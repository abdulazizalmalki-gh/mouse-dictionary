 "shortfin mako": "ماكو قصير الزعنفة (قرش مزرق نشط وسريع جداً يوجد في جميع أنحاء العالم في المياه الدافئة؛ سمكة صيد مهمة)",
 "shortgrass": "عشب قصير (أي من أعشاب مختلفة قصيرة ويمكنها تحمل ظروف الجفاف؛ شائعة في السهول المرتفعة الجافة شرق جبال روكي مباشرة)",
 "shorthand": "اخْتِزَالِيّ, مُخْتَزَل (مكتوب بشكل مختصر أو رمزيّ) / اختزال, كتابة مختزلة (طريقة للكتابة بسرعة باستخدام نظام رمزي مختصر)",
 "shorthand typist": "كاتب اختزال (شخص ماهر في نسخ الكلام (خاصة الإملاء))",
 "shorthorn": "دورهام, شورت هورن (سلالة إنجليزية من الماشية قصيرة القرون)",
 "shortia": "شورتيا (أي نبات من جنس شورتيا؛ أعشاب معمرة دائمة الخضرة بأوراق قاعدية جلدية ناعمة وزهور بيضاء منفردة مبهرجة)",
 "shortia galacifolia": "أجراس أوكوني (نبات في جنوب شرق الولايات المتحدة ذو زهور بيضاء وحيدة على شكل قمع مشوبة بالوردي وأوراق خضراء لامعة كبيرة تتحول إلى البرونزي الأحمر في الخريف)",
 "shortish": "قَصِير نَوْعًا مَا (أَقْصَر بِقَليل مِنَ المُعْتاد)",
 "shortleaf pine": "صنوبر أصفر قصير الأوراق, صنوبر قصير الأوراق (صنوبر كبير من جنوب الولايات المتحدة له إبر قصيرة في حزم من 2-3 ولحاء بني محمر عند النضج)",
 "shortleaf yellow pine": "صنوبر أصفر قصير الأوراق, صنوبر قصير الأوراق (صنوبر كبير من جنوب الولايات المتحدة له إبر قصيرة في حزم من 2-3 ولحاء بني محمر عند النضج)",
 "shortlist": "قائمة مختصرة (قائمة بالمتقدمين تم تصفيتهم من قائمة أطول واعتبروا مناسبين وسيتم اختيار الشخص الناجح منهم)",
 "shortly": "حالاً, خلال وقت قصير (في المستقبل القريب) / بفترة قصيرة, بوقت قصير (لفترة قصيرة) / بمسافة قصيرة (على مسافة قصيرة) / بِإِيجَاز, بِاخْتِصَار (بطريقة موجزة؛ في بضع كلمات)\nمثال: سيكون الطبيب هنا قريباً",
 "shortness": "قِصَر (ضد الطول؛ غير تام، غير كامل)\nمثال: لقد قصر الخطاب.",
 "shortness of breath": "ضيق التنفس, قصر النفس (حالة من عسر التنفس)",
 "shorts": "شُورْت",
 "shortsighted": "قَصِيرُ النَّظَر (يفتقر إلى بُعْد النظر أو الشمولية) / طَائِش, غَيْرُ مَدْرُوس (لم يُعْطَ تفكيرًا كافيًا أو دراسة متأنّية) / قصير النظر, مصاب بقصر النظر (غير قادر على رؤية الأشياء البعيدة بوضوح)",
 "shortsightedness": "تبذير, سوء تدبير (نقص في التدبير والعناية من قبل شخص ما في إدارة الموارد) / حسر, قصر النظر ((طب العيون) خلل في البصر ناتج عن خلل في القدرة الانكسارية للعين؛ تظهر الأشياء البعيدة غير واضحة)",
 "shortstop": "التوقف القصير, شورت ستوب (مركز اللعب للاعب في فريق البيسبول المتمركز بين القاعدة الثانية والثالثة) / لاعب التوقف القصير",
 "shorttail weasel": "ابن عرس قصير الذيل, قاقم (حيوان من فصيلة العرسيات في نصف الكرة الشمالي في معطفه الشتوي الأبيض)",
 "shortwave diathermy machine": "جهاز الإنفاذ الحراري بالموجات القصيرة (جهاز إنفاذ حراري يستخدم إشعاع الموجات القصيرة كمصدر للحرارة)",
 "shoshone": "لغة الشوشوني (اللغة التي يتحدث بها شعب الشوشوني (تنتمي لعائلة اللغات اليوتو-أزتيكية)) / شوشوني (فرد من شعب هندي في أمريكا الشمالية (مرتبط بالأزتيك) في جنوب غرب الولايات المتحدة)",
 "shoshonean": "لغات الشوشوني (عائلة فرعية من اللغات اليوتو-أزتيكية يتم التحدث بها بشكل رئيسي في جنوب غرب الولايات المتحدة)",
 "shoshonean language": "لغات الشوشوني (عائلة فرعية من اللغات اليوتو-أزتيكية يتم التحدث بها بشكل رئيسي في جنوب غرب الولايات المتحدة)",
 "shoshoni": "شوشوني (فرد من شعب هندي في أمريكا الشمالية (مرتبط بالأزتيك) في جنوب غرب الولايات المتحدة)",
 "shoshonian": "لغات الشوشوني (عائلة فرعية من اللغات اليوتو-أزتيكية يتم التحدث بها بشكل رئيسي في جنوب غرب الولايات المتحدة)",
 "shoshonian language": "لغات الشوشوني (عائلة فرعية من اللغات اليوتو-أزتيكية يتم التحدث بها بشكل رئيسي في جنوب غرب الولايات المتحدة)",
 "shot": "طَلَقَة, طَلَق / رَمْيَة / لَقْطَة / حُقْنَة, حَقْن",
 "shot glass": "كأس جرعة, كأس صغير (كأس صغير يكفي لحمل جرعة واحدة)",
 "shot hole": "ثقب التفجير (ثقب حفر لوضع شحنة متفجرة)",
 "shot metal": "معدن الخردق (سبيكة تتكون من 98% رصاص و2% زرنيخ؛ تستخدم في صنع الخردق الصغير)",
 "shot put": "رَمْيُ الجُلَّة",
 "shot putter": "رامي الجلة (رياضي يتنافس في رمي الجلة)",
 "shot tower": "برج الخردق, برج الرصاص (برج من النوع الذي كان يستخدم قديماً لصنع طلقات الرصاص؛ حيث يُسكب الرصاص المصهور عبر غربال ويسقط في الماء)",
 "shote": "خنزير صغير, خنوص (خنزير صغير)",
 "shotgun": "بندقية خرطوش, بندقية صيد (سلاح ناري يُحمل على الكتف مزدوج السبطانة أملس الجوف لإطلاق الخردق في مديات قصيرة)",
 "shotgun microphone": "ميكروفون بندقية, ميكروفون موجه (ميكروفون عالي الاتجاهية ذو أنبوب طويل؛ يمكن توجيهه من مسافة بعيدة)",
 "shotgun mike": "ميكروفون بندقية, ميكروفون موجه (ميكروفون عالي الاتجاهية ذو أنبوب طويل؛ يمكن توجيهه من مسافة بعيدة)",
 "shotgun shell": "خرطوشة بندقية صيد (قذيفة تحتوي على خردق رصاص؛ تستخدم في بنادق الصيد)",
 "should": "يَنْبَغِي أَنْ / مِنْ اَلْمَفْرُوض أَنْ (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / مِنْ اَلْمُفْتَرَض أَنْ (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "shoulder": "كَتِف, كِتْف",
 "shoulder bag": "حقيبة كتف (حقيبة يد كبيرة يمكن حملها بحزام يوضع فوق الكتف)",
 "shoulder blade": "لَوْح اَلْكَتِف, عَظْم كَتِفِيّ",
 "shoulder board": "رتبة كتف, علامة الكتف (كَتَّافات تشير إلى الرتبة)",
 "shoulder bone": "عظم الكتف, لوح الكتف (أي من عظمين مثلثين مسطحين يقعان على كل جانب من جانبي الكتف في البشر)",
 "shoulder cord": "حبل الكتف, قيطان الكتف (حبل مضفر يرتدى على كتف واحد مع زي رسمي معين)",
 "shoulder flash": "شارة كتف (شيء يلبس على كتف الزي العسكري كشعار لفرقة، إلخ)",
 "shoulder girdle": "حزام الكتف, قوس صدرية (القوس العظمي الذي يتكون من الترقوة ولوح الكتف في البشر)",
 "shoulder holster": "جراب كتف (جراب يُلبس فوق الكتف بحيث يمكن إخفاء المسدس تحت السترة)",
 "shoulder joint": "كتف, مفصل الكتف (مفصل كروي بين رأس عظم العضد وتجويف لوح الكتف)",
 "shoulder mark": "رتبة كتف, علامة الكتف (كَتَّافات تشير إلى الرتبة)",
 "shoulder pad": "واقي كتف (ملابس واقية تتكون من وسادة صلبة مستديرة يرتديها لاعبو كرة القدم لحماية أكتافهم)",
 "shoulder patch": "شارة كتف (رقعة تلبس على كتف الزي العسكري للإشارة إلى الرتبة)",
 "shoulder strap": "حمالة, شريط الكتف (شريط يمر فوق الكتف ويدعم ملابس أو حقيبة)",
 "shoulder vise": "ملزمة خشب, ملزمة نجارة (ملزمة ذات فكوك مبطنة لتثبيت الخشب دون إحداث خدوش فيه)",
 "shoulder-to-shoulder": "جنباً إلى جنب, كتفاً بكتف (جنباً إلى جنب ومتقاربين)\nمثال: سارت القوات كتفاً بكتف",
 "shouldered": "ذو أكتاف, مكتف (له أكتاف أو أكتاف كما هو محدد؛ تستخدم عادة كصيغة مركبة)\nمثال: محدب الكتفين",
 "shouldered arch": "قوس ذو أكتاف (قوس يتكون من عتبة أفقية مدعومة عند كل طرف بكوابيل تبرز في الفتحة)",
 "shout": "صَيح, صِيَاح (مبالغة في الصياح، صاح كثيرا؛ في : صرخ) / صَرَخَ, صَاحَ (صاحَ صياحا شديدًا واستغاث)\nمثال: صرخ طالبا النجدة.",
 "shout-out": "إشادة, تحية (فعل التقدير أو الاعتراف بفضل شخص ما علناً)",
 "shouted": "مَصْرُوخ, مُنَادًى (صادر بصراخ عنيف)",
 "shouter": "زاعق, صائح (شخص يتواصل صوتيًا بصوت عالٍ جدًا)",
 "shouting": "صِيَاح (مصدر الفعل صَاحَ؛ صوت الكائن الحي القوي)\nمثال: بدأنا في الصياح.",
 "shove": "دفع عنيف (فعل الدفع بقوة (دفع شخص أو شيء))\nمثال: أعطى الباب دفعة قوية",
 "shove-ha'penny": "شوفل بورد (لعبة يتم فيها زلق عملات معدنية أو أقراص باليد عبر لوحة نحو علامة)",
 "shove-halfpenny": "شوفل بورد (لعبة يتم فيها زلق عملات معدنية أو أقراص باليد عبر لوحة نحو علامة)",
 "shovel": "مِجْرَفَة, مِجْرَاف / مجرفة",
 "shovel board": "شوفل بورد (لعبة يتم فيها زلق عملات معدنية أو أقراص باليد عبر لوحة نحو علامة)",
 "shovel hat": "قبعة المجرفة (قبعة صلبة عريضة الحواف تكون حافتها مرفوعة عند الجانبين وبارزة من الأمام؛ يرتديها بعض رجال الدين في بريطانيا)",
 "shovelboard": "شافلبورد (لعبة يستخدم فيها اللاعبون عصياً طويلة لدفع أقراص خشبية إلى منطقة التسجيل المحددة على سطح أملس)",
 "shoveler": "أبو مجرفة, كيش (بط مياه عذبة من نصف الكرة الشمالي له منقار عريض مسطح) / جرّاف (عامل يستخدم المجرفة)\nمثال: جرّاف فحم",
 "shovelful": "ملء مجرفة (الكمية التي يمكن لمجرفة حملها)",
 "shovelhead": "قرش القلنسوة (قرش مطرقة صغير غير ضار ذو رأس يشبه المجرفة؛ وفير في الخلجان ومصبات الأنهار)",
 "shoveller": "أبو مجرفة, كيش (بط مياه عذبة من نصف الكرة الشمالي له منقار عريض مسطح) / جرّاف (عامل يستخدم المجرفة)\nمثال: جرّاف فحم",
 "shovelnose catfish": "سلور مسطح الرأس (سلور كبير في وسط الولايات المتحدة له رأس مسطح وفك بارز)",
 "shover": "دافع (شخص يدفع)",
 "show": "ثَبَتَ, وَضَحَ (اسْتَقَرَّ ودَامَ ولم يتحرك برغم المغريات أو الدوافع؛ الأمر: تَحَقَّقَ وتَأكَّدَ حصوله) / عَرْض, اِسْتِعْرَاض (أتى العروض، أي مكّة والمدينة وما حولهما؛ الفَرَسَ: سار به بالعُرض) / بَرْنَامَج (عَرْضٌ (تلْفَزِيٌّ،…)؛ مُفَكَّرَةٌ يَوْمِيَّةٌ) / مَعْرِض / إِظْهَار, عَرْض\nمثال: ثبت مناد مكانه.",
 "show bill": "ملصق عرض, ملصق مسرحي (ملصق يعلن عن عرض أو مسرحية)",
 "show biz": "صناعة الترفيه (المشاركون في توفير الترفيه: الراديو والتلفزيون والأفلام والمسرح)",
 "show business": "صناعة الترفيه (المشاركون في توفير الترفيه: الراديو والتلفزيون والأفلام والمسرح)",
 "show card": "ملصق عرض, ملصق مسرحي (ملصق يعلن عن عرض أو مسرحية)",
 "show of force": "استعراض للقوة",
 "show time": "وقت العرض (النقطة الزمنية التي من المقرر أن يبدأ فيها ترفيه ما (فيلم أو برنامج تلفزيوني إلخ))",
 "show trial": "محاكمة شكلية (قرار المحكمة على الجاني؛ القضاء الجنائي على متهم)\nمثال: تمت محاكمة زيري.",
 "show window": "واجهة عرض (نافذة متجر تواجه الشارع؛ تستخدم لعرض البضائع للبيع في المتجر) / نموذج للعرض, واجهة عرض (بيئة أو إطار يمكن فيه عرض شيء ما بأفضل صورة)\nمثال: كانت نموذجاً لعرض الديمقراطية في أفريقيا",
 "show, don't tell": "لا تفصح، بل أبد (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: لا أحب المدرسة.",
 "show-off": "استعراضي, محب للظهور (شخص يتصرف عمداً بطريقة تجذب الانتباه)",
 "show-stopper": "خَاطِف لِلأَنْظَار, عَرْض مُذْهِل (شيء جذاب بشكل لافت أو له جاذبية شعبية كبيرة) / فقرة مذهلة (عرض مذهل أو مثير للإعجاب لدرجة أن العرض يجب أن يتأخر حتى يهدأ الجمهور)\nمثال: لديها ابتسامة خاطفة للأنظار",
 "showboat": "قارب استعراضي, مسرح عائم (قارب نهري بخاري يمكن تقديم العروض المسرحية عليه (خاصة في نهر المسيسيبي))",
 "showboy": "راقص استعراضي (رجل يرقص في صف الكورس)",
 "showcase": "واجِهَة, فَاتْرِينَة",
 "showdown": "مجابهة, مواجهة (خلاف عدائي وجهاً لوجه)",
 "shower": "شَتْوَة, مَطْرَة / مِرَشَّة, دُش / اِسْتَحَمَّ, تَحَمَّمَ (اغتسل بالحميم؛ في : الاغتسال عموما سواء كان بالحميم أو بالماء البارد)\nمثال: استحم زيري هناك.",
 "shower bath": "استحمام بالرشاش, دش (غسل النفس بالوقوف منتصباً تحت الماء المندفع من فوهة (دش)) / كابينة الاستحمام (مقصورة للاغتسال، عادة في الحمام)\nمثال: أخذ دشاً بعد المباراة",
 "shower cap": "قبعة استحمام (قبعة ضيقة تلبس لإبقاء الشعر جافاً أثناء الاستحمام)",
 "shower curtain": "ستارة الحمام (ستارة تمنع تناثر الماء خارج منطقة الاستحمام)",
 "shower glove": "قفاز استحمام, قفاز تقشير (قفاز مصنوع من ألياف خشنة يستخدم لغسل وفرك الجسم)",
 "shower mitt": "قفاز استحمام, قفاز تقشير (قفاز مصنوع من ألياف خشنة يستخدم لغسل وفرك الجسم)",
 "shower room": "غرفة الاستحمام (غرفة بها عدة دُشّات)",
 "shower scrubber": "ليفة استحمام (أداة غسيل مصنوعة من شبكة نايلون؛ تستخدم لغسل وفرك الجسم)",
 "shower stall": "كابينة الاستحمام (مقصورة للاغتسال، عادة في الحمام)",
 "showerhead": "رأس الدش (فوهة مثقبة ترش الماء على المستحم)",
 "showery": "مَاطِر, مُمْطِر ((عن الطقس) مبلَّل بفترات من المطر)",
 "showgirl": "راقصة استعراضية (امرأة ترقص في صف الكورس)",
 "showily": "ببهرجة, بشكل استعراضي (بطريقة ملونة ومبهرجة) / باستعراض, بتباهٍ (مع التباهي؛ بطريقة استعراضية)\nمثال: إنه يرتدي ملابس مبهرجة إلى حد ما",
 "showiness": "بهرجة, تأنق مفرط (إتقان مفرط وتكلف)\nمثال: كتب بأسلوب منمق للغاية",
 "showing": "عرض, معرض (شيء يُعرض للجمهور) / عرض, عرض سينمائي (عرض صورة متحركة (فيلم))\nمثال: كان للمتحف العديد من معروضات الفن الشرقي",
 "showjumping": "قفز الحواجز (ركوب الخيل في مسابقات عبر مسارات محددة لإظهار المهارة في القفز فوق العقبات)",
 "showman": "منتج مسرحي, منظم عروض (راعٍ ذكر يحجز وينظم وسائل الترفيه العامة) / مقدم عروض (شخص ذكر ماهر في تقديم عروض فعالة)",
 "showmanship": "فن الاستعراض, مهارة العرض (القدرة على تقديم شيء ما (خاصة العروض المسرحية) بطريقة جذابة)",
 "showperson": "فَنَّان اسْتِعْرَاضِيّ, مُسْتَعْرِض (شخص ماهر في تقديم العروض المؤثرة)",
 "showpiece": "تحفة فنية, قطعة نادرة (العنصر البارز (القطعة الثمينة أو المعروض الرئيسي) في مجموعة)",
 "showplace": "معلم سياحي, مكان للعرض (مكان يتم عرضه وزيارته بشكل متكرر لاهتمامه التاريخي أو جماله الطبيعي)",
 "showroom": "صالة عرض, معرض (منطقة يمكن فيها عرض البضائع (مثل السيارات))",
 "showstopper": "خَاطِف لِلأَنْظَار, عَرْض مُذْهِل (شيء جذاب بشكل لافت أو له جاذبية شعبية كبيرة) / فقرة مذهلة (عرض مذهل أو مثير للإعجاب لدرجة أن العرض يجب أن يتأخر حتى يهدأ الجمهور)\nمثال: لديها ابتسامة خاطفة للأنظار",
 "showtime": "استهلال, انطلاق (الوقت الذي يفترض أن يبدأ فيه شيء ما)\nمثال: بدأوا بداية مبكرة",
 "showwoman": "منتجة مسرحية, منظمة عروض (راعية أنثى تحجز وتنظم وسائل الترفيه العامة) / مقدمة عروض (شخص أنثى ماهرة في تقديم عروض فعالة)",
 "showy": "بَرَّاق, مُبْهِر (جذّاب وأنيق ظاهريًّا؛ يوحي بالثراء أو الفخامة) / صَارِخ, مُبَهْرَج (ذو ألوان صارخة وبرّاقة تجذب الانتباه بشكل مفرط) / بَرَّاق, مُتَأَلِّق (يَعْرِض بَرَاعَةً وَتَأَلُّقًا) / بَرَّاق, صَارِخ (يتّسم بالتباهي لكنّه غالبًا عديم الذوق)",
 "showy daisy": "أقحوان مبهرج, يرغوث مبهرج (نبات له سيقان مورقة متفرعة كل فرع برأس زهرة منفرد مبهرج بشكل خاص مع العديد من الأشعة الضيقة الوردية أو اللافندر أو البيضاء؛ جبال شمال غرب الولايات…)",
 "showy goldenrod": "عصا الذهب المبهرجة (ما يتخذ من خَشَب للتوكؤ أو الضرب؛ تطلق مجازا على عَظْم السَاق وعلى اللِسَان)\nمثال: لا تمسك العصا من الوسط.",
 "showy lady slipper": "خف السيدة الملكي (سحلب بري وردي شاحب من شمال شرق أمريكا له شفة منتفخة تشبه الجراب)",
 "showy lady's-slipper": "خف السيدة الملكي (سحلب بري وردي شاحب من شمال شرق أمريكا له شفة منتفخة تشبه الجراب)",
 "showy milkweed": "صقلاب استعراضي, صقلاب جميل (صقلاب من جنوب أمريكا الشمالية له زهور أرجوانية ووردية نجمية كبيرة)",
 "showy orchis": "سحلب استعراضي (سحلب من أمريكا الشمالية له سنبلة من الزهور البنفسجية الأرجوانية الممزوجة بالأبيض؛ السبلات والبتلات تشكل غطاء)",
 "showy sunflower": "عباد شمس مبهرج (نبات معمر طويل خشن الأوراق بعدد قليل من رؤوس الزهور الكبيرة؛ وسط الولايات المتحدة)",
 "shrapnel": "شَظَايَا",
 "shred": "خرقة, رقعة (قطعة صغيرة من القماش) / ذرة, مثقال ذرة (كمية صغيرة جداً أو نادرة الوجود)",
 "shredded": "مُشَرَّح, مُفَرَّم (مُعَدّ بالتقطيع)",
 "shredder": "آلة تمزيق, فرامة ورق (جهاز يمزق المستندات (عادة لمنع الأشخاص الخطأ من قراءتها))",
 "shrew": "زَبَابَة",
 "shrew mole": "خلد الزباب (خلد نحيل ذو خطم وذيل طويلين)",
 "shrew-sized": "بِحَجْمِ الزَّبَابَةِ (بحجم حيوان الزبابة تقريبًا)",
 "shrewd": "حَاذِق (اسم فاعل للفعل حَذِقَ أي المَاهِرِ المُتقِنِ لعَمَلِهِ) / نَاصِح, نَبِيه\nمثال: إنها حاذقة الذكاء.",
 "shrewdly": "بِدَهَاء, بِفِطْنَة (بطريقة ذكية)\nمثال: استثمر ثروته بذكاء",
 "shrewdness": "حذق, حنكة (الذكاء الذي يظهر من خلال الحنكة (كما في التعاملات التجارية))",
 "shrewish": "كَثِير التَّذَمُّر, نَوَّاح (دائم الشكوى والتذمر وتصيد الأخطاء)",
 "shrewishly": "بسلاطة لسان (بطريقة سليطة اللسان)",
 "shrewishness": "سلاطة اللسان, نكد (طبيعة تميل للنكد أو التوبيخ)",
 "shrewmouse": "زباب (ثديي صغير يشبه الفأر ذو خطم طويل؛ قريب من الخلد)",
 "shrewsbury": "شروزبري",
 "shriek": "زَعَقَ / صَرَخَ (صاحَ صياحا شديدًا واستغاث)\nمثال: صرخ طالبا النجدة.",
 "shrieked": "مصرخ, مصيح (منطوق بصرخة حادة كما من الألم أو الرعب)",
 "shrieking": "صرخة, عويل (صيحة حادة ثاقبة) / صراخ, صرخة (ضجيج عالي النبرة يشبه صرخة الإنسان)\nمثال: جذب صراخها الجيران",
 "shrift": "اعتراف وحل (فعل الاعتراف بالخطايا ونيل الغفران)",
 "shrike": "صرد (أي من الطيور العديدة في العالم القديم ذات منقار قوي معقوف تتغذى على الحيوانات الأصغر)",
 "shrill": "حَادّ, صَارِخ (ذو لون ساطع بشكل مفرط وصارخ) / حَادّ, صَاخِب (يُصِرُّ بِحِدَّةٍ عَلَى أَنْ يُسْمَع) / حَادّ, صَرِير (ذو نبرة عالية وحادَّة أو يُصدر نغمات كذلك)",
 "shrilling": "صفير حاد, صياح (ضجيج حاد مستمر)\nمثال: صليل السيوف وصفير الأبواق",
 "shrillness": "حدة, صرير (امتلاك جرس صوت عالٍ وحاد) / حدة, صخب (صفة كونه حادًا أو قاسيًا على الحواس)\nمثال: حدة لون شعرها",
 "shrilly": "بشكل ثاقب, بصوت حاد (بصوت حاد)\nمثال: غنت بصوت حاد نوعاً ما",
 "shrimp": "رُوبِيَان / جَمْبَرِيّ / إِرْبِيَان / قُرَيْدِس",
 "shrimp butter": "زبدة الجمبري (زبدة ممزوجة بالجمبري المفروم أو متبلة بخلاصة قشور الجمبري)",
 "shrimp cocktail": "كوكتيل الجمبري, كوكتيل الروبيان (كوكتيل من الجمبري المطبوخ البارد وصلصة)",
 "shrimp newburg": "جمبري نيوبرغ (جمبري في صلصة نيوبرغ يُقدم عادة في حلقة أرز)",
 "shrimp sauce": "صلصة الجمبري, نانتوا (صلصة بيضاء مع كريمة الخفق وزبدة الجمبري)",
 "shrimp-fish": "سمكة الجمبري (سمكة استوائية نحيلة تعيش في المياه الضحلة في جزر الهند الشرقية ومغطاة بصفائح شفافة)",
 "shrimper": "سفينة صيد الجمبري (سفينة تعمل في صيد الجمبري)",
 "shrimpfish": "سمكة الجمبري (سمكة استوائية نحيلة تعيش في المياه الضحلة في جزر الهند الشرقية ومغطاة بصفائح شفافة)",
 "shrimpy": "ضَامِر, نَحِيل ((يُستخدم خاصة للأشخاص) صغير الحجم أو ضعيف البنية)",
 "shrine": "ضَرِيح",
 "shrink": "قَلَّصَ (جعل الشيء أصغر حجمًا أو أقل مقدارًا؛ اختصر أو قلل من شيء معين) / تَقَلَّصَ, أَحْجَمَ",
 "shrink-wrap": "غلاف انكماشي (الفيلم البلاستيكي الشفاف اللاصق الذي يستخدم للتغليف الانكماشي لشيء ما)",
 "shrink-wrapped software": "برمجيات جاهزة (برمجيات على أقراص مضغوطة معبأة ومغلفة وتباع في المتاجر (مما يعني ضمناً منصة قياسية مدعومة على نطاق واسع))",
 "shrinkable": "قابل للانكماش (قابل للانكماش)\nمثال: قماش قابل للانكماش",
 "shrinkage": "سرقة المتاجر (فعل سرقة البضائع المعروضة في المتجر) / انكماش, تقلص (المقدار الذي ينكمش به الشيء) / انكماش, تقلص (عملية أو نتيجة أن يصبح الشيء أقل أو أصغر)\nمثال: فقدت المادة 2 بوصة لكل ياردة بسبب الانكماش",
 "shrinking": "انكماش, تقلص (عملية أن يصبح الشيء أقل) / انكماش, تقلص (عملية أو نتيجة أن يصبح الشيء أقل أو أصغر)\nمثال: فقدت المادة 2 بوصة لكل ياردة بسبب الانكماش",
 "shrinking violet": "انطوائي, خجول (شخص ينكمش من الألفة مع الآخرين)",
 "shriveled": "ذَابِل, مُنْكَمِش (تراجع في الفاعلية أو الحيوية أو الشدّة) / ذَابِل, مُتَجَعِّد (نَحِيل وَمُتَجَعِّد بِسَبَب الانْكِمَاش مِنَ الشَّيْخُوخَة أَوِ المَرَض) / ذَابِل, يَابِس ((يُوصف به النبات خاصّةً) فَقَد كلّ رطوبته وذبل)",
 "shrivelled": "ذَابِل, مُنْكَمِش (تراجع في الفاعلية أو الحيوية أو الشدّة) / ذَابِل, مُتَجَعِّد (نَحِيل وَمُتَجَعِّد بِسَبَب الانْكِمَاش مِنَ الشَّيْخُوخَة أَوِ المَرَض) / ذَابِل, يَابِس ((يُوصف به النبات خاصّةً) فَقَد كلّ رطوبته وذبل)",
 "shroud": "كفن",
 "shrove tuesday": "الثلاثاء البدين, ثلاثاء المرافع",
 "shrovetide": "أيام المرفع (تسبق الصوم الكبير مباشرة)",
 "shrub": "شُجَيْرَة / شَرَاب",
 "shrubbery": "مجموعة شجيرات (مجموعة من الشجيرات تنمو معاً) / مشجر, منطقة شجيرات (منطقة تُزرع فيها مجموعة من الشجيرات)",
 "shrubby": "شجيري (من أو يتعلق بالشجيرة أو يشبهها)",
 "shrubby bittersweet": "حلوة مرة أمريكية, سيلاستروس (شجيرة ملتفة في أمريكا الشمالية لها كبسولات صفراء تحيط ببذور قرمزية)",
 "shrubby penstemon": "بنستيمون شجيري (نبات كثيف منخفض بأزهار كبيرة مبهرجة خزامية باهتة أو زرقاء بنفسجية في عناقيد ضيقة عند نهايات السيقان)",
 "shrubby st john's wort": "عشبة القديس يوحنا الشجيرية (شجيرة صلبة لها أوراق مستطيلة كاملة ونوارات كثيفة من الزهور الصفراء)",
 "shrublet": "شجيرة قزمة (شجيرة قزمة)",
 "shrug": "هَزَّ كَتِفَيْن",
 "shrunken": "ذَابِل, مُنْكَمِش (تراجع في الفاعلية أو الحيوية أو الشدّة) / ذَابِل, مُتَجَعِّد (نَحِيل وَمُتَجَعِّد بِسَبَب الانْكِمَاش مِنَ الشَّيْخُوخَة أَوِ المَرَض)",
 "shtick": "أسلوب مميز, حيلة مسرحية (خدعة ماكرة؛ أو قدر من الاحتيال) / أسلوب مميز, نمرة فكاهية ((اليديشية) مقلب أو قطعة من التهريج) / أسلوب خاص, حركة مميزة (حركة مفتعلة ومستخدمة غالباً يستخدمها المؤدي لجذب الانتباه) / القليل, قطعة ((من اليديشية) القليل؛ قطعة)\nمثال: كيف انطلت عليك حيلة كهذه؟",
 "shtickl": "قطعة صغيرة جداً (قطعة صغيرة جداً)",
 "shtik": "أسلوب مميز, حيلة مسرحية (خدعة ماكرة؛ أو قدر من الاحتيال) / أسلوب مميز, نمرة فكاهية ((اليديشية) مقلب أو قطعة من التهريج) / أسلوب خاص, حركة مميزة (حركة مفتعلة ومستخدمة غالباً يستخدمها المؤدي لجذب الانتباه) / القليل, قطعة ((من اليديشية) القليل؛ قطعة)\nمثال: كيف انطلت عليك حيلة كهذه؟",
 "shtikl": "قطعة صغيرة جداً (قطعة صغيرة جداً)",
 "shtup": "مضاجعة, نكاح (مصطلحات عامية للجماع الجنسي)",
 "shua": "شوا, شوها شنتو (أي فرع من فروع الشنتو غير الكوكا)",
 "shubra el-kheima": "شُبْرَا الْخَيْمَة",
 "shuck": "تبن, حتالة (مادة تتكون من أغطية البذور وقطع صغيرة من الساق أو الأوراق التي تم فصلها عن البذور)",
 "shucks": "تَافِه, لَا يُسَاوِي فَلْساً (شيء ذو قيمة قليلة جداً) / تعبير استياء (تعبير عن خيبة الأمل أو الانزعاج)\nمثال: وعده لا يساوي فلساً",
 "shudder": "ارتجاف, رعشة (اهتزاز لا إرادي (كما لو كان بسبب المرض أو الخوف)) / رجفة, رعشة (إحساس بالخوف يكاد يكون ممتعاً)\nمثال: سرت فيه رعشة مفاجئة",
 "shuddering": "مُتَقَلْقِل, مُرْتَعِد (يهتز بعنف أو بشكل تشنجي)",
 "shudderingly": "بارتجاف, بقشعريرة (مع ارتعاش أو قشعريرة)\nمثال: بارتجاف، اعترفت لنفسها بأنها لا تجرؤ على مواجهة ما ينتظرها",
 "shuddery": "مُرْعِب, مُقْشَعِرّ (يثير الخوف والرعشة والقشعريرة)",
 "shudra": "شودرا (أدنى الطبقات الأربع: الخدم والعمال ذوو المكانة المتدنية) / شودرا (عضو في أدنى طبقة هندوسية أو طبقة العمال)",
 "shuffle": "خَلَطَ (اختلط) / مَشَى يَجُرُّ قَدَمَيْهِ, رَسَفَ (اِنْتَقَلَ من مكان إلى آخر؛ اِنْتَقَلَ من مكان إلى آخر على الأقدام. (تخصيص))\nمثال: خلط توم بين السكر و الملح.",
 "shuffle the cards": "خلط الأوراق (اختلط)\nمثال: خلط توم بين السكر و الملح.",
 "shuffleboard": "شافلبورد (لعبة يستخدم فيها اللاعبون عصياً طويلة لدفع أقراص خشبية إلى منطقة التسجيل المحددة على سطح أملس)",
 "shuffler": "سائر بجر القدمين (شخص يمشي دون رفع القدمين) / خالط الورق (لاعب الورق الذي يقوم بخلط الأوراق)",
 "shuffling": "تسكع, جر الأقدام (المشي بحركة جر بطيئة دون رفع القدمين) / خلط الأوراق (فعل خلط أوراق اللعب بشكل عشوائي)\nمثال: من طريقة جره لأقدامه افترضت أنه عجوز جداً",
 "shufti": "نظرة سريعة (نظرة سريعة حول المكان (أصلها عامية عسكرية))",
 "shuha": "شوها (متعلق بأي طائفة شنتوية غير كوكا شنتو)",
 "shuha shinto": "شوا, شوها شنتو (أي فرع من فروع الشنتو غير الكوكا)",
 "shumac": "سماق",
 "shumard oak": "سنديان شومارد (سنديان أحمر نفضي كبير موطنه جنوب وشرق الولايات المتحدة، له أوراق كبيرة بيضاوية الشكل ذات سبعة إلى تسعة فصوص، وبلوط كبير، وخشب متوسط الصلابة خشن…)",
 "shumard red oak": "سنديان شومارد (سنديان أحمر نفضي كبير موطنه جنوب وشرق الولايات المتحدة، له أوراق كبيرة بيضاوية الشكل ذات سبعة إلى تسعة فصوص، وبلوط كبير، وخشب متوسط الصلابة خشن…)",
 "shun giku": "أقحوان تاجي مأكول, خضروات تشوب سوي (يزرع لأوراقه اللحمية الصالحة للأكل المستخدمة في الطهي الآسيوي)",
 "shunning": "تجنب, تحاشي (التجنب المتعمد؛ الابتعاد عن شيء أو منع حدوثه)",
 "shunt": "حَوَّلَ (جَعَلَ الشيءَ غير ما كان؛ نقل الشيء من موضع إلى آخر)\nمثال: رقصنا حول النار.",
 "shunt circuit": "دائرة توازي (دائرة مغلقة ينقسم فيها التيار إلى مسارين أو أكثر قبل إعادة الاتحاد لإكمال الدائرة)",
 "shunt dc motor": "محرك تيار مستمر تفرعي, محرك تيار مستمر متوازي (نوع من محركات التيار المستمر يربط ملفات المنتج والمجال على التوازي (التفرع) مع مصدر طاقة تيار مستمر مشترك؛ يستخدم للتطبيقات الصناعية ذات السرعة…)\nمثال: يتمتع محرك التيار المستمر التفرعي بتنظيم جيد للسرعة حتى مع اختلاف الحمل، لكنه لا يملك عزم دوران البدء الخاص بمحرك التيار المستمر المتسلسل",
 "shunt wound dc motor": "محرك تيار مستمر تفرعي, محرك تيار مستمر متوازي (نوع من محركات التيار المستمر يربط ملفات المنتج والمجال على التوازي (التفرع) مع مصدر طاقة تيار مستمر مشترك؛ يستخدم للتطبيقات الصناعية ذات السرعة…)\nمثال: يتمتع محرك التيار المستمر التفرعي بتنظيم جيد للسرعة حتى مع اختلاف الحمل، لكنه لا يملك عزم دوران البدء الخاص بمحرك التيار المستمر المتسلسل",
 "shunter": "قاطرة مناورة (قاطرة صغيرة تستخدم لتحريك العربات ولكن ليس للقيام برحلات)",
 "shuriken": "شُورِيكِن, شُورِيكِين",
 "shush": "صَمَت",
 "shut": "أَغْلَقَ (ضد فَتَحَ؛ سَدَّ وسَكَّرَ؛ قد تستخدم بمعنى أَقْفَلَ؛ أغلقه بحيث لا يفتح إلا بمفتاح) / اِنْغَلَقَ\nمثال: أغلق الباب بغضب",
 "shut up": "كَمَّمَ الفَمَ / صَه, اُسْكُت (صَهْ اسم فعل أمر بمعنى اسكتْ، وهو بلفظ واحد للمفرد و الجمع و المذكر و المؤنث; يقال صَهٍ بالتنوين بمعنى اسكت سكوتاً ما في وقتٍ ما)",
 "shut-eye": "إغفاءة (مصطلح غير رسمي للنوم)",
 "shut-in": "حَبِيسُ المَنْزِلِ, مُلَازِمٌ لِلبَيْتِ (مَحْصُورٌ فِي البَيْتِ عَادَةً بِسَبَبِ المَرَضِ) / مَيَّالٌ لِلِانْطِوَاء (يميل إلى الانطواء بعض الشيء) / عاجِز, مُقْعَد (شخص أقعده مرض مزمن أو إصابة)",
 "shutdown": "إغلاق, إقفال (إنهاء العمليات)\nمثال: أسفوا لإغلاق مركز الرعاية النهارية",
 "shuteye": "إغفاءة (مصطلح غير رسمي للنوم)",
 "shutout": "تبييض, فوز نظيف (هزيمة في لعبة يفشل فيها أحد الجانبين في التسجيل)",
 "shutter": "مِصْرَاع (البَاب. ويطلق غالباً على الأبواب الخشبية الثقيلة؛ هو ما يسُدٌّ الباب من خشب)",
 "shutter telegraph chain": "تلغراف بصري, خط الإشارة (نظام لنقل المعلومات عن طريق الإشارات المرئية، باستخدام أبراج ذات مصاريع محورية؛ يتم تشفير المعلومات بواسطة موضع العناصر الميكانيكية)",
 "shutterbug": "هاوي تصوير (متحمس للتصوير الفوتوغرافي)",
 "shuttered": "ذو مصاريع (مزود بمصاريع (للشبابيك)؛ غالبًا ما تستخدم في المركبات)\nمثال: كنيسة ذات جرسية وبرج مزودين بمصاريع",
 "shutting": "إغلاق (عملية إغلاق شيء ما)",
 "shutting post": "عمود الغلق (عمود البوابة الذي تغلق البوابة عليه)",
 "shuttle": "مَكُّوك / مَكُوك",
 "shuttle bus": "حافلة مكوكية (وسيلة نقل مكوكية تتكون من حافلة تسافر بين نقطتين)",
 "shuttle diplomacy": "دبلوماسية مكوكية (مفاوضات دولية يديرها وسيط يسافر بشكل متكرر ذهاباً وإياباً بين الأطراف المتفاوضة)\nمثال: دبلوماسية كيسنجر المكوكية في الشرق الأوسط",
 "shuttle helicopter": "مروحية مكوكية (مروحية تتنقل ذهاباً وإياباً)",
 "shuttlecock": "رِيشَة",
 "shuttlecock fern": "رأس الكمان, سرخس النعامة (سرخس طويل من المناطق المعتدلة الشمالية له سعف مقوس رشيق وأبواغ تشبه ريش النعام)",
 "shwa": "شوا (صائت متوسط محايد؛ يظهر في المقاطع غير المنبورة)",
 "shy": "خَجُول, خَجِل / خَجُول",
 "shy person": "انطوائي, خجول (شخص ينكمش من الألفة مع الآخرين)",
 "shylock": "مرابٍ (شخص يقرض المال بأسعار فائدة مفرطة)",
 "shyly": "بِاسْتِحْيَاء, بِخَجَل (بطريقة تتسم بالخجل أو التردد)\nمثال: ابتسم بخجل",
 "shyness": "حياء, خجل (شعور بالخوف من الإحراج)",
 "shyster": "مراوغ (شخص (خاصة محامٍ أو سياسي) يستخدم أساليب عديمة الضمير أو غير أخلاقية)",
 "si": "سِي",
 "si system": "النظام الدولي للوحدات (نظام متري كامل لوحدات القياس للعلماء؛ الكميات الأساسية هي الطول (متر) والكتلة (كيلوجرام) والوقت (ثانية) والتيار الكهربائي (أمبير) ودرجة الحرارة…)\nمثال: اليوم الولايات المتحدة هي الدولة الوحيدة في العالم غير الملتزمة كلياً بالنظام الدولي للوحدات",
 "si unit": "النظام الدولي للوحدات (نظام متري كامل لوحدات القياس للعلماء؛ الكميات الأساسية هي الطول (متر) والكتلة (كيلوجرام) والوقت (ثانية) والتيار الكهربائي (أمبير) ودرجة الحرارة…)\nمثال: اليوم الولايات المتحدة هي الدولة الوحيدة في العالم غير الملتزمة كلياً بالنظام الدولي للوحدات",
 "sial": "سيال (الصخور الشبيهة بالجرانيت التي تشكل الطبقة الخارجية من قشرة الأرض؛ غنية بالسيليكون والألومنيوم)",
 "sialadenitis": "التهاب الغدد اللعابية (التهاب الغدد اللعابية)",
 "sialis lutaria": "ذبابة ألدر (حشرة داكنة اللون لها يرقات مائية مفترسة)",
 "sialolith": "حَصَاة لُعَابِيَّة (حصاة تتكون في الغدة اللعابية)",
 "siam": "سِيَام",
 "siamang": "سيامانج (جيبون أسود كبير يعيش في سومطرة يتميز بأن إصبعي القدم الثاني والثالث متصلان جزئياً بغشاء)",
 "siamese": "قط سيامي (سلالة نحيلة قصيرة الشعر زرقاء العينين ذات معطف شاحب مع آذان وأقدام ووجه وطرف ذيل داكنة) / تايلاندي, سيامي (من أو متعلق بتايلاند) / تاي, تايلاندي (من أو متعلق بلغات الشعب التايلاندي) / تايلاندي, سيامي (من أو متعلق أو مميز لتايلاند أو شعبها)\nمثال: الحدود التايلاندية مع لاوس",
 "siamese cat": "قِطّ سِيَامِيّ (حَيْوَان مستأنس من عائلة السَنُّورِيّات، له في اللغة أسماء عديدة تذكر وتؤنث)\nمثال: أعطنا هذا القط.",
 "siamese connection": "وصلة سيامية (مدخل به وصلتان أو أكثر يمكن توصيل خرطوم بهما لتمكين سيارات الإطفاء من ضخ المياه في نظام الرش بالمبنى)",
 "siamese twin": "توأم سيامي, توأم ملتصق (أحد زوجي توأم متطابق يولد وجسماهما متصلان في نقطة ما)",
 "sib": "ذو رحم, قريب بالدم (شخص يرتبط بآخر عن طريق الدم أو الأصل؛ خاصة من يشترك في سلف مع آخر) / أخ, أخت (أخ أو أخت الشخص)",
 "siberia": "سِيبِيرِيَا",
 "siberian": "سيبيري (من أو متعلق أو مميز لسيبيريا أو السيبيريين) / سيبيري (مواطن أو ساكن في سيبيريا)\nمثال: موارد طبيعية سيبيرية",
 "siberian crab": "تفاح سيبيري بري (تفاح بري آسيوي يزرع في العديد من الأصناف لفاكهته الحمراء الصغيرة الحمضية عادة المستخدمة للحفظ)",
 "siberian crab apple": "تفاح سيبيري بري (تفاح بري آسيوي يزرع في العديد من الأصناف لفاكهته الحمراء الصغيرة الحمضية عادة المستخدمة للحفظ)",
 "siberian elm": "دردار سيبيري (شجرة آسيوية شجيرية سريعة النمو توطنت في الولايات المتحدة للمأوى أو الزينة)",
 "siberian husky": "هَسْكِي سِيبِيرِيّ",
 "siberian larch": "أرزية سيبيرية (أرزية متوسطة الحجم من شمال شرق روسيا وسيبيريا لها تاج مخروطي ضيق وأوراق خضراء زاهية ضيقة ناعمة؛ تستخدم في الزراعة)",
 "siberian millet": "دخن سيبيري (دخن بحبوب برتقالية إلى محمرة في سنابل طويلة شائكة)",
 "siberian pea tree": "شجرة البازلاء السيبيرية (شجيرة شائكة كبيرة من شرق آسيا لها عناقيد من الزهور الصفراء؛ تزرع غالباً في مصدات الرياح والتحوطات)",
 "siberian spruce": "تنوب سيبيري (تنوب طويل من شمال أوروبا وآسيا؛ يشبه التنوب النرويجي)",
 "siberian wall flower": "إريسيموم, منثور سيبيري (نبات مبهرج منتصب ثنائي الحول أو معمر قصير العمر يزرع لعناقيده الطرفية من الزهور البرتقالية الصفراء؛ يوضع أحياناً في جنس خيري)",
 "sibilant": "صَفِيرِيّ / حَرْفُ صَفِير (طَرَف وَجَانِب وَحَدّ؛ رَمْز مخطوط أو مطبوع يقوم مقام صوت أو كلمة أو عبارة أو معنى)\nمثال: ألف هو الحرف الأول للألف باء.",
 "sibilant consonant": "صوت صفيري (صامت يتميز بصوت هسهسة (مثل س أو ش))",
 "sibilation": "تصفير, هسيس (نطق بصوت صفيري (هسهسة أو تصفير)) / فحيح, هسهسة (صوت احتكاكي (خاصة كتعبير عن عدم الموافقة))\nمثال: لم يكن من الممكن سماع المؤدين فوق هسهسة الجمهور",
 "sibine": "سومراي (لغة تشادية يتم التحدث بها في تشاد)",
 "sibine language": "سومراي (لغة تشادية يتم التحدث بها في تشاد)",
 "sibley tent": "خيمة سيبلي (خيمة قماشية مخروطية خفيفة تنصب على حامل ثلاثي مع تهوية في الأعلى)",
 "sibling": "شَقِيق, شَقِيقَة (كل ما شُقَّ نصفين فكل من النصفين شقيق الآخر؛ الأخ من نفس الأم والأب)\nمثال: لا أحد هناك عرف أن توم هو شقيق ماري.",
 "sibyl": "عرافة ((في روما القديمة) امرأة كانت تعتبر وسيطاً روحياً أو نبياً) / عرافة (امرأة تقرأ البخت)",
 "sibyllic": "عِرَافِيّ, كَهَنُوتِيّ (يُشبِه أو يتّسم بسمات نبيّ أو نبوءة)",
 "sibylline": "رَمْزِيّ, قَبَّالِيّ (له معنى سرّي أو خفيّ) / عِرَافِيّ, كَهَنُوتِيّ (يُشبِه أو يتّسم بسمات نبيّ أو نبوءة)",
 "sic": "كَذَا",
 "siccative": "عامل تجفيف, مادة مجففة (مادة تعزز الجفاف (مثل أكسيد الكالسيوم الذي يمتص الماء ويستخدم لإزالة الرطوبة)) / مجفف زيت (مادة تعزز الجفاف (تستخدم لتجفيف الزيوت والدهانات))",
