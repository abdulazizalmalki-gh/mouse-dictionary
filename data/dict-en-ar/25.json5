 "silex": "سايلكس, صانعة قهوة بالتفريغ (صانعة قهوة تعمل بتقنية التفريغ الهوائي) / سيليكس (شكل نقي من السيليكا المطحونة ناعماً)",
 "silhouette": "خَيَال, سَوَاد (الخَيَّالُ : صَاحبُ الخيول؛ الخَيَّالُ : فارس الخيول)\nمثال: يحب الخيال العلمي.",
 "siliana": "سليانَة",
 "silica": "ثاني أكسيد السيليكون, سيليكا",
 "silica gel": "جل السيليكا, هلام السيليكا (شكل مسامي من السيليكا عالي الامتصاص)",
 "silicate": "سيليكات (ملح أو إستر مشتق من حمض السيليسيليك)",
 "siliceous": "سيليسي (متعلق بـ أو يحتوي على أو يشبه السيليكا)\nمثال: الصخر الرملي هو حجر رملي سيليسي",
 "silicic acid": "حمض السيليسيليك (مادة هلامية (سيليكا مائية))",
 "silicide": "سيليسيد (أي من مركبات السيليكون المختلفة مع عنصر أو شق أكثر إيجابية كهربائية)",
 "silicious": "سيليسي (متعلق بـ أو يحتوي على أو يشبه السيليكا)\nمثال: الصخر الرملي هو حجر رملي سيليسي",
 "silicle": "خُرَيْدِلَة (خردلة (قرنة) قصيرة وعريضة توجد في بعض النباتات الصليبية)",
 "silicon bronze": "برونز سيليكوني (برونز يحتوي على 2-3% سيليكون ومقاوم للتآكل)",
 "silicon carbide": "كربيد السيليكون",
 "silicon chip": "رقاقة, رقاقة دقيقة (معدات إلكترونية تتكون من بلورة صغيرة من شبه موصل السيليكون مصنعة لتنفيذ عدد من الوظائف الإلكترونية في دائرة متكاملة)",
 "silicon dioxide": "ثاني أكسيد السيليكون, سيليكا",
 "silicon oxide": "ثاني أكسيد السيليكون, سيليكا",
 "silicon valley": "وَادِي اَلسِّيلِكُون",
 "silicone": "سيليكون (أي من فئة كبيرة من السيلوكسانات المستقرة بشكل غير عادي عبر نطاق واسع من درجات الحرارة؛ تستخدم في مواد التشحيم والمواد اللاصقة والطلاء والمطاط الصناعي…)",
 "silicone polymer": "سيليكون (أي من فئة كبيرة من السيلوكسانات المستقرة بشكل غير عادي عبر نطاق واسع من درجات الحرارة؛ تستخدم في مواد التشحيم والمواد اللاصقة والطلاء والمطاط الصناعي…)",
 "silicone resin": "راتنج السيليكون (مركب سيليكون بوليمري)",
 "silicone rubber": "مطاط السيليكون (مصنوع من إلاستومرات السيليكون؛ يحتفظ بالمرونة وقوة الشد عبر نطاق واسع من درجات الحرارة)",
 "silicosis": "سَحَار سِيلِيسِيّ",
 "siliqua": "خَرْدَلَة, قَرْنَة (كبسولة بذور ضيقة ومستطيلة تميز الفصيلة الصليبية)",
 "silique": "خَرْدَلَة, قَرْنَة (كبسولة بذور ضيقة ومستطيلة تميز الفصيلة الصليبية)",
 "silk": "حَرِير, إبْرِيسِم",
 "silk cotton": "قطن حريري, كابوك (ألياف نباتية من شجرة الكابوك؛ تستخدم للحشو والعزل)",
 "silk gland": "غدة الحرير (غدة منتجة للحرير في الحشرات (خاصة دودة القز) أو العناكب)",
 "silk grass": "أرز الجبل, عشب الحرير (عشب علفي قيم في المناطق المرتفعة الجافة وسهول غرب أمريكا الشمالية إلى شمال المكسيك)",
 "silk hat": "قبعة رسمية, قبعة عالية (قبعة رجالية ذات تاج عالٍ؛ عادة ما تكون مغطاة بالحرير أو بفرو القندس)",
 "silk oak": "بلوط حريري (أي من عدة أشجار خشبية أسترالية لها عادة أوراق تشبه السرخس وخشب مرقط يستخدم في الخزائن والقشرة الخشبية)",
 "silk road": "طَرِيق اَلْحَرِير (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من ٱلشَّارِعِ، سَبِيل)\nمثال: أسأل عن الطريق.",
 "silk screen print": "سيريغرافيا, طباعة حريرية (مطبوعة مصنوعة باستخدام عملية الاستنسل حيث يتم تركيب صورة أو تصميم على شاشة شبكية دقيقة جداً ويتم ضغط حبر الطباعة على سطح الطباعة من خلال منطقة الشاشة…)",
 "silk serge": "حرير مبرد, سيرج حريري (قماش حريري مبرد يستخدم غالباً لتبطين أجزاء من معاطف الرجال)",
 "silk stocking": "جوارب حريرية, جوارب نايلون (جوارب نسائية مصنوعة من مادة شفافة (نايلون أو رايون أو حرير))",
 "silk tree": "ألبيزيا زهرة الحرير, شجرة الحرير (شجرة آسيوية جذابة مقببة أو مسطحة القمة لها أوراق ريشية مزدوجة وزهور بأسدية حريرية طويلة)",
 "silk vine": "بيريبلوكا, كرمة الحرير (متسلق متساقط الأوراق للأقواس والأسوار له أزهار مثيرة للاهتمام ولكن كريهة الرائحة وثمار صفراء سامة؛ يزرع لأوراقه اللامعة الداكنة؛ جنوب شرق أوروبا إلى…)",
 "silk wood": "شجرة كالابور, كرز جامايكي (شجرة استوائية أمريكية سريعة النمو دائمة الخضرة ذات أزهار بيضاء وثمار صالحة للأكل لحمية؛ ينتج اللحاء أليافاً حريرية تستخدم في الحبال والخشب قيم للألواح)",
 "silk-cotton tree": "شجرة القطن الحريري, قابوق (شجرة استوائية ضخمة ذات تلال عميقة على جذعها الضخم وتحمل قروناً كبيرة من البذور مغطاة بزغب حريري؛ مصدر لألياف القابوق الحريرية)",
 "silk-lined": "مُبَطَّن بِالحَرِير (لَهُ بِطانَة مِنَ الحَرير)",
 "silken": "حَرِيرِيّ, نَاعِم اللَّمَعَان (ذُو سَطْح أَمْلَس لَامِع يَعْكِس الضَّوْء؛ نَاعِم كَالحَرِير)",
 "silkgrass": "أرز الجبل, عشب الحرير (عشب علفي قيم في المناطق المرتفعة الجافة وسهول غرب أمريكا الشمالية إلى شمال المكسيك)",
 "silkily": "بحريرية, بنعومة (بطريقة ناعمة كالحرير)\nمثال: تألق القمح الصغير بنعومة",
 "silkiness": "حريرية, نعومة (الملمس الناعم لقماش الحرير)",
 "silklike": "حَرِيرِيّ, نَاعِم اللَّمَعَان (ذُو سَطْح أَمْلَس لَامِع يَعْكِس الضَّوْء؛ نَاعِم كَالحَرِير)",
 "silks": "زي الجوكي الحريري (الملابس زاهية الألوان للفارس (الجوكي)؛ ترمز للإسطبل)",
 "silkscreen": "سيريغرافيا, طباعة حريرية (مطبوعة مصنوعة باستخدام عملية الاستنسل حيث يتم تركيب صورة أو تصميم على شاشة شبكية دقيقة جداً ويتم ضغط حبر الطباعة على سطح الطباعة من خلال منطقة الشاشة…)",
 "silkweed": "صقلاب, عشبة اللبن",
 "silkwood": "شجرة كالابور, كرز جامايكي (شجرة استوائية أمريكية سريعة النمو دائمة الخضرة ذات أزهار بيضاء وثمار صالحة للأكل لحمية؛ ينتج اللحاء أليافاً حريرية تستخدم في الحبال والخشب قيم للألواح)",
 "silkworm": "دُودَة اَلْقَزّ",
 "silkworm moth": "عثة دودة القز (عثة آسيوية متوسطة الحجم تتغذى يرقاتها على أوراق التوت وتنتج الحرير) / عثة دودة القز العملاقة (أي عثة دودة قز من فصيلة ساتورنيداي)",
 "silkworm seed": "بيض دودة القز (بيض دودة القز)",
 "silky": "حَرِيرِيّ, نَاعِم اللَّمَعَان (ذُو سَطْح أَمْلَس لَامِع يَعْكِس الضَّوْء؛ نَاعِم كَالحَرِير)",
 "silky anteater": "آكل النمل الحريري (آكل نمل من أمريكا الجنوبية بحجم السنجاب وعديم الأسنان ذو فرو ذهبي حريري طويل)",
 "silky cornel": "قرانيا أموموم, قرانيا حريرية (شجيرة من شرق أمريكا الشمالية لها سيقان أرجوانية وثمار زرقاء)",
 "silky dogwood": "قرانيا حريرية / قرانيا أموموم, قرانيا حريرية (شجيرة من شرق أمريكا الشمالية لها سيقان أرجوانية وثمار زرقاء)",
 "silky elm": "زان أحمر, هريتييرا ثلاثية الأوراق (شجرة كبيرة من أسترالاسيا)",
 "silky oak": "بلوط حريري (شجرة متوسطة إلى طويلة سريعة النمو بزهور برتقالية وأوراق ريشية ثنائية ريشية حريرية الشعر من الأسفل؛ شرق أستراليا)",
 "silky pocket mouse": "فأر جيبي حريري (قارض صغير ناعم الفراء مصفر شاحب يعيش في جنوب غرب الولايات المتحدة والمكسيك)",
 "silky tamarin": "طمارين حريري (قرد ذهبي من أمريكا الجنوبية ذو شعر طويل ناعم يشكل عرفاً)",
 "silky terrier": "تيريير حريري, سيلكي تيريير (سلالة أسترالية من الكلاب اللعبة ذات فراء أزرق حريري)",
 "silky willow": "صفصاف حريري, صفصاف فضي (صفصاف أمريكي شمالي بأوراق رمادية حريرية وبرية تسود عادة عند التجفيف) / صفصاف سيتكا (شجرة شجيرية صغيرة في غرب أمريكا الشمالية (من ألاسكا إلى أوريغون))",
 "silky wisteria": "ستارية حريرية, ويستيريا حريرية (ستارية من الصين لها زهور بيضاء)",
 "silky-haired": "حَرِيرِيّ الشَّعْر (ذو شعر ناعم يشبه الحرير)",
 "silky-leafed": "حَرِيرِيّ الأَوْرَاق (ذو أوراق لامعة حريرية الملمس)",
 "silky-leaved": "حَرِيرِيّ الأَوْرَاق (ذو أوراق لامعة حريرية الملمس)",
 "sill": "عتبة (عضو هيكلي يتكون من خشب أفقي مستمر يشكل العضو السفلي لإطار أو هيكل داعم) / سِيل, قَاطِع أُفُقِيّ ((جيولوجيا) كتلة مسطحة (أفقية عادة) من الصخور النارية بين طبقتين من الصخور الرسوبية الأقدم)",
 "sillabub": "سيلابوب (كريمة محلاة مخفوقة مع النبيذ أو المشروب الكحولي) / سيلابوب (حليب ساخن متبل مع الروم أو النبيذ)",
 "silliness": "خفة عقل, سخافة (أسلوب متهور ومشوش) / سخافة, عبث (حماقة مثيرة للسخرية)\nمثال: ضحك الحشد على سخافة سلوك المهرج",
 "silly": "سَخِيف",
 "silly season": "موسم السخافة (وقت عادة ما يكون أواخر الصيف يتميز بقصص إخبارية مبالغ فيها حول أمور تافهة لعدم وجود أخبار حقيقية)",
 "silo": "صَوْمَعَة",
 "siloxane": "سيلوكسان (أي من فئة كبيرة من المركبات التي تحتوي على ذرات سيليكون وأكسجين متناوبة)",
 "silphium laciniatum": "سلفيوم مشرشر, عشبة الراتنج (نبات معمر من أمريكا الشمالية له رائحة راتنجية وزهور صفراء)",
 "silt": "غَرِين",
 "siltstone": "حجر غريني (حجر رملي ناعم الحبيبات من الغرين المتماسك)",
 "silty": "طَمْيِيّ, غِرْيَنِيّ (مليء بالطمي والرواسب الدقيقة)",
 "silurid": "سلوريات (أسماك سلور المياه العذبة في العالم القديم ذات جلد عار وزعنفة شرجية طويلة تندمج تقريباً مع الزعنفة الذيلية التي تشبه ذيل الثعبان)",
 "silurid fish": "سلوريات (أسماك سلور المياه العذبة في العالم القديم ذات جلد عار وزعنفة شرجية طويلة تندمج تقريباً مع الزعنفة الذيلية التي تشبه ذيل الثعبان)",
 "siluriform fish": "سلور, سمك السلور (أي من الأسماك العديدة التي تعيش غالباً في قاع المياه العذبة في أوراسيا وأمريكا الشمالية، ولها زوائد تشبه الشوارب حول الفم)",
 "silurus glanis": "سلور أوروبي (سلور ممدود كبير يعيش في وسط وشرق أوروبا)",
 "silva": "أشجار الغابة, سيلفا (أشجار الغابات التي تنمو في بلد أو منطقة معينة)",
 "silvan": "مَيَّافَارِقِين",
 "silver": "فِضَّة (فِي : فِلِزّ أَبْيَض قَابِلٌ لِلسَّحب والطَّرْق والصَّقْل، من أكثر المواد توصيلاً للحَرَارَة والكَهْرَبَاء…) / فِضِّيّ, لُجَيْن\nمثال: يقدر القبايل الفضة أكثر من الذهب.",
 "silver age": "عَصْر فِضِّيّ (مصدر للفعل \"عَصَرَ\"؛ أي مدة زمنية، دهر من الوقت)\nمثال: صلى زيري العصر.",
 "silver ash": "رماد فضي, فليندرسيا (أي من أشجار الأخشاب المتنوعة من جنس فليندرسيا)",
 "silver beech": "زان فضي (زان نيوزيلندي بلحاء فضي شاحب عادة)",
 "silver bell": "جرس فضي, هاليزية (أي من الأشجار المتساقطة الأوراق المختلفة من جنس هاليزية ذات زهور بيضاء على شكل جرس)",
 "silver berry": "توت فضي, شجيرة فضية (شجيرة أمريكية شمالية متساقطة الأوراق غير شوكية بأوراق وثمار فضية) / توت فضي, زيتون روسي (شجرة شجيرية متساقطة الأوراق من أوروبا وغرب آسيا لها أوراق رمادية وثمار صفراء صغيرة مغطاة بقشور فضية؛ شوكية أحياناً)",
 "silver birch": "بتولا بيضاء أوروبية, بتولا فضية (بتولا أوروبية بلحاء أبيض فضي مقشر وفروع متدلية بشكل ملحوظ)",
 "silver bromide": "بروميد الفضة (بروميد يغمق لونه عند تعرضه للضوء؛ يُستخدم في صنع المستحلبات الفوتوغرافية)",
 "silver bullet": "رَصَاصَة الْفُضَّة",
 "silver certificate": "شهادة فضية (ورقة نقدية كانت تصدرها الخزانة الأمريكية وقابلة للاستبدال بالفضة)",
 "silver chloride": "كلوريد الفضة (كلوريد يستخدم بشكل رئيسي في تصنيع المستحلبات الفوتوغرافية)",
 "silver cord": "حَبْل فِضِّيّ, رَابِطَة عاَطِفِيَّة (الرابط العاطفي بين الأم ونسلها)",
 "silver dollar": "زهرة الدراهم, لوناريا (نبات من جنوب شرق أوروبا يُزرع لأزهاره الأرجوانية العطرة وقرون بذوره الورقية الفضية البيضاء المستديرة المسطحة التي تستخدم للزينة الداخلية) / دولار فضي (دولار مصنوع من الفضة)",
 "silver fern": "سرخس فضي (سرخس من جنوب إفريقيا الاستوائية له سعف بجوانب سفلية بيضاء) / سرخس فضي (سرخس أمريكي استوائي له سعف بجوانب سفلية بيضاء)",
 "silver fir": "شوح فضي (أي من أشجار الشوح الحقيقية المختلفة التي تكون أوراقها بيضاء أو بيضاء فضية من الأسفل)",
 "silver fox": "ثعلب فضي (ثعلب أحمر في الطور اللوني الذي يكون فيه فراءه ذو أطراف بيضاء)",
 "silver grass": "عشب فضي (من أستراليا ونيوزيلندا)",
 "silver gray": "رمادي رمادي, فضي (درجة فاتحة من الرمادي)",
 "silver grey": "رمادي رمادي, فضي (درجة فاتحة من الرمادي)",
 "silver hake": "نازلي فضي (يوجد قبالة ساحل المحيط الأطلسي لأمريكا الشمالية)",
 "silver iodide": "يوديد الفضة (يوديد يُستخدم في التصوير الفوتوغرافي، وفي استمطار السحب، وفي الطب)",
 "silver jenny": "جيني الفضية (موجارا فضية توجد على طول الشواطئ الرملية لغرب المحيط الأطلسي)",
 "silver jubilee": "يوبيل فضي (ذكرى سنوية تحتفل بمرور 25 عامًا)",
 "silver lace": "دانتيل فضي, طاحونة الغبار (شجيرة معمرة في جزر الكناري ذات زهور وأوراق بيضاء وسيقان مشعرة مغطاة بزغب يشبه الغبار؛ توضع أحياناً في جنس الأقحوان)",
 "silver lace vine": "كرمة الدانتيل الفضي, كرمة الصوف الصيني (كرمة معمرة ملتفة لها عناقيد من الزهور المخضرة العطرية؛ غرب الصين إلى روسيا)",
 "silver lime": "زيزفون فضي (شجرة كبيرة موطنها شرق أوروبا وآسيا الصغرى لها أوراق بزغب أبيض على الجانب السفلي؛ تُزرع على نطاق واسع للزينة)",
 "silver linden": "زيزفون فضي (شجرة كبيرة موطنها شرق أوروبا وآسيا الصغرى لها أوراق بزغب أبيض على الجانب السفلي؛ تُزرع على نطاق واسع للزينة)",
 "silver lining": "بصيص أمل, جانب مضيء (جانب مواسٍ لموقف صعب)\nمثال: كل سحابة لها جانب مضيء",
 "silver maple": "قيقب فضي (شجرة قيقب شائعة في أمريكا الشمالية؛ أوراقها خماسية الفصوص خضراء فاتحة من الأعلى وبيضاء فضية من الأسفل؛ مصدر لخشب بني فاتح صلب متقارب الحبيبات ولكنه هش)",
 "silver medal": "فضية, ميدالية فضية (كأس مصنوعة من الفضة (أو لها مظهر الفضة) تمنح عادة للفائز بالمركز الثاني في المسابقة)",
 "silver mine": "منجم فضة (منجم يُستخرج منه خام الفضة)",
 "silver nitrate": "نترات الفضة (نترات تستخدم في صنع المستحلبات الفوتوغرافية؛ وتستخدم أيضاً في الطب للكي وكعامل مضاد للبكتيريا موضعي)",
 "silver oak": "بلوط فضي (شجرة نحيلة صغيرة بأوراق متدلية خضراء رمادية كاملة عادة وزهور بيضاء أو كريمية اللون؛ شمال أستراليا)",
 "silver perch": "فرخ أبيض (سمكة غذائية ورياضية فضية صغيرة في جداول شرق الولايات المتحدة) / فرخ فضي (سمكة طبل فضية صغيرة غالباً ما يُخطأ بينها وبين الفرخ الأبيض؛ توجد على طول سواحل الولايات المتحدة من نيويورك إلى المكسيك)",
 "silver pine": "صنوبر أبيض غربي, صنوبر فضي (صنوبر طويل من غرب أمريكا الشمالية بإبر زرقاء خضراء قوية؛ اللحاء رمادي بني بصفائح مستطيلة عند النضج) / صنوبر فضي, صنوبر ويستلاند (شجرة خشبية في نيوزيلندا ذات خشب أبيض لامع)",
 "silver plate": "طلاء بالفضة (طبقة رقيقة من الفضة مترسبة على شيء ما) / أواني مطلية بالفضة (أدوات مائدة مطلية بالفضة)",
 "silver protein": "بروتين الفضة (مستحضر غرواني من البروتين (الألبومين أو الجيلاتين) وأكسيد الفضة؛ يستخدم في محلول مائي كعامل مضاد للبكتيريا)",
 "silver quandong": "كواندونغ فضي (خشب شاحب سهل العمل من شجرة الكواندونغ)",
 "silver quandong tree": "تين أزرق, شجرة الكواندونج (شجرة أسترالية ذات خشب أبيض صلب وأوراق خضراء لامعة مع أزهار بيضاء تليها ثمرة زرقاء لامعة ذات بذرة واحدة)",
 "silver sage": "شيح فضي, ميرمية فضية (نبات معمر منخفض كثير التفرع في غرب الولايات المتحدة ذو أوراق فضية؛ نبات علف ومأوى مهم)",
 "silver sagebrush": "شيح فضي, ميرمية فضية (نبات معمر منخفض كثير التفرع في غرب الولايات المتحدة ذو أوراق فضية؛ نبات علف ومأوى مهم)",
 "silver salmon": "سلمون فضي, سلمون كوهو (سلمون صغير من سواحل شمال المحيط الهادئ والبحيرات العظمى) / سلمون فضي, سلمون كوهو (لحم وردي دهني لسلمون صغير يتم اصطيده في المحيط الهادئ والبحيرات العظمى)",
 "silver screen": "شاشة عرض (سطح أبيض أو فضي يمكن عرض الصور عليه للمشاهدة) / الشاشة الفضية (صناعة السينما والأفلام)",
 "silver solder": "لحام فضة (سبيكة لحام تحتوي على الفضة)",
 "silver spoon": "مال قديم, ملعقة من ذهب (الثروة الموروثة لعائلات الطبقة العليا الراسخة)\nمثال: ولد وفي فمه ملعقة من ذهب",
 "silver spruce": "تنوب أزرق, تنوب كولورادو (تنوب طويل بإبر زرقاء خضراء وتاج مخروطي كثيف؛ الأشجار الأقدم تصبح عمودية مع فروع سفلية تتجه للأسفل)",
 "silver standard": "معيار الفضة (معيار نقدي يتم بموجبه تعريف الوحدة الأساسية للعملة بكمية محددة من الفضة)",
 "silver star": "النجمة الفضية (وسام عسكري أمريكي للشجاعة في المعركة)",
 "silver star medal": "النجمة الفضية (وسام عسكري أمريكي للشجاعة في المعركة)",
 "silver storm": "عاصفة جليدية (عاصفة ذات مطر متجمد يغطي كل شيء بطبقة من الجليد)",
 "silver thatch": "نخيل القش, نخيل المكنسة (نخيل صغير من جنوب فلوريدا وجزر الهند الغربية يشبه كثيراً بالميتو الفضي) / بالميتو فضي, نخيل المفتاح (نخيل مروحي ممتلئ الجسم صغير من جنوب فلوريدا وكوبا)",
 "silver tree": "شجرة الفضة (شجرة خشبية أسترالية) / شجرة الفضة (شجرة صغيرة من جنوب أفريقيا ذات أوراق حريرية فضية طويلة)",
 "silver tree fern": "سرخس شجري أسود, سرخس شجري فضي (سرخس شجري مبهرج في نيوزيلندا وأستراليا له تاج من السعف الريشي بجوانب سفلية بيضاء)",
 "silver vine": "أكتينيديا مضلعة, كرمة فضية (كرمة زينة من شرق آسيا لها ثمار صفراء صالحة للأكل وأوراق ذات علامات بيضاء فضية)",
 "silver wattle": "سنط فضي, ميموزا (شجرة أسترالية دائمة الخضرة ذات لحاء وأوراق صغيرة بيضاء أو فضية وزهور صفراء)",
 "silver wedding anniversary": "يوبيل فضي للزواج (الذكرى السنوية الخامسة والعشرون للزواج)",
 "silver whiting": "بياض فضي (سمكة بياض فضية باهتة في جنوب المحيط الأطلسي وسواحل الخليج في الولايات المتحدة)",
 "silver willow": "صفصاف حريري, صفصاف فضي (صفصاف أمريكي شمالي بأوراق رمادية حريرية وبرية تسود عادة عند التجفيف)",
 "silver-bell tree": "شجرة الجرس الفضي, شجرة قطرة الثلج (شجرة متوسطة الحجم من فرجينيا الغربية إلى فلوريدا وتكساس)",
 "silver-blue": "أَزْرَق فِضِّيّ (بلون أزرق فاتح لامع)",
 "silver-bodied": "فِضِّيُّ الجَسَد (لَهُ جَسَدٌ فِضِّيُّ اللَّوْن)",
 "silver-bush": "توت فضي, شجيرة فضية (شجيرة أمريكية شمالية متساقطة الأوراق غير شوكية بأوراق وثمار فضية) / شجيرة الفضة, لحية المشتري (شجيرة أوروبية مشعرة فضية ذات أوراق دائمة الخضرة وأزهار صفراء باهتة)",
 "silver-colored": "فِضِّيّ اللَّوْن (ذو لون الفضّة)",
 "silver-gray": "رَمَادِيّ فِضِّيّ (رمادي يشبه لون الفضة)",
 "silver-green": "أَخْضَر فِضِّيّ (بلون أخضر فاتح لامع)",
 "silver-grey": "رَمَادِيّ فِضِّيّ (رمادي يشبه لون الفضة)",
 "silver-haired": "فِضِّيّ الشَّعْر (ذو شعر بلون الفضة)",
 "silver-lace": "دانتيل فضي, طاحونة الغبار (شجيرة معمرة في جزر الكناري ذات زهور وأوراق بيضاء وسيقان مشعرة مغطاة بزغب يشبه الغبار؛ توضع أحياناً في جنس الأقحوان)",
 "silver-leafed": "فِضِّيّ الأَوْرَاق (ذو أوراق فضية اللون)",
 "silver-leaved": "فِضِّيّ الأَوْرَاق (ذو أوراق فضية اللون)",
 "silver-leaved nettle": "باذنجان بري, مغد فضي الأوراق (نبات مغد ضار بأوراق فضية وزهور بنفسجية أو زرقاء أو بيضاء؛ تستخدم ثمرته المستديرة على نطاق واسع لتخثير الحليب؛ من وسط الولايات المتحدة إلى أمريكا…)",
 "silver-leaved nightshade": "باذنجان بري, مغد فضي الأوراق (نبات مغد ضار بأوراق فضية وزهور بنفسجية أو زرقاء أو بيضاء؛ تستخدم ثمرته المستديرة على نطاق واسع لتخثير الحليب؛ من وسط الولايات المتحدة إلى أمريكا…)",
 "silver-leaved poplar": "حور أبيض (حور يزرع على نطاق واسع في الولايات المتحدة؛ له لحاء أبيض وأوراق ذات أسطح سفلية بيضاء)",
 "silver-scaled": "فِضِّيّ القُشُور (مُغطَّى الجسم كلّيًّا أو جزئيًّا بقشور فضّيّة اللون)",
 "silver-tip": "دب أشيب, دب رمادي (دب بني مصفر قوي من مرتفعات غرب أمريكا الشمالية)",
 "silver-tongued": "بَلِيغ, طَلِيق اللِّسَان (يُعبِّر عن نفسه بسهولة ووضوح وفعاليّة)",
 "silver-white": "أَبْيَض فِضِّيّ (أبيض يشبه لون الفضة)",
 "silver-worker": "صائغ فضة (شخص يصنع أو يصلح المصنوعات الفضية)",
 "silverback": "غوريلا فضية الظهر (ذكر غوريلا بالغ ذو شعر رمادي عبر الظهر)",
 "silverbell tree": "شجرة الجرس الفضي, شجرة قطرة الثلج (شجرة متوسطة الحجم من فرجينيا الغربية إلى فلوريدا وتكساس)",
 "silverberry": "توت فضي, شجيرة فضية (شجيرة أمريكية شمالية متساقطة الأوراق غير شوكية بأوراق وثمار فضية)",
 "silverbush": "توت فضي, شجيرة فضية (شجيرة أمريكية شمالية متساقطة الأوراق غير شوكية بأوراق وثمار فضية) / شجيرة الفضة, لحية المشتري (شجيرة أوروبية مشعرة فضية ذات أوراق دائمة الخضرة وأزهار صفراء باهتة)",
 "silverfish": "السمكة الفضية (نوع فضي من السمك الذهبي) / سمكة الفضة (حشرة فضية رمادية غير مجنحة توجد في المنازل وتتغذى على أغلفة الكتب والملابس المنشاة)",
 "silverish": "فِضِّيّ (بلون رمادي لامع؛ مكسو أو مصبوغ بلون الفضة)",
 "silverleaf nightshade": "باذنجان بري, مغد فضي الأوراق (نبات مغد ضار بأوراق فضية وزهور بنفسجية أو زرقاء أو بيضاء؛ تستخدم ثمرته المستديرة على نطاق واسع لتخثير الحليب؛ من وسط الولايات المتحدة إلى أمريكا…)",
 "silvern": "فِضِّيّ اللَّمَعَان (ذُو بَرِيق أَبْيَض لَامِع كَبَرِيق الفِضَّة) / فِضِّيّ الرَّنِين (يُشْبِه رَنِين الفِضَّة أَوْ يُذَكِّر بِه)",
 "silverpoint": "رسم بسن فضي (رسم مصنوع على ورق معد خصيصاً بأداة ذات طرف فضي (القرنين الخامس عشر والسادس عشر))",
 "silverrod": "سوليداجو ثنائي اللون, عصا الفضة (نبات من شرق أمريكا الشمالية ذو أزهار بيضاء كريمية)",
 "silverside": "فضية الجوانب (أسماك صغيرة لها شريط فضي على طول كل جانب؛ وفيرة على طول ساحل المحيط الأطلسي للولايات المتحدة)",
 "silversides": "جوانب الفضة, شاينر الشائع (سمكة الشاينر الشائعة في أمريكا الشمالية) / فضية الجوانب (أسماك صغيرة لها شريط فضي على طول كل جانب؛ وفيرة على طول ساحل المحيط الأطلسي للولايات المتحدة)",
 "silversmith": "صائغ فضة (شخص يصنع أو يصلح المصنوعات الفضية)",
 "silverspot": "فراشة فضية البقع (فراشة ذات بقع فضية على الجانب السفلي من الأجنحة الخلفية)",
 "silversword": "سيف الفضة (نبات منخفض النمو يوجد فقط في الفوهات البركانية في هاواي له وريدات من أوراق خضراء فضية مدببة ضيقة وعناقيد من الزهور الحمراء الأرجوانية الغزيرة على ساق…)",
 "silvertip": "دب أشيب, دب رمادي (دب بني مصفر قوي من مرتفعات غرب أمريكا الشمالية)",
 "silvertop palmetto": "بالميتو فضي, نخيل المفتاح (نخيل مروحي ممتلئ الجسم صغير من جنوب فلوريدا وكوبا)",
 "silvervine": "أكتينيديا مضلعة, كرمة فضية (كرمة زينة من شرق آسيا لها ثمار صفراء صالحة للأكل وأوراق ذات علامات بيضاء فضية)",
 "silverware": "أواني فضية (أدوات مائدة مصنوعة من الفضة أو الفضة المطلية أو البيوتر أو الفولاذ المقاوم للصدأ)",
 "silverweed": "إوزية, عشبة الفضة (نبات معمر منخفض النمو له أوراق فضية من الأسفل؛ شمال الولايات المتحدة، أوروبا، آسيا) / أرجيريا, عشبة الفضة",
 "silverwork": "مشغولات فضية (عمل زخرفي مصنوع من الفضة)",
 "silverworker": "صائغ فضة (شخص يصنع أو يصلح المصنوعات الفضية)",
 "silvery": "لُجَيْن (فِضَّة؛ اسم شخصي معطًى للإناث من العرب)",
 "silvery spleenwort": "سرخس الفسحة, طحال فضي (سرخس من أمريكا الشمالية بسعف ضيق على أعناق صفراء) / ديباريا, طحال فضي (سرخس بنموات فضية ممدودة تحيط بالأبواغ النامية)",
 "silvery wormwood": "شيح فضي, ميرمية الرمل (شجيرة فضية الشعر في وسط وجنوب الولايات المتحدة والمكسيك؛ عشبة ضارة مزعجة في المراعي)",
 "silvery-blue": "أَزْرَق فِضِّيّ (بلون أزرق فاتح لامع)",
 "silvery-bodied": "فِضِّيُّ الجَسَد (لَهُ جَسَدٌ فِضِّيُّ اللَّوْن)",
 "silvery-gray": "رَمَادِيّ فِضِّيّ (رمادي يشبه لون الفضة)",
