 "sink": "غَطَسَ / مَجْلَى, مَغْسَلَة",
 "sink plug": "سدادة حوض (سدادة مخصصة لأحواض الغسيل وأحواض الاستحمام وحاويات المياه المماثلة)",
 "sinkable": "قابل للغرق (يمكن إغراقه)",
 "sinker": "كرة هابطة (رمية تنحني للأسفل بسرعة عند اقترابها من اللوحة) / ثقالة (وزن يغرق (لتثبيت الشباك أو خيوط الصيد تحت الماء)) / دونات, كعكة مقلية (كعكة مقلية صغيرة على شكل حلقة)",
 "sinkhole": "بَالُوعَة, بَلَّاعَة",
 "sinking": "غَرَق",
 "sinking feeling": "انقباض القلب, شعور بالهبوط (شعور ناتج عن عدم الارتياح أو التوجس)\nمثال: بقلب منقبض",
 "sinking fund": "صندوق استهلاك الدين (صندوق يتم تجميعه بانتظام في حساب منفصل ويستخدم لسداد سندات الدين)",
 "sinking spell": "انتكاسة, هبوط (انخفاض مؤقت في الصحة أو القيمة)",
 "sinless": "بَرِيء, طَاهِر (خَالٍ مِنَ الخَطِيئَةِ وَالذَّنْب)",
 "sinlessness": "براءة, طهارة (حالة الخلو من الخطيئة أو الخطأ الأخلاقي؛ الافتقار إلى معرفة الشر)",
 "sinn fein": "شين فين (حركة سياسية جمهورية أيرلندية تأسست عام 1905 لتعزيز الاستقلال عن إنجلترا وتوحيد أيرلندا؛ أصبحت الجناح السياسي للجيش الجمهوري الأيرلندي)",
 "sinner": "خَاطِئ / خَاطِئَة / آثِم (فعل تعدّي من أَثِمَ؛ أوقع في الإِثْم، جعله يَأثَم) / آثِمَة / عَاصٍ / عَاصِيَة",
 "sinning": "إثم, خطيئة (فعل يعتبره اللاهوتيون تجاوزاً لإرادة الله) / آثِم, مُذْنِب (يتعدّى على شريعة أخلاقيّة أو إلهيّة)",
 "sinningia speciosa": "سينينجيا, غلوكسينيا بائعي الزهور (عشب من أمريكا الجنوبية يزرع في العديد من الأصناف كنبات منزلي لأوراقه الكبيرة الوسيمة وأزهاره الكبيرة الجرسية الشكل متنوعة الألوان)",
 "sino-tibetan": "اللغات الصينية التبتية (عائلة اللغات النغمية التي يتم التحدث بها في شرق آسيا)",
 "sino-tibetan language": "اللغات الصينية التبتية (عائلة اللغات النغمية التي يتم التحدث بها في شرق آسيا)",
 "sinoatrial node": "عقدة جيبية أذينية, ناظمة قلبية (قطعة متخصصة من نسيج القلب تتحكم في ضربات القلب)",
 "sinologist": "عالم صينيات (دارس للتاريخ واللغة والثقافة الصينية)",
 "sinology": "علم الصينيات (دراسة التاريخ واللغة والثقافة الصينية)",
 "sinoper": "سينوبيا, مغرة حمراء (مغرة حمراء كانت تستخدم قديماً كصبغة)",
 "sinopia": "سينوبيا, مغرة حمراء (مغرة حمراء كانت تستخدم قديماً كصبغة)",
 "sinopis": "سينوبيا, مغرة حمراء (مغرة حمراء كانت تستخدم قديماً كصبغة)",
 "sinornis": "سينورنيس (طائر أحفوري بحجم العصفور من العصر الجوراسي إلى العصر الطباشيري له عظم صدر جؤجؤي وذيل أثري؛ وجد في الصين)",
 "sint eustatius": "سينت أوستاتيوس",
 "sint maarten": "الْقِدِّيسُ مَارْتِن",
 "sintered": "متكلس, ملبد (مشكل في كتلة بواسطة الحرارة والضغط)",
 "sinuate": "مُتَعَرِّجُ الْحَافَّةِ (ذو حافة متعرّجة ومتموّجة بعمق) / مُتَعَرِّج, مُتَمَوِّج (ينحني ويتعرج إلى الداخل والخارج)",
 "sinuosity": "تعرج, تموج (وجود منعطفات (خاصة في الجداول والطرق))\nمثال: كره تعرج الطرق الجبلية",
 "sinuous": "رَشِيق, لَدِن (نحيل بأناقة ويتحرك وينثني بسهولة ويُسر) / مُتَعَرِّج, مُتَمَوِّج (ينحني ويتعرج إلى الداخل والخارج)",
 "sinuously": "بتعرج, بتموج (بطريقة متعرجة)",
 "sinuousness": "تعرج, تموج (وجود منعطفات (خاصة في الجداول والطرق))\nمثال: كره تعرج الطرق الجبلية",
 "sinus": "جَيْب اَلْأُنْف (جيَّب القميص:جَابَ، جعل له جيبًا)\nمثال: جيب سامي مثقوب.",
 "sinus cavernosus": "جيب كهفي (أي من زوج من الجيوب الوريدية الكبيرة في تجويف الجمجمة)",
 "sinus coronarius": "جيب تاجي (جيب قصير يستقبل معظم أوردة القلب؛ يصب في الأذين الأيمن)",
 "sinus ethmoidales": "جيب غربالي (جيب في ممرات التجويف الأنفي (خلف جسر الأنف))",
 "sinus headache": "صداع الجيوب الأنفية (صداع ناتج عن احتقان أو عدوى في الجيوب الأنفية)",
 "sinus paranasales": "جيب أنفي, جيب جانب أنفي (أي من الجيوب المزدوجة في عظام الوجه المجاورة للتجويف الأنفي والمبطنة بغشاء مخاطي متصل ببطانة تجاويف الأنف)",
 "sinus rectus": "جيب مستقيم (جيب غير مزدوج للأم الجافية)",
