 "slave dealer": "تاجر رقيق (شخص يعمل في تجارة الرقيق)",
 "slave driver": "سائق الرقيق, مسخر العبيد (مشرف على العبيد في العمل) / رب عمل قاس, مُسخِّر (صاحب عمل قاسٍ يطلب عملاً مفرطاً من الموظفين)",
 "slave market": "سوق الرقيق, سوق النخاسة (سوق حيث كان يتم بيع العبيد بالمزاد (خاصة في جنوب الولايات المتحدة قبل الحرب الأهلية الأمريكية))",
 "slave owner": "مالك عبيد (شخص يمتلك عبيداً)",
 "slave ship": "سفينة عبيد (سفينة تستخدم لنقل العبيد من ديارهم إلى أماكن الاستعباد)",
 "slave state": "ولاية عبودية (أي من الولايات الجنوبية التي كانت فيها العبودية قانونية قبل الحرب الأهلية الأمريكية)",
 "slave trade": "تجارة الرقيق (الاتجار في العبيد؛ خاصة الأفارقة السود الذين تم نقلهم إلى أمريكا من القرن 16 إلى 19)",
 "slave trader": "تاجر رقيق (شخص يعمل في تجارة الرقيق)",
 "slave traffic": "تجارة الرقيق (الاتجار في العبيد؛ خاصة الأفارقة السود الذين تم نقلهم إلى أمريكا من القرن 16 إلى 19)",
 "slave-girl": "أَمَة (المرأة المملوكة، خلاف الحرة)\nمثال: الأمة تطلب العدالة الاجتماعية.",
 "slave-maker": "نمل مستعبد (نمل يهاجم مستعمرات أنواع النمل الأخرى ويحمل الصغار لتربيتها كنمل عبيد)",
 "slave-making ant": "نمل مستعبد (نمل يهاجم مستعمرات أنواع النمل الأخرى ويحمل الصغار لتربيتها كنمل عبيد)",
 "slaveholder": "مالك عبيد (شخص يمتلك عبيداً)",
 "slaveholding": "امتلاك العبيد, عبودية (ممارسة امتلاك العبيد) / مُبِيح لِلْعُبُودِيَّة (يَسْمَحُ بِالاسْتِعْبَاد وَيُجِيزُه)",
 "slaveless": "خَالٍ مِنَ العُبُودِيَّة (حَيْثُ كَانَتِ العُبُودِيَّة مَحْظُورَة)",
 "slavelike": "لَائِق بِالعَبِيد (مُنَاسِب لِعَبْد أَوْ خَادِم)",
 "slaver": "نَخَّاس",
 "slavery": "عُبُودِيَّة, رِقّ",
 "slavey": "خادمة (خادمة منزلية تقوم بجميع أنواع الأعمال الوضيعة)",
 "slavic": "سْلَافِيّ, صَقْلَبِيّ",
 "slavic language": "اللغات السلافية (فرع من عائلة اللغات الهندية الأوروبية)",
 "slavic people": "سلافيون, شعب سلافي (مجموعة من الناس يتحدثون لغة سلافية)",
 "slavicness": "الطابع السلافي (حالة أو جودة كون الشيء سلافياً)",
 "slavish": "خَادِمِيّ, عَبْدِيّ (خَاضِع خُضُوعًا مُطْلَقًا؛ مِنْ سِمَات العَبْد أَوِ الخَادِم) / مُقَلِّد بِعَمًى (مُقَلِّد بشكل أعمى ودون تمييز)",
 "slavishly": "بتقليد أعمى, بعبودية (بطريقة العبيد؛ بانقياد تام)\nمثال: آمن أتباعه بعبودية بنظامه الغذائي الجديد",
 "slavonic": "سلافي (من أو متعلق باللغات السلافية) / اللغات السلافية (فرع من عائلة اللغات الهندية الأوروبية)",
 "slavonic language": "اللغات السلافية (فرع من عائلة اللغات الهندية الأوروبية)",
 "slavophilia": "سلافوفيلية, محب السلافية (حركة فكرية نشأت في القرن التاسع عشر أرادت تطوير الإمبراطورية الروسية بناءً على القيم والمؤسسات المستمدة من تاريخها المبكر)",
 "slavophilism": "سلافوفيلية, محب السلافية (حركة فكرية نشأت في القرن التاسع عشر أرادت تطوير الإمبراطورية الروسية بناءً على القيم والمؤسسات المستمدة من تاريخها المبكر)",
 "slaw": "سلطة ملفوف, كولسلو (تتكون أساساً من الملفوف المبشور)",
 "slay": "قَتَلَ, أَزْهَقَ رُوحَهُ (تعمّد جعله يَمُوتُ، أزهق روحه، أمَاتَه متعمدا؛ الوقتَ: ضيعه بشيء غير ذي فائدة وهو ينتظر أمرا آخر)\nمثال: قتل الصياد دبا.",
 "slayer": "سفّاح, قاتل (شخص يتسبب في موت إنسان أو حيوان)",
 "slaying": "اغتيال, جريمة قتل (قتل إنسان لإنسان آخر بشكل غير قانوني ومع سبق الإصرار)",
 "sle": "الذئبة الحمامية المجموعية, الذئبة الحمراء (مرض التهابي يصيب النسيج الضام وله سمات متغيرة تشمل الحمى والضعف وسهولة التعب وآلام المفاصل وآفات جلدية على الوجه أو الرقبة أو الذراعين)",
 "sleaze": "ابْتِذَال, رُخْص (انعدام الذوق لكون الشيء رخيصاً ومبتذلاً)",
 "sleaziness": "بُؤْس, حَقَارَة (انعدام الأناقة نتيجة ارتداء ملابس بالية أو قذرة) / انحطاط, دناءة (مخز أخلاقياً)\nمثال: انحطاط محرج آمل أن تصححه الصحف الأكثر أخلاقية",
 "sleazy": "مُهَلْهَل, رَدِيء (اسم فاعل للفعل \"هَلْهَلَ\") / بَغِيض",
 "sled": "زلاجة (مركبة مثبتة على زحافات وتجرها الخيول أو الكلاب؛ للنقل فوق الثلج)",
 "sled dog": "كلب زلاجات (كلب مدرب لجر زلاجة عادة في فريق)",
 "sledder": "متزلج بالزلاجة (شخص يركب زلاجة)",
 "sledding": "تقدم, سير الأمور (التقدم نحو هدف ما) / تزلج بالمزلاجة (رياضة ركوب الزلاجة)\nمثال: كان إقناعه أمراً سهلاً",
 "sledge": "مطرقة ثقيلة, مِهدَّة (مطرقة ثقيلة طويلة المقبض تستخدم لدق الأوتاد أو الأسافين) / زلاجة (مركبة مثبتة على زحافات وتجرها الخيول أو الكلاب؛ للنقل فوق الثلج)",
 "sledge dog": "كلب زلاجات (كلب مدرب لجر زلاجة عادة في فريق)",
 "sledgehammer": "مِرْزَبَّة, إِرْزَبَّة",
 "sleek": "حَرِيرِيّ, نَاعِم اللَّمَعَان (ذُو سَطْح أَمْلَس لَامِع يَعْكِس الضَّوْء؛ نَاعِم كَالحَرِير) / اِنْسِيَابِيّ, دِينَامِيكِيٌّ هَوَائِيًّا (مصمَّم ليقدّم أقلّ مقاومة لتدفّق الهواء أو السوائل) / أَمْلَس, أَنِيقٌ جِدًّا (حَسَنُ الهِنْدَامِ بِشَكْلٍ مُبَالَغٍ فِيه)",
 "sleekly": "بصقل, بلمعان (بطريقة لامعة ومصقولة)\nمثال: كان الطريق المبتل يلمع بصقل",
 "sleekness": "حريرية, نعومة (الملمس الناعم لقماش الحرير) / أناقة, هندام مهندم (صفة كون الشخص مهندماً ومرتباً)\nمثال: أناقة مظهره ذكرتني بنجاحاته المالية",
 "sleep": "نَامَ, رَقَدَ (الإنسان أو الحيوان: رَقَدَ وغَفَا؛ الإنسان أو الحيوان: رَقَدَ وإن لم يغفو) / نَوْم, سِنَة (بكافة معانيه) / نَوْمَة / غَمَص, رَمَص\nمثال: نام في الحافلة.",
 "sleep apnea": "اِنْقِطَاع النَّفَس أَثْنَاء النَّوْم",
 "sleep deprivation": "حرمان من النوم (شكل من أشكال التعذيب النفسي يتم عن طريق حرمان الضحية من النوم)",
 "sleep disorder": "اضطراب النوم (خلل في نمط النوم الطبيعي)",
 "sleep mode": "وَضْع السُّكُون (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه)\nمثال: لقد أزمت الوضع.",
 "sleep over": "بَاتَ (فلَانٌ باتَ: أدْركهُ اللَّيْل نَام أَو لم ينم؛ باتَ الشَّيْء: مَضَت عَلَيْهِ لَيْلَة فَهُوَ بائت)\nمثال: بات الأمر واضحا الآن.",
 "sleep paralysis": "شَلَل النَّوْم, جَاثُوم",
 "sleep talking": "حديث أثناء النوم (نطق الكلام أثناء النوم)",
 "sleep terror disorder": "اضطراب الفزع الليلي (اضطراب في النوم يتميز بحلم بأبعاد مرعبة أسوأ بكثير من الكابوس المعتاد؛ تحدث أثناء نوم حركة العين غير السريعة)",
 "sleep-learning": "تعلم أثناء النوم (التدريس أثناء النوم (مثل استخدام التسجيلات لتعليم لغة أجنبية لشخص نائم))",
 "sleeper": "نجاح مفاجئ (عمل يحقق نجاحاً غير متوقع) / قوبيون نائم (سمكة استوائية تشبه القوبيون وتستقر بهدوء في القاع في المياه الضحلة) / أثاث للنوم (قطعة أثاث يمكن فتحها لتصبح سريراً) / بيجامة أطفال (بيجامة بأقدام؛ يرتديها الأطفال)\nمثال: كان ذلك الفيلم هو النجاح المفاجئ لهذا الصيف",
 "sleeper agent": "جَاسُوس نَائِم",
 "sleeper cell": "خلية نائمة (خلية من العملاء النائمين)\nمثال: ربما استخدمت خلية نائمة تابعة للقاعدة أريزونا كقاعدة لها",
 "sleeper goby": "قوبيون نائم (سمكة استوائية تشبه القوبيون وتستقر بهدوء في القاع في المياه الضحلة)",
 "sleeper nest": "خلية نائمة (وكر من العملاء النائمين في انتظار إشارة مرتبة مسبقاً)\nمثال: كانت الخلايا النائمة للإرهابيين قادرة على شن هجمات كبيرة في أوروبا",
 "sleepily": "بنعاس (بطريقة تدل على النعاس)\nمثال: الطفلان اللذان كانا متكورين بنعاس في مؤخرة السيارة",
 "sleepiness": "نُعَاس, سِنَة",
 "sleeping": "نوم (توقف الوعي وانخفاض معدل الأيض) / سكون, كمون (حالة من الراحة الهادئة وغير النشطة) / رَاقِد, نَائِم (مستلقٍ ورأسه على كفَّيه كأنَّه نائم) / استغراق في النوم (حالة كون الشخص نائماً)",
 "sleeping accommodation": "غرفة نوم, مخدع (غرفة تستخدم أساساً للنوم)",
 "sleeping around": "إباحية, علاقات متعددة (الانغماس في علاقات جنسية عشوائية وغير مميزة)",
 "sleeping bag": "حَقِيبَةُ النَّوْم",
 "sleeping beauty": "الْجَمِيلَة الْنَائِمَة",
 "sleeping capsule": "حبة منوم, قرص منوم (دواء منوم على شكل حبة (أو قرص أو كبسولة))",
 "sleeping car": "عربة نوم (عربة ركاب تحتوي على أسرّة للنوم)",
 "sleeping draught": "حبة منوم, قرص منوم (دواء منوم على شكل حبة (أو قرص أو كبسولة))",
 "sleeping hibiscus": "خبازة شمعية, خطمي نائم (أي من نباتات مختلفة من جنس مالفافيسكوس لها زهور لامعة جرسية الشكل متدلية تشبه زهور الخطمي غير المتفتحة تماماً)",
 "sleeping partner": "شَرِيك صَامِت, شَرِيك مُوصٍ (شريك (عادة ما يقدم رأس المال) لا تكون علاقته بالمؤسسة معروفة للعامة)",
 "sleeping pill": "مُنَوِّم",
 "sleeping room": "غرفة نوم, مخدع (غرفة تستخدم أساساً للنوم)",
 "sleeping sickness": "التهاب الدماغ السباتي, مرض النوم (التهاب دماغ كان وبائياً بين عامي 1915 و1926؛ تشمل الأعراض شلل عضلة العين الخارجية وضعف عضلي شديد)",
 "sleeping tablet": "حبة منوم, قرص منوم (دواء منوم على شكل حبة (أو قرص أو كبسولة))",
 "sleepless": "دَائِم اليَقَظَة, لَا يَنَام (ساهر دائماً لا تغمض له عين) / أَرِق, سَاهِر (يعاني من الأرق وعدم القدرة على النوم)",
 "sleepless person": "مُؤَرَّق, مُصاب بِالأَرَق (شخص لا يستطيع النوم)",
 "sleeplessly": "بأرق, بلا نوم (دون نوم؛ بطريقة مؤرقة)\nمثال: كان مستلقياً في الفراش بلا نوم",
 "sleeplessness": "أرق, سهاد (حالة مؤقتة تكون فيها غير قادر (أو غير راغب) في النوم)\nمثال: تقبل أرقك ومن المرجح أن يأتي النوم بطريقته المعاكسة",
 "sleepover": "حفلة مبيت, مبيت (مناسبة قضاء ليلة بعيداً عن المنزل أو استضافة ضيف للمبيت (خاصة كحفلة للأطفال))",
 "sleepwalker": "سائر في النوم (شخص يمشي أثناء نومه)",
 "sleepwalking": "سير أثناء النوم, مشي نائم (المشي من قبل شخص نائم)",
 "sleepwear": "ملابس نوم (ملابس مصممة للارتداء في السرير)",
 "sleepy": "نَعْسَان, نَاعِس",
