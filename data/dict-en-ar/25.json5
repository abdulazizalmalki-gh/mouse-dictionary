 "sheremetyevo": "شِيرِيمِيتْيِيفُو",
 "sheriff": "شَرِيف",
 "sheriff's sale": "بيع جبري, بيع قضائي (بيع الممتلكات من قبل الشريف بموجب أمر تنفيذ من المحكمة للوفاء بالتزام غير مدفوع)",
 "sherlock": "محقّق خاص (شخص يمكن استئجاره لجمع المعلومات والمساعدة في التحقيقات الجنائية)",
 "sherlock holmes": "شرلوك هولمز",
 "sherpa": "شيربا (عضو في شعب الهيمالايا الذين يعيشون في نيبال والتبت ويشتهرون بمهارتهم كمتسلقي جبال)",
