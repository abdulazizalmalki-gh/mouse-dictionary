 "shell shock": "إِرْتِجَاج دِمَاغِيّ",
 "shell stitch": "غرزة الصدفة, غرزة المروحة (غرزة كروشيه، تعرف أيضاً بغرزة المروحة)",
 "shell-flower": "زهرة السلحفاة, كيلون (نبات معمر بارز في الأراضي المستنقعية في شرق ووسط أمريكا الشمالية له أوراق رمحية شمعية وزهرة ذات جزء سفلي أبيض كريمي وأجزاء علوية وردية شاحبة إلى…)",
 "shell-less": "بلا صدفة, مقشور (للحيوانات أو الفواكه التي ليس لها صدفة)",
 "shellac": "شيلاك, ورنيش الشيلاك (ورنيش رقيق مصنوع عن طريق إذابة اللك في الإيثانول؛ يستخدم لإنهاء الخشب) / شيلاك, صمغ اللك المنقى (لك منقى بالتسخين والترشيح؛ عادة في رقائق برتقالية أو صفراء رقيقة ولكن أحياناً مبيضة باللون الأبيض)",
 "shellac varnish": "شيلاك, ورنيش الشيلاك (ورنيش رقيق مصنوع عن طريق إذابة اللك في الإيثانول؛ يستخدم لإنهاء الخشب)",
 "shellac wax": "شمع الشيلاك (شمع صلب يُفصل عن الشيلاك بسبب عدم قابليته للذوبان في الكحول)",
 "shellbark": "جوز أشعث اللحاء (جوز من أمريكا الشمالية له لحاء أشعث رمادي فضفاض ومكسرات صالحة للأكل)",
 "shellbark hickory": "جوز أشعث اللحاء (جوز من أمريكا الشمالية له لحاء أشعث رمادي فضفاض ومكسرات صالحة للأكل)",
 "shelled": "ذو صدفة, مصدف (للحيوانات أو الفواكه التي لها صدفة أو قشرة صلبة)",
 "sheller": "قشّار (عامل يزيل القشور (كما في البازلاء أو المحار))",
 "shellfire": "قصف مدفعي (إطلاق قذائف المدفعية)",
 "shellfish": "مَحَار",
 "shellflower": "زنجبيل الصدفة, زهرة الصدفة (يزرع لأوراقه المستطيلة اللامعة وعناقيده المقوسة من الزهور البيضاء ذات الظلال الوردية والشفاه الصفراء المجعدة ذات الخطوط الأرجوانية المبرقشة) / زهرة السلحفاة, كيلون (نبات معمر بارز في الأراضي المستنقعية في شرق ووسط أمريكا الشمالية له أوراق رمحية شمعية وزهرة ذات جزء سفلي أبيض كريمي وأجزاء علوية وردية شاحبة إلى…)",
 "shelling": "قَصْف",
 "shellproof": "مُقَاوِمٌ لِلقَنَابِل (قَادِرٌ عَلَى مُقَاوَمَةِ القُوَّةِ الاِنْفِجَارِيَّةِ لِلقَنَابِلِ وَالقَذَائِف)",
 "shelter": "مَلَاذ (مَلْجَأ، مَأْوَى) / مَخْلَص (الشخص الذي يفي ولا يخون)\nمثال: كان الغطاء النباتي الكثيف لمستنقعات المنغروف يوفر ملاذ آمنا للحيوانات الصغيرة التي تفر من المفترسين.",
 "shelter deck": "سطح مكشوف (سطح علوي ليس له حماية علوية من الطقس، ولكنه يحمي السطح الذي تحته)",
 "shelter tent": "خيمة صغيرة (خيمة على شكل وتد؛ عادة بدون أرضية أو نوافذ)",
 "shelterbelt": "مصد رياح (سياج من الأشجار مصمم لتخفيف قوة الرياح وتقليل التعرية)",
 "sheltered": "مَحْمِيّ, مُحْتَمٍ (مَحْمِيٌّ مِنَ الخَطَرِ أَوْ سُوءِ الطَّقْس)",
 "sheltered workshop": "ورشة محمية (ورشة توفر فرص عمل للأشخاص ذوي الإعاقة الجسدية أو التنموية)",
 "shelver": "مرصّف الرفوف (عامل يضع الأشياء (مثل الكتب) على الرفوف)",
 "shelvy": "ضَحْضَاح, مَلِيءٌ بِالشِّعَاب (مَلِيءٌ بِالشِّعَابِ المَغْمُورَةِ أَوِ الضُّحُولِ الرَّمْلِيَّة)",
 "shem": "سَام",
 "shema": "اسمع يا إسرائيل, شماع (صلاة ليتورجية (تعتبر جوهر الديانة اليهودية) يتلوها الذكور اليهود البالغون مرتين يومياً على الأقل لإعلان إيمانهم)",
 "shemozzle": "فوضى, ورطة ((يديشية) موقف أو شأن مربك؛ فوضى)",
 "shenanigan": "أذى, شقاوة (سلوك متهور أو خبيث يسبب الإزعاج أو الضيق للآخرين) / حيلة, خديعة (استخدام الحيل لخداع شخص ما (عادة لانتزاع المال منه))",
