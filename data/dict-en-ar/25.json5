 "set the scene": "هَيَّأَ الْأَجْوَاءَ (أَعَدَّ)",
 "set theory": "نظرية المجموعات (فرع الرياضيات البحتة الذي يتعامل مع طبيعة وعلاقات المجموعات)",
 "set-apart": "مُنْعَزِل, مُنْفَرِد (بعيد أو منفصل عن الآخرين؛ يشعر بالانفصال عنهم)",
 "set-back": "تراجع معماري, ردة الجدار (هيكل يضيق فيه الجدار أو المبنى بشكل مفاجئ)",
 "set-to": "شِجَار, عِرَاك (قتال قصير ولكنه قوي)",
 "seta": "سفاة, هلبه (شعرة صلبة أو شعيرة خشنة) / سويقة, عنق العلبة (ساق علبة الحزاز)",
 "setaceous": "ذُو أَشْوَاك, شَائِك (يحمل أشواكًا أو إبرًا أو شعيرات واقية أو مُغطَّى بها)",
 "setaria glauca": "ذيل الثعلب الأصفر (عشب ضار وشائك شائع يوجد في جميع المناطق المعتدلة تقريباً)",
 "setaria italica": "دخن إيطالي, دخن ذيل الثعلب (عشب حولي خشن مقاوم للجفاف يزرع للحبوب والتبن والعلف في أوروبا وآسيا وبشكل رئيسي للعلف والتبن في الولايات المتحدة)",
 "setaria italica rubrofructa": "دخن سيبيري (دخن بحبوب برتقالية إلى محمرة في سنابل طويلة شائكة)",
 "setaria italica stramineofructa": "دخن ألماني, دخن العجب الذهبي (دخن بحبوب صفراء في سنابل كبيرة متدلية)",
 "setaria viridis": "ذيل الثعلب الأخضر (ذيل ثعلب أوروبي متوطن في أمريكا الشمالية؛ غالباً ما يكون عشبة ضارة مزعجة)",
 "setback": "نَكْسَة",
 "seth": "شِيث",
 "setline": "خيط الشباك, خيط الصيد بالجر (خيط صيد طويل ترتبط به العديد من الخيوط القصيرة والخطافات (عادة ما يكون معلقاً بين عوامات))",
 "setoff": "تراجع معماري, ردة الجدار (هيكل يضيق فيه الجدار أو المبنى بشكل مفاجئ)",
 "setophaga ruticilla": "حميراء أمريكية (طائر مغرد صائد للذباب يعيش في شرق أمريكا الشمالية، يتميز الذكر بلون برتقالي ساطع على الجوانب والأجنحة والذيل)",
 "setose": "ذُو أَشْوَاك, شَائِك (يحمل أشواكًا أو إبرًا أو شعيرات واقية أو مُغطَّى بها)",
 "setscrew": "برغي تثبيت (برغي (غالباً بدون رأس) يركب في صرة عجلة أو كامة وما إلى ذلك ويمنع حركة الجزء بالنسبة للعمود المثبت عليه) / برغي ضبط (برغي يستخدم لضبط الشد على زنبرك)",
 "setswana": "تسوانا (لهجة السوتو التي يتحدث بها التسوانا في بوتسوانا)",
 "sett": "حجر رصف مستدير (حجر رصف مستطيل ذو قمة منحنية؛ كان يستخدم قديماً لصنع الطرق)",
 "settee": "أريكة صغيرة (أريكة صغيرة الحجم) / دكة بظهر, مقعد خشبي طويل (مقعد خشبي طويل له مسند ظهر)",
 "setter": "سيتر, كلب الرابض (كلب طويل الشعر كان يدرب سابقاً على الانحناء عند العثور على الطريدة ولكنه الآن يدرب على الإشارة إليها) / صفاف, منضد الحروف (شخص يصف المواد المكتوبة في قوالب الطباعة)",
 "setterwort": "خربق كريه الرائحة, خربق منتن (خربق ذو أوراق كفية وله رائحة كريهة وخصائص مهيجة عند تناوله داخلياً)",
 "setting": "إعداد المسرح, ديكور المسرح (ترتيب المناظر والممتلكات لتمثيل المكان الذي تُمثل فيه مسرحية أو فيلم) / فص, مثبت (قاعدة تثبيت تتكون من قطعة معدنية (كما في خاتم أو مجوهرات أخرى) تثبت الحجر الكريم في مكانه) / إعداد المائدة (طقم مائدة لشخص واحد) / إطار, محيط (السياق والبيئة التي يوضع فيها شيء ما)\nمثال: كان الماس في مثبت ذهبي بسيط",
 "setting hen": "دجاجة حاضنة, دجاجة راقدة (دجاجة منزلية مستعدة للرقاد على البيض)",
 "setting pole": "مُرْدِيّ",
 "settle": "اِسْتَعْمَرَ (اِسْتَعْمَرَ الاِسْتِعْمارُ الفَرَنْسِيُّ البِلادَ بِالسِّلاَحِ: دَخَلَها غَازِياً، وَأَرَادَها تابِعَةً لَهُ لِفَرْضِ سِيادَتِهِ عَلَيْها) / اِسْتَوْطَنَ (اتخذ وَطَنا أرضا كانت لغيره) / اِسْتَقَرَّ (فعل مطاوعة لأَقَرَّ بمعنى جعله يثبت ويسكن، أَقْرَرْتُهُ فاسْتَقَرَّ؛ ثبت وقرّ)\nمثال: استقر زيري في خيمته.",
 "settle down": "هَدَأَ / اِسْتَقَرَّ (فعل مطاوعة لأَقَرَّ بمعنى جعله يثبت ويسكن، أَقْرَرْتُهُ فاسْتَقَرَّ؛ ثبت وقرّ)\nمثال: استقر زيري في خيمته.",
 "settled": "ثَابِت, مُسْتَقِرّ (غَيْر قَابِل لِلتَّغَيُّر) / مُسْتَعْمَر, مُسْتَوْطَن (يسكنه مستوطنون أو مستعمرون) / مستقر, مستوطن (تم تأسيسه في وضع أو مكان مرغوب؛ غير متنقل) / محسوم, مُبت فيه (تم تحديده أو البت فيه بما لا يدع مجالاً للنزاع أو الشك)\nمثال: بدو؛ اندمجوا بين الناس المستقرين",
 "settledness": "استقرار, رسوخ (الجودة أو الحالة المتمثلة في كونه ثابتاً أو دائماً أو مستقراً؛ راسخاً)\nمثال: مهما كان استقراره في المكان، يعرف ستيرن من تاريخه الخاص، من مواسم بنسلفانيا، أنه لا يمكن أن يكون هناك استقرار دون ظهور تنوع جذري في المشهد",
 "settlement": "مُسْتَعْمَرَة, مُسْتَوْطَنَة",
 "settlement house": "دار رعاية اجتماعية (مركز في منطقة محرومة يقدم خدمات مجتمعية)",
 "settler": "مُسْتَوْطِن, مُسْتَعْمِر",
 "settler colonialism": "اِسْتِعْمَار اِسْتِيطَانِيّ",
 "settling": "ترسب, ترييح (غوص تدريجي إلى مستوى أدنى)",
 "settlings": "ثفل, حثالة (الرواسب التي استقرت في قاع سائل)",
 "settlor": "الواقف, منشئ الوقف ((في القانون) الشخص الذي ينشئ وقفاً عن طريق منح ممتلكات عقارية أو شخصية في عهدة وصي لصالح مستفيد)",
 "setup": "تلفيق تهمة, مكيدة (فعل يورط شخصاً ما في تهمة كاذبة) / ترتيب, جهاز (معدات مصممة لخدمة وظيفة محددة) / إعداد, ترتيب (الطريقة التي يتم بها تنظيم أو ترتيب شيء ما)\nمثال: يستغرق الأمر وقتاً لتعلم النظام هنا",
