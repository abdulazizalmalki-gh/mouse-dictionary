 "selene setapinnis": "سمكة القمر (أي من عدة أسماك بحرية فضية ذات أجسام مسطحة جداً)",
 "selene vomer": "سمكة لوك داون (تشبه سمكة القمر ولكن عيونها مرتفعة على الجبهة المقطوعة)",
 "selenic acid": "حمض السيلينيك (أصبح حامضًا، تغير الطعم إلى الحموضة؛ ارتفعت نسبة الحموضة في شيء ما، كما في الطعام أو السوائل)\nمثال: رمى ياني الحمض على وجه سكورة.",
 "selenicereus grandiflorus": "سيلينسيريوس, ملكة الليل (صبار متسلق أمريكي استوائي له فروع مثلثة؛ يزرع غالباً لزهوره الكبيرة البارزة التي تتفتح ليلاً تليها ثمار صفراء مخططة بالأحمر)",
 "selenious acid": "حمض السيلينيوز\nمثال: حمض السيلينيوز مشابه لحمض الكبريتوز، لكنه يعزل بسهولة أكبر (أصبح حامضًا، تغير الطعم إلى الحموضة؛ ارتفعت نسبة الحموضة في شيء ما، كما في الطعام أو السوائل)\nمثال: رمى ياني الحمض على وجه سكورة.",
 "selenite": "سيلينيت",
 "selenium": "سِيلِينِيُوم",
 "selenium cell": "خلية سيلينيوم (خلية كهروضوئية تستخدم شريطاً من السيلينيوم)",
 "selenocentric": "قَمَرِيّ الْمَرْكَز",
 "selenolatry": "عبادة القمر (عبادة القمر)",
 "selenology": "جيولوجيا القمر, علم القمر (فرع علم الفلك الذي يتعامل مع القمر)",
 "selenous acid": "حمض السيلينيوز\nمثال: حمض السيلينيوز مشابه لحمض الكبريتوز، لكنه يعزل بسهولة أكبر (أصبح حامضًا، تغير الطعم إلى الحموضة؛ ارتفعت نسبة الحموضة في شيء ما، كما في الطعام أو السوائل)\nمثال: رمى ياني الحمض على وجه سكورة.",
 "seleucid": "سِلُوقِيّ",
 "self": "نَفْس (النَّفْسُ : الرُّوحُ؛ النَّفْسُ :الدَّمُ، فشاهده قول السموأَل: تَسِيلُ على حَدِّ الظُّبَّاتِ نُفُوسُنَا…)\nمثال: هم في نفس السن.",
 "self acceptance": "تقبل الذات (قبول نفسك كما أنت، بكل عيوبك)",
 "self-abasement": "إماتة الشهوات, كفارة (عقاب ذاتي طوعي للتكفير عن خطأ ما)",
 "self-abnegating": "مُتَقَشِّف, مُنْكِر لِلذَّات (يُستخدم خاصّة عن السلوك الزاهد المُنكِر للذات)",
 "self-abnegation": "إِنْكَار الذَّات, زُهْد (التخلي عن مصالحك الخاصة لصالح مصالح الآخرين)",
 "self-absorbed": "مُسْتَغْرِق فِي نَفْسِه, مُنْغَمِس فِي ذَاتِه (منغمس في اهتماماته أو أفكاره الخاصة)",
 "self-absorption": "استغراق في الذات (الانشغال بالنفس مع استبعاد كل شيء آخر)",
 "self-abuse": "استمناء, تحفيز ذاتي (التحفيز اليدوي للعضو التناسلي الخاص بك للمتعة الجنسية)",
 "self-accusation": "إدانة النفس, اتهام الذات (اعتراف بأنك فشلت في فعل أو أن تكون شيئاً تعلم أنه يجب عليك فعله أو كونه)",
 "self-acting": "ذَاتِيّ التَّنْظِيم, ذَاتِيّ الحَرَكَة (مُصَمَّم لتفعيل أو تحريك أو تنظيم نفسه تلقائياً)",
 "self-activating": "ذَاتِيّ التَّنْظِيم, ذَاتِيّ الحَرَكَة (مُصَمَّم لتفعيل أو تحريك أو تنظيم نفسه تلقائياً)",
 "self-adapting program": "برنامج ذاتي التكيف (برنامج يمكنه تغيير أدائه استجابة لبيئته)",
 "self-addressed": "مَعْنُون ذَاتِيًّا (معنون بعنوان المُرسِل نفسه)",
 "self-aggrandisement": "تمجيد الذات, غرور (عمل يتم لزيادة قوتك ونفوذك أو لجذب الانتباه لأهميتك الخاصة)",
 "self-aggrandising": "مُتَبَاهٍ, مُتَفَاخِر (يُظهِر أهمية ذاتية ويتباهى بنفسه) / تعظيمي للذات (مكون من أو متعلق بـ أو مميز لتعظيم الذات)",
 "self-aggrandizement": "تمجيد الذات, غرور (عمل يتم لزيادة قوتك ونفوذك أو لجذب الانتباه لأهميتك الخاصة)",
 "self-aggrandizing": "مُتَبَاهٍ, مُتَفَاخِر (يُظهِر أهمية ذاتية ويتباهى بنفسه) / تعظيمي للذات (مكون من أو متعلق بـ أو مميز لتعظيم الذات)",
 "self-analysis": "تحليل ذاتي (تطبيق مبادئ العلاج النفسي لتحليل شخصيتك الخاصة) / تحليل ذاتي, محاسبة النفس (فحص دقيق لمعتقداتك ودوافعك)",
 "self-annihilation": "انتحار, تدمير الذات (فعل قتل النفس)\nمثال: الانتحار جريمة (في بعض القوانين)",
 "self-appointed": "مُعَيَّن ذَاتِيًّا (عيّن نفسه بنفسه دون تفويض من جهة أخرى)",
 "self-asserting": "تَوْكِيدِيّ, حَازِم (واثق من نفسه بشكل قوي)\nمثال: صبي حازم ونشيط مستعد دائماً للجدال",
 "self-assertion": "تأكيد الذات (فعل تأكيد المرء لنفسه بطريقة عدوانية) / إثبات الذات (فعل طرح آرائك الخاصة بطريقة متباهية أو غير مراعية توحي بأنك تشعر بالتفوق على الآخرين)",
 "self-assertive": "تَوْكِيدِيّ, حَازِم (واثق من نفسه بشكل قوي) / مُتَعَجْرِف, مُتَغَطْرِس (يفرض ذاته بشكل مُسيء ومتعجرف)\nمثال: صبي حازم ونشيط مستعد دائماً للجدال",
 "self-assertiveness": "تَوْكِيد الذَّات, حَزْم (ثقة بالنفس عدوانية؛ الميل إلى تقديم تأكيدات جريئة)",
 "self-assurance": "ثقة, ثقة بالنفس (الخلو من الشك؛ الإيمان بالنفس وبالقدرات)\nمثال: ثقته بتفوقه لم تجعله محبوباً",
 "self-assured": "مُعْتَدّ بِذَاتِه, وَاثِق بِنَفْسِه (يُظهر رباطة الجأش والثقة بقيمته الذاتيّة)",
 "self-aware": "مُدْرِكٌ لِنَفْسِهِ, وَاعٍ بِذَاتِهِ (مُدْرِكٌ لِذَاتِهِ كَفَرْدٍ وَلِكَيْنُونَتِهِ وَأَفْعَالِهِ وَأَفْكَارِهِ)",
 "self-awareness": "وَعْي بِالذَّات (الفَهْم والتَدَبُّر واِحْتِوَاء كل معاني الشيء؛ في علم النفس: حالة وعي ويعني أيضا محتوى العقل، ويشمل المشاعر والوعي الذاتي وٱلصور وَالأفكار وَٱلقدرة على إدراك العلاقة بين المرء وٱلبيئة والشعور بما…)\nمثال: إنها فاقدة الوعي.",
 "self-balancing": "ذَاتِيُّ التَّوَازُن (يُوازِن نفسه بنفسه)",
 "self-centered": "أناني, متمركز حول الذات (يهتم بشكل رئيسي أو حصري بنفسه ومصلحته مع استبعاد الآخرين)\nمثال: رجال أنانيون كانوا يحاولون تحقيق مكاسب لأنفسهم من قضية الحقوق المدنية المقدسة",
 "self-centeredness": "أحادية, حب الذات (الاهتمام بمصالح المرء ورفاهيته الخاصة)",
 "self-centred": "أناني, متمركز حول الذات (يهتم بشكل رئيسي أو حصري بنفسه ومصلحته مع استبعاد الآخرين)\nمثال: رجال أنانيون كانوا يحاولون تحقيق مكاسب لأنفسهم من قضية الحقوق المدنية المقدسة",
 "self-collected": "مُتَمَالِكٌ لِنَفْسِه, مُتَّزِن (مسيطر تمامًا على ملكاته وقدراته؛ رابط الجأش)",
 "self-colored": "أُحَادِيّ اللَّوْن, سَادَة (بنفس اللون في جميع أجزائه)",
 "self-coloured": "أُحَادِيّ اللَّوْن, سَادَة (بنفس اللون في جميع أجزائه)",
 "self-command": "ضبط النفس (سمة التحكم الحازم في سلوك المرء)",
 "self-complacency": "رضا عن الذات, غرور (الشعور الذي ينتابك عندما تكون راضياً عن نفسك)\nمثال: كان رضاه عن نفسه مثيراً للاشمئزاز تماماً",
 "self-complacent": "رَاضٍ عَنْ نَفْسِهِ, مُتَرَاخٍ (رَاضٍ عَنْ ذَاتِهِ أَوْ أَفْعَالِهِ إِلَى حَدِّ الخَلَلِ)",
 "self-conceited": "مَغْرُور, مُعْجَب بِنَفْسِه (يتّسم بكبرياء زائف؛ لديه شعور مبالَغ فيه بأهمية الذات)",
 "self-conceitedly": "بِخُيَلَاء, بِعُجْب (مع الغرور؛ بطريقة مغرورة)\nمثال: يتصرف دائماً بغرور شديد!",
 "self-concern": "أحادية, حب الذات (الاهتمام بمصالح المرء ورفاهيته الخاصة)",
 "self-condemnation": "إدانة النفس, اتهام الذات (اعتراف بأنك فشلت في فعل أو أن تكون شيئاً تعلم أنه يجب عليك فعله أو كونه)",
 "self-confidence": "ثِقَة بِالنَّفْس",
 "self-confident": "مُعْتَدّ بِذَاتِه, وَاثِق بِنَفْسِه (يُظهر رباطة الجأش والثقة بقيمته الذاتيّة)",
 "self-conscious": "خَجُول, مُرْتَبِك مِنْ ذَاتِهِ (واعٍ بشكل مفرط وغير مريح بمظهره أو سلوكه) / مُدْرِكٌ لِنَفْسِهِ, وَاعٍ بِذَاتِهِ (مُدْرِكٌ لِذَاتِهِ كَفَرْدٍ وَلِكَيْنُونَتِهِ وَأَفْعَالِهِ وَأَفْكَارِهِ)",
 "self-consciously": "بارتباك, بخجل (بطريقة تشير إلى الارتباك أو الخجل من مراقبة الآخرين)\nمثال: ألقت الطفلة الصغيرة القصيدة بخجل وارتباك",
 "self-consciousness": "ارتباك ذاتي, وعي ذاتي (وعي بالذات بالإضافة إلى الإدراك الإضافي بأن الآخرين يدركونك بالمثل) / ارتباك, وعي مفرط بالذات (إحراج نابع من الشعور بأن الآخرين يراقبونك بشكل نقدي)",
 "self-consistent": "مُتَّسِقٌ ذَاتِيًّا (لَا يُنَاقِضُ نَفْسَهُ)",
 "self-constituted": "ذَاتِيّ التَّأْسِيس (أسّس أو أقام نفسه بنفسه)",
 "self-contained": "مُسْتَقِلّ, مُكْتَفٍ ذَاتِيًّا (يشكّل وحدة مكتملة ومستقلّة بذاتها) / مُتَمَالِكٌ لِنَفْسِه, مُتَّزِن (مسيطر تمامًا على ملكاته وقدراته؛ رابط الجأش)",
 "self-contemplation": "استبطان, تأمل ذاتي (تأمل أفكارك ورغباتك وسلوكك)",
 "self-contradiction": "تناقض ذاتي (مناقضة النفس)",
 "self-contradictory": "مُتَضَارِب, مُتَنَاقِض (فِي حَالَةِ خِلَافٍ أَوْ تَعَارُضٍ) / مُتَنَاقِض ظَاهِرِيّاً (يبدو متناقضاً لكنه قد يكون صحيحاً مع ذلك)",
 "self-control": "إنكار الذات, ضبط النفس (فعل إنكار الذات؛ السيطرة على الدوافع) / ضبط النفس (سمة التحكم الحازم في سلوك المرء)",
 "self-criticism": "نقد ذاتي (انتقاد المرء لنفسه)",
 "self-cultivation": "تثقيف ذاتي, تعليم ذاتي (عملية تعليم النفس)",
 "self-deceit": "خداع الذات (مفهوم خاطئ يكون في صالح الشخص الذي يحمله)",
 "self-deception": "خداع الذات (مفهوم خاطئ يكون في صالح الشخص الذي يحمله)",
 "self-defeating": "ذَاتِيّ الهَزِيمَة (يعمل ضد غرضه الخاص ويؤدي إلى فشل نفسه)",
 "self-defence": "دفاع عن النفس (فعل الدفاع عن نفسك)",
 "self-defense": "دِفَاع عَنِ النَّفْسِ",
 "self-denial": "إِنْكَار الذَّات, زُهْد (التخلي عن مصالحك الخاصة لصالح مصالح الآخرين) / إنكار الذات, ضبط النفس (فعل إنكار الذات؛ السيطرة على الدوافع) / انضباط ذاتي (سمة ممارسة الانضباط الذاتي)",
 "self-denying": "مُتَقَشِّف, مُنْكِر لِلذَّات (يُستخدم خاصّة عن السلوك الزاهد المُنكِر للذات) / إِيثَارِيّ, مُضَحٍّ بِنَفْسِه (مستعدّ لحرمان نفسه من أجل الآخرين)",
 "self-deprecating": "مُتَوَاضِع, مُنْتَقِص مِنْ ذَاتِه (واعٍ بعيوبه وقصوره الشخصيّة)",
 "self-depreciation": "احتقار الذات (شعور بقلة القيمة)",
 "self-description": "وصف الذات (فعل وصف المرء لنفسه)",
 "self-destruction": "انتحار, تدمير الذات (فعل قتل النفس) / تدمير الذات (فعل تدمير النفس)\nمثال: الانتحار جريمة (في بعض القوانين)",
 "self-destructive": "اِنْتِحَارِيّ, مُدَمِّرٌ لِلذَّات (خطير على النفس أو على المصالح الشخصيّة)",
 "self-determination": "تَقْرِيرُ المَصِير",
 "self-digestion": "تحلل ذاتي, هضم ذاتي (تحلل الأنسجة النباتية أو الحيوانية عن طريق عملية داخلية)",
 "self-directed": "ذَاتِيُّ التَّوْجِيه, مُسْتَقِلّ ((عَنِ الأَشْخَاصِ) حُرٌّ مِنَ السَّيْطَرَةِ وَالقُيُودِ الخَارِجِيَّةِ فِي الفِعْلِ وَالحُكْم)",
 "self-direction": "استقلالية, اعتماد على النفس (الاستقلال الشخصي)",
 "self-discipline": "إنكار الذات, ضبط النفس (فعل إنكار الذات؛ السيطرة على الدوافع) / انضباط ذاتي (سمة ممارسة الانضباط الذاتي)",
 "self-disciplined": "مُنْضَبِط ذَاتِيًّا (يُستخدم عن الأشخاص غير المُتساهلين مع أنفسهم)",
 "self-disclosure": "إِفْصَاح عَن الذَّات",
 "self-discovery": "اكتشاف الذات (اكتشاف الفرد لتفرده وشخصيته)",
 "self-disgust": "اشمئزاز من الذات, كره الذات (خزي ناتج عن كراهية قوية لنفسك أو لأفعالك)",
 "self-distrust": "تردد, عدم الثقة بالنفس (انعدام الثقة بالنفس)",
 "self-doubt": "تردد, عدم الثقة بالنفس (انعدام الثقة بالنفس)",
 "self-drive": "تأجير السيارات, سيارة مستأجرة (سيارة مستأجرة)\nمثال: استلمت سيارة مستأجرة من المطار وقادتها إلى فندقها",
 "self-educated": "عِصَامِيّ",
 "self-education": "تثقيف ذاتي, تعليم ذاتي (عملية تعليم النفس)",
 "self-effacement": "انزواء, تواري (الانسحاب إلى الخلفية؛ جعل النفس غير ملحوظة)",
 "self-effacing": "مُتَكَتِّم, مُتَوَارٍ (يتجنّب لفت الانتباه إلى نفسه؛ متحفّظ ومنسحب)",
 "self-employed": "حر, مستقل (يعمل لنفسه (وليس موظفاً دائماً))",
 "self-employed person": "عامل مستقل, فريلانسر (كاتب أو فنان يبيع خدماته لأصحاب عمل مختلفين دون عقد طويل الأجل مع أي منهم)",
 "self-enclosed": "مُنْغَلِق عَلَى الذَّات (ذو انغلاق أو انحصار مفروض ذاتياً)",
 "self-established": "ذَاتِيّ التَّأْسِيس (أسّس أو أقام نفسه بنفسه)",
 "self-esteem": "تَقْدِير ذَات",
 "self-evident": "بَدَهِيّ, بَدِيهِيّ (واضح دون حاجة إلى برهان أو حجّة)",
 "self-evident truth": "افتراض أساسي, بديهية (افتراض أساسي لحجة ما)",
 "self-evidently": "بشكل بديهي, بوضوح ذاتي (بطريقة واضحة بذاتها ولا تحتاج لبرهان)",
 "self-examination": "استبطان, تأمل ذاتي (تأمل أفكارك ورغباتك وسلوكك)",
 "self-examining": "استبطاني, تأملي (يميل لفحص تجاربه الحسية والإدراكية الخاصة)",
 "self-explanatory": "مُفَسِّر نَفْسَهُ بِنَفْسِهِ, مَفْهُوم بِذَاتِهِ",
 "self-expression": "تعبير عن الذات (التعبير عن فردية المرء (عادة من خلال الأنشطة الإبداعية))",
 "self-feeder": "ملقم ذاتي (آلة توفر تلقائياً إمداداً من مادة ما)\nمثال: أفرغ الملقم العلف في حوض للماشية",
 "self-fertilisation": "إخصاب ذاتي (إخصاب عن طريق اتحاد الأمشاج الذكرية والأنثوية من نفس الفرد)",
 "self-fertilised": "ذَاتِيُّ التَّلْقِيح (مُلقَّح بحبوب لقاحه الذاتية)",
 "self-fertilization": "إخصاب ذاتي (إخصاب عن طريق اتحاد الأمشاج الذكرية والأنثوية من نفس الفرد)",
 "self-fertilized": "ذَاتِيُّ التَّلْقِيح (مُلقَّح بحبوب لقاحه الذاتية)",
 "self-flagellation": "جلد الذات (عقاب ذاتي يتم عن طريق الجلد)",
 "self-forgetful": "نَاسٍ لِذَاتِه (يُظهر عدم اهتمام بمصالحه الشخصية)",
 "self-fulfillment": "تحقيق الذات (تحقيق قدرات الفرد وإمكاناته)",
 "self-generated": "ذَاتِيّ الإِنْتَاج (ناشئ من الذات) / تلقائي, عفوي (يحدث أو ينشأ دون سبب خارجي ظاهر)\nمثال: ضحك عفوي",
 "self-giving": "إِيثَارِيّ, مُضَحٍّ بِنَفْسِه (مستعدّ لحرمان نفسه من أجل الآخرين)",
 "self-governing": "ذُو سِيَادَة, مُسْتَقِلّ ((عَنِ الكِيَانَات السِّيَاسِيَّة) غَيْر خَاضِع لِسَيْطَرَة قُوًى خَارِجِيَّة)",
 "self-government": "تقرير المصير, حكم ذاتي (حكم وحدة سياسية من قبل شعبها)",
 "self-gratification": "إرضاء الذات (عملية إشباع رغباتك الخاصة وإعطاء نفسك المتعة) / تحلل, خلاعة (عدم انضباط فيما يتعلق بالملذات الحسية)",
 "self-hatred": "اشمئزاز من الذات, كره الذات (خزي ناتج عن كراهية قوية لنفسك أو لأفعالك)",
 "self-heal": "برونيلا, شفيقة (نبات معمر أوروبي أزرق الزهر مستلقي يعتقد أنه يمتلك خصائص علاجية؛ مستوطن في جميع أنحاء أمريكا الشمالية)",
 "self-help": "اعتماد على النفس, مساعدة ذاتية (فعل مساعدة أو تحسين المرء لنفسه دون الاعتماد على أي شخص آخر)",
 "self-hypnosis": "تنويم ذاتي (تنويم مغناطيسي يقوم به الشخص لنفسه)",
 "self-importance": "أنانية, حب الذات (رأي مبالغ فيه حول أهمية الذات) / تضخم الأنا, غرور (شعور متضخم بالفخر بتفوقك على الآخرين)",
 "self-important": "مُتَعَجْرِف, مُتَغَطْرِس (لديه أو يُظهِر شعورًا بأهمية لا مبرّر لها ناتجًا عن كبرياء مفرط)",
 "self-imposed": "ذَاتِيُّ الفَرْض (فُرِضَ أَوْ تُحُمِّلَ طَوْعًا عَلَى النَّفْس)",
 "self-improvement": "تحسين الذات, تطوير الذات (فعل تحسين نفسك)",
 "self-incrimination": "إدانة النفس, تجريم الذات (اتهام يورط الشخص نفسه في جريمة)",
 "self-induced": "ذَاتِيّ الاسْتِحْدَاث, مُسَبَّب ذَاتِيًّا (ناتج عن الشخص ذاته وليس عن عامل خارجي) / مستحث ذاتيا (ناتج عن الحث الذاتي الكهربائي)",
 "self-inductance": "حَثّ ذَاتِيّ, مُعَامِل الحَثّ الذَّاتِيّ (النسبة بين القوة الدافعة الكهربائية الناتجة في دائرة عن طريق الحث الذاتي ومعدل تغير التيار الذي ينتجها، معبراً عنها بالهنري)",
 "self-induction": "حث ذاتي (توليد قوة دافعة كهربائية في دائرة بتغيير التيار في تلك الدائرة؛ يقاس عادة بالهنري)",
 "self-indulgence": "إفراط, شره (الإفراط في العمل والانغماس غير المعتدل في الشهوات الجسدية، خاصة في العاطفة أو التساهل) / استرسال, انغماس (عدم القدرة على مقاومة إشباع النزوات والرغبات)\nمثال: تطرف لغتهم",
 "self-indulgent": "مُتَسَاهِل مَعَ النَّفْس (يُلبّي شهواته ورغباته الخاصّة)",
 "self-indulgently": "بشكل منغمس في الملذات (بطريقة منغمسة في الذات)",
 "self-insurance": "تأمين ذاتي (تأمين نفسك عن طريق تخصيص أموال لتغطية الخسائر المحتملة بدلاً من شراء بوليصة تأمين)",
 "self-interest": "أحادية, حب الذات (الاهتمام بمصالح المرء ورفاهيته الخاصة) / انتهازية (استغلال الفرص دون النظر للعواقب على الآخرين)",
 "self-involved": "مُسْتَغْرِق فِي نَفْسِه, مُنْغَمِس فِي ذَاتِه (منغمس في اهتماماته أو أفكاره الخاصة)",
 "self-justification": "تبرير, حجة (دفاع عن سلوك مسيء أو فشل في الوفاء بوعد وما إلى ذلك)\nمثال: استمر في إيجاد الأعذار للبقاء",
 "self-knowledge": "معرفة الذات (فهم لنفسك وأهدافك وقدراتك)",
 "self-limited": "محدود ذاتيا (متعلق بمرض يميل إلى أخذ مسار محدد دون علاج)",
 "self-loader": "سلاح تلقيم ذاتي, ملقم آلي (سلاح ناري يعيد تلقيم نفسه)",
 "self-loading": "ذَاتِيّ التَّعْبِئَة, نِصْف آلِيّ ((للأسلحة النارية) قادر على التعبئة والإطلاق المتواصل آلياً)",
