 "seventeen": "سَبْعَةَ عَشَرَ",
 "seventeen-year locust": "زيز السبعة عشر عاماً (زيز من أمريكا الشمالية؛ يظهر بأعداد كبيرة على فترات متباعدة لأن الحوريات تستغرق 13 إلى 17 عاماً لتنضج)",
 "seventeenth": "سَابِعَ عَشَرَ (العَدَد التَّرْتِيبِيّ 17) / السابع عشر (المركز 17 في سلسلة معدودة من الأشياء)",
 "seventh": "سَابِع, سَابِعَة / سُبْع (اِسْمٌ وَصِفَةٌ لِلْأَسَد)\nمثال: عمره سبع سنوات.",
 "seventh chord": "كورد سباعي (ثالوث مضاف إليه سابعة)",
 "seventh cranial nerve": "عصب قحفي سابع, عصب وجهي (عصب قحفي يغذي عضلات الوجه)",
 "seventh heaven": "سعادة قصوى, غبطة (حالة من السعادة الغامرة)",
 "seventh-day adventism": "أدفنتست السبتيين, سبتيون (حركة مجيئية بروتستانتية بقوة تراعي السبت كيوم للراحة)",
 "seventhly": "سابعاً (في المرتبة السابعة)\nمثال: سابعاً، ليس لديك الحق في إلغاء عقد الإيجار في منتصف العام",
 "seventies": "السبعينات (الفترة من العمر بين 70 و 80) / السبعينات (1970), عقد 1970 (العقد من 1970 إلى 1979)",
 "seventieth": "اَلسَّبْعُونَ (العدد الترتيبي لسبعين في العدّ) / السبعون (المركز 70 في سلسلة معدودة من الأشياء)",
 "seventy": "سَبْعِينَ, سَبْعُون",
 "seventy-eight": "ثَمَانِيَة وَسَبْعُون, ٧٨",
 "seventy-fifth": "اَلْخَامِسُ وَالسَّبْعُونَ (العدد الترتيبي لخمسة وسبعين في العدّ)",
 "seventy-five": "خَمْسَة وَسَبْعُون (قيمة عددية تساوي \"٥\"؛ الرقم ما بعد \"أَرْبَعَة\" وقبل \"سِتَّة\")\nمثال: رأيت خمسة رجال.",
 "seventy-four": "أَرْبَعَة وَسَبْعُون (أَرْبِعَة؛ أربعَة)\nمثال: مرت أربعة أيام.",
 "seventy-nine": "تِسْعَة وَسَبْعُون",
 "seventy-one": "وَاحِد وَسَبْعُون (في وَ: العدد واحد العدد الاول)\nمثال: رأيت واحدة مرة.",
 "seventy-seven": "سَبْعَة وَسَبْعُون",
 "seventy-six": "سِتَّة وَسَبْعُون",
 "seventy-three": "ثَلَاثَة وَسَبْعُون (في هو أحد الأعداد الرياضية، وهو أصغر عدد فردي أولي)\nمثال: حملت ثلاثة كتب.",
 "seventy-two": "اِثْنَان وَسَبْعُون (في اِثْنان هو رقم مرتبته بين الواحد والثلاثة)\nمثال: واحد زائد اثنان يساوي ثلاثة.",
 "sever": "جَذَبَ, قَطَعَ (شَدَّ الشيءَ نحوه بقوة؛ لفَتَ الانتباه أو أثارَ الاهتمام)\nمثال: استعملت ريمة لجذب الانتباه.",
 "severable": "قَابِل لِلتَّجْزِئَة, قَابِل لِلفَصْل (يُمْكِن تَقْسِيمُه أَوْ فَصْلُه)",
 "severable contract": "عقد قابل للتجزئة (عقد يمكن اعتباره، في حالة حدوث خرق من قبل أحد الطرفين، كاتفاقيات مستقلة متعددة يعبر عنها في صك واحد)",
 "several": "بَعْض, عِدَّة ((بَعَضَه) البعوض بَعْضًا: لسعه وآذاه؛ (بَعَضَ) الشَّيْء: جعله أقساما)\nمثال: لديك بعض الكتب.",
 "several-seeded": "مُتَعَدِّدُ البُذُور (ذو بذور كثيرة متعدّدة)",
 "severally": "على التوالي (بالترتيب المذكور) / بشكل فردي, على حدة (بمعزل عن الآخرين) / بشكل مستقل, فرادى (بشكل فردي أو منفصل)\nمثال: سُمي الأخوان فيليكس وماكس، على التوالي",
 "severalty": "مِلْكِيَّة فَرْدِيَّة (ملكية فردية حصرية) / انفصال, تمايز (حالة التعدد والتميز)",
