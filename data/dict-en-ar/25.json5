 "skull session": "تدريب نظري, جلسة تكتيكية (تدريس الاستراتيجية لفريق رياضي) / جلسة تخطيط, جلسة عصف ذهني (جلسة (كما للمديرين التنفيذيين أو المستشارين) لمناقشة السياسة أو الاستراتيجية أو لحل المشاكل أو تبادل الأفكار)",
 "skullcap": "كِبَّة (المرة الواحدة من الانكباب؛ والأصح أن يُقال كَبَّة؛ جنس من طعام يُصنع غالبا من البُرْغُل وقد يكون من عجين الرُزّ ويُحشى باللحم وقد يقلى أو يشوى أو يطبخ مع اللبن أو غيره من الطعام)",
 "skullduggery": "احتيال, تلاعب (تضليل لفظي يهدف إلى استغلالك بطريقة ما)",
 "skunk": "ظَرِبَان (حيوان صغير بحجم القط)",
 "skunk bear": "شره (ثديي لاحم ممتلئ الجسم أشعث المعطف من أمريكا الشمالية)",
 "skunk cabbage": "ملفوف الظربان الغربي / عشبة الظربان, ملفوف الظربان (نبات مستنقعات معمر نفضي منخفض النمو كريه الرائحة في شرق أمريكا الشمالية له أزهار دقيقة محاطة بقنابة مرقطة خضراء أو أرجوانية تشبه القلنسوة)",
 "skunk-weed": "بوليمونيوم لزج, عشبة الظربان (عشب طويل في جبال روكي له أوراق لزجة ورائحة كريهة)",
 "skunkbush": "سماق الظربان, سماق ثلاثي الفصوص (شجيرة متساقطة الأوراق في كاليفورنيا ذات أوراق كريهة الرائحة عادة ما تكون ثلاثية الوريقات وثمار صالحة للأكل)",
 "skunkweed": "بوليمونيوم لزج, عشبة الظربان (عشب طويل في جبال روكي له أوراق لزجة ورائحة كريهة)",
 "sky": "سَمَاء, سما / سَمَاء, سَمَاوَات / سَمَاوَات",
 "sky blue": "سَمَاوِيّ, أَسْمَانْجُونِيّ",
 "sky burial": "دفن سماوي (طقس جنائزي تيبتي تقليدي تُعرض فيه الجثة في الهواء الطلق لتأكلها النسور المقدسة)",
 "sky glow": "توهج السماء (إضاءة سماء الليل في المناطق الحضرية)",
 "sky marshal": "ضابِط أَمْن الطَّائِرَة, مارْشال جَوِّيّ (شخص مدرب حكومياً على تكتيكات مكافحة الاختطاف والإرهاب ويكون راكباً على متن رحلة طيران لأسباب أمنية)",
 "sky pilot": "قسيس عسكري, مرشد ديني عسكري (قسيس في إحدى الخدمات العسكرية)",
 "sky wave": "موجة سماوية (موجة راديوية تنعكس عائدة إلى الأرض بواسطة الغلاف الأيوني أو قمر صناعي للاتصالات؛ تسمح بالإرسال حول منحنى سطح الأرض)",
 "sky-blue": "أَزْرَق سَمَاوِيّ, لَازَوَرْدِيّ (ذو لون أزرق عميق مائل إلى البنفسجيّ كسماء أكتوبر الصافية) / سماوي, لازوردي (درجة فاتحة من الأزرق)",
 "sky-high": "إلى عنان السماء, عالياً جداً (إلى مستوى مرتفع جداً) / بإطراء شديد, بحماس بالغ (بطريقة مسرفة أو متحمسة) / تدميراً كاملاً, نسفاً ((مع الفعل 'نسف' أو 'فجر') دُمّر تماماً أو نُسف إلى قطع)\nمثال: ارتفعت الأسعار عالياً جداً",
 "skybox": "مقصورة علوية (مقصورة مرتفعة لمشاهدة الأحداث في ملعب رياضي)",
 "skycap": "شيّال المطار (حمّال يساعد الركاب في حمل أمتعتهم في المطار)",
 "skydiver": "قَافِز حُرّ, هَاوِي الْقَفْز الْمِظَلِّيّ (شخص يقفز من طائرة ويؤدي حركات بهلوانية مختلفة قبل فتح حبل المظلة)",
 "skydiving": "قفز حر بالمظلات (أداء حركات بهلوانية في السقوط الحر قبل سحب حبل المظلة)",
 "skye": "سكاي",
 "skye terrier": "سكاي تيريير (سلالة اسكتلندية من التيريير ذات شعر أشعث وجسم طويل منخفض مع أرجل قصيرة؛ موطنها الأصلي جزيرة سكاي)",
 "skyhook": "خُطَّاف السماء (خطاف يُتخيل أنه معلق من السماء) / خطاف جوي, مروحية الرفع الثقيل (مروحية تحمل بكرة من الكابلات الفولاذية يمكن استخدامها لرفع ونقل الأشياء الثقيلة)",
 "skylark": "قُبَّرَة",
 "skylight": "فتحة سقف, منور (نافذة في السقف للسماح بدخول ضوء النهار)",
 "skyline": "أُفُق ((أَفِقَ) أفَقَاً: بلغ النِّهَايَة فِي الْكَرم وَالْعلم فَهُوَ أفق وأفيق)\nمثال: طلعت الشمس فوق الأفق.",
 "skype": "سْكَايَبَ",
 "skyrocket": "شمروخ, صاروخ ألعاب نارية (يرسل عرضًا للألعاب النارية عاليًا في السماء) / شمروخ, صاروخ (يدفع ضوءاً ساطعاً عالياً في السماء، أو يُستخدم لدفع حبل إنقاذ أو حربة)",
 "skysail": "شراع السماء (الشراع الموجود فوق شراع الرويال في السفن مربعة الأشرعة)",
 "skyscraper": "نَاطِحَة سَحَاب",
 "skywalk": "جسر معلق للمشاة (ممر مرتفع بين المباني (عادة ما يكون مغلقاً))",
 "skyward": "سَمَاوِيٌّ",
 "skywards": "نَحْو السَّمَاء (باتجاه السماء)\nمثال: انظر نحو السماء!",
 "skyway": "مسار طيران, ممر جوي (طريق محدد تتبعه الطائرات في الطيران من مطار إلى آخر)",
 "skywriting": "كتابة في السماء (كتابة تتشكل في السماء بواسطة الدخان المنبعث من طائرة)",
 "slab": "بَلَاط",
 "slabbing mill": "مطحنة ألواح (مطحنة درفلة للصلب لصنع الألواح)",
 "slack": "مُتَرَاخٍ, مُتَسَاهِل (يَفْتَقِر إِلَى الصَّرَامَة أَوِ الدِّقَّة) / بَطِيء الجَرَيَان (يسيل بسرعة ضئيلة كما عند تحوُّل المدّ) / فَضْفَاض, مُرْتَخٍ (غَيْرُ مَشْدُودٍ وَلَا مُتَوَتِّر) / الجزء المرتخي (حبل أو خيط أو كابل يتدلى باسترخاء)\nمثال: قام بسحب الجزء المرتخي",
 "slack suit": "بدلة غير رسمية (لباس غير رسمي يتكون من بنطال وسترة مطابقة)",
 "slack tide": "ركود المد, وقفة المد (حدوث سكون نسبي للمياه عند تحول المد (الجزر))",
 "slack water": "ركود المد, وقفة المد (حدوث سكون نسبي للمياه عند تحول المد (الجزر)) / مياه راكدة (امتداد من الماء بدون تيار أو حركة)\nمثال: فجأة وجدوا أنفسهم في مياه راكدة وكان الماء ساكناً",
 "slackening": "استرخاء, تراخي (حدوث ضعف في السيطرة أو القوة)\nمثال: تخفيف المتطلبات",
 "slacker": "متخاذل, متهرب (شخص يتهرب من عمله أو واجبه (خاصة من يحاول التهرب من الخدمة العسكرية في وقت الحرب))",
 "slacking": "تكاسل, تهرب من العمل (التهرب من العمل أو الواجب)",
 "slackline": "حبل التوازن المرن (حبل مشدود جزئياً للتوازن أو المشي عليه)",
 "slackly": "برخاوة (بطريقة مرتخية؛ ليست صلبة)\nمثال: استقرت يداه برخاوة",
 "slackness": "تراخ, تسيب (صفة التراخي والإهمال) / ارْتِخَاء, تَرَاخٍ (صفة كون الشيء مرتخياً (غير مشدود)) / خمول, فتور (ضعف يتميز بنقص الحيوية أو الطاقة)\nمثال: لم يحسب حساباً لارتخاء الحبل",
 "slacks": "بِنْطال, بَنْطَلُون (البِنْطَال : ضرب من الألبسة حديث يلبس في النصف الأسفل من الجسم يتكون من ساقين مثل السَرَاويِل إلا أنها أضيق…)",
 "slag": "خابث, خباث",
 "slag code": "قنبلة منطقية (مجموعة من التعليمات تُدرج في برنامج وتصمم للتنفيذ (أو 'الانفجار') إذا تحقق شرط معين؛ عند انفجارها قد تحذف أو تفسد البيانات، أو تطبع رسالة زائفة، أو…)\nمثال: زرع موظف ساخط قنبلة منطقية",
 "slagheap": "كومة الخبث, كومة ركام المعادن (كومة من مواد النفايات الناتجة عن تعدين الفحم وما شابه)",
 "slain": "صَرِيع, قَتِيل (قُتل؛ (صيغة أدبية رسمية كما في 'المحاربون الصرعى')) / صرعى, قتلى (الناس الذين قُتلوا (كما في المعركة))",
 "slaked": "مُرْتَوٍ, مُشْبَع (سُكِّنَتْ حَاجَتُهُ وَأُشْبِعَ رَغْبَتُه)",
 "slaked lime": "جير, هيدروكسيد الكالسيوم (مادة كاوية تنتج عن تسخين الحجر الجيري)",
 "slalom": "تَزَلُّجٌ مُتَعَرِّج",
 "slam": "تهكم, نقد لاذع (ملاحظة عدوانية موجهة لشخص مثل قذيفة وتهدف إلى إحداث تأثير قوي) / خبطة, صفقة (ارتطام قوي يصدر صوتاً عالياً) / ارتطام, صفع (الضجيج الناتج عن الارتطام القوي لجسمين) / اكتساح, سلام (الفوز بجميع الحيل أو جميعها باستثناء واحدة في لعبة البريدج)\nمثال: كانت كلمته الأخيرة 'اذهب للجحيم'",
 "slam dance": "الرقص التصادمي, سلام دانس (شكل من أشكال الرقص يصطدم فيه الراقصون ببعضهم البعض؛ عادة ما يُؤدى على موسيقى البانك روك)",
 "slam dancing": "الرقص التصادمي, سلام دانس (شكل من أشكال الرقص يصطدم فيه الراقصون ببعضهم البعض؛ عادة ما يُؤدى على موسيقى البانك روك)",
 "slam dunk": "رَمْيَة سَاحِقَة, سْلَام دَانْك",
 "slam-bang": "بصخب وعنف, بعنف مفاجئ (بطريقة عنيفة أو مفاجئة أو صاخبة) / باندفاع, بسرعة متهورة (بسرعة غير مبالية) / بإهمال, كيفما اتفق (بطريقة مهملة أو متهورة) / مُدَوٍّ وَعَنِيف (عَنِيفٌ وَمُفَاجِئٌ وَصَاخِب)\nمثال: سقطت القدور بصخب وعنف وأيقظت المنزل بأكمله",
 "slammer": "حبس, سجن (مؤسسة إصلاحية تستخدم لاحتجاز الأشخاص الموجودين في الحجز القانوني للحكومة (إما متهمين ينتظرون المحاكمة أو مدانين يقضون عقوبة)) / صَافِق (شخص يغلق الأشياء بقوة وعنف)\nمثال: هي صافقة للأبواب بشكل درامي",
 "slander": "تَشْهِير, اِفْتِرَاء",
 "slanderer": "قاذف, مشهر (من يهاجم سمعة شخص آخر بالتشهير أو القذف)",
 "slanderous": "افْتِرائِيّ, تَشْهيرِيّ (يَنْطَوي عَلى تَشْهير أو افْتِراء يُسيء إلى السُّمْعَة)",
 "slanderously": "بتشهير, بقذف (بطريقة كاذبة وتشهيرية؛ تتضمن الافتراء)",
 "slanderousness": "افتراء, تشهير (صفة الكلام غير الصحيح والمؤذي للسمعة)",
 "slang": "عَامِّيَّة, دَارِجَة",
 "slang expression": "تعبير عامي, عامية (لغة غير رسمية تتكون من كلمات وتعبيرات لا تعتبر مناسبة للمناسبات الرسمية؛ غالباً ما تكون نابية أو سوقية) / تعبير عامي, كلمة عامية (كلمة أو تعبير خارج الاستخدام القياسي وغير رسمي للغاية)\nمثال: كان كلامهم مليئاً بالتعبيرات العامية",
 "slang term": "تعبير عامي, عامية (لغة غير رسمية تتكون من كلمات وتعبيرات لا تعتبر مناسبة للمناسبات الرسمية؛ غالباً ما تكون نابية أو سوقية) / تعبير عامي, كلمة عامية (كلمة أو تعبير خارج الاستخدام القياسي وغير رسمي للغاية)\nمثال: كان كلامهم مليئاً بالتعبيرات العامية",
 "slang word": "تعبير عامي, كلمة عامية (كلمة أو تعبير خارج الاستخدام القياسي وغير رسمي للغاية)",
 "slangily": "بالعامية, بلغة السوقة (باستخدام العامية؛ بطريقة عامية)\nمثال: يعبر عن نفسه بعبارات عامية",
 "slanginess": "ابتذال لغوي, استخدام العامية (عفوية في استخدام اللغة)",
 "slanguage": "لغة عامية جداً (لغة تتميز بالاستخدام المفرط للعامية أو الرطانة)",
 "slangy": "عَامِّيّ اللَّهْجَة (يُشَكِّلُ لُغَةً عَامِّيَّةً أَوْ يَتَّسِمُ بِاسْتِخْدَامِهَا)",
 "slant": "اِنْحِدَار, زَاوِيَة المَيْل (درجة الانحراف عن المستوى الأفقي) / زاوية منحازة, وجهة نظر خاصة (طريقة منحازة للنظر إلى شيء ما أو تقديمه)\nمثال: كان للسقف انحدار حاد",
 "slant-eye": "مائل العينين ((عامية) مصطلح مهين لشخص آسيوي (خاصة لجنود فيتنام الشمالية في حرب فيتنام))",
 "slanted": "قُطْرِيّ, مَائِل (ذو اتِّجاه مائل أو منحرف عن الأفق) / مُتَحَيِّز, مُنْحَاز (يُفَضِّلُ شَخْصًا أَوْ طَرَفًا عَلَى آخَر)",
 "slanting": "قُطْرِيّ, مَائِل (ذو اتِّجاه مائل أو منحرف عن الأفق)",
 "slantingly": "بانحدار, بشكل مائل (بميل أو انحراف)",
 "slantways": "بانحراف, بشكل مائل (بوضع مائل؛ التحرك أو الاتجاه بوضع أو اتجاه مائل)",
 "slantwise": "بانحراف, بشكل مائل (بوضع مائل؛ التحرك أو الاتجاه بوضع أو اتجاه مائل)",
 "slap": "صَفْعَة, لَطْمَة / صَفَعَ (ضرب بشدة على الوجه أو الجفن؛ في السياق المجازي: أوقع الشخص في موقف محرج أو مهين) / لَطَمَ (ضربَ بباطن الكفّ على الوجه أو على شيءٍ آخر؛ أصابَ الشيءَ بقوة أو صدمه)\nمثال: صفع المدرس مؤخرتي.",
 "slap-bang": "بصخب وعنف, بعنف مفاجئ (بطريقة عنيفة أو مفاجئة أو صاخبة) / في الصميم, مباشرة (بشكل مباشر أو فوري)\nمثال: سقطت القدور بصخب وعنف وأيقظت المنزل بأكمله",
 "slap-up": "رَائِع, مُمْتَاز (ممتاز؛ بالغ الجودة)",
 "slapdash": "ارْتِطَامًا, مُبَاشَرَةً / غَيْر مُتْقَن, مُرْتَجَل (يَتَّسِم بِالإِهْمَال الشَّدِيد وعَدَم الدِّقَّة) / بإهمال, كيفما اتفق (بطريقة مهملة أو متهورة)\nمثال: اصطدم مباشرة بالعمود",
 "slaphappy": "مُتَرَنِّح, مُخْتَلّ التَّوَازُن (مُشوَّش كأنّه تلقّى ضربات متكرّرة) / طَائِش, لَا مُبَالٍ (غير مسؤول بمرح وخِفّة)",
 "slapper": "صافع, ضارب (ضارب يصفع (عادة شخصًا آخر) بيد مفتوحة)\nمثال: صفعني شخص ما على ظهري واستدرت لأرى من الصافع",
 "slapshot": "تسديدة قوية, رمية خاطفة (تسديدة سريعة تتم بأرجوحة قصيرة وقوية لعصا الهوكي)",
 "slapstick": "تَهْرِيجِيّ (يتّسم بالمُشاغبة والحركة البدنيّة في الكوميديا) / عصا التصفيق (جهاز صوتي يتكون من مضربين مفصليين معاً؛ يستخدمه الممثل لإحداث ضوضاء عالية دون التسبب في إصابة عند ضرب شخص ما) / تهريج, سلابستيك (كوميديا صاخبة تتضمن مطاردات واصطدامات ومقالب)",
 "slash": "خَطّ مَائِل (كِتَابَة؛ ما يَصِل نقطتين أو أكثر)\nمثال: إرسم خط مستقيم.",
 "slash and burn": "القطع والحرق",
 "slash pocket": "جيب شقي (جيب في الملابس يتم الوصول إليه عن طريق شق رأسي أو قطري في الخارج)",
 "slashed": "مُشَقَّقٌ زُخْرُفِيًّا (به شقوق زخرفية طويلة وضيقة تُظهِر القماش الذي تحته) / مَقْطُوع, مُخَفَّض ((عن الأسعار) مخفَّض عادة بشكل حادّ) / مَضْرُوب بِخُطُوط عَرِيضَة (ذو نقش بضربات لونيّة عريضة)",
 "slasher": "سلاح قاطع (سلاح (سيف أو خنجر) يستخدم للقطع) / مشطب (شخص يجرح شخصاً آخر (بآلة حادة))",
 "slashing": "كَاسِح, مُنْدَفِع (كأنّه يضرب بضربات كاسحة قوية)",
 "slat": "سدابة, شريحة (شريط رفيع (من الخشب أو المعدن))",
 "slate": "أَرْدْوَاز",
 "slate club": "نادي الادخار (مجموعة من الأشخاص الذين يدخرون المال في صندوق مشترك لغرض محدد (عادة ما يتم توزيعه في عيد الميلاد))",
 "slate fence": "سياج أردوازي (نوع من السياج المصنوع من ألواح عمودية من الأردواز المربوطة معاً بالأسلاك)",
 "slate pencil": "قلم حجر, قلم لوح (قلم من الأردواز الناعم (أو الحجر الصابوني) يستخدم للكتابة على لوح)",
