 "shibah": "شيفا ((اليهودية) فترة حداد مدتها سبعة أيام بعد وفاة قريب مقرب)\nمثال: الأسرة تجلس في شيفا",
 "shibboleth": "شعار مميز, شيبوليث (طريقة تحدث مميزة لمجموعة معينة من الناس) / شعار, عبارة مميزة (قول مفضل لمجموعة أو منظمة أو فرد)",
 "shibuya": "شِيبُويَا",
 "shield": "مِجَنّ, تُرْس / وَقَى, حَمَى (حَمى شخصًا أو شيئًا من خطرٍ أو أذى؛ اتخذ الاحتياطات اللازمة لتجنب وقوع الضرر)",
 "shield fern": "سرخس الدرع (أي من السراخس المتنوعة من أجناس دريوبتريس أو بوليستيشوم أو لاستريوبسيس لها أغطية تشبه الدرع نوعاً ما على البثرات)",
 "shield of david": "خاتم سليمان, نجمة داود (نجمة سداسية مكونة من مثلثين متساويي الأضلاع)",
 "shield-shaped": "تُرْسِيّ الشَّكْل ((عن شكل الورقة) مُستدير مع اتّصال الساق قرب مركز السطح السُّفليّ)",
 "shielded": "مُدَرَّع, مُغَطًّى بِوَاقٍ ((خاصة عن الآلات) محميّ بدرع لمنع الإصابة)",
 "shielder": "حارِس, حامٍ (شخص يعتني بأشخاص أو ممتلكات ويحميهم)",
 "shielding": "حجب, درع (فعل الحجب عن الأذى) / تدريع إشعاعي, حجب (درع من الرصاص أو الخرسانة يهدف ليكون حاجزاً للإشعاع المنبعث في التحلل النووي) / تدريع, حجب كهرومغناطيسي (درع يتكون من ترتيب لشبكة معدنية أو صفائح مصممة لحماية المعدات الإلكترونية من التداخل الكهرومغناطيسي المحيط)",
 "shieldmaker": "تَرَّاس, وَقَّاء",
 "shift": "نَوْبَة",
 "shift key": "مفتاح العالي, مفتاح شيفت (المفتاح الموجود على لوحة مفاتيح الآلة الكاتبة الذي يحول من الأحرف الصغيرة إلى الأحرف الكبيرة)",
 "shift register": "سجل الإزاحة ((في علم الحاسوب) سجل يمكن فيه إزاحة جميع البتات موضعاً واحداً أو أكثر إلى اليسار أو اليمين)",
 "shifter": "عصا التروس, ناقل الحركة (جهاز ميكانيكي لتعشيق وفصل التروس) / عامل تغيير المناظر (عامل مسرح مسؤول عن تحريك الديكور)",
 "shiftily": "بمراوغة, بنظرات زائغة (بطريقة ماكرة أو غير جديرة بالثقة)\nمثال: نظر إلى زبونه الجديد بمراوغة",
 "shiftiness": "تَقَلُّب, مُرَاوَغَة (صفة التغير في الاتجاه) / احتيال, مراوغة (صفة الشخص المحتال والمراوغ الذي يصعب الإمساك به)\nمثال: تسبب تقلب الرياح في انحراف القارب بشكل لا يمكن التنبؤ به",
 "shifting": "تحول, نقلة (فعل الانتقال من مكان إلى آخر) / غَيْرُ ثَابِت, مُتَحَرِّك ((يُقال عن التربة) غير مستقرّ ومتحرّك) / مُتَحَوِّل, مُتَنَقِّل (يتغير في موقعه أو اتجاهه باستمرار) / مُتَحَوِّلٌ بِاسْتِمْرَار (يَتَفَاوَتُ بِشَكْلٍ مُتَوَاصِل)\nمثال: أدى تحوله المستمر إلى تعطيل الفصل",
 "shiftless": "خَامِل, كَسُول (يفتقر إلى الطموح أو المبادرة أو يتصف بغيابهما)",
 "shiftlessness": "عجز, قلة حيلة (الفشل في أن يكون المرء نشطاً نتيجة لنقص المبادرة أو الطموح)",
 "shifty": "مُتَحَوِّل, مُتَنَقِّل (يتغير في موقعه أو اتجاهه باستمرار) / مُخَاتِل, مُرَاوِغ (يتسم بالرياء أو الخداع؛ مراوغ ومتملص)",
 "shiga": "شِيغَا",
