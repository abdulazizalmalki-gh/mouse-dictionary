 "selar crumenophthalmus": "سكاد كبير العين (من المياه الساحلية الأطلسية؛ تستخدم عادة كطعم)",
 "seldom": "نَادِرًا",
 "select": "اِخْتَارَ",
 "select committee": "لجنة خاصة, لجنة مختارة (لجنة برلمانية مُعينة لغرض خاص)",
 "selected": "مختار, منتقى (تم اختياره تفضيلاً على غيره)",
 "selection": "اختيار, انتقاء (فعل الاختيار أو الانتقاء) / اختيار, خيار (الشخص أو الشيء الذي تم اختياره أو انتقاؤه) / مختارات, مقتبس (مقطع مختار من عمل أكبر) / تشكيلة مختارة, خيار (مجموعة متنوعة من الأشياء التي يمكن الاختيار منها)\nمثال: كان اختيارك للألوان غير موفق",
 "selective": "اِنْتِقَائِيّ",
 "selective amnesia": "فقدان ذاكرة انتقائي (نسيان أحداث معينة، وغالباً ما يكون مناسباً للشخص الذي لا يتذكر)\nمثال: لماذا يصاب السياسيون دائماً بفقدان الذاكرة الانتقائي عندما يسألون عن تجاوزاتهم؟",
 "selective information": "إنتروبيا, اعتلاج ((نظرية الاتصال) مقياس رقمي لعدم اليقين في نتيجة ما)\nمثال: احتوت الإشارة على آلاف البتات من المعلومات",
 "selective jamming": "تشويش انتقائي, تشويش نقطي (تشويش إلكتروني لقناة أو تردد محدد)",
 "selective lipectomy": "استئصال الشحم (جراحة تجميلية تتضمن تفتيت وإزالة الأنسجة الدهنية)",
 "selective service": "تجنيد إجباري, خدمة إلزامية (الخدمة العسكرية الإلزامية) / نظام الخدمة الانتقائية (وكالة فيدرالية مستقلة تدير الخدمة العسكرية الإجبارية)",
 "selective service system": "نظام الخدمة الانتقائية (وكالة فيدرالية مستقلة تدير الخدمة العسكرية الإجبارية)",
 "selective-serotonin reuptake inhibitor": "مثبط استرداد السيروتونين الانتقائي (دواء مضاد للاكتئاب يعمل عن طريق منع استرداد السيروتونين بحيث يتوفر المزيد من السيروتونين للعمل على المستقبلات في الدماغ)",
 "selectively": "انتقائياً, بشكل انتقائي (عن طريق الاختيار؛ بطريقة انتقائية)\nمثال: نختار طلابنا بشكل انتقائي للغاية",
 "selectivity": "اِنْتِقَائِيَّة",
 "selectman": "عضو مجلس محلي (عضو منتخب ذكر في مجلس المسؤولين الذين يديرون بلدات نيو إنجلاند)",
 "selector": "مفتاح اختيار (مفتاح يستخدم للاختيار بين البدائل) / مُخْتَار, مُنْتَقٍ (شخص يختار أو ينتقي)",
 "selector switch": "مفتاح اختيار (مفتاح يستخدم للاختيار بين البدائل)",
 "selectwoman": "عضوة مجلس محلي (عضوة منتخبة أنثى في مجلس المسؤولين الذين يديرون بلدات نيو إنجلاند)",
