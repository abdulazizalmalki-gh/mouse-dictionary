 "selva": "سيلفا, غابة مطيرة استوائية (غابة مطيرة في منطقة استوائية)",
 "selvage": "برسل, حاشية القماش (حافة القماش المنسوجة بحيث لا تنسل أو تتآكل) / حاشية السجاد (حد يتكون من هدب زخرفي في أحد طرفي السجادة الشرقية)",
 "selvedge": "برسل, حاشية القماش (حافة القماش المنسوجة بحيث لا تنسل أو تتآكل) / حاشية السجاد (حد يتكون من هدب زخرفي في أحد طرفي السجادة الشرقية)",
 "semaglutide": "سيماجلوتيد",
 "semantic": "دَلَالَات الأَلفَاظ",
 "semantic error": "خطأ دلالي, خطأ وقت التشغيل (خطأ في المنطق أو الحساب يجب اكتشافه في وقت التشغيل)",
 "semantic loan": "اِقْتِرَاض مَعْنَوِيّ (طلب أخذ شيء بشكل مؤقت مع الالتزام بإعادته، وغالبًا يشير إلى المال أو الموارد)",
 "semantic memory": "ذاكرة دلالية (ذاكرتك للمعاني والحقائق العامة (غير الشخصية))",
 "semantic relation": "عَلَاقَة دَلَالِيَّة (علاقة بين المعاني)",
 "semantic role": "دور دلالي ((لغويات) العلاقة الأساسية التي يمتلكها مكون مع الفعل الرئيسي في الجملة)",
 "semantically": "دلالياً, معنوياً (فيما يتعلق بالمعنى)\nمثال: رسائل فارغة دلالياً",
 "semanticist": "سيميائي, عالم دلالة الألفاظ (متخصص في دراسة المعنى)",
 "semantics": "عِلْم اَلْمَعَانِي (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "semaphore": "إشارة بصرية, سيمافور (جهاز للإشارات البصرية باستخدام الأضواء أو الأذرع المتحركة ميكانيكياً)",
 "semaphore line": "تلغراف بصري, خط الإشارة (نظام لنقل المعلومات عن طريق الإشارات المرئية، باستخدام أبراج ذات مصاريع محورية؛ يتم تشفير المعلومات بواسطة موضع العناصر الميكانيكية)",
 "semaphore plant": "نبات التلغراف, نبات الراقص (شجيرة آسيوية استوائية منتصبة تدور وريقاتها الجانبية الصغيرة على محاورها وتهتز صعوداً وهبوطاً تحت تأثير أشعة الشمس)",
 "semaphore telegraph": "تلغراف سيمافور, تلغراف مرئي (برج به مصاريع أو أذرع محورية يستخدم لنقل المعلومات عن طريق إشارات بصرية تُقرأ عندما يكون المصراع في وضع ثابت)",
 "semasiology": "علم الدلالة المعرفي (فرع علم الدلالة الذي يدرس الجوانب المعرفية للمعنى)",
 "semblance": "شبه, صورة مماثلة (صورة تتكون من تمثيل رسومي لشخص أو شيء) / شبه, صبغة (مظهر خارجي أو شكلي مضلل عمداً) / مظهر خادع, وهم (تمثيل عقلي خاطئ)\nمثال: أمل أن يكون لادعاءاته مظهر من المصداقية",
 "semelfactive verb": "فعل المرة, فعل لحظي (صيغة فعل تعبر عن حدث يقع مرة واحدة دون تكرار أو استمرار)\nمثال: الأفعال اللحظية تشمل 'رمش'، 'عطس'، و 'طرق'",
 "semen": "مَنِيّ",
 "semester": "فَصْل دِرَاسِيّ, نِصْف سَنَة (التقطيع؛ تقسيم الشيء أجزاءً؛ جزء، باب في كِتَاب أو ماشابهه)\nمثال: اقرأ هذا الفصل.",
 "semester hour": "ساعة فصلية, ساعة معتمدة (وحدة للرصيد الأكاديمي؛ ساعة واحدة في الأسبوع لفصل دراسي أكاديمي)",
 "semestral": "فَصْلِيّ, نِصْفُ سَنَوِيّ (يحدث كل ستة أشهر أو خلال كل فصل دراسي)",
 "semestrial": "فَصْلِيّ, نِصْفُ سَنَوِيّ (يحدث كل ستة أشهر أو خلال كل فصل دراسي)",
 "semi": "نصف مقطورة (مقطورة لها عجلات في الخلف فقط؛ بينما يتم دعم الجزء الأمامي بواسطة مركبة السحب) / تريلا, شاحنة مقطورة (شاحنة تتكون من جرار ومقطورة معاً) / نصف النهائي (واحدة من المسابقتين في الجولة قبل الأخيرة من بطولة خروج المغلوب)",
 "semi-abstraction": "شبه تجريدية (لوحة شبه تجريدية)",
 "semi-circular bastion": "حصن نصف دائري (نوع من الحصون استخدم في القرن السادس عشر؛ فقد شعبيته بسبب صعوبة تركيز نيران المدافع الموزعة حول منحنى)",
 "semi-climber": "نبات شبه متسلق (نبات يميل إلى التسلق ويمكن أن ينمو أحياناً كالكرمة)",
 "semi-climbing": "شِبْه مُتَسَلِّق (من النباتات التي تتسلَّق جزئيّاً)",
 "semi-detached house": "منزل شبه منفصل (مسكن متصل بشيء ما من جانب واحد فقط)",
 "semi-dry": "شِبْه جَافّ (جافّ إلى حدٍّ ما)",
 "semi-erect": "شِبْه مُنْتَصِب (من النباتات المنتصبة جزئيّاً)",
 "semi-evergreen": "شِبْه دَائِم الخُضْرَة (عن نبات ليس دائم الخضرة بشكل كامل)",
 "semi-formal": "شِبْهُ رَسْمِيّ (رَسْمِيٌّ بِشَكْلٍ مُعْتَدِلٍ؛ يَسْتَلْزِمُ ارْتِدَاءَ بَدْلَةِ عَشَاءٍ)",
 "semi-legality": "شِبْه قَانُونِيَّة (خاصية كون الشيء قانونياً جزئياً أو مشكوكاً في قانونيته)",
 "semi-metric space": "فضاء شبه متري, فضاء متري كاذب (فضاء متري معمّم يمكن أن تكون فيه المسافة بين نقطتين مختلفتين صفراً)\nمثال: بنفس الطريقة التي يكون فيها كل فضاء معياري فضاءً مترياً، فإن كل فضاء شبه معياري هو فضاء شبه متري",
 "semi-precious stone": "حجر شبه كريم (حجر كريم ذو قيمة أقل)",
 "semi-processed": "شِبْهُ مُعَالَجٍ (خضع لمعالجة جزئية)",
 "semi-prostrate": "شِبْه مُنْبَطِح (منبطح بشكل ناقص؛ منبطح في جزء من طوله)",
 "semi-skimmed milk": "حليب نصف دسم (حليب تم إزالة جزء من القشدة منه)",
 "semi-sweet chocolate": "شوكولاتة داكنة, شوكولاتة نصف محلاة (سائل شوكولاتة مع زبدة كاكاو وكميات صغيرة من السكر والفانيليا؛ يضاف الليسيثين عادة)",
 "semi-tuberous": "شبه درني (درني جزئياً)",
 "semi-upright": "شِبْه قَائِم (من الحيوانات المنتصبة جزئيّاً)",
 "semi-vegetarianism": "شبه نباتية, نباتية مرنة (ممارسة تناول الطعام النباتي بشكل أساسي، مع استثناءات عرضية لتناول اللحوم لأسباب اجتماعية أو عملية أو ثقافية أو غذائية)\nمثال: ستكون النباتية المرنة التوجه الكبير التالي",
 "semi-wild": "شِبْهُ بَرِّيّ (بَرِّيٌّ جُزْئِيًّا؛ لَيْسَ مُدَجَّنًا بِالكَامِل)",
 "semiabstract": "شِبْهُ تَجْرِيدِيّ (يتميز بموضوع مُنَمَّط لكن يمكن التعرف عليه)",
 "semiannual": "نِصْفُ سَنَوِيّ (يحدث أو يُدفع مرتين في السنة)",
 "semiannually": "مَرَّتَيْن فِي السَّنَة, نِصْف سَنَوِيًّا (مرتين في السنة)",
 "semiaquatic": "شِبْه مَائِيّ, نِصْف مَائِيّ (مائيّ جزئيًّا؛ يعيش أو ينمو جزئيًّا على اليابسة وجزئيًّا في الماء) / بَرْمَائِيّ, شِبْه مَائِيّ (ذو طور يرقيّ مائيّ وطور بالغ بَرّيّ)",
 "semiarid": "شِبْه قَاحِل (قاحل إلى حدٍّ ما)",
 "semiautobiographical": "شبه سيري ذاتي (مكون من أو متعلق بعمل يجمع بين السيرة الذاتية والخيال)\nمثال: رواية شبه سيرية ذاتية",
 "semiautomatic": "ذَاتِيّ التَّعْبِئَة, نِصْف آلِيّ ((للأسلحة النارية) قادر على التعبئة والإطلاق المتواصل آلياً) / نِصْف آلِيّ (آلي جزئياً) / مسدس نصف آلي (مسدس عبارة عن سلاح ناري نصف آلي قادر على التحميل والإطلاق بشكل مستمر)",
 "semiautomatic firearm": "سلاح ناري نصف آلي (سلاح ذاتي التحميل يطلق طلقة واحدة فقط مع كل سحبة للزناد)",
 "semiautomatic pistol": "مسدس نصف آلي (مسدس عبارة عن سلاح ناري نصف آلي قادر على التحميل والإطلاق بشكل مستمر)",
 "semibreve": "مُسْتَدِيرَة (مؤنث مُسْتَدِير، يُجمع جمعًا سالمًا على مُسْتَدِيرَات)",
 "semicentenary": "نصف قرني, يوبيل ذهبي (من أو يتعلق بالذكرى الخمسين أو يميزها) / نصف مئوية (الذكرى الخمسون (أو الاحتفال بها))",
 "semicentennial": "نصف قرني, يوبيل ذهبي (من أو يتعلق بالذكرى الخمسين أو يميزها) / نصف مئوية (الذكرى الخمسون (أو الاحتفال بها))",
 "semicircle": "نصف دائرة (شكل مستوٍ له شكل نصف دائرة)",
 "semicircular": "نِصْف دَائِرِيّ (منحنٍ على شكل نصف دائرة)",
 "semicircular arch": "قوس روماني, قوس نصف دائري (قوس مستدير مرسوم من مركز واحد)",
 "semicircular canal": "قناة هلالية (إحدى ثلاث حلقات أنبوبية مملوءة بسائل وفي مستويات متعامدة تقريباً مع بعضها البعض؛ معنية بالتوازن)",
 "semicoke": "شبه كوك (بقايا صلبة يتم الحصول عليها عن طريق كربنة الفحم عند درجة حرارة منخفضة نسبياً (أقل من 700 درجة مئوية))\nمثال: يعطي شبه الكوك ناراً ساخنة عديمة الدخان ويمكن استخدامه كوقود منزلي",
 "semicolon": "فَاصِلَة مَنْقُوطَة",
 "semicoma": "شبه غيبوبة (حالة غيبوبة خفيفة؛ غيبوبة يمكن إيقاظ الشخص منها بمحفزات مناسبة)",
 "semicomatose": "شِبْهُ غَيْبُوبِيّ (فِي حَالَةِ غَيْبُوبَةٍ جُزْئِيَّةٍ)",
 "semiconducting": "شِبْهُ مُوَصِّل, نِصْفُ نَاقِل (لَهُ خَصَائِصُ شِبْهِ المُوَصِّلِ؛ أَيْ مُوَصِّلِيَّةٌ كَهْرَبَائِيَّةٌ مُتَوَسِّطَةٌ)",
 "semiconducting material": "شبه موصل, مادة شبه موصلة (مادة مثل الجرمانيوم أو السيليكون تكون موصليتها الكهربائية متوسطة بين موصلية المعدن والعازل؛ تزداد موصليتها مع درجة الحرارة وفي وجود الشوائب)",
 "semiconductive": "شِبْهُ مُوَصِّل, نِصْفُ نَاقِل (لَهُ خَصَائِصُ شِبْهِ المُوَصِّلِ؛ أَيْ مُوَصِّلِيَّةٌ كَهْرَبَائِيَّةٌ مُتَوَسِّطَةٌ)",
 "semiconductor": "شِبْه مُوَصِّل",
 "semiconductor device": "جهاز شبه موصل, نبيطة شبه موصلة (موصل مصنوع من مادة شبه موصلة)",
 "semiconductor diode": "دايود, صمام ثنائي",
 "semiconductor unit": "جهاز شبه موصل, نبيطة شبه موصلة (موصل مصنوع من مادة شبه موصلة)",
 "semiconscious": "شِبْهُ وَاعٍ, نِصْفُ وَاعٍ (وَاعٍ جُزْئِيًّا؛ لَيْسَ مُدْرِكًا لِلْأَحَاسِيسِ بِشَكْلٍ كَامِلٍ)",
 "semiconsciousness": "ترنح, ذهول (وعي هامشي)\nمثال: كان ترنحه بسبب الإرهاق بقدر ما كان بسبب الضربات",
 "semidark": "شِبْه مُظْلِم, نِصْف مُعْتِم (خَالٍ جُزْئِيًّا مِنَ الضَّوْء أَوِ السُّطُوع)",
 "semidarkness": "شبه ظلام (ظلام جزئي)",
 "semidesert": "شبه صحراء (منطقة تشبه الصحراء إلى حد كبير ولكنها تقع عادة بين الصحراء والمناطق المحيطة بها)",
 "semidetached": "شِبْه مُنْفَصِل (متّصل من جانب واحد فقط)",
 "semidetached house": "دوبلكس, منزل مزدوج (منزل بوحدتين تشتركان في جدار مشترك)",
 "semidiameter": "نصف القطر الظاهري (نصف القطر الظاهري لجرم سماوي عند مشاهدته كقرص من الأرض)",
 "semiempirical": "شِبْهُ تَجْرِيبِيّ (يعتمد إلى حدّ ما على الملاحظة أو التجربة)",
 "semiepiphyte": "نبات نصف هوائي (نبات يعيش كنبات هوائي لجزء من حياته)",
 "semifinal": "الدور قبل النهائي",
 "semifinalist": "متأهل لنصف النهائي (واحد من أربعة منافسين متبقين في بطولة بنظام الإقصاء)",
 "semifluidity": "شبه سيولة (خاصية وسطية بين الصلابة والسيولة)",
 "semiformal": "شِبْهُ رَسْمِيّ (رَسْمِيٌّ بِشَكْلٍ مُعْتَدِلٍ؛ يَسْتَلْزِمُ ارْتِدَاءَ بَدْلَةِ عَشَاءٍ)",
 "semigloss": "نصف لامع (طلاء يجف بلمسة نهائية بين اللامعة وغير اللامعة)",
 "semihard": "شِبْه صُلْب (صُلْب إلى حَدٍّ ما؛ بَيْن اللِّين والصَّلابَة)",
 "semilegality": "شِبْه قَانُونِيَّة (خاصية كون الشيء قانونياً جزئياً أو مشكوكاً في قانونيته)",
 "semiliquid": "شِبْهُ سَائِل (سائل إلى حدّ ما؛ بين الصلب والسائل)",
 "semiliterate": "شِبْهُ مُتَعَلِّم (يعرف القراءة والكتابة لكنّه ضعيف الاطّلاع) / نِصْف مُتَعَلِّم (بِالكاد يَسْتَطيع القِراءَة وَالكِتابَة) / يَقْرَأ وَلَا يَكْتُب (قادِر عَلى القِراءَة لَكِنَّه لا يَسْتَطيع الكِتابَة)",
 "semilunar": "هِلَالِيُّ الشَّكْلِ, هِلَالِيّ (ذو شكل يشبه الهلال)",
 "semilunar bone": "عظم هلالي (أحد عظام الرسغ الصغيرة الثمانية)",
 "semilunar cartilage": "غضروف هلالي, هلالة ((في التشريح) قرص غضروفي يعمل كوسادة بين نهايات العظام التي تلتقي عند المفصل)",
 "semilunar valve": "صمام هلالي (صمام قلبي ذو شرفات على شكل أنصاف أقمار؛ يمنع الدم من التدفق عائداً إلى القلب)",
 "semimajor axis": "نصف المحور الأكبر (نصف المحور الأكبر للقطع الناقص؛ المسافة من مركز القطع الناقص إلى أحد طرفيه)",
 "semiminor axis": "نصف المحور الأصغر (نصف المحور الأصغر للقطع الناقص)",
 "semimonthly": "مَرَّتَيْن فِي الشَّهْر (مرتين في الشهر) / نِصْفُ شَهْرِيّ (يحدث مرتين في الشهر) / نصف شهرية (دورية تصدر مرتين كل شهر (أو 24 عدداً في السنة))\nمثال: الرواتب تدفع مرتين في الشهر",
 "seminal": "بَذْرِيّ, جَنِينِيّ (يحتوي على بذور التطور اللاحق) / منوي (يخص أو يحتوي على أو يتكون من السائل المنوي)\nمثال: سائل منوي",
 "seminal duct": "قناة منوية (القناة الصادرة للخصية عند الإنسان)",
 "seminal fluid": "سائل منوي, مني (السائل الأبيض الكثيف الذي يحتوي على الحيوانات المنوية والذي يقذفه الجهاز التناسلي الذكري)",
 "seminal vesicle": "حُوَيْصِلَة مَنَوِيَّة",
 "seminar": "نَدْوَة",
 "seminarian": "طالب لاهوت (طالب في معهد لاهوتي (خاصة المعهد الكاثوليكي))",
 "seminarist": "طالب لاهوت (طالب في معهد لاهوتي (خاصة المعهد الكاثوليكي))",
 "seminary": "مدرسة بنات, مدرسة خاصة (مكان خاص لتعليم الصغار) / كلية لاهوت, معهد لاهوتي (مدرسة لاهوتية لتدريب القساوسة أو الكهنة أو الحاخامات)",
 "seminiferous": "منتج للمني, منوي (يحمل أو ينتج البذور أو السائل المنوي)\nمثال: أنابيب منوية",
 "seminiferous tubule": "نُبيب منوي (أي من النبيبات الطويلة الملتوية العديدة في الخصية والتي تعد مواقع نضوج الحيوانات المنوية)",
 "seminole": "لغة سيمينول (اللغة المسكوكية لشعب سيمينول) / سيمينول (فرد من الشعب المسكوكي الذي انتقل إلى فلوريدا في القرن الثامن عشر)",
 "seminole bread": "زاميا قزمة, كونتي (زاميا خشبية صلبة صغيرة في فلوريدا وجزر الهند الغربية وكوبا؛ تنتج الجذور والسيقان نصف المدفونة نشا الأروروت)",
 "seminole language": "لغة سيمينول (اللغة المسكوكية لشعب سيمينول)",
 "seminoma": "سرطان الخصية, ورم منوي (ورم خبيث في الخصية؛ يحدث عادة عند الرجال الأكبر سنًا)",
 "seminude": "شِبْه عَارٍ (مكسوّ جزئياً فقط)",
 "semiofficial": "شِبْه رَسْمِيّ (له بعض السلطة أو الإقرار الرسميّ)",
 "semiology": "سيميائية, علم العلامات ((فلسفة) نظرية فلسفية لوظائف العلامات والرموز)",
 "semiopaque": "شِبْه مُعْتِم (معتم جزئيّاً)",
 "semiotic": "سيميائي, علاماتي (مكون من أو متعلق بالسيميائية (علم العلامات))\nمثال: تحليل سيميائي",
 "semiotical": "سيميائي, علاماتي (مكون من أو متعلق بالسيميائية (علم العلامات))\nمثال: تحليل سيميائي",
 "semiotician": "سيميائي, عالم دلالة الألفاظ (متخصص في دراسة المعنى)",
 "semiotics": "سميوطيقا",
 "semiparasite": "نصف طفيلي (نبات طفيلي يحتوي على بعض الكلوروفيل وبالتالي فهو قادر على التمثيل الضوئي)",
 "semiparasitic": "شبه طفيلي (مكون من أو متعلق بنباتات شبه طفيلية)",
 "semipermanent": "شِبْه دَائِم, طَوِيل الأَمَد (مُتَعَلِّق بِفَتْرَة زَمَنِيَّة طَويلَة نِسْبِيًّا أَوْ مُمْتَدّ عَلَيْها)",
 "semipermeable": "شِبْه نَفَّاذ ((في الأغشية) نفّاذ بشكل انتقائيّ)",
 "semipermeable membrane": "غشاء شبه منفذ (غشاء (مثل غشاء الخلية) يسمح لبعض الجزيئات بالمرور من خلاله دون غيرها)",
 "semipolitical": "شِبْه سِيَاسِيّ (سياسي في بعض جوانبه وليس كلها)",
 "semiprecious": "شِبْهُ كَرِيم (يُسْتَخْدَمُ لِلأَحْجَارِ الكَرِيمَةِ ذَاتِ القِيمَةِ التِّجَارِيَّةِ الأَقَلِّ مِنَ الأَحْجَارِ الثَّمِينَة)",
 "semiprivate": "شِبْه خَاصّ (مقصور على عدد قليل من المرضى في المستشفى)",
 "semipro": "شبه محترف (رياضي يلعب مقابل أجر على أساس جزئي)",
 "semiprofessional": "شبه محترف (رياضي يلعب مقابل أجر على أساس جزئي)",
 "semipublic": "شِبْه عَامّ (يحمل بعض سمات المؤسسة العامّة)",
 "semiquaver": "ذات السنين, نوتة سداسية عشرية (نوتة موسيقية لها قيمة زمنية تعادل سدس عشر نوتة كاملة)",
 "semirigid": "شِبْهُ صَلْب (لَيْسَ صَلْبًا تَمَامًا؛ بَيْنَ الصَّلَابَةِ وَالمُرُونَةِ) / شِبْهُ صَلْبِ الهَيْكَل (يَحْتَفِظُ بِشَكْلِهِ بِوَاسِطَةِ هَيْكَلٍ دَاخِلِيٍّ صَلْبٍ وَضَغْطِ غَازٍ دَاخِلِيٍّ مَعًا)",
 "semisoft": "شِبْه لَيِّن, لَيِّن نَوْعًا ما (بَيْن اللِّين والصَّلابَة؛ طَرِيّ إلى حَدٍّ ما)",
 "semisolid": "شِبْهُ صُلْب (صلب جزئيًّا؛ ذو صلابة ولزوجة وسطى بين الصلب والسائل)",
 "semisweet": "مُرٌّ وَحُلْو, نِصْفُ حُلْو (ذُو طَعْمٍ يَجْمَعُ بَيْنَ المَرَارَةِ وَالحَلَاوَة)",
 "semisynthetic": "تَرْكِيبِيّ, مَصْنُوع (ليس من أصل طبيعي؛ أُعِدّ أو صُنِع صناعيًّا)",
 "semite": "سَامِيّ, سَامِيَّة (مِنْ أو متعلق بأحد الشعوب السامية)\nمثال: سامي كان السبب.",
 "semiterrestrial": "شبه بري (بري بشكل رئيسي ولكن ليس حصرياً)",
 "semitic": "سَامِيّ (مِنْ أو متعلق بأحد الشعوب السامية)\nمثال: سامي كان السبب.",
 "semitic deity": "إله سامي (إله عبده الساميون القدماء)",
 "semitic-speaking": "نَاطِقٌ بِالسَّامِيَّة (قادر على التواصل بلغة سامية)",
 "semitone": "نصف بعد, نصف نغمة (الفاصل الموسيقي بين المفاتيح المتجاورة على آلة لوحة المفاتيح)",
 "semitrailer": "نصف مقطورة (مقطورة لها عجلات في الخلف فقط؛ بينما يتم دعم الجزء الأمامي بواسطة مركبة السحب)",
 "semitrance": "شبه غشية (حالة تشبه الغشية يمكن للشخص فيها اتباع التعليمات ولكن العمل الإرادي ضعيف أو غائب)",
 "semitransparency": "شُفُوفِيَّة, نِصْف شَفَّافِيَّة (خاصية السماح بمرور الضوء بشكل مشتت)",
 "semitransparent": "شِبْه شَفَّاف (يسمح بمرور الضوء بشكل منتشر دون أن يكون شفّافاً تماماً)",
 "semitropic": "شبه استوائي, شبه مداري (متعلق بظروف المناطق شبه الاستوائية أو مميز لها)\nمثال: حتى بالقرب من خط الاستواء، يكون الغطاء النباتي عند ارتفاع 5000 قدم شبه استوائي وليس استوائياً",
 "semitropical": "شبه استوائي, شبه مداري (متعلق بظروف المناطق شبه الاستوائية أو مميز لها)\nمثال: حتى بالقرب من خط الاستواء، يكون الغطاء النباتي عند ارتفاع 5000 قدم شبه استوائي وليس استوائياً",
 "semitropics": "المنطقة شبه الاستوائية (المناطق المتاخمة للمناطق الاستوائية)",
 "semivowel": "أَشْبَاهُ العِلَلِ",
 "semiweekly": "مَرَّتَيْن فِي الأُسْبُوع (مرتين في الأسبوع) / نِصْفُ أُسْبُوعِيّ (يحدث مرتين في الأسبوع) / نصف أسبوعية (دورية تصدر مرتين كل أسبوع (أو 104 أعداد في السنة))\nمثال: اتصل بالمنزل مرتين في الأسبوع",
 "semnan": "سِمْنَان",
 "semnopithecus entellus": "لانغور رمادي, هانو مان (لانغور يعيش في جنوب آسيا؛ يعتبر مقدساً في الهند)",
 "semolina": "سَمِيذ, سَمِيدْ",
 "sempiternal": "أَبَدِيّ, سَرْمَدِيّ (لَيْسَ لَهُ بِدَايَةٌ مَعْرُوفَةٌ وَلَا نِهَايَةٌ مُفْتَرَضَةٌ)",
 "sempiternity": "أبدية, خلود (خاصية كونه أبدياً (يبدو بلا توقف))",
 "sempstress": "خياطة (امرأة تصنع أو تصلح الفساتين)",
 "sen": "سن (وحدة نقدية كسرية لليابان وإندونيسيا وكمبوديا؛ تساوي واحداً من المائة من الين أو الروبية أو الرييل)",
 "senate": "مَجْلِس الشُّيُوخ",
 "senate campaign": "حملة مجلس الشيوخ, سباق مجلس الشيوخ (سباق للانتخاب في مجلس الشيوخ)",
 "senate race": "حملة مجلس الشيوخ, سباق مجلس الشيوخ (سباق للانتخاب في مجلس الشيوخ)",
 "senator": "سِنَاتُور, سِنَاتُورَة",
 "senatorial": "سناتوري, مشيخي (مكون من أو متعلق بأعضاء مجلس الشيوخ (السناتورات))\nمثال: انتخابات مجلس الشيوخ",
 "senatorship": "عضوية مجلس الشيوخ (منصب السيناتور (عضو مجلس الشيوخ))",
 "send": "أَرْسَلَ, بَعَثَ (بَعَثَ؛ أَطْلَقَ)\nمثال: هو أرسل لي هدية.",
 "send-off": "تَوْدِيع, حَفْل وَدَاع (تعبير منظم عن حسن النية عند بدء رحلة أو مشروع جديد) / انطلاق, ضربة البداية (بداية تعطى للمتسابقين)\nمثال: كنت هناك مع والدي عند الانطلاق",
 "send-up": "بَارُودِيَا, مُحَاكَاة سَاخِرَة (تكوين يقلد أو يحرف أسلوب شخص ما، عادة بطريقة فكاهية)",
 "sendai": "سِنْدَاي",
 "sendee": "المرسل إليه (المستلم المقصود للرسالة)",
 "sender": "مُرْسِل, مُرْسِلَة",
 "sending": "إرسال, بعث (فعل التسبب في ذهاب شيء ما (خاصة الرسائل))",
 "sendup": "بَارُودِيَا, مُحَاكَاة سَاخِرَة (تكوين يقلد أو يحرف أسلوب شخص ما، عادة بطريقة فكاهية)",
 "sene": "سيني (100 سيني تساوي 1 تالا في ساموا الغربية)",
 "seneca": "لغة سينيكا (اللغة الإيروكوية التي يتحدث بها شعب سينيكا) / سينيكا (فرد من شعب إيروكواس كان يعيش سابقاً في ولاية نيويورك جنوب بحيرة أونتاريو)",
 "seneca language": "لغة سينيكا (اللغة الإيروكوية التي يتحدث بها شعب سينيكا)",
 "seneca snakeroot": "جذر ثعبان سينيكا, جذر سينيغا (نبات من شرق أمريكا الشمالية له عنقود طرفي من الزهور البيضاء الصغيرة وجذور طبية)",
 "senecan": "سينيكي (من أو يتعلق بالروماني سينيكا أو يشبهه أو على طريقته)",
 "senecio aureus": "باكرا ذهبية, شيخة ذهبية (عشب ضار في شرق الولايات المتحدة إلى تكساس له أزهار صفراء ذهبية؛ يصبح أحياناً غزواً؛ يوضع أحياناً في جنس شيخة)",
 "senecio bigelovii": "شيخة بيغلو, شيخة مائلة (نبات ذو سيقان ورقية منتصبة تحمل عناقيد من رؤوس زهور صفراء عديمة الشعاع على سيقان فردية منحنية؛ المناطق الرطبة في جنوب غرب الولايات المتحدة)",
 "senecio cineraria": "سينراريا فضية, طاحونة مغبرة (نبات معمر صلب كثير التفرع من منطقة البحر الأبيض المتوسط ذو سيقان وأوراق صوفية بيضاء جداً)",
 "senecio cruentus": "سينراريا (عشب من جزر الكناري يُزرع على نطاق واسع لزهوره الزرقاء أو الأرجوانية أو الحمراء أو المتنوعة التي تشبه الأقحوان)",
 "senecio douglasii": "شيخة خيطية الأوراق (نبات ورقي كثيف أزرق مخضر مغطى بصوف أبيض كثيف ويحمل عناقيد متفرعة من رؤوس الزهور الصفراء؛ جنوب غرب الولايات المتحدة؛ سام لحيوانات المراعي)",
 "senecio glabellus": "شيخة, عشب الزبدة (نبات شيخة أمريكي ذو أزهار صفراء)",
 "senecio jacobaea": "شيخة متكاملة الأوراق, شيخة يعقوبية (عشب ضار أوروبي واسع الانتشار له أزهار صفراء تشبه الأقحوان؛ أحياناً يكون عشباً ضاراً بغيضاً وساماً للماشية إذا استهلك بكميات كبيرة)",
 "senecio milkanioides": "لبلاب ألماني",
 "senecio triangularis": "شيخة سهمية الأوراق (نبات معمر بأوراق مثلثة حادة التسنن على سيقان ورقية تحمل عنقوداً من رؤوس الزهور الصفراء؛ الأماكن الرطبة في جبال غرب أمريكا الشمالية)",
 "senecio vulgaris": "شيخة الرماد, شيخة شائعة (عشب أوراسي ضار برؤوس من الزهور الصفراء الصغيرة)",
 "senega": "سينيغا (عشب شجيري معمر من وسط وجنوب الولايات المتحدة له زهور بيضاء بمراكز خضراء وغالباً عرف أرجواني؛ يشبه جذر ثعبان سينيكا) / سينيغا (جذر مجفف لنباتين من جنس المغزر يحتوي على صابونين مهيج)",
 "senega root": "جذر ثعبان سينيكا, جذر سينيغا (نبات من شرق أمريكا الشمالية له عنقود طرفي من الزهور البيضاء الصغيرة وجذور طبية)",
 "senega snakeroot": "جذر ثعبان سينيكا, جذر سينيغا (نبات من شرق أمريكا الشمالية له عنقود طرفي من الزهور البيضاء الصغيرة وجذور طبية)",
 "senegal": "السِّنْغَال",
 "senegal gum": "صمغ سنغالي (صمغ عربي من منطقة نهر السنغال)",
 "senegalese": "سنغالي (من أو متعلق أو مميز للسنغال أو شعبها) / سِنْغالِيّ (مواطن أو ساكن في السنغال)\nمثال: قرى سنغالية",
 "senegalese franc": "فرنك سنغالي (وحدة المال الأساسية في السنغال)",
 "seneka snakeroot": "جذر ثعبان سينيكا, جذر سينيغا (نبات من شرق أمريكا الشمالية له عنقود طرفي من الزهور البيضاء الصغيرة وجذور طبية)",
 "senescence": "شيخوخة, هرم (الخاصية المميزة للشيخوخة) / تقدم في السن, شيخوخة (العملية العضوية للتقدم في العمر وظهور آثار زيادة السن)",
 "senescent": "آخِذ فِي الشَّيْخُوخَة, شَائِخ (في طور التقدّم في السنّ والشيخوخة)",
 "seneschal": "كبير الخدم (رئيس الخدم أو النادل في منزل كبير)",
 "senga root": "جذر ثعبان سينيكا, جذر سينيغا (نبات من شرق أمريكا الشمالية له عنقود طرفي من الزهور البيضاء الصغيرة وجذور طبية)",
 "senhor": "سنيور, سيد (لقب احترام برتغالي؛ يعادل 'سيد' في الإنجليزية)",
 "senile": "خَرِف, هَرِم (ضعيف عقلياً أو جسدياً بسبب الشيخوخة)",
 "senile dementia": "خرف الشيخوخة, ذهان الشيخوخة (خرف يصيب المسنين؛ ينتج عن تنكس الدماغ في غياب الأمراض الوعائية الدماغية)",
 "senile psychosis": "خرف الشيخوخة, ذهان الشيخوخة (خرف يصيب المسنين؛ ينتج عن تنكس الدماغ في غياب الأمراض الوعائية الدماغية)",
 "senility": "خرف, هرم (حالة الخرف) / خرف, هرم (الضعف العقلي نتيجة لكبر السن)",
 "senior": "طَاعِن فِي السِّنّ, مُسِنّ (متقدّم في العمر) / أرفع مقاماً, أقدم (أكبر سنًا؛ أعلى رتبة؛ أطول في مدة الولاية أو الخدمة) / أَكْبَر سِنّاً, مُسِنّ (شخص أكبر منك سناً) / طالب سنة نهائية (طالب جامعي خلال السنة التي تسبق التخرج)\nمثال: ضابط كبير",
 "senior chief petty officer": "رئيس ضباط الصف الأول (ضابط صف كبير في البحرية أو خفر السواحل برتبة تعادل رقيب أول في الجيش)",
 "senior citizen": "عجوز, كبير السن (شخص متقدم في السن)",
 "senior class": "السنة الأخيرة, الصف النهائي (الصف أو السنة النهائية في المدرسة الثانوية أو الكلية)",
 "senior high": "مدرسة ثانوية, مدرسة ثانوية عليا (مدرسة ثانوية عامة تشمل عادة الصفوف من 9 إلى 12)\nمثال: يذهب إلى المدرسة الثانوية في الحي",
 "senior high school": "مدرسة ثانوية, مدرسة ثانوية عليا (مدرسة ثانوية عامة تشمل عادة الصفوف من 9 إلى 12)\nمثال: يذهب إلى المدرسة الثانوية في الحي",
 "senior master sergeant": "رقيب أول جوي (ضابط صف كبير في القوات الجوية برتبة مماثلة لرقيب أول في الجيش)",
 "senior moment": "هفوة ذاكرة (هفوة لحظية في الذاكرة (خاصة عند كبار السن))",
 "senior pilot": "قائد الطائرة, كبير الطيارين (الطيار المسؤول عن المنطاد أو الطائرة)",
 "senior status": "أقدمية (رتبة أعلى من الآخرين خاصة بسبب الخدمة الأطول)",
 "senior vice president": "نائب رئيس أول (نائب الرئيس الأعلى رتبة في شركة لديها أكثر من نائب رئيس)",
 "senioritis": "إرهاق السنة الأخيرة (التعب من السنة الأخيرة في المدرسة الثانوية)",
 "seniority": "أقدمية, طول العمر (خاصية العيش طويلاً) / أقدمية (رتبة أعلى من الآخرين خاصة بسبب الخدمة الأطول)",
 "seniti": "سينيتي (100 سينيتي تساوي 1 بانغا في تونغا)",
 "senna": "سنا (أي من النباتات المختلفة من جنس السنا ذات أوراق مركبة ريشية وأزهار صفراء مبهرجة عادة؛ يستخدم العديد منها طبياً)",
 "senna alata": "شجيرة السعفة, كاسيا مجنحة (شجيرة استوائية (خاصة في الأمريكتين) لها زهور صفراء وأوراق كبيرة يستخدم عصيرها كعلاج للسعفة واللدغات السامة؛ تصنف أحياناً في جنس كاسيا)",
 "senna alexandrina": "سنا إسكندراني, سنا مكي (شجيرة قائمة لها عناقيد من الزهور الصفراء السمراء؛ تستخدم الأوراق المجففة طبياً كمسهل؛ تصنف أحياناً في جنس كاسيا)",
 "senna auriculata": "أفارام, كاسيا الدباغين (شجيرة هندية دائمة الخضرة بزهور صفراء زاهية يستخدم لحاؤها في الدباغة؛ تصنف أحياناً في جنس كاسيا)",
 "senna marilandica": "سنا بري, سنا ماريلاند (عشب معمر في أمريكا الشمالية؛ تستخدم الأوراق طبياً؛ يوضع أحياناً في جنس كاسيا)",
 "senna obtusifolia": "سنا منفرجة الأوراق, قرن المنجل (عشب استوائي عالمي أو شجيرة صغيرة بزهور صفراء وقرون منحنية رفيعة؛ عشب ضار؛ يصنف أحياناً في جنس كاسيا)",
 "senna occidentalis": "سنا القهوة, عشبة منتنة (شجيرة استوائية مورقة جداً كريهة الرائحة استخدمت بذورها كمغشوش للقهوة؛ تصنف أحياناً في جنس كاسيا)",
 "sennenhunde": "كلب الجبل السويسري (أي من أربع سلالات سويسرية)",
 "sennit": "حبل مسطح مضفر (حبال مضفرة مسطحة تستخدم في السفن)",
 "senor": "سينيور (لقب إسباني أو صيغة خطاب للرجل؛ يشبه 'سيد' في العربية)",
 "senora": "سينيورا (لقب إسباني أو صيغة خطاب للمرأة المتزوجة؛ يشبه 'سيدة' في العربية)",
 "senorita": "سينيوريتا (لقب إسباني أو صيغة خطاب تستخدم للفتاة أو المرأة غير المتزوجة؛ تشبه 'آنسة' في العربية)",
 "senpai": "زَمِيل أَقْدَم, سيمباي (شخص أكبر سناً أو أعلى مقاماً من المتحدث (في الثقافة اليابانية))",
 "sens": "بانجو, عشب (أسماء دارجة للماريجوانا)",
 "sensate": "حِسِّيّ, ذُو إِحْسَاس (يمتلك إحساسًا جسديًّا وإدراكًا حسّيًّا)",
 "sensation": "حَاسَّة, حِسّ",
 "sensational": "لَافِت, مُثِير لِلانْتِبَاه (يستحوذ على الانتباه ويأسره) / ضجة, مثير (يسبب اهتمامًا شديدًا أو فضولًا أو عاطفة قوية) / حسي (متعلق بـ أو معني بالإحساس)\nمثال: القشرة الحسية",
 "sensationalism": "تجريبية, حسية ((فلسفة) المذهب القائل بأن المعرفة تُستمد من التجربة) / حسية ((فلسفة) المذهب الأخلاقي القائل بأن الشعور هو المعيار الوحيد لما هو جيد) / إثارة, تهويل (الاستخدام الصحفي لموضوع يروق للأذواق المبتذلة) / إِثَارَة, صِحَافَة الْإِثَارَة (موضوع مصمم لإثارة وإرضاء الأذواق المبتذلة)",
 "sensationalist": "مروج للإثارة (شخص يستخدم مواد مبالغ فيها أو مثيرة من أجل كسب انتباه الجمهور)",
 "sensationalistic": "إِثَارِيّ, صَحَافَة صَفْرَاء (نموذجيّ للصحافة الشعبية المثيرة؛ يروّج للفضائح)",
 "sensationally": "بشكل مثير, بشكل مذهل (بطريقة مثيرة للمشاعر أو الاهتمام)\nمثال: في صيف عام 1958، عاد عازف البيانو عودة منتصرة بشكل مذهل",
 "sense": "حَاسَّة / إِحْسَاس, شُعُور / مَعْنَى, دَلَالَة / مَوْهِبَة, قُدْرَة طَبِيعِيَّة / حَسَّ (حسّه:أحرقه ، حسسْتُ الشّيء:أحسَسْتُه،حسَسْتُ اللحمَ:جعلته على الجمر،حسَسْتُ النّارَ:رددْتُها بالعصا على خُبْزِ المَلّةِ؛ حَسَّ فلاناً:قتله قتلاً ذريعاً مستأصلاً رأسه.(حسَسْتُ اليهوديََ لما أظهر عداوته لله ودينه))\nمثال: لديهم حس الفكاهة.",
 "sense datum": "إحساس (وعي أولي غير مفصل بالتحفيز)\nمثال: إحساس باللمس",
 "sense experience": "إحساس (وعي أولي غير مفصل بالتحفيز)\nمثال: إحساس باللمس",
 "sense impression": "إحساس (وعي أولي غير مفصل بالتحفيز)\nمثال: إحساس باللمس",
 "sense modality": "نمط حسي (حاسة معينة)",
 "sense of balance": "توازن, حاسة التوازن (نظام حسي يقع في هياكل الأذن الداخلية يسجل اتجاه الرأس)",
 "sense of direction": "إحساس بالاتجاه (وعي بتوجهك في المكان)",
 "sense of duty": "حياء, شعور بالمسؤولية (وعي دافع بالمسؤولية الأخلاقية)",
 "sense of equilibrium": "توازن, حاسة التوازن (نظام حسي يقع في هياكل الأذن الداخلية يسجل اتجاه الرأس)",
 "sense of hearing": "حاسة السمع, سمع (القدرة على السمع؛ الملكة السمعية)\nمثال: كان سمعه ضعيفًا",
 "sense of humor": "روح الدعابة, فكاهة (سمة تقدير (والقدرة على التعبير عن) الفكاهة)\nمثال: لم تقدر فكاهتي",
 "sense of humour": "روح الدعابة, فكاهة (سمة تقدير (والقدرة على التعبير عن) الفكاهة)\nمثال: لم تقدر فكاهتي",
 "sense of movement": "إحساس حركي, حاسة العضلات (القدرة على الشعور بحركات الأطراف والجسم)",
 "sense of purpose": "ذات هدف, هادفة (صفة امتلاك غرض محدد)",
 "sense of responsibility": "شعور بالمسؤولية (وعي بالتزاماتك)",
 "sense of right and wrong": "حس أخلاقي, ضمير (دافع نابع منطقياً من مبادئ أخلاقية تحكم أفكار الشخص وتصرفاته)",
 "sense of shame": "حياء, شعور بالمسؤولية (وعي دافع بالمسؤولية الأخلاقية)",
 "sense of smell": "حاسة الشم, شم (الملكة التي تمكننا من تمييز الروائح)",
 "sense of taste": "تذوق, حاسة التذوق (ملكة التمييز بين الخصائص الحلوة والحامضة والمرة والمالحة في الفم)\nمثال: حرمته نزلته البردية من حاسة التذوق",
 "sense of the meeting": "رأي الاجتماع (اتفاق عام تتوصل إليه مجموعة مجتمعة)\nمثال: لم يتم إجراء تصويت، ولكن بعد كل مناقشة قام الرئيس بتلخيص رأي الاجتماع",
 "sense of touch": "حاسة اللمس, لمس (الملكة التي تدرك بها الأشياء أو القوى الخارجية من خلال الاتصال بالجسم (وخاصة اليدين))\nمثال: فقط البصر واللمس يمكننا من تحديد مواقع الأشياء في الفضاء حولنا",
 "sense organ": "عضو حسي (عضو به نهايات عصبية (في الجلد أو الأحشاء أو العين أو الأذن أو الأنف أو الفم) تستجيب للتحفيز)",
 "sense tagger": "موسّم المعاني (برنامج توسيم تشير تسمياته إلى معاني الكلمات أو التعبيرات)",
 "sensed": "مَحْسُوس, مُسْتَشْعَر (أُدرِك بالحدس أو الاستنتاج لا بإشارات حسّيّة واضحة)",
 "sensei": "مُدَرِّب",
 "senseless": "فَاقِد الرَّشَاد, مَعْتُوه (يفتقر إلى الإدراك والحكمة والحسّ السليم) / فَاقِدُ الإِحْسَاسِ, مُغْمًى عَلَيْهِ (لَا يَسْتَجِيبُ لِلتَّنْبِيهِ أَوِ المُؤَثِّرَاتِ) / أَحْمَقُ, أَهْوَجُ (لا يتسم باستخدام العقل) / عَبَثِيّ, لَا طَائِلَ مِنْه (لَا يَخْدِمُ أَيَّ غَرَضٍ مُفِيد؛ لَا مُبَرِّرَ لِوُجُودِه)",
 "senselessly": "بحماقة, بلا تفكير (بطريقة حمقاء لا معنى لها) / بشكل عبثي, بلا معنى (بطريقة لا معنى لها ولا هدف)\nمثال: دُمرت هذه المعابد بلا تفكير من قبل الحرس الأحمر",
 "senselessness": "حماقة, سخف (الافتقار التام للمعنى أو الأفكار)",
 "sensibility": "تحسس, حساسية ((علم وظائف الأعضاء) الاستجابة للمحفزات الخارجية؛ ملكة الإحساس) / حساسية, قابلية للإحساس (الاستجابة العقلية والوعي) / رهافة حس, شعور مرهف (حساسية راقية للانطباعات الممتعة أو المؤلمة)\nمثال: حساسية للألم",
 "sensible": "حَسَّاس, فَطِن (مدرك بشكل حدسي أو فكري لشيء محسوس) / مَحْسُوس, مَلْمُوس (يُدْرَكُ بِالحَوَاسِّ بِسُهُولَة) / عاقل, معقول (يظهر العقل أو الحكم الصائب) / حسي, شاعر (قادر على الشعور أو الإدراك)\nمثال: خيار معقول",
 "sensible horizon": "أفق, أفق ظاهري (الخط الذي تبدو فيه السماء والأرض تلتقيان)",
 "sensibleness": "حَصَافَة, عَقْلَانِيَّة (صفة إظهار الحس السليم أو الحكم العملي)",
 "sensibly": "بتعقل, بحكمة (بحس سليم أو بطريقة معقولة)\nمثال: تصرف بتعقل في الأزمة",
 "sensing": "إحساس, إدراك (إدراك شيء ما عبر الحواس) / استشعار, رصد (الإدراك بأن شيئاً ما قد حدث أو أن حالة ما موجودة)\nمثال: الكشف المبكر يمكن أن يؤدي غالباً إلى الشفاء",
 "sensing element": "حساس, كاشف (أي جهاز يستقبل إشارة أو محفزاً (مثل الحرارة أو الضغط أو الضوء أو الحركة) ويستجيب له بطريقة مميزة)",
 "sensitisation": "تحسيس (جعل كائن حي حساسًا لمصل عن طريق سلسلة من الحقن) / تحسيس, توعية ((في علم النفس) عملية أن يصبح الشخص حساساً للغاية تجاه أحداث أو مواقف معينة (خاصة الأحداث أو المواقف العاطفية)) / تحسس (حالة الحساسية (كما في المستضدات))",
 "sensitised": "تَحَسُّسِيّ, مُفْرِط الحَسَاسِيَّة (لديه حساسية أو قابلية مفرطة أو خاصة (تجاه عامل معين))",
 "sensitiser": "مادة محسسة, محسس ((كيمياء) مادة غير المحفز تسهل بدء التفاعل التحفيزي)",
 "sensitising": "تحسيس (جعل كائن حي حساسًا لمصل عن طريق سلسلة من الحقن) / مُحسس (يجعل الشخص أو الشيء عرضة أو حساسًا للمحفزات الجسدية أو العاطفية)",
 "sensitive": "ذُو إِحْسَاس (أحد الأسماء الستة، لا يأتي إلا مُضَافًا، بمعنى صاحب) / حَسَّاس\nمثال: كان رجل ذو قامة طويله.",
 "sensitive fern": "أونوكليا, سرخس الخرز (سرخس منتشر جميل في شرق أمريكا الشمالية وشرق آسيا تم توطينه في أوروبا الغربية؛ يُظهر السعف المقسم ريشياً ميلاً طفيفاً للطي عند لمسه؛ تحيط الوريقات…)",
 "sensitive pea": "بازلاء الحجل, بازلاء حساسة (نبات أمريكي استوائي له وريقات حساسة نوعاً ما للمس؛ يصنف أحياناً في جنس كاسيا)",
 "sensitive plant": "ميموزا حساسة, نبات حساس (شجيرة دائمة الخضرة شائكة شبه متسلقة من أمريكا الاستوائية لها أوراق مركبة حساسة للضوء واللمس) / ست المستحية, ميموزا خجولة (شجيرة فرعية مفترشة أو شبه منتصبة من أمريكا الاستوائية وأستراليا؛ مسلحة بشدة بأشواك منحنية ولها وريقات خضراء رمادية ناعمة حساسة تطوى وتتدلى في الليل…)",
 "sensitively": "بحساسية, بمراعاة للشعور (بطريقة حساسة)\nمثال: سألت ضحية الاغتصاب بحساسية شديدة عن الهجوم",
 "sensitiveness": "تأثر, حساسية (القدرة على الاستجابة للتغيرات الوجدانية في البيئة الشخصية) / حساسية (القدرة على الاستجابة للمحفزات الفيزيائية أو تسجيل كميات فيزيائية صغيرة أو فروق) / تحسس, حساسية ((علم وظائف الأعضاء) الاستجابة للمحفزات الخارجية؛ ملكة الإحساس) / حساسية (الحساسية للمشاعر العاطفية (للذات وللآخرين))\nمثال: جلفانومتر ذو حساسية شديدة",
 "sensitivity": "تأثر, حساسية (القدرة على الاستجابة للتغيرات الوجدانية في البيئة الشخصية) / حساسية (القدرة على الاستجابة للمحفزات الفيزيائية أو تسجيل كميات فيزيائية صغيرة أو فروق) / تحسس, حساسية ((علم وظائف الأعضاء) الاستجابة للمحفزات الخارجية؛ ملكة الإحساس) / حساسية (الحساسية للمشاعر العاطفية (للذات وللآخرين))\nمثال: جلفانومتر ذو حساسية شديدة",
 "sensitization": "تحسيس (جعل كائن حي حساسًا لمصل عن طريق سلسلة من الحقن) / تحسيس, توعية ((في علم النفس) عملية أن يصبح الشخص حساساً للغاية تجاه أحداث أو مواقف معينة (خاصة الأحداث أو المواقف العاطفية)) / تحسس (حالة الحساسية (كما في المستضدات))",
 "sensitized": "تَحَسُّسِيّ, مُفْرِط الحَسَاسِيَّة (لديه حساسية أو قابلية مفرطة أو خاصة (تجاه عامل معين))",
 "sensitizer": "مادة محسسة, محسس ((كيمياء) مادة غير المحفز تسهل بدء التفاعل التحفيزي)",
 "sensitizing": "تحسيس (جعل كائن حي حساسًا لمصل عن طريق سلسلة من الحقن) / مُحسس (يجعل الشخص أو الشيء عرضة أو حساسًا للمحفزات الجسدية أو العاطفية)",
 "sensitometer": "مقياس الحساسية (أداة قياس لقياس حساسية الفيلم للضوء عبر مجموعة من التعريضات)",
 "sensor": "حَسَّاس, جِهَازُ اِسْتِشْعَار",
 "sensorial": "حسي (يتعلق بالحواس أو مشتق منها)\nمثال: تجربة حسية",
 "sensorimotor": "حسي حركي (متعلق بالتنسيق الحسي والحركي للكائن الحي أو بالأعصاب المتحكمة فيه)",
 "sensorimotor area": "منطقة حسية حركية (منطقة من القشرة تشمل التلفيف قبل المركزي والتلفيف بعد المركزي وتجمع بين الوظائف الحسية والحركية)",
 "sensorimotor region": "منطقة حسية حركية (منطقة من القشرة تشمل التلفيف قبل المركزي والتلفيف بعد المركزي وتجمع بين الوظائف الحسية والحركية)",
 "sensorineural": "حسي عصبي (متعلق بالعملية العصبية للإحساس)",
 "sensorineural hearing loss": "فقدان السمع الحسي العصبي (فقدان السمع بسبب فشل العصب السمعي)",
 "sensorium": "الجهاز الحسي, المجموع الحسي (مناطق الدماغ التي تعالج وتسجل المعلومات الحسية الواردة وتمكن من الوعي بالعالم)",
 "sensory": "حِسِّيّ, حِسِّيَّة ((حَسِيَ) الحسى حسى: احتقره ليخرج المَاء؛ (حَسِيَ) مَا فِي نَفسه: اختبره)",
 "sensory activity": "نشاط حسي (نشاط يهدف إلى تحقيق نتيجة حسية معينة)",
 "sensory aphasia": "حبسة استقبالية, حبسة حسية (حبسة تتميز بكلام طلق ولكنه لا معنى له وضعف شديد في القدرة على فهم الكلمات المنطوقة أو المكتوبة)",
 "sensory deprivation": "حرمان حسي (شكل من أشكال التعذيب النفسي يتم عن طريق حرمان الضحية من جميع المدخلات الحسية)",
 "sensory epilepsy": "صرع حسي (صرع بؤري يبدأ بظواهر حسية جسدية)",
 "sensory faculty": "إحساس, حاسة (الملكة التي يتم من خلالها إدراك العالم الخارجي)\nمثال: في الظلام اضطر للاعتماد على اللمس وحواسه الشمية والسمعية",
 "sensory fiber": "ليف حسي, ليف وارد (ليف عصبي يحمل النبضات نحو الجهاز العصبي المركزي)",
 "sensory hair": "شارب, شعرة حسية (شعرة صلبة طويلة تنمو من خطم أو حاجب معظم الثدييات مثل القطط)",
 "sensory nerve": "عصب حسي, عصب وارد (عصب ينقل النبضات من المستقبلات باتجاه أو إلى الجهاز العصبي المركزي)",
 "sensory neuron": "عصبون حسي (عصبون ينقل النبضات نحو الدماغ أو الحبل الشوكي)",
 "sensory receptor": "عضو حسي (عضو به نهايات عصبية (في الجلد أو الأحشاء أو العين أو الأذن أو الأنف أو الفم) تستجيب للتحفيز)",
 "sensory system": "الجهاز الحسي (نظام أعضاء الحس في الجسم) / نمط حسي (حاسة معينة)",
 "sensual": "شَهْوَانِيّ",
 "sensualism": "حسية ((فلسفة) المذهب الأخلاقي القائل بأن الشعور هو المعيار الوحيد لما هو جيد) / حسية, شهوانية (الرغبة في الملذات الحسية)",
 "sensualist": "شهواني (شخص يستمتع بالشهوات)",
 "sensuality": "شَهْوَانِيَّة",
 "sensually": "بإثارة, بشكل مثير (بطريقة مثيرة وحسية)\nمثال: تحركت الراقصة بإثارة بين الطاولات",
 "sensualness": "حسية, شهوانية (الرغبة في الملذات الحسية)",
