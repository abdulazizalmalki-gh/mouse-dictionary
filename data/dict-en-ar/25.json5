 "single dwelling": "مسكن مستقل, منزل منفصل (منزل يقف بمفرده)",
 "single entry": "قيد مفرد (نظام مسك دفاتر بسيط؛ يتم إدخال المعاملات في حساب واحد فقط)",
 "single file": "رتل, طابور فردي (خط من الأشخاص أو الأشياء مرتبة واحداً خلف الآخر)",
 "single mother": "أُم عَزْبَاء (الوَالِدَة أو الجَدَّة، وقد يطلق على والدة الزوج مجازا؛ أمّ بالرضاعة: المرأة التي أرضعت الطِفْل صغيرا فتصبح كوالدته)\nمثال: هل ستأتي أم لا؟",
 "single nucleotide polymorphism": "تعدد أشكال النوكليوتيدات المفردة ((في علم الوراثة) تباين وراثي في تسلسل الحمض النووي يحدث عندما يتغير نيوكليوتيد واحد في الجينوم؛ وتعتبر عادة طفرات نقطية كانت ناجحة تطورياً بما يكفي…)",
 "single prop": "طائرة بمروحة واحدة (طائرة مروحية بمروحة واحدة)",
 "single quote": "علامة اقتباس مفردة (علامة اقتباس فردية)",
 "single room": "غُرْفَة لِشَخْص وَاحِد (اسم مفعول لما غُرِفَ من الماء وغيره باليد، الجمع غِرَاف؛ اسم؛ المكان في الدار أو المبنى محاط بأربع جدران وسقف، حُجْرَة، عِلِّيَّة. الجمع وغُرَف وغُرُفَات)\nمثال: الأب في الغرفة.",
 "single shell": "قارب تجديف فردي (قارب قشري لمجدف واحد)",
 "single stitch": "غرزة حشو, غرزة كروشيه مفردة (غرزة الكروشيه الأساسية)",
 "single supplement": "إضافة الفردي (رسم إضافي يضاف إلى التكلفة للشخص الواحد عند السفر بمفرده)",
 "single tax": "ضريبة موحدة (نظام ضريبي تفرض فيه ضريبة على سلعة واحدة (عادة الأرض))",
 "single-barreled": "أحادي الماسورة (له ماسورة واحدة)\nمثال: معظم البنادق أحادية الماسورة",
 "single-barrelled": "أحادي الماسورة (له ماسورة واحدة)\nمثال: معظم البنادق أحادية الماسورة",
 "single-bedded": "ذُو سَرِير مُفْرَد (يحتوي على أسرة مفردة)",
 "single-breasted": "أحادي الصدر ((عن الملابس) يغلق بتداخل ضيق ويُثبت بصف واحد من الأزرار)\nمثال: سترة أحادية الصدر",
 "single-breasted jacket": "سترة أحادية الصدر (سترة تتداخل مقدمتها فقط بما يكفي لصف واحد من الأزرار)",
 "single-breasted suit": "بدلة أحادية الصدر (بدلة ذات سترة أحادية الصدر)",
 "single-celled": "أُحَادِيّ الخَلِيَّة (ذو خليّة واحدة (وبالتالي غير منقسم إلى خلايا))",
 "single-channel": "أُحَادِيّ الصَّوْت, مُونُو (يشير إلى نقل الصوت أو تسجيله عبر قناة واحدة)",
 "single-entry bookkeeping": "قيد مفرد (نظام مسك دفاتر بسيط؛ يتم إدخال المعاملات في حساب واحد فقط)",
 "single-foot": "خبب سريع (مشية سريعة للحصان تضرب فيها كل قدم الأرض بشكل منفصل)",
 "single-furrow plough": "محراث أحادي الأخدود (محراث له عجلة واحدة فقط في المقدمة ومقابض في الخلف ليتمكن الحراث من توجيهه والمناورة به)",
 "single-furrow plow": "محراث أحادي الأخدود (محراث له عجلة واحدة فقط في المقدمة ومقابض في الخلف ليتمكن الحراث من توجيهه والمناورة به)",
 "single-handed": "بجهد فردي, بمفرده (دون مساعدة) / بِلَا مُسَاعَدَة, مُنْفَرِد (بِدُونِ مُسَاعَدَةٍ مِنَ الآخَرِين) / بِلَا مُسَانَدَة, مُنْفَرِد (غير مدعوم من أشخاص آخرين)\nمثال: بنيت هذا المنزل بمفردي",
 "single-handedly": "بجهد فردي, بمفرده (دون مساعدة)\nمثال: بنيت هذا المنزل بمفردي",
 "single-humped": "وحيد السنام (يمتلك سناماً واحداً)\nمثال: جمل وحيد السنام",
 "single-lane": "ذو مسار واحد ((للطرق) لها حارة واحدة لحركة المرور في كلا الاتجاهين؛ عندما تتقابل المركبات يجب أن تخرج إحداها عن الطريق لتمر الأخرى)",
 "single-leaf": "بينيون أحادي الورقة (بينيون من جنوب غرب الولايات المتحدة له إبر منفردة وغالباً سيقان عديدة؛ مهم كصنوبر جوز)",
 "single-leaf pine": "بينيون أحادي الورقة (بينيون من جنوب غرب الولايات المتحدة له إبر منفردة وغالباً سيقان عديدة؛ مهم كصنوبر جوز)",
 "single-leaf pinyon": "بينيون أحادي الورقة (بينيون من جنوب غرب الولايات المتحدة له إبر منفردة وغالباً سيقان عديدة؛ مهم كصنوبر جوز)",
 "single-member system": "نظام الدوائر الفردية, نظام العضو الواحد (قائم على مبدأ اختيار عضو واحد فقط (كما في المجلس التشريعي) من كل دائرة انتخابية)",
 "single-minded": "أُحَادِيُّ الْهَدَفِ, مُصَمِّمٌ (مُصَمِّم ومُنصَبّ على هدف واحد)",
 "single-mindedly": "بتركيز وحيد الهدف, بتصميم (بطريقة تركز على هدف واحد)",
 "single-mindedness": "إخلاص النية, وحدة الهدف (يتميز بهدف موحد واحد)",
 "single-propeller plane": "طائرة بمروحة واحدة (طائرة مروحية بمروحة واحدة)",
 "single-reed instrument": "آلة ذات ريشة مفردة (آلة موسيقية ذات ريشة واحدة (مثل الكلارينيت أو الساكسفون))",
 "single-reed woodwind": "آلة ذات ريشة مفردة (آلة موسيقية ذات ريشة واحدة (مثل الكلارينيت أو الساكسفون))",
 "single-rotor helicopter": "مروحية أحادية الدوار (مروحية لها دوار واحد)",
 "single-seeded": "أُحَادِيُّ البَذْرَة (يحتوي على بذرة واحدة فقط)",
 "single-shelled": "أُحَادِيُّ الصَّدَفَة (ذُو صَدَفَةٍ وَاحِدَة)",
 "single-spaced": "أُحَادِيّ التَّبَاعُد ((في الطباعة) لا يحتوي على مسافة فارغة بين السطور)",
 "single-spacing": "مسافة مفردة (طباعة لا تترك أسطراً فارغة)",
 "single-stranded": "أحادي الخيط, أحادي الشريط (يمتلك خيطاً واحداً)\nمثال: حمض نووي ريبوزي أحادي الشريط",
 "single-valued function": "تَابِع رِيَاضِيّ, دَالَّة ((الرياضيات) علاقة رياضية بحيث يرتبط كل عنصر من مجموعة معينة (مجال الدالة) بعنصر من مجموعة أخرى (مدى الدالة))",
 "singleness": "تركيز, تفرغ (جودة التركيز على هدف مركزي واحد) / استقامة, تفرد (بدون نفاق)\nمثال: تفرغه لهدفه",
 "singles": "فردي (التنس التي تُلعب بشخص واحد في كل جانب) / فردي (تنس الريشة التي تُلعب بشخص واحد في كل جانب)",
 "singlestick": "عصا المبارزة (عصا تستخدم بدلاً من السيف للمبارزة)",
 "singlet": "القميص",
 "singletary pea": "بازلاء سنجلتاري, جلبان مشعر (نبات حولي شتوي ضعيف الساق موطنه منطقة البحر الأبيض المتوسط واستقر منذ فترة طويلة في جنوب الولايات المتحدة؛ يزرع كمحصول تغطية ومرعى)",
 "singleton": "ورقة مفردة (ورقة اللعب التي تكون الوحيدة من نوعها (النقش) في يد البريدج كما وزعت في البداية) / مجموعة أحادية (مجموعة تحتوي على عضو واحد فقط) / مَجْمُوعَة أُحَادِيَّة, مُفْرَد (كائن واحد (كمتميز عن الزوج))",
 "singly": "بشكل فردي, واحداً تلو الآخر (واحداً تلو الآخر؛ واحداً في كل مرة) / بشكل فردي, على حدة (بمعزل عن الآخرين)\nمثال: تم ترتيبها بشكل فردي",
 "singsong": "غناء جماعي (غناء جماعي غير رسمي للأغاني الشعبية) / تَرْتِيلِيّ, رَتِيب (يُنطَق بإيقاع رتيب كالترتيل أو الإنشاد) / إنشاد رتيب (تنغيم منتظم ورتيب يرتفع وينخفض)",
 "singular": "مُفْرَد ((في النحو) يصف شيئًا أو شخصًا واحدًا فقط؛ كَلِمَة) / مُفْرَد, صِيغَة اَلْمُفْرَد ((في النحو) يصف شيئًا أو شخصًا واحدًا فقط؛ كَلِمَة)",
 "singular form": "صيغة المفرد, مفرد (صيغة الكلمة المستخدمة للدلالة على شيء واحد)",
 "singular matrix": "مصفوفة منفردة (مصفوفة مربعة يساوي محددها صفراً)",
 "singular proposition": "قضية شخصية, قضية مفردة (قضية موضوعها مصطلح مفرد، أو مصطلح عام مقصور على فرد بواسطة علامة مفردة)",
 "singularity": "تميز, فرادة (صفة كون الشيء فريداً من نوعه) / تَفَرُّد, غَرَابَة (الغرابة بحكم كون الشيء لافتاً أو غير عادي)\nمثال: ميزه ذلك التفرد عن جميع رفاقه",
 "singularly": "بشكل فريد, بصورة استثنائية (بطريقة فريدة أو بدرجة استثنائية)\nمثال: اُعتبر اللورد ت. ماجناً بشكل فريد حتى بالنسبة لبلاط روسيا والبرتغال",
 "singultus": "حازوقة, فواق (حالة حدوث تشنجات انعكاسية في الحجاب الحاجز مصحوبة بإغلاق سريع للمزمار مما ينتج صوتًا مسموعًا؛ أحيانًا تكون عرضًا لعسر الهضم)\nمثال: كيف تعالج الفواق؟",
 "sinhala": "سنهالي (من أو متعلق باللغات السنهالية) / السنهالية (اللغة الهندية التي يتحدث بها شعب سريلانكا)\nمثال: النسخ السنهالية من رامايانا",
 "sinhala language": "السنهالية (اللغة الهندية التي يتحدث بها شعب سريلانكا)",
 "sinhalese": "سِنْهَالِيّ, لُغَة سِنْهَالِيَّة",
 "sinhalese language": "السنهالية (اللغة الهندية التي يتحدث بها شعب سريلانكا)",
 "sinister": "شَرِير (الكَثير الشَرّ بمعنى اسم جامع للرذائل، قد يستعمل كاسم فاعل؛ ضد الخَيِّر؛ يستخدم أيضا بمعنى ذو الشَرّ وما تسبب بالشرّ)\nمثال: لقد وصف سامي ليلى كشخص شرير إلى حد يكاد لا يصدق.",
 "sinistral": "أيسر, يساري (من أو على اليسار) / أَعْسَر (يُفضِّل استخدام القدم أو اليد أو العين اليسرى)\nمثال: صدفة بطنيات الأقدام اليسارية التي تكون قمتها للأعلى تكون فتحتها على اليسار عند مواجهة المراقب",
 "sinistrality": "أعسرية, عسر (تفضيل استخدام اليد اليسرى)",
 "sinistrorsal": "مُلْتَفّ يَسَارًا (يَلْتَفّ صُعُودًا مِنَ اليَمِين إِلَى اليَسَار)",
 "sinistrorse": "مُلْتَفّ يَسَارًا (يَلْتَفّ صُعُودًا مِنَ اليَمِين إِلَى اليَسَار)",
 "sinitic": "صيني (من أو يتعلق بالشعب الصيني أو لغتهم أو ثقافتهم) / اللغات الصينية (مجموعة من اللغات الصينية التبتية)\nمثال: لهجات صينية",
