 "slate-black": "أَسْوَد أَرْدُوَازِيّ (أسود مع مسحة رمادية أردوازية)",
 "slate-colored junco": "جنكو (طائر جنكو شائع في أمريكا الشمالية ذو ريش رمادي وعيون ذات قزحية بنية داكنة)",
 "slate-gray": "رَمَادِيّ أَرْدُوَازِيّ (بلون الأردواز أو الجرانيت)",
 "slate-grey": "رَمَادِيّ أَرْدُوَازِيّ (بلون الأردواز أو الجرانيت)",
 "slater": "قمل الخشب (أي من متماثلات الأرجل الأرضية الصغيرة المتنوعة ذات جسم مسطح بيضاوي مقسم؛ توجد في البيئات الرطبة)",
 "slatey": "رَمَادِيّ أَرْدُوَازِيّ (بلون الأردواز أو الجرانيت)",
 "slatiness": "صفائحية, طبيعة صخر الأردواز (حالة أو صفة كونه من معدن الأردواز (الشيست) أو يشبهه)\nمثال: عند صعود التل من الغرب أجد أن صفائحية التكوين لا تظهر كثيراً إلا في التجوية",
 "slating": "تسقيف بالأردواز (عملية وضع الأردواز للأسقف) / نَقْد لَاذِع, هُجُوم نَقْدِيّ (هجوم نقدي شديد) / أردواز (طبقات رقيقة من الصخور تستخدم للتسقيف)\nمثال: أعطى النقاد كتابه نقداً لاذعاً",
 "slattern": "امرأة قذرة (امرأة قذرة وغير مرتبة) / عاهرة شوارع (عاهرة تجذب الزبائن بالمشي في الشوارع)",
 "slatternliness": "إهمال, قذارة (بأسلوب المرأة المهملة القذرة)",
 "slatternly": "رَثَّة, مُهْمَلَةُ المَظْهَر (تَتَّسِمُ بِالإِهْمَالِ فِي المَظْهَرِ؛ تُسْتَخْدَمُ خَاصَّةً لِلنِّسَاء)",
 "slaty": "رَمَادِيّ أَرْدُوَازِيّ (بلون الأردواز أو الجرانيت)",
 "slaty-gray": "رَمَادِيّ أَرْدُوَازِيّ (بلون الأردواز أو الجرانيت)",
 "slaty-grey": "رَمَادِيّ أَرْدُوَازِيّ (بلون الأردواز أو الجرانيت)",
 "slaughter": "ذَبْح (قتل بآلة حادة كالسيف أو السكين بقطع الوريد أو الشريان في الرقبة؛ عن القتل بدون مقاومة المقتول) / ذَبَحَ (قتل بآلة حادة كالسيف أو السكين بقطع الوريد أو الشريان في الرقبة؛ عن القتل بدون مقاومة المقتول)\nمثال: وعندما يتم ذبح الأبرياء في دارفور والبوسنة يسبب ذلك وصمة في ضميرنا المشترك.",
 "slaughterer": "جَزَّار, قَصَّاب",
 "slaughterhouse": "مذبح, مسلخ (مبنى يتم فيه ذبح الحيوانات)",
 "slaughterous": "دَامٍ, مُرَوِّع (مصحوب بسفك دماء)",
 "slav": "صَقْلَبِيّ, سَلَافِيّ",
 "slave": "عَبْد (خلاف الحُرّ، المَمْلُوْك، من له مالك يملكه. الجمع عبيد وأعبد وعِبدان وعُبدان؛ الإنسان حرا كان أم لا مؤمنا كان أن ملحدا من حيث أنه مملوك لله) / أَمَة (المرأة المملوكة، خلاف الحرة)\nمثال: ماذا أنجز عبد العزيز بوتفليقة؟",
