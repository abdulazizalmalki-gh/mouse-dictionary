 "hat": "قُبَّعَة, بُرْنَيْطَة (خرقة تخاطُ كالبُرْنس يلبسها الصِّبيان؛ غطاء للرأس يكون مُخّيَّط على عكس العَمَامَة التي لا يكون فيها خِيَاطَة. قُلُنْسُوَة)\nمثال: لقد اشترى قبعة.",
 "hat shop": "متجر قبعات نسائية (متجر يبيع القبعات النسائية)",
 "hat trick": "هاتريك",
 "hatband": "شريط القبعة (شريط حول تاج القبعة فوق الحافة مباشرة)",
 "hatbox": "صندوق القبعات (قطعة مستديرة من الأمتعة لحمل القبعات)",
 "hatch": "حَضَنَ (مَا دُونُ الإِبْط إِلى الكَشح؛ الصَّدْرُ والعَضُدان وَمَا بَيْنَهُمَا)\nمثال: كان زيري يعيش في حضن الرفاهية.",
 "hatchback": "باب خلفي, هاتشباك (باب سيارة خلفي مائل يُرفع لفتحه) / سيارة هاتشباك (سيارة لها باب خلفي يفتح لأعلى)",
 "hatchback door": "باب خلفي, هاتشباك (باب سيارة خلفي مائل يُرفع لفتحه)",
 "hatcheck girl": "مسؤولة المعاطف (موظفة استلام المعاطف والقبعات)",
 "hatched": "مُظَلَّل بِالتَّهْشِير (مُظَلَّل بِوَاسِطَة خُطُوط مُتَوَازِيَة أَوْ مُتَقَاطِعَة دَقِيقَة) / فَاقِس, مَفْقُوس (خَرَجَ مِنَ البَيْضَة)",
 "hatchel": "مشط الكتان, مِندَف (مشط لفصل ألياف الكتان)",
 "hatchery": "مفقس (مكان يفقس فيه البيض تحت ظروف اصطناعية (خاصة بيض السمك))\nمثال: تدير سلطات الحديقة مفقساً لسمك السلمون المرقط",
 "hatchet": "بلطة, فأس صغيرة (فأس صغيرة بمقبض قصير تستخدم بيد واحدة (عادة لقطع الحطب)) / توماهوك, فأس صغيرة (سلاح يتكون من فأس قتال؛ استخدمه هنود أمريكا الشمالية)",
 "hatchet job": "اغْتِيَال مَعْنَوِيّ, افْتِرَاء (اتهام كاذب بارتكاب جريمة أو تحريف خبيث لكلمات أو أفعال شخص ما)",
 "hatchet man": "قاتل مأجور (قاتل محترف ذكر) / منفذ المهام القذرة (رجل وظيفته تنفيذ المهام غير السارة لرئيسه)",
 "hatchet woman": "منفذة المهام القذرة (امرأة وظيفتها تنفيذ المهام غير السارة لرئيسها)",
 "hatching": "تهشير (تظليل يتكون من خطوط متقاطعة متعددة) / فقس (إنتاج الصغار من البيضة)",
 "hatchling": "فرخ حديث الفقس, فقس (أي حيوان فقس حديثاً (خاصة الطيور))",
 "hatchway": "فتحة, كوة (مدخل مجهز بغطاء؛ خاصة الممرات بين طوابق السفينة)",
 "hate": "كَرِهَ, أَبْغَضَ (لم يُحِبّ، لم يَسْتطِع تحمُّلَ شَخْص أو أمرٍ، لم يُطِقْه، مقَته وكان عنده نُفورٌ منه؛ كره الشّخص فعل السّوء)\nمثال: هتلر كره اليهود.",
 "hate crime": "جَرِيمَة كَرَاهِيَّة",
 "hate mail": "رسائل كراهية (بريد يعبر عن كره الكاتب أو بغضه (عادة بلغة مسيئة))",
 "hated": "مُبْغَض, مَكْرُوه",
 "hateful": "بغيض, كريه (يثير أو يستحق الكراهية) / حَقُود, خَبِيث (يتسم بالحقد والخبث)\nمثال: لا توجد رذيلة بغيضة عالمياً مثل الجحود",
 "hatefully": "ببغض, بكراهية (بطريقة مليئة بالكراهية)",
 "hatefulness": "بَغَاضَة, كَرَاهِيَة (صفة كون الشيء بغيضاً أو كريهاً)",
