 "hanuman": "لانغور رمادي, هانو مان (لانغور يعيش في جنوب آسيا؛ يعتبر مقدساً في الهند)",
 "hanyu pinyin": "بينيين, هانيبو بينيين (النظام الصوتي الرسمي لنسخ نطق لغة الماندرين للأحرف الصينية إلى الأبجدية اللاتينية)",
 "hao": "هاو (10 هاو تساوي 1 دونغ في فيتنام)",
 "haoma": "سوما, هاوما (كرمة عديمة الأوراق من جزر الهند الشرقية؛ كانت عصارتها اللبنية الحامضة تستخدم سابقاً لصنع مشروب مسكر)",
 "hap": "اتفاق, حدث (حدث عرضي)\nمثال: سجل كل أحداث حياته السارة والسيئة",
 "hapax legomenon": "لَفْظ فَرِيد, كَلِمَة وَحِيدَة (نَطَقَ، تَكَلَّمَ؛ أَخْرَجَ، رَمَى)\nمثال: هذه الكلمة صعبة اللفظ.",
 "haphazard": "غَيْر مُتْقَن, مُرْتَجَل (يَتَّسِم بِالإِهْمَال الشَّدِيد وعَدَم الدِّقَّة) / جزافاً, خبط عشواء (بدون عناية؛ بطريقة مرتجلة وسريعة) / اِعْتِبَاطِيّ, عَشْوَائِيّ (يعتمد على الصدفة أو يتّسم بها)\nمثال: كان رئيس الوزراء يرتدي بدلة رمادية وقميصاً أبيض بياقة ناعمة، لكن رقبته أصبحت أنحف والياقة تبتعد عنها كما لو تم شراؤها عشوائياً",
 "haphazardly": "بشكل عشوائي, دون تمييز (بطريقة عشوائية) / جزافاً, خبط عشواء (بدون عناية؛ بطريقة مرتجلة وسريعة)\nمثال: كانت المنازل مبعثرة عشوائياً",
 "haphazardness": "اعْتِبَاطِيَّة, عَشْوَائِيَّة (صفة الافتقار إلى أي نظام أو خطة يمكن التنبؤ بها)",
 "hapless": "قَلِيل الحَظّ (ما كان عدده صغيرا؛ متبوعًا بمِنْ: عدد صغير أو كمية صغيرة من الشيء)\nمثال: و بعد قليل أتى.",
 "haploid": "أحادي الصيغة الصبغية (لخلية أو كائن حي يحتوي على مجموعة واحدة من الكروموسومات) / أحادي الصيغة الصبغية ((في علم الوراثة) كائن أو خلية تحتوي على مجموعة كاملة واحدة فقط من الكروموسومات)",
 "haploidic": "أحادي الصيغة الصبغية (لخلية أو كائن حي يحتوي على مجموعة واحدة من الكروموسومات)",
 "haploidy": "أحادية الصيغة الصبغية (حالة كون الكائن أحادي الصيغة الصبغية)",
 "haplopappus acaulis": "عشب ذهبي عديم الساق (عشب قائم أخضر داكن في شمال غرب الولايات المتحدة وجنوب غرب كندا له أوراق صلبة في خصلات كثيفة ورؤوس زهرية صفراء؛ يوضع أحياناً في جنس هابلوبابوس)",
 "haplopappus phyllocephalus": "أقحوان الكافور (نبات حولي من جنوب الولايات المتحدة والمكسيك ذو أوراق خشنة وأزهار صفراء شاحبة)",
 "haplopappus spinulosus": "أقحوان شائك أصفر (نبات معمر نحيل من غرب أمريكا الشمالية ذو أوراق خشنة ضعيفة ورؤوس زهور صفراء)",
 "haplosporidian": "هابلوسبوريديان (طفيل في اللافقاريات والفقاريات الدنيا ليس له أهمية اقتصادية معروفة)",
 "haplotype": "نمط فردي ((علم الوراثة) مجموعة من الأليلات (لجينات مختلفة) تقع بالقرب من بعضها البعض على نفس الكروموسوم وتميل إلى التوارث معاً)",
 "haply": "ربما, صدفةً (عن طريق الصدفة)\nمثال: خانه لفظ سُمع صدفةً",
 "happen": "حَدَثَ, جَرَى (وَقَعَ الأمر؛ نقيض قَدُمَ، كان حَدِيثا)\nمثال: لا أصدق ما حدث.",
 "happening": "حَدَث طَبِيعِيّ, حُدُوث (حدث يقع بشكل طبيعيّ)",
 "happenstance": "تزامن, مصادفة (حدث قد يبدو مدبراً رغم أنه عرضي في الحقيقة)",
 "happily": "بِسَعَادَة",
 "happily ever after": "وَعَاشُوا عِيشَة سَعِيدَة",
 "happiness": "سَعَادَة, فَرَح",
 "happy": "سَعِيد / فَرِح (سُرُور؛ اسم يطلق على الإناث) / مَحْظُوظ\nمثال: فرح فاضل كثيرا.",
 "happy birthday": "كُلُّ عَامٍ وَأَنْتُمْ بِخَيْرٍ, عِيد مِيلَاد سَعِيد",
 "happy chance": "ضربة حظ, فرصة سعيدة (قطعة غير متوقعة من الحظ السعيد)\nمثال: حصل أخيراً على فرصته الكبيرة",
 "happy easter": "عِيدُ فِصْح سَعِيد, الْمَسِيح قَامَ",
 "happy event": "حدث سعيد (الولادة الحية لطفل)",
 "happy hour": "سَاعَة سَعِيدَة (ثُلْث ثُمْن اليَوْم بمعنى مجموع النَهَار واللَيْل، أي جزء من أربعة وعشرين جزءا من مجموع النهار والليل وتتكون من ستين دَقِيقَة؛ الوَقْت الحاضر، الآن)\nمثال: درست لمدة ساعة.",
 "happy new year": "كُلُّ عَامٍ وَأَنْتُمْ بِخَيْرٍ, سَنَة جَدِيدَة سَعِيدَة",
 "happy ramadan": "رَمَضَان مُبَارَك, رَمَضَان كَرِيم",
 "happy-go-lucky": "طَائِش, لَا مُبَالٍ (غير مسؤول بمرح وخِفّة)",
 "hapsburg": "هابسبورغ (عائلة ألمانية ملكية قدمت حكاماً لعدة دول أوروبية وحملت تاج الإمبراطورية الرومانية المقدسة من 1440 إلى 1806)",
 "haptic": "لمسي (متعلق بحاسة اللمس أو نابع منها)\nمثال: بيانات لمسية",
 "haptic sensation": "إحساس جلدي, حس لمسي (إحساس موضعي على الجلد)",
 "haptically": "باللمس (عن طريق اللمس)\nمثال: يدرك الأشكال باللمس",
 "haptoglobin": "هابتوجلوبين (بروتين في البلازما يرتبط بالهيموجلوبين الحر ويزيله (كما هو الحال من الجروح))",
 "hara-kiri": "هَارَا كِيرِي",
 "harajuku": "هَارَاجُوكُو",
 "harakat": "حَرَكَات, حَرَكَة",
 "harakiri": "سيبوكو, هاراكيري (انتحار شعائري بقر البطن بالسيف؛ كان يمارسه الساموراي في المجتمع الياباني التقليدي)",
 "haram": "حَرَام (ثوب يُتَّقى به البرد؛ غِطاء من صوفٍ أو غيره يُلْتَحَف به وقت النوم، كما تستخدم غطاء للرأس والجسم)\nمثال: رمضان شهر حرام.",
 "harangue": "خطبة عصماء, صياح (خطبة رنانة عالية الصوت تعبر عن مشاعر قوية)",
 "haranguer": "خطيب مهيج (متحدث عام يلقي خطابًا صاخبًا أو قويًا أو غاضبًا)",
 "harar": "هَرَر",
 "harare": "هَرَارِي / هاراري",
 "harassed": "مُتَضَايِق, مُنْزَعِج (يعاني من إزعاج مستمر خاصة بمضايقات تافهة)",
 "harasser": "متحرش, مضايق (مهاجم مستمر) / متحرش, مزعج (شخص يمارس المضايقة أو التعذيب النفسي بشكل مستمر)\nمثال: لم يكن المتحرشون أعضاء في الجيش النظامي",
 "harassing fire": "نيران إزعاج (نيران مصممة لإزعاج راحة قوات العدو وتقليص الحركة وخفض معنويات العدو)",
 "harassment": "تَحَرُّش",
 "haratin": "حَرَاطِين",
 "harbin": "هَارْبِين, خَارْبِين",
 "harbinger": "بشير, سلف (شيء يسبق ويشير إلى اقتراب شيء أو شخص ما)",
 "harbor": "مَرْفَأ, مَرْسَى",
 "harbor patrol": "خفر الميناء, دورية الميناء (دورية من الضباط الذين يراقبون منطقة الميناء)",
 "harbor porpoise": "خنزير البحر المينائي (خنزير البحر الشائع في شمال المحيط الأطلسي والمحيط الهادئ)",
 "harbor seal": "فقمة الميناء, فقمة شائعة (فقمة مرقطة صغيرة تعيش في المياه الساحلية لنصف الكرة الشمالي)",
 "harborage": "مرفأ, ملاذ ((مصطلح بحري) مكان للجوء (كما للسفينة))",
 "harbour": "مرفأ, ملاذ (مكان للملجأ والراحة والأمان) / مرفأ, ميناء بحري (ميناء محمي حيث يمكن للسفن شحن أو تفريغ البضائع)",
 "harbourage": "مرفأ, ملاذ ((مصطلح بحري) مكان للجوء (كما للسفينة))",
 "hard": "صُلْب (قوي وصلب الملمس، لا ينحني بسهولة؛ متماسك وثابت، غير قابل للتغيير أو الانكسار) / صَعْب / لَا يُدْحَضُ (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: هذا التخت جدا صلب.",
 "hard beech": "زان صلب (شجرة نيوزيلندية طويلة تنتج خشباً صلباً جداً)",
 "hard bop": "هارد بوب (نوع من الموسيقى يشبه البلوز ويرتبط بالبيبوب المستقيم، ولكنه أكثر ترابية ومنهجية في مقاربته)",
 "hard candy": "مُلَبَّسَة",
 "hard cash": "سيولة نقدية, كاش (المال في شكل أوراق نقدية أو عملات معدنية)\nمثال: هناك نقص حاد في السيولة النقدية",
 "hard cheese": "جُبْن يَابِس (جَبَنَ يَجْبُن وجَبُنَ جُبْنًا وجُبُنًا وجَبانةً)\nمثال: قل جبنة يا زيري.",
 "hard cider": "سيدر كحولي, نبيذ التفاح (مشروب كحولي من السيدر المخمر)",
 "hard clam": "كواهوج (محار أمريكي صالح للأكل؛ استخدمت أصدافه الثقيلة كنقود من قبل بعض الهنود الأمريكيين)",
 "hard coal": "أنتراسيت, فحم حجري صلب (فحم طبيعي صلب يحترق ببطء ويعطي حرارة شديدة)",
 "hard copy": "نسخة مطبوعة, نسخة ورقية ((في علم الحاسوب) مادة محفوظة في كمبيوتر ومكتوبة أو مطبوعة على ورق)\nمثال: طبع نسخة ورقية من التقرير",
 "hard core": "النواة الصلبة (النواة الأكثر تفانياً وولاءً لمجموعة أو حركة)",
 "hard currency": "سيولة نقدية, كاش (المال في شكل أوراق نقدية أو عملات معدنية) / عملة صعبة (عملة من غير المرجح أن تنخفض قيمتها فجأة)\nمثال: هناك نقص حاد في السيولة النقدية",
 "hard disc": "قرص صلب (قرص مغناطيسي صلب مثبت بشكل دائم في وحدة محرك أقراص)",
 "hard disk": "قُرْص صُلْب",
 "hard drink": "خمر مقطر, مشروب روحي (مشروب كحولي يتم تقطيره بدلاً من تخميره)",
 "hard drive": "قُرْص صُلْب",
 "hard drug": "مخدر ثقيل, مخدر قوي (مخدر يعتبر قوياً نسبياً ومن المرجح أن يسبب الإدمان)",
 "hard fern": "بليكنوم, سرخس صلب (أي من السراخس العديدة من جنس بليكنوم)",
 "hard hat": "خوذة أمان, خوذة صلبة (خوذة واقية خفيفة الوزن (بلاستيكية أو معدنية) يرتديها عمال البناء) / عامل بناء (عامل ماهر في بناء المكاتب أو المساكن وغيرها)",
 "hard knocks": "شدة, ضراء (حالة من سوء الحظ أو البلاء)\nمثال: مزارعون مثقلون بالديون يكافحون الشدائد",
 "hard labor": "أَعْمَالٌ شَاقَّة (في يطلق على أي عمل حرّ يحتاج إلى رأس مال مثل الصناعة والتجارة وقطاع المال وما أشبه)\nمثال: أنا في رحلة أعمال.",
 "hard lead": "رصاص صلب (رصاص غير مكرر صلب بسبب الشوائب التي يحتوي عليها) / رصاص أنتيموني, رصاص صلب (سبيكة رصاص تحتوي على حوالي 5٪ من الأنتيمون)",
 "hard line": "سياسة صارمة, موقف متشدد (موقف حازم لا يقبل المساومة)\nمثال: اتخذ الحاكم موقفاً متشدداً تجاه المخدرات",
 "hard liquor": "خمر مقطر, مشروب روحي (مشروب كحولي يتم تقطيره بدلاً من تخميره)",
 "hard news": "أخبار جادة (أخبار تتناول موضوعات أو أحداثاً خطيرة)",
 "hard palate": "حَنَك صَلْب ((حَنَكَت) الْأُم الصَّبِي حنكا: دلكت حنكه؛ (حَنَكَ) فُلَان الدَّابَّة: جعل الرسن فِي فمها)",
 "hard put": "فِي ضَائِقَة, مُتَعَسِّر مَالِيًّا (يواجه صعوبات مالية أو ضائقة)",
 "hard right": "اليمين المتشدد (الجناح اليميني المتطرف)",
 "hard rock": "هَارْد رُوك",
 "hard roe": "بطارخ (بيض السمك أو المبيض الممتلئ بالبيض؛ له قوام حبيبي)",
 "hard roll": "لفافة صلبة, لفافة فيينا (لفافة مخمرة بالخميرة ذات قشرة صلبة)",
 "hard rubber": "إيبونيت, مطاط صلب (مطاط صلب غير مرن يتكون من فلكنة المطاط الطبيعي)",
 "hard rush": "أسل صلب, سمار صلب (أسل طويل من المناطق المعتدلة)",
 "hard sauce": "صلصة الزبدة الصلبة (زبدة وسكر ممزوجان مع البراندي أو نكهة أخرى وتقدم مع البودنغ الغني)",
 "hard sell": "بيع قسري, ترويج قوي (إعلان قوي ومُلح)",
 "hard shoulder": "كتف صلب, ممر الطوارئ (شريط معبد بجانب الطريق السريع (للوقوف في حالات الطوارئ))",
 "hard sign": "علامة التفخيم, ير خلفي (الحرف السيريلي Ъ/ъ، والذي يعمل في اللغات الحديثة للدلالة على صامت صلب (غير مرقق))",
 "hard solder": "لحام صلد (سبيكة لحام تحتوي على النحاس؛ تنصهر عند درجة حرارة عالية نسبياً؛ تستخدم في اللحام بالنحاس)",
 "hard steel": "فولاذ صلد (فولاذ يحتوي على أكثر من 0.3% كربون)",
 "hard subtitle": "ترجمة مدمجة ((غالباً بصيغة الجمع) ترجمة مرئية تم دمج نصها بشكل لا رجعة فيه في إطارات الفيديو الأصلية)",
 "hard tick": "قراد صلب (قراد له درع صلب على الظهر وأجزاء فم تبرز من الرأس)",
 "hard time": "مشقة, وقت عصيب (صعوبة يمكن التغلب عليها بالجهد) / سجن مشدد (مدة تُقضى في سجن شديد الحراسة)\nمثال: واجهنا وقتاً عصيباً للوصول إلى هنا",
 "hard times": "أوقات عصيبة (وقت تسوده الصعوبات)",
 "hard up": "مَضِيق, مُعْسِر (لا يملك ما يكفي من المال لسدّ الحاجات الأساسية)",
 "hard water": "ماء عسر (ماء يحتوي على أملاح معدنية (كأيونات الكالسيوم والمغنيسيوم) تحد من تكون الرغوة مع الصابون)",
 "hard wheat": "قمح المعكرونة, قمح ديورم (قمح ذو حبات صلبة داكنة اللون غنية بالغلوتين ويستخدم للخبز والمعكرونة؛ يزرع خاصة في جنوب روسيا وشمال أفريقيا وشمال وسط أمريكا الشمالية)",
 "hard worker": "عامل كادح (شخص يعمل بجد مثل العبد)",
 "hard-and-fast": "حَازِم, صَارِم ((عن القواعد) مُطَبَّقٌ بِصَرَامَة)",
 "hard-baked": "مَخْبُوزٌ حَتَّى التَّصَلُّب (خُبِزَ حَتَّى أَصْبَحَ صَلْبًا)",
 "hard-bitten": "عَنِيد, مُتَجَلِّد (قاسٍ وغليظ بفعل الخبرة والتجربة)",
 "hard-boiled": "مَسْلُوقٌ تَمَامًا ((عَنِ البَيْض) مَسْلُوقٌ حَتَّى تَمَاسُكِ الصَّفَار) / عَديم الإحْساس, مُتَقَسٍّ (أصبَح قاسِيًا بِفِعْل التَّجْرِبَة؛ لا تُؤَثِّر فيه المَشاعِر) / عَنِيد, مُتَجَلِّد (قاسٍ وغليظ بفعل الخبرة والتجربة)",
 "hard-boiled egg": "بيض مسلوق جيداً (بيضة مغلية برفق حتى يتصلب البياض والصفار)",
 "hard-cooked egg": "بيض مسلوق جيداً (بيضة مغلية برفق حتى يتصلب البياض والصفار)",
 "hard-core": "إِبَاحِيّ صَرِيح (صريح إلى أقصى درجة في المحتوى الجنسي) / مُتَشَدِّد فِي الوَلَاء, مُوَالٍ بِشِدَّة (شَدِيد الوَلَاء والإِخْلَاص) / رَاسِخٌ فِي مَوْقِفِه, مُتَشَدِّد (يُقَاوِمُ التَّغْيِيرَ أَوِ التَّحَسُّنَ بِعِنَادٍ)",
 "hard-fought": "عَنِيف المُنَافَسَة (يَتَطَلَّب جُهْدًا كَبِيرًا)",
 "hard-hitting": "ضَاغِط, عَنِيف الإِقْنَاع (مُقنِع بإلحاح وعدوانية) / حَاسِم, قَوِيُّ التَّأْثِير (يتميّز بالقوّة والحزم الشديدين)",
 "hard-line": "حَازِم, مُتَشَدِّد (صَارِمٌ وَلَا يَقْبَلُ التَّسْوِيَةَ)",
 "hard-nosed": "بَرَاغْمَاتِيّ, عَمَلِيّ (يسترشد بالخبرة العملية والملاحظة لا بالنظرية)",
 "hard-of-hearing": "ثَقِيلُ السَّمْعِ, ضَعِيفُ السَّمْعِ (لديه فقدان جزئي في السمع)",
 "hard-on": "انتصاب (قضيب منتصب)",
 "hard-pressed": "فِي ضَائِقَة, مُتَعَسِّر مَالِيًّا (يواجه صعوبات مالية أو ضائقة)",
 "hard-shell clam": "كواهوج (محار أمريكي صالح للأكل؛ استخدمت أصدافه الثقيلة كنقود من قبل بعض الهنود الأمريكيين) / بطلينوس صلب (بطلينوس دائري ذو قشرة صلبة من الساحل الأطلسي؛ بطلينوس كبير يستخدم عادة للحساء أو أطباق البطلينوس الأخرى)",
 "hard-shell crab": "سرطان صلب الصدفة (سرطان صالح للأكل لم ينسلخ حديثاً وبالتالي له صدفة صلبة)",
 "hard-shelled": "صُلْبُ القِشْرَةِ (لِلْحَيَوَانَاتِ أَوِ النَّبَاتَاتِ الَّتِي لَهَا صَدَفَةٌ أَوْ قِشْرَةٌ صُلْبَةٌ)",
 "hard-skinned puffball": "كرة الأرض, كمأة كاذبة (أي من الفطريات المختلفة من جنس سكليروديرما لها أجسام ثمرية تحت أرضية صلبة الجلد تشبه الكمأة)",
 "hardback": "ذُو غِلَاف صَلْب, مُقَوَّى الغِلَاف (ذو غلاف أو ظهر صلب وقاسٍ) / غلاف مقوى, كتاب مجلد (كتاب بأغلفة من الورق المقوى أو القماش أو الجلد)",
 "hardbacked": "ذُو غِلَاف صَلْب, مُقَوَّى الغِلَاف (ذو غلاف أو ظهر صلب وقاسٍ)",
 "hardbake": "هاردبيك (حلوى بريطانية مصنوعة من الدبس والزبدة واللوز)",
 "hardball": "هاردبول (البيسبول كتمييز عن السوفتبول) / أسلوب صارم, تعامل حازم (موقف لا هوادة فيه وجاد في الأعمال التجارية أو السياسة)\nمثال: إنهم يلعبون بأسلوب صارم في مجلس الشيوخ",
 "hardboard": "خشب حبيبي, لوح مضغوط (مادة صلبة رخيصة مصنوعة من رقائق الخشب المضغوطة معاً والمربوطة بالراتنج الصناعي)",
 "hardbound": "ذُو غِلَاف صَلْب, مُقَوَّى الغِلَاف (ذو غلاف أو ظهر صلب وقاسٍ)",
 "hardcore": "إِبَاحِيّ صَرِيح (صريح إلى أقصى درجة في المحتوى الجنسي) / مُتَشَدِّد فِي الوَلَاء, مُوَالٍ بِشِدَّة (شَدِيد الوَلَاء والإِخْلَاص)",
 "hardcover": "ذُو غِلَاف صَلْب, مُقَوَّى الغِلَاف (ذو غلاف أو ظهر صلب وقاسٍ) / غلاف مقوى, كتاب مجلد (كتاب بأغلفة من الورق المقوى أو القماش أو الجلد)",
 "hardenbergia comptoniana": "بازلاء مرجانية غرب أستراليا, هاردنبيرجيا (متسلق قوي في غابات غرب أستراليا؛ يزرع لعناقيده الكثيفة من الزهور الأرجوانية الوردية الزاهية الجذابة)",
 "hardened": "جامِد, مُتَصَلِّب (أصبَح صُلْبًا بَعْد أن كان لَيِّنًا) / عَديم الإحْساس, مُتَقَسٍّ (أصبَح قاسِيًا بِفِعْل التَّجْرِبَة؛ لا تُؤَثِّر فيه المَشاعِر) / محصن (محمي ضد الهجوم (خاصة بالأسلحة النووية)) / مُصلّد, مُعالَج (ما جُعل صلباً أو مرناً أو مقاوماً خاصةً عن طريق المعالجة الحرارية)\nمثال: صوامع صواريخ محصنة",
 "hardener": "مصلب, مقسي (مادة تزيد الصلابة، خاصة مادة تضاف إلى الورنيش أو الطلاء لمنحه سطحاً أو طبقة أكثر صلابة)",
 "hardening": "تصلب, تقسية (عملية جعل الشيء أكثر صلابة (أكثر متانة أو إحكاماً أو تماسكاً)) / تصلب, تصلد (عملية التحول إلى صلب أو قاسي عن طريق التبريد أو التجفيف أو التبلور) / تحجر, تصلب (تصلب أو تغلظ غير طبيعي للأنسجة)\nمثال: تصلب الخرسانة",
 "hardening of the arteries": "تصلب الشرايين (تصلب جدران الشرايين)",
 "hardfisted": "قَابِض اليَد, مُمْسِك (غير راغب في التخلي عن المال)",
 "hardheaded": "بَرَاغْمَاتِيّ, عَمَلِيّ (يسترشد بالخبرة العملية والملاحظة لا بالنظرية) / صَلْب الرَّأْس, عَنِيد كَالبَغْل (صارم بشكل غير معقول في مواجهة الحجة أو التوسل)",
 "hardheadedness": "عناد, يباسة رأس (خاصية العناد أو التعنت)\nمثال: أصبح عناده في رفض قبول شهادات حتى علماء النفس مثل مونستربرغ حول طبيعة الشهادة أمراً كلاسيكياً",
 "hardheads": "قنطريون أسود (نبات معمر عشبي بسيقان سلكية قوية وزهور أرجوانية؛ موطنه أوروبا ولكنه متوطن على نطاق واسع)",
 "hardhearted": "قَاسِي الْقَلْب, غَلِيظ الْقَلْب",
 "hardheartedness": "غلظة, قسوة القلب (غياب الاهتمام برفاهية الآخرين)",
 "hardihood": "إقدام, جرأة (سمة الاستعداد للقيام بأمور تنطوي على مخاطرة أو خطر)\nمثال: تطلب الاقتراح جرأة كبيرة",
 "hardiness": "إقدام, جرأة (سمة الاستعداد للقيام بأمور تنطوي على مخاطرة أو خطر) / عافية, متانة (خاصية كون الشخص قوياً وصحياً في البنية)\nمثال: تطلب الاقتراح جرأة كبيرة",
 "harding grass": "عشب هاردينغ (عشب معمر من أستراليا وجنوب أفريقيا؛ أدخل إلى أمريكا الشمالية كعشب علف)",
 "hardinggrass": "عشب هاردينغ (عشب معمر من أستراليا وجنوب أفريقيا؛ أدخل إلى أمريكا الشمالية كعشب علف)",
 "hardline": "حَازِم, مُتَشَدِّد (صَارِمٌ وَلَا يَقْبَلُ التَّسْوِيَةَ)",
 "hardliner": "متشدد (محافظ لا يقبل المساومة)",
 "hardly": "بالكاد, قبل قليل (قبل وقت قصير جداً فقط) / بالكاد, قلّما (تقريباً لا؛ بصعوبة بالغة) / بالكاد, بصعوبة (ببطء وبصعوبة)\nمثال: بالكاد كنا نعرفهم",
 "hardness": "شدة, صرامة (صرامة مفرطة) / صعوبة, وعورة (صفة الصعوبة في القيام بالشيء) / تَبَلُّد شُعُورِيّ, غِلْظَة (الخلو من العاطفة أو الشعور؛ قسوة القلب) / عسارة, عسر الماء (صفة للمياه التي تحتوي على أملاح معدنية مذابة تمنع الصابون من تكوين رغوة)\nمثال: صرامة الشخصية",
 "hardpan": "قشرة كلسية, كاليش (قشرة أو طبقة من التربة التحتية الصلبة المغطاة بكربونات الكالسيوم توجد في المناطق القاحلة أو شبه القاحلة)",
 "hardscrabble": "بَائِس, شَاقّ (بالكاد يفي بالحدّ الأدنى من المعايير)",
 "hardship": "مَشَقَّة, شِدَّة",
 "hardstem bulrush": "أسل, بوط صلب الساق (سعد واسع الانتشار في أمريكا الشمالية له سيقان خضراء زيتونية صلبة)",
 "hardstemmed bulrush": "أسل, بوط صلب الساق (سعد واسع الانتشار في أمريكا الشمالية له سيقان خضراء زيتونية صلبة)",
 "hardstyle": "هاردستايل, هارد ستايل",
 "hardsub": "ترجمة مدمجة ((غالباً بصيغة الجمع) ترجمة مرئية تم دمج نصها بشكل لا رجعة فيه في إطارات الفيديو الأصلية)",
 "hardtack": "بقسماط السفينة, خبز البحارة (بسكويت أو خبز صلب جداً غير مملح؛ كان غذاءً أساسياً في السفن قديماً) / ماهوجني الجبل (نوع من الماهوجني الجبلي)",
 "hardtop": "سيارة ذات سقف صلب (سيارة تشبه السيارة المكشوفة ولكن لها سقف صلب ثابت)",
 "hardware": "مَتاع الحاسب, المَتاع",
 "hardware error": "خطأ في الأجهزة, عطل مادي (خطأ ناتج عن خلل في أحد المكونات المادية للحاسوب)",
 "hardware store": "متجر خردوات, محل مواد بناء وأدوات (متجر لبيع الأدوات والمعدات المعدنية)",
 "hardware woman": "بائعة خردوات (امرأة تبيع الخردوات)",
 "hardwareman": "بائع خردوات (رجل يبيع الخردوات والأدوات المعدنية)",
 "hardwood": "خشب صلب (خشب الأشجار عريضة الأوراق ثنائية الفلقة (بالمقارنة مع خشب الصنوبريات))",
 "hardworking": "مُجْتَهِد (مشتق من إجتهد)\nمثال: لعل المجتهد ينجح.",
 "hardy": "بَاسِل, جَسُور (لا يهاب الخوف أو الترهيب) / صُلْب, قَوِيُّ البُنْيَة (ذو قوة بدنية متينة؛ متمرّس على التعب والمشقّة) / مُتَحَمِّلٌ لِلظُّرُوف (قادر على البقاء في ظروف مناخية غير ملائمة)",
 "hare": "قُوَاع, أَرْنَب بَرِّيَّة",
 "hare and hounds": "مطاردة الورق (لعبة خارجية؛ تنطلق مجموعة من اللاعبين (الأرانب) في ركض طويل مبعثرين قصاصات من الورق (الرائحة) ويحاول المطاردون (الكلاب) الإمساك بهم قبل وصولهم إلى…)",
 "hare krishna": "الجمعية الدولية لوعي كريشنا, هاري كريشنا (طائفة دينية تأسست في الولايات المتحدة عام 1966؛ تستند إلى الكتب الفيدية؛ تنخرط المجموعات في ترديد بهيج لـ \"هاري كريشنا\" ومانترا أخرى تستند إلى اسم…) / هاري كريشنا (عابد لكريشنا وعضو في الجمعية الدولية لوعي كريشنا)",
 "hare wallaby": "ولب أرنبي (ولب أسترالي صغير يشبه الأرنب وله أسنان دائمة)",
 "hare's-foot bristle fern": "سرخس قدم الأرنب الشائك (نوع من السرخس الشائك)",
 "hare's-foot fern": "سرخس قدم الأرنب (أي من سرخسين من جنس دافاليا لهما جذمور مشعر رمادي ناعم)",
 "harebell": "جريس, جريس مستدير الأوراق (نبات معمر من نصف الكرة الشمالي ذو سيقان نحيلة وأزهار زرقاء على شكل جرس) / جريس, ياسنت الخشب (يصنف أحياناً في جنس سيلا)",
 "harebrained": "أَرْعَن, مَجْنُون (بالغ الحماقة والطيش)",
 "haredi": "حريديم (أي من عدة طوائف من اليهودية الأرثوذكسية ترفض الثقافة العلمانية الحديثة ولا يعترف الكثير منهم بالسلطة الروحية لدولة إسرائيل الحديثة)",
 "hareem": "حرملك (أماكن معيشة مخصصة للزوجات والمحظيات والقريبات في منزل مسلم)",
 "harelip": "شفة أرنبية, شفة مشقوقة (شق خلقي في منتصف الشفة العليا)",
 "harem": "حَرِيم, حَرَمْلِك / حَرِيم",
 "hargeisa": "هرجيسا",
 "haricot": "فاصولياء فلاجوليه (نوع من الفاصولياء الفرنسية ذات بذور فاتحة اللون؛ عادة ما تكون مجففة) / فاصولياء بيضاء, هاريكوت (صنف فرنسي من نبات الفاصولياء الخضراء يحمل فاصولياء فاتحة اللون)",
 "haricot vert": "فاصولياء خضراء رفيعة, فاصولياء فرنسية (فاصولياء خضراء صغيرة جداً ونحيلة)",
 "haricots verts": "فاصولياء خضراء رفيعة, فاصولياء فرنسية (فاصولياء خضراء صغيرة جداً ونحيلة)",
 "harijan": "مَنْبُوذ, هارِيجان (شخص ينتمي إلى أدنى طبقة اجتماعية ودينية في الهند)",
 "harikari": "سيبوكو, هاراكيري (انتحار شعائري بقر البطن بالسيف؛ كان يمارسه الساموراي في المجتمع الياباني التقليدي)",
 "haripur": "هَرِيفُور",
 "harissa": "هَرِيسَة (مؤنث هَرِيْس؛ حَلْوى تصنع من القَمْح المدقوق (سَمِيْد) المخلوط باللَبَن والسُكَّر ومَشْوي. تسمى في مِصْر بالبَسْبُوْسَة)\nمثال: لا أستطيع إضافة الهريسة لأكلي.",
 "harlem": "هارلم, هارليم",
 "harlequin": "مهرج, هارليكوين (مهرج أو بهلوان (نسبة إلى شخصية هارليكوين في الكوميديا الإيطالية القديمة))",
 "harlequin opal": "أوبال أرليكوين (أوبال محمر مع بقع صغيرة من الألوان الرائعة)",
 "harlequin-snake": "ثعبان مرجاني (أي من عدة ثعابين سامة من العالم الجديد مخططة ببراعة بالأحمر والأسود وإما الأصفر أو الأبيض؛ واسعة الانتشار في أمريكا الجنوبية والوسطى)",
 "harlequinade": "تهريج (التصرف مثل المهرج أو البهلوان)",
 "harlot": "بائعة هوى, عاهرة (امرأة تمارس الجماع الجنسي مقابل المال)",
 "harlotry": "بغاء, دعارة (عرض الجماع الجنسي مقابل أجر)",
 "harm": "ضَرَرٌ / ضَرَّ أَضَرَّ",
 "harmal": "حَرْمَل",
 "harmattan": "رياح الخماسين (هرمتان), هرمتان (رياح متربة من الصحراء الكبرى تهب نحو الساحل الغربي لأفريقيا خلال الشتاء)",
 "harmful": "ضَارّ, مُضِرّ",
 "harmfully": "بِأَذًى, بِشَكْل ضَارّ (بطريقة ضارة)",
 "harmfulness": "أَذِيَّة, ضَرَر (صفة كون الشيء ضاراً) / إِيذَاء, ضَرَر (التدميرية التي تسبب ضرراً أو أذى)",
 "harmless": "غير ضار, مسالم (لا يسبب أو غير قادر على التسبب في ضرر)\nمثال: بكتيريا غير ضارة",
 "harmlessly": "بِبَرَاءَة, دُونَ ضَرَر (بطريقة غير ضارة)\nمثال: هذه لعبة طفولية غير ضارة",
 "harmonic": "مُتَوافِق, مُنْسَجِم (مُتَناغِم ومُتَّسِق في التَّوْليفَة الصَّوْتِيَّة) / تَوافُقِيّ, رَنّانِيّ (يَتَعَلَّق بِالتَّوافُقِيّات أو الرَّنين المُتَعاطِف) / توافقي, هارموني (مكون من أو متعلق بالتوافق (الهارموني) كتميز عن اللحن والإيقاع) / توافقي (مكون من أو متعلق بفرع الصوتيات الذي يدرس تركيب الأصوات الموسيقية)\nمثال: دقة التغيير التوافقي والنغمية",
 "harmonic analysis": "تحليل توافقي, تحليل فورييه (تحليل دالة دورية إلى مجموع مكونات جيبية بسيطة)",
 "harmonic law": "القانون التوافقي, قانون كبلر الثالث (قانون ينص على أن نسبة مربع الفترة المدارية (بالسنوات) إلى مكعب المحور المداري (بالوحدات الفلكية) هي نفسها لجميع الكواكب)",
 "harmonic mean": "وسط توافقي",
 "harmonic motion": "حركة توافقية (حركة دورية تكون فيها الإزاحة إما متناظرة حول نقطة أو مجموع حركات من هذا القبيل)",
 "harmonic progression": "متتالية توافقية ((رياضيات) متتالية من الحدود تشكل مقلوباتُها متتالية حسابية)",
 "harmonica": "هارمونيكا",
 "harmonical": "مُتَوافِق, مُنْسَجِم (مُتَناغِم ومُتَّسِق في التَّوْليفَة الصَّوْتِيَّة)",
 "harmonically": "تناغمياً, هارمونياً (فيما يتعلق بالتناغم (الهارموني))\nمثال: قطعة مثيرة للاهتمام تناغمياً",
 "harmonics": "علم التوافقيات (دراسة الصوت الموسيقي)",
