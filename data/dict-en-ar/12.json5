 "graphics driver": "تعريف كرت الشاشة, مشغل رسوميات (سلسلة من التعليمات التي تنشط جهاز الرسومات، مثل شاشة العرض أو الراسمة)",
 "graphite": "غَرَافِيت",
 "graphologist": "أخصائي علم الخط, خبير خطوط (متخصص في استنتاج الشخصية من خط اليد)",
 "graphology": "جرافولوجي, علم الخط (دراسة خط اليد (خاصة كمؤشر على شخصية الكاتب أو مزاجه))",
 "graphospasm": "تشنج الكاتب (تشنجات عضلية في الإبهام والسبابة أثناء الكتابة بقلم)",
 "grapnel": "خطاف, مرساة خطافية (مرساة خفيفة للقوارب الصغيرة) / خُطَّاف إرساء, مرساة خطافية (أداة تتكون من عدة خطافات للإمساك والتشبث؛ غالباً ما تُرمى بحبل)",
 "grapnel anchor": "خطاف, مرساة خطافية (مرساة خفيفة للقوارب الصغيرة)",
 "grappa": "جرابا (براندي إيطالي مصنوع من بقايا العنب بعد العصر)",
 "grapple": "عراك, مصارعة (فعل الانخراط في قتال يدوي وثيق) / غارفة محارية (دلو جرف بمفاصل تشبه صدفة المحار) / خُطَّاف إرساء, مرساة خطافية (أداة تتكون من عدة خطافات للإمساك والتشبث؛ غالباً ما تُرمى بحبل)\nمثال: كان بينهما مصارعة عنيفة",
 "grappler": "خُطَّاف إرساء, مرساة خطافية (أداة تتكون من عدة خطافات للإمساك والتشبث؛ غالباً ما تُرمى بحبل) / مصارع (مقاتل يحاول طرح الخصم أرضاً)",
 "grappling": "مصارعة (رياضة الصراع اليدوي بين متنافسين غير مسلحين يحاول كل منهما طرح الآخر أرضاً) / عراك, مصارعة (فعل الانخراط في قتال يدوي وثيق)\nمثال: كان بينهما مصارعة عنيفة",
 "grappling hook": "خُطَّاف إرساء, مرساة خطافية (أداة تتكون من عدة خطافات للإمساك والتشبث؛ غالباً ما تُرمى بحبل)",
 "grappling iron": "خُطَّاف إرساء, مرساة خطافية (أداة تتكون من عدة خطافات للإمساك والتشبث؛ غالباً ما تُرمى بحبل)",
 "graptophyllum pictum": "جرابتوفيلوم, نبات الكاريكاتير (شجيرة استوائية من العالم القديم لها زهور أنبوبية أرجوانية أو حمراء وعلامات أوراق تشبه ملامح وجه الإنسان)",
 "grapy": "عِنَبِيّ (ذُو طَعْمٍ يُشْبِهُ العِنَب)",
 "grasp": "قَبْضَة",
 "graspability": "قابلية الاستيعاب, قابلية الفهم (صفة كونه قابلاً للفهم أو الاستيعاب)\nمثال: يرتبط التفاوت في قابلية فهم المخاطر باحتمال عدم المساواة في الوصول إلى المعلومات حولها",
 "graspable": "مَفْهُوم, وَاضِح (يمكن إدراكه وفهمه واستيعابه)",
 "grasping": "جَشِع, حَرِيص (شديد الرغبة بشكل مفرط في اكتساب الثروة وغيرها) / إمساك, قبض (فعل الإمساك بشيء بإحكام باليدين) / محاولة الفهم (الفهم بصعوبة)\nمثال: كانت المحاضرة تتجاوز أقصى محاولاته للفهم",
 "grass": "حَشِيش, عُشْب / حَشِيش",
 "grass bacillus": "عصوية رقيقة (نوع من العصويات يوجد في التربة والمواد العضوية المتحللة؛ تنتج بعض سلالاتها مضادات حيوية)",
 "grass fern": "سرخس الشريط, سرخس العشب (سرخس هوائي يوجد في غابات الأراضي المنخفضة في أمريكا الاستوائية)",
 "grass finch": "عصفور المساء (عصفور شائع في أمريكا الشمالية يشتهر بغنائه المسائي) / عصفور العشب (طيور نساجة أسترالية عادة ما تكون زاهية الألوان؛ تُربى غالباً كطيور زينة)",
 "grass frog": "ضفدع العشب (ضفدع أوروبي شبه أرضي شائع)",
 "grass over": "زرع العشب, عشّب (غطّى بالعشب)\nمثال: قرر الملاك زراعة العشب في ممتلكاتهم",
 "grass parakeet": "بادجي, ببغاء الدرة (ببغاء أسترالي صغير عادة ما يكون لونه أخضر فاتح مع علامات سوداء وصفراء في البرية ولكن يتم تربيته بألوان عديدة)",
 "grass pea": "بيقية هندية, جلبان (نبات حولي أوروبي يزرع للعلف؛ تستخدم بذوره كغذاء في الهند وعلف للماشية في أماكن أخرى)",
 "grass pink": "قرنفل الكوخ, قرنفل ريشي (قرنفل أوروبي يزرع لزهوره الوردية أو الوردية العطرة جداً) / قرنفل العشب, كالوبوجون (نوع من الأوركيد)",
 "grass poly": "ليثروم زوفي الأوراق (نبات حولي ذو زهور وردية صغيرة منفردة؛ أصله من أوروبا ولكنه متوطن على نطاق واسع في المناطق الرطبة)",
 "grass roots": "عامة الناس, قواعد شعبية (عامة الناس على المستوى المحلي (بتمييزهم عن مراكز النشاط السياسي)) / أَسَاس, جُذُور (الأساس أو المصدر الجوهري)\nمثال: تمت معالجة المشكلة من جذورها",
 "grass skirt": "تنورة عشبية (تنورة مصنوعة من شفرات العشب الطويلة)",
 "grass snake": "ثعبان أخضر (أي من ثعبانين من أمريكا الشمالية آكلين للحشرات بشكل رئيسي ولونهما أخضر) / ثعبان الرباط (أي من ثعابين عديدة غير سامة مخططة طولياً ولودية من أمريكا الشمالية والوسطى) / ثعبان العشب, ثعبان مطوق (ثعبان أوروبي غير ضار ذو طوق أصفر ساطع؛ شائع في إنجلترا)",
 "grass tree": "خلنج شجري, شجرة العشب (شجرة شجيرية تسمانية دائمة الخضرة نحيلة بأوراق مدببة رفيعة طولها 3 إلى 5 أقدام) / شجرة العشب, شجرة العشب الأسترالية (أي من النباتات المعمرة الأسترالية دائمة الخضرة ذات سيقان خشبية سميكة قصيرة متوجة بخصلة من أوراق تشبه العشب وتنتج راتنجات أكاريد) / شجرة العشب, شجرة الملفوف (شجرة أنيقة لها إما جذع واحد أو جذع متفرع كل منها بخصل طرفية من أوراق ضيقة طويلة وعناقيد كبيرة من الزهور العطرة البيضاء أو الصفراء أو الحمراء؛…)",
 "grass vetch": "بيقية عشبية, جلبان عشبي (نبات بيقية حولي أوروبي ذو زهور حمراء)",
 "grass vetchling": "بيقية عشبية, جلبان عشبي (نبات بيقية حولي أوروبي ذو زهور حمراء)",
 "grass widow": "مطلقة (امرأة مطلقة أو منفصلة عن زوجها)",
 "grass widower": "رجل منفصل, مطلق (رجل مطلق (أو منفصل) عن زوجته)",
 "grass wrack": "حشيشة البحر, زوستيرا (نبات بحري مغمور بأوراق ضيقة طويلة جداً يوجد بكثرة على طول سواحل شمال الأطلسي)",
 "grass-covered": "مُغَطَّى بِالعُشْب (مكسو ومغطى بالعشب)",
 "grass-leaved golden aster": "نجمة ذهبية عشبية الأوراق",
 "grass-of-parnassus": "بارناسيا, عشب بارناسوس (أي من نباتات المستنقعات دائمة الخضرة عادة من جنس بارناسيا لها أوراق قاعدية ناعمة عريضة وزهرة شاحبة واحدة تشبه الحوذان)",
 "grassfinch": "عصفور العشب (طيور نساجة أسترالية عادة ما تكون زاهية الألوان؛ تُربى غالباً كطيور زينة)",
 "grassfire": "حريق الحشائش, حريق المروج (حريق غير منضبط في منطقة عشبية)",
 "grasshopper": "جُنْدُب, جَرَادَة",
 "grasshopper mouse": "فأر الجندب (فأر آكل للحشرات من غرب أمريكا الشمالية)",
 "grassland": "مَرْعَى",
 "grassless": "أَجْرَد, خَالٍ مِن العُشْب (يفتقر إلى العشب)",
 "grasslike": "شَبِيه بِالعُشْب (يشبه العشب في مظهره)",
 "grassroots": "شَعْبِيّ قَاعِدِيّ (يتعلق بعامة الناس بوصفهم جماعة سياسية واقتصادية أساسية) / شَعْبِيّ, قَاعِدِيّ (أساسيّ نابع من القاعدة الشعبية)",
 "grassy": "عُشْبِيّ (غني بالعشب)",
 "grassy death camas": "كاماسيا الموت العشبية (نبات من غرب أمريكا الشمالية إلى المكسيك؛ سام خاصة للحيوانات الراعية)",
 "grassy-leafed": "عُشْبِيّ الأَوْرَاق (ذو أوراق تشبه العشب)",
 "grassy-leaved": "عُشْبِيّ الأَوْرَاق (ذو أوراق تشبه العشب)",
 "grate": "بَشَر (بَشَرَ؛ بُشِرَ)\nمثال: لكنهم كلهم بشر.",
 "grated cheese": "جبن مبشور (جبن صلب أو شبه صلب مبشور)",
 "grateful": "مُمْتَنّ, شَاكِر",
 "gratefully": "بامتنان, بشكر (بطريقة ممتنة؛ مع الشكر) / بِامْتِنَان, بِتَقْدِير (مع التقدير؛ بطريقة ممتنة)\nمثال: قبل اعتذاري بامتنان",
 "gratefulness": "شكر, عرفان بالجميل (مشاعر الامتنان الودية الدافئة)",
 "grater": "مِبْشَرَة",
 "graticule": "غْرَاتِيكُول",
 "gratification": "إرضاء, إشباع (الفعل أو حالة الإرضاء) / إشباع, ارتياح (حالة من الشعور بالرضا أو الإشباع)\nمثال: العمل المتكرر الممل لا يمنح أي إشباع",
 "gratified": "رَاضٍ, قَرِير العَيْن (قد نال ما كان يرغب فيه)",
 "gratifying": "مُرْضٍ, مُمْتِع (يمنح الرضا أو المتعة) / حُلْو, مُرْضٍ (ممتع للعقل أو الشعور)",
 "gratifyingly": "بشكل مرض (بطريقة تبعث على الرضا)\nمثال: كان الأداء بمستوى عال بشكل مرض",
 "grating": "خَشِن الصَّوْت, مُحْتَكّ (قَاسٍ أَوْ مُزْعِج فِي الصَّوْت بِشَكْلٍ غَيْر مُسْتَحَبّ) / محزز حيود (جهاز بصري يتكون من سطح به العديد من الأخاديد المتوازية؛ يشتت شعاع الضوء (أو الإشعاع الكهرومغناطيسي الآخر) إلى أطواله الموجية لإنتاج طيفه) / شبكة الموقد (إطار من قضبان حديدية لاحتواء النار) / شبكة (حاجز به قضبان متوازية أو متقاطعة تسد ممراً ولكنها تسمح بدخول الهواء)",
 "gratingly": "بخشونة, بصرير (بطريقة قاسية ومزعجة للأذن)\nمثال: وقع صوتها بصرير على آذاننا",
 "gratis": "مَجَّانًا (بدون تكلفة)\nمثال: سأعطيك هذا مجاناً",
 "gratitude": "شُكْر, اِمْتِنَان ((شَكِرَت) الشَّجرة تَشْكَرُ شَكَرًا: خرج منها الشَّكِيرُ؛ (شَكِرَت) الضَّرْعُ: امتلأ باللبن)\nمثال: شكر ياني أسرته.",
 "gratuitous": "بِلَا مُبَرِّر, مَجَّانِيّ (بدون سبب أو مبرر) / لَا مُبَرِّر لَه, مَجَّانِيّ (غير ضروري وغير مبرر) / بِلَا ثَمَن, مَجَّانِيّ (لَا يُكَلِّفُ شَيْئًا)",
 "gratuitously": "بلا سبب, بلا مبرر (بطريقة غير مبررة أو غير مطلوبة)\nمثال: أهاننا بلا سبب",
 "gratuity": "مكافأة تقديرية (مكافأة (كما في الخدمة الجديرة بالتقدير) تُعطى دون مطالبة أو التزام) / إكرامية, بقشيش (مبلغ صغير نسبياً من المال يُعطى مقابل الخدمات المقدمة (كما من قبل نادل))",
 "gratulatory": "تَهْنِيئِيّ (يُعَبِّر عَنِ الفَرَح والسُّرُور بِنَجَاح شَخْص أَوْ حُسْن حَظِّه)",
 "graupel": "برد دقيق (أصبح باردا، ضد سَخَنَ وهو فعل لازم مصدر بَرْد وبُرود؛ مَاتَ، على المجاز لأن الميت تبرد جثته. فعل لازم مصدر بَرْد)\nمثال: لا أتحمل البرد.",
 "grave": "قَبْر, ضَرِيح (مَدْفَنُ الإِنسان، وَجَمْعُهُ قُبُور، والمَقْبَرُ الْمَصْدَرُ)\nمثال: زار توم قبر ماري.",
 "grave accent": "نَبْرَة خَفِيضَة",
 "grave mound": "تل مدفني, رابية الدفن ((في علم الآثار) كومة من التراب توضع فوق مقابر ما قبل التاريخ)",
 "gravedigger": "حفار القبور (شخص يكسب عيشه من حفر القبور)",
 "gravel": "حَصَى, حَصْبَاء (الحَصَى: صِغارُ الْحِجَارَةِ، الواحدةُ مِنْهُ حَصَاة. ابْنُ سِيدَهْ: الحَصَاة مِنَ الْحِجَارَةِ مَعْرُوفَةٌ…)",
 "gravel pit": "محجر الحصى (محجر لاستخراج الحصى)",
 "gravelly": "خَشِن (صار خشناً أو غير ناعم؛ أصبح صلباً أو غليظ الملمس)\nمثال: زيري خشن الخلق.",
 "gravelweed": "عشبة الحصى (عشب معمر بزهور صفراء؛ جنوب وجنوب وسط الولايات المتحدة)",
 "gravely": "بشدة, بشكل بالغ (لدرجة شديدة أو خطيرة) / برزانة, بوقار (بطريقة جادة ورصينة)\nمثال: أصابع متجمدة بشدة لدرجة أنه كان لا بد من بترها",
 "graven": "مَحْفُور عَلَى السَّطْح, مَنْقُوش (مقطوع أو مطبوع على سطحٍ ما) / مَنْحُوت, مُجَسَّم (مقطوع إلى الشكل المطلوب)",
 "graven image": "وَثَن",
 "graveness": "رصانة, وقار (أسلوب جاد ورزين)",
 "graver": "أداة نقش, منقاش (أداة يستخدمها النقاش)",
 "graverobber": "ناش نبش القبور (شخص يأخذ الجثث من القبور ويبيعها للتشريح) / سارق القبور (شخص يسرق الأشياء الثمينة من القبور أو السراديب)",
 "graves' disease": "داء غريفز, دراق جحوظي (جحوظ يحدث بالاشتراك مع تضخم الغدة الدرقية)",
 "gravestone": "شاهد القبر (حجر يستخدم لتحديد مكان القبر)",
 "graveyard": "مَقْبَرَة, مَقْبُرَة",
 "graveyard shift": "وردية ليلية (عمال يعملون أثناء الليل (مثل من منتصف الليل إلى 8 صباحًا)) / وردية ليلية (نوبة العمل أثناء الليل (مثل منتصف الليل إلى 8 صباحاً))",
 "graveyard watch": "النوبة الليلية, نوبة آخر الليل (نوبة حراسة أثناء الليل (كما من منتصف الليل إلى 8 صباحاً))",
 "gravid": "حُبْلَى فِي شَهْرِهَا الأَخِير, عَلَى وَشْك الوِلَادَة (في مرحلة متقدمة من الحمل)",
 "gravida": "حامل (امرأة حامل) / حامل (رقم الحمل الذي تمر به المرأة)\nمثال: في حملها الثالث يقال إن المرأة حامل للمرة الثالثة",
 "gravida i": "بكرية ((طب التوليد) امرأة حامل للمرة الأولى)",
 "gravida ii": "حامل للمرة الثانية (امرأة حامل للمرة الثانية)",
 "gravida iii": "حامل للمرة الثالثة (امرأة حامل للمرة الثالثة)",
 "gravidation": "حبل (مصطلحات تقنية للحمل)",
 "gravidity": "حبل (مصطلحات تقنية للحمل)",
 "gravidness": "حبل (مصطلحات تقنية للحمل)",
 "gravimeter": "مقياس الجاذبية (أداة قياس لقياس التغيرات في مجال الجاذبية الأرضية) / مقياس كثافة السوائل, هيدرومتر (أداة قياس لتحديد الثقل النوعي لسائل أو صلب)",
 "gravimetric": "قياس مائي, هيدرومتري (من أو يتعلق بالهيدرومتري (قياس كثافة السوائل))",
 "gravimetric analysis": "تحليل وزني (التحليل الكمي عن طريق الوزن)",
 "gravimetry": "قياس الكثافة النوعية, قياس الوزن النوعي (قياس الثقل النوعي للسوائل)",
 "graving dock": "حوض جاف (حوض كبير يمكن ضخ المياه منه؛ يستخدم لبناء السفن أو لإصلاح السفينة أسفل خط الماء)",
 "graving tool": "أداة نقش, منقاش (أداة يستخدمها النقاش)",
 "gravitas": "هيبة, وقار (الرسمية في الهيئة والمظهر)\nمثال: تصرف بوقار عظيم",
 "gravitation": "جَاذِبِيَّة",
 "gravitational": "تثاقلي, جاذبي (مكون من أو متعلق بـ أو ناتج عن الجاذبية)",
 "gravitational attraction": "ثقالة, جاذبية ((في الفيزياء) قوة الجذب بين جميع الكتل في الكون؛ وخاصة جذب كتلة الأرض للأجسام القريبة من سطحها)\nمثال: كلما كان الجسم أبعد، قلت الجاذبية",
 "gravitational collapse": "انهيار تجاذبي (الانفجار الداخلي لنجم ناتج عن جاذبيته الخاصة؛ والنتيجة هي جرم سماوي أصغر وأكثر كثافة)",
 "gravitational constant": "ثَابِت الْجَاذِبِيَّة, ثَابِت الْجَذْب الْعَامّ ((في الفيزياء) الثابت العام الذي يربط القوة بالكتلة والمسافة في قانون نيوتن للجاذبية)",
 "gravitational field": "حقل الجاذبية, مجال الجاذبية (مجال قوة يحيط بجسم ذي كتلة محدودة)",
 "gravitational force": "ثقالة, جاذبية ((في الفيزياء) قوة الجذب بين جميع الكتل في الكون؛ وخاصة جذب كتلة الأرض للأجسام القريبة من سطحها)\nمثال: كلما كان الجسم أبعد، قلت الجاذبية",
 "gravitational interaction": "تفاعل الجاذبية (تفاعل ضعيف بين الجسيمات ينتج عن كتلتها؛ يتوسطه غرافيتونات)",
 "gravitational mass": "كتلة الجاذبية ((في الفيزياء) كتلة الجسم مقاسة بجاذبيته للأجسام الأخرى)",
 "gravitational theory": "نظرية الجاذبية, نظرية نيوتن للجاذبية ((فيزياء) النظرية القائلة بأن أي جسيمين من المادة يجذبان بعضهما البعض بقوة تتناسب طردياً مع ناتج كتلتيهما وعكسياً مع مربع المسافة بينهما)",
 "gravitational wave": "موجة ثقالية",
 "gravitationally": "جاذبياً (فيما يتعلق بالجاذبية)\nمثال: قوى قوية جاذبياً",
 "gravitative": "تثاقلي, جاذبي (مكون من أو متعلق بـ أو ناتج عن الجاذبية)",
 "graviton": "غْرَافِيتُون (بوزون معياري يتوسط تفاعلات الجاذبية (الضعيفة جداً) بين الجسيمات)",
 "gravity": "رصانة, وقار (أسلوب جاد ورزين) / جدية, وقار (شعور مهيب ورصين) / ثقالة, جاذبية ((في الفيزياء) قوة الجذب بين جميع الكتل في الكون؛ وخاصة جذب كتلة الأرض للأجسام القريبة من سطحها)\nمثال: كلما كان الجسم أبعد، قلت الجاذبية",
 "gravity bomb": "قنبلة جاذبية, قنبلة غير موجهة (قنبلة تسقط بفعل الجاذبية ولا يتم توجيهها إلى هدف)",
 "gravity fault": "صدع عادي (صدع مائل يبدو فيه أن الجدار المعلق قد انزلق لأسفل بالنسبة للجدار السفلي)",
 "gravity gradient": "تَدَرُّج الجَاذِبِيَّة (تدرج في قوى الجاذبية المؤثرة على أجزاء مختلفة من جسم غير كروي)\nمثال: تدرج الجاذبية للقمر يسبب المد والجزر في المحيطات على الأرض",
 "gravity meter": "مقياس الجاذبية (أداة قياس لقياس التغيرات في مجال الجاذبية الأرضية)",
 "gravity wave": "موجة جاذبية ((في الفيزياء) موجة يفترض أنها تنشر الجاذبية وتنتقل بسرعة الضوء)",
 "gravity-assist": "مساعدة الجاذبية ((رحلات الفضاء) مسار يمر بالقرب من جسم كوكبي لاكتساب الطاقة من مجال جاذبيته)",
 "gravure": "طباعة غائرة (عملية الطباعة الغائرة) / حفر ضوئي, طباعة غائرة (مطبوعة غائرة يتم إنتاجها عن طريق الحفر) / لوحة طباعة غائرة (لوحة طباعة تستخدم في عملية الطباعة الغائرة) / طباعة غائرة, غرافور (عملية طباعة تستخدم لوحاً محفوراً أو منقوشاً؛ يُلطخ اللوح بالحبر ويُمسح لينظف، ثم يصنع الحبر المتبقي في التجاويف الطبعة)",
 "gravy": "مَرَق, مَرَقَة (الطَعَام سائل الخفيف فيه ماء اللحم وقد يكون فيه خضار أو غير ذلك. يؤكل عادة مع الرز أو الخبز. يجوز قول مَرَقَة، وهي أخص من المرَق)",
 "gravy boat": "قارب المرق, وعاء الصلصة (طبق (غالباً على شكل قارب) لتقديم المرق أو الصلصة)",
 "gravy holder": "قارب المرق, وعاء الصلصة (طبق (غالباً على شكل قارب) لتقديم المرق أو الصلصة)",
 "gravy train": "كسب يسير, مال سهل (دخل يتم الحصول عليه بحد أدنى من الجهد)",
 "gray": "رَمَادِيّ, أَشْيَب",
 "gray alder": "نغت رمادي (موطنه أوروبا ولكن أدخل إلى أمريكا)",
 "gray area": "منطقة رمادية (منطقة وسطى؛ موضوع ليس شيئاً واحداً بوضوح ولا الآخر)",
 "gray birch": "بتولا رمادية (بتولا متوسطة الحجم من شرق أمريكا الشمالية لها لحاء أبيض أو رمادي شاحب وخشب قليل القيمة؛ توجد غالباً كشجرة غابات ثانوية النمو)",
 "gray body": "جسم رمادي (جسم يبعث إشعاعاً بنسبة ثابتة مقارنة بإشعاع الجسم الأسود المقابل)\nمثال: المصدر ذو الانبعاثية المنخفضة المستقلة عن التردد غالباً ما يشار إليه بالجسم الرمادي",
 "gray catbird": "طائر المواء (طائر مغرد من أمريكا الشمالية يشبه نداءه مواء القطة)",
 "gray flounder": "فلو ندر رمادي (سمكة مفلطحة توجد من كارولينا الشمالية إلى فلوريدا وشرق خليج المكسيك)",
 "gray fox": "ثعلب رمادي (ثعلب أمريكي رمادي داكن؛ من أمريكا الوسطى عبر جنوب الولايات المتحدة)",
 "gray goldenrod": "عصا الذهب الرمادية (عشبة صباغين في كندا وشرق الولايات المتحدة ذات أزهار صفراء تستخدم أحياناً في الصباغة)",
 "gray hen": "دجاجة الطيهوج الرمادية (أنثى الطيهوج الأسود)",
 "gray jay": "قيق كندي (قيق من شمال أمريكا الشمالية ذو رأس أسود القبعة وبدون عرف؛ يشتهر بجرأته في السرقة)",
 "gray kingbird": "ملك الطيور الرمادي (طائر يتكاثر في جنوب شرق الولايات المتحدة ويشتي في أمريكا الاستوائية؛ يشبه ملك الطيور الشرقي ولكنه أكبر حجماً)",
 "gray lemming": "لاموس رمادي (لاموس من العالم القديم)",
 "gray market": "سوق رمادية (سوق غير رسمية يتم فيها شراء وبيع السلع بأسعار أقل من السعر الرسمي الذي حددته وكالة تنظيمية)",
 "gray matter": "مادة رمادية, مادة سنجابية (نسيج عصبي رمادي يحتوي على أجسام الخلايا والألياف؛ يشكل القشرة المخية المكونة من عصبونات غير مغلفة بالمايلين)",
 "gray mullet": "بوري, بوري رمادي (أسماك غذائية تعيش في المياه العذبة أو الساحلية ذات جسم مغزلي الشكل؛ توجد في جميع أنحاء العالم) / بوري, بوري رمادي (لحم عالي القيمة قليل الدهن للبوري البحري أو النهري)",
 "gray partridge": "حجل رمادي (حجل أوروبي شائع)",
 "gray polypody": "بوليبودي رمادي, سرخس القيامة (سرخس ينمو على الصخور أو جذوع الأشجار وله سعف رمادي وحرشفي من الأسفل؛ الأمريكتين وجنوب أفريقيا)",
 "gray poplar": "حور رمادي (حور كبير سريع النمو بأوراق مسننة مفصصة بشكل خافت رمادية على السطح السفلي؛ موطنه أوروبا ولكنه أدخل وتوطن في أماكن أخرى)",
 "gray sage": "شيح فضي, ميرمية فضية (نبات معمر منخفض كثير التفرع في غرب الولايات المتحدة ذو أوراق فضية؛ نبات علف ومأوى مهم)",
 "gray sea eagle": "عقاب البحر أبيض الذيل (عقاب ضخم بني رمادي بذيل أبيض قصير وتدي الشكل؛ من أوروبا وجرينلاند)",
 "gray skate": "ورنك رمادي (ورنك أوروبي شائع يستخدم كطعام)",
 "gray snapper": "نهاش رمادي (يوجد في المياه الضحلة قبالة ساحل فلوريدا)",
 "gray sole": "سمك موسى الرمادي (لحم أبيض مائل للرمادي لسمكة مفلطحة)",
 "gray substance": "مادة رمادية, مادة سنجابية (نسيج عصبي رمادي يحتوي على أجسام الخلايا والألياف؛ يشكل القشرة المخية المكونة من عصبونات غير مغلفة بالمايلين)",
 "gray whale": "حوت رمادي (حوت متوسط الحجم رمادي مسود يعيش في شمال المحيط الهادئ)",
 "gray willow": "صفصاف رمادي (صفصاف شجيري أوراسي بأغصان وبرية بيضاء)",
 "gray wolf": "ذئب الغياض, ذئب رمادي (ذئب ذو معطف رمادي مبقع يعيش في المناطق الشمالية المشجرة في أمريكا الشمالية)",
 "gray-black": "أَسْوَد رَمَادِيّ (أسود مع مسحة رمادية)",
 "gray-blue": "أَزْرَق رَمَادِيّ (أزرق مع مسحة رمادية)",
 "gray-brown": "بُنِّيّ رَمَادِيّ (بني مع مسحة رمادية)",
 "gray-collar": "يَاقَة رَمادِيَّة",
 "gray-green": "أَخْضَر رَمَادِيّ (أخضر مع مسحة رمادية)",
 "gray-haired": "أَشْيَب, شَائِب (يُظهِر علامات الشيخوخة خاصّة الشعر الأبيض أو الرماديّ)",
 "gray-headed": "أَشْيَب, شَائِب (يُظهِر علامات الشيخوخة خاصّة الشعر الأبيض أو الرماديّ)",
 "gray-pink": "وَرْدِيّ رَمَادِيّ (وردي مع مسحة رمادية)",
 "gray-white": "أَبْيَض رَمَادِيّ (أبيض مع مسحة رمادية)",
 "grayback": "دريجة حمراء (طيطوي يتكاثر في القطب الشمالي ويشتي في نصف الكرة الجنوبي) / رمادية الظهر (طائر دويتشر ذو ظهر رمادي)",
 "graybeard": "رجل عجوز (رجل كبير جداً في السن)",
 "grayhen": "دجاجة الطيهوج الرمادية (أنثى الطيهوج الأسود)",
 "grayish": "رَمَادِيّ (بلون لا لوني متوسط بين الأبيض والأسود)",
 "grayish brown": "أشهب, بني رمادي (لون أو صبغة تتراوح حول لون بني رمادي فاتح)\nمثال: ارتدت لوناً أشهب",
 "grayish-black": "أَسْوَد رَمَادِيّ (أسود مع مسحة رمادية)",
 "grayish-blue": "أَزْرَق رَمَادِيّ (أزرق مع مسحة رمادية)",
 "grayish-brown": "بُنِّيّ رَمَادِيّ (بني مع مسحة رمادية)",
 "grayish-green": "أَخْضَر رَمَادِيّ (أخضر مع مسحة رمادية)",
 "grayish-pink": "وَرْدِيّ رَمَادِيّ (وردي مع مسحة رمادية)",
 "grayish-white": "أَبْيَض رَمَادِيّ (أبيض مع مسحة رمادية)",
 "graylag": "إوز رمادي, إوزة ربداء (إوز بري رمادي شائع في أوروبا؛ سلف العديد من السلالات المستأنسة)",
 "graylag goose": "إوز رمادي, إوزة ربداء (إوز بري رمادي شائع في أوروبا؛ سلف العديد من السلالات المستأنسة)",
 "grayly": "برمادية, بلون رمادي (بمظهر رمادي)\nمثال: الجداول الوحيدة تبدو أرجوانية في الفجر، زرقاء كالسيف في الشمس، وفضية برمادية تحت الأقمار الضبابية",
 "grayness": "رمادي (لون لا لوني محايد وسط بين الأبيض والأسود)",
 "graze": "سَحَج (سَحَجَهُ يَسْحَجَ سَحْجًا: خَدَشهُ وقَشَرَهُ؛ فهو مَسحُوجٌ، وسَحِيجٌ) / رَعَى / اِرْتَعَى",
 "grazed": "مَخْدُوش بِخِفَّة, مُحْتَكّ (خُدِش أو لُمِس بخفة عند المرور)",
 "grazier": "مربي ماشية للرعي, مُرَعّي (صاحب مزرعة يرعى الأبقار أو الأغنام بغرض بيعها في السوق)",
 "grazing": "احتكاك, كشط (فعل الاحتكاك بشيء أثناء المرور) / رعي (فعل الرعي)",
 "grazing fire": "نيران كاسحة (نيران موازية للأرض تقريباً)",
 "grazing land": "أرض رعي, مرعى (حقل مغطى بالعشب أو النباتات وصالح لرعي الماشية)",
 "grease": "شَحْم",
 "grease gun": "مسدس شحم (مضخة تعمل يدوياً تشبه المسدس؛ تدفع الشحم إلى أجزاء الآلة)",
 "grease monkey": "ميكانيكي سيارات (شخص مهنته إصلاح وصيانة السيارات)",
 "grease payment": "بَخْشِيش",
 "grease pit": "حفرة فحص",
 "greaseball": "إيطالي (مهين) (مصطلح عدائي أو مهين لشخص من أصل إيطالي)",
 "greased": "مزيت, مشحم (مدهون بالزيت أو الشحم لتقليل الاحتكاك)",
 "greasepaint": "دهان تجميلي (مادة دهنية تستخدم كمكياج للممثلين)",
 "greaseproof": "مُقَاوِم لِلدُّهُون (مقاوم لنفاذ الشحوم أو الزيوت أو الشمع)",
 "greaseproof paper": "ورق زبدة, ورق مانع للشحوم (ورق غير منفذ للزيت أو الشحم؛ يستخدم في الطهي)",
 "greaser": "غريسر ((افتراء عرقي) مصطلح مهين لشخص من أصل مكسيكي)",
 "greasewood": "خشب الشحم, خشب الشحم الأسود (شجيرة شائكة منخفضة كثيرة التفرع شائعة في التربة القلوية بغرب أمريكا)",
 "greasily": "بدسامة, بدهنية (بطريقة دهنية)\nمثال: كان الطعام دهنياً بشكل لا يفتح الشهية",
 "greasiness": "دهنية, زيتية (يتكون من الزيت أو مغطى به)",
 "greasy": "دُهْنِيّ",
 "greasy spoon": "مطعم رخيص (مطعم صغير متخصص في الأطعمة المقلية سريعة التحضير)",
 "great": "رَائِع, عَظِيم / عَظِيم, كَبِير (خلاف الصَغِيْر، الكَبِيْر؛ نقيض الحَقِير)\nمثال: الصين بلد عظيم.",
 "great adductor muscle": "مقربة كبيرة (العضلة التي تقرب وتمد الفخذ)",
 "great anteater": "آكل النمل العملاق (آكل نمل كبير أشعث الشعر وعديم الأسنان ذو لسان طويل ومخالب قوية؛ من أمريكا الجنوبية)",
 "great ape": "قرد عظيم (أي من القردة العليا الكبيرة من فصيلة البونجيد)",
 "great attractor": "الجاذب العظيم (تجمع هائل من المجرات في اتجاه كوكبة قنطورس والشجاع يُعتقد أن جاذبيته تسبب انحرافات في مسارات المجرات الأخرى)",
 "great auk": "أوك عظيم (طائر أوك كبير لا يطير من الجزر الصخرية قبالة سواحل شمال الأطلسي؛ منقرض)",
 "great barracuda": "باراكودا كبيرة (باراكودا رمادية بنية كبيرة (تصل إلى 6 أقدام) تحظى بتقدير كبير كسمكة غذائية ورياضية؛ قد تكون خطرة على السباحين)",
 "great barrier reef": "اَلْحَاجِز اَلْمُرْجَانِيّ اَلْعَظِيم",
 "great bellied": "بَطِين, كَبِير البَطْن (ذو بطن بارز)",
 "great black-backed gull": "نورس أسود الظهر (نورس أبيض ذو ظهر وأجنحة سوداء)",
 "great blue heron": "بلشون أزرق كبير (بلشون أمريكي كبير ذو ريش رمادي مزرق)",
 "great blue shark": "قرش أزرق, قرش أزرق كبير (قرش نحيل عالمي الانتشار يعيش في عرض البحر؛ يتدرج لون جسمه الأزرق إلى بطن أبيض؛ خطير خاصة أثناء الكوارث البحرية)",
 "great bowerbird": "طائر التعريشة الكبير (طائر تعريشة كبير من شمال أستراليا)",
 "great britain": "بِرِيطَانِيَا الْعُظْمَى (اسم غير رسمي لِلْمَمْلَكَةِ الْمُتَّحِدَةِ؛ (منذ القرن السابع عشر) الإِمْبِرَاطُورِيَّة الْبِرِيطَانِيَّة)\nمثال: أنا من بريطانيا.",
 "great burdock": "أرقطيون كبير, لزيق (أرقطيون بأوراق على شكل قلب يوجد في الغابات المفتوحة والأسيجة والمراعي الوعرة في أوروبا (باستثناء أقصى الشمال) وآسيا الصغرى؛ يزرع أحياناً للاستخدام…)",
 "great bustard": "حبارى كبرى (أكبر طائر بري أوروبي)",
 "great care": "عناية فائقة (انتباه واعتبار أكثر مما يمنحه عادة الأشخاص الحكماء)\nمثال: مارس الطيار عناية فائقة في الهبوط",
 "great cerebral vein": "وريد غالين, وريد مخي كبير (وريد مخي يتكون من الوريدين المخيين الداخليين ويستمر في الجيب المستقيم)",
 "great circle": "دائرة عظمى (خط دائري على سطح الكرة يتشكل بتقاطعها مع مستوى يمر عبر المركز)",
 "great crested grebe": "غطاس متوج كبير (غطاس كبير من العالم القديم ذو خصلات أذن سوداء)",
 "great dane": "جريت دان (سلالة قوية كبيرة جداً ناعمة المعطف من الكلاب)",
 "great deal": "الكثير, دفعة (عدد كبير أو كمية أو مدى كبير (وغالباً ما تتبعها كلمة 'من'))\nمثال: دفعة من الرسائل",
 "great depression": "الْكَسَاد الْعَظِيم",
 "great duckweed": "عدس الماء الكبير (عالمي الانتشار باستثناء أمريكا الجنوبية ونيوزيلندا وبعض جزر المحيطات)",
 "great game": "اللعبة الكبرى",
 "great grandchild": "ابن الحفيد (طفل حفيدك أو حفيدتك)",
 "great granddaughter": "ابنة الحفيد, ابنة الحفيدة (ابنة حفيدك أو حفيدتك)",
 "great grandfather": "والد الجد, والد الجدة (أب جدك أو جدتك)",
 "great grandmother": "والدة الجد, والدة الجدة (أم جدك أو جدتك)",
 "great grandparent": "والد الجد (والد جدك)",
 "great grandson": "ابن الحفيد, ابن الحفيدة (ابن حفيدك أو حفيدتك)",
 "great gray owl": "بومة رمادية عظمى (بومة كبيرة ذات وجه مسطح من شمال أمريكا الشمالية وغرب أوراسيا)",
 "great grey kangaroo": "كنغر رمادي شرقي, كنغر عملاق (كنغر أسترالي بني رمادي كبير جداً كان وفيراً سابقاً في المناطق المشجرة المفتوحة)",
 "great grey owl": "بومة رمادية عظمى (بومة كبيرة ذات وجه مسطح من شمال أمريكا الشمالية وغرب أوراسيا)",
 "great gross": "غُرُوس كَبِير (عدد أصلي يساوي اثنتي عشرة غروساً)",
 "great hall": "القاعة الكبرى (القاعة الرئيسية في قلعة أو قصر؛ يمكن استخدامها لتناول الطعام أو الترفيه)",
 "great horned owl": "بومة قرناء كبيرة (بومة قرناء بنية من أمريكا الشمالية)",
 "great hours": "صَلَاة السَّاعَات الْكَبِيرَة",
 "great hundred": "مِائَة طَوِيلَة (العدد الأصلي الذي هو حاصل ضرب عشرة في اثنا عشر)",
 "great knapweed": "قنطريون كبير (نبات أوروبي معمر طويل له رؤوس زهور أرجوانية)",
 "great lakes": "اَلْبُحَيْرَات اَلْعُظْمَى",
 "great lobelia": "لوبيليا زرقاء كبيرة (عشبة معمرة طويلة ومنتصبة وورقية جداً من شرق أمريكا الشمالية ذات سنابل كثيفة من الزهور الزرقاء)",
 "great maple": "قيقب الجميز, قيقب كبير (شجرة قيقب أوراسية بلحاء رمادي شاحب يتقشر في رقائق مثل شجرة الجميز؛ أوراقها بخمسة فصوص بيضاوية صفراء في الخريف)",
 "great millet": "ذرة بيضاء, سورغم (مهم لغذاء الإنسان والحيوان؛ عادة النمو وشكل الساق يشبه الذرة الهندية ولكن بأوراق مسننة الحواف)",
 "great mullein": "آذان الدب, بوصير (بوصير طويل الساق صوفي جداً بزهور صفراء مكتظة بكثافة؛ كان الإغريق والرومان القدماء يغمسون السيقان في الشحم لاستخدامها كمشاعل جنائزية)",
 "great patriotic war": "الْحَرْب الْوَطَنِيَّة الْعُظْمَى",
 "great plains": "السُّهُول الْعُظْمَى",
 "great plains paintbrush": "فرشاة رسم السهول الكبرى, كاستيليجا لاطئة الأزهار (نبات مشعر بزهور وردية؛ السهول الكبرى إلى شمال المكسيك)",
 "great power": "قُوَّة عُظْمَى (ضد الضُعْف، الشِدَّة والقُدْرَة الجِسْمَانِيَّة؛ ضد الضُعْف، المَقْدِرَة والحَوْل والتَمَكُّن، القدرة المعنوية)\nمثال: توم شعر بالقوة.",
 "great proletarian cultural revolution": "الثورة الثقافية, الثورة الثقافية البروليتارية الكبرى (إصلاح جذري في الصين بدأه ماو تسي تونغ عام 1965 ونفذه الحرس الأحمر إلى حد كبير؛ بهدف القضاء على العناصر المضادة للثورة في الحكومة وأدى إلى تطهير…)",
 "great pyramid of giza": "هَرَم أَكْبَر, هَرَم خُوفُو ((في الهندسة) منشور كثير السطوح، قاعدته مضلع، وأوجهه الأخرى مثلثات، قواعدها أضلاع مضلع القاعدة، ورؤوسها مجتمعة في نقطة واحدة خارجة عنه؛ بناء أثري بناه الفراعنة في مصر بالحجارة الصلبة، ذو قاعدة مربعة، له أربع واجهات، وكل واجهة مثلثة الشكل، تلتقي رؤوسها فتكون رأسًا واحدًا هو قمة الهرم)",
 "great pyrenees": "كلب الجبال البيرينيه (سلالة من الكلاب البيضاء الكبيرة كثيفة الشعر تشبه نيوفاوندلاند)",
 "great ragweed": "دمسيسة كبيرة, رجيد كبير (نبات حولي خشن ببعض الأوراق مشقوقة بعمق وبشكل كفي إلى ثلاثة أو خمسة شقوق)",
 "great russian": "روسي عرقي, روسي عظيم (عضو في الأصل الرئيسي للشعب الروسي الذي يعيش في روسيا الأوروبية؛ تستخدم لتمييز الروس العرقيين عن غيرهم من الشعوب المدمجة في روسيا)",
 "great salt lake": "الْبُحَيْرَة الْمَالِحَة الْكُبْرَى",
 "great saphenous vein": "وَرِيد صَافِن صَغِير",
 "great satan": "اَلشَّيْطان اَلْأَكْبَر",
 "great seal": "الختم العظيم (الختم الرئيسي للحكومة، يرمز للسلطة أو السيادة)",
 "great skua": "كركر كبير (كركر بني كبير يعيش في شمال المحيط الأطلسي)",
 "great snipe": "شنقب كبير (شنقب من العالم القديم أكبر وأغمق من الشنقب الشائع)",
 "great solomon's-seal": "خاتم سليمان العظيم (عشب معمر من أمريكا الشمالية بأوراق ناعمة وزهور خضراء أنبوبية متدلية)",
 "great st john's wort": "عشبة القديس يوحنا الكبيرة (شجيرة معمرة لها زهور صفراء كبيرة على شكل نجمة في نوارات هرمية ضيقة)",
 "great toe": "إبهام القدم (الإصبع الأول الأكبر والأكثر تداخلًا في القدم)",
 "great wall of china": "سُور اَلصِّين اَلْعَظِيم",
 "great war": "اَلْحَرْب الْعُظْمَى",
 "great white heron": "بلشون أبيض كبير (بلشون أبيض كبير من فلوريدا وجزر فلوريدا كيز) / بلشون أبيض كبير (بلشون أبيض واسع الانتشار في العالم القديم) / بلشون أمريكي (بلشون شائع من جنس إغريتا يوجد في أمريكا؛ وهو نوع من البلشون الأبيض للعالم القديم)",
 "great white hope": "أمل كبير (شخص (أو شيء) يُتوقع منه تحقيق نجاح كبير في مجال معين)\nمثال: هذه الشركة هي الأمل الكبير لسياسة إدارة النفايات في الصناعة النووية",
 "great white pelican": "بجع أبيض كبير (يشبه البجع الأبيض الأمريكي)",
 "great white shark": "قِرْش أَبْيَض عَظِيم",
 "great year": "سنة أفلاطونية, سنة عظمى (الوقت اللازم لدورة كاملة واحدة لمبادرة الاعتدالين، حوالي 25,800 سنة)",
 "great yellow gentian": "جنطيانا صفراء, كوشاد أصفر (نبات أوروبي معمر قوي له عناقيد من الزهور الصفراء)",
 "great yellowcress": "رشاد أصفر كبير, روريپا برمائية (عشبة معمرة توجد على ضفاف الجداول والأنهار في جميع أنحاء أوروبا باستثناء أقصى الشمال والبحر الأبيض المتوسط؛ توضع أحياناً في جنس ناستورتيوم)",
 "great-aunt": "خالة كبرى, عمة كبرى (عمة أو خالة والدك أو والدتك)",
 "great-leaved macrophylla": "ماغنوليا كبيرة الأوراق (شجيرة كبيرة متساقطة الأوراق أو شجرة في جنوب شرق الولايات المتحدة ذات أوراق ضخمة في دوامات كاذبة كثيفة وزهور كريمية كبيرة مشوبة بالأرجواني نحو القاعدة)",
 "great-nephew": "ابن ابن الأخ, ابن ابن الأخت (ابن ابنة أخيك أو ابن أخيك)",
 "great-niece": "ابنة ابن الأخ, ابنة ابن الأخت (ابنة ابنة أخيك أو ابن أخيك)",
 "great-uncle": "خال الأب, عم الأب (عم أو خال والدك أو والدتك)",
 "greatcoat": "مِعْطَف سَمِيك",
 "greater": "أَكْبَر, كُبْرَى (الأَكْبَر: هو ما فاق غيره في الكُبْر، ويكون ذلك إما بالحجم أو المقام أو كلاهما؛ للكُبْر)\nمثال: إنه أخي الأكبر.",
 "greater armenia": "أرمينيا الكبرى ((تاريخًا) مملكة أرمينيا، مملكة حكمت ما بين عامي ٣٨٠ قبل الميلاد و٣٨٧/٤٢٨ للميلاد؛ (تاريخًا) مملكة أرمينيا، مملكة حكمت في العصور الوسطى، ما بين عامي ٨٨٥ و١٠٤٥ للميلاد)\nمثال: خسرت أرمينيا الحرب.",
 "greater burdock": "أرقطيون كبير, لزيق (أرقطيون بأوراق على شكل قلب يوجد في الغابات المفتوحة والأسيجة والمراعي الوعرة في أوروبا (باستثناء أقصى الشمال) وآسيا الصغرى؛ يزرع أحياناً للاستخدام…)",
 "greater butterfly orchid": "أوركيد الفراشة الكبير (أوركيد جنوب أوروبي بزهور خضراء داكنة أكبر وأقل عطراً من أوركيد الفراشة الصغير؛ يوضع أحياناً في جنس هابيناريا)",
 "greater celandine": "بقلة الخطاطيف, عروق الصباغين (عشبة معمرة بجذع خشبي متفرع وزهور صفراء زاهية)",
 "greater knapweed": "قنطريون كبير (نبات أوروبي معمر طويل له رؤوس زهور أرجوانية)",
 "greater kudu": "كودو أكبر (نوع من الكودو)",
 "greater london": "لَنْدَن اَلْكُبْرَى",
 "greater masterwort": "أسترانتيا كبرى (عشب أوروبي بجذور عطرية وأوراق في خصلة قاعدية وخيمات مركبة بارزة من الزهور البيضاء إلى الوردية)",
 "greater omentum": "ثرب كبير (جزء من الصفاق متصل بالمعدة والقولون ويغطي الأمعاء)",
 "greater pectoral muscle": "صدرية كبرى (عضلة هيكلية تقرب الذراع وتديرها)",
 "greater peritoneal sac": "تجويف بريتوني, كيس صفاقي أكبر (الجزء الداخلي من الصفاق؛ حيز محتمل بين طبقات الصفاق)",
 "greater pichiciego": "مدرع قزم كبير (نوع من المدرع يعيش في جنوب أمريكا الجنوبية)",
 "greater prairie chicken": "دجاجة البراري الكبرى (أكثر أنواع دجاج البراري شيوعاً)",
 "greater rhomboid muscle": "معينية كبرى (عضلة معينية تسحب لوح الكتف باتجاه العمود الفقري)",
 "greater scaup": "زرقاي كبير (بط غواص كبير في أمريكا الشمالية يتميز الذكر منه بلمعان مخضر على الرأس)",
 "greater spearwort": "حوذان لسانية, سنانية كبرى (حوذان أوروبي شبه مائي ذو أوراق تشبه الرماح)",
 "greater stitchwort": "حشيشة القزاز الكبرى (عشبة منخفضة النمو في المنطقة المعتدلة الشمالية ذات أزهار بيضاء صغيرة على شكل نجمة؛ سميت لقدرتها المزعومة على تخفيف الآلام الحادة في الجانب)",
 "greater swiss mountain dog": "كلب الجبل السويسري الكبير (أكبر السلالات السويسرية الأربع)",
 "greater than": "أَكْبَر مِن (الأَكْبَر: هو ما فاق غيره في الكُبْر، ويكون ذلك إما بالحجم أو المقام أو كلاهما؛ للكُبْر)\nمثال: إنه أخي الأكبر.",
 "greater water parsnip": "جزر الماء الكبير (نبات معمر كبير قوي ذو زهور بيضاء يوجد برياً في المياه العذبة الضحلة؛ أوروبا)",
 "greater whitethroat": "هازجة بيضاء الزور (هازجة من العالم القديم بنية رمادية ذات حلق وأجزاء سفلية بيضاء)",
 "greater yellowlegs": "صفراء الساق الكبرى (نوع من طيور صفراء الساق، طائر شاطئي كبير في أمريكا الشمالية)",
 "greatest": "أَرْقَى, فَائِق الجَوْدَة (الأعلى في مستوى الجودة)",
 "greatest common divisor": "العَامِل المُشْتَرَك الأَكْبَر, القَاسِم المُشْتَرَك الأَكْبَر (أكبر عدد صحيح يقسم مجموعة من الأعداد الصحيحة بدون باقي)",
 "greatest common factor": "العَامِل المُشْتَرَك الأَكْبَر, القَاسِم المُشْتَرَك الأَكْبَر (أكبر عدد صحيح يقسم مجموعة من الأعداد الصحيحة بدون باقي)",
 "greathearted": "شَهْم, كَرِيم النَّفْس (نبيل وكريم في الروح والطبع)",
 "greatly": "بشكل كبير",
 "greatness": "عَظَمَة, كِبَر",
 "greave": "دِرْع لِلسَّاقِ (الثَلَاثُ الدُرَع: الليلة السادسة عشر والسابعة عشر والثامنة عشر من كل شهر قمري…)\nمثال: اعطني هذا الدرع.",
 "greaves": "بقايا الشحم (البقايا التي تتبقى بعد إذابة الدهون الحيوانية)",
 "grebe": "غطاس (طائر مائي صغير مدمج الجسم بالكامل تقريباً يبني أعشاشاً عائمة؛ يشبه الغواص ولكنه أصغر وله أقدام مفصصة بدلاً من مكففة)",
 "grecian": "إغريقي, يوناني (من أو يتعلق باليونان أو الإغريق أو اللغة اليونانية أو يميزهم) / إغريقي, يوناني (مواطن أو مقيم في اليونان)\nمثال: الأساطير اليونانية",
 "grecism": "يونانية (كلمة أو تعبير من اللغة اليونانية مستخدم في لغة أخرى)",
 "greco-roman": "إِغْرِيقِيّ رُومَانِيّ, كْلَاسِيكِيّ (ينتمي إلى الحضارة الإغريقيّة الرومانيّة القديمة أو يتّسم بطابعها)",
 "greco-roman architecture": "العمارة الكلاسيكية, العمارة اليونانية الرومانية (العمارة المتأثرة باليونان القديمة أو روما)",
 "greco-roman deity": "إله يوناني-روماني (إله من الأساطير الكلاسيكية)",
 "greco-roman wrestling": "مصارعة رومانية (أسلوب من المصارعة يُمنع فيه المصارعون من عرقلة الخصم أو استخدام مسكات تحت الخصر)",
 "greed": "جَشَع, طَمَع (اِسْمٌ وَصِفَةٌ لِلْأَسَد)\nمثال: كان مارك يميل للجشع.",
 "greedily": "بِجَشَع, بِطَمَع (بطريقة جشعة)",
 "greediness": "جشع, طمع (رغبة مفرطة في الثروة (عادة بكميات كبيرة)) / جشع, شره (رغبة مفرطة في الطعام)\nمثال: جشع المحامين",
 "greedy": "طَمَّاع, جَشِع / شرِه, نهِم ((شَرِهَ) إلى الطعام وغيره، وشَرِهَ عليه يَشْرَهَ شَرَهًا: اشتد حرصُه عليه واشتِهاؤه له؛ فهو شَرِهٌ وشَرْهَانُ، وهي شَرِهة وشَرْهَى)\nمثال: كانت صوفيا شرهة.",
 "greegree": "تميمة أفريقية (تميمة ذات أصل أفريقي)",
 "greek": "يُونَانِيّ, إِغْرِيقِيّ",
 "greek alphabet": "الأبجدية اليونانية (الأبجدية التي استخدمها اليونانيون القدماء)",
 "greek architecture": "العمارة اليونانية (عمارة اليونان القديمة)",
 "greek catholic": "روم كاثوليك (عضو في الكنيسة اليونانية الأرثوذكسية)",
 "greek chorus": "جوقة, جوقة إغريقية (فرقة من الممثلين الذين يعلقون (بالتحدث أو الغناء في انسجام) على الحدث في مسرحية يونانية كلاسيكية)",
 "greek church": "الكنيسة اليونانية الأرثوذكسية, كنيسة الروم الأرثوذكس (كنيسة الدولة في اليونان؛ جزء مستقل من الكنيسة الأرثوذكسية الشرقية)",
 "greek clover": "حلبة (عشب حولي في جنوب أوروبا وشرق آسيا له أزهار بيضاء مائلة للصفرة وبذور عطرية تستخدم طبياً وفي الكاري)",
 "greek cross": "صليب يوناني (صليب ذو أذرع أربعة متساوية الطول)",
 "greek deity": "إله يوناني (إله عبده الإغريق القدماء)",
 "greek drachma": "دراخما, دراخما يونانية (سابقاً وحدة المال الأساسية في اليونان)",
 "greek fire": "النَّارُ الإِغْرِيقِيَّة",
 "greek fret": "تعشيق هندسي, مفتاح إغريقي (نمط زخرفي يتكون من خطوط عمودية وأفقية متكررة (غالباً بشكل بارز))\nمثال: كان هناك تعشيق هندسي بسيط في أعلى الجدران",
 "greek key": "تعشيق هندسي, مفتاح إغريقي (نمط زخرفي يتكون من خطوط عمودية وأفقية متكررة (غالباً بشكل بارز))\nمثال: كان هناك تعشيق هندسي بسيط في أعلى الجدران",
 "greek mode": "مقام يوناني (أي من السلالم الدياتونية التنازلية في موسيقى اليونان الكلاسيكية)",
 "greek monetary unit": "وحدة نقدية يونانية (الوحدة النقدية في اليونان)",
 "greek mythology": "الأساطير الإغريقية, الأساطير اليونانية (أساطير اليونانيين القدماء)",
 "greek orthodox": "أرثوذكسي (من أو يتعلق بالكنيسة الأرثوذكسية الشرقية أو يتميز بها)",
 "greek orthodox church": "كَنِيسَة الرُّوم الأُرْثُوذُكْس (محلّ العبادة عند المسيحيين؛ جماعة المؤمنين بدين المسيح)\nمثال: أين أقرب كنيسة ؟",
 "greek partridge": "حجل الصخر (من المناطق الجبلية في جنوب أوروبا)",
 "greek valerian": "سلم يعقوب, ناردين يوناني (نبات معمر أوروبي ذو أوراق ريشية له زهور زرقاء زاهية أو بيضاء) / بوليمونيوم زاحف, ناردين يوناني (نبات معمر منتصب أو منتشر في شرق الولايات المتحدة)",
 "greekness": "الطابع اليوناني (حالة أو شرط كون الشيء يونانياً)",
 "green": "أَخْضَر, خَضْرَاء (أحد الألوان الثانوية يتكون من خلط الأَصْفَر والأَزْرَق وهو لون وَرَق النَبَات؛ صفة ما كان لونه أخضرا) / خُضْر (خَضَر الرجلُ النَّخْلَ خَضَر ُ خَضْرًا: قطعه)\nمثال: ذلك الضوء أخضر.",
 "green adder's mouth": "فم الأفعى الأخضر (أوركيد أمريكي شمالي له ورقة وحيدة وزهور ببتلات تشبه الخيوط)",
 "green alder": "نغت أخضر (شجيرة من المناطق الجبلية في أوروبا) / نغت أخضر (شجيرة من أمريكا الشمالية بأوراق خضراء فاتحة وجوز مجنح)",
 "green algae": "طحالب خضراء (طحالب ذات لون أخضر صافٍ؛ تنمو غالباً على الصخور الرطبة أو الخشب الرطب أو سطح المياه الراكدة)",
 "green apple aphid": "من التفاح (من أخضر ساطع؛ يتغذى على أوراق التفاح ويسبب تجعدها)",
 "green arrow arum": "لوف السهم الأخضر (عشبة معمرة في شرق الولايات المتحدة ذات أوراق على شكل رأس السهم وقنابة مدببة ممدودة وتوت أخضر)",
 "green ash": "مران أخضر (صنف من المران الأحمر يتميز بغصينات وأسطح أوراق سفلية لامعة)",
 "green bean": "فَاصُولِيَاء",
 "green belt": "حزام أخضر (خيط أو قطعة من جلد تستخدم لحَزْم النَبَات أو العِيدَان أو غيرها لتكوين حُزْمَة؛ النِطَاق، قطعة من الجِلْد الطَوِيل يلف حول الخَصْر إما ليمسك المَلابِس أو ليظهر الخصر)\nمثال: هذا حزام من الجلد.",
 "green beret": "جندي القوات الخاصة, صاحب القبعة الخضراء (جندي عضو في القوات الخاصة للجيش الأمريكي)",
 "green bond": "السندات الخضراء - سندات المناخ",
 "green bristlegrass": "ذيل الثعلب الأخضر (ذيل ثعلب أوروبي متوطن في أمريكا الشمالية؛ غالباً ما يكون عشبة ضارة مزعجة)",
 "green broom": "وزال اسكتلندي, وزال شائع (وزال متساقط الأوراق قائم منتشر موطنه غرب أوروبا؛ يزرع على نطاق واسع لزهوره الصفراء الغنية)",
 "green card": "كَارْت أَخْضَر",
 "green corn": "ذرة حلوة (ذرة يمكن أن تؤكل كخضار وهي لا تزال صغيرة وطرية) / ذرة حلوة (نبات ذرة تم تطويره ليكون له أكواز صغيرة حلوة ومناسبة للأكل)",
 "green douglas fir": "تنوب دوغلاس الأخضر, صنوبر أوريغون (تنوب دوغلاس شاهق من شمال غرب أمريكا الشمالية له إبر قصيرة ومخاريط بيضاوية الشكل)",
 "green dragon": "تنين أخضر (نبات يزهر في أوائل الربيع في شرق أمريكا الشمالية يشبه اللفت الهندي ولكنه ذو أوراق كفية وقنابة صفراء مخضرة نحيلة وطلع ممدود) / تنين أخضر, لوف التنين (لوف أوروبي يشبه اللوف المبقع)",
 "green energy": "الطاقة الخضراء",
 "green fingers": "مَهَارَة زِرَاعِيَّة, يَد خَضْرَاء (قدرة خاصة على جعل النباتات تنمو)",
 "green foxtail": "ذيل الثعلب الأخضر (ذيل ثعلب أوروبي متوطن في أمريكا الشمالية؛ غالباً ما يكون عشبة ضارة مزعجة)",
 "green fringed orchis": "سحلب ممزق (سحلب مهدب من شرق الولايات المتحدة له زهرة مخضرة بشفة ممزقة بعمق)",
 "green frog": "ضفدع أخضر (يشبه ضفدع الثور؛ يوجد في المستنقعات والبرك أو بالقرب منها؛ في الولايات المتحدة وكندا)",
 "green gentian": "جنطيانا خضراء (عشب طويل له عثاكيل من الزهور البيضاء المشوبة بالخضرة؛ شمال غرب الولايات المتحدة؛ يوضع أحياناً في جنس سويرتيا)",
 "green gland": "غدة خضراء (إحدى زوج من الغدد (يعتقد أن لها وظائف إخراجية) في بعض القشريات بالقرب من قاعدة الهوائيات الكبيرة)",
 "green goddess": "بانجو, عشب (أسماء دارجة للماريجوانا)",
 "green gold": "ذهب أخضر (سبيكة ذهب (عيار 14 قيراطًا على الأقل مع الفضة أو الفضة والكادميوم) ذات مظهر أخضر)",
 "green goods": "خضراوات وفواكه, منتجات زراعية (فواكه وخضراوات طازجة تزرع من أجل السوق)",
 "green gram": "لوبياء شعاعية, ماش (بذور نبات الماش المستخدمة كغذاء) / فول مونج, ماش (بذرة نبات الماش؛ تستخدم للغذاء)",
 "green groceries": "خضراوات وفواكه, منتجات زراعية (فواكه وخضراوات طازجة تزرع من أجل السوق)",
 "green hellebore": "خربق أخضر (نبات متساقط الأوراق ذو أوراق كبيرة خضراء داكنة مفصصة وأزهار خضراء متدلية تشبه الصحن)",
 "green june beetle": "آكلة التين, خنفساء يونيو الخضراء (خنفساء يونيو خضراء كبيرة من جنوب الولايات المتحدة)",
 "green lacewing": "شبكية الأجنحة الخضراء (ذبابة شبكية الأجنحة خضراء شاحبة كريهة الرائحة لها يرقات آكلة للحوم)",
 "green lead ore": "بيرومورفيت, خام الرصاص الأخضر (معدن يتكون من كلوريد وفوسفات الرصاص؛ مصدر ثانوي للرصاص)",
 "green light": "ضَوْء أَخْضَر (النُّور؛ مصدر ضَاء)\nمثال: ضوء القمر ضعيف.",
 "green lizard": "سحلية خضراء (سحلية أوراسية شائعة يبلغ طولها حوالي قدم)",
 "green mamba": "مامبا خضراء (الطور الأخضر للمامبا السوداء)",
 "green manure": "سماد أخضر (محصول نامٍ يتم حرثه في التربة لإغنائها)",
 "green market": "سوق المزارعين (سوق مفتوح للمنتجات الزراعية)",
 "green mayonnaise": "مايونيز أخضر (مايونيز مع الطرخون أو الشبت والجرجير المفروم والسبانخ أو الخيار)",
 "green monkey": "سعدان أخضر (قرد سافانا شائع ذو ظهر رمادي مخضر وذيل أصفر)",
 "green monkey disease": "حمى ماربورغ النزفية, مرض ماربورغ (مرض فيروسي يصيب القردة الخضراء يسببه فيروس ماربورغ؛ عندما ينتقل إلى البشر يسبب مرضاً خطيراً أو مميتاً)",
 "green mushroom pimple": "بثرة الفطر الخضراء",
 "green olive": "زيتون أخضر (زيتون يقطف أخضر ويخلل في محلول ملحي؛ يحشى بشكل غير متكرر بالفلفل الأحمر مثلاً)",
 "green onion": "بصل أخضر (بصل صغير قبل تضخم البصلة؛ يؤكل في السلطات)",
 "green paper": "ورقة خضراء (تقرير أولي لمقترحات حكومية يتم نشره لتحفيز النقاش)",
 "green party": "حزب الخضر (حزب سياسي بيئي)",
 "green pea": "بازلاء خضراء (بازلاء طازجة)",
 "green pea soup": "حساء البازلاء الخضراء (مصنوع من البازلاء الخضراء الطازجة والمرق مع الخس والبصل والكرفس المقطع)",
 "green peach aphid": "من الخوخ الأخضر (من أخضر مصفر مدمر بشكل خاص للخوخ)",
 "green peafowl": "طاووس أخضر (طاووس جنوب شرق آسيا)",
 "green pepper": "فلفل أخضر (فلفل حلو يصبح أحمر عند النضج)",
 "green plover": "أبو طيط, زقزاق شامي (زقزاق متوج كبير من العالم القديم له دلايات ومهاميز)",
 "green revolution": "ثورة خضراء (إدخال المبيدات الحشرية والحبوب عالية الغلة والإدارة الأفضل خلال الستينيات والسبعينيات مما زاد بشكل كبير من الإنتاجية الزراعية)",
 "green salad": "سلطة خضراء (سلطة مخلوطة تتكون أساساً من الخضروات الورقية)",
 "green smut": "تفحم أخضر, تفحم كاذب (مرض يصيب الأرز؛ حيث تُغطى الحبوب بمسحوق أخضر يتكون من كونيديا)",
 "green smut fungus": "فطر التفحم الأخضر (فطر يسبب التفحم الأخضر في الأرز)",
 "green snake": "ثعبان أخضر (أي من ثعبانين من أمريكا الشمالية آكلين للحشرات بشكل رئيسي ولونهما أخضر) / ثعبان أخضر أفريقي (أي من ثعابين أفريقية عديدة من فصيلة الأحناش)",
 "green soap": "صابون طري (صابون طري (أو سائل) مصنوع من زيوت نباتية؛ يستخدم في بعض الأمراض الجلدية)",
 "green soy": "لوبياء شعاعية, ماش (بذور نبات الماش المستخدمة كغذاء) / فول مونج, ماش (بذرة نبات الماش؛ تستخدم للغذاء)",
 "green soybean": "فول الصويا الأخضر (بذور تقشر وتطهى مثل فاصولياء ليما)",
 "green spleenwort": "طحال أخضر (سرخس صغير بسعف أخضر نحيل؛ واسع الانتشار في الأجزاء الباردة من نصف الكرة الشمالي)",
 "green tea": "شَايْ أَخْضَر (شَجَرَة خَضْرَاء من فَصِيلَة الكَامِيلِيات لها أزْهَار بَيْضَاء، وتُعْطِي أوراقاً يصنع منها شَرَاب مُنَبِّه؛ أوراق الشجرة المجففة)\nمثال: صب الشاي لضيفك.",
 "green thumb": "مَهَارَة زِرَاعِيَّة, يَد خَضْرَاء (قدرة خاصة على جعل النباتات تنمو)",
 "green turtle": "سلحفاة خضراء (سلحفاة استوائية كبيرة ذات لحم مخضر يُستخدم في حساء السلاحف)",
 "green turtle soup": "حساء السلاحف (حساء يُصنع عادة من لحم السلاحف الخضراء)",
 "green woodpecker": "نقار الخشب الأخضر (نقار خشب من أوروبا وغرب آسيا)",
 "green zone": "الْمِنْطَقَة الْخَضْرَاء",
 "green-blind": "مُصَاب بِعَمَى الأَخْضَر (عدم القدرة على رؤية اللون الأخضر أو التمييز بين الأخضر والأحمر الأُرجوانيّ)",
 "green-blindness": "عمى الأخضر (عمى ألوان ثنائي يتميز بانخفاض الحساسية للضوء الأخضر مما يؤدي إلى عدم القدرة على التمييز بين الأخضر والأحمر الأرجواني)",
 "green-eyed": "حَسُود, غَيُور (شديد الارتياب أو الخوف من أن يحلّ منافس محله)",
 "green-eyed monster": "غيرة (شعور بالحسد الغيور (خاصة من منافس))",
 "green-tailed towhee": "طوهي أخضر الذيل (طائر طوهي من جبال روكي)",
 "green-white": "أَبْيَض مُخْضَرّ (أبيض مع مسحة خضراء)",
 "green-winged teal": "حذف أخضر الجناح (بط صغير شائع في أوراسيا وأمريكا الشمالية)",
 "greenback": "ورقة نقدية (قطعة من النقود الورقية (خاصة تلك الصادرة عن بنك مركزي))\nمثال: سحب خمس أوراق نقدية من فئة ألف زلوتي",
 "greenback party": "حزب الدولار الأخضر, غرينباك (حزب سياسي سابق في الولايات المتحدة؛ نُظم عام 1874؛ عارض أي تخفيض في كمية النقود الورقية المتداولة)",
 "greenbelt": "حزام أخضر (حزام من المتنزهات أو الأراضي الريفية المحيطة ببلدة أو مدينة)",
 "greenbottle": "ذباب أخضر (ذباب ذو جسم أخضر نحاسي لامع)",
 "greenbottle fly": "ذباب أخضر (ذباب ذو جسم أخضر نحاسي لامع)",
 "greenbrier": "عشبة الثور, فصة مستديرة الأوراق (كرمة خشبية شائكة جداً في شرق الولايات المتحدة تنمو في كتل متشابكة ولها سيقان مستديرة قوية بأوراق جلدية لامعة وأزهار خضراء صغيرة تليها عناقيد من التوت…)",
 "greenery": "خضرة (أوراق خضراء)",
 "greeneye": "خضراء العيون (أسماك تعيش في القاع ولها عيون كبيرة ذات بريق أخضر معدني)",
 "greenfly": "من أخضر (من مخضر؛ آفة على نباتات الحدائق والمحاصيل)",
 "greengage": "جَانَرِك",
 "greengage plum": "برقوق أخضر, جنارك (صنف حلو أخضر أو أصفر مخضر من البرقوق)",
 "greengrocer": "بَقَّال",
 "greengrocery": "دكان خضري, محل خضار (متجر بقالة لبيع الخضار والفواكه) / خضار, خضروات وفاكهة (سلع البقالة التي يبيعها بائع الخضار)",
 "greenhood": "أوركيد الخوذة, القلنسوة الخضراء (أي من بساتين الفاكهة العديدة من جنس بتيروستيليس ذات أوراق في وردية قاعدية وزهور خضراء مخططة غالباً بالأرجواني أو البني أو الأحمر مع انحناء السبلة…)",
 "greenhorn": "ساذج, غر (شاب أخرق وقليل الخبرة)",
 "greenhouse": "دَفِيئَة زِرَاعِيّة, دَفِيئَة",
 "greenhouse effect": "اَلاِحْتِبَاس اَلْحَرَارِيّ",
 "greenhouse emission": "غاز الاحتباس الحراري, غاز دفيئة (غاز يساهم في ظاهرة الاحتباس الحراري عن طريق امتصاص الأشعة تحت الحمراء)",
 "greenhouse gas": "غازات دفيئة",
 "greenhouse warming": "احتباس حراري (ارتفاع درجة الحرارة الناتج عندما تحبس الغازات الجوية الإشعاع الشمسي؛ حيث تسمح هذه الغازات بمرور ضوء الشمس ولكنها تمتص الحرارة المنبعثة مرة أخرى من…)",
 "greenhouse whitefly": "ذبابة البيوت الزجاجية البيضاء (ذبابة بيضاء تسكن البيوت الزجاجية)",
 "greening": "استعادة الشباب, تجدد (ظاهرة استعادة الحيوية والنضارة)\nمثال: التجدد السنوي للمناظر الطبيعية",
 "greenish": "أَخْضَر (بلون بين الأزرق والأصفر في الطيف اللوني؛ مشابه للون العشب الطازج)",
 "greenish blue": "أزرق مخضر, تركواز (درجة من الأزرق مشوبة بالأخضر)",
 "greenish yellow": "أصفر مخضر (درجة من الأصفر مشوبة بالأخضر)",
 "greenish-brown": "بُنِّيّ مُخْضَرّ (بني مع مسحة خضراء)",
 "greenish-gray": "رَمَادِيّ مُخْضَرّ (رمادي مع مسحة خضراء)",
 "greenish-grey": "رَمَادِيّ مُخْضَرّ (رمادي مع مسحة خضراء)",
 "greenish-white": "أَبْيَض مُخْضَرّ (أبيض مع مسحة خضراء)",
 "greenishness": "اخضرار (خاصية الميل للأخضر)",
 "greenland": "جِرِينْلَانْد, غِرِينْلَانْد",
 "greenland caribou": "رنة, كاريبو (أيل قطبي ذو قرون كبيرة في كلا الجنسين؛ يسمى 'رنة' في أوراسيا و 'كاريبو' في أمريكا الشمالية)",
 "greenland spar": "كريوليت (معدن أبيض يتكون من فلوريدات الألمنيوم والصوديوم؛ مصدر للفلور)",
 "greenland whale": "حوت مقوس الرأس (حوت قطبي كبير الفم)",
 "greenling": "جرينلينغ (سمكة غذائية في شمال المحيط الهادئ)",
 "greenly": "بِاخْضِرَار (باللون الأخضر)\nمثال: انحدر الريف باخضرار نحو الوادي",
 "greenmail": "ابتزاز الأسهم, غرين ميل ((الشركات) ممارسة شراء أسهم كافية في شركة لتهديدها بالاستحواذ وبالتالي إجبار الملاك على إعادة شراء تلك الأسهم بعلاوة للبقاء في العمل)",
 "greenmarket": "سوق المزارعين (سوق مفتوح للمنتجات الزراعية)",
 "greenness": "خُضْرَة",
 "greenockite": "غرينوكيت (خام الكادميوم؛ معدن مصفر نادر يتكون من كبريتيد الكادميوم في شكل بلوري)",
 "greenroom": "الغرفة الخضراء, غرفة الاستراحة (غرفة خلف الكواليس في المسرح حيث يستريح المؤدون أو يستقبلون الزوار)",
 "greens": "خضراوات ورقية (أي من النباتات الورقية المختلفة أو أوراقها وسيقانها التي تؤكل كخضروات)",
 "greensand": "رمل أخضر (ذرات دقيقة من الصخور أو المعادن، تتكون طبيعياً بفعل الرياح أو الماء؛ تربة رخوة تتكوّن غالباً على الشاطئ أو في الصحارى)\nمثال: وصلت شاحنة الرمل.",
 "greenshank": "طيطوي أخضر الساق (طيطوي أوروبي كبير ذو أرجل مخضرة)",
 "greensick": "شاحب, يخضوري (من أو متعلق بـ أو يعاني من اليخضور (فقر دم يسبب شحوب مخضر))",
 "greensickness": "داء الاخضرار, يرقان شاحب (فقر الدم الناجم عن نقص الحديد لدى الشابات؛ يتميز بالضعف واضطرابات الدورة الشهرية ولون أخضر للجلد)",
 "greenside": "بجانب المسطح الأخضر (مجاور للمسطح الأخضر (في الجولف))\nمثال: حفرة رملية بجانب المسطح الأخضر",
 "greenskeeper": "مَسْؤُول المَلاعِب الخَضْراء, مُشْرِف مَلْعَب الجُولْف (شخص مسؤول عن صيانة ملعب الجولف والعناية بعشبه)",
 "greenstick fracture": "كسر الغصن النضير (كسر جزئي للعظم (عادة عند الأطفال)؛ ينحني العظم ولكنه ينكسر من جانب واحد فقط)",
 "greensward": "طبقة عشبية, عشب (طبقة سطحية من الأرض تحتوي على حصير من العشب وجذوره)",
 "greenway": "حزام أخضر (حزام من المتنزهات أو الأراضي الريفية المحيطة ببلدة أو مدينة)",
 "greenweed": "جنيستا الصباغين, وزال الصباغين (شجيرة أوراسية صغيرة لها عناقيد من الزهور الصفراء التي تنتج صبغة؛ شائعة كعشب ضار في بريطانيا والولايات المتحدة؛ تزرع أحياناً للزينة)",
 "greenwich": "غْرِينِيتْش",
 "greenwich mean time": "التوقيت العالمي, توقيت غرينتش (التوقيت المحلي عند خط الصفر المار عبر غرينتش، إنجلترا؛ وهو نفسه في كل مكان)",
 "greenwich time": "التوقيت العالمي, توقيت غرينتش (التوقيت المحلي عند خط الصفر المار عبر غرينتش، إنجلترا؛ وهو نفسه في كل مكان)",
 "greenwing": "حذف أخضر الجناح (بط صغير شائع في أوراسيا وأمريكا الشمالية)",
 "greenwood": "غابة خضراء (أراضي حرجية مكتملة الأوراق)",
 "greet": "حَيَّا",
 "greeter": "مُرَحِّب, مُسْتَقْبِل (شخص يقوم بالترحيب)\nمثال: استقبل القادمين الجدد مرحبون مبتسمون",
 "greeting": "تَحِيَّة (مصدر للفعل \"حَيَّا\"؛ عبارة لفظية أو جسدية تُبدأ بها الرسالة أو المحادثة غرضها التعريف عن وجود قائلها)\nمثال: ألقى زيري تحية.",
 "greeting card": "بطاقة تهنئة, بطاقة معايدة (بطاقة تُرسل للتعبير عن تحيات شخصية)",
 "gregarine": "جريجارين (أوالي دودية الشكل تتطفل على الحشرات واللافقاريات الأخرى)",
 "gregarious": "اِجْتِمَاعِيّ (إنسان اجتماعيّ: لهُ فِطْرَةٌ تَمِيلُ إِلَى مُعَاشَرَةِ النَّاسِ فِي الْمُجْتَمَعِ والاخْتِلاَطِ بِهِمْ؛ نسبة إلى اجتماع أو مُجْتَمَع، خَاصّ بجَماعة بَشرية أو بالمُجتمع)\nمثال: هذا هو مسلسلي الاجتماعي المفضل.",
 "gregariously": "بألفة, باجتماعية (بطريقة اجتماعية ومحبة للمخالطة)",
 "gregariousness": "أنيسية, حب الاجتماع (صفة كون المرء اجتماعياً — كره البقاء وحيداً)",
 "gregorian": "غريغوري, ميلادي (من أو متعلق بالبابا غريغوري الثالث عشر أو التقويم الذي قدمه عام 1582) / غريغوري (من أو متعلق بالبابا غريغوري الأول أو بترتيل الألحان في الكنيسة الكاثوليكية)",
 "gregorian calendar": "التَقْوِيم الغَرْبِيّ, التَقْوِيم المِيلَادِيّ",
 "gregorian calendar month": "شهر ميلادي (شهر في التقويم الميلادي (الغريغوري))",
 "gregorian chant": "ترتيل غريغوري (نوع من الغناء البسيط سُمي تيمناً بالبابا غريغوري الأول)",
 "gregorian mode": "مقام كنسي (أي من نظام المقامات المستخدمة في التراتيل الغريغورية حتى عام 1600؛ مشتق تاريخياً من المقام اليوناني)",
 "gregorian telescope": "تلسكوب كاسيجرين, مقراب كاسيجرين (تلسكوب عاكس يحتوي على مرآة أولية مكافئة ومرآة ثانوية زائدة؛ ويتم تجميع الضوء في بؤرة من خلال فتحة في وسط المرآة الأولية)",
 "gregory": "غِرِيغُورِي, جِرِيجُورِي",
 "greisen": "غرايزن (صخر جرانيتي يتكون من الكوارتز والميكا)",
 "gremlin": "بيكسي, عفريت ((فلكلور) جنيات تميل للمشاغبة)",
 "grenada": "غْرِينَادَا, جْرِينَادَا",
 "grenada dollar": "دولار غرينادا (وحدة المال الأساسية في غرينادا)",
 "grenade": "قُنْبُلَة, قُنْبُلَة يَدَوِيَّة",
 "grenade launcher": "بندقية قاذفة (أنبوب لاطلاق الرصاص، وتعتبر من الأسلحة؛ الْبُنْدُقِيََة: فِي إِيطَالْيَا)\nمثال: البندقية مدينة جميلة.",
 "grenade thrower": "رامي القنابل, غرينادير (جندي مشاة مجهز بقنابل يدوية)",
 "grenadian": "غرينادي (من أو متعلق أو مميز لغرينادا أو سكانها) / غرينادي (مواطن أو ساكن في غرينادا)\nمثال: العاصمة الغرينادية",
 "grenadier": "جرينادير, ذيل الجرذ (سمكة أعماق ذات رأس وجسم كبيرين وذيل طويل مستدق) / رامي القنابل, غرينادير (جندي مشاة مجهز بقنابل يدوية)",
 "grenadine": "غرينادين (شراب رقيق مصنوع من عصير الرمان؛ يستخدم في المشروبات المختلطة)",
 "gres-gris": "تميمة أفريقية (تميمة ذات أصل أفريقي)",
 "gresham's law": "قانون جريشام ((اقتصاد) المبدأ القائل بأنه عندما يكون هناك نوعان من المال لهما نفس القيمة الاسمية في التداول، سيتم اكتناز المال الأكثر قيمة جوهريًا وسيدور المال…)",
 "gretel": "غْرِيتِل, جْرِيتِل",
 "grevillea": "جريفيليا (أي شجيرة أو شجرة من جنس جريفيليا)",
 "grevillea banksii": "بلوط حريري أحمر الأزهار (شجيرة طويلة بعناقيد أسطوانية من الزهور الحمراء وأوراق ريشية حريرية ورمادية من الأسفل؛ شرق أستراليا)",
 "grevillea parallela": "بلوط فضي (شجرة نحيلة صغيرة بأوراق متدلية خضراء رمادية كاملة عادة وزهور بيضاء أو كريمية اللون؛ شمال أستراليا)",
 "grevillea robusta": "بلوط حريري (شجرة متوسطة إلى طويلة سريعة النمو بزهور برتقالية وأوراق ريشية ثنائية ريشية حريرية الشعر من الأسفل؛ شرق أستراليا)",
 "grevillea striata": "خشب اللحم (شجرة تنتج خشباً محمراً ثقيلاً صلباً)",
 "grevy's zebra": "حمار زرد غريفي (حمار زرد بخطوط أقل استمراراً)",
 "grewia asiatica": "غرويا, فالسا (شجيرة شجرية آسيوية مقاومة للجفاف تحمل ثماراً حمراء صغيرة حمضية بشكل لطيف صالحة للأكل تستخدم عادة في المشروبات)",
 "grey": "رَمَادِيّ (بلون لا لوني متوسط بين الأبيض والأسود) / رَمَادِيّ, ضَبَابِيّ (وَسَطٌ فِي الطَّبِيعَةِ أَوِ المَوْقِعِ؛ غَيْرُ وَاضِحِ المَعَالِمِ) / رَمَادِيّ (يُستخدم للدلالة على قوات الكونفدرالية في الحرب الأهلية الأمريكية (الذين ارتدوا زيّاً رمادياً)) / أَشْيَب, شَائِب (يُظهِر علامات الشيخوخة خاصّة الشعر الأبيض أو الرماديّ)",
 "grey alder": "نغت رمادي (موطنه أوروبا ولكن أدخل إلى أمريكا)",
 "grey area": "منطقة رمادية (منطقة وسطى؛ موضوع ليس شيئاً واحداً بوضوح ولا الآخر)",
 "grey birch": "بتولا رمادية (بتولا متوسطة الحجم من شرق أمريكا الشمالية لها لحاء أبيض أو رمادي شاحب وخشب قليل القيمة؛ توجد غالباً كشجرة غابات ثانوية النمو)",
 "grey body": "جسم رمادي (جسم يبعث إشعاعاً بنسبة ثابتة مقارنة بإشعاع الجسم الأسود المقابل)\nمثال: المصدر ذو الانبعاثية المنخفضة المستقلة عن التردد غالباً ما يشار إليه بالجسم الرمادي",
 "grey catbird": "طائر المواء (طائر مغرد من أمريكا الشمالية يشبه نداءه مواء القطة)",
 "grey flounder": "فلو ندر رمادي (سمكة مفلطحة توجد من كارولينا الشمالية إلى فلوريدا وشرق خليج المكسيك)",
 "grey fox": "ثعلب رمادي (ثعلب أمريكي رمادي داكن؛ من أمريكا الوسطى عبر جنوب الولايات المتحدة)",
 "grey friar": "راهب رمادي, فرنسيسكاني (راهب روماني كاثوليكي يرتدي الزي الرمادي للرهبنة الفرنسيسكانية)",
 "grey goldenrod": "عصا الذهب الرمادية (عشبة صباغين في كندا وشرق الولايات المتحدة ذات أزهار صفراء تستخدم أحياناً في الصباغة)",
 "grey hen": "دجاجة الطيهوج الرمادية (أنثى الطيهوج الأسود)",
 "grey jackal": "ذئب ذهبي أفريقي (حيوان من فصيلة الكلبيات يعيش في صحاري شمال أفريقيا ويرتبط بابن آوى الذهبي والذئب الرمادي)",
 "grey jay": "قيق كندي (قيق من شمال أمريكا الشمالية ذو رأس أسود القبعة وبدون عرف؛ يشتهر بجرأته في السرقة)",
 "grey kingbird": "ملك الطيور الرمادي (طائر يتكاثر في جنوب شرق الولايات المتحدة ويشتي في أمريكا الاستوائية؛ يشبه ملك الطيور الشرقي ولكنه أكبر حجماً)",
 "grey lemming": "لاموس رمادي (لاموس من العالم القديم)",
 "grey market": "سوق رمادية (سوق غير رسمية يتم فيها شراء وبيع السلع بأسعار أقل من السعر الرسمي الذي حددته وكالة تنظيمية)",
 "grey matter": "مادة رمادية, مادة سنجابية (نسيج عصبي رمادي يحتوي على أجسام الخلايا والألياف؛ يشكل القشرة المخية المكونة من عصبونات غير مغلفة بالمايلين)",
 "grey mullet": "بوري, بوري رمادي (أسماك غذائية تعيش في المياه العذبة أو الساحلية ذات جسم مغزلي الشكل؛ توجد في جميع أنحاء العالم) / بوري, بوري رمادي (لحم عالي القيمة قليل الدهن للبوري البحري أو النهري)",
 "grey partridge": "حجل رمادي (حجل أوروبي شائع)",
 "grey polypody": "بوليبودي رمادي, سرخس القيامة (سرخس ينمو على الصخور أو جذوع الأشجار وله سعف رمادي وحرشفي من الأسفل؛ الأمريكتين وجنوب أفريقيا)",
 "grey poplar": "حور رمادي (حور كبير سريع النمو بأوراق مسننة مفصصة بشكل خافت رمادية على السطح السفلي؛ موطنه أوروبا ولكنه أدخل وتوطن في أماكن أخرى)",
 "grey sage": "شيح فضي, ميرمية فضية (نبات معمر منخفض كثير التفرع في غرب الولايات المتحدة ذو أوراق فضية؛ نبات علف ومأوى مهم)",
 "grey sea eagle": "عقاب البحر أبيض الذيل (عقاب ضخم بني رمادي بذيل أبيض قصير وتدي الشكل؛ من أوروبا وجرينلاند)",
 "grey skate": "ورنك رمادي (ورنك أوروبي شائع يستخدم كطعام)",
 "grey snapper": "نهاش رمادي (يوجد في المياه الضحلة قبالة ساحل فلوريدا)",
 "grey sole": "سمك موسى الرمادي (لحم أبيض مائل للرمادي لسمكة مفلطحة)",
 "grey substance": "مادة رمادية, مادة سنجابية (نسيج عصبي رمادي يحتوي على أجسام الخلايا والألياف؛ يشكل القشرة المخية المكونة من عصبونات غير مغلفة بالمايلين)",
 "grey whale": "حوت رمادي (حوت متوسط الحجم رمادي مسود يعيش في شمال المحيط الهادئ)",
 "grey willow": "صفصاف رمادي (صفصاف شجيري أوراسي بأغصان وبرية بيضاء)",
 "grey wolf": "ذئب الغياض, ذئب رمادي (ذئب ذو معطف رمادي مبقع يعيش في المناطق الشمالية المشجرة في أمريكا الشمالية)",
 "grey-black": "أَسْوَد رَمَادِيّ (أسود مع مسحة رمادية)",
 "grey-blue": "أَزْرَق رَمَادِيّ (أزرق مع مسحة رمادية)",
 "grey-brown": "بُنِّيّ رَمَادِيّ (بني مع مسحة رمادية)",
 "grey-green": "أَخْضَر رَمَادِيّ (أخضر مع مسحة رمادية)",
 "grey-haired": "أَشْيَب",
 "grey-headed": "أَشْيَب, شَائِب (يُظهِر علامات الشيخوخة خاصّة الشعر الأبيض أو الرماديّ)",
 "grey-leaf pine": "صنوبر توري (صنوبر متوسط الحجم خماسي الإبر من جنوب غرب كاليفورنيا له مخاريط أسطوانية طويلة)",
 "grey-pink": "وَرْدِيّ رَمَادِيّ (وردي مع مسحة رمادية)",
 "grey-white": "أَبْيَض رَمَادِيّ (أبيض مع مسحة رمادية)",
 "greyback": "دريجة حمراء (طيطوي يتكاثر في القطب الشمالي ويشتي في نصف الكرة الجنوبي) / رمادية الظهر (طائر دويتشر ذو ظهر رمادي) / جوني ريب, متمرد (لقب أطلقه الجنود الفيدراليون على الجنود الكونفدراليين في الحرب الأهلية الأمريكية)",
 "greybeard": "إبريق ملتحي, بيلارمين (إبريق شرب خزفي ذو عنق طويل؛ مزين برسم كاريكاتوري للكاردينال بيلارمين) / رجل عجوز (رجل كبير جداً في السن)",
 "greyed": "خَافِت, مُطْفَأ (فاقد البريق واللمعان؛ خافت اللون)",
 "greyhen": "دجاجة الطيهوج الرمادية (أنثى الطيهوج الأسود)",
 "greyhound": "غريهاوند, كلب الصيد السريع (كلب طويل ونحيل من سلالة قديمة تشتهر بالسرعة والبصر الحاد؛ يستخدم ككلب سباق)",
 "greyhound racing": "سباق الكلاب السلوقية (رياضة سباق الكلاب السلوقية)",
 "greyish": "رَمَادِيّ (بلون لا لوني متوسط بين الأبيض والأسود)",
 "greyish brown": "أشهب, بني رمادي (لون أو صبغة تتراوح حول لون بني رمادي فاتح)\nمثال: ارتدت لوناً أشهب",
 "greyish-black": "أَسْوَد رَمَادِيّ (أسود مع مسحة رمادية)",
 "greyish-blue": "أَزْرَق رَمَادِيّ (أزرق مع مسحة رمادية)",
 "greyish-brown": "بُنِّيّ رَمَادِيّ (بني مع مسحة رمادية)",
 "greyish-green": "أَخْضَر رَمَادِيّ (أخضر مع مسحة رمادية)",
 "greyish-pink": "وَرْدِيّ رَمَادِيّ (وردي مع مسحة رمادية)",
 "greyish-white": "أَبْيَض رَمَادِيّ (أبيض مع مسحة رمادية)",
 "greylag": "إوز رمادي, إوزة ربداء (إوز بري رمادي شائع في أوروبا؛ سلف العديد من السلالات المستأنسة)",
 "greylag goose": "إوز رمادي, إوزة ربداء (إوز بري رمادي شائع في أوروبا؛ سلف العديد من السلالات المستأنسة)",
 "greyly": "برمادية, بلون رمادي (بمظهر رمادي)\nمثال: الجداول الوحيدة تبدو أرجوانية في الفجر، زرقاء كالسيف في الشمس، وفضية برمادية تحت الأقمار الضبابية",
 "greyness": "رمادي (لون لا لوني محايد وسط بين الأبيض والأسود)",
 "gri-gri": "ماكامبا, نخيل غروغرو (نخيل ريشي استوائي أمريكي له جذع شائك منتفخ ومكسرات صالحة للأكل)",
 "grias cauliflora": "إجاص الأنشوفة (شجرة من جزر الهند الغربية تحمل فاكهة صالحة للأكل تشبه المانجو)",
 "grid": "شَبَك, شَبَكَة / شَبَكَة كَهْرُبَاء / شَبَك",
 "grid metal": "معدن الشبكات (نوع من الرصاص الصلب يستخدم لشبكات بطاريات التخزين)",
 "griddle": "صاج, لوح طهي (أداة طهي تتكون من سطح ساخن مسطح (كما في الجزء العلوي من الموقد) يتم طهي الطعام عليه)",
 "griddlecake": "بان كيك, فطيرة المقلاة (كعكة مسطحة من عجين رقيق تقلى على كلا الجانبين على صاج) / بان كيك اسكتلندي, سكون القطرة (سكون يُصنع بصب ملعقة من العجين السائل على صاج)",
 "gridiron": "ملعب كرة قدم أمريكية (ملعب اللعب الذي تُلعب عليه كرة القدم الأمريكية) / شواية شبكية (أداة طهي من قضبان معدنية متوازية؛ تستخدم لشواء السمك أو اللحم)",
 "gridiron-tailed lizard": "سحلية حمار الزرد (سحلية سريعة ذات ذيل طويل مخطط بالأسود وأرجل طويلة؛ من صحاري الولايات المتحدة والمكسيك)",
 "gridlock": "جُمُود",
 "grief": "غَمّ, حُزْن",
 "grief-stricken": "ثَاكِل, مَفْجُوع (حزين بسبب فقدان أو حرمان)",
 "grievance": "مَظْلَمَة",
 "griever": "ثاكِل, حَزِين (شخص يشعر بالحزن (خاصة الحزن على شخص مات))",
 "grieving": "ثَاكِل, مَفْجُوع (حزين بسبب فقدان أو حرمان)",
 "grievous": "جَسِيم, خَطِير (يُثير الخوف أو القلق بتهديده بأذى عظيم) / شَنِيع, فَظِيع (بالغ الوحشية أو القسوة بشكل صادم) / ثَقِيل, خَطِير (بالغ الخطورة أو حاسم؛ يستدعي تفكيرًا جادًّا) / مُحْزِن, مُفْجِع (يسبب أو يتسم بالحزن الشديد أو الكرب)",
 "grievous bodily harm": "إكستاسي سائل, غوب (أسماء دارجة لـ جاما هيدروكسي بيوتيريت)",
 "grievously": "بشدة, بشكل فادح (بطريقة مؤلمة أو خطيرة)\nمثال: ألمانيا الصامدة ولكن غير المكسورة، الجريحة بشكل فادح ولكنها بعيدة عن الدمار، كانت قادرة على إرساء أسس راسخة للنهضة العسكرية",
 "griffin": "فَتْخَاء",
 "griffon": "نسر أسمر (نسر كبير من جنوب أوروبا وشمال أفريقيا ذو ريش شاحب وأجنحة سوداء) / غريفون (سلالة من الكلاب متوسطة الحجم طويلة الرأس ذات طبقة تحتية زغبية وطبقة خارجية خشنة سلكية؛ نشأت في هولندا ولكن طورت بشكل كبير في فرنسا) / غريفون, غريفون بروكسل (سلالة من الكلاب الصغيرة جداً المدمجة ذات الشعر السلكي من أصل بلجيكي ولها خطم ملتح قصير) / غريفين, فتخاء (وحش مجنح برأس نسر وجسم أسد)",
 "griffon vulture": "نسر أسمر (الكشط والجرح والنقب؛ طَيْر من الجَوَارِح أكبرها حجما يقتات الجِيَف وله منقار معقوف)\nمثال: الصغر أسرع من النسر",
 "grifola frondosa": "دجاجة الغابة, فطر دجاجة الغابة (فطر كبير صالح للأكل بني رمادي يشكل كتلة من القبعات المتداخلة تشبه الدجاجة إلى حد ما عند قاعدة الأشجار)",
 "grifter": "محتال, نصاب (شخص يحتال عليك عن طريق الخداع أو الغش)",
 "grigori aleksandrovich potemkin": "بوتيمكين, غريغوري بوتيمكين (ضابط وسياسي روسي كان مفضلاً لدى كاترين الثانية (1739-1791))",
 "grigori potemkin": "بوتيمكين, غريغوري بوتيمكين (ضابط وسياسي روسي كان مفضلاً لدى كاترين الثانية (1739-1791))",
 "grigori potyokin": "بوتيمكين, غريغوري بوتيمكين (ضابط وسياسي روسي كان مفضلاً لدى كاترين الثانية (1739-1791))",
 "grigri": "تميمة أفريقية (تميمة ذات أصل أفريقي)",
 "grill": "شواية / مُصَبَّع / مِشْوَاة / شِوَاء / مَشْوِيَّات / شَوَى, يَشْوِي",
 "grille": "شواية (هيكل من القضبان المعدنية يستخدم كحاجز أو شبكة) / شبكة المبرد (شبكة تسمح بدخول هواء التبريد إلى مبرد السيارة) / شباك صغير, كوة (فتحة صغيرة (مثل نافذة في باب) يمكن من خلالها إجراء المعاملات)\nمثال: طهى الهامبرغر على الشواية",
 "grilled": "مَشْوِيّ (مَطْهُوٌّ عَلَى الشَّوَّايَة) / مَشْوِيٌّ بِالحَرَارَة (مَطْهُوٌّ بِالحَرَارَةِ المُشِعَّةِ كَمَا عَلَى الشَّوَّايَة)",
 "grilled cheese": "جبن مشوي (شطيرة مشوية حشوتها الأساسية الجبن)",
 "grilling": "شوي (الطهي بالتعرض المباشر للحرارة المشعة (كما فوق نار أو تحت شواية))",
 "grillroom": "مشواة, مطعم مشويات (مطعم يتم فيه طهي الطعام على الشواية)",
 "grillwork": "شواية (هيكل من القضبان المعدنية يستخدم كحاجز أو شبكة) / شبك معدني, شبكة سلكية (شبكة مصنوعة من الأسلاك)\nمثال: طهى الهامبرغر على الشواية",
 "grim": "بَشِع, مَكَابِرِيّ (منفّر بشكل صادم؛ يثير الرعب والاشمئزاز) / قَاتِم, كَئِيب (يبعث على الحزن والكآبة) / كَئِيب, مُكْتَئِب (مَمْلُوءٌ بِالكَآبَةِ وَالقُنُوط) / صَارِم, لَا يَرْحَم (لا يمكن استرضاؤه أو ثَنيه بالتوسّل)",
 "grim reaper": "حِفَاف الْأَرْوَاح",
 "grimace": "تجهم, تكشيرة (تعبير وجهي ملتوي)\nمثال: قامت بتجهم عند التفكير في الأمر",
 "grime": "دنس, قذارة (أي شيء يعتبر جاعلاً للشيء غير نظيف)",
 "grimes' golden": "تفاح غرايمز الذهبي (تفاح أصفر ينضج في أواخر الخريف؛ يؤكل نيئًا)",
 "griminess": "اتساخ, تلطخ (حالة كون الشيء متسخاً)",
 "grimly": "بشكل كئيب, بصرامة (بطريقة صارمة لا هوادة فيها)\nمثال: كان راضياً بصرامة",
 "grimm's law": "قانون غريم (قانون صوتي يربط بين الحروف الساكنة الألمانية والحروف الساكنة في اللغات الهندو أوروبية الأخرى)",
 "grimness": "شدة, صعوبة (شيء يصعب تحمله) / بَشَاعَة, شَنَاعَة (صفة كون الشيء مروعاً أو بشعاً)\nمثال: قسوة شتاء الشمال",
 "grimoire": "غريموار, كتاب تعاويذ (دليل للسحر الأسود (لاستحضار الأرواح والشياطين))",
 "grimy": "مُتَرَبِّب, وَسِخ جِدًّا (مُغطّى بطبقة سميكة من الأوساخ أو السُّخام المتراكم)",
 "grin": "ابتسامة (تعبير وجهي يتميز برفع زوايا الفم؛ يظهر عادة السعادة أو التسلية)",
 "grind": "طَحَنَ (طَحَنَ؛ طِحْنٌ)",
 "grind organ": "أرغن أسطواني, أرغن يدوي (آلة موسيقية تصدر الموسيقى عن طريق دوران أسطوانة مرصعة بأوتاد)",
 "grindelia robusta": "غرندلية قوية (عشبة صمغية معمرة من كاليفورنيا وباجا كاليفورنيا)",
 "grindelia squarrosa": "عشبة الصمغ مجعدة الكأس (عشبة صمغية معمرة من غرب ووسط أمريكا الشمالية)",
 "grinder": "آلة تجليخ, جلاخة (أداة آلية تلمع المعدن) / طاحونة, مطحنة (آلات تعالج المواد عن طريق الطحن أو السحق) / رحى, ضرس (سن طاحنة ذات تاج عريض؛ تقع خلف الضواحك) / سابمارين, سندويتش غواصة (شطيرة كبيرة مصنوعة من لفافة خبز طويلة مقسومة طولياً ومحشوة باللحوم والجبن (والطماطم والبصل والخس والتوابل))",
 "grinding": "صرير, طحن (صوت خشن وحاد (مثل صوت طحن التروس)) / سحالة, نحاتة (المادة الناتجة عن عملية الطحن) / تآكل, سحج (تآكل جزيئات الصخور عن طريق الاحتكاك بسبب الماء أو الرياح أو الجليد)\nمثال: سحالة الخضروات سدت المصرف",
 "grinding wheel": "حجر جلخ, عجلة تجليخ (عجلة مكونة من مادة كاشطة؛ تستخدم للتجليخ)",
 "grindle": "مقوسة الزعنفة (سمكة بدائية طويلة الجسم آكلة للحوم تعيش في المياه العذبة ولها زعنفة ظهرية طويلة جداً؛ توجد في المياه الراكدة في أمريكا الشمالية)",
 "grindstone": "مِجْلَخَة, جَلَّاخَة",
 "gringo": "غرينغو (مصطلح (ازدرائي) في أمريكا اللاتينية للأجانب (وخاصة الأمريكيين والإنجليز))",
 "grinner": "مُبْتَسِم ابْتِسَامَة عَرِيضَة (شخص يبتسم ابتسامة عريضة)",
 "grinning": "ابتسامة (تعبير وجهي يتميز برفع زوايا الفم؛ يظهر عادة السعادة أو التسلية)",
 "griot": "راوٍ أفريقي, غريو (راوي قصص في غرب أفريقيا؛ يخلد التقاليد الشفهية للعائلة أو القرية)",
 "grip": "مَقْبِض",
 "gripe": "تذمر, شكوى (مصطلحات غير رسمية للاعتراض)\nمثال: لدي شكوى بخصوص الخدمة هنا",
 "gripes": "مغص (ألم حاد في البطن (خاصة عند الرضع))",
 "griping": "مغص (ألم حاد في البطن (خاصة عند الرضع))",
 "grippe": "أنفلونزا, نزل وافدة (مرض فيروسي حموي شديد العدوى)",
