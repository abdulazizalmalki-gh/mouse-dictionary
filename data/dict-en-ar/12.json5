 "ground rule": "قَاعِدَة الْمَلْعَب ((البيسبول) قاعدة خاصة تتعامل مع المواقف التي تنشأ بسبب طبيعة أرضية الملعب)",
 "ground sloth": "كسلان أرضي (ثديي أرضي عملاق منقرض شبيه بالكسلان عاش في العصرين البليوسيني والبليستوسيني في أمريكا)",
 "ground snake": "ثعبان الأرض (ثعبان أرضي صغير خجول ذو حلقات زاهية من المناطق القاحلة أو شبه القاحلة في غرب أمريكا الشمالية)",
 "ground squirrel": "سنجاب الأرض (أي من قوارض أرضية متنوعة تحفر الجحور في العالمين القديم والجديد؛ غالباً ما تدمر المحاصيل) / صيدناني شرقي (سنجاب أمريكي شرقي صغير مخطط شبه أرضي ذو جيوب خدية)",
 "ground state": "حالة أرضية, حالة قاعية ((فيزياء) حالة الطاقة الأدنى لذرة أو جسيم آخر)",
 "ground stroke": "ضربة أرضية (رد تنس يتم بضرب الكرة بعد ارتدادها مرة واحدة)",
 "ground substance": "جبلة شفافة, هيالوبلازم (الجزء الشفاف غير الحبيبي من سيتوبلازم الخلية) / مادة خلالية, مصفوفة (مادة الجسم التي تنغمس فيها خلايا الأنسجة)",
 "ground swell": "تموج عميق, موج عظيم (تموج واسع وعميق للمحيط) / تحول في الرأي العام, موجة تأييد (تغير واضح في الرأي العام أو المشاعر السياسية يحدث دون قيادة أو تعبير صريح)\nمثال: كانت هناك موجة تأييد للمشاعر المناهضة للحرب",
 "ground tackle": "مرساة (جهاز ميكانيكي يمنع السفينة من التحرك)",
 "ground water": "مياه جوفية (مياه تحت الأرض محتجزة في التربة وفي الصخور المنفذة)",
 "ground wave": "موجة أرضية (موجة راديوية تنتشر على أو بالقرب من سطح الأرض)",
 "ground zero": "نقطة الانفجار, نقطة الصفر (نقطة تفجير سلاح نووي (أو فوقها أو تحتها)) / نقطة الصفر, نقطة الهدف (هدف قذيفة (مثل قنبلة أو صاروخ))",
 "ground-berry": "توت الشاي, عنب الأرض (شجيرة زاحفة من شرق أمريكا الشمالية لها زهور بيضاء جرسية الشكل تليها ثمار حمراء تشبه التوت حارة وأوراق عطرية لامعة تنتج زيت الوينترغرين) / توت الأرض, توت بري أصلي (شجيرة صغيرة منبطحة أو صاعدة ذات أزهار قرمزية وثمار عصارية تشبه التوت البري)",
 "ground-controlled approach": "اقتراب موجه من الأرض (هبوط طائرة في طقس سيء يتم فيه توجيه الطيار من قبل المراقبة الأرضية باستخدام الرادار الدقيق)",
 "ground-effect machine": "حوامة (مركبة قادرة على التحرك فوق الماء أو الأرض على وسادة هوائية تنشأ بواسطة محركات نفاثة)",
 "ground-emplaced mine": "فخ مفخخ, لغم أرضي (لغم متفجر مخبأ تحت الأرض؛ ينفجر عند الدوس عليه أو القيادة فوقه)",
 "ground-floor": "فِي الطَّابِقِ الأَرْضِيّ (فِي الطَّابِقِ الأَقْرَبِ إِلَى مُسْتَوَى سَطْحِ الأَرْض)",
 "ground-hugging": "زَاحِف, مُنْبَطِح النُّمُوّ (من النباتات التي تنمو قريبة من سطح الأرض نسبيّاً)",
 "ground-service crew": "طاقم أرضي (طاقم الفنيين والميكانيكيين الذين يخدمون الطائرات على الأرض)",
 "ground-shaker": "سيسموصور (ديناصور عاشب ضخم من العصر الطباشيري وجد في غرب أمريكا الشمالية)",
 "groundball": "ضربة أرضية, كرة أرضية ((بيسبول) ضربة تسير على الأرض)",
 "groundberry": "توت الشاي, عنب الأرض (شجيرة زاحفة من شرق أمريكا الشمالية لها زهور بيضاء جرسية الشكل تليها ثمار حمراء تشبه التوت حارة وأوراق عطرية لامعة تنتج زيت الوينترغرين) / توت الأرض, توت بري أصلي (شجيرة صغيرة منبطحة أو صاعدة ذات أزهار قرمزية وثمار عصارية تشبه التوت البري)",
 "groundbreaker": "رائد, سبّاق (شخص يساعد في فتح مجال جديد للبحث أو التكنولوجيا أو الفن)",
 "groundbreaking": "رَائِد",
 "groundbreaking ceremony": "وضع حجر الأساس (الكسر الاحتفالي للأرض لبدء مشروع بناء رسميًا)",
 "groundcover": "غطاء أرضي حرجي (نباتات صغيرة غير الشتلات تنمو على أرضية الغابة) / غطاء أرضي, نباتات غطائية (نباتات منخفضة النمو تُزرع في الظل العميق أو على منحدر حاد حيث يصعب نمو العشب)",
 "grounder": "ضربة أرضية, كرة أرضية ((بيسبول) ضربة تسير على الأرض)",
 "groundfish": "سمك القاع (الأسماك التي تعيش في قاع البحر (خاصة أسماك القد المهمة تجارياً مثل القد والحدوق، أو الأسماك المفلطحة مثل الفلوندر))",
 "groundhog": "جرذ الأرض, مرموط خنزيري (مرموط بني محمر من أمريكا الشمالية)",
 "groundhog day": "2 فبراير, يوم جرذ الأرض (إذا خرج جرذ الأرض ورأى ظله في هذا اليوم، فسيكون هناك 6 أسابيع أخرى من الشتاء)",
 "grounding": "تأريض (توصيل المعدات الكهربائية بالأرض) / أساس, تأسيس (التعليم أو التوجيه في أساسيات مجال من مجالات المعرفة)\nمثال: يفتقر إلى التأسيس اللازم للدراسة المتقدمة",
 "groundkeeper": "حارس الحديقة, مسؤول الملاعب (شخص يحافظ على الأراضي (في عقار أو حديقة أو ملعب رياضي))",
 "groundless": "لَا أَسَاس لَه, وَاهٍ (بدون أساس في العقل أو الواقع)",
 "groundlessness": "بُطْلَان, لَا أَسَاس (صفة الافتقار إلى الجوهر أو القيمة)\nمثال: تم التعرف بسرعة على بطلان تقريرهم",
 "groundling": "مشاهد الوقوف (في المسرح الإليزابيثي: مرتاد مسرح في قسم الوقوف الرخيص)",
 "groundmass": "الكتلة الأساسية, المصفوفة الصخرية ((جيولوجيا) مصفوفة من مادة بلورية ناعمة الحبيبات تكون البلورات الأكبر مغمورة فيها)",
 "groundnut": "فستق عبيد, فول سوداني (قرن كرمة الفول السوداني يحتوي عادة على حبتين أو بذرتين) / فول سوداني (درنة تشبه الجوز؛ طعام مهم للأمريكيين الأصليين) / أبيوس, بطاطس هندية (كرمة من أمريكا الشمالية ذات أزهار عطرة ودرنات صالحة للأكل؛ محصول غذائي مهم للأمريكيين الأصليين)",
 "groundnut oil": "زيت الفول السوداني (زيت مستخرج من الفول السوداني؛ يُستخدم في الطهي وصنع الصابون)",
 "groundnut vine": "أبيوس, بطاطس هندية (كرمة من أمريكا الشمالية ذات أزهار عطرة ودرنات صالحة للأكل؛ محصول غذائي مهم للأمريكيين الأصليين)",
 "grounds": "باحة, ساحة (الأرض المسيجة المحيطة بمنزل أو مبنى آخر) / أساس, بينة (أساس الاعتقاد أو عدم التصديق؛ المعرفة التي يبنى عليها الاعتقاد) / سبب, مبرر (مبرر لوجود أو حدوث شيء ما) / أرض, ساحة (قطعة أرض تم تنظيفها لأغراض خاصة (مثل الترفيه أو الدفن إلخ))\nمثال: كان منزلاً صغيراً بلا فناء تقريباً",
 "groundsel": "لُبَيْنَة, شَيْخَة",
 "groundsel bush": "باخاريس, شجيرة الشيخ (شجيرة من المستنقعات المالحة في شرق وجنوب وسط أمريكا الشمالية وجزر الهند الغربية؛ الثمرة محاطة بخصل شعرية بيضاء تشبه الريش)",
 "groundsel tree": "باخاريس, شجيرة الشيخ (شجيرة من المستنقعات المالحة في شرق وجنوب وسط أمريكا الشمالية وجزر الهند الغربية؛ الثمرة محاطة بخصل شعرية بيضاء تشبه الريش)",
 "groundsheet": "غطاء أرضي, مفرش أرضي (قطعة قماش مقاومة للماء تفرش على الأرض (كما تحت الخيمة) للحماية من الرطوبة)",
 "groundskeeper": "حارس الحديقة, مسؤول الملاعب (شخص يحافظ على الأراضي (في عقار أو حديقة أو ملعب رياضي))",
 "groundsman": "مسؤول الملاعب (رجل يقوم بصيانة الأراضي (لعقار أو حديقة أو ملعب رياضي))",
 "groundspeed": "سُرْعَة أَرْضِيَّة (سرعة الطائرة بالنسبة للأرض)",
 "groundswoman": "مسؤولة ملاعب (امرأة تحافظ على الأراضي (في عقار أو حديقة أو ملعب رياضي))",
 "groundwater": "مِيَاه جَوْفِيَّة",
 "groundwater level": "مستوى الماء, منسوب المياه الجوفية (السطح تحت الأرضي الذي تكون الأرض تحته مشبعة بالكامل بالماء)\nمثال: أمطار الربيع رفعت منسوب المياه الجوفية",
 "groundwater pump": "مضخة غاطسة, مضخة مياه جوفية (مضخة مناسبة لأخذ العينات وضخ إمدادات المياه الجوفية)",
 "groundwork": "أساس, عمل تمهيدي (إعداد أولي كأساس أو قاعدة) / أساس (أدنى دعامة لهيكل ما) / أساس, حجر الزاوية (الافتراضات الأساسية التي يبدأ منها شيء ما أو يتطور أو يُحسب أو يُشرح)\nمثال: نحن مستعدون اليوم بسبب العمل التمهيدي الذي تم قبل عشر سنوات",
 "group": "مَجْمُوعَة, جَمَاعَة (مؤنث مَجْمُوع وهو اسم مفعول من جَمَعَ؛ الطَائِفَة أو الجَمَاعَة من الناس)\nمثال: شكرا لإضافتي للمجموعة.",
 "group 14 element": "عنصر المجموعة 14, عنصر مجموعة الكربون (أي عنصر كيميائي ينتمي إلى مجموعة الكربون)\nمثال: الكربون، أخف عناصر مجموعة الكربون، يتسامى عند 3825 درجة مئوية",
 "group action": "عَمَل جَمَاعِيّ (إجراء يتّخذه مجموعة من الناس)",
 "group captain": "قائد مجموعة (ضابط مفوض (خاصة في سلاح الجو الملكي) يعادل رتبة عقيد في الجيش)",
 "group discussion": "حلقة نقاش, مؤتمر (مناقشة بين المشاركين لديهم موضوع (جاد) متفق عليه)",
 "group dynamics": "ديناميكيات الجماعة (فرع علم النفس الاجتماعي الذي يدرس الديناميكيات النفسية للتفاعل في المجموعات الاجتماعية)",
 "group insurance": "تأمين جماعي (تأمين تشتريه مجموعة (مثل موظفي شركة) عادة بسعر مخفض للأعضاء الأفراد في المجموعة)",
 "group meeting": "اِجْتِمَاع, لِقَاء (تجمع يتم ترتيبه رسمياً)\nمثال: سيكون الاجتماع العام المقبل في شيكاغو",
 "group of death": "مَجْمُوعَة الْمَوْت (مؤنث مَجْمُوع وهو اسم مفعول من جَمَعَ؛ الطَائِفَة أو الجَمَاعَة من الناس)\nمثال: شكرا لإضافتي للمجموعة.",
 "group participation": "مُشَارَكَة جَمَاعِيَّة (مشاركة من قبل جميع أعضاء المجموعة)",
 "group practice": "عيادة جماعية, ممارسة جماعية ((طب) ممارسة الطب من قبل مجموعة من الأطباء يتشاركون في المبنى والموارد الأخرى)",
 "group psychotherapy": "علاج جماعي (علاج نفسي تلتقي فيه مجموعة صغيرة من الأفراد مع معالج؛ تعتبر التفاعلات بين الأعضاء علاجية)",
 "group sex": "جِنْس جَمَاعِيّ (الجَمَاعَة أو المَجْمُوعَة الواحدة التي لها صفات تجعلها تنتمي إلى بعض تسمى جِنْسا وهو أعمُّ من النَوْع. ليس للجنس أو النوع ما يحددهما فالبشر كلهم جنس…؛ أحيانا يقصد به ذكر أم أنثى تحديدا)\nمثال: أنا مثلي الجنس.",
 "group theory": "نظرية الزمر (فرع الرياضيات الذي يتعامل مع الزمر)",
 "group therapy": "علاج جماعي (علاج نفسي تلتقي فيه مجموعة صغيرة من الأفراد مع معالج؛ تعتبر التفاعلات بين الأعضاء علاجية)",
 "group velocity": "سرعة الزمرة",
 "grouped": "مُجَمَّع, مُرَتَّب (تمّ تجميعه أو فرزه في مجموعات)",
 "grouper": "هامور, وقار (أسماك قاعية منعزلة عادة من عائلة القاروص تعيش في البحار الدافئة) / سمك الهامور, هامور (لحم سمكة مياه مالحة مشابهة لسمك القاروص)",
 "groupie": "مُعْجَبَة (معجبة شابة متحمسة (خاصة التي تتبع فرق الروك))",
 "grouping": "تَجَمُّع, مَجْمُوعَة (أيّ عدد من الكيانات (الأعضاء) يُعتبَر وحدة واحدة) / تجميع, تصنيف (نشاط جمع الأشياء معاً في مجموعات) / تجميع, تصنيف (نظام لتصنيف الأشياء إلى مجموعات)",
 "groupthink": "تفكير جماعي (اتخاذ القرار من قبل مجموعة (خاصة بطريقة تثبط الإبداع أو المسؤولية الفردية))",
 "groupware": "برمجيات تعاونية (برمجيات يمكن استخدامها من قبل مجموعة من الأشخاص يعملون على نفس المعلومات ولكن قد يكونون موزعين في أماكن مختلفة)",
 "grouse": "طَيْهُوج",
 "grouse whortleberry": "توت الطيهوج (شجيرة من شمال غرب أمريكا الشمالية تحمل توتاً أحمر)",
 "grouse-berry": "توت الطيهوج (شجيرة من شمال غرب أمريكا الشمالية تحمل توتاً أحمر)",
 "grouseberry": "توت الطيهوج (شجيرة من شمال غرب أمريكا الشمالية تحمل توتاً أحمر)",
 "grout": "روبة, ملاط سائل (ملاط رقيق يمكن صبه ويستخدم لملء الشقوق في البناء أو الطوب)",
 "grove": "بستان, غابة صغيرة (حديقة تتكون من خشب مزروع صغير بدون شجيرات سفلية) / أيكة, بستان (نمو صغير للأشجار بدون شجيرات تحتية)",
 "groveler": "خَنُوع, مُتَذَلِّل (شخص يذل نفسه كعلامة على الاحترام؛ يتصرف وكأنه بلا كرامة)",
 "groveling": "زَاحِف, مُتَذَلِّل (خَاضِع خُضُوعًا تَامًّا)",
 "groveller": "خَنُوع, مُتَذَلِّل (شخص يذل نفسه كعلامة على الاحترام؛ يتصرف وكأنه بلا كرامة)",
 "grovelling": "زَاحِف, مُتَذَلِّل (خَاضِع خُضُوعًا تَامًّا)",
 "grow": "نَمَى / كَبُرَ (قَوْلُ 'الله أكْبَر'؛ أَحَدَ أَرْكَان الصَلاَة: كَبَّرَ المُصَلِّي)\nمثال: ما مدى كبر المسافة بين هنا وهناك؟",
 "grow up": "كَبُرَ, ْنَشَأ (قَوْلُ 'الله أكْبَر'؛ أَحَدَ أَرْكَان الصَلاَة: كَبَّرَ المُصَلِّي)\nمثال: ما مدى كبر المسافة بين هنا وهناك؟",
 "grower": "خبير زراعي, مزارع (شخص يعنى بعلم أو فن أو تجارة زراعة الأرض)",
 "growing": "زراعي, نمو (متعلق أو مناسب للنمو) / تنمية البلورات ((إلكترونيات) إنتاج بلورات (شبه موصلة) عن طريق التبلور البطيء من الحالة المنصهرة) / تطور, نشوء ((علم الأحياء) عملية نمو الكائن الفردي عضويًا؛ تكشف بيولوجي بحت للأحداث المتضمنة في تغير الكائن الحي تدريجيًا من مستوى بسيط إلى مستوى أكثر تعقيدًا)\nمثال: موسم زراعة الذرة",
 "growing pains": "صعوبات البداية, مشاكل النمو (المشاكل التي تنشأ عند توسيع مؤسسة (خاصة في المراحل المبكرة)) / آلام النمو, معاناة النضج (ضيق عاطفي ينشأ خلال فترة المراهقة) / آلام النمو (ألم في العضلات أو المفاصل يعاني منه الأطفال أحياناً وغالباً ما يُعزى إلى النمو السريع)",
 "growing season": "موسم النمو (الموسم الذي ينمو فيه المحصول بشكل أفضل)",
 "growl": "زَمْجَرَة (اِسْمٌ لِصَوْتِ الأَسَد) / قَرْقَرَة",
 "growler": "كتلة جليدية صغيرة (جبل جليدي صغير أو طوف جليدي كبير بما يكفي ليكون خطيراً على الملاحة) / مزمجر (متحدث يبدو صوته كالزمجرة)",
 "growling": "زمجرة (تلفظ فظ أو غاضب (يوحي بزمجرة حيوان)) / زمجرة, هرهرة (صوت الزمجرة (كما تصدره الحيوانات))",
 "grown": "بَالِغ, مُكْتَمِلُ النُّمُوّ ((للحيوانات) مكتمل النمو والتطور)",
 "grown-up": "بَالِغ",
 "grownup": "بَالِغ, مُكْتَمِلُ النُّمُوّ ((للحيوانات) مكتمل النمو والتطور) / بالغ, راشد (شخص مكتمل النمو وصل إلى مرحلة النضج)",
 "growth": "تَنْمِيَة, نُمُو (الزيادة؛ النماء)\nمثال: الجزائر راغبة في تنمية اقتصادها.",
 "growth factor": "عامل نمو (بروتين يشارك في تمايز الخلايا ونموها)",
 "growth hormone": "سوماتروبين, هرمون النمو (هرمون تنتجه الغدة النخامية الأمامية؛ يعزز النمو عند البشر)",
 "growth hormone-releasing factor": "عامل مطلق لهرمون النمو (عامل مطلق يسرع إفراز هرمون النمو من الجسم النخامي الأمامي)",
 "growth industry": "صناعة نامية (صناعة تنمو بسرعة)",
 "growth rate": "مُعَدَّل النُّمُوّ (معدل الزيادة في الحجم لكل وحدة زمنية)",
 "growth regulator": "منظم نمو, هرمون نباتي ((علم النبات) منتج نباتي يعمل مثل الهرمون)",
 "growth ring": "حلقة النمو, حلقة سنوية (تشكل سنوي للخشب في النباتات أثناء نموها)",
 "growth stock": "أسهم نمو (أسهم شركة حققت مكاسب أسرع من المتوسط في الأرباح ومن المتوقع أن تستمر في ذلك)",
 "growth-onset diabetes": "السكري المعتمد على الأنسولين, السكري من النوع الأول (داء سكري شديد يظهر مبكرًا؛ يتميز بكثرة التبول والعطش الشديد وزيادة الشهية وفقدان الوزن والحماض الكيتوني العرضي؛ يتطلب النظام الغذائي وحقن الأنسولين…)",
 "groyne": "كاسر الأمواج (هيكل واقي من الحجر أو الخرسانة؛ يمتد من الشاطئ إلى الماء لمنع جرف الشاطئ)",
 "grozny": "غْرُوزْنِي, جْرُوزْنِي",
 "grub": "يَرَقَة",
 "grub street": "عالم الكتاب المأجورين, غروب ستريت (عالم الكتاب الأدبيين المتكسبين (المأجورين))",
 "grubbily": "بقذارة, بكآبة (بطريقة قذرة وكئيبة)",
 "grubbiness": "اتساخ, تلطخ (حالة كون الشيء متسخاً)",
 "grubby": "مُتَرَبِّب, وَسِخ جِدًّا (مُغطّى بطبقة سميكة من الأوساخ أو السُّخام المتراكم) / غرابي (سمكة إسقلبين صغيرة في ساحل نيو إنجلاند) / مدود, يرقاني (موبوء باليرقات (الديدان))",
 "grubstake": "تمويل تأسيسي, دعم مالي (أموال مقدمة لمنقب أو لشخص يبدأ عملاً تجارياً مقابل حصة من الأرباح)",
 "grudge": "بُغْض, ضَغِينَة (البُغْض ضدّ الحبّ ، بغَض جَدُّك:كتعس جدّك،ونعِمَ الله بك عيناً وبغَض بعدوّك عيناً؛ بغَضَ فلانٌ الشّيءَ أو الشّخصَ:كَرِهَه ومَقَتَه وأعرض عنه)\nمثال: سأذهب بغض النظر عن مجيئه.",
 "grudging": "ضَنِين, مُتَبَرِّم بِالعَطَاء (تافه أو متردد في العطاء أو الإنفاق) / عَلَى مَضَض, مُتَذَمِّر (يتّسم بالتردّد والامتعاض خاصّةً في الموقف)",
 "grudgingly": "بغير رغبة, على مضض (بطريقة مترددة أو كارهة)\nمثال: وافق على مضض على تناول مشروب في فندق قريب",
 "gruel": "عصيدة خفيفة (عصيدة رقيقة القوام (عادة دقيق الشوفان أو دقيق الذرة))",
