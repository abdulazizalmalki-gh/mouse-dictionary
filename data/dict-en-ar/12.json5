 "gluttony": "نَهَم, شَرَه",
 "glyburide": "غليبوريد, ميكروناز (دواء فموي مضاد للسكري (الأسماء التجارية ميكروناز وغيرها) يحفز إفراز الأنسولين من البنكرياس)",
 "glyceraldehyde": "غليسرالدهيد (ألديهيد بلوري حلو يتكون من تحلل السكريات)",
 "glyceria grandis": "عشب المروج القصبي (عشب مراعي في الأماكن الرطبة في جميع أنحاء أمريكا الشمالية)",
 "glyceric acid": "حمض الغليسيريك (حمض شراب القوام يتم الحصول عليه عن طريق أكسدة الجلسرين أو الغليسرالدهيد)",
 "glyceric aldehyde": "غليسرالدهيد (ألديهيد بلوري حلو يتكون من تحلل السكريات)",
 "glyceride": "أسيل غليسرول, غليسريد (إستر من الجلسرين والأحماض الدهنية يوجد بشكل طبيعي في الدهون والزيوت الدهنية)\nمثال: الدهون الطازجة تحتوي على غليسريدات الأحماض الدهنية وقليل جداً من الأحماض الحرة",
 "glycerin": "غليسرول, غليسرين (كحول ثلاثي الهيدروكسيل حلو المذاق وشرابي القوام يتم الحصول عليه بتصبن الدهون والزيوت)",
 "glycerin jelly": "هلام الجلسرين (خليط من الجلسرين والجيلاتين يُستخدم في علم الأنسجة لتثبيت العينات)",
 "glycerinated gelatin": "جيلاتين مغلسر (مستحضر هلامي مصنوع من الجيلاتين والجلسرين والماء؛ يستخدم كقاعدة للمراهم والتحاميل)",
 "glycerine": "غليسرول, غليسرين (كحول ثلاثي الهيدروكسيل حلو المذاق وشرابي القوام يتم الحصول عليه بتصبن الدهون والزيوت)",
 "glycerite": "غليسريت (دواء يُصنع بخلط مادة ما في الجلسرين)",
 "glycerogel": "غليسرينات الجلاتين (مستحضر جلدي طبي مصنوع من الجلسرين والجيلاتين الممزوج بالجلسرين)",
 "glycerogelatin": "غليسرينات الجلاتين (مستحضر جلدي طبي مصنوع من الجلسرين والجيلاتين الممزوج بالجلسرين)",
 "glycerol": "غليسرول, غليسرين (كحول ثلاثي الهيدروكسيل حلو المذاق وشرابي القوام يتم الحصول عليه بتصبن الدهون والزيوت)",
 "glycerol trimargarate": "مارغرين (إستر غليسيريل لحمض المارجريك)",
 "glycerol tripalmitate": "تريبالستين (ثلاثي غليسريد لحمض البالمتيك)",
 "glycerol tristearate": "تريستيرين (ثلاثي غليسريد لحمض الستياريك)",
 "glycerole": "غليسريت (دواء يُصنع بخلط مادة ما في الجلسرين)",
 "glyceryl": "غليسيريل (شق ثلاثي التكافؤ مشتق من الجليسرين عن طريق إزالة جذور الهيدروكسيل الثلاثة)",
 "glyceryl ester": "إستر غليسيريل (إستر للجلسرين)",
 "glyceryl trinitrate": "ثلاثي نيتروجليسرين, نيتروجليسرين (سائل زيتي ثقيل أصفر سام متفجر يتم الحصول عليه عن طريق نيترة الجلسرين؛ يستخدم في صنع المتفجرات وطبياً كموسع للأوعية الدموية)",
 "glycine": "غلايسين (أبسط حمض أميني يوجد في البروتينات وهو الحمض الأميني الرئيسي في قصب السكر)",
 "glycine max": "صويا, فول الصويا (عشب حولي منتصب كثيف الشعر له أوراق ثلاثية وزهور أرجوانية إلى وردية؛ يزرع على نطاق واسع للغذاء والعلف ولتحسين التربة، وخاصة لبذوره المغذية الغنية…)",
 "glycogen": "غليكوجين, نشا حيواني (أحد الأشكال التي يُخزن بها وقود الجسم؛ يُخزن بشكل أساسي في الكبد ويتحلل إلى جلوكوز عند حاجة الجسم)",
 "glycogenesis": "تكون الجليكوجين (تحويل الجلوكوز إلى جليكوجين عندما يتجاوز الجلوكوز في الدم الطلب) / تكون الغليكوجين (تكوين الغليكوجين من الجلوكوز في الحيوانات)",
 "glycogenic": "جليكوجيني (مكون من أو متعلق بـ أو يتضمن الجليكوجين)",
 "glycol": "ديول, غليكول (أي من فئة الكحولات التي تحتوي على مجموعتي هيدروكسيل في كل جزيء) / إيثيلين غليكول, غليكول (سائل شرابي حلو ولكنه سام يستخدم كمضاد للتجمد ومذيب)",
 "glycolic acid": "حمض الجليكوليك (مركب بلوري شفاف يوجد في قصب السكر والبنجر والعنب غير الناضج)",
 "glycollic acid": "حمض الجليكوليك (مركب بلوري شفاف يوجد في قصب السكر والبنجر والعنب غير الناضج)",
 "glycolysis": "تحلل السكر",
 "glycoprotein": "بروتين سكري (بروتين مقترن يحتوي على مكون كربوهيدراتي)",
 "glycoside": "غليكوزيد (مجموعة من المركبات المشتقة من السكريات الأحادية)",
 "glycosuria": "بيلة سكرية (وجود مستويات عالية بشكل غير طبيعي من السكر في البول)",
 "glycyrrhiza glabra": "عرق سوس (نبات عميق الجذور خشن الملمس موطنه منطقة البحر الأبيض المتوسط له أزهار زرقاء وأوراق مركبة ريشية؛ يزرع على نطاق واسع في أوروبا لجذوره الحلوة السميكة…)",
 "glycyrrhiza lepidota": "عرق سوس أمريكي, عرق سوس بري (نبات من أمريكا الشمالية يشبه العرق سوس الحقيقي وله جذر بخصائص مماثلة)",
 "glyoxaline": "إيميدازول",
 "glyph": "غليف, نقش رمزي (فن نحت على شكل شكل رمزي منحوت أو محفور بشكل بارز)",
 "glyptic art": "جليبتوغرافيا, فن النحت على الجواهر (النقوش أو الحفر (خاصة على الأحجار الكريمة))",
 "glyptics": "فن الحفر على الأحجار الكريمة (فن النقش على الأحجار الكريمة)",
 "glyptography": "غليبتوغرافيا, فن النقش (النحت أو النقش (خاصة على الأحجار)) / جليبتوغرافيا, فن النحت على الجواهر (النقوش أو الحفر (خاصة على الأحجار الكريمة))",
 "gm": "غرام (وحدة مترية للوزن تساوي واحداً من الألف من الكيلوغرام)",
 "gmt": "التوقيت العالمي, توقيت غرينتش (التوقيت المحلي عند خط الصفر المار عبر غرينتش، إنجلترا؛ وهو نفسه في كل مكان)",
 "gnaphalium sylvaticum": "عشبة القد الخشبية (نبات معمر عشبي من المناطق المعتدلة الشمالية له أوراق صوفية وزهور بيضاء قذرة في سنبلة ورقية)",
 "gnarl": "تشنج, عقدة (شيء ملتو ومشدود ومنتفخ)\nمثال: برزت عضلاتهم في عقد",
 "gnarled": "ذُو عُقَد, مُعَقَّد (يُستخدَم لوصف كبار السن أو الأشجار القديمة؛ مغطى بالعقد والنتوءات)",
 "gnarly": "ذُو عُقَد, مُعَقَّد (يُستخدَم لوصف كبار السن أو الأشجار القديمة؛ مغطى بالعقد والنتوءات)",
 "gnash": "قَرَشَ",
 "gnat": "بعوضة ((استخدام بريطاني) بعوضة) / برغش, هسهسة (أي من الذباب الصغير اللاسع المتنوع: الهاموش؛ الهاموش اللاسع؛ الذباب الأسود؛ ذباب الرمل)",
 "gnatcatcher": "صائد البعوض (طيور هازجة صغيرة جداً من أمريكا الشمالية والجنوبية)",
 "gnathion": "فُكَيْكَى",
 "gnathopod": "رجل فكية, قدم فكية (واحدة من مجموعة من ثلاثة زوائد مزدوجة على صدر القشريات عشاريات الأرجل، تقع خلف الفك العلوي وتستخدم في التغذية)\nمثال: الزائدة المعدلة للمساعدة في التغذية تعرف بالرجل الفكية",
 "gnathostome": "فكي الفم, فكيات (حيوان فقاري يمتلك فكوكاً حقيقية)",
 "gnaw": "نَخَرَ, قَضَمَ",
 "gnawer": "قارض (ثدييات مشيمية صغيرة نسبياً لها زوج واحد من الأسنان القاطعة دائمة النمو المتخصصة للقضم)",
 "gnawing mammal": "أرنبيات الشكل (حيوانات قاضمة كبيرة نسبياً؛ تتميز عن القوارض بوجود زوجين من القواطع العلوية المتخصصة للقضم)",
 "gneiss": "نايس (صخر متحول صفائحي مشابه للجرانيت)",
 "gnetum": "جنيتوم (شجرة استوائية صغيرة بفروع متدرجة وغصينات متباعدة لها أوراق خضراء داكنة لامعة عريضة؛ تستغل لأوراقها الصغيرة الصالحة للأكل وبذورها التي توفر دقيقاً…)",
 "gnetum gnemon": "جنيتوم (شجرة استوائية صغيرة بفروع متدرجة وغصينات متباعدة لها أوراق خضراء داكنة لامعة عريضة؛ تستغل لأوراقها الصغيرة الصالحة للأكل وبذورها التي توفر دقيقاً…)",
 "gnocchi": "نْيُوكِّي",
 "gnome": "تِمْثَال, قزم خرافيّ",
 "gnomic": "حكمي, مأثور (متعلق بالحكم والأمثال المأثورة أو يحتوي عليها)\nمثال: شعر حكمي",
 "gnomish": "جِنِّيّ, قُزْمِيّ (يُستخدم لوصف مخلوقات صغيرة مشوّهة)",
 "gnomon": "قياس",
 "gnosis": "عرفان, غنوص (معرفة حدسية بالحقائق الروحية؛ قيل إن الغنوصيين القدماء امتلكوها)",
 "gnostic": "غُنُّوصِيّ, عِرْفَانِيّ",
 "gnosticism": "غُنُّوصِيَّة, عِرْفَانِيَّة",
 "gnp": "ناتج قومي إجمالي (مقياس سابق لاقتصاد الولايات المتحدة؛ القيمة السوقية الإجمالية للسلع والخدمات التي ينتجها جميع المواطنين ورأس المال خلال فترة معينة (عادة سنة واحدة))",
 "gnu": "نَوّ",
 "gnu goat": "تاكين, ماعز الغنو (ظبي ماعز كبير ثقيل البنية يعيش في منطقة الهيمالايا الشرقية)",
 "go": "ذَهَبَ, رَاحَ (في : التِبْر، مَعْدِن ثَمِين أصْفَر اللَّوْنِ، هُوَ أَسَاسُ التَعَامُلِ المَالِيّ وَيُسْتَخْدَمُ أَيْضاً فِي صِنَاعَةِ الْحُلِيّ وَالْمُجَوْهَرَات؛ هَذَا رَجُل ذَهَبا: أَيْ رَجُلٌ يُسَاوِي ذَهَباً فِي قِيمَتِهِ وَقدره) / ذَهَبَ, زَالَ (في : التِبْر، مَعْدِن ثَمِين أصْفَر اللَّوْنِ، هُوَ أَسَاسُ التَعَامُلِ المَالِيّ وَيُسْتَخْدَمُ أَيْضاً فِي صِنَاعَةِ الْحُلِيّ وَالْمُجَوْهَرَات؛ هَذَا رَجُل ذَهَبا: أَيْ رَجُلٌ يُسَاوِي ذَهَباً فِي قِيمَتِهِ وَقدره) / غُو\nمثال: ذهب إلى الدكان.",
 "go astray": "ضَلَّ",
 "go away": "اِبْتَعَدَ",
 "go board": "لوحة غو (لوحة تستخدم للعب غو)",
 "go down": "نَزَلَ (ضد صَعَدَ، اِنْحَدَرَ أو اِنْخَفَضَ؛ القوم: حَلُّوا في مكان ما)\nمثال: نزل علينا الخوف.",
 "go dutch": "وَزَّعَ الْمَصَارِيف (كَفَّ ومَنَعَ وحَبَسَ؛ به: أَغْرَى)\nمثال: وزع علينا الورق.",
 "go fish": "غو فيش (لعبة ورق للاعبين اثنين يحاولان تجميع مجموعات من الأوراق عن طريق طلب أوراق معينة من الخصم)",
 "go fuck oneself": "روح نيك نفسك (رَوَّحَ عليه بالمِرْوحَة: حَرَّكَها ليجلبَ إِليه نسيمَ الهواء؛ رَوَّحَ بالقوم: صلَّى بهم التراويح)\nمثال: كان سامي هو روح الحفلة.",
 "go game": "غو (لعبة لوحية للاعبين اثنين يضعان عدادات على شبكة؛ الهدف هو إحاطة عدادات الخصم والاستيلاء عليها)",
 "go nuts": "أَصْبَحَ مَجْنُونًا (دَخَلَ فِي الصَّبَاح؛ صَارَ)\nمثال: أصبح الجو ماطرا",
 "go out": "خَرَجَ (اِنْتَقَلَ إلى خارج المكان)\nمثال: خرج سامي ليحتفل.",
 "go up": "صَعِدَ, يَصْعَدُ",
 "go-ahead": "إقدام, روح المبادرة (الاستعداد للشروع في مشاريع جديدة جريئة) / إشارة الانطلاق, ضوء أخضر (إشارة للمضي قدماً)",
 "go-around": "إلغاء الهبوط, تجاوز الهدف (اقتراب يفشل ويفسح المجال لمحاولة أخرى)",
 "go-as-you-please": "حُرّ, طَلِيقٌ مِنَ القُيُود (غَيْرُ مُقَيَّدٍ بِقَاعِدَةٍ أَوْ قَانُونٍ أَوْ عُرْف)",
 "go-between": "حلقة وصل, وسيط (مفاوض يعمل كحلقة وصل بين الأطراف)",
 "go-cart": "عربة أطفال (مركبة صغيرة بأربع عجلات يدفع فيها الرضيع أو الطفل) / عربة دفع, عربة يدوية (مركبة بعجلات يمكن دفعها بواسطة شخص؛ قد يكون لها عجلة واحدة أو عجلتان أو أربع عجلات) / مشاية أطفال (هيكل مغلق على عجلات؛ يساعد الأطفال على تعلم المشي)\nمثال: استخدم عربة يدوية لنقل الصخور بعيداً",
 "go-getter": "طَمُوح, مُثَابِر (شخص يتقدم مساره المهني بسرعة؛ شخص ذو همة عالية)",
 "go-kart": "جو كارت (مركبة آلية منخفضة صغيرة بأربع عجلات وإطار مفتوح؛ تستخدم للسباق)",
 "go-slow": "تَبَاطُؤ فِي العَمَل (شكل من أشكال الاحتجاج العمالي يتباطأ فيه العمال عمداً للتسبب في مشاكل لأصحاب العمل)",
 "go-to": "خيار أول, خيار مُفَضَّل (فعل أو شيء يختاره المرء دائماً في المقام الأول)",
 "goa": "غْوَا",
 "goa bean": "فاصولياء غوا, فاصولياء مجنحة (فاصولياء استوائية من العالم القديم) / فاصوليا مجنحة, فول غوا (كرمة حولية درنية ملتفة تحمل عناقيد من الزهور الأرجوانية وقروناً بأربعة أجنحة مسننة؛ المناطق الاستوائية في العالم القديم)",
 "goa bean vine": "فاصوليا مجنحة, فول غوا (كرمة حولية درنية ملتفة تحمل عناقيد من الزهور الأرجوانية وقروناً بأربعة أجنحة مسننة؛ المناطق الاستوائية في العالم القديم)",
 "goa powder": "أراروبا, مسحوق جوا (مسحوق أصفر مر يستخدم لعلاج الأمراض الجلدية)",
 "goad": "مِنْخَس",
 "goaded": "مَدْفُوع, مُحَفَّز (مُجْبَرٌ قَسْرًا بِوَاسِطَةِ عَامِلٍ خَارِجِيّ)",
 "goading": "تحفيز, حث (لفظ يشجعك على محاولة شيء ما)\nمثال: النكز المستمر أثار أعصابه",
 "goal": "هَدَف, مَقْصَد (جاء إلى الهَدَف؛ ارتفع عن الأرض) / مَرْمًى / هَدَف (جاء إلى الهَدَف؛ ارتفع عن الأرض) / سَجَّلَ هَدَفًا (كتاب أو صحيفة تُسَجَّلُ فيها الأمور؛ الكاتب الذي يحفظ تلك الصحيفة أو السِجِلّ)\nمثال: لقد أخطأ الهدف.",
 "goal kick": "رَكْلَة مَرْمًى",
 "goal line": "خط المرمى (خط يحدد كل نهاية لملعب اللعب؛ حيث توجد الأهداف)",
 "goal-directed": "غَرَضِيّ, مُوَجَّه نَحْوَ الهَدَف (ذو غاية وهدف محدّد)",
 "goal-kick": "ركلة مرمى ((كرة القدم) ركلة من قبل الفريق المدافع بعد أن يرسل الفريق المهاجم الكرة فوق خط المرمى) / ركلة هدف ((رجبي) محاولة لركل هدف)",
 "goalie": "حارس مرمى (المركز الدفاعي في فريق هوكي الجليد أو كرة القدم أو اللاكروس الذي يقف أمام المرمى ويحاول منع لاعبي الخصم من التسجيل) / حارس مرمى (لاعب كرة القدم أو الهوكي المكلف بحماية المرمى)",
 "goalkeeper": "حَارِس مَرْمَى, حَارِس",
 "goalless": "بِلَا أَهْدَاف, بِلَا نِقَاط (لم يُسجَّل فيه أي نقاط أو أهداف)",
 "goalmouth": "منطقة المرمى ((رياضة) المنطقة التي تقع مباشرة أمام المرمى)",
 "goalpost": "قائم المرمى (أحد القائمين (وعادة ما يربط بينهما عارضة) اللذين يتم نصبهما كهدف في كل طرف من الملعب)",
 "goalscorer": "هَدَّاف",
 "goaltender": "حارس مرمى (المركز الدفاعي في فريق هوكي الجليد أو كرة القدم أو اللاكروس الذي يقف أمام المرمى ويحاول منع لاعبي الخصم من التسجيل) / حارس مرمى (لاعب كرة القدم أو الهوكي المكلف بحماية المرمى)",
 "goat": "مَاعِز, عَنْزَة",
 "goat antelope": "ظبي الماعز (بقريات مرتبطة بالماعز ولكن لها ميزات تشبه الظباء: الماعز الجبلي، الغورال، السيرو، الشامواه، ظباء الغنو)",
 "goat cheese": "جبن الماعز (مصنوع من حليب الماعز)",
 "goat eye": "عين الماعز (حلقة قضيب مصنوعة من الجلد وشعر الحيوان)",
 "goat grass": "عشب الماعز (عشب أوروبي توطن كعشب ضار في أمريكا الشمالية؛ تسبب بذوره حادة الرؤوس إصابات عند أكلها من قبل الماشية)",
 "goat herder": "راعي ماعز (شخص يرعى قطيعاً من الماعز)",
 "goat rue": "سذاب الماعز, مدرة مخزنية (نبات أوروبي معمر طويل وكثيف يزرع لأوراقه الريشية وسنابله النحيلة من الزهور الزرقاء؛ يستخدم أحياناً طبياً)",
 "goat willow": "صفصاف الماعز (صفصاف كثير التفرع من العالم القديم له نورات هرية كبيرة وأوراق عريضة كبيرة نسبياً)",
 "goat's foot": "حميض الماعز, قدم الماعز (نبات قصير الساق من جنوب إفريقيا بزهور مزرقة)",
 "goat's milk": "حَلِيب اَلْمَاعِز (هو اللَبَن المَحْلُوْب، أو ما لم يتغير طعمه. أصل التسمية؛ هو ما لم يَرُوْب واللَبَن هو ما رَابَ)\nمثال: كنت أشرب الحليب",
 "goat's rue": "مُدِرَّةٌ مَخْزَنِيَّةٌ",
 "goatee": "عُثْنُون",
 "goateed": "ذُو سَكْسُوكَة (له لحية صغيرة مُدبَّبة على الذقن)",
 "goatfish": "بربوني, سلطان إبراهيم (أسماك استوائية زاهية الألوان ذات زوائد استشعارية في الذقن)",
 "goatgrass": "دَوْسَر",
 "goatherd": "راعي ماعز (شخص يرعى قطيعاً من الماعز)",
 "goats' milk": "حليب الماعز (حليب الماعز)",
 "goatsbeard": "ساسفي المروج, لحية التيس (نبات حولي أوروبي ضار بأزهار صفراء؛ مستوطن في الولايات المتحدة)",
 "goatsfoot": "حميض الماعز, قدم الماعز (نبات قصير الساق من جنوب إفريقيا بزهور مزرقة)",
 "goatskin": "جلد الماعز (إهاب الماعز)",
 "goatsucker": "سبد (طيور غير جاثمة شفقية أو ليلية بشكل رئيسي بريش بني رمادي مبقع وعيون كبيرة؛ تتغذى على الحشرات)",
 "gob": "بوز, فم (مصطلحات عامية للفم) / كتلة لزجة (كتلة من مادة لزجة) / بحار (رجل يخدم كبحار)\nمثال: كتلة من البلغم",
 "gobbet": "قطعة لحم, كتلة لحم (كتلة أو قطعة من اللحم النيء)",
 "gobble": "قرقرة (الصوت المميز الذي يصدره الديك الرومي)",
 "gobbledygook": "رطانة, كلام غير مفهوم (رطانة غير مفهومة أو متفاخرة للمتخصصين)",
 "gobbler": "ديك رومي (ذكر الديك الرومي) / زَرِد, مُلتهم (آكل متسرع يبتلع لقيمات كبيرة)",
 "gobi": "جُوبِي",
 "gobiesox strumosus": "سمكة المقلاة (سمكة ملتصقة ذات شكل يشبه المقلاة)",
 "gobio gobio": "جودجون (سمكة مياه عذبة أوروبية نحيلة صغيرة غالباً ما يستخدمها الصيادون كطعم)",
 "goblet": "صُوَاع",
 "goblet cell": "خلية كأسية (خلية طلائية تفرز المخاط)",
 "goblet drum": "دَرْبُوكَة",
 "goblet-shaped": "كَأْسِيُّ الشَّكْل (يشبه شكل الكأس)",
 "goblin": "جني, عفريت ((فلكلور) مخلوق خارق صغير بشع يسبب المشاكل للبشر)",
 "gobs": "أطنان, أكوام (عدد أو كمية كبيرة)\nمثال: كون الكثير من الصداقات الجديدة",
 "gobsmacked": "مَشْدُوه تَمَامًا (مذهول إلى أقصى حد)",
 "goby": "قوبيون (سمكة صغيرة شائكة الزعانف تعيش في المياه الساحلية أو قليلة الملوحة لها رأس كبير وجسم مستدق ممدود وتتحور الزعانف البطنية لتعمل كممص)",
 "god": "رَبّ (رَبَّ الولدَ يَرُبُّ رَبًّا: ولِيَه وتعهده بما يغذيه وينميه ويؤدّبه؛ الفاعل: رَابٌّ، والمفعول: مَرْبوبٌ، وربيبٌ)\nمثال: اعتني بي يا رب.",
 "god bless you": "حَيَّاك اللّٰه, بَارَكَ اللّٰه فِيكَ",
 "god forbid": "لَا سَمَحَ اللّٰه, لَا قَدَّرَ اللّٰه (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: لا أحب المدرسة.",
 "god helps those who help themselves": "اعقِلْها وتَوكَّلْ",
 "god knows": "اَللّٰهُ أَعْلَم ((في الديانات التوحيدية الربوبية) الإله المعبود بحق؛ اللَّٰه)\nمثال: الله وحده يعلم.",
 "god knows how": "الله يعلم كيف (بوسيلة لا يفهمها المتحدث)\nمثال: الله يعلم كيف فعلها",
 "god of war": "إله الحرب (إله يُعبد بصفته مانحاً للنصر في الحرب)",
 "god tree": "شجرة القطن الحريري, قابوق (شجرة استوائية ضخمة ذات تلال عميقة على جذعها الضخم وتحمل قروناً كبيرة من البذور مغطاة بزغب حريري؛ مصدر لألياف القابوق الحريرية)",
 "god willing": "إِنْ شَاءَ الله (يفيد التوكيد)\nمثال: إن شاء الله ؛",
 "god works in mysterious ways": "لِلّٰهِ فِي خَلْقِهِ شُؤُونٌ",
 "god's acre": "فناء الكنيسة (الساحة المرتبطة بالكنيسة)",
 "god's will": "إرادة إلهية, مشيئة الله (القدرة المطلقة لكائن إلهي)",
 "god's wisdom": "حكمة إلهية (العلم المطلق لكائن إلهي)",
 "god-awful": "بَشِع, فَظِيع ((غير رسمي) غير سارّ للغاية)",
 "god-fearing": "وَرِع, تَقِيّ (تَحَرَّجَ من أن يأتي إِثْما وابتعد عن المعاصي)",
 "god-given": "هِبَة إِلٰهِيَّة, تَوْفِيق إِلٰهِيّ",
 "godchild": "ابن بالمعمودية, ابنة بالمعمودية (رضيع يكفله شخص بالغ (العراب) عند المعمودية)",
 "goddam": "بحق, واللعنة (للتعبير عن الغضب، اليأس، الإحباط، الموافقة، أو المفاجأة) / لَعِين, مَلْعُون ((غير رسمي) شتائم تُستخدَم للتوكيد والتأثير)\nمثال: أنت محق واللعنة!",
 "goddamn": "اللَعْنَة / مَلْعُون",
 "goddamned": "بحق, واللعنة (للتعبير عن الغضب، اليأس، الإحباط، الموافقة، أو المفاجأة) / لَعِين, مَلْعُون ((غير رسمي) شتائم تُستخدَم للتوكيد والتأثير)\nمثال: أنت محق واللعنة!",
 "goddaughter": "ابنة بالمعمودية (ابنة بالمعمودية (أنثى))",
 "goddess": "إِلَاهَة, إِلٰهَة / مَعْبُودَة",
 "godfather": "عَرَّاب, إِشْبِين (عامل العَرَبَات؛ عند النصارى: كفيل الطفل المعتمد)\nمثال: العراب هو فيلمي المفضل.",
 "godforsaken": "قَفْر, مَهْجُور (في منطقة نائية وموحشة؛ خَرِبة)",
 "godless": "مُلْحِد, زِنْدِيق",
 "godlessness": "فجور, كفر (عدم التقوى بحكم عدم كون الشخص ربانياً)",
 "godlike": "مُتَأَلِه",
 "godliness": "وَرَع, تَقْوَى (تَحَرَّجَ من أن يأتي إِثْما وابتعد عن المعاصي)",
 "godly": "إِلٰهِيّ",
 "godmother": "عَرَّابَة, إِشْبِينَة",
 "godown": "مستودع (جوداون) ((في الهند وماليزيا) مستودع)",
 "godparent": "عراب المعمودية (شخص يكفل شخصاً (الطفل الروحي) عند المعمودية)",
 "godsend": "ضَرْبَة حَظّ (المرة الواحدة من الضَرْب؛ اللطمو أو الدقة أو الصكّة؛ ضربة طبل: دقة واحدة منه) / مُصَادَفَة سَعِيدَة / مِنْحَة إِلٰهِيَّة\nمثال: تلقى مناد ضربة.",
 "godson": "ابن بالمعمودية (ابن بالمعمودية (ذكر))",
 "godspeed": "بِالتَّوْفِيق, فِي مَعِيَّة اللّٰه",
 "godwit": "بقويقة",
 "godzilla": "غُودْزِيلَا, غُدْزِيلَا",
 "goer": "راحل, مغادر (شخص يغادر)",
 "goethe": "غُوتَه",
 "goethean": "غوتي (من أو يتعلق بغوته أو على طريقته)",
 "goethian": "غوتي (من أو يتعلق بغوته أو على طريقته)",
 "goethite": "غوثيت (معدن أحمر أو أصفر أو بني؛ أكسيد الحديد ومكون شائع للصدأ)",
 "gofer": "ساعي, مرسال (موظف تشمل واجباته قضاء المهمات الصغيرة والمشاوير)",
 "goffer": "كشكشة مكوية (كشكشة زخرفية تُصنع عن طريق ضغط الثنيات) / مكواة تكسير, مكواة كشكشة (مكواة تُستخدم لكيّ الثنيات والتموجات (الكشكشة)) / سَاعٍ, مُتَحَمِّس (شخص نشيط بحماس (خاصة بائع))",
 "goffering iron": "مكواة تكسير, مكواة كشكشة (مكواة تُستخدم لكيّ الثنيات والتموجات (الكشكشة))",
 "gog and magog": "يأجوج ومأجوج (أسماء توراتية لأعداء شعب الله الذين يشنون حربًا ضد الله في نهاية العالم)\nمثال: في سفر حزقيال، جوج هو حاكم من أرض ماجوج ولكن في سفر الرؤيا جوج وماجوج هم أمم تحت حكم الشيطان",
 "goggle box": "تلفاز, جهاز تلفزيون (جهاز إلكتروني يستقبل إشارات التلفزيون ويعرضها على شاشة)",
 "goggle-eye": "سكاد كبير العين (من المياه الساحلية الأطلسية؛ تستخدم عادة كطعم)",
 "goggle-eyed": "جَاحِظ العَيْنَيْن, فَاغِر الفَم (مفتوح العينين أو الفم من شدة الدهشة)",
 "goggles": "نظارات واقية ((جمع) نظارات محكمة التثبيت تُرتدى لحماية العينين)",
 "gogol": "غُوغُول, جُوجُول",
 "goidelic": "الجودية, الغيلية (أي من عدة لغات ذات صلة بالكلت في أيرلندا واسكتلندا)",
 "goidelic language": "الجودية, الغيلية (أي من عدة لغات ذات صلة بالكلت في أيرلندا واسكتلندا)",
 "going": "ذهاب, رحيل (فعل المغادرة) / تقدم, سير الأمور (التقدم نحو هدف ما) / رحيل, فقدان (تعبيرات ملطفة للموت)\nمثال: كان إقناعه أمراً سهلاً",
 "going ashore": "نزول للبر (النزول من قارب أو سفينة)",
 "going away": "ذهاب, رحيل (فعل المغادرة)",
 "going to jerusalem": "الكراسي الموسيقية (لعبة للأطفال يسير فيها اللاعبون على أنغام الموسيقى حول مجموعة من الكراسي تقل بكرسي واحد عن عدد اللاعبين؛ عندما تتوقف الموسيقى فجأة يتدافع اللاعبون…)",
 "going under": "غرق ((للسفينة) الغرق أو الغوص تحت الماء)",
 "going-out-of-business sale": "تصفية إغلاق النشاط, تصفية نهائية (بيع جميع الأصول الملموسة لشركة على وشك الإغلاق)\nمثال: خلال الكساد الكبير كانت تصفيات إغلاق النشاط شائعة جداً",
 "going-over": "تفتيش دقيق, فحص شامل (تفتيش دقيق وشامل) / تَقْرِيع شَدِيد, تَوْبِيخ لَاذِع (توبيخ شديد وقاسٍ)",
 "goiter": "تضخم الغدة الدرقية, دراق (تضخم غير طبيعي للغدة الدرقية)",
 "goitre": "تَضَخُّم الْغُدَّة الدَّرَقِيَّة (الزِّيادة المُفرِطة في الحجم؛ الزِّيادة المُفرِطة في الوسائل والأَشخاص)\nمثال: الجزائر تعاني من التضخم.",
 "goitrogen": "محدث الدراق, مسبب تضخم الغدة الدرقية (أي مادة (مثل ثيويوراسيل) تحفز تكوين تضخم الغدة الدرقية (الدراق))",
 "goiás": "غُويَاسْ",
 "golaghat": "جولاغات",
 "golan heights": "هَضْبَةُ الْجَوْلَان, مُرْتَفَعَاتُ الْجَوْلَان",
 "golconda": "غولكوندا (مصدر لثروة كبيرة (خاصة منجم))",
 "gold": "ذَهَب, إِبْرِيز (في : التِبْر، مَعْدِن ثَمِين أصْفَر اللَّوْنِ، هُوَ أَسَاسُ التَعَامُلِ المَالِيّ وَيُسْتَخْدَمُ أَيْضاً فِي صِنَاعَةِ الْحُلِيّ وَالْمُجَوْهَرَات؛ هَذَا رَجُل ذَهَبا: أَيْ رَجُلٌ يُسَاوِي ذَهَباً فِي قِيمَتِهِ وَقدره) / ذَهَبِي\nمثال: ذهب إلى الدكان.",
 "gold braid": "جديلة, شريط مجدول (حاشية تستخدم لتزيين الملابس أو الستائر)",
 "gold coast": "غُولْد كُوسْت",
 "gold digger": "صائدة ثروات (امرأة ترتبط برجل غني أو تتزوجه للحصول على ممتلكات منه من خلال الهدايا أو تسوية الطلاق) / منقب عن الذهب (عامل منجم يحفر أو يغسل التربة بحثاً عن الذهب في حقل ذهب)",
 "gold dust": "تبر الذهب, غبار الذهب (الجزيئات والرقائق (وأحيانًا شذرات صغيرة) من الذهب التي يتم الحصول عليها في التعدين الغريني)",
 "gold fern": "سرخس الذهب (سرخس من جزر الهند الغربية وأمريكا الجنوبية له سعف بجوانب سفلية صفراء ذهبية زاهية)",
 "gold fever": "حمى الذهب (الجشع والإثارة المعدية للبحث عن الذهب)",
 "gold foil": "رقائق الذهب (رقائق مصنوعة من الذهب)",
 "gold leaf": "ورق الذهب (شكل رقيق جداً من رقائق الذهب)",
 "gold medal": "ميدالية ذهبية (كأس مصنوعة من الذهب (أو لها مظهر الذهب) تمنح عادة للفائز بالمركز الأول في المسابقة)",
 "gold mine": "منجم ذهب (منجم يُعثر فيه على خام الذهب) / منجم ذهب (مصدر جيد لشيء مرغوب فيه)",
 "gold miner": "منقب عن الذهب (عامل منجم يحفر أو يغسل التربة بحثاً عن الذهب في حقل ذهب)",
 "gold of pleasure": "كاملينا, كتان كاذب (كتان كاذب أوروبي حولي ذو أزهار بيضاء صغيرة؛ زرع منذ العصر الحجري الحديث كمصدر للألياف ولبذوره الغنية بالزيت؛ متوطن على نطاق واسع في أمريكا الشمالية)",
 "gold panner": "منقب عن الذهب (عامل منجم يحفر أو يغسل التربة بحثاً عن الذهب في حقل ذهب)",
 "gold plate": "طلاء بالذهب (طبقة رقيقة من الذهب على شيء ما) / أواني مطلية بالذهب (أدوات مائدة مطلية بالذهب)",
 "gold rush": "حمى الذهب (هجرة كبيرة للناس إلى حقل ذهب مكتشف حديثاً) / رزق ساقه الله, رواج (حدث مفاجئ يجلب الحظ السعيد (مثل فرصة مفاجئة لكسب المال))\nمثال: خلق الطلب على الاختبار طفرة لتلك المختبرات غير الخاضعة للتنظيم",
 "gold standard": "معيار ذهبي (نموذج للتميز) / معيار الذهب (معيار نقدي يتم بموجبه تعريف الوحدة الأساسية للعملة بكمية محددة من الذهب)\nمثال: التعليم الأكاديمي هو المعيار الذهبي الذي يُحكم على أساسه سلباً على الأنشطة التعليمية الأخرى",
 "gold telluride": "تيلوريد الذهب",
 "gold-bearing": "حَامِلٌ لِلذَّهَب, ذَهَبِيّ (يَحْتَوِي عَلَى الذَّهَب)",
 "gold-beater": "صانع أوراق الذهب, طراق الذهب (حرفي يطرق الذهب ليحوله إلى أوراق ذهبية)",
 "gold-colored": "ذَهَبِيّ اللَّوْن (ذو لون الذَّهب)",
 "gold-coloured": "ذَهَبِيّ اللَّوْن (ذو لون الذَّهب)",
 "gold-crowned kinglet": "صعوة ذهبية التاج (صعوة أمريكية ذهبية التاج)",
 "gold-tail moth": "عثة ذهبية الذيل (عثة أوروبية بيضاء ذات جسم فروي وخصلة ذيل صفراء)",
 "gold-worker": "صائغ ذهب (حرفي يصنع المجوهرات وأشياء أخرى من الذهب)",
 "goldbeater": "صانع أوراق الذهب, طراق الذهب (حرفي يطرق الذهب ليحوله إلى أوراق ذهبية)",
 "goldbrick": "غش (أي شيء يفترض أن يكون قيماً ولكنه يتبين أنه بلا قيمة) / سبيكة زائفة (كتلة على شكل طوب تشبه الذهب ولكنها ليست كذلك) / شخص عديم الفائدة, عاطل (شخص خامل لا قيمة له) / متكاسل, متهرب (جندي يؤدي واجباته دون اهتمام أو جهد مناسب)",
 "goldbricking": "تكاسل, تهرب من العمل (التهرب من العمل أو الواجب)",
 "goldcrest": "صعوة ذهبية (صعوة أوروبية ذات بقعة تاج صفراء محاطة بالأسود)",
 "goldcup": "حوذان, زهرة الزبدة",
 "golden": "ذَهَبِيّ",
 "golden age": "عَصْر ذَهَبِيّ (مصدر للفعل \"عَصَرَ\"؛ أي مدة زمنية، دهر من الوقت)\nمثال: صلى زيري العصر.",
 "golden ager": "عجوز, كبير السن (شخص متقدم في السن)",
 "golden algae": "طحالب ذهبية (طحالب تحتوي على أصباغ الكلوروفيل والكاروتين والزانثوفيل)",
 "golden aster": "أستر ذهبي, كريسوبسيس (أي من عدة أعشاب شجيرية أو شجيرات صغيرة من جنس كريسوبسيس ذات رؤوس زهرية صفراء ذهبية زاهية تشبه الأستر؛ في معظم أنحاء الولايات المتحدة وكندا)",
 "golden barrel cactus": "صبار البرميل الذهبي, كرسي الحماة (صبار كبير من شرق وسط المكسيك له زهور وأشواك ذهبية إلى صفراء شاحبة)",
 "golden buttons": "أزرار ذهبية, حشيشة الدود (عشبة عطرية معمرة شائعة موطنها أوراسيا ذات رؤوس زهور صفراء تشبه الأزرار وأوراق ريشية مرة الطعم تستخدم أحياناً طبياً)",
 "golden calf": "عِجْل الذَّهَب (أسرع في إنجاز شيء أو القيام به؛ قدم شيئًا قبل وقته المعتاد)\nمثال: أنا في عجلة من أمري.",
 "golden calla": "كالا ذهبية (أي من عدة أنواع كالا من جنس زانتيديسكيا ذات قنابات صفراء)",
 "golden chain": "سلسلة ذهبية, لابورنوم شائع (شجيرة زينة أو شجرة من جنس لابورنوم؛ تزرع غالباً لزينة عيد الفصح)",
 "golden chinkapin": "شنكابين ذهبي, شنكابين عملاق (شجرة زينة صغيرة دائمة الخضرة من ساحل المحيط الهادئ أوراقها الخضراء الصفراء اللامعة صفراء من الأسفل؛ تحمل مكسرات صالحة للأكل)",
 "golden clematis": "ياسمين بري ذهبي (ياسمين بري صيني ذو أوراق مسننة وأزهار صفراء كبيرة)",
 "golden club": "أرونتيم مائي, الهراوة الذهبية (نبات مائي في جنوب شرق الولايات المتحدة له أوراق زرقاء مخضرة وطلع يشبه الهراوة مغطى بأزهار صفراء صغيرة)",
 "golden crown beard": "أقحوان الزبدة (عشب حولي خشن رمادي مخضر أصفر الزهور؛ جنوب غرب الولايات المتحدة إلى المكسيك)",
 "golden crownbeard": "أقحوان الزبدة (عشب حولي خشن رمادي مخضر أصفر الزهور؛ جنوب غرب الولايات المتحدة إلى المكسيك)",
 "golden cup": "خشخاش التوليب المكسيكي, كأس ذهبي (موطنه المرتفعات المكسيكية يزرع لزهوره الصفراء الصافية اللامعة وأوراقه الزرقاء الرمادية المقسمة بدقة)",
 "golden delicious": "تفاح ذهبي, تفاح غولدن ديليشس (تفاح أكل حلو ذو قشرة صفراء)",
 "golden eagle": "عُقَاب ذَهَبِيّ (طَيْر من الجَوَارِح، أكبر التي تصيد منها يكنى بأبي الهَيْثَم ومعروف بحِدَّة البصر؛ حَجَر ناتئ في جَوْف البِئْر يخرق الدَلُو. ونادر)\nمثال: هو من تلقى العقاب الأكبر.",
 "golden everlasting": "ذهب الشمس, زهرة القش (نبات أسترالي متوطن في إسبانيا له زهور صفراء ليمونية إلى ذهبية عميقة؛ الخيار المتكرر لمحبي الزهور المجففة)",
 "golden fairy lantern": "زنبق الكرة الأصفر, فانوس الجنية الذهبي (زنبق كروي له عناقيد متفرعة مفتوحة من الزهور الصفراء الصافية بيضاوية الشكل؛ شمال كاليفورنيا)",
 "golden fern": "سرخس جلدي, سرخس ذهبي (سرخس مستنقعات استوائي قوي (خاصة أمريكا الاستوائية) له سعف كبير بأكياس أبواغ صفراء ذهبية تغطي الجوانب السفلية) / سرخس ذهبي (سرخس أمريكي استوائي له سعف بجوانب سفلية ذهبية فاتحة)",
 "golden fig": "تين خانق, تين ذهبي (شجرة خانقة موطنها جنوب فلوريدا وجزر الهند الغربية؛ تبدأ كنبات هوائي وتطور في النهاية العديد من الجذور الهوائية السميكة وتغطي مساحات هائلة)",
 "golden fleece": "الجزة الذهبية (في الأساطير اليونانية، جزة من الذهب يملكها ملك كولخيس ويحرسها تنين في بستان مقدس؛ استعادها جاسون والأرجونوتس)",
 "golden gate bridge": "جِسْر البَوَّابَة الذَهَبِيَّة (شَجُعَ، جرُؤ؛ أقدم على الخطر واجترأ)\nمثال: اذهب إلى الجسر.",
 "golden glow": "توهج ذهبي (عشب متفرع طويل جداً برؤوس زهور صفراء مزدوجة كثيرة ملفتة للنظر)",
 "golden gram": "لوبياء شعاعية, ماش (بذور نبات الماش المستخدمة كغذاء) / فول مونج, ماش (بذرة نبات الماش؛ تستخدم للغذاء)",
 "golden groundsel": "باكرا ذهبية, شيخة ذهبية (عشب ضار في شرق الولايات المتحدة إلى تكساس له أزهار صفراء ذهبية؛ يصبح أحياناً غزواً؛ يوضع أحياناً في جنس شيخة)",
 "golden hamster": "هامستر ذهبي, هامستر سوري (هامستر صغير فاتح اللون يُربى غالباً كحيوان أليف)",
 "golden handshake": "مصافحة ذهبية, مكافأة نهاية خدمة سخية (اتفاقية إنهاء خدمة مربحة تُعرض على موظف (عادة كحافز للتقاعد))",
 "golden heather": "خلنج ذهبي, خلنج كاذب (نبات أمريكي شمالي دائم الخضرة منبطح يشبه الخلنج بزهور صفراء)",
 "golden honey plant": "فيربيسينا متبادلة الأوراق (عشب معمر بزهور صفراء ملفتة للنظر؛ شرق الولايات المتحدة)",
 "golden horde": "الْقَبِيلَة الذَّهَبِيَّة",
 "golden horn": "الْقَرْن الذَّهَبِي",
 "golden ironweed": "فيربيسينا متبادلة الأوراق (عشب معمر بزهور صفراء ملفتة للنظر؛ شرق الولايات المتحدة)",
 "golden jackal": "اِبْن آوَى الذَّهَبِيّ (الولد الذكر)\nمثال: هو له ابن صغير.",
 "golden larch": "لاريكس ذهبي, لاريكس كاذب (صنوبرية صينية متساقطة الأوراق تشبه اللاريكس بأوراق صفراء ذهبية)",
 "golden maidenhair": "بوليبودي شائع, سرخس الجدار (سرخس صخري أو أرضي يشكل حصيرة بجذامير زاحفة وسعف ريشي كبير يوجد في جميع أنحاء أمريكا الشمالية وأوروبا وأفريقيا وشرق آسيا)",
 "golden marguerite": "أقحوان الصباغين, بابونج أصفر (عشبة أوراسية معمرة بأوراق مقسمة مشعرة وزهور صفراء؛ متوطنة في أمريكا الشمالية)",
 "golden mean": "الوسط الذهبي (الوسط بين نقيضين) / النِّسْبَة الذَّهَبِيَّة (العلاقة التناسبية بين قسمين من خط أو بُعدين لشكل مستوٍ بحيث تكون النسبة بين القصير والطويل كالنسبة بين الطويل ومجموعهما)",
 "golden mole": "خلد ذهبي (خلد من جنوب أفريقيا ذو شعر حماية قزحي اللون مختلط بالفراء السفلي)",
 "golden oak mushroom": "شيتاكي (فطر شرق آسيوي صالح للأكل له قبعة ذهبية أو بنية داكنة إلى سوداء وساق غير صالح للأكل)",
 "golden oldie": "أغنية قديمة (أغنية كانت مشهورة سابقاً)",
 "golden oriole": "صفارية ذهبية (طائر مغرد أصفر ساطع بأجنحة سوداء)",
 "golden parachute": "مِظَلَّة هُبُوط ذَهَبِيَّة",
 "golden pea": "بازلاء ذهبية, ترمس كاذب (عشب كثيف في غرب الولايات المتحدة له زهور صفراء تشبه البازلاء)",
 "golden pheasant": "تدرج ذهبي (تدرج متوج زاهي الألوان من جبال غرب ووسط آسيا)",
 "golden pholiota": "فوليوت ذهبي (فطر جميل ذو خياشيم صفراء يوجد من ألاسكا جنوباً على طول الساحل)",
 "golden plover": "زقزاق ذهبي (زقزاق من أوروبا وأمريكا يتميز بظهر معلم ببقع صفراء ذهبية)",
 "golden polypody": "بوليبودي شائع, سرخس الجدار (سرخس صخري أو أرضي يشكل حصيرة بجذامير زاحفة وسعف ريشي كبير يوجد في جميع أنحاء أمريكا الشمالية وأوروبا وأفريقيا وشرق آسيا) / بوليبودي ذهبي, سرخس قدم الأرنب (سرخس أمريكي استوائي بجذامير قشرية بنية يزرع لسعفه الكبير المفصص بعمق ذي اللون الأخضر المزرق الداكن؛ يوضع أحياناً في جنس بوليبوديوم)",
 "golden pothos": "بوثوس, بوثوس ذهبي (ليانا دائمة الخضرة تزرع على نطاق واسع لأوراقها المبرقشة)",
 "golden potto": "أنغوانتيبو, بوتو ذهبي (نوع من الليمور الأصفر أو الذهبي)",
 "golden ragwort": "باكرا ذهبية, شيخة ذهبية (عشب ضار في شرق الولايات المتحدة إلى تكساس له أزهار صفراء ذهبية؛ يصبح أحياناً غزواً؛ يوضع أحياناً في جنس شيخة)",
 "golden rain": "سلسلة ذهبية, لابورنوم شائع (شجيرة زينة أو شجرة من جنس لابورنوم؛ تزرع غالباً لزينة عيد الفصح)",
 "golden ratio": "الرَقْم الذَهَبِيّ",
 "golden retriever": "جولدن ريتريفر",
 "golden rule": "القاعدة الذهبية (أمر يستند إلى كلمات يسوع في الموعظة على الجبل) / قَاعِدَة ذَهَبِيَّة (أي قاعدة مهمة وأساسية)\nمثال: فكل ما تريدون أن يفعل الناس بكم افعلوا هكذا أنتم أيضاً بهم",
 "golden saxifrage": "كاسر الحجر الذهبي (الذي قام بالكَسْر؛ اسم من أسماء العُقَاب)",
 "golden seal": "الجذر الأصفر, خاتم الذهب (عشب معمر في شمال شرق الولايات المتحدة له ساق جذري أصفر سميك وعقدي وأوراق مستديرة كبيرة)",
 "golden section": "النِّسْبَة الذَّهَبِيَّة (العلاقة التناسبية بين قسمين من خط أو بُعدين لشكل مستوٍ بحيث تكون النسبة بين القصير والطويل كالنسبة بين الطويل ومجموعهما)",
 "golden shiner": "شاينر الذهبي (سمكة شاينر في شرق أمريكا الشمالية لها بريق ذهبي؛ تسمى أحياناً أيضاً 'بريم')",
 "golden shower": "خِيَار شَنْبَر, خَرُّوب هِنْدِيّ (الإسم من الإختيار ، وهو إنتقاء شيء فيكون خير من غيره؛ صيغة جمع لخير ، بمعنى أفضل)\nمثال: لم يكن لدي خيار.",
 "golden shower tree": "خيار شمبر, شجرة المطر الذهبي (شجرة متساقطة الأوراق أو شبه دائمة الخضرة لها زهور بنية داكنة إلى صفراء معطرة في عناقيد متدلية وقرون يستخدم لبها طبياً؛ آسيا الاستوائية ووسط وجنوب…)",
 "golden spleen": "كاسر الحجر الذهبي (الذي قام بالكَسْر؛ اسم من أسماء العُقَاب)",
 "golden star": "نجمة ذهبية (نبات كاليفورنيا ذو أوراق تشبه العشب وأزهار برتقالية مبهرجة)",
 "golden stars": "نجمة ذهبية (نبات كاليفورنيا ذو أوراق تشبه العشب وأزهار برتقالية مبهرجة)",
 "golden syrup": "تريكل, شراب ذهبي (شراب قصب شاحب اللون)",
 "golden thistle": "شوك ذهبي (أي من الأعشاب الشائكة المتعددة في البحر الأبيض المتوسط من جنس سكوليموس ذات رؤوس زهور صفراء)",
 "golden thread": "خيط الذهب, كوبتيس (نبات معمر منخفض النمو في غابات أمريكا الشمالية له أوراق ثلاثية وساق جذري أصفر وأزهار بيضاء)",
 "golden trumpet": "ألمندا شائعة, بوق ذهبي (نبات متسلق دائم الخضرة قوي من أمريكا الجنوبية ذو أوراق جلدية لامعة وأزهار صفراء ذهبية)",
 "golden warbler": "هازجة صفراء (هازجة غابات أمريكية صفراء الحنجرة)",
