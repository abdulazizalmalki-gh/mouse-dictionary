 "haitian creole": "الكريولية الهايتية (لغة كريولية يتحدث بها معظم الهايتيين؛ تعتمد على الفرنسية ولغات أفريقية مختلفة)",
 "haitian creole language": "الكريولية الهايتية (لغة كريولية يتحدث بها معظم الهايتيين؛ تعتمد على الفرنسية ولغات أفريقية مختلفة)",
 "haitian monetary unit": "وحدة نقدية هايتية (الوحدة النقدية في هايتي)",
 "haj": "الحج (الركن الخامس من أركان الإسلام وهو الحج إلى مكة خلال شهر ذي الحجة؛ يُتوقع من المسلم القيام برحلة دينية إلى مكة والكعبة مرة واحدة على الأقل في العمر)\nمثال: بالنسبة للمسلم يعتبر الحج أسمى عبادة",
 "haji": "حاج (مصطلح عربي يطلق احتراماً على من أدى فريضة الحج إلى مكة)",
 "hajj": "حَجّ, الْحَجّ (القَصْد والزِيَارَة على جهة التَعْظِيم؛ زيارة مكان مُقَدَّس بهدف ديني ويوجد عند معظم الديانات منها اليَهُودِيَّة والمَسِيحِيَّة والإسْلام)\nمثال: ذهب رجل للحج وترك خلفه خمس بنات وكلبة.",
 "hajji": "حَاجّ, حَاجَّة (افتقر)\nمثال: لا أرى لذلك حاجة.",
 "haka": "هَاكَا",
 "hake": "نازلي (أي من عدة أسماك غذائية بحرية مرتبطة بالقد) / سمك الميرلو, نازلي (اللحم قليل الدهن لسمكة مشابهة للقد)",
 "hakea laurina": "زهرة الوسادة, هاكيا لورينية (شجيرة طويلة متناثرة ذات أزهار كروية كبيرة قرمزية صفراء؛ غرب أستراليا)",
 "hakea leucoptera": "خشب الإبرة (شجيرة كثيفة كبيرة ذات أوراق مدببة لاذعة وأزهار بيضاء كريمية؛ وسط وشرق أستراليا)",
 "hakea lissosperma": "شجيرة الإبرة (شجيرة ذات أوراق صلبة لاذعة على شكل إبرة وأزهار بيضاء؛ شرق أستراليا)",
 "hakeem": "حكيم (طبيب مسلم)",
 "hakenkreuz": "صليب معقوف (الشعار الرسمي للحزب النازي والرايخ الثالث؛ صليب بأذرع مثنية بزوايا قائمة في اتجاه عقارب الساعة)",
 "hakham": "حاخام (لقب عبري للاحترام يطلق على الرجل الحكيم والمتعلم تعليماً عالياً)",
 "hakim": "حكيم (طبيب مسلم) / حاكم (حاكم أو والٍ أو قاضٍ مسلم)",
 "hakka": "لغة الهاكا (لهجة صينية يتحدث بها شعب الهاكا في جنوب شرق الصين) / هاكا (عضو في شعب جنوب شرق الصين (خاصة هونغ كونغ وكانتون وتايوان) هاجروا من الشمال في القرن الثاني عشر)",
 "hakka dialect": "لغة الهاكا (لهجة صينية يتحدث بها شعب الهاكا في جنوب شرق الصين)",
 "halabja": "حَلَبْجَة",
 "halacha": "الشريعة اليهودية, هالاخاه (أدب تلمودي يتعامل مع القانون وتفسير القوانين في الكتب المقدسة العبرية)",
 "halaka": "الشريعة اليهودية, هالاخاه (أدب تلمودي يتعامل مع القانون وتفسير القوانين في الكتب المقدسة العبرية)",
 "halakah": "الشريعة اليهودية, هالاخاه (أدب تلمودي يتعامل مع القانون وتفسير القوانين في الكتب المقدسة العبرية)",
 "halal": "حَلَال (ضد الحرام، وسمي كذلك لإنحلال عقد الحظر عنه؛ عند البدو: ما يملكه المرء من الإبل والمواشي. سمي كذلك لأنه حلال له وليس في ملكه حرمة)\nمثال: لست بحلال مشاكل.",
 "halala": "هَلَلَة",
 "halalball": "كُرَة حَلَال",
 "halberd": "فأس برمح, مطرد (رمح مزود برأس فأس)",
 "halberdier": "حامِل المُطَرَّد (حارس يحمل سلاح المطرد (كرمز لواجبه))",
 "halchidhoma": "هالشيدوما (فرد من شعب هندي في أمريكا الشمالية في وادي نهر كولورادو بالقرب من مصب نهر جيلا)",
 "halcion": "تريازولام, هالسيون (شكل من أشكال البنزوديازيبين (الاسم التجاري هالسيون) يوصف بشكل متكرر كحبوب منومة؛ يعطى عادة للأشخاص الذين يجدون صعوبة في النوم)",
 "halcyon": "ذَهَبِيّ, زَاهِر (يتسم بالسلام والازدهار) / هَانِئ, وَادِع (هَادِئٌ وَسَلَامِيٌّ بِشَكْلٍ مِثَالِيّ؛ يُوحِي بِالطُّمَأْنِينَةِ السَّعِيدَة) / طائر الهالسيون الأسطوري (طائر أسطوري يقال إنه يتكاثر في وقت الانقلاب الشتوي في عش يطفو على البحر ولديه القدرة على تهدئة الرياح والأمواج)",
 "haldea striatula": "ثعبان الأرض الشرقي (ثعبان صغير رمادي محمر من شرق أمريكا الشمالية)",
 "haldol": "هالدول, هالوبيريدول (مهدئ (الاسم التجاري هالدول) يستخدم لعلاج بعض الاضطرابات الذهانية ومتلازمة توريت)",
 "hale": "صَحيح الجِسْم, مُعافًى تَمامًا (يَتَمَتَّع بِصِحَّة تامَّة وسَلامَة كامِلَة)",
 "haleem": "حَلِيم (حَليم: (اسم)؛ حليم: (اسم))",
 "haleness": "سلامة, صحة تامة (حالة من الصحة الجيدة القوية)",
 "haler": "هالر (100 هالر تساوي 1 كورونا في جمهورية التشيك) / هالر (100 هالر تساوي 1 كورونا في سلوفاكيا)",
 "halesia carolina": "شجرة الجرس الفضي, شجرة قطرة الثلج (شجرة متوسطة الحجم من فرجينيا الغربية إلى فلوريدا وتكساس)",
 "halesia tetraptera": "شجرة الجرس الفضي, شجرة قطرة الثلج (شجرة متوسطة الحجم من فرجينيا الغربية إلى فلوريدا وتكساس)",
 "half": "نِصْف, نُصْف",
 "half a dozen": "سُدَاسِيّ, سِتَّة (العدد الأصلي الذي هو مجموع خمسة وواحد)",
 "half binding": "تجليد نصفي (تجليد كتب يكون فيه الكعب وجزء من الجوانب مكسواً بمادة وبقية الغلاف بمادة أخرى)",
 "half blood": "أخ غير شقيق (أحد الإخوة الذين يشتركون في والد واحد فقط)",
 "half boot": "جزمة نصفية, حذاء قتالي (حذاء يصل إلى منتصف الطريق نحو الركبة)",
 "half brother": "أخ غير شقيق (أخ يشترك معك في أحد الوالدين فقط)",
 "half cross stitch": "نصف غرزة متقاطعة (غرزة متقاطعة واحدة بشكل قطري)",
 "half crown": "نصف كراون (عملة إنجليزية قيمتها نصف كراون)",
 "half dollar": "نصف دولار (عملة أمريكية قيمتها نصف دولار)",
 "half door": "باب نصفي, باب هولندي (باب خارجي مقسوم نصفين أفقياً؛ يمكن إغلاق أو فتح أي من النصفين بشكل مستقل)",
 "half dozen": "سِتَّة (يَدُلُّ عَلَى العَدَد 6)",
 "half eagle": "نصف نسر (عملة ذهبية سابقة في الولايات المتحدة بقيمة 5 دولارات)",
 "half gainer": "نصف غطسة عكسية (غطسة يرمي فيها الغطاس قدميه للأمام ولأعلى لإكمال نصف شقلبة خلفية ويدخل الماء مواجهاً للوح الغطس)",
 "half hatchet": "بلطة نصفية (فأس صغيرة برأس فأس نصفي)",
 "half hitch": "نصف عقدة (عقدة تستخدم لربط حبل مؤقتاً بجسم ما؛ عادة ما تكون مزدوجة)",
 "half life": "عمر النصف (الوقت اللازم لشيء ما للانخفاض إلى نصف قيمته الأولية (على وجه الخصوص، الوقت اللازم لتحلل نصف الذرات في مادة مشعة))",
 "half mask": "قناع عين, قناع نصفي (قناع يغطي الجزء العلوي من الوجه مع وجود ثقوب للعينين)",
 "half mile": "نصف ميل (وحدة للطول تساوي نصف ميل)",
 "half nelson": "نصف نيلسون (مسكة مصارعة يضع فيها الحامل ذراعًا واحدة تحت ذراع الخصم ويضغط على الرقبة)",
 "half note": "بيضاء, نوتة نصفية (نوتة موسيقية لها قيمة زمنية تعادل نصف نوتة كاملة)",
 "half page": "نصف صفحة (شيء يغطي (الجزء العلوي أو السفلي) نصف الصفحة)",
 "half past": "السَّاعَة وَالنِّصْف, السَّاعَة الْوَاحِدَة وَالنِّصْف",
 "half pound": "نصف رطل (8 أوقيات (أفرديبوا))",
 "half rest": "سكتة نصفية (سكتة موسيقية لها قيمة زمنية تعادل نصف سكتة كاملة أو مساوية في المدة لنبضتين في الزمن الشائع)",
 "half sister": "أخت غير شقيقة (أخت تشترك معك في أحد الوالدين فقط)",
 "half snipe": "شنقب صغير (شنقب صغير قصير المنقار من العالم القديم)",
 "half sole": "نصف نعل (نعل حذاء يمتد من القوس إلى إصبع القدم)",
 "half step": "نصف بعد, نصف نغمة (الفاصل الموسيقي بين المفاتيح المتجاورة على آلة لوحة المفاتيح)",
 "half title": "العنوان الموجز (صفحة أولى في بعض الكتب تعرض فقط عنوان الكتاب)",
 "half track": "نصف مجنزرة (مسار يحيط بالعجلات الخلفية فقط) / مركبة نصف مجنزرة (مركبة آلية تدفع بنصف جنازير؛ تستخدم كثيراً من قبل الجيش)",
 "half volley": "نصف طائرة (رد تنس يتم بضرب الكرة فور ارتدادها)",
 "half-and-half": "مناصفة (بنسب متساوية) / نِصْفٌ وَنِصْف (بأجزاء متساوية) / هاف أند هاف (نصف حليب ونصف كريمة خفيفة؛ يحتوي على 10% إلى 18% من دهن الزبدة)\nمثال: تم تقسيمها مناصفة",
 "half-and-half dressing": "تتبيلة النصف بالنصف (نصف مايونيز ونصف فينيغريت متبل بالثوم المفروم والأنشوفة المهروسة وجبن البارميزان المبشور؛ جيدة خاصة للسلطات المشكلة)",
 "half-baked": "غَيْرُ مُكْتَمِلِ النُّضْج, نَاقِصُ الطَّهْو (لَمْ يُطْهَ بِالقَدْرِ الكَافِي) / أَحْمَق, طَائِش (سخيف وعديم الجدوى تماماً)",
 "half-bastion": "نصف حصن (في العمارة العسكرية، حصن مبني من وجه واحد وجناح واحد)",
 "half-blooded": "نِصْفُ دَم, نِصْفُ سُلَالَة ((في الحيوانات) لديه أحد الأبوين فقط من سلالة أصيلة)",
 "half-bound": "نِصْف مُجَلَّد ((للكتب) مجلد الظهر بمادة والجوانب بمادة أخرى)",
 "half-bred": "نِصْفُ دَم, نِصْفُ سُلَالَة ((في الحيوانات) لديه أحد الأبوين فقط من سلالة أصيلة)",
 "half-breed": "نِصْفُ دَم, نِصْفُ سُلَالَة ((في الحيوانات) لديه أحد الأبوين فقط من سلالة أصيلة) / هجين (مصطلح مهين لنسل أبوين من مجموعات عرقية مختلفة (خاصة من أصول قوقازية وهندية أمريكية))",
 "half-brother": "أخ غير شقيق (أخ يشترك معك في أحد الوالدين فقط)",
 "half-caste": "مولد, هجين (مصطلح مهين لنسل أبوين من مجموعات عرقية أو ثقافات مختلفة)",
 "half-century": "نصف قرن (فترة 50 سنة)",
 "half-clothed": "شَحِيح اللِّبَاس, شِبْه عَارٍ (يرتدي ملابس غير كافية)",
 "half-cock": "ارتجال مرتبك, تسرع (ارتباك ناتج عن نقص التحضير)",
 "half-consciousness": "شبه وعي, نصف وعي (خاصية كون المرء واعياً أو حساساً جزئياً فقط لشيء ما)",
 "half-crazed": "مُجَنَّن, مُختَلُّ العَقْل (دُفِع إلى الجنون؛ فَقَدَ عقله)",
 "half-dozen": "سِتَّة (يَدُلُّ عَلَى العَدَد 6)",
 "half-dugout": "نصف حفرة (مأوى بدائي، غالباً ما يكون مؤقتاً، حيث يتم حفر جزء كبير من هيكله تحت مستوى الأرض؛ عادة ما يكون له جدران وسقف من العشب)",
 "half-evergreen": "شِبْه دَائِم الخُضْرَة (عن نبات ليس دائم الخضرة بشكل كامل)",
 "half-free morel": "موريل نصف حر (موريل جزؤه الخصب ذو النتوءات والحفر متصل بالساق لنحو نصف طوله)",
 "half-hardy": "شِبْهُ مُقَاوِم ((للنباتات) يحتاج إلى حماية من الصقيع)",
 "half-hearted": "فَاتِرُ الهِمَّة, مُتَرَدِّد (يشعر أو يُظهِر اهتماماً أو حماسة قليلة)",
 "half-heartedly": "بفتور, بقلب غير حاضر (بدون حماس؛ بطريقة فاترة)\nمثال: حاولت بفتور",
 "half-holiday": "نصف يوم عطلة (يوم يكون نصفه خالياً من العمل أو الواجب)",
 "half-hour": "نِصْف سَاعَة",
 "half-hourly": "كل نصف ساعة",
 "half-intensity": "نصف الشدة (نصف الشدة القصوى)",
 "half-length": "مُختَصَر إِلَى النِّصْف (اختُصِرَ إلى نصف طوله الأصلي) / لِلنِّصْف العُلْوِيّ, نِصْفِيّ (يُمثل النصف العلوي فقط من الجسم) / صورة نصفية (بورتريه يظهر الجسم من الخصر لأعلى فقط)",
 "half-life": "عمر النصف (الوقت اللازم لشيء ما للانخفاض إلى نصف قيمته الأولية (على وجه الخصوص، الوقت اللازم لتحلل نصف الذرات في مادة مشعة))",
 "half-light": "ضوء خافت, غلس (ضوء رمادي (كما في الفجر أو الغسق أو في الدواخل المعتمة))",
 "half-mast": "تنكيس, منتصف الصاري (موضع على مسافة ما أسفل قمة الصاري يتم إنزال العلم إليه في الحداد أو للإشارة إلى الاستغاثة)",
 "half-moon": "تَرْبِيع",
 "half-moon bastion": "حصن نصف دائري (نوع من الحصون استخدم في القرن السادس عشر؛ فقد شعبيته بسبب صعوبة تركيز نيران المدافع الموزعة حول منحنى)",
 "half-pay": "نصف أجر, نصف راتب (أجر مخفض يدفع لشخص لا يعمل بدوام كامل)",
 "half-pint": "ضئيل الجسم, قزم (مصطلحات مهينة للأشخاص صغار الحجم)",
 "half-price": "بنصف السعر (مقابل نصف السعر)\nمثال: اشترته بنصف السعر أثناء التخفيضات",
 "half-relief": "نقش بارز متوسط (نحت بارز بين النقش المنخفض والنقش العالي)",
 "half-seas-over": "مُتَرَنِّح ((عَامِّيَّة بِرِيطَانِيَّة) سَكْرَان)",
 "half-sister": "أخت غير شقيقة (أخت تشترك معك في أحد الوالدين فقط)",
 "half-size": "بِنِصْف الحَجْم (نصف الحجم المعتاد أو العادي)",
 "half-slip": "تنورة داخلية (رداء داخلي يلبس تحت التنورة)",
 "half-staff": "تنكيس, منتصف الصاري (موضع على مسافة ما أسفل قمة الصاري يتم إنزال العلم إليه في الحداد أو للإشارة إلى الاستغاثة)",
 "half-term": "عطلة نصف الفصل (إجازة قصيرة في منتصف الفصل الدراسي تقريباً)\nمثال: جاء للزيارة في عطلة نصف الفصل",
 "half-timber": "نِصْفُ خَشَبِيّ (ذُو هَيْكَلٍ خَشَبِيٍّ مَكْشُوفٍ مَعَ فَرَاغَاتٍ مَمْلُوءَةٍ بِالبِنَاء)",
 "half-timbered": "نِصْفُ خَشَبِيّ (ذُو هَيْكَلٍ خَشَبِيٍّ مَكْشُوفٍ مَعَ فَرَاغَاتٍ مَمْلُوءَةٍ بِالبِنَاء)",
 "half-time": "بَدَوَام جُزْئِيّ (لأقل من عدد الساعات القياسي) / بِدَوَام جُزْئِيّ, نِصْف الوَقْت (يَتَطَلَّبُ نِصْف الوَقْت المِعْيَارِيّ أَوِ المُعْتَاد لِنَشَاط مَا)\nمثال: يعمل بدوام جزئي",
 "half-track": "نِصْف مُجَنْزَر (له جنازير في الخلف وعجلات في الأمام)",
 "half-tracked": "نِصْف مُجَنْزَر (له جنازير في الخلف وعجلات في الأمام)",
 "half-truth": "نصف الحقيقة (بيان صحيح جزئياً يهدف إلى الخداع أو التضليل)",
 "half-wit": "أحمق, غبي (شخص غبي وغير كفء) / أبله, متخلف عقلياً (شخص ذو ذكاء دون الطبيعي)",
 "half-witted": "بَطِيء الفَهْم, ضَعِيف العَقْل (متأخر في التطور العقلي والذهني)",
 "half-yearly": "كل ستة أشهر, نصف سنوياً (كل نصف سنة) / نِصْفُ سَنَوِيّ (يحدث أو يُدفع مرتين في السنة)",
 "halfback": "ظهير نصفي, هاف باك ((كرة قدم أمريكية) مركز ظهير في فريق كرة القدم، عموماً أصغر حجماً من الظهير الكامل) / ظهير نصف ((في كرة القدم الأمريكية) الظهير الراكض الذي يلعب مركز الظهير النصف الهجومي)",
 "halfbeak": "نصف منقار (أسماك استوائية وشبه استوائية بحرية ومن المياه العذبة ذات جسم ممدود وفك سفلي طويل بارز)",
 "halfhearted": "تعوزه الحماسَة, مفتقر إلى الحماسَة",
 "halfheartedness": "عدم حماس, فتور (سمة كون الشخص فاتراً؛ غير مخلص؛ يفتقر إلى الطاقة الكاملة أو الجهد أو الالتزام أو العزم)",
 "halfpenny": "نصف بنس",
 "halfpennyworth": "ما قيمته نصف بنس (الكمية التي يمكن شراؤها بنصف بنس)",
 "halftime": "استراحة الشوطين (استراحة بين الشوط الأول والثاني من المباراة)",
 "halftone": "لوحة تظليل, نقش ضوئي (نقش يستخدم لإعادة إنتاج رسم توضيحي) / نصفية الألوان, هالف تون (مطبوعة تم الحصول عليها من الحفر الضوئي)",
 "halftone engraving": "لوحة تظليل, نقش ضوئي (نقش يستخدم لإعادة إنتاج رسم توضيحي)",
 "halfway": "فِي مُنْتَصَف الطَّرِيق (في نصف المسافة؛ في المنتصف) / مُنْتَصَف, وَسَط (على مسافة متساوية من الأطراف) / جُزْئِيّ, نِصْفِيّ (لا يشمل إلّا النصف أو جزءًا فقط) / فِي مُنْتَصَفِ الطَّرِيق (عِنْدَ نُقْطَةٍ وَسَطٍ بَيْنَ طَرَفَيْنِ)\nمثال: كان في منتصف السلم عندما سقط",
 "haliaeetus leucocephalus": "عقاب رخماء (عقاب كبيرة من أمريكا الشمالية لها رأس أبيض وأجنحة وجسم داكن)",
 "haliaeetus leucorhyphus": "عقاب السمك (من جنوب شرق أوروبا ووسط آسيا)",
 "haliaeetus pelagicus": "عقاب البحر ستيلر (يوجد على سواحل شمال غرب المحيط الهادئ)",
 "haliatus albicilla": "عقاب البحر أبيض الذيل (عقاب ضخم بني رمادي بذيل أبيض قصير وتدي الشكل؛ من أوروبا وجرينلاند)",
 "halibut": "هَلْبُوت",
 "halibut-liver oil": "زيت كبد الهلبوت (زيت دهني من أكباد الهلبوت يُستخدم كمصدر لفيتامين أ)",
 "halicoeres bivittatus": "سمكة سليبري ديك, لبروسية صغيرة (سمكة لبروسية صغيرة تعيش في المحيط الأطلسي الاستوائي)",
 "halicoeres radiatus": "بودينغ وايف, سمكة لبروسية (سمكة لبروسية مائلة للزرقة والبرونز؛ توجد من فلوريدا كيز إلى البرازيل)",
 "halide": "هَالِيت",
