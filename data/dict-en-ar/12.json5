 "granny's bonnets": "أكيليجا شائعة, قبعات الجدة (كولومبين أوروبي شائع ذو زهور قصيرة المهماز متنوعة الألوان (أبيض أو أزرق إلى أرجواني أو أحمر)؛ متوطن في الولايات المتحدة)",
 "granola": "جرانولا",
 "granola bar": "قالب جرانولا (قالب بسكويت مصنوع من الجرانولا)",
 "grant": "مَنَحَ / مِنْحة",
 "grant-in-aid": "منحة مساعدة (منحة من حكومة مركزية لحكومة محلية) / منحة دراسية, منحة مشروع (منحة لشخص أو مدرسة لمشروع تعليمي ما)",
 "granted": "مَفْرُوض, مُسَلَّم بِه (مُعتَرف به بوصفه افتراضًا)",
 "grantee": "الممنوح له, المنقول إليه (شخص يُنقل إليه سند ملكية العقار) / متلقي المنحة, ممنوح له (متلقي منحة)",
 "granter": "مَانِح, وَاهِب (شخص يمنح أو يعطي شيئاً ما)",
 "granting immunity": "إعفاء, حصانة (فعل استثناء شخص ما أو منحه الحصانة)\nمثال: مُنح حصانة من الملاحقة القضائية",
 "grantor": "مَانِح (شخص يقدم منحة بصيغة قانونية)\nمثال: نُقلت الملكية من المانح إلى الممنوح له",
 "grantor trust": "ائتمان المانح, ائتمان كليفورد (ائتمان يتم إنشاؤه لتحويل الدخل إلى شخص يخضع لضريبة بمعدل أقل من المانح لمدة 10 سنوات أو أكثر)",
 "granular": "حُبَيْبِيّ, كُونْدِرِيتِيّ (لديه هيكل حبيبي مثل هيكل الكوندريت (النيازك الحجرية)) / حُبَيْبِيّ, مُحَبَّب (مؤلّف من جزيئات تشبه الدقيق في القوام أو مغطّى بها)",
 "granular pearlite": "بيرليت حبيبي (إذا برد الفولاذ أو الحديد ببطء شديد، قد يتواجد السمنتيت في كريات بدلاً من طبقات)",
 "granularity": "حببية, خشونة (جودة التكون من جزيئات كبيرة نسبياً)",
 "granulated": "مُحَبَّب (جُعل حبيبيًّا أو صِيغ على شكل حبيبات)",
 "granulated sugar": "سكر حبيبي (سكر على شكل حبيبات صغيرة)",
 "granulation": "تحبيب (فعل تشكيل شيء ما إلى حبيبات) / تحبب, نسيج حبيبي (نسيج ضام جديد وأوعية دموية دقيقة تتشكل على أسطح الجرح أثناء عملية الشفاء)\nمثال: تحبيب الأدوية",
 "granulation tissue": "تحبب, نسيج حبيبي (نسيج ضام جديد وأوعية دموية دقيقة تتشكل على أسطح الجرح أثناء عملية الشفاء)",
 "granulator": "آلة تحبيب (آلة تشكل المواد (مثل البلاستيك والزجاجات والمواد العضوية وما إلى ذلك) إلى حبيبات)",
 "granulator machine": "آلة تحبيب (آلة تشكل المواد (مثل البلاستيك والزجاجات والمواد العضوية وما إلى ذلك) إلى حبيبات)",
 "granule": "حبيبة (حبة صغيرة جداً)",
 "granuliferous": "حبيبي (منتج للحبيبات أو مليء بها)",
 "granulocyte": "خلية محببة (خلية دم بيضاء تحتوي على حبيبات في السيتوبلازم)",
 "granulocytic": "حبيبي (من أو يتعلق بالخلايا المحببة)",
 "granulocytic leukemia": "ابيضاض الدم النقوي (ورم خبيث في الأنسجة المكونة للدم؛ يتميز بتكاثر الخلايا النقوية ووجودها في الدم)",
 "granulocytopenia": "ندرة المحببات (اضطراب دموي حاد يتميز بانخفاض حاد في الخلايا المحببة)",
 "granuloma": "ورم حبيبي (ورم يتكون من نسيج حبيبي ناتج عن إصابة أو التهاب أو عدوى)",
 "granuloma inguinale": "ورم حبيبي أربي",
 "granuloma venereum": "ورم حبيبي أربي",
 "granulomatous": "ورمي حبيبي (متعلق بـ أو يتميز بالأورام الحبيبية)",
 "granulose": "حُبَيْبِيّ, مُحَبَّب (مؤلّف من جزيئات تشبه الدقيق في القوام أو مغطّى بها)",
 "granville wilt": "ذبول غرانفيل (ذبول بكتيري يصيب نباتات التبغ)",
 "grape": "عِنَب",
 "grape arbor": "عريشة عنب (عريشة يُزرع فيها العنب)",
 "grape arbour": "عريشة عنب (عريشة يُزرع فيها العنب)",
 "grape fern": "سرخس العنب (سرخس من جنس بوتريشيوم له سعفة خصبة تحمل عناقيد صغيرة تشبه العنب من أكياس الأبواغ)",
 "grape hyacinth": "ياسنت العنب (أي من الياسنت الربيعي المبكر المتنوع موطنه أوراسيا ذو سنابل كثيفة من الزهور الزرقاء المستديرة تشبه عناقيد العنب الصغيرة)",
 "grape jelly": "هلام العنب (هلام مصنوع من عصير العنب)",
 "grape juice": "عصير عنب (سائلٌ سُكَّريٌّ يُستخرج من بعض الثّمار عند عَصْرها)\nمثال: هل تريد عصير فاكهة؟",
 "grape louse": "قمل العنب (مدمر لنباتات العنب المختلفة)",
 "grape phylloxera": "قمل العنب (مدمر لنباتات العنب المختلفة)",
 "grape sugar": "ديكستروز, سكر العنب (متصاوغ للجلوكوز يوجد في العسل والفواكه الحلوة)",
 "grape vine": "عنب, كرمة العنب",
 "grape-leaf begonia": "بيغونيا ورق العنب (بيغونيا درنية أو شبه درنية من جنوب أفريقيا لها أوراق بيضاوية مفصصة بشكل ضحل وزهور بيضاء صغيرة)",
 "grape-sized": "بِحَجْمِ حَبَّةِ الْعِنَبِ (بحجم حبة عنب تقريبًا)",
 "grapefruit": "لَيْمُون هِنْدِيّ, جْرِيب فْرُوت",
 "grapefruit juice": "عصير الجريب فروت, عصير الليمون الهندي (عصير مستخرج من الجريب فروت)",
 "grapefruit peel": "قشر جريب فروت (شرائح من قشر الجريب فروت مطبوخة في شراب السكر ومغلفة بالسكر)",
 "grapefruit spoon": "ملعقة برتقال (أداة للأكل والاحتساء والطبخ وتقديم الطعام)",
 "grapelike": "شبيه بالعنب, عنبي (يشبه ثمرة كرمة العنب)",
 "grapeshot": "طلقة عنقودية (مجموعة من المقذوفات الصغيرة تطلق معاً من مدفع لإنتاج وابل من الطلقات)",
 "grapevine": "جَفْنَة, كَرْمَة",
 "grapey": "عِنَبِيّ (ذُو طَعْمٍ يُشْبِهُ العِنَب)",
