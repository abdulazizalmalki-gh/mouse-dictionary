 "hall of residence": "قاعة إقامة (سكن جامعي)",
 "hall pass": "إذن خروج, تصريح مرور مدرسي (إذن مكتوب من المعلم للطالب للخروج من الفصل وفي أروقة المدرسة)",
 "hall porter": "بَوَّاب, حارِس الباب (شخص يحرس مدخلاً)",
 "hall's honeysuckle": "عسلة هول (صنف من العسلة اليابانية ينمو ككرمة؛ استقرت كهارب عدواني في جنوب شرق الولايات المتحدة)",
 "hallah": "خبز الحلة ((اليهودية) رغيف من الخبز الأبيض يحتوي على البيض ومخمر بالخميرة؛ غالباً ما يشكل في أرغفة مضفرة ويدهن بالبيض قبل الخبز)",
 "hallelujah": "هَلِّلُويَا, هَلُولِيَا",
 "halliard": "حبل الرفع (حبل لرفع أو خفض شراع أو علم)",
 "hallmark": "بصمة, سمة فارقة (سمة أو صفة مميزة لشخص أو شيء ما) / دمغة, علامة جودة (علامة على سلعة تجارية للإشارة إلى منشئها وأصالتها)",
 "halloo": "صيحة تنبيه (صيحة لجذب الانتباه)\nمثال: أطلق صيحة عالية لكن لم يسمعه أحد",
 "hallowe'en": "عيد القديسين, هالوين (الليلة التي تسبق عيد جميع القديسين؛ غالباً ما تخصص للمقالب والأزياء التنكرية)",
 "hallowed": "مُبَجَّل, مُقَدَّس (جدير بالتبجيل والتعظيم الدينيّ)",
 "halloween": "هَالُوِين, عِيدُ جَمِيعِ القِدِّيسِين",
 "hallowmas": "1 نوفمبر, عيد جميع القديسين (عيد مسيحي لتكريم جميع القديسين؛ لوحظ لأول مرة عام 835)",
 "hallowmass": "1 نوفمبر, عيد جميع القديسين (عيد مسيحي لتكريم جميع القديسين؛ لوحظ لأول مرة عام 835)",
 "hallstand": "حامل المعاطف, شماعة المدخل (قطعة أثاث يُعلق عليها المعاطف والقبعات والمظلات؛ وعادة ما تحتوي على مرآة)",
 "hallucinate": "هَلْوَسَ",
 "hallucinating": "مُهَلْوِس, هَاذٍ (يعاني من الهذيان والهلوسة)",
