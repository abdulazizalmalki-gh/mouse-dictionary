 "gunwoman": "قاتلة مأجورة (قاتلة محترفة أنثى تستخدم مسدساً) / رامية, مسلحة (شخص أنثى تطلق النار من مسدس (فيما يتعلق بقدرتها))",
 "guomindang": "الكومينتانغ (الحزب السياسي الذي أسسه صن يات صن عام 1911؛ حكم الصين تحت قيادة شيانغ كاي شيك من عام 1928 حتى عام 1949 عندما تولى الشيوعيون السلطة وأصبح فيما بعد…)",
 "guppy": "جوبي (سمكة مياه عذبة صغيرة من أمريكا الجنوبية وجزر الهند الغربية؛ غالباً ما تُحفظ في أحواض السمك)",
 "gur": "غور, فولتية (مجموعة من اللغات النيجرية الكنغولية يتم التحدث بها بشكل أساسي في جنوب شرق مالي وشمال غانا)",
 "gurgle": "غَرْغَرَ, بَقْبَقَ",
 "gurkha": "جورخا (عضو في شعب هندوسي ينحدر من البراهمة والراجبوت الذين يعيشون في نيبال) / جوركا (عضو في القوة النيبالية التي كانت جزءاً من الجيش البريطاني لمدة 200 عام؛ معروفون بالشراسة في القتال)",
 "gurnard": "غرنار (أسماك ساحلية تعيش في القاع ذات رؤوس مدرعة شائكة وزعانف صدرية تشبه الأصابع تستخدم للزحف على طول قاع البحر)",
 "gurney": "مِحَفَّة",
 "guru": "مُعَلِّم رُوحِيّ, جُورُو (من يمتهن التعليم، مُدَرِّس)\nمثال: هي أصبحت معلمة.",
 "gush": "انفجار, تدفق عاطفي (تعبير غير مقيد عن العاطفة) / تدفق غزير, دفق (تدفق سريع ومفاجئ (كما في الماء))\nمثال: سمع دفق المرحاض",
 "gusher": "بئر دافق (بئر نفط بتدفق طبيعي قوي بحيث لا يكون الضخ ضرورياً)",
 "gushing": "فَيَّاض, مُتَدَفِّق (يُعبَّر عنه بحماسة غير مقيّدة) / مُتَدَفِّق, مُنْهَمِر (يسيل بغزارة)",
 "gushingly": "بانفعال شديد, بفيض من العاطفة (بطريقة متدفقة المشاعر بشكل مفرط)\nمثال: كاتب غزير الإنتاج بفيض",
 "gushy": "فَيَّاض, مُبَالِغٌ فِي التَّعْبِير (مُبَالِغٌ فِي إِظْهَارِ المَشَاعِرِ بِشَكْلٍ مُفْرِط)",
 "gusset": "رقعة, وصلة تقوية (قطعة من المادة تستخدم لتقوية أو توسيع الثوب) / صفيحة تقوية (صفيحة معدنية تستخدم لتقوية الرافدة) / رقعة زردية, وصلة درعية (قطعة من الزرد تغطي مكاناً غير محمي بالدرع الصفائحي)",
 "gusset plate": "صفيحة تقوية (صفيحة معدنية تستخدم لتقوية الرافدة)",
 "gusseted": "مُدَعَّم, مُقَوَّى",
 "gust": "هَبَّة",
 "gustation": "تذوق, حاسة التذوق (ملكة التمييز بين الخصائص الحلوة والحامضة والمرة والمالحة في الفم)\nمثال: حرمته نزلته البردية من حاسة التذوق",
 "gustative": "تذوقي, ذوقي (متعلق بحاسة التذوق)",
 "gustatorial": "تذوقي, ذوقي (متعلق بحاسة التذوق)",
 "gustatory": "تذوقي, ذوقي (متعلق بحاسة التذوق)",
 "gustatory cell": "خلية ذوقية (خلية طلائية في برعم التذوق تنشط الألياف الحسية للعصب الوجهي أو العصب البلعومي اللساني أو العصب المبهم)",
 "gustatory modality": "تذوق, حاسة التذوق (ملكة التمييز بين الخصائص الحلوة والحامضة والمرة والمالحة في الفم)\nمثال: حرمته نزلته البردية من حاسة التذوق",
 "gustatory organ": "برعم ذوقي (عضو حسي بيضاوي نهائي على سطح اللسان)",
 "gustatory perception": "تذوق, ذوق (الإحساس الناتج عندما تنقل براعم التذوق في اللسان والحلق معلومات حول التركيب الكيميائي لمادة قابلة للذوبان)\nمثال: تركت الحلوى طعماً سيئاً لديه",
 "gustatory sensation": "تذوق, ذوق (الإحساس الناتج عندما تنقل براعم التذوق في اللسان والحلق معلومات حول التركيب الكيميائي لمادة قابلة للذوبان)\nمثال: تركت الحلوى طعماً سيئاً لديه",
 "gusto": "تلذذ, شغف (استمتاع قوي ومتحمس)",
 "gusty": "ذُو هَبَّات, هَبُوب (يَهُبّ عَلَى شَكْل هَبَّات أَوْ نَفَحَات مُتَقَطِّعَة)",
 "gut": "خيط معوي, وتر جراحي (حبل قوي مصنوع من أمعاء الأغنام ويستخدم في الجراحة) / أمعاء (جزء القناة الهضمية بين المعدة والشرج) / مضيق صغير, ممر مائي ضيق (قناة ضيقة أو مضيق)",
 "gut issue": "قضية شائكة, قضية مثيرة للمشاعر (قضية تثير ردود فعل عاطفية قوية)",
 "gutierrezia microcephala": "عشبة الثعبان صغيرة الرأس (مشابهة لعشبة الثعبان المكنسية ولكن برؤوس زهور ذات أشعة وزهور قرصية أقل)",
 "gutierrezia sarothrae": "عشبة الأرنب, عشبة الثعبان المكنسية (شجيرة منخفضة النمو لزجة في جنوب غرب الولايات المتحدة ذات أوراق خطية ضيقة على العديد من الفروع الرفيعة ومئات من رؤوس الزهور الصفراء الصغيرة)",
 "gutierrezia texana": "عشبة المكنسة (نبات سنوي في جنوب غرب الولايات المتحدة ذو فروع خشبية صلبة بأوراق لزجة وزهور صفراء)",
 "gutless": "جَبَان, ضَعِيف الشَّخْصِيَّة (يفتقر إلى الشجاعة أو الحيوية)\nمثال: كان دودة صفراء عديمة الشجاعة",
 "gutlessness": "انعدام الشخصية, خوار (سمة الافتقار للشجاعة والتصميم؛ الخوف من الخسارة أو الإصابة)",
 "guts": "أَحْشَاء",
 "gutsiness": "ثبات, جلد (سمة إظهار الشجاعة والتصميم رغم احتمالية الخسارة أو الإصابة)",
 "gutsy": "بَاسِل, جَرِيء (يتميز بالشجاعة والتصميم في مواجهة الصعوبات أو الخطر؛ قوي وغير مكبوت)\nمثال: عليك أن تعجب بها: كان شيئاً جريئاً للقيام به",
 "gutta balata": "بالاتا (عندما تجف تعطي مادة صلبة تستخدم مثلاً في كرات الغولف)",
 "gutta-percha": "جتا بركا (مطاط مبيض مشتق من اللاتكس الحليبي المتخثر لأشجار الجتا بركا؛ يستخدم لعزل الكابلات الكهربائية)",
 "gutta-percha tree": "شجرة جوتا بيرشا (واحدة من عدة أشجار في جزر الهند الشرقية تنتج جوتا بيرشا) / شجرة جوتا بيرشا (نبات قائم على سَاق صلبة؛ مخطط له تفرعات)\nمثال: أنا تحت الشجرة.",
 "gutter": "مِزْراب (قناة صرف لمياه الأمطار والثلوج؛ نظام يحدّ من جريان المياه على الأسطح الخارجية للمبنى)",
 "gutter press": "صحافة الفضائح, صحافة صفراء (الصحافة التي تنخرط في الإثارة (خاصة فيما يتعلق بالحياة الخاصة للشخصيات العامة))",
 "guttersnipe": "طفل شوارع (طفل يقضي معظم وقته في الشوارع خاصة في المناطق العشوائية)",
 "guttural": "أَجَشّ, حَلْقِيّ (يُشْبِه أَصْوَات الضَّفَادِع والغِرْبَان) / حلقي (متعلق بـ أو ينطق في الحلق) / صوت بلعومي, صوت حلقي (صامت يُنطق في مؤخرة الفم أو الحلق)\nمثال: الوقفة المزمارية وحرف الراء اللهوي وحرف الخاء في الألمانية هي أصوات حلقية",
 "guttural consonant": "صوت بلعومي, صوت حلقي (صامت يُنطق في مؤخرة الفم أو الحلق)",
 "gutturally": "حلقياً (بطريقة حلقية (صوت))\nمثال: ملفوظ حلقياً",
 "guvnor": "رئيس, زعيم ((عامية بريطانية) الشخص الآمر أو المسؤول)",
 "guy": "رَجُل (العُضْو في جسد الإنسان يتكون من القَدَم والسَاق والفُخْذ. الجمع أرجُل، وقد تقول العامّة رِجْلين ورجْلينات؛ القَدَم من باب اطلاق اسم الكل على الجزء)\nمثال: هذا الرجل تاجر.",
 "guy cable": "حبل شد, سلك تثبيت (كابل أو سلك أو حبل يستخدم لتدعيم شيء ما (خاصة الخيمة))",
 "guy fawkes day": "يوم جاي فوكس (يوم للاحتفال باكتشاف مؤامرة البارود)",
 "guy fawkes night": "ليلة الشعلة, ليلة جاي فوكس (تُحرق دمى جاي فوكس في هذه الليلة)",
 "guy rope": "حبل شد, سلك تثبيت (كابل أو سلك أو حبل يستخدم لتدعيم شيء ما (خاصة الخيمة))",
 "guy wire": "حبل شد, سلك تثبيت (كابل أو سلك أو حبل يستخدم لتدعيم شيء ما (خاصة الخيمة))",
 "guyana": "غْوِيَانَا, غُويَانَا",
 "guyana dollar": "دولار غوياني (وحدة المال الأساسية في غويانا)",
 "guyanese": "غياني (من أو متعلق أو مميز لغويانا أو سكانها) / غياني (مواطن أو ساكن في غيانا)\nمثال: العاصمة الغيانية",
 "guyot": "جبل بحري مسطح القمة, غايوت (جبل بحري من أصل بركاني (خاصة في المحيط الهادئ))",
 "guzzle": "أَسْرَفَ فِي اَلشَّرَاب (أَسْرَفَ: جاوَزَ الحدَّ؛ يقال: أَسْرَفَ في مالِه)",
 "guzzler": "جارع, عبّاب (شارب يبتلع كميات كبيرة بنهم) / شرِه للشرب, مُعاقِر الخمر (شخص يشرب بشراهة (خاصة المشروبات الكحولية))\nمثال: هو معاقر للبيرة كل ليلة",
 "guzzling": "جرع, عب (شرب ملء الفم بسرعة كبيرة)",
 "gwadar": "جَوَادِر, قَوَادِر",
 "gwangju": "جْوَانْجُو",
 "gy": "غراي (وحدة النظام الدولي للطاقة الممتصة من الإشعاع المؤين؛ تساوي امتصاص واحد جول من طاقة الإشعاع بواسطة واحد كيلوغرام من المادة)",
 "gym": "صَالَة رِيَاضِيَّة (مكان فسيح في وسط المسكن يُوصِلُ إلى سائر الحجرات، الرُدْهَة؛ غُرْفَةُ المَعِيْشَة سواء كانت توصل إلى سائر الحجرات أم لا وسواء كانت فسيحة أم لا)\nمثال: حجزت الصالة يوم الخميس.",
 "gym mat": "بساط, حصيرة جمباز (معدات رياضية تتكون من قطعة مبطنة سميكة توضع على الأرض للرياضات الجمبازية)",
 "gym rat": "مهووس بالرياضة (شخص يقضي كل وقت فراغه في ممارسة الرياضة أو التمرين في صالة الألعاب الرياضية)",
 "gym shoe": "حذاء تنس, حذاء رياضي (حذاء قماشي بنعل مطاطي مرن)",
 "gym suit": "بدلة جمباز, زي رياضي (ملابس مخصصة للارتداء أثناء ممارسة تمارين الجمباز)",
 "gymel": "جيميل (تقنية وجدت في بعض الموسيقى الإنجليزية في العصور الوسطى، تتمثل في غناء أجزاء صوتية بمسافات ثالثة متوازية)",
 "gymkhana": "جيمكانا, مسابقة مهارات الفروسية (ملتقى يعرض فيه الفرسان والخيول مجموعة من المهارات والقدرات)",
 "gymnadenia conopsea": "أوركيد عطري (أوركيد أوروبي ذو سنابل كثيفة من زهور وردية أو ليلكية أو حمراء عطرة بمهاميز بارزة)",
 "gymnadenia odoratissima": "أوركيد عطري قصير المهماز (مشابه للأوركيد العطري ولكن بزهور أصغر على سيقان أقصر وله مهاميز أقصر بكثير)",
 "gymnasium": "جمنازيوم, صالة ألعاب رياضية (منشأة رياضية مجهزة للرياضة أو التدريب البدني) / مدرسة ثانوية, مدرسة متوسطة (مدرسة للطلاب بين المدرسة الابتدائية والكلية؛ عادة الصفوف من 9 إلى 12)",
 "gymnast": "لاعب جمباز (رياضي ماهر في الجمباز)",
 "gymnastic": "بَهْلَوَانِيّ, رِيَاضِيّ (نشيط بقوّة وحيويّة) / جمبازي, رياضي (متعلق بالتمارين المعدة لتنمية القوة والمرونة أو يستخدم فيها)\nمثال: حصان الجمباز",
 "gymnastic apparatus": "جهاز جمباز (معدات رياضية تستخدم في تمارين الجمباز)",
 "gymnastic exercise": "جمباز (رياضة تتضمن تمارين تهدف إلى إظهار القوة والتوازن والرشاقة) / تمرين جمباز (تمرين مصمم لتطوير وإظهار القوة والرشاقة والتوازن (يُؤدى عادةً باستخدام أو على بعض أجهزة الجمباز))",
 "gymnastic horse": "حصان, حصان الجمباز (جهاز جمباز مبطن محمول على قوائم)",
 "gymnastics": "جُمْبَاز",
 "gymnelus viridis": "طبيب السمك (إيل بوت قطبي زاهي الألوان وبلا حراشف)",
 "gymnocarpium dryopteris": "سرخس البلوط (سرخس أزرق مخضر ساطع واسع الانتشار خاصة في الغابات الحمضية الرطبة في المنطقة المعتدلة الشمالية)",
 "gymnocarpium robertianum": "سرخس البلوط الشمالي, سرخس الحجر الجيري (سرخس أصفر مخضر في المناطق الصخرية في نصف الكرة الشمالي)",
 "gymnocladus dioica": "بندق هندي, شجرة البن الكنتاكية (شجرة جميلة من وسط وشرق أمريكا الشمالية ذات أوراق كبيرة ثنائية الريش وأزهار خضراء بيضاء تليها قرون بنية خشبية كبيرة تستخدم بذورها كبديل للقهوة)",
 "gymnogyps californianus": "كندور كاليفورنيا (كندور من أمريكا الشمالية؛ أسود باهت بشكل رئيسي؛ منقرض تقريباً)",
 "gymnopilus spectabilis": "جيمنوبيلوس رائع (فطر بجسم ثمري برتقالي بني وحلقة بالقرب من أعلى الساق؛ الطعم مر ويحتوي اللحم على السيلوسيبين والسيلوسين)",
 "gymnopilus validipes": "جيمنوبيلوس قوي القدم (فطر سام بقبعة جافة وستارة لا تترك حلقة كبيرة على الساق القوي)",
 "gymnopilus ventricosus": "جيمنوبيلوس منتفخ (فطر عملاق في شمال غرب المحيط الهادئ؛ له ساق سميك جداً وتترك الستارة حلقة عالية على الساق)",
 "gymnorhina tibicen": "غراب ناعق (طائر بحجم الغراب أسود وأبيض؛ مقلد جيد غالباً ما يوضع في أقفاص)",
 "gymnosophical": "متعلق بحكمة العراة (متعلق بمذهب الجمناصوفيا (حكمة العراة الهندية القديمة))",
 "gymnosophist": "ممارس للعري (عضو في طائفة هندوسية تمارس العري (خاصة لأغراض دينية وفلسفية))",
 "gymnosophy": "جمنوسوفيا, عريانية (مذهب طائفة من الفلاسفة الهندوس الذين مارسوا العري والزهد والتأمل)",
 "gymnosperm": "عاريات البذور (نباتات من طائفة عاريات البذور تكون بذورها غير محاطة بمبيض)",
 "gymnosperm family": "فصيلة عاريات البذور (فصيلة من عاريات البذور)",
 "gymnosperm genus": "جنس عاريات البذور (جنس من عاريات البذور)",
 "gymnospermous": "عاري البذور (متعلق بالنباتات من طائفة عاريات البذور أو مميز لها)",
 "gymnospermous tree": "شجرة عارية البذور (أي شجرة من شعبة عاريات البذور)",
 "gymnospermous yellowwood": "خشب أصفر عاري البذور (أي من الأشجار عارية البذور المتنوعة ذات الخشب الأصفر)",
 "gymnosporangium juniperi-virginianae": "صدأ الأرز والتفاح, صدأ التفاح (فطر صدأ يسبب بقع صدأ على التفاح والكمثرى وغيرها)",
 "gymslip": "مريول مدرسي (سترة بلا أكمام ترتديها الفتيات الإنجليزيات كجزء من الزي المدرسي)",
 "gynaecological": "نسائي (متعلق بطب النساء أو ممارسته)\nمثال: فحص نسائي",
 "gynaecologist": "طَبِيب نِسَاء (العالم بالطب)\nمثال: سوف تصبح طبيبة.",
 "gynaecology": "طب النساء (فرع الطب الذي يتعامل مع أمراض النساء وصحتهن)",
 "gynaeolatry": "تقديس النساء, عبادة المرأة (عبادة النساء)",
 "gynandromorph": "خنثى (شخص يمتلك خصائص وأعضاء جنسية ذكرية وأنثوية؛ ولا يمكن تحديد جنسه بشكل قاطع عند الولادة)",
 "gynandromorphic": "ثُنَائِيُّ الشَّكْلِ الجِنْسِيّ (يمتلك خصائص شكلية ذكورية وأنثوية معاً)",
 "gynandromorphous": "ثُنَائِيُّ الشَّكْلِ الجِنْسِيّ (يمتلك خصائص شكلية ذكورية وأنثوية معاً)",
 "gynarchy": "جينوقراطية, حكم النساء (نظام سياسي تحكمه امرأة)",
 "gynecocracy": "جينوقراطية, حكم النساء (نظام سياسي تحكمه امرأة)",
 "gynecologic": "نسائي (متعلق بطب النساء أو ممارسته)\nمثال: فحص نسائي",
 "gynecological": "نسائي (متعلق بطب النساء أو ممارسته)\nمثال: فحص نسائي",
 "gynecologist": "أخصائي أمراض نساء, طبيب نساء (أخصائي في طب النساء)",
 "gynecology": "طِبّ النِّسَاء (العِلْم؛ دراسة أسباب وتَشْخِيْص ومُعَاْلَجَة الأمراض)\nمثال: اختص في طب القلب.",
 "gynecomastia": "تثدي الرجل (نمو مفرط للثدي عند الذكور؛ عادة ما يكون نتيجة لعدم التوازن الهرموني أو العلاج ببعض الأدوية (بما في ذلك بعض أدوية ارتفاع ضغط الدم))",
 "gyneolatry": "تقديس النساء, عبادة المرأة (عبادة النساء)",
 "gynesexual": "جنسيا",
 "gynobase": "قاعدة المتاع (التخت المتضخم الذي تُحمل فيه المدقة)",
 "gynoecium": "أعضاء التأنيث, متاع (وعاء مشيجي أنثوي)",
 "gynogenesis": "توالد أنثوي (توالد عذري أنثوي يحتوي فيه الجنين على كروموسومات الأم فقط بسبب فشل الحيوان المنوي في الاندماج مع نواة البويضة)",
 "gynophobia": "رهاب النساء (خوف مرضي من النساء)",
 "gynophore": "حامل المتاع (ساق المدقة التي ترفعها فوق التخت)",
 "gynostegium": "عمود المتاع (تاج السداة في نباتات جنس الصقلاب)",
 "gynura aurantiaca": "جينورا برتقالية, نبات المخمل (نبات ورقي جاوي يُزرع لأوراقه المخملية الجميلة ذات الشعيرات البنفسجية الأرجوانية)",
 "gyp": "خداع, غش ((أحياناً مهينة) فعل من أفعال النصب أو الغش)",
 "gypaetus barbatus": "كاسر العظام, نسر ملتحي (أكبر طائر جارح أوراسي؛ له ريش أسود يتدلى حول المنقار)",
 "gyps fulvus": "نسر أسمر (نسر كبير من جنوب أوروبا وشمال أفريقيا ذو ريش شاحب وأجنحة سوداء)",
 "gypsophila paniculata": "جبسوفيلا, نفس الطفل (نبات طويل بأوراق صغيرة رمحية الشكل والعديد من الزهور البيضاء أو الوردية الدقيقة)",
 "gypsum": "جِصّ, جِبْص (جَصَّ في الرِّباط يَجِصُّ جَصًّا، وجَصِيصاً: تَأَوَّهَ من شدّة ربطه به)",
 "gypsum board": "جبس بورد, لوح جصي (لوح جداري بقلب من الجص الجبسي مرتبط بطبقات من الورق أو الألواح الليفية؛ يستخدم بدلاً من الجص أو الألواح الجدارية لعمل الجدران الداخلية)",
 "gypsy": "غَجَرِيّ, غَجَرِيَّة",
 "gypsy cab": "سيارة أجرة غير مرخصة (سيارة أجرة تتجول بحثاً عن زبائن على الرغم من أنها مرخصة فقط للاستجابة للمكالمات)",
 "gypsy dancing": "رقص غجري, فلامنكو (أسلوب رقص مميز لغجر الأندلس؛ قوي وإيقاعي مع التصفيق والضرب بالقدمين)",
 "gypsy language": "الغجرية, لغة الروما (اللغة الهندية للروماني (الغجر))",
 "gypsy moth": "عثة الغجر (عثة أوروبية أُدخلت إلى أمريكا الشمالية؛ آفة خطيرة لأشجار الظل)",
 "gypsyweed": "زهرة الحواشي المخزنية, فيرونيكا شائعة (نبات أوروبي معمر زغبي شائع بزهور زرقاء شاحبة أو ليلكية في عناقيد إبطية)",
 "gypsywort": "عشبة الغجر, ليكوبس أوروبي (عشب أوراسي مشعر بأزهار بيضاء ذات شفتين)",
 "gyral": "تلافيفي (متعلق بتلافيف الدماغ أو مرتبط بها أو يشملها)\nمثال: الثلم التلافيفي",
 "gyration": "دوران حلزوني (عملية الدوران في دائرة أو حلزون) / دوران, دورة (دورة كاملة واحدة (محورية أو مدارية))\nمثال: قامت الطائرة بثلاث دورات قبل أن تتحطم",
 "gyre": "تجعيد, حلقة (شكل مستدير يتكون من سلسلة من الدوائر متحدة المركز (كما تشكلها الأوراق أو بتلات الزهور))",
 "gyrfalcon": "سنقر (صقر قطبي كبير ونادر له أطوار لونية بيضاء وداكنة)",
 "gyrinid": "جِرِنُوسِيّ",
 "gyro": "جيروسكوب, مدوار (آلية دوارة على شكل عجلة دوارة مثبتة بشكل شامل تقاوم الدوران في أي اتجاه) / جيرو, شاورما يونانية (شطيرة يونانية: شرائح لحم ضأن مشوي مع البصل والطماطم محشوة في خبز بيتا)",
 "gyro horizon": "أفق اصطناعي, مؤشر الطيران (أداة ملاحية تعتمد على الجيروسكوب؛ توفر أفقاً محاكياً للطيار بشكل اصطناعي)",
 "gyrocompass": "بوصلة جيروسكوبية (بوصلة لا تعتمد على المغناطيسية ولكن تستخدم جيروسكوب بدلاً من ذلك)",
 "gyromitra": "جيروميترا (أي فطر من جنس جيروميترا)",
 "gyromitra brunnea": "جيروميترا فاستيجياتا (لورشيل بجزء خصب أحمر بني عميق وساق أبيض)",
 "gyromitra californica": "موريل كاليفورنيا الكاذب (جيروميترا بجزء خصب بني منتفخ وساق مخدد سميك؛ يوجد تحت الصنوبريات في كاليفورنيا)",
 "gyromitra esculenta": "فطر الدماغ, موريل شريحة اللحم (جيروميترا سام؛ سطح الجسم الخصب أملس في البداية ويصبح متموجاً ومجعداً تدريجياً (ولكن ليس محفوراً حقاً)؛ يتراوح اللون من الأصفر الباهت إلى البني)",
 "gyromitra fastigiata": "جيروميترا فاستيجياتا (لورشيل بجزء خصب أحمر بني عميق وساق أبيض)",
 "gyromitra gigas": "جيروميترا جيجاس (جيروميترا بساق كبير غير منتظم وجزء خصب أصفر إلى بني ومجعد؛ يثمر مبكراً)",
 "gyromitra infula": "موريل كاذب سرجي الشكل (فطر سام؛ الجزء الخصب على شكل سرج وأصفر باهت إلى بني ومستوٍ نسبياً)",
 "gyromitra sphaerospora": "جيروميترا كروية الأبواغ (جيروميترا بجزء خصب بني منتفخ وساق مخدد وردي وأبواغ مستديرة ملساء؛ يوجد على مخلفات الأخشاب الصلبة شرق السهول الكبرى)",
 "gyroplane": "أوتوجيرو, طائرة دوارة (طائرة تُدعم في الطيران بواسطة أجنحة أفقية (أو شفرات) دوارة غير مزودة بالطاقة؛ ويتم توفير الدفع الأمامي بواسطة مروحة تقليدية)",
 "gyroscope": "جَيْرُوسْكُوب",
 "gyroscopic": "جيروسكوبي, دواري (لديه خصائص الجيروسكوب (المدوار))",
 "gyrostabiliser": "مثبت جيروسكوبي (مثبت يتكون من جيروسكوب ثقيل يدور على محور عمودي؛ يقلل من التأرجح الجانبي للسفينة أو الطائرة)",
 "gyrostabilizer": "مثبت جيروسكوبي (مثبت يتكون من جيروسكوب ثقيل يدور على محور عمودي؛ يقلل من التأرجح الجانبي للسفينة أو الطائرة)",
 "gyrus": "تلفيف (طية محدبة أو ارتفاع في سطح الدماغ)",
 "gyrus cinguli": "تلفيف حزامي (بنية منحنية طويلة على السطح الإنسي لنصفي الكرة المخية؛ الجزء القشري من الجهاز الحوفي)",
 "gyumri": "غْيُومْرِي",
 "győr": "جيور",
 "gömböc": "غومبوش",
 "h": "إنثالبي, محتوى حراري (كمية ديناميكية حرارية تساوي الطاقة الداخلية للنظام زائد حاصل ضرب حجمه وضغطه) / ثَابِت بِلَانْك (ثابت التناسب الذي يربط طاقة الفوتون بتردده؛ يساوي تقريباً 6.626 × 10^-34 جول-ثانية) / هنري (وحدة للمحاثة يتم فيها إنتاج قوة دافعة كهربائية مستحثة مقدارها فولت واحد عندما يتغير التيار بمعدل أمبير واحد في الثانية) / هيدروجين (عنصر لافلزي أحادي التكافؤ يكون عادة غازاً ثنائي الذرة عديم اللون والرائحة وسريع الاشتعال؛ أبسط وأخف العناصر وأكثرها وفرة في الكون)\nمثال: المحتوى الحراري هو مقدار الطاقة في النظام القادر على القيام بعمل ميكانيكي",
 "h-bomb": "قنبلة هيدروجينية (سلاح نووي يطلق طاقة ذرية عن طريق اتحاد نوى خفيفة (هيدروجين) عند درجات حرارة عالية لتكوين الهيليوم)",
 "h.p.": "حصان, قوة حصان (وحدة للقدرة تساوي 746 واط)",
 "h2o": "ماء (مركب ثنائي يوجد في درجة حرارة الغرفة كسائل شفاف عديم اللون والرائحة والطعم؛ يتجمد إلى ثلج تحت 0 درجة مئوية ويغلي فوق 100 درجة مئوية؛ يستخدم على نطاق…)",
 "ha": "ههه",
 "ha'p'orth": "ما قيمته نصف بنس (الكمية التي يمكن شراؤها بنصف بنس)",
 "ha'penny": "نصف بنس (عملة إنجليزية قيمتها نصف بنس)",
 "ha-ha": "هَاهَا, هِهِهِهِ",
 "haarlem": "هارلم, هارليم",
 "haarlemmermeer": "هارلمرمير",
 "haart": "علاج مضاد للفيروسات القهقرية عالي النشاط, كوكتيل دوائي (مزيج من مثبطات البروتياز تؤخذ مع مثبطات المنتسخة العكسية؛ يستخدم في علاج الإيدز وفيروس نقص المناعة البشرية)",
 "haastia pulvinaris": "خروف نباتي, هاستيا (عشب نيوزيلندي يشكل وسائد وله أوراق مغطاة بكثافة بشعيرات سمراء مصفرة)",
 "habakkuk": "حَبَقُّوق",
 "habanera": "هابانيرا (رقصة كوبية بإيقاع ثنائي) / هابانيرا (موسيقى مؤلفة في زمن ثنائي لرقص الهابانيرا)",
 "habeas corpus": "أمر المثول, حق المثول أمام القضاء (الحق المدني في الحصول على أمر بالمثول أمام القضاء كحماية ضد السجن غير القانوني) / أمر المثول أمام القضاء, هابياس كوربوس (أمر بإحضار سجين أمام قاضٍ)",
 "habenaria albiflora": "سحلب أبيض مهدب (سحلب مستنقعات من شرق أمريكا الشمالية بسنبلة من الزهور البيضاء النقية المهدبة)",
 "habenaria bifolia": "أوركيد الفراشة الصغير (أوركيد جنوب أوروبي ذو زهور بيضاء مخضرة عطرة؛ يوضع أحياناً في جنس هابيناريا)",
 "habenaria chlorantha": "أوركيد الفراشة الكبير (أوركيد جنوب أوروبي بزهور خضراء داكنة أكبر وأقل عطراً من أوركيد الفراشة الصغير؛ يوضع أحياناً في جنس هابيناريا)",
 "habenaria dilatata": "سحلب اللجام المستنقعي (سحلب بسنابل من العديد من الزهور البيضاء العطرة على سيقان ورقية منتصبة؛ في الأراضي الرطبة أو المستنقعية عبر معظم الغرب وشمال أمريكا الشمالية)",
 "habenaria elegans": "هابيناريا أنيقة (سحلب لجام داخلي نحيل يشبه سحلب اللجام الساحلي ولكن بزهور صفراء مخضرة شاحبة)",
 "habenaria fimbriata": "سحلب أرجواني مهدب",
 "habenaria greenei": "سحلب اللجام الساحلي (سحلب قوي من وسط كاليفورنيا إلى شمال واشنطن له عناقيد من الزهور البيضاء العطرة المتناظرة ثنائياً)",
 "habenaria hookeri": "سحلب هوكر (سحلب طويل المهماز بأوراق قاعدية وبتلات تتقارب تحت السبلة العلوية)",
 "habenaria lacera": "سحلب ممزق (سحلب مهدب من شرق الولايات المتحدة له زهرة مخضرة بشفة ممزقة بعمق)",
 "habenaria leucophaea": "سحلب البراري (سحلب الأراضي المستنقعية أو الرطبة في شمال وسط الولايات المتحدة له عناقيد من الزهور البيضاء الكريمية أو المخضرة العطرة جداً)",
 "habenaria nivea": "سحلب ثلجي (سحلب مهدب نحيل من شرق أمريكا الشمالية له زهور بيضاء)",
 "habenaria orbiculata": "سحلب اللجام مستدير الأوراق (سحلب له عنقود من الزهور البيضاء المخضرة الكبيرة على ساق زهرة واحدة تنمو بين ورقتين قاعديتين بيضاويتين أو مستديرتين ملقاتين على الأرض؛ من شمال أوريغون…)",
 "habenaria peramoena": "سحلب أرجواني غير مهدب (سحلب من شمال شرق وشرق أمريكا الشمالية الألبي وثيق الصلة بالسحلب الأرجواني المهدب ولكن له زهور وردية أرجوانية أو بنفسجية بتقسيمات أوراق مسننة)",
 "habenaria psycodes": "سحلب أرجواني مهدب صغير (سحلب من أمريكا الشمالية بعناقيد من الزهور الأرجوانية المهدبة العطرة)",
 "habenaria unalascensis": "سحلب لجام ألاسكا (يشبه سحلب اللجام الساحلي ولكن بزهور أصغر؛ ألاسكا إلى باجا كاليفورنيا وشرقاً إلى داكوتا وكولورادو)",
 "haber process": "عملية هابر, عملية هابر-بوش (عملية صناعية لإنتاج الأمونيا من النيتروجين والهيدروجين عن طريق دمجهما تحت ضغط عالٍ بوجود محفز الحديد)",
 "haber-bosch process": "عملية هابر, عملية هابر-بوش (عملية صناعية لإنتاج الأمونيا من النيتروجين والهيدروجين عن طريق دمجهما تحت ضغط عالٍ بوجود محفز الحديد)",
 "haberdasher": "بائع ملابس رجالية, تاجر ملابس (تاجر يبيع الملابس الرجالية)",
 "haberdashery": "متجر ملابس رجالية (متجر تباع فيه ملابس الرجال) / خردوات, مستلزمات ملابس رجالية (السلع الجافة (كالملابس الرجالية أو أدوات الخياطة) التي يبيعها الخردواتي)",
 "haberdashery store": "متجر ملابس رجالية (متجر تباع فيه ملابس الرجال)",
 "habergeon": "درع زردي خفيف, سابغة قصيرة ((في العصور الوسطى) معطف خفيف بلا أكمام من الزرد يلبس تحت الدرع الطويل)",
 "habiganj district": "ضِلْع حَبِيبْغَنْج",
 "habiliment": "ثياب, كساء (غطاء مصمم ليتم ارتداؤه على جسم الإنسان)",
 "habilimented": "مُتَأَنِّق, مُرْتَدٍ (يرتدي ملابس خاصة أنيقة؛ تستخدم غالباً في التركيب)",
 "habit": "عَادَة",
 "habit-forming": "مُسَبِّب لِلْإِدْمَان (يسبب أو يتميز بالإدمان)\nمثال: عقاقير تسبب الإدمان",
 "habitability": "قَابِلِيَّة السَّكَن (الملاءمة للعيش فيها أو عليها)",
 "habitable": "صَالِح لِلسَّكَن, قَابِل لِلسُّكْنَى (مُناسِب لِلإِقامَة وَالعَيْش فيه)",
 "habitableness": "قَابِلِيَّة السَّكَن (الملاءمة للعيش فيها أو عليها)",
 "habitant": "ساكن, قاطن (شخص يسكن في مكان معين)",
 "habitat": "مَوْطِن (الوَطَن؛ كل مكان أقام به الإنسان سواء اتخذه وطنا أم لا)\nمثال: السافانة موطن أيضا للأسود و النمور.",
 "habitation": "استيطان, سكنى (فعل السكن أو العيش الدائم في مكان ما (للإنسان والحيوان)) / مأوى, مسكن (سكن يعيش فيه شخص ما) / مسكن, موطن (الموطن الأصلي أو المسكن لحيوان أو نبات)\nمثال: بنى مسكناً متواضعاً بالقرب من البركة",
 "habited": "مُرْتَدٍ زِيّاً دِينِيّاً (يرتدي زياً دينياً)",
 "habitual": "مَأْلُوف, مُعْتَاد (شائع الاستخدام أو الممارسة؛ اعتيادي)",
 "habitual abortion": "إجهاض متكرر (إجهاض تلقائي متكرر (غالباً لسبب غير معروف))",
