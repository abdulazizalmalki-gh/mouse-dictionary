 "gopher snake": "ثعبان الغوفر (ثعبان ثور من غرب أمريكا الشمالية يغزو جحور القوارض) / ثعبان نيلي (ثعبان كبير أزرق داكن غير سام يغزو الجحور؛ يوجد في جنوب أمريكا الشمالية والمكسيك)",
 "gopher tortoise": "سلحفاة غوفرية (سلحفاة برية صالحة للأكل تحفر الجحور من جنوب شرق أمريكا الشمالية)",
 "gopher turtle": "سلحفاة غوفرية (سلحفاة برية صالحة للأكل تحفر الجحور من جنوب شرق أمريكا الشمالية)",
 "gopherus agassizii": "سلحفاة صحراوية (سلحفاة تحفر الجحور من المناطق القاحلة في غرب الولايات المتحدة وشمال المكسيك)",
 "gopherus polyphemus": "سلحفاة غوفرية (سلحفاة برية صالحة للأكل تحفر الجحور من جنوب شرق أمريكا الشمالية)",
 "gopherwood": "خشب أصفر كنتاكي (شجرة نفضية صغيرة وسيمة مستديرة الرأس لها زهور بيضاء ملفتة للنظر في عناقيد طرفية وخشب صلب ثقيل ينتج صبغة صفراء)",
 "goral": "غورال (ظبي ماعز صغير ذو قرون مخروطية صغيرة؛ يعيش في جبال جنوب آسيا)",
 "gorbachev": "غُورْبَاتْشُوف",
 "gordian": "غُرْدِيّ, مُسْتَعْصٍ (بَالِغ التَّعْقِيد؛ يُسْتَخْدَم عَادَةً فِي عِبَارَة 'العُقْدَة الغُرْدِيَّة')",
 "gordian knot": "العقدة الغوردية (عقدة معقدة ربطها غورديوس، ملك فريجيا، وقطعها الإسكندر الأكبر بسيفه بعد أن سمع أن من يفكها سيصبح حاكم آسيا) / الْعُقْدَة الْغُورْدِيَّة, مُشْكِلَة عَوِيصَة (أي مشكلة صعبة للغاية؛ غير قابلة للحل بشروطها الخاصة)",
 "gordon setter": "جوردون سيتر (سلالة اسكتلندية ذات فراء أسود وأسمر)",
 "gore": "ينطح / بَنِيقَة",
 "gorgan": "جُرْجَان",
 "gorge": "أُخْدُود (أخْدُودُ)",
 "gorgeous": "خَلَّاب, سَاحِر (جميل بشكل مُبْهِر)",
 "gorgeously": "بأبهة, بروعة (بطريقة جميلة ومثيرة للإعجاب)\nمثال: كانت الأميرة ترتدي ملابس فخمة",
 "gorgeousness": "بهاء, روعة (السمة أو الصفة لكون الشخص جميلاً جداً)\nمثال: بعد سنوات، أعطتها والدة كازوكو القصة الحقيقية: مفتوناً بروعتها، طلب الشاب من والدة كازوكو ترك والدها",
 "gorger": "أكول, ملتهم (شخص يأكل الطعام بسرعة وشراهة)",
 "gorgerin": "طوق العمود (الإطار الزخرفي في قمة العمود)",
 "gorget": "طوق العنق, واقي الرقبة (درع صفيحي يحمي الرقبة)",
 "gorgon": "غورغون ((الأساطير اليونانية) أي من الأخوات الوحوش الثلاث المجنحات وميدوسا الفانية اللواتي كان لديهن ثعابين حية بدل الشعر؛ نظرة إلى ميدوسا تحول الناظر إلى حجر)",
 "gorgonian": "جورجونيا (مرجان له هيكل متفرع قرني أو جيري)",
