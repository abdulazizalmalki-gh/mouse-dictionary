 "hacker": "هَاكِر, مُخْتَرِق",
 "hackle": "قَوْزَعَة",
 "hackles": "ثائرة, غضب (شعور بالغضب والعداء)\nمثال: ثارت ثائرته",
 "hackmatack": "حور بلسمي (حور من شمال شرق أمريكا الشمالية بأوراق عريضة على شكل قلب)",
 "hackney": "هاكني (سلالة مدمجة من خيول العربات) / عربة للإيجار, هاكني (عربة للإيجار)",
 "hackney carriage": "عربة للإيجار, هاكني (عربة للإيجار)",
 "hackney coach": "عربة للإيجار, هاكني (عربة للإيجار)",
 "hackneyed": "مُبْتَذَل, مُسْتَهْلَك (مُكرَّر أكثر من اللازم؛ مألوف بشكل مفرط بسبب كثرة الاستخدام)",
 "hacksaw": "منشار حديدي (منشار يستخدم بيد واحدة لقطع المعدن)",
 "hackwork": "عمل تجاري رخيص, عمل مأجور (عمل مهني يتم وفق صيغة روتينية) / عَمَل تِجَارِيّ رَخِيص, كِتَابَة مُرْتَزَقَة ((مصطلحات أدبية ونقدية) عمل أدبي غير متميز يتم إنتاجه حسب الطلب)\nمثال: لاحظ جيمس سكالي أن الكثير مما يسمى بالشعر السياسي، أو الشعر الذي يتناول السياسة، هو عمل تجاري رخيص",
 "had crime": "جريمة حدية, حد ((الإسلام) جرائم خطيرة يرتكبها المسلمون ويعاقب عليها بعقوبات مقررة في القرآن)\nمثال: تشمل جرائم الحدود الردة عن الإسلام والقتل والسرقة والزنا",
 "hadal": "أخدودي, هدالي (يتعلق بأعمق أجزاء المحيط (أقل من 6000 متر))",
 "haddock": "سمك الحدوق, سمك القد (سَمَك جمع سَمَكَة، كما تجمع سمكة أسماك)\nمثال: سمكة ميناد ماتت",
 "hadean": "بُلُوتُونِيّ, جَحِيمِيّ (مُتعلق بالجحيم أو العالم السفلي أو من سماته)",
 "hades": "هَادِيس",
 "hadith": "حَدِيث (جَدِيد؛ الخبر عن ما حدث)\nمثال: توقف عن الحديث.",
 "hadj": "الحج (الركن الخامس من أركان الإسلام وهو الحج إلى مكة خلال شهر ذي الحجة؛ يُتوقع من المسلم القيام برحلة دينية إلى مكة والكعبة مرة واحدة على الأقل في العمر)\nمثال: بالنسبة للمسلم يعتبر الحج أسمى عبادة",
 "hadji": "حاج (مصطلح عربي يطلق احتراماً على من أدى فريضة الحج إلى مكة)",
 "hadrat": "حَضْرَة",
 "hadron": "هَادْرُون (أي جسيم أولي يتفاعل بقوة مع الجسيمات الأخرى)",
 "hadrosaur": "ديناصور بطي المنقار, هادروصور (أي من العديد من الديناصورات الكبيرة التي تسير على قدمين ولها منقار قرني يشبه منقار البط وأقدام مكففة؛ ربما كانت مائية جزئياً)",
 "hadrosaurus": "ديناصور بطي المنقار, هادروصور (أي من العديد من الديناصورات الكبيرة التي تسير على قدمين ولها منقار قرني يشبه منقار البط وأقدام مكففة؛ ربما كانت مائية جزئياً)",
 "haecceity": "ماهية (الجوهر الذي يجعل الشيء هو نوع الشيء الذي هو عليه ويجعله مختلفاً عن أي شيء آخر)",
 "haem": "هيم (خضاب عضوي أحمر معقد يحتوي على الحديد وذرات أخرى يرتبط بها الأكسجين)",
 "haemagglutination": "تراص دموي, تلازن دموي (تراص خلايا الدم الحمراء)",
 "haemal": "دموي (متعلق بالأوعية الدموية أو بالدم)",
 "haemal arch": "قوس دموية (بنية تنشأ بطنياً من مركز الفقرة وتحيط بالأوعية الدموية الذيلية)",
 "haemangioma": "ورم وعائي دموي (ورم وعائي حميد يتكون من كتلة من الأوعية الدموية؛ يظهر بعضها كوحمات)",
 "haemanthus coccineus": "توليب الكاب (نبات مذهل ذو أوراق منبطحة كبيرة مخططة باللون البني المحمر وأزهار بكتلة من الأسدية الصفراء الطويلة في كأس من القنابات اللحمية الحمراء المرجانية؛ جنوب…)",
 "haematal": "دموي (متعلق بالأوعية الدموية أو بالدم)",
 "haematemesis": "قيء دموي (تقيؤ الدم)",
 "haematic": "دموي (متعلق بالدم أو يحتويه أو يؤثر فيه)\nمثال: كيسة دموية",
 "haematin": "هيم (خضاب عضوي أحمر معقد يحتوي على الحديد وذرات أخرى يرتبط بها الأكسجين)",
 "haematinic": "مقوي للدم, مكون للدم (دواء يزيد من محتوى الهيموغلوبين في الدم؛ يستخدم لعلاج فقر الدم الناجم عن نقص الحديد)",
 "haematite": "حجر الدم, هيماتيت (الشكل الرئيسي لخام الحديد؛ يتكون من أكسيد الحديديك في شكل بلوري؛ يوجد في شكل ترابي أحمر)",
 "haematobia irritans": "ذبابة القرن (ذبابة أوروبية سوداء صغيرة أدخلت إلى أمريكا الشمالية؛ تمتص الدم من الماشية خاصة عند قاعدة القرن)",
 "haematocele": "قيلة دموية (تورم ناتج عن تجمع الدم في تجويف الجسم (وخاصة تورم الغشاء الذي يغطي الخصية))",
 "haematochezia": "تغوط دموي (مرور براز يحتوي على دم (كما هو الحال في داء الرتوج أو سرطان القولون أو القرحة الهضمية))",
 "haematocoele": "قيلة دموية (تورم ناتج عن تجمع الدم في تجويف الجسم (وخاصة تورم الغشاء الذي يغطي الخصية))",
 "haematocolpometra": "تدمي المهبل والرحم (تراكم الدم في المهبل والرحم)",
 "haematocolpos": "تدمي المهبل (تراكم دم الحيض في المهبل (عادة بسبب غشاء بكارة غير مثقوب))",
 "haematocrit": "مقياس الهيماتوكريت (أداة قياس لتحديد (عادة عن طريق الطرد المركزي) الكميات النسبية للكريات والبلازما في الدم) / مُكَوِّنَات الدَّم الخَلَوِيَّة, مِقْيَاس الدَّم (نسبة الحجم الذي تشغله خلايا الدم الحمراء المكدسة إلى حجم الدم الكامل)",
 "haematocytopenia": "نقص كريات الدم (عدد منخفض بشكل غير طبيعي لخلايا الدم الحمراء في الدم)",
 "haematocyturia": "بيلة كروية دموية (وجود خلايا الدم الحمراء في البول)",
 "haematogenesis": "تكون الدم, تكون الكريات (تكوين خلايا الدم في الجسم الحي (خاصة في نخاع العظم))",
 "haematogenic": "مكون للدم (متعلق بتكوين الدم أو خلايا الدم)\nمثال: خلايا جذعية مكونة للدم في نخاع العظم",
 "haematoidin": "بيليروبين (خضاب برتقالي أصفر في العصارة الصفراوية يتشكل كناتج للهيموجلوبين؛ الكميات الزائدة منه في الدم تنتج المظهر الأصفر الملاحظ في اليرقان)",
 "haematological": "دموي (متعلق بعلم الدم أو مشارك فيه)",
 "haematologist": "أخصائي أمراض دم (طبيب متخصص في أمراض الدم والأعضاء المكونة للدم)",
 "haematology": "عِلْم الدَّمْ (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "haematolysis": "انحلال الدم, تحلل الدم (تحلل كريات الدم الحمراء مع إطلاق الهيموجلوبين)",
 "haematoma": "ورم دموي (تورم موضعي مملوء بالدم)",
 "haematopoiesis": "تكون الدم, تكون الكريات (تكوين خلايا الدم في الجسم الحي (خاصة في نخاع العظم))",
 "haematopoietic": "مكون للدم (متعلق بتكوين الدم أو خلايا الدم)\nمثال: خلايا جذعية مكونة للدم في نخاع العظم",
 "haematoxylum campechianum": "خشب الدم, شجرة خشب البقم (شجيرة شائكة أو شجرة صغيرة من أمريكا الوسطى وجزر الهند الغربية لها أوراق ثنائية الريش وعناقيد من الزهور الصفراء الزاهية الصغيرة وتنتج خشباً قلبياً…)",
 "haematuria": "بيلة دموية (وجود الدم في البول؛ غالباً ما يكون عرضاً لمرض في المسالك البولية)",
 "haemic": "دموي (متعلق بالدم أو يحتويه أو يؤثر فيه)\nمثال: كيسة دموية",
 "haemodialysis": "غسيل الكلى الدموي (غسيل الدم لإزالة المواد السامة أو النفايات الأيضية من مجرى الدم؛ يستخدم في حالة الفشل الكلوي)",
 "haemogenesis": "تكون الدم, تكون الكريات (تكوين خلايا الدم في الجسم الحي (خاصة في نخاع العظم))",
 "haemoglobin": "خضاب الدم, هيموغلوبين (بروتين هيمي يتكون من الغلوبين والهيم ويعطي خلايا الدم الحمراء لونها المميز؛ وظيفته الأساسية نقل الأكسجين من الرئتين إلى أنسجة الجسم)\nمثال: الأسماك لديها هيموغلوبين أبسط من الثدييات",
 "haemoglobinemia": "هيموغلوبينية الدم (وجود الهيموغلوبين المفرط في بلازما الدم)",
 "haemoglobinopathy": "اعتلال الهيموغلوبين (مرض دموي يتميز بوجود هيموغلوبين غير طبيعي في الدم)",
 "haemoglobinuria": "بيلة هيموغلوبينية (وجود الهيموغلوبين في البول)",
 "haemolysin": "حال الدم, هيموليسين (أي مادة يمكن أن تسبب تحلل كريات الدم الحمراء وإطلاق الهيموجلوبين منها)",
 "haemolysis": "انحلال الدم, تحلل الدم (تحلل كريات الدم الحمراء مع إطلاق الهيموجلوبين)",
 "haemolytic": "انحلالي, محلل للدم (يتعلق بانحلال الدم أو يسببه)\nمثال: فقر الدم الانحلالي",
 "haemolytic anaemia": "فقر الدم الانحلالي (فقر دم ينتج عن تدمير كريات الدم الحمراء)",
 "haemophile": "مَرِيض بِالنَّاعُور, هِيمُوفِيلِيّ (شخص مصاب بمرض الهيموفيليا (الناعور) وعرضة لنزيف لا يمكن السيطرة عليه)",
 "haemophilia": "هِيمُوفِيلِيَا, نَزْف دَم وِرَاثِيّ",
 "haemophilia a": "الناعور أ, الهيموفيليا الكلاسيكية (هيموفيليا ناجمة عن نقص خلقي في العامل الثامن؛ تحدث حصريًا تقريبًا عند الرجال)",
 "haemophilia b": "الناعور ب, مرض كريسماس (اضطراب تخثر مشابه للهيموفيليا أ ولكنه ناتج عن نقص خلقي في العامل التاسع)",
 "haemophiliac": "مَرِيض بِالنَّاعُور, هِيمُوفِيلِيّ (شخص مصاب بمرض الهيموفيليا (الناعور) وعرضة لنزيف لا يمكن السيطرة عليه)",
 "haemophilic": "ناعوري, هيموفيلي (متعلق بمرض الهيموفيليا (الناعور) أو الإصابة به)",
 "haemopoiesis": "تكون الدم, تكون الكريات (تكوين خلايا الدم في الجسم الحي (خاصة في نخاع العظم))",
 "haemopoietic": "مكون للدم (متعلق بتكوين الدم أو خلايا الدم)\nمثال: خلايا جذعية مكونة للدم في نخاع العظم",
 "haemoproteid": "متقلبة دموية (مرتبطة بطفيل الملاريا ولها مرحلة في أحشاء طيور مختلفة)",
 "haemoprotein": "بروتين الهيم (بروتين مقترن مرتبط بمركب من الحديد والبورفيرين)",
 "haemoptysis": "نفث الدم (سعال الدم من الجهاز التنفسي؛ عادة ما يشير إلى عدوى شديدة في الشعب الهوائية أو الرئتين)",
 "haemorrhage": "نزف, نزيف (تدفق الدم من وعاء دموي ممزق)",
 "haemorrhagic": "نزفي (مكون من أو متعلق بالنزيف)",
 "haemorrhagic fever": "حمى نزفية (مجموعة من الأمراض التي تسببها عدوى فيروسية؛ تلي الحمى والأعراض المعوية نزيف شعيري)",
 "haemorrhagic stroke": "سكتة دماغية نزفية (سكتة دماغية ناجمة عن تمزق وعاء دموي في الدماغ)",
 "haemorrhoid": "بواسير (تضخم وريدي خارجي أو داخلي للمصرة الشرجية)",
 "haemorrhoidectomy": "استئصال البواسير (إجراء جراحي لربط البواسير واستئصالها)",
 "haemorrhoids": "بَوَاسِير",
 "haemosiderin": "هيموسيديرين (مادة بنية حبيبية تتكون من أكسيد الحديديك؛ تتبقى من تحلل الهيموجلوبين؛ يمكن أن تكون علامة على اضطراب استقلاب الحديد)",
 "haemosiderosis": "داء ترسب الأصبغة الدموية (ترسب غير طبيعي للهيموسيديرين؛ غالباً ما يكون عرضاً للثلاسيميا أو داء ترسب الأصبغة الدموية)",
 "haemosporidian": "بوغيات دموية (أوالي دقيقة تتطفل في مرحلة ما من دورة حياتها في خلايا الدم للفقاريات وتشمل العديد من مسببات الأمراض)",
 "haemostasia": "إرقاء, قطع النزف (إجراء جراحي لوقف تدفق الدم)",
 "haemostasis": "إرقاء, قطع النزف (إجراء جراحي لوقف تدفق الدم)",
 "haemostat": "ملقط مرقئ (أداة جراحية توقف النزيف عن طريق ضغط الأوعية الدموية)",
 "haemothorax": "تدمي الصدر (تراكم الدم في التجويف الجنبي (الفراغ بين الرئتين وجدران الصدر))",
 "haemulon album": "مارغيت (ناخر ذو فم أحمر يوجد من فلوريدا إلى البرازيل)",
 "haemulon aurolineatum": "تومتيت (يوجد قبالة جزر الهند الغربية وفلوريدا)",
 "haemulon macrostomum": "ناخر إسباني (نوع من الناخر)",
 "haemulon malanurum": "قطنية الفتيل (من مياه المحيط الأطلسي الدافئة)",
 "haemulon parra": "خيار البحار (ناخر يوجد من فلوريدا إلى البرازيل وخليج المكسيك)",
 "hafiz": "حَافِظ",
 "hafnium": "هَفْنِيُوم",
 "haft": "مقبض, نِصاب (مقبض سلاح أو أداة)",
 "hag": "شَمْطَاء",
 "hag-ridden": "مُبْتَلًى بِالكَوَابِيس, مُعَذَّب (يعذبه الكوابيس أو المخاوف غير المعقولة ويطارده)",
 "hagada": "الهاجادا (أدب تلمودي لا يتعامل مع القانون ولكنه لا يزال جزءاً من التقليد اليهودي)",
 "haganah": "الهاغاناه (الجناح العسكري السري للقيادة اليهودية خلال الحكم البريطاني على فلسطين من 1920 إلى 1948؛ أصبح الأساس لجيش الدفاع الإسرائيلي)",
 "hagar": "هَاجَر",
