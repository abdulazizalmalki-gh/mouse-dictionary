 "gospeller": "إنجيلي, مبشر (واعظ بالإنجيل المسيحي)",
 "gospels": "إنجيل, الأناجيل (الكتب الأربعة في العهد الجديد (متى ومرقس ولوقا ويوحنا) التي تروي قصة حياة المسيح وتعاليمه)",
 "gossamer": "أَثِيرِيّ, شَفَّاف (يَتَّسِمُ بِخِفَّةٍ وَرِقَّةٍ غَيْرِ مَعْهُودَة) / رَقِيقٌ كَالغَزْل, شَفَّاف (بَالِغُ الرِّقَّةِ بِحَيْثُ يَنْفُذُ مِنْهُ الضَّوْء) / خيط العنكبوت, نسيج العنكبوت (خيوط من شبكة نسجها عنكبوت) / جوسامر, قماش شفاف (قماش شاش ذو نسيج ناعم للغاية)",
 "gossip": "نَمِيمَة, إِشَاعَة / اِغْتَابَ",
 "gossip columnist": "كاتب عمود القيل والقال (صحفي يكتب عموداً من القيل والقال عن المشاهير)",
 "gossiper": "نَمَّام, نَمَّامة",
 "gossiping": "اغتياب, نميمة (محادثة تنشر معلومات شخصية عن الآخرين)",
 "gossipmonger": "ثرثار, نمّام (شخص يميل إلى الثرثرة وإفشاء المعلومات الشخصية عن الآخرين)",
 "gossipmongering": "اغتياب, نميمة (محادثة تنشر معلومات شخصية عن الآخرين)",
 "gossipy": "ثَرْثَار, نَمَّام (يميل إلى الدردشة غير الرسمية ونقل الأخبار والقيل والقال)",
 "gossypium arboreum": "قطن شجري (شجيرة من شرق الهند تُزرع خاصة للزينة لزهورها الصفراء الشاحبة إلى الأرجوانية الداكنة)",
 "gossypium barbadense": "قطن جزر البحر (شجرة كثيفة صغيرة تنمو في جزر الكاريبي وقبالة الساحل الأطلسي لجنوب الولايات المتحدة؛ تنتج قطناً بألياف حريرية طويلة بشكل غير عادي)",
 "gossypium herbaceum": "قطن عشبي, قطن ليفانت (نبات حولي من العالم القديم بأوراق على شكل قلب وبذور كبيرة ذات وبر رمادي قصير يُزال بصعوبة؛ يعتبر سلفاً للأقطان الحديثة قصيرة التيلة)",
 "gossypium hirsutum": "قطن المرتفعات, قطن مشعر (نبات أمريكي استوائي أصلي يُزرع الآن في الولايات المتحدة وينتج قطناً قصير التيلة)",
 "gossypium peruvianum": "قطن بيروفي (قطن بألياف خشنة طويلة ومشعرّة)",
 "gossypium thurberi": "قطن أريزونا البري, قطن بري (شجيرة من جنوب أريزونا والمكسيك)",
 "got it": "فَهِمْتَ, فَهِمْتِ / فَهِمْتُ",
 "goth": "قُوطِيّ, قُوط",
 "gothenburg": "غُوتِنْبُرْغ",
 "gothic": "قُوطِيَّة",
 "gothic arch": "قوس قوطي (قوس مدبب؛ عادة ما يكون له مفصل (بدلاً من حجر العقد) في القمة)",
 "gothic architecture": "العمارة القوطية, القوطية (طراز معماري تطور في شمال فرنسا وانتشر في جميع أنحاء أوروبا بين القرنين الثاني عشر والسادس عشر؛ يتميز بالأعمدة الرأسية النحيلة والدعامات الموازنة…)",
 "gothic language": "اللغة القوطية (لغة جرمانية شرقية منقرضة للقوط القدماء؛ السجل الوحيد الباقي هو أجزاء من ترجمة للكتاب المقدس من القرن الرابع)",
 "gothic revival": "إحياء العمارة القوطية, القوطية الحديثة (طراز معماري استلهم العمارة في العصور الوسطى وتنافس مع حركات الإحياء الكلاسيكية الجديدة في الولايات المتحدة وبريطانيا العظمى)",
 "gothic revival architecture": "إحياء العمارة القوطية, القوطية الحديثة (طراز معماري استلهم العمارة في العصور الوسطى وتنافس مع حركات الإحياء الكلاسيكية الجديدة في الولايات المتحدة وبريطانيا العظمى)",
 "gothic romance": "رواية قوطية, رومانسية قوطية (رواية رومانسية تتناول أحداثاً موحشة وغامضة وغريبة)",
 "gothic romancer": "كاتب الرومانسية القوطية (كاتب للروايات الرومانسية القوطية)",
 "gothite": "غوثيت (معدن أحمر أو أصفر أو بني؛ أكسيد الحديد ومكون شائع للصدأ)",
 "gotterdammerung": "راغناروك, شفق الآلهة (أسطورة حول الدمار النهائي للآلهة في معركة مع قوى الشر)",
 "gouache": "جواش (لوحة مائية منفذة بألوان مائية معتمة ممزوجة بالصمغ) / جواش (ألوان مائية غير شفافة محضرة بالصمغ)",
 "gouda": "غَوْدَا",
 "gouda cheese": "جبن غودا, غودا (جبن هولندي كريمي اللون خفيف يشكل في كرات)",
 "gouge": "تجويف, نقر (فعل النقر أو التجويف بأداة) / إزميل مقعر, مِنْقَار (أداة ذات حد بشفرة تشبه الميزاب لقطع القنوات أو الأخاديد) / انبعاج, حز (أثر غائر في سطح (كما ينتج عن ضربة))",
 "gouger": "محتال, نصاب (شخص يحتال عليك عن طريق الخداع أو الغش) / قالع الأعين (مهاجم يقتلع عين الخصم)",
 "goujon": "سلور مسطح الرأس (سلور كبير في وسط الولايات المتحدة له رأس مسطح وفك بارز)",
 "goulash": "غُولَاش",
 "gourd": "قَرْع (ضرب بشدة على شيء يَصْدُرُ منه صوت قوي؛ في سياق مجازي: أوقع الضربة أو وقع الصوت المفاجئ أو الحاد)\nمثال: توقف ذلك القرع.",
 "gourd vine": "قرع, يقطين (أي كرمة من الفصيلة القرعية تحمل ثماراً ذات قشور صلبة)",
 "gourde": "غورد (وحدة المال الأساسية في هايتي)",
 "gourmand": "أكول, شرِه (شخص مفرط في الأكل والشرب)",
 "gourmandism": "شره, نهم (طبع وعادات الأكول)",
 "gourmandizer": "أكول, شرِه (شخص مفرط في الأكل والشرب)",
 "gourmet": "ذَوَّاق",
 "gout": "رَثْيَة / نِقْرِس",
 "gouty": "مُصَاب بِالنِّقْرِس, نِقْرِسِيّ (يعاني من داء النِّقرس)",
 "gouty arthritis": "التهاب المفاصل النقرسي, نقرس (التهاب مؤلم في إصبع القدم الكبير والقدم ناجم عن عيوب في استقلاب حمض اليوريك مما يؤدي إلى ترسبات الحمض وأملاحه في الدم والمفاصل)",
 "govern": "حَكَمَ, تَحَكَّمَ (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ)\nمثال: حكم علي بالموت.",
 "governable": "قَابِلٌ لِلسَّيْطَرَة (يمكن التحكم فيه)",
 "governance": "إدارة, حكم (فعل الحكم؛ ممارسة السلطة) / إدارة, المؤسسة (الأشخاص (أو اللجان أو الأقسام وما إلى ذلك) الذين يشكلون هيئة لغرض إدارة شيء ما)\nمثال: لوائح لحكم سجون الولاية",
 "governed": "رعية, محكومون (مجموعة الأشخاص الذين هم مواطنون في حكومة معينة)\nمثال: تستمد الحكومات سلطاتها العادلة من موافقة المحكومين",
 "governess": "مربية (امرأة يُعهد إليها برعاية وإشراف طفل (خاصة في منزل خاص))",
 "governing": "حَاكِم (مَسْؤُول عَنْ وَضْع القَوَانِين وَإِنْفَاذِهَا) / إدارة, حكم (فعل الحكم؛ ممارسة السلطة)\nمثال: لوائح لحكم سجون الولاية",
 "governing board": "مجلس إدارة, مجلس حاكم (مجلس يدير شؤون مؤسسة ما)",
 "governing body": "إدارة, المؤسسة (الأشخاص (أو اللجان أو الأقسام وما إلى ذلك) الذين يشكلون هيئة لغرض إدارة شيء ما)\nمثال: يدعي أن الإدارة الحالية فاسدة",
 "government": "حُكُومَة (الجهة أو المؤسسة التي تحكم دولة أو أرض ما)\nمثال: انشأوا حكومة جديدة.",
 "government accounting office": "مكتب المحاسبة الحكومي (وكالة فيدرالية مستقلة غير حزبية تعمل كذراع تحقيق للكونغرس، مما يجعل السلطة التنفيذية مسؤولة أمام الكونغرس والحكومة مسؤولة أمام مواطني الولايات المتحدة)",
 "government activity": "إدارة, حكم (فعل الحكم؛ ممارسة السلطة)\nمثال: لوائح لحكم سجون الولاية",
 "government agency": "مكتب, هيئة (وحدة إدارية حكومية)\nمثال: وكالة الاستخبارات المركزية",
 "government agent": "عميل حكومي, مسؤول حكومي (ممثل أو مسؤول حكومي أو تابع لإدارة حكومية)",
 "government bond": "سند حكومي (سند يعتبر وثيقة دين على وزارة الخزانة الأمريكية؛ يعتبر الورقة المالية الأكثر أماناً في عالم الاستثمار)",
 "government building": "مبنى حكومي (مبنى يضم فرعاً من فروع الحكومة)",
 "government department": "إدارة حكومية, مصلحة حكومية (قسم تابع للحكومة)",
 "government income": "إيرادات الدولة, دخل الحكومة (الدخل المتاح للحكومة)",
 "government issue": "إصدار عسكري, مخصصات حكومية (إمدادات (كالطعام أو الملابس أو الذخيرة) تصدرها الحكومة)",
 "government man": "عميل فيدرالي (عميل ذكر خاص لإنفاذ القانون في مكتب التحقيقات الفيدرالي)",
 "government minister": "وزير (شخص مُعين في منصب رفيع في الحكومة)\nمثال: وزير المالية",
 "government note": "ورقة نقدية (قطعة من النقود الورقية (خاصة تلك الصادرة عن بنك مركزي))\nمثال: سحب خمس أوراق نقدية من فئة ألف زلوتي",
 "government office": "مكتب حكومي (مكتب يعمل فيه موظفو الحكومة)",
 "government officials": "مسؤولون حكوميون (أشخاص منتخبون أو معينون لإدارة حكومة)",
 "government printing office": "مكتب الطباعة الحكومي الأمريكي (وكالة تابعة للسلطة التشريعية تقدم خدمات الطباعة والتجليد للكونغرس والإدارات والمؤسسات التابعة للحكومة الفيدرالية)",
 "government revenue": "إيرادات الدولة, دخل الحكومة (الدخل المتاح للحكومة)",
 "government security": "ورقة مالية حكومية (ورقة مالية تصدرها وكالات حكومة الولايات المتحدة أو نظام الائتمان الزراعي)",
 "government woman": "عميلة فيدرالية (عميلة أنثى خاصة لإنفاذ القانون في مكتب التحقيقات الفيدرالي)",
 "government-in-exile": "حكومة في المنفى (حكومة مؤقتة انتقلت إلى أو تشكلت في أرض أجنبية من قبل المنفيين الذين يأملون في الحكم عند تحرير بلادهم)",
 "governmental": "حُكُومِيّ",
 "governmentally": "حكومياً (من قبل الحكومة)\nمثال: سياسة محددة حكومياً",
 "governor": "مُحَافِظ, حَاكِم",
 "governor general": "حَاكِم عَامّ (حَاكَمَ القاضي فلانا: أقام عليه محكمة ليرى ما إذا كان مجرما أم لا؛ حَاكَمَ فلانٌ فلانا: رفع عليه قضية؛ اشتكى عليه عند القضاء فأقاموا محكمة للحكم في الأمر)\nمثال: ميت رومني هو حاكم ولاية ماساتشوستس.",
 "governor plum": "برقوق الحاكم, برقوق مدغشقر (شجرة شجيرية صغيرة من مدغشقر تزرع في المناطق الاستوائية كنبات سياج ولثمارها الحمراء الداكنة الحمضية التي تشبه البرقوق الصغير)",
 "governor's plum": "برقوق الحاكم, برقوق مدغشقر (شجرة شجيرية صغيرة من مدغشقر تزرع في المناطق الاستوائية كنبات سياج ولثمارها الحمراء الداكنة الحمضية التي تشبه البرقوق الصغير)",
