 "haloform": "هالوفورم",
 "halogen": "هالوجين (أي من العناصر اللافلزية الخمسة المرتبطة (الفلور أو الكلور أو البروم أو اليود أو الأستاتين) التي تكون جميعها أحادية التكافؤ وتشكل أيونات سالبة بسهولة)",
 "halogeton": "هالوجيتون (عشب حولي خشن أدخل إلى أمريكا الشمالية من سيبيريا؛ خطير على الأغنام والماشية في المراعي الغربية بسبب محتواه العالي من الأكسالات)",
 "halogeton glomeratus": "هالوجيتون (عشب حولي خشن أدخل إلى أمريكا الشمالية من سيبيريا؛ خطير على الأغنام والماشية في المراعي الغربية بسبب محتواه العالي من الأكسالات)",
 "halogeton souda": "أشنان, باريلا (نبات جزائري كان يحرق سابقاً للحصول على كربونات الكالسيوم)",
 "halon": "هالون (مركب تم فيه استبدال ذرات الهيدروجين في الهيدروكربون بالبروم وذرات هالوجين أخرى؛ مستقر جداً؛ يستخدم في طفايات الحريق رغم أنه يُعتقد أنه يطلق البروم…)",
 "haloperidol": "هالدول, هالوبيريدول (مهدئ (الاسم التجاري هالدول) يستخدم لعلاج بعض الاضطرابات الذهانية ومتلازمة توريت)",
 "halophil": "أليف الملح, محب للملوحة (بكتيريا قديمة تتطلب بيئة غنية بالملح للنمو والبقاء)",
 "halophile": "أليف الملح, محب للملوحة (بكتيريا قديمة تتطلب بيئة غنية بالملح للنمو والبقاء)",
 "halophyte": "نبات ملحي (نبات ينمو بشكل طبيعي في تربة شديدة الملوحة)",
 "halothane": "هالوثان (مخدر استنشاقي غير قابل للاشتعال ينتج تخديراً عاماً؛ يستخدم جنباً إلى جنب مع المسكنات ومرخيات العضلات للعديد من أنواع العمليات الجراحية)",
 "halt": "أَعْرَج, مُقْعَد (مُصَابٌ بِعَجْزٍ فِي القَدَمَيْنِ أَوِ السَّاقَيْنِ) / إيقاف, تجميد (مقاطعة أو تعليق مؤقت للتقدم أو الحركة) / توقف, وقوف (حدث انتهاء شيء ما) / توقف, كبح (حالة عدم النشاط بعد انقطاع)\nمثال: وقف سباق التسلح",
 "halter": "دبوس التوازن (أي من الأجنحة الخلفية الضامرة للحشرات ثنائية الأجنحة؛ تستخدم للحفاظ على التوازن أثناء الطيران) / بلوزة برباط عنق, هالتر توب (توب نسائي يربط خلف الظهر والرقبة ويترك الظهر والذراعين مكشوفين) / رسن, مقود (غطاء رأس من الحبل أو القماش للحصان، مع حبل للقيادة) / حبل المشنقة (حبل يستخدمه الجلاد لإعدام الأشخاص المحكوم عليهم بالموت شنقاً)",
 "haltere": "دبوس التوازن (أي من الأجنحة الخلفية الضامرة للحشرات ثنائية الأجنحة؛ تستخدم للحفاظ على التوازن أثناء الطيران)",
 "halting": "مُتَعَثِّر, مُتَلَعْثِم (مُتَقَطِّع أَوْ مُتَرَدِّد بِسَبَب الانْفِعَال) / أَعْرَج, مُقْعَد (مُصَابٌ بِعَجْزٍ فِي القَدَمَيْنِ أَوِ السَّاقَيْنِ)",
 "haltingly": "بتردد, بتلعثم (بطريقة مترددة)\nمثال: تحدث بتلعثم",
