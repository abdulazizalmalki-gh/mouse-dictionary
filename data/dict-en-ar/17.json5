 "millenary": "ألفي (متعلق بالعدد 1000 أو مكون منه) / ألفي (من أو متعلق بعقيدة الألفية) / أَلْفِيَّة (مجموع أو تجميع لألف (خاصة ألف سنة)) / ألفية (فترة زمنية تمتد لألف عام)",
 "millennial": "ألفي (متعلق بألفية أو فترة تمتد لألف عام)",
 "millennian": "ألفي (متعلق بألفية أو فترة تمتد لألف عام)",
 "millennium": "أَلْفِيَّة",
 "millenniumism": "ألفية (الإيمان بالعقيدة المسيحية للألفية المذكورة في سفر الرؤيا)",
 "millepede": "ألفية الأرجل (أي من المفصليات العاشبة غير السامة العديدة التي لها جسم أسطواني مكون من 20 إلى 100 قطعة أو أكثر معظمها له زوجان من الأرجل)",
 "miller": "طَحَّان, طَحَّانَة",
