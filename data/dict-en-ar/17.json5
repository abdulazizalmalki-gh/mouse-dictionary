 "manpower": "أيدي عاملة, قوة عاملة (قوة العمال المتاحة)",
 "manque": "مُحْبَط الطُّمُوح (لم يتحقق طموحه أو أحبطته الظروف عن بلوغ مراده)",
 "manroot": "كرمة البطاطا البرية (نبات معمر عشبي مفترش أو متسلق أمريكي استوائي له جذر نشوي ضخم؛ يعتبر أحياناً مصدراً للبطاطا الحلوة)",
 "mansard": "مَنْصَارْدِيّ ((للسقف) ذو ميلَين على جميع الجوانب مع كون الميل السفليّ أشدّ من العلويّ) / سقف سنامي, سقف مانسارد (سقف سنامي له ميلان على كل جانب)",
 "mansard roof": "سقف سنامي, سقف مانسارد (سقف سنامي له ميلان على كل جانب)",
 "manse": "سكن القسيس (مقر إقامة رجل الدين (خاصة رجل الدين المشيخي)) / بيت فخم, قصر (منزل كبير ومثير للإعجاب)",
 "manservant": "خادم رجل (خادم من الرجال)",
 "mansi": "الفوغول, المانسي (اللغة الأوغرية (المرتبطة بالمجرية) التي يتحدث بها الفوغول) / فوغول, مانسي (عضو في شعب بدوي في شمال جبال الأورال)",
 "mansi language": "الفوغول, المانسي (اللغة الأوغرية (المرتبطة بالمجرية) التي يتحدث بها الفوغول)",
 "mansion": "قَصْر (ضد الطول؛ غير تام، غير كامل)\nمثال: لقد قصر الخطاب.",
 "mansion house": "بيت فخم, قصر (منزل كبير ومثير للإعجاب)",
 "manslaughter": "قتل خطأ, قتل غير متعمد (قتل دون سبق إصرار وترصد)",
 "manslayer": "قاتل (مجرم يرتكب جريمة قتل (من يقوم بالقتل المتعمد غير المشروع لإنسان آخر))",
 "manta": "شيطان البحر, مانتا (سمكة راي استوائية ضخمة للغاية تعيش في عرض البحر وتتغذى على العوالق والأسماك الصغيرة؛ عادة ما تكون غير ضارة ولكن حجمها يجعلها خطيرة إذا تم صيدها بالرمح) / مانتا (بطانية تستخدم كعباءة أو شال)",
 "manta birostris": "مانتا أطلسية (أكبر أنواع المانتا (يصل عرض جناحيها إلى 22 قدماً)؛ توجد في جميع أنحاء العالم ولكنها شائعة في خليج المكسيك وعلى طول السواحل الجنوبية للولايات المتحدة؛…)",
 "manta ray": "شيطان البحر ((في الأديان الإبراهيمية) الرُّوح الشِّرِّير الَّذِي يَرْمِي بِكَ لِلتَّهْلُكَةِ لِبُعْدِهِ عَنِ الْخَيْرِ وَطَرِيقِ الْحَقِّ؛ (استعمال مجازي) كُلّ وَلَدٍ مُشَاكِسٍ أَوْ مُتَمَرِّدٍ)\nمثال: العجلة من الشيطان.",
 "mantel": "رف الموقد (رف يبرز من الجدار فوق الموقد)",
 "mantelet": "رداء نسائي قصير, مانتيلا (رداء قصير ترتديه النساء) / ترس محمول (مأوى محمول مضاد للرصاص)",
 "mantelpiece": "رَفّ اَلْمُسْتَوْقَد (رَفَّتْ أَوْراقُ الشَّجَرِ: اِهْتَزَّتْ، تَحَرَّكَتْ؛ رَفَّتِ العَيْنُ: رَمَّشَتْ)\nمثال: وضع الكتاب على الرف.",
 "manti": "مَنْتُو",
 "mantic": "عِرَافِيّ, كَهَنُوتِيّ (يُشبِه أو يتّسم بسمات نبيّ أو نبوءة)",
 "mantichora": "مانتيكور (وحش أسطوري له رأس إنسان (بقرون) وجسم أسد وذيل عقرب)",
