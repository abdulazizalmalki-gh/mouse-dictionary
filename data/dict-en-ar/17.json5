 "millimeter": "مليمتر (وحدة مترية للطول تساوي واحداً من الألف من المتر)",
 "millimeter of mercury": "تور, مليمتر زئبقي (وحدة ضغط تساوي 0.001316 ضغط جوي؛ سُميت نسبة إلى تورشيللي)",
 "millimetre": "مِلِّيمِتْر",
 "millimicron": "نانومتر (وحدة مترية للطول تساوي واحداً من المليار من المتر)",
 "milline": "ميلين (مقياس إعلاني؛ سطر أغات واحد يظهر في مليون نسخة من مطبوعة)",
 "milliner": "صانع قبعات, قبعاتي (شخص يصنع ويبيع القبعات)",
 "millinery": "قبعات نسائية (القبعات المخصصة للنساء؛ البضائع التي يبيعها صانع القبعات النسائية) / متجر قبعات نسائية (متجر يبيع القبعات النسائية)",
 "milling": "تخريش الحافة (الحافة المموجة لعملة معدنية)",
 "milling machine": "آلة تفريز (أداة آلية يتم فيها تغذية المعدن المثبت على عربة ضد قواطع دوارة تشكله)",
 "milling machinery": "طاحونة, مطحنة (آلات تعالج المواد عن طريق الطحن أو السحق)",
 "million": "مِلْيُون, ١٠٠٠٠٠٠",
 "million floating point operations per second": "مليون عملية نقطة عائمة في الثانية, ميغا فلوب ((علم الحاسوب) وحدة لقياس سرعة نظام الحاسوب، الميغا فلوب الواحد هو مليون عملية نقطة عائمة في الثانية)",
 "million instructions per second": "مليون تعليمة في الثانية ((علم الحاسوب) وحدة لقياس سرعة تنفيذ وحدة المعالجة المركزية للحاسوب)",
 "millionaire": "مِلْيُونِير",
 "millionairess": "مليونيرة (امرأة تملك الملايين)",
 "millionfold": "مليون ضعف (بمقدار مليون ضعف)\nمثال: ازداد مليون ضعف",
 "millionth": "اَلْمِلْيُونُ (العدد الترتيبي لمليون في العدّ) / جُزْء مِن مِلْيُون (جزء واحد من مليون جزء متساوي) / المتمم للمليون, المليون (المركز 1,000,000 في سلسلة معدودة من الأشياء)",
 "milliped": "ألفية الأرجل (أي من المفصليات العاشبة غير السامة العديدة التي لها جسم أسطواني مكون من 20 إلى 100 قطعة أو أكثر معظمها له زوجان من الأرجل)",
 "millipede": "دُودَة أَلْفِيَّة, ذات الألف قدم",
 "milliradian": "مليراديان (وحدة مسافة زاوية تساوي واحدًا من الألف من الراديان)",
 "millirem": "ملي ريم (جرعة من الإشعاع المؤين تعادل واحداً من الألف من الريم)",
 "milliroentgen": "ملي رونتغن (وحدة للتعرض للإشعاع المؤين، تساوي واحداً من الألف من الرونتغن)\nمثال: التعرض المعتاد للإشعاع الخلفي الطبيعي للإنسان هو حوالي 200 ملي رونتغن سنوياً",
 "millisecond": "مِيلِي ثَانِيَة",
 "millivolt": "ملي فولت (وحدة للجهد تساوي واحد من الألف من الفولت)",
 "millivoltmeter": "مقياس ميلي فولت (مقياس فولت حساس يمكنه قياس الجهد بالميلي فولت)",
 "milliwatt": "ملي واط (وحدة للقدرة تساوي واحد من الألف من الواط)",
 "millpond": "بركة الطاحونة (بركة تشكلت عن طريق إقامة سد على مجرى مائي لتوفير قوة دفع مائية لتدوير عجلة الطاحونة)",
 "millrace": "قناة الطاحونة, مجرى مائي (قناة لتيار الماء الذي يدير عجلة الطاحونة)",
 "millrun": "قناة الطاحونة, مجرى مائي (قناة لتيار الماء الذي يدير عجلة الطاحونة)",
 "millstone": "رَحًى (رَحَى: طاحون؛ مؤنثة، جمعها: أرحاء، أرحية، أرح، رَحِيّ، رِحِيّ، رِحًى، وأُرْحِي، ومِثل: رَحْوان ورَحْيان؛ ورَحَى: وَجْ، جمعه أرحاء، بمعنى الصدر)",
 "millwheel": "عجلة الطاحونة (عجلة مائية تستخدم لتشغيل الآلات في الطاحونة)",
 "millwork": "منتجات خشبية مصنعة (أعمال خشبية تم تشكيلها بآلات في مصنع)",
 "millwright": "ميكانيكي طواحين (عامل يصمم أو ينصب الطواحين وآلات الطحن)",
 "milo": "ذرة ميلو, ميلو (سورغم صغير مقاوم للجفاف له حبوب صفراء أو بيضاء كبيرة)",
 "milo maize": "ذرة ميلو, ميلو (سورغم صغير مقاوم للجفاف له حبوب صفراء أو بيضاء كبيرة)",
 "milometer": "عداد المسافات (عداد يظهر المسافة المقطوعة بالميل)",
 "milontin": "فينسوكسيميد, ميلونتين (مضاد للاختلاج (الاسم التجاري ميلونتين) يستخدم لعلاج الصرع الصغير)",
 "milord": "ميلورد (مصطلح لمخاطبة لورد إنجليزي)",
 "milova": "ميلوفا",
 "milquetoast": "جبان, مخنث (رجل أو صبي خجول يعتبر طفولياً أو غير حازم)",
 "milt": "بطروح, مني السمك (السائل المنوي الذي تنتجه ذكور الأسماك) / سرء, مني السمك (حيوانات منوية للسمك أو غدة تناسلية ممتلئة بالحيوانات المنوية؛ لها قوام كريمي)",
 "miltomate": "توماتيلو, ميلتومات (نبات حولي مكسيكي تم توطينه في شرق أمريكا الشمالية له ثمار صفراء إلى أرجوانية صالحة للأكل تشبه الطماطم الصغيرة)",
 "miltown": "إكوانيل, ميبروبامات (مهدئ ومهدئ للأعصاب (الأسماء التجارية ميلتاون وإكوانيل وميبرين) يستخدم لعلاج توتر العضلات والقلق)",
 "milvus migrans": "حدأة سوداء (حدأة داكنة من العالم القديم تتغذى بشكل رئيسي على الجيف)",
 "mimamsa": "ميمامسا ((من الكلمة السنسكريتية التي تعني 'التأمل' أو 'التفسير') واحدة من الأنظمة الفلسفية الستة الأرثوذكسية أو وجهات النظر حول التقاليد الطقسية المتجذرة في…)",
 "mime": "بانتوميم, تمثيل صامت (أداء يستخدم الإيماءات وحركات الجسم بدون كلمات) / إيمائي, ممثل صامت (ممثل يتواصل كلياً عن طريق الإيماءات وتعابير الوجه)",
 "mimeo": "آلة سحب, ميميوغراف (ناسخة دوارة تستخدم استنسل يتم ضغط الحبر من خلاله)",
 "mimeograph": "آلة سحب, ميميوغراف (ناسخة دوارة تستخدم استنسل يتم ضغط الحبر من خلاله)",
 "mimeograph machine": "آلة سحب, ميميوغراف (ناسخة دوارة تستخدم استنسل يتم ضغط الحبر من خلاله)",
 "mimer": "إيمائي, ممثل صامت (ممثل يتواصل كلياً عن طريق الإيماءات وتعابير الوجه)",
 "mimesis": "ممسيس, ميحاكاة (التمثيل المحاكي للطبيعة والسلوك البشري في الفن والأدب) / محاكاة (تمثيل كلمات شخص آخر في خطاب) / محاكاة (أي مرض يظهر أعراضاً مميزة لمرض آخر)",
 "mimetic": "مُحَاكٍ (يُظهِر المحاكاة في السلوك أو المظهر) / مُحَاكَاتِيّ (يتميز بالمحاكاة أو يستخدمها في التعبير)",
 "mimic": "تَقْلِيدِيّ (يُشكِّل تقليداً أو محاكاة) / مقلد (شخص يقلد (خاصة ممثل أو ممثلة))",
 "mimicker": "مقلد (شخص يقلد (خاصة ممثل أو ممثلة))",
 "mimicry": "مُشَاكهَة",
 "mimir": "ميمير ((الأساطير الإسكندنافية) عملاق يعيش في جذور يغدراسيل ويحرس بئر الحكمة)",
 "mimosa": "ميموزا (مشروب مخلوط يحتوي على الشمبانيا وعصير البرتقال) / ست الحسن, ميموزا (أي من الشجيرات أو الأشجار الاستوائية المختلفة من جنس الميموزا ذات أزهار صفراء عادة وأوراق مركبة) / سنط فضي, ميموزا (شجرة أسترالية دائمة الخضرة ذات لحاء وأوراق صغيرة بيضاء أو فضية وزهور صفراء)",
 "mimosa bush": "أكاسيا حلوة, سنط عنبري (شجيرة شائكة أو شجرة صغيرة من أمريكا الاستوائية؛ تستخدم زهورها الصفراء العطرة في صناعة العطور)",
 "mimosa pudica": "ست المستحية, ميموزا خجولة (شجيرة فرعية مفترشة أو شبه منتصبة من أمريكا الاستوائية وأستراليا؛ مسلحة بشدة بأشواك منحنية ولها وريقات خضراء رمادية ناعمة حساسة تطوى وتتدلى في الليل…)",
 "mimosa sensitiva": "ميموزا حساسة, نبات حساس (شجيرة دائمة الخضرة شائكة شبه متسلقة من أمريكا الاستوائية لها أوراق مركبة حساسة للضوء واللمس)",
 "mimus polyglottos": "طائر محاكي (طائر مغرد طويل الذيل رمادي وأبيض من جنوب الولايات المتحدة قادر على تقليد أغاني الطيور الأخرى)",
 "min": "مين",
 "min dialect": "فوكين, لغة مين (أي من أشكال اللغة الصينية التي يتم التحدث بها في مقاطعة فوجيان)",
 "min language": "فوكين, لغة مين (أي من أشكال اللغة الصينية التي يتم التحدث بها في مقاطعة فوجيان)",
 "mina": "مِنًى, مِنَى (وعده بأمر كان يريده فأصبح أمنية)",
 "minacious": "مُتَوَعِّد, مُنْذِر بِالشَّرّ (يهدد أو ينذر بتطورات شريرة أو مأساوية)",
 "minaean": "مَعِينِيّ",
 "minah": "مينة (زرزور آسيوي استوائي)",
 "minamata disease": "داء ميناماتا (شكل من أشكال التسمم بالزئبق بين الأشخاص الذين أكلوا الأسماك من مياه خليج ميناماتا الملوثة بالزئبق قبالة اليابان في الخمسينيات؛ يتميز بتدهور عصبي حاد)",
 "minaret": "مَنَارَة, مِئْذَنَة (أسم، محجَّة الطريق وما يُوضَع بين الشيئَين من الحدود؛ اسم، البرج عند البحر يوضع فيه نور لتهتدي به السفن)",
 "minas gerais": "مِينَاسْ جِيرَايْسْ",
 "minatory": "مُتَوَعِّد, مُنْذِر بِالشَّرّ (يهدد أو ينذر بتطورات شريرة أو مأساوية)",
 "mince": "لَحْم مَفْرُوم (ما يبقى من جسم الحيوان أو الإنسان بعد إزالة الجلد الأحشاء والعظم والشحم والدم والأعصاب. يتكون أساسا من العَضَلَات؛ ما يؤكل من لحم من الحيوان والطير والسمك عامة)\nمثال: أفضل لحم البقر.",
 "mince pie": "فطيرة اللحم المفروم الحلوة (فطيرة تحتوي على خليط من الفواكه المجففة والتوابل)",
 "mincemeat": "حشوة اللحم المفروم الحلوة, مينسميت (خليط متبل من الزبيب والتفاح المفروم ومكونات أخرى مع أو بدون لحم)",
 "mincer": "مفرمة (أداة مطبخ تقطع أو تفرم الطعام (خاصة اللحوم) إلى قطع صغيرة)",
 "mincing": "مُتَصَنِّعٌ, مُتَكَلِّفٌ (مُتَصَنِّع في الرقة والتهذيب)",
 "mincing machine": "مفرمة (أداة مطبخ تقطع أو تفرم الطعام (خاصة اللحوم) إلى قطع صغيرة)",
 "mincingly": "بتصنع, بميوعة (بطريقة متصنعة)\nمثال: خطت بتصنع فوق البرك",
 "mind": "عَقْل (أمسك بأطرافه وربطه، أصلها للشاة والإبل حيث تربط قوائمها كي تبقى باركة فلا تقوم؛ بلغ العَقْل، أصبح عاقلا فاهما راشدا)\nمثال: هي فتاة تسحر العقل.",
 "mind game": "ألاعيب عقلية, تلاعب نفسي (إجراءات متعمدة من التلاعب النفسي المحسوب تهدف إلى التخويف أو الإرباك (عادة من أجل ميزة تنافسية)) / لعبة ذهنية (أي لعبة مصممة لتمرين العقل)\nمثال: يحاول لاعبو كرة القدم لعب ألاعيب عقلية مع الخصم",
 "mind one's own business": "اعتنى بشؤونه الخاصّة",
 "mind reader": "قارئ الأفكار (ساحر يبدو كأنه يميز أفكار شخص آخر (عادة عن طريق إشارات ذكية من شريك)) / قارئ الأفكار, متخاطر (شخص لديه القدرة على توصيل الأفكار مباشرة)",
 "mind's eye": "عين العقل, مخيلة (تخيل مشاهد متذكرة أو مخترعة)\nمثال: استطعت رؤيتها بوضوح في مخيلتي",
 "mind-altering": "مُغَيِّر لِلْوَعْي (يُحدِث تغييرات في المزاج أو تشوّهات في الإدراك)",
 "mind-altering drug": "عقار مؤثر عقلياً, مادة ذات تأثير نفسي (عقار يمكن أن ينتج تغيرات في المزاج وتشوهات في الإدراك)",
 "mind-bending": "مُذْهِل لِلْعَقْل (يؤثّر بشدّة في العقل وخاصّة بإحداث هلوسات)",
 "mind-blowing": "صَاعِق, مُذْهِل (يؤثّر بشدّة في العقل أو المشاعر) / مُذْهِل لِلْعَقْل (يؤثّر بشدّة في العقل وخاصّة بإحداث هلوسات)",
 "mind-boggling": "مُحَيِّر لِلْعَقْل (يُربك العقل أو المشاعر بشكل طاغٍ)",
 "mind-expanding": "مُوَسِّع لِلْإِدْرَاك ((في المخدّرات) يُعطي إحساسًا بوعي أعلى أو أوسع)",
 "mind-set": "ذهنية, عقلية (موقف ذهني اعتيادي أو مميز يحدد كيفية تفسير المواقف والاستجابة لها)",
 "minded": "ذُو مَيْل, مُهْتَمّ ((يُستخدم في التركيب) ذو توجه ذهني نحو شيء محدد)",
 "minder": "حاضِنَة مَنْزِلِيَّة, مُرَبِّيَة (شخص يعتني بالأطفال (عادة في منزله الخاص) أثناء عمل الوالدين) / رقيب, مرافق أمني (شخص (عادة في الدول الشمولية) يتم تعيينه لمراقبة الزوار الأجانب)\nمثال: استدرت وهناك، على بعد بضع مئات من الأقدام، كان مرافقنا الحكومي، لي وونغ سو، يلهث باتجاهنا",
 "mindfuck": "تلاعب بالعقول, زعزعة عقلية (شيء يزعزع استقرار عقل شخص آخر أو يربكه أو يتلاعب به عمداً)",
 "mindful": "مُنْتَبِه",
 "mindfully": "بانتباه, بحرص (بطريقة متعمدة وحذرة)",
 "mindfulness": "وعي, يقظة ذهنية (سمة البقاء واعياً (إيلاء اهتمام وثيق) بمسؤولياتك)",
 "mindless": "لَا يَحْتَاجُ تَفْكِيرًا (لا يتطلب جهدًا ذهنيًّا يُذكر) / أَعْمَى, بِلَا عَقْل (يفتقر إلى القدرة على التفكير التي تميز الكائن الواعي) / أَحْمَقُ, أَهْوَجُ (لا يتسم باستخدام العقل) / ساه, غافل (غير منتبه أو يقظ)\nمثال: وبينما كان غافلاً عن خطواته تعثر",
 "mindlessly": "بِدُونِ عَقْلَانِيَّة",
 "mindlessness": "رعونة, طيش (سمة التصرف برعونة وبدون تعقل) / حماقة, سخف (الافتقار التام للمعنى أو الأفكار)",
 "mindset": "ذهنية, عقلية (موقف ذهني اعتيادي أو مميز يحدد كيفية تفسير المواقف والاستجابة لها)",
 "mine": "لِي, لي / مَنْجَم, لَغَم / لَغْم, لَغَم / لَغَمَ",
 "mine cage": "قفص المنجم, مصعد المنجم ((التعدين) وسيلة نقل تستخدم لنقل العمال والإمدادات تحت السطح، وتكون معلقة من الرافعة بحبل سلكي فولاذي)",
 "mine detector": "كاشف ألغام (كاشف يتكون من جهاز كهرومغناطيسي؛ يستخدم لتحديد موقع الألغام المتفجرة)",
 "mine disposal": "التخلص من الألغام, تفكيك الألغام (التخلص من الألغام المتفجرة)",
 "mine field": "حقل ألغام (قطعة أرض تحتوي على ألغام متفجرة)",
 "mine pig": "حديد غفل منجمي (حديد غفل مصنوع بالكامل من الخام)",
 "mine run": "عَادِيّ, غَيْر مُمَيَّز (ليس مميزاً بأي شكل؛ يفتقر للتميز)",
 "mined": "مُستخرَج, مُعدَّن (مستخرج من مصدر توريد مثل المعادن من الأرض)",
 "minefield": "حَقْلُ أَلْغَام (ذهب أو حدث بسرعة أو دون توقف؛ في بعض اللهجات: تعني تحرك سريعاً أو اهتزّ)\nمثال: يعمل الفلاحون في الحقل.",
 "minelayer": "زارعة ألغام (سفينة مجهزة لزرع الألغام البحرية)",
 "minelaying": "تلهيم, زرع الألغام (زرع ألغام متفجرة في أماكن مخفية لتدمير أفراد ومعدات العدو)",
 "miner": "عامل منجم (عامل يعمل في منجم)",
 "miner's cat": "بساريسك, قط حلقي الذيل (ثديي قارت شبيه بالراكون من المكسيك وجنوب غرب الولايات المتحدة له ذيل كثيف طويل بحلقات سوداء وبيضاء)",
 "miner's lettuce": "خس عامل المنجم, رجلة الشتاء (عشبة عصارية تزرع أحياناً كسلطة أو بقلة؛ تنمو في الكثبان والأراضي البور بساحل المحيط الهادئ لأمريكا الشمالية)",
 "mineral": "مَعْدِن (فِي : مركب صُلْب، يتكون طبيعياً من خلال عمليات جيولوجية؛ فِي : ما يستخرج من باطن الأَرْض كالحَدِيد والرَّصَاص والذَّهَب والمُجَوْهَرَات)\nمثال: هذا السلم مصنوع من المعدن",
 "mineral association": "تجمع معدني (المعادن التي يمكن العثور عليها معاً في صخرة)",
 "mineral deficiency": "نقص المعادن (نقص في المغذيات الدقيقة المعدنية الضرورية للتغذية الطبيعية أو التمثيل الغذائي)",
 "mineral dressing": "استخلاص المعادن, معالجة الخامات (سحق الخامات وفصلها إلى مواد قيمة أو نفايات باستخدام أي من التقنيات المتنوعة)",
 "mineral extraction": "استخلاص المعادن, معالجة الخامات (سحق الخامات وفصلها إلى مواد قيمة أو نفايات باستخدام أي من التقنيات المتنوعة)",
 "mineral fertiliser": "سماد معدني (سماد غير عضوي يحتوي على معادن نادرة)",
 "mineral fertilizer": "سماد معدني (سماد غير عضوي يحتوي على معادن نادرة)",
 "mineral jelly": "فازلين, هلام بترولي (خليط شبه صلب من الهيدروكربونات يتم الحصول عليه من البترول؛ يستخدم في المراهم الطبية وللتزييت)",
 "mineral kingdom": "مملكة المعادن (جميع الأشياء غير العضوية؛ تتباين مع المملكتين الحيوانية والنباتية)",
 "mineral oil": "زيت معدني (مقطر من البترول (خاصة الذي يُستخدم طبياً كملين))",
 "mineral pitch": "أسفلت, قير معدني (مادة بيتومينية داكنة توجد في طبقات طبيعية وكبقايا من تقطير النفط؛ تتكون أساساً من الهيدروكربونات)",
 "mineral processing": "استخلاص المعادن, معالجة الخامات (سحق الخامات وفصلها إلى مواد قيمة أو نفايات باستخدام أي من التقنيات المتنوعة)",
 "mineral resources": "موارد معدنية (الموارد الطبيعية في شكل معادن)",
 "mineral tar": "قطران معدني, مالتا (قطران أسود سميك وسط بين النفط والأسفلت)",
 "mineral vein": "عرق معدني (طبقة من الخام بين طبقات الصخور)",
 "mineral water": "مَاء مَعْدِنِيّ (السائل الشفاف المعروف الذي تنشأ به الحياة، عديم اللون والرائحة والطعم عندما يكون نقيا؛ علميا فِي : جزيئة متكونة من ذرتي هيدروجين مرتبطين بذرة واحدة من الأوكسيجين)\nمثال: أنا أشرب الماء.",
 "mineral wax": "أوزوكريت, شمع معدني (معدن شمعي عبارة عن خليط من الهيدروكربونات ويوجد مصاحباً للنفط؛ تستخدم بعض أنواعه في صنع السيريسين والشموع)",
 "mineral wool": "صوف صخري, صوف معدني (مادة ليفية خفيفة تستخدم كعازل)",
 "mineralization": "تَمَعْدُن",
 "mineralocorticoid": "قشرانيات معدنية (هرمون هو أحد ستيرويدات قشرة الغدة الكظرية التي تؤثر على استقلاب الصوديوم والبوتاسيوم)",
 "mineralogist": "عالم معادن (عالم مدرب في علم المعادن)",
 "mineralogy": "علم المعادن (فرع الجيولوجيا الذي يدرس المعادن: بنيتها وخصائصها وطرق تمييزها)",
 "minerva": "مِينِيرْفَا",
 "mineshaft": "بئر المنجم (حفر يتكون من ممر عمودي أو مائل للعثور على الخام أو تعدينه أو لتهوية المنجم)",
 "minestrone": "حساء الخضروات, مينستروني (حساء مصنوع من مجموعة متنوعة من الخضروات)",
 "minesweeper": "كانسة الألغام",
 "minesweeping": "تطهير الألغام, كسح الألغام (نشاط الكشف عن الألغام البحرية والتخلص منها)",
 "mineworker": "عامل منجم (عامل يعمل في منجم)",
 "ming": "سلالة مينغ, مينغ (السلالة الإمبراطورية للصين من 1368 إلى 1644)",
 "ming dynasty": "سلالة مينغ, مينغ (السلالة الإمبراطورية للصين من 1368 إلى 1644)",
 "ming tree": "شجرة مينغ (صنوبرية أو شجيرة دائمة الخضرة مقزمة مشكلة لتكون ذات فروع غير متماثلة مسطحة القمة وتزرع في وعاء) / شجرة مينغ (نبات صناعي يشبه البونساي)",
 "minge": "شَعْرُ عَانَةِ المَرْأَة (مصطلح سوقي لشعر عانة المرأة أو أعضائها التناسلية)",
 "minginess": "خسة, شح (بخل شديد)",
 "mingle-mangle": "أخلاط, أشياء متنوعة (تشكيلة مختلطة من الأشياء)",
 "mingling": "اِخْتِلَاط, اِمْتِزَاج (فعل اختلاط الناس وتواصلهم)\nمثال: كل ذلك الاختلاط العشوائي والحديث الخامل جعله يكره الحفلات الأدبية",
 "mingy": "حَقِير, لَئِيم ((عن الأشخاص أو السلوك) يتسم بانعدام الكرم أو يدل عليه)",
 "mini": "قصير جداً, ميني (يستخدم لملابس النساء؛ قصير جداً بحاشية فوق الركبة) / تنورة قصيرة, ميني جيب (تنورة قصيرة جداً)\nمثال: فستان قصير جداً",
 "mini dress": "فستان قصير جداً (فستان قصير جداً لا يغطي الركبتين)\nمثال: فستان الميني ليس مناسباً لاجتماع رسمي",
 "miniature": "مُنَمْنَمَة",
 "miniature fan palm": "نخيل الخيزران, نخيل مروحي مصغر (نخيل رشيق صغير بسيقان تشبه القصب وقواعد أوراق مغطاة بألياف خشنة فضفاضة)",
 "miniature golf": "غولف مصغر, ميني غولف (نسخة مبتكرة من الغولف تُلعب بكرات الغولف والمضارب في ملعب مصغر يتميز بالعديد من العقبات)",
 "miniature pinscher": "بينشر مصغر (نسخة ألمانية صغيرة من الدوبرمان بينشر)",
 "miniature poodle": "بودل مصغر (سلالة من البودل الصغير)",
 "miniature schnauzer": "شناوزر مصغر (شناوزر صغير)",
 "miniaturisation": "تصغير (عملية الصنع بمقياس مخفض جداً)",
 "miniaturist": "رسام منمنمات, مصغر (شخص يرسم صوراً صغيرة جداً بتفاصيل دقيقة)",
 "miniaturization": "تصغير (عملية الصنع بمقياس مخفض جداً)",
 "minibar": "ثلاجة صغيرة, خزانة مشروبات (خزانة جانبية ذات حجيرات لحفظ القوارير)",
 "minibike": "دراجة نارية صغيرة (دراجة نارية صغيرة بإطار منخفض وعجلات صغيرة ومقاود مرتفعة)",
 "minibus": "مِيكْرُوبَاص / مِينِيبَاص",
 "minicab": "سيارة أجرة صغيرة (سيارة صغيرة تستخدم كسيارة أجرة)",
 "minicalculator": "آلة حاسبة صغيرة ((طراز قديم) آلة حاسبة محمولة صغيرة جداً)",
 "minicar": "سيارة صغيرة جداً (سيارة أصغر حتى من السيارة الصغيرة المدمجة)",
 "minicomputer": "حاسوب صغير (حاسوب رقمي متوسط الحجم)",
 "miniconju": "مينيكونجو (فرد من مجموعة من الشعب السيوي شكلت قسماً من تيتون سيوكس، وعاشوا في غرب داكوتا الجنوبية الحالية)",
 "minim": "بَيْضَاء (مؤنث أَبْيَض، صفة ما كان لونها البياض؛ يد بيضاء: هي اليد التي تعمل الخير وتسبق بالحسنات)\nمثال: هي بيضاء اللون.",
 "minimal": "أدنى, حد أدنى (أقل ما يمكن)\nمثال: الحاجة لفرض معايير دنيا",
 "minimal art": "التبسيطية, الفن التقليلي (حركة فنية في النحت والرسم بدأت في الخمسينيات وأكدت على التبسيط الشديد للشكل واللون)",
 "minimal brain damage": "اضطراب فرط الحركة ونقص الانتباه, اضطراب نقص الانتباه (حالة (تغلب عند الأولاد) تتميز باضطرابات سلوكية وصعوبات في التعلم)",
 "minimal brain dysfunction": "اضطراب فرط الحركة ونقص الانتباه, اضطراب نقص الانتباه (حالة (تغلب عند الأولاد) تتميز باضطرابات سلوكية وصعوبات في التعلم)",
 "minimalism": "التبسيطية, الفن التقليلي (حركة فنية في النحت والرسم بدأت في الخمسينيات وأكدت على التبسيط الشديد للشكل واللون)",
 "minimalist": "حَدِّيٌّ إِصْلَاحِيّ (يَدْعُو إِلَى الحَدِّ الأَدْنَى مِنَ الإِصْلَاحَاتِ فِي الحُكُومَةِ أَوِ السِّيَاسَة) / تبسيطي, تقليلي / تبسيطي, فنان الحد الأدنى (ممارس أو داعية لمذهب التبسيطية الفني) / إصلاحي أدنى, تقليلي (محافظ يدعو فقط إلى إصلاحات طفيفة في الحكومة أو السياسة)",
 "minimality": "أصغرية, حد أدنى (حالة كون الشيء في أقل كمية أو مقدار أو درجة ممكنة)\nمثال: سنقوم بخصم رسومنا بالنظر إلى الحد الأدنى من أعمال الهندسة الكهربائية والميكانيكية في المبنى",
 "minimally": "إلى الحد الأدنى (لدرجة دنيا)\nمثال: الخلايا المستجيبة للحد الأدنى للخطوط في هذا الاتجاه لن تطلق إشارات",
