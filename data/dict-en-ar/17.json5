 "metric": "عَرُوضِيّ, مَوْزُون (يتعلّق بالتنظيم الإيقاعي للمقاطع اللفظية) / متري (قائم على المتر كمعيار للقياس) / نظام قياس (نظام من المقاييس المترابطة يسهل تحديد كمية خاصية معينة) / وحدة مترية (وحدة قياس عشرية للنظام المتري (تعتمد على المتر والكيلوغرام والثانية))\nمثال: النظام المتري",
 "metric capacity unit": "وحدة سعة مترية (وحدة سعة محددة بالمصطلحات المترية)",
 "metric function": "دَالَّة مِتْرِيَّة, مِقْيَاس (دالة للفضاء الطوبولوجي تعطي لأي نقطتين في الفضاء قيمة تساوي المسافة بينهما)",
 "metric grain": "قمحة (وحدة وزن تستخدم للؤلؤ أو الألماس: 50 ملغ أو 1/4 قيراط)",
 "metric hundredweight": "قنطار متري, هندريدويت (وحدة وزن تساوي 100 كيلوغرام في النظام المتري)",
 "metric linear unit": "وحدة طول مترية (وحدة خطية للمسافة بالمصطلحات المترية)",
 "metric space": "فضاء متري (مجموعة من النقاط بحيث يوجد لكل زوج من النقاط عدد حقيقي غير سالب يسمى المسافة بينهما، ويكون متماثلاً ويحقق متباينة المثلث)",
 "metric system": "النظام المتري (نظام عشري للأوزان والمقاييس يعتمد على المتر والكيلوجرام والثانية)",
 "metric ton": "طُنّ مِتْرِيّ",
 "metric unit": "وحدة مترية (وحدة قياس عشرية للنظام المتري (تعتمد على المتر والكيلوغرام والثانية))\nمثال: حول جميع القياسات إلى وحدات مترية",
 "metric weight unit": "وحدة وزن, وحدة وزن مترية (وحدة وزن عشرية تعتمد على الغرام)",
 "metrical": "عَرُوضِيّ, مَوْزُون (يتعلّق بالتنظيم الإيقاعي للمقاطع اللفظية) / متري (قائم على المتر كمعيار للقياس)\nمثال: النظام المتري",
 "metrical foot": "تفعيلة, وحدة مترية ((عروض) مجموعة من مقطعين أو 3 مقاطع تشكل الوحدة الأساسية للإيقاع الشعري)",
 "metrical unit": "تفعيلة, وحدة مترية ((عروض) مجموعة من مقطعين أو 3 مقاطع تشكل الوحدة الأساسية للإيقاع الشعري)",
 "metrically": "عروضياً, وزنياً (فيما يتعلق بالوزن (الشعري))\nمثال: عروضياً، هذه القصائد متطابقة",
 "metrication": "تحويل للنظام المتري, مترية (عملية التغيير من الوحدات الإمبراطورية للقياس إلى الوحدات المترية: متر، جرام، ثانية)",
 "metrics": "علم العروض (دراسة الوزن الشعري وفن النظم)",
 "metrification": "تحويل للنظام المتري, مترية (عملية التغيير من الوحدات الإمبراطورية للقياس إلى الوحدات المترية: متر، جرام، ثانية) / نظم, وزن شعري (كتابة مؤلف موزون (أو البنية الوزنية لمؤلف ما))",
 "metritis": "التهاب الرحم, التهاب بطانة الرحم (التهاب بطانة الرحم)",
 "metro": "قطار أنفاق, مترو (سكة حديد كهربائية تعمل تحت سطح الأرض (عادة في مدينة))\nمثال: في باريس يُطلق على نظام مترو الأنفاق اسم 'مترو' وفي لندن يُطلق عليه 'تيوب' أو 'أندر جراوند'",
 "metro cattolico": "متر عالمي, متر كاثوليكي (وحدة طول تعادل طول بندول الثواني الحر؛ تختلف عن المتر الحديث بنصف سنتيمتر)",
 "metrological": "قياسي, مترولوجي (مكون من أو متعلق بعلم القياس (المترولوجيا))",
 "metrology": "علم القياس, ميترولوجيا (الدراسة العلمية للقياس)",
 "metronidazole": "فلاجيل, ميترونيدازول (دواء مضاد للأوالي (الاسم التجاري فلاجيل) يستخدم لعلاج داء المشعرات وداء الجيارديا)",
 "metronome": "مِيتْرُونُوم, مِسْرَع",
 "metronome marking": "نَبْضَة فِي الدَّقِيقَة (إيقاع الموسيقى مقاساً بعدد الضربات التي تحدث في 60 ثانية)",
 "metronymic": "اسم الأم, نسبة للأم (اسم مشتق من اسم أمك أو سلف من جهة الأم)",
 "metropolis": "حَاضِرَة (خلاف البَادِيَة، وهي الأرض التي فيها عمران وزرع مثل المدن والقرى والضياع؛ المَدِينَة الكبيرة، العَاصِمَة أو المِصْر. أكثر الاستخدامات شيوعا)\nمثال: الصين حاضرة في إفريقيا.",
 "metropolitan": "مُطْرَان, مِطْرَان",
 "metropolitan france": "فَرَنْسَا الأُورُوبِّيَّة (أوروبية تقع في الجزء الجنوبي الغربي من قارة أوروبا. كانت تسمى بلاد الإِفْرَنْجَ أو الفَرَنْجَة)\nمثال: نساء فرنسا جميلات.",
 "metroptosis": "تدلي الرحم, هبوط الرحم (تدلي الرحم)",
 "metrorrhagia": "نزيف رحمي (نزيف من الرحم لا يعود إلى الحيض)",
 "metrosexual": "متروسكشوال, مهووس بالأناقة (رجل مغاير الجنس يهتم بشكل خاص بمظهره، ويكون مهندماً ويتابع الموضة)",
 "metroxylon sagu": "نخيل الساغو الحقيقي (نخيل ماليزي ينتج جذعه اللبي الساغو - وهو نشا يستخدم كمكثف للطعام ومقوي للأقمشة؛ من الملايو إلى فيجي)",
 "mettle": "معدن (فِي : مركب صُلْب، يتكون طبيعياً من خلال عمليات جيولوجية؛ فِي : ما يستخرج من باطن الأَرْض كالحَدِيد والرَّصَاص والذَّهَب والمُجَوْهَرَات)\nمثال: هذا السلم مصنوع من المعدن",
 "mettlesome": "جَرِيء, ذُو هِمَّة (مُسْتَعِدّ لِمُوَاجَهَة الخَطَر) / أَبِيّ, ذُو هِمَّة (ذو روح أبيّة وعزيمة لم تُكسَر)",
 "mettlesomeness": "حمية, شهامة (روح عالية شجاعة)",
 "metycaine": "بيبيروكائين (مركب يستخدم في شكل هيدروكلوريد كمخدر موضعي أو نخاعي)",
 "meuniere butter": "زبدة الليمون, زبدة مونيير (زبدة مصفاة تحمر ببطء وتتبل بعصير الليمون والبقدونس)",
 "mev": "ميغا إلكترون فولت (وحدة طاقة تساوي الشغل الذي يبذله إلكترون يتسارع عبر فرق جهد قدره مليون فولت)",
 "mevacor": "لوفاستاتين, ميفاكور (دواء فموي (الاسم التجاري ميفاكور) لتقليل مستويات الكوليسترول في الدم؛ يستخدم عندما تثبت التغييرات الغذائية عدم كفايتها)",
 "mew": "نورس شائع (النورس الشائع في أوراسيا وشمال شرق أمريكا الشمالية) / مواء (الصوت الذي تصدره القطة (أو أي صوت يشبه هذا))",
 "mew gull": "نورس شائع (النورس الشائع في أوراسيا وشمال شرق أمريكا الشمالية)",
 "mews": "إسطبلات محولة, زقاق الإسطبلات (شارع تصطف على جانبيه مباني كانت في الأصل إسطبلات خاصة ولكن تم تحويلها إلى مساكن)\nمثال: تعيش في إسطبلات تشيلسي",
 "mexican": "مَكْسِيكِيّ, مَكْسِيكِيَّة",
 "mexican beaded lizard": "سحلية خرزية (سحلية ذات حراشف تشبه الخرز الأسود والمصفر؛ من غرب المكسيك)",
 "mexican bean beetle": "خنفساء الفاصوليا المكسيكية (أدخلت إلى الولايات المتحدة من المكسيك؛ تتغذى على أوراق نبات الفاصوليا)",
 "mexican black cherry": "كرز مكسيكي أسود (كرز مكسيكي أسود)",
 "mexican cypress": "سرو برتغالي, سرو مكسيكي (شجرة دائمة الخضرة طويلة منتشرة توجد في المكسيك ولها فروع متدلية؛ يعتقد أنها أدخلت إلى البرتغال من غوا)",
 "mexican fire plant": "فربيون كأسي, نار على الجبل (بنت القنصل في الولايات المتحدة وشرق المكسيك؛ غالباً ما يتم الخلط بينها وبين الفربيون متباين الأوراق)",
 "mexican flameleaf": "بنت القنصل, زهرة الميلاد (نبات أمريكي استوائي ذو حليب سام وأوراق مبهرجة مستدقة عادة ما تكون قرمزية تشبه البتلات تحيط بزهور صفراء صغيرة)",
 "mexican freetail bat": "خفاش ذيل حر, خفاش ذيل حر مكسيكي (الخفاش ذو الذيل الحر الشائع في جنوب الولايات المتحدة ذو فرو مخملي قصير؛ يهاجر جنوباً في الشتاء)",
 "mexican green": "أكابولكو غولد, المكسيكي الأخضر (نوع قوي بشكل خاص من الماريجوانا)",
 "mexican hairless": "كلب مكسيكي أصلع (أي من سلالة قديمة من الكلاب الصغيرة شبه الخالية من الشعر في المكسيك)",
 "mexican hat": "قبعة مكسيكية (زهرة الصنوبرية برأس زهرة يشبه القبعة المكسيكية بقرص أحمر بني طويل وأشعة متدلية صفراء أو صفراء وحمراء بنية؛ تنمو في السهول الكبرى على طول قاعدة جبال…)",
 "mexican husk tomato": "توماتيلو, طماطم مكسيكية (فاكهة صغيرة صالحة للأكل صفراء إلى أرجوانية تشبه الطماطم محاطة بقشرة تشبه المثانة) / توماتيلو, طماطم قشرية مكسيكية (نبات حولي من المكسيك وجنوب الولايات المتحدة له ثمار لزجة أرجوانية صالحة للأكل تشبه الطماطم الصغيرة)",
 "mexican hyssop": "زوفا مكسيكية (نبات معمر منتصب من المكسيك له زهور وردية إلى قرمزية)",
 "mexican jumping bean": "فاصوليا قافزة (بذرة شجيرات مكسيكية تحتوي على يرقة عثة تسبب حركاتها اهتزاز الفاصوليا أو تدحرجها)",
 "mexican juniper": "عرعر متدلي, عرعر مكسيكي (شجرة صغيرة في غرب تكساس وجبال المكسيك ذات فروع منتشرة مع غصينات متدلية)",
 "mexican mint": "قصعين الكهان, ميرمية الكهان (عشب من أواكساكا له تأثير مهلوس قوي؛ المكون النشط هو سالفينورين)",
 "mexican monetary unit": "وحدة نقدية مكسيكية (الوحدة النقدية في المكسيك)",
 "mexican nut pine": "صنوبر الجوز المكسيكي, صنوبر بينيون (بينيون صغير ثنائي أو ثلاثي الإبر من المكسيك وجنوب تكساس)",
 "mexican onyx": "ألباستر, مرمر (نوع صلب مدمج من الكالسيت)",
 "mexican peso": "بيزو, بيزو مكسيكي (وحدة المال الأساسية في المكسيك؛ تساوي 100 سنتافو)",
 "mexican pocket mouse": "فأر جيبي مكسيكي (فأر جيبي كبير يعيش في المكسيك)",
 "mexican poppy": "أرجيمون, خشخاش مكسيكي (عشبة حولية ذات سيقان شائكة وأزهار صفراء كبيرة؛ من جنوب الولايات المتحدة إلى جزر الهند الغربية والمكسيك)",
 "mexican spanish": "الإسبانية المكسيكية (اللهجة الإسبانية التي يتم التحدث بها في المكسيك)",
 "mexican standoff": "طريق مسدود, مواجهة متعادلة (وضع لا يمكن لأحد أن يخرج منه كفائز واضح)",
 "mexican sunflower": "تيثونيا, دوار الشمس المكسيكي (أي نبات من جنس تيثونيا؛ أعشاب طويلة خشنة أو شجيرات من المكسيك إلى بنما لها رؤوس زهور كبيرة تشبه دوار الشمس بزهيرات قرصية صفراء وأشعة صفراء ذهبية إلى…)",
 "mexican swamp cypress": "سرو مونتيزوما (شجرة سرو في وديان الأنهار في المرتفعات المكسيكية) / سرو مونتيزوما (خشب السرو في وديان الأنهار بالمرتفعات المكسيكية)",
 "mexican tea": "دودة البذور الأمريكية, شاي مكسيكي (عشبة الخنازير الاستوائية الأمريكية كريهة الرائحة) / إبرة الراعي الريشية, بلوط القدس (رجل الوزة الأوراسي العطري ذو الأوراق الشبيهة بالبلوط والعديد من الزهور الصفراء الخضراء؛ متوطن في أمريكا الشمالية)",
 "mexican tulip poppy": "خشخاش التوليب المكسيكي, كأس ذهبي (موطنه المرتفعات المكسيكية يزرع لزهوره الصفراء الصافية اللامعة وأوراقه الزرقاء الرمادية المقسمة بدقة)",
 "mexican valium": "دواء النسيان, روفي (أسماء دارجة للفلونيترازيبام)",
 "mexican-american": "أمريكي مكسيكي (مكسيكي (أو شخص من أصل مكسيكي) يعيش في الولايات المتحدة)",
 "mexicano": "أمريكي مكسيكي (مكسيكي (أو شخص من أصل مكسيكي) يعيش في الولايات المتحدة)",
 "mexico": "الْمَكْسِيك, الميكسيك (دولة في الشطر الجنوبي من قارة أمريكا الشمالية؛ اسمها الرسمي الولايات المتحدة المكسيكية، وعاصمتها مدينة مكسيكو)\nمثال: قامت ثورة في المكسيك.",
 "mexico city": "مَكْسِيكُو, مَدِينَة مَكْسِيكُو",
 "mexiletine": "ميكسيتيل, ميكسيليتين (دواء مضاد لاضطراب النظم (الاسم التجاري ميكسيتيل) يستخدم لعلاج عدم الانتظام البطيني)",
 "mexitil": "ميكسيتيل, ميكسيليتين (دواء مضاد لاضطراب النظم (الاسم التجاري ميكسيتيل) يستخدم لعلاج عدم الانتظام البطيني)",
 "mezcal": "بيوت, مسكال (صبار صغير عديم الأشواك كروي الشكل؛ مصدر لأزرار المسكال)",
 "meze": "مَزَّة (مَزة (بفتح الميم) مجموعة من الأكلات الصغيرة مشهورة في شرق البحر المتوسط، عادة تؤكل مع المشروبات الكحولية؛ مُزة (بضم الميم) تستخدم في اللهجة المصرية للإشارة للمرأة الجميلة)",
 "mezereon": "مَازَرْيُون",
