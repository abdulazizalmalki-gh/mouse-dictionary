 "middleweight": "وزن متوسط (ملاكم محترف يتراوح وزنه بين 155 و 160 رطلاً) / وزن متوسط (مصارع يزن 172-192 رطلاً) / وزن متوسط (ملاكم هاوٍ لا يزيد وزنه عن 165 رطلاً (حوالي 75 كجم))",
 "middlewoman": "مؤدية الوسط (مؤدية أنثى في وسط صف المنشدين تشارك الآخرين في الحديث) / وسيطة (شخص أنثى في وضع يسمح لها بتقديم مساعدة خاصة لك) / وسيطة تجارية (امرأة تشتري كميات كبيرة من البضائع وتعيد بيعها للتجار بدلاً من العملاء النهائيين)",
 "middling": "إلى حد ما, باعتدال (إلى حد أو درجة معينة) / عَادِيّ, مُتَوَسِّط (يفتقر لجودة أو قدرة استثنائية) / سلع متوسطة الجودة (أي سلعة ذات جودة أو حجم متوسط)\nمثال: كبير جداً",
 "middy": "بلوزة بحار (بلوزة بياقة بحار)",
 "middy blouse": "بلوزة بحار (بلوزة بياقة بحار)",
 "midfield": "خط الوسط, وسط الملعب ((رياضة) الجزء الأوسط من ملعب اللعب (كما في كرة القدم))",
 "midgard": "ميدغارد ((الأساطير الإسكندنافية) مسكن البشر في الأساطير الإسكندنافية)",
 "midge": "هاموش (ذبابة دقيقة ذات جناحين تشبه البعوض تفتقر إلى أجزاء الفم القارضة؛ تظهر في أسراب راقصة خاصة بالقرب من الماء)",
 "midget": "قَزَم",
 "midgrass": "عشب متوسط (أي من أعشاب مختلفة متوسطة الارتفاع كانت تغطي البراري غير المضطربة في الولايات المتحدة؛ تشمل معظم أعشاب العلف في المنطقة المعتدلة)",
 "midi": "متوسط الطول, ميدي (يستخدم لملابس النساء ذات حاشية عند منتصف الساق) / الْوَاجِهَة الرَّقْمِيَّة لِلْآلَات الْمُوسِيقِيَّة, مِيدِي (بروتوكول قياسي للتواصل بين الآلات الموسيقية الإلكترونية وأجهزة الكمبيوتر)\nمثال: تنانير متوسطة الطول",
 "midian": "مَـدْيَـن",
 "midinette": "بائعة باريسية (بائعة باريسية)",
 "midiron": "حديد اثنين, مضرب حديدي متوسط (مضرب حديدي طويل بوجه عمودي تقريباً)",
 "midland": "جَوْفِيّ, دَاخِلِيّ (من وسط المنطقة أو البلاد أو قادم منه) / منطقة وسطى, وسط البلاد (الجزء الداخلي من بلد ما)",
 "midline": "المستوى الناصف, خط الوسط (المستوى المتوسط للجسم (أو جزء منه))",
 "midmost": "فِي المُنْتَصَف تَمَامًا (الجزء أو النقطة الوسطى أو المركزية) / فِي أَقْصَى الوَسَط (يقع في المنتصف تمامًا)\nمثال: في وسط الغابة",
 "midnight": "مُنْتَصَف لَيْل, مُنْتَصَف اللَّيْل / مُنْتَصَف اَللَّيْل",
 "midnight sun": "شمس منتصف الليل (الشمس المرئية عند منتصف الليل (داخل الدوائر القطبية الشمالية أو الجنوبية))",
 "midplane": "المستوى الناصف, خط الوسط (المستوى المتوسط للجسم (أو جزء منه))",
 "midpoint": "مركز, منتصف (نقطة متساوية البعد عن نهايات خط أو أطراف شكل ما)",
 "midrash": "مدراش",
 "midrib": "عرق وسطي (العرق الموجود في وسط الورقة)",
 "midriff": "حجاب حاجز ((في التشريح) فاصل عضلي يفصل بين التجويف البطني والصدر؛ يساهم في التنفس) / خصر, وسط (المنطقة الوسطى من الجذع البشري (عادة في الأمام))\nمثال: تعتقد الشابات الأمريكيات أن كشف الوسط موضة",
 "midsection": "خصر, وسط (المنطقة الوسطى من الجذع البشري (عادة في الأمام))\nمثال: تعتقد الشابات الأمريكيات أن كشف الوسط موضة",
 "midshipman": "طالب بحري (رتبة مؤقتة للذكور يحملها ضباط البحرية الشباب أثناء التدريب)",
 "midships": "في منتصف السفينة (في أو بالقرب أو باتجاه وسط السفينة)\nمثال: في أواخر القرن التاسع عشر، وضعت المحركات في الأمام، وفي منتصف السفينة، وفي الخلف",
 "midshipwoman": "طالبة بحرية (رتبة مؤقتة للإناث تحملها ضابطات البحرية الشابات أثناء التدريب)",
 "midspread": "المدى الربيعي, نصف المدى الربيعي (مقياس للتشتت الإحصائي، يساوي الفرق بين الربيع الأعلى والربيع الأدنى)\nمثال: من مجموعة البيانات أعلاه لدينا مدى ربيعي قدره 3.5، ومدى قدره 9 - 2 = 7 وانحراف معياري قدره 2.34",
 "midst": "فِي مُنْتَصَف, وَسْطَ (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "midstream": "منتصف النهر, وسط المجرى (الجزء الأوسط من مجرى النهر)",
 "midsummer": "قيظ",
 "midsummer day": "24 يونيو, يوم منتصف الصيف (يوم ربع سنوي في إنجلترا وويلز وأيرلندا)",
 "midsummer eve": "23 يونيو, ليلة منتصف الصيف (الليلة التي تسبق يوم منتصف الصيف)",
 "midsummer night": "23 يونيو, ليلة منتصف الصيف (الليلة التي تسبق يوم منتصف الصيف)",
 "midsummer's day": "24 يونيو, يوم منتصف الصيف (يوم ربع سنوي في إنجلترا وويلز وأيرلندا)",
 "midsummer-men": "جذر الورد, سدم وردي (نبات جبلي أوراسي بأوراق لحمية ذات أطراف وردية وعنقود من الزهور الصفراء)",
 "midterm": "امتحان نصفي (امتحان يجرى في منتصف الفصل الدراسي) / منتصف الفصل, منتصف المدة (منتصف الفصل الدراسي أو فترة سياسية في المنصب) / منتصف الحمل (منتصف فترة الحمل)",
 "midterm exam": "امتحان نصفي (امتحان يجرى في منتصف الفصل الدراسي)",
 "midterm examination": "امتحان نصفي (امتحان يجرى في منتصف الفصل الدراسي)",
 "midvein": "عرق وسطي (العرق الموجود في وسط الورقة)",
 "midwatch": "النوبة الليلية, نوبة آخر الليل (نوبة حراسة أثناء الليل (كما من منتصف الليل إلى 8 صباحاً))",
 "midway": "فِي مُنْتَصَف الطَّرِيق (في نصف المسافة؛ في المنتصف) / مُنْتَصَف, وَسَط (على مسافة متساوية من الأطراف) / منطقة الألعاب (المكان في معرض أو كرنفال حيث توجد العروض الجانبية ووسائل الترفيه المماثلة)\nمثال: كان في منتصف السلم عندما سقط",
 "midweek": "في منتصف الأسبوع (في وسط الأسبوع) / منتصف الأسبوع (وسط الأسبوع) / الأربعاء, يوم الأربعاء (اليوم الرابع من الأسبوع)",
 "midweekly": "فِي مُنْتَصَفِ الْأُسْبُوعِ (يحدث في منتصف الأسبوع)",
 "midwestern": "وَسَطِيٌّ غَرْبِيّ (من منطقة في الولايات المتحدة تشمل عموماً أوهايو وإنديانا وإلينوي وآيوا وميزوري)",
 "midwife": "قَابِلَة, دَايَة",
 "midwife toad": "علجوم قابلة (علجوم أوروبي يحمل ذكره البيض المخصب ملفوفاً حول أرجله الخلفية حتى يفقس) / علجوم قابلة إيبيري (مشابه في العادة لعلجوم القابلة)",
 "midwifery": "قَبَالَة",
 "midwinter": "عز الشتاء, منتصف الشتاء (وسط فصل الشتاء)",
 "mie": "مِيِه",
 "mien": "سلوك, هيئة (أسلوب أو سلوك وقور)",
 "mierkat": "ميركات (حيوان زبادي يشبه النمس من جنوب أفريقيا له وجه يشبه الليمور وأربعة أصابع فقط)",
 "mifepristone": "حبوب الإجهاض, ميفيبريستون",
 "miff": "حنق, غضبة (حالة من التهيج أو الانزعاج)",
 "miffed": "مُتَضَايِق, مُنْزَعِج (أُثير فيه نفاد الصبر أو الغضب)",
 "might": "قُوَّة (ضد الضُعْف، الشِدَّة والقُدْرَة الجِسْمَانِيَّة؛ ضد الضُعْف، المَقْدِرَة والحَوْل والتَمَكُّن، القدرة المعنوية)\nمثال: توم شعر بالقوة.",
 "might-have-been": "احتمال لم يتحقق, فرصة ضائعة (حدث كان من الممكن أن يقع لكنه لم يحدث قط)",
 "mightily": "بشدة, جداً ((لهجة إقليمية جنوبية) جداً؛ إلى درجة كبيرة) / بشدة, بقوة (بقوة أو بنشاط)\nمثال: الطفل لطيف جداً",
 "mightiness": "اقتدار, بأس (قوة بدنية)",
 "mighty": "قَوِيّ, قَادِر (اسم من أسماء الله الحسنى؛ الشَدِيْد ذو الحَوْل)\nمثال: كانت صدمة قوية.",
 "mignonette": "خزامى, ريزيدا عطرة (نبات حولي خشبي متوسطي يزرع على نطاق واسع لعناقيده الطرفية الكثيفة التي تشبه السنابل من الزهور البيضاء المخضرة أو الصفراء ذات الرائحة الحارة القوية)",
 "migraine": "شَقِيقَة, صُدَاع نِصْفِي (مؤنث الشَقِيْق، وهو كل ما شُقَّ نصفين فكل من النصفين شقيق الآخر. الجمع شَقَائِق؛ مؤنث الشَقِيْق، وهو الأَخ من نفس الأُمّ والأبّ)\nمثال: هي أختي غير الشقيقة.",
 "migrant": "مُهَاجِر, مُهَاجِرَة",
 "migrant shrike": "صرد مهاجر (صرد من وسط أمريكا الشمالية؛ يشتي في تكساس ووادي المسيسيبي الجنوبي)",
 "migrant worker": "عامل مهاجر, متشرد (عامل يتنقل ويعمل مؤقتاً في أماكن مختلفة)",
 "migration": "هِجْرَة (ترك الأرض والخروج منها إلى أخرى؛ في الشرع: ترك الوطن الذي بين الكفار والانتقال إلى دار الإسلام قربة لله)\nمثال: الهجرة النبوية.",
 "migration route": "مسار الهجرة (الطريق الجغرافي الذي تهاجر الطيور على طوله عادة)",
 "migrational": "هجري (متعلق بالهجرة)",
 "migrator": "حيوان مهاجر (حيوان (خاصة الطيور والأسماك) يسافر بين بيئات مختلفة في أوقات معينة من السنة) / مغترب, مهاجر (مسافر ينتقل من منطقة أو بلد إلى آخر)",
 "migratory": "مُتَنَقِّل, مُهَاجِر (يتنقّل من مكان لآخر بشكل معتاد بحثًا عن العمل) / مهاجر (يُستخدم للحيوانات التي تنتقل موسمياً)\nمثال: طيور مهاجرة",
 "migratory grasshopper": "جندب مهاجر (آفة خطيرة في مناطق زراعة الحبوب والمراعي في وسط وغرب الولايات المتحدة)",
 "migratory locust": "جراد مهاجر (جراد من العالم القديم يسافر في أسراب ضخمة يجرد مساحات واسعة من الغطاء النباتي)",
 "migratory quail": "سمان مهاجر (السمان النموذجي للعالم القديم)",
 "mihaffa": "مِحَفَّة",
 "mihrab": "محراب ((الإسلام) تجويف في جدار المسجد يشير إلى اتجاه مكة) / تصميم المحراب ((الإسلام) تصميم على شكل محراب في سجادة الصلاة؛ يجب أن يشير المحراب أثناء العبادة نحو مكة المكرمة)",
 "mikado": "تينو, ميكادو (إمبراطور اليابان؛ عندما يُعتبر زعيمًا دينيًا يسمى تينو)",
 "mikagura": "ميكاغورا (نوع من رقص الكاغورا الشنتوي الطقسي الرسمي)\nمثال: تم أداء الميكاغورا أيضاً في مهرجان الحصاد الإمبراطوري وفي الأضرحة الكبرى مثل إيسي وكامو",
 "mikania scandens": "قنب متسلق, ميكانيا متسلقة (عشب من أمريكا الاستوائية له أزهار برائحة الفانيليا؛ يتسلق الأشجار)",
 "mike": "مايك",
 "mikmaq": "ميكماك (فرد من شعب ألغونكي يسكن المقاطعات البحرية في كندا)",
 "mikvah": "حمام تطهير يهودي, ميكفاه ((عبرية) حمام تطهير وتنظيف طقوسي يقوم به اليهود الأرثوذكس في مناسبات معينة (قبل السبت أو بعد الحيض))",
 "mil": "ميل (وحدة زاوية تستخدم في المدفعية؛ تساوي 1/6400 من الدورة الكاملة) / سنتيمتر مكعب, مليلتر (وحدة مترية للحجم تساوي واحداً من الألف من اللتر) / ميل (وحدة للطول تساوي واحداً من الألف من البوصة؛ تستخدم لتحديد السماكة (مثل الأوراق أو الأسلاك)) / ميل سويدي (وحدة طول سويدية تعادل 10 كم)",
 "mila": "ميلة",
 "milady": "سيدتي, ميلادي (امرأة نبيلة إنجليزية)",
 "milage": "مَسَافَة بِالمِيل (المسافة المقاسة بالأميال)",
 "milan": "مِيلَانُو",
 "milanese": "ميلاني (من أو يتعلق بميلانو أو شعبها أو يميزهم) / ميلاني (مواطن أو ساكن في ميلانو)",
 "milankovitch cycle": "ْدَوْرَاتُ مِيلَانْكُوفِيتْش",
 "milch": "حلوب (تدر الحليب؛ تُربى أو مناسبة أساساً لإنتاج الحليب)\nمثال: ماعز حلوب",
 "milch cow": "أبقار حلوب, ماشية الحليب (الماشية التي تُربى من أجل حليبها)",
 "milcher": "أبقار حلوب, ماشية الحليب (الماشية التي تُربى من أجل حليبها)",
 "mild": "مُعْتَدِل (الأمر الوسط بين الطَرَفْيَن، نقيض المُتَطَرِّف)\nمثال: الجو معتدل هنا.",
 "mild silver protein": "أرغيرول, بروتين الفضة الخفيف (مطهر يتكون من مركب من البروتين والفضة (الاسم التجاري أرغيرول))",
 "mild steel": "صلب طري, فولاذ لين (فولاذ يحتوي على أقل من 0.15% كربون)",
 "mild-mannered": "لَيِّنُ المُعَامَلَة, هَادِئُ الطَّبْع (يَتَصَرَّفُ بِلُطْفٍ وَرِفْقٍ فِي سُلُوكِه)",
 "mild-tasting": "خَفِيفُ المَذَاق (ذُو طَعْمٍ لَطِيفٍ وَمُعْتَدِل)",
 "mildew": "تَعَفُّن, عُفُونَة",
 "mildly": "باعتدال, بدرجة خفيفة (إلى درجة معتدلة) / برفق, بلطف (بطريقة لطيفة)\nمثال: كان مهتماً بشكل طفيف",
 "mildness": "تَسَاهُل, رَأْفَة (الرحمة كنتيجة لكون الشخص ليناً أو متسامحاً) / رقة, لطف (التصرف بأسلوب رقيق ولطيف ومتزن) / اعتدال (طقس جيد مع درجات حرارة مريحة)\nمثال: تعلمت أصابعه الرقة",
 "mile": "عُقْدَة",
 "mileage": "مَسَافَة بِالمِيل (المسافة المقاسة بالأميال) / بدل الأميال, تعويض المسافة (بدل سفر بمعدل معين لكل ميل مقطوع) / اِسْتِهْلَاك الوَقُود (نسبة عدد الأميال المقطوعة إلى عدد جالونات البنزين المحروقة)",
 "mileikowsky": "مِيلَيْكَوْسْكِي, مِيلَيْكُوسْكِي",
 "mileometer": "عداد المسافات (عداد يظهر المسافة المقطوعة بالميل)",
 "milepost": "حجر الميل, معلم المسافة (عمود حجري بجانب الطريق لإظهار المسافات)",
 "miler": "عداء الميل (عداء في سباق الميل الواحد) / ميل ((تستخدم في التراكيب فقط) طول شيء ما بالأميال)\nمثال: كان السباق لمسافة 30 ميلاً",
 "miles gloriosus": "الجندي المتباهي (جندي متباهٍ (شخصية نمطية في الكوميديا))",
 "miles per gallon": "ميل لكل غالون (المسافة المقطوعة في مركبة تعمل بمحرك باستخدام غالون واحد من البنزين أو الديزل)",
 "miles per hour": "مِيل فِي السَّاعَة (نسبة المسافة المقطوعة (بالأميال) إلى الوقت المستغرق في السفر (بالساعات)) / ميل في الساعة (قراءة عداد السرعة لمعدل السفر اللحظي)",
 "milestone": "حجر الميل, معلم المسافة (عمود حجري بجانب الطريق لإظهار المسافات) / إنجاز مرحلي, حدث بارز (حدث مهم في حياتك (أو في مشروع))",
 "milfoil": "ألفية, حزنبل (عشبة أوراسية قوية الرائحة منتشرة تشكل حصيرة في الأراضي البور أو السياج أو المراعي ذات أوراق مسننة ضيقة وزهيرات صغيرة بيضاء عادة؛ متوطنة على نطاق واسع…)",
 "milford haven": "ميلفورد هافن",
 "miliaria": "حمو النيل, طفح حراري (انسداد القنوات العرقية أثناء الحرارة العالية والرطوبة)",
 "miliary fever": "مرض التعرق (وباء انتشر في القرنين الخامس عشر والسادس عشر وتميز بالتعرق الغزير والوفيات المرتفعة)",
