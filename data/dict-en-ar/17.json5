 "mezuza": "مزوزا (نصوص دينية من سفر التثنية مكتوبة على رق وملفوفة في علبة مثبتة على إطار الباب في العديد من المنازل اليهودية)",
 "mezuzah": "مِزُوزَة",
 "mezzanine": "طابق مسروق, ميزانين (طابق متوسط يقع فوق الطابق الأرضي مباشرة) / الشرفة الأولى, ميزانين المسرح (الشرفة الأولى أو الأدنى في المسرح)",
 "mezzanine floor": "طابق مسروق, ميزانين (طابق متوسط يقع فوق الطابق الأرضي مباشرة)",
 "mezzo": "ميزو سوبرانو (الصوت الغنائي النسائي بين الكونترالتو والسوبرانو) / ميزو سوبرانو (سوبرانو بصوت يقع بين السوبرانو والكونترالتو)",
 "mezzo-relievo": "نقش بارز متوسط (نحت بارز بين النقش المنخفض والنقش العالي)",
 "mezzo-rilievo": "نقش بارز متوسط (نحت بارز بين النقش المنخفض والنقش العالي)",
 "mezzo-soprano": "ميزو سوبرانو (الصوت الغنائي النسائي بين الكونترالتو والسوبرانو) / ميزو سوبرانو (سوبرانو بصوت يقع بين السوبرانو والكونترالتو)",
 "mezzotint": "حفر غائر, ميزوتنت (مطبوعة منتجة بواسطة نقش تم كشطه لتمثيل الضوء أو الظل)",
