 "mental": "عَقْلِيّ",
 "mental ability": "أهلية, سعة (القدرة على التعلم أو الاحتفاظ بالمعرفة؛ وفي القانون، القدرة على فهم الحقائق وأهمية سلوكك)",
 "mental abnormality": "شذوذ عقلي (أي شذوذ في الوظيفة العقلية)",
 "mental age": "عمر عقلي (مستوى التطور الفكري كما يقاس باختبار الذكاء)",
 "mental anguish": "عذاب نفسي, كرب عقلي (ألم عاطفي مستمر ومضجر)",
 "mental attitude": "اتجاه ذهني, موقف (حالة ذهنية معقدة تشمل المعتقدات والمشاعر والقيم والميول للتصرف بطرق معينة)\nمثال: كان لديه موقف بأن العمل ممتع",
 "mental balance": "توازن عقلي, سلامة عقلية (الحالة النفسية السليمة لشخص يتمتع بحكم جيد)",
 "mental block": "انحباس, حصر ذهني (عدم القدرة على تذكر أو التفكير في شيء يمكنك فعله عادة؛ غالباً ما يحدث بسبب التوتر العاطفي)\nمثال: كنت أعرف اسمه تماماً ولكن أصابني انحباس مؤقت",
 "mental calculation": "حساب ذهني (بمعنى عَدَّ وجَمَعَ وطَرَحَ كلها معا. جمعه حُسْبَان؛ الاسم من المُحَاسَبَة، لأن فيه تُحسب المحاسن والأخطاء)\nمثال: الحساب لو سمحت.",
 "mental capacity": "ذكاء, عقل (القدرة العقلية)\nمثال: لديه الكثير من الذكاء ولكنه يفتقر للحس السليم",
 "mental case": "عُصابِيّ, مَرِيض نَفْسِيّ (شخص يعاني من العصاب)",
 "mental condition": "حالة عقلية, حالة نفسية ((علم النفس) حالة عقلية تكون فيها صفات الحالة ثابتة نسبيًا على الرغم من أن الحالة نفسها قد تكون ديناميكية)\nمثال: الإجهاد ليس الحالة العاطفية أو العقلية الوحيدة التي يمكن أن تستفيد من التأمل المنتظم",
 "mental confusion": "ارتباك, تشوش (حالة عقلية تتميز بنقص في وضوح الفكر والسلوك ونظامهما)\nمثال: تشوش في الانطباعات",
 "mental defectiveness": "قصور عقلي (تأخر كافٍ للخروج عن النطاق الطبيعي للذكاء)",
 "mental deficiency": "بله, قصور ذهني بسيط (تخلف عقلي بسيط)",
 "mental dexterity": "براعة عقلية, خفة ذهن (الذكاء كما يكشف عنه سرعة وتيقظ العقل)\nمثال: خفة الذهن والخيال",
 "mental disease": "اعتلال نفسي, مرض عقلي (أي مرض يصيب العقل؛ الحالة النفسية لشخص يعاني من مشاكل عاطفية أو سلوكية خطيرة بما يكفي لتطلب تدخل الطب النفسي)",
 "mental disorder": "اضطراب نفسي",
 "mental disturbance": "اضطراب عقلي, اضطراب نفسي ((الطب النفسي) اضطراب نفسي في التفكير أو العاطفة؛ مصطلح أكثر حيادية من المرض العقلي)",
 "mental energy": "طاقة عقلية, طاقة نفسية (قوة أو عامل محرك في النفس)",
 "mental exhaustion": "إجهاد ذهني, إرهاق عقلي (إرهاق يؤثر على حدة الذهن)",
 "mental faculty": "قدرة عقلية, ملكة (واحدة من القوى المعرفية أو الإدراكية المتأصلة في العقل)",
 "mental health": "صِحَّة نَفْسِيَّة (سَلَامَة؛ سَلَامَة الْجِسْم)\nمثال: أشك في صحة ذلك.",
 "mental home": "مستشفى الأمراض العقلية, مصح نفسي (مستشفى للأشخاص غير المتزنين عقلياً)",
 "mental hospital": "مُسْتَشْفَى الأَمْرَاض النَفْسِيَّة (اسم مفعول من الفعل \"اسْتَشْفَى\")\nمثال: أعمل في مستشفى.",
 "mental hygiene": "الصحة النفسية, علاج نفسي (فرع الطب النفسي المعني بالطرق النفسية)",
 "mental illness": "مرض نفسي (أصابه مرضٌ أو علّة أو سَقَم)\nمثال: هذا المرض قلبي.",
 "mental image": "صورة, صورة ذهنية (تمثيل عقلي أيقوني (يشبه الصورة المرئية))\nمثال: فرض خيالها عليها صوراً مروعة جداً لا يمكن تأملها",
 "mental imagery": "تخيل, خيال (القدرة على تكوين صور ذهنية للأشياء أو الأحداث)\nمثال: كان لا يزال يسمعها في خياله",
 "mental institution": "مستشفى الأمراض العقلية, مصح نفسي (مستشفى للأشخاص غير المتزنين عقلياً)",
 "mental lexicon": "معجم ذهني, مفردات (معرفة مستخدم اللغة بالكلمات)",
 "mental measurement": "قياس عقلي (مصطلح عام يستخدم لتغطية أي تطبيق لتقنيات القياس لتقدير الوظائف العقلية كميًا)",
 "mental note": "ملاحظة ذهنية (انتباه خاص بقصد التذكر)\nمثال: سجل ملاحظة ذهنية لإرسال الزهور لها",
 "mental object": "مُحْتَوَى ذِهْنِيّ, مُحْتَوَى مَعْرِفِيّ (مجموع أو نطاق ما أُدرِك أو اكتُشِف أو تُعُلِّم)",
 "mental picture": "انطباع, صورة ذهنية (صورة ذهنية واضحة ومعبرة)\nمثال: وصف صورته الذهنية عن مهاجمه",
 "mental process": "عملية, عملية ذهنية ((علم النفس) أداء نشاط معرفي مركب؛ عملية تؤثر في المحتويات العقلية)\nمثال: عملية التفكير",
 "mental quickness": "سرعة بديهة, سرعة ذهنية (الذكاء كما يكشف عنه القدرة على تقديم إجابات صحيحة دون تأخير)",
 "mental rejection": "ارتياب, شك (الشك في حقيقة شيء ما)",
 "mental representation": "تصور داخلي, تمثيل (عرض للأمور في العقل على شكل فكرة أو صورة)",
 "mental reservation": "تحفظ, تحفظ ذهني (شك غير معلن يمنعك من قبول شيء ما بقلب خالص)",
 "mental retardation": "تأخر, تخلف عقلي (نقص في التطور الطبيعي للقدرات الفكرية)",
 "mental soundness": "توازن عقلي, سلامة عقلية (الحالة النفسية السليمة لشخص يتمتع بحكم جيد)",
 "mental state": "حالة عقلية, حالة نفسية ((علم النفس) حالة عقلية تكون فيها صفات الحالة ثابتة نسبيًا على الرغم من أن الحالة نفسها قد تكون ديناميكية)\nمثال: الإجهاد ليس الحالة العاطفية أو العقلية الوحيدة التي يمكن أن تستفيد من التأمل المنتظم",
 "mental strain": "إجهاد, إجهاد ذهني ((علم النفس) عصبية ناتجة عن الضغط النفسي)\nمثال: كانت مسؤولياته تشكل ضغطاً مستمراً",
 "mental synthesis": "بناء عقلي, تركيب ذهني (خلق بناء عقلي؛ عملية الجمع بين الأفكار في موضوع فكري متوافق)",
 "mental telepathist": "قارئ الأفكار, متخاطر (شخص لديه القدرة على توصيل الأفكار مباشرة)",
 "mental test": "اختبار, اختبار عقلي (أي إجراء موحد لقياس الحساسية أو الذاكرة أو الذكاء أو الكفاءة أو الشخصية وما إلى ذلك)\nمثال: تم توحيد الاختبار على عينة كبيرة من الطلاب",
 "mental testing": "اختبار, اختبار عقلي (أي إجراء موحد لقياس الحساسية أو الذاكرة أو الذكاء أو الكفاءة أو الشخصية وما إلى ذلك)\nمثال: تم توحيد الاختبار على عينة كبيرة من الطلاب",
 "mental unsoundness": "اضطراب عقلي, خلل عقلي (حالة من الاضطراب والتوهان العقلي)",
 "mentalism": "ذهنية ((فلسفة) مذهب يرى أن العقل هو الواقع الحقيقي وأن الأشياء توجد فقط كجوانب من وعي العقل)",
 "mentality": "عَقْلِيَّة",
 "mentally": "ذِهْنِيًّا, عَقْلِيًّا (فيما يتعلق بالعقل أو التفكير)\nمثال: لقد عانى ذهنياً",
 "mentally ill": "مَجْنُون, مَخْبُول",
 "mentally retarded": "مُتَخَلِّف",
 "mentation": "تفكير, فكر (عملية استخدام عقلك للنظر في شيء ما بعناية)\nمثال: التفكير دائماً ما يجعله يعبس",
 "mentee": "مُتَدَرِّب, مُتَلَقِّي التَّوْجِيه (شخص يتلقى التوجيه والإرشاد من مرشد)\nمثال: قد يدعم المرشد الطلابي ما يصل إلى سبعة متدربين",
 "mentha aquatica": "نعناع مائي (نعناع أوروبي يزدهر في الأماكن الرطبة؛ له عطر يشبه عطر برتقال البرغموت؛ تم توطينه في شرق أمريكا الشمالية)",
 "mentha arvensis": "نعناع الحقل (نعناع أوروبي تم توطينه في الولايات المتحدة)",
 "mentha citrata": "نعناع البرغموت, نعناع ليموني (نعناع بأوراق لها عطر يشبه عطر برتقال البرغموت)",
 "mentha longifolia": "حبق الحصان, نعناع طويل الأوراق (نعناع مائي بري خشن من العالم القديم له أوراق طويلة وعناقيد من الزهور تشبه السنابل؛ تم توطينه في شرق الولايات المتحدة)",
 "mentha piperita": "نعناع فلفلي (عشب بأوراق زغبية وزهور صغيرة أرجوانية أو بيضاء ينتج زيتاً نفاذاً يستخدم كنكهة)",
 "mentha pulegium": "فوتنج, نعناع أوروبي (نعناع معمر أوراسي له زهور ليلكية زرقاء صغيرة وأوراق بيضاوية؛ ينتج زيتاً عطرياً)",
 "mentha rotundifolia": "نعناع تفاحي (نعناع بسيقان برائحة التفاح من جنوب وغرب أوروبا؛ تم توطينه في الولايات المتحدة)",
 "mentha spicata": "نعناع سنبلي, نعناع مدبب (عشب حديقة شائع له عناقيد من الزهور الأرجوانية الصغيرة وينتج زيتاً يستخدم كنكهة)",
 "mentha suaveolens": "نعناع تفاحي (نعناع بسيقان برائحة التفاح من جنوب وغرب أوروبا؛ تم توطينه في الولايات المتحدة)",
 "menthol": "منثول (غسول يحتوي على المنثول مما يعطيه رائحة النعناع) / منثول (مركب بلوري له طعم ورائحة النعناع الباردة ويوجد بشكل طبيعي في زيت النعناع الفلفلي؛ يستخدم كمنكه وفي الطب لتخفيف الحكة والألم واحتقان الأنف)",
 "mentholated": "بالمنثول, ممنثل (يحتوي على أو مشبع بالمنثول)\nمثال: شراب سعال بالمنثول",
 "mentholated salve": "مرهم منثول (مرهم يحتوي على المنثول)",
 "menticirrhus americanus": "بياض الملك (سمكة بياض في الساحل الجنوبي الشرقي لأمريكا الشمالية)",
 "menticirrhus littoralis": "بياض فضي (سمكة بياض فضية باهتة في جنوب المحيط الأطلسي وسواحل الخليج في الولايات المتحدة)",
 "menticirrhus saxatilis": "بياض شمالي (سمكة بياض في الساحل الشرقي للولايات المتحدة؛ تشبه إلى حد كبير بياض الملك)",
 "menticirrhus undulatus": "كوربينا (سمكة بياض زرقاء رمادية في ساحل كاليفورنيا)",
 "mention": "ذِكْر (ذَكَرَ الشيءَ: نطق به أو أشار إليه بالكلام؛ ذَكَرَ شخصًا: استحضره في الذاكرة) / ذَكَرَ (ذَكَرَ الشيءَ: نطق به أو أشار إليه بالكلام؛ ذَكَرَ شخصًا: استحضره في الذاكرة)\nمثال: قتله ذكر زرافة.",
 "mentioner": "ذاكر (متحدث يشير إلى شيء باختصار أو عرضًا)",
 "mentor": "مرشد, موجه (مرشد ومستشار حكيم وموثوق به)",
 "mentoree": "مُتَدَرِّب, مُتَلَقِّي التَّوْجِيه (شخص يتلقى التوجيه والإرشاد من مرشد)\nمثال: قد يدعم المرشد الطلابي ما يصل إلى سبعة متدربين",
 "mentum": "ذقن (نتوء أسفل فم بعض الرخويات يشبه الذقن) / ذقن (الجزء البارز من الفك السفلي) / ذقن (نتوء يشبه الذقن يتكون من السبلات وقاعدة العمود في بعض بساتين الفاكهة)",
 "mentzelia laevicaulis": "نجمة ساطعة (نبات ثنائي الحول من جنوب غرب الولايات المتحدة له سيقان بيضاء وأوراق مسننة يُزرع لزهوره الصفراء الشاحبة الكبيرة التي تتفتح في الصباح الباكر)",
 "mentzelia lindleyi": "بارتونيا (نبات حولي يُزرع خاصة لزهوره الذهبية الليلية العطرة)",
 "mentzelia livicaulis": "نجمة ساطعة (نبات ثنائي الحول من جنوب غرب الولايات المتحدة له سيقان بيضاء وأوراق مسننة يُزرع لزهوره الصفراء الشاحبة الكبيرة التي تتفتح في الصباح الباكر)",
 "menu": "قَائِمَة, قَائِمَةُ الطَّعَام / قَائِمَة",
 "menyanthes trifoliata": "إطريفل الماء, فاصوليا المستنقعات (نبات معمر في أوروبا وأمريكا له عناقيد من الزهور البيضاء أو الأرجوانية وأوراق ثلاثية شديدة المرارة؛ غالباً ما يتجذر عند حافة الماء وينتشر عبر السطح)",
 "menziesia ferruginea": "أزاليا كاذبة, توت الأحمق (شجيرة متناثرة من شمال غرب أمريكا الشمالية ذات أوراق بمسحة مزرقة وخيمات من الزهور الصغيرة على شكل جرس)",
 "menziesia pilosa": "شجيرة ميني (شجيرة منخفضة من شرق الولايات المتحدة ذات أغصان زغبية)",
 "meow": "مُوَاء (صَوْت القِطّ) / مَاءَ, تَمَوَّأَ (السائل الشفاف المعروف الذي تنشأ به الحياة، عديم اللون والرائحة والطعم عندما يكون نقيا؛ علميا فِي : جزيئة متكونة من ذرتي هيدروجين مرتبطين بذرة واحدة من الأوكسيجين)\nمثال: أنا أشرب الماء.",
 "meowing": "مُوَاء (صَوْت القِطّ)",
 "mepacrine": "أتابرين, كويناكرين (دواء (الاسم التجاري أتابرين) يستخدم لعلاج بعض الإصابات بالديدان وكان يستخدم سابقاً لعلاج الملاريا)",
 "meperidine": "ديميرول, ميبيريدين (عقار مخدر صناعي (الاسم التجاري ديميرول) يستخدم لعلاج الألم)",
 "meperidine hydrochloride": "ديميرول, ميبيريدين (عقار مخدر صناعي (الاسم التجاري ديميرول) يستخدم لعلاج الألم)",
 "mephaquine": "لاريام, مفلوكوين (دواء مضاد للملاريا (الأسماء التجارية لاريام وغيرها) فعال في الحالات التي لا تستجيب للكلوروكين؛ يقال إنه ينتج آثاراً عصبية نفسية ضارة على بعض الناس)",
 "mephenytoin": "ميسانتوين, ميفينيتوين (دواء سام مضاد للاختلاج (الاسم التجاري ميسانتوين) يستخدم في علاج الصرع عندما تكون مضادات الاختلاج الأقل سمية غير فعالة)",
 "mephistophelean": "إِبْلِيسِيّ, مَاكِر (يُظهر الدهاء أو الخبث أو الشر المميز للشيطان)",
 "mephistopheles": "مِفِسْتُوفِيلِيس",
 "mephistophelian": "إِبْلِيسِيّ, مَاكِر (يُظهر الدهاء أو الخبث أو الشر المميز للشيطان)",
 "mephitic": "سَامُّ الرَّائِحَة, وَبَائِيُّ الرَّائِحَة (ذُو رَائِحَةٍ ضَارَّةٍ نَاتِجَةٍ عَنِ التَّلَوُّثِ الجَوِّيِّ)",
 "mephitis": "رائحة كريهة, نتانة (رائحة مميزة كريهة ومزعجة) / غاز كريه الرائحة, نتن (غاز سام أو كريه الرائحة ينبعث من الأرض)",
 "mephitis macroura": "ظربان مقلنس (من المكسيك والأجزاء الجنوبية القصوى من جنوب غرب الولايات المتحدة)",
 "mephitis mephitis": "ظربان مخطط (أكثر أنواع الظربان شيوعاً وانتشاراً في أمريكا الشمالية)",
 "mephobarbital": "ميبارال, ميفوباربيتال (باربيتورات طويل المفعول (الاسم التجاري ميبارال) يستخدم كمهدئ وكمضاد للاختلاج في علاج الصرع)",
 "meprin": "إكوانيل, ميبروبامات (مهدئ ومهدئ للأعصاب (الأسماء التجارية ميلتاون وإكوانيل وميبرين) يستخدم لعلاج توتر العضلات والقلق)",
 "meprobamate": "إكوانيل, ميبروبامات (مهدئ ومهدئ للأعصاب (الأسماء التجارية ميلتاون وإكوانيل وميبرين) يستخدم لعلاج توتر العضلات والقلق)",
 "meq": "ملي مكافئ (جزء من ألف من المكافئ)",
 "meralgia": "ألم الفخذ (ألم في الفخذ)",
 "merbromine": "ميربرومين, ميركوروكروم (مركب زئبقي يطبق موضعياً كمطهر؛ ميركوروكروم هي العلامة التجارية)",
 "mercalli scale": "مقياس ميركالي (مقياس كان يستخدم سابقاً لوصف شدة الزلزال)",
 "mercantile": "تِجَارِيّ, مِهْنِيّ (متعلق بالتجارة أو التجار أو يتسم بسماتهم) / تِجَارِيّ, رِبْحِيّ (موجّه نحو الربح) / تجاري (من أو يتعلق بالنظام الاقتصادي التجاري)\nمثال: نظريات تجارية",
 "mercantile agency": "وكالة تجارية (منظمة تزود الشركات بتصنيفات ائتمانية لشركات أخرى)\nمثال: دان آند برادستريت هي أكبر وكالة تجارية في الولايات المتحدة",
 "mercantile establishment": "متجر, محل تجاري (مكان عمل لبيع البضائع بالتجزئة)",
 "mercantile law": "قانون تجاري (مجموعة القواعد المطبقة على المعاملات التجارية؛ مستمدة من ممارسات التجار بدلاً من الفقه القانوني)",
 "mercantile system": "مذهب تجاري, مركنتيلية (نظام اقتصادي (أوروبا في القرن الثامن عشر) لزيادة ثروة الأمة عن طريق التنظيم الحكومي لجميع المصالح التجارية للأمة)",
 "mercantilism": "تجارة, تجارية (المعاملات (البيع والشراء) التي تهدف إلى توفير السلع (البضائع والخدمات)) / مذهب تجاري, مركنتيلية (نظام اقتصادي (أوروبا في القرن الثامن عشر) لزيادة ثروة الأمة عن طريق التنظيم الحكومي لجميع المصالح التجارية للأمة)",
 "mercaptopurine": "بيورينثول, مركابتوبورين (دواء (الاسم التجاري بيورينثول) يتداخل مع استقلاب البيورين ويستخدم لعلاج سرطان الدم الليمفاوي الحاد)",
 "mercator projection": "إسقاط مركاتور (إسقاط خرائطي للأرض على أسطوانة؛ تظهر المناطق أكبر كلما ابتعدت عن خط الاستواء)",
 "mercator's projection": "إسقاط مركاتور (إسقاط خرائطي للأرض على أسطوانة؛ تظهر المناطق أكبر كلما ابتعدت عن خط الاستواء)",
 "mercenaria mercenaria": "كواهوج (محار أمريكي صالح للأكل؛ استخدمت أصدافه الثقيلة كنقود من قبل بعض الهنود الأمريكيين)",
 "mercenariness": "تكسب, مادية (حالة الدافعية القائمة على الكسب الشخصي المادي)\nمثال: لا أهتم بإخبارك عن مراوغته، ونفعيته، ولؤمه، وتطفله",
 "mercenary": "مُرْتَزِق, مُؤْجِر",
 "mercer": "تاجر حرير, تاجر منسوجات (تاجر في المنسوجات (خاصة الحرير))",
 "mercerised": "معالج بالصودا, ممرسر (من خيط القطن الذي تمت معالجته بهيدروكسيد الصوديوم لتقليصه وزيادة بريقه وتقبله للصبغة)\nمثال: قطن ممرسر",
 "mercerized": "معالج بالصودا, ممرسر (من خيط القطن الذي تمت معالجته بهيدروكسيد الصوديوم لتقليصه وزيادة بريقه وتقبله للصبغة)\nمثال: قطن ممرسر",
 "merchandise": "بِضَاعَة / بَضَائِع / سِلْعَة / سِلَع ((سَلَعَ) رأْسَهُ يَسْلَعُ سَلْعًا: شجَّهُ؛ (سَلَعَ) الطَّريقَ: شَقَّهُ) / مَتَاع\nمثال: الناس ليسوا سلعة.",
 "merchandiser": "بائع تجزئة, تاجر (رجل أعمال يعمل في تجارة التجزئة)",
 "merchandising": "إعلان, دعاية (العمل التجاري لجذب انتباه الجمهور إلى السلع والخدمات) / بيع, متاجرة (تبادل البضائع مقابل مبلغ متفق عليه من المال) / منتجات ترويجية (منتجات تحمل علامة تجارية تهدف للترويج لمنتج آخر، وخاصة الأفلام والفرق الموسيقية)",
 "merchant": "تَاجِر, تَاجِرَة",
 "merchant bank": "بنك تجاري, بنك مكتسب (بنك يعالج بطاقات الائتمان؛ حيث يتلقى التجار ائتمانًا لإيصالات بطاقات الائتمان مخصومًا منها رسوم المعالجة)",
 "merchant marine": "شحن بحري, ملاحة تجارية (خدمات النقل التي توفرها السفن التابعة لبلد أو صناعة معينة) / البحرية التجارية (طاقم سفينة تجارية)",
 "merchant ship": "باخرة شحن, سفينة تجارية (سفينة شحن)\nمثال: قاموا بالكثير من تجارتهم الخارجية في سفن أجنبية",
 "merchant vessels": "شحن بحري, ملاحة تجارية (خدمات النقل التي توفرها السفن التابعة لبلد أو صناعة معينة)",
 "merchant-venturer": "تاجر مغامر (تاجر يقوم بمشروع تجاري (خاصة المشاريع التي ترسل البضائع عبر البحار))",
 "merchantability": "صلاحية العرض للبيع, قابلية للتسويق (حالة كونه مناسباً للسوق؛ جاهزاً للشراء أو البيع)",
 "merchantable": "تِجَارِيّ, قَابِلٌ لِلبَيْع (صالح للعرض في السوق والبيع)",
 "merchantman": "باخرة شحن, سفينة تجارية (سفينة شحن)\nمثال: قاموا بالكثير من تجارتهم الخارجية في سفن أجنبية",
 "merciful": "رَحِيم (الرَاحِم كثير الرحمة؛ الرَحِيم اسم من الأسماء الحسنى)\nمثال: بسم الله الرحمن الرحيم.",
 "mercifully": "برحمة (بطريقة رحيمة)\nمثال: عامل اللص برحمة",
 "mercifulness": "رأفة, رحمة (التساهل والرحمة التي يظهرها تجاه المخالفين شخص أو وكالة مكلفة بإقامة العدل) / رَأْفَة, رَحْمَة (الميل ليكون لطيفاً ومتسامحاً) / رحمة (الشعور الذي يحفز الشفقة)",
 "merciless": "عديم الرحمة, قاسٍ (ليس لديه أو لا يظهر أي رحمة)\nمثال: العدو عديم الرحمة",
 "mercilessly": "بقسوة بالغة, بلا رحمة (بدون شفقة؛ بطريقة لا ترحم)\nمثال: تعرض لهزيمة نكراء بلا رحمة من قبل خصمه في المجلس",
 "mercilessness": "عَدَم رَحْمَة, قَسْوَة (اللاإنسانية التي يدل عليها عدم الرغبة في أن يكون لطيفاً أو متسامحاً) / قسوة, وحشية (مشاعر انعدام الرحمة الشديدة)",
 "mercurial": "حَامِي الطَّبْع, مِزَاجِيّ",
 "mercurial ointment": "مرهم زئبقي (مرهم يحتوي على الزئبق)",
 "mercurialis annua": "زئبق العشب, ميركوريالس حولي (نبات حولي أورو-أفريقي مستوطن في أمريكا كعشب ضار؛ كان يجفف سابقاً للاستخدام كمسهل أو مدر للبول أو مضاد للزهري)",
 "mercurialis perennis": "زئبق الكلب, ميركوريالس معمر (نبات أوروبي معمر ضار بأزهار مخضرة)",
 "mercuric": "زئبقوزي, زئبقي (مكون من أو متعلق بـ أو يحتوي على الزئبق)",
 "mercuric chloride": "المتسامي الآكل, كلوريد الزئبق (مادة بلورية بيضاء سامة قابلة للذوبان (ناتجة عن تسامي الزئبق)؛ تستخدم كمبيد للآفات أو مطهر أو مادة حافظة للخشب)",
 "mercurochrome": "ميربرومين, ميركوروكروم (مركب زئبقي يطبق موضعياً كمطهر؛ ميركوروكروم هي العلامة التجارية)",
 "mercurous": "زئبقوزي, زئبقي (مكون من أو متعلق بـ أو يحتوي على الزئبق)",
 "mercurous chloride": "كالوميل, كلوريد الزئبقوز (مسحوق عديم اللون والطعم يستخدم طبياً كمسهل)",
 "mercury": "زِئْبَق, زَاؤُوق / حُلْبُوب",
 "mercury barometer": "بارومتر زئبقي (بارومتر يظهر الضغط بارتفاع عمود من الزئبق)",
 "mercury cell": "خلية زئبقية (خلية أولية تتكون من أنود الزنك وكاثود من أكسيد الزئبق وإلكتروليت من هيدروكسيد البوتاسيوم)",
 "mercury chloride": "المتسامي الآكل, كلوريد الزئبق (مادة بلورية بيضاء سامة قابلة للذوبان (ناتجة عن تسامي الزئبق)؛ تستخدم كمبيد للآفات أو مطهر أو مادة حافظة للخشب)",
 "mercury fulminate": "فلمينات الزئبق (فلمينات تنفجر بعنف عندما تكون جافة إذا ضُربت أو سُخنت؛ تستخدم في الصواعق وأغطية التفجير)",
 "mercury poisoning": "تسمم بالزئبق (حالة تسمم ناتجة عن تناول أو استنشاق الزئبق؛ التسمم الحاد بالزئبق يسبب طعماً معدنياً وقيئاً وإسهالاً ومشاكل في الكلى قد تؤدي إلى الوفاة)",
 "mercury thermometer": "مقياس حرارة زئبقي (مقياس حرارة يتكون من زئبق موجود في بصلة في أسفل أنبوب شعري زجاجي مدرج ومختوم ومميز بدرجات مئوية أو فهرنهايت؛ يتمدد الزئبق مع ارتفاع درجة الحرارة مما…)",
 "mercury-contaminated": "مُلَوَّث بِالزِّئْبَق (تلوّث بمادّة الزئبق)",
 "mercury-in-glass clinical thermometer": "مقياس حرارة طبي, ميزان حرارة طبي (ميزان حرارة زئبقي مصمم لقياس درجة حرارة جسم الإنسان؛ مدرج لتغطية نطاق بضع درجات على جانبي درجة حرارة الجسم الطبيعية)",
 "mercury-in-glass thermometer": "مقياس حرارة زئبقي (مقياس حرارة يتكون من زئبق موجود في بصلة في أسفل أنبوب شعري زجاجي مدرج ومختوم ومميز بدرجات مئوية أو فهرنهايت؛ يتمدد الزئبق مع ارتفاع درجة الحرارة مما…)",
 "mercury-vapor lamp": "مصباح بخار الزئبق (مصباح فوق بنفسجي يبعث ضوءاً مزرقاً قوياً (غني بالأشعة فوق البنفسجية) عند مرور تيار كهربائي عبر بخار الزئبق)",
 "mercy": "رَحْمَة, رَأْفَة / رَحْمَة, شَفَقَة",
 "mercy kill": "قَتَلَ قَتْلاً رَحِيماً (تسبب عمداً في الموت غير المؤلم لشخص أو حيوان)",
 "mercy killing": "قتل رحيم (فعل قتل شخص ما دون ألم (خاصة من يعاني من مرض عضال))",
 "mercy seat": "غطاء التابوت, كرسي الرحمة (الغطاء الذهبي لتابوت العهد) / عرش الرحمة, كرسي الرحمة (عرش الله (في السياق الديني))",
 "mere": "بحيرة صغيرة, بركة (بركة صغيرة من المياه الراكدة)",
 "merely": "بِالْكَاد",
 "merestone": "حجر الحدود (مصطلح قديم لمعلم أرضي يتكون من كومة من الحجارة يعلوها لوح قائم)",
 "meretricious": "بَرَّاق, خَدَّاع (قَائِم عَلَى التَّظَاهُر؛ خَادِع المَظْهَر) / صَارِخ, مُبَهْرَج (بَرَّاقٌ وَلَافِتٌ بِطَرِيقَةٍ تَفْتَقِرُ إِلَى الذَّوْق) / بغايا, عهري (يشبه أو يتعلق ببغي (عاهرة))\nمثال: علاقات عهرية",
 "meretriciously": "بابتذال, ببهرجة كاذبة (بطريقة مبهرجة ومبتذلة)\nمثال: القارب مزين ببهرجة كاذبة",
 "meretriciousness": "بَهْرَجَة, زَخْرَفَة صَارِخَة (الاستعراض المبتذل عديم الذوق) / بريق خادع, خداع المظهر (مظهر الحقيقة الذي يكون زائفًا أو مخادعًا؛ المعقولية الظاهرية)\nمثال: زيف حجته",
 "merganser": "بلقشة (بط غواص كبير آكل للأسماك ذو عرف ومنقار نحيل معقوف بحواف مسننة)",
 "merge": "دَمَجَ (دمج الأشياء: جمعها وخلطها معًا؛ دمجهُ:جعله جزءًا من شيء أكبر منه)\nمثال: دمج فكرتين في فكرة.",
 "merged": "مُتَكَامِل, مُدْمَج (تشكّل أو اتحد في كلّ واحد متكامل)",
 "merger": "اِنْدِمَاج",
 "merger agreement": "اتفاقية استحواذ, اتفاقية اندماج (عقد يحكم اندماج شركتين أو أكثر)",
 "merging": "اتحاد, التقاء (عملية الانضمام معاً ككيان واحد) / التقاء, تلاق (التدفق معاً في مجرى واحد)\nمثال: حدث اندماج المجموعتين بسرعة",
 "mergus albellus": "بلقشة بيضاء (أصغر أنواع البلقشة وأكثرها مهارة في الغوص؛ توجد في شمال أوراسيا)",
 "mergus merganser": "بلقشة شائعة (البلقشة الشائعة في أوروبا وأمريكا الشمالية)",
 "mergus merganser americanus": "بلقشة أمريكية (بط غواص شائع في أمريكا الشمالية يعتبر صنفاً من البلقشة الشائعة الأوروبية)",
 "mergus serrator": "بلقشة حمراء الصدر (بلقشة واسعة الانتشار في أمريكا وأوروبا)",
 "mericarp": "ثمرة جزئية, فصلية (كربلة ذات بذرة واحدة؛ تنفصل كواحد من زوج عند النضج)",
 "meridian": "خَطّ الطُّول (كِتَابَة؛ ما يَصِل نقطتين أو أكثر)\nمثال: إرسم خط مستقيم.",
 "meridional": "مِيرِيدْيُونَالِيّ (يقع في الجنوب أو يتسم بخصائص سكان الجنوب وأماكنه) / خطي طولي, زوالي (مكون من أو متعلق بخط الزوال (خط الطول))",
 "meringue": "مَرَنْغ",
 "meringue kiss": "قُبَل الميرانغ (حلوى مصنوعة من السكر وبياض البيض ومخبوزة ببطء)",
 "merino": "ميرينو (خروف أبيض أصله من إسبانيا وينتج صوفاً كثيفاً بجودة استثنائية)",
 "merino sheep": "ميرينو (خروف أبيض أصله من إسبانيا وينتج صوفاً كثيفاً بجودة استثنائية)",
 "meriones longifrons": "جرذ الرمل (يربوع من جنوب أوروبا)",
 "meriones unguiculatus": "عضل منغولي (يربوع شائع كحيوان أليف)",
 "meristem": "ميرستيم, نسيج إنشائي (نسيج غير متمايز تتكون منه خلايا جديدة، كما في طرف الساق أو الجذر)",
 "merit": "جَدَارَة",
 "merit badge": "شارة استحقاق (شارة تُمنح للكشافة تقديراً لمشاريع خاصة)",
 "merit pay": "أجر الجدارة, مكافأة التميز (أجر إضافي يُمنح للموظف على أساس الجدارة (خاصة لمعلمي المدارس))",
 "merit system": "نظام الجدارة (نظام توظيف وترقية الموظفين المدنيين على أساس القدرة والكفاءة)",
 "meritable": "جَدِيرٌ بِالتَّقْدِيرِ, ذُو اسْتِحْقَاقٍ (يَسْتَحِقُّ المُكَافَأَةَ أَوِ الإِطْرَاءَ)",
 "merited": "مجازى, مستحق (مستحق بشكل صحيح)\nمثال: نجاح مستحق",
 "meritless": "عَدِيمُ الجَدْوَى, لَا خَيْرَ فِيه (بِلَا اسْتِحْقَاق؛ ذُو قِيمَةٍ أَوْ فَائِدَةٍ ضَئِيلَةٍ أَوْ مُنْعَدِمَة)",
 "meritocracy": "حكم الجدارة, ميريتوقراطية (الاعتقاد بأن الحكام يجب أن يتم اختيارهم لقدراتهم المتفوقة وليس بسبب ثروتهم أو نسبهم) / حكم الجدارة, ميريتوقراطية (شكل من أشكال النظام الاجتماعي تذهب فيه السلطة لأولئك ذوي الفكر المتفوق)",
 "meritocratic": "استحقاقي, جداري (متعلق أو مميز لنظام الجدارة (الاستحقاق))\nمثال: مجتمع استحقاقي",
 "meritorious": "فَاضِل, جَدِير",
 "meritoriously": "باستحقاق, بجدارة (بطريقة جديرة بالتقدير)\nمثال: خدم بلاده بجدارة",
 "meritoriousness": "اسْتِحْقَاق, جَدَارَة (صفة كون الشخص مستحقاً (مثلاً، استحقاق المساعدة))",
 "merkel": "مِيرْكِل",
 "merl": "شحرور (سمنة أوروبية سوداء شائعة)",
 "merlangus merlangus": "بياض",
 "merle": "شحرور (سمنة أوروبية سوداء شائعة)",
 "merlin": "يؤيؤ",
 "merlon": "سن الشرفة, شرافة (قسم صلب بين فتحتين في شرفات القلعة المسننة)",
 "merlot": "ميرلو (نبيذ أحمر جاف مصنوع من عنب يزرع على نطاق واسع في بوردو وكاليفورنيا) / ميرلو (عنب نبيذ أسود أصله من منطقة بوردو)",
 "merluccius bilinearis": "نازلي فضي (يوجد قبالة ساحل المحيط الأطلسي لأمريكا الشمالية)",
 "mermaid": "خَيَلَان, اِبْنَة الْبَحْر",
 "merman": "غرانق الماء",
 "merobenthos": "قاعيات مؤقتة (قاعيات تتكون من كائنات في مراحل ما قبل البلوغ تصبح بالغة لاحقاً في العوالق)\nمثال: سلطت دراسات حديثة الضوء على دور القاعيات المؤقتة كأكياس لكائنات عوالق تقضي جزءاً من حياتها ساكنة في الرواسب",
 "meromelia": "انعدام جزء من الطرف (غياب خلقي لجزء من ذراع أو ساق)",
 "meronym": "اسم الجزء (كلمة تسمي جزءاً من كل أكبر)\nمثال: 'حافة' و 'تاج' هما اسما جزء لـ 'قبعة'",
 "meronymy": "عَلَاقَة الجُزْء بِالكُلّ (العلاقة الدلالية التي تربط بين الجزء والكل)",
 "merostomata": "فكيات الأرجل (تستخدم في بعض التصنيفات؛ تشمل رتب سيفيات الذيل وعقارب البحر)",
 "merovingian": "ميروفنجي (مكون من أو متعلق بالسلالة الميروفنجية أو أعضائها) / سلالة الميروفنجيون, ميروفنجيون (سلالة فرنجية أسسها كلوفيس الأول حكمت في بلاد الغال وألمانيا من حوالي 500 إلى 750) / ميروفنجي (عضو في السلالة الميروفنجية)",
 "merovingian dynasty": "سلالة الميروفنجيون, ميروفنجيون (سلالة فرنجية أسسها كلوفيس الأول حكمت في بلاد الغال وألمانيا من حوالي 500 إلى 750)",
 "merozoite": "قسيمة, ميروزويت (خلية تنشأ من الانقسام اللاجنسي لبوغي أم أثناء دورة حياته)",
 "merrily": "بابتهاج, بسعادة (بطريقة مبهجة)\nمثال: صاحوا بسعادة",
 "merriment": "متعة, مرح (أنشطة ممتعة أو مسلية) / حبور, مرح (شعور بالمرح)\nمثال: أفعل ذلك من أجل المتعة",
 "merriness": "دعابة, مرح (سمة المزاح المرح)",
 "merry": "مَرِح, فَرِح",
 "merry andrew": "بهلوان, مهرج (شخص يمتع الآخرين من خلال التصرفات السخيفة والمضحكة)",
 "merry bells": "أوفولاريا, عشبة الجرس (أي من نباتات مختلفة من جنس أوفولاريا لها زهور جرسية الشكل متدلية مصفرة)",
 "merry christmas": "عِيد مِيلَاد مَجِيد, مِيلَاد مَجِيد",
 "merry-go-round": "أرجوحة دوارة, دوامة الخيل (آلة دوارة كبيرة بها مقاعد لركوب الأطفال للتسلية) / دوامة, دورة مفرغة (دورة لا تنتهي من الأنشطة والأحداث (خاصة عندما تبدو قليلة الجدوى))\nمثال: إذا خسرنا الانتخابات، فإن دوامة التشريع بأكملها ستبدأ من جديد",
 "merrymaker": "مُحْتَفِل صَاخِب, مُعَرْبِد (محتفل يشارك في حفلة صاخبة)\nمثال: تجذب النوادي المحتفلين الصاخبين الذين لا تتجاوز أعمارهم الثالثة عشرة",
 "merrymaking": "ابتهاج, احتفال صاخب (احتفال صاخب؛ بهجة ومرح)",
 "mers": "إنفلونزا الإبل, فيروس كورونا المسبب لمتلازمة الشرق الأوسط التنفسية",
 "mersa matruh": "مَرْسَى مَطْرُوح",
 "mertensia virginica": "جريس فرجينيا, ميرتنسيا (عشب قائم أملس في شرق أمريكا الشمالية له أوراق كاملة وأزهار زرقاء مبهرجة تكون وردية في البرعم)",
 "merthiolate": "ثيميروسال, ميرثيولات (مسحوق بلوري فاتح اللون (الاسم التجاري ميرثيولات) يستخدم كمطهر جراحي)",
 "merv": "مَرْو",
 "meryta sinclairii": "بوكا (شجرة نيوزيلندية صغيرة مستديرة الرأس ذات أوراق راتنجية كبيرة وعناقيد من الزهور البيضاء المخضرة)",
 "mesa": "ميسا, هضبة منضدية (هضبة مسطحة ذات حواف شديدة الانحدار)\nمثال: كانت القبيلة آمنة نسبياً على الميسا لكن كان عليهم النزول إلى الوادي للحصول على الماء",
 "mesalliance": "زواج بمن هو أدنى مرتبة (الزواج بشخص ذي وضع اجتماعي أقل)",
 "mesantoin": "ميسانتوين, ميفينيتوين (دواء سام مضاد للاختلاج (الاسم التجاري ميسانتوين) يستخدم في علاج الصرع عندما تكون مضادات الاختلاج الأقل سمية غير فعالة)",
 "mesasamkranti": "ميسا سامكرانتي (عطلة شمسية هندوسية في بداية السنة الفلكية الجديدة عندما تدخل الشمس برج الحمل)",
 "mescal": "ميسكال (مشروب مكسيكي عديم اللون مقطر من العصائر المخمرة لنباتات صحراوية معينة من جنس الأغاف (خاصة نبات القرن)) / بيوت, مسكال (صبار صغير عديم الأشواك كروي الشكل؛ مصدر لأزرار المسكال)",
 "mescal bean": "صفيراء ثانوية الأزهار, فاصولياء المسكال (شجيرة أو شجرة صغيرة لها أوراق ريشية سامة للماشية وعناقيد كثيفة من الزهور الزرقاء شديدة العطر وفاصولياء حمراء)",
 "mescal button": "زر مسكال (القمة التي تشبه الزر لصبار المسكال؛ مصدر للسيلوسيبين)",
 "mescaline": "بيوت, ميسكالين (القلويد المهلوس الذي هو العامل النشط في أزرار الميسكال)",
 "mesembryanthemum crystallinum": "نبات الثلج, نبات الجليد (نبات سنوي من العالم القديم متوطن على نطاق واسع في المناطق الدافئة ذو زهور بيضاء وأوراق لحمية مغطاة بشعيرات تشبه الجليد)",
 "mesembryanthemum edule": "أصابع العروس, تين هوتنتوت (نبات عصاري منخفض النمو في جنوب أفريقيا له ثمرة كبسولية تحتوي على لب صالح للأكل)",
 "mesencephalon": "دماغ متوسط (الجزء الأوسط من الدماغ)",
 "mesenchyme": "لحمة متوسطة, نسيج متوسط (نسيج من أصل أديم متوسط يشكل النسيج الضام والدم والعضلات الملساء)",
 "mesenteric": "مساريقي (من أو يتعلق بالمساريق أو يقع فيها)",
 "mesenteric artery": "شريان مساريقي (واحد من فرعين للأبهر يمران بين طبقتي المساريق إلى الأمعاء)",
 "mesenteric plexus": "ضفيرة مساريقية (ضفيرة من الأعصاب الذاتية)",
 "mesenteric vein": "وريد مساريقي (رافد للوريد البابي يمر من الأمعاء بين طبقتي المساريق)",
 "mesentery": "مِسْرَاق",
 "mesh": "شَبَكَة",
 "mesh topology": "طوبولوجيا الشبكة المعشقة (طوبولوجيا شبكة تكون مكوناتها متصلة مباشرة بكل مكون آخر)",
 "meshed": "مُتَشَابِك, مُعَشَّق ((عن الأجزاء المسننة أو التروس) متشابك ومتفاعل) / مُتَشَابِكُ الخُيُوط (يشبه شبكة في بنيته)",
 "meshing": "تداخل, تشابك (فعل التشابك أو التداخل) / شبكة (قماش مفتوح من خيوط أو حبال أو أسلاك منسوجة معاً على فترات منتظمة) / اشتباك, تداخل (تلامس عن طريق التداخل أو التركيب معاً)\nمثال: تشابك أذرع الشرطة أبقى الحشد تحت السيطرة",
 "meshuga": "مَجْنُون, مَعْتُوه (فاقد العقل؛ أحمق بالكامل)",
 "meshugaas": "جنون ((اليديشية) جنون؛ سلوك أو نشاط لا معنى له)",
 "meshugga": "مَجْنُون, مَعْتُوه (فاقد العقل؛ أحمق بالكامل)",
 "meshugge": "مَجْنُون, مَعْتُوه (فاقد العقل؛ أحمق بالكامل)",
 "meshuggeneh": "مَجْنُون, مَعْتُوه (فاقد العقل؛ أحمق بالكامل) / مجنون ((اليديشية) أحمق مجنون)",
 "meshuggener": "مَجْنُون, مَعْتُوه (فاقد العقل؛ أحمق بالكامل) / مجنون ((اليديشية) أحمق مجنون)",
 "meshwork": "شبكة (قماش مفتوح من خيوط أو حبال أو أسلاك منسوجة معاً على فترات منتظمة)",
 "mesial": "إنسي, وسطي (كائن في أو موجه نحو خط الوسط أو المستوى الإنسي للجسم)",
 "mesic": "متوسط الرطوبة (يحتوي على أو يتميز بإمداد معتدل أو متوازن من الرطوبة) / ميزوني (من أو يخص الميزون)\nمثال: مواطن متوسطة الرطوبة",
 "mesmeric": "سَاحِر, مُنَوِّم (يجذب الانتباه ويأسره كأنّه تنويم مغناطيسيّ)",
 "mesmerised": "مَسْلُوبُ اللُّبّ, مَشْدُوه (ثابت الانتباه كأنّه تحت تأثير سحر)",
 "mesmerism": "تنويم إيحائي, تنويم مغناطيسي (فعل إحداث التنويم المغناطيسي)",
 "mesmerist": "منوم إيحائي, منوم مغناطيسي (شخص يحفز التنويم المغناطيسي)",
 "mesmerized": "مُنْبَهِر, مَفْتُون",
 "mesmerizer": "منوم إيحائي, منوم مغناطيسي (شخص يحفز التنويم المغناطيسي)",
 "mesmerizing": "سَاحِر, مُنَوِّم (يجذب الانتباه ويأسره كأنّه تنويم مغناطيسيّ)",
 "mesne lord": "سيد وسيط (سيد إقطاعي كان سيداً لمستأجريه على أرض مملوكة من سيد أعلى)",
 "meso-": "وَسْط / وَسْطِيّ",
 "mesoamerican": "أمريكي وسطي (متعلق بشعوب أمريكا الوسطى أو لغاتهم أو ثقافاتهم) / ميسوأمريكي (فرد من الشعوب المختلفة التي تسكن أمريكا الوسطى)",
 "mesoblast": "أديم متوسط, الأديم الأوسط (الطبقة المنتشة الوسطى التي تتطور لتشكل العضلات والعظام والغضاريف والدم والنسيج الضام)",
 "mesoblastic": "أديمي متوسط (متعلق بالأديم المتوسط أو مشتق منه)",
 "mesocarp": "الغِلاف المُتَوَسِّط, اللُّبّ (الطبقة الوسطى من غلاف الثمرة)",
 "mesocolon": "مساريقا القولون (مساريقا تثبت القولون السفلي بالجدار البطني الظهري)",
 "mesocricetus auratus": "هامستر ذهبي, هامستر سوري (هامستر صغير فاتح اللون يُربى غالباً كحيوان أليف)",
 "mesoderm": "أديم متوسط, الأديم الأوسط (الطبقة المنتشة الوسطى التي تتطور لتشكل العضلات والعظام والغضاريف والدم والنسيج الضام)",
 "mesodermal": "أديمي متوسط (متعلق بالأديم المتوسط أو مشتق منه)",
 "mesohippus": "ميزوهيبوس (حيوان ثلاثي الأصابع من أمريكا الشمالية عاش في العصر الأوليغوسيني؛ ربما ليس سلفاً مباشراً للخيول الحديثة)",
 "mesolithic": "حجري متوسط, ميزوليثي (من أو متعلق بفترة متوسطة من العصر الحجري (تلي العصر الحجري القديم))",
 "mesomorph": "عضلي البنية, ميزومورف (شخص ذو جسد عضلي متطور)",
 "mesomorphic": "عضلي البنية, متوسط البنية (له بنية جسمية عضلية قوية تتميز بغلبة الهياكل (العظام والعضلات والأنسجة الضامة) المتطورة من طبقة الأديم المتوسط الجنينية)",
 "mesomorphy": "بنية رياضية, عضلية البنية (عضلي وعريض العظام)",
 "meson": "مِيزُون (جسيم أولي مسؤول عن القوى في النواة الذرية؛ هادرون ذو عدد باريوني 0)",
 "mesonic": "ميزوني (من أو يخص الميزون)\nمثال: أنصاف أقطار المدارات الميزونية",
 "mesophyron": "مقطب (بروز أملس للعظم الجبهي بين الحاجبين وفوقهما؛ النقطة الأكثر بروزاً للأمام في الجبهة في خط الوسط عند مستوى الحواف فوق الحجاج)",
 "mesophyte": "نبات معتدل الرطوبة, نبات وسطي (نبات أرضي ينمو في بيئات ذات إمدادات مياه متوسطة؛ قارنه بالنبات الجفافي والنبات المائي)",
 "mesophytic": "مُتَوَسِّطُ الرُّطُوبَةِ نَبَاتِيًّا (يَنْمُو أَوْ يَتَكَيَّفُ فِي بِيئَةٍ مُعْتَدِلَةِ الرُّطُوبَةِ)",
 "mesophytic plant": "نبات معتدل الرطوبة, نبات وسطي (نبات أرضي ينمو في بيئات ذات إمدادات مياه متوسطة؛ قارنه بالنبات الجفافي والنبات المائي)",
 "mesopotamia": "بِلَادُ الرَّافِدَيْن, بَيْن النَّهْرَيْن",
 "mesosphere": "غلاف أوسط, ميزوسفير (طبقة الغلاف الجوي بين الستراتوسفير والثيرموسفير)",
 "mesothelioma": "ورم الظهارة المتوسطة (شكل من أشكال سرطانة الظهارة المتوسطة المبطنة للرئتين أو البطن أو القلب؛ يرتبط عادة بالتعرض لغبار الأسبستوس)",
 "mesothelium": "ظهارة متوسطة (ظهارة تنشأ في الأديم المتوسط الجنيني؛ تبطن تجويف الجسم البدائي)",
 "mesotron": "مِيزُون (جسيم أولي مسؤول عن القوى في النواة الذرية؛ هادرون ذو عدد باريوني 0)",
 "mesozoic": "متعلق بالدهر الوسيط, ميزوزوي (متعلق بالدهر الوسيط أو يشير إليه)",
 "mespilus germanica": "زعرور جرماني, ميدلار (شجرة أوراسية نفضية صغيرة تزرع لفاكهتها التي تشبه التفاح البري)",
 "mesquit": "غاف, مسكيت",
 "mesquite": "غاف, مسكيت",
 "mesquite gum": "صمغ المسكيت (صمغ يتم الحصول عليه من قرون المسكيت؛ يشبه الصمغ العربي)",
 "mess": "فَوْضَى, اِخْتِلَاط",
 "mess hall": "قاعة طعام عسكرية, ميس (غرفة طعام عسكرية (كبيرة) حيث يأكل أفراد الخدمة أو يسترخون)",
 "mess jacket": "سترة ضباط (سترة بطول الخصر تضيق لتشكل نقطة في الخلف؛ يرتديها الضباط في قاعة الطعام للعشاء الرسمي)",
 "mess kit": "طقم طعام (طقم يحتوي على طبق معدني وأدوات أكل؛ يستخدمه الجنود والمخيمون)",
 "mess of pottage": "ثمن بخس, شيء تافه (أي شيء ذو قيمة تافهة)\nمثال: باع عيسو حقه في البكورية ليعقوب بثمن بخس",
 "mess-up": "تخبط, فوضى (شيء تم إفساده أو خلطه بشكل سيء)",
 "message": "رِسَالَة, خَبَر",
 "message pad": "دفتر رسائل, دفتر ملاحظات (دفتر ورق يمكن كتابة الرسائل عليه)",
 "messaging": "مراسلة, مراسلة إلكترونية (إرسال ومعالجة البريد الإلكتروني بواسطة الكمبيوتر)",
 "messenger": "رَسُول, قَاصِد (شخص يحمل الرسائل، أو ينقل رسالة شفوية، أو يقوم برحلة قصيرة لتوصيل رسالة؛ (في الإسلام) من يبعثه الله تعالى بشَرْعٍ يعمل به ويبلغه)\nمثال: محمد رسول الله.",
 "messenger boy": "ساعي, فتى المراسلات (صبي يكسب المال عن طريق توصيل الرسائل وقضاء المهمات)",
 "messenger rna": "حمض نووي ريبوزي رسول (القالب لتخليق البروتين؛ شكل الحمض النووي الريبوزي الذي يحمل المعلومات من الحمض النووي في النواة إلى مواقع الريبوسوم لتخليق البروتين في الخلية)",
 "messiah": "مَسِيح",
 "messiahship": "منصب المسيح (منصب المسيح (المخلص))",
 "messianic": "مَسِيحَانِيّ",
 "messidor": "مِيسِيدُور",
 "messily": "بفوضوية, بقذارة (بطريقة فوضوية وغير مرتبة)\nمثال: بصق روس بتعمد شديد، وبقذارة شديدة، على بطاقة حزب دوريو",
 "messina": "مسينة",
 "messiness": "عدم ترتيب, فوضى (سمة كون المرء غير مرتب وفوضوي) / فوضى, كركبة (حالة من الارتباك وعدم النظام)\nمثال: كان المنزل في حالة فوضى",
 "messmate": "رفيق المائدة ((بحري) زميل تشاركه وجبات الطعام في نفس قاعة الطعام (كما في السفينة))",
 "messuage": "مسكن وملحقاته ((قانون) منزل سكني ومبانيه المجاورة والأرض المجاورة التي تستخدمها الأسرة)",
 "messy": "فَوْضَوِيّ, وَسِخ (قَذِرٌ وَغَيْرُ مُنَظَّم)",
 "mestiza": "مستيزة, هجينة (امرأة من أصل عرقي مختلط (خاصة من أصول أوروبية وأمريكية أصلية مختلطة))",
 "mestizo": "مُوَلَّد, مِسْتِيزُو (شخص من أصل عرقي مختلط (خاصة من أصل أوروبي وأمريكي أصلي مختلط))",
 "mestranol": "ميسترانول (شكل اصطناعي من الإستروجين يستخدم بالاشتراك مع البروجستين في حبوب منع الحمل)",
 "mesua ferrea": "خشب الحديد, كستناء الورد (شجرة دائمة الخضرة جميلة من شرق الهند تزرع غالباً كزينة لأزهارها البيضاء العطرة التي تنتج عطراً؛ مصدر لخشب صلب ثقيل جداً يستخدم لروابط السكك الحديدية)",
 "metabola": "كاملات التحول (حشرات تخضع لتحول كامل)",
 "metabolic": "اِسْتِقْلَابِيّ, أَيْضِيّ",
 "metabolic acidosis": "حماض استقلابي (حماض ناتج عن تراكم الأحماض أو فقدان القواعد من الجسم)",
 "metabolic alkalosis": "قلاء استقلابي (قلاء ناتج عن فقدان أيون الهيدروجين أو التناول المفرط للمواد القلوية)",
 "metabolic disorder": "اضطراب استقلابي, اضطراب الأيض (اضطراب أو خلل في التمثيل الغذائي)",
 "metabolic indican": "إنديكان استقلابي, إنديكان بولي",
 "metabolic process": "أيض, استقلاب (العمليات العضوية (في الخلية أو الكائن الحي) الضرورية للحياة)",
 "metabolic rate": "مُعَدَّل الأَيْض, مُعَدَّل التَّمْثِيل الغِذَائِيّ (معدل التمثيل الغذائي؛ كمية الطاقة المستهلكة في فترة معينة)",
 "metabolic syndrome": "مُتَلَازِمَة الأَيْض, المُتَلَازِمَة الاِسْتِقْلَابِيَّة",
 "metabolically": "أيضياً, استقلابياً (ينطوي على التمثيل الغذائي)\nمثال: مواد مهمة استقلابياً",
 "metabolism": "أَيْض ( تَحَوُّل غذائيّ في الخلايا، أو قوّة التجدُّد والبناء والهدم في الكائن الحيّ) / تَمْثِيل غِذَائِيّ / اِسْتِقْلَاب (يُشير مُعجم مُفردات كلمة \"قلَب\" إلى معانٍ متعددة تدور حول فكرة التغيير و التحويل، سواءً كان ذلك بتغيير مكان شيء ما (كإفراغ قدر أو عكس شيء)…؛ يُشير الفعل \"قلب\" إلى معانٍ تتراوح بين الحركة المادية لعكس اتجاه أو وضع شيء ما (كقلب كأس أو صفحة)…)",
 "metabolite": "مستقلب, ناتج أيضي (أي مادة تشارك في عملية التمثيل الغذائي (سواء كمنتج للأيض أو ضرورية له))",
 "metabolize": "أَيَّضَ ( تَحَوُّل غذائيّ في الخلايا، أو قوّة التجدُّد والبناء والهدم في الكائن الحيّ)",
 "metabolous": "استقلابي, متحول (يخضع للتحول (التطور))",
 "metacarpal": "مُشْط الْيَد (سرح الشعر باستخدام مشط؛ نظف أو مرر شيئًا باستخدام مشط أو أداة مشابهة)\nمثال: مشط شعرك قبل أن تخرج.",
 "metacarpal artery": "شريان سنعي (شرايين ظهرية وراحية لليد)",
 "metacarpal bone": "سنع, عظم المشط (أي عظم من عظام اليد يقع بين الرسغ والأصابع)",
 "metacarpal vein": "وريد سنعي (أوردة ظهرية وراحية لليد)",
 "metacarpophalangeal joint": "برجمة (مفصل الإصبع عندما تكون القبضة مغلقة)",
 "metacarpus": "مُشْط اَلْيَد (سرح الشعر باستخدام مشط؛ نظف أو مرر شيئًا باستخدام مشط أو أداة مشابهة)\nمثال: مشط شعرك قبل أن تخرج.",
 "metacenter": "مركز الثبات, ميطاسنتر ((بناء السفن) نقطة التقاطع بين خطين رأسيين، أحدهما يمر عبر مركز طفو هيكل السفينة في حالة توازن والآخر يمر عبر مركز طفو الهيكل عندما تميل السفينة إلى…)",
 "metacentre": "مركز الثبات, ميطاسنتر ((بناء السفن) نقطة التقاطع بين خطين رأسيين، أحدهما يمر عبر مركز طفو هيكل السفينة في حالة توازن والآخر يمر عبر مركز طفو الهيكل عندما تميل السفينة إلى…)",
 "metacentric": "وسطي المركز (لديه ذراعان متساويان بسبب الموقع المتوسط للسنترومير) / فوق مركزي (من أو متعلق بالمركز الأعلى (الميتاسنتر))\nمثال: كروموسوم وسطي المركز",
