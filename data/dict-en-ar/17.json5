 "medicine chest": "خزانة الأدوية, صيدلية منزلية (خزانة تحفظ فيها الأدوية ومستلزمات النظافة الشخصية)",
 "medicine man": "رجل الطب, طبيب ساحر (شامان من الهنود الحمر)",
 "medick": "فصة, نفل",
 "medico": "طبيب (ممارس طبي مرخص) / طالب طب (طالب في كلية الطب)\nمثال: شعرت بسوء شديد فذهبت لرؤية طبيبي",
 "medicolegal": "طبي قانوني (يخص الجوانب القانونية لممارسة الطب (مثل سوء الممارسة أو موافقة المريض على العمليات أو معلومات المريض))",
 "mediety": "شَطْر, نِصْف (واحد من جزأين متساويين (تقريباً))",
 "medieval": "قُرُوسَطِيّ, مُتَخَلِّف (كَأَنَّهُ يَنْتَمِي إِلَى القُرُونِ الوُسْطَى؛ عَتِيقُ الفِكْرِ وَغَيْرُ مُسْتَنِير) / فُرُوسِيّ, قُرُوسَطِيّ (مُمَيِّزٌ لِعَصْرِ الفُرُوسِيَّةِ وَالعُصُورِ الوُسْطَى) / قروسطي, من العصور الوسطى (يتعلق بالعصور الوسطى أو ينتمي إليها)\nمثال: علماء العصور الوسطى",
 "medieval greek": "اليونانية البيزنطية, اليونانية في العصور الوسطى (اللغة اليونانية من حوالي 600 إلى 1200 م)",
 "medieval greek language": "اليونانية البيزنطية, اليونانية في العصور الوسطى (اللغة اليونانية من حوالي 600 إلى 1200 م)",
 "medieval latin": "لاتينية العصور الوسطى (اللاتينية المستخدمة للأغراض الدينية خلال العصور الوسطى)",
 "medieval latin language": "لاتينية العصور الوسطى (اللاتينية المستخدمة للأغراض الدينية خلال العصور الوسطى)",
 "medieval mode": "مقام كنسي (أي من نظام المقامات المستخدمة في التراتيل الغريغورية حتى عام 1600؛ مشتق تاريخياً من المقام اليوناني)",
 "medieval schoolman": "عالم مدرسي, مدرسي (عالم في إحدى جامعات العصور الوسطى؛ ضليع في السكولاستية (المدرسية))",
 "medievality": "قروسطية (صفة الانتماء إلى العصور الوسطى أو الارتباط بها، ربما حوالي 500 إلى 1500 م)\nمثال: كما أن الاهتمام الأثري المتزايد بالحداثة جعل قضية القروسطية موضوعية، لأن التحديث يعني ضمناً مفهوماً معيناً لما قبل الحداثة",
 "medina": "الْمَدِينَة / الْمَدِينَةُ الْمُنَوَّرَة / مَدِينَة عَتِيقَة, مَدِينَة قَدِيمَة",
 "medinilla magnifica": "ميدينيلا رائعة (شجيرة نباتية (هوائية) استوائية دائمة الخضرة جميلة تزرع لأوراقها الغضة وعناقيدها الضخمة من الزهور الوردية؛ الفلبين)",
 "mediocre": "مُتَوَسِّط",
 "mediocrity": "تَوَسُّط, رَدَاءَة نِسْبِيَّة (العادية نتيجة لكون الشيء متوسطاً وغير متميز) / شَخْص مِنَ الدَّرَجَة الثَّانِيَة, مُتَوَسِّط الْمُسْتَوَى (شخص ذو قدرة أو قيمة من الدرجة الثانية)",
 "meditation": "تأمل, مضاربة فكرية (تأمل مستمر وعميق في موضوع أو سلسلة من الموضوعات ذات طبيعة عميقة أو غامضة) / تأمل روحي ((دين) التأمل في الأمور الروحية (عادة في مواضيع دينية أو فلسفية))\nمثال: عادة التأمل هي الأساس لكل معرفة حقيقية",
 "meditative": "تَأَمُّلِيّ, مُتَدَبِّر (مُسْتَغْرِقٌ فِي تَفْكِيرٍ عَمِيقٍ وَجِدِّيّ)",
 "meditatively": "بتأمل (بطريقة تأملية)\nمثال: بينما كان يدور ويدور بتأمل، كبقر يجتر، ترك عينيه تستقران على الماء المنبسط أمامه",
 "meditativeness": "استغراق في التفكير, تأمل (تفكير عميق وجاد)",
 "mediterranean": "متوسطي (من أو متعلق أو مميز أو يقع بالقرب من البحر الأبيض المتوسط)\nمثال: دول البحر الأبيض المتوسط",
 "mediterranean anaemia": "أنيميا البحر المتوسط, ثالاسيميا (شكل وراثي من فقر الدم ناتج عن خلل في تركيب الهيموغلوبين)",
 "mediterranean anchovy": "أنشوفة متوسطية (تُقدر لنكهتها؛ عادة ما تُحفظ أو تستخدم للصلصات والمقبلات)",
 "mediterranean anemia": "أنيميا البحر المتوسط, ثالاسيميا (شكل وراثي من فقر الدم ناتج عن خلل في تركيب الهيموغلوبين)",
 "mediterranean cypress": "سرو إيطالي, سرو المتوسط (سرو أوراسي طويل بلحاء رمادي رقيق وفروع صاعدة)",
 "mediterranean fever": "حمى مالطية, حمى متموجة (مرض بكتيري معد يصيب البشر ينتقل عن طريق الاتصال بالحيوانات المصابة أو اللحوم أو منتجات الألبان المصابة؛ يتميز بالحمى والصداع)",
 "mediterranean flour moth": "عثة دقيق البحر المتوسط (عثة صغيرة تتلف يرقاتها الحبوب والدقيق المخزن)",
 "mediterranean fruit fly": "ذبابة فاكهة البحر المتوسط (ذبابة صغيرة سوداء وبيضاء تتلف الحمضيات والفواكه الأخرى عن طريق زرع البيض الذي يفقس داخل الفاكهة)",
 "mediterranean hackberry": "ميس أوروبي, ميس جنوبي (شجرة ظل متساقطة الأوراق خضراء زاهية من جنوب أوروبا)",
 "mediterranean sea": "البَحْرُ الأَبْيَضُ الْمُتَوَسِّط, البَحْرُ المُتَوَسِّط",
 "mediterranean snapdragon": "أنف العجل المتوسطي, فم السمكة (نبات معمر موطنه البحر الأبيض المتوسط ولكن يزرع على نطاق واسع لزهوره الأرجوانية أو الوردية)",
 "mediterranean water shrew": "زباب الماء المتوسطي (نوع من زباب الماء)",
 "medium": "مُتَوَسِّط",
 "medium frequency": "تَرَدُّد مُتَوَسِّط (300 إلى 3000 كيلوهرتز)",
 "medium of exchange": "نظام نقدي, وسيط تبادل (أي شيء مقبول عموماً كمعيار للقيمة ومقياس للثروة في بلد أو منطقة معينة)",
 "medium steel": "فولاذ متوسط الصلابة (فولاذ يحتوي على 0.15-0.3% كربون)",
 "medium wave": "موجة متوسطة (موجة راديوية بطول موجي بين 100 و 1000 متر (تردد بين 300 كيلو هرتز و 3000 كيلو هرتز))",
 "medium-dry": "مُتَوَسِّط الجَفَاف ((للنبيذ) جاف لكن ليس شديد الجفاف)",
 "medium-large": "مُتَوَسِّط الكِبَر (كبير لكنه ليس الأكبر على الإطلاق)",
 "medium-size": "مُتَوَسِّطُ الْحَجْمِ (متوسط في الحجم)",
 "medium-sized": "مُتَوَسِّطُ ٱلْحَجْمِ",
 "medivac": "إجلاء طبي (إجلاء الأشخاص (عادة عن طريق النقل الجوي) إلى مكان حيث يمكنهم تلقي الرعاية الطبية)",
 "medlar": "مُشْمُلَة / إِسْكِدُنْيَا / زُعْرُور / مُصَع",
 "medlar tree": "زعرور جرماني, ميدلار (شجرة أوراسية نفضية صغيرة تزرع لفاكهتها التي تشبه التفاح البري)",
 "medley": "مزيج موسيقي, ميدلي (تأليف موسيقي يتكون من سلسلة من الأغاني أو القطع الموسيقية الأخرى من مصادر مختلفة)",
 "medline": "ميدلاين",
 "medoc": "ميدوك (نبيذ بوردو الأحمر من منطقة ميدوك بجنوب غرب فرنسا)",
 "medroxyprogesterone": "ميدروكسي بروجسترون (مركب بروجستين يستخدم لعلاج اضطرابات الدورة الشهرية)",
 "medulla": "لب, نخاع (الجزء الداخلي لعضو أو هيكل في النبات أو الحيوان) / بصلة السيساء, نخاع مستطيل (الجزء السفلي أو الخلفي من الدماغ؛ متصل بالحبل الشوكي) / مايلين, نخاعين (مادة دهنية بيضاء تشكل غمداً نخاعياً حول المحور العصبي لبعض الألياف العصبية)\nمثال: النخاع المستطيل هو الجزء الأكثر حيوية في الدماغ لأنه يحتوي على مراكز تتحكم في التنفس ووظائف القلب",
 "medulla oblongata": "نُخَاع مُسْتَطِيل, بَصَلَة سِيسَائِيَّة",
 "medulla spinalis": "حبل شوكي (جزء رئيسي من الجهاز العصبي المركزي يوصل النبضات العصبية الحسية والحركية من وإلى الدماغ؛ بنية أنبوبية طويلة تمتد من قاعدة الدماغ عبر القناة الفقرية…)",
 "medullary": "نخاعي (مكون من أو متعلق بالنخاع (اللب) لأي عضو في الجسم) / بصلي, نخاعي مستطيل (مكون من أو متعلق بالبصلة السيسائية (النخاع المستطيل)) / نخاعي, نقيي (يحتوي على أو يتكون من أو يشبه نخاع العظم)",
 "medullary ray": "شعاع نخاعي, شعاع وعائي (ورقة من الأنسجة الوعائية تفصل بين الحزم الوعائية)",
 "medullary sheath": "غِمْد النُّخَاع, غِمْد مَيَالِينِيّ (طبقة من المايلين تغلف (وتعزل) محاور الألياف العصبية النخاعية)",
 "medullated": "ميليني, نخاعيني ((عن الخلايا العصبية) مغطاة بطبقة من المايلين (النخاعين))",
 "medullated nerve fiber": "ليف عصبي مغمد بالنخاعين, ليف عصبي نخاعيني (ليف عصبي مغلف بغمد من الميالين (النخاعين))",
 "medusa": "مَدُوزَة",
 "medusa's head": "رأس ميدوسا (عشبة جاودار ضارة ذات سفا شائك طويل) / رأس ميدوسا, فربيون رأس ميدوسا (شجيرة عصارية قزمة أفريقية معمرة ذات فروع متدلية رفيعة عديدة)",
 "medusan": "شكل قنديلي, ميدوزا (أحد الشكلين اللذين تتخذهما الجوفمعويات: وهي المرحلة الجنسية حرة السباحة في دورة حياة الجوفمعويات؛ في هذه المرحلة يكون لها جسم هلامي يشبه المظلة ومجسات)",
 "medusoid": "شكل قنديلي, ميدوزا (أحد الشكلين اللذين تتخذهما الجوفمعويات: وهي المرحلة الجنسية حرة السباحة في دورة حياة الجوفمعويات؛ في هذه المرحلة يكون لها جسم هلامي يشبه المظلة ومجسات) / قنديلي, ميدوزي (متعلق بـ أو يشبه الميدوزا (قنديل البحر))",
 "medvedev": "مِيدْفِيدِيف",
 "meed": "مكافأة مستحقة (مكافأة مناسبة)",
 "meek": "خَنُوع, مُسْتَكِين (يُظْهِر قِلَّة فِي الشَّجَاعَة؛ مُفْرِط فِي الِامْتِثَال) / خَجُول, وَدِيع (متواضع في الروح أو السلوك؛ يُوحي بلطف منسحب أو خضوع مهيب) / خَنُوع, وَدِيع (بالغ الطاعة والانقياد)",
 "meekly": "بتواضع (بطريقة متواضعة) / بخضوع, بوداعة (بطريقة خاضعة أو مفتقرة للروح)\nمثال: خفض رأسه بتواضع",
 "meekness": "حلم, وداعة (ميل لأن يكون المرء صبوراً ومتحملاً) / خنوع, وداعة (شعور التواضع الصبور والخاضع)",
 "meem": "مِيم, م",
 "meerestone": "حجر الحدود (مصطلح قديم لمعلم أرضي يتكون من كومة من الحجارة يعلوها لوح قائم)",
 "meerkat": "سُرِقَاط, مِيرْكَات",
 "meerschaum": "غليون الرغوة البحرية, غليون ميرشام (غليون ذو وعاء مصنوع من حجر الميرشام (الرغوة البحرية)) / سيبيوليت, ميرشوم (معدن طيني أبيض)",
 "meet": "لَاقَى, لَقِيَ (لَقِيَ، صَادَفَ) / اِلْتَقَى, تَقَابَلَ ((لَازِمٌ) فِعْلُ مُشَارَكَةٍ فِي اللِّقَاءِ؛ (مُتَعَدٍّ بِنَفْسِهِ) لَقِيَهُ) / تَعَرَّفَ\nمثال: لقد التقى بماري.",
 "meeter": "حاضِر, حُضُور (شخص حاضر ومشارك في اجتماع)\nمثال: كان حاضراً دائماً في اجتماعات القسم",
 "meeting": "اِجْتِمَاع, مَجْلِس (جمعوا انفسهم؛ اسم يطلق على عملية جَمْع بعض الناس في مكان واحد ليتباحثوا أمرا) / مُلَاقَاة, مُقَابَلَة (لِقَاء) / مُلَاقَاة, لِقَاء (لِقَاء)\nمثال: هذا اجتماع مهم.",
 "meeting beam headlamp": "ضوء التلاقي, ضوء منخفض (مصباح أمامي منخفض الشعاع (يُسمى أيضاً ضوء المرور أو التلاقي) يوفر توزيعاً للضوء لإعطاء إضاءة أمامية وجانبية كافية دون إبهار مستخدمي الطريق الآخرين…)",
 "meeting house": "أكيليجا كندية, كولومبين كندي (كولومبين في شرق أمريكا الشمالية ذو زهور حمراء طويلة المهماز)",
 "meeting of minds": "تلاقى الأفكار, توافق (حالة من التعاون)",
 "meeting place": "مكان اجتماع, منتدى (منشأة عامة للاجتماع للمناقشة المفتوحة)",
 "meetinghouse": "دار الاجتماع (مبنى للتجمع الديني (خاصة غير الممتثلين، مثل الكويكرز))",
 "mefenamic acid": "بونستيل, حمض الميفيناميك (دواء مضاد للالتهاب ومسكن غير ستيرويدي (الاسم التجاري بونستيل) يستخدم لعلاج الألم الخفيف (خاصة تقلصات الدورة الشهرية))",
 "mefloquine": "لاريام, مفلوكوين (دواء مضاد للملاريا (الأسماء التجارية لاريام وغيرها) فعال في الحالات التي لا تستجيب للكلوروكين؛ يقال إنه ينتج آثاراً عصبية نفسية ضارة على بعض الناس)",
 "mefloquine hydrochloride": "لاريام, مفلوكوين (دواء مضاد للملاريا (الأسماء التجارية لاريام وغيرها) فعال في الحالات التي لا تستجيب للكلوروكين؛ يقال إنه ينتج آثاراً عصبية نفسية ضارة على بعض الناس)",
 "mefoxin": "سيفالوسبورين, ميفوكسين (واحد من عدة مواد مضادة حيوية واسعة الطيف يتم الحصول عليها من الفطريات وترتبط بالبنسلين (الأسماء التجارية ميفوكسين)؛ أدت إضافة سلاسل جانبية إلى إنتاج…)",
 "meg": "مِلْيُون (العدد الذي يمثله واحد متبوعاً بـ 6 أصفار)",
 "megabat": "خفاش الفاكهة (خفاش كبير من العالم القديم في المناطق الدافئة والاستوائية يتغذى على الفاكهة)",
 "megabit": "ميغابت (وحدة معلومات تساوي 1000 كيلوبت أو 10 أس 6 (1,000,000) بت)",
 "megabucks": "ثروة كبيرة, مبلغ طائل (مبلغ كبير من المال (خاصة كأجر أو ربح))\nمثال: لقد جنت مبلغاً طائلاً من بيع العقارات",
 "megabyte": "مِيغَابَايْت",
 "megacardia": "تضخم القلب (تضخم غير طبيعي للقلب)\nمثال: تضخم القلب الخفيف شائع لدى الرياضيين",
 "megacephaly": "ضخامة الرأس (رأس كبير بشكل غير طبيعي؛ يختلف عن استسقاء الدماغ لأنه لا يوجد ضغط زائد داخل الجمجمة ويكون فرط النمو متماثلاً)",
 "megacity": "مدينة كبيرة",
 "megacolon": "تضخم القولون (تضخم غير طبيعي للقولون؛ يمكن أن يكون خلقياً (كما في مرض هيرشسبرونغ) أو مكتسباً (كما هو الحال عندما يرفض الأطفال التبرز))",
 "megacycle": "مِيجَاهَرْتز (مليون دورة في الثانية)",
 "megacycle per second": "مِيجَاهَرْتز (مليون دورة في الثانية)",
 "megadeath": "إفناء جماعي, موت الملايين (موت مليون شخص)\nمثال: يقيسون آثار القنابل الذرية بعدد الملايين من القتلى",
 "megaderma lyra": "خفاش كبير الأذن (خفاش لاحم كبير من العالم القديم ذو أذنين كبيرتين جداً)",
 "megadose": "جرعة ضخمة (جرعة كبيرة بشكل استثنائي، كما هو الحال من دواء أو فيتامين)",
 "megaelectron volt": "ميغا إلكترون فولت (وحدة طاقة تساوي الشغل الذي يبذله إلكترون يتسارع عبر فرق جهد قدره مليون فولت)",
 "megaflop": "مليون عملية نقطة عائمة في الثانية, ميغا فلوب ((علم الحاسوب) وحدة لقياس سرعة نظام الحاسوب، الميغا فلوب الواحد هو مليون عملية نقطة عائمة في الثانية)",
 "megagametophyte": "مشيج أنثوي, نابتة عروسية كبروية (النابتة العروسية الأنثوية التي تنتجها البوغة الكبيرة لنبات ينتج كلا النوعين من الأبواغ (الصغيرة والكبيرة))",
 "megahertz": "مِيغَاهِرْتِز",
 "megahit": "بلوك باستر, عمل ضخم النجاح (نجاح غير عادي مع شعبية واسعة ومبيعات ضخمة (خاصة لفيلم أو مسرحية أو تسجيل أو رواية))",
 "megakaryocyte": "خلية كبيرة النواة, خلية نواء (خلية نخاع عظم كبيرة؛ تعتبر مصدر الصفائح الدموية)",
 "megakaryocytic": "ميجاكاريوسيتي, نواء ضخم (من أو يخص خلايا نخاع العظم الكبيرة (النواءات الضخمة))",
 "megalith": "جندل",
 "megalithic": "صخري ضخم, ميغاليثي (من أو متعلق بالصخور الضخمة (الميغاليث) أو الناس الذين أقاموها)\nمثال: آثار صخرية ضخمة مثل ستونهنج",
 "megalithic structure": "ميغاليث, نصب حجري ضخم (نصب تذكاري يتكون من حجر كبير جداً يشكل جزءاً من هيكل ما قبل التاريخ (خاصة في غرب أوروبا))",
 "megalobatrachus maximus": "سمندل عملاق (سمندل آسيوي كبير (يصل إلى أكثر من ثلاثة أقدام) صالح للأكل)",
 "megaloblast": "أرومة ضخمة (خلية دم حمراء كبيرة بشكل غير طبيعي توجد في فقر الدم الخبيث ونقص حمض الفوليك)",
 "megaloblastic": "أرومي ضخم (من أو يتعلق بالأرومات الضخمة (خلايا دم حمراء غير ناضجة))",
 "megaloblastic anaemia": "فقر الدم الوبيل الضخم الأرومات (فقر دم يتميز بوجود العديد من خلايا الدم الحمراء الكبيرة غير الناضجة وغير الوظيفية (أرومات ضخمة) في نخاع العظم؛ يرتبط بفقر الدم الوبيل)",
 "megaloblastic anemia": "فقر الدم الوبيل الضخم الأرومات (فقر دم يتميز بوجود العديد من خلايا الدم الحمراء الكبيرة غير الناضجة وغير الوظيفية (أرومات ضخمة) في نخاع العظم؛ يرتبط بفقر الدم الوبيل)",
 "megalocardia": "تضخم القلب (تضخم غير طبيعي للقلب)\nمثال: تضخم القلب الخفيف شائع لدى الرياضيين",
 "megalocephaly": "ضخامة الرأس (رأس كبير بشكل غير طبيعي؛ يختلف عن استسقاء الدماغ لأنه لا يوجد ضغط زائد داخل الجمجمة ويكون فرط النمو متماثلاً)",
 "megalocyte": "خلية دم حمراء ضخمة (خلية دم حمراء كبيرة بشكل غير طبيعي (مرتبطة بفقر الدم الخبيث))",
 "megalohepatia": "تضخم الكبد (تضخم غير طبيعي للكبد)",
 "megalomania": "جنون العظمة, ميغالومانيا (حالة نفسية تتميز بأوهام العظمة)",
 "megalomaniac": "مصاب بجنون العظمة (شخص أناني بشكل مرضي)",
 "megalomaniacal": "مُصَاب بِجُنُون العَظَمَة (يعاني من جنون العظمة)",
 "megalomanic": "مُصَاب بِجُنُون العَظَمَة (يعاني من جنون العظمة)",
 "megalopolis": "مَديِنَةٌ ضَخْمَةٌ",
 "megalops": "خُنْجُولَة",
 "megalosaur": "ميغالوصور (ديناصور لاحم عملاق ثنائي الأرجل من العصر الجوراسي أو أوائل العصر الطباشيري في أوروبا)",
 "megalosaurus": "ميغالوصور (ديناصور لاحم عملاق ثنائي الأرجل من العصر الجوراسي أو أوائل العصر الطباشيري في أوروبا)",
 "megan": "ميغان",
 "megaphone": "مُكَبِّر صَوْت, بُوق",
 "megapode": "شقبان (طيور كبيرة الأقدام قصيرة الأجنحة من أسترالاسيا؛ تبني أكواماً من النباتات المتحللة لاحتضان البيض)",
 "megaptera novaeangliae": "حوت أحدب (حوت باليني كبير ذو زعانف طويلة يشتهر بتقويس ظهره عند الغوص)",
 "megaron": "مِيغَارُون",
 "megascopic": "مَكْرُوسْكُوبِيّ (مَرْئِيٌّ بِالعَيْنِ المُجَرَّدَة (خَاصَّةً لِلصُّخُورِ وَالسِّمَاتِ التَّشْرِيحِيَّة))",
 "megasporangium": "محفظة بوغية كبيرة (بنية نباتية تنتج أبواغاً كبيرة)",
 "megaspore": "بوغ كبير (أكبر نوعي الأبواغ المنتجة في النباتات متباينة الأبواغ؛ يتطور في البويضة إلى نبات مشيجي أنثوي)",
 "megasporophyll": "ورقة بوغية كبيرة (في النباتات غير الزهرية، ورقة بوغية تحمل فقط محافظ بوغية كبيرة)",
 "megathere": "كسلان أرضي (ثديي أرضي عملاق منقرض شبيه بالكسلان عاش في العصرين البليوسيني والبليستوسيني في أمريكا)",
 "megatherian": "كسلان أرضي عملاق, ميجاثيريوم (كسلان أرضي ضخم منقرض)",
 "megatherian mammal": "كسلان أرضي عملاق, ميجاثيريوم (كسلان أرضي ضخم منقرض)",
 "megatheriid": "كسلان أرضي عملاق, ميجاثيريوم (كسلان أرضي ضخم منقرض)",
 "megaton": "ميغا طن (مقياس للقوة التفجيرية (لسلاح نووي) يساوي قوة مليون طن من مادة تي إن تي) / ميغا طن (مليون طن)",
 "megaton bomb": "قنبلة ميجا طن (سلاح نووي بقوة تفجيرية تعادل مليون طن من مادة تي إن تي)",
 "megavitamin therapy": "علاج بالفيتامينات المكثفة (علاج يعتمد على نظرية مفادها أن تناول جرعات كبيرة جداً من الفيتامينات سيمنع أو يعالج الاضطرابات الجسدية أو النفسية)",
 "megawatt": "ميغاواط (وحدة للقدرة تساوي مليون واط)",
 "megawatt hour": "ميغاواط ساعي (وحدة طاقة تساوي الشغل المبذول بقدرة مليون واط تعمل لمدة ساعة واحدة)",
 "megawatt-hour": "ميغاواط ساعي (وحدة طاقة تساوي الشغل المبذول بقدرة مليون واط تعمل لمدة ساعة واحدة)",
 "megestrol": "ميجيسترول (مركب بروجستيروني اصطناعي يستخدم لعلاج سرطان بطانة الرحم)",
 "megestrol acetate": "ميجيسترول (مركب بروجستيروني اصطناعي يستخدم لعلاج سرطان بطانة الرحم)",
 "meghalaya": "مِيغَالَايَا",
 "megillah": "لفافة إستير, ميجيلات إستير ((اليهودية) لفافة الرق التي تحتوي على القصة التوراتية لإستير؛ تقرأ تقليدياً في المعابد للاحتفال بعيد الفور) / قصة طويلة مملة (رواية طويلة ومملة ومفصلة بشكل مضجر)\nمثال: أصر على سرد القصة الطويلة المملة كاملة لنا",
 "megilp": "ميجيلب (وسط للألوان الزيتية؛ زيت بذر الكتان الممزوج بوارنيش المصطكي أو زيت التربنتين)",
 "megohm": "ميغا أوم (وحدة مقاومة تساوي مليون أوم)",
 "megrim": "شقيقة, صداع نصفي (صداع وعائي متكرر شديد؛ يحدث بشكل متكرر عند النساء أكثر من الرجال)",
 "megrims": "حزن, غم (حالة من الاكتئاب)\nمثال: كان يعاني من حالة كآبة شديدة",
 "mehboob": "مَحْبُوب",
 "mei": "مشمش ياباني (شجرة زينة يابانية بزهور بيضاء أو وردية عطرة وثمار صفراء صغيرة)",
 "meibomian cyst": "برد, كيسة ميبومية (كيس دهني صغير في الجفن ينتج عن انسداد غدة ميبوميان)",
 "meibomian gland": "غدة تارسية, غدة ميبوميان (غدة دهنية طويلة ترطب الجفون)\nمثال: تنتج العدوى البكتيرية لغدة ميبوميان شحاذاً",
 "meiosis": "إثبات بالنفي, تورية (تهوين للتأثير البلاغي (خاصة عند التعبير عن الإيجاب بنفي ضده)) / انقسام اختزالي, انقسام منصف ((علم الوراثة) انقسام الخلية الذي ينتج خلايا تناسلية في الكائنات التي تتكاثر جنسيًا؛ تنقسم النواة إلى أربع نوى تحتوي كل منها على نصف عدد الكروموسومات)\nمثال: قول 'لم أكن منزعجاً قليلاً' عندما تقصد 'كنت منزعجاً جداً' هو مثال على الإثبات بالنفي",
 "meiotic": "انتصافي, ميوزي (مكون من أو متعلق بالانقسام المنصف (الميوزي))",
 "meissa": "الهَقْعَة",
 "meitnerium": "مِيتْنِرْيُوم",
 "meknes": "مَكْنَاس",
 "melaena": "تغوط أسود, ميلينا (براز قطري داكن بشكل غير طبيعي يحتوي على دم (عادة من نزيف الجهاز الهضمي))",
 "melagra": "ألم الأطراف (آلام روماتيزمية أو عضلية في الذراعين أو الساقين)",
 "melagueta pepper": "حبوب الجنة, فلفل غينيا (نبات من غرب أفريقيا يحمل بذوراً حريفة تشبه الفلفل)",
 "melamine": "ميلامين (قاعدة عضوية بلورية بيضاء؛ تستخدم أساساً في صنع راتنجات الميلامين)",
 "melamine resin": "راتنج الميلامين (راتنج متصلب بالحرارة يتكون من الميلامين والألدهيد؛ يُستخدم في المنتجات المقولبة والمواد اللاصقة والطلاء)",
 "melampodium leucanthum": "أقحوان ذو القدم السوداء, ميلامبديوم (شجيرة صغيرة كثيفة لها رؤوس زهرية تشبه الأستر بأشعة بيضاء عريضة؛ توجد في المناطق الصحراوية من أريزونا شرقاً إلى كانساس وجنوباً إلى المكسيك)",
 "melampsora lini": "صدأ الكتان (فطر يسبب صدأ الكتان)",
 "melancholia": "سَوْدَاوِيَّة",
 "melancholiac": "سَوْداوِيّ, مُكْتَئِب (شخص عرضة للملانخوليا (السوداوية))",
 "melancholic": "سَوْدَاوِيّ (اسم منسوب إلى سوداءُ؛ (نف) مصاب بالسوداء، وهي مرض نفسيّ من أعراضه الحزن العميق والتشاؤم المطلق وهبوط النشاط الحركيّ \"رجل سوداويّ المزاج\")",
 "melancholy": "سَوْدَاوِيَّة",
 "melancholy thistle": "شوك حزين (شوك معمر ذو رئد من شمال أوروبا بأوراق قاعدية سنانية ورؤوس زهور حمراء أرجوانية منفردة عادة)",
 "melanerpes erythrocephalus": "نقار الخشب أحمر الرأس (نقار خشب أسود وأبيض من أمريكا الشمالية له رأس ورقبة حمراء)",
 "melanesia": "مِيلَانِيزِيَا",
 "melanesian": "ميلانيزي (متعلق بميلانيزيا أو شعبها أو ثقافتها)",
 "melange": "أخلاط, أشياء متنوعة (تشكيلة مختلطة من الأشياء)",
 "melange yarn": "خيط مخلوط, خيط ميلانج (خيط ينتج عن مزيج من ليفين على الأقل، إما من أنواع مختلفة أو ألوان مختلفة)\nمثال: يتميز هذا القميص بنسيج تويل مصقول قليلاً بألوان عميقة منسوج باستخدام خيط ميلانج",
 "melanin": "ميلانين (أصباغ غير قابلة للذوبان مسؤولة عن لون الجلد والقشور والريش)",
 "melanism": "تصبغ, قتام (حالة تتميز برواسب غير طبيعية من الميلانين)",
 "melanitta nigra": "بط أسود شائع (نوع من البط الأسود)",
 "melanoblast": "أرومة ميلانينية (خلية في البشرة تعتبر سلفاً للخلية الصباغية)",
 "melanocyte": "خلية صباغية, خلية ميلانينية (خلية في الطبقة القاعدية للبشرة تنتج الميلانين تحت سيطرة الهرمون المحفز للخلايا الصباغية)",
 "melanocyte-stimulating hormone": "هرمون محفز للخلايا الصبغية, هرمون منبه لصبغة الميلانين (هرمون تفرزه الغدة النخامية الأمامية يتحكم في درجة تصبغ الخلايا الصبغية)",
 "melanoderma": "تسوّد الجلد (جلد داكن بشكل غير طبيعي بسبب زيادة رواسب الميلاتونين)",
 "melanogrammus aeglefinus": "حدوق (سمكة غذائية مهمة على جانبي المحيط الأطلسي؛ مرتبطة بالقد ولكنها عادة أصغر)",
 "melanoma": "ميلانوما, ورم ميلانيني (أي من الأورام الخبيثة المتعددة (عادة في الجلد) التي تتكون من الخلايا الصبغية (الميلانينية))",
 "melanosis": "تصبغ, قتام (حالة تتميز برواسب غير طبيعية من الميلانين)",
 "melanotis caerulescens": "طائر محاكي أزرق (طائر محاكي من المكسيك)",
 "melasma": "كَلَف (سبب له كُلْفَة، أي كان أمرا صعبا وغير سهل أو طبيعي؛ جعل عليه كُلْفَة وثَمَنا كبيرا، أي كان غاليا عليه)\nمثال: كلف ذلك فاضل حياته.",
 "melastoma malabathricum": "رودودندرون هندي (شجيرة منتشرة دائمة الخضرة من الهند وجنوب شرق آسيا ذات أزهار أرجوانية كبيرة)",
 "melatonin": "ميلاتونين (هرمون تفرزه الغدة الصنوبرية)",
 "melba toast": "توست ميلبا (توست بني رقيق جداً ومقرمش)",
 "melbourne": "مِلْبُورْن مِيلْبُورْن",
 "melchite": "ملكي (مسيحي أرثوذكسي أو كاثوليكي شرقي ينتمي إلى بطريركية الإسكندرية أو أنطاكية أو القدس) / ملكي (مسيحي شرقي في مصر أو سوريا يلتزم بالعقيدة الأرثوذكسية كما حددها مجمع خلقيدونية عام 451 وكما قبلها الإمبراطور البيزنطي)",
 "melchizedek": "مَلِك السَّلَام (لغة في المَالِك، وهو الذي يَمْلِكُ؛ السُلْطَان الحَاكِم الذي يملك الأَرْض والبِلاد)\nمثال: زيري ملك لنفسه.",
 "meld": "كاناستا (شكل من أشكال الرومي يستخدم رزمتين من الأوراق وأربعة جوكر؛ الجوكر والاثنين هما أوراق حرة؛ الهدف هو تشكيل مجموعات من نفس الرتبة)",
 "meleagris gallopavo": "ديك رومي (طائر كبير من الدجاجيات له ذيل مروحي الشكل؛ يربى على نطاق واسع من أجل الطعام)",
 "melee": "شجار",
 "melena": "تغوط أسود, ميلينا (براز قطري داكن بشكل غير طبيعي يحتوي على دم (عادة من نزيف الجهاز الهضمي))",
 "meles meles": "غرير أوراسي (نوع من الغرير موطنه أوروبا وآسيا)",
 "meletius": "مِلَاتِيُوس",
 "melia azadirachta": "أزاديراشتا إنديكا, شجرة النيم (شجرة كبيرة شبه دائمة الخضرة من جزر الهند الشرقية؛ يفرز جذعها صمغاً متماسكاً؛ يستخدم لحاؤها المر كمقوٍ؛ وتنتج البذور زيتاً عطرياً)",
 "melia azedarach": "أزدرخت, زنزلخت (شجرة من شمال الهند والصين لها أزهار أرجوانية وثمار صفراء صغيرة غير صالحة للأكل؛ تم توطينها في جنوب الولايات المتحدة كشجرة ظل)",
 "melia azederach": "أزدرخت, زنزلخت (شجرة من شمال الهند والصين لها أزهار أرجوانية وثمار صفراء صغيرة غير صالحة للأكل؛ تم توطينها في جنوب الولايات المتحدة كشجرة ظل)",
 "melic verse": "شعر غنائي يوناني (شعر مخصص للغناء، وخاصة الشعر الغنائي اليوناني من القرن السابع إلى الخامس قبل الميلاد)",
 "melicocca bijuga": "ليمون إسباني, مامونسيلو (شجرة استوائية أمريكية تحمل فاكهة صغيرة صالحة للأكل ذات قشرة جلدية خضراء ولب شفاف عصيري حلو)",
 "melicocca bijugatus": "ليمون إسباني, مامونسيلو (شجرة استوائية أمريكية تحمل فاكهة صغيرة صالحة للأكل ذات قشرة جلدية خضراء ولب شفاف عصيري حلو)",
 "melilla": "مَلِيلْيَة",
 "melilot": "إكليل الملك, حندقوق (نبات حولي أو ثنائي الحول قائم يزرع على نطاق واسع خاصة للتبن ولتحسين التربة)",
 "melilotus": "إكليل الملك, حندقوق (نبات حولي أو ثنائي الحول قائم يزرع على نطاق واسع خاصة للتبن ولتحسين التربة)",
 "melilotus alba": "إكليل الملك الأبيض, حندقوق أبيض (نبات ثنائي الحول؛ يعتبر نبات عسل قيم)",
 "melilotus officinalis": "إكليل الملك الأصفر, حندقوق طبي (نبات أوراسي ثنائي الحول أصفر الزهر ذو أوراق عطرية تستخدم كطارد للغازات أو مادة منكهة؛ يزرع على نطاق واسع خاصة كسماد أخضر أو محصول تغطية)",
 "melioration": "تحسين, تلطيف (فعل تخفيف العلل والتغيير للأفضل) / تحسين المعنى (العملية اللغوية التي تكتسب فيها الكلمة بمرور الوقت دلالة أكثر إيجابية أو معنى أرقى) / تحسن, تحسين (حالة أفضل من حالة سابقة)\nمثال: المدرسة الجديدة تمثل تحسناً كبيراً",
 "meliorative": "إِصْلَاحِيّ, تَحْسِينِيّ (يميل إلى التحسين والإصلاح)",
 "meliorism": "مذهب التحسين, ميليورية (الاعتقاد بأن العالم يمكن جعله أفضل من خلال الجهد البشري)",
 "meliorist": "إِصْلاحِيّ, مُصْلِح (مجادل يدعو إلى الإصلاح)",
 "melissa officinalis": "ترنجان, عشبة الليمون (نعناع معمر كثيف من العالم القديم له أزهار بيضاء أو مصفرة صغيرة وأوراق عطرية بنكهة الليمون؛ هارب من الحدائق في شمال أوروبا وأمريكا الشمالية)",
 "melkite": "ملكي (مسيحي أرثوذكسي أو كاثوليكي شرقي ينتمي إلى بطريركية الإسكندرية أو أنطاكية أو القدس) / ملكي (مسيحي شرقي في مصر أو سوريا يلتزم بالعقيدة الأرثوذكسية كما حددها مجمع خلقيدونية عام 451 وكما قبلها الإمبراطور البيزنطي)",
 "mellaril": "ثيوريدازين, ميلاريل (مهدئ (الاسم التجاري ميلاريل) يستخدم لعلاج الفصام والاضطرابات الذهانية الأخرى)",
 "mellifluous": "رَقِيقُ النَّغَم, عَذْب (مُمْتِعٌ لِلأُذُنِ وَلَطِيفُ الوَقْعِ عَلَيْهَا)",
 "mellisonant": "رَقِيقُ النَّغَم, عَذْب (مُمْتِعٌ لِلأُذُنِ وَلَطِيفُ الوَقْعِ عَلَيْهَا)",
 "mellitate": "مليتات (ملح لحمض الميليتيك)",
 "mellivora capensis": "غرير العسل (لاحم ليلي يشبه الغرير من المناطق المشجرة في أفريقيا وجنوب آسيا)",
 "mellow": "برخامة, بنعومة (بطريقة رخيمة) / ثَمِل قَلِيلًا, مُنْتَشٍ (فِي حَالَة نَشْوَة خَفِيفَة مِنَ الكُحُول أَوِ المُخَدِّرَات) / هادِئ, وَديع (لَطيف وهادِئ؛ نَضِج واعْتَدَل بِمُرور الوَقْت) / مُعَتَّق, نَاعِم (ذو نكهة ممتلئة ومُسْتَحَبّة بفضل التعتيق المناسب)",
 "mellowed": "هادِئ, وَديع (لَطيف وهادِئ؛ نَضِج واعْتَدَل بِمُرور الوَقْت) / مُعَتَّق, نَاعِم (ذو نكهة ممتلئة ومُسْتَحَبّة بفضل التعتيق المناسب)",
 "mellowing": "تليين, نضج (عملية أن يصبح الشيء ناضجًا أو ليناً)",
 "mellowingly": "بشكل ملطف (بحيث يلطف أو ينضج)\nمثال: ضربت أشعة الشمس الأرض بشكل ملطف",
 "mellowly": "برخامة, بنعومة (بطريقة رخيمة)",
 "mellowness": "انتشاء, نشوة (المرح واللطف، كما من خلال تأثيرات الكحول أو الماريجوانا) / رقة لونية, نعومة (درجة ناعمة من اللون) / امتلاء, رقة (خاصية الإحساس الغني والممتع) / طراوة, نضج النكهة (طعم (خاصة للفاكهة) ناضج وكامل النكهة)\nمثال: رقة الضوء والظلال التي لا يمكن تحقيقها في الرخام",
 "melodic": "شجي, عذب الألحان (يحتوي على أو يشكل أو يتميز بلحن ممتع) / لحني (متعلق باللحن)\nمثال: الأغنية العذبة لطائر المروج",
 "melodic line": "جملة لحنية, لحن (تتابع من النغمات يشكل تسلسلاً مميزاً)\nمثال: كانت تدندن لحناً لبيتهوفن",
 "melodic phrase": "جملة لحنية, لحن (تتابع من النغمات يشكل تسلسلاً مميزاً)\nمثال: كانت تدندن لحناً لبيتهوفن",
 "melodic theme": "تيمة, موضوع موسيقي ((موسيقى) الموضوع اللحني لتكوين موسيقي)\nمثال: تم الإعلان عن الموضوع في المقاييس الأولى",
 "melodically": "لحنياً (فيما يتعلق باللحن)\nمثال: موضوعات مثيرة للاهتمام لحنياً",
 "melodious": "شجي, عذب الألحان (يحتوي على أو يشكل أو يتميز بلحن ممتع) / عذب, مُنغَّم (لديه صوت موسيقي؛ خاصة نغمة ممتعة)\nمثال: الأغنية العذبة لطائر المروج",
 "melodiously": "بشكل منغم, بعذوبة (بطريقة شجية ولحنية)\nمثال: غنت بعذوبة",
 "melodiousness": "عذوبة النغم, نغمية (خاصية امتلاك لحن)",
 "melodrama": "مِيلُودْرَامَا",
 "melodramatic": "مِيلُودْرَامِيّ (يَحْمِل إِثَارَةً وَجَاذِبِيَّةً عَاطِفِيَّة كَالمِيلُودْرَامَا) / اِسْتِعْرَاضِيّ, مَسْرَحِيّ (مِنْ سِمَات التَّمْثِيل أَوِ الأَدَاء المَسْرَحِيّ؛ غَالِبًا مُتَكَلَّف)",
 "melodramatically": "بشكل درامي مفرط (بطريقة عاطفية مبالغ فيها) / بأسلوب الميلودراما (كما في الميلودراما)\nمثال: تصرفت بشكل درامي مفرط عندما طلبت المساعدة",
 "melody": "لَحْن, أُغْنِيَّة (وضع الألحان أو التأليف الموسيقي؛ قرأ النص بلحن أو أداء صوتي مميز)\nمثال: أنا أحب هذا اللحن.",
 "melody pipe": "أنبوب اللحن (أنبوب قصبي به ثقوب للأصابع يُعزف عليه اللحن)",
 "meloid": "خنفساء محرقة, ذراح (خنفساء تنتج إفرازاً يسبب تقرحات في الجلد)",
 "melolontha melolontha": "خنفساء أيار, دودة بيضاء (أي من الخنافس الأوروبية الكبيرة المتنوعة المدمرة للنباتات كيرقات وبالغين)",
 "melolonthid beetle": "خنفساء ميلولونثيد (أي من خنافس متنوعة من فصيلة (أو تحت فصيلة) ميلولونثيداي)",
 "melon": "شَمَّام",
 "melon ball": "كرة شمام (قطعة من الشمام مقطعة على شكل كرة)",
 "melon tree": "بابايا, ببايا (شجيرة أو شجرة صغيرة استوائية أمريكية لها أوراق ضخمة مفصصة بعمق وفاكهة صفراء مستطيلة كبيرة)",
 "melon vine": "بطيخ, شمام (أي من ثمار الكروم القرعية المختلفة بما في ذلك: الشمام، والبطيخ الأحمر، والكنتالوب، والخيار)",
 "melophagus ovinus": "ذبابة الغنم (ذبابة غير مجنحة طفيلية خارجية على الأغنام والماشية)",
 "melopsittacus undulatus": "بادجي, ببغاء الدرة (ببغاء أسترالي صغير عادة ما يكون لونه أخضر فاتح مع علامات سوداء وصفراء في البرية ولكن يتم تربيته بألوان عديدة)",
 "melosa": "عشبة القطران التشيلية, ماديا (عشبة من أمريكا الجنوبية ذات أوراق غدية لزجة؛ مصدر لزيت الماديا)",
 "melospiza georgiana": "عصفور المستنقع (عصفور من أمريكا الشمالية يعيش في المناطق المستنقعية)",
 "melospiza melodia": "عصفور مغرد (طائر مغرد صغير شائع في أمريكا الشمالية)",
 "melphalan": "ألكيران, ملفالان (دواء مضاد للأورام (الاسم التجاري ألكيران) يستخدم لعلاج المايلوما المتعددة وبعض الأورام الخبيثة الأخرى)",
 "melt": "ذَابَ, انْصَهَرَ (تحوّل الشيء من حالته الصلبة إلى حالة سائلة نتيجة الحرارة؛ زال أو تلاشى شيئًا فشيئًا، مثل ذوبان الجليد أو اختفاء الألم)\nمثال: ذاب ذلك الجليد.",
 "meltability": "قابلية الانصهار (القدرة على التحول من الحالة الصلبة إلى السائلة عادة عن طريق الحرارة)\nمثال: تم إثبات أن ضغوط التجانس العالية أدت إلى ضعف قابلية التمدد والانصهار للجبن",
 "meltable": "قَابِلٌ لِلانْصِهَار (يمكن صهره وإذابته بالحرارة)",
 "meltdown": "اِنْصِهَار نَوَوِيّ (صَهَرَ (الشَّيْءَ) ، كالشّحْمِ ونَحْوِه، يَصْهَرُه صَهْراً: (أَذابَه، فانْصَهَرَ، فَهُوَ صَهِيرٌ)…؛ انصهر المعدن ينصهر انصهاراً:ذاب بفعل الحرارة،تحوّل من حالة صلبة إلى حالة سائلة)",
 "melted": "ذائب, سائل (تحول من حالة صلبة إلى سائلة)\nمثال: أنهار فاضت بسبب الثلوج الذائبة",
 "melter": "صاهر (عامل يصهر المواد (المعدن أو الشمع وما إلى ذلك))",
 "melting": "اِنْصِهَار, ذَوَبَان (صَهَرَ (الشَّيْءَ) ، كالشّحْمِ ونَحْوِه، يَصْهَرُه صَهْراً: (أَذابَه، فانْصَهَرَ، فَهُوَ صَهِيرٌ)…؛ انصهر المعدن ينصهر انصهاراً:ذاب بفعل الحرارة،تحوّل من حالة صلبة إلى حالة سائلة)",
 "melting point": "نقطة الانصهار, نقطة التجمد (درجة الحرارة التي يتحول تحتها السائل إلى صلب)",
 "melting pot": "قِدْر صَهْر (قضاء الله وحكمه وما قَدَّرَه؛ مبلغ الشيء وكميتّه، بنفس معنى قَدْر)\nمثال: خذ قدر ما تريد.",
 "meltwater": "ماء ذائب (الثلج أو الجليد المذاب)",
 "melursus ursinus": "دب الكسلان (دب شائع خشن الشعر طويل الخطم من جنوب وسط آسيا)",
 "mem": "ميم (الحرف الثالث عشر من الأبجدية العبرية)",
 "member": "عُضْو, عِضْو (جُزْء من الجَسَد؛ مُشْتَرِك فِي جَمْعِيَّة أو شَرِكَة أو حِزْب أو نَادٍ) / عُضُو (جُزْء من الجَسَد؛ مُشْتَرِك فِي جَمْعِيَّة أو شَرِكَة أو حِزْب أو نَادٍ)\nمثال: اذكر كل عضو باسمه.",
 "member bank": "بنك عضو (بنك عضو في نظام الاحتياطي الفيدرالي)",
 "member of parliament": "عضو برلمان, نائب (عضو منتخب في البرلمان البريطاني: عضو في مجلس العموم)",
 "member state": "دَوْلَة عُضْو, دَوْلَة عِضْو (بَلَد يتميز بحُدُود معروفة وشَعْب وحُكُومَة ومُؤَسَسَات مُنَظَّمَة؛ مجموعة من الناس مستقلين متحدين معا لتكوين مجتمع لحماية حقوقهم و وضع قوانينهم الخاصة)\nمثال: لبنان دولة صغيرة.",
 "membered": "ذو أعضاء (له أعضاء؛ تستخدم عادة في الكيمياء مع رقم)",
 "memberless": "بلا أعضاء (لمجموعة أو فئة ليس لها أعضاء)",
 "membership": "عُضْوِيَّة",
 "membership card": "بطاقة عضوية (بطاقة تثبت العضوية في منظمة ما)",
 "membrane": "غِشَاء",
 "membrane bone": "عظم غشائي (أي عظم ينمو داخل الأنسجة الغشائية دون تكوين غضروفي مسبق؛ مثل الترقوة وعظام الجمجمة)",
 "membrane filter": "مرشح غشائي (مرشح يتكون من طبقة رقيقة من الكولوديون أو خلات السليلوز أو مادة أخرى، متوفر في مجموعة واسعة من أحجام المسام المحددة، والأصغر منها قادرة على الاحتفاظ…)",
 "membrane-forming": "غِشائِيّ (يَتَّسِم بِتَكْوين غِشاء أو ما يُشبِهُه)",
 "membranophone": "طبل (آلة إيقاعية موسيقية؛ تتكون عادة من أسطوانة مجوفة مع غشاء مشدود عبر كل طرف)",
 "membranous": "غِشائِيّ (يَتَّسِم بِتَكْوين غِشاء أو ما يُشبِهُه) / غشائي (متعلق بـ أو مصنوع من أو مشابه لغشاء)\nمثال: بطانة غشائية",
 "membranous labyrinth": "تِيه غِشَائِيّ (الهياكل الحسية للأذن الداخلية بما في ذلك المستقبلات التيهية والقوقعة؛ وتوجد داخل التيه العظمي)",
 "meme": "مِيم / مِيم, م",
 "memento": "تذكار (شيء يذكر بأحداث الماضي)",
 "memento mori": "تذكرة الموت, ميمينتو موري (تذكير (مثل جمجمة) بحتمية موتك)",
 "memetics": "علم الميمات, ميميات (نظرية للمحتوى العقلي تستند إلى تشبيه بالتطور الدارويني)",
 "memo": "مذكرة, مذكرة داخلية (اقتراح أو تذكير مكتوب)",
 "memoir": "مُذَكَّرَات, مُذَكِّرَات",
 "memorabilia": "تذكارات, مذكرات (سجل لأشياء تستحق التذكر)",
 "memorability": "جدارة التذكر, قابلية التذكر (صفة كون الشيء جديراً بالتذكر)\nمثال: التغيير المستمر يؤدي إلى عدم القدرة على التذكر",
 "memorable": "جَدِيرٌ بِالتَّذَكُّر, لَافِت (يَسْتَحِقُّ أَنْ يُتَذَكَّرَ)",
 "memorably": "بشكل لا ينسى (بطريقة لا تُنسى)\nمثال: كان هوروويتز يعزف شوبان بشكل لا ينسى",
 "memoranda": "مذكرة, مذكرة داخلية (اقتراح أو تذكير مكتوب)",
 "memorandum": "مُذَكِرَة",
 "memorial": "نُصْب / نُصْب تَذْكَارِيّ",
 "memorial day": "يوم الذكرى (عطلة قانونية في الولايات المتحدة، آخر يوم اثنين في مايو؛ يحيي ذكرى أعضاء القوات المسلحة الأمريكية الذين قتلوا في الحرب)",
 "memorial park": "جبانة, مدفن (قطعة أرض تستخدم للدفن)",
 "memorial tablet": "لوحة تذكارية نحاسية, لوحة معدنية (نصب تذكاري مصنوع من النحاس الأصفر)",
 "memorialisation": "إحياء ذكرى, تأبين (مراسم لتكريم ذكرى شخص أو شيء ما)",
 "memorialization": "إحياء ذكرى, تأبين (مراسم لتكريم ذكرى شخص أو شيء ما)",
 "memorisation": "استظهار, حفظ (التعلم بغرض التذكر الحرفي)\nمثال: حفظ الممثل لسطوره",
 "memoriser": "حفّاظ, مستظهر (شخص يتعلم عن ظهر قلب)",
 "memorization": "حِفْظ (الحِفْظُ نَقِيضُ النِّسْيَان، وهو التَّعَاهُدُ وقِلَّةُ الغَفْلَةِ؛ قِلَّةُ الغَفْلَةِ)\nمثال: حفظ رقم هاتفها.",
 "memorize": "حَفِظَ (الحِفْظُ نَقِيضُ النِّسْيَان، وهو التَّعَاهُدُ وقِلَّةُ الغَفْلَةِ؛ قِلَّةُ الغَفْلَةِ)\nمثال: حفظ رقم هاتفها.",
 "memorizer": "حفّاظ, مستظهر (شخص يتعلم عن ظهر قلب)",
