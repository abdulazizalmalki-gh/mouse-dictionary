 "marrow": "نِقْيُ ٱلْعَظْم, مُخُّ ٱلْعَظْم / كُوسَا",
 "marrow squash": "قرع نباتي, كوسة (أي من نباتات القرع المختلفة التي تزرع لثمارها الممدودة ذات القشرة الخضراء الداكنة واللب الأبيض)",
 "marrowbone": "عظم النخاع, عظم مخي (عظم يحتوي على نخاع صالح للأكل؛ يستخدم خاصة في نكهة الحساء)",
 "marrowfat pea": "بازلاء كبيرة (نوع من البازلاء الكبيرة التي يتم معالجتها وبيعها عادة في علب)",
 "marrubium vulgare": "فراسيون أبيض, فراسيون شائع (عشب عطري أوروبي بأوراق مشعرة والعديد من الزهور البيضاء في سيمات إبطية؛ تنتج الأوراق مستخلصاً مراً يستخدم طبياً وكنكهة)",
 "marry": "تَزَوَّجَ / زَوَّجَ (زَوَّجَ الأَشياءَ تَزْويجًا، وزَواجًا: قرن بعضَها ببعض؛ زَوَّجَ فلانًا امرأةً، وبها: جعله يتزوَجَها)\nمثال: زوجة ماري طبيبة.",
 "marry off": "زَوَّجَ (زَوَّجَ الأَشياءَ تَزْويجًا، وزَواجًا: قرن بعضَها ببعض؛ زَوَّجَ فلانًا امرأةً، وبها: جعله يتزوَجَها)\nمثال: زوجة ماري طبيبة.",
 "mars": "الْمِرِّيخ, المريخ (رابع كوكب من كواكب المجموعة الشمسية) / مَارِس (ومَرِسَ؛ إله الحرب في الأساطير الرُومِيَّة، وهو المَرِيِّخ، لا يؤنث ولا يجمع)\nمثال: المريخ عالم ميت.",
 "marsala": "مارسالا (نبيذ حلوى داكن حلو أو شبه حلو من صقلية)",
 "marseillaise": "لَامَارْسِيِيز",
 "marseille": "مَارْسِيلْيَا, مَرْسِيلْيَا",
 "marseilles fever": "حمى بوتونية, حمى مرسيليا (مرض تسببه الريكيتسيا وينتقل للبشر عن طريق القراد)",
 "marsh": "نَعْصَة, مُسْتَنْقَع",
 "marsh andromeda": "أندروميدا المستنقعات (شجيرة دائمة الخضرة قائمة أو منبطحة لها عناقيد متدلية من الزهور البيضاء أو الوردية؛ من مستنقعات الخث الطحلبية والمناطق الحمضية الرطبة الأخرى في شمال…)",
 "marsh bellflower": "جريس المستنقع (زهرة الجرس شائعة في مستنقعات شرق أمريكا الشمالية ذات أوراق سنانية خطية وأزهار بيضاء صغيرة)",
 "marsh buggy": "عربة المستنقعات (مركبة برمائية عادة ذات دفع رباعي وجسم مرتفع)",
 "marsh clematis": "ياسمين أزرق, ياسمين بري مجعد (نبات متسلق من جنوب الولايات المتحدة ذو أزهار أرجوانية مائلة للزرقة)",
 "marsh cress": "جرجير أصفر, رشاد المستنقعات (رشاد سنوي أو ثنائي الحول ينمو في الأماكن الرطبة يستخدم أحياناً في السلطات أو كعشبة طهي؛ عشبة ضارة مزعجة في بعض المناطق)",
 "marsh elder": "إيفا, عشبة المستنقع (أي من النباتات الشجيرية الخشنة المختلفة من جنس إيفا ذات أزهار خضراء صغيرة؛ شائعة في المناطق الرطبة (مثل المستنقعات الملحية الساحلية) في شرق ووسط…)",
 "marsh felwort": "جنطيانا المستنقعات, سويرتيا (نبات معمر في الأماكن الرطبة في جبال أوراسيا وأمريكا الشمالية له أزهار زرقاء أو بنفسجية باهتة اللون)",
 "marsh fern": "سرخس المستنقعات (سرخس له سعف مفصص ريشياً وينمو في الأماكن الرطبة؛ عالمي الانتشار في المناطق المعتدلة الشمالية)",
 "marsh gas": "غاز المستنقعات (غاز الميثان الناتج عن تحلل النباتات في الماء)",
 "marsh gentian": "جنطيانا المستنقعات (جنطيانا أوراسية معمرة ذات زهور زرقاء سماوية قمعية الشكل تنمو في المروج المفتوحة الرطبة)",
 "marsh hare": "أرنب الأهوار (أرنب غابات يعيش في المناطق الساحلية المستنقعية من نورث كارولينا إلى فلوريدا)",
 "marsh harrier": "مرزة المستنقعات (مرزة من العالم القديم تتردد على مناطق المستنقعات)",
 "marsh hawk": "مرزة الدجاج (مرزة شائعة في أمريكا الشمالية وأوروبا؛ تعشش في المستنقعات والأراضي المفتوحة)",
 "marsh hen": "دجاجة الماء (طَيْر من الدواجن، لا يطير ويربيه البشر لبيضه ولحمه وريشه؛ أنثى بعض الطيور من الفصائل التي لا تطير كالقَبَج وغيره) / غر أمريكي (غر يوجد في أمريكا الشمالية)\nمثال: وضعت الدجاجة بيضة.",
 "marsh horsetail": "ذيل الحصان السبخي, كنباث سبخي (ذيل حصان واسع الانتشار في المناطق الرطبة أو المستنقعية في نصف الكرة الشمالي)",
 "marsh mallow": "خِطْمِيّ",
 "marsh marigold": "آذريون المستنقع, قطيفة المستنقع (نبات مستنقعات من أوروبا وأمريكا الشمالية ذو أزهار صفراء زاهية تشبه الحوذان)",
 "marsh milkweed": "جو باي الأرجواني, غافث أرجواني (عشب من أمريكا الشمالية له أوراق محيطية وعناقيد طرفية من الزهور المرقطة بالأرجواني)",
 "marsh orchid": "أوركيد المستنقعات (أي من عدة بساتين فاكهة من جنس داكتيلوريزا ذات جذور درنية تشبه الأصابع؛ أوروبا ومنطقة البحر الأبيض المتوسط)",
 "marsh pea": "بازلاء المستنقعات, جلبان المستنقعات (نبات معمر متسلق في المناطق الرطبة أو المستنقعية في أوراسيا وأمريكا الشمالية بزهور أرجوانية)",
 "marsh pink": "قرنفل المستنقعات, قنطريون أمريكي (أي من عدة نباتات مستنقعات زهرية اللون من شرق الولايات المتحدة تشبه القنطريون الحقيقي)",
 "marsh plant": "نبات المستنقعات (نبات شبه مائي ينمو في الأراضي الرطبة الرخوة؛ معظمها من ذوات الفلقة الواحدة: السعادى، الطحالب، الأعشاب، البردي، إلخ؛ وربما الخلنج)",
 "marsh rosemary": "لافندر البحر, ليمونيوم (أي من نباتات مختلفة من جنس ليمونيوم في المستنقعات الملحية المعتدلة لها سنابل من الزهور البيضاء أو البنفسجية الباهتة)",
 "marsh st-john's wort": "عشبة القديس يوحنا المستنقعية (عشبة مستنقعات معمرة ذات زهور وردية إلى بنفسجية؛ جنوب شرق الولايات المتحدة)",
 "marsh tea": "إكليل الجبل البري, شاي المستنقع (شجيرة مستنقعات من شمال ووسط أوروبا وشرق سيبيريا إلى كوريا واليابان)",
 "marsh trefoil": "إطريفل الماء, فاصوليا المستنقعات (نبات معمر في أوروبا وأمريكا له عناقيد من الزهور البيضاء أو الأرجوانية وأوراق ثلاثية شديدة المرارة؛ غالباً ما يتجذر عند حافة الماء وينتشر عبر السطح)",
 "marsh wren": "نمنمة المستنقعات",
 "marshal": "عَقِيْد",
 "marshall": "مارْشال, مَأْمُور تَنْفِيذ قَضائِيّ (ضابط قانون له واجبات مشابهة للمأمور في تنفيذ أحكام المحكمة) / مارشال, مشير ((في بعض البلدان) ضابط عسكري من أعلى رتبة)",
 "marshall islands": "جُزُر مَارْشَال (جَزَرَ الماءُ عن الأَرضِ يَجْزُرُ جَزْراً: نَضَبَ وحَسَرَ؛ ويقال: جَزَرَ البَحْرُ والنَّهْرُ: انْحسرَ ماؤُهُ)\nمثال: ضع الجزر في القدر.",
 "marshalling yard": "ساحة تجميع القطارات (ساحة سكة حديد يتم فيها تجميع القطارات وتحميل البضائع)",
 "marshals": "خدمة المارشال الأمريكية (أقدم وكالة إنفاذ قانون فيدرالية في الولايات المتحدة مسؤولة اليوم عن حماية القضاء الفيدرالي ونقل السجناء الفيدراليين وحماية الشهود الفيدراليين وإدارة…)",
 "marshalship": "رتبة مارشال, منصب المشير (منصب المشير أو المارشال)",
 "marshland": "مستنقع عشبي, هور (أرض رطبة منخفضة ذات غطاء نباتي عشبي؛ عادة ما تكون منطقة انتقالية بين اليابسة والماء)\nمثال: آلاف الأفدنة من المستنقعات",
 "marshmallow": "خِطْمِيّ",
 "marshmallow fluff": "كريمة المارشميلو (معجون أبيض حلو جداً يشبه حلوى المارشميلو)",
 "marshy": "مُسْتَنْقَعِيّ, وَحِل ((عن التربة) ليّنة ومشبَعة بالماء)",
 "marsilea drummondii": "ناردو, ناردو شائع (سرخس البرسيم الأسترالي)",
 "marsilea quadrifolia": "برسيم مائي (سرخس مائي من أوروبا وآسيا وشرق الولايات المتحدة يتميز بأربع وريقات تشبه أوراق البرسيم)",
 "marsupial": "جِرَابِيّ, جِرَاب",
 "marsupial mole": "خلد جرابي (جرابي أسترالي حفار صغير يشبه الخلد)",
 "marsupial mouse": "فأر جرابي (أي من جرابيات عديدة صغيرة حادة الأنف آكلة للحشرات تشبه الفئران أو الجرذان ظاهرياً)",
 "marsupial rat": "فأر جرابي (أي من جرابيات عديدة صغيرة حادة الأنف آكلة للحشرات تشبه الفئران أو الجرذان ظاهرياً)",
 "marsupium": "جراب (جيب بطني خارجي في معظم الجرابيات حيث يتم إرضاع الصغار حديثي الولادة)",
 "mart": "ساحة السوق, سوق (منطقة في مدينة حيث تُقام منشأة تجارية عامة)",
 "martagon": "زنبق العمامة, مارتاغون (زنبق بزهور أرجوانية باهتة صغيرة من شمال غرب أوروبا وشمال غرب آسيا)",
 "martello tower": "برج مارتيلو (حصن حجري دائري للدفاع الساحلي)",
 "marten": "دَلَق, خَزّ (صب وأراق؛ خرج سريعًا)",
 "marten cat": "دلق (عرسيات شجرية رشيقة نحيلة الجسم أكبر قليلاً من ابن عرس)",
 "martensite": "مارتنزيت (محلول جامد للكربون في حديد ألفا يتشكل عندما يتم تبريد الفولاذ بسرعة كبيرة بحيث يتم كبح التغيير من الأوستنيت إلى البيرليت؛ مسؤول عن صلابة الفولاذ…)",
 "martes americana": "دلق أمريكي (يُقدر لفروه)",
 "martes foina": "دلق الحجر (دلق أوراسي ذو معطف بني مع صدر وحلق شاحب)",
 "martes martes": "دلق الصنوبر (دلق بني داكن من الغابات الصنوبرية في شمال أوراسيا)",
 "martes pennanti": "دلق الصياد, فيشر (ثديي لاحم شجري كبير بني داكن من أمريكا الشمالية)",
 "martes zibellina": "سمور (دلق من غابات شمال آسيا ذو فرو بني داكن فاخر)",
 "martha": "مَرْثَا",
 "martial": "جُنْدِيّ, فُرُوسِيّ ((لِلأَشْخَاص) يَلِيقُ بِالمُحَارِبِ؛ ذُو خِصَالٍ عَسْكَرِيَّة) / حَرْبِيّ, قِتَالِيّ (يُوحِي بِالحَرْبِ أَوِ الحَيَاةِ العَسْكَرِيَّة)",
 "martial art": "فَنٌّ قِتَالِيّ, الفُنُون القِتَالِيَّة (نوع، صنف؛ كل عمل جميل يؤثر في المشاعر والعواطف)\nمثال: هذا مدرسنا في الفن.",
 "martial law": "حُكْم عُرْفِيّ (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ)\nمثال: حكم علي بالموت.",
 "martial music": "مارش عسكري, موسيقى عسكرية (موسيقى مسير حيوية مناسبة للجنود الذين يسيرون في عرض عسكري)",
 "martially": "عسكرياً (بطريقة عسكرية)",
 "martian": "مِرِّيخِيّ",
 "martin": "مَارْتِن",
 "martin luther king day": "يوم مارتن لوثر كينغ (يُحتفل به في يوم الاثنين الأقرب إلى 15 يناير)",
 "martin luther king jr's birthday": "يوم مارتن لوثر كينغ (يُحتفل به في يوم الاثنين الأقرب إلى 15 يناير)",
 "martinet": "صارم, متشدد (شخص يطلب الالتزام التام بالقواعد والشكليات)",
 "martingale": "عارضة الدولفين (عارضة تحت الصاري المائل لمركب شراعي) / لجام الصدر, مارتنجال (شريط سرج يربط قطعة الأنف بالحزام البطني؛ يمنع الحصان من رفع رأسه للخلف)",
 "martini": "مارتيني (كوكتيل مصنوع من الجن (أو الفودكا) مع فيرموث جاف)",
 "martinique": "مَارْتِينِيك",
 "martinmas": "11 نوفمبر, عيد القديس مارتن (عيد القديس مارتن؛ يوم ربع سنوي في اسكتلندا)",
 "martynia": "مارتينيا (عشب حولي أو معمر مترامي الأطراف في أمريكا الوسطى وجزر الهند الغربية له أزهار جرسية الشكل بيضاء قشدية إلى حمراء أرجوانية تليها ثمار قرنية غير عادية)",
 "martynia annua": "مارتينيا (عشب حولي أو معمر مترامي الأطراف في أمريكا الوسطى وجزر الهند الغربية له أزهار جرسية الشكل بيضاء قشدية إلى حمراء أرجوانية تليها ثمار قرنية غير عادية)",
 "martynia arenaria": "مخالب الشيطان الرملية (يوضع بشكل بديل في جنس مارتينيا)",
 "martynia fragrans": "نبات وحيد القرن الحلو (مصدر للفعل نَبَتَ؛ اسم جنس شامل لكل ما تنبته الأرض من شجر أو بقل أو عشب أو غيره)\nمثال: هذا النبات مهدد بالانقراض.",
 "martyr": "شُهَدَاء, شَهِيد",
 "martyr operation": "عملية استشهادية, مهمة انتحارية (قتل أو إصابة الآخرين مع إهلاك النفس؛ يتم عادة بقنبلة)",
 "martyrdom": "شَهَادَة",
 "martyropolis": "مَيَّافَارِقِين",
 "martyropolitan": "فَارِقِي",
 "marum": "زعتر القطط, ماروم (جعدة متوسطية لها أوراق زغبية صغيرة وزهور أرجوانية محمرة؛ جذابة للقطط)",
 "marumi": "كمكوات مستدير, مارومي (شجيرة تحمل كمكوات مستدير الثمار)",
 "marumi kumquat": "كمكوات مستدير, مارومي (شجيرة تحمل كمكوات مستدير الثمار)",
 "marupa": "سيماروبا مرة, ماروبا (شجرة في وادي الأمازون تنتج خشباً خفيفاً وهشاً يعتبر محلياً مقاوماً لهجمات الحشرات)",
 "marut": "ماروت (أي من مجموعة آلهة العواصف الهندوسية؛ نسل رودرا)",
 "marvel": "أعجوبة (شيء يسبب مشاعر التعجب)\nمثال: عجائب العلم الحديث",
 "marvel of peru": "شَبّ اللَيْل",
 "marvel-of-peru": "أعجوبة بيرو, شب الليل (نبات حديقة شائع في أمريكا الشمالية ذو زهور عطرة حمراء أو أرجوانية أو صفراء أو بيضاء تفتح في وقت متأخر من بعد الظهر)",
 "marveller": "مَنْبَهِر, مُتَعَجِّب (شخص مليء بالإعجاب والرهبة؛ شخص يتعجب من شيء ما)",
 "marvellous": "عَجِيب, مُسْتَبْعَد (مستبعد جداً بحيث لا يمكن تصديقه) / خَارِق, مُعْجِز (ذو طابع المعجزة أو يتسم بها) / رَائِع, عَظِيم (جيد أو عظيم بشكل استثنائي؛ يُستخدم خاصة كمكثف)",
 "marvellously": "بشكل رائع, بشكل مذهل ((يستخدم للمبالغة) بشكل ممتاز)\nمثال: صوتها منضبط بشكل رائع",
 "marvelous": "مُدْهِش, بَدِيع",
 "marvelously": "بشكل رائع, بشكل مذهل ((يستخدم للمبالغة) بشكل ممتاز)\nمثال: صوتها منضبط بشكل رائع",
 "marx": "مَارْكْس",
 "marxism": "مَارْكْسِيَّة",
 "marxism-leninism": "مَارْكْسِيَّة-لِينِينِيَّة",
 "marxist": "مَارْكِسِيّ, مَارْكْسِيّ",
 "marxist-leninist": "ماركسي لينيني (يتبع أفكار ماركس التي توسعت لتشمل أفكار لينين)",
 "mary": "مَرْيَم, مَارِي ((في الديانات الإبراهيمية) مريم بنت عمران، وهي أم النبي عِيسَى، والمرأة الوحيدة التي ورد ذكرها في القرآن، حيث سميت على اسمها السورة التاسعة عشر؛ اسم شخصي معطًى لدى الإناث من العَرَب) / مَرْيَم ((في الديانات الإبراهيمية) مريم بنت عمران، وهي أم النبي عِيسَى، والمرأة الوحيدة التي ورد ذكرها في القرآن، حيث سميت على اسمها السورة التاسعة عشر؛ اسم شخصي معطًى لدى الإناث من العَرَب)\nمثال: مريم طرقت الباب.",
 "mary jane": "بانجو, عشب (أسماء دارجة للماريجوانا)",
 "mary magdalene": "مَرْيَم الْمَجْدَلِيَّة ((في الديانات الإبراهيمية) مريم بنت عمران، وهي أم النبي عِيسَى، والمرأة الوحيدة التي ورد ذكرها في القرآن، حيث سميت على اسمها السورة التاسعة عشر؛ اسم شخصي معطًى لدى الإناث من العَرَب)\nمثال: مريم طرقت الباب.",
 "maryam": "مَرْيَم ((في الديانات الإبراهيمية) مريم بنت عمران، وهي أم النبي عِيسَى، والمرأة الوحيدة التي ورد ذكرها في القرآن، حيث سميت على اسمها السورة التاسعة عشر؛ اسم شخصي معطًى لدى الإناث من العَرَب) / سورة مريم\nمثال: مريم طرقت الباب.",
 "maryland": "مَارِيلَانْد",
 "maryland chicken": "دجاج ماريلاند (دجاج مقلي ثم مخبوز في الفرن ويقدم مع مرق الحليب)",
