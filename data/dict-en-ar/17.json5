 "milliammeter": "مقياس ميلي أمبير (مقياس أمبير حساس مدرج بالميلي أمبير)",
 "milliampere": "ملي أمبير (واحد من الألف من الأمبير)",
 "milliard": "مِلْيَار\nمثال: في إنجلترا يسمون الألف مليون 'مِلياراً'",
 "millibar": "ميلي بار",
 "millicurie": "ملي كوري (وحدة للنشاط الإشعاعي تساوي واحد من الألف من الكوري)",
 "millidegree": "ملي درجة (وحدة درجة حرارة تساوي جزءًا من ألف من الدرجة)",
 "milliequivalent": "ملي مكافئ (جزء من ألف من المكافئ)",
 "millifarad": "مليفاراد (وحدة للسعة الكهربائية تساوي واحداً من الألف من الفاراد)",
 "milligram": "مِلِّيغْرَام",
 "millihenry": "ملي هنري (وحدة للمحاثة تساوي واحد من الألف من الهنري)",
