 "mammy": "أمي, ماما (مصطلحات غير رسمية للأم) / مربية سوداء (مصطلح مسيء لمربية سوداء في جنوب الولايات المتحدة)",
 "mamo": "مامو (طيور عسل سوداء ذات ريش أصفر حول الذيل؛ منقرضة الآن)",
 "mamoncillo": "ليمون إسباني, مامونسيلو (شجرة استوائية أمريكية تحمل فاكهة صغيرة صالحة للأكل ذات قشرة جلدية خضراء ولب شفاف عصيري حلو)",
 "man": "إِنْسَان, نَاس (كَائِن بَشَرِيّ؛ سَوَاد العَيْن) / زود بالجند (زَوَّدَ (زوده): أزاده. ويقال زودته كتابا إلى فلان؛ زَوَّدَ(هـ) بكذا: أمده به)\nمثال: أنا إنسان صادق.",
 "man and wife": "رجل وزوجته, زواج (شخصان متزوجان من بعضهما البعض)\nمثال: كان زواجه الثاني أكثر سعادة من الأول",
 "man friday": "مساعد أيمن (المساعد الذكر الأكثر فائدة)",
 "man hour": "ساعة عمل (وحدة زمنية تستخدم في الصناعة لقياس العمل)",
 "man in the street": "فلان الفلاني, مواطن مجهول (رجل عادي افتراضي (يُستخدم للإشارة إلى شخص غير محدد))",
 "man jack": "أحد, فرد (فرد واحد)\nمثال: كل واحد منهم",
 "man of action": "رَجُل عَمَل (العُضْو في جسد الإنسان يتكون من القَدَم والسَاق والفُخْذ. الجمع أرجُل، وقد تقول العامّة رِجْلين ورجْلينات؛ القَدَم من باب اطلاق اسم الكل على الجزء)\nمثال: هذا الرجل تاجر.",
 "man of affairs": "رجل أعمال (رجل يعمل في الأعمال التجارية أو الصناعية)",
 "man of deeds": "رَجُل أَفْعَال (شخص يميل إلى التصرف أولاً والتفكير لاحقاً)",
 "man of letters": "عَالِم (الذي يعلم؛ متخصص في عِلْم ما وباحث فيه)\nمثال: هو عالم أحيائي.",
 "man of means": "رجل ميسور (العُضْو في جسد الإنسان يتكون من القَدَم والسَاق والفُخْذ. الجمع أرجُل، وقد تقول العامّة رِجْلين ورجْلينات؛ القَدَم من باب اطلاق اسم الكل على الجزء)\nمثال: هذا الرجل تاجر.",
 "man of the cloth": "رجل دين (عضو ذكر في سلك الكهنوت وقائد روحي للكنيسة المسيحية)",
 "man of the world": "شخص راق, شخص محنك (شخص حكيم دنيوياً)",
 "man overboard": "شخصٌ سقط في الماء (سواد الإنسان حين يرى من بعيد فلا يُعرَف؛ واحد الإنسان بصورة عامة بدون تحديد لسنه وجنسه وقومه وغير ذلك)\nمثال: هذا الشخص فنان.",
 "man shall not live by bread alone": "لَيْسَ بِٱلْخُبْزِ وَحْدَهُ يَحْيَا ٱلْإِنْسَانُ",
 "man's best friend": "أَفْضَل صَدِيق لِلْإِنْسَان",
 "man's body": "جَسَدُ الرَّجُل (جسد رجل بالغ)",
 "man-about-town": "زير نساء, لعوب (رجل مكرس للسعي وراء المتعة)",
 "man-at-arms": "رجل السلاح, محارب (جندي مدجج بالسلاح وممتطٍ لجواد في العصور الوسطى)",
 "man-child": "ابن, ذرية ذكر (الولد الذكر)\nمثال: هو له ابن صغير.",
 "man-eater": "قرش أبيض, قرش أبيض كبير (قرش عدواني كبير واسع الانتشار في البحار الدافئة؛ معروف بمهاجمته للبشر) / آكل لحوم البشر (شخص يأكل اللحم البشري)",
 "man-eating shark": "قرش أبيض, قرش أبيض كبير (قرش عدواني كبير واسع الانتشار في البحار الدافئة؛ معروف بمهاجمته للبشر)",
 "man-made": "تَرْكِيبِيّ, مَصْنُوع (ليس من أصل طبيعي؛ أُعِدّ أو صُنِع صناعيًّا)",
 "man-made fiber": "ألياف صناعية, ألياف من صنع الإنسان (ألياف تم إنشاؤها من مواد طبيعية أو عن طريق عمليات كيميائية)",
 "man-made lake": "بحيرة صناعية, خزان مائي (بحيرة تستخدم لتخزين المياه للاستخدام المجتمعي؛ بحيرة (طبيعية أو اصطناعية) تستخدم لتخزين المياه واستخدامها كمصدر للمياه)",
 "man-month": "رجل-شهر, شهر عمل (وقت عمل شخص واحد لمدة شهر، يُستخدم كمقياس لمقدار العمل أو الجهد المطلوب لأداء مهمة ما)",
 "man-of-the-earth": "كرمة البطاطا البرية (نبات معمر عشبي مفترش أو متسلق أمريكي استوائي له جذر نشوي ضخم؛ يعتبر أحياناً مصدراً للبطاطا الحلوة) / أثمان رفيع الأوراق, رجل الأرض (نبات مجد الصباح بجذور طويلة من غرب الولايات المتحدة)",
 "man-of-war": "سَفِينَة حَرْبِيَّة (مَرْكَبٌ بَحْرِيٌّ لِنَقْلِ الْمُسَافِرِينَ وَالبَضَائِعِ)\nمثال: غادروا السفينة.",
 "man-of-war bird": "فرقاط (طائر بحري طويل المنقار من المياه الدافئة ذو باع جناحين عريض وذيل متشعب)",
 "man-on-a-horse": "رجل على حصان (غاريقون صالح للأكل بخياشيم صفراء وقبعة صفراء لزجة لها مركز بني)",
 "man-portable": "يَحْمِلُهُ شَخْصٌ وَاحِد (يُمْكِنُ لِشَخْصٍ وَاحِدٍ حَمْلُهُ وَنَقْلُه)",
 "man-sized": "بِحَجْم رَجُل (كبير جداً؛ مناسب لحجم رجل بالغ) / بِحَجْمِ الرِّجَال (يتطلب قوة رجل)",
 "man-to-man": "بصراحة, كرجل لرجل (بشكل مباشر أو صريح) / رَجُلٌ لِرَجُل, فَرْدِيّ (نظام لعب يراقب فيه كل لاعب دفاعيّ لاعبًا هجوميًّا بعينه) / أَمِين, صَرِيح (مُبَاشِر وَصَادِق)\nمثال: يجب أن نتحدث كرجل لرجل",
 "manacle": "أصفاد, كلبشات (قيد يتكون من حلقة معدنية يمكن قفلها حول المعصم؛ تستخدم عادة في أزواج)",
 "manage": "أَدَارَ (دَارَ نصف دورة فقط؛ الشيء: جعله يدور؛ فعل تعدّي من دَارَ)\nمثال: أدار فاضل مقبض الباب بهدوء و دخل إلى المنزل.",
 "manageability": "قابلية للإدارة (القدرة على الإدارة أو التحكم)",
 "manageable": "طيع, قابل للإدارة (يمكن إدارته أو التحكم فيه) / قَابِل لِلتَّحْقِيق, قَابِل لِلْإِنْجَاز (يمكن تحقيقه أو إنجازه؛ في حيّز الإمكان)",
 "manageableness": "قابلية للإدارة (القدرة على الإدارة أو التحكم)",
 "manageably": "بشكل معقول, بشكل يمكن التحكم فيه (بحيث يمكن إدارته)\nمثال: هذا المنزل صغير بشكل يمكن التحكم فيه",
 "managed economy": "اقتصاد موجه (اقتصاد غير سوقي يكون فيه التدخل الحكومي مهماً في تخصيص السلع والموارد وتحديد الأسعار)",
 "management": "إِدَارَة (هو عملية تولي تَصْرِيف شؤون العَمَل. لا جمع له؛ مجموع الناس الذين يقومون بإدارة شؤون الجهة، حكومية كانت أم خاصة)\nمثال: والدتي تنتظرني في الإدارة.",
 "management consultant": "مستشار إداري (مستشار للشركات بشأن ممارسات الإدارة الفعالة)",
 "management consulting": "استشارات إدارية (صناعة خدمات تقدم المشورة للمسؤولين عن إدارة الأعمال)",
 "management control": "رقابة إدارية (رقابة داخلية يقوم بها واحد أو أكثر من المديرين)",
 "management personnel": "موظفو الإدارة (الموظفون الذين لديهم مسؤوليات شاملة للتخطيط والتوجيه)",
 "management system": "نِظَامْ إِدَارَةْ (مَنْهَج، طَرِيقَة؛ تَرْتِيب واتِّسَاق)\nمثال: ليس بنظام كامل.",
 "manager": "مُدِير, مُدِيرَة (الشخص الذي أدار، جمعه مُدِيرُون ومُدِيرِين؛ مهنة يتولى صاحبها إدَارَة شؤون جهة ما. جمعه مُدَرَاء)\nمثال: زيري هو المدير.",
 "manageress": "مديرة (امرأة تعمل كمدير)",
 "managerial": "إداري, تسييري (متعلق بوظيفة أو مسؤولية أو نشاط الإدارة)",
 "managerial economics": "اقتصاد إداري (تطبيق المفاهيم الاقتصادية والتحليل الاقتصادي على مشاكل صياغة القرارات الإدارية العقلانية)",
 "managerially": "إدارياً (بطريقة إدارية)",
 "managership": "إدارة, منصب المدير (منصب المدير)",
 "managing director": "مدير (شخص يتحكم في الموارد والنفقات)",
 "managing editor": "مدير تحرير (المحرر المسؤول عن جميع الأنشطة التحريرية لصحيفة أو مجلة)",
 "managua": "مَنَاغُوَة",
 "manakin": "ماناكن (أي من الطيور الصغيرة زاهية الألوان العديدة في أمريكا الوسطى والجنوبية ذات مناقير قصيرة وسلوك تودد معقد) / دمية عرض, مانيكان (دمية بالحجم الطبيعي تستخدم لعرض الملابس) / عارضة أزياء (امرأة ترتدي الملابس لعرض الأزياء)\nمثال: كانت بدينة جداً لدرجة أنها لا تصلح كعارضة أزياء",
 "manama": "الْمَنَامَة",
 "manana": "تسويف, غد (وقت غير محدد في المستقبل)",
 "manasseh": "مَنَسَّى",
 "manat": "مَنَاة",
 "manatee": "خَرُوف البَحْر",
 "manbij": "مَنْبِج",
 "manchego": "مَنْتْشِيغُو",
 "manchester": "مَانْشِسْتِر, مَانْشِسْتَر",
 "manchester terrier": "مانشستر تيريير (سلالة من تيريير الجرذان قصير الشعر ذو فراء أسود وأسمر تم تطويرها في مانشستر، إنجلترا)",
 "manchu": "لغة المانشو (هِيَ مجموعة من الأصوات التي يصدرها الإنسان على شكل كلمات منظمة بقواعد، ليتواصل به الناس وينقلون به الافكار والمعاني، اللسان؛ يقصد بها أحيانا اللهجة)\nمثال: الأمازيغية لغة.",
 "manchu dynasty": "تشينغ, سلالة تشينغ (آخر سلالة إمبراطورية للصين (من 1644 إلى 1912) والتي أطاح بها الثوار؛ خلال سلالة تشينغ حكم المانشو الصين)",
 "manchu language": "المانشو (اللغة التنغوسية التي يتحدث بها المانشو)",
 "manchuria": "مَنْشُورِيَا",
 "manchurian": "منشوريا",
 "mancunian": "مانشستري (من أو متعلق أو مميز لمدينة مانشستر الإنجليزية أو سكانها) / مانشستري, مانكني (مواطن أو مقيم في مانشستر)\nمثال: تجار مانشستريون",
 "manda": "ماندا (لغة درافيدية يتم التحدث بها في جنوب وسط الهند، وتحديداً في أوديشا)",
 "manda language": "ماندا (لغة درافيدية يتم التحدث بها في جنوب وسط الهند، وتحديداً في أوديشا)",
 "mandaean": "مندائي (مكون من أو متعلق بالشعب المندائي أو لغتهم أو ثقافتهم) / المندائية (شكل الآرامية الذي يستخدمه المندائيون) / مندائي (عضو في طائفة غنوصية صغيرة نشأت في الأردن وتعيش في العراق، وتؤمن بأن يوحنا المعمدان كان المسيح)",
 "mandaean language": "المندائية (شكل الآرامية الذي يستخدمه المندائيون)",
 "mandaeanism": "مندائية (ديانة غنوصية نشأت في القرنين الثاني والثالث تؤمن بأن يوحنا المعمدان كان المسيح وتدمج عناصر يهودية ومسيحية في إطار من المعتقدات الثنائية)",
 "mandaeism": "مِنْدَائِيَّة",
 "mandage": "كوتوكو (لغة تشادية يتم التحدث بها جنوب بحيرة تشاد، وعادة ما يتم التحدث بها على طول نهري شاري ولوغون السفليين)",
 "mandage language": "كوتوكو (لغة تشادية يتم التحدث بها جنوب بحيرة تشاد، وعادة ما يتم التحدث بها على طول نهري شاري ولوغون السفليين)",
 "mandala": "ماندالا (أي من التصاميم الهندسية المختلفة (عادة دائرية) ترمز للكون؛ تستخدم بشكل رئيسي في الهندوسية والبوذية كأداة مساعدة للتأمل)",
 "mandamus": "أمر تنفيذ, مانداموس (أمر استثنائي يأمر مسؤولاً بأداء عمل وزاري يعترف به القانون كواجب مطلق وليس مسألة تقديرية للمسؤول؛ يستخدم فقط عند فشل جميع العلاجات القضائية الأخرى)",
 "mandara": "ماندارا (لغة تشادية يتم التحدث بها في جبال ماندارا في الكاميرون؛ لها حرفان متحركان فقط)",
 "mandara language": "ماندارا (لغة تشادية يتم التحدث بها في جبال ماندارا في الكاميرون؛ لها حرفان متحركان فقط)",
 "mandarin": "اَللُّغَة اَلصِّينِيَّة اَلشَّمَالِيَّة, مَنْدَرِينِيَّة",
 "mandarin chinese": "الصينية الفصحى, الماندرين (لهجة صينية يتم التحدث بها في بكين وتم اعتمادها كلغة رسمية للصين بأكملها)",
 "mandarin dialect": "الصينية الفصحى, الماندرين (لهجة صينية يتم التحدث بها في بكين وتم اعتمادها كلغة رسمية للصين بأكملها)",
 "mandarin duck": "بطة الماندرين (بطة آسيوية متوجة مبهرجة؛ غالباً ما تُستأنس)",
 "mandarin orange": "يُوسُفِيّ, يُوسُف أَفَنْدِي",
 "mandarin orange tree": "مندرين, يوسفي (شجيرة أو شجرة صغيرة لها فاكهة كروية مفلطحة بلب عطري حلو جداً وقشرة رقيقة صفراء برتقالية إلى برتقالية نارية فضفاضة وسهلة الإزالة؛ موطنها جنوب شرق آسيا)",
 "mandatary": "صاحب التفويض, وكيل مفوض (متلقي تفويض أو توكيل)",
 "mandate": "اِنْتِدَاب, حُكْم",
 "mandator": "آمر, مانح التفويض (سلطة تصدر تفويضاً أو أمراً)",
 "mandatorily": "إِجْبَارِيًّا, إِلْزَامِيًّا (بطريقة لا يمكن التهرب منها)\nمثال: ترى الوزارة أن المساهمات في مثل هذا الصندوق يجب أن تُلبى من التبرعات الطوعية بدلاً من الرسوم المفروضة إجبارياً",
 "mandatory": "إِجْبَارِيّ, مَفْرُوض",
 "mandatory injunction": "أمر قضائي إلزامي (أمر قضائي يتطلب أداء فعل محدد)",
 "mandatory palestine": "فلسطين الانتدابية (دَوْلَةُ فِلَسْطِين: مِنَ الْبُلْدَانِ الْعَرَبِيَّةِ بِالشَّرْقِ الأَوْسَطِ، عَاصِمَتُهَا الْقُدْسُ (مُحتَلَةٌ/ مُتَنَازَعٌ عَلَيْهَا)؛ مِنْطَقَةُ فِلَسْطِين: كُورَةٌ بالشّامِ، والْمَعْرُوفَةُ فيما بين الأُرْدُنّ وديار مِصْرَ، وأُمُّ بِلَادِهَا بيتُ المَقْدِسِ. وهي من أجناد الشام)\nمثال: الحرية لفلسطين.",
 "mande": "ماندي (مجموعة من اللغات الأفريقية في مجموعة النيجر والكونغو يتم التحدث بها من السنغال شرقًا حتى ساحل العاج)",
 "mandean": "مندائي (مكون من أو متعلق بالشعب المندائي أو لغتهم أو ثقافتهم) / المندائية (شكل الآرامية الذي يستخدمه المندائيون) / مندائي (عضو في طائفة غنوصية صغيرة نشأت في الأردن وتعيش في العراق، وتؤمن بأن يوحنا المعمدان كان المسيح)",
 "mandean language": "المندائية (شكل الآرامية الذي يستخدمه المندائيون)",
 "mandeanism": "مندائية (ديانة غنوصية نشأت في القرنين الثاني والثالث تؤمن بأن يوحنا المعمدان كان المسيح وتدمج عناصر يهودية ومسيحية في إطار من المعتقدات الثنائية)",
 "mandela": "مَانْدِيلَا",
 "mandela effect": "تَأْثِير مَانْدَيلَا",
 "mandelamine": "مانديلامين, ميثينامين (عامل مضاد للبكتيريا (الأسماء التجارية مانديلامين ويوريكس) يوجد في العديد من المنتجات التي تستخدم لعلاج التهابات المسالك البولية)",
 "mandelbrot set": "مجموعة ماندلبرو (مجموعة من الأعداد المركبة التي تُظهر حدوداً فركتالية (كسرية) شديدة التعقيد عند رسمها؛ وهي مجموعة النقاط في المستوى المركب التي تظل محدودة تحت تكرار…)",
 "mandevilla boliviensis": "ديبلادينيا بيضاء, مانديفيلا (نبات متسلق شجيري ذو أوراق لامعة وأزهار بيضاء قمعية الشكل ذات حلق أصفر)",
 "mandevilla laxa": "ياسمين تشيلي (كرمة خشبية من الأرجنتين تزرع للزينة لأوراقها اللامعة وعناقيدها من الزهور البيضاء الكريمية الكبيرة العطرة قمعية الشكل)",
 "mandible": "فك سفلي (الفك في الفقاريات الذي يتمفصل ليفتح الفم)",
 "mandibula": "فك سفلي (الفك في الفقاريات الذي يتمفصل ليفتح الفم)",
 "mandibular": "فكي سفلي (متعلق بالفك السفلي)",
 "mandibular bone": "فك سفلي (الفك في الفقاريات الذي يتمفصل ليفتح الفم)",
 "mandibular condyle": "لقمة الفك السفلي, نتوء لقمي (لقمة فرع الفك السفلي التي تتمفصل مع الجمجمة)",
 "mandibular fossa": "حفرة الفك السفلي (تجويف عميق في العظم الصدغي عند جذر القوس الوجني يستقبل لقمة الفك السفلي)",
 "mandibular gland": "غدة تحت الفك السفلي (غدة لعابية داخل الفك السفلي على كلا الجانبين تنتج معظم اللعاب الليلي؛ تفرغ اللعاب في الفم تحت اللسان)",
 "mandibular joint": "مفصل صدغي فكي, مفصل فكي (المفصل بين رأس عظم الفك السفلي والعظم الصدغي)",
 "mandibular notch": "الثلمة الفكية (انبعاج صغير في منتصف عظم الفك السفلي)",
 "mandibulate": "ذي فكوك (يمتلك فكوكاً (خاصة للحشرات))",
 "mandibulofacial": "فكي وجهي (متعلق بالفك السفلي والوجه)",
 "mandioc": "بفرة, كسافا مرة (كسافا ذات جذور درنية طويلة صالحة للأكل وسيقان هشة ناعمة؛ تستخدم خاصة لصنع الكاسيري (مشروب مسكر) والتابيوكا)",
 "mandioca": "بفرة, كسافا مرة (كسافا ذات جذور درنية طويلة صالحة للأكل وسيقان هشة ناعمة؛ تستخدم خاصة لصنع الكاسيري (مشروب مسكر) والتابيوكا)",
 "mandola": "ماندولا (نوع قديم من الماندولين)",
 "mandolin": "ماندولين (آلة وترية مرتبطة بالعود، تُعزف عادة بريشة)",
 "mandopop": "مَانْدُوبُوب",
 "mandragora officinarum": "تفاح المجانين, يبروح (نبات في جنوب أوروبا وشمال أفريقيا له أزهار أرجوانية وثمار صفراء وجذر متشعب كان يُعتقد سابقاً أن له قوى سحرية)",
 "mandrake": "يَبْرُوح, لُفَّاح",
 "mandrake root": "جذر اللفاح (جذر نبات اللفاح؛ يستخدم طبياً أو كمخدر)",
 "mandrel": "عمود دوران, مغزل (أي من الأعمدة الدوارة المختلفة التي تعمل كمحاور لأجزاء دوارة أكبر)",
 "mandril": "عمود دوران, مغزل (أي من الأعمدة الدوارة المختلفة التي تعمل كمحاور لأجزاء دوارة أكبر)",
 "mandrill": "مندريل (رباح يعيش في غرب أفريقيا ذو خطم أحمر وأزرق ساطع ومؤخرة زرقاء)",
 "mandrillus leucophaeus": "دريل (يشبه المندريل ولكنه أصغر وأقل زهواً في الألوان)",
 "mandrillus sphinx": "مندريل (رباح يعيش في غرب أفريقيا ذو خطم أحمر وأزرق ساطع ومؤخرة زرقاء)",
 "manduca quinquemaculata": "دودة الطماطم القرنية (عثة يرقاتها هي ديدان الطماطم القرنية) / دودة الطماطم القرنية (يرقة عثة صقرية خضراء كبيرة مخططة بالأبيض تتغذى على نباتات الطماطم والبطاطس)",
 "manduca sexta": "دودة التبغ القرنية (عثة يرقاتها هي ديدان التبغ القرنية) / دودة التبغ القرنية (يرقة عثة صقرية خضراء كبيرة مخططة بالأبيض تتغذى على التبغ والنباتات ذات الصلة)",
 "manduction": "مضغ (عض وطحن الطعام في فمك ليصبح ناعماً بما يكفي للبلع) / تناول, قربان مقدس (فعل المشاركة في الاحتفال بالقربان المقدس (الإفخارستيا))\nمثال: تناول الحاكم القربان المقدس مع بقية الرعية",
 "mane": "عُرْف, لِبْدَة (عَلِمَ؛ سَكَنَ إلى الشيءِ، أَنَسَهُ وأَلِفَه)\nمثال: من عرف نفسه فقد عرف ربه.",
 "maned sheep": "كبش بربري, وداد (خروف بري يعيش في شمال أفريقيا)",
 "maned wolf": "ذئب أحمر (ذئب رمادي محمر من جنوب غرب أمريكا الشمالية)",
 "maneuver": "مُنَاوَرَة, تَدْرِيب عَسْكَرِيّ",
 "maneuverability": "قُدْرَة عَلَى المُنَاوَرَة (صفة القابلية للمناورة)",
 "maneuverable": "قَابِلٌ لِلْمُنَاوَرَة (يُمْكِنُ تَوْجِيهُهُ وَتَغْيِيرُ وَضْعِه)",
 "maneuverer": "مراوغ, مُناور (شخص ماهر في المناورة)",
 "manful": "رجولي (يمتلك صفات تليق بالرجل) / رَجُولِيّ, فُحُولِيّ (من سمات الرجل وصفاته)",
 "manfully": "برجولة, بشجاعة (بطريقة رجولية؛ بصفات يُعتقد أنها تليق بالرجل)\nمثال: بعد أن قالت كلمتها، حملت بيغي عبئها برجولة واستعدت لتفكيك منزل آخر",
 "manfulness": "رجولة, فحولة (سمة كون المرء رجلاً؛ امتلاك خصائص الذكر البالغ)",
 "manga": "مَانْغَا, مَنْجَا",
 "mangabey": "منجبي (قرد شجري كبير رشيق ذو أطراف وذيل طويل وجفون علوية بيضاء)",
 "mangal": "مَنْقَل, مِنْقَل",
 "mangaluru": "مَانْغَلُور",
 "manganate": "منغنات (ملح لحمض المنغنيك يحتوي على المنغنيز كأنيون)",
 "manganese": "مَنْغَنِيز, مَنْجَنِيز",
 "manganese bronze": "برونز منغنيزي, نحاس أصفر منغنيزي (نحاس أصفر يحتوي على 1-4% منغنيز لزيادة صلابته)",
 "manganese steel": "فولاذ منغنيزي, فولاذ منغنيزي أوستنيتي (فولاذ ذو مكون كبير نسبياً (10-14%) من المنغنيز؛ مقاوم للغاية للتآكل والصدمات)",
 "manganese tetroxide": "رابع أكسيد المنغنيز (أكسيد للمنغنيز يوجد بشكل طبيعي كمعدن الهوسمانيت)",
 "manganic acid": "حمض المنغنيك (أصبح حامضًا، تغير الطعم إلى الحموضة؛ ارتفعت نسبة الحموضة في شيء ما، كما في الطعام أو السوائل)\nمثال: رمى ياني الحمض على وجه سكورة.",
 "manganite": "منغنيت (معدن أسود يتكون من أكسيد المنغنيز الأساسي؛ مصدر للمنغنيز)",
 "mange": "جَرَب (أَصابَهُ الجَرَب؛ السَّيْفُ: صَدِئَ)\nمثال: جرب هذا الكسكس.",
 "mangel-wurzel": "شمندر علفي (يزرع كعلف للماشية) / بنجر العلف, شمندر العلف (شمندر بجذر مصفر كبير؛ يزرع بشكل رئيسي كعلف للماشية)",
 "manger": "مذود, معلف (حاوية (عادة في الحظيرة أو الإسطبل) تتغذى منها الماشية أو الخيول)",
 "mangey": "أَجْرَب, رَثّ (فِيهِ بُقَعٌ كَثِيرَةٌ بَالِيَةٌ أَوْ مَسْحُوقَةُ الوَبَرِ)",
 "mangifera indica": "أنبج, شجرة المانجو (شجرة استوائية كبيرة دائمة الخضرة تزرع لفاكهتها البيضاوية الكبيرة)",
 "mangily": "بجرب, بقذارة (بطريقة قذرة أو جرباء)",
 "manginess": "بُؤْس, حَقَارَة (انعدام الأناقة نتيجة ارتداء ملابس بالية أو قذرة)",
 "mangle": "آلة كي, معصرة غسيل (مجفف ملابس لتجفيف وكي الغسيل بتمريره بين أسطوانتين ساخنتين ثقيلتين)",
 "mangled": "مُمَزَّق, مُهَتَّك (ذو حواف خشنة ممزقة من أثر الإصابة)",
 "mangler": "مُشَوِّه, مُنَكِّل (شخص يشوه أو يدمر أو يغير المعالم أو يسبب عجزاً)",
 "manglietia": "مانغليتيا (جنس من الأشجار المزهرة من الفصيلة الماغنولية يوجد من الملايو إلى جنوب الصين)",
 "mango": "مَنْجُو, مَنْجَا",
 "mango tree": "أنبج, شجرة المانجو (شجرة استوائية كبيرة دائمة الخضرة تزرع لفاكهتها البيضاوية الكبيرة)",
 "mangold": "بنجر العلف, شمندر العلف (شمندر بجذر مصفر كبير؛ يزرع بشكل رئيسي كعلف للماشية)",
 "mangold-wurzel": "بنجر العلف, شمندر العلف (شمندر بجذر مصفر كبير؛ يزرع بشكل رئيسي كعلف للماشية)",
 "mangonel": "منجنيق الجر, منجنيق يدوي (منجنيق يعمل بقوة بشرية تسحب الحبال المتصلة برافعة ومقلاع لإطلاق القذائف)",
 "mangosteen": "مَانْغُوسْتِين / مَانْجُوسْتِين / جَوْز جَنْدَم (جَوَّز لَهُمْ إِبِلَهم إِذا قَادَهَا بَعِيرًا بَعِيرًا حَتَّى تَجُوزَ)\nمثال: نريد أن نأكل نبات جوز الهند.",
 "mangosteen tree": "شجرة المانغوستين, مانغوستين (شجرة من جزر الهند الشرقية ذات أوراق جلدية سميكة وفاكهة صالحة للأكل)",
 "mangrove": "المنغروف",
 "mangrove snapper": "نهاش رمادي (يوجد في المياه الضحلة قبالة ساحل فلوريدا)",
 "mangy": "أَجْرَب ((أَجْرَبَ): جَرِبَت إبِلُه)\nمثال: أريد أن أجرب ذلك.",
 "manhattan": "مانهاتن (كوكتيل مصنوع من الويسكي والفيرموث الحلو مع قليل من البيترز)",
 "manhattan clam chowder": "تشاودر محار مانهاتن (تشاودر مصنوع من المحار والطماطم وخضروات أخرى وتوابل)",
 "manhattan project": "مشروع مانهاتن (وكالة تنفيذية أمريكية سابقة كانت مسؤولة عن تطوير القنابل الذرية خلال الحرب العالمية الثانية)",
 "manhole": "فتحة صيانة, منهول (ثقب (عادة بغطاء مستو) يمكن للشخص من خلاله الوصول إلى هيكل تحت الأرض)",
 "manhole cover": "غطاء البالوعة (غطاء حديدي مسطح لفتحة الصيانة (كما في الشارع))",
 "manhood": "رُجُولَة, رُجْلَة (الاسم من الرجل، حالة كون الرجل رجلا؛ مجموعة الصفات الحسنة في الرجال كالشهامة والشجاعة والكرم والجود وغيرها)",
 "manhunt": "بحث منظم, مطارده (بحث منظم (من قبل الشرطة) عن شخص (متهم بجريمة))",
 "mani": "مَانِي",
 "mania": "شغف جنوني, هوس (دافع غير عقلاني ولكنه لا يُقاوم لمعتقد أو فعل ما) / اضطراب الهوس, هوس (اضطراب مزاجي؛ اضطراب وجداني يميل فيه المصاب إلى الاستجابة بشكل مفرط وعنيف أحياناً)",
 "maniac": "مَهْوُوس, مَهْوُوسَة",
 "maniacal": "هَائِج, هَوَسِيّ (مضطرب بشكل عنيف وجامح)",
 "maniacally": "بجنون, بهوس (بطريقة جنونية أو لدرجة الهوس)\nمثال: كان مهووساً بجنون بالغيرة",
 "manic": "مَسْعُور, هَوَسِيّ (مُصَابٌ بِالهَيَجَانِ أَوِ الهَوَسِ غَيْرِ المُنْضَبِطِ بِالعَقْل)",
 "manic depression": "اضطراب ثنائي القطب, الهوس الاكتئابي (اضطراب عقلي يتميز بنوبات من الهوس والاكتئاب)",
 "manic depressive illness": "اضطراب ثنائي القطب, الهوس الاكتئابي (اضطراب عقلي يتميز بنوبات من الهوس والاكتئاب)",
 "manic disorder": "اضطراب الهوس, هوس (اضطراب مزاجي؛ اضطراب وجداني يميل فيه المصاب إلى الاستجابة بشكل مفرط وعنيف أحياناً)",
 "manic-depressive": "هَوَسِيٌّ اكْتِئَابِيّ (مصاب باضطراب يتناوب فيه الهوس والاكتئاب) / مُصاب بِالهَوَس الاِكْتِئابِيّ (شخص مصاب بمرض الهوس الاكتئابي (الاضطراب ثنائي القطب))",
 "manic-depressive psychosis": "اضطراب ثنائي القطب, الهوس الاكتئابي (اضطراب عقلي يتميز بنوبات من الهوس والاكتئاب)",
 "manichaean": "مانوي (مكون من أو متعلق بالمانوية) / ثنوي, مانوي (من أو يتعلق بمذهب الثنوية الفلسفي) / مانَوِيّ (معتنق للمانوية)\nمثال: صراع مانوي بين الخير والشر",
 "manichaeanism": "مانوية (دين أسسه ماني في القرن الثالث؛ توليفة من الثنوية الزرادشتية بين النور والظلام والفولكلور البابلي والأخلاق البوذية وعناصر سطحية من المسيحية؛ انتشرت…)",
 "manichaeism": "مَانَوِيَّة",
 "manichean": "مانوي (مكون من أو متعلق بالمانوية) / مانَوِيّ (معتنق للمانوية)",
 "manichee": "مانوي (مكون من أو متعلق بالمانوية) / مانَوِيّ (معتنق للمانوية)",
 "maniclike": "شَبِيهٌ بِالهَوَس (يشبه حالة الهوس في الاضطراب ثنائي القطب)",
 "manicotti": "مانيكوتي (أنابيب مكرونة كبيرة محشوة باللحم المفروم أو الجبن الخفيف وتخبز في صلصة الطماطم)",
 "manicure": "مَانِيكِير, تَجْمِيل الْيَدَيْن",
 "manicure set": "طقم تقليم الأظافر (مجموعة من الأدوات المستخدمة لتقليم الأظافر)",
 "manicurist": "أخصائي تقليم الأظافر, مانيكير (أخصائي تجميل ينظف ويقلم ويلمع أظافر اليدين)",
 "manifest": "ظَاهِر (اسم فاعل من ظَهَرَ هو الذي يَظْهَر على عدوه؛ ضد الباطن) / بَيَان (ما يتبيَّن به الشيء من الدلالة والفصاحة وغيرها، وقيل هو الإفصاح مع ذكاء؛ كل شيء كُشف لك وبان عليك، وقيل هو الكشف والتوضيح بمعنى الإثبات بالدليل) / تَظَاهَرَ (فعل مطاوعة لظَاهَرَ، ظاهرته فتظاهر، يكون بمعنى تعاون فكان كل طرف كظهر الآخر؛ القوم: ولّى كل منهم ظهره للآخر)\nمثال: كل شئ ظاهر على وجهه.",
 "manifest destiny": "القدر المتجلي (سياسة إمبريالية تُبرر على أنها حتمية (كما لو كانت ممنوحة من الله))",
 "manifestation": "مُظَاهَرَة (عرض عام للمشاعر الجماعية (عادة ذات طابع سياسي)) / تجلي, مظهر (دلالة واضحة لوجود أو حضور أو طبيعة شخص أو شيء ما) / انعكاس, تعبير (تعبير بدون كلمات) / تجسد, تجلي (ظهور في شكل جسدي (كما في الروح غير المتجسدة))\nمثال: كانت هناك مظاهرات عنيفة ضد الحرب",
 "manifestly": "بوضوح, جلياً (بشكل لا لبس فيه)\nمثال: الإجابة خاطئة بوضوح",
 "manifesto": "بَيَان (ما يتبيَّن به الشيء من الدلالة والفصاحة وغيرها، وقيل هو الإفصاح مع ذكاء؛ كل شيء كُشف لك وبان عليك، وقيل هو الكشف والتوضيح بمعنى الإثبات بالدليل)\nمثال: وأوضح البيان ذاته، أن الوزارة وجهت تعليمات من أجل تسخير كافة الإمكانيات البشرية والمادية للتسريع من وتيرة سير العملية.",
 "manifold": "مُتَنَوِّع",
 "manifold paper": "ورق رقيق, ورق نسخ (ورق خفيف الوزن يستخدم مع ورق الكربون لعمل نسخ متعددة)\nمثال: أصل ونسختين",
 "manihot dulcis": "كسافا حلوة (نبات أمريكي جنوبي ذو جذور تستخدم كخضروات وأعشاب تستخدم كعلف للماشية)",
 "manihot esculenta": "بفرة, كسافا مرة (كسافا ذات جذور درنية طويلة صالحة للأكل وسيقان هشة ناعمة؛ تستخدم خاصة لصنع الكاسيري (مشروب مسكر) والتابيوكا)",
 "manihot utilissima": "بفرة, كسافا مرة (كسافا ذات جذور درنية طويلة صالحة للأكل وسيقان هشة ناعمة؛ تستخدم خاصة لصنع الكاسيري (مشروب مسكر) والتابيوكا)",
 "manikin": "دمية عرض, مانيكان (دمية بالحجم الطبيعي تستخدم لعرض الملابس) / عارضة أزياء (امرأة ترتدي الملابس لعرض الأزياء) / رجل ضئيل, قزم (شخص صغير جداً ولكنه ليس مشوهاً أو غير طبيعي من نواحٍ أخرى)\nمثال: كانت بدينة جداً لدرجة أنها لا تصلح كعارضة أزياء",
 "manila": "مَانِيلَا",
 "manila bean": "فاصوليا مجنحة, فول غوا (كرمة حولية درنية ملتفة تحمل عناقيد من الزهور الأرجوانية وقروناً بأربعة أجنحة مسننة؛ المناطق الاستوائية في العالم القديم)",
 "manila grass": "عشبة السجاد اليابانية, عشبة مانيلا (عشبة مروج شائعة في الفلبين؛ تزرع أيضاً في الولايات المتحدة)",
 "manila hemp": "أباكا, قنب مانيلا (شجرة موز فلبينية تنتج أعناق أوراقها قنب مانيلا المستخدم للحبال والورق وما إلى ذلك) / أباكا, قنب مانيلا (نوع من القنب يُحصل عليه من نبات الأباكا في الفلبين)",
 "manila maguey": "كانتالا, ماغي سيبو (ألياف صلبة تستخدم في صنع الخيوط الخشنة؛ من نباتات الأغاف الفلبينية)",
 "manila paper": "ورق مانيلا (ورق قوي أو ورق مقوى رقيق بلمسة نهائية بنية فاتحة ناعمة مصنوع من قنب مانيلا مثلاً)",
 "manila tamarind": "تمرهندي مانيلا, كاماشيل (شجرة استوائية أمريكية شائكة شائعة ذات عناقيد طرفية من الزهور الصفراء تليها قرون صالحة للأكل منجلية أو دائرية وتنتج خشباً جيداً وصبغة صفراء وصمغاً…)",
 "manilkara bidentata": "بالاتا, شجرة البالاتا (شجرة خشب صلب استوائية تنتج صمغ البالاتا وخشباً أحمر ثقيلاً)",
 "manilkara zapota": "سبوتة, شجرة السبوتة (شجرة استوائية أمريكية كبيرة دائمة الخضرة تنتج صمغ الشيكل وفاكهة صالحة للأكل)",
 "manilla": "ورق مانيلا (ورق قوي أو ورق مقوى رقيق بلمسة نهائية بنية فاتحة ناعمة مصنوع من قنب مانيلا مثلاً)",
 "manilla hemp": "أباكا, قنب مانيلا (نوع من القنب يُحصل عليه من نبات الأباكا في الفلبين)",
 "manilla paper": "ورق مانيلا (ورق قوي أو ورق مقوى رقيق بلمسة نهائية بنية فاتحة ناعمة مصنوع من قنب مانيلا مثلاً)",
 "manioc": "بفرة, كسافا مرة (كسافا ذات جذور درنية طويلة صالحة للأكل وسيقان هشة ناعمة؛ تستخدم خاصة لصنع الكاسيري (مشروب مسكر) والتابيوكا) / كاسافا, مانيوك (جذر الكاسافا يؤكل كغذاء أساسي بعد التجفيف والنقع؛ مصدر للتابيوكا) / بفرة, كسافا (نشا يُصنع عن طريق نقع وتجفيف جذر نبات الكسافا؛ مصدر التابيوكا؛ غذاء أساسي في المناطق الاستوائية)",
 "manioca": "بفرة, كسافا (نشا يُصنع عن طريق نقع وتجفيف جذر نبات الكسافا؛ مصدر التابيوكا؛ غذاء أساسي في المناطق الاستوائية)",
 "manipulability": "قَابِلِيَّة التَّنَاوُل, قَابِلِيَّة المُعَالَجَة اليَدَوِيَّة (صفة القابلية للتحكم بها عبر حركات اليد الماهرة)",
 "manipulable": "سهل الانقياد, طَيِّع (سهل الإدارة (التحكم أو التعليم أو التشكيل))\nمثال: عقول شابة طيعة",
 "manipulation": "تَلَاعُب, تَعْدِيل",
 "manipulative": "مُتَلَاعِب, مُسْتَغِلّ (بارع في التأثير على الآخرين والتحكّم بهم لصالحه)",
 "manipulative electronic deception": "خداع إلكتروني تلاعبي (إجراءات للقضاء على المؤشرات الكاشفة التي يمكن أن يستخدمها العدو (أو لنقل مؤشرات مضللة))",
 "manipulatively": "بتلاعب (بطريقة تلاعبية ماكرة)",
 "manipulativeness": "تلاعب (صفة استخدام التلاعب بشكل هادف، أو الميل للتلاعب بالآخرين)",
 "manipulator": "مُعَالِج يَدَوِيّ, مُنَاوِل (شخص يعالج الأشياء أو يتعامل معها يدوياً) / عامل تشغيل, مُشَغِّل (وكيل يقوم بتشغيل جهاز أو آلة)\nمثال: مشغل لوحة المفاتيح",
 "manipur": "مَانِيبُور",
 "maniraptor": "مانيرابتور (ثيروبود لاحم متطور؛ يُعتبر أنه بقي حياً اليوم متمثلاً في الطيور الحية)",
 "manitoba": "مَانِيتُوبَا",
 "mankind": "بَشَرِيَّة, الْجِنْس الْبَشَرِيّ",
 "manky": "حَقِير, رَدِيء (دُونِيٌّ وَعَدِيمُ القِيمَة)",
 "manlike": "شَبِيه بِالإِنْسَان (يُشبه البشر في الشكل أو الصفات) / رجولي (يمتلك صفات تليق بالرجل) / رَجُولِيّ, فُحُولِيّ (من سمات الرجل وصفاته)",
 "manliness": "رجولة, فحولة (سمة كون المرء رجلاً؛ امتلاك خصائص الذكر البالغ)",
 "manly": "رُجُولِيّ",
 "manna": "مَنّ (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "manna ash": "المَنّ الرَمَاد",
 "manna from heaven": "رزق ساقه الله, رواج (حدث مفاجئ يجلب الحظ السعيد (مثل فرصة مفاجئة لكسب المال)) / المن, المن والسلوى ((في العهد القديم) الطعام الذي أعطاه الله لبني إسرائيل أثناء الخروج)\nمثال: خلق الطلب على الاختبار طفرة لتلك المختبرات غير الخاضعة للتنظيم",
 "manna grass": "عشبة المن, عشبة حلوة (أي من عدة أعشاب محبة للرطوبة من جنس جليسيريا ذات نكهة أو رائحة حلوة)",
 "manna gum": "صمغ المن (شجرة طويلة تنتج مناً كاذباً)",
 "manna lichen": "أشنة المن (أي من عدة أنواع من الليكانورا في العالم القديم قشرية جزئياً أو شجيرية تلتف وتتطاير فوق الصحاري الأفريقية والعربية ويستخدمها الناس والحيوانات كغذاء)",
 "manned": "مأهول (لديه طاقم)\nمثال: اعتبر القمر الصناعي الأرضي المأهول خطوة بحثية ضرورية",
 "mannequin": "مِثَالَة / مَانِيكَان / مَانُوكَان",
 "manner": "أُسْلُوب, طَرِيقَة (الطَرِيْق والفنّ من القول؛ الطريقة بصورة عامة سواء كانت من القول أو الفعل أو الفكر)\nمثال: هو يحب أسلوب معطوب.",
 "manner adverbial": "ظرف حال, ظرف هيئة (عبارة ظرفية تصف كيفية تنفيذ الفعل)",
 "manner name": "اسم الهيئة (كلمة تدل على طريقة فعل شيء ما)",
 "manner of speaking": "إلقاء, طريقة التحدث (أسلوبك أو طريقتك المميزة في التعبير عن نفسك شفهياً)\nمثال: كانت طريقته في الكلام فظة للغاية",
 "manner of walking": "مشية (طريقة المشي)\nمثال: كان لديه مشية مضحكة",
 "mannered": "مُتَصَنِّع السُّلُوك (ذو سلوكيات غير طبيعية ومتكلّفة)",
 "mannerism": "تصنع, تكلف (تظاهر متعمد أو عرض مبالغ فيه) / خصوصية, سمة شخصية غريبة (سمة سلوكية مميزة وخاصة بالفرد) / تكلف, مانييريزم (أسلوب فني في أواخر القرن السادس عشر في أوروبا يتميز بالتنافر المكاني والاستطالة المفرطة للشخصيات البشرية)\nمثال: يفضل المانييريزم التوتر التركيبي وعدم الاستقرار بدلاً من التوازن والوضوح في رسم عصر النهضة المبكر",
 "mannerly": "حَسَنُ الأَخْلَاقِ, مُؤَدَّب (صحيح السلوك اجتماعياً)",
 "manners": "آداب, أخلاق (السلوك الاجتماعي)\nمثال: أخلاقه أخلاق خنازير",
 "mannikin": "دمية عرض, مانيكان (دمية بالحجم الطبيعي تستخدم لعرض الملابس) / عارضة أزياء (امرأة ترتدي الملابس لعرض الأزياء) / رجل ضئيل, قزم (شخص صغير جداً ولكنه ليس مشوهاً أو غير طبيعي من نواحٍ أخرى)\nمثال: كانت بدينة جداً لدرجة أنها لا تصلح كعارضة أزياء",
 "mannish": "رِجَالِيّ (من خصائص الرجل بما يميّزه عن المرأة) / مُسْتَرْجِل (يشبه أو يُقلِّد أو يوحي بالرجل أكثر من المرأة)",
 "mannitol": "مانيتول (مدر للبول (الاسم التجاري أوزميترول) يستخدم لتعزيز إخراج البول)",
 "manoah": "مَنُوح",
 "manoeuvrability": "قُدْرَة عَلَى المُنَاوَرَة (صفة القابلية للمناورة)",
 "manoeuvrable": "قَابِلٌ لِلْمُنَاوَرَة (يُمْكِنُ تَوْجِيهُهُ وَتَغْيِيرُ وَضْعِه)",
 "manoeuvre": "مناورة (إجراء يهدف إلى مراوغة الخصم) / مناورة (خطوة تُتخذ لتحقيق غاية تكتيكية) / لعبة, مناورة (حركة منسقة متعمدة تتطلب البراعة والمهارة) / مناورة (تدريب عسكري)\nمثال: قام بمناورة رائعة",
