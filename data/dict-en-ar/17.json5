 "maximum": "أعظمي, أقصى (الأعظم أو الأكثر اكتمالاً أو الأفضل الممكن) / أقصى, غاية (أقصى درجة ممكنة) / حد أقصى, نهاية عظمى (النقطة على المنحنى حيث يتغير المماس من موجب على اليسار إلى سالب على اليمين) / حد أقصى, ذروة (أكبر كمية ممكنة)\nمثال: توسع أقصى",
 "maximum and minimum thermometer": "مقياس الحرارة العظمى والصغرى (مقياس حرارة يسجل أعلى وأدنى درجات حرارة تم الوصول إليها خلال فترة زمنية)",
 "maxwell": "ماكسويل (وحدة في نظام سنتيمتر-غرام-ثانية للتدفق المغناطيسي تساوي التدفق العمودي على مساحة 1 سنتيمتر مربع في مجال مغناطيسي قدره 1 غاوس)",
 "maxwell's equations": "معادلات ماكسويل (أربع معادلات تفاضلية تلخص الخصائص الكلاسيكية للمجالات الكهرومغناطيسية)",
 "maxwell-boltzmann distribution law": "توزيع ماكسويل-بولتزمان ((فيزياء) قانون يعبر عن توزيع الطاقة بين جزيئات الغاز في حالة التوازن الحراري)",
 "maxzide": "ماكسزايد (اسم تجاري لدواء خافض لضغط الدم يحتوي على هيدروكلوروثيازيد ومدر للبول آخر)",
 "may": "اِسْتَطَاعَ (أَطَاقَ الشَّيءَ وقَدَرَ عليه، أَمْكَنَهُ الشَّيءُ)\nمثال: توم استطاع ان يهرب",
 "may 1": "أول مايو, عيد العمال (يُحتفل به في العديد من البلدان للاحتفال بقدوم الصيف؛ يُحتفل به في روسيا والدول ذات الصلة تكريماً للعمال)",
 "may 24": "24 مايو, يوم الكومنولث (بريطاني، ذكرى ميلاد الملكة فيكتوريا)",
 "may apple": "تفاح مايو, يبروح بري (عشب من أمريكا الشمالية ذو ساق جذري سام وثمرة صالحة للأكل رغم طعمها غير المستساغ) / تفاح مايو (فاكهة صالحة للأكل ولكنها عديمة الطعم لنبات تفاح مايو)",
 "may beetle": "خنفساء مايو, خنفساء يونيو (أي من خنافس كبيرة بنية عادة في أمريكا الشمالية تأكل الأوراق وشائعة في أواخر الربيع؛ تتغذى اليرقات على جذور الأعشاب وما إلى ذلك) / خنفساء أيار, دودة بيضاء (أي من الخنافس الأوروبية الكبيرة المتنوعة المدمرة للنباتات كيرقات وبالغين)",
 "may blob": "آذريون المستنقع, قطيفة المستنقع (نبات مستنقعات من أوروبا وأمريكا الشمالية ذو أزهار صفراء زاهية تشبه الحوذان)",
 "may bug": "خنفساء مايو, خنفساء يونيو (أي من خنافس كبيرة بنية عادة في أمريكا الشمالية تأكل الأوراق وشائعة في أواخر الربيع؛ تتغذى اليرقات على جذور الأعشاب وما إلى ذلك) / خنفساء أيار, دودة بيضاء (أي من الخنافس الأوروبية الكبيرة المتنوعة المدمرة للنباتات كيرقات وبالغين)",
 "may day": "يَوْم العُمَّال العَالَمِيّ, يَوْم العُمَّال (فترة من الزمان تبدأ عند غُرُوب الشمس وتنتهي عند غُرُوب شمس النهار التالي ويشمل اللَيْلَة ونَهَارا. طوله أربع وعشرين سَاعَة؛ النَهَار، يبدأ من طلوع الفَجْر إلى غُرُوب الشَمس، على المجاز)\nمثال: طقس اليوم جميل.",
 "may fish": "سمكة كيلي المخططة, سمكة مايو (سمكة مخططة بالأسود تعيش في الخلجان والمستنقعات الساحلية للمحيط الأطلسي وساحل الخليج في الولايات المتحدة)",
 "may lily": "زنبق الوادي, كونفالاريا (نبات معمر منخفض النمو له عادة ورقتان كبيرتان مستطيلتان سنانيتان وعنقود من الزهور الصغيرة العطرة المتدلية على شكل جرس تليها توت قرمزي)",
 "may queen": "ملكة مايو (الفتاة المختارة كملكة لمهرجان يوم مايو)",
 "may wine": "نبيذ مايو (نَبِيذ (صفة مفردة مذكرة، مؤنثها نَبِيْذَة، وجمعها السالم نَبِيْذُوْن، وجمعها المؤنث السالم نَبِيْذَات، وجمعها المكسر أَنْبِذَة)؛ نَبِيذ (لا يؤنث، وجمعه أَنْبِذَة))\nمثال: أنا شربت النبيذ.",
 "maya": "مَايَا",
 "mayan": "المايا, لغات المايا (عائلة من لغات الهنود الحمر يتحدث بها شعب المايا) / مايا, ماياني (فرد من شعب هندي أمريكي في يوكاتان وبليز وغواتيمالا، كان لديهم حضارة تميزت بالهندسة المعمارية والفخار والفلك)\nمثال: كان لدى المايا نظام للكتابة وتقويم دقيق",
 "mayan language": "المايا, لغات المايا (عائلة من لغات الهنود الحمر يتحدث بها شعب المايا)",
 "mayapple": "تفاح مايو, يبروح بري (عشب من أمريكا الشمالية ذو ساق جذري سام وثمرة صالحة للأكل رغم طعمها غير المستساغ)",
 "maybe": "رُبَّمَا, مِن اَلْمُمْكِن",
 "mayday": "ماي داي, نداء استغاثة لاسلكي (إشارة استغاثة معترف بها دولياً عبر الهاتف اللاسلكي)",
 "mayeng": "تيروسبيرموم, ماينج (شجرة هندية ذات أزهار بيضاء ليلية عطرة وتنتج خشباً محمراً يستخدم للألواح؛ تزرع غالباً كزينة أو شجرة ظل)",
 "mayetiola destructor": "ذبابة هسيان (ذبابة صغيرة تتلف يرقاتها القمح والحبوب الأخرى)",
 "mayfish": "سمكة كيلي المخططة, سمكة مايو (سمكة مخططة بالأسود تعيش في الخلجان والمستنقعات الساحلية للمحيط الأطلسي وساحل الخليج في الولايات المتحدة)",
 "mayflower": "زهرة مايو, قطلب زاحف (شجيرة دائمة الخضرة منخفضة النمو من شرق أمريكا الشمالية ذات أوراق جلدية وعناقيد من الزهور العطرية الوردية أو البيضاء)",
 "mayfly": "ذُبَابَة مَايُو, ذُبَاب مَايُو (حشرة صغيرة سوداء اللون معروفة)\nمثال: أمسك بتلك الذبابة.",
 "mayhap": "رُبَّمَا, لَعَلَّ (عن طريق الصدفة (أو الاحتمال))\nمثال: ربما ستتصل غداً",
 "mayhaw": "زعرور صيفي, زعرور مايو (زعرور من جنوب الولايات المتحدة يحمل ثمرة قرمزية عصيرية حمضية تستخدم غالباً في الهلام أو المربيات)",
 "mayhem": "خراب, فوضى عارمة (اضطراب عنيف وغير ضروري) / إحداث عاهة, تشويه متعمد (الإعاقة المتعمدة وغير القانونية أو التشويه لشخص آخر)",
 "mayidism": "بلاغرا (مرض ناتج عن نقص النياسين أو التريبتوفان (أو عن خلل في التحويل الأيضي للتريبتوفان إلى نياسين)؛ يتميز باضطرابات الجهاز الهضمي والحمامي واضطرابات عصبية…)",
 "maykop": "مَايْكُوب",
 "mayo": "مايونيز (صفار بيض وزيت وخل)",
 "mayonnaise": "مَايُونِيز",
 "mayor": "عُمْدَة",
 "mayoral": "بلدي, عمدي (من أو متعلق بالعمدة أو منصب العمدة)\nمثال: انتخابات منصب العمدة",
 "mayoralty": "عمودية, منصب العمدة (منصب العمدة أو رئيس البلدية)",
 "mayoress": "عمدة (امرأة تشغل منصب العمدة) / زوجة العمدة (زوجة العمدة)",
 "mayotte": "مَايُوت",
 "maypole": "عَمُود الرَّقْص",
 "maypop": "مايبوب (من جنوب الولايات المتحدة؛ لها ثمرة توت عديمة الطعم بحجم بيضة الدجاجة)",
 "maysan": "مَيْسَان",
 "mayweed": "أقحوان نتن, شمر الكلاب (عشبة ضارة واسعة الانتشار كريهة الرائحة ذات رؤوس زهور بيضاء الأشعة بأقراص صفراء)",
 "mazandaran": "مَازَنْدَرَان",
 "mazdaism": "زرادشتية, مازداوية (نظام ديني أسسه زرادشت في بلاد فارس في القرن السادس قبل الميلاد؛ مبين في الأبستاق؛ قائم على مفهوم الصراع بين النور (الخير) والظلام (الشر))",
 "maze": "مَتَاهَة",
 "mazed": "تَائِه, مَذْهُول (في حيرة شديدة بسبب كثرة التناقضات؛ مرتبك ومشوّش الذهن)",
 "mazel tov": "مَازَل تُوف",
 "mazer": "وعاء خشبي (وعاء شرب كبير من الخشب الصلب)",
 "mazopathy": "اعتلال الثدي (أي حالة مرضية تصيب الثدي)",
 "mazurka": "مازوركا (رقصة وطنية بولندية بإيقاع ثلاثي) / مازوركا (موسيقى مؤلفة لرقص المازوركا)",
 "mazut": "مازوت",
 "mazy": "مُتَاهِيّ, مُتَعَرِّج (يُشْبِه المَتَاهَة فِي الشَّكْل أَوِ التَّعْقِيد)",
 "mazzard": "كرز مازارد (كرز حلو بري أو شتلات تستخدم كأصل للتطعيم)",
 "mazzard cherry": "كرز مازارد (كرز حلو بري أو شتلات تستخدم كأصل للتطعيم)",
 "mb": "بكالوريوس الطب ((درجة بريطانية) درجة البكالوريوس في الطب) / ميبي بايت, ميغابايت (وحدة معلومات تساوي 1024 كيبي بايت أو 2 أس 20 (1,048,576) بايت) / ميغابايت (وحدة معلومات تساوي 1000 كيلوبايت أو 10 أس 6 (1,000,000) بايت) / ميغابت (وحدة معلومات تساوي 1000 كيلوبت أو 10 أس 6 (1,000,000) بت)",
 "mba": "ماجستير في إدارة الأعمال (درجة الماجستير في الأعمال)",
 "mbabane": "مْبَابَانِي",
 "mbd": "اضطراب فرط الحركة ونقص الانتباه, اضطراب نقص الانتباه (حالة (تغلب عند الأولاد) تتميز باضطرابات سلوكية وصعوبات في التعلم)",
 "mbit": "ميغابت (وحدة معلومات تساوي 1000 كيلوبت أو 10 أس 6 (1,000,000) بت)",
 "mbundu": "مبوندو (مجموعة عرقية تتحدث لغة أومبوندو وتعيش في غرب أنغولا)",
 "mc": "عريف الحفل, مذيع الربط (شخص يعمل كمضيف في المناسبات الرسمية (يلقي خطابات تمهيدية ويقدم المتحدثين الآخرين)) / مِيجَاهَرْتز (مليون دورة في الثانية)",
 "mcardle's disease": "مرض مكاردل (مرض وراثي تتراكم فيه كميات غير طبيعية من الجليكوجين في العضلات الهيكلية)",
 "mcburney's point": "نقطة ماكبيرني (نقطة تقع في ثلث المسافة على طول خط مرسوم من الورك إلى السرة؛ وهي نقطة الحساسية القصوى في حالات التهاب الزائدة الدودية الحاد)",
 "mccarthyism": "مكارثية (اتهام الناس بعدم الولاء بشكل عديم الضمير (كما بقول أنهم شيوعيون))",
 "mcdonald's": "مَاكْدُونَالْدْز",
 "mcg": "ميكروغرام (واحد من المليون من الغرام)",
 "mcguffey eclectic readers": "كتب ماكغافي للقراءة (كتب قراءة جمعت بين دروس القراءة والرسائل الأخلاقية)",
 "mcguffin": "ماكغافن ((في السينما) عنصر في الحبكة يجذب انتباه المشاهدين أو يدفع الحبكة للأمام)\nمثال: كان الماكغافن عنصرًا رئيسيًا في أفلام ألفريد هيتشكوك",
 "mcia": "نشاط استخبارات مشاة البحرية (وكالة تابعة لمشاة البحرية الأمريكية تقدم دعمًا استخباراتيًا واسعًا ومستجيبًا لمنظمة مشاة البحرية العالمية)",
 "mcintosh": "تفاح ماكنتوش (تفاح مبكر النضج شائع في شمال شرق الولايات المتحدة؛ يؤكل نيئًا بشكل أساسي ولكنه مناسب لصلصة التفاح)",
 "mcmansion": "قصر تجاري, ماكماشن (منزل فخم عام مُنتج بكميات كبيرة)",
 "md": "دكتور في الطب (درجة الدكتوراه في الطب) / طبيب (ممارس طبي مرخص) / مندليفيوم (عنصر مشع ما بعد اليورانيوم يتم تصنيعه بقصف الأينشتاينيوم بجسيمات ألفا)\nمثال: شعرت بسوء شديد فذهبت لرؤية طبيبي",
 "mdiv": "ماجستير في اللاهوت (درجة الماجستير في الدراسات الدينية)",
 "mdma": "إكستاسي, إم دي إم إيه (عقار منشط مرتبط كيميائياً بالميسكالين والأمفيتامين ويستخدم بشكل غير مشروع لتأثيراته المبهجة والمهلوسة؛ كان يستخدم سابقاً في العلاج النفسي ولكن في عام…)\nمثال: غالباً ما يستخدم الإكستاسي في الحفلات لأنه يمكن رواد الحفلات من البقاء نشطين لفترات طويلة من الزمن",
 "me": "ـنِي, ـنِيَ / ـِي, ـِيَ",
 "me too": "أَنَا أَيْضًا, أَنَا كَذٰلِك",
 "me-tooer": "إِمَّعَة",
 "mea culpa": "اعْتِرَاف بِالْخَطَأ, مِيَا كُولْبَا (إقرار بخطئك أو ذنبك)",
 "mead": "بِتْع (تباعد؛ صيّرَ)",
 "mead's milkweed": "صقلاب ميد (صقلاب من وسط أمريكا الشمالية؛ نوع مهدد بالانقراض)",
 "meadow": "مَرْج",
 "meadow beauty": "جمال المروج, عشب الغزال (أي من عدة نباتات من جنس ريكسيا عادة ما يكون لها زهور وردية أرجوانية إلى أرجوانية؛ شرق أمريكا الشمالية)",
 "meadow bright": "آذريون المستنقع, قطيفة المستنقع (نبات مستنقعات من أوروبا وأمريكا الشمالية ذو أزهار صفراء زاهية تشبه الحوذان)",
 "meadow buttercup": "حوذان المروج, حوذان طويل (حوذان أوروبي معمر ذو أزهار ربيعية صفراء، متوطن بشكل واسع خاصة في شرق أمريكا الشمالية)",
 "meadow clary": "قصعين المروج, ميرمية المروج (ميرمية معمرة طويلة من العالم القديم بزهور زرقاء بنفسجية؛ توجد في الأراضي العشبية المفتوحة)",
 "meadow cranesbill": "إبرة الراعي المرجية, غرنوقي المروج (غرنوقي معمر طويل بزهور إبطية بنفسجية زرقاء مزدوجة؛ موطنه الأجزاء الشمالية من العالم القديم وتوطن في أمريكا الشمالية)",
 "meadow cress": "حرف مرجي, زهرة الوقواق (رشاد مر من أوروبا وأمريكا)",
 "meadow fern": "سرخس المرج, سرخس صندوق السعوط (سرخس في شمال شرق أمريكا الشمالية)",
 "meadow fescue": "عشب الفستوكة, فستوكة (عشب بأوراق مسطحة عريضة يُزرع في أوروبا وأمريكا للمراعي الدائمة والقش والمروج)",
 "meadow foxtail": "ذيل الثعلب المروجي (عشب معمر منتصب قوي من الأجزاء الشمالية للعالم القديم له سنابل مزهرة حريرية؛ يزرع على نطاق واسع للمراعي والتبن؛ متوطن في أمريكا الشمالية)",
 "meadow goldenrod": "عصا الذهب الكندية, عصا الذهب المرجية (عصا الذهب كبيرة من أمريكا الشمالية ذات عناقيد مبهرجة من الزهور الصفراء على فروع مقوسة؛ غالباً ما تكون عشبة ضارة)",
 "meadow grass": "عشب المروج (أي من أعشاب مختلفة تزدهر بوجود رطوبة وفيرة)",
 "meadow jumping mouse": "فأر المروج القفاز (واسع الانتشار في شمال شرق ووسط الولايات المتحدة وكندا)",
 "meadow leek": "ثوم كندي (نبات بصلي من أمريكا الشمالية)",
 "meadow lily": "زنبق أصفر بري, زنبق كندا (زنبق شائع في شرق الولايات المتحدة له زهور صفراء أو محمرة متدلية منقطة بالبني)",
 "meadow mouse": "فأر المروج (واسع الانتشار في المراعي في شمال الولايات المتحدة وكندا)",
 "meadow mushroom": "فطر الحقل, فطر المروج (فطر شائع صالح للأكل يوجد طبيعياً في التربة المفتوحة الرطبة؛ الفطر المزروع تجارياً)",
 "meadow pea": "بازلاء المروج, بيقية شائعة (بازلاء برية أوراسية معمرة متسلقة لها زهور مصفرة وقرون بذور مضغوطة؛ تزرع للعلف)",
 "meadow pipit": "جشنة المروج (جشنة شائعة بنية من الأعلى وبيضاء من الأسفل؛ واسعة الانتشار في شمال ووسط أوروبا وآسيا)",
 "meadow rue": "تاليتروم, سداب المروج",
 "meadow saffron": "زعفران الخريف, سورنجان (عشب بصلي يزهر في الخريف بأزهار بيضاء أو أرجوانية أو خزامية وبيضاء؛ موطنه غرب ووسط أوروبا)",
 "meadow salsify": "ساسفي المروج, لحية التيس (نبات حولي أوروبي ضار بأزهار صفراء؛ مستوطن في الولايات المتحدة)",
 "meadow saxifrage": "ساكسفراجا جرانيولاتا, كاسر الحجر المروجي (نبات معمر يشكل وريدات وله عناقيد مدمجة من الزهور البيضاء؛ أوروبا)",
 "meadow spikemoss": "طحلب السنبلة المروجي (طحلب سنبلة يشكل حصائر كثيفة؛ شرق أمريكا الشمالية)",
 "meadow spittlebug": "حشرة بصاق المروج (حشرة من أمريكا الشمالية تتلف الأعشاب بشدة)",
 "meadow vole": "فأر المروج (واسع الانتشار في المراعي في شمال الولايات المتحدة وكندا)",
 "meadowgrass": "عشب المروج (أي من أعشاب مختلفة تزدهر بوجود رطوبة وفيرة)",
 "meadowlark": "قبرة المروج (طيور مغردة من أمريكا الشمالية ذات صدر أصفر)",
 "meager": "ضَئِيل",
 "meagerly": "شَحِيح, ضَئِيل (ناقص في الكمية أو الجودة أو المدى) / بشح, بضآلة (لدرجة ضئيلة أو بطريقة شحيحة)\nمثال: موارد شحيحة",
 "meagerness": "شح, ضآلة (صفة كون الشيء هزيلاً أو ضئيلاً)\nمثال: ضآلة القماش التي لا تسمح إلا بعمل أغطية مصغرة",
 "meagre": "شَحِيح, ضَئِيل (ناقص في الكمية أو الجودة أو المدى)\nمثال: موارد شحيحة",
 "meagrely": "بشح, بضآلة (لدرجة ضئيلة أو بطريقة شحيحة)\nمثال: هذه الأصوات ممثلة بقلة في المؤتمر",
 "meagreness": "شح, ضآلة (صفة كون الشيء هزيلاً أو ضئيلاً)\nمثال: ضآلة القماش التي لا تسمح إلا بعمل أغطية مصغرة",
 "meal": "وَجْبَة, أكلة (الحصة التي صارت واجبة؛ الحصة الواحدة من الطعام توجب في موعد محدد)\nمثال: التهم زيري الوجبة.",
 "meal plan": "خطة إقامة, خطة فندقية (خطة وسعر غرفة لتوفير غرفة ووجبات للضيوف في فندق)",
 "meal ticket": "تذكرة طعام, قسيمة وجبة (قسيمة قابلة للاسترداد في مطعم وتخول حاملها الحصول على وجبة) / مصدر دخل (مصدر للدخل أو الرزق)",
 "mealberry": "عنب الدب, قطلب عنب الدب (شجيرة دائمة الخضرة تشكل حصيرة من أمريكا الشمالية وشمال أوراسيا لها زهور بيضاء صغيرة وتوت أحمر؛ تتحول الأوراق إلى الأحمر في الخريف)",
 "mealie": "كوز ذرة (كوز من الذرة)",
 "mealtime": "وقت الطعام, وقت الوجبة (الساعة التي تُؤكل فيها وجبة عادة أو عرفاً)",
 "mealworm": "دودة الدقيق (يرقة الخنافس من عائلة الظلاميات)",
 "mealy": "حُبَيْبِيّ, مُحَبَّب (مؤلّف من جزيئات تشبه الدقيق في القوام أو مغطّى بها) / دقيقي (يحتوي على دقيق أو مصنوع من دقيق)",
 "mealy bug": "بق دقيقي (حشرة آكلة للنبات تشبه القشور مغطاة بإفراز شمعي مسحوقي؛ مدمرة خاصة لأشجار الفاكهة)",
 "mealy sage": "ميرمية دقيقية (ميرمية تكساس ذات زهور زرقاء مكثفة)",
 "mealy-mouthed": "مُتَلَعْثِم, مُرَاوِغ (مُتَرَدِّد فِي ذِكْر الحَقَائِق أَوِ الآرَاء بِبَسَاطَة وَمُبَاشَرَة)",
 "mealybug": "بق دقيقي (حشرة آكلة للنبات تشبه القشور مغطاة بإفراز شمعي مسحوقي؛ مدمرة خاصة لأشجار الفاكهة)",
 "mealymouthed": "مُتَلَعْثِم, مُرَاوِغ (مُتَرَدِّد فِي ذِكْر الحَقَائِق أَوِ الآرَاء بِبَسَاطَة وَمُبَاشَرَة)",
 "mean": "عَنَى, قَصَدَ / لَئِيم, خَسِيس / مُتَوَسِّط",
 "mean deviation": "انحراف متوسط, انحراف متوسط عن المتوسط (المتوسط الحسابي للقيم المطلقة للانحرافات عن متوسط التوزيع)",
 "mean deviation from the mean": "انحراف متوسط, انحراف متوسط عن المتوسط (المتوسط الحسابي للقيم المطلقة للانحرافات عن متوسط التوزيع)",
 "mean distance": "المَسَافَة المُتَوَسِّطَة, مُتَوَسِّط المَسَافَة (المتوسط الحسابي للحد الأقصى والأدنى لمسافات جرم سماوي (قمر صناعي أو نجم ثانوي) عن الجرم الأساسي الذي يدور حوله)",
 "mean solar day": "أربع وعشرون ساعة, يوم (الوقت الذي تستغرقه الأرض للقيام بدورة كاملة حول محورها)\nمثال: غادروا بعد يومين",
 "mean solar time": "التوقيت الشمسي المتوسط, الوقت المتوسط ((علم الفلك) وقت يعتمد على حركة الشمس المتوسطة (شمس وهمية تتحرك بانتظام على طول خط الاستواء السماوي))",
 "mean sun": "الشمس المتوسطة (شمس نظرية تتحرك على طول خط الاستواء السماوي بسرعة ثابتة وتكمل دورتها السنوية في نفس الوقت الذي تستغرقه الشمس الحقيقية بسرعات متغيرة)",
 "mean time": "التوقيت الشمسي المتوسط, الوقت المتوسط ((علم الفلك) وقت يعتمد على حركة الشمس المتوسطة (شمس وهمية تتحرك بانتظام على طول خط الاستواء السماوي))",
 "mean value": "متوسط, وسط",
 "meander": "تَعَرَّجَ",
 "meanderingly": "بشكل متعرج (بطريقة متعرجة)\nمثال: جرى النهر بشكل متعرج عبر الوادي",
 "meanie": "قاس, لئيم (شخص ذو طباع لئيمة أو خبيثة)",
 "meaning": "مَعْنًى / الْمَعْنَى",
 "meaning of life": "مَعْنَى اَلْحَيَاة",
 "meaningful": "ذُو مَعْنًى (أحد الأسماء الستة، لا يأتي إلا مُضَافًا، بمعنى صاحب)\nمثال: كان رجل ذو قامة طويله.",
 "meaningfully": "بشكل ذي مغزى, بشكل معبر (بطريقة ذات معنى؛ بحيث تكون ذات مغزى)\nمثال: نظر إليها بشكل معبر",
 "meaningfulness": "جدوى, معنى (صفة امتلاك قيمة أو أهمية كبيرة)",
 "meaningless": "بلا معنى, عبثي (ليس له معنى أو اتجاه أو غرض) / عَبَثِيّ, عَقِيم (لَا يُنْتِجُ أَيَّ نَتِيجَةٍ أَوْ أَثَر)\nمثال: مسعى بلا معنى",
 "meaninglessness": "انعدام المعنى, عبثية (صفة انعدام القيمة أو الأهمية) / كَلَام فَارِغ, لَغْو (رسالة يبدو أنها لا تحمل أي معنى)\nمثال: استاء من عبثية المهام التي كلفوه بها",
 "meanly": "ببخل, بتقتير (بطريقة بخيلة) / بشكل رديء, بشكل وضيع (بشكل سيء أو بطريقة متدنية) / بخسة, بنذالة (بطريقة حقيرة ودنيئة) / بخبت, بسوء خلق (بطريقة سيئة المزاج وخبيثة)\nمثال: عاشوا بتقتير ودون تفاخر",
 "meanness": "خسة, شح (بخل شديد) / خسة, دناءة (صفة التعمد في الدناءة وسوء المعاملة)",
 "means": "طريقة, واسطة (امتلاك القدرة على إنتاج تأثير معين أو تحقيق غاية) / أَدَاة, وَسِيلَة (مصنوعة تُستخدَم وسيلة لإنجاز غاية ما) / ثراء, سعة (رأس مال كبير (ثروة أو دخل))\nمثال: وسيلة للسيطرة",
 "means grass": "عشب جونسون, عشب حلب (عشب معمر طويل ينتشر عن طريق الجذامير الزاحفة ويزرع للعلف؛ متوطن في جنوب الولايات المتحدة حيث يعتبر آفة خطيرة في الأراضي المزروعة)",
 "means of production": "وَسَائِل الْإِنْتَاج",
 "means test": "استطلاع الموارد المالية",
 "meanspirited": "غير كريم, لئيم (يفتقر إلى الشهامة والنبل) / دَنِيء, لَئِيم (يُظهِر افتقارًا وضيعًا للشرف أو الأخلاق)\nمثال: يبدو من غير الكياسة إنهاء هذه المراجعة لعمل علمي رائع بملاحظة نقدية",
 "meanspiritedly": "بخسة نفس, بلؤم (بطريقة لئيمة)",
 "meantime": "في غضون ذلك, في هذه الأثناء (خلال الوقت الفاصل) / أثناء ذلك, فترة مؤقتة (الوقت بين حدث أو عملية أو فترة وأخرى)\nمثال: في غضون ذلك لن أفكر في المشكلة",
 "meanwhile": "أَمَّا (حَرْفُ اِسْتِفْتَاحٍ، وَيَكْثُرُ اِسْتِعْمَالُهُ قَبْلَ القَسَمِ) / إِلَى حِينِ ذَلِكَ الوَقْتِ فِي الأَثْنَاءِ (حرف جر يُفيد الغاية الزمنية؛ حرف جر يُفيد الغاية المكانية) / فِي حِينِ أَنَّ (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: أما زلت تذكرني؟",
 "meany": "قاس, لئيم (شخص ذو طباع لئيمة أو خبيثة)",
 "mearstone": "حجر الحدود (مصطلح قديم لمعلم أرضي يتكون من كومة من الحجارة يعلوها لوح قائم)",
 "measles": "حَصْبَة",
 "measly": "بَخْس, تَافِه (ضئيل المقدار بشكل يبعث على الازدراء)",
 "measurability": "قَابِلِيَّة القِيَاس (صفة كون الشيء قابلاً للقياس)",
 "measurable": "ذُو وَزْن, مُعْتَبَر (ذو أهمّيّة بارزة ومُميّزة) / قابل للقياس (يمكن قياسه)\nمثال: أعماق قابلة للقياس",
 "measurably": "بشكل ملحوظ, بشكل ملموس (لدرجة قابلة للقياس)\nمثال: الفرق كبير بشكل ملحوظ",
 "measure": "قِيَاس / فَاصِلَة / إِجْرَاء / قَاسَ (شديد وصلب، غير لين؛ جافٍ أو يابس في الملمس أو التعامل)\nمثال: قاس طول السرير.",
 "measured": "مَحْسُوب, مُتَأَنٍّ (غير مُتسرّع وبعناية ووقار) / مَحْسُوب, مَدْرُوس (مُفكَّر فيه بعناية مسبقًا) / عَرُوضِيّ, مَوْزُون (يتعلّق بالتنظيم الإيقاعي للمقاطع اللفظية) / إيقاعي منضبط, قياسي (يحتوي على نغمات ذات قيمة إيقاعية ثابتة)",
 "measured rhythm": "إيقاع موزون (نوع من الإيقاع تكون فيه كل قيمة زمنية مضاعفاً أو جزءاً من وحدة زمنية محددة ولكن لا توجد لكنات متكررة بانتظام)",
 "measuredly": "بتؤدة, بتروٍ (بطريقة مدروسة وغير مستعجلة)\nمثال: كانت تعمل بتؤدة",
 "measureless": "لَا حَدَّ لَه, لَا مَحْدُود (بلا حدود في المدى أو الحجم أو الكمية)",
 "measurement": "قياس (فعل أو عملية تعيين أرقام للظواهر وفقًا لقاعدة)\nمثال: تمت القياسات بعناية",
 "measurer": "قَائِس (شخص يقوم بإجراء قياسات)",
 "measuring": "قياس (فعل أو عملية تعيين أرقام للظواهر وفقًا لقاعدة)\nمثال: تمت القياسات بعناية",
 "measuring block": "وحدة قياس (وحدة للقياس)",
 "measuring cup": "كُوب قِيَاس (إناء للشرب لا عروة له؛ كل إناء للشرب. (تعميم)(غير معياري))\nمثال: الكوب مليء بالحليب.",
 "measuring device": "أداة قياس, جهاز قياس (أداة تظهر مدى أو كمية أو درجة شيء ما)",
 "measuring instrument": "أداة قياس, جهاز قياس (أداة تظهر مدى أو كمية أو درجة شيء ما)",
 "measuring rod": "عصا القياس, مسطرة قياس (أداة قياس تحتوي على تسلسل من العلامات على فترات منتظمة؛ تستخدم كمرجع في إجراء القياسات)",
 "measuring stick": "عصا القياس, مسطرة قياس (أداة قياس تحتوي على تسلسل من العلامات على فترات منتظمة؛ تستخدم كمرجع في إجراء القياسات)",
 "measuring system": "أداة قياس, جهاز قياس (أداة تظهر مدى أو كمية أو درجة شيء ما)",
 "measuring unit": "وحدة قياس (وحدة للقياس)",
 "measuring worm": "دودة شبرية, دودة قياسة (يسروع صغير أملس له أرجل فقط في قطاعاته الأمامية والخلفية؛ معظمها يرقات لعث من عائلة الأرفية)",
 "meat": "لَحْم, لحمة (ما يبقى من جسم الحيوان أو الإنسان بعد إزالة الجلد الأحشاء والعظم والشحم والدم والأعصاب. يتكون أساسا من العَضَلَات؛ ما يؤكل من لحم من الحيوان والطير والسمك عامة)\nمثال: أفضل لحم البقر.",
 "meat and potatoes": "الجزء الجوهري, اللحم والبطاطس (الجزء الأساسي)\nمثال: التفاوض الناجح هو جوهر التحكيم",
 "meat cleaver": "ساطور (سكين جزار له شفرة مربعة كبيرة)",
 "meat counter": "ثلاجة عرض اللحوم, كاونتر اللحوم (منضدة تعرض فيها اللحوم للبيع)",
 "meat grinder": "معركة طاحنة, مفرمة (أي عمل يؤدي إلى إصابة أو دمار (مجازي)) / مفرمة لحم (طاحونة لفرم اللحم)\nمثال: مفرمة السياسة دمرت سمعته",
 "meat hook": "خُطَّاف لحم, كُلَّاب الجزار (خطاف مدبب قوي تعلق عليه ذبائح الحيوانات)",
 "meat hooks": "أيدي قوية (يد قوية وكبيرة (كما للمقاتل))\nمثال: انتظر حتى أضع يدي عليه",
 "meat house": "بيت اللحم (منزل صغير (في مزرعة) حيث يتم تخزين اللحوم) / بيت التدخين, مدخنة (منزل صغير يستخدم فيه الدخان لمعالجة اللحوم أو الأسماك)",
 "meat loaf": "رغيف اللحم (رغيف مخبوز من اللحم المفروم)",
 "meat market": "محل جزارة, ملحمة (متجر تباع فيه اللحوم والدواجن (وأحياناً الأسماك))",
 "meat mixer": "خلاط لحم (أداة تتكون من خزان فولاذي ومجاديف خلط، تستخدم لإعداد اللحم للنقانق)",
 "meat packer": "تاجر لحوم بالجملة, معبّئ لحوم (تاجر جملة في مجال تعبئة اللحوم)",
 "meat packing": "تعبئة اللحوم (تعبئة اللحوم بالجملة للبيع المستقبلي (بما في ذلك الذبح والمعالجة والتوزيع لتجار التجزئة))",
 "meat pie": "فطيرة لحم (فطيرة مصنوعة من اللحم أو الطيور محاطة بالمعجنات أو مغطاة بالمعجنات أو عجينة البسكويت)",
 "meat safe": "خزانة لحوم (خزانة آمنة لتخزين اللحوم)",
 "meat thermometer": "مقياس حرارة اللحوم (مقياس حرارة يتم إدخاله في وسط الشواء (مع كون الجزء العلوي بعيداً عن مصدر الحرارة)؛ يستخدم لقياس مدى نضج اللحم)",
 "meat-packing business": "تعبئة اللحوم (تعبئة اللحوم بالجملة للبيع المستقبلي (بما في ذلك الذبح والمعالجة والتوزيع لتجار التجزئة))",
 "meatball": "كُرَات اللَحْم",
 "meatgrinder": "فَرّامَةُ لَحْم",
 "meatless": "خالٍ من اللحم (يفتقر إلى اللحم)\nمثال: أيام خالية من اللحم",
 "meatloaf": "رغيف اللحم (رغيف مخبوز من اللحم المفروم)",
 "meatman": "بائع لحوم, جزار (بائع تجزئة ذكر للحوم)",
 "meatpacking": "تعبئة اللحوم (تعبئة اللحوم بالجملة للبيع المستقبلي (بما في ذلك الذبح والمعالجة والتوزيع لتجار التجزئة))",
 "meatus": "صماخ (ممر جسدي طبيعي)",
 "meaty": "لَحْمِيّ",
 "mebaral": "ميبارال, ميفوباربيتال (باربيتورات طويل المفعول (الاسم التجاري ميبارال) يستخدم كمهدئ وكمضاد للاختلاج في علاج الصرع)",
 "mebendazole": "ميبيندازول (طارد للديدان يستخدم لعلاج الإصابة بالديدان الخطافية والديدان الدبوسية والديدان المستديرة)",
 "mebibit": "ميبي بت (وحدة معلومات تساوي 1024 كيبي بت أو 2 أس 20 (1,048,576) بت)",
 "mebibyte": "ميبي بايت, ميغابايت (وحدة معلومات تساوي 1024 كيبي بايت أو 2 أس 20 (1,048,576) بايت)",
 "mecca": "مَكَّة, مَكَّةُ الْمُكَرَّمَة (مدينة مقدسة لدى المسلمين، بها المسجد الحرام، والكعبة التي تعد قبلة المسلمين في صلاتهم. تقع غرب السُّعُودِيَّة…)\nمثال: حلمي الاستقرار في مكة.",
 "meccan": "مَكِّيّ",
 "meccano": "ميكانو (مجموعة بناء للأطفال لعمل نماذج ميكانيكية)",
