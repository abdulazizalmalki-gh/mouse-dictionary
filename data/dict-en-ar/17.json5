 "mate": "صَدِيق (هو الصَاحِب والخّل الذي بينك وبينه صَدَاقَة)\nمثال: ليس لديه صديقة.",
 "mated": "مُقْتَرِن (يتعلق بشريك الزواج) / متزاوج (تزاوج جنسياً) / مُتَقَارِن, مُزْدَوِج (يحدث في أزواج أو كزوج)",
 "mateless": "بِلَا شَرِيك (ليس لديه شريك زواج) / بِلَا قَرِين (بدون شريك جنسي)",
 "matelote": "ماتلوت (حساء أو يخنة متبلة جداً من أسماك المياه العذبة (ثعبان البحر، الكارب، الفرخ) مع النبيذ والمرق)",
 "mater": "والدة (استخدام غير رسمي للكلمة اللاتينية للأم؛ يستخدم أحياناً من قبل تلاميذ المدارس البريطانيين أو يستخدم على سبيل المزاح)",
 "mater lectionis": "أُمّ قِرَاءَة (الوَالِدَة أو الجَدَّة، وقد يطلق على والدة الزوج مجازا؛ أمّ بالرضاعة: المرأة التي أرضعت الطِفْل صغيرا فتصبح كوالدته)\nمثال: هل ستأتي أم لا؟",
 "materfamilias": "الأم الحاكمة, عميدة الأسرة (رئيسة الأسرة أو القبيلة)",
 "materia medica": "علم الأدوية, فارماكولوجيا (علم أو دراسة الأدوية: تحضيرها وخصائصها واستخداماتها وتأثيراتها)",
 "material": "مَادِّيّ / مَادَّة (مؤنث مَادّ، اسم فاعل من مَدَّ. الجمع مَادَّات؛ ما كان مَدَدًا لغيره)\nمثال: لا أحب مادة العلوم.",
 "material body": "جَسَد, جِسْمُ الإِنْسَان (أسماء بديلة لجسد الإنسان)\nمثال: درس ليوناردو جسم الإنسان",
 "material breach": "إخلال جوهري (خرق خطير بما يكفي لتدمير قيمة العقد وإعطاء أساس لدعوى خرق العقد)",
 "material intensity": "استهلاك المواد, كثافة المواد (الإنفاق بشروط محددة (لكل وحدة إنتاج) للموارد المادية (المواد الأساسية والمساعدة، الوقود، الطاقة، واستهلاك الأصول الثابتة) اللازمة للإنتاج)",
 "material possession": "ممتلكات مادية, ممتلكات ملموسة (ممتلكات أو مقتنيات ملموسة)",
 "material resource": "مورد مادي (أصول في شكل ممتلكات مادية)",
 "material witness": "شاهد أساسي (شاهد تكون شهادته ذات صلة بالموضوع محل النزاع ومطلوبة لحل المسألة)",
 "materialisation": "تجسيد, ثمرة (شيء يظهر إلى الوجود كنتيجة) / تجسد, تجلي (ظهور في شكل جسدي (كما في الروح غير المتجسدة)) / تجسد, تحقق (عملية الخروج إلى الوجود؛ التحول إلى واقع)\nمثال: مهدت الصناعة الطريق لقبول مختلف النتاجات الاشتراكية للثورة الفرنسية",
 "materialism": "مَادِّيَّة",
 "materialist": "مادي (شخص يعتقد أنه لا يوجد شيء سوى المادة الفيزيائية) / مادي (شخص لديه اهتمام كبير بالممتلكات المادية)",
 "materialistic": "بُرْجُوَازِيّ, مَادِّيّ (يتوافق مع معايير وأعراف الطبقة الوسطى) / مَادِّيّ النَّزْعَةِ, نَفْعِيّ (يَتَّسِمُ بِالنَّزْعَةِ المَادِّيَّةِ)",
 "materialistically": "بمادية (بطريقة مادية)\nمثال: لا ينبغي للمرء أن يقارب الحياة بمادية",
 "materiality": "جُسْمَانِيَّة, مَادِّيَّة (صفة كون الشيء مادياً؛ مكوناً من مادة) / أَهَمِّيَّة, جَوْهَرِيَّة (صلة تتطلب دراسة متأنية)",
 "materialization": "تجسيد, ثمرة (شيء يظهر إلى الوجود كنتيجة) / تجسد, تجلي (ظهور في شكل جسدي (كما في الروح غير المتجسدة)) / تجسد, تحقق (عملية الخروج إلى الوجود؛ التحول إلى واقع)\nمثال: مهدت الصناعة الطريق لقبول مختلف النتاجات الاشتراكية للثورة الفرنسية",
