 "racketeering": "أعمال العصابات, ابتزاز منظم (الانخراط في أعمال غير مشروعة للاحتيال أو الابتزاز)",
 "racketiness": "جلبة, صخب (التأثير السمعي الذي يتميز بضوضاء عالية ومستمرة)",
 "rackety": "صَاخِب, مُزْعِج (شديد الضجيج بشكل لا يمكن السيطرة عليه)",
 "racking": "مُعَذِّب, مُمَزِّق (يُسَبِّبُ مُعَانَاةً جَسَدِيَّةً أَوْ نَفْسِيَّةً شَدِيدَة)",
 "racon": "راكون, منارة الرادار (جهاز يقوم، عند تلقي إشارات الرادار، بإرسال إشارات مشفرة رداً للمساعدة في تحديد موقع الملاحين)",
 "raconteur": "قاص نوادر (شخص ماهر في سرد الحكايات والنوادر)",
 "racoon": "راكون (ثديي ليلي قارت (آكل لكل شيء) موطنه أمريكا الشمالية وأمريكا الوسطى)",
 "racquet": "مِضْرَب (أداة رياضية (تتكون عادة من مقبض وإطار بيضاوي بشبكة مشدودة من الأوتار) تستخدم لضرب الكرة في ألعاب مختلفة)",
 "racquetball": "راكيت بول (لعبة تُلعب في ملعب كرة يد بمضارب قصيرة المقبض) / كرة المضرب (الكرة المستخدمة في لعب لعبة كرة المضرب)",
 "racy": "سِبَاقِيّ (مُصَمَّمٌ أَوْ مُنَاسِبٌ لِلتَّنَافُسِ فِي سِبَاق) / فَاحِش, مُوحٍ بِالبَذَاءَة (يُلمّح إلى سلوك جنسيّ غير لائق) / حَيَوِيّ, نَابِض (مليء بالحيويّة والنَّشاط والقوّة) / غَنِيّ, مُكْتَنِزُ النَّكْهَة (يَتَّسِمُ بِالثَّرَاءِ وَالامْتِلَاءِ فِي النَّكْهَة)",
 "rad": "راديان, زاوية نصف قطرية (وحدة الزاوية المستوية المعتمدة في النظام الدولي للوحدات؛ وتساوي الزاوية عند مركز دائرة يقابلها قوس مساوٍ في الطول لنصف القطر) / راد (وحدة للإشعاع المؤين الممتص تساوي 100 إرج لكل غرام من المادة المشععة)",
 "radar": "رَادَار",
 "radar beacon": "راكون, منارة الرادار (جهاز يقوم، عند تلقي إشارات الرادار، بإرسال إشارات مشفرة رداً للمساعدة في تحديد موقع الملاحين)",
 "radar dome": "قبة الرادار (مبيت لهوائي الرادار؛ شفاف لموجات الراديو)",
 "radar echo": "صدى الرادار (إشارة إلكترونية انعكست عائدة إلى هوائي الرادار؛ تحتوي على معلومات حول موقع الجسم العاكس وبعده)",
 "radar fire": "نيران موجهة بالرادار (إطلاق نار يستهدف هدفاً يتم تتبعه بواسطة الرادار)",
 "radar gun": "مسدس الرادار (اسم مفعول من سَدَّسَ؛ في : شَكْل هندسي مُسَطَّح له سِتَّة أضلاع متساوية فإن لم تكن متساوية سميّ بالسُدَاسِيّ)\nمثال: كان عند زيري مسدس.",
 "radar target": "نقطة رادار, ومضة (صدى رادار يُعرض لإظهار موقع سطح عاكس)",
 "raddle": "حجر تعليم أحمر, مغرة حمراء (خام حديد أحمر يستخدم في الصباغة ووضع العلامات)",
 "raddled": "شَاحِب, مُتْعَبُ المَلَامِح (يُظْهِرُ آثَارَ الإِرْهَاقِ أَوِ الهَمِّ أَوِ المُعَانَاة) / مُسْتَهْلَكٌ تَمَامًا (اسْتُعْمِلَ حَتَّى لَمْ يَعُدْ صَالِحًا لِلاسْتِخْدَامِ)",
 "radial": "شُعَاعِيّ, نَجْمِيّ (مُرتَّب كالأشعة؛ ينبثق من مركز مشترك) / إشعاعي (صادر في أشعة من مركز مشترك؛ أو متعلق بأشعة الضوء) / نصف قطري (متعلق بنصف القطر أو يتحرك على طوله أو في اتجاهه) / كعبري (متعلق بعظم الكعبرة أو بالقرب منه)\nمثال: حرارة إشعاعية",
 "radial artery": "شريان كعبري (فرع من الشريان العضدي يبدأ أسفل المرفق ويمتد لأسفل الساعد حول الرسغ وإلى راحة اليد)",
 "radial asymmetry": "لا تناظر شعاعي (غياب التناظر حول محور)",
 "radial engine": "محرك دوار, محرك شعاعي (محرك احتراق داخلي تترتب فيه الأسطوانات شعاعياً حول علبة مرافق مركزية)",
 "radial keratotomy": "بضع القرنية التشريطي (نمط شعاعي من الشقوق في القرنية يتسبب في انتفاخ القرنية؛ يجرى لتصحيح قصر النظر)",
 "radial nerve": "عصب كعبري (أكبر فرع من الضفيرة العضدية؛ يمتد أسفل العضد إلى اللقيمة الوحشية حيث ينقسم إلى فرع يذهب إلى الجلد على ظهر اليد وآخر يذهب إلى العضلات الباسطة التحتية)",
 "radial pulse": "نَبْض كُعْبُرِيّ (نبض الشريان الكعبري (يُحس في المعصم))",
 "radial symmetry": "تناظر شعاعي (خاصية التناظر حول محور)\nمثال: نجم البحر يوضح التناظر الشعاعي",
 "radial tire": "إطار شعاعي, راديال (إطار هوائي له غلاف بطبقات شعاعية)",
 "radial vein": "وريد كعبري (أوردة سطحية تصعد على الجانب الكعبري للساعد؛ تتحد مع الأوردة الزندية لتكوين الوريد العضدي)",
 "radial velocity": "سُرْعَة شُعَاعِيَّة (السرعة على طول خط البصر باتجاه الراصد أو بعيداً عنه)",
 "radial-ply": "شعاعي الطبقات (مكون من أو متعلق بإطارات السيارات التي لها شريط تحت المداس وصلابة قليلة نسبياً في الجوانب)\nمثال: إطارات شعاعية الطبقات",
 "radial-ply tire": "إطار شعاعي, راديال (إطار هوائي له غلاف بطبقات شعاعية)",
 "radially": "شعاعياً (بطريقة شعاعية)\nمثال: توزيع خيالي للمقاعد شعاعياً من البؤرة المركزية للمنبر",
 "radially symmetrical": "شُعَاعِيّ التَّنَاظُر (ذو ترتيب متناظر للأجزاء المشعة حول نقطة مركزية)",
 "radian": "راديان, زاوية نصف قطرية (وحدة الزاوية المستوية المعتمدة في النظام الدولي للوحدات؛ وتساوي الزاوية عند مركز دائرة يقابلها قوس مساوٍ في الطول لنصف القطر)",
 "radiance": "إشعاع, بهاء (صفة كون الشيء ساطعاً ويرسل أشعة ضوئية) / تألق, توهج (كمية الإشعاع الكهرومغناطيسي التي تغادر أو تصل إلى نقطة على سطح ما) / تألق (مزيج جذاب من الصحة الجيدة والسعادة)\nمثال: تألق محياها",
 "radiancy": "إشعاع, بهاء (صفة كون الشيء ساطعاً ويرسل أشعة ضوئية)",
 "radiant": "مُشِعّ, مُتَوَهِّج",
 "radiant energy": "طاقة إشعاعية (طاقة تنتقل في شكل إشعاع (كهرومغناطيسي)؛ طاقة توجد في غياب المادة)",
 "radiant flux": "فَيْض إِشْعَاعِيّ (معدل تدفق الطاقة الإشعاعية (الموجات الكهرومغناطيسية))",
 "radiant heating": "تدفئة بالإشعاع (تدفئة مبنى عن طريق الإشعاع من ألواح تحتوي على ماء ساخن أو سخانات كهربائية)",
 "radiantly": "بإشراق, بتألق (بطريقة مشرقة)\nمثال: ابتسمت العروس بإشراق",
 "radiate": "شُعَاعِيّ (ذو أشعّة أو أجزاء شعاعيّة كما في رؤوس أزهار الأقحوان) / شُعَاعِيّ, نَجْمِيّ (مُرتَّب كالأشعة؛ ينبثق من مركز مشترك)",
 "radiatio optica": "تشعع بصري (مسار عصبي من الجسم الركبي الجانبي إلى القشرة البصرية)",
 "radiation": "إِشْعَاع (انبعاث الطَّاقة وامتدادُها)",
 "radiation diagram": "نمط الإشعاع (تمثيل بياني للتوزيع المكاني للإشعاع من هوائي كدالة للزاوية)",
 "radiation field": "مجال إشعاعي (مجال يمثل الطاقة المفقودة من المشع إلى الفضاء)",
 "radiation pattern": "نمط الإشعاع (تمثيل بياني للتوزيع المكاني للإشعاع من هوائي كدالة للزاوية)",
 "radiation pressure": "ضغط الإشعاع (الضغط الدقيق الذي يمارس على سطح عمودي على اتجاه انتشار الموجة)",
 "radiation pyrometer": "بيرومتر إشعاعي (بيرومتر لتقدير درجة حرارة مصادر الحرارة البعيدة؛ يتم تركيز الإشعاع على وصلة حرارية)",
 "radiation sickness": "داء الإشعاع, متلازمة الإشعاع (متلازمة ناتجة عن التعرض للإشعاع المؤين (مثل التعرض للمواد الكيميائية المشعة أو للانفجارات النووية)؛ الجرعات المنخفضة تسبب الإسهال والغثيان والقيء…)\nمثال: كان يعاني من الإشعاع",
 "radiation syndrome": "داء الإشعاع, متلازمة الإشعاع (متلازمة ناتجة عن التعرض للإشعاع المؤين (مثل التعرض للمواد الكيميائية المشعة أو للانفجارات النووية)؛ الجرعات المنخفضة تسبب الإسهال والغثيان والقيء…)\nمثال: كان يعاني من الإشعاع",
 "radiation therapy": "علاج إشعاعي ((طب) علاج المرض (خاصة السرطان) عن طريق التعرض لمادة مشعة)",
 "radiator": "مِشْعاع",
 "radiator cap": "غطاء الردياتير, غطاء المبرد (غطاء الفتحة في أعلى المبرد التي يمكن من خلالها إضافة سائل التبريد)",
 "radiator grille": "شبكة المبرد (شبكة تسمح بدخول هواء التبريد إلى مبرد السيارة)",
 "radiator hose": "خرطوم المبرد (خرطوم مرن يصل بين المبرد وكتلة المحرك)",
 "radical": "جَذْريّ / رَادِيكَالِيّ",
 "radical cell": "خلية إرهابية (خلية من الإرهابيين (عادة من 3 إلى 5 أعضاء))\nمثال: لضمان الأمن التشغيلي، لا يعرف أعضاء الخلايا الإرهابية المتجاورة بعضهم البعض عادة أو هوية قيادتهم",
 "radical chic": "أناقة راديكالية (تكلف تبني وجهات نظر يسارية راديكالية مع اللباس وأسلوب الحياة العصري المصاحب لها)",
 "radical hysterectomy": "استئصال الرحم الجذري (إزالة جراحية للرحم والمبيضين وقناتي فالوب وعنق الرحم والعقد الليمفاوية ذات الصلة)",
 "radical mastectomy": "استئصال الثدي الجذري (إزالة الثدي والعضلات الأساسية (الصدرية الكبرى والصغرى) والعقد الليمفاوية في الإبط المجاور)",
 "radical sign": "علامة الجذر (علامة تشير إلى استخراج الجذر)",
 "radicalism": "رَادِيكَالِيَّة",
 "radically": "جذرياً (بطريقة جذرية)\nمثال: اتخذت نهجاً مختلفاً جذرياً",
 "radicchio": "راديكيو, هندباء حمراء (نوع ثمين من الهندباء له رؤوس كروية من الأوراق الحمراء)",
 "radicle": "جُذَيْر ((في التشريح) بنية صغيرة تشبه الجذر الصغير (مثل لييفة العصب))",
 "radiculitis": "التهاب الجذور العصبية (التهاب جذر العصب)",
 "radif": "رَدِيف",
 "radiigera fuscogleba": "راديجيرا فوسكوجليبا (فطر يشبه نجمة الأرض إلا أنه لا ينفتح؛ كتلة الأبواغ بنية عند النضج مع عمود من نسيج عقيم يمتد بداخلها)",
 "radio": "رَادْيُو, رَادِيُو",
 "radio aerial": "هوائي راديو (هوائي متعدد الاتجاهات يشكل جزءاً من جهاز استقبال الراديو يتم من خلاله استقبال إشارات الراديو)",
 "radio announcer": "مذيع راديو (مذيع يُبث صوته على الراديو)",
 "radio antenna": "هوائي راديو (هوائي متعدد الاتجاهات يشكل جزءاً من جهاز استقبال الراديو يتم من خلاله استقبال إشارات الراديو)",
 "radio astronomy": "علم الفلك الراديوي (فرع علم الفلك الذي يكتشف ويدرس موجات الراديو المنبعثة من الأجرام السماوية)",
 "radio beacon": "منارة لاسلكية (محطة إذاعية تبث إشارة توجيهية لأغراض الملاحة) / منارة لاسلكية (إشارة مميزة يبعثها جهاز إرسال يستخدم للملاحة)",
 "radio beam": "حزمة موجية, شُعَاع راديو (إشارة تُبث عبر مسار ضيق؛ تُرشد طياري الطائرات في الظلام أو الطقس السيئ)",
 "radio brightness": "سطوع راديوي (قوة الموجة الراديوية التي يلتقطها التلسكوب الراديوي)",
 "radio broadcast": "بث إذاعي (بث عبر الراديو)",
 "radio chassis": "هيكل الراديو (شاسيه لجهاز استقبال راديو)",
 "radio compass": "بوصلة لاسلكية (محدد اتجاه يعطي اتجاهاً عن طريق تحديد اتجاه إشارات الراديو القادمة)",
 "radio detection and ranging": "رادار (أداة قياس يستخدم فيها صدى نبضة من إشعاع الميكروويف للكشف عن الأجسام البعيدة وتحديد موقعها)",
 "radio dispatch": "بلاغ لاسلكي (بلاغ يتم إرساله عبر البث اللاسلكي)",
 "radio drama": "دراما إذاعية, مسرح إذاعي (أداء درامي صوتي بحت يبث على الراديو)",
 "radio emission": "موجة راديوية (موجة كهرومغناطيسية بطول موجي بين 0.5 سم إلى 30,000 متر)",
 "radio frequency": "تَرَدُّد رَادْيَوِيّ (تردد موجة كهرومغناطيسية بين الصوتية والأشعة تحت الحمراء)",
 "radio interferometer": "مقياس التداخل الراديوي (تلسكوب راديوي يستخدم أنماط التداخل من هوائيين بدلاً من هوائي مكافئ واحد)",
 "radio link": "رابط لاسلكي, وصلة راديو (نظام اتصال لاسلكي ثنائي الاتجاه (ميكروويف عادة)؛ جزء من شبكة اتصالات أوسع)",
 "radio news": "أخبار إذاعية (بث إذاعي للأخبار)",
 "radio noise": "ضوضاء راديوية (تشويش عند أطوال موجات الراديو)",
 "radio observation": "رصد لاسلكي (رصد يتم باستخدام تلسكوب لاسلكي)",
 "radio operator": "عامل لاسلكي, مشغل راديو (شخص يقوم بتشغيل جهاز إرسال لاسلكي)",
 "radio radiation": "موجة راديوية (موجة كهرومغناطيسية بطول موجي بين 0.5 سم إلى 30,000 متر)",
 "radio receiver": "جهاز استقبال لاسلكي, راديو (مستقبل إلكتروني يكشف عن الإشارات المرسلة ويفك تشكيلها ويضخمها)",
 "radio reflector": "تلسكوب راديوي, عاقس راديوي (تلسكوب فلكي يلتقط الإشعاعات الكهرومغناطيسية في نطاق الترددات الراديوية من مصادر خارج كوكب الأرض)",
 "radio set": "جهاز استقبال لاسلكي, راديو (مستقبل إلكتروني يكشف عن الإشارات المرسلة ويفك تشكيلها ويضخمها)",
 "radio signal": "إشارة راديوية (موجة راديوية تستخدم لإرسال واستقبال الرسائل)",
 "radio silence": "صمت إذاعي",
 "radio source": "مَصْدَر رَادْيَوِيّ (جسم يشع موجات راديوية)",
 "radio spectrum": "طيف راديوي (الطيف الكامل للترددات الكهرومغناطيسية المستخدمة للاتصالات؛ يشمل الترددات المستخدمة للراديو والرادار والتلفزيون)",
 "radio station": "مَحَطَّة إِذَاعِيَّة",
 "radio telescope": "مِقْرَاب رَادْيُوي, مِقْرَاب الكَاشُوفِي",
 "radio theater": "دراما إذاعية, مسرح إذاعي (أداء درامي صوتي بحت يبث على الراديو)",
