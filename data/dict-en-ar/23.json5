 "removal company": "شركة نقل, شركة نقل أثاث (شركة تقوم بنقل ممتلكات عائلة أو شركة من موقع إلى آخر)",
 "removal firm": "شركة نقل, شركة نقل أثاث (شركة تقوم بنقل ممتلكات عائلة أو شركة من موقع إلى آخر)",
 "remove": "نَقَلَ / أَزَالَ (أَزَاحَ ونَحَّى وأَبْعَدَ؛ خَلَعَ) / أَخْرَجَ / جَذَبَ (شَدَّ الشيءَ نحوه بقوة؛ لفَتَ الانتباه أو أثارَ الاهتمام)\nمثال: لا أزال عطشانا.",
 "removed": "بَعِيد زَمَنِيًّا, سَحِيق (منفصل أو متباعد في الزمن)",
 "remover": "ناقل أثاث (شخص يعمل لدى شركة تنقل الأثاث) / مزيل (مذيب يزيل مادة (عادة من سطح))\nمثال: مزيل الطلاء",
 "remuda": "ريموادا, قطيع الخيول البديلة (قطيع من الخيول يتم اختيار تلك التي ستستخدم في اليوم التالي منه)",
 "remunerated": "بِرَاتِب, يَتَقَاضَى أَجْرًا (يَتَلَقَّى تَعْوِيضًا مَالِيًّا أَوْ مُؤَهَّلٌ لِذَلِك)",
 "remuneration": "أَجْر, مُكَافَأَة (جزاء؛ هو المقابل المادّي الذي يتلقاه طرف أو أكثر نتيجة القيام بعمل) / أَجْر, رَاتِب (جزاء؛ هو المقابل المادّي الذي يتلقاه طرف أو أكثر نتيجة القيام بعمل)\nمثال: ركبت سيارة أجرة.",
 "remunerative": "مَأْجُور, مَدْفُوعُ الأَجْر (يُدْفَعُ مُقَابِلُهُ مَال) / مُدِرّ لِلْأَرْبَاح, مُرْبِح جِدًّا (ينتج ربحًا كبيرًا ووافرًا)",
 "remunerator": "دافع, مسدد (شخص يدفع المال مقابل شيء ما)",
 "remus": "رِمُوس",
 "renaissance": "نَهْضَة, عَصْر اَلنَّهْضَة / عَصْر اَلنَّهْضَة, اَلنَّهْضَة (مصدر للفعل \"عَصَرَ\"؛ أي مدة زمنية، دهر من الوقت)\nمثال: صلى زيري العصر.",
 "renaissance man": "رجل عصر النهضة (عالم خلال عصر النهضة كان (بسبب محدودية المعرفة) يستطيع معرفة كل شيء تقريباً حول العديد من المواضيع) / رجل نهضة حديث, عالم شمولي (عالم حديث في وضع يسمح له باكتساب أكثر من مجرد معرفة سطحية حول العديد من الاهتمامات المختلفة)\nمثال: يجب أن يكون الإحصائي ملماً بمجالات متعددة",
 "renaissance revival": "إحياء عمارة النهضة, عمارة النهضة الحديثة (تسمية شاملة تغطي العديد من أنماط الإحياء المعماري في القرن التاسع عشر التي لم تكن يونانية ولا قوطية بل استلهمت بدلاً من ذلك مجموعة واسعة من الأنماط…)",
 "renal": "كُلْوِيّ",
 "renal artery": "شريان كلوي (شريان ينشأ من الأبهر البطني ويغذي الكلى والغدد الكظرية والحوالب)",
 "renal calculus": "حَصَاةُ الكُلْيَة (حصاة تتكون في الكلية)",
 "renal colic": "مغص كلوي (ألم حاد في أسفل الظهر يمتد إلى الفخذ؛ يرتبط بمرور حصوة كلوية عبر الحالب)",
 "renal corpuscle": "جسيم ملبيغي, كرية كلوية (المحفظة التي تحتوي على محفظة بومان والكبيبة عند النهاية المتوسعة للنفرون)",
 "renal cortex": "قشرة الكلية (قشرة الكلية التي تحتوي على الكبيبات والأنابيب الملتوية)",
 "renal disorder": "اعتلال الكلية, مرض كلوي (مرض يصيب الكلى)",
 "renal failure": "فشل كلوي, قصور كلوي (عدم قدرة الكلى على إخراج الفضلات والمساعدة في الحفاظ على توازن الشوارد)",
 "renal insufficiency": "قصور كلوي (عدم كفاية إخراج الفضلات عن طريق الكلى)",
 "renal lithiasis": "حصى الكلى (وجود حصوات الكلى في الكلى)",
 "renal pelvis": "حوض الكلية (بنية تشبه القمع في مخرج الكلية يفرغ فيها البول قبل مروره إلى الحالب)",
 "renal vein": "وريد كلوي (أوردة ترافق الشرايين الكلوية؛ تفتح في الوريد الأجوف عند مستوى الفقرة القطنية الثانية)",
 "renanthera": "رَنَنْتِيرَة",
 "renascence": "عصر النهضة, نهضة (إحياء التعلم والثقافة) / انبعاث, تناسخ الأرواح (ولادة ثانية أو جديدة)",
 "renascent": "بَاعِث, نَاهِض (ينهض من جديد إلى حياة ونشاط متجدّدَيْن)",
 "renault": "رينو, رونو",
 "render": "جَعَلَ, صَيَّرَ (صَيَّرَ؛ أَنْشَأَ)\nمثال: جعل الأمور أسوء.",
 "rendering": "تأويل فني, تفسير (فعل تفسير شيء ما كما هو معبر عنه في أداء فني) / أداء, تقديم (إعطاء اعترافاً بالالتزام) / إظهار معماري, ريندر (رسم منظوري لتصميم مهندس معماري) / تلييس, قصارة (طبقة من الجص تطبق على جدار حجري)\nمثال: كان أداؤها لشعر ميلتون مؤثراً بشكل استثنائي",
 "rendering machine": "آلة لياسة (آلة للياسة الجدران)",
 "rendezvous": "لِقَاء مُحَدَّد, مَوْعِد (اجتماع مخطط له في وقت ومكان معينين) / لقاء, موعد غرامي (موعد؛ عادة مع شخص من الجنس الآخر) / مكان اللقاء, ملتقى (مكان يلتقي فيه الناس)\nمثال: كان ينتظرهم في مكان اللقاء",
 "rending": "شَاقّ, مُمَزِّق (يُشْبِه صَوْت تَمْزِيق عَنِيف كَصَوْت البَرْق المُشَقِّق لِلسَّمَاء)",
 "rendition": "تأويل فني, تفسير (فعل تفسير شيء ما كما هو معبر عنه في أداء فني) / تسليم استثنائي (تسليم السجناء إلى البلد الذي ارتكبت فيه الجريمة) / تأويل, تفسير (شرح لشيء ليس واضحاً على الفور) / أداء, تجسيد (أداء لمقطوعة موسيقية أو دور درامي وما إلى ذلك)\nمثال: كان أداؤها لشعر ميلتون مؤثراً بشكل استثنائي",
 "renegade": "مُرْتَدّ, مُنْشَقّ (تَخَلَّى عَنْ قَضِيَّة أَوْ مَبْدَأ) / خَائِن, مُرْتَدّ (شخص غير مخلص يخون أو يتخلى عن قضيته أو دينه أو حزبه السياسي أو صديقه، إلخ) / مرتد, منشق (شخص يتمرد ويصبح خارجاً عن القانون)",
 "renegade state": "دولة مارقة (دولة لا تحترم الدول الأخرى في أعمالها الدولية)",
 "renege": "مخالفة اللعب (خطأ عدم اتباع نفس نوع الورقة عند القدرة على ذلك)",
 "renew": "جَدَّدَ (الشيء: رممه أو أصلحه حتى صار كالجَدِيد؛ الكلام: أعاده من جديد) / جَدِد (الشيء: رممه أو أصلحه حتى صار كالجَدِيد؛ الكلام: أعاده من جديد)\nمثال: تعرف على أناس جدد.",
 "renewable": "قَابِل لِلتَّجْدِيد, مُتَجَدِّد (يمكن تجديده أو استبداله) / قابل للتجديد (يمكن تجديده أو تمديده)\nمثال: عقد إيجار قابل للتجديد",
