 "reflective": "تَأَمُّلِيّ, تَفَكُّرِيّ (مُكرَّس للشؤون الفكرية والعقلية) / عاكس (قادر على عكس الضوء أو الصوت فيزيائياً) / تَأَمُّلِيّ, مُتَدَبِّر (مُسْتَغْرِقٌ فِي تَفْكِيرٍ عَمِيقٍ وَجِدِّيّ)\nمثال: سطح عاكس",
 "reflective power": "البَيَاض, القُدْرَة العَاكِسَة (نسبة الضوء المنعكس إلى الضوء الساقط)",
 "reflectively": "بتأمل, بتفكير عميق (بطريقة تتسم بالتأمل والتفكير)\nمثال: راقبها بتأمل",
 "reflectiveness": "تأمل, تفكر (القدرة على التفكير الهادئ أو التأمل)",
 "reflectivity": "تأمل, تفكر (القدرة على التفكير الهادئ أو التأمل) / انعكاس, انعكاسية (القدرة على عكس الأشعة) / اِنْعِكَاسِيَّة, مُعَامِل الِانْعِكَاس (جزء الطاقة الإشعاعية الذي ينعكس عن سطح ما)",
 "reflectometer": "مقياس الانعكاس (مقياس يقيس انعكاسية السطح)",
 "reflector": "تلسكوب عاكس (تلسكوب بصري يتكون من مرآة مقعرة كبيرة تنتج صورة يتم تكبيرها بواسطة العدسة العينية) / عاكس (جهاز يعكس الإشعاع)\nمثال: اخترع إسحاق نيوتن التلسكوب العاكس في عام 1668",
 "reflex": "مُنْعَكَس",
 "reflex action": "رد فعل منعكس, منعكس (رد فعل تلقائي غريزي غير متعلم لمحفز)",
 "reflex angle": "زَاوِيَة مُنْعَكِسَة, زَاوِيَة مَعْكُوسَة",
 "reflex arc": "قوس انعكاسية (المسار العصبي للفعل المنعكس)",
 "reflex camera": "كاميرا عاكسة (كاميرا تتيح للمصور رؤية المشهد الدقيق الذي يتم تصويره والتركيز عليه)",
 "reflex epilepsy": "صرع انعكاسي (شكل من أشكال الصرع يتم تحفيز نوباته عن طريق تحفيز محيطي)",
 "reflex response": "رد فعل منعكس, منعكس (رد فعل تلقائي غريزي غير متعلم لمحفز)",
 "reflexed": "مُنْحَنٍ لِلْخَلْف, مُنْعَكِس ((للأوراق) مثنيّ إلى الأسفل والخارج بأكثر من تسعين درجة)",
 "reflexion": "انعكاس (صورة شيء ما كما تعكسها مرآة (أو مادة عاكسة أخرى)) / انْعِكَاس, صُورَة مِرْآتِيَّة (صورة مماثلة يكون فيها اليسار واليمين معكوسين) / انعكاس, انعكاسية (القدرة على عكس الأشعة) / تأمل, تفكر (تفكير هادئ ومطول ومركّز)\nمثال: تأمل انعكاسه في المرآة",
 "reflexive": "اِنْعِكَاسِيّ, ذَاتِيّ المَرْجِع (يشير ويرجع إلى نفسه) / اِنْعِكَاسِيّ, تِلْقَائِيّ (بِدُونِ إِرَادَةٍ أَوْ تَحَكُّمٍ وَاعٍ) / ضمير انعكاسي (ضمير شخصي يدل على أن فعل الفاعل يؤثر على الفاعل نفسه)",
 "reflexive pronoun": "ضَمِير اِنْعِكَاسِيّ (بمعنى اسم الفاعل ضَامِر، يستخدم للمبالغة؛ العنب الذابل لأنه قد ضمر)\nمثال: وكان الضحايا من الرجال والنساء والأطفال الأبرياء. ورغم ذلك اختارت القاعدة بلا ضمير قتل هؤلاء الأبرياء وتباهت بالهجوم وأكدت إلى الآن عزمها على ارتكاب القتل مجددا وبأعداد ضخمة",
 "reflexive verb": "فعل مطاوع, فعل منعكس (فعل يقوم فيه الفاعل بعمل موجه نحو نفسه)\nمثال: جملة 'اغتسل' تحتوي على فعل منعكس",
 "reflexively": "انعكاسياً, بشكل لا إرادي (بطريقة انعكاسية؛ بواسطة ردود الفعل)\nمثال: أجابت بشكل لا إرادي",
 "reflexiveness": "انْعِكَاسِيَّة ((المنطق والرياضيات) علاقة تكون قائمة بين العنصر ونفسه) / انْعِكَاسِيَّة (العلاقة الإحالية بين ضمير انعكاسي ومرجعه)",
 "reflexivity": "انْعِكَاسِيَّة ((المنطق والرياضيات) علاقة تكون قائمة بين العنصر ونفسه) / انْعِكَاسِيَّة (العلاقة الإحالية بين ضمير انعكاسي ومرجعه)",
 "reflexly": "انعكاسياً, بشكل لا إرادي (بطريقة انعكاسية؛ بواسطة ردود الفعل)\nمثال: أجابت بشكل لا إرادي",
 "reflexology": "ريفلعكسولوجي, علم المنعكسات (تدليك لتخفيف التوتر عن طريق ضغط الأصابع؛ يعتمد على الاعتقاد بوجود نقاط انعكاسية على القدمين واليدين والرأس متصلة بكل جزء من الجسم) / علم المنعكسات (دراسة الفعل المنعكس وعلاقته بسلوك الكائنات الحية)",
 "reflux": "انحسار, جزر (التدفق الخارجي للمد) / ارتجاع, جزر (تدفق غير طبيعي لسوائل الجسم إلى الخلف)",
 "reflux condenser": "مكثف ارتجاعي (مكثف يتم فيه تكثيف البخار فوق سائل يغلي فيتدفق مرة أخرى إلى الوعاء لمنع جفاف محتوياته من الغليان)",
 "refocusing": "إعادة التركيز (التركيز مرة أخرى)",
