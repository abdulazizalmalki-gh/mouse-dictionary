 "reality check": "صدمة الواقع, مواجهة الواقع (مناسبة يتم فيها تذكير المرء بطبيعة الأشياء في العالم الحقيقي)\nمثال: يهدف هذا البرنامج إلى مواجهة الواقع للرؤساء التنفيذيين",
 "reality principle": "مبدأ الواقع ((التحليل النفسي) المبدأ الحاكم للأنا؛ المبدأ القائل بأنه مع نمو الطفل يصبح مدركًا للبيئة الحقيقية والحاجة إلى التكيف معها)",
 "reality television": "تِلِفِزْيُون الْوَاقِع (تِلْفَاز)\nمثال: لنشاهد التلفزيون.",
 "realizable": "قَابِل لِلتَّحْقِيق, قَابِل لِلْإِنْجَاز (يمكن تحقيقه أو إنجازه؛ في حيّز الإمكان) / قَابِلٌ لِلتَّحْقِيق (يُمْكِنُ تَحْقِيقُهُ وَتَحْوِيلُهُ إِلَى قِيمَةٍ فِعْلِيَّة)",
 "realization": "تَحْقِيق",
 "realize": "حَقَّقَ (حَقَّقَ (الأمرَ): أثبتَه وصدَّقَه؛ ويقال: حَقَّقَ الظنَّ، وحَقَّقَ القولَ والقضيّةَ؛ حَقَّقَ (الشيءَ والأمرَ): أحكمه؛ ويقال: حَقَّقَ الثوبَ: أحكم نَسْجَه)\nمثال: و أخيرا حقق هدفه.",
 "realized": "مُحَقَّق, مُنْجَز (تمّ إنجازه أو إتمامه بنجاح)",
 "reallocation": "إعادة تخصيص, إعادة تقسيم (تقسيم جديد (خاصة تقسيم جديد لمقاعد الكونغرس في الولايات المتحدة على أساس نتائج التعداد)) / إعادة تخصيص (حصة تم تخصيصها مرة أخرى)",
 "reallotment": "إعادة تخصيص, إعادة تقسيم (تقسيم جديد (خاصة تقسيم جديد لمقاعد الكونغرس في الولايات المتحدة على أساس نتائج التعداد))",
 "really": "حَقًّا (حَقَا (حقاه) حقوا: أصاب حقوه، يقال ضربه فحقاه؛ (حَقَا)الشيء فلانا: بلغ حقوه، يقال نزل في الماء حتى حقاه فهو محقو ومحقي) / وَٱللّٰه؟ / لَيْسَ مَعْقُل!\nمثال: هو اغضبني حقا .",
 "realm": "حَيِّز",
 "realness": "حقيقة, واقع (حالة كونه فعلياً أو حقيقياً)\nمثال: اتضحت له حقيقة موقفه ببطء",
 "realpolitik": "وَاقِعِيَّة سِيَاسِيَّة (مؤنث وَاقِعيّ، المنسوبة إلى الوَاقِع، حَقِيقِيَّة؛ اسم لحالة الموصوف بأنه وَاقِعيّ)\nمثال: يجب أن نكون أكثر واقعية؛",
 "realtor": "ريالتر, سمسار عقارات عضو (وكيل عقاري عضو في الرابطة الوطنية للوسطاء العقاريين (في أمريكا))",
 "realty": "أملاك عقارية, عقار (ممتلكات تتكون من منازل وأراضٍ)",
 "ream": "رَزْمَة وَرَق (كمية من الورق؛ 480 أو 500 ورقة؛ الرزمة الواحدة تساوي 20 ملزمة) / رزمة, كمية كبيرة من الكتابة (كمية كبيرة من المواد المكتوبة)\nمثال: كتب رزم ورزم",
 "reamer": "مخرطة ثقوب, موسع ثقوب (مثقاب يستخدم لتشكيل أو توسيع الثقوب) / عصارة (عصارة ذات مركز مخروطي مضلع تستخدم لعصر العصير من الحمضيات)",
 "reanimated": "مُسْتَعَاد الحَيَوِيَّة, مُنْعَش (أُعيدت إليه الحيويّة والنشاط من جديد)",
 "reap": "حَصَدَ (قَطَعَ الزَّرْعَ وغيره من النبات بالمِنْجَل أو آلة الحصاد)\nمثال: حصد الفلاح القمح.",
 "reap hook": "مِنجل (أداة ذات حد لقطع العشب أو المحاصيل؛ لها شفرة منحنية ومقبض قصير)",
 "reaper": "حَصَّاد",
 "reaper binder": "آلة حصاد وربط (آلة تقطع الحبوب وتربطها في حزم)",
 "reaping hook": "مِنجل (أداة ذات حد لقطع العشب أو المحاصيل؛ لها شفرة منحنية ومقبض قصير)",
 "reappearance": "عودة, عودة الظهور (فعل ظهور شخص ما مرة أخرى) / ظهور مجدد, عودة ظهور (حدث ظهور شيء ما مرة أخرى)\nمثال: كانت عودة ظهوره في دور هاملت منتظرة منذ فترة طويلة",
 "reapportionment": "إعادة تخصيص, إعادة تقسيم (تقسيم جديد (خاصة تقسيم جديد لمقاعد الكونغرس في الولايات المتحدة على أساس نتائج التعداد))",
 "reappraisal": "إعادة تقييم, مراجعة (تقييم جديد أو تقدير جديد)",
 "rear": "خَلْفِيّ",
 "rear admiral": "أدميرال خلفي, لواء بحري (أدميرال أدنى رتبة من نائب أدميرال)",
 "rear end": "أرداف, ألية (الجزء اللحمي من جسم الإنسان الذي يجلس عليه)\nمثال: يستحق ركلة جيدة في مؤخرته",
 "rear lamp": "ضوء خلفي (مصباح (عادة أحمر) مثبت في مؤخرة مركبة آلية)",
 "rear light": "ضوء خلفي (مصباح (عادة أحمر) مثبت في مؤخرة مركبة آلية)",
 "rear of barrel": "مؤخرة الماسورة (فتحة في مؤخرة ماسورة البندقية حيث يمكن تحميل الرصاص)",
 "rear of tube": "مؤخرة الماسورة (فتحة في مؤخرة ماسورة البندقية حيث يمكن تحميل الرصاص)",
 "rear window": "نافذة خلفية (نافذة سيارة تسمح بالرؤية من الجزء الخلفي للسيارة)",
 "rearguard": "حرس المؤخرة (مفرزة مكلفة بحماية مؤخرة هيئة عسكرية (منسحبة))",
 "rearing": "تربية, تنشئة (مساعدة شخص ما على النمو ليكون عضواً مقبولاً في المجتمع) / مُتَنَمِّر, نَاهِض (واقف على الرِّجل الخلفيَّة اليسرى مع رفع القوائم الأماميَّة والرأس جانبيّاً) / تنشئة, رعاية (الخصائص المكتسبة نتيجة للطريقة التي عوملت بها كطفل)",
 "rearmament": "إعادة التسلح (فعل التسلح مرة أخرى)\nمثال: عارض إعادة تسليح اليابان بعد الحرب العالمية الثانية",
 "rearmost": "الأَبْعَد خَلْفًا, الأَخِير (يقع في أبعد نقطة نحو الخلف)",
 "rearrangement": "إعادة ترتيب (تغيير ترتيب شيء ما)",
 "rearview mirror": "مرآة الرؤية الخلفية (مرآة سيارة تعكس المنظر من النافذة الخلفية)",
 "rearward": "إلى الوراء, للخلف (عند أو إلى أو نحو الخلف أو المؤخرة) / رَجْعِيّ, نَحْو الخَلْف (موجه أو متحرك نحو المؤخرة والخلف) / اتجاه الخلف, خلف (الاتجاه نحو الخلف)\nمثال: تحرك للخلف",
 "rearwards": "إلى الوراء, للخلف (عند أو إلى أو نحو الخلف أو المؤخرة)\nمثال: تحرك للخلف",
 "reason": "عَقْل (أمسك بأطرافه وربطه، أصلها للشاة والإبل حيث تربط قوائمها كي تبقى باركة فلا تقوم؛ بلغ العَقْل، أصبح عاقلا فاهما راشدا)\nمثال: هي فتاة تسحر العقل.",
 "reasonable": "مَعْقُول (مربوط، قد عُقِلَ بالعِقَال؛ ما يمكن عَقْلَه بالعَقْل)\nمثال: زيري يخاف العناكب بصفة غير معقولة.",
 "reasonable care": "عناية واجبة (العناية التي يمارسها الرجل العاقل في ظل الظروف؛ المعيار لتحديد الواجب القانوني)",
 "reasonableness": "مَعْقُولِيَّة, وَجَاهَة (صفة كون الشيء معقولاً أو مقبولاً لشخص عاقل) / معقولية (الاعتدال في التوقعات) / اعتدال, تواضع (خاصية الاعتدال في السعر أو النفقات) / رَجَاحَة, مَعْقُولِيَّة (جودة العقل والحكم)\nمثال: شكك في وجاهة ادعاءاتي",
 "reasonably": "بِشَكْل مَنْطِقِيّ / بشكل معقول",
 "reasoned": "سَلِيمُ الحُجَّة, مُعَلَّل (صَحِيحٌ مَنْطِقِيًّا)",
 "reasoner": "مجادل منطقي, مستدل (شخص يستدل منطقياً)",
 "reasoning": "استدلال, تفكير منطقي (تفكير متماسك ومنطقي)",
 "reasoning backward": "استدلال تراجعي (التفكير المتضمن عند افتراض صحة النتيجة والتفكير العكسي للوصول إلى الأدلة)",
 "reasoning by elimination": "إقصاء, استدلال بالحذف (تحليل مشكلة إلى احتمالات بديلة يتبعه رفض منهجي للبدائل غير المقبولة)",
 "reasonless": "بِلَا سَبَب, بِلَا مُبَرِّر (ليس له سبب أو مبرر يبرره) / عَدِيمُ العَقْل, غَيْرُ عَاقِل (لا يتمتّع بملكة التفكير والاستدلال) / أَحْمَقُ, أَهْوَجُ (لا يتسم باستخدام العقل)",
 "reassembly": "إعادة تجميع, إعادة تصنيع (التجميع مرة أخرى)",
 "reassertion": "إعادة تأكيد (تأكيد متجدد)",
 "reassessment": "إعادة تقييم, مراجعة (تقييم جديد أو تقدير جديد)",
 "reassignment": "إعادة تعيين, إعادة تكليف (التعيين في واجب مختلف)",
 "reassurance": "طمأنة (فعل الطمأنة؛ استعادة ثقة شخص ما)",
 "reassured": "مُرْتَاح, مُطَمْأَن (استعاد ثقته وتحرّر من القلق)",
 "reassuring": "مُطَمْئِن (يعيد الثقة ويخفف القلق)\nمثال: ملاحظة مطمئنة جداً",
 "reassuringly": "بشكل مطمئن (بطريقة مطمئنة)\nمثال: أشار رئيس الوزراء بشكل مطمئن إلى صمت الصحافة البريطانية",
 "reata": "أنشوطة, وهق (حبل طويل ذو عقدة منزلقة يستخدم لصيد الحيوانات)",
 "reaumur scale": "مقياس ريومور (مقياس درجة حرارة يتجمد فيه الماء عند 0 درجة ويغلي عند 80 درجة)",
 "reaumur thermometer": "مقياس حرارة ريومور (مقياس حرارة كحولي مدرج بدرجات ريومور)",
 "reave": "نَهْب بِالْإِعْتِدَاء",
 "reb": "جوني ريب, متمرد (لقب أطلقه الجنود الفيدراليون على الجنود الكونفدراليين في الحرب الأهلية الأمريكية)",
 "rebab": "رَبَابَة",
 "rebarbative": "طَارِد, مُنَفِّر (يعمل على الصدّ أو يميل إلى النفور)",
 "rebate": "حز, فريز (أخدود مستطيل يُعمل لتثبيت قطعتين معاً) / استرداد جزئي, تخفيض (استرداد لجزء من المبلغ المدفوع)",
 "rebato": "رباتو, ياقة سلكية (ياقة مدعمة بسلك أو منشاة من الدانتيل المعقد؛ كانت ترتدى في القرن السابع عشر)",
 "rebecca": "رِفْقَة",
 "rebekah": "رِفْقَة",
 "rebel": "مُتَمَرِّد, مُتَمَرِّدَة / تَمَرَّدَ, يَتَمَرَّدُ",
 "rebellion": "ثَوْرَة, تَمَرُّد",
 "rebellious": "عَاصٍ",
 "rebelliously": "بتحد, بتمرد (بطريقة متمردة)\nمثال: رفض كلماتها بتمرد",
 "rebelliousness": "تَمَرُّد, عَدَم خُضُوع (فعل يتسم بالتمرد وعدم الخضوع) / تحد, عصيان (سلوك أو موقف محتقر عمداً)",
 "rebirth": "اعتناق, هداية (استنارة روحية تدفع الشخص لعيش حياة جديدة) / عصر النهضة, نهضة (إحياء التعلم والثقافة) / انبعاث, تناسخ الأرواح (ولادة ثانية أو جديدة) / تناسخ الأرواح (بعد الموت تبدأ الروح دورة جديدة من الوجود في جسم بشري آخر)",
 "reboot": "إِعَادَة التَّشْغِيل / أَعَادَ تَشْغِيل (كَرَّرَ؛ أَرْجَعَ، رَدَّ)\nمثال: أعاد توم كتابته.",
 "reborn": "مَوْلُودٌ مِنْ جَدِيدٍ, مُتَجَدِّدُ الْإِيمَانِ (وُلد من جديد روحياً أو اهتدى) / مُتَجَدِّدُ الحَيَوِيَّة, مُنْبَعِث (أُعيدت إليه الحياة والحيوية من جديد)",
 "rebound": "استحواذ على المرتدة, ريباوند (فعل تأمين حيازة كرة السلة المرتدة بعد تسديدة ضائعة) / ارتداد, رد فعل عكسي (رد فعل لأزمة أو نكسة أو إحباط) / ارتداد, انعكاس (حركة العودة من الارتطام)\nمثال: لا يزال في حالة ارتداد من وفاة زوجته",
 "rebound tenderness": "إيلام ارتدادي (ألم يُشعر به عند رفع اليد التي تضغط على البطن فجأة؛ عَرَض لالتهاب الصفاق)",
 "reboxetine": "إدروناكس, ريبوكسيتين (دواء مضاد للاكتئاب يمنع استرداد النوربينفرين)",
 "rebozo": "ريبوزو (وشاح طويل من الصوف أو الكتان يغطي الرأس والكتفين (يستخدم أيضاً كحمالة لحمل الطفل)؛ ترتديه النساء في أمريكا اللاتينية تقليدياً)",
 "rebroadcast": "إعادة بث (بث يتكرر في وقت لاحق)",
 "rebuff": "تجاهل, صد (فعل غير مهذب متعمد (عادة كتعبير عن الغضب أو الرفض)) / رفض, زجر (حالة من الإبعاد أو الصد)",
 "rebuilding": "إعادة بناء (البناء مرة أخرى)",
 "rebuke": "تَأْنِيب, تَوْبِيخ (فعل أو تعبير عن النقد واللوم)\nمثال: اضطر لتلقي التوبيخ بابتسامة على وجهه",
 "rebuker": "مؤنب, موبخ (شخص يجد الخطأ أو يلقي اللوم)",
 "rebukingly": "بتوبيخ, بشكل توبيخي (بأسلوب من يوجه اللوم أو التوبيخ)",
 "reburial": "إعادة دفن (فعل الدفن مرة أخرى)",
 "reburying": "إعادة دفن (فعل الدفن مرة أخرى)",
 "rebus": "رِيبُوس, لُغْز صُوَرِيّ (لغز حيث تقوم بفك تشفير رسالة تتكون من صور تمثل مقاطع وكلمات)",
 "rebuttal": "رد المدعى عليه الثاني (صَرَفَ، أَرْجَعَ؛ أَعَادَ، أَرْجَعَ. (يتعدى بإلى)) / تفنيد, نقض (الفعل الكلامي للدحض عن طريق تقديم حجة أو ادعاء معاكس)\nمثال: اليوم هناك برد.",
 "rebutter": "رد المدعى عليه الثاني (صَرَفَ، أَرْجَعَ؛ أَعَادَ، أَرْجَعَ. (يتعدى بإلى)) / مُدْحِض, مُفَنِّد (مناظر يدحض أو يفند من خلال تقديم أدلة أو حجج معاكسة)\nمثال: اليوم هناك برد.",
 "rec room": "غرفة استجمام, غرفة ترفيه (غرفة مجهزة للترفيه غير الرسمي)",
 "recalcitrance": "تمرد, شموس (سمة صعوبة الإدارة)",
 "recalcitrancy": "تمرد, شموس (سمة صعوبة الإدارة)",
 "recalcitrant": "عَنِيد, مُسْتَعْصٍ (يَتَّسِمُ بِالمُقَاوَمَةِ العَنِيدَةِ لِلسُّلْطَة) / جَمُوح, مُتَمَرِّد (يقاوم السلطة أو السيطرة بعناد شديد)",
 "recalculation": "إعادة حساب (فعل الحساب مرة أخرى (عادة لإزالة الأخطاء أو لتضمين بيانات إضافية))\nمثال: أسفرت إعادة الحساب عن قيمة أكبر بكثير",
 "recall": "ٱسْتَدْعى / تَذَكَّرَ (تذكَّر الشَّيءَ: ذكره، استحضره بعد نسيان، وفطِن له؛ تذكَّرتِ المرأةُ: تَشَبَّهَتْ بِالرَّجُلِ) / سَحْبٌ (سحب أو جذب شيئًا باتجاهه أو بعيدًا عنه؛ أزال أو سحب شيء من مكانه)\nمثال: ليلى تذكر سامي.",
 "recall dose": "جرعة داعمة, جرعة معززة (جرعة إضافية للتأكد من فعالية الجرعة الأولى)",
 "recantation": "تراجع, سحب كلام (تبرؤ أو تراجع عن تأكيد سابق)",
 "recap": "إطار مُجدد, إطار مُعاد تدويره (إطار سيارة مستعمل تم إعادة تشكيله لإعطائه نقوشاً جديدة) / استعراض موجز, خلاصة ختامية (ملخص في النهاية يكرر جوهر مناقشة أطول)",
 "recapitulate": "لَخَّصَ",
 "recapitulation": "إعادة عرض, استعادة ((موسيقى) تكرار الموضوعات التي تم تقديمها سابقًا (خاصة عند تأليف الجزء الأخير من الحركة)) / استعراض موجز, خلاصة ختامية (ملخص في النهاية يكرر جوهر مناقشة أطول) / إعادة العرض, التلخيص الموسيقي ((في الموسيقى) قسم من مقطوعة أو حركة موسيقية يتم فيه تكرار الموضوعات الموسيقية التي تم تقديمها سابقاً) / استعادة, تجدد (ظهور خصائص أو هياكل مختلفة أثناء التطور الجنيني كانت قد ظهرت خلال التاريخ التطوري للسلالة أو النوع)",
 "recapture": "استرداد, استعادة (فعل استعادة شيء ما) / استرداد الأرباح (استيلاء قانوني من قبل الحكومة على الأرباح التي تتجاوز مبلغاً ثابتاً)",
 "recasting": "إعادة صياغة (تغيير كلمة أو عبارة معينة)",
 "recce": "استطلاع (استطلاع (بالاختصار))",
 "recco": "استطلاع (استطلاع (بالاختصار))",
 "reccy": "استطلاع (استطلاع (بالاختصار))",
 "receding": "ابتعاد, انحسار (فعل الابتعاد أو التراجع) / انحسار, خفوت (اختفاء بطيء أو تدريجي)",
 "receipt": "إِيصَال",
 "receipts": "إيراد إجمالي, مقبوضات (المبلغ الكامل للدخل قبل إجراء أي خصومات)",
 "receivable": "مُسْتَحَقّ القَبْض (بانتظار التحصيل أو السداد)",
 "receivables": "ذمم مدينة, مقبوضات (الأموال التي تتوقع حالياً استلامها من سندات أو حسابات)",
 "receive": "اِسْتَقْبَلَ, اِسْتَلَمَ (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه) / اِسْتَقْبَلَ, يَسْتَقْبِل (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه)\nمثال: استقبل توم الضيوف.",
 "received": "مَقْبُول, مُتَعَارَفٌ عَلَيْه (مَقْبُولٌ عَلَى نِطَاقٍ وَاسِعٍ بِاعْتِبَارِهِ صَحِيحًا أَوْ جَدِيرًا بِالاعْتِبَار) / فصيح, معياري (لغة) (يتوافق مع الاستخدام اللغوي الراسخ للمتحدثين الأصليين المتعلمين)\nمثال: الإنجليزية (الأمريكية) القياسية",
 "received pronunciation": "النطق المستلم (النطق المعتمد للإنجليزية البريطانية؛ كان يستند في الأصل إلى إنجليزية الملك كما يتحدث بها في المدارس العامة وفي جامعتي أكسفورد وكامبريدج)",
 "received pronunciation language": "النطق المستلم (النطق المعتمد للإنجليزية البريطانية؛ كان يستند في الأصل إلى إنجليزية الملك كما يتحدث بها في المدارس العامة وفي جامعتي أكسفورد وكامبريدج)",
 "receiver": "مِذْيَاع, رَادِيُو / سَمَّاعَة",
 "receiver-creditor relation": "عَلَاقَة الحَارِس القَضَائِيّ بِالدَّائِن (مسؤولية الحارس القضائي أو أمين الإفلاس في التصرف بما يخدم مصلحة الدائن)",
 "receivership": "حراسة قضائية (منصب الحارس القضائي) / حراسة قضائية (إجراء قضائي يضع الممتلكات تحت سيطرة حارس قضائي أثناء التقاضي حتى يمكن الحفاظ عليها لصالح الجميع) / حراسة قضائية (حالة الممتلكات التي تكون في يد حارس قضائي)\nمثال: الشركة تحت الحراسة القضائية",
 "receiving set": "جهاز استقبال لاسلكي, راديو (مستقبل إلكتروني يكشف عن الإشارات المرسلة ويفك تشكيلها ويضخمها)",
 "receiving system": "مستقبل, نظام استقبال (جهاز يستقبل إشارات الراديو أو التلفزيون)",
 "recency": "حداثة عهد, قرب العهد (خاصية الحدوث أو الظهور منذ وقت غير بعيد) / حداثة عهد (وقت يسبق الحاضر مباشرة)",
 "recent": "أَخِير, جَدِيد",
 "recently": "مُؤَخَّرًا / حَدِيثًا / بِأَخَرَة",
 "recentness": "حداثة عهد, قرب العهد (خاصية الحدوث أو الظهور منذ وقت غير بعيد) / حداثة عهد (وقت يسبق الحاضر مباشرة)",
 "receptacle": "حاوية, مستوعب (حاوية تستخدم لوضع الأشياء أو حفظها بداخلها) / مأخذ, مِقبس (تجهيزة كهربائية (أو إلكترونية) متصلة بمصدر طاقة ومجهزة لاستقبال قابس) / تخت (طرف متضخم للساق يحمل الأجزاء الزهرية)",
 "reception": "اِسْتِقْبَال / اِسْتِقْبَال, حَفْلَة اِسْتِقْبَال",
 "reception desk": "مكتب الاستقبال (منضدة (كما في الفندق) يتم فيها استقبال الضيوف)",
 "reception line": "صف الاستقبال (صف من الأشخاص (المضيفين وضيوف الشرف) الذين يرحبون بالضيوف في حفل استقبال)",
 "reception room": "غرفة الاستقبال (غرفة لاستقبال وترفيه الزوار (كما في منزل خاص أو فندق))",
 "receptionist": "مُوَظَّف الْاِسْتِقْبَال, مُوَظَّفَةُ الْاِسْتِقْبَال",
 "receptive": "سَمَّاع",
 "receptive aphasia": "حبسة استقبالية, حبسة حسية (حبسة تتميز بكلام طلق ولكنه لا معنى له وضعف شديد في القدرة على فهم الكلمات المنطوقة أو المكتوبة)",
 "receptively": "بتقبل, برحابة صدر (بطريقة تدل على التقبل والاستعداد للأخذ)",
 "receptiveness": "انفتاح, تقبل (الاستعداد أو الجاهزية للتلقي (خاصة الانطباعات أو الأفكار))\nمثال: كان يختبر تقبل الحكومة للإصلاح",
 "receptivity": "انفتاح, تقبل (الاستعداد أو الجاهزية للتلقي (خاصة الانطباعات أو الأفكار))\nمثال: كان يختبر تقبل الحكومة للإصلاح",
 "receptor": "مُسْتَقْبِل",
 "recess": "رَدْب",
 "recessed": "غَائِر, مُتَنَحٍّ (يشبه الكوّة أو الحنيّة في تجويفه) / غَائِر, مُنْخَفِض (ذو منطقة غائرة أو منخفضة عن السطح)",
 "recession": "تَرَاجُع",
 "recessional": "انسحابي, ختامي (من أو متعلق بالانسحاب أو التراجع (خاصة في السياق الديني كترتيلة ختامية)) / ترنيمة الانصراف, نشيد الختام (ترنيمة تُغنى في نهاية الخدمة بينما ينسحب رجال الدين والجوقة) / مَوْكِب خُرُوج (انسحاب رجال الدين والجوقة من الهيكل إلى غرفة الملابس في نهاية خدمة الكنيسة)",
 "recessional march": "مارش الانصراف, مارش الموكب (مارش يُعزف للمواكب)",
 "recessionary": "تراجعي, ركودي (من أو متعلق بالركود)",
 "recessive": "مُتَنَحٍّ",
 "recessive allele": "أليل متنحي (أليل ينتج نمطه الظاهري المميز فقط عندما يكون أليله المقترن مطابقاً)",
 "recessive gene": "جين متنحي (جين ينتج نمطه الظاهري المميز فقط عندما يكون أليله مطابقاً)\nمثال: الجين المتنحي للعيون الزرقاء",
 "rechargeable": "قَابِل لِإِعَادَة الشَّحْن (يمكن إعادة شحنه واستخدامه مجدّدًا)",
 "rechauffe": "طعام مُسخّن (بقايا طعام مُعاد تسخينها)",
 "recherche": "بَالِغُ الأَنَاقَة, رَائِع (أنيق ومصقول بشكل بالغ)",
 "rechewed food": "جرة (طعام يجتره الحيوان المجتر ليعيد مضغه)",
 "recidivism": "عَوْد (قطعة من الخشب كالعصا جمعه عيدان؛ ما يُتَبَخَّر به)\nمثال: أشعلت عود ثقاب.",
 "recidivist": "عائد للخطيئة, منتكص (شخص يعود إلى أنماط سلوك سابقة غير مرغوب فيها) / عائد للإجرام (شخص يُعتقل بشكل متكرر بسبب سلوك إجرامي (خاصة لنفس السلوك الإجرامي))",
 "recife": "رِيسِيفِي",
 "recipe": "وَصْفَة",
 "recipient": "مُسْتَلِم, مُسْتَلِمَة",
 "recipient role": "المتلقي (الدور الدلالي للكيان الحي الذي يشارك بشكل سلبي في الحدث الذي يدل عليه الفعل)",
 "reciprocal": "مُتَبَادَل / مَقْلُوب",
 "reciprocal cross": "تهجين تبادلي (تهجين يتضمن زوجاً من التزاوجات التي تعكس الجنسين المرتبطين بكل نمط جيني)",
 "reciprocal inhibition": "تثبيط متبادل, كف متبادل (طريقة للعلاج السلوكي تعتمد على تثبيط استجابة واحدة بحدوث استجابة أخرى غير متوافقة معها بشكل متبادل؛ قد يتم تكييف استجابة الاسترخاء مع حافز كان يثير…)",
 "reciprocal ohm": "سيمنز, مو (وحدة للموصلية تساوي مقلوب الأوم)",
 "reciprocal pronoun": "ضمير تبادلي (ضمير أو عبارة ضميرية (مثل 'بعضهم البعض') تعبر عن فعل متبادل أو علاقة بين الأفراد المشار إليهم في الفاعل الجمع)\nمثال: جملة 'اهتموا ببعضهم البعض' تحتوي على ضمير تبادلي",
 "reciprocal-inhibition therapy": "تثبيط متبادل, كف متبادل (طريقة للعلاج السلوكي تعتمد على تثبيط استجابة واحدة بحدوث استجابة أخرى غير متوافقة معها بشكل متبادل؛ قد يتم تكييف استجابة الاسترخاء مع حافز كان يثير…)",
 "reciprocality": "تَبَادُلِيَّة (علاقة اعتماد أو عمل أو تأثير متبادل)",
 "reciprocally": "بالمقابل, عكسياً (بطريقة عكسية أو متبادلة) / بشكل متبادل (بطريقة متبادلة أو مشتركة) / في المقابل (في تبادل أو رد)\nمثال: مرتبط عكسياً",
 "reciprocate": "بَادَلَ / تَبَادَلَ, رَدَّ",
 "reciprocating engine": "محرك ترددي (محرك احتراق داخلي يتم فيه تدوير العمود المرفقي بواسطة مكابس تتحرك صعوداً وهبوطاً في أسطوانات)",
 "reciprocating saw": "منشار ترددي, منشار صابر (منشار آلي محمول بشفرة ترددية؛ يمكن استخدامه مع مجموعة متنوعة من الشفرات حسب التطبيق ونوع القطع؛ يحتوي عموماً على لوحة تركب على السطح الذي يتم قطعه)",
 "reciprocation": "أخذ وعطاء, تبادل (تفاعل متبادل؛ نشاط المبادلة (خاصة المعلومات)) / حركة ترددية (حركة متناوبة ذهاباً وإياباً) / مُبَادَلَة, مُعَامَلَة بِالمِثْل (فعل صنع أو القيام بشيء ما في المقابل)",
 "reciprocative": "تَرَدُّدِيّ, مُتَذَبْذِبٌ (يتحرك بالتناوب إلى الأمام والخلف) / تَبَادُلِيّ, مُتَبَادَلٌ (يُعطى أو يُفعل أو يُستحق لكل طرف تجاه الآخر)",
 "reciprocatory": "تَرَدُّدِيّ, مُتَذَبْذِبٌ (يتحرك بالتناوب إلى الأمام والخلف) / تَبَادُلِيّ, مُتَبَادَلٌ (يُعطى أو يُفعل أو يُستحق لكل طرف تجاه الآخر)",
 "reciprocity": "معاملة بالمثل (تبادل متبادل لامتيازات تجارية أو غيرها) / تَبَادُلِيَّة (علاقة اعتماد أو عمل أو تأثير متبادل)",
 "recirculation": "إعادة التداول (التداول مرة أخرى)",
 "recission": "إلغاء, فسخ العقد ((في القانون) فعل الفسخ؛ إلغاء العقد وإعادة الأطراف إلى المراكز التي كانوا عليها لو لم يتم إبرام العقد)\nمثال: يمكن أن يتم الفسخ بموجب مرسوم أو بالتراضي",
 "recital": "حَيْثِيَّة",
 "recitalist": "عازف منفرد (موسيقي يقدم حفلات موسيقية منفردة)",
 "recitation": "تِلَاوَة",
 "recitative": "إلقاء منغم, رسيتاتيف (مقطع صوتي لنص سردي يلقيه المغني بالإيقاعات الطبيعية للكلام)",
 "recite": "تَلَا (قَرَأَ، نحو: تَلُوتُ القرآن تلاوةً أي قرأته؛ اتّبَعَ، نحو: تلا الكتاب والسنة، أو تبع فلان في عمله وسار على نهجه)",
 "reciter": "قارئ, مُلقي (شخص يلقي من الذاكرة)",
 "reckless": "مُتَهَوِّر",
 "recklessly": "باستهتار, بتهور (بطريقة متهورة)",
 "recklessness": "تَهَوُّر (التسرع والاندفاع لفعل شيء دون التفكير بالنتائج)\nمثال: إنه خطر أن تقود بتهور.",
 "reckoner": "جدول حسابي (كتيب جداول يستخدم لتسهيل الحساب) / حاسب, مُحسِّب (خبير في الحساب (أو في تشغيل الآلات الحاسبة))",
 "reckoning": "إحصاء, عد (فعل العد؛ تلاوة الأرقام بترتيب تصاعدي) / حساب, عملية حسابية (حل المشكلات الذي يتضمن أرقاماً أو كميات) / حساب, كشف الحساب (فاتورة بمبلغ مستحق)\nمثال: استمر العد لعدة ساعات",
 "reclaimable": "قَابِلٌ لِإِعَادَةِ الاِسْتِخْدَام, قَابِلٌ لِلتَّدْوِير (يُمْكِنُ اسْتِخْدَامُهُ مَرَّةً أُخْرَى)",
 "reclaimed": "مُسْتَرَدّ, مُنْقَذ (تمّ إنقاذه من الخطر)",
 "reclamation": "استصلاح, تدوير (استعادة المواد المفيدة من النفايات) / إصلاح, تقويم (الإنقاذ من الخطأ والعودة إلى المسار الصحيح) / إعادة تأهيل, استصلاح (تحويل الأرض البور إلى أرض صالحة للسكن أو الزراعة)\nمثال: إصلاح الأطفال الجانحين",
 "reclassification": "إعادة تصنيف (تصنيف شيء ما مرة أخرى (عادة في فئة جديدة))",
 "recliner": "كرسي استلقاء, كرسي قابل للإمالة (كرسي بذراعين يمكن خفض ظهره ورفع مسند القدمين للسماح للجالس بالاستلقاء فيه)",
 "reclining": "اتكاء, استلقاء (فعل اتخاذ أو الحفاظ على وضعية الاستلقاء)",
 "reclining chair": "كرسي استلقاء, كرسي قابل للإمالة (كرسي بذراعين يمكن خفض ظهره ورفع مسند القدمين للسماح للجالس بالاستلقاء فيه)",
 "recluse": "مُعْتَزِل, مُنْزَوٍ (منسحب من المجتمع ويطلب العزلة) / زاهد, معتزل (من يعيش في عزلة)",
 "reclusive": "مُنْتَبِذ, مُنْعَزِل (يُوفِّر الخصوصية أو العزلة) / مُعْتَزِل, مُنْزَوٍ (منسحب من المجتمع ويطلب العزلة)",
 "reclusiveness": "اعتزال, انعزالية (الميل لتفضيل العزلة أو الانفراد)",
 "recoding": "إعادة ترميز (التحويل من رمز إلى آخر)",
 "recognisable": "يُمْكِن التَّعَرُّف عَلَيْه (قابل للتمييز أو التعرّف عليه)",
 "recognisance": "تعهد, كفالة شخصية ((قانون) ضمان يتم الدخول فيه أمام محكمة بشرط أداء فعل يقتضيه القانون؛ وعند الفشل في أداء ذلك الفعل يتم مصادرة مبلغ)",
 "recognised": "مَقْبُول, مُعْتَرَف بِه (حائز على القبول العامّ أو يفرض الاعتراف) / ذُو سُمْعَة, مُعْتَرَف بِه (يتمتّع بسمعة راسخة ومعترف بها)",
 "recognition": "إذن بالكلام (تعيين من قبل رئيس الجلسة يمنح الشخص الحق في التحدث في هيئة تداولية) / تحديد الهوية, تعرف (عملية التعرف على شيء ما أو شخص ما عن طريق التذكر) / إدراك, اعتراف (الوصول إلى فهم شيء ما بوضوح وتميز) / إقرار, اعتراف (قبول (مثل قبول ادعاء) على أنه حقيقي وصالح)\nمثال: لم يتمكن من تقديم اقتراحه لأنه لم يحصل على إذن بالكلام من الرئيس",
 "recognizable": "يُمْكِن التَّعَرُّف عَلَيْه (قابل للتمييز أو التعرّف عليه) / سَهْلُ التَّعَرُّف, وَاضِح (يُدْرَكُ بِسُهُولَةٍ؛ سَهْلُ المُلَاحَظَة)",
 "recognizably": "بشكل ملحوظ, بشكل يمكن التعرف عليه (لدرجة يمكن التعرف عليها)\nمثال: كان أنحف بشكل ملحوظ الآن",
 "recognizance": "تعهد, كفالة شخصية ((قانون) ضمان يتم الدخول فيه أمام محكمة بشرط أداء فعل يقتضيه القانون؛ وعند الفشل في أداء ذلك الفعل يتم مصادرة مبلغ)",
 "recognize": "تَعَرَّفَ",
 "recognized": "مَقْبُول, مُعْتَرَف بِه (حائز على القبول العامّ أو يفرض الاعتراف) / ذُو سُمْعَة, مُعْتَرَف بِه (يتمتّع بسمعة راسخة ومعترف بها)",
 "recoil": "ارتداد, انعكاس (حركة العودة من الارتطام) / ارتداد (الرجوع الخلفي المفاجئ للبندقية عند إطلاقها)",
 "recoilless": "عديم الارتداد (مكون من أو كونه سلاحاً مصمماً لتقليل الارتداد)",
 "recollect": "تَذَكَّرَ (تذكَّر الشَّيءَ: ذكره، استحضره بعد نسيان، وفطِن له؛ تذكَّرتِ المرأةُ: تَشَبَّهَتْ بِالرَّجُلِ)\nمثال: ليلى تذكر سامي.",
 "recollection": "استدعاء, تذكر (عملية التذكر (وخاصة عملية استعادة المعلومات بجهد ذهني)) / استرجاع, تذكر (القدرة على استدعاء الأحداث الماضية) / استذكار, ذكرى مستعادة (شيء تم استدعاؤه إلى الذهن)\nمثال: لديه استدعاء كامل للحلقة",
 "recollective": "حافظ, قوي الذاكرة (جيد في التذكر)\nمثال: عقل حافظ",
 "recombinant": "مؤتلف (خلية أو كائن حدث فيه إعادة تركيب جيني) / مؤتلف, معاد التركيب (مكون من أو متعلق بالحمض النووي المؤتلف)",
 "recombinant deoxyribonucleic acid": "حمض نووي معاد التركيب (حمض نووي معدل وراثياً يُصنع عن طريق إعادة دمج أجزاء من الحمض النووي من كائنات حية مختلفة)",
 "recombinant dna": "حمض نووي معاد التركيب (حمض نووي معدل وراثياً يُصنع عن طريق إعادة دمج أجزاء من الحمض النووي من كائنات حية مختلفة)",
 "recombinant dna technology": "هندسة وراثية (تكنولوجيا إعداد الحمض النووي المؤتلف في المختبر عن طريق تقطيع جزيئات الحمض النووي وربط الأجزاء معاً من أكثر من كائن حي)",
 "recombinant human insulin": "إنسولين بشري مؤتلف, هيومولين",
 "recombinant protein": "بروتين معاد التركيب (بروتين مشتق من حمض نووي معاد التركيب)",
 "recombination": "إعادة التركيب ((في علم الوراثة) دمج جينات أو صفات تختلف عما كانت عليه في الوالدين) / إعادة الالتحام ((في الفيزياء) اتحاد الشحنات أو انتقال الإلكترونات في غاز يؤدي إلى معادلة الأيونات؛ مهم للأيونات الناتجة عن مرور الجسيمات عالية الطاقة)",
 "recommencement": "استئناف, عودة (البدء مرة أخرى)",
 "recommend": "وَصَّى, أَوْصَى / يوصي يقترح, نصح",
 "recommendation": "تَوْصِيَة",
 "recompense": "مُكَافَأَة, بَدَل",
 "reconcilable": "قابل للتوفيق, ممكن المصالحة (يمكن التوفيق بينه أو مصالحته)\nمثال: طريقة تفكيرها قابلة للتوفيق مع طريقتي",
 "reconcile": "أَصْلَحَ بَيْنَ, وَفَّقَ بَيْنَ / وَفَّقَ",
