 "rhapsodic": "مَسْحُور, مُبْتَهِج (يشعر بنشوة أو سرور بالغ)",
 "rhapsodically": "بِابْتِهَاج غَامِر, بِنَشْوَة (بطريقة منتشية)\nمثال: تفاعل بابتهاج غامر مع خطتي للسفر إلى أفريقيا",
 "rhapsody": "رابسودية, ملحمة غنائية ((في اليونان القديمة) قصيدة ملحمية معدة للإلقاء) / راپسودي, ملحمة موسيقية ((موسيقى) تكوين آلي حر في حركة ممتدة واحدة؛ عادة ما يكون عاطفياً أو حماسياً في طابعه) / حماسة مفرطة, نشوة (تعبير متحمس عن العاطفة)\nمثال: أهازيج الفرح",
 "rhea": "ريا (الأكبر من طائرين طويلين سريعي الجري لا يطيران يشبهان النعام ولكنهما بثلاثة أصابع؛ يوجد من البرازيل إلى باتاغونيا) / ريا صغيرة (الأصغر من طائرين طويلين سريعي الجري لا يطيران يشبهان النعام ولكنهما بثلاثة أصابع؛ يوجد من بيرو إلى مضيق ماجلان)",
 "rhea americana": "ريا (الأكبر من طائرين طويلين سريعي الجري لا يطيران يشبهان النعام ولكنهما بثلاثة أصابع؛ يوجد من البرازيل إلى باتاغونيا)",
 "rhea silvia": "ريا سيلفيا ((الأساطير الرومانية) عذراء فيستال أصبحت أماً للتوأمين رومولوس وريموس من المريخ)",
 "rhenish": "رايني (من أو متعلق بنهر الراين والأراضي المجاورة له) / نبيذ الراين, هوك (أي من أنواع النبيذ الأبيض المتعددة من وادي نهر الراين في ألمانيا)\nمثال: خمور الراين تميل إلى الحلاوة",
 "rhenium": "رِينِيُوم",
 "rheologic": "انسيابي, ريولوجي (من أو يتعلق بالريولوجيا (علم الانسياب))",
 "rheological": "انسيابي, ريولوجي (من أو يتعلق بالريولوجيا (علم الانسياب))",
 "rheology": "علم الانسياب, علم الريولوجيا (فرع الفيزياء الذي يدرس تشوه وتدفق المادة)",
 "rheometer": "ريومتر, مقياس الانسيابية (أداة لقياس تدفق السوائل (خاصة الدم الشرياني))",
 "rheostat": "ريوستات, مقاومة متغيرة (مقاومة لتنظيم التيار)",
 "rhesus": "مكاك ريسوسي (يعيش في جنوب آسيا؛ يُستخدم في الأبحاث الطبية)",
 "rhesus factor": "العامل الرايزيسي, عامل ريزوس (مستضد فصيلة الدم يمتلكه الأشخاص إيجابيو العامل الرايزيسي)",
 "rhesus monkey": "مكاك ريسوسي (يعيش في جنوب آسيا؛ يُستخدم في الأبحاث الطبية)",
 "rhetoric": "بَلَاغَة, فَصَاحَة (مطابَقةُ الكلام لمقتضى الحال أو حُسْن البَيَانِ وقوَّةُ التأثير؛ قُدرة المتكلِّم على البيان والتأثير)",
 "rhetorical": "بلاغي, خطابي (يميل للبلاغة، مؤكداً على الأسلوب على حساب الفكر) / بلاغي, خطابي (من أو يتعلق بالبلاغة وفن الخطابة)\nمثال: مجرد زخرفة بلاغية",
 "rhetorical accent": "نبر بلاغي (توكيد خاص يوضع بشكل استثنائي على نغمات لا تخضع للنبر النحوي)",
 "rhetorical device": "أداة بلاغية, محسن بديعي (استخدام للغة يخلق تأثيراً أدبياً (ولكن غالباً دون اعتبار للمعنى الحرفي))",
 "rhetorical language": "لغة بلاغية, لغة خطابية (لغة مصممة لإقناع الآخرين أو التأثير عليهم)\nمثال: استخدم مارتن لوثر كينغ جونيور لغة بلاغية لتوصيل وجهة نظره بأن الجميع يجب أن يعاملوا على قدم المساواة",
 "rhetorical question": "اِسْتِفْهَام مَجَازِيّ",
 "rhetorically": "بلاغياً (بطريقة بلاغية)\nمثال: سأل بلاغياً: 'ما الذي يمكن فعله؟'",
 "rhetorician": "خطيب, مفوّه (شخص يلقي خطابًا أو خطبة)",
 "rheum": "غَمَص / رَمَص ((رَمِصَتِ) العينُ: اجتمع في مُوقِها وَسَخٌ أبيضُ. ويقال: (رَمِصَ) فلانٌ فهو أرْمَصُ، وهي رَمْصاءُ. والجمع: رُمْصٌ)",
 "rheum australe": "راوند الهيمالايا, راوند هندي (عشب آسيوي (من الهيمالايا))",
 "rheum cultorum": "راوند الحدائق",
 "rheum emodi": "راوند الهيمالايا, راوند هندي (عشب آسيوي (من الهيمالايا))",
 "rheum palmatum": "راوند صيني, راوند كفي (يستخدم منذ فترة طويلة لخصائصه الملينة)",
 "rheum rhabarbarum": "راوند الحدائق",
 "rheum rhaponticum": "راوند الحدائق",
 "rheumatic": "رُوماتِيزْمِيّ, مَفْصِلِيّ (مُتَعَلِّق بِالتِهاب المَفاصِل أو الرُّوماتِيزْم) / رُوماتِيزْمِيّ (شخص يعاني من الروماتيزم)",
 "rheumatic aortitis": "التهاب الأبهر الروماتيزمي (التهاب الأبهر الذي يحدث في الحمى الروماتيزمية)",
 "rheumatic fever": "حمى روماتيزمية (مرض شديد يصيب الأطفال بشكل رئيسي ويتميز بالتهاب مؤلم في المفاصل وغالباً تلف في صمامات القلب)",
 "rheumatic heart disease": "مرض القلب الروماتزمي (مرض القلب الناجم عن نوبات متكررة من الحمى الروماتيزمية؛ يتميز بتغيرات في عضلة القلب أو تندب في صمامات القلب مما يقلل من قدرة القلب على ضخ الدم)",
 "rheumatism": "رَثْيَة",
 "rheumatism weed": "دفل شائع, قاتل الكلب الشائع (نبات معمر في أمريكا الشمالية له أزهار وردية في نورات محدودة سائبة؛ يستخدم في الطب الشعبي لعلاج الألم أو الالتهاب في المفاصل) / دفل كندي, قنب هندي (دفل كندي ينتج أليافاً قوية يستخدمها الأمريكيون الأصليون كحبال؛ يستخدم في الطب الشعبي لألم المفاصل أو الالتهابات)",
 "rheumatoid": "رُوماتِيزْمِيّ, مَفْصِلِيّ (مُتَعَلِّق بِالتِهاب المَفاصِل أو الرُّوماتِيزْم)",
 "rheumatoid arthritis": "الدَّاء الرَثَيَانِيّ, اِلْتِهَاب المَفَاصِل الرُّومَاتُويِدِيّ",
 "rheumatoid factor": "عامل الروماتويد (جسم مضاد ذاتي يوجد عادة في مصل الأشخاص المصابين بالتهاب المفاصل الروماتويدي)",
 "rheumatoid spondylitis": "التهاب الفقار المقسط (شكل مزمن من التهاب الفقار يصيب الذكور بشكل أساسي ويتميز بضعف حركة العمود الفقري)",
 "rheumatologist": "أخصائي روماتيزم (طبيب متخصص في الأمراض الروماتيزمية)",
 "rheumatology": "طب الروماتيزم (فرع الطب المعني بدراسة وعلاج أمراض العضلات أو الأوتار أو المفاصل)",
 "rheumy": "رُوماتِيزْمِيّ, مَفْصِلِيّ (مُتَعَلِّق بِالتِهاب المَفاصِل أو الرُّوماتِيزْم) / رَطْب, نَدِيّ (رطب وندِيّ (يُوصف به الهواء خاصّةً))",
 "rhibhus": "ريبوس (واحد من ثلاثة حرفيين للآلهة الهندوسية)",
 "rhinal": "أنفي (من أو في أو يتعلق بالأنف)\nمثال: ممرات أنفية",
 "rhincodon typus": "قرش حوت (قرش مرقط كبير يعيش في المياه السطحية الدافئة في جميع أنحاء العالم؛ يشبه الحوت ويتغذى بشكل رئيسي على العوالق)",
 "rhine": "نَهْر اَلرَّايْن (صَارَ عَصَبِيًّا وغَضِبَ؛ أَصَابَ الشَّيْءَ أو الكَائِنَ بِغَضَبٍ أو صَارَ يَأْمُرُهُ)\nمثال: عبر جوناس النهر.",
 "rhine wine": "نبيذ الراين, هوك (أي من أنواع النبيذ الأبيض المتعددة من وادي نهر الراين في ألمانيا)",
 "rhineland": "رَايْنْلَانْد",
 "rhinencephalon": "دماغ شمي (مركز في نصفي الكرة المخية يحكم حاسة الشم في الحيوانات الدنيا؛ وفي البشر يبدو أنه يتوسط السلوك العاطفي المعقد)",
 "rhinestone": "حجر الراين (ماس مقلد مصنوع من البلور الصخري أو الزجاج أو المعجون)",
 "rhinion": "راينيون (الطرف الأمامي عند نهاية درز عظام الأنف)",
 "rhinitis": "التهاب الأنف, زكام (التهاب الغشاء المخاطي المبطن للأنف (يرتبط عادة بإفرازات أنفية))",
 "rhino": "كركدن, وحيد القرن (حيوان عاشب ضخم قوي مفرد الأصابع من جنوب شرق آسيا وأفريقيا ذو جلد سميك جداً وقرن واحد أو قرنين على الخطم)",
 "rhinoceros": "وَحِيد اَلْقَرْن, كَرْكَدَّن",
 "rhinoceros antiquitatis": "وحيد القرن الصوفي (نوع منقرض كثيف الشعر من المناطق القطبية)",
 "rhinoceros beetle": "خنفساء وحيد القرن (أي من خنافس كبيرة استوائية بشكل رئيسي متنوعة لها قرون على الرأس؛ آفة على جوز الهند)",
 "rhinoceros unicornis": "وحيد القرن الهندي (له قرن واحد)",
 "rhinolaryngologist": "طبيب أنف وأذن وحنجرة (أخصائي في اضطرابات الأذن أو الأنف أو الحنجرة)",
 "rhinolaryngology": "طب الأنف والأذن والحنجرة (التخصص الطبي الذي يتعامل مع أمراض الأذن والأنف والحنجرة)",
 "rhinonicteris aurantius": "خفاش برتقالي, خفاش حدوة الحصان البرتقالي (خفاش شائع في شمال غرب أستراليا ذو فرو برتقالي أو أصفر)",
 "rhinopathy": "اعتلال الأنف (أي مرض أو تشوه في الأنف)",
 "rhinophyma": "فيمة الأنف (تضخم الأنف مع توسع الجريبات واحمرار وبروز الأوعية الدموية في الجلد)",
 "rhinoplasty": "تجميل الأنف (جراحة تجميلية لتحسين مظهر الأنف)",
 "rhinoptera bonasus": "لخمة أنف البقرة (لخمة كبيرة توجد على طول الساحل الشرقي لأمريكا الشمالية)",
 "rhinorrhea": "ثر أنفي, سيلان الأنف (إفراز مخاطي مائي مستمر من الأنف (كما في نزلات البرد))",
 "rhinoscope": "منظار الأنف (أداة طبية تتكون من مرآة مثبتة بزاوية على قضيب؛ تستخدم لفحص الممرات الأنفية (عبر البلعوم الأنفي))",
 "rhinoscopy": "تنظير الأنف (فحص الممرات الأنفية (إما من خلال المنخر الأمامي أو بمنظار الأنف من خلال البلعوم الأنفي))",
 "rhinosporidiosis": "داء التبقع الأنفي (عدوى فطرية في الأنف؛ تُكتسب غالبًا أثناء السباحة)",
 "rhinostenosis": "تضيق الأنف (تضيق الممرات في تجويف الأنف)",
 "rhinotomy": "بضع الأنف (إجراء جراحي يتم فيه عمل شق في الأنف لتصريف الصديد المتراكم)",
 "rhinotracheitis": "التهاب الأنف والقصبة الهوائية (عدوى تنفسية في الأنف والحلق في الماشية)",
 "rhinovirus": "فَيْرُوس أَنْفِيّ",
 "rhizoctinia": "ريزوكتينيا (أي فطر ينتمي الآن أو سابقاً إلى الجنس الشكلي ريزوكتينيا)",
 "rhizoctinia disease": "مرض الرايزوكتونيا (مرض تسببه فطريات الرايزوكتونيا)",
 "rhizoctinia solani": "فطر البطاطس (فطر يسبب مرضاً في البطاطس يتميز ببقع قشرية سوداء على الدرنات)",
 "rhizoid": "أشباه الجذور (أي من الخيوط الرفيعة المختلفة التي تعمل كجذور في الطحالب والسراخس والفطريات وما إلى ذلك)",
 "rhizoidal": "شبه جذري (من أو متعلق بأشباه الجذور)",
 "rhizomatous": "جذموري (ينتج أو يمتلك أو يشبه الجذور (الجذامير))",
 "rhizomatous begonia": "بيغونيا جذمورية (أي من العديد من البيغونيا التي لها سيقان زاحفة بارزة أو جذامير)",
 "rhizome": "جذمور (ساق نبات أفقية ذات براعم فوق وجذور تحت تعمل كهيكل تكاثري)",
 "rhizomorph": "جذمور فطري (كتلة كثيفة من الخيوط الفطرية تشكل هيكلاً يشبه الجذر يميز العديد من الفطريات)",
 "rhizophora mangle": "قرم, مانغروف (شجرة أو شجيرة استوائية تحمل ثماراً تنبت وهي لا تزال على الشجرة ولها العديد من الجذور الداعمة التي تشكل في النهاية كتلة لا يمكن اختراقها وتعتبر مهمة…)",
 "rhizopod": "جذري الأرجل (أوالي تتميز بوجود قدم كاذبة)",
 "rhizopodan": "جذري الأرجل (أوالي تتميز بوجود قدم كاذبة)",
 "rhizopogon idahoensis": "ريزوبوجون أيداهو (ريزوبوجون كبير مبيض يصبح رمادياً بنياً عند النضج)",
 "rhizopus": "ريزوبوس (أي من الفطريات المسببة للعفن المختلفة من جنس ريزوبوس)",
 "rhizopus nigricans": "عفن الخبز (عفن من جنس ريزوبوس)",
 "rhizopus stolonifer": "عفن الخبز الأسود, فطر العفن الجاف (فطر يسبب عفناً مائياً ليناً في الفواكه والخضروات وحلقات من العفن الجاف حول جذور البطاطا الحلوة)",
 "rhizotomy": "بضع الجذر (إجراء جراحي يتم فيه قطع جذور الأعصاب الشوكية؛ يجرى (للجذور الأمامية) لتخفيف الألم المستعصي أو (للجذور الخلفية) لوقف التشنجات العضلية الشديدة)",
 "rho": "رُو",
 "rhodanthe": "رودانث",
 "rhodanthe manglesii": "رودانث",
 "rhode island": "رُود آيْلَانْد",
 "rhode island bent": "أغروستيس مخملي, عشبة منحنية مخملية (عشبة شائعة بسيقان نحيلة وأوراق ضيقة)",
 "rhode island red": "دجاج رود آيلاند الأحمر (سلالة أمريكية من الدجاج ثقيل الجسم بني محمر متعدد الأغراض)",
 "rhode islander": "رود آيلاندي (مواطن أو مقيم في رود آيلاند)",
 "rhodes": "رُودُس",
 "rhodes grass": "عشبة رودس (عشبة معمرة من جنوب أفريقيا أدخلت إلى الولايات المتحدة؛ تزرع كعشبة علف في المناطق الجافة)",
 "rhodes scholar": "باحث رودس (طالب حاصل على إحدى المنح الدراسية الموقوفة بوصية سيسيل رودس للدراسة في جامعة أكسفورد)",
 "rhodesian": "روديسي (مكون من أو متعلق بدولة روديسيا السابقة (زيمبابوي حالياً))",
 "rhodesian man": "إنسان روديسيا (إنسان بدائي يشبه إنسان نياندرتال ولكنه عاش في أفريقيا)",
 "rhodesian ridgeback": "كلب روديسيا ذو العرف (كلب صيد أفريقي قوي قصير الشعر له عرف من الشعر المعكوس على طول العمود الفقري)",
 "rhodium": "رُودِيُوم",
 "rhodochrosite": "رودوكروزيت (معدن يتكون من كربونات المنغنيز؛ مصدر للمنغنيز)",
 "rhododendron": "رودودندرون, وردية الشجر (أي شجيرة من جنس رودودندرون: شجيرات دائمة الخضرة أو أشجار شجيرية صغيرة ذات أوراق جلدية وعناقيد مبهرجة من الزهور الجريسية (على شكل جرس))",
 "rhododendron californicum": "ردندرة الساحل (ردندرة متوسطة الحجم من ساحل المحيط الهادئ لأمريكا الشمالية لها زهور وردية كبيرة منقطة بالبني)",
 "rhododendron maxima": "دفلية, ردندرة عظمى (ردندرة تزهر في أواخر الربيع من شرق أمريكا الشمالية لها زهور وردية إلى وردية أرجوانية)",
 "rhododendron maximum": "دفلية, ردندرة عظمى (ردندرة تزهر في أواخر الربيع من شرق أمريكا الشمالية لها زهور وردية إلى وردية أرجوانية)",
 "rhododendron viscosum": "أزاليا المستنقعات (شجيرة تنمو في المستنقعات في جميع أنحاء شرق الولايات المتحدة ولها زهور بيضاء إلى وردية صغيرة تشبه زهر العسل)",
 "rhodolite": "رودوليت (نوع أحمر أو وردي من العقيق يستخدم كحجر كريم)",
 "rhodomontade": "عجرفة, غطرسة (تفاخر فارغ ومغرور)",
 "rhodonite": "رودونيت (معدن وردي أو أحمر يتكون من سيليكات المنغنيز البلورية؛ يستخدم كحجر زينة)",
 "rhodophyta": "الطحالب الحمراء, قسم الطحالب الحمراء (نباتات دنيا؛ غالباً طحالب حقيقية النواة بحرية وساحلية)",
 "rhodopsin": "أرجوان بصري, رودوبسين (خضاب ضوئي أحمر في العصي الشبكية للفقاريات؛ يتحلل إلى ريتينال بواسطة الضوء)",
 "rhodosphaera rhodanthema": "سماق أسترالي (شجرة دائمة الخضرة من أستراليا تنتج خشباً أصفر داكناً)",
 "rhodymenia palmata": "دلسي (عشب بحري أحمر خشن صالح للأكل)",
 "rhomb": "معين (متوازي أضلاع بأربعة أضلاع متساوية)",
 "rhombencephalon": "دماغ خلفي (الجزء الخلفي من الدماغ بما في ذلك المخيخ وجذع الدماغ)",
 "rhombic": "معيني (يشبه المعين)",
 "rhombohedral": "ثُلَاثِيّ, مُعَيَّنِيّ السُّطُوح (ذو تناظر ثلاثي)",
 "rhombohedron": "موشور معيني (متوازي سطوح يحده ستة أوجه متشابهة (إما معينات أو متوازيات أضلاع))",
 "rhomboid": "شبه منحرف, معيني (على شكل معين أو شبه منحرف) / عضلة معينية (أي من عدة عضلات في الجزء العلوي من الظهر تساعد في تحريك لوح الكتف) / شبه معين (متوازي أضلاع أضلاعه المتجاورة غير متساوية في الطول)\nمثال: أشكال معينية",
 "rhomboid minor muscle": "معينية صغرى (عضلة معينية تسحب لوح الكتف باتجاه العمود الفقري وإلى الأعلى قليلاً)",
 "rhomboid muscle": "عضلة معينية (أي من عدة عضلات في الجزء العلوي من الظهر تساعد في تحريك لوح الكتف)",
 "rhomboidal": "شبه منحرف, معيني (على شكل معين أو شبه منحرف)\nمثال: أشكال معينية",
 "rhomboideus major muscle": "معينية كبرى (عضلة معينية تسحب لوح الكتف باتجاه العمود الفقري)",
 "rhombus": "مُعَيِّن",
 "rhonchus": "غطيط (صوت مثل الصفير أو الشخير يسمع بالسماعة الطبية أثناء الزفير حيث يمر الهواء عبر قنوات مسدودة)",
 "rhone wine": "نبيذ الرون (أي من أنواع النبيذ المتعددة من وادي نهر الرون في فرنسا)",
 "rhubarb": "رَاوَنْد",
 "rhubarb pie": "فطيرة الراوند (فطيرة تحتوي على راوند مقطع وكثير من السكر)",
 "rhubarb plant": "راوند (نباتات ذات سيقان أوراق حمضية خضراء أو حمراء طويلة تنمو في كتل قاعدية؛ السيقان (والسيقان فقط) صالحة للأكل عند طهيها؛ الأوراق سامة)",
 "rhumb": "دِيرَة / خَنّ ((خَنَّ) فلان خنينا: خرج صوت بكائه أو ضحكه من أنفه وبكى دون الانتحاب؛ (خَنَّ) فلان القوم خنا: وطئ مخنتهم)",
 "rhumb line": "خط الاتجاه الثابت (خط على كرة يقطع جميع خطوط الزوال بنفس الزاوية؛ المسار الذي تسلكه سفينة أو طائرة تحافظ على اتجاه بوصلة ثابت)",
 "rhumba": "رومبا (رقصة صالونات تعتمد على الرقص الشعبي الكوبي) / رومبا (رقصة شعبية بإيقاع ثنائي نشأت في كوبا بعناصر إسبانية وأفريقية؛ تتميز بحركات أقدام معقدة وحركة عنيفة) / رومبا (موسيقى ذات إيقاع متقطع في زمن ثنائي لرقص الرومبا)",
 "rhus aromatica": "سماق عطري (سماق ذو رائحة حلوة في شرق أمريكا ذو أوراق ثلاثية وزهور خضراء مصفرة في سنابل تشبه النورات الهرية تليها ثمار حمراء مشعرة)",
 "rhus copallina": "سماق قزم, سماق لامع (شجيرة شائعة غير سامة في شرق أمريكا الشمالية بأوراق مركبة وزهور خضراء عنقودية تليها ثمار حمراء)",
 "rhus dermatitis": "التهاب الجلد السماقي (التهاب جلد تماسي ناتج عن ملامسة نباتات من جنس السماق السام)",
 "rhus diversiloba": "بلوط سام غربي (شجيرة سامة في ساحل المحيط الهادئ لأمريكا الشمالية تسبب طفحاً جلدياً عند اللمس)",
 "rhus glabra": "سماق أملس, سماق قرمزي (شجيرة شائعة غير سامة في شرق أمريكا الشمالية بأوراق مركبة شمعية وزهور خضراء عنقودية تليها ثمار حمراء)",
 "rhus laurina": "سماق الغار, مالوسما (شجيرة عطرية صغيرة دائمة الخضرة من كاليفورنيا لها أوراق عنقودية وتوت مبيض؛ في بعض التصنيفات تدرج في جنس السماق)",
 "rhus ovata": "سماق السكر, سماق بيضوي (شجيرة دائمة الخضرة في جنوب شرق الولايات المتحدة ذات سنابل من الزهور الصفراء المحمرة وثمار مشعرة غدية)",
 "rhus quercifolia": "بلوط سام شرقي (شجيرة سامة في جنوب شرق الولايات المتحدة تسبب طفحاً جلدياً عند اللمس)",
 "rhus radicans": "لبلاب سام (نبات متسلق شائع في شرق ووسط الولايات المتحدة بأوراق ثلاثية وأزهار مخضرة يليها توت أبيض؛ ينتج زيتاً مهيجاً يسبب طفحاً جلدياً عند اللمس)",
 "rhus rhodanthema": "سماق أسترالي (شجرة دائمة الخضرة من أستراليا تنتج خشباً أصفر داكناً)",
 "rhus toxicodenedron": "بلوط سام شرقي (شجيرة سامة في جنوب شرق الولايات المتحدة تسبب طفحاً جلدياً عند اللمس)",
 "rhus trilobata": "سماق الظربان, سماق ثلاثي الفصوص (شجيرة متساقطة الأوراق في كاليفورنيا ذات أوراق كريهة الرائحة عادة ما تكون ثلاثية الوريقات وثمار صالحة للأكل)",
 "rhus typhina": "سماق قرن الوعل, سماق مخملي (شجرة شجيرية متساقطة الأوراق في شرق أمريكا الشمالية بأوراق مركبة تتحول إلى اللون الأحمر اللامع في الخريف وعناقيد كثيفة من الزهور الصفراء المخضرة تليها…)",
 "rhus verniciflua": "شجرة اللك, شجرة الورنيش (شجرة آسيوية صغيرة تفرز مادة سامة يتم الحصول منها على اللك (الورنيش))",
 "rhus vernix": "سم الشجر, سماق سام (شجيرة مستنقعات أمريكية ملساء ذات أوراق ريشية وأزهار مخضرة يليها توت أبيض مخضر؛ تنتج زيتاً مهيجاً)",
 "rhyacotriton olympicus": "سمندل أولمبي (سمندل شبه مائي صغير واسع العينين من شمال غرب الولايات المتحدة)",
 "rhyme": "سَجْع (نَطَقَ، تَكَلَّمَ بأسلوب مُوزون؛ في نحو: التكرار في الجملة مما يؤدي إلى التأثير في المعنى، غالبًا بما يتناسب مع الوزن)",
 "rhyme royal": "القافية الملكية (شكل مقطع يحتوي على سبعة أسطر من الخماسي اليامبي؛ قدمه تشوسر)",
 "rhymed": "مسجوع, مقفى (له أصوات متطابقة خاصة الأصوات النهائية)\nمثال: شعر مقفى",
 "rhymeless": "غير مقفى, مرسل (ليس له قافية)\nمثال: كتابة الشعر المرسل غير المقفى تشبه لعب التنس بدون شبكة",
 "rhymer": "شويعر, ناظم القوافي (كاتب يؤلف القوافي؛ صانع أبيات رديئة (تستخدم عادة كعبارة ازدراء للشعراء القصر أو الدونيين))",
 "rhymester": "شويعر, ناظم القوافي (كاتب يؤلف القوافي؛ صانع أبيات رديئة (تستخدم عادة كعبارة ازدراء للشعراء القصر أو الدونيين))",
 "rhyming": "مسجوع, مقفى (له أصوات متطابقة خاصة الأصوات النهائية)\nمثال: شعر مقفى",
 "rhyming slang": "عامية مقفاة (عامية تستبدل الكلمات بكلمات أو تعبيرات مقفاة ثم تحذف عادة المكون المقفى)",
 "rhynchoelaps australis": "ثعبان مرجاني أسترالي (ثعبان صغير سام ولكنه غير ضار (للإنسان عادة) معلم بالأسود والأبيض على خلفية حمراء)",
 "rhyolite": "ريوليت (صخر بركاني حمضي جداً)",
 "rhythm": "إِيقَاع",
 "rhythm and blues": "آر أند بي, ريذم أند بلوز (مزيج من البلوز والجاز تم تطويره في الولايات المتحدة بواسطة موسيقيين سود؛ مقدمة مهمة للروك أند رول)",
 "rhythm and blues musician": "موسيقي آر أند بي (متعلق أو له صلة بالموسيقى؛ الشخض الذي يعزف أو يؤلف الموسيقى، كمهنة أو هواية)\nمثال: سيبدأ الفيلم الموسيقي قريبا.",
 "rhythm method": "طريقة التقويم, طريقة العد (تنظيم الأسرة الطبيعي الذي يُفترض فيه حدوث الإباضة قبل 14 يوماً من بدء الدورة الشهرية)",
 "rhythm method of birth control": "طريقة التقويم, طريقة العد (تنظيم الأسرة الطبيعي الذي يُفترض فيه حدوث الإباضة قبل 14 يوماً من بدء الدورة الشهرية)",
 "rhythm section": "قسم الإيقاع (قسم الفرقة أو الأوركسترا الذي يعزف على آلات الإيقاع)",
 "rhythmic": "إيقاعي, موزون (يتكرر بانتظام موزون)\nمثال: الدقات الإيقاعية لأجراس الكنيسة",
 "rhythmic pattern": "إيقاع شعري, عروض ((عروض) نظام للنظم الشعري)",
 "rhythmical": "إيقاعي, موزون (يتكرر بانتظام موزون)\nمثال: الدقات الإيقاعية لأجراس الكنيسة",
 "rhythmically": "بإيقاع, بشكل إيقاعي (بطريقة إيقاعية)\nمثال: تأرجح الكرسي بشكل إيقاعي ذهاباً وإياباً",
 "rhythmicity": "إيقاعية (الخاصية الإيقاعية التي تضفيها النبرات والمدد النسبية للنغمات في قطعة موسيقية)",
 "rhytidectomy": "شد الوجه (جراحة تجميلية لإزالة التجاعيد وعلامات الشيخوخة الأخرى من الوجه؛ يتم عمل شق قرب خط الشعر وشد الجلد واستئصال الأنسجة الزائدة)\nمثال: بعض الممثلات يقمن بأكثر من عملية شد وجه",
 "rhytidoplasty": "شد الوجه (جراحة تجميلية لإزالة التجاعيد وعلامات الشيخوخة الأخرى من الوجه؛ يتم عمل شق قرب خط الشعر وشد الجلد واستئصال الأنسجة الزائدة)\nمثال: بعض الممثلات يقمن بأكثر من عملية شد وجه",
 "rial": "رِيَال (العُمْلَة الرسمية لدى)",
 "riant": "ضَاحِك, مُبْتَهِج (يُظهِر أو يَشعُر بالمَرَح أو السُّرور أو السَّعادة)",
 "riata": "أنشوطة, وهق (حبل طويل ذو عقدة منزلقة يستخدم لصيد الحيوانات)",
 "rib": "ضِلْع",
 "rib cage": "القَفَص الصَدْرِيّ",
 "rib joint pliers": "زرادية مفصلية (نوع من الزرادية يمكن تحريك محورها لتوسيع نطاق قبضتها)",
 "rib roast": "ريش للتحمير, شواء الضلع (قطعة من اللحم (بقر أو غزال) تشمل أكثر من ضلع واللحم الموجود على الجانب الخارجي للأضلاع)",
 "ribald": "خَلِيع, مَاجِن (فاحش بطريقة فكاهيّة ومرحة) / بذيء, سليط اللسان (شخص بذيء؛ يستخدم لغة فاحشة ومهينة)",
 "ribaldry": "بذاءة, فحش (سلوك أو لغة تقترب من الفجاجة) / فُكَاهَة بَذِيئَة, مُجُون (فكاهة ماجنة)",
 "riband": "شريط زينة, وشاح (شريط يستخدم كزينة)",
 "ribavirin": "ريبافيرين, فيرازول (عامل مضاد للفيروسات يُستنشق (الاسم التجاري فيرازول) قد يستخدم لعلاج الالتهابات الفيروسية الخطيرة)",
 "ribband": "شريط زينة, وشاح (شريط يستخدم كزينة)",
 "ribbed": "مضلع (مزود أو مقوى بأضلاع) / مُضَلَّع (ذو أضلاع أو حزوز بارزة)",
 "ribbed toad": "ضفدع مذنب (ضفدع من غرب أمريكا الشمالية بعضو تزاوج يشبه الذيل)",
 "ribbed vault": "قبو مضلع (قبو يشبه القبو المتقاطع ولكنه يحتوي على أقواس مضلعة)",
 "ribbing": "إغاظة, تهكم (فعل مضايقة شخص ما بمرح أو بخبث (خاصة عن طريق السخرية)؛ استفزاز شخص ما بمضايقات مستمرة) / تضليع (هيكل من الأضلاع)\nمثال: تجاهل تهكمهم",
 "ribbon": "شَرِيط",
 "ribbon development": "تطوير شريطي (مجمع مباني في صف مستمر على طول الطريق)",
 "ribbon fern": "سرخس الشريط, لسان الأفعى المتدلي (سرخس هوائي بسعف يشبه الشريط وعادة ما يكون ملتوياً في آسيا الاستوائية وبولينيزيا وأمريكا) / سرخس الشريط, سرخس العشب (سرخس هوائي يوجد في غابات الأراضي المنخفضة في أمريكا الاستوائية) / سرخس الشريط, سرخس العنكبوت (سرخس من شمال إفريقيا وجزر الأزور وجزر الكناري)",
 "ribbon grass": "عشب الشريط, عشب القصب الكناري (عشب معمر في مروج المستنقعات والخنادق له أوراق عريضة؛ أوروبا وأمريكا الشمالية)",
 "ribbon snake": "ثعبان الشريط (ثعبان رباط نحيل مخطط بالأصفر من أمريكا الشمالية؛ يفضل الأماكن الرطبة)",
 "ribbon tree": "خشب الشريط, شجرة الشريط (شجرة نيوزيلندية نفضية ينتج لحاؤها الداخلي أليافاً قوية تشبه الكتان وتسمى قطن نيوزيلندا)",
 "ribbon worm": "دودة خرطومية, دودة شريطية (ديدان بحرية رخوة غير مقسمة لها خرطوم يشبه الخيط والقدرة على التمدد والتقلص)",
 "ribbon-leaved water plantain": "مزمار الراعي شريطي الأوراق (صنف من مزمار الراعي (أليسما غرامينيوم))",
 "ribbon-shaped": "شَرِيطِيّ الشَّكْل (على شكل شريط)",
 "ribbonfish": "سمكة الشريط (سمكة بحرية لها جسم طويل مضغوط يشبه الشريط) / سمكة المجداف, ملك الرنجة (سمكة استوائية رفيعة تعيش في المياه العميقة يتراوح طولها بين 20 و 30 قدماً ولها زعنفة ظهرية حمراء)",
 "ribbonlike": "شَرِيطِيّ (طَوِيلٌ وَرَقِيقٌ؛ يُشْبِهُ الشَّرِيط)",
 "ribbonwood": "خشب الشريط, لحاء الدانتيل (شجرة صغيرة أو شجيرة من نيوزيلندا ذات غزارة في عناقيد إبطية من الزهور البيضاء الورقية برائحة العسل والتي يستخدم لحاؤها للحبال) / خشب الشريط, شجرة الشريط (شجرة نيوزيلندية نفضية ينتج لحاؤها الداخلي أليافاً قوية تشبه الكتان وتسمى قطن نيوزيلندا)",
 "ribbony": "شَرِيطِيّ (طَوِيلٌ وَرَقِيقٌ؛ يُشْبِهُ الشَّرِيط)",
 "ribes grossularia": "عنب الثعلب, كشمش شائك (شجيرة أوراسية شائكة لها زهور مخضرة مشوبة بالأرجواني وتوت بيضاوي أصفر مخضر أو أحمر أرجواني)",
 "ribes nigrum": "ريباس أسود, كشمش أسود (كشمش مزروع على نطاق واسع يحمل ثماراً سوداء عطرية صالحة للأكل)",
 "ribes rubrum": "ريباس أحمر, كشمش أحمر (كشمش أوروبي مزروع يحمل ثماراً حمراء صغيرة صالحة للأكل)",
 "ribes sanguineum": "ريباس دموي, كشمش شتوي (شجيرة مزهرة تعرف أيضاً باسم الكشمش المزهر أو الكشمش أحمر الأزهار)",
 "ribes sativum": "كشمش أبيض (كشمش حدائق يحمل ثماراً بيضاء صغيرة)",
 "ribes uva-crispa": "عنب الثعلب, كشمش شائك (شجيرة أوراسية شائكة لها زهور مخضرة مشوبة بالأرجواني وتوت بيضاوي أصفر مخضر أو أحمر أرجواني)",
 "ribgrass": "لسان الحمل السهاني, لسان الحمل ضيق الأوراق (نبات لسان حمل من العالم القديم بأوراق مضلعة ضيقة طويلة راسخ في المناطق المعتدلة)",
 "ribhus": "ريبوس (واحد من ثلاثة حرفيين للآلهة الهندوسية)",
 "ribier": "عنب ريبيير (عنب مائدة أرجواني محمر داكن من كاليفورنيا)",
 "ribless": "بلا أضلاع, غير مضلع (ليس له أضلاع أو أضلاع ظاهرة)",
 "riblike": "شَبِيهٌ بِالضِّلْع (يشبه الضلع في شكله)",
 "riboflavin": "ريبوفلافين, فيتامين ب2 (فيتامين ب يمنع الآفات الجلدية وفقدان الوزن)",
 "ribonuclease": "ريبو نوكلياز",
 "ribonucleic acid": "حمض نووي ريبوزي\nمثال: الحمض النووي الريبوزي هو المادة الوراثية لبعض الفيروسات (أصبح حامضًا، تغير الطعم إلى الحموضة؛ ارتفعت نسبة الحموضة في شيء ما، كما في الطعام أو السوائل)\nمثال: رمى ياني الحمض على وجه سكورة.",
 "ribonucleinase": "ريبو نوكلياز",
 "ribose": "ريبوز (سكر خماسي مهم كأحد مكونات الحمض النووي الريبوزي)",
 "ribosome": "ريبوسوم (عضية في سيتوبلازم الخلية الحية؛ ترتبط بالرنا المرسال وتتحرك لأسفل كودوناً واحداً في كل مرة ثم تتوقف حتى يجلب الرنا الناقل الحمض الأميني المطلوب؛…)\nمثال: الريبوسوم هو موقع تخليق البروتين",
 "ribwort": "لسان الحمل السهاني, لسان الحمل ضيق الأوراق (نبات لسان حمل من العالم القديم بأوراق مضلعة ضيقة طويلة راسخ في المناطق المعتدلة)",
 "rice": "أَرُزّ, رُزّ ((أَرَزَّت) الجرادةُ: رَزَّت)\nمثال: هكذا نطهي الأرز",
 "rice beer": "ساكي, نبيذ الأرز (مشروب كحولي ياباني مصنوع من الأرز المخمر؛ يُقدم عادة ساخناً)",
 "rice cooker": "طباخة أرز, قدر طهي الأرز (جهاز مطبخ آلي مصمم لسلق أو طهي الأرز بالبخار)",
 "rice flour": "دَقِيق الْأَرُزّ, أَرُزّ مَسْحُوق (ضد الغَلِيْظ، الرَفِيْع الرَقِيْق؛ صغير الحجم جدا)\nمثال: ساعتي غير دقيقة.",
 "rice grass": "عشبة الأرز (أي عشبة من جنس أوريزوبسيس)",
 "rice paddy": "حقل أرز (حقل مروي أو مغمور يُزرع فيه الأرز)",
 "rice paper": "ورق الأرز (مادة رقيقة ناعمة تشبه الورق؛ مصنوعة من شجرة ورق الأرز)",
 "rice rat": "جرذ الأرز (جرذ رشيق قوي التحمل يعيش في المستنقعات العشبية في المكسيك وجنوب شرق الولايات المتحدة)",
 "rice soup": "شوربة الأرز (حساء يحتوي على الأرز والخضروات)",
 "rice steamer": "طباخة أرز, قدر طهي الأرز (جهاز مطبخ آلي مصمم لسلق أو طهي الأرز بالبخار)",
 "rice weevil": "سوسة الأرز (سوسة بنية تغزو الحبوب المخزنة وخاصة الأرز)",
 "rice-grain fritillary": "أجراس المهمة, فريتيلاريا (عشبة من شمال غرب أمريكا ذات أزهار خضراء وأرجوانية على شكل جرس)",
 "ricebird": "عصفور الأرز, عصفور جاوة (طائر نساج إندونيسي صغير يشبه العصفور يتردد على حقول الأرز) / بوبولينك (طائر مغرد أمريكي مهاجر)",
 "ricegrass": "عشبة الأرز (أي عشبة من جنس أوريزوبسيس)",
 "ricer": "هراسة بطاطس (أداة مطبخ تستخدم لهرس الأطعمة اللينة عن طريق ضغطها عبر ثقوب صغيرة)",
 "rich": "غَنِيّ",
 "rich man": "غَنِيّ, غَنِيَّة",
 "rich people": "أثرياء, أغنياء (الناس الذين يمتلكون ممتلكات وثروة (يُعتبرون كمجموعة))\nمثال: فقط الأغنياء جداً يستفيدون من هذا التشريع",
 "rich person": "ثري, غني (شخص يمتلك ثروة مادية كبيرة)",
 "rich woman": "امرأة ثرية (امرأة غنية)",
 "richard": "رِيتْشَارْد",
 "richard roe": "ريتشارد رو (طرف مجهول أو وهمي في إجراءات قانونية)",
 "richardson ground squirrel": "سنجاب ريتشاردسون الأرضي (من مناطق الميرمية والمراعي في غرب الولايات المتحدة وكندا)",
 "richardson vole": "فأر الماء, فأر ريتشاردسون (أكبر فأر حقل في غرب أمريكا الشمالية)",
 "richardson's geranium": "غرنوقي ريتشاردسون (غرنوقي من غرب أمريكا الشمالية له عناقيد متفرعة من الزهور البيضاء أو الوردية الباهتة)",
 "richea dracophylla": "شجرة العشب الأسترالية (شجيرة أسترالية قوية بأوراق ضيقة مزدحمة في نهايات الفروع وعناقيد طرفية من الزهور البيضاء أو الوردية)",
 "richea pandanifolia": "خلنج شجري, شجرة العشب (شجرة شجيرية تسمانية دائمة الخضرة نحيلة بأوراق مدببة رفيعة طولها 3 إلى 5 أقدام)",
 "riches": "ثروة, غنى (وفرة من الممتلكات والموارد المادية)",
 "richly": "ببذخ, بسخاء (بطريقة غنية ومسرفة) / بترف, برفاهية (بطريقة غنية ومترفة) / بثراء, بشكل وافٍ (لدرجة وفيرة أو بطريقة وافية)\nمثال: مزينة ببذخ",
 "richmond": "ريتشموند",
 "richmondena cardinalis": "طائر أحمر, كاردينال (عصفور من أمريكا الشمالية ذو عرف ومنقار سميك ويتميز الذكر بريش أحمر ساطع)",
 "richness": "عَظَمَة, فَخَامَة (الروعة أو الهيبة في الحجم أو المظهر) / ثراء لوني, غنى (حيوية عميقة وقوية للون) / امتلاء, رقة (خاصية الإحساس الغني والممتع) / ثراء, غزارة (خاصية كون الشيء وفيراً للغاية)\nمثال: عظمة العمارة",
 "richter scale": "مِقْيَاس رِيخْتَر",
 "richweed": "عشبة غنية, قراص ميت (نباتات من جنس بيليا ذات عناقيد زهرية خضراء متدلية وسيقان وأوراق شفافة ملساء) / بلسم الحصان, جذر الحجر (عشب معمر قائم قوي الرائحة بأوراق مسننة مدببة وعثكول فضفاض من الزهور المصفرة؛ شرق الولايات المتحدة)",
 "ricin": "رِيْسِيْن",
 "ricin toxin": "ريسين (بروتين سام يُستخرج من بذور الخروع؛ يُستخدم ككاشف كيميائي؛ ويمكن استخدامه كسلاح بيولوجي)\nمثال: مليغرام واحد من الريسين يمكن أن يقتل شخصاً بالغاً",
 "ricinoleic acid": "حمض الريسينوليك (حمض دهني زيتي يوجد في زيت الخروع ويُستخدم في الصابون)",
 "ricinus communis": "خروع, نبات الخروع (شجيرة كبيرة من إفريقيا الاستوائية وآسيا لها أوراق كفية كبيرة وكبسولات شائكة تحتوي على بذور هي مصدر زيت الخروع والريسين؛ تم توطينها على نطاق واسع في…)",
 "rick": "بيدر, كومة قش (كدس من القش) / تشنج, وثء (تشنج عضلي مؤلم خاصة في الرقبة أو الظهر)",
 "ricketiness": "تَرَنُّح, عَدَم ثَبَات (صفة كون الشيء غير ثابت أو غير مثبت بإحكام في مكانه)",
 "rickets": "كُسَاح",
 "rickettsia": "رِكِتْسِيَا, رِيكِتْسِيَّة",
 "rickettsial": "ركتسي (متعلق ببكتيريا الركتسيا أو ناتج عنها)",
 "rickettsial disease": "داء الريكيتسيات, مرض ريكيتسي (مرض معد يسببه القراد أو العث أو قمل الجسم المصاب ببكتيريا الريكيتسيا)",
 "rickettsialpox": "جدري ريكتسي (مرض ريكتسي معدٍ خفيف تسببه بكتيريا من جنس ريكتسيا تنتقل إلى البشر عن طريق لدغة سوس يعيش على القوارض؛ يتميز بقشعريرة وحمى وصداع وآفات جلدية تشبه جدري…)",
 "rickettsiosis": "داء الريكيتسيات, مرض ريكيتسي (مرض معد يسببه القراد أو العث أو قمل الجسم المصاب ببكتيريا الريكيتسيا)",
 "rickety": "ضَعِيف, وَاهِن (يفتقر إلى القوة البدنية أو العضلية أو الحيوية) / مُتَرَنِّح, مُهْتَزّ (يميل إلى الاهتزاز والترنّح بسبب ضعف أو خلل) / كُسَاحِيّ, مُصَاب بِالْكُسَاح (مصاب بالكُساح أو يتّسم بأعراضه)",
 "rickey": "ريكي (مشروب مخلوط مصنوع من عصير الليمون المحلى وماء الصودا عادة مع الكحول)",
 "rickrack": "ركراك, شريط متعرج (شريط متعرج ضيق يستخدم كحاشية)",
 "ricksha": "ريكشو, عربة يجرها إنسان (عربة صغيرة بعجلتين لراكب واحد؛ يسحبها شخص واحد)",
 "rickshaw": "رِيكْشَا",
 "rico": "قانون ريكو, قانون مكافحة الابتزاز (قانون يهدف إلى القضاء على الجريمة المنظمة بفرض عقوبات قوية وأحكام بالمصادرة)",
 "rico act": "قانون ريكو, قانون مكافحة الابتزاز (قانون يهدف إلى القضاء على الجريمة المنظمة بفرض عقوبات قوية وأحكام بالمصادرة)",
 "ricochet": "ارتداد, وثبة (ارتداد جانبي)",
 "ricotta": "رِيكُوتَّا, جُبْن رِيكُوتَّا",
 "ricrac": "ركراك, شريط متعرج (شريط متعرج ضيق يستخدم كحاشية)",
 "rictus": "تكشيرة فك (تجهم بفم مفتوح)",
 "riddance": "إخراج, إقصاء (فعل إجبار شخص أو شيء على الخروج) / إزالة, تخلص (عملية إزالة أو التخلص من شيء ما)\nمثال: طرد مثيري الشغب من قبل الشرطة",
 "riddle": "لُغْز, أُحْجِيَّة (قالَ كلامًا خفيًا أو غير واضح، أو استخدم التورية والإشارة؛ عبّرَ عن شيء بطريقة رمزية أو غير مباشرة)\nمثال: لم يحل أبدا لغز وفاتها.",
 "riddle canon": "كانون غامض (كانون تمت الإشارة فيه إلى مداخل الأجزاء المتتالية برموز وأجهزة غامضة (شاع في القرنين 15 و 16))",
 "riddled": "مَمْلُوءٌ بِالثُّقُوبِ, مُخَرَّم ((غالباً يتبعها 'بـ') متضرر بالكامل من ثقوب عديدة) / مَلِيء, مُنْتَشِر فِيه (مُنْتَشِر فِي جَمِيع أَنْحَائِه)",
 "ride": "رَكِبَ, اِمْتَطَى (عَلَى أو أعْتَلَى شيئا؛ السَيَّارَة أو وسيلة نقل أخرى، استخدمها في تنقله بدلا من الدواب) / رَكِبَ (عَلَى أو أعْتَلَى شيئا؛ السَيَّارَة أو وسيلة نقل أخرى، استخدمها في تنقله بدلا من الدواب) / رُكُوب / آليَّة\nمثال: ركب ياني سفينة.",
 "ride herd on": "رَعَى ركوباً, قَادَ القطيع (قيادة الحيوانات كالخيول والماشية أثناء الركوب معها)\nمثال: كان جو يقود القطيع خلال النهار",
 "rider": "رَاكِب (فُلانٌ فلانَا: ركِب معه، إما في مركبة واحدة أو كلٌّ منهم على فرس؛ الأشياء: وضعها بعضها فوق بعض بغير تنظيم) / رَاكِبَة\nمثال: هي راكبة أمواج.",
