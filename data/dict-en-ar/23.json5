 "rectory": "بيت القسيس, سكن الكاهن (مقر إقامة رسمي توفره الكنيسة لقسيسها أو كاهنها)",
 "rectosigmoid": "مستقيمي سيني (من أو يتعلق بالقولون السيني والجزء العلوي من المستقيم)",
 "rectum": "مُسْتَقِيم (ما جُعِلَ قَائِمًا غير مُنْحَنٍ؛ ما ليس به عِوَج)\nمثال: إرسم خط مستقيم.",
 "rectus": "عضلة مستقيمة (أي من العضلات المستقيمة المختلفة)",
 "rectus inferior": "مستقيمة سفلية (عضلة العين التي يدير انقباضها مقلة العين لأسفل وللداخل)",
 "rectus lateralis": "مستقيمة وحشية (عضلة العين التي يدير انقباضها مقلة العين للخارج)",
 "rectus medialis": "مستقيمة إنسية (عضلة العين التي يدير انقباضها مقلة العين للداخل)",
 "rectus superior": "مستقيمة علوية (عضلة العين التي يدير انقباضها مقلة العين لأعلى وللداخل)",
 "recumbent": "مُتَّكِئ, مُضْطَجِع (مستلقٍ؛ في وضع راحة أو استرخاء)",
 "recuperation": "تعافي, فترة النقاهة (الشفاء التدريجي (من خلال الراحة) بعد المرض أو الإصابة)",
 "recuperative": "اسْتِشْفائِيّ, تَعافٍ (يُساعِد عَلى التَّعافي واسْتِعادَة الصِّحَّة)",
 "recurrence": "تكرار, عودة (الحدوث مرة أخرى (خاصة على فترات منتظمة))\nمثال: عودة الربيع",
 "recurrent": "دَائِمُ التَّكْرَار, مُعَاوِد (يَتَكَرَّرُ مَرَّةً بَعْدَ أُخْرَى)",
 "recurrent event": "حدث دوري, حدث متكرر (حدث يتكرر على فترات زمنية)",
 "recurrent fever": "حمى راجعة, حمى ناكسة (تتميز بحمى عالية متكررة وتنتقل عن طريق لدغة القمل أو القراد المصاب؛ تتميز بنوبات من الحمى العالية والقشعريرة والصداع وآلام العضلات والغثيان التي…)",
 "recurrently": "بشكل دوري, بشكل متكرر (بطريقة متكررة)",
 "recurring": "رَاجِع, عَائِد (يَعُودُ مِنْ جَدِيد)",
 "recurring decimal": "عَدَد عَشْرِيّ دَوْرِيّ, كَسْر دَوْرِيّ (عدد عشري يتكرر فيه تسلسل الأرقام إلى ما لا نهاية)",
 "recursion": "عَوْدِيَّة",
 "recursive": "عَوْدِيّ",
 "recursive definition": "تعريف تكراري ((رياضيات) تعريف لدالة يمكن من خلاله حساب قيم الدالة في عدد محدود من الخطوات)",
 "recursive routine": "روتين استدعاء ذاتي, روتين تكراري (روتين يمكنه استدعاء نفسه)",
 "recurvate": "مُرْتَدّ الانْحِنَاء, مُنْحَنٍ لِلْخَلْف (منحنٍ إلى الخلف أو إلى الداخل)",
 "recurved": "مُرْتَدّ الانْحِنَاء, مُنْحَنٍ لِلْخَلْف (منحنٍ إلى الخلف أو إلى الداخل)",
 "recusal": "تنحٍّ, رد القاضي ((قانون) استبعاد قاضٍ أو هيئة محلفين بسبب التحيز أو تضارب المصالح)",
 "recusancy": "رَفْض الاِمْتِثَال, عِصْيَان دِينِيّ (رفض الخضوع لسلطة قائمة؛ تاريخياً رفض الروم الكاثوليك حضور خدمات كنيسة إنجلترا)",
 "recusant": "رَافِض, مُمْتَنِع (يرفض الخضوع للسلطة) / رَافِض, مُعَارِض ((في الكاثوليكية) يرفض حضور خدمات كنيسة إنجلترا) / خارج عن المألوف, غير ممتثل (شخص يرفض الامتثال لمعايير السلوك الراسخة)",
 "recusation": "تنححي, رد القاضي ((قانون) اعتراض مبني على علاقة القاضي بأحد الأطراف) / تنحٍّ, رد القاضي ((قانون) استبعاد قاضٍ أو هيئة محلفين بسبب التحيز أو تضارب المصالح)",
 "recyclable": "قَابِلٌ لِإِعَادَةِ الاِسْتِخْدَام, قَابِلٌ لِلتَّدْوِير (يُمْكِنُ اسْتِخْدَامُهُ مَرَّةً أُخْرَى)",
 "recycle": "إِعَادَةْ تَدْوِير",
 "recycle bin": "سَلَّة الْمَحْذُوفَات",
 "recycling": "إِعَادَةْ تَدْوِير",
 "recycling bin": "حاوية تدوير, سلة إعادة تدوير (حاوية لإيداع الأشياء المراد إعادة تدويرها)",
 "recycling plant": "مصنع إعادة تدوير (منشأة لإعادة معالجة المواد المستعملة أو المتروكة)",
 "red": "أَحْمَر, حُمْرَة (أحد الألوان الرئيسية الثلاث (الأَحْمَر والأَصْفَر والأَزْرَق) وهو ما كان بلون الدَم أو النَار؛ صفة ما كان لونه أحمرا) / حَمْرَاء (مؤنث أَحْمَر؛ صفة لما كان لونها الحَمَار؛ ذوات الرايات الحمراء أو الحُمُر: عن المومسات) / أحمر (أحد الألوان الرئيسية الثلاث (الأَحْمَر والأَصْفَر والأَزْرَق) وهو ما كان بلون الدَم أو النَار؛ صفة ما كان لونه أحمرا)\nمثال: أردت حذاء أحمر.",
 "red admiral": "فراشة الأميرال الأحمر (من المناطق المعتدلة في أوروبا وآسيا؛ لها أجنحة سوداء بعلامات حمراء وبيضاء)",
 "red alder": "نغت أحمر (شجرة كبيرة من ساحل المحيط الهادئ لأمريكا الشمالية لها خشب أحمر صلب يستخدم كثيراً للأثاث)",
 "red alert": "إنذار أحمر, تأهب قصوى (أعلى مستوى من التأهب عندما يبدو هجوم العدو وشيكاً (أو بشكل عام حالة تأهب ناتجة عن خطر وشيك))",
 "red algae": "طحالب حمراء (طحالب بحرية يحجب الكلوروفيل فيها صبغة حمراء أو أرجوانية؛ مصدر للأجار والكاراجينان)",
 "red amaranth": "ريش الأمير, قطيفة أرجوانية (نبات حولي استوائي أمريكي طويل مبهرج ذو سيقان مشعرة وسنابل طويلة من الزهور الحمراء عادة فوق أوراق مشبعة باللون الأرجواني؛ غالباً ما تستخدم البذور كحبوب)",
 "red angel's trumpet": "بروجمانسيا دموية, بوق الملاك الأحمر (شجيرة شجرية من أمريكا الجنوبية لها زهور برتقالية حمراء كبيرة جداً)",
 "red army": "الْجَيْش الْأَحْمَر",
 "red ash": "مران أحمر, مران زغبي (شجرة أمريكية صغيرة نوعاً ما بغصينات مخملية وأسطح أوراق سفلية مخملية)",
 "red baneberry": "أكتيا حمراء, توت سام أحمر (عشب معمر في أمريكا الشمالية بأوراق مركبة وعناقيد من الزهور البيضاء الصغيرة تليها ثمار لبية بيضاوية حمراء زاهية وسامة)",
 "red bat": "خفاش أحمر (خفاش من أمريكا الشمالية ذو لون قرميدي أو أحمر صدئ مع شعر أبيض الأطراف)",
 "red bay": "بيرسيا بوربونيا, غار أحمر (شجرة صغيرة في جنوب الولايات المتحدة ذات خشب قلب أحمر داكن)",
 "red bearberry": "عنب الدب, قطلب عنب الدب (شجيرة دائمة الخضرة تشكل حصيرة من أمريكا الشمالية وشمال أوراسيا لها زهور بيضاء صغيرة وتوت أحمر؛ تتحول الأوراق إلى الأحمر في الخريف)",
 "red beech": "زان أحمر, هريتييرا ثلاثية الأوراق (شجرة كبيرة من أسترالاسيا) / زان أمريكي (شجرة غابات أمريكية شمالية بأوراق خضراء فاتحة وجوز صالح للأكل)",
 "red birch": "بتولا سوداء, بتولا نهرية (بتولا المستنقعات وقيعان الأنهار في جميع أنحاء شرق الولايات المتحدة لها لحاء بني محمر)",
 "red bird's eye": "سيلينة حمراء, ليخنيس أحمر (نبات أوروبي ثنائي الحول ذو زهور حمراء أو وردية؛ يوضع أحياناً في جنس ليخنيس)",
 "red blood cell": "كُرَيَّةُ دَمٍ ُحَمْرَاء, خَلِيَّةُ دَمٍ حَمْرَاءُ",
 "red bone marrow": "نخاع أحمر (نخاع العظم لدى الأطفال وبعض عظام البالغين المطلوب لتكوين خلايا الدم الحمراء)",
 "red bordeaux": "بوردو الأحمر, كلاريت (نبيذ بوردو أحمر جاف أو نبيذ شبيه بالبوردو)",
 "red brass": "نحاس أحمر (نحاس أصفر يحتوي على ما يكفي من النحاس لإعطائه صبغة حمراء؛ يستخدم لأنابيب السباكة وأدوات نحاسية أخرى وفي المجوهرات الرخيصة)",
 "red bryony": "جنجل بري, فاشرا حمراء (فاشرا ذات جذور لحمية وأزهار خضراء باهتة وتوت أحمر صغير جداً؛ توجد في أوروبا وشمال أفريقيا وغرب آسيا)",
 "red buckeye": "بكية حمراء, كستناء الحصان الحمراء (شجيرة بكية من جنوب الولايات المتحدة)",
 "red cabbage": "ملفوف أحمر (رأس مدمج من الأوراق الحمراء الأرجوانية) / كرنب أحمر, ملفوف أحمر (نبات ملفوف برأس مدمج من الأوراق الأرجوانية المحمرة)",
 "red campion": "سيلينة حمراء, ليخنيس أحمر (نبات أوروبي ثنائي الحول ذو زهور حمراء أو وردية؛ يوضع أحياناً في جنس ليخنيس)",
 "red carpet": "سَجَّادَة حَمْرَاء",
 "red cedar": "أرز أحمر (خشب محمر عطري لأي من أشجار الأرز الأحمر المختلفة) / أرز البخور (شجرة طويلة من ساحل المحيط الهادئ لأمريكا الشمالية لها أوراق تشبه السرو ولحاء أحمر قرفي) / عرعر أحمر شرقي (عرعر صغير يوجد شرق جبال روكي له تاج مخروطي ولحاء بني يتقشر في شرائح وإبر صغيرة حادة) / أرز أحمر غربي, عفص مطوي (عفص كبير قيم من شمال غرب الولايات المتحدة)",
 "red cent": "تَافِه, لَا يُسَاوِي فَلْساً (شيء ذو قيمة قليلة جداً)\nمثال: وعده لا يساوي فلساً",
 "red chalk": "سانغوين, طباشير أحمر (طباشير بلون بني محمر يشبه الدم الجاف)",
 "red clay": "طين أحمر (طين ناتج احمراره عن أكسيد الحديد)",
 "red clintonia": "كلينتونيا حمراء (نبات بساق شبه خالية من الأوراق تعلوها عنقود من الزهور الحمراء أو الخزامية المحمرة؛ كاليفورنيا إلى أوريغون)",
 "red clover": "نفل المروج, نفل بنفسجي (نبات معمر قصير العمر، منتصب إلى منبطح، ذو أزهار حمراء أرجوانية إلى وردية؛ أكثر أنواع نفل العلف زراعة)",
 "red cole": "فجل الخيل, فجل حار (نبات أوراسي خشن يُزرع لجذره الأبيض السميك الحريف)",
 "red coral": "مرجان أحمر (شعاب مرجانية خاصة في البحر الأبيض المتوسط ذات لون وردي أو أحمر تستخدم للزينة والمجوهرات) / مرجان, مرجان أحمر (الهيكل الصخري الصلب لمرجان البحر المتوسط، ذو لون أحمر أو وردي دقيق ويستخدم للمجوهرات)",
 "red crescent": "اَلْهِلَال اَلْأَحْمَر",
 "red cross": "اَلصَّلِيب اَلْأَحْمَر",
 "red currant": "كِشْمِش أَحْمَر",
 "red cypress pine": "صنوبر السرو الأسود (شجرة أسترالية ذات قشور صغيرة مسطحة كأوراق وبذور عديدة بنية داكنة؛ تُثمن لخشبها وراتنجها)",
 "red dagga": "داغا, ذيل الأسد (عشب جنوب أفريقي غير سام نسبياً يدخن مثل التبغ)",
 "red deer": "أيل أحمر (أيل شائع في المناطق المعتدلة من أوروبا وآسيا)",
 "red delicious": "تفاح ديليشس الأحمر (تفاح أكل حلو ذو قشرة حمراء زاهية؛ أكثر أنواع التفاح زراعة في العالم)",
 "red devil": "سيكوباربيتال الصوديوم, سيكونال (باربيتورات عبارة عن مسحوق أبيض عديم الرائحة مر قليلاً (الاسم التجاري سيكونال) يستخدم كملح صوديوم للتهدئة ولعلاج التشنجات)",
 "red dogwood": "قرانيا أمريكية, قرانيا حمراء (شجيرة شائعة في أمريكا الشمالية بغصينات أرجوانية محمرة وزهور بيضاء) / قرانيا أوروبية شائعة, قرانيا دموية (شجيرة نفضية أوروبية تتحول للأحمر في الخريف ولها زهور بيضاء باهتة)",
 "red drum": "سمكة الطبل الأحمر, طبل أحمر (سمكة كبيرة صالحة للأكل توجد قبالة ساحل الولايات المتحدة من ماساتشوستس إلى المكسيك)",
 "red dwarf": "قَزَم أَحْمَر (نجم صغير قديم وبارد نسبياً؛ كتلته تقريباً 100 ضعف كتلة المشتري)",
 "red dwarf star": "قَزَم أَحْمَر (نجم صغير قديم وبارد نسبياً؛ كتلته تقريباً 100 ضعف كتلة المشتري)",
 "red eft": "سمندل أحمر (الشكل البري الأحمر لسمندل مائي شائع في أمريكا الشمالية)",
 "red elm": "دردار أحمر, دردار لزج (دردار من أمريكا الشمالية له أوراق خشنة تكون حمراء عند تفتحها؛ ينتج خشباً صلباً) / دردار أحمر, دردار سبتمبر (دردار خريفي الإزهار من جنوب شرق الولايات المتحدة)",
 "red false mallow": "ختمية البراري, ختمية كاذبة حمراء (ختمية كاذبة في غرب الولايات المتحدة ذات زهور حمراء عنقودية؛ توضع أحياناً في جنس مالفاستروم)",
 "red fire": "مادة ألعاب نارية حمراء, نار حمراء (مادة قابلة للاحتراق (عادة أملاح الليثيوم أو السترونتيوم) تحترق بلون أحمر ساطع؛ تستخدم في المشاعل والألعاب النارية)",
 "red flag": "راية حمراء, نذير خطر (شيء يثير الغضب أو يتطلب إجراءً فوريًا) / راية حمراء, علم أحمر (شعار الثورة الاشتراكية) / علم أحمر (علم يعمل كإشارة تحذير)\nمثال: القيام بذلك يشبه التلويح بخرقة حمراء أمام ثور",
 "red fox": "ثعلب أحمر (الثعلب الشائع في العالم القديم؛ ذو فرو بني محمر؛ يُعتبر عادة نوعاً واحداً حول القطب الشمالي) / ثعلب أحمر (ثعلب العالم الجديد؛ غالباً ما يُعتبر نفس نوع ثعلب العالم القديم) / الثعلب الأحمر, سيلوزيا فضية (نبات حولي عشبي ذو سنابل من الزهور البيضاء الفضية)",
 "red giant": "عِمْلَاق أَحْمَر (نجم كبير قديم ومضيء؛ يتميز بدرجة حرارة سطح منخفضة نسبياً وقطر كبير نسبة للشمس)",
 "red giant star": "عِمْلَاق أَحْمَر (نجم كبير قديم ومضيء؛ يتميز بدرجة حرارة سطح منخفضة نسبياً وقطر كبير نسبة للشمس)",
 "red ginger": "زنجبيل أحمر (زنجبيل زينة موطنه جزر المحيط الهادئ)",
 "red goatfish": "بربوني أحمر, سمكة الماعز الحمراء (جسمها قرمزي ساطع مع شريطين أصفرين إلى محمرين على الجانب)",
 "red goosefoot": "رجل الوزة الأحمر, سرمق هجين (عشبة تعتبر قاتلة للخنازير) / رجل الوزة الأحمر, سبانخ فرنسي (عشبة أوراسية شائعة؛ متوطنة في الولايات المتحدة)",
 "red gram": "بازلاء الحمام, لوبيا العدس (عشبة خشبية استوائية ذات أزهار صفراء مبهرجة وقرون مسطحة؛ تزرع بكثرة في المناطق الاستوائية)",
 "red grouse": "طيهوج أحمر (طيهوج بني محمر يعيش في المستنقعات المرتفعة في بريطانيا العظمى)",
 "red guard": "الحرس الأحمر (حركة سياسية راديكالية للشباب الصينيين الذين تبنوا المبادئ الماوية)",
 "red gum": "شجرة الصمغ الحلو, ليكويدامبر (نبات قائم على سَاق صلبة؛ مخطط له تفرعات) / جوز أطلسي, صمغ حلو (خشب بني محمر من خشب القلب لشجرة الصمغ الحلو يستخدم لصنع الأثاث) / صمغ أحمر, كينا النعناع (شجرة صمغ أحمر من تسمانيا) / صمغ أحمر, ماري (شجرة صمغ أحمر كبيرة جداً)\nمثال: أنا تحت الشجرة.",
 "red haw": "زعرور أحمر, زعرور زغبي (زعرور أمريكي أحمر الثمار بسيقان وأوراق مغطاة بكثافة بشعر صوفي قصير) / زعرور أحمر (زعرور أمريكي أحمر الثمار بعناقيد كثيفة من الزهور الوردية الحمراء)",
 "red heat": "احمرار, توهج (حرارة أو لون النار)",
 "red helleborine": "سيفالانترا حمراء (سحلب من البحر الأبيض المتوسط وآسيا له سنبلة رخوة من الزهور الوردية الزاهية)",
 "red herring": "تمويه, سمكة الرنجة الحمراء (أي تحويل يهدف إلى صرف الانتباه عن القضية الرئيسية) / مسودة نشرة الاكتتاب, نشرة تمهيدية (مسودة أولى لنشرة اكتتاب؛ يجب أن تكون مميزة بوضوح للإشارة إلى أن أجزاء منها قد تتغير في النشرة النهائية) / رنجة حمراء (رنجة مجففة ومدخنة ذات لون مائل للاحمرار)",
 "red hot": "نقانق, هوت دوج (نقانق فرانكفورتر تُقدم ساخنة في خبز كعك)",
 "red indian": "هندي أحمر (فرد من عرق الأشخاص الذين عاشوا في أمريكا عند وصول الأوروبيين)",
 "red ink": "خسارة, عجز (المبلغ الذي تتجاوز به تكلفة العمل إيراداته)\nمثال: عملت الشركة بخسارة العام الماضي",
 "red jungle fowl": "دجاج الأدغال الأحمر (دجاج أدغال من جنوب شرق آسيا يعتبر سلف الدجاج المنزلي)",
 "red juniper": "عرعر أحمر شرقي (عرعر صغير يوجد شرق جبال روكي له تاج مخروطي ولحاء بني يتقشر في شرائح وإبر صغيرة حادة)",
 "red kauri": "كاوري أحمر (شجرة نيوزيلندية بأوراق لامعة ولحاء بني محمر حرشفي)",
 "red kite": "حَدَأَة حَمْرَاء",
 "red lauan": "لاوان أحمر (شجرة أخشاب فلبينية قيمة) / لاوان أحمر (خشب أحمر ثقيل صلب لشجرة اللاوان الأحمر؛ يباع غالباً كماهوجني فلبيني)",
 "red lauan tree": "لاوان أحمر (شجرة أخشاب فلبينية قيمة)",
 "red laver": "لافر أحمر (أعشاب بحرية حمراء صالحة للأكل)",
 "red lead": "أكسيد الرصاص الأحمر, الرصاص الأحمر",
 "red light": "ضَوْء أَحْمَر (النُّور؛ مصدر ضَاء)\nمثال: ضوء القمر ضعيف.",
 "red line": "خَطّ أَحْمَر (كِتَابَة؛ ما يَصِل نقطتين أو أكثر)\nمثال: إرسم خط مستقيم.",
 "red link": "وَصْلَة حَمْرَاء",
 "red maids": "خادمة حمراء, كالاندرينا مهدبة (نبات عصاري يشكل بساطاً وله أزهار صغيرة زاهية باللون الوردي المحمر؛ جنوب غرب الولايات المتحدة)",
 "red man": "رجل أحمر (مصطلح مسيء) ((عامية) مصطلح مسيء للذكور من السكان الأصليين لأمريكا)",
 "red maple": "قيقب أحمر, قيقب قرمزي (قيقب من شرق ووسط أمريكا؛ أوراقه خماسية الفصوص تتحول إلى القرمزي والأصفر في الخريف)",
 "red marrow": "نخاع أحمر (نخاع العظم لدى الأطفال وبعض عظام البالغين المطلوب لتكوين خلايا الدم الحمراء)",
 "red meat": "لحم أحمر (لحم لونه داكن قبل الطهي (مثل لحم البقر، الغزال، الضأن))",
 "red morning-glory": "أثمان قرمزي, مجد الصباح الأحمر (عشب حولي له زهور قرمزية؛ شرق الولايات المتحدة)",
 "red mulberry": "توت أحمر (توت من أمريكا الشمالية له فاكهة أرجوانية داكنة صالحة للأكل)",
 "red mullet": "بربوني, سلطان إبراهيم (أسماك استوائية زاهية الألوان ذات زوائد استشعارية في الذقن)",
 "red notice": "نشرة حمراء, نشرة دولية للمطلوبين (نشرة من الإنتربول تصف شخصاً مطلوباً وتطلب اعتقاله بهدف تسليمه؛ إشعار مطلوبين يصدره الإنتربول بناءً على طلب دولة عضو ويوزع على جميع الدول الأعضاء)\nمثال: تعد النشرة الحمراء للإنتربول أقرب أداة لأمر اعتقال دولي مستخدم اليوم",
 "red oak": "بلوط أحمر (أي من العديد من أشجار البلوط الأمريكية التي تحتوي على 4 أسدية في كل زهيرة، وبلوط يتطلب عامين للنضج وعروق أوراق تمتد عادة إلى ما بعد حافة الورقة لتشكل…)",
 "red onion": "بَصَل أَحْمَر, بَصَل أَرْجُوَانِيّ",
 "red osier": "صفصاف أحمر, صفصاف أرجواني (صفصاف أوراسي له غصينات محمرة أو أرجوانية ولحاء غني بالعفص) / قرانيا أمريكية, قرانيا حمراء (شجيرة شائعة في أمريكا الشمالية بغصينات أرجوانية محمرة وزهور بيضاء)",
 "red osier dogwood": "قرانيا أمريكية, قرانيا حمراء (شجيرة شائعة في أمريكا الشمالية بغصينات أرجوانية محمرة وزهور بيضاء)",
 "red panda": "بَانْدَا أَحْمَر",
 "red pepper": "تباسكو, فلفل أحمر (فلفل أحمر حار جداً؛ عادة ما يكون طويلاً ورفيعاً؛ وبعضه صغير جداً) / فلفل أحمر, فلفل حريف (قرون وبذور مطحونة للفلفل الأحمر اللاذع)",
 "red periwinkle": "عناقية, عين البزون (عشب خشبي من العالم القديم يزرع عادة وله أزهار كبيرة وردية إلى حمراء)",
 "red phalarope": "فلروب أحمر (فلروب من المحيطات والبحيرات الشمالية)",
 "red pimpernel": "أناغالس حقلي, زهرة الطقس (عشبة ذات أزهار قرمزية أو بيضاء أو أرجوانية تغلق عند اقتراب الطقس الممطر)",
 "red pine": "صنوبر أحمر, صنوبر أحمر كندي (صنوبر من شرق أمريكا الشمالية له إبر طويلة في حزم من اثنتين ولحاء محمر) / ريمو, صنوبر أحمر (شجرة خشبية طويلة في نيوزيلندا)",
 "red poll": "ريد بول (سلالة من ماشية اللحم والحليب عديمة القرون وقصيرة الشعر)",
 "red porgy": "المرجان الأحمر (سمكة طعام في البحر الأبيض المتوسط وسواحل المحيط الأطلسي لأوروبا وأمريكا)",
 "red raspberry": "توت العليق الأحمر, توت شوكي (أي من عدة أنواع من التوت الشوكي تحمل فاكهة حمراء)",
 "red rat snake": "ثعبان الجرذ الأحمر, ثعبان الذرة (ثعبان كبير غير سام من جنوب شرق الولايات المتحدة؛ غالباً ما يوجد في المزارع)",
 "red region": "السعير, نار جهنم (مكان من النار الأبدية يُتصور كعقاب للملعونين)",
 "red river hog": "خَنْزِير الأَنْهار الأَحْمَر",
 "red rockfish": "سمكة الصخر الحمراء (سمكة كبيرة في ساحل المحيط الهادئ لأمريكا الشمالية) / سمك الصخر الأحمر (لحم أحمر لسمكة طعام كبيرة من ساحل المحيط الهادئ)",
 "red salmon": "سلمون أحمر, سلمون سوكي (سلمون صغير ذو لحم أحمر؛ يوجد في الأنهار وروافد شمال المحيط الهادئ ويُقدر كطعام؛ يموت البالغون بعد وضع البيض) / سلمون أحمر (لحم أحمر دهني لسلمون ساحل المحيط الهادئ والأنهار)",
 "red sandalwood": "خشب المرجان, صندل أحمر (شجرة من شرق الهند ذات عناقيد من الزهور الصفراء البيضاء؛ تزرع للزينة) / بتيروكاربوس سانتالينوس, خشب الصندل الأحمر (شجرة من الهند وجزر الهند الشرقية تنتج خشباً عطرياً صلباً ثميناً للأثاث وقلب خشب أحمر داكن يستخدم كخشب صباغة) / خشب الصندل الأحمر, خشب ياقوتي (خشب متين صلب لأشجار خشب الصندل الأحمر؛ يُقدر للخزائن)",
 "red sanders": "بتيروكاربوس سانتالينوس, خشب الصندل الأحمر (شجرة من الهند وجزر الهند الشرقية تنتج خشباً عطرياً صلباً ثميناً للأثاث وقلب خشب أحمر داكن يستخدم كخشب صباغة)",
 "red sanderswood": "بتيروكاربوس سانتالينوس, خشب الصندل الأحمر (شجرة من الهند وجزر الهند الشرقية تنتج خشباً عطرياً صلباً ثميناً للأثاث وقلب خشب أحمر داكن يستخدم كخشب صباغة)",
 "red saunders": "بتيروكاربوس سانتالينوس, خشب الصندل الأحمر (شجرة من الهند وجزر الهند الشرقية تنتج خشباً عطرياً صلباً ثميناً للأثاث وقلب خشب أحمر داكن يستخدم كخشب صباغة)",
 "red scare": "الذعر الأحمر (فترة من الخوف العام من الشيوعيين)",
 "red sea": "البَحْرُ الأَحْمَر, بَحْرُ القُلْزُم",
 "red sea governorate": "محافظة البحر الأحمر (تقسيم إداري في أرض دولة؛ المؤنث من \"مُحَافَظ\")\nمثال: نشأت ليلى في بلدة محافظة.",
 "red setter": "سيتر إيرلندي (سلالة أيرلندية ذات فراء بني كستنائي أو أحمر ماهوجني)",
 "red shift": "انزياح أحمر ((في علم الفلك) انزياح في أطياف المجرات البعيدة جداً نحو أطوال موجية أطول (نحو الطرف الأحمر من الطيف)؛ يفسر عموماً كدليل على أن الكون يتوسع)",
 "red shrubby penstemon": "بنستيمون الخشب الأحمر, بنستيمون شجيري أحمر (شجيرة منخفضة التفرع خضراء داكنة مع باقات من الزهور الحمراء القرميدية في نهايات الفروع؛ السلاسل الساحلية وسفوح التلال في شمال كاليفورنيا)",
 "red silk cotton": "قطن حريري أحمر (ألياف نباتية من شجرة القطن الحريري الأحمر في شرق الهند؛ أقل جودة من الكابوك)",
 "red silk-cotton tree": "سيمال, شجرة قطن الحرير الأحمر (شجرة قطن حرير من شرق الهند تنتج أليافاً أقل جودة من الكابوك)",
 "red silver fir": "شوح بهي, شوح فضي باسيفيكي (شوح متوسط إلى طويل من غرب أمريكا الشمالية له تاج مخروطي وفروع في طبقات؛ الأوراق تفوح منها رائحة البرتقال عند سحقها)",
 "red siskin": "حسون أحمر (نوع من العصافير القرمزية في أمريكا الجنوبية برأس وأجنحة وذيل أسود)",
 "red snapper": "نهاش أحمر (سمكة طعام محترمة ذات رأس وجسم أحمر وردي؛ شائعة في المياه الساحلية الأطلسية لأمريكا الشمالية وخليج المكسيك) / نهاش أحمر (لحم محمر قليل الدهن يحظى بتقدير كبير للنهاش من الساحل الأطلسي وخليج المكسيك)",
 "red sorrel": "حميض أحمر, غجر (عشبة سنوية شائكة قليلاً من شرق الهند أو شجيرة معمرة تزرع على نطاق واسع لكؤوسها اللحمية المستخدمة في الفطائر والهلام ولألياف اللحاء)",
 "red spider": "سوس العنكبوت الأحمر, عنكبوت أحمر (سوس صغير يغزل الشباك؛ آفة خطيرة في البساتين)",
 "red spider mite": "سوس العنكبوت الأحمر, عنكبوت أحمر (سوس صغير يغزل الشباك؛ آفة خطيرة في البساتين)",
 "red sprites": "عفاريت حمراء (كهرباء جوية (تستمر 10 مللي ثانية) تظهر كومضات كروية من الضوء الأحمر (وردي إلى أحمر قاني) ترتفع لارتفاعات تصل إلى 60 ميلاً (تُرى أحياناً مع عفاريت…)",
 "red spruce": "تنوب أحمر (تنوب متوسط الحجم من شرق أمريكا الشمالية؛ تنوب الخشب الرئيسي في المنطقة؛ ومصدر لخشب اللب)",
 "red square": "الْمَيْدَان الْأَحْمَر",
 "red squirrel": "سنجاب أحمر (سنجاب بني محمر شائع في أوروبا وأجزاء من آسيا) / سنجاب أحمر أمريكي (من شمال الولايات المتحدة وكندا)",
 "red tai": "لغة تاي الحمراء (فرع من لغات تاي، يُتحدث به في ولاية كاتشين ومنطقة ساغينغ في بورما)",
 "red tape": "روتين, روتين بيروقراطي (إجراء يستهلك وقتاً طويلاً بلا داع)",
 "red tide": "المد الأحمر (مياه البحر التي يتغير لونها بسبب أعداد كبيرة من سوطيات دينية معينة تنتج الساكسيتوكسين)",
 "red trillium": "تريليوم أحمر, تريليوم أرجواني (تريليوم من شرق أمريكا الشمالية له زهور وردية إلى أرجوانية كريهة الرائحة وجذر قابض يستخدم في الطب الشعبي خاصة لتسهيل الولادة) / تريليوم أحمر, تريليوم لاطئ (تريليوم من شمال شرق الولايات المتحدة بأوراق لاطئة وزهور حمراء أو أرجوانية لها رائحة نفاذة)",
 "red underwing": "عثة حمراء تحت الجناح (عثة ذات أجنحة أمامية باهتة وأجنحة خلفية معلمة بالأحمر)",
 "red valerian": "مخلب الشيطان, ناردين أحمر (عشبة أوروبية ذات زهور قرمزية أو بيضاء صغيرة عطرة ذات مهماز)",
 "red water": "ماء أحمر (مرض يصيب الماشية؛ يتميز ببيلة دموية)",
 "red willow": "صفصاف أحمر, صفصاف أرجواني (صفصاف أوراسي له غصينات محمرة أو أرجوانية ولحاء غني بالعفص)",
 "red wine": "نَبِيذ أَحْمَر, خَمْر أَحْمَر (نَبِيذ (صفة مفردة مذكرة، مؤنثها نَبِيْذَة، وجمعها السالم نَبِيْذُوْن، وجمعها المؤنث السالم نَبِيْذَات، وجمعها المكسر أَنْبِذَة)؛ نَبِيذ (لا يؤنث، وجمعه أَنْبِذَة))\nمثال: أنا شربت النبيذ.",
 "red wolf": "ذئب أحمر (ذئب رمادي محمر من جنوب غرب أمريكا الشمالية)",
 "red woman": "امرأة حمراء (مصطلح مسيء) ((عامية) مصطلح مسيء للإناث من السكان الأصليين لأمريكا)",
 "red worm": "دودة الأرض (دودة برية تحفر في التربة وتساعد في تهويتها؛ تظهر غالباً عندما تكون الأرض باردة أو رطبة؛ تستخدم كطعم من قبل الصيادين)",
 "red-backed lemming": "لاموس رمادي (لاموس من العالم القديم)",
 "red-backed mouse": "فأر أحمر الظهر (أي من عدة فئران حقل في المناطق الجبلية في أوراسيا وأمريكا)",
 "red-backed sandpiper": "دريجة ألبية (طيطوي شائع صغير يتكاثر في المناطق الشمالية أو القطبية ويشتي في جنوب الولايات المتحدة أو مناطق البحر الأبيض المتوسط)",
 "red-bellied snake": "ثعبان أحمر البطن (ثعبان غابات غير ضار من جنوب شرق الولايات المتحدة)",
 "red-bellied terrapin": "سلحفاة حمراء البطن (سلحفاة مياه عذبة من روافد خليج تشيسابيك لها علامات حمراء على الصدفة السفلية)",
 "red-bellied turtle": "سلحفاة حمراء البطن (سلحفاة مياه عذبة من روافد خليج تشيسابيك لها علامات حمراء على الصدفة السفلية)",
 "red-berried elder": "بيلسان أحمر أمريكي (شجيرة أو شجرة صغيرة شائعة في أمريكا الشمالية) / بيلسان أحمر أوروبي (شجيرة أوراسية)",
 "red-berry": "أكتيا حمراء, توت سام أحمر (عشب معمر في أمريكا الشمالية بأوراق مركبة وعناقيد من الزهور البيضاء الصغيرة تليها ثمار لبية بيضاوية حمراء زاهية وسامة) / توت أحمر, نبق أحمر (شجيرة شائكة صغيرة دائمة الخضرة في غرب الولايات المتحدة والمكسيك ذات زهور دقيقة وتوت أحمر زاهي)",
 "red-blind": "مُصَاب بِعَمَى الأَحْمَر (عدم القدرة على رؤية اللون الأحمر أو التمييز بين الأحمر والأخضر المُزرَقّ)",
 "red-blindness": "عمى الأحمر (عمى ألوان ثنائي يتميز بانخفاض الحساسية للأطوال الموجية الطويلة للضوء مما يؤدي إلى عدم القدرة على التمييز بين الأحمر والأزرق الأرجواني)",
 "red-blooded": "فَتِيّ, مِلْؤُه الحَيَوِيَّة (مَليء بِالقُوَّة والنَّشاط والحَيَوِيَّة الدَّمَوِيَّة)",
 "red-breasted merganser": "بلقشة حمراء الصدر (بلقشة واسعة الانتشار في أمريكا وأوروبا)",
 "red-breasted nuthatch": "كاسر الجوز أحمر الصدر (كاسر جوز رمادي مزرق بصدر محمر؛ من الغابات الصنوبرية الشمالية)",
 "red-breasted sapsucker": "نقار الخشب مصاص العصارة أحمر الصدر (نقار خشب مصاص للعصارة من غرب أمريكا الشمالية)",
 "red-breasted snipe": "شنقب أحمر الصدر (طائر دويتشر ذو صدر أحمر)",
 "red-brick": "مِنْ جَامِعَاتِ الطُّوبِ الأَحْمَر (مُتَعَلِّقٌ بِالجَامِعَاتِ البِرِيطَانِيَّةِ الَّتِي أُنْشِئَتْ فِي أَوَاخِرِ القَرْنِ التَّاسِعَ عَشَر)",
 "red-brown": "بُنِّيّ مُحْمَرّ (بني مع مسحة حمراء)",
 "red-coated": "ذُو مِعْطَف أَحْمَر (يُستخدم للجنود البريطانيين في حرب الاستقلال الأمريكية بسبب معاطفهم الحمراء)",
 "red-crested pochard": "ونس",
 "red-eyed vireo": "فيريو أحمر العينين (من شمال أمريكا الشمالية له قزحية حمراء وجسم رمادي زيتوني مع أجزاء سفلية بيضاء)",
 "red-faced": "مُتَوَرِّد, مُحْمَرّ ((خاصة للوجه) محمر أو مشبع بالدم من الانفعال أو المجهود) / خَجُول, مُحْمَرُّ الوَجْه (محمرّ الوجه من الحرج أو الخجل أو الانفعال)",
 "red-flowered": "أَحْمَر الأَزْهَار (ذو أزهار حمراء اللون)",
 "red-flowered silky oak": "بلوط حريري أحمر الأزهار (شجيرة طويلة بعناقيد أسطوانية من الزهور الحمراء وأوراق ريشية حريرية ورمادية من الأسفل؛ شرق أستراليا)",
 "red-fruited": "ذُو ثِمَار حَمْرَاء (يَحْمِلُ ثِمَارًا حَمْرَاء)",
 "red-gray": "رَمَادِيّ مُحْمَرّ (رمادي مع مسحة حمراء)",
 "red-green color blindness": "عمى الألوان الأحمر والأخضر (الخلط بين اللونين الأحمر والأخضر)",
 "red-green colour blindness": "عمى الألوان الأحمر والأخضر (الخلط بين اللونين الأحمر والأخضر)",
 "red-green dichromacy": "عمى الألوان الأحمر والأخضر (الخلط بين اللونين الأحمر والأخضر)",
 "red-grey": "رَمَادِيّ مُحْمَرّ (رمادي مع مسحة حمراء)",
 "red-handed": "مُتَلَبَّس, جُرْم مَشْهُود",
 "red-header": "أحمر الشعر, أصهب (شخص ذو شعر أحمر)",
 "red-hot": "خَاطِف, سَرِيع جِدًّا (سَرِيع لِلغَايَة؛ قَادِر عَلَى الاسْتِجَابَة السَّرِيعَة وَالسُّرْعَة الفَائِقَة) / مُتَوَهِّج الحُمْرَة (يتوهَّج باللون الأحمر من شدَّة الحرارة) / مُتَأَجِّج, مُثِير (يتّسم بالعاطفة الشديدة أو الاهتمام أو الإثارة) / سَاخِن, طَازَج جِدًّا (الأحدث والأكثر جدّة)",
 "red-hot poker": "تريتومة مبكرة (نبات هجين يزرع على نطاق واسع)",
 "red-lavender": "خُزَامِيّ مُحْمَرّ (خزامي مع مسحة حمراء)",
 "red-lead putty": "معجون الرصاص الأحمر (أسمنت يشبه المعجون؛ يصنع بخلط الرصاص الأبيض والأحمر في زيت بذر الكتان المغلي؛ يستخدم كحشو في وصلات الأنابيب)",
 "red-legged partridge": "حجل أحمر الساق (حجل شائع في غرب أوروبا ذو أرجل حمراء)",
 "red-letter": "تَارِيخِيّ, مَشْهُود (جَدِيرٌ بِالتَّذَكُّرِ لِكَوْنِهِ مُنَاسَبَةً خَاصَّةً)",
 "red-letter day": "يوم لا ينسى, يوم مشهود (يوم سعيد أو بارز لا يُنسى (من عادة وضع علامة على الأيام المقدسة باللون الأحمر في التقويمات الكنسية))",
 "red-light district": "حي البغاء, منطقة الضوء الأحمر (حي يكثر فيه وجود بيوت الدعارة)",
 "red-necked grebe": "غطاس أحمر الرقبة (غطاس ممتلئ الجسم كبير من المناطق القطبية ذو رقبة داكنة)",
 "red-orange": "بُرْتُقَالِيّ مُحْمَرّ (برتقالي مع مسحة حمراء)",
 "red-purple": "أُرْجُوَانِيّ مُحْمَرّ (أرجواني مع مسحة حمراء)",
 "red-rimmed": "أَحْمَرُ الحَوَافّ (مُحاط بحافة حمراء)",
 "red-shafted flicker": "نقار الخشب أحمر العمود (طائر من غرب الولايات المتحدة ذو سطح سفلي أحمر للأجنحة والذيل)",
 "red-shouldered hawk": "سقاوة موشحة",
 "red-skinned onion": "بصل أحمر القشرة (بصل ذو غلاف أبيض إلى أحمر عميق؛ كاليفورنيا)",
 "red-spotted purple": "فراشة أرجوانية حمراء البقع (تشبه فراشة الأميرال الأبيض الأمريكية ولكن مع بقع حمراء على أسطح الأجنحة السفلية)",
 "red-streaked": "مُخَطَّط بِالأَحْمَر (ذو خطوط حمراء اللون)",
 "red-striped": "مُخَطَّط بِالأَحْمَر (ذو خطوط حمراء اللون)",
 "red-tailed hawk": "باز أحمر الذيل (نوع من الصقور الأمريكية ذات اللون البني الداكن ولها ذيل بني محمر)",
 "red-tailed squirrel": "سنجاب أحمر الذيل",
 "red-veined pie plant": "راوند الهيمالايا, راوند هندي (عشب آسيوي (من الهيمالايا))",
 "red-violet": "بَنَفْسَجِيّ مُحْمَرّ (بنفسجي مع مسحة حمراء)",
 "red-winged blackbird": "شحرور أحمر الجناح (شحرور من أمريكا الشمالية ذو بقع قرمزية على الأجنحة)",
 "redact": "محرر صياغة, معدّ (شخص يضع النص في شكل مناسب للنشر)",
 "redaction": "تحرير, صياغة (فعل وضع شيء ما في صيغة مكتوبة) / تحرير, تنقيح (وضع شيء ما (مثل عمل أدبي) في شكل مقبول)",
 "redactor": "محرر صياغة, معدّ (شخص يضع النص في شكل مناسب للنشر)",
 "redback vole": "فأر أحمر الظهر (أي من عدة فئران حقل في المناطق الجبلية في أوراسيا وأمريكا)",
 "redbelly": "سلحفاة حمراء البطن (سلحفاة مياه عذبة من روافد خليج تشيسابيك لها علامات حمراء على الصدفة السفلية)",
 "redberry": "أكتيا حمراء, توت سام أحمر (عشب معمر في أمريكا الشمالية بأوراق مركبة وعناقيد من الزهور البيضاء الصغيرة تليها ثمار لبية بيضاوية حمراء زاهية وسامة) / توت أحمر, نبق أحمر (شجيرة شائكة صغيرة دائمة الخضرة في غرب الولايات المتحدة والمكسيك ذات زهور دقيقة وتوت أحمر زاهي)",
 "redbird": "طائر أحمر, كاردينال (عصفور من أمريكا الشمالية ذو عرف ومنقار سميك ويتميز الذكر بريش أحمر ساطع) / تناجر قرمزي (الذكر أحمر ساطع بأجنحة وذيل أسود)",
 "redbird cactus": "شجيرة اليهودي, صبار الطائر الأحمر (شجيرة أمريكية استوائية منخفضة ذات خصائص مقيئة قوية)",
 "redbird flower": "شجيرة اليهودي, صبار الطائر الأحمر (شجيرة أمريكية استوائية منخفضة ذات خصائص مقيئة قوية)",
 "redbone": "كلب ريدبون (كلب صيد أمريكي سريع ذو لون أحمر أو أحمر وأسمر)",
 "redbreast": "أبو الحناء (طائر مغرد صغير من العالم القديم ذو صدر محمر)",
 "redbrick": "مِنْ جَامِعَاتِ الطُّوبِ الأَحْمَر (مُتَعَلِّقٌ بِالجَامِعَاتِ البِرِيطَانِيَّةِ الَّتِي أُنْشِئَتْ فِي أَوَاخِرِ القَرْنِ التَّاسِعَ عَشَر)",
 "redbrick university": "جامعة حديثة ((بريطانية غير رسمية) جامعة بريطانية إقليمية ذات تأسيس حديث نسبياً؛ تتميز عن جامعة أكسفورد وجامعة كامبريدج)",
 "redbrush": "قرانيا أمريكية, قرانيا حمراء (شجيرة شائعة في أمريكا الشمالية بغصينات أرجوانية محمرة وزهور بيضاء)",
 "redbud": "برعم أحمر, زمريق كندي (شجرة شجيرية صغيرة من شرق أمريكا الشمالية تشبه شجرة يهوذا ولها زهور وردية عادة؛ توجد في الغابات التحتية المحمية الرطبة)",
 "redbug": "بق الحصاد, سوس الحصاد (يرقة سوس تمتص دم الفقاريات بما في ذلك البشر مسببة تهيجاً شديداً)",
 "redcap": "شيّال المحطة (حمّال يساعد الركاب في حمل أمتعتهم في محطة السكة الحديد) / شُرْطِيّ عَسْكَرِيّ بَرِيطانِيّ (عضو في الشرطة العسكرية في بريطانيا (يسمى ذو القبعة الحمراء))",
 "redcoat": "جندي بريطاني, ذو المعطف الأحمر (جندي بريطاني؛ سمي كذلك بسبب معطفه الأحمر (خاصة خلال الثورة الأمريكية))",
 "redden": "اِحْمَرَّ (أصبح لونه أَحْمَرا بعد أن كان بلون ثان؛ تَضَرَّجَ؛ ازداد حَمَارُهُ) / حَمَّرَ (السَيْر: سَحا قشره؛ الشاة: سلخها)\nمثال: شعرت بالخجل و احمر وجهها.",
 "reddened": "مُحْمَرّ, مُشْتَعِل (مُضَاء بِضَوْءٍ أَحْمَر كَأَنَّهُ مُلْتَهِب) / مُتَوَرِّد, مُحْمَرّ ((خاصة للوجه) محمر أو مشبع بالدم من الانفعال أو المجهود)",
 "reddish": "أَحْمَر, قِرْمِزِيّ (بلون في نهاية الطيف اللوني قرب البرتقالي؛ يشبه لون الدم أو الكرز أو الياقوت)",
 "reddish blue": "بنفسجي (لون متغير يقع بعد الأزرق في الطيف)",
 "reddish brown": "بني داكن, بني محمر (درجة من البني مع مسحة من الأحمر)",
 "reddish orange": "برتقالي محمر (لون برتقالي أقرب إلى الأحمر منه إلى الأصفر)",
 "reddish purple": "أرجواني محمر (درجة من الأرجواني مشوبة بالأحمر)",
 "reddish-brown": "بُنِّيّ مُحْمَرّ (بني مع مسحة حمراء)",
 "reddish-gray": "رَمَادِيّ مُحْمَرّ (رمادي مع مسحة حمراء)",
 "reddish-grey": "رَمَادِيّ مُحْمَرّ (رمادي مع مسحة حمراء)",
 "reddish-lavender": "خُزَامِيّ مُحْمَرّ (خزامي مع مسحة حمراء)",
 "reddish-orange": "بُرْتُقَالِيّ مُحْمَرّ (برتقالي مع مسحة حمراء)",
 "reddish-pink": "وَرْدِيّ مُحْمَرّ (وردي قريب من الأحمر)",
 "reddish-purple": "أُرْجُوَانِيّ مُحْمَرّ (أرجواني مع مسحة حمراء)",
 "reddish-striped": "مُخَطَّط بِالأَحْمَر (ذو خطوط حمراء اللون)",
 "reddish-violet": "بَنَفْسَجِيّ مُحْمَرّ (بنفسجي مع مسحة حمراء)",
 "reddishness": "احمرار (خاصية الميل للاحمرار إلى حد ما)\nمثال: احتضن احمرار المارسالا واقرنه بالأخضر والذهبي لتغليف الهدايا أو البطاقات",
 "reddle": "حجر تعليم أحمر, مغرة حمراء (خام حديد أحمر يستخدم في الصباغة ووضع العلامات)",
 "rededication": "إعادة تكريس (تكريس جديد لشيء ما)\nمثال: إعادة تكريس معبد القدس",
 "redeemable": "قَابِلٌ لِلإِصْلَاح (يَقْبَلُ الإِصْلَاحَ أَوِ التَّهْذِيب) / قَابِل لِلاسْتِرْدَاد, قَابِل لِلصَّرْف (يمكن تحويله إلى نقد جاهز أو ما يعادله) / قَابِلٌ لِلِاسْتِرْدَادِ (يمكن استعادته عند الدفع أو استيفاء شرط معين)",
 "redeemed": "مُخَلَّص, مُفْتَدًى (مُنقَذ من عبودية الخطيئة)",
 "redeemer": "مسترد, مفكك الرهن (شخص يسترد أو يشتري (سندات أو بضائع أو أوراق تجارية) مرة أخرى)",
 "redefinition": "إعادة تعريف (فعل إعطاء تعريف جديد)\nمثال: الكلمات مثل 'محافظ' تتطلب إعادة تعريف دورية",
 "redemption": "فِدَاء / خَلَاص",
 "redemptional": "خلاصي, فدائي (من أو متعلق بـ أو يؤدي إلى الخلاص أو الفداء)\nمثال: نظرية خلاصية حول الحياة",
 "redemptive": "خَلَاصِيّ, مُنقِذ (يُحقق الخلاص أو الفداء من الذنب) / خلاصي, فدائي (من أو متعلق بـ أو يؤدي إلى الخلاص أو الفداء)\nمثال: نظرية خلاصية حول الحياة",
 "redemptory": "خلاصي, فدائي (من أو متعلق بـ أو يؤدي إلى الخلاص أو الفداء)\nمثال: نظرية خلاصية حول الحياة",
 "redeployment": "إعادة توزيع, إعادة نشر (سحب وإعادة توزيع القوات في محاولة لاستخدامها بفعالية أكبر)",
 "redeposition": "إعادة الترسيب (الترسيب من رواسب إلى أخرى)",
 "redetermination": "إعادة تحديد (التحديد مرة أخرى)",
 "redevelopment": "إعادة تأهيل, تجديد (فعل التحسين عن طريق التجديد والاستعادة)\nمثال: إنهم يتابعون برنامجاً عاماً لتجديد العقار بأكمله",
 "redevelopment authority": "هيئة إعادة التطوير (وحدة إدارية عامة تُعطى مسؤولية تجديد المناطق الحضرية المتدهورة)",
 "redeye": "رحلة ليلية (رحلة ليلية يخرج منها الركاب بعيون حمراء من قلة النوم)\nمثال: أخذ الرحلة الليلية ليصل إلى المنزل في صباح اليوم التالي",
 "redeye flight": "رحلة ليلية (رحلة ليلية يخرج منها الركاب بعيون حمراء من قلة النوم)\nمثال: أخذ الرحلة الليلية ليصل إلى المنزل في صباح اليوم التالي",
 "redfin pickerel": "بيكريل أحمر الزعانف (بيكريل صغير ولكنه مقدام في الولايات الساحلية الأطلسية)",
 "redfish": "ذكر السلمون (ذكر السلمون الذي قام بالتخصيب حديثاً) / سمكة الطبل الأحمر, طبل أحمر (سمكة كبيرة صالحة للأكل توجد قبالة ساحل الولايات المتحدة من ماساتشوستس إلى المكسيك) / سمك أحمر, سمك الصخر (سمك الصخر من شمال الأطلسي)",
 "redhead": "نقار الخشب أحمر الرأس (نقار خشب أسود وأبيض من أمريكا الشمالية له رأس ورقبة حمراء) / بطة حمراء الرأس (بطة غواصة من أمريكا الشمالية ذات جسم رمادي وأسود ورأس بني محمر) / أحمر الشعر, أصهب (شخص ذو شعر أحمر)",
 "redheaded": "أَحْمَر الشَّعْر (ذو شعر أحمر وعادة بشرة فاتحة)",
 "redheaded woodpecker": "نقار الخشب أحمر الرأس (نقار خشب أسود وأبيض من أمريكا الشمالية له رأس ورقبة حمراء)",
 "redheader": "أحمر الشعر, أصهب (شخص ذو شعر أحمر)",
 "redhorse": "الحصان الأحمر, ريد هورس (سمكة ماصة من أمريكا الشمالية ذات زعانف حمراء)",
 "redhorse sucker": "الحصان الأحمر, ريد هورس (سمكة ماصة من أمريكا الشمالية ذات زعانف حمراء)",
 "rediffusion": "إعادة البث (نظام لتوزيع برامج الراديو أو التلفزيون)",
 "redirect examination": "إعادة استجواب ((قانون) استجواب الشاهد من قبل الطرف الذي استدعاه بعد خضوع هذا الشاهد للاستجواب المضاد)",
 "redirection": "تَحْوِيل",
 "rediscovery": "إعادة اكتشاف (فعل الاكتشاف مرة أخرى)",
 "redisposition": "إعادة توزيع, إعادة نشر (سحب وإعادة توزيع القوات في محاولة لاستخدامها بفعالية أكبر)",
 "redistributed": "مُعَاد تَوْزِيعُه (نُقِل سكانه وصناعاته من المناطق الحضرية إلى المناطق المحيطة)",
 "redistribution": "إعادة توزيع (التوزيع مرة أخرى)\nمثال: أدت الثورة إلى إعادة توزيع الثروة",
 "redly": "بحمرة (بإظهار اللون الأحمر)\nمثال: أطلق الكور لهباً أحمر نحو السماء",
 "redmaids": "خادمة حمراء, كالاندرينا مهدبة (نبات عصاري يشكل بساطاً وله أزهار صغيرة زاهية باللون الوردي المحمر؛ جنوب غرب الولايات المتحدة)",
 "redneck": "أحمر الرقبة, قروي أبيض فقير (شخص أبيض فقير في جنوب الولايات المتحدة (مصطلح عامي))",
 "redness": "حُمْرَة",
 "redolence": "أريج, شذى (خاصية شمية حلوة وممتعة)",
 "redolent": "أَرِيج, عَطِر (ذُو رَائِحَةٍ طَيِّبَةٍ قَوِيَّةٍ) / مُذَكِّرٌ, مُسْتَحْضِرٌ (يستحضر الذاكرة ويثير في الذهن صوراً أو معاني)",
 "redoubled": "مُضَاعَف (ازداد كثيراً في الشدّة أو الحجم أو الكمّية)",
 "redoubt": "معقل محصن (معقل أو ملجأ راسخ) / معقل ((عسكري) تحصين مؤقت أو تكميلي؛ عادة ما يكون مربعاً أو مضلعاً بدون دفاعات جانبية)",
 "redoubtable": "مَهِيب, مُرْهِب (يبعث على الخوف والرهبة) / جَلِيلٌ, مَهِيبٌ (جدير بالاحترام والتوقير)",
 "redox": "أكسدة واختزال (تفاعل كيميائي عكسي يكون فيه أحد التفاعلين أكسدة والعكسي اختزالاً)",
 "redpoll": "حسون ناري (عصفور صغير يشبه حسون الشوك ذو تاج أحمر وصدر وردي) / حسون قطبي (عصفور صغير يشبه حسون الشوك ذو تاج أحمر)",
 "redraft": "إعادة السحب, كمبيالة الرجوع (كمبيالة بمبلغ كمبيالة مرفوضة مضافاً إليها تكاليف ورسوم السحب مرة أخرى)",
 "redress": "إصلاح, جبر الضرر (فعل تصحيح خطأ أو عيب أو شر) / تعويضات, غرامة تعويضية (مبلغ من المال يُدفع كتعويض عن خسارة أو إصابة)",
 "redroot": "جذر الدم, سانغويناريا (نبات معمر من غابات أمريكا الشمالية له جذر أحمر وعصارة حمراء، يحمل ورقة مفصصة وحيدة وزهرة بيضاء في أوائل الربيع وله خصائص مقيأة حريفة؛ يستخدم الساق…)",
 "redshank": "طيطوي أحمر الساق (طائر خوض شائع في العالم القديم ذو أرجل حمراء طويلة)",
 "redshift": "انزياح أحمر ((في علم الفلك) انزياح في أطياف المجرات البعيدة جداً نحو أطوال موجية أطول (نحو الطرف الأحمر من الطيف)؛ يفسر عموماً كدليل على أن الكون يتوسع)",
 "redskin": "هِنْدِيّ أَحْمَر, أَمْرِيكِيّ أَصْلِيّ (المنسوب إلى الهِنْد)",
 "redstart": "حَمِيرَاء",
 "redstem storksbill": "رقمة شوكرانية, منقار اللقلق أحمر الساق (عشب ضار أوروبي توطن في جنوب غرب الولايات المتحدة والمكسيك له سيقان منبطحة محمرة بأوراق صغيرة تشبه السرخس وزهور صغيرة خزامية حمراء عميقة تليها ثمار…)",
 "redtail": "حميراء (طائر مغرد أوروبي ذو صدر وذيل محمر؛ قريب من طيور أبي الحناء في العالم القديم) / باز أحمر الذيل (نوع من الصقور الأمريكية ذات اللون البني الداكن ولها ذيل بني محمر)",
 "reduce": "قَلَّلَ",
 "reduced": "متناقص, مخفض (أصبح أقل في الحجم أو الكمية أو الدرجة) / بَخْس, مُخَفَّض (أقلّ بكثير من المعتاد خاصَّة في السعر)",
 "reduced instruction set computer": "حاسوب بمجموعة تعليمات مقلصة, ريسك ((علم الحاسوب) نوع من معمارية الحاسوب يحتوي على مجموعة صغيرة نسبياً من تعليمات الحاسوب التي يمكنه تنفيذها)",
 "reduced instruction set computing": "حاسوب بمجموعة تعليمات مقلصة, ريسك ((علم الحاسوب) نوع من معمارية الحاسوب يحتوي على مجموعة صغيرة نسبياً من تعليمات الحاسوب التي يمكنه تنفيذها)",
 "reduced vowel": "صائت مختزل (شكل غير منبور ومركزي لصائت كامل)",
 "reducer": "مُخفِّض, وصلة تصغير (وصلة أنابيب تربط بين أنبوبين مختلفي القطر) / عامل مختزل, مختزل (مادة قادرة على إحداث اختزال لمادة أخرى بينما تتأكسد هي نفسها؛ تستخدم في التصوير الفوتوغرافي لتقليل كثافة السالب أو المطبوعة عن طريق أكسدة بعض الفضة…)",
 "reducible": "قابل للاختزال, قابل للتبسيط (قادر على أن يتم اختزاله)\nمثال: قابل للاختزال إلى مجموعة من مبادئ الطبيعة البشرية",
 "reducing": "تخسيس, تنحيف (فقدان الوزن الزائد (عن طريق اتباع نظام غذائي مثلاً)؛ أن تصبح أنحف) / اختزال (أي عملية تضاف فيها إلكترونات إلى ذرة أو أيون (كما هو الحال عند إزالة الأكسجين أو إضافة الهيدروجين)؛ وتحدث دائماً مصحوبة بأكسدة العامل المختزل)\nمثال: أشرف طبيب على عملية تنحيفها",
 "reducing agent": "عامل مختزل, مختزل (مادة قادرة على إحداث اختزال لمادة أخرى بينما تتأكسد هي نفسها؛ تستخدم في التصوير الفوتوغرافي لتقليل كثافة السالب أو المطبوعة عن طريق أكسدة بعض الفضة…)",
 "reducing diet": "حمية إنقاص الوزن, حمية التخسيس (نظام غذائي مصمم للمساعدة في فقدان الوزن (خاصة الدهون))",
 "reductant": "عامل مختزل, مختزل (مادة قادرة على إحداث اختزال لمادة أخرى بينما تتأكسد هي نفسها؛ تستخدم في التصوير الفوتوغرافي لتقليل كثافة السالب أو المطبوعة عن طريق أكسدة بعض الفضة…)",
 "reductase": "ريدوكتاز (إنزيم يحفز الاختزال الكيميائي الحيوي لبعض المواد المحددة)",
 "reductio": "الإثبات بالخلف, برهان الخلف (دحض عن طريق إظهار أن عواقب الاقتراح سخيفة؛ أو إثبات اقتراح عن طريق إظهار أن نفيها يؤدي إلى تناقض)",
 "reductio ad absurdum": "الإثبات بالخلف, برهان الخلف (دحض عن طريق إظهار أن عواقب الاقتراح سخيفة؛ أو إثبات اقتراح عن طريق إظهار أن نفيها يؤدي إلى تناقض)",
 "reduction": "نَقْص",
 "reduction division": "انقسام اختزالي, انقسام منصف ((علم الوراثة) انقسام الخلية الذي ينتج خلايا تناسلية في الكائنات التي تتكاثر جنسيًا؛ تنقسم النواة إلى أربع نوى تحتوي كل منها على نصف عدد الكروموسومات)",
 "reduction gear": "ترس تخفيض السرعة (تروس تقلل سرعة الدخل إلى سرعة خرج أبطأ)",
 "reductionism": "اختزالية (تحليل الأشياء المعقدة إلى مكونات أبسط) / اختزالية (نظرية تفيد بأن الأنظمة المعقدة يمكن فهمها بالكامل من حيث مكوناتها)",
 "reductionist": "اختزالي (من أو يتعلق بنظرية الاختزالية)\nمثال: حجج اختزالية",
 "reductive": "اخْتِزَالِيّ (يتّسم بالتقليص أو التقليل أو يتسبّب فيه)",
 "reductivism": "التبسيطية, الفن التقليلي (حركة فنية في النحت والرسم بدأت في الخمسينيات وأكدت على التبسيط الشديد للشكل واللون)",
 "redundance": "زيادة, فائض (سمة كون الشيء زائداً وغير مطلوب)\nمثال: خلق استخدام الروبوتات الصناعية فائضاً في العمالة",
 "redundancy": "تكرار زائد, حشو (تكرار فعل ما بلا حاجة) / زيادة, فائض (سمة كون الشيء زائداً وغير مطلوب) / تكرار احتياطي ((إلكترونيات) تصميم نظام يكرر المكونات لتوفير بدائل في حالة فشل أحد المكونات) / تكرار زائد, حشو (تكرار الرسائل لتقليل احتمالية الأخطاء في الإرسال)\nمثال: خلق استخدام الروبوتات الصناعية فائضاً في العمالة",
 "redundancy check": "فحص التكافؤ (نظام للتحقق من الأخطاء في عمل الكمبيوتر)",
 "redundant": "فَائِض, زَائِد / حَشْو",
 "reduplication": "مضاعفة",
 "reduviid": "بق قاتل (بق حقيقي: بق مفترس طويل الأرجل يعيش غالباً على الحشرات الأخرى؛ وعدد قليل منها يمتص دماء الثدييات)",
 "redwing": "سمنة حمراء الجناح (سمنة أوروبية صغيرة ذات جوانب حمراء) / شحرور أحمر الجناح (شحرور من أمريكا الشمالية ذو بقع قرمزية على الأجنحة)",
 "redwood": "خشب أحمر (الخشب المحمر الناعم لأي من نوعي أشجار السيكويا) / خشب الخشب الأحمر, سيكويا (خشب أي من شجرتين صنوبريتين ضخمتين في كاليفورنيا يصل ارتفاعهما إلى 300 قدم) / خشب أحمر, سيكويا (هو ما غَلَظَ وصَلُبَ من أصول الشَجَر وفروعها مثل الجِذْع والأغْصَان؛ هو ما صنع من جذوع أو أغصان الشَجَر)\nمثال: نحن نقطع الخشب.",
 "redwood penstemon": "بنستيمون الخشب الأحمر, بنستيمون شجيري أحمر (شجيرة منخفضة التفرع خضراء داكنة مع باقات من الزهور الحمراء القرميدية في نهايات الفروع؛ السلاسل الساحلية وسفوح التلال في شمال كاليفورنيا)",
 "reechoing": "صَادٍ, مُتَرَدِّد ((للأصوات) يتكرر بالانعكاس)",
 "reed": "قَصَبَة, بُوصَة",
 "reed bunting": "درسة القصب (طائر درسة أوروبي يسكن المناطق المستنقعية)",
 "reed canary grass": "عشب الشريط, عشب القصب الكناري (عشب معمر في مروج المستنقعات والخنادق له أوراق عريضة؛ أوروبا وأمريكا الشمالية)",
 "reed grass": "عشب القصب (أي من أعشاب معمرة طويلة مختلفة من جنس كالاماغروستيس لها ريش ناعم؛ موطنها مستنقعات وأراضي الغابات الرطبة في نصف الكرة الشمالي المعتدل)",
 "reed instrument": "آلة ذات ريشة, آلة قصبية (آلة موسيقية تصدر صوتاً عن طريق قصبة مهتزة)",
 "reed mace": "بردي, بوط عريض الأوراق (نبات مستنقعات طويل برؤوس بذور أسطوانية تنفجر عند النضج وتذرف كميات كبيرة من الزغب؛ تستخدم أوراقه الطويلة المسطحة لصنع الحصير ومقاعد الكراسي؛ من…)",
 "reed meadow grass": "عشب المروج القصبي (عشب مراعي في الأماكن الرطبة في جميع أنحاء أمريكا الشمالية)",
 "reed organ": "أرغن القصب, هارمونيوم (آلة ذات قصبات حرة مع لوحة مفاتيح بيانو يتم فيها دفع الهواء عبر القصبات بواسطة منفاخ)",
 "reed pipe": "أنبوب قصبي (أنبوب أرغن بقصبة مهتزة)",
 "reed rhapis": "نخيل السيدة النحيل (جمع نَخْلَة)\nمثال: زيري يغرس نخيل التمر.",
 "reed section": "قسم آلات الريش (قسم الفرقة أو الأوركسترا الذي يعزف على آلات الريش (النفخ الخشبية))",
 "reed stop": "موقف الريشة (في الأرغن) (موقف أرغن بنغمة تشبه آلة ذات ريشة)",
 "reedbird": "هزاز السعد (هازجة أوروبية صغيرة تتكاثر بين القصب والسعد وتشتي في أفريقيا) / بوبولينك (طائر مغرد أمريكي مهاجر)",
 "reedlike": "رَفِيع مُنْتَصِب, كَالقَصَبَة (يُشْبِه القَصَبَة فِي الانْتِصَاب والنُّحُول)",
 "reedmace": "بردي, بوط عريض الأوراق (نبات مستنقعات طويل برؤوس بذور أسطوانية تنفجر عند النضج وتذرف كميات كبيرة من الزغب؛ تستخدم أوراقه الطويلة المسطحة لصنع الحصير ومقاعد الكراسي؛ من…)",
 "reedy": "رَفِيع مُنْتَصِب, كَالقَصَبَة (يُشْبِه القَصَبَة فِي الانْتِصَاب والنُّحُول) / أَزِيزِيّ, نَاعِر (ذو نبرة تشبه صوت آلة القصب الموسيقية)",
 "reef": "شَعَاب",
 "reef knot": "عقدة اليد, عقدة مربعة (عقدة مربعة تستخدم في حبل تقليص الشراع)",
 "reef line": "خيط تقليص الشراع ((مصطلح بحري) أحد الأطوال القصيرة للحبل المخيطة عبر الشراع لربط طية التقليص)\nمثال: يجب على أحد أفراد الطاقم سحب خيط التقليص بينما يقوم آخر بإنزال الشراع",
 "reef point": "خيط تقليص الشراع ((مصطلح بحري) أحد الأطوال القصيرة للحبل المخيطة عبر الشراع لربط طية التقليص)\nمثال: يجب على أحد أفراد الطاقم سحب خيط التقليص بينما يقوم آخر بإنزال الشراع",
 "reef squirrelfish": "سمكة السنجاب المرجانية (توجد في الشعاب المرجانية من برمودا وفلوريدا إلى شمال أمريكا الجنوبية)",
 "reef whitetip shark": "قرش الشعاب أبيض الطرف (كلب بحر أملس يعيش في المحيطين الهادئ والهندي والبحر الأحمر وله زعانف ظهرية وذيلية بيضاء الطرف)",
 "reefer": "جوينت, سيجارة ماريجوانا (أوراق ماريجوانا ملفوفة في سيجارة للتدخين)",
 "reefing line": "خيط تقليص الشراع ((مصطلح بحري) أحد الأطوال القصيرة للحبل المخيطة عبر الشراع لربط طية التقليص)\nمثال: يجب على أحد أفراد الطاقم سحب خيط التقليص بينما يقوم آخر بإنزال الشراع",
 "reefy": "ضَحْضَاح, مَلِيءٌ بِالشِّعَاب (مَلِيءٌ بِالشِّعَابِ المَغْمُورَةِ أَوِ الضُّحُولِ الرَّمْلِيَّة)",
 "reek": "نَتَانَة",
 "reeking": "مُنْتِن, نَتِن (يَنْبَعِثُ مِنْهُ رَائِحَة كَرِيهَة قَوِيَّة) / دَامِع, رَاشِح (مبلَّل بإفرازات رطبة كالعَرَق أو الدموع)",
 "reel": "بَكَرَة",
 "reelection": "إِعَادَة اِنْتِخَاب (الانتخاب مرة أخرى)\nمثال: لم يترشح لإعادة الانتخاب",
 "reeler": "راقص الريل (راقص لرقصات الريل) / مترنح (شخص يمشي بشكل غير مستقر وكأنه على وشك السقوط)",
 "reenactment": "إعادة تمثيل (أداء دور في حدث وقع في وقت سابق)\nمثال: إعادة تمثيل معركة برينستون",
 "reenactor": "مجسد للأحداث التاريخية, ممثل إعادة تجسيد (شخص يجسد دوراً في حدث وقع سابقاً)",
 "reenforcement": "تعزيز, دعم (عملية عسكرية (غالباً ما تتضمن إمدادات جديدة من الرجال والعتاد) لتقوية قوة عسكرية أو المساعدة في أداء مهمتها) / تعزيز, تقوية (معلومات تجعل الأمر أكثر قوة أو إقناعاً)\nمثال: طلبوا دعماً مدفعياً",
 "reenlistment": "إِعَادَة التَّطَوُّع (تجديد التطوع)",
 "reentering angle": "زاوية منعكسة (زاوية داخلية لمضلع تزيد عن 180 درجة)",
 "reentering polygon": "مضلع منعكس (مضلع له زاوية منعكسة واحدة أو أكثر)",
 "reentrant": "داخل, منعكس ((للزوايا) تشير إلى الداخل)\nمثال: مضلع بزوايا منعكسة",
 "reentrant angle": "زاوية منعكسة (زاوية داخلية لمضلع تزيد عن 180 درجة)",
 "reentrant polygon": "مضلع منعكس (مضلع له زاوية منعكسة واحدة أو أكثر)",
 "reentry": "دخول مجدد (فعل الدخول مرة أخرى)",
 "reevaluation": "إعادة تقييم (تقييم شيء ما للمرة الثانية (أو أكثر))",
 "reeve": "أنثى الدريجة المطوقة (أنثى طائر الدريجة المطوقة)",
 "reexamination": "فحص لاحق, متابعة (فحص لاحق للمريض لغرض مراقبة العلاج السابق) / إعادة استجواب ((قانون) استجواب الشاهد من قبل الطرف الذي استدعاه بعد خضوع هذا الشاهد للاستجواب المضاد)",
 "ref": "حكم ((رياضة) المسؤول الرئيسي (كما في الملاكمة أو كرة القدم الأمريكية) المتوقع منه ضمان اللعب النظيف)",
 "refabrication": "إعادة تجميع, إعادة تصنيع (التجميع مرة أخرى)",
 "refection": "لقمة, وجبة خفيفة (وجبة خفيفة أو طعام)",
 "refectory": "قاعة طعام مشتركة, مائدة الدير (قاعة طعام جماعية (عادة في دير))",
 "refectory table": "طاولة طعام طويلة (طاولة طعام طويلة وضيقة مدعومة بمسند عرضي بين حاملين)",
 "refer": "أَشَارَ",
 "referable": "رَاجِع إِلَى, قَابِل لِلنِّسْبَة (قابل للإسناد أو النسبة إلى شيء ما)",
 "referee": "حَكَم (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ)\nمثال: حكم علي بالموت.",
 "refereeing": "تحكيم (فعل التحكيم (في الرياضة))\nمثال: كان التحكيم ممتازاً",
 "reference": "مَرْجِع",
 "reference book": "كِتَاب مَرْجِعِيّ (موضع تعليم الكتابة. الاستخدام الأصلي؛ مدرسة شبه رسمية لتعليم الأطفال الكِتَابَة والقِرَاءَة ومباديء الحِسَاب وبعض القُرَآن…)\nمثال: هذا الكتاب جديد",
 "reference data": "بَيَانَات مَرْجِعِيَّة",
 "reference frame": "إطار مرجعي, نظام إحداثيات (نظام يستخدم الإحداثيات لتحديد الموقع)",
 "reference grid": "شبكة مرجعية (نمط من الخطوط الأفقية والعمودية التي توفر إحداثيات لتحديد النقاط على صورة أو خريطة)",
 "reference manual": "دليل مرجعي (دليل يحتوي على معلومات منظمة بطريقة موجزة)",
 "reference point": "مرجع, نقطة مرجعية (مؤشر يوجهك بشكل عام)",
 "reference system": "إطار مرجعي, نظام إحداثيات (نظام يستخدم الإحداثيات لتحديد الموقع)",
