 "resinoid": "شبيه الراتينج (بلاستيك يحتوي على راتنجات)",
 "resinous": "رَاتِنْجِيّ, قَطْرَانِيّ (له خصائص القطران أو الراتنج)",
 "resiny": "رَاتِنْجِيّ, قَطْرَانِيّ (له خصائص القطران أو الراتنج)",
 "resist": "قَاوَمَ (ظَلَّ يقوم ضد الشيء، استمر في القيام)\nمثال: قاوم حتى النهاية!",
 "resistance": "مُقَاوَمَة",
 "resistance furnace": "فرن المقاومة (فرن كهربائي تتولد فيه الحرارة عن طريق مرور تيار كهربائي عبر مقاومة)",
 "resistance pyrometer": "بيرومتر المقاومة (بيرومتر يقيس درجات الحرارة العالية عن طريق المقاومة في سلك ساخن)",
 "resistance thermometer": "مقياس حرارة المقاومة, مقياس حرارة بلاتيني (مقياس حرارة يقيس درجة الحرارة عن طريق التغيرات في مقاومة لولب من سلك البلاتين)",
 "resistance unit": "وحدة مقاومة (مقلوب الموصلية)",
 "resistant": "طَارِد, مُقَاوِم (غير قادر على الامتصاص أو الاختلاط) / عَاصٍ, مُقَاوِم (مَيَّالٌ إِلَى تَحَدِّي السُّلْطَةِ القَائِمَةِ أَوْ مُنْخَرِطٌ فِيه) / مُقَاوِم (لا يتأثّر بسهولة؛ محصَّن ضدّ التأثير) / مَنِيع, مُقَاوِم (يتعلق بالمناعة أو يمنحها (ضد المرض أو العدوى))",
 "resister": "خَصْم, غريم (شخص يبدي المعارضة) / مُعَرْقِل, مُعَوِّق (شخص يعيق بشكل منهجي إجراءً يريد الآخرون اتخاذه)",
 "resistible": "قابل للمقاومة (يمكن مقاومته أو الصمود أمامه أو إحباطه)\nمثال: هجوم يمكن صده",
 "resisting arrest": "مقاومة الاعتقال (الجهود الجسدية لمعارضة الاعتقال القانوني؛ تصنف المقاومة كاعتداء وضرب على شخص ضابط الشرطة الذي يحاول الاعتقال)",
 "resistive": "عَاصٍ, مُقَاوِم (مَيَّالٌ إِلَى تَحَدِّي السُّلْطَةِ القَائِمَةِ أَوْ مُنْخَرِطٌ فِيه) / مقاوم (يظهر أو يتعلق بالمقاومة الكهربائية)\nمثال: حمل مقاوم",
 "resistivity": "مقاومة, مقاومة كهربائية (ممانعة المادة لتدفق التيار الكهربائي؛ تقاس بالأوم)",
 "resistless": "غَيْر مُقَاوِم, مُسْتَسْلِم (لا يُقدِّم مقاومة؛ يقبل الوضع بسلبيّة) / ساحق, لا يقاوم (مستحيل مقاومته؛ غلاب)\nمثال: دوافع لا تقاوم",
 "resistor": "مقاومة (جهاز كهربائي يقاوم تدفق التيار الكهربائي)",
 "resolute": "بِلَا تَرَدُّد, عَازِم (يتميز بالسرعة والحزم في اتخاذ القرار) / حازم, صارم (ثابت في الغرض أو المعتقد؛ يتميز بالحزم والتصميم)\nمثال: وقف بحزم ضد العدو",
 "resolutely": "بِإِصْرَار, بِعَزْم (إظهار تصميم أو هدف حازم) / بِتَصْمِيم, بِحَزْم (بثبات الهدف)\nمثال: رفضت بحزم النظر إليه أو التحدث معه",
 "resoluteness": "حزم, عزم (سمة كون المرء حازماً)\nمثال: حمله عزمه خلال المعركة",
 "resolution": "عَزْم, عُزْم / دِقَّة",
 "resolvable": "قَابِلٌ لِلْحَلِّ (يمكن تسويته أو حله) / قَابِلٌ لِلْحَلّ (يمكن حلّه والتوصّل إلى إجابته)",
 "resolve": "حَلَّ (للعقدة: ضد عَقْدها؛ للجامد في السائل: إذابته)\nمثال: حل زيري المشكل.",
 "resolved": "أُحَادِيُّ الْهَدَفِ, مُصَمِّمٌ (مُصَمِّم ومُنصَبّ على هدف واحد) / محلول, مفكك (لغزه) (تم تفسيره أو الإجابة عليه)\nمثال: ألغاز محلولة وغير محلولة",
 "resolvent": "مذيب, مُحِل (مادة سائلة قادرة على إذابة مواد أخرى)\nمثال: المذيب لا يغير حالته عند تكوين محلول",
 "resolving": "تحليل, تفكيك (تحليل إلى مكونات واضحة المعالم)",
 "resolving power": "دقة, قدرة التمييز (قدرة المجهر أو التلسكوب على قياس الفصل الزاوي للصور المتقاربة)",
 "resonance": "رنين, صويت (الجودة التي تضفيها غرف الرنين في الحلق والفم والتجاويف الأنفية على أصوات الكلام المنطوقة) / جهارة, دوي (امتلاك طابع صوت عميق وعالٍ؛ خاصية الرنين) / رنين (اهتزاز ذو سعة كبيرة ينتج عن اهتزاز صغير نسبياً بالقرب من نفس تردد الاهتزاز مثل التردد الطبيعي للنظام الرنان) / رنين (حالة مثارة لجسيم مستقر تسبب حداً أقصى حاداً في احتمالية امتصاص الإشعاع الكهرومغناطيسي)",
 "resonant": "مُذَكِّرٌ, مُسْتَحْضِرٌ (يستحضر الذاكرة ويثير في الذهن صوراً أو معاني) / رَنَّان, مُتَرَنِّم (يتميّز بالرنين والطنين)",
 "resonant circuit": "دائرة رنين, رنان (دائرة كهربائية تجمع بين السعة والمحاثة بطريقة تجعل التذبذب الكهربائي الدوري يصل إلى أقصى سعة)",
 "resonating": "رَنَّان, مُتَرَنِّم (يتميّز بالرنين والطنين)",
 "resonating chamber": "حجرة رنين, رنان (حجرة مجوفة تسمح أبعادها بالتذبذب الرنيني للموجات الكهرومغناطيسية أو الصوتية)",
 "resonator": "رنان, مرنان (أي نظام يحدث له رنين) / دائرة رنين, رنان (دائرة كهربائية تجمع بين السعة والمحاثة بطريقة تجعل التذبذب الكهربائي الدوري يصل إلى أقصى سعة) / حجرة رنين, رنان (حجرة مجوفة تسمح أبعادها بالتذبذب الرنيني للموجات الكهرومغناطيسية أو الصوتية)",
 "resorcinol": "ريزورسينول (فينول بلوري يتم الحصول عليه من راتنجات مختلفة؛ يستخدم في مراهم حب الشباب وشامبو قشرة الرأس)",
 "resorcinolphthalein": "صبغة الفلوريسين, فلوريسين (صبغة صفراء تظهر بوضوح حتى عند تخفيفها بشدة؛ تستخدم كمؤشر امتزاز)",
 "resorption": "ارتشاف, امتصاص (العملية العضوية التي تخضع فيها مادة بنية متمايزة تم إنتاجها بواسطة الجسم للتحلل والاستيعاب)",
 "resort": "مُنْتَجَع",
 "resort area": "مساحة للترويح, منتجع (منطقة يذهب إليها الكثير من الناس للترفيه أو العطلات)",
 "resort hotel": "فندق منتجع, منتجع صحي (فندق راقٍ يقع عادة في منطقة منتجع) / فندق منتجع, منتجع (فندق يقع في منطقة منتجع)",
 "resounding": "مُجِلْجِل",
 "resoundingly": "بشكل مدوٍ, بقوة (بطريقة ذات صدى قوي أو تأثير كبير)\nمثال: ثم استنكر بشدة ومدوياً صديقه السابق",
 "resource": "مَوْرِد",
 "resourceful": "بَارِع, وَاسِع الحِيلَة (ذُو مَوَارِد دَاخِلِيَّة؛ حَاذِق أَوْ مُبْتَكِر)",
 "resourcefully": "ببراعة, بحيلة واسعة (بطريقة تدل على القدرة على إيجاد الحلول والوسائل)",
 "resourcefulness": "حُسْن التَّصَرُّف, دَهَاء (صفة القدرة على التعامل مع المواقف الصعبة) / دهاء, سعة الحيلة (القدرة على التعامل بدهاء مع المشاكل غير العادية)\nمثال: رجل ذو دهاء عظيم",
 "resourceless": "شَحِيحُ المَوَارِد (يفتقر إلى الموارد الطبيعية أو يعاني نقصاً فيها)",
 "respect": "اِحْتِرَام (احترام الذَّات: احترام النَّفس والشعور بالكرامة؛ احترامًا له: بدافع ال احترام) / اِعْتِبَار, صَدَد (اعتبر منه:تعجّب،وقيل:الْعِبْرة بالكسر هو الاسم من الاعتبار؛ اعتبر بالموت اعتباراً:تدبّر،اتّعظ به) / اِحْتَرَمَ\nمثال: تعامل معها باحترام.",
 "respectability": "احترام, سمعة حسنة (الشرف بحكم كون الشخص محترماً وذا سمعة طيبة)",
 "respectable": "مُحْتَرَم",
 "respectably": "بشكل محترم, بوقار (بطريقة لائقة وذات سمعة أخلاقية حسنة) / بشكل جيد, بشكل مقبول (إلى حد يستحق التقدير أو القبول)\nمثال: ينتهي الفيلم بزواج العاشقين في منتصف العمر بشكل محترم",
 "respected": "مَوْقُورٌ, مُحْتَرَمٌ (يحظى باحترام وتقدير الآخرين)",
 "respecter": "مُحْتَرِم, مُراعِي (شخص يحترم شخصاً أو شيئاً؛ تستخدم عادة في النفي)\nمثال: س لا يقيم وزناً لـ ص",
 "respectful": "مُحْتَرَم",
 "respectfully": "بِاحْتِرَام (بطريقة محترمة)\nمثال: هل لي أن أقترح باحترام على مجلس المدينة أن يتبنوا سياسة عدم النشاط المتقن؟",
 "respectfulness": "احترام, توقير (مراعاة مهذبة لمشاعر الناس)\nمثال: احتراماً لرغباتك",
 "respectively": "على التوالي (بالترتيب المذكور)\nمثال: سُمي الأخوان فيليكس وماكس، على التوالي",
 "respects": "احْتِرَام, تَحِيَّة ((غالباً ما تستخدم مع 'دفع' أو 'أدى') تعبير رسمي عن التقدير)\nمثال: أدى واجب الاحترام للعمدة",
 "respiration": "تنفس خلوي, تنفس داخلي (العمليات الأيضية التي تحصل بها بعض الكائنات الحية على الطاقة من الجزيئات العضوية؛ العمليات التي تحدث في الخلايا والأنسجة والتي يتم خلالها إطلاق…) / تنفس, تهوية (العملية الجسدية للشهيق والزفير؛ عملية أخذ الأكسجين من الهواء المستنشق وإطلاق ثاني أكسيد الكربون عن طريق الزفير) / نَفَس (عملية كاملة واحدة من الشهيق والزفير)\nمثال: ثلاثون نَفَسًا في الدقيقة",
 "respirator": "قناع غاز, كمامة تنفس (قناع واقٍ مزود بمرشح؛ يحمي الوجه والرئتين من الغازات السامة) / جهاز تنفس صناعي, منشقة (جهاز تنفس لإعطاء تنفس صناعي طويل الأمد)",
 "respiratory": "جِهَاز تَنَفُّسِيّ, تَنَفُّسِيّ",
 "respiratory acidosis": "حماض تنفسي (حماض ناتج عن انخفاض تبادل الغازات في الرئتين)",
 "respiratory alkalosis": "قلاء تنفسي (قلاء ناتج عن زيادة تبادل الغازات في الرئتين)",
 "respiratory center": "مركز تنفسي (المركز في النخاع المستطيل والجسر الذي يدمج المعلومات الحسية حول مستوى الأكسجين وثاني أكسيد الكربون في الدم ويحدد الإشارات التي سيتم إرسالها إلى عضلات…)",
 "respiratory disease": "اضطراب تنفسي, مرض تنفسي (مرض يصيب الجهاز التنفسي)",
 "respiratory disorder": "اضطراب تنفسي, مرض تنفسي (مرض يصيب الجهاز التنفسي)",
