 "reincarnation": "تَنَاسُخُ الأَرْوَاحِ",
 "reincarnationism": "تناسخية (مذهب يقول إنه عند موت الجسد تنتقل الروح إلى أو تولد مرة أخرى في جسد آخر)",
 "reindeer": "رَنَة",
 "reindeer lichen": "طحلب الرنة (أشنة متفرعة رمادية منتصبة في القطب الشمالي وحتى بعض المناطق المعتدلة الشمالية تشكل الغذاء الرئيسي للرنة والكاريبو وأحياناً يأكلها البشر)",
 "reindeer moss": "طحلب الرنة (أشنة متفرعة رمادية منتصبة في القطب الشمالي وحتى بعض المناطق المعتدلة الشمالية تشكل الغذاء الرئيسي للرنة والكاريبو وأحياناً يأكلها البشر)",
 "reinforce": "قَوَّى",
 "reinforced": "مُعَزَّز, مُقَوًّى ((عن الصابون أو عوامل التنظيف) أُضيفت إليه مادّة لزيادة الفعاليّة) / مُدَعَّم, مُعَزَّز (أُضيف إليه دعم أو قوة إضافية)",
 "reinforced concrete": "خرسانة مسلحة (خرسانة مضاف إليها معدن و/أو شبكة لتوفير دعم إضافي ضد الإجهاد)",
 "reinforcement": "تعزيز, دعم (عملية عسكرية (غالباً ما تتضمن إمدادات جديدة من الرجال والعتاد) لتقوية قوة عسكرية أو المساعدة في أداء مهمتها) / تعزيز, مكافأة (فعل يتم القيام به لتقوية سلوك مقبول) / دعامة تقوية, مقوي (جهاز مصمم لتوفير قوة إضافية) / مثير معزز, معزز ((علم النفس) مثير يقوي أو يضعف السلوك الذي أنتجه)\nمثال: طلبوا دعماً مدفعياً",
 "reinforcer": "مثير معزز, معزز ((علم النفس) مثير يقوي أو يضعف السلوك الذي أنتجه)",
 "reinforcing stimulus": "مثير معزز, معزز ((علم النفس) مثير يقوي أو يضعف السلوك الذي أنتجه)",
 "reinstatement": "إعادة اعتبار, إعادة للوظيفة (فعل إعادة شخص ما إلى منصب سابق) / إعادة, إعادة تعيين (حالة الإعادة إلى المنصب)\nمثال: أصررنا على إعادة العقيد لمنصبه",
 "reinsurance": "إِعَادَةُ تَأْمِين",
 "reinterpretation": "إعادة تأويل (تفسير جديد أو مختلف) / إعادة تفسير (معنى جديد أو مختلف)",
 "reintroduction": "إعادة تقديم (فعل تجديد التقديم)",
 "reinvestment": "إعادة استثمار (استثمار ثانٍ أو لاحق في نفس الشيء)",
 "reinvigorated": "مُتَجَدِّد النَّشَاط, مُنْتَعِش (ذو طاقة متجددة ونشاط مستعاد)",
 "reissue": "إعادة إصدار, طبعة جديدة (منشور (مثل كتاب) يُعاد طبعه دون تغييرات أو تحرير ويُعرض للبيع مرة أخرى)",
 "reit": "ريت, صندوق الاستثمار العقاري (صندوق استثمار يمتلك ويدير مجموعة من العقارات التجارية والرهون العقارية وأصول عقارية أخرى؛ ويمكن شراء وبيع أسهمه في سوق الأوراق المالية)",
 "reiter's disease": "متلازمة رايتر, مرض رايتر (متلازمة التهابية (سببها غير معروف) تصيب الذكور في الغالب؛ تتميز بالتهاب المفاصل والتهاب الملتحمة والتهاب الإحليل)",
 "reiter's syndrome": "متلازمة رايتر, مرض رايتر (متلازمة التهابية (سببها غير معروف) تصيب الذكور في الغالب؛ تتميز بالتهاب المفاصل والتهاب الملتحمة والتهاب الإحليل)",
 "reiteration": "تضاعف, تكرار متوالي (فعل التكرار مراراً وتكراراً (أو مثال على ذلك))",
 "reiterative": "تَكْرَارِيّ (يتسم بالتكرار المتتابع)",
 "reject": "رَفَضَ (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟",
 "rejected": "مَرْفُوض, مَهْجُور (رفضه الحبيب دون سابق إنذار)",
 "rejection": "رَفْض, إِبَاء (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟",
 "rejective": "رَافِض (يرفض أو يميل إلى الرفض)\nمثال: مواقف رافضة أو مفرطة في النقد من الآباء المحبطين",
 "rejoice": "أَفْرَحَ",
 "rejoicing": "ظَافِر, مُبْتَهِج (فَرِحٌ وَفَخُورٌ خَاصَّةً بِسَبَبِ نَصْرٍ أَوْ نَجَاح) / ابتهاج, تهلل (تلفظ بأصوات تعبر عن الفرح العظيم) / ابتهاج (شعور بالسعادة العظيمة)",
 "rejoicing in the law": "سمحات توراة, فرحة التوراة ((اليهودية) يوم مقدس يهودي يُحتفل به في 22 أو 23 من تشري للاحتفال بانتهاء الدورة السنوية لقراءات التوراة)",
 "rejoicing of the law": "سمحات توراة, فرحة التوراة ((اليهودية) يوم مقدس يهودي يُحتفل به في 22 أو 23 من تشري للاحتفال بانتهاء الدورة السنوية لقراءات التوراة)",
 "rejoicing over the law": "سمحات توراة, فرحة التوراة ((اليهودية) يوم مقدس يهودي يُحتفل به في 22 أو 23 من تشري للاحتفال بانتهاء الدورة السنوية لقراءات التوراة)",
 "rejoinder": "رد المدعى عليه ((قانون) مرافعة يقدمها المدعى عليه رداً على تعقيب المدعي) / جواب سريع, رد مفحم (رد سريع على سؤال أو ملاحظة (خاصة إذا كان ذكياً أو نقدياً))\nمثال: استدعى ذلك رداً حاداً من المعلم",
 "rejuvenate": "جَدَّدَ (الشيء: رممه أو أصلحه حتى صار كالجَدِيد؛ الكلام: أعاده من جديد)\nمثال: تعرف على أناس جدد.",
 "rejuvenation": "تجديد الشباب (فعل الاستعادة لحالة أكثر شباباً) / استعادة الشباب, تجدد (ظاهرة استعادة الحيوية والنضارة)\nمثال: التجدد السنوي للمناظر الطبيعية",
 "rejuvenescence": "تجدد الشباب (تجدد الخصائص الشبابية أو الحيوية)\nمثال: أدت اكتشافات النفط المكتشفة حديثاً إلى تجدد شباب اقتصاد الأمة",
 "relafen": "ريلافين, نابوميتون (دواء مضاد للالتهاب غير ستيرويدي (الاسم التجاري ريلافين))",
 "relanium": "ريلانيوم (دواء يحتوي على ديازيبام، متوفر في ليتوانيا وبولندا)",
 "relapse": "انتكاس, تراجع (فشل في الحفاظ على حالة أعلى)",
 "relapsing": "انتكاس, تراجع (فشل في الحفاظ على حالة أعلى)",
 "relapsing fever": "حمى راجعة, حمى ناكسة (تتميز بحمى عالية متكررة وتنتقل عن طريق لدغة القمل أو القراد المصاب؛ تتميز بنوبات من الحمى العالية والقشعريرة والصداع وآلام العضلات والغثيان التي…)",
 "relatable": "سَهْلُ التَّوَاصُلِ, مُحَبَّب (ذُو طَبِيعَةٍ يَسْهُلُ التَّعَاطُفُ مَعَهَا وَالتَّوَاصُلُ)",
 "related": "مُتَعَلَّق",
 "related to": "ذو صلة, متعلق بـ (متصل منطقياً أو سببياً أو بخصائص مشتركة)\nمثال: الرسم والفنون ذات الصلة",
 "relatedness": "ارْتِبَاط, قَرَابَة (طريقة معينة من الترابط)\nمثال: الارتباط بين جميع الكائنات الحية",
 "relation": "عَلَاقَة",
 "relation back": "أثر رجعي ((قانون) المبدأ القائل بأن الفعل الذي تم في وقت لاحق يعتبر قانونيًا قد حدث في وقت سابق)\nمثال: جادل محاميه من أجل الأثر الرجعي للشكوى المعدلة ليعود إلى وقت تقديم الشكوى الأولية",
 "relational": "عَلَاقِيّ (له علاقة بشيء آخر أو مرتبط به)",
 "relational adjective": "صفة تصنيفية, صفة نسبية (صفة تصنف اسمها (مثل 'مرض عصبي' أو 'آلة موسيقية'))",
 "relational database": "قاعدة بيانات علائقية (قاعدة بيانات يتم فيها تحديد العلاقات بين عناصر المعلومات بشكل صريح كسمات يمكن الوصول إليها)\nمثال: في قاعدة البيانات العلائقية يتم تنظيم البيانات كعدد من الجداول مختلفة الأحجام",
 "relational database management system": "نظام إدارة قواعد البيانات العلائقية (نظام إدارة قواعد بيانات مصمم لإدارة قاعدة بيانات علائقية)",
 "relations": "تَعَامُلَات, عَلَاقَات (تعاملات متبادلة أو اتصالات أو تواصل بين الأشخاص أو الجماعات)",
 "relationship": "عَلَاقَة, مُنَاسَبَة / صِلَة, عَلَاقَة",
 "relative": "نِسْبِيّ / قَرِيب, قَرِيبَة",
 "relative atomic mass": "كتلة ذرية, وزن ذري ((في الكيمياء) كتلة ذرة عنصر كيميائي معبر عنها بوحدات الكتلة الذرية)",
 "relative clause": "جملة موصولة (جملة يقدمها ضمير موصول)",
 "relative density": "كثافة نسبية (نسبة كثافة شيء ما إلى كثافة معيار)",
 "relative frequency": "تَرَدُّد نِسْبِيّ, تَكْرَار نِسْبِيّ (نسبة عدد الملاحظات في فئة إحصائية إلى العدد الكلي للملاحظات)",
 "relative humidity": "رُطُوبَة نِسْبِيَّة (نسبة كمية الماء في الهواء عند درجة حرارة معينة إلى الحد الأقصى للكمية التي يمكن أن يحملها عند تلك الدرجة؛ معبراً عنها كنسبة مئوية)",
 "relative incidence": "مُعَدَّل الحُدُوث, نِسْبَة الوُقُوع (التكرار النسبي لحدوث شيء ما)",
 "relative majority": "أكثرية نسبية, تعددية ((في انتخابات بها أكثر من خيارين) عدد الأصوات للمرشح أو الحزب الذي يحصل على أكبر عدد (ولكن أقل من نصف الأصوات))",
 "relative molecular mass": "كتلة جزيئية نسبية, وزن جزيئي ((في الكيمياء) مجموع الكتل الذرية النسبية للذرات المكونة للجزيء)",
 "relative motion": "حركة نسبية (الحركة كما تلاحظ من أو تشير إلى نظام مادي يشكل إطاراً مرجعياً (مثل جدارين متجاورين وأرضية غرفة))",
 "relative price": "سعر نسبي (سعر سلعة مثل بضاعة أو خدمة بدلالة أخرى؛ أي نسبة سعرين)",
 "relative pronoun": "اسم موصول, ضمير وصل (ضمير (مثل 'الذي' أو 'التي') يقدم جملة صلة تشير إلى سابق ما)",
 "relative quantity": "كمية نسبية (كمية نسبية لغرض ما)",
 "relative speed": "سُرْعَة نِسْبِيَّة (الفرق المتجهي بين سرعتي جسمين: سرعة جسم بالنسبة لآخر يُعتبر ساكناً)\nمثال: قد تبدو الحركة مختلفة عند النظر إليها من إطار مرجعي مختلف، لكن يمكن تفسير ذلك بتضمين السرعة النسبية للإطار المرجعي في وصف الحركة",
 "relative velocity": "سُرْعَة نِسْبِيَّة (الفرق المتجهي بين سرعتي جسمين: سرعة جسم بالنسبة لآخر يُعتبر ساكناً)\nمثال: قد تبدو الحركة مختلفة عند النظر إليها من إطار مرجعي مختلف، لكن يمكن تفسير ذلك بتضمين السرعة النسبية للإطار المرجعي في وصف الحركة",
 "relative-in-law": "صهر, نسيب (قريب عن طريق الزواج)",
 "relatively": "نِسْبِيّاً",
 "relativisation": "إضفاء النسبية, تنسيب (فعل أو نتيجة جعل الشيء نسبياً أو اعتباره نسبياً بدلاً من مطلق)\nمثال: يبدو تنسيب مفاهيم الطول وفترات الزمن صعباً للكثيرين",
 "relativism": "نِسْبَوِيَّة",
 "relativistic": "نسبي (متعلق بالنظرية النسبية الخاصة أو العامة أو خاضع لها) / نسبي (متعلق بالمذهب الفلسفي للنسبية)\nمثال: ميكانيكا الكم النسبية",
 "relativistic mass": "كتلة نسبية ((في الفيزياء) كتلة الجسم المتحرك بالنسبة للمراقب: تساوي كتلة السكون مضروبة في عامل أكبر من 1 يزداد بزيادة السرعة)",
 "relativistically": "نسبياً (وفقاً لنظرية النسبية)\nمثال: هذا مستحيل نسبياً (وفق النسبية)",
 "relativity": "نسبية (صفة كون الشيء نسبياً وله دلالة فقط عند ربطه بشيء آخر) / نسبية, نظرية النسبية ((فيزياء) النظرية القائلة بأن المكان والزمان مفاهيم نسبية وليست مطلقة)",
 "relativity theory": "نسبية, نظرية النسبية ((فيزياء) النظرية القائلة بأن المكان والزمان مفاهيم نسبية وليست مطلقة)",
 "relativization": "إضفاء النسبية, تنسيب (فعل أو نتيجة جعل الشيء نسبياً أو اعتباره نسبياً بدلاً من مطلق)\nمثال: يبدو تنسيب مفاهيم الطول وفترات الزمن صعباً للكثيرين",
 "relatum": "مرتبط (حد في القضية يرتبط بمرجع القضية)",
 "relax": "اِسْتَرْخَى",
 "relaxant": "بَاسِط, مُرْخٍ (يميل إلى إرخاء التوتر العضلي أو العصبي وتخفيفه) / مهدئ, مُرخٍ (عقار يرخي ويخفف التوتر)",
 "relaxation": "اِسْتِرْخَاءْ",
 "relaxation behavior": "استرخاء, سلوك الاسترخاء ((في الفيزياء) العودة الأسية للنظام إلى التوازن بعد اضطراب)",
 "relaxation method": "طريقة الاسترخاء (طريقة لحل المعادلات الآنية عن طريق تخمين حل ثم تقليل الأخطاء الناتجة عن طريق التقريبات المتتالية)",
 "relaxation time": "وقت الاسترخاء (ثابت الزمن لعودة النظام الأسية إلى التوازن بعد حدوث اضطراب)",
 "relaxed": "مسترخٍ, هادئ (بدون إجهاد أو قلق)\nمثال: أعطى انطباعاً بأنه مسترخٍ تماماً",
 "relaxedness": "اسْتِرْخَاء (صفة الراحة أو الارتخاء، أو امتلاك مزاج أو طبع هادئ)",
 "relaxer": "مُرْخٍ, مُهَدِّئ (أي عامل يسبب الاسترخاء)\nمثال: الموسيقا مهدئ جيد",
 "relaxin": "ريلاكسين (هرمون يفرزه الجسم الأصفر خلال الأيام الأخيرة من الحمل؛ يرخي أربطة الحوض ويجهز الرحم للمخاض)",
 "relaxing": "باعث على الاسترخاء, مريح (يوفر راحة جسدية أو عقلية)\nمثال: قضت ليلة مريحة في المنزل",
 "relay": "سِبَاق تَتَابُع",
 "relay link": "محطة تقوية, معزز (مضخم لاستعادة قوة الإشارة المرسلة)",
 "relay race": "سِبَاق تَتَابُع",
 "relay station": "محطة تقوية, معزز (مضخم لاستعادة قوة الإشارة المرسلة)",
 "relay transmitter": "محطة تقوية, معزز (مضخم لاستعادة قوة الإشارة المرسلة)",
 "release": "أَطْلَقَ سَرَاح, حَرَّرَ",
 "releasing": "تَطْهِيرِيّ, مُنَفِّس (يُطهِّر النفس من المشاعر المكبوتة (كما في الفنّ))",
 "releasing factor": "عامل مطلق, هرمون مطلق (أي من عدة هرمونات تنتج في الهايبوتلاموس وتحمل إلى الغدة النخامية الأمامية حيث تحفز إطلاق هرمونات الغدة النخامية الأمامية) / عامل مطلق, هرمون مطلق (مادة ينتجها الوطاء قادرة على تسريع إفراز هرمون معين من الغدة النخامية الأمامية)",
 "releasing hormone": "عامل مطلق, هرمون مطلق (أي من عدة هرمونات تنتج في الهايبوتلاموس وتحمل إلى الغدة النخامية الأمامية حيث تحفز إطلاق هرمونات الغدة النخامية الأمامية) / عامل مطلق, هرمون مطلق (مادة ينتجها الوطاء قادرة على تسريع إفراز هرمون معين من الغدة النخامية الأمامية)",
 "relegating": "تفويض, توكيل (تخويل المرؤوسين لاتخاذ قرارات معينة)",
 "relegation": "إبعاد, تنزيل المرتبة (نفي خفيف؛ الإحالة إلى منصب أدنى) / إنزال, نقل لدرجة أدنى (فعل تعيين (شخص أو شيء) في فئة أو صنف معين (أقل عادة)) / تفويض, توكيل (تخويل المرؤوسين لاتخاذ قرارات معينة)\nمثال: تم إبعاده إلى موقع في سيبيريا",
 "relegation zone": "مِنْطَقَة الهُبَوط (المِنْطَقةُ: المَنْطِقَةُ؛ مِنْطَقَةُ: مُقَاطَعَةٌ)\nمثال: غزة منطقة مكشوفة.",
 "relentless": "عَدِيم الشَّفَقَة, قَاسٍ (عديم: فقير؛ عديم: أحمق، غبي)\nمثال: كن عديم الرحمة.",
 "relentlessly": "بلا هوادة (بطريقة لا تكل ولا تمل)\nمثال: عمل بلا هوادة",
 "relentlessness": "صَرَامَة, قَسْوَة لَا تَلِين (قسوة تتميز بعدم الرغبة في التراجع أو التخفيف)\nمثال: صرامة مطاردتهم",
 "relevance": "عَلَاقَة, صِلَة",
 "relevancy": "صِلَة, عَلَاقَة (علاقة شيء ما بالموضوع المطروح)",
 "relevant": "مُتَّصِل, مُتَعَلِّق",
 "relevantly": "بشكل وثيق الصلة, بملاءمة (بما يتصل بالموضوع اتصالاً وثيقاً)",
 "reliability": "اعتمادية, موثوقية (جودة كون الشخص أو الشيء جديراً بالاعتماد أو الثقة)",
 "reliable": "مَوْثُوق",
 "reliableness": "اعتمادية, موثوقية (جودة كون الشخص أو الشيء جديراً بالاعتماد أو الثقة)",
 "reliably": "بِأَمَانَة, بِإِخْلَاص (بطريقة تتسم بالوفاء والموثوقية)\nمثال: كان يعمل دائماً، بإخلاص، مثل المذياع",
 "reliance": "اتكال, اعتماد (يقين مبني على الخبرة السابقة) / اتكال, اعتماد (حالة الاعتماد على شيء ما)\nمثال: كتب الورقة مع اعتماد كبير على عمل علماء آخرين",
 "reliant": "مُتَّكِل, مُعْتَمِد (يَعْتَمِدُ عَلَى آخَرَ فِي الدَّعْم)",
 "relic": "أَثَر (عَلَامَة؛ بَقِيَّة؛ رَسْم مُتَخَلَّف من شيء ما؛ تأثير؛ انطباع) / ذَخِيرَة\nمثال: اختفى فلم ير له أثر.",
 "relict": "أثر متبق, بقايا جيولوجية (ميزة جيولوجية تمثل بقايا تكوين موجود مسبقاً بعد اختفاء أجزاء أخرى) / أثر باق, باقية (كائن أو نوع باقٍ كبقية من نباتات أو حيوانات منقرضة في بيئة تغيرت كثيراً عن تلك التي نشأ فيها)",
 "relief": "رَاحَة, تَخْفِيف / نَقْش نَافِر (لوّن بلونين أو أكثر؛ زيَّن بأشكال أو ألوان)",
 "relief map": "خريطة تضاريس, خريطة كنتورية (خريطة تحتوي على خطوط كنتور تمر عبر نقاط متساوية الارتفاع)",
 "relief pitcher": "رامي الإغاثة, رامٍ بديل (رامٍ لا يبدأ المباراة بل يدخل كبديل)",
 "relief printing": "طباعة بارزة, لتربرس (الطباعة من لوح ذي أحرف بارزة)",
 "relief valve": "صمام أمان, صمام تنفيس (صمام في حاوية يمكن أن يتراكم فيها الضغط (مثل غلاية البخار)؛ يفتح تلقائياً عندما يصل الضغط إلى مستوى خطير)",
 "relieved": "بَارِز, مُمْتَدّ (يمتد للخارج فوق سطح أو حدّ أو ما وراءهما) / مُخَفَّف, مُسَكَّن ((لِلأَلَمِ أَوِ الحُزْن) جُعِلَ أَسْهَلَ تَحَمُّلًا)",
 "reliever": "رامي الإغاثة, رامٍ بديل (رامٍ لا يبدأ المباراة بل يدخل كبديل) / مُخَفِّف, مُهَدِّئ (شخص يقلل من الحدة (مثلاً المخاوف) ويهدئ ويسكن) / احْتِياطِيّ, بَدِيل (شخص يأخذ مكان آخر (كما هو الحال عندما تصبح الأمور خطيرة أو صعبة))\nمثال: مخفف للقلق",
 "relievo": "نحت ناتئ, نقش بارز (نحت يتكون من أشكال منحوتة على سطح بحيث تبرز عن الخلفية المحيطة)",
 "religion": "دِين (العِبَادَة والتَقْدِيْس؛ المَذْهَب)\nمثال: الإسلام دين حق.",
 "religionism": "تزمت ديني, غلو في الدين (تقوى مصطنعة أو مبالغ فيها وحماسة دينية) / تزمت ديني, غلو ديني (تعصب ديني مبالغ فيه)",
 "religionist": "متعصب ديني, مهووس بالدين (شخص مدمن على الدين أو متعصب ديني)",
 "religiosity": "تزمت ديني, غلو في الدين (تقوى مصطنعة أو مبالغ فيها وحماسة دينية)",
 "religious": "دِينِيّ / مُتَدَيِّنٌ, دَيِّنٌ",
 "religious belief": "إيمان, دين (اعتقاد قوي بقوة أو قوى خارقة للطبيعة تتحكم في المصير البشري)\nمثال: فقد إيمانه ولكن ليس أخلاقه",
