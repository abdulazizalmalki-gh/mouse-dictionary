 "radio transmitter": "جهاز إرسال لاسلكي, مرسل راديوي (جهاز إرسال يمثل جزءاً من نظام الراديو يقوم ببث الإشارات)",
 "radio wave": "مَوْجَة رَادْيُو",
 "radio-controlled": "مُتَحَكَّم بِهِ لَاسِلْكِيًّا (يُدار وَيُوَجَّه عَن بُعْد بِواسِطَة اللَّاسِلْكِيّ)",
 "radio-controlled aircraft": "درون, طائرة بدون طيار (طائرة بدون طيار يتم تشغيلها بواسطة التحكم عن بعد)",
 "radio-frequency spectroscopy": "مطيافية الترددات الراديوية (فرع التحليل الطيفي المعني بقياس الفترات الفاصلة بين مستويات الطاقة الذرية أو الجزيئية التي تفصل بينها ترددات تتراوح من 105 إلى 109 هرتز)",
 "radio-frequency spectrum": "طيف راديوي (الطيف الكامل للترددات الكهرومغناطيسية المستخدمة للاتصالات؛ يشمل الترددات المستخدمة للراديو والرادار والتلفزيون)",
 "radio-gramophone": "راديو غرامافون, راديو فونوغراف (معدات إلكترونية تتكون من مزيج من جهاز استقبال راديو ومشغل أسطوانات)",
 "radio-opacity": "عتامة إشعاعية (عتامة للأشعة السينية أو غيرها من الإشعاعات)",
 "radio-opaque": "ظَلِيل لِلأَشِعَّة, مُعْتِم لِلأَشِعَّة (غير شفاف للأشعة السينية أو أشكال الإشعاع الأخرى)\nمثال: كبريتات الباريوم ظليلة للأشعة",
 "radio-phonograph": "راديو غرامافون, راديو فونوغراف (معدات إلكترونية تتكون من مزيج من جهاز استقبال راديو ومشغل أسطوانات)",
 "radioactive": "مُشِعّ (يظهر أو ناتج عن النشاط الإشعاعي)\nمثال: نظير مشع",
 "radioactive dating": "تأريخ إشعاعي (قياس كمية المواد المشعة (عادة الكربون 14) التي يحتوي عليها جسم ما؛ يمكن استخدامها لتقدير عمر الجسم)",
 "radioactive decay": "اضمحلال إشعاعي, تفكك إشعاعي (التفكك التلقائي لمادة مشعة مصحوب بانبعاث إشعاع مؤين)",
 "radioactive dust": "سقط نووي, غبار ذري (الجسيمات المشعة التي تستقر على الأرض بعد انفجار نووي)",
 "radioactive iodine excretion test": "اختبار إفراز اليود المشع (اختبار اليود المشع الذي يقيس كمية اليود المشع المفرزة في البول)",
 "radioactive iodine test": "اختبار اليود المشع (اختبار لوظيفة الغدة الدرقية يعطى فيه المريض جرعة فموية من اليود المشع-131)",
 "radioactive iodine uptake test": "اختبار امتصاص اليود المشع (اختبار اليود المشع الذي يقيس كمية اليود المشع التي تمتصها الغدة الدرقية)",
 "radioactive material": "مادة مشعة (مادة ذات نشاط إشعاعي)",
 "radioactive waste": "نفايات مشعة (مواد مشعة عديمة الفائدة تتبقى بعد اكتمال عملية مخبرية أو تجارية)",
 "radioactively": "إشعاعياً (بطريقة مشعة)\nمثال: موسوم إشعاعياً",
 "radioactivity": "إشعاع, نشاط إشعاعي (الانبعاث التلقائي لتيار من الجسيمات أو الأشعة الكهرومغناطيسية في الاضمحلال النووي)",
 "radioactivity unit": "وحدة نشاط إشعاعي (مقياس للنشاط الإشعاعي)",
 "radiobiologist": "عالم أحياء إشعاعية (عالم أحياء يدرس تأثيرات الإشعاع على الكائنات الحية)",
 "radiobiology": "بيولوجيا إشعاعية (فرع علم الأحياء الذي يدرس تأثيرات الإشعاع على الكائنات الحية)",
 "radiocarbon": "كربون 14, كربون مشع (نظير مشع للكربون)",
 "radiocarbon dating": "تأريخ بالكربون المشع (تَسْجِيْل التَارِيْخ)",
 "radiocarpal joint": "رسغ, مفصل الرسغ (مفصل بين النهاية البعيدة للكعبرة والصف القريب من عظام الرسغ)",
 "radiochemist": "كيميائي إشعاعي, كيميائي نووي (كيميائي متخصص في الكيمياء النووية)",
 "radiochemistry": "كيمياء إشعاعية, كيمياء نووية (كيمياء المواد المشعة)",
 "radiochlorine": "كلور مشع (نظير مشع للكلور)",
 "radiocommunication": "اتصال لاسلكي, راديو (وسيط للاتصال)",
 "radiogram": "صورة شعاعية (صورة فوتوغرافية منتجة على سطح حساس للإشعاع بواسطة إشعاع غير الضوء المرئي (خاصة الأشعة السينية أو أشعة غاما)) / برقية لاسلكية (رسالة تنقل بواسطة التلغراف اللاسلكي)",
 "radiograph": "صورة شعاعية (صورة فوتوغرافية منتجة على سطح حساس للإشعاع بواسطة إشعاع غير الضوء المرئي (خاصة الأشعة السينية أو أشعة غاما))",
 "radiographer": "مصور أشعة (شخص يقوم بعمل صور الأشعة)",
 "radiographic": "تصويري إشعاعي, راديوجرافي (متعلق بالتصوير الشعاعي أو ناتج عنه)",
 "radiography": "تصوير إشعاعي (التصوير الذي يستخدم أنواعًا أخرى من الإشعاع غير الضوء المرئي) / تصوير إشعاعي (عملية صنع صورة شعاعية؛ إنتاج صورة على سطح حساس للإشعاع بواسطة إشعاع غير الضوء المرئي)",
 "radioimmunoassay": "مقايسة مناعية شعاعية (مقايسة مناعية لمادة تم وسمها إشعاعيًا)",
 "radioisotope": "نظير مشع (نظير مشع لعنصر ما؛ ينتج إما طبيعياً أو صناعياً)",
 "radiolarian": "شعاعي (أوالي ذات أجسام تشبه الأميبا وأقدام كاذبة خيطية شعاعية)",
 "radiolocation": "رادار (أداة قياس يستخدم فيها صدى نبضة من إشعاع الميكروويف للكشف عن الأجسام البعيدة وتحديد موقعها)",
 "radiologic technologist": "تقني أشعة (عالم مدرب في التكنولوجيا الإشعاعية)",
 "radiological": "إشعاعي (مكون من أو متعلق بعلم الأشعة)",
 "radiologist": "طَبِيب أَشِعَّة (العالم بالطب)\nمثال: سوف تصبح طبيبة.",
 "radiology": "تنظير إشعاعي, علم الأشعة ((علم الأشعة) فحص الهيكل الداخلي للأشياء المعتمة باستخدام الأشعة السينية أو غيرها من الإشعاعات المخترقة) / علم الأشعة (فرع العلوم الطبية المعني بالاستخدام الطبي للأشعة السينية أو الإشعاعات المخترقة الأخرى)",
 "radiolucent": "شَفِيف لِلأَشِعَّة, مُنْفِذ لِلأَشِعَّة (شفاف تماماً تقريباً للأشعة السينية أو أشكال الإشعاع الأخرى)\nمثال: أنسجة منفذة للأشعة",
 "radiolysis": "تحلل إشعاعي (تفكك جزيئي ناتج عن الإشعاع)",
 "radiometer": "راديومتر, مقياس الإشعاع (مقياس للكشف عن الطاقة الإشعاعية وقياسها (كهرومغناطيسية أو صوتية))",
 "radiomicrometer": "ميكرومتر إشعاعي (مقياس إشعاع حساس للغاية)",
 "radiopacity": "عتامة إشعاعية (عتامة للأشعة السينية أو غيرها من الإشعاعات)",
 "radiopaque": "ظَلِيل لِلأَشِعَّة, مُعْتِم لِلأَشِعَّة (غير شفاف للأشعة السينية أو أشكال الإشعاع الأخرى)\nمثال: كبريتات الباريوم ظليلة للأشعة",
 "radiopaque dye": "صبغة تباين, صبغة ظليلة للأشعة (صبغة لا تسمح بمرور الأشعة السينية أو غيرها من الإشعاعات؛ تستخدم لتحديد أعضاء معينة أثناء فحص الأشعة السينية)",
 "radiopharmaceutical": "دواء مشع, مستحضر صيدلاني مشع (مستحضر صيدلاني يتكون من مركب مشع يستخدم في العلاج الإشعاعي)",
 "radiophone": "هاتف راديوي, هاتف لاسلكي (هاتف يتصل عبر موجات الراديو بدلاً من الكابلات)",
 "radiophonic": "هاتفي لاسلكي (متعلق بـ أو عن طريق الاتصالات الهاتفية اللاسلكية)",
 "radiophoto": "صورة لاسلكية (صورة مرسلة عبر موجات الراديو)",
 "radiophotograph": "صورة لاسلكية (صورة مرسلة عبر موجات الراديو)",
 "radiophotography": "تصوير لاسلكي (إرسال الصور عن طريق موجات الراديو)",
 "radioprotection": "حماية من الإشعاع (الحماية ضد الآثار الضارة للإشعاع)",
 "radioscopy": "تنظير إشعاعي, علم الأشعة ((علم الأشعة) فحص الهيكل الداخلي للأشياء المعتمة باستخدام الأشعة السينية أو غيرها من الإشعاعات المخترقة)",
 "radiosensitive": "حَسَّاس لِلإِشْعَاع (حسّاس للإشعاع)",
 "radiosensitivity": "حساسية إشعاعية, حساسية للضوء (الحساسية لتأثير الطاقة المشعة)",
 "radiosurgery": "جِرَاحَة إِشْعَاعِيَّة",
 "radiotelegraph": "البرق اللاسلكي (استخدام الراديو لإرسال الرسائل البرقية (عادة بشفرة مورس)) / إبراق لاسلكي, راديو تلغراف (الإبراق الذي يستخدم الإرسال عن طريق الراديو بدلاً من الأسلاك)",
 "radiotelegraphic signal": "إشارة برقية, إشارة تلغرافية (إشارة مرسلة عن طريق التلغراف)",
 "radiotelegraphy": "البرق اللاسلكي (استخدام الراديو لإرسال الرسائل البرقية (عادة بشفرة مورس)) / إبراق لاسلكي, راديو تلغراف (الإبراق الذي يستخدم الإرسال عن طريق الراديو بدلاً من الأسلاك)",
 "radiotelephone": "هاتف راديوي, هاتف لاسلكي (هاتف يتصل عبر موجات الراديو بدلاً من الكابلات) / راديو تليفون, هاتف لاسلكي (المهاتفة التي تستخدم الإرسال عن طريق الراديو بدلاً من الأسلاك)",
 "radiotelephonic": "هاتفي لاسلكي (متعلق بـ أو عن طريق الاتصالات الهاتفية اللاسلكية)",
 "radiotelephony": "راديو تليفون, هاتف لاسلكي (المهاتفة التي تستخدم الإرسال عن طريق الراديو بدلاً من الأسلاك)",
 "radiotherapist": "أخصائي أشعة, معالج بالأشعة (أخصائي طبي يستخدم المواد المشعة والأشعة السينية في علاج الأمراض)",
 "radiotherapy": "عِلَاج بِالأَشِعَّة",
 "radiotherapy equipment": "معدات العلاج الإشعاعي (معدات تستخدم لعلاج الأمراض بالأشعة السينية أو النشاط الإشعاعي)",
 "radiothorium": "ثوريوم-228, راديوثوريوم (نظير مشع للثوريوم برقم كتلي 228)",
 "radish": "فُجْل (فَجَّلَ الشيءَ تعني عرَّضَهُ، أي جعله مكشوفًا أو ظاهرًا. يمكن استخدام الفعل للإشارة إلى تعريض شيء ما للآخرين أو جعله واضحًا؛ فجل - يفجل، فجلا، الكلمة مرتبطة بتغيير شكل الشيء ليصبح أوسع أو أكثر استرخاءً وغلظة)",
 "radish plant": "فجل, نبات الفجل (نبات صليبي من جنس الفجل له جذر لاذع صالح للأكل)",
 "radium": "رَادِيُوم",
 "radium therapy": "علاج بالراديوم (استخدام الراديوم في العلاج الإشعاعي)",
 "radius": "كُعْبُرَة / نِصْف قُطْر, شُعَاع",
 "radius of curvature": "نصف قطر الانحناء, نصف قطر التكور (نصف قطر دائرة الانحناء؛ القيمة المطلقة لمقلوب انحناء منحنى عند نقطة معينة)",
 "radius vector": "متجه نصف القطر (خط يربط نقطة في الفضاء بأصل نظام إحداثيات قطبي) / متجه نصف القطر (خط يربط قمرًا صناعيًا بمركز الجسم الذي يدور حوله)",
 "radix": "أَسَاس ((في نظام العد) العدد الصحيح الموجب الذي يعادل واحداً في الخانة التالية الأعلى)\nمثال: 10 هو أساس النظام العشري",
 "radome": "قبة الرادار (مبيت لهوائي الرادار؛ شفاف لموجات الراديو)",
 "radon": "رَادُون",
 "radyera farragei": "كركديه شجيري (شجيرة أسترالية جنوبية وغربية ذات أوراق مسننة غير مفصصة أو مفصصة بشكل ضحل وأزهار أرجوانية؛ تصنف أحياناً ضمن جنس الكركديه)",
 "raetam": "رتامة, رتم",
 "raf": "سلاح الجو الملكي (القوات الجوية لبريطانيا العظمى)",
 "rafah": "رَفَح",
 "raffia": "رَافِيَة",
 "raffia farinifera": "نخيل الرافيا (نخيل ريشي كبير من أفريقيا ومدغشقر له سعف مقسم طويل جداً ينتج أليافاً قوية تجارية مهمة من أعناق أوراقه)",
 "raffia palm": "نخيل الرافيا (نخيل ريشي كبير من أفريقيا ومدغشقر له سعف مقسم طويل جداً ينتج أليافاً قوية تجارية مهمة من أعناق أوراقه)",
 "raffia ruffia": "نخيل الرافيا (نخيل ريشي كبير من أفريقيا ومدغشقر له سعف مقسم طويل جداً ينتج أليافاً قوية تجارية مهمة من أعناق أوراقه)",
 "raffia taedigera": "جوباتي, نخيل جوباتي (نخيل ريشي برازيلي طويل له تاج طرفي من أوراق ريشية جلدية كبيرة جداً ترتفع من سيقان قوية طويلة تستخدم لأغراض هيكلية)",
 "raffia vinifera": "نخيل الخيزران (نخلة من جنس رافيا)",
 "raffinose": "رافينوز (سكر ثلاثي يوجد في بنجر السكر وبذور القطن وبعض الحبوب)",
 "raffish": "لَا مُبَالٍ, مُتَهَتِّك (يَتَّسِمُ بِعَدَمِ المُبَالَاةِ بِالأَعْرَافِ أَوْ بِسُوءِ السُّمْعَة) / أَنِيق, مُتَأَلِّق (يَتَمَيَّز بِمُوَاكَبَة العَصْر فِي المَلْبَس وَالسُّلُوك)",
 "raffishly": "بأناقة متمردة, باستهتار (بطريقة مستهترة أو مائلة)\nمثال: ارتدت قبعتها بميل واستهتار",
 "raffle": "سحب خيري, يانصيب عيني (يانصيب تكون فيه الجوائز سلعاً بدلاً من المال)",
 "rafflesia": "رَافْلِيسِياَ",
 "raft": "طَوْف / رَمَث (رَمَّثَ على كذا: زاد؛ يقال: رَمَّثَ على الخمسين، ورَمَّثَتْ غَنَمُهُ على المئةِ) / قَارِب مَطَّاطِيّ (الزَّورق؛ سفينة صغيرة)\nمثال: كان لسامي قارب صغير",
 "raft foundation": "أساس حصيرة (أساس (عادة على أرض لينة) يتكون من طبقة ممتدة من الخرسانة المسلحة)",
 "rafter": "رافدة سقف (واحدة من عدة عوارض مائلة متوازية تدعم السقف) / راكب الطوافة (شخص يسافر بواسطة طوافة (رمث))",
 "raftered": "ذُو عَوَارِض (له عوارض سقفيَّة خاصَّة عوارض مكشوفة)",
 "raftman": "طواف, قائد طوف (رجل يسافر بواسطة الطوف)",
 "rafts": "أطنان, أكوام (عدد أو كمية كبيرة)\nمثال: كون الكثير من الصداقات الجديدة",
 "raftsman": "طواف, قائد طوف (رجل يسافر بواسطة الطوف)",
 "raftswoman": "طوافة (امرأة تسافر بواسطة الطوف)",
 "rag": "خِرْقَة",
 "rag day": "يوم العمل الخيري (يوم يقيم فيه طلاب الجامعات أنشطة خيرية)",
 "rag doll": "دمية قماشية (دمية من القماش محشوة و(عادة) مرسومة)",
 "rag gourd": "لوف, ليفة (أي من عدة نباتات متسلقة حولية استوائية لها أزهار صفراء كبيرة وثمار صغيرة صالحة للأكل؛ تُزرع تجارياً للحصول على اللب الليفي المجفف للثمار الناضجة الذي…)",
 "rag paper": "ورق خرق (ورق مصنوع جزئياً أو كلياً من الخرق)",
 "rag trade": "صناعة الملابس, قطاع الأزياء (صناع وبائعو الملابس العصرية)",
 "rag week": "أسبوع العمل الخيري (أسبوع في الجامعات البريطانية يتم فيه تنظيم عروض جانبية ومواكب لجمع الأموال للجمعيات الخيرية)",
 "ragamuffin": "طفل رث الثياب (طفل متشرد قذر ورث الثياب)",
 "ragbag": "كيس الخرق (كيس تُحفظ فيه الخرق وبقايا القماش) / أخلاط, أشياء متنوعة (تشكيلة مختلطة من الأشياء)",
 "rage": "حَنَق ((حَنِقَ) عَلَيْهِ حنقا: اشْتَدَّ غيظه فَهُوَ حنق وحنيق) / غَضِبَ, اِنْدَلَعَ",
 "ragee": "دخن الإصبع, راجي (عشب حبوب من شرق الهند تنتج بذوره دقيقاً مراً نوعاً ما، وهو غذاء أساسي في الشرق)",
 "ragged": "مُتَعَرِّج الحَوَافّ (ذو محيط أو خطوط غير منتظمة) / بَالٍ, مُنْهَك (متهالك من الإجهاد أو الضغط) / بَالِي الثِّيَابِ, مُمَزَّق (يَرْتَدِي أَوْ يَتَّصِفُ بِمَلَابِسَ بَالِيَةٍ أَوْ مُمَزَّقَةٍ)",
 "ragged orchid": "سحلب ممزق (سحلب مهدب من شرق الولايات المتحدة له زهرة مخضرة بشفة ممزقة بعمق)",
 "ragged orchis": "سحلب ممزق (سحلب مهدب من شرق الولايات المتحدة له زهرة مخضرة بشفة ممزقة بعمق)",
 "ragged robin": "زهرة الوقواق, ليخنيس زهرة الوقواق (نبات معمر شائع موطنه أوروبا وغرب آسيا ذو زهور وردية عادة ببتلات خشنة)",
 "ragged-fringed orchid": "سحلب ممزق (سحلب مهدب من شرق الولايات المتحدة له زهرة مخضرة بشفة ممزقة بعمق)",
 "raggedly": "بشكل خشن, بشكل غير مستو (بمظهر غير مستو وخشن) / بشكل مبعثر, بشكل متناثر (بطريقة متناثرة وغير منتظمة) / بشكل غير منتظم, بشكل متقطع (بطريقة متقطعة وغير مستوية)\nمثال: لحية طويلة مقصوصة بشكل غير مستو",
 "raggedness": "تَمَزُّق, رَثَاثَة (الرثاثة بحكم ارتداء الأسمال البالية) / خشونة, وعورة (ملمس سطح أو حافة ليس ناعماً بل غير منتظم ومتفاوت)",
 "ragi": "دخن الإصبع, راجي (عشب حبوب من شرق الهند تنتج بذوره دقيقاً مراً نوعاً ما، وهو غذاء أساسي في الشرق)",
 "raging": "عَاتٍ, هَائِج ((عَنِ العَنَاصِر الطَّبِيعِيَّة) كَأَنَّهُ يُظْهِر غَضَبًا عَنِيفًا) / مُسْتَعِر, هَائِج (بَالِغُ الشِّدَّةِ وَالحِدَّة) / حَامٍ, هَائِج (يَتَّسِمُ بِنَشَاطٍ أَوْ حَرَكَةٍ عَنِيفَةٍ وَشَدِيدَة)",
 "raglan": "راجلان (رداء (معطف أو سترة) بأكمام راجلان)",
 "raglan sleeve": "كم راجلان (كم يمتد كقطعة واحدة حتى خط العنق للمعطف أو السترة مع خياطة من الإبط إلى العنق)",
 "ragnarok": "راغناروك, شفق الآلهة (أسطورة حول الدمار النهائي للآلهة في معركة مع قوى الشر)",
 "ragout": "راجو, يخنة متبلة (يخنة متبلة جيداً من اللحم والخضروات)",
 "ragpicker": "جامع القمامة, نبّاش (شخص غير ماهر يجمع الخرق من القمامة العامة كوسيلة للعيش)",
 "ragpicker's disease": "جمرة خبيثة رئوية (شكل من أشكال عدوى الجمرة الخبيثة المكتسبة عن طريق استنشاق الغبار المحتوي على البكتيريا)",
 "rags to riches": "مِنَ الْفَقْرِ إِلَى الثَّرَاءِ, مِنَ الْفَقْرِ الْمُطْلَقِ إِلَى غِنَى الْفَاحِشِ (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "ragsorter": "فارز الخرق (عامل يفرز الخرق والملابس القديمة لاستخدامات جديدة (كما في صناعة الورق))",
 "ragsorter's disease": "جمرة خبيثة رئوية (شكل من أشكال عدوى الجمرة الخبيثة المكتسبة عن طريق استنشاق الغبار المحتوي على البكتيريا)",
 "ragtag": "حثالة, رعاع (مصطلحات تحقيرية لعامة الناس أو الدهماء)",
 "ragtag and bobtail": "حثالة, رعاع (مصطلحات تحقيرية لعامة الناس أو الدهماء)",
 "ragtime": "راغ, راغتايم (موسيقى ذات لحن متقطع الإيقاع (عادة للبيانو))",
 "ragweed": "أمبروزية, دمسيسة (أي من العديد من النباتات الضارة في أمريكا الشمالية التي تشكل جنس الأمبروزية والتي تنتج حبوب لقاح مسببة للحساسية الشديدة المسؤولة عن الكثير من حمى…) / شيخة متكاملة الأوراق, شيخة يعقوبية (عشب ضار أوروبي واسع الانتشار له أزهار صفراء تشبه الأقحوان؛ أحياناً يكون عشباً ضاراً بغيضاً وساماً للماشية إذا استهلك بكميات كبيرة)",
 "ragweed pollen": "لقاح الرجيد (لقاح نبات الرجيد وهو مسبب شائع للحساسية)",
 "ragwort": "لُبَيْنَة",
 "raid": "مُدَاهَمَة / غَارَة, غَزْوَة / أَغَارَ, اِقْتَحَمَ / أَغَارَ",
 "raider": "مستحوذ, مغير (مستثمر مؤسسي ينوي الاستحواذ على شركة عن طريق شراء حصة مسيطرة من أسهمها وتعيين إدارة جديدة) / سالب, ناهب (شخص يأخذ الغنائم أو الأسلاب (كما في الحرب))",
 "raiding": "سَالِب, مُغِير (يتّسم بالنهب والسلب والإغارة)",
 "rail": "تفلق / درابزين, قضيب (قضيب أفقي (عادة من الخشب أو المعدن)) / سكة حديد (اختصار لسكة حديدية) / درابزين, سياج (حاجز يتكون من قضيب أفقي ودعامات)\nمثال: سافر بالقطار",
 "rail fence": "سياج عوارض (سياج (عادة مصنوع من جذوع الأشجار المشقوقة الموضوعة عبر بعضها البعض بزاوية))",
 "rail line": "خط سكة حديد (الطريق المكون من مسار السكة الحديدية وأرضية الطريق)",
 "rail technology": "تكنولوجيا السكك الحديدية (نشاط تصميم وبناء وتشغيل السكك الحديدية)",
 "rail-splitter": "فالف الحطب (عامل يشق جذوع الأشجار لبناء أسوار من السكك الخشبية)",
 "railbird": "مشجع السباق (مشجع للسباقات يشاهدها من السياج الخارجي للمضمار)",
 "railcar": "عربة سكة حديد, عربة قطار (مركبة بعجلات مكيفة لقضبان السكك الحديدية)\nمثال: ثلاث عربات خرجت عن القضبان",
 "railhead": "محطة السكك الحديدية الرئيسية (مستودع سكة حديد في مسرح العمليات حيث يتم تفريغ الإمدادات العسكرية للتوزيع) / رأس السكة (نهاية المسار المكتمل في سكة حديد غير مكتملة)",
 "railing": "درابزين, سياج (حاجز يتكون من قضيب أفقي ودعامات) / سياج, مادة الدرابزين (مادة لصنع القضبان أو الحواجز بشكل جماعي)",
 "raillery": "مُدَاعَبَة, مُمَازَحَة (ردود خفيفة مازحة)",
 "railroad": "خط سكة حديد, سكة حديدية (خط من القضبان يوفر مساراً لعجلات القطار) / خط سكة حديد, سكة حديد (الخط الذي يمثل المنظمة التجارية المسؤولة عن تشغيل نظام نقل للقطارات التي تسحب الركاب أو البضائع)\nمثال: مشى بمحاذاة السكة الحديدية",
 "railroad bed": "ركيزة السكة الحديدية (طبقة أساس توضع عليها سكة الحديد)",
 "railroad car": "عَرَبَة",
 "railroad engineer": "سائق قطار, مهندس قطار (مشغل قاطرة السكك الحديدية)",
 "railroad flat": "شقة متصلة الغرف (شقة تكون غرفها كلها في خط واحد مع أبواب بينها)",
 "railroad line": "خط سكة حديد, سكة حديد (الخط الذي يمثل المنظمة التجارية المسؤولة عن تشغيل نظام نقل للقطارات التي تسحب الركاب أو البضائع)",
 "railroad man": "عامل سكة حديد, موظف قطار (موظف ذكر يعمل في السكك الحديدية)",
 "railroad siding": "تحويلة جانبية, سكة فرعية (امتداد قصير لسكة الحديد يُستخدم لتخزين العربات أو لتمكين القطارات على نفس الخط من المرور)",
 "railroad station": "محطة سكة حديد, محطة قطار (محطة طرفية حيث تقوم القطارات بتحميل أو تفريغ الركاب أو البضائع)",
 "railroad terminal": "محطة سكة حديد, محطة قطار (محطة طرفية حيث تقوم القطارات بتحميل أو تفريغ الركاب أو البضائع)",
 "railroad ticket": "تذكرة قطار (تذكرة صالحة لركوب القطار)",
 "railroad tie": "عَارِضَة",
 "railroad track": "خط سكة حديد, سكة حديدية (خط من القضبان يوفر مساراً لعجلات القطار)\nمثال: مشى بمحاذاة السكة الحديدية",
 "railroad train": "قطار, قطار سكة حديد (نقل عام توفره سلسلة من عربات السكك الحديدية المقترنة ببعضها البعض وتجرها قاطرة)\nمثال: القطارات السريعة لا تتوقف في تقاطع برينستون",
 "railroad tunnel": "نفق السكك الحديدية (نفق تمر عبره سكة الحديد)",
 "railroad vine": "أثمان قدم الماعز, كرمة السكة الحديد (نبات معمر مفترش في الكثبان الرملية الساحلية من فلوريدا إلى تكساس)",
 "railroad woman": "عاملة سكة حديد (موظفة أنثى تعمل في السكك الحديدية)",
 "railroad worm": "دودة التفاح (يرقات تحفر وتتغذى على التفاح)",
 "railroader": "عامل سكة حديد (موظف في السكك الحديدية)",
 "railroading": "تكنولوجيا السكك الحديدية (نشاط تصميم وبناء وتشغيل السكك الحديدية)",
 "rails": "سكة, قضبان السكة الحديدية (قضيب أو زوج من القضبان المتوازية من الفولاذ الملفوف يشكل السكة الحديدية التي يمكن أن تسير عليها عربات القطار أو المركبات الأخرى)",
 "railway": "سِكَّة حَدِيدِيَّة, سِكَّة حَدِيد / سِكَّة حَدِيدِيَّة, سِكَّة الْحَدِيد",
 "railway car": "عربة سكة حديد, عربة قطار (مركبة بعجلات مكيفة لقضبان السكك الحديدية)\nمثال: ثلاث عربات خرجت عن القضبان",
 "railway junction": "تقاطع سكك حديدية (تقاطع تلتقي فيه أو تتقاطع خطوط سكك حديدية أو أكثر)",
 "railway line": "خط سكة حديد (الطريق المكون من مسار السكة الحديدية وأرضية الطريق) / خط سكة حديد, سكة حديد (الخط الذي يمثل المنظمة التجارية المسؤولة عن تشغيل نظام نقل للقطارات التي تسحب الركاب أو البضائع)",
 "railway locomotive": "جرار قطار, قاطرة (مركبة بعجلات تتكون من محرك ذاتي الدفع يستخدم لسحب القطارات على طول خطوط السكك الحديدية)",
 "railway man": "عامل سكة حديد, موظف قطار (موظف ذكر يعمل في السكك الحديدية)",
 "railway station": "مَحَطَّة السِّكَك الْحَدِيدِيَّة, مَحَطَّة",
 "railway system": "خط سكة حديد, سكة حديد (الخط الذي يمثل المنظمة التجارية المسؤولة عن تشغيل نظام نقل للقطارات التي تسحب الركاب أو البضائع)",
 "railway woman": "عاملة سكة حديد (موظفة أنثى تعمل في السكك الحديدية)",
 "railway yard": "ساحة قطارات (منطقة بها شبكة من مسارات السكك الحديدية والتحويلات لتخزين وصيانة العربات والقاطرات)",
 "railwayman": "عامل سكة حديد, موظف قطار (موظف ذكر يعمل في السكك الحديدية)",
 "railwaywoman": "عاملة سكة حديد (موظفة أنثى تعمل في السكك الحديدية)",
 "railyard": "ساحة قطارات (منطقة بها شبكة من مسارات السكك الحديدية والتحويلات لتخزين وصيانة العربات والقاطرات)",
 "raiment": "حلل, زينة (ملابس فاخرة أو مزخرفة بشكل خاص)",
 "raimentless": "بِلَا ثِيَاب (لا يملك أي ملابس)",
 "rain": "مَطَر, مطر (السماء: أنزلت مَطَرًا) / أَمْطَرَ, مَطَرَ / أَمْطَرَ\nمثال: فجأة هطل المطر.",
 "rain barrel": "برميل مياه الأمطار (برميل يستخدم كصهريج لحفظ مياه الأمطار)",
 "rain cats and dogs": "أَمْطَرَ بِغَزَارَة",
 "rain check": "تَذْكِرَة تَعْوِيضِيَّة (كعب تذكرة يخول حامله الدخول إلى حدث مستقبلي إذا تم إلغاء الحدث المجدول بسبب المطر) / تأجيل الدعوة, وعد بتجديد العرض (وعد بأن العرض غير المقبول سيتم تجديده في المستقبل)",
 "rain cloud": "مُزْنَة",
 "rain dance": "رقصة المطر (رقصة طقسية تهدف إلى جلب المطر)",
 "rain date": "موعد بديل (تاريخ بديل محدد لحدث خارجي في حالة هطول الأمطار في الموعد المحدد)\nمثال: الموعد البديل للنزهة في حال المطر سيكون الأحد التالي",
 "rain forest": "غابة مطيرة (غابة ذات هطول مطري سنوي كثيف)",
 "rain gage": "مقياس المطر (مقياس يتكون من أداة لقياس كمية هطول الأمطار)",
 "rain gauge": "مقياس المطر (مقياس يتكون من أداة لقياس كمية هطول الأمطار)",
 "rain shadow": "ظل المطر (منطقة قليلة الهطول لأن حاجزاً (جبلياً) يتسبب في فقدان الرياح لرطوبتها قبل الوصول إليها)",
 "rain shower": "ديمة, زخات مطر (فترة قصيرة من الهطول)\nمثال: توقفت المباراة بسبب زخة مطر قصيرة",
 "rain stick": "عصا المطر (آلة إيقاعية مصنوعة من فرع صبار مجفف مجوف ومملوء بحصى صغيرة ومغطى من كلا الطرفين؛ تصدر صوت المطر المتساقط عند إمالتها؛ أصلها في تشيلي حيث استخدمها…)",
 "rain tree": "سامان, شجرة المطر (شجرة أمريكية استوائية كبيرة للزينة بأوراق ريشية مزدوجة وعناقيد كروية من الزهور بأسدية قرمزية وقرون بذور تأكلها الماشية)",
 "rain-wash": "جرف المطر (جرف التربة أو المواد السائبة الأخرى بواسطة المطر)",
 "rainbow": "قَوْس قُزَح, قوس قزح / قَزَّحَ",
 "rainbow cactus": "صبار قوس قزح (صبار أسطواني قوي من جنوب غرب الولايات المتحدة والمكسيك المجاورة)",
 "rainbow fish": "جوبي (سمكة مياه عذبة صغيرة من أمريكا الجنوبية وجزر الهند الغربية؛ غالباً ما تُحفظ في أحواض السمك)",
 "rainbow lorikeet": "لوريكيت قوس قزح (نوع من اللوريكيت)",
 "rainbow perch": "فرخ البحر قوس قزح (سمكة ساحل المحيط الهادئ)",
 "rainbow pink": "قرنفل صيني, قرنفل قوس قزح (قرنفل صيني بزهور وردية ليلكية مسننة بعمق مع عين أرجوانية؛ يزرع عادة كنبات سنوي)",
 "rainbow runner": "العداء قوس قزح (سمكة جاك انسيابية على شكل سيجار؛ سمكة صيد جيدة)",
 "rainbow seaperch": "فرخ البحر قوس قزح (سمكة ساحل المحيط الهادئ)",
 "rainbow shower": "المطر القزحي, كاسيا جاوية (هجين زينة متساقط الأوراق من جنوب شرق آسيا وهاواي له عناقيد من الزهور تتراوح ألوانها من الكريمي إلى البرتقالي والأحمر)",
 "rainbow smelt": "هف قوس قزح (سمكة غذائية بحرية وحبيسة مهمة في شرق أمريكا الشمالية وألاسكا) / هف أمريكي (الهف الشائع في شرق أمريكا الشمالية وألاسكا)",
 "rainbow trout": "تروتة قوس قزح (توجد في المياه الساحلية للمحيط الهادئ والجداول من كاليفورنيا السفلى إلى ألاسكا) / تراوت قوس قزح (لحم تراوت المحيط الهادئ الذي يهاجر من المياه المالحة إلى العذبة)",
 "raincoat": "مِعْطَف",
 "raindrop": "قَطْرَةُ مَطَر",
 "rainfall": "مطر, هطول مطري (ماء يسقط في قطرات من بخار متكثف في الغلاف الجوي)",
 "rainfly": "باب الخيمة, غطاء الخيمة (لسان مكون من قطعة قماش يمكن سحبها للخلف لتوفير مدخل للخيمة)",
 "rainforest": "غَابَة اِسْتِوَائِيَّة (الغَابَةُ: الأَجَمَةُ ذاتُ الشَّجَرِ المُتَكَاثِف؛ لأَنَّها تُغَيِّبُ مَا فِيهَا. أو الأَجَمَةُ الَّتِي طالتْ، وَلَهَا أَطْراف مُرْتَفِعَةٌ باسِقَة؛ الغابةُ أَجَمة القَصَب، قَالَ: وَقَدْ جُعِلَتْ جماعةَ الشَّجَرِ، لأَنه مأْخوذ مِنَ الغَيابةِ)\nمثال: مشينا في الغابة",
 "raininess": "رداءة الطقس ((للطقس) سوء الأحوال الجوية)\nمثال: لقد أرهقتهم رداءة الطقس",
 "raining": "مَاطِر, مُنْهَمِر (يَتَسَاقَطُ قَطَرَاتٍ أَوْ كَأَنَّهُ يَتَسَاقَطُ كَالمَطَر)",
 "rainless": "بِلَا مَطَر, خَالٍ مِنَ الأَمْطَار (يفتقر إلى المطر)",
 "rainlessness": "انحباس المطر, قحط (حالة عدم هطول الأمطار؛ نقص المطر؛ الجفاف)\nمثال: انحباس المطر في مصر واعتمادها على فيضان النيل كان واحداً من أكثر التناقضات التي تم التعليق عليها في ذلك البلد",
 "rainmaker": "مستمطر (رجل طب من الهنود الحمر يحاول جعل السماء تمطر) / جالب أرباح, صانع صفقات (مسؤول تنفيذي ناجح جداً في جلب الأعمال لشركته أو مؤسسته)",
 "rainmaking": "استمطار (نشاط يهدف إلى إنتاج المطر)",
 "rainproof": "كَتِيم لِلْمَاء, مُقَاوِم لِلْمَاء (لا يسمح بمرور الماء)",
 "rainstorm": "عاصفة مطرية (عاصفة مصحوبة بمطر)",
 "rainwater": "مِيَاه اَلْأَمْطَار",
 "rainy": "مَطِر, مَاطِر (السماء: أنزلت مَطَرًا)\nمثال: فجأة هطل المطر.",
 "rainy day": "اليوم الأسود, وقت الشدة (وقت (مستقبلي) للحاجة المالية)\nمثال: أنا أدخر ليوم الحاجة",
 "rainy season": "موسم الأمطار (أحد الموسمين في المناخات الاستوائية، وهي فترة سنوية يحدث فيها معظم هطول الأمطار في بلد ما)",
 "raisable": "قَابِلٌ لِلرَّفْع (يُمْكِنُ رَفْعُهُ إِلَى أَعْلَى)",
 "raise": "رَفَعَ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ)\nمثال: رفع سامي نظارته.",
 "raise one's voice": "رَفَعَ صَوْتَهُ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ)\nمثال: رفع سامي نظارته.",
 "raiseable": "قَابِلٌ لِلرَّفْع (يُمْكِنُ رَفْعُهُ إِلَى أَعْلَى)",
 "raised": "بَارِز النَّقْش, مُطَرَّز (مزين بنقش بارز ناتج عن الضغط أو التطريز) / بارز, مرفوع (يقع أو نُقل فوق المحيط أو فوق الوضع الطبيعي)\nمثال: تصميم بارز",
 "raised doughnut": "دونات مخمرة (دونات جعلت خفيفة بالخميرة بدلاً من مسحوق الخبز)",
 "raiser": "خبير زراعي, مزارع (شخص يعنى بعلم أو فن أو تجارة زراعة الأرض) / رافع المزايدة (شريك بريدج يزيد من مزايدة شريكه)",
 "raisin": "زَبِيب, زَبِيبَة (ما قدد أو جفف من العِنَب وقد يقال لغيره من النبات المقدد إذا كان صغير الحجم؛ السم في فَمّ الحَيَّة)\nمثال: الزبيب هو عنب مجفف.",
 "raisin bran": "رقائق النخالة بالزبيب (رقائق نخالة مع زبيب)",
 "raisin bread": "خبز الزبيب (خبز يحتوي على الزبيب)",
 "raisin cookie": "بسكويت الزبيب (بسكويت يحتوي على الزبيب)",
 "raisin moth": "عثة الزبيب (عثة تهاجم يرقاتها الفواكه المجففة ومنتجات الحبوب)",
 "raisin-nut cookie": "بسكويت الزبيب والمكسرات (بسكويت محشو بمعجون من الزبيب والمكسرات)",
 "raising": "تربية, تنشئة (مساعدة شخص ما على النمو ليكون عضواً مقبولاً في المجتمع) / مُتَزَايِد, مُرْتَفِع (يزداد في الكمّيّة أو القيمة) / تنشئة, رعاية (الخصائص المكتسبة نتيجة للطريقة التي عوملت بها كطفل) / ارتفاع, رفع (حدث رفع شيء ما إلى الأعلى)\nمثال: ارتفاع في درجة الحرارة بعد الظهر",
 "raising agent": "خميرة, مادة رافعة (مادة تضاف إلى العجين لجعله أخف وأكثر طراوة (مثل الخميرة أو مساحيق الخبز))\nمثال: أعلم أنه يمكنني استخدام مواد رافعة كيميائية، لكنني أعتقد أن استخدام الخميرة كمادة رافعة أكثر صحة",
 "raising hell": "إثارة الشغب, افتعال المشاكل (صنع المشاكل لمجرد التسلية)",
 "raison d'etre": "سَبَب وُجُود, مُبَرِّر وُجُود (الغرض الذي يبرر وجود الشيء) / سبب الوجود (مبرر الوجود)",
 "raison d'être": "سَبَب الْوُجُود ((سَبَّبَه): أَكثر سَبَّه؛ (سَبَّبَ) الأسبَاب: أوجدها)\nمثال: سامي كان السبب.",
 "raita": "رايتا (طبق جانبي هندي من الزبادي والخيار المفروم والتوابل)",
 "raiu": "اختبار امتصاص اليود المشع (اختبار اليود المشع الذي يقيس كمية اليود المشع التي تمتصها الغدة الدرقية)",
 "raj": "الحكم البريطاني, الراج (الحكم البريطاني في الهند (1757-1947))",
 "raja": "راجا (أمير أو ملك في الهند)",
 "raja batis": "ورنك رمادي (ورنك أوروبي شائع يستخدم كطعام)",
 "raja erinacea": "ورنك صغير (أكثر أنواع الورنك وفرة في المياه الساحلية لأمريكا الشمالية في الصيف؛ يصل طوله إلى 21 بوصة)",
 "raja laevis": "ورنك باب الحظيرة (واحد من أكبر أنواع الورنك (يصل إلى 5 أقدام)؛ ورنك نشط يسهل صيده بالصنارة)",
 "raja radiata": "ورنك شائك (سمكة قاع تعيش في المياه الباردة ولها أشواك على الظهر؛ يصل طولها إلى 40 بوصة)",
 "rajab": "رَجَب (هَابَ وعَظَّمَ؛ اسْتَحِيا وخَجَلَ)",
 "rajah": "رَاجَا",
 "rajanya": "راجانيا, كشاتريا (ثاني أعلى الطبقات الأربع: فئة النبلاء أو المحاربين)",
 "rajasthan": "رَاجَاسْتَان",
 "rajasthani": "هندوآرية",
 "rajpoot": "راجبوت (عضو في الطبقة العسكرية الهندوسية المهيمنة في شمال الهند)",
 "rajput": "راجبوت (عضو في الطبقة العسكرية الهندوسية المهيمنة في شمال الهند)",
 "rajshahi district": "ضِلْع رَاجْشَاهِي",
 "rake": "مِدَمَّة, مُشْط / يجمع الحشائش / قذائف مكثفَة / يسرح الشعر\\الحشائش",
 "rake handle": "عصا المشط, مقبض المشط (مقبض المشط (أداة الزراعة))",
 "rake-off": "عمولة المقامرة (نسبة مئوية (من المكاسب أو الغنائم أو الربح) يأخذها مشغل أو رجل عصابات)",
 "rakehell": "فاسق (رجل منحل في المجتمع الراقي)",
 "rakish": "لَا مُبَالٍ, مُتَهَتِّك (يَتَّسِمُ بِعَدَمِ المُبَالَاةِ بِالأَعْرَافِ أَوْ بِسُوءِ السُّمْعَة) / أَنِيق, مُتَأَلِّق (يَتَمَيَّز بِمُوَاكَبَة العَصْر فِي المَلْبَس وَالسُّلُوك)",
 "rakishly": "بأناقة متمردة, باستهتار (بطريقة مستهترة أو مائلة)\nمثال: ارتدت قبعتها بميل واستهتار",
 "rakishness": "أَنَاقَة, هِنْدَام (الأناقة كما تظهر في المظهر الذكي والمرتب) / استهتار, خلاعة (جودة الشخص الفاسق)",
 "rale": "كراكر",
 "rallentando": "رالينتاندو, متباطئاً (يتباطأ تدريجياً (في الموسيقى)) / رَالِّينْتَانْدُو, رِيتَارْدَانْدُو ((في الموسيقى) يتباطأ تدريجيًّا في الإيقاع)\nمثال: يجب عزف هذا المقطع متباطئاً",
 "rally": "تَجَمُّع, مُظَاهَرَة (صيغة مطاوعة من جَمَّعَ، جَمَّعته فتجمّع؛ جُمِّعَ لوحده بدون أن يُجَمِّعه أحد)\nمثال: هي تجمع الحواسيب.",
 "rallying": "استجماع القوى, حشد (مأثرة استجماع القوة لبذل جهد متجدد) / حَاشِد, مُلْهِم (يحثّ على الوحدة وتجديد الجهد) / تَجْمِيع, حَشْد (فعل الحشد لغرض مشترك)\nمثال: ضرب ضربة أحادية ليبدأ صحوة الفريق في الشوط التاسع",
 "rallying cry": "صيحة الحرب, نداء المعركة (صرخة تهدف إلى حشد مجموعة من الجنود في المعركة) / صيحة الحرب, كلمة السر (شعار يستخدم لحشد الدعم لقضية ما)\nمثال: دعوة لحمل السلاح",
 "rallying point": "مَبْدَأ جَامِع, نُقْطَة تَجَمُّع (نقطة أو مبدأ يمكن أن تجتمع عليه المجموعات المتناثرة أو المتعارضة)",
 "ralph": "رَالْف",
 "ram": "كَبْش",
 "ram disk": "قرص رام ((علم الحاسوب) محرك افتراضي يتم إنشاؤه عن طريق تخصيص جزء من ذاكرة الوصول العشوائي لاستخدامه كما لو كان مجموعة من القطاعات)\nمثال: الوصول إلى قرص رام سريع جداً ولكن البيانات التي يحتوي عليها تضيع عند إيقاف تشغيل النظام",
 "ram's horn": "بروبوسيديا, مخالب الشيطان (نبات حولي من جنوب الولايات المتحدة إلى المكسيك له أزهار كبيرة بيضاء أو صفراء مرقطة بالأرجواني ومنقار منحن طويل)",
 "ram's-head": "رأس الكبش (سحلب من شمال أمريكا الشمالية له زهرة خضراء بنية وشفة حمراء وبيضاء توحي برأس كبش)",
 "ram's-head lady's slipper": "رأس الكبش (سحلب من شمال أمريكا الشمالية له زهرة خضراء بنية وشفة حمراء وبيضاء توحي برأس كبش)",
 "ramadan": "رَمَضَان",
 "ramallah": "رَام اللّٰه ((رَامَ) الجُرحُ يَرِيمُ رَيْمًا، ورَيَمَانًا: انْضَمَّ فَمُهُ للبُرْءِ؛ (رَامَ) الحِمْلُ: مالَ)",
 "ramanavami": "رامانافامي (عطلة قمرية هندوسية (في اليوم التاسع من شيترا) للاحتفال بميلاد راما)",
 "ramate": "ذُو فُرُوع, مُتَفَرِّع (لَهُ فُرُوعٌ أَوْ أَغْصَان)",
 "ramble": "تجوال بلا وجهة, تسكع (تجوال بلا هدف في مسار متعرج)",
 "rambler": "مسترسل (شخص كلامه أو كتابته غير منظمة بشكل جيد) / متنزه (شخص يقوم بنزهات طويلة في الريف)",
 "rambling": "مُتَعَرِّج, مُتَلَوٍّ ((عَنِ الطَّرِيق) كَثِير المُنْعَطَفَات وَالِالْتِوَاءَات) / اِسْتِطْرَادِيّ, مُتَشَعِّب ((عَنِ الكَلَام وَالكِتَابَة) يَمِيل إِلَى الخُرُوج عَنِ المَوْضُوع الرَّئِيسِيّ) / مُتَرَامِي الأَطْرَاف, مُتَنَاثِر (يَمْتَدُّ فِي اتِّجَاهَاتٍ مُخْتَلِفَةٍ أَوْ مُوَزَّعٌ بِشَكْلٍ غَيْرِ مُنْتَظِم)",
 "ramblingly": "باستطراد, بتشتت (بطريقة مستطردة)",
 "rambotan": "رامبوتان (فاكهة ماليزية بيضاوية حمراء زاهية حمضية بشكل لطيف مغطاة بأشواك ناعمة) / رامبوتان, شجرة الرامبوتان (شجرة ماليزية تحمل فاكهة حمراء شائكة)",
 "rambouillet": "رامبوييه (خروف قوي طُور من الميرينو وينتج كلاً من اللحم الجيد والصوف الناعم)",
 "rambunctious": "جَامِح, صَاخِب (صاخب ويفتقر لضبط النفس أو الانضباط)",
 "rambutan": "رَامْبُوتَان",
 "rambutan tree": "رامبوتان, شجرة الرامبوتان (شجرة ماليزية تحمل فاكهة حمراء شائكة)",
 "ramee": "رامي, عشبة الصين (عشبة معمرة طويلة من آسيا الاستوائية ذات أوراق خضراء داكنة؛ تزرع للألياف من سيقانها الخشبية التي تشبه الكتان)",
 "ramekin": "رامكين, صحن فخار صغير (طبق صغير مقاوم للنار يستخدم للخبز وتقديم الحصص الفردية) / رامكين (طبق جبن مصنوع من البيض وفتات الخبز يخبز ويقدم في أطباق فردية مقاومة للنار)",
 "ramen": "رَامِن, رَامَن",
 "ramequin": "رامكين, صحن فخار صغير (طبق صغير مقاوم للنار يستخدم للخبز وتقديم الحصص الفردية) / رامكين (طبق جبن مصنوع من البيض وفتات الخبز يخبز ويقدم في أطباق فردية مقاومة للنار)",
 "ramesses": "رَمْسِيس",
 "ramie": "قُنَّبُ سِيَام",
 "ramification": "تشعب, تفرع (عملية التفرع أو الانقسام إلى فروع) / تَشَعُّب, تَفَرُّع (ترتيب الأجزاء المتفرعة) / تشعب, تعقيد (تطور يعقد الموقف) / شعبة, فرع (جزء من شكل متشعب)\nمثال: كان لقرار المحكمة تداعيات عديدة غير متوقعة",
 "ramipril": "ألتاس, راميبريل (مثبط للإنزيم المحول للأنجيوتنسين (الاسم التجاري ألتاس) يستخدم لعلاج ارتفاع ضغط الدم أو لدى بعض المرضى الذين أصيبوا بنوبة قلبية)",
 "ramjet": "رام جيت, محرك نفاث تضاغطي (نوع بسيط من المحركات النفاثة؛ يجب إطلاقه بسرعة عالية)",
 "ramjet engine": "رام جيت, محرك نفاث تضاغطي (نوع بسيط من المحركات النفاثة؛ يجب إطلاقه بسرعة عالية)",
 "ramla": "اَلرَّمْلَة",
 "rammer": "مِدَكّ (أداة لدفع شيء بقوة)",
 "ramona": "قصعين طبي, ميرمية شائعة (نبات شجيري ذو أوراق رمادية خضراء عطرية تستخدم كعشب طبخ)",
 "ramontchi": "برقوق الحاكم, برقوق مدغشقر (شجرة شجيرية صغيرة من مدغشقر تزرع في المناطق الاستوائية كنبات سياج ولثمارها الحمراء الداكنة الحمضية التي تشبه البرقوق الصغير)",
 "ramose": "ذُو فُرُوع, مُتَفَرِّع (لَهُ فُرُوعٌ أَوْ أَغْصَان)",
 "ramous": "ذُو فُرُوع, مُتَفَرِّع (لَهُ فُرُوعٌ أَوْ أَغْصَان)",
 "ramp": "منحدر (سطح مائل يربط بين مستويين) / سلم الطائرة, منحدر (درج متحرك يستخدمه الركاب للصعود إلى الطائرة أو النزول منها) / رامب, كراث بري (نبات معمر من أمريكا الشمالية له بصلة رفيعة وزهور بيضاء)",
 "rampage": "عربدة, هيجان (سلوك عنيف غاضب ومدمر)",
 "rampageous": "مُسْتَشِيط, هَائِج (يُظْهِرُ عُنْفًا هَائِجًا؛ غَالِبًا مُدَمِّر)",
 "rampant": "جَامِح, هَائِج",
 "rampant arch": "قوس منحدر (قوس دعامته أعلى في جانب واحد من الآخر)",
 "rampantly": "بجموح, بشكل متفش (بطريقة جامحة وغير منضبطة)\nمثال: نمت الأعشاب الضارة بجموح حول هنا",
 "rampart": "مِتْرَاس",
 "rampion": "جريس اللفت, جريس رابونكولوس (زهرة الجرس من أوروبا وآسيا وشمال أفريقيا ذات أزهار مزرقة وجذر درني صالح للأكل يستخدم مع الأوراق في السلطة)",
 "rampion bellflower": "جريس اللفت, جريس رابونكولوس (زهرة الجرس من أوروبا وآسيا وشمال أفريقيا ذات أزهار مزرقة وجذر درني صالح للأكل يستخدم مع الأوراق في السلطة)",
 "ramrod": "مِدَكّ",
 "ramsay hunt syndrome": "متلازمة رامزي هنت (متلازمة ناتجة عن العدوى بفيروس الهربس النطاقي الحماقي؛ تتميز بالدوار وآلام في الأذنين وشلل العصب الوجهي وأحياناً فقدان السمع)",
 "ramshackle": "مُتَدَاعٍ, مُتَهَالِك (في حالة يُرثَى لها من التهالك)",
 "ramsons": "ثوم الدببة, ثوم بري (نبات عشبي نفاذ من العالم القديم)",
 "ramus": "رأد, فرع الفك (الجزء الخلفي من الفك السفلي الذي يكون عمودياً إلى حد ما)",
 "rana cascadae": "ضفدع الشلالات (ضفدع جبلي يوجد بالقرب من الماء؛ من شمال غرب الولايات المتحدة إلى كاليفورنيا)",
 "rana catesbeiana": "ضفدع الثور (أكبر ضفدع في أمريكا الشمالية؛ مائي للغاية وله صوت عميق النبرة)",
 "rana clamitans": "ضفدع أخضر (يشبه ضفدع الثور؛ يوجد في المستنقعات والبرك أو بالقرب منها؛ في الولايات المتحدة وكندا)",
 "rana goliath": "ضفدع جالوت (أكبر ضفدع حي؛ يصل طوله إلى قدم ووزنه إلى 10 أرطال؛ أفريقيا)",
 "rana palustris": "ضفدع البيكريل (ضفدع مروج من شرق أمريكا الشمالية)",
 "rana pipiens": "ضفدع النمر (ضفدع أخضر أو بني شائع في أمريكا الشمالية له بقع بيضاوية داكنة ذات حواف بيضاء)",
 "rana sylvatica": "ضفدع الخشب (ضفدع بني فاتح واسع الانتشار في غابات أمريكا الشمالية الرطبة وخاصة التنوب)",
 "rana tarahumarae": "ضفدع تاراهومارا (ضفدع مكسيكي يوجد على مسافة قفزة أو اثنتين من الماء)",
 "rana temporaria": "ضفدع العشب (ضفدع أوروبي شبه أرضي شائع)",
 "ranch": "مزرعة مواشي (مزرعة تتكون من مساحة كبيرة من الأرض مع المرافق اللازمة لتربية الماشية (وخاصة الأبقار))",
 "ranch hand": "عامل مزرعة مواشي (عامل مستأجر في مزرعة مواشي)",
 "ranch house": "منزل المزرعة (منزل من طابق واحد بسقف منخفض الانحدار)",
 "rancher": "صاحب مزرعة مواشي, مربي الماشية (شخص يملك أو يدير مزرعة كبيرة لتربية المواشي)",
 "ranching": "إدارة المراعي, تربية المواشي (الزراعة لتربية الماشية (خاصة الأبقار))",
 "rancid": "زَنِخ ((زَنِخَ) الدُّهْن زَنَخًا: تغيَّرتْ رائحتُه؛ فهو زَنِخٌ)",
 "rancidity": "زناخة (حالة كونه زنخاً؛ وجود رائحة أو نكهة زنخة (كما في زيت الطهي القديم))",
 "rancidness": "تزنخ (خاصية كون الشيء متزنخاً)",
 "rancor": "حِقْد (حقد:أَمْسَكَ عَداوتَهُ فِي قَلْبهِ وتَرَبَّصَ لفُرْصَتِها؛ حقد على فلان:أَضْمَرَ له العداوة وتربّص فرصة الإيقاع به ، كَرِهَه وبَغِضَه)\nمثال: احس سامي بالحقد.",
 "rancorous": "حَاقِد, ضَغِين (يُظهر حقدًا عميقًا متأصّلًا واستياءً راسخًا)",
 "rancour": "استياء, حقد (شعور بالغضب العميق والمرارة وسوء النية)",
 "rand": "رَانْد",
 "random": "عَشْوَائِيّ",
 "random access memory": "ذاكرة الوصول العشوائي, رام (ذاكرة الحاسوب الأكثر شيوعاً والتي يمكن استخدامها بواسطة البرامج لأداء المهام الضرورية أثناء تشغيل الحاسوب؛ تسمح شريحة ذاكرة الدائرة المتكاملة بتخزين…)",
 "random memory": "ذاكرة الوصول العشوائي, رام (ذاكرة الحاسوب الأكثر شيوعاً والتي يمكن استخدامها بواسطة البرامج لأداء المهام الضرورية أثناء تشغيل الحاسوب؛ تسمح شريحة ذاكرة الدائرة المتكاملة بتخزين…)",
 "random number generator": "مولد أرقام عشوائية (روتين مصمم لإنتاج رقم عشوائي)",
 "random sample": "عينة عشوائية (عينة مأخوذة بشكل عشوائي) / عينة عشوائية (عينة يكون فيها لكل عنصر في المجتمع فرصة متساوية للاختيار)",
 "random sampling": "أخذ عينات عشوائي (اختيار عينة عشوائية؛ حيث يكون لكل عنصر من عناصر المجتمع فرصة متساوية في الاختيار)",
 "random variable": "مُتَغَيِّر عَشْوَائِيّ",
 "random walk": "سير عشوائي (عملية عشوائية تتكون من سلسلة من التغييرات التي يتم تحديد خصائص كل منها (مثل الحجم أو الاتجاه) عن طريق الصدفة)",
 "random-access memory": "ذاكرة الوصول العشوائي, رام (ذاكرة الحاسوب الأكثر شيوعاً والتي يمكن استخدامها بواسطة البرامج لأداء المهام الضرورية أثناء تشغيل الحاسوب؛ تسمح شريحة ذاكرة الدائرة المتكاملة بتخزين…)",
 "randomisation": "تعشية, عشوائية (ترتيب عشوائي متعمد للملاحظات لمحاكاة الصدفة)",
 "randomised": "عَشْوَائِيّ (مُنَظَّم أو مُوَزَّع بطريقة عشوائية مُتَعَمَّدة)",
 "randomization": "تعشية, عشوائية (ترتيب عشوائي متعمد للملاحظات لمحاكاة الصدفة)",
 "randomized": "مُعَشَّىً",
 "randomly": "عَشْوَائِيًّا",
 "randomness": "اعْتِبَاطِيَّة, عَشْوَائِيَّة (صفة الافتقار إلى أي نظام أو خطة يمكن التنبؤ بها) / إنتروبيا, اعتلاج (كمية ديناميكية حرارية تمثل مقدار الطاقة في النظام التي لم تعد متاحة للقيام بعمل ميكانيكي)\nمثال: تزداد الإنتروبيا مع تحلل المادة والطاقة في الكون إلى حالة نهائية من التماثل الخامل",
 "randy": "شَبِق, مُثَار جِنْسِيًّا (يشعر برغبة جنسية شديدة)",
 "ranee": "راني ((مؤنث راجا) أميرة هندوسية أو زوجة راجا)",
 "range": "مدى, قدرة / مَدَى",
 "range animal": "حيوان مرعى (أي حيوان يعيش ويرعى في الأراضي العشبية المفتوحة (خاصة الخيول والماشية والأغنام))",
 "range finder": "محدد المدى (أداة قياس (صوتية أو بصرية أو إلكترونية) للعثور على مسافة جسم ما)",
 "range hood": "شفاط المطبخ (غطاء عادم فوق موقد المطبخ)",
 "range of a function": "صورة, مدى (مجموعة قيم المتغير التابع التي يتم تعريف الدالة لها)",
 "range of mountains": "سلسلة جبال, سلسلة جبلية (سلسلة من التلال أو الجبال)\nمثال: كان الوادي يقع بين سلسلتين من التلال",
 "range pole": "شاخص, عمود المسح (أداة مسح تتكون من قضيب مستقيم مطلي بشرائط حمراء وبيضاء متبادلة عرض كل منها قدم واحد؛ تستخدم للرصد من قبل المساحين)",
 "rangefinder": "محدد المدى (أداة قياس (صوتية أو بصرية أو إلكترونية) للعثور على مسافة جسم ما)",
 "rangeland": "أرض رعي, مراعي (أرض مناسبة لرعي الماشية)",
 "ranger": "جندي صاعقة, فدائي (عضو في وحدة عسكرية مدربة كقوات اقتحام لشن غارات خاطفة) / حارس الغابات, مكافح حرائق الغابات (مسؤول عن إدارة وحماية منطقة من الغابات) / جَوَّال تِكْساس, حارِس تِكْساس (عضو في دورية الطرق السريعة بولاية تكساس؛ (تاريخياً) رجل قانون يركب الخيل لحفظ النظام على الحدود)",
 "rangifer arcticus": "كاريبو الأراضي القاحلة",
 "rangifer caribou": "كاريبو الغابات",
 "rangifer tarandus": "رنة, كاريبو (أيل قطبي ذو قرون كبيرة في كلا الجنسين؛ يسمى 'رنة' في أوراسيا و 'كاريبو' في أمريكا الشمالية)",
 "ranginess": "طول فارع (حالة كونه نحيلاً وطويل الأطراف)\nمثال: كان بيلي طويلاً، لكن طوله الفارع كان يشير إلى وزن يمكن التعامل معه بسهولة",
 "ranging": "جائل, طائف (يتجول بحرية)\nمثال: في الليل في السرير؛ واجهتها أفكاره الجائلة ببطء",
 "ranging pole": "شاخص, عمود المسح (أداة مسح تتكون من قضيب مستقيم مطلي بشرائط حمراء وبيضاء متبادلة عرض كل منها قدم واحد؛ تستخدم للرصد من قبل المساحين)",
 "rangpur": "رانجبور (هجين بين اليوسفي والليمون له فاكهة حامضة جداً بقشرة برتقالية)",
 "rangpur lime": "رانجبور (هجين بين اليوسفي والليمون له فاكهة حامضة جداً بقشرة برتقالية)",
 "rangy": "فَسِيح, مُتَّسِع (يتيح مساحة واسعة للتجوّل) / جَوَّال, طَلِيق (مُتَكَيِّفٌ لِلتَّجَوُّلِ وَالتَّرَحُّل) / فَارِع, نَحِيل طَوِيل (طويل ونحيف ذو أطراف طويلة رفيعة)",
 "rani": "راني ((مؤنث راجا) أميرة هندوسية أو زوجة راجا)",
 "ranid": "ضفدع حقيقي (برمائي آكل للحشرات عادة ما يكون شبه مائي وتري القدمين بجلد رطب أملس وأرجل خلفية طويلة)",
 "ranitidine": "رانيتيدين, زانتاك (حاصر للهيستامين ومضاد للحموضة (الاسم التجاري زانتاك) يستخدم لعلاج القرحة الهضمية والتهاب المعدة والارتجاع المريئي)",
 "rank": "رُتْبَة (رُتْبَة، بضم الراء؛ رَتْبَة، بفتح الراء)",
 "rank and file": "الأفراد, الجنود العاديون (الأعضاء العاديون في منظمة (مثل الجنود المجندين في الجيش)) / القواعد, عامة الأعضاء (الناس الذين يشكلون الجسم الرئيسي لأي مجموعة)\nمثال: تم دعم الإضراب من قبل أفراد النقابة",
 "rank order": "ترتيب الرتب (ترتيب وفقاً للرتبة)",
 "rank-difference correlation": "ارتباط الرتب, معامل ارتباط الرتب (الطريقة الأكثر استخداماً لحساب معامل الارتباط بين رتب الدرجات لمتغيرين)",
 "rank-difference correlation coefficient": "ارتباط الرتب, معامل ارتباط الرتب (الطريقة الأكثر استخداماً لحساب معامل الارتباط بين رتب الدرجات لمتغيرين)",
 "rank-order correlation": "ارتباط الرتب, معامل ارتباط الرتب (الطريقة الأكثر استخداماً لحساب معامل الارتباط بين رتب الدرجات لمتغيرين)",
 "rank-order correlation coefficient": "ارتباط الرتب, معامل ارتباط الرتب (الطريقة الأكثر استخداماً لحساب معامل الارتباط بين رتب الدرجات لمتغيرين)",
 "rank-smelling": "زَنِخ الرَّائِحَةِ (ذُو رَائِحَة كَرِيهَة زَنِخَة)",
 "ranked": "مُدَرَّج, مُرَتَّب (منظَّم في تسلسل من الدرجات أو الرُّتَب)",
 "ranker": "جندي صف (جندي مجند يخدم في صفوف القوات المسلحة) / ضابط مترقٍ (ضابط مفوض تم ترقيته من حالة التجنيد)",
 "rankine": "رانكين (وحدة درجة حرارة على مقياس رانكين)",
 "rankine scale": "مقياس رانكين (مقياس لدرجة الحرارة المطلقة بدرجات الفهرنهايت)",
 "ranking": "ترتيب, تصنيف (الموقع على مقياس بالنسبة للآخرين في المكانة أو الرتبة أو الإنجاز)",
 "rankness": "رائحة كريهة, نتانة (سمة امتلاك رائحة كريهة قوية) / خُصُوبَة, غَزَارَة (خاصية الإنتاج بغزارة والحفاظ على نمو قوي وفاخر)\nمثال: أشاد بخصوبة التربة",
 "ransacked": "مَسْلُوب, مَنْهُوب (فُرِّغَ ظُلْمًا مِنْ كُلّ مَا لَهُ قِيمَة)",
 "ransacking": "تفتيش دقيق, نبش (بحث شامل عن شيء ما (غالباً ما يسبب الفوضى أو الارتباك))\nمثال: قام بنبش العلية جيداً لكنه لم يجد زلاجاته",
 "ransom": "فِدْيَة / اِفْتَدَى, فَدَى",
 "ransom money": "فدية (أموال تُطلب لإعادة شخص أسير)",
 "ransomed": "مُفْتَدًى (تمّ استرداده بدفع فدية) / مُخَلَّص, مُفْتَدًى (مُنقَذ من عبودية الخطيئة)",
 "ransomware": "برمجيات الفدية (برمجيات خبيثة تجعل الحاسوب غير قابل للاستخدام ما لم يتم دفع مبلغ مادي للمهاجم)",
 "rant": "كلام طنان, هراء (كلام أو كتابة متفاخرة أو مدعية) / خطبة عصماء, صياح (خطبة رنانة عالية الصوت تعبر عن مشاعر قوية)",
 "ranter": "صخّاب, هائج (شخص يهذي ويصيح؛ يتحدث بطريقة عنيفة أو صاخبة)",
 "ranting": "خطبة عصماء, صياح (خطبة رنانة عالية الصوت تعبر عن مشاعر قوية)",
 "ranula": "ضفدع, كيسة تحت اللسان (كيس على الجانب السفلي من اللسان)",
 "ranunculus acris": "حوذان المروج, حوذان طويل (حوذان أوروبي معمر ذو أزهار ربيعية صفراء، متوطن بشكل واسع خاصة في شرق أمريكا الشمالية)",
 "ranunculus aquatilis": "حوذان مائي (نبات البرك والجداول بطيئة الجريان له أوراق مغمورة وطافية وأزهار بيضاء؛ أوروبا وأمريكا الشمالية)",
 "ranunculus bulbosus": "حوذان بصيلي, حوذان شائع (حوذان معمر من العالم القديم ذو أزهار ذهبية إلى صفراء كبريتية في أواخر الربيع إلى أوائل الصيف؛ متوطن في أمريكا الشمالية)",
 "ranunculus ficaria": "بقلة الخطاطيف الصغرى, حوذان التين (عشب معمر موطنه أوروبا ولكن تم توطينه في أماكن أخرى له أوراق على شكل قلب وزهور صفراء تشبه الحوذان؛ استخدمت جذوره الدرنية كلبخة لتخفيف البواسير)",
 "ranunculus flammula": "حوذان لهيبي, سنانية صغرى (حوذان أوراسي معمر شبه مائي ذو أوراق تشبه الرماح؛ متوطن في نيوزيلندا)",
 "ranunculus glaberrimus": "حوذان أملس, حوذان الميرمية (حوذان صغير مبكر الإزهار ذو أزهار صفراء لامعة في غرب أمريكا الشمالية)",
 "ranunculus lingua": "حوذان لسانية, سنانية كبرى (حوذان أوروبي شبه مائي ذو أوراق تشبه الرماح)",
 "ranunculus lyalii": "زنبق الجبل, زنبق جبل كوك (نبات معمر مبهرج ذو أزهار بيضاء من نيوزيلندا)",
 "ranunculus occidentalis": "حوذان غربي (نبات معمر من غرب أمريكا الشمالية)",
 "ranunculus repens": "حوذان زاحف (عشب أوروبي معمر ذو سيقان زاحفة طويلة)",
 "ranunculus sceleratus": "حوذان سام, حوذان كرفسي الأوراق (عشب حولي ينمو في الأماكن السبخة)",
 "ranvier's nodes": "عقد رانفييه (فجوات صغيرة في غمد المايلين للمحاور العصبية النخاعية)",
 "raoulia australis": "خروف نباتي, راوليا (عشب معمر منبسط يشكل حصيرة بأوراق صوفية شائبة)",
 "raoulia lutescens": "خروف نباتي, راوليا (عشب معمر منبسط يشكل حصيرة بأوراق صوفية شائبة)",
 "rap": "خبطة, طرحة (فعل الضرب بقوة) / لَوْم, مَسْؤُولِيَّة الْخَطَأ (عتاب أو تحميل مسؤولية عن زلة أو سوء تصرف) / راب, موسيقى الراب (نوع من موسيقى الأمريكيين الأفارقة في الثمانينيات والتسعينيات يتم فيه ترديد كلمات مقفاة على مرافقة موسيقية) / ثرثرة مسترسلة (محادثة طلقة ومسترسلة)\nمثال: ضرب الطاولة خبطة قوية",
 "rap group": "جلسة نقاش (تجمع لأشخاص يعقدون جلسة نقاش وحوار)",
 "rap music": "مُوسِيقَى اَلرَّاب, اَلرَّاب (مُوسِيقى، فنُّ تأليف الألحان وتوزيعها وإيقاعها والغناء والتطريب بضروب المعازف؛ علم الموسيقى : علمٌ يُبحَثُ فيه عن أُصَول النغم من حيث تأَتلف أَو تتنافر، وأَحوال الأَزمنة المتخللة بينها، ليُعلَمَ كيف يؤلَّف اللَّحْن)\nمثال: أتعلم الموسيقى.",
 "rap session": "جلسة مصارحة (محادثة في موقف يمكن فيه التعبير عن المشاعر وانتقادها أو دعمها)",
 "rap sheet": "دفتر الأحوال, سجل الشرطة (السجل اليومي المكتوب للأحداث (كالاعتقالات) في مركز الشرطة)",
 "rapacious": "جَشِع, شَرِه (يلتهم الطعام أو يشتهيه بكمّيّات كبيرة) / شَرِه, نَهَّاب (جشع وطمّاع بشكل مُفرِط) / كَاسِر, مُفْتَرِس (يعيش على افتراس حيوانات أخرى وخاصة بصيد الفرائس الحية)",
 "rapaciously": "بجشع, بنهب (بطريقة جشعة)",
 "rapaciousness": "جشع, طمع (رغبة مفرطة في الثروة (عادة بكميات كبيرة)) / نهم شديد (شراهة مفرطة) / الافتراس, الجشع ((للحيوان، عادة الطيور) صفة العيش على فريسة حية)\nمثال: جشع المحامين",
 "rapacity": "بخل, جشع (رغبة مذمومة في التملك؛ رغبة لا تشبع في الثروة (تُشخص كإحدى الخطايا السبع المميتة)) / نهم شديد (شراهة مفرطة) / الافتراس, الجشع ((للحيوان، عادة الطيور) صفة العيش على فريسة حية)",
 "rape": "اِغْتِصَاب (أَخْذُ الشيء قَهْراً وَظُلْماً؛ اِسْتِخْدَامُ العُنْفِ مَعَ النساء لِنَيْلِ الحَاجَةِ مِنْهَن بِالرَّغْمِ عَنْهَن) / اِغْتَصَبَ, غَصَبَ (غَصَبَ؛ زَنَى (بِفُلَانَةٍ) قَهْرًا/غَصْبًا)\nمثال: تعرض زيري للاغتصاب.",
 "rape conviction": "إدانة بالاغتصاب (إدانة بجريمة الاغتصاب)",
 "rape oil": "زيت السلجم, زيت الكولزا (زيت صالح للأكل أصفر فاتح إلى بني من بذور اللفت يُستخدم أيضاً كمواد تشحيم أو للإضاءة)",
 "rape suspect": "مُشْتَبَه بِه فِي اغْتِصَاب (شخص يشتبه في ارتكابه جريمة اغتصاب)",
 "raped": "مَنْهُوب, مُخَرَّب (تَعَرَّضَ لِلنَّهْبِ وَالتَّدْمِيرِ بِالقُوَّةِ وَالعُنْف)",
 "rapee": "مُغْتَصَب, مُغْتَصَبَة",
 "raper": "مغتصب (شخص يجبر آخر على ممارسة الجنس)",
 "rapeseed": "بذور السلجم (بذرة نباتات السلجم؛ مصدر لزيت صالح للأكل)",
 "rapeseed oil": "زيت السلجم, زيت الكولزا (زيت صالح للأكل أصفر فاتح إلى بني من بذور اللفت يُستخدم أيضاً كمواد تشحيم أو للإضاءة)",
 "raphael": "رُفَائِيل",
 "raphanus raphanistrum": "فجل بري, لفت بري (عشب ضار أوراسي له أزهار صفراء أو بنفسجية أو بيضاء وثمار تشبه القرون)",
 "raphanus sativus": "فجل (نبات أوراسي يزرع على نطاق واسع لجذره الحريف الصالح للأكل الذي يؤكل عادة نيئاً)",
 "raphanus sativus longipinnatus": "دايكون, فجل ياباني (فجل من اليابان له جذر طويل صلب دائم يؤكل نيئاً أو مطبوخاً)",
 "raphe": "درز, رفاء (حافة تشكل درزاً أو خط وصل بين جزأين)",
