 "rightism": "يمينية (أيديولوجية اليمين السياسي؛ الإيمان بمبادئ اليمين السياسي أو دعمها)",
 "rightist": "يَمِينِيّ (يؤمن بمبادئ اليمين السياسي أو يدعمها) / يميني (عضو في حزب سياسي يميني)",
 "rightly": "بشكل محق, عن حق (بصدق؛ كما هو مبرر)\nمثال: اعتبر عن حق أعظم مغني في عصره",
 "rightmost": "أَقْصَى اليَمِين (الأبعد نحو اليمين)",
 "rightness": "إحكام, دقة (المطابقة لمعيار جمالي أو معياري للصحة) / صحة, صواب (المطابقة للواقع أو الحقيقة) / صحة, صواب (التوافق مع الضمير أو الأخلاق) / صوابية, ملاءمة (السلوك المناسب؛ فعل الشيء الصحيح)\nمثال: تم أداؤها بدقة وجمال",
 "rights issue": "طَرْح حُقُوق أَوْلَوِيَّة, طَرْح حُقُوق اكْتِتَاب (طرح أسهم عادية للمساهمين الحاليين الذين يحملون حقوق اكتتاب تخولهم شراء أسهم جديدة بخصم من السعر الذي ستطرح به للجمهور لاحقاً)\nمثال: عادةً ما يوافق المصرفي الاستثماري الذي يدير طرح الحقوق على شراء أي أسهم لم يشتريها المساهمون",
 "rights offering": "طَرْح حُقُوق أَوْلَوِيَّة, طَرْح حُقُوق اكْتِتَاب (طرح أسهم عادية للمساهمين الحاليين الذين يحملون حقوق اكتتاب تخولهم شراء أسهم جديدة بخصم من السعر الذي ستطرح به للجمهور لاحقاً)\nمثال: عادةً ما يوافق المصرفي الاستثماري الذي يدير طرح الحقوق على شراء أي أسهم لم يشتريها المساهمون",
 "rigid": "جَامِد, مُتَصَلِّب (غَيْرُ قَابِلٍ لِلِانْثِنَاءِ أَوْ مُقَاوِمٌ لَهُ) / صلب الهيكل (يصف منطاداً أو سفينة هوائية تحافظ على شكلها بواسطة إطار أو هيكل صلب غير مرن) / جَامِد, صَارِم (غَيْرُ قَادِرٍ عَلَى التَّكَيُّفِ أَوِ التَّغَيُّرِ لِمُوَاجَهَةِ الظُّرُوفِ) / ثَابِت, جَامِد (مثبّت في مكانه ولا يتحرك)",
 "rigidification": "تصلب, تصلد (عملية التحول إلى صلب أو قاسي)",
 "rigidifying": "تصلب, تصلد (عملية التحول إلى صلب أو قاسي)",
 "rigidity": "جُمُود, صَلَابَة (صفة كون الشخص جامداً وشديد الصرامة) / جسوءة, صلابة (الخاصية الفيزيائية لكون الشيء صلباً ومقاوماً للثني)",
 "rigidly": "بتيبس, بصلابة (بطريقة صلبة)\nمثال: كان الجسم منتصباً بصلابة",
 "rigidness": "جُمُود, صَلَابَة (صفة كون الشخص جامداً وشديد الصرامة) / جسوءة, صلابة (الخاصية الفيزيائية لكون الشيء صلباً ومقاوماً للثني)",
 "rigmarole": "إجراءات معقدة, روتين عقيم (إجراء طويل ومعقد ومربك) / كَلَام طَوِيل وَمُمِلّ, لَغْو (مجموعة من البيانات المربكة والتي لا معنى لها)\nمثال: كل ذلك الروتين الأكاديمي كان مضيعة للوقت",
 "rigor": "شدة, صرامة (صرامة مفرطة) / شدة, صعوبة (شيء يصعب تحمله) / سَدَاد, صِحَّة (صفة كون الشيء صحيحاً ودقيقاً)\nمثال: صرامة الشخصية",
 "rigor mortis": "تخشب الموت, تيبس الموت (تصلب عضلي يبدأ بعد 2 إلى 4 ساعات من الوفاة ويستمر لمدة 4 أيام تقريباً) / تيبس موتي, صمل موتي (تصلب مؤقت للمفاصل وتيبس عضلي يحدث بعد الموت)",
 "rigorous": "صَارِم, مُتَشَدِّد (يَتَطَلَّبُ التَّقَيُّدَ الصَّارِمَ بِالقَوَاعِدِ وَالإِجْرَاءَات) / صَارِم, صَرِيم (دقيق بصرامة؛ لا يسمح بأي انحراف عن المعيار)",
 "rigorously": "بِحَزْم, بِدِقَّة (بطريقة تتسم بالشدة والدقة)\nمثال: تلقى تدريباً صارماً على يد الرهبان",
 "rigorousness": "شدة, صرامة (صرامة مفرطة) / شدة, صعوبة (شيء يصعب تحمله)\nمثال: صرامة الشخصية",
 "rigour": "شدة, صرامة (صرامة مفرطة) / شدة, صعوبة (شيء يصعب تحمله) / سَدَاد, صِحَّة (صفة كون الشيء صحيحاً ودقيقاً)\nمثال: صرامة الشخصية",
 "rigourousness": "شدة, صرامة (صرامة مفرطة) / شدة, صعوبة (شيء يصعب تحمله)\nمثال: صرامة الشخصية",
 "rigout": "زي, هندام غريب (زي الشخص (خاصة إذا كان غريباً))\nمثال: يا له من زي غريب!",
 "rijeka": "رِيِيكَا",
 "rijstafel": "ريستافل (طبق من أصل إندونيسي؛ يتم تقديم مجموعة واسعة من الأطعمة والصلصات مع الأرز)",
 "rijsttafel": "ريستافل (طبق من أصل إندونيسي؛ يتم تقديم مجموعة واسعة من الأطعمة والصلصات مع الأرز)",
 "riksmaal": "ريكسمل (في عام 1929، تم إعادة تسمية هذه اللهجة من النرويجية رسميًا إلى بوكمال)",
 "riksmal": "ريكسمل (في عام 1929، تم إعادة تسمية هذه اللهجة من النرويجية رسميًا إلى بوكمال)",
 "riled": "مُتَضَايِق, مُنْزَعِج (أُثير فيه نفاد الصبر أو الغضب)",
 "rilievo": "نحت ناتئ, نقش بارز (نحت يتكون من أشكال منحوتة على سطح بحيث تبرز عن الخلفية المحيطة)",
 "rill": "قناة صغيرة, مجرى صغير (قناة صغيرة (كتلك التي تكونت بفعل تعرية التربة)) / جدول صغير, ساقية (مجرى مائي صغير)",
 "rim": "حافة, شفة (الحافة العليا لوعاء أو حاوية أخرى) / حافة بارزة, شفة (نتوء يستخدم للتقوية أو للتثبيت بجسم آخر) / إطار العجلة, جنط (الجزء الخارجي من العجلة الذي يثبت عليه الإطار) / حلقة السلة ((في كرة السلة) الطوق الذي تتدلى منه الشبكة)\nمثال: اصطدمت الكرة بالحلقة وارتدت",
 "rim blight": "لفحة الحواف (مرض يصيب نباتات الشاي، يتميز باصفرار ثم تحول حواف الأوراق إلى اللون البني)",
 "rima": "شق (فتحة ضيقة ممدودة أو شق بين جزأين متماثلين)",
 "rima glottidis": "مزمار, مزمار حقيقي (الحيز بين الطيتين الصوتيتين الحقيقيتين)",
 "rima oris": "تجويف فموي, فم (الفتحة التي يتم من خلالها تناول الطعام وخروج الأصوات)\nمثال: حشا فمه بالحلوى",
 "rima pudendi": "شق فرجي (الشق بين الشفرين الكبيرين)",
 "rima respiratoria": "شق الدهليز, مزمار كاذب (الفتحة بين الطيات الصوتية الكاذبة)",
 "rima vestibuli": "شق الدهليز, مزمار كاذب (الفتحة بين الطيات الصوتية الكاذبة)",
 "rima vocalis": "مزمار, مزمار حقيقي (الحيز بين الطيتين الصوتيتين الحقيقيتين)",
 "rima vulvae": "شق فرجي (الشق بين الشفرين الكبيرين)",
 "rimactane": "ريفادين, ريفامبين (دواء مضاد للبكتيريا (الأسماء التجارية ريفادين وغيرها) يستخدم لعلاج السل)",
 "rime": "بَرَد (أصبح باردا، ضد سَخَنَ وهو فعل لازم مصدر بَرْد وبُرود؛ مَاتَ، على المجاز لأن الميت تبرد جثته. فعل لازم مصدر بَرْد)\nمثال: لا أتحمل البرد.",
 "rimed": "مُتَجَمِّد, مُكَلَّل بِالصَّقِيع (مُغطّى بالصقيع)",
 "rimeless": "غير مقفى, مرسل (ليس له قافية)\nمثال: كتابة الشعر المرسل غير المقفى تشبه لعب التنس بدون شبكة",
 "riming": "مسجوع, مقفى (له أصوات متطابقة خاصة الأصوات النهائية)\nمثال: شعر مقفى",
 "rimless": "بلا إطار (يفتقر لإطار أو حافة)\nمثال: نظارات بلا إطار",
 "rimmed": "ذو إطار, مؤطر (له إطار أو حافة من نوع محدد)\nمثال: هل ترتدي نظارات ذات إطار أم بلا إطار؟",
 "rimose": "مُتَشَقِّق (ذو سطح مغطّى بشبكة من الشقوق والصدوع الصغيرة)",
 "rimu": "ريمو, صنوبر أحمر (شجرة خشبية طويلة في نيوزيلندا)",
 "rimy": "مُتَجَمِّد, مُكَلَّل بِالصَّقِيع (مُغطّى بالصقيع)",
 "rind": "قشرة (الغطاء الخارجي الطبيعي للطعام (يزال عادة قبل الأكل))",
 "rinderpest": "طاعون الماشية (مرض فيروسي معد حاد يصيب الماشية (غالباً ما يكون قاتلاً)؛ يتميز بالحمى والإسهال والتهاب الأغشية المخاطية)",
 "ring": "حَلْقَة / خَاتَم, خَاتِم / دَقَّ, رَنَّ (الشيءَ: ضربه وأصدر صوتًا عند الدق؛ البابَ: طرقه) / رَنَّ ((رَنَّ) رنينا: صَوَّت وَصَاح؛ (رَنَّ) إِلَيْهِ: أصغى) / تَلْفَنَ, رَنَّ / مثال: واصل زيري دق الجرس.",
 "ring armor": "درع حلقي, درع زرد ((في العصور الوسطى) درع مرن مصنوع من حلقات معدنية متشابكة)",
 "ring armour": "درع حلقي, درع زرد ((في العصور الوسطى) درع مرن مصنوع من حلقات معدنية متشابكة)",
 "ring blackbird": "شحرور مطوق (سمنة أوروبية شائعة في المناطق الصخرية؛ الذكر له ريش مسود مع شريط أبيض حول الرقبة)",
 "ring containment": "احتواء حلقي (استراتيجية دفاعية في حالات الإرهاب البيولوجي؛ تطعيم الأشخاص المعرضين والمخالطين فقط)\nمثال: الاحتواء الحلقي طريقة مثبتة لوقف وباء الجدري",
 "ring dance": "رقص حلقي, رقصة دائرية (رقصة شعبية؛ يشكل الراقصون دائرة)",
 "ring disease": "عفن حلقي, مرض حلقي (مرض يصيب الطماطم والبطاطس والتبغ وغيرها تسببه بكتيريا 'سودوموناس سولاناسيروم')",
 "ring finger": "بِنْصِر",
 "ring girl": "فتاة الحلبة (شابة ترفع بطاقات تشير إلى رقم الجولة التالية في مباريات الملاكمة)",
 "ring mail": "درع حلقي, درع زرد ((في العصور الوسطى) درع مرن مصنوع من حلقات معدنية متشابكة)",
 "ring of color": "هالة (منطقة دائرية صغيرة مثل تلك الموجودة حول حلمة الإنسان أو منطقة ملتهبة حول بثرة أو لدغة حشرة)",
 "ring ouzel": "شحرور مطوق (سمنة أوروبية شائعة في المناطق الصخرية؛ الذكر له ريش مسود مع شريط أبيض حول الرقبة)",
 "ring road": "طريق التفافي, طريق دائري (طريق سريع يحيط بمنطقة حضرية حتى لا تضطر حركة المرور إلى المرور عبر المركز)",
 "ring rot": "عفن حلقي, مرض حلقي (مرض يصيب الطماطم والبطاطس والتبغ وغيرها تسببه بكتيريا 'سودوموناس سولاناسيروم')",
 "ring rot bacteria": "بكتيريا العفن الحلقي, زائفة باذنجانية (تسبب العفن البني في الطماطم والبطاطس والتبغ وغيرها)",
 "ring rot fungus": "عفن الخبز الأسود, فطر العفن الجاف (فطر يسبب عفناً مائياً ليناً في الفواكه والخضروات وحلقات من العفن الجاف حول جذور البطاطا الحلوة)",
 "ring snake": "ثعبان مطوق العنق (أي من ثعابين أمريكا الشمالية الصغيرة غير السامة العديدة ذات حلقة صفراء أو برتقالية حول الرقبة) / ثعبان العشب, ثعبان مطوق (ثعبان أوروبي غير ضار ذو طوق أصفر ساطع؛ شائع في إنجلترا)",
 "ring thrush": "شحرور مطوق (سمنة أوروبية شائعة في المناطق الصخرية؛ الذكر له ريش مسود مع شريط أبيض حول الرقبة)",
 "ring vaccination": "تطعيم حلقي (إعطاء اللقاح فقط للأشخاص المخالطين لمريض معزول؛ يمنع انتشار مرض شديد العدوى عن طريق إحاطة المريض بحلقة من التحصين)",
 "ring-a-rosy": "حلقة حول الورد (لعبة أطفال يرقص فيها اللاعبون في دائرة وعند إشارة معينة يجلس الجميع القرفصاء)",
 "ring-around-a-rosy": "حلقة حول الورد (لعبة أطفال يرقص فيها اللاعبون في دائرة وعند إشارة معينة يجلس الجميع القرفصاء)",
 "ring-around-the-rosy": "حلقة حول الورد (لعبة أطفال يرقص فيها اللاعبون في دائرة وعند إشارة معينة يجلس الجميع القرفصاء)",
 "ring-binder": "حافظة ملفات, مجلد (أداة لحفظ الأوراق السائبة أو المجلات)",
 "ring-necked parakeet": "ببغاء مطوق (ببغاء أفريقي)",
 "ring-necked pheasant": "تدرج مطوق (تدرج شائع ذو ريش زاهي وحلقة عنق بيضاء)",
 "ring-necked snake": "ثعبان مطوق العنق (أي من ثعابين أمريكا الشمالية الصغيرة غير السامة العديدة ذات حلقة صفراء أو برتقالية حول الرقبة)",
 "ring-shaped": "حَلَقِيّ, دَائِرِيّ (ذو شكل يشبه الحلقة أو الخاتم)",
 "ring-tailed cat": "بساريسك, قط حلقي الذيل (ثديي قارت شبيه بالراكون من المكسيك وجنوب غرب الولايات المتحدة له ذيل كثيف طويل بحلقات سوداء وبيضاء)",
 "ring-tailed lemur": "ليمور حلقي الذيل (ليمور صغير ذيله مخطط باللون الأسود)",
 "ringdove": "حمامة الغابة, ورشان (حمامة أوراسية ذات بقع بيضاء على الأجنحة والرقبة) / يمامة مطوقة (يمامة من العالم القديم رمادية اللون ذات شريط أسود حول الرقبة؛ غالباً ما تُربى في أقفاص)",
 "ringed": "مُتَزَوِّجٌ شَرْعِيًّا (يلبس خاتم زواج؛ متزوج قانونياً) / ذُو حَلَقَات, مُحَلَّق (عليه حلقات ملوّنة حول الجسم) / حَلَقِيّ, دَائِرِيّ (ذو شكل يشبه الحلقة أو الخاتم)",
 "ringed snake": "ثعبان العشب, ثعبان مطوق (ثعبان أوروبي غير ضار ذو طوق أصفر ساطع؛ شائع في إنجلترا)",
 "ringer": "رمية مطوقة ((لعبة حدوة الحصان) الرمية الناجحة لحدوة الحصان أو الحلقة بحيث تحيط بالوتد) / مشارك منتحل (متسابق دخل في منافسة تحت ذرائع كاذبة) / صُورَة طِبْق الْأَصْل, نُسْخَة (شخص متطابق تقريباً مع آخر) / قارع الأجراس (شخص يقرع أجراس الكنيسة (مثل دعوة المصلين))",
 "ringer solution": "محلول رينغر (محلول مائي يحتوي على كلوريدات الصوديوم والبوتاسيوم والكالسيوم ويكون متساوي التوتر مع الأنسجة الحيوانية؛ يستخدم لتصحيح الجفاف و(في التجارب…)",
 "ringer's solution": "محلول رينغر (محلول مائي يحتوي على كلوريدات الصوديوم والبوتاسيوم والكالسيوم ويكون متساوي التوتر مع الأنسجة الحيوانية؛ يستخدم لتصحيح الجفاف و(في التجارب…)",
 "ringgit": "رِينْغِيت",
 "ringhals": "ثعبان باصق, رينغالس (ثعبان شديد السمية من جنوب أفريقيا قادر على بصق السم لمسافة تصل إلى سبعة أقدام)",
 "ringing": "جهارة, دوي (امتلاك طابع صوت عميق وعالٍ؛ خاصية الرنين) / تقديم الخاتم (إعطاء خاتم كرمز للخطوبة) / دق الجرس, رنين (صوت رنين الجرس)\nمثال: الرنين المميز لجرس الكنيسة",
 "ringleader": "رأس المدبرين, زعيم عصابة (شخص يقود الآخرين (خاصة في الأنشطة غير المشروعة))",
 "ringlet": "فراشة الحلقات (حشرة صغيرة رقيقة ذات أجنحة كبيرة قد تكون ملونة أو غير ملونة) / حلقة صغيرة, خاتم صغير (خاتم صغير) / تجعيد, حلقة (شكل مستدير يتكون من سلسلة من الدوائر متحدة المركز (كما تشكلها الأوراق أو بتلات الزهور)) / حَلَقَة شَعْر, خُصْلَة لَوْلَبِيَّة (خصلة شعر على شكل لولب أو تجعيدة)\nمثال: آه ، هناك فراشة!",
 "ringlet butterfly": "فراشة الحلقات (حشرة صغيرة رقيقة ذات أجنحة كبيرة قد تكون ملونة أو غير ملونة)\nمثال: آه ، هناك فراشة!",
 "ringleted": "ذُو خُصَلٍ حَلَقِيَّة, مُحَلَّق ((عَنِ الشَّعْرِ) مُشَكَّلٌ عَلَى هَيْئَةِ حَلَقَاتٍ)",
 "ringlike": "حَلَقِيّ (على شكل حلقة)",
 "ringmaster": "مدير الحلبة, مقدم السيرك (الشخص المسؤول عن العروض في حلبة السيرك)",
 "ringneck snake": "ثعبان مطوق العنق (أي من ثعابين أمريكا الشمالية الصغيرة غير السامة العديدة ذات حلقة صفراء أو برتقالية حول الرقبة)",
 "rings": "حلق, حلقات (جهاز جمباز يتكون من زوج من الحلقات المعدنية الثقيلة (مغطاة عادة بالجلد) معلقة بحبال؛ تستخدم لتمارين الجمباز)\nمثال: تتطلب الحلقات قوة جسدية علوية كبيرة",
 "ringside": "مَقْعَد الحَلْبَة (الصف الأول من المقاعد؛ يتمتع برؤية خالية من العوائق لحلبة الملاكمة أو المصارعة)",
 "ringside seat": "مَقْعَد الحَلْبَة (الصف الأول من المقاعد؛ يتمتع برؤية خالية من العوائق لحلبة الملاكمة أو المصارعة)",
 "ringtail": "عقاب ذهبي يافع (عقاب ذهبي غير بالغ) / سعدان الكبوشي, كبوشي (قرد من أمريكا الوسطى والجنوبية يتميز بشعر كثيف على الرأس يشبه قلنسوة الراهب) / راكون, راكون شائع (الراكون الموجود في أمريكا الشمالية) / بساريسك, قط حلقي الذيل (ثديي قارت شبيه بالراكون من المكسيك وجنوب غرب الولايات المتحدة له ذيل كثيف طويل بحلقات سوداء وبيضاء)",
 "ringtone": "نَغْمَة الرَنَّة, نَغْمَة رَنِين",
 "ringway": "طريق التفافي, طريق دائري (طريق سريع يحيط بمنطقة حضرية حتى لا تضطر حركة المرور إلى المرور عبر المركز)",
 "ringworm": "سَعْفَة, قَرَع",
 "ringworm bush": "شجيرة السعفة, كاسيا مجنحة (شجيرة استوائية (خاصة في الأمريكتين) لها زهور صفراء وأوراق كبيرة يستخدم عصيرها كعلاج للسعفة واللدغات السامة؛ تصنف أحياناً في جنس كاسيا)",
 "ringworm cassia": "شجيرة السعفة, كاسيا مجنحة (شجيرة استوائية (خاصة في الأمريكتين) لها زهور صفراء وأوراق كبيرة يستخدم عصيرها كعلاج للسعفة واللدغات السامة؛ تصنف أحياناً في جنس كاسيا)",
 "ringworm shrub": "شجيرة السعفة, كاسيا مجنحة (شجيرة استوائية (خاصة في الأمريكتين) لها زهور صفراء وأوراق كبيرة يستخدم عصيرها كعلاج للسعفة واللدغات السامة؛ تصنف أحياناً في جنس كاسيا)",
 "rink": "حلبة تزلج (مبنى يحتوي على سطح للتزلج على الجليد أو التزلج بالعجلات)",
 "rinkhals": "ثعبان باصق, رينغالس (ثعبان شديد السمية من جنوب أفريقيا قادر على بصق السم لمسافة تصل إلى سبعة أقدام)",
 "rinse": "شَطَفَ (غسل أو نظف الشيء بالماء، غالبًا بمعنى التنظيف العميق؛ في بعض الاستخدامات، يمكن أن تعني إزالة ما علق بالشيء من أوساخ أو شوائب) / مَضْمَضَ",
 "rinsing": "شطف (إزالة الصابون بالماء النظيف في المرحلة النهائية من الغسيل)",
 "rio de janeiro": "رِيُّو دِي جَانِيرُو",
 "rio grande do norte": "رِيُو غْرَانْدِي دُو نُورْتِي",
 "rio grande do sul": "رِيُو غْرَانْدِي دُو سُولْ",
 "rio nunez coffee": "بن روبوستا, قهوة روبوستا (موطنها غرب أفريقيا ولكنها تزرع في جاوة وأماكن أخرى؛ مقاومة لصدأ القهوة)",
 "rioja": "ريوخا (نبيذ مائدة أحمر جاف من منطقة ريوخا في شمال إسبانيا)",
 "riot": "شَغَب ((شَغَبَ) القومَ، وعليهم، وفيهم، وبهم يَشْغَبَ شَغَبًا: هَيَّجَ الشر بينهُم؛ يقال: شَغَبَ فلانٌ: أَحدثَ فتْنَةً وجلَبَةٌ)\nمثال: هو حرض على الشغب.",
 "riot act": "قانون الشغب (قانون إنجليزي سابق يطالب الغوغاء بالتفرق بعد أن يقرأ القاضي القانون عليهم) / إِنْذَار صَارِم, تَوْبِيخ شَدِيد (توبيخ قوي وحازم)\nمثال: قرأت عليه الإنذار الصارم",
 "riot control": "مكافحة الشغب (التدابير المتخذة للسيطرة على أعمال الشغب)",
 "riot control operation": "مكافحة الشغب (التدابير المتخذة للسيطرة على أعمال الشغب)",
 "riot gun": "بندقية مكافحة الشغب (سلاح ناري مصمم لتفريق المشاغبين بدلاً من إلحاق إصابات خطيرة أو الوفاة)",
 "riot police": "شُرطةُ مُكافَحةِ الشَغَب",
 "rioter": "مثير للشغب, مشاغب (مثير للمتاعب يشارك في اضطرابات عنيفة تخل بالأمن؛ شخص يتمرد على السلطة القائمة)",
 "rioting": "شغب (حالة من الاضطراب تنطوي على عنف جماعي)",
 "riotous": "زَاخِر, فَيَّاض (يُنتَج أو ينمو بوَفْرة بالغة) / فَاسِق, مُسْتَهْتِر (مُتَحَرِّرٌ مِنَ القُيُودِ الأَخْلَاقِيَّةِ وَالأَعْرَاف) / عَاصِف, مُضْطَرِب (يتّسم بالفوضى أو الاضطراب أو التمرّد)",
 "riotously": "بحيوية فائقة, بصخب (بطريقة مفعمة بالحيوية والنشاط المفرط) / باضطراب, بصخب (بطريقة صاخبة ومشاغبة)\nمثال: الزخرفة الباروكية الصاخبة للكنيسة",
 "rip": "تمزيق, شق (عملية شق أو تمزيق شيء ما) / تيار ساحب, تيار عنيف (امتداد من المياه المضطربة في نهر أو في البحر ناتج عن تدفق تيار في تيار آخر أو عبره) / تمزق, شرم (فتحة أحدثت بالقوة عن طريق الشد) / فاسق (رجل منحل في المجتمع الراقي)\nمثال: قام بتمزيق الظرف بقوة",
 "rip current": "تيار ساحب, تيار شاطئي (تيار سطحي قوي يتدفق للخارج من الشاطئ)",
 "rip van winkle": "كثير النوم, نؤوم (شخص ينام كثيراً) / ريب فان وينكل (شخص غافل عن التغيرات الاجتماعية)",
 "rip-off": "سرقة كبرى, نهب (فعل السرقة)",
 "rip-roaring": "صَاخِب, مُزْعِج (شديد الضجيج بشكل لا يمكن السيطرة عليه)",
 "riparia riparia": "سنونو الجرف (سنونو من نصف الكرة الشمالي يعشش في أنفاق محفورة في ضفاف الطين أو الرمل)",
 "riparian": "ضفافي, نهري (من أو يتعلق بضفاف النهر أو يقع عليها)\nمثال: أرض نهرية",
 "riparian forest": "غابة ضفاف النهر (غابات على طول ضفاف جدول أو نهر)",
 "riparian right": "حق المياه, حقوق الشرب (حق الوصول إلى المياه)",
 "ripcord": "حبل الفتح (حبل يتم سحبه لفتح المظلة من حقيبتها أثناء الهبوط) / حبل التنفيس (حبل يتم سحبه لفتح كيس الغاز في المنطاد بشكل واسع بما يكفي لإخراج الغاز وبالتالي هبوط المنطاد)",
 "ripe": "ناضِج, حاصِد",
 "ripe olive": "زيتون أسود (زيتون يقطف ناضجاً ويعالج في محلول ملحي ثم يجفف أو يخلل أو يحفظ معلباً أو في الزيت)",
 "ripely": "بنضج (بمظهر ناضج أو مكتمل النمو)",
 "ripen": "يَنَعَ, نَضَجَ (أَيْنَعَ؛ نَضَجَ)",
 "ripened": "مُعَتَّق, نَاضِج (بلغ الحالة المرغوبة أو النهائية (للنبيذ أو الفاكهة أو الجبن))",
 "ripeness": "نضج (حالة كونه ناضجاً (للثمار))",
 "ripening": "إيناع, نضج (الوصول إلى التطور الكامل؛ أن يصبح ناضجًا) / تعتق, نضج (اكتساب صفات مرغوبة عن طريق ترك الشيء دون إزعاج لبعض الوقت)",
 "riposte": "رد, هجمة مرتدة ((المبارزة) هجوم مضاد يتم فوراً بعد صد اندفاع الخصم بنجاح) / جواب سريع, رد مفحم (رد سريع على سؤال أو ملاحظة (خاصة إذا كان ذكياً أو نقدياً))\nمثال: استدعى ذلك رداً حاداً من المعلم",
 "ripped": "مُمَزَّق",
 "ripper": "سفاح (قاتل يمزق الضحايا بسكين)",
 "ripping": "شَاقّ, مُمَزِّق (يُشْبِه صَوْت تَمْزِيق عَنِيف كَصَوْت البَرْق المُشَقِّق لِلسَّمَاء) / رَفِيع, مُتَأَلِّق (جيد جدًا؛ من أرقى مستويات الجودة)",
 "ripping bar": "عتلة الهدم, قضيب التفكيك (رافعة فولاذية أحد طرفيها مشكل كإزميل هدم والآخر معقوف بمخلب لسحب المسامير)",
 "ripping chisel": "إزميل هدم (إزميل طويل بطرف قطع منحني قليلاً؛ يستخدم للرفع الثقيل أو تنظيف النقرات)",
 "ripple": "تموج صغير, مويجة (موجة صغيرة على سطح سائل) / تموج ((في الإلكترونيات) تذبذب ذو سعة صغيرة مفروض فوق قيمة ثابتة)",
 "ripple mark": "علامة تموج (واحدة من سلسلة من الحواف الصغيرة الناتجة في الرمال بواسطة التيارات المائية أو الرياح)",
 "ripple-grass": "لسان الحمل السهاني, لسان الحمل ضيق الأوراق (نبات لسان حمل من العالم القديم بأوراق مضلعة ضيقة طويلة راسخ في المناطق المعتدلة)",
 "rippled": "مُتَمَوِّج (مُهتزّ على شكل موجات أو تموّجات بفعل الرياح) / مُتَمَوِّج, مُجَعَّد (غير مستوٍ بسبب وجود تجاعيد أو موجات)",
 "rippling": "تموج صغير, مويجة (موجة صغيرة على سطح سائل)",
 "ripsaw": "منشار شق طولي (منشار يدوي للقطع مع اتجاه ألياف الخشب)",
 "riptide": "تيار ساحب, تيار شاطئي (تيار سطحي قوي يتدفق للخارج من الشاطئ) / تيار ساحب, تيار عنيف (امتداد من المياه المضطربة في نهر أو في البحر ناتج عن تدفق تيار في تيار آخر أو عبره)",
 "risc": "حاسوب بمجموعة تعليمات مقلصة, ريسك ((علم الحاسوب) نوع من معمارية الحاسوب يحتوي على مجموعة صغيرة نسبياً من تعليمات الحاسوب التي يمكنه تنفيذها)",
 "rise": "نَهَضَ, اِرْتَفْعَ (قَامَ) / أَشْرَقَ, شَرَقَ ((أَشْرَقَتِ) الشمسُ: طلعت وأضاءَت على الأرضِ؛ يقال: أَشرقتِ الأَرضِ: أنارت بإشراقِ الشمس)\nمثال: نهض توم على قدميه.",
 "rise from the dead": "قام (اِنْتَصَبَ، نَهَضَ، وَقَفَ؛ ثَبَتَ، وَقَفَ، حَبَسَ)\nمثال: لقد قام بواجبه.",
 "rise to power": "اعتلاء, تولي (فعل الوصول أو الحصول على منصب جديد أو حق (خاصة العرش))\nمثال: اعتلاء إليزابيث العرش في عام 1558",
 "risen": "طَالِع, مُشْرِق ((عن الأجرام السماوية) فَوْقَ خَطِّ الأُفُق)",
 "riser": "قائمة الدرجة (عضو هيكلي يتكون من الجزء الرأسي لدرج أو خطوة) / أنبوب صاعد (أنبوب رأسي في مبنى) / مُسْتَيْقِظ, نَاهِض (شخص ينهض (خاصة من الفراش))\nمثال: هو عادة ناهض متأخر",
 "riser main": "أنبوب صاعد (أنبوب رأسي في مبنى)",
 "riser pipe": "أنبوب صاعد (أنبوب رأسي في مبنى)",
 "riser pipeline": "أنبوب صاعد (أنبوب رأسي في مبنى)",
 "rishi": "رِيشِي",
 "rishon lezion": "ريشون لتصيون, ريشون لتسيون",
 "risibility": "بشاشة, ميل للضحك (الاستعداد للضحك)",
 "risible": "كُومِيدِيّ, مُضْحِك (يُثير الضحك أو يستدعيه)",
 "rising": "اِنْتِفَاضَة, تَمَرُّد (معارضة منظمة للسلطة؛ صراع يحاول فيه فصيل انتزاع السيطرة من آخر) / بَازِغ, صَاعِد (برز حديثاً إلى الواجهة) / صَاعِد, نَاشِئ (يَبْلُغُ مَرْحَلَةَ النُّضْج) / طَالِع, مُنْحَدِرٌ صُعُودًا (مَائِلٌ نَحْوَ الأَعْلَى)",
 "rising prices": "ارتفاع الأسعار, تضخم (زيادة عامة ومستمرة في الأسعار)\nمثال: في التضخم يصبح كل شيء أكثر قيمة ما عدا المال",
 "rising slope": "صُعُود, مَطْلَع (الخاصية التي يمتلكها منحدر أو سطح يرتفع للأعلى)",
 "rising tide": "فيضان, مد صاعد (حدوث تدفق المياه للداخل (بين الجزر والمد العالي التالي))\nمثال: مد في شؤون البشر، إذا أُخذ في ذروته، يقود إلى الثروة",
 "rising trot": "خبب صاعد (ينهض الفارس من السرج كل خطوة ثانية)",
 "risk": "مُخَاطَرة / مُجَازَفَة / خَطَر (خطر في مشيه: اهتز وتبختر؛ خطر بذنبه: رفعه مرة وخفضه أخرى، أو حركه يمينا وشمالا) / خَاطَرَ\nمثال: أنا ذاهب للخطر.",
 "risk arbitrage": "مراجحة المخاطر (مراجحة تنطوي على مخاطر؛ كما في الشراء المتزامن للأسهم في شركة مستهدفة وبيع الأسهم في المستحوذ المحتمل؛ إذا فشل الاستحواذ قد يخسر المراجح الكثير من…)",
 "risk capital": "رأس مال جريء, رأس مال مخاطر (ثروة متاحة للاستثمار في مشاريع جديدة أو مضاربة)",
 "risk factor": "عَامِل اِخْتِطَار (الذي يَعْمَل أو الذي عَمِلَ؛ هو الذي وَلاه السُلْطَان على أمر من أمور الدولة. الجمع عمَال)\nمثال: توم عامل نفايات.",
 "risk group": "فئة معرضة للخطر, مجموعة الخطر (مجموعة من الأشخاص يشتركون في احتمالية التأثر بحدث معين (مثل الإصابة بمرض، أو فرصة الشفاء، إلخ))",
 "risk of exposure": "خطر التعرض, مخاطرة (احتمال التعرض لعامل معد)",
 "risk of infection": "خطر العدوى, مخاطرة (احتمال الإصابة بالعدوى بعد حدوث التعرض لعامل معد)",
 "risk taker": "مغامر, مُخاطر (شخص يخاطر بالخسارة أو الإصابة أملاً في الكسب أو الإثارة)",
 "risk-free": "بِلَا مُخَاطَرَة, خَالٍ مِنَ المَخَاطِر (يُعتَقد أنّه خالٍ من المخاطر)",
 "riskily": "بشكل محفوف بالمخاطر, بمخاطرة (بطريقة خطيرة تنطوي على مجازفة)\nمثال: خسر المباراة لأنه لعب بمخاطرة كبيرة",
 "riskiness": "خطر, مجازفة (حالة خطر تنطوي على مخاطرة)",
 "riskless": "بِلَا مُخَاطَرَة, خَالٍ مِنَ المَخَاطِر (يُعتَقد أنّه خالٍ من المخاطر)",
 "risklessness": "خلو من المخاطر (السلامة نتيجة لعدم وجود مخاطر)",
 "risky": "خَطِر (خطر في مشيه: اهتز وتبختر؛ خطر بذنبه: رفعه مرة وخفضه أخرى، أو حركه يمينا وشمالا)\nمثال: أنا ذاهب للخطر.",
 "risky venture": "مغامرة (مشروع جامح ومثير (ليس بالضرورة قانونياً))",
 "risotto": "رِيزُوتُو",
 "risque": "فَاحِش, مُوحٍ بِالبَذَاءَة (يُلمّح إلى سلوك جنسيّ غير لائق)",
 "riss glaciation": "تجلد ريس (التجلد قبل الأخير في العصر البليستوسيني في جبال الألب والرواسب التي تكونت في ذلك الوقت)",
 "rissole": "ريصول, كبة مقلية (لحم مطبوخ مفروم أو سمك مغطى بالبيض وفتات الخبز ومقلي في زيت غزير)",
 "rit.": "رَالِّينْتَانْدُو, رِيتَارْدَانْدُو ((في الموسيقى) يتباطأ تدريجيًّا في الإيقاع)",
 "ritalin": "ريتالين, ميثيل فينيدات (منشط للجهاز العصبي المركزي (الاسم التجاري ريتالين) يستخدم في علاج التغفيق عند البالغين واضطراب نقص الانتباه عند الأطفال)",
 "ritardando": "رَالِّينْتَانْدُو, رِيتَارْدَانْدُو ((في الموسيقى) يتباطأ تدريجيًّا في الإيقاع)",
 "rite": "طَقْس دِينِيّ, شَعِيرَة",
 "rite of passage": "طَقْس الْعُبُور",
 "ritenuto": "رَالِّينْتَانْدُو, رِيتَارْدَانْدُو ((في الموسيقى) يتباطأ تدريجيًّا في الإيقاع)",
 "ritonavir": "ريتونافير, نورفير (مثبط للبروتياز (الاسم التجاري نورفير) يستخدم في علاج فيروس نقص المناعة البشرية)",
 "ritual": "شَعِيرَة, مَرَاسِم",
 "ritual dance": "رقص طقسي (رقصة تكون جزءاً من طقس ديني)",
 "ritual dancing": "رقص طقسي (رقصة تكون جزءاً من طقس ديني)",
 "ritual killing": "تضحية, قتل شعائري (فعل قتل (حيوان أو شخص) استرضاءً لإله)",
 "ritualism": "طقوسية (تأكيد مبالغ فيه على أهمية الطقوس أو الأشكال الطقسية في العبادة) / علم الطقوس (دراسة الطقوس الدينية أو السحرية)",
 "ritualist": "عالم طقوس (عالم أنثروبولوجيا اجتماعية خبير في الطقوس والمراسم) / متمسك بالطقوس (مدافع عن الالتزام الصارم بالأشكال الطقسية)",
 "ritualistic": "شعائري, طقوسي (من أو يتميز بـ أو يلتزم بالطقوس)\nمثال: مجتمع إقطاعي أو طقوسي",
 "ritually": "بشكل طقوسي, في حفل رسمي (بطريقة احتفالية)\nمثال: أدى اليمين الدستورية كرئيس في حفل رسمي",
 "ritz": "فندق ريتز (فندق هو جزء من سلسلة الفنادق التي أسسها سيزار ريتز) / فخفخة (عرض متباه للأناقة)",
 "ritzy": "فَخْمٌ وَأَنِيق (أنيق بشكل ترفيّ فاخر)",
 "rival": "مُنَافِس",
 "rivalrous": "مُتَبَارٍ, مُنَافِس (حريص على التفوّق على الآخرين ومنافستهم)",
 "rivalry": "تَنَافُس, مُنَافَسَة (فعل التنافس من أجل الربح أو الجائزة)\nمثال: كانت الفرق في تنافس شرس على المركز الأول",
 "river": "نَهْر, أَنْهَار (صَارَ عَصَبِيًّا وغَضِبَ؛ أَصَابَ الشَّيْءَ أو الكَائِنَ بِغَضَبٍ أو صَارَ يَأْمُرُهُ) / نهر أبيض (صَارَ عَصَبِيًّا وغَضِبَ؛ أَصَابَ الشَّيْءَ أو الكَائِنَ بِغَضَبٍ أو صَارَ يَأْمُرُهُ)\nمثال: عبر جوناس النهر.",
 "river basin": "حوض النهر, مستجمع مائي (المنطقة الجغرافية الكاملة التي يصرفها النهر وروافده؛ منطقة تتميز بتدفق جميع مياه الجريان السطحي إلى نفس المخرج)\nمثال: التحكم في الفيضانات في حوض ميسوري",
 "river birch": "بتولا سوداء, بتولا نهرية (بتولا المستنقعات وقيعان الأنهار في جميع أنحاء شرق الولايات المتحدة لها لحاء بني محمر)",
 "river blindness": "داء كلابية الذنب, عمى نهري (الإصابة بديدان خيطية رفيعة (فيلاريا) تودع تحت الجلد عن طريق لدغة الذباب الأسود؛ عندما تصاب العين، يمكن أن يؤدي ذلك إلى العمى؛ شائع في أفريقيا وأمريكا…)",
 "river boat": "قارب نهري (قارب يستخدم في الأنهار أو للإبحار في النهر)",
 "river bottom": "قاع النهر (قناة يشغلها (أو كان يشغلها) نهر)",
 "river boulder": "جُلْمُود نَهْرِيّ (جلمود حمله نهر إلى مكان بعيد عن مكان نشأته)",
 "river cooter": "كوتر (سلحفاة نهرية كبيرة من جنوب الولايات المتحدة وشمال المكسيك)",
 "river dolphin": "دلفين نهري (أي من عدة دلافين طويلة الخطم تعيش عادة في المياه العذبة في أمريكا الجنوبية وجنوب آسيا)",
 "river gum": "صمغ أحمر نهري, صمغ نهري (شجرة صمغ أحمر ملتوية نوعاً ما تنمو بشكل رئيسي على طول الأنهار؛ لها خشب محمر متين يستخدم في البناء الثقيل)",
 "river horse": "فرس النهر (حيوان عاشب ضخم سميك الجلد يعيش في أو حول أنهار أفريقيا الاستوائية)",
 "river limpet": "بطلينوس نهري (بطني قدم مخروطي دقيق يشبه البطلينوس ظاهرياً ولكنه يعيش ويتغذى على نباتات المياه العذبة)",
