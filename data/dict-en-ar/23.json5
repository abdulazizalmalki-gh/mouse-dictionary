 "restaurant": "مَطْعَم",
 "restaurant attendant": "عامل قاعة الطعام (شخص يعمل لتقديم الخدمة في غرفة الطعام)",
 "restaurant chain": "سلسلة مطاعم (سلسلة من المطاعم)",
 "restauranter": "صاحب مطعم (مالك مطعم)",
 "restaurateur": "صاحب مطعم (مالك مطعم)",
 "rested": "مرتاح, مستريح (غير متعب؛ منتعش كما بالنوم أو الاسترخاء)\nمثال: عادت مرتاحة من إجازتها",
 "rester": "مستريح (شخص يستريح)",
 "restful": "باعث على الاسترخاء, مريح (يوفر راحة جسدية أو عقلية)\nمثال: قضت ليلة مريحة في المنزل",
 "restfully": "بسكينة, بهدوء (بطريقة مريحة وهادئة)\nمثال: الشوارع مشمسة بسكينة وهدوء لأن البلدة في القداس",
 "restfulness": "سكون, هدوء (صفة كون المرء ساكناً)\nمثال: اشتاق إلى هدوء المنزل",
 "restharrow": "شُبْرُق",
 "restiform": "مَرَسِيّ (الذي يُرْسِي؛ أبو العبّاس المُرسي: هو الشيخ شهاب الدين أبو العباس أحمد بن حسن بن على الخزرجى الأنصارى المرسي، أحد شيوخ التصوف على الطريقة الشاذلية)",
 "resting potential": "جهد الراحة (فرق الجهد بين جانبي غشاء خلية عصبية عندما لا تقوم الخلية بتوصيل نبضة)",
 "resting spore": "بوغ ساكن (بوغ لبعض الطحالب أو الفطريات يبقى كامنًا؛ قد ينبت بعد فترة طويلة)",
 "restitution": "إعادة, استرداد (استعادة الشيء مرة أخرى) / إرجاع الحالة, رد الحقوق (فعل إعادة شيء إلى حالته الأصلية) / تعويضات, غرامة تعويضية (مبلغ من المال يُدفع كتعويض عن خسارة أو إصابة)\nمثال: عند إعادة الكتاب إلى صاحبه الشرعي تم توبيخ الطفل",
 "restive": "مُتَمَلْمِل / جَامِح",
 "restively": "بِتَمَلْمُل, بِضَجَر (بطريقة متململة)\nمثال: جلس مرة أخرى بتململ",
 "restiveness": "جفول, نزق (يتميز بالعصبية وسرعة الفزع) / توتر, عصبية (شعور القلق الذي ينتابك عندما تكون متوتراً) / تململ, حران (خاصية مقاومة السيطرة والعناد)\nمثال: كذلك لم تعط أي من الدراسات التي تمت مراجعتها معلومات عن انتشار العدوان وتململ الشباب في ولاية أنامبرا",
 "restless": "غَيْرُ مُرْتَاح, قَلِق (مَشْغُول البَال وَغَيْر مُطْمَئِنّ) / دَائِم الحَرَكَة, لَا يَهْدَأ (في حركة مستمرة لا تتوقف) / غير مريح, قلق (يفتقر أو لا يوفر راحة جسدية أو عقلية) / قَلِق, مُتَمَلْمِل (عَصَبِيٌّ وَغَيْرُ قَادِرٍ عَلَى الاسْتِرْخَاء)\nمثال: ليلة قلقة",
 "restless legs": "متلازمة تململ الساقين (شعور بعدم الارتياح والأرق في الساقين بعد الذهاب إلى الفراش (مما يسبب الأرق أحياناً)؛ قد يخف مؤقتاً بالمشي أو تحريك الساقين)",
 "restless legs syndrome": "متلازمة تململ الساقين (شعور بعدم الارتياح والأرق في الساقين بعد الذهاب إلى الفراش (مما يسبب الأرق أحياناً)؛ قد يخف مؤقتاً بالمشي أو تحريك الساقين)",
 "restlessly": "بتململ, بقلق (بطريقة متململة)\nمثال: طقطق مفاصل أصابعه بتململ",
 "restlessness": "تململ, قلق (عدم القدرة على الراحة أو الاسترخاء أو السكون) / تَمَلْمُل, عَدَم اسْتِقْرَار (صفة الحركة أو النشاط المستمر بلا توقف) / تململ (شعور بالاضطراب يتم التعبير عنه بالحركة المستمرة) / تململ, نفاد صبر (قلة الصبر؛ الانزعاج من أي شيء يسبب التأخير)\nمثال: تململ الريح",
 "restoration": "إعادة, استرداد (استعادة الشيء مرة أخرى) / إعادة تأهيل, استعادة (فعل إعادة شيء أو شخص إلى حالة مرضية) / نموذج استعادة, نموذج ترميم (نموذج يمثل المشهد الطبيعي لعصر جيولوجي سابق أو يمثل حيواناً منقرضاً وما إلى ذلك) / عمل مرمم, قطعة مرممة (قطعة أثرية أو فنية تم ترميمها أو إعادة بنائها)\nمثال: عند إعادة الكتاب إلى صاحبه الشرعي تم توبيخ الطفل",
 "restorative": "اسْتِشْفائِيّ, تَعافٍ (يُساعِد عَلى التَّعافي واسْتِعادَة الصِّحَّة) / مُجَدِّد, مُعِيد لِلْحَيَوِيَّة (يميل إلى بثّ حياة ونشاط جديدين) / أداة تصحيحية, وسيلة علاجية (جهاز لعلاج إصابة أو مرض) / دواء مقوي, مقوي (دواء يقوي وينشط)",
 "restore": "اِسْتَعَادَ",
 "restorer": "مُجَدِّد, مُرَمِّم (عامل ماهر يتم توظيفه لترميم أو تجديد المباني أو الأثاث العتيق)",
 "restoril": "تيمازيبام, ريستوريل (بنزوديازيبين يوصف بشكل متكرر (الاسم التجاري ريستوريل)؛ يأخذ مفعوله ببطء ويستمر لفترة كافية لمساعدة أولئك الذين يستيقظون بشكل متكرر أثناء الليل)",
 "restrained": "مُتَحَفِّظ, مُحْتَرِز (حَصِيف ومتحفّظ في التصرّف) / كَتُوم, مُتَحَفِّظ (بَارِدٌ وَرَسْمِيٌّ فِي أُسْلُوبِهِ) / مُتَحَفِّظ, هَادِئ (غير مُلفِت أو متطفّل) / رزين, مقيد (خاضع للتقييد)",
 "restrainer": "ضابط, متحكم (شخص يوجه ويضبط) / كابح, مقيد التفاعل (مادة كيميائية تضاف إلى مظهر الصور الفوتوغرافية لتأخير التظهير وتقليل كمية الضبابية على الفيلم)",
 "restraint": "تقييد, كبح (فعل السيطرة عن طريق تقييد شخص ما أو شيء ما) / رادع, قيد (جهاز يؤخر حركة شيء ما) / بساطة, تقشف فني (الخلو من الزخرفة) / تحفظ, كبح (الانضباط في الأنشطة الشخصية والاجتماعية)\nمثال: التقييد غير القانوني للتجارة",
 "restraint of trade": "تقييد التجارة (أي فعل يميل إلى منع المنافسة الحرة في الأعمال التجارية)",
 "restrict": "حَدَّ, حَدَّدَ (مُنْتَهى الشيءِ؛ الْفَصْلُ بَيْنَ الشَّيْئَيْنِ لِئَلَّا يَخْتَلِطَ أَحدهما بِالْآخَرِ أَو لِئَلَّا يَتَعَدَّى أَحدهما عَلَى الْآخَرِ)\nمثال: أعرفها إلى حد ما.",
 "restricted": "مُقَيَّد (يخضع لقيود في الاطّلاع والتداول) / مُحَدَّدُ المَعْنَى, مُقَيَّد (مَحْصُورُ المَعْنَى؛ كَمَا فِي 'رَجُل' فِي 'رَجُلٌ طَوِيل') / محدود, محصور (خاضع لقيود أو تم إخضاعه لقيود)\nمثال: ذو أهمية محدودة",
 "restricting": "حَاصِر, مُقَيِّد (يُقيِّد نطاق العمل أو حرية الحركة)",
 "restriction": "تَقْيِيد, اِقْتِصَار / قَيْد",
 "restriction endonuclease": "إنزيم الاقتطاع, إنزيم القصر (أي من الإنزيمات التي تقطع الحمض النووي في مواقع اقتطاع محددة وتنتج شظايا اقتطاع؛ يتم الحصول عليها من البكتيريا (حيث تعطل الغزاة الفيروسيين)؛ تُستخدم…)",
 "restriction enzyme": "إنزيم الاقتطاع, إنزيم القصر (أي من الإنزيمات التي تقطع الحمض النووي في مواقع اقتطاع محددة وتنتج شظايا اقتطاع؛ يتم الحصول عليها من البكتيريا (حيث تعطل الغزاة الفيروسيين)؛ تُستخدم…)",
 "restriction fragment": "شظية تقييد, قطعة حمض نووي (جزء من الحمض النووي ينتج عن شطر الحمض بواسطة إنزيم القصر (إنزيم التقييد))",
 "restriction nuclease": "إنزيم الاقتطاع, إنزيم القصر (أي من الإنزيمات التي تقطع الحمض النووي في مواقع اقتطاع محددة وتنتج شظايا اقتطاع؛ يتم الحصول عليها من البكتيريا (حيث تعطل الغزاة الفيروسيين)؛ تُستخدم…)",
 "restriction site": "موقع القطع (المواقع المحددة التي يقوم فيها إنزيم القطع بفصل الحمض النووي)",
 "restrictive": "تَقْيِيدِيّ",
 "restrictive clause": "جملة تقييدية (جملة تابعة تحد أو تقيد معنى العبارة الاسمية التي تعدلها)",
 "restrictively": "بشكل تقييدي, على نحو مقيد (بطريقة تفرض قيوداً أو حدوداً)\nمثال: تستخدم هذه الجملة النسبية بشكل تقييدي",
 "restrictiveness": "تقييد, عدم التساهل (نقص في التساهل أو التهاون والميل لحصر السلوك ضمن حدود معينة) / تَقْيِيد (تعديل نحوي يجعل المعنى أكثر تحديداً ('قبعة حمراء' لها معنى أكثر تحديداً من 'قبعة'))",
 "restroom": "حُجْرَة التُوَالِيت, حَمَّام (الغُرْفَة أو القَاعَة. تطلق على القَبْر والحَضِيرَة من باب التشبيه؛ ما يشبه الغرفة من الأرض، المكان المحمي أو المحاط بما يجعله شبيها بالمنعى الأول. استخدام مجازي وقديم)\nمثال: قعدنا في وسط الحجرة.",
 "result": "تَسَبَّب / نَتِيجَة",
 "resultant": "مُحَصَّل",
 "resultant role": "النتيجة (الدور الدلالي للعبارة الاسمية التي يوجد مرجعها فقط بفضل النشاط الذي يدل عليه الفعل)",
 "resulting trust": "ائتمان ناتج (ائتمان تنشئه المحكمة عندما يُحكم بأن نية الأطراف كانت إنشاء ائتمان)",
 "resume": "اِسْتَأْنَفَ",
 "resumption": "استئناف, عودة (البدء مرة أخرى)",
 "resupine": "مُسْتَلْقٍ عَلَى ظَهْرِه (مستلقٍ على الظهر ووجهه للأعلى)",
 "resurgence": "إحياء, انبعاث (إعادة الشيء إلى النشاط والشهرة مرة أخرى)\nمثال: انتعاش التجارة",
 "resurgent": "بَاعِث, نَاهِض (ينهض من جديد إلى حياة ونشاط متجدّدَيْن)",
 "resurrect": "أَحْيَا, بَعَثَ",
 "resurrection": "قِيَامَة / سُورَةُ الْقِيَامَةِ",
 "resurrection fern": "بوليبودي رمادي, سرخس القيامة (سرخس ينمو على الصخور أو جذوع الأشجار وله سعف رمادي وحرشفي من الأسفل؛ الأمريكتين وجنوب أفريقيا)",
 "resurrection plant": "كف مريم, نبات القيامة (نبات صحراوي آسيوي رمادي صغير يحمل أزهاراً بيضاء دقيقة يلتف عند الجفاف ويتمدد عند الرطوبة) / نبات القيامة, وردة أريحا (حليف سرخس كثيف الخصلات من جنوب غرب الولايات المتحدة إلى بيرو؛ يلتف في كرة محكمة عندما يجف ويتوسع وينمو في الظروف الرطبة)",
 "resurvey": "إعادة المسح (مسح أو دراسة جديدة)",
 "resuscitate": "أَنْعَشَ",
 "resuscitated": "مُعَافًى, مُنْعَش (أُعيد إلى الحياة أو الوعي)",
 "resuscitation": "اِنْعَاش",
 "resuscitator": "جهاز إنعاش (جهاز تنفس يستخدم للإنعاش عن طريق دفع الأكسجين إلى رئتي شخص تعرض للاختناق أو توقف التنفس)",
 "resuspension": "إعادة تعليق (تعليق متجدد للجسيمات غير القابلة للذوبان بعد ترسبها)",
 "retail": "بالتجزئة, بالقطاعي (بسعر التجزئة) / بيع بالتجزئة (بيع البضائع للمستهلكين؛ عادة بكميات صغيرة وليس لإعادة البيع)\nمثال: سأبيعها لك بالتجزئة فقط",
 "retail bank": "مَصْرِف اِسْتِهْلَاكِيّ, بَنْك اِسْتِهْلَاكِيّ (في الاقتصاد: مؤسسة مالية مُرَخصة، تختص بإتمام الخدمات المالية كتلقي عمليات الإيداع، ومنح القروض، وإدارة الثروات، واستبدال العملات)\nمثال: عدن إلى المصرف.",
 "retail chain": "سلسلة متاجر تجزئة (سلسلة من متاجر البيع بالتجزئة)",
 "retail market": "سوق التجزئة (السوق لبيع السلع أو الخدمات للمستهلكين بدلاً من المنتجين أو الوسطاء)",
 "retail merchant": "بائع بالمفرق, تاجر تجزئة (تاجر يبيع البضائع بالتجزئة)",
 "retail price": "سعر التجزئة (السعر الإجمالي المفروض على منتج يُباع للعميل، ويشمل تكلفة المصنع بالإضافة إلى هامش ربح التجزئة)",
 "retail price index": "مؤشر أسعار التجزئة (مؤشر للتغيرات في أسعار التجزئة)",
 "retail store": "متجر, محل تجاري (مكان عمل لبيع البضائع بالتجزئة)",
 "retailer": "بائع بالمفرق, تاجر تجزئة (تاجر يبيع البضائع بالتجزئة)",
 "retailing": "تجارة التجزئة (الأنشطة المتعلقة ببيع السلع مباشرة للمستهلكين)",
 "retain": "أَبْقَى / أَدَامَ / بَقَّى / حَفِظَ (الحِفْظُ نَقِيضُ النِّسْيَان، وهو التَّعَاهُدُ وقِلَّةُ الغَفْلَةِ؛ قِلَّةُ الغَفْلَةِ) / رَعَى / صانَ\nمثال: حفظ رقم هاتفها.",
 "retained": "مُحْتَفَظٌ بِه (اسْتُمِرَّ فِي حِفْظِهِ أَوِ اسْتِخْدَامِهِ أَوْ ذَاكِرَتِه)",
 "retained object": "مفعول محتفظ به (مفعول به في بناء المبني للمجهول)",
 "retainer": "مثبت أسنان (جهاز سني يثبت الأسنان (أو طرف صناعي) في موضعها بعد علاج تقويم الأسنان) / خادم (شخص يعمل في خدمة شخص آخر (خاصة في المنزل)) / عربون استعانة, مقدم أتعاب (رسم يُفرض مقدماً للاحتفاظ بخدمات شخص ما (مثل المحامي))",
 "retaining wall": "جدار استنادي (جدار يُبنى لمقاومة الضغط الجانبي (خاصة الجدار المبني لمنع تقدم كتلة من الأرض))",
 "retake": "إعادة التصوير, لقطة معادة (لقطة أو مشهد يتم تصويره مرة أخرى)",
 "retaking": "استرداد, استعادة (فعل استعادة شيء ما)",
 "retaliation": "اِنْتِقَام",
 "retaliative": "اِنْتِقَامِيّ, جَزَائِيّ (يتعلّق بالقِصاص أو الجزاء أو يتّسم بطبيعته)",
 "retaliator": "منتقم (شخص يأخذ بالثأر)",
 "retaliatory": "اِنْتِقَامِيّ, جَزَائِيّ (يتعلّق بالقِصاص أو الجزاء أو يتّسم بطبيعته)",
 "retaliatory eviction": "طرد انتقامي (طرد انتقاماً لشكاوى المستأجر بحسن نية ضد المالك؛ غير قانوني في العديد من الولايات)",
 "retaliatory tariff": "تعريفة انتقامية (تعريفة تفرض على كيان تجاري أجنبي كشكل من أشكال الرد الانتقامي)",
 "retama raetam": "رتامة, رتم",
 "retard": "أبله, متخلف عقلياً (شخص ذو ذكاء دون الطبيعي)",
 "retardant": "مُؤَخِّر, مُثَبِّط (أي عامل يؤخر أو يعطل أو يعيق)\nمثال: مُثبط للهب",
 "retardation": "تباطؤ, تلكؤ (فعل الإبطاء أو التخلف عن الركب) / إبطاء, تباطؤ (نقصان في معدل التغير) / تأخر, تخلف عقلي (نقص في التطور الطبيعي للقدرات الفكرية) / مُؤَخِّر, مُثَبِّط (أي عامل يؤخر أو يعطل أو يعيق)\nمثال: تباطؤ سباق التسلح",
 "retarded": "متأخر النمو, متخلف (بطيء نسبياً في التطور العقلي أو العاطفي أو الجسدي) / المتخلفون عقلياً, ذوو الإعاقة الذهنية (مجموعة الناس الذين يعانون من تأخر عقلي)\nمثال: توفير حياة آمنة وسعيدة أحياناً للمتأخرين عقلياً",
 "retarded blowback": "ارتداد مؤجل, ارتداد متأخر (نوع من أنظمة تشغيل الأسلحة النارية يتطلب من الترباس التغلب على بعض المقاومة الأولية بينما لا يكون مقفلاً بالكامل)",
 "retarded depression": "اكتئاب بطيء, اكتئاب مع تخلف حركي نفسي (حالة من الاكتئاب السريري يكون فيها الفرد خاملاً وبطيئاً في بدء العمل)",
 "retardent": "مُؤَخِّر, مُثَبِّط (أي عامل يؤخر أو يعطل أو يعيق)\nمثال: مُثبط للهب",
 "retarding force": "كبح, مقاومة المائع (ظاهرة مقاومة الحركة عبر مائع)",
 "retch": "تقيؤ جاف, تهوع (تشنج لا إرادي لمحاولة التقيؤ دون جدوى)\nمثال: نوبة سيئة من التهوع",
 "rete": "شبكة, ضفيرة (شبكة من الأوعية الدموية المتقاطعة أو الأعصاب المتقاطعة أو الأوعية الليمفاوية المتقاطعة)",
 "rete malpighii": "طبقة قاعدية, طبقة نامية (الطبقة الداخلية للبشرة)",
 "rete testis": "شبكة الخصية (شبكة من النبيبات تحمل الحيوانات المنوية من النبيبات المنوية إلى الأوعية الصادرة)",
 "retell": "سَرَدَ, نَقَلَ (الشيء: نَسَجَهُ ليصبح مفهوما؛ الأمر:الحديث يتلوه بإستمرار)\nمثال: يحاول الانفصاليون تطوير سرد زائف من أجل تبرير مشروعهم السياسي.",
 "retem": "رتامة, رتم",
 "retention": "حِفْظ (الحِفْظُ نَقِيضُ النِّسْيَان، وهو التَّعَاهُدُ وقِلَّةُ الغَفْلَةِ؛ قِلَّةُ الغَفْلَةِ) / ذَاكِرَة / أُسْر (الأَسْر : شدة الخَلْق؛ الأَسْر : القيدُ)\nمثال: حفظ رقم هاتفها.",
 "retention basin": "حوض احتباس (موقع تخزين مشابه لحوض الاحتجاز لكن المياه المخزنة تُمنع بشكل دائم من التدفق باتجاه المصب)",
 "retentive": "حَابِس لِلْمَاء, كَتِيم (له القدرة على الاحتفاظ بالماء) / حافظ, قوي الذاكرة (جيد في التذكر) / احتفاظي, ماسك (لديه القدرة على الاحتفاظ بشيء ما)\nمثال: عقل حافظ",
 "retentively": "بحفظ جيد, بذاكرة قوية (بطريقة تدل على القدرة على الاحتفاظ بالأشياء أو المعلومات)",
 "retentiveness": "احتباس, احتفاظ (القدرة على الاحتفاظ بالسائل) / احتفاظ, استبقاء (خاصية الاحتفاظ بالممتلكات التي تم اكتسابها) / حفظ, ذاكرة (قوة الاحتفاظ بالخبرة الماضية واستدعائها)\nمثال: احتباس التربة للرطوبة",
 "retentivity": "احتباس, احتفاظ (القدرة على الاحتفاظ بالسائل) / احتفاظ, استبقاء (خاصية الاحتفاظ بالممتلكات التي تم اكتسابها) / حفظ, ذاكرة (قوة الاحتفاظ بالخبرة الماضية واستدعائها)\nمثال: احتباس التربة للرطوبة",
 "rethink": "إعادة نظر, تفكير ثانٍ (التفكير مرة أخرى في خيار تم اتخاذه سابقاً)\nمثال: أعاد النظر في مشترياته",
 "reticence": "تحفظ, تكتم (سمة قلة التواصل؛ عدم التطوع بأي شيء أكثر من الضروري)",
 "reticent": "كَتُوم",
 "reticently": "بتحفظ, بتكتم (بقلة كلام وتكتم)\nمثال: أجابت على الأسئلة بتكتم",
 "reticle": "تصويب, شبكية (شبكة من الخطوط الدقيقة أو النقاط أو الشعيرات المتقاطعة أو الأسلاك في المستوى البؤري لعدسة أداة بصرية)",
 "reticular": "شبكي (يشبه أو يشكل شبكة)\nمثال: العروق الشبكية للورقة",
 "reticular activating system": "نظام التنشيط الشبكي (الشبكة الموجودة في التكوين الشبكي التي تخدم وظيفة التنبيه أو الاستثارة)",
 "reticular formation": "التَكْوِين الشَبَكِيّ",
 "reticulate": "شبكي (يشبه أو يشكل شبكة)\nمثال: العروق الشبكية للورقة",
 "reticulated python": "بايثون شبكي (يعيش في جنوب شرق آسيا وجزر الهند الشرقية؛ أكبر ثعبان في العالم)",
 "reticulation": "ترابط شبكي, تشبيك (ترتيب يشبه الشبكة) / تشبك ((في التصوير الفوتوغرافي) تكون شبكة من الشقوق أو التجاعيد في المستحلب الفوتوغرافي)\nمثال: تشبيك الورقة",
 "reticule": "تصويب, شبكية (شبكة من الخطوط الدقيقة أو النقاط أو الشعيرات المتقاطعة أو الأسلاك في المستوى البؤري لعدسة أداة بصرية) / حقيبة شبكية, ريتيكول (حقيبة يد نسائية برباط؛ مصنوعة عادة من الشبكة أو الخرز؛ استخدمت في القرنين الثامن عشر والتاسع عشر)",
 "reticulitermes flanipes": "نمل أبيض أمريكي (نمل أبيض مدمر في الولايات المتحدة)",
 "reticulitermes flavipes": "نمل أبيض أمريكي (نمل أبيض مدمر في الولايات المتحدة)",
 "reticulitermes lucifugus": "نمل أبيض أوروبي (نمل أبيض مدمر في أوروبا)",
 "reticulocyte": "خلية شبكية (خلية دم حمراء غير ناضجة تحتوي على شبكة من الخيوط أو الحبيبات)",
 "reticuloendothelial system": "الجهاز الشبكي البطاني (جهاز واسع الانتشار يتكون من جميع الخلايا القادرة على التهام البكتيريا أو الجزيئات الغروية وما إلى ذلك، باستثناء بعض خلايا الدم البيضاء)",
 "reticulum": "قَلَنْسُوَة (القُلُنْسُوَة: لباس داخلي للرأس يُلبس غالبا داخليا تحت العَمَامَة أو الكُوفِيَّة أو غيره من أغطية الرأس للرجال والنساء، يسمى أيضا الطَاقِيَّة؛ القُلُنْسُوَة: لباس للرأس يشبه الداخلي إلا أنه يلبس لوحده، قد يكون أبيضا وقد يكون مطرزا، يسمى أيضا الطَاقِيَّة)\nمثال: كان زيري يرتدي قلنسوة.",
 "retina": "شَبَكِيَّة عَيْن, شَبَكِيَّة",
 "retinal": "شبكي (في أو يتعلق بشبكية العين) / ريتينال, ريتينين (أحد اثنين من أصباغ الشبكية الصفراء إلى الحمراء المتكونة من الرودوبسين بفعل الضوء)\nمثال: خلايا شبكية",
 "retinal cone": "خلية مخروطية, مخروط (خلية مستقبلة بصرية في الشبكية حساسة للضوء الساطع والألوان)",
 "retinal detachment": "انفصال الشبكية (ضعف بصري ناتج عن انفصال الشبكية عن المشيمية في الجزء الخلفي من العين)",
 "retinal purple": "أرجوان بصري, رودوبسين (خضاب ضوئي أحمر في العصي الشبكية للفقاريات؛ يتحلل إلى ريتينال بواسطة الضوء)",
 "retinal rod": "خلية عصوية, عصية (خلية مستقبلة بصرية حساسة للضوء الخافت)",
 "retinal scanning": "مسح الشبكية (تحديد هوية بيومتري عن طريق مسح شبكية العين)\nمثال: تحديد الهوية بمسح الشبكية معقد بسبب حركات العين",
 "retinene": "ريتينال, ريتينين (أحد اثنين من أصباغ الشبكية الصفراء إلى الحمراء المتكونة من الرودوبسين بفعل الضوء)",
 "retinitis": "التهاب الشبكية (التهاب الشبكية)",
 "retinoblastoma": "ورم أرومي شبكي (ورم عيني خبيث في خلايا الشبكية؛ يحدث عادة قبل السنة الثالثة من العمر؛ يتكون من خلايا شبكية مستديرة صغيرة بدائية)",
 "retinol": "رتينول",
 "retinopathy": "اعتلال الشبكية (مرض في الشبكية يمكن أن يؤدي إلى فقدان الرؤية)",
 "retinue": "بطانة, حاشية (المجموعة التي تتبع وتخدم شخصاً مهماً)",
 "retire": "تَقَاعَدَ / اِعْتَزَلَ",
 "retired": "مُتَقَاعِد",
 "retired person": "متقاعد (شخص تقاعد من العمل النشط)",
 "retiree": "مُتَقَاعِد",
 "retirement": "تَقَاعُد",
 "retirement account": "خطة تقاعد, نظام تقاعد (خطة لتخصيص الأموال لإنفاقها بعد التقاعد)",
 "retirement benefit": "صندوق التقاعد, معاش التقاعد (دفعة شهرية تُقدم لشخص تقاعد عن العمل)",
 "retirement check": "صندوق التقاعد, معاش التقاعد (دفعة شهرية تُقدم لشخص تقاعد عن العمل)",
 "retirement community": "مجمع للمتقاعدين (مجتمع مخطط للسكان الذين تقاعدوا من الحياة العملية النشطة)",
 "retirement complex": "مجمع للمتقاعدين (مجتمع مخطط للسكان الذين تقاعدوا من الحياة العملية النشطة)",
 "retirement fund": "صندوق التقاعد, معاش التقاعد (دفعة شهرية تُقدم لشخص تقاعد عن العمل)",
 "retirement home": "بَيْتُ تَقاعُدٍ, دَار مُسِنِّين (بمعنى قضى الليل؛ الخَيْمَة من الشَعْر يَبِيت فيها البَدَوي أو المُسافر. الجمع بُيُوت)\nمثال: لنعد إلى البيت.",
 "retirement pension": "صندوق التقاعد, معاش التقاعد (دفعة شهرية تُقدم لشخص تقاعد عن العمل)",
 "retirement plan": "خطة تقاعد, نظام تقاعد (خطة لتخصيص الأموال لإنفاقها بعد التقاعد)",
 "retirement program": "خطة تقاعد, نظام تقاعد (خطة لتخصيص الأموال لإنفاقها بعد التقاعد)",
 "retirement savings account": "خطة تقاعد, نظام تقاعد (خطة لتخصيص الأموال لإنفاقها بعد التقاعد)",
 "retirement savings plan": "خطة تقاعد, نظام تقاعد (خطة لتخصيص الأموال لإنفاقها بعد التقاعد)",
 "retiring": "مُتَكَتِّم, مُتَوَارٍ (يتجنّب لفت الانتباه إلى نفسه؛ متحفّظ ومنسحب) / غَيْرُ مُتَكَبِّر, مُتَوَاضِع (لَيْسَ مُتَعَجْرِفًا وَلَا مُتَطَاوِلًا)",
 "retort": "معوجة (وعاء يتم فيه تقطير المواد أو تحللها بالحرارة) / جواب سريع, رد مفحم (رد سريع على سؤال أو ملاحظة (خاصة إذا كان ذكياً أو نقدياً))\nمثال: استدعى ذلك رداً حاداً من المعلم",
 "retractable": "قَابِلٌ لِلسَّحْب (يمكن سحبه وإرجاعه إلى الداخل)",
 "retracted": "مَسْحُوب, مُنْكَمِش (مسحوب إلى الداخل والخلف)",
 "retractile": "انكماشي, قابل للسحب (قابل للانكماش؛ يمكن سحبه للخلف)\nمثال: القطط لها مخالب قابلة للسحب",
 "retraction": "تراجع, سحب (عملية سحب أو إمساك أو جر جزء للخلف) / تراجع, سحب كلام (تبرؤ أو تراجع عن تأكيد سابق)\nمثال: سحب معدات الهبوط",
 "retractor": "مبعد (أداة جراحية تمسك حواف الشق الجراحي للخلف)",
 "retractor muscle": "عضلة ضامة (أي من العضلات المختلفة التي تسحب عضواً أو جزءاً من الجسم)\nمثال: تنقبض العضلة الضامة لسحب القضيب إلى الغمد وتسترخي للسماح للقضيب بالخروج من الغمد",
 "retraining": "إعادة تأهيل, إعادة تدريب (التدريب لمهنة جديدة)",
 "retral": "خَلْفِيّ, رَجْعِيّ (عند الجزء الخلفيّ أو بالقرب منه أو باتّجاهه) / تَقَهْقُرِيّ, رَجْعِيّ (يتحرك أو يتجه في اتجاه عكسي أو مضاد للاتجاه السابق)",
 "retread": "إطار مُجدد, إطار مُعاد تدويره (إطار سيارة مستعمل تم إعادة تشكيله لإعطائه نقوشاً جديدة)",
 "retreat": "تَرَاجُع / اِنْسِحَاب / تَرَاجَعَ",
 "retreatant": "مُخْتَلٍ لِلعِبادَة, مُعْتَكِف (مشارك في خلوة دينية)",
 "retreated": "منسحبون (الناس الذين انسحبوا أو تراجعوا)\nمثال: لم يكن لديه سوى الاحتقار للمنسحبين",
 "retrenchment": "تقشف, تقليص النفقات (تخفيض النفقات من أجل الاستقرار المالي) / تحصين داخلي (خندق يتكون من تحصين داخلي إضافي لإطالة أمد الدفاع)",
 "retrial": "إعادة المحاكمة (محاكمة جديدة يتم فيها إعادة فحص القضايا التي تم التقاضي بشأنها بالفعل والتي أصدرت المحكمة حكماً أو قراراً بشأنها من قبل نفس المحكمة؛ يحدث عندما يتبين…)",
 "retribution": "عِقَاب, اِنْتِقَام (طَيْر من الجَوَارِح، أكبر التي تصيد منها يكنى بأبي الهَيْثَم ومعروف بحِدَّة البصر؛ حَجَر ناتئ في جَوْف البِئْر يخرق الدَلُو. ونادر)\nمثال: هو من تلقى العقاب الأكبر.",
 "retributive": "جَزَائِيّ, عِقَابِيّ (يُمنح أو يُوقع كجزاء وفقاً للاستحقاق) / اِنْتِقَامِيّ, جَزَائِيّ (يتعلّق بالقِصاص أو الجزاء أو يتّسم بطبيعته)",
 "retributory": "جَزَائِيّ, عِقَابِيّ (يُمنح أو يُوقع كجزاء وفقاً للاستحقاق) / اِنْتِقَامِيّ, جَزَائِيّ (يتعلّق بالقِصاص أو الجزاء أو يتّسم بطبيعته)",
 "retrievable": "قَابِلٌ لِلِاسْتِعَادَةِ (يمكن استعادته خاصة ببذل جهد)",
 "retrieval": "استرداد, استعادة (فعل استعادة أو إنقاذ شيء مفقود (أو معرض لخطر الفقدان)) / استرجاع (العملية المعرفية للوصول إلى المعلومات في الذاكرة) / استرجاع ((في علم الحاسوب) عملية الوصول إلى المعلومات من ذاكرة الكمبيوتر)\nمثال: استرجاعي لأسماء الناس ضعيف جداً",
 "retrieve": "استرجع",
 "retriever": "ريتريفر, كلب الاسترداد (كلب ذو فراء ثقيل مقاوم للماء يمكن تدريبه على استرداد الطرائد)",
 "retro": "بِأَثَر رَجْعِيّ, رَجْعِيّ الأَثَر (يؤثّر في أمور ماضية) / ريترو, طراز قديم (موضة تذكر بالماضي)",
 "retroactive": "بِأَثَر رَجْعِيّ, رَجْعِيّ الأَثَر (يؤثّر في أمور ماضية) / بأثر رجعي (وصفي لأي حدث أو حافز أو عملية لها تأثير على آثار الأحداث أو المحفزات أو العمليات التي حدثت سابقًا)",
 "retroactively": "بأثر رجعي (بعد حدوث الأمر)\nمثال: سيتقاضى أجراً بأثر رجعي",
 "retrobulbar neuritis": "التهاب العصب خلف المقلة (التهاب العصب البصري خلف العين؛ شائع في التصلب المتعدد)",
 "retrofit": "تحديث, تعديل تحديثي (عملية إضافة مكون أو ملحق لشيء لم يكن يحتوي عليه عند تصنيعه) / تجهيز لاحق, تحديث (مكون أو ملحق يضاف إلى شيء بعد تصنيعه)\nمثال: أمرت المحكمة بتحديث جميع السيارات",
 "retroflection": "انثناء خلفي (عملية الانحناء للخلف) / إطباق, نطق التوائي (حركة نطقية تتم عن طريق ثني طرف اللسان للخلف ضد سقف الفم) / انثناء للخلف, انقلاب للخلف (دوران أو إمالة عضو أو جزء من الجسم للخلف)\nمثال: انقلاب الرحم للخلف",
 "retroflex": "مُرْتَدّ",
 "retroflexed": "مُنْثَنٍ إِلَى الخَلْف (منحنٍ أو مقوس إلى الوراء)",
 "retroflexion": "انثناء خلفي (عملية الانحناء للخلف) / إطباق, نطق التوائي (حركة نطقية تتم عن طريق ثني طرف اللسان للخلف ضد سقف الفم) / انثناء للخلف, انقلاب للخلف (دوران أو إمالة عضو أو جزء من الجسم للخلف)\nمثال: انقلاب الرحم للخلف",
 "retrogaming": "ألعاب الفيديو الكلاسيكية, ريترو غيمنغ (هواية لعب أو جمع ألعاب الفيديو وألعاب الكمبيوتر القديمة)",
 "retrograde": "رَجْعِيّ (فقدان ذاكرة) (لفقدان الذاكرة؛ يؤثر على الوقت الذي يسبق الصدمة مباشرة) / تَقَهْقُرِيّ, رَجْعِيّ (يتحرك أو يتجه في اتجاه عكسي أو مضاد للاتجاه السابق) / تراجعي, رجعي الحركة ((فلكياً) يتحرك من الشرق إلى الغرب على الكرة السماوية؛ أو — للكواكب — حول الشمس في اتجاه معاكس لاتجاه الأرض) / اِنْحِدَارِيّ, تَرَاجُعِيّ (يتحوّل من الأفضل إلى الأسوأ)",
 "retrograde amnesia": "فقدان الذاكرة الرجعي, نسيان رجعي (فقدان الذاكرة للأحداث التي سبقت الصدمة مباشرة)",
 "retrogression": "ارتداد, تراجع (العودة إلى حالة سابقة) / انتكاس, تدهور (الانتقال من شكل بيولوجي أكثر تعقيداً إلى شكل أبسط)",
 "retrogressive": "اِنْحِدَارِيّ, تَرَاجُعِيّ (يتحوّل من الأفضل إلى الأسوأ)",
 "retromandibular vein": "وريد خلف الفك السفلي (الفرع الخلفي للوريد الوجهي؛ يتكون من الأوردة الصدغية أمام الأذن)",
 "retronym": "تسمية استدراكية, مصطلح رجعي (كلمة تم تقديمها لأن المصطلح الحالي أصبح غير كافٍ)\nمثال: لم يسمع أحد عن 'الساعات التناظرية' حتى أصبحت الساعات الرقمية شائعة، لذا فإن 'ساعة تناظرية' هي مصطلح رجعي",
 "retrorocket": "صاروخ عكسي, صاروخ كابح (محرك صاروخي صغير على صاروخ أكبر أو مركبة فضائية يتم إطلاقه لإبطاء أو تغيير مسارها)",
 "retrorse": "مُتَّجِه لِلْخَلْف (منحني أو مقوس للخلف أو للأسفل)\nمثال: أوراق ذات أشواك متجهة للخلف",
 "retrospect": "استرجاع, نظرة إلى الوراء (تأمل الأشياء الماضية)\nمثال: في نظرة إلى الوراء",
 "retrospection": "استرجاع الماضي, تذكر (ذاكرة للتجارب التي مضت) / استذكار, استرجاع (الإشارة إلى أشياء من الماضي)\nمثال: حاول بعض علماء النفس التباين بين استرجاع الماضي والاستبطان",
 "retrospective": "متعلِّق بالماضي, رَجْعِيّ",
 "retrospectively": "بأثر رجعي, بنظرة استرجاعية (بطريقة تتأمل أحداث الماضي)\nمثال: بنظرة استرجاعية، يبدو كفنان عظيم",
 "retrousse": "أَفْطَس, مَرْفُوع الطَّرَف ((عن الأنوف) مرفوع الطرف إلى أعلى)",
 "retroversion": "ارتداد, تراجع (العودة إلى حالة سابقة) / إعادة الترجمة, ترجمة عكسية (الترجمة مرة أخرى إلى اللغة الأصلية) / انثناء للخلف, انقلاب للخلف (دوران أو إمالة عضو أو جزء من الجسم للخلف)\nمثال: ترجم المعلم النصوص اللاتينية إلى الإنجليزية وأعطاها لطلابه لإعادة ترجمتها للأصل",
 "retrovir": "ريتروفير, زيدوفودين (دواء مضاد للفيروسات (الاسم التجاري ريتروفير) يستخدم في علاج الإيدز؛ تشمل آثاره الجانبية تلف الكبد وقمع نقي العظم)",
