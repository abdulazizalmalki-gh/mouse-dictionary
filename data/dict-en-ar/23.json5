 "ridge tile": "قرميد القمة (بلاط زخرفي منحني في المقطع العرضي؛ يستخدم لتغطية قمة السقف)",
 "ridged": "جؤجؤي, عرفي (لديه حافة أو على شكل حافة أو يوحي بقرينة السفينة)\nمثال: سبلة عرفية",
 "ridgel": "حصان خفي الخصية (مهر بخصيتين غير نازلتين)",
 "ridgeline": "خط التلال (سلسلة طويلة وضيقة من التلال)",
 "ridgeling": "حصان خفي الخصية (مهر بخصيتين غير نازلتين)",
 "ridgepole": "عارضة القمة, قمة السقف (عارضة موضوعة على طول الحافة حيث يلتقي جانبان مائلان للسقف في الأعلى؛ توفر مرفقاً للنهايات العليا للعوارض الخشبية)",
 "ridgil": "حصان خفي الخصية (مهر بخصيتين غير نازلتين)",
 "ridgling": "حصان خفي الخصية (مهر بخصيتين غير نازلتين)",
 "ridicule": "تَهَكَّمَ, سَخِرَ (تَهَكَّمَ بِزمِيلِهِ أمَامَ النَّاسِ: اِسْتَهْزَأَ بِهِ، سَخِرَ مِنْهُ، زَرَى عَلَيْهِ، عَبَثَ بِهِ. تَهَكَّمَ صَاحِبَهُ)",
 "ridiculer": "ساخر, متهكم (فكاهي يستخدم السخرية والتهكم والغمز لانتقاد الرذائل أو الحماقات)",
 "ridiculous": "سَخِيف, مَسْخَرَة",
 "ridiculously": "بشكل مضحك, بشكل يثير السخرية (بشكل يثير الضحك أو يستحقه)\nمثال: كان دخلها صغيراً بشكل مضحك، لكنها تمكنت من العيش بشكل جيد",
 "ridiculousness": "سَخَافَة, عَبَث (رسالة يتعارض محتواها مع العقل)",
 "riding": "ركوب الخيل (السفر محمولاً على ظهر الخيل) / ركوب الخيل, فروسية (رياضة الجلوس على ظهر الحصان مع التحكم في تحركاته)",
 "riding bitt": "مربط الحبال الرئيسي (واحد من المرابط الكبيرة المستخدمة لتأمين كابل المرساة الملقاة)",
 "riding boot": "حذاء ركوب الخيل (حذاء بدون أربطة يرتدى لركوب الخيل؛ جزء من زي الركوب)",
 "riding breeches": "بنطال ركوب الخيل, جودبور ((تستخدم بصيغة الجمع) سراويل واسعة تنتهي عند الساق؛ تلبس مع أحذية الركوب)",
 "riding crop": "سوط الركوب, سوط الصيد (سوط قصير بجلد في نهايته ومقبض لفتح البوابات)",
 "riding habit": "بدلة ركوب الخيل (الملابس التي يرتديها عادة راكب الخيل (وخاصة زي المرأة))",
 "riding horse": "حصان ركوب (حصان خفيف الوزن يُربى للركوب فقط)",
 "riding lamp": "ضوء المرساة (ضوء في تجهيزات السفينة التي ترسو)",
 "riding light": "ضوء المرساة (ضوء في تجهيزات السفينة التي ترسو)",
 "riding master": "مدرب ركوب الخيل (شخص يعلم الفروسية)",
 "riding mower": "جزازة ركوب (جزازة آلية يمكنك ركوبها)",
 "riding school": "مدرسة ركوب الخيل (مدرسة يتم فيها تعليم وممارسة الفروسية)",
 "ridley": "سلحفاة ريدلي (سلحفاة بحرية)",
 "riel": "رييل (وحدة المال الأساسية في كمبوديا؛ تساوي 100 سن)",
 "riemannian": "ريماني (من أو يتعلق بهندسة ريمان غير الإقليدية)",
 "riemannian geometry": "هندسة إهليلجية, هندسة ريمانية ((رياضيات) هندسة لا إقليدية تعتبر الفضاء مثل كرة والخط مثل دائرة عظمى)",
 "riesling": "ريسلينغ (نبيذ أبيض جاف عطري أو حلو من وادي الراين أو نبيذ مماثل من كاليفورنيا) / ريسلينغ (عنب أبيض يزرع في أوروبا وكاليفورنيا)",
 "rifadin": "ريفادين, ريفامبين (دواء مضاد للبكتيريا (الأسماء التجارية ريفادين وغيرها) يستخدم لعلاج السل)",
 "rifampin": "ريفادين, ريفامبين (دواء مضاد للبكتيريا (الأسماء التجارية ريفادين وغيرها) يستخدم لعلاج السل)",
 "rife": "مُفْرِط الوَفْرَة (وافر بشكل مفرط) / سَائِد, غَالِب (الأَكْثَر شُيُوعًا أَوْ تَكْرَارًا)",
 "riff": "جملة متكررة, ريف (أوستيناتو الجاز؛ عادة ما يوفر خلفية لارتجال منفرد) / رِيفِيّ (أمازيغي يعيش في شمال المغرب (منطقة الريف))",
 "riffian": "رِيفِيّ (أمازيغي يعيش في شمال المغرب (منطقة الريف))",
 "riffle": "خلط تفريقي, خلط سريع (خلط الأوراق بقسم الرزمة وتداخل النصفين عند الزوايا) / تموج صغير, مويجة (موجة صغيرة على سطح سائل)",
 "riffraff": "رَعَاع",
 "rifle": "بُنْدُقِيَّة (أنبوب لاطلاق الرصاص، وتعتبر من الأسلحة؛ الْبُنْدُقِيََة: فِي إِيطَالْيَا)\nمثال: البندقية مدينة جميلة.",
 "rifle ball": "رصاصة بندقية (رصاصة مصممة لتطلق من بندقية؛ لم تعد تصنع كروية الشكل)",
 "rifle butt": "أخمص البندقية, كعب البندقية (الطرف الغليظ (الكعب) للبندقية)",
 "rifle grenade": "قنبلة بندقية (قنبلة يدوية تُرمى من جهاز إطلاق مثبت بماسورة بندقية)",
 "rifle range": "ميدان البنادق (ميدان حيث يمكن للناس التدرب على إطلاق النار بالبنادق) / مدى البندقية (المسافة التي تصل إليها رصاصة البندقية)\nمثال: أثناء الحرب حولوا صالات البولينغ إلى ميادين للبنادق",
 "rifle shot": "مدى البندقية (المسافة التي تصل إليها رصاصة البندقية)\nمثال: كان الهدف خارج مدى البندقية",
 "riflebird": "طائر البندقية (طائر الجنة الأسترالي أسود مخملي مع تقزح لوني أخضر وأرجواني على الرأس والذيل)",
 "rifled": "محلزن (للسبطانة), مششخن ((للسلاح الناري) يحتوي على ششخنة أو أخاديد لولبية داخل السبطانة)",
 "rifleman": "جندي بندقية, رامٍ (جندي ذكر سلاحه بندقية) / رامي بندقية (رجل ماهر في استخدام البندقية)",
 "rifleman bird": "طائر البندقية (طائر صغير أخضر وبرونزي)",
 "rifler": "رامي بندقية (جندي سلاحه البندقية) / رامي بندقية (شخص ماهر في استخدام البندقية)",
 "riflewoman": "رامية بندقية (جندية أنثى سلاحها البندقية) / رامية بندقية (امرأة ماهرة في استخدام البندقية)",
 "rifling": "تحزيز, ششخانة (قطع أخاديد حلزونية داخل ماسورة سلاح ناري)",
 "rift": "انشقاق, صدع (انفصال شخصي أو اجتماعي (كما بين الفصائل المتعارضة)) / شق صخري, صدع (شق ضيق في الصخر) / انفراج, فجوة (فجوة بين كتل السحب)\nمثال: كانوا يأملون في تجنب قطيعة في العلاقات",
 "rift valley": "وادي متصدع (وادٍ ذو جوانب شديدة الانحدار؛ تشكل بواسطة صدع في قشرة الأرض)",
 "rift valley fever": "حمى الوادي المتصدع (عدوى شائعة في أفريقيا يسببها فيروس بونيا)",
 "rig": "احتيال, غبن (فعل النصب بواسطة مخطط احتيالي) / عربة خيول (مركبة بعجلات يجرها حصان واحد أو أكثر) / معدات صيد الأسماك (معدات تستخدم في صيد الأسماك) / طقم ملابس, هندام (مجموعة متناسقة من الملابس (مع الإكسسوارات))\nمثال: هذا الكتاب خدعة",
 "riga": "رِيغَا, رِيجَا",
 "rigamarole": "إجراءات معقدة, روتين عقيم (إجراء طويل ومعقد ومربك) / كَلَام طَوِيل وَمُمِلّ, لَغْو (مجموعة من البيانات المربكة والتي لا معنى لها)\nمثال: كل ذلك الروتين الأكاديمي كان مضيعة للوقت",
 "rigatoni": "ريجاتوني (مكرونة أنبوبية في قطع قصيرة مضلعة)",
 "rigged": "مُزَوَّر, مُزَيَّف",
 "rigger": "فرشاة رسم رفيعة (فرشاة سمور مدببة رفيعة طويلة يستخدمها الفنانون) / سفينة مجهزة (سفينة شراعية بتجهيز محدد) / عامل تجهيز, مجهز سفن (شخص يجهز السفن (بالحبال والصواري)) / عامل منصة نفط (شخص يعمل في منصة نفط)\nمثال: سفينة مربعة الأشرعة",
 "rigger brush": "فرشاة رسم رفيعة (فرشاة سمور مدببة رفيعة طويلة يستخدمها الفنانون)",
 "rigging": "تَجْهِيزَات السَّفِينَة, صَوَارِي وَشِرَاع (تشكيل الصواري والعوارض والأشرعة وغيرها على السفينة) / تجهيزات الصاري, حبال السفينة (معدات تتكون من حبال وما إلى ذلك تدعم سواري السفينة وأشرعتها)",
 "riggs' disease": "تقيح اللثة, مرض ريغز (التهاب دواعم السن المزمن؛ التهاب قيحي في تجاويف الأسنان)",
 "right": "يَمِين, يمين / صَحِيح, صَوَاب / قَائِم / عَلَى اَلْيَمِين (يفيد الاستعلاء؛ يفيد التعليل) / إِلَى اَلْيَمِين (حرف جر يُفيد الغاية الزمنية؛ حرف جر يُفيد الغاية المكانية) / صحيح, تمام / حَقّ, حُقُوق (اسم من الأسماء الحسنى وهو من صفات الله. لا جمع له؛ ضد البَاطِل، العَدْل والحَقِيْقَة والوُجُوْد الثَابِت والصِدْق والذي لا جدال فيه. لا جمع له) / صَحَّحَ (جعل الشيء صحيحًا أو خاليًا من الأخطاء؛ أظهر صحة معلومة أو حقيقة)\nمثال: أجب على السؤال.",
 "right along": "طوال الوقت, منذ البداية (طوال الوقت أو خلال فترة من الزمن)\nمثال: كانت تعرف طوال الوقت",
 "right angle": "زَاوِيَة قَائِمَة",
 "right ascension": "مُطَّلَعً مُسْتَقِيم",
 "right atrioventricular valve": "صمام ثلاثي الشرف (صمام ذو ثلاث شرفات؛ يقع بين الأذين الأيمن والبطين الأيمن؛ يسمح للدم بالمرور من الأذين إلى البطين ويغلق لمنع التدفق العكسي عند انقباض البطين)",
 "right atrium": "أذين أيمن (الحجرة العلوية اليمنى للقلب التي تتلقى الدم من الأوردة الجوفاء والجيب التاجي)",
 "right atrium of the heart": "أذين أيمن (الحجرة العلوية اليمنى للقلب التي تتلقى الدم من الأوردة الجوفاء والجيب التاجي)",
 "right away": "فَوْرًا, حَالًا",
 "right brain": "الدماغ الأيمن, نصف الكرة الأيمن (نصف الكرة المخية إلى يمين الجسم الثفني الذي يتحكم في النصف الأيسر من الجسم)",
 "right coronary artery": "شريان تاجي أيمن (ينشأ من الجيب الأبهري الأيمن؛ يغذي الجانب الأيمن من القلب)",
 "right field": "الحقل الأيمن (مركز اللعب للاعب في فريق البيسبول المتوقع منه التقاط الكرات في الثلث الأيمن من الملعب الخارجي) / يمين الملعب (قطعة الأرض في المنطقة الخارجية على يمين الماسك)",
 "right fielder": "لاعب الدفاع الأيمن (الشخص الذي يلعب في الجانب الأيمن من الملعب الخارجي)",
 "right gastric artery": "شريان معدي أيمن (فرع من الشريان الكبدي يغذي الجزء البوابي من المعدة عند الانحناء الصغير)",
 "right gastric vein": "وريد بوابي, وريد معدي أيمن (يتلقى أوردة من الأسطح العلوية للمعدة ويصب في الوريد البابي)",
 "right hand": "يَمِين, يُمْنَى",
 "right hander": "أيمن, مستخدم اليد اليمنى (شخص يستخدم يده اليمنى بمهارة أكبر من اليسرى)",
 "right hemisphere": "الدماغ الأيمن, نصف الكرة الأيمن (نصف الكرة المخية إلى يمين الجسم الثفني الذي يتحكم في النصف الأيسر من الجسم)",
 "right of action": "حق التقاضي, حق رفع الدعوى (الحق القانوني في رفع دعوى قضائية)",
 "right of asylum": "حَقُّ اللُّجُوءِ (اسم من الأسماء الحسنى وهو من صفات الله. لا جمع له؛ ضد البَاطِل، العَدْل والحَقِيْقَة والوُجُوْد الثَابِت والصِدْق والذي لا جدال فيه. لا جمع له)\nمثال: الأستاذ على حق.",
 "right of election": "حق الخيار (في قانون الوصايا: الحق القانوني للزوج الباقي على قيد الحياة في اختيار أخذ ما أعطاه الزوج المتوفى بموجب الوصية أو حصة التركة كما هو محدد في القانون)",
 "right of entry": "حق الدخول (الحق القانوني في حيازة العقارات بطريقة سلمية)",
 "right of first publication": "حق المؤلف, حقوق النشر (وثيقة تمنح حقاً حصرياً لنشر وبيع عمل أدبي أو موسيقي أو فني)",
 "right of offset": "حق المقاصة ((في المصارف) الحق القانوني للبنك في الاستيلاء على الأموال المودعة لتغطية قرض متعثر)",
 "right of privacy": "حق الخصوصية (حق قانوني في أن يُترك الشخص وشأنه؛ الحق في العيش بعيدًا عن الدعاية غير المبررة)",
 "right of re-entry": "حق استعادة الحيازة (الحق القانوني في استئناف الحيازة (حق تم الاحتفاظ به عند التخلي عن حيازة سابقة))",
 "right of search": "حق التفتيش (حق المحارب في إيقاف السفن المحايدة في أعالي البحار في وقت الحرب وتفتيشها)",
 "right of way": "حرم الطريق, حق المرور (الممر المكون من مسار أو شريط من الأرض يملك شخص ما الحق القانوني في المرور عبره) / أولوية المرور, حق الأولوية (حق مركبة أو سفينة في أن تكون لها الأسبقية على أخرى) / حق المرور (امتياز شخص ما في المرور عبر أرض تخص شخصًا آخر)",
 "right on": "تماماً, صحيح (تعبير عن الموافقة؛ نعم أنت محق بالفعل)",
 "right prism": "منشور قائم (منشور له قاعدتان بالضبط وجوانبه الأخرى كلها مستطيلات عمودية على هاتين القاعدتين)\nمثال: المساحة الجانبية للمنشور القائم هي مجموع مساحات جميع الأوجه الجانبية",
 "right smart": "بكثير, جداً (بدرجة كبيرة أو بمسافة كبيرة؛ كثيراً جداً) / لَا بَأْسَ بِه ((لَهْجَة جَنُوبِيَّة أَوْ وُسْطَى) مُعْتَبَر)\nمثال: تجاوز الميزانية بكثير",
 "right stage": "يمين المسرح (جزء المسرح الواقع على يمين الممثل عندما يواجه الجمهور)",
 "right to an attorney": "الحق في توكيل محام (حق مدني يتطلب من الحكومة تعيين محام للمدعى عليه أو دفع أتعابه القانونية في حال لم يستطع تحمل تكاليف محام)",
 "right to candidacy": "حق الترشح (الحق القانوني في الترشح للانتخابات)",
 "right to confront accusers": "حق مواجهة الخصوم (حق يكفله القانون للمتهم بمواجهة من يتهمه)",
 "right to due process": "حق الإجراءات القانونية الواجبة (حق يكفله الدستور لضمان العدالة في الإجراءات القانونية)",
 "right to liberty": "حق الحرية (الحق في أن تكون حرًا)",
 "right to life": "حق الحياة (الحق في العيش)",
 "right to privacy": "حق الخصوصية (الحق في التحرر من التدخل غير المصرح به)",
 "right to speedy and public trial by jury": "الحق في محاكمة سريعة وعلنية (حق مدني يتطلب من الحكومة توفير محاكمة سريعة وعلنية للمتهم وتوفير هيئة محلفين محايدة)",
 "right to the pursuit of happiness": "حق السعي وراء السعادة (الحق في محاولة العثور على السعادة)",
 "right to vote": "اقتراع, حق الانتخاب (حق قانوني يكفل التصويت في الانتخابات)\nمثال: حصلت النساء الأمريكيات على حق التصويت في عام 1920",
 "right triangle": "مثلث قائم الزاوية (مثلث به زاوية قائمة واحدة)",
 "right ventricle": "بطين أيمن (الحجرة على الجانب الأيمن من القلب التي تتلقى الدم الوريدي من الأذين الأيمن وتضخه في الجذع الرئوي)",
 "right whale": "حوت صائب (حوت باليني قطبي كبير؛ سُمي بالحوت 'الصائب' (المناسب) للصيد بسبب عظامه وزيته الثمين)",
 "right wing": "الجناح اليميني, اليمين (أولئك الذين يدعمون المحافظة السياسية أو الاجتماعية أو الاقتصادية؛ أولئك الذين يعتقدون أن الأمور أفضل إذا تركت دون تغيير)",
 "right-angled": "قَائِمُ الزَّاوِيَة (يُشكِّل زاوية قائمة أو يحتوي على زاوية قائمة أو أكثر)",
 "right-angled triangle": "مثلث قائم الزاوية (مثلث به زاوية قائمة واحدة)",
 "right-down": "تماماً, كلياً (بشكل إيجابي أو كامل) / صِرْف, مَحْض (تامّ بلا تحفّظ أو تقييد؛ يُستخدم أحيانًا مُكثِّفًا غير رسميّ)\nمثال: شخص سيء تماماً",
 "right-eyed": "أَيْمَن العَيْن (ليس له إلا العين اليمنى)",
 "right-hand": "يَدٌ يُمْنى (الأكْثَر عَوْنًا وَمَوْثوقِيَّة)",
 "right-hand man": "مساعد أيمن (المساعد الذكر الأكثر فائدة)",
 "right-hand woman": "مساعدة أيمن (المساعدة الأنثى الأكثر فائدة)",
 "right-handed": "أَيْمَن (صفة لما كان يقع على جهة اليمين؛ ضد أَيْسَر؛ صفة لمن كان كثير اليُمن والبركة)\nمثال: لدى توم وشم في ذراعه الأيمن.",
 "right-handed pitcher": "رامٍ أيمن ((في البيسبول) رامٍ يرمي الكرة باليد اليمنى)",
 "right-handedness": "أيمنية, تيامن (تفضيل استخدام اليد اليمنى)",
 "right-hander": "رامٍ أيمن ((في البيسبول) رامٍ يرمي الكرة باليد اليمنى) / أيمن, مستخدم اليد اليمنى (شخص يستخدم يده اليمنى بمهارة أكبر من اليسرى)",
