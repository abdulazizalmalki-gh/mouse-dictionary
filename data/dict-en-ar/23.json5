 "rat typhus": "تيفوس الفئران, تيفوس متوطن (عدوى حادة تسببها الريكتسيا وتنتقل عن طريق لدغة برغوث مصاب؛ تتميز بالحمى والقشعريرة وآلام العضلات والطفح الجلدي)",
 "rat's-tail cactus": "صبار ذيل الجرذ (صبار استوائي أمريكي يزرع عادة وله سيقان زاحفة نحيلة وأزهار قرمزية مبهرجة كبيرة جداً تتفتح لعدة أيام)",
 "rat-a-tat": "طقطقة, نقر متكرر (سلسلة من النقرات القصيرة الحادة (كما تصدر عن ضربات على الطبل أو طرق على الباب))",
 "rat-a-tat-tat": "طقطقة, نقر متكرر (سلسلة من النقرات القصيرة الحادة (كما تصدر عن ضربات على الطبل أو طرق على الباب))",
 "rat-catcher": "صائد الجرذان, مكافح القوارض (عامل يعمل لتدمير أو طرد الهوام والقوارض)",
 "rat-tail file": "مبرد ذيل الفأر, مبرد مستدير (مبرد دائري رفيع على شكل ذيل الفأر)",
 "rat-tat": "طقطقة, نقر متكرر (سلسلة من النقرات القصيرة الحادة (كما تصدر عن ضربات على الطبل أو طرق على الباب))",
 "ratability": "قَابِلِيَّة التَّقْدِير, قَابِلِيَّة التَّقْيِيم (صفة كون الشيء قابلاً للتقييم أو التقدير) / قابلية التقييم (حالة الخضوع للتقييم أو الضرائب)",
 "ratable": "خَاضِعٌ لِلضَّرَائِبِ المَحَلِّيَّة (مُلْزَمٌ بِدَفْعِ ضَرَائِبِ المُمْتَلَكَاتِ المُقَدَّرَةِ مَحَلِّيًّا)",
 "ratables": "ممتلكات خاضعة للضريبة (الممتلكات التي توفر دخلاً ضريبياً للحكومات المحلية)",
 "ratafee": "راتافيا (ليكير حلو مصنوع من النبيذ والبراندي المنكه بنواة البرقوق أو الخوخ أو المشمش واللوز المر)",
 "ratafia": "راتافيا (ماكارون بنكهة لكيور الراتافيا) / راتافيا (ليكير حلو مصنوع من النبيذ والبراندي المنكه بنواة البرقوق أو الخوخ أو المشمش واللوز المر)",
 "ratafia biscuit": "راتافيا (ماكارون بنكهة لكيور الراتافيا)",
 "ratan": "خيزران (عصا مصنوعة من سيقان نخيل الروطان)",
 "rataplan": "قرع الطبل (الصوت الناتج عن ضرب الطبل)",
 "ratatouille": "راتاتوي (يخنة خضروات؛ تُصنع عادة من الطماطم والباذنجان والكوسا والفلفل والبصل والتوابل)",
 "ratbite fever": "حمى عضة الجرذ (أحد مرضين معديين ينتقلان إلى البشر عن طريق عضة جرذ أو فأر؛ يتميز بالحمى والصداع والغثيان والطفح الجلدي)",
 "ratbite fever bacterium": "بكتيريا حمى عضة الجرذ, لولبية صغرى (بكتيريا تسبب حمى عضة الجرذ)",
 "ratch": "سقاطة (جهاز ميكانيكي يتكون من عجلة مسننة أو رف متشابك مع لسان يسمح له بالتحرك في اتجاه واحد فقط)",
 "ratchet": "سقاطة (جهاز ميكانيكي يتكون من عجلة مسننة أو رف متشابك مع لسان يسمح له بالتحرك في اتجاه واحد فقط)",
 "ratchet screwdriver": "مفك سقاطة حلزوني (مفك براغي بسقاطة (بحيث يدور النصل في اتجاه واحد فقط) وحلزون في المقبض (بحيث يدور النصل) مع الضغط لأسفل على المقبض)",
 "ratchet wheel": "عجلة السقاطة (عجلة مسننة تثبت في مكانها بواسطة سقاطة وتدار بواسطة رافعة)",
 "rate": "مُعَدَّل (هو الأمر الذي جرى عليه تَعْدِيل فهو أفضل من ما يناظره؛ السيارة المعدّلة تسير بسرعة أكبر من مثيلاتها) / سِعْر (سَعِرَ يَسْعَرَ سَعَراً، وسُعْرَةً: ضرب لونه إِلى السواد فُوَيْقَ الأُدْمة؛ فهو أَسْعَرُ، وهي سَعْراءُ. والجمع: سُعْرٌ)\nمثال: انخفض معدل الجريمة.",
 "rate of attrition": "مُعَدَّل التَّنَاقُص, مُعَدَّل الِاسْتِنْزَاف (معدل الانكماش في الحجم أو العدد)",
 "rate of depreciation": "معدل الإهلاك (المعدل الذي تنخفض به قيمة الممتلكات؛ يُستخدم لحساب الخصم الضريبي)",
 "rate of exchange": "سعر الصرف (الرسم لتبادل عملة دولة بعملة دولة أخرى)",
 "rate of flow": "تَدَفُّق, مُعَدَّل التَّدَفُّق (كمية السائل التي تتدفق في وقت معين)",
 "rate of growth": "مُعَدَّل النُّمُوّ (معدل الزيادة في الحجم لكل وحدة زمنية)",
 "rate of inflation": "مُعَدَّل التَّضَخُّم (معدل تغير الأسعار (كما يشير إليه مؤشر الأسعار) محسوباً على أساس شهري أو سنوي)",
 "rate of interest": "سعر الفائدة, معدل الفائدة (النسبة المئوية لمبلغ من المال المفروضة لاستخدامه)",
 "rate of pay": "معدل الأجر (مبلغ المال المستلم لكل وحدة زمنية)\nمثال: معدل أجور النساء أقل من الرجال",
 "rate of payment": "معدل الدفع, معدل السداد (مبلغ المال المدفوع لكل وحدة زمنية)",
 "rate of respiration": "مُعَدَّل التَّنَفُّس (المعدل الذي يشهق ويزفر به الشخص؛ يقاس عادة للحصول على تقييم سريع لصحة الشخص)",
 "rate of return": "مُعَدَّل العَائِد (المبلغ المُعاد لكل وحدة زمنية معبراً عنه كنسبة مئوية من التكلفة)",
 "rateability": "قابلية التقييم (حالة الخضوع للتقييم أو الضرائب)",
 "rateable": "خَاضِعٌ لِلضَّرَائِبِ المَحَلِّيَّة (مُلْزَمٌ بِدَفْعِ ضَرَائِبِ المُمْتَلَكَاتِ المُقَدَّرَةِ مَحَلِّيًّا)",
 "rateables": "ممتلكات خاضعة للضريبة (الممتلكات التي توفر دخلاً ضريبياً للحكومات المحلية)",
 "rated voltage": "جهد مقنن (أقصى جهد يمكن للقاطع الكهربائي قطعه بأمان ودون التعرض للتلف بسبب القوس الكهربائي المفرط)",
 "ratel": "غرير العسل (لاحم ليلي يشبه الغرير من المناطق المشجرة في أفريقيا وجنوب آسيا)",
 "ratepayer": "دافع الرسوم المحلية (شخص يدفع الرسوم المحلية (خاصة صاحب المنزل))",
 "rates": "ضريبة محلية, عوائد (ضريبة محلية على الممتلكات)",
 "rather": "بِالْأَحْرَى",
 "rather than": "بَدَلًا مِن / أَكْثَر مِن, عَنّ",
 "rathole": "جحر, غرفة قذرة (غرفة صغيرة قذرة وغير مريحة) / جحر جرذ (حفرة (كما في جدار مبنى) صنعتها الجرذان)",
 "rathskeller": "راثسكيلر, قبو البيرة (حانة تحت مستوى الشارع تقدم البيرة؛ أصلاً مطعم ألماني في قبو مبنى البلدية)",
 "ratibida columnaris": "قبعة مكسيكية (زهرة الصنوبرية برأس زهرة يشبه القبعة المكسيكية بقرص أحمر بني طويل وأشعة متدلية صفراء أو صفراء وحمراء بنية؛ تنمو في السهول الكبرى على طول قاعدة جبال…)",
 "ratibida columnifera": "زهرة الصنوبرية طويلة الرأس, زهرة صنوبرية البراري (نبات يشبه زهرة القبعة المكسيكية؛ من كولومبيا البريطانية إلى نيو مكسيكو)",
 "ratibida tagetes": "زهرة صنوبرية البراري (زهرة صنوبرية من وسط إلى جنوب غرب الولايات المتحدة)",
 "ratification": "إبرام, تصديق (جعل الشيء ساري المفعول عن طريق التصديق عليه أو تأكيده رسميًا)\nمثال: المصادقة على المعاهدة",
 "ratified": "مُصَدَّق, مُقَرّ (تَمَّت المُوافَقَة عَلَيْهِ رَسْمِيًّا أَوْ المُصادَقَة عَلَيْه)",
 "ratifier": "مؤيد, مصادق (شخص يعبر عن موافقة قوية)",
 "rating": "تقدير, تقييم (فعل التأكد من أو تحديد قيمة أو جدوى شيء ما) / تثمين, تقدير (تقدير لقيمة شيء ما) / تصنيف, تقييم (المكانة أو الموقع على مقياس) / رتبة عسكرية (الرتبة في منظمة عسكرية)\nمثال: وضع تقييماً عالياً للصداقة",
 "rating system": "نظام تسجيل, نظام تقييم (نظام للتصنيف وفقاً للجودة أو الجدارة أو الكمية)",
 "ratio": "نِسْبَة (مصدر للفعل \"نَسَبَ\"؛ (في النحو) صفة أُضيفت إليها يَاءُ النَّسَبِ، غرضها نسب المنسوب إلى المنسوب إليه)\nمثال: بالنسبة لي، إنه مهم.",
 "ratio analysis": "تحليل النسب (أسلوب مهم في التحليل المالي يتم فيه تحويل الكميات إلى نسب لإجراء مقارنات ذات مغزى)\nمثال: عندما يتحدث المستشار المالي إليك عن مدفوعات سيارتك ومنزلك، قد يستخدم تحليل النسب",
 "ratiocination": "استدلال منطقي (تفكير منطقي ومنهجي) / استنتاج, نتيجة (القضية التي تم التوصل إليها عن طريق التفكير المنطقي (مثل القضية التي يجب أن تتبع المقدمات الكبرى والصغرى للقياس المنطقي))",
 "ratiocinative": "اِسْتِنْبَاطِيّ (مَبْنِيّ عَلى التَّفْكير الدَّقيق وَالمُحاكَمَة العَقْلِيَّة)",
 "ratiocinator": "مجادل منطقي, مستدل (شخص يستدل منطقياً)",
 "ration": "حِصَّة / قَنَّنَ (قلل الكمية واقتصد بها؛ وضع الشيء في قَنَانِي)",
 "ration card": "بطاقة تموين (بطاقة تثبت حق حاملها في شراء السلع المقننة)",
 "rational": "عَقْلَانِيّ",
 "rational motive": "دافع عقلاني, دافع منطقي (دافع يمكن تبريره بالمنطق أو الحجة العقلانية)",
 "rational number": "عَدَد كَسْرِيّ, عَدَد نِسْبِيّ (عدد صحيح أو كسر)",
 "rationale": "أساس منطقي, مبدأ ((قانون) شرح للأسباب الأساسية (خاصة شرح عمل جهاز ما من حيث قوانين الطبيعة))\nمثال: الأساس المنطقي لعقوبة الإعدام",
 "rationalisation": "ترشيد, منهجة (تنظيم منهجي؛ فعل تنظيم شيء ما وفقاً لنظام أو منطق) / ترشيد, عقلنة (تنظيم العمل التجاري وفقاً لمبادئ الإدارة العلمية لزيادة الكفاءة) / إنطاق ((رياضيات) تبسيط تعبير أو معادلة عن طريق إزالة الجذور دون تغيير قيمة التعبير أو جذور المعادلة) / تبرير, عقلنة (العملية المعرفية لجعل شيء ما يبدو متسقاً مع العقل أو قائماً عليه)",
 "rationalism": "عَقْلَانِيَّة / عَقْلِيَّة",
 "rationalist": "عَقْلَانِيّ",
 "rationalistic": "عقلاني (مكون من أو متعلق بالمذهب الفلسفي للعقلانية)",
 "rationality": "عَقْلَانِيَّة (صفة الاتساق مع المنطق أو الاستناد إليه) / رجاحة عقل, عقلانية (حالة امتلاك الحس السليم والحكم الصائب)\nمثال: ربما تكون عقلانيته قد تضررت",
 "rationalization": "ترشيد, منهجة (تنظيم منهجي؛ فعل تنظيم شيء ما وفقاً لنظام أو منطق) / ترشيد, عقلنة (تنظيم العمل التجاري وفقاً لمبادئ الإدارة العلمية لزيادة الكفاءة) / إنطاق ((رياضيات) تبسيط تعبير أو معادلة عن طريق إزالة الجذور دون تغيير قيمة التعبير أو جذور المعادلة) / تبرير, عقلنة (العملية المعرفية لجعل شيء ما يبدو متسقاً مع العقل أو قائماً عليه)",
 "rationally": "بعقلانية (بطريقة عقلانية)\nمثال: يجب أن نتصرف بعقلانية",
 "rationalness": "عَقْلَانِيَّة (صفة الاتساق مع المنطق أو الاستناد إليه)",
 "rationed": "مُحَصَّص, مُقَنَّن (مُوَزَّعٌ بِالتَّسَاوِي فِي حِصَصٍ فَرْدِيَّةٍ مَحْدُودَةٍ)",
 "rationing": "تقنين, توزيع بالحصص (فعل التقنين (تحديد حصص))\nمثال: خلال الحرب فرضت الحكومة تقنين الغذاء والبنزين",
 "ratite": "طيور مسطحة الصدر, نعاميات (طيور لا تطير لها عظام صدر مسطحة تفتقر إلى الجؤجؤ لربط عضلات الطيران: النعام، الشبنم، الإيمو، الموا، الريا، الكيوي، طيور الفيل)",
 "ratite bird": "طيور مسطحة الصدر, نعاميات (طيور لا تطير لها عظام صدر مسطحة تفتقر إلى الجؤجؤ لربط عضلات الطيران: النعام، الشبنم، الإيمو، الموا، الريا، الكيوي، طيور الفيل)",
 "ratlike": "جرذي, شبيه بالجرذ (يشبه أو مميز للجرذ)",
 "ratlin": "درجات الحبال, سلم الحبال ((مصطلح بحري) حبل أفقي صغير بين حبال الصاري في السفينة الشراعية؛ يشكل سلماً للصعود إلى الأعلى)",
 "ratline": "درجات الحبال, سلم الحبال ((مصطلح بحري) حبل أفقي صغير بين حبال الصاري في السفينة الشراعية؛ يشكل سلماً للصعود إلى الأعلى)",
 "ratsbane": "ثلاثي أكسيد الزرنيخ, زرنيخ (مسحوق أبيض سام من ثلاثي أكسيد الزرنيخ؛ يستخدم في صناعة الزجاج وكمبيد للآفات (سم الفئران) ومبيد للأعشاب)",
 "rattail": "جرينادير, ذيل الجرذ (سمكة أعماق ذات رأس وجسم كبيرين وذيل طويل مستدق)",
 "rattail cactus": "صبار ذيل الجرذ (صبار استوائي أمريكي يزرع عادة وله سيقان زاحفة نحيلة وأزهار قرمزية مبهرجة كبيرة جداً تتفتح لعدة أيام)",
 "rattail fish": "جرينادير, ذيل الجرذ (سمكة أعماق ذات رأس وجسم كبيرين وذيل طويل مستدق)",
 "rattan": "خيزران (عصا مصنوعة من سيقان نخيل الروطان) / خيزران هندي, روطان (ساق نخيل متسلق مختلف من جنس القلام وأجناس ذات صلة تستخدم لصنع الخوص والأثاث والعصي) / خيزران, رتان (نخيل متسلق من سريلانكا وجنوب الهند يتميز بطول سيقانه الكبير والتي تستخدم لعصي الملقا)",
 "rattan cane": "خيزران هندي, روطان (ساق نخيل متسلق مختلف من جنس القلام وأجناس ذات صلة تستخدم لصنع الخوص والأثاث والعصي)",
 "rattan palm": "خيزران, رتان (نخيل متسلق من سريلانكا وجنوب الهند يتميز بطول سيقانه الكبير والتي تستخدم لعصي الملقا)",
 "ratter": "رات تيريير, كلب صيد الجرذان (أي من سلالات التيريير المتعددة التي طورت لصيد الجرذان) / خَائِن, مُرْتَدّ (شخص غير مخلص يخون أو يتخلى عن قضيته أو دينه أو حزبه السياسي أو صديقه، إلخ)",
 "ratting": "إبلاغ, وشاية (تقديم أدلة تدين شخصاً إلى ضابط القانون (عادة مقابل خدمات))",
 "rattle": "قَعْقَعَ / خُشْخِيشَة, شُخْلِيلَة",
 "rattle weed": "عشبة ذبابة الخيل, نيلة برية (عشبة منتصبة كثيرة التفرع ذات أزهار صفراء زاهية؛ موزعة من ماساتشوستس إلى فلوريدا)",
 "rattle-top": "جذر الثعبان الأسود, كوهوش أسود (نبات البق توت من أمريكا الشمالية يوجد من ماين وأونتاريو إلى ويسكونسن وجنوباً إلى جورجيا)",
 "rattlebox": "جلاجلاء, كروتالاريا",
 "rattlebrained": "طَائِش, مُشَتَّت الذِّهْن (يفتقر إلى الحكمة والتمييز)",
 "rattled": "مُتَوَتِّر, مُرْتَبِك (أُلقِي في حالة من الاضطراب والارتباك المتهيّج)",
 "rattlepated": "طَائِش, مُشَتَّت الذِّهْن (يفتقر إلى الحكمة والتمييز)",
 "rattler": "أفعى جرسية, ذات الجرس (أفعى حفرية ذات قطع قرنية في نهاية الذيل تصدر صوتاً عند اهتزازها) / قطار بضائع, قطار شحن (قطار سكة حديد يتكون من عربات بضائع)",
 "rattlesnake": "أَفْعًى مُجَلْجِلَة",
 "rattlesnake fern": "بوتريشيوم فرجينيا, سرخس الأفعى المجلجلة (سرخس أمريكي تشبه حوافظه البوغية العنقودية خشخيشة الأفعى)",
 "rattlesnake master": "سيد الأفاعي, قرصعنة يوكية الأوراق (قرصعنة معمرة خشنة وشائكة في الولايات المتحدة يُعتقد أنها تعالج لدغة الأفعى الجرسية)",
 "rattlesnake orchid": "أوركيد الأفعى المجلجلة (أي من بساتين الفاكهة المختلفة من جنس فوليدوتا ذات زهور بيضاء إلى بنية عديدة في عناقيد لولبية مكسوة بقنابات منتفخة قليلاً وتشبه ذيل الأفعى المجلجلة)",
 "rattlesnake plantain": "جوديرا, لسان الحمل الأفعواني (أي من عدة بساتين فاكهة صغيرة معتدلة واستوائية ذات أوراق مرقطة أو مخططة وسنابل من زهور بيضاء مصفرة صغيرة في عنقود ملتوي)",
 "rattlesnake root": "جذر الأفعى الجرسية, نابالوس (نبات من جنس نابالوس) / برينانتس, جذر الأفعى الجرسية (عشب في وسط وجنوب أوروبا ذو زهور قرصية أرجوانية)",
 "rattlesnake weed": "عشبة الأفعى المجلجلة (صقور ذو وريدة من الأوراق القاعدية ذات العروق الأرجوانية؛ من كندا إلى شمال جورجيا وكنتاكي)",
 "rattlesnake's master": "سيد الأفاعي, قرصعنة يوكية الأوراق (قرصعنة معمرة خشنة وشائكة في الولايات المتحدة يُعتقد أنها تعالج لدغة الأفعى الجرسية)",
 "rattling": "جداً, حقاً (تستخدم لإعطاء التوكيد) / خَفِيفُ الحَرَكَة, نَشِيط (سريع ومفعم بالطاقة والحيوية) / حشرجة, خشخشة (سلسلة سريعة من الأصوات العالية القصيرة (كما قد تسمع بالسماعة الطبية في بعض أنواع اضطرابات الجهاز التنفسي))\nمثال: كانت موهوبة جداً",
 "rattrap": "مصيدة جرذان (فخ لصيد الجرذان) / مسكن متهالك (سكن قذر متداعي) / مصيدة, ورطة شائكة (وضع صعب ومعقد)",
 "rattus norvegicus": "جرذ بني, جرذ نرويجي (جرذ منزلي شائع؛ آفة خطيرة في جميع أنحاء العالم)",
 "rattus rattus": "جرذ أسود (آفة منزلية شائعة أصلها من آسيا وانتشرت في جميع أنحاء العالم)",
 "ratty": "مَلِيء بِالجِرْذَان (قذر وموبوء بالجرذان) / بَالٍ, رَثّ (تَظْهَرُ عَلَيْهِ عَلَامَاتُ البِلَى وَالتَّلَفِ) / جرذي (مكون من أو مميز للجرذان)",
 "rau-sed": "ريزيربين, سرباسيل (خافض لضغط الدم يتكون من قلويد مستخرج من نبات الراوولفية الثعبانية (الأسماء التجارية سرباسيل وغيرها))",
 "raucous": "حَادّ الصَّوْت, صَاخِب (عَالٍ وخَشِن بِشَكْلٍ مُزْعِج) / صَخَّاب, مُشَاغِب (يُخِلّ بالسلام العام؛ صاخب وخشن)",
 "raucously": "بصخب, بصوت أجش (بصوت خشن أو صاخب) / بشغب, بصخب (بطريقة صاخبة ومشاغبة)\nمثال: رن صوته بصخب",
 "raudixin": "ريزيربين, سرباسيل (خافض لضغط الدم يتكون من قلويد مستخرج من نبات الراوولفية الثعبانية (الأسماء التجارية سرباسيل وغيرها))",
 "rauli beech": "زان راولي (شجرة أخشاب تشيلية كبيرة تنتج خشباً خشناً)",
 "raunch": "ابْتِذَال, سُوقِيَّة (صفة الافتقار إلى الذوق والتهذيب)",
 "raunchy": "مُتَرَبِّب, وَسِخ جِدًّا (مُغطّى بطبقة سميكة من الأوساخ أو السُّخام المتراكم) / خَلِيع, فَاجِر (يوحي بالفجور والانحلال الأخلاقيّ أو يميل إليه) / بَذِيء, فَاحِش (صريح جنسيًّا وخشن في التعبير)",
