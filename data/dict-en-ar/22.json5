 "profiterole": "بروفيترول (معجنات مجوفة صغيرة عادة ما تكون محشوة بالكريمة ومغطاة بالشوكولاتة)",
 "profitless": "بِلَا رِبْح, عَدِيمُ الجَدْوَى (بلا ربح أو مكافأة)",
 "profitlessly": "بلا جدوى, دون نفع (بدون مكسب أو ربح)",
 "profits": "أرباح, صافي الدخل (فائض الإيرادات عن المصروفات في فترة زمنية معينة (بما في ذلك الإهلاك والمصروفات غير النقدية الأخرى)) / أرباح, مكاسب (شيء تم كسبه (خاصة المال))",
 "profligacy": "انحلال, فجور (انغماس منحل في الملذات الحسية) / إسراف, بذخ (سمة الإنفاق بإسراف)",
 "profligate": "فَاسِق, مُسْتَهْتِر (مُتَحَرِّرٌ مِنَ القُيُودِ الأَخْلَاقِيَّةِ وَالأَعْرَاف) / مُبَذِّر, مُسْرِفٌ بِتَهَوُّر (يُبَدِّدُ المَوَارِدَ بِطَيْشٍ وَتَهَوُّر) / مبذر, مسرف (مستهلك مسرف بتهور) / فاسق (رجل منحل في المجتمع الراقي)",
 "profligately": "بإسراف, بفجور (بطريقة منحلة)",
 "profound": "سَحِيق, غَوْر (يَقَعُ فِي عُمْقٍ كَبِيرٍ أَوْ يَمْتَدُّ إِلَيْهِ؛ أَعْمَقُ مِنْ أَنْ يُسْبَرَ) / ثَقِيل, عَمِيق ((عَنِ النَّوْمِ) عَمِيقٌ وَتَامّ) / عَمِيقٌ مِنَ الأَعْمَاق (نَابِعٌ مِنْ أَعْمَاقِ النَّفْس) / بَالِغُ العُمْق, عَمِيقٌ جِدًّا (مِنْ أَشَدِّ دَرَجَاتِ الحِدَّةِ؛ تَامّ)",
 "profoundly": "بشدة, بعمق (إلى عمق كبير نفسياً أو عاطفياً)\nمثال: شعروا بالخسارة بعمق",
 "profoundly deaf": "أَصَمُّ تَمَامًا, أَصَمُّ كَالحَجَرِ (أصم كلياً؛ عاجز عن سماع أي شيء)",
 "profoundness": "عمق, عمق فكري (العمق الفكري، المعرفة النافذة، البصيرة الثاقبة، إلخ) / عُمْق, غور (صفة كون الشيء عميقاً مادياً) / حدة ذهن, عمق (القدرة الفكرية على التعمق في الأفكار) / عمق, عوص (الحكمة التي تتسم بالغموض والصعوبة والعمق)\nمثال: عمق شعوري",
 "profundity": "عمق, عمق فكري (العمق الفكري، المعرفة النافذة، البصيرة الثاقبة، إلخ) / عُمْق, غور (صفة كون الشيء عميقاً مادياً) / حدة ذهن, عمق (القدرة الفكرية على التعمق في الأفكار) / عمق, عوص (الحكمة التي تتسم بالغموض والصعوبة والعمق)\nمثال: عمق شعوري",
 "profuse": "زَاخِر, فَيَّاض (يُنتَج أو ينمو بوَفْرة بالغة)",
 "profusely": "بغزارة, بوفرة (بطريقة وفيرة)\nمثال: تم تزويدهم بالطعام بوفرة",
 "profuseness": "ثراء, غزارة (خاصية كون الشيء وفيراً للغاية)\nمثال: غزارة التفاصيل",
 "profusion": "ثراء, غزارة (خاصية كون الشيء وفيراً للغاية)\nمثال: غزارة التفاصيل",
 "progenitor": "سَلَف (مضى أو سبق في الزمن؛ تسوية الأرض للمزارعة باستخدام أداة تسمى \"المِسْلَفَة\")",
 "progeny": "نَسْل, سَلِيل",
 "progeria": "شيخوخة مبكرة (شذوذ نادر يتميز بالشيخوخة المبكرة (شيب الشعر وتجاعيد الجلد وانحناء الظهر) لدى الطفل)",
 "progestational": "ما قبل الحمل, مهيئ للحمل (يسبق ويفضل الحمل؛ من أو يتعلق بالتغيرات الفسيولوجية المرتبطة بالإباضة وتكوين الجسم الأصفر) / بروجستيروني (من أو يتعلق بالبروجستيرون (أو بدواء له تأثيرات مشابهة للبروجستيرون))",
 "progesterone": "بروجسترون (هرمون ستيرويدي ينتج في المبيض؛ يجهز ويحافظ على الرحم للحمل)",
 "progestin": "بروجستوجين, بروجستين (أي من مجموعة الهرمونات الستيرويدية التي لها تأثير البروجسترون)",
 "progestogen": "بروجستوجين, بروجستين (أي من مجموعة الهرمونات الستيرويدية التي لها تأثير البروجسترون)",
 "prognathic": "بارز الفك (لديه فك سفلي بارز)",
 "prognathism": "بروز الفك, فقم (حالة بروز الفك نحو الأمام)",
 "prognathous": "أَفْقَم",
 "progne subis": "سنونو أرجواني (سنونو كبير من أمريكا الشمالية يتميز الذكر منه بلون أزرق مسود)",
 "prognosis": "تنبؤ بسير المرض, مآل المرض (التنبؤ بمسار المرض) / تنبؤ, توقعات (تنبؤ حول كيفية تطور شيء ما (مثل الطقس))",
 "prognostic": "اِسْتِشْرَافِيّ, تَنَبُّؤِيّ (متعلّق بالتنبّؤ أو ذو قيمة في إجراء التنبّؤات) / بشير, فأل (علامة على شيء على وشك الحدوث)\nمثال: بحث عن فأل قبل الذهاب إلى المعركة",
 "prognosticate": "أَنْذَرَ",
 "prognostication": "تكهن, نبوءة (معرفة المستقبل (يُقال عادة أنه يتم الحصول عليها من مصدر إلهي)) / تنبؤ, توقع (بيان يصدر حول المستقبل) / بشير, فأل (علامة على شيء على وشك الحدوث)\nمثال: بحث عن فأل قبل الذهاب إلى المعركة",
 "prognosticative": "اِسْتِشْرَافِيّ, تَنَبُّؤِيّ (متعلّق بالتنبّؤ أو ذو قيمة في إجراء التنبّؤات)",
 "prognosticator": "عرّاف, متنبئ (شخص يقوم بتنبؤات للمستقبل (عادة على أساس معرفة خاصة))",
 "program": "بَرْنَامَج (عَرْضٌ (تلْفَزِيٌّ،…)؛ مُفَكَّرَةٌ يَوْمِيَّةٌ) / بَرْمَجَ, وَضَعَ بَرْنَامَجًا / بَرْمَجَ\nمثال: نشط البرنامج الآن.",
 "program library": "مكتبة برمجية ((حوسبة) مجموعة من البرامج والروتينات الفرعية القياسية المخزنة والمتاحة للاستخدام الفوري)",
 "program line": "أمر, تعليمة ((علم الحاسوب) سطر من الكود مكتوب كجزء من برنامج حاسوبي)",
