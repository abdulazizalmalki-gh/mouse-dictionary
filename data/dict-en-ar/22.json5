 "protectorate": "الحِمَايَة",
 "protectorate of bohemia and moravia": "محمية بوهيميا ومورافيا",
 "protectorship": "حماية, وصاية (منصب الحامي أو الوصي)",
 "protege": "محمي, مشمول بالرعاية (شخص يتلقى الدعم والحماية من راعٍ مؤثر يعزز مسيرته المهنية)",
 "protegee": "مشمولة بالرعاية (أنثى مشمولة بالرعاية)",
 "protein": "بْرُوتِين (في جزيئات حيوية ضخمة تتكون من سلسلة أو أكثر من الأحماض الأمينية) / بُرُوتِين (في جزيئات حيوية ضخمة تتكون من سلسلة أو أكثر من الأحماض الأمينية)\nمثال: يحتوي اللحم على البروتين.",
 "protein folding": "طي البروتين (العملية التي يتخذ فيها جزيء البروتين شكله المعقد ثلاثي الأبعاد)\nمثال: فهم طي البروتين هو الخطوة التالية في فك الشفرة الجينية",
 "protein molecule": "جزيء بروتين (أي جزيء كبير يحتوي على سلاسل من الأحماض الأمينية مرتبطة بروابط ببتيدية)",
 "proteinaceous": "بروتيني (متعلق بـ أو ذو طبيعة بروتينية)",
 "proteinase": "بروتياز (أي إنزيم يحفز انقسام البروتينات إلى أجزاء ببتيد أصغر وأحماض أمينية بعملية تعرف بالتحلل البروتيني)",
 "proteinuria": "بيلة ألبومينية, بيلة بروتينية (وجود بروتين مفرط (بشكل رئيسي الألبومين ولكن أيضاً الجلوبيولين) في البول؛ عادة ما يكون عرضاً لاضطراب كلوي)",
 "proteles cristata": "ذئب الأرض, عسبار (ضبع مخطط من جنوب شرق أفريقيا يتغذى بشكل رئيسي على الحشرات)",
 "proteolysis": "تحلل بروتيني (التحلل المائي للبروتينات إلى ببتيدات وأحماض أمينية عن طريق انقسام روابطها الببتيدية)",
 "proteolytic": "محلل للبروتين (من أو يتعلق بالتحلل البروتيني)",
 "proteolytic enzyme": "بروتياز (أي إنزيم يحفز انقسام البروتينات إلى أجزاء ببتيد أصغر وأحماض أمينية بعملية تعرف بالتحلل البروتيني)",
 "proteome": "بروتيوم (المجموعة الكاملة من البروتينات التي ينتجها جينوم معين)",
