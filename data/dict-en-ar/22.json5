 "protea mellifera": "زهرة العسل (شجيرة أسترالية تنتج زهورها العسل بغزارة)",
 "protea repens": "زهرة العسل (شجيرة أسترالية تنتج زهورها العسل بغزارة)",
 "protean": "بُرُوتِيّ, مُتَشَكِّلٌ بِأَشْكَالٍ مُخْتَلِفَة (يَتَّخِذُ أَشْكَالًا مُخْتَلِفَة)",
 "protease": "بروتياز (أي إنزيم يحفز انقسام البروتينات إلى أجزاء ببتيد أصغر وأحماض أمينية بعملية تعرف بالتحلل البروتيني)",
 "protease inhibitor": "مثبط البروتياز (دواء مضاد للفيروسات يستخدم ضد فيروس نقص المناعة البشرية؛ يقطع تكاثر الفيروس عن طريق الارتباط وحجب بروتياز الفيروس؛ غالباً ما يستخدم مع أدوية أخرى)",
 "protect": "حَمَى (حمَى الشيءُ فلانًا: منَعه ودفع عنه؛ حمى المريضَ: منعه ما يضره)\nمثال: ليس لديك أي حمى.",
 "protected": "مَحْمِيّ, مُنْقَذ (مَحْرُوسٌ مِنَ الأَذَى أَوِ الدَّمَار) / محمي, مصون (محفوظ بأمان أو مُدافع عنه ضد الخطر أو الإصابة أو الخسارة)\nمثال: أكثر بقعة محمية استطعت إيجادها",
 "protection": "حِمَايَة",
 "protectionism": "حِمَائِيَّة",
 "protectionist": "حمائي (مدافع عن الحماية التجارية)",
 "protective": "حمائي, واق (مخصص أو مكيف لتوفير نوع من الحماية) / حَمَائِيّ, وَقَائِيّ (يُظهر الحرص والرعاية)\nمثال: غطاء واق",
 "protective coloration": "تلوين وقائي (تلوين يجعل الكائن الحي أقل وضوحاً أو جاذبية للحيوانات المفترسة)",
 "protective cover": "حماية, غطاء واقٍ (غطاء يهدف إلى الحماية من التلف أو الإصابة)\nمثال: لم يكن لديهم حماية من الغبار الذري",
 "protective covering": "غِطَاء وَاقٍ (الغطاء الطبيعي الصلب لبعض الكائنات الحية) / حماية, غطاء واقٍ (غطاء يهدف إلى الحماية من التلف أو الإصابة)\nمثال: لم يكن لديهم حماية من الغبار الذري",
 "protective embankment": "منحدر تحصيني (منحدر اصطناعي حاد أمام تحصين)",
 "protective fold": "طية واقية (سديلة من الأنسجة تحمي ما تغطيه)",
 "protective garment": "ملابس واقية (ملابس تهدف إلى حماية مرتديها من الإصابة)",
 "protective tariff": "تعريفة حمائية (تعريفة تفرض لحماية الشركات المحلية من منافسة الواردات)",
 "protectively": "بحماية, بوقائية (بطريقة وقائية)\nمثال: انحنى بوقائية فوق المرأة",
 "protectiveness": "حماية, وقائية (صفة توفير الحماية أو الوقاية) / حمائية, شعور بالحماية (شعور بالمودة الحمائية)\nمثال: أدلة إحصائية على وقائية التطعيم",
