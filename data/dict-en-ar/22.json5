 "programme": "برنامج (أداء (أو سلسلة من العروض) في عرض عام) / برنامج, خطة (سلسلة من الخطوات التي يتعين تنفيذها أو الأهداف التي يتعين تحقيقها) / برنامج (نظام من المشاريع أو الخدمات يهدف إلى تلبية حاجة عامة) / برنامج, برنامج حاسوبي ((علم الحاسوب) تسلسل من التعليمات التي يمكن للحاسوب تفسيرها وتنفيذها)\nمثال: استمر البرنامج لأكثر من ساعتين",
 "programme music": "موسيقى برنامجية (تراكيب موسيقية تهدف إلى استحضار صور أو تذكير المستمع بأحداث)",
 "programmed cell death": "استماتة, موت الخلية المبرمج (نوع من موت الخلايا تستخدم فيه الخلية آليات خلوية متخصصة لقتل نفسها؛ آلية انتحار خلوية تمكن الكائنات متعددة الخلايا من التحكم في عدد الخلايا والقضاء…)",
 "programmer": "مُبَرْمِج, مُبَرْمِجَة",
 "programming": "بَرْمَجَة (فِي : هي عملية كتابة تعليمات وتوجيه أوامر لجهاز الحَاسُوبِ أو أي جهاز آخر مثل قارئات أقراص الدي في دي أو أجهزة استقبال الصوت والصورة في نظم الاتصالات…؛ اسم لفظي للفعل بَرْمَجَ)\nمثال: تسمح لغة البرمجة بكتابة البرامج الحاسوبية.",
 "programming error": "خطأ برمجي (خطأ ناتج عن كود سيء في برنامج ما مشارك في إنتاج النتيجة الخاطئة)",
 "programming language": "لُغَة بَرْمَجَة (هِيَ مجموعة من الأصوات التي يصدرها الإنسان على شكل كلمات منظمة بقواعد، ليتواصل به الناس وينقلون به الافكار والمعاني، اللسان؛ يقصد بها أحيانا اللهجة)\nمثال: الأمازيغية لغة.",
 "progress": "تَقَدُّم",
 "progress report": "تقرير سير العمل, تقرير مرحلي (تقرير عن العمل المنجز خلال فترة زمنية محددة)",
 "progression": "مُتَتَالِيَة",
 "progressive": "تَقَدُّمِيّ, مُتَرَقٍّ",
 "progressive aspect": "مُسْتَمِرّ, هَيْئَة تَقَدُّمِيَّة (جهة الفعل التي تعبر عن حدث جارٍ)",
 "progressive emphysematous necrosis": "غرغرينا غازية (شكل مميت من الغرغرينا تسببه عادة بكتيريا المطثية التي تنتج سموماً تسبب موت الأنسجة)",
 "progressive party": "الحزب التقدمي, حزب بول موس (حزب سياسي سابق في الولايات المتحدة؛ أسسه ثيودور روزفلت خلال الحملة الرئاسية لعام 1912؛ كان شعاره صورة لحيوان الموظ)",
 "progressive rock": "روك تقدمي",
 "progressive tax": "ضريبة تصاعدية (أي ضريبة يزداد معدلها مع زيادة المبلغ الخاضع للضريبة)",
 "progressive tense": "مستمر (زمن للأفعال يُستخدم في وصف حدث مستمر)",
 "progressive vaccinia": "وقس متفاقم (شكل حاد أو قاتل من الوقس يحدث بشكل رئيسي عند الأشخاص الذين يعانون من نقص مناعي)",
 "progressively": "أكثر فأكثر, بشكل متزايد (يتقدم في الكمية أو الكثافة)\nمثال: أصبحت مكتئبة بشكل متزايد",
 "progressiveness": "تَقَدُّمِيَّة (التقدم نحو ظروف أو سياسات أو أساليب أفضل)",
 "progressivism": "تقدمية (التوجه السياسي لمن يفضلون التقدم نحو ظروف أفضل في الحكومة والمجتمع)",
 "progressivity": "تَقَدُّمِيَّة (التقدم نحو ظروف أو سياسات أو أساليب أفضل)",
 "progymnosperm": "طليعة عاريات البذور (نوع أحفوري سلفي يُعتقد أن عاريات البذور الحديثة قد اشتقت منه)",
 "prohibit": "مَنَعَ (حَرَمَ، ضد أَعْطَى؛ كَفَّ عنه وحَمَاه)\nمثال: تساهم جذور أشجار المنغروف في منع حدوث انجراف التربة.",
 "prohibited": "مَحْظُور, مَمْنُوع (غَيْر مَسْموح بِهِ بِمُوجَب القانون) / مَحْظُور, مُحَرَّم (ممنوع استخدامه أو ذكره)",
 "prohibition": "حَظْر, مَنْع ((حَظَّرَ): بالغ في الحظر) / حَظْر ((حَظَّرَ): بالغ في الحظر)\nمثال: حظر تويتر توم لمدة خمسة عشرة يوما.",
 "prohibition era": "عصر الحظر, فترة منع الكحول (الفترة من 1920 إلى 1933 عندما تم حظر بيع المشروبات الكحولية في الولايات المتحدة بموجب تعديل دستوري)",
 "prohibition party": "حزب الحظر (حزب سياسي في الولايات المتحدة؛ تشكل عام 1869 لمعارضة تصنيع وبيع المشروبات الكحولية)",
 "prohibitionist": "مُؤَيِّد لِحَظْر الكُحُول, مُحَرِّم لِلخُمُور (مصلح يعارض استخدام المشروبات المسكرة)",
 "prohibitive": "نَهْي",
 "prohibitively": "بشكل باهظ, بشكل مانع (لدرجة تمنع (الشراء مثلاً))\nمثال: إنها باهظة الثمن بشكل مانع",
 "prohibitory": "بَاهِظ, مُثَبِّط (يميل إلى التثبيط وخاصّة بسبب ارتفاع الأسعار)",
 "proinflammatory": "مُحَفِّز لِلالْتِهاب (يَميل إلى إثارَة الالْتِهاب أو تَحْفيزِه)",
 "project": "مَشْرُوع (ما تُجِيزُه السلطة أو القانون أو أي قاعدة، جَائِز، قَانُونِيّ؛ مسعى مؤقت أي شيء يُسْعى لفعله خلال فترة زمنية معينة، فيُقال مشروع شخصي، مشروع سياسي، مشروع تجاري ؛إلخ)\nمثال: هذا مشروع عظيم.",
 "project management": "إدارَة المشاريع (هو عملية تولي تَصْرِيف شؤون العَمَل. لا جمع له؛ مجموع الناس الذين يقومون بإدارة شؤون الجهة، حكومية كانت أم خاصة)\nمثال: والدتي تنتظرني في الإدارة.",
 "projected": "بَارِز, مُمْتَدّ (يمتد للخارج فوق سطح أو حدّ أو ما وراءهما)",
 "projectile": "قَذْفِيّ, مَقْذُوف (يدفع أو يُدفَع إلى الأمام) / قذيفة, مقذوف (سلاح يُرمى أو يُقذف بقوة على الأهداف ولكنه ليس ذاتي الدفع) / صاروخ, مركبة صاروخية (أي مركبة ذاتية الدفع بواسطة محرك صاروخي)",
 "projecting": "بَارِز, مُمْتَدّ (يمتد للخارج فوق سطح أو حدّ أو ما وراءهما)",
 "projection": "إِسْقَاط / مَسْقَط (اسم مكان من السقوط؛ موضع السقوط عامّة؛ رأسه: عن المكان الذي وُلِد فيه. يُقصد بها الدولة أو المدينة لا المبنى)\nمثال: دفنت في مسقط رأسها.",
 "projection screen": "شاشة عرض (سطح أبيض أو فضي يمكن عرض الصور عليه للمشاهدة)",
 "projectionist": "عامل العرض السينمائي, مشغل جهاز العرض (الشخص الذي يشغل جهاز العرض في دار السينما)",
 "projective device": "اختبار إسقاطي (أي اختبار شخصية مصمم لتقديم معلومات حول شخصية شخص ما بناءً على استجابته غير المقيدة لأشياء أو مواقف غامضة)",
 "projective geometry": "هندسة إسقاطية, هندسة وصفية (هندسة الخصائص التي تظل ثابتة تحت الإسقاط)",
 "projective technique": "اختبار إسقاطي (أي اختبار شخصية مصمم لتقديم معلومات حول شخصية شخص ما بناءً على استجابته غير المقيدة لأشياء أو مواقف غامضة)",
 "projective test": "اختبار إسقاطي (أي اختبار شخصية مصمم لتقديم معلومات حول شخصية شخص ما بناءً على استجابته غير المقيدة لأشياء أو مواقف غامضة)",
