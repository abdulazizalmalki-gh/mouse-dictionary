 "quechuan": "كيتشوي (من أو متعلق بشعب الكيتشوا أو لغتهم) / لغة الكيتشوا (لغة الكيتشوا التي كان يتحدث بها الإنكا)",
 "quechuan language": "لغة الكيتشوا (لغة الكيتشوا التي كان يتحدث بها الإنكا)",
 "queckenstedt's test": "اختبار كويكينشتيت (اختبار لتحديد ما إذا كان هناك انسداد في القناة الشوكية)",
 "queen": "مَلِكَة, ملكة (مؤنث مَلِك) / وَزِير, فرزان / تفرزن\nمثال: ليحفظ الله الملكة.",
 "queen anne's lace": "جزر بري, دانتيل الملكة آن (عشب أوراسي مستوطن على نطاق واسع بأوراق مقطعة بدقة وخيمات مركبة بيضاء من الزهور الصغيرة البيضاء أو الصفراء وجذور صفراء رفيعة)",
 "queen bee": "ملكة النحل (أنثى النحل المخصبة التي تضع البيض)",
 "queen consort": "ملكة قرينة (زوجة الملك الحاكم)",
 "queen dowager": "ملكة أرملة (أرملة الملك)",
 "queen mole rat": "ملكة فئران الخلد (فأر خلد كبير بشكل خاص وهي العضو الوحيد في مستعمرة فئران الخلد العارية التي تنجب ذرية يتم تلقيحها بواسطة عدد قليل من الذكور)",
 "queen mother": "الْمَلِكَة الْأُمّ",
 "queen of england": "ملكة إنجلترا (الحاكم السيادي لإنجلترا عندما تكون أنثى)",
 "queen of the may": "ملكة مايو (الفتاة المختارة كملكة لمهرجان يوم مايو)",
 "queen of the night": "سيلينسيريوس, ملكة الليل (صبار متسلق أمريكي استوائي له فروع مثلثة؛ يزرع غالباً لزهوره الكبيرة البارزة التي تتفتح ليلاً تليها ثمار صفراء مخططة بالأحمر)",
 "queen post": "عمود الملكة (عمود ربط رأسي في جملون السقف)",
 "queen regent": "ملكة وصية (ملكة تعمل كحاكم عندما لا يستطيع الملك ذلك)",
 "queen regnant": "ملكة حاكمة (حاكمة سيادية أنثى)",
 "queen triggerfish": "سمكة الزناد الملكة (سمكة أطلسية استوائية)",
 "queen's counsel": "مستشار الملكة (مستشار للتاج عندما يكون العاهل البريطاني ملكة)",
 "queen's crape myrtle": "لاجرستروميا, وردة الهند (موطنها آسيا وأستراليا وجزر الهند الشرقية، حيث توفر خشباً يسمى بيينما؛ تستخدم في أماكن أخرى للزينة لزهورها الكبيرة المبهرجة)",
 "queen's cup": "قلنسوة العروس, كأس الملكة (نبات بـ 1 أو 2 زهرة بيضاء تشبه النجوم على سيقان قصيرة بلا أوراق؛ ألاسكا إلى كاليفورنيا وشرقاً إلى أوريغون ومونتانا)",
 "queen's english": "النطق المستلم (النطق المعتمد للإنجليزية البريطانية؛ كان يستند في الأصل إلى إنجليزية الملك كما يتحدث بها في المدارس العامة وفي جامعتي أكسفورد وكامبريدج)",
 "queen-size": "بِحَجْم المَلِكَة ((يُستخدم خاصة للأسِرّة) ليس بكبر حجم الملك)",
 "queen-sized": "بِحَجْم المَلِكَة ((يُستخدم خاصة للأسِرّة) ليس بكبر حجم الملك)",
 "queenfish": "السمكة الملكة, كرواكر أبيض (سمكة طبل فضية ومائلة للزرقة في المياه الساحلية الضحلة لكاليفورنيا)",
 "queenlike": "كَالمَلِكَة, مَلَكِيّ مُؤَنَّث (له رتبة ملكة أو يشبهها أو يليق بها)",
 "queenly": "كَالمَلِكَة, مَلَكِيّ مُؤَنَّث (له رتبة ملكة أو يشبهها أو يليق بها)",
 "queensland": "كْوِينْزْلَانْد",
 "queensland bottletree": "شجرة الزجاجة الكوينزلاندية (شجرة كبيرة من كوينزلاند لها زهور كريمية اللون ملطخة بالأحمر من الداخل)",
 "queensland grass-cloth plant": "نبات قماش العشب كوينزلاند (نبات أسترالي من جنس بيبتورس تستخدم أليافه في صناعة القماش)",
 "queensland hemp": "سيدا, قنب كوينزلاند (عشب واسع الانتشار في المناطق الاستوائية وشبه الاستوائية يستخدم للعلف وطبياً كملطف وله لحاء ناعم قوي أقوى من الجوت)",
 "queensland kauri": "كاوري كوينزلاند (شجرة خشب أسترالية تشبه الكاوري ولكن خشبها أخف وزناً وأكثر ليونة بكثير)",
 "queensland nut": "جوز كوينزلاند (شجرة كثيفة بزهور وردية إلى أرجوانية)",
 "queer": "كْوِير",
 "queer bird": "غَرِيب الْأَطْوَار (شخص يعتبر غريب الأطوار أو مجنوناً ويبرز عن المجموعة)",
 "queer duck": "غَرِيب الْأَطْوَار (شخص يعتبر غريب الأطوار أو مجنوناً ويبرز عن المجموعة)",
 "queerly": "بشكل مريب, بشكل مشبوه (بطريقة غير عادية ومثيرة للشك) / بشكل عجيب, بغرابة (بطريقة غريبة)\nمثال: تم الحصول على هذا المال بشكل مريب",
 "queerness": "كُوِيرِيَّة",
 "quelled": "مَقْمُوع, مُخْمَد (أُخضع أو قُهر)",
 "quelling": "إخماد, قمع (منع بالقوة؛ القضاء على الشيء بالسلطة أو القوة)\nمثال: قمع الهرطقة",
 "quellung": "تفاعل الانتفاخ (تورم الكبسولة المحيطة بالكائن الحي الدقيق بعد التفاعل مع جسم مضاد؛ أساس بعض الاختبارات لتحديد الكائنات الحية الدقيقة)",
 "quellung reaction": "تفاعل الانتفاخ (تورم الكبسولة المحيطة بالكائن الحي الدقيق بعد التفاعل مع جسم مضاد؛ أساس بعض الاختبارات لتحديد الكائنات الحية الدقيقة)",
 "quench": "أَنْقَعَ",
 "quenched": "مَقْمُوع, مُخْمَد (أُخضع أو قُهر) / مُرْتَوٍ, مُشْبَع (سُكِّنَتْ حَاجَتُهُ وَأُشْبِعَ رَغْبَتُه)",
 "quenched steel": "فولاذ مُسْقَى (فولاذ تم تصليبه بغمره في الماء أو الزيت لتبريده)",
 "quenching": "إخماد, إطفاء (فعل الإطفاء؛ التسبب في توقف الاحتراق)\nمثال: إطفاء الأنوار",
 "quenchless": "لَا يُرْوَى, لَا يُطْفَأ (يستحيل إشباعه أو إطفاؤه)",
 "quercitron": "بلوط أسود, بلوط أصفر (شجرة أخشاب متساقطة الأوراق متوسطة إلى كبيرة من شرق الولايات المتحدة وجنوب شرق كندا لها لحاء خارجي داكن ولحاء داخلي أصفر يستخدم للدباغة؛ الأوراق…) / كويرسيترون (صبغة صفراء مصنوعة من لحاء شجرة بلوط الكويرسيترون)",
 "quercitron oak": "بلوط أسود, بلوط أصفر (شجرة أخشاب متساقطة الأوراق متوسطة إلى كبيرة من شرق الولايات المتحدة وجنوب شرق كندا لها لحاء خارجي داكن ولحاء داخلي أصفر يستخدم للدباغة؛ الأوراق…)",
 "quercus agrifolia": "بلوط الساحل الحي, سنديان أغريفولي (سنديان دائم الخضرة، غالباً ما يكون شجيرياً، ينمو في المناطق الساحلية لغرب أمريكا الشمالية، وله أوراق خضراء داكنة صغيرة وسميكة ومسننة عادةً)",
 "quercus alba": "بلوط أبيض أمريكي, سنديان أبيض (شجرة نفضية كبيرة بطيئة النمو موطنها شرق الولايات المتحدة، لها فروع قوية منتشرة وأوراق ذات 7 فصوص مستديرة عادة؛ وتنتج خشباً صلباً قوياً ومتيناً)",
 "quercus arizonica": "سنديان أريزونا (شجيرة شبه دائمة الخضرة أو شجرة صغيرة موطنها أريزونا ونيو مكسيكو، لها بلوط (ثمر) ذو قمع نصف كروي)",
 "quercus bicolor": "بلوط المستنقعات, سنديان المستنقعات الأبيض (سنديان نفضي كبير موطنه شرق الولايات المتحدة، ذو لحاء مقشر وأوراق تحتوي على فصوص أقل من السنديان الأبيض الآخر؛ ينتج خشباً ثقيلاً وقوياً يستخدم في…)",
 "quercus borealis": "بلوط أحمر, سنديان أحمر شمالي (شجرة نفضية كبيرة متناظرة ذات تاج مستدير تنتشر على نطاق واسع في شرق أمريكا الشمالية؛ لها أوراق كبيرة ذات فصوص مثلثة مدببة الأطراف وخشب خشن الحبيبات…)",
 "quercus cerris": "بلوط تركي (شجرة كبيرة متساقطة الأوراق من وسط وجنوب أوروبا وآسيا الصغرى لها أوراق رمحية ذات فصوص شائكة)",
 "quercus chrysolepis": "سنديان الأخاديد, سنديان الوادي الحي (شجرة دائمة الخضرة متوسطة الحجم موطنها جنوب غرب الولايات المتحدة وشمال غرب المكسيك، ذات أوراق مستطيلة جلدية غالباً ما تكون حوافها شوكية)",
 "quercus coccinea": "بلوط قرمزي (شجرة متساقطة الأوراق متوسطة إلى كبيرة ذات جذع سميك توجد في شرق الولايات المتحدة وجنوب كندا ولها خشب ضيق الحبيبات وأوراق عميقة الفصوص تتحول إلى…)",
 "quercus ellipsoidalis": "بلوط جاك, بلوط دبوسي شمالي (بلوط متساقط الأوراق صغير إلى متوسط من شرق وسط أمريكا الشمالية؛ الأوراق لها فصوص مدببة بحدة)",
 "quercus falcata": "سنديان أحمر جنوبي, سنديان إسباني (شجرة نفضية كبيرة مستديرة القمة ذات فروع منتشرة وأوراق ضيقة منجلية الشكل ذات فصوص عميقة التموج، وخشبها مشابه لخشب السنديان الأحمر الشمالي؛ تنتشر من…)",
 "quercus garryana": "سنديان أوريغون الأبيض, سنديان غاري (شجرة نفضية صغيرة موطنها غرب أمريكا الشمالية ذات فروع ملتوية ولحاء رمادي شاحب)",
 "quercus grosseserrata": "بلوط منغولي, بلوط ياباني (بلوط بخشب ناعم الحبيبات خفيف معتدلاً؛ اليابان)",
 "quercus ilex": "بلوط هولم, سنديان أخضر (بلوط دائم الخضرة من جنوب أوروبا له أوراق تشبه إلى حد ما أوراق البهشية؛ ينتج خشباً صلباً)",
 "quercus ilicifolia": "سنديان الدب (سنديان شجيري موطنه جنوب شرق الولايات المتحدة، يشكل عادةً غابات كثيفة)",
 "quercus imbricaria": "بلوط الألواح, بلوط الغار (شجرة متساقطة الأوراق صغيرة من شرق ووسط الولايات المتحدة لها أوراق تلمع مثل الغار؛ يستخدم الخشب في الولايات الغربية للألواح الخشبية)",
 "quercus incana": "بلوط أزرق, بلوط تركي (شجرة شجيرية صغيرة شبه دائمة الخضرة من جنوب شرق الولايات المتحدة لها غصينات صغيرة مشعرة وأوراق تضيق إلى نقطة شائكة رفيعة)",
 "quercus kelloggii": "بلوط أسود كاليفورني (شجرة كبيرة متساقطة الأوراق من ساحل المحيط الهادئ لها أوراق عميقة الفصوص ذات أطراف شائكة)",
 "quercus laevis": "بلوط تركي أمريكي (شجرة شجيرية صغيرة بطيئة النمو متساقطة الأوراق في الأراضي الرملية القاحلة بجنوب شرق الولايات المتحدة لها أوراق ذات فصوص شائكة الأطراف تشبه أصابع الديك…)",
 "quercus laurifolia": "بلوط الغار (بلوط كبير شبه دائم الخضرة تقريباً من جنوب شرق الولايات المتحدة؛ يزدهر في التربة الرطبة)",
 "quercus lobata": "سنديان الوادي, سنديان كاليفورنيا الأبيض (سنديان نفضي طويل ورشيق موطنه كاليفورنيا، له أوراق جلدية وبلوط (ثمر) نحيل ومدبب)",
 "quercus lyrata": "بلوط القيثارة (شجرة أخشاب متساقطة الأوراق متوسطة إلى كبيرة من وسط وجنوب الولايات المتحدة؛ البلوط مغمور بعمق في الكأس وينضج في السنة الأولى)",
 "quercus macrocarpa": "سنديان كبير الثمار (سنديان نفضي متوسط إلى كبير الحجم موطنه وسط وشرق أمريكا الشمالية، له بلوط بيضوي مغمور بعمق في أقماع كبيرة مهدبة؛ ينتج خشباً قوياً ناعم الحبيبات)",
 "quercus marilandica": "سنديان ماريلاند (شجرة نفضية شجيرية شائعة في وسط وجنوب شرق الولايات المتحدة، لها لحاء داكن وأوراق عريضة ثلاثية الفصوص (على شكل هراوة)؛ وتميل لتشكيل غابات كثيفة)",
 "quercus michauxii": "سنديان المستنقعات الكستنائي, سنديان كستنائي (شجرة نفضية متوسطة إلى كبيرة الحجم تنمو في المناطق الرطبة بجنوب شرق الولايات المتحدة، تشبه سنديان السلال)",
 "quercus mongolica": "بلوط منغولي, بلوط ياباني (بلوط بخشب ناعم الحبيبات خفيف معتدلاً؛ اليابان)",
 "quercus montana": "سنديان البقر, سنديان السلال (شجرة نفضية متوسطة إلى كبيرة الحجم موطنها شرق الولايات المتحدة؛ يستخدم خشبها المتين كأخشاب بناء أو يُشطر ويُنسج في سلال أو مقاعد كراسي)",
 "quercus muehlenbergii": "سنديان أصفر, سنديان تشينكابين (شجرة نفضية متوسطة الحجم موطنها شرق الولايات المتحدة، تنتج خشباً قوياً ومتيناً)",
 "quercus myrtifolia": "سنديان آسي (شجيرة أو شجرة صغيرة دائمة الخضرة موطنها جنوب شرق الولايات المتحدة؛ غالباً ما تشكل غابات كثيفة لا يمكن اختراقها في المناطق الساحلية الرملية)",
 "quercus nigra": "بلوط مائي (بلوط مائي متساقط الأوراق طويل نسبياً من جنوب شرق الولايات المتحدة يُزرع غالباً كشجرة ظل؛ يزدهر في التربة الرطبة)",
 "quercus nuttalli": "بلوط نوتال (يشبه البلوط الدبوسي؛ ينمو في المواقع الرطبة في حوض نهر المسيسيبي)",
 "quercus palustris": "بلوط المستنقعات, بلوط دبوسي (شجرة متساقطة الأوراق هرمية سريعة النمو متوسطة إلى كبيرة من شمال شرق الولايات المتحدة وجنوب شرق كندا لها أوراق ريشية عميقة تتحول إلى الأحمر الساطع في…)",
 "quercus petraea": "بلوط صخري, سنديان لاطئ (سنديان أوروبي نفضي يُقدر لخشبه القوي والمرن)",
 "quercus phellos": "بلوط صفصافي (بلوط متساقط الأوراق متوسط إلى كبير من شرق الولايات المتحدة له أوراق رمحية طويلة وخشب ناعم قوي)",
 "quercus prinoides": "سنديان قزمي (شجرة شجيرية نفضية موطنها شمال شرق ووسط الولايات المتحدة، لها جوز حلو صالح للأكل وغالباً ما تشكل غابات كثيفة)",
 "quercus prinus": "سنديان البقر, سنديان السلال (شجرة نفضية متوسطة إلى كبيرة الحجم موطنها شرق الولايات المتحدة؛ يستخدم خشبها المتين كأخشاب بناء أو يُشطر ويُنسج في سلال أو مقاعد كراسي)",
 "quercus robur": "بلوط شائع, سنديان إنجليزي (سنديان أوروبي نفضي متوسط إلى كبير الحجم، له أوراق ناعمة ذات فصوص مستديرة؛ ينتج خشباً صلباً قوياً فاتح اللون)",
 "quercus rubra": "بلوط أحمر, سنديان أحمر شمالي (شجرة نفضية كبيرة متناظرة ذات تاج مستدير تنتشر على نطاق واسع في شرق أمريكا الشمالية؛ لها أوراق كبيرة ذات فصوص مثلثة مدببة الأطراف وخشب خشن الحبيبات…)",
 "quercus sessiliflora": "بلوط صخري, سنديان لاطئ (سنديان أوروبي نفضي يُقدر لخشبه القوي والمرن)",
 "quercus shumardii": "سنديان شومارد (سنديان أحمر نفضي كبير موطنه جنوب وشرق الولايات المتحدة، له أوراق كبيرة بيضاوية الشكل ذات سبعة إلى تسعة فصوص، وبلوط كبير، وخشب متوسط الصلابة خشن…)",
 "quercus stellata": "بلوط عمودي (شجرة متساقطة الأوراق صغيرة من شرق ووسط الولايات المتحدة لها أوراق ريشية قيثارية خضراء داكنة وخشب قوي مقاوم للرطوبة يستخدم خاصة لأعمدة السياج)",
 "quercus suber": "بلوط الفلين (بلوط دائم الخضرة متوسط الحجم من جنوب أوروبا وشمال أفريقيا له لحاء فليني سميك يتم تقشيره دورياً لإنتاج الفلين التجاري)",
 "quercus texana": "بلوط إسباني, بلوط تكساس (شجرة متساقطة الأوراق صغيرة يتفرع جذعها تقريباً من القاعدة بفروع منتشرة؛ تكساس وجنوب أوكلاهوما)",
 "quercus vaccinifolia": "بلوط التوت (شجيرة منخفضة منتشرة أو زاحفة في جنوب غرب الولايات المتحدة ذات بلوط صغير وأوراق تشبه أوراق التوت البري)",
 "quercus variabilis": "بلوط الفلين الصيني (شجرة متساقطة الأوراق متوسطة إلى كبيرة من الصين واليابان وكوريا لها لحاء فليني سميك)",
 "quercus velutina": "بلوط أسود, بلوط أصفر (شجرة أخشاب متساقطة الأوراق متوسطة إلى كبيرة من شرق الولايات المتحدة وجنوب شرق كندا لها لحاء خارجي داكن ولحاء داخلي أصفر يستخدم للدباغة؛ الأوراق…)",
