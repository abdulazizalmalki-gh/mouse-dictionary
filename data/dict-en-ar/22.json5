 "quality of life": "جَوْدَة الْحَيَاة",
 "qualm": "توجس, رادع أخلاقي (عدم الارتياح بشأن ملاءمة إجراء ما (لا سيما لأسباب تتعلق بالأخلاق أو اللياقة)) / انزعاج معدي, غثيان خفيف (حالة خفيفة من الغثيان)",
 "quamash": "كاماس, كاماسيا (أي من النباتات العديدة من جنس كاماسيا؛ أمريكا الشمالية والجنوبية)",
 "quamoclit pennata": "أثمان ريشي, كرمة السرو (متسلق حولي أمريكي استوائي له زهور حمراء (وأحياناً بيضاء) وأوراق مقطعة بدقة؛ تم توطينه في الولايات المتحدة وأماكن أخرى)",
 "quandang": "دراق محلي أسترالي, كوندونغ (فاكهة أسترالية حمراء؛ تستخدم للحلوى أو في المربى) / خوخ الصحراء, كواندونغ (شجرة أسترالية ذات لب صالح للأكل وبذرة تشبه الجوز صالحة للأكل)",
 "quandary": "مأزق, معضلة (حالة من عدم اليقين أو الحيرة تتطلب خاصة اختياراً بين خيارات غير مواتية على قدم المساواة) / مأزق, ورطة (موقف يصعب الخلاص منه، خاصة إذا كان مزعجاً أو شاقاً)\nمثال: وجد نفسه في مأزق محرج للغاية",
 "quandong": "دراق محلي أسترالي, كوندونغ (فاكهة أسترالية حمراء؛ تستخدم للحلوى أو في المربى) / تين أزرق, شجرة الكواندونج (شجرة أسترالية ذات خشب أبيض صلب وأوراق خضراء لامعة مع أزهار بيضاء تليها ثمرة زرقاء لامعة ذات بذرة واحدة) / تين أزرق, كوندونغ (ثمرة شجرة الكوندونغ في بريسبان) / خوخ الصحراء, كواندونغ (شجرة أسترالية ذات لب صالح للأكل وبذرة تشبه الجوز صالحة للأكل)",
 "quandong nut": "جوز الكوندونغ (بذرة تشبه الجوز صالحة للأكل لفاكهة الكوندونغ)",
 "quandong tree": "تين أزرق, شجرة الكواندونج (شجرة أسترالية ذات خشب أبيض صلب وأوراق خضراء لامعة مع أزهار بيضاء تليها ثمرة زرقاء لامعة ذات بذرة واحدة) / خوخ الصحراء, كواندونغ (شجرة أسترالية ذات لب صالح للأكل وبذرة تشبه الجوز صالحة للأكل)",
 "quango": "منظمة شبه حكومية (منظمة ممولة من قبل الحكومة ولكنها تعمل بشكل مستقل عنها)",
 "quantal": "كمي, مكمم",
 "quantic": "كَثِيرَة حُدُود مُتَجَانِسَة بِمُتَغَيِّرَيْن (كثيرة حدود متجانسة لها متغيرين على الأقل)",
 "quantifiability": "قَابِلِيَّة القِيَاس (صفة كون الشيء قابلاً للقياس)",
 "quantifiable": "قَابِلٌ لِلتَّكْمِيم, قَابِلٌ لِلقِيَاس (يمكن التعبير عنه بأرقام أو قياسه كمّيًّا)",
 "quantification": "تكميم, قياس كمي (فعل اكتشاف أو التعبير عن كمية شيء ما) / تسوير, تكميم (قيد مفروض على متغيرات قضية منطقية (مثل المحددات الكمية 'بعض' أو 'كل' أو 'لا'))",
 "quantifier": "مُحَدِدْ الْكَمِيَّةْ (من الفعل حَدَّدَ؛ (في الرياضيات) مصطلح يستعمل في الجبر الخطي، ويتم تحديد محدد مصفوفة باستعمال صيغة لايبنتس أو صيغة لابلاس)\nمثال: حضر الجميع إلى الصف في الوقت المحدد",
 "quantisation": "تكميم (عملية التقسيم إلى كمات أو التعبير بمصطلحات نظرية الكم)",
 "quantitative": "كمي (يمكن التعبير عنه ككمية أو يتعلق بـ أو قابل للقياس) / كمي ((للشعر) له نظام متري يعتمد على المدة النسبية للمقاطع) / كمي (يتعلق بقياس الكمية)\nمثال: تصدير القمح دون قيود كمية",
 "quantitative analysis": "تحليل كمي, تحليل كيميائي كمي (تحليل كيميائي لتحديد كميات كل عنصر في المادة)",
 "quantitative chemical analysis": "تحليل كمي, تحليل كيميائي كمي (تحليل كيميائي لتحديد كميات كل عنصر في المادة)",
 "quantitative relation": "عَلَاقَة كَمِّيَّة, عَلَاقَة مِقْدَارِيَّة (علاقة بين المقادير)",
 "quantitatively": "كَمِّيًّا (بطريقة كمية)\nمثال: يمكن التعبير عن هذا كمياً",
 "quantity": "كَمِّيَّة, مِقْدَار",
