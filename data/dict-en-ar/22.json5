 "proportional counter": "أنبوب عداد تناسبي (أنبوب عداد تتناسب نبضة خرجه مع عدد الأيونات المنتجة)",
 "proportional counter tube": "أنبوب عداد تناسبي (أنبوب عداد تتناسب نبضة خرجه مع عدد الأيونات المنتجة)",
 "proportional font": "خط نسبي (أي خط يكون لأحرفه المختلفة عروض مختلفة)",
 "proportional representation": "تَمْثِيل نِسْبِيّ (تمثيل جميع الأحزاب بما يتناسب مع تصويتهم الشعبي)",
 "proportional sample": "عينة طبقية, عينة ممثلة (يتم تقسيم المجتمع إلى طبقات ويتم أخذ عينة عشوائية من كل طبقة)",
 "proportional sampling": "أخذ عينات طبقي (تقسيم المجتمع الإحصائي إلى طبقات وأخذ عينات عشوائية من كل طبقة)",
 "proportional tax": "ضريبة تناسبية (أي ضريبة يكون معدلها ثابتاً مع زيادة المبلغ الخاضع للضريبة)",
 "proportionality": "تَنَاسُب, تَوَازُن (ترتيب أو علاقة متناغمة للأجزاء أو العناصر داخل كلٍّ (كما في التصميم)) / تَنَاسُبِيَّة (نسبة كميتين تكون ثابتة)\nمثال: في جميع الأشياء الجميلة تماماً يوجد تقابل بين جزء وآخر وتوازن متبادل",
 "proportionally": "بِالتَّنَاسُب, بِشَكْل مُتَنَاسِب (لدرجة متناسبة)\nمثال: سيزداد راتبك بشكل متناسب مع عبء عملك",
 "proportionate": "مُتَنَاسِب",
 "proportionately": "بِالتَّنَاسُب (بطريقة تتفق في الكمية أو الحجم أو الدرجة) / بِالتَّنَاسُب, بِشَكْل مُتَنَاسِب (لدرجة متناسبة) / بِالتَّنَاسُب, بِشَكْل نِسْبِيّ (بطريقة تتوافق بين مكونات كيان آخر)\nمثال: سيزداد راتبك بشكل متناسب مع عبء عملك",
 "proportionateness": "تَنَاسُب, تَوَافُق (علاقة التطابق في الدرجة أو الحجم أو المقدار)",
 "proposal": "طَلَب الزَّوَاج (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى))\nمثال: طلب زيري ورودا.",
 "proposal of marriage": "طَلَب زَوَاج, عَرْض زَوَاج (عرض للزواج)",
 "propose": "اِقْتَرَحَ (اِبْتَدَعَ ٱلشَّيْءَ مِنْ ذَاتِ نَفْسِهِ مِنْ غَيْرِ أَنْ يَسْمَعَهُ؛ اِخْتَارَ) / خَطَبَ, طَلَبَ يَد (يُشير إلى من يُلقي خطبة أو يطلب الزواج، وجمعه خُطّاب. ويُضرب مثل \"ذهب خاطباً فتزوج\" لمن يطلب شيئاً صغيراً فيحصل على شيء أكبر؛ يشير إلى فعل التحدث إلى الجمهور بغرض إلقاء خطاب، وعظ، أو إرشاد)\nمثال: اقترح سامي المساعدة.",
 "proposer": "مُقْتَرِح",
 "proposition": "قَضِيَّة (الأمر أو الشيء المُعَقَّد؛ في : ما يقضي فيه القاضي)\nمثال: سأرفع عليك قضية.",
 "propositional calculus": "منطق القضايا (فرع من المنطق الرمزي يتعامل مع القضايا كوحدات ومع تركيباتها والروابط التي تربط بينها)",
 "propositional logic": "منطق القضايا (فرع من المنطق الرمزي يتعامل مع القضايا كوحدات ومع تركيباتها والروابط التي تربط بينها)",
 "propositus": "المعني, صاحب الشأن (الشخص المتأثر مباشرة أو المعني بإجراء ما)",
 "propoxyphene": "بروبوكسيفين, دارفون (دواء مسكن مخدر خفيف (الاسم التجاري دارفون) مرتبط بالميثادون ولكنه أقل تسبباً في الإدمان)",
 "propoxyphene hydrochloride": "بروبوكسيفين, دارفون (دواء مسكن مخدر خفيف (الاسم التجاري دارفون) مرتبط بالميثادون ولكنه أقل تسبباً في الإدمان)",
 "propping up": "إسناد, تدعيم (فعل التدعيم بالدعامات)",
 "propranolol": "إندرال, بروبرانولول (أول حاصر لبيتا (الاسم التجاري إندرال) يستخدم في علاج ارتفاع ضغط الدم والذبحة الصدرية والرعاش الأساسي)",
 "proprietary": "ذي ملكية خاصة, مملوك (محمي بعلامة تجارية أو براءة اختراع أو حقوق نشر؛ مصنوع أو منتج أو موزع بواسطة من يمتلك حقوقاً حصرية) / مُؤَسَّسَة فَرْدِيَّة, مِلْكِيَّة فَرْدِيَّة (عمل تجاري غير مدمج يمتلكه شخص واحد يكون مسؤولاً عن التزاماته ويحق له أرباحه)\nمثال: تايلينول هو دواء مملوك وشكله العام هو أسيتامينوفين",
 "proprietary colony": "مستعمرة ملكية خاصة (مستعمرة تُعطى لمالك لحكمها (في القرن السابع عشر))",
 "proprietary drug": "دواء ذو علامة تجارية, دواء مسجل (دواء له اسم تجاري ومحمي ببراءة اختراع (يمكن إنتاجه وبيعه فقط من قبل الشركة التي تحمل براءة الاختراع))",
 "proprietor": "صاحب ملك, مالك (شخص يمتلك (هو الحائز القانوني) لعمل تجاري)\nمثال: هو مالك سلسلة مطاعم",
 "proprietorship": "مُؤَسَّسَة فَرْدِيَّة, مِلْكِيَّة فَرْدِيَّة (عمل تجاري غير مدمج يمتلكه شخص واحد يكون مسؤولاً عن التزاماته ويحق له أرباحه)",
 "proprietorship certificate": "شهادة ملكية فردية (شهادة تظهر من هو المسؤول في عمل مملوك فردياً)",
 "proprietress": "مالكة (امرأة مالكة)",
 "propriety": "أدب, صواب (السلوك الصحيح أو المناسب)",
 "proprioception": "إدراك الوضعية, استقبال الحس العميق (القدرة على استشعار موضع ومكان واتجاه وحركة الجسم وأجزائه)",
 "proprioceptive": "استقبالي ذاتي, حسي عميق (متعلق بالاستقبال الحسي العميق (إدراك وضع الجسم))",
