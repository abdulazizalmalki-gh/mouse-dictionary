 "puzzling": "مُحَيِّر, مُرْبِك (يفتقر إلى وضوح المعنى ويُسبّب الحيرة والارتباك) / لُغْزِيّ, مُحَيِّر (غير واضح للفهم؛ يثير الحيرة والتساؤل)",
 "pva": "بولي فينيل أسيتات (بوليمر فينيل يُستخدم خاصة في الدهانات أو المواد اللاصقة)",
 "pvc": "انقباض بطيني سابق لأوانه (عدم انتظام في إيقاع القلب؛ يمكن أن يكون تكرار حدوثه مقدمة للرجفان البطيني) / بي في سي, كلوريد البوليفينيل (بوليمر من كلوريد الفينيل يُستخدم بدلاً من المطاط في الكابلات الكهربائية)",
 "pwr": "مفاعل الماء المضغوط (مفاعل نووي يستخدم الماء كمبرد ومهدئ؛ يمكن للبخار المنتج تشغيل توربين بخاري)",
 "px": "بي إكس, متجر عسكري (مجمع استهلاكي في موقع للجيش الأمريكي)",
 "pya": "بيا (100 بيا تساوي 1 كيات في ميانمار)",
 "pyaemia": "تقيح الدم (إنتان ناتج عن إطلاق البكتيريا المكونة للقيح من خراج)",
 "pyaemic": "تقيحي دموي (من أو متعلق بتقيح الدم)",
 "pycnanthemum virginianum": "نعناع الريحان (عشب معمر من شرق الولايات المتحدة له زهور مخضرة غير بارزة وأوراق ضيقة عطرية جداً عند فركها)",
 "pycnidium": "وعاء بكنيدي (هيكل لاجنسي قاروري الشكل يحتوي على كونيدات)",
 "pycnodysostosis": "خلل التعظم المكثف (شكل من أشكال القزامة مصحوب بعظام هشة وأسنان سيئة)",
 "pycnogonid": "عنكبوت البحر (أي من المفصليات البحرية الصغيرة المختلفة التي تشبه العناكب ولها أجسام صغيرة رفيعة وأرجل طويلة نحيلة)",
 "pycnometry": "قياس الكثافة بالبيكنومتر (تحديد كثافة السائل عن طريق وزن السائل في حاوية (بيكنومتر) ذات حجم معروف)",
 "pycnosis": "تغلظ النواة, تكنز (حالة تنكسية لنواة الخلية)",
 "pycnotic": "تغلظي, تكثفي (من أو يتعلق بالتغلظ (تكثف نواة الخلية))",
 "pye-dog": "كلب منبوذ (كلب هجين نصف بري بلا مالك شائع حول القرى الآسيوية خاصة الهند)",
 "pyelitis": "التهاب الحويضة (التهاب حوض الكلية)",
 "pyelogram": "صورة الحويضة (أشعة سينية للكلى والحالبين)",
 "pyelography": "تصوير الحويض (تصوير الكلى والحالبين بالأشعة السينية (عادة بعد الحقن بصبغة غير شفافة للأشعة))",
 "pyelonephritis": "التهاب الحويضة والكلية (التهاب الكلى وحوضها الناجم عن عدوى بكتيرية)",
 "pyemia": "تقيح الدم (إنتان ناتج عن إطلاق البكتيريا المكونة للقيح من خراج)",
 "pyemic": "تقيحي دموي (من أو متعلق بتقيح الدم)",
 "pygmy": "قزم (أي عضو من شعوب مختلفة يقل متوسط طولهم عن خمسة أقدام) / قزم (فرد صغير الحجم بشكل غير عادي)",
 "pygmy chimpanzee": "بونوبو, شمبانزي قزم (شمبانزي صغير يعيش في غابات المستنقعات في زائير؛ نوع مهدد بالانقراض)",
 "pygmy cypress": "سرو قزم (سرو صغير نادر موطنه شمال كاليفورنيا؛ يعتبر أحياناً نفس نوع سرو غوين)",
 "pygmy marmoset": "مارموسيت قزم (أصغر قرد؛ يعيش في الغابات الاستوائية في الأمازون)",
 "pygmy mouse": "فأر قزم (فأر بني رمادي داكن صغير جداً يشبه فأر المنزل؛ من تكساس والمكسيك)",
 "pygmy sperm whale": "حوت العنبر القزم (حوت عنبر صغير يعيش في المياه الدافئة لكلا ساحلي أمريكا الشمالية)",
 "pygoscelis adeliae": "بطريق آديلي (بطاريق متوسطة الحجم توجد في مستعمرات كبيرة على ساحل آديلي في القارة القطبية الجنوبية)",
 "pyinma": "خشب بينما (خشب متين صلب نسبياً؛ بني محمر فاتح، ناعم ولامع)",
 "pyjama": "بيجامة, منامة ((عادة جمع) ملابس نوم فضفاضة للنوم أو الاسترخاء؛ لها سترة علوية وسروال) / بنطال منامة, سروال بيجامة (زوج من السراويل الفضفاضة المربوطة بحبل حول الخصر؛ يرتديه الرجال والنساء في بعض الدول الآسيوية)",
 "pyknic": "باطن البنية, ممتلئ البنية (له بنية ممتلئة ومكتنزة باللحم)\nمثال: مزحة عملية ثقيلة",
 "pyknic type": "بدانة البنية, بنية ممتلئة (مستدير وسمين وثقيل)",
 "pyknosis": "تغلظ النواة, تكنز (حالة تنكسية لنواة الخلية)",
 "pyknotic": "تغلظي, تكثفي (من أو يتعلق بالتغلظ (تكثف نواة الخلية))",
 "pylodictus olivaris": "سلور مسطح الرأس (سلور كبير في وسط الولايات المتحدة له رأس مسطح وفك بارز)",
 "pylon": "برج كهرباء, عمود ضغط عالي (برج فولاذي رأسي كبير يدعم خطوط الطاقة عالية الجهد) / صرح توجيه, علامة تحديد المسار (برج لتوجيه الطيارين أو تحديد نقطة الانعطاف في السباق)\nمثال: أبراج الكهرباء هدف مفضل للإرهابيين",
 "pyloric": "بوابي (متعلق بـ أو بالقرب من البواب (فتحة المعدة))",
 "pyloric sphincter": "مصرة البواب (العضلة العاصرة للبواب التي تفصل المعدة عن الاثني عشر)",
 "pyloric stenosis": "تضيق البواب (تضيق العضلة العاصرة البوابية مما يمنع مرور الطعام من المعدة إلى الاثني عشر)",
 "pyloric valve": "مصرة البواب (العضلة العاصرة للبواب التي تفصل المعدة عن الاثني عشر)",
 "pyloric vein": "وريد بوابي, وريد معدي أيمن (يتلقى أوردة من الأسطح العلوية للمعدة ويصب في الوريد البابي)",
 "pylorus": "بَوَّاب",
 "pyocyanase": "بيوسيناز (خليط أصفر مخضر من المضادات الحيوية يتم الحصول عليه من عصية القيح الأخضر)",
 "pyocyanin": "بيوسيانين (مضاد حيوي بلوري أزرق سام يوجد في القيح الأخضر)",
 "pyogenic": "مقيح, مولد للقيح (منتج للقيح)",
 "pyongyang": "بْيُونْيَانْغ",
 "pyorrhea": "تقيح اللثة, مرض ريغز (التهاب دواعم السن المزمن؛ التهاب قيحي في تجاويف الأسنان) / تقيح, سيلان القيح (خروج القيح)",
 "pyorrhea alveolaris": "تقيح اللثة, مرض ريغز (التهاب دواعم السن المزمن؛ التهاب قيحي في تجاويف الأسنان)",
 "pyorrhoea": "تقيح اللثة, مرض ريغز (التهاب دواعم السن المزمن؛ التهاب قيحي في تجاويف الأسنان) / تقيح, سيلان القيح (خروج القيح)",
 "pyracanth": "بيراكانثا, شوكة النار (أي من الشجيرات الشائكة المتنوعة من جنس بيراكانثا تحمل زهوراً بيضاء صغيرة تليها توت أحمر صلب أو برتقالي محمر)",
 "pyracantha": "بيراكانثا, شوكة النار (أي من الشجيرات الشائكة المتنوعة من جنس بيراكانثا تحمل زهوراً بيضاء صغيرة تليها توت أحمر صلب أو برتقالي محمر)",
 "pyralid": "عثة بيراليد (عثة استوائية عادة نحيلة الجسم طويلة الأرجل تعتبر يرقاتها آفات للمحاصيل)",
 "pyralid moth": "عثة بيراليد (عثة استوائية عادة نحيلة الجسم طويلة الأرجل تعتبر يرقاتها آفات للمحاصيل)",
 "pyramid": "هَرَم, أَهْرَام ((في الهندسة) منشور كثير السطوح، قاعدته مضلع، وأوجهه الأخرى مثلثات، قواعدها أضلاع مضلع القاعدة، ورؤوسها مجتمعة في نقطة واحدة خارجة عنه؛ بناء أثري بناه الفراعنة في مصر بالحجارة الصلبة، ذو قاعدة مربعة، له أربع واجهات، وكل واجهة مثلثة الشكل، تلتقي رؤوسها فتكون رأسًا واحدًا هو قمة الهرم)",
 "pyramid bugle": "عجوقة هرمية (نبات معمر دائم الخضرة أوروبي يشكل سجاداً)",
 "pyramid plant": "فراسيرا, كولومبو أمريكي",
 "pyramid scheme": "مخطط هرمي (مخطط احتيالي يتم فيه تجنيد أشخاص لدفع مدفوعات للشخص الذي جندهم بينما يتوقعون تلقي مدفوعات من الأشخاص الذين يقومون بتجنيدهم؛ عندما يفشل عدد المجندين…)",
 "pyramidal": "هَرَمِيّ (يشبه الهرم في الشكل)",
 "pyramidal bone": "عظم مثلثي (عظم رسغي يتمفصل مع العظام الحمصية والكلابية والهلالية)",
 "pyramidal motor system": "سبيل هرمي, مسلك هرمي (أي من الأعصاب الحركية المهمة على كل جانب من الجهاز العصبي المركزي التي تمتد من المناطق الحسية الحركية للقشرة عبر جذع الدماغ إلى العصبونات الحركية…)",
 "pyramidal tent": "خيمة هرمية (خيمة كبيرة على شكل هرم؛ يمكن أن تسع نصف دزينة من الأشخاص)",
 "pyramidal tract": "سبيل هرمي, مسلك هرمي (أي من الأعصاب الحركية المهمة على كل جانب من الجهاز العصبي المركزي التي تمتد من المناطق الحسية الحركية للقشرة عبر جذع الدماغ إلى العصبونات الحركية…)",
 "pyramidic": "هَرَمِيّ (يشبه الهرم في الشكل)",
 "pyramidical": "هَرَمِيّ (يشبه الهرم في الشكل)",
 "pyramidically": "بشكل هرمي (بطريقة أو شكل هرمي)\nمثال: تم تقليم الشجيرة بشكل هرمي",
 "pyramiding": "تسويق هرمي احتيالي (ممارسة تجارية احتيالية تنطوي على شكل من أشكال المخطط الهرمي)",
 "pyrausta nubilalis": "حفار الذرة, عثة حفار الذرة الأوروبي (موطنها الأصلي أوروبا؛ في أمريكا تحفر اليرقات في ساق وتاج الذرة ونباتات أخرى) / حفار الذرة (يرقة عثة حفار الذرة الأوروبي؛ آفة خطيرة للذرة)",
 "pyre": "كومة الحرق, محرقة الجثث (خشب مكدس لحرق جثة الميت كطقس جنائزي)",
 "pyrectic": "حموي, محموم (لديه حمى أو مسبب للحمى) / بيروجين, مولد الحمى (أي مادة يمكن أن تسبب ارتفاعاً في درجة حرارة الجسم)",
 "pyrene": "نواة الثمرة (الجويزة الصلبة الصغيرة لثمرة حسلية أو نووية؛ البذرة والغلاف الداخلي الصلب الذي يحيط بها) / بيرين",
 "pyrenees": "البَرَانِس",
 "pyrenees daisy": "أقحوان البرانس (نبات معمر في البرتغال مشابه لأقحوان المروج)",
 "pyrethrum": "أقحوان ملون, بيريثروم (نبات حديقة معمر يزهر في الربيع من أصل آسيوي له أوراق عطرية مقسمة بدقة وزهور بيضاء إلى وردية أرجوانية؛ مصدر لمبيد حشري) / بيرثروم, عاقر قرحا (بيرثروم أبيض الزهر من منطقة البلقان أوراقه الريشية بيضاء ومشعرّة حريرياً من الأسفل؛ مصدر لمبيد حشري؛ يوضع أحياناً في جنس أقحوان) / بيريثروم (مصنوع من رؤوس زهور نباتات البيريثروم المجففة)",
 "pyretic": "مسبب للحمى (يسبب الحمى)",
 "pyrex": "بيركس",
 "pyrexia": "حمى, سخونة (ارتفاع في درجة حرارة الجسم؛ غالباً ما يكون عرضاً للعدوى)",
 "pyridine": "بيريدين (قاعدة عضوية سائلة سامة عديمة اللون وقابلة للاشتعال ذات رائحة كريهة؛ تشتق عادة من الفحم)",
 "pyridium": "بيريديوم, فينازوبيريدين (مسكن (الاسم التجاري بيريديوم) يستخدم لعلاج التهابات المسالك البولية)",
 "pyridoxal": "بيريدوكسين, فيتامين ب6 (فيتامين ب ضروري لعملية التمثيل الغذائي للأحماض الأمينية والنشا)",
 "pyridoxamine": "بيريدوكسين, فيتامين ب6 (فيتامين ب ضروري لعملية التمثيل الغذائي للأحماض الأمينية والنشا)",
 "pyridoxamine 5'-phosphate": "بيريدوكسامين 5-فوسفات (فيتامين ب ضروري لاستقلاب الأحماض الأمينية والنشا)",
 "pyridoxine": "بيريدوكسين, فيتامين ب6 (فيتامين ب ضروري لعملية التمثيل الغذائي للأحماض الأمينية والنشا)",
 "pyridoxine 5'-phosphate": "بيريدوكسامين 5-فوسفات (فيتامين ب ضروري لاستقلاب الأحماض الأمينية والنشا)",
 "pyriform area": "باحة كمثرية (بنية عصبية على شكل كمثرى على جانبي الدماغ في الدماغ الشمي)",
 "pyriform lobe": "باحة كمثرية (بنية عصبية على شكل كمثرى على جانبي الدماغ في الدماغ الشمي)",
 "pyrilamine": "بيريلأمين (مضاد للهيستامين يستخدم لعلاج التهاب الأنف والحكة)",
 "pyrimidine": "بيريميدين (مركب عضوي حلقي غير متجانس ذو رائحة نفاذة) / بيريميدين (أي من عدة مركبات قاعدية مشتقة من البيريميدين)",
 "pyrite": "بايرايت الحديد, بايريت (معدن شائع (ثنائي كبريتيد الحديد) لونه أصفر شاحب)",
 "pyrites": "بيريت (أي من الكبريتيدات ذات المظهر المعدني المختلفة (ويعتبر البيريت أكثرها شيوعاً))",
 "pyrocellulose": "بيروسليلوز (نيتروسليلوز يحتوي على نيتروجين أقل من قطن البارود؛ يُستخدم في صنع البارود عديم الدخان)",
 "pyrocephalus rubinus mexicanus": "صائد الذباب القرمزي (صائد ذباب أمريكي استوائي يوجد شمالاً حتى جنوب تكساس وأريزونا؛ الذكر البالغ له ريش قرمزي ساطع وأسود)",
 "pyrochemical": "كيميائي حراري (من أو متعلق بـ أو ناتج عن تفاعلات كيميائية في درجات حرارة عالية)",
 "pyrochemical process": "عملية كيميائية حرارية, كيمياء حرارية (عمليات للتفاعلات الكيميائية عند درجات حرارة عالية)",
 "pyrochemistry": "عملية كيميائية حرارية, كيمياء حرارية (عمليات للتفاعلات الكيميائية عند درجات حرارة عالية)",
 "pyroelectric": "كهربائي حراري (متعلق بـ أو يظهر الكهرباء الحرارية)",
 "pyroelectric material": "مادة كهروحرارية (مادة قادرة على توليد جهد مؤقت عند تسخينها أو تبريدها)",
 "pyroelectrical": "كهربائي حراري (متعلق بـ أو يظهر الكهرباء الحرارية)",
 "pyroelectricity": "كهرباء حرارية (توليد شحنة كهربائية على بلورات معينة (مثل التورمالين) نتيجة لتغير في درجة الحرارة)",
 "pyrogallic": "بيروغالي (من أو متعلق بالبيروجالول)",
 "pyrogallic acid": "بيروجالول, حمض البيروجاليك (فينول بلوري سام لامع أبيض يستخدم لعلاج بعض الأمراض الجلدية وكمظهر فوتوغرافي)",
 "pyrogallol": "بيروجالول, حمض البيروجاليك (فينول بلوري سام لامع أبيض يستخدم لعلاج بعض الأمراض الجلدية وكمظهر فوتوغرافي)",
 "pyrogen": "بيروجين, مولد الحمى (أي مادة يمكن أن تسبب ارتفاعاً في درجة حرارة الجسم) / مادة قابلة للاشتعال (أي مادة تتميز بقابليتها الشديدة للاشتعال)",
 "pyrogenetic": "محم, مولد للحمى (ناتج عن الحمى أو منتج للحمى)",
 "pyrogenic": "صهيري, ناري (منتج تحت ظروف تنطوي على حرارة شديدة) / محم, مولد للحمى (ناتج عن الحمى أو منتج للحمى)\nمثال: الصخور النارية هي صخور تشكلت من التصلب من حالة منصهرة",
 "pyrogenous": "صهيري, ناري (منتج تحت ظروف تنطوي على حرارة شديدة) / محم, مولد للحمى (ناتج عن الحمى أو منتج للحمى)\nمثال: الصخور النارية هي صخور تشكلت من التصلب من حالة منصهرة",
 "pyrograph": "رسم بالحرق (تصميم يتم إنتاجه عن طريق الحرق على الخشب أو الجلد)",
 "pyrographer": "حارق الخشب, فنان الحرق على الخشب (فنان يمارس فن الحرق على الخشب)",
 "pyrographic": "بيروغرافي, رسم بالحرق (من أو متعلق بـ أو منتج بواسطة فن الحرق على الخشب)",
 "pyrography": "حفر على الخشب بالحرق, فن الحرق (فعل إنتاج رسومات على الخشب أو الجلد باستخدام أدوات ساخنة)",
 "pyrola": "بيرولا, شاي كندا",
 "pyrola americana": "وينترغرين كاذب (دائم الخضرة من شرق أمريكا الشمالية بأوراق جلدية والعديد من الزهور البيضاء)",
 "pyrola elliptica": "زنبق الوادي البري, ورقة الساق (نبات دائم الخضرة من أمريكا الشمالية بأزهار صغيرة وردية على شكل جرس وأوراق مستطيلة كانت تستخدم سابقاً كلصقات للساق)",
 "pyrola minor": "وينترغرين صغير (الوينترغرين الشائع ذو عناقيد كثيرة الزهور من الزهور البيضاء المشوبة بالوردي؛ أوروبا وأمريكا الشمالية)",
 "pyrola rotundifolia": "زنبق الوادي البري (دائم الخضرة بأوراق مستديرة وأزهار بيضاء كريمية عطرة جداً؛ موزعة على نطاق واسع في الأجزاء الشمالية من العالمين القديم والجديد)",
 "pyrola rotundifolia americana": "وينترغرين كاذب (دائم الخضرة من شرق أمريكا الشمالية بأوراق جلدية والعديد من الزهور البيضاء)",
