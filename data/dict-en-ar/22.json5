 "price-controlled": "مُسَعَّرٌ حُكُومِيًّا (يَخْضَعُ سِعْرُهُ لِلتَّنْظِيمِ أَوِ الرَّقَابَةِ الحُكُومِيَّة)",
 "price-fixing": "تثبيت الأسعار (السيطرة (عن طريق الاتفاق بين المنتجين) على سعر سلعة ما)",
 "price-to-earnings ratio": "مُضَاعِف الرِّبْحِيَّة, نِسْبَة السِّعْر إِلَى الأَرْبَاح ((سوق الأسهم) سعر السهم مقسوماً على أرباحه)",
 "priceless": "لَا يُقَدَّرُ بِثَمَن, نَفِيس (ذُو قِيمَةٍ مَادِّيَّةٍ أَوْ فِكْرِيَّةٍ أَوْ رُوحِيَّةٍ لَا تُحْصَى)",
 "pricelessness": "قيمة لا تقدر بثمن, نفاسة (الجودة الإيجابية لكون الشيء ثميناً ويفوق القيمة)",
 "pricey": "غَالٍ",
 "pricing": "تسعير (تقييم شيء ما من حيث سعره)",
 "pricing system": "نظام تسعير (نظام لتحديد أسعار السلع أو الخدمات)",
 "prick": "زُبّ, زُبْر (في : اللحية أو مقدمها؛ في : الأنف)",
 "pricker": "مخراز, مخراز المسامير (مخراز لعمل ثقوب صغيرة للمسامير الصغيرة أو البراغي الصغيرة) / حسكة, شوكة (طرف صغير مدبب حاد يشبه السنبلة على ساق أو ورقة)",
 "pricket": "أيل فتي (ذكر الأيل في سنته الثانية) / شمعدان ذو شوكة (مسمار معدني حاد لتثبيت الشمعة)",
 "pricking": "وخز (فعل الثقب بنقطة صغيرة)\nمثال: أعطى البالون وخزة صغيرة",
 "prickle": "حسكة, شوكة (طرف صغير مدبب حاد يشبه السنبلة على ساق أو ورقة)",
 "prickle cell": "خلية شائكة (خلية في الطبقة المنتشة للجلد (الطبقة الشائكة)؛ لها العديد من الأشواك والنتوءات المشعة)",
 "prickle-weed": "ديسمانثوس, ميموزا البراري (عشب معمر في براري أمريكا الشمالية له رؤوس كثيفة من الزهور البيضاء الصغيرة)",
 "prickleback": "سمك شائك الظهر (أسماك صغيرة (2-4 بوصات) عدوانية غالباً عديمة الحراشف وشائكة الظهر تعيش في المياه العذبة والساحلية الشمالية ولها طقوس تزاوج معقدة؛ موضوع لكثير من…) / شائكة الظهر (أسماك صغيرة مستطيلة تعيش في البحار الشمالية الضحلة؛ لها زعنفة ظهرية طويلة تتكون بالكامل من أشواك)",
 "prickliness": "شوكية, وخز (جودة التغطية بأشواك وخازة)",
 "prickling": "تنميل, وخز (إحساس جسدي يشبه العديد من اللسعات الصغيرة)",
 "prickly": "ذُو أَشْوَاك, شَائِك (يحمل أشواكًا أو إبرًا أو شعيرات واقية أو مُغطَّى بها) / حَادّ الطَّبْع, لَاسِع (شديد الانفعال وسريع الغضب)",
 "prickly ash": "شجرة الرماد الشائك (شجرة أسترالية ذات أوراق بسيطة متبادلة (عندما تكون صغيرة تكون ريشية ذات حواف مسننة شائكة) وسنابل إبطية نحيلة من الزهور البيضاء) / زانثوكسيليوم, فاغرة",
 "prickly custard apple": "غرافيولا, قشطة شائكة (شجرة استوائية أمريكية صغيرة تحمل فاكهة كبيرة عصيرية حامضة قليلاً)",
 "prickly heat": "حمو النيل, طفح حراري (انسداد القنوات العرقية أثناء الحرارة العالية والرطوبة)",
 "prickly lettuce": "خس شائك (خس بري حولي أوروبي له سيقان شائكة؛ عشبة ضارة مزعجة في أجزاء من الولايات المتحدة)",
 "prickly pear": "تِين شَوْكِيّ, بَلَس",
 "prickly pear cactus": "تين شوكي, صبار التين الشوكي (صباريات ذات مفاصل مسطحة شائكة وفاكهة بيضاوية صالحة للأكل في بعض الأنواع؛ غالباً ما تستخدم كعلف للماشية)",
 "prickly pine": "صنوبر الجبل المسطح, صنوبر شائك (صنوبر مرتفعات صغير ثنائي الإبر من شرق الولايات المتحدة (الأبالاش) له لحاء بني داكن متقشر وحراشف مخروطية مدببة الأشواك)",
 "prickly poppy": "خشخاش شائك (خشخاش سنوي من العالم القديم بزهور برتقالية حمراء وثمار شائكة) / أرجيمون, خشخاش شائك (أي نبات من جنس أرجيمون له أزهار بيضاء أو صفراء كبيرة وأوراق وسيقان وقرون شائكة؛ بشكل رئيسي في أمريكا الاستوائية)",
 "prickly shield fern": "سرخس الدرع الشائك, سرخس بهشية براون (سرخس أمريكي شمالي سعفه الجلدي دائم الخضرة تقريباً مغطى بحراشف تشبه القش البني الشاحب)",
 "prickly thrift": "غُمْلُول",
 "prickly-edged leaf": "ورقة شائكة الحافة (ورقة ذات حواف شائكة)",
 "prickly-leafed": "شَائِك الأَوْرَاق (ذو أوراق شائكة)",
 "prickly-leaved": "شَائِك الأَوْرَاق (ذو أوراق شائكة)",
 "prickly-seeded spinach": "سبانخ (نبات من جنوب غرب آسيا يزرع على نطاق واسع لأوراقه الخضراء الداكنة العصارية الصالحة للأكل)",
 "prickteaser": "غانية, لعوب (امرأة مغرية تستخدم جاذبيتها لاستغلال الرجال)",
 "pricy": "ثَمِين, غَالٍ (ذو سعر مرتفع)",
 "pride": "فَخْر (اعتزَّ أو تباهى بشيء يملكه أو بعمل قام به؛ زها على الآخرين وأبدى شعوره بالتفوق) / زُمْرَة\nمثال: أنا شديدة الفخر بأبي.",
 "pride month": "شَهْر الفَخْر (اسم مفرد: مدة زمنية قدرها 28 أو 29 أو 30 أو 31 يوما، والشَّهرُ جزءٌ من اثني عشر جزئا من السَنَة…)\nمثال: رمضان شهر حرام.",
 "pride of barbados": "زهرة الجنة, زهرة الطاووس (شجيرة استوائية أو شجرة صغيرة لها زهور صفراء إلى برتقالية حمراء مبهرجة؛ تصنف أحياناً في جنس بوانسيانا)",
 "pride of bolivia": "تيبو, جاكاراندا صفراء (شجرة شبه دائمة الخضرة من أمريكا الجنوبية بأوراق ريشية فردية وزهور صفراء ذهبية تزرع للزينة)",
 "pride of california": "جلبان رائع, فخر كاليفورنيا (نبات معمر شجيري كاليفورني له زهور وردية أو بنفسجية كبيرة؛ يزرع للزينة)",
 "pride of place": "مكان الصدارة (المكان الأول أو الأعلى أو الأكثر أهمية أو الأكثر تفاخراً)",
 "pride parade": "مسيرة فخر المثليين",
 "pride-of-india": "لاجرستروميا, وردة الهند (موطنها آسيا وأستراليا وجزر الهند الشرقية، حيث توفر خشباً يسمى بيينما؛ تستخدم في أماكن أخرى للزينة لزهورها الكبيرة المبهرجة) / أزدرخت, زنزلخت (شجرة من شمال الهند والصين لها أزهار أرجوانية وثمار صفراء صغيرة غير صالحة للأكل؛ تم توطينها في جنوب الولايات المتحدة كشجرة ظل)",
 "prideful": "مَغْرُور, فَخُور",
 "pridefulness": "فخر, كبرياء (شعور باحترام الذات والقيمة الشخصية)",
 "prie-dieu": "محربة, مقعد الركوع (مقعد منخفض للركوع عليه للصلاة)",
 "priest": "كَاهِن, قِسِّيس",
 "priest-doctor": "شامان, كاهن ساحر (في المجتمعات التي تمارس الشامانية: شخص يعمل كوسيط بين العالم المرئي وعالم الأرواح؛ يمارس السحر للشفاء أو العرافة)",
 "priest-penitent privilege": "سر الاعتراف, سر الكاهن والتائب (حق رجل الدين في رفض الكشف عن معلومات سرية تلقاها من شخص أثناء الاعتراف أو تبادلات مماثلة)",
 "priestcraft": "صنعة الكاهن, كهنوت (المهارات المتضمنة في عمل الكاهن) / كهنوتية (إشارة مهينة للكهنة الذين يستخدمون نفوذهم للسيطرة على الشؤون العلمانية أو السياسية)",
 "priestess": "كاهنة (امرأة كاهن)",
 "priesthood": "سلك الكهنوت, كهنوت (مجموعة الممارسين الدينيين المرسمين)",
 "priestlike": "كهنوتي (يليق بـ أو مميز للكاهن أو الكهنوت)\nمثال: تكرس كهنوتي لشعب أبرشيته",
 "priestly": "كهنوتي (يليق بـ أو مميز للكاهن أو الكهنوت) / كهنوتي (مرتبط بالكهنوت أو الكهنة)\nمثال: تكرس كهنوتي لشعب أبرشيته",
 "prig": "متعالي, متغطرس (شخص يُعتبر مغروراً ومزعجاً)",
 "priggish": "مُتَحَفِّظ بِإِفْرَاط, مُتَزَمِّت (مبالِغ في التمسّك باللياقة والتحفّظ)",
 "priggishly": "بادعاء الفضيلة, بتحذلق (بطريقة متحذلقة ومتزمتة)\nمثال: هذا الأستاذ يتصرف بتحذلق شديد - مثل مدير جلسة يحمل مطرقة!",
 "priggishness": "تزمت, تصنع (لياقة مبالغ فيها ومتغطرسة)",
 "prilosec": "أوميبرازول, بريلوسيك",
 "prim": "مُتَحَفِّظ بِإِفْرَاط, مُتَزَمِّت (مبالِغ في التمسّك باللياقة والتحفّظ) / مُتَصَنِّعٌ, مُتَكَلِّفٌ (مُتَصَنِّع في الرقة والتهذيب)",
 "prima": "تفاح بريما (يستخدم بشكل أساسي كتفاح للأكل)",
 "prima ballerina": "راقصة باليه أولى (راقصة باليه أنثى رائدة)",
 "prima donna": "ديفا, مغنية أوبرا رئيسية (مغنية أوبرا متميزة؛ نجمة أوبرا أنثى) / شخصية مغرورة (شخص مغرور ومتقلب المزاج)",
 "prima facie": "لِأَوَّل وَهْلَة, مَبْدَئِيًّا (من النظرة الأولى) / لِلْوَهْلَة الأُولَى (كما يبدو عند النظرة الأولى ظاهريًّا)",
 "primacy": "أولوية, صدارة (حالة كونه الأول في الأهمية)",
 "primaeval": "أَزَلِيّ, بِدْئِيّ (موجود منذ البداية؛ في أبكر مرحلة أو حالة أصلية)",
 "primal": "أَزَلِيّ, بِدْئِيّ (موجود منذ البداية؛ في أبكر مرحلة أو حالة أصلية) / أَسَاسِيّ, جَوْهَرِيّ (يخدم كعنصر أساسيّ لا غنى عنه)",
 "primality": "أولية (خاصية كون الرقم أولياً)",
 "primaquine": "بريماكوين (دواء صناعي مضاد للملاريا)",
 "primarily": "أساساً, بشكل رئيسي (في الغالب) / أساساً, في المقام الأول (ذو أهمية أولية)\nمثال: هو مهتم بشكل رئيسي بالفراشات",
 "primary": "أَوَّلِيّ",
 "primary amenorrhea": "انقطاع الطمث الأولي (تأخر بدء الحيض إلى ما بعد سن 18 عاماً)",
 "primary atypical pneumonia": "التهاب رئوي لانمطي (مرض تنفسي حاد يتميز بحمى عالية وسعال)",
 "primary care": "رعاية أولية (الرعاية الطبية التي يتم تلقيها عند أول اتصال بالنظام الطبي (قبل الإحالة إلى مكان آخر))",
 "primary care physician": "طبيب الرعاية الأولية (الطبيب الذي يقدم الرعاية الأولية)\nمثال: يعمل طبيب الرعاية الأولية كبوابة للنظام الطبي",
 "primary care provider": "أخصائي صحي, مقدم رعاية صحية (شخص يساعد في تحديد أو منع أو علاج المرض أو الإعاقة)",
 "primary cell": "خلية أولية, خلية جلفانية (خلية كهربائية تولد قوة دافعة كهربائية عن طريق تحويل غير عكسي للطاقة الكيميائية إلى طاقة كهربائية؛ ولا يمكن إعادة شحنها)",
 "primary censorship": "رقابة أولية (رقابة القوات المسلحة التي يقوم بها أفراد وحدة عسكرية على الاتصالات الشخصية للأشخاص المعينين في تلك الوحدة)",
 "primary coil": "ملف ابتدائي (ملف يشكل جزءاً من دائرة كهربائية بحيث يؤدي تغيير التيار فيه إلى حث تيار في دائرة مجاورة)\nمثال: التيار عبر الملف الابتدائي يحث تياراً في الملف الثانوي",
 "primary color": "لون أساسي (أي من ثلاثة ألوان يمكن الحصول منها على جميع الألوان الأخرى عن طريق المزج)",
 "primary color for light": "لون ضوئي أساسي (أي من الألوان الأساسية الثلاثة للضوء التي يمكن الحصول منها على جميع الألوان عن طريق المزج الجمعي)\nمثال: الألوان الأساسية للضوء هي الأحمر والأزرق والأخضر",
 "primary color for pigments": "لون صباغ أساسي (أي من ثلاثة أصباغ يمكن الحصول منها على جميع الألوان عن طريق المزج)\nمثال: الألوان الأساسية للأصباغ هي الأحمر والأزرق والأصفر",
 "primary colour": "لون أساسي (أي من ثلاثة ألوان يمكن الحصول منها على جميع الألوان الأخرى عن طريق المزج)",
 "primary colour for light": "لون ضوئي أساسي (أي من الألوان الأساسية الثلاثة للضوء التي يمكن الحصول منها على جميع الألوان عن طريق المزج الجمعي)\nمثال: الألوان الأساسية للضوء هي الأحمر والأزرق والأخضر",
 "primary colour for pigments": "لون صباغ أساسي (أي من ثلاثة أصباغ يمكن الحصول منها على جميع الألوان عن طريق المزج)\nمثال: الألوان الأساسية للأصباغ هي الأحمر والأزرق والأصفر",
 "primary dentition": "أسنان أولية, أسنان لبنية (مجموعة الأسنان المؤقتة (اللبنية))",
 "primary dysmenorrhea": "عسر الطمث الأولي (حيض مؤلم يكون جوهرياً للحيض وليس نتيجة لمرض)",
 "primary election": "اِنْتِخَابَات تَمْهِيدِيَّة (انتخابات أولية يتم فيها اختيار المندوبين أو المرشحين)",
 "primary feather": "رِيشَة أَوَّلِيَّة, قَوَادِم (واحدة من ريشات الطيران الرئيسية التي تبرز على الحافة الخارجية لجناح الطائر)",
 "primary health care": "رعاية صحية أولية (الرعاية الصحية التي يقدمها أخصائي الرعاية الصحية في أول اتصال للمريض بنظام الرعاية الصحية)",
 "primary quill": "رِيشَة أَوَّلِيَّة, قَوَادِم (واحدة من ريشات الطيران الرئيسية التي تبرز على الحافة الخارجية لجناح الطائر)",
 "primary school": "مَدْرَسَة اَلاِبْتِدَائِيَّة (الموضع الذي تُدَرَّس فيه العلوم؛ البناء فيه عدة غرف تُدَرَّسُ فيها العلوم وتمنح شهادة رسمية بعد إكمال الدروس)\nمثال: لا أحب المدرسة.",
 "primary sex character": "صفة جنسية أولية (الخصائص الجنسية المحددة وراثيًا والمرتبطة بالتكاثر (الأعضاء التناسلية وأعضاء التكاثر))",
 "primary sex characteristic": "صفة جنسية أولية (الخصائص الجنسية المحددة وراثيًا والمرتبطة بالتكاثر (الأعضاء التناسلية وأعضاء التكاثر))",
 "primary sexual characteristic": "صفة جنسية أولية (الخصائص الجنسية المحددة وراثيًا والمرتبطة بالتكاثر (الأعضاء التناسلية وأعضاء التكاثر))",
 "primary solid solution": "محلول جامد, محلول صلب (مادة صلبة متجانسة يمكن أن توجد عبر نطاق من المكونات الكيميائية؛ مكون من السبائك يتشكل عندما تندمج ذرات عنصر في بلورات معدن)",
 "primary subtractive color for light": "لون طرحي أساسي (أي من الألوان الثلاثة التي تعطي الألوان الأساسية للضوء بعد الطرح من الضوء الأبيض)\nمثال: الألوان الطرحية الأساسية للضوء هي الماجنتا (القرمزي) والسيان (السماوي) والأصفر",
 "primary subtractive colour for light": "لون طرحي أساسي (أي من الألوان الثلاثة التي تعطي الألوان الأساسية للضوء بعد الطرح من الضوء الأبيض)\nمثال: الألوان الطرحية الأساسية للضوء هي الماجنتا (القرمزي) والسيان (السماوي) والأصفر",
 "primary syphilis": "زهري أولي (المرحلة الأولى؛ تتميز بقرحة في موقع العدوى)",
 "primary tooth": "سن لبنية (واحدة من أولى الأسنان المؤقتة للثدييات الصغيرة (واحدة من 20 عند الأطفال))",
 "primary winding": "ملف ابتدائي (ملف يشكل جزءاً من دائرة كهربائية بحيث يؤدي تغيير التيار فيه إلى حث تيار في دائرة مجاورة)\nمثال: التيار عبر الملف الابتدائي يحث تياراً في الملف الثانوي",
 "primate": "رَئِيسِيَّات",
 "primateship": "رئاسة الأساقفة (منصب رئيس الأساقفة)",
 "primatology": "علم الرئيسيات (فرع علم الحيوان الذي يدرس الرئيسيات)",
 "primaxin": "بريماكسين (اسم تجاري لمضاد حيوي يعطى بالحقن)",
 "prime": "مُمْتَاز, فَاخِر",
 "prime factor": "عَامِل أَوَّلِيّ (العوامل الأولية لكمية ما هي جميع الكميات الأولية التي تقسم الكمية المعطاة بالتمام)",
 "prime interest rate": "سعر الفائدة الممتاز (سعر الفائدة على القروض قصيرة الأجل الذي تفرضه البنوك على عملائها التجاريين ذوي التصنيف الائتماني العالي)",
 "prime meridian": "خَطّ الزَّوَال, خَطّ الطُّول الرَّئِيسِيّ (كِتَابَة؛ ما يَصِل نقطتين أو أكثر)\nمثال: إرسم خط مستقيم.",
 "prime minister": "رَئِيس وُزَرَاء, رَئِيسَة وُزَرَاء",
 "prime mover": "السبب الأول, المحرك الأول (عامل هو سبب كل الأشياء ولكن ليس له سبب في حد ذاته)\nمثال: الله هو السبب الأول",
 "prime number": "عَدَد أَوَّلِيّ (مِقْدَار مَا يُعَدّ)\nمثال: كم عدد سكان الجزائر؟",
 "prime of life": "أوج العمر, ريعان (وقت النضج عندما تكون القوة والحيوية في ذروتها)",
 "prime quantity": "عَدَد أَوَّلِيّ, كَمِّيَّة أَوَّلِيَّة (عدد طبيعي له قاسمان طبيعيان متميزان فقط: 1 والعدد نفسه)",
 "prime time": "وقت الذروة (الساعات بين 7 و 11 مساءً التي يتوفر فيها أكبر جمهور للتلفزيون)",
 "primer": "كِتَاب تَمْهِيدِيّ (موضع تعليم الكتابة. الاستخدام الأصلي؛ مدرسة شبه رسمية لتعليم الأطفال الكِتَابَة والقِرَاءَة ومباديء الحِسَاب وبعض القُرَآن…)\nمثال: هذا الكتاب جديد",
 "primer coat": "بطانة, طلاء أولي (الطبقة الأولى أو التمهيدية من الطلاء أو الغراء المطبق على سطح ما)",
 "primeval": "أَزَلِيّ, بِدْئِيّ (موجود منذ البداية؛ في أبكر مرحلة أو حالة أصلية)",
 "primidone": "بريميدون, ميزولين (مضاد للاختلاج (الاسم التجاري ميزولين) يستخدم لعلاج نوبات الصرع الكبير والرعاش الأساسي)",
 "primigravida": "بكرية ((طب التوليد) امرأة حامل للمرة الأولى)",
 "priming": "تلقيم, تهيئة (فعل جعل الشيء جاهزاً) / بطانة, طلاء أولي (الطبقة الأولى أو التمهيدية من الطلاء أو الغراء المطبق على سطح ما) / بادئ إشعال, فتيل (أي مشعل يستخدم لبدء حرق الوقود الدافع)",
 "priming coat": "بطانة, طلاء أولي (الطبقة الأولى أو التمهيدية من الطلاء أو الغراء المطبق على سطح ما)",
 "primipara": "بكرية ((طب التوليد) امرأة ولدت طفلاً لأول مرة)",
 "primiparous": "بكرية (من أو متعلق بامرأة ولدت مرة واحدة فقط)",
 "primitive": "بدائي",
 "primitive art": "فن الدخلاء, فن الفطرة (نوع من الفن والإنشاءات الخارجية صنعها فنانون غير مدربين لا يعتبرون أنفسهم فنانين)",
 "primitive idealization": "مثالية بدائية (شكل غير واقعي للغاية وقديم من المثالية)",
 "primitive person": "إنسان بدائي (شخص ينتمي إلى مرحلة مبكرة من الحضارة)",
 "primitively": "بشكل بدائي (بأسلوب أو طريقة بدائية) / أصلاً, في البداية (فيما يتعلق بالأصل أو البداية)\nمثال: مسابك تدار بشكل بدائي إلى حد ما",
 "primitiveness": "بدائية, خشونة (حالة برية أو غير مهذبة)",
 "primitivism": "بدائية (نوع فني يتميز (أو يحاكي) الفنانين البدائيين أو الأطفال) / بدائية, خشونة (حالة برية أو غير مهذبة)",
 "primly": "بتأنق مفرط, بتزمت (بطريقة متزمتة وأنيقة بشكل مبالغ فيه)\nمثال: المعلمة الجديدة تنفر الأطفال بتصرفها بتزمت",
 "primness": "تزمت, تصنع (لياقة مبالغ فيها ومتغطرسة) / تزمت, تكلف (تواضع مفرط أو متصنع)",
 "primo": "الأَجْوَد, مِن الدَّرَجَة الأُولَى (الأفضل من نوعه) / الجزء الأول, بريمو (الجزء الرئيسي في الثنائي (خاصة ثنائي البيانو))",
 "primogenitor": "جد, سلف (سلف في الخط المباشر)",
 "primogeniture": "بكور, حق البكورة (حق الميراث الذي يعود حصرياً للابن الأكبر)",
 "primordial": "أَزَلِيّ, بِدْئِيّ (موجود منذ البداية؛ في أبكر مرحلة أو حالة أصلية)",
 "primordial dwarf": "قزم أولي (قزم ودروي ناتج صغر حجمه عن عيب وراثي؛ أجزاء الجسم والنمو العقلي والجنسي طبيعية)",
 "primordiality": "أولية, بدائية (صفة كون الشيء أولاً أو مبكراً جداً أو أصلياً)",
 "primordium": "بدائية, منشأ (عضو في مرحلته المبكرة من التطور؛ الأساس للتطور اللاحق)",
 "primorsky krai": "بْرِيمُورْسْكِي كْرَاي",
 "primping": "تأنق, تبرج (تزيين دقيق أو متكلف)\nمثال: استغرق التأنق وحده أكثر من ساعة",
 "primrose": "الربيعية, بريملة",
 "primrose jasmine": "ياسمين الزهرة الربيعية (شجيرة متسلقة دائمة الخضرة صفراء الأزهار من غرب الصين)",
 "primrose path": "حياة الدعة والملذات (حياة سهلة ومليئة بالمتعة)",
 "primula": "الربيعية, بريملة",
 "primula auricula": "أذن الدب, زهرة الربيع الألبية (زهرة ربيع صفراء الزهر موطنها جبال الألب؛ تزرع بشكل شائع)",
 "primula elatior": "زهرة الربيع العالية (زهرة ربيع أوراسية ذات أزهار صفراء مجمعة في خيمة أحادية الجانب)",
 "primula polyantha": "بوليانثوس (زهور الربيع الخاصة بائعي الزهور؛ تعتبر هجيناً معقداً مشتقاً من زهرة الربيع العالية وزهرة الربيع الشائعة)",
 "primula sinensis": "زهرة الربيع الصينية (زهرة ربيع آسيوية مزروعة)",
 "primula veris": "زهرة الربيع, كعب الثلج (زهرة ربيعية مبكرة شائعة في الجزر البريطانية ذات أزهار عطرة صفراء أو أرجوانية أحياناً)",
 "primula vulgaris": "زهرة الربيع الإنجليزية (نبات من غرب وجنوب أوروبا يزرع على نطاق واسع لأزهاره الصفراء الشاحبة)",
 "primum mobile": "السبب الأول, المحرك الأول (عامل هو سبب كل الأشياء ولكن ليس له سبب في حد ذاته)\nمثال: الله هو السبب الأول",
 "primus": "موقد بريموس, موقد تخييم (موقد طهي محمول يعمل بالكيروسين؛ يستخدمه المخيمون) / الأسقف الرئيس (الأسقف المترأس للكنيسة الأسقفية في اسكتلندا)",
 "primus stove": "موقد بريموس, موقد تخييم (موقد طهي محمول يعمل بالكيروسين؛ يستخدمه المخيمون)",
 "prince": "أَمِير",
 "prince albert": "معطف الأمير ألبرت (معطف فراك رجالي مزدوج الصدر)",
 "prince albert yew": "طقسوس الأمير ألبرت (طقسوس صغير ذو أوراق جذابة وفروع متدلية جزئياً يزرع كنبات زينة؛ جبال جنوب تشيلي)",
 "prince albert's yew": "طقسوس الأمير ألبرت (طقسوس صغير ذو أوراق جذابة وفروع متدلية جزئياً يزرع كنبات زينة؛ جبال جنوب تشيلي)",
 "prince charming": "فتى الأحلام, فارس الأحلام (شَابٌّ أوَّلَ شبابه بين المراهقة والرُّجولة؛ عبد، خادم)\nمثال: ترى الفتاة الفتى.",
 "prince consort": "أمير قرين (أمير هو زوج ملكة حاكمة)",
 "prince edward island": "جَزِيرَة الأَمِير إِدْوَارْد",
 "prince of wales": "أَمِير وِيلْز",
 "prince of wales heath": "خلنج أمير ويلز (شجيرة جنوب أفريقية تزرع لوفرة زهورها البيضاء)",
 "prince's pine": "شيميفيلا, صنوبر الأمير (أي من النباتات المتنوعة من جنس شيميفيلا)",
 "prince's-feather": "ريش الأمير, قطيفة أرجوانية (نبات حولي استوائي أمريكي طويل مبهرج ذو سيقان مشعرة وسنابل طويلة من الزهور الحمراء عادة فوق أوراق مشبعة باللون الأرجواني؛ غالباً ما تستخدم البذور كحبوب) / بطباط شرقي, ريشة الأمير (نبات حولي بأوراق بيضاوية عريضة وسنابل متدلية رفيعة من الزهور القرمزية؛ جنوب شرق آسيا وأستراليا؛ توطن في أمريكا الشمالية)",
 "prince's-plume": "ريش الأمير, قطيفة أرجوانية (نبات حولي استوائي أمريكي طويل مبهرج ذو سيقان مشعرة وسنابل طويلة من الزهور الحمراء عادة فوق أوراق مشبعة باللون الأرجواني؛ غالباً ما تستخدم البذور كحبوب) / ريشة الأمير, ستانليا (نبات معمر من جنوب غرب الولايات المتحدة له أوراق ريشية جلدية زرقاء خضراء وسنابل سميكة تشبه الريش من الزهور الصفراء؛ يوضع أحياناً في جنس كليوم) / بطباط شرقي, ريشة الأمير (نبات حولي بأوراق بيضاوية عريضة وسنابل متدلية رفيعة من الزهور القرمزية؛ جنوب شرق آسيا وأستراليا؛ توطن في أمريكا الشمالية)",
 "prince-of-wales feather": "ريشة أمير ويلز, سرخس الكريب (سرخس نيوزيلندي بسعف ريشي وسيقان صوفية كثيفة؛ يدرج أحياناً في جنس توديا)",
 "prince-of-wales fern": "ريشة أمير ويلز, سرخس الكريب (سرخس نيوزيلندي بسعف ريشي وسيقان صوفية كثيفة؛ يدرج أحياناً في جنس توديا)",
 "prince-of-wales plume": "ريشة أمير ويلز, سرخس الكريب (سرخس نيوزيلندي بسعف ريشي وسيقان صوفية كثيفة؛ يدرج أحياناً في جنس توديا)",
 "prince-of-wales'-heath": "خلنج أمير ويلز (شجيرة جنوب أفريقية تزرع لوفرة زهورها البيضاء)",
 "princedom": "إمارة (منطقة يحكمها أمير) / إمارة, رتبة الأمير (كرامة أو رتبة أو منصب الأمير)",
 "princeling": "أمير صغير (أمير شاب) / أمير دويلة (أمير صغير أو غير مهم يحكم إمارة غير مهمة)",
 "princely": "أَمِيرِيّ (له رتبة أمير أو يليق به) / فَاخِر, فَخْم (غنيّ بشكل استعراضي ومتفوّق في الجودة)",
 "princess": "أَمِيرَة",
 "princess feather": "بطباط شرقي, ريشة الأمير (نبات حولي بأوراق بيضاوية عريضة وسنابل متدلية رفيعة من الزهور القرمزية؛ جنوب شرق آسيا وأستراليا؛ توطن في أمريكا الشمالية)",
 "princess pine": "تنوب أرضي, صنوبر الأميرة (صنف من طحلب النادي، يسمى عادة الصنوبر الأرضي، أو صنوبر الأمير، أو صنوبر الأميرة)",
 "princess royal": "الأميرة الملكية (الابنة الكبرى لملك بريطاني)",
 "princewood": "دردار إسباني, كورديا (شجرة أمريكية استوائية كبيرة من جنس كورديا تزرع لزهورها البيضاء الكريمية الوفيرة وخشبها القيم) / خشب الأمير, دردار إسباني (شجرة خشب أمريكية استوائية)",
 "principal": "رَئِيسِيّ / مُدِير, مُدِيرَة (الشخص الذي أدار، جمعه مُدِيرُون ومُدِيرِين؛ مهنة يتولى صاحبها إدَارَة شؤون جهة ما. جمعه مُدَرَاء) / مُوَكِّل\nمثال: زيري هو المدير.",
 "principal axis": "محور بصري, محور رئيسي (خط يمر عبر مركز انحناء العدسة بحيث لا ينعكس الضوء ولا ينكسر)\nمثال: في العين الطبيعية، المحور البصري هو الاتجاه الذي تُرى فيه الأشياء بوضوح أكبر",
 "principal diagonal": "قطر رئيسي (قطر المصفوفة المربعة الممتد من المدخل العلوي الأيسر إلى المدخل السفلي الأيمن)",
 "principal investigator": "باحث رئيسي (العالم المسؤول عن تجربة أو مشروع بحثي)",
 "principal sum": "رأس المال الأساسي, مبلغ أصلي (رأس المال مقابل الدخل المستمد منه)",
 "principality": "إمَارَة (الإمَارَة : منصِب الأمير؛ الإمَارَة: دَوْلَة أو مَنْطِقَة أو جُزْء من الأَرْض يحكمه أَمِير)",
 "principally": "أساساً, بشكل رئيسي (في الغالب)\nمثال: هو مهتم بشكل رئيسي بالفراشات",
 "principalship": "إدارة المدرسة, منصب المدير (وظيفة المدير)",
 "principen": "أمبيسيلين (بنسلين شبه صناعي (الأسماء التجارية برينسيبين وبوليسيلين وغيرها))",
 "principle": "مَبْدَأ, قاعِدَة (أَسَاس، أَصْل؛ مُسَلَّمَة، اِفْتِرَاض، ما يسلّم به لوضوحه)",
 "principle of equivalence": "مبدأ التكافؤ ((فيزياء) المبدأ القائل بأن المراقب ليس لديه طريقة للتمييز بين ما إذا كان مختبره في مجال جاذبية منتظم أو في إطار مرجعي متسارع)",
 "principle of liquid displacement": "مبدأ إزاحة السوائل ((هيدروستاتيكا) حجم الجسم المغمور في مائع يساوي حجم المائع المزاح)",
 "principle of parsimony": "مبدأ الإيجاز, نصل أوكام (المبدأ القائل بأنه لا ينبغي مضاعفة الكيانات دون داع؛ يجب تفضيل أبسط النظريتين المتنافستين)",
 "principle of relativity": "مبدأ النسبية ((فيزياء) قانون عالمي ينص على أن قوانين الميكانيكا لا تتأثر بحركة مستقيمة منتظمة لنظام الإحداثيات الذي يتم الرجوع إليه)",
 "principle of superposition": "مبدأ التراكب (إزاحة أي نقطة بسبب تراكب أنظمة الموجات تساوي مجموع إزاحات الموجات الفردية عند تلك النقطة) / مبدأ التراكب, مبدأ التعاقب الطبقي ((جيولوجيا) المبدأ القائل بأنه في سلسلة من الصخور الرسوبية الطبقية، تكون الطبقة السفلى هي الأقدم)\nمثال: مبدأ التراكب هو أساس النظرية الموجية للضوء",
 "principled": "صاحب مبدأ, مبدئي (قائم على أو يظهر معايير محددة موضوعياً للصواب أو الأخلاق)\nمثال: البراغماتية المبدئية والمصلحة غير المبدئية",
 "pringle": "بْرِينْجَلْز",
 "prinivil": "زيستريل, ليزينوبريل (دواء مثبط للإنزيم المحول للأنجيوتنسين (الأسماء التجارية زيستريل وغيرها) يعطى كخافض لضغط الدم وبعد النوبات القلبية)",
 "print": "طَبَعَ (طَبَعَ الله الخلقَ : أَنشأَهُ؛ طبَعَت الدَّوْلةُ النَّقْد : صاغتْه ونقشته)\nمثال: بالطبع هي مزحة!",
 "print buffer": "مخزن الطابعة (ذاكرة مؤقتة تخزن البيانات حتى تصبح الطابعة جاهزة)",
 "print media": "الصحافة المطبوعة, وسائل الإعلام المطبوعة (وسيط ينشر المواد المطبوعة)",
 "print run": "مدة الطباعة (الفترة التي تعمل فيها المطابع لإنتاج عدد من صحيفة)",
 "print seller": "بائع مطبوعات فنية (شخص يبيع النقوش والمحفورات وغيرها)",
 "print shop": "مطبعة (مكان عمل يتم فيه الطباعة)",
 "printable": "صالح للطباعة, قابل للنشر (صالح للنشر لخلوه من المواد المرفوضة أخلاقياً أو قانونياً)\nمثال: لغة صالحة للنشر",
 "printed circuit": "دائرة مطبوعة (دائرة حاسوبية تتكون من تجميع فرعي إلكتروني؛ يتم تصفيح الموصلات النحاسية على لوحة عازلة ويتم إدخال مكونات الدائرة في الثقوب ولحامها بالغمس)",
 "printed symbol": "رمز مطبوع, رمز مكتوب (رمز مكتوب أو مطبوع)",
 "printer": "طَابِعَة",
 "printer cable": "كابل الطابعة (كابل بين حاسوب وطابعة)",
 "printer's devil": "صبي المطبعة (متدرب في مؤسسة طباعة)",
 "printer's ink": "حبر الطباعة (حبر شبه صلب سريع الجفاف مصنوع خصيصاً للاستخدام في الطباعة)",
 "printing": "طِبَاعَة",
 "printing business": "شركة طباعة, مطبعة تجارية (شركة تقوم بالطباعة التجارية)",
 "printing company": "شركة طباعة, مطبعة تجارية (شركة تقوم بالطباعة التجارية)",
 "printing concern": "شركة طباعة, مطبعة تجارية (شركة تقوم بالطباعة التجارية)",
 "printing house": "مَطْبَعَة",
 "printing ink": "حبر الطباعة (حبر شبه صلب سريع الجفاف مصنوع خصيصاً للاستخدام في الطباعة)",
 "printing machine": "آلة طباعة, طابعة (آلة تقوم بالطباعة)",
 "printing operation": "عملية طباعة (عملية تتحكم في طباعة أو عرض المعلومات)",
 "printing press": "آلَةُ طِبَاعَة, آلَةُ الطِّبَاعَة (الفارسية: ماشين؛ الأوردية: مشين)\nمثال: نسى زيري الآلة.",
 "printing process": "طباعة, عملية الطباعة (الاستنساخ عن طريق وضع الحبر على الورق كما في النشر)",
