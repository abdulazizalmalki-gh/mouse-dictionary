 "pueblo": "بويبلو (قرية جماعية بناها الهنود في جنوب غرب الولايات المتحدة) / بويبلو (فرد من أي من شعوب الهنود الأمريكيين التي أطلق عليها الإسبان اسم 'بويبلوس' لأنهم يعيشون في قرى مبنية من الطين والصخور)",
 "puebloan person": "بويبلو (فرد من أي من شعوب الهنود الأمريكيين التي أطلق عليها الإسبان اسم 'بويبلوس' لأنهم يعيشون في قرى مبنية من الطين والصخور)",
 "pueraria lobata": "كودزو (كرمة سريعة النمو من شرق آسيا لها جذور نشوية درنية وأوراق ثلاثية مشعرة وعناقيد من الزهور الأرجوانية تليها قرون مشعرة طويلة تحتوي على العديد من البذور؛…)",
 "puerile": "سَاذَج, صِبْيَانِيّ (يُظهر أو يوحي بافتقار إلى النضج) / صبياني, طفولي (من أو مميز للطفل (بمعنى سلبي غالباً))\nمثال: تنفس طفولي",
 "puerility": "صبيانية, طفولية (خاصية مميزة للطفل) / طفولة (حالة الطفل بين الرضاعة والمراهقة)",
 "puerpera": "نفساء (امرأة في حالة الولادة أو بعد ذلك بقليل)",
 "puerperal": "نفاسي (يتعلق بالولادة أو يحدث في وقتها أو بعدها بفترة وجيزة، أو بالمرأة التي ولدت حديثاً)",
 "puerperal fever": "حمى النفاس (شكل خطير من الإنتان تصاب به المرأة أثناء الولادة أو الإجهاض (يُعزى عادةً إلى ظروف غير صحية)؛ كان واسع الانتشار سابقًا ولكنه الآن غير شائع)",
 "puerperium": "اَلنِّفَاس",
 "puerto galera": "بويرتو جاليرا",
 "puerto rican": "بورتوريكي (مواطن أو مقيم في بورتوريكو)",
 "puerto rico": "بُورْتُو رِيكُو, بُورْتُورِيكُو",
 "puff": "زفر, نفخ (زفير قوي عن طريق الأنف أو الفم) / سحبة, شفطة (استنشاق بطيء (كما في دخان التبغ)) / مُكَوَّر, مُنْتَفِخ (مجموع بحيث يبرز بامتلاء) / بف, مقعد عثماني (وسادة سميكة تستخدم كمقعد)\nمثال: أعطى أنفه نفخة قوية",
 "puff adder": "ثعبان خنزيري الأنف (ثعبان غير ضار من أمريكا الشمالية ذو أنف مقلوب؛ قد ينشر رأسه ورقبته أو يتظاهر بالموت عند الانزعاج) / أفعى نافخة (أفعى أفريقية كبيرة تنفخ جسمها عند الانزعاج)",
 "puff batter": "عجين الشو, عجين منتفخ سائل (عجين سائل لصنع أغلفة مجوفة خفيفة لتحتوي حشوات مختلفة)",
 "puff of air": "نسمة خفيفة, نفخة هواء (هبة هواء خفيفة قصيرة)",
 "puff paste": "باف باستري, عجين مورق (عجين يستخدم للمعجنات الغنية المورقة الخفيفة جداً)",
 "puff pastry": "عجينة منتفخة",
 "puffball": "كرة الأرض, كمأة كاذبة (أي من الفطريات المختلفة من جنس سكليروديرما لها أجسام ثمرية تحت أرضية صلبة الجلد تشبه الكمأة) / فطر نفاث, فطر نفاث حقيقي (أي من الفطريات المختلفة من فصيلة ليكوبيرداسيا التي يطلق جسمها الثمري المستدير سحابة من الأبواغ عند النضج)",
 "puffbird": "طائر النفخة (طائر أمريكي استوائي بني اللون له رأس كبير بريش منفوش)",
 "puffed": "مُكَوَّر, مُنْتَفِخ (مجموع بحيث يبرز بامتلاء)",
 "puffed rice": "أرز منفوخ (حبات أرز منتفخة)",
 "puffed wheat": "قمح منفوخ (حبات قمح منتفخة)",
 "puffer": "سمكة منتفخة, ينفوخ (أي من الأسماك البحرية العديدة التي يمكن لجسمها الشائك الممدود أن ينفخ نفسه بالماء أو الهواء ليشكل كرة؛ تحتوي عدة أنواع على سم عصبي قوي؛ مرتبطة…) / سمك ينفوخ, سمكة منتفخة (طعام شهي ولكنه خطير جداً بسبب سم عصبي قوي في المبايض والكبد)",
 "pufferfish": "سمكة منتفخة, ينفوخ (أي من الأسماك البحرية العديدة التي يمكن لجسمها الشائك الممدود أن ينفخ نفسه بالماء أو الهواء ليشكل كرة؛ تحتوي عدة أنواع على سم عصبي قوي؛ مرتبطة…) / سمك ينفوخ, سمكة منتفخة (طعام شهي ولكنه خطير جداً بسبب سم عصبي قوي في المبايض والكبد)",
 "puffery": "مبالغة دعائية (ثناء متملق (خاصة عند استخدامه للأغراض الترويجية))",
 "puffin": "بفن (أي من جنسين من الطيور البحرية الشمالية ذات رقاب قصيرة ومناقير مضغوطة زاهية الألوان)",
 "puffiness": "انْتِفَاخ, تَبَاهِي (انعدام الأناقة نتيجة التفاخر والغرور وانتفاخ الذات) / انتفاخ, تضخم (بروز غير طبيعي أو تضخم موضعي)",
 "puffing": "نخير, نفخ (فعل الزفير بقوة) / نفث الدخان (نفخ دخان التبغ في الهواء)\nمثال: لقد ملأوا الغرفة بالدخان بنفثهم المستمر",
 "puffinus puffinus": "جلم الماء مانكس (جلم ماء صغير أسود وأبيض شائع في شمال شرق المحيط الأطلسي)",
 "puffy": "ذُو هَبَّات, هَبُوب (يَهُبّ عَلَى شَكْل هَبَّات أَوْ نَفَحَات مُتَقَطِّعَة) / مُتَوَرِّم, مُنْتَفِخ (مُتَمَدِّد بِشَكْل غَيْر طَبيعِيّ بِسَبَب السَّوائِل أو الغاز) / مُنَفَّش, مُنْتَفِخ (منفوخ وبارز؛ يُستخدم لتسريحة الشعر أو الملابس)",
 "pug": "بَاك",
 "pug nose": "أنف أفطس (أنف قصير؛ مسطح ومقلوب في النهاية)",
 "pug-dog": "كلب البج (سلالة صغيرة مدمجة ناعمة المعطف من أصل آسيوي لها ذيل مجعد بإحكام وخطم عريض مسطح مجعد)",
 "pug-faced": "أَفْطَس الوَجْه (ذو وجه مسطح مجعد كوجه كلب البَج)",
 "pug-nose": "أَفْطَس, قَصِير الأَنْف (ذو أنف قصير وأفطس)",
 "pug-nosed": "أَفْطَس, قَصِير الأَنْف (ذو أنف قصير وأفطس)",
 "pugach": "پوجاتش",
 "pugilism": "ملاكمة (القتال بالقبضات)",
 "pugilist": "مُلَاكِم",
 "pugilistic": "ملاكمي (من أو متعلق بالملاكمة أو الملاكمين)\nمثال: مهنة في الملاكمة",
 "pugnacious": "شَرِس, عَنِيف (مستعد وقادر على اللجوء إلى القوة أو العنف) / عَنِيد, مُتَجَلِّد (قاسٍ وغليظ بفعل الخبرة والتجربة)",
 "pugnaciously": "بشكل مشاكس, بعدوانية (بطريقة عدوانية)",
 "pugnacity": "عدوانية, ولع بالقتال (ميل طبيعي للعداء)",
 "puissance": "بأس, سطوة (القوة للتأثير أو الإكراه)\nمثال: سطوة الصوت العمالي",
 "puissant": "ذُو سَطْوَة, نَافِذ (قوي أو ذو نفوذ واسع)",
 "pujunan": "لغة ميدو (لغة بينوتية يتحدث بها شعب ميدو)",
 "pujunan language": "لغة ميدو (لغة بينوتية يتحدث بها شعب ميدو)",
 "puka": "بوكا (شجرة نيوزيلندية صغيرة مستديرة الرأس ذات أوراق راتنجية كبيرة وعناقيد من الزهور البيضاء المخضرة) / بوكا, غريسيلينيا ساطعة (شجيرة أو شجرة صغيرة من أمريكا الجنوبية لها أوراق دائمة الخضرة لامعة طويلة وعناقيد من الزهور الخضراء أو الصفراء)",
 "puke": "حقير, دنيء (شخص يُعتبر حقيراً أو مُزدرى) / قيء (المادة التي يتم إخراجها عند التقيؤ)\nمثال: وحده الدنيء يفعل ذلك",
 "puking": "استفراغ, تقيؤ (الفعل الانعكاسي لقذف محتويات المعدة عبر الفم)",
 "pukka": "أَصِيل, مِنَ الطِّرَاز الأَوَّل (من الدرجة الأولى وأصيل تمامًا)",
 "puku": "بوكو (ظبي أفريقي وثيق الصلة بظبي الماء)",
 "pul": "بول (100 بول تساوي 1 أفغاني في أفغانستان)",
 "pula": "بولا (وحدة المال الأساسية في بوتسوانا)",
 "pulasan": "بولاسان (فاكهة لشجرة هندية شرقية تشبه الرامبوتان ولكنها أحلى) / بولاسان, شجرة البولاسان (شجرة فاكهة من جزر الهند الشرقية تحمل فاكهة تشبه الرامبوتان ولكنها أحلى)",
 "pulasan tree": "بولاسان, شجرة البولاسان (شجرة فاكهة من جزر الهند الشرقية تحمل فاكهة تشبه الرامبوتان ولكنها أحلى)",
 "pulassan": "بولاسان (فاكهة لشجرة هندية شرقية تشبه الرامبوتان ولكنها أحلى) / بولاسان, شجرة البولاسان (شجرة فاكهة من جزر الهند الشرقية تحمل فاكهة تشبه الرامبوتان ولكنها أحلى)",
 "pulchritude": "جمال جسدي, حسن (الجمال الجسدي (خاصة للمرأة))",
 "pulchritudinous": "فَائِق الحُسْن (يوصف به الأشخاص فقط؛ ذو جمال جسدي عظيم)",
 "pulex irritans": "برغوث الإنسان (أكثر البراغيث شيوعاً التي تهاجم البشر)",
 "pulicaria dysenterica": "برغوثية, بوليكاريا (عشب أوراسي معمر مشعر ذو أزهار صفراء تشبه الأقحوان يشتهر بقدرته على القضاء على البراغيث أو طردها)",
 "pull": "جَرَّ, سَحَبَ (جَرَّ الحيوانَ وغيرَه: جذبه وسحبه؛ جَرَّ أذيالَه: تبختر، زها بنفسه، اختال)\nمثال: اضطررت إلى جر سامي.",
 "pull an all-nighter": "سهر طول الليل ((سَهِرَ) يَسْهَرَ سَهَرًا: لَمْ ينَمْ كلَّ اللَّيْل أَو بَعْضَه؛ (سَهِرَ): أَرِق)\nمثال: إنها معتادة على السهر.",
 "pull chain": "سلسلة سحب (سلسلة (عادة بمقبض في نهايتها) يتم سحبها لتشغيل آلية ما (مثل تدفق المرحاض))",
 "pull out": "عَزَلَ (فَصَلَ، فرَز، أَبْعَدَ؛ أَبْعَدَ، نَحَّى)\nمثال: جو بايدن طالب الكونغرس بعزل ترامب.",
 "pull-in": "مقهى على الطريق (مقهى على جانب الطريق خاصة لسائقي الشاحنات)",
 "pull-off": "استراحة طريق, موقف جانبي (منطقة مبلطة مخصصة بجانب طريق رئيسي حيث يمكن للسيارات التوقف مؤقتاً)",
 "pull-through": "حبل تنظيف السبطانة (أداة تنظيف تتكون من خرقة زيتية مثبتة بحبل وثقل؛ تُسحب عبر سبطانة البندقية أو المسدس لتنظيفها)",
 "pull-up": "تمرين العقلة (تمرين للذراع يتم بسحب النفس للأعلى على قضيب أفقي حتى يصبح الذقن بمستوى القضيب) / مقهى على الطريق (مقهى على جانب الطريق خاصة لسائقي الشاحنات)",
 "pullback": "انسحاب تكتيكي, تراجع ((عسكرية) فعل التراجع (خاصة الانسحاب المنظم للقوات)) / مربط ستارة (جهاز (مثل حلقة زخرفية من الحبل أو القماش) لحمل أو سحب شيء ما للخلف)\nمثال: من المتوقع أن يشمل الانسحاب أكثر من 25000 جندي",
 "puller": "جارّ, ساحب (شخص يسحب أو يجر في محاولة لتحريك شيء ما) / ساحب (شخص يطبق قوة لإحداث حركة تجاه نفسه)",
 "pullet": "فَرُّوجَة",
 "pulley": "مَنْجُور",
 "pulley block": "بكرة (آلة بسيطة تتكون من عجلة ذات أخدود يمكن أن يمر فيه حبل لتغيير اتجاه أو نقطة تطبيق القوة المطبقة على الحبل)",
 "pulley-block": "بكرة (آلة بسيطة تتكون من عجلة ذات أخدود يمكن أن يمر فيه حبل لتغيير اتجاه أو نقطة تطبيق القوة المطبقة على الحبل)",
 "pulling": "جر, سحب (فعل السحب؛ تطبيق قوة لتحريك شيء تجاهك أو معك)\nمثال: جعله السحب لأعلى التل يتنفس بصعوبة",
 "pulling out": "الجماع المقطوع, العزل (طريقة لتحديد النسل يتم فيها بدء الجماع ولكن يتم سحب القضيب عمداً قبل القذف)",
 "pullman": "عربة بولمان (عربة ركاب فاخرة؛ للسفر النهاري أو الليلي)",
 "pullman car": "عربة بولمان (عربة ركاب فاخرة؛ للسفر النهاري أو الليلي)",
 "pullman porter": "شيّال القطار, عامل خدمة القطار (موظف سكة حديد يساعد الركاب (خاصة في عربات النوم))",
 "pullorum disease": "مرض بولوروم (مرض بكتيري خطير يصيب الدجاج الصغير)",
 "pullout": "انسحاب, فك الاشتباك (وقف عمل عسكري مع عدو)",
 "pullover": "مِعْطَف, كِنْزَة",
 "pullulation": "تكاثر سريع, توالد (زيادة سريعة وغزيرة) / تبرعم (تكاثر لاجنسي يصبح فيه نمو محلي على سطح أو في جسم الأصل فرداً منفصلاً)",
 "pulmonary": "رِئَوِيّ",
 "pulmonary anthrax": "جمرة خبيثة رئوية (شكل من أشكال عدوى الجمرة الخبيثة المكتسبة عن طريق استنشاق الغبار المحتوي على البكتيريا)",
 "pulmonary artery": "شريان رئوي (واحد من شريانين (فرعي الجذع الرئوي) يحملان الدم الوريدي من القلب إلى الرئتين)",
 "pulmonary circulation": "دَوْرَة دَمَوِيَّة صُغْرَى (في غرب العراق على نهر الفرات قرب الحدود السورية؛ حَيّ في جنوب بغداد تقع فيه محطة تكرير للنفط تسمّى بإسمه)\nمثال: خضع زيد لدورة مكثفة",
 "pulmonary congestion": "احتقان رئوي (احتقان في الرئتين)",
 "pulmonary embolism": "انصمام رئوي (انسداد الشريان الرئوي بمادة غريبة أو بجلطة دموية)",
 "pulmonary emphysema": "انتفاخ الرئة (حالة غير طبيعية للرئتين تتميز بانخفاض وظيفة الجهاز التنفسي)",
 "pulmonary plexus": "ضفيرة رئوية (واحدة من ضفيرتين عصبيتين ذاتيتين في كل رئة)",
 "pulmonary reserve": "احتياطي رئوي (الحجم الإضافي للهواء الذي يمكن للرئتين استنشاقه وزفيره عند التنفس إلى أقصى سعة في أوقات الإجهاد)",
 "pulmonary stenosis": "تضيق رئوي (تضيق غير طبيعي للفتحة المؤدية إلى الشريان الرئوي من البطين الأيمن)",
 "pulmonary trunk": "جذع رئوي (الشريان الذي يحمل الدم الوريدي من البطين الأيمن للقلب وينقسم إلى الشرايين الرئوية اليمنى واليسرى)",
 "pulmonary tuberculosis": "تدرن رئوي, سل رئوي (يشمل الرئتين مع هزال تدريجي للجسم)",
 "pulmonary valve": "صمام رئوي (صمام هلالي بين البطين الأيمن والشريان الرئوي؛ يمنع الدم من التدفق من الشريان عائداً إلى القلب)",
 "pulmonary vein": "وريد رئوي (أي من أربعة أوردة تحمل الدم الشرياني من الرئتين إلى الأذين الأيسر للقلب)",
 "pulmonic": "رئوي (يتعلق بالرئتين أو يؤثر عليهما)\nمثال: مرض رئوي",
 "pulmonic plague": "طاعون رئوي (شكل سريع التطور ومميت غالبًا من الطاعون يمكن أن ينتشر عبر الهواء من شخص لآخر؛ يتميز بإصابة الرئة مع قشعريرة ونفث دموي وحمى شديدة)",
 "pulp": "لب (الجزء الداخلي الرخو للسن) / مجلة إثارة, مجلة رخيصة (مجلة غير مكلفة مطبوعة على ورق رديء الجودة) / عَصِيدَة, لُبّ (أي كتلة ناعمة أو رطبة) / لب, لحم الفاكهة (جزء طري رطب من الفاكهة)\nمثال: سحقه حتى أصبح لباً",
 "pulp cavity": "تجويف اللب (التجويف المركزي للسن الذي يحتوي على اللب (بما في ذلك قناة الجذر))",
 "pulp magazine": "مجلة إثارة, مجلة رخيصة (مجلة غير مكلفة مطبوعة على ورق رديء الجودة)",
 "pulpiness": "رخاوة لبية, هريسية (ليونة لبية مهروسة)",
 "pulpit": "مِنْبَر",
 "pulpwood": "خشب اللب (خشب لين يستخدم لصنع الورق)",
 "pulpy": "طَرِيّ, لُبِّيّ (يُشْبِهُ اللُّبَّ أَوِ الثَّمَرَ المُفْرِطَ النُّضْجِ؛ لَا يَتَّسِمُ بِالصَّلَابَةِ)",
 "pulque": "بولكي (مشروب مكسيكي مخمر من عصير نباتات أغاف متنوعة خاصة الماغوي)",
 "pulsar": "نباض",
 "pulsatilla occidentalis": "زهرة الفصح الغربية (نوع نباتي عشبي من غرب أمريكا الشمالية)",
 "pulsatilla patens": "زهرة الفصح الأمريكية, شقائق النعمان البراري (نبات معمر قصير مشعر ذو أزهار زرقاء بنفسجية أو ليلكية في أوائل الربيع؛ أمريكا الشمالية وسيبيريا)",
