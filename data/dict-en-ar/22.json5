 "pro-choice": "مؤيد لحق الاختيار, مؤيد للإجهاض (يدافع عن حق المرأة في التحكم بجسدها (خاصة حقها في الإجهاض المتعمد))",
 "pro-choice faction": "المؤيدون لحرية الاختيار, مؤيدو الإجهاض (أولئك الذين يجادلون بأن قرار إجراء الإجهاض يجب أن تتخذه الأم)",
 "pro-inflammatory": "مُحَفِّز لِلالْتِهاب (يَميل إلى إثارَة الالْتِهاب أو تَحْفيزِه)",
 "pro-life": "مؤيد للحياة, مناهض للإجهاض (يدافع عن الحماية القانونية الكاملة للأجنة (خاصة معارضة تقنين الإجهاض المتعمد))",
 "pro-life faction": "المؤيدون للحياة, مناهضو الإجهاض (أولئك الذين يجادلون بأن الإجهاض هو قتل ويجب حظره)",
 "pro-lifer": "مؤيد للحياة (مدافع عن الحماية القانونية الكاملة للأجنة؛ شخص يعارض الإجهاض المقنن)",
 "pro-rape": "مؤيد للاغتصاب (مؤيد للاغتصاب، تستخدم بشكل ازدرائي)",
 "proaccelerin": "برو أكسيليرين (عامل تخثر)",
 "proactive": "وِقَائِيّ, استباق الْأَحْدَاث",
 "probabilism": "احتمالية ((فلسفة) المذهب القائل (بما أن اليقين غير ممكن) فإن الاحتمال هو أساس كافٍ للاعتقاد والعمل) / مذهب الاحتمالية (نظام كاثوليكي في دراسة الحالات الأخلاقية يرى أنه عند اختلاف آراء الخبراء، يمكن للفاعل اتباع أي رأي محتمل بقوة يرغب فيه حتى لو كان هناك رأي مختلف أكثر…)",
 "probabilistic": "احتمالي (من أو متعلق أو قائم على الاحتمال) / احتمالي (من أو متعلق بالفلسفة الكاثوليكية الرومانية للاحتمالية)\nمثال: نظرية الكم الاحتمالية",
 "probabilistic classifier": "مصنف احتمالي (مصنف قادر على التنبؤ، بناءً على مدخلات العينة، بتوزيع احتمالي عبر مجموعة من الفئات، بدلاً من مجرد إخراج الفئة الأكثر ترجيحاً التي يجب أن تنتمي إليها…)",
 "probabilistically": "احتمالياً (باستخدام نظرية الاحتمالات)\nمثال: يمكننا حساب موقع الجسيمات احتمالياً",
 "probability": "أَرْجَحِيَّة, احْتِمَالِيَّة (صفة كون الشيء محتملاً؛ حدث محتمل أو الحدث الأكثر احتمالاً) / احتمال, فرصة (مقياس لمدى احتمالية وقوع حدث ما؛ رقم يعبر عن نسبة الحالات المواتية إلى العدد الكلي للحالات الممكنة)\nمثال: لفترة من الوقت بدا التمرد احتمالاً وارداً",
 "probability theorist": "عالم نظرية الاحتمالات (عالم رياضيات يتخصص في نظرية الاحتمالات)",
 "probability theory": "نظرية الاحتمالات (فرع الرياضيات التطبيقية الذي يتعامل مع الاحتمالات)",
 "probable": "رَاجِح, مُحْتَمَل (يُرَجَّح حُدوثُه أَوْ وُقوعُه) / محتمل, مرجح (مرجح ولكن ليس مؤكداً أن يكون حقيقياً أو واقعياً) / مرشح مرجح (متقدم من المرجح أن يتم اختياره)\nمثال: نتيجة محتملة",
 "probable cause": "سبب محتمل, شبهة معقولة ((قانون) أدلة كافية لتبرير الاعتقال أو التفتيش والمصادرة)\nمثال: قرر القاضي أن هناك سبباً محتملاً لتفتيش المنزل",
 "probably": "مِن اَلْمُحْتَمَل, رُبَّمَا (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "probate": "إثبات الوصية (إجراء إثبات أن وثيقة تدعي أنها وصية قد تم توقيعها وتنفيذها وفقاً للمتطلبات القانونية) / إثبات الوصية, مصادقة على الوصية (شهادة قضائية تفيد بأن الوصية حقيقية وتمنح المنفذين سلطة إدارة التركة)",
 "probate court": "محكمة التركات, محكمة الوصايا (محكمة لها اختصاص في إثبات الوصايا وإدارة التركات)",
 "probate will": "إثبات الوصية, مصادقة على الوصية (شهادة قضائية تفيد بأن الوصية حقيقية وتمنح المنفذين سلطة إدارة التركة)",
 "probation": "وضع تحت المراقبة ((قانون) طريقة للتعامل مع الجناة دون سجنهم؛ حيث يطلق سراح المتهم المدان بشروط تفرضها المحكمة) / إطلاق سراح مشروط, فترة مراقبة (فترة تجريبية تُمنح للمذنب كوقت لإصلاح نفسه بدلاً من السجن) / فترة اختبار, فترة تجربة (فترة تجريبية يتم فيها اختبار شخصيتك وقدراتك لمعرفة ما إذا كنت مناسباً للعمل أو للعضوية)\nمثال: الوضع تحت المراقبة جزء من عملية إصدار الحكم",
 "probation officer": "ضابط مراقبة, مسؤول الرعاية اللاحقة (ضابط المحكمة الذي يشرف على الخاضعين للمراقبة)",
 "probationary": "تَجْرِيبِيّ, مُؤَقَّت (بِمُوجِبِ شُرُوطٍ لَمْ تُسْتَكْمَلْ أَوْ لَمْ يُتَّفَقْ عَلَيْهَا نِهَائِيًّا)",
 "probationer": "مطلق سراحه بشروط (شخص أُطلق سراحه تحت المراقبة أو بكفالة) / ممرضة متدربة (ممرضة قيد التدريب تخضع لفترة تجربة)",
 "probative": "إِثْبَاتِيّ, اسْتِدْلَالِيّ (يميل إلى إثبات قضيّة معيّنة أو إقناعك بصحّة ادّعاء)",
 "probatory": "إِثْبَاتِيّ, اسْتِدْلَالِيّ (يميل إلى إثبات قضيّة معيّنة أو إقناعك بصحّة ادّعاء)",
 "probe": "مِسْبَار",
 "probenecid": "بروبينسيد (دواء طارد لحمض اليوريك يقلل من مستوى حمض اليوريك في الدم؛ يستخدم لعلاج النقرس)",
 "probing": "سَبَّار, مُتَعَمِّق (دقيق وشامل في البحث أو التحقيق)",
 "probiotic": "بروبيوتيك, بكتيريا نافعة (بكتيريا مفيدة توجد في القناة المعوية للثدييات السليمة؛ غالباً ما تعتبر نباتاً) / بروبيوتيك, بكتيريا نافعة (مكمل غذائي يحتوي على بكتيريا حية، يؤخذ عادة بعد تناول المضادات الحيوية لتجديد النبت الجرثومي المعوي المتضرر)\nمثال: كان ياكولت أول بروبيوتيك يعتمد على الألبان ويباع تجارياً في عام 1935، وهو حليب مخمر مضاف إليه بكتيريا العصيات اللبنية",
 "probiotic bacterium": "بروبيوتيك, بكتيريا نافعة (بكتيريا مفيدة توجد في القناة المعوية للثدييات السليمة؛ غالباً ما تعتبر نباتاً)",
 "probiotic flora": "بروبيوتيك, بكتيريا نافعة (بكتيريا مفيدة توجد في القناة المعوية للثدييات السليمة؛ غالباً ما تعتبر نباتاً)",
 "probiotic microflora": "بروبيوتيك, بكتيريا نافعة (بكتيريا مفيدة توجد في القناة المعوية للثدييات السليمة؛ غالباً ما تعتبر نباتاً)",
 "probity": "استقامة, عفة (النزاهة التامة والمؤكدة؛ التمتع بمبادئ أخلاقية قوية)\nمثال: في عالم قد لا تكون فيه العفة المالية شائعة",
 "problem": "تَمْرِين / مَسْأَلَة",
 "problem solver": "حلال المشاكل, مفكر تقاربي (مفكر يركز على المشكلة كما طُرحت ويحاول تجميع المعلومات والمعرفة للوصول إلى حل)",
 "problem solving": "حل المشكلات (عمليات التفكير المتضمنة في حل مشكلة ما) / حل المشكلات (مجال علم النفس المعرفي الذي يدرس العمليات المتضمنة في حل المشكلات)",
 "problem-oriented language": "لغة موجهة للتطبيق, لغة موجهة للمشكلات (لغة تشبه عباراتها مصطلحات المستخدم)",
 "problematic": "عَوِيص, مُحَيِّر (يَفْرِض مُتَطَلَّبَات ذِهْنِيَّة كَبِيرَة؛ صَعْب الفَهْم أَوِ الحَلّ) / جَدَلِيّ, خِلَافِيّ (قابل للشكّ أو النقاش)",
 "problematical": "عَوِيص, مُحَيِّر (يَفْرِض مُتَطَلَّبَات ذِهْنِيَّة كَبِيرَة؛ صَعْب الفَهْم أَوِ الحَلّ) / جَدَلِيّ, خِلَافِيّ (قابل للشكّ أو النقاش)",
 "problematically": "بشكل إشكالي (بطريقة تطرح مشكلة)",
 "problematics": "إشكاليات (الشكوك أو الصعوبات المتأصلة في موقف أو خطة)\nمثال: يتناول الإشكاليات التي تفرضها العولمة على دراسات الاتصال النقدية",
 "proboscidea arenaria": "مخالب الشيطان الرملية (يوضع بشكل بديل في جنس مارتينيا)",
 "proboscidea fragrans": "نبات وحيد القرن الحلو (مصدر للفعل نَبَتَ؛ اسم جنس شامل لكل ما تنبته الأرض من شجر أو بقل أو عشب أو غيره)\nمثال: هذا النبات مهدد بالانقراض.",
 "proboscidea louisianica": "بروبوسيديا, مخالب الشيطان (نبات حولي من جنوب الولايات المتحدة إلى المكسيك له أزهار كبيرة بيضاء أو صفراء مرقطة بالأرجواني ومنقار منحن طويل)",
 "proboscidean": "خرطوميات (ثدييات عاشبة ضخمة لها أنياب وخرطوم طويل)",
 "proboscidian": "خرطوميات (ثدييات عاشبة ضخمة لها أنياب وخرطوم طويل)",
 "proboscis": "خُرْطُوم",
 "proboscis flower": "بروبوسيديا, مخالب الشيطان (نبات حولي من جنوب الولايات المتحدة إلى المكسيك له أزهار كبيرة بيضاء أو صفراء مرقطة بالأرجواني ومنقار منحن طويل)",
 "proboscis monkey": "قرد الململة, قرد ذو خرطوم (قرد من بورنيو له أنف بصلي طويل)",
 "proboscis worm": "دودة خرطومية, دودة شريطية (ديدان بحرية رخوة غير مقسمة لها خرطوم يشبه الخيط والقدرة على التمدد والتقلص)",
 "procaine": "بروكائين (مسحوق بلوري أبيض (الاسم التجاري إيثوكائين) يُعطى بالقرب من الأعصاب كمخدر موضعي في طب الأسنان والطب)",
 "procaine hydrochloride": "بروكائين هيدروكلوريد, نوفوكائين (بروكائين يُعطى على شكل هيدروكلوريد (الاسم التجاري نوفوكائين))",
 "procarbazine": "بروكاربازين (دواء مضاد للأورام يستخدم لعلاج مرض هودجكين)",
 "procardia": "بروكارديا, نيفيديبين (حاصر للكالسيوم (الاسم التجاري بروكارديا)؛ يبدو أنه يزيد من خطر تكرار النوبات القلبية)",
 "procaryote": "بدائي النواة (كائن وحيد الخلية تفتقر خلاياه إلى نواة محاطة بغشاء؛ البكتيريا هي المثال الرئيسي ولكن تشمل أيضاً الطحالب الخضراء المزرقة والشعيات والمفطورات)",
 "procaryotic": "بدائي النواة (تمتلك خلايا تفتقر إلى أنوية محاطة بغشاء)",
 "procavia capensis": "وبر صخري (وبر يعيش في المناطق الصخرية)",
 "procedural": "إِجْرَائِيّ, شَكْلِيّ (يتعلق بممارسة المحكمة والإجراءات بدلاً من مبادئ القانون) / إجرائي (من أو متعلق بالإجراءات)\nمثال: القانون الإجرائي",
 "procedural law": "قَانُون إِجْرَائِيّ (مقياس كل شيء وطريقه؛ أمر كليّ ينطبق على جميع جزئياته التي تعرف أحكامها منه)\nمثال: ذكرني بالقانون.",
 "procedure": "اِجْرَاء",
 "proceed": "اِنْطَلَقَ / اِنْبَثَق",
 "proceeding": "إجراءات قانونية, دعوى ((قانون) بدء سلسلة من الخطوات التي يتم من خلالها استدعاء الأحكام القانونية)",
 "proceedings": "إجراءات قانونية, دعوى ((قانون) بدء سلسلة من الخطوات التي يتم من خلالها استدعاء الأحكام القانونية) / محضر, مداولات (وصف مكتوب لما دار في اجتماع ما)",
 "proceeds": "دَخْل (وَلَجَ؛ أَدْخَلَ. (تعدية خاصة بالباء))\nمثال: دخل توم المبنى.",
 "procellaria aequinoctialis": "نوء أبيض الذقن (طائر نوء أسود كبير من البحار الجنوبية له علامة بيضاء على الذقن)",
 "procellariiform seabird": "نوئيات (طائر كبير طويل الجناحين ذو منقار معقوف وفتحات أنف أنبوبية يتجول في البحار المفتوحة)",
 "process": "عَمَلِيَّة / عِلْمِيَّة, مُعَالَجَة / جَهَّزَ (جَهاز العَرُوس وَالْمَيِّتِ وجِهازهما: مَا يَحْتَاجَانِ إِليه؛ جَهَّزَه فَتَجَهَّز وجَهَّزْتُ العروسَ تَجْهِيزاً، وَكَذَلِكَ جَهَّزت الْجَيْشَ)\nمثال: جهز زيري حقائبه.",
 "process cheese": "جبن مطبوخ, جبن معالج (يصنع بمزج عدة دفعات من الجبن)",
 "process of monition": "إنذار قضائي (استدعاء يصدر بعد رفع دعوى يوجه جميع الأطراف المعنية لإظهار السبب في عدم منح الحكم المطلوب)",
 "process printing": "طباعة البروسس, طباعة المعالجة (طريقة لطباعة نسخ ملونة من ألواح الألوان النصفية)",
 "process-server": "مُحضر محكمة (شخص يسلم استدعاءً أو أوراق المحكمة شخصيًا للمدعى عليه)",
 "processed": "مُصَنَّع, مُعَالَج (خضع لعملية أو معالجة خاصة) / مصنع, معالج (محضر أو محول من حالة طبيعية عن طريق الإخضاع لعملية خاصة) / مكرر, منقى (منقى من الشوائب عن طريق المعالجة)\nمثال: خامات معالجة",
 "processed cheese": "جبن مطبوخ, جبن معالج (يصنع بمزج عدة دفعات من الجبن)",
 "processing": "مُعَالَجَة",
 "processing time": "وقت المعالجة (الوقت المستغرق لإكمال إجراء محدد)\nمثال: قاموا بزيادة الإنتاج عن طريق تقليل وقت المعالجة",
 "procession": "تقدم, زحف (فعل التحرك للأمام (نحو هدف)) / مَسِيرَة, مَوْكِب (العمل الجماعي لمجموعة من الناس أو الحيوانات أو المركبات التي تتحرك للأمام في تشكيل منتظم إلى حد ما) / انبثاق, فيض ((اللاهوت) انبثاق الروح القدس في العنصرة)\nمثال: كانت المواكب محظورة",
 "processional": "موكبي (من أو متعلق أو مميز لموكب) / موكبي (معد للاستخدام في موكب) / نشيد الموكب (موسيقى دينية تستخدم في موكب)\nمثال: في نظام موكبي جيد",
 "processional march": "مارش الانصراف, مارش الموكب (مارش يُعزف للمواكب)",
 "processor": "مُعَالِج",
 "processus coronoideus": "نتوء منقاري (نتوء مثلثي حاد يبرز من عظم)",
 "prochlorperazine": "بروكلوربيرازين (دواء مضاد للذهان ومضاد للقيء يستخدم لعلاج الفصام ولمكافحة الغثيان والقيء)",
 "prociphilus tessellatus": "من النغت الصوفي (يهاجم أشجار النغت)",
 "proclaimed": "مُصَرَّحٌ بِهِ عَلَنًا, مُعْلَنٌ عَنْهُ (أُعلِن عنه على الملأ وصار معروفاً على نطاق واسع)",
 "proclamation": "مَنْسُور, مُنَادَاة",
 "proclitic": "مُلْحَق",
 "proclivity": "ميل فطري, نزعة طبيعية (ميل طبيعي أو فطري)\nمثال: لديه نزعة طبيعية للمبالغة",
 "proconsul": "بروكونسول (قرد شبيه بالإنسان من جنس بروكونسول) / قنصل, والٍ (حاكم إقليمي برتبة قنصلية في الجمهورية الرومانية والإمبراطورية الرومانية) / حاكم, قنصل عام (مسؤول في مستعمرة حديثة يتمتع بسلطة إدارية كبيرة)",
 "proconsular": "بروقنصلي, قنصلي (من أو متعلق أو نموذجي للوالي الروماني (البروقنصل))\nمثال: مكاتب قنصلية",
 "proconsulate": "قنصلية عامة, منصب الوالي الروماني (منصب القنصل العام أو الوالي (البروك القنصل))",
 "proconsulship": "قنصلية عامة, منصب الوالي الروماني (منصب القنصل العام أو الوالي (البروك القنصل))",
 "proconvertin": "بروكونفيرتين (عامل تخثر يتكون في الكلى تحت تأثير فيتامين ك)",
 "procopius": "بروكوبيوس",
 "procrastinate": "سَوَّفَ (سَوْفَ حرف تسويف مرادفة للسين عند البعض وهي أبعد منها عند البعض الآخر. تستعمل قبل الفعل المُضَارِع فتعطي معنى المستقبل)\nمثال: سوف تصبح طبيبة.",
 "procrastination": "تَسْوِيف, تَأْجِيل",
