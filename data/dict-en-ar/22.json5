 "potato tuber moth": "عثة البطاطس, عثة درنات البطاطس (عثة بنية رمادية يرقتها هي دودة درنات البطاطس)",
 "potato tuberworm": "دودة درنات البطاطس (يرقة عثة البطاطس؛ تحفر في أوراق وسيقان البطاطس والتبغ)",
 "potato vine": "كرمة البطاطس, ياسمين البطاطس (كرمة كثيرة التفرع من البرازيل ذات أوراق متساقطة وأزهار بيضاء مشوبة بالزرقة) / كرمة البطاطس العملاقة (كرمة من كوستاريكا مسلحة بشكل متناثر بأشواك تشبه الخطاف ولها أزهار زرقاء ليلكية كبيرة)",
 "potato wart": "ثؤلول البطاطس (مرض فطري يسبب نتوءات إسفنجية ثؤلولية داكنة في عيون درنات البطاطس)",
 "potato wart fungus": "فطر ثالول البطاطس (فطر يسبب مرض ثالول البطاطس في درنات البطاطس)",
 "potato worm": "دودة الطماطم القرنية (يرقة عثة صقرية خضراء كبيرة مخططة بالأبيض تتغذى على نباتات الطماطم والبطاطس)",
 "potato yellow dwarf": "تقزم البطاطس الأصفر (مرض التقزم الأصفر لنباتات البطاطس)",
 "potato yellow-dwarf virus": "فيروس التقزم الأصفر للبطاطس (الفيروس الذي يسبب التقزم واصفرار أوراق نبات البطاطس)",
 "potawatomi": "لغة بوتاواتومي (لغة ألغونكوية يتحدث بها شعب بوتاواتومي) / بوتاواتومي (فرد من شعب ألغونكي أصلهم من ميشيغان وويسكونسن)",
 "potawatomi language": "لغة بوتاواتومي (لغة ألغونكوية يتحدث بها شعب بوتاواتومي)",
 "potbellied": "ذُو كِرْش, كَرْشِيّ (لَدَيْه بَطْن كَبِيرَة)",
 "potbelly": "مدفأة كرشية, موقد منتفخ (موقد منتفخ الشكل يتم فيه حرق الحطب أو الفحم) / كرش (مصطلحات عامية للكرش أو البطن البارز)",
 "potbelly stove": "مدفأة كرشية, موقد منتفخ (موقد منتفخ الشكل يتم فيه حرق الحطب أو الفحم)",
 "potboiler": "عمل تجاري رديء (مؤلف أدبي رديء الجودة كُتب بسرعة لكسب المال)",
 "potbound": "مُقَيَّد الجُذُور, مُكَبَّل بِالأَصِيص ((عن نبتة في أصيص) نمت كثيراً بحيث تشابكت جذورها وضاق عليها الوعاء)",
 "potboy": "خادم الحانة (عامل ذكر في نزل أو حانة يخدم الزبائن ويقوم بمهام متنوعة)",
 "poteen": "بوتين (ويسكي أيرلندي مقطر بشكل غير قانوني)",
 "potemkin": "بوتيمكين, غريغوري بوتيمكين (ضابط وسياسي روسي كان مفضلاً لدى كاترين الثانية (1739-1791))",
 "potemkin village": "قرية بوتيمكين, واجهة خادعة (شيء يبدو مثيراً للإعجاب ولكنه في الواقع يفتقر إلى الجوهر)",
 "potence": "فحولة, قدرة جنسية (حالة القدرة الجنسية؛ قدرة الذكر على الجماع)",
 "potency": "سُلْطَة (هو طعام يصنع من الخُضَار الطَازَجَة تقطع وتخلط ويضاف إليها المِلْح وقد يضاف عصير اللَيْمُون أو الخَلّ أو الزَيْت. لا يطبخ) / قُوَّة, فَعَّالِيَّة (ضد الضُعْف، الشِدَّة والقُدْرَة الجِسْمَانِيَّة؛ ضد الضُعْف، المَقْدِرَة والحَوْل والتَمَكُّن، القدرة المعنوية)\nمثال: هو متعطش للسلطة.",
 "potent": "شديد المفعول, فعال (له تأثير فسيولوجي أو كيميائي قوي) / فحل, قوي جنسياً ((للذكر) قادر على الجماع) / ذُو بَأْس, ذُو سُلْطَة (يمتلك أو يمارس القوة أو السلطة) / ذُو تَأْثِير بَالِغ (له تأثير ونفوذ كبيران)",
 "potentate": "حاكم مطلق, ديكتاتور (حاكم غير مقيد بالقانون)",
 "potential": "كَامِن, مُحْتَمَل (موجود في حيز الإمكانية) / مُتَوَقَّع, مُحْتَمَل (يُتوقَّع أن يصبح أو يكون؛ في الأفق) / جهد كهربائي, فرق الجهد (الفرق في الشحنة الكهربائية بين نقطتين في دائرة معبراً عنه بالفولت) / إمكانية, قدرة كامنة (القدرة الكامنة على التحقق في الوجود)\nمثال: مشكلة محتملة",
 "potential difference": "جهد كهربائي, فرق الجهد (الفرق في الشحنة الكهربائية بين نقطتين في دائرة معبراً عنه بالفولت)",
 "potential divider": "مقسم الجهد (مقاومات متصلة على التوالي عبر مصدر جهد؛ تستخدم للحصول على جزء مطلوب من الجهد)",
 "potential drop": "جهد كهربائي, فرق الجهد (الفرق في الشحنة الكهربائية بين نقطتين في دائرة معبراً عنه بالفولت)",
 "potential energy": "طاقة وضع (القُدْرَة والشِدَّة؛ هي مقدار ما يمكن للإنسان أن يفعله بمشقة، كأن قدرته محددة بطَوْق)\nمثال: طلب بطاقة اعتماد.",
 "potential unit": "وحدة جهد (مقياس لطاقة الوضع لشحنة وحدة عند نقطة معينة في دائرة كهربائية بالنسبة لنقطة مرجعية (الأرض))",
 "potentiality": "إمكانية, قابلية (استعداد يمكن تطويره) / إمكانية, قدرة كامنة (القدرة الكامنة على التحقق في الوجود)",
 "potentially": "بِشَكْل كَامِن, مُحْتَمَلًا (مع احتمال أن يصبح فعلياً)\nمثال: إنه خطير محتملاً",
 "potentiation": "تعزيز المفعول, تقوية ((في الطب) التأثير التآزري لدواءين يعطيان في وقت واحد)",
 "potentilla": "عُشْبَة الْقَوَى",
 "potentilla anserina": "إوزية, عشبة الفضة (نبات معمر منخفض النمو له أوراق فضية من الأسفل؛ شمال الولايات المتحدة، أوروبا، آسيا)",
 "potentiometer": "مقياس الجهد الانزلاقي",
 "potently": "بتأثير, بقوة (بطريقة ذات تأثير قوي)\nمثال: ظل شبح كليتمنسترا الذي يبكي في الليل طلباً للانتقام بقوة في ذهن الجمهور",
 "poterium sanguisorba": "بوطيريوم, عشبة الدم (عشب حدائق أوروبي بأزهار مشوبة بالأرجواني وأوراق تستخدم أحياناً للسلطات)",
 "potful": "ملء قدر (الكمية المحتواة في قدر)",
 "pothead": "مدمن ماريجوانا (شخص يدخن الماريجوانا بانتظام)",
 "pother": "اضطراب, حيرة (حالة من الهياج المثار)\nمثال: كان في حيرة من أمره",
 "potherb": "أعشاب الطبخ, بقلة (أي من النباتات العشبية المختلفة التي تطهى أوراقها أو سيقانها أو أزهارها وتستخدم للغذاء أو التتبيل)",
 "potholder": "حامل الأواني الساخنة, مساكة (لبادة معزولة لحمل الأواني الساخنة)",
 "pothole": "حفرة طريق, حفرة وعائية (حفرة أو ثقب ناتج عن التآكل أو العوامل الجوية (خاصة في سطح الطريق))",
 "potholed": "مُحَفَّر, مُنَقَّر (مليء بالحُفر أو النُّقر الصغيرة على السطح)",
 "potholer": "إسبيليولوجي, مستكشف كهوف (شخص يستكشف الكهوف)",
 "pothook": "خطاف القدر",
 "pothos": "بوثوس, بوثوس ذهبي (ليانا دائمة الخضرة تزرع على نطاق واسع لأوراقها المبرقشة) / بوثوس",
 "pothouse": "بار, حانة عامة (حانة تتكون من مبنى به بار وغرف عامة؛ غالباً ما توفر وجبات خفيفة)",
 "pothunter": "صياد القوت (شخص يصطاد من أجل الطعام (وليس للرياضة)) / صائد الجوائز (شخص يشارك في المسابقات من أجل جمع الجوائز والكؤوس) / صائد آثار (عالم آثار غير محترف (هاوٍ))",
 "potion": "جُرْعَة",
 "potiphar": "فُوطِيفَار, قِطْفِير",
 "potlatch": "بوتلاتش, وليمة توزيع الهدايا (وليمة احتفالية تقيمها بعض قبائل الهنود الحمر في الساحل الشمالي الغربي لأمريكا الشمالية (كما في الاحتفال بالزواج أو تولي منصب جديد) حيث يوزع المضيف…)",
 "potluck": "عشاء مشترك, وليمة مساهمة (ما يتوفر من طعام خاصة عند تقديمه لضيف غير متوقع أو عندما يحضره الضيوف ويتشاركون فيه جميعاً)\nمثال: عشاء مساهمة (كل ضيف يحضر طبقاً)",
 "potman": "خادم الحانة (عامل ذكر في نزل أو حانة يخدم الزبائن ويقوم بمهام متنوعة)",
 "potomania": "إدمان الكحول, ديبسومانيا (رغبة شديدة ومستمرة في شرب المشروبات الكحولية بإفراط)",
 "potoroo": "بوطورو (كنغر جرذي أسترالي)",
 "potos caudivolvulus": "دب العسل, كنكاج (ثديي شجري آكل للفاكهة من أمريكا الاستوائية ذو ذيل طويل قابض)",
 "potos flavus": "دب العسل, كنكاج (ثديي شجري آكل للفاكهة من أمريكا الاستوائية ذو ذيل طويل قابض)",
 "potpie": "بوت باي, فطيرة القدر (فطيرة عميقة من اللحم والخضروات أو يخنة لحم مع زلابية)",
 "potpourri": "بوت بوري, خليط معطر (جرة من بتلات الزهور المختلطة والتوابل تستخدم كعطر) / مزيج موسيقي, ميدلي (تأليف موسيقي يتكون من سلسلة من الأغاني أو القطع الموسيقية الأخرى من مصادر مختلفة) / تشكيلة, خليط (مجموعة تحتوي على تشكيلة متنوعة من أنواع الأشياء)\nمثال: كانت هناك تشكيلة كبيرة من السيارات معروضة",
 "potsdam": "بُوتْسْدَام",
 "potsherd": "شقفة فخار (كسرة من الفخار)",
 "potshot": "رمية عشوائية (طلقة تطلق على هدف سهل أو عرضي) / رَمْيَة طَائِشَة, نَقْد عَشْوَائِيّ (نقد موجه إلى هدف سهل ودون تفكير دقيق)\nمثال: أطلق المراسلون انتقادات عشوائية على رئيس البلدية",
 "pott's disease": "داء بوت (سل العمود الفقري مع تدمير الفقرات مما يؤدي إلى انحناء العمود الفقري)",
 "pottage": "بوتاج, حساء كثيف (حساء كثيف (وغالباً كريمي)) / يخنة الخضار (يخنة من الخضروات وأحياناً اللحم)",
 "potted": "مُلَخَّص, مُوجَز ((عامّيّة بريطانيّة) مُلخَّص أو مُختصَر) / مَحْفُوظ فِي وِعَاء (مَحْفُوظ فِي قِدْر أَوْ عُلْبَة أَوْ بُرْطُمَان) / مزروع في أصيص (للنباتات؛ مزروعة أو تنمو في وعاء (أصيص))\nمثال: نبات الغرنوقي في أصيص",
 "potter": "خَزَّاف",
 "potter bee": "نحلة خزافة (نحلة منعزلة تبني أعشاشاً من الطين أو الحصى الملصقة معاً وتعلقها بنبات)",
 "potter wasp": "دبور الخزف (أي من دبابير انفرادية متنوعة تبني خلايا على شكل مزهرية من الطين لبيضها)",
 "potter's clay": "طين الفخار (طين لا يحتوي على أي حديد؛ يستخدم في صنع الفخار أو للنمذجة)",
 "potter's earth": "طين الفخار (طين لا يحتوي على أي حديد؛ يستخدم في صنع الفخار أو للنمذجة)",
 "potter's field": "مقبرة الغرباء (مقبرة للأشخاص المجهولين أو المعوزين)",
 "potter's wheel": "عَجَلَة فَخَّار",
 "potterer": "متسكع (شخص يقضي وقته في أعمال تافهة)",
 "pottery": "فَخَّار, خَزَف / مَتْجَر الْفَخَّارِيَّات, مَحَلّ الْفَخَّارِيَّات / صِنَاعَة الفَخَّار (إيجاد الشيء وخَلْقُه؛ (استخدام حديث) قطاع اقتصادي)\nمثال: هذا البلد مدعوم بالصناعة.",
 "pottle": "إناء مكيال (وعاء يسع 2 كوارت (نصف جالون))",
 "potto": "بوتو (نوع من الليمور الرمادي البني) / دب العسل, كنكاج (ثديي شجري آكل للفاكهة من أمريكا الاستوائية ذو ذيل طويل قابض)",
 "potty": "قَعَادَة طِفْل",
 "potty chair": "نونية (مرحاض يتكون من مقعد صغير يستخدمه الأطفال الصغار)",
 "potty seat": "نونية (مرحاض يتكون من مقعد صغير يستخدمه الأطفال الصغار)",
 "potty-trained": "مُدَرَّب عَلَى اسْتِخْدَامِ المِرْحَاض ((في الأطفال) مدرّب على استخدام المرحاض)",
 "potyokin": "بوتيمكين, غريغوري بوتيمكين (ضابط وسياسي روسي كان مفضلاً لدى كاترين الثانية (1739-1791))",
 "pouch": "جراب, جريب (حاوية صغيرة أو متوسطة الحجم لحفظ أو حمل الأشياء) / جيب ((في التشريح) بنية تشبه الكيس في العديد من الحيوانات (مثل الجرابيات أو الغوفر أو البجع)) / جيب, كيس (حيز مغلق)\nمثال: وجد عمال المناجم المحاصرون جيباً من الهواء",
 "pouch-shaped": "جِرَابِيُّ الشَّكْل, كِيسِيّ (على شكل جراب أو كيس)",
 "pouched": "ذو جراب, مجرب (يمتلك جراباً)",
 "pouched mammal": "جرابيات (ثدييات تمتلك إناثها جراباً يحتوي على الحلمات حيث يتم تغذية الصغار وحملهم)",
 "pouched mole": "خلد جرابي (جرابي أسترالي حفار صغير يشبه الخلد)",
 "pouched mouse": "فأر جرابي (أي من جرابيات عديدة صغيرة حادة الأنف آكلة للحشرات تشبه الفئران أو الجرذان ظاهرياً)",
 "pouched rat": "غوفر, غوفر جيبي (قارض حفار من فصيلة الغوفرية له جيوب خدية خارجية كبيرة؛ من أمريكا الوسطى وجنوب غرب أمريكا الشمالية)",
 "pouchlike": "جِرَابِيُّ الشَّكْل, كِيسِيّ (على شكل جراب أو كيس)",
 "poudrin": "بلورة جليدية, رذاذ ثلجي (بلورات صغيرة من الجليد)",
 "pouf": "بف, مقعد عثماني (وسادة سميكة تستخدم كمقعد) / شاذ (مصطلح مهين لرجل مثلي الجنس)",
 "pouf paste": "عجين الشو, عجين منتفخ سائل (عجين سائل لصنع أغلفة مجوفة خفيفة لتحتوي حشوات مختلفة)",
 "pouffe": "بف, مقعد عثماني (وسادة سميكة تستخدم كمقعد)",
 "poulet": "دجاج, لحم دجاج (لحم الدجاجة المستخدم كطعام)",
 "poulette": "بوليت (صلصة ألموند مع بقدونس مفروم)",
 "poulterer": "بائع دواجن, تاجر طيور (تاجر في الدواجن ومنتجاتها)",
 "poultice": "لَبْخَة",
 "poultry": "دَجَاج / دَوَاجِن",
 "poultryman": "تاجر دواجن, مربي دواجن (تاجر ذكر في الدواجن ومنتجاتها)",
 "poultrywoman": "تاجرة دواجن (تاجرة أنثى في الدواجن ومنتجاتها)",
 "pounce": "انقضاض, هجوم (فعل الانقضاض)",
 "pound": "بَاوْنْد / رَطْل ((رَطَلَ) يَرْطُلُ رَطْلاً: عَدَا؛ (رَطَلَ) الشيءَ: رازَهُ بيدِهِ ليعرِفَ وزْنَهُ) / جُنَيْه",
 "pound cake": "كعكة الزبدة, كعكة باوند (كعكة رغيف غنية مصنوعة من رطل من كل من الزبدة والسكر والدقيق)",
 "pound net": "شبكة حظيرة (فخ يتكون من ترتيب من الشباك لتوجيه الأسماك إلى حظيرة)",
 "pound sign": "جنيه, علامة الجنيه (رمز لوحدة العملة (خاصة للجنيه الإسترليني في بريطانيا العظمى))",
 "pound sterling": "جُنَيْه, جُنَيْه إِسْتَرْلِينِيّ",
 "pound-foolish": "مُبَذِّرٌ فِي الكِبَار (غَيْرُ حَكِيمٍ فِي التَّعَامُلِ مَعَ المَبَالِغِ الكَبِيرَة)",
 "poundage": "حجز, مصادرة (وضع الممتلكات الخاصة في عهدة ضابط القانون) / وزن بالرطل (الوزن معبراً عنه بالرطل) / رسم الحجز (رسم يُفرض لاستعادة الحيوانات المحجوزة) / رسم الوزن (رسم يعتمد على الوزن المقاس بالرطل)",
 "poundal": "باوندال (وحدة قوة تساوي القوة التي تكسب كتلة مقدارها رطل واحد تسارعًا قدره 1 قدم/ثانية/ثانية)",
 "pounder": "مِدقّة, يد الهاون (أداة ثقيلة من الحجر أو الحديد (عادة ذات قاعدة مسطحة ومقبض) تستخدم لطحن وخلط المواد (كالحبوب أو الأدوية) في الهاون) / باوندر (شيء يزن عددًا معينًا من الأرطال (يستخدم عادة مضافًا))\nمثال: اصطاد الصياد سمكة بوزن 10 أرطال",
 "pounding": "دك, طرق (فعل الطرق (توجيه ضربات ثقيلة متكررة)) / خفقان, نبض قوي (حالة من النبض القوي والسريع (للقلب)) / ضرب متكرر, قصف (ضربات ثقيلة متكررة)\nمثال: فاجأه طرق القبضات المفاجئ",
 "pounds per square inch": "رطل لكل بوصة مربعة (وحدة لقياس الضغط)",
 "pour": "صَبَّ, سَكَبَ (سَكَبَ، الفرق بين صَبَّ وسَكَب أن الصَبّ يكون متعمدا والسكب قد يكون متعمدا أو خطأ؛ صَبَّ الطعام، أي سكبه في الإناء أو الصحون)\nمثال: صب الشاي لضيفك.",
 "pourboire": "إكرامية, بقشيش (مبلغ صغير نسبياً من المال يُعطى مقابل الخدمات المقدمة (كما من قبل نادل))",
 "pouria": "بوريا",
 "pouring": "مُتَدَفِّق, مُنْهَمِر (يسيل بغزارة)",
 "pousse-cafe": "بوس كافيه (مشروب صغير يقدم بعد العشاء (خاصة عدة ليكيرات تصب بعناية لتبقى في طبقات منفصلة))",
 "pout": "بوّز, بَرطَمَ",
 "pouter": "حمام نافخ (سلالة من الحمام توسع حوصلتها حتى ينتفخ صدرها) / عبوس, متجهم (شخص ذو تعبير وجه كئيب أو عابس بشكل معتاد)",
 "pouter pigeon": "حمام نافخ (سلالة من الحمام توسع حوصلتها حتى ينتفخ صدرها)",
 "pouteria campechiana": "شجرة الكانيستل, كانيستل (شجرة استوائية من فلوريدا وجزر الهند الغربية تنتج فاكهة صالحة للأكل)",
 "pouteria campechiana nervosa": "شجرة الكانيستل, كانيستل (شجرة استوائية من فلوريدا وجزر الهند الغربية تنتج فاكهة صالحة للأكل)",
 "pouteria zapota": "سابوت, شجرة السابوت (شجرة أمريكية استوائية ذات خشب يشبه الماهوجني وثمار حلوة صالحة للأكل بيضاوية الشكل؛ في بعض التصنيفات توضع في جنس كالوكاربوم)",
 "poutine": "بوتين",
 "poutingly": "ببوز, بتجهم (بشفاه مزمومة أو بطريقة عابسة)",
 "poverty": "فَقْر (بمعنى شقّ وحزّ؛ الشقّ والحزّ؛ الهمّ والحرص، يُجمع جَمْع تَكْسِير على فُقُور)\nمثال: الفقر والفرعنة.",
 "poverty grass": "خلنج الشاطئ, عشب الفقر (نبات صغير يشبه الخلنج مغطى بزغب أبيض ينمو على الشواطئ في شمال شرق أمريكا الشمالية)",
 "poverty level": "خط الفقر, مستوى الفقر (مستوى من الدخل الشخصي يحدد حالة الفقر)",
 "poverty line": "خط الفقر, مستوى الفقر (مستوى من الدخل الشخصي يحدد حالة الفقر)",
 "poverty trap": "مصيدة الفقر (وضع تؤدي فيه زيادة الدخل إلى فقدان المزايا بحيث لا يتحسن حالك)",
 "poverty-stricken": "مُعْدَم, مُعْوِز (فقير لدرجة الحاجة إلى مساعدة الآخرين)",
 "pow": "أَسِير حَرْب (شخص يستسلم للعدو (أو يأخذه العدو) في وقت الحرب)",
 "pow camp": "مخيم اعتقال, معسكر أسرى الحرب (معسكر لأسرى الحرب)",
 "powder": "بُودْرَة",
 "powder and shot": "بارود وطلقات (ذخيرة تتكون من البارود والرصاص للبنادق القديمة (المسكيت))",
 "powder blue": "أَزْرَق سَمَاوِيّ فَاتِح (بلون أزرق معتدل إلى فاتح مائل للأرجواني) / أزرق باهت, أزرق طباشيري (لون أزرق شاحب يميل إلى الرمادي)",
 "powder compact": "علبة بودرة, مضغوطة تجميل (علبة مستحضرات تجميل صغيرة بمرآة؛ لتحمل في حقيبة المرأة)",
 "powder flask": "قرن البارود (حاوية لحمل البارود؛ مصنوعة من قرن حيوان مجوف)",
 "powder horn": "قرن البارود (حاوية لحمل البارود؛ مصنوعة من قرن حيوان مجوف)",
 "powder keg": "برميل بارود (برميل (عادة من المعدن) للبارود أو مسحوق التفجير) / برميل بارود (حالة قابلة للانفجار المحتمل)",
 "powder magazine": "مخزن البارود, مخزن الذخيرة (مستودع (كحجرة في سفينة حربية) حيث تُخزن الأسلحة والذخيرة)",
 "powder metallurgy": "ميتالورجيا المساحيق (تعدين المساحيق المعدنية؛ كيفية إنتاج أجسام معدنية صلبة من مسحوق المعدن عن طريق الضغط والتلبيد)",
 "powder method": "تصوير المسحوق, طريقة المسحوق (عملية لتحديد المعادن أو البلورات؛ حيث يغطى قضيب صغير بمسحوق من المادة ويعرض لأشعة سينية معدلة بشكل مناسب؛ ويستخدم نمط الحلقات المنحرفة للتحديد)",
 "powder monkey": "حامل البارود (شخص يحمل المتفجرات (كما من المخزن إلى المدافع على متن سفينة حربية))",
 "powder photography": "تصوير المسحوق, طريقة المسحوق (عملية لتحديد المعادن أو البلورات؛ حيث يغطى قضيب صغير بمسحوق من المادة ويعرض لأشعة سينية معدلة بشكل مناسب؛ ويستخدم نمط الحلقات المنحرفة للتحديد)",
 "powder room": "حمام السيدات (مرحاض للسيدات في مبنى عام (أو شبه عام))",
 "powder store": "مخزن البارود, مخزن الذخيرة (مستودع (كحجرة في سفينة حربية) حيث تُخزن الأسلحة والذخيرة)",
 "powder technique": "تصوير المسحوق, طريقة المسحوق (عملية لتحديد المعادن أو البلورات؛ حيث يغطى قضيب صغير بمسحوق من المادة ويعرض لأشعة سينية معدلة بشكل مناسب؛ ويستخدم نمط الحلقات المنحرفة للتحديد)",
 "powder-post termite": "نمل أبيض مسحوقي (نمل أبيض مدمر للغاية للخشب الجاف في المناطق الدافئة)",
 "powder-puff": "نِسَائِيّ حَصْرِيّ (يُستخدم للأنشطة التنافسية التي تشارك فيها النساء فقط)",
 "powdered": "مَسْحُوق, مُسَحَّق (يتكوّن من جزيئات دقيقة ناعمة)",
 "powdered ginger": "زنجبيل, مسحوق الزنجبيل (جذر الزنجبيل المجفف والمطحون)",
 "powdered milk": "حليب بودرة, حليب مجفف (حليب منزوع الماء (مجفف))",
 "powdered mustard": "خردل جاف, مسحوق الخردل (مادة تذوب منها ملعقة إلى ثلاث ملاعق كبيرة في كوب من الماء الدافئ لتكون مقيئاً منزلياً)",
 "powdered sugar": "سكر بودرة, سكر ناعم (سكر محبب إلى مسحوق ناعم)",
 "powderer": "مُبَدِّر, نَاثِر الْمَسْحُوق (شخص يضع أو ينثر المسحوق (البودرة))",
 "powderiness": "دقة, نعومة (امتلاك ملمس دقيق جداً)\nمثال: دقة الرمال على الشاطئ",
 "powderpuff": "إسفنجة بودرة (جسم كروي ناعم مصنوع من ألياف رقيقة؛ لوضع البودرة على الجلد)",
 "powdery": "بُودْرِيّ, مَسْحُوقِيّ (ذو مظهر ناعم كالبودرة في اللون) / مَسْحُوق, مُسَحَّق (يتكوّن من جزيئات دقيقة ناعمة)",
 "powdery mildew": "بياض دقيقي (أي من الفطريات المختلفة من جنس إري سيفي تنتج كونيديا مسحوقية على سطح العائل)",
 "powdery-blue": "أَزْرَق سَمَاوِيّ فَاتِح (بلون أزرق معتدل إلى فاتح مائل للأرجواني)",
 "power": "قُوَّة, قُدْرَة (ضد الضُعْف، الشِدَّة والقُدْرَة الجِسْمَانِيَّة؛ ضد الضُعْف، المَقْدِرَة والحَوْل والتَمَكُّن، القدرة المعنوية) / قُوَّة (ضد الضُعْف، الشِدَّة والقُدْرَة الجِسْمَانِيَّة؛ ضد الضُعْف، المَقْدِرَة والحَوْل والتَمَكُّن، القدرة المعنوية) / قُوَّة, طَاقَة (ضد الضُعْف، الشِدَّة والقُدْرَة الجِسْمَانِيَّة؛ ضد الضُعْف، المَقْدِرَة والحَوْل والتَمَكُّن، القدرة المعنوية) / طَاقَة كَهْرَبَائِيَّة, طَاقَة (القُدْرَة والشِدَّة؛ هي مقدار ما يمكن للإنسان أن يفعله بمشقة، كأن قدرته محددة بطَوْق)\nمثال: توم شعر بالقوة.",
 "power brake": "مكبح آلي, مكبح معزز (مكبح في السيارة يضخم قوة صغيرة مطبقة على دواسة الفرامل إلى قوة أكبر نسبياً مطبقة لإبطاء أو إيقاف المركبة)",
 "power breakfast": "إفطار عمل (اجتماع لأشخاص مؤثرين لإدارة الأعمال أثناء تناول الإفطار)",
 "power broker": "سمسار سلطة (شخص مهم بفضل الناس أو الأصوات التي يسيطر عليها)\nمثال: سمسار السلطة الذي يقدم لك معروفاً سيتوقع منك رده",
 "power cable": "خط كهرباء, كابل طاقة (كابل يستخدم لتوزيع الكهرباء)",
 "power company": "شركة طاقة, شركة كهرباء (مرفق عام يوفر الكهرباء)",
 "power cord": "سلك الطاقة (سلك لتوصيل الطاقة لجهاز كهربائي)",
 "power couple": "ثنائي القوة, زوجان نافذان (زوجان كلاهما لديه مهن عالية المستوى أو نفوذ سياسي)",
 "power dive": "انقضاض بمحرك (غوص طائرة يتم تسريعه بواسطة الجاذبية وقوة المحرك معاً)",
 "power drill": "مثقاب كهربائي (أداة كهربائية لحفر الثقوب في المواد الصلبة)",
 "power engineering": "هندسة القوى (مجال فرعي من هندسة الطاقة يتعامل مع توليد ونقل وتوزيع واستخدام الطاقة الكهربائية والأجهزة الكهربائية المتصلة بهذه الأنظمة)",
 "power failure": "انقطاع التيار الكهربائي, انقطاع الكهرباء (فشل المعدات الناتج عند انقطاع مصدر الطاقة)\nمثال: تسببت العاصفة الثلجية في انقطاع التيار الكهربائي",
 "power grid": "شبكة الكهرباء, نظام الطاقة (نظام من الكابلات عالية الجهد يتم من خلاله توزيع الطاقة الكهربائية عبر منطقة ما)",
 "power hammer": "مطرقة آلية, مطرقة حفر (أداة آلية لحفر الصخور)",
 "power hunger": "تعطش للسلطة (دافع لاكتساب السلطة)",
 "power law": "قانون القوة, قانون ستيفنز ((فيزياء نفسية) المفهوم القائل بأن حجم الإحساس الذاتي يزداد بما يتناسب مع قوة (أس) شدة التحفيز)",
 "power line": "خَطّ اَلْكَهْرَبَاء, خَطّ اَلطَّاقَة (كِتَابَة؛ ما يَصِل نقطتين أو أكثر)\nمثال: إرسم خط مستقيم.",
 "power loading": "حِمْل القُدْرَة (نسبة وزن الطائرة إلى قدرة محركها)",
 "power loom": "نول آلي (نول يعمل ميكانيكياً)",
 "power meter": "عداد كهرباء (عداد لقياس كمية الطاقة الكهربائية المستخدمة)",
 "power module": "وحدة طاقة (وحدة توفر الطاقة لتشغيل وحدات أخرى)",
 "power mower": "جزازة آلية (جزازة عشب تعمل بمحرك بنزين)",
 "power of appointment": "حق التعيين, سلطة التعيين (سلطة تمنح (في وصية أو صك) لتعيين المستفيدين من ممتلكات المانح)",
 "power of attorney": "توكيل رسمي, وكالة (صك قانوني يخول شخصاً ما بالتصرف كوكيل للمانح)",
 "power outage": "انقطاع التيار الكهربائي, انقطاع الكهرباء (فشل المعدات الناتج عند انقطاع مصدر الطاقة)\nمثال: تسببت العاصفة الثلجية في انقطاع التيار الكهربائي",
 "power pack": "وحدة طاقة (جهاز لتحويل مصدر طاقة إلى جهد مطلوب لمعدات معينة)",
 "power plant": "محطة توليد الكهرباء, محطة طاقة (محطة لتوليد الكهرباء)",
 "power play": "لعب القوة ((هوكي الجليد) لعبة يتمتع فيها فريق واحد بميزة عددية على الآخر نتيجة للعقوبات) / لعب القوة (لعبة يكون فيها تركيز للاعبين في مكان واحد في الملعب) / لعبة ضغط, مناورة قوة (محاولة عدوانية لإجبار الإذعان عن طريق تركيز القوة أو التلاعب بها)\nمثال: لم يتمكن الفريق من الاستفادة من لعب القوة",
 "power point": "مأخذ, نقطة كهرباء (مقبس جداري)",
 "power politics": "دبلوماسية الزوارق الحربية, سياسة القوة (دبلوماسية تهدد فيها الدول باستخدام القوة لتحقيق أهدافها)",
 "power pylon": "برج كهرباء, عمود ضغط عالي (برج فولاذي رأسي كبير يدعم خطوط الطاقة عالية الجهد)\nمثال: أبراج الكهرباء هدف مفضل للإرهابيين",
 "power saw": "منشار كهربائي (أداة كهربائية لقطع الخشب)",
 "power series": "مُتَسَلْسِلَة القُوَى (مجموع حدود تحتوي على قوى صحيحة أعلى تباعاً لمتغير ما)",
 "power service": "شركة طاقة, شركة كهرباء (مرفق عام يوفر الكهرباء)",
 "power shovel": "حفارة, مجرفة آلية (آلة للحفر)",
 "power station": "مَحَطَّة طَاقَة",
 "power steering": "باور ستيرنج, توجيه معزز (توجيه سيارات حيث تضخم قوة المحرك عزم الدوران المطبق على عجلة القيادة)",
 "power structure": "تسلسل هرمي, هرمية (تنظيم الأشخاص في مراتب ودرجات مختلفة داخل هيئة إدارية)",
 "power struggle": "صِرَاع عَلَى ٱلسُّلْطَة",
 "power supply": "وحدة تزويد الطاقة / تغذية طاقة (تَغْذِيَةُ الجِسْمِ: تَزْوِيدُهُ بِـالغِذَاءِ؛ في ركيزة أساسية للحياة، فهي تشمل جميع العمليات التي يُحصل من خلالها الكائن الحي على احتياجاته الغذائية. تُساهم هذه الاحتياجات في تشغيل الوظائف…)\nمثال: لن نستمر في تغذية الانتقامات.",
 "power system": "شبكة الكهرباء, نظام الطاقة (نظام من الكابلات عالية الجهد يتم من خلاله توزيع الطاقة الكهربائية عبر منطقة ما)",
 "power takeoff": "عمود نقل الحركة, مأخذ طاقة (جهاز ينقل الطاقة من محرك (كما في الجرار أو المركبات الآلية الأخرى) إلى قطعة أخرى من المعدات (مثل مضخة أو مطرقة ثقب))",
 "power tool": "أداة كهربائية (أداة تعمل بمحرك)",
 "power train": "مجموعة تروس, نظام نقل الحركة (آلية عجلات تتكون من مجموعة متصلة من التروس الدوارة التي يتم من خلالها نقل القوة أو تغيير الحركة أو عزم الدوران)\nمثال: علق ربطة عنق الأحمق في مجموعة التروس",
 "power trip": "استعراض سلطة, نشوة سلطة (عمل تعظيمي للذات يتم القيام به لمجرد متعة ممارسة السيطرة على الآخرين)",
 "power unit": "وحدة قدرة (مقياس للقدرة الكهربائية)",
 "power user": "مستخدم محترف, مستخدم نهم ((حوسبة) مستخدم حاسوب يحتاج إلى أسرع وأقوى الحواسيب المتاحة)",
 "power walking": "مشي القوة, مشي سريع (شكل من أشكال التمارين القلبية يتكون من المشي السريع المصحوب بأرجحة قوية للذراعين)",
 "power worker": "عامل طاقة, عامل محطة كهرباء (عامل يعمل في محطة لتوليد الطاقة)",
 "power-assisted": "مُعَزَّز بِالطَّاقَة (يُكمِّل أو يحل محل الجهد اليدوي)",
 "power-assisted steering": "باور ستيرنج, توجيه معزز (توجيه سيارات حيث تضخم قوة المحرك عزم الدوران المطبق على عجلة القيادة)",
 "power-driven": "يَعْمَل بِمُحَرِّك (مدار بواسطة محرك آلي)",
 "power-station worker": "عامل طاقة, عامل محطة كهرباء (عامل يعمل في محطة لتوليد الطاقة)",
 "powerboat": "زورق بمحرك, قارب آلي (قارب يدفعه محرك احتراق داخلي)",
 "powerbroker": "سمسار سلطة (شخص مهم بفضل الناس أو الأصوات التي يسيطر عليها)\nمثال: سمسار السلطة الذي يقدم لك معروفاً سيتوقع منك رده",
 "powered": "آلي, مدار بالطاقة ((غالباً ما يستخدم في التركيبات) يمتلك أو يستخدم أو يُدفع بواسطة طاقة أو قوة من نوع معين)\nمثال: طيران بمحرك",
 "powerful": "قَوِيّ (اسم من أسماء الله الحسنى؛ الشَدِيْد ذو الحَوْل)\nمثال: كانت صدمة قوية.",
 "powerfully": "بتأثير, بقوة (بطريقة ذات تأثير قوي) / بشدة, بقوة (بطريقة قوية)\nمثال: ظل شبح كليتمنسترا الذي يبكي في الليل طلباً للانتقام بقوة في ذهن الجمهور",
 "powerfulness": "سطوة, قدرة (امتلاك تأثير مسيطر)\nمثال: قوة الردع للأسلحة النووية",
 "powerhouse": "محطة توليد الكهرباء, محطة طاقة (محطة لتوليد الكهرباء) / فريق قوي (فريق يُعتبر الأفضل في فئته) / دِينَامُو, شُعْلَة طَاقَة (شخص عالي الطاقة لا يكل)",
 "powerless": "ضَعِيف, عَاجِز",
 "powerlessly": "بضعف, بعجز (بطريقة عاجزة)",
 "powerlessness": "ضَعْف, عَجْز (صفة الافتقار إلى القوة أو القدرة؛ الضعف والوهن)",
 "powerlifting": "رِيَاضَة الْقُوَّة",
 "powhatan": "لغة بوهادان, لغة بوهتان (لغة ألغونكوية خاصة بشعب بوهتان) / بوهاتان (فرد من شعب ألغونكي كان يعيش سابقاً في شرق فرجينيا)",
 "powhatan language": "لغة بوهادان, لغة بوهتان (لغة ألغونكوية خاصة بشعب بوهتان)",
 "powwow": "تشاور سريع ((غير رسمي) مؤتمر خاص سريع) / بَاوْ وَاوْ (مجلس أو اجتماع للهنود الحمر)",
 "pox": "جدري, مرض بثرى (مرض معد يتميز بطفح جلدي قيحي قد يترك ندوباً تشبه الجدري) / زهري (مرض تناسلي شائع تسببه اللولبية الشاحبة؛ تتغير الأعراض عبر مراحل تقدمية؛ يمكن أن يكون خلقيًا (ينتقل عبر المشيمة))",
 "poxvirus": "فيروس الجدري (أي من مجموعة فيروسات يمكن أن تسبب أمراض الجدري في الفقاريات)",
 "poyou": "بيلودو, مدرع مشعر (مدرع أرجنتيني له ستة أشرطة متحركة وأجزاء سفلية مشعرة)",
 "poznan": "بُوزْنَان",
 "pplo": "كائن شبيه بالالتهاب الرئوي الجنبي (مفطورة مقاومة للمضادات الحيوية تسبب نوعاً من الالتهاب الرئوي لدى البشر)",
 "ppp": "رأب الحنك والبلعوم (استئصال جراحي للأنسجة الحنكية والبلعومية غير الضرورية لفتح مجرى الهواء؛ يهدف لعلاج الحالات الشديدة من الشخير (مع أو بدون توقف التنفس أثناء النوم))",
 "pr": "عَلَاقَات عَامَّة (ترويج يهدف إلى خلق حسن النية تجاه شخص أو مؤسسة) / براسيوديميوم (عنصر فلزي ناعم أبيض مصفر ثلاثي التكافؤ من مجموعة الأتربة النادرة)",
 "pr man": "رجل علاقات عامة (رجل موظف لترتيب الدعاية (لشركة أو شخصية عامة))",
 "pr woman": "مسؤولة علاقات عامة (امرأة موظفة لترتيب الدعاية (لشركة أو شخصية عامة))",
 "practicability": "إِمْكَانِيَّة التَّطْبِيق, قَابِلِيَّة التَّنْفِيذ (صفة كون الشيء قابلاً للاستخدام)",
 "practicable": "عَمَلِيّ, مُمْكِن التَّنْفِيذ (يمكن تنفيذه بالوسائل المتاحة وفي الظروف القائمة) / صَالِح لِلاسْتِعْمَال, قَابِل لِلتَّشْغِيل (يمكن استخدامه لغرض محدد)",
 "practicableness": "إِمْكَانِيَّة التَّطْبِيق, قَابِلِيَّة التَّنْفِيذ (صفة كون الشيء قابلاً للاستخدام)",
 "practicably": "بشكل ممكن, عملياً (بطريقة قابلة للتطبيق)",
 "practical": "تَطْبِيقِيّ / عَمَلِيّ",
 "practical application": "تطبيق, تطبيق عملي (فعل وضع شيء ما موضع التنفيذ؛ استخدامه لغرض معين)\nمثال: دعا إلى تطبيق الإحصاء على المشكلة",
 "practical joke": "مزحة عملية, مَقلَب (خدعة أو مقلب يُدبّر لشخص ما (خاصة لجعل الضحية يبدو أحمقاً))",
 "practical joker": "صاحب مقالب, مخادع مازح (شخص يقوم بتدبير المقالب والمزاح العملي ضد الآخرين)",
 "practical nurse": "ممرضة عملية مرخصة (ممرضة لديها تدريب كافٍ لترخيصها من قبل الدولة لتقديم الرعاية الروتينية للمرضى)",
 "practical politics": "براغماتية سياسية, سياسة واقعية (السياسة القائمة على اعتبارات عملية بدلاً من اعتبارات أخلاقية أو أيديولوجية)",
 "practicality": "عَمَلِيَّة, وَاقِعِيَّة (الاهتمام بالاستخدام الفعلي بدلاً من الاحتمالات النظرية)",
 "practically": "عَمَلِيًّا",
 "practice": "تَدْرِيب (تزويدُ الدَّارسين بالدّراسات العلميَّة والعمليّة التي تؤدِّي إلى رفع درجة المهارة عندهم في أداء واجبات الوظيفة؛ إعداد شخص أو مجموعة لتأدية مهمة أو وظيفة معينة) / مُمَارَسَة\nمثال: واصل زيري التدريب.",
 "practice game": "مباراة استعراضية, مباراة ودية (مباراة لا يتم تسجيل نتيجتها في الترتيب الرسمي للموسم)",
 "practice of law": "قانون, محاماة (المهنة العلمية التي يتم إتقانها من خلال الدراسة العليا في كلية الحقوق والمسؤولة عن النظام القضائي)\nمثال: درس القانون في جامعة ييل",
 "practice of medicine": "طب, ممارسة الطب (المهنة العلمية التي يتم إتقانها من خلال التدريب العالي في كلية الطب والمكرسة للوقاية من الأمراض والإصابات أو تخفيفها أو علاجها)\nمثال: درس الطب في جامعة هارفارد",
 "practice range": "ميدان تدريب (مكان للتدرب على ضربات الغولف)",
 "practice session": "تدريب, تمرين (تدريب منهجي بتكرارات متعددة)\nمثال: الممارسة تؤدي إلى الإتقان",
 "practice teacher": "طالب معلم (طالب جامعي يقوم بالتدريس تحت إشراف معلم معتمد للتأهل للحصول على درجة في التعليم)",
 "practiced": "مُتَدَرِّب, مُتَمَرِّن (بارع بعد تمرين وممارسة كثيرة) / بَارِع, حَاذِق (يمتلك معرفة ومهارة وكفاءة ويُظهرها)",
 "practician": "ممارس (شخص يمارس مهنة علمية)",
 "practised": "مُتَدَرِّب, مُتَمَرِّن (بارع بعد تمرين وممارسة كثيرة)",
 "practitioner": "مُمَارِس",
 "praenomen": "الاسم الأول (الاسم الأول لمواطن في روما القديمة)",
 "praesidium": "هيئة الرئاسة (لجنة تنفيذية دائمة في الدول الاشتراكية تمتلك جميع صلاحيات هيئة تشريعية أكبر وتعمل نيابة عنها عندما لا تكون في حالة انعقاد)",
 "praetor": "بريتور, قاضٍ روماني (قاضٍ منتخب سنوياً في الجمهورية الرومانية القديمة)",
 "praetorial": "بريتوري (من أو متعلق ببريتور روماني (قاض))\nمثال: سلطات بريتورية",
 "praetorian": "بْرِيتُورِيّ (يَتَّسِمُ بِصِفَاتِ الحَرَسِ البْرِيتُورِيِّ مِنْ حَيْثُ الفَسَادُ وَالرَّشْوَة) / بريتوري (من أو متعلق ببريتور روماني (قاض)) / الحَرَس البِريتُورِي, جندي بريتوري (عضو في الحرس البريتوري (الروماني القديم))\nمثال: سلطات بريتورية",
 "praetorian guard": "الحرس الإمبراطوري, الحرس البريتوري (الحرس الشخصي للنخبة للإمبراطور الروماني في روما القديمة) / الحَرَس البِريتُورِي, جندي بريتوري (عضو في الحرس البريتوري (الروماني القديم))",
 "praetorium": "خيمة القائد (خيمة جنرال روماني قديم)",
 "praetorship": "منصب البريتور (منصب البريتور (قاضٍ روماني قديم))",
 "pragmatic": "عَمَلِيّ, بْرَاغْمَاتِيّ",
 "pragmatic sanction": "مرسوم ملكي دستوري (مرسوم إمبراطوري يصبح جزءاً من القانون الأساسي للبلاد)",
 "pragmatical": "بَرَاغْمَاتِيّ, وَاقِعِيّ (يهتم بالأمور العملية الواقعية) / براغماتي, نفعي (مكون من أو يتعلق بنظرية البراغماتية)",
 "pragmatically": "براغماتياً, بشكل عملي (بطريقة عملية، عكس النظرية أو المثالية)\nمثال: نريد بناء مجتمع ديمقراطي، لكن يجب أن نتصرف بشكل عملي",
 "pragmatics": "براغماتية, تداولية (دراسة استخدام اللغة)",
 "pragmatism": "بْرَاغْمَاتِيَّة",
 "pragmatist": "بَرَاغْمَاتِيّ, عَمَلِيّ (شخص يتبع نهجاً عملياً في المشاكل ويهتم أساساً بنجاح أو فشل أفعاله) / براغماتي, ذرائعي (موالٍ للفلسفة البراغماتية (الذرائعية))",
 "prague": "بْرَاغ",
 "praia": "بْرَايَا",
 "prairial": "بْرَيْرِيَال",
 "prairie": "براري, سهل عشبي (سهل عشبي خالٍ من الأشجار)",
 "prairie anemone": "زهرة الفصح الأمريكية, شقائق النعمان البراري (نبات معمر قصير مشعر ذو أزهار زرقاء بنفسجية أو ليلكية في أوائل الربيع؛ أمريكا الشمالية وسيبيريا)",
 "prairie aster": "أستر البراري (أستر معمر بنفسجي الزهور في وسط الولايات المتحدة ذو رؤوس وحيدة)",
 "prairie berry": "باذنجان بري, مغد فضي الأوراق (نبات مغد ضار بأوراق فضية وزهور بنفسجية أو زرقاء أو بيضاء؛ تستخدم ثمرته المستديرة على نطاق واسع لتخثير الحليب؛ من وسط الولايات المتحدة إلى أمريكا…)",
 "prairie bird's-foot trefoil": "لوتس البراري, نفل البراري (نبات حولي من أمريكا الشمالية بزهور حمراء أو وردية)",
 "prairie chicken": "دجاج البراري (طيهوج بني مرقط من براري غرب أمريكا الشمالية)",
 "prairie coneflower": "زهرة الصنوبرية طويلة الرأس, زهرة صنوبرية البراري (نبات يشبه زهرة القبعة المكسيكية؛ من كولومبيا البريطانية إلى نيو مكسيكو) / زهرة صنوبرية البراري (زهرة صنوبرية من وسط إلى جنوب غرب الولايات المتحدة)",
 "prairie cordgrass": "عشبة الحبل البراري, عشبة الحبل للمياه العذبة (عشبة حبل أمريكية شمالية ذات أوراق بحواف غشائية جافة وقنابات بسفا طويل)",
 "prairie crab": "تفاح آيوا البري, تفاح البراري البري (تفاح بري من غرب الولايات المتحدة بزهور وردية عطرة)",
 "prairie dock": "أقحوان الحمى الأمريكي, كينا برية (عشب معمر قوي من شرق الولايات المتحدة بزهور بيضاء؛ استخدم الهنود أوراقه تقليدياً لعلاج الحروق)",
 "prairie dog": "كلب البراري (أي من عدة قوارض تعيش في براري أمريكا الشمالية في جحور كبيرة معقدة ولها صرخة تشبه النباح)",
 "prairie fire": "حريق الحشائش, حريق المروج (حريق غير منضبط في منطقة عشبية)",
 "prairie fowl": "دجاج البراري (طيهوج بني مرقط من براري غرب أمريكا الشمالية)",
 "prairie fox": "ثعلب البراري, ثعلب القزم (ثعلب رمادي صغير من سهول غرب أمريكا الشمالية)",
 "prairie gentian": "جرس أزرق, جنطيانا المروج (واحدة من أجمل الأزهار البرية في المروج لها أزهار زرقاء كبيرة منتصبة جرسية الشكل؛ في الأماكن الرطبة في المروج والحقول من شرق كولورادو ونبراسكا جنوباً…)",
 "prairie golden aster": "أستر ذهبي مشعر, هيتروتيكا (نبات معمر مشعر ذو رؤوس زهرية صفراء في عناقيد متفرعة؛ يوجد في كل مكان تقريباً في الأماكن الجافة من كندا إلى غرب وسط وغرب الولايات المتحدة؛ يوضع…)",
 "prairie gourd": "قرع البراري, قرع الجاموس (كرمة معمرة في المناطق الجافة بوسط وجنوب غرب الولايات المتحدة والمكسيك ذات ثمار خضراء مرقطة صغيرة صلبة غير صالحة للأكل) / قرع البراري (فاكهة خضراء وبيضاء صلبة صغيرة غير صالحة للأكل لنبات قرع البراري)",
 "prairie gourd vine": "قرع البراري, قرع الجاموس (كرمة معمرة في المناطق الجافة بوسط وجنوب غرب الولايات المتحدة والمكسيك ذات ثمار خضراء مرقطة صغيرة صلبة غير صالحة للأكل)",
 "prairie grass": "عشبة البراري, عشبة لحية المكنسة (عشبة أمريكية شمالية قوية التحمل جميلة تتحول أوراقها إلى البرونزي الشاحب في الخريف)",
 "prairie grouse": "دجاج البراري (طيهوج بني مرقط من براري غرب أمريكا الشمالية)",
 "prairie lotus": "لوتس البراري, نفل البراري (نبات حولي من أمريكا الشمالية بزهور حمراء أو وردية)",
 "prairie mallow": "ختمية البراري, ختمية كاذبة حمراء (ختمية كاذبة في غرب الولايات المتحدة ذات زهور حمراء عنقودية؛ توضع أحياناً في جنس مالفاستروم)",
 "prairie marmot": "كلب البراري (أي من عدة قوارض تعيش في براري أمريكا الشمالية في جحور كبيرة معقدة ولها صرخة تشبه النباح)",
 "prairie mimosa": "ديسمانثوس, ميموزا البراري (عشب معمر في براري أمريكا الشمالية له رؤوس كثيفة من الزهور البيضاء الصغيرة)",
 "prairie orchid": "سحلب البراري (سحلب الأراضي المستنقعية أو الرطبة في شمال وسط الولايات المتحدة له عناقيد من الزهور البيضاء الكريمية أو المخضرة العطرة جداً)",
 "prairie rattler": "أفعى جرسية البراري (واسعة الانتشار بين المسيسيبي وجبال روكي)",
 "prairie rattlesnake": "أفعى جرسية البراري (واسعة الانتشار بين المسيسيبي وجبال روكي)",
 "prairie rocket": "صاروخ البراري (سهم له ساق من قصب و في أحد طرفيه أنبوبة صغيرة من المقوى تحشى بارودا و لها فتيل من فتحتها السفلى فإذا أُشعل الفتيل و احتُرق ما في مُؤخرتها من بارود…؛ سلاح حربي، و رُبما استُخدم في أمور غير حربية، وهو كناية على اسطوانة ضخمة مخروطية الشكل، ذات جناحين صغيرين يثبتانها في خط مجراها…) / صاروخ البراري (أي من عدة نباتات أمريكية شمالية من جنس إريسيموم لها زهور صفراء كبيرة)\nمثال: هبط الصاروخ بدون مشاكل.",
 "prairie sabbatia": "ساباتيا البراري, نجمة تكساس (عشب براري بزهور أرجوانية فاتحة منفردة)",
 "prairie sage": "شيح لويزيانا, مريمية بيضاء (عشب معمر أبيض قطني من جنوب غرب الولايات المتحدة)",
 "prairie sagewort": "شيح بارد, ميرمية الشيح (نبات معمر عطري حريري الأوراق في المناطق الشمالية الجافة من نصف الكرة الشمالي؛ له زهيرات سمراء)",
 "prairie schooner": "عربة كونستوجا, عربة مغطاة (عربة كبيرة بعجلات عريضة وسقف قماشي مقوس؛ استخدمها الرواد الأمريكيون لعبور البراري في القرن التاسع عشر)",
 "prairie smoke": "أفينس أرجواني, دخان البراري (نبات معمر من أمريكا الشمالية بأوراق ريشية قاعدية زغبية وزهور أرجوانية وثمار ذات ريش)",
 "prairie soil": "تربة البراري (نوع من التربة يوجد تحت الأعشاب في المناخات المعتدلة)",
 "prairie star": "ليثوفراجما, نجمة البراري (نبات بأوراق قاعدية غالباً وعناقيد نحيلة مفتوحة من الزهور البيضاء أو الوردية الشاحبة؛ البراري والغابات المفتوحة في شمال غرب الولايات المتحدة إلى…)",
 "prairie sunflower": "عباد شمس البراري (مشابه لعباد الشمس الشائع بسيقان نحيلة متفرعة عادة شائع في وسط الولايات المتحدة)",
 "prairie trefoil": "لوتس البراري, نفل البراري (نبات حولي من أمريكا الشمالية بزهور حمراء أو وردية)",
 "prairie trillium": "تريليوم البراري, تريليوم منحني (تريليوم من وسط الولايات المتحدة له زهور أرجوانية داكنة لاطئة)",
 "prairie vole": "فأر البراري (فأر حقل نموذجي في منطقة البراري الممتدة في وسط الولايات المتحدة وجنوب كندا)",
 "prairie wagon": "عربة كونستوجا, عربة مغطاة (عربة كبيرة بعجلات عريضة وسقف قماشي مقوس؛ استخدمها الرواد الأمريكيون لعبور البراري في القرن التاسع عشر)",
 "prairie wake-robin": "تريليوم البراري, تريليوم منحني (تريليوم من وسط الولايات المتحدة له زهور أرجوانية داكنة لاطئة)",
 "prairie white-fringed orchid": "أوركيد البراري الأبيض المهدب (من وسط أمريكا الشمالية؛ نوع مهدد بالانقراض)",
 "prairie white-fringed orchis": "سحلب البراري (سحلب الأراضي المستنقعية أو الرطبة في شمال وسط الولايات المتحدة له عناقيد من الزهور البيضاء الكريمية أو المخضرة العطرة جداً)",
 "prairie willow": "صفصاف البراري (صفصاف شجيري نحيل في المناطق الجافة بأمريكا الشمالية)",
 "prairie wolf": "ذئب البراري, قيوط (ذئب صغير موطنه غرب أمريكا الشمالية)",
 "praise": "مِدْحَة, إِثْنَاء / عِبَادَة, حَمْد / مَدَحَ, أَثْنَى",
 "praise the lord": "سُبْحَانَ اللّٰه (مصدر للفعل سَبَحَ؛ تُقال حصرًا للَّٰه، كما في العبارة \"سُبْحَانَ اللَّٰهِ\")\nمثال: سبحان الله عما يشركون.",
 "praiseful": "إِطْرَائِيّ, ثَنَائِيّ (مَلِيء بالثناء أو يُقَدِّم المديح)",
 "praiseworthily": "بشكل جدير بالثناء, بشكل مثير للإعجاب (بطريقة مثيرة للإعجاب)\nمثال: كانت استجابات الأطفال طبيعية بشكل مثير للإعجاب",
 "praiseworthiness": "جَدَارَة بِالثَّنَاء, مَحْمَدَة (صفة كون الشيء مستحقاً للمدح)",
 "praiseworthy": "مُحَمَّد (مُفَعَّل من حَمَّدَ؛ الذي يُحْمَدُ كثيرا)\nمثال: محمد رسول الله.",
 "praising": "إِطْرَائِيّ, ثَنَائِيّ (مَلِيء بالثناء أو يُقَدِّم المديح)",
 "praisworthiness": "استحقاق المدح (خاصية استحقاق الثناء)",
 "prakrit": "البراكريت (أي من اللغات الهندية العامية في شمال ووسط الهند (المتميزة عن السنسكريتية) المسجلة من القرن الثالث قبل الميلاد إلى القرن الرابع الميلادي)",
 "prakrit language": "البراكريت (أي من اللغات الهندية العامية في شمال ووسط الهند (المتميزة عن السنسكريتية) المسجلة من القرن الثالث قبل الميلاد إلى القرن الرابع الميلادي)",
 "prakritic": "براكريتي (مكون من أو متعلق باللغات البراكريتية)",
 "praline": "برالين (حلوى بحجم الكوكيز مصنوعة من السكر البني والزبدة وجوز البقان)",
 "pram": "عَرَبَةْ أَطْفَال",
 "prance": "اِسْتَنَاصَ / نَاصَ",
 "prancer": "حصان متبختر (حصان نشيط أو ناري الطباع)",
 "prandial": "طعامي, وجبي (مكون من أو متعلق بوجبة)",
 "prang": "تحطم (حادث تحطم يشمل سيارة أو طائرة)",
 "prank": "مَقْلَب",
 "prank call": "اِتِّصَال مَقْلَب",
 "prankish": "مُشَاغِب, مُشَاكِس (مرح بطريقة مزعجة أو شقيّة)",
 "prankishness": "عبث, ميل للمقالب (سمة الانغماس في مقالب سيئة السمعة)",
 "prankster": "صاحب مقالب, مخادع مازح (شخص يقوم بتدبير المقالب والمزاح العملي ضد الآخرين)",
 "praseodymium": "بَرَاسِيُودِيمِيُوم",
 "prat": "أرداف, ألية (الجزء اللحمي من جسم الإنسان الذي يجلس عليه)\nمثال: يستحق ركلة جيدة في مؤخرته",
 "prate": "ثرثرة, كلام تافه (حديث عاطل أو أحمق وغير ذي صلة)",
 "prater": "ثرثار, مهذار (متحدث مزعج وأحمق وكثير الكلام)",
 "pratfall": "خطأ فادح, زلة (خطأ محرج) / سقوط على المؤخرة (سقوط على الأرداف)",
 "pratincole": "أبو اليسر (طائر شاطئي من العالم القديم بأجنحة طويلة مدببة وأرجل قصيرة؛ قريب الصلة بالجليل)",
 "prattle": "بَقَّ ((بَقَّ) الرجل بقا: أَكثر القَوْل فِي صَوَاب أَو خطأ؛ (بَقَّ) الْمَرْأَة: كثر وَلَدهَا)\nمثال: قد غزا بق الفراش فرنسا.",
 "prattler": "ثرثار (شخص يتحدث بطريقة طفولية)",
 "pravachol": "برافاستاتين, برافكول (دواء فموي (الاسم التجاري برافكول) يعطى لتقليل مستويات الكوليسترول في الدم؛ يوصى به بعد النوبات القلبية غير المميتة)",
 "pravastatin": "برافاستاتين, برافكول (دواء فموي (الاسم التجاري برافكول) يعطى لتقليل مستويات الكوليسترول في الدم؛ يوصى به بعد النوبات القلبية غير المميتة)",
 "prawn": "جَمْبَرِي, رُوبِيَان",
 "praxis": "تطبيق عملي, ممارسة (ترجمة فكرة إلى عمل)\nمثال: نظرية صعبة التطبيق العملي",
 "pray": "صَلَّى, دَعَا",
 "praya": "برايا (سحاري استعماري يصل طوله إلى 130 قدماً)",
 "prayer": "صَلَاة, دُعَاء / صَلَاة / مُصَلٍّ",
 "prayer beads": "مِسْبَحَة, سُبْحَة",
 "prayer book": "كتاب صلوات (كتاب يحتوي على صلوات)",
 "prayer mat": "سجادة صلاة (سجادة صغيرة يستخدمها المسلمون أثناء أداء الصلاة)",
 "prayer meeting": "اجتماع صلاة (خدمة يغني فيها الناس الترانيم ويصلون معًا)",
 "prayer rug": "سَجَّادَة",
 "prayer service": "اجتماع صلاة (خدمة يغني فيها الناس الترانيم ويصلون معًا)",
 "prayer shawl": "تاليت, شال صلاة ((في اليهودية) شال ذو أهداب معقودة طقوسياً عند كل زاوية؛ يرتديه اليهود في صلاة الصباح)",
 "prayer wheel": "عجلة الصلاة (أسطوانة على محور مكتوب عليها أو ملفوف حولها صلوات، تستخدم خاصة من قبل البوذيين في التبت)",
 "prayerbook": "كتاب صلوات (كتاب يحتوي على صلوات)",
 "prayerful": "كَثِير الدُّعَاء, مُصَلٍّ (مائل إلى الصلاة والدعاء أو يبدو كذلك)",
 "praying mantid": "سرعوف مصلي (السرعوف الشائع)",
 "praying mantis": "فَرَس اَلنَّبِيّ (أقوام تسكن شرق العِرَاق، يقال أنهم أقوام آرِيَّة)\nمثال: الفرس هي أنثى الحصان",
 "prazosin": "برازوسين, مينيبوريس (دواء خافض لضغط الدم (الاسم التجاري مينيبوريس))",
 "pre-christian": "ما قبل المسيحية (مكون من أو متعلق بـ أو كونه الوقت الذي يسبق بداية العصر المسيحي)",
 "pre-columbian": "ما قبل كولومبوس (من أو يتعلق بالأمريكتين قبل وصول كولومبوس أو نشأ فيهما)",
 "pre-eclampsia": "ما قبل تسمم الحمل, مقدمات الارتعاج (حالة غير طبيعية للحمل تتميز بارتفاع ضغط الدم واحتباس السوائل والبيلة الزلالية)",
 "pre-ejaculate": "مَذْي",
 "pre-eminently": "بتفوق, بشكل بارز (بدرجة متفوقة؛ بتميز فوق الآخرين)\nمثال: مجموعة واسعة من المشاهد المعاصرة بشكل بارز",
 "pre-empt": "مزايدة استباقية (عطاء مرتفع يهدف إلى منع اللاعبين المعارضين من المزايدة)",
 "pre-emption": "استباق, حق الشفعة (الاستيلاء المسبق على شيء ما) / أولوية الشراء, حق الشفعة (الحق في شراء شيء ما قبل الآخرين) / استيلاء, حق الشفعة (حق الحكومة في الاستيلاء على شيء ما أو تخصيصه (مثل الممتلكات)) / أسبقية, استباق (المبدأ القضائي الذي يؤكد سيادة التشريع الفيدرالي على تشريع الولاية في نفس الموضوع)\nمثال: استيلاء المصالح التجارية على عرض النطاق الترددي",
 "pre-emptive": "اسْتِبَاقِيّ, وِقَائِيّ مُسْبَق (مُصمَّم لمنع حدوث أمر متوقَّع أو إحباطه)",
 "pre-emptive strike": "ضربة استباقية (هجوم مفاجئ يُشن لمنع العدو من القيام به ضدك)",
 "pre-emptor": "مزايد استباقي (مزايد في البريدج يقوم بمزايدة استباقية) / مستحوذ بالأولوية (شخص يكتسب الأرض عن طريق حق الشفعة أو الأولوية)",
 "pre-existent": "سَابِق الوُجُود, مَوْجُود سَلَفًا (كان موجودًا من قبلُ أو قبل شيء آخر)",
 "pre-existing": "سَابِق الوُجُود, مَوْجُود سَلَفًا (كان موجودًا من قبلُ أو قبل شيء آخر)",
 "pre-game": "تجمع تحضيري, جلسة ما قبل الحفلة (تجمع اجتماعي يسبق حفلة أو مباراة رياضية)",
 "pre-jurassic": "ما قبل الجوراسي (مكون من أو متعلق بـ أو يشير إلى الوقت الذي سبق العصر الجوراسي)",
 "pre-orientation": "برنامج ما قبل التوجيه (برنامج من الأنشطة المتخصصة تنظمه مؤسسة التعليم العالي لتوجيه الطلاب الجامعيين الجدد وتعريفهم بالحرم الجامعي قبل بدء الفصل الدراسي)",
 "pre-raphaelite": "ما قبل الرافائيلي (من أو متعلق أو مميز لجماعة ما قبل الرافائيلية (الفنية)) / ما قبل الرفائيلية (رسام أو كاتب مكرس لاستعادة مُثُل عصر النهضة المبكر)\nمثال: رسامو ما قبل الرافائيلية",
 "pre-raphaelitism": "ما قبل الرافائيلية (حركة مضادة للثقافة هدفت إلى إصلاح الفن والأدب الفيكتوري)\nمثال: بلغت ما قبل الرافائيلية ذروتها في الولايات المتحدة في أواخر خمسينيات وستينيات القرن التاسع عشر، لكن تأثيرها استمر في التردد",
 "pre-romanticism": "ما قبل الرومانسية (حركة ثقافية في أوروبا من حوالي أربعينيات القرن الثامن عشر فصاعداً سبقت وبشرت بالحركة الفنية المعروفة بالرومانسية)\nمثال: تبع عصر الكلاسيكية الجديدة فترة انتقالية تعرف أيضاً بما قبل الرومانسية",
 "pre-socratic": "ما قبل سقراطي (قبل زمن سقراط) / فيلسوف ما قبل سقراط (أي فيلسوف عاش قبل سقراط)",
 "pre-valentine's day": "ما قبل عيد الحب (اليوم السابق لعيد الحب، مثلًا 1 فبراير)",
 "pre-valentines day": "ما قبل عيد الحب (اليوم السابق لعيد الحب، مثلًا 1 فبراير)",
 "preach": "خَطَبَ, وَعَظَ (يُشير إلى من يُلقي خطبة أو يطلب الزواج، وجمعه خُطّاب. ويُضرب مثل \"ذهب خاطباً فتزوج\" لمن يطلب شيئاً صغيراً فيحصل على شيء أكبر؛ يشير إلى فعل التحدث إلى الجمهور بغرض إلقاء خطاب، وعظ، أو إرشاد) / كَرَزَ\nمثال: أخبرني ما الخطب.",
 "preacher": "وَاعِظ",
 "preacher man": "واعظ (رجل مهنته الوعظ بالإنجيل)",
 "preacher woman": "مبشرة, واعظة (امرأة مهنتها الوعظ بالإنجيل)",
 "preachification": "وعظ ممل (تخليق يتم تقديمه بشكل ممل وبأسلوب وعظي)",
 "preaching": "مَوْعِظَة, وَعْظ (توبيخ أخلاقي) / خطبة دينية, عظة (خطاب ذو طبيعة دينية (يلقى عادة أثناء الخدمة الكنسية))\nمثال: وعظك يضيع عليه",
 "preachment": "عظة أخلاقية (عظة حول موضوع أخلاقي أو ديني)",
 "preachy": "مُتَنَطِّع, وَعْظِيّ (يميل إلى الوعظ الأخلاقي الممل أو يتّسم به)",
 "preadolescent": "مَا قَبْل المُرَاهَقَة (يتعلّق بالأطفال بين سنّ التاسعة والثانية عشرة أو مُعَدّ لهم)",
 "preakness": "بريكنس ستيكس (سباق سنوي للخيول بعمر ثلاث سنوات؛ يقام في بيمليكو في بالتيمور، ميريلاند)",
 "preamble": "دِيبَاجَة",
 "preanal": "أمام الشرج (يقع أمام فتحة الشرج)",
 "prearrangement": "ترتيب مسبق (شيء مرتب مسبقاً)",
 "prebend": "دخل كنسي, مخصص كنسي (الراتب الذي تمنحه الكاتدرائية للكاهن)",
 "prebendary": "كاهن مُرَتَّب (كاهن قانوني يحصل على راتب كنسي مقابل خدمة الكنيسة)",
 "precalc": "ما قبل التفاضل والتكامل (دورة جبر ومثلثات على مستوى الكلية مصممة لإعداد الطلاب لدراسة التفاضل والتكامل)",
 "precalculus": "ما قبل التفاضل والتكامل (دورة جبر ومثلثات على مستوى الكلية مصممة لإعداد الطلاب لدراسة التفاضل والتكامل)",
 "precancerous": "ما قبل السرطاني (مكون من أو متعلق بنمو ليس خبيثاً ولكن من المحتمل أن يصبح كذلك إذا لم يعالج)",
 "precarious": "غَيْرُ مُسْتَقِرّ, هَشّ (لا يوفّر راحة أو طمأنينة) / مَحْفُوفٌ بِالخَطَر, وَخِيم (مليء بالأخطار والمهالك) / مُتَزَعْزِع, هَشّ (غير آمن؛ محفوف بالصعوبات)",
 "precariously": "بشكل غير مستقر, بشكل محفوف بالمخاطر (بطريقة غير مستقرة وخطرة)\nمثال: كونك أقلية مسيطرة بشكل محفوف بالمخاطر هو وضع صعب للطبيعة البشرية للتعامل معه",
 "precariousness": "تَزَعْزُع, شَكّ (كون الشيء غير مستقر أو مشكوك فيه أو معتمد على الصدفة) / تزعزع, خطورة بالغة (الخطورة الشديدة أو عدم الاستقرار)\nمثال: عدم يقين النتيجة",
 "precast": "مَسْبُوق الصَّبّ (مُشكَّل مُسبقًا في قالب قبل النقل إلى الموقع؛ خاصّةً عناصر الخرسانة)",
 "precative": "ابْتِهَالِيّ, تَضَرُّعِيّ (يُعَبِّرُ عَنِ التَّضَرُّعِ وَالابْتِهَال)",
 "precatory": "ابْتِهَالِيّ, تَضَرُّعِيّ (يُعَبِّرُ عَنِ التَّضَرُّعِ وَالابْتِهَال)",
 "precaution": "احتراز, تدبير وقائي (إجراء وقائي لدرء خطر وشيك أو ضرر أو إصابة) / احتراز, وقاية (سمة ممارسة الحذر مسبقاً) / احتراس, تروي (التعقل في تجنب الضرر أو الخطر)\nمثال: وضع كيس ثلج على الإصابة كإجراء وقائي",
 "precautional": "احْتِرَازِيّ, وِقَائِيّ (يُتَّخذ مسبقًا للحماية من خطر أو فشل محتمل)",
 "precautionary": "احْتِرَازِيّ, وِقَائِيّ (يُتَّخذ مسبقًا للحماية من خطر أو فشل محتمل)",
 "precava": "وريد أجوف علوي (يتلقى الدم من الرأس والذراعين والصدر ويصب في الأذين الأيمن للقلب؛ يتكون من الوريد الفرد وكلا الوريدين العضديين الرأسيين)",
 "precede": "سَبَقَ, سَلَفَ (سَبَقَهُ إِلَى الشيءِ يَسْبِقَهُ سَبْقًا: تقدَّمَهُ؛ يقال سَبَقَ الفرسُ في الحَلْبةِ: جاءَ قبل الأَفراسِ)\nمثال: سبق و رأيت ذلك.",
 "precedence": "أسبقية, تقدم (فعل التقدم في الوقت أو الترتيب أو الرتبة (كما في المراسم)) / أسبقية, أولوية (السبق في الزمن) / أسبقية, أولوية (مكانة محددة بترتيب الأهمية أو الإلحاح)\nمثال: أسبقيتها كشركة رائدة عالمياً في تصنيع الأدوية",
 "precedency": "أسبقية, تقدم (فعل التقدم في الوقت أو الترتيب أو الرتبة (كما في المراسم)) / أسبقية, أولوية (السبق في الزمن) / أسبقية, أولوية (مكانة محددة بترتيب الأهمية أو الإلحاح)\nمثال: أسبقيتها كشركة رائدة عالمياً في تصنيع الأدوية",
 "precedent": "سَابِقَة (فِي : لَاصِقَة تزاد قبل الكلمة لتحويل مبناها وتغيير معناها. وهي وسيلة اقتصادية لبناء المفردات في اللغة)\nمثال: افتقد لزوجته السابقة.",
 "precedented": "مَسْبُوق (له سابقة أو مدعوم أو مبرر بسابقة)",
 "precedentedly": "بشكل مسبوق (بوجود سابقة)",
 "precedential": "تَقَدُّمِيّ, ذُو أَسْبَقِيَّة (له الأسبقية خاصة بسبب طول مدة الخدمة)",
 "precentor": "قائد جوقة, مرتل (المدير الموسيقي لجوقة غنائية)",
 "precentorship": "منصب قائد المرنمين (منصب قائد الجوقة أو المرنمين)",
 "precentral gyrus": "تلفيف قبل المركزي (تلفيف الفص الجبهي الذي يحده من الخلف التلم المركزي ويحتوي على المنطقة الحركية)",
 "precept": "مَبْدَأ (أَسَاس، أَصْل؛ مُسَلَّمَة، اِفْتِرَاض، ما يسلّم به لوضوحه)",
 "preceptor": "معلم جامعي (معلم في جامعة أو كلية (خاصة في كامبريدج أو أكسفورد))",
 "preceptorship": "منصب المعلم الخاص (منصب المؤدب أو المعلم)",
 "precession": "أسبقية, تقدم (فعل التقدم في الوقت أو الترتيب أو الرتبة (كما في المراسم)) / ترنح, مبادرة (حركة جسم دوار (مثل البلبل) يترنح فيها بحيث يمسح محور الدوران مخروطاً)",
 "precession of the equinoxes": "مبادرة الاعتدالين (انزياح غربي بطيء للاعتدالين على طول مستوى مسار الشمس ناتج عن مبادرة محور دوران الأرض)",
 "prechlorination": "كلورة أولية (الكلورة التي تسبق عملية كيميائية أخرى)",
 "precinct": "دائرة إدارية, قِسم (منطقة في مدينة أو بلدة محددة لأغراض إدارية)",
 "preciosity": "تَأَنُّق مُتَكَلَّف, تَحَذْلُق (صفة التشدد أو الإفراط في التهذيب والتأنق)",
 "precious": "ثَمِين",
 "precious coral": "مرجان, مرجان أحمر (الهيكل الصخري الصلب لمرجان البحر المتوسط، ذو لون أحمر أو وردي دقيق ويستخدم للمجوهرات)",
 "precious metal": "معدن نفيس (أي من المعادن الأقل شيوعاً والقيمة التي تُستخدم غالباً لصنع العملات المعدنية أو المجوهرات)",
 "precious stone": "جَوْهَر, جَوْهَرَة (جَوْهَر)\nمثال: الجمال في الجوهر لا المظهر",
 "preciously": "جداً, حقاً (تستخدم لإعطاء التوكيد)\nمثال: كانت موهوبة جداً",
 "preciousness": "تَأَنُّق مُتَكَلَّف, تَحَذْلُق (صفة التشدد أو الإفراط في التهذيب والتأنق) / قيمة لا تقدر بثمن, نفاسة (الجودة الإيجابية لكون الشيء ثميناً ويفوق القيمة) / تكلفة باهظة, نفاسة (الجودة التي يمتلكها شيء ذو سعر أو قيمة كبيرة)",
 "precipice": "جرف شديد الانحدار, هاوية (جرف شديد الانحدار جداً)",
 "precipitance": "تهور, فجائية (جودة الحدوث بسرعة متهورة أو بدون سابق إنذار)",
 "precipitancy": "تهور, فجائية (جودة الحدوث بسرعة متهورة أو بدون سابق إنذار)",
 "precipitant": "مُتَرَسِّع, مُتَعَجِّل (يتمّ بعجلة شديدة وبدون تَرَوٍّ كافٍ) / مادة مرسبة, مرسب (عامل يسبب تشكل راسب)",
 "precipitate": "تَرَسَّبَ",
 "precipitately": "باندفاع, بسرعة جنونية (بسرعة خطرة جداً)\nمثال: اندفع بسرعة جنونية عبر البوابة",
 "precipitateness": "تهور, فجائية (جودة الحدوث بسرعة متهورة أو بدون سابق إنذار)",
 "precipitation": "تَسَاقُط, هُطُول / تَرَسُّب / عجلة",
 "precipitator": "مرسب, مرسب كهروسكوني (يزيل جزيئات الغبار من الغازات عن طريق الترسيب الكهروسكوني)",
 "precipitin": "برسيبتين, مرسبة (جسم مضاد يسبب الترسيب عندما يتحد مع مستضده)",
 "precipitous": "سَحِيق, شَدِيد الانْحِدَار (حاد الانحدار بشكل خطير) / مُتَرَسِّع, مُتَعَجِّل (يتمّ بعجلة شديدة وبدون تَرَوٍّ كافٍ)",
 "precipitously": "بانحدار شديد, بشكل شاهق (بشكل مفاجئ وشديد الانحدار) / بشكل حاد, بشكل مفاجئ (بشكل مفاجئ جداً وبدرجة كبيرة)\nمثال: ارتفعت الجبال بانحدار شديد من الشاطئ",
 "precipitousness": "تهور, فجائية (جودة الحدوث بسرعة متهورة أو بدون سابق إنذار) / اِنْحِدَار شَدِيد, شِدَّة الانْحِدَار (الخاصية التي يمتلكها منحدر شديد الانحدار)",
 "precis": "مخطط, ملخص (ملخص تقريبي للنقاط الرئيسية لحجة أو نظرية)",
 "precise": "مَضْبُوط, دَقِيق",
 "precisely": "بِدِقَّة",
 "preciseness": "إِحْكَام, دِقَّة (صفة القابلية للتكرار في الكمية أو الأداء) / دِقَّة, وُضُوح قَاطِع (الوضوح كنتيجة للدقة)\nمثال: تعامل معها بدقة آلة أوتوماتيكية",
 "precision": "إِحْكَام, دِقَّة (صفة القابلية للتكرار في الكمية أو الأداء)\nمثال: تعامل معها بدقة آلة أوتوماتيكية",
 "precision cookie": "ملف تعريف ارتباط دائم (ملف تعريف ارتباط يتم حفظه بشكل دائم على القرص الصلب الخاص بك)",
 "precision rifle": "بندقية دقيقة, بندقية قنص (بندقية قوية للغاية طورت للجيش؛ قادرة على تدمير المركبات المدرعة الخفيفة والطائرات على بعد أكثر من ميل)",
 "preclinical": "قبل الأعراض, ما قبل السريري (مكون من أو متعلق بالمراحل المبكرة من المرض عندما لا يكون التشخيص الدقيق ممكناً لأن أعراض المرض لم تظهر بعد)",
 "preclinical phase": "تجربة ما قبل السريرية (اختبار معملي لدواء جديد أو جهاز طبي على الحيوانات؛ يجرى لجمع أدلة تبرر التجربة السريرية)",
 "preclinical test": "تجربة ما قبل السريرية (اختبار معملي لدواء جديد أو جهاز طبي على الحيوانات؛ يجرى لجمع أدلة تبرر التجربة السريرية)",
 "preclinical trial": "تجربة ما قبل السريرية (اختبار معملي لدواء جديد أو جهاز طبي على الحيوانات؛ يجرى لجمع أدلة تبرر التجربة السريرية)",
 "preclusion": "استباق, تحاشي (فعل منع شيء ما عن طريق توقعه والتخلص منه بفعالية)",
 "preclusive": "اسْتِبْعَادِيّ, حَاسِم (يجعل الأمر مستحيلًا سلفًا)",
 "precocial": "مُبَكِّر الاسْتِقْلال ((للفراخ) مغطاة بالزغب ومفتوحة العينين؛ قادرة على مغادرة العش في غضون أيام قليلة)",
 "precocious": "سَابِقُ النُّضْج, مُبَكِّرُ النُّمُوّ (يظهر أو ينمو في وقت مبكّر) / مبكر النضوج, نابغ (يتميز بالتطور أو النضج المبكر بشكل استثنائي (خاصة في القدرات العقلية))\nمثال: طفل نابغ",
 "precocious dentition": "تسنين مبكر (التسنين في سن أبكر مما هو متوقع)",
 "precociously": "بنضج مبكر (بطريقة سابقة للأوان (نضوج مبكر))\nمثال: يتصرف طفلها بنضج مبكر",
 "precociousness": "نبوغ مبكر, نضج مبكر (الذكاء الذي يتحقق قبل الجداول الزمنية النمائية الطبيعية بكثير)",
 "precocity": "نبوغ مبكر, نضج مبكر (الذكاء الذي يتحقق قبل الجداول الزمنية النمائية الطبيعية بكثير)",
 "precognition": "تنبؤ, معرفة مسبقة (معرفة حدث قبل وقوعه)",
 "precognitive": "اِسْتِبْصَارِيّ, بَصِير (يستشرف المستقبل ويتوقّعه)",
 "preconceived": "مسبق, مكون مسبقاً ((للفكرة أو الرأي) تم تكوينه مسبقاً؛ خاصة بدون دليل أو من خلال التحيز)\nمثال: بعض الأفكار المسبقة",
 "preconceived idea": "حكم مسبق, فكرة مسبقة (رأي تم تشكيله مسبقاً دون أدلة كافية)\nمثال: لم يحاول حتى التأكد من أفكاره المسبقة",
 "preconceived notion": "حكم مسبق, فكرة مسبقة (رأي تم تشكيله مسبقاً دون أدلة كافية)\nمثال: لم يحاول حتى التأكد من أفكاره المسبقة",
 "preconceived opinion": "حكم مسبق, فكرة مسبقة (رأي تم تشكيله مسبقاً دون أدلة كافية)\nمثال: لم يحاول حتى التأكد من أفكاره المسبقة",
 "preconception": "حكم مسبق, فكرة مسبقة (رأي تم تشكيله مسبقاً دون أدلة كافية) / انحياز, تحامل (تحيز يمنع النظر بموضوعية في قضية أو موقف)\nمثال: لم يحاول حتى التأكد من أفكاره المسبقة",
 "preconcerted": "مُتَّفَق عَلَيْه مُسْبَقًا (مُرتَّب أو مُتَّفَق عليه من قبل)",
 "precondition": "شرط مسبق (شرط يعتبر متطلباً أساسياً) / مُسلّمة, مُعطى (افتراض يؤخذ كأمر مسلم به) / شرط, شرط مسبق (افتراض تعتمد عليه صحة أو تأثير شيء آخر)",
 "preconditioned": "مُهَيَّأ مُسْبَقًا (تمّ وضعه في حالة ملائمة من قبل)",
 "precooked": "مَطْبُوخ مُسْبَقًا (مطبوخ جزئيًّا أو كلّيًّا مسبقًا)",
 "precooled": "مُبَرَّد مُسْبَقًا (تمّ تبريده مسبقًا)",
 "precordial": "أمام القلب, بركي (أمام القلب؛ يتضمن المنطقة البركية)",
 "precordium": "منطقة بركية (السطح الخارجي للجسم الذي يغطي القلب والمعدة)",
 "precum": "مَذْي",
 "precuneus": "طَلَل",
 "precursor": "بشير, سلف (شيء يسبق ويشير إلى اقتراب شيء أو شخص ما) / رَائِد, سَابِق (شخص يسبق غيره أو يعلن عن قدوم آخر) / سلائف, مادة أولية (مادة تتكون منها مادة أخرى (خاصة عن طريق تفاعل استقلابي))",
 "precursory": "إِنْذَارِيّ, تَحْذِيرِيّ (يُنذِر بمصيبة مستقبلية)",
 "predaceous": "اسْتِغْلَالِيّ, مُفْتَرِس (يعيش على استغلال الآخرين لتحقيق مكاسب شخصيّة) / ضَارٍ, مُفْتَرِس (يَصْطَاد وَيَقْتُل حَيَوَانَات أُخْرَى لِلتَّغْذِيَة)",
 "predaceousness": "الافتراس, الجشع ((للحيوان، عادة الطيور) صفة العيش على فريسة حية)",
 "predacious": "اسْتِغْلَالِيّ, مُفْتَرِس (يعيش على استغلال الآخرين لتحقيق مكاسب شخصيّة) / ضَارٍ, مُفْتَرِس (يَصْطَاد وَيَقْتُل حَيَوَانَات أُخْرَى لِلتَّغْذِيَة)",
 "predaciousness": "الافتراس, الجشع ((للحيوان، عادة الطيور) صفة العيش على فريسة حية)",
 "predation": "افتراس (فعل الافتراس من قبل مفترس يقتل الفريسة ويأكلها) / إغارة, نهب (فعل النهب والسلب والإغارة)",
 "predator": "مُفْتَرِس, ضَارٍ",
 "predatory": "اسْتِغْلَالِيّ, مُفْتَرِس (يعيش على استغلال الآخرين لتحقيق مكاسب شخصيّة) / كَاسِر, مُفْتَرِس (يعيش على افتراس حيوانات أخرى وخاصة بصيد الفرائس الحية) / سَالِب, مُغِير (يتّسم بالنهب والسلب والإغارة)",
 "predatory animal": "حيوان مفترس, ضارٍ (أي حيوان يعيش عن طريق افتراس الحيوانات الأخرى)",
 "predecessor": "بشير, سلف (شيء يسبق ويشير إلى اقتراب شيء أو شخص ما) / سَلَف (من يسبقك في الوقت (كما في شغل منصب أو وظيفة))",
 "predestinarian": "جبري, قدري (مكون من أو متعلق بالقضاء والقدر؛ يعتنق مذهب الجبر) / حتمي, قدري (أي شخص يسلم بالاعتقاد بأنه عاجز عن تغيير قدره)",
 "predestinarianism": "جبرية, عقيدة القدر (الاعتقاد أو العقيدة القائلة بالقدر المحتوم)",
 "predestinate": "مَكْتُوب, مُقَدَّر سَلَفًا (مقرّر أو مرتّب سلفًا بشكل لا يتغيّر)",
 "predestination": "تعيين مسبق, قدرية ((اللاهوت) التحديد مسبقاً؛ وخاصة المذهب (المرتبط عادة بكالفن) القائل بأن الله قد قضى بكل حدث عبر الأبدية (بما في ذلك الخلاص النهائي للبشرية)) / جبرية, قضاء وقدر (تحديد مسبق كما لو كان عن طريق القدر أو المصير)",
 "predestinationist": "حتمي, قدري (أي شخص يسلم بالاعتقاد بأنه عاجز عن تغيير قدره)",
 "predestined": "مَكْتُوب, مُقَدَّر سَلَفًا (مقرّر أو مرتّب سلفًا بشكل لا يتغيّر)",
 "predetermination": "تحديد مسبق (فعل تحديد أو تقرير ما سيحدث مسبقاً) / عزم مسبق, قرار مسبق (تحديد عقلي أو عزم مسبق؛ نية سابقة للقيام بشيء ما) / تعيين مسبق, قدرية ((اللاهوت) التحديد مسبقاً؛ وخاصة المذهب (المرتبط عادة بكالفن) القائل بأن الله قد قضى بكل حدث عبر الأبدية (بما في ذلك الخلاص النهائي للبشرية))\nمثال: دخل النقاش بقرار مسبق لإثبات أنني مخطئ",
 "predetermined": "مُحَدَّد مُسْبَقًا, مُعَدّ سَلَفًا (تم ضبطه أو تحديده مسبقاً)",
 "predicament": "مأزق, ورطة (موقف يصعب الخلاص منه، خاصة إذا كان مزعجاً أو شاقاً)\nمثال: وجد نفسه في مأزق محرج للغاية",
 "predicate": "خَبَر (بلاه وامتحنه ليعرف ما يُمكن عنه؛ عرفه على حقيقته بعد أن جربّه)\nمثال: زيري عنده خبرة.",
 "predicate calculus": "حساب المحمولات (نظام للمنطق الرمزي يمثل الأفراد والمحمولات والتكميم على الأفراد (وكذلك العلاقات بين القضايا))",
 "predication": "افتراض, مسلمة ((منطق) إعلان شيء بديهي؛ شيء يمكن افتراضه كأساس للنقاش)",
 "predicative": "إِسْنَادِيّ, خَبَرِيّ (للصفات؛ تتعلق بـ أو تحدث داخل خبر الجملة)",
 "predicatively": "إسنادياً, خبرياً (يقع ضمن عبارة الخبر (في النحو))\nمثال: صفات مستخدمة خبرياً",
 "predicator": "عنصر الإسناد (تعبير يقوم بالإسناد)",
 "predict": "تَنَبَّأَ",
 "predictability": "قَابِلِيَّة التَّنَبُّؤ (صفة كون الشيء قابلاً للتنبؤ به)",
 "predictable": "قابل للتنبؤ به, متوقع (يمكن التنبؤ به)",
 "predictably": "بشكل متوقع, كما هو متوقع (بطريقة متوقعة أو لدرجة متوقعة)\nمثال: كما هو متوقع، لم يعجبه الخبر",
 "prediction": "تَنَبُّؤ",
 "predictive": "اِسْتِشْرَافِيّ, تَنَبُّؤِيّ (متعلّق بالتنبّؤ أو ذو قيمة في إجراء التنبّؤات)",
 "predictor": "متنبئ (حاسوب للتحكم في النيران المضادة للطائرات يحسب موقع الطائرة في لحظة وصول القذيفة) / عامل تنبؤ, مؤشر تنبؤي (معلومات تدعم تقديراً احتمالياً للأحداث المستقبلية) / عرّاف, متنبئ (شخص يقوم بتنبؤات للمستقبل (عادة على أساس معرفة خاصة))\nمثال: تحتوي النشرة الأسبوعية على العديد من المؤشرات التنبؤية لأداء صناديق الاستثمار المشترك",
 "predictor variable": "متغير تنبؤي (متغير يمكن استخدامه للتنبؤ بقيمة متغير آخر (كما في الانحدار الإحصائي))",
 "predigested": "مَهْضوم مُسْبَقًا (مُعالَج صِناعِيًّا بِالإنْزيمات لِتَسْهيل الهَضْم)",
 "predilection": "إيثار, تفضيل (استعداد مسبق لتفضيل شيء ما) / تفضيل, ذائقة (إعجاب قوي)\nمثال: تفضيل للسيارات الباهظة",
 "predisposed": "مُعَرَّض سَلَفًا, مُهَيَّأ (جُعل قابلًا للتأثر مسبقًا)",
 "predisposition": "استعداد مسبق, تأهب (استعداد مسبق للتفاعل بطريقة معينة) / استعداد مسبق, تهيؤ (ميل مسبق لتفسير الأمور بطريقة معينة) / حساسية, قابلية الإصابة (القابلية للإصابة بمسببات الأمراض)",
 "prednisolone": "بريدنيزولون, بيديابريد (غلوكوكورتيكويد (الأسماء التجارية بيديابريد وغيرها) يستخدم لعلاج الحالات الالتهابية)",
 "prednisone": "بريدنيزون, دلتاسون (نظير منزوع الهيدروجين للكورتيزول (الأسماء التجارية دلتاسون وغيرها)؛ يستخدم كدواء مضاد للالتهابات في علاج التهاب المفاصل وكمثبط للمناعة)",
 "predominance": "غلبة, هيمنة (صفة كون الشيء أكثر وضوحاً من أي شيء آخر) / سيادة, غلبة (حالة السيادة على الآخرين)\nمثال: أعطت هيمنة اللون الأزرق اللوحة نغمة هادئة",
 "predominant": "رَاجِح, طَاغٍ (ذُو قُوَّة وَتَأْثِير أَعْلَى) / سَائِد, غَالِب (الأَكْثَر شُيُوعًا أَوْ تَكْرَارًا)",
 "predominantly": "بشكل سائد, في الغالب (أكبر بكثير في العدد أو التأثير)\nمثال: المرضى في الغالب من السكان الأصليين",
 "predominate": "رَاجِح, طَاغٍ (ذُو قُوَّة وَتَأْثِير أَعْلَى)",
 "predomination": "غلبة, هيمنة (صفة كون الشيء أكثر وضوحاً من أي شيء آخر) / سيادة, غلبة (حالة السيادة على الآخرين)\nمثال: أعطت هيمنة اللون الأزرق اللوحة نغمة هادئة",
 "preeclampsia": "تسمّم الحمل",
 "preemie": "طفل خديج, طفل مبتسر (رضيع يولد قبل 37 أسبوعاً من الحمل)",
 "preeminence": "تَقَدُّم",
 "preeminent": "رَائِد, فَذّ (الأعظم أهمية أو درجة أو دلالة أو إنجازًا)",
 "preeminently": "بتفوق, بشكل بارز (بدرجة متفوقة؛ بتميز فوق الآخرين)\nمثال: مجموعة واسعة من المشاهد المعاصرة بشكل بارز",
 "preemployment training program": "برنامج تدريب ما قبل التوظيف (برنامج تدريبي لإعدادك للتوظيف)",
 "preempt": "مزايدة استباقية (عطاء مرتفع يهدف إلى منع اللاعبين المعارضين من المزايدة)",
 "preemption": "استباق, حق الشفعة (الاستيلاء المسبق على شيء ما) / أولوية الشراء, حق الشفعة (الحق في شراء شيء ما قبل الآخرين) / استيلاء, حق الشفعة (حق الحكومة في الاستيلاء على شيء ما أو تخصيصه (مثل الممتلكات)) / أسبقية, استباق (المبدأ القضائي الذي يؤكد سيادة التشريع الفيدرالي على تشريع الولاية في نفس الموضوع)\nمثال: استيلاء المصالح التجارية على عرض النطاق الترددي",
 "preemptive": "اسْتِبَاقِيّ, وِقَائِيّ مُسْبَق (مُصمَّم لمنع حدوث أمر متوقَّع أو إحباطه)",
 "preemptive bid": "مزايدة استباقية (عطاء مرتفع يهدف إلى منع اللاعبين المعارضين من المزايدة)",
 "preemptive right": "حق الأولوية (الحق الذي يمنح المساهمين الفرصة الأولى لشراء إصدار جديد من الأسهم؛ يوفر حماية ضد تخفيف حصة ملكية المساهم)",
 "preemptor": "مزايد استباقي (مزايد في البريدج يقوم بمزايدة استباقية) / مستحوذ بالأولوية (شخص يكتسب الأرض عن طريق حق الشفعة أو الأولوية)",
 "preen gland": "غدة زمكية (غدة مفرزة للزيت تقع عند قاعدة الذيل في معظم الطيور)",
 "preexistence": "وجود سابق (الوجود في حالة سابقة أو قبل شيء آخر)",
 "preexistent": "سَابِق الوُجُود, مَوْجُود سَلَفًا (كان موجودًا من قبلُ أو قبل شيء آخر)",
 "preexisting": "سَابِق الوُجُود, مَوْجُود سَلَفًا (كان موجودًا من قبلُ أو قبل شيء آخر)",
 "prefab": "جَاهِزُ التَّرْكِيبِ, مُسَبَّقُ الصُّنْعِ (مُصنَّع بأحجام معيارية ليُشحَن ويُركَّب في مكان آخر) / مبنى جاهز (هيكل مسبق الصنع)",
 "prefabrication": "بناء جاهز, تصنيع مسبق (تصنيع أقسام مبنى في المصنع بحيث يمكن تجميعها بسهولة وبسرعة في موقع البناء)",
 "preface": "مُقَدِّمَة",
 "prefaded": "مُسْبَق البَهْت (تمّ تبهيت لونه مسبقاً في التصنيع)",
 "prefatorial": "اسْتِهْلَالِيّ, تَمْهِيدِيّ (يُستعمَل مقدّمةً أو تمهيدًا لما يليه)",
 "prefatory": "اسْتِهْلَالِيّ, تَمْهِيدِيّ (يُستعمَل مقدّمةً أو تمهيدًا لما يليه)",
 "prefect": "حاكم إداري, محافظ (كبير الضباط أو كبير القضاة)\nمثال: محافظ شرطة باريس",
 "prefectural": "محافظي, ولائي (من أو متعلق بمحافظة أو ولاية (إدارية))\nمثال: متحف الولاية",
 "prefecture": "مَبْنَى الْوِلَايَة (كل ما بُنِيَ؛ ما يُبْنى على أرضٍ محاطا بالجُدْرَان ومغطى بسَقْف. (تخصيص)) / وِلَايَة (منطقة إدارية لها استقلالها الإداري والمعنوي؛ ويختلف المعنى من بلد لآخر كما يختلف من فترة زمنية لأخرى)\nمثال: دخل توم المبنى.",
 "prefer": "فَضَّلَ, آثَرَ (عَدَّه أو رآه أو وجده أفْضَل؛ آثَرَه وقَدَّمَه)\nمثال: كل هذا بفضل جمال.",
 "preferable": "مُفَضَّل, أَفْضَل",
 "preferably": "بالأحرى, يفضل (بشكل أكثر استعداداً أو رغبة)\nمثال: نظفه جيداً، يفضل بالماء الدافئ",
 "preference": "تَفْضِيل, أَفْضَلِيَّة",
 "preference shares": "أسهم تفضيلية, أسهم ممتازة (أسهم يُضمن لحامليها الأولوية في دفع أرباح الأسهم ولكن ليس لحامليها حقوق تصويت)",
 "preferent": "مُحَبَّذ, مُفَضَّل (يُفضَّل على جميع الآخرين ويُعامَل بمحاباة)",
 "preferential": "تَفْضِيلِيّ, تَمْيِيزِيّ (يُظهر تحيزاً أو محاباة)",
 "preferentially": "بشكل تفضيلي (بطريقة تفضيلية)\nمثال: عومل بشكل تفضيلي",
 "preferment": "ترقية, تفضيل (فعل التفضيل) / توجيه الاتهام, رفع التهم (فعل تقديم الاتهامات)\nمثال: ذهبت الترقية إلى المرشح الأصغر سناً",
 "preferred": "أَفْضَل, مُفَضَّل (أَكْثَرُ اسْتِحْبَابًا مِنْ غَيْرِه) / مُحَبَّذ, مُفَضَّل (يُفضَّل على جميع الآخرين ويُعامَل بمحاباة)",
 "preferred shares": "أسهم تفضيلية, أسهم ممتازة (أسهم يُضمن لحامليها الأولوية في دفع أرباح الأسهم ولكن ليس لحامليها حقوق تصويت)",
 "preferred stock": "سَهْم مُمْتَاز (سَهَمَ؛ سَهَّمَ)\nمثال: لم يصب السهم توم.",
 "prefiguration": "إرهاص, تلميح مسبق (فعل تقديم مؤشرات غامضة مسبقة؛ التمثيل مسبقاً) / إرهاص, تمثيل مسبق (مثال ينذر أو يلمح لما سيأتي)",
 "prefigurative": "تَمْهِيدِيّ, مُنْبِئ بِشَكْل غَامِض (نبوئيّ بشكل غامض وغير واضح)",
 "prefix": "سَابِقَة, بَادِئَة (فِي : لَاصِقَة تزاد قبل الكلمة لتحويل مبناها وتغيير معناها. وهي وسيلة اقتصادية لبناء المفردات في اللغة)\nمثال: افتقد لزوجته السابقة.",
 "prefix notation": "التدوين البولندي, تدوين بادئ (تدوين خالٍ من الأقواس لتكوين التعبيرات الرياضية يسبق فيه كل معامل المعاملات الخاصة به)",
 "prefixation": "إضافة بادئة, تصدير (تكوين كلمة بواسطة بادئة)",
 "preformation": "تكون مسبق, نظرية التكون المسبق (نظرية (كانت شائعة في القرن الثامن عشر وفقدت مصداقيتها الآن) تفيد بأن الفرد يتطور بتضخم بسيط لكائن حي صغير كامل التكوين موجود في الخلية الجرثومية)",
 "prefrontal": "أَمَام جَبْهِيّ, قَبْل جَبْهِيّ (يقع أمام البنية الجبهيّة)",
 "prefrontal cortex": "الفص الجبهي الأمامي, القشرة قبل الجبهية (الجزء الأمامي من الفص الجبهي)",
 "prefrontal leucotomy": "بضع الفص, عملية الفص الجبهي (قطع جراحي للمسالك العصبية من وإلى الفص الجبهي للدماغ؛ غالباً ما يؤدي إلى تغيرات ملحوظة في الإدراك والشخصية)",
 "prefrontal leukotomy": "بضع الفص, عملية الفص الجبهي (قطع جراحي للمسالك العصبية من وإلى الفص الجبهي للدماغ؛ غالباً ما يؤدي إلى تغيرات ملحوظة في الإدراك والشخصية)",
 "prefrontal lobe": "الفص الجبهي الأمامي, القشرة قبل الجبهية (الجزء الأمامي من الفص الجبهي)",
 "prefrontal lobotomy": "بضع الفص, عملية الفص الجبهي (قطع جراحي للمسالك العصبية من وإلى الفص الجبهي للدماغ؛ غالباً ما يؤدي إلى تغيرات ملحوظة في الإدراك والشخصية)",
 "pregabalin": "بْرِيغَابَالِين",
 "pregnancy": "حَمْل (رَفَعَ، أَقَلَّ)\nمثال: حمل سامي سلاحه.",
 "pregnancy test": "اختبار الحمل (اختبار فسيولوجي لتحديد ما إذا كانت المرأة حاملاً)",
 "pregnanediol": "بريغنانيديول (مركب يوجد في بول النساء خلال مراحل معينة من الدورة الشهرية وفي بول النساء الحوامل)",
 "pregnant": "حَامِل (اسم فاعل من حَمَلَ، أي الذي يحمل شيئا؛ امرأة حَامِل: حُبْلَى، في بطنها جَنْيِن، وإذا أريد اسم الفاعل يقال للمرأة حَامِلَة) / حَوامِلُ / حُبْلَى\nمثال: يبدو أنني حامل.",
 "pregnant chad": "قصاصة ثقب غير منفصلة, قصاصة ثقب معلقة (قصاصة ثقب تم ثقبها أو ضغطها ولكن زواياها الأربعة لا تزال متصلة)",
 "prehensile": "جَشِع, حَرِيص (شديد الرغبة بشكل مفرط في اكتساب الثروة وغيرها) / قَابِض, مُمْسِك (مكيف للإمساك خاصة عن طريق الالتفاف حول شيء ما) / ثَاقِبُ الذِّهْن (ذو عقل ثاقب ومتيقظ)\nمثال: ذيل القرد القابض",
 "prehension": "إمساك, قبض (فعل الإمساك بشيء بإحكام باليدين)",
 "prehensor": "رجل قابضة, قابضة (الزوج الأمامي من أرجل مئويات الأرجل المعدلة للإمساك بالفريسة وحقن السم من المخالب السامة)",
 "prehistoric": "مَا قَبْلَ التَّارِيخ (انظر مَا)\nمثال: هلا! ما الجديد؟",
 "prehistoric culture": "ما قبل التاريخ (الوقت خلال تطور الثقافة البشرية قبل ظهور الكلمة المكتوبة)",
 "prehistorical": "مَا قَبْلَ التَّارِيخ, مَا قَبْلَ التَّدْوِين (يَنْتَمِي لِعُصُورٍ سَبَقَتِ التَّارِيخَ المُدَوَّن)",
 "prehistory": "عَصْر مَا قَبْلَ التَّارِيخ (مصدر للفعل \"عَصَرَ\"؛ أي مدة زمنية، دهر من الوقت)\nمثال: صلى زيري العصر.",
 "preindication": "إرهاص, علامة (حدث يُختبر على أنه يشير إلى أشياء مهمة ستحدث)\nمثال: كان يأمل أن يكون ذلك نذيراً",
 "preinvasive cancer": "سرطان ما قبل الغزو, سرطانة لابدّة (تجمع من الخلايا الخبيثة التي لم تغزُ بعد الأنسجة الظهارية العميقة أو تنتشر إلى أجزاء أخرى من الجسم)",
 "prejudgement": "حكم مسبق (حكم تم التوصل إليه قبل توفر الأدلة)",
 "prejudgment": "حُكْمٌ مُسْبَق (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ)\nمثال: حكم علي بالموت.",
 "prejudice": "إِجْحَاف, تَحَامُل",
 "prejudiced": "مُتَحَامِل, مُتَحَامِلَة",
 "prejudicial": "ضارّ, مُجْحِف (يُسَبِّب ضَرَرًا أو يُلحِق أذًى بِالمَصالِح) / إجحافي, متحيز (يميل إلى تفضيل أفكار مسبقة)\nمثال: وجود مواقف تمييزية أو متحيزة لدى السكان البيض",
 "prejudicious": "ضارّ, مُجْحِف (يُسَبِّب ضَرَرًا أو يُلحِق أذًى بِالمَصالِح) / إجحافي, متحيز (يميل إلى تفضيل أفكار مسبقة)\nمثال: وجود مواقف تمييزية أو متحيزة لدى السكان البيض",
 "prelacy": "حبرية, منصب الحبر (منصب أو مقام الحبر (رجل دين رفيع المستوى)) / أسقفية (الأساقفة بشكل جماعي)",
 "prelapsarian": "ما قبل السقوط (مكون من أو متعلق بالوقت الذي سبق سقوط آدم وحواء)",
 "prelate": "حبر, رئيس كهنة (رجل دين كبير وشخصية رفيعة المستوى)",
 "prelature": "حبرية, منصب الحبر (منصب أو مقام الحبر (رجل دين رفيع المستوى)) / أسقفية (الأساقفة بشكل جماعي)",
 "prelim": "امتحان تمهيدي (امتحان يؤديه طلاب الدراسات العليا لتحديد أهليتهم للاستمرار) / تصفيات أولية, مباراة تمهيدية (مباراة ثانوية تسبق الحدث الرئيسي)",
 "preliminary": "أَوَّلِيّ, تَمْهِيدِيّ (يدلّ على فعل أو حدث يسبق أو يُمهِّد لشيء أهمّ) / استهلال, تمهيد (شيء يعمل كحدث سابق أو يقدم ما يلي) / تصفيات أولية, مباراة تمهيدية (مباراة ثانوية تسبق الحدث الرئيسي)\nمثال: التدريب مقدمة ضرورية للتوظيف",
 "preliminary exam": "امتحان تمهيدي (امتحان يؤديه طلاب الدراسات العليا لتحديد أهليتهم للاستمرار)",
 "preliminary examination": "امتحان تمهيدي (امتحان يؤديه طلاب الدراسات العليا لتحديد أهليتهم للاستمرار)",
 "preliminary prospectus": "مسودة نشرة الاكتتاب, نشرة تمهيدية (مسودة أولى لنشرة اكتتاب؛ يجب أن تكون مميزة بوضوح للإشارة إلى أن أجزاء منها قد تتغير في النشرة النهائية)",
 "prelims": "المواد التمهيدية, مقدمات الكتاب (مادة مكتوبة تسبق المتن الرئيسي لكتاب)",
 "preliterate": "أُمِّيّ, قَبْل الكِتَابَة (ينتمي إلى مرحلة ما قبل معرفة الكتابة والقراءة) / قَبْلَ مَرْحَلَة القِرَاءَة (لَمْ يَكْتَسِب بَعْد القُدْرَة عَلى القِراءَة وَالكِتابَة)",
 "prelone": "بريدنيزولون, بيديابريد (غلوكوكورتيكويد (الأسماء التجارية بيديابريد وغيرها) يستخدم لعلاج الحالات الالتهابية)",
 "prelude": "بريلود, مقدمة (موسيقى تسبق الفوغا أو تقدم فصلاً في الأوبرا) / استهلال, تمهيد (شيء يعمل كحدث سابق أو يقدم ما يلي)\nمثال: التدريب مقدمة ضرورية للتوظيف",
 "premarital": "ما قبل الزواج (يتعلق بالأحداث التي تسبق الزواج)\nمثال: اتفاق ما قبل الزواج",
 "premature": "سَابِقٌ لِأَوَانِه, مُبْتَسَر (مبكّر بشكل غير مألوف أو قبل الوقت المتوقّع) / مُتَسَرِّع, مُسْتَعْجَل (أبكر ممّا ينبغي أو أكثر تسرّعاً من اللازم) / سابق لأوانه, مبتسر (ولد بعد فترة حمل أقل من الوقت الطبيعي)\nمثال: رضيع مبتسر",
 "premature baby": "طفل خديج, طفل مبتسر (رضيع يولد قبل 37 أسبوعاً من الحمل)",
 "premature ejaculation": "سرعة القذف, قذف مبكر (القذف خلال المراحل المبكرة من الإثارة الجنسية أو بعد فترة وجيزة من إيلاج القضيب في المهبل)",
 "premature infant": "طفل خديج, طفل مبتسر (رضيع يولد قبل 37 أسبوعاً من الحمل)",
 "premature labor": "مخاض مبكر (المخاض الذي يبدأ قبل الأسبوع 37 من الحمل)",
 "premature labour": "مخاض مبكر (المخاض الذي يبدأ قبل الأسبوع 37 من الحمل)",
 "premature ventricular contraction": "انقباض بطيني سابق لأوانه (عدم انتظام في إيقاع القلب؛ يمكن أن يكون تكرار حدوثه مقدمة للرجفان البطيني)",
 "prematurely": "قبل الأوان, مبكراً (في وقت مبكر جداً) / خداجاً, قبل الموعد ((للولادة) قبل نهاية فترة الحمل الطبيعية)\nمثال: تحدثت قبل الأوان",
 "prematureness": "ابتسار, سابق لأوانه (حالة كون الشيء سابقاً لأوانه)",
 "prematurity": "ابتسار, سابق لأوانه (حالة كون الشيء سابقاً لأوانه)",
 "premedical": "تَحْضِيرِيّ طِبِّيّ (يسبق دراسة الطبّ ويُمهِّد لها) / تمهيدي للطب (معد لدراسة الطب)\nمثال: طلاب المرحلة التمهيدية للطب",
 "premeditated": "مُتَعَمَّد, مُبَيَّت",
 "premeditation": "سبق الإصرار والترصّد (سَبَقَهُ إِلَى الشيءِ يَسْبِقَهُ سَبْقًا: تقدَّمَهُ؛ يقال سَبَقَ الفرسُ في الحَلْبةِ: جاءَ قبل الأَفراسِ)\nمثال: سبق و رأيت ذلك.",
 "premenopausal": "ما قبل الإياس, ما قبل انقطاع الطمث (قبل سن اليأس (انقطاع الطمث))",
 "premenstrual": "سابق للحيض (مكون من أو متعلق بـ أو يحدث خلال الوقت الذي يسبق الحيض مباشرة)",
 "premenstrual syndrome": "متلازمة ما قبل الحيض (متلازمة تحدث لدى العديد من النساء قبل 2 إلى 14 يوماً من بدء الحيض)",
 "premie": "طفل خديج, طفل مبتسر (رضيع يولد قبل 37 أسبوعاً من الحمل)",
 "premier": "أَوَّلِيّ, رَائِد (يَسْبِقُ جَمِيعَ مَا عَدَاهُ مِنْ حَيْثُ الزَّمَنِ) / رئيس الوزراء (الشخص الذي يرأس الحكومة (في العديد من البلدان)) / رئيس الوزراء البريطاني (الشخص الذي يشغل منصب رئيس الحكومة في المملكة المتحدة)",
 "premiere": "الْعَرْضُ ٱلْأَوَّل",
 "premiership": "رئاسة الوزراء (منصب رئيس الوزراء)",
 "premise": "مُقَدِّمَة",
 "premises": "عقار, مباني (الأرض والمباني المقامة عليها)\nمثال: يتم خبز الخبز في المبنى",
 "premiss": "افتراض, مقدمة منطقية (بيان يُفترض أنه صحيح ويمكن استخلاص استنتاج منه)\nمثال: بافتراض أنه أصيب، يمكننا استنتاج أنه لن يلعب",
 "premium": "إصدار مُكَلف / فاخر",
 "premium account": "حساب مميز (حساب بنكي مع خدمات إضافية ومزايا)",
 "premium bond": "سند ذو جائزة (سند حكومي لا يحمل فائدة أو مكاسب رأسمالية ولكنه يدخل حامله في سحوبات يانصيب)",
 "premix": "خليط جاهز (خليط محضر تجارياً من المكونات الجافة)",
 "premolar": "نَاجِذ, ضَاحِك",
 "premonition": "رُؤْيَة / نُبُوءَة, حَدْس",
 "premonitory": "إِنْذَارِيّ, تَحْذِيرِيّ (يُنذِر بمصيبة مستقبلية)",
 "prenanthes alba": "خس أبيض (عشبة من شمال شرق أمريكا الشمالية ذات عناقيد متدلية من الزهور البيضاء المصفرة)",
 "prenanthes purpurea": "برينانتس, جذر الأفعى الجرسية (عشب في وسط وجنوب أوروبا ذو زهور قرصية أرجوانية)",
 "prenanthes serpentaria": "رجل الأسد, نابالوس سربنتاريوس (عشب معمر شائع واسع التوزيع في جنوب وشرق الولايات المتحدة له عناقيد متدلية من الزهور الوردية وأوراق قاعدية سميكة توحي بشكل قدم الأسد؛ يوضع أحياناً في…)",
 "prenatal": "قَبْل الوِلَادَة (يحدث أو يوجد قبل الولادة)\nمثال: فترة ما قبل الولادة",
 "prenatal diagnosis": "تشخيص ما قبل الولادة (أي من الإجراءات التشخيصية المستخدمة لتحديد ما إذا كان الجنين يعاني من خلل وراثي)",
 "prenominal": "نَعْتِيّ, وَصْفِيّ (للصفات؛ توضع قبل الأسماء التي تعدلها (في اللغة الإنجليزية))",
 "prentice": "صبيّ, متدرب مهني (يعمل لدى خبير لتعلم مهنة)",
 "prenuptial": "ما قبل الزواج (يتعلق بالأحداث التي تسبق الزواج)\nمثال: اتفاق ما قبل الزواج",
 "prenuptial agreement": "اتفاق ما قبل الزواج (عقد يُبرم قبل الزواج أو الاتحاد المدني)",
 "preoccupancy": "إشغال مسبق (فعل تولي الإشغال قبل شخص آخر) / استغراق, انشغال (الحالة العقلية للانشغال بشيء ما)",
 "preoccupation": "اِسْتِغْرَاق, اِنْهِمَاك",
 "preoccupied": "مَهْوُوس, مُنْشَغِل (لَدَيْهِ انْشِغَالٌ مُفْرِطٌ أَوْ قَهْرِيٌّ بِشَيْءٍ مَا) / شَارِدُ الذِّهْن, مُسْتَغْرِقٌ فِي التَّفْكِير (غَارِقٌ فِي التَّفْكِيرِ بِعُمْق)",
 "preoperative": "قَبْل الجِراحَة (يَسْبِق العَمَلِيَّة الجِراحِيَّة)",
 "preordination": "تعيين مسبق, قدرية ((اللاهوت) التحديد مسبقاً؛ وخاصة المذهب (المرتبط عادة بكالفن) القائل بأن الله قد قضى بكل حدث عبر الأبدية (بما في ذلك الخلاص النهائي للبشرية))",
 "prep": "استعداد, تحضير (عمل مدرسي تحضيري يتم خارج المدرسة (خاصة في المنزل))",
 "prep school": "مدرسة إعدادية, مدرسة تحضيرية (مدرسة ثانوية خاصة)",
 "prepackaged": "مُعَبَّأٌ مُسْبَقًا (مُحَضَّرٌ وَمُغَلَّفٌ مُسْبَقًا وَجَاهِزٌ لِلْبَيْع)",
 "prepacked": "مُعَبَّأٌ مُسْبَقًا (مُحَضَّرٌ وَمُغَلَّفٌ مُسْبَقًا وَجَاهِزٌ لِلْبَيْع)",
 "prepaid": "مَدْفُوعُ البَرِيد, مُسْبَقُ الدَّفْع (يُسْتَخْدَمُ خَاصَّةً لِلْبَرِيدِ؛ مَدْفُوعٌ مُقَدَّمًا)",
 "preparation": "تَحْضِير, إِعْدَاد",
 "preparation fire": "نيران تحضيرية (نيران توجه لهدف تمهيداً لهجوم)",
 "preparative": "إِعْدَادِيّ, تَحْضِيرِيّ (يسبق شيئًا ما ويُمهِّد له أو يُعِدّ له)",
 "preparatory": "إِعْدَادِيّ, تَحْضِيرِيّ (يسبق شيئًا ما ويُمهِّد له أو يُعِدّ له)",
 "preparatory school": "مدرسة إعدادية, مدرسة تحضيرية (مدرسة ثانوية خاصة)",
 "prepare": "جَهَّزَ, حَضَّرَ (جَهاز العَرُوس وَالْمَيِّتِ وجِهازهما: مَا يَحْتَاجَانِ إِليه؛ جَهَّزَه فَتَجَهَّز وجَهَّزْتُ العروسَ تَجْهِيزاً، وَكَذَلِكَ جَهَّزت الْجَيْشَ) / اِسْتَعَدَّ, تَأَهَّبَ (اِسْتَعَدَّ للامْتِحانِ بِجِدٍّ: حَضَّرَ لَه؛ يَسْتَعِدُّ لِلْمُبَارَاةِ: يَتَهَيَّأُ لَهَا)\nمثال: جهز زيري حقائبه.",
 "prepared": "مُؤَهَّل, مُسْتَعِدّ ذِهْنِيًّا (مُجهَّز أو مُعَدّ بالموارد الفكرية اللازمة) / مجهز, مستعد (تم تجهيزه أو جعله صالحاً أو مناسباً مسبقاً) / مُسْتَعِدّ, مُهَيَّأ (قد أعدّ نفسه واستعدّ للفعل)\nمثال: بيان معد مسبقاً",
 "preparedness": "استعداد, تأهب (حالة الجاهزية أو الاستعداد للاستخدام أو العمل (خاصة العمل العسكري))\nمثال: وضعهم في حالة تأهب",
 "prepayment": "دفع مسبق (الدفع مقدماً)",
 "preponderance": "تفوق في الوزن, رجحان (الزيادة في الثقل؛ امتلاك وزن أكبر) / تفوق عددي, رجحان (تفوق في العدد أو المقدار) / تفوق, رجحان (التفوق في القوة أو التأثير)\nمثال: أقل رجحان في أي من الكفتين سيخل بتوازن الميزان",
 "preponderant": "رَاجِح, طَاغٍ (ذُو قُوَّة وَتَأْثِير أَعْلَى)",
 "preponderantly": "بشكل سائد, في الغالب (أكبر بكثير في العدد أو التأثير)\nمثال: المرضى في الغالب من السكان الأصليين",
 "preponderating": "رَاجِح, طَاغٍ (ذُو قُوَّة وَتَأْثِير أَعْلَى)",
 "preposition": "جَارّ, حَرْف جَرّ (له استخدامات متعددة، تتراوح بين وصف المكان والعلاقة بين الناس، وبين وصف فعل الظلم أو الميل عن الطريق الصحيح؛ \"جار\" كلمةٌ مُشْعِبَةُ المعنى، تشيرُ إلى المكانِ، والعلاقة، والظلم)\nمثال: لدي جارة مسلمة.",
 "prepositional": "جاري, متعلق بحرف الجر (من أو متعلق أو مُشكل بحرف جر)\nمثال: عبارة جار ومجرور",
 "prepositional object": "مجرور, مفعول حرف الجر (المفعول الذي يحكمه حرف الجر)",
 "prepositional phrase": "شبه جملة, عبارة جار ومجرور (عبارة تبدأ بحرف جر)",
 "prepositionally": "كحرف جر (بصفته حرف جر)",
 "prepossessing": "حَسَن الأَثَر, مُسْتَحْسَن (يترك انطباعاً أولياً إيجابياً)",
 "prepossession": "حكم مسبق, فكرة مسبقة (رأي تم تشكيله مسبقاً دون أدلة كافية) / تحيز مسبق, ميل مسبق (حالة التحيز المسبق)\nمثال: لم يحاول حتى التأكد من أفكاره المسبقة",
 "preposterous": "سَخِيف, مُثِير لِلسُّخْرِيَة (بالغ اللامعقوليّة بحيث يستدعي الاستهزاء والسخرية)",
 "preposterously": "بشكل مضحك, بشكل يثير السخرية (بشكل يثير الضحك أو يستحقه)\nمثال: كان دخلها صغيراً بشكل مضحك، لكنها تمكنت من العيش بشكل جيد",
 "prepotency": "سيادة, غلبة (حالة السيادة على الآخرين)",
 "prepper": "مُحْتَاط, مُسْتَعِدّ لِلْكَوَارِث (شخص يجهز نفسه ومؤونته تحسباً لوقوع كارثة)",
 "preprandial": "قَبْل الأَكْل, قَبْل الطَّعَام (يسبق وجبة (خاصة العشاء))\nمثال: مشروب قبل العشاء",
 "prepubertal": "قَبْلَ بُلُوغِيّ ((خاصة للبشر) في السن التي تسبق البلوغ مباشرة)",
 "prepuberty": "ما قبل البلوغ (فترة عامين تسبق مباشرة بداية البلوغ حيث يحدث النمو والتغيرات المؤدية إلى النضج الجنسي)",
 "prepubescent": "قَبْلَ بُلُوغِيّ ((خاصة للبشر) في السن التي تسبق البلوغ مباشرة)",
 "prepuce": "غُرْلَة, قُلْفَة (طية من الجلد تغطي رأس القضيب) / غُرْلَة, قُلْفَة (طية من الجلد تغطي رأس البظر)",
 "prepupal": "قَبْلَ عَذْرَائِيّ (في مرحلة خمول في نمو بعض الحشرات بين اليرقة والعذراء)",
 "prepyloric vein": "وريد ما قبل البواب (رافد للوريد المعدي الأيمن)",
 "prerecorded": "مُسَجَّل مُسْبَقًا (سُجِّلَ في وَقْت سابِق لِيُبَثّ لاحِقًا)",
 "prerequisite": "لَازِم / شَرْط, اِحْتِيَاج (شَرِطَ فلانٌ يَشْرِطِ شَرْطًا: وقع في أَمر عظيمٍ)\nمثال: صرخ ليون: \"شرطة!\"",
 "prerogative": "امتياز, حق حصري (حق محفوظ حصريًا لشخص أو مجموعة معينة (خاصة حق وراثي أو رسمي))\nمثال: كان التصويت امتيازًا للذكور البالغين البيض",
 "presage": "بشير, فأل (علامة على شيء على وشك الحدوث) / إرهاص, نذير (هاجس حول ما هو على وشك الحدوث)\nمثال: بحث عن فأل قبل الذهاب إلى المعركة",
 "presbyope": "مصاب بقصر البصر الشيخوخي (شخص يعاني من قصر البصر الشيخوخي؛ شخص يعاني من طول النظر الناتج عن فقدان مرونة عدسة العين التدريجي مع التقدم في السن)",
 "presbyopia": "قُصُوُّ البَصَرِ الشَيْخُوخِيّ",
 "presbyopic": "بعيد النظر (قادر على رؤية الأشياء البعيدة بوضوح)",
 "presbyter": "قسيس (شيخ في الكنيسة المشيخية)",
 "presbyterian": "مشيخي (تابع للكالفينية كما تُدرّس في الكنيسة المشيخية)",
 "presbyterian church": "الكنيسة المشيخية (الطائفة البروتستانتية الملتزمة بآراء جون كالفن)",
 "presbyterianism": "مشيخية (عقائد وممارسات الكنيسة المشيخية: قائمة على الكالفينية)",
 "presbytery": "بيت الكهنة (مبنى مخصص لرجال الدين القائمين بالخدمة)",
 "presbytes entellus": "لانغور رمادي, هانو مان (لانغور يعيش في جنوب آسيا؛ يعتبر مقدساً في الهند)",
 "preschool": "روضة أطفال, مرحلة ما قبل المدرسة (مؤسسة تعليمية للأطفال الصغار جداً على المدرسة الابتدائية)",
 "preschooler": "طفل ما قبل المدرسة (طفل يرتاد حضانة أو روضة أطفال)",
 "prescience": "استبصار, علم بالغيب (القدرة على التنبؤ بالمستقبل)",
 "prescient": "اِسْتِشْرَافِيّ, بَعِيد النَّظَر (يُدْرِك أَهَمِّيَّة الأَحْدَاث قَبْل وُقُوعِهَا)",
 "presciently": "ببعد نظر, بفراسة (مع البصيرة وبعد النظر)\nمثال: ببعد نظر أكثر من رؤسائهم، أدرك هؤلاء العمال الوضع الاقتصادي",
 "prescribe": "وَصَفَ / أَمَرَ (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة)\nمثال: إنه أمر مختلف .",
 "prescribed": "مَفْرُوض, مُقَرَّر (مَنْصُوصٌ عَلَيْهِ كَقَاعِدَةٍ أَوْ دَلِيلٍ إِرْشَادِيّ) / مَنْصُوصٌ عَلَيْه, وَضْعِيّ (مَفْرُوضٌ أَوْ مُقَرَّرٌ رَسْمِيًّا) / رَسْمِيّ, مُقَرَّرٌ (متوافق مع الاستخدام أو الإجراء أو النظام المحدد) / مَفْرُوض, مُقَرَّر (ثابت أو مقرّر خاصّة بأمر أو قرار رسميّ)",
 "prescript": "حُكْم, قَاعِدَة (دليل مقرر للسلوك أو العمل)",
 "prescription": "وَصْفَة طِبِّيَّة, وَصْفَة / تَقَادُم",
 "prescription drug": "دواء بوصفة طبية, وصفة طبية (دواء لا يتوفر إلا بتعليمات مكتوبة من طبيب أو طبيب أسنان للصيدلي)\nمثال: أخبر الطبيب أنه كان يتناول وصفته الطبية بانتظام",
 "prescription medicine": "دواء بوصفة طبية, وصفة طبية (دواء لا يتوفر إلا بتعليمات مكتوبة من طبيب أو طبيب أسنان للصيدلي)\nمثال: أخبر الطبيب أنه كان يتناول وصفته الطبية بانتظام",
 "prescriptive": "تقريري, معياري (يتعلق بإعطاء توجيهات أو قواعد (للصواب والخطأ))\nمثال: النحو المعياري يهتم بقواعد الاستخدام الصحيح",
 "prescriptive grammar": "نحو معياري (قواعد نحوية تنتجها اللسانيات المعيارية)",
 "prescriptive linguistics": "لسانيات معيارية (وصف لكيفية وجوب استخدام اللغة بدلاً من كيفية استخدامها فعلياً؛ وصفة لـ 'الصحة' الصوتية والصرفية والنحوية والدلالية)",
 "prescriptivism": "مِعْيَارِيّة لُغَوِيَّة",
 "preseason": "فترة ما قبل الموسم (فترة تسبق بداية الموسم العادي وتخصص للتدريب والإعداد)",
 "presence": "حُضُور (حُضُور)\nمثال: الحضور هام جدا.",
 "presence chamber": "غرفة الاستقبال الملكية, قاعة العرش (غرفة يستقبل فيها الملك أو شخصية عظيمة الضيوف والتجمعات، إلخ)",
 "presence of mind": "حضور الذهن, سرعة بديهة (ضبط النفس في الأزمات؛ القدرة على قول أو فعل الشيء الصحيح في الطوارئ)",
 "presenile dementia": "خرف ما قبل الشيخوخة, خرف مبكر (خرف يبدأ قبل سن 65)",
 "present": "حَالِيّ, حَاضِر / مَوْجُود, حَاضِر (الذي له وجود) / الزَّمَان, الْحَال / قَدَّمَ, طَرَحَ (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى الرُّسْغَ؛ أنّ لهم سابقةً وفضلاً له عند فلان قَدَمٌ : معروف)\nمثال: أنا موجود لوحدي",
