 "quadraphonic system": "نظام صوتي رباعي القنوات (نظام تسجيل أو إعادة إنتاج صوت ستيريو يستخدم أربع قنوات منفصلة)",
 "quadraphony": "نظام صوتي رباعي القنوات (نظام تسجيل أو إعادة إنتاج صوت ستيريو يستخدم أربع قنوات منفصلة)",
 "quadrasonic": "رباعي الصوت, رباعي القنوات (من أو متعلق بالصوت الرباعي)\nمثال: نظام الصوت الرباعي الخاص به",
 "quadrate": "رُبَاعِيُّ الأَضْلَاع, مُرَبَّع (ذو أربعة أضلاع وأربع زوايا) / جسم مربع, مربع (جسم على شكل مربع) / شبيه بالمكعب, مكعباني (جسم يشبه المكعب)",
 "quadratic": "تربيعي (ينطوي على القوة الثانية ولا توجد قوة أعلى للكمية أو الدرجة) / كَثِيرَة حُدُود مِن الدَّرَجَة الثَّانِيَة, مُعَادَلَة تَرْبِيعِيَّة (كثيرة حدود من الدرجة الثانية) / معادلة تربيعية (معادلة تكون فيها أعلى قوة للكمية المجهولة هي المربع)\nمثال: معادلة تربيعية",
 "quadratic equation": "معادلة تربيعية (معادلة تكون فيها أعلى قوة للكمية المجهولة هي المربع)",
 "quadratic polynomial": "كَثِيرَة حُدُود مِن الدَّرَجَة الثَّانِيَة, مُعَادَلَة تَرْبِيعِيَّة (كثيرة حدود من الدرجة الثانية)",
 "quadratics": "علم المعادلات التربيعية (فرع من الجبر يتعامل مع المعادلات التربيعية)",
 "quadrature": "تربيع (إنشاء مربع له نفس مساحة شكل آخر)",
 "quadrennium": "فترة أربع سنوات (فترة مدتها أربع سنوات)",
 "quadric": "سطح تربيعي (منحنى أو سطح معادلته (في الإحداثيات الديكارتية) من الدرجة الثانية)",
 "quadric surface": "سطح تربيعي (منحنى أو سطح معادلته (في الإحداثيات الديكارتية) من الدرجة الثانية)",
 "quadriceps": "عضلة رباعية الرؤوس (عضلة في الفخذ تمد الساق)",
 "quadriceps femoris": "عضلة رباعية الرؤوس (عضلة في الفخذ تمد الساق)",
 "quadrigesima sunday": "أحد الأربعين (الأحد الأول في الصوم الكبير)",
 "quadrilateral": "رُبَاعِيّ الْأَضْلَاع / رُبَاعِيّ الْجَوَانِب",
 "quadrille": "كادريل (رقصة مربعة من 5 أشكال أو أكثر لأربعة أزواج أو أكثر) / كوادريل (موسيقى لرقص الكوادريل)",
 "quadrillion": "كُوَادرِيلْيُون (العدد الذي يمثله واحد متبوعاً بـ 15 صفراً) / كُوَادرِيلْيُون (بريطاني قديم) (العدد الذي يمثله واحد متبوعاً بـ 24 صفراً في المملكة المتحدة (سابقاً))",
 "quadrillionth": "اَلْكْوَادِرِلْيُونُ (العدد الترتيبي لكوادريليون في العدّ) / جُزْء مِن كُوَادرِيلْيُون (جزء واحد من كوادريليون جزء متساوي)",
 "quadripara": "امرأة تلد للمرة الرابعة ((طب التوليد) امرأة أنجبت طفلاً قابلاً للحياة في كل من أربع حالات حمل)",
 "quadripartite": "رُبَاعِيّ",
 "quadriphonic": "رباعي الصوت, رباعي القنوات (من أو متعلق بالصوت الرباعي)\nمثال: نظام الصوت الرباعي الخاص به",
 "quadriphonic system": "نظام صوتي رباعي القنوات (نظام تسجيل أو إعادة إنتاج صوت ستيريو يستخدم أربع قنوات منفصلة)",
 "quadriplegia": "شلل رباعي (شلل الذراعين والساقين)",
 "quadriplegic": "مشلول رباعياً (شخص مشلول في كلتا ذراعيه وساقيه)",
 "quadrisonic": "رباعي الصوت, رباعي القنوات (من أو متعلق بالصوت الرباعي)\nمثال: نظام الصوت الرباعي الخاص به",
 "quadrivium": "الرباعية ((العصور الوسطى) قسم أعلى من المناهج الدراسية في جامعة من العصور الوسطى يشمل الحساب والموسيقى والهندسة والفلك)",
 "quadroon": "ربع خلاس (نسل لشخص مولد وشخص أبيض؛ شخص ربعه أسود)",
 "quadrumvirate": "مجلس رباعي (مجموعة من أربعة رجال)",
 "quadruped": "رُبَاعِيّ الأَرْجُل (لديه أربعة أقدام) / رباعي الأرجل (حيوان خاصة الثدييات له أربعة أطراف متخصصة للمشي)",
 "quadrupedal": "رُبَاعِيّ الأَرْجُل (لديه أربعة أقدام)",
 "quadruple": "أَرْبَعَةُ أَضْعَافٍ, رُبَاعِيُّ الضِّعْفِ (أربعة أمثال الكمية أو العدد) / رُبَاعِيّ (ذو أربع وحدات أو مكوّنات) / أربعة أضعاف (كمية أكبر بأربع مرات من كمية أخرى) / رباعي (مجموعة من أربعة أشياء متشابهة تُعتبر كوحدة واحدة)",
 "quadruple time": "زمن شائع, وزن رباعي (توقيع زمني يشير إلى أربع دقات في المقياس)",
 "quadruplet": "رباعي (مجموعة من أربعة أشياء متشابهة تُعتبر كوحدة واحدة) / توأم رباعي (واحد من أربعة أطفال ولدوا في نفس الوقت من نفس الحمل) / أَرْبَعَة, رُبَاعِيّ (العدد الأصلي الذي هو مجموع ثلاثة وواحد)",
 "quadruplex": "رُبَاعِيّ (ذو أربع وحدات أو مكوّنات)",
 "quadruplicate": "رُبَاعِيّ (ذو أربع وحدات أو مكوّنات) / نسخة رابعة (أي أربع نسخ؛ أي من أربعة أشياء تتوافق مع بعضها البعض تماماً)\nمثال: تم توقيعه من أربع نسخ",
