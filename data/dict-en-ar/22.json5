 "provable": "قَابِل لِلإِثْبَات, قَابِل لِلْبَرْهَنَة (يمكن إثباته أو البرهنة عليه)",
 "provably": "بِالدَّلِيل, بِشَكْل قَابِل لِلإِثْبَات (بطريقة واضحة وقابلة للإثبات)\nمثال: مصادره الوثائقية خاطئة بشكل قابل للإثبات",
 "prove": "بَرْهَنَ, أَثْبَتَ",
 "proved": "مبرهن, مثبت (تم تأكيده بما لا يدع مجالاً للشك)\nمثال: كاذب مثبت كذبه",
 "proven": "مبرهن, مثبت (تم تأكيده بما لا يدع مجالاً للشك)\nمثال: كاذب مثبت كذبه",
 "provenance": "مسقط الرأس, منشأ (المكان الذي نشأ فيه شيء ما أو تمت رعايته في بداية وجوده)\nمثال: مهد الحضارة",
 "provencal": "بروفنسي (مكون من أو متعلق بمنطقة بروفنس أو شعبها أو ثقافتهم) / البروفنسالية, القسطانية (لهجات العصور الوسطى للغات أوش (جنوب فرنسا))",
 "provence": "بْروفَانْس, بَروفنسة",
 "provence-alpes-côte d'azur": "بروفانس-ألب-كوت دازور",
 "provender": "إمدادات غذائية, تموين (مخزون أو إمدادات من الأطعمة) / علف, عليقة (طعام للماشية والحيوانات الأليفة)",
 "provenience": "مسقط الرأس, منشأ (المكان الذي نشأ فيه شيء ما أو تمت رعايته في بداية وجوده)\nمثال: مهد الحضارة",
 "proventil": "ألبوتيرول, بروفنتيل (موسع للقصبات (الأسماء التجارية فينتولين وبروفنتيل) يستخدم للربو وانتفاخ الرئة وحالات الرئة الأخرى؛ متوفر في أشكال فموية أو استنشاقية؛ الآثار الجانبية…)",
 "provera": "ميدروكسي بروجسترون (مركب بروجستين يستخدم لعلاج اضطرابات الدورة الشهرية)",
 "proverb": "مَثَل, حِكْمَة (الشَبَه؛ النَظِير)\nمثال: قصدته مثل نكتة.",
 "proverbial": "مَثَلِيّ, يُضرَب بِهِ المَثَل (معروف ومتداول على نطاق واسع) / مثلي, مضرب للمثل (من أو يتعلق بمثل أو يشبهه أو معبر عنه في مثل)\nمثال: ركل الدلو المضرب للمثل (كناية عن الموت)",
 "proverbially": "بشكل مضرب للأمثال, كما في الأمثال (بطريقة شيء أصبح مضرباً للمثل)\nمثال: نبات الشيح هذا المر كما في الأمثال",
 "proverbs": "اَلْأَمْثَال",
 "provide": "زَوَّدَ (زَوَّدَ (زوده): أزاده. ويقال زودته كتابا إلى فلان؛ زَوَّدَ(هـ) بكذا: أمده به)",
 "provided": "شَرِيطَةً أَن, عَلَى شَرِيطَة",
 "providence": "بروفيدنس",
 "provident": "حكيم, مدبر (يوفر بعناية للمستقبل) / حَرِيص, مُحْتَاط (حريص فيما يخصّ مصالحه الشخصية)\nمثال: السناجب البرية مدبرة",
 "providential": "رَبَّانِيّ, مِنْ عِنَايَةِ السَّمَاء (مُنَاسِبٌ أَوْ مَحْظُوظٌ بِشَكْلٍ اسْتِثْنَائِيٍّ كَأَنَّمَا بِتَدَخُّلٍ إِلَهِيٍّ) / بِتَدْبير إلَهِيّ, رَبّانِيّ (ناتِج عَن العِنايَة الإلَهِيَّة والتَّدْبير الرَّبّانِيّ) / عنايتي, قدري (يتعلق بالعناية الإلهية أو يميزها)\nمثال: الافتراض بأن الطبيعة تعمل فقط وفقاً لخطة عناية إلهية",
 "providentially": "بتعقل, بحكمة (بطريقة حكيمة) / بقدر إلهي (بطريقة العناية الإلهية) / بتوفيق إلهي, لحسن الحظ (بطريقة محظوظة بفضل العناية)\nمثال: لقد خصصت غرفة نومي الخاصة للعناق، وقمت بحكمة بإزالة السرير والمفتاح، وأخذت نفسي وآلتي الكاتبة إلى غرفة نوم ابني",
 "providently": "بتدبير, بحيطة (بطريقة مدبرة وحكيمة)\nمثال: بتدبير، ادخر بعض المال للطوارئ",
 "provider": "موفر, مُعِيل (شخص يوفر سبل العيش) / مُزوّد, مُورّد (شخص عمله هو توريد خدمة أو سلعة معينة)",
 "province": "وِلَايَة, مُقَاطَعَة (منطقة إدارية لها استقلالها الإداري والمعنوي؛ ويختلف المعنى من بلد لآخر كما يختلف من فترة زمنية لأخرى)\nمثال: كان زيري من ولاية أخرى.",
 "provincial": "إقليمي, ريفي (من خصائص الأقاليم (الريف) أو سكانها) / إقليمي, ريفي (مكون من أو مرتبط بمقاطعة أو إقليم) / فلاح, قروي (شخص من الريف) / رئيس إقليمي ((الكنيسة الكاثوليكية) مسؤول مسؤول عن مقاطعة كنسية يعمل تحت الرئيس العام للرهبنة)\nمثال: ريفي ومساير للأعراف بعمق",
 "provincial capital": "عاصمة المقاطعة (العاصمة لمقاطعة ما)",
 "provincialism": "إقليمية, مناطقية (التحيز لمكان أو منطقة معينة) / سذاجة ريفية, عدم تحضر (افتقار إلى التطور أو التحضر في التفكير)",
 "provincially": "إقليمياً, محلياً (بواسطة الإقليم أو المقاطعة)\nمثال: خاضع لسيطرة إقليمية",
 "proving ground": "حقل تجارب (مكان عمل لاختبار معدات أو أفكار جديدة)",
 "provirus": "طليعة الفيروس",
 "provision": "إمداد, تزويد (نشاط توريد أو توفير شيء ما) / إعداد, تحضير (العملية المعرفية للتفكير فيما ستفعله في حالة حدوث شيء ما) / بند, شرط (شرط منصوص عليه) / إمدادات, مؤونة (مخزون أو إمداد من شيء ما (خاصة الطعام أو الملابس أو الأسلحة))\nمثال: أعيق تخطيطه للتقاعد بسبب العديد من الشكوك",
 "provisional": "مُؤَقَّت, مَشْرُوط",
 "provisionally": "بشكل مشروط, مؤقتاً (مؤقتاً وبشكل مشروط)\nمثال: وافقوا بشكل مؤقت",
 "provisionary": "تَجْرِيبِيّ, مُؤَقَّت (بِمُوجِبِ شُرُوطٍ لَمْ تُسْتَكْمَلْ أَوْ لَمْ يُتَّفَقْ عَلَيْهَا نِهَائِيًّا)",
 "provisioner": "متعهد جيش, ممون معسكر (مورّد للمؤن أو الإمدادات للجيش)",
 "provisions": "إمدادات غذائية, تموين (مخزون أو إمدادات من الأطعمة)",
 "proviso": "بند, شرط (شرط منصوص عليه)\nمثال: قبل بشرط واحد",
 "provisory": "شَرْطِيّ, مُقَيَّدٌ بِتَحَفُّظٍ (خَاضِعٌ لِشَرْطٍ أَوْ تَحَفُّظٍ مُعَيَّنٍ)",
 "provitamin": "طليعة الفيتامين (مادة تتحول إلى فيتامين في الأنسجة الحيوانية)",
 "provitamin a": "طليعة فيتامين أ, كاروتين (متصاوغ برتقالي لهيدروكربون غير مشبع يوجد في العديد من النباتات؛ يتحول إلى فيتامين أ في الكبد)",
 "provo": "بروفو",
 "provocateur": "عميل محرض (عميل سري يحرض المشتبه بهم على ارتكاب أعمال غير قانونية)",
 "provocation": "إِثَارَة, اِسْتِفْزَاز (إِثَارَة: يُجمع على إثارات)\nمثال: كف عن إثارة غضبي.",
 "provocative": "مُسْتَفِز",
 "provocatively": "باستفزاز, بشكل مثير (بطريقة مستفزة)\nمثال: قال باستفزاز: جرب ذلك",
 "provoke": "اِسْتَفَزَّ",
 "provoked": "مُسْتَثَار, مُسْتَفَزّ (أُثير غضبه عمدًا؛ مُحتَدّ بفعل استفزاز مقصود)",
 "provoker": "مثير للفتنة, محرض (شخص يثير المشاكل والقلاقل عمداً)\nمثال: كانت هي المحرضة على شجارهم",
 "provoking": "مُغِيظ, مُهَيِّج (يتسبّب في الغضب أو الاستياء أو يميل إلى ذلك)",
 "provokingly": "باستفزاز, بشكل مثير (بطريقة مستفزة)\nمثال: قال باستفزاز: جرب ذلك",
 "provost": "مدير الجامعة, وكيل الجامعة (إداري جامعي رفيع المستوى)",
 "provost court": "محكمة الشرطة العسكرية (محكمة عسكرية لمحاكمة الأشخاص المتهمين بجرائم بسيطة في منطقة محتلة)",
 "provost guard": "الشرطة العسكرية, حرس الانضباط (مفرزة تحت قيادة قائد الشرطة العسكرية)",
 "provost marshal": "قائِد الشُّرْطَة العَسْكَرِيَّة (المشرف على الشرطة العسكرية)",
 "prow": "أنف, مقدمة (الجزء الأمامي لسفينة أو طائرة)\nمثال: وجه مقدمة القارب نحو خط النهاية",
 "prowess": "براعة, فن (مهارة فائقة يمكنك تعلمها بالدراسة والممارسة والملاحظة)\nمثال: فن المحادثة",
 "prowl": "تجوال خلسة, تسلل (فعل التجوال خلسة)",
 "prowl car": "دورية شرطة, سيارة شرطة (سيارة يجوب فيها رجال الشرطة الشوارع؛ مجهزة باتصالات لاسلكية بالمقر الرئيسي)",
 "prowler": "حائم, متسلل (شخص يتجول خلسة أو يتلصص؛ عادة بنوايا غير مشروعة)",
 "prox": "مِنَ الشَّهْرِ القَادِم (فِي الشَّهْرِ التَّالِي لِلشَّهْرِ الحَالِيّ)",
 "proxemics": "بروكسيميكس, علم القربيات (دراسة المسافات المكانية بين الأفراد في مختلف الثقافات والمواقف)",
 "proximal": "دانٍ, قريب (يقع في أقرب نقطة من نقطة الاتصال أو المنشأ)\nمثال: الطرف الداني للعظم",
 "proximate": "دَانٍ, قَرِيب جِدّاً (قريب جداً في المكان أو الزمان) / قريب, مباشر (الأقرب في الدرجة أو الترتيب (مكاناً أو زماناً) خاصة في سلسلة من الأسباب والنتائج)\nمثال: أخبار عن وصوله القريب",
 "proximity": "قرب (أَدْنَى؛ قدَّرَ)\nمثال: جلست بالقرب منها.",
 "proximo": "مِنَ الشَّهْرِ القَادِم (فِي الشَّهْرِ التَّالِي لِلشَّهْرِ الحَالِيّ)",
 "proxy": "إِنَابَة, اِسْتِنَابَة (عند السالكين: الرجوع عن الغَفْلَة إلى الذِّكْر)",
 "proxy fight": "حرب بالوكالة, نزاع بالوكالة (إجراء يستخدمه المستحوذ للسيطرة على هدف الاستحواذ؛ يحاول المستحوذ إقناع المساهمين الآخرين بضرورة استبدال إدارة الهدف)",
 "proxy war": "حَرْب بِالوِكَالَة (حَرَبَ (حربه) بالحربة حربا: طعنه بها؛ حَرَبَ (ه) حربا: سلبه جميع ما يملك)\nمثال: بوتين مجرم حرب.",
 "prozac": "بروزاك, سارافيم (مثبط استرداد السيروتونين الانتقائي يوصف عادة كمضاد للاكتئاب (الأسماء التجارية بروزاك وسارافيم)؛ يعتقد أنه يعمل عن طريق زيادة نشاط السيروتونين في…)",
 "prude": "متزمت (شخص يهتم بشكل مفرط باللياقة والأعراف)",
 "prudence": "عَقْل, حَنْك (أمسك بأطرافه وربطه، أصلها للشاة والإبل حيث تربط قوائمها كي تبقى باركة فلا تقوم؛ بلغ العَقْل، أصبح عاقلا فاهما راشدا)\nمثال: هي فتاة تسحر العقل.",
 "prudent": "حَرِيص, حَكِيم / حَرِيص",
 "prudential": "اِحْتِرَازِيّ, تَدْبِيرِيّ (ناشئ عن التعقّل أو يتسم به لا سيّما في شؤون الأعمال)",
 "prudently": "بتعقل, بحكمة (بطريقة حكيمة)\nمثال: لقد خصصت غرفة نومي الخاصة للعناق، وقمت بحكمة بإزالة السرير والمفتاح، وأخذت نفسي وآلتي الكاتبة إلى غرفة نوم ابني",
 "prudery": "تزمت, تكلف (تواضع مفرط أو متصنع)",
 "prudish": "مُتَحَفِّظ بِإِفْرَاط, مُتَزَمِّت (مبالِغ في التمسّك باللياقة والتحفّظ)",
 "prudishly": "بتحفظ مفرط, بتزمت (بطريقة متزمتة)\nمثال: تتصرف بتزمت، لكني أتساءل عما إذا كانت عفيفة حقاً إلى هذا الحد",
 "prudishness": "تزمت, تكلف (تواضع مفرط أو متصنع)",
 "prumnopitys amara": "بودوكاربوس مر, سونداكاربوس (شجرة استوائية دائمة الخضرة كبيرة سريعة النمو أحادية المسكن ذات أوراق رمحية لامعة كبيرة؛ من الغابات المطيرة في سومطرة والفلبين إلى شمال كوينزلاند)",
 "prumnopitys andina": "طقسوس برقوقي الثمار (شجرة أو شجيرة دائمة الخضرة في أمريكا الجنوبية)",
 "prumnopitys elegans": "طقسوس برقوقي الثمار (شجرة أو شجيرة دائمة الخضرة في أمريكا الجنوبية)",
 "prumnopitys ferruginea": "صنوبر أسود, ميرو (صنوبرية نيوزيلندية تستخدم للأخشاب؛ يستخدم الخشب الداكن للنجارة الداخلية)",
 "prumnopitys taxifolia": "صنوبر أسود, ماتاي (صنوبرية في أستراليا ونيوزيلندا)",
 "prune": "أَجَاص / عَوِينَة / عَوِينَة مُجَفَّفَة / خَوْخ مُجَفَّف / شَذَبَ, قَضَبَ",
 "prune cake": "كعكة البرقوق (كعكة رطبة تحتوي على البرقوق المجفف الذي تم تحويله إلى هريس)",
 "prune whip": "خفقة البرقوق المجفف (تحلية مصنوعة من مهروس البرقوق المجفف والكريمة المخفوقة)",
 "prunella modularis": "عصفور, عصفور الشوك (طائر مغرد أوروبي صغير بني اللون)",
 "prunella vulgaris": "برونيلا, شفيقة (نبات معمر أوروبي أزرق الزهر مستلقي يعتقد أنه يمتلك خصائص علاجية؛ مستوطن في جميع أنحاء أمريكا الشمالية)",
 "pruner": "مقص تقليم, مِنجل تقليم (منشار تقليم طويل المقبض بشفرة منحنية في النهاية وأحياناً مقص؛ يستخدم لتقليم الأشجار الصغيرة) / مقلّم الأشجار (عامل يخفف ويشذب الأشجار والشجيرات)\nمثال: لم يمسها فأس مقلّم الأشجار",
 "pruning": "تقليم (عملية تشذيب النبات) / قُلامَة (ما تم تقليمه وقصه من النبات)",
 "pruning hook": "مقص تقليم, مِنجل تقليم (منشار تقليم طويل المقبض بشفرة منحنية في النهاية وأحياناً مقص؛ يستخدم لتقليم الأشجار الصغيرة)",
 "pruning knife": "سكين تقليم (سكين بشفرة منحنية أو معقوفة)",
 "pruning saw": "منشار تقليم (منشار يدوي يستخدم لتقليم الأشجار)",
 "pruning shears": "مقص تقليم, مقص شجر (مقص بشفرات قوية يستخدم للتقليم الخفيف للنباتات الخشبية)",
 "pruno": "برونو, خمر السجون (مشروب كحولي محضر من خليط مكونات (مثل البرقوق والزبيب والحليب والسكر) يمكن تخميره لإنتاج الكحول؛ يصنعه نزلاء السجون)",
 "prunus alleghaniensis": "برقوق أليغني (برقوق بري من شمال شرق الولايات المتحدة له ثمار أرجوانية داكنة بلحم أصفر)",
 "prunus americana": "برقوق أحمر أمريكي (أشجار برقوق برية من شرق ووسط أمريكا الشمالية لها فاكهة حمراء برتقالية بلحم أصفر)",
 "prunus amygdalus": "لوز, لوز حلو (شجرة نفضية شجيرية صغيرة موطنها آسيا وشمال أفريقيا لها أزهار وردية جميلة ومكسرات صالحة للأكل ذات قيمة عالية محاطة بقشرة خضراء صلبة؛ تزرع في جنوب…)",
 "prunus angustifolia": "برقوق الخنزير, برقوق تشيكاساو (شجرة شجيرية أمريكية أصلية صغيرة تحمل فاكهة صفراء إلى محمرة صغيرة صالحة للأكل)",
 "prunus armeniaca": "مشمش شائع (شجرة منطقة معتدلة تحمل ثماراً زغبية صفراء إلى وردية)",
 "prunus avium": "كرز حلو (شجرة أوراسية كبيرة تنتج فاكهة مرة داكنة صغيرة في البرية ولكن فاكهة حلوة صالحة للأكل عند الزراعة)",
 "prunus besseyi": "كرز الرمل الغربي (شجيرة زينة قزمية من غرب الولايات المتحدة لها ثمار صالحة للأكل كبيرة سوداء إلى حمراء وصفراء حلوة)",
 "prunus capuli": "كابولين (شجرة كرز أسود مكسيكية لها فاكهة صالحة للأكل)",
 "prunus caroliniana": "غار الكرز, كرز الغار (شجرة مزهرة صغيرة دائمة الخضرة من جنوب الولايات المتحدة)",
 "prunus cerasifera": "برقوق كرزي, ميروبالان (شجرة آسيوية صغيرة تحمل فاكهة حمراء أو صفراء صالحة للأكل)",
 "prunus cerasus": "كرز حامض (شجرة أوراسية صغيرة نوعاً ما تنتج فاكهة حمضية صالحة للأكل حمراء إلى سوداء)",
 "prunus cerasus austera": "موريلو (أي من عدة أشجار كرز حامض مزروعة تحمل فاكهة بقشرة وعصير داكنين)",
 "prunus cerasus caproniana": "أماريل (أي من عدة أشجار كرز حامض مزروعة تحمل فاكهة حمراء شاحبة بعصير عديم اللون)",
 "prunus cerasus marasca": "كرز ماراسكينو, ماراسكا (شجرة كرز بري مر دلماسية تحمل فاكهة يصنع من عصيرها ليكيور الماراسكينو)",
 "prunus cuneata": "كرز رملي, كرز قزم (كرز أمريكي صغير متناثر ينمو في التربة الرملية وله ثمار سوداء أرجوانية دقيقة تكاد لا تؤكل)",
 "prunus dasycarpa": "مشمش أرجواني (مشمش هجين صغير من آسيا وآسيا الصغرى له غصينات أرجوانية وزهور بيضاء تليها فاكهة أرجوانية رديئة)",
 "prunus demissa": "كرز مخنوق غربي (كرز مخنوق من غرب الولايات المتحدة)",
 "prunus domestica": "برقوق شائع (أي من أنواع البرقوق المختلفة واسعة الانتشار التي تزرع في المناطق المعتدلة الباردة)",
 "prunus domestica insititia": "برقوق دمشقي (شجرة برقوق تزرع منذ فترة طويلة لفاكهتها الصالحة للأكل)",
 "prunus dulcis": "لوز, لوز حلو (شجرة نفضية شجيرية صغيرة موطنها آسيا وشمال أفريقيا لها أزهار وردية جميلة ومكسرات صالحة للأكل ذات قيمة عالية محاطة بقشرة خضراء صلبة؛ تزرع في جنوب…)",
 "prunus dulcis amara": "لوز مر (أشجار لوز لها أزهار بيضاء ومكسرات سامة تنتج زيتاً يستخدم للنكهة ولأغراض طبية)",
 "prunus glandulosa": "لوز مزهر قزم (شجيرة صينية صغيرة بفاكهة حمراء داكنة ملساء غير مجعدة تزرع خاصة لزهورها الحمراء أو الوردية أو البيضاء)",
 "prunus ilicifolia": "إيسلاي, كرز هولي الأوراق (برقوق بري دائم الخضرة من كاليفورنيا بأوراق جلدية شائكة وزهور بيضاء)",
 "prunus incisa": "كرز فوجي (شجرة كرز يابانية شجيرية لها أزهار وردية شاحبة)",
 "prunus insititia": "برقوق دمشقي بري (برقوق أوراسي صغير بري أو نصف مدجن يحمل فاكهة بيضاوية صغيرة في عناقيد)",
 "prunus japonica": "كرز الشجيرة الشرقي, لوز مزهر (نبات شرقي خشبي بفاكهة حمراء ملساء غير مجعدة يزرع خاصة لأزهاره البيضاء أو الوردية الشاحبة)",
 "prunus laurocerasus": "غار الكرز, كرز الغار (شجيرة أو شجرة صغيرة أوراسية دائمة الخضرة تزرع كثيراً، لها عناقيد بارزة من الزهور البيضاء وأوراق لامعة وتنتج زيتاً يشبه زيت اللوز المر)",
 "prunus lyonii": "كرز كاتالينا (شجيرة أو شجرة صغيرة دائمة الخضرة توجد في جزيرة كاتالينا (كاليفورنيا))",
 "prunus maritima": "برقوق الشاطئ (شجيرة ساحلية من شمال شرق أمريكا الشمالية لها أزهار بيضاء ملفتة للنظر وفاكهة أرجوانية صالحة للأكل)",
 "prunus mexicana": "برقوق الشجرة الكبيرة (شجرة صغيرة من جنوب غرب الولايات المتحدة لها فاكهة حمراء أرجوانية تزرع أحياناً للزينة لأوراقها الكبيرة)",
 "prunus mume": "مشمش ياباني (شجرة زينة يابانية بزهور بيضاء أو وردية عطرة وثمار صفراء صغيرة)",
 "prunus nigra": "برقوق كندا (شجرة صغيرة موطنها شمال شرق أمريكا الشمالية لها فاكهة حمراء برتقالية مستطيلة)",
 "prunus padus": "كرز الطيور الأوروبي, هاغبيري (شجرة كرز أوروبية صغيرة تشبه كثيراً الكرز المخنوق الأمريكي)",
 "prunus pensylvanica": "كرز الدبوس (كرز بري شجيري صغير من أمريكا الشمالية بفاكهة حمضية حمراء زاهية صغيرة)",
 "prunus persica": "خوخ, دراق (تزرع في المناطق المعتدلة)",
 "prunus persica nectarina": "زليقة, نكتارين (صنف أو طفرة من الخوخ تحمل فاكهة ذات قشرة ناعمة ولحم أصفر (عادة))",
 "prunus pumila": "كرز رملي, كرز قزم (كرز أمريكي صغير متناثر ينمو في التربة الرملية وله ثمار سوداء أرجوانية دقيقة تكاد لا تؤكل)",
 "prunus pumilla susquehanae": "كرز رملي, كرز قزم (كرز أمريكي صغير متناثر ينمو في التربة الرملية وله ثمار سوداء أرجوانية دقيقة تكاد لا تؤكل)",
 "prunus salicina": "برقوق ياباني (شجرة صغيرة من الصين واليابان تحمل برقوقاً كبيراً أصفر إلى أحمر عادة ما يكون أقل جودة نوعاً ما من البرقوق الأوروبي في النكهة)",
 "prunus serotina": "كرز أسود, كرز الروم (كرز بري كبير من أمريكا الشمالية بفاكهة سوداء حامضة مستديرة صالحة للأكل)",
 "prunus serrulata": "كرز شرقي, كرز ياباني (شجرة زينة بفاكهة غير صالحة للأكل تزرع على نطاق واسع في العديد من الأصناف لأزهارها البيضاء)",
 "prunus sieboldii": "كرز ياباني مزهر (شجرة زينة بفاكهة غير صالحة للأكل تزرع على نطاق واسع في العديد من الأصناف لأزهارها الوردية)",
 "prunus spinosa": "خوخ شائك, شجيرة الشوك الأسود (شجيرة أوراسية شائكة ذات ثمار تشبه البرقوق)",
 "prunus subcordata": "برقوق سييرا (شجيرة من ساحل المحيط الهادئ للولايات المتحدة تحمل فاكهة حمراء صغيرة عديمة الطعم)",
 "prunus subhirtella": "كرز برعم الورد, كرز مزهر شتوي (شجيرة أو شجرة موطنها اليابان تزرع للزينة لأزهارها الوردية)",
 "prunus susquehanae": "كرز رملي, كرز قزم (كرز أمريكي صغير متناثر ينمو في التربة الرملية وله ثمار سوداء أرجوانية دقيقة تكاد لا تؤكل)",
 "prunus tenella": "لوز روسي (شجيرة آسيوية تزرع لزهورها الحمراء الوردية)",
 "prunus triloba": "لوز مزهر (شجيرة أو شجرة صغيرة صينية نفضية بأوراق غالباً ما تكون ثلاثية الفصوص تزرع لزهورها الوردية البيضاء)",
 "prunus virginiana": "كرز مخنوق (كرز بري شائع في شرق أمريكا الشمالية له توت أسود مر صغير تفضله الطيور)",
 "prunus virginiana demissa": "كرز مخنوق غربي (كرز مخنوق من غرب الولايات المتحدة)",
 "prurience": "شهوانية, فجور (الشعور برغبة جنسية مرضية أو ميل للفحش)",
 "pruriency": "شهوانية, فجور (الشعور برغبة جنسية مرضية أو ميل للفحش)",
 "prurient": "شَبِق, فَاجِر (يتّسم بالشهوة والنزوات الجنسية)",
 "pruriently": "بشهوانية, بولع جنسي (بطريقة شهوانية بذيئة)",
 "prurigo": "حكاك (مرض التهابي مزمن للجلد يتميز بحطاطات تعلوها بثور وحكة شديدة)",
 "pruritus": "حكاك, حكة مرضية (إحساس حكة شديد يمكن أن يكون له أسباب مختلفة (مثل الحساسية أو العدوى أو اليرقان، إلخ))",
 "pruritus ani": "حكة شرجية (حكة مزمنة في الجلد حول فتحة الشرج)",
 "pruritus vulvae": "حكة فرجية (حكة مستمرة في الأعضاء التناسلية الأنثوية الخارجية)",
 "prussia": "بْرُوسْيَا",
 "prussian": "بروسي (من أو متعلق أو مميز لبروسيا أو سكانها) / بروسي (ألماني ساكن في بروسيا)\nمثال: ضباط بروسيون",
 "prussian asparagus": "هليون الحمام, هليون بروسي (نجمة بيت لحم من العالم القديم ذات براعم صغيرة صالحة للأكل)",
 "prussian blue": "أزرق بروسي (لون أزرق مخضر داكن) / أزرق بروسي, أزرق حديدي (أي من الأصباغ الزرقاء المختلفة)",
 "prussic acid": "حمض البروسيك, حمض الهيدروسيانيك (محلول لسيانيد الهيدروجين في الماء؛ تستخدم المحاليل الضعيفة في التبخير وفي تخليق المركبات العضوية)",
 "pry": "عتلة, مِخْل (رافعة حديدية ثقيلة أحد طرفيها مُشَكَّل كإسفين)",
 "pry bar": "عتلة, مِخْل (رافعة حديدية ثقيلة أحد طرفيها مُشَكَّل كإسفين)",
 "prying": "مُتَطَفِّل, مُتَلَصِّص (فضولي بطريقة مُسِيئة ومتطفلة) / تطفل, حشرية (فضول مزعج وتدخل فيما لا يعنيك)",
 "pryingly": "بتطفل, بفضول (بطريقة فضولية متطفلة)\nمثال: سألت مستأجرتها المحتملة بتطفل: هل لديك صديق؟",
 "przevalski's horse": "حصان برزوالسكي (حصان بري في وسط آسيا يشبه الحمار؛ مهدد بالانقراض الآن)",
 "przewalski's horse": "حصان برزوالسكي (حصان بري في وسط آسيا يشبه الحمار؛ مهدد بالانقراض الآن)",
 "ps": "مُلَاحَظَة",
 "psa": "مستضد البروستاتا النوعي (بروتين تنتجه غدة البروستاتا حصرياً؛ يرتبط ارتفاع مستوياته في الدم بتضخم البروستاتا الحميد وسرطان البروستاتا)",
 "psa blood test": "فحص مستضد البروستاتا النوعي (فحص دم يقيس مستويات بروتين يسمى مستضد البروستاتا النوعي)",
 "psaki": "بْسَاكِي",
 "psalm": "مَزْمُور",
 "psalmist": "مرتل المزامير, ناظم المزامير (مؤلف للأغاني المقدسة)\nمثال: يُطلق على داود اسم مرتل المزامير لأنه يُعتقد أنه مؤلف سفر المزامير",
 "psalmody": "ترتيل المزامير (فعل غناء المزامير أو التراتيل)",
 "psalms": "الْمَزَامِير, الزَّبُور",
 "psalter": "سِفْر المَزَامِير, زَبُور (السَّفَرُ : قَطْعُ المسافة؛ هو مِنِّي سفَرٌ : بعيد)\nمثال: صاحبته في السفر.",
 "psalterium": "أم التلافيف, المعدة الثالثة (القسم الثالث من معدة الحيوان المجتر)",
 "psaltery": "سُنْطُور آلَةْ مُوسِيقِيَّة",
 "psammoma": "ورم رملي (ورم مشتق من النسيج الليفي للسحايا أو الضفيرة المشيمية)",
 "psephologist": "عالم انتخابات (عالم اجتماع يدرس اتجاهات الانتخابات)",
 "psephology": "علم الانتخابات (فرع علم الاجتماع الذي يدرس اتجاهات الانتخابات)",
 "psephurus gladis": "سمكة المجداف الصينية (سمكة في الأنهار الكبيرة في الصين تشبه سمكة المجداف في المسيسيبي)",
 "psetta maxima": "تربوت (سمكة مفلطحة أوروبية كبيرة بنية اللون)",
 "psettichthys melanostichus": "سمك موسى الرملي (سمكة مفلطحة شائعة من ساحل المحيط الهادئ لأمريكا الشمالية)",
 "pseud": "دجال, محتال (شخص يقدم ادعاءات خادعة)",
 "pseudaletia unipuncta": "دودة الجيش (عثة تسافر يرقاتها المدمرة في حشود) / دودة الحشد (يرقات عثة ليلية تسافر في مجموعات كبيرة وتدمر العشب والحبوب بشكل خاص)",
 "pseudechis porphyriacus": "ثعبان أسود أسترالي (ثعبان كبير شبه مائي من أستراليا؛ أسود من الأعلى ببطن أحمر)",
 "pseudemys concinna": "كوتر (سلحفاة نهرية كبيرة من جنوب الولايات المتحدة وشمال المكسيك)",
 "pseudemys rubriventris": "سلحفاة حمراء البطن (سلحفاة مياه عذبة من روافد خليج تشيسابيك لها علامات حمراء على الصدفة السفلية)",
 "pseudemys scripta": "سلحفاة منزلقة (سلحفاة مياه عذبة من الولايات المتحدة وأمريكا الجنوبية؛ تُربى تجارياً بشكل متكرر؛ يُباع بعض صغارها كحيوانات أليفة)",
 "pseudepigrapha": "الكتابات المنحولة, سوديبيجرافا (52 نصاً كُتبت بين 200 قبل الميلاد و200 ميلادي ولكن نُسبت إلى أنبياء وملوك مختلفين في الكتب المقدسة العبرية)",
 "pseudo": "زَائِف المَظْهَر, شِبْه ((غالباً يُستخدم في التركيبات) غير حقيقي لكنه يحمل مظهر الحقيقي) / دجال, محتال (شخص يقدم ادعاءات خادعة)",
 "pseudo-": "زائف",
 "pseudobombax ellipticum": "شجرة فرشاة الحلاقة (شجرة من المكسيك إلى غواتيمالا ذات أزهار مشعرة بكثافة ببتلات ضيقة طويلة متجمعة في نهايات الفروع قبل ظهور الأوراق)",
 "pseudobulb": "بصلة كاذبة (تضخم صلب يشبه البصلة في ساق بعض بساتين الفاكهة)",
 "pseudocarp": "ثمرة كاذبة, فاكهة ملحقة (فاكهة تحتوي على الكثير من الأنسجة اللحمية بجانب تلك الموجودة في المبيض الناضج؛ مثل التفاح أو الفراولة)",
 "pseudococcus comstocki": "بق كومستوك الدقيقي (حشرة آسيوية أُدخلت عن طريق الخطأ إلى الولايات المتحدة؛ آفة على أشجار الحمضيات والتفاح)",
 "pseudococcus fragilis": "بق دقيقي محب للحمضيات (مدمر للحمضيات بشكل خاص)",
 "pseudocolus fusiformis": "الحبار النتن (فطر نتن من جنس بسودوكولوس؛ يشبه الجسم الثمري في البداية فطراً نفاثاً صغيراً ينفتح قريباً ليشكل ساقاً بأذرع مستدقة تتقوس وتستدق إلى نقطة مشتركة)",
 "pseudocyesis": "حَمْل كَاذِب (رَفَعَ، أَقَلَّ)\nمثال: حمل سامي سلاحه.",
 "pseudoephedrine": "سودوإيفيدرين (قلويد بلوري سام يوجد مع الإيفيدرين ومتماثل معه في الشكل)",
 "pseudohallucination": "شبه هلوسة, هلوسة كاذبة (صورة حية بما يكفي لتكون هلوسة ولكن يتم التعرف عليها على أنها غير حقيقية)",
 "pseudohermaphrodite": "خُنْثَوِيّ كَاذِب (يمتلك أعضاء تناسلية داخلية لجنس وخصائص جنسية خارجية للجنس الآخر) / خنثى كاذبة (شخص لديه أعضاء تناسلية خارجية لجنس وأعضاء جنسية داخلية للجنس الآخر؛ ليس خنثى حقيقياً لعدم وجود غموض في جنس الأعضاء الخارجية)",
 "pseudohermaphroditic": "خُنْثَوِيّ كَاذِب (يمتلك أعضاء تناسلية داخلية لجنس وخصائص جنسية خارجية للجنس الآخر)",
 "pseudohermaphroditism": "خنثية كاذبة (حالة خلقية يمتلك فيها الشخص أعضاء تناسلية خارجية لجنس وأعضاء جنسية داخلية للجنس الآخر)",
 "pseudohypertrophic dystrophy": "حثل دوشين العضلي ((حثل) حثلا: ساءَت حاله)",
 "pseudolarix amabilis": "لاريكس ذهبي, لاريكس كاذب (صنوبرية صينية متساقطة الأوراق تشبه اللاريكس بأوراق صفراء ذهبية)",
 "pseudometric space": "فضاء شبه متري, فضاء متري كاذب (فضاء متري معمّم يمكن أن تكون فيه المسافة بين نقطتين مختلفتين صفراً)\nمثال: بنفس الطريقة التي يكون فيها كل فضاء معياري فضاءً مترياً، فإن كل فضاء شبه معياري هو فضاء شبه متري",
 "pseudomonad": "زائفة, سودوموناس (بكتيريا تنتج عادة صبغة خضراء فلورية قابلة للذوبان في الماء؛ بعضها ممرض للنباتات والحيوانات)",
 "pseudomonas solanacearum": "بكتيريا العفن الحلقي, زائفة باذنجانية (تسبب العفن البني في الطماطم والبطاطس والتبغ وغيرها)",
 "pseudonym": "اِسْم مُسْتَعَار (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)\nمثال: ما اسم حصان توم؟",
 "pseudonymous": "بِاسْمٍ مُسْتَعَار, مُسْتَعَار الاِسْم (يحمل اسمًا مُستعارًا أو يُعرَف به، وغالبًا ما يكون اسمًا أدبيًّا)",
 "pseudoperipteral": "مُحِيطِيّ الأَعْمِدَة (ذو أعمدة تحيط بالبناء من جميع الجهات)",
 "pseudophloem": "لحاء كاذب (لحاء كاذب)",
 "pseudopleuronectes americanus": "سمك موسى الليموني, فلو ندر الشتاء (سمكة طعام أمريكية مهمة في الشتاء)",
 "pseudopod": "قدم كاذبة (نتوء مؤقت تستخدمه بعض الكائنات الحية الدقيقة كعضو للتغذية أو الحركة)",
 "pseudopodium": "قدم كاذبة (نتوء مؤقت تستخدمه بعض الكائنات الحية الدقيقة كعضو للتغذية أو الحركة)",
 "pseudoprostyle": "أُحَادِيّ الرِّوَاق (يتّسم بأعمدة حرّة في رواق واحد فقط عند المدخل)",
 "pseudorubella": "طفح وردي, وردية الرضيع (مرض فيروسي يصيب الرضع والأطفال الصغار؛ يتميز بحمى عالية مفاجئة تليها طفح جلدي وردي باهت)",
 "pseudoryx nghetinhensis": "ساولا, ماعز الغابة (مخلوق يشبه البقرة بمعطف لامع كالحصان ورشاقة كالماعز وقرون طويلة كالظبي؛ يوصف بأنه بقرة تعيش حياة الماعز)",
 "pseudoscience": "علم زائف (نشاط يشبه العلم ولكنه يعتمد على افتراضات مغلوطة)",
 "pseudoscientific": "عِلْمِيٌّ زَائِف (قائم على نظريّات ومناهج يُعتَقد خطأً أنّها علميّة)",
 "pseudoscorpion": "عَقْرَب زَائِفَة, عَقْرَب مُزَيَّف",
 "pseudosmallpox": "جدري خفيف (شكل خفيف من الجدري يسببه فيروس أقل ضراوة)",
 "pseudotaxus chienii": "طقسوس أبيض التوت (طقسوس من جنوب شرق الصين، يختلف عن طقسوس العالم القديم بوجود توت أبيض)",
 "pseudotsuga macrocarpa": "تنوب دوغلاس كبير المخروط (تنوب دوغلاس من كاليفورنيا له مخاريط بطول 4-8 بوصات)",
 "pseudotsuga menziesii": "تنوب دوغلاس الأخضر, صنوبر أوريغون (تنوب دوغلاس شاهق من شمال غرب أمريكا الشمالية له إبر قصيرة ومخاريط بيضاوية الشكل)",
 "pseudovariola": "جدري خفيف (شكل خفيف من الجدري يسببه فيروس أقل ضراوة)",
 "pseudowintera colorata": "شجيرة الفلفل (شجيرة دائمة الخضرة أو شجرة صغيرة أوراقها ملطخة بوضوح باللونين الأحمر والأصفر ولها ثمار سوداء صغيرة)",
 "psi": "پْسِي, بْسِي",
 "psi particle": "جُسَيْم جاي (ميزون متعادل ذو كتلة كبيرة)",
 "psidium cattleianum": "جوافة الفراولة الأرجوانية, جوافة كاتلي (شجرة شجيرية استوائية صغيرة تحمل ثماراً بيضاوية حمراء داكنة)",
 "psidium guajava": "جوافة, شجرة الجوافة (شجرة شجيرية استوائية أمريكية صغيرة؛ تزرع على نطاق واسع في المناطق الدافئة لفاكهتها الصفراء الكروية الحلوة)",
 "psidium guineense": "جوافة برازيلية (شجرة من أمريكا الجنوبية لها ثمار تشبه الجوافة الحقيقية)",
 "psidium littorale": "جوافة الفراولة, جوافة كاتلي الصفراء (شجرة شجيرية استوائية صغيرة تحمل ثماراً صفراء صغيرة)",
 "psidium littorale longipes": "جوافة الفراولة الأرجوانية, جوافة كاتلي (شجرة شجيرية استوائية صغيرة تحمل ثماراً بيضاوية حمراء داكنة)",
 "psilocin": "سيلوسيبين (مركب مهلوس يتم الحصول عليه من فطر) / سيلوسين (قلويد تريبتامين ومادة مخدرة ذات تأثير سيروتونيني، توجد في معظم الفطر المخدر جنباً إلى جنب مع نظيرتها المفسفرة السيلوسيبين)\nمثال: التأثيرات المغيرة للعقل للسيلوسين متغيرة للغاية وشخصية وتشبه تأثيرات إل إس دي وثنائي ميثيل تريبتامين",
 "psilocine": "سيلوسين (قلويد تريبتامين ومادة مخدرة ذات تأثير سيروتونيني، توجد في معظم الفطر المخدر جنباً إلى جنب مع نظيرتها المفسفرة السيلوسيبين)\nمثال: التأثيرات المغيرة للعقل للسيلوسين متغيرة للغاية وشخصية وتشبه تأثيرات إل إس دي وثنائي ميثيل تريبتامين",
 "psilocybin": "سيلوسيبين (مركب مهلوس يتم الحصول عليه من فطر)",
 "psilocyn": "سيلوسين (قلويد تريبتامين ومادة مخدرة ذات تأثير سيروتونيني، توجد في معظم الفطر المخدر جنباً إلى جنب مع نظيرتها المفسفرة السيلوسيبين)\nمثال: التأثيرات المغيرة للعقل للسيلوسين متغيرة للغاية وشخصية وتشبه تأثيرات إل إس دي وثنائي ميثيل تريبتامين",
 "psilomelane": "بسيلوميلان (معدن يتكون من أكسيد المنغنيز والباريوم المائي؛ مصدر للمنغنيز)",
 "psilophyte": "سيلوفيت, نبات عاري",
 "psilophyton": "سيلوفيتون (أي نبات أو أحفور من جنس سيلوفيتون)",
 "psilosis": "تجريد, تساقط الشعر (سقوط الشعر) / إسهال مداري, ذرب (اضطراب مزمن يحدث بأشكال مدارية وغير مدارية وفي كل من الأطفال والبالغين؛ لا يتم امتصاص العناصر الغذائية؛ تشمل الأعراض إسهالاً كريه الرائحة وهزالاً)",
 "psilotsin": "سيلوسين (قلويد تريبتامين ومادة مخدرة ذات تأثير سيروتونيني، توجد في معظم الفطر المخدر جنباً إلى جنب مع نظيرتها المفسفرة السيلوسيبين)\nمثال: التأثيرات المغيرة للعقل للسيلوسين متغيرة للغاية وشخصية وتشبه تأثيرات إل إس دي وثنائي ميثيل تريبتامين",
 "psilotum nudum": "بسيلوتوم عاري, سرخس الشوكة العظمي (سرخس خفقي هوائي أو أرضي استوائي شامل بفروع صفراء باهتة عادة وأوراق دقيقة؛ موطنه أمريكا واليابان وأستراليا)",
 "psittacosaur": "بسيتاكوصور (ديناصور بدائي يفتقر في الواقع إلى القرون وله فقط بداية كشكش؛ أطرافه الخلفية طويلة والأمامية قصيرة؛ ربما كان ثنائي الأرجل)",
 "psittacosaurus": "بسيتاكوصور (ديناصور بدائي يفتقر في الواقع إلى القرون وله فقط بداية كشكش؛ أطرافه الخلفية طويلة والأمامية قصيرة؛ ربما كان ثنائي الأرجل)",
 "psittacosis": "حمى الببغاء, داء الببغائية (التهاب رئوي لانمطي يسببه كائن دقيق من الريكيتسيا وينتقل إلى البشر من الطيور المصابة) / حمى الببغاء, داء الببغائية (مرض معد يصيب الطيور)",
 "psittacula krameri": "ببغاء مطوق (ببغاء أفريقي)",
 "psittacus erithacus": "ببغاء رمادي أفريقي (ببغاء رمادي مدجن شائع بذيل أحمر وأسود ووجه أبيض؛ موطنه أفريقيا الاستوائية)",
 "pskov": "بْسْكُوف",
 "psoas": "عضلة قطنية (أي من عضلتين في البطن والحوض تثني الجذع وتدير الفخذ)",
 "psocid": "قمل القلف (حشرة مجنحة صغيرة تعيش على لحاء وأوراق الأشجار وتتغذى على الفطريات والمواد النباتية المتحللة)",
 "psocopterous insect": "قمل الكتب (حشرة صغيرة ناعمة الجسم بأجزاء فم ماضغة وإما بدون أجنحة أو بزوجين منها)",
 "psophia crepitans": "بواق برازيلي (بواق من البرازيل وغيانا؛ غالباً ما يُربى لحماية الدواجن في البرازيل)",
 "psophocarpus tetragonolobus": "فاصوليا مجنحة, فول غوا (كرمة حولية درنية ملتفة تحمل عناقيد من الزهور الأرجوانية وقروناً بأربعة أجنحة مسننة؛ المناطق الاستوائية في العالم القديم)",
 "psoralea esculenta": "جذر الخبز, سوراليا (نبات معمر كثيف الشعر في وسط أمريكا الشمالية له جذور درنية صالحة للأكل)",
 "psoriasis": "صَدَفِيَّة",
 "psoriatic arthritis": "التهاب المفاصل الصدفي (شكل من أشكال التهاب المفاصل الروماتويدي يصيب عادة الأصابع وأصابع القدم ويرتبط بالصدفية)",
 "pst": "توقيت المحيط الهادئ (التوقيت القياسي في المنطقة الزمنية الثامنة غرب غرينتش، يحسب عند خط الطول 120 غرباً؛ يستخدم في الولايات الغربية البعيدة بالولايات المتحدة)",
 "psyche": "سيكي",
 "psychedelia": "ثقافة المخدرات, سايكيديليا (الثقافة الفرعية لمستخدمي المخدرات المهلوسة)",
 "psychedelic": "مُخَدِّرِيّ, مُهَلْوِس ((لحالة ذهنية) يتسم بإدراكات مشوّهة وهلوسات ومشاعر نشوة أو يأس) / سَايْكِدِيلِيّ (ذو ألوان صارخة ومتداخلة وكثيفة كتلك المرتبطة بالمهلوسات) / سَايْكِدِلِيّ, مُخَدِّر (يُنتِج تشوّهات في الإدراك الحسّيّ أو حالات وعي متغيّرة)",
 "psychedelic drug": "عقار مهلوس, مهلوس (عقار ذو تأثير نفسي يحفز الهلاوس أو تجارب حسية متغيرة)",
 "psychedelic rock": "روك مخدر, سايكيديلك روك (نمط موسيقي ظهر في الستينيات؛ موسيقى روك مستوحاة من أو مرتبطة بتجربة تعاطي المخدرات)",
 "psychiatric": "طب نفسي, نفسي (متعلق بممارسة الطب النفسي أو مستخدم فيه)\nمثال: اضطراب نفسي",
 "psychiatric hospital": "مستشفى الأمراض العقلية, مصح نفسي (مستشفى للأشخاص غير المتزنين عقلياً)",
 "psychiatrical": "طب نفسي, نفسي (متعلق بممارسة الطب النفسي أو مستخدم فيه)\nمثال: اضطراب نفسي",
 "psychiatrist": "طَبِيب نَفْسَانِيّ (العالم بالطب)\nمثال: سوف تصبح طبيبة.",
 "psychiatry": "الطِّبّ النَّفْسِيّ",
 "psychic": "رُوحَانِيّ, نَفْسَانِيّ (خارج نطاق العلوم الفيزيائية) / رُوحَانِيّ, نَفْسِيّ (يؤثّر في النفس البشريّة أو يتأثّر بها) / نفساني, وسيط روحي (شخص يبدو حساساً لأشياء تتجاوز النطاق الطبيعي للإدراك)",
 "psychic communication": "تواصل خارق, تواصل روحي (تواصل عبر وسائل خارقة للطبيعة)",
 "psychic energy": "طاقة عقلية, طاقة نفسية (قوة أو عامل محرك في النفس)",
 "psychic phenomena": "باراسيكولوجيا, ظواهر نفسية خارقة (ظواهر تبدو وكأنها تتناقض مع القوانين الفيزيائية وتشير إلى إمكانية السببية عن طريق العمليات العقلية)",
 "psychic phenomenon": "باراسيكولوجيا, ظواهر نفسية خارقة (ظواهر تبدو وكأنها تتناقض مع القوانين الفيزيائية وتشير إلى إمكانية السببية عن طريق العمليات العقلية)",
 "psychic trauma": "صدمة, صدمة نفسية (جرح أو صدمة عاطفية غالباً ما يكون لها آثار طويلة الأمد)",
 "psychical": "رُوحَانِيّ, نَفْسَانِيّ (خارج نطاق العلوم الفيزيائية) / رُوحَانِيّ, نَفْسِيّ (يؤثّر في النفس البشريّة أو يتأثّر بها)",
 "psychical communication": "تواصل خارق, تواصل روحي (تواصل عبر وسائل خارقة للطبيعة)",
 "psychically": "نفسياً (من وجهة نظر نفسية)\nمثال: كان أعمى نفسياً",
 "psycho": "مَذْهُول, مُصاب بِذُهان (شخص مصاب بالذهان)",
 "psychoactive": "مؤثر عقلي, منشط نفسي (يؤثر على العقل أو المزاج أو العمليات العقلية الأخرى)\nمثال: أدوية مؤثرة عقلياً",
 "psychoactive drug": "عقار مؤثر عقلياً, مادة ذات تأثير نفسي (عقار يمكن أن ينتج تغيرات في المزاج وتشوهات في الإدراك)",
 "psychoactive substance": "عقار مؤثر عقلياً, مادة ذات تأثير نفسي (عقار يمكن أن ينتج تغيرات في المزاج وتشوهات في الإدراك)",
 "psychoanalysis": "تحليل نفسي, علم نفس الأعماق (مجموعة من التقنيات لاستكشاف الدوافع الكامنة وطريقة لعلاج الاضطرابات العقلية المختلفة؛ تستند إلى نظريات سيغموند فرويد)\nمثال: أوصى طبيبه بالتحليل النفسي",
 "psychoanalyst": "محلل نفسي (ممارس مرخص للتحليل النفسي)",
 "psychoanalytic": "تحليلي نفسي (متعلق بأساليب ونظرية العلاج النفسي التي وضعها سيغموند فرويد)\nمثال: نظريات فرويد للتحليل النفسي",
 "psychoanalytic process": "عملية التحليل النفسي (عملية يفترض حدوثها في نظرية التحليل النفسي)",
 "psychoanalytical": "تحليلي نفسي (متعلق بأساليب ونظرية العلاج النفسي التي وضعها سيغموند فرويد)\nمثال: نظريات فرويد للتحليل النفسي",
 "psychobabble": "ثرثرة نفسية (استخدام لغة محملة بالمصطلحات النفسية)",
 "psychodid": "فراشيات المظهر",
 "psychodynamics": "ديناميكا نفسية (فرع علم النفس الاجتماعي الذي يتعامل مع العمليات والعواطف التي تحدد النفسية والدافع) / دِينَامِيكِيَّة نَفْسِيَّة (الترابط بين العمليات والعواطف الواعية وغير الواعية التي تحدد الشخصية والدوافع)",
 "psychogalvanic response": "استجابة الجلد الجلفانية (تغير في الخصائص الكهربائية للجلد استجابة للتوتر أو القلق)",
 "psychogenesis": "نشوء نفسي (مصطلح عام لأصل وتطور أي جانب من جوانب العقل تقريبًا) / منشأ نفسي (تطور اضطراب ما في حياة الفرد ناتج عن عوامل نفسية بدلاً من عوامل فسيولوجية)",
 "psychogenetic": "تكويني نفسي (متعلق بأصل وتطور العقل) / نفسي المنشأ (متعلق بالسبب النفسي للاضطراب)",
 "psychogenic": "نَفْسِيّ المَنْشَأ (ذو منشأ نفسيّ أو عاطفيّ لا جسديّ) / نفسي المنشأ (متعلق بالسبب النفسي للاضطراب)",
 "psychogenic fugue": "شرود, شرود نفسي (اضطراب انشقاقي ينسى فيه الشخص من هو ويغادر المنزل لبدء حياة جديدة؛ أثناء الشرود لا توجد ذاكرة للحياة السابقة؛ وبعد التعافي لا توجد ذاكرة للأحداث…)",
 "psychographics": "تصنيف نفسي, سايكوغرافيك (بحث السوق أو الإحصاءات التي تصنف المجموعات السكانية وفقاً للمتغيرات النفسية (مثل المواقف، القيم، أو المخاوف))",
 "psychokinesis": "تحريك عن بعد, تحريك نفسي (القدرة على تحريك شيء ما عن طريق التفكير فيه دون تطبيق قوة فيزيائية)",
 "psychokinetic": "تَحْرِيكِيّ ذِهْنِيّ (يُحرِّك الأشياء دون استخدام وسائل مادية ظاهرة)",
 "psycholinguist": "عالم لغويات نفسي (شخص (عادة ما يكون طبيباً نفسياً أو لغوياً) يدرس الأساس النفسي للغة البشرية)",
 "psycholinguistic": "لغوي نفسي (من أو يتعلق بعلم اللغة النفسي)",
 "psycholinguistics": "لسانيات نفسية (فرع علم النفس المعرفي الذي يدرس الأساس النفسي للكفاءة والأداء اللغوي)",
 "psychological": "سَيْكُولُوجِيّ, نَفْسَانِيّ (عقليّ أو عاطفيّ بطبيعته لا جسديّ) / سيكولوجي, نفسي (متعلق علم النفس أو محدد به)\nمثال: نظريات نفسية",
 "psychological condition": "حالة عقلية, حالة نفسية ((علم النفس) حالة عقلية تكون فيها صفات الحالة ثابتة نسبيًا على الرغم من أن الحالة نفسها قد تكون ديناميكية)\nمثال: الإجهاد ليس الحالة العاطفية أو العقلية الوحيدة التي يمكن أن تستفيد من التأمل المنتظم",
 "psychological disorder": "اضطراب عقلي, اضطراب نفسي ((الطب النفسي) اضطراب نفسي في التفكير أو العاطفة؛ مصطلح أكثر حيادية من المرض العقلي)",
 "psychological feature": "سِمَة نَفْسِيَّة (سمة من سمات الحياة العقليّة والنفسيّة للكائن الحيّ)",
 "psychological medicine": "طب نفسي (فرع الطب المعني بتشخيص وعلاج الاضطرابات العقلية)",
 "psychological moment": "اللحظة النفسية المناسبة (الوقت الأنسب لتحقيق التأثير المطلوب)",
 "psychological operation": "عملية نفسية (إجراءات عسكرية مصممة للتأثير على تصورات ومواقف الأفراد والجماعات والحكومات الأجنبية)",
 "psychological science": "علم النفس (علم الحياة العقلية)",
 "psychological state": "حالة عقلية, حالة نفسية ((علم النفس) حالة عقلية تكون فيها صفات الحالة ثابتة نسبيًا على الرغم من أن الحالة نفسها قد تكون ديناميكية)\nمثال: الإجهاد ليس الحالة العاطفية أو العقلية الوحيدة التي يمكن أن تستفيد من التأمل المنتظم",
 "psychological warfare": "حرب أعصاب, حرب نفسية (استخدام تكتيكات نفسية لتدمير معنويات الخصوم)",
 "psychologically": "نفسياً (فيما يتعلق بعلم النفس) / من الناحية النفسية, نفسياً (من حيث علم النفس)\nمثال: حرب أوقعتهم في شراكها سواء نفسياً أو جسدياً",
 "psychologist": "نَفْسَانِيّ, عَالِم النَّفْس",
 "psychology": "سَيْكُولُوجْيَا, عِلْم النَّفْس",
 "psychology department": "قسم علم النفس (القسم الأكاديمي المسؤول عن التدريس والبحث في علم النفس)",
 "psychomachy": "صراع النفس (صراع الروح (كما هو الحال مع الجسد أو بين الخير والشر))",
 "psychometric": "سيكومتري, قياسي نفسي (متعلق بالقياس النفسي)\nمثال: مجلات القياس النفسي",
 "psychometric test": "اختبار, اختبار عقلي (أي إجراء موحد لقياس الحساسية أو الذاكرة أو الذكاء أو الكفاءة أو الشخصية وما إلى ذلك)\nمثال: تم توحيد الاختبار على عينة كبيرة من الطلاب",
 "psychometrics": "سيكومتريا, قياس نفسي (أي فرع من فروع علم النفس المعني بالقياسات النفسية)",
 "psychometrika": "سيكومتريا, قياس نفسي (أي فرع من فروع علم النفس المعني بالقياسات النفسية)",
 "psychometry": "سيكومتريا, قياس نفسي (أي فرع من فروع علم النفس المعني بالقياسات النفسية)",
 "psychomotor": "نفسي حركي (متعلق بالأحداث العقلية التي لها نتائج حركية أو العكس)",
 "psychomotor development": "تطور نفسي حركي (الاكتساب التدريجي للمهارات التي تنطوي على كل من الأنشطة العقلية والحركية)",
 "psychomotor epilepsy": "صرع الفص الصدغي, صرع نفسي حركي (صرع يتميز سريرياً بضعف الوعي وفقدان الذاكرة للنوبة؛ غالباً ما يتضمن حركات هادفة للذراعين والساقين وأحياناً هلوسة)",
 "psychoneurosis": "عصاب, عصاب نفسي (اضطراب عقلي أو في الشخصية لا يعزى إلى أي خلل عصبي أو عضوي معروف)",
 "psychoneurotic": "عصابي, مريض نفسياً (مصاب باضطراب عاطفي) / عُصابِيّ, مَرِيض نَفْسِيّ (شخص يعاني من العصاب)",
 "psychonomics": "علم النفس التجريبي (فرع علم النفس الذي يستخدم الأساليب التجريبية لدراسة القضايا النفسية)",
 "psychopath": "سِيكُوباتِيّ, مُعْتَلّ اجْتِماعِيّاً (شخص ذو شخصية معادية للمجتمع)",
 "psychopathic": "ذُو اعْتِلَالٍ نَفْسِيّ, سِيكُوبَاتِيّ (يعاني من اضطراب نفسيّ غير مُشخَّص)",
 "psychopathic personality": "اضطراب الشخصية المعادية للمجتمع, شخصية سيكوباتية (اضطراب في الشخصية يتميز باللاأخلاقية ونقص العاطفة؛ قادر على ارتكاب أعمال عنيفة دون شعور بالذنب)",
 "psychopathologic": "ذُو اعْتِلَالٍ نَفْسِيّ, سِيكُوبَاتِيّ (يعاني من اضطراب نفسيّ غير مُشخَّص)",
 "psychopathological": "ذُو اعْتِلَالٍ نَفْسِيّ, سِيكُوبَاتِيّ (يعاني من اضطراب نفسيّ غير مُشخَّص)",
 "psychopathology": "طب نفسي (فرع الطب المعني بتشخيص وعلاج الاضطرابات العقلية) / علم النفس المرضي, علم النفس غير السوي (فرع علم النفس المعني بالسلوك غير الطبيعي)",
 "psychopathy": "اعتلال نفسي, مرض عقلي (أي مرض يصيب العقل؛ الحالة النفسية لشخص يعاني من مشاكل عاطفية أو سلوكية خطيرة بما يكفي لتطلب تدخل الطب النفسي)",
 "psychopharmacological": "دوائي نفسي (من أو يتعلق بعلم الأدوية النفسية)",
 "psychopharmacologist": "طبيب نفساني (العالم بالطب)\nمثال: سوف تصبح طبيبة.",
 "psychopharmacology": "علم الأدوية النفسية (دراسة الأدوية التي تؤثر على العقل)",
 "psychophysicist": "عالم فيزياء نفسية (عالم نفس مدرب في الفيزياء النفسية)",
 "psychophysics": "فيزياء نفسية (فرع علم النفس المعني بالعلاقات الكمية بين المحفزات الفيزيائية وتأثيراتها النفسية)",
 "psychophysiology": "علم النفس العصبي, علم النفس الفسيولوجي (فرع علم النفس المعني بالأسس الفسيولوجية للعمليات النفسية)",
 "psychopomp": "مُرْشِد الأَرْوَاح (المُرْشِد : من يقوم بدور التَّوجيه والإرشاد؛ من يُساعد السُّفن بتعليماته لاجتياز القنوات أو للإرساء في المرافئ)\nمثال: كيف استطيع الحصول على مرشد سياحي.",
 "psychopsis krameriana": "سيكوبسيس كراميريانا",
 "psychopsis papilio": "أونسيديوم بابيليو, سحلب الفراشة",
 "psychosexual": "نفسي جنسي (متعلق بالمواقف العقلية أو العاطفية تجاه الجنسانية)",
 "psychosexual development": "تطور نفسي جنسي ((التحليل النفسي) العملية التي تنضج خلالها الشخصية والسلوك الجنسي عبر سلسلة من المراحل: المرحلة الفموية، ثم المرحلة الشرجية، ثم المرحلة القضيبية، ثم…)",
 "psychosexuality": "نفسية جنسية (التمثيل العقلي للأنشطة الجنسية)",
 "psychosis": "ذُهَان ((في علم النفس) حالة غير طبيعية للعقل تؤدي إلى صعوبات في تحديد ما هو حقيقي وما هو غير حقيقي)\nمثال: كان فاضل يعالج بأدوية مضادة للذهان.",
 "psychosomatic": "سَيْكُوسُومَاتِيّ, نَفْسَجَسَدِيّ (يوصف به المرض أو الأعراض الناتجة عن العُصاب)",
 "psychosomatic disorder": "اضطراب سيكوسوماتي, اضطراب نفسي جسدي (اضطراب عقلي يسبب أعراضاً جسدية)",
 "psychosurgery": "جراحة نفسية (جراحة دماغ على مرضى بشريين تهدف إلى تخفيف مشاكل عقلية أو سلوكية حادة ومستعصية)",
 "psychotherapeutic": "عِلاجِيّ نَفْسِيّ (يَتَعَلَّق بِالعِلاج النَّفْسِيّ أو يُفيد فيه) / علاجي نفسي (متعلق بالعلاج النفسي أو ممارسته)\nمثال: جلسات العلاج النفسي",
 "psychotherapeutics": "الصحة النفسية, علاج نفسي (فرع الطب النفسي المعني بالطرق النفسية)",
 "psychotherapist": "معالج نفسي (معالج يتعامل مع الاضطرابات العقلية والعاطفية)",
 "psychotherapy": "علاج نفسي (علاج المشاكل العقلية أو العاطفية بوسائل نفسية) / الصحة النفسية, علاج نفسي (فرع الطب النفسي المعني بالطرق النفسية)",
 "psychotherapy group": "مَجْمُوعَة عِلَاج نَفْسِيّ (اجتماع لأشخاص لأغراض العلاج النفسي)",
 "psychotic": "ذُهَانِيّ (يتّسم بسمات الذُّهان أو مصاب به) / مَذْهُول, مُصاب بِذُهان (شخص مصاب بالذهان)",
 "psychotic belief": "اعتقاد ذهاني, ضلالة ((علم النفس) اعتقاد خاطئ يتم التمسك به في مواجهة أدلة تثبت عكس ذلك)",
 "psychotic depression": "اكتئاب ذهاني (حالة اكتئاب شديدة لدرجة أن الشخص يفقد الاتصال بالواقع ويعاني من مجموعة متنوعة من الاختلالات الوظيفية)",
 "psychotic person": "مَذْهُول, مُصاب بِذُهان (شخص مصاب بالذهان)",
 "psychotria capensis": "خشب الليمون, سيكوتريا كابينسيس (شجرة دائمة الخضرة من جنوب إفريقيا ذات خشب صلب قوي)",
 "psychotropic": "مؤثر عقلي, منشط نفسي (يؤثر على العقل أو المزاج أو العمليات العقلية الأخرى)\nمثال: أدوية مؤثرة عقلياً",
 "psychotropic agent": "عامل مؤثر عقلياً (مادة كيميائية يمكن أن تؤثر على الوعي البشري)",
 "psychrometer": "سيكرومتر, مقياس الرطوبة النفسي (مقياس رطوبة يتكون من مقياس حرارة جاف البصلة ومقياس حرارة رطب البصلة؛ يشير الفرق بينهما إلى جفاف الهواء المحيط)",
 "psychrometrics": "سايكرومتري",
 "psylla": "قمل النبات القافز (حشرة صغيرة نشطة تشبه الزيز لها أرجل خلفية متكيفة للقفز؛ تتغذى على عصارة النبات)",
 "psyllid": "بْسِيلَّا",
 "psyllium": "بَزَرْقَطُونَا, أَسْفِيُوس",
 "psyop": "عملية نفسية (إجراءات عسكرية مصممة للتأثير على تصورات ومواقف الأفراد والجماعات والحكومات الأجنبية)",
 "psytrance": "ترانس مخدر, ساي ترانس",
 "pt": "بلاتين, بلاتينوم (عنصر فلزي ثمين ثقيل؛ رمادي أبيض ومقاوم للتآكل)",
 "pt boat": "قارب طوربيد للدوريات (قارب طوربيد صغير سريع غير مدرع ومسلح تسليحاً خفيفاً)",
 "ptah": "بتاح",
 "ptarmigan": "ترمجان (طيهوج كبير من القطب الشمالي وشبه القطبي ذو أقدام مكسوة بالريش وريش شتوي أبيض عادة)",
 "pteretis struthiopteris": "رأس الكمان, سرخس النعامة (سرخس طويل من المناطق المعتدلة الشمالية له سعف مقوس رشيق وأبواغ تشبه ريش النعام)",
 "pteridium aquilinum": "براكن, سرخس النسر (سرخس خشن كبير غالباً بارتفاع عدة أقدام؛ سراخس ضارة أساساً؛ عالمي الانتشار)",
 "pteridium esculentum": "براكن (سرخس من جنوب شرق آسيا؛ غير مقاوم للبرد في المناطق المعتدلة الباردة)",
 "pteridological": "سراخسي (مكون من أو متعلق بدراسة السراخس (علم السراخس))",
 "pteridologist": "عالم سراخس (خبير في دراسة السراخس)",
 "pteridology": "علم السراخس (فرع علم النبات الذي يدرس السراخس)",
 "pteridophyte": "نبات تريدي, نبات وعائي لا زهري (نباتات تحتوي على أنسجة وعائية وتتكاثر عن طريق الأبواغ)",
 "pteridosperm": "سرخس بذي (نبات منقرض شبيه بالسرخس ومنتج للبذور من رتبة السرخسيات البذرية)",
 "pterion": "جُنَيْحَى",
 "pteris cretica": "تيريس كريتيكا (تزرع في العديد من الأصناف كنباتات منزلية)",
 "pteris multifida": "تيريس متعدد, سرخس العنكبوت (سرخس آسيوي تم إدخاله إلى أمريكا)",
 "pteris serrulata": "سرخس الشريط, سرخس العنكبوت (سرخس من شمال إفريقيا وجزر الأزور وجزر الكناري)",
 "pternohyla fodiens": "ضفدع الشجر الحفار (ضفدع ليلي حفار أرضي من التضاريس العشبية وغابات الشجيرات له سطح علوي صلب جداً للرأس؛ من جنوب غرب الولايات المتحدة)",
 "pterocarpus angolensis": "بتيروكاربوس أنغولنسيس, شجرة دم الأخوين (شجرة نفضية من جنوب إفريقيا ذات أوراق ريشية فردية كبيرة وزهور برتقالية صفراء عطرة غزيرة؛ تنتج عصارة حمراء وخشباً ثقيلاً قوياً ومتيناً)",
 "pterocarpus indicus": "أمبوينا, بادوك (شجرة موطنها جنوب شرق آسيا ذات خشب محمر ذو عروق سوداء مرقشة أو مخططة)",
 "pterocarpus macrocarpus": "بادوك بورما, خشب الورد البورمي (شجرة من الهند وبورما تنتج خشباً يشبه الماهوجني)",
 "pterocarpus marsupium": "بتيروكاربوس مارسوبيوم, كينو (شجرة من جزر الهند الشرقية تنتج راتنجاً أو مستخلصاً يستخدم غالباً طبياً وفي الدباغة)",
 "pterocarpus santalinus": "بتيروكاربوس سانتالينوس, خشب الصندل الأحمر (شجرة من الهند وجزر الهند الشرقية تنتج خشباً عطرياً صلباً ثميناً للأثاث وقلب خشب أحمر داكن يستخدم كخشب صباغة)",
 "pterocarya fraxinifolia": "جوز قوقازي (شجرة قوقازية متوسطة الحجم كثيرة التفرع تتميز عن أشجار الجوز الأخرى بفاكهتها المجنحة)",
 "pterocles alchata": "قطا دبوسي الذيل, قطا عراقي (قطا من أوروبا وأفريقيا ذو ريش ذيل أوسط طويل)",
 "pterocles indicus": "قطا ملون (قطا من الهند)",
 "pterocnemia pennata": "ريا صغيرة (الأصغر من طائرين طويلين سريعي الجري لا يطيران يشبهان النعام ولكنهما بثلاثة أصابع؛ يوجد من بيرو إلى مضيق ماجلان)",
 "pterodactyl": "إصبعي الجناح, تيروداكتيل (زاحف طائر منقرض)",
 "pteropogon": "بتيروبوغون (نبات جنوب أسترالي له شعيرات ريشية تحيط بالثمرة)",
 "pteropogon humboltianum": "بتيروبوغون (نبات جنوب أسترالي له شعيرات ريشية تحيط بالثمرة)",
 "pteropus capestratus": "خفاش الفاكهة المقنع (نوع من خفافيش الفاكهة)",
 "pteropus hypomelanus": "ثعلب طائر صغير (نوع من الخفافيش آكلة الفاكهة، يُعرف بالثعلب الطائر الصغير أو ثعلب الجزر الطائر)",
 "pterosaur": "تيروصور, زاحف مجنح (زاحف منقرض من العصر الجوراسي والطباشيري له منقار يشبه الطيور وأجنحة غشائية مدعومة بالإصبع الرابع الطويل جداً لكل طرف أمامي)",
 "pterospermum acerifolium": "تيروسبيرموم, ماينج (شجرة هندية ذات أزهار بيضاء ليلية عطرة وتنتج خشباً محمراً يستخدم للألواح؛ تزرع غالباً كزينة أو شجرة ظل)",
 "pteroylglutamic acid": "حمض الفوليك, فولات (فيتامين ب ضروري لنمو الخلايا والتكاثر)",
 "pteroylmonoglutamic acid": "حمض الفوليك, فولات (فيتامين ب ضروري لنمو الخلايا والتكاثر)",
 "pterygium": "ظُفْرَة",
 "pterygoid muscle": "عضلة جناحية (عضلة تنحدر من العظم الوتدي إلى الفك السفلي)",
 "pterygoid plexus": "ضفيرة جناحية (ضفيرة من الأوردة تصرف منطقة العضلات الجناحية وتصب في الأوردة الفكية الداخلية والوجهية الأمامية)",
 "pterygoid process": "نتوء جناحي (نتوءان عظميان ينحدران من جسم العظم الوتدي)",
 "pterygote": "جَنَاحِيَّة",
 "pthirus pubis": "قملة العانة (قملة تغزو منطقة العانة في جسم الإنسان)",
 "ptilonorhynchus violaceus": "طائر التعريشة الساتاني (من جنوب شرق أستراليا؛ الذكر أزرق بنفسجي لامع؛ الأنثى رمادية خضراء فاتحة)",
 "ptiloris paradisea": "طائر البندقية (طائر الجنة الأسترالي أسود مخملي مع تقزح لوني أخضر وأرجواني على الرأس والذيل)",
 "pto": "عمود نقل الحركة, مأخذ طاقة (جهاز ينقل الطاقة من محرك (كما في الجرار أو المركبات الآلية الأخرى) إلى قطعة أخرى من المعدات (مثل مضخة أو مطرقة ثقب))",
 "ptolemaic": "بَطْلَمِيّ (متعلق بنظام بطليموس الفلكي الذي يتخذ الأرض مركزاً) / بطلمي (من أو يتعلق بالفلكي بطليموس)",
 "ptolemaic dynasty": "السلالة البطلمية, بطالمة (سلالة قديمة من الملوك المقدونيين حكمت مصر من 323 قبل الميلاد إلى 30 قبل الميلاد؛ أسسها بطليموس الأول وانتهت بكليوباترا)",
 "ptolemaic system": "النظام البطلمي ((فلك) نموذج بطليموس للكون مع وجود الأرض في المركز)",
 "ptolemy": "بَطُلِيمُوس",
 "ptomain": "توماين (أي من الأمينات المختلفة (مثل البوترسين أو الكادافيرين) التي تتكون بفعل البكتيريا المتعفنة)",
 "ptomaine": "تسمم بتوماين (مصطلح للتسمم الغذائي لم يعد مستخدماً علمياً) / توماين (أي من الأمينات المختلفة (مثل البوترسين أو الكادافيرين) التي تتكون بفعل البكتيريا المتعفنة)",
 "ptomaine poisoning": "تسمم بتوماين (مصطلح للتسمم الغذائي لم يعد مستخدماً علمياً)",
 "ptosis": "تدلي الجفن (تدلي الجفن العلوي بسبب شلل وضعف العضلات)",
 "ptsd": "اضطراب ما بعد الصدمة (اضطراب قلق مرتبط بأحداث صادمة خطيرة ويتميز بأعراض مثل شعور الناجي بالذنب، أو إعادة عيش الصدمة في الأحلام، أو الخدر ونقص الانخراط في الواقع، أو…)",
 "ptui": "اتفو",
 "ptyalin": "بتيالين (أميلاز يفرز في اللعاب)",
 "ptyalism": "سيلان اللعاب, فرط الإلعاب (تدفق مفرط للعاب)",
 "ptyalith": "حَصَاة لُعَابِيَّة (حصاة في غدة لعابية)",
 "ptyas mucosus": "ثعبان الجرذ الهندي (يدخل المباني سعياً وراء الفريسة)",
 "ptychozoon homalocephalum": "وزغة طائرة (وزغة لها تمددات غشائية على جانبي جسمها وأطرافها وذيلها تمكنها من الانزلاق لمسافات قصيرة)",
 "pu": "بلوتونيوم (عنصر فلزي صلب رمادي فضي مشع ما بعد اليورانيوم يمكن شطر ذراته عند قصفها بالنيوترونات) / بولي يوريثان (أي من البوليمرات المختلفة التي تحتوي على شق اليوريثان؛ تُصنع منه مجموعة متنوعة من الأشكال الاصطناعية وتستخدم كمواد لاصقة أو بلاستيك أو طلاء أو مطاط)",
 "pub": "حَانَة, خَانَة",
 "pub crawl": "جولة حانات (جولة في الحانات (عادة مع تناول مشروب في كل محطة))",
 "pubertal": "بلوغي (مكون من أو متعلق بالبلوغ)",
