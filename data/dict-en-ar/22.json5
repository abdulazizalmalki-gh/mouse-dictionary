 "punny": "تلاعب لفظي, مرح لفظياً (يثير الضحك عن طريق التلاعب بالألفاظ)",
 "punster": "صاحب تورية, متلاعب بالألفاظ (شخص مولع جداً بصياغة التورية والتلاعب اللفظي)",
 "punt": "ركلة بانت, ركلة تشتيت ((كرة القدم الأمريكية) ركلة يتم فيها إسقاط الكرة من اليدين وركلها قبل أن تلمس الأرض) / قارب مسطح القاع (قارب مفتوح مسطح القاع يستخدم في المياه الضحلة ويدفع بعمود طويل) / بونت, جنيه (سابقاً وحدة المال الأساسية في أيرلندا؛ تساوي 100 بنس)\nمثال: سافرت ركلة التشتيت 50 ياردة",
 "punter": "مُراهن (شخص يقوم بالرهان) / راكل الإبعاد ((في كرة القدم الأمريكية) شخص يركل الكرة بإسقاطها من يديه وضربها بالقدم قبل أن تلمس الأرض) / دافع القارب بالعمود (شخص يدفع القارب باستخدام عمود)",
 "punting": "ركلة بانت, ركلة تشتيت ((كرة القدم الأمريكية) ركلة يتم فيها إسقاط الكرة من اليدين وركلها قبل أن تلمس الأرض)\nمثال: سافرت ركلة التشتيت 50 ياردة",
 "puntland": "أرض البنط (الكَوْكَب الذي نعيش عليه. لا جمع له؛ البَرّ، ضد البَحْر. يجمع على أرضون)\nمثال: أرض الله واسعة.",
 "puny": "ضَامِر, نَحِيل ((يُستخدم خاصة للأشخاص) صغير الحجم أو ضعيف البنية) / ضَئِيل, نَحِيل (أقل شأنًا في القوة أو الأهمية)",
 "pup": "جَرْو, غَلْو (الصَغير من كل نَبَات أو حَيَوَان؛ الصغير من الثَمَر كالبَطِّيخ والرُمَّان وغيره)\nمثال: كان الجرو يلحس خدها.",
 "pup tent": "خيمة صغيرة (خيمة على شكل وتد؛ عادة بدون أرضية أو نوافذ)",
 "pupa": "خَادِرَة, شَرْنَقَة",
 "pupal": "شَرْنَقِيّ, عَذْرَائِيّ (يتعلق بالحشرات في مرحلة الشرنقة أو ما بعد اليرقة)",
 "pupil": "تِلْمِيذ, تِلْمِيذَة / حَدَقَة, بُؤْبُؤ",
 "pupillary": "حدقي (مكون من أو متعلق بحدقة العين)",
 "pupillary reflex": "تقبض الحدقة, منعكس الضوء (انكماش انعكاسي للعضلة العاصرة للقزحية استجابة لضوء ساطع (أو أدوية معينة) مما يسبب صغر حجم الحدقة)",
 "pupillary sphincter": "مصرة الحدقة (حلقة من العضلات الملساء تحيط بالقزحية)",
 "puppet": "دُمْيَة",
 "puppet government": "حكومة دمية, حكومة صورية (حكومة يتم تعيينها وتوجيه شؤونها من قبل سلطة خارجية قد تفرض صعوبات على المحكومين)",
 "puppet leader": "حاكم دمية, حاكم صوري (زعيم أو حاكم يختاره مستبد لرئاسة حكومة)",
 "puppet play": "عرض دمى, مسرح عرائس (عرض يكون فيه الممثلون عبارة عن دمى)",
 "puppet regime": "حكومة دمية, حكومة صورية (حكومة يتم تعيينها وتوجيه شؤونها من قبل سلطة خارجية قد تفرض صعوبات على المحكومين)",
 "puppet ruler": "حاكم دمية, حاكم صوري (زعيم أو حاكم يختاره مستبد لرئاسة حكومة)",
 "puppet show": "عرض دمى, مسرح عرائس (عرض يكون فيه الممثلون عبارة عن دمى)",
 "puppet state": "حكومة دمية, حكومة صورية (حكومة يتم تعيينها وتوجيه شؤونها من قبل سلطة خارجية قد تفرض صعوبات على المحكومين)",
 "puppeteer": "محرك الدمى (شخص يحرك الدمى أو الماريونيت)",
 "puppetry": "فن الدمى (أداء درامي متكلف (كما لو كان بواسطة دمى)) / تحريك الدمى, فن الدمى (فن صنع الدمى وتقديم عروض الدمى)",
 "puppy": "جَرْو (الصَغير من كل نَبَات أو حَيَوَان؛ الصغير من الثَمَر كالبَطِّيخ والرُمَّان وغيره)\nمثال: كان الجرو يلحس خدها.",
 "puppy fat": "سمنة الطفولة, شحم الطفولة (دهون على جسم الرضيع أو الطفل؛ تختفي عند المراهقة)",
 "puppy love": "إعجاب عابر, حب المراهقة (حب مؤقت لمراهق)",
 "puppyish": "جَرْوِيّ (من خصائص الجرو وسماته)",
 "puppylike": "جَرْوِيّ (من خصائص الجرو وسماته)",
 "pur": "بولي يوريثان (أي من البوليمرات المختلفة التي تحتوي على شق اليوريثان؛ تُصنع منه مجموعة متنوعة من الأشكال الاصطناعية وتستخدم كمواد لاصقة أو بلاستيك أو طلاء أو مطاط)",
 "purana": "بورانا (مجموعة من 18 عملاً كتبت بين القرنين الأول والحادي عشر وتتضمن أساطير وتواريخ تأملية للكون)",
 "puranic": "بوراني (مكون من أو متعلق بالبورانا (نصوص هندوسية))",
 "purau": "ماجاجوا, ماهو (شجرة شجيرية واسعة الانتشار على طول الشواطئ الاستوائية؛ تنتج خشباً خفيفاً متيناً يستخدم لركائز الزوارق وأليافاً تستخدم للحبال والسد؛ تزرع غالباً للزينة)",
 "purblind": "بَلِيد, قَاصِر الإِدْرَاك (يَفْتَقِر إِلَى البَصِيرَة أَوِ الفِطْنَة) / شِبْه أَعْمَى, ضَعِيف البَصَر (ذو بصر ضعيف جدًّا)",
 "purchasable": "قَابِل لِلشِّرَاء, لِلبَيْع (متاح للشراء والبيع) / قَابِلٌ لِلإِفْسَاد, قَابِلٌ لِلرَّشْوَة (يُمْكِنُ إِفْسَادُهُ أَوْ رَشْوَتُه)",
 "purchase": "شِرَاء, اِشْتِرَاء / مُشْتَرًى, مُشْتَرَيَات / اِشْتَرَى (أَخَذَ الشيءَ بِثَمَن؛ اشترى الشخصَ (الحرّ) أو رضاه: أراد إرضائه ومحبته بغض النظر عن الكلفة)\nمثال: اشترى زيري ذلك.",
 "purchase agreement": "اتفاقية شراء, عقد شراء (عقد يحدد شروط الشراء)",
 "purchase contract": "اتفاقية شراء, عقد شراء (عقد يحدد شروط الشراء)",
 "purchase order": "أمر شراء, طلب شراء (وثيقة تجارية تستخدم لطلب توريد شيء ما من شخص مقابل الدفع وتوفر المواصفات والكميات)\nمثال: تلقت شركة آي بي إم طلباً لمائة حاسوب",
 "purchase price": "سعر الشراء (السعر الذي يتم شراء شيء ما به فعلياً)",
 "purchaser": "مبتاع, مُشتَرٍ (شخص يقوم بالشراء)",
 "purchasing": "تبضع, شراء (فعل الشراء)\nمثال: الشراء والبيع يملآن أيامهم",
 "purchasing agent": "وكيل مشتريات (وكيل يشتري السلع أو الخدمات لآخر)",
 "purchasing department": "قسم المشتريات (قسم في مؤسسة تجارية مسؤول عن عمليات الشراء)",
 "purchasing power": "قُدْرَة شِرائِيَّة",
 "purdah": "البردة, ستارة الحجب (ستار يستخدم في الهند لفصل النساء عن الرجال أو الغرباء) / بردة, عزل النساء (النظام التقليدي الهندوسي أو الإسلامي لإبقاء النساء معزولات) / عزلة اجتماعية (حالة من العزلة الاجتماعية)",
 "pure": "صَافٍ, اَلصَّافِي",
 "pure absence": "غيبة بسيطة (نوبة غياب دون مضاعفات أخرى؛ تليها ذروات موجات دماغية بمعدل 3 في الثانية)",
 "pure binary numeration system": "النظام الثنائي, نظام العد الثنائي (نظام عد موضعي يستخدم أرقاماً ثنائية وأساساً هو الاثنان)",
 "pure gold": "ذهب خالص, ذهب عيار 24 (ذهب بنسبة 100 في المائة)",
 "pure iambic trimeter": "تريمتر إيامبي نقي (سطر إيامبي من ستة أقدام تكون فيه جميع المقاطع غير المؤكدة قصيرة ولا يُسمح بتحليل المقاطع الطويلة)",
 "pure imaginary number": "عَدَد تَخَيُّلِيّ بَحْت (مِقْدَار مَا يُعَدّ)\nمثال: كم عدد سكان الجزائر؟",
 "pure mathematics": "رياضيات بحتة (فروع الرياضيات التي تدرس وتطور مبادئ الرياضيات لذاتها بدلاً من فائدتها المباشرة)",
 "pure tone": "نغمة, نغمة نقية (صوت ثابت بدون نغمات توافقية)\nمثال: فحصوا سمعه بنغمات نقية ذات ترددات مختلفة",
 "pureblood": "أصيل, حيوان أصيل (حيوان ذو نسب من سلالة غير مختلطة؛ يستخدم خاصة للخيول) / أَصِيلُ السُّلَالَة, مُوَثَّقُ النَّسَب (لديه سجلّ أنساب يُثبت نقاء سلالته)",
 "pureblooded": "أَصِيلُ السُّلَالَة, مُوَثَّقُ النَّسَب (لديه سجلّ أنساب يُثبت نقاء سلالته)",
 "purebred": "أصيل, حيوان أصيل (حيوان ذو نسب من سلالة غير مختلطة؛ يستخدم خاصة للخيول) / أصيل, صافي السلالة (تمت تربيته لعدة أجيال من أفراد سلالة أو عرق معترف به)",
 "puree": "هريس (اسم مفعول من هَرَسَ، وهو المدقوق دقا عنيفا حتى تفتت؛ اسم: طعام مصنوع من القَمْح المدقوق بقوة مخلوطا باللحم)",
 "purely": "بحتة, بشكل صارم (مقتصر على شيء ما)\nمثال: تحدثنا في العمل فقط (بشكل صارم)",
 "pureness": "شرف, عفة (فضيلة المرأة أو عفتها) / براءة, طهارة (حالة الخلو من الخطيئة أو الخطأ الأخلاقي؛ الافتقار إلى معرفة الشر) / صفاء, نقاء (كون الشيء غير مخفف أو غير مخلوط بمواد غريبة)",
 "purgation": "تبرئة, تطهير (فعل تبرئة نفسك (أو شخص آخر) من وصمة عار أو تهمة) / تطهير, تنقية (تطهير احتفالي من النجاسة عن طريق أداء طقوس مناسبة) / تسهيل, تطهير الأمعاء (تطهير الجسم باستخدام مسهل لتحفيز إفراغ الأمعاء)",
 "purgative": "مُسْهِلٌ قَوِيّ, مُنَقٍّ (شديد التأثير المُسْهِل) / مسهل, ملين قوي (دواء مسهل؛ يحفز إخلاء الأمعاء)",
 "purgatorial": "مطهري (من أو يشبه المطهر) / تطهيري, تكفيري (يخدم في التطهير أو التخلص من الخطيئة)\nمثال: نيران المطهر",
 "purgatory": "مَطْهَر",
 "purge": "تطهير (إزالة مفاجئة لشخص أو مجموعة من منظمة أو مكان) / تطهير, تنقية (فعل الإزالة عن طريق التنظيف؛ التخلص من الرواسب أو العناصر الأخرى غير المرغوب فيها) / تبرئة, تطهير (فعل تبرئة نفسك (أو شخص آخر) من وصمة عار أو تهمة)\nمثال: مات في حملة تطهير قام بها ستالين",
 "purging": "تطهير, تنقية (فعل الإزالة عن طريق التنظيف؛ التخلص من الرواسب أو العناصر الأخرى غير المرغوب فيها) / تبرئة, تطهير (فعل تبرئة نفسك (أو شخص آخر) من وصمة عار أو تهمة) / تطهيري, تكفيري (يخدم في التطهير أو التخلص من الخطيئة)\nمثال: طقوس تطهيرية",
 "purging cassia": "خيار شمبر, شجرة المطر الذهبي (شجرة متساقطة الأوراق أو شبه دائمة الخضرة لها زهور بنية داكنة إلى صفراء معطرة في عناقيد متدلية وقرون يستخدم لبها طبياً؛ آسيا الاستوائية ووسط وجنوب…)",
 "purification": "تَطْهِير (إِزالة التَلَوُّث؛ تَنْقية النَّفْس من الدَّنس)\nمثال: مهمتها هي متابعة أداء محطات التطهير.",
 "purificator": "مطهّر, منديل التطهير (قماش كتاني أبيض يستخدم لمسح الكأس بعد تناول كل متناول للقربان)",
 "purificatorium": "مطهّر, منديل التطهير (قماش كتاني أبيض يستخدم لمسح الكأس بعد تناول كل متناول للقربان)",
 "purifier": "جهاز تنقية, منقٍّ (جهاز لإزالة الشوائب)",
 "purify": "صَفَّى",
 "purifying": "مُطَهِّر, مُنَقٍّ (يعمل كمضادّ للعدوى؛ ذو أثر تطهيريّ) / مطهر, منق (يحرر من المواد الضارة) / تطهيري, تكفيري (يخدم في التطهير أو التخلص من الخطيئة)\nمثال: الترشيح عامل منقٍ",
 "purim": "عِيد الْمَسَاخِر, عِيد السُّكَّر",
 "purine": "بيورين (قاعدة عضوية بلورية عديمة اللون تحتوي على النيتروجين؛ وهي المركب الأصلي للعديد من المواد المهمة بيولوجياً) / بيورين (أي من القواعد المتعددة التي تعتبر مشتقات للبيورين)",
 "purinethol": "بيورينثول, مركابتوبورين (دواء (الاسم التجاري بيورينثول) يتداخل مع استقلاب البيورين ويستخدم لعلاج سرطان الدم الليمفاوي الحاد)",
 "purism": "نِقَائِيَة",
 "purist": "صفائي, متشدد في القواعد (شخص يصر على الدقة الكبيرة والصحة (خاصة في استخدام الكلمات))",
 "puritan": "متزمت (شخص يهتم بشكل مفرط باللياقة والأعراف) / بيوريتاني, متزمت (شخص يلتزم بمبادئ دينية صارمة؛ شخص يعارض الملذات الحسية) / بيوريتاني, تطهيري (عضو في مجموعة من البروتستانت الإنجليز في القرنين السادس عشر والسابع عشر اعتقدوا أن الإصلاح البروتستانتي في عهد إليزابيث كان غير مكتمل ودعوا لتبسيط…)",
 "puritanic": "بُورِيتَانِيّ, مُتَزَمِّت (صارم ومُتشدّد أخلاقيًّا)",
 "puritanical": "بُورِيتَانِيّ, مُتَزَمِّت (صارم ومُتشدّد أخلاقيًّا) / مُتَحَفِّظ بِإِفْرَاط, مُتَزَمِّت (مبالِغ في التمسّك باللياقة والتحفّظ) / بيورتاني, تطهري (من أو متعلق بالتطهرية (البيوريتانية) أو المتطهرين)",
 "puritanically": "بتحفظ مفرط, بتزمت (بطريقة متزمتة)\nمثال: تتصرف بتزمت، لكني أتساءل عما إذا كانت عفيفة حقاً إلى هذا الحد",
 "puritanism": "تزمت, تطهرية (صرامة وتقشف في السلوك والدين) / تطهيرية (المعتقدات والممارسات المميزة للمتطهرين (الذين كان معظمهم كالفينيين أرادوا تطهير كنيسة إنجلترا من جوانبها الكاثوليكية))",
 "purity": "شرف, عفة (فضيلة المرأة أو عفتها) / براءة, طهارة (حالة الخلو من الخطيئة أو الخطأ الأخلاقي؛ الافتقار إلى معرفة الشر) / صفاء, نقاء (كون الشيء غير مخفف أو غير مخلوط بمواد غريبة)",
 "purkinje cell": "خلية بركنجي (عصبون كبير كثيف التفرع يعتبر الخلية المميزة لقشرة المخيخ)",
 "purkinje fiber": "ألياف بركنجي (ليف عضلي قلبي متخصص يشكل جزءاً من شبكة بركنجي)",
 "purkinje network": "شبكة بركنجي (شبكة من ألياف بركنجي تحمل النبض القلبي من العقدة الأذينية البطينية إلى بطيني القلب وتسبب انقباضهما)",
 "purkinje's system": "شبكة بركنجي (شبكة من ألياف بركنجي تحمل النبض القلبي من العقدة الأذينية البطينية إلى بطيني القلب وتسبب انقباضهما)",
 "purkinje's tissue": "شبكة بركنجي (شبكة من ألياف بركنجي تحمل النبض القلبي من العقدة الأذينية البطينية إلى بطيني القلب وتسبب انقباضهما)",
 "purl": "غرزة مقلوبة (غرزة حياكة أساسية مصنوعة بوضع الإبرة عبر الجزء الأمامي من الغرزة من الجانب الأيمن) / خيط مقصب, سلك ذهبي أو فضي (خيط سلكي من الذهب أو الفضة)",
 "purl stitch": "غرزة مقلوبة (غرزة حياكة أساسية مصنوعة بوضع الإبرة عبر الجزء الأمامي من الغرزة من الجانب الأيمن)",
 "purlieu": "جوار, ضواحي (منطقة خارجية مجاورة لأي مكان)",
 "purloo": "بيرلو (يخنة كثيفة مصنوعة من الأرز والدجاج والصيد الصغير؛ جنوب الولايات المتحدة)",
 "purple": "بَنَفْسَجِيّ / أُرْجُوَانِيّ",
 "purple amaranth": "ريش الأمير, قطيفة أرجوانية (نبات حولي استوائي أمريكي طويل مبهرج ذو سيقان مشعرة وسنابل طويلة من الزهور الحمراء عادة فوق أوراق مشبعة باللون الأرجواني؛ غالباً ما تستخدم البذور كحبوب)",
 "purple anise": "يانسون أرجواني (شجرة شجيرية صغيرة بزهور أرجوانية؛ توجد في التربة الرطبة في جنوب شرق الولايات المتحدة)",
 "purple apricot": "مشمش أرجواني (مشمش هجين صغير من آسيا وآسيا الصغرى له غصينات أرجوانية وزهور بيضاء تليها فاكهة أرجوانية رديئة)",
 "purple avens": "أفينس أرجواني, أفينس مائي (نبات معمر منتصب من المنطقة المعتدلة الشمالية له أوراق ريشية وعدد قليل من الزهور المتدلية بكأس بني أرجواني وبتلات برتقالية ووردية) / أفينس أرجواني, دخان البراري (نبات معمر من أمريكا الشمالية بأوراق ريشية قاعدية زغبية وزهور أرجوانية وثمار ذات ريش)",
 "purple bacteria": "بكتيريا أرجوانية (بكتيريا حرة المعيشة سالبة الجرام ذات لون وردي إلى بني أرجواني تحتوي على كلوروفيل بكتيري)",
 "purple beech": "زان أرجواني, زان نحاسي (صنف من الزان الأوروبي بأوراق أرجوانية لامعة أو نحاسية اللون)",
 "purple boneset": "جو باي الأرجواني, غافث أرجواني (عشب من أمريكا الشمالية له أوراق محيطية وعناقيد طرفية من الزهور المرقطة بالأرجواني)",
 "purple chinese houses": "المنازل الصينية الأرجوانية, كولينسيا ثنائية اللون (أزهار بيضاء وخزامية إلى زرقاء شاحبة تنمو في حلقات مثالية من شرائط متباعدة على نطاق واسع حول السيقان تشكل نوعاً من الباغودا؛ كاليفورنيا)",
 "purple clematis": "ياسمين بري أرجواني, ياسمين بري جبلي (نبات متسلق من شمال شرق أمريكا الشمالية ذو أزهار أرجوانية زرقاء شمعية)",
 "purple clover": "نفل المروج, نفل بنفسجي (نبات معمر قصير العمر، منتصب إلى منبطح، ذو أزهار حمراء أرجوانية إلى وردية؛ أكثر أنواع نفل العلف زراعة)",
 "purple cress": "حرف دوغلاس, رشاد أرجواني (عشبة معمرة صغيرة في المناطق الباردة من أمريكا الشمالية بزهور أرجوانية عنقودية)",
 "purple emperor": "إمبراطور أرجواني (فراشة أوروبية كبيرة يتميز الذكر منها بأجنحة مظللة بالأرجواني)",
 "purple finch": "عصفور أرجواني (عصفور من أمريكا الشمالية له رأس وصدر وردي محمر)",
 "purple fringeless orchid": "سحلب أرجواني غير مهدب (سحلب من شمال شرق وشرق أمريكا الشمالية الألبي وثيق الصلة بالسحلب الأرجواني المهدب ولكن له زهور وردية أرجوانية أو بنفسجية بتقسيمات أوراق مسننة)",
 "purple fringeless orchis": "سحلب أرجواني غير مهدب (سحلب من شمال شرق وشرق أمريكا الشمالية الألبي وثيق الصلة بالسحلب الأرجواني المهدب ولكن له زهور وردية أرجوانية أو بنفسجية بتقسيمات أوراق مسننة)",
 "purple gallinule": "دجاجة الماء الأرجوانية (دجاجة ماء ذات ريش أرجواني مبهرج)",
 "purple grackle": "سوادية أرجوانية (سوادية تعيش في شرق الولايات المتحدة)",
 "purple granadillo": "باشن فروت, غرانديلا (زهرة العاطفة البرازيلية تزرع لثمارها الأرجوانية الداكنة)",
 "purple ground cherry": "حرنكش, عنب الثعلب البيروفي (نبات حولي من أمريكا الجنوبية الاستوائية له ثمار أرجوانية صالحة للأكل) / توماتيلو, ميلتومات (نبات حولي مكسيكي تم توطينه في شرق أمريكا الشمالية له ثمار صفراء إلى أرجوانية صالحة للأكل تشبه الطماطم الصغيرة)",
 "purple heart": "ثيوبنتال الصوديوم, فينوباربيتال (باربيتورات طويل المفعول يستخدم كمهدئ) / وسام القلب الأرجواني (وسام عسكري أمريكي يمنح لأي عضو في القوات المسلحة يُجرح في المعركة)",
 "purple heather": "خلنج أرجواني (عشب شبه منبطح دائم الخضرة من غرب الولايات المتحدة)",
 "purple loco": "أوكسيتروبيس, عشبة اللوكو الأرجوانية (عشبة متكتلة من جنوب غرب الولايات المتحدة لها زهور أرجوانية أو وردية إلى بيضاء)",
 "purple locoweed": "أوكسيتروبيس, عشبة اللوكو الأرجوانية (عشبة متكتلة من جنوب غرب الولايات المتحدة لها زهور أرجوانية أو وردية إلى بيضاء)",
 "purple loosestrife": "حناء دجال, ليثروم صفصافي (عشب مستنقعات ذو سنبلة طويلة من الزهور الأرجوانية؛ أصله من أوروبا ولكنه ينتشر الآن بكثرة في شرق الولايات المتحدة)",
 "purple martin": "سنونو أرجواني (سنونو كبير من أمريكا الشمالية يتميز الذكر منه بلون أزرق مسود)",
 "purple milk vetch": "قتاد أرجواني (نبات معمر من جنوب وغرب أوروبا ذو عناقيد كثيفة من الزهور الأرجوانية أو البنفسجية)",
 "purple mullein": "بوصير أرجواني (بوصير أوراسي بزهور أرجوانية أو وردية بارزة)",
 "purple nightshade": "باذنجان بري, مغد فضي الأوراق (نبات مغد ضار بأوراق فضية وزهور بنفسجية أو زرقاء أو بيضاء؛ تستخدم ثمرته المستديرة على نطاق واسع لتخثير الحليب؛ من وسط الولايات المتحدة إلى أمريكا…)",
 "purple onion": "بصل أحمر (بصل مسطح خفيف ذو قشور أرجوانية؛ يستخدم للزينة على الهامبرغر والسلطات)",
 "purple orchis": "سحلب استعراضي (سحلب من أمريكا الشمالية له سنبلة من الزهور البنفسجية الأرجوانية الممزوجة بالأبيض؛ السبلات والبتلات تشكل غطاء)",
 "purple osier": "صفصاف أحمر, صفصاف أرجواني (صفصاف أوراسي له غصينات محمرة أو أرجوانية ولحاء غني بالعفص)",
 "purple passage": "فقرة منمقة (مقطع مليء باللغة المنمقة والمزخرفة)",
 "purple pea": "بازلاء أرجوانية, هوفا (أي من الشجيرات دائمة الخضرة الجذابة المتعددة في أستراليا، تزرع لأوراقها الخضراء الداكنة اللامعة وزهورها ذات اللون الأزرق الغني والبنفسجي المكثف)",
 "purple poppy mallow": "ختمية الخشخاش الأرجوانية (نبات معمر مشعر في وسط الولايات المتحدة ذو أوراق مستديرة مفصصة بعمق وعناقيد فضفاضة من الزهور القرمزية الأرجوانية أو الحمراء الكرزية الكبيرة)",
 "purple rock brake": "سرخس الجرف الأرجواني (سرخس أمريكي شمالي زاحف ضحل قصير جداً ينمو عادة على المنحدرات أو الجدران وله محاور أوراق لامعة داكنة)",
 "purple sage": "ميرمية أرجوانية, ميرمية الشابارال (عشب كاليفورني ذو أوراق فضية وزهور أرجوانية)",
 "purple sanicle": "سانيكولا أرجوانية (سانيكولا في شمال غرب الولايات المتحدة وكولومبيا البريطانية لها زهور صفراء أو حمراء أو أرجوانية)",
 "purple saxifrage": "كاسر الحجر الأرجواني (نباتات تشكل وسائد كثيفة بزهور أرجوانية محمرة زاهية؛ المناطق الصخرية في أوروبا وآسيا وغرب أمريكا الشمالية)",
 "purple silkweed": "صقلاب أرجواني, عشبة الحرير الأرجوانية (نبات معمر من شرق أمريكا الشمالية له زهور وردية أرجوانية)",
 "purple strawberry guava": "جوافة الفراولة الأرجوانية, جوافة كاتلي (شجرة شجيرية استوائية صغيرة تحمل ثماراً بيضاوية حمراء داكنة)",
 "purple trillium": "تريليوم أحمر, تريليوم أرجواني (تريليوم من شرق أمريكا الشمالية له زهور وردية إلى أرجوانية كريهة الرائحة وجذر قابض يستخدم في الطب الشعبي خاصة لتسهيل الولادة)",
 "purple velvet plant": "جينورا برتقالية, نبات المخمل (نبات ورقي جاوي يُزرع لأوراقه المخملية الجميلة ذات الشعيرات البنفسجية الأرجوانية)",
 "purple virgin's bower": "ياسمين بري أرجواني, ياسمين بري جبلي (نبات متسلق من شمال شرق أمريكا الشمالية ذو أزهار أرجوانية زرقاء شمعية)",
 "purple willow": "صفصاف أحمر, صفصاف أرجواني (صفصاف أوراسي له غصينات محمرة أو أرجوانية ولحاء غني بالعفص)",
 "purple-black": "أَسْوَد أُرْجُوَانِيّ (أسود مع مسحة أرجوانية)",
 "purple-blue": "أَزْرَق أُرْجُوَانِيّ (أزرق مع مسحة أرجوانية)",
 "purple-brown": "بُنِّيّ أُرْجُوَانِيّ (بني مع مسحة أرجوانية)",
 "purple-eyed": "بَنَفْسَجِيّ العَيْن ((عن الأزهار) ذو علامة تشبه العين بلون بنفسجي)",
 "purple-flowered": "بَنَفْسَجِيّ الأَزْهَار (ذو أزهار بنفسجيّة اللون)",
 "purple-flowering raspberry": "توت العليق المزهر (توت شوكي شجيري من شرق أمريكا الشمالية له زهور وردية إلى أرجوانية ملفتة للنظر وفاكهة حمراء أو برتقالية على شكل كشتبان)",
 "purple-fringed orchid": "سحلب أرجواني مهدب / سحلب أرجواني مهدب صغير (سحلب من أمريكا الشمالية بعناقيد من الزهور الأرجوانية المهدبة العطرة)",
 "purple-fringed orchis": "سحلب أرجواني مهدب / سحلب أرجواني مهدب صغير (سحلب من أمريكا الشمالية بعناقيد من الزهور الأرجوانية المهدبة العطرة)",
 "purple-green": "أَخْضَر أُرْجُوَانِيّ (أخضر مع مسحة أرجوانية)",
 "purple-hooded orchis": "سحلب استعراضي (سحلب من أمريكا الشمالية له سنبلة من الزهور البنفسجية الأرجوانية الممزوجة بالأبيض؛ السبلات والبتلات تشكل غطاء)",
 "purple-lilac": "لَيْلَكِيّ أُرْجُوَانِيّ (خزامي مع مسحة أرجوانية)",
 "purple-red": "أَحْمَر أُرْجُوَانِيّ (أحمر مع مسحة أرجوانية)",
 "purple-spotted": "ذُو بُقَع بَنَفْسَجِيَّة (عليه بقع بنفسجيّة اللون)",
 "purple-staining cortinarius": "كورتيناريوس متغير (فطر بقبعة أرجوانية محمرة ذات سطح أملس لزج؛ خياشيم بنفسجية متقاربة؛ تصبغ جميع الأجزاء باللون الأرجواني الداكن عند الكدمات)",
 "purple-stemmed aster": "أستر أرجواني الساق",
 "purple-tinged": "مَصْبُوغ بِالأُرْجُوَانِيّ (بلون ممزوج بمسحة أرجوانية)",
 "purple-tinted": "مَصْبُوغ بِالأُرْجُوَانِيّ (بلون ممزوج بمسحة أرجوانية)",
 "purple-veined": "ذُو عُرُوق بَنَفْسَجِيَّة ((في الأزهار) ذو علامات بنفسجيّة تُشبه العروق)",
 "purple-white": "أَبْيَض أُرْجُوَانِيّ (أبيض مع مسحة أرجوانية)",
 "purpleness": "أرجواني, لون بنفسجي (لون بين الأحمر والأزرق)",
 "purplish": "أُرْجُوَانِيّ, بَنَفْسَجِيّ (بلون متوسط بين الأحمر والأزرق)",
 "purplish blue": "أزرق أرجواني, أزرق ملكي (درجة من الأزرق مشوبة بالأرجواني)",
 "purplish pink": "سولفرينو (صبغة وردية اكتشفت عام 1859)",
 "purplish red": "أحمر أرجواني (أحمر مع مسحة من الأرجواني)",
 "purplish-black": "أَسْوَد أُرْجُوَانِيّ (أسود مع مسحة أرجوانية)",
 "purplish-blue": "أَزْرَق أُرْجُوَانِيّ (أزرق مع مسحة أرجوانية)",
 "purplish-brown": "بُنِّيّ أُرْجُوَانِيّ (بني مع مسحة أرجوانية)",
 "purplish-green": "أَخْضَر أُرْجُوَانِيّ (أخضر مع مسحة أرجوانية)",
 "purplish-lilac": "لَيْلَكِيّ أُرْجُوَانِيّ (خزامي مع مسحة أرجوانية)",
 "purplish-red": "أَحْمَر أُرْجُوَانِيّ (أحمر مع مسحة أرجوانية) / أحمر أرجواني (أحمر مع مسحة من الأرجواني)",
 "purplish-white": "أَبْيَض أُرْجُوَانِيّ (أبيض مع مسحة أرجوانية)",
 "purport": "مرمى, مغزى (المعنى العام أو الفحوى السائد) / قَصْد, مَغْزًى (المعنى المقصود من التواصل)\nمثال: فهمت المغزى العام للمحادثة",
 "purportedly": "كما يُشاع, من المفترض (كما هو معتقد أو مشاع)",
 "purpose": "هَدَف, مَقْصِد (جاء إلى الهَدَف؛ ارتفع عن الأرض) / سَبَب ((سَبَّبَه): أَكثر سَبَّه؛ (سَبَّبَ) الأسبَاب: أوجدها)\nمثال: لقد أخطأ الهدف.",
 "purpose-built": "مُصَمَّم لِغَرَضٍ مُعَيَّن (صُمِّم وبُنِي لخدمة غرض محدّد)",
 "purpose-made": "مُصَمَّم لِغَرَضٍ مُعَيَّن (صُمِّم وبُنِي لخدمة غرض محدّد)",
 "purposeful": "هَادِف (ذو معنى من خلال وجود غاية) / ذو غرض, هادف (يخدم كـ أو يشير إلى وجود غرض أو هدف)",
 "purposefully": "بشكل هادف, بعزم (بطريقة هادفة)\nمثال: ضبط الدراجات النارية في الوهج الكامل لمصابيحه الأمامية، وفرمل وخرج بعزم من السيارة",
 "purposefulness": "ذات هدف, هادفة (صفة امتلاك غرض محدد)",
 "purposeless": "بلا هدف, عبثي (لا يظهر أي غرض أو هدف) / عَبَثِيّ, لَا طَائِلَ مِنْه (لَا يَخْدِمُ أَيَّ غَرَضٍ مُفِيد؛ لَا مُبَرِّرَ لِوُجُودِه)",
 "purposelessly": "بلا هدف (بدون غرض واضح)\nمثال: دعونا لا نوزع المساعدات بلا هدف",
 "purposelessness": "انعدام الهدف, عبثية (صفة الافتقار إلى أي غرض محدد)",
 "purposely": "بتعمد, عمداً (بنية؛ بطريقة متعمدة)\nمثال: استخدم تلك الكلمة عمداً",
 "purposive": "غَرَضِيّ, مُوَجَّه نَحْوَ الهَدَف (ذو غاية وهدف محدّد) / قَصْدِيّ, مَقْصُود (ذو غرض أو تصميم واضح أو يُظهِر ذلك)",
 "purpura": "فرفرية (أي من عدة أمراض دموية تسبب نزيفاً تحت الجلد)",
 "purpura hemorrhagica": "فرفرية قليلة الصفيحات (فرفرية مرتبطة بانخفاض في الصفائح الدموية الدائرة والتي يمكن أن تنتج عن مجموعة متنوعة من العوامل)",
 "purr": "خَرْخَرَ, هَرْهَرَ / خَرْخَرَة",
 "purse": "جِزْدَان, جُزْدَان",
 "purse seine": "شباك الجر الكيسية (شبكة مصممة ليتم وضعها بواسطة قاربين حول سرب من الأسماك ثم إغلاقها من الأسفل بواسطة حبل)",
 "purse string": "خيط صرة النقود (خيط زم يستخدم لإغلاق فوهة كيس النقود)",
 "purse strings": "خزينة, سلطة الإنفاق (الموارد المالية أو الدعم المالي)\nمثال: من يسيطر على الخزينة (الإنفاق) في هذه العائلة؟",
 "purse-proud": "مُتَبَاهٍ بِثَرْوَتِه (فخور أو متعجرف بسبب ثروته (خاصة في غياب مزايا أخرى))",
 "purse-string operation": "عملية تطويق عنق الرحم, عملية شيرودكار (إجراء جراحي يتم فيه استخدام خيط لإغلاق عنق الرحم لدى المرأة الحامل؛ يجرى عندما يفشل عنق الرحم في الاحتفاظ بالحمل السابق)",
 "purser": "المسؤول المالي للسفينة (ضابط على متن سفينة يحتفظ بالحسابات ويهتم برفاهية الركاب)",
 "purslane": "بقلة, رجلة (نبات من الفصيلة الرجلية له أوراق بيضاوية مقلوبة عصارية لحمية، غالباً ما يُزرع كبقلة أو عشب للسلطة؛ يعد عشباً ضاراً في بعض المناطق)",
 "purslane speedwell": "زهرة الحواشي الرجلة (نبات حولي من أمريكا الشمالية بزهور بيضاء صغيرة متوطن كعشبة ضارة في أمريكا الجنوبية وأوروبا)",
 "pursual": "مطارده, ملاحقة (فعل المطاردة في محاولة للحاق أو القبض على شخص)\nمثال: بدأ الجاني في الجري وانطلق الشرطي في مطاردته",
 "pursuance": "متابعة, مواصلة (استمرار شيء بدأ بهدف إتمامه) / بحث, سعي (بحث عن بديل يلبي معايير معرفية)\nمثال: السعي وراء الحب",
 "pursuant": "عَمَلاً بِ",
 "pursue": "لَاحَقَ / اِتَّبَعَ (تَكَلَّفَ وبذل الجُهْد في أن يَتْبَع)\nمثال: اتبع قلبك فحسب.",
 "pursued": "مطارد, ملاحق (متبع بعداء كما لو للإيذاء) / مُطارَد, مُلاحَق (شخص يتم تعقبه)\nمثال: تركض وتقفز مثل قطيع من الظباء المطاردة",
