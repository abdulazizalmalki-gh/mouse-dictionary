 "dwarf": "قَزَم / حَنْدَل, حِنْتَار / قَزَمِيّ",
 "dwarf astilbe": "أستيلب قزم (نبات آسيوي دائم الخضرة يشكل حصيرة بأوراق مقطوعة بدقة وزهور وردية صغيرة إلى بورجوندي؛ يزرع كغطاء أرضي)",
 "dwarf banana": "موز قزم (شجرة موز آسيوية منخفضة النمو تزرع خاصة في جزر الهند الغربية لعناقيدها من الفاكهة الصفراء الصالحة للأكل)",
 "dwarf bilberry": "توت أزرق قزم (شجيرة متساقطة الأوراق متكتلة منخفضة النمو من شمال وألب أمريكا الشمالية لها زهور وردية إلى حمراء مرجانية يتبعها توت أزرق حلو)",
 "dwarf blueberry": "توت أزرق قزم (شجيرة متساقطة الأوراق متكتلة منخفضة النمو من شمال وألب أمريكا الشمالية لها زهور وردية إلى حمراء مرجانية يتبعها توت أزرق حلو)",
 "dwarf buckeye": "بكية فرشاة الزجاج, كستناء الحصان القزمية (شجيرة منتشرة بزهور وردية؛ توجد في جنوب شرق الولايات المتحدة)",
 "dwarf buffalo": "أنوا (جاموس صغير في سيليبس له قرون صغيرة مستقيمة)",
 "dwarf cape gooseberry": "حرنكش, طماطم الفراولة (نبات حولي مشعر قوي من شرق أمريكا الشمالية بثمار صفراء حلوة)",
 "dwarf chestnut": "شينكابين, كستناء قزمية (شجرة كستناء شجيرية من جنوب شرق الولايات المتحدة لها جوز صغير صالح للأكل)",
 "dwarf chinkapin oak": "سنديان قزمي (شجرة شجيرية نفضية موطنها شمال شرق ووسط الولايات المتحدة، لها جوز حلو صالح للأكل وغالباً ما تشكل غابات كثيفة)",
 "dwarf chinquapin oak": "سنديان قزمي (شجرة شجيرية نفضية موطنها شمال شرق ووسط الولايات المتحدة، لها جوز حلو صالح للأكل وغالباً ما تشكل غابات كثيفة)",
 "dwarf cornel": "توت البودنغ, قرانيا قزمية (عشب معمر زاحف يتميز بتوت أحمر ودوامات أوراق عنقودية عند أطراف البراعم؛ غرينلاند إلى ألاسكا)",
 "dwarf daisy": "أقحوان صوفي, إريوفيلوم والاسي (نبات حولي صغير رمادي صوفي معنقد ذو رؤوس زهرية صفراء ذهبية صغيرة؛ جنوب شرق كاليفورنيا إلى شمال غرب أريزونا وجنوب غرب يوتا؛ يوضع أحياناً في جنس…)",
 "dwarf dandelion": "هندباء قزمة (عشبة صغيرة صفراء الزهر تشبه الهندباء في وسط وجنوب شرق الولايات المتحدة)",
 "dwarf elder": "خَمَان صَغِير, خَمَان الأَرْض",
 "dwarf elm": "دردار سيبيري (شجرة آسيوية شجيرية سريعة النمو توطنت في الولايات المتحدة للمأوى أو الزينة)",
 "dwarf flowering almond": "لوز مزهر قزم (شجيرة صينية صغيرة بفاكهة حمراء داكنة ملساء غير مجعدة تزرع خاصة لزهورها الحمراء أو الوردية أو البيضاء)",
 "dwarf golden chinkapin": "شنكابين ذهبي قزم (شجيرة دائمة الخضرة تشبه الشنكابين الذهبي؛ جبال كاليفورنيا)",
 "dwarf gray willow": "صفصاف رمادي قزم (شجيرة صفصاف في الأماكن الجافة بشرق الولايات المتحدة ذات أوراق ضيقة طويلة مبيضة من الأسفل)",
 "dwarf grey willow": "صفصاف رمادي قزم (شجيرة صفصاف في الأماكن الجافة بشرق الولايات المتحدة ذات أوراق ضيقة طويلة مبيضة من الأسفل)",
 "dwarf hulsea": "هولسيا قزمة (مشابهة للذهب الألبي ولكنها أصغر حجماً)",
 "dwarf iris": "سوسن قزم (سوسن منخفض النمو يزهر في الصيف من شمال شرق الولايات المتحدة) / سوسن ربيعي, سوسن قزم (سوسن أمريكي منخفض النمو يزهر في الربيع بزهور ليلكية زرقاء زاهية)",
 "dwarf juniper": "عرعر قزم (عرعر منبسط أو منتشر) / عرعر زاحف (نوع منبسط من العرعر الشائع)",
 "dwarf lycopod": "طحلب السنبلة الصخري (طحلب سنبلة ذو خصلات يشكل حصائر منتشرة فضفاضة؛ شرق أمريكا الشمالية)",
 "dwarf maple": "قيقب جبال روكي, قيقب قزمي (قيقب صغير من شمال غرب أمريكا الشمالية)",
 "dwarf mountain pine": "صنوبر جبلي سويسري, صنوبر موغو (صنوبر شجيري منخفض من وسط أوروبا بإبر خضراء زاهية قصيرة في حزم من اثنتين)",
 "dwarf mulberry": "توت السحاب, توت الغيم (توت شوكي زاحف من المناطق المعتدلة الشمالية بتوت أصفر أو برتقالي)",
 "dwarf nipplewort": "أرنوسيريس, هندباء الحمل (عشب أوروبي صغير بأزهار صفراء صغيرة)",
 "dwarf oak": "سنديان قزمي (شجرة شجيرية نفضية موطنها شمال شرق ووسط الولايات المتحدة، لها جوز حلو صالح للأكل وغالباً ما تشكل غابات كثيفة)",
 "dwarf phlox": "قبس جبلي, قبس طحلبي (قبس معمر منخفض ذو خصلات بأوراق دائمة الخضرة تشبه الإبر وزهور وردية أو بيضاء؛ موطنه الولايات المتحدة ويزرع على نطاق واسع كغطاء أرضي)",
 "dwarf pipefish": "سمك أنبوبي قزم (سمكة صغيرة (4 بوصات) توجد قبالة ساحل خليج فلوريدا)",
 "dwarf planet": "كَوْكَب قَزَم ((قديمًا) جرم سماوي من البلازما مضيئ بذاته متماسك بفعل الجاذبية؛ جرم سماوي يدور حول الشمس)\nمثال: كوكب الأرض جميل.",
 "dwarf pocket rat": "جرذ جيبي قزم, فأر كنغري (قارض جيبي صغير حريري الشعر؛ يشبه الجرذان الكنغرية ولكنه أصغر)",
 "dwarf russian almond": "لوز روسي (شجيرة آسيوية تزرع لزهورها الحمراء الوردية)",
 "dwarf sperm whale": "حوت العنبر القزمي (حوت عنبر صغير جداً (يصل إلى 8 أقدام) يعيش في السواحل الوسطى للمحيط الأطلسي والهادئ)",
 "dwarf spurge": "فربيون قزم (فربيون عشبي سنوي أوروبي منتصب أو منخفض دخيل في شمال شرق الولايات المتحدة)",
 "dwarf star": "نَجْم قَزَم (طَلَعَ وظَهَرَ؛ نَجَمَ عن الأمر: أي ظهر نَتِيجَة عنه أو نَتَجَ عنه)\nمثال: سميت السفينة \"النجم الفضي\".",
 "dwarf sumac": "سماق قزم, سماق لامع (شجيرة شائعة غير سامة في شرق أمريكا الشمالية بأوراق مركبة وزهور خضراء عنقودية تليها ثمار حمراء)",
 "dwarf tulip": "توليب قزم (توليب صغير يزهر مبكراً)",
 "dwarf willow": "صفصاف عشبي, صفصاف قزم (صفصاف شجيري شمالي واسع الانتشار بسيقان زاحفة جزئياً تحت الأرض وأوراق خضراء لامعة زاهية)",
 "dwarf-white trillium": "تريليوم أبيض قزم, تريليوم الثلج (تريليوم معمر منخفض أبيض الأزهار يوجد في جنوب شرق الولايات المتحدة)",
 "dwarfish": "قَزَمِيّ (صغير بشكل غير نمطي)",
 "dwarfishness": "قزمية (صفة البنية المشابهة للقزم)",
 "dwarfism": "تقزم (خلل جيني يؤدي إلى قصر القامة)",
 "dweeb": "دحيح, مجتهد ممل (طالب غير مهم يتعرض للسخرية لكونه متصنعاً أو مجتهداً بشكل ممل)",
 "dwell": "سَكَنَ, أَقَامَ (قَرَّ وهَدَأ، ضد اِضْطَرَبَ؛ وَطَنَ، يستخدم سكن عند الحديث عن البيت أو الدار ووطن عن الحديث عن البلاد أو المدينة)\nمثال: كان زيري بسكن هناك.",
 "dweller": "ساكن, قاطن (شخص يسكن في مكان معين)",
 "dwelling": "مَنْزِل, سَكَن (مكان نزول القافلة؛ واحد منازل القمر، وهي مداراته التي يدور فيها حول الأَرض يدور كلَّ ليلة في أَحدها)\nمثال: لقد هدأ المنزل.",
 "dwelling house": "مأوى, مسكن (سكن يعيش فيه شخص ما)\nمثال: بنى مسكناً متواضعاً بالقرب من البركة",
 "dwindling": "آخِذ فِي التَّلَاشِي, مُتَضَائِل (يتناقص تدريجيًّا حتّى لا يبقى منه إلّا القليل) / تضاؤل, تناقص (أن يصبح الشيء أقل تدريجياً)\nمثال: ليس هناك حزن أكبر من تضاؤل العائلة",
 "dwindling away": "تضاؤل, تناقص (أن يصبح الشيء أقل تدريجياً)\nمثال: ليس هناك حزن أكبر من تضاؤل العائلة",
 "dwojniak": "دوفويباك (نبيذ عسل بولندي، يُصنع باستخدام كميات متساوية من الماء والعسل)",
 "dy": "ديسبروسيوم (عنصر فلزي ثلاثي التكافؤ من مجموعة الأتربة النادرة؛ يشكل مركبات مغناطيسية للغاية)",
 "dyad": "ثُنَائِيّ, زَوْج (عنصران من نفس النوع)",
 "dyadic": "ثنائي (متعلق بزوج (ثنائي) أو قائم على اثنين)",
 "dyadic operation": "عملية ثنائية (عملية تجرى على معاملين اثنين بالضبط)",
 "dyarchy": "حكم ثنائي (شكل من أشكال الحكم بوجود حاكمين مشتركين)",
 "dybbuk": "ديبوك ((الفولكلور اليهودي) شيطان يدخل جسد شخص حي ويسيطر على سلوك ذلك الجسد)",
 "dye": "صِبْغَة / صَبَغَ ((صَبَغَ) الثوبَ ونحوه يَصْبُغُ صَبْغًا: لَوَّنَهُ؛ فهو صابغ، وصَبَّاغٌ، والمفعولُ: مصبوغٌ، وصَبِيغٌ)\nمثال: صبغ ابي صندوق البريد بالاحمر.",
 "dye-works": "مصبغة (ورشة يتم فيها الصباغة)",
 "dyed": "مَصْبُوغ",
 "dyeing": "صباغة (استخدام الصبغة لتغيير لون شيء ما بشكل دائم)",
 "dyer": "صَبَّاغ, صَبَّاغَة",
 "dyer's greenweed": "جنيستا الصباغين, وزال الصباغين (شجيرة أوراسية صغيرة لها عناقيد من الزهور الصفراء التي تنتج صبغة؛ شائعة كعشب ضار في بريطانيا والولايات المتحدة؛ تزرع أحياناً للزينة)",
 "dyer's mignonette": "بليحاء, ريزيدا الصباغين (خزامى أوروبية تزرع كمصدر لصبغة صفراء؛ متوطنة في أمريكا الشمالية)",
 "dyer's rocket": "بليحاء, ريزيدا الصباغين (خزامى أوروبية تزرع كمصدر لصبغة صفراء؛ متوطنة في أمريكا الشمالية)",
 "dyer's weed": "عشبة الصباغين (عشبة من شرق أمريكا الشمالية تستخدم أزهارها الصفراء (أو كانت تستخدم) في الصباغة)",
 "dyer's woad": "سُدُوس",
 "dyer's woodruff": "خشب الصباغين (نبات أوروبي زاحف معمر له زهور حمراء أو بيضاء وردية وجذور حمراء تستخدم أحياناً كبديل للفوة في الصباغة)",
 "dyer's-broom": "جنيستا الصباغين, وزال الصباغين (شجيرة أوراسية صغيرة لها عناقيد من الزهور الصفراء التي تنتج صبغة؛ شائعة كعشب ضار في بريطانيا والولايات المتحدة؛ تزرع أحياناً للزينة)",
 "dyers' chamomile": "أقحوان الصباغين, بابونج أصفر (عشبة أوراسية معمرة بأوراق مقسمة مشعرة وزهور صفراء؛ متوطنة في أمريكا الشمالية)",
 "dyestuff": "خضاب, صبغة (مادة قابلة للذوبان عادة تستخدم للتلوين أو الصباغة، مثل الأقمشة أو الشعر)",
 "dyeweed": "جنيستا الصباغين, وزال الصباغين (شجيرة أوراسية صغيرة لها عناقيد من الزهور الصفراء التي تنتج صبغة؛ شائعة كعشب ضار في بريطانيا والولايات المتحدة؛ تزرع أحياناً للزينة)",
 "dyewood": "خشب الصباغة (أي خشب يتم الحصول منه على صبغة)",
 "dying": "مُحْتَضَر, يَمُوت (في عملية الانتقال من الحياة أو التوقف عن الوجود) / اندثار, زوال (الوقت الذي ينتهي فيه شيء ما)\nمثال: رجل يحتضر",
 "dyirbal": "لغة ديربال (لغة لسكان أستراليا الأصليين، يتم التحدث بها في شمال شرق كوينزلاند)",
 "dyirbal language": "لغة ديربال (لغة لسكان أستراليا الأصليين، يتم التحدث بها في شمال شرق كوينزلاند)",
 "dyke": "جَيْبْ نَافِذ (جيَّب القميص:جَابَ، جعل له جيبًا)\nمثال: جيب سامي مثقوب.",
 "dynamic": "حَرَكِيّ ((يستخدم للأفعال والصفات المشتقة) يعبر عن فعل بدلاً من حالة كينونة) / حركي, ديناميكي (يتميز بالعمل أو القوة أو قوة الشخصية) / ديناميكي (من أو يتعلق بالديناميكا) / دينامية, قوة دافعة (حافز فعال أو قوة محركة)\nمثال: سوق ديناميكي",
 "dynamic balance": "توازن ديناميكي ((في الطيران) حالة التوازن التي لا تنتج فيها قوى الطرد المركزي الناتجة عن كتلة دوارة (مثل المروحة) قوة في العمود، مما يقلل الاهتزاز)",
 "dynamic electricity": "كهرباء تيارية, كهرباء ديناميكية (تدفق للشحنة الكهربائية)",
 "dynamic headroom": "سعة ديناميكية, هامش أمان صوتي (قدرة النظام على إعادة إنتاج الأصوات العالية دون تشويه)",
 "dynamic loudspeaker": "مكبر صوت ديناميكي (مكبر صوت يستخدم غشاء خفيف الوزن متصل بسلة صلبة عبر تعليق مرن يقيد حركة الملف الصوتي محورياً عبر فجوة مغناطيسية أسطوانية)\nمثال: يعمل مكبر الصوت الديناميكي على نفس المبدأ الأساسي للميكروفون الديناميكي، ولكن بشكل معكوس، لإنتاج صوت من إشارة كهربائية",
 "dynamic microphone": "ميكروفون حركي, ميكروفون ديناميكي (ميكروفون يعمل عن طريق الحث الكهرومغناطيسي)",
 "dynamic speaker": "مكبر صوت ديناميكي (مكبر صوت يستخدم غشاء خفيف الوزن متصل بسلة صلبة عبر تعليق مرن يقيد حركة الملف الصوتي محورياً عبر فجوة مغناطيسية أسطوانية)\nمثال: يعمل مكبر الصوت الديناميكي على نفس المبدأ الأساسي للميكروفون الديناميكي، ولكن بشكل معكوس، لإنتاج صوت من إشارة كهربائية",
 "dynamic viscosity": "لُزُوجَة دِينَامِيكِيَّة, لُزُوجَة مُطْلَقَة (مقياس لمقاومة تدفق مائع تحت تأثير قوة مطبقة)",
 "dynamical": "حركي, ديناميكي (يتميز بالعمل أو القوة أو قوة الشخصية)\nمثال: سوق ديناميكي",
 "dynamical system": "نظام ديناميكي ((الفيزياء) فضاء طور جنباً إلى جنب مع تحول لذلك الفضاء)",
 "dynamically": "بِحَيْوِيَّة, دِينَامِيكِيًّا (بطريقة ديناميكية قوية)\nمثال: هذا عازف البيانو يعزف بديناميكية",
 "dynamics": "دِينَامِيكَا, حَرَكِيَّة",
 "dynamism": "حيوية, ديناميكية (نشاط شخصية حيوية) / حيوية, نشاط (قوة نشطة للجسد أو العقل) / ديناميكية (أي من النظريات أو المذاهب أو الأنظمة الفلسفية المختلفة التي تحاول تفسير ظواهر الكون بدلالة قوة أو طاقة كامنة)",
 "dynamite": "دِينَامِيت",
 "dynamiter": "مفجر بالديناميت, ناسف (شخص يستخدم الديناميت في قضية ثورية)",
 "dynamitist": "مفجر بالديناميت, ناسف (شخص يستخدم الديناميت في قضية ثورية)",
 "dynamo": "دِينَامُو",
 "dynamometer": "دينامومتر, مقياس القوة (أداة قياس مصممة لقياس القدرة أو القوة)",
 "dynapen": "ديكلوكساسيلين, دينابين (مضاد للبكتيريا (الاسم التجاري دينابين) يستخدم لعلاج الالتهابات العنقودية المقاومة للبنسلين)",
 "dynast": "حاكم سلالة, عاهل وراثي (حاكم وراثي)",
 "dynastic": "سلالي (مكون من أو متعلق بـ أو مميز للسلالة الحاكمة)",
 "dynasty": "سُلَالَة",
 "dyne": "داين (وحدة قوة تساوي القوة التي تكسب كتلة مقدارها غرام واحد تسارعًا قدره 1 سم/ثانية/ثانية)",
 "dysaphia": "خلل اللمس, عسر اللمس (اضطراب في حاسة اللمس)",
 "dysarthria": "رتة, عسر التلفظ (ضعف القدرة التعبيرية الناتجة عن عيوب في الأعصاب الحركية المحيطية أو في عضلات الكلام)",
 "dysbiosis": "اِخْتِلَال التَّوَازُنِ ٱلْبَكْتِيرِيِّ (الاِخْتِلال : اتّخاذ الخلّ من العصير؛ اختلّ الأمر : وقع فيه الخلل)",
 "dyscalculia": "عسر الحساب (ضعف القدرة على تعلم الرياضيات المناسبة للصف الدراسي)",
 "dyschezia": "عسر التغوط (صعوبة في التبرز (عادة نتيجة لقمع إرادي طويل الأمد للرغبة في التبرز))",
 "dyscrasia": "اعتلال الدم, خلل المزاج (حالة غير طبيعية أو غير متوازنة فسيولوجياً للجسم)",
 "dysentery": "زُحَار",
 "dysfunction": "خلل وظيفي, قصور وظيفي (أي اضطراب في أداء عضو أو جزء من الجسم، أو اضطراب في عمل مجموعة اجتماعية)\nمثال: ضعف الانتصاب",
 "dysfunctional": "سَيِّئ التَّكَيُّف, مُخْتَلّ وَظِيفِيًّا ((عن سمة أو حالة) يفشل في خدمة غرض التكيّف) / مُخْتَلّ الوَظِيفَة (مُعتلّ في الأداء الوظيفي؛ خاصّة في جهاز أو عضو من الجسم)",
 "dysfunctionality": "خلل وظيفي (حالة العمل بشكل غير صحيح أو غير طبيعي)\nمثال: الخلل الوظيفي في معظم الكنائس والدول ينبع من سوء التربية الأبوية",
 "dysgenesis": "خلل التكون (عقم بين الهجائن)",
 "dysgenic": "تدهوري, خللي النسل (متعلق بـ أو مسبب للتدهور في النسل الناتج)",
 "dysgenics": "علم خلل النسل (دراسة عمل العوامل التي تسبب انحطاطاً في نوع النسل المنتج)",
 "dysgraphia": "عسر الكتابة (ضعف القدرة على تعلم الكتابة)",
 "dyshidrosis": "خلل التعرق (أدخل شيئًا بين آخر؛ جعل شيئًا يتخلل شيئًا آخر)",
 "dyskinesia": "خلل الحركة, عسر الحركة (شذوذ في أداء الحركات العضلية الإرادية)",
 "dyslectic": "مُصَاب بِعُسْر القِرَاءَة (يُعاني من ضعف القدرة على فهم الكلمات المكتوبة عادةً بسبب اضطراب عصبيّ) / عسير القراءة, مصاب بعسر القراءة (شخص يعاني من عسر القراءة (ديسليكسيا))",
 "dyslexia": "عُسْرُ ٱلْقِرَاءَة (جعَل شيئًا صعبًا أو أكثر تعقيدًا؛ وضع عوائق أو صعوبات أمام أمرٍ ما)\nمثال: إن مع العسر يسرا.",
 "dyslexic": "مُصَاب بِعُسْر القِرَاءَة (يُعاني من ضعف القدرة على فهم الكلمات المكتوبة عادةً بسبب اضطراب عصبيّ) / ديسليكسي, عسر قرائي (من أو يتعلق بعسر القراءة (ديسليكسيا) أو يعد عرضاً له) / عسير القراءة, مصاب بعسر القراءة (شخص يعاني من عسر القراءة (ديسليكسيا))",
 "dyslogia": "خلل المنطق, عسر الكلام العقلي (ضعف القدرة على التعبير عن الأفكار شفهياً؛ ناتج عادة عن صعوبات في التفكير (كما في ضعف العقل أو بعض الذهان))",
 "dyslogistic": "تَحْقِيرِيّ, ذَمِّيّ (يُعَبِّر عن الاستهجان أو الرفض)",
 "dysmenorrhea": "عسر الطمث (حيض مؤلم)",
 "dysomia": "خلل الشم (قصور في حاسة الشم)",
 "dysosmia": "خلل الشم, عسر الشم (اضطراب في حاسة الشم)",
 "dysostosis multiplex": "متلازمة هيرلر (مرض وراثي (متنحي) يتمثل في خطأ في استقلاب عديدات السكاريد المخاطية؛ يتميز بتشوهات شديدة في تطور الغضروف الهيكلي والعظام والتخلف العقلي)",
 "dyspareunia": "عُسْر جِمَاع, علم جماع (جعَل شيئًا صعبًا أو أكثر تعقيدًا؛ وضع عوائق أو صعوبات أمام أمرٍ ما)\nمثال: إن مع العسر يسرا.",
 "dyspepsia": "عسر الهضم (اضطراب في وظيفة الجهاز الهضمي يتميز بعدم الراحة أو حرقة المعدة أو الغثيان)",
 "dyspeptic": "سَوْدَاوِيّ, مُتَعَكِّر المِزَاج (سريع الانفعال كأنه يعاني من عسر الهضم) / مُصَاب بِعُسْر الهَضْم (يعاني من عسر الهضم) / مُصاب بِعُسْر الهَضْم (شخص يعاني من عسر الهضم)",
 "dysphagia": "عسر البلع (حالة يكون فيها البلع صعباً أو مؤلماً)",
 "dysphania": "أَثِنَة",
 "dysphasia": "عسر الكلام (ضعف في اللغة (وخاصة إنتاج الكلام) الذي يرجع عادة إلى تلف في الدماغ)",
 "dysphemism": "تعبير مسيء, ديسفيميزم (تعبير مسيء أو مهين يتم استبداله بآخر غير مسيء)",
 "dysphemistic": "تهجيني, قبيح التعبير (من أو ذو طبيعة التهجين (استخدام تعبير قاسي لشيء عادي))\nمثال: 'رفس الدلو' هو مصطلح تهجيني لـ 'مات'",
 "dysphonia": "بحة الصوت, خلل التصويت (اضطراب في الكلام يعزى إلى اضطراب في التصويت)",
 "dysphoria": "اِضْطِرَاب هُوِيَّة",
 "dysphoric": "تعيس, مكتئب (شعور عام بالضيق)",
 "dysplasia": "خلل التنسج (نمو غير طبيعي (للأعضاء أو الخلايا) أو هيكل غير طبيعي ناتج عن هذا النمو)",
 "dysplastic": "خلل التنسج (متعلق بـ أو يظهر خلل التنسج)",
 "dyspnea": "ضيق النفس, عسر التنفس (تنفس صعب أو مجهد)",
 "dyspneal": "عَسِر التَّنَفُّس, لَاهِث (لا يتنفس أو غير قادر على التنفس إلا بصعوبة)\nمثال: مقطوع النفس عند التفكير فيما فعلت",
 "dyspneic": "عَسِر التَّنَفُّس, لَاهِث (لا يتنفس أو غير قادر على التنفس إلا بصعوبة)\nمثال: مقطوع النفس عند التفكير فيما فعلت",
 "dyspnoea": "ضيق النفس, عسر التنفس (تنفس صعب أو مجهد)",
 "dyspnoeal": "عَسِر التَّنَفُّس, لَاهِث (لا يتنفس أو غير قادر على التنفس إلا بصعوبة)\nمثال: مقطوع النفس عند التفكير فيما فعلت",
 "dyspnoeic": "عَسِر التَّنَفُّس, لَاهِث (لا يتنفس أو غير قادر على التنفس إلا بصعوبة)\nمثال: مقطوع النفس عند التفكير فيما فعلت",
 "dysprosium": "دِسْبُرُوسِيُوم",
 "dyssynergia": "رنح, فقدان الانتظام الحركي (عدم القدرة على تنسيق الحركات العضلية الإرادية؛ حركات غير مستقرة ومشية مترنحة)",
 "dysthymia": "الاكتئاب الجزئي, عسر المزاج (اكتئاب مزمن خفيف)\nمثال: اعتقدت أنها كانت في مزاج سيء لمدة ثلاثين عاماً، لكن الطبيب سماه عسر المزاج",
 "dysthymic depression": "الاكتئاب الجزئي, عسر المزاج (اكتئاب مزمن خفيف)\nمثال: اعتقدت أنها كانت في مزاج سيء لمدة ثلاثين عاماً، لكن الطبيب سماه عسر المزاج",
 "dystopia": "أدب المدينة الفاسدة, أدب الواقع المرير (عمل خيالي يصف مكاناً وهمياً تكون الحياة فيه سيئة للغاية بسبب الحرمان أو القمع أو الرعب) / ديستوبيا, مدينة فاسدة (حالة تكون فيها ظروف الحياة سيئة للغاية بسبب الحرمان أو القمع أو الإرهاب)",
 "dystopian": "بائس, ديستوبي (سيء لأقصى حد؛ يتميز بالبؤس البشري) / بائس, ديستوبي (من أو يخص أو يشبه الديستوبيا (المدينة الفاسدة))\nمثال: الإيدز هو أحد النذر الديستوبية للقرى العالمية",
 "dystrophy": "ضُمُور",
 "dysuria": "عسر التبول (تبول مؤلم أو صعب)",
 "dziggetai": "حمار منغوليا البري, دزيجيتاي (حمار بري منغولي)",
 "dzmitry": "دْمِيتْرِي",
 "déjà vu": "دِيجَا ڤُو",
 "détente": "انفراج دولي",
 "dönmeh": "دُونْمَة",
 "düzce": "دُوزْجِه",
 "e": "إِي, إِيه (بمعنى نَعَم ولا يأتي إلا وبعده قَسَم؛ في : يستخدم بدلا من نعم في كل الحالات حتى في إجابة النداء وليس بحاجة إلى قَسَم)\nمثال: يجب على توم عدم إعطاء إي إهتمام لما قالته ماري.",
 "e'en": "حتى (يفيد انتهاء الغاية؛ يفيد الغاية)\nمثال: انتظر حتى أجلس.",
 "e'er": "أبداً, دائماً (في جميع الأوقات؛ طوال الوقت وفي كل مناسبة)\nمثال: سأكون دائماً هناك لمساعدتك",
 "e-bike": "دراجة إلكترونية, دراجة كهربائية (دراجة مبنية بمحرك، يمكن تشغيل الدراجة بواسطة المحرك أو بتدويس الراكب)",
 "e-bomb": "قنبلة إلكترونية, قنبلة ميكروويف (قنبلة تنفجر في الجو وتطلق دفعة هائلة من الطاقة الكهرومغناطيسية كافية لتعطيل الحواسيب والاتصالات دون قتل الناس أو تدمير المباني)",
 "e-book": "كِتَاب إِلِكْتْرُونِيّ, إِيبُوك (موضع تعليم الكتابة. الاستخدام الأصلي؛ مدرسة شبه رسمية لتعليم الأطفال الكِتَابَة والقِرَاءَة ومباديء الحِسَاب وبعض القُرَآن…)\nمثال: هذا الكتاب جديد",
 "e-commerce": "تِجَارَة إِلِكْتْرُونِيَّة",
 "e-consulting": "استشارة إلكترونية (عمل تقديم خدمات مثل تصميم صفحات الويب ونصائح التسويق للشركات التي تمارس أعمالاً تجارية عبر الإنترنت)",
 "e-lasik": "لازك (إجراء جراحي انكساري يعيد تشكيل القرنية، مما يخلق رفرفاً مفصلياً في الطبقة الظهارية للعين)",
 "e-mail": "إيميل, بريد إلكتروني ((علوم الكمبيوتر) نظام للاتصال الإلكتروني العالمي حيث يمكن لمستخدم الكمبيوتر إنشاء رسالة في محطة طرفية واحدة يمكن إعادة إنشائها في محطة المستلم عند…) / رسالة بريد إلكتروني (رسالة مرسلة عبر الإنترنت عبر نظام البريد الإلكتروني) / عنوان بريد إلكتروني (مُعرِّف يستخدمه الشخص كهوية له للتواصل عبر نظام البريد الإلكتروني)\nمثال: لا يمكنك إرسال طرود بالبريد الإلكتروني",
 "e-mail address": "عُنْوَان بَرِيد إِلِكْتْرُونِيّ, عِنْوَان بَرِيد إِلِكْتْرُونِيّ (عُنْوَان)\nمثال: نسيت عنوان توم.",
 "e-mail message": "رسالة بريد إلكتروني (رسالة مرسلة عبر الإنترنت عبر نظام البريد الإلكتروني)",
 "e-mycin": "إريثروسين, إريثروميسين",
 "e-reader": "قَارِئ اَلْكِتَاب اَلْإِلِكْتْرُونِيّ",
 "e. coli": "إشريكية قولونية (نوع من البكتيريا يوجد عادة في القناة المعوية للبشر والحيوانات الأخرى؛ ممرضة أحياناً؛ يمكن أن تشكل تهديداً لسلامة الغذاء)",
 "e.g.": "على سبيل المثال, نحو (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال.",
 "e.p.a.": "وكالة حماية البيئة (وكالة فيدرالية مستقلة تأسست لتنسيق البرامج التي تهدف إلى الحد من التلوث وحماية البيئة)",
 "e.s.p.": "إدراك خارج الحواس, استبصار (قوة ظاهرية لإدراك أشياء غير موجودة للحواس)",
 "each": "كُلّ",
 "each other": "بَعْضُهُ الْبَعْض",
 "each week": "أسبوعياً, كل أسبوع (دون تفويت أسبوع)\nمثال: زارت عمتها أسبوعياً",
 "each year": "سنوياً, كل سنة (دون تفويت سنة) / سَنَوِيًّا (في السنة؛ كل سنة (عادة مع الإشارة إلى مبلغ من المال يدفع أو يُستلم))\nمثال: يسافرون إلى الصين سنوياً",
 "eacles imperialis": "عثة إمبراطورية (عثة أمريكية كبيرة ذات أجنحة صفراء بعلامات أرجوانية أو بنية؛ تتغذى اليرقات على أشجار القيقب والصنوبر مثلاً)",
 "eager": "مُشْتَاق",
 "eager beaver": "شُعْلَة نَشَاط, مُتَحَمِّس (شخص يقظ ونشيط للغاية)",
 "eagerly": "بشوق, بلهفة\nمثال: كانت الأخبار منتظرة بلهفة",
 "eagerness": "تأهب, حماس (استعداد فوري) / توق, شغف (شعور إيجابي بالرغبة في المضي قدماً في شيء ما)\nمثال: استعداد لمواصلة المناقشات",
 "eagle": "عُقَاب (طَيْر من الجَوَارِح، أكبر التي تصيد منها يكنى بأبي الهَيْثَم ومعروف بحِدَّة البصر؛ حَجَر ناتئ في جَوْف البِئْر يخرق الدَلُو. ونادر)\nمثال: هو من تلقى العقاب الأكبر.",
 "eagle ray": "سمك الراي النسر (سمكة راي استوائية قوية تسبح بحرية وتشتهر بـ 'التحليق' عن طريق رفرفة زعانف تشبه الأجنحة؛ عادة ما تكون غير ضارة ولكن لديها نسيج سام بالقرب من قاعدة…)",
 "eagle scout": "كشاف نسر (كشاف حصل على العديد من شارات الجدارة)",
 "eagle-eyed": "بَعِيد النَّظَر, حَادّ البَصَر (قادر على رؤية الأشياء البعيدة بوضوح)",
 "eaglet": "هَيْثَم (فرخ العقاب أو الصقر؛ الصقر أو العقاب ذاته)\nمثال: أكد رئيس دولة الإمارات، ألشيخ محمد بن زايد وسلطان عمان هيثم بن طارق، أكدا ضرورة اللجوء إلى الحوار والحلول الدبلوماسية في معالجة قضايا المنطقة.",
 "eagre": "طغيان المد, موجة المد العارمة (موجة عالية (غالباً ما تكون خطرة) ناتجة عن تدفق المد والجزر (كما هو الحال عند تصادم تيارات المد والجزر أو في مصب ضيق))",
 "eames chair": "كرسي إيمز (كرسي صممه تشارلز إيمز؛ مصنوع أصلاً من الخشب الرقائقي المقولب؛ المقعد والظهر مصممان ليلائما جسم الإنسان)",
 "ear": "أُذُن (أَذَن؛ أَذَنَ: ( فعل ) أَذَنَ أَذْناً) / أُذْن (أَذَن؛ أَذَنَ: ( فعل ) أَذَنَ أَذْناً) / سُنْبُلَة / حَرَثَ (حرث الأرض: شقها بالمحراث ليزرعها؛ حرث النار: حركها وأثارها)\nمثال: من أذن لتوم باستعارة سيارتي?",
 "ear canal": "قَنَاة سَمْعِيَّة, صِمَاخ",
 "ear cuff": "قرط مشبك, مشبك الأذن (قرط غير مثقوب بأحجام مختلفة (أي لفة صغيرة أو خطاف كبير يكفي للتعليق فوق الأذن بأكملها والتدلي) يوضع على حافة الأذن)",
 "ear doctor": "أخصائي أذن, طبيب أذن (طبيب متخصص في الأذن وأمراضها)",
 "ear fungus": "أذن يهوذا, فطر الأذن (فطر صالح للأكل واسع الانتشار على شكل أذن بشرية وينمو على الخشب المتحلل)",
 "ear hole": "فتحة الأذن (ثقب (كما في خوذة) لوصول الصوت إلى الأذنين)",
 "ear hook earring": "قرط مشبك, مشبك الأذن (قرط غير مثقوب بأحجام مختلفة (أي لفة صغيرة أو خطاف كبير يكفي للتعليق فوق الأذن بأكملها والتدلي) يوضع على حافة الأذن)",
 "ear lobe": "شَحْمَة اَلْأُذْن",
 "ear specialist": "أخصائي أذن, طبيب أذن (طبيب متخصص في الأذن وأمراضها)",
 "ear trumpet": "بوق سمع (جهاز صوتي مخروطي كان يستخدم سابقاً لتوجيه الصوت إلى أذن الشخص ضعيف السمع)",
 "ear wrap": "قرط مشبك, مشبك الأذن (قرط غير مثقوب بأحجام مختلفة (أي لفة صغيرة أو خطاف كبير يكفي للتعليق فوق الأذن بأكملها والتدلي) يوضع على حافة الأذن)",
 "ear-like": "أُذُنِيُّ الشَّكْلِ, أُذُنِيّ (ذو شكل يشبه الأذن)",
 "ear-nose-and-throat doctor": "طبيب أنف وأذن وحنجرة (أخصائي في اضطرابات الأذن أو الأنف أو الحنجرة)",
 "ear-shaped": "أُذُنِيُّ الشَّكْلِ, أُذُنِيّ (ذو شكل يشبه الأذن)",
 "ear-shell": "أذن البحر (أَذَن؛ أَذَنَ: ( فعل ) أَذَنَ أَذْناً)\nمثال: من أذن لتوم باستعارة سيارتي?",
 "earache": "أَلَم الأُذُنِ, أَلَم الأُذْنِ (الوَجَع)\nمثال: ألم أقل لك ذلك؟",
 "earcuff": "قرط مشبك, مشبك الأذن (قرط غير مثقوب بأحجام مختلفة (أي لفة صغيرة أو خطاف كبير يكفي للتعليق فوق الأذن بأكملها والتدلي) يوضع على حافة الأذن)",
 "eardrop": "قرط متدلي (قرط به حلية متدلية)",
 "eardrum": "طَبْلَة اَلْأُذْن",
 "eared": "ذو أذنين, مؤذن (له أذنان (أو زوائد تشبه الأذنين) أو له أذنان من نوع معين؛ غالباً ما يستخدم في التركيبات اللفظية) / رَثّ, مُثَنَّى الزَّوَايَا (بَالٍ أَوْ رَثٌّ مِنْ كَثْرَةِ الاسْتِعْمَالِ أَوْ (لِلصَّفَحَاتِ) مَطْوِيُّ الزَّوَايَا)",
 "eared grebe": "غطاس أسود الرقبة (غطاس صغير ذو خصلات أذن صفراء ورقبة سوداء؛ يوجد في أوراسيا وجنوب أفريقيا وكذلك غرب الولايات المتحدة)",
 "eared seal": "فقمة ذات أذنين (ثديي زعنفي الأقدام له سديلات أذن خارجية وأطراف خلفية تُستخدم للحركة على الأرض؛ يُقدر لفروه السفلي الناعم)",
 "earflap": "غطاء الأذن (أحد لسانين متصلين بقبعة للحفاظ على دفء الأذنين)",
 "earful": "تَقْرِيع شَدِيد, تَوْبِيخ لَاذِع (توبيخ شديد وقاسٍ) / توبيخ, كم هائل من الثرثرة (تدفق من القيل والقال أو التوبيخ)",
 "earl": "إيرل (نبيل بريطاني رتبته أقل من ماركيز وأعلى من فيكونت)",
 "earl marshal": "إيرل مارشال (ضابط في طبقة النبلاء الإنجليزية ينظم المواكب الملكية وغيرها من الاحتفالات)",
 "earlap": "غطاء الأذن (أحد لسانين متصلين بقبعة للحفاظ على دفء الأذنين)",
 "earldom": "إقطاعية إيرل (المجال الذي يسيطر عليه الإيرل أو الكونت) / رتبة الكونت, كونتية (كرامة أو رتبة أو منصب الكونت أو الكونتيسة)",
 "earleaved umbrella tree": "شجرة المظلة أذينية الأوراق, ماغنوليا فريزر (شجرة صغيرة منتصبة متساقطة الأوراق بأوراق كبيرة في تشكيلات ملفوفة عند أطراف الفروع)",
 "earless": "أصم (بلا أذنين), عديم الأذن (يفتقر إلى الأذنين الخارجيتين)\nمثال: فقمات عديمة الأذن",
 "earless lizard": "سحلية عديمة الأذن (أي من عدة سحالي نحيلة بدون فتحات أذن خارجية: من سهول غرب الولايات المتحدة والمكسيك)",
 "earless seal": "فقمة حقيقية, فقمة عديمة الأذن (أي من عدة فقمات تفتقر إلى سديلات الأذن الخارجية ولها معطف صلب يشبه الشعر مع أطراف خلفية مختزلة إلى زعانف للسباحة)",
 "earlier": "سابقاً, في وقت سابق (في وقت أبكر؛ سابقاً) / أصلاً, في المقام الأول (قبل الآن) / فِي وَقْت أَبْكَر (صيغ مقارنة لـ 'قريباً' أو 'مبكراً') / أَبْكَر, أَسْبَق ((صيغة تفضيل لـ 'مُبَكِّر') أكثر أو أشدّ تبكيراً)\nمثال: كنت أعرفها من قبل",
 "earliest": "أبكر وقت, في أقرب وقت (بأقل تأخير) / أَبْكَر, أَسْبَق ((صيغة تفضيل لـ 'مُبَكِّر') أكثر أو أشدّ تبكيراً)\nمثال: أقرب وقت يمكنني الوصول فيه هو الساعة 3 مساءً",
 "earliness": "تبكير (صفة المجيء مبكراً أو في وقت أسبق)",
 "earlobe": "شحمة الأذن (الجزء اللحمي المتدلي من الأذن الخارجية للإنسان)",
 "early": "بَاكِر (صيعة الأمر المفرد المذكر من الفعل بَاكَرَ) / مُبَكِّرًا, بَاكِرًا\nمثال: وصل السيد باكر.",
 "early bird": "مُبَكِّر (شخص يستيقظ مبكراً جداً في الصباح) / باكور, مبكر (شخص يصل مبكرًا قبل الآخرين)",
 "early childhood": "طفولة مبكرة, مهد (المرحلة المبكرة من النمو أو التطور)",
 "early coral root": "جذر المرجان المبكر (نبات له كتل من السيقان الصفراء الشاحبة إلى المخضرة عديمة الأوراق تقريباً تحمل زهوراً ملونة بالمثل بشفاه سفلية بيضاء؛ شمال نيو مكسيكو شمالاً عبر…)",
 "early days": "بداية, حداثة (فترة مبكرة من التطور)\nمثال: خلال حداثة المشروع",
 "early morel": "فيربا بوهيمية, موريل مبكر (يشبه الكشتبان على الإصبع؛ سطح الجزء الخصب مطوي في تجاعيد تمتد من الأعلى إلى الأسفل؛ يبدأ الإثمار في الربيع قبل خروج الأوراق على الأشجار)",
 "early on": "في وقت مبكر, مبكراً (خلال مرحلة مبكرة)\nمثال: في وقت مبكر من مسيرتها المهنية",
 "early purple orchid": "سحلب ذكر (سحلب أوراسي بزهور وردية أو أرجوانية ملفتة للنظر في سنبلة فضفاضة)",
 "early spider orchid": "سحلب العنكبوت المبكر (سحلب عنكبوت يزهر في الربيع له زهرة بسبلات صفراء أو خضراء أو وردية وشفة مخملية بنية عريضة)",
 "early wake-robin": "تريليوم أبيض قزم, تريليوم الثلج (تريليوم معمر منخفض أبيض الأزهار يوجد في جنوب شرق الولايات المتحدة)",
 "early warning radar": "رادار الإنذار المبكر (رادار يعد جزءاً من نظام الإنذار المبكر)",
 "early warning system": "نظام الإنذار المبكر (شبكة من منشآت الرادار مصممة للكشف عن صواريخ العدو أو طائراته بينما لا يزال هناك وقت لاعتراضها)",
 "early winter cress": "رشاد أمريكي, رشاد الأرض (من جنوب غرب أوروبا؛ يزرع في فلوريدا)",
 "early-blooming": "مُزْهِر فِي الرَّبِيع (من النباتات التي تُزهر خلال فصل الربيع)",
 "early-flowering": "مُزْهِر فِي الرَّبِيع (من النباتات التي تُزهر خلال فصل الربيع)",
 "early-morning hour": "ساعة مبكرة من الصباح (ساعة في وقت مبكر من الصباح)",
 "earlyish": "مُبَكِّرٌ نَوْعاً مَا (مبكّر إلى حدّ ما)",
 "earmark": "بصمة, سمة فارقة (سمة أو صفة مميزة لشخص أو شيء ما) / علامة الأذن (علامة تعريف على أذن حيوان أليف)",
 "earmuff": "غطاء للأذنين (زوج من أغطية الأذن (عادة ما تكون متصلة بطوق رأس) يتم ارتداؤها للحفاظ على دفء الأذنين في الطقس البارد)",
 "earn": "كَسَبَ",
 "earned": "مستحق, مكتسب (تم الحصول عليه أو اكتسابه؛ خاصة عن طريق الجدارة أو كنتيجة لجهد أو عمل)\nمثال: سمعة مستحقة عن جدارة للأمانة",
 "earned run": "ركضة مكتسبة (ركضة لم تُسجل نتيجة لخطأ من الفريق الآخر)",
 "earned run average": "معدل الركض المكتسب ((بيسبول) مقياس لفعالية الرامي)",
 "earner": "كاسب, متكسب (شخص يكسب أجراً مقابل عمله)",
 "earnest": "جَدِّي, جَادّ / عَرْبُون",
 "earnest money": "مال العربون (مال يعطيه المشتري للبائع لتوثيق العقد)",
 "earnestly": "بجدية (بطريقة جادة)\nمثال: تحدث بجدية مع ابنه",
 "earnestness": "جدية, رزانة (سمة كون المرء جاداً) / إخلاص, جدية (شعور جاد وصادق)\nمثال: نقص الوقار ليس بالضرورة نقصاً في الجدية",
 "earning per share": "ربحية السهم (حصة كل سهم قائم من الأسهم العادية في أرباح الشركة)",
 "earnings": "أرباح, صافي الدخل (فائض الإيرادات عن المصروفات في فترة زمنية معينة (بما في ذلك الإهلاك والمصروفات غير النقدية الأخرى)) / أجر, راتب (شيء يُدفع كمقابل للعمل)\nمثال: دُفعت الأجور نقداً",
 "earnings before interest taxes depreciation and amortization": "إبيتدا, الأرباح قبل الفوائد والضرائب والإهلاك والاستهلاك (الدخل قبل طرح الفوائد والضرائب والإهلاك والاستهلاك؛ مؤشر لربحية الشركة يراقبه المستثمرون (خاصة في عمليات الاستحواذ بالرافعة المالية))",
 "earnings report": "بيان الدخل, تقرير الأرباح (بيان مالي يعطي نتائج التشغيل لفترة محددة)",
 "earphone": "سَمَّاعَة, سَمَاعَات الرَّأْس",
 "earphones": "سَمَّاعَات",
 "earpiece": "سماعة أذن, سماعة رأس (محول كهروصوتي لتحويل الإشارات الكهربائية إلى أصوات؛ يوضع فوق الأذن أو بداخلها)\nمثال: لم تكن الكتابة هي ما تكرهه بل سماعات الأذن",
 "earplug": "سدادة أذن (سدادة من القطن أو الشمع أو المطاط يتم تركيبها في قناة الأذن للحماية من دخول الماء أو الضوضاء العالية) / سدادة أذن (سماعة) (سماعة أذن يتم إدخالها في قناة الأذن)",
 "earreach": "مرمى السمع, مسمع (النطاق الذي يمكن سماع الصوت ضمنه)\nمثال: طُلب من الأطفال البقاء في مرمى السمع",
 "earring": "قُرْط, حَلَق",
 "earshot": "مرمى السمع, مسمع (النطاق الذي يمكن سماع الصوت ضمنه)\nمثال: طُلب من الأطفال البقاء في مرمى السمع",
 "earsplitting": "مُدَوٍّ, مُصِمّ (عالٍ بما يكفي لإحداث فقدان سمع مؤقت)",
 "earth": "تُرْبَة, تُرَاب / أَرْض, أرض (الكَوْكَب الذي نعيش عليه. لا جمع له؛ البَرّ، ضد البَحْر. يجمع على أرضون) / أَرْض, دُنْيَا (الكَوْكَب الذي نعيش عليه. لا جمع له؛ البَرّ، ضد البَحْر. يجمع على أرضون)\nمثال: أرض الله واسعة.",
 "earth almond": "حب العزيز, سعد لذيذ (سعد أوروبي له درنات صغيرة صالحة للأكل تشبه الجوز)",
 "earth color": "صبغة معدنية, لون ترابي (معدن ملون يستخدم كصبغة)",
 "earth day": "يَوْم اَلْأَرْض (فترة من الزمان تبدأ عند غُرُوب الشمس وتنتهي عند غُرُوب شمس النهار التالي ويشمل اللَيْلَة ونَهَارا. طوله أربع وعشرين سَاعَة؛ النَهَار، يبدأ من طلوع الفَجْر إلى غُرُوب الشَمس، على المجاز)\nمثال: طقس اليوم جميل.",
 "earth god": "إله الأرض (إله الخصوبة والنباتات)",
 "earth goddess": "إلهة الأرض (إلهة الخصوبة والنباتات)",
 "earth mother": "الأم الأرض (الأرض متصورة كمبدأ أنثوي للخصوبة)",
 "earth science": "علوم الأرض (أي من العلوم التي تتعامل مع الأرض أو أجزائها)",
 "earth tremor": "رعشة أرضية, زلزال صغير (زلزال صغير)",
 "earth wax": "أوزوكريت, شمع معدني (معدن شمعي عبارة عن خليط من الهيدروكربونات ويوجد مصاحباً للنفط؛ تستخدم بعض أنواعه في صنع السيريسين والشموع)",
 "earth's crust": "قشرة, قشرة الأرض (الطبقة الخارجية للأرض)",
 "earth's surface": "سطح, سطح الأرض (المستوى الخارجي لليابسة أو البحر)\nمثال: تنشأ الزلازل بعيداً تحت السطح",
 "earth-ball": "ترفاس, كمأة (أي من الفطريات التحت أرضية الصالحة للأكل ذات القيمة العالية من جنس تيوبر؛ تنمو طبيعياً في جنوب غرب أوروبا)",
 "earth-closet": "مرحاض خارجي (مبنى خارجي صغير به مقعد يحتوي على ثقوب يمكن للمستخدم التبرز من خلالها)",
 "earth-god": "إله الأرض (إله الخصوبة والنباتات)",
 "earth-goddess": "إلهة الأرض (إلهة الخصوبة والنباتات)",
 "earth-nut pea": "بسلة الأرض, جلبان درني (عشب أوروبي يحمل درنات صغيرة تستخدم للغذاء وفي اسكتلندا لتنكيه الويسكي)",
 "earth-received time": "وقت الاستقبال الأرضي (التوقيت العالمي المنسق عند استقبال حدث على الأرض)",
 "earth-tongue": "لسان الأرض (أي فطر صولجاني الشكل من جنس جيوجلوسوم)",
 "earthball": "كرة الأرض, كمأة كاذبة (أي من الفطريات المختلفة من جنس سكليروديرما لها أجسام ثمرية تحت أرضية صلبة الجلد تشبه الكمأة)",
 "earthborn": "أَرْضِيّ المَنْشَأ (مُرْتَبِط بِالحَياة الأرْضِيَّة؛ ذو أصْل دُنْيَوِيّ) / أَرْضِيّ المَوْلِد (ناشئ من الأرض أو مولود عليها) / أَرْضِيّ المَنْشَأ, بَشَرِيّ (من أصل أرضي كالبشر الفانين)",
 "earthbound": "مُقَيَّد بِالأَرْض (مَحْصور في الأرْض؛ غَيْر قادِر عَلى التَّحَلُّق) / رَتِيب, عَادِيّ (يفتقر إلى الظرف والخيال)",
 "earthen": "تُرَابِيّ / فَخَرِيّ, خَزَفِيّ",
 "earthenware": "خزف مسامي, فخار (أواني خزفية مصنوعة من طين مسامي محروق بحرارة منخفضة)",
 "earthenware jar": "إناء خزفي, جرة فخارية (جرة ترابية (مصنوعة من الطين المخبوز))",
 "earthing": "تأريض (توصيل المعدات الكهربائية بالأرض)",
 "earthlike": "تُرَابِيّ اللَّوْن (بلون التراب أو الأرض) / شَبيه بِالأَرْض (يُشبِه الأرْض في خَصائِصِها)",
 "earthling": "أَرْضِيّ",
 "earthly": "أرضي, دنيوي (من أو ينتمي إلى أو مميز لهذه الأرض كتميز عن السماء)\nمثال: كائنات أرضية",
 "earthly concern": "دنيا, شأن دنيوي (اهتمامات هذه الحياة بتمييزها عن الآخرة)\nمثال: يعتبرون الكنيسة مستقلة عن العالم",
 "earthman": "أرضي, ساكن الأرض (ساكن ذكر لكوكب الأرض)",
 "earthnut": "فقع, كمأة (فطر جوفي صالح للأكل من جنس الكمأة) / فستق عبيد, فول سوداني (قرن كرمة الفول السوداني يحتوي عادة على حبتين أو بذرتين) / جوز الأرض, كونوبوديوم (نبات أوروبي شائع له درنات صالحة للأكل بنكهة الكستناء المحمصة) / ترفاس, كمأة (أي من الفطريات التحت أرضية الصالحة للأكل ذات القيمة العالية من جنس تيوبر؛ تنمو طبيعياً في جنوب غرب أوروبا)",
 "earthnut pea": "بسلة الأرض, جلبان درني (عشب أوروبي يحمل درنات صغيرة تستخدم للغذاء وفي اسكتلندا لتنكيه الويسكي)",
 "earthquake": "زَلْزَال, زِلْزال (فِي : ظاهرة طبيعية وهو اهتزاز أو سلسلة من الاهتزازات الارتجاجية المتتالية لسطح تحدث في وقت لا يتعدى ثواني معدودة…)\nمثال: دمر زلزال عيادة سامي.",
 "earthshaking": "مُزَلْزِل (عالٍ بما يكفي لزلزلة الأرض) / مُزَلْزِل, هَائِل التَّأْثِير (بالغ الأهمّيّة بما يكفي للتأثير في العالم كلّه)",
 "earthshine": "ضوء الأرض (النُّور؛ مصدر ضَاء)\nمثال: ضوء القمر ضعيف.",
 "earthstar": "نجمة الأرض (أي فطر من فصيلة جيستراسيا؛ يشير شكله إلى فطر نفاث ينقسم غلافه الخارجي إلى شكل نجمة)",
 "earthtongue": "لسان الأرض (أي فطر صولجاني الشكل من جنس جيوجلوسوم)",
 "earthwoman": "أرضية, ساكنة الأرض (ساكنة أنثى لكوكب الأرض)",
 "earthwork": "أعمال ترابية, متراس ترابي (متراس مصنوع من التراب)",
 "earthworm": "دُودَة الْأَرْض, خُرْطُون",
 "earthy": "سُوقِيّ, فَجّ (فاحش وعديم الذوق بشكل لافت) / حَيَوِيّ, فِطْرِيّ (نابض بالحيوية والنشاط) / أَرْضِيّ, قَرِيب مِنَ الطَّبِيعَة (غير بعيد عن الطبيعة أو موحٍ بها) / عَمَلِيّ, وَاقِعِيّ (عمليّ ومنطقي بعيد عن التنظير)",
 "earwax": "صِمْلَاخ, شَمْع اَلْأُذْن",
 "earwig": "أَبُو مِقَصّ",
 "ease": "استجمام, استرخاء (التحرر من النشاط (العمل أو الجهد أو المسؤولية)) / بَسَاطَة, سُهُولَة (التحرر من الصعوبة أو المشقة أو الجهد) / أَرِيحِيَّة, بَسَاطَة (التحرر من القيد أو الحرج) / تخفيف, راحة (حالة الارتياح أو التخفيف (خاصة بعد التخلص من الضيق))\nمثال: أخذ قسطاً من الراحة بجانب المسبح",
 "eased": "مُخَفَّف, مُسَكَّن ((لِلأَلَمِ أَوِ الحُزْن) جُعِلَ أَسْهَلَ تَحَمُّلًا)",
 "easel": "حَامِل (اسم فاعل من حَمَلَ، أي الذي يحمل شيئا؛ امرأة حَامِل: حُبْلَى، في بطنها جَنْيِن، وإذا أريد اسم الفاعل يقال للمرأة حَامِلَة)\nمثال: يبدو أنني حامل.",
 "easement": "إراحة, تخفيف (عملية تقليل شيء غير سار (مثل الألم أو الانزعاج)) / حق الارتفاق ((قانون) امتياز استخدام شيء ليس ملكك (مثل استخدام أرض شخص آخر كحق مرور لأرضك))\nمثال: طلب من الممرضة تخفيف الألم المستمر",
