 "east slavic": "سلافي شرقي",
 "east southeast": "الشَّرْق الجَنُوبِيّ الشَّرْقِيّ, شَرْق جَنُوب شَرْق (نقطة البوصلة في منتصف المسافة بين الشرق والجنوب الشرقي)",
 "east timor": "تِيمُور الشَّرْقِيَّة",
 "east tocharian": "التوخارية الشرقية, تورفان (لهجة من التوخارية، خاصة بقراشهر وتوربان)",
 "east turkestan": "تُرْكِسْتَان الشَّرْقِيَّة",
 "east wind": "رياح شرقية (رياح تهب من الشرق)",
 "east-central": "وَسَطِيٌّ شَرْقِيّ (من منطقة في الولايات المتحدة تشمل عموماً كنتاكي ووست فرجينيا)",
 "east-sider": "ساكن الجانب الشرقي (أحد سكان الجانب الشرقي من مانهاتن في مدينة نيويورك)",
 "east-west direction": "اتجاه شرق-غرب (في اتجاه موازٍ لخطوط العرض)",
 "eastbound": "مُتَّجِهٌ شَرْقاً (يتحرّك نحو الشرق)",
 "easter": "عِيد الْفِصْح, الْعِيد الْكَبِير",
 "easter cactus": "صبار الفصح (صبار من أمريكا الجنوبية يزهر في الربيع بمفاصل مستطيلة وأزهار حمراء مرجانية)",
 "easter card": "بطاقة الفصح (بطاقة تعبر عن تهنئة بعيد الفصح)",
 "easter daisy": "أقحوان الفصح, أقحوان عديم الساق (عشب قزم متكتل يكاد يكون عديم الساق له وردة من أوراق صوفية ورؤوس زهور كبيرة بيضاء الأشعة؛ وسط كندا والولايات المتحدة غرباً إلى أريزونا)",
 "easter day": "أحد الفصح, يوم الفصح (اليوم (في مارس أو أبريل) الذي يُحتفل فيه بعيد الفصح)",
 "easter egg": "بَيْضَة عِيد اَلْفِصْح, بَيْضَة اَلْفِصْح (ما تضعه أنثى الحيوان البَيُوض أو الطائر، يخرج منه صغير الطائر بعد فترة؛ قد يقصد به بَيْضَة الدجاج تحديدا لأنه أكثر ما يأكله الإنسان من بيوض الحيوان)\nمثال: هذه بيضة مقلية.",
 "easter island": "جَزِيرَة عِيد اَلْفِصْح, جَزِيرَة الْفِصْح",
 "easter lily": "زنبق الفصح, زنبق برمودا (زنبق طويل له زهور بيضاء كبيرة بوقية الشكل تتفتح في الربيع)",
 "easter lily vine": "زهرة بوق نيبال, كرمة زنبق الفصح (نبات متسلق خشبي دائم الخضرة ذو أوراق لامعة كبيرة ونورات خيمية مبهرجة من الأزهار البيضاء العطرة البوقية الشكل)",
 "easter sunday": "أحد الفصح, يوم الفصح (اليوم (في مارس أو أبريل) الذي يُحتفل فيه بعيد الفصح)",
 "easterly": "شَرْقِيًّا, مِن الشَّرْق (من الشرق) / شَرْقِيّ (قادم من الشرق؛ يُستخدم خاصة عن الرياح) / شَرْقِيّ, وَاقِعٌ فِي الشَّرْق (يقع في الشرق أو باتّجاهه) / رياح شرقية (رياح تهب من الشرق)\nمثال: هبت الرياح شرقياً طوال الليل",
 "eastern": "شَرْقِيّ",
 "eastern bloc": "اَلْكُتْلَة الشَّرْقِيَّة",
 "eastern catholicism": "كاثوليكية شرقية (معتقدات وممارسات أي من الكنائس الكاثوليكية الشرقية التي تتخذ من القسطنطينية أو أنطاكية أو الإسكندرية أو موسكو أو القدس مقراً لها)",
 "eastern chimpanzee": "شمبانزي شرقي (شمبانزي طويل الشعر في شرق وسط أفريقيا؛ يرتبط ارتباطاً وثيقاً بالشمبانزي المركزي)",
 "eastern chinquapin": "شينكابين, كستناء قزمية (شجرة كستناء شجيرية من جنوب شرق الولايات المتحدة لها جوز صغير صالح للأكل)",
 "eastern chipmunk": "صيدناني شرقي (سنجاب أمريكي شرقي صغير مخطط شبه أرضي ذو جيوب خدية)",
 "eastern church": "الكنيسة البيزنطية, الكنيسة الشرقية (الكنيسة الكاثوليكية كما كانت موجودة في الإمبراطورية البيزنطية) / الكنيسة الأرثوذكسية, الكنيسة الأرثوذكسية الشرقية (مشتقة من الكنيسة البيزنطية وتلتزم بالطقوس البيزنطية)",
 "eastern coral snake": "ثعبان مرجاني شرقي (يمتد نطاقه من أمريكا الوسطى إلى جنوب شرق الولايات المتحدة)",
 "eastern cottontail": "أرنب قطني الذيل الشرقي (واسع الانتشار في الولايات المتحدة باستثناء المناطق الشمالية الغربية والغربية البعيدة)",
 "eastern cottonwood": "خشب القطن الشرقي (حور شائع في شرق ووسط الولايات المتحدة؛ يزرع في الولايات المتحدة لنموه السريع وأوراقه الغزيرة وفي أوروبا للخشب)",
 "eastern cricket frog": "ضفدع الصرصور الشرقي (ضفدع صرصور من شرق الولايات المتحدة)",
 "eastern dasyure": "دصيور شرقي (نوع من الدصيور)",
 "eastern europe": "أُورُوبَّا الشَّرْقِيَّة (الجزء من يوراسيا الذي يقع غرب جبال الأورال، والمعتبر تقليديًّا قارة بحد ذاته، كما يقع شمال قارة إفريقيا، وغرب قارة آسيا، وشرق المحيط الأطلسي؛ كيان سياسي؛ الاتحاد الأوروبي)\nمثال: ذهبت إلى أوروبا مرة.",
 "eastern fence lizard": "سحلية السياج الشرقية (سحلية نشطة صغيرة تعيش في الولايات المتحدة وشمالاً حتى كولومبيا البريطانية)",
 "eastern flowering dogwood": "قرانيا بيضاء شائعة, قرانيا مزهرة شرقية (شجرة نفضية؛ تشتهر بقناباتها البيضاء أو الوردية الكبيرة ولونها الخريفي المذهل الذي يتبعه توت أحمر)",
 "eastern fox squirrel": "سنجاب الثعلب (سنجاب شجري كبير بشكل استثنائي من شرق الولايات المتحدة)",
 "eastern gray squirrel": "سنجاب رمادي شرقي (سنجاب متوسط إلى كبير شائع في شرق أمريكا الشمالية؛ أُدخل الآن إلى إنجلترا)",
 "eastern green mamba": "مامبا سوداء (مامبا من جنوب أفريقيا شديدة السمية يُخشى منها بسبب سرعتها واستعدادها للعض)",
 "eastern grey squirrel": "سنجاب رمادي شرقي (سنجاب متوسط إلى كبير شائع في شرق أمريكا الشمالية؛ أُدخل الآن إلى إنجلترا)",
 "eastern ground snake": "ثعبان الأرض الشرقي (ثعبان صغير رمادي محمر من شرق أمريكا الشمالية)",
 "eastern hemisphere": "المشرق, نصف الكرة الشرقي (نصف الكرة الذي يشمل أوراسيا وأفريقيا وأستراليا)",
 "eastern hemlock": "تسوغا شرقية, تسوغا كندية (شجرة غابات شائعة في شرق الولايات المتحدة وكندا؛ تستخدم خاصة لخشب اللب)",
 "eastern hop hornbeam": "خشب الحديد, ممران شجرة الجنجل الشرقي (ممران شجرة الجنجل متوسط الحجم من شرق أمريكا الشمالية)",
 "eastern indigo snake": "ثعبان النيلي الشرقي (نوع من الثعبان النيلي)",
 "eastern kingbird": "ملك الطيور الشرقي (طائر يتكاثر في أمريكا الشمالية ويشتي في أمريكا الاستوائية؛ يتميز بشريط أبيض على طرف الذيل)",
 "eastern lowland gorilla": "غوريلا السهول الشرقية",
 "eastern malayo-polynesian": "اللغات الأوقيانوسية (عائلة فرعية شرقية من اللغات الملايو بولينيزية)",
 "eastern meadowlark": "قبرة المروج الشرقية (قبرة مروج من شرق أمريكا الشمالية)",
 "eastern narrow-mouthed toad": "علجوم ضيق الفم الشرقي (علجوم صغير من جنوب شرق الولايات المتحدة)",
 "eastern orthodox": "أرثوذكسي (من أو يتعلق بالكنيسة الأرثوذكسية الشرقية أو يتميز بها) / الكنيسة الأرثوذكسية, الكنيسة الأرثوذكسية الشرقية (مشتقة من الكنيسة البيزنطية وتلتزم بالطقوس البيزنطية)",
 "eastern orthodox church": "أُرْثُوذُكْسِيَّة شَرْقِيَّة (أرثوذكسيَّة)",
 "eastern pasque flower": "زهرة الفصح الأمريكية, شقائق النعمان البراري (نبات معمر قصير مشعر ذو أزهار زرقاء بنفسجية أو ليلكية في أوائل الربيع؛ أمريكا الشمالية وسيبيريا)",
 "eastern pipistrel": "خفاش بيبيستريل شرقي (أحد أصغر الخفافيش في شرق أمريكا الشمالية)",
 "eastern poison oak": "بلوط سام شرقي (شجيرة سامة في جنوب شرق الولايات المتحدة تسبب طفحاً جلدياً عند اللمس)",
 "eastern province": "الْمِنْطَقَة الشَرْقِيَّة, الشَرْقِيَّة",
 "eastern red cedar": "عرعر أحمر شرقي (عرعر صغير يوجد شرق جبال روكي له تاج مخروطي ولحاء بني يتقشر في شرائح وإبر صغيرة حادة)",
 "eastern red-backed salamander": "سمندل أحمر الظهر الشرقي (سمندل شائع في شرق أمريكا الشمالية)",
 "eastern silvery aster": "أستر فضي شرقي",
 "eastern sioux": "سانتي (فرد من الفرع الشرقي للسيوكس)",
 "eastern spruce": "تنوب أحمر (تنوب متوسط الحجم من شرق أمريكا الشمالية؛ تنوب الخشب الرئيسي في المنطقة؛ ومصدر لخشب اللب)",
 "eastern standard time": "توقيت المنطقة الشرقية (التوقيت القياسي في المنطقة الزمنية الخامسة غرب غرينتش، يحسب عند خط الطول 75؛ يستخدم في شرق الولايات المتحدة)",
 "eastern time": "توقيت المنطقة الشرقية (التوقيت القياسي في المنطقة الزمنية الخامسة غرب غرينتش، يحسب عند خط الطول 75؛ يستخدم في شرق الولايات المتحدة)",
 "eastern turki": "التركية الشرقية, الجغتائية (لغة أدبية تركية لوسط آسيا في العصور الوسطى (سميت باسم أحد أبناء جنكيز خان))",
 "eastern turki language": "التركية الشرقية, الجغتائية (لغة أدبية تركية لوسط آسيا في العصور الوسطى (سميت باسم أحد أبناء جنكيز خان))",
 "eastern white pine": "صنوبر أبيض أمريكي, صنوبر أبيض شرقي (صنوبر طويل النمو من شرق أمريكا الشمالية؛ اللحاء بني بشقوق طولية عند النضج؛ يقدر كشجرة خشب)",
 "eastern woodrat": "جرذ الخشب الشرقي (جرذ خشب بني رمادي كبير من جنوب شرق الولايات المتحدة)",
 "easterner": "شرقي (أحد سكان منطقة شرقية؛ خاصة في الولايات المتحدة)",
 "easternmost": "أَقْصَى الشَّرْق (الأبعد باتّجاه الشرق)",
 "eastertide": "موسم الفصح (موسم عيد الفصح)",
 "eastmost": "أَقْصَى الشَّرْق (الأبعد باتّجاه الشرق)",
 "eastside": "فِي الجَانِبِ الشَّرْقِيّ (من الجزء الشرقيّ لمدينة ما)",
 "eastward": "بِاتِّجَاه الشَّرْق, شَرْقًا (نحو الشرق) / مُتَّجِهٌ شَرْقاً (يتحرّك نحو الشرق) / الشَّرْق (نقطة البوصلة الأصلية التي تكون عند 90 درجة)\nمثال: هاجروا شرقاً إلى السويد",
 "eastwards": "بِاتِّجَاه الشَّرْق, شَرْقًا (نحو الشرق)\nمثال: هاجروا شرقاً إلى السويد",
 "easy": "سَهْل (ضد الصَعْب، اليَسِير. لا جمع له؛ الشيء المُمَهَّد اللَيِّن. لا جمع له)\nمثال: هذا الشعور سهل.",
 "easy chair": "كرسي استرخاء, كرسي مريح (كرسي بذراعين منجد ومريح)",
 "easy going": "تقدم سهل, طريق ممهد (تقدم سهل غير معاق)\nمثال: بعد أن قمنا بحل تلك المشكلة، كان الباقي سهلاً وممهداً",
 "easy lay": "إكستاسي سائل, غوب (أسماء دارجة لـ جاما هيدروكسي بيوتيريت)",
 "easy mark": "فريسة سهلة, هدف سهل (ضحية بلا دفاع)",
 "easy money": "كسب يسير, مال سهل (دخل يتم الحصول عليه بحد أدنى من الجهد) / المال السهل (الحالة الاقتصادية التي يكون فيها الحصول على الائتمان سهلاً)",
 "easy street": "بحبوحة, رغد العيش (أمان مالي)",
 "easygoing": "مُتَسَاهِل, مُرِيح (مُسْتَرْخٍ وَغَيْرُ رَسْمِيٍّ فِي المَوْقِفِ أَوِ المَعَايِير) / مُرِيح, هَيِّن (لَيْسَ مُرْهِقًا أَوْ مُتَطَلِّبًا؛ يُنْجَز بِسُهُولَة وَبِدُون مَشَقَّة) / مُسْتَرْسِل, هَادِئ (غير مُتعجّل ولا قسريّ)",
 "easygoingness": "بساطة, تساهل (الخلو من القلق أو الاهتمام المفرط)",
 "eat": "أَكَلَ : يَأْكُلُ, كَلْ (تَنَاوَلَ الطَّعَام، وَضَعَه في فمِه ثُم مَضَغَه ثُم بَلَعَه؛ أَفْنَى الشيء ولَم يبقِ منه)\nمثال: أحب أكل البطيخ.",
 "eat away": "أَبْلَى, أَهْلَكَ (فعل بجهد ومشقة، أصلها إجتاز البلاء؛ قد تكون بمعنى بَلِي؛ قدم وأَخْلَقَ)\nمثال: أبلى في الامتحان بلاء حسنا.",
 "eat shit": "كُلْ خِرَاء, كُلِي خِرَاء",
 "eat the rich": "كلوا الأغنياء",
 "eatable": "صالح للأكل, مأكول (مناسب للاستخدام كطعام) / طعام, مأكولات (أي مادة يمكن استخدامها كطعام)",
 "eatage": "حشيش, كلأ (طعام ضخم الحجم مثل العشب أو التبن للخيول أو الماشية التي ترعى)",
 "eater": "آكِل (أكل معه؛ آكَلَه الشيءَ: أَطعمه إِياه)\nمثال: لا آكل الفواكه.",
 "eatery": "مطعم, مكان للأكل (مبنى يذهب الناس إليه لتناول الطعام)",
 "eating": "أَكْل (تَنَاوَلَ الطَّعَام، وَضَعَه في فمِه ثُم مَضَغَه ثُم بَلَعَه؛ أَفْنَى الشيء ولَم يبقِ منه)\nمثال: أحب أكل البطيخ.",
 "eating apple": "تُفَّاح المَائِدة (شجر فاكهة من الفصيلة الوردية؛ ثمر شجر التفاح)\nمثال: هذه تفاحة أيضا.",
 "eating away": "تعرية, نحت ((في الجيولوجيا) العملية الميكانيكية لتآكل أو طحن شيء ما (كما يحدث عند غسل الجسيمات له)، وتستخدم مجازياً أيضاً)",
 "eating disorder": "اضطراب الأكل (اضطراب في روتين الأكل الطبيعي)",
 "eating habit": "عَادَات اَلْأَكْل",
 "eating house": "مطعم, مكان للأكل (مبنى يذهب الناس إليه لتناول الطعام)",
 "eating place": "مطعم, مكان للأكل (مبنى يذهب الناس إليه لتناول الطعام)",
 "eating utensil": "أدوات الأكل, أدوات المائدة القاطعة (أدوات المائدة لتقطيع وتناول الطعام)",
 "eaton-lambert syndrome": "متلازمة لامبرت-إيتون (مرض يظهر لدى مرضى سرطان الرئة ويتميز بضعف وإعياء عضلات الورك والفخذ)",
 "eats": "أكل, طعام (مصطلحات غير رسمية تعني وجبة أو طعام)",
 "eau de cologne": "كولونيا, ماء الكولونيا (سائل معطر مصنوع من الزيوت الأساسية والكحول)",
 "eau de cologne mint": "نعناع البرغموت, نعناع ليموني (نعناع بأوراق لها عطر يشبه عطر برتقال البرغموت)",
 "eau de javelle": "ماء جافيل (محلول مائي من هيبوكلوريت الصوديوم)",
 "eau de toilette": "ماء تواليت (سائل معطر أخف تركيزاً من الكولونيا)",
 "eau de vie": "أو دو في (براندي خشن وقوي)",
 "eaves": "طُنْف",
 "eavesdrop": "تَنَصَّتَ, تَسَمَّعَ",
 "eavesdropper": "متصنت (مستمع سري للمحادثات الخاصة)",
 "eavesdropping": "تَنَصُّت, اِسْتِرَاق سَمْع / تَنَصُّت",
 "eavestrough": "مِرْزَاب",
 "eb": "إكسابايت, إكسبي بايت (وحدة معلومات تساوي 1024 بيبي بايت أو 2 أس 60 بايت) / إكسابايت (وحدة معلومات تساوي 1000 بيتابايت أو 10 أس 18 بايت) / إكسابت (وحدة معلومات تساوي 1000 بيتابت أو 10 أس 18 بت)",
 "ebay": "إِيبَاي",
 "ebb": "انحسار, جزر (التدفق الخارجي للمد) / انحسار, تضاؤل (انخفاض تدريجي (في الحجم أو القوة أو السلطة أو العدد))",
 "ebbing": "انحسار, تضاؤل (انخفاض تدريجي (في الحجم أو القوة أو السلطة أو العدد))",
 "ebbtide": "انحسار, جزر (المد أثناء تدفق المياه للخارج)",
 "ebionite": "إبيوني (مكون من أو متعلق بالإبيونيين أو دينهم) / أبيوني, ناصري (عضو في مجموعة من اليهود الذين قبلوا يسوع كالمسيح (خلال التاريخ المبكر للكنيسة المسيحية)؛ قبلوا إنجيل متى لكنهم رفضوا رسائل القديس بولس واستمروا في…)",
 "ebit": "إكسابت (وحدة معلومات تساوي 1000 بيتابت أو 10 أس 18 بت)",
 "ebitda": "إبيتدا, الأرباح قبل الفوائد والضرائب والإهلاك والاستهلاك (الدخل قبل طرح الفوائد والضرائب والإهلاك والاستهلاك؛ مؤشر لربحية الشركة يراقبه المستثمرون (خاصة في عمليات الاستحواذ بالرافعة المالية))",
 "ebla": "إِبْلَا",
 "eblis": "إبليس ((الإسلام) الجني الشرير الرئيسي في التراث الإسلامي)",
 "ebn": "الشَّرْق المَائِل لِلشَّمَال, شَرْق لِشَمَال (نقطة البوصلة التي تقع شمال الشرق بنقطة واحدة)",
 "ebola": "إِيبُولَا",
 "ebola fever": "حُمَّى اَلْإِيبُولَا (حمَى الشيءُ فلانًا: منَعه ودفع عنه؛ حمى المريضَ: منعه ما يضره)\nمثال: ليس لديك أي حمى.",
 "ebola hemorrhagic fever": "إيبولا, حمى إيبولا (مرض شديد وغالباً مميت في البشر والرئيسيات يسببه فيروس إيبولا)",
 "ebola virus": "فِيرُوس إِيبُولَا",
 "ebon": "أَسْوَد أَبَنُوسِيّ (بلون أسود داكن جداً كلون الأبنوس)",
 "ebonics": "إيبونيكس, الإنجليزية الأمريكية الأفريقية (شكل غير قياسي من الإنجليزية الأمريكية يتحدث به بشكل مميز الأمريكيون من أصل أفريقي في الولايات المتحدة)",
 "ebonite": "إِبُونِيت",
 "ebony": "آبَنُوس",
 "ebony spleenwort": "طحال الأبنوس (سرخس أمريكي شمالي شائع بخطوط سوداء مصقولة)",
 "ebony tree": "أبنوس, شجرة الأبنوس (شجرة استوائية من جنوب آسيا ذات خشب قلب داكن صلب يستخدم في صناعة الخزائن)",
 "ebracteate": "عديم القنابة (بدون قنابات (أوراق نباتية متحورة))",
 "ebro": "إِيبْرُو",
 "ebs": "الشَّرْق المَائِل لِلجَنُوب, شَرْق لِجَنُوب (نقطة البوصلة التي تقع جنوب الشرق بنقطة واحدة)",
 "ebullience": "حماس, غزارة (فائض بالمتعة أو الاستحسان الشديد)",
 "ebullient": "فَيَّاض, مُتَدَفِّق (طافح بالفرح والحيويّة بلا قيود)",
 "ebulliently": "بِجَيَّاشِيَّة, بِحَمَاسَة (بطريقة مفعمة بالحيوية)\nمثال: وعد خروتشوف بحماسة بتوفير صواريخ لحماية كوبا من العدوان الأمريكي",
 "ebullition": "انفجار, تدفق عاطفي (تعبير غير مقيد عن العاطفة)",
 "eburnation": "تصلب العظام, تعاج (تغيير يحدث في أمراض المفاصل التنكسية حيث يتحول العظم إلى مادة ناعمة كثيفة تشبه العاج)",
 "eburophyton austinae": "أوركيد الثلج, أوركيد الشبح (نبات أبيض شمعي عديم الأوراق تقريباً بسيقان في مجموعات وعناقيد من الزهور البيضاء؛ شمال غرب الولايات المتحدة إلى شمال كاليفورنيا وشرقاً إلى أيداهو)",
 "ebv": "فيروس إبشتاين-بار (فيروس هربس يسبب كثرة الوحيدات العدوائية؛ ويرتبط بسرطانات محددة في أفريقيا والصين)",
 "ec": "الاتحاد الأوروبي, السوق الأوروبية المشتركة (منظمة دولية للدول الأوروبية تشكلت بعد الحرب العالمية الثانية لتقليل الحواجز التجارية وزيادة التعاون بين أعضائها)\nمثال: حاول إدخال بريطانيا في الاتحاد الأوروبي",
 "ecarte": "إيكارتيه (لعبة ورق للاعبين اثنين؛ تُلعب بـ 32 ورقة والملك هو الأعلى)",
 "ecballium elaterium": "فقوس الحمار, قثاء الحمار (كرمة متوسطية ذات ثمار مستطيلة تطرد بذورها وعصيرها بعنف عند النضج عند لمسها)",
 "ecc": "رمز تصحيح الخطأ ((الأتصالات) نظام تشفير يدمج بتات تماثل إضافية من أجل اكتشاف الأخطاء)",
 "ecce homo": "إيكه هومو, هذا هو الرجل (تمثيل (صورة أو نحت) ليسوع يرتدي إكليلاً من الشوك)",
 "eccentric": "لامتراكز, منحرف المركز (ليس له مركز مشترك؛ غير متحد المركز) / شَاذّ, عَجِيب (غَيْرُ تَقْلِيدِيٍّ أَوْ غَيْرُ مَأْلُوفٍ بِشَكْلٍ لَافِتٍ لِلنَّظَر) / شخصية, غريب الأطوار (شخص من نوع محدد (عادة ما يكون لديه العديد من الغرابة)) / غَرِيب الْأَطْوَار (شخص ذو شخصية غير عادية أو غريبة)\nمثال: دوائر لامتراكزة",
 "eccentric person": "غَرِيب الْأَطْوَار (شخص ذو شخصية غير عادية أو غريبة)",
 "eccentrically": "لامركزياً (ليس بشكل متماثل بالنسبة للمركز) / بشكل شاذ, بغرابة أطوار (بطريقة غريبة الأطوار)",
 "eccentricity": "غَرَابَة الأَطْوَار (سلوك غريب وغير تقليدي) / لا مركزية (دائرية لها مركز مختلف أو تنحرف عن مسار دائري) / اِخْتِلَاف مَرْكَزِيّ, لَا مَرْكَزِيَّة ((الهندسة) نسبة تصف شكل القطع المخروطي؛ نسبة المسافة بين البؤرتين إلى طول المحور الأكبر)\nمثال: الدائرة هي قطع ناقص ذو اختلاف مركزي صفري",
 "ecchymosis": "ازرقاق, كدمة (هروب الدم من الأوعية الدموية الممزقة إلى الأنسجة المحيطة لتكوين بقعة أرجوانية أو سوداء وزرقاء على الجلد) / كدمة دموية (المنطقة الأرجوانية أو الزرقاء المسودة الناتجة عن الكدمة)",
 "eccles cake": "كعكة إكليس (كعكة مستديرة مسطحة من المعجنات المحلاة محشوة بالفواكه المجففة)",
 "ecclesiastes": "ﺍﻟﺠَﺎﻣِﻌَﺔ, سِفْرُ الجَامِعَة",
 "ecclesiastic": "كنسي (متعلق بالكنيسة (خاصة الكنيسة المسيحية) أو مرتبط بها) / إكليريكي, رجل دين (قس أو شخص آخر في السلك الكهنوتي)\nمثال: تاريخ كنسي",
 "ecclesiastical": "كَنْسِيّ",
 "ecclesiastical attire": "زي كنسي (الزي المناسب للارتداء في الكنيسة)",
 "ecclesiastical benefice": "منصب كنسي, وقف كنسي (منصب كنسي ممنوح يوفر دخلاً لحامله)",
 "ecclesiastical calendar": "تقويم كنسي (تقويم للسنة المسيحية يشير إلى تواريخ الصيام والأعياد)",
 "ecclesiastical law": "قانون كنسي (مجموعة القوانين المدونة التي تحكم شؤون الكنيسة المسيحية)",
 "ecclesiastical mode": "مقام كنسي (أي من نظام المقامات المستخدمة في التراتيل الغريغورية حتى عام 1600؛ مشتق تاريخياً من المقام اليوناني)",
 "ecclesiastical province": "أبرشية كبرى, مقاطعة كنسية (المنطقة الخاضعة لولاية رئيس أساقفة أو مطران أو أحد التقسيمات الإقليمية لنظام كنسي)\nمثال: الولايات المتحدة مقسمة إلى 33 مقاطعة كنسية",
 "ecclesiastical robe": "زي كنسي (الزي المناسب للارتداء في الكنيسة)",
 "ecclesiastically": "كَنَسِيًّا (بطريقة كنسية)\nمثال: تمت المصادقة على المرشح كنسياً",
 "ecclesiasticism": "تعلق بالكهنوت, تمسك بالشكليات الكنسية (التمسك المفرط بالأشكال والأنشطة الكنسية) / كهنوتية, نظام كنسي (الدين المناسب للكنيسة والمبادئ والممارسات الكنسية)\nمثال: طغى تعلقهم بالكهنوت على دينهم",
 "ecclesiasticus": "سِفْر يَشُوع بِن سِيرَاخ (السَّفَرُ : قَطْعُ المسافة؛ هو مِنِّي سفَرٌ : بعيد)\nمثال: صاحبته في السفر.",
 "ecclesiology": "علم الكنيسة (فرع اللاهوت المعني بطبيعة الكنيسة وتكوينها ووظائفها)",
 "eccm": "إجراءات إلكترونية مضادة للمضادات (حرب إلكترونية تهدف لضمان الاستخدام الفعال للطيف الكهرومغناطيسي من قبل القوات الصديقة رغم استخدام العدو للحرب الإلكترونية)",
 "eccrine": "نَاتِح ((للغدد خارجية الإفراز) تنتج إفرازاً مائياً صافياً دون إطلاق جزء من الخلية المفرزة؛ مهم في تنظيم درجة حرارة الجسم)",
 "eccrine gland": "غدة ناتحة (غدة عرقية صغيرة تنتج سائلاً فقط؛ تقتصر على جلد الإنسان)",
 "eccyesis": "حمل خارج الرحم, حمل منتبذ (حمل ناتج عن نمو الجنين في مكان آخر غير الرحم)",
 "ecdemic": "وافد (من أو يتعلق بمرض ينشأ خارج المنطقة التي يحدث فيها)",
 "ecdysiast": "راقصة تعري, متعرية (فنانة تقدم ترفيهاً مثيراً بخلع الملابس على أنغام الموسيقى)",
 "ecdysis": "انسلاخ, طرح الريش (الانسلاخ الدوري للبشرة في المفصليات أو الجلد الخارجي في الزواحف)",
 "ecdysteroid": "إكديستيرويد (يشير الاسم إلى هرمونات الانسلاخ والجنس للحشرات والتي تشمل الإيكديسون ونظائره)",
 "ecesis": "توطن ((في علم البيئة) العملية التي يستقر بها نبات أو حيوان في موطن جديد)",
 "ecf": "سائل خارج خلوي (سائل يحتوي على بروتينات وإلكتروليتات بما في ذلك السائل في بلازما الدم والسائل الخلالي)\nمثال: يحتوي الجسم عادة على حوالي 15 لتراً من السائل خارج الخلوي",
 "ecg": "تخطيط القلب, مخطط كهربية القلب (تسجيل بياني للدورة القلبية ينتجه جهاز تخطيط كهربية القلب)",
 "echelon": "محزز الحيود المتدرج (محزز حيود يتكون من كومة من الصفائح متساوية السمك مرتبة بشكل متدرج مع إزاحة ثابتة) / نسق (هيئة من القوات مرتبة في خط) / درجة, رتبة (المكانة في مجتمع أو منظمة)\nمثال: الرتب العليا",
 "echeneis naucrates": "ماصة القرش (ريمورا توجد ملتصقة بأسماك القرش)",
 "echidna": "إِيكِيدْنَا, نَضْناض",
 "echidnophaga gallinacea": "برغوث الدجاج (طفيلي يتواجد خاصة على رؤوس الدجاج)",
 "echinocactus": "صبار البرميل, صبار القنفذ (أي صبار من جنس القنفذ؛ مضلع بقوة وشائك جداً؛ جنوب غرب الولايات المتحدة إلى البرازيل)",
 "echinocactus grusonii": "صبار البرميل الذهبي, كرسي الحماة (صبار كبير من شرق وسط المكسيك له زهور وأشواك ذهبية إلى صفراء شاحبة)",
 "echinochloa crusgalli": "إكينوكلوا, دخن الحظيرة (عشب ذعر حولي خشن؛ عشبة ضارة عالمية؛ تستخدم أحياناً للتبن أو الرعي)",
 "echinochloa frumentacea": "دخن ياباني (عشب حولي خشن يزرع في اليابان وجنوب شرق آسيا لبذوره الصالحة للأكل وللعلف؛ غذاء مهم للحياة البرية في الولايات المتحدة)",
 "echinococcosis": "داء المشوكات, كيسات عذرية (الإصابة بيرقات المشوكات (الديدان الشريطية))",
 "echinococcus": "مشوكة (ديدان شريطية تتطفل يرقاتها في البشر والحيوانات الأليفة)",
 "echinoderm": "شوكيات الجلد (لافقاريات بحرية ذات أقدام أنبوبية وأجسام متناظرة شعاعياً خماسية الأجزاء)",
 "echinoderm family": "فصيلة شوكيات الجلد (فصيلة من شوكيات الجلد)",
 "echinoderm genus": "جنس شوكيات الجلد (جنس من شوكيات الجلد)",
 "echinus": "إكينوس (إطار أوفولو بين العمود والتاج في العمود الدوري)",
 "echinus esculentus": "قنفذ البحر الصالح للأكل (قنفذ بحر يمكن أكله)",
 "echium vulgare": "زهرة الأفعى, شوك أزرق (عشب أوروبي شائك خشن بسنابل من الزهور الزرقاء؛ مستوطن في الولايات المتحدة)",
 "echo": "صَدًى",
 "echo chamber": "غُرْفَة الصَّدَى (اسم مفعول لما غُرِفَ من الماء وغيره باليد، الجمع غِرَاف؛ اسم؛ المكان في الدار أو المبنى محاط بأربع جدران وسقف، حُجْرَة، عِلِّيَّة. الجمع وغُرَف وغُرُفَات)\nمثال: الأب في الغرفة.",
 "echo sounder": "سونار, مسبار الصدى (أداة قياس ترسل نبضة صوتية في الماء وتقيس المسافات من حيث الوقت الذي يستغرقه صدى النبضة للعودة)",
 "echo sounding": "تحديد الموقع بالصدى (تحديد موقع شيء ما عن طريق قياس الوقت الذي يستغرقه الصدى للعودة منه)",
 "echocardiogram": "مخطط صدى القلب (صورة بيانية للقلب منتجة بواسطة جهاز تخطيط صدى القلب)",
 "echocardiograph": "جهاز تخطيط صدى القلب (جهاز سونار ينشئ صورة للقلب وتشوهاته)",
 "echocardiography": "تخطيط صدى القلب (إجراء تشخيصي غير جراحي يستخدم الموجات فوق الصوتية لدراسة بنية وحركات القلب)",
 "echoencephalogram": "مخطط صدى الدماغ (صورة بيانية للدماغ منتجة بواسطة جهاز تخطيط صدى الدماغ)",
 "echoencephalograph": "جهاز تخطيط صدى الدماغ (جهاز سونار ينشئ صورة للدماغ وتشوهاته)",
 "echoencephalography": "تخطيط صدى الدماغ (إجراء تشخيصي غير جراحي يستخدم الموجات فوق الصوتية لدراسة تشريح الدماغ)",
 "echogram": "سونار, مخطط صدى الصوت (صورة لهيكل يتم إنتاجها بواسطة الموجات فوق الصوتية (انعكاسات الموجات الصوتية عالية التردد)؛ تستخدم لمراقبة نمو الجنين أو دراسة أعضاء الجسم)",
 "echograph": "جهاز تخطيط الصدى (أداة تستخدم لتسجيل مخطط الصدى)",
 "echography": "تصوير بالموجات فوق الصوتية, سونار (استخدام انعكاسات الموجات الصوتية عالية التردد لبناء صورة لعضو من أعضاء الجسم؛ يُستخدم عادة لمراقبة نمو الجنين أو دراسة أعضاء الجسم)",
 "echoic": "صوتي, محاكٍ للصوت ((للكلمات) مشكلة تقليداً لصوت طبيعي) / صَدَوِيّ (شبيه بالصدى أو من خصائصه)\nمثال: الكلمات المحاكية للأصوات تقلد الضوضاء",
 "echolalia": "ترديد مرضي, مصاداة ((طب نفسي) تكرار ميكانيكي وبلا معنى لكلمات شخص آخر (كما في الفصام)) / إيكولاليا, محاكاة لفظية (تكرار الرضيع للأصوات التي ينطق بها الآخرون)",
 "echoless": "عَدِيمُ الصَّدَى (لا يُنتِج أو لا يملك صدى)",
 "echolike": "صَدَوِيّ (شبيه بالصدى أو من خصائصه)",
 "echolocation": "تحديد الموقع بالصدى (تحديد موقع شيء ما عن طريق قياس الوقت الذي يستغرقه الصدى للعودة منه)",
 "echovirus": "فيروس إيكو (أي من مجموعة فيروسات مرتبطة بأمراض مختلفة بما في ذلك التهاب السحايا الفيروسي واضطرابات الجهاز التنفسي الخفيفة والإسهال عند الأطفال حديثي الولادة)",
 "echt": "أصلي, حقيقي (ليس مزيفاً أو مقلداً)\nمثال: لوحة بيكاسو أصلية",
 "eclair": "إكلير (فطيرة كريمة مستطيلة الشكل)",
 "eclampsia": "ارتعاج, تشنج الحمل (حالة سامة تتميز بتشنجات وربما غيبوبة أثناء الحمل أو بعده مباشرة)",
 "eclat": "تَأَلُّق, نَجَاح بَاهِر (نجاح أو تأثير باهر أو لافت للنظر) / أُبَّهَة, مَوْكِب فَخْم (الأناقة والفخامة الاحتفالية) / إشادة, استحسان (موافقة حماسية)\nمثال: تألق إنجاز عظيم",
 "eclectic": "اِنْتِقَائِيّ, تَوْفِيقِيّ (يَخْتَار مَا يَبْدُو أَفْضَل مِنْ أَسَالِيب أَوْ أَفْكَار مُتَنَوِّعَة) / انتقائي (شخص يختار وفقاً للمنهج الانتقائي)",
 "eclectic method": "انتقائية (اتخاذ القرارات بناءً على ما يبدو أفضل بدلاً من اتباع مذهب أو أسلوب واحد)",
 "eclecticism": "انتقائية (اتخاذ القرارات بناءً على ما يبدو أفضل بدلاً من اتباع مذهب أو أسلوب واحد)",
 "eclecticist": "انتقائي (شخص يختار وفقاً للمنهج الانتقائي)",
 "eclipse": "كُسُوف, خُسُوف",
 "eclipsis": "إضمار, حذف (حذف أو كبت أجزاء من الكلمات أو الجمل)",
 "eclipta": "مُنْكَسِفَة",
 "ecliptic": "مَسَارُ الشَّمْسِ (المَسَار: اسم مكان من سارَ : مسلك ، طريق ؛ خَطُّ السَّيْر؛ مَسَار كوكب حول الشَّمس : مدار)\nمثال: هذا من شأنه أن يضع العاصفة في مسار تصادم افتراضي مع بركان كيلويا ، في الجزء الجنوبي من الجزيرة.",
 "eclogue": "أنشودة ريفية, قصيدة رعوية (قصيدة قصيرة تصف الحياة الريفية أو الرعوية)",
 "ecm": "إجراءات إلكترونية مضادة (حرب إلكترونية يتم القيام بها لمنع أو تقليل الاستخدام الفعال للعدو للطيف الكهرومغناطيسي)",
 "eco-warfare": "إرهاب بيئي (عنف يتم تنفيذه لتعزيز الأهداف السياسية أو الاجتماعية لعلماء البيئة)",
 "ecobabble": "ثرثرة بيئية (استخدام اللغة التقنية لعلم البيئة لجعل المستخدم يبدو واعياً بيئياً)",
 "ecocide": "إِبَادَة بِيئِيَّة",
 "ecofriendly": "أَخْضَر, صَدِيقٌ لِلْبِيئَةِ (مُفِيدٌ لِلْبِيئَةِ وَغَيْرُ مُضِرٍّ بِهَا)",
 "ecologic": "إيكولوجي, بيئي (متعلق بعلم البيئة (الإيكولوجيا)) / بيئي (يتميز بالترابط بين الكائنات الحية في بيئة ما)\nمثال: بحث بيئي",
 "ecological": "بِيئِيّ, إِيكُولُوجِيّ",
 "ecological niche": "تخصص بيئي, مكانة بيئية ((علم البيئة) وضع الكائن الحي داخل بيئته ومجتمعه (الذي يؤثر على بقائه كنوع))",
 "ecological succession": "تتابع, تعاقب بيئي ((في علم البيئة) عملية التغيير التدريجي والمنظم في نظام بيئي ناتجة عن الاستبدال التدريجي لمجتمع بآخر حتى يتم إنشاء مجتمع ذروة مستقر)",
 "ecological terrorism": "إرهاب بيئي (عنف يتم تنفيذه لتعزيز الأهداف السياسية أو الاجتماعية لعلماء البيئة)",
 "ecological warfare": "إرهاب بيئي (عنف يتم تنفيذه لتعزيز الأهداف السياسية أو الاجتماعية لعلماء البيئة)",
 "ecologically": "بِيئِيًّا, مِن النَّاحِيَة البِيئِيَّة (فيما يتعلق بالبيئة)\nمثال: بيئياً، هذه الفكرة رائعة؛ اقتصادياً، هي كارثة",
 "ecologist": "عالم بيئة (عالم أحياء يدرس العلاقة بين الكائنات الحية وبيئتها)",
 "ecology": "عِلْم اَلْبِيئَة (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "econometric": "اقتصادي قياسي (متعلق بالاقتصاد القياسي)\nمثال: نظريات الاقتصاد القياسي",
 "econometrician": "خبير قياس اقتصادي (اقتصادي يستخدم الأساليب الإحصائية والرياضية)",
 "econometrics": "اقتصاد قياسي (تطبيق الرياضيات والإحصاء لدراسة البيانات الاقتصادية والمالية)",
 "econometrist": "خبير قياس اقتصادي (اقتصادي يستخدم الأساليب الإحصائية والرياضية)",
 "economic": "اِقْتِصَادِيّ",
 "economic aid": "إعانة, دعم اقتصادي (هبة مالية أو مساعدة مادية أخرى لدعم شخص أو قضية)\nمثال: مساعدة اقتصادية للمناطق الكاسدة",
 "economic and social council": "المجلس الاقتصادي والاجتماعي (مجلس دائم للأمم المتحدة؛ مسؤول عن الظروف الاقتصادية والاجتماعية)",
 "economic and social council commission": "لجنة المجلس الاقتصادي والاجتماعي (لجنة تابعة للمجلس الاقتصادي والاجتماعي للأمم المتحدة)",
 "economic assistance": "إعانة, دعم اقتصادي (هبة مالية أو مساعدة مادية أخرى لدعم شخص أو قضية)\nمثال: مساعدة اقتصادية للمناطق الكاسدة",
 "economic commission for africa": "اللجنة الاقتصادية لأفريقيا (لجنة المجلس الاقتصادي والاجتماعي للأمم المتحدة المعنية بالتنمية الاقتصادية للدول الأفريقية)",
 "economic commission for asia and the far east": "اللجنة الاقتصادية لآسيا والشرق الأقصى (لجنة المجلس الاقتصادي والاجتماعي للأمم المتحدة المعنية بالتنمية الاقتصادية لدول آسيا والشرق الأقصى)",
 "economic commission for europe": "اللجنة الاقتصادية لأوروبا (لجنة المجلس الاقتصادي والاجتماعي للأمم المتحدة المعنية بالتنمية الاقتصادية في أوروبا)",
 "economic commission for latin america": "اللجنة الاقتصادية لأمريكا اللاتينية (لجنة المجلس الاقتصادي والاجتماعي للأمم المتحدة المعنية بالتنمية الاقتصادية في أمريكا اللاتينية)",
 "economic condition": "حالة اقتصادية, وضع اقتصادي (حالة الاقتصاد)",
 "economic consumption": "استهلاك, استهلاك اقتصادي ((في الاقتصاد) استخدام السلع الاقتصادية لتلبية الاحتياجات أو في التصنيع)\nمثال: زاد استهلاك الطاقة بشكل مطرد",
 "economic crisis": "أزمة اقتصادية, كساد (حالة اقتصادية طويلة الأمد تتميز بالبطالة وانخفاض الأسعار ومستويات منخفضة من التجارة والاستثمار)",
 "economic development": "تنمية اقتصادية (الإجراءات المستمرة والمتضافرة لصانعي السياسات والمجتمعات التي تعزز مستوى المعيشة والصحة الاقتصادية لمنطقة معينة)\nمثال: استراتيجية التنمية الاقتصادية الخمسية هي أول خارطة طريق استراتيجية للمقاطعة لتحقيق تنمية اقتصادية مستدامة",
 "economic expert": "اقتصادي, خبير اقتصادي (خبير في علم الاقتصاد)",
 "economic geography": "جغرافيا اقتصادية (فرع الجغرافيا المعني بإنتاج وتوزيع السلع)",
 "economic geology": "جيولوجيا اقتصادية (فرع الجيولوجيا الذي يتعامل مع المواد الجيولوجية ذات القيمة الاقتصادية)",
 "economic growth": "نمو اقتصادي (نمو مطرد في القدرة الإنتاجية للاقتصاد (وبالتالي نمو الدخل القومي))",
 "economic infrastructure": "بنية تحتية اقتصادية (المرافق والأنظمة التي تخدم بلداً أو مدينة أو منطقة، والضرورية لعمل اقتصادها)",
 "economic libertarian": "تحرري اقتصادي (تحرري يدافع عن تعظيم الحقوق الفردية وتقليل دور الدولة)",
 "economic mobilisation": "تَعْبِئَة اِقْتِصَادِيَّة (تعبئة موارد الاقتصاد)",
 "economic mobilization": "تَعْبِئَة اِقْتِصَادِيَّة (تعبئة موارد الاقتصاد)",
 "economic policy": "سياسة اقتصادية (سياسة حكومية للحفاظ على النمو الاقتصادي والإيرادات الضريبية)",
 "economic process": "عملية اقتصادية (أي عملية تؤثر على إنتاج وتطوير وإدارة الثروة المادية)",
 "economic rent": "ريع, ريع اقتصادي (العائد المستمد من الأراضي المزروعة بما يزيد عن ذلك المستمد من أفقر الأراضي المزروعة في ظل ظروف مماثلة)",
 "economic science": "اقتصاد, علم الاقتصاد (فرع العلوم الاجتماعية الذي يتعامل مع إنتاج وتوزيع واستهلاك السلع والخدمات وإدارتها)",
 "economic strangulation": "خنق اقتصادي (عقاب مجموعة بقطع التعاملات التجارية معهم)",
 "economic system": "اقتصاد, نظام اقتصادي (نظام الإنتاج والتوزيع والاستهلاك)",
 "economic theory": "نظرية اقتصادية ((اقتصاد) نظرية للأنشطة التجارية (مثل إنتاج واستهلاك السلع))",
 "economic value": "قيمة, قيمة اقتصادية (المبلغ (من المال أو البضائع أو الخدمات) الذي يعتبر مكافئاً عادلاً لشيء آخر)\nمثال: حاول تقدير قيمة المنتجات بالأسعار العادية",
 "economical": "اقْتِصَادِيّ, مُوَفِّر (يستخدم الحدّ الأدنى من الوقت أو الموارد اللازمة للفاعلية) / زَاهِد, مُقْتَصِد (يَتَجَنَّبُ الإِسْرَافَ وَالهَدْر) / اقتصادي (مكون من أو متعلق بالاقتصاد، نظام الإنتاج وإدارة الثروة المادية)\nمثال: نمو اقتصادي",
 "economically": "اقتصادياً (فيما يتعلق بعلم الاقتصاد) / اقتصادياً (فيما يتعلق بالنظام الاقتصادي) / اقتصادياً, بتوفير (بطريقة مقتصدة)\nمثال: اقتصادياً هذا الاقتراح لا معنى له",
 "economics": "عِلْم الاِقْتِصَاد (أَدْرَكَ حقيقة الشيء) / اِقْتِصَاد (بمعنى واصل عمل القصائد؛ بمعنى تَوَسَّط في الانفاق فلم يسرف ولم يقتر)\nمثال: أدرس علم النفس.",
 "economics department": "قسم الاقتصاد (القسم الأكاديمي المسؤول عن التدريس والبحث في الاقتصاد)",
 "economics profession": "مهنة الاقتصاد (مجموعة الاقتصاديين المحترفين)",
 "economiser": "مقتصد (شخص مقتصد يحد من الإنفاق ويتجنب التبذير)",
 "economist": "اِقْتِصَادِيّ",
 "economize": "اِقْتَصَدَ, اِدَّخَرَ",
 "economizer": "مقتصد (شخص مقتصد يحد من الإنفاق ويتجنب التبذير)",
 "economy": "اِقْتِصَاد (بمعنى واصل عمل القصائد؛ بمعنى تَوَسَّط في الانفاق فلم يسرف ولم يقتر)\nمثال: ابني يدرس الاقتصاد.",
 "economy class": "درجة ثانية, درجة سياحية (فئة من أماكن الإقامة على متن سفينة أو قطار أو طائرة أقل تكلفة من أماكن الدرجة الأولى)",
 "economy of scale": "وفورات الحجم (التوفير في تكلفة الإنتاج الناتج عن الإنتاج الضخم)",
 "ecosoc": "المجلس الاقتصادي والاجتماعي (مجلس دائم للأمم المتحدة؛ مسؤول عن الظروف الاقتصادية والاجتماعية)",
 "ecosoc commission": "لجنة المجلس الاقتصادي والاجتماعي (لجنة تابعة للمجلس الاقتصادي والاجتماعي للأمم المتحدة)",
 "ecosystem": "نِظَام بِيئِي (مَنْهَج، طَرِيقَة؛ تَرْتِيب واتِّسَاق)\nمثال: ليس بنظام كامل.",
 "ecoterrorism": "إرهاب بيئي (عنف يتم تنفيذه لتعزيز الأهداف السياسية أو الاجتماعية لعلماء البيئة)",
 "ecotourism": "سِيَاحَة بِيئِيَّة",
 "ecphonesis": "تعجب (أداة بلاغية تعجبية)",
 "ecrevisse": "جراد البحر (جراد بحر صغير من أوروبا وآسيا وغرب أمريكا الشمالية) / استاكوزا المياه العذبة, جراد البحر (قشريات صغيرة شبيهة بالكركند تسلق عادة لفترة وجيزة)",
 "ecru": "بيج (بني فاتح جداً)",
 "ecstasy": "نَشْوَة",
 "ecstatic": "مَسْحُور, مُبْتَهِج (يشعر بنشوة أو سرور بالغ)",
 "ecstatic state": "جذبة دينية, وجد ديني (غشية ناتجة عن التفاني الديني الشديد؛ لا تظهر انخفاضاً في الوظائف الجسدية المعتادة في حالات الغشية الأخرى)",
 "ecstatically": "بِابْتِهَاج غَامِر, بِنَشْوَة (بطريقة منتشية)\nمثال: تفاعل بابتهاج غامر مع خطتي للسفر إلى أفريقيا",
 "ect": "علاج بالصدمات الكهربائية (إعطاء تيار كهربائي قوي يمر عبر الدماغ للحث على التشنجات والغيبوبة)",
 "ectasia": "تمدد وعائي, توسع (تمدد أو انتفاخ عضو مجوف)",
 "ectasis": "تمدد وعائي, توسع (تمدد أو انتفاخ عضو مجوف)",
 "ectoblast": "أديم ظاهر, الأرومة الظاهرة (الطبقة المنتشة الخارجية التي تتطور لتشكل الجلد والأنسجة العصبية)",
 "ectoderm": "أديم ظاهر, الأرومة الظاهرة (الطبقة المنتشة الخارجية التي تتطور لتشكل الجلد والأنسجة العصبية)",
 "ectodermal": "أديمي ظاهر (متعلق بالأديم الظاهر)",
 "ectodermic": "أديمي ظاهر (متعلق بالأديم الظاهر)",
 "ectomorph": "اكتومورف, نحيف البنية (شخص ذو جسد نحيل)",
 "ectomorphic": "ظاهر البنية, نحيف البنية (له بنية قليلة الدهون أو العضلات ولكن بأطراف طويلة)",
 "ectomorphy": "بنية واهنة, نحافة البنية (نحيف وضعيف وخفيف الوزن)",
 "ectoparasite": "طفيلي خارجي (أي كائن طفيلي خارجي (مثل البراغيث))",
 "ectopia": "انتباذ (موضع غير طبيعي لجزء أو عضو (خاصة وقت الولادة))",
 "ectopic": "منتبذ, هاجر (يظهر انتباذاً (وجود عضو أو نسيج في غير مكانه الطبيعي))",
 "ectopic gestation": "حمل خارج الرحم, حمل منتبذ (حمل ناتج عن نمو الجنين في مكان آخر غير الرحم)",
 "ectopic pregnancy": "حمل خارج الرحم, حمل منتبذ (حمل ناتج عن نمو الجنين في مكان آخر غير الرحم)",
 "ectopistes migratorius": "حمام مهاجر (حمامة مهاجرة اجتماعية من أمريكا الشمالية منقرضة الآن)",
 "ectoplasm": "إكتوبلازم",
 "ectoproct": "خارجي الشرج (حيوان مائي طحلبي لاطئ تكون فيه فتحة شرج السليلة خارج تاج المجسات)",
 "ectotherm": "ذوات الدم البارد, كائن متغير الحرارة (حيوان تتغير درجة حرارة جسمه مع درجة حرارة محيطه؛ أي حيوان باستثناء الطيور والثدييات)",
 "ectothermic": "بَارِد الدَّم (مُنْخَفِض الحَرارة أو حَرارتُه أقلّ من حَرارة جسْم الإنسان؛ غير حامٍ، أو متروك بلا حماوة، غير محميّ على النَّار)\nمثال: الماء بارد حقا.",
 "ectozoan": "طفيلي خارجي (أي كائن طفيلي خارجي (مثل البراغيث)) / طفيلي خارجي (من أو متعلق بالطفيليات الخارجية)",
 "ectozoon": "طفيلي خارجي (أي كائن طفيلي خارجي (مثل البراغيث))",
 "ectrodactyly": "انعدام الأصابع (تشوه خلقي ينطوي على غياب بعض أصابع اليدين أو القدمين)",
 "ects credit": "رصيد دراسي, نقطة معتمدة (نقاط تعبر عن حجم عبء العمل، تُمنح للطلاب لإكمال دورة أو ندوة أو وحدة دراسية)",
 "ects-credit point": "رصيد دراسي, نقطة معتمدة (نقاط تعبر عن حجم عبء العمل، تُمنح للطلاب لإكمال دورة أو ندوة أو وحدة دراسية)",
 "ecuador": "إِكْوَادُور, الإِكْوَادُور",
 "ecuador laurel": "دردار إسباني, كورديا (شجرة أمريكية استوائية كبيرة من جنس كورديا تزرع لزهورها البيضاء الكريمية الوفيرة وخشبها القيم)",
 "ecuadoran": "إكوادوري (مواطن أو ساكن في الإكوادور)",
 "ecuadoran monetary unit": "وحدة نقدية إكوادورية (الوحدة النقدية في الإكوادور)",
 "ecuadorian": "إكوادوري (من أو يتعلق بالإكوادور أو شعبها أو يميزهم) / إكوادوري (مواطن أو ساكن في الإكوادور)\nمثال: تراث شعبي إكوادوري",
 "ecumenic": "كَنَسِيّ جَامِع, مَسْكُونِيّ (مُهْتَمّ بتعزيز الوحدة بين الكنائس أو الأديان)",
 "ecumenical": "عَالَمِيّ, كَوْنِيّ (ذو نطاق أو تطبيق عالميّ شامل) / كَنَسِيّ جَامِع, مَسْكُونِيّ (مُهْتَمّ بتعزيز الوحدة بين الكنائس أو الأديان)",
 "ecumenical council": "مَجْمَع مَسْكُونِيّ (اسم مفعول من جَمَّعَ؛ كُلِّيَّة، جَامِعَة)\nمثال: كان سامي يعيش في مجمع مسور.",
 "ecumenical movement": "الحركة المسكونية (حركة تهدف إلى تعزيز التفاهم والتعاون بين الكنائس المسيحية؛ تهدف في النهاية إلى الوحدة المسيحية العالمية)",
 "ecumenicalism": "مسكونية ((المسيحية) عقيدة الحركة المسكونية التي تعزز التعاون والتفاهم الأفضل بين الطوائف الدينية المختلفة: تهدف إلى الوحدة المسيحية العالمية)",
 "ecumenicism": "مسكونية ((المسيحية) عقيدة الحركة المسكونية التي تعزز التعاون والتفاهم الأفضل بين الطوائف الدينية المختلفة: تهدف إلى الوحدة المسيحية العالمية)",
 "ecumenism": "مسكونية ((المسيحية) عقيدة الحركة المسكونية التي تعزز التعاون والتفاهم الأفضل بين الطوائف الدينية المختلفة: تهدف إلى الوحدة المسيحية العالمية) / الحركة المسكونية (حركة تروج للاتحاد بين الأديان (وخاصة بين الكنائس المسيحية))",
 "eczema": "أَكْزِيمَا",
 "eczema herpeticum": "إكزيما حلئية (إكزيما تتميز بحالة حمى وانتشار واسع للحويصلات؛ أكثر شيوعًا عند الأطفال)",
 "eczema hypertrophicum": "إكزيما حزازية, إكزيما مزمنة (إكزيما تتميز بسماكة الجلد مع خطوط جلدية بارزة)",
 "eczema marginatum": "حكة جوك, سعفة الفخذ (عدوى فطرية في الفخذ (الأكثر شيوعاً عند الرجال))",
 "eczema vaccinatum": "إكزيما لقاحية (مضاعفات نادرة الآن للقاح الجدري تتراكب على التهاب الجلد التاتبي مع حمى شديدة وحويصلات وحطاطات معممة)",
 "ed": "خلل الانتصاب, ضعف الانتصاب (عجز ناتج عن عدم قدرة الرجل على الحصول على انتصاب للقضيب أو الحفاظ عليه)",
 "edacious": "جَشِع, شَرِه (يلتهم الطعام أو يشتهيه بكمّيّات كبيرة)",
 "edacity": "نهم شديد (شراهة مفرطة) / شراهة, نهم (رغبة مفرطة في الأكل)",
