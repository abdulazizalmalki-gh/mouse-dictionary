 "eton jacket": "سترة إيتون (سترة تصل للخصر ومقصوصة بشكل مربع من الأسفل)",
 "etonian": "إيتوني (طالب مسجل في (أو تخرج من) كلية إيتون)",
 "etropus rimosus": "فلو ندر رمادي (سمكة مفلطحة توجد من كارولينا الشمالية إلى فلوريدا وشرق خليج المكسيك)",
 "etruscan": "إتروسكي (مواطن أو ساكن في إتروريا القديمة؛ أثر الإتروسكان على الرومان)",
 "etruscology": "علم الحضارة الإتروسكانية (دراسة الحضارة الإتروسكانية، وخاصة آثارها ولغتها)",
 "etude": "إيتود, دراسة موسيقية (تأليف قصير لآلة منفردة؛ يهدف كتمرين أو لإظهار البراعة التقنية)",
 "etui": "حافظة إبر, علبة صغيرة (حقيبة نسائية صغيرة مزخرفة للأغراض الصغيرة)",
 "etymological": "إتيمولوجي, اشتقاقي (مبني على أو ينتمي إلى علم أصول الكلمات (الإتيمولوجيا))\nمثال: رسمت مجرد تمييز اشتقاقي",
 "etymological dictionary": "قاموس اشتقاقي (قاموس يعطي الأصول التاريخية لكل كلمة)",
 "etymologist": "إتيمولوجي, عالم اشتقاق (معجمي متخصص في علم الاشتقاق (أصول الكلمات))",
 "etymologizing": "اشتقاق, تأثيل ((علم اللغة التاريخي) شرح للأصول التاريخية لكلمة أو عبارة)",
 "etymology": "اِشْتِقَاق, تَأْثِيل",
 "etymon": "أَثَلَة",
 "eu": "الاتحاد الأوروبي, السوق الأوروبية المشتركة (منظمة دولية للدول الأوروبية تشكلت بعد الحرب العالمية الثانية لتقليل الحواجز التجارية وزيادة التعاون بين أعضائها) / يوروبيوم (عنصر فلزي ثنائي وثلاثي التكافؤ من مجموعة الأتربة النادرة)\nمثال: حاول إدخال بريطانيا في الاتحاد الأوروبي",
 "euarctos americanus": "دب أسود أمريكي (دب بني إلى أسود من أمريكا الشمالية؛ أصغر وأقل شراسة من الدب البني)",
 "eubacteria": "بكتيريا حقيقية (مجموعة كبيرة من البكتيريا ذات جدران خلوية صلبة؛ الأنواع المتحركة منها تمتلك أسواطاً)",
 "eubacterium": "بكتيريا حقيقية (مجموعة كبيرة من البكتيريا ذات جدران خلوية صلبة؛ الأنواع المتحركة منها تمتلك أسواطاً)",
 "eucalypt": "أوكالبتوس, كينا (شجرة من جنس أوكالبتوس)",
 "eucalypt grandis": "صمغ الورد (شجرة طويلة جداً من كوينزلاند ونيو ساوث ويلز)",
 "eucalypt gunnii": "صمغ السيدر (شجرة صغيرة إلى متوسطة الحجم من تسمانيا)",
 "eucalypt ovata": "صمغ المستنقعات (شجرة متوسطة الحجم من جنوب أستراليا)",
 "eucalypt tereticornis": "صمغ الغابة الأحمر (شجرة طويلة من كوينزلاند ونيو ساوث ويلز وفيكتوريا)",
 "eucalyptus": "أُوكَالِبْتُوس, يُوكَالِيبْتُوس",
 "eucalyptus amygdalina": "صمغ أحمر, كينا النعناع (شجرة صمغ أحمر من تسمانيا)",
 "eucalyptus calophylla": "صمغ أحمر, ماري (شجرة صمغ أحمر كبيرة جداً)",
 "eucalyptus camaldulensis": "صمغ أحمر نهري, صمغ نهري (شجرة صمغ أحمر ملتوية نوعاً ما تنمو بشكل رئيسي على طول الأنهار؛ لها خشب محمر متين يستخدم في البناء الثقيل)",
 "eucalyptus camphora": "صمغ المستنقعات الجبلي (صمغ مستنقعات متوسط الحجم من نيو ساوث ويلز وفيكتوريا)",
 "eucalyptus citriodora": "صمغ برائحة الليمون, كينا ليمونية (تشبه الصمغ المرقط ولكنها أصغر ولها أوراق برائحة الليمون)",
 "eucalyptus coriacea": "صمغ الثلج, صمغ الشبح (شجرة صغيرة إلى متوسطة الحجم من أستراليا وتسمانيا ذات لحاء أبيض ناعم إلى رمادي فاتح يتساقط في بقع أو شرائط)",
 "eucalyptus delegatensis": "بلوط الجبل, مران ألبي (شجرة خشبية طويلة ذات خشب صلب ثقيل وردي أو بني فاتح)",
 "eucalyptus dumosa": "مالي أبيض (مالي شجيري صغير)",
 "eucalyptus eugenioides": "لحاء الخيط الأبيض (لحاء خيط له خشب أبيض)",
 "eucalyptus fraxinoides": "مران الجبل الأبيض (شجرة كبيرة ذات لحاء داكن متماسك على الجذع السفلي ولكنه أملس وأبيض في الأعلى؛ تنتج خشباً مشابهاً لخشب المران الأوروبي أو الأمريكي)",
 "eucalyptus globulus": "شجرة الحمى, صمغ أزرق (شجرة خشبية طويلة سريعة النمو ذات أوراق تحتوي على زيت طبي؛ الأوراق الصغيرة تكون زرقاء اللون)",
 "eucalyptus gum": "صمغ الكينا, كينو الكافور (إفراز صمغي مجفف بني محمر من أي من أشجار جنس الكافور)",
 "eucalyptus kino": "صمغ الكينا, كينو الكافور (إفراز صمغي مجفف بني محمر من أي من أشجار جنس الكافور)",
 "eucalyptus maculata": "صمغ مرقط (شجرة صمغ كبيرة ذات لحاء مرقط)",
 "eucalyptus maculata citriodora": "صمغ برائحة الليمون, كينا ليمونية (تشبه الصمغ المرقط ولكنها أصغر ولها أوراق برائحة الليمون)",
 "eucalyptus oil": "زيت الأوكالبتوس (زيت عطري يتم الحصول عليه من أوراق الأوكالبتوس)",
 "eucalyptus pauciflora": "صمغ الثلج, صمغ الشبح (شجرة صغيرة إلى متوسطة الحجم من أستراليا وتسمانيا ذات لحاء أبيض ناعم إلى رمادي فاتح يتساقط في بقع أو شرائط)",
 "eucalyptus regnans": "مران الجبل (شجرة لها خشب مشابه للمران الألبي؛ أطول شجرة في أستراليا وأطول شجرة خشب صلب في العالم)",
 "eucalyptus rostrata": "صمغ أحمر نهري, صمغ نهري (شجرة صمغ أحمر ملتوية نوعاً ما تنمو بشكل رئيسي على طول الأنهار؛ لها خشب محمر متين يستخدم في البناء الثقيل)",
 "eucalyptus stellulata": "مالي أسود (مالي صغير بلحاء خشن داكن اللون نحو القاعدة؛ ينتج صمغ كينو أوكالبتوس أحمر)",
 "eucalyptus tree": "أوكالبتوس, كينا (شجرة من جنس أوكالبتوس)",
 "eucalyptus viminalis": "صمغ المن (شجرة طويلة تنتج مناً كاذباً)",
 "eucarya acuminata": "خوخ الصحراء, كواندونغ (شجرة أسترالية ذات لب صالح للأكل وبذرة تشبه الجوز صالحة للأكل)",
 "eucaryote": "حقيقي النواة (كائن بخلايا مميزة لجميع أشكال الحياة باستثناء الكائنات الدقيقة البدائية مثل البكتيريا؛ أي كائن بنواة 'جيدة' أو محاطة بغشاء في خلاياه)",
 "eucaryotic": "حقيقي النواة (تمتلك خلايا ذات أنوية 'جيدة' أو محاطة بغشاء)",
 "eucerin anhydrous": "يوسيرين لا مائي (يستخدم بشكل رئيسي كقاعدة لدمج الأدوية الأخرى في حالات التهاب الجلد السطحي أو التهيج)\nمثال: يمكن استخدام اليوسيرين اللا مائي كمنظف عندما يمنع استخدام الصابون والماء",
 "eucerine anhydrous": "يوسيرين لا مائي (يستخدم بشكل رئيسي كقاعدة لدمج الأدوية الأخرى في حالات التهاب الجلد السطحي أو التهيج)\nمثال: يمكن استخدام اليوسيرين اللا مائي كمنظف عندما يمنع استخدام الصابون والماء",
 "eucharist": "تَنَاوُل (فعل مطاوعة من نَاوَلَ، ناولته فتناول؛ أخذ الشيء الذي ناولته إياه؛ الطعام والدواء: أكَلَه) / أَفْخَارِسْتِيَا\nمثال: تناول سامي سما.",
 "eucharistic": "أفخارستي, قرباني (مكون من أو متعلق بسر القربان المقدس (الإفخارستيا))\nمثال: الكأس القربانية",
 "eucharistic liturgy": "الإفخارستيا, القربان المقدس (سر مسيحي يحيي ذكرى العشاء الأخير بتكريس الخبز والنبيذ)",
 "euchre": "يوكر (لعبة ورق تشبه الإيكارتيه؛ يتم توزيع 5 أوراق لكل لاعب ويجب على اللاعب الذي يختار الورقة الرابحة أن يأخذ 3 جولات للفوز باليد)",
 "eucinostomus gula": "جيني الفضية (موجارا فضية توجد على طول الشواطئ الرملية لغرب المحيط الأطلسي)",
 "euclid": "إِقْلِيدِس",
 "euclid's axiom": "بديهية إقليدس ((رياضيات) أي من البديهيات الخمس التي يُعترف بها عموماً كأساس للهندسة الإقليدية)",
 "euclid's fifth axiom": "بديهية إقليدس الخامسة, بديهية التوازي (يمكن رسم خط واحد فقط عبر نقطة موازياً لخط آخر)",
 "euclid's first axiom": "بديهية إقليدس الأولى (يمكن رسم خط مستقيم بين أي نقطتين)",
 "euclid's fourth axiom": "بديهية إقليدس الرابعة (جميع الزوايا القائمة متساوية)",
 "euclid's postulate": "بديهية إقليدس ((رياضيات) أي من البديهيات الخمس التي يُعترف بها عموماً كأساس للهندسة الإقليدية)",
 "euclid's second axiom": "بديهية إقليدس الثانية (أي خط مستقيم محدود يمكن تمديده إلى ما لا نهاية)",
 "euclid's third axiom": "بديهية إقليدس الثالثة (يمكن رسم دائرة بأي نصف قطر حول أي نقطة)",
 "euclidean": "إقليدي (متعلق بالهندسة كما طورها إقليدس)\nمثال: هندسة إقليدية",
 "euclidean algorithm": "خَوَارِزْمِيَّة إِقْلِيدِس (خوارزمية: مجموعة من الخطوات والقواعد المحددة التي تُتَّبع لحل مسألة أو تنفيذ مهمة معينة، ولا سيما في الحاسوب)\nمثال: هذه الخوارزمية لا تتقارب.",
 "euclidean axiom": "بديهية إقليدس ((رياضيات) أي من البديهيات الخمس التي يُعترف بها عموماً كأساس للهندسة الإقليدية)",
 "euclidean geometry": "هَنْدَسَة إِقْلِيدِيَّة (الحدُّ والقياس؛ في الرياضيات: هي العلم الذي يبحث في الأشكال وعلاقاتها من حيث الخطوط والأبعاد والسطوح وغيرها)\nمثال: هو ضليع في علم الهندسة .",
 "euclidean space": "فضاء إقليدي (فضاء تنطبق فيه بديهيات وتعريفات إقليدس؛ فضاء متري خطي ومحدود الأبعاد)",
 "euclidian": "إقليدي (متعلق بالهندسة كما طورها إقليدس)\nمثال: هندسة إقليدية",
 "eudaemon": "روح خيرة (روح محبة للخير)",
 "eudaemonia": "رفاهية, سعادة (حالة قناعة وسعادة وصحة وازدهار)\nمثال: كانت المدينة أخيراً في حالة تحسن (رفاهية) بعد مشاكلنا الأخيرة",
 "eudaemonic": "جالب للسعادة, سعودي (يؤدي إلى السعادة والرفاهية)",
 "eudaimonia": "رفاهية, سعادة (حالة قناعة وسعادة وصحة وازدهار)\nمثال: كانت المدينة أخيراً في حالة تحسن (رفاهية) بعد مشاكلنا الأخيرة",
 "eudemon": "روح خيرة (روح محبة للخير)",
 "eudemonic": "جالب للسعادة, سعودي (يؤدي إلى السعادة والرفاهية)",
 "eudemonism": "مذهب السعادة (نظام أخلاقي يقيم الأفعال بالإشارة إلى الرفاهية الشخصية من خلال حياة قائمة على العقل)",
 "euderma maculata": "خفاش مرقط (خفاش كبير من جنوب غرب الولايات المتحدة له بقع وآذان ضخمة)",
 "eudiometer": "مقياس نقاء الهواء, يوديومتر (أداة قياس تتكون من أنبوب زجاجي مدرج لقياس تغيرات الحجم في التفاعلات الكيميائية بين الغازات)",
 "eudromias morinellus": "زقزاق أوراسي (زقزاق نادر من المناطق المرتفعة في أوراسيا)",
 "eugenia aromaticum": "شجرة القرنفل, قرنفل (شجرة دائمة الخضرة متوسطة الحجم متناظرة جداً ذات زهور حمراء، تزرع على نطاق واسع في المناطق الاستوائية لبراعم زهورها التي تعد مصدراً للقرنفل)",
 "eugenia caryophyllatum": "شجرة القرنفل, قرنفل (شجرة دائمة الخضرة متوسطة الحجم متناظرة جداً ذات زهور حمراء، تزرع على نطاق واسع في المناطق الاستوائية لبراعم زهورها التي تعد مصدراً للقرنفل)",
 "eugenia corynantha": "كرز حامض أسترالي (شجرة أسترالية ذات ثمار حمراء حامضة)",
 "eugenia dicrana": "خشب عاري (شجرة من أقصى جنوب فلوريدا وجزر الهند الغربية لها لحاء حرشفي رقيق وثمار وبذور عطرية وتنتج خشب الحمار الوحشي الصلب الثقيل وثيق الحبيبات)",
 "eugenia jambos": "تفاح الورد, جامبوزا (شجرة استوائية من جزر الهند الشرقية تزرع لفاكهتها الصالحة للأكل)",
 "eugenia uniflora": "بيتانغا, كرز سورينام (شجرة برازيلية ذات ثمار حمراء حارة؛ تزرع غالباً في كاليفورنيا وفلوريدا)",
 "eugenic": "تحسيني للنسل, يوجيني (متعلق بـ أو مسبب للتحسن في النسل الناتج)",
 "eugenics": "تَحْسِين نَسْل",
 "euglena": "يوجلينا (كائن دقيق أخضر وحيد الخلية يعيش في المياه العذبة وله سوط واحد؛ يصنف غالباً كطحالب)",
 "euglenid": "يوجلينية (كائن سوطي أخضر أو عديم اللون يعيش في المياه العذبة والبحرية)",
 "euglenoid": "يوجلينية (كائن سوطي أخضر أو عديم اللون يعيش في المياه العذبة والبحرية)",
 "euglenophyta": "اليوجلينيات, قسم اليوجلينيات (طحالب سوطية حرة السباحة)",
 "euglenophyte": "يوجلينية (كائن سوطي أخضر أو عديم اللون يعيش في المياه العذبة والبحرية)",
 "euhemerism": "يُوهَيْمِرِيَّة",
 "eukaryote": "حقيقيات النوى",
 "eukaryotic": "حقيقي النواة (تمتلك خلايا ذات أنوية 'جيدة' أو محاطة بغشاء)",
 "euler's formula": "صِيغَة أُويْلِر",
 "eulogist": "مَدَّاح",
 "eulogistic": "تَمْجِيدِيّ, مَدَائِحِيّ (يُعَبِّر عن الثناء بشكل رسمي)",
 "eulogium": "تأبين, رثاء (تعبير رسمي عن الثناء لشخص توفي مؤخراً)",
 "eulogize": "أَبَّنَ",
 "eulogy": "تَأْبِين, أُمْدُوحَة / ثَنَاء, أُمْدُوحَة",
 "eumeces callicephalus": "سقنقور جبلي (يتردد على موائل البلوط والصنوبر في المناطق الجبلية الصخرية بجنوب غرب الولايات المتحدة والمكسيك)",
 "eumeces skiltonianus": "سقنقور غربي (يوجد في المراعي والغابات المفتوحة في غرب أمريكا الشمالية)",
 "eumenides": "إرينييس, فوريات ((الأساطير الكلاسيكية) الوحوش البشعة ذات شعر الثعابين (عادة ثلاث) اللواتي يلاحقن المجرمين غير المعاقبين)",
 "eumetopias jubatus": "أسد البحر ستيلر (أكبر أسود البحر؛ يعيش في شمال المحيط الهادئ)",
 "eunectes murinus": "أناكوندا (أصلة شجرية كبيرة من أمريكا الجنوبية الاستوائية)",
 "eunuch": "خَصِيّ, مَخْصِيّ",
 "eunuchoidism": "خنوثة ذكورية, طواشية (حالة الخصي (إما بسبب عدم وجود الخصيتين أو لأنهما فشلا في التطور))",
 "euonymous alatus": "مغزلية مجنحة (شجيرة كثيفة متساقطة الأوراق ذات فروع لها أجنحة طولية فلينية عريضة ورقيقة؛ حمراء زاهية في الخريف؛ من شمال شرق آسيا إلى وسط الصين)",
 "euonymus alatus": "مغزلية مجنحة (شجيرة كثيفة متساقطة الأوراق ذات فروع لها أجنحة طولية فلينية عريضة ورقيقة؛ حمراء زاهية في الخريف؛ من شمال شرق آسيا إلى وسط الصين)",
 "euonymus americanus": "شجيرة الفراولة, غدب أمريكي (نبات نفضي منتصب بقرون وبذور قرمزية؛ شرق الولايات المتحدة من نيويورك إلى فلوريدا وتكساس)",
 "euonymus atropurpureus": "شجيرة محترقة, غدب أرجواني (شجيرة نفضية لها كبسولات أرجوانية تحيط ببذور قرمزية)",
 "euonymus europaeus": "شجرة المغزل الشائعة, مغزلية أوروبية (شجيرة صغيرة منتصبة متساقطة الأوراق ذات خشب أبيض صلب ولحاء وثمار مسهلة)",
 "euonymus fortunei radicans": "حلوة مرة دائمة الخضرة (شجيرة آسيوية ملتفة عريضة وكثيفة بثمار وردية؛ العديد من الأنواع الفرعية أو الأصناف)",
 "euonymus radicans vegetus": "حلوة مرة دائمة الخضرة (شجيرة آسيوية ملتفة عريضة وكثيفة بثمار وردية؛ العديد من الأنواع الفرعية أو الأصناف)",
 "eupatorium aya-pana": "أيابانا",
 "eupatorium cannabinum": "غافث القنب (عشب أوروبي خشن ذو أوراق مقسمة كفياً وعناقيد من رؤوس الزهور الحمراء الأرجوانية الصغيرة)",
 "eupatorium capillifolium": "شمر الكلب (نبات عشبي ضار في جنوب شرق الولايات المتحدة له أوراق مقسمة وعناقيد طويلة من الزهور المخضرة)",
 "eupatorium coelestinum": "أجيراتوم, زهرة الضباب (نبات جذموري من وسط وجنوب شرق الولايات المتحدة وجزر الهند الغربية له رؤوس كبيرة مبهرجة من الزهور الزرقاء الصافية)",
 "eupatorium maculatum": "جو باي المرقط, غافث مرقط (عشب من أمريكا الشمالية له أوراق محيطية وعناقيد طرفية من رؤوس الزهور الوردية أو الأرجوانية الصغيرة)",
 "eupatorium perfoliatum": "جابر العظام, غافث مثقوب (عشب معمر في جنوب شرق الولايات المتحدة له رؤوس زهرية بيضاء الشعاع؛ كان يستخدم سابقاً في الطب الشعبي)",
 "eupatorium purpureum": "جو باي الأرجواني, غافث أرجواني (عشب من أمريكا الشمالية له أوراق محيطية وعناقيد طرفية من الزهور المرقطة بالأرجواني)",
 "eupatorium rugosum": "أغراتينا, جذر الثعبان الأبيض",
 "euphagus carolinus": "شحرور صدئ (شحرور من أمريكا الشمالية يصبح ريشه الأسود المزرق ذو حواف صدئة في الخريف)",
 "euphausia pacifica": "كريل المحيط الهادئ (غذاء لقنديل البحر)",
 "euphemism": "تلطيف التعبير, يوفيميزم (تعبير غير مسيء أو غير مباشر يتم استبداله بآخر يعتبر مسيئاً أو قاسياً جداً)",
 "euphemistic": "تلطيفي, مهذب التعبير (من أو ذو طبيعة التلطيف (استخدام تعبير لطيف لشيء كريه))",
 "euphemistically": "بعبارة ملطفة, تلطفاً (بأسلوب يستخدم عبارات ملطفة لتخفيف وقع الكلام)\nمثال: أشير إلى موته العنيف تلطفاً بعبارة (انتقل إلى رحمة الله)",
 "euphonic": "شجي, عذب الوقع (من أو يتعلق بحسن الوقع الصوتي أو يتميز به)",
 "euphonical": "شجي, عذب الوقع (من أو يتعلق بحسن الوقع الصوتي أو يتميز به)",
 "euphonious": "شَجِيّ, عَذْب الصَّوْت (له صوت سار) / رَخِيم, عَذْبُ النَّغَم ((للكلام أو اللهجة) مُسْتَحَبّ السمع؛ غير خشن أو نشاز)\nمثال: ترنيم شجي لضحكة فضية",
 "euphonium": "بُوق (فَسَد؛ باق الرجل: كَذَب)\nمثال: كان سامي ينبه بالبوق.",
 "euphonous": "شَجِيّ, عَذْب الصَّوْت (له صوت سار)\nمثال: ترنيم شجي لضحكة فضية",
 "euphony": "موسيقى, نغم عذب (أي أصوات مقبولة (مستساغة ومتناغمة))\nمثال: غفا على وقع موسيقى أجراس الرياح",
 "euphorbia amygdaloides": "فربيون الغابة, فربيون لوزي (عشبة معمرة أوروبية ذات عناقيد زهور طرفية صفراء مخضرة)",
 "euphorbia antisyphilitica": "فربيون مضاد للزهري, كانديليلا (شجيرة مغطاة بالشمع في شمال المكسيك وجنوب غرب الولايات المتحدة)",
 "euphorbia caput-medusae": "رأس ميدوسا, فربيون رأس ميدوسا (شجيرة عصارية قزمة أفريقية معمرة ذات فروع متدلية رفيعة عديدة)",
 "euphorbia corollata": "فربيون بري, فربيون مزهر (فربيون معمر شائع في الولايات المتحدة ذو قنابات بيضاء مبهرجة تشبه البتلات)",
 "euphorbia cyathophora": "فربيون كأسي, نار على الجبل (بنت القنصل في الولايات المتحدة وشرق المكسيك؛ غالباً ما يتم الخلط بينها وبين الفربيون متباين الأوراق)",
 "euphorbia cyparissias": "فربيون سروي (نبات معمر من العالم القديم ذو أوراق تشبه السرو؛ متوطن كعشبة ضارة في الولايات المتحدة)",
 "euphorbia dentata": "فربيون مسنن (عشبة سنوية في شمال شرق أمريكا الشمالية ذات أوراق مسننة)",
 "euphorbia esula": "حليب الذئب, فربيون ورقي (نبات معمر أوروبي طويل متوطن ومزعج كعشبة ضارة في شرق أمريكا الشمالية)",
 "euphorbia exigua": "فربيون قزم (فربيون عشبي سنوي أوروبي منتصب أو منخفض دخيل في شمال شرق الولايات المتحدة)",
 "euphorbia fulgens": "ريشة قرمزية, فربيون لامع (شجيرة مكسيكية تزرع غالباً لزهورها ذات القنابات القرمزية)",
 "euphorbia helioscopia": "حليب الشيطان, فربيون الشمس (عشبة أوروبية غير جذابة تتحول زهورها نحو الشمس)",
 "euphorbia heterophylla": "بنت القنصل اليابانية, فربيون متباين الأوراق (بنت القنصل المبهرجة توجد من جنوب الولايات المتحدة إلى بيرو)",
 "euphorbia hirta": "أوفوربيا هيرتا, فربيون زاحف (عشب حولي ينمو في الأراضي العشبية المفتوحة وعلى جوانب الطرق والممرات أصله من الأمريكتين ويستخدم في طب الأعشاب التقليدي)",
 "euphorbia ingens": "فربيون صباري, فربيون ضخم (شجرة صغيرة في الأجزاء المفتوحة الجافة من جنوب أفريقيا ذات فروع زاوية منتصبة توحي بالشمعدان)",
 "euphorbia lathyris": "فربيون الكبر, فربيون منشاري (فربيون سام من العالم القديم؛ دخيل في أمريكا؛ تنتج بذوره زيتاً مسهلاً)",
 "euphorbia litchi": "لونجان, لونغان (شجرة من جنوب شرق آسيا إلى أستراليا تزرع أساساً لفاكهتها الحلوة الصالحة للأكل التي تشبه مكسرات الليتشي)",
 "euphorbia marginata": "ثلج على الجبل, فربيون مهدب (فربيون سنوي في غرب الولايات المتحدة ذو عناقيد زهور بيضاء القنابات وحليب سام جداً)",
 "euphorbia medusae": "رأس ميدوسا, فربيون رأس ميدوسا (شجيرة عصارية قزمة أفريقية معمرة ذات فروع متدلية رفيعة عديدة)",
 "euphorbia milii": "إكليل الشوك, شوك المسيح (فربيون شجيري متسلق نوعاً ما في مدغشقر ذو سيقان شائكة خشبية طويلة مع القليل من الأوراق وزهور بقنابات قرمزية)",
 "euphorbia peplus": "حليب الشيطان, فربيون صغير (فربيون من العالم القديم تم إدخاله كعشبة ضارة في شرق الولايات المتحدة)",
 "euphorbia pulcherrima": "بنت القنصل, زهرة الميلاد (نبات أمريكي استوائي ذو حليب سام وأوراق مبهرجة مستدقة عادة ما تكون قرمزية تشبه البتلات تحيط بزهور صفراء صغيرة)",
 "euphorbia villosa": "فربيون وبري (نوع من النباتات العشبية المعمرة موطنه أوروبا)",
 "euphorbium": "فربيون (راتنج صمغي بني لاذع يستخدم الآن بشكل رئيسي في الطب البيطري)",
 "euphoria": "اِبْتِهَاج, نَشْوَة (البَهْجَةُ: الحُسْنُ يُقَال: رَجُلٌ ذُو بَهْجَةٍ؛ وَيُقَال: هُوَ حُسْنُ لَونِ الشيْءِ ونَضَارَتُه، وَقيل: هُوَ فِي النّباتِ النضَارَةُ…؛ (بَهُجَ، ككَرُمَ) بَهْجَةً و (بَهاجَةً) وبَهَجَاناً (فَهُوَ بَهِيجٌ، و) امرأَةٌ بَهِجَةٌ: مُبْتَهِجَةٌ، وَقد بَهُجَتْ بَهْجَةً، و (هِيَ مِبْهَاجٌ)…)",
 "euphoriant": "مُبْهِج, مُنْشٍ (يَمِيل إلى إحداث النَّشوة) / عقار مبهج (عقار ذو تأثير نفسي يميل إلى إنتاج الابتهاج والنشوة)",
 "euphoric": "مبتهج, منتشٍ (شعور مبالغ فيه بالرفاهية أو الابتهاج)",
 "euphory": "نشوة (شعور بالابتهاج العظيم (المبالغ فيه عادة))",
 "euphractus sexcinctus": "بيلودو, مدرع مشعر (مدرع أرجنتيني له ستة أشرطة متحركة وأجزاء سفلية مشعرة)",
 "euphratean": "فُرَاتِيّ",
 "euphrates": "اَلْفُرَات",
 "euphrosyne": "إيفروسيني ((الأساطير اليونانية) واحدة من الخاريس الثلاثة؛ التي تجلب الفرح)",
 "euphuism": "أسلوب يوفيوسي (أسلوب أنيق للنثر في الفترة الإليزابيثية؛ يتميز بالتوازن والتضاد والجناس والتشبيهات الممتدة مع الإشارات إلى الطبيعة والأساطير) / تفاصح, تكلف لغوي (أي أسلوب لغة أنيق بشكل مصطنع)",
 "eupnea": "تنفس سوي, تنفس طبيعي (تنفس مريح وطبيعي)",
 "eupneic": "طَبِيعِيّ التَّنَفُّس, مُتَنَفِّس (يمرر أو قادر على تمرير الهواء داخل وخارج الرئتين بشكل طبيعي؛ تستخدم أحياناً في التركيب)\nمثال: خاب أمل الصبي للعثور فقط على هياكل عظمية بدلاً من ديناصورات حية تتنفس",
 "eupnoea": "تنفس سوي, تنفس طبيعي (تنفس مريح وطبيعي)",
 "eupnoeic": "طَبِيعِيّ التَّنَفُّس, مُتَنَفِّس (يمرر أو قادر على تمرير الهواء داخل وخارج الرئتين بشكل طبيعي؛ تستخدم أحياناً في التركيب)\nمثال: خاب أمل الصبي للعثور فقط على هياكل عظمية بدلاً من ديناصورات حية تتنفس",
 "euproctis chrysorrhoea": "عثة ذهبية الذيل (عثة أوروبية بيضاء ذات جسم فروي وخصلة ذيل صفراء)",
 "euproctis phaeorrhoea": "عثة بنية الذيل (عثة أوروبية صغيرة بنية وبيضاء أُدخلت إلى شرق الولايات المتحدة؛ آفة لأشجار الظل والفاكهة المتنوعة)",
 "eurafrican": "أورأفريقي (يتعلق بأوروبا وأفريقيا أو يأتي منهما) / أوروإفريقي (شخص من أصل أوروبي وإفريقي مختلط)",
 "eurasia": "أُورَاسِيَا",
 "eurasian": "أوراسي (يتعلق بأوروبا وآسيا أو يأتي منهما) / أوراسي (شخص من أصل أوروبي وآسيوي مختلط)\nمثال: كانت والدته أوراسية ووالده صينياً",
 "eurasian badger": "غرير أوراسي (نوع من الغرير موطنه أوروبا وآسيا)",
 "eurasian economic union": "اَلاِتِّحَاد اَلْيُورَاسِيّ, اَلاِتِّحَاد اَلْأُورَاسِيّ",
 "eurasian green toad": "علجوم أخضر أوراسي (علجوم أوراسي ذو لون أخضر متغير بشكل رئيسي)",
 "eurasian hamster": "هامستر أوراسي (نوع من الهامستر شائع في أوروبا وآسيا)",
 "eurasian kingfisher": "رفراف شائع (رفراف صغير ذو ريش أزرق مخضر وبرتقالي)",
 "eurasian otter": "قضاعة أوراسية (قضاعة توجد في أوروبا وآسيا)",
 "eurasian sparrowhawk": "بَاشِق",
 "eurasian teal": "حذف شتوي (حَذَفَ الشّيء:قطعه وأَسْقَطَه. حَذَفَ الْمُرَاجِعُ عِبَارَةً منَ الْخِطَابِ؛ حَذَفَهُ بِالعَصَا: ضَرَبَهُ ، ورَمَاهُ بِها)\nمثال: حذف ياني حسابه.",
 "eurasian woodcock": "دجاجة الأرض الأوراسية (دجاجة أرض مهاجرة من العالم القديم قصيرة الساقين وطويلة المنقار)",
 "eurasiatic": "أوراسي (يتعلق بأوروبا وآسيا أو يأتي منهما)\nمثال: كانت والدته أوراسية ووالده صينياً",
 "eureka": "يُورِيكَا, لَقَدْ وَجَدتُهَا!",
 "eurhythmics": "حركات إيقاعية, يوريثميكس (التفسير بحركات جسدية متناغمة لإيقاع المؤلفات الموسيقية؛ يستخدم لتعليم الفهم الموسيقي)",
 "eurhythmy": "حركات إيقاعية, يوريثميكس (التفسير بحركات جسدية متناغمة لإيقاع المؤلفات الموسيقية؛ يستخدم لتعليم الفهم الموسيقي)",
 "euripides": "يُورِبِيدِيس",
 "euro": "يُورُو, يورو",
 "euro-trance": "يورو ترانس (موسيقى ترانس إلكترونية من أوروبا)",
 "eurobabble": "ثرثرة أوروبية (رطانة وثائق ولوائح المجتمع الأوروبي)",
 "eurocentric": "متمركز حول أوروبا (يركز على أوروبا والأوروبيين)",
 "eurocentrism": "مَرْكَزِيَّة أُورُوبِّيَّة",
 "eurocurrency": "عملة أوروبية (عملة الدول المالية والصناعية الكبرى المحتفظ بها في تلك البلدان لغرض الإقراض والاقتراض)",
 "eurodollar": "يورودولار (دولار أمريكي مودع في بنك أوروبي ويستخدم كعملة دولية لتمويل التجارة)",
 "euromaidan": "اَلمَيْدَان اَلأُورُوبِّيّ, أُورُومَيْدَان",
 "europa": "أُورُوبَّا, أُورُبَّا (الجزء من يوراسيا الذي يقع غرب جبال الأورال، والمعتبر تقليديًّا قارة بحد ذاته، كما يقع شمال قارة إفريقيا، وغرب قارة آسيا، وشرق المحيط الأطلسي؛ كيان سياسي؛ الاتحاد الأوروبي)\nمثال: ذهبت إلى أوروبا مرة.",
 "europan": "يوروبان (لغة مصطنعة اقتُرحت كلغة أوروبية مساعدة)",
 "europe": "أُورُوبَّا, أُورُوبَّة (الجزء من يوراسيا الذي يقع غرب جبال الأورال، والمعتبر تقليديًّا قارة بحد ذاته، كما يقع شمال قارة إفريقيا، وغرب قارة آسيا، وشرق المحيط الأطلسي؛ كيان سياسي؛ الاتحاد الأوروبي)\nمثال: ذهبت إلى أوروبا مرة.",
 "european": "أُورُوبِيّ",
 "european ash": "مران أوروبي, مران عالي (مران طويل من أوروبا إلى القوقاز له أوراق خضراء داكنة لامعة من الأعلى وشاحبة زغبية من الأسفل)",
 "european barberry": "باربيريس شائع, زرشك (شجيرة أوروبية نفضية منتصبة تم توطينها على نطاق واسع في الولايات المتحدة لها عناقيد من التوت العصاري)",
 "european bean": "فول, فول عريض (نبات منتصب من العالم القديم يزرع خاصة لبذوره المسطحة الكبيرة الصالحة للأكل وأيضاً كعلف)",
 "european beech": "زان أوروبي, زان شائع (زان أوروبي كبير بأوراق مسننة بدقة؛ يُزرع على نطاق واسع للزينة في أمريكا الشمالية)",
 "european beggar-ticks": "قراد المتسول الأوروبي, قطيفة شائكة ثلاثية الفصوص (قطيفة شائكة في أوراسيا المعتدلة)",
 "european bird cherry": "كرز الطيور الأوروبي, هاغبيري (شجرة كرز أوروبية صغيرة تشبه كثيراً الكرز المخنوق الأمريكي)",
 "european bittern": "واق أوراسي, واق أوروبي (نوع من الواق، يُعرف أيضاً بالواق الكبير)",
 "european black alder": "نغت أسود أوروبي, نغت دابق (شجرة متوسطة الحجم بلحاء بني أسود وعناقيد ثمرية خشبية؛ الأوراق مشعرة من الأسفل)",
 "european black currant": "ريباس أسود, كشمش أسود (كشمش مزروع على نطاق واسع يحمل ثماراً سوداء عطرية صالحة للأكل)",
 "european black grouse": "طيهوج أسود أوروبي (طيهوج كبير من شمال أوروبا أسود اللون وذيله على شكل قيثارة)",
 "european blackbird": "شحرور (سمنة أوروبية سوداء شائعة)",
 "european blueberry": "عنبية (توت أزرق مسود يشبه التوت الأزرق الأمريكي)",
 "european bog asphodel": "بروق المستنقعات الأوروبي (من غرب أوروبا: إسكندنافيا إلى شمال إسبانيا والبرتغال)",
 "european box": "بقس شائع, شمشاد دائم الخضرة (شجيرة كبيرة بطيئة النمو دائمة الخضرة أو شجرة صغيرة ذات سيقان متعددة؛ تستخدم على نطاق واسع للأسيجة أو الحدود والأشكال المقلمة)",
 "european bream": "البريم, الدنيس الأوروبي (سمكة مياه عذبة أوروبية ذات جسم مسطح وحراشف فضية؛ قيمتها الغذائية قليلة)",
 "european brooklime": "زهرة الوحل الأوروبية, فيرونيكا (نبات أوروبي له سيقان منخفضة وزهور زرقاء؛ تم توطينه بشكل متناثر في أمريكا الشمالية)",
 "european brown bat": "خفاش بني أوروبي, خفاش سيروتين (خفاش بني شائع في أوروبا)",
 "european catfish": "سلور أوروبي (سلور ممدود كبير يعيش في وسط وشرق أوروبا)",
 "european central bank": "اَلْبَنْك اَلْمَرْكَزِيّ اَلْأُورُوبِّيّ",
 "european chestnut": "أبو فروة, كستناء أوروبية (برية أو مزروعة في جميع أنحاء جنوب أوروبا وشمال غرب أفريقيا وجنوب غرب آسيا)",
 "european community": "الاتحاد الأوروبي, السوق الأوروبية المشتركة (منظمة دولية للدول الأوروبية تشكلت بعد الحرب العالمية الثانية لتقليل الحواجز التجارية وزيادة التعاون بين أعضائها)\nمثال: حاول إدخال بريطانيا في الاتحاد الأوروبي",
 "european corn borer moth": "حفار الذرة, عثة حفار الذرة الأوروبي (موطنها الأصلي أوروبا؛ في أمريكا تحفر اليرقات في ساق وتاج الذرة ونباتات أخرى)",
 "european country": "دولة أوروبية (أي دولة من الدول التي تشغل القارة الأوروبية)",
 "european cranberry": "توت بري أوروبي, كرانبيري صغير (توت بري زاحف ذو ثمار حمراء صغيرة من المناطق القطبية والباردة في نصف الكرة الشمالي)",
 "european cranberry bush": "رباطية أوبولس, ورد غيلدر (شجيرة نفضية من العالم القديم تشكل غابات صغيرة، لها عناقيد من الزهور البيضاء وتوت أحمر لامع صغير)",
 "european cranberrybush": "رباطية أوبولس, ورد غيلدر (شجيرة نفضية من العالم القديم تشكل غابات صغيرة، لها عناقيد من الزهور البيضاء وتوت أحمر لامع صغير)",
 "european creeper": "دابة الشجر الأوروبية (دابة شجر أوروبية شائعة بنية وصفراء بمنقار منحني لأسفل)",
 "european cuckoo": "واقواق شائع (واقواق شائع في أوروبا له نداء مميز من نغمتين؛ يضع البيض في أعشاش الطيور الأخرى)",
 "european curlew": "كروان أوراسي (كروان أوراسي شائع)",
 "european dewberry": "ديوبيري أوروبي (عليق أوروبي زاحف يحمل الديوبيري)",
 "european dogtooth": "سن الكلب الأوروبي (نبات سن الكلب الأوروبي القوي بزهور وردية إلى بنفسجية؛ يزرع في العديد من الأصناف)",
 "european dragon": "تنين, تنين أوروبي (مخلوق من الأساطير التيوتونية؛ يصور عادة وهو ينفث النار وله جسم زاحف وأحيانًا أجنحة)",
 "european dune grass": "عشبة الكثبان الأوروبية, عشبة لايم البحرية (عشبة كثبان في ساحل المحيط الهادئ تستخدم كمثبت للرمال)",
 "european economic community": "الاتحاد الأوروبي, السوق الأوروبية المشتركة (منظمة دولية للدول الأوروبية تشكلت بعد الحرب العالمية الثانية لتقليل الحواجز التجارية وزيادة التعاون بين أعضائها)\nمثال: حاول إدخال بريطانيا في الاتحاد الأوروبي",
 "european elder": "بيلسان أسود, خمان أسود (شجيرة شائعة بفاكهة سوداء أو شجرة صغيرة من أوروبا وآسيا؛ تستخدم الفاكهة للنبيذ والمربيات)",
 "european elm": "دردار إنجليزي (دردار عريض الانتشار خشن الأوراق شائع في جميع أنحاء أوروبا ويزرع في أماكن أخرى)",
 "european field elm": "دردار ناعم الأوراق (دردار أوروبي بأوراق ناعمة لامعة يستخدم للزينة)",
 "european fire salamander": "سمندل النار الأوروبي (نوع من السمندل الأوروبي)",
 "european flatfish": "السمكة المفلطحة الأوروبية (سمكة طعام مهمة في أوروبا)",
 "european fly honeysuckle": "عسلة أوروبية (شجيرة أوراسية مزروعة بزهور بيضاء مصفرة مزدوجة وثمار قرمزية)",
 "european gallinule": "دجاجة الماء الأرجوانية (دجاجة ماء أرجوانية من جنوب أوروبا)",
 "european goatsucker": "سبد أوروبي (سبد من العالم القديم)",
 "european hackberry": "ميس أوروبي, ميس جنوبي (شجرة ظل متساقطة الأوراق خضراء زاهية من جنوب أوروبا)",
 "european hare": "أرنب بري أوروبي (أرنب بري كبير أُدخل في أمريكا الشمالية؛ لا يتحول إلى الأبيض في الشتاء)",
 "european holly": "بَهَشِيَّةٌ شَائِعَةٌ",
 "european honeysuckle": "عسلة أوروبية (شجيرة أوراسية مزروعة بزهور بيضاء مصفرة مزدوجة وثمار قرمزية)",
 "european hoopoe": "هدهد (هدهد بني وردي ذو أجنحة سوداء وبيضاء)",
 "european hop": "جنجل شائع, حشيشة الدينار (نبات متسلق أوروبي تستخدم أزهاره بشكل رئيسي لتنكيه المشروبات الكحولية (البيرة)؛ يزرع في أمريكا)",
 "european hornbeam": "شجرة النير الأوروبية (شجرة متوسطة الحجم من العالم القديم بلحاء رمادي ناعم وأوراق تشبه الزان تتحول إلى الأصفر البرتقالي في الخريف)",
 "european house cricket": "صرصور المنزل الأوروبي (يعيش في مساكن البشر؛ استوطن في أجزاء من أمريكا)",
 "european ladies' tresses": "جدائل السيدة الأوروبية (سحلب أوروبي له عناقيد أقصر من الزهور البيضاء الثلجية الحلزونية بقوة)",
 "european larch": "أرزية أوروبية (شجرة أوروبية طويلة لها تاج مخروطي نحيل، وأوراق مسطحة تشبه الإبر، وحراشف مخروطية مشعرة)",
 "european law enforcement organisation": "يوروبول (منظمة الشرطة للاتحاد الأوروبي؛ تهدف إلى تحسين الفعالية والتعاون بين قوات الشرطة الأوروبية)",
 "european lemming": "لاموس أوروبي (يشتهر بالهجرات الجماعية حتى إلى البحر حيث يغرق الكثير منها)",
 "european lobster": "كركند أوروبي (كركند ساحل المحيط الأطلسي لأوروبا) / كركند أوروبي (مشابه للكركند الأمريكي ولكنه أصغر)",
 "european magpie": "عقعق أوروبي (عقعق شائع في أوراسيا)",
 "european mountain ash": "روان, شجرة الروان (شجرة أوراسية ذات ثمار تشبه التوت برتقالية حمراء)",
 "european nation": "دولة أوروبية (أي دولة من الدول التي تشغل القارة الأوروبية)",
 "european nightjar": "سبد أوروبي (سبد من العالم القديم)",
 "european nut pine": "صنوبر المظلة, صنوبر ثمري (صنوبر ثنائي الإبر متوسط الحجم من جنوب أوروبا له تاج منتشر؛ يزرع على نطاق واسع لبذوره الحلوة التي تشبه اللوز)",
 "european nuthatch": "كاسر الجوز الأوروبي (نوع من كاسر الجوز)",
 "european olive tree": "زيتون, شجرة الزيتون الأوروبية (شجرة دائمة الخضرة تزرع في منطقة البحر الأبيض المتوسط منذ العصور القديمة والآن في أماكن أخرى؛ لها ثمار سوداء لامعة صالحة للأكل)",
 "european parsley fern": "سرخس البقدونس الأوروبي, سرخس البقدونس الجبلي (سرخس في أوروبا وآسيا الصغرى بجذمور نحيل قصير وسعف أخضر زاهي كثيف يشبه البقدونس)",
 "european pasqueflower": "زهرة الفصح الأوروبية (نبات أوروبي معمر ذو أزهار ربيعية بنفسجية أو بيضاء عادة)",
 "european perch": "فرخ أوروبي (فرخ موطنه أوروبا)",
 "european plan": "خطة أوروبية, خطة كونتيننتال (خطة فندقية توفر إفطاراً خفيفاً (كونتيننتال) يومياً)",
 "european polecat": "اِبْن عُرْس مُنْتِن أُورُوبِيّ, فَأْر الْخَيْل الْأُورُوبِيّ (الولد الذكر)\nمثال: هو له ابن صغير.",
 "european quaking aspen": "حور أوروبي, حور راجف (حور من العالم القديم بتاج عريض كثير التفرع؛ شمال غرب أوروبا وسيبيريا إلى شمال أفريقيا)",
 "european rabbit": "أرنب أوروبي, أرنب العالم القديم (حيوان حفار بني رمادي شائع موطنه جنوب أوروبا وشمال أفريقيا ولكن تم إدخاله في أماكن أخرى؛ مستأنس على نطاق واسع ومطور بألوان مختلفة ولاحتياجات مختلفة؛…)",
 "european raspberry": "توت العليق الأوروبي, توت العليق البري (توت العليق الأوروبي الشائع؛ الفاكهة حمراء أو برتقالية)",
 "european red elder": "بيلسان أحمر أوروبي (شجيرة أوراسية)",
 "european roller": "شقراق أوروبي (شقراق أوروبي شائع أزرق وأخضر ذو ظهر بني محمر)",
 "european sandpiper": "طيطوي شائع (نوع من الطيطوي)",
 "european sanicle": "سانيكولا أوروبية (سانيكولا في أوروبا وآسيا لها زهور بيضاء إلى وردية شاحبة)",
 "european sea bream": "دنيس أوروبي (سمكة غذائية في المياه الساحلية الأوروبية)",
 "european sea eagle": "عقاب البحر أبيض الذيل (عقاب ضخم بني رمادي بذيل أبيض قصير وتدي الشكل؛ من أوروبا وجرينلاند)",
 "european seabass": "قاروس, قاروص",
 "european shrike": "صرد رمادي كبير (طائر صرد أوروبي شائع)",
 "european silver fir": "شوح فضي أوروبي (شجرة خشب طويلة من وسط وجنوب أوروبا لها تاج منتظم ولحاء رمادي)",
 "european smelt": "هف أوروبي (الهف الشائع في أوروبا)",
 "european sole": "سمك موسى الأوروبي (ذو قيمة عالية كطعام)",
 "european spider crab": "سلطعون العنكبوت الأوروبي (سلطعون عنكبوت كبير من أوروبا)",
 "european swift": "سمامة شائعة (طائر أوروبي شائع ذو نداء صاخب يعشش بشكل رئيسي حول أفاريز المباني أو على المنحدرات)",
 "european toad": "علجوم أوروبي (علجوم شائع في أوروبا)",
 "european tortoise": "سلحفاة أوروبية (سلحفاة برية صغيرة من جنوب أوروبا)",
 "european turkey oak": "بلوط تركي (شجرة كبيرة متساقطة الأوراق من وسط وجنوب أوروبا وآسيا الصغرى لها أوراق رمحية ذات فصوص شائكة)",
 "european union": "الِٱتِّحَاد الْأُورُوبِيّ",
 "european water ouzel": "دج الماء الأوروبي (دج ماء من أوروبا)",
 "european water shrew": "زباب الماء الأوروبي (زباب ماء واسع الانتشار في العالم القديم)",
 "european white birch": "بتولا بيضاء أوروبية, بتولا فضية (بتولا أوروبية بلحاء أبيض فضي مقشر وفروع متدلية بشكل ملحوظ)",
 "european white lily": "زنبق أبيض أوروبي, نيلوفر أبيض (زنبق ماء ذو أزهار بيضاء)",
 "european wildcat": "قط بري أوروبي (قط بري كثيف الذيل يعيش في أوروبا يشبه القط المنزلي ويعتبر سلف القط المنزلي)",
 "european wolf spider": "رتيلاء, عنكبوت الذئب الأوروبي (عنكبوت كبير من جنوب أوروبا كان يعتقد سابقاً أنه سبب الهوس الرقصي (حركة جسدية لا يمكن السيطرة عليها))",
 "european wood mouse": "فأر الخشب الأوروبي (فأر ليلي بني مصفر يسكن الغابات والحقول والحدائق)",
 "european woolly thistle": "شوك صوفي أوروبي (شوك صوفي في غرب ووسط أوروبا وشبه جزيرة البلقان)",
 "europeanisation": "أوربة (الاستيعاب في الثقافة الأوروبية)",
 "europeanization": "أوربة (الاستيعاب في الثقافة الأوروبية)",
 "europhilia": "ولع بأوروبا, يوروفيليا (الإعجاب بأوروبا أو الأوروبيين أو الاتحاد الأوروبي)",
 "europium": "يُورُوبِّيُوم / أُورُوبِّيُوم",
 "europocentric": "متمركز حول أوروبا (يركز على أوروبا والأوروبيين)",
 "europol": "يُورُوبُول",
 "europop": "يُورُوبُوب",
 "eurovision": "يُورُوفِيجْن",
 "eurozone": "مِنْطَقَة اَلْيُورُو (المِنْطَقةُ: المَنْطِقَةُ؛ مِنْطَقَةُ: مُقَاطَعَةٌ)\nمثال: غزة منطقة مكشوفة.",
 "euryale": "يوريالي ((الأساطير اليونانية) الأخت الوسطى بين الغورغونات الثلاث)",
 "euryon": "عُرَيْضَى",
 "eurypterid": "عقرب البحر, يوريبتيريد (مفصلي منقرض كبير يشبه العقرب يعتبر مرتبطاً بسرطانات حدوة الحصان)",
 "eurythmics": "حركات إيقاعية, يوريثميكس (التفسير بحركات جسدية متناغمة لإيقاع المؤلفات الموسيقية؛ يستخدم لتعليم الفهم الموسيقي)",
 "eurythmy": "حركات إيقاعية, يوريثميكس (التفسير بحركات جسدية متناغمة لإيقاع المؤلفات الموسيقية؛ يستخدم لتعليم الفهم الموسيقي)",
 "eusporangiate": "حقيقي المباغ ((للسرخسيات) التي تنشأ فيها الحوافظ البوغية من مجموعة من خلايا البشرة)",
 "eusporangium": "محفظة بوغية حقيقية (محفظة بوغية تنشأ من مجموعة من خلايا البشرة)",
 "eustachian tube": "الأنبوب السمعي, النفير (أي من الأنبوبين المزدوجين اللذين يربطان الأذن الوسطى بالبلعوم الأنفي؛ يعمل على موازنة ضغط الهواء على جانبي طبلة الأذن)",
 "eustoma grandiflorum": "جرس أزرق, جنطيانا المروج (واحدة من أجمل الأزهار البرية في المروج لها أزهار زرقاء كبيرة منتصبة جرسية الشكل؛ في الأماكن الرطبة في المروج والحقول من شرق كولورادو ونبراسكا جنوباً…)",
 "eutamius asiaticus": "سنجاب سيبيري (سنجاب سيبيري أرضي)",
 "eutamius sibiricus": "سنجاب سيبيري (سنجاب سيبيري أرضي)",
 "eutectic": "خليط أصهري, يوتكتيك (خليط من المواد له الحد الأدنى من نقطة الانصهار)",
 "eutectoid steel": "فولاذ يوتكتودي (فولاذ يحتوي على 0.9% كربون (النقطة اليوتكتية)؛ الفولاذ الكربوني بنسبة 0.9% كربون هو بيرليت نقي)",
 "euterpe oleracea": "نخيل الآساي, نخيل الملفوف (نخيل برازيلي من جنس يوتيربي تؤكل براعم أوراقه مثل الملفوف عندما تكون صغيرة)",
 "euthanasia": "قَتْلٌ رَحِيم (تعمّد جعله يَمُوتُ، أزهق روحه، أمَاتَه متعمدا؛ الوقتَ: ضيعه بشيء غير ذي فائدة وهو ينتظر أمرا آخر)\nمثال: قتل الصياد دبا.",
 "euthanatise": "قَتَلَ قَتْلاً رَحِيماً (تسبب عمداً في الموت غير المؤلم لشخص أو حيوان)",
 "euthanatize": "قَتَلَ قَتْلاً رَحِيماً (تسبب عمداً في الموت غير المؤلم لشخص أو حيوان)",
 "euthanise": "قَتَلَ قَتْلاً رَحِيماً (تسبب عمداً في الموت غير المؤلم لشخص أو حيوان)",
 "euthanize": "قَتَلَ قَتْلاً رَحِيماً (تسبب عمداً في الموت غير المؤلم لشخص أو حيوان)",
 "euthenics": "تحسين المعيشة (دراسة طرق تحسين رفاهية الإنسان وأدائه الفعال من خلال تحسين الظروف البيئية)",
 "eutherian": "ثدييات مشيمية, مشيميات (ثدييات لها مشيمة؛ جميع الثدييات باستثناء الكظاميات والجرابيات) / حقيقي الوحشية, مشيمي (من أو يتعلق بالثدييات المشيمية (الحقيقية))\nمثال: ثدييات مشيمية",
 "eutherian mammal": "ثدييات مشيمية, مشيميات (ثدييات لها مشيمة؛ جميع الثدييات باستثناء الكظاميات والجرابيات)",
 "euthynnus pelamis": "تونا وثابة, وثابة (تونة محيطية تعيش في أسراب ذات قيمة كبيرة في المحيط الهادئ ولكن أقل في الأطلسي؛ تصل إلى 75 رطلاً؛ تشبه جداً بونيتو المحيط إن لم تكن هي نفسها)",
 "eutopic pregnancy": "حمل داخل الرحم (حمل ناتج عن نمو طبيعي للجنين في الرحم)",
 "eutrophic": "غني بالمغذيات, يوتروفي ((في البيئة) بحيرة أو جسم مائي غني بالعناصر الغذائية وعرضة للإثراء الغذائي)",
 "eutrophication": "إثراء غذائي, تخاصب (المغذيات المفرطة في بحيرة أو مسطح مائي آخر، وعادة ما تنتج عن جريان المغذيات (نفايات الحيوانات، الأسمدة، مياه الصرف الصحي) من الأرض، مما يسبب نموًا…)\nمثال: جادل بأن العامل المتحكم في الإثراء الغذائي ليس النترات بل الفوسفات",
 "euxenite": "يوكسينيت, أوكسينيت",
 "ev": "إلكترون فولت (وحدة طاقة تساوي الشغل الذي يبذله إلكترون يتسارع عبر فرق جهد قدره 1 فولت)",
 "evacuant": "مُسْهِلٌ قَوِيّ, مُنَقٍّ (شديد التأثير المُسْهِل)",
 "evacuate": "خلا / جَلَا, أَخْلَى (كشف أو أزال الشيء ليظهره بوضوح؛ طهر أو نقى، استخدم في معاني إزالة الأوساخ أو الشوائب) / فَرَّغَ, خَلَّى / أَفْرَغَ",
 "evacuation": "إخْلَاء, تَخْلِيَة / إخْلَاء / تَفْرِيغ, تَخْلِيَة (تَفْريغُ الظروف: إخْلاؤُها)",
 "evacuee": "مُرَحَّل",
 "evaluation": "تَقْيِيم, تَقْدِير",
 "evaluative": "تَقْيِيمِيّ, فَاحِص (يمارس أو ينطوي على تقييمات دقيقة)",
 "evaluator": "حَكَم, مُقيِّم (سلطة قادرة على تقدير القيمة أو الجودة)",
 "evanescence": "اضمحلال, تلاشي (حدث التلاشي والاختفاء التدريجي من الرؤية)\nمثال: تلاشي ضباب الصباح",
 "evanescent": "زَائِل كَالبُخَار, مُتَلَاشٍ (يميل إلى التلاشي كالبخار)",
 "evangel": "إنجيل, الأناجيل (الكتب الأربعة في العهد الجديد (متى ومرقس ولوقا ويوحنا) التي تروي قصة حياة المسيح وتعاليمه)",
 "evangelical": "تَبْشِيرِيّ, دَعَوِيّ (يتّسم بحماسة متّقدة لقضيّة ما) / إنجيلي (متعلق بالإنجيل المسيحي أو متوافق معه، خاصة كما في الكتب الأربعة الأولى من العهد الجديد) / إنجيلي (متعلق بكنيسة مسيحية تؤمن بالتحول الشخصي وعصمة الكتاب المقدس وخاصة الأناجيل الأربعة)\nمثال: المسيحية الإنجيلية",
 "evangelical and reformed church": "الكنيسة الإنجيلية والإصلاحية (طائفة بروتستانتية ذات عقيدة كالفينية)",
 "evangelical united brethren church": "كنيسة الإخوة المتحدين الإنجيلية (طائفة ميثودية)",
 "evangelicalism": "إنجيلية (تؤكد على أهمية التحول الشخصي والإيمان كوسيلة للخلاص)",
 "evangelism": "تبشير بالإنجيل (التبشير الحماسي والدعوة للإنجيل)",
 "evangelist": "مُبَشِّر / إِنْجِيلِيّ, بَشِير",
 "evangelistic": "تَبْشِيرِيّ, دَعَوِيّ (يتّسم بحماسة متّقدة لقضيّة ما) / إنجيلي, تبشيري (متعلق بوعظ ونشر الإنجيل المسيحي أو الترويج له)\nمثال: حماسة تبشيرية",
 "evangelize": "بَشَّرَ (بَشَرَ؛ بُشِرَ)\nمثال: لكنهم كلهم بشر.",
 "evaporable": "قَابِلٌ لِلتَّبَخُّر, قَابِلٌ لِلتَّطَايُر ((يُسْتَخْدَمُ لِلمَوَادّ) قَابِلٌ لِلتَّحَوُّلِ إِلَى بُخَار)",
 "evaporate": "تَبَخَّرَ",
 "evaporated": "مُتَبَخِّر (سُحِب على شكل بخار)",
 "evaporated milk": "حليب مبخر (حليب تم تركيزه عن طريق التبخير)",
 "evaporation": "تتجفاف, تجفيف (عملية استخلاص الرطوبة) / تبخر, تبخير (عملية التحول إلى بخار)",
 "evaporative": "تبخيري (متعلق بالتبخر أو يسببه أو ناتج عنه)\nمثال: مبرد تبخيري",
 "evaporative cooler": "مبرد تبخيري, مكيف صحراوي (نظام تبريد يبرد عن طريق التبخر)",
 "evaporite": "متبخرات (الراسب المتبقي بعد تبخر مياه البحر)",
 "evaporometer": "مقياس التبخر (أداة تقيس معدل تبخر الماء)",
 "evasion": "تملص, مراوغة (فعل الهروب جسدياً من شيء ما (خصم أو مطارد أو موقف غير سار) عن طريق مناورة بارعة) / تنصل, تهرب (عدم أداء شيء بغيض (كما هو الحال عن طريق الخداع أو الحيلة) من المفترض أن تقوم به) / تهرب, عدم الدفع (الفعل المتعمد لعدم دفع المال) / تهرب, مراوغة (بيان ليس كاذباً حرفياً ولكنه يتجنب بذكاء حقيقة غير سارة)\nمثال: كان تهربه من واجبه الواضح أمراً مستهجناً",
 "evasive": "مُتَهَرِّب, مُرَاوِغ (غامض أو ملتبس عمداً) / تَهَرُّبِيّ, مُرَاوِغ (يتفادى أو يهرب من الصعوبة أو الخطر خاصة نيران العدوّ)",
 "evasive action": "مناورة (إجراء يهدف إلى مراوغة الخصم)",
 "evasive answer": "إجابة مراوغة, رد مموه ((قانون) إجابة من المدعى عليه تفشل في الإقرار أو إنكار المزاعم الواردة في الشكوى)",
 "evasively": "بتهرب, بمراوغة (مع تهرب؛ بأسلوب مراوغ)\nمثال: بدا أن زوجها يعرف الكثير من الأشخاص المذكورين، لكنه أجاب بمراوغة عندما سُئل عن هويتهم",
 "evasiveness": "غموض متعمد, مراوغة (الغموض أو الإبهام المتعمد في الكلام)",
 "eve": "حَوَّاء / حَوَّاء, أِيف",
 "even": "مُسَطَّح, مُنبَسِط / أَمْلَس, سَوِيّ / زَوْجِيّ / حَتَّى (يفيد انتهاء الغاية؛ يفيد الغاية)\nمثال: انتظر حتى أجلس.",
 "even a little": "على الإطلاق, ولو قليلاً (إلى أي مدى كان)\nمثال: هل أنت مهتم ولو قليلاً؟",
 "even as": "بينما, في الوقت الذي (في نفس الوقت الذي)\nمثال: بينما كان يحتضر، تجادلوا حول تركته",
 "even chance": "أمر غير محسوم, احتمالية متساوية (ظاهرة لا يمكن التنبؤ بها)\nمثال: إنه أمر غير محسوم ما إذا كان سيفوز أم يخسر",
 "even number": "عَدَد زَوْجِيّ (مِقْدَار مَا يُعَدّ)\nمثال: كم عدد سكان الجزائر؟",
 "even so": "رغم ذلك, لكن (على الرغم من أي شيء مخالف (تسبق عادة التنازل))\nمثال: على الرغم من أنني خائف قليلاً، إلا أنني أود تجربتها مع ذلك",
 "even spacing": "تَبَاعُد مُنْتَظِم (انتظام التباعد)",
 "even though": "بِالرَغْم مِن",
 "even-pinnate": "زَوْجِيّ التَّرِيُّش ((عن شكل الورقة) ريشيّ بزوج من الوريقات عند القمّة)",
 "even-pinnate leaf": "ورقة ريشية زوجية (ورقة ريشية مع زوج من الوريقات عند القمة)",
 "even-tempered": "مُعْتَدِل المِزَاج, هَادِئ الطَّبْع (لا يُستثار بسهولة؛ رَزين وثابت المزاج)",
 "even-textured": "مُتَجَانِسُ الْمَلْمَسِ (ذو ملمس متساوٍ ومنتظم)",
 "even-toed": "شفعي الأصابع (من أو متعلق بـ أو ينتمي إلى الثدييات من رتبة مزدوجات الأصابع)",
 "even-toed ungulate": "شفعيات الأصابع, مزدوجات الأصابع (ثدييات مشيمية لها حوافر بعدد زوجي من الأصابع الوظيفية في كل قدم)",
 "evenfall": "أصيل, شفق (الوقت من اليوم الذي يلي غروب الشمس مباشرة)\nمثال: كان يحب الشفق",
 "evenhanded": "غَيْر مُنْحَاز, مُتَسَاوِي المُعَامَلَة (بِدُونِ تَحَيُّز أَوْ مُحَابَاة)",
 "evenhandedly": "بإنصاف, بعدل (بدون محاباة طرف واحد، بطريقة عادلة ومنصفة)\nمثال: تعاملوا بإنصاف مع بعضهم البعض",
 "evenhandedness": "إِنْصَاف (أخْذُ نِصْف الشيء أو وصول النصف؛ العَدْل والتَقْسِيم بالتساوي بدون أن يظلم أي من الطرفين)",
 "evening": "مَسَاء",
 "evening bag": "حقيبة سهرة (حقيبة يد تستخدم مع ملابس السهرة)",
 "evening clothes": "ملابس رسمية, ملابس سهرة (ملابس تُرتدى في المناسبات الرسمية المسائية)",
 "evening dress": "ملابس رسمية, ملابس سهرة (ملابس تُرتدى في المناسبات الرسمية المسائية)",
 "evening gown": "ثوب رسمي, فستان سهرة (ثوب للسهرة)",
 "evening grosbeak": "مغلظ المنقار المسائي (طائر مغلظ المنقار من أمريكا الشمالية)",
 "evening lychnis": "سيلينة بيضاء, ليخنيس أبيض (عشبة خضراء مزرقة ذات سيقان لزجة وعناقيد من الزهور البيضاء الكبيرة التي تفتح مساءً بكأس منتفخ جداً؛ توضع أحياناً في جنس ليخنيس)",
 "evening primrose": "أخدرية, زهرة الربيع المسائية",
 "evening shift": "وردية مسائية (عمال يعملون أثناء المساء (مثل من 4 مساءً إلى منتصف الليل)) / وردية مسائية (وردية العمل خلال المساء (مثل من 4 مساءً إلى منتصف الليل))",
 "evening shirt": "قميص رسمي (قميص رجالي أبيض (بمقدمة منشاة) للسهرة (عادة مع بدلة التوكسيدو))",
 "evening star": "نَجْمَة الْمَسَاء",
 "evening trumpet flower": "ياسمين أصفر, ياسمين كارولينا (كرمة خشبية سامة دائمة الخضرة في جنوب شرق الولايات المتحدة لها أزهار صفراء قمعية الشكل وعطرة)",
 "evening-snow": "ثلج المساء (نبات حولي صغير في كاليفورنيا بزهور بيضاء)",
 "eveningwear": "ملابس رسمية, ملابس سهرة (ملابس تُرتدى في المناسبات الرسمية المسائية)",
 "evenk": "تونغوس (عضو في الشعب المتحدث بالتونغوسية وهم شعب بدوي ينتشر على نطاق واسع في شرق سيبيريا؛ يرتبطون بالمانشو)",
 "evenki": "الإيفينكية, التنغوسية (اللغة التنغوسية للإيفينك في شرق سيبيريا) / إيفينكي (عضو في الشعب الذي يسكن منطقة شمال منغوليا وشرق سيبيريا)",
 "evenki language": "الإيفينكية, التنغوسية (اللغة التنغوسية للإيفينك في شرق سيبيريا)",
 "evenly": "بالتساوي, بانتظام (بطريقة مستوية ومنتظمة) / بالتساوي, بالمناصفة (بكميات أو حصص متساوية؛ بطريقة متوازنة أو محايدة)\nمثال: فصل دراسي مقسم بالتساوي بين الفتيات والفتيان",
 "evenness": "تَعَادُل, تَوَازُن (صفة كون الشيء متوازناً) / اسْتِوَاء, انْتِظَام (صفة التماثل وانعدام التباين) / زَوْجِيَّة (حالة الأعداد الزوجية (القابلة للقسمة على اثنين))",
 "evensong": "صلاة الغروب, صلاة المساء (السادسة من الساعات القانونية السبع للمكتب الإلهي؛ في وقت مبكر من المساء)",
 "event": "وَاقِعَة, حَادِثَة (مؤنث الوَاقِع، اسم فاعل للشيء المؤنث الذي وَقَعَ؛ مؤنث وَاقِع، الأمر المؤنث الحاصل)\nمثال: الصخور الواقعة تشكل خطرا على المتسلقين.",
 "event horizon": "أُفُق اَلْحَدَث ((أَفِقَ) أفَقَاً: بلغ النِّهَايَة فِي الْكَرم وَالْعلم فَهُوَ أفق وأفيق)\nمثال: طلعت الشمس فوق الأفق.",
 "event planner": "مخطط أحداث, منسق فعاليات (شخص يخطط للمناسبات الاجتماعية كمهنة (عادة للحكومة أو مسؤولي الشركات))",
 "eventful": "حافل بالأحداث, مثير (مليء بالأحداث أو الوقائع) / ذُو عَوَاقِب, مَصِيرِيّ (له قضايا أو نتائج مهمّة)\nمثال: أكثر يوم مرهق وحافل بالأحداث في حياتي",
 "eventide": "مساء (الجزء الأخير من النهار (فترة تناقص ضوء النهار من وقت متأخر بعد الظهر حتى حلول الظلام))\nمثال: استمتع بضوء المساء عبر البحيرة",
 "eventration": "تفتق الأحشاء (بروز الأمعاء عبر جدار البطن)",
 "eventuality": "اِحْتِمَال (ما يكمن توقع حدوثه. يقول الجرجاني: «الاحتمال ما لا يكون تصور طرفيه كافيًا، بل يتردد في النسبة بينهما، ويراد به الإمكان الذهني»)\nمثال: هناك احتمال أن لا ينجح.",
 "eventually": "أَخِيرًا, فِي اَلْآخِرْ",
 "ever": "يَوْمًا",
 "ever since": "مُنْذُ",
 "ever so": "جداً ((للتأكيد على الصفات) جداً)\nمثال: كانت ودودة جداً",
 "ever-changing": "دَائِمُ التَّغَيُّر, مُتَغَيِّر (يتميّز بالتغيّر المستمرّ أو الفعل المؤثّر)",
 "ever-present": "حَاضِر أَبَدًا, دَائِم الحُضُور (حاضر على الدوام)",
 "evergreen": "دائم الخضرة ((عن النباتات والشجيرات) تحمل أوراق الشجر طوال العام) / نبات دائم الخضرة (نبات له أوراق تدوم وتظل خضراء طوال العام)",
 "evergreen beech": "زان جنوبي, زان دائم الخضرة (أي من أشجار الزان المختلفة في نصف الكرة الجنوبي ذات أوراق صغيرة دائمة الخضرة عادة)",
 "evergreen bittersweet": "حلوة مرة دائمة الخضرة (شجيرة آسيوية ملتفة عريضة وكثيفة بثمار وردية؛ العديد من الأنواع الفرعية أو الأصناف)",
 "evergreen blueberry": "توت أزرق دائم الخضرة (شجيرة من شرق الولايات المتحدة لها أوراق دائمة الخضرة لامعة وثمار زرقاء مسودة)",
 "evergreen cherry": "إيسلاي, كرز هولي الأوراق (برقوق بري دائم الخضرة من كاليفورنيا بأوراق جلدية شائكة وزهور بيضاء)",
 "evergreen grass": "شوفان طويل, شوفان كاذب (عشب أوراسي معمر خشن يشبه الشوفان؛ يوجد على حواف الطرق والأراضي العشبية الوعرة وفي مروج القش؛ أدخل إلى أمريكا الشمالية كعلف)",
 "evergreen huckleberry": "عنب الأحراش دائم الخضرة (شجيرة كثيفة صلبة دائمة الخضرة من غرب أمريكا الشمالية لها توت أسود حامض وأوراق خضراء لامعة تستخدم في تنسيق الزهور)",
 "evergreen magnolia": "ماغنوليا جنوبية, ماغنوليا كبيرة الأزهار (شجرة دائمة الخضرة في جنوب الولايات المتحدة ذات أوراق لامعة صلبة كبيرة وزهور بيضاء ضخمة حلوة الرائحة)",
 "evergreen millet": "عشب جونسون, عشب حلب (عشب معمر طويل ينتشر عن طريق الجذامير الزاحفة ويزرع للعلف؛ متوطن في جنوب الولايات المتحدة حيث يعتبر آفة خطيرة في الأراضي المزروعة)",
 "evergreen oak": "بلوط هولم, سنديان أخضر (بلوط دائم الخضرة من جنوب أوروبا له أوراق تشبه إلى حد ما أوراق البهشية؛ ينتج خشباً صلباً)",
 "evergreen plant": "نبات دائم الخضرة (نبات له أوراق تدوم وتظل خضراء طوال العام)",
 "evergreen thorn": "زعرور دائم الخضرة (زعرور دائم الخضرة من جنوب شرق أوروبا)",
 "evergreen winterberry": "بهشية ملساء, توت الحبر (بهشية دائمة الخضرة من شرق أمريكا الشمالية بأوراق جلدية مستطيلة وتوت أسود صغير)",
 "evergreen wood fern": "سرخس الخشب الهامشي, سرخس الخشب دائم الخضرة (سرخس أمريكي شمالي بسعف دائم الخضرة) / سرخس الخنجر, سرخس عيد الميلاد (سرخس دائم الخضرة من أمريكا الشمالية له أوراق ريشية وعناقيد كثيفة من السعف رمحي الشكل)",
 "everlasting": "أَبَدِيّ, أَزَلِيّ (مستمرّ إلى الأبد أو إلى أجل غير مُسمًّى) / أزهار مجففة, زهرة الخلود (أي من النباتات المختلفة من أجناس مختلفة من الفصيلة النجمية ذات زهور يمكن تجفيفها دون فقدان الشكل أو اللون)",
 "everlasting flower": "أزهار مجففة, زهرة الخلود (أي من النباتات المختلفة من أجناس مختلفة من الفصيلة النجمية ذات زهور يمكن تجفيفها دون فقدان الشكل أو اللون)",
 "everlasting pea": "بازلاء دائمة, جلبان دائم",
 "everlastingly": "أبدياً, إلى الأبد (لوقت غير محدود)\nمثال: لا أحد يستطيع العيش إلى الأبد",
 "everlastingness": "أبدية, بقاء (خاصية الاستمرار إلى الأبد)",
 "evermore": "أبدياً, إلى الأبد (لوقت غير محدود) / إلى الأبد, دائماً وأبداً (في أي وقت في المستقبل؛ مستقبلاً وبشكل دائم)\nمثال: لا أحد يستطيع العيش إلى الأبد",
 "eversion": "عكس, قلب (عملية القلب من الداخل إلى الخارج) / انقلاب للخارج (وضع الانقلاب نحو الخارج)\nمثال: انقلاب القدم للخارج",
 "everting": "عكس, قلب (عملية القلب من الداخل إلى الخارج)",
 "every": "كُلّ",
 "every bit": "بالتساوي, بقدر ما (بنفس الدرجة (غالباً ما تتبع بـ 'مثل'))\nمثال: كانتا جميلتين بالتساوي",
 "every cloud has a silver lining": "رُبَّ ضارّةٍ نافِعةٌ (رَبَّ الولدَ يَرُبُّ رَبًّا: ولِيَه وتعهده بما يغذيه وينميه ويؤدّبه؛ الفاعل: رَابٌّ، والمفعول: مَرْبوبٌ، وربيبٌ)\nمثال: اعتني بي يا رب.",
 "every dog has its day": "كُلّ كَلْب بِيجِي يُومُه",
 "every inch": "بكل معنى الكلمة, تماماً (بكل الطرق؛ كلياً)\nمثال: كان رجل دولة بكل معنى الكلمة",
 "every man for himself": "كُلّ رَجُل لِنَفْسِهِ",
 "every night": "كل ليلة, ليلياً (في نهاية كل يوم)\nمثال: تتفقد ورودها ليلياً",
 "every now and then": "بين الحين والآخر\nمثال: تزور والدها بين الحين والآخر (ظرف مكان بمعنى وَسْط)\nمثال: مصيري بين يديك.",
 "every quarter": "ربع سنوياً, كل ثلاثة أشهر (في فترات كل ثلاثة أشهر)\nمثال: الفائدة مركبة ربع سنوياً",
 "every so often": "بين الحين والآخر\nمثال: تزور والدها بين الحين والآخر (ظرف مكان بمعنى وَسْط)\nمثال: مصيري بين يديك.",
 "every time": "كُلَّمَا",
 "every week": "أسبوعياً, كل أسبوع (دون تفويت أسبوع)\nمثال: زارت عمتها أسبوعياً",
 "every which way": "بشكل عشوائي, دون تمييز (بطريقة عشوائية) / بشكل عشوائي, هرج ومرج (بشكل عشوائي وغير منظم)\nمثال: كانت المنازل مبعثرة عشوائياً",
 "every year": "سنوياً, كل سنة (دون تفويت سنة)\nمثال: يسافرون إلى الصين سنوياً",
 "everybody": "اَلْجَمِيع, كُلّ شَخْص",
 "everyday": "اعْتِيَادِيّ, يَوْمِيّ (شَائِع وَعَادِيّ؛ مِنَ الحَيَاة اليَوْمِيَّة) / عَادِيّ, يَوْمِيّ (مُنَاسِبٌ لِلْمُنَاسَبَاتِ العَادِيَّةِ أَوِ الرُّوتِينِيَّةِ) / رُوتِينِيّ, يَوْمِيّ (يوجد في المجرى العادي للأحداث)",
 "everyday life": "حَيَاة يَوْمِيَّة (الحَياة: ضد الموت والحَيُّ: ضدُّ الميّت؛ والمَحْيا مَفْعَلٌ من الحياة. تقول: مَحْيَاي ومماتي. والجمع الحَحايي)\nمثال: ما أغرب الحياة!",
 "everydayness": "اعْتِيَادِيَّة, شُيُوع (العادية كنتيجة لكون الشيء متكرراً ومألوفاً)",
 "everyman": "الإنسان العادي, الشخص العادي (الشخص العادي من عامة الناس)",
 "everyone": "الْجَمِيع, كُلّ شَخْص",
 "everyplace": "في جميع الأنحاء, في كل مكان (إلى أو في أي أو كل الأماكن)\nمثال: تجد متاجر الوجبات السريعة في كل مكان",
 "everything": "كُلّ شَيْء",
 "everywhere": "فِي كُلِّ مَكَانٍ (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "everywoman": "امرأة عادية (المرأة العادية (التي تمثل عامة النساء))",
 "evict": "أَجْلَى, طَرَدَ",
 "eviction": "طَرْد",
 "evidence": "دَلِيل, بُرْهَان / دَلِيل",
 "evidenced": "مُدَعَّم بِأَدِلَّة (مُؤيَّد ومسنود بالأدلّة والبراهين)",
 "evident": "بَيِّن, مَلْحُوظ (يمكن رؤيته أو ملاحظته) / بَيِّن, جَلِيّ (مكشوف بوضوح للعقل أو الحواسّ أو الحكم)",
 "evidential": "اسْتِدْلَالِيّ, قَرَائِنِيّ (يُستخدَم كدليل أو يقوم على أساس أدلّة)",
 "evidentiary": "اسْتِدْلَالِيّ, قَرَائِنِيّ (يُستخدَم كدليل أو يقوم على أساس أدلّة) / إثباتي, بيناتي (يتعلق بـ أو يشكل دليلاً أو بينة)\nمثال: تقنية إثباتية",
 "evidently": "بوضوح, جلياً (بشكل لا لبس فيه)\nمثال: الإجابة خاطئة بوضوح",
 "evil": "شِرِّير, شَرِير (الكَثير الشَرّ بمعنى اسم جامع للرذائل، قد يستعمل كاسم فاعل؛ ضد الخَيِّر؛ يستخدم أيضا بمعنى ذو الشَرّ وما تسبب بالشرّ) / شَرّ, سَوْء (ضد الخَيْر؛ السوء والفساد والرذائل والخطايا وقيل الشرّ يضم كل الرذائل؛ اسم تفضيل، الأكثر شَرّا، أصله أشرّ وحذفت الألف) / شَرّ (ضد الخَيْر؛ السوء والفساد والرذائل والخطايا وقيل الشرّ يضم كل الرذائل؛ اسم تفضيل، الأكثر شَرّا، أصله أشرّ وحذفت الألف)\nمثال: لقد وصف سامي ليلى كشخص شرير إلى حد يكاد لا يصدق.",
 "evil eye": "عَيْن اَلْحَسُود, عين حارّة (المُعَايَنَة والمشاهدة؛ العين : حاسة البصر والرؤية - مؤنث - تكون للإنسان وغيره من الحيوان . قال ابن السكيت : العين التي يبصر بها الناظر…)\nمثال: كان عين ليلى مسودة.",
 "evil one": "اَلشِّرِّير",
 "evil spirit": "روح شريرة (روح تميل لإحداث الضرر)",
 "evil-looking": "شِرِّير المَظْهَر (ذو مظهر شرير)",
 "evil-minded": "خَبِيث النِّيَّة, سَيِّئ الطَّوِيَّة (يحمل أفكاراً أو نوايا شريرة)",
 "evildoer": "آثم, مذنب (شخص يرتكب المعاصي (دون توبة))",
 "evildoing": "تجاوز, مخالفة (فعل التجاوز؛ انتهاك قانون أو واجب أو مبدأ أخلاقي)\nمثال: عوقب الصبي بسبب تجاوزات والده",
 "evilly": "بخبث, بشكل شرير (بطريقة شريرة خبيثة)\nمثال: تصرف بخبث",
 "evilness": "سوء, شر (صفة الخطأ الأخلاقي من حيث المبدأ أو الممارسة)\nمثال: محاولات لتفسير أصل الشر في العالم",
 "evince": "أَظْهَرَ (الشيء: فعل تعدّ من ظَهَرَ؛ جعله يظهر؛ القرآن: قرأه على ظهر لسانه)\nمثال: أظهر سامي رأفة.",
 "eviscerate": "مَنْزُوعُ الْأَحْشَاء (أُزيلت أحشاؤه)",
 "evisceration": "تفريغ من المضمون (تغيير شيء ما (مثل قانون تشريعي أو بيان) بطريقة تقلل من قيمته) / إخراج الأحشاء, نزع الأحشاء (عملية إزالة الأمعاء أو الأحشاء؛ عملية القطع بحيث تبرز الأحشاء) / إفراغ الأحشاء (إزالة جراحية لعضو (أو محتويات عضو) من مريض)\nمثال: اعتماد تعديلاتهم كان سيعني تفريغ القانون من مضمونه",
 "evitable": "يُمْكِن تَجَنُّبُه, يُمْكِن تَفَادِيه (قادر على تجنبه أو صده)",
 "evocation": "استحضار (إعادة خلق خيالية) / استثارة, استحثاث (تحفيز يستدعي (يستخرج) فئة معينة من السلوكيات) / استجلباب, استحضار (استدعاء قوى خارقة مفترضة عن طريق التعاويذ والرقى)\nمثال: لم يكن استخلاص شهادته سهلاً",
 "evocative": "مُذَكِّرٌ, مُسْتَحْضِرٌ (يستحضر الذاكرة ويثير في الذهن صوراً أو معاني)",
 "evoke": "اِسْتَحْضَارَ, اِسْتَدَعَى",
 "evoked": "مُسْتَثَار, مُسْتَحْضَر (استُدعِي من حالة كامنة أو محتملة عن طريق التحفيز)",
 "evoked potential": "جهد مستثار (الاستجابة الكهربائية للجهاز العصبي المركزي الناتجة عن محفز خارجي)\nمثال: قاس الجهد المستثار بواسطة مخطط كهربية الدماغ",
 "evolution": "تَطَوُّر",
 "evolutionarily": "تطورياً, من الناحية التطورية (بطريقة تطورية؛ من وجهة نظر التطور البيولوجي)\nمثال: لقد كانت الطفرة ناجحة تطورياً",
 "evolutionary": "تطوري (من أو يتعلق بالتطور أو ناتج عنه)\nمثال: بيولوجيا تطورية",
 "evolutionary biology": "علم الأحياء التطوري (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "evolutionary developmental biology": "علم الأحياء النمائي التطوري (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "evolutionary theory": "نَظَرِيَّة التَّطَوُّر (مؤنث نَظَرْيّ، أي يفحض بالنظر لا بالإختبار؛ قضية غير مثبتة ولا مبرهنة لتفسير أمر ما)\nمثال: إنها مجرد نظرية.",
 "evolutionary trend": "اتجاه تطوري (اتجاه عام للتغير التطوري)"
}
