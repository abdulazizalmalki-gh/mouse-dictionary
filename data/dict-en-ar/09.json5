 "edam cheese": "إِيدَام",
 "edaphosaurus": "إيدافوصور (زاحف ثقيل الجسم بشراع ظهري أو عرف؛ من أواخر العصر القديم)",
 "edd": "دكتوراه في التربية (درجة الدكتوراه في التربية)",
 "edda": "إيدا (أي من العملين المتميزين في اللغة الأيسلندية القديمة اللذين يعود تاريخهما إلى أواخر القرن الثالث عشر؛ وتعد المصدر الأساسي للميثولوجيا الاسكندنافية) / قلقاس (جذر درني نشوي استوائي)",
 "eddo": "قلقاس (جذر درني نشوي صالح للأكل لنباتات القلقاس)",
 "eddy": "دُوَّامَة",
 "edecrin": "حمض الإيثاكرينيك (مدر للبول (الاسم التجاري إيديكرين) يستخدم لعلاج الوذمة)",
 "edelweiss": "إِيدِلْفَايْس",
 "edema": "استسقاء, وذمة (تورم ناتج عن تراكم مفرط للسوائل المائية في الخلايا أو الأنسجة أو التجاويف المصلية)",
 "edematous": "اسْتِسْقائِيّ, وَذَمِيّ (مُنْتَفِخ بِسَبَب تَراكُم مُفْرِط لِلسَّوائِل)",
 "eden": "جَنَّاتِ عَدْن, عَدْن",
 "edental": "شِبْهُ أَدْرَد, قَلِيل الأَسْنَان (له أسنان قليلة أو يكاد يخلو منها)",
 "edentate": "شِبْهُ أَدْرَد, قَلِيل الأَسْنَان (له أسنان قليلة أو يكاد يخلو منها) / حيوان درد, عديم الأسنان (ثديي أرضي بدائي ذو أسنان قليلة إن وجدت؛ من المناطق الاستوائية في أمريكا الوسطى وأمريكا الجنوبية)",
 "edentulate": "شِبْهُ أَدْرَد, قَلِيل الأَسْنَان (له أسنان قليلة أو يكاد يخلو منها)",
 "edentulous": "فَاقِد الأَسْنَان (فقد أسنانه بعد أن كانت له)",
 "edessa": "اَلرُّهَا",
 "edge": "حافة (جانب حاد يتكون من تقاطع سطحين لجسم ما) / حافة, طرف (الحد الخارجي لجسم أو منطقة أو سطح؛ مكان أبعد ما يكون عن مركز الشيء) / أَفْضَلِيَّة نِسْبِيَّة, تَفَوُّق بَسِيط (ميزة تنافسية طفيفة) / حدة (سمة الإلحاح في نبرة الصوت)\nمثال: قام بتدوير حواف الصندوق",
 "edge tool": "أداة ذات حد, أداة قاطعة (أي أداة قطع ذات حافة قطع حادة (مثل الإزميل أو السكين أو المسحج أو المنقار))",
 "edged": "ذُو حَافَّة مُحَدَّدَة (ذو حافة من نوع محدد) / ذُو حَدّ, مَشْحُوذ (له حافة قاطعة أو حواف من نوع معيّن؛ غالباً يُستخدم في التركيبات) / جَارِح, لَاذِع ((في الكلام) حادّ أو مؤذٍ في النبرة أو الطابع)",
 "edgeless": "بِلَا حَدّ (يَفْتَقِر إِلَى حَافَّة قَاطِعَة)",
 "edger": "قاطعة الحواف (أداة حديقة لقص العشب حول حواف الفناء) / محيّك الحواف (شخص يضع الحواف النهائية للملابس)",
 "edgeways": "بِاتِّجَاه الحَافَّة, مِن الحَافَّة (مع الحافة للأمام أو على، بواسطة، أو نحو الحافة) / بِالكِاد, بِشَقّ الأَنْفُس (كما لو كان بحافة؛ بالكاد)\nمثال: نشر اللوح من الحافة",
 "edgewise": "بِاتِّجَاه الحَافَّة, مِن الحَافَّة (مع الحافة للأمام أو على، بواسطة، أو نحو الحافة) / بِالكِاد, بِشَقّ الأَنْفُس (كما لو كان بحافة؛ بالكاد)\nمثال: نشر اللوح من الحافة",
 "edgeworth-kuiper belt": "حزام كايبر (منطقة على شكل قرص من الكواكب الصغيرة خارج مدار نبتون)",
 "edginess": "توتر, قلق (مشاعر القلق التي تجعلك متوتراً وسريع الانفعال)",
 "edging": "تزيين الحواف, حاشية (حدود تتكون من أي شيء يوضع على الحافة لإنهاء شيء ما (مثل الأهداب على الملابس أو السجاد))",
 "edgy": "حَسَّاسُ الأَعْصَاب, عَصَبِيّ (فِي حَالَةِ تَوَتُّرٍ وَانْفِعَال)",
 "edibility": "قابلية الأكل (خاصية الصلاحية للأكل)",
 "edible": "صَالِح لِلْأَكَل ((في الإسلام) نبي ورد ذكره في القرآن، أُرسل إلى قوم ثمود؛ اسم شخصي معطًى للذكور من العرب)\nمثال: قم بما هو صالح.",
 "edible asparagus": "أسبرجس, هليون (نبات تُطهى براعمه الصغيرة الغضة وتؤكل كخضروات)",
 "edible banana": "موز صالح للأكل (أنواع مزروعة على نطاق واسع من أشجار الموز تحمل عناقيد متدلية مدمجة من الفاكهة الصفراء الصالحة للأكل ذات الأهمية التجارية)",
 "edible bean": "فاصولياء, فول (أي من البذور الصالحة للأكل المختلفة لنباتات العائلة البقولية المستخدمة كغذاء)",
 "edible cockle": "كوكل صالح للأكل (كوكل أوروبي شائع صالح للأكل)",
 "edible corn": "ذرة (أكواز الذرة التي يمكن تحضيرها وتقديمها كطعام للبشر)",
 "edible fat": "دهن صالح للأكل (مادة زيتية أو دهنية تشكل الجزء الأكبر من الأنسجة الدهنية في الحيوانات والبذور والأنسجة النباتية الأخرى)",
 "edible fruit": "ثمرة مأكولة, فاكهة صالحة للأكل (جسم تكاثري صالح للأكل لنبات البذور، وخاصة الذي له لحم حلو)",
 "edible mussel": "بلح البحر المأكول (بلح بحر ذو صدفة داكنة يعيش ملتصقاً بالصخور)",
 "edible nut": "مكسرات صالحة للأكل (بذرة صلبة القشرة تتكون من نواة أو لب صالح للأكل محاط بقشرة خشبية أو جلدية)",
 "edible sea urchin": "قنفذ البحر الصالح للأكل (قنفذ بحر يمكن أكله)",
 "edible seed": "بذور صالحة للأكل (يستخدم الكثير منها كتوابل)",
 "edible snail": "حلزون صالح للأكل (أحد الحلزونات الرئيسية الصالحة للأكل)",
 "edible-pod pea": "بازلاء الثلج, بازلاء سكرية (صنف من نبات البازلاء ينتج بازلاء ذات قرون ناعمة سميكة صالحة للأكل تفتقر إلى البطانة الليفية للبازلاء الشائعة)",
 "edible-podded pea": "بازلاء الثلج, بازلاء سكرية (صنف من نبات البازلاء ينتج بازلاء ذات قرون ناعمة سميكة صالحة للأكل تفتقر إلى البطانة الليفية للبازلاء الشائعة)",
 "edibleness": "قابلية الأكل (خاصية الصلاحية للأكل)",
 "edict": "مَرْسُوم",
 "edification": "تَنْوِير",
 "edifice": "بِنَاء, مَبْنَى (ضد هَدْم. ؛ المَبْنَى أو البِنَاية) / مَدْرَسَة (الموضع الذي تُدَرَّس فيه العلوم؛ البناء فيه عدة غرف تُدَرَّسُ فيها العلوم وتمنح شهادة رسمية بعد إكمال الدروس)\nمثال: أنا وجدت البناء.",
 "edified": "مُتَنَوِّر, مُتَهَذِّب (تلقّى تعليماً وتشجيعاً في التحسّن الأخلاقي والفكري والروحي)",
 "edifying": "تثقيفي, تنويري (تنويري أو رافع للمعنويات بما يشجع على التحسن الفكري أو الأخلاقي)\nمثال: اللوحات في الكنيسة خدمت غرضاً تهذيبياً حتى لأولئك الذين لا يستطيعون القراءة",
 "edinburgh": "إِدِنْبُرَة, إِدِنْبْرَة",
 "edirne": "أَدِرْنَة",
 "edison": "إديسون",
 "edit": "تَحْرِير / حَرَّرَ, عَدَّلَ (يُصَغَّرُ عَلَى حُرَيْحٍ وَيُجْمَعُ عَلَى أَحْرَاحٍ؛ ضد الْعَبْدِ)\nمثال: هو,البارحة حرر من الحبس.",
 "edit war": "حَرْب تَحْرِير (حَرَبَ (حربه) بالحربة حربا: طعنه بها؛ حَرَبَ (ه) حربا: سلبه جميع ما يملك)\nمثال: بوتين مجرم حرب.",
 "edited": "مُحَرَّر, مُنَقَّح (حُسِّن أو صُحِّح عن طريق التحرير النقديّ)",
 "editing": "تحرير, تنقيح (وضع شيء ما (مثل عمل أدبي) في شكل مقبول)",
 "edition": "طَبْعَة",
 "editor": "مُحَرِّر (مُعْتِق؛ مُطْلِق الحُرِّيَّات ، المُنْقِد من احْتِلال أجْنبي ، من اسْتِعباد) / مُحَرِّر, مُحَرِّرَة (مُعْتِق؛ مُطْلِق الحُرِّيَّات ، المُنْقِد من احْتِلال أجْنبي ، من اسْتِعباد)\nمثال: محرر هذا المقال ناقد مشهور.",
 "editor in chief": "رئيس التحرير, محرر (شخص مسؤول عن الجوانب التحريرية للنشر؛ الشخص الذي يحدد المحتوى النهائي للنص (خاصة لصحيفة أو مجلة))",
 "editor program": "برنامج تحرير, محرر ((علم الحاسوب) برنامج مصمم لأداء وظائف تحريرية مثل إعادة ترتيب أو تعديل أو حذف البيانات)",
 "editorial": "تَحْرِيرِيّ / اِفْتِتاحِيّة, مَقَال اِفْتِتَاحِيّ",
