 "emphasised": "مُؤَكَّد, مُشَدَّد (يُنطَق بتشديد ونبر واضح)",
 "emphasize": "شَدَّدَ (الشيءَ: قَوَّاه وجعله شديدًا؛ في الأمر: بالغ فيه)",
 "emphasized": "مُؤَكَّد, مُشَدَّد (يُنطَق بتشديد ونبر واضح)",
 "emphasizing": "تأكيد, تشديد (فعل إعطاء أهمية خاصة أو دلالة لشيء ما)",
 "emphatic": "مُفَخَّم",
 "emphatically": "بالتأكيد, بشكل قاطع (بدون شك وخارج نطاق الشك)\nمثال: كان باهظ الثمن بلا شك",
 "emphysema": "انتفاخ الرئة (حالة غير طبيعية للرئتين تتميز بانخفاض وظيفة الجهاز التنفسي)",
 "emphysematous": "نفاخي (يتعلق بانتفاخ الرئة (الإمفيزيما) أو يشبهه)",
 "emphysematous gangrene": "غرغرينا غازية (شكل مميت من الغرغرينا تسببه عادة بكتيريا المطثية التي تنتج سموماً تسبب موت الأنسجة)",
 "emphysematous phlegmon": "غرغرينا غازية (شكل مميت من الغرغرينا تسببه عادة بكتيريا المطثية التي تنتج سموماً تسبب موت الأنسجة)",
 "empire": "إِمْبِرَاطُورِيَّة",
 "empire day": "24 مايو, يوم الكومنولث (بريطاني، ذكرى ميلاد الملكة فيكتوريا)",
 "empiric": "إمبيريقي, تجريبي (مستمد من التجربة والملاحظة بدلاً من النظرية) / تجريبي زائف, دجلي (يعتمد على الدجل الطبي)\nمثال: أساس تجريبي لنظرية أخلاقية",
 "empirical": "تَجْرِيبِيّ",
 "empirical formula": "صيغة أولية, صيغة تجريبية (صيغة كيميائية تظهر نسبة العناصر في مركب بدلاً من العدد الإجمالي للذرات)",
 "empirical research": "بحث تجريبي (بحث تجريبي عن المعرفة)",
 "empirically": "إمبيريقياً, تجريبياً (بطريقة تجريبية)\nمثال: يمكن اختبار هذا تجريبياً",
 "empiricism": "دجل, شعوذة طبية (ممارسة طبية ومشورة قائمة على الملاحظة والخبرة مع الجهل بالنتائج العلمية) / تجريبية (تطبيق الأساليب التجريبية في أي فن أو علم) / تجريبية, حسية ((فلسفة) المذهب القائل بأن المعرفة تُستمد من التجربة)",
 "empiricist": "تجريبي (فيلسوف يؤيد المذهب التجريبي)",
 "empiricist philosophy": "تجريبية, حسية ((فلسفة) المذهب القائل بأن المعرفة تُستمد من التجربة)",
 "empirin": "أسبرين, حمض الأسيتيل ساليسيليك (مشتق مؤستل لحمض الساليسيليك؛ يستخدم كدواء مسكن ومضاد للالتهابات (الأسماء التجارية باير وغيرها) يؤخذ عادة على شكل أقراص؛ يستخدم كخافض للحرارة ويبطئ…)",
 "emplacement": "تحديد الموقع, تمركز (فعل وضع شيء ما في مكان معين) / موضع سلاح (منشأة عسكرية تتكون من موقع مجهز لوضع سلاح)",
 "employ": "وَظَّفَ",
 "employable": "صالح للعمل, قابل للتوظيف (قادر جسدياً وعقلياً على العمل في وظيفة منتظمة ومتاح) / قابل للتوظيف (شخص مؤهل ومستعد للعمل)",
 "employed": "مستخدم, موظف (تم الاستعانة بخدماته؛ أو لديه وظيفة خاصة تلك التي تدفع أجراً أو راتباً) / مُسْتَثْمَر, مُوَظَّف (جُعِلَ ذَا فَائِدَة)\nمثال: معظم خريجينا موظفون",
 "employee": "مُوَظَّف, مُوَظَّفَة",
 "employee ownership": "مِلْكِيَّة المُوَظَّفِين (ملكية عمل تجاري من قبل الأشخاص الذين يعملون فيه)",
 "employee savings plan": "خطة ادخار الموظفين (خطة تسمح للموظفين بالمساهمة في مجمع استثماري يديره صاحب العمل)",
 "employee stock ownership plan": "خطة ملكية الأسهم للموظفين (برنامج يقوم الموظفون بموجبه بتجميع الأسهم بانتظام وقد يتولون في النهاية السيطرة على الشركة)",
 "employee turnover": "دَوَرَان المُوَظَّفِين, مُعَدَّل الدَّوَرَان (نسبة عدد العمال الذين تم استبدالهم في فترة زمنية معينة إلى متوسط عدد العمال)",
 "employee-owned business": "مؤسسة مملوكة للموظفين (مؤسسة تجارية مملوكة للأشخاص الذين يعملون فيها)",
 "employee-owned enterprise": "مؤسسة مملوكة للموظفين (مؤسسة تجارية مملوكة للأشخاص الذين يعملون فيها)",
 "employer": "رَبّ عَمَل, رَبَّة عَمَل (رَبَّ الولدَ يَرُبُّ رَبًّا: ولِيَه وتعهده بما يغذيه وينميه ويؤدّبه؛ الفاعل: رَابٌّ، والمفعول: مَرْبوبٌ، وربيبٌ)\nمثال: اعتني بي يا رب.",
 "employment": "وَظِيفَة, تَوْظِيف (ما يُقَدَّر من الشيء في زمن مُعَيَّن؛ مَنْصِب) / اِسْتِخْدَام\nمثال: ما وظيفة زوجتك؟",
 "employment agency": "وَكَالَة تَوْظِيف",
 "employment agent": "وكيل توظيف (شخص يدير وكالة توظيف)",
 "employment agreement": "عقد توظيف, عقد عمل (عقد بين صاحب العمل والموظف)",
 "employment contract": "عقد عمل (العَشْر من السَنَوَات؛ الاتِّفَاق والعَهْد بين طرفين)\nمثال: أمضى زيري العقد.",
 "employment interview": "مقابلة توظيف, مقابلة عمل (مقابلة لتحديد ما إذا كان المتقدم مناسبًا لوظيفة)",
 "employment office": "مكتب عمل, وكالة توظيف (وكالة تجد أشخاصاً لشغل وظائف معينة أو تجد وظائف للعاطلين عن العمل)",
 "emporium": "سوق مركزي, متجر متعدد الأقسام (متجر تجزئة كبير منظم في أقسام تقدم مجموعة متنوعة من البضائع؛ عادة ما يكون جزءاً من سلسلة متاجر)",
 "empowered": "ذُو صَوْلَجَان, مُمَكَّن (مُستَثمَر بالسلطة القانونية أو الرسمية خاصة كما يرمز إليه الصولجان)",
 "empowerment": "تَمْكِين",
 "empress": "إِمْبِرَاطُورَة, مَلِكَة / إِمْبْرَاطُورَة, زَوْجَةْ إِمِبْرَاطُور",
 "empress dowager": "إِمْبِرَاطُورَة الأُمّ",
 "emptiness": "بُطْلَان, غُرُور (صفة كون الشيء عديم القيمة أو عبثياً) / خلاء, فراغ (منطقة أو مساحة فارغة) / خواء (حالة وجود معدة فارغة) / خواء, فراغ (حالة عدم احتواء أي شيء)\nمثال: رفض مغريات العالم الباطلة",
 "emptor": "مبتاع, مُشتَرٍ (شخص يقوم بالشراء)",
 "empty": "فَارِغ / فَرَغَ",
 "empty nester": "والد غادر أبناؤه المنزل (والد كبر أطفاله وغادروا المنزل)",
 "empty talk": "خِطَابَة جَوْفَاء, كَلَام مُنَمَّق (كلام صاخب ومشوش وفارغ)\nمثال: مجرد خطاب منمق",
 "empty tomb": "ضريح أجوف, قبر رمزي (نصب تذكاري يُبنى لتكريم أشخاص دُفنت رفاتهم في مكان آخر أو لم يتم العثور عليها)",
 "empty words": "خِطَابَة جَوْفَاء, كَلَام مُنَمَّق (كلام صاخب ومشوش وفارغ)\nمثال: مجرد خطاب منمق",
 "empty-bellied": "خَاوِي البَطْن, فَارِغ المَعِدَة (بحاجة إلى غذاء)",
 "empty-handed": "فَارِغ اليَدَيْن (لَا يَحْمِلُ شَيْئًا فِي يَدَيْه) / خَالِي الوِفَاض, صِفْر اليَدَيْن (لم يكتسب أو يحصل على شيء)",
 "empty-headed": "تَافِه, طَائِش (يفتقر إلى الجدّية؛ ميّال إلى التفاهة والاستخفاف)",
 "emptying": "إخلاء, إفراغ (عملية إزالة محتويات شيء ما)",
 "empurpled": "مُبَالَغٌ فِي تَزْيِينِه, مُتَكَلَّف (مُبالَغ فيه بشكل مفرط أو مُعبَّر عنه بتصنُّع)",
 "empyema": "تجمع قيحي, دبيلة (تجمع للقيح في تجويف الجسم (خاصة في تجويف الرئة))",
 "empyreal": "جَلِيل, سَامٍ (يبعث على الرهبة والإجلال؛ عُلْوِيّ) / سماوي, ملكوتي (مكون من أو متعلق بالسماء أو السماوات)\nمثال: الكرة السماوية",
 "empyrean": "جَلِيل, سَامٍ (يبعث على الرهبة والإجلال؛ عُلْوِيّ) / سماوي, ملكوتي (مكون من أو متعلق بالسماء أو السماوات) / القبة السماوية, سماء (السطح الظاهري للكرة الوهمية التي تبدو الأجرام السماوية مسقطة عليها)\nمثال: الكرة السماوية",
 "emser salt": "ملح إمس, ملح إمس الطبيعي (ملح ينتج من المياه المعدنية في باد إمس، ويستخدم كدواء لأمراض الجهاز التنفسي العلوي)\nمثال: الغرغرة بماء ملح إمس طريقة سريعة لعلاج الحلق المصاب بالعدوى",
 "emu": "دُرْمِيس أُسْتُرَالِيّ",
 "emu novaehollandiae": "إيمو (طائر أسترالي كبير لا يطير يشبه النعامة ولكنه أصغر)",
 "emulate": "ضَاهَى / قَلَّدَ, حَاكَى",
 "emulation": "اقتداء, محاكاة (الجهد المبذول لمساواة أو التفوق على آخر) / محاكاة ((علم الحاسوب) تقنية تمكن آلة من الحصول على نفس نتائج آلة أخرى) / مضاهاة, منافسة (طموح للمساواة أو التفوق)",
 "emulator": "مُحَاكٍ",
 "emulous": "مُتَبَارٍ, مُنَافِس (حريص على التفوّق على الآخرين ومنافستهم) / مباري, منافس (يتميز بـ أو ينشأ عن المنافسة أو التقليد)",
 "emulously": "بِتَنَافُس, بِمُحَاكَاة تَنَافُسِيَّة (بطريقة تقليد تنافسي)\nمثال: حاولت بمحاكاة تنافسية أن تتفوق على أختها الكبرى",
 "emulsifier": "عامل استحلاب, مستحلب (مادة خافضة للتوتر السطحي تعزز تكوين المستحلب)",
 "emulsion": "مُسْتَحْلَب",
 "emunctorium": "مطهّر, منديل التطهير (قماش كتاني أبيض يستخدم لمسح الكأس بعد تناول كل متناول للقربان)",
 "en": "إِن (يفيد التوكيد)\nمثال: إن شاء الله ؛",
 "en bloc": "بشكل جماعي, معاً (الجميع معاً)\nمثال: خرج الطلاب بشكل جماعي",
 "en clair": "بِلُغَة وَاضِحَة (بلغة عادية)",
 "en dash": "شرطة إن, شرطة متوسطة",
 "en deshabille": "مُبْتَذَل اللِّبَاس (يرتدي ملابس فضفاضة أو مهملة جزئياً)",
 "en famille": "أُسَرِيًّا, عَبْر العَائِلَة (بطريقة غير رسمية في المنزل)\nمثال: سنتناول العشاء عائلياً",
 "en garde": "اِحْتَمِ, اِحْتَمِي",
 "en masse": "بشكل جماعي, معاً (الجميع معاً)\nمثال: خرج الطلاب بشكل جماعي",
 "en passant": "أَخْذٌ بِالتَّجَاوُز (تَنَاوَلَ الشيء بيده، تملكه أو تحكم فيه، بالقوة أو بدونها؛ أمْسَكَ بِالشيء. (يتعدى بالباء)) / الأخذ بالتجاوز\nمثال: أخذ الولد يبكي.",
 "en route": "فِي طَرِيق, فِي مَسِيرَة (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "enabling": "تمكيني, مخوِّل (توفير السلطة القانونية أو العقوبة)\nمثال: قرار تمكيني",
 "enabling act": "بند تمكيني, قانون تمكيني (حكم في قانون يمنح المسؤولين المناسبين سلطة تنفيذ أو إنفاذ القانون)",
 "enabling clause": "بند تمكيني, قانون تمكيني (حكم في قانون يمنح المسؤولين المناسبين سلطة تنفيذ أو إنفاذ القانون)",
 "enabling legislation": "تشريع تمكيني (تشريع يمنح المسؤولين المختصين سلطة تنفيذ أو إنفاذ القانون)",
 "enactment": "تجسيد, تقمص (تمثيل دور شخصية على المسرح؛ تمثيل الشخصية بشكل درامي عن طريق الكلام والفعل والإشارة) / إقرار, سن (تمرير قانون من قبل هيئة تشريعية) / تشريع, قانون (وثيقة قانونية تدون نتيجة مداولات لجنة أو جمعية أو هيئة تشريعية)",
 "enalapril": "إنالابريل, فاسوتيك (مثبط للإنزيم المحول للأنجيوتنسين (الاسم التجاري فاسوتيك) يمنع تكوين الأنجيوتنسين في الكلى وبالتالي يؤدي إلى توسع الأوعية؛ يعطى بعد النوبات القلبية)",
 "enallage": "التفات (استبدال جزء من الكلام أو الجنس أو العدد أو الزمن إلخ (مثل 'نحن' التحريرية بدلاً من 'أنا'))",
 "enamel": "مِينَاء",
 "enamelware": "أواني مطلية بالمينا (أداة طهي من الحديد المطلي بالمينا)",
 "enamine": "إينامين",
 "enamored": "عَاشِق",
 "enamoredness": "عشق, غرام (شعور بالحب أو الولع)",
 "enanthem": "طفح باطن (طفح على غشاء مخاطي (مثل داخل الفم) يحدث كعَرَض لمرض)",
 "enanthema": "طفح باطن (طفح على غشاء مخاطي (مثل داخل الفم) يحدث كعَرَض لمرض)",
 "enantiomer": "مُتَصَاوِغ اِنْعِكَاسِيّ, مُتَصَاوِغ مِرْآتِيّ",
 "enantiomorph": "إينانتيومر, متخايل (واحد من زوج من المركبات (بلورات أو جزيئات) التي تكون صور مرآة لبعضها البعض ولكنها غير متطابقة)",
 "enantiomorphism": "تَمَاثُل مِرْآتِيّ, صُورَة مِرْآتِيَّة (علاقة التقابل بين البلورات أو الجزيئات التي تكون انعكاسات لبعضها البعض)",
 "enarthrodial joint": "مفصل كروي, مفصل كروي وحقي (مفصل حر الحركة تتناسب فيه كرة على رأس عظم مع تجويف دائري في العظم الآخر)",
 "enarthrosis": "مفصل كروي, مفصل كروي وحقي (مفصل حر الحركة تتناسب فيه كرة على رأس عظم مع تجويف دائري في العظم الآخر)",
 "enate": "أُمَوِيّ, مِنْ جِهَةِ الْأُمِّ (مرتبط من جهة الأم) / قريب من جهة الأم (شخص قريب من ناحية الأم)",
 "enatic": "أُمَوِيّ, مِنْ جِهَةِ الْأُمِّ (مرتبط من جهة الأم)",
 "enation": "بروز نباتي, نتوء نباتي (بروز طبيعي أو نتوء من جسم النبات أو عضو فيه) / نَسَب أُمُومِيّ (خط النسب المتتبع عبر جانب الأم من العائلة)",
 "enbrel": "إنبريل, إيتانيرسبت",
 "encainide": "إنكايد, إنكاينيد (دواء مضاد لاضطراب النظم (الاسم التجاري إنكايد) يستخدم لعلاج عدم الانتظام المهدد للحياة ولكنه يزيد من خطر الموت المفاجئ لدى مرضى النوبات القلبية)",
 "encampment": "مَحَلَّة, مُخَيَّم (ما دون الحَيّ وفوق المَنْزِل. قيل قرابة مئة بيت ومجلس ومسجد؛ تقسيم إداري للمناطق السكنية في المدن. أصغر من الحيّ وأكبر من الزُقَاق)",
 "encapsulation": "تغليف, كبسلة (عملية التغليف (كما في كبسولة)) / تغليف, تكبسيل (حالة الانغلاق (كما في كبسولة))\nمثال: تغليف الأوتار في أغلفة غشائية",
 "encased": "مُحَاط بِغِلَاف, مُغَلَّف (مُغطّى أو محميّ بغلاف أو ما يُشبهه)",
 "encasement": "تغليف (عملية إحاطة شيء ما في غلاف أو علبة)",
 "encaustic": "إنكوستيك, طلاء شمعي (طلاء يتكون من صبغة ممزوجة بشمع العسل المذاب؛ يتم تثبيته بالحرارة بعد التطبيق)",
 "enceinte": "حُبْلَى فِي شَهْرِهَا الأَخِير, عَلَى وَشْك الوِلَادَة (في مرحلة متقدمة من الحمل)",
 "enceladus": "إِنْسِيلَادُوس",
 "encelia farinosa": "إنسيليا دقيقية, شجيرة هشة (شجيرة مستديرة عطرية في جنوب غرب الولايات المتحدة والمكسيك المجاورة لها سيقان هشة وأوراق صغيرة مزدحمة زرقاء مخضرة وأزهار صفراء؛ تنتج راتنجاً يستخدم في…)",
 "enceliopsis nudicaulis": "إنسيليوبسيس, شعاع الشمس (عشب له كتلة قاعدية من الأوراق الرمادية المخضرة وسيقان خالية من الأوراق تحمل كل منها رأس زهرة صفراء عريضة وحيدة؛ المناطق الصحراوية من أيداهو إلى…)",
 "encephalartos": "إنسيفالارتوس (أي من السيكاديات العديدة من جنس إنسيفالارتوس لها جذوع أسطوانية قوية وتاج طرفي من الأوراق الريشية الطويلة الشائكة غالباً)",
 "encephalartos caffer": "إنسيفالارتوس كافر, خبز الكافر (سيكاد من جنوب إفريقيا؛ يستخدم لب الثمرة النشوي كغذاء)",
 "encephalitis": "التهاب الدماغ (التهاب الدماغ عادة ما يسببه فيروس؛ تشمل الأعراض الصداع وألم الرقبة والنعاس والغثيان والحمى)",
 "encephalitis lethargica": "التهاب الدماغ السباتي, مرض النوم (التهاب دماغ كان وبائياً بين عامي 1915 و1926؛ تشمل الأعراض شلل عضلة العين الخارجية وضعف عضلي شديد)",
 "encephalocele": "قيلة دماغية (بروز أنسجة الدماغ من خلال شق خلقي في الجمجمة)",
 "encephalogram": "تصوير الدماغ بالغاز, مخطط الدماغ (أشعة سينية للدماغ تُجرى باستبدال السائل النخاعي بغاز (عادة الأكسجين) لتحسين التباين) / تخطيط الدماغ, مخطط كهربية الدماغ (سجل بياني للنشاط الكهربائي للدماغ؛ ينتجه جهاز تخطيط كهربية الدماغ)",
 "encephalograph": "تخطيط كهربائية الدماغ, جهاز تخطيط الدماغ (أي جهاز يستخدم لإنتاج مخطط للدماغ عن طريق تسجيل التيارات الكهربائية التي يولدها الدماغ)",
 "encephalography": "تصوير الدماغ (تصوير الدماغ بالأشعة السينية بعد استبدال السائل الشوكي بغاز (عادة الأكسجين))",
 "encephalomeningitis": "التهاب السحايا والدماغ (التهاب الدماغ والحبل الشوكي وسحاياهما)",
 "encephalomyelitis": "التهاب الدماغ والنخاع (التهاب الدماغ والحبل الشوكي)",
 "encephalon": "دماغ (ذلك الجزء من الجهاز العصبي المركزي الذي يشمل جميع المراكز العصبية العليا؛ محاط بالجمجمة؛ متصل بالحبل الشوكي)",
 "encephalopathy": "اضطراب دماغي, اعتلال دماغي (أي اضطراب أو مرض في الدماغ)",
 "enchained": "مُقَيَّد بِالسَّلَاسِل (مربوط بالسلاسل)",
 "enchanted": "مسحور, مفتون (واقع تحت تأثير السحر أو التعاويذ)",
 "enchanter": "ساحر (مشعوذ أو ساحر)",
 "enchanter's nightshade": "عشبة الساحر (أي من الأعشاب المعمرة المنتصبة الجذمورية المتعددة من جنس سيرسيا ذات أزهار بيضاء تتفتح عند الفجر؛ نصف الكرة الشمالي)",
 "enchanting": "آسِر, سَاحِر (يأسر الاهتمام كأنّه يسحر سحرًا)",
 "enchantingly": "بِسِحْر, بِفِتْنَة (بطريقة ساحرة)\nمثال: كانت جميلة بشكل ساحر",
 "enchantingness": "سحر, فتنة (جودة امتلاك القدرة على السحر؛ كون الشخص ساحراً ومبهجاً)",
 "enchantment": "تعويذة, رقية سحرية (تعويذة سحرية) / افتتان, انبهار (شعور بإعجاب كبير بشيء رائع وغير عادي) / انفتان, ذهول (حالة نفسية ناجمة (أو كأنها ناجمة) عن تعويذة سحرية)",
 "enchantress": "ساحرة (أنثى تمارس السحر) / فاتنة, مغوية (امرأة تعتبر مغرية بشكل خطير)",
 "enchilada": "إنتشلادا (تورتيلا بحشوة لحم مخبوزة في صلصة طماطم متبلة بالفلفل الحار)",
 "enchiridion": "دليل, كتيب إرشادي (كتاب مرجعي موجز يوفر معلومات محددة حول موضوع أو موقع)",
 "enchondroma": "ورم غضروفي باطني (ورم حميد بطيء النمو يتكون من خلايا غضروفية في نهايات العظام الأنبوبية (خاصة في اليدين والقدمين))",
 "encircled": "مُحَاصَر, مُطَوَّق (محاط من جميع الجوانب)",
 "encirclement": "تطويق, حصار (إجراء حربي يعزل منطقة ذات أهمية للعدو)",
 "enclave": "جيب, منطقة مكتنفة (إقليم محاط بأراضٍ أجنبية يختلف عنها ثقافياً)",
 "enclitic": "مُتَّصِل, مُحَاط",
 "enclosed": "محاط, مرفق (مقفول عليه أو محاط أو متضمن في الداخل)\nمثال: شرفة مغلقة",
 "enclosed space": "تجويف, حيز مغلق (مساحة محاطة بشيء ما)",
 "enclosing": "إحاطة, تغليف (عملية إحاطة شيء داخل شيء آخر)",
 "enclosure": "إحاطة, تغليف (عملية إحاطة شيء داخل شيء آخر) / حظيرة, مسيَّج (هيكل يتكون من منطقة تم تطويقها لغرض ما) / طية, مرفق (شيء ما (عادة وثيقة داعمة) يتم إرفاقه في ظرف مع رسالة تغطية) / حيز طبيعي مغلق, مكان مغلق (مساحة مغلقة بشكل طبيعي)",
 "encoding": "تَرْمِيز, إِنْكُودِينْغ",
 "encolure": "عُرْفُ الحِصَان (شعر رقبة الحصان)",
 "encomiastic": "تَمْجِيدِيّ, مَدَائِحِيّ (يُعَبِّر عن الثناء بشكل رسمي)",
 "encomium": "ثَنَاء",
 "encompassing": "شَامِل, وَاسِعُ النِّطَاق (واسع في نطاقه أو محتواه؛ يغطّي مجالات عديدة)",
 "encompassment": "إحاطة, شمول (الشمول التام)",
 "encopresis": "تبرز لاإرادي, سلس البراز (تبرز لا إرادي لا يعزى إلى عيوب جسدية أو مرض)",
 "encore": "فقرة إضافية (أداء إضافي أو متكرر؛ يُعطى عادة استجابة لطلب الجمهور)",
 "encounter": "صَادَفَ, لَاقَى (لَقِيَ، وَافَقَ، وَجَدَ؛ وَاجَهَ، لَاقَى، وَجَدَ) / مُلَاقَاة, مُقَابَلَة (لِقَاء)\nمثال: صادف مشكلا صعبا.",
 "encounter group": "مَجْمُوعَة مُوَاجَهَة (اجتماع لأشخاص لتطوير التفاهم المتبادل من خلال التعبير الحر عن المشاعر)",
 "encourage": "شَجَّعَ (حفَّز شخصًا أو دعمه لتحقيق هدف أو القيام بعمل؛ بثَّ الحماس أو الثقة في نفس شخص)\nمثال: شجع سامي ليلى لتفعل ذلك.",
 "encouraged": "مُشَجَّع, مُلْهَم بِالثِّقَة (مفعم بالثقة والتشجيع)",
 "encouragement": "تشجيع, دعم (فعل إعطاء الأمل أو الدعم لشخص ما) / تشجيع (التعبير عن الموافقة والدعم) / تشجيع (الشعور بالتشجيع)",
 "encouraging": "مشجع (يعطي الشجاعة أو الثقة أو الأمل) / مُسَانِد, مُشَجِّع (يقدم الدعم والتشجيع)\nمثال: تطورات مشجعة في الأبحاث الطبية",
 "encouragingly": "بِتَشْجِيع, بِشَكْل مُشَجِّع (بطريقة مشجعة)\nمثال: 'استمر'، قال بتشجيع لطالبه",
 "encroach": "اِخْتَلَسَ, أَزْعَجَ",
 "encroacher": "غازٍ, محتل (شخص يدخل بالقوة بهدف الغزو أو السيطرة)",
 "encroachment": "تأثير, تعدي (التأثير بقوة) / انتهاك حرمة, تجاوز (دخول ممتلكات شخص آخر دون حق أو إذن) / اجتياح, تطفل (أي دخول إلى منطقة لم تكن مشغولة سابقاً)\nمثال: استاءوا من طغيان القيم الأمريكية على الثقافة الأوروبية",
 "encrustation": "تغطية قشرية (طلاء زخرفي من مادة مغايرة يوضع على سطح كتطعيم أو طبقة خارجية) / طَبَقَة صُلْبَة, قِشْرَة (طبقة خارجية صلبة تغطي شيئاً ما) / تقشر, تكون قشرة (تكون قشرة)",
 "encrusted": "ذُو قِشْرَة صُلْبَة, مُتَقَشِّر (ذو قشرة صلبة كغطاء)",
 "encryption": "ترميز, تشفير (نشاط تحويل البيانات أو المعلومات إلى رمز)",
 "enculturation": "تطبع اجتماعي, تنشئة اجتماعية (تبني أنماط سلوك الثقافة المحيطة)\nمثال: التنشئة الاجتماعية للأطفال وفقاً لمعايير ثقافتهم",
 "encumbered": "مثقل, محمل (محمل بشكل زائد أو معاق بحمل ثقيل)\nمثال: منتجع صيفي ؛ مثقل بفنادق كبيرة من الألواح الخشبية والجص",
 "encumbrance": "عائق, مانع (أي عائق يعرقل أو يكون مرهقاً) / ثقل, حمل (اهتمام شاق أو صعب) / رهن, عبء (حق للغير على الممتلكات (مثل حق الحجز أو الرهن العقاري))\nمثال: عبء المسؤولية",
 "encyclia citrina": "أوركيد التوليب (أوركيد هوائي مكسيكي بأوراق خضراء رمادية مزرقة وزهور ليمونية إلى صفراء ذهبية تظهر مفتوحة جزئياً فقط؛ يوضع أحياناً في جنس كاتليا)",
 "encyclia tampensis": "أوركيد الفراشة (أوركيد فلوريدا وجزر البهاما ذو زهور زاهية الألوان مبهرجة؛ يوضع أحياناً في جنس إبيدندروم)",
 "encyclia venosa": "أوركيد الفراشة (أوركيد هوائي مكسيكي ذو زهور خضراء شاحبة أو خضراء مصفرة بشفة بيضاء معرقة بالأرجواني)",
 "encyclical": "تَعْمِيمِيّ, دَوْرِيّ (مُعَدٌّ لِلتَّوْزِيعِ الوَاسِعِ) / رسالة بابوية (رسالة من البابا ترسل إلى جميع الأساقفة الكاثوليك في جميع أنحاء العالم)",
 "encyclical letter": "رسالة بابوية (رسالة من البابا ترسل إلى جميع الأساقفة الكاثوليك في جميع أنحاء العالم)",
 "encyclopaedia": "دائرة معارف, موسوعة (عمل مرجعي (غالباً في عدة مجلدات) يحتوي على مقالات حول مواضيع مختلفة (مرتبة غالباً بترتيب أبجدي) تتناول كامل نطاق المعرفة البشرية أو تخصصاً معيناً)",
 "encyclopaedic": "مَوْسُوعِيّ (شامل في نطاقه أو محتواه كالموسوعة)",
 "encyclopaedism": "تبحر, سعة اطلاع (معرفة علمية عميقة)",
 "encyclopaedist": "موسوعي (شخص يجمع المعلومات للموسوعات)",
 "encyclopedia": "مَوْسُوعَة, دَائِرَة مَعَارِف (مُعْجَمٌ ضَخْمٌ يَضُمُّ مَعْلُومَاتٍ وَافِيَةً ومُرَكَّزَةً عَنِ الْمَعَارِفِ الإِنْسَانِيَّةِ مُرَتَّبَةً تَرْتِيباً أَبَجَدِيّاً أَوْ حَسَبَ…)\nمثال: موسوعة رحلات العرب والمسلمين.",
 "encyclopedic": "مَوْسُوعِيّ",
 "encyclopedism": "تبحر, سعة اطلاع (معرفة علمية عميقة)",
 "encyclopedist": "مَوْسُوعِيّ",
 "encysted": "متكيس (محاط بكيس (أو كما لو كان في كيس))",
 "end": "نِهَايَة, غَايَة / غَايَة / اِنْتَهَى, أَنْهَى (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات)\nمثال: انتهى أمر زيري.",
 "end game": "نهاية اللعبة (المراحل النهائية من لعبة الشطرنج بعد إزالة معظم القطع من الرقعة) / مرحلة نهائية, نهاية اللعبة (المراحل النهائية لعملية تفاوض ممتدة)\nمثال: المرحلة النهائية الدبلوماسية",
 "end man": "رجل الطرف (رجل في أحد طرفي صف من الناس) / رجل الطرف (رجل في أحد طرفي صف المؤدين في عرض المنستريل؛ يجري حواراً فكاهياً مع المحاور)",
 "end matter": "الملحقات الختامية, ذيل الكتاب (مادة مكتوبة تلي المتن الرئيسي لكتاب)",
 "end of the world": "نِهَايَةُ الْعَالَم, الْقِيَامَة",
 "end on": "بِالنِّهَايَة نَحْو الأَمَام, مِن النِّهَايَة (مع النهاية للأمام أو نحو المراقب)\nمثال: منازل مبنية من النهاية",
 "end organ": "عضو نهائي (هيكل متخصص في النهاية المحيطية لبعض الألياف العصبية الحركية أو الحسية)",
 "end point": "محطة أخيرة, نقطة نهاية (مكان ينتهي فيه شيء أو يكتمل) / محصلة, نقطة النهاية (النقطة النهائية في عملية ما)",
 "end product": "مخرجات, منتج نهائي (المنتج النهائي؛ الأشياء المنتجة)",
 "end run": "اكتساح, ركض جانبي ((كرة القدم الأمريكية) محاولة لتقديم الكرة عن طريق الركض حول نهاية الخط)",
 "end user": "مستخدم نهائي",
 "end-all": "المنتهى, غاية الغايات (الهدف النهائي والأسمى)\nمثال: البشر ليسوا غاية التطور النهائية",
 "end-plate": "صفيحة نهائية, صفيحة نهائية حركية (النهاية المسطحة للعصبون الحركي التي تنقل النبضات العصبية إلى العضلة)",
 "end-rhymed": "مُقَفًّى آخِرِيًّا (مُقَفًّى على المقاطع الأخيرة من الأبيات)",
 "end-stopped": "مقفى النهاية, موقوف ((عن الشعر) له وقفة بلاغية في نهاية كل سطر)",
 "end-to-end": "بالكامل, من البداية إلى النهاية (من الأول إلى الأخير) / مِن طَرَف إِلَى طَرَف (بِحَيْث يَتَلامَس طَرَف شَيْء مَع طَرَف شَيْء آخَر طولِيًّا)\nمثال: المسرحية كانت ممتازة من البداية إلى النهاية",
 "endaemonism": "مذهب السعادة (نظام أخلاقي يقيم الأفعال بالإشارة إلى الرفاهية الشخصية من خلال حياة قائمة على العقل)",
 "endameba": "متحولة داخلية (أي أميبا من جنس المتحولة الداخلية)",
 "endamoeba histolytica": "متحولة حالة للنسج (الأميبا الطفيلية التي تسبب الزحار الأميبي في البشر)",
 "endangered": "مُهَدَّدٌ بِالاِنْقِرَاض ((عن النباتات أو الحيوانات) فِي خَطَرٍ وَشِيكٍ بِالاِنْقِرَاض)",
 "endangered species": "نوع مهدد بالانقراض (نوع تكون أعداده صغيرة جداً بحيث يكون معرضاً لخطر الانقراض)",
 "endangerment": "خطر, مجازفة (مصدر للخطر؛ احتمالية تكبد خسارة أو مصيبة)\nمثال: شرب الكحول خطر صحي",
 "endarterectomy": "استئصال باطنة الشريان (إزالة جراحية للبطانة الداخلية للشريان المسدود بتصلب الشرايين)",
 "endarteritis": "التهاب بطانة الشريان (التهاب البطانة الداخلية للشريان)",
 "endband": "حبكة الكتاب, شريط الرأس للكتاب (جزء من الكتاب، يوجد غالباً مع الأغلفة الصلبة، يتكون من حبل صغير أو شريط من المواد مثبت بالقرب من الكعب لتوفير تعزيز هيكلي وأحياناً تأثير زخرفي)\nمثال: عند استخدام أشرطة الرأس لأغراض زخرفية فقط، يمكن لصقها في مكانها بدلاً من خياطتها، وإن كان ذلك على حساب قوة التعزيز",
 "endearing": "جَذَّاب, فَاتِن (محبوب خاصة بطريقة طفولية أو ساذجة)",
 "endearingly": "بِشَكْل بَدِيع, بِفِتْنَة (بطريقة رائعة)\nمثال: تصرف الطفل الصغير بشكل رائع",
 "endearment": "تحبب, تودد (فعل إظهار العاطفة)",
 "endeavor": "مُحَاوَلَة, غَايَة (بذل الجهد أو السعي لتحقيق هدف أو الوصول إلى نتيجة معينة؛ التجربة أو القيام بشيء ما للحصول على نتيجة مرغوبة)\nمثال: كف عن المحاولة.",
 "endeavour": "جهد, محاولة (نشاط جاد وواعي يهدف إلى فعل أو إنجاز شيء ما) / مسعى, مشروع (مشروع هادف أو كادح (خاصة المشروع الذي يتطلب جهداً أو جرأة))\nمثال: بذل جهدًا لتغطية جميع مواد القراءة",
 "ended": "تَامّ, مُنْتَهٍ (بَلَغَ خِتَامَهُ أَوْ وَصَلَ إِلَى نِهَايَتِهِ)",
 "endemic": "مُتَوَطِّن",
 "endemic disease": "مرض متوطن (مرض موجود باستمرار بدرجة أكبر أو أقل في أشخاص من طبقة معينة أو في أشخاص يعيشون في موقع معين)",
 "endemic typhus": "تيفوس الفئران, تيفوس متوطن (عدوى حادة تسببها الريكتسيا وتنتقل عن طريق لدغة برغوث مصاب؛ تتميز بالحمى والقشعريرة وآلام العضلات والطفح الجلدي)",
 "endemical": "متوطن (من أو يتعلق بمرض (أو أي شيء يشبه المرض) موجود باستمرار بدرجة أكبر أو أقل في منطقة معينة)\nمثال: أمراض متوطنة في المناطق الاستوائية",
 "endemism": "أَصَالَة, تَوَطُّن (الأصلية بحكم النشأة أو الحدوث الطبيعي (كما في مكان معين))",
 "endergonic": "مَاصّ لِلْطَّاقَة ((الكيمياء الحيوية) لعملية مصحوبة بـ أو تتطلب امتصاص الطاقة؛ نواتج العملية ذات طاقة حرة أكبر من المتفاعلات)\nمثال: التمثيل الضوئي هو عملية ماصة للطاقة",
 "endermatic": "عبر الجلد (يعمل عن طريق الامتصاص عبر الجلد)\nمثال: مرهم يُمتص عبر الجلد",
 "endermic": "عبر الجلد (يعمل عن طريق الامتصاص عبر الجلد)\nمثال: مرهم يُمتص عبر الجلد",
 "endgame": "نهاية اللعبة (المراحل النهائية من لعبة الشطرنج بعد إزالة معظم القطع من الرقعة) / مرحلة نهائية, نهاية اللعبة (المراحل النهائية لعملية تفاوض ممتدة)\nمثال: المرحلة النهائية الدبلوماسية",
 "ending": "إنهاء, خاتمة (فعل إنهاء شيء ما) / خاتمة, نهاية (نهاية الكلمة (لاحقة أو نهاية تصريفية أو مورفيم نهائي)) / خاتمة, نهاية (القسم الأخير من اتصال ما) / إنهاء, ختام (حدث ينهي وقوعه شيئاً ما)\nمثال: إنهاء الاتفاقية",
 "endive": "هِنْدِبَاء",
 "endless": "حَلَقِيّ, لَا نِهَائِيّ (مُتَّصِلُ الأَطْرَافِ بِحَيْثُ يُشَكِّلُ كُلًّا مُتَّصِلًا) / أَبَدِيّ, سَرْمَدِيّ (لَيْسَ لَهُ بِدَايَةٌ مَعْرُوفَةٌ وَلَا نِهَايَةٌ مُفْتَرَضَةٌ) / لَا نِهَائِيّ, لَا يُحْصَى (عَظِيمٌ بِلَا حُدُودٍ فِي العَدَدِ) / لَا نِهَائِيّ, لَا يَنْتَهِي (طَويل بِشَكْل مُمِلّ؛ يَبْدو بِلا نِهايَة)",
 "endlessly": "إِلى مَا لَا نِهَايَة, بِلَا نِهَايَة (الاستمرار للأبد دون توقف) / بِلَا انْقِطَاع, بِلَا تَوَقُّف (بعزيمة لا تكل) / إِلَى مَا لَا نِهَايَة (طوال الوقت؛ يبدو بلا توقف) / إلى ما لا نهاية, بلا نهاية ((بالمعنى المكاني) يبدو أنه ليس له حدود)\nمثال: هناك احتمالات لا حصر لها",
 "endlessness": "ديمومة, لا نهائية (خاصية كونه (أو يبدو أنه) بلا نهاية)",
 "endmost": "طرفي, نهائي (كائن أو واقع في النهاية أو الطرف)\nمثال: العمود الطرفي",
 "endoblast": "أديم باطن, الأرومة الباطنة (الطبقة المنتشة الداخلية التي تتطور لتشكل بطانة الجهاز الهضمي والتنفسي)",
 "endocarditis": "التهاب الشغاف (التهاب الشغاف وصمامات القلب)",
 "endocardium": "شُغاف",
 "endocarp": "الغِلاف الدَّاخِلِيّ, عَجْمَة (الطبقة الداخلية الصلبة (عادة خشبية) لغلاف الثمرة في بعض الفواكه (كالخوخ أو البرقوق أو الكرز أو الزيتون) والتي تحتوي على البذرة)\nمثال: يجب إزالة النوى من البرقوق قبل الطهي",
 "endocentric": "داخلي المركز ((في النحو) يؤدي الدور النحوي لأحد مكوناته)\nمثال: عندما تعمل 'ثلاثة فئران عمياء' كاسم فهي تركيب داخلي المركز",
 "endocentric compound": "مركب داخلي المركز (مركب له نفس الوظيفة النحوية في الجملة مثل أحد مكوناته المباشرة)",
 "endocervicitis": "التهاب باطن عنق الرحم (التهاب البطانة المخاطية لعنق الرحم)",
 "endocranium": "بطانة القحف (غشاء يبطن الجزء الداخلي من الجمجمة)",
 "endocrinal": "صماوي, غدي صماوي (متعلق بالغدد الصماء أو إفرازاتها)\nمثال: جهاز الغدد الصماء",
 "endocrine": "صماوي, غدي صماوي (متعلق بالغدد الصماء أو إفرازاتها) / غدة صماء, غدة لا قنوية (أي من غدد جهاز الغدد الصماء التي تفرز الهرمونات مباشرة في مجرى الدم) / هرمون (إفراز غدة صماء ينتقل عن طريق الدم إلى الأنسجة التي يكون له عليها تأثير محدد)\nمثال: جهاز الغدد الصماء",
 "endocrine gland": "غدة صماء, غدة لا قنوية (أي من غدد جهاز الغدد الصماء التي تفرز الهرمونات مباشرة في مجرى الدم)",
 "endocrine system": "جِهَاز اَلْغُدَد اَلصَّمَاء",
 "endocrinologist": "أخصائي غدد صماء (طبيب متخصص في تشخيص وعلاج الحالات التي تؤثر على نظام الغدد الصماء)",
 "endocrinology": "علم الغدد الصماء (فرع الطب المعني بالغدد الصماء وإفرازاتها)",
 "endoderm": "أديم باطن, الأرومة الباطنة (الطبقة المنتشة الداخلية التي تتطور لتشكل بطانة الجهاز الهضمي والتنفسي)",
 "endodontia": "علاج جذور الأسنان (فرع طب الأسنان الذي يتعامل مع أمراض لب الأسنان)",
 "endodontic": "لبي (متعلق بعلاج لب الأسنان (عصب الأسنان))\nمثال: أخصائي علاج جذور (لب) الأسنان",
 "endodontics": "علاج جذور الأسنان (فرع طب الأسنان الذي يتعامل مع أمراض لب الأسنان)",
 "endodontist": "أخصائي لب الأسنان (طبيب أسنان متخصص في أمراض لب الأسنان والعصب)",
 "endoergic": "ماص للطاقة ((عن التفاعل النووي) يحدث مع امتصاص للطاقة)",
 "endoergic reaction": "تفاعل ماص للطاقة (تفاعل نووي يحدث مع امتصاص للطاقة)",
 "endogamic": "زواجي داخلي (يتعلق بـ أو يتميز بعادة الزواج فقط ضمن حدود العشيرة أو القبيلة) / تلقيحي داخلي (يتميز بـ أو صالح للإخصاب بواسطة حبوب اللقاح من زهرة أخرى من نفس النوع)",
 "endogamous": "زواجي داخلي (يتعلق بـ أو يتميز بعادة الزواج فقط ضمن حدود العشيرة أو القبيلة) / تلقيحي داخلي (يتميز بـ أو صالح للإخصاب بواسطة حبوب اللقاح من زهرة أخرى من نفس النوع)",
 "endogamy": "زواج الأقارب, زواج داخلي (الزواج داخل قبيلة أو مجموعة المرء كما يقتضي العرف أو القانون)",
 "endogen": "أحادي الفلقة, نبات ذو فلقة واحدة (نبات زهري أحادي الفلقة؛ ينمو الساق عن طريق تراكمات في داخله)",
 "endogenetic": "بَاطِنِيّ, دَاخِلِيُّ الْمَنْشَأ (يتعلق بصخور تتشكل أو توجد تحت سطح الأرض)",
 "endogenic": "داخلي المنشأ (مشتق أو ناشئ داخلياً) / بَاطِنِيّ, دَاخِلِيُّ الْمَنْشَأ (يتعلق بصخور تتشكل أو توجد تحت سطح الأرض)",
 "endogenous": "داخلي المنشأ (مشتق أو ناشئ داخلياً) / داخلي المنشأ (متعلق بالنباتات داخلية النمو أو يشبهها)",
 "endogenous depression": "اكتئاب داخلي المنشأ (حالة اكتئاب لا يوجد لها سبب واضح)",
 "endogenously": "داخلياً, ذاتياً (بطريقة داخلية المنشأ)",
 "endogeny": "عملية داخلية المنشأ, نشاط داخلي (ظاهرة جيولوجية تحدث تحت سطح الأرض)",
 "endolymph": "لمف داخلي (السائل الجسدي الذي يملأ التيه الغشائي للأذن الداخلية)",
 "endometrial": "بطاني رحمي (من أو متعلق ببطانة الرحم)",
 "endometrial cancer": "سرطان بطانة الرحم, سرطانة بطانة الرحم (سرطان في بطانة الرحم)",
 "endometrial carcinoma": "سرطان بطانة الرحم, سرطانة بطانة الرحم (سرطان في بطانة الرحم)",
 "endometriosis": "انتباذ بطاني رحمي, بطانة الرحم المهاجرة (وجود بطانة الرحم في مكان آخر غير بطانة الرحم؛ يسبب ألم ما قبل الحيض وعسر الطمث)",
 "endometritis": "التهاب الرحم, التهاب بطانة الرحم (التهاب بطانة الرحم)",
 "endometrium": "بطانَة الرحم",
 "endomorph": "إندومورف, ممتلئ البنية (شخص ثقيل الوزن ذو جسد ناعم ومستدير)",
 "endomorphic": "باطن البنية, ممتلئ البنية (له بنية ممتلئة ومكتنزة باللحم)\nمثال: مزحة عملية ثقيلة",
 "endomorphy": "بدانة البنية, بنية ممتلئة (مستدير وسمين وثقيل)",
 "endoneurium": "باطنة العصب, غمد الليف العصبي (نسيج ضام رقيق يحيط بالألياف العصبية الفردية في العصب)",
 "endonuclease": "نيوكلياز داخلي (نوكلياز يقطع الأحماض النووية عند روابط داخلية وينتج بذلك شظايا بأحجام مختلفة)",
 "endoparasite": "طفيلي داخلي (أي من الطفيليات المختلفة التي تعيش في الأعضاء الداخلية للحيوانات (خاصة الديدان المعوية))",
 "endoparasitic": "داخلي التطفل (متعلق بالطفيليات التي تعيش في الأعضاء الداخلية للحيوانات)",
 "endoplasm": "إندوبلازم, جبلة داخلية (الجزء الداخلي من سيتوبلازم الخلية)",
 "endoplasmic reticulum": "شبكة إندوبلازمية",
 "endopsammon": "كائنات داخل رملية (الحيوانات المجهرية في الرمل والطين)",
 "endorphin": "إِنْدُورْفِين",
 "endorsement": "إقرار, تزكية (فعل المصادقة أو التزكية) / تظهير, مصادقة (توقيع يثبت صحة شيء ما) / إقرار, تأييد (موافقة رسمية وصريحة) / تأييد, تثنية (حديث لتأييد أو تثنية اقتراح ما)\nمثال: يمكن للرياضي النجم أن يجني الكثير من المال من عقود التزكية",
 "endorsement in blank": "تظهير على بياض (تظهير على ورقة تجارية لا يذكر اسم المستفيد، وبالتالي تكون قابلة للدفع لحاملها)",
 "endorser": "مُجَيِّر, مُظَهِّر (شخص ينقل ملكيته لشيء ما عن طريق التوقيع على شيك أو ورقة مالية قابلة للتداول) / مؤيد, مصادق (شخص يعبر عن موافقة قوية)",
 "endoscope": "منظار داخلي (أداة طبية رفيعة وطويلة لفحص الجزء الداخلي من عضو جسدي أو إجراء جراحة بسيطة)",
 "endoscopic": "تنظيري (من أو متعلق بالتنظير الداخلي)",
 "endoscopy": "تنظير داخلي (فحص بصري لداخل عضو مجوف في الجسم باستخدام منظار داخلي)",
 "endoskeleton": "هيكل داخلي (الهيكل العظمي الداخلي؛ البنية العظمية والغضروفية (خاصة للفقاريات))",
 "endosperm": "سويداء (نسيج مغذٍ يحيط بالجنين داخل بذور النباتات الزهرية)",
 "endospore": "بوغ داخلي (بوغ لاجنسي صغير ينمو داخل خلية بعض البكتيريا والطحالب)",
 "endospore-forming bacteria": "بكتيريا مكونة للأبواغ الداخلية (مجموعة من البكتيريا الحقيقية)",
 "endosteum": "بطانة العظم (غشاء وعائي يبطن السطح الداخلي للعظام الطويلة)",
 "endothelial": "بِطَانِيّ",
 "endothelial myeloma": "ساركومة إيوينغ, ورم إيوينغ (ورم خبيث في نخاع العظم (عادة في الحوض أو في العظام الطويلة))",
 "endothelialization": "تَبَطْنُن",
 "endothelium": "بِطَانَة",
 "endothermal": "ماص للحرارة ((عن تفاعل كيميائي أو مركب) يحدث أو يتشكل مع امتصاص للحرارة)",
 "endothermic": "ماص للحرارة ((عن تفاعل كيميائي أو مركب) يحدث أو يتشكل مع امتصاص للحرارة)",
 "endothermic reaction": "تفاعل ماص للحرارة (تفاعل كيميائي مصحوب بامتصاص للحرارة)",
 "endotoxin": "ذيفان داخلي (ذيفان محصور داخل الكائنات الدقيقة ولا يتم إطلاقه إلا عند تحلل الكائنات الدقيقة أو موتها)",
 "endotracheal tube": "أنبوب القصبة الهوائية, أنبوب رغامي (قسطرة يتم إدخالها في القصبة الهوائية عبر الفم أو الأنف للحفاظ على ممر هوائي مفتوح أو لتوصيل الأكسجين أو للسماح بشفط المخاط أو لمنع استنشاق محتويات…)",
 "endovenous": "داخل الوريد, وريدي (داخل الوريد أو عن طريقه)\nمثال: التهاب وريدي",
 "endowed": "محبو, مزود (مزود أو مجهز بـ (خاصة عن طريق الوراثة أو الطبيعة))\nمثال: كلية ذات وقف جيد (ممنوحة)",
 "endowment": "منحة وقفية, وقف (فعل منح مصدر دخل دائم) / ملكة, موهبة (قدرات أو صفات طبيعية) / صندوق وقفي, وقف (رأس المال الذي يوفر الدخل لمؤسسة)\nمثال: جاء وقفه السخي للمختبر في الوقت المناسب تماماً",
 "endowment fund": "صندوق وقفي, وقف (رأس المال الذي يوفر الدخل لمؤسسة)",
 "endowment insurance": "تأمين مختلط, تأمين وقفي (تأمين على الحياة بمبلغ محدد يُدفع للشخص المؤمن عليه عند انقضاء فترة زمنية معينة أو لمستفيد معين فور وفاة المؤمن عليه)",
 "endozoan": "طفيلي داخلي (أي من الطفيليات المختلفة التي تعيش في الأعضاء الداخلية للحيوانات (خاصة الديدان المعوية)) / طفيلي داخلي (من أو متعلق بالطفيليات الداخلية (أحشاء الحيوان))",
 "endozoic": "طفيلي داخلي (يعيش داخل حيوان حي عادة كطفيلي)\nمثال: ديدان طفيلية داخلية",
 "endplate": "صفيحة نهائية, صفيحة نهائية حركية (النهاية المسطحة للعصبون الحركي التي تنقل النبضات العصبية إلى العضلة)",
 "endpoint": "نقطة نهاية (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه)\nمثال: هذه هي نقطة ضعفه.",
 "endurable": "قَابِل لِلتَّحَمُّل, مُحْتَمَل (يمكن تحمله وإن كان مزعجًا)",
 "endurance": "تحمل, جلد (القدرة على تحمل المشقة أو التوتر) / بقاء, نجاة (حالة البقاء على قيد الحياة)\nمثال: يختبر الماراثون قدرة تحمل العداء",
 "endurance contest": "ماراثون, مسابقة التحمل (أي مشروع طويل وشاق)",
 "endurance riding": "ركوب التحمل (الركوب لساعات طويلة عبر مسافات طويلة)",
 "endure": "تَحَمَّلَ, صَبَرَ / اِسْتَمَرَّ",
 "enduring": "صَبُور, طَوِيلُ البَال (يَتَحَمَّلُ بِصَبْرٍ الظُّلْمَ أَوِ المَتَاعِبَ المُسْتَمِرَّة) / خَالِد, رَاسِخ (يبقى مدّة طويلة؛ لا يزول بسهولة)",
 "enduringly": "بِثَبَات, بِشَكْل دَائِم (بطريقة دائمة)\nمثال: تم تخصيب الثقافة الرومانية بشكل دائم",
 "enduringness": "تحمل, صمود (الديمومة بحكم القوة لمقاومة الضغط أو القوة)\nمثال: أعلنوا عن متانة منتجاتهم",
 "endways": "بِالنِّهَايَة نَحْو الأَمَام, مِن النِّهَايَة (مع النهاية للأمام أو نحو المراقب) / بِاتِّجَاه الأَطْرَاف, طُولِيًّا (في أو نحو اتجاه النهايات؛ طولياً) / عَلَى طَرَفِه, عَمُودِيًّا (على طرفه أو منتصباً)\nمثال: منازل مبنية من النهاية",
 "endwise": "بِالنِّهَايَة نَحْو الأَمَام, مِن النِّهَايَة (مع النهاية للأمام أو نحو المراقب) / بِاتِّجَاه الأَطْرَاف, طُولِيًّا (في أو نحو اتجاه النهايات؛ طولياً) / عَلَى طَرَفِه, عَمُودِيًّا (على طرفه أو منتصباً)\nمثال: منازل مبنية من النهاية",
 "ene": "الشَّرْق الشَّمَالِيّ الشَّرْقِيّ, شَرْق شَمَال شَرْق (نقطة البوصلة في منتصف المسافة بين الشمال الشرقي والشرق)",
 "enema": "حُقْنَة شَرَجِيَّة, حُقْنَة",
