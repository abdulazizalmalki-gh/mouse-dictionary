 "electrocardiogram": "مُخَطَط كَهْرَبِيَّة اَلْقَلْب, إِلِكْتْرُوكَارْدِيُوغْرَام",
 "electrocardiograph": "جهاز تخطيط القلب, مخطط القلب (أداة طبية تسجل التيارات الكهربائية المرتبطة بانقباضات القلب)",
 "electrocardiographic": "تخطيطي قلبي (مكون من أو متعلق بجهاز تخطيط القلب الكهربائي)",
 "electrocardiography": "تخطيط القلب, تخطيط كهربائية القلب (إجراء تشخيصي يتمثل في تسجيل نشاط القلب إلكترونياً باستخدام جهاز تخطيط القلب)",
 "electrocautery": "كي كهربائي (استخدام إبرة مسخنة بتيار كهربائي لتدمير الأنسجة (كما في إزالة الثآليل))",
 "electroceramic material": "مادة خزفية كهربائية (مادة سيراميك لها خصائص كهربائية وبصرية ومغناطيسية، مناسبة للاستخدام كعوازل لخطوط الطاقة وفي المكونات الكهربائية)",
 "electrochemical": "كهركيميائي (مكون من أو يتضمن الكيمياء الكهربائية)",
 "electrochemical series": "سلسلة الكهروكيميائية, سلسلة كهرومغناطيسية (ترتيب تسلسلي للعناصر الفلزية أو الأيونات وفقاً لجهود أقطابها المحددة تحت ظروف معينة؛ يظهر الترتيب ميل معدن ما لاختزال أيونات أي معدن آخر تحته في…)",
 "electrochemistry": "كيمياء كهربائية (فرع الكيمياء الذي يتعامل مع التأثير الكيميائي للكهرباء وإنتاج الكهرباء عن طريق التفاعلات الكيميائية)",
 "electroconvulsive therapy": "علاج بالصدمات الكهربائية (إعطاء تيار كهربائي قوي يمر عبر الدماغ للحث على التشنجات والغيبوبة)",
 "electrocution": "صعق كهربائي (القتل بصدمة كهربائية) / صعق كهربائي (الإعدام بالكهرباء)",
 "electrocutioner": "منفذ الإعدام بالكهرباء (جلاد يستخدم الكهرباء لقتل الشخص المحكوم عليه)",
 "electrode": "إِلِكْتْرُود",
 "electrodeposition": "ترسيب كهربائي (ترسيب مادة على قطب كهربائي بفعل الكهرباء (خاصة عن طريق التحليل الكهربائي))",
 "electrodermal response": "استجابة الجلد الجلفانية (تغير في الخصائص الكهربائية للجلد استجابة للتوتر أو القلق)",
 "electrodynamometer": "مقياس الديناميكا الكهربائية (أداة قياس تستخدم تفاعل المجالات المغناطيسية لملفين لقياس التيار أو الجهد أو القدرة)",
 "electroencephalogram": "تخطيط الدماغ, مخطط كهربية الدماغ (سجل بياني للنشاط الكهربائي للدماغ؛ ينتجه جهاز تخطيط كهربية الدماغ)",
 "electroencephalograph": "جهاز تخطيط كهربائية الدماغ (أداة طبية تسجل التيارات الكهربائية التي يولدها الدماغ)",
 "electroencephalographic": "تخطيطي مخي (مكون من أو متعلق بجهاز تخطيط المخ الكهربائي)",
 "electrograph": "جهاز نقش كهربائي (جهاز كهربائي يستخدم للحفر بالوسائل الإلكتروليتية) / جهاز إرسال الصور, راسمة كهربائية (جهاز للإرسال الكهربائي للصور)",
 "electrolier": "ثريا كهربائية",
 "electrolocation": "تحديد الموقع بالكهرباء (استخدام الاستقبال الكهربائي لتحديد موقع الأشياء المحيطة)",
 "electrologist": "أخصائي تحليل كهربائي (شخص ماهر في استخدام الكهرباء لإزالة الشامات أو الثآليل أو جذور الشعر)",
 "electrolysis": "تحليل كهربائي لإزالة الشعر (إزالة الشعر الزائد أو غير المرغوب فيه عن طريق تمرير تيار كهربائي عبر جذر الشعرة) / تحليل كهربائي ((في الكيمياء) تفاعل تحلل كيميائي ينتج عن تمرير تيار كهربائي عبر محلول يحتوي على أيونات)",
 "electrolyte": "إلكتروليت, كهرل (محلول يوصل الكهرباء)\nمثال: الكمية والتوزيع المناسب للإلكتروليتات في الجسم ضروري للصحة",
 "electrolyte acid": "حمض البطارية (حمض الكبريتيك المخفف المستخدم في بطاريات التخزين)",
 "electrolyte balance": "توازن الكهارل (توازن بين كميات الكهارل (مثل الكالسيوم والصوديوم والبوتاسيوم) الضروري للصحة والأداء الطبيعي)",
 "electrolytic": "إلكتروليتي, كهرلي (مكون من أو متعلق بـ أو محتوٍ على إلكتروليت (كهرل)) / تحليلي كهربائي (مكون من أو معني بـ أو ناتج عن التحليل الكهربائي) / مكثف إلكتروليتي, مكثف كيميائي (مكثف ثابت يتكون من قطبين يفصل بينهما إلكتروليت)",
 "electrolytic capacitor": "مكثف إلكتروليتي, مكثف كيميائي (مكثف ثابت يتكون من قطبين يفصل بينهما إلكتروليت)",
 "electrolytic cell": "خلية تحليل كهربائي (خلية تحتوي على إلكتروليت يتسبب الجهد المطبق فيه بحدوث تفاعل لا يحدث لولاه (مثل تحلل الماء إلى هيدروجين وأكسجين))",
 "electrolytic condenser": "مكثف إلكتروليتي, مكثف كيميائي (مكثف ثابت يتكون من قطبين يفصل بينهما إلكتروليت)",
 "electromagnet": "مغناطيس كهربائي (مغناطيس مؤقت مصنوع عن طريق لف سلك حول قلب حديدي؛ عندما يتدفق التيار في الملف يصبح الحديد مغناطيساً)",
 "electromagnetic": "كَهْرُومِغْنَاطِيسِيّ",
 "electromagnetic delay line": "خط تأخير كهرومغناطيسي (خط تأخير يعتمد على وقت انتشار الموجات الكهرومغناطيسية)",
 "electromagnetic interaction": "تفاعل كهرومغناطيسي (تفاعل بين الجسيمات الأولية المشحونة يكون متوسطاً في القوة بين التفاعلات القوية والضعيفة؛ يتوسطه فوتونات)",
 "electromagnetic intrusion": "تداخل كهرومغناطيسي (الإدخال المتعمد للطاقة الكهرومغناطيسية في مسارات النقل بهدف إرباك أو خداع المشغلين)",
 "electromagnetic radiation": "إشعاع كهرومغناطيسي, موجة كهرومغناطيسية (إشعاع يتكون من موجات من الطاقة مرتبطة بمجالات كهربائية ومغناطيسية ناتجة عن تسارع شحنة كهربائية)",
 "electromagnetic spectrum": "طَيْف كَهْرُومَغْنَاطِيسِيّ",
 "electromagnetic transducer": "محول طاقة كهرومغناطيسي (محول طاقة يحول الموجات الكهرومغناطيسية والمجالات المغناطيسية من وإلى إشارات كهربائية)",
 "electromagnetic unit": "وحدة كهرومغناطيسية (أي من أنظمة الوحدات المختلفة لقياس الكهرباء والمغناطيسية)",
 "electromagnetic wave": "إشعاع كهرومغناطيسي, موجة كهرومغناطيسية (إشعاع يتكون من موجات من الطاقة مرتبطة بمجالات كهربائية ومغناطيسية ناتجة عن تسارع شحنة كهربائية)",
 "electromagnetics": "كهرومغناطيسية (فرع الفيزياء المعني بالظواهر الكهرومغناطيسية)",
 "electromagnetism": "كهرومغناطيسية",
 "electromechanical": "كهروميكانيكي (مكون من أو متعلق بـ أو يتضمن جهازاً ميكانيكياً يعمل بالكهرباء)",
 "electromechanical device": "جهاز كهروميكانيكي (جهاز ميكانيكي يعمل بالكهرباء)",
 "electromechanical transducer": "محول طاقة كهروميكانيكي (محول طاقة لاستقبال الموجات من نظام كهربائي وتسليمها لنظام ميكانيكي، أو العكس)",
 "electrometer": "إلكترومتر, مقياس الكهرباء (مقياس لقياس فروق الجهد الكهروستاتيكي؛ لا يسحب تياراً من المصدر)",
 "electromotive": "دافع كهربائي (معني بـ أو منتج للتيار الكهربائي)",
 "electromotive drug administration": "رحلان أيوني, علاج أيوني (علاج يستخدم تياراً كهربائياً موضعياً لإدخال أيونات الدواء إلى الأنسجة)",
 "electromotive force": "فولتية, قوة دافعة كهربائية (المعدل الذي يتم به سحب الطاقة من مصدر ينتج تدفقاً للكهرباء في دائرة؛ يعبر عنه بالفولت)",
 "electromotive force series": "سلسلة الكهروكيميائية, سلسلة كهرومغناطيسية (ترتيب تسلسلي للعناصر الفلزية أو الأيونات وفقاً لجهود أقطابها المحددة تحت ظروف معينة؛ يظهر الترتيب ميل معدن ما لاختزال أيونات أي معدن آخر تحته في…)",
 "electromotive series": "سلسلة الكهروكيميائية, سلسلة كهرومغناطيسية (ترتيب تسلسلي للعناصر الفلزية أو الأيونات وفقاً لجهود أقطابها المحددة تحت ظروف معينة؛ يظهر الترتيب ميل معدن ما لاختزال أيونات أي معدن آخر تحته في…)",
 "electromyogram": "تخطيط العضلات, مخطط كهربية العضل (سجل بياني للتيارات الكهربائية المرتبطة بتقلصات العضلات)",
 "electromyograph": "جهاز تخطيط كهربائية العضل (أداة طبية تسجل الموجات الكهربائية المرتبطة بنشاط العضلات الهيكلية)",
 "electromyography": "تخطيط كهربائية العضل (تشخيص الاضطرابات العصبية العضلية باستخدام جهاز تخطيط كهربائية العضل)",
 "electron": "إِلِكْتْرُون, كُهَيْرِب",
 "electron accelerator": "مسارع الإلكترونات (مصادم يتكون من مسارع يصادم الإلكترونات والبوزيترونات)",
 "electron beam": "حزمة إشعاعية, حزمة إلكترونية (مجموعة من خطوط الإشعاع الكهرومغناطيسي المتوازية تقريباً)",
 "electron gun": "مدفع إلكتروني (القطب الكهربائي الذي يعد مصدر الإلكترونات في أنبوب أشعة الكاثود أو المجهر الإلكتروني؛ يتكون من كاثود يبعث تياراً من الإلكترونات وجهاز كهروستاتيكي أو…)",
 "electron lens": "عدسة إلكترونية (معدات إلكترونية تستخدم مجالاً مغناطيسياً أو كهربائياً لتركيز حزمة من الإلكترونات)",
 "electron microscope": "مجهر إلكتروني (مجهر يشبه في الغرض المجهر الضوئي ولكنه يحقق قوة تحليل أكبر بكثير باستخدام شعاع متواز من الإلكترونات لإضاءة الجسم بدلاً من شعاع الضوء)",
 "electron microscopic": "مجهري إلكتروني (متعلق بالمجهر الإلكتروني)",
 "electron microscopy": "مجهرية إلكترونية (الفحص المجهري باستخدام المجاهر الإلكترونية)",
 "electron multiplier": "مضاعف إلكتروني (أنبوب مفرغ يضخم تدفق الإلكترونات)",
 "electron optics": "بصريات إلكترونية (فرع الإلكترونيات الذي يتعامل مع حزم الإلكترونات وتركيزها وانحرافها بواسطة المجالات المغناطيسية)",
 "electron orbit": "مدار, مدار الإلكترون (مسار الإلكترون حول نواة الذرة)",
 "electron paramagnetic resonance": "رنين إلكتروني مغزلي, رنين مغناطيسي إلكتروني (مطيافية الميكروويف التي يوجد فيها امتصاص رنيني للإشعاع بواسطة مغناطيس مساير)",
 "electron radiation": "أشعة بيتا, إشعاع بيتا (إشعاع جسيمات بيتا أثناء التحلل الإشعاعي)",
 "electron shell": "غلاف إلكتروني, مدار إلكتروني (مجموعة من الإلكترونات تحيط بنواة الذرة)\nمثال: تتحدد الخصائص الكيميائية للذرة من خلال الغلاف الإلكتروني الخارجي",
 "electron spin resonance": "رنين إلكتروني مغزلي, رنين مغناطيسي إلكتروني (مطيافية الميكروويف التي يوجد فيها امتصاص رنيني للإشعاع بواسطة مغناطيس مساير)",
 "electron tube": "أنبوب إلكتروني, صمام مفرغ (جهاز إلكتروني يتكون من نظام من الأقطاب الكهربائية مرتبة في غلاف زجاجي أو معدني مفرغ)",
 "electron volt": "إلكترون فولت (وحدة طاقة تساوي الشغل الذي يبذله إلكترون يتسارع عبر فرق جهد قدره 1 فولت)",
 "electronegative": "سَالِب الشِّحْنَة, سَلْبِيّ (ذو شحنة كهربائيّة سالبة)",
 "electronegativity": "سلبية كهربائية ((كيمياء) ميل الذرة أو الجذر لجذب الإلكترونات في تكوين رابطة أيونية)",
 "electroneutral": "مُتَعَادِل كَهْرَبَائِيًّا, مُحَايِد (ليس له شحنة كهربائيّة صافية)",
 "electronic": "إِلِكْتْرُونِيّ",
 "electronic balance": "ميزان إلكتروني (ميزان يولد تياراً يتناسب مع إزاحة الكفة)",
 "electronic bicycle": "دراجة إلكترونية, دراجة كهربائية (دراجة مبنية بمحرك، يمكن تشغيل الدراجة بواسطة المحرك أو بتدويس الراكب)",
 "electronic bike": "دراجة إلكترونية, دراجة كهربائية (دراجة مبنية بمحرك، يمكن تشغيل الدراجة بواسطة المحرك أو بتدويس الراكب)",
 "electronic bulletin board": "نظام لوحة الإعلانات الإلكترونية (حاسوب يشغل برنامجاً يسمح للمستخدمين بترك رسائل والوصول إلى معلومات ذات اهتمام عام)",
 "electronic cigarette": "سِيجَارَة إِلِكْتْرُونِيَّة (منتج مصنوع من أوراق التبغ، تلف أو تحشى بداخل غلاف ورقي على شكل أسطوانة لغرض التدخين)\nمثال: دخن زيري سيجارة.",
 "electronic circuit": "دَارَة إِلِكْتْرُونِيّة (لا جمع له)",
 "electronic communication": "اتصال إلكتروني (التواصل عن طريق الكمبيوتر)",
 "electronic computer": "حاسوب, كمبيوتر (آلة لإجراء الحسابات تلقائياً)",
 "electronic converter": "محول إلكتروني ((اتصالات) محول لتحويل إشارة من تردد إلى آخر)",
 "electronic counter-countermeasures": "إجراءات إلكترونية مضادة للمضادات (حرب إلكترونية تهدف لضمان الاستخدام الفعال للطيف الكهرومغناطيسي من قبل القوات الصديقة رغم استخدام العدو للحرب الإلكترونية)",
 "electronic countermeasures": "إجراءات إلكترونية مضادة (حرب إلكترونية يتم القيام بها لمنع أو تقليل الاستخدام الفعال للعدو للطيف الكهرومغناطيسي)",
 "electronic data processing": "معالجة إلكترونية للبيانات (معالجة آلية للبيانات بالوسائل الإلكترونية دون استخدام بطاقات التبويب أو الأشرطة المثقوبة)",
 "electronic database": "قاعدة بيانات إلكترونية, قاعدة بيانات حاسوبية ((علوم الكمبيوتر) قاعدة بيانات يمكن الوصول إليها بواسطة أجهزة الكمبيوتر)",
 "electronic deception": "خداع إلكتروني (الاستخدام المتعمد للطاقة الكهرومغناطيسية بطريقة تهدف إلى نقل معلومات مضللة)",
 "electronic device": "جهاز إلكتروني (جهاز يحقق غرضه إلكترونياً)",
 "electronic dictionary": "قاموس إلكتروني, قاموس مقروء آلياً (نسخة مقروءة آلياً من قاموس قياسي؛ منظمة أبجدياً)",
 "electronic drum kit": "طقم طبول إلكتروني (مجموعة من الطبول الإلكترونية وهي أجهزة كهربائية يضربها قارع الطبول، وتُعزف في الوقت الفعلي لإنتاج مجموعة مختارة من الأصوات والآلات والمؤثرات)",
 "electronic drum set": "طقم طبول إلكتروني (مجموعة من الطبول الإلكترونية وهي أجهزة كهربائية يضربها قارع الطبول، وتُعزف في الوقت الفعلي لإنتاج مجموعة مختارة من الأصوات والآلات والمؤثرات)",
 "electronic equipment": "معدات إلكترونية (معدات تتضمن التوصيل المتحكم فيه للإلكترونات (خاصة في الغاز أو الفراغ أو أشباه الموصلات))",
 "electronic fetal monitor": "جهاز مراقبة الجنين الإلكتروني (شاشة إلكترونية تراقب ضربات قلب الجنين وتقلصات رحم الأم أثناء الولادة)",
 "electronic foetal monitor": "جهاز مراقبة الجنين الإلكتروني (شاشة إلكترونية تراقب ضربات قلب الجنين وتقلصات رحم الأم أثناء الولادة)",
 "electronic game": "لَعْبَة إِلِكْتْرُونِيَّة (اللَعْبَة البَرْبَرية دواء عشبيّ)\nمثال: عنده لعبة يويو.",
 "electronic image": "خريطة بتات, صورة نقطية (صورة ممثلة كمصفوفة ثنائية الأبعاد لقيم السطوع للبكسلات)",
 "electronic imitative deception": "خداع إلكتروني تقليدي (إدخال طاقة كهرومغناطيسية في أنظمة العدو تحاكي انبعاثات العدو)",
 "electronic information service": "قاعدة بيانات إلكترونية, قاعدة بيانات حاسوبية ((علوم الكمبيوتر) قاعدة بيانات يمكن الوصول إليها بواسطة أجهزة الكمبيوتر)",
 "electronic instrument": "آلة موسيقية إلكترونية (آلة موسيقية تولد الأصوات إلكترونياً)",
 "electronic jamming": "تشويش, تشويش إلكتروني (إشعاع أو عكس متعمد للطاقة الكهرومغناطيسية لغرض تعطيل استخدام العدو للأجهزة أو الأنظمة الإلكترونية)",
 "electronic mail": "إيميل, بريد إلكتروني ((علوم الكمبيوتر) نظام للاتصال الإلكتروني العالمي حيث يمكن لمستخدم الكمبيوتر إنشاء رسالة في محطة طرفية واحدة يمكن إعادة إنشائها في محطة المستلم عند…)\nمثال: لا يمكنك إرسال طرود بالبريد الإلكتروني",
 "electronic manipulative deception": "خداع إلكتروني تلاعبي (إجراءات للقضاء على المؤشرات الكاشفة التي يمكن أن يستخدمها العدو (أو لنقل مؤشرات مضللة))",
 "electronic messaging": "مراسلة, مراسلة إلكترونية (إرسال ومعالجة البريد الإلكتروني بواسطة الكمبيوتر)",
 "electronic music": "موسيقى إلكترونية (شكل من الموسيقى يتكون من أصوات تنتجها تيارات كهربائية متذبذبة يتم التحكم فيها إما من لوحة آلة أو لوحة مفاتيح أو مسجلة مسبقاً على شريط مغناطيسي)",
 "electronic musical instrument": "آلة موسيقية إلكترونية (آلة موسيقية تولد الأصوات إلكترونياً)",
 "electronic network": "شبكة إلكترونية ((إلكترونيات) نظام من المكونات أو الدوائر الإلكترونية المترابطة)",
 "electronic organ": "أورغن كهربائي ((موسيقى) محاكاة إلكترونية للأورغن الأنبوبي)",
 "electronic reconnaissance": "استطلاع إلكتروني (كشف وتحديد وتقييم وتعيين مواقع الإشعاعات الكهرومغناطيسية الأجنبية (بخلاف المشعة))",
 "electronic scanner": "جهاز مسح الترددات, ماسح ضوئي إلكتروني (جهاز استقبال راديو يتحرك تلقائياً عبر نطاق محدد من الترددات بحثاً عن إشارة أو حالة معينة)\nمثال: استخدموا أجهزة المسح لمراقبة قنوات راديو الشرطة",
 "electronic signal": "إشارة إلكترونية (إشارة تُولد بوسائل إلكترونية)",
 "electronic simulative deception": "خداع إلكتروني محاكاتي (إجراءات لتمثيل قدرات افتراضية أو فعلية صديقة لتضليل القوات المعادية)",
 "electronic sports": "رياضة إلكترونية (شكل من أشكال الرياضات الذهنية حيث يتم تسهيل الجوانب الأساسية للرياضة بواسطة ألعاب الفيديو)",
 "electronic stylus": "قلم ضوئي ((في علم الحاسوب) مؤشر يستشعر عند توجيهه إلى شاشة الحاسوب ما إذا كانت النقطة مضاءة أم لا)",
 "electronic surveillance": "مراقبة إلكترونية (المراقبة بالوسائل الإلكترونية (مثل التلفزيون))",
 "electronic text": "نص إلكتروني (نص في شكل يمكن للكمبيوتر تخزينه أو عرضه على شاشة الكمبيوتر)",
 "electronic transistor": "ترانزستور (جهاز شبه موصل قادر على التضخيم)",
 "electronic voltmeter": "فولتميتر إلكتروني, مقياس الفولت الإلكتروني (مقياس جهد تزداد حساسيته عن طريق التضخيم)",
 "electronic warfare": "حرب إلكترونية (عمل عسكري يتضمن استخدام الطاقة الكهرومغناطيسية لتحديد أو استغلال أو تقليل أو منع الاستخدام المعادي للطيف الكهرومغناطيسي)",
 "electronic warfare-support measures": "تدابير دعم الحرب الإلكترونية (حرب إلكترونية تتم تحت السيطرة المباشرة لقائد عملياتي لتحديد مصادر الطاقة الكهرومغناطيسية المشعة لغرض التعرف الفوري على التهديد)",
 "electronically": "إلكترونياً (بواسطة وسائل إلكترونية)\nمثال: يفتح الباب إلكترونياً",
 "electronics": "إِلِكْتْرُونِيَّات",
 "electronics company": "شركة إلكترونيات (شركة تقوم بتصنيع وبيع الأدوات الإلكترونية)",
 "electronics industry": "صناعة الإلكترونيات (مصنعو المنتجات الإلكترونية باعتبارهم مجموعة)",
 "electronics intelligence": "استخبارات إلكترونية (استخبارات مستمدة من الإشعاعات الكهرومغناطيسية من مصادر أجنبية (بخلاف المصادر المشعة))",
 "electrophoresis": "رحلان كهربائي (حركة الجسيمات المشحونة في مادة غروانية تحت تأثير مجال كهربائي؛ حيث تتجه الجسيمات ذات الشحنة الموجبة إلى الكاثود والسالبة إلى الأنود)",
 "electrophoretic": "رحلاني كهربائي (مكون من أو متعلق بالرحلان الكهربائي)",
 "electrophorus": "إلكتروفور, حامل الكهرباء (مولد كهروستاتيكي بسيط يولد شحنات متكررة من الكهرباء الساكنة)",
 "electrophorus electricus": "أنقليس رعاد, أنقليس كهربائي (سمكة مياه عذبة تشبه الثعبان تعيش في أمريكا الجنوبية ولها أعضاء كهربائية في جسمها)",
 "electroplate": "قطعة مطلية كهربائياً (أي جسم تم طلاؤه بطبقة رقيقة من المعدن عن طريق التحليل الكهربائي)",
 "electroplater": "مطلي كهربائي (مطلي يستخدم التحليل الكهربائي)",
 "electropositive": "إِيجَابِيّ, مُوجَب الشِّحْنَة (ذو شحنة كهربائيّة موجبة)",
 "electroretinogram": "مخطط كهربية الشبكية (تسجيل بياني للنشاط الكهربائي للشبكية الناتج عن وميض الضوء في العين)",
 "electroscope": "كشاف كهربائي (أداة قياس تكشف عن الشحنة الكهربائية؛ تنفرج ورقتان ذهبيتان بسبب تنافر الشحنات ذات الإشارة المتشابهة)",
 "electroshock": "علاج بالصدمات الكهربائية (إعطاء تيار كهربائي قوي يمر عبر الدماغ للحث على التشنجات والغيبوبة)",
 "electroshock therapy": "علاج بالصدمات الكهربائية (إعطاء تيار كهربائي قوي يمر عبر الدماغ للحث على التشنجات والغيبوبة)",
 "electrosleep": "نوم كهربائي (فقدان الوعي الناجم عن مرور تيار كهربائي منخفض الجهد عبر الدماغ)",
 "electrostatic": "كهروستاتيكي, كهروسكوني (معني بـ أو منتج لـ أو ناتج عن الكهرباء الساكنة)\nمثال: مولد كهروستاتيكي ينتج كهرباء ساكنة عالية الجهد",
 "electrostatic bond": "رابطة أيونية, رابطة شاردية (رابطة كيميائية تفقد فيها ذرة إلكتروناً لتشكل أيوناً موجباً وتكتسب الذرة الأخرى إلكتروناً لتشكل أيوناً سالباً)",
 "electrostatic charge": "شحنة كهروسكونية (الشحنة الكهربائية الساكنة على سطح جسم معزول (التي تنشئ مجالاً كهروسكونياً مجاوراً))",
 "electrostatic field": "مجال كهروستاتيكي, مجال كهروسكوني (مجال كهربائي مرتبط بشحنات كهربائية ساكنة)",
 "electrostatic generator": "مولد كهروسكوني (جهاز كهربائي ينتج جهداً عالياً عن طريق تكوين شحنة من الكهرباء الساكنة)",
 "electrostatic machine": "مولد كهروسكوني (جهاز كهربائي ينتج جهداً عالياً عن طريق تكوين شحنة من الكهرباء الساكنة)",
 "electrostatic precipitation": "ترسيب كهروستاتيكي (عملية تزيل جزيئات الغبار العالقة من الغاز عن طريق تطبيق شحنة كهروستاتيكية عالية الجهد على الجزيئات وجمعها على ألواح مشحونة)",
 "electrostatic precipitator": "مرسب, مرسب كهروسكوني (يزيل جزيئات الغبار من الغازات عن طريق الترسيب الكهروسكوني)",
 "electrostatic printer": "طابعة كهروستاتيكية (طابعة تستخدم شحنة كهربائية لترسيب الحبر الجاف (التونر) على الورق)",
 "electrostatic unit": "وحدة كهروستاتيكية (أي من وحدات الكهرباء المختلفة القائمة على قوى التفاعل بين الشحنات الكهربائية)",
 "electrostatically": "كهروستاتيكياً (بطريقة كهروستاتيكية)\nمثال: التصق الغبار كهروستاتيكياً بالسطح",
 "electrostatics": "إلكتروستاتيكا, كهرباء ساكنة (فرع الفيزياء الذي يتعامل مع الكهرباء الساكنة)",
 "electrosurgery": "جراحة كهربائية (جراحة تجرى بأجهزة كهربائية (كما في الكي الكهربائي))",
 "electrotherapist": "معالج بالكهرباء (شخص يتخصص في علاج الأمراض بالكهرباء)",
 "electrotherapy": "علاج كهربائي (التطبيق العلاجي للكهرباء على الجسم (كما في علاج أشكال مختلفة من الشلل))",
 "electrovalent bond": "رابطة أيونية, رابطة شاردية (رابطة كيميائية تفقد فيها ذرة إلكتروناً لتشكل أيوناً موجباً وتكتسب الذرة الأخرى إلكتروناً لتشكل أيوناً سالباً)",
 "electroweak interaction": "تفاعل كهروضعيف (في فيزياء الجسيمات، الوصف الموحد لاثنين من التفاعلات الأساسية الأربعة المعروفة في الطبيعة: الكهرومغناطيسية والتفاعل الضعيف)",
 "electrum": "إلكتروم",
 "eleemosynary": "خَيِّر, مُحْسِن (سخيّ في مساعدة الفقراء والمحتاجين)",
 "elegance": "أَنَاقَة",
 "elegant": "ظَرِيف, أَنِيق (الذي فيه ظُرْف، أي فيه كياسة وحسن العبارة)\nمثال: هذه الفتاة ظريفة.",
 "elegant brodiaea": "بروديا أنيقة (بروديا لها مظلة من الزهور البنفسجية أو الزرقاء البنفسجية فوق ساق بلا أوراق؛ شمال أوريغون إلى جنوب كاليفورنيا)",
 "elegant cat's ears": "آذان القط الأنيقة, توليب النجمة (نبات صغير بسيقان منحنية رفيعة تحمل عناقيد متفرعة لعدد قليل من الزهور البيضاء النجمية ببتلات تشبه آذان القط؛ جنوب شرق واشنطن وشمال شرق أوريغون إلى…)",
 "elegant habenaria": "هابيناريا أنيقة (سحلب لجام داخلي نحيل يشبه سحلب اللجام الساحلي ولكن بزهور صفراء مخضرة شاحبة)",
 "elegantly": "بِأَنَاقَة, بِبَرَاعَة (بطريقة أنيقة رشيقة) / بِأَنَاقَة, بِذَوْق رَفِيع (مع الأناقة؛ بطريقة أنيقة بذوق)\nمثال: أعضاء هذه المجموعات لا يعبرون عن أنفسهم بدقة أو بأناقة كما يفعل منتقدوهم",
 "elegiac": "رِثَائِيّ, مَرْثِيّ (يعبّر عن الحزن غالباً على شيء مضى) / رثائي (يشبه أو مميز لـ أو مناسب للرثاء)\nمثال: قصيدة رثائية في وفاة صديق",
 "elegiac stanza": "رباعية رثائية (رباعية في الخماسي اليامبي مع نظام قافية أ-ب-أ-ب)",
 "elegist": "راثٍ, شاعر رثاء (مؤلف قصيدة حزينة يرثي فيها الموتى)",
 "elegy": "رِثَاء, مَرْثِيَة",
 "element": "عُنْصُر كِيمِيَائِيّ, عُنْصُر (الْأَصْل؛ الجِنْس)\nمثال: المغنيزيوم عنصر كيميائي.",
 "element 104": "رذرفورديوم (عنصر مشع ما بعد اليورانيوم تم تصنيعه)",
 "element 105": "دوبنيوم (عنصر ما بعد اليورانيوم عدده الذري 105)",
 "element 106": "سيبورجيوم (عنصر ما بعد اليورانيوم عدده الذري 106)",
 "element 107": "بوريوم (عنصر ما بعد اليورانيوم عدده الذري 107)",
 "element 108": "هاسيوم (عنصر مشع ما بعد اليورانيوم، عدده الذري 108)",
 "element 109": "مايتنريوم (عنصر مشع ما بعد اليورانيوم، عدده الذري 109)",
 "element 110": "دارمشتاتيوم (عنصر مشع ما بعد اليورانيوم، عدده الذري 110)",
 "element 111": "رونتجينيوم (عنصر مشع ما بعد اليورانيوم، عدده الذري 111)",
 "element 112": "أنون بيوم, كوبرنيسيوم (عنصر مشع ما بعد اليورانيوم، عدده الذري 112)",
 "element 113": "أنون تريوم, نيهونيوم (عنصر مشع ما بعد اليورانيوم، عدده الذري 113)",
 "element 114": "أنون كواديوم, فليروفيوم (عنصر مشع ما بعد اليورانيوم، عدده الذري 114)",
 "element 115": "أنون بنتيوم, موسكوفيوم (عنصر مشع ما بعد اليورانيوم، عدده الذري 115)",
 "element 116": "أنون هيكسيوم, ليفرموريوم (عنصر مشع ما بعد اليورانيوم، عدده الذري 116)",
 "element of a cone": "راسم المخروط (خط مستقيم يصل بين القمة ونقطة على القاعدة)",
 "element of a cylinder": "راسم الأسطوانة (خط مستقيم يمتد على طول الأسطوانة)",
 "elemental": "أَوَّلِيّ, جَوْهَرِيّ (من الجزء الأساسي أو الجوهري أو يكونه) / عنصري (متعلق بـ أو كونه عنصراً (كيميائياً)) / جوهري, عاصف (متعلق بالظروف الجوية القاسية)\nمثال: كبريت عنصري",
 "elementarily": "بِشَكْل أَسَاسِيّ, بِشَكْل أَوَّلِيّ (بطريقة أولية)",
 "elementary": "بَسِيط, غَيْر مُعَقَّد (سَهْل وَغَيْر مُعَقَّد أَوْ مُتَشَعِّب) / أَوَّلِيّ, جَوْهَرِيّ (من الجزء الأساسي أو الجوهري أو يكونه) / أولي, ابتدائي (مكون من أو متعلق بـ أو مميز للمدرسة الابتدائية أو التعليم الابتدائي)\nمثال: الصفوف الابتدائية",
 "elementary education": "تعليم ابتدائي (التعليم في المواد الأساسية (القراءة والكتابة والحساب) المقدم للطلاب الصغار في المدرسة الابتدائية)",
 "elementary geometry": "هندسة أولية, هندسة إقليدية (الهندسة القائمة على بديهيات إقليدس)",
 "elementary particle": "جُسَيْم أَوَّلِيّ (في الفيزياء: الجُسيْمات التحت ذريّة، أي الجُسيْمات الأوليّة والمركّبة (معنى مستحدث))\nمثال: نحن نعيش بعض اللحظات الحزينة حقا لأن بلادنا عانت من خسارة جسيمة. وسوف يستغرق وقتا طويلا قبل أن تعود إلى مجدها السابق.",
 "elementary school": "مدرسة ابتدائية (مدرسة للأطفال الصغار؛ عادة ما تكون الصفوف الستة أو الثمانية الأولى)",
 "elements": "عوامل الطبيعة (طقس عنيف أو قاسٍ (ينظر إليه على أنه ناجم عن فعل العناصر الأربعة))\nمثال: شعروا بغضب الطبيعة الكامل",
 "elemi": "إيليمي, صمغ الإيليمي (راتنج عطري يُستخرج من أشجار عائلة البخوريات ويُستخدم كبخور)",
 "eleocharis acicularis": "أسل إبري, عشبة الشعر (أسل مائي دقيق الأوراق؛ شائع كمهوية لأحواض السمك)",
 "eleocharis dulcis": "كستناء الماء, كستناء الماء الصينية (سعد صيني ينتج درنات صالحة للأكل على شكل بصيلة)",
 "eleocharis palustris": "أسل زاحف (سعد ذو ساق أسطوانية)",
 "eleostearic acid": "حمض إليوستيريك (حمض دهني بلوري غير مشبع)",
 "elephant": "فِيل, فيل (حيوان ثديي آكل أعشاب، وهو أكبر الحيوانات الأرضية الحية؛ (في الشطرنج) قطعة من قطع الشطرنج تتحرك بشكل قطري، ورمزها \"♗\" أو \"♝\")\nمثال: لدى الفيل أنف طويل.",
 "elephant bird": "طائر الفيل (طائر ضخم (يصل إلى 9 أقدام) منقرض لا يطير من مدغشقر)",
 "elephant calf": "دَغْفَل",
 "elephant ear": "أذن الفيل, ألوكاسيا (أي نبات من جنس الألوكاسيا ذو أوراق قاعدية كبيرة مبهرجة وقنابة قاربيه الشكل وتوت محمر)",
 "elephant seal": "فيل البحر (أي من نوعين من الفقمات الكبيرة عديمة الأذن في شمال المحيط الأطلسي لها خطم يشبه الخرطوم)",
 "elephant tree": "بورسيرا صغيرة الأوراق, شجرة الفيل (شجرة صغيرة أو شجيرة توجد في جنوب غرب الولايات المتحدة، تتميز برائحة حارة وأوراق ريشية فردية وعناقيد صغيرة من الزهور البيضاء)",
 "elephant yam": "أمورفوفالس فاونيا, يام الفيل (نبات لوفي كريه الرائحة من جنوب شرق آسيا (خاصة الفلبين) يزرع لدرنته الصالحة للأكل)",
 "elephant's ear": "أذن الفيل, كوناكاست (شجرة استوائية من أمريكا الجنوبية ذات تاج واسع الانتشار من أوراق ثنائية الريش وثمار ملفوفة تشبه الأذن؛ تزرع للظل والزينة وكذلك للحصول على أخشاب قيمة) / أذن الفيل, ألوكاسيا (أي نبات من جنس الألوكاسيا ذو أوراق قاعدية كبيرة مبهرجة وقنابة قاربيه الشكل وتوت محمر)",
 "elephant's-foot": "رجل الفيل (العُضْو في جسد الإنسان يتكون من القَدَم والسَاق والفُخْذ. الجمع أرجُل، وقد تقول العامّة رِجْلين ورجْلينات؛ القَدَم من باب اطلاق اسم الكل على الجزء) / ديسقوريا الفيل, قدم الفيل (كرمة من جنوب أفريقيا لها ساق جذري ضخم مغطى بلحاء عميق التشقق)\nمثال: هذا الرجل تاجر.",
 "elephant-tusk": "بروبوسيديا, مخالب الشيطان (نبات حولي من جنوب الولايات المتحدة إلى المكسيك له أزهار كبيرة بيضاء أو صفراء مرقطة بالأرجواني ومنقار منحن طويل)",
 "elephantiasis": "داء الفيل (تضخم أجزاء معينة من الجسم (عادة الساقين وكيس الصفن)؛ المرحلة النهائية لمرض داء الفيلاريات)",
 "elephantiasis neuromatosa": "داء الفيل العصبي (تضخم طرف ما)",
 "elephantiasis scroti": "داء الفيل الصفني (تورم كيس الصفن الناتج عن انسداد لمفاوي مزمن)",
 "elephantine": "إِلْفَنْتِين",
 "elephas maximus": "فيل آسيوي, فيل هندي (فيل آسيوي له آذان أصغر وأنياب توجد أساساً لدى الذكور)",
 "elettaria cardamomum": "حبهان, هيل (عشب جذموري من الهند له بذور عطرية تستخدم كتوابل)",
 "eleusine coracana": "دخن الإصبع, راجي (عشب حبوب من شرق الهند تنتج بذوره دقيقاً مراً نوعاً ما، وهو غذاء أساسي في الشرق)",
 "eleusine indica": "عشب الإوز, نجيل هندي (عشب حولي خشن له سنابل زهور تشبه الأصابع؛ موطنه المناطق الاستوائية في العالم القديم؛ عشبة ضارة متوطنة في أماكن أخرى)",
 "eleuthera bark": "قِشْرَةُ العَنْبَر, كَسْكَارِيلا (لحاء عطري للكسكاريلا؛ يستخدم كمقوٍ ولصنع البخور)",
 "elevate": "رفع (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ)\nمثال: رفع سامي نظارته.",
 "elevated": "مُرْتَفِع (ازداد في الكمّية أو الدرجة) / مُرْتَفِع عَنِ الأَرْض (مرفوع فوق سطح الأرض) / رَفِيع, سَامٍ (ذو قيمة أخلاقية أو فكرية عالية؛ سامٍ في طبيعته أو أسلوبه) / سكة حديد معلقة, قطار معلق (سكة حديد تعمل بالكهرباء وتسير على مسار مرتفع فوق مستوى الشارع)",
 "elevated railroad": "سكة حديد معلقة, قطار معلق (سكة حديد تعمل بالكهرباء وتسير على مسار مرتفع فوق مستوى الشارع)",
 "elevated railway": "سكة حديد معلقة, قطار معلق (سكة حديد تعمل بالكهرباء وتسير على مسار مرتفع فوق مستوى الشارع)",
 "elevation": "منسوب",
 "elevator": "مِصْعَدْ",
 "elevator boy": "رجل المصعد, عامل مصعد (رجل موظف لتشغيل المصعد)",
 "elevator car": "عربة المصعد, كابينة المصعد (حيث يركب الركاب للصعود والنزول)\nمثال: كانت عربة المصعد في الطابق العلوي",
 "elevator girl": "عاملة مصعد, فتاة المصعد (فتاة موظفة لتشغيل المصعد)",
 "elevator man": "رجل المصعد, عامل مصعد (رجل موظف لتشغيل المصعد)",
 "elevator operator": "عامل مصعد (مُشغل للمصعد)",
 "elevator shaft": "بئر المصعد (عمود رأسي في مبنى يسمح بمرور المصعد من طابق لآخر)",
 "eleven": "أَحَد عَشَر, إِحْدَى عَشْرَةَ (العدد وَاحِد؛ الوَاحِد من الشيء)\nمثال: لم يساعدني أحد.",
 "eleven o'clock": "السَاعَة الحَادِيَة عَشَرَة",
 "eleven-plus": "امتحان أحد عشر بلس ((سابقاً في بريطانيا) امتحان يؤديه الطلاب البالغون من العمر 11 و 12 عاماً لاختيار المرشحين المناسبين للمدرسة الثانوية)",
 "eleven-sided": "أُحَادِيّ عَشَرِيّ الأَضْلَاع (ذو أحد عشر ضلعاً)",
 "eleventh": "حَادِيَ عَشَرَ, حَادِيَةَ عَشْرَةَ",
 "eleventh cranial nerve": "عصب إضافي, عصب قحفي حادي عشر (ينشأ من مجموعتين من الجذور (قحفية وشوكية) تتحد لتشكل العصب)",
 "eleventh hour": "آخر لحظة، اللحظة الأخيرة (ضد الأوَّل؛ وهو من يكون ترتيبه بعد الجميع؛ الشيء: مؤخرّه، الجزء الآخير منه)\nمثال: أرني مثالا آخر.",
 "elf": "آلْف",
 "elf cup": "كأس القزم (الثمرة القرصية لفطر من فصيلة الفنجانية)",
 "elfin": "دَقِيق وَلَطِيف, رَشِيق (صغير ورقيق ولطيف) / أُسْطُورِيّ, جِنِّيّ (يوحي بالجن في غرابته وانتمائه إلى عالم آخر) / خَبِيث بِلُطْف, شَقِيّ (مشاغب بطبعه بطريقة حسنة النيّة عادةً) / جني, قزمي (متعلق بـ أو مصنوع أو منفذ بواسطة قزم (جني) أو كما لو كان بواسطته)\nمثال: أجراس قزمية",
 "elfish": "خَبِيث بِلُطْف, شَقِيّ (مشاغب بطبعه بطريقة حسنة النيّة عادةً)",
 "elflike": "دَقِيق وَلَطِيف, رَشِيق (صغير ورقيق ولطيف)",
 "elgin marbles": "رخاميات إلغن (مجموعة من المنحوتات الرخامية اليونانية الكلاسيكية وشظايا معمارية أنشأها فيدياس؛ ومعظمها من البارثينون في أثينا)",
 "eli": "عالي",
 "elicit": "يُهَيِّج, يُوْقِظ / اِنْتَزَعَ (الشيء من مكانه: بمعنى نَزَعَ وغالبا ما يقصد به الشدة والاجبار)",
 "elicitation": "استثارة, استحثاث (تحفيز يستدعي (يستخرج) فئة معينة من السلوكيات)\nمثال: لم يكن استخلاص شهادته سهلاً",
 "elicited": "مُسْتَثَار, مُسْتَحْضَر (استُدعِي من حالة كامنة أو محتملة عن طريق التحفيز)",
 "elide": "أَسْقَطَ, حَذَفَ ((أَسْقَطَ) في قوله أو فعله أخطأ وزل. ويقال تكلم فما أسقط في كلمة ما أخطأ؛ (أَسْقَطَ) له: خاطبه بسقط الكلام)\nمثال: أسقط زيري هاتفه.",
 "eligibility": "أَهْلِيَّة, اسْتِحْقَاق (صفة أو حالة كون الشخص مؤهلاً)\nمثال: أهلية المرشح للمنصب",
 "eligible": "مؤهل, مستحق (مؤهل لـ أو مسموح له أو يستحق أن يتم اختياره)\nمثال: مؤهل للترشح للمنصب",
 "elijah": "إِيلِيَّا, إِلْيَاس",
 "elimination": "حذف (حَذَفَ الشّيء:قطعه وأَسْقَطَه. حَذَفَ الْمُرَاجِعُ عِبَارَةً منَ الْخِطَابِ؛ حَذَفَهُ بِالعَصَا: ضَرَبَهُ ، ورَمَاهُ بِها)\nمثال: حذف ياني حسابه.",
 "elimination reaction": "تفاعل انتزاع, تفاعل حذف (تفاعل كيميائي يتحلل فيه جزيء إلى جزيئين مختلفين)",
 "elimination tournament": "بطولة خروج المغلوب (بطولة يتم فيها إقصاء الخاسرين في جولات متتالية)",
 "eliminator": "مُزيل, مُقْصٍ (عامل يقوم بإزالة شيء ما)",
 "elint": "استخبارات إلكترونية (استخبارات مستمدة من الإشعاعات الكهرومغناطيسية من مصادر أجنبية (بخلاف المصادر المشعة))",
 "elinvar": "إلينفار, فولاذ الكروم والنيكل (اسم تجاري لنوع من الفولاذ يستخدم لنوابض الساعات لأن مرونته ثابتة عبر نطاق واسع من درجات الحرارة)",
 "elisa": "إليزا, المقايسة المناعية المرتبطة بالإنزيم (مقايسة تعتمد على تفاعل تحويل إنزيمي وتستخدم للكشف عن وجود مواد محددة (مثل الإنزيمات أو الفيروسات أو الأجسام المضادة أو البكتيريا))",
 "elisabeth": "إِلِيصَابَات",
 "elisha": "الْيَسَع, أَلِيشَع ((في الإسلام) نبي ورد ذكره اسمًا مرتين في القرآن)",
 "elisheba": "أَلِيشَابَعْ",
 "elision": "إِسْقَاط, حَذْف",
 "elista": "إِيلِيسْتَا",
 "elite": "نُخْبَة",
 "elite group": "صفوة, نخبة (مجموعة أو طبقة من الأشخاص يتمتعون بوضع فكري أو اجتماعي أو اقتصادي متفوق)",
 "elitism": "نُخْبَوِيَّة",
 "elitist": "نخبوي (شخص يؤمن بحكم النخبة)",
 "elixir": "إِكْسِير",
 "elixir of life": "إكسير الحياة (مادة افتراضية يعتقد أنها تحافظ على الحياة إلى أجل غير مسمى؛ كان يسعى إليها الخيميائيون)",
 "elixophyllin": "إليكسوفيلين, ثيوفيلين (قلويد بلوري عديم اللون مشتق من أوراق الشاي أو يصنع صناعياً؛ يستخدم في الطب كموسع للشعب الهوائية)",
 "elizabeth": "إِلِيزَابِيث, إِلِيصَابَات",
 "elizabethan": "إليزابيثي (من أو يتعلق بإليزابيث الأولى ملكة إنجلترا أو بالعصر الذي حكمت فيه كملكة) / إِلِيزَابِيثِيّ (شخص عاش في عهد الملكة إليزابيث الأولى)\nمثال: موسيقى إليزابيثية",
 "elizabethan sonnet": "سونيتة إنجليزية, سونيتة شكسبيرية (سونيتة تتكون من ثلاث رباعيات وخاتمة ثنائية في البحر الخماسي اليامبي)",
 "elk": "أيل أحمر (أيل شائع في المناطق المعتدلة من أوروبا وآسيا) / إلكة أمريكية, وابيتي (أيل كبير في أمريكا الشمالية يتميز الذكر منه بقرون كبيرة كثيرة التفرع) / إلكة, موس (أيل شمالي كبير يتميز الذكر منه بقرون ضخمة مسطحة؛ يسمى 'إلكة' في أوروبا و 'موس' في أمريكا الشمالية)",
 "elk nut": "جوز الجاموس (فاكهة زيتية حسلية لنبات خشب الأرنب)",
 "elk-wood": "شجرة المظلة, ماغنوليا ثلاثية البتلات (شجرة صغيرة متساقطة الأوراق في شرق أمريكا الشمالية ذات زهور بيضاء كريمية وأوراق كبيرة في تشكيلات تشبه المظلات عند أطراف الفروع)",
 "elkhorn fern": "سرخس قرن الأيل, سرخس قرن الوعل الشائع (سرخس يزرع عادة في أستراليا وجنوب شرق آسيا وبولينيزيا)",
 "elkhound": "كلب الأيل النرويجي (سلالة من الكلاب المدمجة متوسطة الحجم ذات فراء رمادي كثيف طورت في النرويج لصيد الأيائل)",
 "elkwood": "شجرة المظلة, ماغنوليا ثلاثية البتلات (شجرة صغيرة متساقطة الأوراق في شرق أمريكا الشمالية ذات زهور بيضاء كريمية وأوراق كبيرة في تشكيلات تشبه المظلات عند أطراف الفروع)",
 "ell": "جناح جانبي, ملحق متعامد (ملحق في النهاية وبزاوية قائمة مع المبنى الرئيسي)",
 "ell-wand": "عصا القياس\nمثال: طلب إدوارد الأول ملك إنجلترا أن يكون لكل مدينة عصا قياس واحدة على الأقل (ما يتخذ من خَشَب للتوكؤ أو الضرب؛ تطلق مجازا على عَظْم السَاق وعلى اللِسَان)\nمثال: لا تمسك العصا من الوسط.",
 "elliott wave": "موجَة إليوت",
 "elliott's goldenrod": "عصا الذهب إليوت (ما يتخذ من خَشَب للتوكؤ أو الضرب؛ تطلق مجازا على عَظْم السَاق وعلى اللِسَان)\nمثال: لا تمسك العصا من الوسط.",
 "ellipse": "إِهْلِيلَج, قَطْعٌ نَاقِص",
 "ellipsis": "حَذْف, إِضْمَار (حَذَفَ الشّيء:قطعه وأَسْقَطَه. حَذَفَ الْمُرَاجِعُ عِبَارَةً منَ الْخِطَابِ؛ حَذَفَهُ بِالعَصَا: ضَرَبَهُ ، ورَمَاهُ بِها)\nمثال: حذف ياني حسابه.",
 "ellipsoid": "إِهْلِيلَجِيّ, شِبْهُ كُرَوِيّ (ذو طبيعة أو شكل القَطْع الناقص المجسَّم) / مجسم بيضوي, مجسم قطع ناقص (سطح مقاطعه المستوية كلها قطوع ناقصة أو دوائر)\nمثال: الأرض عبارة عن مجسم بيضوي",
 "ellipsoid of revolution": "شبه كرة, كرواني (شكل يتولد عن تدوير قطع ناقص حول أحد محاوره)",
 "ellipsoidal": "إِهْلِيلَجِيّ, شِبْهُ كُرَوِيّ (ذو طبيعة أو شكل القَطْع الناقص المجسَّم)",
 "elliptic": "إِضْمَارِيّ, حَذْفِيّ (يَتَّسِمُ بِالِاقْتِصَادِ الشَّدِيدِ فِي التَّعْبِيرِ أَوْ حَذْفِ العَنَاصِرِ الزَّائِدَةِ) / إِهْلِيلَجِيّ, بَيْضَوِيّ (مستدير كالبيضة؛ ذو شكل بيضاوي) / إِهْلِيلَجِيّ ((عن شكل الورقة) بيضاويّ الشكل)",
 "elliptic geometry": "هندسة إهليلجية, هندسة ريمانية ((رياضيات) هندسة لا إقليدية تعتبر الفضاء مثل كرة والخط مثل دائرة عظمى)",
 "elliptic leaf": "ورقة إهليلجية (ورقة بسيطة على شكل قطع ناقص)",
 "elliptical": "إِضْمَارِيّ, حَذْفِيّ (يَتَّسِمُ بِالِاقْتِصَادِ الشَّدِيدِ فِي التَّعْبِيرِ أَوْ حَذْفِ العَنَاصِرِ الزَّائِدَةِ) / إِهْلِيلَجِيّ, بَيْضَوِيّ (مستدير كالبيضة؛ ذو شكل بيضاوي)",
 "elliptical galaxy": "مَجَرَة إِهْلِيجِيَّة (نجوم كثيرة لا تدرك بمجرد البصر، وعندما ينتشر ضوؤها فيُرى كأنه بقعة بيضاء (أي: مصادر ضوء كثيرة بحيث يبدو ضوئها كوهج بدلاً من أن يَبدو كل نجم واضحٍ…؛ باب السماء، وهي البياض الذي يَعبر السماء ويَقع بين النّسرَين (المقصود هنا هو مجرة دَرْب التّبانَة…)\nمثال: أنا بطل المجرة.",
 "ellipticity": "إهليلجية, تفلطح (الخاصية التي يمتلكها شكل دائري مفلطح عند القطبين)\nمثال: تفلطح الكوكب",
 "ellul": "أيلول (الشهر الثاني عشر من السنة المدنية؛ الشهر السادس من السنة الدينية في التقويم اليهودي (في أغسطس وسبتمبر))",
 "ellwand": "عصا القياس\nمثال: طلب إدوارد الأول ملك إنجلترا أن يكون لكل مدينة عصا قياس واحدة على الأقل (ما يتخذ من خَشَب للتوكؤ أو الضرب؛ تطلق مجازا على عَظْم السَاق وعلى اللِسَان)\nمثال: لا تمسك العصا من الوسط.",
 "elm": "دَرْدَار, بُوقِيصَا",
 "elm tree": "دردار, شجر الدردار (أي من الأشجار المتعددة من جنس أولموس: أشجار خشبية أو ظل مهمة)",
 "elmo": "إِلْمُو, أَلْمُو",
 "elmwood": "خشب الدردار (خشب صلب قاسي لشجرة الدردار؛ يستخدم على سبيل المثال للأدوات والأثاث)",
 "elocution": "فن الإلقاء (طريقة خبيرة في التحدث تتضمن التحكم في الصوت والإيماءات)",
 "elocutionary": "خَطَابِيّ مُتَصَنِّع ((لأسلوب الكلام) مبالغ في التنميق والتزويق) / إلقائي (من أو متعلق بفن الإلقاء)\nمثال: حفلات إلقائية",
 "elocutionist": "خبير إلقاء (متحدث عام مدرب على إنتاج الصوت والإيماءات والإلقاء)",
 "elodea canadensis": "إيلودية كندية, حشيشة الماء الكندية (حشيشة ماء من أمريكا الشمالية؛ تم توطينها على نطاق واسع في أوروبا)",
 "elodea densa": "إيجيريا كثيفة, إيلودية كثيفة (نبات مائي ذو أوراق خضراء داكنة مفيد لإضافة الأكسجين لحوض السمك؛ يوضع أحياناً في جنس إيجيريا)",
 "elohim": "إِلُوهِيم",
 "elongate": "مُسْتَطِيل, مُطَوَّل (أَطْوَل بِشَكْل مَلْحوظ مِنَ العَرْض؛ طَويل وَنَحيل) / خَطِّيّ, مُسْتَطِيل ((عن شكل الورقة) طويل وضيّق)",
 "elongate leaf": "ورقة خطية (ورقة نحيلة طويلة)",
