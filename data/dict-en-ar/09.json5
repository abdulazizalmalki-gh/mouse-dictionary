 "ephemerid": "ذبابة مايو (حشرة قصيرة العمر)",
 "ephemeris": "تقويم فلكي, زيج (منشور سنوي يحتوي على جداول فلكية تعطي مواقع الأجرام السماوية على مدار العام)\nمثال: اليوم تقوم أجهزة الكمبيوتر بحساب التقاويم الفلكية",
 "ephemeris time": "التوقيت الأرضي, توقيت التقويم الفلكي ((علم الفلك) مقياس للوقت محدد بحركة الأرض المدارية؛ التوقيت الأرضي هو التوقيت الشمسي المتوسط مصححاً لعدم انتظام حركات الأرض)",
 "ephemeron": "كائن سريع الزوال (أي شيء قصير العمر، مثل حشرة تعيش ليوم واحد فقط في شكلها المجنح)",
 "ephemeropteran": "ذبابة مايو (حشرة قصيرة العمر)",
 "ephesian": "أفسسي (مكون من أو متعلق بأفسس القديمة أو شعبها أو لغتها أو ثقافتها) / أفسسي (مقيم في مدينة أفسس اليونانية القديمة)",
 "ephesians": "اَلرِّسَالَة إِلَى أَهْلِ أَفَسُسَ",
 "ephestia elutella": "عثة التبغ (عثة صغيرة تتغذى يرقاتها على التبغ ومنتجات نباتية مجففة أخرى)",
 "ephesus": "أَفَسُس",
 "ephippiorhynchus senegalensis": "لقلق سرج المنقار (لقلق كبير أسود وأبيض من أفريقيا الاستوائية؛ منقاره الأحمر له شريط أسود حول المنتصف)",
 "ephraim": "أَفْرَايِم",
 "epi": "استبيان آيسنك للشخصية (استبيان تقرير ذاتي للشخصية يعتمد على التحليل العاملي للشخصية لهانز آيسنك)",
 "epic": "مَلْحَمَة / مَلْحَمِيّ (متعلق بالكتب، أو الأفلام، أو الأشعار، أو بغيرها من الوسائط التي تصور دراما إنسانية على نطاق واسع، وتُعرف باسم الملحمات أو الملحميات)",
 "epic poem": "قصيدة ملحمية, ملحمة (قصيدة سردية طويلة تروي مآثر بطل)",
 "epic poetry": "شعر بطولي, شعر ملحمي (شعر يحتفي بمآثر بطل ما)",
 "epic theatre": "مسرح ملحمي (شكل من الدراما التعليمية يقدم سلسلة من المشاهد المترابطة بشكل فضفاض والتي تتجنب الوهم وتخاطب الجمهور مباشرة)",
 "epical": "ملحمي (يشكل ملحمة أدبية أو يتعلق بها أو يوحي بها)\nمثال: تقليد ملحمي",
 "epicalyx": "كَأْس كَاذِب, كُؤَيْس (مجموعة من القنابات تحاكي الكأس كما في القرنفل أو الخطمي)",
 "epicanthic": "موقي (متعلق بطية الموق (ثنية الجلد للجفن العلوي))\nمثال: طيات موقية",
 "epicanthic fold": "طية علاية الموق (طية عمودية من الجلد فوق الموق الأنفي؛ نموذجية للعديد من شعوب شرق آسيا؛ وتحدث أحياناً في متلازمة داون)",
 "epicanthus": "طية علاية الموق (طية عمودية من الجلد فوق الموق الأنفي؛ نموذجية للعديد من شعوب شرق آسيا؛ وتحدث أحياناً في متلازمة داون)",
 "epicardia": "مريء بطني (الجزء القصير من المريء الذي يمتد لأسفل من الحجاب الحاجز إلى المعدة)",
 "epicardium": "تامور حشوي, نخاب (الطبقة الداخلية من طبقتي التامور)",
 "epicarp": "إِيكُوكَارْب, القِشْرَةُ الخَارِجِيَّة (الطبقة الخارجية القصوى لغلاف الثمرة، مثل قشرة الخوخ أو العنب)",
 "epicarpal": "خارجي الغلاف, قشري الثمرة (من بلاد الخارج؛ من الخوارج)\nمثال: بحث سامي عن مساعدة خارجية.",
 "epicene": "مُتَأَنِّث, مُخَنَّث (يتحلى بصفات أنثوية غير لائقة بالرجل) / مُزْدَوِجُ الجِنْس (ذو هوية جنسية مُلتبسة) / خنثى (شخص يمتلك خصائص وأعضاء جنسية ذكرية وأنثوية؛ ولا يمكن تحديد جنسه بشكل قاطع عند الولادة)",
 "epicene person": "خنثى (شخص يمتلك خصائص وأعضاء جنسية ذكرية وأنثوية؛ ولا يمكن تحديد جنسه بشكل قاطع عند الولادة)",
 "epicenter": "بؤرة سطحية, مركز زلزالي سطحي (النقطة على سطح الأرض الواقعة مباشرة فوق بؤرة الزلزال)",
 "epicentre": "مَرْكَز, مَرْكَز اَلزِّلْزَال (موضع الاِرْتِكَاز عامة؛ موضع الشخص ومحلّه الذي يبقى فيه عادة) / بُؤْرَة\nمثال: أين أقرب مركز شرطة؟",
 "epicheirema": "إبيشيريما, قياس مركب (قياس منطقي يتم فيه تقديم عبارة داعمة لإحدى المقدمتين أو كلتيهما مع المقدمات نفسها)",
 "epicness": "عظمة, ملحمية (الجودة أو الحالة التي تتسم بالبطولة الهامة أو الضخامة في النطاق أو الطابع)\nمثال: كنا متحمسين للغاية لرواية موبي ديك، وأحببنا فكرة جلب ملحمية عمل ملفيل إلى شيء يمكنك حمله والتفاعل معه",
 "epicondyle": "فوق اللقمة, لقيمة (نتوء على عظم فوق اللقمة يعمل كمرتكز للعضلات والأربطة)",
 "epicondylitis": "التهاب اللقيمة (التهاب مؤلم في العضلات والأنسجة الرخوة حول اللقيمة)",
 "epicranium": "فَرْوَةُ القِحْف (العضلة والسفاق والجلد الذي يغطي القحف)",
 "epicure": "ذواقة, محب للطعام (شخص مكرس للاستمتاع الحسي المترف (خاصة الطعام والشراب الجيد))",
 "epicurean": "إِبِيقُورِيّ",
 "epicureanism": "أبيقورية (مذهب المتعة الذي دافع عنه العديد من الفلاسفة اليونانيين القدماء)",
 "epicurism": "أبيقورية, تلذذ (طبع وعادات الأبيقوري (المحب للملذات))",
 "epicurus": "إِبِيقُور",
 "epicycle": "فَلَك التَّدوِير (التَلّ المستدير من الرَمْل حوله فَضَاء؛ المَدَار يسبح فيه الجُرْم السماويّ)\nمثال: أصبح زيري عالم فلك.",
 "epicyclic": "فلكي تدويري, فوق دوري (من أو يتعلق بالفلك التدويري (دائرة تدور حول محيط دائرة أخرى))\nمثال: مجموعة تروس كوكبية",
 "epicyclic gear": "ترس تداويري, ترس كوكبي (ترس خارجي يدور حول ترس شمسي مركزي في مجموعة تروس تداويرية)",
 "epicyclic gear train": "تروس تداويرية, تروس كوكبية (نظام من التروس التداويرية يدور فيه محور عجلة واحدة على الأقل حول محور ثابت آخر)",
 "epicyclic train": "تروس تداويرية, تروس كوكبية (نظام من التروس التداويرية يدور فيه محور عجلة واحدة على الأقل حول محور ثابت آخر)",
 "epicyclical": "فلكي تدويري, فوق دوري (من أو يتعلق بالفلك التدويري (دائرة تدور حول محيط دائرة أخرى))\nمثال: مجموعة تروس كوكبية",
 "epicycloid": "دويري خارجي (خط يتولد عن نقطة على دائرة تتدحرج حول دائرة أخرى)",
 "epideictic": "اسْتِعْرَاضِيّ, خَطَابِيّ (مُصَمَّمٌ أَسَاسًا لِلْعَرْضِ البَلَاغِيّ)",
 "epideictic oratory": "خطابة استعراضية (نوع من الخطابة يستخدم لمدح أو إدانة شخص أو مجموعة من الناس)\nمثال: خطبة جنازة بريكليس للأثينيين الذين قتلوا في الحرب البيلوبونيسية هي مثال شهير للخطابة الاستعراضية",
 "epideictical": "اسْتِعْرَاضِيّ, خَطَابِيّ (مُصَمَّمٌ أَسَاسًا لِلْعَرْضِ البَلَاغِيّ)",
 "epidemic": "وَبَاء, أَوْبِئَة (المرض العام الذي ينتشر بين الناس)\nمثال: على السلطات أن توقف انتشار الوباء.",
 "epidemic cholera": "كوليرا (عدوى معوية حادة ناجمة عن تناول مياه أو طعام ملوث)",
 "epidemic disease": "مرض وبائي (أي مرض معد يتطور وينتشر بسرعة بين العديد من الناس)",
 "epidemic encephalitis": "التهاب الدماغ السباتي, مرض النوم (التهاب دماغ كان وبائياً بين عامي 1915 و1926؛ تشمل الأعراض شلل عضلة العين الخارجية وضعف عضلي شديد)",
 "epidemic hysteria": "هستيريا جماعية (حالة تظهر فيها مجموعة كبيرة من الناس نفس حالة الهياج العقلي العنيف)",
 "epidemic meningitis": "التهاب السحايا الدماغي الشوكي, حمى مخية شوكية (التهاب سحايا تسببه البكتيريا وغالبًا ما يكون مميتًا)",
 "epidemic myalgia": "ألم جنبي وبائي, ألم عضلي وبائي (مرض معد حاد يحدث في شكل وبائي ويتميز بنوبات ألم (عادة في الصدر))",
 "epidemic parotitis": "التهاب الغدة النكفية الوبائي, نكاف (مرض فيروسي معد حاد يتميز بالحمى وتورم الغدد النكفية)",
 "epidemic pleurodynia": "ألم جنبي وبائي, ألم عضلي وبائي (مرض معد حاد يحدث في شكل وبائي ويتميز بنوبات ألم (عادة في الصدر))",
 "epidemic roseola": "حصبة ألمانية (مرض فيروسي معدٍ هو شكل أخف من الحصبة يستمر ثلاثة أو أربعة أيام؛ يمكن أن يضر بالجنين خلال الأشهر الثلاثة الأولى)",
 "epidemiologic": "وبائي (من أو يتعلق بعلم الأوبئة)\nمثال: دراسات وبائية",
 "epidemiological": "وبائي (من أو يتعلق بعلم الأوبئة)\nمثال: دراسات وبائية",
 "epidemiologist": "عالم أوبئة (عالم طبي يدرس انتقال الأمراض الوبائية والسيطرة عليها)",
 "epidemiology": "عِلْم أَوْبِئَة (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "epidendron": "إبيدندرون (أي من بساتين الفاكهة المختلفة من جنس إبيدندروم)",
 "epidendrum tampense": "أوركيد الفراشة (أوركيد فلوريدا وجزر البهاما ذو زهور زاهية الألوان مبهرجة؛ يوضع أحياناً في جنس إبيدندروم)",
 "epidendrum venosum": "أوركيد الفراشة (أوركيد هوائي مكسيكي ذو زهور خضراء شاحبة أو خضراء مصفرة بشفة بيضاء معرقة بالأرجواني)",
 "epidermal": "جليدي, قشيري (متعلق بالقشيرة (الجليدة) أو البشرة المتصلبة)",
 "epidermal cell": "خلية بشرة (أي من الخلايا المكونة للبشرة)",
 "epidermic": "جليدي, قشيري (متعلق بالقشيرة (الجليدة) أو البشرة المتصلبة)",
 "epidermis": "بشرَة",
 "epidiascope": "إبيدياسكوب, جهاز عرض فوقي (جهاز عرض بصري يعطي صوراً للأجسام الشفافة والمعتمة)",
 "epididymis": "بَرْبَخ",
 "epididymitis": "التهاب البربخ (التهاب مؤلم في البربخ)",
 "epidural": "فوق الجافية (على أو خارج الأم الجافية) / تخدير فوق الجافية (تخدير ناحي ناتج عن حقن مخدر في الحيز فوق الجافية للحبل الشوكي؛ يُفقد الإحساس في مناطق البطن والأعضاء التناسلية والحوض؛ يستخدم في الولادة وجراحة أمراض…)",
 "epidural anaesthesia": "تخدير فوق الجافية (تخدير ناحي ناتج عن حقن مخدر في الحيز فوق الجافية للحبل الشوكي؛ يُفقد الإحساس في مناطق البطن والأعضاء التناسلية والحوض؛ يستخدم في الولادة وجراحة أمراض…)",
 "epidural anesthesia": "تخدير فوق الجافية (تخدير ناحي ناتج عن حقن مخدر في الحيز فوق الجافية للحبل الشوكي؛ يُفقد الإحساس في مناطق البطن والأعضاء التناسلية والحوض؛ يستخدم في الولادة وجراحة أمراض…)",
 "epidural injection": "حقن فوق الجافية (حقن مادة مخدرة في الحيز فوق الجافية للحبل الشوكي لإحداث تخدير فوق الجافية)",
 "epigaea repens": "زهرة مايو, قطلب زاحف (شجيرة دائمة الخضرة منخفضة النمو من شرق أمريكا الشمالية ذات أوراق جلدية وعناقيد من الزهور العطرية الوردية أو البيضاء)",
 "epigastric": "فوق معدي (يقع على أو فوق المعدة) / شرسوفي (مكون من أو متعلق بالجدران الأمامية للبطن)\nمثال: شريان شرسوفي",
 "epigastric artery": "شريان شرسوفي (واحد من ثلاثة شرايين تغذي الجدران الأمامية للبطن)",
 "epigastric fossa": "الحفرة الشرسوفية, فم المعدة (انخفاض طفيف في خط الوسط أسفل القص مباشرة (حيث يمكن لضربة أن تؤثر على الضفيرة الشمسية))",
 "epigastric vein": "وريد شرسوفي (أوردة تخدم الجدران الأمامية للبطن)",
 "epigastrium": "شرسوف, منطقة فوق المعدة (المنطقة الواقعة على أو فوق المعدة (أسفل عظم القص مباشرة))",
 "epigenesis": "تخلق لاحق (تغير جيولوجي في المحتوى المعدني للصخر بعد تشكله)",
 "epiglottic cartilage": "غضروف لسان المزمار (صفيحة رقيقة من الغضروف المرن تشكل الجزء المركزي من لسان المزمار)",
 "epiglottis": "لِسَان اَلْمِزْمَار (فِي : جسم لحميّ مستطيل متحرك، يكون في الفم، ويصلح للتّذوُّق والبلع، وللنطق؛ جَارِحَة الْكَلَام؛ كَلِمَة)\nمثال: ماري لها فم ليس لها لسان.",
 "epiglottitis": "التهاب لسان المزمار (التهاب لسان المزمار؛ يتميز بالحمى والتهاب الحلق الشديد وصعوبة في البلع)",
 "epigon": "تَابِع, مُقَلِّد (مقلد أقل مستوى لكاتب أو فنان أو موسيقي متميز)",
 "epigone": "تَابِع, مُقَلِّد (مقلد أقل مستوى لكاتب أو فنان أو موسيقي متميز)",
 "epigram": "إبيجرام, قول فطن (قول ذكي أو ظريف)",
 "epigrammatic": "أَقْوَالِيّ, حِكَمِيّ (مُوجَزٌ وَظَرِيفٌ وَشَبِيهٌ بِالحِكْمَةِ أَوِ المَثَلِ)",
 "epigraph": "نقش أثري (نقش محفور) / عبارة استهلالية, نقش (اقتباس في بداية قطعة كتابية ما)",
 "epigraphy": "علم النقوش (دراسة النقوش القديمة)",
 "epikeratophakia": "رأب القرنية فوق العدسة (استخدام قطعة من نسيج القرنية المتبرع به لإصلاح عين شخص تمت إزالة الساد منها)\nمثال: أعطتها عملية رأب القرنية فوق العدسة عدسة لاصقة حية",
 "epilachna varivestis": "خنفساء الفاصوليا المكسيكية (أدخلت إلى الولايات المتحدة من المكسيك؛ تتغذى على أوراق نبات الفاصوليا)",
 "epilating wax": "شمع إزالة الشعر (خليط من الراتنجات والشموع لإزالة الشعر غير المرغوب فيه تجميلياً؛ يوضع الخليط ساخناً على السطح وبعد التبريد يتم سحبه ليأخذ الشعر معه)",
 "epilation": "إزالة الشعر (فعل إزالة الشعر (كما من جلد الحيوان)) / إزالة الشعر (فقدان الشعر؛ نتيجة إزالة الشعر)",
 "epilator": "مزيل الشعر (مستحضر تجميلي لإزالة الشعر غير المرغوب فيه مؤقتاً)",
 "epilepsia major": "صرع كبير, نوبة معممة (نوبة يصبح خلالها المريض فاقداً للوعي ويعاني من تشنجات في جميع أنحاء الجسم) / صرع كبير, نوبة توترية رمعية (صرع تتضمن نوباته فقدان الوعي وتشنجات توترية في العضلات يتبعها ارتعاش عام)",
 "epilepsia minor": "صرع صغير, نوبة خفيفة (نوبة قصيرة الأمد تتميز بفقدان لحظي للوعي وتشنجات عضلية موضعية أو ارتعاش) / صرع صغير, نوبة غيبية (صرع يتميز بنوبات انتيابية من تغيم الوعي لفترة وجيزة (وربما تشوهات أخرى))\nمثال: خافت الفتاة من أول نوبة صرع صغيرة لها",
 "epilepsy": "صَرْع (طَرَحَه على الأرض؛ أَرْدَاهُ قَتِيلاً وأَهْلَكَهُ)",
 "epileptic": "صرعي (من أو يتعلق بالصرع أو يتميز به) / مَرِيض بِالصَّرْع, مَصْرُوع (شخص مصاب بالصرع)\nمثال: نوبة صرع",
 "epileptic seizure": "نوبة صرع (تشنجات مصحوبة بضعف في الوعي)",
 "epilith": "كائن فوق صخري, نبات صخري (نبات أو فطر أو كائن آخر ينمو على الصخور)",
 "epilithic": "فوق صخري (ينمو على الحجر)\nمثال: حزازيات فوق صخرية",
 "epilobium angustifolium": "عشبة الصفصاف العملاقة, عشبة النار (نبات معمر طويل من أمريكا الشمالية ذو جذور زاحفة وأوراق ضيقة وسنابل من الزهور الوردية الأرجوانية توجد بكثرة كبيرة في المناطق المحترقة أو المناطق التي…)",
 "epilobium canum canum": "فوشية كاليفورنية (شجيرة صغيرة من جنوب غرب الولايات المتحدة إلى المكسيك لها زهور قرمزية متألقة)",
 "epilobium hirsutum": "عشبة الصفصاف المشعرة (نبات من أوروبا وآسيا ذو أزهار حمراء أرجوانية وسيقان وأوراق مشعرة؛ أدخل إلى أمريكا الشمالية)",
 "epilog": "تذييل, خاتمة أدبية (مقطع قصير يضاف في نهاية عمل أدبي) / خاتمة مسرحية (خطاب قصير (غالباً شعري) يوجهه ممثل مباشرة للجمهور في نهاية المسرحية)\nمثال: أخبرت الخاتمة بما حدث في النهاية للشخصيات الرئيسية",
 "epilogue": "خَاتِمَة",
 "epimedium grandiflorum": "عشبة العقر, قبعة الأسقف (نبات زاحف بطيء النمو بأوراق شبه دائمة الخضرة على سيقان سلكية منتصبة؛ يستخدم كغطاء أرضي)",
 "epimetheus": "ابيمثيوس",
 "epimorphic": "فَوْقِ تَحَوُّلِيّ (يَتَّسِمُ بِتَحَوُّلٍ غَيْرِ مُكْتَمِل؛ يَحْتَفِظُ بِنَفْسِ عَدَدِ قِطَعِ الجِسْم)",
 "epimythium": "المغزى, خاتمة الحكاية الخرافية (مغزى أخلاقي في نهاية قصة)",
 "epinephelus adscensionis": "هند الصخور (توجد حول السواحل الصخرية أو على الشعاب المرجانية)",
 "epinephelus fulvus": "كوني (سمكة مرقطة بالأسود عادة ما تكون داكنة اللون ذات زعانف مائلة للاحمرار)",
 "epinephrin": "أدرينالين, إبينفرين (كاتيكولامين تفرزه نخاع الغدة الكظرية استجابة للتوتر؛ يحفز عمل الأعصاب اللاإرادية)",
 "epinephrine": "أدرينالين, إبينفرين (كاتيكولامين تفرزه نخاع الغدة الكظرية استجابة للتوتر؛ يحفز عمل الأعصاب اللاإرادية)",
 "epipactis gigantea": "سحلب الجدول (سحلب ينمو على طول الجداول أو البرك في غرب أمريكا الشمالية له سيقان ورقية وزهرة واحدة بنية مخضرة ووردية في إبط كل ورقة علوية)",
 "epipactis helleborine": "إيبباكتيس خربقي (سحلب أوروبي بسنابل من الزهور الخضراء والوردية أو الأرجوانية)",
 "epipelon": "كائنات فوق طينية (بكتيريا زرقاء وطحالب حقيقية النواة تعيش على أو بالارتباط مع ركائز دقيقة الحبيبات)",
 "epiphany": "تَجَلٍّ",
 "epiphany of our lord": "6 يناير, عيد الغطاس (بعد اثني عشر يومًا من عيد الميلاد؛ يحتفل بزيارة الحكماء الثلاثة للطفل يسوع)",
 "epiphenomenon": "ظاهرة ثانوية, ظاهرة مصاحبة (ظاهرة ثانوية تعد ناتجاً عرضياً لظاهرة أخرى)",
 "epiphonema": "تعليق ختامي (جملة تكون تعجباً، أو تعليقاً عاماً أو لافتاً، أو ملخصاً موجزاً لما قيل سابقاً)",
 "epiphora": "تكرار النهاية, سجع (تكرار نهايات جملتين أو أبيات متتالية أو أكثر)",
 "epiphyllum": "إبيفيلم, صبار الأوركيد (أي صبار من جنس إبيفيلم له سيقان مسطحة مفصلية متفرعة بشكل غير منتظم وأزهار أنبوبية مبهرجة)",
 "epiphyseal": "مشاشي (يتعلق بالمشاش (نهاية العظم))",
 "epiphyseal plate": "صَفِيحَة مُشَاشِيَّة, صَفِيحَة النُّمُوّ",
 "epiphysial": "مشاشي (يتعلق بالمشاش (نهاية العظم))",
 "epiphysis": "مُشَاشَة",
 "epiphysis cerebri": "غدة صنوبرية (غدة صماء صغيرة في الدماغ؛ تقع أسفل الجزء الخلفي من الجسم الثفني؛ تفرز الميلاتونين)",
 "epiphyte": "نبات فوقي, نبات هوائي (نبات يستمد الرطوبة والمواد المغذية من الهواء والمطر؛ ينمو عادة على نبات آخر ولكنه لا يتطفل عليه)",
 "epiphytic": "عليقي, نباتي هوائي (من أو يتعلق بالنباتات الهوائية (التي تنمو على نباتات أخرى))",
 "epiphytic plant": "نبات فوقي, نبات هوائي (نبات يستمد الرطوبة والمواد المغذية من الهواء والمطر؛ ينمو عادة على نبات آخر ولكنه لا يتطفل عليه)",
 "epiphytotic": "وَبَائِيّ نَبَاتِيّ ((في النباتات) مُنْتَشِر بِشَكْل وَبائِيّ بَيْنَ نَباتات مِن نَوْع واحِد)",
 "epiplexis": "توبيخ (أداة بلاغية يوبخ فيها المتحدث الجمهور لتحريضهم أو إقناعهم)",
 "epipremnum aureum": "بوثوس, بوثوس ذهبي (ليانا دائمة الخضرة تزرع على نطاق واسع لأوراقها المبرقشة)",
 "epipsammon": "كائنات فوق رملية (نباتات وحيوانات مجهرية توجد على سطح و/أو ملتصقة بحبيبات الرمل)",
 "episcia": "إبيسشيا (أي نبات من جنس إبيسشيا؛ عادة ما تكون زاحفة وذات سويقات جارية، وتزرع لأوراقها الملونة وأزهارها)",
 "episcia dianthiflora": "إبيسيا, كرمة زهرة الدانتيل (نبات معمر زاحف منخفض النمو في أمريكا الوسطى ذو زهور بيضاء مهدبة بعمق؛ يوضع أحياناً في جنس إبيسيا)",
 "episcleral veins": "أوردة فوق الصلبة (أوردة صغيرة في الصلبة بالقرب من هامش القرنية؛ تصب في الأوردة الهدبية الأمامية)",
 "episcleritis": "التهاب ظاهر الصلبة (التهاب صلبة العين)",
 "episcopacy": "هيئة الأساقفة (الهيئة الجماعية للأساقفة)",
 "episcopal": "أسقفي, بابوي (يشير إلى أو يحكم بواسطة أو يتعلق بأسقف أو أساقفة) / أسقفي (من أو يخص أو يميز الكنيسة الأسقفية)\nمثال: التسلسل الهرمي الأسقفي",
 "episcopal church": "الكنيسة الأسقفية (كنيسة الولايات المتحدة التي تتواصل مع كرسي كانتربري) / الكنيسة الأسقفية في اسكتلندا (فرع مستقل من الطائفة الإنجليكانية في اسكتلندا)",
 "episcopal church of scotland": "الكنيسة الأسقفية في اسكتلندا (فرع مستقل من الطائفة الإنجليكانية في اسكتلندا)",
 "episcopalian": "أسقفي (من أو يخص أو يميز الكنيسة الأسقفية) / أسقفي (عضو في الكنيسة الأسقفية)\nمثال: التسلسل الهرمي الأسقفي",
 "episcopalianism": "أسقفية (العقيدة اللاهوتية لحكم الكنيسة بواسطة الأساقفة)",
 "episcopate": "أسقفية, منصب الأسقف (منصب ومقام الأسقف) / هيئة الأساقفة (الهيئة الجماعية للأساقفة) / أبرشية, أسقفية (الولاية الإقليمية للأسقف) / أسقفية (فترة ولاية الأسقف)",
 "episiotomy": "بضع الفرج (شقَّ الشيءَ أو قطعه)\nمثال: ستأخذ بضع دقائق.",
 "episode": "حَادِثَة, وَاقِعَة / حَلْقَة, حَلَقَة",
 "episodic": "ظَرْفِيّ, عَرَضِيّ (محصور في حلقة أو حدث واحد) / عَرَضِيّ, مُتَقَطِّع (يحدث أو يظهر على فترات غير منتظمة عادةً) / ذُو حَلَقَات, عَرَضِيّ ((في الكِتَابَة أو السَّرْد) مُقَسَّم إلى حَلَقَاتٍ أو مُؤَلَّف مِنْهَا)",
 "episodic memory": "ذاكرة شخصية, ذاكرة عرضية (ذاكرة لأحداث في حياتك الخاصة)",
 "episodically": "بشكل عرضي, على فترات (بطريقة عرضية أو متقطعة)",
 "episodicity": "تقطع, عرضية (جودة كون الشيء متقطعاً، يحدث بشكل غير متكرر وغير منتظم)",
 "episome": "إبيسوم (حمض نووي لا يندمج في الجينوم ولكنه يتضاعف جنباً إلى جنب مع الجينوم (خاصة في الخلايا البكتيرية))",
 "epispadias": "إحليل فوقي (شذوذ خلقي عند الذكور يكون فيه مجرى البول على السطح العلوي للقضيب)",
 "episperm": "غلاف البذرة, قصرة (الطبقة الخارجية الواقية لبذور النباتات الزهرية)",
 "epistasis": "تفوق جيني, ركود (تثبيط جين بفعل تأثير جين غير ذي صلة)",
 "epistatic gene": "جين سائد فوقي, جين متفوق (جين يحدد ما إذا كان سيتم التعبير عن سمة معينة أم لا)\nمثال: الجين المسؤول عن المهق هو جين متفوق",
 "epistaxis": "رعاف",
 "episteme": "إبستيم, نظام معرفي (مجموعة الأفكار التي تحدد المعرفة المؤكدة فكرياً في أي وقت معين)",
 "epistemic": "إبستمولوجي, معرفي (متعلق بنظرية المعرفة (الإبستمولوجيا))\nمثال: صيغة معرفية",
 "epistemic logic": "المنطق المعرفي (منطق الموجهات المتعلق بالمعرفة وعدم اليقين والجهل)",
 "epistemological": "إبستمولوجي, معرفي (متعلق بنظرية المعرفة (الإبستمولوجيا))\nمثال: صيغة معرفية",
 "epistemologist": "خبير في نظرية المعرفة, عالم إبستيمولوجيا (متخصص في نظرية المعرفة)",
 "epistemology": "إِبِسْتِمُولُوجِيَّا, نَظَرِيَّةْ اَلمَعْرِفَة",
 "epistle": "رِسَالَة",
 "epistolary": "رَسَائِلِيّ (مَكْتُوبٌ فِي شَكْلِ رَسَائِلَ أَوْ يُجْرَى عَنْ طَرِيقِ المُرَاسَلَاتِ)",
 "epistolatory": "رَسَائِلِيّ (مَكْتُوبٌ فِي شَكْلِ رَسَائِلَ أَوْ يُجْرَى عَنْ طَرِيقِ المُرَاسَلَاتِ)",
 "epistrophe": "تكرار النهاية, سجع (تكرار نهايات جملتين أو أبيات متتالية أو أكثر)",
 "epitaph": "شاهد القبر, نص القبر (نص منقوش على شاهد قبر أو نصب تذكاري لذكرى الشخص المدفون هناك) / مرثية, نقش ضريحي (بيان موجز لإحياء ذكرى شخص ميت)",
 "epitaxy": "تنمية فوقية (تنمية طبقة بلورية من معدن ما على قاعدة بلورية لمعدن آخر بحيث يكون اتجاهها البلوري مطابقاً لاتجاه القاعدة)",
 "epithalamium": "قصيدة العرس, نشيد الزفاف (قصيدة غنائية تكريماً للعروس والعريس)",
 "epithelial": "طلائي, ظهاري (من أو ينتمي إلى النسيج الطلائي (الظهارة))\nمثال: طبقة طلائية",
 "epithelial cell": "خلية طلائية, خلية ظهارية (واحدة من الخلايا المتراصة التي تشكل النسيج الطلائي)",
 "epithelial duct": "قناة, مجرى (ممر جسدي أو أنبوب مبطن بخلايا طلائية وينقل إفرازاً أو مادة أخرى)\nمثال: كانت القناة الدمعية مسدودة",
 "epithelial tissue": "ظهارة, نسيج طلائي (نسيج غشائي يغطي الأعضاء الداخلية والأسطح الداخلية الأخرى للجسم)",
 "epithelioid": "طلائي, ظهاري (من أو ينتمي إلى النسيج الطلائي (الظهارة))\nمثال: طبقة طلائية",
 "epithelioma": "ورم ظهاري (ورم خبيث في النسيج الظهاري)",
 "epithelium": "نَسِيج طِلَائِيّ",
 "epithet": "صِفَة (صُفَّة المَسْجِد هي موضع مُظَلَّل منه بين جدران ثلاثة؛ هي غُرْفَة ذات ثلاث جُدْرَان وسَقْف والإتجاه الرابع مَفْتُوح بلا بِنَاء. تستخدم غالبا للجلوس وتواجه صَحْن البَيْت)\nمثال: محاسبة النفس صفة حميدة.",
 "epitome": "مَثَال",
 "epitomize": "جَسَّدَ (جسد - يجسد ، جسدا؛ جسد الدم: يبس)\nمثال: يتكون الإنسان من نفس و جسد.",
 "epitope": "حاتمة, محدد مستضدي (الموقع على سطح جزيء المستضد الذي يرتبط به الجسم المضاد)",
 "epitrachelion": "بطرشيل",
 "epitrochoidal engine": "محرك دوار, محرك فانكل (محرك دوار يعمل كأحد محركات الاحتراق الداخلي رباعية الأشواط دون أجزاء ترددية (مكابس صاعدة وهابطة))",
 "epixylon": "كائنات فوق خشبية (كائنات ملتصقة بأسطح الخشب المغمورة في النظم البيئية المائية)\nمثال: تشير بعض الدراسات إلى أن الخشب والأغشية الحيوية الخشبية (الكائنات فوق الخشبية) قد تكون مورداً مهماً ولكن تم تجاهله",
 "epizoan": "طفيلي خارجي (أي كائن طفيلي خارجي (مثل البراغيث)) / طفيلي خارجي (من أو متعلق بالطفيليات الخارجية)",
 "epizoic": "طفيلي خارجي (يعيش أو ينمو على السطح الخارجي لحيوان عادة كطفيلي)\nمثال: طفيلي نباتي خارجي",
 "epizoon": "طفيلي خارجي (أي كائن طفيلي خارجي (مثل البراغيث))",
 "epizootic": "وَبَائِيّ حَيَوَانِيّ ((في الحيوانات) مُنْتَشِر بِشَكْل وَبائِيّ بَيْنَ حَيَوانات مِن نَوْع واحِد)",
 "epoch": "عَصْر, عُصُور (مصدر للفعل \"عَصَرَ\"؛ أي مدة زمنية، دهر من الوقت)\nمثال: صلى زيري العصر.",
 "epoch-making": "تَارِيخِيّ, حِقْبِيّ (بالغ الأهمّيّة خاصّةً في إحداث أو تمييز بداية حقبة أو عصر جديد)",
 "epochal": "تَارِيخِيّ, حِقْبِيّ (بالغ الأهمّيّة خاصّةً في إحداث أو تمييز بداية حقبة أو عصر جديد)",
 "eponychium": "سَلِيفَة ظُفْر",
 "eponym": "اسم منسوب لشخص (الاسم المشتق من شخص (حقيقي أو خيالي)) / شخص سُمي به (الشخص الذي سُمي شيء باسمه)\nمثال: متلازمة داون هي اسم منسوب للطبيب الإنجليزي جون داون",
 "eponymic": "إيبونيمي, مسمى على اسم (يكون أو يتعلق بـ أو يحمل اسم الشخص الذي سُمي الشيء باسمه (إيبونيم))",
 "eponymous": "إيبونيمي, مسمى على اسم (يكون أو يتعلق بـ أو يحمل اسم الشخص الذي سُمي الشيء باسمه (إيبونيم))",
 "eponymy": "تسمية باسم علم (اشتقاق اسم عام من اسم شخص مشهور)",
 "epoophoron": "مبيض جانبي",
 "epopee": "مَلْحَمَة",
 "epos": "قصيدة ملحمية, ملحمة (قصيدة سردية طويلة تروي مآثر بطل) / ملحمة (مجموعة من الشعر تنقل تقاليد مجتمع ما عن طريق معالجة موضوع ملحمي ما)",
 "epoxy": "إيبوكسي, راتنج الإيبوكسي (راتنج متصلب بالحرارة؛ يُستخدم بشكل رئيسي في المواد اللاصقة القوية والطلاء والرقائق)",
 "epoxy glue": "إيبوكسي, راتنج الإيبوكسي (راتنج متصلب بالحرارة؛ يُستخدم بشكل رئيسي في المواد اللاصقة القوية والطلاء والرقائق)",
 "epoxy resin": "إيبوكسي, راتنج الإيبوكسي (راتنج متصلب بالحرارة؛ يُستخدم بشكل رئيسي في المواد اللاصقة القوية والطلاء والرقائق)",
 "eprom": "إيبروم, ذاكرة القراءة فقط القابلة للمحى والبرمجة ((في علم الحاسوب) شريحة ذاكرة للقراءة فقط يمكن مسحها بالأشعة فوق البنفسجية وبرمجتها مرة أخرى ببيانات جديدة)",
 "epsilon": "إِبْسِلُون, إِبْسِيلُون",
 "epsilon toxin": "ذيفان إبسيلون",
 "epsom salts": "ملح إبسوم (كبريتات المغنيسيوم المائية تستخدم كملين) / الملح الإنجليزي, ملح إبسوم (كبريتات المغنيسيوم المائية التي تؤخذ عن طريق الفم لعلاج حرقة المعدة والإمساك أو تحقن لمنع النوبات)",
 "epstein island": "جَزِيرَة إِبِسْتِين",
 "epstein-barr virus": "فيروس إبشتاين-بار (فيروس هربس يسبب كثرة الوحيدات العدوائية؛ ويرتبط بسرطانات محددة في أفريقيا والصين)",
 "eptatretus": "إبتاتريتوس",
 "eptesicus fuscus": "خفاش بني كبير (خفاش بني كبير نوعاً ما من أمريكا الشمالية؛ واسع الانتشار)",
 "eptesicus serotinus": "خفاش بني أوروبي, خفاش سيروتين (خفاش بني شائع في أوروبا)",
 "eq": "مكافئ, وزن مكافئ (الوزن الذري لعنصر له نفس سعة الاتحاد لوزن معين من عنصر آخر؛ المعيار هو 8 للأكسجين)",
 "equable": "مُعْتَدِل المِزَاج, هَادِئ الطَّبْع (لا يُستثار بسهولة؛ رَزين وثابت المزاج) / ثَابِت, مُتَسَاوٍ (لَا يَتَفَاوَتُ؛ مُسْتَقِرٌّ وَمُتَجَانِس)",
 "equably": "بِاعْتِدَال, بِانْتِظَام (بطريقة معتدلة)\nمثال: هو شخص مرح بانتظام",
 "equal": "عِدْل (عَدْل) / مُسَاوٍ, الْمُسَاوِي / سَاوَى\nمثال: هل يعاملون بالعدل",
 "equal opportunity": "تكافؤ الفرص (الحق في الحصول على فرص متكافئة للتوظيف بغض النظر عن العرق أو اللون أو الجنس أو الأصل القومي)",
 "equal protection of the laws": "الحماية المتساوية بموجب القانون (حق يكفل المساواة في الحماية القانونية لجميع الأفراد)",
 "equal sign": "علامة اليساوي (علامة تشير إلى أن الكميات على كلا الجانبين متساوية)",
 "equal temperament": "دوزنة متساوية (تقسيم السلم الموسيقي بناءً على أوكتاف مقسم إلى اثني عشر نصف نغمة متساوية تماماً)",
 "equal-area map projection": "إسقاط متساوي المساحات (إسقاط خرائطي تكون فيه الأشكال الرباعية التي تشكلها خطوط الطول ودوائر العرض لها مساحة على الخريطة تتناسب مع مساحتها على الكرة الأرضية)",
 "equal-area projection": "إسقاط متساوي المساحات (إسقاط خرائطي تكون فيه الأشكال الرباعية التي تشكلها خطوط الطول ودوائر العرض لها مساحة على الخريطة تتناسب مع مساحتها على الكرة الأرضية)",
 "equalisation": "تسوية, مساواة (فعل جعل الأشياء متساوية أو موحدة)",
 "equaliser": "ثقل موازن (وزن يوازن وزناً آخر) / إيكولايزر, معادل الصوت (معدات إلكترونية تقلل من تشويه التردد)",
 "equalitarian": "مساواتي (شخص يؤمن بالمساواة بين جميع الناس)",
 "equalitarianism": "مساواتية (مذهب مساواة البشر والرغبة في المساواة السياسية والاقتصادية والاجتماعية)",
 "equality": "مُسَاوَاة / تَسَاوٍ",
 "equality before the law": "المساواة أمام القانون (الحق في الحماية المتساوية للقوانين)",
 "equalization": "تسوية, مساواة (فعل جعل الأشياء متساوية أو موحدة)",
 "equalizer": "هدف التعادل (تسجيل يجعل النتيجة متساوية) / ثقل موازن (وزن يوازن وزناً آخر) / إيكولايزر, معادل الصوت (معدات إلكترونية تقلل من تشويه التردد)",
 "equalizing dividend": "أرباح تسوية (أرباح مدفوعة لتعويض المساهمين عن الخسائر الناتجة عن تغيير في جدول توزيع الأرباح)",
 "equally": "بِالتَّسَاوِي",
 "equanil": "إكوانيل, ميبروبامات (مهدئ ومهدئ للأعصاب (الأسماء التجارية ميلتاون وإكوانيل وميبرين) يستخدم لعلاج توتر العضلات والقلق)",
 "equanimity": "صَبْر, تساوي ((صَبَرَ) يَصْبِرُ صَبْرًا: تجلَّد ولم يَجْزَع؛ (صَبَرَ): انتظر في هدوء واطمئنان)\nمثال: الصبر أم العلوم.",
 "equanimous": "مُتَمَالِكٌ لِنَفْسِه, مُتَّزِن (مسيطر تمامًا على ملكاته وقدراته؛ رابط الجأش)",
 "equatability": "قَابِلِيَّة لِلتَّسْوِيَة, قَابِلِيَّة لِلْمُسَاوَاة (القدرة على أن تكون مساوياً)",
 "equating": "مساواة (فعل اعتبار الأشياء متساوية)",
 "equation": "مُعَادَلَة (المُوَازَنَة؛ في الرِيَاضِيَّات: هي مسألة مُتَوَازِنَة فيها طرفين كل واحد منهما يعادل الآخر فيها مَجْهُول أو أكثر يُرَادُ استخراجه)",
 "equatoguinean franc": "فرنك غينيا الاستوائية (وحدة المال الأساسية في جمهورية غينيا الاستوائية)",
 "equator": "خَطُّ الاِسْتِوَاء (كِتَابَة؛ ما يَصِل نقطتين أو أكثر)\nمثال: إرسم خط مستقيم.",
 "equatorial": "اِسْتِوَائِيّ (الاسْتِوَائِيّ : المنسوب إلى خَطّ الاستواء؛ المناخ لاسْتِوَائِيّ : هو المناخ المتميِّز بالحرارة المرتفعة والأَمطار الغزيرة وانعدام الفصول)\nمثال: لا توجد غابات استوائية في الجزائر.",
 "equatorial current": "تيار استوائي (أي من تيارات المحيط التي تتدفق غرباً عند خط الاستواء)",
 "equatorial guinea": "غِينِيَا اَلاِسْتِوَائِيَّة",
 "equatorial guinean franc": "فرنك غينيا الاستوائية (وحدة المال الأساسية في جمهورية غينيا الاستوائية)",
 "equerry": "مرافق ملكي (مرافق شخصي للعائلة المالكة البريطانية) / المرافق, مسؤول الإسطبل (مسؤول مكلف برعاية خيول الأمراء أو النبلاء)",
 "equestrian": "فروسي (مكون من أو متعلق بـ أو يبرز ركوب الخيل) / فرساني (مكون من أو متعلق بـ أو يتألف من فرسان) / خيال, فارس (شخص ماهر في الفروسية)",
 "equestrian sport": "رياضة الفروسية (رياضة تختبر مهارات الفروسية)",
 "equestrianism": "رُكُوب اَلْخَيْل, فُرُوسِيَّة",
 "equetus lanceolatus": "سمكة المطواة (سمكة طبل سوداء وبيضاء ذات زعنفة ظهرية ممدودة منتصبة)",
 "equetus pulcher": "طبل مخطط (نوع من أسماك الطبل)",
 "equiangular": "مُتَسَاوِي الزَّوَايَا (ذو زوايا متساوية جميعها)",
 "equiangular triangle": "مثلث متساوي الأضلاع (مضلع منتظم ثلاثي الأضلاع)",
 "equid": "خيلي (ثدييات ذات حوافر لها أرجل نحيلة ومعطف مسطح مع عرف ضيق على طول مؤخرة العنق)",
 "equidistant": "مُتَسَاوِي البُعْد (على نفس المسافة عند كلّ نقطة)",
 "equidistribution": "توزيع متساو (توزيع مسطح له ترددات متساوية للحدوث)",
 "equilateral": "مُتَسَاوِي الأَضْلَاع (جميع أضلاعه أو أوجهه متساوية) / متساوي الأضلاع (شكل جميع أضلاعه متساوية)",
 "equilateral triangle": "مثلث متساوي الأضلاع (مضلع منتظم ثلاثي الأضلاع)",
 "equilibration": "موازنة (الاستقرار عن طريق تحقيق التوازن)",
 "equilibrium": "اِتِّزَان, تَوَازُن",
 "equilibrium constant": "ثَابِت التَّوَازُن ((في الكيمياء) نسبة التركيزات عند الوصول إلى التوازن في تفاعل عكسي (عندما يتساوى معدل التفاعل الأمامي مع معدل التفاعل العكسي))",
 "equilibrium law": "قانون التوازن الكيميائي ((كيمياء) المبدأ القائل بأنه (عند التوازن الكيميائي) في تفاعل عكسي، تكون نسبة معدل التفاعل الأمامي إلى معدل التفاعل العكسي ثابتة لذلك التفاعل)",
 "equine": "فَرَسِيّ / خَيْلِيّ",
 "equine distemper": "خناق الخيل (مرض بكتيري حاد يصيب الخيول يتميز بالتهاب الأغشية المخاطية)",
 "equine encephalitis": "التهاب الدماغ الخيلي (التهاب الدماغ الناجم عن فيروس ينتقل عن طريق البعوض من حصان مصاب)",
 "equine encephalomyelitis": "التهاب الدماغ الخيلي (التهاب الدماغ الناجم عن فيروس ينتقل عن طريق البعوض من حصان مصاب)",
 "equinoctial": "اعتدالي (متعلق بالاعتدال (عندما يتساوى طول الليل والنهار)) / استوائي (متعلق بمحيط خط الاستواء) / الدائرة الاعتدالية, خط الاستواء السماوي (الدائرة العظمى على الكرة السماوية في منتصف المسافة بين القطبين السماويين)",
 "equinoctial circle": "الدائرة الاعتدالية, خط الاستواء السماوي (الدائرة العظمى على الكرة السماوية في منتصف المسافة بين القطبين السماويين)",
 "equinoctial line": "الدائرة الاعتدالية, خط الاستواء السماوي (الدائرة العظمى على الكرة السماوية في منتصف المسافة بين القطبين السماويين)",
 "equinoctial point": "اعتدال, نقطة الاعتدال ((في الفلك) إحدى النقطتين السماويتين حيث يتقاطع خط الاستواء السماوي مع مسار الشمس)",
 "equinoctial storm": "عاصفة الاعتدال (عاصفة مطرية عنيفة قرب وقت الاعتدال (الربيعي أو الخريفي))",
 "equinoctial year": "سنة شمسية, سنة فلكية (الوقت اللازم للأرض لعمل دورة واحدة حول الشمس، مقاسة بين اعتدالين ربيعيين)",
 "equinox": "اِعْتِدَال (الوَسَطِيَّة، يقابله التَطَرُّف؛ التَنَاسُب وأن يكون الأمر عَدْلا، يقابله الاِنْقِلاب)\nمثال: الاعتدال هو اليوم الذي يتساوى به الليل و النهار بنفس المدة.",
 "equipage": "عربة خيول (مركبة بعجلات يجرها حصان واحد أو أكثر) / عتاد, معدات عسكرية (معدات ولوازم قوة عسكرية)",
 "equipment": "مُعَدَّات, تَجْهِيزَات",
 "equipment casualty": "خسارة معدات, ضرر (فقدان المعدات العسكرية)",
 "equipment failure": "تعطل, توقف (توقف عن التشغيل الطبيعي)\nمثال: حدث انقطاع في الطاقة",
 "equipoise": "تعادل, توازن (التساوي في توزيع الأجزاء)",
 "equipoised": "مُتَوَازِنُ اليَدَيْن (لا يُهيمِن فيه جانب واحد؛ ليس أيمن ولا أعسر)",
 "equipotent": "مُتَسَاوِي الفَعَالِيَّة (ذو قوة أو فعالية متساوية)",
 "equipped": "مُجَهَّز بِالسِّلَاح (يحمل أسلحة ومُعَدّات قتاليّة) / مُجهَّز, مُزوَّد (مزود أو مجهز بما هو ضروري أو مفيد أو مناسب) / مؤثث, مفروش (مزود بما هو ضروري لغرض ما (مثل الأثاث أو المعدات أو السلطة)) / مُجَهَّز, مُعَدّ بِالْعَتَاد (مُجَهَّز بالمعدات المناسبة)\nمثال: ملعب مجهز جيداً",
 "equipping": "تجهيز, تسليح (فعل التجهيز بالأسلحة استعداداً للحرب)",
 "equiprobable": "مُتَسَاوِي الاِحْتِمَال (لَهُ نَفْس دَرَجَة الاِحْتِمال مَعَ غَيْرِه)",
 "equipt": "مُجهَّز, مُزوَّد (مزود أو مجهز بما هو ضروري أو مفيد أو مناسب)\nمثال: ملعب مجهز جيداً",
 "equisetum arvense": "ذيل الحصان الحقلي, ذيل الحصان الشائع (من أوراسيا وجرينلاند وأمريكا الشمالية)",
 "equisetum fluviatile": "ذيل الحصان المائي, ذيل الحصان المستنقعي (أوراسيا؛ شمال أمريكا الشمالية إلى فرجينيا)",
 "equisetum hyemale": "ذيل الحصان الخشن, كنباث شتوي (ذيل حصان منتصب دائم الخضرة بسيقان خشنة الحواف؛ كان يستخدم سابقاً لتنظيف الأواني)",
 "equisetum hyemale robustum": "ذيل الحصان الخشن, كنباث شتوي (ذيل حصان منتصب دائم الخضرة بسيقان خشنة الحواف؛ كان يستخدم سابقاً لتنظيف الأواني)",
 "equisetum palustre": "ذيل الحصان السبخي, كنباث سبخي (ذيل حصان واسع الانتشار في المناطق الرطبة أو المستنقعية في نصف الكرة الشمالي)",
 "equisetum robustum": "ذيل الحصان الخشن, كنباث شتوي (ذيل حصان منتصب دائم الخضرة بسيقان خشنة الحواف؛ كان يستخدم سابقاً لتنظيف الأواني)",
 "equisetum sylvaticum": "ذيل الحصان الحرجي, كنباث حرجي (أوراسيا باستثناء جنوب روسيا؛ شمال أمريكا الشمالية)",
 "equisetum variegatum": "ذيل الحصان المبرقش, كنباث مبرقش (شمال أمريكا الشمالية، جرينلاند، شمال ووسط أوروبا)",
 "equitable": "حَقَّانِيّ, عَدْل",
 "equitably": "بِإِنْصَاف, بِعَدْل (بطريقة منصفة)\nمثال: تم تقسيم الميراث بإنصاف بين الأخوات",
 "equitation": "ركوب الخيل, فروسية (رياضة الجلوس على ظهر الحصان مع التحكم في تحركاته)",
 "equity": "إنصاف, عدالة (المطابقة للقواعد أو المعايير) / حقوق الملكية, رأس المال السهمي (حصة ملكية المساهمين في شركة) / حقوق الملكية الصافية (الفرق بين القيمة السوقية للعقار والمطالبات المحتفظ بها ضده)\nمثال: اعترف القاضي بعدالة مطالبتي",
 "equity credit line": "قرض بضمان المسكن, قرض منزلي (قرض بضمان قيمة حقوق الملكية في منزل المقترض)",
 "equivalence": "قَابِلِيَّة لِلْمُقَارَنَة, مُضَاهَاة (السمات التي يمكن مقارنتها) / تَعَادُل, تَكَافُؤ (مساواة جوهرية وقابلية للتبادل) / تكافؤ, مساواة (حالة من التساوي أو التكافؤ الجوهري؛ التوازن المتساوي)\nمثال: لا توجد مقارنة بين الكتابين",
 "equivalent": "مُعَادِل",
 "equivalent weight": "مكافئ, وزن مكافئ (الوزن الذري لعنصر له نفس سعة الاتحاد لوزن معين من عنصر آخر؛ المعيار هو 8 للأكسجين)",
 "equivalent word": "مرادف (يقال عن كلمتين يمكن تبادلهما في سياق ما أنهما مترادفتان بالنسبة لذلك السياق)",
 "equivalent-binary-digit factor": "عَامِل الأَرْقَام الثُّنَائِيَّة المُكَافِئَة (متوسط عدد الأرقام الثنائية اللازمة للتعبير عن رقم أساس واحد في نظام عد غير ثنائي)",
 "equivocal": "غَامِض, مُلْتَبِس (غَيْرُ يَقِينِيٍّ كَعَلَامَةٍ أَوْ دَلَالَةٍ) / حمال أوجه, غامض (مفتوح لأكثر من تفسير؛ أو ذو طبيعة أو مغزى غير مؤكد؛ أو (غالباً) يهدف إلى التضليل) / غَامِض, مُلْتَبِس (قابل للتساؤل ومفتوح للتأويل)\nمثال: بيان ملتبس",
 "equivocally": "بشكل ملتبس, بغموض (بطريقة غامضة)\nمثال: هذه الرسالة مصاغة بغموض",
 "equivocalness": "احْتِمَالِيَّة المَعَانِي, الْتِبَاس (عدم الوضوح بحكم وجود أكثر من معنى واحد)",
 "equivocation": "مراوغة, مواربة (التزييف عن طريق لغة غامضة أو ملتبسة) / غموض متعمد, مراوغة (الغموض أو الإبهام المتعمد في الكلام) / تهرب, مراوغة (بيان ليس كاذباً حرفياً ولكنه يتجنب بذكاء حقيقة غير سارة)",
 "equivocator": "مراوغ, موارب (مجيب يتجنب إعطاء إجابة مباشرة واضحة)",
 "equus africanus": "حمار بري أفريقي (حمار بري يعيش في أفريقيا)",
 "equus asinus": "حمار, حمار أهلي (حيوان حمل أهلي ينحدر من الحمار البري الأفريقي؛ صبور ولكنه عنيد)",
 "equus burchelli": "حمار الزرد الشائع (يعيش في سهول وسط وشرق أفريقيا)",
 "equus caballus": "حصان, خيل (حيوان عشبي ذو حوافر صلبة رباعي الأرجل تم استئناسه منذ عصور ما قبل التاريخ)",
 "equus caballus gomelini": "تاربان (حصان بري أوروبي انقرض منذ أوائل القرن العشرين)",
 "equus caballus przevalskii": "حصان برزوالسكي (حصان بري في وسط آسيا يشبه الحمار؛ مهدد بالانقراض الآن)",
 "equus caballus przewalskii": "حصان برزوالسكي (حصان بري في وسط آسيا يشبه الحمار؛ مهدد بالانقراض الآن)",
 "equus grevyi": "حمار زرد غريفي (حمار زرد بخطوط أقل استمراراً)",
 "equus hemionus": "أخدر (حمار بري آسيوي)",
 "equus hemionus hemionus": "حمار منغوليا البري, دزيجيتاي (حمار بري منغولي)",
 "equus kiang": "كيانج (حمار بري يعيش في التبت ومنغوليا)",
 "equus quagga": "كواجا (ثديي من جنوب أفريقيا كان يشبه الحمار الوحشي؛ انقرض منذ أواخر القرن التاسع عشر)",
 "equus zebra zebra": "حمار الزرد الجبلي (حمار زرد ضيق الخطوط شبه منقرض يعيش في جنوب أفريقيا)",
 "er": "غرفة الطوارئ (غرفة في مستشفى أو عيادة مزودة بطاقم ومعدات لتوفير رعاية طارئة للأشخاص الذين يحتاجون إلى علاج طبي فوري) / إيربيوم (عنصر فلزي ثلاثي التكافؤ من مجموعة الأتربة النادرة)",
 "era": "حِقْبَة (مدة من الزمان تُقَدَّرُ بطولٍ غير محدد، وقد تكون قصيرة أو طويلة بحسب السياق؛ فترة تاريخية مميزة بسمات أو أحداث معينة)\nمثال: لقد بدأت حقبة جديدة في الجزائر.",
 "eradicable": "قابل للإبادة, قابل للاستئصال (يمكن استئصاله أو اجتثاثه)",
 "eradication": "استئصال, طمس (التدمير الكامل لكل أثر لشيء ما)",
 "eradicator": "مُبيد, مُفْنٍ (شخص يقوم بالإبادة (وخاصة من مهنته إبادة القوارض والحشرات المزعجة))",
 "eragrostic abyssinica": "تيف, عشبة التيف (عشبة أفريقية مهمة اقتصادياً كعشبة حبوب (تنتج دقيقاً أبيض عالي الجودة) وكذلك للعلف والتبن)",
 "eragrostis curvula": "عشبة الحب الأفريقية, عشبة الحب الباكية (عشبة جنوب أفريقية معمرة ذات سيقان واهية متكتلة بكثافة؛ أدخلت إلى الولايات المتحدة خاصة لمكافحة التعرية)",
 "eragrostis tef": "تيف, عشبة التيف (عشبة أفريقية مهمة اقتصادياً كعشبة حبوب (تنتج دقيقاً أبيض عالي الجودة) وكذلك للعلف والتبن)",
 "eranthis hyemalis": "أكونيت شتوي, خانق الذئب الشتوي (عشب معمر صغير من العالم القديم يزرع لزهوره الصفراء الزاهية التي تظهر في أوائل الربيع وغالباً قبل ذوبان الثلج)",
 "erasable": "قَابِلٌ لِلْإِزَالَة, قَابِلٌ لِلْمَسْح (يمكن طمسه أو إزالته)",
 "erasable programmable read-only memory": "إيبروم, ذاكرة القراءة فقط القابلة للمحى والبرمجة ((في علم الحاسوب) شريحة ذاكرة للقراءة فقط يمكن مسحها بالأشعة فوق البنفسجية وبرمجتها مرة أخرى ببيانات جديدة)",
 "erase": "مَحَا, مَحَى / اِمَّحَى, اِنْمَحَى",
 "eraser": "مِمْحَاة",
 "erasmian": "إيرازمي (من أو يتعلق بإيراسموس أو على طريقته)",
 "erastianism": "إيراستية (المذهب القائل بأن الدولة لها السيادة على الكنيسة في الأمور الكنسية)",
 "erasure": "شطب, محو (الحذف عن طريق الشطب أو المسح) / كشط, محو (منطقة سطح تم محو شيء منها) / شطب, محو (تصحيح يتم عن طريق المسح)\nمثال: تمت كتابة كلمة أخرى فوق المحو",
 "erb's palsy": "شلل إيرب (شلل الذراع الناتج عن إصابة الضفيرة العضدية (عادة أثناء الولادة))",
 "erb-duchenne paralysis": "شلل إيرب (شلل الذراع الناتج عن إصابة الضفيرة العضدية (عادة أثناء الولادة))",
 "erbium": "إِرْبِيُوم",
 "erdoğan": "أَرْدُوغَان",
 "ere": "قَبْل, أْبْكَر (وضع فمه على الشخص أو الشيء علامة الحب والاحترام. في العاميّة يُقال بَاسَ)\nمثال: كنت هنا من قبل.",
 "erebus": "إِرِيْبْس",
 "erechtites hieracifolia": "إريكتيتس, عشب النار (نبات عشبي أمريكي ضار ذو أزهار بيضاء أو مخضرة صغيرة)",
 "erect": "مُنْتَصِب, مُنْتَفِخ (مُتَصَلِّب ومُنْتَفِخ؛ في حالَة انْتِصاب) / قائم, منتصب (في وضع مستقيم أو وضعية قائمة)\nمثال: قامة منتصبة",
 "erect bugle": "عجوقة زرقاء, عجوقة منتصبة (نبات معمر جذموري منتصب بزهور زرقاء زاهية؛ جنوب أوروبا)",
 "erectile": "كَهْفِيّ, نَاعِظ (مملوء بجيوب وعائية وقابل للانتصاب عند امتلائه بالدم) / قَابِل لِلانْتِصَاب (قادر على أن يُرفَع إلى وضع منتصب)",
 "erectile dysfunction": "خلل الانتصاب, ضعف الانتصاب (عجز ناتج عن عدم قدرة الرجل على الحصول على انتصاب للقضيب أو الحفاظ عليه)",
 "erectile organ": "عضو انتصابي (عضو يحتوي على نسيج انتصابي)",
 "erectile tissue": "نسيج انتصابي (نسيج وعائي قادر على الامتلاء بالدم والتصلب)",
 "erecting": "إقامة, انتصاب (فعل البناء أو الرفع لأعلى)",
 "erecting prism": "منشور مقوّم, منشور ناصب (منشور بصري قائم الزاوية يستخدم لقلب الصورة المقلوبة لتصبح معتدلة)",
 "erection": "نُعُوظ, اِنْتِصَاب",
 "erection ring": "حلقة القضيب (حلقة يمكن وضعها حول القضيب، عادة عند القاعدة، لإبطاء تدفق الدم)",
 "erectly": "بقامة منتصبة, منتصباً (بأسلوب تكون فيه القامة منتصبة ومستقيمة الظهر)\nمثال: لا يزال الرجل العجوز يمشي منتصباً",
 "erectness": "تَعَامُد, رَأْسِيَّة (الوضع بزاوية قائمة مع الأفق) / استقامة, انتصاب (خاصية كون الجسم منتصباً في الوضعية)",
 "eremite": "ناسك (مسيحي معتزل)",
 "eremitic": "زُهْدِيّ, نَاسِكِيّ (يَتَّسِمُ بِالعُزْلَةِ الزُّهْدِيَّةِ وَالتَّنَسُّكِ) / توحدي, نسكي (من أو متعلق بـ أو يليق بالنساك أو ممارساتهم في العيش المنعزل)\nمثال: تقشفات نسكية",
 "eremitical": "زُهْدِيّ, نَاسِكِيّ (يَتَّسِمُ بِالعُزْلَةِ الزُّهْدِيَّةِ وَالتَّنَسُّكِ) / توحدي, نسكي (من أو متعلق بـ أو يليق بالنساك أو ممارساتهم في العيش المنعزل)\nمثال: تقشفات نسكية",
 "eremitism": "اعتزال, نسك (رهبانية تتميز بالعزلة حيث يتم التضحية بالبعد الاجتماعي للحياة من أجل أولوية التجربة الدينية)",
 "erethism": "إرثية, تهيجية (درجة عالية غير طبيعية من التهيج أو الحساسية لتحفيز عضو أو جزء من الجسم)",
 "erethizon dorsatum": "شيهم كندي (شيهم من شمال شرق أمريكا الشمالية ذو أشواك شائكة مخفية في الفرو الخشن؛ غالباً ما يقضم المباني للحصول على الملح والشحوم)",
 "eretmochelys imbricata": "سلحفاة صقرية المنقار (سلحفاة بحرية استوائية عدوانية ذات منقار يشبه الصقر؛ مصدر للغذاء وأفضل أنواع صدف السلاحف)",
 "erg": "إرج",
 "ergative language": "لغة أرغاتيفية, لغة فاعلية-مفعولية (نوع من اللغات يحتوي على حالة أرغاتيفية أو يكون فيها المفعول به للفعل المتعدي له نفس شكل فاعل الفعل اللازم)",
 "ergative-absolutive language": "لغة أرغاتيفية, لغة فاعلية-مفعولية (نوع من اللغات يحتوي على حالة أرغاتيفية أو يكون فيها المفعول به للفعل المتعدي له نفس شكل فاعل الفعل اللازم)",
 "ergo": "إذن, وبالتالي ((تستخدم كرابط للجمل) لذلك أو وبالتالي)",
 "ergocalciferol": "فيتامين د, كالسيفيرول (فيتامين قابل للذوبان في الدهون يمنع الكساح)",
 "ergodic": "إِرْغُودِيّ (حالة عودة إيجابية لا دورية في الأنظمة العشوائية)",
 "ergodicity": "إِرْجُودِيَّة (سمة للأنظمة العشوائية؛ عموماً، النظام الذي يميل في الاحتمالية إلى شكل محدود مستقل عن الظروف الأولية)",
 "ergometer": "دينامومتر, مقياس القوة (أداة قياس مصممة لقياس القدرة أو القوة)",
 "ergonomic": "أرغونومي, هندسي بشري (مكون من أو متعلق ببيئة العمل (الأرغونوميا) وملائمتها للبشر)",
 "ergonomics": "الأرغونوميا, تكنولوجيا حيوية (فرع العلوم الهندسية الذي تُستخدم فيه العلوم البيولوجية لدراسة العلاقة بين العمال وبيئاتهم)",
 "ergonovine": "إرغونوفين (قلويد مشتق من الإرغوت أقل سمية من الإرغوت؛ يحفز تقلص عضلات الرحم ويعطى بعد الولادة أو الإجهاض)",
 "ergosterol": "إرغوستيرول (ستيرول نباتي يتحول إلى فيتامين د بواسطة الأشعة فوق البنفسجية)",
 "ergot": "إرغوت, دابرة (فطر يصيب نباتات الحبوب المختلفة مكوناً كتلاً سوداء مدمجة من خيوط متفرعة تحل محل العديد من حبوب النبات؛ مصدر لقلويدات مهمة طبياً ولحمض الليسرجيك) / إرغوت (مرض نباتي يسببه فطر الإرغوت)",
 "ergotamine": "إرغوتامين (قلويد مشتق من الإرغوت أقل سمية من الإرغوت؛ يسبب انقباض الأوعية الدموية ويستخدم لعلاج الصداع النصفي)",
 "ergotic": "إرغوتي (متعلق بـ أو ناتج عن فطر الإرغوت)",
 "ergotine": "إرغوتين (قلويد قابض قوي يستخرج من الإرغوت كمادة بنية غير متبلورة ومرة، يستخدم لإحداث انقباض الرحم)",
 "ergotism": "تسمم أرجوني, تسمم الداروب (تسمم عن طريق تناول منتجات الحبوب المصابة بفطر الأرجوت؛ يتميز بالعطش والإسهال والغثيان والتشنج والقيء وعدم انتظام ضربات القلب؛ في الحالات الشديدة يمكن…)",
 "ergotrate maleate": "إرغونوفين (قلويد مشتق من الإرغوت أقل سمية من الإرغوت؛ يحفز تقلص عضلات الرحم ويعطى بعد الولادة أو الإجهاض)",
 "ergotropic": "إرغوتروبي, محفز للطاقة (مكون من أو متعلق بالإرغوتروبية (توجيه الطاقة))",
 "ergotropism": "انتحاء للعمل (ميل للعمل)",
 "erianthus ravennae": "عشبة الصوف, عشبة رافينا (عشبة تزرع غالباً لأوراقها الطويلة المضلعة بالأبيض وأعمدتها الكبيرة التي تشبه تلك الموجودة في عشبة البامباس)",
 "eric": "إِرِيك",
 "erica": "خلنج (أي نبات من جنس إريكا)",
 "erica arborea": "خلنج, خلنج شجري (شجيرة متوسطية دائمة الخضرة تشبه الشجرة ذات زهور بيضاء عطرة في عناقيد طرفية كبيرة وجذور خشبية صلبة تستخدم لصنع غليون التبغ)",
 "erica carnea": "خلنج ربيعي, خلنج شتوي (شجيرة أوروبية قزمة بزهور حمراء على شكل جرس تزهر مبكراً جداً)",
 "erica cinerea": "خلنج جرسي, خلنج ناعم الأوراق (شجيرة أوروبية منخفضة شائعة بزهور أرجوانية حمراء)",
 "erica lusitanica": "خلنج إسباني, خلنج برتغالي (شجيرة كثيفة منتصبة موطنها غرب شبه الجزيرة الأيبيرية ذات زهور بيضاء أو وردية غزيرة؛ متوطنة في جنوب غرب إنجلترا)",
 "erica perspicua": "خلنج أمير ويلز (شجيرة جنوب أفريقية تزرع لوفرة زهورها البيضاء)",
 "erica tetralix": "خلنج متصالب الأوراق (شجيرة أوروبية قزمة بزهور وردية اللون)",
 "erica vagans": "خلنج كورني (شجيرة كثيفة ذات زهور وردية إلى بيضاء؛ شائعة في مستنقعات كورنوال وجنوب غرب أوروبا؛ تزرع في أماكن أخرى)",
 "erie": "إيري (فرد من شعب إيروكواس كان يعيش سابقاً على الشاطئ الجنوبي لبحيرة إيري في شمال أوهايو وشمال غرب بنسلفانيا وغرب نيويورك)",
 "erigeron acer": "شيخ الربيع الأزرق, يرغوث أزرق (عشبة ضارة واسعة الانتشار ذات أزهار زرقاء أرجوانية شاحبة)",
 "erigeron annuus": "شيخ الربيع الحولي, يرغوث حولي (عشبة من أمريكا الشمالية ذات أزهار بيضاء متوطنة على نطاق واسع)",
 "erigeron aurantiacus": "أقحوان برتقالي, يرغوث برتقالي (عشبة تشكل حصيرة من تركستان ذات أزهار برتقالية صفراء مزدوجة تقريباً)",
 "erigeron canadensis": "أريغارون كندي, ذيل الحصان (عشب ضار شائع في أمريكا الشمالية بأوراق خطية ورؤوس قرصية صغيرة من الزهور الصفراء؛ مستوطن على نطاق واسع في جميع المناطق المعتدلة؛ يوضع أحياناً في جنس…)",
 "erigeron divergens": "يرغوث مفترش (نبات جيد التفرع ذو أوراق وسيقان مشعرة كل منها برأس زهرة منفرد بأشعة ضيقة بيضاء أو وردية أو لافندر؛ غرب أمريكا الشمالية)",
 "erigeron glaucus": "أقحوان شاطئي, نجمة الشاطئ (نبات معمر عصاري قليلاً بأوراق قاعدية وسيقان لزجة مشعرة كل منها يحمل رأس زهرة منفرداً بأشعة ضيقة وردية أو لافندر؛ المنحدرات الساحلية من أوريغون إلى…)",
 "erigeron philadelphicus": "يرغوث فيلادلفيا (نبات جميل بشكل خاص له هامش دقيق من الأشعة الخيطية حول رؤوس الزهور ذات الأشعة البيضاء أو الوردية النحيلة جداً؛ الولايات المتحدة وكندا)",
 "erigeron pulchellus": "لسان الحمل روبن, يرغوث جميل (نبات معمر شائع في شرق أمريكا الشمالية له أزهار ذات أشعة بنفسجية أرجوانية عادة)",
 "erigeron speciosus": "أقحوان مبهرج, يرغوث مبهرج (نبات له سيقان مورقة متفرعة كل فرع برأس زهرة منفرد مبهرج بشكل خاص مع العديد من الأشعة الضيقة الوردية أو اللافندر أو البيضاء؛ جبال شمال غرب الولايات…)",
 "erignathus barbatus": "فقمة ملتحية (فقمة متوسطة الحجم رمادية إلى صفراء ذات شعيرات على جانبي الخطم؛ تعيش في المحيط المتجمد الشمالي)",
 "erigonum fasciculatum": "حنطة سوداء برية, حنطة سوداء كاليفورنيا (شجيرة منخفضة النمو ذات فروع منتشرة وزهور في رؤوس فضفاضة؛ المناطق الصحراوية في غرب الولايات المتحدة (كاليفورنيا إلى يوتا))",
 "erinaceus europaeus": "قنفذ (ثديي ليلي صغير من العالم القديم مغطى بالشعر والأشواك الواقية)",
 "erinaceus europeaeus": "قنفذ (ثديي ليلي صغير من العالم القديم مغطى بالشعر والأشواك الواقية)",
 "eringo": "قرصعنة",
 "erinyes": "إرينييس, فوريات ((الأساطير الكلاسيكية) الوحوش البشعة ذات شعر الثعابين (عادة ثلاث) اللواتي يلاحقن المجرمين غير المعاقبين)",
 "eriobotrya japonica": "أسكدنيا, أكي دنيا (شجرة دائمة الخضرة في المناطق الدافئة لها فاكهة صفراء زغبية بحجم الزيتون مع نواة كبيرة حرة؛ موطنها الصين واليابان)",
 "eriocaulon aquaticum": "عشبة الغليون (نبات مائي معمر في أمريكا الشمالية وأيرلندا وجزر هبريدس له أوراق خضراء شفافة في لولب قاعدي وعناقيد كثيفة تشبه الأزرار من الزهور البيضاء الدقيقة)",
 "eriodictyon californicum": "إريوديكتيون, يربا سانتا (شجيرة دائمة الخضرة لزجة من غرب الولايات المتحدة بزهور بيضاء إلى ليلكية داكنة؛ تستخدم الأوراق العطرية اللزجة في علاج أمراض الشعب الهوائية والرئة)",
 "eriogonum": "إريوغونوم, الحنطة السوداء البرية (أي نبات من جنس إريوغونوم بزهور عنقودية صغيرة)",
 "eriogonum allenii": "نبات المظلة (نبات معمر متأخر الإزهار ينمو في الأراضي الصخرية بفرجينيا وله زهور في عناقيد مسطحة القمة)",
 "eriometer": "إريوميتر, مقياس الألياف (أداة لقياس أقطار الجسيمات الدقيقة أو الألياف، من حجم الحلقات الملونة الناتجة عن حيود الضوء الذي تُشاهد فيه الأجسام)",
 "eriophorum angustifolium": "عشبة القطن الشائعة (ذات قنابات قطنية بيضاء أو تشبه الزغب معنقدة بكثافة)",
 "eriophyllum lanatum": "قيصوم ذهبي (نبات معمر ورقي صوفي رمادي بسيقان متفرعة تنتهي بسيقان عديمة الأوراق تحمل رؤوس زهور صفراء ذهبية؛ المناطق الجافة غرب أمريكا الشمالية)",
 "eriophyllum wallacei": "أقحوان صوفي, إريوفيلوم والاسي (نبات حولي صغير رمادي صوفي معنقد ذو رؤوس زهرية صفراء ذهبية صغيرة؛ جنوب شرق كاليفورنيا إلى شمال غرب أريزونا وجنوب غرب يوتا؛ يوضع أحياناً في جنس…)",
 "eriosoma lanigerum": "من التفاح الصوفي (يتغذى بشكل رئيسي على اللحاء في الأجزاء الهوائية وجذور التفاح وأشجار أخرى)",
 "eris": "إِرِيس",
 "eristic": "سَفْسَطَائِيّ, مُجَادِلٌ عَبَثًا (مَيَّالٌ إِلَى الجَدَلِ لِذَاتِهِ وَغَالِبًا بِحُجَجٍ وَاهِيَة) / فن الجدل (فن المناظرة المنطقية (خاصة إذا كانت خادعة)) / مُجادِل, مُخاصِم (شخص يجادل؛ شخص يجيد أو يستمتع بالجدل)",
 "eristical": "سَفْسَطَائِيّ, مُجَادِلٌ عَبَثًا (مَيَّالٌ إِلَى الجَدَلِ لِذَاتِهِ وَغَالِبًا بِحُجَجٍ وَاهِيَة)",
 "erithacus rubecola": "أبو الحناء (طائر مغرد صغير من العالم القديم ذو صدر محمر)",
 "erithacus rubecula": "أبو الحناء (طائر مغرد صغير من العالم القديم ذو صدر محمر)",
 "erithacus svecicus": "هزار أزرق الزور (طائر مغرد من شمال أوروبا وآسيا)",
 "eritrea": "إِرِتْرِيَا",
 "eritrean": "إِرِيتْرِيّ",
 "erlang": "إرلانج (وحدة لشدة الحركة في نظام الهاتف)",
 "erlenmeyer flask": "دورق مخروطي, قارورة إرلينماير (قارورة مخروطية ذات قاعدة عريضة وعنق ضيق)",
 "ermine": "قَاقِم",
 "ern": "عقاب البحر أبيض الذيل (عقاب ضخم بني رمادي بذيل أبيض قصير وتدي الشكل؛ من أوروبا وجرينلاند)",
 "erne": "عقاب البحر أبيض الذيل (عقاب ضخم بني رمادي بذيل أبيض قصير وتدي الشكل؛ من أوروبا وجرينلاند)",
 "eroded": "مَنْحُوت, مُتَآكِل (مُتَآكِلٌ بِفِعْلِ المَاءِ أَوِ الجَلِيدِ أَوِ الرِّيَاحِ)",
 "eroding": "تعرية, نحت ((في الجيولوجيا) العملية الميكانيكية لتآكل أو طحن شيء ما (كما يحدث عند غسل الجسيمات له)، وتستخدم مجازياً أيضاً)",
 "erodium cicutarium": "رقمة شوكرانية, منقار اللقلق أحمر الساق (عشب ضار أوروبي توطن في جنوب غرب الولايات المتحدة والمكسيك له سيقان منبطحة محمرة بأوراق صغيرة تشبه السرخس وزهور صغيرة خزامية حمراء عميقة تليها ثمار…)",
 "erodium moschatum": "رقمة مسكية, نفل المسك (عشب أوروبي حولي منخفض توطن في أمريكا؛ يشبه الرقمة الشوكرانية)",
 "erodium texanum": "إروديوم تكساس, غرنوقي تكساس (نبات ينمو في البراري والمناطق الصحراوية في جنوب غرب الولايات المتحدة والمكسيك)",
 "erogenous": "شَهْوَانِيّ, مُثِير جِنْسِيًّا (حسّاس للإثارة الجنسية)",
 "erogenous zone": "مِنْطَقَة اَلشَّهْوَة اَلْجِنْسِيَّة (المِنْطَقةُ: المَنْطِقَةُ؛ مِنْطَقَةُ: مُقَاطَعَةٌ)\nمثال: غزة منطقة مكشوفة.",
 "erolia alpina": "دريجة ألبية (طيطوي شائع صغير يتكاثر في المناطق الشمالية أو القطبية ويشتي في جنوب الولايات المتحدة أو مناطق البحر الأبيض المتوسط)",
 "erolia minutilla": "دريجة صغيرة, فطيرة (أصغر طيطوي أمريكي)",
 "eros": "إِيرُوس",
 "erose": "مُتَآكِل, مُحَزَّز (ذو حافة محزّزة أو مسنّنة بشكل غير منتظم كأنّها مقضومة)",
 "erose leaf": "ورقة متآكلة الحافة (ورقة ذات حافة غير منتظمة وكأنها مقضومة)",
 "erosion": "تآكل, حت (تآكل بفعل العمليات الكيميائية) / تعرية, نحت ((في الجيولوجيا) العملية الميكانيكية لتآكل أو طحن شيء ما (كما يحدث عند غسل الجسيمات له)، وتستخدم مجازياً أيضاً) / تآكل, تراجع (انخفاض تدريجي لشيء ما) / تآكل, تعرية (حالة يتآكل فيها سطح الأرض بفعل الماء والرياح)\nمثال: بعد فضيحة المحاسبة كان هناك تآكل في الثقة في المدققين",
 "erosive": "أَكَّال, كَاوٍ ((عَنْ مَادَّةٍ، خَاصَّةً حَمْضٍ قَوِيٍّ) قَادِرٌ عَلَى إِتْلَافِ المَوَادِّ أَوْ تَآكُلِهَا) / تَآكُلِيّ, حَاتّ (يُزِيلُ المَوَادَّ بِالِاحْتِكَاكِ التَّدْرِيجِيِّ)",
 "erosiveness": "تَآكُلِيَّة, حَتّ (حالة أو صفة التسبب في التآكل أو الحت)",
 "erotic": "شَبَقِيّ, جِنْسِيّ",
 "erotic love": "حب جنسي, عشق (شعور عميق بالرغبة الجنسية والانجذاب)\nمثال: حبهم جعلهم غير مبالين بما حولهم",
 "erotica": "شَبَقِيَّة",
 "erotically": "إيروتيكياً, بشهوانية (بطريقة مثيرة جنسياً)",
 "eroticism": "إثارة جنسية, شبق (إثارة مشاعر الرغبة الجنسية) / إثارة جنسية, شبق (حالة من توقع النشاط الجنسي)",
 "erotism": "إثارة جنسية, شبق (إثارة مشاعر الرغبة الجنسية) / إثارة جنسية, شبق (حالة من توقع النشاط الجنسي)",
 "err": "غَلِطَ, أَخْطَأَ",
 "err on the side of caution": "تتوخى الحيطة والحذر, تأخذ بأسباب الحيطة والحذر",
 "errancy": "زيغ, ضلال (قابلية الخطأ كما يتضح من الخطأ أو الميل للخطأ) / ضَلَال ((المسيحية) اعتناق آراء تختلف مع العقيدة المقبولة؛ وخاصة الاختلاف مع عصمة البابا)",
 "errand": "قضاء حاجة, مشوار (رحلة قصيرة تُتخذ لأداء مهمة ضرورية)",
 "errand boy": "ساعي, فتى المراسلات (صبي يكسب المال عن طريق توصيل الرسائل وقضاء المهمات)",
 "errant": "تَائِه, شَارِد (ذُو حَرَكَةٍ غَيْرِ مُنْضَبِطَةٍ وَغَيْرِ مُتَوَقَّعَة) / شَارِد, ضَالّ (يَنْحَرِف عَنِ المَسَار الصَّحِيح أَوِ المَعَايِير المَقْبُولَة)",
 "erratic": "مُتَقَلِّب, نَزَوِيّ (عرضة لتغيّرات مفاجئة وغير متوقّعة) / غَيْرُ مُنْتَظِم, مُتَقَلِّب (مِنَ المُرَجَّحِ أَنْ يَعْمَلَ بِشَكْلٍ غَيْرِ مُتَوَقَّع) / بِلَا مَسَار ثَابِت, شَارِد (ليس له مسار محدّد أو ثابت)",
 "erratically": "بشكل غير منتظم, بشكل متقطع (بطريقة غير منتظمة ولا يمكن التنبؤ بها)\nمثال: التغيرات الاقتصادية تسير بشكل متقطع",
 "erratum": "خطأ مطبعي, هفوة مطبعية (خطأ في المادة المطبوعة ناتج عن أعطال ميكانيكية من نوع ما)",
 "errhine": "مُسَبِّب لِلإِفْرَاز الأَنْفِيّ (يتسبّب في إفراز أنفيّ)",
 "erring": "مُعَرَّض لِلخَطَأ (قَابِل لِارْتِكَاب الأَخْطَاء)",
 "erroneous": "خَاطِئ, مَغْلُوط (يَحْتَوِي عَلَى أَخْطَاءٍ أَوْ يَتَّسِمُ بِهَا)",
 "erroneous belief": "خطأ, معتقد خاطئ (مفهوم خاطئ ناتج عن معلومات غير صحيحة)",
 "erroneously": "خطأً, عن طريق الخطأ (بطريقة خاطئة)\nمثال: صدق ذلك عن طريق الخطأ",
 "erroneousness": "خَطَأ, زَلَل (عدم صحة غير مقصود)",
 "error": "خَطَأ (تعني ضدّ الصواب. يشمل ذلك الفعل، القول، والرأي. يُستخدم الفعل \"أخطأ\" للدلالة على عدم الإصابة…؛ قام بعمل بعيد عن الصواب أو مخالف للحق سواء كان ذلك في السلوك أو القول أو الكتابة) / غَلْطَة / غَلَط\nمثال: كان خطأ حاسوبي.",
 "error correction code": "رمز تصحيح الخطأ ((الأتصالات) نظام تشفير يدمج بتات تماثل إضافية من أجل اكتشاف الأخطاء)",
 "error message": "رِسَالَة خَطٰأ",
 "error-prone": "مُعَرَّض لِلخَطَأ (قَابِل لِارْتِكَاب الأَخْطَاء)",
 "errorless": "خَالٍ مِنَ الأَخْطَاء (بِلَا أَيِّ خَطَأ)",
 "ersatz": "بَدِيل, رَدِيء (اصطناعي ورديء الجودة؛ بديل أقل قيمة) / بديل رديء, زائف (بديل أو تقليد مصطنع أو رديء)",
 "erse": "الجودية, الغيلية (أي من عدة لغات ذات صلة بالكلت في أيرلندا واسكتلندا)",
 "erse language": "الجودية, الغيلية (أي من عدة لغات ذات صلة بالكلت في أيرلندا واسكتلندا)",
 "erst": "ذات مرة, سابقاً (في وقت سابق)\nمثال: في وقت ما أحبها",
 "erstwhile": "ذات مرة, سابقاً (في وقت سابق)\nمثال: في وقت ما أحبها",
 "ert": "وقت الاستقبال الأرضي (التوقيت العالمي المنسق عند استقبال حدث على الأرض)",
 "eruca sativa": "جرجير, روكا (نبات حولي أوروبي قائم يزرع غالباً كمحصول سلطة ليحصد عندما يكون صغيراً وطرياً)",
 "eruca vesicaria sativa": "جرجير, روكا (نبات حولي أوروبي قائم يزرع غالباً كمحصول سلطة ليحصد عندما يكون صغيراً وطرياً)",
 "eructation": "تجشؤ (منعكس يطرد الغازات بصوت عالٍ من المعدة عبر الفم) / تدفق, ثوران ((للبراكين) صب الأبخرة أو الحمم (أو الرواسب المتكونة))",
 "erudite": "مُتَبَحِّر, وَاسِعُ الاِطِّلَاع (ذو معرفة عميقة وواسعة أو يُظهرها)",
 "eruditely": "بتبحر, بثقافة واسعة (مع سعة اطلاع؛ بأسلوب ينم عن علم غزير)\nمثال: تحدث بتبحر عن الأساطير الهندية",
 "eruditeness": "تبحر, سعة اطلاع (معرفة علمية عميقة)",
 "erudition": "تبحر, سعة اطلاع (معرفة علمية عميقة)",
 "erupt": "ثَار (ثارَ يَثُورُ ثَوَرانًا، وثَوْرًا، وثَوْرَةً: هاج وانتَشَرَ؛ يُقال: ثارَ الدُّخانُ والغُبَرُ، وثار الدّم بفلان، وثارت به الحصْبَةُ، وثار به الشَّرُّ والغَضَبُ)\nمثال: ثار الفلاحون على الحكومة.",
 "eruption": "بزوغ السن (ظهور السن عند اختراقه اللثة) / انفجار, دوي (ضجيج عالٍ جداً ومفاجئ) / اندلاع, تفشي (حدوث تلقائي عنيف ومفاجئ (عادة لحالة غير مرغوب فيها)) / ثوران, ثوران بركاني (الحدوث المفاجئ لتفريغ عنيف للبخار والمواد البركانية)\nمثال: اندلاع الأعمال العدائية",
 "eruptive": "ثَائِر, مُنْدَفِع (يقذف الحمم البركانيّة بنشاط) / بركاني, ناري (مُنتَج بفعل النار أو الحرارة الشديدة) / ثوراني, طفحي (ينتج أو يتسم بالثوران أو الطفح)\nمثال: صخور تشكلت بواسطة عوامل نارية",
 "erwinia": "إروينيا (بكتيريا متحركة عصوية الشكل تهاجم النباتات)",
 "eryngium aquaticum": "زر الثعبان, قرصعنة مائية (قرصعنة معمرة شائكة خشنة بجذور عطرية؛ جنوب شرق الولايات المتحدة؛ غالباً ما يخلط بينها وبين سيد الأفاعي)",
 "eryngium maritimum": "شوك البحر, قرصعنة بحرية (قرصعنة أوروبية دائمة الخضرة بأوراق شائكة ملتوية تم توطينها في الساحل الشرقي للولايات المتحدة؛ كانت جذورها تستخدم سابقاً كمنشط جنسي)",
 "eryngium yuccifolium": "سيد الأفاعي, قرصعنة يوكية الأوراق (قرصعنة معمرة خشنة وشائكة في الولايات المتحدة يُعتقد أنها تعالج لدغة الأفعى الجرسية)",
 "eryngo": "قرصعنة",
 "erysimum allionii": "إريسيموم, منثور سيبيري (نبات مبهرج منتصب ثنائي الحول أو معمر قصير العمر يزرع لعناقيده الطرفية من الزهور البرتقالية الصفراء؛ يوضع أحياناً في جنس خيري)",
 "erysimum arkansanum": "زهرة الجدار الغربية (صاروخ البراري ثنائي الحول أو قصير العمر المعمر له زهور صفراء برتقالية؛ غرب أمريكا الشمالية إلى مينيسوتا وكانساس؛ يوضع أحياناً في جنس خيري)",
 "erysimum asperum": "زهرة الجدار الغربية (صاروخ البراري ثنائي الحول أو قصير العمر المعمر له زهور صفراء برتقالية؛ غرب أمريكا الشمالية إلى مينيسوتا وكانساس؛ يوضع أحياناً في جنس خيري)",
 "erysimum cheiranthoides": "إريسيموم, خردل بذور الدود (خردل أوروبي نحيل أصفر الزهر غالباً ما يكون عشباً ضاراً مزعجاً؛ كان يستخدم سابقاً كطارد للديدان)",
 "erysimum cheiri": "جدارية, منثور (نبات معمر من جنوب أوروبا له عناقيد من الزهور العطرة بجميع الألوان خاصة الأصفر والبرتقالي؛ غالباً ما يتوطن على الجدران القديمة أو المنحدرات؛ يوضع…)",
 "erysipelas": "حمرة (عدوى عقدية حادة تتميز بالتهاب أحمر عميق في الجلد والأغشية المخاطية)",
 "erythema": "حمامي (احمرار غير طبيعي في الجلد ناتج عن توسع الأوعية الدموية (كما في حروق الشمس أو الالتهاب))",
 "erythema multiforme": "حمامي متعددة الأشكال (طفح جلدي أحمر ناتج عن فرط الحساسية لدواء أو مرض أو مسبب حساسية آخر)",
 "erythema nodosum": "حمامي عقدة (حالة جلدية تتميز بعقد حمراء مؤلمة على الساقين)",
 "erythema nodosum leprosum": "حمامي عقدة جذامية (مضاعفات التهابية للجذام تؤدي إلى آفات جلدية مؤلمة على الذراعين والساقين والوجه)",
 "erythema solare": "حروق الشمس (احمرار الجلد الناجم عن التعرض لأشعة الشمس)",
 "erythematous": "حمامي (متعلق بـ أو يتميز بالحمامى (احمرار الجلد))",
 "erythrina": "حمرية, شجرة المرجان",
 "erythrina caffra": "إريثرينا كافرا, شجرة المرجان (شجرة شبه دائمة الخضرة واسعة الانتشار صغيرة من شرق جنوب أفريقيا بزهور برتقالية قرمزية وبذور حمراء مرجانية صغيرة؛ تنتج خشباً ناعماً خفيفاً يستخدم…)",
 "erythrina corallodendrum": "إريثرينا مرجانية, شجرة الفول المرجاني (شجيرة متساقطة الأوراق لها عناقيد من الزهور الحمراء العميقة وبذور حمراء منقطة بالأسود)",
 "erythrina crista-galli": "سايبو, شجرة المرجان الشائعة (شجرة شائكة صغيرة من أمريكا الجنوبية بزهور قرمزية داكنة وقرمزية منفردة أو متجمعة)",
 "erythrina indica": "شجرة المرجان الهندية (شجرة شائكة صغيرة إلى متوسطة الحجم من آسيا الاستوائية وشمال أستراليا لها عناقيد كثيفة من الزهور القرمزية أو القرمزية الداكنة وبذور سوداء)",
 "erythrina lysistemon": "إريثرينا ليسيستيمون, شجرة المرجان (شجرة صغيرة شبه دائمة الخضرة من جنوب أفريقيا لها عناقيد كثيفة من الزهور القرمزية الصافية وبذور حمراء)",
 "erythrina variegata": "شجرة المرجان الهندية (شجرة شائكة صغيرة إلى متوسطة الحجم من آسيا الاستوائية وشمال أستراليا لها عناقيد كثيفة من الزهور القرمزية أو القرمزية الداكنة وبذور سوداء)",
 "erythrina vespertilio": "إريثرينا خفافيشية, شجرة الفلين (شجرة مرجان أسترالية شائكة لها خشب إسفنجي ناعم)",
 "erythrite": "إريثريت, زهرة الكوبالت (معدن محمر يتكون من زرنيخات الكوبالت المائية في شكل بلوري أحادي الميل ويستخدم في تلوين الزجاج)",
 "erythroblast": "أرومة حمراء (خلية ذات نواة في نخاع العظم تتطور منها خلايا الدم الحمراء)",
 "erythroblastosis": "كثرة الأرومات الحمر (مرض دموي يتميز بالوجود غير الطبيعي للأرومات الحمراء في الدم)",
 "erythroblastosis fetalis": "كثرة الأرومات الحمر الجنينية",
 "erythrocebus patas": "سعدان باتاس, سعدان عسكري (قرد محمر طويل الذيل من غرب أفريقيا)",
 "erythrocin": "إريثروسين, إريثروميسين",
 "erythrocyte": "خلية دم حمراء, كريّة دم حمراء (خلية دم ناضجة تحتوي على الهيموجلوبين لنقل الأكسجين إلى أنسجة الجسم؛ قرص مقعر الوجهين ليس له نواة)",
 "erythrocyte sedimentation rate": "سُرْعَة التَّثَفُّل, مُعَدَّل تَثَفُّل كُرَيَات الدَّم الحَمْرَاء (المعدل الذي تترسب به خلايا الدم الحمراء في أنبوب دم تحت ظروف قياسية؛ يشير المعدل المرتفع عادة إلى وجود التهاب)",
 "erythrocytolysin": "حال الدم, هيموليسين (أي مادة يمكن أن تسبب تحلل كريات الدم الحمراء وإطلاق الهيموجلوبين منها)",
 "erythroderma": "احمرار الجلد (أي اضطراب جلدي ينطوي على احمرار غير طبيعي)",
 "erythroid": "كريوي أحمر (متعلق بكريات الدم الحمراء)",
 "erythrolysin": "حال الدم, هيموليسين (أي مادة يمكن أن تسبب تحلل كريات الدم الحمراء وإطلاق الهيموجلوبين منها)",
 "erythromycin": "إِرِيثْرُومِيسِين",
 "erythronium albidum": "إريثرونيوم أبيض, سن الكلب الأبيض (نبات سن الكلب من أمريكا الشمالية له زهور بيضاء منفردة بمراكز صفراء وخارج أزرق أو وردي)",
 "erythronium americanum": "زنبق السلمون المرقط, لسان الحية الأصفر (نبات سن الكلب من شرق أمريكا الشمالية له زهور صفراء منفردة معلمة بالبني أو الأرجواني وداخل منقط)",
 "erythronium californicum": "إريثرونيوم كاليفورني, زنبق الظبي (بنفسج سن الكلب الكاليفورني بزهور بيضاء كريمية مشوبة أحياناً بالأصفر)",
 "erythronium dens-canis": "سن الكلب الأوروبي (نبات سن الكلب الأوروبي القوي بزهور وردية إلى بنفسجية؛ يزرع في العديد من الأصناف)",
 "erythronium grandiflorum": "زنبق الثلج, زنبق النهر الجليدي (بنفسج سن الكلب من غرب أمريكا الشمالية له زهور صفراء زاهية)",
 "erythronium montanum": "زنبق الانهيار الجليدي (عشبة معمرة ذات أزهار بيضاء كبيرة معلمة باللون البرتقالي؛ توجد بالقرب من خط الثلج في شمال غرب الولايات المتحدة)",
 "erythropoiesis": "تكون الكريات الحمر (عملية إنتاج خلايا الدم الحمراء بواسطة الخلايا الجذعية في نخاع العظم)",
 "erythropoietic": "مكون للحمر (مكون من أو متعلق بتكوين خلايا الدم الحمراء)",
 "erythropoietin": "إريثروبويتين (بروتين سكري تفرزه الكلى يحفز إنتاج خلايا الدم الحمراء)",
 "erythroxylon coca": "كوكا, نبات الكوكا (شجيرة من أمريكا الجنوبية يمضغ السكان الأصليون في جبال الأنديز أوراقها؛ مصدر للكوكايين)",
 "erythroxylon truxiuense": "كوكا تروكسيلو (شجيرة من أمريكا الجنوبية تعد أوراقها مصدراً للكوكايين)",
 "erzincan": "أَرْزِنْجَان",
 "erzurum": "أَرْضُرُوم, أَرْضُ الرُوم",
 "es": "أينشتاينيوم (عنصر مشع ما بعد اليورانيوم يتم إنتاجه بقصف البلوتونيوم بالنيوترونات)",
 "esau": "عِيسُو, العِيص",
 "esc key": "مِفْتَاحُ هُرُوبٍ (مفتاح)\nمثال: بحث عن المفتاح.",
 "escabeche": "سِكْبَاج أَنْدَلُسِيّ",
 "escadrille": "سرب طائرات (سرب قوات جوية يحتوي عادة على ست طائرات (كما في فرنسا خلال الحرب العالمية الأولى)) / سرب صغير (سرب صغير)",
 "escalade": "تسلق الأسوار (فعل التسلق باستخدام السلالم (خاصة جدران التحصينات))",
