 "eternal life": "حياة أبدية, خلود (حياة بلا بداية أو نهاية)",
 "eternal rest": "راحة أبدية, رقاد (تعابير ملطفة للموت (بناءً على تشبيه بين الاستلقاء في السرير وفي القبر))\nمثال: وريت الثرى (رقدت) بجوار زوجها",
 "eternal sleep": "راحة أبدية, رقاد (تعابير ملطفة للموت (بناءً على تشبيه بين الاستلقاء في السرير وفي القبر))\nمثال: وريت الثرى (رقدت) بجوار زوجها",
 "eternally": "أبدياً, إلى الأبد (لوقت غير محدود)\nمثال: لا أحد يستطيع العيش إلى الأبد",
 "eternity": "أَبَد (الأبَد : الدَّهْرُ وَيُقَالُ الدَّهْرُ الطَّوِيلُ الَّذِي لَيْسَ بِمَحْدُودٍ؛ ما يَنْفُر القَلْب عن تقدير نهايته) / أبَدِيَّة\nمثال: سأحبك إلى الأبد.",
 "etf": "صندوق متداول في البورصة (صندوق استثمار مشترك يتم تداوله في سوق الأوراق المالية)",
 "ethacrynic acid": "حمض الإيثاكرينيك (مدر للبول (الاسم التجاري إيديكرين) يستخدم لعلاج الوذمة)",
 "ethanal": "أسيتالدهيد, إيثانال (ألديهيد سائل عديم اللون متطاير قابل للذوبان في الماء يستخدم بشكل رئيسي في تصنيع حمض الأسيتيك والعطور والأدوية)",
 "ethanal trimer": "بارالدهيد (سائل عديم اللون (ثلاثي الوحدات حلقي للأسيتالدهيد) يستخدم كمهدئ ومذيب)",
 "ethanamide": "أسيتاميد, إيثاناميد (أميد صلب عديم اللون لحمض الأسيتيك يستخدم كمذيب وفي تخليق المركبات العضوية)",
 "ethane": "إيثان (غاز ألكاني عديم اللون والرائحة يُستخدم كوقود)",
 "ethanedioic acid": "حمض الأكساليك (حمض عضوي بلوري سام عديم اللون يوجد في نبات الحميض ونباتات أخرى؛ يُستخدم كمبيض ومزيل للصدأ وفي التحليل الكيميائي)",
 "ethanediol": "إيثيلين غليكول, غليكول (سائل شرابي حلو ولكنه سام يستخدم كمضاد للتجمد ومذيب)",
 "ethanoate": "أسيتات, إيثانوات (ملح أو إستر لحمض الأسيتيك (الخليك))",
 "ethanoic acid": "حمض الأسيتيك, حمض الخليك (سائل لاذع عديم اللون يستخدم على نطاق واسع في تصنيع البلاستيك والمستحضرات الصيدلانية)",
 "ethanol": "إِيثَانُول",
 "ethanoyl chloride": "كلوريد الأسيتيل",
 "ethanoyl group": "أسيتيل, شق الأسيتيل",
 "ethanoyl radical": "أسيتيل, شق الأسيتيل",
 "ethchlorvynol": "إيثكلورفينول, بلاسيديل (دواء مهدئ منوم خفيف (الاسم التجاري بلاسيديل))",
 "ethene": "إيثيلين, إيثين (غاز ألكيني عديم اللون قابل للاشتعال؛ يُستخرج من البترول والغاز الطبيعي ويُستخدم في تصنيع العديد من المواد الكيميائية الأخرى؛ ويُستخدم أحياناً كمخدر)",
 "ether": "أَثِير",
 "ethereal": "أَثِيرِيّ, هَوَائِيّ (يَتَّسِمُ بِالخِفَّةِ وَعَدَمِ الكَثَافَة؛ لَا يُمْكِنُ لَمْسُهُ كَالهَوَاء) / أَثِيرِيّ, شَفَّاف (يَتَّسِمُ بِخِفَّةٍ وَرِقَّةٍ غَيْرِ مَعْهُودَة) / أَثيرِيّ, سَماوِيّ (مُتَعَلِّق بِالسَّماء أو الرُّوح؛ عُلْوِيّ وأَثيرِيّ) / إيثيري (محتوٍ على الإيثير أو مذاب فيه)\nمثال: محلول إيثيري",
 "ethernet": "إيثرنت (نوع من تكنولوجيا الشبكات للشبكات المحلية؛ يحمل الكابل المحوري إشارات تردد الراديو بين أجهزة الكمبيوتر بمعدل 10 ميغابت في الثانية)",
 "ethernet cable": "كابل إيثرنت (أي من عدة أنواع من الكابلات المحورية المستخدمة في شبكات الإيثرنت)",
 "ethic": "أخلاق, مبدأ أخلاقي (مبادئ الصواب والخطأ التي يقبلها فرد أو مجموعة اجتماعية) / أخلاقيات, دستور أخلاقي (نظام من المبادئ التي تحكم الأخلاق والسلوك المقبول)\nمثال: الأخلاق البيوريتانية",
 "ethical": "أَخْلَاقِيّ",
 "ethical code": "أخلاقيات, دستور أخلاقي (نظام من المبادئ التي تحكم الأخلاق والسلوك المقبول)",
 "ethical drug": "دواء بوصفة طبية, وصفة طبية (دواء لا يتوفر إلا بتعليمات مكتوبة من طبيب أو طبيب أسنان للصيدلي)\nمثال: أخبر الطبيب أنه كان يتناول وصفته الطبية بانتظام",
 "ethical motive": "أخلاق, دافع أخلاقي (دافع يستند إلى مبادئ الصواب والخطأ)",
 "ethical nihilism": "عدمية أخلاقية (وجهة نظر ما وراء الأخلاق القائلة بأنه لا شيء أخلاقي أو غير أخلاقي جوهرياً)",
 "ethicality": "أخلاقية (حالة أو جودة أو طريقة الامتثال لمعايير السلوك المقبولة)\nمثال: بدلاً من ذلك، ساعد في وضع مثل هذه الإرشادات ووجد نفسه في تفكير عميق حول أخلاقية بحثه الخاص",
 "ethically": "أخلاقياً, بشكل أخلاقي (بطريقة أخلاقية؛ من وجهة نظر أخلاقية؛ وفقاً للأخلاق)\nمثال: لقد تصرف أخلاقياً",
 "ethician": "عالم أخلاق (فيلسوف متخصص في الأخلاق)",
 "ethicism": "أخلاقية (مذهب يرى أن الأخلاق والأفكار الأخلاقية صالحة ومهمة)\nمثال: أدت به أخلاقيته في كثير من الأحيان إلى الوعظ",
 "ethicist": "عالم أخلاق (فيلسوف متخصص في الأخلاق)",
 "ethics": "أَخْلَاق, أَدَب",
 "ethics committee": "لجنة الأخلاقيات (لجنة معينة للنظر في القضايا الأخلاقية)",
 "ethics panel": "لجنة الأخلاقيات (لجنة معينة للنظر في القضايا الأخلاقية)",
 "ethiopia": "أَثِيُوبِيَا (طريقة هجاء بديلة لإثيوبيا) / إِثِيُوبِيَا (دولة في شرق إفريقيا؛ اسمها الرسمي: جمهورية إثيوبيا الفدرالية الديمقراطية؛ عاصمتها: أَدِيس أَبَابَا)",
 "ethiopian": "إثيوبي (من أو متعلق أو مميز لإثيوبيا أو شعبها أو لغاتها) / إِثْيُوبِيّ, حَبَشِيّ (مواطن أو ساكن في إثيوبيا)\nمثال: مهاجرون إثيوبيون",
 "ethiopian banana": "إنست, موز حبشي (عشب شجري دائم الخضرة كبير له أوراق ضخمة تشبه المجداف ويحمل ثماراً تشبه الموز غير صالحة للأكل ولكن براعم أزهاره الصغيرة صالحة للأكل؛ يوضع أحياناً في…)",
 "ethiopian language": "الأمهرية (اللغة المهيمنة والرسمية لإثيوبيا؛ لغة سامية متأثرة كثيرًا باللغة الكوشية)",
 "ethiopian monetary unit": "وحدة نقدية إثيوبية (الوحدة النقدية في إثيوبيا)",
 "ethiopian nightshade": "بَاذِنْجَان أَفْرِيقِيّ, حَدَق أَثْيُوبِيّ",
 "ethmoid": "عظم غربالي (أحد عظام القحف الثمانية؛ عظم صغير مليء بجيوب هوائية يشكل جزءاً من محجر العين والتجويف الأنفي)",
 "ethmoid bone": "عظم غربالي (أحد عظام القحف الثمانية؛ عظم صغير مليء بجيوب هوائية يشكل جزءاً من محجر العين والتجويف الأنفي)",
 "ethmoid sinus": "جيب غربالي (جيب في ممرات التجويف الأنفي (خلف جسر الأنف))",
 "ethmoidal artery": "شريان غربالي (فرع من الشريان العيني يغذي التراكيب الموجودة داخل وحول المحفظة الأنفية)",
 "ethmoidal sinus": "جيب غربالي (جيب في ممرات التجويف الأنفي (خلف جسر الأنف))",
 "ethmoidal vein": "وريد غربالي (أوردة تصرف الجيوب الغربالية وتصب في الوريد العيني العلوي)",
 "ethnarch": "إثنارك, حاكم شعب (حاكم مقاطعة (كما في الإمبراطورية الرومانية والبيزنطية) أو بعض الحكام الدينيين ذوي السلطة الدنيوية)\nمثال: انتخاب مكاريوس الثالث رئيساً للأساقفة منحه وضع حاكم الشعب في قبرص",
 "ethnic": "عِرْقِيّ",
 "ethnic cleansing": "تَطْهِير عِرْقِيّ (إِزالة التَلَوُّث؛ تَنْقية النَّفْس من الدَّنس)\nمثال: مهمتها هي متابعة أداء محطات التطهير.",
 "ethnic group": "مَجْمُوعَة إثْنِيَّة (مؤنث مَجْمُوع وهو اسم مفعول من جَمَعَ؛ الطَائِفَة أو الجَمَاعَة من الناس)\nمثال: شكرا لإضافتي للمجموعة.",
 "ethnic joke": "نُكْتَة عِرْقِيَّة (نكتة على حساب مجموعة عرقية معينة)",
 "ethnic minority": "أَقَلِّيَّة قَوْمِيَّة",
 "ethnic music": "فولك, موسيقى تراثية (الموسيقى التقليدية وعادة مجهولة المؤلف التي تعبر عن حياة الناس في مجتمع ما)",
 "ethnic slur": "إِهَانَة عِرْقِيَّة (إهانة موجهة لعرق شخص ما أو لغته)",
 "ethnical": "إِثْنِيّ, ثَقَافِيّ (يدلّ على أو ينبثق من أو يميّز أنماط الحياة التي بناها مجموعة من الناس)",
 "ethnically": "إثنياً, عرقياً (فيما يتعلق بالعرق أو الإثنية)\nمثال: الحي متنوع عرقياً",
 "ethnicity": "إِثْنِيَّة, مَجْمُوعَة إِثْنِيَّة",
 "ethnocentric": "متمركز حول العرق (يتمحور حول مجموعة عرقية محددة، عادةً مجموعة الشخص نفسه)",
 "ethnocentrism": "تَمَرْكُز عِرْقِيّ",
 "ethnographer": "إثنوغرافي (عالم أنثروبولوجيا يقوم بالإثنوغرافيا (وصف الشعوب))",
 "ethnographic": "إِثْنُوغْرَافِيّ",
 "ethnographical": "إثنوغرافي, وصف الأعراق (من أو متعلق بالإثنوغرافيا (وصف الأعراق البشرية))\nمثال: بيانات إثنوغرافية",
 "ethnography": "عِلْم الإِنْسََان التَطْبِيقِيّ, إِثْنُوغْرَافِيَّا (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "ethnologic": "إثنولوجي, علم الأعراق (من أو متعلق بالإثنولوجيا (علم الأعراق))\nمثال: عمل ميداني إثنولوجي",
 "ethnological": "إثنولوجي, علم الأعراق (من أو متعلق بالإثنولوجيا (علم الأعراق))\nمثال: عمل ميداني إثنولوجي",
 "ethnologist": "إثنولوجي, عالم أعراق (عالم أنثروبولوجيا يدرس الإثنولوجيا (علم الأعراق))",
 "ethnology": "إِتْنُولُوجِيَة",
 "ethnonationalism": "قومي",
 "ethnos": "إثنية, مجموعة عرقية (أشخاص من نفس العرق أو الجنسية يشتركون في ثقافة مميزة)",
 "ethocaine": "بروكائين (مسحوق بلوري أبيض (الاسم التجاري إيثوكائين) يُعطى بالقرب من الأعصاب كمخدر موضعي في طب الأسنان والطب)",
 "ethologist": "عالم سلوك حيوان (عالم حيوان يدرس سلوك الحيوانات في بيئاتها الطبيعية)",
 "ethology": "علم سلوك الحيوان (فرع علم الحيوان الذي يدرس سلوك الحيوانات في بيئاتها الطبيعية)",
 "ethos": "إيثوس, روح الثقافة ((الأنثروبولوجيا) الروح المميزة لثقافة أو عصر ما)\nمثال: الروح اليونانية",
 "ethosuximide": "إيثوسكسيميد, زارونتين (دواء مضاد للاختلاج (الأسماء التجارية زارونتين وغيرها) يستخدم لعلاج الصرع الصغير)",
 "ethoxyethane": "إيثر (سائل متطاير عديم اللون وشديد الاشتعال كان يستخدم سابقاً كمخدر استنشاقي)",
 "ethrane": "إنفلوران (سائل غير قابل للاشتعال (الاسم التجاري إيثران) يستخدم كمخدر عام استنشاقي)",
 "ethril": "إريثروسين, إريثروميسين",
 "ethyl": "إيثيل, شق إيثيل",
 "ethyl acetate": "إيثيل أسيتات, خلات الإيثيل (إستر سائل متطاير قابل للاشتعال عديم اللون عطري يصنع من الإيثانول وحمض الأسيتيك؛ يستخدم في المنكهات والعطور وكمذيب للبلاستيك)",
 "ethyl alcohol": "كحول إيثيلي, كحول محايد (كحول غير منكه بنسبة 95 بالمائة أو 190 درجة، يستخدم للمزج مع الويسكي الصافي وفي صنع الجن والليكير) / إيثانول, كحول إيثيلي (العامل المسكر في المشروبات المخمرة والمقطرة؛ يستخدم نقياً أو محولاً كمذيب أو في الأدوية والكولونيا ومحاليل التنظيف ووقود الصواريخ؛ ويقترح كإضافة…)",
 "ethyl aminobenzoate": "بنزوكائين (إستر بلوري أبيض يستخدم كمخدر موضعي)",
 "ethyl chloride": "كلوريد الإيثيل (غاز عديم اللون قابل للاشتعال يستخدم كمخدر سطحي موضعي)",
 "ethyl ether": "إيثر (سائل متطاير عديم اللون وشديد الاشتعال كان يستخدم سابقاً كمخدر استنشاقي)",
 "ethyl group": "إيثيل, شق إيثيل",
 "ethyl radical": "إيثيل, شق إيثيل",
 "ethylene": "إيثيلين, إيثين (غاز ألكيني عديم اللون قابل للاشتعال؛ يُستخرج من البترول والغاز الطبيعي ويُستخدم في تصنيع العديد من المواد الكيميائية الأخرى؛ ويُستخدم أحياناً كمخدر)",
 "ethylene glycol": "إيثيلين غليكول, غليكول (سائل شرابي حلو ولكنه سام يستخدم كمضاد للتجمد ومذيب)",
 "ethylene tetrachloride": "تتراكلور إيثيلين (عامل طارد للديدان يستخدم ضد الديدان الخطافية والديدان الخيطية الأخرى)",
 "ethylenediaminetetraacetic acid": "إيثيلين ثنائي الأمين رباعي حمض الأسيتيك (جزيء معقد يستخدم طبياً لإزالة أيونات المعادن (الاستخلاب) في حالات التسمم بالرصاص أو المعادن الثقيلة)",
 "ethyne": "أسيتيلين, إيثاين (غاز عديم اللون قابل للاشتعال يستخدم بشكل رئيسي في اللحام وفي التخليق العضوي)",
 "etiolate": "شَاحِب, مُبْيَضّ (فاقد اللون بسبب الحرمان من الضوء)",
 "etiolated": "شَاحِب, مُبْيَضّ (فاقد اللون بسبب الحرمان من الضوء)",
 "etiolation": "اصفرار, شحوب ((علم النبات) فعل جعل النبات ينمو بدون كلوروفيل عن طريق زراعته دون التعرض لأشعة الشمس) / إصفرار, شحوب (عملية الإضعاف عن طريق إعاقة نمو أو تطور شيء ما) / اصفرار, شحوب (مظهر شاحب ومريض)\nمثال: اصفرار الكرفس",
 "etiologic": "مرضي سببي, مسببي (يتعلق بأسباب المرض (الإتيولوجيا)) / تعليلي, سببي (من أو يتعلق بالدراسة الفلسفية للأسباب)\nمثال: عامل مسبب",
 "etiological": "مرضي سببي, مسببي (يتعلق بأسباب المرض (الإتيولوجيا)) / تعليلي, سببي (من أو يتعلق بالدراسة الفلسفية للأسباب)\nمثال: عامل مسبب",
 "etiologist": "أخصائي علم أسباب الأمراض (أخصائي في علم أسباب الأمراض)",
 "etiology": "أيتولوجيا, علم الأسباب (الدراسة الفلسفية للسببية) / علم الأسباب, مسببات المرض (سبب المرض)",
 "etiquette": "ذَوْق, آدَاب (الذَّوْقُ : حَاسَّةُ اللِّسَانِ وَبِهَا قُوَّةٌ تُدْرِكُ خَوَاصَّ الأَجْسَامِ الطَّعْمِيَّةَ؛ الذَّوْقُ : آدابُ السلوك التي تقتضي معرفة ما هو لائق أو مناسب في موقف اجتماعيّ معيّن)\nمثال: أكره ذوق الكحول.",
 "etna": "جَبَل النَار, جَبَل إِتْنَا (كلمة \"جبل\" لها معانٍ متعددة؛ طبع أو خلق شيئًا أو شخصًا على طبيعة أو سلوك معين)\nمثال: منزلي في الجبل.",
 "etodolac": "إيتودولاك, لودين (دواء مضاد للالتهاب غير ستيرويدي (الاسم التجاري لودين))",
 "eton collar": "ياقة إيتون (ياقة بيضاء عريضة تُرتدى فوق طيات صدر السترة)",
