 "editorial file": "ملف تحريري (ملف يتضمن مطبوعات جاهزة للنشر)",
 "editorialist": "كاتب افتتاحي, كاتب عمود (صحفي يكتب المقالات الافتتاحية)",
 "editorially": "تَحْرِيرِيًّا, عَبْرَ مَقَال افْتِتَاحِيّ (بواسطة مقال افتتاحي)\nمثال: علقت الصحيفة تحريرياً على الفضيحة",
 "editorship": "تحرير, رئاسة التحرير (منصب المحرر)",
 "edmonton": "أدمونتون",
 "edmontonia": "إدمونتونيا (ديناصور مدرع بكثافة وشائك للغاية ذو وضعية شبه منتصبة)",
 "edmontosaurus": "إدمونتوصور (ديناصور بطي المنقار من كندا عُثر عليه كمومياء متحجرة مع الجلد)",
 "edo": "إِيدُو",
 "edp": "معالجة إلكترونية للبيانات (معالجة آلية للبيانات بالوسائل الإلكترونية دون استخدام بطاقات التبويب أو الأشرطة المثقوبة)",
 "edronax": "إدروناكس, ريبوكسيتين (دواء مضاد للاكتئاب يمنع استرداد النوربينفرين)",
 "eds": "نظام الكشف عن المتفجرات (نظام آلي سريع للكشف عن المتفجرات البلاستيكية في أمتعة الركاب باستخدام تقنية الأشعة السينية وأجهزة الكمبيوتر؛ مصمم للاستخدام في المطارات)",
 "edta": "إيثيلين ثنائي الأمين رباعي حمض الأسيتيك (جزيء معقد يستخدم طبياً لإزالة أيونات المعادن (الاستخلاب) في حالات التسمم بالرصاص أو المعادن الثقيلة)",
 "educate": "يُعَلم, درّب",
 "educated": "متعلم, مثقف (يمتلك تعليماً (خاصة وجود معرفة أكثر من المتوسط)) / مُسْتَنِير, وَاعٍ (يتّسم بالفهم الكامل للمسألة المطروحة)",
 "educatee": "تلميذ, طالب (متعلم مسجل في مؤسسة تعليمية)",
 "education": "تَعْلِيم, تَرْبِيَة (الأوامر والنواهي التي يحددها دِين ما أو مَذْهَب ما. يُجمع جَمْع تَكْسِير على تَعَالِيم؛ ما دون الأمْر المُلْزِم والمستدعي للعقوبة وفوق الطَلَب الإختياري. أكثر ما يستخدم بصيغة الجمع تَعْلِيمَات) / تَعْلِيم, ثَقَافَة (الأوامر والنواهي التي يحددها دِين ما أو مَذْهَب ما. يُجمع جَمْع تَكْسِير على تَعَالِيم؛ ما دون الأمْر المُلْزِم والمستدعي للعقوبة وفوق الطَلَب الإختياري. أكثر ما يستخدم بصيغة الجمع تَعْلِيمَات)\nمثال: هو بارع في التعليم.",
 "education department": "وزارة التعليم (الإدارة الفيدرالية الأمريكية التي تدير جميع البرامج الفيدرالية المتعلقة بالتعليم (بما في ذلك المساعدات الفيدرالية للمؤسسات التعليمية والطلاب)؛ أنشئت…)",
 "education secretary": "وزير التعليم (منصب رئيس وزارة التعليم) / وزير التعليم (الشخص الذي يشغل منصب وزير وزارة التعليم)\nمثال: تم إنشاء منصب وزير التعليم عام 1979",
 "educational": "تَعْلِيمِيّ",
 "educational activity": "تدريس, تربية (أنشطة التعليم أو التدريس؛ الأنشطة التي تنقل المعرفة أو المهارة)\nمثال: لم يتلق أي تعليم رسمي",
 "educational institution": "مُؤَسَّسَة تَعْلِيمِيَّة",
 "educational program": "برنامج تعليمي (برنامج لتوفير التعليم)",
 "educationalist": "تربوي (متخصص في نظرية التعليم)",
 "educationally": "تَرْبَوِيًّا, تَعْلِيمِيًّا (بطريقة تعليمية)\nمثال: شكل المساعدون لجنة خاصة بهم للنظر فيما يمكن القيام به تعليمياً للمدينة",
 "educationist": "تربوي (متخصص في نظرية التعليم)",
 "educative": "تَرْبَوِيّ (يؤدي إلى التثقيف والتعليم)",
 "educator": "مُعَلِّم, مُؤَدِّب (من يمتهن التعليم، مُدَرِّس)\nمثال: هي أصبحت معلمة.",
 "eductor-jet pump": "حاقن بخاري, ضاغط حراري (الحاقن أو اللافظ أو الحاقن البخاري أو المضخة النفاثة هو نوع من المضخات)\nمثال: بناءً على التطبيق المحدد، يمكن للحاقن أن يتخذ شكل مضخة نفاثة، أو قاذف مياه، أو قاذف تفريغ، أو قاذف بخار نفاث، أو شفاط",
 "edutainment": "ترفيه تعليمي (ترفيه يهدف إلى أن يكون تعليمياً)",
 "edward": "إِدْوَارْد",
 "edwardian": "إدواردي (من أو متعلق أو مميز لعهد إدوارد السابع في إنجلترا) / إدواردي (شخص ينتمي (أو كأنه ينتمي) إلى عصر إدوارد السابع)\nمثال: أثاث إدواردي",
 "ee": "هندسة كهربائية (فرع العلوم الهندسية الذي يدرس استخدامات الكهرباء ومعدات توليد الطاقة وتوزيعها والتحكم في الآلات والاتصالات)",
 "eec": "الاتحاد الأوروبي, السوق الأوروبية المشتركة (منظمة دولية للدول الأوروبية تشكلت بعد الحرب العالمية الثانية لتقليل الحواجز التجارية وزيادة التعاون بين أعضائها)\nمثال: حاول إدخال بريطانيا في الاتحاد الأوروبي",
 "eeg": "تخطيط الدماغ, مخطط كهربية الدماغ (سجل بياني للنشاط الكهربائي للدماغ؛ ينتجه جهاز تخطيط كهربية الدماغ)",
 "eel": "أَنْقَلِيس, أَنْكَلِيس",
 "eel-shaped": "أَنْقَلِيسِيّ الشَّكْل (على شكل ثعبان البحر)",
 "eelblenny": "إيل بليني (أسماك تشبه الثعبان توجد في المياه الساحلية شبه القطبية)",
 "eelgrass": "عشب الشريط, فاليسنيريا (نبات مائي مغمور بأوراق تشبه الشريط؛ العالم القديم وأستراليا) / حشيشة البحر, زوستيرا (نبات بحري مغمور بأوراق ضيقة طويلة جداً يوجد بكثرة على طول سواحل شمال الأطلسي)",
 "eellike": "أُنْقُلِيسِيّ, شَبِيه بِالأَنْقَلِيس (يشبه ثعبان البحر في كونه طويلًا ونحيلًا ومتلويًا)",
 "eelpout": "بربوط (قد مياه عذبة ممدود في شمال أوروبا وآسيا وأمريكا الشمالية له زوائد حول فمه) / إيل بوت, السمكة المرموطة (أسماك بحرية تشبه الثعبان تعيش غالباً في القاع في البحار الشمالية)",
 "eelworm": "دودة ثعبانية (أي من الديدان الأسطوانية الصغيرة حرة المعيشة المتطفلة على النباتات)",
 "eeny, meeny, miny, moe": "حكرة بكرة",
 "eerie": "مُخِيف, مُوحِش (يُوحِي بِالخَوْف؛ غَرِيب وَمُرْعِب) / مُخِيف, مُوحٍ بِالخَوَارِق (يوحي بما هو خارق للطبيعة؛ غامض ومريب)",
 "eerily": "بِشَكْل مُخِيف, بِشَكْل مُوحِش (بطريقة مخيفة غير طبيعية)\nمثال: كان الجو هادئاً بشكل مخيف في الكنيسة",
 "eeriness": "غُمُوض مُخِيف, وَحْشَة (الغرابة بحكم كون الشيء غامضاً ومثيراً للخوف)",
 "eery": "مُخِيف, مُوحِش (يُوحِي بِالخَوْف؛ غَرِيب وَمُرْعِب)",
 "ef": "إِف",
 "efface": "دَسَمَ, طَلَسَ (دَسََّمَ: الدَّسَمُ، محرَّكةً: الوَدَكُ، والوَضَرُ، والدَّنَسُ)",
 "effaceable": "قَابِلٌ لِلْإِزَالَة, قَابِلٌ لِلْمَسْح (يمكن طمسه أو إزالته)",
 "effacement": "انزواء, تواري (الانسحاب إلى الخلفية؛ جعل النفس غير ملحوظة) / ترقق عنق الرحم, محي (قصر عنق الرحم وترقق جدرانه مع اتساعه أثناء المخاض)",
 "effect": "تَأْثِير, أَثَر",
 "effected": "مُحَقَّق, مُنْجَز (مُستقرّ بشكل نهائيّ وغير مشروط)",
 "effecter": "مُحَقِّق لِلْغَايَة, مُنَفِّذ (من يحقق نتيجة أو حدثاً؛ من ينجز غرضاً ما)",
 "effective": "فَعَّال (ذو الفعل المؤثر)\nمثال: لا يستطيع إتخاذ إجراءات فعالة.",
 "effectively": "فعلياً, في الواقع (في الواقع أو الحقيقة) / بِتَأْثِير, بِفَاعِلِيَّة (بطريقة فعالة)\nمثال: هي فعلياً زوجته",
 "effectiveness": "فعالية, قوة تأثير (القدرة على إنتاج تأثيرات فسيولوجية أو كيميائية قوية) / تأثير, فعالية (القدرة على أن يكون مؤثرًا أو إحداث تأثير)\nمثال: قوة تأثير التوكسين",
 "effectivity": "تأثير, فعالية (القدرة على أن يكون مؤثرًا أو إحداث تأثير)",
 "effector": "مستجيب (عضو (غدة أو عضلة) يصبح نشطاً استجابة للنبضات العصبية) / عضو منفذ, مستجيب (ليف عصبي ينتهي عند عضلة أو غدة ويحفز الانقباض أو الإفراز) / مُحَقِّق لِلْغَايَة, مُنَفِّذ (من يحقق نتيجة أو حدثاً؛ من ينجز غرضاً ما)",
 "effects": "أغراض شخصية, متعلقات شخصية (ممتلكات ذات طابع شخصي قابلة للحمل ولا تستخدم في الأعمال التجارية)\nمثال: تركت بعض متعلقاتها الشخصية في المنزل",
 "effects unit": "وحدة مؤثرات (جهاز إلكتروني يغير طريقة صوت الآلة الموسيقية أو مصدر صوتي آخر)\nمثال: يستمد عازفو الجيتار صوتهم المميز أو 'نغمتهم' من اختيارهم للآلة، والمنشطات، ووحدات المؤثرات، ومضخم الجيتار",
 "effectual": "فعال, مؤثر (ينتج أو قادر على إنتاج نتيجة مقصودة أو له تأثير ملحوظ) / قَانُونِيّ, نَافِذ (ذُو فَاعِلِيَّةٍ أَوْ قُوَّةٍ قَانُونِيَّة)\nمثال: كان المحرك المبرد بالهواء أكثر فعالية من مكنسة الساحرة للنقل السريع لمسافات طويلة",
 "effectuality": "تأثير, فعالية (القدرة على أن يكون مؤثرًا أو إحداث تأثير)",
 "effectually": "بِتَأْثِير, بِشَكْل فَعَّال (بطريقة فعالة)\nمثال: تعرض بسمارك لانتقادات مستمرة من قبل الصحف الأكثر ليبرالية، ورد بإصدار مرسوم طوارئ أخرس الصحافة بشكل فعال",
 "effectualness": "تأثير, فعالية (القدرة على أن يكون مؤثرًا أو إحداث تأثير)",
 "effectuation": "تطبيق, تفعيل (فعل التنفيذ (توفير وسيلة عملية لإنجاز شيء ما))",
 "effeminacy": "تخنُّث، تأنث",
 "effeminate": "مُخَنَّث",
 "effeminateness": "تخنث, ميوعة (سمة التخنث (استخدام ازدرائي للرجل))\nمثال: ربط الطلاب العلم بالرجولة والفنون بالتخنث",
 "effendi": "أَفَنْدِي",
 "efferent": "حَرَكِيّ, صَادِر (للأعصاب والنبضات العصبية؛ تنقل المعلومات بعيداً عن الجهاز العصبي المركزي) / عصب حركي, عصب صادر (عصب ينقل النبضات باتجاه أو إلى العضلات أو الغدد)\nمثال: أعصاب ونبضات صادرة",
 "efferent fiber": "ليف حركي, ليف صادر (ليف عصبي يحمل النبضات نحو العضلات أو الغدد)",
 "efferent nerve": "عصب حركي, عصب صادر (عصب ينقل النبضات باتجاه أو إلى العضلات أو الغدد)",
 "efferent neuron": "عصبون حركي (عصبون ينقل النبضات من الدماغ أو الحبل الشوكي إلى الخارج)",
 "effervescence": "رغوية, فوران (خاصية إطلاق فقاعات) / فوران (عملية ظهور فقاعات أثناء خروج الغاز)",
 "effervescent": "فَوَّار, مُتَأَلِّق (يتميّز بروح عالية أو حماسة متّقدة) / فوار ((للسائل) يطلق فقاعات) / غازي, فوار (يُستخدم للنبيذ والمياه؛ مشحون طبيعياً أو صناعياً بثاني أكسيد الكربون)\nمثال: نبيذ فوار",
 "effervescing": "رَغْوِيّ, فَقَّاعِيّ (يُصدر فقاعات أو مليء بها كما في المشروبات الغازيّة أو التخمير)",
 "effete": "فَاقِد الحَيَوِيَّة, مُنْهَك (فقد حيويته وقدرته على الفعالية) / مُتَرَهِّلٌ, مُخَنَّثٌ (متكلف ومبالغ في الرقة والتأنق)",
 "efficacious": "فعال, مؤثر (ينتج أو قادر على إنتاج نتيجة مقصودة أو له تأثير ملحوظ) / فعال, ناجع (يتميز بصفات تمنح القدرة على إنتاج تأثير مقصود)\nمثال: كان المحرك المبرد بالهواء أكثر فعالية من مكنسة الساحرة للنقل السريع لمسافات طويلة",
 "efficaciously": "بِتَأْثِير, بِفَاعِلِيَّة (بطريقة فعالة)\nمثال: هذه مشاكل حقيقية يمكن التعامل معها بفاعلية أكبر من خلال النقاش العقلاني",
 "efficaciousness": "فعالية, نجاعة (القدرة أو القوة لإنتاج تأثير مرغوب)\nمثال: قلق بشأن سلامة وفعالية اللقاح",
 "efficacy": "فعالية, نجاعة (القدرة أو القوة لإنتاج تأثير مرغوب)\nمثال: قلق بشأن سلامة وفعالية اللقاح",
 "efficiency": "فاعلية, كفاءة (المهارة في تجنب إضاعة الوقت والجهد) / كَفَاءَة (نسبة المخرجات إلى المدخلات في أي نظام)\nمثال: قامت بالعمل بكفاءة كبيرة",
 "efficiency apartment": "استديو, شقة اقتصادية (شقة مفروشة مع مطبخ صغير وحمام)",
 "efficiency engineer": "خبير كفاءة (خبير في زيادة الاستخدام الفعال للآلات والموظفين)",
 "efficiency expert": "خبير كفاءة (خبير في زيادة الاستخدام الفعال للآلات والموظفين)",
 "efficient": "فَعَّال (ذو الفعل المؤثر)\nمثال: لا يستطيع إتخاذ إجراءات فعالة.",
 "efficiently": "بِفَعَّالِيَّة, بِكَفَاءَة (مع الكفاءة؛ بطريقة فعالة)\nمثال: يعمل بكفاءة",
 "effigy": "تمثال رمزي, دمية (تمثيل لشخص (خاصة في شكل نحت))\nمثال: تحمل العملة صورة لينكولن",
 "effleurage": "تدليك خفيف, مسد (حركة مسح إيقاعية)\nمثال: يستخدم المسد للبطن في طريقة لاماز للولادة",
 "efflorescence": "إزهار, تزهير (رواسب مسحوقية على سطح ما) / إزهار, تفتح الزهور (وقت وعملية تبرعم وتفتح الزهور) / طفح جلدي (أي طفح أحمر على الجلد) / أوج, إبان (فترة الازدهار أو الإنتاجية القصوى)",
 "efflorescent": "مُتَفَتِّح, مُزْهِر (عندما تكون البراعم على النبات في طور التفتح والإزهار)",
 "effluence": "تدفق خارجي (عملية التدفق إلى الخارج)",
 "effluent": "مُتَدَفِّق إِلَى الخَارِج (يجري أو يتدفّق نحو الخارج) / مياه عادمة, مياه مبتذلة (ماء مخلوط بمواد النفايات)",
 "effluvium": "رائحة كريهة, نفايات غازية (تدفق أو بخار كريه الرائحة (خاصة النفايات الغازية))",
 "efflux": "تدفق خارجي (عملية التدفق إلى الخارج)",
 "effort": "جَهْد, جُهْد (بَذَلَ قُصَارَى جُهْدِهِ فِي أَمْرٍ مَا؛ أَتْعَبَ نَفْسَهُ أو غَيْرَهُ بِعَمَلٍ شَاقٍ)\nمثال: لا إنجاز بلا جهد .",
 "effortful": "شاق, مجهد (يتطلب جهداً بدنياً كبيراً)",
 "effortfulness": "احتياج لجهد, مشقة (صفة تطلب جهد متعمد)",
 "effortless": "بِلَا جُهْد, يَسِير (لَا يُظْهِر جُهْدًا أَوْ إِجْهَادًا) / بدون جهد, سهل (لا يتطلب أو يبدو أنه لا يتطلب جهداً)\nمثال: انزلقت طيور السنونو بطريقة سهلة عبر الهواء المزدحم",
 "effortlessly": "بسهولة, دون جهد (بدون جهد أو جهد ظاهر)\nمثال: رقصت برشاقة ودون جهد",
 "effortlessness": "سُهُولَة تَامَّة, عَدَم بَذْل جُهْد (صفة التطلب لجهد قليل)\nمثال: هذه السهولة لا تتحقق إلا بعد ساعات من التدريب",
 "effrontery": "افتئات, تطاول (سلوك جريء (حتى متعجرف) ليس من حقك)\nمثال: احتقرهم بسبب تطاولهم",
 "effulgence": "إشعاع, بهاء (صفة كون الشيء ساطعاً ويرسل أشعة ضوئية)",
 "effulgent": "مُشِعّ, وَضَّاء (يَبُثّ الضَّوْء أَوْ كَأَنَّهُ يَبُثّ ضَوْءًا)",
 "effusion": "اِنْدِفَاق, اِنْصِبَاب / تَدَفُّق",
 "effusive": "فَيَّاض, مُبَالِغٌ فِي التَّعْبِير (مُبَالِغٌ فِي إِظْهَارِ المَشَاعِرِ بِشَكْلٍ مُفْرِط) / فَيَّاض, مُتَدَفِّق (يُعبَّر عنه بحماسة غير مقيّدة)",
 "effusively": "بِحَرَارَة بَالِغَة, بِفَيْض (بطريقة فياضة)\nمثال: أشاد النقاد بها بفيض",
 "effusiveness": "اندفاع في الكلام, فيض عاطفي (سمة ودية منفتحة لشخص ثرثار)",
 "eflops": "إكسا فلوب ((علم الحاسوب) وحدة لقياس سرعة نظام الحاسوب، تساوي كوينتيليون (10 أس 18) عملية نقطة عائمة في الثانية)",
 "eft": "سمندل الماء (مرحلة برية) (سمندل الماء في مرحلة تطوره البرية)",
 "egalitarian": "بِلَا طَبَقَات, مُسَاوَاتِيّ (يُؤَيِّدُ المُسَاوَاةَ الاجْتِمَاعِيَّة) / مساواتي (شخص يؤمن بالمساواة بين جميع الناس)",
 "egalitarianism": "مساواتية",
 "egalite": "مساواة تامة (المساواة الاجتماعية والسياسية)\nمثال: تمثل المساواة التامة تسوية شديدة للمجتمع",
 "egality": "مساواة تامة (المساواة الاجتماعية والسياسية)\nمثال: تمثل المساواة التامة تسوية شديدة للمجتمع",
 "egeria densa": "إيجيريا كثيفة, إيلودية كثيفة (نبات مائي ذو أوراق خضراء داكنة مفيد لإضافة الأكسجين لحوض السمك؛ يوضع أحياناً في جنس إيجيريا)",
 "egg": "بَيْضَة (ما تضعه أنثى الحيوان البَيُوض أو الطائر، يخرج منه صغير الطائر بعد فترة؛ قد يقصد به بَيْضَة الدجاج تحديدا لأنه أكثر ما يأكله الإنسان من بيوض الحيوان)\nمثال: هذه بيضة مقلية.",
 "egg candler": "جهاز فحص البيض (درع ضوئي يسمح فقط لبقعة ضوء بحجم بيضة بالسطوع؛ يستخدم لفحص البيض)",
 "egg cell": "بويضة (الخلية التناسلية الأنثوية؛ المشيج الأنثوي)",
 "egg cracker": "كسارة البيض (جهاز مطبخ يفتح البيض ويفصل بياض البيض عن الصفار)\nمثال: استخدام كسارة البيض لا يستحق العناء حقاً، فمن الأسهل القيام بذلك بالطريقة التقليدية",
 "egg cream": "شراب البيض الغازي (مصنوع من الحليب وشراب منكه مع مياه غازية)",
 "egg cup": "كأس البيض (إناء صغير لتقديم البيض المسلوق)",
 "egg en cocotte": "بيض في الفرن, بيض مخبوز (بيض مطبوخ بشكل فردي في القشدة أو الزبدة في وعاء صغير)",
 "egg foo yong": "إيج فو يونج (عجة تحتوي على البصل والكرفس واللحم المفروم أو السمك)",
 "egg fu yung": "إيج فو يونج (عجة تحتوي على البصل والكرفس واللحم المفروم أو السمك)",
 "egg laying": "وضع البيض (إنتاج البيض (خاصة في الطيور))",
 "egg noodle": "نودلز بالبيض (شريط ضيق من عجين المكرونة مصنوع بالبيض)",
 "egg roll": "سبرينغ رول, لفافة البيض (خضروات ولحم مفروم ملفوف في فطيرة ومقلية)",
 "egg salad": "سَلَطَة بَيْض (هو طعام يصنع من الخُضَار الطَازَجَة تقطع وتخلط ويضاف إليها المِلْح وقد يضاف عصير اللَيْمُون أو الخَلّ أو الزَيْت. لا يطبخ)\nمثال: هو متعطش للسلطة.",
 "egg timer": "ساعة رملية للبيض, مؤقت البيض (ساعة رملية تعمل لمدة ثلاث دقائق؛ تستخدم لتوقيت سلق البيض)",
 "egg white": "غِرْقِل, آح البَيْض",
 "egg yield": "إِنْتَاج البَيْض (إنتاجية الدجاجة أو غيرها من الحيوانات البياضة)",
 "egg yolk": "صفار البيض, مح (الجزء الكروي الأصفر من البيضة الذي يحيط به الزلال)",
 "egg-and-anchor": "بيضة وسهم (إطار زخرفي؛ سلسلة من الأشكال البيضاوية تتناوب مع شكل آخر)",
 "egg-and-dart": "بيضة وسهم (إطار زخرفي؛ سلسلة من الأشكال البيضاوية تتناوب مع شكل آخر)",
 "egg-and-tongue": "بيضة وسهم (إطار زخرفي؛ سلسلة من الأشكال البيضاوية تتناوب مع شكل آخر)",
 "egg-filled": "مَمْلُوء بِالبَيْض (مَلِيء بِالبَيْض)",
 "egg-laying mammal": "كظاميات (أكثر الثدييات بدائية وتضم الأعضاء الحية الوحيدة من طائفة الوحشيات الأولية)",
 "egg-shaped": "إِهْلِيلَجِيّ, بَيْضَوِيّ (مستدير كالبيضة؛ ذو شكل بيضاوي)",
 "eggar": "عثة إيجر (عثة ذات أجزاء فم غير وظيفية كبالغات؛ تتغذى اليرقات على أوراق الأشجار وتغزل شرانق بيضاوية الشكل)",
 "eggbeater": "خفاقة البيض (خلاط لخفق البيض أو الكريمة) / مروحية, هليكوبتر (طائرة بدون أجنحة تحصل على رفعها من دوران شفرات علوية)",
 "eggcup": "كأس البيض (إناء صغير لتقديم البيض المسلوق)",
 "eggdrop soup": "حساء البيض المخفوق, حساء قطرة البيض (يُصنع بتحريك البيض المخفوق في مرق يغلي)",
 "egger": "عثة إيجر (عثة ذات أجزاء فم غير وظيفية كبالغات؛ تتغذى اليرقات على أوراق الأشجار وتغزل شرانق بيضاوية الشكل)",
 "eggfruit": "فاكهة البيض, كانيستل (فاكهة حلوة دقيقية برتقالية صفراء بيضاوية الشكل من فلوريدا وجزر الهند الغربية)",
 "egghead": "دودة كتب, مثقف أكاديمي (مثقف؛ شخص دَرّاس وأكاديمي للغاية)\nمثال: رغم حبها للقراءة أنكرت كونها مثقفة أكاديمية",
 "eggnog": "شراب البيض",
 "eggplant": "بَاذِنْجَان, بَادِنْجَان",
 "eggplant bush": "باذنجان (عشب مشعر قائم موطنه جنوب شرق آسيا ولكنه يزرع على نطاق واسع لفاكهته اللحمية اللامعة الكبيرة المستخدمة عادة كخضروات)",
 "eggs": "بيض (جسم تناسلي بيضاوي للطير (خاصة الدجاج) يستخدم كطعام)",
 "eggs benedict": "بيض بينيديكت (مافن إنجليزي محمص مغطى بلحم وخنزير وبيضة مسلوقة (بدون قشر) وصلصة هولنديز)",
 "eggshake": "مخفوق البيض (مخفوق حليب يحتوي على البيض)",
 "eggshell": "قَشْر الْبَيْضِ",
 "eggwhisk": "خفاقة البيض (خلاط لخفق البيض أو الكريمة)",
 "egis": "درع الصدر, صفيحة صدرية (درع صفيحي يحمي الصدر؛ الجزء الأمامي من درع الجذع)",
 "eglantine": "ورد ياقوتي (اِسْمٌ وَصِفَةٌ لِلْأَسَد)\nمثال: سألته ورد بنعم.",
 "ego": "اَلْأَنَا",
 "ego ideal": "أنا مثالية, مثل أعلى للأنا ((التحليل النفسي) جزء من الأنا يحتوي على مثل أعلى للتميز الشخصي يسعى الشخص نحوه)",
 "ego trip": "تمجيد الذات, غرور (عمل يتم لزيادة قوتك ونفوذك أو لجذب الانتباه لأهميتك الخاصة)",
 "egocentric": "أناني, متمركز حول الذات (يهتم بشكل رئيسي أو حصري بنفسه ومصلحته مع استبعاد الآخرين) / أناني, متمركز حول ذاته (شخص يركز على ذاته ولا يقيم وزناً للآخرين)\nمثال: رجال أنانيون كانوا يحاولون تحقيق مكاسب لأنفسهم من قضية الحقوق المدنية المقدسة",
 "egocentrism": "أحادية, حب الذات (الاهتمام بمصالح المرء ورفاهيته الخاصة)",
 "egoism": "أَنَانِيَّة",
 "egoist": "أناني, متمركز حول ذاته (شخص يركز على ذاته ولا يقيم وزناً للآخرين) / أناني, شخص متمركز حول ذاته (شخص مغرور ومهتم بنفسه فقط)",
 "egoistic": "أناني, متمركز حول الذات (يهتم بشكل رئيسي أو حصري بنفسه ومصلحته مع استبعاد الآخرين)\nمثال: رجال أنانيون كانوا يحاولون تحقيق مكاسب لأنفسهم من قضية الحقوق المدنية المقدسة",
 "egoistical": "أناني, متمركز حول الذات (يهتم بشكل رئيسي أو حصري بنفسه ومصلحته مع استبعاد الآخرين)\nمثال: رجال أنانيون كانوا يحاولون تحقيق مكاسب لأنفسهم من قضية الحقوق المدنية المقدسة",
 "egomania": "أنانية مفرطة, غرور مرضي (حب شديد لا يقاوم للذات واهتمام مفرط بالحاجات الشخصية)",
 "egomaniac": "مفرط الأنانية, مهووس بذاته (شخص أناني بشكل غير طبيعي)",
 "egotism": "أنانية, حب الذات (رأي مبالغ فيه حول أهمية الذات) / تضخم الأنا, غرور (شعور متضخم بالفخر بتفوقك على الآخرين)",
 "egotist": "أناني, شخص متمركز حول ذاته (شخص مغرور ومهتم بنفسه فقط)",
 "egotistic": "مَغْرُور, مُعْجَب بِنَفْسِه (يتّسم بكبرياء زائف؛ لديه شعور مبالَغ فيه بأهمية الذات) / مَغْرُور, مُعْجَب بِنَفْسِه (يتسم بتضخيم أهمية ذاته؛ ذو نرجسية مفرطة)",
 "egotistical": "مَغْرُور, مُعْجَب بِنَفْسِه (يتّسم بكبرياء زائف؛ لديه شعور مبالَغ فيه بأهمية الذات) / مَغْرُور, مُعْجَب بِنَفْسِه (يتسم بتضخيم أهمية ذاته؛ ذو نرجسية مفرطة)",
 "egotistically": "بِأَثَرَة, بِأَنَانِيَّة (بطريقة أنانية)\nمثال: تصرف بأنانية",
 "egregious": "صَارِخ, فَاضِح (سَيِّئٌ وَمُسْتَنْكَرٌ بِشَكْلٍ صَارِخٍ وَفَاضِحٍ)",
 "egress": "انبيثاق, بزوغ (فعل الخروج أو الظهور للعيان) / بزوغ, خروج (الظهور للعيان) / بزوغ, خروج ((في علم الفلك) عودة ظهور جرم سماوي بعد الكسوف أو الاحتجاب)\nمثال: لا يوجد فرق يوم واحد بين ظهور النحل وتفتح أزهار الصفصاف",
 "egression": "انبيثاق, بزوغ (فعل الخروج أو الظهور للعيان)",
 "egret": "أَبُو قِرْدَان",
 "egretta albus": "بلشون أمريكي (بلشون شائع من جنس إغريتا يوجد في أمريكا؛ وهو نوع من البلشون الأبيض للعالم القديم)",
 "egretta caerulea": "بلشون أزرق صغير (بلشون رمادي مزرق صغير من نصف الكرة الغربي)",
 "egretta garzetta": "بلشون أبيض صغير (بلشون من العالم القديم)",
 "egretta thula": "بلشون ثلجي (بلشون صغير من العالم الجديد)",
 "egypt": "مِصْر, مصر (تقع في أقصى شمال شرق إفريقيا وجنوب غرب آسيا؛ اسمها الرسمي جُمْهُورِيَّة مِصْر الْعَرَبِيَّة، وعاصمتها الْقَاهِرَة؛ الحَاجِز بين الشيئين، والحَدُّ بين الأرضَيْن (جمعها مُصُور))\nمثال: ولد سامي في مصر.",
 "egyptian": "مِصْرِيّ",
 "egyptian arabic": "لَهْجَة مِصْرِيَّة, مِصْرِيَّة (طَرَفُ ٱللِّسَانِ؛ جَرْسُ ٱلْكَلَامِ)\nمثال: الشاوية هي لهجة للأمازيغية.",
 "egyptian bean": "فاصوليا هندية, فول مصري (كرمة معمرة ملتفة من المناطق الاستوائية في العالم القديم لها أوراق ثلاثية وعناقيد من زهور تشبه البازلاء الأرجوانية العطرة تليها قرون عنابية من بذور…)",
 "egyptian cat": "قط مصري (قط منزلي من مصر)",
 "egyptian cobra": "صِل, كوبرا مصرية (كوبرا استخدمها الفراعنة كرمز لقوتهم على الحياة والموت)",
 "egyptian corn": "درة, ذرة بيضاء (سورغم المناطق الجافة في آسيا وشمال أفريقيا)",
 "egyptian cotton": "قطن مصري (قطن ناعم طويل التيلة يميل للبني يُزرع في مصر؛ يُعتقد أنه مشتق من قطن جزر البحر أو بالتهجين مع القطن البيروفي)",
 "egyptian deity": "إله مصري (إله عبده قدماء المصريين)",
 "egyptian goose": "وَزَّة مِصْرِيَّة",
 "egyptian grass": "عشبة قدم الغراب, عشبة مصرية (عشبة زاحفة بسنابل تشبه الأصابع)",
 "egyptian henbane": "بنج مصري (عشب سام تعتبر أوراقه مصدراً للهيوسيامين)",
 "egyptian jackal": "ذئب ذهبي أفريقي (حيوان من فصيلة الكلبيات يعيش في صحاري شمال أفريقيا ويرتبط بابن آوى الذهبي والذئب الرمادي)",
 "egyptian language": "المصرية القديمة (لغة مصر القديمة والمنقرضة الآن تحت حكم الفراعنة؛ تعود السجلات المكتوبة إلى 3000 قبل الميلاد)",
 "egyptian lupine": "ترمس أبيض, ترمس مصري (عشب أوراسي ذو زهور بيضاء يزرع على نطاق واسع للعلف ومكافحة التعرية)",
 "egyptian monetary unit": "وحدة نقدية مصرية (الوحدة النقدية في مصر)",
 "egyptian onion": "بصل الشجرة, بصل مصري (نوع من البصل المعمر يزرع بشكل رئيسي للغرابة أو كبصل أخضر مبكر؛ له بصيلات صغيرة تحل محل الزهور)",
 "egyptian paper reed": "بردي, ورق البردي (سعد طويل من وادي النيل ينتج أليافاً خدمت أغراضاً عديدة في العصور التاريخية)",
 "egyptian paper rush": "بردي, ورق البردي (سعد طويل من وادي النيل ينتج أليافاً خدمت أغراضاً عديدة في العصور التاريخية)",
 "egyptian pea": "حمص, نبات الحمص (عشبة آسيوية تزرع لقرونها القصيرة التي تحتوي على بذرة أو بذرتين صالحتين للأكل)",
 "egyptian pound": "جنيه, جنيه مصري (وحدة المال الأساسية في مصر؛ تساوي 100 قرش)",
 "egyptian vulture": "رَخَم, رَخَمَة (رَخَمَ الصوتُ والكلامُ رَخْمًا: لان وسهل؛ رَخَمَت النعامةُ والدجاجةُ بيضَها وعليه رَخْمًا ورَخَمًا ورَخَمَةً: حضنته؛ فهي راخم)",
 "egyptian water lily": "زنبق الماء المصري, لوتس (اللوتس المصري الأبيض: زنبق الماء في مصر إلى جنوب شرق أفريقيا؛ كان مقدساً عند المصريين القدماء)",
 "egyptianize": "مَصَّرَ (تقع في أقصى شمال شرق إفريقيا وجنوب غرب آسيا؛ اسمها الرسمي جُمْهُورِيَّة مِصْر الْعَرَبِيَّة، وعاصمتها الْقَاهِرَة؛ الحَاجِز بين الشيئين، والحَدُّ بين الأرضَيْن (جمعها مُصُور))\nمثال: ولد سامي في مصر.",
 "egyptologist": "عالم مصريات (عالم آثار متخصص في علم المصريات)",
 "egyptology": "عِلْم اَلْمِصْرِيَّات (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "ehf": "تَرَدُّد شَدِيد العُلُوّ (30 إلى 300 جيجاهرتز)",
 "ehime": "إِهِيمِه",
 "eib": "إكسابايت, إكسبي بايت (وحدة معلومات تساوي 1024 بيبي بايت أو 2 أس 60 بايت)",
 "eibit": "إكسبي بت (وحدة معلومات تساوي 1024 بيبي بت أو 2 أس 60 بت)",
 "eichhornia crassipes": "ورد النيل, ياقوتية الماء (نبات مائي عائم استوائي له سنابل من الزهور الزرقاء الكبيرة؛ يسبب مشاكل في انسداد الممرات المائية خاصة في جنوب الولايات المتحدة)",
 "eichhornia spesiosa": "ورد النيل, ياقوتية الماء (نبات مائي عائم استوائي له سنابل من الزهور الزرقاء الكبيرة؛ يسبب مشاكل في انسداد الممرات المائية خاصة في جنوب الولايات المتحدة)",
 "eicosapentaenoic acid": "حمض إيكوسابنتاينويك (حمض أوميغا 3 دهني يحتوي على 20 ذرة كربون؛ يوجد في الأسماك (خاصة التونة والسمك الأزرق))",
 "eid": "عِيد",
 "eid al-adha": "عِيد اَلْأَضْحَى, اَلْأَضْحَى",
 "eid al-fitr": "عِيد الْفِطْر",
 "eid mubarak": "عِيد مُبَارَك",
 "eider": "عيدر (بط من نصف الكرة الشمالي يُقدر كثيراً لزغبه الناعم الموجود لدى الإناث)",
 "eider duck": "عيدر (بط من نصف الكرة الشمالي يُقدر كثيراً لزغبه الناعم الموجود لدى الإناث)",
 "eiderdown": "زَغَبُ العَيْدَر (زغب بط العيدر) / دوفيت, لحاف ريشي (لحاف ناعم محشو عادة بريش البط)",
 "eidetic": "اسْتِذْكَارِيّ (ذو تصوير بصري شبه فوتوغرافي في دقته)",
 "eidos": "إيدوس, طابع فكري ((الأنثروبولوجيا) التعبير المميز للطابع المعرفي أو الفكري لثقافة أو مجموعة اجتماعية)",
 "eiffel tower": "بُرْج إِيفِل (ظهر وارتفع)\nمثال: وصل كارل إلى برج آخر.",
 "eigenvalue": "قيمة ذاتية, قيمة مميزة ((رياضيات) أي عدد بحيث أن مصفوفة مربعة معينة مطروحًا منها ذلك العدد مضروبًا في مصفوفة الوحدة يكون لها محدد صفري)",
 "eigenvalue of a matrix": "قيمة ذاتية, قيمة مميزة ((رياضيات) أي عدد بحيث أن مصفوفة مربعة معينة مطروحًا منها ذلك العدد مضروبًا في مصفوفة الوحدة يكون لها محدد صفري)",
 "eigenvalue of a square matrix": "قيمة ذاتية, قيمة مميزة ((رياضيات) أي عدد بحيث أن مصفوفة مربعة معينة مطروحًا منها ذلك العدد مضروبًا في مصفوفة الوحدة يكون لها محدد صفري)",
 "eight": "ثَمَانِيَة, تمانية / ثَمَانِيَةٌ",
 "eight ball": "كرة الثمانية (كرة بلياردو سوداء تحمل الرقم 8؛ يجب أن تكون الأخيرة التي تدخل في بعض ألعاب البلياردو)",
 "eight hundred": "ثَمَانِيمِئَة, ثَمَانِيمِا۟ئَة",
 "eight o'clock": "اَلسَّاعَة اَلثَّامِنَة",
 "eight thousand": "ثَمَانِيَة آلَاف",
 "eight-day": "لِمُدَّة ثَمَانِيَة أَيَّام (يَسْتَمِرّ ثَمانِيَة أَيَّام)",
 "eight-fold": "ثُمَانِيّ (ذو ثماني وحدات أو مكوّنات)",
 "eight-membered": "ثُمَانِيُّ الأَعْضَاء (مُرَكَّبٌ كِيمِيَائِيٌّ لَهُ حَلْقَةٌ مِنْ ثَمَانِيَةِ أَعْضَاء)",
 "eight-sided": "ثُمَانِيّ الأَضْلَاع (ذو ثمانية أضلاع)",
 "eight-spot": "ثمانية (واحدة من أوراق اللعب الأربع في الحزمة التي تحمل ثماني نقاط على الوجه)",
 "eighteen": "ثَمَانِيَةَ عَشَرَ",
 "eighteenth": "ثَامِنَ عَشَرَ (العَدَد التَّرْتِيبِيّ 18) / الثامن عشر (المركز 18 في سلسلة معدودة من الأشياء)",
 "eighter": "ثَمَانِيَة, ثُمَانِيّ (العدد الأصلي الذي هو مجموع سبعة وواحد)",
 "eighter from decatur": "ثَمَانِيَة, ثُمَانِيّ (العدد الأصلي الذي هو مجموع سبعة وواحد)",
 "eightfold": "ثُمَانِيّ (ذو ثماني وحدات أو مكوّنات)",
 "eighth": "ثَامِن, ثَامِنَة / ثُمْن (ثمَّنَ السِّلْعَةَ: قدّر ثَمنَها؛ ثمَّنَ الشيءَ: جعل له ثمانية أركان)\nمثال: دفع زيري الثمن.",
 "eighth cranial nerve": "عصب دهليزي قوقعي, عصب سمعي (عصب حسي مركب يغذي الخلايا الشعرية للعضو الدهليزي والخلايا الشعرية للقوقعة)",
 "eighth note": "ذات السن, نوتة ثمنية (نوتة موسيقية لها قيمة زمنية تعادل ثمن نوتة كاملة)",
 "eighties": "الثمانينات (الفترة من العمر بين 80 و 90) / الثمانينات (1980), عقد 1980 (العقد من 1980 إلى 1989) / عقد 1880 (العقد من 1880 إلى 1889)",
 "eightieth": "اَلثَّمَانُونَ (العدد الترتيبي لثمانين في العدّ) / الثمانون (المركز 80 في سلسلة معدودة من الأشياء)",
 "eightpence": "ثمانية بنسات (عملة بقيمة ثمانية بنسات)",
 "eightpenny": "ثُمَانِيُّ الْبِنْس ((في قياس المسامير) بطول 2.5 بوصة أو 6.4 سم)",
 "eightpenny nail": "مسمار 2.5 بوصة (مسمار طوله 2.5 بوصة)",
 "eightsome": "رقصة الثمانية (رقصة ريل اسكتلندية لثمانية راقصين) / ثماني, مجموعة ثمانية (ثمانية أشخاص يُنظر إليهم كوحدة واحدة)",
 "eightvo": "قطع ثُماني (حجم كتاب تُصنع صفحاته بطي ورقة ثلاث مرات لتكوين ثماني ورقات)",
 "eighty": "ثَمَانِينَ, ثَمَانُونَ",
 "eighty-eight": "ثَمَانِيَة وَثَمَانُون",
 "eighty-fifth": "اَلْخَامِسُ وَالثَّمَانُونَ (العدد الترتيبي لخمسة وثمانين في العدّ)",
 "eighty-five": "خَمْسَة وَثَمَانُون (قيمة عددية تساوي \"٥\"؛ الرقم ما بعد \"أَرْبَعَة\" وقبل \"سِتَّة\")\nمثال: رأيت خمسة رجال.",
 "eighty-four": "أَرْبَعَة وَثَمَانُون (أَرْبِعَة؛ أربعَة)\nمثال: مرت أربعة أيام.",
 "eighty-nine": "تِسْعَة وَثَمَانُون",
 "eighty-one": "وَاحِد وَثَمَانُون (في وَ: العدد واحد العدد الاول)\nمثال: رأيت واحدة مرة.",
 "eighty-seven": "سَبْعَة وَثَمَانُون",
 "eighty-six": "سِتَّة وَثَمَانُون",
 "eighty-three": "ثَلَاثَة وَثَمَانُون (في هو أحد الأعداد الرياضية، وهو أصغر عدد فردي أولي)\nمثال: حملت ثلاثة كتب.",
 "eighty-two": "اِثْنَان وَثَمَانُون (في اِثْنان هو رقم مرتبته بين الواحد والثلاثة)\nمثال: واحد زائد اثنان يساوي ثلاثة.",
 "eilat": "إِيلَات, أُمّ الرَّشْرَاش",
 "eimeria": "إيميريا, كوكسيديا (طفيلية على الظهارة الهضمية للفقاريات واللافقاريات العليا)",
 "einstein": "أَيْنْشْتَايْن",
 "einstein's general theory of relativity": "النظرية النسبية العامة, نسبية عامة (تعميم للنسبية الخاصة لتشمل الجاذبية (بناءً على مبدأ التكافؤ))",
 "einstein's special theory of relativity": "النظرية النسبية الخاصة, نسبية خاصة (نظرية فيزيائية للنسبية تستند إلى افتراض أن سرعة الضوء في الفراغ ثابتة وافتراض أن قوانين الفيزياء ثابتة في جميع الأنظمة القصورية)",
 "einstein's theory of relativity": "نسبية, نظرية النسبية ((فيزياء) النظرية القائلة بأن المكان والزمان مفاهيم نسبية وليست مطلقة)",
 "einsteinian": "أينشتايني (من أو يتعلق بألبرت أينشتاين أو نظرياته)\nمثال: الكون الأينشتايني",
 "einsteinium": "أَيْنِشْتَيْنِيُوم",
 "eira barbara": "تايرا (عرسيات شجرية طويلة الذيل من أمريكا الوسطى والجنوبية)",
 "eisegesis": "إقحام, تفسير شخصي (تفسير شخصي لنص (خاصة الكتاب المقدس) باستخدام أفكارك الخاصة)",
 "eisteddfod": "إستيدفود, مهرجان ويلزي (أي من المهرجانات الويلزية السنوية التي تتضمن مسابقات فنية (خاصة في الغناء))",
 "eitchen midden": "تلة نفايات أثرية ((علم الآثار) كومة من النفايات المنزلية تحتوي على أصداف وعظام حيوانات تحدد موقع مستوطنة ما قبل التاريخ)",
 "either": "أَيْضًا, كَذٰلِكَ / إِمَّا ؛ إِمَّا",
 "either … or": "إِمَّا … أَوْ, يا ؛ يا",
 "ejaculate": "قَذَفَ الْمَنْي (بمعنى رَمَى؛ قذَف بالحقّ: أمر به وأبانه)",
 "ejaculation": "قَذْف (بمعنى رَمَى؛ قذَف بالحقّ: أمر به وأبانه)",
 "ejaculator": "صائح, هاتف (متحدث يطلق تعجبًا مفاجئًا) / قاذف (رجل يقذف السائل المنوي)",
 "ejaculatory duct": "قناة دافقة (جزء من القناة المنوية يتكون من القناة القادمة من الحويصلة المنوية والأسهر؛ تمر عبر غدة البروستاتا)",
 "eject": "قَذَفَ نَفْسَهُ (بمعنى رَمَى؛ قذَف بالحقّ: أمر به وأبانه)",
 "ejection": "إخراج, طرد (فعل الطرد أو القذف أو الإخراج) / إخراج, إقصاء (فعل إجبار شخص أو شيء على الخروج)\nمثال: طرد مثيري الشغب من قبل الشرطة",
 "ejection seat": "مقعد قذفي (مقعد الطيار في الطائرة الذي يمكن قذفه بقوة في حالة الطوارئ؛ ثم يهبط الطيار بالمظلة)",
 "ejective": "صوت قذفي (نوع من الصوامت في بعض اللغات، مثل الهوسا، يُنتج عن طريق الإطلاق المفاجئ للضغط من المزمار)",
 "ejective consonant": "صوت قذفي (نوع من الصوامت في بعض اللغات، مثل الهوسا، يُنتج عن طريق الإطلاق المفاجئ للضغط من المزمار)",
 "ejector": "لافظ الخرطوش (آلية في سلاح ناري تلفظ غلاف القذيفة الفارغ بعد الإطلاق) / طَارِد, مُقْصٍ (شخص يطرد شخصاً آخر أو يحل محله) / حاقن بخاري, ضاغط حراري (الحاقن أو اللافظ أو الحاقن البخاري أو المضخة النفاثة هو نوع من المضخات)\nمثال: بناءً على التطبيق المحدد، يمكن للحاقن أن يتخذ شكل مضخة نفاثة، أو قاذف مياه، أو قاذف تفريغ، أو قاذف بخار نفاث، أو شفاط",
 "ejector seat": "مقعد قذفي (مقعد الطيار في الطائرة الذي يمكن قذفه بقوة في حالة الطوارئ؛ ثم يهبط الطيار بالمظلة)",
 "ekbom syndrome": "متلازمة تململ الساقين (شعور بعدم الارتياح والأرق في الساقين بعد الذهاب إلى الفراش (مما يسبب الأرق أحياناً)؛ قد يخف مؤقتاً بالمشي أو تحريك الساقين)",
 "ekg": "تخطيط القلب, مخطط كهربية القلب (تسجيل بياني للدورة القلبية ينتجه جهاز تخطيط كهربية القلب)",
 "el": "إِل",
 "el alamein": "اَلْعَلَمَيْن",
 "el clásico": "اَلْكْلَاسِيكُو",
 "el dorado": "إلدورادو (مكان خيالي للثروة العظيمة والفرص؛ بحث عنه المستكشفون في القرن السادس عشر في أمريكا الجنوبية)",
 "el nino": "النينيو ((في علم المحيطات) تيار محيطي دافئ يتدفق على طول خط الاستواء من خط التاريخ والجنوب قبالة ساحل الإكوادور في وقت عيد الميلاد)",
 "el nino southern oscillation": "تذبذب النينيو الجنوبي (نينيو أكثر كثافة يحدث كل بضع سنوات عندما لا يحدث تدفق المياه الباردة الغنية بالمغذيات؛ مما يقتل العوالق والأسماك ويؤثر على أنماط الطقس)",
 "el paso": "إِلْ بَاسُو",
 "el salvador": "السَّلْفَادُور",
 "el salvadoran colon": "كولون, كولون سلفادوري (وحدة المال الأساسية في السلفادور؛ تساوي 100 سنتافو)",
 "el salvadoran monetary unit": "وحدة نقدية سلفادورية (الوحدة النقدية في السلفادور)",
 "elaborate": "مُفَصَّل",
 "elaborated": "مُتْقَن, مُفَصَّل (مُنَفَّذ بِعِنَايَة وبِتَفَاصِيل دَقِيقَة)",
 "elaborately": "بإسهاب, بتفصيل\nمثال: تم توضيحه بإسهاب",
 "elaborateness": "تزيين مفرط, زخرفة (مظهر مزخرف؛ كونه مزخرفاً بشكل متقن (حتى بشكل مفرط)) / تَعْقِيد دَقِيق, تَفْصِيل (يتميز بتفاصيل معقدة ومتقنة)",
 "elaboration": "إسهاب, بلورة (التطوير بتفاصيل معقدة ومضنية) / تفصيل, توضيح (إضافة مواد إضافية أو توضيح أو تفاصيل شارحة) / تَعْقِيد دَقِيق, تَفْصِيل (يتميز بتفاصيل معقدة ومتقنة) / توسع, توضيح (مناقشة تقدم معلومات إضافية)\nمثال: بضع ملاحظات أضيفت كتوضيح ودفاع",
 "elaeagnus augustifolia": "توت فضي, زيتون روسي (شجرة شجيرية متساقطة الأوراق من أوروبا وغرب آسيا لها أوراق رمادية وثمار صفراء صغيرة مغطاة بقشور فضية؛ شوكية أحياناً)",
 "elaeagnus commutata": "توت فضي, شجيرة فضية (شجيرة أمريكية شمالية متساقطة الأوراق غير شوكية بأوراق وثمار فضية)",
 "elaeagnus latifolia": "زيتون بري (شجيرة قائمة أو متسلقة من الهند والصين بثمار حمراء تشبه الزيتون)",
 "elaeis guineensis": "نخيل الزيت الأفريقي (نخيل الزيت من أفريقيا)",
 "elaeis oleifera": "نخيل الزيت الأمريكي (نخيل من أمريكا الوسطى والجنوبية)",
 "elaeocarpus grandis": "تين أزرق, شجرة الكواندونج (شجرة أسترالية ذات خشب أبيض صلب وأوراق خضراء لامعة مع أزهار بيضاء تليها ثمرة زرقاء لامعة ذات بذرة واحدة)",
 "elaeostearic acid": "حمض إليوستيريك (حمض دهني بلوري غير مشبع)",
 "elagabalus": "إِيل جَبَل",
 "elagatis bipinnulata": "العداء قوس قزح (سمكة جاك انسيابية على شكل سيجار؛ سمكة صيد جيدة)",
 "elaidic acid": "حمض الإيلايديك (حمض دهني أحادي غير مشبع له نفس بنية حمض الأوليك إلا أنه حمض دهني متحول؛ الحمض الدهني المتحول الرئيسي في المارجرين والأطعمة المقلية)",
 "elam": "عِيلَام",
 "elamite": "العيلامية (لغة قديمة منقرضة ذات صلات غير معروفة؛ كان يتحدث بها العيلاميون) / عيلامي (عضو في شعب حربي قديم عاش في عيلام شرق بابل منذ 3000 قبل الميلاد)",
 "elamite language": "العيلامية (لغة قديمة منقرضة ذات صلات غير معروفة؛ كان يتحدث بها العيلاميون)",
 "elamitic": "العيلامية (لغة قديمة منقرضة ذات صلات غير معروفة؛ كان يتحدث بها العيلاميون)",
 "elamitic language": "العيلامية (لغة قديمة منقرضة ذات صلات غير معروفة؛ كان يتحدث بها العيلاميون)",
 "elan": "انطلاق, حماس (قوة وحيوية متحمسة وواثقة) / أُسْلُوب مُمَيَّز, تَأَلُّق (أناقة مميزة وعصرية) / اتقاد, اندفاع (شعور بتوق قوي (عادة لصالح شخص أو قضية))\nمثال: أداء ذو انطلاق وتطور كبيرين",
 "elan vital": "طاقة حيوية, قوة حيوية ((في علم الأحياء) قوة افتراضية (ليست فيزيائية أو كيميائية) كان يعتقد هنري برجسون أنها تسبب تطور ونمو الكائنات الحية)",
 "eland": "عَلَنْد",
 "elanoides forficatus": "حدأة خطافية الذيل (حدأة رشيقة سوداء وبيضاء من أمريكا الشمالية)",
 "elanus leucurus": "حدأة بيضاء الذيل (حدأة أمريكية رمادية وبيضاء من المناطق الدافئة والاستوائية)",
 "elaphe guttata": "ثعبان الجرذ الأحمر, ثعبان الذرة (ثعبان كبير غير سام من جنوب شرق الولايات المتحدة؛ غالباً ما يوجد في المزارع)",
 "elaphe obsoleta": "ثعبان أسود, ثعبان الجرذ الأسود (ثعبان أسود لامع كبير غير سام من أمريكا الشمالية)",
 "elaphure": "أيل الأب دافيد (أيل صيني كبير يعيش فقط في قطعان مستأنسة)",
 "elaphurus davidianus": "أيل الأب دافيد (أيل صيني كبير يعيش فقط في قطعان مستأنسة)",
 "elapid": "أفعى عربيدة (أي من الثعابين السامة ذات الأنياب العديدة في الأجزاء الأكثر دفئاً من كلا نصفي الكرة الأرضية)",
 "elapid snake": "أفعى عربيدة (أي من الثعابين السامة ذات الأنياب العديدة في الأجزاء الأكثر دفئاً من كلا نصفي الكرة الأرضية)",
 "elapse": "مَرَّ (فَاتَ ومَضَى؛ الحدثُ أو الأمرُ: حدث وانتهى)\nمثال: مر زيري بجانبي.",
 "elapsed": "فائت, منقض ((عن الوقت) الذي مر أو انقضى)\nمثال: الوقت المنقضي",
 "elapsed time": "الوقت المنقضي (الوقت الذي يمر أثناء حدوث حدث ما)",
 "elasmobranch": "أسماك غضروفية, صفيحية الخياشيم (أي من الأسماك العديدة من طائفة الأسماك الغضروفية التي تتميز بهيكل غضروفي وحراشف درعية: أسماك القرش، الشفنينيات، الزلاجات)",
 "elastance": "إلاستانس, مرونة كهربائية (قدرة عازل كهربائي على مقاومة شحنة كهربائية)",
 "elastance unit": "وحدة مرانة (مقلوب السعة الكهربائية)",
 "elastase": "إيلاستاز (إنزيم بنكرياسي يحفز التحلل المائي للإيلاستين)",
 "elastic": "مَرِن",
 "elastic band": "شريط مطاطي (شريط ضيق من المطاط المرن يستخدم لتثبيت الأشياء (مثل الأوراق) معاً)",
 "elastic bandage": "رباط ضاغط مرن (ضمادة تحتوي على مادة قابلة للتمدد يمكنها تطبيق ضغط موضعي)",
 "elastic demand": "طلب مرن (الطلب الذي يزيد أو ينقص مع انخفاض أو زيادة سعر السلعة أو الخدمة)",
 "elastic device": "أداة مرنة, جهاز مرن (أي جهاز مرن يعود إلى شكله الأصلي عند تمدده)",
 "elastic energy": "طاقة كامنة مرنة, طاقة مرنة (طاقة كامنة مخزنة عندما يتشوه جسم (كما في نابض ملفوف))",
 "elastic modulus": "مُعَامِل الْمُرُونَة, مِعْيَار الْمُرُونَة ((في الفيزياء) نسبة الإجهاد المطبق إلى التغير في شكل جسم مرن)",
 "elastic potential energy": "طاقة كامنة مرنة, طاقة مرنة (طاقة كامنة مخزنة عندما يتشوه جسم (كما في نابض ملفوف))",
 "elastic tissue": "نسيج مرن (نسيج ضام يتكون بشكل رئيسي من ألياف مرنة يوجد في أدمة الجلد وجدران الأوردة والشرايين وفي بعض الأوتار والأربطة)",
 "elasticised": "مُطَعَّمٌ بِالمَطَّاط (مصنوع بخيوط أو شرائط مطّاطية)",
 "elasticity": "مرونة (ميل الجسم للعودة إلى شكله الأصلي بعد تمدده أو ضغطه)\nمثال: فقد حزام الخصر مرونته",
 "elasticity of shear": "مرونة القص (مرونة جسم تم سحبه خارج الشكل بواسطة قوة قص)",
 "elasticized": "مُطَعَّمٌ بِالمَطَّاط (مصنوع بخيوط أو شرائط مطّاطية)",
 "elastin": "إيلاستين (بروتين ليفي صلب يوجد في الأنسجة المرنة مثل جدران الشرايين)",
 "elastomer": "إلاستومر, مطاط صناعي (أي من المواد المرنة المختلفة التي تشبه المطاط (تستعيد شكلها الأصلي عند إزالة القوة المشوهة))",
 "elastoplast": "إيلاستوبلاست (ضمادة لاصقة مرنة لتغطية الجروح)",
 "elastosis": "تنكس مرن, داء المرنة (انهيار الأنسجة المرنة (مثل فقدان مرونة الجلد لدى كبار السن الناتج عن تنكس النسيج الضام))",
 "elated": "مبتهج, مسرور جداً (فخور ومسرور بانتشاء؛ في معنويات عالية) / فَرِح, مُبْتَهِج (مليء ببهجة نشيطة ومرحة)\nمثال: الفائز المبتهج",
 "elater": "خنفساء مطقطقة (أي من الخنافس المتنوعة واسعة الانتشار)",
 "elaterid": "خنفساء مطقطقة (أي من الخنافس المتنوعة واسعة الانتشار)",
 "elaterid beetle": "خنفساء مطقطقة (أي من الخنافس المتنوعة واسعة الانتشار)",
 "elating": "مُبْهِج, مُنْعِش (يُضفي الحيوية والبهجة)",
 "elation": "ابتهاج, زهو (شعور بالفرح والفخر) / ابتهاج, جذل (حالة نفسية مبهجة من الفخر والتفاؤل؛ غياب الاكتئاب)",
 "elative": "اِسْم تَفْضِيل (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)\nمثال: ما اسم حصان توم؟",
 "elavil": "أميتريبتيلين, إيلافيل (دواء مضاد للاكتئاب ثلاثي الحلقات (الاسم التجاري إيلافيل) له آثار جانبية خطيرة؛ يتفاعل مع العديد من الأدوية الأخرى)",
 "elbe": "إلبه",
 "elbow": "كُوع, مِرْفَق / كُوعٌ",
 "elbow bone": "زند, عظم الزند (العظم الداخلي والأطول من بين عظمتي الساعد البشري)",
 "elbow grease": "جهد, عناء (استخدام الطاقة البدنية أو العقلية؛ العمل الشاق)\nمثال: حصل على درجة امتياز لجهده",
 "elbow joint": "مرفق, مفصل المرفق (مفصل رزي بين الساعد والعضد والمفصل المقابل في الطرف الأمامي لذوات الأربع)",
 "elbow pad": "واقي كوع (ملابس واقية تتكون من وسادة تلبس فوق الكوع من قبل لاعبي كرة القدم والهوكي)",
 "elbow room": "مَجَال, مَسَاحَة (حيز للحركة)\nمثال: مجال للمرور",
 "elbowing": "دفع بالمرفق (التدافع باستخدام المرافق)\nمثال: الدفع بالمرفق مخالفة في كرة السلة",
 "elbrus": "إِلْبْرُوز",
 "eld": "سن, عمر (وقت من الحياة (يحدد عادة بالسنوات) ينشأ فيه مؤهل أو قدرة معينة) / أرذل العمر, شيخوخة (مرحلة متأخرة من الحياة)\nمثال: هي الآن في سن المدرسة",
 "elder": "كَابِر / بَيْلَسَان (زهره بيضاء ذات رائحه عطريه جميله) / خَمَان",
 "elder hand": "اللاعب الأول, اليد الكبرى (لاعب الورق الموجود على يسار الموزع)",
 "elder statesman": "رجل دولة مخضرم (رجل دولة مسن يطلب قادة الحكومة نصيحته) / رجل محترم, كبير القوم (رجل تحظى نصيحته باحترام كبير)",
 "elder stateswoman": "حكيمة الدولة, سياسية مخضرمة (امرأة تحظى نصيحتها باحترام كبير) / سياسية مخضرمة (سياسية مسنة يُطلب رأيها من قبل قادة الحكومة)",
 "elderberry": "بَيْلَسَان (زهره بيضاء ذات رائحه عطريه جميله)",
 "elderberry bush": "خمان, شجيرة البلسان (أي من الشجيرات العديدة أو الأشجار الصغيرة في المناطق المعتدلة وشبه الاستوائية في نصف الكرة الشمالي، لها زهور بيضاء وثمار تشبه التوت)",
 "elderly": "مُسِنّ, مُسِنَّة",
 "eldership": "مشيخة (منصب الشيخ (في سياق ديني أو اجتماعي))",
 "eldest": "أَكْبَر, بِكْر (الأَوَّلُ فِي تَرْتِيبِ الوِلَادَةِ) / أكبر الأبناء, بكر (النسل الذي جاء أولاً في ترتيب الولادة)",
 "eldest hand": "اللاعب الأول, اليد الكبرى (لاعب الورق الموجود على يسار الموزع)",
 "eldorado": "إلدورادو (مكان خيالي للثروة العظيمة والفرص؛ بحث عنه المستكشفون في القرن السادس عشر في أمريكا الجنوبية)",
 "eldritch": "خَارِق, غَرِيب (يوحي بعمل قوى خارقة للطبيعة)",
 "eleanor": "نُورَة",
 "eleaticism": "إيلية (واحدة من المدارس الرئيسية لفلسفة ما قبل سقراط القديمة، سميت بذلك نسبة إلى مقرها في المستعمرة اليونانية إيليا في جنوب إيطاليا)",
 "eleazar": "الْعَيْزَار",
 "elecampane": "رَاسَن, عِرْق الْجَنَاح",
 "elect": "اِنْتَخَبَ (اخْتَارَهُ وانتقاه؛ اخْتَارَهُ بإعطائه صَوته فِي الانتخاب)\nمثال: عام 1999، انتخب عبد العزيز بوتفليقة رئيسا جديدا للجزائر.",
 "elected": "انتخابي, منتخب (خاضع لانتخاب شعبي)\nمثال: مسؤول منتخب",
 "elected official": "مسؤول منتخب (مسؤول فاز بالمنصب في انتخابات حرة)",
 "election": "اِنْتِخَاب, اِنْتِخَابَات",
 "election commission": "لجنة الانتخابات (لجنة مفوضة للإشراف على الانتخابات)",
 "election day": "يوم الاقتراع, يوم الانتخابات (اليوم المحدد للانتخابات؛ في الولايات المتحدة هو أول ثلاثاء بعد أول اثنين في نوفمبر)",
 "election district": "دائرة انتخابية, منطقة اقتراع (واحدة من عدة مناطق تُقسَّم إليها المدينة أو البلدة من أجل التصويت؛ وتحتوي كل منها على مركز اقتراع واحد)",
 "election fraud": "تزوير الانتخابات (تحريف أو تغيير النتائج الحقيقية للانتخابات)",
 "election threshold": "العتبة الانتخابية, عتبة الحسم (الحد الأدنى من حصة الأصوات التي يتطلبها حزب سياسي لتأمين أي تمثيل)\nمثال: حصل الحزب الديمقراطي الحر على 4.8% فقط من الأصوات لذلك لم يستوف العتبة الانتخابية البالغة 5% ولم يفز بأي مقاعد منتخبة مباشرة",
 "electioneering": "حملة انتخابية (حملة المرشح ليتم انتخابه) / حشد الأصوات, دعاية انتخابية (إقناع الناخبين في حملة سياسية)",
 "elective": "انتخابي, منتخب (خاضع لانتخاب شعبي) / اخْتِيَارِيّ (غير إجباري؛ يُمكن اختياره بحرّية) / مادة اختيارية, مقرر اختياري (دورة يمكن للطالب اختيارها من بين البدائل)\nمثال: مسؤول منتخب",
 "elective course": "مادة اختيارية, مقرر اختياري (دورة يمكن للطالب اختيارها من بين البدائل)",
 "electiveness": "اختيارية (الجودة أو الحالة التي يُسمح فيها بالاختيار أو التصرف)\nمثال: تستلزم الاختيارية المعتادة لهذه المهام خطر عدم قيام الطلاب بإنجازها بطريقة فعالة",
 "elector": "نَاخِب / نَاخِبَة",
 "electoral": "انْتِخَابِيّ (يتعلّق بالناخبين أو يتألّف منهم) / انتخابي (مكون من أو متعلق بالانتخابات)\nمثال: عملية انتخابية",
 "electoral college": "مجمع انتخابي (هيئة الناخبين الذين ينتخبون رسمياً رئيس الولايات المتحدة ونائب الرئيس)",
 "electoral system": "نظام التصويت, نظام انتخابي (نظام قانوني لاتخاذ خيارات ديمقراطية)",
 "electorate": "الهيئة الناخبة, ناخبون (هيئة المواطنين الذين يحق لهم التصويت)",
 "electra complex": "عقدة إليكترا (عقدة لدى الإناث؛ الانجذاب الجنسي للأب)",
 "electric": "كَهْرَبَائِيّ, كَهْرُبَائِيّ",
 "electric arc": "تفريغ, قوس كهربائي (توصيل كهربائي عبر غاز في مجال كهربائي مطبق)",
 "electric automobile": "سيارة كهربائية (سيارة تعمل بالكهرباء)",
 "electric baking pan": "صينية خبز كهربائية (صينية خبز متعددة الوظائف تستخدم للشواء، والفطائر، والترتيلا، وقلي السمك، وشواء الروبيان، إلخ)",
 "electric battery": "بطارية, بطارية كهربائية (جهاز ينتج الكهرباء؛ قد يحتوي على عدة خلايا أولية أو ثانوية مرتبة على التوازي أو التوالي)",
 "electric bell": "جرس كهربائي (جرس يتم تفعيله بواسطة التأثير المغناطيسي لتيار كهربائي)",
 "electric bill": "فاتورة الكهرباء (فاتورة بالأموال المستحقة مقابل الكهرباء المستهلكة)",
 "electric blanket": "بطانية كهربائية (بطانية تحتوي على عنصر تسخين كهربائي يمكن التحكم فيه للوصول لدرجة الحرارة المطلوبة)",
 "electric burn": "حرق كهربائي (حرق ناتج عن الحرارة المتولدة عن تيار كهربائي)",
 "electric car": "سَيَّارَة كَهْرَبَائِيَّة (مؤنث سَيَّار، صفة للكثير السَيْر؛ القَافِلَة أوالقَوْم الذين يسيرون)\nمثال: إنه يملك سيارة.",
 "electric catfish": "رعاد, سلور كهربائي (سلور مياه عذبة في النيل ووسط أفريقيا الاستوائية يمتلك عضواً كهربائياً)",
 "electric cell": "خلية, خلية كهربائية (جهاز يوصل تياراً كهربائياً نتيجة لتفاعل كيميائي)",
 "electric chair": "كُرْسِيّ كَهْرَبَائِيّ (مَقْعَد لواحد؛ العِلْم. يقال هو من أهل الكُرسِيّ أي أهل العِلم)\nمثال: أحب ذاك الكرسي.",
 "electric charge": "شِحْنَة كَهْرَبَائِيَّة",
 "electric circuit": "دَارَة كَهْرَبَائِيَّة (لا جمع له)",
 "electric clock": "ساعة كهربائية (ساعة تستخدم محركاً كهربائيًا صغيراً)",
 "electric company": "شركة طاقة, شركة كهرباء (مرفق عام يوفر الكهرباء)",
 "electric cord": "سلك كهربائي (موصل معزول خفيف للاستخدام المنزلي)",
 "electric current": "تَيَّار كَهْرَبَائِيّ / تَيَّار كَهْرُبَائِيّ",
 "electric dipole": "ثنائي قطب كهربائي (ثنائي قطب بشحنات كهربائية متساوية ومتضادة)",
 "electric dipole moment": "عزم ثنائي القطب الكهربائي (عزم ثنائي القطب في ثنائي قطب كهربائي)",
 "electric discharge": "تفريغ, قوس كهربائي (توصيل كهربائي عبر غاز في مجال كهربائي مطبق)",
 "electric doublet": "ثنائي قطب كهربائي (ثنائي قطب بشحنات كهربائية متساوية ومتضادة)",
 "electric drill": "دريل كهربائي, مقدح كهربائي (مقدح آلي دوار يعمل بمحرك كهربائي)",
 "electric eel": "أنقليس رعاد, أنقليس كهربائي (سمكة مياه عذبة تشبه الثعبان تعيش في أمريكا الجنوبية ولها أعضاء كهربائية في جسمها)",
 "electric energy": "طاقة كهربائية (كامنة) ((في الفيزياء) الطاقة الكامنة لشحنة كهربائية في مجال كهربائي، أو لتيار كهربائي في مجال مغناطيسي)",
 "electric eye": "خلية كهروضوئية (محول طاقة يستخدم للكشف عن الضوء والإشعاعات الأخرى وقياسها)",
 "electric fan": "مروحة كهربائية (مروحة تعمل بمحرك كهربائي)",
 "electric field": "حقل كهربائي (ذهب أو حدث بسرعة أو دون توقف؛ في بعض اللهجات: تعني تحرك سريعاً أو اهتزّ)\nمثال: يعمل الفلاحون في الحقل.",
 "electric fire": "مدفأة كهربائية (سخان مساحة كهربائي صغير)",
 "electric frying pan": "مقلاة كهربائية (مقلاة تسخن بالكهرباء)",
 "electric furnace": "فرن كهربائي (أي فرن يتم توفير الحرارة فيه بواسطة تيار كهربائي)",
 "electric glow": "تفريغ هالي, نار سانت إلمو (تفريغ كهربائي مصحوب بتأين الغلاف الجوي المحيط)",
 "electric guitar": "جيتار كهربائي (جيتار يتم تضخيم صوته بوسائل كهربائية)",
 "electric hammer": "مطرقة كهربائية (مطرقة تعمل بمحرك كهربائي)",
 "electric healing": "علاج كهربائي (التطبيق العلاجي للكهرباء على الجسم (كما في علاج أشكال مختلفة من الشلل))",
 "electric heater": "مدفأة كهربائية (سخان مساحة كهربائي صغير)",
 "electric iron": "مكواة كهربائية (مكواة تستخدم التسهين المقاوم الناتج عن تيار كهربائي)",
 "electric lamp": "مصباح كهربائي (مصباح يعمل بالكهرباء)",
 "electric light": "لمبة, مصباح كهربائي (مصباح كهربائي يتكون من غلاف زجاجي شفاف أو نصف شفاف يحتوي على فتيل سلكي (عادة من التنجستن) يبعث الضوء عند تسخينه بالكهرباء)",
 "electric locomotive": "قاطرة كهربائية (قاطرة تعمل بمحرك كهربائي)",
 "electric main": "خط كهرباء رئيسي, كابل رئيسي (خط رئيسي يوزع الكهرباء)",
