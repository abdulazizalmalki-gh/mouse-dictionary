 "east by north": "الشَّرْق المَائِل لِلشَّمَال, شَرْق لِشَمَال (نقطة البوصلة التي تقع شمال الشرق بنقطة واحدة)",
 "east by south": "الشَّرْق المَائِل لِلجَنُوب, شَرْق لِجَنُوب (نقطة البوصلة التي تقع جنوب الشرق بنقطة واحدة)",
 "east chadic": "التشادية الشرقية (مجموعة من اللغات التشادية يتم التحدث بها في تشاد)",
 "east china sea": "بَحْر الصِّين الشَّرْقِيّ (شَقّ الأرض؛ التَحَيُّر والبَهْت من الفزع أو من شدة العَطَش فنظر لا يقصد شيئا)\nمثال: هبطت على البحر.",
 "east german": "ألماني شرقي (يتعلق بألمانيا الشرقية أو يميزها) / ألماني شرقي (مواطن أو ساكن في جمهورية ألمانيا الشرقية السابقة)\nمثال: جواسيس ألمان شرقيون",
 "east germanic": "اللغات الجرمانية الشرقية (فرع منقرض من اللغات الجرمانية)",
 "east germanic language": "اللغات الجرمانية الشرقية (فرع منقرض من اللغات الجرمانية)",
 "east germany": "أَلْمَانِيَا الشَّرْقِيَّة (دولة أوروبية في وسط أوروبا)\nمثال: ستعجبك ألمانيا.",
 "east india company": "شركة الهند الشرقية (شركة إنجليزية تشكلت عام 1600 لتطوير التجارة مع المستعمرات البريطانية الجديدة في الهند وجنوب شرق آسيا؛ تولت السيطرة الإدارية على البنغال في القرن…)",
 "east india kino": "صمغ الكينو, كينو (عصير أو راتنج محمر أو أسود من أشجار معينة ويستخدم في الطب والدباغة)",
 "east india rosewood": "خشب أسود هندي, خشب الورد الهندي (شجرة من شرق الهند لها خشب أرجواني داكن مفيد)",
 "east indian": "شرق هندي (من أو يتعلق بجزر الهند الشرقية أو يقع فيها) / هندي شرقي (مواطن أو ساكن في جزر الهند الشرقية)",
 "east indian fig tree": "بانيان, تين هندي (شجرة من شرق الهند تخرج جذوراً هوائية تنمو لأسفل في التربة مشكلة جذوعاً إضافية)",
 "east indian rosebay": "تفاحة آدم, زهرة الطاحونة (شجيرة استوائية ذات أوراق لامعة وأزهار ليلية عطرة ذات تيجان مجعدة أو متموجة؛ من شمال الهند إلى تايلاند)",
 "east indian rosewood": "خشب أسود هندي, خشب الورد الهندي (شجرة من شرق الهند لها خشب أرجواني داكن مفيد)",
 "east jerusalem": "اَلْقُدْس اَلشَّرْقِيَّة, أُورُشَلِيم اَلشَّرْقِيَّة",
 "east midland": "شرق ميدلاند (لهجة الإنجليزية الوسطى التي حلت محل الساكسونية الغربية كلغة أدبية وتطورت إلى الإنجليزية الحديثة)",
 "east midlands": "ميدلاندز الشرقية",
 "east northeast": "الشَّرْق الشَّمَالِيّ الشَّرْقِيّ, شَرْق شَمَال شَرْق (نقطة البوصلة في منتصف المسافة بين الشمال الشرقي والشرق)",
 "east pakistani": "بنغلاديشي (من أو متعلق أو مميز لبنغلاديش أو شعبها أو لغتها)\nمثال: لهجات بنغلاديشية",
 "east siberian sea": "بَحْر سِيبِيرِيَا الشَّرْقِ (شَقّ الأرض؛ التَحَيُّر والبَهْت من الفزع أو من شدة العَطَش فنظر لا يقصد شيئا)\nمثال: هبطت على البحر.",
