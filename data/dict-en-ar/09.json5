 "enneagram": "إنياغرام (نموذج للشخصية البشرية يُفهم ويُدرس بشكل أساسي كنمط لتسعة أنواع شخصية مترابطة)",
 "ennoblement": "إعلاء الشأن, منح لقب نبيل (فعل رفع شخص ما إلى طبقة النبلاء) / شرف, نبل (حالة النبل)",
 "ennobling": "مُعَظِّم, مُمَجِّد (يميل إلى الرفعة والتعظيم) / مُعَزِّز لِلْكَرَامَة, مُوَقِّر (يمنح الكرامة أو الشرف)",
 "ennui": "سأم, ضجر (الشعور بالملل من شيء مضجر)",
 "enoch": "إِدْرِيس, أَخْنُوخ (في نبي ذُكر مرتين في القرآن، ويقال أنه أخْنُوخ المذكور في الكتاب المقدس. هو نبي مُعَمِّر، وقد جاهد في سبيل الله ضدّ أحفاد قابيل المفسدين؛ اِسْمُ عَلَمٍ مذكر من أصل سامي، ومعناه الظهور والوضوح، اشتهر الاسم من نبي الله إدريس ، وقيل سُمي به لغزارة علمه وكثرة دراسته)",
 "enol": "إينول (مركب عضوي يحتوي على مجموعة هيدروكسيل مرتبطة بذرة كربون ترتبط بدورها برابطة مزدوجة مع ذرة كربون أخرى)",
 "enolic": "إينولي (متعلق بالإينول أو يتكون منه)",
 "enologist": "أخصائي نبيذ (متخصص في صناعة النبيذ)",
 "enology": "علم صناعة النبيذ (فن صناعة النبيذ)",
 "enophile": "مُتَذَوِّق لِلنَّبِيذ, مُحِبّ لِلْخَمْر (شخص يقدر النبيذ ويستمتع به)",
 "enormity": "جرم عظيم, فداحة (عمل من أعمال الشر المدقع) / شناعة, فظاعة (صفة الشر المفرط أو الشناعة الكبيرة) / فظاعة (جودة كون الشيء فظيعاً) / جسامة, ضخامة (شساعة الحجم أو المدى)\nمثال: أدركت الجامعات ضخامة مهمتها",
 "enormous": "ضَخْم, هَائِل",
 "enormously": "بشدة, بشكل هائل (بدرجة كبيرة جداً)\nمثال: كان محبوباً بشكل هائل",
