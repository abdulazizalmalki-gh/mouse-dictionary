 "enkaid": "إنكايد, إنكاينيد (دواء مضاد لاضطراب النظم (الاسم التجاري إنكايد) يستخدم لعلاج عدم الانتظام المهدد للحياة ولكنه يزيد من خطر الموت المفاجئ لدى مرضى النوبات القلبية)",
 "enkephalin": "إنكيفالين (إندورفين له صفات أفيونية يحدث في الدماغ والحبل الشوكي وأماكن أخرى)",
 "enkindled": "مُضْرَم, مُوقَد (أُشعلت فيه النار)",
 "enl": "حمامي عقدة جذامية (مضاعفات التهابية للجذام تؤدي إلى آفات جلدية مؤلمة على الذراعين والساقين والوجه)",
 "enlarge": "كَبَّرَ (قَوْلُ 'الله أكْبَر'؛ أَحَدَ أَرْكَان الصَلاَة: كَبَّرَ المُصَلِّي)\nمثال: ما مدى كبر المسافة بين هنا وهناك؟",
 "enlarged": "متضخم ((عن عضو أو جزء من الجسم) متضخم بشكل مفرط نتيجة لزيادة حجم الخلايا المكونة له) / مُضَخَّم, مُكَبَّر (مُكبَّر إلى درجة غير طبيعية) / مُتَضَخِّم (أكْبَر مِن الحَجْم الطَّبيعِيّ) / مُكَبَّر (كالصورة الفوتوغرافية؛ جُعل أكبر حجماً)\nمثال: ألياف عضلة القلب المتضخمة",
 "enlarged heart": "تضخم القلب (تضخم غير طبيعي للقلب)\nمثال: تضخم القلب الخفيف شائع لدى الرياضيين",
 "enlargement": "تَوْسِيع",
 "enlarger": "مكبر الصور (معدات تصوير فوتوغرافي تتكون من جهاز عرض بصري يستخدم لتكبير صورة فوتوغرافية)",
 "enlightened": "مستنير (لديه معرفة وبصيرة روحية) / مُسْتَنِير, وَاعٍ (يتّسم بالفهم الكامل للمسألة المطروحة) / عارفون, مطلعون (الناس الذين تم تعريفهم بأسرار مجال أو نشاط معين)\nمثال: إنه مألوف جداً للمطلعين",
 "enlightening": "تثقيفي, تنويري (تنويري أو رافع للمعنويات بما يشجع على التحسن الفكري أو الأخلاقي) / تثقيفي, تنويري (يميل لزيادة المعرفة أو تبديد الجهل)\nمثال: اللوحات في الكنيسة خدمت غرضاً تهذيبياً حتى لأولئك الذين لا يستطيعون القراءة",
 "enlightenment": "تَنْوِير",
 "enlisted man": "مجند (فرد ذكر مجند في القوات المسلحة)",
 "enlisted officer": "صف ضابط, ضابط صف (ضابط عسكري يتم تعيينه من المجندين)",
 "enlisted person": "جندي متطوع, مجند (جندي رتبته أقل من الضابط المكلف)",
 "enlisted woman": "مجندة (فرد أنثى مجندة في القوات المسلحة)",
 "enlistee": "متطوع, مُجنّد (أي عضو أو مؤيد جديد (كما في القوات المسلحة))",
 "enlisting": "تجنيد, توظيف (عملية الحصول على مجندين؛ إشراك الناس في الجيش (أو وظيفة أو قضية))",
 "enlistment": "تَجَنُّد, تَطَوُّع (فعل التطوع (كما في الخدمة العسكرية)) / فترة تجنيد, فترة خدمة (فترة زمنية تقضى في الخدمة العسكرية)",
 "enlivened": "مُفْعَم بِالحَيَاة, مُنْتَعِش (أُضفِيَت عليه الحيويّة والنشاط) / مُبْتَهِج, مُنْتَعِش (أصبح نشيطاً أو مبتهجاً)",
 "enlivener": "باعث للحيوية, مُحْيِي (عامل يعطي أو يعيد الحياة أو النشاط)\nمثال: الروح هي باعثة الحياة في الجسد",
