 "birth control pill": "حبوب منع الحمل (مانع حمل على شكل حبة تحتوي على الإستروجين والبروجستين لمنع الإباضة وبالتالي منع الحمل)",
 "birth defect": "تشوه خلقي, عيب خلقي (عيب موجود عند الولادة)",
 "birth pangs": "آلام المخاض (تشنج ألم متكرر بانتظام وهو سمة من سمات الولادة)",
 "birth prevention": "تحديد النسل, تنظيم الأسرة (الحد من عدد الأطفال المولودين)",
 "birth rate": "خُصُوبَة, مُعَدَّل المَوَالِيد (نسبة المواليد الأحياء في منطقة ما إلى سكان تلك المنطقة؛ يُعبر عنها لكل 1000 نسمة في السنة)",
 "birth trauma": "صدمة الولادة (إصابة عاطفية تلحق بالرضيع جراء أحداث مصاحبة للولادة، ويُزعم أنها تظهر بشكل رمزي لدى المرضى المصابين بأمراض عقلية) / إصابة الولادة, صدمة الولادة (إصابة جسدية للرضيع أثناء عملية الولادة)",
 "birth-control campaigner": "ناشِط لِتَحْدِيد النَّسْل (مصلح اجتماعي يدعو إلى تحديد النسل وتنظيم الأسرة)",
 "birth-control reformer": "ناشِط لِتَحْدِيد النَّسْل (مصلح اجتماعي يدعو إلى تحديد النسل وتنظيم الأسرة)",
 "birthday": "عِيد مِيلَاد / يَوْم مِيلَاد (فترة من الزمان تبدأ عند غُرُوب الشمس وتنتهي عند غُرُوب شمس النهار التالي ويشمل اللَيْلَة ونَهَارا. طوله أربع وعشرين سَاعَة؛ النَهَار، يبدأ من طلوع الفَجْر إلى غُرُوب الشَمس، على المجاز)\nمثال: طقس اليوم جميل.",
 "birthday cake": "كَعْكَة عِيد مِيلَاد (واحدة الكَعْك؛ حَلْوَى تُصْنع من الدَقِيق والحَلِيب والسُكَّر والزَيت ويخبز طريًا وقد يوضع عليه القِشْطَة. يُسمى عند البعض كَيْك وعند البعض تُورْتَة)\nمثال: خبزت كعكة لتوم.",
 "birthday card": "بطاقة عيد ميلاد (بطاقة تعبر عن تهنئة بعيد الميلاد)",
 "birthday gift": "هدية عيد ميلاد (هدية تُقدم احتفالاً بعيد ميلاد شخص)",
 "birthday party": "حَفْلَة عِيد مِيلَاد",
 "birthday present": "هدية عيد ميلاد (هدية تُقدم احتفالاً بعيد ميلاد شخص)",
 "birthday suit": "كما ولدتني أمي (تعبيرات غير رسمية للعري)",
 "birthing": "وضع, ولادة (عملية الولادة)",
 "birthing coach": "دولا, مدرب الولادة (مساعد (غالباً والد الطفل الذي سيولد قريباً) يقدم الدعم لامرأة في المخاض من خلال تشجيعها على استخدام التقنيات المستفادة في فصول التحضير للولادة)",
 "birthmark": "وَحْمَة",
 "birthplace": "مَكَان الْمِيلَاد, مَسْقَط الرَّأْس (مَوْضِع؛ المنزلة والشأن، يقال أيضا مكانة)\nمثال: هذا المكان مقدس",
 "birthrate": "خُصُوبَة, مُعَدَّل المَوَالِيد (نسبة المواليد الأحياء في منطقة ما إلى سكان تلك المنطقة؛ يُعبر عنها لكل 1000 نسمة في السنة)",
 "birthright": "حق المولد, حق فطري (حق أو امتياز يحق لك الحصول عليه عند الولادة) / حق المولد, ميراث الأجداد (ميراث يأتي بحكم حق المولد (خاصة عن طريق البكورة))\nمثال: التعليم العام المجاني هو حق فطري لكل طفل أمريكي",
 "birthroot": "تريليوم أحمر, تريليوم أرجواني (تريليوم من شرق أمريكا الشمالية له زهور وردية إلى أرجوانية كريهة الرائحة وجذر قابض يستخدم في الطب الشعبي خاصة لتسهيل الولادة)",
 "birthstone": "حجر البخت (حَجَرَ عليه الأمرَ:مَنَعَه منه ، حجر الشّيء على نفسه:خَصَّها به وقصره عليها؛ الحجْرُ: المَنْعُ مِن التَّصَرُّفِ ، وحَجَرَ عَلَيْهِ القاضِي يَحْجُرُ حَجْراً، إِذا مَنَعَه مِن التَّصَرُّفِ فِي مالِه)\nمثال: عوقب زيري بالحجر.",
 "birthwort": "زَرَاوَنْد",
 "birthyear": "سَنَةُ الْمِيلَادِ (مقدارُ قطع الشمس البروجَ الاثني عشر ، وهي السنة الشمسيَّة، و السَّنَةُ تمامُ اثنتَيْ عشرةَ دَورةً للقمر ، وهي السنة القمرية…)\nمثال: في عمره 24 سنة.",
 "biryani": "بِرْيَانِي (طعام يصنع من الرز المطبوخ بأنواع مختلفة من البُهَار وغالبا ما يكون حارّا ويطبخ معه الدجَاج وقد يستخدم البعض اللَحْم)",
 "birštonas": "بِيرْشْتُونَاس",
 "bisayan": "بيسايا, فيسايان (عضو في أكبر مجموعة من السكان الأصليين في الفلبين)",
 "biscuit": "بَسْكَوِيت, بِسْكْوِي",
 "biscutella laevigata": "خردل الترس (نبات من جنوب شرق أوروبا له أزهار صفراء مثل أزهار الخردل وقرون ذات صمامات مفتوحة تشبه التروس)",
 "bise": "الرياح الشمالية الباردة, بيز (رياح شمالية باردة وجافة في جنوب شرق فرنسا)",
 "bisection": "تنصيف (التقسيم إلى جزأين متساويين)",
