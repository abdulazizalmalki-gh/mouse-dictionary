 "branchiate": "خيشومي (مزود بخياشيم)\nمثال: شرغوف ذو خياشيم",
 "branching": "تشعب, تفرع (عملية التفرع أو الانقسام إلى فروع) / شَجَرِيُّ الشَّكْل, مُتَفَرِّع (يُشْبِهُ أَغْصَانَ الشَّجَرَةِ فِي تَفَرُّعِهِ) / ذُو فُرُوع, مُتَفَرِّع (لَهُ فُرُوعٌ أَوْ أَغْصَان)",
 "branchiopod": "غلصميات الأرجل (قشريات مائية لها عادة درقة والعديد من أزواج الزوائد التي تشبه الأوراق تستخدم للسباحة وكذلك للتنفس والتغذية) / خيشومي الأرجل, غلصمي الأرجل (من أو متعلق بـ أو من خصائص طويئفة غلصميات الأرجل)",
 "branchiopod crustacean": "غلصميات الأرجل (قشريات مائية لها عادة درقة والعديد من أزواج الزوائد التي تشبه الأوراق تستخدم للسباحة وكذلك للتنفس والتغذية)",
 "branchiopodan": "غلصميات الأرجل (قشريات مائية لها عادة درقة والعديد من أزواج الزوائد التي تشبه الأوراق تستخدم للسباحة وكذلك للتنفس والتغذية) / خيشومي الأرجل, غلصمي الأرجل (من أو متعلق بـ أو من خصائص طويئفة غلصميات الأرجل)",
 "branchiopodous": "خيشومي الأرجل, غلصمي الأرجل (من أو متعلق بـ أو من خصائص طويئفة غلصميات الأرجل)",
 "branchless": "عديم الأغصان, غير متفرع (ليس له فروع)",
 "branchlet": "غصين (فرع صغير أو انقسام لفرع (خاصة انقسام طرفي)؛ يطبق عادة على فروع السنة الحالية أو السابقة)",
 "branchy": "كثير الغصون, متفرع (له فروع كثيرة)\nمثال: جذع شجرة كثير التفرع",
 "brand": "عَلَامَة, شِعَار (سِمَةٌ أو أمارة أو شِعَار تُعرف به الأشياء؛ رَمْز) / مَارْكَة\nمثال: تحصلت على علامة أ.",
 "brand name": "اسم تجاري, علامة تجارية (اسم يُعطى لمنتج أو خدمة)",
 "brand-name drug": "دواء ذو علامة تجارية, دواء مسجل (دواء له اسم تجاري ومحمي ببراءة اختراع (يمكن إنتاجه وبيعه فقط من قبل الشركة التي تحمل براءة الاختراع))",
 "brand-new": "جَدِيد تَمَامًا, لَامِع (جديد بشكل لافت للنظر)",
 "brand-newness": "جدة تامة (خاصية كون الشيء جديداً جداً)",
 "branded": "ذُو عَلَامَة تِجَارِيَّة ((عن البضائع) موسوم بكلمة أو رمز مميز يدل على حقوق حصرية) / موسوم (معلم بعلامة (وسم))\nمثال: ماشية موسومة",
 "brandenburg": "براندنبورغ",
 "branding": "تشويه السمعة, وصم بالعار (فعل الوصم بالعار)",
 "branding iron": "مِيسَم",
 "brandish": "إشهار, تلويح (فعل التلويح)",
 "brandon": "بْرَانْدُون",
 "brandy": "بَرَانْدِي / بْرَانْدِي / كُونْيَاك",
 "brandy glass": "كأس براندي (كأس كروي ذو قمة صغيرة؛ يستخدم لتقديم البراندي)",
 "brandy nose": "فيمة الأنف (تضخم الأنف مع توسع الجريبات واحمرار وبروز الأوعية الدموية في الجلد)",
 "brandy sling": "سلينغ البراندي (سلينغ مصنوع بالبراندي)",
 "brandy snifter": "كأس براندي (كأس كروي ذو قمة صغيرة؛ يستخدم لتقديم البراندي)",
 "brandyball": "براندي بول (حلوى بريطانية بنكهة البراندي)",
 "brandysnap": "براندي سناب (بسكويت زنجبيل بنكهة البراندي)",
 "brant": "إوز أسود, برنت (إوز داكن صغير يتكاثر في الشمال ويهاجر جنوباً)",
 "brant goose": "إوز أسود, برنت (إوز داكن صغير يتكاثر في الشمال ويهاجر جنوباً)",
 "branta bernicla": "إوز برانت الشائع (أشهر أنواع إوز برانت)",
 "branta canadensis": "إوز كندي (إوز بري بني رمادي شائع في أمريكا الشمالية ذو نداء عالٍ يشبه البوق)",
 "branta leucopsis": "إوز البرنقيل (إوز أوروبي أصغر من الإوز الأسود؛ يتكاثر في أقصى الشمال)",
 "brasenia schreberi": "براسينيا, درع الماء (نبات مائي ذو أوراق بيضاوية طافية وأزهار أرجوانية؛ يوجد في البحيرات والجداول بطيئة الحركة؛ مناسب لأحواض السمك)",
 "brash": "قَلِيل الأَدَب, وَقِح (جريء بشكل مسيء وبذيء)",
 "brash oak": "بلوط عمودي (شجرة متساقطة الأوراق صغيرة من شرق ووسط الولايات المتحدة لها أوراق ريشية قيثارية خضراء داكنة وخشب قوي مقاوم للرطوبة يستخدم خاصة لأعمدة السياج)",
 "brashly": "بِوَقَاحَة (بطريقة وقحة وجريئة)\nمثال: بوقاحة، طلبت خصماً",
 "brashness": "اندفاع, رعونة (سمة كون المرء طائشاً ومتسرعاً) / بَهْرَجَة, زَخْرَفَة صَارِخَة (الاستعراض المبتذل عديم الذوق)",
 "brasier": "مجمرة, موقد فحم (وعاء معدني كبير يحرق فيه الفحم أو الفحم النباتي؛ يدفئ الأشخاص الذين يجب أن يبقوا في الخارج لفترات طويلة)",
 "brass": "شَبَه / صُفْر (الخَالِي كأنه تَصْفِر فيه الرِيح. ويقال أيضا صَفْر وصُفْر؛ في : هي عَدَد قيمته لا شيء، أو خالية) / صُفَّر (الخَالِي كأنه تَصْفِر فيه الرِيح. ويقال أيضا صَفْر وصُفْر؛ في : هي عَدَد قيمته لا شيء، أو خالية)\nمثال: بدأ سامي من نقطة الصفر.",
 "brass band": "فرقة نحاسية (مجموعة من الموسيقيين يعزفون فقط على الآلات النحاسية والإيقاعية)",
 "brass buttons": "أزرار نحاسية, كوتولا (عشب من جنوب أفريقيا ذو رؤوس زهور كروية صفراء ذهبية؛ توطن في المناطق الرطبة)",
 "brass family": "عائلة الآلات النحاسية ((موسيقى) عائلة الآلات النحاسية)",
 "brass hat": "ضابط كبير, كبار الضباط (ضابط عسكري رفيع المستوى)",
 "brass instrument": "آلة نحاسية, آلة نفخ نحاسية (آلة نفخ تتكون من أنبوب نحاسي (عادة ما يكون متغير الطول) يُنفخ فيه بواسطة قطعة فم على شكل كوب أو قمع)",
 "brass knuckles": "منافض مفصل",
 "brass knucks": "قبضة حديدية, ملاكمة حديدية ((تستخدم بصيغة الجمع) سلاح معدني صغير يُلبس فوق مفاصل أصابع اليد)",
 "brass monkey": "حامل قذائف (حامل معدني كان يُستخدم قديماً لحمل قذائف المدافع على السفن الشراعية)",
 "brass ring": "جائزة كبرى, فرصة ذهبية (فرصة غنية أو جائزة)\nمثال: فوت الفرصة الذهبية في مؤتمر ميامي",
 "brass section": "قسم الآلات النحاسية (قسم الفرقة أو الأوركسترا الذي يعزف على الآلات النحاسية)",
 "brassaia actinophylla": "شجرة المظلة, شفليرا (شجيرة دائمة الخضرة منتصبة أو شجرة صغيرة من أستراليا وشمال غينيا الجديدة ذات أوراق مركبة كفية)",
 "brassard": "درع الذراع (درع صفيحي يحمي الذراع)",
 "brassavola": "براسافولا (أي من بساتين الفاكهة الأمريكية الاستوائية المختلفة بأوراق لحمية وحيدة عادة وزهور بيضاء إلى خضراء مبهرجة عطرة ليلاً وحيدة أو في عناقيد تصل إلى 7)",
 "brassbound": "مُطَوَّق بِالنُّحَاس (ذو زخارف أو تجهيزات من النحاس الأصفر) / رَاسِخ, لَا يَتَزَعْزَع (مُتَجَذِّرٌ وَغَيْرُ قَابِلٍ لِلتَّغْيِيرِ بِأَيِّ شَكْلٍ)",
 "brasserie": "براسيري (مطعم صغير يقدم البيرة والنبيذ بالإضافة إلى الطعام؛ وعادة ما يكون رخيصاً)",
 "brassia lawrenceana": "أوركيد العنكبوت, براسيا لورانس (أوركيد أمريكي جنوبي بزهور صفراء شاحبة إلى خضراء شاحبة تشبه العنكبوت)",
 "brassia verrucosa": "أوركيد العنكبوت, براسيا ثؤلولية (أوركيد أمريكي أوسط ذو زهور تشبه العنكبوت بثآليل خضراء بارزة)",
 "brassica hirta": "خردل أبيض (خردل أوراسي يزرع لبذوره النفاذة؛ مصدر لخردل المائدة وزيت الخردل)",
 "brassica juncea": "خردل صيني, خردل هندي (خردل آسيوي يستخدم كعشب وعائي)",
 "brassica kaber": "خردل الحقل, خردل بري (نبات أوراسي ضار غالباً ما يكون آفة في حقول الحبوب)",
 "brassica napus": "سلجم, لفت زيتي (نبات أوراسي يزرع لبذوره وكمحصول علف)",
 "brassica napus napobrassica": "روتاباغا, لفت سويدي (نبات صليبي بجذر أصفر سميك بصلي صالح للأكل)",
 "brassica nigra": "خردل أسود (نبات حولي أوراسي واسع الانتشار يزرع لبذوره النفاذة؛ مصدر رئيسي لخردل المائدة)",
 "brassica oleracea": "كرنب بري, ملفوف بري (الأصل البري للملفوف المزروع؛ شائع في غرب أوروبا الساحلية) / كرنب, ملفوف (أي من الأصناف المختلفة لجنس الكرنب الزيتي التي تزرع لأوراقها أو أزهارها الصالحة للأكل)",
 "brassica oleracea acephala": "كايل, كرنب أجعد (كرنب قوي ذو أوراق مجعدة خشنة لا تشكل رأساً)",
 "brassica oleracea botrytis": "زهرة, قرنبيط (نبات له رأس كبير صالح للأكل من براعم الزهور البيضاء المزدحمة)",
 "brassica oleracea capitata": "كرنب, ملفوف الرأس (أي من نباتات الملفوف المزروعة المتنوعة التي لها ساق سميك قصير ورأس كبير مدمج من الأوراق الصالحة للأكل وعادة ما تكون خضراء)",
 "brassica oleracea gemmifera": "كرنب بروكسل, كرنب مسوق (نبات يزرع لسيقانه القوية ذات الرؤوس الخضراء الصغيرة الصالحة للأكل والتي تشبه ملفوفاً صغيراً)",
 "brassica oleracea gongylodes": "كرنب ساقي, كولرابي (نبات يزرع لساقه اللحمي المتضخم الصالح للأكل الذي يشبه اللفت)",
 "brassica oleracea italica": "بروكلي, قرنبيط أخضر (نبات ذو عناقيد كثيفة من براعم الزهور الخضراء الضيقة)",
 "brassica perviridis": "خردل السبانخ (نبات آسيوي يزرع لتاجه الجذري المنتفخ وأوراقه الصالحة للأكل)",
 "brassica rapa": "لفت, لفت أبيض (نبات يزرع على نطاق واسع له جذر أبيض أو أصفر لحمي كبير صالح للأكل)",
 "brassica rapa chinensis": "بوك تشوي, ملفوف صيني أبيض (نبات آسيوي يزرع لعنقوده من السيقان البيضاء الصالحة للأكل مع أوراق خضراء داكنة)",
 "brassica rapa pekinensis": "كرنب صيني, ملفوف صيني (نبات ذو رأس ممدود من أوراق عريضة معنقة تشبه الكرفس؛ يستخدم كخضروات في شرق آسيا)",
 "brassica rapa perviridis": "خردل السبانخ (نبات آسيوي يزرع لتاجه الجذري المنتفخ وأوراقه الصالحة للأكل)",
 "brassica rapa ruvo": "بروكلي راب (نبات يزرع لسيقانه الورقية الصالحة للأكل اللاذعة)",
 "brassie": "براسي, خشب 2",
 "brassiere": "حمالة صدر (رداء داخلي ترتديه النساء لدعم الثديين)",
 "brasslike": "نحاسي الصوت (يشبه صوت آلة نحاسية)",
 "brassy": "صَفِيق, وَقِح (لا يتقيّد بالأعراف أو اللياقة؛ جريء بشكل فظّ) / صَارِخ, مُبَهْرَج (بَرَّاقٌ وَلَافِتٌ بِطَرِيقَةٍ تَفْتَقِرُ إِلَى الذَّوْق) / نحاسي الصوت (يشبه صوت آلة نحاسية)",
 "brasília": "بْرَازِيلِيَا",
 "brat": "براتوورست (سجق خنزير صغير) / طفل شقي (طفل مزعج جداً)",
 "bratislava": "بُرَاتِسْلَافَا / بُرَاتِيسْلَافَا",
 "brattice": "حاجز تهوية (قاطع (غالباً ما يكون مؤقتاً) من الألواح أو القماش يستخدم للتحكم في التهوية في المنجم)",
 "brattiness": "سلوك شقي, شقاوه (حالة أو وضع التصرف كطفل شقي، كونه جامحاً وغير مهذب)\nمثال: الآباء لديهم قدرة أكبر على تحمل شقاوة أطفالهم",
 "brattish": "مُتَمَرِّد, مُشَاغِب ((يوصف به الطفل سيئ الأخلاق) جامح بطريقة غير مؤدبة)",
 "bratty": "مُتَمَرِّد, مُشَاغِب ((يوصف به الطفل سيئ الأخلاق) جامح بطريقة غير مؤدبة)",
 "bratwurst": "براتوورست (سجق خنزير صغير)",
 "braun's holly fern": "سرخس الدرع الشائك, سرخس بهشية براون (سرخس أمريكي شمالي سعفه الجلدي دائم الخضرة تقريباً مغطى بحراشف تشبه القش البني الشاحب)",
 "bravado": "تبجح, تهديد فارغ (تظاهر بالشجاعة بغطرسة)",
 "bravais lattice": "شبكة بلورية, شبكة فراغية (ترتيب هندسي ثلاثي الأبعاد للذرات أو الجزيئات أو الأيونات المكونة للبلورة)",
 "brave": "شُجَاع, جَرِيء (الثعبان)\nمثال: إنك شجاع للغاية.",
 "bravely": "بشجاعة (بطريقة شجاعة)\nمثال: دخل المنزل المحترق بشجاعة",
 "braveness": "بأس, جرأة (سمة روحية تمكنك من مواجهة الخطر أو الألم دون إظهار الخوف)",
 "bravery": "شَجَاعَة",
 "bravo": "بْرَافُو, بِرَافُو",
 "bravura": "أداء مبهر, براعة استعراضية (مهارة فنية رائعة واستعراضية)\nمثال: في استعراض أخير بدت راقصة الباليه وكأنها تطفو في الماء",
 "braw": "أَنِيق, زَاهٍ (ذو ألوان جميلة وأنيقة تلفت النظر)",
 "brawl": "شِجَار صَاخِب (قتال صاخب وسط حشد من الناس) / حفلة صاخبة (حفلة صاخبة أو مليئة بالضجيج والمرح)",
 "brawler": "مُشَاكِس",
 "brawn": "فتوة, قوة عضلية (امتلاك قوة عضلية)",
 "brawniness": "فتوة, قوة عضلية (امتلاك قوة عضلية)",
 "brawny": "قَوِيّ البُنْيَة, مَفْتُول العَضَلَات ((للشخص) يمتلك قوة بدنية ووزنًا؛ متين وجبار)",
 "braxton-hicks contraction": "انقباض براكستون هيكس, مخاض كاذب (انقباضات غير مؤلمة لعضلات الرحم تستمر طوال فترة الحمل بتواتر متزايد)",
 "bray": "رَغَى, هَدَر / نَهْقَة",
 "brazen": "صَفِيق, وَقِح (لا يتقيّد بالأعراف أو اللياقة؛ جريء بشكل فظّ) / نحاسي أصفر (مصنوع من النحاس الأصفر أو يشبهه (في اللون أو الصلابة))",
 "brazen bull": "ثَوْر بْرُونْزِيّ (حُمْرَة الشفق الثائرة فيه؛ الطُحْلُب وما أشبهه فوق الماء. سميّ كذلك لأنه يثور فجأة)\nمثال: حرث ما حرث الثور.",
 "brazen-faced": "صَفِيق, وَقِح (لا يتقيّد بالأعراف أو اللياقة؛ جريء بشكل فظّ)",
 "brazenly": "بجرأة, بوقاحة (بطريقة وقحة)\nمثال: تحدث بوقاحة",
 "brazenness": "صفاقة, وقاحة (سلوك يتسم بتحدٍ جريء للأعراف وافتقار للحياء)",
 "brazier": "مَجْمَرَة, مَنْقَل",
 "brazil": "الْبَرَازِيل",
 "brazil nut": "جَوْز الْبَرَازِيل (جَوَّز لَهُمْ إِبِلَهم إِذا قَادَهَا بَعِيرًا بَعِيرًا حَتَّى تَجُوزَ)\nمثال: نريد أن نأكل نبات جوز الهند.",
 "brazil-nut tree": "جوز برازيلي, شجرة الجوز البرازيلي (شجرة طويلة من أمريكا الجنوبية تحمل الجوز البرازيلي)",
 "brazilian": "بَرَازِيلِيّ",
 "brazilian guava": "جوافة برازيلية (شجرة من أمريكا الجنوبية لها ثمار تشبه الجوافة الحقيقية)",
 "brazilian ironwood": "خشب الحديد البرازيلي (شجرة عديمة الشوك تنتج خشباً ثقيلاً)",
 "brazilian monetary unit": "وحدة نقدية برازيلية (الوحدة النقدية في البرازيل)",
 "brazilian pepper tree": "شينوس تيربينثيفوليا, فلفل برازيلي (شجرة راتنجية صغيرة أو شجيرة من البرازيل)",
 "brazilian potato tree": "شجرة البطاطا (شجيرة أو شجرة صغيرة من أمريكا الجنوبية تزرع على نطاق واسع في المناطق الاستوائية؛ ليست بطاطا حقيقية)",
 "brazilian rosewood": "جاكاراندا, خشب الورد البرازيلي (شجرة أخشاب برازيلية مهمة تنتج خشباً ثقيلاً صلباً داكن اللون مخططاً بالأسود)",
 "brazilian trumpeter": "بواق برازيلي (بواق من البرازيل وغيانا؛ غالباً ما يُربى لحماية الدواجن في البرازيل)",
 "brazilian wandering spider": "عَنْكَبُوت بْرَازِيلِيّ جَوَّال",
 "brazilwood": "خشب البرازيل, خشب الخوخ (شجرة استوائية ذات جذع شائك؛ ينتج خشبها الأحمر الثقيل صبغة حمراء ويستخدم في صناعة الخزائن) / خشب البرازيل (خشب ثقيل لأشجار خشب البرازيل المختلفة؛ يستخدم لأقواس الكمان وكأخشاب صباغة)",
 "brazzaville": "بْرَازَافِيل / بِرَازَافِيل",
 "breach": "خَرْق (شَقَّ الثوب والقماش وما أشبه)\nمثال: لقد قام بخرق الاتفاق.",
 "breach of contract": "خرق العقد (شَقَّ الثوب والقماش وما أشبه)\nمثال: لقد قام بخرق الاتفاق.",
 "breach of duty": "إخلال بالواجب (خرق للعناية الواجبة)",
 "breach of promise": "نكث بالوعد (الفشل في الوفاء بوعد (الزواج))",
 "breach of the covenant of warranty": "إخلال بضمان الملكية (فشل ضمان البائع للملكية الجيدة)",
 "breach of the peace": "إقلاق الراحة العامة, سلوك مخل بالنظام العام (أي فعل من أفعال المضايقة أو المقاطعة أو الإعاقة أو الإثارة أو الحرمان من الراحة والهدوء الذي يحق للسكان التمتع به)",
 "breach of trust": "خيانة الأمانة (انتهاك (إما عن طريق الاحتيال أو الإهمال) من قبل وصي لواجب يفرضه عليه الانصاف)",
 "breach of trust with fraudulent intent": "خيانة الأمانة بنية الاحتيال (السرقة بعد الائتمان بدلاً من الأخذ غير المشروع)",
 "breach of warranty": "إخلال بالضمان (خرق يحدث عندما يكون العنصر ناقصاً وفقاً لشروط الضمان)",
 "bread": "خُبْز (هو طعام يصنع من الدَقِيق الذي يعجن بالماء والخَمِيرَة ويُخْبَز في الفُرْن أو التَنُّور؛ خُبْز الغُراب: الفِطْر، ويسمى أيضا عُشّ الغُرَاب) / عيش (مصدر للفعل عَاشَ؛ هو الحَيَاة) / خُبز (هو طعام يصنع من الدَقِيق الذي يعجن بالماء والخَمِيرَة ويُخْبَز في الفُرْن أو التَنُّور؛ خُبْز الغُراب: الفِطْر، ويسمى أيضا عُشّ الغُرَاب) / خبز (هو طعام يصنع من الدَقِيق الذي يعجن بالماء والخَمِيرَة ويُخْبَز في الفُرْن أو التَنُّور؛ خُبْز الغُراب: الفِطْر، ويسمى أيضا عُشّ الغُرَاب) / قرص / خَبَزَ (هو طعام يصنع من الدَقِيق الذي يعجن بالماء والخَمِيرَة ويُخْبَز في الفُرْن أو التَنُّور؛ خُبْز الغُراب: الفِطْر، ويسمى أيضا عُشّ الغُرَاب)\nمثال: هذا الخبز لذيذ.",
 "bread and butter": "قوت, مصدر رزق (الوسائل المالية التي يعيش بها المرء)\nمثال: لم يعد قادراً على كسب رزقه",
 "bread and butter pickle": "مخلل حلو ومالح (شرائح رقيقة من المخلل الحلو)",
 "bread board": "لوح تقطيع الخبز (لوح خشبي أو بلاستيكي يُعجن عليه العجين أو يُقطع عليه الخبز)",
 "bread dough": "عجين الخبز (أي من العجائن المختلفة للخبز)",
 "bread knife": "سكين الخبز (سكين يستخدم لقطع الخبز)",
 "bread line": "طابور الخبز, طابور المعونة (طابور من الناس ينتظرون طعاماً مجانياً)",
 "bread maker": "خباز (شخص يخبز الخبز أو الكعك)",
 "bread mold": "عفن الخبز (عفن من جنس ريزوبوس)",
 "bread roll": "كَعْكَة (واحدة الكَعْك؛ حَلْوَى تُصْنع من الدَقِيق والحَلِيب والسُكَّر والزَيت ويخبز طريًا وقد يوضع عليه القِشْطَة. يُسمى عند البعض كَيْك وعند البعض تُورْتَة)\nمثال: خبزت كعكة لتوم.",
 "bread sauce": "صلصة الخبز (صلصة بيضاء كريمية مصنوعة بالخبز بدلاً من الدقيق ومتبلة بالقرنفل والبصل)",
 "bread-and-butter issue": "قضية معيشية, مسألة اقتصادية (قضية ستؤثر تسويتها على الموارد المالية)",
 "bread-bin": "صندوق الخبز (حاوية تستخدم لحفظ الخبز أو الكعك)",
 "bread-stick": "إصبع خبز, بقسماط (لفافة مقرمشة على شكل عصا؛ تقدم غالباً مع الحساء)",
 "breadbasket": "سلة خبز (سلة لتقديم الخبز) / معدة (عضو كيسي عضلي متضخم في القناة الهضمية؛ العضو الرئيسي للهضم) / سلة الغذاء (منطقة جغرافية تعمل كمصدر رئيسي للحبوب)",
 "breadboard": "لوح تقطيع الخبز (لوح خشبي أو بلاستيكي يُعجن عليه العجين أو يُقطع عليه الخبز)",
 "breadbox": "صندوق الخبز (حاوية تستخدم لحفظ الخبز أو الكعك)",
 "breadcrumb": "بُقْسُمَاطْ",
 "breadcrust": "قِشْرَة",
 "breadfruit": "خُبْزِيَّة, شَجَرَة الخُبْز",
 "breadfruit tree": "شجرة الخبز, فاكهة الخبز (موطنها جزر المحيط الهادئ ولها فاكهة صالحة للأكل ذات قوام يشبه الخبز)",
 "breadline": "طابور الخبز, طابور المعونة (طابور من الناس ينتظرون طعاماً مجانياً)",
 "breadroot": "جذر الخبز, سوراليا (نبات معمر كثيف الشعر في وسط أمريكا الشمالية له جذور درنية صالحة للأكل)",
 "breadstick": "عُود الخُبْز (قطعة من الخشب كالعصا جمعه عيدان؛ ما يُتَبَخَّر به)\nمثال: أشعلت عود ثقاب.",
 "breadstuff": "دقيق الخبز, مادة الخبز (دقيق أو طحين أو حبوب تستخدم في خبز الخبز) / خبز (طعام مصنوع من عجين الدقيق أو الطحين وعادة ما يخمّر بالخميرة أو مسحوق الخبز ثم يخبز)",
 "breadth": "اتساع, عَرْض (مدى الشيء من جانب إلى آخر) / سعة أفق, شمولية (القدرة على فهم مجموعة واسعة من المواضيع)\nمثال: يجب أن يكون لدى المعلم شمولية في المعرفة بالمادة",
 "breadth index": "المُؤَشِّر الرَّأْسِيّ (نسبة (بالنسبة المئوية) أقصى عرض للجمجمة إلى أقصى طول لها)",
 "breadthways": "عَرْضًا (في اتجاه العرض)\nمثال: قص القماش عرضاً",
 "breadthwise": "عَرْضًا (في اتجاه العرض)\nمثال: قص القماش عرضاً",
 "breadwinner": "مُعِيل, عَائِل",
 "break": "اِنْكَسَرَ (فعل مطاوعة لكَسَرَ، قام أحدهم بكَسْره أو قام هو بكَسْر نفسه؛ التاجر: خَسِرَ المال ونَقَصَ عنده المال، أفْلَسَ) / كَسَرَ / اِسْتِرَاحَة (مبنى خارج المدن يتوقف فيه المسافرون للراحة والتَزَوُّد يُجمع على اِسْتِرَاحَات)\nمثال: عليك أخذ استراحة.",
 "break dance": "بريك دانس, رقص البريك (شكل من أشكال الرقص الفردي يتضمن حركات بهلوانية سريعة تلمس فيها أجزاء مختلفة من الجسم الأرض؛ يُؤدى عادة على إيقاع موسيقى الراب)",
 "break dancing": "بريك دانس, رقص البريك (شكل من أشكال الرقص الفردي يتضمن حركات بهلوانية سريعة تلمس فيها أجزاء مختلفة من الجسم الأرض؛ يُؤدى عادة على إيقاع موسيقى الراب)",
 "break of day": "بزوغ الفجر, شروق (ضوء النهار الأول)\nمثال: استيقظنا قبل الفجر",
 "break of serve": "كسر الإرسال ((تنس) الفوز بشوط عندما يكون الخصم هو المرسل)\nمثال: كان متقدماً بكسرين للإرسال في المجموعة الثانية",
 "break of the day": "بزوغ الفجر, شروق (ضوء النهار الأول)\nمثال: استيقظنا قبل الفجر",
 "break one's fast": "أَفْطَرَ (تَنَاوَلَ طَعَامَ الصَّبَاح؛ قَطَعَ صِيَامَه بِتَنَاوُل الطَّعَام)\nمثال: أنا دائما أرتدي الملابس قبل أن أفطر.",
 "break out": "اِنْدَلَعَ",
 "break ranks": "انْشَقَّ",
 "break seal": "ختم الكسر (ختم يجب كسره عند الاستخدام الأول ولا يمكن إعادة ختمه بسهولة)\nمثال: تم تخزينه في أنبوب بختم كسر",
 "break someone's heart": "فطر القلب, فطر الفؤاد ( مَا تَفَطَّر مِنَ النَّبَاتِ، والفُطْر جِنْسٌ مِنَ الكَمْءِ أَبيض عِظَامٌ لأَن الأَرض تَنْفطر عَنْهُ؛  في هو اسم يطلق على طائفة من اللازهريات خالية من الكلوروفيل منها فصائل وأَجناس وأَنواع عديدة وتسمى أيضًا فُطْريّات، منها ما يُؤْكَلُ، وما هو سامٌ…)\nمثال: وجدت بعض الفطر.",
 "break wind": "ضَرَطَ",
 "break-axe": "كاسر الفأس (شجرة خشبية من جزر الهند الغربية ذات خشب صلب جداً)",
 "break-in": "اقتحام, كسر وخلع (التعدي لغرض غير قانوني؛ الدخول غير المشروع إلى مبنى بنية إجرامية)",
 "breakability": "قابلية الكسر, هشاشة (جودة التضرر أو التدمير بسهولة)",
 "breakable": "قابل للكسر, هش (قادر على أن ينكسر أو يتلف) / قابل للكسر (صنف هش وسهل الكسر)\nمثال: الفخار الخزفي قابل للكسر",
 "breakableness": "قابلية الكسر (قوام الشيء الذي ينكسر تحت الضغط)",
 "breakage": "تحطيم, كسر (عملية كسر شيء ما) / تعويض الكسر (تعويض عن البضائع التالفة أثناء النقل أو الاستخدام) / تالف, كسر (الكمية المكسورة أو التالفة)\nمثال: كان الكسر لا مفر منه",
 "breakaway": "انشقاق, خروج عن (عملية الانفصال أو الانسحاب من) / انْشِقَاقِيّ, انْفِصَالِيّ (انْفَصَلَ أَوْ يُنَادِي بِالانْفِصَالِ عَنْ كِيَانٍ أَوْ سِيَاسَةٍ أَوْ مَوْقِف)\nمثال: كان هناك انشقاق من قبل الأعضاء الساخطين",
 "breakax": "كاسر الفأس (شجرة خشبية من جزر الهند الغربية ذات خشب صلب جداً)",
 "breakaxe": "كاسر الفأس (شجرة خشبية من جزر الهند الغربية ذات خشب صلب جداً)",
 "breakbone fever": "حمى الضنك (مرض معد في المناطق الاستوائية ينتقل عن طريق البعوض ويتميز بطفح جلدي وآلام في الرأس والمفاصل)",
 "breakdance": "بريك دانس",
 "breakdown": "تَوَزُّع",
 "breaker": "قاطع الدائرة, قاطع كهربائي (جهاز يعمل مثل المفتاح ويفتح الدائرة عند التحميل الزائد) / تكسر الأمواج, موج متكسر (أمواج تتكسر على الشاطئ) / كاسر الحجارة (عامل محجر يكسر كتل الحجر)",
 "breaker point": "بلاتين, نقطة الموزع (نقطة اتصال في الموزع (الاسبراتير)؛ عندما يدور العضو الدوار، تلامس ذراعه البارزة النقاط ويتدفق التيار إلى شمعات الإشعال)",
 "breakers": "تكسر الأمواج, موج متكسر (أمواج تتكسر على الشاطئ)",
 "breakfast": "إِفْطَار, فَطُور / فَطَرَ ( مَا تَفَطَّر مِنَ النَّبَاتِ، والفُطْر جِنْسٌ مِنَ الكَمْءِ أَبيض عِظَامٌ لأَن الأَرض تَنْفطر عَنْهُ؛  في هو اسم يطلق على طائفة من اللازهريات خالية من الكلوروفيل منها فصائل وأَجناس وأَنواع عديدة وتسمى أيضًا فُطْريّات، منها ما يُؤْكَلُ، وما هو سامٌ…)\nمثال: وجدت بعض الفطر.",
 "breakfast area": "ركن الإفطار, زاوية الإفطار (مكان لتناول الوجبات الخفيفة (عادة بالقرب من المطبخ))\nمثال: كان ركن الإفطار يحتوي على طاولة ومقاعد مدمجة",
 "breakfast cereal": "حُبُوب الإِفْطَار",
 "breakfast food": "طعام إفطار (أي طعام (خاصة الحبوب) يقدم عادة للإفطار)",
 "breakfast nook": "ركن الإفطار, زاوية الإفطار (مكان لتناول الوجبات الخفيفة (عادة بالقرب من المطبخ))\nمثال: كان ركن الإفطار يحتوي على طاولة ومقاعد مدمجة",
 "breakfast table": "طاولة الإفطار (طاولة يُتناول عليها طعام الإفطار)",
 "breakfast time": "وقت الإفطار (الساعة المعتادة أو العرفية لتناول وجبة الإفطار)",
 "breaking": "تحطيم, كسر (عملية كسر شيء ما)\nمثال: كان الكسر لا مفر منه",
 "breaking and entering": "اقتحام, كسر وخلع (التعدي لغرض غير قانوني؛ الدخول غير المشروع إلى مبنى بنية إجرامية)",
 "breaking away": "انطلاق, انفلات (المغادرة بسرعة أو عجل) / انشقاق, خروج عن (عملية الانفصال أو الانسحاب من)\nمثال: كان هناك انشقاق من قبل الأعضاء الساخطين",
 "breaking ball": "رمية منحنية, كرة مقوسة (رمية كرة بيسبول يتم رميها بدوران بحيث ينحني مسارها عند اقترابها من الضارب)",
 "breaking news": "أَخْبَار هَامَّة, خَبَر عَاجِل (أنباء ما قد حدث؛ نشرة الأخبار أو عرض الأخبار: ما يعرضه التلفاز أو الراديو من أخبار سياسة واقتصادية ورياضية تهم عامة الناس)\nمثال: هذه أخبار طيبة.",
 "breaking off": "انقطاع, قطع مفاجئ (حالة من المقاطعة المفاجئة)",
 "breaking point": "نقطة الانكسار, نقطة الانهيار (درجة الشد أو الإجهاد التي ينكسر عندها الشيء) / نقطة الانهيار ((علم النفس) مستوى الضغط الذي ينهار عنده الشخص أو يصبح الوضع حرجاً)",
 "breaking wind": "إخراج ريح, ريح (منعكس يطرد الغازات المعوية عبر الشرج)",
 "breakneck": "جُنُونِيُّ السُّرْعَة (يتحرّك بسرعة فائقة وخطيرة)",
 "breakout": "هروب من السجن (هروب من السجن)\nمثال: تم التخطيط للهروب بعناية",
 "breakstone": "كاسر الحجر (الذي قام بالكَسْر؛ اسم من أسماء العُقَاب)",
 "breakthrough": "اِخْتِرَاق (اختراق الرياح مرورها؛ اخترقت الخيل ما بين القرى والشجر:تخلّلتها)",
 "breakup": "انحلال, انفصال (إنهاء أو تفكك علاقة (بين أشخاص أو دول)) / انفصال, تفكك (التفرق أو الانقسام)",
 "breakwater": "كاسر الأمواج (هيكل واقي من الحجر أو الخرسانة؛ يمتد من الشاطئ إلى الماء لمنع جرف الشاطئ)",
 "bream": "أَبْرَامِيس / سَمَك البْرِيم (سَمَك جمع سَمَكَة، كما تجمع سمكة أسماك)\nمثال: سمكة ميناد ماتت",
 "breast": "ثَدْي, بز / صَدْر (الأمر: حدث ووقع وتقرّر؛ عن المكان: رجع وانصرف)\nمثال: تلقى ياني طلقة في الصدر.",
