 "blastoporic": "أرومي مسامي (من أو متعلق بالمسام الأرومي)",
 "blastosphere": "أريمة (مرحلة مبكرة من الجنين تنتج عن انقسام البويضة؛ كرة مملوءة بالسائل يتكون جدارها من طبقة واحدة من الخلايا)",
 "blastospheric": "أرومي (من أو متعلق بالأريمة (البلاستولا))",
 "blastula": "أريمة (مرحلة مبكرة من الجنين تنتج عن انقسام البويضة؛ كرة مملوءة بالسائل يتكون جدارها من طبقة واحدة من الخلايا)",
 "blastular": "أرومي (من أو متعلق بالأريمة (البلاستولا))",
 "blatancy": "سُفُور, فَجَاجَة (خاصية كون الشيء واضحاً ومسيئاً في آن واحد)\nمثال: كانت فجاجة محاولته لتبرئة الجريمة لا تغتفر",
 "blatant": "مُبِين",
 "blatantly": "بِسُفُور, بِشَكْل فَاضِح (بطريقة سافرة)\nمثال: انتهكوا القوانين بشكل صارخ",
 "blate": "حَيِيّ, خَجِل (يميل إلى تجنب لفت الانتباه)",
 "blather": "بَقَّ ((بَقَّ) الرجل بقا: أَكثر القَوْل فِي صَوَاب أَو خطأ؛ (بَقَّ) الْمَرْأَة: كثر وَلَدهَا) / لَغْو\nمثال: قد غزا بق الفراش فرنسا.",
 "blatherskite": "ثَرْثَرَة, هَذَر (رطانة حمقاء)",
 "blatta orientalis": "صرصور شرقي (صرصور بني داكن أصله من الشرق والآن عالمي الانتشار تقريباً)",
