 "blowback": "ارتداد, تضليل مرتد (معلومات خاطئة ناتجة عن إعادة تداول التضليل الإعلامي الذي زرعه جهاز استخبارات ذلك البلد سابقاً في الخارج داخل البلد المصدر) / ارتداد غازي, نفث خلفي (الهروب العكسي للغازات والبارود غير المحترق بعد إطلاق النار) / الارتداد الغازي, نظام الارتداد (نظام تشغيل للأسلحة النارية ذاتية التحميل يحصل على الطاقة من حركة غلاف الخرطوشة (الظرف) أثناء دفعه للخلف بواسطة الغازات المتمددة الناتجة عن اشتعال…)",
 "blowball": "طرخشقون, هندباء",
 "blowbang": "جنس فموي جماعي (نشاط جنسي يتم فيه إجراء الجنس الفموي لعدة رجال)",
 "blower": "حوتيات (ثديي مائي كبير آكل للحوم ذو أطراف أمامية تشبه الزعانف ولا أطراف خلفية، يشمل: الحيتان، الدلافين، خنازير البحر، حريش البحر) / منفاخ, نافخ (جهاز ينتج تياراً من الهواء) / مروحة كهربائية (مروحة تعمل بمحرك كهربائي)",
 "blowfish": "أَسْمَاك بَالُون",
 "blowfly": "ذبابة الزجاجة (ذبابة كبيرة عادة ما تكون مشعرة ذات لون أزرق أو أخضر معدني؛ تضع البيض في الجيف أو الروث أو الجروح)",
 "blowgun": "سبطانة",
 "blowhard": "متباهٍ, متفاخر (شخص كثير التفاخر والحديث عن نفسه)",
 "blowhole": "فتحة تهوية, منفس (ثقب لهروب الغاز أو الهواء) / ثقب النفث (متنفس الحيتانيات الواقع بعيداً في الخلف على الجمجمة)",
 "blowing": "نفخ (معالجة تتضمن نفخ الغاز)",
 "blowing gas": "غاز النفخ (الغاز الخارج من المولد أثناء فترة النفخ)",
 "blowing up": "تَعْنِيف, تَوْبِيخ شَدِيد (توبيخ شديد)\nمثال: استحق التوبيخ الشديد الذي وجهه له المدرب",
 "blowjob": "مَصّ (مَصَّ الرَّضِيعُ ثَدْيَ أُمِّهِ: رَضَعَ؛ مَصَّ العَصِيرَ: رَشَفَهُ رَشْفًا رَقِيقًا، جَذَبَهُ بِنَفَسِهِ)",
 "blowlamp": "مشعل, مشعل نفث (موقد يخلط الهواء والغاز لإنتاج لهب شديد الحرارة)",
 "blown": "مَبْهُور, مُنْقَطِع النَّفَس (يَتَنَفَّس بِصُعُوبَة أَوْ بِشَكْلٍ مُتَشَنِّج) / مَدْفُوع بِالرِّيح, مُنْقَاد بِالهَوَاء (يتحرك بفعل الهواء أو البخار المتحرك)",
 "blown-up": "مُكَبَّر (كالصورة الفوتوغرافية؛ جُعل أكبر حجماً)",
 "blowout": "احتفال بهيج, حفل (احتفال مبهج أو مناسبة اجتماعية كبيرة) / انفجار, عطل مفاجئ (عطل مفاجئ في جزء أو جهاز) / اكتساح, فوز سهل (انتصار سهل)\nمثال: انفجر الإطار الأمامي الأيمن",
 "blowpipe": "أنبوب النفخ (أنبوب يمكن من خلاله إطلاق السهام بالنفخ) / أنبوب نفخ (أنبوب يوجه الهواء أو الغاز إلى اللهب لتركيز الحرارة)",
 "blowsy": "رَثَّة, مُهْمَلَةُ المَظْهَر (تَتَّسِمُ بِالإِهْمَالِ فِي المَظْهَرِ؛ تُسْتَخْدَمُ خَاصَّةً لِلنِّسَاء)",
 "blowtorch": "مشعل, مشعل نفث (موقد يخلط الهواء والغاز لإنتاج لهب شديد الحرارة)",
 "blowtube": "أنبوب النفخ (أنبوب يمكن من خلاله إطلاق السهام بالنفخ) / أنبوب نفخ (أنبوب يوجه الهواء أو الغاز إلى اللهب لتركيز الحرارة)",
 "blowup": "تكبير, صورة مكبرة (مطبوعة فوتوغرافية تم تكبيرها) / انفجار, تدفق عاطفي (تعبير غير مقيد عن العاطفة) / انفجار, تفرقع (إطلاق عنيف للطاقة ناتج عن تفاعل كيميائي أو نووي)",
 "blowy": "عَلِيل الرِّيَاح, نَسِيمِيّ (مَلِيء بِالرِّيَاح أَوْ مُعَرَّض لِلنَّسَائِم)",
 "blowzy": "رَثَّة, مُهْمَلَةُ المَظْهَر (تَتَّسِمُ بِالإِهْمَالِ فِي المَظْهَرِ؛ تُسْتَخْدَمُ خَاصَّةً لِلنِّسَاء)",
 "blu-82": "بيج بلو (قنبلة متشظية موثوقة وفتاكة تزن 15000 رطل تنفجر فوق الأرض مباشرة بنصف قطر كبير؛ وهي أكبر قنبلة تقليدية موجودة؛ استخدمت في أفغانستان)",
 "blu-ray": "بْلُورَاي",
 "blubber": "سمنة, شحم (وزن جسدي زائد) / شحم الحوت (طبقة عازلة من الدهون تحت جلد الحيتان والثدييات البحرية الكبيرة الأخرى؛ تُستخدم كمصدر للزيت)\nمثال: كانت تكره السمنة في نفسها وكذلك في الآخرين",
 "blubberer": "مُجْهِش بِالبُكاء, مُنْتَحِب (شخص يشهق ويبكي بنشيج عال)",
 "blubbery": "مُنْتَفِخ الشَّحْم (مُتَوَرِّم بِالشَّحْم والدُّهُون)",
 "blucher": "حذاء بلوشر (حذاء مرتفع ذو أربطة فوق اللسان) / بلوشر, جبهارد فون بلوشر (جنرال بروسي يذكر لقيادته في الحروب ضد نابليون (1742-1819))",
 "bludgeon": "هِرَاوَة / يَهْرِي",
 "bludgeoner": "ضارب بهراوة (مهاجم يستخدم هراوة)",
 "bludger": "بلودجر (كرة مراوغة مفرغة قليلاً من الهواء يتم ضربها بواسطة الضاربين في لعبة الكويدتش)\nمثال: يمكن للضاربين محاولة ضرب كرات البلودجر في الهواء باستخدام عصي هوكي قصيرة أو مضرب قصير",
 "blue": "حَزِين / أَزْرَق, زرق (أحد الأَلْوَان الرئيسية (الأَحْمَر والأَزْرَق والأَصْفَر) وهو لون السَمَاء نهارا حين تكون صافية. انظر الصورة؛ صفة ما كان لونه أزرقًا)\nمثال: هذا البناء أزرق.",
 "blue african lily": "أغابانثوس, زنبق أفريقي (نبات أفريقي بأوراق خضراء زاهية دائمة الخضرة ومظلات من العديد من الزهور البنفسجية الزرقاء العميقة عادة)",
 "blue air": "زرقة السماء, سماء زرقاء (السماء كما تُرى في وضح النهار)\nمثال: أطلق سهماً في كبد السماء",
 "blue angel": "أموباربيتال الصوديوم, أميتال (ملح الصوديوم للأموباربيتال الذي يستخدم كباربيتورات؛ يستخدم كمهدئ ومنوم)",
 "blue ash": "مران أزرق (مران من وسط وجنوب الولايات المتحدة بأوراق خضراء مزرقة وخشب بني صلب)",
 "blue baby": "طفل مزرق (رضيع يولد بلون مزرق؛ عادة ما يكون لديه عيب في القلب)",
 "blue blood": "أرستقراطي, نبيل (عضو في الطبقة الأرستقراطية)",
 "blue book": "كراسة إجابة زرقاء (كتيب أزرق يستخدم في الجامعات لكتابة الامتحانات) / الدليل الاجتماعي (سجل للأشخاص البارزين اجتماعياً) / كتاب أزرق (تقرير تنشره الحكومة البريطانية؛ يغلف عادة بغلاف أزرق)",
 "blue bugle": "عجوقة زرقاء, عجوقة منتصبة (نبات معمر جذموري منتصب بزهور زرقاء زاهية؛ جنوب أوروبا)",
 "blue bull": "ثور أزرق, نيلجاي (ظبي هندي كبير؛ الذكر أزرق رمادي بعلامات بيضاء؛ الأنثى بنية وبلا قرون)",
 "blue cardinal flower": "لوبيليا زرقاء كبيرة (عشبة معمرة طويلة ومنتصبة وورقية جداً من شرق أمريكا الشمالية ذات سنابل كثيفة من الزهور الزرقاء)",
 "blue cat": "سلور أزرق (سلور كبير في وادي المسيسيبي)",
 "blue catfish": "سلور أزرق (سلور كبير في وادي المسيسيبي)",
 "blue channel cat": "سلور أزرق (سلور كبير في وادي المسيسيبي)",
 "blue channel catfish": "سلور أزرق (سلور كبير في وادي المسيسيبي)",
 "blue cheese": "جُبْنَة زَرْقَاء",
 "blue cheese dressing": "تتبيلة الجبن الأزرق (تتبيلة كريمية تحتوي على فتات الجبن الأزرق) / تتبيلة الروكفور (فينيغريت (خل وزيت) يحتوي على فتات جبن الروكفور أو الجبن الأزرق)",
 "blue chip": "فيشة زرقاء (فيشة بوكر زرقاء ذات أعلى قيمة) / أسهم قيادية, أسهم ممتازة (أسهم عادية لشركة معروفة وطنياً تكون قيمتها وأرباحها موثوقة؛ عادة ما يكون لها سعر مرتفع وعائد منخفض)\nمثال: الأسهم القيادية عادة ما تكون استثمارات آمنة",
 "blue cohosh": "جذر التوت الأزرق, كوهوش أزرق (عشبة طويلة من شرق أمريكا الشمالية وآسيا لها ثمار تشبه التوت الأزرق وجذمور سميك وعقدي كان يستخدم طبياً سابقاً)",
 "blue columbine": "كولومبين أزرق (كولومبين جبال روكي ذو زهور زرقاء طويلة المهماز)",
 "blue copperas": "زاج أزرق (شكل بلوري أزرق مائي لكبريتات النحاس)",
 "blue crab": "سلطعون أزرق (سلطعون أزرق صالح للأكل من سواحل المحيط الأطلسي والخليج في أمريكا الشمالية) / سلطعون أزرق (سلطعون أطلسي؛ المصدر الأكثر شيوعاً للحم السلطعون الطازج)",
 "blue curls": "تجعيدات زرقاء, تريكوستيما (أي من عدة نباتات من جنس تريكوستيما ذات دوامات من الزهور الزرقاء الصغيرة)",
 "blue daisy": "أقحوان أزرق, مارغريت زرقاء (شجيرة مشعرة من جنوب أفريقيا أو أستراليا لها زهور تشبه الأقحوان بأشعة زرقاء)",
 "blue darter": "باز كوبر (صقر من أمريكا الشمالية لونه رمادي مزرق يتميز بطيران انقضاضي)",
 "blue devil": "أموباربيتال الصوديوم, أميتال (ملح الصوديوم للأموباربيتال الذي يستخدم كباربيتورات؛ يستخدم كمهدئ ومنوم) / زهرة الأفعى, شوك أزرق (عشب أوروبي شائك خشن بسنابل من الزهور الزرقاء؛ مستوطن في الولايات المتحدة)",
 "blue devils": "حزن, غم (حالة من الاكتئاب)\nمثال: كان يعاني من حالة كآبة شديدة",
 "blue elder": "بيلسان أزرق (شجيرة أو شجرة صغيرة من غرب الولايات المتحدة لها زهور بيضاء وتوت أزرق؛ تستخدم الفاكهة في النبيذ والمربيات)",
 "blue elderberry": "بيلسان أزرق (شجيرة أو شجرة صغيرة من غرب الولايات المتحدة لها زهور بيضاء وتوت أزرق؛ تستخدم الفاكهة في النبيذ والمربيات)",
 "blue false indigo": "نيلة كاذبة زرقاء (نيلة برية في شرق الولايات المتحدة ذات عناقيد من الزهور الزرقاء)",
 "blue fig": "تين أزرق, شجرة الكواندونج (شجرة أسترالية ذات خشب أبيض صلب وأوراق خضراء لامعة مع أزهار بيضاء تليها ثمرة زرقاء لامعة ذات بذرة واحدة) / تين أزرق, كوندونغ (ثمرة شجرة الكوندونغ في بريسبان)",
 "blue flag": "سوسن أزرق, سوسن مبرقش (سوسن شائع في شرق الولايات المتحدة له زهور زرقاء أو زرقاء بنفسجية؛ كان جذره يستخدم طبياً سابقاً)",
 "blue fleabane": "شيخ الربيع الأزرق, يرغوث أزرق (عشبة ضارة واسعة الانتشار ذات أزهار زرقاء أرجوانية شاحبة)",
 "blue fox": "ثعلب أزرق (نوع من الثعلب القطبي ذو معطف شتوي رمادي باهت)",
 "blue funk": "خوف واكتئاب, وجوم (حالة من الاكتئاب العصبي)\nمثال: كان في حالة وجوم",
 "blue goose": "إوز أزرق (إوز بري من أمريكا الشمالية ذو ريش داكن في الصيف وأبيض في الشتاء)",
 "blue grama": "غراما زرقاء (عشبة مراعي في غرب أمريكا الشمالية)",
 "blue grass": "عشب أزرق, قبأ (أي من أعشاب مختلفة من جنس بوع)",
 "blue green": "أخضر مزرق, فيروزي غامق (لون أو صبغة زرقاء مخضرة)\nمثال: طلوها بدرجة فاتحة من الأزرق المخضر",
 "blue gum": "شجرة الحمى, صمغ أزرق (شجرة خشبية طويلة سريعة النمو ذات أوراق تحتوي على زيت طبي؛ الأوراق الصغيرة تكون زرقاء اللون)",
 "blue jack": "سلمون فضي, سلمون كوهو (سلمون صغير من سواحل شمال المحيط الهادئ والبحيرات العظمى)",
 "blue jasmine": "ياسمين أزرق, ياسمين بري مجعد (نبات متسلق من جنوب الولايات المتحدة ذو أزهار أرجوانية مائلة للزرقة)",
 "blue jay": "قيق أزرق (قيق شائع في شرق أمريكا الشمالية؛ لونه أزرق ساطع مع صدر رمادي)",
 "blue jeans": "بنطال جينز, جينز ((تستخدم بصيغة الجمع) بنطال ضيق مصنوع من قماش الدينيم الثقيل للعمل اليدوي أو الارتداء غير الرسمي)",
 "blue jessamine": "ياسمين أزرق, ياسمين بري مجعد (نبات متسلق من جنوب الولايات المتحدة ذو أزهار أرجوانية مائلة للزرقة)",
 "blue jet": "برق عكسي, نفث أزرق (تفريغ جوي (يستمر 10 مللي ثانية) ينفجر من قمم سحب العواصف العملاقة في مخاريط زرقاء تتسع أثناء وميضها لأعلى)",
 "blue joke": "نُكْتَة بَذِيئَة (نكتة غير مهذبة)",
 "blue law": "القانون الأزرق (قانون ينظم العمل أيام الأحد)",
 "blue light": "ضَوْء أَزْرَق (النُّور؛ مصدر ضَاء)\nمثال: ضوء القمر ضعيف.",
 "blue line": "خَطّ أَزْرَق (كِتَابَة؛ ما يَصِل نقطتين أو أكثر)\nمثال: إرسم خط مستقيم.",
 "blue lotus": "لوتس أزرق, نيلوفر أزرق (اللوتس المصري الأزرق: كان مقدساً عند المصريين القدماء) / لوتس أزرق, نيلوفر نجمي (لوتس أزرق موطنه الهند وجنوب شرق آسيا)",
 "blue mahoe": "لحاء كوبي, ماهو أزرق (شجرة غابات منتصبة في كوبا وجامايكا ذات أوراق مشعرة بشكل متباين وزهور برتقالية صفراء أو برتقالية حمراء؛ تنتج خشباً متوسط الكثافة لأعمال الخزائن…)",
 "blue marguerite": "أقحوان أزرق, مارغريت زرقاء (شجيرة مشعرة من جنوب أفريقيا أو أستراليا لها زهور تشبه الأقحوان بأشعة زرقاء)",
 "blue marlin": "مارلين أزرق (أكبر أنواع المارلين؛ قد يصل وزنه إلى 2000 رطل؛ يوجد عالمياً في البحار الدافئة)",
 "blue mockingbird": "طائر محاكي أزرق (طائر محاكي من المكسيك)",
 "blue mold fungus": "فطر العفن الأزرق (فطر يسبب مرضاً خطيراً في نباتات التبغ يتميز ببياض رمادي مزرق على الجانب السفلي للأوراق)",
 "blue moon": "زمن بعيد, في المشمش (وقت طويل جداً (نادر الحدوث))\nمثال: شيء يحدث مرة في القمر الأزرق (نادراً جداً)",
 "blue mountain tea": "شاي الجبل الأزرق, عصا الذهب الحلوة (عصا ذهب من شرق أمريكا ذات أوراق عطرية يصنع منها شاي طبي)",
 "blue murder": "صراخ صاخب (صيحة عالية بشكل مبالغ فيه)",
 "blue nile": "اَلنِّيل الْأَزْرَق",
 "blue note": "نوتة بلوز (ثالثة أو سابعة مخفضة)",
 "blue orchid": "سحلب أزرق, فاندا زرقاء (سحلب شهير من شمال الهند له زهور كبيرة زرقاء ليلكية شاحبة إلى عميقة)",
 "blue pea": "بازلاء الفراشة, بازلاء زرقاء (كرمة من آسيا الاستوائية لها أوراق ريشية وأزهار زرقاء زاهية بمراكز صفراء)",
 "blue peafowl": "طاووس أزرق (طاووس الهند وسيلان)",
 "blue peter": "العلم الأزرق (علم أزرق به مربع أبيض في المنتصف يشير إلى أن السفينة جاهزة للإبحار)",
 "blue pickerel": "بايك أزرق (نوع يعيش في البحيرات العظمى)",
 "blue pike": "بايك أزرق (نوع يعيش في البحيرات العظمى)",
 "blue pikeperch": "بايك أزرق (نوع يعيش في البحيرات العظمى)",
 "blue pimpernel": "درقة الكلب المسعور, درقة زرقاء (نعناع أمريكي ينتج إفرازاً راتنجياً يستخدم خاصة في الماضي كمضاد للتشنج)",
 "blue point": "محار بلو بوينت (محار صغير صالح للأكل عادة من الشاطئ الجنوبي لجزيرة لونغ آيلاند) / محار بلوبوينت (محار أصله من لونغ آيلاند ساوند ولكنه الآن من أي مكان على طول الساحل الشمالي الشرقي؛ يؤكل عادة نيئاً)",
 "blue point siamese": "سيامي أزرق الأطراف (قط سيامي له جسم كريمي مزرق وأطراف رمادية داكنة)",
 "blue pointed": "قرش بونيتو (قرش أزرق رمادي شائع في جنوب غرب المحيط الهادئ؛ سمكة رياضة وطعام)",
 "blue poppy": "خشخاش أزرق (نبات صيني معمر ذو زهور بنفسجية وردية إلى زرقاء سماوية زاهية في نورات محدودة متدلية)",
 "blue racer": "المتسابق الأزرق (ثعبان أسود مزرق مخضر يوجد من أوهايو إلى تكساس)",
 "blue ribbon": "شريط أزرق (شرف أو جائزة تُكتسب للتميز)",
 "blue ribbon commission": "لجنة النخبة, لجنة رفيعة المستوى (لجنة مستقلة وحصرية من رجال الدولة والخبراء غير الحزبيين تشكلت للتحقيق في قضية حكومية مهمة)",
 "blue ribbon committee": "لجنة النخبة, لجنة رفيعة المستوى (لجنة مستقلة وحصرية من رجال الدولة والخبراء غير الحزبيين تشكلت للتحقيق في قضية حكومية مهمة)",
 "blue ribbon jury": "هيئة محلفين خاصة (هيئة محلفين يتم اختيار أعضائها لمعرفتهم الخاصة بقضية تنطوي على مسائل معقدة)",
 "blue runner": "العداء الأزرق (سمكة من غرب المحيط الأطلسي: من كيب كود إلى البرازيل)",
 "blue sage": "شيح ثلاثي الأسنان, ميرمية كبيرة (شجيرة عطرية في المناطق القاحلة بغرب أمريكا الشمالية ذات أوراق شيباء) / قصعين أزرق, ميرمية زرقاء (ميرمية زرقاء الزهور من البراري الجافة في شرق الولايات المتحدة) / ميرمية دقيقية (ميرمية تكساس ذات زهور زرقاء مكثفة) / قصعين منعكس, ميرمية زرقاء (ميرمية من غرب أمريكا الشمالية إلى أمريكا الوسطى لها زهور زرقاء بنفسجية؛ واسعة الانتشار في الزراعة)",
 "blue screen of death": "شَاشَة الْمَوْت الزَّرْقَاء",
 "blue shark": "قرش أزرق, قرش أزرق كبير (قرش نحيل عالمي الانتشار يعيش في عرض البحر؛ يتدرج لون جسمه الأزرق إلى بطن أبيض؛ خطير خاصة أثناء الكوارث البحرية)",
 "blue skullcap": "درقة الكلب المسعور, درقة زرقاء (نعناع أمريكي ينتج إفرازاً راتنجياً يستخدم خاصة في الماضي كمضاد للتشنج)",
 "blue sky": "زرقة السماء, سماء زرقاء (السماء كما تُرى في وضح النهار)\nمثال: أطلق سهماً في كبد السماء",
 "blue sky law": "قانون السماء الزرقاء (قانون ولاية ينظم بيع الأوراق المالية لمحاولة السيطرة على بيع الأوراق المالية في المشاريع الاحتيالية)",
 "blue star": "أمسونيا, نجمة زرقاء (شجيرات فرعية في جنوب شرق الولايات المتحدة تشكل كتل بطيئة النمو ولها زهور زرقاء في سيمات طرفية قصيرة)",
 "blue stem": "عشب أزرق الساق (عشب طويل بأغماد أوراق زرقاء ناعمة يُزرع للقش في الولايات المتحدة)",
 "blue stone": "زاج أزرق (شكل بلوري أزرق مائي لكبريتات النحاس)",
 "blue story": "نُكْتَة بَذِيئَة (نكتة غير مهذبة)",
 "blue straggler": "نجوم زرقاء شاردَة (الظُهُور والطُلُوع والنُبُوغ؛ عِلْمُ النُجُوْم: هو العلم الذي يعنى بدراسة النجوم والأجْرَام السماويّة الأخرى، وهو غير التَنْجِيم)\nمثال: أحب تأمل النجوم.",
 "blue succory": "سهم كيوبيد, هندباء زرقاء (نبات جنوب أوروبي ذو زهور داكنة العين بأشعة زرقاء مسطحة)",
 "blue thistle": "زهرة الأفعى, شوك أزرق (عشب أوروبي شائك خشن بسنابل من الزهور الزرقاء؛ مستوطن في الولايات المتحدة)",
 "blue tit": "قرقف أزرق",
 "blue toadflax": "كتانية زرقاء (نبات من أمريكا الشمالية له عناقيد من الزهور الزرقاء البنفسجية)",
 "blue tulip": "زهرة الفصح الأمريكية, شقائق النعمان البراري (نبات معمر قصير مشعر ذو أزهار زرقاء بنفسجية أو ليلكية في أوائل الربيع؛ أمريكا الشمالية وسيبيريا)",
 "blue vitriol": "زاج أزرق (شكل بلوري أزرق مائي لكبريتات النحاس)",
 "blue wall": "جدار الصمت, جدار الصمت الأزرق (سرية ضباط الشرطة الذين يكذبون أو يغضون الطرف لحماية ضباط شرطة آخرين)\nمثال: تصدع جدار الصمت عندما رفض بعض الضباط المشاركة في التستر",
 "blue wall of silence": "جدار الصمت, جدار الصمت الأزرق (سرية ضباط الشرطة الذين يكذبون أو يغضون الطرف لحماية ضباط شرطة آخرين)\nمثال: تصدع جدار الصمت عندما رفض بعض الضباط المشاركة في التستر",
 "blue walleye": "بايك أزرق (نوع يعيش في البحيرات العظمى)",
 "blue whale": "حوت أزرق (أكبر حيوان ثديي معروف على الإطلاق؛ حوت باليني مهاجر أزرق رمادي يعيش غالباً في نصف الكرة الجنوبي)",
 "blue-belly": "سحلية السياج الغربية (سحلية غربية شائعة؛ تُشاهد على جذوع الأشجار أو الصخور)",
 "blue-black": "أَسْوَد مُزْرَقّ (أسود مع مسحة زرقاء)",
 "blue-blind": "مُصَاب بِعَمَى الأَزْرَق (عدم القدرة على رؤية اللون الأزرق أو التمييز بين الأزرق والأصفر)",
 "blue-blindness": "عمى الأزرق (شكل نادر من عمى الألوان الثنائي يتميز بانخفاض الحساسية للضوء الأزرق مما يؤدي إلى عدم القدرة على التمييز بين الأزرق والأصفر)",
 "blue-blooded": "أَرِسْتُقْرَاطِيّ, نَبِيل المَحْتِد (ينتمي إلى طبقة النبلاء أو الأرستقراطية أو يتسم بسماتها)",
 "blue-chip": "رَفِيعُ القِيمَة, مُمْتَاز (بَالِغُ القِيمَة)",
 "blue-chip stock": "أسهم قيادية, أسهم ممتازة (أسهم عادية لشركة معروفة وطنياً تكون قيمتها وأرباحها موثوقة؛ عادة ما يكون لها سعر مرتفع وعائد منخفض)\nمثال: الأسهم القيادية عادة ما تكون استثمارات آمنة",
 "blue-collar": "عُمَّالِيّ, مِن الطَّبَقَة العَامِلَة (ينتمي إلى من يعملون بأجر خاصة العمال اليدويين أو الصناعيين) / ذو الياقات الزرقاء, عمالي (من أو يحدد العمل الصناعي اليدوي أو العمال)",
 "blue-eyed": "أَزْرَق العَيْنَيْن (ذو عينين زرقاوين)",
 "blue-eyed african daisy": "أقحوان أفريقي أزرق العينين (نبات معمر كثيف من جنوب أفريقيا ذو زهور بيضاء أو بنفسجية؛ يغطي في موطنه الأصلي جوانب الوديان بأكملها بغطاء ملون)",
 "blue-eyed grass": "عشب أزرق العينين (نبات ذو أوراق تشبه العشب وأزهار زرقاء رقيقة)",
 "blue-eyed mary": "كولينسيا ربيعية, ماري زرقاء العيون (نبات في شرق الولايات المتحدة بدوامات من الزهور الزرقاء والبيضاء)",
 "blue-flowered": "أَزْرَق الأَزْهَار (ذو أزهار زرقاء)",
 "blue-fruited": "ذُو ثِمَار زَرْقَاء (يَحْمِلُ ثِمَارًا زَرْقَاء)",
 "blue-gray": "رَمَادِيّ مُزْرَقّ (رمادي مع مسحة زرقاء)",
 "blue-green": "أَخْضَر مُزْرَقّ (ذو لون أخضر بمسحة زرقاء)",
 "blue-green algae": "بكتيريا زرقاء, طحالب خضراء مزرقة (كائنات بدائية النواة تقوم بالتمثيل الضوئي بشكل أساسي وتحتوي على صبغة زرقاء بالإضافة إلى الكلوروفيل؛ توجد منفردة أو في مستعمرات في بيئات متنوعة؛ مهمة…)",
 "blue-grey": "رَمَادِيّ مُزْرَقّ (رمادي مع مسحة زرقاء)",
 "blue-headed vireo": "فيريو أزرق الرأس (فيريو شائع في شمال شرق أمريكا الشمالية برأس رمادي مزرق)",
 "blue-lilac": "أَزْرَق لَيْلَكِيّ (بلون الخُزامى مع مَسْحة زرقاء)",
 "blue-purple": "أَزْرَق أُرْجُوَانِيّ (بلون أرجواني مع مسحة زرقاء)",
 "blue-sky": "بَحْثِيّ بَحْت, نَظَرِيّ (بدون قيمة تجارية فورية)",
 "blue-violet": "أَزْرَق بَنَفْسَجِيّ (بلون بنفسجي مع مسحة زرقاء)",
 "blue-white": "أَبْيَض مُزْرَقّ (أبيض مع مسحة زرقاء)",
 "blue-winged teal": "شَرْشِير",
 "blueback salmon": "سلمون أحمر, سلمون سوكي (سلمون صغير ذو لحم أحمر؛ يوجد في الأنهار وروافد شمال المحيط الهادئ ويُقدر كطعام؛ يموت البالغون بعد وضع البيض)",
 "bluebeard": "اَللِّحْيَة الزَّرْقَاء",
 "bluebell": "جريس, جريس مستدير الأوراق (نبات معمر من نصف الكرة الشمالي ذو سيقان نحيلة وأزهار زرقاء على شكل جرس) / جرس أزرق, جنطيانا المروج (واحدة من أجمل الأزهار البرية في المروج لها أزهار زرقاء كبيرة منتصبة جرسية الشكل؛ في الأماكن الرطبة في المروج والحقول من شرق كولورادو ونبراسكا جنوباً…) / جريس, ياسنت الخشب (يصنف أحياناً في جنس سيلا)",
 "blueberry": "تُوت أَزْرَق, بْلُو بيرِي",
 "blueberry bush": "توت أزرق, شجيرة التوت الأزرق (أي من الشجيرات المتعددة من جنس فاكسينيوم التي تحمل التوت الأزرق)",
 "blueberry liqueur": "ليكير التوت الأزرق (ليكير منقوع بالتوت الأزرق أو عصير التوت الأزرق أو نكهة التوت الأزرق)\nمثال: ليكير التوت الأزرق مشروب كحولي لذيذ ومتعدد الاستخدامات ويصلح تماماً للشرب مع الثلج فقط",
 "blueberry pie": "فطيرة التوت الأزرق (فطيرة تحتوي على التوت الأزرق والسكر)",
 "blueberry root": "جذر التوت الأزرق, كوهوش أزرق (عشبة طويلة من شرق أمريكا الشمالية وآسيا لها ثمار تشبه التوت الأزرق وجذمور سميك وعقدي كان يستخدم طبياً سابقاً)",
 "blueberry soup": "حساء العنب البري (حساء مصنوع من العنب البري)",
 "blueberry yogurt": "زبادي التوت (زبادي مع التوت المحلى أو مربى التوت)",
 "bluebill": "بط زرقاي, زرقاي (بط غواص من أمريكا الشمالية له منقار رمادي مزرق)",
 "bluebird": "عصفور أزرق",
 "bluebonnet": "بالمورال (قبعة اسكتلندية زرقاء داكنة بلا حواف ذات سطح مسطح وريشة على جانب واحد) / بلوبونيت, ترمس تكساس (عشب حولي منخفض النمو في جنوب غرب الولايات المتحدة (تكساس) ذو أوراق حريرية وزهور زرقاء؛ وهو سبب رئيسي لتسمم الماشية في جنوب غرب الولايات المتحدة)",
 "bluebottle": "ذباب أزرق (ذباب ذو جسم أزرق قزحي؛ يصدر طنيناً عالياً أثناء الطيران) / قنطريون عنبري, ورد الذرة (نبات أوراسي حولي يُزرع في أمريكا الشمالية له رؤوس مبهرجة من الزهور الزرقاء أو الأرجوانية أو الوردية أو البيضاء)",
 "bluecoat": "صَاحِب الْمِعْطَف الْأَزْرَق (شخص يرتدي ملابس زرقاء بالكامل (كجندي أو بحار))",
 "bluefin": "تونة زرقاء الزعانف (أكبر أنواع التونة؛ تصل إلى 1500 رطل؛ تعيش غالباً في البحار المعتدلة: تتغذى في المناطق القطبية ولكن تتكاثر في المناطق الاستوائية) / تونة زرقاء الزعانف (لحم تونة كبيرة جداً)",
 "bluefin tuna": "تونة زرقاء الزعانف (أكبر أنواع التونة؛ تصل إلى 1500 رطل؛ تعيش غالباً في البحار المعتدلة: تتغذى في المناطق القطبية ولكن تتكاثر في المناطق الاستوائية) / تونة زرقاء الزعانف (لحم تونة كبيرة جداً)",
 "bluefish": "سمكة زرقاء (سمكة غذائية ورياضية بحرية زرقاء تعيش في المياه الدافئة وتتبع أسراب الأسماك الصغيرة إلى المياه الضحلة) / سمك أزرق (لحم مزرق دهني لسمك البلوفيش)",
 "bluegill": "بلوجيل, خيشوم أزرق (سمكة شمس صالحة للأكل ومهمة في شرق ووسط الولايات المتحدة)",
 "bluegrass": "بلوغراس (نوع من موسيقى الكانتري يُعزف بإيقاع سريع على البانجو والغيتار) / عشب أزرق, قبأ (أي من أعشاب مختلفة من جنس بوع)",
 "bluegrass stater": "كنتاكي (مواطن أو مقيم في كنتاكي)",
 "bluehead": "سمكة زرقاء الرأس (سمكة لبروسية أطلسية صغيرة يتميز ذكرها برأس أزرق لامع)",
 "blueing": "تزريق (عملية تجعل الشيء أزرق اللون (أو ضارباً إلى الزرقة)) / زهرة الغسيل, مادة التزريق (مادة تستخدم لتبييض الغسيل أو الشعر أو إعطائه مسحة زرقاء)",
 "blueish": "أَزْرَق (ذو لون وسط بين الأخضر والبنفسجيّ؛ كلون السماء الصافية)",
 "bluejack oak": "بلوط أزرق, بلوط تركي (شجرة شجيرية صغيرة شبه دائمة الخضرة من جنوب شرق الولايات المتحدة لها غصينات صغيرة مشعرة وأوراق تضيق إلى نقطة شائكة رفيعة)",
 "bluejacket": "بحار, جندي بحرية (جندي يخدم في القوات البحرية)",
 "blueness": "زُرْقَة",
 "bluenose": "نوفا سكوشي (مواطن أو ساكن في نوفا سكوشا)",
 "bluepoint": "محار بلو بوينت (محار صغير صالح للأكل عادة من الشاطئ الجنوبي لجزيرة لونغ آيلاند) / محار بلوبوينت (محار أصله من لونغ آيلاند ساوند ولكنه الآن من أي مكان على طول الساحل الشمالي الشرقي؛ يؤكل عادة نيئاً)",
 "blueprint": "مُخَطَّط",
 "blueprint paper": "ورق المخططات الزرقاء (ورق حساس يستخدم لعمل المخططات الزرقاء)",
 "blues": "بْلُوز / بَلُوز",
 "blues scale": "سلم البلوز (سلم موسيقي له فواصل تتغير بين الكبير والصغير ويُستخدم خاصة في موسيقى الجاز)",
 "bluestem": "عشب أزرق الساق (عشب طويل بأغماد أوراق زرقاء ناعمة يُزرع للقش في الولايات المتحدة)",
 "bluestem wheatgrass": "عشبة القمح الغربية (عشبة علف قيمة في غرب الولايات المتحدة)",
 "bluestocking": "جورب أزرق, مثقفة (امرأة لديها اهتمامات أدبية أو فكرية)",
 "bluestone": "حجر أزرق (حجر رملي رمادي مزرق يستخدم للرصف والبناء)",
 "bluethroat": "هَزَار أَزْرَق الزَوْر, أَزْرَق الْحَلْق",
 "bluethroat pikeblenny": "بايك بليني أزرق الحلق (توجد من فلوريدا إلى كوبا)",
 "bluetick": "بلوتيك (كلب صيد أمريكي سريع جداً؛ أبيض مبقع بالرمادي المزرق)",
 "bluetongue": "مَرَض اَللِّسَان اَلْأَزْرَق (أصابه مرضٌ أو علّة أو سَقَم)\nمثال: هذا المرض قلبي.",
 "bluetooth": "بُلُوتُوث, بْلُوتُوث",
 "blueweed": "زهرة الأفعى, شوك أزرق (عشب أوروبي شائك خشن بسنابل من الزهور الزرقاء؛ مستوطن في الولايات المتحدة)",
 "bluewing": "حذف أزرق الجناح (بط صغير أمريكي)",
 "bluff": "خداع, مخادعة (فعل المخادعة في البوكر؛ الخداع بإظهار ثقة زائفة في قوة أوراقك) / صَرِيح, طَيِّب القَلْب (مُبَاشِر وَصَرِيح فِي الكَلَام لَكِنْ بِطِيبَة قَلْب) / شَاهِق, عَمُودِيّ تَقْرِيبًا (شديد الانحدار؛ ذو واجهة بارزة وشبه عمودية) / خداع, مخادعة (تظاهر بأن موقفك أقوى مما هو عليه في الواقع)\nمثال: نجحت مخادعته في قبوله",
 "bluffer": "مخادع, مراوغ (شخص يحاول خداع الآخرين بالتبجح)",
 "bluffly": "بِصَرَاحَة فَجَّة, بِفَظَاظَة (بطريقة مباشرة فظة)\nمثال: تحدث بفظاظة",
 "bluffness": "صراحة فجة (صراحة طيبة النية ولكن خشنة)",
 "bluing": "تزريق (عملية تجعل الشيء أزرق اللون (أو ضارباً إلى الزرقة)) / زهرة الغسيل, مادة التزريق (مادة تستخدم لتبييض الغسيل أو الشعر أو إعطائه مسحة زرقاء)",
 "bluish": "أَزْرَق (ذو لون وسط بين الأخضر والبنفسجيّ؛ كلون السماء الصافية)",
 "bluish black": "أَسْوَد مُزْرَقّ (أسود مع مسحة زرقاء)",
 "bluish green": "أَخْضَر مُزْرَقّ (ذو لون أخضر بمسحة زرقاء) / أخضر مزرق, فيروزي غامق (لون أو صبغة زرقاء مخضرة)\nمثال: طلوها بدرجة فاتحة من الأزرق المخضر",
 "bluish-gray": "رَمَادِيّ مُزْرَقّ (رمادي مع مسحة زرقاء)",
 "bluish-grey": "رَمَادِيّ مُزْرَقّ (رمادي مع مسحة زرقاء)",
 "bluish-lilac": "أَزْرَق لَيْلَكِيّ (بلون الخُزامى مع مَسْحة زرقاء)",
