 "bird of minerva": "بومة (طائر جارح ليلي بمنقار ومخالب تشبه الصقر ورأس كبير بعيون موجهة للأمام)",
 "bird of night": "بومة (طائر جارح ليلي بمنقار ومخالب تشبه الصقر ورأس كبير بعيون موجهة للأمام)",
 "bird of paradise": "طائر الجنة (أي من الطيور العديدة ذات الريش الملون ببراعة في منطقة غينيا الجديدة) / إستريلتزيا, عصفور الجنة (نبات زينة من جنوب أفريقيا الاستوائية وأمريكا الجنوبية له سيقان من الزهور البرتقالية والزرقاء الأرجوانية تشبه الطائر) / بوانسيانا, عصفور الجنة (شجيرة مزهرة استوائية لها زهور برتقالية زاهية أو حمراء؛ تصنف أحياناً في جنس بوانسيانا)",
 "bird of passage": "طائر مهاجر (أي طائر يهاجر موسمياً) / جوال, متشرد (شخص يعيش حياة تجوال غير مستقرة)",
 "bird of prey": "طَيْر جَارِح",
 "bird pepper": "فلفل الطيور (نبات يحمل ثماراً حمراء مستطيلة صغيرة جداً وحارة جداً؛ يشمل أشكالاً برية موطنها أمريكا الاستوائية؛ يعتقد أنه سلف الفلفل الحلو والعديد من الفلفل الحار)",
 "bird sanctuary": "بيت الطيور, قفص الطيور الكبير (مبنى تُحفظ فيه الطيور)",
 "bird shot": "خردق الطيور, خردق صيد (خردق رصاصي صغير لخراطيش بنادق الصيد)",
 "bird vetch": "بيقية الطيور, بيقية معنقدة (متسلق معمر شائع في المناطق المعتدلة من أوراسيا وأمريكا الشمالية له عناقيد طويلة كثيفة من الزهور)",
 "bird watcher": "مراقب الطيور (شخص يتعرف على الطيور ويدرسها في بيئاتها الطبيعية) / عالم طيور (عالم حيوان يدرس الطيور)",
 "bird's eye": "زهرة الحواشي الجعدية, عين الطائر (نبات من العالم القديم بعناقيد إبطية من الزهور الزرقاء والبيضاء)",
 "bird's eye view": "نظرة شمولية, نظرة عامة (النظر إلى موقف أو موضوع وكأنه يُرى من علو أو مسافة)",
 "bird's foot": "قدم طائر (قدم طائر)",
 "bird's foot clover": "قرن الغزال, لوتس قرني (نبات علف أوروبي له قرون مخلبية الشكل أدخل إلى أمريكا)",
 "bird's foot trefoil": "قرن الغزال, لوتس قرني (نبات علف أوروبي له قرون مخلبية الشكل أدخل إلى أمريكا) / تريغونيلا, نفل الطيور (عشب من العالم القديم يرتبط بالحلبة)",
 "bird's nest": "أُكْنَة, وُكْنَة",
 "bird's nest fern": "سرخس عش الطير (سرخس هوائي استوائي من العالم القديم أو أستراليا يشكل كثيراً خصلات في تشعبات الأشجار)",
 "bird's-eye": "بَانُورَامِيّ, مِنْ عَلُوّ (كما يُرى من ارتفاع أو مسافة بعيدة)",
 "bird's-eye bush": "أوشنا, شجيرة عين الطائر (شجيرة ذات أوراق دائمة الخضرة بيضاوية ضيقة لامعة وأزهار صفراء بسبلات جلدية تشبه البتلات)",
 "bird's-eye maple": "قيقب عين الطائر (خشب قيقب له عروق مموجة بعلامات تشبه العين)",
 "bird's-eye view": "مَنْظُور عَيْن الْطَائِر",
 "bird's-foot fern": "سرخس قدم الطائر (سرخس جرف في كاليفورنيا وباها كاليفورنيا بسويقات أوراق بنية أرجوانية)",
 "bird's-foot violet": "بنفسج قدم الطائر (بنفسج شائع في شرق الولايات المتحدة بزهور زرقاء شاحبة أو أرجوانية كبيرة تشبه زهور الثالوث)",
 "bird's-nest fungus": "فطر عش الطائر (أي من الفطريات المختلفة من فصيلة نيدولارياسيا لها جسم كأسي الشكل يحتوي على عدة هياكل بيضاوية الشكل تحيط بالأبواغ)",
 "bird-footed dinosaur": "ثيروبود, ديناصور ثيروبود (أي من العديد من الديناصورات اللاحمة من العصر الترياسي إلى الطباشيري ذات أطراف أمامية قصيرة وكانت تمشي أو تركض على أرجل خلفية قوية)",
 "bird-on-the-wing": "مستدرة مهدبة, وينترغرين مزهر (مستدرة معمرة زاحفة شائعة في شرق أمريكا الشمالية لها أوراق تشبه الوينترغرين وزهور وردية أرجوانية عادة بسبلات مجنحة)",
 "bird-scarer": "فزاعة (دمية على شكل رجل لتخويف الطيور بعيداً عن البذور)",
 "birdbath": "حوض استحمام الطيور (حوض زينة (عادة في الحديقة) لتستحم فيه الطيور)",
 "birdbrain": "أبله, عقل العصفور (شخص ذو أفكار مشوشة؛ غير قادر على التفكير الجاد)",
 "birdcage": "قفص طيور (قفص يمكن حفظ طائر فيه)",
 "birdcage mask": "قناع قفص العصفور (قناع الماسك في البيسبول ذو وجه سلكي قوي)",
 "birdcall": "صفارة طيور (جهاز لتقليد نداء الطيور) / أغنية الطائر, تغريد (الصوت المميز الذي يصدره الطائر)\nمثال: لن يتعلم الطائر أغنيته ما لم يسمعها في سن مبكرة",
 "birdeater": "عَنْكَبُوت آكِلَة الطَّيْر",
 "birder": "مراقب الطيور (شخص يتعرف على الطيور ويدرسها في بيئاتها الطبيعية)",
 "birdfeeder": "مِعْلف طيور, وحدة إطعام الطيور (جهاز خارجي يوفر الطعام للطيور البرية)",
 "birdhouse": "بيت الطيور (مأوى للطيور)",
 "birdie": "كرة الريشة (أداة في لعبة الريشة الطائرة تتكون من كرة من الفلين أو المطاط مع تاج من الريش) / بِيرْدِي",
 "birdlime": "دبق (مادة لاصقة لزجة تدهن على الأغصان الصغيرة لاصطياد الطيور الصغيرة)",
 "birdnest": "عُشُّ طَائِر (عش تضع فيه الطيور بيضها وتفرخ صغارها)",
 "birdnesting": "جمع بيض الطيور (البحث عن أعشاش الطيور للحصول على البيض)",
 "birdseed": "بذور الطيور, طعام الطيور (طعام يقدم للطيور؛ عادة ما يكون خليطاً من البذور)",
 "birdseed grass": "عشب الكناري, عشب طعام الطيور (عشب من جزر الكناري؛ تستخدم بذوره كعلف لطيور الأقفاص)",
 "birdsong": "أغنية الطائر, تغريد (الصوت المميز الذي يصدره الطائر)\nمثال: لن يتعلم الطائر أغنيته ما لم يسمعها في سن مبكرة",
 "birefringence": "انكسار مزدوج (انقسام شعاع إلى شعاعين متوازيين مستقطبين بشكل عمودي)",
 "birefringent": "مزدوج الانكسار (متعلق بالانكسار المزدوج أو يتميز به)",
 "biretta": "بيريتا (قبعة صلبة بحواف بارزة عبر التاج؛ يرتديها رجال الدين الكاثوليك)",
 "biriani": "برياني (طبق هندي مصنوع من الأرز المتبل جداً واللحم أو السمك أو الخضروات)",
 "birken": "قَضْبَانِيّ (مُكَوَّنٌ أَوْ مَصْنُوعٌ مِنْ خَشَبِ شَجَرَةِ القَضْبَانِ (البَتُولَا))",
 "birling": "دحرجة جذوع الأشجار (تدوير جذع خشبي بسرعة في الماء (كرياضة تنافسية))",
 "birmingham": "بَرْمِنْغْهَام",
 "biro": "قلم حبر جاف (قلم يحتوي على كرة معدنية صغيرة كنقطة لنقل الحبر إلى الورق)",
 "birobidzhan": "بِيرُوبِيجَان",
 "birr": "أزيز, هفيف (صوت شيء يتحرك بسرعة) / بير (وحدة المال الأساسية في إثيوبيا؛ تساوي 100 سنت)\nمثال: رفرفة أجنحة الطائر",
 "birretta": "بيريتا (قبعة صلبة بحواف بارزة عبر التاج؛ يرتديها رجال الدين الكاثوليك)",
 "birth": "وِلَادَة, مَوْلِد / وِلَادَة, بدايَة / وَلَدَ, وَضَعَ (الرجلُ و المرأةُ ومثلهما الانسان: أنجب؛ الرجلُ و المرأةُ وَلَدًا: أنجبه)\nمثال: أعرف ذلك الولد.",
 "birth canal": "قناة الولادة (ممر في الرحم والمهبل يمر عبره الجنين أثناء الولادة الطبيعية)",
 "birth certificate": "شَهَادَةُ مِيلَاد",
 "birth control": "تَحْدِيد اَلنَّسْل",
