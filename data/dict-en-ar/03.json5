 "bison bison": "بيسون أمريكي (بيسون بني كبير أشعث الشعر يعيش في سهول أمريكا الشمالية)",
 "bison bonasus": "بيسون أوروبي (بيسون أوروبي له رأس أصغر وأعلى من البيسون الأمريكي)",
 "bisontine": "بيزوني (متعلق بحيوان البيزون أو مميز له)",
 "bispak": "بيسباك (امرأة إندونيسية منحلّة جنسياً)",
 "bisque": "بيسك, حساء القشطة البحرية (حساء كريمي كثيف مصنوع من المحار)",
 "bissau": "بِيسَاو",
 "bissau-guinean franc": "فرنك غينيا بيساو (وحدة المال الأساسية في جمهورية غينيا بيساو)",
 "bissextile day": "29 فبراير, يوم كبيس (اسم اليوم الذي يُضاف خلال السنة الكبيسة)",
 "bissextile year": "سنة كبيسة (سنة تقويمية يضاف فيها يوم إضافي في شهر فبراير)",
 "bistable relay": "مرحل ماسك, مرحل نبضي (مرحل يحافظ على وضع التلامس إلى أجل غير مسمى دون تطبيق طاقة على الملف)\nمثال: يسمح المرحل الماسك بالتحكم عن بعد في إضاءة المبنى دون الطنين الذي قد ينتج عن ملف نشط باستمرار (تيار متردد)",
 "bister": "بني مصفر, بيستر (خضاب بني مصفر قابل للذوبان في الماء يصنع بغلي سخام الخشب)",
 "bistered": "بني داكن, بيستري (ملون بمادة البيستر (صبغ بني) أو كأنه ملون بها)",
 "bistre": "بني مصفر, بيستر (خضاب بني مصفر قابل للذوبان في الماء يصنع بغلي سخام الخشب)",
 "bistred": "بني داكن, بيستري (ملون بمادة البيستر (صبغ بني) أو كأنه ملون بها)",
 "bistro": "بيسترو, مقهى ومطعم صغير (مطعم صغير غير رسمي؛ يقدم النبيذ)",
 "bistroic": "بيستروي, متعلق بالمقاهي الصغيرة (متعلق بمقهى صغير (بيسترو) أو يشبهه)",
 "bisulcate": "ذُو حَافِرٍ مَشْقُوق, مَشْقُوق ((يُستخدم للحوافر) مُنشَقّ إلى شِقَّيْن)",
 "bisulfate": "بيكبريتات, كبريتات الهيدروجين",
 "bit": "بِت (انقطع؛ قَطَع)",
 "bit by bit": "تدريجياً, خطوة بخطوة (بطريقة تدريجية) / تدريجياً, شيئاً فشيئاً (جزءاً صغيراً في كل مرة)\nمثال: تحرك الثعبان تدريجياً نحو ضحيته",
 "bit field": "حقل بتات (حقل يحتوي فقط على أحرف ثنائية)",
 "bit part": "دور ثانوي, دور صغير (دور صغير)",
 "bit rate": "معدل البتات (عدد البتات التي يتم نقلها أو معالجتها لكل وحدة زمنية)",
 "bit-by-bit": "تَدْرِيجِيًّا, خُطْوَة بِخُطْوَة (شيء واحد في كل مرة؛ على مراحل صغيرة)",
 "bitartrate": "بيطرطرات (طرطرات حمضية؛ طرطرات هيدروجينية)",
 "bitch": "ثَعْلَبَة, كَلْبَة (مؤنث ثَعْلَب؛ اسم لمَرَض يصيب فروة الرأس ويسبب سقوط الشعر والصَلَع) / قَحْبَة, سَلِيطَة",
 "bitchery": "خبث, لؤم (ملاحظات وسلوك عدواني يشبه سلوك امرأة حاقدة خبيثة)",
 "bitchiness": "خبث, لؤم (الخبث الناتج عن كون الشخص حقودًا أو سيئ الطبع)",
 "bitchy": "لَئِيم, لَذَّاع (يتسم بالخبث أو ناتج عنه)",
 "bite": "عَضَّ, قَضَمَ / عَضَّ / قَرْصة / لُقْمة",
 "bite off more than one can chew": "قَضَمَ أَكْثَرَ مِمَّا يَسْتَطِيعُ مَضَغَهُ",
 "bite plate": "صفيحة عض (جهاز سني قابل للإزالة يتم ارتداؤه في الحنك لأغراض تشخيصية أو علاجية)",
 "biteplate": "صفيحة عض (جهاز سني قابل للإزالة يتم ارتداؤه في الحنك لأغراض تشخيصية أو علاجية)",
 "biter": "عَاضّ (شخص يقوم بالعض)",
 "bitewing": "فيلم أشعة سينية مجنح (فيلم أشعة سينية للأسنان يمكن تثبيته بواسطة الأسنان أثناء التصوير الشعاعي)",
 "bitey": "عضاض (لديه ميل للعض بعدوانية)",
 "bithynia": "بِيثِينِيَا",
 "biting": "عَضَّة / قَارِس / لَاذِع, جَارِح / عَقُور, لَاسِع",
 "biting louse": "قمل الطيور, قمل قارض (حشرة عديمة الأجنحة بأجزاء فم مهيأة للعض؛ تتطفل غالباً على الطيور)",
 "biting midge": "هاموش (حشرة دقيقة ذات جناحين تمتص دماء الثدييات والطيور والحشرات الأخرى)",
 "bitingly": "بشكل ثاقب, بشكل قارص (بشكل شديد وحاد جداً)\nمثال: كان الجو بارداً بشكل لاذع",
 "bitis arietans": "أفعى نافخة (أفعى أفريقية كبيرة تنفخ جسمها عند الانزعاج)",
 "bitis gabonica": "أفعى الغابون (أفعى كبيرة ثقيلة الجسم ذات علامات رائعة وشديدة السمية من غرب أفريقيا)",
 "bitmap": "خريطة بتات, صورة نقطية (صورة ممثلة كمصفوفة ثنائية الأبعاد لقيم السطوع للبكسلات)",
 "bitok": "بيتوك (طبق روسي مصنوع من أقراص اللحم المفروم (المخلوط بالبصل والخبز والحليب) ويُقدم مع صلصة القشدة الحامضة)",
 "bits per inch": "بت في البوصة (مقياس لمدى كثافة المعلومات المخزنة على وسيط تخزين)",
 "bits per second": "بِت فِي الثَّانِيَة ((علم الحاسوب) المعدل الذي يتم به نقل البيانات (كما هو الحال عن طريق المودم))",
 "bitstock": "مثقاب يدوي, مِلفاف (أداة نجار لها مقبض تدوير ومقبس لتثبيت ريشة الثقب)",
 "bitt": "عمود حاجز, مربط (عمود قوي (كما في رصيف الميناء أو السفينة لربط حبال الإرساء))\nمثال: أغلق الطريق أمام حركة المركبات باستخدام الأعمدة الحاجزة",
 "bitt pin": "مسمار المربط (مسمار يمر عبر رأس المربط لمنع حبال الإرساء من الانزلاق)",
 "bitter": "مُرّ (فَاتَ ومَضَى؛ الحدثُ أو الأمرُ: حدث وانتهى) / أَلِيم / مَقِيت, مَمْقُوت (مَقيت: ( اسم )؛ مُقِيت: ( اسم ))\nمثال: مر زيري بجانبي.",
 "bitter almond": "لوز مر (أشجار لوز لها أزهار بيضاء ومكسرات سامة تنتج زيتاً يستخدم للنكهة ولأغراض طبية)",
 "bitter almond oil": "زيت اللوز المر (زيت عطري أصفر شاحب يتم الحصول عليه من اللوز المر بالتقطير)",
 "bitter aloes": "صبار, صبار مر (مسهل مصنوع من أوراق الصبار)",
 "bitter cassava": "بفرة, كسافا مرة (كسافا ذات جذور درنية طويلة صالحة للأكل وسيقان هشة ناعمة؛ تستخدم خاصة لصنع الكاسيري (مشروب مسكر) والتابيوكا)",
 "bitter chocolate": "شوكولاتة خام, شوكولاتة للخبز (شوكولاتة نقية غير محلاة تستخدم في الخبز والتغطيات السكرية والصلصات والحلوى)",
 "bitter cress": "حرف, رشاد مر (طَرَف وَجَانِب وَحَدّ؛ رَمْز مخطوط أو مطبوع يقوم مقام صوت أو كلمة أو عبارة أو معنى)\nمثال: ألف هو الحرف الأول للألف باء.",
 "bitter dock": "حميض أصفر, حميض عريض الأوراق (حميض أوروبي بأوراق عريضة منفرجة وجذمور مر شائع كعشب ضار في أمريكا الشمالية)",
 "bitter end": "الطرف الداخلي للحبل, الطرف المرير ((ملاحي) الطرف الداخلي لخط أو كابل وخاصة الطرف الملتف حول مربط الحبال) / رمق أخير, نهاية مريرة (الغاية القصوى النهائية (مهما كانت غير سارة))\nمثال: كان مصمماً على القتال حتى النهاية المريرة",
 "bitter floom": "قرنفل المستنقعات, قنطريون أمريكي (أي من عدة نباتات مستنقعات زهرية اللون من شرق الولايات المتحدة تشبه القنطريون الحقيقي)",
 "bitter hickory": "جوز مر (جوز من شرق الولايات المتحدة له أوراق بـ 7 أو 9 وريقات ومكسرات مرة جداً رقيقة القشرة)",
 "bitter lemon": "ليمون مر (مشروب غازي لاذع بنكهة الليمون)",
 "bitter melon": "قَاوُون",
 "bitter orange": "نَارِنْج",
 "bitter orange tree": "برتقال إشبيلية, برتقال حامض (أي من أشجار البرتقال الشائعة المختلفة التي تنتج فاكهة حامضة أو مرة؛ تستخدم كأصل للتطعيم)",
 "bitter pea": "بازلاء مرة (أي من الشجيرات الشائكة المتعددة من جنس دافيسيا، لها زهور صفراء وبذور مثلثة؛ موطنها أستراليا)",
 "bitter pecan": "بيكان مر, جوز الماء (جوز من جنوب الولايات المتحدة له العديد من الوريقات الضيقة ومكسرات مرة نوعاً ما)",
 "bitter pignut": "جوز مر (جوز من شرق الولايات المتحدة له أوراق بـ 7 أو 9 وريقات ومكسرات مرة جداً رقيقة القشرة)",
 "bitter principle": "مادة مرة, مبدأ مر (أي من مئات المركبات ذات الطعم المر؛ ولا تندرج تحت تصنيف كيميائي محدد)",
 "bitter salts": "الملح الإنجليزي, ملح إبسوم (كبريتات المغنيسيوم المائية التي تؤخذ عن طريق الفم لعلاج حرقة المعدة والإمساك أو تحقن لمنع النوبات)",
 "bitter spar": "دولوميت (معدن فاتح اللون يتكون من كربونات الكالسيوم والمغنيسيوم؛ مصدر للمغنيسيوم؛ يستخدم كخزف وكسماد)",
 "bitter vetch": "كَرْسَنَّة",
 "bitter-bark": "شجرة الحمى, لحاء جورجيا (شجيرة زينة أو شجرة صغيرة في المناطق المستنقعية في جنوب غرب الولايات المتحدة لها كؤوس كبيرة وردية أو بيضاء وتنتج لحاء جورجيا لعلاج الحمى)",
 "bittercress": "حرف, رشاد مر (طَرَف وَجَانِب وَحَدّ؛ رَمْز مخطوط أو مطبوع يقوم مقام صوت أو كلمة أو عبارة أو معنى)\nمثال: ألف هو الحرف الأول للألف باء.",
 "bitterish": "لَاذِع, مَائِلٌ لِلمَرَارَة (مُرٌّ بَعْضَ الشَّيْء)",
 "bitterly": "بمرارة (بمرارة؛ بطريقة مستاءة) / بشدة, بمرارة (تشير إلى شيء صعب القبول) / بشكل ثاقب, بشكل قارص (بشكل شديد وحاد جداً)\nمثال: اشتكت بمرارة",
 "bittern": "واق (بلشون صغير نسبياً مدمج الجسم بني أسمر ذو عادات ليلية وصرخة مدوية؛ يوجد في المستنقعات)",
 "bitterness": "مَرَارَة",
 "bitternut": "جوز مر (جوز من شرق الولايات المتحدة له أوراق بـ 7 أو 9 وريقات ومكسرات مرة جداً رقيقة القشرة)",
 "bitternut hickory": "جوز مر (جوز من شرق الولايات المتحدة له أوراق بـ 7 أو 9 وريقات ومكسرات مرة جداً رقيقة القشرة)",
 "bitterroot": "جذر مر, لويزيا متجددة (نبات عصاري مبهرج يعانق الأرض في مناطق جبال روكي له أزهار وردية عميقة إلى باهتة وجذور نشوية لحمية؛ زهرة ولاية مونتانا)",
 "bitters": "بيترز, مشروب مر (مشروب كحولي منكه بأعشاب وجذور مرة)",
 "bittersweet": "حُلْو وَمُرّ, حُلْوَة وَمُرَّة (متَّصِف بالحلاوة، وهي ذوق أساسي يُشعر به غالبًا عند تناول الأكلات الغنية بالسكر، ويرتبط بشكل عام باللذة، إلا عندما يتم التفريط به)\nمثال: الكعكة حلوة جدا",
 "bittersweet chocolate": "شوكولاتة داكنة, شوكولاتة نصف محلاة (سائل شوكولاتة مع زبدة كاكاو وكميات صغيرة من السكر والفانيليا؛ يضاف الليسيثين عادة)",
 "bittersweet nightshade": "عنب الديب, مغد حلو ومر (كرمة معمرة سامة من العالم القديم لها زهور بنفسجية وتوت أحمر مرجاني بيضاوي؛ عشب ضار واسع الانتشار في أمريكا الشمالية)",
 "bitterweed": "أمبروزية, دمسيسة (أي من العديد من النباتات الضارة في أمريكا الشمالية التي تشكل جنس الأمبروزية والتي تنتج حبوب لقاح مسببة للحساسية الشديدة المسؤولة عن الكثير من حمى…) / بيكريس, لسان الثور (عشب ضار أوروبي واسع الانتشار ذو أوراق شائكة تشبه اللسان وأزهار صفراء؛ مستوطن في الولايات المتحدة)",
 "bitterwood": "سيماروبا زرقاء, شجرة الفردوس (شجرة متوسطة إلى كبيرة الحجم في أمريكا الشمالية والجنوبية الاستوائية ذات أوراق ريشية فردية وعناقيد طويلة من الزهور الصفراء الشاحبة الصغيرة تليها ثمار…) / بيكراسما سامقة, كواسيا جامايكية (شجرة في جزر الهند الغربية تنتج عقار الكواسيا الجامايكي) / كواسيا, كواسيا مرة (شجيرة أو شجرة صغيرة جميلة في أمريكا الجنوبية ذات زهور قرمزية زاهية وتنتج خشباً قيماً ناعم الحبيبات مصفراً؛ يُستخرج منها عقار الكواسيا المر من خشبها…)",
 "bitterwood tree": "شجرة الخشب المر (أي من الأشجار أو الشجيرات المتنوعة من الفصيلة السيماروبية ذات خشب ولحاء بطعم مر)",
 "bitthead": "رأس المربط (الطرف العلوي لمربط الحبال)",
 "bittie": "صَغِيرُوت, ضَئِيل ((غير رسمي) صغير جداً أو ضئيل)",
 "bitty": "صَغِيرُوت, ضَئِيل ((غير رسمي) صغير جداً أو ضئيل)",
 "bitumastic": "طلاء بتيوميني (طبقة واقية من الأسفلت والفلتر تستخدم على المعادن الإنشائية المعرضة للعوامل الجوية)",
 "bitumen": "أسفلت, بيتومين (أي من خلائط الهيدروكربونات غير النقية الموجودة بشكل طبيعي)",
 "bitumenoid": "شبيه بالقار (يشبه القار)",
 "bituminoid": "شبيه بالقار (يشبه القار)",
 "bituminous": "زفتي, قاري (يشبه أو يحتوي على القار (البيتومين))\nمثال: فحم قاري",
 "bituminous coal": "فحم بتوميني, فحم قاري (فحم غني بالهيدروكربونات القطرانية؛ يحترق بسهولة بلهب أصفر مدخن)",
 "biu-mandara": "بيو-ماندارا (مجموعة من اللغات التشادية يتم التحدث بها في المنطقة الحدودية بين الكاميرون ونيجيريا جنوب بحيرة تشاد)",
 "bivalent": "ثنائي التكافؤ, مزدوج (يستخدم للكروموسومات المتماثلة المرتبطة في أزواج أثناء التشابك الصبغي) / ثنائي التكافؤ (لديه تكافؤ اثنين أو لديه تكافؤين)",
 "bivalve": "ذوات الصدفتين (رخويات بحرية أو مياه عذبة لها جسم رخو مع خياشيم تشبه الصفائح محاطة بصدفتين مفصليتين معاً) / ثنائي الصدفة (يستخدم للرخويات التي لها صدفتان (مثل المحار وغيرها))",
 "bivalved": "ثنائي الصدفة (يستخدم للرخويات التي لها صدفتان (مثل المحار وغيرها))",
 "bivariate": "ثنائي المتغير (لديه متغيرين)\nمثال: توزيع ثنائي الحد ثنائي المتغير",
 "bivouac": "مخيم, معسكر (أماكن معيشة مؤقتة بناها الجيش خصيصاً للجنود) / مخيم, موقع تخييم (موقع يمكن للأشخاص في العطلة نصب خيمة فيه)\nمثال: أينما ذهب في المعسكر كان الرجال يتذمرون",
 "bivouacking": "تخييم, معسكر (فعل التخييم والعيش في الخيام)",
 "biweekly": "كُلّ أُسْبُوعَيْن (كل أسبوعين) / مَرَّتَيْن فِي الأُسْبُوع (مرتين في الأسبوع) / نِصْفُ أُسْبُوعِيّ (يحدث مرتين في الأسبوع) / نِصْفُ شَهْرِيّ (يحدث كل أسبوعين)\nمثال: زار أبناء عمومته كل أسبوعين",
 "biyearly": "مَرَّتَيْن فِي السَّنَة, نِصْف سَنَوِيًّا (مرتين في السنة) / كُلّ سَنَتَيْن (كل عامين) / نِصْفُ سَنَوِيّ (يحدث أو يُدفع مرتين في السنة) / كُلَّ سَنَتَيْنِ (يحدث كل سنتين)\nمثال: يقام هذا المهرجان كل سنتين",
 "biz": "صنعة, مجال عمل (مهنتك أو مجال عملك)\nمثال: هو يعمل في مجال السباكة",
 "bizarre": "شَاذّ, عَجِيب (غَيْرُ تَقْلِيدِيٍّ أَوْ غَيْرُ مَأْلُوفٍ بِشَكْلٍ لَافِتٍ لِلنَّظَر)",
 "bizarreness": "شُذُوذ, غَرَابَة شَدِيدَة (الخروج عن المألوف بشكل لافت للنظر)",
 "bize": "الرياح الشمالية الباردة, بيز (رياح شمالية باردة وجافة في جنوب شرق فرنسا)",
 "bizerte": "بِنْزَرْت",
 "bizonal": "ثنائي المنطقة (متعلق بـ أو معني بالشؤون المشتركة لمنطقتين إداريتين)\nمثال: استخدمت العملة ثنائية المنطقة في ألمانيا المحتلة بعد الحرب العالمية الثانية",
 "bja": "مكتب المساعدة القضائية (المكتب في وزارة العدل الذي يساعد أنظمة العدالة الجنائية المحلية لتقليل أو منع الجريمة والعنف وتعاطي المخدرات)",
 "bjs": "مكتب إحصاءات العدالة (الوكالة في وزارة العدل التي تعد المصدر الرئيسي لإحصاءات العدالة الجنائية لصانعي السياسات الفيدراليين والمحليين)",
 "bk": "بيركيليوم (عنصر مشع ما بعد اليورانيوم؛ اكتشف بقصف الأمريسيوم بالهيليوم)",
 "blabber": "مخبر, واشٍ (من يكشف معلومات سرية للشرطة أو سلطة أخرى)",
 "blabbermouth": "نمّام, واشٍ (شخص يثرثر بشكل غير حكيم)",
 "blabbermouthed": "ثَرْثَار, مُفْشِي أَسْرَار (يميل إلى إفشاء المعلومات السرّيّة) / ثَرْثَار, كَثِير الكَلَام (يَتَكَلَّم كَثِيرًا بِغَيْر حِكْمَة)",
 "blabby": "ثَرْثَار, كَثِير الكَلَام (يَتَكَلَّم كَثِيرًا بِغَيْر حِكْمَة)",
 "black": "أَسْوَد, سَوْدَاء (هو لَوْن مُظلم غَامِق لا يُبان منه. سميّ كذلك لأنه يسود على غيره من الألوان لظلامه؛ هو انعدام اللَوْن) / أَسْوَد (هو لَوْن مُظلم غَامِق لا يُبان منه. سميّ كذلك لأنه يسود على غيره من الألوان لظلامه؛ هو انعدام اللَوْن) / زِنْجِيّ, زَنْجِيّ / أَسْوَد, أسود (هو لَوْن مُظلم غَامِق لا يُبان منه. سميّ كذلك لأنه يسود على غيره من الألوان لظلامه؛ هو انعدام اللَوْن)\nمثال: لديه قميص أسود.",
 "black african": "أَفْرِيقِيّ أَسْوَد (شخص أفريقي ذو بشرة سوداء)",
 "black american": "أفرو-أمريكي, أمريكي إفريقي (أمريكي من أصول ولدت في إفريقيا)",
 "black and gold garden spider": "عنكبوت الحديقة الأسود والذهبي (عنكبوت حديقة أمريكي شمالي واسع الانتشار)",
 "black and tan": "بلاك آند تان (مجند إنجليزي (كان يرتدي زياً أسود وبنياً) خدم في الشرطة الأيرلندية لقمع تمرد شين فين من 1919 إلى 1921)",
 "black and white": "صورة أبيض وأسود, صورة أحادية اللون (صورة فوتوغرافية أو شريحة بالأبيض والأسود) / تَوَاصُل كِتَابِيّ, لُغَة مَكْتُوبَة (التواصل بوساطة رموز مكتوبة، سواء أكانت مطبوعة أم مخطوطة)",
 "black angus": "أبردين أنغوس, أنغوس (سلالة سوداء عديمة القرون من اسكتلندا)",
 "black apricot": "مشمش أرجواني (مشمش هجين صغير من آسيا وآسيا الصغرى له غصينات أرجوانية وزهور بيضاء تليها فاكهة أرجوانية رديئة)",
 "black archangel": "بلوطة, فراسيون أسود (عشب أوروبي كريه الرائحة بأوراق مجعدة ودوامات من الزهور الأرجوانية الداكنة)",
 "black art": "دجل, سحر أسود (الاعتقاد في تعاويذ سحرية تسخر قوى خفية أو أرواحاً شريرة لإحداث تأثيرات غير طبيعية في العالم)",
 "black ash": "مران أسود (شجرة أمريكية شمالية قوية الانتشار لها خشب ثقيل بني داكن؛ تتحول الأوراق إلى الذهب في الخريف)",
 "black bamboo": "خيزران أسود (خيزران صغير له سيقان خضراء رقيقة تتحول إلى اللون الأسود اللامع)",
 "black bass": "باس أسود (أسماك رياضية أمريكية تعيش في المياه العذبة واسعة الانتشار وذات قيمة عالية (فصيلة سمكة الشمس)) / قاروص البحر الأسود (قاروص بحر مخطط باللون الأسود المزرق من ساحل المحيط الأطلسي للولايات المتحدة)",
 "black bead": "خرز أسود, مخلب القط (شجيرة منتصبة ذات أشواك صغيرة إن وجدت، ولها عناقيد من الزهور البيضاء إلى الصفراء تليها قرون منحنية مدببة وبذور سوداء لامعة؛ جزر الهند الغربية وفلوريدا)",
 "black bean": "فاصولياء سوداء (فاصولياء سوداء البذور من أمريكا الجنوبية؛ عادة ما تكون مجففة)",
 "black bear": "دب أسود أمريكي (دب بني إلى أسود من أمريكا الشمالية؛ أصغر وأقل شراسة من الدب البني) / دب أسود آسيوي (دب ذو معطف أسود يعيش في وسط وشرق آسيا)",
 "black bearberry": "عنب الدب الألبي, قطلب ألبي (شجيرة زاحفة متساقطة الأوراق تكون حمراء زاهية في الخريف ولها توت أسود أو أزرق مسود؛ ألبية وقطبية)",
 "black bee": "نحل أسود, نحل ألماني (نحل عسل داكن اللون سيء المزاج يُفترض أنه من أصل ألماني)",
 "black beech": "زان أسود (شجرة غابات نيوزيلندية)",
 "black belt": "حِزَام أَسْوَد (خيط أو قطعة من جلد تستخدم لحَزْم النَبَات أو العِيدَان أو غيرها لتكوين حُزْمَة؛ النِطَاق، قطعة من الجِلْد الطَوِيل يلف حول الخَصْر إما ليمسك المَلابِس أو ليظهر الخصر)\nمثال: هذا حزام من الجلد.",
 "black bile": "سَوْدَاء (مؤنث أَسْوَد، ما كان لونها السَوَاد)\nمثال: أرى نقاطآ سوداء.",
 "black bindweed": "تاموس شائع, كرمة سوداء (كرمة أوروبية شائعة ملتفة ذات جذور درنية وأوراق قلبية الشكل وثمار لبية حمراء)",
 "black birch": "بتولا سوداء, بتولا نهرية (بتولا المستنقعات وقيعان الأنهار في جميع أنحاء شرق الولايات المتحدة لها لحاء بني محمر) / بتولا حلوة, بتولا كرزية (بتولا شائعة في شرق الولايات المتحدة لها لحاء بني حار ينتج زيتاً طياراً وخشباً داكناً صلباً يستخدم للأثاث)",
 "black body": "جِسْم أَسْوَد (جسم افتراضي قادر على امتصاص كل الإشعاع الكهرومغناطيسي الساقط عليه)\nمثال: الجسم الأسود المحافظ على درجة حرارة ثابتة هو مشع كامل عند تلك الدرجة لأن الإشعاع الواصل إليه والمغادر له يجب أن يكون في توازن",
 "black book": "قائمة سوداء (قائمة بالأشخاص المغضوب عليهم)",
 "black box": "صُنْدُوق أَسْوَد (وعاء كبيرة من الخشب غالبا وقد يكون حديدًا يستخدم لوضع الاشياء داخله، ويكون لها عادة جهة قابلة للفتح سواء بمفاصل او بالازالة الكاملة؛ صُنْدُوْقُ السَيَّارَة قمرة تشبه الصندوق في الجزء الخلفي من السيارة يستخدم كالصندوق)\nمثال: أين صندوق البريد؟",
 "black bread": "بومبرنيكل, خبز أسود (خبز مصنوع من دقيق الجاودار الخشن)",
 "black bream": "دنيس أسود (سمكة غذائية ورياضية مهمة داكنة اللون في أستراليا)",
 "black bryony": "تاموس شائع, كرمة سوداء (كرمة أوروبية شائعة ملتفة ذات جذور درنية وأوراق قلبية الشكل وثمار لبية حمراء)",
 "black buck": "ظبي أسود (ظبي هندي شائع ذو ظهر داكن وقرون لولبية)",
 "black buffalo": "جاموس أسود (سمكة في المسيسيبي السفلي)",
 "black calla": "كالا سوداء, لوف فلسطيني (نبات زينة من الشرق الأوسط يزرع لقنابته الأرجوانية الداكنة)",
 "black caraway": "شُونِيز / كَمُّون أَسْوَد / حَبَّةُ سَوْدَاءُ (واحدة الحَبّ؛ البَذْرَة، لأنها صغيرة مثل الحبة) / قِزْح\nمثال: أكلت حبة طماطم.",
 "black carpet beetle": "خنفساء السجاد السوداء (خنفساء سجاد ذات لون أسود خالص)",
 "black cat": "القطة السوداء",
 "black catechu": "كاتشو أسود (مستخلص من قلب خشب شجر السنط الكادي يستخدم للصباغة والدباغة وحفظ شباك الصيد والأشرعة؛ كان يستخدم طبياً في السابق)",
 "black cherry": "كرز حلو (أي من عدة فواكه لأشجار الكرز المزروعة التي لها لحم حلو) / كرز أسود, كرز الروم (كرز بري كبير من أمريكا الشمالية بفاكهة سوداء حامضة مستديرة صالحة للأكل)",
 "black cherry tree": "كرز أسود, كرز الروم (كرز بري كبير من أمريكا الشمالية بفاكهة سوداء حامضة مستديرة صالحة للأكل)",
 "black cock": "ديك الطيهوج الأسود (ذكر الطيهوج الأسود)",
 "black coffee": "قَهْوَة سَوْدَاء (مشروب يحضر بغلي مطحون البُنّ؛ المحل أو الدكان الذي تُقدَّم فيه القهوة وغيرها من المشروبات)\nمثال: لا أفضل القهوة.",
 "black cohosh": "جذر الثعبان الأسود, كوهوش أسود (نبات البق توت من أمريكا الشمالية يوجد من ماين وأونتاريو إلى ويسكونسن وجنوباً إلى جورجيا)",
 "black comedy": "كوميديا سوداء (كوميديا تستخدم الفكاهة السوداء)",
 "black cottonwood": "خشب القطن الأسود (خشب قطن من غرب أمريكا الشمالية بأوراق خضراء داكنة لامعة من الأعلى وصدئة أو فضية من الأسفل) / خشب القطن المستنقعي (حور من أمريكا الشمالية بأوراق كبيرة مستديرة صدفيّة ولحاء وخشب بني)",
 "black crappie": "كرابي أسود (نوع من سمك الكرابي لونه أسود)",
 "black currant": "كشمش أسود (توت أسود صغير يستخدم في المربيات والهلام) / ريباس أسود, كشمش أسود (كشمش مزروع على نطاق واسع يحمل ثماراً سوداء عطرية صالحة للأكل)",
 "black cypress pine": "صنوبر السرو الأسود (شجرة أسترالية ذات قشور صغيرة مسطحة كأوراق وبذور عديدة بنية داكنة؛ تُثمن لخشبها وراتنجها)",
 "black death": "الطّاعُونُ, مَوْت أَسْوَد",
 "black diamond": "ألماس أسود, كربونادو (ألماس داكن أقل جودة يستخدم صناعياً للحفر والتلميع)",
 "black disease": "تعفن الكبد (مرض في الكبد (خاصة في الأغنام والماشية) تسببه المثقوبات الكبدية ومنتجاتها الثانوية)",
 "black duck": "بط أسود, بطة سوداء (بط داكن اللون يعيش في شمال شرق الولايات المتحدة وكندا)",
 "black economy": "اقتصاد أسود, اقتصاد الظل (قطاع خفي من الاقتصاد تجري فيه معاملات نقدية خاصة غير معلن عنها)\nمثال: لا أحد يعرف الحجم الحقيقي لاقتصاد الظل",
 "black elder": "بيلسان أسود, خمان أسود (شجيرة شائعة بفاكهة سوداء أو شجرة صغيرة من أوروبا وآسيا؛ تستخدم الفاكهة للنبيذ والمربيات)",
 "black elderberry": "بيلسان أمريكي, خمان كندي (بيلسان شائع في وسط وشرق أمريكا الشمالية يحمل توتاً أرجوانياً أسود؛ تستخدم الفاكهة في النبيذ والمربيات)",
 "black english": "إيبونيكس, الإنجليزية الأمريكية الأفريقية (شكل غير قياسي من الإنجليزية الأمريكية يتحدث به بشكل مميز الأمريكيون من أصل أفريقي في الولايات المتحدة)",
 "black english vernacular": "إيبونيكس, الإنجليزية الأمريكية الأفريقية (شكل غير قياسي من الإنجليزية الأمريكية يتحدث به بشكل مميز الأمريكيون من أصل أفريقي في الولايات المتحدة)",
 "black eye": "عَيْن سَوْدَاء (المُعَايَنَة والمشاهدة؛ العين : حاسة البصر والرؤية - مؤنث - تكون للإنسان وغيره من الحيوان . قال ابن السكيت : العين التي يبصر بها الناظر…)\nمثال: كان عين ليلى مسودة.",
 "black felt cup": "كأس اللباد الأسود (نوع من ساركوسوماتاسيا (بليكتانيا نانفيلدتي))",
 "black flag": "العلم الأسود, علم القراصنة (علم يحمل عادة جمجمة بيضاء وعظمتين متقاطعتين على خلفية سوداء؛ يشير إلى سفينة قراصنة)",
 "black fly": "ذبابة سوداء (ذبابة لاسعة صغيرة مسودة ممتلئة الجسم لها يرقات مائية؛ تمتص دماء الطيور وكذلك البشر والثدييات الأخرى)",
 "black forest": "الْغَابَة السَّوْدَاء",
 "black forest gâteau": "كَعْكَة الْبْلَاك فُورِسْت (واحدة الكَعْك؛ حَلْوَى تُصْنع من الدَقِيق والحَلِيب والسُكَّر والزَيت ويخبز طريًا وقد يوضع عليه القِشْطَة. يُسمى عند البعض كَيْك وعند البعض تُورْتَة)\nمثال: خبزت كعكة لتوم.",
 "black fox": "ثعلب أسود (ثعلب أحمر في الطور اللوني الذي يكون فيه فراءه أسود في الغالب)",
 "black friar": "دومينيكاني, راهب أسود (راهب روماني كاثوليكي يرتدي العباءة السوداء للرهبنة الدومينيكانية)",
 "black friday": "الْجُمُعَة السَّوْدَاء, الجُمُعَة الْبَيْضَاء",
 "black fritillary": "أجراس المهمة, فريتيلاريا سوداء (عشبة من جنوب غرب الولايات المتحدة ذات أزهار أرجوانية داكنة على شكل جرس مرقطة بالأخضر)",
 "black grama": "غراما سوداء (عشبة مراعي (خاصة في المناطق الساحلية الغربية لأمريكا الشمالية))",
 "black greasewood": "خشب الشحم, خشب الشحم الأسود (شجيرة شائكة منخفضة كثيرة التفرع شائعة في التربة القلوية بغرب أمريكا)",
 "black grouse": "طيهوج أسود (طيهوج يكون الذكر فيه أسود مزرق)",
 "black guillemot": "غلموت أسود, مور أسود (غلموت شمال الأطلسي)",
 "black gum": "مالي أسود (مالي صغير بلحاء خشن داكن اللون نحو القاعدة؛ ينتج صمغ كينو أوكالبتوس أحمر) / صمغ أسود, صمغ حامض (شجرة عمودية من شرق أمريكا الشمالية لها أطراف أفقية وأوراق صغيرة تظهر متأخرة في الربيع وتكتسب لوناً رائعاً في أوائل الخريف)",
 "black hand": "اليد السوداء (جمعية إرهابية سرية في الولايات المتحدة في أوائل القرن العشرين)",
 "black haw": "رباطية خوخية الورق, زعرور أسود (شجيرة نفضية منتصبة لها ثمار زرقاء داكنة مغطاة بطبقة شمعية؛ شرق وشرق وسط أمريكا الشمالية) / بوميلية صوفية, نبق كاذب (شجرة متساقطة الأوراق في جنوب شرق الولايات المتحدة والمكسيك)",
 "black hellebore": "خربق أسود, وردة عيد الميلاد (نبات أوروبي دائم الخضرة ذو أزهار شتوية بيضاء أو أرجوانية تشبه الورد) / خربق مشرقي, وردة الصوم (نبات معمر مشعر قليلاً له أوراق جلدية خضراء داكنة وأزهار تصبح في النهاية خضراء أرجوانية)",
 "black hemlock": "تسوغا جبلية (شجرة دائمة الخضرة كبيرة من غرب الولايات المتحدة؛ خشبها أصلب بكثير من التسوغا الكندية)",
 "black henbane": "بنج, بنج أسود (عشب سام منتن من العالم القديم له أوراق مشعرة لزجة وأزهار بنية صفراء؛ ينتج الهيوسيامين والسكوبولامين)",
 "black hickory": "جوز أسود (شجرة جوز من أمريكا الشمالية بخشب داكن صلب وجوز صالح للأكل) / جوز الخنزير (شجرة جوز أمريكية لها مكسرات مرة) / جوز موكرنت (جوز من أمريكا الشمالية أملس اللحاء بـ 7 إلى 9 وريقات يحمل جوزة صالحة للأكل صلبة القشرة)",
 "black hole": "ثُقْب أَسْوَد (فَجَّرَ أو خَرَقَ شيئًا بفتح فيه؛ نَفَذَ أو مرَّ عبر شيء)\nمثال: انه ثقب الاسود.",
 "black hollander": "صفصاف اللوز (صفصاف من العالم القديم بأوراق خضراء فاتحة يزرع للاستخدام في صناعة السلال)",
 "black horehound": "بلوطة, فراسيون أسود (عشب أوروبي كريه الرائحة بأوراق مجعدة ودوامات من الزهور الأرجوانية الداكنة)",
 "black huckleberry": "عنب الأحراش الأسود (شجيرة منخفضة من شرق الولايات المتحدة تحمل ثماراً سوداء لامعة صالحة للأكل؛ أشهر أنواع عنب الأحراش)",
 "black humor": "فكاهة سوداء, كوميديا سوداء (تجاور العناصر المرضية والهزلية (في الكتابة أو الدراما) لإعطاء تأثير مزعج)",
 "black humour": "فكاهة سوداء, كوميديا سوداء (تجاور العناصر المرضية والهزلية (في الكتابة أو الدراما) لإعطاء تأثير مزعج)",
 "black ice": "جَلِيد أَسْوَد",
 "black kite": "حدأة سوداء (حدأة داكنة من العالم القديم تتغذى بشكل رئيسي على الجيف)",
 "black knapweed": "قنطريون أسود (نبات معمر عشبي بسيقان سلكية قوية وزهور أرجوانية؛ موطنه أوروبا ولكنه متوطن على نطاق واسع)",
 "black knot": "عقدة سوداء (مرض يصيب أشجار البرقوق والكرز يتميز بنتوءات سوداء على الفروع)",
 "black larch": "أرزية أمريكية, تاماراك (أرزية متوسطة الحجم من كندا وشمال الولايات المتحدة بما في ذلك ألاسكا لها تاج مخروطي عريض ولحاء حرشفي بني صدئ)",
 "black lead": "رصاص أسود, غرافيت (يُستخدم كمواد تشحيم وكمهدئ في المفاعلات النووية)",
 "black letter": "حروف سوداء, قوطي (نمط خط ثقيل استخدم من القرن الخامس عشر إلى الثامن عشر)",
 "black lives matter": "حَيَاةُ السُّودِ مُهِمَّة (الحَياة: ضد الموت والحَيُّ: ضدُّ الميّت؛ والمَحْيا مَفْعَلٌ من الحياة. تقول: مَحْيَاي ومماتي. والجمع الحَحايي)\nمثال: ما أغرب الحياة!",
 "black locust": "شَجَرَةُ الْجَرَادِ, سَنْطٌ كَاذِبٌ (نبات قائم على سَاق صلبة؛ مخطط له تفرعات)\nمثال: أنا تحت الشجرة.",
 "black lotion": "غسول أسود (خليط من الكالوميل وماء الجير يستخدم على القروح الزهرية)",
 "black lovage": "ألكسندر, سميرنيوم (عشب أوروبي يشبه الكرفس إلى حد ما ومستوطن على نطاق واسع في المناطق الساحلية البريطانية ويزرع غالباً كبقلة)",
 "black lung": "رئة سوداء, سحار فحم (مرض رئوي ناجم عن استنشاق غبار الفحم)",
 "black lung disease": "رئة سوداء, سحار فحم (مرض رئوي ناجم عن استنشاق غبار الفحم)",
 "black magic": "سِحْر أَسْوَد (ألقى السحر على شخص أو شيء، بمعنى جعله تحت تأثير السحر؛ أدهش أو أبهر بجمال أو جاذبية غير عادية)\nمثال: هذا هو سحر الجزائر.",
 "black maire": "مايري أسود (شجرة من شمال نيوزيلندا لها خشب بني فاتح صلب كثيف)",
 "black mallee": "مالي أسود (مالي صغير بلحاء خشن داكن اللون نحو القاعدة؛ ينتج صمغ كينو أوكالبتوس أحمر)",
 "black man": "رجل أسود (رجل أسود البشرة)",
 "black mangrove": "أفيسينيا مارينا, قرم أسود (مانغروف في جزر الهند الغربية وساحل فلوريدا الجنوبي؛ يوجد في غابات كثيفة وله جذور قصيرة عديدة تنحني لأعلى من الأرض) / مانغروف أسود (شجرة أسترالية تشبه المانغروف الأسود في جزر الهند الغربية وفلوريدا)",
 "black margate": "بومبون (سمكة غذائية رمادية داكنة توجد من لويزيانا وفلوريدا جنوباً)",
 "black maria": "هارتس (شكل من أشكال الويست يتجنب فيه اللاعبون الفوز بالجولات التي تحتوي على قلوب أو ملكة البستوني) / بوكس الشرطة, عربة الشرطة (شاحنة مغلقة تستخدمها الشرطة لنقل السجناء)",
 "black market": "سُوق سَوْدَاء (مكان للبيع والشراء؛ جمع ساق، قال الله تعالى: 《رُدُّوهَا عَلَيَّ فَطَفِقَ مَسْحًا بِالسُّوقِ وَالْأَعْنَاقِ》)\nمثال: ذهبت إلى السوق.",
 "black marketeer": "تاجر سوق سوداء (شخص يشارك بشكل غير قانوني في تجارة السلع النادرة أو الخاضعة للرقابة)",
 "black marlin": "مارلين أسود (سمكة صيد كبيرة في المحيط الهادئ؛ قد يصل وزنها إلى 1000 رطل)",
 "black medick": "فصة ذئبية, فصة سوداء (عشب أوروبي مفترش ذو زهور صفراء صغيرة وقرون سوداء منحنية؛ تم توطينه في أمريكا الشمالية)",
 "black morel": "غوشنة مخروطية, موريل أسود (موريل جسمه الخصب المحفور متصل بالساق مع تنورة حرة صغيرة حوله؛ الجسم الخصب رمادي عندما يكون صغيراً وأسود في الشيخوخة)",
 "black moss": "طحلب إسباني, لحية العجوز (أكاليل كثيفة من خيوط مرنة تشبه الشعر بلون رمادي مخضر مثبتة بجذوع الأشجار وفروعها بواسطة جذور سلكية متفرقة؛ جنوب شرق الولايات المتحدة وجزر الهند…)",
 "black mulberry": "توت أسود (توت أوروبي له أوراق وثمار داكنة)",
 "black music": "الموسيقى السوداء, موسيقى الأمريكيين الأفارقة (موسيقى أنشأها موسيقيون أمريكيون من أصل أفريقي؛ كانت الأشكال المبكرة عبارة عن أغانٍ ذات خط لحني وإيقاع قوي مع لازمة متكررة)",
 "black muslim": "مُسْلِم أَسْوَد (عضو ناشط في مجموعة أمريكية من السود تسمى أمة الإسلام)",
 "black mustard": "خردل أسود (نبات حولي أوراسي واسع الانتشار يزرع لبذوره النفاذة؛ مصدر رئيسي لخردل المائدة)",
 "black nightshade": "مَغْد أَسْوَد / عِنَب الذِئْب / عِنَب الثَعْلَب",
 "black oak": "بلوط أسود, بلوط أصفر (شجرة أخشاب متساقطة الأوراق متوسطة إلى كبيرة من شرق الولايات المتحدة وجنوب شرق كندا لها لحاء خارجي داكن ولحاء داخلي أصفر يستخدم للدباغة؛ الأوراق…)",
 "black olive": "زيتون أسود (زيتون يقطف ناضجاً ويعالج في محلول ملحي ثم يجفف أو يخلل أو يحفظ معلباً أو في الزيت)",
 "black opal": "أوبال أسود (أوبال داكن اللون مع انعكاسات داخلية خضراء أو حمراء)",
 "black operation": "عملية سوداء (عملية سرية لا تُنسب إلى المنظمة التي تنفذها)",
 "black panther": "نَمِر أَسْوَد (عضو في حزب الفهود السود السياسي)",
 "black panthers": "الفهود السود (حزب سياسي أسود متشدد تأسس عام 1965 لإنهاء الهيمنة السياسية للبيض)",
 "black pea": "بازلاء سوداء, جلبان أسود (نبات معمر من أوروبا وشمال إفريقيا؛ تتحول أوراقه إلى اللون الأسود عند التجفيف)",
 "black pepper": "فِلْفِل أَسْوَد (حَبّ حريف يوضع في الطعام أو يطحن يستخدم كتابل. يكون منه أسود أو أبيض، حرارته متوسطة؛ فُلْفُل حَارّ: نبات ثمره حريف لونه أخضر وقد يحمرّ شديد الحرارة. يؤكل كما هو أو يجفف ويطحن ويستخدم كتابل)\nمثال: نحب الفلفل الحار.",
 "black pepper vodka": "فودكا الفلفل الأسود (مشروب كحولي قوي بنكهة الفلفل)",
 "black peppercorn vodka": "فودكا الفلفل الأسود (مشروب كحولي قوي بنكهة الفلفل)",
 "black person": "شخص أسود (شخص ذو بشرة داكنة ينحدر من أفريقيا (أو كان أسلافه من أفريقيا))",
 "black pine": "صنوبر أسود (صنوبر خشب كبير ثنائي الإبر من جنوب شرق أوروبا) / صنوبر أسود, صنوبر جيفري (صنوبر متناظر طويل من غرب أمريكا الشمالية له إبر زرقاء خضراء طويلة في حزم من 3 ومخاريط ممدودة على فروع منتشرة متدلية نوعاً ما؛ يصنف أحياناً كصنف من…) / صنوبر أسود ياباني (نبات زينة ياباني كبير له إبر طويلة في حزم من 2؛ يزرع على نطاق واسع في الولايات المتحدة لمقاومته للملح والضباب الدخاني) / صنوبر أسود, ميرو (صنوبرية نيوزيلندية تستخدم للأخشاب؛ يستخدم الخشب الداكن للنجارة الداخلية)",
 "black plague": "الطاعون الأسود, الموت الأسود (الشكل الوبائي للطاعون الدملي الذي حدث خلال العصور الوسطى عندما قتل ما يقرب من نصف سكان أوروبا الغربية)",
 "black poplar": "حور أسود (حور أوروبي كبير)",
 "black powder": "بارود أسود (شكل بسيط من البارود، يتكون من خليط من نترات البوتاسيوم والفحم والكبريت؛ اختُرع في القرن التاسع في الصين)\nمثال: يُعزى انتشار البارود الأسود عبر آسيا من الصين على نطاق واسع إلى المغول",
 "black pudding": "سجق الدم (سجق أسود يحتوي على دم الخنزير ومكونات أخرى)",
 "black race": "العرق الأسود, زنوج (عرق ذو بشرة داكنة)",
 "black racer": "ثعبان أسود, متسابق أسود (ثعبان متسابق مسود من شرق الولايات المتحدة ينمو حتى ستة أقدام)",
 "black raspberry": "توت العليق الأسود (توت شوكي موطنه شرق أمريكا الشمالية له فاكهة سوداء على شكل كشتبان)",
 "black rat": "جرذ أسود (آفة منزلية شائعة أصلها من آسيا وانتشرت في جميع أنحاء العالم)",
 "black rat snake": "ثعبان أسود, ثعبان الجرذ الأسود (ثعبان أسود لامع كبير غير سام من أمريكا الشمالية)",
 "black rhinoceros": "وحيد القرن الأسود",
 "black rockweed": "فوكوس حويصلي (عشب صخري شائع يستخدم في تحضير عشب البحر وكسماد)",
 "black root rot fungus": "فطر عفن الجذور الأسود (فطر يسبب عفن الجذور الأسود في التفاح)",
 "black rot": "عفن أسود (مرض فطري يسبب اسوداد وتحلل أوراق الفواكه والخضروات)",
 "black rudderfish": "سمكة البرميل (سمكة سوداء اللون تعيش في مياه نيو إنجلاند)",
 "black sage": "تجعيدات زرقاء صوفية, مريمية سوداء (نبات عطري بأوراق صوفية يوجد في جنوب كاليفورنيا والمكسيك)",
 "black sally": "مالي أسود (مالي صغير بلحاء خشن داكن اللون نحو القاعدة؛ ينتج صمغ كينو أوكالبتوس أحمر)",
 "black salsify": "سلسفي أسود (سلسفي أسود طويل) / تيس الجبل الإسباني, ساسفي أسود (عشب معمر من جنوب أوروبا له أوراق كاملة ضيقة ورؤوس زهرية صفراء منعزلة وجذور طويلة سوداء صالحة للأكل تشبه الجزر)",
 "black saltwort": "حلاب البحر, غلوكس (عشب لحمي صغير شائع على طول شواطئ أمريكا الشمالية وفي المستنقعات المالحة وله أزهار وردية أو بيضاء)",
 "black sea": "الْبَحْر الْأَسْوَد, بَحْرُ نِيطَش",
 "black sea bass": "قاروص البحر الأسود (قاروص بحر مخطط باللون الأسود المزرق من ساحل المحيط الأطلسي للولايات المتحدة)",
 "black sheep": "خروف أسود (خروف ذو صوف أسود) / النعجة السوداء, طالح (فاسق متهور وعديم المبادئ)",
 "black snakeroot": "جذر الثعبان الأسود, كوهوش أسود (نبات البق توت من أمريكا الشمالية يوجد من ماين وأونتاريو إلى ويسكونسن وجنوباً إلى جورجيا) / جذر الثعبان الأسود, زنجبيل كندا (نبات معمر نفضي منخفض النمو من كندا وشرق ووسط الولايات المتحدة)",
 "black spleenwort": "أسبلينيوم أسود, طحال أسود (طحال في أوروبا وأفريقيا وآسيا ذو سعف ريشي وينتج مادة قابضة)",
 "black spot": "بقعة سوداء (أي من العديد من الأمراض الفطرية للنباتات التي تنتج بقعاً سوداء صغيرة على النبات)",
 "black spruce": "تنوب أسود (تنوب صغير في المناطق المستنقعية بشمال شرق أمريكا الشمالية له فروع منتشرة بأوراق كثيفة؛ خشب رديء)",
 "black squirrel": "سنجاب أسود (سنجاب الثعلب أو السنجاب الرمادي في المرحلة اللونية السوداء)",
 "black stork": "لقلق أسود (لقلق من العالم القديم أسود لامع من الأعلى وأبيض من الأسفل)",
 "black sumac": "سماق قزم, سماق لامع (شجيرة شائعة غير سامة في شرق أمريكا الشمالية بأوراق مركبة وزهور خضراء عنقودية تليها ثمار حمراء)",
 "black swan": "تَمّ أَسْوَد",
 "black tai": "تاي السوداء, لغة تاي دام (فرع من لغات تاي، يُتحدث به في شمال وجنوب فيتنام)",
 "black tea": "شَاي أَسْوَد (شَجَرَة خَضْرَاء من فَصِيلَة الكَامِيلِيات لها أزْهَار بَيْضَاء، وتُعْطِي أوراقاً يصنع منها شَرَاب مُنَبِّه؛ أوراق الشجرة المجففة)\nمثال: صب الشاي لضيفك.",
 "black tetra": "تَتْرَة سَوْدَاء",
 "black tie": "ربطة عنق سوداء (ربطة عنق فراشة سوداء تلبس مع بدلة السهرة) / بدلة سهرة, توكسيدو (زي سهرة شبه رسمي للرجال)",
 "black tongue": "لسان مشعر (أثر جانبي حميد لبعض المضادات الحيوية؛ فرط نمو داكن لحليمات اللسان)",
 "black tree fern": "سرخس شجري أسود, سرخس شجري فضي (سرخس شجري مبهرج في نيوزيلندا وأستراليا له تاج من السعف الريشي بجوانب سفلية بيضاء)",
 "black turnstone": "قنبرة الماء السوداء (قنبرة ماء شائعة في ساحل المحيط الهادئ لأمريكا الشمالية)",
 "black vernacular": "إيبونيكس, الإنجليزية الأمريكية الأفريقية (شكل غير قياسي من الإنجليزية الأمريكية يتحدث به بشكل مميز الأمريكيون من أصل أفريقي في الولايات المتحدة)",
 "black vernacular english": "إيبونيكس, الإنجليزية الأمريكية الأفريقية (شكل غير قياسي من الإنجليزية الأمريكية يتحدث به بشكل مميز الأمريكيون من أصل أفريقي في الولايات المتحدة)",
 "black vomit": "حمى صفراء (مرض يسببه فيروس مصفر ينتقل عن طريق البعوض)",
 "black vulture": "نسر أسود (من جنوب أوراسيا وشمال أفريقيا) / نسر أسود أمريكي (نسر أمريكي أصغر من النسر الرومي)",
 "black walnut": "جوز أسود (جوز أمريكي له قشرة خشبية صلبة وسميكة جداً) / جوز أسود (شجرة جوز من أمريكا الشمالية بخشب داكن صلب وجوز صالح للأكل)",
 "black walnut tree": "جوز أسود (شجرة جوز من أمريكا الشمالية بخشب داكن صلب وجوز صالح للأكل)",
 "black wattle": "أكاسيا أذينية, سنط أسود (شجرة أسترالية تنتج مواد دباغة)",
 "black weevil": "سوسة الأرز (سوسة بنية تغزو الحبوب المخزنة وخاصة الأرز)",
 "black whale": "حوت العنبر (حوت كبير ذو تجويف كبير في الرأس يحتوي على العنبر والزيت؛ وهو أيضاً مصدر للعنبر الرمادي) / حوت طيار (حوت صغير داكن اللون يعيش في ساحل المحيط الأطلسي للولايات المتحدة؛ يعمل الذكر الأكبر كطيار أو قائد للسرب)",
 "black widow": "أرملة سوداء (عنكبوت سام من العالم الجديد؛ الأنثى سوداء بعلامة حمراء على شكل ساعة رملية على الجانب السفلي من البطن)",
 "black willow": "صفصاف أسود, صفصاف المستنقعات (صفصاف شجيري في أمريكا الشمالية ذو لحاء داكن وأوراق خطية ينمو بالقرب من الجداول والبحيرات)",
 "black woman": "امرأة سوداء (امرأة سوداء البشرة)",
 "black-and-blue": "مَكْدُوم, مُزْرَقّ (تغيّر لونه بسبب تجمع الدم تحت الجلد)",
 "black-and-tan": "أَسْوَد وَأَسْمَر (ذو نقش باللونين الأسود والأسمر)",
 "black-and-tan coonhound": "كونهاوند أسود وأسمر (سلالة أمريكية من كلاب الصيد الكبيرة القوية تستخدم لصيد الراكون وطرائد أخرى)",
 "black-and-tan terrier": "مانشستر تيريير (سلالة من تيريير الجرذان قصير الشعر ذو فراء أسود وأسمر تم تطويرها في مانشستر، إنجلترا)",
 "black-and-white": "أَبْيَض وَأَسْوَد (ليس لديه أو غير قادر على إنتاج الألوان) / أَبْيَض وَأَسْوَد, حَدِّيّ ((يوصف به الموقف) منقسم بحدة إلى فئتين متعارضتين لا وسط بينهما) / أبيض وأسود (يفتقر إلى تدرجات الألوان أو الظلال الرمادية؛ جزء منه أبيض وجزء أسود)\nمثال: فيلم أبيض وأسود",
 "black-backed gull": "نورس أسود الظهر (نورس أبيض ذو ظهر وأجنحة سوداء)",
 "black-backed jackal": "ابن آوى أسود الظهر (ابن آوى موطنه أفريقيا ذو ظهر أسود)",
 "black-barred": "مُقَضَّب بِالأَسْوَد (ذو نقش من قضبان سوداء)",
 "black-bibbed tit": "قرقف أسود الصدر",
 "black-billed cuckoo": "واقواق أسود المنقار (واقواق من أمريكا الشمالية؛ يبني عشاً ويربي صغاره بنفسه)",
 "black-body radiation": "إشعاع الجسم الأسود (الإشعاع الكهرومغناطيسي الذي يشع من جسم أسود مثالي؛ يعتمد توزيع الطاقة في الطيف المشع للجسم الأسود فقط على درجة الحرارة ويحدده قانون بلانك للإشعاع)",
 "black-capped chickadee": "قرقف أسود التاج (قرقف ذو تاج داكن)",
 "black-coated": "مَطْلِيّ بِالأَسْوَد (مغلف أو مطلي بطبقة سوداء)",
 "black-crowned night heron": "غُرَاب اللَيْل أَسْوَد التَاج",
 "black-eyed pea": "لُوبِيَاء, لُوبِيَا",
 "black-eyed susan": "رودبيكيا, سوزان سوداء العينين (زهرة ولاية ماريلاند؛ من وسط وجنوب شرق الولايات المتحدة؛ ذات زهور تشبه الأقحوان بمراكز داكنة وأشعة صفراء إلى برتقالية) / زهرة الساعة, كتمد (عشبة سنوية ضارة بزهور صفراء سريعة الزوال بعين أرجوانية؛ المناطق الاستوائية في العالم القديم؛ متوطنة كعشبة ضارة في أمريكا الشمالية) / ثونبيرغيا, سوزان سوداء العينين (نبات متسلق أفريقي استوائي له أزهار صفراء بمركز أرجواني داكن)",
 "black-eyed susan vine": "ثونبيرغيا, سوزان سوداء العينين (نبات متسلق أفريقي استوائي له أزهار صفراء بمركز أرجواني داكن)",
 "black-footed albatross": "قطرس أسود الرجلين (نوع من القطرس ذو أقدام سوداء)",
 "black-footed ferret": "نمس أسود الأقدام (ثديي من العرسيات في مناطق البراري بالولايات المتحدة؛ مهدد بالانقراض تقريباً)",
 "black-fronted bush shrike": "صرد الأدغال أسود الجبهة (نوع من صرد الأدغال)",
 "black-gray": "أَسْوَد رَمَادِيّ (بلون رمادي داكن)",
 "black-grey": "أَسْوَد رَمَادِيّ (بلون رمادي داكن)",
 "black-haired": "دَاكِن الشَّعْر (ذو شعر بلون داكن)",
 "black-headed gull": "نورس اسود الرأس",
 "black-headed snake": "ثعبان أسود الرأس (ثعبان أرضي صغير كتوم؛ يوجد من وسط الولايات المتحدة إلى الأرجنتين)",
 "black-legged tick": "قراد أسود الأرجل (طفيلي على الفئران ويعض البشر؛ ناقل رئيسي لداء لايم في شرق الولايات المتحدة (خاصة نيو إنجلاند))",
 "black-marked": "مُعَلَّم بِالأَسْوَد (ذو علامات سوداء)",
 "black-market": "مُحَرَّم, مُهَرَّب (مُنْتَج أَوْ مُتاجَر بِهِ بِشَكْل غَيْر قانونِيّ)",
 "black-necked cobra": "كوبرا باصقة, كوبرا سوداء العنق (كوبرا عدوانية واسعة الانتشار في أفريقيا؛ نادراً ما تعض ولكنها تبصق السم الذي قد يسبب العمى)",
 "black-necked grebe": "غطاس أسود الرقبة (غطاس صغير ذو خصلات أذن صفراء ورقبة سوداء؛ يوجد في أوراسيا وجنوب أفريقيا وكذلك غرب الولايات المتحدة)",
 "black-necked stilt": "أبو مغازل أسود العنق (أبو مغازل من جنوب غرب الولايات المتحدة إلى شمال أمريكا الجنوبية ذو ريش أسود يمتد من الرأس إلى أسفل مؤخرة العنق)",
 "black-necked stork": "لقلق أسود العنق (لقلق أسترالي كبير أبيض في الغالب)",
 "black-seeded": "أَسْوَدُ البُذُور (ذو بذور سوداء اللون)",
 "black-stem spleenwort": "طحال أسود الساق (سرخس أمريكا الاستوائية: من جنوب الولايات المتحدة إلى جزر الهند الغربية والمكسيك إلى البرازيل)",
 "black-stemmed spleenwort": "طحال أسود الساق (سرخس أمريكا الاستوائية: من جنوب الولايات المتحدة إلى جزر الهند الغربية والمكسيك إلى البرازيل)",
 "black-tailed deer": "أيل أسود الذيل (أيل البغل في جبال روكي الغربية)",
 "black-tie": "شِبْهُ رَسْمِيّ (رَسْمِيٌّ بِشَكْلٍ مُعْتَدِلٍ؛ يَسْتَلْزِمُ ارْتِدَاءَ بَدْلَةِ عَشَاءٍ)",
 "black-winged stilt": "أبو مغازل أسود الجناح (أبو مغازل من أوروبا وأفريقيا وآسيا ذو ريش أبيض في الغالب ولكن بأجنحة سوداء)",
 "blackamoor": "شخص أسود (شخص ذو بشرة داكنة ينحدر من أفريقيا (أو كان أسلافه من أفريقيا))",
 "blackback flounder": "سمك موسى الليموني, فلو ندر الشتاء (سمكة طعام أمريكية مهمة في الشتاء)",
 "blackball": "استبعاد, حظر (فعل استبعاد شخص ما عن طريق تصويت سلبي أو حق النقض)",
 "blackbeetle": "صرصور شرقي (صرصور بني داكن أصله من الشرق والآن عالمي الانتشار تقريباً)",
 "blackberry": "تُوت العُلَّيْق, بَاطُس",
 "blackberry bush": "توت العليق, شجيرة توت العليق (نبات شائك يحمل توتاً أسود أو أرجوانياً داكناً حلواً صالحاً للأكل لا ينفصل عادة عن التخت الزهري)",
 "blackberry liqueur": "ليكير التوت الأسود (أي من مجموعة متنوعة من المشروبات الكحولية القوية المصنوعة من التوت الأسود)",
 "blackberry-lily": "زنبق التوت, زنبق النمر (نبات حديقة تكشف كبسولته عند النضج عن كتلة من البذور تشبه التوت الأسود)",
 "blackbird": "شُحْرُور",
 "blackboard": "سَبُّورَة, لَوْح",
 "blackboard eraser": "طلاّسة, ممحاة السبورة (ممحاة تزيل علامات الطباشير من السبورة)",
 "blackbody": "جِسْم أَسْوَد (جسم افتراضي قادر على امتصاص كل الإشعاع الكهرومغناطيسي الساقط عليه)\nمثال: الجسم الأسود المحافظ على درجة حرارة ثابتة هو مشع كامل عند تلك الدرجة لأن الإشعاع الواصل إليه والمغادر له يجب أن يكون في توازن",
 "blackbody radiation": "إشعاع الجسم الأسود (الإشعاع الكهرومغناطيسي الذي يشع من جسم أسود مثالي؛ يعتمد توزيع الطاقة في الطيف المشع للجسم الأسود فقط على درجة الحرارة ويحدده قانون بلانك للإشعاع)",
 "blackbuck": "ظبي أسود (ظبي هندي شائع ذو ظهر داكن وقرون لولبية)",
 "blackburn": "هازجة بلاكبيرن (هازجة غابات من أمريكا الشمالية سوداء وبيضاء ذات رأس وحلق برتقالي وأسود)",
 "blackburnian warbler": "هازجة بلاكبيرن (هازجة غابات من أمريكا الشمالية سوداء وبيضاء ذات رأس وحلق برتقالي وأسود)",
 "blackcap": "أبو قلنسوة (هازجة صغيرة رمادية بنية ذات تاج أسود) / قرقف أسود التاج (قرقف ذو تاج داكن) / نورس ضاحك (نورس أوروبي صغير أسود الرأس) / توت العليق الأسود (توت شوكي موطنه شرق أمريكا الشمالية له فاكهة سوداء على شكل كشتبان)",
 "blackcap raspberry": "توت العليق الأسود (توت شوكي موطنه شرق أمريكا الشمالية له فاكهة سوداء على شكل كشتبان)",
 "blackcock": "ديك الطيهوج الأسود (ذكر الطيهوج الأسود)",
 "blackcurrant": "كِشْمِش أَسْوَد, عِنَب الثَّعْلَب",
 "blackcurrant liqueur": "ليكير الكشمش الأسود (أي من ليكيرات متنوعة مصنوعة من الكشمش الأسود)",
 "blackdamp": "غاز خانق (الغلاف الجوي في منجم بعد انفجار؛ غني بثاني أكسيد الكربون وغير قادر على دعم الحياة)",
 "blacken": "سَوَّدَ / اِسْوَدَّ",
 "blackened": "مُسْوَدّ ((للوجه) أسود خاصة من احتقان الدم) / مُدَخَّن, مُسْوَدّ (أصبح داكنًا بفعل الدخان)",
 "blackening": "تسويد, تعتيم (التغيير إلى لون أغمق)",
 "blackface": "مكياج الوجه الأسود (المكياج (عادة من الفلين المحروق) الذي يستخدمه المؤدي لتقليد ذوي البشرة السوداء)",
 "blackfish": "حوت طيار (حوت صغير داكن اللون يعيش في ساحل المحيط الأطلسي للولايات المتحدة؛ يعمل الذكر الأكبر كطيار أو قائد للسرب) / أنثى السلمون (أنثى السلمون التي وضعت بيضها حديثاً) / السمكة السوداء, توتوغ (سمكة طعام كبيرة داكنة اللون تعيش في ساحل المحيط الأطلسي لأمريكا الشمالية)",
 "blackfly": "ذبابة سوداء (ذبابة لاسعة صغيرة مسودة ممتلئة الجسم لها يرقات مائية؛ تمتص دماء الطيور وكذلك البشر والثدييات الأخرى) / من الفاصوليا (من مسود يغزو الفاصوليا وبنجر السكر مثلاً)",
 "blackfoot": "لغة البلاك فوت, لغة ذوي الأقدام السوداء (أي من اللغات الألغونكوية التي يتحدث بها شعب البلاك فوت) / بلاكفوت, ذوو الأقدام السوداء (فرد من مجموعة محاربة من الألغونكيان تعيش في السهول الشمالية الغربية)",
 "blackfoot daisy": "أقحوان ذو القدم السوداء, ميلامبديوم (شجيرة صغيرة كثيفة لها رؤوس زهرية تشبه الأستر بأشعة بيضاء عريضة؛ توجد في المناطق الصحراوية من أريزونا شرقاً إلى كانساس وجنوباً إلى المكسيك)",
 "blackfoot language": "لغة البلاك فوت, لغة ذوي الأقدام السوداء (أي من اللغات الألغونكوية التي يتحدث بها شعب البلاك فوت)",
 "blackfriar": "دومينيكاني, راهب أسود (راهب روماني كاثوليكي يرتدي العباءة السوداء للرهبنة الدومينيكانية)",
 "blackguard": "خسيس, دنيء (شخص مذموم أخلاقياً)\nمثال: أيها الكلب القذر",
 "blackguardly": "نَذْل, وَغْدِيّ (عديم المبادئ أو الضمير)",
 "blackhead": "بُثُور سَوْدَاء, رُؤُوس سَوْدَاء",
 "blackheart": "كرز القلب الأسود (كرز قلبي ذو لحم وقشرة داكنة) / قلب أسود (أي من الأمراض المختلفة التي تسود فيها الأنسجة المركزية)",
 "blackheart cherry": "كرز القلب الأسود (كرز قلبي ذو لحم وقشرة داكنة)",
 "blacking": "ملمع الأحذية (مادة تستخدم لإنتاج سطح واقٍ لامع للأحذية)",
 "blackish": "مَائِل لِلسَّوَاد (مائل إلى السواد قليلاً)",
 "blackish-brown": "بُنِّيّ مُسْوَدّ (ذو لون بنّيّ بمسحة سوداء)",
 "blackish-gray": "أَسْوَد رَمَادِيّ (بلون رمادي داكن)",
 "blackish-grey": "أَسْوَد رَمَادِيّ (بلون رمادي داكن)",
 "blackish-red": "أَحْمَر مُسْوَدّ (ذو لون أحمر بمسحة سوداء)",
 "blackjack": "بلاك جاك, واحد وعشرون (لعبة قمار تستخدم الأوراق؛ الهدف هو الحصول على أوراق ذات مجموع أعلى من أوراق المصرفي ولكن لا تتجاوز 21) / العلم الأسود, علم القراصنة (علم يحمل عادة جمجمة بيضاء وعظمتين متقاطعتين على خلفية سوداء؛ يشير إلى سفينة قراصنة) / عصا سوداء, هراوة قصيرة (قطعة من المعدن مغطاة بالجلد بمقبض مرن؛ تستخدم لضرب الناس) / سنديان ماريلاند (شجرة نفضية شجيرية شائعة في وسط وجنوب شرق الولايات المتحدة، لها لحاء داكن وأوراق عريضة ثلاثية الفصوص (على شكل هراوة)؛ وتميل لتشكيل غابات كثيفة)",
 "blackjack oak": "سنديان ماريلاند (شجرة نفضية شجيرية شائعة في وسط وجنوب شرق الولايات المتحدة، لها لحاء داكن وأوراق عريضة ثلاثية الفصوص (على شكل هراوة)؛ وتميل لتشكيل غابات كثيفة)",
 "blackleg": "كاسر الإضراب (شخص يعمل (أو يوفر عمالاً) أثناء الإضراب)",
 "blacklist": "قَائِمَة سَوْدَاء",
 "blackmail": "اِبْتِزَاز (اِسْتِغْلالٌ بِدَنَاءَة؛ ابتزاز المال بالتهديد) / اِبْتِزَازَ (اِسْتِغْلالٌ بِدَنَاءَة؛ ابتزاز المال بالتهديد)",
 "blackmailer": "مبتز (مجرم يبتز المال من شخص ما بتهديده بفضح معلومات محرجة عنه)",
 "blackmouth bass": "قاروص أسود الفم (سمكة بحرية صغيرة ذات فم وتجويف خيشومي أسود)",
 "blackness": "سَوَاد",
 "blackout": "غَشْيَة / تَعْتِيم",
 "blackpoll": "هازجة سوداء الرأس (هازجة من أمريكا الشمالية ذات رأس أسود وأبيض)",
 "blackseed": "عشبة السجاد, عشبة السناج (عشبة موطنها جزر الهند الغربية ولكنها شائعة في جنوب الولايات المتحدة ذات سيقان سلكية معنقدة غالباً ما تكون مصابة بفطر داكن)",
 "blackshirt": "صاحب القميص الأسود (عضو في الحزب الفاشي الإيطالي قبل الحرب العالمية الثانية)",
 "blacksmith": "حَدَّاد, قَيْن",
 "blacksnake": "ثعبان أسود, متسابق أسود (ثعبان متسابق مسود من شرق الولايات المتحدة ينمو حتى ستة أقدام) / ثعبان أسود, ثعبان الجرذ الأسود (ثعبان أسود لامع كبير غير سام من أمريكا الشمالية)",
 "blacktail": "أيل أسود الذيل (أيل البغل في جبال روكي الغربية)",
 "blacktail deer": "أيل أسود الذيل (أيل البغل في جبال روكي الغربية)",
 "blacktail jackrabbit": "أرنب بري أسود الذيل (الأرنب البري الشائع في الأراضي العشبية والمناطق المفتوحة في غرب الولايات المتحدة؛ له آذان كبيرة سوداء الأطراف وشريط أسود على الذيل)",
 "blacktail prairie dog": "كلب البراري أسود الذيل (ذيله أسود الطرف)",
 "blackthorn": "بَرْقُوق شَائِك, بَرْقُوق السِيَاج",
 "blackthorn liqueur": "ليكير الشوك الأسود (أي من مجموعة متنوعة من المشروبات الكحولية القوية المصنوعة من فاكهة الشوك الأسود)",
 "blacktip shark": "قرش أسود الطرف (قرش واسع الانتشار في المياه الضحلة، تبدو زعانفه وكأنها مغموسة في الحبر)",
 "blacktop": "أسفلت, طبقة سوداء (مادة بيتومينية سوداء تستخدم لرصف الطرق أو مناطق أخرى؛ عادة ما تنشر فوق الصخور المسحوقة)",
 "blacktopping": "أسفلت, طبقة سوداء (مادة بيتومينية سوداء تستخدم لرصف الطرق أو مناطق أخرى؛ عادة ما تنشر فوق الصخور المسحوقة)",
 "blackwall hitch": "عقدة بلاك وول (عقدة بسيطة تستخدم لربط حبل بخطاف مؤقتاً)",
 "blackwash": "غسول أسود (غسول يلون السطح باللون الأسود) / غسول أسود (خليط من الكالوميل وماء الجير يستخدم على القروح الزهرية) / اغْتِيَال الشَّخْصِيَّة (هجوم يهدف إلى تدمير سمعة شخص ما)",
 "blackwater": "بيلة دموية (أي من العديد من الأمراض البشرية أو الحيوانية التي تتميز ببول داكن ناتج عن التحلل السريع لخلايا الدم الحمراء)",
 "blackwater fever": "حمى البول الأسود (ملاريا شديدة وغالباً مميتة تتميز بتلف الكلى مما يؤدي إلى بول داكن)",
 "blackwood": "خشب أسود, شجرة الخشب الأسود (أي من الأشجار الصلبة المتعددة التي تنتج خشبًا داكن اللون جدًا) / خشب أسود (خشب داكن جداً لأي من عدة أشجار خشب أسود)",
 "blackwood tree": "خشب أسود, شجرة الخشب الأسود (أي من الأشجار الصلبة المتعددة التي تنتج خشبًا داكن اللون جدًا)",
 "bladder": "حُوَيْصِلَة",
 "bladder campion": "سيلينة بيضاء, ليخنيس أبيض (عشبة خضراء مزرقة ذات سيقان لزجة وعناقيد من الزهور البيضاء الكبيرة التي تفتح مساءً بكأس منتفخ جداً؛ توضع أحياناً في جنس ليخنيس) / سيلينة شائعة, سيلينة منفوخة (نبات معمر في القطب الشمالي لأوروبا ذو زهور بيضاء كبيرة بكأس منتفخ)",
 "bladder cherry": "كَاكِنْج",
 "bladder disorder": "اضطراب المثانة (اضطراب في المثانة البولية)",
 "bladder fern": "سرخس المثانة (أي سرخس من جنس سيستوبتريس يتميز بغطاء مقنع أو غشاء يشبه المثانة يغطي البثرات)",
 "bladder fucus": "فوكوس حويصلي (عشب صخري شائع يستخدم في تحضير عشب البحر وكسماد)",
 "bladder ketmia": "زهرة الساعة, كتمد (عشبة سنوية ضارة بزهور صفراء سريعة الزوال بعين أرجوانية؛ المناطق الاستوائية في العالم القديم؛ متوطنة كعشبة ضارة في أمريكا الشمالية)",
 "bladder senna": "سنا مثاني (شجيرة أوروبية صفراء الزهر تزرع لتتابع أزهارها الصفراء وقرونها المثانية المنتفخة جداً وكمصدر لغذاء الحياة البرية)",
 "bladder sphincter": "مصرة المثانة (العضلة العاصرة للمثانة البولية؛ تتكون من طبقة عضلية سميكة للمثانة حول فتحة الإحليل)",
 "bladder stone": "حَصَاةُ المَثَانَة (حصاة تتكون في المثانة)",
 "bladder worm": "دودة مثانية (يرقة متكيسة تشبه الكيس للدودة الشريطية)",
 "bladderlike": "كيسي, مثاني الشكل (يشبه المثانة)",
 "bladdernose": "فقمة مقنعة (فقمة متوسطة الحجم سوداء رمادية ذات كيس كبير قابل للنفخ على الرأس؛ تعيش في مياه القطب الشمالي وشمال المحيط الأطلسي)",
 "bladderpod": "قرن المثانة, مشلحية (أي من عدة أعشاب مشعرة في أمريكا الشمالية ذات أزهار عنقودية صفراء وقرون منتفخة) / فيزاريا, قرن المثانة / قرن المثانة, ليسكيريلا (أعشاب حولية أو معمرة ذات قرون بذور منتفخة؛ يوضع بعضها في جنس ليسكيريلا) / تبغ هندي, لوبيليا منتفخة (لوبيليا برية من أمريكا الشمالية ذات أزهار زرقاء صغيرة وكبسولات منتفخة كانت تستخدم سابقاً كمضاد للتشنج)",
 "bladderwort": "حامول الماء",
 "bladderwrack": "فوكوس حويصلي (عشب صخري شائع يستخدم في تحضير عشب البحر وكسماد) / أسكوفيلوم عقدي (يشبه عشب الصخور الأسود ويوجد معه)",
 "bladdery": "كيسي, مثاني الشكل (يشبه المثانة)",
 "blade": "نَصْل (مصدر من الفعل نَصَلَ؛ حديدة السهم والرمح والسيف والسكين وغيرها من الأسلحة الحادّة الجارحة)\nمثال: لن نصل إلى أي مكان.",
 "blade apple": "عنب الثعلب البربادوسي (فاكهة صغيرة صفراء إلى برتقالية لصبار عنب الثعلب البربادوسي)",
 "blade bit": "ريشة ذيل السمكة (ريشة حفر ذات حواف قطع مقواة عادة ضد التآكل)",
 "blade roast": "شواء الكتف, لحم لوح الكتف (لحم للتحمير مأخوذ من الكتف)",
 "bladed": "صَفِيحِيّ, نَصْلِيّ (مُكَوَّنٌ مِنْ صَفَائِحَ رَقِيقَةٍ مُسَطَّحَةٍ تُشْبِهُ النَّصْل) / ذو نصل, ناصل (يحمل أو يتميز بنصل أو سيف؛ تستخدم غالباً في التركيبات) / ذو نصل, نصلي (لديه نصل أو أنصال؛ تستخدم غالباً في التركيبات)\nمثال: قاتل، مكسور النصل ولكن غير منحني",
 "bladelike": "سَيْفِيّ الشَّكْل (على شكل نصل السيف)",
 "blae": "أَزْرَق مُسْوَدّ (ذو لون أزرق مائل إلى السواد أو الرماديّ)",
 "blaeberry": "توت أزرق أوروبي, عنب الأحراش (توت أزرق أوروبي قائم له زهور منفردة وتوت أزرق مسود)",
 "blagoevgrad": "بلاغويفغراد",
 "blagoveshchensk": "بْلَاغُوفِيشْتْشِينْسْك",
 "blah": "كلام طنان, هراء (كلام أو كتابة متفاخرة أو مدعية)",
 "blahs": "فتور, ملل (شعور عام بالملل وعدم الرضا)",
 "blaia zimondal": "بلايا زيموندال (لغة مصطنعة اقترحها سيزار ميريجي عام 1884)",
 "blain": "بثرة (تورم التهابي أو قرحة)",
 "blamable": "مُسْتَحِقٌّ لِلذَّمّ, مُسْتَوْجِبٌ لِلَّوْم (يستحق اللوم أو الذم لكونه خاطئًا أو مؤذيًا)",
 "blame": "لَوْم, مَلَامَة",
 "blame game": "تبادل اللوم, تقاذف الاتهامات (اتهامات متبادلة بين أشخاص يرفضون قبول المسؤولية الفردية عن حدث غير مرغوب فيه)",
 "blameable": "مُسْتَحِقٌّ لِلذَّمّ, مُسْتَوْجِبٌ لِلَّوْم (يستحق اللوم أو الذم لكونه خاطئًا أو مؤذيًا)",
 "blamed": "لَعِين, مَلْعُون ((غير رسمي) شتائم تُستخدَم للتوكيد والتأثير)",
 "blameful": "مُسْتَحِقٌّ لِلذَّمّ, مُسْتَوْجِبٌ لِلَّوْم (يستحق اللوم أو الذم لكونه خاطئًا أو مؤذيًا)",
 "blameless": "بَرِيء, لَا تَشُوبُهُ شَائِبَة (خالٍ من الذنب؛ لا يستحق اللوم)",
 "blamelessly": "بشكل لا غبار عليه, بنزاهة تامة (بطريقة لا تشوبها شائبة ولا لوم فيها)\nمثال: عاشت بنزاهة تامة حتى قابلت هذا الرجل",
 "blamelessness": "براءة, خلو من اللوم (حالة من البراءة)",
 "blameworthiness": "جدارة باللوم, مسؤولية عن الخطأ (حالة من الذنب)",
