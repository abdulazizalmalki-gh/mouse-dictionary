 "bog": "مستنقع",
 "bog asphodel": "أسفوديل المستنقع (إما من نباتين عشبيين يشبهان الأسل في المستنقعات ولهما أزهار صفراء صغيرة وأوراق تشبه العشب؛ المناطق المعتدلة الشمالية)",
 "bog aster": "أستر المستنقع",
 "bog bilberry": "عنب المستنقعات (شجيرة دائمة الخضرة بأوراق جلدية)",
 "bog candles": "سحلب اللجام المستنقعي (سحلب بسنابل من العديد من الزهور البيضاء العطرة على سيقان ورقية منتصبة؛ في الأراضي الرطبة أو المستنقعية عبر معظم الغرب وشمال أمريكا الشمالية)",
 "bog hemp": "بوميريا, قراص كاذب (أي من عدة أعشاب ضارة مزهرة من جنس بوميريا تفتقر إلى الشعيرات اللاسعة)",
 "bog kalmia": "غار المستنقعات (غار مستنقعات شمال غرب الولايات المتحدة له زهور أرجوانية صغيرة وأوراق شاحبة زرقاء من الأسفل)",
 "bog laurel": "غار المستنقعات (غار مستنقعات شمال غرب الولايات المتحدة له زهور أرجوانية صغيرة وأوراق شاحبة زرقاء من الأسفل)",
 "bog moss": "سفاغنوم, طحلب الخث (أي من الحزازيات الشاحبة أو الرمادية المختلفة من جنس سفاغنوم التي تشكل بقاياها المتحللة الخث)",
 "bog myrtle": "إطريفل الماء, فاصوليا المستنقعات (نبات معمر في أوروبا وأمريكا له عناقيد من الزهور البيضاء أو الأرجوانية وأوراق ثلاثية شديدة المرارة؛ غالباً ما يتجذر عند حافة الماء وينتشر عبر السطح)",
 "bog pimpernel": "أناغالس المستنقع (عشبة أوروبية زاحفة صغيرة ذات أزهار وردية دقيقة)",
 "bog plant": "نبات المستنقعات (نبات شبه مائي ينمو في الأراضي الرطبة الرخوة؛ معظمها من ذوات الفلقة الواحدة: السعادى، الطحالب، الأعشاب، البردي، إلخ؛ وربما الخلنج)",
 "bog rein orchid": "سحلب اللجام المستنقعي (سحلب بسنابل من العديد من الزهور البيضاء العطرة على سيقان ورقية منتصبة؛ في الأراضي الرطبة أو المستنقعية عبر معظم الغرب وشمال أمريكا الشمالية)",
 "bog rhubarb": "باتسيتس, راوند البرك (عشب أوراسي صغير له أوراق عريضة وأزهار ليلكية وردية عديمة الشعاع؛ يوجد في المناطق الرطبة)",
 "bog rose": "أريثوسا, فم التنين (سحلب مستنقعات بزهور وردية أرجوانية عطرية منفردة عادة بتويج واسع الفجوة؛ كندا)",
 "bog rosemary": "أندروميدا, إكليل الجبل المستنقعي (شجيرة دائمة الخضرة سلكية لها عناقيد متدلية من الزهور البيضاء أو الوردية؛ من المناطق الحمضية الرطبة في القطب الشمالي وكندا إلى شمال شرق الولايات…)",
 "bog soil": "تربة المستنقعات (تربة رديئة الصرف فوق الخث وتحت نباتات الأهوار أو المستنقعات)",
 "bog spavin": "عرة رخوة (عرة (مرض في مفصل العرقوب عند الخيول) ناتج عن تجمع السوائل)",
