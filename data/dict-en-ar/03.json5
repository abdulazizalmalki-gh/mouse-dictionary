 "botswanan": "بوتسواني (من أو متعلق ببوتسوانا أو شعب بوتسوانا)",
 "bottle": "زُجَاجَة (قطعة زُجَاج؛ قِنْدِيل) / قِنِّينَة (وعاء توضع فيه السوائل، ويصنع من مواد مختلفة مثل الزجاج والبلاستيك) / قزازة / بطل / قارورة (وعاء زجاجي توضع فيه السوائل، وله عنق وسدادة) / قُزازة / عَبَّأَ فِي زُجَاجَة / يرضع بواسطَة زجاجَة\nمثال: سرقوا زجاجة نبيذي!",
 "bottle bank": "حاوية تجميع الزجاجات (مكان يمكن فيه إيداع الزجاجات لإعادة التدوير)",
 "bottle bill": "مشروع قانون الزجاجات (قانون يتطلب من التجار استعادة الزجاجات المستعملة)",
 "bottle cap": "غِطَاء زُجَاجَة, غِطَاء قَارُورَة",
 "bottle capper": "آلة تغطية الزجاجات, كابة الزجاجات (جهاز يدوي أو أوتوماتيكي يستخدم لوضع الأغطية على الزجاجات)",
 "bottle collection": "جمع الزجاجات (جمع الزجاجات لإعادة استخدامها) / جمع الزجاجات (نشاط جمع الزجاجات (كهواية)) / مجموعة زجاجات (مجموعة من الزجاجات)\nمثال: جمع الزجاجات هو هواية لها",
 "bottle cork": "سدادة فلينية, فلين (السدادة في فم زجاجة (خاصة زجاجة نبيذ))",
 "bottle gentian": "جنطيانا عمياء, جنطيانا مغلقة (جنطيانا من شرق أمريكا الشمالية لها زهور أنبوبية زرقاء أو بيضاء تفتح قليلاً أو لا تفتح على الإطلاق)",
 "bottle gourd": "قرع القنينة, يقطين (نبات متسلق من العالم القديم ذو ثمار قرعية صلبة القشرة تشبه الزجاجة)",
 "bottle grass": "ذيل الثعلب الأخضر (ذيل ثعلب أوروبي متوطن في أمريكا الشمالية؛ غالباً ما يكون عشبة ضارة مزعجة)",
 "bottle green": "أخضر زجاجي (أخضر داكن إلى متوسط أو رمادي)",
 "bottle opener": "فَتَّاحَة (التي تكثر الفَتْح) / فَتَّاحَة زُجَاجَات (التي تكثر الفَتْح)",
 "bottle screw": "بريمة السدادات, مفتاح الفلين (فتاحة زجاجات تسحب السدادات الفلينية)",
 "bottle tree": "شجرة الزجاجة (شجرة أسترالية من جنس براتشيشيتون)",
 "bottle-fed": "رَضِيع صِنَاعِيًّا ((للرضيع) يعطى الحليب من زجاجة)",
 "bottle-grass": "ذيل الثعلب الأخضر (ذيل ثعلب أوروبي متوطن في أمريكا الشمالية؛ غالباً ما يكون عشبة ضارة مزعجة)",
 "bottle-green": "أَخْضَر زُجَاجِيّ (بلون أخضر داكن إلى معتدل مائل إلى الرمادي)",
 "bottle-nosed dolphin": "دلفين قاروري الأنف (أي من عدة دلافين ذات جبهة مستديرة ومنقار متطور؛ تعيش بشكل رئيسي في شمال المحيط الأطلسي والبحر الأبيض المتوسط)",
 "bottle-nosed whale": "حوت قاروري الأنف (حوت منقاري يعيش في شمال المحيط الأطلسي ذو جبهة منتفخة)",
 "bottle-shaped": "قَارُورِيّ الشَّكْل (على شكل قارورة)",
 "bottle-tree": "شجرة الزجاجة (شجرة أسترالية من جنس براتشيشيتون)",
 "bottlebrush": "فرشاة القوارير (فرشاة أسطوانية على عمود رفيع تستخدم لتنظيف الزجاجات)",
 "bottlebrush buckeye": "بكية فرشاة الزجاج, كستناء الحصان القزمية (شجيرة منتشرة بزهور وردية؛ توجد في جنوب شرق الولايات المتحدة)",
 "bottlecap": "غطاء الزجاجة (غطاء يغلق الزجاجة)",
 "bottled gas": "غاز معبأ, غاز نفطي مسال (غازات هيدروكربونية، عادة البروبان أو البوتان، محفوظة تحت الضغط)",
 "bottled water": "مِيَاه مُعَبَّأَة",
 "bottleful": "ملء زجاجة, ملء قارورة (الكمية المحتواة في زجاجة)",
 "bottleneck": "عُنُق الزُّجَاجَة",
 "bottlenose": "حوت قاروري الأنف (حوت منقاري يعيش في شمال المحيط الأطلسي ذو جبهة منتفخة) / دلفين قاروري الأنف (أي من عدة دلافين ذات جبهة مستديرة ومنقار متطور؛ تعيش بشكل رئيسي في شمال المحيط الأطلسي والبحر الأبيض المتوسط)",
 "bottlenose dolphin": "دلفين قاروري الأنف (أي من عدة دلافين ذات جبهة مستديرة ومنقار متطور؛ تعيش بشكل رئيسي في شمال المحيط الأطلسي والبحر الأبيض المتوسط)",
 "bottlenose whale": "حوت قاروري الأنف (حوت منقاري يعيش في شمال المحيط الأطلسي ذو جبهة منتفخة)",
 "bottler": "شركة تعبئة (مُصنِّع يصنع المشروبات ويعبئها)",
 "bottling plant": "مصنع تعبئة زجاجات (مصنع يتم فيه وضع المشروبات في زجاجات مع أغطية)",
 "bottom": "قَاع (أَرْض مستوية سهلة تنصب إِليها مياه الأمطار فتمسكها ثم تُنبت العشب؛ القَعْر) / قَعْر / سَالِب\nمثال: نمت في قاعة السينما.",
 "bottom dog": "شخص في أسفل السلم (شخص ذو مكانة منخفضة)",
 "bottom feeder": "انتهازي وضيع, مستغل للمصائب (انتهازي يتربح من مصائب الآخرين وسوء حظهم)",
 "bottom fermentation": "تخمر سفلي (نوع بطيء من التخمر الكحولي في درجة حرارة منخفضة بما يكفي لغرق خلايا الخميرة في قاع السائل المتخمر؛ يستخدم في إنتاج جعة اللاغر)",
 "bottom fermenting yeast": "خميرة التخمير السفلي (خميرة بيرة تستخدم في التخمير السفلي للجعة (لاغر))",
 "bottom fish": "سمك القاع (الأسماك التي تعيش في قاع البحر (خاصة أسماك القد المهمة تجارياً مثل القد والحدوق، أو الأسماك المفلطحة مثل الفلوندر))",
 "bottom line": "حاصل الأمر (الشيء :حصل عليه)",
 "bottom lurker": "قاطنات القاع (سمكة تكمن في قاع جسم مائي)",
 "bottom of the inning": "النصف الثاني من الشوط (النصف الثاني من الشوط (في البيسبول)؛ بينما يكون الفريق المضيف في وضع الضرب)",
 "bottom quark": "كُوَارْك قَعْرِيّ",
 "bottom rot": "عفن القاع (مرض فطري يصيب الخس حيث يعفن الأوراق السفلية أولاً وينتشر لأعلى)",
 "bottom rot fungus": "فطر عفن القاع (فطر يسبب عفن القاع في الخس)",
 "bottom round": "فخذة سفلية (قطعة من الفخذ المدورة؛ مناسبة لطهي القدر (الروستو))",
 "bottom-dweller": "متغذٍ قاعي (سمكة تعيش وتتغذى في قاع جسم مائي)",
 "bottom-dwelling": "قاعي المعيشة (من أو متعلق بالأسماك والحياة البحرية التي تعيش في قاع المسطح المائي)",
 "bottom-feeder": "متغذٍ قاعي (سمكة تعيش وتتغذى في قاع جسم مائي) / آكل القاع, متغذٍ قاعي (حيوان قمام يتغذى في أسفل السلسلة الغذائية)",
 "bottom-feeding": "قاعي التغذية (من أو متعلق بالأسماك والحياة البحرية التي تتغذى في قاع المسطح المائي)",
 "bottom-up": "من أسفل لأعلى (لنهج في حل المشكلات يبدأ بالتفاصيل ويعمل صعودًا إلى أعلى مستوى مفاهيمي)\nمثال: محلل من أسفل لأعلى",
 "bottomed": "ذو قاع, مقوع (له قاع ذو طابع محدد)",
 "bottomland": "أرض غرينية, أرض منخفضة (أرض منخفضة غرينية بالقرب من النهر)",
 "bottomless": "عَارِي النِّصْف السُّفْلِيّ (غير مكسوّ خاصة أسفل الخصر) / بِلَا قَاع, لَا قَعْرَ لَهُ (بَالِغُ العُمْقِ إِلَى أَقْصَى حَدٍّ) / لَا قَرَار لَهُ, لَا قَعْرَ لَهُ (عَميق إلى حَدّ لا نِهائِيّ؛ بِلا قاع) / بلا قاع (ليس له قاع)\nمثال: بيجاما بلا جزء سفلي تتكون ببساطة من قميص طويل يفتح من الأمام",
 "bottomless pit": "هَاوِيَة (مؤنث هاوٍ، الساقطة أو الواقعة؛ مؤنث هَاوٍ، المحبّة)\nمثال: وصل سامي إلى قاع الهاوية ماليا.",
 "bottomlessness": "عمق لا متناه, لا قاع له (خاصية كون الشيء عميقاً جداً؛ بلا حد)",
 "bottommost": "الأَسْفَل, فِي أَقْصَى القَاع (في أدنى نقطة أو أبعدها إلى الأسفل)",
 "botuliform": "نَقَانِقِيّ الشَّكْل (طويل ذو أطراف مُستديرة)",
 "botulin": "بوتولين, سم البوتولينوم (سم بكتيري قوي تنتجه بكتيريا المطثية الوشيقية يسبب التسمم الوشيقي؛ يمكن استخدامه كسلاح بيولوجي)",
 "botulinal": "وشيقي (من أو يتعلق ببكتيريا البوتولينوس أو ناتج عنها)",
 "botulinum": "بكتيريا التسمم الوشيقي, مِطَثِّيَّة وشيقية (بكتيريا لاهوائية تنتج الوشيقان (البوتولين)، وهو السم الذي يسبب التسمم الوشيقي)",
 "botulinum toxin": "ذيفان وشيقي (أي من الذيفانات العصبية المتعددة التي تنتجها بكتيريا المطثية الوشيقية اللاهوائية؛ تسبب شلل العضلات)",
 "botulinum toxin a": "بوتوكس, ذيفان وشيقي أ (سم عصبي يستخدم طبياً بكميات صغيرة لعلاج الاضطرابات العصبية وتجميلياً لتنعيم خطوط التجاعيد)",
 "botulinus": "بكتيريا التسمم الوشيقي, مِطَثِّيَّة وشيقية (بكتيريا لاهوائية تنتج الوشيقان (البوتولين)، وهو السم الذي يسبب التسمم الوشيقي)",
 "botulinus toxin": "بوتولين, سم البوتولينوم (سم بكتيري قوي تنتجه بكتيريا المطثية الوشيقية يسبب التسمم الوشيقي؛ يمكن استخدامه كسلاح بيولوجي)",
 "botulism": "تسمم سجقي, تسمم وشيقي (تسمم غذائي ناتج عن تناول البوتولين؛ يؤثر على الجهاز العصبي المركزي ويمكن أن يكون قاتلاً)",
 "botulismotoxin": "بوتولين, سم البوتولينوم (سم بكتيري قوي تنتجه بكتيريا المطثية الوشيقية يسبب التسمم الوشيقي؛ يمكن استخدامه كسلاح بيولوجي)",
 "bouchee": "بوشيه, قشرة الفطيرة المنتفخة (قشرة من العجينة المنتفخة)",
 "boucle": "بوكليه (قماش من خيوط غير مستوية له تأثير عقدي غير متساوٍ)",
 "boudoir": "بودوار, مخدع السيدة (غرفة نوم السيدة أو غرفة جلوس خاصة)",
 "bouffant": "مُنَفَّش, مُنْتَفِخ (منفوخ وبارز؛ يُستخدم لتسريحة الشعر أو الملابس) / تَسْرِيحَة مُنْتَفِخَة (تسريحة شعر للمرأة يبدو فيها الشعر منتفخاً)",
 "bouffe": "أوبرا كوميك, أوبرا هزلية (أوبرا ذات نهاية سعيدة وفيها بعض النصوص منطوقة)",
 "bougainville": "بُوغَانْفِيل",
 "bougainvillea": "بوغنفيلية, جهنمية (أي من الكروم الخشبية للزينة من جنس الجهنمية في أمريكا الجنوبية، تتميز بقنابات زهرية حمراء أو أرجوانية زاهية؛ تزرع على نطاق واسع في المناطق الدافئة)",
 "bougainvillea glabra": "جهنمية ملساء, زهرة الورق (كرمة برازيلية تميل للإزهار بشكل مستمر)",
 "bough": "غُصْن",
 "boughed": "ذُو أَغْصَان (لَهُ فُروع أَوْ أَغْصان)",
 "boughless": "بِلَا أَغْصَان (لَيْسَ لَهُ فُروع أَوْ أَغْصان)",
 "boughten": "مُشْتَرًى مِنَ المَتْجَرِ (مشترى وليس مصنوعاً في المنزل)",
 "bouillabaisse": "بويابيس (حساء أو يخنة متوسطية متبلة جداً مصنوعة من عدة أنواع من الأسماك والمحار مع الطماطم والبصل أو الكراث ومتبلة بالزعفران والثوم والأعشاب)",
 "bouillon": "بويون, مرق متبل (مرق صافي متبل)",
 "bouillon cube": "مكعب مرقة (مكعب من مستخلص اللحم المتبل والمبخر)",
 "boulder": "جُلْمُود, صَخْرَة كَبِيرَة (كتلة صخرية كبيرة ملساء منفصلة عن مكان نشأتها)",
 "boulder clay": "تيل, طين الجلاميد (تربة غير طبقية رسبها نهر جليدي؛ تتكون من الرمل والطين والحصى والجلاميد المختلطة معاً)",
 "boulder fern": "سرخس برائحة التبن (سرخس من شرق أمريكا الشمالية بسعف أخضر شاحب ورائحة تشبه التبن)",
 "bouldered": "حَجَرِيّ, صَخْرِيّ (مليء بالصخور أو الأحجار)",
 "bouldery": "حَجَرِيّ, صَخْرِيّ (مليء بالصخور أو الأحجار)",
 "boule": "بول, تطعيم بول (زخرفة أثاث مطعمة؛ حيث تشكل صدفة السلحفاة والمعدن الأصفر والأبيض لفائف في أعمال النجارة)",
 "boulevard": "جادة, شارع عريض (شارع عريض أو طريق عام)",
 "boulevardier": "متنزه في الشوارع (زائر لشوارع المدينة (خاصة في باريس))",
 "boulle": "بول, تطعيم بول (زخرفة أثاث مطعمة؛ حيث تشكل صدفة السلحفاة والمعدن الأصفر والأبيض لفائف في أعمال النجارة)",
 "bounce": "قفزة, وثبة (حركة خفيفة ذاتية الدفع لأعلى أو للأمام) / ارتداد (جودة المادة القادرة على الارتداد) / ارتداد, نط (الارتداد من ارتطام (أو سلسلة من الارتطامات))",
 "bouncer": "حارِس أَمْن, طارِد المُشاغِبِين (شخص وظيفته إخراج مثيري الشغب من حانة أو اجتماع عام)",
 "bounciness": "ارتداد (جودة المادة القادرة على الارتداد)",
 "bouncing": "حَيَوِيّ, مِقْدَام (يتميّز بالحركة النشطة والحيوية) / مَليء بِالحَيَوِيَّة, نَشيط (يَتَمَتَّع بِصِحَّة جَيِّدَة وحَيَوِيَّة واضِحَة) / ارتداد, نط (الارتداد من ارتطام (أو سلسلة من الارتطامات))",
 "bouncing bess": "صابونية مخزنية, عرق الحلاوة (نبات من أصل أوروبي له زهور وردية أو بيضاء وأوراق تنتج منظفاً عند سحقها)",
 "bouncing bet": "صابونية مخزنية, عرق الحلاوة (نبات من أصل أوروبي له زهور وردية أو بيضاء وأوراق تنتج منظفاً عند سحقها)",
 "bouncing betty": "لغم وثاب (لغم أرضي مضاد للأفراد)",
 "bouncing putty": "معجون نطاط (بوليمر سيليكوني مرن ناعم تزداد مرونته مع تطبيق القوة؛ يستخدم في مركز كرات الغولف وكبطانة لامتصاص الصدمات)",
 "bouncy": "حَيَوِيّ, مِقْدَام (يتميّز بالحركة النشطة والحيوية) / مَرِنٌ مُرْتَدّ, نَابِض (مرن ويرتدّ بسهولة)",
 "bound": "مُتَّجِه",
 "bound form": "مورفيم مقيد",
 "bound morpheme": "مورفيم مقيد",
 "bound up": "مُسْتَغْرِق, مُنْهَمِك (شديد التعلّق والانهماك في شيء ما) / وَثِيقُ الِارْتِبَاطِ (مرتبط ارتباطاً وثيقاً أو لا ينفصل عنه)",
 "boundary": "حَدّ (مُنْتَهى الشيءِ؛ الْفَصْلُ بَيْنَ الشَّيْئَيْنِ لِئَلَّا يَخْتَلِطَ أَحدهما بِالْآخَرِ أَو لِئَلَّا يَتَعَدَّى أَحدهما عَلَى الْآخَرِ)\nمثال: أعرفها إلى حد ما.",
 "boundary condition": "شرط حدي ((رياضيات) شرط محدد لحل مجموعة من المعادلات التفاضلية)",
 "boundary layer": "طبقة حدية (طبقة التدفق الأبطأ لسائل مار بسطح ما)",
 "boundary line": "حد فاصل, خط الحدود (خط يشير إلى الحدود)",
 "bounded": "مَحْدُود, مُحَدَّد المَعَالِم (تَمَّ تَعْيِينُ حُدُودِهِ أَوْ مَعَالِمِهِ)",
 "bounded interval": "فترة مغلقة (فترة تتضمن نقطتي نهايتها)",
 "boundedness": "محدودية, نهائية (صفة كون الشيء متناهياً أو محدوداً)",
 "bounden": "مُلْزِمٌ أَخْلَاقِيًّا (واجب أخلاقيًّا)",
 "bounder": "واثب (شخص يثب أو يقفز (كما في المنافسة)) / خسيس, دنيء (شخص مذموم أخلاقياً)\nمثال: أيها الكلب القذر",
 "bounderish": "سَيِّئُ التَّرْبِيَةِ, قَلِيلُ الْأَدَبِ ((عن الأشخاص) يفتقر إلى الرقة أو اللباقة)",
 "boundless": "بِلَا حُدُود, لَامَحْدُود (يَبْدُو بِلَا حُدُودٍ فِي الكَمِّيَّةِ أَوِ العَدَدِ أَوِ الدَّرَجَةِ أَوِ المَدَى)",
