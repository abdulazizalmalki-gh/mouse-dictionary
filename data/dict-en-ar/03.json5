 "behest": "أمر, طلب ملح (أمر سلطوي أو طلب)",
 "behind": "وَرَاءَ",
 "behind bars": "خَلْفَ الْقُضْبَان, وَرَاءَ الْقُضْبَان (بَدَلَ، أَعْقَبَ؛ أَتَى بعده أو جاء مكانه)\nمثال: دار زيري للخلف.",
 "behind closed doors": "خلف الأبواب المغلقة (بَدَلَ، أَعْقَبَ؛ أَتَى بعده أو جاء مكانه)\nمثال: دار زيري للخلف.",
 "behind the scenes": "مِن وَرَاءَ السِّتارِ, وَرَاءَ الكَوالِيسِ (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "behind the wheel": "خَلْفَ الْمِقْوَد (بَدَلَ، أَعْقَبَ؛ أَتَى بعده أو جاء مكانه)\nمثال: دار زيري للخلف.",
 "behind-the-scenes": "خَلْفَ الكَوَالِيس, سِرِّيّ (مُصَمَّمٌ وَمُنَفَّذٌ بِسِرِّيَّةٍ أَوْ بِشَكْلٍ سِرِّيّ)",
 "behindhand": "فِي حَالَة دَيْن, مُتَأَخِّر (في حالة دين أو تأخر عن سداد المستحقات) / مُتَأَخِّر, مُتَخَلِّف (متأخّر عن الموعد المحدّد)\nمثال: تأخر في سداد أقساط الرهن العقاري",
 "behmenism": "بوهمية (العقيدة اللاهوتية الصوفية لجاكوب بوهم التي أثرت في الكويكرز)",
 "behold": "هُوَذَا / هَا",
 "beholder": "مراقب, مُدرِك (شخص يصبح واعياً (بالأشياء أو الأحداث) من خلال الحواس)",
 "beholding": "إبصار, إدراك بصري (الإدراك عن طريق العينين)",
 "behove": "لاءم",
 "beige": "بِيج",
 "beigel": "بيغل, كعك البيغل ((اليديشية) لفافة مصقولة مخمرة بالخميرة على شكل حلقة ذات قشرة صلبة)",
 "beignet": "بينييه, فطيرة فرنسية مقلية (دونات مقلية مخمرة بالخميرة ومرشوشة بسكر الحلواني)",
 "beijing": "بِكِين / پِكِين",
 "beijing dialect": "الصينية الفصحى, الماندرين (لهجة صينية يتم التحدث بها في بكين وتم اعتمادها كلغة رسمية للصين بأكملها)",
 "beijinger": "بِكِينِيّ, بِكِينِيَّة",
 "being": "كَائِن, مَخْلُوق / كَيْنُونَة, كَوْن",
 "beingness": "كيان, كينونة (حالة أو حقيقة الوجود)\nمثال: وجهة نظر بدأت تظهر للوجود تدريجياً",
 "beirut": "بَيْرُوت",
