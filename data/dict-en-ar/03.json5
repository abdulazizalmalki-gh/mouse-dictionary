 "breast drill": "مثقاب صدري (مثقاب محمول مزود بلوحة يتم ضغطها على الصدر لدفع رأس المثقاب في العمل)",
 "breast feeding": "رضاعة طبيعية (التغذية من الثدي)",
 "breast implant": "زرعة ثدي (زرعة لأغراض تجميلية لتحل محل الثدي الذي تم استئصاله جراحياً)",
 "breast milk": "حليب الأم (هو اللَبَن المَحْلُوْب، أو ما لم يتغير طعمه. أصل التسمية؛ هو ما لم يَرُوْب واللَبَن هو ما رَابَ)\nمثال: كنت أشرب الحليب",
 "breast of lamb": "صدر ضأن (قطعة من الضأن تشمل عظم القص والعضلات المتصلة به مجهزة كلحم)",
 "breast of veal": "صدر عجل (عادة ما يُحشى ويُشوى)",
 "breast pocket": "جيب صدر (جيب في الجزء الداخلي أو الخارجي العلوي من معطف الرجل)",
 "breast-deep": "حَتَّى الصَّدْر (حتى الصدر)\nمثال: كنا نقف في الماء حتى الصدر",
 "breast-fed": "رَضِيع طَبِيعِيًّا ((للرضيع) يتغذى على الحليب من ثدي الأم)",
 "breast-high": "حَتَّى الصَّدْر (حتى الصدر)\nمثال: كنا نقف في الماء حتى الصدر",
 "breastbone": "قَصّ",
 "breasted": "ذو ثدي (يمتلك ثديًا أو أثداء؛ أو أثداء كما هو محدد (تستخدم في المركبات))\nمثال: صغير الثدي",
 "breastfeed": "أَرْضَعَ ((أَرْضَعَت) الْأُم: كَانَ لَهَا ولد تُرْضِعه؛ (أَرْضَعَت) الْولد: جعلته يرضع فَهِيَ مرضع ومرضعة (ج) مراضع)",
 "breastfeeding": "رَضَاعَة طَبِيعِيَّة",
 "breastless": "عديم الثدي (بدون ثدي)",
 "breastpin": "بروش, دبوس صدر (دبوس مزخرف ترتديه النساء)",
 "breastplate": "لَبَب",
 "breaststroke": "سباحة الصدر (طريقة سباحة؛ تُمد الذراعان معاً أمام الرأس وتُسحبان للخلف على الجانبين مصحوبة بركلة الضفدع)",
 "breaststroker": "سباح صدر (شخص يسبح سباحة الصدر)",
 "breastwork": "حاجز صد, ساتر (تحصين يتكون من جدار منخفض)",
 "breath": "نَفَس (النَّفْسُ : الرُّوحُ؛ النَّفْسُ :الدَّمُ، فشاهده قول السموأَل: تَسِيلُ على حَدِّ الظُّبَّاتِ نُفُوسُنَا…)\nمثال: هم في نفس السن.",
 "breath of fresh air": "متنفس, نسمة هواء عليل (ارتياح مرحب به)\nمثال: كانت الإدارة الجديدة بمثابة نسمة هواء عليل",
 "breathalyser": "جهاز فحص الكحول, مقياس الكحول بالنفس (جهاز يقيس المواد الكيميائية (خاصة محتوى الكحول) في زفير الشخص)",
 "breathalyzer": "جهاز فحص الكحول, مقياس الكحول بالنفس (جهاز يقيس المواد الكيميائية (خاصة محتوى الكحول) في زفير الشخص)",
 "breathe": "تَنَفَّسَ",
 "breathed": "بِلَا صَوْت, مَهْمُوس (يُنطق بدون صوت حنجري)",
 "breather": "أنبوب التنفس, سنوركل (ممر هوائي يوفره جهاز قابل للسحب يحتوي على أنابيب سحب وعادم؛ يسمح للغواصة بالبقاء تحت الماء لفترات طويلة) / فترة التقاط الأنفاس, متنفس (استراحة قصيرة)",
 "breathing": "تَنَفُس, نَفَس",
 "breathing apparatus": "جهاز تنفس, جهاز تنفس صناعي (جهاز يسهل عملية التنفس في حالات الفشل التنفسي)",
 "breathing device": "جهاز تنفس, جهاز تنفس صناعي (جهاز يسهل عملية التنفس في حالات الفشل التنفسي)",
 "breathing in": "استنشاق, شهيق (فعل الشهيق؛ سحب الهواء (أو غازات أخرى) للداخل كما في التنفس)",
 "breathing machine": "جهاز تنفس, جهاز تنفس صناعي (جهاز يسهل عملية التنفس في حالات الفشل التنفسي)",
 "breathing out": "إخراج النفس, زفير (فعل إخراج الهواء من الرئتين)",
 "breathing place": "فترة التقاط الأنفاس, متنفس (استراحة قصيرة)",
 "breathing room": "مُتَنَفَّس, مُتَّسَع (حيز كافٍ للتنفس أو الحركة بسهولة)\nمثال: انتقل إلى الريف ليجد متنفساً",
 "breathing space": "مُتَنَفَّس, مُتَّسَع (حيز كافٍ للتنفس أو الحركة بسهولة) / فترة التقاط الأنفاس, متنفس (استراحة قصيرة)\nمثال: انتقل إلى الريف ليجد متنفساً",
 "breathing spell": "فترة التقاط الأنفاس, متنفس (استراحة قصيرة)",
 "breathing time": "فترة التقاط الأنفاس, متنفس (استراحة قصيرة)"
}
