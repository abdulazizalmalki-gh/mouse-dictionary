 "boolean": "بولي, بولياني (من أو متعلق بنظام توافقي ابتكره جورج بول يجمع بين القضايا والعمليات المنطقية (و، أو، إذا، إذن، ماعدا، ليس))",
 "boolean algebra": "جبر بولياني, منطق بولياني (نظام للمنطق الرمزي ابتكره جورج بول؛ يستخدم في أجهزة الحاسوب)",
 "boolean logic": "جبر بولياني, منطق بولياني (نظام للمنطق الرمزي ابتكره جورج بول؛ يستخدم في أجهزة الحاسوب)",
 "boolean operation": "عملية ثنائية, عملية منطقية (عملية تتبع قواعد الجبر البولياني؛ يأخذ كل معامل والنتيجة إحدى قيمتين)",
 "boom": "ذراع التطويل, عوارضة (أي من الصواري أو الأعمدة الأفقية المتنوعة المستخدمة لتمديد أسفل الشراع أو لمناولة البضائع أو في الإرساء) / بوم, ذراع الميكروفون (عمود يحمل ميكروفوناً علوياً مسلطاً فوق موقع تصوير فيلم أو تلفزيون) / دوي, رعد (ضجيج عميق طويل وعالٍ) / رزق ساقه الله, رواج (حدث مفاجئ يجلب الحظ السعيد (مثل فرصة مفاجئة لكسب المال))\nمثال: خلق الطلب على الاختبار طفرة لتلك المختبرات غير الخاضعة للتنظيم",
 "boom box": "مسجل محمول كبير (جهاز ستيريو محمول)",
 "boom town": "مدينة مزدهرة (بلدة تتمتع بازدهار مفاجئ)",
 "boomer": "مَوْلُود طَفْرَة الْمَوَالِيد (عضو في جيل طفرة المواليد في الخمسينيات)\nمثال: قاموا بتوسيع المدارس لجيل من مواليد الطفرة",
 "boomerang": "بُومَرَانْغ, عُرْجُد",
 "booming": "جَهْوَرِيّ, مُجَلْجِل ((للصوت) عميق ورنّان) / رَائِج, مُزْدَهِر (حيوي ومربح للغاية؛ في حالة ازدهار ونمو)",
 "boon": "أَنِيس, رَفِيق (قريب جداً وأليف في العشرة) / بركة, منحة (حالة مرغوبة)\nمثال: استمتع بنعم السلام",
 "boondocks": "أحراش, منطقة نائية (منطقة نائية وغير متطورة)",
 "boondoggle": "عمل تافه, عمل لا طائل منه (عمل قليل القيمة أو معدوم القيمة يتم القيام به لمجرد الظهور بمظهر المشغول)",
 "boor": "عديم التربية, فظ (شخص فظ غير مهذب يفتقر للثقافة أو الرقي)",
 "boorish": "غَلِيظٌ, فَظٌّ (سيئ السلوك وخشن ومحتقر في التصرف أو المظهر)",
 "boorishly": "بِسُوقِيَّة, بِغِلْظَة (مثل شخص فظ)\nمثال: تصرف بفظاظة في الحفلة",
 "boorishness": "جَلَافَة, غَلَاظَة (انعدام الأناقة بسبب كون الشخص غليظاً وجلفاً) / خشونة, غلظة (أسلوب شخص وقح أو غير حساس)",
 "boost": "تشجيع, دعم (فعل إعطاء الأمل أو الدعم لشخص ما) / دفعة مساعدة, رفع (فعل إعطاء دفعة) / ارتفاع, زيادة (زيادة في التكلفة)\nمثال: ساعدها بدفعة لتجاوز السياج",
 "booster": "جرعة داعمة, جرعة معززة (جرعة إضافية للتأكد من فعالية الجرعة الأولى) / صاروخ معزز, معزز الإقلاع (المرحلة الأولى من صاروخ متعدد المراحل) / محطة تقوية, معزز (مضخم لاستعادة قوة الإشارة المرسلة) / سارق متاجر (لص يسرق البضائع الموجودة في متجر)",
 "booster amplifier": "محطة تقوية, معزز (مضخم لاستعادة قوة الإشارة المرسلة)",
 "booster cable": "كابل اشتراك, كابل توصيل (وصلة تتكون من قطعة قصيرة من السلك)\nمثال: كانت عبارة عن تشابك من كابلات التوصيل والأسلاك المشبكية",
 "booster dose": "جرعة داعمة, جرعة معززة (جرعة إضافية للتأكد من فعالية الجرعة الأولى)",
 "booster rocket": "صاروخ معزز, معزز الإقلاع (المرحلة الأولى من صاروخ متعدد المراحل)",
 "booster shot": "جرعة داعمة, جرعة معززة (جرعة إضافية للتأكد من فعالية الجرعة الأولى)",
 "booster station": "محطة تقوية, معزز (مضخم لاستعادة قوة الإشارة المرسلة)",
 "booster unit": "صاروخ معزز, معزز الإقلاع (المرحلة الأولى من صاروخ متعدد المراحل)",
 "boot": "جَزْمَة (الأكلة الواحدة ليلا ونهارا؛ هي السُكُون بمعنى علامة الجزم من الحركات) / بسطار",
 "boot camp": "معسكر تدريب (معسكر لتدريب المجندين العسكريين)",
 "boot maker": "صانع أحذية طويلة (صانع للأحذية الطويلة (الجزم))",
 "boot sale": "بيع السلع المستعملة, سوق صندوق السيارة (بيع في الهواء الطلق يبيع فيه الناس أشياء من صناديق سياراتهم)",
 "boot-shaped": "حِذَائِيّ الشَّكْل (على شكل حذاء طويل)",
 "bootblack": "ماسح أحذية (شخص يقوم بتلميع الأحذية)",
 "bootboys": "حليقي الرؤوس, سكين هيدز (ثقافة فرعية شبابية ظهرت لأول مرة في إنجلترا في أواخر الستينيات كرد فعل للطبقة العاملة على الهيبيز؛ كان الشعر مقصوصاً بالقرب من فروة الرأس؛ ارتدوا…)",
 "booted": "مُنْتَعِل جَزْمَة (يرتدي جزمة أو حذاءً طويلاً)",
 "booted armillaria": "أرميلاريا منتعلة (فطر بقبعة بنية وخياشيم بيضاء وحلقة غشائية في منتصف الساق)",
 "bootee": "جوارب للأطفال, خف صوفي (خف ناعم وصوفي (للأطفال الرضع))",
 "booth": "كُشْك (هو الكِشْك في بعض اللهجات العربية؛ شبه رِوَاق بارز عن مساواة بقية البيت) / حُجَيْرَة, كَابِينَة",
 "boothose": "جورب حذاء برقبة (جوارب واقية تلبس مع الأحذية ذات الرقبة أو بدلاً منها)",
 "bootie": "جوارب للأطفال, خف صوفي (خف ناعم وصوفي (للأطفال الرضع))",
 "bootjack": "خالع الأحذية, مِخْلع",
 "bootlace": "رباط الجزمة, رباط الحذاء الطويل (رباط طويل لربط الأحذية العالية (الجزمات))",
 "bootleg": "مُحَرَّم, مُهَرَّب (مُنْتَج أَوْ مُتاجَر بِهِ بِشَكْل غَيْر قانونِيّ) / عنق الحذاء (الجزء من الحذاء الطويل فوق مشط القدم) / خمر مهرب, مون شاين (ويسكي مقطر بشكل غير قانوني من هريس الذرة)",
 "bootlegger": "مهرب كحول (شخص يصنع أو يبيع الخمور غير القانونية)",
 "bootlegging": "تهريب الكحول (فعل صنع أو نقل المشروبات الكحولية للبيع بشكل غير قانوني) / بيع غير قانوني (فعل البيع بشكل غير قانوني أو بدون إذن)\nمثال: جعل تعديل الحظر تهريب الكحول مربحاً",
 "bootless": "سُدًى, عَبَثِيّ (لا يؤدّي إلى نجاح أو نتيجة مرجوّة)",
 "bootlicker": "خَنُوع, مُتَذَلِّل (شخص يذل نفسه كعلامة على الاحترام؛ يتصرف وكأنه بلا كرامة)",
 "bootlicking": "مُتَزَلِّف, مُتَمَلِّق (يَسْعَى لِكَسْب الوُدّ بِالتَّمَلُّق) / مُتَزَلِّف, مُتَمَلِّق (يُحَاوِل كَسْب وُدّ ذَوِي النُّفُوذ بِالتَّمَلُّق)",
 "bootmaker": "صانع أحذية طويلة (صانع للأحذية الطويلة (الجزم))",
 "bootstrap": "عروة الحذاء (شريط يتم لفه وخياطته في الجزء العلوي من الحذاء لسحبه وارتدائه)",
 "boott's goldenrod": "عصا الذهب بوت (ما يتخذ من خَشَب للتوكؤ أو الضرب؛ تطلق مجازا على عَظْم السَاق وعلى اللِسَان)\nمثال: لا تمسك العصا من الوسط.",
 "booty": "مَغَانِم",
 "booyong": "زان أحمر, هريتييرا ثلاثية الأوراق (شجرة كبيرة من أسترالاسيا)",
 "booze": "كُحُول (سَائِلٌ لاَ لَوْنَ لَهُ، لاَذِعُ الطَّعْمِ، يُسْتَخْرَجُ مِنْ تَخْمِيرِ بَعْضِ الْمَوَادِّ، يُمْزَجُ بِالْمَشْرُوبَاتِ الرُّوحِيَّةِ…) / خَمْر (شَرَابُ الْعِنَبِ إِذَا اخْتَمَرَ؛ كُلُّ مُسْكِرٍ مُخَامِرٍ لِلْعَقْلِ، إِذَا كَانَ شَرَاباً كُحُولِيّاً أَوْ غَيْرَهُ)\nمثال: أكره ذوق الكحول.",
 "booze-up": "حفل سُكْر, معاقرة الخمر (الاحتفال الصاخب بشرب الكحول؛ حفلة شرب مرحة)",
 "boozer": "كحولي, مدمن كحول (شخص يشرب الكحول بإفراط وبشكل اعتيادي)",
 "boozing": "إدمان الخمر, سكر (فعل شرب المشروبات الكحولية بإفراط)\nمثال: كان السكر سبب سقوطه",
 "boozy": "سِكِّير, مُدْمِن الخَمْر (مُنْغَمِس فِي شُرْب الكُحُول أَوْ يَتَّسِم بِهِ)",
 "bop": "بوب, بيبوب (شكل مبكر من الجاز الحديث (نشأ حوالي عام 1940)) / المكتب الفيدرالي للسجون (وكالة إنفاذ القانون التابعة لوزارة العدل التي تدير نظامًا وطنيًا من السجون ومرافق الاحتجاز لسجن النزلاء المحكوم عليهم بالسجن لجرائم فيدرالية)",
 "bopeep": "لعبة إخفاء الوجه, ملاعبة الطفل (لعبة تُلعب مع الأطفال الصغار؛ تخفي وجهك وتكشفه فجأة وأنت تقول بخ!)",
 "boracic": "بوريك (من أو متعلق أو مشتق من أو يحتوي على البورون)\nمثال: حمض البوريك",
 "boracic acid": "حمض البوريك (أي من الأحماض المختلفة التي تحتوي على البورون والأكسجين)",
 "borage": "حِمْحِم",
 "borago officinalis": "بوراج, حمحم (عشب حولي أوروبي مشعر أزرق الزهر يستخدم منذ فترة طويلة في طب الأعشاب وتؤكل أوراقه نيئة كسلطة خضراء أو مطبوخة مثل السبانخ)",
 "boran": "بُورَانْدُخْت",
 "borassus flabellifer": "دوم, نخلة تدمر (نخيل مروحي طويل من أفريقيا والهند وماليزيا ينتج خشباً صلباً وعصارة حلوة تعد مصدراً لنبيذ النخيل والسكر؛ وتستخدم الأوراق للتسقيف والنسيج)",
 "borate": "بورات (ملح أو إستر لحمض البوريك)",
 "borated": "مبورق (مخلوط أو مشبع بالبوراكس)",
 "borax": "بَوْرَق",
 "bordeaux": "بُورْدُو, بُرْذَال",
 "bordeaux mixture": "مزيج بوردو (عامل مضاد للفطريات يتكون من محلول كبريتات النحاس والجير الحي)",
 "bordeaux wine": "بوردو, نبيذ بوردو (أي من أنواع النبيذ الأحمر أو الأبيض المتعددة المنتجة حول بوردو بفرنسا أو النبيذ المشابه لها)",
 "bordelaise": "بوردوليز (صلصة بنية مع نخاع البقر والنبيذ الأحمر)",
 "bordello": "بيت دعارة, ماخور (مبنى تتوفر فيه البغايا)",
 "border": "حَدّ, حُدُود (مُنْتَهى الشيءِ؛ الْفَصْلُ بَيْنَ الشَّيْئَيْنِ لِئَلَّا يَخْتَلِطَ أَحدهما بِالْآخَرِ أَو لِئَلَّا يَتَعَدَّى أَحدهما عَلَى الْآخَرِ)\nمثال: أعرفها إلى حد ما.",
 "border collie": "بوردر كولي (كلب تم تطويره في المنطقة بين اسكتلندا وإنجلترا، عادة ما يكون له فراء أسود مع أبيض على الرأس وطرف الذيل، يستخدم لرعي كل من الأغنام والماشية)",
 "border district": "تخوم, منطقة حدودية (منطقة تتكون من المساحة الموجودة على جانبي حدود دولة أو منطقة ما)\nمثال: التخوم الويلزية بين إنجلترا وويلز",
 "border guard": "حَرْس الْحُدُود (حَفِظَ الشيء أو الشخص أو مكاناً من المخاطر أو الأضرار؛ راقب شيئاً أو شخصاً بعناية لضمان الأمان)\nمثال: كان لدى سامي حرس شخصي.",
 "border patrol": "حرس الحدود (مجموعة من الضباط الذين يقومون بدوريات على حدود الدولة)",
 "border patroller": "حَرَس الحُدُود, دَوْرِيَّة الحُدُود (شخص يقوم بدوريات على حدود الدولة)",
 "border patrolman": "حرس حدود (رجل يقوم بدوريات على حدود بلد ما)",
 "border patrolwoman": "حارسة حدود (امرأة تقوم بدوريات على حدود بلد ما)",
 "border terrier": "بوردر تيريير (تيريير صغير خشن الفراء من أصل بريطاني)",
 "bordered": "ذُو حَاشِيَة, مَحْدُود (لديه حدود خاصة من نوع محدد؛ يستخدم أحياناً كمصطلح دمج)\nمثال: منديل محاط باللون الأسود",
 "borderer": "ساكن الحدود (أحد سكان منطقة حدودية (خاصة الحدود بين اسكتلندا وإنجلترا))",
 "borderland": "تخوم, منطقة حدودية (منطقة تتكون من المساحة الموجودة على جانبي حدود دولة أو منطقة ما)\nمثال: التخوم الويلزية بين إنجلترا وويلز",
 "borderline": "حَدِّيّ, هَامِشِيّ (ذو جودة مشكوك فيها أو ضئيلة) / حد فاصل, خط الحدود (خط يشير إلى الحدود)",
 "borderline intelligence": "ذَكَاء حَدِّيّ (الحد الأدنى من نسبة الذكاء المطلوب لشخص ما ليعمل بشكل طبيعي ومستقل في العالم (دون شكل من أشكال المساعدة المؤسسية))",
 "borderline personality disorder": "اضطراب الشخصية الحدي",
 "borderline schizophrenia": "فصام حدي, فصام كامن (فصام يتميز بأعراض خفيفة أو بميل سابق للفصام)",
 "bore": "أَمَلَّ ((أَمَّلَه): أَمَلَهُ يُقَال: فلَان بَحر المؤمل)\nمثال: أشعر بخيبة أمل.",
 "bore bit": "ريشة حفر الصخر, مثقاب الصخور (مثقاب لاختراق الصخور)",
 "bore-hole": "بئر استكشافي, ثقب حفر (ثقب أو ممر مصنوع بواسطة مثقاب؛ عادة ما يصنع لأغراض استكشافية)",
 "boreal": "بُورِيَالِيّ, قُطْبِيّ شَمَالِيّ (يشمل المناطق الشمالية البعيدة أو ينتشر فيها) / شمالي (نحو أو يقع في الشمال) / شمالي (متعلق بـ أو يتسم بصفات مرتبطة بالرياح الشمالية)\nمثال: الأبراج الشمالية من دائرة البروج",
 "boreas": "رياح شمالية (رياح تهب من الشمال)",
 "borecole": "كايل, كرنب أجعد (كرنب قوي ذو أوراق مجعدة خشنة لا تشكل رأساً)",
 "bored": "مَلُول, ضَجِر",
 "boredom": "مَلَل, ضَجَر",
 "borer": "ثاقبة الخشب, حفار الخشب (أي من الحشرات أو اليرقات أو الرخويات المختلفة التي تحفر في الخشب) / ريشة حفر الصخر, مثقاب الصخور (مثقاب لاختراق الصخور)",
 "borhani": "بُرْهَانِي",
 "boric": "بوريك (من أو متعلق أو مشتق من أو يحتوي على البورون)\nمثال: حمض البوريك",
 "boric acid": "حمض البوريك (أي من الأحماض المختلفة التي تحتوي على البورون والأكسجين) / حمض الأرثوبوريك, حمض البوريك (مادة صلبة بيضاء أو عديمة اللون حمضية قليلاً قابلة للذوبان في الماء والإيثانول؛ تستخدم في صناعة الزجاج والورق والمواد اللاصقة وفي المنظفات وكمطهر…)",
 "boring": "مُمِلّ, مُضْجِر (ما يسبب الضجر والضيقة، غير مثير للاهتمام)\nمثال: نهار اليوم ممل!",
 "boringly": "بشكل ممل, بضجر (بطريقة مملة)\nمثال: عمل بطيء بشكل ممل",
 "boringness": "رَتَابَة, سَآمَة (الملل الشديد؛ الافتقار إلى الروح أو الاهتمام)",
 "boris": "بُورِيس",
 "born": "مَوْلُود",
 "born with a silver spoon in one's mouth": "وُلِدَ وَفِي فَمِهِ مِلْعَقَةٌ مِن ذَهَب (الرجلُ و المرأةُ ومثلهما الانسان: أنجب؛ الرجلُ و المرأةُ وَلَدًا: أنجبه)\nمثال: أعرف ذلك الولد.",
 "born-again": "مَوْلُودٌ مِنْ جَدِيدٍ, مُتَجَدِّدُ الْإِيمَانِ (وُلد من جديد روحياً أو اهتدى)",
