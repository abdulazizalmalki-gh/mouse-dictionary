 "box girder": "عارضة صندوقية (عارضة مبنية من ألواح؛ لها مقطع عرضي مستطيل مجوف)",
 "box huckleberry": "عنب الأحراش الصندوقي (شجيرة زاحفة دائمة الخضرة من جنوب شرق الولايات المتحدة لها أوراق صغيرة لامعة تشبه الصندوق وثمار عديمة النكهة)",
 "box kite": "طائرة ورقية صندوقية (طائرة ورقية على شكل صندوق مفتوح من كلا الطرفين)",
 "box kodak": "كاميرا صندوقية (كاميرا بسيطة على شكل صندوق مستطيل)",
 "box number": "رقم الصندوق (عنوان بريدي يمكن إرسال الردود على إعلان صحفي إليه) / رقم صندوق البريد (رقم صندوق رسائل في مكتب البريد حيث يتم جمع البريد)",
 "box office": "شباك التذاكر (المكتب الذي تباع فيه تذاكر الدخول) / إيرادات التذاكر, شباك التذاكر (إجمالي إيرادات الدخول للترفيه)",
 "box pleat": "كسرة مربعة (طية مزدوجة مسطحة تُصنع عن طريق طي القماش تحتها من كلا الجانبين)",
 "box seat": "صندوق السائق, مقعد السائق (مقعد السائق في العربة التي تجرها الخيول) / مقصورة, مقعد المقصورة (مقعد خاص في مسرح أو مقصورة المتفرجين)\nمثال: جلس حارس مسلح في مقعد السائق",
 "box spring": "قاعدة سرير زنبركية (زنبرك سرير ملفوف في إطار مغطى بالقماش)",
 "box tortoise": "سلحفاة صندوقية (سلحفاة برية بشكل رئيسي من أمريكا الشمالية؛ يمكن إغلاق صدفتها بإحكام)",
 "box turtle": "سلحفاة صندوقية (سلحفاة برية بشكل رئيسي من أمريكا الشمالية؛ يمكن إغلاق صدفتها بإحكام)",
 "box white oak": "بلوط عمودي (شجرة متساقطة الأوراق صغيرة من شرق ووسط الولايات المتحدة لها أوراق ريشية قيثارية خضراء داكنة وخشب قوي مقاوم للرطوبة يستخدم خاصة لأعمدة السياج)",
 "box wrench": "مفتاح حلقي, مفتاح مغلق (مفتاح ربط بحلقة مغلقة (لقمة) تتناسب فوق صامولة أو رأس مسمار)",
 "box-shaped": "شَبِيهٌ بِالصُّنْدُوقِ, صُنْدُوقِيّ (يشبه الصندوق في استطالته)",
 "boxberry": "عنب الأرض, وينترغرين (فاكهة حمراء حارة تشبه التوت؛ مصدر لزيت وينترغرين) / توت الحجل, ميتشيلا (نبات خشبي زاحف في شرق أمريكا الشمالية بأوراق دائمة الخضرة لامعة وتوت قرمزي)",
 "boxcar": "عربة شحن مغلقة (عربة شحن بسقف وأبواب منزلقة في الجوانب)",
 "boxcars": "اثْنَا عَشَر (نَرْد), عَرَبَات القِطَار ((عادة بصيغة الجمع) تعبير يستخدم عند رمي حجري نرد وظهور ست نقاط على كل منهما)",
 "boxed": "فِي إِطَار, مُؤَطَّر (محاط أو محدد بإطار أو مربع) / مَحْصُور, مُعَلَّب (محاط في صندوق أو كأنه في صندوق)",
 "boxer": "مُلَاكِم",
 "boxers": "بوكسر, سروال داخلي رجالي (سراويل داخلية يرتديها الرجال)",
 "boxershorts": "بوكسر, سروال داخلي رجالي (سراويل داخلية يرتديها الرجال)",
 "boxfish": "سمكة الصندوق (أي من الأسماك الاستوائية الصغيرة العديدة التي يكون جسمها ورأسها مغلفين بصفائح عظمية)",
 "boxful": "ملء صندوق, ملء علبة (الكمية المحتواة في صندوق أو علبة)\nمثال: أعطاها علبة من الشوكولاتة",
 "boxing": "مُلَاكَمَة",
 "boxing day": "يَوْم اَلصَّنَادِيق, بُوكْسِينْج دَاي (فترة من الزمان تبدأ عند غُرُوب الشمس وتنتهي عند غُرُوب شمس النهار التالي ويشمل اللَيْلَة ونَهَارا. طوله أربع وعشرين سَاعَة؛ النَهَار، يبدأ من طلوع الفَجْر إلى غُرُوب الشَمس، على المجاز)\nمثال: طقس اليوم جميل.",
 "boxing equipment": "معدات الملاكمة (المعدات المستخدمة في الملاكمة)",
 "boxing glove": "قفاز الملاكمة (معدات ملاكمة تتكون من أغطية كبيرة ومبطنة لقبضات المقاتلين؛ ترتدى لرياضة الملاكمة)",
 "boxing match": "مباراة ملاكمة (مباراة بين ملاكمين؛ تقام عادة في حلبة ملاكمة)",
 "boxing ring": "حلبة الملاكمة (حلبة مربعة حيث يقاتل الملاكمون)",
 "boxlike": "شَبِيهٌ بِالصُّنْدُوقِ, صُنْدُوقِيّ (يشبه الصندوق في استطالته)",
 "boxthorn": "عوسج, لساس",
 "boxwood": "بقس, شمشاد (شجيرات أو أشجار صغيرة دائمة الخضرة) / خشب البقس (خشب أصفر فاتح دقيق الحبيبات صلب جداً وقوي لشجرة البقس؛ يستخدم في الأعمال الخشبية الدقيقة: الآلات الموسيقية والتطعيم وكتل الحفر)",
 "boxy": "شَبِيهٌ بِالصُّنْدُوقِ, صُنْدُوقِيّ (يشبه الصندوق في استطالته)",
 "boy": "فَتًى, غُلَام (شَابٌّ أوَّلَ شبابه بين المراهقة والرُّجولة؛ عبد، خادم) / صَبِيّ, فَتًى / ياه\nمثال: ترى الفتاة الفتى.",
 "boy friday": "فتى مساعد, مساعد (مساعد ذكر لديه مجموعة من الواجبات)",
 "boy scout": "كشاف (صبي عضو في الكشافة) / شاب ساذج, مستقيم جداً (رجل يُعتبر ساذجاً)",
 "boy scouts": "الكشافة, فتيان الكشافة (حركة دولية (لكنها لامركزية) بدأت في عام 1908 في إنجلترا بهدف تعليم المواطنة الصالحة للفتيان)",
 "boy scouts of america": "كشافة أمريكا (مؤسسة تعمل من خلال مجلس وطني يرخص المجالس المحلية في جميع أنحاء الولايات المتحدة؛ الغرض هو بناء الشخصية والتدريب على المواطنة)",
 "boy wonder": "فتى معجزة (ذكر شاب موهوب للغاية)",
 "boycott": "قَاطَعَ / مُقَاطَعَة",
 "boyfriend": "خَلِيل, رَفِيق / صَدِيق, رَفِيق (هو الصَاحِب والخّل الذي بينك وبينه صَدَاقَة)\nمثال: ليس لديه صديقة.",
 "boyhood": "صبا الفتى, طفولة الفتى (فترة طفولة الصبي)",
 "boyish": "صِبْيَانِيّ, فَتَوِيّ (يليق بالصبيّ أو من صفاته وخصائصه)",
 "boyishly": "بِصِبْيَانِيَّة (مثل الصبي)\nمثال: ابتسم بصبيانية لخطيبته",
 "boyishness": "صبيانية (كونها من خصائص الصبي)",
 "boykinia elata": "بويكينيا الساحل (نبات بأوراق في القاعدة غالباً وعناقيد متفرعة مفتوحة من الزهور البيضاء الصغيرة؛ غرب أمريكا الشمالية)",
 "boykinia occidentalis": "بويكينيا الساحل (نبات بأوراق في القاعدة غالباً وعناقيد متفرعة مفتوحة من الزهور البيضاء الصغيرة؛ غرب أمريكا الشمالية)",
 "boyle's law": "قانون بويل (ضغط الغاز المثالي عند درجة حرارة ثابتة يتناسب عكسياً مع الحجم)",
 "boylike": "بِصِبْيَانِيَّة (مثل الصبي) / صِبْيَانِيّ, فَتَوِيّ (يليق بالصبيّ أو من صفاته وخصائصه)\nمثال: ابتسم بصبيانية لخطيبته",
 "boys-and-girls": "زئبق العشب, ميركوريالس حولي (نبات حولي أورو-أفريقي مستوطن في أمريكا كعشب ضار؛ كان يجفف سابقاً للاستخدام كمسهل أو مدر للبول أو مضاد للزهري)",
 "boysenberry": "توت بويزن (فاكهة كبيرة بنكهة توت العليق الأحمر؛ هجين بين توت العليق وتوت العليق الأحمر) / بويزنبيري (عليق هجين مزروع في كاليفورنيا له فاكهة كبيرة حمراء نبيذية داكنة بنكهة تشبه التوت)",
 "boysenberry bush": "بويزنبيري (عليق هجين مزروع في كاليفورنيا له فاكهة كبيرة حمراء نبيذية داكنة بنكهة تشبه التوت)",
 "boytrose": "عنقودي, عنقودي الشكل (يشبه عنقود العنب في الشكل)",
 "boza": "بُوظَة, بُوظَا",
 "bozo": "رجل, شاب (مصطلح غير رسمي لشاب أو رجل) / أحمق, غبي (رجل غبي وغير كفء)\nمثال: شاب لطيف",
 "bph": "تضخم البروستاتا الحميد (تضخم البروستاتا؛ يبدو أنه جزء من عملية الشيخوخة الطبيعية)",
 "bpi": "بت في البوصة (مقياس لمدى كثافة المعلومات المخزنة على وسيط تخزين)",
 "bpm": "نَبْضَة فِي الدَّقِيقَة (إيقاع الموسيقى مقاساً بعدد الضربات التي تحدث في 60 ثانية)",
 "bps": "بِت فِي الثَّانِيَة ((علم الحاسوب) المعدل الذي يتم به نقل البيانات (كما هو الحال عن طريق المودم))",
 "br": "بروم (عنصر سائل لافلزي ثقيل متطاير ذو لون بني داكن ينتمي للهالوجينات؛ يوجد في مياه البحر)",
 "bra": "حَمَّالَة صَدْر, مِشَدّ صَدْر",
 "brabancon griffon": "غريفون برابانكون (نوع من غريفون بروكسل له معطف أملس قصير)",
 "brabant island": "جزيرة برابانت",
 "brace": "تقوية, دعامة (عضو إنشائي يستخدم لتقوية إطار العمل) / مثقاب يدوي, مِلفاف (أداة نجار لها مقبض تدوير ومقبس لتثبيت ريشة الثقب) / تقويم أسنان (جهاز يصحح عدم انتظام الأسنان) / دعامة (دعامة تثبت أو تقوي شيئاً آخر)\nمثال: كان يرتدي دعامة على ركبته",
 "brace and bit": "مثقاب يدوي (مثقاب يتكون من ريشة ومقبض لتثبيتها وتدويرها)",
 "brace wrench": "مفتاح ربط مرفقي (مفتاح ربط على شكل مرفق (له مقبض على شكل كرنك) ورأس لقمة)",
 "braced": "مُتَأَهِّب, مُسْتَعِدّ (في وضعية استعداد لمواجهة خطر أو تحدٍّ) / مُدَعَّم, مُعَزَّز بِدِعَامَات (محمول بواسطة دعامات أو ركائز)",
 "bracelet": "سِوَار",
 "bracelet wood": "خشب السوار (شجيرة أو شجرة صغيرة من جزر الهند الغربية ذات بذور لامعة صلبة منقوشة بالأصفر والبني تستخدم لصنع الأساور)",
 "bracer": "مشروب مقوي, منشط (مقوي أو منشط (خاصة مشروب كحولي)) / حامي الساعد, واقي الذراع (غطاء واقٍ للمعصم أو الذراع يستخدم في الرماية والمبارزة ورياضات أخرى)",
 "bracero": "براسيرو (عامل مكسيكي عمل في الولايات المتحدة في المزارع والسكك الحديدية لتخفيف نقص العمالة خلال الحرب العالمية الثانية)",
 "braces": "مُقَوَّم أَسْنَان",
 "brachial": "عَضُدِيّ",
 "brachial artery": "شريان عضدي (الشريان الرئيسي للذراع العلوي؛ استمرار للشريان الإبطي؛ يتفرع إلى الشرايين الكعبرية والزندية عند المرفق)",
 "brachial plexus": "ضَفِيرَة عَضُدِيَّة",
 "brachial vein": "وريد عضدي (وريدان في كل ذراع يرافقان الشريان العضدي ويصبان في الوريد الإبطي)",
 "brachiate": "مُتَفَرِّع الأَذْرُع (ذو أذرع أو زوائد شبيهة بالأذرع) / عَرِيضُ التَّفَرُّع (لَهُ فُرُوعٌ مُزْدَوَجَةٌ مُنْتَشِرَةٌ عَلَى نِطَاقٍ وَاسِع)",
 "brachiation": "تأرجح بالذراعين (التأرجح بالذراعين من غصن إلى غصن (عند القرود))",
 "brachiocephalic vein": "وريد عضدي رأسي, وريد لا اسم له (أوردة تتكون من اتحاد الوريد الوداجي الباطن والوريد تحت الترقوة)",
 "brachiopod": "عضدي الأرجل (حيوان بحري ذو صدفة ذات مصراعين وله زوج من الأذرع تحمل مجسات لالتقاط الطعام) / عضدي الأرجل (من أو ينتمي إلى شعبة عضديات الأرجل)",
 "brachiopodous": "عضدي الأرجل (من أو ينتمي إلى شعبة عضديات الأرجل)",
 "brachioradialis": "الْعَضَلَة الْعَضُدِيَّة الْكُعْبُرُيَّة",
 "brachistochrone": "براكيستوكرون, منحنى أسرع نزول (منحنى بين نقطتين يمكن لجسم أن يتحرك عليه تحت تأثير الجاذبية في أقصر وقت مقارنة بأي منحنى آخر)",
 "brachium": "عضد ((أحياء) جزء متفرع أو يشبه الذراع في حيوان)",
 "brachycephalic": "عَرِيض الرَّأْس (له رأس قصير وعريض بمؤشر رأسي يزيد عن 80) / عريض الرأس (شخص بالغ ذو رأس عريض وقصير)",
 "brachycephalism": "قصر الرأس (صفة قصر الجمجمة أو الرأس (عرض الرأس كبير بالنسبة لطوله))",
 "brachycephaly": "قصر الرأس (صفة قصر الجمجمة أو الرأس (عرض الرأس كبير بالنسبة لطوله))",
 "brachychiton acerifolius": "شجرة اللهب (شجرة جنوب أسترالية لها عناقيد من الزهور القرمزية المتألقة)",
 "brachychiton australis": "شجرة الزجاجة عريضة الأوراق, شجرة اللهب (شجرة شمال أسترالية لها زهور بيضاء وأوراق عريضة)",
 "brachychiton populneus": "كراجونغ (شجرة واسعة الانتشار في شرق أستراليا تنتج أليافاً متينة قوية وخشباً ناعماً خفيفاً جذاباً؛ أوراقها طعام طوارئ مهم للماشية)",
 "brachychiton rupestris": "شجرة الزجاجة الكوينزلاندية (شجرة كبيرة من كوينزلاند لها زهور كريمية اللون ملطخة بالأحمر من الداخل)",
 "brachycome iberidifolia": "أقحوان نهر سوان (نبات حولي من غرب أستراليا يُزرع كثيراً لرؤوس أزهاره ذات الأشعة البيضاء أو المائلة للزرقة إلى البنفسجية أو المتنوعة)",
 "brachycranial": "عَرِيض الرَّأْس (له رأس قصير وعريض بمؤشر رأسي يزيد عن 80)",
 "brachycranic": "عَرِيض الرَّأْس (له رأس قصير وعريض بمؤشر رأسي يزيد عن 80)",
 "brachydactylia": "قصر الأصابع (قصر غير طبيعي في أصابع اليدين والقدمين)",
 "brachydactylic": "قَصِير الأَصَابِع (ذو أصابع يد أو قدم قصيرة بشكل غير طبيعي)",
 "brachydactylous": "قَصِير الأَصَابِع (ذو أصابع يد أو قدم قصيرة بشكل غير طبيعي)",
 "brachydactyly": "قصر الأصابع (قصر غير طبيعي في أصابع اليدين والقدمين)",
 "brachypterous": "قَصِير الأَجْنِحَة ((عن بعض الحشرات خاصّة) ذو أجنحة قصيرة جدًّا أو أثريّة)",
 "brachystegia speciformis": "مساسا (شجرة أفريقية شجيرية صغيرة ذات أوراق مركبة وعناقيد من الزهور الخضراء العطرة الصغيرة)",
 "brachyuran": "قصيرات الذيل (السرطانات النموذجية)",
 "brachyurous": "قصير الذيل (من أو ينتمي إلى رتيبة قصيرات الذيل (السرطانات))",
 "bracing": "مُنَبِّه, مُنْعِش (يبثّ الحيوية والطاقة) / تقوية, دعامة (عضو إنشائي يستخدم لتقوية إطار العمل)",
 "bracken": "براكن, سرخس النسر (سرخس خشن كبير غالباً بارتفاع عدة أقدام؛ سراخس ضارة أساساً؛ عالمي الانتشار) / براكن (سرخس من جنوب شرق آسيا؛ غير مقاوم للبرد في المناطق المعتدلة الباردة)",
 "bracket": "شَرِيحَة",
 "bracket creep": "زحف الشريحة الضريبية (الانتقال إلى شريحة ضريبية أعلى مع زيادة الدخل الخاضع للضريبة)",
 "bracket fungus": "فطر الرف, فطر قوسي (فطر خشبي يشكل حوامل بوغية تشبه الرف على جذوع الأشجار والهياكل الخشبية)",
 "bracketed blenny": "بليني, جوني (أسماك صغيرة تشبه الثعبان شائعة في المياه الضحلة لشمال المحيط الأطلسي)",
 "brackish": "آسِن, زُعَاق / آسِن",
 "brackishness": "أجاج, ملوحة (جودة كون الشيء مالحاً، كملوحة الماء)",
 "bract": "قِنَّابَة (ورقة متحورة أو جزء يشبه الورقة يقع أسفل النورة الزهرية ويحميها)",
 "bracteal": "قنابي (متعلق بـ أو يشبه أو يعمل كقنابة)",
 "bracteate": "قنابي, مقنب (لديه قنابات)",
 "bracted": "قنابي, مقنب (لديه قنابات)",
 "bracteolate": "قنيبي (لديه قنيبات (قنابات صغيرة))",
 "bracteole": "قُنَيْبَة (قنابة صغيرة)",
 "bractlet": "قُنَيْبَة (قنابة صغيرة)",
 "brad": "مسمار صغير (مسمار صغير)",
 "bradawl": "مخراز, مخراز المسامير (مخراز لعمل ثقوب صغيرة للمسامير الصغيرة أو البراغي الصغيرة)",
