 "beggar": "سَائِل / فَقِير",
 "beggar lice": "ديسموديوم, عشبة القراد (أي من نباتات استوائية وشبه استوائية مختلفة لها أوراق ثلاثية وأقسام قرن خشنة لزجة) / قمل المتسول (نباتات أوراسية وأمريكية شمالية لها جويزات شائكة صغيرة تلتصق بالملابس)",
 "beggar's lice": "ديسموديوم, عشبة القراد (أي من نباتات استوائية وشبه استوائية مختلفة لها أوراق ثلاثية وأقسام قرن خشنة لزجة) / قمل المتسول (نباتات أوراسية وأمريكية شمالية لها جويزات شائكة صغيرة تلتصق بالملابس)",
 "beggar's-ticks": "حسك السيدة, قواض (أي من عدة نباتات من جنس بايدنس لها زهور صفراء وثمار شائكة تلتصق بالفراء والملابس)",
 "beggar-my-neighbor": "بيغر ماي نيبر (لعبة ورق للاعبين اثنين الهدف منها هو كسب جميع أوراق اللاعب الآخر)",
 "beggar-my-neighbor policy": "سياسة إفقار الجار (سياسة تعزيز الذات على حساب الآخرين؛ تستخدم خاصة في السياسة الوطنية)\nمثال: اتبعت الولايات المتحدة سياسة إفقار الجار",
 "beggar-my-neighbor strategy": "سياسة إفقار الجار (سياسة تعزيز الذات على حساب الآخرين؛ تستخدم خاصة في السياسة الوطنية)\nمثال: اتبعت الولايات المتحدة سياسة إفقار الجار",
 "beggar-my-neighbour": "بيغر ماي نيبر (لعبة ورق للاعبين اثنين الهدف منها هو كسب جميع أوراق اللاعب الآخر)",
 "beggar-my-neighbour policy": "سياسة إفقار الجار (سياسة تعزيز الذات على حساب الآخرين؛ تستخدم خاصة في السياسة الوطنية)\nمثال: اتبعت الولايات المتحدة سياسة إفقار الجار",
 "beggar-my-neighbour strategy": "سياسة إفقار الجار (سياسة تعزيز الذات على حساب الآخرين؛ تستخدم خاصة في السياسة الوطنية)\nمثال: اتبعت الولايات المتحدة سياسة إفقار الجار",
 "beggar-ticks": "حسك السيدة, قواض (أي من عدة نباتات من جنس بايدنس لها زهور صفراء وثمار شائكة تلتصق بالفراء والملابس) / بُذُور الحَسَك (بذور نبات الحسك)",
 "beggarly": "بَائِس, زَهِيد ((عن المبالغ المالية) ضئيل لدرجة تستحق الازدراء) / بَائِس, حَقِير (يتّسم بفقر يليق بالمتسوّلين)",
 "beggarman": "متسول (رجل يتسول)",
 "beggarweed": "عشبة المتسول (نبات علفي من جزر الهند الغربية يزرع في جنوب الولايات المتحدة كعلف ولتحسين التربة)",
 "beggarwoman": "متسولة (امرأة تتسول)",
 "beggary": "تسول, شحاذة (طلب المال أو الطعام (خاصة في الشارع من قبل شخص يبدو معدمًا)) / استجداء, تسوّل (حالة كون الشخص متسولاً أو شحاذاً)\nمثال: تحول حالهم إلى التسول",
 "begging": "تَسَوُّل",
 "begging the question": "مُصَادَرَة عَلَى الْمَطْلُوب (دُفْعَة مالية منتزَعة عن طريق الحكومة في أوقات الحرب؛ عِقاب موضوعه اِسْتِصْفَاء مال المحكوم عليه واِسْتِيلَاء الدّولة عليه)",
 "begin": "بَدَأَ, اِبْتَدَأَ (حَدَثَ ونَشَأَ وحَصَلَ؛ أَخَذَ، شَرَعَ)\nمثال: بدأ سامي يتكلم.",
 "beginner": "مُبْتَدِئ, مُبْتَدِئَة (من يبتدئ في تعلّم علم أو فنّ، شخص قليل الخبرة)\nمثال: إنك محترف وأنا مبتدئ.",
 "beginner's luck": "حَظّ المُبْتَدِئ ((حَظَّ) حظا: حسن حظه فهو محظوظ وحظيظ)\nمثال: لقد حالفني الحظ.",
 "beginning": "بِدَايَة (في بِدَايَة الأمْرِ كانَ مُهَذَّباً : فِي أوّلِهِ؛ البِدَايَة والنِّهاية: المبتدأ والمنتهى)\nمثال: هذه بداية جيدة.",
 "beginning rhyme": "جناس استهلالي, قافية أولية (استخدام نفس الحرف الساكن في بداية كل مقطع مشدد في بيت الشعر)",
 "begonia": "بِغُونِيَّة",
 "begonia cheimantha": "بيغونيا الميلاد (بيغونيا هجينة تزهر في الشتاء تزرع لزهورها الوردية الكبيرة الكثيرة)",
 "begonia cocchinea": "بيغونيا جناح الملاك (بيغونيا ليفية الجذور من أمريكا الجنوبية لها فصوص أوراق قاعدية بارزة توحي بأجنحة الملائكة وعناقيد من الزهور الحمراء المرجانية)",
 "begonia dregei": "بيغونيا ورق العنب (بيغونيا درنية أو شبه درنية من جنوب أفريقيا لها أوراق بيضاوية مفصصة بشكل ضحل وزهور بيضاء صغيرة)",
 "begonia erythrophylla": "بيغونيا الكلى, بيغونيا شريحة اللحم (بيغونيا جذمورية ذات أوراق لحمية مستديرة ملونة بالأحمر من الأسفل)",
 "begonia feastii": "بيغونيا الكلى, بيغونيا شريحة اللحم (بيغونيا جذمورية ذات أوراق لحمية مستديرة ملونة بالأحمر من الأسفل)",
 "begonia heracleifolia": "بيغونيا النجمة (بيغونيا جذمورية لها أوراق ذات فصوص مدببة توحي بالنجوم وزهور وردية)",
 "begonia rex": "بيغونيا الملك, بيغونيا ريكس (أي من العديد من البيغونيا الهجينة الجذمورية عادةً المشتقة من نبات من جزر الهند الشرقية، لها أوراق خشنة الملمس منقوشة بالفضة والبرونز والأرجواني…)",
 "begonia semperflorens": "بيغونيا شمعية (بيغونيا هجينة ليفية الجذور لها أوراق عريضة بيضاوية خضراء إلى برونزية حمراء وعناقيد صغيرة من الزهور البيضاء أو الوردية أو الحمراء؛ تستخدم على نطاق…)",
 "begonia socotrana": "بيغونيا سقطرى (بيغونيا شبه درنية لها أوراق درعية وزهور وردية؛ موطنها اليمن)",
 "begonia tuberhybrida": "بيغونيا درنية هجينة (أي من العديد من البيغونيا الهجينة التي لها جذور درنية وزهور ملونة بألوان مختلفة)",
 "begotten": "مَوْلُود, مُنْجَب (ناتِج عَن الوِلادَة الطَّبيعِيَّة)",
 "begrimed": "مُتَرَبِّب, وَسِخ جِدًّا (مُغطّى بطبقة سميكة من الأوساخ أو السُّخام المتراكم)",
 "beguiled": "مَأْسُور, مُنْبَهِر (مملوء بالدهشة والسرور)",
 "beguilement": "إلهاء, تسرية (ترفيه يثير اهتماماً ساراً ويصرف انتباهك عن الهموم والمضايقات) / سحر, فتنة (سحر شخصي مغناطيسي)",
 "beguiler": "جَذَّاب, سَاحِر (شخص يسحر الآخرين (عادة بجاذبيته الشخصية)) / غشاش, محتال (شخص يجعلك تعتقد شيئاً غير حقيقي)",
 "beguiling": "فَاتِن مُضَلِّل, مُغْرٍ بِالخِدَاع (يُضلِّل بوسائل ممتعة أو مُغرية) / سَاحِر, فَتَّان (شديد الجاذبية وقادر على إثارة الأمل أو الرغبة)",
 "beguine": "بيغين (رقصة صالونات نشأت في جزر الهند الغربية الفرنسية؛ تشبه الرومبا) / بيغين (موسيقى مكتوبة بإيقاع بوليرو لرقصة البيغين) / بيغين ((الكنيسة الكاثوليكية الرومانية) عضوة في أخوية علمانية (واحدة من عدة تأسست في هولندا في القرنين الثاني عشر والثالث عشر)؛ على الرغم من عدم أخذ نذور…)",
 "begum": "بيكُم",
 "behalf": "باسم, نيابة (كوكيل عن أو من جانب شخص ما) / أَجْل, مَصْلَحَة (لمصلحة شخص ما)\nمثال: وقع الوصي العقد نيابة عن الطفل القاصر",
 "behave": "تَصَرَّفَ / تَصَرَّفَ بِشَكْل, مُؤَدَّب",
 "behavior": "سُلُوك, تَصَرُّف",
 "behavior modification": "تعديل السلوك, علاج سلوكي (علاج نفسي يسعى لإطفاء أو تثبيط السلوك غير الطبيعي أو غير المتكيف من خلال تعزيز السلوك المرغوب وإطفاء السلوك غير المرغوب فيه)",
