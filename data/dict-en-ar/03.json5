 "berm": "كتف الطريق (حافة ضيقة من الأرض (غير معبدة عادة) على طول جانب الطريق) / حافة, مسطح ترابي (حافة ضيقة أو رف عادة في أعلى أو أسفل منحدر)\nمثال: توقفت السيارة على كتف الطريق",
 "bermuda": "جُزُر بَرْمُودَا (جَزَرَ الماءُ عن الأَرضِ يَجْزُرُ جَزْراً: نَضَبَ وحَسَرَ؛ ويقال: جَزَرَ البَحْرُ والنَّهْرُ: انْحسرَ ماؤُهُ)\nمثال: ضع الجزر في القدر.",
 "bermuda buttercup": "أقصليس ماعزي, حميض برمودا (حميض خشب بصلي من جنوب إفريقيا بزهور صفراء بارزة)",
 "bermuda cedar": "عرعر برمودا (عرعر هرمي كثيف للزينة في برمودا؛ كبير إلى حد ما بالنسبة لعرعر)",
 "bermuda chub": "شوب برمودا (سمكة غذائية ورياضية حول برمودا وفلوريدا؛ تتبع السفن غالباً)",
 "bermuda dollar": "دولار برمودي (وحدة المال الأساسية في برمودا)",
 "bermuda grass": "ثَيِّل, ثِيل",
 "bermuda lily": "زنبق الفصح, زنبق برمودا (زنبق طويل له زهور بيضاء كبيرة بوقية الشكل تتفتح في الربيع)",
 "bermuda maidenhair": "كزبرة البئر البرمودية (سرخس برمودي متوطن رقيق بجذمور زاحف)",
 "bermuda maidenhair fern": "كزبرة البئر البرمودية (سرخس برمودي متوطن رقيق بجذمور زاحف)",
 "bermuda onion": "بصل برمودا (بصل مسطح خفيف الطعم يزرع في المناطق الدافئة)",
 "bermuda plan": "خطة برمودا (خطة فندقية توفر إفطاراً كاملاً يومياً)",
 "bermuda rig": "الشِّرَاع البَرْمُودِيّ (تجهيز أشرعة مثلثة لليخت)",
 "bermuda shorts": "برمودا",
 "bermudan": "برمودي (من أو متعلق أو مميز لبرمودا أو سكانها) / برمودي (مواطن أو ساكن في برمودا)\nمثال: شواطئ برمودية",
 "bermudan option": "خيار برمودي (خيار حيث يحق للمشتري التنفيذ في عدد محدد (متباعد بشكل منفصل دائماً) من المرات)\nمثال: الخيار البرمودي هو أمريكي إلى حد ما وأوروبي إلى حد ما",
 "bermudan rig": "الشِّرَاع البَرْمُودِيّ (تجهيز أشرعة مثلثة لليخت)",
 "bermudian": "برمودي (مواطن أو ساكن في برمودا)",
 "bermudian rig": "الشِّرَاع البَرْمُودِيّ (تجهيز أشرعة مثلثة لليخت)",
 "bern": "بِرْن, بِيرْن",
 "bernese mountain dog": "كلب جبل بيرن (كلب سويسري كبير قوي طويل الشعر أسود الفراء مع علامات سمراء داكنة أو حمراء على الأرجل وعلامة بيضاء على الوجه والصدر والقدمين؛ كان يستخدم سابقاً للجر)",
 "bernoulli distribution": "توزيع برنولي, توزيع ثنائي الحدين (توزيع نظري لعدد النجاحات في مجموعة محدودة من المحاولات المستقلة باحتمال نجاح ثابت)",
 "bernoulli's law": "قانون الأعداد الكبيرة ((إحصاء) قانون ينص على أن عددًا كبيرًا من العناصر المأخوذة عشوائيًا من مجتمع إحصائي سيكون له (في المتوسط) إحصائيات المجتمع)",
 "beroe": "بيروي (مشطيات قمعية الشكل ذات تقزح لوني دقيق)",
 "berretta": "بيريتا (قبعة صلبة بحواف بارزة عبر التاج؛ يرتديها رجال الدين الكاثوليك)",
 "berried": "تُوتِيّ, مُثْمِر بِالتُّوت (يُنْتِجُ أَوْ يَحْمِلُ تُوتًا)",
 "berry": "تُوت, حَبَّة",
 "berry fern": "سرخس المثانة البصيلي, سرخس بصيلي (سرخس أمريكي شمالي يحمل غالباً بصيلات على الوريقات)",
 "berrylike": "توتي, عنبي الشكل (يشبه التوت (أو العنب))",
 "berserk": "مُسْتَشِيط, هَائِج (في حالة هياج عنيف وخارج عن السيطرة) / بيرسيركر, هائج (أحد المحاربين النورديين القدماء الأسطوريين المعروفين بدخولهم في حالة من الهيجان قبل المعركة والقتال بوحشية متهورة وغضب مجنون)",
 "berserker": "بيرسيركر, هائج (أحد المحاربين النورديين القدماء الأسطوريين المعروفين بدخولهم في حالة من الهيجان قبل المعركة والقتال بوحشية متهورة وغضب مجنون)",
 "berteroa incana": "أليسون أشيب, بيرتروا (نبات حولي أوروبي طويل ذو أوراق خضراء رمادية زغبية ورؤوس كثيفة من الزهور البيضاء الصغيرة تليها قرون مشعرة؛ مستوطن في أمريكا الشمالية؛ أحياناً يكون…)",
 "berth": "مركز, منصب (وظيفة أو دور في منظمة ما) / سرير سفينة, سرير قطار (سرير على متن سفينة أو قطار؛ عادة ما يكون في طبقات) / مربط, مرسى (مكان يمكن فيه تثبيت القارب أو السفينة)\nمثال: شغل منصباً في وزارة الخزانة",
 "bertholletia excelsa": "جوز برازيلي, شجرة الجوز البرازيلي (شجرة طويلة من أمريكا الجنوبية تحمل الجوز البرازيلي)",
 "bertillon system": "نظام بيرتيون (نظام أو إجراء لتحديد هوية الأشخاص)",
 "beryl": "بيريل (المصدر الرئيسي للبريليوم؛ تُثَمّن أصنافه الشفافة الملونة كأحجار كريمة)",
 "beryllium": "بِرِيلِيُوم",
 "beryllium bronze": "برونز بيريليوم (سبيكة أساسها النحاس تحتوي على البيريليوم)",
 "bes": "بس (نشر الشيء وفرَّقه؛ أشاع خبرًا أو معلومة)\nمثال: لبس سروالا نظيفا.",
 "beseech": "تَوَسَّلَ (إتخذ وسيلة. أي طريقة أو اسلوب؛ رَجَا بشدة وذل) / اِلْتَمَسَ\nمثال: توقف زيري عن التوسل.",
 "beseeching": "ضارع, متوسل (يقوم بالتوسل أو الاستجداء)",
 "beseechingly": "بِإِلْحَاح, بِتَوَسُّل (بطريقة متوسلة)\nمثال: 'يجب أن تساعدني'، قالت بتوسل",
 "beseechingness": "تضرع, توسل (حالة أو صفة الشخص الذي يتوسل أو يتضرع)",
 "beseem": "اِنْبَغَى, لَاقَ (صَلَح الشيءُ للشخص أو الشيء)",
 "beset": "اِكْتَنَفَ",
 "besides": "إِلَّا, بِٱسْتِثْنَاء (حرف استثناء؛ في : للسؤال المنفي، مرادف لبَلَى في الفصحى) / عِلَاوَة عَلَى ذٰلِكَ\nمثال: لا أعرف إلا هذا.",
 "besiege": "حَاصَرَ",
 "besieged": "مُحَاصَر (محاط بقوات معادية)",
 "besieger": "مُحاصِر (عدو يفرض حصاراً على موقعك) / ملح في الطلب (ملتمس نشط ولحوح)",
 "besieging": "حصار (عمل قوة مسلحة تحيط بمكان محصن وتعزله مع الاستمرار في الهجوم)",
 "besom": "مِقَشَّة",
 "besotted": "ثَمِل تَمَامًا, سَكْرَان طَافِح (فِي حَالَة سُكْرٍ شَدِيد)",
 "bespectacled": "ذُو نَظَّارَات, مُرْتَدٍ لِلنَّظَّارَات (يرتدي نظارات أو وجهه مزين بها)",
 "bespoke": "مُفَصَّلٌ حَسَبَ الطَّلَبِ ((عن الملابس) مصنوع حسب المقاس والطلب)",
 "bespoken": "مَخْطُوب, مُرْتَبِط عَاطِفِيًّا (تعهّد بالزواج؛ على وعد بالارتباط) / مُفَصَّلٌ حَسَبَ الطَّلَبِ ((عن الملابس) مصنوع حسب المقاس والطلب)",
 "besprent": "مَرْشُوش, مُرَشَّش (مرشوش ومنثور عليه)",
 "bessarabia": "بِيسَارَابِيَا",
 "bessemer converter": "محول بسمر (فرن مبطن بمواد حرارية يستخدم لتحويل الحديد الخام إلى صلب بواسطة عملية بسمر)",
 "bessemer process": "عملية بسمر (عملية صناعية لصنع الفولاذ باستخدام محول بسمر لضخ الهواء عبر الحديد المنصهر وبالتالي حرق الكربون الزائد والشوائب؛ وهي أول طريقة ناجحة لصنع الفولاذ…)",
 "bessera elegans": "بيسيرا, قطرات المرجان (عشب مكسيكي نصف قوي يزرع لمظلاته الطرفية المتدلية من الزهور الحمراء والبيضاء المبهرجة)",
 "besseya alpina": "بيسيا ألبية (نبات شاحب صغير ذو سنابل كثيفة من الزهور البنفسجية المزرقة الشاحبة؛ من المروج الباردة العالية من وايومنغ ويوتا إلى نيو مكسيكو)",
 "bessy cerca": "سمكة الزناد الملكة (سمكة أطلسية استوائية)",
 "best": "أَفْضَل",
 "best evidence rule": "قَاعِدَة أَفْضَل دَلِيل (قاعدة إثبات تتطلب تقديم الأصل لإثبات محتوى كتابة أو تسجيل أو صورة)",
 "best friend": "أَفْضَل صَدِيق, فُضْلَى صَدِيقَة",
 "best friend forever": "أَفَاضِل أَصْدِقَاء لِلْأَبَد, فُضْلَيَات صَدِيْقَات لِلْأَبَد",
 "best man": "إشبين العريس (الإشبين الرئيسي في حفل الزفاف)",
 "best of all": "والأفضل من ذلك كله (لحسن الحظ بشكل خاص)\nمثال: والأفضل من ذلك كله، ليس لدينا واجبات منزلية!",
 "best regards": "مَعَ أَطْيَب التَحْيَات (يفيد الاجتماع والمصاحبة؛ مكان الاجتماع)\nمثال: جئت مع أصدقائي.",
 "best seller": "الأكثر مبيعاً, بست سيلر (كتاب حقق مبيعات كبيرة وسريعة)",
 "best wishes": "أَطْيَب التَّمَنِّيَات (تعبير عن الأمل في سعادة أو رفاهية شخص ما في المستقبل)\nمثال: أرسلنا أطيب تمنياتنا بالشفاء العاجل",
 "best-known": "الأَكْثَر شُهْرَةً (الأشهر أو الأبرز على الإطلاق)",
 "best-loved": "مُحَبَّذ, مُفَضَّل (يُفضَّل على جميع الآخرين ويُعامَل بمحاباة)",
 "bestial": "بَهِيمِيّ, حَيَوَانِيّ (يُشبه الوحش؛ يُظهر انعدام الحِسّ الإنساني)",
 "bestiality": "بَهِيمِيّة",
 "bestially": "بِبَهَائِمِيَّة, بِوَحْشِيَّة (على طريقة الوحش)\nمثال: عاملت زوجها بوحشية",
 "bestiary": "حيوانات رامزة",
 "bestow": "أَنْعَمَ",
 "bestowal": "إسباغ, تقليد (فعل منح شرف أو تقديم هدية) / إنعام, منح (هدية تمنح أو تُسبغ)",
 "bestower": "مانح, متبرع (شخص يقدم هدية أو هبة من ممتلكاته)",
 "bestowment": "إسباغ, تقليد (فعل منح شرف أو تقديم هدية) / إنعام, منح (هدية تمنح أو تُسبغ)",
 "bestseller": "أَكْثَر رَوَاجًا, أَكْثَر مَبِيعًا",
 "bestubbled": "خَشِن اللِّحْيَة, ذُو شَعْر قَصِير (له نموّ قصير من شعر اللحية)",
 "bet": "رِهَان, مُرَاهَنَة",
 "beta": "بِيتَا",
 "beta blocker": "حاصر بيتا, مناهض بيتا الأدرينالي (أي من الأدوية المختلفة المستخدمة في علاج ارتفاع ضغط الدم أو عدم انتظام ضربات القلب؛ تقلل من قوة ومعدل انقباضات القلب عن طريق حجب مستقبلات بيتا…)",
 "beta blocker eyedrop": "قطرة حاصرات بيتا (علاج للجلوكوما؛ تقلل القطرات ضغط العين عن طريق تقليل إنتاج الخلط المائي)",
 "beta cell": "خلية بيتا (خلية تنتج الأنسولين في جزر لانجرهانس في البنكرياس)",
 "beta decay": "اضمحلال بيتا (اضمحلال إشعاعي لنواة ذرية مصحوب بانبعاث جسيم بيتا)",
 "beta endorphin": "بيتا إندورفين (إندورفين تنتجه الغدة النخامية يثبط الألم)",
 "beta globulin": "ترانسفيرين (غلوبولين في بلازما الدم يحمل الحديد)",
 "beta iron": "حديد بيتا (تآصل للحديد يشبه حديد ألفا إلا أنه غير مغناطيسي)",
 "beta particle": "جُسَيْم بِيتَا (إلكترون أو بوزيترون عالي السرعة ينبعث في تحلل نظير مشع)",
 "beta radiation": "أشعة بيتا, إشعاع بيتا (إشعاع جسيمات بيتا أثناء التحلل الإشعاعي)",
 "beta ray": "أشعة بيتا, إشعاع بيتا (إشعاع جسيمات بيتا أثناء التحلل الإشعاعي)",
 "beta receptor": "مستقبل أدرينالي بيتا, مستقبل بيتا (مستقبلات يفترض وجودها على أغشية الخلايا العصبية للجهاز العصبي الودي لتفسير خصوصية بعض العوامل التي تؤثر فقط على بعض الأنشطة الودية (مثل توسع الأوعية…)",
 "beta rhythm": "إيقاع بيتا, موجة بيتا (الموجة الدماغية الطبيعية في مخطط الدماغ لشخص مستيقظ وفي حالة يقظة؛ تحدث بتردد بين 12 و 30 هرتز)",
 "beta software": "برنامج بيتا, نسخة بيتا (برنامج لم يُطلق رسمياً بعد ولكنه اجتاز اختبار ألفا وما زال يحتوي على أخطاء أكثر من الإصدار العادي)\nمثال: عادة ما تتاح برامج بيتا لمستخدمين معينين فقط لاختبارها",
 "beta test": "اختبار بيتا ((علوم الكمبيوتر) اختبار ثانٍ لمنتج تجريبي يجريه طرف خارجي)",
 "beta vulgaris": "بنجر, سلق (نبات أوراسي ثنائي الحول له عادة جذر منتفخ صالح للأكل؛ يزرع على نطاق واسع كمحصول غذائي)",
 "beta vulgaris cicla": "سلق, سلق سويسري (شمندر يفتقر إلى الجذر المتضخم؛ يزرع كخضروات لأوراقه وسيقانه الصالحة للأكل)",
 "beta vulgaris rubra": "بنجر, شمندر أحمر (شمندر له جذر أحمر متضخم بشكل كبير؛ يزرع على نطاق واسع للاستهلاك البشري)",
 "beta vulgaris vulgaris": "بنجر العلف, شمندر العلف (شمندر بجذر مصفر كبير؛ يزرع بشكل رئيسي كعلف للماشية)",
 "beta wave": "إيقاع بيتا, موجة بيتا (الموجة الدماغية الطبيعية في مخطط الدماغ لشخص مستيقظ وفي حالة يقظة؛ تحدث بتردد بين 12 و 30 هرتز)",
 "beta-adrenergic blocker": "حاصر بيتا, مناهض بيتا الأدرينالي (أي من الأدوية المختلفة المستخدمة في علاج ارتفاع ضغط الدم أو عدم انتظام ضربات القلب؛ تقلل من قوة ومعدل انقباضات القلب عن طريق حجب مستقبلات بيتا…)",
 "beta-adrenergic blocking agent": "حاصر بيتا, مناهض بيتا الأدرينالي (أي من الأدوية المختلفة المستخدمة في علاج ارتفاع ضغط الدم أو عدم انتظام ضربات القلب؛ تقلل من قوة ومعدل انقباضات القلب عن طريق حجب مستقبلات بيتا…)",
 "beta-adrenergic receptor": "مستقبل أدرينالي بيتا, مستقبل بيتا (مستقبلات يفترض وجودها على أغشية الخلايا العصبية للجهاز العصبي الودي لتفسير خصوصية بعض العوامل التي تؤثر فقط على بعض الأنشطة الودية (مثل توسع الأوعية…)",
 "beta-adrenoceptor": "مستقبل أدرينالي بيتا, مستقبل بيتا (مستقبلات يفترض وجودها على أغشية الخلايا العصبية للجهاز العصبي الودي لتفسير خصوصية بعض العوامل التي تؤثر فقط على بعض الأنشطة الودية (مثل توسع الأوعية…)",
 "beta-blocking agent": "حاصر بيتا, مناهض بيتا الأدرينالي (أي من الأدوية المختلفة المستخدمة في علاج ارتفاع ضغط الدم أو عدم انتظام ضربات القلب؛ تقلل من قوة ومعدل انقباضات القلب عن طريق حجب مستقبلات بيتا…)",
 "beta-carotene": "بيتا كاروتين (متصاوغ من الكاروتين يوجد في الفواكه والخضروات ذات اللون الأخضر الداكن والأصفر الداكن)",
 "beta-hydroxybutyric acid": "حمض بيتا-هيدروكسي بيوتيريك (مشتق بيتا لحمض الهيدروكسي بيوتيريك يوجد في الدم والبول في بعض حالات ضعف التمثيل الغذائي)",
 "beta-interferon": "بيتا إنترفيرون (شكل من أشكال الإنترفيرون تنتجه الخلايا الليفية وله تأثيرات مضادة للفيروسات؛ يستخدم في علاج التصلب المتعدد)",
 "beta-lactamase": "بنسيليناز (إنزيم تنتجه بعض البكتيريا يعطل البنسلين ويؤدي إلى مقاومة ذلك المضاد الحيوي)",
 "beta-lipoprotein": "بروتين دهني منخفض الكثافة (بروتين دهني ينقل الكوليسترول في الدم؛ يتكون من كمية معتدلة من البروتين وكمية كبيرة من الكوليسترول؛ يُعتقد أن المستويات العالية منه ترتبط بزيادة خطر…)",
 "beta-naphthol": "بيتا-نافثول (متصاوغ للنافثول يستخدم في المطاط كمضاد للأكسدة)",
