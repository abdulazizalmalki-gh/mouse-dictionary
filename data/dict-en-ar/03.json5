 "both": "كِلَا (بمعنى إنته ولا تفعل، ليست بحاجة إلى جملة كاملة؛ تأتي بمعنى لا الجوابية) / كل من ؛ و ؛\nمثال: انا احب كلا منهما",
 "both … and": "كِلَا ؛ وَ, كِلْتَا ؛ وَ (بمعنى إنته ولا تفعل، ليست بحاجة إلى جملة كاملة؛ تأتي بمعنى لا الجوابية)\nمثال: انا احب كلا منهما",
 "bother": "أزْعَجَ / يَزْعَجْ, يُضَايِقْ",
 "botheration": "إزعاج, مصدر إزعاج (شيء أو شخص يسبب المتاعب؛ مصدر للتعاسة) / استياء, انزعاج (الحالة النفسية للشعور بالتهيج أو الانزعاج)\nمثال: إزعاج بسيط",
 "bothered": "مُرْتَبِك, مُنْزَعِج (أُصيب بالارتباك وفقدان الهدوء)",
 "bothersome": "مُزْعِج, مُضَايِق (يسبب الانزعاج أو الضيق)",
 "bothrops atrops": "رأس الرمح (أفعى حفرية كبيرة شديدة السمية من أمريكا الوسطى وأمريكا الجنوبية)",
 "botonee": "ذُو نِهَايَات بُرْعُمِيَّة ((فِي شِعَار النَّبَالَة) ذُو تَجَمُّع مِنْ ثَلَاثَة أَزْرَار فِي نِهَايَة كُلّ ذِرَاع)",
 "botonnee": "ذُو نِهَايَات بُرْعُمِيَّة ((فِي شِعَار النَّبَالَة) ذُو تَجَمُّع مِنْ ثَلَاثَة أَزْرَار فِي نِهَايَة كُلّ ذِرَاع)",
 "botox": "بوتوكس, ذيفان وشيقي أ (سم عصبي يستخدم طبياً بكميات صغيرة لعلاج الاضطرابات العصبية وتجميلياً لتنعيم خطوط التجاعيد)",
 "botrychium lunaria": "بوتريشيوم قمري, عشبة القمر (من أمريكا وأوراسيا وأستراليا)",
 "botrychium matricariifolium": "سرخس العنب ديزي الأوراق (من أمريكا الشمالية وأوراسيا)",
 "botrychium multifidum": "سرخس العنب الجلدي (سرخس أوروبي بسعف جلدي وقليل الشعر)",
 "botrychium virginianum": "بوتريشيوم فرجينيا, سرخس الأفعى المجلجلة (سرخس أمريكي تشبه حوافظه البوغية العنقودية خشخيشة الأفعى)",
 "botryoid": "عنقودي, عنقودي الشكل (يشبه عنقود العنب في الشكل)",
 "botryoidal": "عنقودي, عنقودي الشكل (يشبه عنقود العنب في الشكل)",
 "botswana": "بُتْسْوَانَا, بُوتْسْوَانَا",
