 "beetle-browed": "عَابِس, مُقَطِّب الجَبِين (كَئِيب أَوْ غَيْر وُدِّيّ فِي المَظْهَر)",
 "beetleweed": "غالاكس (عشب معمر دائم الخضرة معنقد له سنابل من الزهور البيضاء الصغيرة وأوراق لامعة خضراء مستديرة إلى قلبية الشكل تتحول إلى اللون النحاسي أو العنابي أو…)",
 "beetling": "مُتَدَلٍّ, نَاتِئ (بارز إلى الأمام أو متدلٍّ من الأعلى)",
 "beetroot": "شَمَنْدَر أَحْمَر, بَنْجَر",
 "beey": "نَحْلِيّ",
 "befitting": "لَائِق, مُنَاسِب (ملائم لموقف أو سياق معيّن)",
 "befittingly": "بشكل لائق, بشكل مناسب (بما يتوافق مع ما هو مناسب أو ملائم للظروف)\nمثال: كان يرتدي ملابس مناسبة",
 "befogged": "ثَمِل, مُتَرَنِّح (مُشوَّش الذهن بسبب المشروبات الكحوليّة)",
 "befooling": "اسْتِغْبَاء, تَسْفِيه (السخرية من شخص أو شيء ما باعتباره أحمق أو سخيفاً أو غير متسق)",
 "before": "قَبْلَ (وضع فمه على الشخص أو الشيء علامة الحب والاحترام. في العاميّة يُقال بَاسَ) / قَبْلَ, أَمَامَ (وضع فمه على الشخص أو الشيء علامة الحب والاحترام. في العاميّة يُقال بَاسَ)\nمثال: كنت هنا من قبل.",
 "before christ": "ق.م, قبل الميلاد (قبل العصر المسيحي؛ تستخدم بعد التواريخ السابقة للسنة المفترضة لميلاد المسيح)\nمثال: في عام 200 قبل الميلاد",
 "before long": "حالاً, خلال وقت قصير (في المستقبل القريب)\nمثال: سيكون الطبيب هنا قريباً",
 "beforehand": "سلفاً, مسبقاً (قبل الوقت؛ تحسباً)\nمثال: عندما تدفع مقدماً تحصل على خصم",
 "befouled": "مُلَوَّث (صار قذراً أو ملوّثاً بالأوساخ)",
 "befoulment": "تلوث, تنجيس (حالة كونه ملوثاً)",
 "befuddled": "مُخْتَلِط, مُشَوَّش الذِّهْن (مرتبك وغامض التفكير؛ يُقال خاصّة عن طريقة التفكير) / ثَمِل, مُتَرَنِّح (مُشوَّش الذهن بسبب المشروبات الكحوليّة) / تَائِه, مَذْهُول (في حيرة شديدة بسبب كثرة التناقضات؛ مرتبك ومشوّش الذهن)",
 "befuddlement": "ارتباك, حيرة (ارتباك ناتج عن الفشل في الفهم)",
 "beg": "اِسْتَجْدَى, تَسَوَّلَ / تَسَوَّلَ, رَجَا / بيك",
