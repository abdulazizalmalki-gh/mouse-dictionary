 "blastocele": "تجويف الأريمة (التجويف المملوء بالسائل داخل الأريمة)",
 "blastocoel": "تجويف الأريمة (التجويف المملوء بالسائل داخل الأريمة)",
 "blastocoele": "تجويف الأريمة (التجويف المملوء بالسائل داخل الأريمة)",
 "blastocoelic": "أرومي تجويفي (من أو متعلق بالتجويف الأرومي)",
 "blastocyst": "كيسة أريمية (أريمة الثدييات المشيمية التي حدث فيها بعض تمايز الخلايا)",
 "blastocyte": "خلية أريمية (خلية جنينية غير متمايزة)",
 "blastocytoma": "ورم أرومي (ورم يتكون من خلايا غير ناضجة غير متمايزة)",
 "blastoderm": "أدمة الأريمة, قرص جرثومي (طبقة من الخلايا في الجزء الداخلي للأريمة)",
 "blastodermatic": "أرومي جلدي (من أو متعلق بالأديم الأرومي)",
 "blastodermic": "أرومي جلدي (من أو متعلق بالأديم الأرومي)",
 "blastodermic vesicle": "كيسة أريمية (أريمة الثدييات المشيمية التي حدث فيها بعض تمايز الخلايا)",
 "blastodisc": "أدمة الأريمة, قرص جرثومي (طبقة من الخلايا في الجزء الداخلي للأريمة)",
 "blastoff": "إطلاق, انطلاق (إطلاق صاروخ أو مركبة فضائية إلى وجهة محددة)",
 "blastogenesis": "نشوء أريمي (نظرية تفيد بأن الخصائص الموروثة تنتقل عن طريق البلازما الجرثومية) / تبرعم (تكاثر لاجنسي عن طريق التبرعم)",
 "blastogenetic": "نشوئي برعمي (من أو متعلق بالنشوء البرعمي (التكاثر بالتبرعم))",
