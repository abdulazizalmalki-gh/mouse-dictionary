 "boltzmann distribution law": "توزيع ماكسويل-بولتزمان ((فيزياء) قانون يعبر عن توزيع الطاقة بين جزيئات الغاز في حالة التوازن الحراري)",
 "boltzmann's constant": "ثَابِت بُولْتَزمَان (ثابت يستخدم في حساب ثابت الغاز المثالي)",
 "bolus": "بلعة (حبة كبيرة؛ تستخدم خاصة في الطب البيطري) / بلعة, مضغة (كتلة مستديرة صغيرة لينة (مثل الطعام الممضوغ))",
 "bolus hook": "خطاف نول (أداة في نول الجاكار ترفع أو تخفض النير، الذي يحمل ويوجه خيط السدى بحيث يقع خيط اللحمة إما فوقه أو تحته، مما يخلق النمط بدوره)",
 "bomarea edulis": "بوماريا, سالسيلا صالحة للأكل (كرمة استوائية لها أزهار وردية وصفراء مرقطة بالأرجواني وجذور صالحة للأكل تُسلق أحياناً كبديل للبطاطس؛ جزر الهند الغربية إلى شمال أمريكا الجنوبية)",
 "bomarea salsilla": "بوماريا, سالسيلا (كرمة استوائية لها خيمات من الزهور الأرجوانية الصغيرة وجذور صالحة للأكل تُسلق أحياناً كبديل للبطاطس؛ كولومبيا)",
 "bomb": "قُنْبُلَة / قَنْبَلَ",
 "bomb blast": "انفجار قنبلة (انفجار قنبلة)",
 "bomb calorimeter": "مسعر القنبلة (وعاء مغلق قوي لقياس حرارة الاحتراق)",
 "bomb rack": "رف القنابل (جهاز على طائرة لحمل القنابل)",
 "bomb shelter": "مخبأ محصن, ملجأ (حجرة (غالباً تحت الأرض) محصنة ضد القصف ومزودة بالطعام ومرافق المعيشة؛ تُستخدم أثناء الغارات الجوية)",
 "bomb site": "موقع قصف (منطقة في بلدة دمرتها القنابل)\nمثال: افتتحوا موقف سيارات في موقع القصف",
 "bombard": "بومباردون (مزمار كبير؛ عضو الباس في عائلة المزمار)",
 "bombardier": "رامي القنابل (عضو طاقم القاذفة المسؤول عن استخدام منظار القصف وإسقاط القنابل على الهدف) / ضابط قصف (ضابط صف في المدفعية البريطانية)",
 "bombardier beetle": "خنفساء قاذفة (خنفساء تطلق بخاراً لاذعاً بصوت مسموع عند إزعاجها)",
 "bombardment": "قَصْف",
 "bombardon": "بومباردون (مزمار كبير؛ عضو الباس في عائلة المزمار) / هيليكون (توبا تلتف فوق كتف الموسيقي)",
 "bombast": "كلام طنان, هراء (كلام أو كتابة متفاخرة أو مدعية)",
 "bombastic": "طَنَّان, مُنْتَفِخ (مُتعالٍ ومُتكلَّف في الأسلوب بشكل استعراضي)",
 "bombastically": "بِتَفَاخُم, بِرَنِين (بطريقة فخمة) / بِانْتِفَاخ, بِتَكَلُّف (بطريقة متكلفة)\nمثال: كان المبنى واسعاً بشكل فخم",
 "bombax ceiba": "سيمال, شجرة قطن الحرير الأحمر (شجرة قطن حرير من شرق الهند تنتج أليافاً أقل جودة من الكابوك)",
 "bombax malabarica": "سيمال, شجرة قطن الحرير الأحمر (شجرة قطن حرير من شرق الهند تنتج أليافاً أقل جودة من الكابوك)",
 "bombay ceiba": "شجرة القطن الحريري, قابوق (شجرة استوائية ضخمة ذات تلال عميقة على جذعها الضخم وتحمل قروناً كبيرة من البذور مغطاة بزغب حريري؛ مصدر لألياف القابوق الحريرية)",
 "bombay hemp": "تيل, كيناف (نبات ليفي قيم من جزر الهند الشرقية واسع الانتشار الآن في الزراعة)",
 "bombazine": "بومبازين (قماش مبرد يستخدم للفساتين؛ السدى من الحرير واللحمة من الصوف الصخري)\nمثال: البومبازين الأسود يستخدم كثيراً لملابس الحداد",
 "bomber": "قَاذِفَة قَنَابِل",
 "bomber aircrew": "طاقم قاذفة (طاقم طائرة قاذفة)",
 "bomber crew": "طاقم قاذفة (طاقم طائرة قاذفة)",
 "bomber jacket": "سترة بومبر, سترة طيارين (سترة مزمومة بشريط عند الخصر)",
 "bombie": "قنبلة صغيرة (قنبلة صغيرة غير منفجرة)\nمثال: القنابل الصغيرة غير المنفجرة المعروفة في لاوس باسم 'بومبيز' جعلت المزارعين يخشون زراعة حقولهم",
 "bombilation": "أزيز, طنين (صوت اهتزاز سريع)\nمثال: أزيز نحلة طنانة",
 "bombina bombina": "علجوم ناري البطن (علجوم من وسط وشرق أوروبا له بقع حمراء أو برتقالية مختلطة بالأسود على جانبه السفلي)",
 "bombination": "أزيز, طنين (صوت اهتزاز سريع)\nمثال: أزيز نحلة طنانة",
 "bombing": "تَفْجِير, قَصْف",
 "bombing run": "طلعة قصف (ذلك الجزء من الطيران الذي يبدأ بالاقتراب من الهدف ويشمل الاستحواذ على الهدف وينتهي بإطلاق القنابل)",
 "bomblet": "قنبلة صغيرة (واحدة من القنابل الصغيرة التي يتم إطلاقها من قنبلة عنقودية)",
 "bombproof": "مُقَاوِمٌ لِلقَنَابِل (قَادِرٌ عَلَى مُقَاوَمَةِ القُوَّةِ الاِنْفِجَارِيَّةِ لِلقَنَابِلِ وَالقَذَائِف) / مخبأ محصن, ملجأ (حجرة (غالباً تحت الأرض) محصنة ضد القصف ومزودة بالطعام ومرافق المعيشة؛ تُستخدم أثناء الغارات الجوية)",
 "bombshell": "قذيفة, قنبلة (قنبلة متفجرة أو قذيفة مدفعية) / صاعقة, قنبلة (مفاجأة صادمة) / فاتنة, قنبلة (مجازاً) (فنانة ترفيهية لها تأثير مثير ومدهش (غالباً ما تطلق على النساء الجذابات))\nمثال: جاءت أنباء الهجوم كالقنبلة",
 "bombsight": "منظار القصف (جهاز تصويب في الطائرة لتوجيه القنابل)",
 "bombycid": "عثة دودة القز (عثة آسيوية متوسطة الحجم تتغذى يرقاتها على أوراق التوت وتنتج الحرير)",
 "bombycid moth": "عثة دودة القز (عثة آسيوية متوسطة الحجم تتغذى يرقاتها على أوراق التوت وتنتج الحرير)",
 "bombycilla cedrorum": "جناح الشمع (واسع الانتشار في المناطق المعتدلة من أمريكا الشمالية)",
 "bombycilla cedrorun": "جناح الشمع (واسع الانتشار في المناطق المعتدلة من أمريكا الشمالية)",
 "bombycilla garrulus": "جناح الشمع البوهيمي (جناح شمع كبير من شمال أمريكا الشمالية؛ يشبه جناح الشمع العادي ولكنه أكبر)",
 "bombyx mori": "عثة دودة القز المستأنسة (عثة آسيوية ممتلئة الجسم بيضاء كريمية توجد بالكامل تقريباً تحت الرعاية البشرية؛ مصدر معظم تجارة الحرير)",
 "bon appétit": "شَهْيَة طَيِّبَة, بِٱلصِّحَّةِ وَٱلْعَافِيَةِ",
 "bon mot": "طُرْفَة, كَلِمَة ذَكِيَّة (ملاحظة ذكية)",
 "bon ton": "الطبقة الراقية, المجتمع الراقي (النخبة العصرية الأنيقة)",
 "bon vivant": "ذواقة, محب للطعام (شخص مكرس للاستمتاع الحسي المترف (خاصة الطعام والشراب الجيد))",
 "bon voyage": "رِحْلَة سَعِيدَة, رِحْلَة مُوَفَّقَة",
 "bona fide": "عن حسن نيَة (يُفِيدُ المُجَاوَزَة؛ يُفِيدُ الاستعلاء، عَلَى)\nمثال: سألتني عن عمري.",
 "bonaire": "بُونِير",
 "bonanza": "رزق ساقه الله, رواج (حدث مفاجئ يجلب الحظ السعيد (مثل فرصة مفاجئة لكسب المال)) / بونانزا, عرق غني (عرق غني بشكل خاص من خام ثمين)\nمثال: خلق الطلب على الاختبار طفرة لتلك المختبرات غير الخاضعة للتنظيم",
 "bonapartism": "بونابرتية",
 "bonasa umbellus": "طيهوج مطوق (يُقدر كطائر صيد في شرق الولايات المتحدة وكندا)",
 "bonavist": "فاصوليا هندية, فول مصري (كرمة معمرة ملتفة من المناطق الاستوائية في العالم القديم لها أوراق ثلاثية وعناقيد من زهور تشبه البازلاء الأرجوانية العطرة تليها قرون عنابية من بذور…)",
 "bonbon": "بونبون (حلوى تحتوي عادة على مركز من الفوندان أو الفاكهة أو المكسرات ومغطاة بالشوكولاتة)",
 "bonce": "رأس, هامة (مصطلحات غير رسمية للرأس البشري)",
 "bond": "رباط, وصلة تثبيت (وصلة تثبت الأشياء ببعضها البعض) / صفد, قيد (قيد يحد أو يقيد الحرية (خاصة شيء يستخدم لربط أو تقييد سجين)) / التصاق, تلاصق (خاصية الالتصاق معاً (كالغراء والخشب) أو انضمام أسطح مختلفة التكوين) / رابطة, رابطة كيميائية (قوة كهربائية تربط الذرات)\nمثال: الالتصاق المتبادل للخلايا",
 "bond certificate": "سند, شهادة سند (شهادة دين (عادة ما تكون بفائدة أو مخصومة) تصدرها حكومة أو شركة لجمع الأموال؛ يُطلب من المصدر دفع مبلغ ثابت سنوياً حتى تاريخ الاستحقاق ثم مبلغ ثابت…)",
 "bond issue": "إصدار سندات (سندات تبيعها شركة أو وكالة حكومية في وقت معين ويمكن تحديدها بتاريخ الاستحقاق)",
 "bond paper": "ورق بوند, ورق سندات (جودة فائقة من ورق الكتابة الأبيض القوي والمتين؛ صنع في الأصل لطباعة المستندات)",
 "bond rating": "تصنيف السندات (تقييم من قبل شركة تصنيف لاحتمالية تخلف إصدار سندات معين عن السداد)",
 "bond servant": "خادم ملزم, عبد (شخص ملزم بالعمل دون أجر)",
 "bond trading": "تداول السندات (التداول في السندات (عادة بواسطة وسيط في قاعة البورصة))",
 "bond-trading activity": "تداول السندات (التداول في السندات (عادة بواسطة وسيط في قاعة البورصة))",
 "bondable": "قَابِل لِلتَّرَابُط (قادر على التماسك معًا كالجُسيمات في كتلة واحدة) / قَابِل لِلرَّبْط (يمكن تثبيته أو ربطه بحبل أو رباط)",
 "bondage": "تقييد جنسي (ممارسة جنسية تتضمن تقييد أحد الشريكين جسديًا (بالحبال أو الأصفاد)) / رق, عبودية (حالة الخضوع لسيطرة شخص آخر) / استرقاق, عبودية (حالة الخضوع لسيطرة قوة أو تأثير أو قوة مجردة)\nمثال: كان في عبودية للخوف",
 "bonded labor": "استعباد بالدين, عمل بالسخرة (ممارسة يقدم فيها أصحاب العمل قروضاً بفوائد عالية للعمال الذين تعمل عائلاتهم بأكملها بأجور منخفضة لسداد الدين؛ هذه الممارسة غير قانونية في الولايات…)",
 "bondholder": "حامل سندات (حامل سندات تصدرها حكومة أو شركة)",
 "bonding": "لحام, لصق (التثبيت بإحكام معاً) / ربط الأسنان, لصق تجميلي ((طب الأسنان) تقنية لإصلاح الأسنان؛ يتم تطبيق مادة صمغية على سطح السن حيث تلتصق بمينا الأسنان) / أُلْفَة, تَرَابُط (علاقة شخصية وثيقة تتشكل بين الناس (كما بين الزوج والزوجة أو الوالد والطفل))",
 "bondmaid": "أمة, جارية (أنثى مستعبدة) / خادمة ملزمة (أنثى ملزمة بالخدمة دون أجر)",
 "bondman": "عبد (خلاف الحُرّ، المَمْلُوْك، من له مالك يملكه. الجمع عبيد وأعبد وعِبدان وعُبدان؛ الإنسان حرا كان أم لا مؤمنا كان أن ملحدا من حيث أنه مملوك لله) / خادم ملزم (ذكر ملزم بالخدمة دون أجر)\nمثال: ماذا أنجز عبد العزيز بوتفليقة؟",
 "bondsman": "كَفِيل",
 "bondsperson": "ضامن, كفيل (شخص يوقع على سند كضمان لشخص آخر)",
 "bondswoman": "أمة, جارية (أنثى مستعبدة) / خادمة ملزمة (أنثى ملزمة بالخدمة دون أجر) / ضامنة, كفيلة (أنثى توقع سنداً كضمان لشخص آخر)",
 "bonduc": "بندق هندي, شجرة البندق الهندي (شجرة استوائية ذات قرون شائكة كبيرة لبذور تشبه الفاصوليا وتستخدم للمجوهرات والمسابح) / بندق هندي, شجرة البن الكنتاكية (شجرة جميلة من وسط وشرق أمريكا الشمالية ذات أوراق كبيرة ثنائية الريش وأزهار خضراء بيضاء تليها قرون بنية خشبية كبيرة تستخدم بذورها كبديل للقهوة)",
 "bonduc nut": "بندق هندي, جوز البندق (بذرة رمادية لامعة صلبة لشجرة البندق الهندي؛ تستخدم لصنع المجوهرات مثلاً)",
 "bonduc tree": "بندق هندي, شجرة البندق الهندي (شجرة استوائية ذات قرون شائكة كبيرة لبذور تشبه الفاصوليا وتستخدم للمجوهرات والمسابح)",
 "bondwoman": "أمة, جارية (أنثى مستعبدة) / خادمة ملزمة (أنثى ملزمة بالخدمة دون أجر)",
 "bone": "عَظْم / عضم / عَظْمَة / عضمة",
 "bone age": "عمر عظمي (عمر الشخص مقاساً بمطابقة نمو عظامه (كما يظهر في الأشعة السينية) مع نمو عظام شخص متوسط من عمر زمني معروف)",
 "bone ash": "رماد العظام (الرماد المتبقي عند حرق العظام؛ غني بفوسفات الكالسيوم؛ يستخدم كسماد وفي صناعة الخزف العظمي)",
 "bone black": "أسود العظام, فحم العظام (مادة سوداء تحتوي على الفحم في شكل عظام متفحمة؛ تستخدم كصبغة سوداء)",
 "bone cell": "خلية عظمية (خلية تشكل جزءاً من العظم)",
 "bone char": "أسود العظام, فحم العظام (مادة سوداء تحتوي على الفحم في شكل عظام متفحمة؛ تستخدم كصبغة سوداء)",
 "bone china": "خزف عظمي (بورسلين فاخر يحتوي على رماد العظام)",
 "bone fat": "دهن العظام (مادة دهنية في العظام تُستخرج بالمذيبات أو بالغليان أو بالبخار؛ تُستخدم بشكل رئيسي في الشموع والصابون الرخيص وشحوم التزييت)",
 "bone folder": "مِطْوًى",
 "bone marrow": "نُخَاع, نُخَاع العَظْم",
 "bone of contention": "مَوْضِع خِلَاف, مُثَار نِزَاع (موضوع الخلاف)\nمثال: موضع الخلاف الحقيقي، كما تعلم، هو المال",
 "bone oil": "زيت العظام (زيت داكن اللون كريه الرائحة يتم الحصول عليه بتفحيم العظام؛ يُستخدم خاصة في محاليل تغطيس الأغنام وفي تغيير طبيعة الكحول) / زيت العظام (الجزء السائل من دهن العظام؛ يُستخدم كمواد تشحيم وفي صناعة الجلود)",
 "bone spavin": "عرة عظمية (عرة (مرض في مفصل العرقوب عند الخيول) ناتج عن نمو عظمي)",
 "bone-ash cup": "بوتقة التمحيع (وعاء مسامي صغير مصنوع من رماد العظام يستخدم في فحص المعادن لفصل المعادن الثمينة عن الرصاص)",
 "bone-covered": "مُغَطَّى بِالعَظْم ((عن الحيوانات) مدرَّع بطبقة عظميّة)",
 "bone-forming cell": "أرومة عظمية, خلية بانية للعظم (خلية يتطور منها العظم)",
 "bone-headed dinosaur": "ديناصور عظمي الرأس (ديناصورات عشبية تسير على قدمين ولها تيجان عظمية)",
 "bone-idle": "كَسُول بِالفِطْرَة (كَسُول أَوْ خَامِل بِطَبِيعَتِه)",
 "bone-lazy": "كَسُول بِالفِطْرَة (كَسُول أَوْ خَامِل بِطَبِيعَتِه)",
 "boned": "ذُو عِظَام (لَهُ عِظَام بِصِفَة مُعَيَّنَة) / مَنْزُوع العَظْم (أُزِيلَت مِنْه العِظَام)",
 "bonefish": "سمكة العظم (سمكة بحرية فضية نحيلة توجد في المسطحات الطينية الاستوائية وبحيرات المانغروف)",
 "bonehead": "أحمق, بليد (شخص غبي؛ تستخدم هذه الكلمات للتعبير عن رأي متدنٍ في ذكاء شخص ما)",
 "boneheaded": "بَلِيد, غَلِيظ الفَهْم ((غير رسمي) غبيّ وبطيء الفهم)",
 "boneless": "بِلَا عِظَام, رَخْو (بدون عظم أو عظام)\nمثال: قنديل البحر بلا عظام",
 "bonelet": "عظم صغير, عظيم (عظم صغير؛ خاصة في الأذن الوسطى)",
 "bonelike": "شَبِيه بِالعَظْم (يُشْبِه العَظْم فِي مَظْهَرِه أَوْ بِنْيَتِه)",
 "bonemeal": "دقيق العظم, مسحوق العظام (سماد مصنوع من العظام المطحونة)",
 "boner": "اِنْتِصَاب",
