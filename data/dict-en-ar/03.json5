 "blaxploitation": "استغلال السود (استغلال السود (خاصة فيما يتعلق بالأدوار النمطية في الأفلام))",
 "blaze": "سَعِيرَا",
 "blazer": "بلزر",
 "blazing": "مُبْهِر, وَهَّاج (يَلْمَع بِشِدَّة وقُوَّة) / صَارِخ, فَاضِح (واضح تمامًا دون أيّ محاولة للإخفاء) / حريق هائل, وهج (لهب قوي يحترق بلمعان وشدة)\nمثال: انتشر الحريق الهائل بسرعة",
 "blazing star": "ريشة غاي, ليآتريس (أي من نباتات أمريكا الشمالية المتنوعة من جنس ليآتريس ذات نورات عنقودية أو عثكولية من رؤوس الزهور القرصية الصغيرة) / نجمة ساطعة (نبات ثنائي الحول من جنوب غرب الولايات المتحدة له سيقان بيضاء وأوراق مسننة يُزرع لزهوره الصفراء الشاحبة الكبيرة التي تتفتح في الصباح الباكر)",
 "blazon": "درع النبالة, شعار النبالة (الرموز الرسمية لعائلة أو دولة، إلخ)",
 "blazonry": "درع النبالة, شعار النبالة (الرموز الرسمية لعائلة أو دولة، إلخ)",
 "bleach": "مَادَّة تَبْيِيض (مؤنث مَادّ، اسم فاعل من مَدَّ. الجمع مَادَّات؛ ما كان مَدَدًا لغيره) / بَيَّضَ (الأيام البِيض: الأيام التي توافق اليوم الثالث عشر، والرابع عشر، والخامس عشر من كل شهر من أشهر العام الهجري، وقد سُمِّيت بذلك…)\nمثال: لا أحب مادة العلوم.",
 "bleach liquor": "سائل قصر, محلول تبييض (محلول يحتوي على عوامل تبييض يستخدم لتبييض المنسوجات أو لب الورق)",
 "bleached": "بَاهِت, مَغْسُول (فاقد اللون بسبب التعرّض للضوء أو الغسيل المتكرّر) / مَصْبُوغ, مُلَوَّن صِنَاعِيًّا (مُنتَج صناعيًّا وليس طبيعيًّا (يوصف به اللون))",
 "bleacher": "مبيض (عامل يقوم بتبييض (القماش أو الدقيق وما إلى ذلك))",
 "bleachers": "مُدَرَّجَات مَكْشُوفَة (مدرج خارجي بدون سقف؛ يتعرض الرواد للشمس)",
 "bleaching agent": "عامل تبييض, مبيض (عامل يجعل الأشياء بيضاء أو عديمة اللون)",
 "bleaching clay": "طين تبييض (طين ممتز يزيل اللون من الزيوت)",
 "bleaching earth": "طين تبييض (طين ممتز يزيل اللون من الزيوت)",
 "bleaching powder": "جير مكلور, مسحوق تبييض (مسحوق أبيض يتكون من هيدروكسيد الكالسيوم والكلوريد وهيبوكلوريت ويستخدم للتبييض و/أو التطهير)",
 "bleak": "قَاتِم, كَئِيب (لا يبعث على الأمل إلّا قليلاً أو لا يبعث عليه أبداً) / جَرْدَاء, قَاحِلَة (لا توفِّر مأوى ولا قوتاً) / قَارِص, كَئِيب (بارد ورطب بشكل مُزعج)",
 "bleakly": "بكآبة, بيأس (بدون أمل)\nمثال: تساءل بكآبة",
 "bleakness": "عراء, قفار (جو موحش ومقفر)\nمثال: عراء المنظر الطبيعي",
 "blear": "غَائِمُ العَيْنَيْن, كَلِيل (مُتْعَبٌ إِلَى حَدِّ الإِنْهَاك)",
 "blear-eyed": "غَائِمُ العَيْنَيْن, كَلِيل (مُتْعَبٌ إِلَى حَدِّ الإِنْهَاك)",
 "bleary": "ضَبَابِيّ, مُشَوَّش (غَيْر وَاضِح أَوْ مُبْهَم الخُطُوط) / غَائِمُ العَيْنَيْن, كَلِيل (مُتْعَبٌ إِلَى حَدِّ الإِنْهَاك)",
 "bleary-eyed": "غَائِمُ العَيْنَيْن, كَلِيل (مُتْعَبٌ إِلَى حَدِّ الإِنْهَاك)",
 "bleat": "ثُغَاء, مَأْمَأَة / مَأْمَأَ, ثَغَا",
 "bleb": "بثرة, فقاعة ((علم الأمراض) ارتفاع في الجلد مملوء بسائل مصلي)",
 "blebbed": "ذُو فُقَّاعَات, مُنَفَّط ((للزجاج أو الكوارتز) مشوَّه بفقاعات صغيرة أو جسيمات غريبة)",
 "blebby": "ذُو فُقَّاعَات, مُنَفَّط ((للزجاج أو الكوارتز) مشوَّه بفقاعات صغيرة أو جسيمات غريبة) / ذو فُقاعات, مُبَثَّر (مُغَطّى بِبُثور أو فُقاعات صَغيرَة)",
 "blechnum spicant": "سرخس الغزال (سرخس بسعف منتصب في أوروبا وغرب أمريكا الشمالية؛ يزرع غالباً كعلف للغزلان)",
 "bleed": "نَزَفَ",
 "bleed out": "نَزَفَ حَتَّى الْمَوْت",
 "bleeder": "مَرِيض بِالنَّاعُور, هِيمُوفِيلِيّ (شخص مصاب بمرض الهيموفيليا (الناعور) وعرضة لنزيف لا يمكن السيطرة عليه)",
 "bleeder's disease": "ناعور, هيموفيليا (ميل خلقي لنزيف غير منضبط)",
 "bleeding": "نَزِيف, نَزْف",
 "bleeding heart": "مفرط التعاطف (شخص متعاطف بشكل مفرط مع أولئك الذين يدعون أنهم مستغلون أو محرومون) / القلب النازف, ديسنترا رائعة (نبات حدائق له أزهار متدلية على شكل قلب وردية داكنة)",
 "bleeding tooth": "سن نازف (بطني قدم له نتوءات تشبه الأسنان المحمرة حول فتحة الصدفة؛ من منطقة البحر الكاريبي)",
 "bleep": "بيب, صفير (نغمة عالية قصيرة تصدر كإشارة أو تحذير)",
 "blemish": "شائبة, عيب (علامة أو عيب يفسد مظهر شيء ما (خاصة على جسم الشخص))\nمثال: عيب في الوجه",
 "blemished": "مَشُوب, مَعِيب (مشوه بالعيوب) / مَشُوب, مَعِيب (فيه شائبة أو عيب)",
 "blend": "توليف, مزج (عملية مزج المكونات معاً بدقة) / كلمة منحوتة, نحت (كلمة جديدة تتشكل من خلال ضم كلمتين أخريين والجمع بين معانيهما) / امتزاج, تمازج (حدوث خلط شامل)\nمثال: 'الزمكان' هي نحت من 'الزمان' و 'المكان'",
 "blende": "بلند الزنك, سفاليريت (خام يعد المصدر الرئيسي للزنك؛ يتكون إلى حد كبير من كبريتيد الزنك البلوري)",
 "blended": "مخلوط, ممزوج (مُجمع أو مخلوط معاً بحيث لا يمكن تمييز الأجزاء المكونة)",
 "blended whiskey": "ويسكي مخلوط (خليط من نوعين أو أكثر من الويسكي أو من الويسكي والكحول المحايد)",
 "blended whisky": "ويسكي مخلوط (خليط من نوعين أو أكثر من الويسكي أو من الويسكي والكحول المحايد)",
 "blender": "خَلَّاط",
 "blending": "توليف, مزج (عملية مزج المكونات معاً بدقة) / تظليل, مزج (تدرج ينطوي على اختلافات صغيرة أو غير محسوسة بين الدرجات)",
 "blenheim spaniel": "بلينهايم سبانييل (صنف أحمر وأبيض من سبانييل اللعبة الإنجليزي)",
 "blennioid": "بليني (أسماك بحرية ممدودة غالباً عديمة القشور ذات زعانف صدرية كبيرة وزعانف حوضية مختزلة)",
 "blennioid fish": "بليني (أسماك بحرية ممدودة غالباً عديمة القشور ذات زعانف صدرية كبيرة وزعانف حوضية مختزلة)",
 "blennius pholis": "شاني (بليني أوروبي بلا حراشف)",
 "blenny": "البليني, سمكة البلينية (أسماك صغيرة عادة ما تكون بلا حراشف ولها أسنان تشبه المشط وتعيش حول الشواطئ الصخرية؛ وهي إقليمية وتعيش في ثقوب بين الصخور)",
 "blepharism": "تشنج الجفن المستمر (حالة يرمش فيها الشخص باستمرار)",
 "blepharitis": "التهاب الجفن (التهاب الجفون يتميز بالاحمرار والتورم والقشور الجافة)",
 "blepharospasm": "تشنج الجفن (تشنج عضلة الجفن مما يؤدي إلى انغلاق العين)",
 "blephilia ciliata": "نعناع الخشب الزغبي (صنف من نعناع الخشب بزهور وردية أرجوانية مكدسة لتشبه الباغودا)",
 "blephilia hirsuta": "نعناع الخشب المشعر (صنف من نعناع الخشب بزهور زرقاء فاتحة أو أرجوانية شاحبة أو بيضاء مع بقع أرجوانية)",
 "bless": "بَارَكَ",
 "bless you": "صِحَّة, اَلْحَمْدُ لِلّٰه (سَلَامَة؛ سَلَامَة الْجِسْم)\nمثال: أشك في صحة ذلك.",
 "blessed": "مُبَارَك",
 "blessed event": "حدث سعيد (الولادة الحية لطفل)",
 "blessed thistle": "شَوْك مُبَارَك",
 "blessedly": "بشكل مبارك, لحسن الحظ (بطريقة مباركة أو ميمونة)",
 "blessedness": "سعادة قصوى, طوبى (حالة من السعادة العارمة)",
 "blessing": "بَرَكَة, نِعْمَة (مُسْتَنْقَع الماء أو أو بُحِيْرَة صغيرة؛ حوض الماء المصنوع لتزيين الحدائق وريها) / نِعْمَة\nمثال: البركة عميقة جدا.",
 "blest": "مبارك, منعم عليه (مفضل جداً أو محظوظ (كما هو الحال بفضل إلهي))\nمثال: أرضنا المباركة",
 "blether": "ثرثرة, كلام تافه (حديث عاطل أو أحمق وغير ذي صلة)",
 "bletia": "بليتيا (أي من بساتين الفاكهة المختلفة من جنس بليتيا ذات بصيلات كاذبة وعناقيد منتصبة بلا أوراق من الزهور الأرجوانية أو الوردية الكبيرة)",
 "bletia striata": "بليتيلا مخططة (أوركيد ياباني بأوراق مخططة بالأبيض وعناقيد منتصبة نحيلة من الزهور الوردية إلى الأرجوانية؛ يزرع غالباً؛ يوضع أحياناً في جنس بليتيا)",
 "bletilla striata": "بليتيلا مخططة (أوركيد ياباني بأوراق مخططة بالأبيض وعناقيد منتصبة نحيلة من الزهور الوردية إلى الأرجوانية؛ يزرع غالباً؛ يوضع أحياناً في جنس بليتيا)",
 "bleu": "جبن أزرق (جبن يحتوي على عفن أزرق)",
 "bleu cheese dressing": "تتبيلة الجبن الأزرق (تتبيلة كريمية تحتوي على فتات الجبن الأزرق)",
 "bleu vegetal pour les veines": "أزرق نباتي للعروق (مستحضر تجميلي أزرق اللون استخدم منذ العصور القديمة وحتى القرن العشرين لرسم خطوط زرقاء على الجلد عند الصدغين وأسفل الرقبة، بهدف تقليد العروق الزرقاء…)\nمثال: كان الأزرق النباتي للعروق يأتي على شكل أعواد أو أقلام محضرة من الطباشير والصمغ والصبغة الزرقاء",
 "blewits": "بلوويت (غاريقون صالح للأكل لونه ليلكي شاحب عندما يكون صغيراً؛ له قبعة رطبة ملساء)",
 "blida": "البُلَيْدَة",
 "blighia sapida": "آكي, شجرة الآكي (تزرع على نطاق واسع في المناطق الاستوائية وشبه الاستوائية لزهورها العطرة وثمارها الملونة؛ أدخلها ويليام بليغ إلى جامايكا)",
 "blight": "لفحة (أي مرض نباتي يؤدي إلى الذبول دون تعفن) / آفة, لفحة (حالة أو وضع الإصابة بآفة)",
 "blight canker": "تقرح اللفحة (مرحلة من اللفحة النارية تظهر فيها تقرحات)",
 "blighted": "فَاسِد, مُصَاب بِالآفَة (أَصَابَهُ تَلَفٌ يُعِيقُ النُّمُوَّ أَوِ الازْدِهَار)",
 "blighter": "رجل, رفيق (صبي أو رجل) / ثقيل الظل, لحوح (شخص يسبب الإزعاج والمضايقة باستمرار)\nمثال: ذلك الرجل هو مضيفك",
 "blighty wound": "جرح يستدعي الإعادة (جرح من شأنه أن يتسبب في إعادة الجندي إلى وطنه من الخدمة في الخارج)",
 "blimp": "مُنْطَاد ذُو مُحَرِّك",
 "blimpish": "شُوفِينِيّ, مُتَبَجِّح (مُحَافِظٌ بِتَطَرُّفٍ مَعَ قَوْمِيَّةٍ مُتَغَطْرِسَةٍ)",
 "blind": "أَعْمَى, عَمْيَاء",
 "blind alley": "طريق مسدود ((مجازياً) مسار عمل غير منتج ولا يوفر أي أمل في التحسن) / طريق مسدود (شارع له مدخل أو مخرج واحد فقط)\nمثال: قادت كل الأدلة الشرطة إلى طرق مسدودة",
 "blind axle": "محور أصم (محور يدور ولكنه لا ينقل الحركة)",
 "blind bend": "منحنى أعمى, منعطف محجوب (منحنى أو منعطف في الطريق لا يمكنك رؤية ما وراءه أثناء القيادة)",
 "blind corner": "منعطف محجوب الرؤية (زاوية شارع لا يمكنك الرؤية حولها أثناء القيادة)",
 "blind curve": "منحنى أعمى, منعطف محجوب (منحنى أو منعطف في الطريق لا يمكنك رؤية ما وراءه أثناء القيادة)",
 "blind date": "لقاء مع غريب, موعد مدبر (موعد غرامي مع شخص غريب) / رفيق موعد أعمى (مشارك في موعد أعمى (شخص تقابله لأول مرة في موعد))\nمثال: هي لا تذهب أبداً في مواعيد مدبرة",
 "blind drunk": "ثَمِل تَمَامًا, سَكْرَان طَافِح (فِي حَالَة سُكْرٍ شَدِيد)",
 "blind eel": "أمفيوما (سمندل مائي يشبه الثعبان له زوجان من الأقدام الصغيرة جداً؛ من المياه الطينية الراكدة في جنوب الولايات المتحدة)",
 "blind flying": "طيران آلي, طيران أعمى (استخدام الأجهزة فقط لتوجيه الطائرة لعدم القدرة على الرؤية بسبب الغيوم أو الضباب وما إلى ذلك)",
 "blind gentian": "جنطيانا عمياء, جنطيانا مغلقة (جنطيانا من شرق أمريكا الشمالية لها زهور أنبوبية زرقاء أو بيضاء تفتح قليلاً أو لا تفتح على الإطلاق) / جنطيانا مغلقة",
 "blind gut": "أعور (التجويف الذي تبدأ فيه الأمعاء الغليظة والذي يفتح فيه اللفائفي)\nمثال: الزائدة الدودية هي فرع من الأعور",
 "blind landing": "طيران آلي, طيران أعمى (استخدام الأجهزة فقط لتوجيه الطائرة لعدم القدرة على الرؤية بسبب الغيوم أو الضباب وما إلى ذلك)",
 "blind person": "مَكْفوف",
 "blind side": "جانب أعمى, نقطة عمياء (الجانب الذي تكون فيه رؤيتك محدودة أو محجوبة)",
 "blind snake": "ثعبان أعمى (ثعبان حفار يشبه الدودة من المناطق الدافئة له عيون أثرية)",
 "blind spot": "نُقْطَة عَمْيَاء (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه)\nمثال: هذه هي نقطة ضعفه.",
 "blind staggers": "ترنح, دوار (مرض في الجهاز العصبي المركزي يؤثر خاصة على الخيول والماشية؛ يتميز بمشية غير مستقرة وسقوط متكرر)",
 "blind stitch machine": "ماكينة الخياطة المخفية, ماكينة اللفق (آلة خياطة لربط قطعتين من القماش بحيث يكون خيط الغرزة غير مرئي، أو غير مرئي تقريباً)",
 "blind stitching": "خياطة مخفية (خياطة لا تُرى أو تلاحظ بسهولة)",
 "blind trust": "ائتمان أعمى (ائتمان يمكّن الشخص من تجنب تضارب المصالح المحتمل عن طريق نقل الأصول إلى وكيل؛ يتخلى الشخص المنشئ للائتمان عن الحق في المعلومات حول الأصول)",
 "blinded": "فَاقِد البَصَر, مَكْفُوف (حُرم من نعمة البصر)",
 "blinder": "غطاء العين, غمامة (ساتر يتكون من رقعة جلدية مخيطة بجانب الرسن تمنع الحصان من رؤية ما هو موجود على الجانبين)",
 "blindfold": "غَمَّى",
 "blindfolded": "مُغَمًّى, مَعْصُوبُ العَيْنَيْن",
 "blindfolder": "مُغَمٍّ",
 "blinding": "مُبْهِر, وَهَّاج (يَلْمَع بِشِدَّة وقُوَّة)",
 "blindly": "بشكل أعمى, دون تفكير (بدون تحضير أو تفكير؛ بدون أساس عقلاني) / بشكل أعمى, دون تبصر (دون رؤية أو نظر)\nمثال: اشتروا السيارة بشكل أعمى",
 "blindman's bluff": "الاستغماية, الغميضة (لعبة للأطفال يحاول فيها لاعب معصوب العينين الإمساك باللاعبين الآخرين والتعرف عليهم)",
 "blindman's buff": "الاستغماية, الغميضة (لعبة للأطفال يحاول فيها لاعب معصوب العينين الإمساك باللاعبين الآخرين والتعرف عليهم)",
 "blindness": "عَمًى",
 "blindstitch machine": "ماكينة الخياطة المخفية, ماكينة اللفق (آلة خياطة لربط قطعتين من القماش بحيث يكون خيط الغرزة غير مرئي، أو غير مرئي تقريباً)",
 "blindstitch sewing machine": "ماكينة الخياطة المخفية, ماكينة اللفق (آلة خياطة لربط قطعتين من القماش بحيث يكون خيط الغرزة غير مرئي، أو غير مرئي تقريباً)",
 "blindworm": "ضفدع ثعباني (أي من البرمائيات الصغيرة النحيلة عديمة الأطراف الحفارة التي تشبه الديدان؛ تعيش في التربة الرطبة في المناطق الاستوائية) / برص أعمى, دودة بطيئة (سحلية أوروبية صغيرة تحفر الجحور وعديمة الأرجل ذات عيون صغيرة جداً؛ يُعتقد شعبياً أنها عمياء)",
 "bling": "مجوهرات مبهرجة (مجوهرات لامعة ومتباهية)\nمثال: كان مغني الراب محملاً بالمجوهرات المبهرجة",
 "bling bling": "مجوهرات مبهرجة (مجوهرات لامعة ومتباهية)\nمثال: كان مغني الراب محملاً بالمجوهرات المبهرجة",
 "blini": "بليني (فطيرة روسية من دقيق الحنطة السوداء والخميرة؛ تقدم عادة مع الكافيار والقشدة الحامضة)",
 "blink": "رَمَشَ (رمش: المش:- تقتل في الشفر وحمرة في الجفن مع ماء يسيل، رجل ارمش وامراءة رمشاء وعين رمشاء وقد ارمش؛ وبه رمش اي برش:- وارمش الشجر:- اورق كأربش وقال ابن الاعرابي أرمش أخرج ثمره كالحمص، وارض رمشاء: كثيرة العشب كرسماء) / رَمْشَة",
 "blink of an eye": "طرفة عين, لمح البصر (وقت قصير جداً (مثل الوقت الذي تستغرقه العين لتطرف))\nمثال: سأفعل ذلك في لمح البصر",
 "blinker": "غمّاز, وماض (ضوء يضيء وينطفئ؛ يستخدم كإشارة أو لإرسال رسائل) / غطاء العين, غمامة (ساتر يتكون من رقعة جلدية مخيطة بجانب الرسن تمنع الحصان من رؤية ما هو موجود على الجانبين) / إشارة الانعطاف, غمّاز (ضوء وامض في مركبة بمحرك يشير إلى الاتجاه الذي توشك المركبة على الانعطاف إليه)",
 "blinking": "رفة عين, رمش (منعكس يغلق ويفتح العينين بسرعة) / رَامِش, طَارِف (يُغلق العينين بشكل متقطع وسريع)",
 "blinking chickweed": "بلينكس, عشبة الطيور المائية (خس هندي صغير من المناطق الشمالية)",
 "blinks": "بلينكس, عشبة الطيور المائية (خس هندي صغير من المناطق الشمالية)",
 "blintz": "بلينتز (فطيرة رقيقة تطوى حول حشوة وتقلى أو تخبز)",
 "blintze": "بلينتز (فطيرة رقيقة تطوى حول حشوة وتقلى أو تخبز)",
 "bliny": "بليني (فطيرة روسية من دقيق الحنطة السوداء والخميرة؛ تقدم عادة مع الكافيار والقشدة الحامضة)",
 "blip": "نقطة رادار, ومضة (صدى رادار يُعرض لإظهار موقع سطح عاكس) / خلل عابر, هفوة (صدمة طفيفة مفاجئة أو انقطاع لا معنى له)\nمثال: شهد السوق هفوة سيئة واحدة اليوم",
 "bliss": "نَعِيم",
 "blissful": "غَارِق فِي النَّعِيم, مُنْعَم (سعيد ومكتفٍ تماماً؛ في غاية الهناء)",
 "blissfully": "بِسَعَادَة غَامِرَة, بِهَنَاء (بطريقة سعيدة)\nمثال: كان غافلاً بسعادة عن الخطر",
 "blissfulness": "سعادة قصوى, غبطة (حالة من السعادة الغامرة)",
 "blissus leucopterus": "بق الحبوب (حشرة صغيرة سوداء وبيضاء تتغذى على أعشاب الحبوب)",
 "blister": "بَطْبَاطَة, نَفْطَة",
 "blister beetle": "خنفساء محرقة, ذراح (خنفساء تنتج إفرازاً يسبب تقرحات في الجلد)",
 "blister blight": "لفحة الشاي التبثرية (مرض يصيب نباتات الشاي، يتميز بآفات تشبه البثور على الأوراق) / لفحة الصنوبر التبثرية (مرض يصيب الصنوبر الاسكتلندي)",
 "blister copper": "نحاس بليستر, نحاس خام (شكل غير نقي من النحاس له سطح أسود متقرح)",
 "blister pack": "عبوة فقاعية (تغليف يتم فيه ختم المنتج بين دعامة من الورق المقوى وغطاء بلاستيكي شفاف)",
 "blister rust": "صدأ نفطي (فطر يسبب صدأ الصنوبر الأبيض النفطي وله دورة حياة معقدة تتطلب نباتاً من جنس ريبس كعائل بديل) / صدأ الصنوبر الأبيض, صدأ تبثري",
 "blistering": "خَاطِف, سَرِيع جِدًّا (سَرِيع لِلغَايَة؛ قَادِر عَلَى الاسْتِجَابَة السَّرِيعَة وَالسُّرْعَة الفَائِقَة) / لَافِح, مُلْتَهِب (شديد الحرارة بما يكفي لإحداث بثور أو كأنَّه كذلك) / حَارِق, لَاذِع (قاسٍ أو كاوٍ في اللهجة) / تبثر, تكون الحويصلات (تكون حويصلات في الجلد أو تحته)",
 "blistering agent": "عامل منفط, غاز الخردل (غاز حرب سام بمركبات تعتمد على الكبريتيد يسبب البثور ويهاجم العيون والرئتين؛ لا يوجد ترياق معروف له)",
 "blistery": "ذو فُقاعات, مُبَثَّر (مُغَطّى بِبُثور أو فُقاعات صَغيرَة) / لَافِح, مُلْتَهِب (شديد الحرارة بما يكفي لإحداث بثور أو كأنَّه كذلك)",
 "blithe": "خَفِيف الرُّوح, فَرِح (بلا هموم؛ سعيد وخفيف القلب) / طَائِش, مُسْتَهْتِر (يَفْتَقِرُ إِلَى الِاهْتِمَامِ الوَاجِبِ أَوْ يُظْهِرُ ذَلِكَ)",
 "blithely": "بابتهاج, بسعادة (بطريقة مبهجة)\nمثال: صاحوا بسعادة",
 "blitheness": "انشراح, بشاشة (شعور بمعنويات جيدة عفوية)\nمثال: بشاشته جعلت الجميع يشعرون بتحسن",
 "blithesome": "خَفِيف الرُّوح, فَرِح (بلا هموم؛ سعيد وخفيف القلب)",
 "blitt": "بكالوريوس في الأدب (درجة البكالوريوس في الأدب)",
 "blitz": "حرب خاطفة, هجوم خاطف (هجوم عسكري سريع وعنيف بقصف جوي مكثف) / بليتز, هجوم خاطف ((كرة القدم الأمريكية) محاولة اللاعبين المدافعين اختراق الخط الهجومي)",
 "blitzkrieg": "حَرْب خَاطِفَة (حَرَبَ (حربه) بالحربة حربا: طعنه بها؛ حَرَبَ (ه) حربا: سلبه جميع ما يملك)\nمثال: بوتين مجرم حرب.",
 "blizzard": "عَاصِفَة ثَلْجِيَّة, دَمَق",
 "bloat": "نفاخ (انتفاخ الكرش أو الجهاز المعوي للحيوانات الأليفة الناتج عن الغازات المفرطة)",
 "bloated": "مُتَوَرِّم, مُنْتَفِخ (مُتَمَدِّد بِشَكْل غَيْر طَبيعِيّ بِسَبَب السَّوائِل أو الغاز)",
 "bloater": "رنجة مملحة ومدخنة جزئياً (رنجة دهنية كبيرة مملحة قليلاً ومدخنة لفترة وجيزة)",
 "bloating": "نَفْخ, اِنْتِفَاخ (أَطْلَقَ الريح من فمه؛ زَفَرَ أو هَبَّ بشدة)\nمثال: يداك أوكتا وفوك نفخ",
 "blob": "بقعة, كتلة (شكل غير واضح المعالم)",
 "bloc": "كُتْلَة (القطعة المجتمعة من الشيء؛ القطعة الواحدة من اللحم)\nمثال: السحابة هي كتلة بخار في السماء.",
 "blocadren": "بلوكادرين, تيمولول (حاصر بيتا (الاسم التجاري بلوكادرين) يعطى بعد النوبات القلبية)",
 "block": "طَابُوقَة",
 "block anaesthesia": "تخدير توصيلي, حصر العصب (تخدير منطقة يغذيها عصب معين؛ يتم عن طريق تطبيق عامل مخدر على العصب)",
 "block and tackle": "مُحْل, مَحَالَة (الهدي: الوقت الذي ينحر فيه؛ الدين: أجله والوقت الذي يوفى فيه)\nمثال: أغلق دان المحل.",
 "block anesthesia": "تخدير توصيلي, حصر العصب (تخدير منطقة يغذيها عصب معين؛ يتم عن طريق تطبيق عامل مخدر على العصب)",
 "block capital": "حرف كبير بسيط (حرف مرسوم يدوياً بشكل بسيط)",
 "block diagram": "مخطط كتلي (مخطط يظهر الترابطات بين مكونات نظام (خاصة نظام إلكتروني))",
 "block grant": "منحة شاملة (منحة من المال الفيدرالي لحكومات الولايات والحكومات المحلية لدعم برامج الرعاية الاجتماعية)\nمثال: المنح الشاملة تقلل من المسؤولية الفيدرالية عن الرعاية الاجتماعية",
 "block heel": "كعب ضخم, كعب عريض (نوع من الكعب العريض الذي يكون عادة مربعاً؛ ويأتي بارتفاعات مختلفة)\nمثال: ستمنحك الأحذية ذات الكعوب العريضة بضع بوصات إضافية مع الحفاظ على الراحة",
 "block island": "بلوك آيلاند",
 "block letter": "حرف كبير بسيط (حرف مرسوم يدوياً بشكل بسيط)",
 "block plane": "فارة صغيرة, مِسْحَج التسوية (مسحج صغير يستخدم على أطراف ألياف الخشب (المقطع العرضي))",
 "block vote": "تصويت الكتلة, تصويت جماعي (تصويت يتناسب حجمه مع عدد الأشخاص الذين يمثلهم المندوب)",
 "blockade": "حِصَار, مُحَاصَرَة",
 "blockade-runner": "سفينة كاسرة للحصار (سفينة تخترق الحصار البحري أو تلتف حوله)",
 "blockaded": "مُتَرَّس, مُحَاصَر (يمنع الدخول أو الخروج أو اتخاذ إجراء ما)",
 "blockading": "مُحَاصِر (يمنع الدخول إلى الموانئ والمرافئ والخروج منها)",
 "blockage": "انسداد, سد (فعل السد أو الغلق) / انسداد, سدادة (عائق في أنبوب أو مجرى) / إعاقة, انسداد (الحالة المادية لسد أو ملء ممر بعائق)\nمثال: اضطررنا لاستدعاء سباك لإزالة الانسداد في أنبوب الصرف",
 "blockbuster": "بْلُوكْبَاسْتَر",
 "blocked": "مَسْدُود تَمَامًا, مُغْلَق (مسدود أو مغلق بالكامل) / مُغْلَق أَمَام الحَرَكَة (مغلق أمام حركة المرور)",
 "blocker": "حاصر, مثبط (فئة من الأدوية التي تثبط (تحجب) بعض العمليات البيولوجية) / حاجب, صداد (لاعب كرة قدم أمريكية مسؤوليته صد اللاعبين الذين يحاولون إيقاف اللعب الهجومي)",
 "blockhead": "أحمق, بليد (شخص غبي؛ تستخدم هذه الكلمات للتعبير عن رأي متدنٍ في ذكاء شخص ما)",
 "blockheaded": "بَلِيد, غَلِيظ الفَهْم ((غير رسمي) غبيّ وبطيء الفهم)",
 "blockhouse": "حِصْن (ما يُتَحَصَّنُ به ويُمْنَع؛ كل مكان محميّ مُحرَز لا يُوصَل إليه؛ عن ما يُتَحصَّن به وإن لم يكن موضعا أو مكانا كالسلاح مثلا)\nمثال: كان هناك حصن على تلك الهضبة في يوم من الأيام.",
 "blocking": "حجب, صد (فعل إعاقة أو تحويل حركات شخص ما)",
 "blocking agent": "حاصر, مثبط (فئة من الأدوية التي تثبط (تحجب) بعض العمليات البيولوجية)",
 "blockish": "شَبِيهٌ بِالكُتْلَةِ, كُتْلَوِيّ (يشبه الكتلة في شكله)",
 "blocky": "شَبِيهٌ بِالكُتْلَةِ, كُتْلَوِيّ (يشبه الكتلة في شكله)",
 "blog": "مُدَوَّنَة إِلِكْتْرُونِيَّة, مُدَوَّنَة",
 "blogger": "مُدَوِّن, مُدَوِّنَة",
 "blois": "بْلُوَا, بْلُوَة",
 "bloke": "رَجُل (العُضْو في جسد الإنسان يتكون من القَدَم والسَاق والفُخْذ. الجمع أرجُل، وقد تقول العامّة رِجْلين ورجْلينات؛ القَدَم من باب اطلاق اسم الكل على الجزء)\nمثال: هذا الرجل تاجر.",
 "blolly": "توت الثلج لغرب الهند, كيوكوكا ألبا (شجيرة متسلقة دائمة الخضرة من جنوب فلوريدا وجزر الهند الغربية تزرع لعناقيدها من الزهور البيضاء العطرة إلى الكريمية تليها ثمار توت عصارية بيضاء كروية)",
 "blond": "أَشْقَر, شَقْرَاء (هو لون الشُقْرَة، وأصله اللون الأحمر المائل إلى الصُفرة ثم أصبح يطلق على ما كان لونه أصفر أيضا؛ صفة ما كان لونه الشُقرة) / أَشْقَر, شَقْرَاءْ (هو لون الشُقْرَة، وأصله اللون الأحمر المائل إلى الصُفرة ثم أصبح يطلق على ما كان لونه أصفر أيضا؛ صفة ما كان لونه الشُقرة)\nمثال: أنا لديها شعر بني كستنائي, ولكن ماجدالينا لديها شعر أشقر.",
 "blond person": "أشقر (شخص ذو بشرة فاتحة وشعر فاتح)",
 "blonde": "أَشْقَر (كونه أو لديه بشرة وشعر فاتح اللون وعادة عيون زرقاء أو رمادية) / أشقر (أصفر رمادي فاتح إلى ما يقرب من الأبيض) / شقراء (شخص أنثى ذات بشرة وشعر فاتحين)\nمثال: اسكندنافيون شقر",
 "blonde lilian": "إريثرونيوم أبيض, سن الكلب الأبيض (نبات سن الكلب من أمريكا الشمالية له زهور بيضاء منفردة بمراكز صفراء وخارج أزرق أو وردي)",
 "blondness": "بياض البشرة, شقرة (خاصية التمتع ببشرة فاتحة بشكل طبيعي)",
 "blood": "دَم, دم (فِي وَ: سائل أحمر في جسم الكائنات الحية يقوم بنقل المواد الغذائية والأكسجين إلى الخلايا والفضلات وثاني أكسيد الكربون منها)\nمثال: تبرع توم بالدم.",
 "blood agar": "آغار الدم (وسط استنبات يحتوي على الدم الكامل كمادة مغذية)",
 "blood bank": "بنك الدم (مكان لتخزين الدم الكامل أو بلازما الدم)\nمثال: أنشأ الصليب الأحمر بنك دم للطوارئ",
 "blood berry": "توت الدم, ريفينا (نبات منزلي شجيري له أزهار بيضاء إلى وردية شاحبة تليها عناقيد من التوت القرمزي؛ موطنه المناطق الاستوائية في الأمريكتين)",
 "blood blister": "فقاعة دموية (بثرة تحتوي على دم أو مصل دموي عادة ما تسببها إصابة)",
 "blood brother": "أخ بالدم (ذكر أقسم (عادة بمراسم تتضمن خلط الدم) على معاملة آخر كأخيه) / أخ, شقيق (ذكر له نفس الوالدين مثل شخص آخر)\nمثال: لا يزال أخي يعيش مع والدينا",
 "blood brotherhood": "أخوة الدم (الصداقة المميزة لإخوة الدم)",
 "blood cell": "خَلِيَّة دَم, خَلِيَّة دَمَوِيَّة",
 "blood clam": "محار الدم (محار أحمر الدم)",
 "blood clot": "خُثْرَة, جُلْطَة",
 "blood clotting": "تجلط الدم, تخثر الدم (عملية يتحول فيها الدم السائل إلى كتلة شبه صلبة (جلطة دموية))",
 "blood coagulation": "تجلط الدم, تخثر الدم (عملية يتحول فيها الدم السائل إلى كتلة شبه صلبة (جلطة دموية))",
 "blood corpuscle": "خلية دم, كريّة دم (أي من نوعي الخلايا (خلايا الدم الحمراء والبيضاء) وأحياناً تشمل الصفائح الدموية)",
 "blood count": "تعداد الدم (عملية تقدير عدد الكريات الحمراء والبيضاء في عينة دم) / تَعْدَاد الدَّم, عَدّ الدَّم (عدد كريات الدم الحمراء والبيضاء في عينة دم)",
 "blood cup": "كأس الجنية, كأس الدم (فطر أوروبي قرمزي بجسم ثمري كأسي الشكل)",
 "blood cyst": "كيس دموي (كيس يحتوي على دم)",
 "blood disease": "اضطراب الدم, مرض دموي (مرض أو اضطراب في الدم)",
 "blood disorder": "اضطراب الدم, مرض دموي (مرض أو اضطراب في الدم)",
 "blood donor": "متبرع بالدم (شخص يتبرع بالدم لاستخدامه في عمليات نقل الدم)",
 "blood dyscrasia": "اعتلال الدم, خلل الدم (أي حالة غير طبيعية للدم)",
 "blood extravasation": "تسرب الدم (تسرب الدم من وعاء إلى الأنسجة المحيطة به؛ يمكن أن يحدث في الإصابات أو الحروق أو ردود الفعل التحسسية)",
 "blood feud": "اِنْتِقَام, ثَأْر دَمَوِيّ (عداء يقتل فيه أعضاء الأطراف المتعارضة بعضهم البعض)",
 "blood flow": "تدفق الدم",
 "blood flower": "زهرة الدم, صقلاب قرمزي (عشب استوائي له زهور برتقالية حمراء تليها قرون توحي بابتلاع بأجنحة مفرودة؛ عشب ضار في جميع أنحاء المناطق الاستوائية)",
 "blood fluke": "بلهارسيا, منشقة (ديدان مفلطحة تتطفل في الأوعية الدموية للثدييات)",
