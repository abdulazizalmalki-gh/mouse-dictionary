 "please": "أَرْضَى, أَعْجَبَ / مِن فَضْلِك (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / رَجَاءً / لَو سَمَحْت / لُطْفًا / أَرْجُوك\nمثال: يا لها من جملة!",
 "please help me": "سَاعِدُونِي, سَاعِدْنِي",
 "please pass the salt": "امرر الملح لي من فضلك",
 "please repeat after me": "كَرِّر بَعْدِي مِن فَضْلَك, كَرِّر بَعْدِي مِن فَضْلِك (أَعَادَ)\nمثال: كرر الشهادة بعدي.",
 "please say that again": "هَلْ يُمْكِن أَنْ تُعِدْ مِنْ فَضْلِكَ؟, هَلْ يُمْكِن أَنْ تُعِيدِي مِنْ فَضْلِكِ؟",
 "please sit down": "إِجْلِس مِن فَضْلَك, إِجْلِس مِن فَضْلِك",
 "please speak more slowly": "تَكَلَّم بِبُطْء أَكْثَر مِن فَضْلِكَ, تَكَلَّمِي بِبُطْء أَكْثَر مِن فَضْلِكِ (نُطْق؛ تَحَدُّث)\nمثال: أخذت تكلم الكلب.",
 "please turn left": "لِفّ يَسَار، مِن فَضْلِكَ, لِفّ يَسَار، مِن فَضْلِكِ",
 "please turn right": "لِفّ يَمِين، مِن فَضْلِكَ, لِفّ يَمِين، مِن فَضْلِكِ",
 "pleased": "مَسْرُور (كلُّ من يشعر بالسُّرُور)\nمثال: أما مسرور برؤيتك.",
 "pleased to meet you": "تَشَرَّفْنَا, فُرْصَة سَعِيدَة",
 "pleasing": "سَارّ (مَشَى)\nمثال: ها قد أتت سارة.",
 "pleasure": "مُتْعَة, لَذَّة",
 "plectrum": "ريشة",
 "pledge": "تَعَهَّدَ / ضَمَان (مَصْدَرُ ضَمِنَ؛ كَفَالَة) / تَعَهُّد\nمثال: لا أستطيع ضمان أي شيء.",
 "pleiades": "الثُّرَيَّا",
 "plenty": "كَثِير (ما كان عدده كبيرا؛ متبوعًا بمِنْ: عدد كبير أو كمية كبيرة من الشيء)\nمثال: هذا أسهل بكثير.",
 "pleonasm": "حَشْو, إِطْنَاب",
 "plexus": "ضَفِيرَة",
 "pliers": "زَرَّادِيَّة",
 "plo": "م.ت.ف",
 "plosive": "اِنْفِجَارِيّ, صَوْتٌ اِنْفِجَارِيّ",
 "plot": "حَبْكَة / مُؤَامَرَة / مَكِيدَة / كَادَ",
 "plough": "مِحْرَاث / حَرَثَ (حرث الأرض: شقها بالمحراث ليزرعها؛ حرث النار: حركها وأثارها)\nمثال: حرث المزارع أرضه."
}
