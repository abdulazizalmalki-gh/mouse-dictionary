 "dryopteris dilatata": "سرخس الترس العريض (سرخس درعي أوروبي)",
 "dryopteris filix-mas": "سرخس ذكر (سرخس في أمريكا الشمالية وأوروبا تنتج جذاميره وسيقانه راتنجاً زيتياً يستخدم لطرد الديدان الشريطية)",
 "dryopteris fragrans": "سرخس الجرف العطر, سرخس الدرع العطر (سرخس شمال أوراسيا وأمريكا الشمالية ذو سعف عطر)",
 "dryopteris goldiana": "سرخس جولدي, سرخس درع جولدي (سرخس أمريكي شمالي بسويقة سوداء لامعة)",
 "dryopteris hexagonoptera": "سرخس الزان الجنوبي, سرخس الزان العريض (سرخس زان في غابات أمريكا الشمالية بخطوط بلون القش)",
 "dryopteris marginalis": "سرخس الخشب الهامشي, سرخس الخشب دائم الخضرة (سرخس أمريكي شمالي بسعف دائم الخضرة)",
 "dryopteris noveboracensis": "سرخس نيويورك (سرخس درعي رفيع في الغابات الرطبة في شرق أمريكا الشمالية؛ يوضع أحياناً في جنس دريوبتريس)",
 "dryopteris oreades": "سرخس ذكر جبلي (سرخس من جنس درايوبتيريس)",
 "dryopteris oreopteris": "سرخس الجبل (سرخس جبلي أوروبي شائع له سعف برائحة الليمون أو البلسم)",
 "dryopteris phegopteris": "سرخس الزان الشمالي, سرخس الزان الطويل (سرخس زان في أمريكا الشمالية وأوراسيا)",
 "dryopteris thelypteris": "سرخس المستنقعات (سرخس له سعف مفصص ريشياً وينمو في الأماكن الرطبة؛ عالمي الانتشار في المناطق المعتدلة الشمالية)",
 "dryopteris thelypteris pubescens": "سرخس المرج, سرخس صندوق السعوط (سرخس في شمال شرق أمريكا الشمالية)",
 "drypis": "دريبس (عشب معمر شائك الأوراق في جنوب أوروبا له عناقيد طرفية من الزهور الصغيرة)",
 "drywall": "دريوال, لوح جداري (لوح مسطح عريض يستخدم لتغطية الجدران أو القواطع؛ مصنوع من الجص أو لب الخشب أو مواد أخرى ويستخدم بشكل أساسي لتشكيل الجدران الداخلية للمنازل)",
 "ds": "دكتوراه في العلوم (درجة فخرية في العلوم) / مكتب الأمن الدبلوماسي (المكتب في وزارة الخارجية المسؤول عن أمن الدبلوماسيين والسفارات في الخارج) / دارمشتاتيوم (عنصر مشع ما بعد اليورانيوم، عدده الذري 110)",
 "dsl": "خط اشتراك رقمي, دي إس إل (اسم عام للخطوط الرقمية التي تقدمها شركات الهاتف لمشتركيها المحليين والتي تنقل البيانات بسرعات عالية)",
 "dtic": "مركز المعلومات التقنية الدفاعية (الوكالة في وزارة الدفاع التي توفر المعلومات العلمية والتقنية للوكالات الفيدرالية ومقاوليها)",
 "dtmp": "ديوكسي ثيميدين أحادي الفوسفات",
 "dts": "هذيان ارتعاشي (هذيان حاد ناجم عن التسمم الكحولي)",
 "du'a'": "دُعَاء (ما يُدْعَى به الله من القول)\nمثال: لن ينفع الدعاء.",
 "duad": "ثُنَائِيّ, زَوْج (عنصران من نفس النوع)",
 "dual": "مُثَنًّى / مُثَنَّى",
 "dual carriageway": "طريق مزدوج (طريق سريع مقسوم من المنتصف بحاجز يفصل حركة المرور المتجهة في اتجاهين مختلفين)",
 "dual inline package switch": "مفتاح الحزمة المزدوجة ((علم الحاسوب) واحد من مجموعة مفاتيح تشغيل/إيقاف صغيرة مثبتة في أجهزة الكمبيوتر؛ تستخدم بدلاً من الوصلات لتهيئة الجهاز للمستخدم)",
 "dual scan display": "شاشة المسح المزدوج (نوع من شاشات المصفوفة السلبية يتم فيه تحديث النصف العلوي والسفلي من الشاشة في وقت واحد)",
 "dual-lane": "ذُو جَزِيرَةٍ وَسَطِيَّةٍ, مُقَسَّم (به شريط أو جزيرة وسطية تفصل بين حارات المرور المتعاكسة)",
 "dual-purpose": "ثُنَائِيُّ الِاسْتِخْدَامِ, ثُنَائِيُّ الْغَرَضِ (مصمَّم لخدمة غرضين أو مُعَدّ لهما)",
 "dual-use": "ثُنَائِيُّ الِاسْتِخْدَامِ, ثُنَائِيُّ الْغَرَضِ (مصمَّم لخدمة غرضين أو مُعَدّ لهما)",
 "dualism": "ثَنَوِيَّة",
 "dualist": "ثَنَوِيّ",
 "dualistic": "ثنوي, مانوي (من أو يتعلق بمذهب الثنوية الفلسفي)\nمثال: صراع مانوي بين الخير والشر",
 "duality": "ازْدِوَاجِيَّة, ثَنَوِيَّة ((في الهندسة) قابلية تبادل أدوار النقاط والمستويات في نظريات الهندسة الإسقاطية) / ازدواجية, ازدواجية الموجة والجسيم ((فيزياء) خاصية المادة والإشعاع الكهرومغناطيسي التي تتميز بحقيقة أن بعض الخصائص يمكن تفسيرها بشكل أفضل بنظرية الموجة والبعض الآخر بنظرية الجسيمات) / انقسام ثنائي, ثنائية (كون الشيء ثنائياً؛ تصنيف إلى جزأين أو فئتين فرعيتين متضادتين)\nمثال: الانقسام بين الثقافة الشرقية والغربية",
 "dub": "اِنْتَسَخَ, نَسَخَ / دَبْلَجَ (في المسرح: أحَلَّ مُمَثِّلاً مَحَلَّ اخَر) / داب",
 "dubai": "دُبَيّ (إحدى الإمارات السبع اللاتي يشكلن الإمارات العربية المتحدة؛ المدينة العاصمة لتلك الإمارة، وهي أكثر مدن الإمارات اكتظاظًا بالسكان)\nمثال: هي تسكن في دبي.",
 "dubai chocolate": "شُوكُولَاتَة دُبَيّ",
 "dubber": "مُدَبْلِج / مُدَبْلِجَة",
 "dubbin": "دوبين (شحم ممزوج بالزيت؛ يُستخدم لجعل الجلد ناعماً ومقاوماً للماء)",
 "dubbing": "دَبْلَجَة (دَبْلَجَةُ فِلْمٍ : تَغْيِيرُ لُغَةِ الفِلْمِ الأصْلِيَّةِ إلَى لُغَةٍ أُخْرَى)",
 "dubiety": "ارتياب, شك (حالة عدم التأكد من شيء ما)",
 "dubious": "مَشْكُوك فِيه, مُرْتَاب (مليء بالشكّ وعدم اليقين) / شَاكّ, غَيْر مُقْتَنِع (ليس على اقتناع أو يقين) / مَشْبُوه, مَشْكُوكٌ فِيه (يثير الشكّ أو الريبة)",
 "dubiously": "بِرِيبَة, بِشَكّ (بطريقة مشككة) / بشكل مريب, بشكل مشكوك فيه (بطريقة مشكوك فيها ومريبة)\nمثال: هز جيرالد رأسه بشك",
 "dubiousness": "رِيبَة, شَكّ (عدم اليقين بشأن حقيقة أو واقعية أو وجود شيء ما) / ارتياب, شك (حالة عدم التأكد من شيء ما)\nمثال: الشك في ادعائه",
 "dubitable": "مَشْبُوه, مَشْكُوكٌ فِيه (يثير الشكّ أو الريبة)",
