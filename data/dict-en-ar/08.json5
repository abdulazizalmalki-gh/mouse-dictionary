 "duck": "بَطَّة, بط (نوع من الطيور يسبح في الماء والأنواع البرية منه تهاجر إلى إفريقيا شتاءً؛ العضلة الخلفية في الساق) / بَطَّة (نوع من الطيور يسبح في الماء والأنواع البرية منه تهاجر إلى إفريقيا شتاءً؛ العضلة الخلفية في الساق)\nمثال: إني أصوب على تلك البطة.",
 "duck down": "زَغَبُ البَطّ (ريش البط الناعم)",
 "duck hunter": "صياد البط (صياد البط)",
 "duck hunting": "صيد البط (صيد البط)",
 "duck pate": "باتيه البط (باتيه مصنوع من كبد البط)",
 "duck sauce": "صلصة البط, صلصة هويسين (تابل صيني سميك حلو ولاذع)",
 "duck shot": "خردق الطيور, خردق صيد (خردق رصاصي صغير لخراطيش بنادق الصيد)",
 "duck soup": "أمر سهل, لعب أطفال (أي مشروع يسهل القيام به)\nمثال: تسويق هذا المنتج لن يكون نزهة",
 "duck's egg": "بَطَّة, صِفْر ((في الكريكيت) تسجيل صفر من قبل ضارب الكرة)",
 "duck-billed": "بَطِّيّ المِنْقَار (ذو منقار يشبه منقار البطة)",
 "duck-billed dinosaur": "ديناصور بطي المنقار, هادروصور (أي من العديد من الديناصورات الكبيرة التي تسير على قدمين ولها منقار قرني يشبه منقار البط وأقدام مكففة؛ ربما كانت مائية جزئياً)",
 "duck-billed platypus": "بطي المنقار, خلد الماء (ثديي أحادي المسلك مائي صغير كثيف الفراء من أستراليا وتاسمانيا له منقار عريض وذيل وأقدام مكففة؛ النوع الوحيد في فصيلة خلد الماء)",
 "duckbill": "بَطِّيّ المِنْقَار (ذو منقار يشبه منقار البطة) / بطي المنقار, خلد الماء (ثديي أحادي المسلك مائي صغير كثيف الفراء من أستراليا وتاسمانيا له منقار عريض وذيل وأقدام مكففة؛ النوع الوحيد في فصيلة خلد الماء) / سمكة المجداف (سمكة بدائية في وادي المسيسيبي لها خطم طويل يشبه المجداف)",
 "duckbilled platypus": "بطي المنقار, خلد الماء (ثديي أحادي المسلك مائي صغير كثيف الفراء من أستراليا وتاسمانيا له منقار عريض وذيل وأقدام مكففة؛ النوع الوحيد في فصيلة خلد الماء)",
 "duckboard": "ممشى ألواح (ممشى خشبي يوضع فوق أرض طينية)",
 "duckburg": "مَدِينَة البَطّ",
 "ducking": "تغطيس, غمر (فعل تبليل شيء بغمره) / صيد البط (صيد البط)",
 "ducking stool": "كرسي التغطييس (أداة عقاب تتكون من كرسي يُغمس فيه المخالفون في الماء)",
 "duckling": "فرخ البط (بطة صغيرة) / لحم بط صغير (لحم صغار البط الداجن)",
 "duckpin": "قنيمة قصيرة (قنيمة بولينج قصيرة وممتلئة مقارنة بالقنيمة العشرية)",
 "duckpins": "دكبنس (لعبة بولينغ تستخدم دبابيس أصغر من الدبابيس العشرة ولكنها أعرض نسبياً)",
 "ducks and drakes": "وثب الحجارة (لعبة يتم فيها نط حجر مسطح على سطح ماء هادئ)",
