 "diocese": "أَبْرَشِيَّة",
 "diode": "صِمَام ثُنَائِيّ, ثَنَائِي دِيُود (الصِّمَامُ : السِّدَادُ؛ الصِّمام : جهاز لضبط السوائل والغازات في أَوعيتها وتنظيم انسيابها في اتِّجاه دون آخر)\nمثال: فتح سامر صمام المياه.",
 "diodon holocanthus": "السمكة البالونية (تشبه سمكة النيص ولكنها أصغر حجماً)",
 "diodon hystrix": "سمكة النيص (تنتصب أشواكها عندما ينتفخ الجسم؛ توجد عالمياً في المياه الدافئة)",
 "diodora apertura": "بطلينوس ثقب المفتاح (بطلينوس بحري له صدفة مخروطية مع فتحة في القمة)",
 "dioecian": "ثنائي المسكن, منفصل الجنس (يحتوي على أعضاء تناسلية ذكرية وأنثوية في نباتات أو حيوانات منفصلة)",
 "dioecious": "ثنائي المسكن, منفصل الجنس (يحتوي على أعضاء تناسلية ذكرية وأنثوية في نباتات أو حيوانات منفصلة)",
 "dioestrous": "بَيْنَ شِبْقِيّ ((عن الحيوانات ذات دورات الشبق المتعدّدة) في الفترة بين دورتي شبق متتاليتين)",
 "dioestrual": "بَيْنَ شِبْقِيّ ((عن الحيوانات ذات دورات الشبق المتعدّدة) في الفترة بين دورتي شبق متتاليتين)",
 "diol": "ديول, غليكول (أي من فئة الكحولات التي تحتوي على مجموعتي هيدروكسيل في كل جزيء)",
 "diomedea exulans": "قطرس جوال (قطرس كبير جداً؛ أبيض بأجنحة سوداء عريضة)",
 "diomedea nigripes": "قطرس أسود الرجلين (نوع من القطرس ذو أقدام سوداء)",
 "dionaea muscipula": "خناق الذباب, ديونية (نبات آكل للحوم من السهول الساحلية في كارولينا له نصال أوراق حساسة ذات مفصلات وحواف خشنة تنغلق وتحتجز الحشرات)",
 "dionysia": "باخاناليا, ديونيسيا (مهرجان طقسي في اليونان القديمة تكريماً للإله ديونيسوس (باخوس))",
 "dionysian": "ديونيسي (مكون من أو متعلق بـ أو عابد لديونيسوس)",
 "dioon": "ديون (أي سيكاد من جنس ديون؛ سيكاديات جميلة تشبه النخيل ذات تيجان قوية من الأوراق وجذوع خشنة)",
 "diopter": "ديوبتر (وحدة قياس القوة الانكسارية للعدسة وتساوي مقلوب البعد البؤري مقاسًا بالأمتار)",
 "dioptre": "ديوبتر (وحدة قياس القوة الانكسارية للعدسة وتساوي مقلوب البعد البؤري مقاسًا بالأمتار)",
 "diorama": "بانوراما, مشهد شامل (صورة (أو سلسلة صور) تمثل مشهداً مستمراً)",
 "diorite": "ديوريت (صخر ناري متطفل بلوري حبيبي)",
 "dioscorea alata": "يام أبيض, يام الماء (يزرع في أسترالاسيا وبولينيزيا لجذره الكبير ذو اللحم الأبيض الناعم الصالح للأكل)",
 "dioscorea batata": "كرمة القرفة, يام صيني (كرمة صينية قوية التحمل متوطنة في الولايات المتحدة وتزرع كمتسلقة زينة لأوراقها اللامعة على شكل قلب برائحة القرفة وفي المناطق الاستوائية لدرناتها…)",
 "dioscorea bulbifera": "بطاطس الهواء (يام من أفريقيا الاستوائية وآسيا يزرع لدرناته الكبيرة)",
 "dioscorea elephantipes": "ديسقوريا الفيل, قدم الفيل (كرمة من جنوب أفريقيا لها ساق جذري ضخم مغطى بلحاء عميق التشقق)",
 "dioscorea paniculata": "يام بري (نبات له جذمور كان يُجفف سابقاً ويستخدم لعلاج الروماتيزم أو اضطرابات الكبد)",
 "dioscorea trifida": "كوش كوش (يام أمريكي استوائي ذو درنات صفراء صغيرة صالحة للأكل)",
 "diospyros ebenum": "أبنوس, شجرة الأبنوس (شجرة استوائية من جنوب آسيا ذات خشب قلب داكن صلب يستخدم في صناعة الخزائن)",
 "diospyros kaki": "خرمة يابانية, كاكي (شجرة آسيوية صغيرة نفضية تحمل فاكهة كبيرة حمراء أو برتقالية صالحة للأكل قابضة)",
 "diospyros kurzii": "خشب الرخام, ديوسبيروس كورزي (شجرة آسيوية كبيرة ذات خشب مخطط صلب رخامي)",
 "diospyros lotus": "تمر البرقوق, خرمة اللوتس (شجرة خرمة آسيوية تزرع لفاكهتها الصغيرة الصفراء أو السوداء الأرجوانية الصالحة للأكل والتي تقدرها القبائل الأفغانية كثيراً)",
 "diospyros virginiana": "خرمة أمريكية (شجرة متوسطة الحجم في الغابات الجافة في جنوب وشرق الولايات المتحدة تحمل فاكهة صفراء أو برتقالية قابضة جداً تكون صالحة للأكل عندما تنضج تماماً)",
 "diovan": "ديوفان, فالسارتان (مثبط للأنجيوتنسين 2 يستخدم لعلاج ارتفاع ضغط الدم)",
 "dioxide": "ثاني أكسيد (أكسيد يحتوي على ذرتين من الأكسجين في الجزيء)",
 "dioxin": "ديوكسين (أي من عدة هيدروكربونات سامة أو مسرطنة توجد كشوائب في مبيدات الأعشاب)",
 "dip": "غَمَس / غَمَر (الغَمْرُ: الماء الكثير؛ الغَمْرُ من الماء: خِلاف الضَّحْل، وهو الذي يعلو مَن يدخله ويغطِّيه، وفي الحديث) / غَطَسَ",
 "dip circle": "مقياس الميل المغناطيسي (أداة قياس لقياس زاوية الميل المغناطيسي (كما هو الحال من طائرة))",
 "dip switch": "مفتاح الحزمة المزدوجة ((علم الحاسوب) واحد من مجموعة مفاتيح تشغيل/إيقاف صغيرة مثبتة في أجهزة الكمبيوتر؛ تستخدم بدلاً من الوصلات لتهيئة الجهاز للمستخدم)",
 "diphenhydramine": "بينادريل, ديفينهيدرامين (مضاد للهيستامين (الاسم التجاري بينادريل) يستخدم لعلاج تفاعلات الحساسية التي تشمل الممرات الأنفية (حمى القش) وكذلك لعلاج دوار الحركة)",
 "diphenylbutyl piperidine": "ثنائي فينيل بوتيل بيبيريدين (مجموعة من الأدوية المضادة للذهان تستخدم بشكل رئيسي في علاج الفصام)",
 "diphenylhydantoin": "ديلانتين, فينيتوين (دواء مضاد للاختلاج (الاسم التجاري ديلانتين) يستخدم لعلاج الصرع وهو ليس مهدئاً)",
 "diphtheria": "خُنَاق",
 "diphthong": "مُصَوِّت مُزْدَوِج",
 "diphylla ecaudata": "خفاش مصاص الدماء مشعر الساقين (يشبه الخفاش مصاص الدماء الشائع في الحجم والعادات؛ من أمريكا الاستوائية بما في ذلك جنوب كاليفورنيا وتكساس)",
 "dipladenia boliviensis": "ديبلادينيا بيضاء, مانديفيلا (نبات متسلق شجيري ذو أوراق لامعة وأزهار بيضاء قمعية الشكل ذات حلق أصفر)",
 "diplazium pycnocarpon": "سرخس الفسحة, طحال فضي (سرخس من أمريكا الشمالية بسعف ضيق على أعناق صفراء)",
 "diplegia": "شلل مزدوج (شلل في الأجزاء المتقابلة على جانبي الجسم)",
 "diplococcus": "مكورة مزدوجة (بكتيريا موجبة الجرام توجد عادة في أزواج)",
 "diplococcus pneumoniae": "مكورة رئوية (بكتيريا تسبب الالتهاب الرئوي في الفئران والبشر)",
 "diplodocus": "ديبلودوكس (حيوان عاشب ضخم رباعي الأرجل ذو رقبة وذيل طويلين؛ من العصر الجوراسي المتأخر في غرب أمريكا الشمالية)",
 "diploe": "خِلَال اللَّوْحَتَيْن",
 "diploic vein": "وريد ضعفاني (واحد من الأوردة التي تخدم الجزء الإسفنجي من عظام القحف)",
 "diploid": "ثنائي الصيغة الصبغية (لخلية أو كائن حي يحتوي على مجموعتين من الكروموسومات أو ضعف العدد الأحادي) / ثنائي الصيغة الصبغية ((في علم الوراثة) كائن أو خلية تحتوي على الكمية الطبيعية من الحمض النووي لكل خلية؛ أي مجموعتين من الكروموسومات أو ضعف العدد الأحادي)\nمثال: خلايا جسدية ثنائية الصيغة الصبغية",
 "diploidy": "ثنائية الصيغة الصبغية (حالة كون الكائن ثنائي الصيغة الصبغية)",
 "diploma": "شَهَادَة, دِبْلُوم",
 "diplomacy": "دِبْلُومَاسِيَّة",
 "diplomat": "دِبْلُومَاسِيّ, دِبْلُومَاسِيَّة",
 "diplomate": "دبلوماسي طبي, طبيب مُجاز (أخصائي طبي تم اعتماد كفاءته بشهادة تمنحها مجموعة مهنية مناسبة)",
 "diplomatic": "دِبْلُومَاسِيّ",
 "diplomatic building": "مبنى دبلوماسي (مبنى حكومي يعيش أو يعمل فيه الدبلوماسيون)",
 "diplomatic corps": "الخدمة الدبلوماسية, سلك دبلوماسي (هيئة الموظفين الدبلوماسيين)",
 "diplomatic immunity": "حصانة دبلوماسية (الإعفاء من الضرائب أو الإجراءات القانونية العادية الذي يُمنح للموظفين الدبلوماسيين في بلد أجنبي)",
 "diplomatic minister": "وزير دبلوماسي (دبلوماسي يمثل حكومة لدى أخرى؛ رتبته أقل من سفير)",
 "diplomatic mission": "بعثة دبلوماسية (بعثة تخدم أهدافاً وغايات دبلوماسية)",
 "diplomatic negotiations": "دبلوماسية, مفاوضات دبلوماسية (تفاوض بين الدول)",
 "diplomatic pouch": "حقيبة دبلوماسية (حقيبة بريد مغلقة بإحكام تُستخدم لنقل المراسلات بين البعثة الدبلوماسية ومكتبها الرئيسي)",
 "diplomatic service": "الخدمة الدبلوماسية, سلك دبلوماسي (هيئة الموظفين الدبلوماسيين)",
 "diplomatical": "دبلوماسي, لبق (يستخدم أو يتميز باللباقة في التعامل مع الأمور الحساسة أو الناس)\nمثال: تجنبت المضيفة مواجهة بتغيير دبلوماسي للموضوع",
 "diplomatically": "دبلوماسياً (بدبلوماسية)\nمثال: أجاب دبلوماسياً جداً",
 "diplomatics": "علم الوثائق (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "diplomatist": "دبلوماسي (مسؤول منخرط في المفاوضات الدولية)",
 "diplopia": "رؤية مزدوجة, شفع (ضعف بصري يُرى فيه الجسم كجسمين)\nمثال: غالباً ما يختفي الشفع عند تغطية إحدى العينين",
 "diplopterygium longissimum": "سرخس متسلق عملاق (سرخس متسلق كبير يشكل بقعاً كبيرة يصل ارتفاعها إلى 18 قدماً؛ منطقة المحيط الهادئ والصين)",
 "diplotaxis erucoides": "جرجير أبيض, ديبلوتاكسيس أبيض (من منطقة البحر الأبيض المتوسط؛ عشب ضار مستوطن في جميع أنحاء جنوب أوروبا)",
 "diplotaxis muralis": "جرجير الجدار, ديبلوتاكسيس (نبات أوروبي أصفر الزهر ينمو على الجدران القديمة وفي الأماكن المهملة؛ عشب ضار وافد في أمريكا الشمالية)",
 "diplotaxis tenuifolia": "جرجير الجدار, ديبلوتاكسيس (نبات أوروبي أصفر الزهر ينمو على الجدران القديمة وفي الأماكن المهملة؛ عشب ضار وافد في أمريكا الشمالية)",
 "diplotene": "ديبلوتين, طور تضاعفي (المرحلة الرابعة من الطور التمهيدي للانقسام المنصف)",
 "dipodomys ordi": "جرذ كانغرو أورد (أكثر أنواع جرذان الكنغر انتشاراً: يعيش في السهول والمناطق الجبلية بوسط وغرب الولايات المتحدة)",
 "dipodomys phillipsii": "جرذ الصحراء, جرذ كنغري (أي من القوارض القافزة المتنوعة في المناطق الصحراوية في أمريكا الشمالية والمكسيك؛ أكبر أعضاء فصيلة الفئران المتغايرة)",
 "dipogon lignosus": "بازلاء أسترالية, ديبوغون (كرمة خشبية جزئياً دائمة الخضرة من جنوب أفريقيا تزرع لعناقيدها من الزهور الأرجوانية الوردية تليها قرون صالحة للأكل مثل الفاصوليا الخضراء؛ تزرع أيضاً…)",
 "dipolar": "ثنائي القطب (له شحنات كهربائية متضادة ومتساوية أو أقطاب مغناطيسية ذات إشارات متعاكسة مفصولة بمسافة صغيرة)",
 "dipole": "هوائي ثنائي القطب (هوائي طوله نصف طول موجة يتكون من قضيبين متصلين بخط نقل في المنتصف) / ثنائي القطب (زوج من الشحنات الكهربائية أو الأقطاب المغناطيسية المتساوية والمتضادة يفصل بينها مسافة صغيرة)",
 "dipole antenna": "هوائي ثنائي القطب (هوائي طوله نصف طول موجة يتكون من قضيبين متصلين بخط نقل في المنتصف)",
 "dipole molecule": "جزيء ثنائي القطب (جزيء يعتبر ثنائي قطب دائم)",
 "dipole moment": "عزم ثنائي القطب (عزم ثنائي القطب)",
 "dipped": "أَهْدَل الظَّهْر, مُتَقَعِّرُ الظَّهْر (يُعَانِي مِنْ تَقَعُّرٍ غَيْرِ طَبِيعِيٍّ فِي العَمُودِ الفِقَرِيِّ (خَاصَّةً فِي الخَيْلِ))",
 "dipped-beam headlamp": "ضوء التلاقي, ضوء منخفض (مصباح أمامي منخفض الشعاع (يُسمى أيضاً ضوء المرور أو التلاقي) يوفر توزيعاً للضوء لإعطاء إضاءة أمامية وجانبية كافية دون إبهار مستخدمي الطريق الآخرين…)",
 "dippel's oil": "زيت العظام (زيت داكن اللون كريه الرائحة يتم الحصول عليه بتفحيم العظام؛ يُستخدم خاصة في محاليل تغطيس الأغنام وفي تغيير طبيعة الكحول)",
 "dipper": "دج الماء, غطاس (طائر غواص صغير ممتلئ الجسم بدون أقدام مكففة؛ يتردد على الجداول سريعة التدفق ويتغذى على طول القاع) / بطة برأس الجاموس (بطة غواصة صغيرة من أمريكا الشمالية؛ الذكور لديهم ريش رأس كثيف) / كيلة, مغرفة (مغرفة لها كوب ومقبض طويل)",
 "dippers": "كنيسة الإخوة (طائفة معمدانية أسسها أمريكيون من أصل ألماني عام 1708؛ عارضت الخدمة العسكرية وأداء القسم القانوني؛ مارست المعمودية الثلاثية بالتغطيس)",
 "dipsacus fullonum": "ديبساق, مشط الراعي الشائع (نبات مشط الراعي بزهور ليلكية موطنه العالم القديم ولكن تم توطينه في أمريكا الشمالية؛ تستخدم رؤوس الزهور المجففة لرفع الوبر على القماش الصوفي)",
 "dipsacus sativus": "ديبساق, مشط الراعي المزروع (يشبه مشط الراعي الشائع ويستخدم بالمثل؛ واسع الانتشار في أوروبا وشمال إفريقيا وغرب آسيا؛ تم توطينه في الولايات المتحدة)",
 "dipsacus sylvestris": "ديبساق حرجي, مشط الراعي البري (مشط راعي أوروبي بزهور بيضاء إلى وردية؛ تم توطينه في الولايات المتحدة)",
 "dipsomania": "إدمان الكحول, ديبسومانيا (رغبة شديدة ومستمرة في شرب المشروبات الكحولية بإفراط)",
 "dipsomaniac": "كحولي, مدمن كحول (شخص يشرب الكحول بإفراط وبشكل اعتيادي)",
 "dipsosaurus dorsalis": "إغوانة صحراوية (سحلية صغيرة طويلة الذيل من المناطق القاحلة في جنوب غرب الولايات المتحدة وشمال غرب المكسيك)",
 "dipstick": "عصا قياس (قضيب مدرج يُغمس في حاوية للإشارة إلى مستوى السائل)",
 "dipteran": "ثنائيات الأجنحة (حشرات لها عادة زوج واحد من الأجنحة الوظيفية (الزوج الأمامي) مع اختزال الزوج الخلفي إلى هياكل صغيرة تشبه المقبض وأجزاء فم مهيأة للمص أو اللعق أو الثقب)",
 "dipterocarp": "مجناح الثمر (شجرة من العائلة مجناحية الثمر)",
 "dipteron": "ثنائيات الأجنحة (حشرات لها عادة زوج واحد من الأجنحة الوظيفية (الزوج الأمامي) مع اختزال الزوج الخلفي إلى هياكل صغيرة تشبه المقبض وأجزاء فم مهيأة للمص أو اللعق أو الثقب)",
 "dipterous": "ثنائي الجناح",
 "dipterous insect": "ثنائيات الأجنحة (حشرات لها عادة زوج واحد من الأجنحة الوظيفية (الزوج الأمامي) مع اختزال الزوج الخلفي إلى هياكل صغيرة تشبه المقبض وأجزاء فم مهيأة للمص أو اللعق أو الثقب)",
 "dipteryx odorata": "شجرة التونكا, فول التونكا (شجرة طويلة في أمريكا الجنوبية الاستوائية لها قرون لبية بيضاوية الشكل تحتوي على بذور سوداء عطرية تشبه اللوز تستخدم للنكهة)",
 "diptote": "مَمْنُوع مِنَ الصَّرْف, غَيْر مُنْصَرِف",
 "diptych": "ديبرتيك, لوحة ثنائية (لوحة أو نحت (خاصة كقطعة مذبح) على لوحين (عادة ما تكون مفصلية مثل الكتاب))",
 "dipylon": "ديبيلوني (من أو يتعلق ببوابة الديبيلون غرب أثينا القديمة)",
