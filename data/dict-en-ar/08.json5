 "durion": "دوريان, شجرة الدوريان (شجرة في جنوب شرق آسيا ذات ثمار بيضاوية صالحة للأكل بقشرة شائكة صلبة)",
 "durmast": "بلوط صخري, سنديان لاطئ (سنديان أوروبي نفضي يُقدر لخشبه القوي والمرن)",
 "durometer": "مقياس الصلادة, مقياس القساوة (أداة لقياس درجة الصلابة؛ خاصة أداة لاختبار الصلابة النسبية لقضبان الصلب وما شابه)\nمثال: غالباً ما يستخدم مصطلح مقياس الصلادة للإشارة إلى القياس وكذلك الأداة نفسها",
 "durra": "درة, ذرة بيضاء (سورغم المناطق الجافة في آسيا وشمال أفريقيا)",
 "durrës": "دُرَاج, دُرَاس",
 "durum": "قمح المعكرونة, قمح ديورم (قمح ذو حبات صلبة داكنة اللون غنية بالغلوتين ويستخدم للخبز والمعكرونة؛ يزرع خاصة في جنوب روسيا وشمال أفريقيا وشمال وسط أمريكا الشمالية)",
 "durum wheat": "قمح المعكرونة, قمح ديورم (قمح ذو حبات صلبة داكنة اللون غنية بالغلوتين ويستخدم للخبز والمعكرونة؛ يزرع خاصة في جنوب روسيا وشمال أفريقيا وشمال وسط أمريكا الشمالية)",
 "dushanbe": "دُوشَنْبِه",
 "dusicyon cancrivorus": "ثعلب آكل السرطان, كلب آكل السرطان (كلب بري من شمال أمريكا الجنوبية)",
 "dusk": "عِشَاء, غَسَق (طَعَام العَشِيّ. وهو الطعام الذي يؤكل في المَسَاء) / يَغْسِق, يَعْتِم\nمثال: هل العشاء جاهز؟",
 "duskiness": "سمرة داكنة (بشرة سمراء داكنة) / خفوت, عتمة (حالة ضعف الإضاءة)",
 "dusky": "أَسْمَر البَشَرَة, دَاكِن البَشَرَة (ذو بشرة داكنة بطبيعتها) / شَفَقِيّ, مُتَلَأْلِئ بِنُور الغُرُوب (مُضَاء بِنُور الشَّفَق أَوْ كَأَنَّهُ كَذَلِك)",
 "dusky salamander": "سمندل داكن (سمندل شائع في أمريكا الشمالية مبقع باللون البني الباهت أو الأسود الرمادي)",
 "dusky shark": "قرش ترابي (قرش أزرق رمادي نحيل نسبياً؛ يوجد تقريباً في جميع أنحاء العالم في المياه الاستوائية والمعتدلة)",
 "dusky-colored": "دَاكِن اللَّوْن (ذو لون داكن أو قاتم)",
 "dusky-coloured": "دَاكِن اللَّوْن (ذو لون داكن أو قاتم)",
 "dusky-footed wood rat": "جرذ الخشب داكن القدمين (جرذ خشب ذو أقدام داكنة)",
 "dusky-footed woodrat": "جرذ الخشب داكن القدمين (مضيف لقراد داء لايم في شمال كاليفورنيا)",
 "dust": "غُبَار (التراب الناعم الدقيق الجاف. ويقال أيضا غَبَرَة وغَبْرَة؛ \"في الجو غُبَارٌ\" ، أي فيه تراب ناعم) / تراب / غُبار (التراب الناعم الدقيق الجاف. ويقال أيضا غَبَرَة وغَبْرَة؛ \"في الجو غُبَارٌ\" ، أي فيه تراب ناعم) / تُراب / غبار (التراب الناعم الدقيق الجاف. ويقال أيضا غَبَرَة وغَبْرَة؛ \"في الجو غُبَارٌ\" ، أي فيه تراب ناعم)\nمثال: أزل الغبار عن المرآة.",
 "dust bag": "كيس الغبار, كيس المكنسة (كيس يتم شفط الأوساخ إليه بواسطة المكنسة الكهربائية)",
 "dust bowl": "منطقة العواصف الغبارية (منطقة معرضة للعواصف الغبارية؛ خاصة المنطقة الوسطى من الولايات المتحدة التي تعرضت لعواصف غبارية في الثلاثينيات)",
 "dust cloud": "سحابة غبار (سحابة من الغبار معلقة في الهواء)",
 "dust coat": "مريول, معطف واق من الغبار (رداء شامل فضفاض (معطف أو ثوب) يصل إلى الكاحلين)",
 "dust contamination": "تلوث غباري (فعل التلويث بجزيئات الغبار) / تلوث بالغبار (حالة كونه ملوثاً بالغبار)",
 "dust cover": "غطاء الغبار (غطاء واقٍ بلاستيكي قابل للإزالة لقطعة من المعدات) / غطاء غبار (قطعة كبيرة من القماش تستخدم لتغطية الأثاث الذي لا يستخدم لفترة طويلة) / غلاف الكتاب الورقي (غلاف ورقي للكتاب؛ غلاف تطبع عليه عادة معلومات ترويجية)",
 "dust devil": "زوبعة غبارية, عفريت الغبار (دوامة هوائية مصغرة قوية بما يكفي لرفع الغبار والأوراق والنفايات في الهواء)",
 "dust jacket": "غلاف الكتاب الورقي (غلاف ورقي للكتاب؛ غلاف تطبع عليه عادة معلومات ترويجية)",
 "dust mop": "ممسحة غبار جافة (ممسحة جافة لتنظيف الغبار عن الأرضيات)",
 "dust sheet": "غطاء غبار (قطعة كبيرة من القماش تستخدم لتغطية الأثاث الذي لا يستخدم لفترة طويلة)",
 "dust storm": "سيروكو, عاصفة رملية (عاصفة ريحية ترفع سحباً من الغبار أو الرمل)\nمثال: كانت نوعاً من العواصف الغبارية لم نشهده منذ سنوات",
 "dust wrapper": "غلاف الكتاب الورقي (غلاف ورقي للكتاب؛ غلاف تطبع عليه عادة معلومات ترويجية)"
}
