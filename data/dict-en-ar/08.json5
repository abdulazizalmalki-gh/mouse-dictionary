 "die": "مَاتَ (للحَيّ: فقد الحَيَاة. مصدره مَوتَا ومِيتَة؛ للأرض: ليس فيها شيء حَيّ من النبات أو الحيوان أو الإنسان. مصدره مَوَات) / تُوُفِّيَ / زَهْر اَلطَّاوِلَة, زَهْر اَلنَّرْد ((زَهَرَ) الوجهُ والسراجُ والقمرُ يَزْهُرُ زَهْرًا، وزُهُوراً: تلألأ وأشْرق؛ (زَهَرَ) الشيءُ: صَفا لونُه)\nمثال: إعتقدت أنه مات.",
 "die out": "اِنْقَرَضَ",
 "die-cast": "مَسْبُوك بِالقَالَب (مُشَكَّل بضغط المعدن المُنصهر في قالب)",
 "die-sinker": "صانع القوالب (شخص يصنع القوالب (للسك أو التشكيل))",
 "dieback": "موت رجعي (مرض نباتي يتميز بالموت التدريجي للبراعم الصغيرة بدءاً من الأطراف وانتهاءً بالفروع الأكبر)",
 "dieffenbachia sequine": "ديفنباخيا, نبات الخرس (نبات دائم الخضرة بأوراق خضراء داكنة كبيرة ومبهرجة؛ يحتوي على سم يسبب تورم اللسان والحلق ومن هنا جاء الاسم)",
 "diego": "دَيَيغُو",
 "diegueno": "لغة كاميا (اللغة اليومية التي يتحدث بها شعب كاميا) / ديغوينو (فرد من شعب هندي في أمريكا الشمالية في جنوب كاليفورنيا)",
 "diegueno language": "لغة كاميا (اللغة اليومية التي يتحدث بها شعب كاميا)",
 "diehard": "تقليدي (من يلتزم بالآراء التقليدية)",
 "dielectric": "عازل, مادة عازلة (مادة مثل الزجاج أو الخزف ذات موصلية كهربائية أو حرارية مهملة)",
 "dielectric heating": "تسخين عازل (تسخين عازل بواسطة مجال كهربائي عالي التردد)",
 "dielectrolysis": "رحلان كهربائي (حركة الجسيمات المشحونة في مادة غروانية تحت تأثير مجال كهربائي؛ حيث تتجه الجسيمات ذات الشحنة الموجبة إلى الكاثود والسالبة إلى الأنود)",
 "diemaker": "صانع القوالب (شخص يصنع القوالب (للسك أو التشكيل))",
 "diencephalon": "دماغ بيني (القسم الخلفي من الدماغ الأمامي؛ يربط نصفي الكرة المخية بالدماغ المتوسط)",
 "dieresis": "ديايريسيس, نقطتا الفصل (علامة تشكيل (نقطتان) توضع فوق حرف متحرك للإشارة إلى أنه لا يشكل إدغاماً مع حرف متحرك مجاور)",
 "diervilla lonicera": "ديرفيلا, عسلة الشجيرة (شجيرة منتشرة في شمال شرق الولايات المتحدة لها عناقيد صغيرة من الزهور الخضراء والصفراء العطرة)",
 "diervilla sessilifolia": "عسلة الشجيرة الجنوبية (عسلة شجيرية من جنوب شرق الولايات المتحدة لها عناقيد كبيرة مزدحمة من الزهور الصفراء الكبريتية)",
 "diesel": "دِيزَل, دِيزِل",
 "diesel engine": "محرك ديزل (اسم فاعل من حَرَّكَ؛ اسم آلة)\nمثال: المحرك لا يعمل.",
 "diesel fuel": "زيت الديزل, وقود الديزل (زيت معدني ثقيل يستخدم كوقود في محركات الديزل)",
 "diesel hammer": "مطرقة خوازيق ديزل, مطرقة ديزل (جهاز لدق الخوازيق يتكون من محرك ديزل كبير ثنائي الأشواط)",
 "diesel locomotive": "قاطرة ديزل (قاطرة تعمل بمحرك ديزل)",
 "diesel motor": "محرك ديزل (محرك احتراق داخلي يحرق الزيت الثقيل (وقود الديزل))",
 "diesel oil": "زيت الديزل, وقود الديزل (زيت معدني ثقيل يستخدم كوقود في محركات الديزل)",
 "diesel pile hammer": "مطرقة خوازيق ديزل, مطرقة ديزل (جهاز لدق الخوازيق يتكون من محرك ديزل كبير ثنائي الأشواط)",
 "diesel-electric": "قاطرة ديزل كهربائية (قاطرة تعمل بالتيار الكهربائي الناتج عن محرك ديزل)",
 "diesel-electric locomotive": "قاطرة ديزل كهربائية (قاطرة تعمل بالتيار الكهربائي الناتج عن محرك ديزل)",
 "diesel-hydraulic": "قاطرة ديزل هيدروليكية (قاطرة تعمل بنظام نقل هيدروليكي مدعوم بمحرك ديزل)",
 "diesel-hydraulic locomotive": "قاطرة ديزل هيدروليكية (قاطرة تعمل بنظام نقل هيدروليكي مدعوم بمحرك ديزل)",
 "diesinker": "صانع القوالب (شخص يصنع القوالب (للسك أو التشكيل))",
 "diesis": "خنجر مزدوج (حرف يُستخدم في الطباعة للإشارة إلى مرجع ثالث أو حاشية سفلية بعد استخدام النجمة والخنجر)",
 "diestock": "حامل لقمة القلاووظ, مقبض لقمة اللولبة (جهاز يحمل القوالب التي تقطع اللوالب الخارجية على الأسطوانات المعدنية)",
 "diestrous": "بَيْنَ شِبْقِيّ ((عن الحيوانات ذات دورات الشبق المتعدّدة) في الفترة بين دورتي شبق متتاليتين)",
 "diestrual": "بَيْنَ شِبْقِيّ ((عن الحيوانات ذات دورات الشبق المتعدّدة) في الفترة بين دورتي شبق متتاليتين)",
 "diestrum": "بين الشبقين, فترة اللاشبق ((للحيوانات التي لديها دورات شبق متعددة في موسم تكاثر واحد) حالة أو فترة من الخمول الجنسي أو السكون بين فترات النشاط)",
 "diestrus": "بين الشبقين, فترة اللاشبق ((للحيوانات التي لديها دورات شبق متعددة في موسم تكاثر واحد) حالة أو فترة من الخمول الجنسي أو السكون بين فترات النشاط)",
 "diet": "حِمْيَة, حِمْيَة غِذَائِيَّة / حِمْيَة, نِظَام غِذَائِيّ / بَرْلَمَان, مَجْلِس",
 "dietary": "حميوي, غذائي (متعلق بالنظام الغذائي) / حصة غذائية, مخصص غذائي (مخصص غذائي يومي منظم)\nمثال: قيود غذائية",
 "dietary supplement": "مكمل غذائي (شيء يضاف لإكمال النظام الغذائي أو لتعويض نقص غذائي)",
 "dieter": "مُتَّبِع حِمْيَة (شخص يتبع نظاماً غذائياً (حمية))",
 "dietetic": "حميوي, غذائي (متعلق بالنظام الغذائي)\nمثال: قيود غذائية",
 "dietetical": "حميوي, غذائي (متعلق بالنظام الغذائي)\nمثال: قيود غذائية",
 "dietetics": "علم الحمية, نظام غذائي (الدراسة العلمية لإعداد الطعام وتناوله)",
 "diethyl ether": "إيثر (سائل متطاير عديم اللون وشديد الاشتعال كان يستخدم سابقاً كمخدر استنشاقي)",
 "diethylaminoethyl cellulose": "ثنائي إيثيل أمينو إيثيل سليلوز (يُستخدم للكروماتوغرافيا)",
 "diethylbarbituric acid": "باربيتال, فيرونال (باربيتورات يستخدم كمنوم)",
 "diethylmalonylurea": "باربيتال, فيرونال (باربيتورات يستخدم كمنوم)",
 "diethylstilbesterol": "ثنائي إيثيل ستيلبوستيرول (مادة اصطناعية غير ستيرويدية لها خصائص الإستروجين؛ كانت تستخدم سابقاً لعلاج مشاكل الدورة الشهرية)",
 "diethylstilbestrol": "ثنائي إيثيل ستيلبوستيرول (إستروجين قوي يستخدم في الطب وفي علف الماشية والدواجن)",
 "diethylstilboestrol": "ثنائي إيثيل ستيلبوستيرول (إستروجين قوي يستخدم في الطب وفي علف الماشية والدواجن)",
 "dietician": "أخصائي تغذية, أخصائي حميات (متخصص في دراسة الأنظمة الغذائية والتغذية)",
 "dieting": "حمية, ريجيم (فعل تقييد تناول الطعام)",
 "dietitian": "أخصائي تغذية, أخصائي حميات (متخصص في دراسة الأنظمة الغذائية والتغذية)",
 "differ": "اِخْتَلَفَ (ضد اِتَّفَقَ، كانوا على خِلاف مع بعض أو ذوو آراء مُخْتَلِفَة؛ إلى المكان: كرر الذهاب إلى إليه مرة بعد مرة)\nمثال: أنا اختلف معك في الرأي.",
 "difference": "فَرْق, اِخْتِلَاف / فَرْق, فُرُوق / خِلاف, خِلافات / فَرْق / مَيَّزَ",
 "difference limen": "عتبة الفارق, عتبة تفاضلية (أصغر تغيير في التحفيز يمكن للشخص اكتشافه)",
 "difference of opinion": "خلاف, صراع (خلاف أو جدال حول أمر مهم)\nمثال: كان لديه نزاع مع زوجته",
 "difference threshold": "عتبة الفارق, عتبة تفاضلية (أصغر تغيير في التحفيز يمكن للشخص اكتشافه)",
 "different": "مُخْتَلِف / آٰخَر (ضد الأوَّل؛ وهو من يكون ترتيبه بعد الجميع؛ الشيء: مؤخرّه، الجزء الآخير منه)\nمثال: أرني مثالا آخر.",
 "differentia": "سِمَة مُمَيِّزَة, فَصْل نَوْعِيّ (خصائص مميزة (خاصة في الأنواع المختلفة لنفس الجنس))",
 "differentiable": "قَابِلٌ لِلتَّمْيِيزِ (يُمْكِنُ إِدْرَاكُهُ بِاعْتِبَارِهِ مُخْتَلِفًا) / قابل للاشتقاق, قابل للتفاضل (يمتلك معاملاً تفاضلياً أو مشتقة)",
 "differential": "تفاضلي, فارقي (متعلق بـ أو يظهر فرقاً واختلافاً) / تفاضلي (ينطوي على أو يحتوي على مشتق واحد أو أكثر (في الرياضيات)) / ترس تفاضلي, دفرنس (ترس مخروطي يسمح بتدوير عمودين بسرعات مختلفة؛ يستخدم في المحور الخلفي للسيارات للسماح للعجلات بالدوران بسرعات مختلفة عند المنعطفات) / عَامِل تَفَاضُل, فَارِق (صفة تميز بين الأشياء المتشابهة)\nمثال: معاملة تفاضلية",
 "differential analyzer": "محلل تفاضلي (حاسوب تناظري مصمم لحل المعادلات التفاضلية)",
 "differential blood count": "تعداد الدم التفريقي (عد عدد أنواع محددة من خلايا الدم البيضاء الموجودة في 1 ملليمتر مكعب من الدم)",
 "differential calculus": "حساب التفاضل (جزء التفاضل والتكامل الذي يتعامل مع تغير الدالة بالنسبة للتغيرات في المتغير المستقل)",
 "differential coefficient": "دالة مشتقة, مشتقة (نتيجة التفاضل الرياضي؛ التغيير اللحظي لكمية بالنسبة لأخرى)",
 "differential cost": "تكلفة تزايدية, تكلفة حدية (الزيادة أو النقصان في التكاليف نتيجة لوحدة إنتاج واحدة أكثر أو أقل)",
 "differential diagnosis": "تشخيص تفريقي (طريقة منهجية لتشخيص اضطراب يفتقر إلى أعراض أو علامات فريدة)",
 "differential equation": "معادلة تفاضلية (معادلة تحتوي على تفاضلات دالة ما)",
 "differential gear": "ترس تفاضلي, دفرنس (ترس مخروطي يسمح بتدوير عمودين بسرعات مختلفة؛ يستخدم في المحور الخلفي للسيارات للسماح للعجلات بالدوران بسرعات مختلفة عند المنعطفات)",
 "differential limen": "عتبة الفارق, عتبة تفاضلية (أصغر تغيير في التحفيز يمكن للشخص اكتشافه)",
 "differential psychology": "علم النفس الفارق (فرع علم النفس الذي يدرس الفروق القابلة للقياس بين الأفراد)",
 "differential threshold": "عتبة الفارق, عتبة تفاضلية (أصغر تغيير في التحفيز يمكن للشخص اكتشافه)",
 "differentially": "بِشَكْل تَفَاضُلِيّ, بِشَكْل مُتَبَايِن (بطريقة تفاضلية)\nمثال: وجد هوبل وويزل خلايا تستجيب بشكل تفاضلي وفقاً للاتجاه الذي يتحرك فيه المحفز عبر الشبكية",
 "differentiate": "فَرَّقَ",
 "differentiated": "متباين, متمايز (أصبح مختلفاً (خاصة في سياق التطور) أو تبين أنه مختلف) / مُتَمَايِز (يُظهر تخصّصًا بيولوجيًّا؛ تكيّف أثناء النموّ لوظيفة معيّنة)\nمثال: العلامات المتمايزة للفراشات",
 "differentiation": "تفاضل (العملية الرياضية للحصول على مشتق دالة) / اختلاف, تمايز (التمييز بين الأشياء على أنها مختلفة ومتميزة بناءً على خصائصها أو سماتها) / تخصص, تمايز ((في الأحياء) التكيف الهيكلي لجزء من الجسم لوظيفة معينة)\nمثال: من الضروري التمييز بين الحب والافتتان",
 "differentiator": "فَاصِل, مُمَيِّز (شخص (أو شيء) يميز أو يفرق)",
 "differently": "بشكل مختلف, خلاف ذلك (بطريقة أخرى ومختلفة)\nمثال: قريباً جداً ستعرف خلاف ذلك",
 "difficult": "صَعْب",
 "difficultness": "صعوبة, مشقة (صفة كون الشيء شبه مستعصٍ على التعامل معه ويتطلب جهداً كبيراً لتحقيق نتيجة إيجابية)\nمثال: اتفقوا حول صعوبة التسلق",
 "difficulty": "صُعُوبَة",
 "diffidence": "تردد, عدم الثقة بالنفس (انعدام الثقة بالنفس)",
 "diffident": "خَجُول, غَيْر وَاثِق (يفتقر إلى الثقة بالنفس) / خَجُولٌ, مُتَوَارٍ (يُظهر تحفظاً متواضعاً)\nمثال: وقف في المدخل متردداً وخجلاً",
 "diffidently": "بِتَحَفُّظ, بِخَجَل (بطريقة خجولة)\nمثال: 'أوه، حسناً'، هز كتفيه بخجل، 'أنا أحب العمل'",
 "difflugia": "ديفلوجيا (أوالي له صدفة بيضاوية من حبيبات الرمل الملتحمة)",
 "diffraction": "حيود (عندما يمر الضوء بحواف حادة أو يمر عبر شقوق ضيقة تنحرف الأشعة وتنتج أهداباً من نطاقات الضوء والظلام)",
 "diffraction grating": "محزز حيود (جهاز بصري يتكون من سطح به العديد من الأخاديد المتوازية؛ يشتت شعاع الضوء (أو الإشعاع الكهرومغناطيسي الآخر) إلى أطواله الموجية لإنتاج طيفه)",
 "diffuse": "مُبَعْثَر, مُنْتَشِر (مُمْتَدٌّ عَلَى مِسَاحَةٍ وَاسِعَةٍ؛ غَيْرُ مُتَمَرْكِزٍ فِي مَكَانٍ وَاحِدٍ) / فَضْفَاض, مُطَوَّل (يَفْتَقِرُ إِلَى الإِيجَازِ وَالِاخْتِصَارِ) / مشتت, ناعم ((للضوء) ينتقل من مصدر ضوء واسع أو منعكس)",
 "diffuse nebula": "سديم غازي, سديم منتشر (عنقود من النجوم داخل سحابة معقدة من الغاز والغبار)",
 "diffused": "مُبَدَّد, مُشَتَّت ((عَنِ الأَشِعَّةِ الضَّوْئِيَّةِ) خَضَعَ لِلتَّشَتُّتِ بِالِانْعِكَاسِ عَنْ سَطْحٍ خَشِنٍ أَوِ النَّفَاذِ عَبْرَ مَادَّةٍ شِبْهِ شَفَّافَةٍ) / مشتت, ناعم ((للضوء) ينتقل من مصدر ضوء واسع أو منعكس)",
 "diffusely": "بشكل منتشر, بشكل واسع (بطريقة منتشرة)\nمثال: الشرايين كانت ضيقة بشكل منتشر",
 "diffuseness": "اِنْتِشَار, تَشَتُّت (الخاصية المكانية للانتشار على مساحة واسعة أو عبر حجم كبير)",
 "diffuser": "ناشر ضوء (جهاز بصري يوزع ضوء المصباح بالتساوي) / ناشر الصوت (حاجز يوزع الموجات الصوتية بالتساوي)",
 "diffusing screen": "شاشة نشر, مرشح ضوئي (مرشح شفاف يقلل الضوء (أو بعض الأطوال الموجية للضوء) المار عبره)",
 "diffusion": "اِنْتِشَار (مصدر الفعل \"انْتَشَرَ\"؛ (في الفيزياء) عملية توزيع جزيئات أو ذرات أو حبيبات بشكل متساوٍ في فراغ أو في حيز متاح أو تخللها خلال حاجز غشائي)\nمثال: تساهم في انتشار الجهل والتضليل.",
 "diffusion pump": "مضخة انتشار, مضخة تكثيف (مضخة تفريغ تستخدم للحصول على فراغ عالي)",
 "diffusive": "مُتَبَدِّد, مُنْتَشِر (ينتشر عن طريق الانتشار التدريجي)",
 "diffusor": "ناشر ضوء (جهاز بصري يوزع ضوء المصباح بالتساوي) / ناشر الصوت (حاجز يوزع الموجات الصوتية بالتساوي)",
 "diflunisal": "دولوبيد, ديفلونيسال (مضاد للالتهاب غير ستيرويدي (الاسم التجاري دولوبيد) يستخدم لعلاج التهاب المفاصل والحالات الالتهابية الأخرى)",
 "dig": "حَفَرَ, اِحْتَفَرَ ((حَفَرَ الشَّيْءَ يَحْفِرُه) ، من حَدِّ ضَرَبَ، حَفْراً، (واحْتَفَرَه: نَقَّاه، كَمَا تُحْفَرُ الأَرضُ بالحَدِيدَةِ)؛ حفر: حَفَرَ الشيءَ يَحْفِرُه حَفْراً واحْتَفَرَهُ: نَقَّاهُ كَمَا تُحْفَرُ الأَرض بِالْحَدِيدَةِ)\nمثال: هم يحفرون حفرة.",
 "digenesis": "تعاقب الأجيال الجنسي واللاجنسي, تكاثر تال (تناوب الأجيال الجنسية واللاجنسية)",
 "digest": "هَضَمَ",
 "digester": "جهاز هضم, هاضم (وعاء ضغط يتم فيه هضم المواد النباتية أو الحيوانية)",
 "digestibility": "قابلية الهضم (خاصية سهولة الهضم)",
 "digestible": "قابل للهضم, مهضوم (قابل للتحويل إلى حالة قابلة للامتصاص في القناة الهضمية)",
 "digestibleness": "قابلية الهضم (خاصية سهولة الهضم)",
 "digestion": "هَضْم",
 "digestive": "هَضْمِيّ / جِهَاز هَضْمِيّ",
 "digestive fluid": "عصارة هضمية (إفرازات تساعد على الهضم)",
 "digestive gland": "غدة هضمية (أي غدة لها قنوات تصب إفرازاتها في القناة الهضمية)",
 "digestive juice": "عصارة هضمية (إفرازات تساعد على الهضم)",
 "digestive system": "جِهَاز هَضْمِيّ",
 "digestive tract": "قَنَاة هَضْمِيَّة",
 "digestive tube": "جهاز هضمي, قناة هضمية (ممر أنبوبي من الغشاء المخاطي والعضلات يمتد حوالي 8.3 متر من الفم إلى الشرج؛ وظيفته الهضم والإخراج)",
 "digger": "حَفَّار",
 "digger wasp": "دبور حفار (دبور انفرادي يحفر أعشاشاً في التربة ويخزن فيها حشرات مشلولة لليرقات)",
 "digging": "تنيقب, حفر (فعل الحفر)\nمثال: هناك حفر مثير للاهتمام يجري بالقرب من برينستون",
 "digging up": "استخراج الجثة, نبش (فعل حفر الأرض لاستخراج شيء ما (خاصة جثة) من مدفنها)",
 "diggings": "سكن مؤقت (أماكن معيشة مؤقتة) / حفريات (حفر للتنقيب عن الخام أو الأحجار الكريمة أو للآثار)",
 "dighted": "مُتَأَهِّب, مُتَزَيِّن (مرتدٍ ملابس أو مزيّن (كما للمعركة))",
 "digit": "رَقْم (وضع أرقامًا على شيء ما للتنظيم أو التمييز) / إِصْبَع (عضو مستطيل ينشعِب من طرف الكفّ أو القدم)\nمثال: سجلت رقم هاتفه.",
 "digital": "إِصْبَعِيّ / رَقْمِيّ",
 "digital arteries": "شرايين إصبعية (شرايين في اليد والقدم تغذي الأصابع وأصابع القدم)",
 "digital audiotape": "شريط صوتي رقمي (تسجيل رقمي للصوت على شريط)",
 "digital camera": "كَامِيرَا رَقْمِيَّة (آلة تصوير، لصور ثابتة أو متحركة (فيديو). وتستخدم عدة عدسات في تركيب الكاميرا. وأول وصف لآلة التصوير عن ابن الهيثم في سياق دراسته علم البصريات وذلك في…)\nمثال: أريد هذه الكاميرا.",
 "digital clock": "ساعة رقمية (ساعة تعرض الوقت رقمياً)",
 "digital communication": "اتصال رقمي, تراسل البيانات (النقل الإلكتروني للمعلومات التي تم ترميزها رقمياً (للتخزين والمعالجة بواسطة أجهزة الكمبيوتر))",
 "digital communications technology": "تكنولوجيا الاتصالات الرقمية (تصميم وبناء تكنولوجيا الاتصالات التي تنقل المعلومات في شكل رقمي)",
 "digital computer": "حاسوب رقمي (حاسوب يمثل المعلومات بأرقام (ثنائية))",
 "digital currency": "عملة رقمية (أُجْرَة العَمَل؛ النُقُود عامة لأنها تعطى أجرة للعمل)\nمثال: دعونا نقلب العملة.",
 "digital display": "شاشة رقمية (شاشة تعرض المعلومات في شكل أحرف (أرقام أو حروف))",
 "digital photography": "تصوير رقمي (طريقة تصوير تخزن الصورة رقمياً لإعادة إنتاجها لاحقاً)",
 "digital plethysmograph": "مقياس تحجم رقمي (مقياس تحجم يطبق على إصبع اليد أو القدم لقياس تدفق الدم في الجلد)",
 "digital rights management": "إدَارَةُ الْحُقُوقِ الرَقَمِيَّة (هو عملية تولي تَصْرِيف شؤون العَمَل. لا جمع له؛ مجموع الناس الذين يقومون بإدارة شؤون الجهة، حكومية كانت أم خاصة)\nمثال: والدتي تنتظرني في الإدارة.",
 "digital scanner": "ماسح ضوئي (جهاز إلكتروني يولد تمثيلاً رقمياً لصورة لإدخال البيانات إلى الحاسوب)",
 "digital subscriber line": "خط اشتراك رقمي, دي إس إل (اسم عام للخطوط الرقمية التي تقدمها شركات الهاتف لمشتركيها المحليين والتي تنقل البيانات بسرعات عالية)",
 "digital television": "تَلْفَزَة رَقْمِيَّة",
 "digital vein": "وريد إصبعي (واحد من الأوردة التي تخدم الأصابع أو أصابع القدم)",
 "digital voltmeter": "فولتميتر رقمي (فولتميتر إلكتروني يعطي قراءات بالأرقام)",
 "digital watch": "ساعة يد رقمية (ساعة يد ذات شاشة رقمية)",
 "digital-analog converter": "محول رقمي تناظري (جهاز لتحويل الإشارات الرقمية إلى إشارات تناظرية)",
 "digital-to-analog converter": "محول رقمي تناظري (جهاز لتحويل الإشارات الرقمية إلى إشارات تناظرية)",
 "digitalin": "ديجيتاليس, قمعية (منشط قوي للقلب يُستخرج من نبات القمعية)",
 "digitalis": "أصابع العذراء, ديجيتاليس / ديجيتاليس, قمعية (منشط قوي للقلب يُستخرج من نبات القمعية)",
 "digitalis glycoside": "ديجيتاليس, قمعية (منشط قوي للقلب يُستخرج من نبات القمعية)",
 "digitalis lutea": "قمعية صفراء (قمعية أوروبية ذات زهور صفراء)",
 "digitalis purpurea": "قفاز الثعلب, قمعية أرجوانية (نبات ثنائي الحول أو معمر أوروبي طويل ومورق له عناقيد مذهلة من الزهور الأنبوبية الوردية الأرجوانية الكبيرة؛ تنتج الأوراق دواء الديجيتال وهي سامة…)",
 "digitalisation": "رقمنة, علاج بالديجيتاليس (إعطاء الديجيتاليس لعلاج بعض اضطرابات القلب)",
 "digitalization": "رقمنة, علاج بالديجيتاليس (إعطاء الديجيتاليس لعلاج بعض اضطرابات القلب)",
 "digitally": "رقمياً (من حيث الأرقام الصحيحة) / بإصبع, يدوياً (بواسطة الأصابع (غالباً في الفحص الطبي))\nمثال: تم عرض الوقت رقمياً",
 "digitaria ischaemum": "عشبة السلطعون الملساء (عشبة ضارة، عشبة سنوية صيفية منخفضة النمو تنتشر بالبذور ومن تجذير المفاصل السفلية للسيقان)",
 "digitaria sanguinalis": "عشبة الأصابع المشعرة, عشبة السلطعون الكبيرة (عشبة علف أوروبية تزرع للتبن؛ عشبة ضارة متوطنة في الولايات المتحدة)",
 "digitate": "إِصْبَعِيّ / صَبَعَ ((صَبَعَ) به، وصَبَعَ عليه يَصْبَعُ صَبْعًا: أشار نحوه بِإِصبَعِهِ سخريةً؛ (صَبَعَ) في الشيءِ: أَدخل إصبَعَه فيه) / تَصَبَّعَ",
 "digitately": "بشكل إصبعي (بطريقة تشبه الأصابع)",
 "digitigrade": "إصبعي السير, مترجل على الأصابع ((عن الثدييات) السير على أصابع القدمين مع رفع الجزء الخلفي من القدم (كما تفعل القطط والكلاب والخيول)) / حيوان إصبعي السير (حيوان يمشي بحيث تلامس أصابع القدم فقط الأرض مثل الكلاب والقطط والخيول)",
 "digitigrade mammal": "حيوان إصبعي السير (حيوان يمشي بحيث تلامس أصابع القدم فقط الأرض مثل الكلاب والقطط والخيول)",
 "digitisation": "رقمنة (تحويل المعلومات التناظرية إلى معلومات رقمية)",
 "digitiser": "محول تناظري رقمي, مرقم (جهاز لتحويل الإشارات التناظرية إلى إشارات رقمية)",
 "digitization": "رَقْمَنَة",
 "digitize": "رَقْمَنَة",
 "digitizer": "محول تناظري رقمي, مرقم (جهاز لتحويل الإشارات التناظرية إلى إشارات رقمية)",
 "digitoxin": "ديجيتوكسين (مستحضر من الديجيتاليس يُستخدم لعلاج قصور القلب الاحتقاني أو عدم انتظام ضربات القلب)",
 "diglossia": "اِزْدِوَاجِيَّة لُغَوِيَّة, دِيجْلُوسْيَا",
 "dignified": "رزين, مهيب (يمتلك أو يعبر عن الكرامة؛ خاصة الرسمية أو الهيبة في السلوك أو المظهر) / مُعْتَزّ بِنَفْسِه, وَقُور (يمتلك أو يُظهِر تقديرًا واحترامًا للذات)\nمثال: سلوكها الوقور",
 "dignifying": "مُعَزِّز لِلْكَرَامَة, مُوَقِّر (يمنح الكرامة أو الشرف)",
 "dignitary": "شخصية هامة جداً, كبار الشخصيات (شخص مهم أو مؤثر (وغالباً ما يكون متسلطاً))",
 "dignity": "كَرَامَة, وَقَار (الكرامة هي حق الفرد في أن يكون له قيمة وأن يُحترم لذاته، وأن يُعامل بطريقة أخلاقية)\nمثال: لا يعرض أي إنسان للتعذيب ولا للعقوبات أو المعاملات القاسية أو الوحشية أو الحاطة بالكرامة.",
 "digoxin": "ديجوكسين, لانوكسين (مستحضر ديجيتاليس يُستخدم لعلاج قصور القلب الاحتقاني أو عدم انتظام ضربات القلب؛ يساعد القلب على النبض بقوة أكبر)",
 "digram": "ثنائي الحرف (حرفان متتاليان (خاصة حرفين يستخدمان لتمثيل صوت واحد))",
 "digraph": "ثنائي الحرف (حرفان متتاليان (خاصة حرفين يستخدمان لتمثيل صوت واحد))",
 "digression": "انحراف عن المسار, خروج عن الطريق (الابتعاد عن المسار الرئيسي للرحلة) / انحراف, تحويل (التحول جانباً (عن مسارك أو انتباهك أو اهتمامك)) / اسْتِطْرَاد, جُمْلَة مُعْتَرِضَة (رسالة تخرج عن الموضوع الرئيسي)\nمثال: تحويل عن الطريق السريع الرئيسي",
 "digressive": "اِسْتِطْرَادِيّ, مُتَشَعِّب ((عَنِ الكَلَام وَالكِتَابَة) يَمِيل إِلَى الخُرُوج عَنِ المَوْضُوع الرَّئِيسِيّ) / اسْتِطْرَادِيّ, هَامِشِيّ (ذو صلة سطحية إن وُجدت)",
 "digressiveness": "استطراد (السمة المميزة للشعر التي تتسم بالخروج عن الموضوع أو المسار أو الفكرة المطروحة؛ أو باستكشاف اهتمام مختلف أو غير ذي صلة)",
 "digs": "سكن مؤقت (أماكن معيشة مؤقتة) / حفريات (حفر للتنقيب عن الخام أو الأحجار الكريمة أو للآثار)",
 "dihedral angle": "زاوية الالتواء, زاوية زوجية (الزاوية بين مستويين)",
 "dihybrid": "هجين ثنائي (هجين ناتج عن أبوين يختلفان فقط في موقعين جينيين لهما أليلان لكل منهما)",
 "dihybrid cross": "تهجين ثنائي (تهجين باستخدام صفتين مع أليلين لكل منهما)",
 "dihydric alcohol": "ديول, غليكول (أي من فئة الكحولات التي تحتوي على مجموعتي هيدروكسيل في كل جزيء)",
 "dihydrostreptomycin": "ديهيدروستربتوميسين (مضاد حيوي يتكون من شكل مهدرج من الستربتوميسين؛ يستخدم ضد السل والتولاريميا والكائنات سلبية الغرام)",
 "dihydroxyphenylalanine": "دوبا (حمض أميني يتكون في الكبد ويتحول إلى دوبامين في الدماغ)",
 "dijkstra's algorithm": "خَوَارِزْمِيَّة دِيكْسْتْرَا (خوارزمية: مجموعة من الخطوات والقواعد المحددة التي تُتَّبع لحل مسألة أو تنفيذ مهمة معينة، ولا سيما في الحاسوب)\nمثال: هذه الخوارزمية لا تتقارب.",
 "dik-dik": "ديك ديك (ذكر الدَجَاج؛ ذكر أي طير داجن يشبه الدجاج كالقَبَج وغيره)\nمثال: لديك بعض الكتب.",
 "dika": "ديكا, مانجو بري (شجرة أفريقية بفاكهة صفراء صالحة للأكل تشبه المانجو؛ تقدر لبذورها الغنية بالزيت وخشبها الأخضر الصلب المقاوم للنمل الأبيض)",
 "dika bread": "خبز الديكا (عجينة قابضة نوعاً ما تحضر بطحن وتسخين بذور المانجو البري الأفريقي؛ طعام أساسي لبعض الشعوب الأفريقية)",
 "dika nut": "جوز الديكا (بذرة غنية بالزيت صالحة للأكل للمانجو البري)",
 "dike": "سد (حاجز يُبنى لاحتواء تدفق المياه أو لإبعاد البحر) / مسترجلة ((عامية) مصطلح مسيء لمثلية تظهر عليها صفات ذكورية بشكل ملحوظ)",
 "dilantin": "ديلانتين, فينيتوين (دواء مضاد للاختلاج (الاسم التجاري ديلانتين) يستخدم لعلاج الصرع وهو ليس مهدئاً)",
 "dilapidated": "مُتَدَاعٍ, مُتَهَالِك (في حالة يُرثَى لها من التهالك)",
 "dilapidation": "تداعي, خراب (عملية التحول إلى حالة متداعية) / تداعي, تهالك (حالة تدهور بسبب الشيخوخة أو الاستخدام الطويل)",
 "dilatation": "تمدد, توسع (عملية توسيع فتحة) / تمدد, توسع (حالة التمدد إلى ما وراء الأبعاد الطبيعية)\nمثال: توسع حدقة العين",
 "dilatation and curettage": "توسيع وكشط (إجراء جراحي يتم عادة تحت تخدير موضعي يتم فيه توسيع عنق الرحم وكشط بطانة الرحم)",
 "dilater": "موسع (أداة جراحية تستخدم لتوسيع أو تمديد فتحة أو عضو)",
 "dilation": "تمدد, توسع (عملية توسيع فتحة) / إطناب, توسع (مناقشة مطولة (منطوقة أو مكتوبة) حول موضوع معين)\nمثال: توسع حدقة العين",
 "dilation and curettage": "توسيع وكشط (إجراء جراحي يتم عادة تحت تخدير موضعي يتم فيه توسيع عنق الرحم وكشط بطانة الرحم)",
 "dilator": "موسع (أداة جراحية تستخدم لتوسيع أو تمديد فتحة أو عضو) / موسع (عقار يسبب التوسع) / عضلة موسعة, موسع (عضلة أو عصب يوسع جزءاً من الجسم)",
 "dilatoriness": "تباطؤ, تسويف (البطء نتيجة لعدم القيام بالأمر)",
 "dilatory": "مُتَبَاطِئ, مُتَلَكِّئ (يُضَيِّع الوَقْت وَيَتَأَخَّر)",
 "dilatory plea": "دفع تسويفي, دفع معطل (دفع يؤخر الدعوى دون تسوية سبب الدعوى؛ يمكن أن يطعن في الاختصاص القضائي أو يدعي عدم أهلية المدعى عليه وما إلى ذلك (تُثار مثل هذه الدفاعات عادةً في…)",
 "dilaudid": "ديلوديد, هيدرومورفون (مسكن مخدر (الاسم التجاري ديلوديد) يستخدم لعلاج الألم المتوسط إلى الشديد)",
 "dildo": "قَضِيب اِصْطِنَاعِيّ",
 "dilemma": "مُعْضِلَة / مِحْنَة",
 "dilettante": "مُتَطَفِّل, هَاوٍ سَطْحِيّ (يُظهِر اهتمامًا سطحيًّا أو تافهًا؛ على مستوى الهواة) / متطفل, هاوٍ غير جدي (هاوٍ ينخرط في نشاط دون نوايا جادة ويدعي المعرفة)",
 "dilettanteish": "مُتَطَفِّل, هَاوٍ سَطْحِيّ (يُظهِر اهتمامًا سطحيًّا أو تافهًا؛ على مستوى الهواة)",
 "dilettantish": "مُتَطَفِّل, هَاوٍ سَطْحِيّ (يُظهِر اهتمامًا سطحيًّا أو تافهًا؛ على مستوى الهواة)",
 "dili": "دِيلِي",
 "diligence": "اِجْتِهَاد",
 "diligent": "مُجْتَهِد (مشتق من إجتهد)\nمثال: لعل المجتهد ينجح.",
 "diligently": "بِجِدّ",
 "dill": "شِبِثّ, شِبِتّ",
 "dill pickle": "مخلل الشبت (مخلل محفوظ في محلول ملحي أو خل منكه بذور الشبت)",
 "dill seed": "بذور الشبت (بذور نبات الشبت تستخدم للتتبيل)",
 "dill tea": "شاي الشبت (مشروب من نقيع الشبت)\nمثال: اكتشف الفوائد الصحية لهذا النبات الذي يُستخدم في الطهي واستمتع بكوب من شاي الشبت العطري متى شئت",
