 "domestic carp": "شبوط, مبروكة (سمكة مياه عذبة كبيرة من العالم القديم تتغذى في القاع، أُدخلت إلى أوروبا من آسيا؛ تعيش في البرك والجداول البطيئة وغالباً ما تُربى للطعام؛ أُدخلت إلى…)",
 "domestic cat": "قط, قط أليف (حَيْوَان مستأنس من عائلة السَنُّورِيّات، له في اللغة أسماء عديدة تذكر وتؤنث)\nمثال: أعطنا هذا القط.",
 "domestic dog": "كلب, كلب أليف\nمثال: نبح الكلب طوال الليل (بمعنى ضربهُ بالكُلاب أو جعل لها كَلْبًا؛ سَيْر أحمر يُجعَل بين طرفي الأديم إذا خُرِز)\nمثال: كان الكلب ميتا.",
 "domestic flight": "رحلة داخلية (رحلة تبدأ وتنتهي في نفس البلد)",
 "domestic fowl": "دجاج داجن (طائر داجن من الدجاجيات يعتقد أنه ينحدر من دجاج الأدغال الأحمر)",
 "domestic goat": "ماعز أهلي (أي من سلالات الماعز المختلفة التي تربى من أجل الحليب أو اللحم أو الصوف)",
 "domestic help": "خادم منزلي, عامل منزلي (خادم يتقاضى أجراً لأداء مهام وضيعة حول المنزل)",
 "domestic llama": "لاما (تُستخدم في جبال الأنديز كدابة حمل ومصدر للصوف؛ تُعتبر صنفاً مستأنساً من الغواناكو)",
 "domestic partner": "شَرِيك حَياة, شَرِيك مُساكِن (شخص (ليس بالضرورة زوجاً) تعيش معه وتشترك معه في علاقة طويلة الأمد)",
 "domestic pigeon": "حمام مستأنس (حمام مستأنس يُربى للرياضة أو الطعام)",
 "domestic prelate": "حبر منزلي ((الكنيسة الكاثوليكية الرومانية) كاهن عضو فخري في الأسرة البابوية)",
 "domestic relations court": "محكمة الأسرة, محكمة العلاقات الأسرية (محكمة في بعض ولايات الولايات المتحدة لها اختصاص في النزاعات العائلية (خاصة تلك المتعلقة بالأطفال))",
 "domestic science": "اقتصاد منزلي, تدبير منزلي (نظرية وممارسة إدارة المنزل)",
 "domestic sheep": "خروف أهلي (أي من السلالات المختلفة التي تربى من أجل الصوف أو اللحم الصالح للأكل أو الجلد)",
 "domestic silkworm moth": "عثة دودة القز المستأنسة (عثة آسيوية ممتلئة الجسم بيضاء كريمية توجد بالكامل تقريباً تحت الرعاية البشرية؛ مصدر معظم تجارة الحرير)",
 "domestic terrorism": "إرهاب محلي (إرهاب يمارس في بلدك ضد شعبك)\nمثال: كان تفجير المبنى الفيدرالي في أوكلاهوما سيتي عام 1995 مثالاً على الإرهاب المحلي",
 "domestic violence": "عُنْف مَنْزَلِيّ, عُنْف أُسْرِيّ",
 "domestically": "عَائِلِيًّا, مَنْزِلِيًّا (فيما يتعلق بالمنزل أو الأسرة) / دَاخِلِيًّا, مَحَلِّيًّا (فيما يتعلق بالشؤون الداخلية للحكومة)\nمثال: ربة المنزل أشعرتنا بالملل بحديثها المحدود منزلياً",
 "domesticated": "أَلِيف",
 "domesticated animal": "حيوان أليف, حيوان داجن (أي من الحيوانات المختلفة التي تم ترويضها وجعلها مناسبة للبيئة البشرية)",
 "domesticated silkworm moth": "عثة دودة القز المستأنسة (عثة آسيوية ممتلئة الجسم بيضاء كريمية توجد بالكامل تقريباً تحت الرعاية البشرية؛ مصدر معظم تجارة الحرير)",
 "domestication": "اِسْتِئْنَاس (استأنس الحيوان:صار أليفاَ،ذهبت عنه وحشيّته ، استأنس الزّائر:استأذن،استأنس إلى فلان:أَنِس به،سكن إليه،ذهبت به وحشته،ألفه و اطمأنّ إليه؛ الاستئناس في كلام العرب النّظر،يُقال:اذهب فاستأنس هل ترى أحداً، استأنس الرّجل:استأذن وتبصّر،وبه فُسِّر قوله تعالى:…)\nمثال: هل يمكن استئناس ابن آوى؟",
 "domesticity": "حياة منزلية, شؤون منزلية (الأنشطة أو الحياة المنزلية) / ألفة منزلية, حياة منزلية (صفة الحياة المنزلية أو كون الكائن أليفاً)\nمثال: عائلة ملكية تعيش في حياة منزلية متواضعة",
 "domicile": "مأوى, مسكن (سكن يعيش فيه شخص ما) / مقر إقامة, موطن قانوني ((في القانون) المسكن الذي يوجد به منزلك الدائم أو مؤسستك الرئيسية وإليه تنوي العودة كلما تغيبت؛ يُلزم كل شخص بأن يكون له موطن واحد فقط في كل مرة)\nمثال: بنى مسكناً متواضعاً بالقرب من البركة",
 "domiciliary": "سكني, منزلي (من أو متعلق بالمنزل أو مُقدم في محل الإقامة)\nمثال: رعاية طبية منزلية",
 "domiciliation": "سكن مؤقت (أماكن معيشة مؤقتة)",
 "dominance": "جانبية, هيمنة جانبية (تطور متفوق لجانب واحد من الجسم) / تفويض, سلطة (القوة أو الحق في إصدار الأوامر أو اتخاذ القرارات) / سيادة (الظاهرة العضوية التي يتم فيها التعبير عن أحد أليلين موجودين في النمط الجيني في النمط الظاهري بينما لا يظهر الأليل الآخر) / تحكم, سيطرة (الحالة التي توجد عندما يكون لشخص أو مجموعة سلطة على أخرى)\nمثال: لديه السلطة لإصدار مذكرات التوقيف",
 "dominant": "سَائِد / سَائِد, شَائِع",
 "dominant allele": "أليل سائد (أليل ينتج نفس النمط الظاهري سواء كان أليله المقترن مطابقاً أو مختلفاً)",
 "dominant gene": "جين سائد (جين ينتج نفس النمط الظاهري في الكائن الحي سواء كان أليله مطابقاً أم لا)\nمثال: الجين السائد للعيون البنية",
 "dominate": "سَيْطَرَ",
 "dominated": "خَاضِع, مُهَيْمَنٌ عَلَيْه (يَخْضَعُ لِسُلْطَةٍ أَوْ قُوَّةٍ عُلْيَا) / خَاضِع لِلزَّوْجَة, مُهَيْمَن عَلَيْه (مُضَايَق بِالتَّذَمُّر المُسْتَمِرّ)",
 "dominating": "مُتَجَبِّر, مُتَسَلِّط (مُعْتَدّ بِنَفْسِهِ بِشَكْلٍ مُسِيء أَوْ يُمَارِس سُلْطَةً غَيْر مُبَرَّرَة) / مُسَيْطِر, مُهَيْمِن (الأَكْثَر قُوَّةً أَوْ أَهَمِّيَّةً أَوْ تَأْثِيرًا) / مُشْرِف, مُطِلّ (يُستخدَم لوصف ارتفاع أو موقع مُطِلّ على ما حوله)",
 "domination": "هَيْمَنَة, سَيْطَرَة",
 "dominatrix": "امرأة مسيطرة (امرأة مسيطرة (خاصة تلك التي تلعب هذا الدور في علاقة سادية مازوخية))",
 "domine": "سيد, قس (رجل دين؛ خاصة قس أو كاهن مستقر في رعية)",
 "dominee": "سيد, قس (رجل دين؛ خاصة قس أو كاهن مستقر في رعية)",
 "domineering": "متسلط, مهيمن (يميل إلى التسلط والسيطرة)",
 "domineeringly": "بِاسْتِبْدَاد, بِتَسَلُّط (بطريقة متسلطة)\nمثال: تصرفت زوجته بتسلط",
 "domineeringness": "تجبر, تسلط (سمة التسلط والغطرسة)",
 "dominic": "دومينيك",
 "dominica": "دُومِينِيكَا",
 "dominical": "أحدي, متعلق بيوم الرب (متعلق بيوم الأحد بصفته يوم الرب) / رباني, مسيحي (متعلق بيسوع المسيح أو صادر عنه)",
 "dominican": "دومينيكاني (من أو متعلق بالقديس دومينيك أو النظام الدومينيكاني) / دومينيكاني (من أو متعلق أو مميز لجمهورية الدومينيكان أو شعبها) / دومينيكاني (مواطن أو ساكن في جمهورية الدومينيكان) / دومينيكاني, راهب أسود (راهب روماني كاثوليكي يرتدي العباءة السوداء للرهبنة الدومينيكانية)\nمثال: رهبان دومينيكان",
 "dominican dollar": "دولار دومينيكي (وحدة المال الأساسية في دومينيكا)",
 "dominican mahogany": "ماهوجني حقيقي, ماهوجني كوبي (شجرة الماهوجني في جزر الهند الغربية)",
 "dominican monetary unit": "وحدة نقدية دومينيكية (الوحدة النقدية في جمهورية الدومينيكان)",
 "dominican order": "الرهبنة الدومينيكانية (نظام كاثوليكي روماني للوعظ المتسول تأسس في القرن الثالث عشر)",
 "dominican peso": "بيزو, بيزو دومينيكي (وحدة المال الأساسية في جمهورية الدومينيكان؛ تساوي 100 سنتافو)",
 "dominican republic": "جُمْهُورِيَّة اَلدُّومِنِيكَان",
 "dominick": "دجاج دومينيك (سلالة أمريكية من الدجاج ذات ريش رمادي مخطط تُربى من أجل اللحم والبيض البني)",
 "dominicus": "الأحد, يوم الأحد (أول أيام الأسبوع (في بعض التقاويم)؛ يوم راحة وعبادة لمعظم المسيحيين)",
 "dominie": "سيد, قس (رجل دين؛ خاصة قس أو كاهن مستقر في رعية)",
 "dominion": "دومينيون (واحدة من الدول ذاتية الحكم في الكومنولث البريطاني) / إِقْلِيم إِدَارِيّ, مُقَاطَعَة (منطقة محدّدة لأغراض إداريّة أو غيرها) / حكم, سلطان (الهيمنة أو السلطة من خلال السلطة القانونية)\nمثال: احتفظت فرنسا بحكم لا جدال فيه على مناطق شاسعة من أفريقيا",
 "dominion day": "1 يوليو, يوم الدومينيون (عطلة قانونية في كندا لإحياء ذكرى الحصول على وضع الدومينيون عام 1867)",
 "dominique": "دجاج دومينيك (سلالة أمريكية من الدجاج ذات ريش رمادي مخطط تُربى من أجل اللحم والبيض البني)",
 "domino": "دومينو (كتلة مستطيلة صغيرة تستخدم في لعب الدومينو؛ يحتوي وجه كل كتلة على منطقتين متساويتين يمكن أن تحمل كل منهما 0 إلى 6 نقاط) / قناع عين, قناع نصفي (قناع يغطي الجزء العلوي من الوجه مع وجود ثقوب للعينين) / دومينو, رداء تنكري (عباءة فضفاضة بغطاء رأس تلبس مع قناع نصف وجه كجزء من زي تنكري)",
 "domino effect": "تأثير الدومينو",
 "domino theory": "نظرية الدومينو (النظرية السياسية التي تقول إنه إذا وقعت دولة تحت السيطرة الشيوعية فإن الدول المجاورة ستقع أيضاً تحت السيطرة الشيوعية)",
 "dominoes": "الدَّوْمَنَة, دُومِينُو",
 "dominos": "دومينو (أي من الألعاب المختلفة التي تُلعب بقطع مستطيلة صغيرة)",
 "dominus": "سيد, قس (رجل دين؛ خاصة قس أو كاهن مستقر في رعية)",
 "domodedovo": "دُومُودِيدُوفُو",
 "domoic acid": "حمض الدومويك (سم عصبي قاتل للبشر؛ يوجد في طحالب بحرية مختلفة)",
 "don": "دون (لقب مجاملة إسباني أو صيغة خطاب للرجال يوضع قبل الاسم الأول) / دون (رجل نبيل أو سيد إسباني) / دون, عراب (رئيس عائلة جريمة منظمة) / معلم جامعي (معلم في جامعة أو كلية (خاصة في كامبريدج أو أكسفورد))\nمثال: دون روبرتو",
 "don juan": "دُون خُوَان (مصدر من الفعل دَانَ يَدُون بمعنى خَسَّ وضَعُف؛ تَحت؛ ضد فَوق. ويختلف عن التحت بأن التحت موضعه في الأسفل والدون هو تقصير عن الغاية أو عدم القدرة على الوصول إلى أعلى)\nمثال: زيري بدون مؤوى.",
 "don quixote": "دُون كِيشُوت, دُون كِيخُوتِي (مصدر من الفعل دَانَ يَدُون بمعنى خَسَّ وضَعُف؛ تَحت؛ ضد فَوق. ويختلف عن التحت بأن التحت موضعه في الأسفل والدون هو تقصير عن الغاية أو عدم القدرة على الوصول إلى أعلى)\nمثال: زيري بدون مؤوى.",
 "don't": "لَا (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: لا أحب المدرسة.",
 "don't mention it": "عَفْوًا",
 "don't-know": "الممتنع عن الإجابة (شخص يجيب بـ 'لا أعرف' في استطلاع للرأي العام)\nمثال: 70% مؤيدون، 13% معارضون و 17% لا يعرفون",
 "dona": "دونا (لقب مجاملة إسباني أو صيغة خطاب للمرأة)",
 "donald": "دُونَلْد",
