 "disaffected": "سَاخِط, مُتَمَرِّد (غَيْرُ رَاضٍ تُجَاهَ السُّلْطَةِ)",
 "disaffection": "تَمَرُّد, سُخْط (عدم الولاء للحكومة أو للسلطة القائمة) / اغتراب, جفاء (الشعور بالغربة عن الآخرين)\nمثال: السخط الواسع بين القوات",
 "disaffirmation": "إنكار, نفي (فعل التأكيد على أن شيئاً مزعوماً غير صحيح)",
 "disagreeable": "بَغِيض, غَيْر مَقْبُول (ليس على هواك) / غَيْرُ مُتَعَاطِفٍ, مُنَفِّر (لَا يَتَّفِقُ مَعَ أَذْوَاقِكَ أَوْ تَوَقُّعَاتِكَ) / بَغِيض, كَرِيه المُعَاشَرَة (غير سار في التعامل معه)\nمثال: موقف بغيض",
 "disagreeable person": "شَخْص بَغِيض, شَخْص كَرِيه (شخص غير لطيف أو غير مقبول في التعامل)",
 "disagreeableness": "سء المعشر, فظاظة (طبع سيء المزاج وعدواني) / بَغَاضَة, كَرَاهَة (صفة كون الشيء كريهاً وغير سار)",
 "disagreeably": "بِشَكْل بَغِيض, بِنَكَد (بطريقة بغيضة)\nمثال: 'لم يصبني أي أذى من الرحلة، شكراً لك'، قالت بنكد",
 "disagreement": "تَبَايُن, تَضَارُب (اختلاف بين حقائق أو ادعاءات أو آراء متعارضة) / خلاف, عدم اتفاق (الفعل الكلامي المتمثل في الاختلاف أو الجدال أو النزاع) / تنافر, خلاف (صراع في آراء الناس أو أفعالهم أو طباعهم)\nمثال: تباين متزايد في الآراء",
 "disambiguation": "تَوْضِيح",
 "disambiguator": "مزيل الغموض ((علم الحاسوب) تطبيق معالجة لغة طبيعية يحاول تحديد المعنى المقصود لكلمة أو عبارة عن طريق فحص السياق اللغوي الذي استُخدمت فيه)",
 "disappear": "اِخْتَفَى (تعمّد وتكلف إخفاء نفسه عنه الأنظار فلا يُرى؛ خَفِيَ بعد أن كان مرئيًّا) / أَخْفَى\nمثال: لقد اختفى فاضل.",
 "disappearance": "اِخْتِفَاء",
 "disappearing": "اختفاء, تواري (فعل المغادرة سراً أو دون تفسير)",
 "disappoint": "خَيَّبَ آمَالَهُ ((خَيَّبَ)و(خيبه): جعله خائبا وَحرمه وَلم ينله طلبه)\nمثال: خيبة أملها كانت جلية للجميع.",
 "disappointed": "خَائِب الأَمَل",
 "disappointedly": "بِخَيْبَة أَمَل (بخيبة أمل؛ بطريقة خائبة)\nمثال: غادرت طاولة القمار بخيبة أمل",
 "disappointing": "غَيْرُ مُرْضٍ, مُخَيِّبٌ لِلآمَال (لا يرقى إلى مستوى التوقّعات)",
 "disappointingly": "بِشَكْل مُخَيِّب لِلآمَال (بطريقة مخيبة للآمال)\nمثال: بدا مكتشف الأرجون، السير ويليام رامزي، عادياً بشكل مخيب للآمال",
 "disappointment": "خَيْبَة أَمَل",
 "disapprobation": "إِدَانَة, اسْتِنْكَار شَدِيد (تعبير عن الرفض القوي؛ أو الحكم على الشيء بأنه خاطئ أو يستحق اللوم أخلاقياً)\nمثال: إدانته الصارمة للعنصرية",
 "disapproval": "إدانة, استهجان (فعل الاستهجان أو الإدانة) / استهجان, عدم رضا (الميل لعدم منح الموافقة أو الرضا عن شخص أو مجموعة) / اسْتِنْكَار, اسْتِهْجَان (التعبير عن عدم الموافقة أو الاستهجان) / استهجان, عدم استحسان (شعور بعدم الإعجاب بشيء أو بما يفعله شخص ما)",
 "disapproving": "رَافِض, مُسْتَنْكِر (يُعَبِّر عَنْ عَدَم المُوَافَقَة أَوْ يُظْهِرُهَا)",
 "disapprovingly": "بِاسْتِهْجَان (إظهار عدم الموافقة)\nمثال: هز رأسه باستنكار",
 "disarmament": "نَزْع السِلَاح (قَلَعَ، أَزَالَ؛ خَلَعَ)\nمثال: نزع زيري البساط.",
 "disarmer": "دَاعِيَة سَلَام, مُسَالِم (شخص يعارض العنف كوسيلة لتسوية النزاعات)",
 "disarming": "نزع السلاح (فعل تقليل أو حرمان من الأسلحة) / مُسْتَمِيل, مُطَمْئِن (قادر على تبديد العداوة وكسب الودّ)",
 "disarranged": "مبعثر, مشوش (اضطرب ترتيبه؛ ليس في نظام)\nمثال: شعرها المبعثر",
 "disarrangement": "اختلال النظام, تفكك (حالة تعطل فيها نظام منظم)",
 "disarray": "تشوش هندام, شعث (عدم ترتيب (خاصة الملابس والمظهر)) / ارتباك, تشوش (حالة عقلية تتميز بنقص في وضوح الفكر والسلوك ونظامهما)\nمثال: تشوش في الانطباعات",
 "disarrayed": "مُتَبَعْثِر (في حالة من الفوضى وعدم الترتيب)",
 "disassembly": "تَفْكِيك",
 "disassociation": "انشقاق, تفكك (حالة ينفصل فيها جزء متكامل من حياة الشخص عن بقية الشخصية ويعمل بشكل مستقل) / تفكك, فصل ذهني (حالة عدم الارتباط في الذاكرة أو الخيال)\nمثال: لم أستطع التفكير فيه بمعزل عن زوجته",
 "disassortative mating": "تزاوج تبايني, تزاوج غير متوافق (تزاوج أفراد لديهم صفات متباينة أكثر مما هو محتمل في التزاوج العشوائي)",
 "disaster": "كَارِثَة, مُصِيبَة",
 "disaster area": "منطقة منكوبة (المِنْطَقةُ: المَنْطِقَةُ؛ مِنْطَقَةُ: مُقَاطَعَةٌ)\nمثال: غزة منطقة مكشوفة.",
 "disastrous": "كَارِثِيّ, مَشْؤُوم ((عَنِ الأَحْدَاثِ) ذُو عَوَاقِبَ وَخِيمَةٍ أَوْ كَارِثِيَّةٍ)",
 "disastrously": "بِشَكْل كَارِثِيّ, بِوَبَال (بطريقة كارثية)\nمثال: القيمة الحقيقية لرأس مال الصندوق قد تكون أقل بشكل كارثي مما كانت عليه عند بدء الصندوق",
 "disavowable": "قَابِلٌ لِلتَّنَصُّل (يُمْكِنُ التَّنَصُّلُ مِنْهُ أَوْ إِنْكَارُهُ)",
 "disavowal": "إنكار, تتبرؤ (إنكار أي صلة أو معرفة بـ)",
 "disband": "حَلَّ, سَرَّحَ (للعقدة: ضد عَقْدها؛ للجامد في السائل: إذابته)\nمثال: حل زيري المشكل.",
 "disbandment": "حَلّ (فعل الحل (لمنظمة أو جماعة))\nمثال: واجهت الأوركسترا احتمال الحل",
 "disbarment": "تجريد من المحاماة, شطب من النقابة (فعل طرد محام من ممارسة مهنة المحاماة)",
 "disbelief": "ارتياب, شك (الشك في حقيقة شيء ما) / جحود, عدم إيمان (رفض الاعتقاد أو الإيمان)",
 "disbelieve": "كَذَّبَ (مصدر للفعل كَذَبَ؛ نقيض الصِدْق، قَوْل ما يخالف ما يعلم القَائِل أنه حَقِيقَة)\nمثال: اتهمتني بالكذب.",
 "disbeliever": "كَافِر, كَافِرَة",
 "disbelievers": "سورة الكافرون",
 "disbelieving": "مُتَشَكِّك, مُرْتَاب (يُنكِر أو يُشَكِّك في عقائد دين ما خاصةً)",
 "disbelievingly": "بِاسْتِنْكَار, بِتَشَكُّك (بطريقة شاكة وغير مصدقة)\nمثال: نظرت المرأة إليها بعدم تصديق",
 "disbursal": "إنفاق, صرف (عملية إنفاق أو صرف المال) / صرف, مصروف (مبالغ مدفوعة للسلع والخدمات قد تكون قابلة للخصم الضريبي حالياً (على عكس النفقات الرأسمالية))",
 "disbursement": "إنفاق, صرف (عملية إنفاق أو صرف المال) / صرف, مصروف (مبالغ مدفوعة للسلع والخدمات قد تكون قابلة للخصم الضريبي حالياً (على عكس النفقات الرأسمالية))",
 "disburser": "صَارِف, مُنفِق (شخص ينفق المال لشراء السلع أو الخدمات)",
 "disc": "قرص (لوحة دائرية مسطحة) / قرص مغناطيسي ((علم الحاسوب) جهاز ذاكرة يتكون من قرص مسطح مغطى بطبقة مغناطيسية يتم تخزين المعلومات عليها) / أسطوانة, أسطوانة فونوغراف (تسجيل صوتي يتكون من قرص به أخدود مستمر؛ يستخدم لإعادة إنتاج الموسيقى عن طريق الدوران بينما تتبع إبرة الفونوغراف الأخدود) / صحن, قرص (شيء ذو شكل مستدير يشبه طبقاً دائرياً مسطحاً)\nمثال: قرص القمر",
 "disc brake": "فرامل ديسك, مكبح قرصي (مكبح هيدروليكي يتم فيه تطبيق الاحتكاك على جانبي قرص دوار بواسطة وسادات الفرامل)",
 "disc drive": "قرص صلب, محرك أقراص (جهاز حاسوب يحمل ويدير قرصاً مغناطيسياً أو ضوئياً ويقرأ ويكتب المعلومات عليه)",
 "disc harrow": "مسلفة قرصية (مسلفة ذات سلسلة من الأقراص مثبتة على الحافة بزاوية)",
 "disc jockey": "فارس الإسطوانات, دسْك جوكي (اسم فاعل لفَرَسَ؛ راكب الفَرَس أو الحِصَان)\nمثال: فارس الظلام فيلم جيد.",
 "disc pack": "حزمة أقراص ((علم الحاسوب) حزمة محمولة من الأقراص المغناطيسية تُستخدم في جهاز تخزين الأقراص)",
 "disc plough": "محراث قرصي (محراث يتكون من مجموعة من أقراص القطع الفولاذية المقعرة، يستخدم للعمل في التربة الجافة الصلبة)",
 "disc plow": "محراث قرصي (محراث يتكون من مجموعة من أقراص القطع الفولاذية المقعرة، يستخدم للعمل في التربة الجافة الصلبة)",
 "disc space": "مساحة القرص ((علم الحاسوب) المساحة المتوفرة على القرص المغناطيسي)",
 "disc-shaped": "قُرْصِيّ, مُسَطَّحٌ دَائِرِيّ (ذو شكل دائري مسطّح كالقرص)",
 "discalceate": "حافٍ ((يُستخدم لبعض الطوائف الدينية) حفاة الأقدام أو يرتدون الصنادل فقط)\nمثال: رهبان حفاة",
 "discalced": "حافٍ ((يُستخدم لبعض الطوائف الدينية) حفاة الأقدام أو يرتدون الصنادل فقط)\nمثال: رهبان حفاة",
 "discant": "ديسكانت, لحن إضافي (مرافقة موسيقية زخرفية (غالباً ما تكون ارتجالية) تضاف فوق اللحن الأساسي)",
 "discard": "تخلص, رمي (التخلص من شيء يعتبر عديم الفائدة أو غير مرغوب فيه) / إلقاء الورق, طرح الورق ((في أوراق اللعب) فعل رمي بطاقة عديمة الفائدة) / شيء متروك, مُهملات (أي شيء يتم طرحه جانباً أو التخلص منه)",
 "discarded": "مَنْبُوذ, مُلْقًى (مُلقًى به ومُتخلَّص منه)",
 "disceptation": "جدل, سجال (فعل كلامي جدلي؛ نزاع حيث يوجد اختلاف قوي في الرأي)\nمثال: انخرطوا في جدال عنيف",
 "discernability": "قَابِلِيَّة التَّمْيِيز, مَقْرُوئِيَّة (التمايز الذي يجعل الإدراك سهلاً)",
 "discernable": "جلي, قابل للتمييز (يمكن إدراكه بالحواس أو العقل)\nمثال: تحدث أشياء في الأرض والسماء بلا سبب ظاهر (قابل للتمييز)",
 "discernible": "جلي, قابل للتمييز (يمكن إدراكه بالحواس أو العقل) / بَيِّن, مَلْحُوظ (يمكن رؤيته أو ملاحظته) / قَابِلٌ لِلتَّمْيِيز (يُمْكِنُ إِدْرَاكُهُ بِوُضُوح)\nمثال: تحدث أشياء في الأرض والسماء بلا سبب ظاهر (قابل للتمييز)",
 "discerning": "ثاقب النظر, فطن (يمتلك أو يكشف عن بصيرة حادة وحكم جيد) / حَاذِق, مُمَيِّز (قَادِر عَلَى إِدْرَاك الفُرُوقَات الدَّقِيقَة؛ حَسَّاس) / سَرِيعُ الفَهْم, فَطِن (سَرِيعُ الإِدْرَاكِ وَالاسْتِيعَاب) / حَصِيف, فَطِن (ذو إدراك خفي ومتعاطف)\nمثال: ناقد فطن",
 "discernment": "حسن تقدير, فطنة (سمة الحكم بحكمة وموضوعية) / تمييز, حصافة (القدرة العقلية على الفهم والتمييز بين العلاقات) / بصيرة, فطانة (إدراك ما هو غامض) / بصيرة, تذوق (تمييز دقيق (خاصة للقيم الجمالية))\nمثال: رجل ذو فطنة",
 "discharge": "إطلاق نار (فعل إطلاق النار من بندقية) / إبراء ذمة, إخلاء طرف (بيان مكتوب رسمي بالتنازل أو الإبراء) / إقالة, تسريح (إنهاء توظيف شخص ما (وتركه حراً للمغادرة)) / تصريف, تنفيس (فعل التنفيس أو الإخراج)",
 "discharge lamp": "مصباح تفريغ (مصباح يولد الضوء عن طريق تفريغ كهربائي بين قطبين في غاز)",
 "discharge pipe": "أنبوب تصريف (أنبوب يمكن من خلاله تصريف السوائل)",
 "discharged": "مَفْصُول, مُسَرَّح (فقد وظيفته أو تمّ الاستغناء عنه)",
 "disciform": "قُرْصِيُّ الشَّكْلِ, قُرْصِيّ (ذو شكل مستدير أو بيضاوي كالقرص)",
 "discina": "ديسينا (أي فطر من جنس ديسينا)",
 "discina macrospora": "ديسينا ماكرو سبورا (ديسينا بجسم خصب مسطح أو صحني الشكل بني على السطح العلوي؛ له ساق قصير؛ لا ينصح بأكله)",
 "disciotis venosa": "موريل الكأس (موريل صالح للأكل بجسم ثمري يشبه الكأس أو الصحن يمكن أن يصل عرضه إلى 20 سم؛ السطح الخصب داخل الكأس به تجاعيد تشع من المركز؛ يمكن الخلط بينه وبين الفطر…)",
 "disciple": "حَوَارِيّ, تِلْمِيذ",
 "disciples of christ": "الكنيسة المسيحية, تلاميذ المسيح (كنيسة بروتستانتية تقبل الكتاب المقدس باعتباره المصدر الوحيد للإيمان المسيحي الحقيقي وتمارس المعمودية بالتغطيس)",
 "discipleship": "اتباع, تلمذة (منصب التلميذ أو المريد)",
 "disciplinal": "تَأْدِيبِيّ, تَصْحِيحِيّ (مُصمَّم لتعزيز الانضباط)",
 "disciplinarian": "صارم, متشدد (شخص يطلب الالتزام التام بالقواعد والشكليات)",
 "disciplinary": "تَأْدِيبِيّ, تَصْحِيحِيّ (مُصمَّم لتعزيز الانضباط) / تخصصي (متعلق بمجال دراسي أكاديمي محدد) / انضباطي, تأديبي (متعلق بالانضباط في السلوك)\nمثال: الاقتصاد بمعناه التخصصي الحديث",
