 "destroyer escort": "مدمرة مرافقة (سفينة حربية أصغر من المدمرة؛ مصممة لمرافقة الأساطيل أو القوافل)",
 "destroying angel": "أمانيت فالوسي, قبعة الموت (فطر سام للغاية عادة ما يكون أبيض اللون بقاعدة بارزة تشبه الكأس؛ يختلف عن الغاريقون الصالح للأكل فقط في خياشيمه البيضاء) / أمانيت ربيعي, الملاك المدمر (فطر مشابه للأمانيت الفالوسي)",
 "destructibility": "قابلية التدمير (الضعف أمام التدمير)",
 "destructible": "قابل للتدمير (سهل التدمير)\nمثال: أواني زجاجية قابلة للكسر (للتدمير)",
 "destruction": "تَدْمِير, هَدْم",
 "destruction fire": "نيران تدمير (نيران يتم إطلاقها لغرض وحيد هو تدمير الأجسام المادية)",
 "destructive": "مدمر, هدام (يسبب دماراً أو ضرراً كبيراً)\nمثال: سياسة هدامة للاقتصاد",
 "destructive criticism": "نَقْدٌ هَدَّامٌ",
 "destructive distillation": "تقطير إتلافي (تسخين مادة صلبة في وعاء مغلق وجمع المنتجات المتطايرة)",
 "destructive metabolism": "أيض هدمي, هدم (تحلل المواد الأكثر تعقيدًا في الكائنات الحية إلى مواد أبسط مع إطلاق الطاقة)",
 "destructive-metabolic": "مُطْلِق لِلطَّاقَة, هَدْمِيّ اسْتِقْلَابِيّ (مُتعلّق بعمليّة الهدم الاستقلابيّ (الأيض الهدميّ))",
 "destructively": "بِشَكْل مُدَمِّر, تَخْرِيبِيًّا (بطريقة مدمرة)\nمثال: هو عدواني بشكل مدمر",
 "destructiveness": "إِتْلَاف, تَدْمِيرِيَّة (صفة التسبب في الدمار)",
 "desuetude": "إهمال, عدم استعمال (حالة من عدم النشاط أو عدم الاستخدام)",
 "desultory": "غَيْرُ مُنْتَظِم, مُشَتَّت (يتّسم بانعدام الخطّة أو الانتظام؛ ينتقل من موضوع إلى آخر)",
 "desynchronisation": "عَدَم التَّزَامُن, لَا تَزَامُن (العلاقة التي توجد عندما تحدث الأشياء في أوقات غير مرتبطة)\nمثال: أنتج التحفيز عدم تزامن لموجات الدماغ",
 "desynchronization": "عَدَم التَّزَامُن, لَا تَزَامُن (العلاقة التي توجد عندما تحدث الأشياء في أوقات غير مرتبطة)\nمثال: أنتج التحفيز عدم تزامن لموجات الدماغ",
 "desynchronizing": "عَدَم التَّزَامُن, لَا تَزَامُن (العلاقة التي توجد عندما تحدث الأشياء في أوقات غير مرتبطة)\nمثال: أنتج التحفيز عدم تزامن لموجات الدماغ",
 "desyrel": "ترازودون, ديسيريل (مضاد اكتئاب فموي (الاسم التجاري ديسيريل) وهو دواء غير ثلاثي الحلقات يستخدم كمهدئ)",
 "detachable": "قَابِل لِلْفَصْل, قَابِل لِلْفَكّ (مصمم ليتم فكه أو فصله دون ضرر)\nمثال: قمصان بياقات قابلة للفصل",
 "detached": "مُسْتَقِلّ, مُنْفَصِل (يستخدم للمباني؛ قائمة بمعزل عن غيرها) / غَيْرُ مُنْخَرِطٍ, مُنْفَصِلٌ عَاطِفِيًّا (يُظْهِرُ عَدَمَ انْخِرَاطٍ عَاطِفِيٍّ) / مَفْصُول, مُنْفَصِل (لَمْ يَعُدْ مُتَّصِلًا أَوْ مُلْتَحِمًا) / طَلِيق, مُنْفَصِل (غَيْر مُثَبَّت فِي مَوْضِعِه)\nمثال: منازل منفصلة",
 "detached house": "مسكن مستقل, منزل منفصل (منزل يقف بمفرده)",
 "detached retina": "انفصال الشبكية (ضعف بصري ناتج عن انفصال الشبكية عن المشيمية في الجزء الخلفي من العين)",
 "detachment": "فصل, فك الارتباط (عملية التحرير من مرفق أو اتصال) / انفصال, تفكك (التفرق أو الانقسام) / انسحاب, تجرد (تجنب التورط العاطفي) / مفرزة (وحدة صغيرة من القوات ذات تكوين خاص)",
 "detachment of the retina": "انفصال الشبكية (ضعف بصري ناتج عن انفصال الشبكية عن المشيمية في الجزء الخلفي من العين)",
 "detail": "تَفْصِيل, تَفَاصِيل / فَصَّلَ (التقطيع؛ تقسيم الشيء أجزاءً؛ جزء، باب في كِتَاب أو ماشابهه)\nمثال: اقرأ هذا الفصل.",
 "detail file": "ملف التفاصيل, ملف المعاملات ((علوم الحاسوب) ملف حاسوبي يحتوي على بيانات مؤقتة نسبياً حول مهمة معالجة بيانات معينة)",
 "detailed": "مُفَصَّل",
 "detailing": "تخصيص, تفصيل (وصف فردي لحالة معينة)",
 "details": "تفاصيل, معلومات داخلية (معلومات سرية حقيقية)\nمثال: بعد المحاكمة أعطانا التفاصيل الحقيقية",
 "detain": "اِعْتَقَلَ (أمسك الأطراف وربطها، بمعنى عَقَلَ؛ أمسك ووضع في السجن أو المَعْقَل)\nمثال: اعتقل لقيادته و هو سكران.",
 "detainee": "أسير, أسيرة (اَلْأَسِيرُ هُوَ مَنْ أُسِرَ فِي مَعْرَكَةٍ حَيّّا فَسُجِنَ إِلَى حِينٍ؛ الأَسيرُ: الأَخِيذُ)\nمثال: أنا بريء وأسير حرب.",
 "detainment": "اعتقال, توقيف (حالة الاحتجاز (عادة لفترة قصيرة))\nمثال: كان اعتقاله لدوافع سياسية",
 "detect": "كَشَفَ (كشَّف الأمرَ بالغ في كشْفِه وتوضيحه؛ أزال الغطاء أو جعل الشيء مكشوفًا)\nمثال: كشف كارل المزيد.",
 "detectability": "قابلية الكشف (حالة كون الشيء قابلاً للملاحظة)\nمثال: إحدى المشكلات العملية المهمة في تحليل السلاسل الزمنية الطويلة للسجلات الهيدرولوجية هي تقييم قابلية الكشف للاتجاهات",
 "detectable": "مَحْسُوس, مَكْشُوف (يسهل رؤيته أو اكتشافه) / قَابِلٌ لِلْكَشْف, مُلَاحَظ (يُمْكِنُ كَشْفُهُ أَوِ اكْتِشَافُه)",
 "detected": "مُدْرَك, مُكْتَشَف (أُدرِك بالعقل) / مرصود, مكتشف (تم إدراكه أو تمييزه)\nمثال: المواد النيزكية الدقيقة المكتشفة",
 "detecting": "تحري, كشف الجرائم (تحقيق للشرطة لتحديد الجاني)\nمثال: التحري صعب على القدمين (يتطلب مشياً كثيراً)",
 "detection": "اكتشاف, رصد (فعل اكتشاف شيء ما؛ أو ملاحظة شيء ما) / تحري, كشف الجرائم (تحقيق للشرطة لتحديد الجاني) / استشعار, رصد (الإدراك بأن شيئاً ما قد حدث أو أن حالة ما موجودة) / كشف الإشارة (الكشف عن استقبال إشارة)\nمثال: التحري صعب على القدمين (يتطلب مشياً كثيراً)",
 "detective": "مُحَقِّق (من يُجري تحقيق وتحرِّيات للكشف عن ملابسات قضيَّة غامضة؛ قَاضِي التَّحْقِيقِ الَّذِي يُحَقِّقُ مَعَ الْمُتَّهَمِ فِي قَضِيَّةٍ لِلْكَشْفِ عَنْ مَجْرَيَاتِهَا)\nمثال: تحدث ياني مع محقق.",
 "detective agency": "مكتب تحقيقات خاص, وكالة تحريات (وكالة تقوم بإجراء استفسارات لعملائها)",
 "detective novel": "رواية بوليسية, رواية غموض (رواية يُتحدى فيها القارئ لحل لغز قبل أن يشرحه المحقق في النهاية)",
 "detective story": "قصة بوليسية (سرد عن شخص يحقق في الجرائم ويحصل على أدلة تؤدي إلى حلها)",
 "detective work": "تحري, كشف الجرائم (تحقيق للشرطة لتحديد الجاني)\nمثال: التحري صعب على القدمين (يتطلب مشياً كثيراً)",
 "detector": "حساس, كاشف (أي جهاز يستقبل إشارة أو محفزاً (مثل الحرارة أو الضغط أو الضوء أو الحركة) ويستجيب له بطريقة مميزة) / كاشف (معدات إلكترونية تكشف عن وجود إشارات راديو أو نشاط إشعاعي) / كاشف, مزيل التعديل (مقوم يستخرج التعديل من موجة حاملة لاسلكية)",
 "detent": "سقاطة, لسان (مقبض مفصلي يتناسب مع سن في عجلة سقاطة لتحريك العجلة للأمام أو منعها من التحرك للخلف)",
 "detente": "انفراج, تهدئة (تخفيف التوترات أو العلاقات المتوترة (خاصة بين الدول))",
 "detention": "تَوْقِيف",
 "detention basin": "حوض احتجاز (موقع تخزين (مثل خزان صغير) يؤخر تدفق المياه باتجاه المصب)",
 "detention camp": "دار أحداث, دار احتجاز (مؤسسة يمكن فيها احتجاز الجناة الأحداث مؤقتاً (عادة تحت إشراف محكمة الأحداث))",
 "detention cell": "زنزانة احتجاز جماعي (زنزانة كبيرة يُحبس فيها السجناء (الأشخاص الذين ينتظرون المحاكمة أو الحكم أو اللاجئون أو المهاجرون غير الشرعيين) معاً بشكل مؤقت)",
 "detention centre": "زنزانة احتجاز جماعي (زنزانة كبيرة يُحبس فيها السجناء (الأشخاص الذين ينتظرون المحاكمة أو الحكم أو اللاجئون أو المهاجرون غير الشرعيين) معاً بشكل مؤقت)",
 "detention home": "دار أحداث, دار احتجاز (مؤسسة يمكن فيها احتجاز الجناة الأحداث مؤقتاً (عادة تحت إشراف محكمة الأحداث))",
 "detention house": "دار أحداث, دار احتجاز (مؤسسة يمكن فيها احتجاز الجناة الأحداث مؤقتاً (عادة تحت إشراف محكمة الأحداث))",
 "deter": "رَدَعَ (رَدَعَه عنه: كَفَّهُ ورَدَّهُ، فارْتَدَعَ؛ رَدَعَ جَيْبَه عنه: فَرَجَه)\nمثال: بما أن إسرائيل خسرت حربا في لبنان عام 2006، شنت العديد من حملات قصف كبيرة في غزة كي تسترجع قدرتها على الردع.",
 "detergence": "تَطْهِيرِيَّة, قُدْرَة تَنْظِيفِيَّة (صفة امتلاك قوة التنظيف)",
 "detergency": "تَطْهِيرِيَّة, قُدْرَة تَنْظِيفِيَّة (صفة امتلاك قوة التنظيف)",
 "detergent": "مُطَهِّر, مُنَظِّف",
 "detergent builder": "مادة بناء للمنظفات, محسن منظف (مادة تضاف إلى الصابون أو المنظفات لزيادة فعالية تنظيفها)",
 "deterioration": "تدهور, تردي (عملية التغير إلى حالة أدنى) / تدهور, ضعف (علامة على انخفاض الجودة أو القوة)",
 "determent": "تَخْوِيف, رَدْع (تواصل يجعلك خائفاً من تجربة شيء ما)",
 "determinable": "قابل للتحديد, يمكن تعيينه (قادر على أن يتم تحديده أو حصره أو تثبيته)\nمثال: سرعات قابلة للتحديد",
 "determinant": "مُحَدِّد (من الفعل حَدَّدَ؛ (في الرياضيات) مصطلح يستعمل في الجبر الخطي، ويتم تحديد محدد مصفوفة باستعمال صيغة لايبنتس أو صيغة لابلاس)\nمثال: حضر الجميع إلى الصف في الوقت المحدد",
 "determinate": "حَاسِم, نِهَائِيّ (يُقَدِّمُ تَسْوِيَةً نِهَائِيَّةً أَوْ قَاطِعَةً) / ثابت, محدد (محدد أو مقيد أو معرف بدقة؛ خاصة ما هو مثبت بقاعدة أو سبب محدد وثابت) / محدود النمو ((في النبات) لا يستمر في النمو إلى أجل غير مسمى عند القمة)\nمثال: مسافة محددة",
 "determinateness": "تَحْدِيد, قَطْعِيَّة (صفة القابلية للتنبؤ بثقة كبيرة)",
 "determination": "عَزِيمَة",
 "determinative": "حَاسِمٌ, مُقَرِّر (يملك القدرة أو الصفة اللازمة لاتخاذ القرار) / عامل حاسم, محدد (عنصر أو عامل محدد أو سببي) / محدد (واحد من فئة محدودة من معدلات الأسماء التي تحدد مراجع العبارات الاسمية)\nمثال: التعليم هو محدد مهم لنظرة المرء للحياة",
 "determined": "مَدْفُوع, مُصَمِّم (شديد الدافعية نحو النجاح) / محدد, معلوم (تم معرفته أو العثور عليه أو تحديده خاصة عن طريق التحقيق) / مُصَمِّمٌ (يتميز بتصميم وعزيمة كبيرة) / مَحْسُوم, مُحَدَّد (تمّ تحديده أو البتّ فيه من قِبَل سلطة مختصّة)",
 "determinedly": "بتصميم, بعزم (مع تصميم؛ بطريقة مصممة) / بِطُمُوح (مع الطموح؛ بطريقة طموحة وحيوية)\nمثال: تشبث بالماضي بتصميم",
 "determiner": "مُحَدِّدَة",
 "determining factor": "عامل حاسم, محدد (عنصر أو عامل محدد أو سببي) / حجة حاسمة, عامل حاسم (حجة تكون قاطعة وفاصلة)\nمثال: التعليم هو محدد مهم لنظرة المرء للحياة",
 "determinism": "حَتْمِيَّة",
 "determinist": "حتمي, قدري (أي شخص يسلم بالاعتقاد بأنه عاجز عن تغيير قدره)",
 "deterministic": "حَتْمِيّ, قَطْعِيّ (نتيجة حتمية لأسباب سابقة كافية)",
 "deterministic algorithm": "خَوَارِزْمِيَّة قَطْعِيَّة (خوارزمية: مجموعة من الخطوات والقواعد المحددة التي تُتَّبع لحل مسألة أو تنفيذ مهمة معينة، ولا سيما في الحاسوب)\nمثال: هذه الخوارزمية لا تتقارب.",
 "deterrence": "رَدْع (رَدَعَه عنه: كَفَّهُ ورَدَّهُ، فارْتَدَعَ؛ رَدَعَ جَيْبَه عنه: فَرَجَه)\nمثال: بما أن إسرائيل خسرت حربا في لبنان عام 2006، شنت العديد من حملات قصف كبيرة في غزة كي تسترجع قدرتها على الردع.",
 "deterrent": "رَادِع, زَاجِر (يميل إلى الردع والتثبيط) / عائق, عقبة (شيء غير مادي يتداخل مع أو يؤخر العمل أو التقدم)",
 "deterrent example": "عِبْرَة, مِثَال رَادِع (عقوبة يقصد بها أن تكون تحذيراً للآخرين)\nمثال: قرروا أن يجعلوه عبرة",
 "detersive": "ذُو قُوَّة تَنْظِيفِيَّة, مُنَظِّف (يمتلك قدرة على التنظيف والإزالة)",
 "detestable": "بَشِع, مَقِيت (مكروه بشكل لا لبس فيه) / بَشِع, مَقِيت (مسيء للعقل ومثير للنفور)",
 "detestably": "بِشَكْل بَغِيض, بِشَكْل مَقِيت (بطريقة مسيئة ومكروهة)\nمثال: لا أعرف أي شخص كان يمكن أن يتصرف بمثل هذه الشناعة",
 "detestation": "اشمئزاز, بغض (كراهية مقترنة بالاشمئزاز)",
 "detested": "مَمْقُوت, مُحْتَقَر (يُعامَل بكراهية أو ازدراء)",
 "dethronement": "خلع, عزل (فعل عزل شخص ما؛ إزالة شخص قوي من منصب أو وظيفة)",
 "detonating device": "صاعق, كبسولة تفجير (جهاز تفجير ميكانيكي أو كهربائي أو كمية صغيرة من المتفجرات؛ يمكن استخدامه لبدء تفاعل متفجر مدمر)",
 "detonating fuse": "فتيل التفجير (فتيل يحتوي على مادة متفجرة)",
 "detonation": "تَفْجِير",
 "detonative": "تَفْجِيرِيّ (ينفجر بشكل شبه فوري)",
 "detonator": "صاعق, كبسولة تفجير (جهاز تفجير ميكانيكي أو كهربائي أو كمية صغيرة من المتفجرات؛ يمكن استخدامه لبدء تفاعل متفجر مدمر)",
 "detour": "تحويلة, طريق التفافي (طريق غير مباشر (خاصة الذي يستخدم مؤقتاً أثناء إغلاق الطريق الرئيسي))",
 "detox": "وحدة إزالة السموم (جناح المستشفى أو العيادة التي يتم فيها إزالة السموم من المرضى)",
 "detoxification": "إزالة السموم (علاج للتسمم عن طريق تحييد الخصائص السامة (عادة وظيفة الكبد)) / تخلص من السموم, علاج الإدمان (علاج لإدمان المخدرات أو الكحول يهدف إلى إزالة الآثار الفسيولوجية للمواد المسببة للإدمان)",
 "detraction": "انتقاص, تشهير (فعل تشويه سمعة شخص ما أو الانتقاص منها) / انْتِقَاص, تَشْوِيه سُمْعَة بَسِيط (انتقاص تافه)",
 "detractive": "مُقَلِّل, مُنْتَقِص (يتسبّب في إنقاص الأهمّيّة أو القيمة)",
 "detractor": "ذام, مستخف (من يستخف أو يقلل من قيمة شيء ما)",
 "detribalisation": "إزالة القبلية (تراجع أو إنهاء التنظيم القبلي) / تحديث, تخلى عن القبلية (فعل جعل رجال القبائل يتخلون عن عاداتهم ويتبنون طرق العيش الحضرية)",
 "detribalization": "إزالة القبلية (تراجع أو إنهاء التنظيم القبلي) / تحديث, تخلى عن القبلية (فعل جعل رجال القبائل يتخلون عن عاداتهم ويتبنون طرق العيش الحضرية)",
 "detriment": "أذى, ضرر (تلف أو خسارة)",
 "detrimental": "ضَارّ مُضِرّ",
 "detrimentally": "بِأَذًى, بِشَكْل ضَارّ (بطريقة ضارة)",
 "detrition": "احتكاك, فرك (الجهد المبذول في تحريك جسم فوق آخر مع الضغط) / تآكل, سحج (تآكل جزيئات الصخور عن طريق الاحتكاك بسبب الماء أو الرياح أو الجليد) / بري, تآكل بالاحتكاك (التعرية عن طريق الاحتكاك)",
 "detritus": "فتات الصخور (مادة مفككة (شظايا حجرية وطمي وما إلى ذلك) ناتجة عن تآكل الصخور) / حطام, ركام (بقايا شيء تم تدميره أو تفتيته)",
 "detroit": "ديترويت",
 "detumescence": "زوال التورم (تضاؤل التورم؛ هبوط أي شيء متورم)",
 "deuce": "اثنان, دو (واحدة من أوراق اللعب الأربع في الحزمة التي تحمل نقطتين) / اللعنة, تباً (كلمة تستخدم في تعبيرات الارتباك أو التعجب) / اثْنَان (العدد الأصلي الذي هو مجموع واحد وواحد أو رمز يمثل هذا العدد) / تعادل (تعادل في التنس أو تنس الطاولة يتطلب الفوز بنقطتين متتاليتين للفوز باللعبة)\nمثال: يا إلهي!",
 "deuce-ace": "ثَلَاثَة, ثُلَاثِيّ (العدد الأصلي الذي هو مجموع واحد وواحد وواحد)",
 "deuced": "لَعِين, مَلْعُون ((غير رسمي) شتائم تُستخدَم للتوكيد والتأثير)",
 "deucedly": "بجنون, بشكل شيطاني ((تستخدم للتوكيد) بإفراط)\nمثال: كانت واقعة في الحب بجنون",
 "deus ex machina": "الحَلّ مِنَ السَّمَاء",
 "deuteranopia": "عمى الأخضر (عمى ألوان ثنائي يتميز بانخفاض الحساسية للضوء الأخضر مما يؤدي إلى عدم القدرة على التمييز بين الأخضر والأحمر الأرجواني)",
 "deuteranopic": "مُصَاب بِعَمَى الأَخْضَر (عدم القدرة على رؤية اللون الأخضر أو التمييز بين الأخضر والأحمر الأُرجوانيّ)",
 "deuterium": "ديوتيريوم, هيدروجين ثقيل (نظير للهيدروجين يحتوي على نيوترون واحد (مقارنة بعدم وجود نيوترونات في الهيدروجين العادي))",
 "deuterium oxide": "أكسيد الديوتيريوم, ماء ثقيل (ماء يحتوي على نسبة كبيرة من ذرات الديوتيريوم، يستخدم في المفاعلات النووية)",
 "deuteron": "دِيُوتِرُون (نواة الديوتيريوم؛ تتكون من بروتون واحد ونيوترون واحد؛ تستخدم كجسيم قاذف في المسرعات)",
 "deuteronomy": "سِفْر التَثْنِيَة, سِفْر تَثْنِيَةِ الاِشْتِرَاع (السَّفَرُ : قَطْعُ المسافة؛ هو مِنِّي سفَرٌ : بعيد)\nمثال: صاحبته في السفر.",
 "deutsche mark": "مَارْك أَلْمَانِيّ",
 "deutschmark": "مارك, مارك ألماني (سابقاً وحدة المال الأساسية في ألمانيا)",
 "deutzia": "دوتزية (أي من الشجيرات المختلفة من جنس دوتزية ذات أوراق متقابلة مسننة عادة ولحاء مقشر وزهور بيضاء أو وردية في عناقيد طرفية فضفاضة)",
 "devaluation": "بخس, تقليل القيمة (تخفيض قيمة شيء ما أو أهميته) / تخفيض القيمة (تخفيض رسمي لعملة وطنية؛ انخفاض في قيمة عملة بلد ما بالنسبة لعملات الدول الأجنبية)",
 "devalued": "مُتَدَنٍّ, مُنْخَفِض القِيمَة (تراجعت قيمته؛ انخفض سعره أو مكانته)",
 "devanagari": "دِيفَانَاجَارِي, دِيفَانَاغَارِي",
 "devanagari script": "الخط الديوناكري, ديوناكري (خط مقطعي يُستخدم في كتابة السنسكريتية والهندية)",
 "devastating": "مُبِيد, مُدَمِّر (يَتَسَبَّبُ أَوْ يَقْدِرُ عَلَى التَّدْمِيرِ الكَامِلِ) / سَاحِق, مُدَمِّر (مُدَمِّرٌ مَادِّيًّا أَوْ مَعْنَوِيًّا؛ يُسْتَخْدَمُ غَالِبًا فِي التَّرْكِيبَاتِ) / سَاحِقٌ, مَاحِقٌ (يستخف بالآخرين ويحقرهم)",
 "devastation": "تدمير, دمار (إنهاء وجود شيء ما عن طريق إحداث ضرر كبير لدرجة لا يمكن إصلاحه) / تخريب, تدمير شامل (النهب المصحوب بضرر ودمار مفرط) / خراب شامل, دمار شامل (حدث يؤدي إلى تدمير كامل) / انهيار, صدمة مدمرة (شعور بالارتباك أو الانسحاق)\nمثال: رحيلها تركه في دمار شامل",
 "develop": "طَوَّرَ",
 "developed": "متطور, متقدم (تم تغييره بمرور الوقت ليصبح أقوى أو أكثر اكتمالاً أو فائدة) / مُطَوَّر, مُعَمَّر ((عن العقارات) جُعل أكثر فائدة وربحيّة ببناء طرق ونحوها) / مُتَقَدِّم صِنَاعِيًّا ((عن المجتمعات) ذو تطوّر صناعيّ عالٍ)\nمثال: الصفات المتطورة للنظرة الهيلينية",
 "developed country": "دَوْلَة مُتَقَدِّمَة (بَلَد يتميز بحُدُود معروفة وشَعْب وحُكُومَة ومُؤَسَسَات مُنَظَّمَة؛ مجموعة من الناس مستقلين متحدين معا لتكوين مجتمع لحماية حقوقهم و وضع قوانينهم الخاصة)\nمثال: لبنان دولة صغيرة.",
 "developer": "مُطَوِّر (الشخص الذي يقوم بـ«تطوير» شيء ما، أي تحسينه أو تغييره للأفضل، كمنتج أو نظام أو مهارة؛ في الاستخدام المعاصر، يُقصد به غالبًا «مُطَوِّر البرمجيات» أو «مُطَوِّر التطبيقات» أي شخص يعمل على تصميم وتطوير البرمجيات)",
 "developing": "مُتَخَلِّف, نَامٍ (يتعلق بمجتمعات يشحّ فيها رأس المال اللازم للتصنيع) / تحميض, تظهير (معالجة مادة حساسة للضوء لجعل الصورة مرئية)\nمثال: استغرق تحميض وطباعة صوره ساعتين فقط",
 "developing country": "دَوْلَة نَامِيَّة (بَلَد يتميز بحُدُود معروفة وشَعْب وحُكُومَة ومُؤَسَسَات مُنَظَّمَة؛ مجموعة من الناس مستقلين متحدين معا لتكوين مجتمع لحماية حقوقهم و وضع قوانينهم الخاصة)\nمثال: لبنان دولة صغيرة.",
 "development": "إِعْمَار, تَعْمِير",
 "developmental": "تطوري, تنموي (من أو يتعلق بالتطور أو يشكله)\nمثال: علم نفس النمو",
 "developmental age": "عمر نمائي (مقياس لنمو الطفل (في حجم الجسم أو المهارة الحركية أو الوظيفة النفسية) معبراً عنه بمصطلحات معايير العمر)",
 "developmental anatomy": "تشريح تطوري (فرع التشريح الذي يدرس التغيرات الهيكلية للفرد من الإخصاب إلى النضج)",
 "developmental learning": "تعلم نمائي (التعلم الذي يحدث كجزء طبيعي من التطور المعرفي)",
 "developmental psychology": "علم النفس النمائي, علم نفس الطفل (فرع علم النفس الذي يدرس التطور الاجتماعي والعقلي للأطفال)",
 "developmentally": "تَطَوُّرِيًّا, نَمَائِيًّا (فيما يتعلق بالتطور)\nمثال: متخلف نمائياً",
 "developmentally challenged": "المتخلفون عقلياً, ذوو الإعاقة الذهنية (مجموعة الناس الذين يعانون من تأخر عقلي)\nمثال: أنشأ مدرسة للمتخلفين عقلياً",
 "deverbal noun": "اسم مشتق من فعل, مصدر (اسم مشتق من فعل)",
 "deviance": "انحراف, زيغ (سلوك منحرف) / انحراف, زيغ (حالة أو وضع مختلف بشكل ملحوظ عن المألوف)",
 "deviant": "شَاذّ, مُنْحَرِف (يختلف اختلافًا واضحًا عن المعيار المقبول) / منحرف (شخص ينحرف سلوكه عما هو مقبول خاصة في السلوك الجنسي)",
 "deviate": "شَاذّ, مُنْحَرِف (يختلف اختلافًا واضحًا عن المعيار المقبول) / منحرف (شخص ينحرف سلوكه عما هو مقبول خاصة في السلوك الجنسي)",
 "deviated nasal septum": "انحراف الحاجز الأنفي (تحول غير طبيعي في موقع الحاجز الأنفي؛ حالة شائعة تسبب انسداد الممرات الأنفية وصعوبة في التنفس ونزيف متكرر للأنف)",
 "deviated septum": "انحراف الحاجز (إزاحة غير طبيعية لأي جدار يفصل بين غرفتين (عادة في تجويف الأنف))",
 "deviation": "إِنْحِرَاف",
 "deviationism": "انحرافية حزبية (انشقاق أيديولوجي عن خط الحزب (خاصة الشيوعية الأرثوذكسية))",
 "deviationist": "منحرف (منشق أيديولوجي عن خط الحزب (خاصة عن الشيوعية الأرثوذكسية))",
 "device": "أَدَاة, جِهَاز",
 "device characteristic": "خاصية, ميزة الجهاز (أي خاصية قابلة للقياس لجهاز تقاس في ظل ظروف محددة بدقة)",
 "device driver": "برنامج تعريف, مشغل جهاز ((علم الحاسوب) برنامج يحدد كيفية تواصل الحاسوب مع جهاز طرفي)",
 "devices": "رغبة, هوى (ميل أو رغبة؛ تستخدم عادة في عبارة 'تُرك لهواه' أو 'تُرك وشأنه')\nمثال: في النهاية تركت العائلة المنزل لأهواء هذه القوة الحاقدة",
 "devil": "اَلشَّيْطَان, إِبْلِيس / شَيْطَان, إِبْلِيس ((في الأديان الإبراهيمية) الرُّوح الشِّرِّير الَّذِي يَرْمِي بِكَ لِلتَّهْلُكَةِ لِبُعْدِهِ عَنِ الْخَيْرِ وَطَرِيقِ الْحَقِّ؛ (استعمال مجازي) كُلّ وَلَدٍ مُشَاكِسٍ أَوْ مُتَمَرِّدٍ)\nمثال: العجلة من الشيطان.",
 "devil dog": "جندي مشاة البحرية الأمريكية, مارينز (عضو في سلاح مشاة البحرية الأمريكية)",
 "devil grass": "ثيّل, عشب برمودا (عشب زاحف موطنه أوروبا وعالمي الانتشار الآن في المناطق الدافئة؛ يستخدم للمروج والمراعي خاصة في جنوب الولايات المتحدة والهند)",
 "devil lily": "زنبق النمر (نبات معمر شرق آسيوي له زهور برتقالية محمرة كبيرة منقطة بالأسود ببتلات منحنية للخلف)",
 "devil nettle": "عشبة لاسعة, قراص الدربيون (عشب لاسع في أمريكا الاستوائية)",
 "devil ray": "شيطان البحر (مانتا صغيرة (تصل إلى 4 أقدام) تنتقل في أسراب)",
 "devil tree": "ديتا, شجرة الشيطان (شجرة دائمة الخضرة من شرق آسيا والفلبين ذات أوراق جلدية كبيرة وأزهار خضراء بيضاء صغيرة في مجموعات كثيفة؛ كان يستخدم لحاؤها طبياً)",
 "devil worshiper": "عابد للشيطان (شخص يعبد الشياطين)",
 "devil's advocate": "مُحَامِي الشَّيْطَان",
 "devil's apples": "تفاح المجانين, يبروح (نبات في جنوب أوروبا وشمال أفريقيا له أزهار أرجوانية وثمار صفراء وجذر متشعب كان يُعتقد سابقاً أن له قوى سحرية)",
 "devil's cigar": "سيجار الشيطان (نوع من ساركوسوماتاسيا (كوريوأكتيس جيستر))",
 "devil's claw": "بروبوسيديا, مخالب الشيطان (نبات حولي من جنوب الولايات المتحدة إلى المكسيك له أزهار كبيرة بيضاء أو صفراء مرقطة بالأرجواني ومنقار منحن طويل)",
 "devil's darning needle": "يعسوب (حشرة نحيلة الجسم غير لاسعة ذات أجنحة قزحية الألوان تكون مفرودة عند الراحة؛ تتغذى البالغات والحوريات على البعوض وما إلى ذلك) / لحية العجوز, ياسمين بري فرجيني (نبات متسلق شائع في شرق أمريكا الشمالية يمتد فوق النباتات الأخرى ويحمل عناقيد عديدة من الزهور البيضاء الكريمية الصغيرة)",
 "devil's fig": "أرجيمون, خشخاش شائك (أي نبات من جنس أرجيمون له أزهار بيضاء أو صفراء كبيرة وأوراق وسيقان وقرون شائكة؛ بشكل رئيسي في أمريكا الاستوائية)",
 "devil's flax": "كتان العلجوم, كتانية شائعة (نبات معمر أوروبي شائع ذو زهور صفراء وبرتقالية مبهرجة؛ عشبة ضارة متوطنة في أمريكا الشمالية)",
 "devil's food": "كعكة الشيطان (كعكة شوكولاتة داكنة جداً)",
 "devil's food cake": "كعكة الشيطان (كعكة شوكولاتة داكنة جداً)",
 "devil's milk": "حليب الشيطان, فربيون الشمس (عشبة أوروبية غير جذابة تتحول زهورها نحو الشمس) / حليب الشيطان, فربيون صغير (فربيون من العالم القديم تم إدخاله كعشبة ضارة في شرق الولايات المتحدة)",
 "devil's tongue": "لسان الشيطان, نخيل الثعبان (نبات استوائي لحمي نوعاً ما كريه الرائحة من جنوب شرق آسيا يزرع لكورماته الصالحة للأكل أو في البيوت الزجاجية لأوراقه الكبيرة وقنابته الحمراء الداكنة…)",
 "devil's turnip": "فاشرا بيضاء, لفت الشيطان (كرمة بيضاء الزهر ذات جذور سميكة وتحمل توتاً أسود صغيراً؛ من أوروبا إلى إيران)",
 "devil's urn": "جرة الشيطان (اسم شائع لنوع من ساركوسوماتاسيا بني داكن من الخارج مع مناطق سوداء وأسود من الداخل، ويشبه الكأس العميق)",
 "devil's walking stick": "شجرة أنجليكا الأمريكية, عصا الشيطان (شجرة أو شجيرة نفضية صغيرة تشكل كتلاً في شرق الولايات المتحدة)",
 "devil's weed": "حسك, شرشر (شجيرة استوائية سنوية زاحفة وسامة ذات ثمار تنقسم إلى خمس جويزات شائكة؛ تعتبر عشبة ضارة خطيرة في المراعي)",
 "devil-may-care": "لَا مُبَالٍ, مُتَهَتِّك (يَتَّسِمُ بِعَدَمِ المُبَالَاةِ بِالأَعْرَافِ أَوْ بِسُوءِ السُّمْعَة) / طَائِش, لَا مُبَالٍ (غير مسؤول بمرح وخِفّة)",
 "devil-worship": "عبادة الشيطان (طقوس عبادة الشياطين)",
 "deviled egg": "بيض محشو (أنصاف بيض مسلوق جيداً يهرس صفاره مع المايونيز والتوابل ثم يعاد إلى البياض)",
 "devilfish": "شيطان البحر, مانتا (سمكة راي استوائية ضخمة للغاية تعيش في عرض البحر وتتغذى على العوالق والأسماك الصغيرة؛ عادة ما تكون غير ضارة ولكن حجمها يجعلها خطيرة إذا تم صيدها بالرمح) / أخطبوط (رأسيات أرجل تعيش في القاع لها جسم بيضاوي ناعم بثمانية مجسات طويلة) / حوت رمادي (حوت متوسط الحجم رمادي مسود يعيش في شمال المحيط الهادئ)",
 "devilish": "بِشَيْطَنَة, بِمَكْر شَدِيد (بطريقة شيطانية لعوبة) / إِبْلِيسِيّ, مَاكِر (يُظهر الدهاء أو الخبث أو الشر المميز للشيطان) / شَيْطَانِيّ, مَاكِر بِلُطْف (مرح بجرأة جذّابة ومحبّبة)\nمثال: الاشتراكيون يواجهون عائقاً إضافياً إذا اعتقدوا أن الرأسماليين ليسوا أشراراً فحسب بل أذكياء بشيطنة أيضاً",
 "devilishly": "بجنون, بشكل شيطاني ((تستخدم للتوكيد) بإفراط) / بِشَيْطَنَة, بِمَكْر شَدِيد (بطريقة شيطانية لعوبة) / بِجَهَنَّمِيَّة, بِشَرّ (مثل الشيطان؛ بطريقة شريرة)\nمثال: كانت واقعة في الحب بجنون",
 "devilishness": "شيطانية (خاصية التشبه بالشيطان أو التميز به)\nمثال: تلاشت شيطانية ابتسامته بعد ذلك إلى شيء من الخجل وهو يواصل الحديث",
 "devilment": "أذى, شقاوة (سلوك متهور أو خبيث يسبب الإزعاج أو الضيق للآخرين)",
 "devilry": "أذى, شقاوة (سلوك متهور أو خبيث يسبب الإزعاج أو الضيق للآخرين) / خبث, شرور (سلوك شرير وقاس)",
 "deviltry": "أذى, شقاوة (سلوك متهور أو خبيث يسبب الإزعاج أو الضيق للآخرين) / خبث, شرور (سلوك شرير وقاس)",
 "devilwood": "خشب الشيطان, زيتون أمريكي (شجرة صغيرة من جنوب الولايات المتحدة ذات عناقيد من الزهور البيضاء الباهتة تليها ثمار أرجوانية داكنة)",
 "devious": "غَيْر مُبَاشِر, مُلْتَوٍ (يَنْحَرِف عَنِ المَسَار المُسْتَقِيم) / مُخَاتِل, مُضَلِّل (غَيْر مُبَاشِر بِالِانْحِرَاف عَنِ الطَّرِيق المَقْبُول أَوِ الصَّحِيح؛ مُضَلِّل) / مُخَاتِل, مُرَاوِغ (يتسم بالرياء أو الخداع؛ مراوغ ومتملص)",
 "deviously": "بِالتِوَاء, بِخَدِيعَة (بطريقة ملتوية)\nمثال: حصل على الترقية بالتصرف بمراوغة",
 "deviousness": "التواء, مراوغة (صفة الخداع والعمل بأساليب ملتوية وغير شريفة) / التواء, انحراف (صفة الميل وعدم الاستقامة في المسار)",
 "devisal": "ابتكار, اختلاق (فعل تدبير أو ابتكار شيء ما)",
 "devise": "وصية عقارية ((قانون) هبة لممتلكات عقارية بموجب وصية) / وصية عقارية (وصية للتصرف في الممتلكات العقارية)",
 "devisee": "الموصى له (شخص يورث له ممتلكات (خاصة العقارية) بموجب وصية)",
 "deviser": "مُخَطِّط, مُدَبِّر (شخص يضع الخطط)",
 "devising": "ابتكار, تشكيل (الفعل الذي ينتج عنه ظهور شيء ما إلى الوجود)\nمثال: ابتكار الخطط",
 "devisor": "مُوصٍ بِعَقَار (شخص يوصي بممتلكات عقارية في وصية)",
 "devitalisation": "إضعاف الحيوية (عملية تقليل حيوية شيء ما)",
 "devitalization": "إضعاف الحيوية (عملية تقليل حيوية شيء ما)",
 "devoid": "خَالِي, فَارِغ",
 "devoir": "واجب الاحترام (تعبير رسمي عن الاحترام)",
 "devolution": "لامركزية, نقل السلطة (تفويض السلطة (خاصة من حكومة مركزية إلى حكومة إقليمية)) / انحطاط, تدهور (عملية التراجع من مستوى أعلى إلى مستوى أدنى من القوة الفعالة أو الحيوية أو الجودة الأساسية)",
 "devolvement": "لامركزية, نقل السلطة (تفويض السلطة (خاصة من حكومة مركزية إلى حكومة إقليمية))",
 "devon": "دِيفُون",
 "devonshire cream": "قشطة متخثرة (قشطة سميكة مصنوعة من الحليب المبستر الساخن)",
 "devote": "توفر على, صرف همته إلى",
 "devoted": "مُخْلِص, وَفِيّ (شديد الإخلاص والمودّة والتفاني)",
 "devotedly": "بِإِخْلَاص, بِتَفَانٍ\nمثال: خدم سيده بتفان",
 "devotedness": "إخلاص, تفانٍ (مشاعر الحب الشديد)\nمثال: كان تفانيهما لبعضهما البعض جميلاً",
 "devotee": "مُحِبّ, مُشَجِّع (تابع ومُعجب متحمس)",
 "devotion": "تَفَرُّغ",
 "devotional": "عبادة قصيرة (خدمة دينية قصيرة) / تَعَبُّدِيّ (متعلّق بالعبادة وشعائرها)",
 "devour": "اِلْتَهَمَ",
 "devourer": "آكل نهم, ملتهم (شخص يأكل بنهم أو شراهة)",
 "devout": "مُتَدَيِّن",
 "devoutly": "بِتَدَيُّن, بِتَقْوَى (بطريقة ورعة وتقية)\nمثال: كانت كاثوليكية ورعة",
 "devoutness": "تبتل, تدين (التقوى بحكم كون الشخص متعبداً ومخلصاً دينياً)",
 "devshirme": "دَوْشِيرْمَة",
 "dew": "نَدَى, طَلّ",
 "dew point": "نقطة الندى (درجة الحرارة التي يتشبع عندها بخار الماء في الهواء ويبدأ التكثيف)",
 "dew worm": "دودة الأرض (دودة برية تحفر في التربة وتساعد في تهويتها؛ تظهر غالباً عندما تكون الأرض باردة أو رطبة؛ تستخدم كطعم من قبل الصيادين)",
 "dewar": "قارورة ديوار (قارورة مفرغة تحفظ الهواء السائل أو الهيليوم للتجارب العلمية)",
 "dewar flask": "قارورة ديوار (قارورة مفرغة تحفظ الهواء السائل أو الهيليوم للتجارب العلمية)",
 "dewberry": "توت الندى (فواكه تشبه توت العليق لأي من شجيرات العليق الزاحفة المتعددة) / توت العليق الزاحف, ديوبيري (أي من عدة شجيرات عليق زاحفة خاصة في أمريكا الشمالية)",
 "dewberry bush": "توت العليق الزاحف, ديوبيري (أي من عدة شجيرات عليق زاحفة خاصة في أمريكا الشمالية)",
 "dewclaw": "زمعة",
 "dewdrop": "قطرة ندى (قطرة من الندى)",
 "dewey decimal classification": "تصنيف ديوي العشري (نظام تستخدمه المكتبات لتصنيف المنشورات غير الروائية إلى فئات موضوعية)",
 "dewey decimal system": "تصنيف ديوي العشري (نظام تستخدمه المكتبات لتصنيف المنشورات غير الروائية إلى فئات موضوعية)",
 "deweyan": "ديوي (من أو يتعلق بجون ديوي أو فلسفته)",
 "dewiness": "نداوة (حالة أو خاصية التغطية بالندى، أو حمل قطرات الماء)\nمثال: يخفف هذا المنتج بعضاً من نداوة المرطب الملون الذي استخدمناه سابقاً ولكنه لا يزال يترك البشرة بلمعان خفيف",
 "dewlap": "غَبَب, لُغْد",
 "dewy": "مُبَلَّل بِالنَّدَى, مُنَدًّى (مبلَّل بالندى)",
