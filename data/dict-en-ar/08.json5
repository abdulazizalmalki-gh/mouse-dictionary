 "descriptive linguistics": "لسانيات وصفية (وصف (في وقت معين) للغة فيما يتعلق بأصواتها وصرفها ونحوها ودلالاتها دون أحكام قيمية)",
 "descriptively": "بِشَكْل وَصْفِيّ, وَصْفِيًّا (عن طريق إعطاء وصف)\nمثال: هذه المواضيع تحتاج إلى المعالجة ليس فقط وصفياً",
 "descriptivism": "وصفية ((لسانيات) مذهب يدعم أو يعزز اللسانيات الوصفية) / وصفية ((أخلاق) مذهب يرى أن البيانات الأخلاقية لها قيمة حقيقة)",
 "descriptor": "كلمة دالة, واصف (معلومة مخزنة تُستخدم لتحديد عنصر في نظام تخزين واسترجاع المعلومات) / شكل الكلمة, صيغة (المظهر الصوتي أو الكتابي للكلمة الذي يمكن استخدامه لوصف أو تحديد شيء ما)",
 "descurainia pinnata": "خردل حشيشة الدود, ديسكورينيا (عشب من أمريكا الشمالية بأوراق ريشية مرة المذاق تشبه أوراق حشيشة الدود)",
 "desecrated": "مدنس, منتهك الحرمة (تم التعامل معه بقلة احترام وازدراء)\nمثال: العديد من الأضرحة والمقابر المدنسة",
 "desecration": "ازدراء المقدسات, تجديف (سلوك تجديفي؛ فعل تجريد الشيء من طابعه المقدس)\nمثال: تدنيس السبت المقدس",
 "desegrated": "غَيْرُ مَفْصُول, مُنْهِي لِلْفَصْل (أُزيل منه الفصل العنصري؛ انتهى فيه التمييز)",
 "desegregation": "إِدْمَاج, دَمْج (فعل دمج مجموعة عرقية أو دينية في مجتمع ما)",
 "desensitisation": "إزالة التحسس (عملية تقليل الحساسية)\nمثال: تتحسر على عدم اكتراث المجتمع التدريجي لفظائع كراهية الأجانب",
 "desensitisation procedure": "إزالة التحسس, إزالة الحساسية المنهجية (تقنية تستخدم في العلاج السلوكي لعلاج الرهاب ومشاكل السلوك الأخرى التي تنطوي على القلق؛ يتعرض العميل للموقف المهدد تحت ظروف استرخاء حتى يتم إطفاء رد…)",
 "desensitisation technique": "إزالة التحسس, إزالة الحساسية المنهجية (تقنية تستخدم في العلاج السلوكي لعلاج الرهاب ومشاكل السلوك الأخرى التي تنطوي على القلق؛ يتعرض العميل للموقف المهدد تحت ظروف استرخاء حتى يتم إطفاء رد…)",
 "desensitising": "مبلد للحس, مزيل للحساسية (يجعل الشخص أو الشيء أقل عرضة أو حساسية للمحفزات الجسدية أو العاطفية)",
 "desensitization": "إزالة التحسس (عملية تقليل الحساسية)\nمثال: تتحسر على عدم اكتراث المجتمع التدريجي لفظائع كراهية الأجانب",
 "desensitization procedure": "إزالة التحسس, إزالة الحساسية المنهجية (تقنية تستخدم في العلاج السلوكي لعلاج الرهاب ومشاكل السلوك الأخرى التي تنطوي على القلق؛ يتعرض العميل للموقف المهدد تحت ظروف استرخاء حتى يتم إطفاء رد…)",
 "desensitization technique": "إزالة التحسس, إزالة الحساسية المنهجية (تقنية تستخدم في العلاج السلوكي لعلاج الرهاب ومشاكل السلوك الأخرى التي تنطوي على القلق؛ يتعرض العميل للموقف المهدد تحت ظروف استرخاء حتى يتم إطفاء رد…)",
 "desensitizing": "مبلد للحس, مزيل للحساسية (يجعل الشخص أو الشيء أقل عرضة أو حساسية للمحفزات الجسدية أو العاطفية)",
 "desert": "صَحْرَاء (الصَّحْرَاءُ : الفَضاءُ الواسِعُ لا نباتَ به، نادرة الماء مرتفعة درجات الحرارة ولا حياة فيها؛ الصَّحْرَاءُ : الأرضُ المُسْتَوِيةُ في لِينٍ وغِلَظٍ دُونَ القُفِّ) / صحرة / صحرا / بَرّ (أحسن إلى والديه أو إلى غيره بالخير والاحترام؛ صدق أو وفى بوعد أو عهد) / فَرَّ / جَزاء\nمثال: عاد إلى الصحراء.",
 "desert boot": "جزمة نصفية, حذاء قتالي (حذاء يصل إلى منتصف الطريق نحو الركبة)",
 "desert date": "هِجْلِيج, هَجْلِيج",
 "desert four o'clock": "شب الليل الصحراوي, شب الليل كولورادو (زهرة برية ذات زهور أنبوبية وردية عميقة نابضة بالحياة تتفتح مساءً؛ توجد في المناطق الرملية والصحراوية من جنوب كاليفورنيا إلى جنوب كولورادو وإلى المكسيك)",
 "desert holly": "رغل غشائي, هولي الصحراء (شجيرة ملحية منخفضة وسيمة في المناطق القاحلة بجنوب غرب الولايات المتحدة والمكسيك لها أوراق زرقاء خضراء شائكة الحواف تستخدم غالباً لزينة عيد الميلاد)",
 "desert iguana": "إغوانة صحراوية (سحلية صغيرة طويلة الذيل من المناطق القاحلة في جنوب غرب الولايات المتحدة وشمال غرب المكسيك)",
 "desert lynx": "عناق الأرض, وشق الصحراء (يعيش في صحاري شمال أفريقيا وجنوب آسيا)",
 "desert mariposa tulip": "توليب ماريبوسا الصحراوي (ماريبوسا بعناقيد من الزهور القرمزية أو البرتقالية أو الصفراء جرسية الشكل فوق سيقان قصيرة؛ جنوب كاليفورنيا إلى أريزونا والمكسيك)",
 "desert olive": "زيتون الصحراء (شجيرة متفرعة شائكة متساقطة الأوراق من جنوب غرب الولايات المتحدة لها عناقيد من الزهور الصفراء البيضاء غير الملحوظة تظهر قبل الأوراق تليها ثمار سوداء…)",
 "desert paintbrush": "فرشاة الرسم الصحراوية, كاستيليجا كروموزا (أكثر أنواع فرشاة الرسم شيوعاً في الأراضي الجافة غرب الولايات المتحدة؛ لها سيقان منتصبة تنتهي بسنابل كثيفة من الزهور البرتقالية الزاهية إلى الحمراء)",
 "desert pea": "بازلاء الصحراء, بازلاء ستورت (نبات معمر شجيري مترامي الأطراف يشتهر بزهوره القرمزية المعلمة بالأسود؛ واسع الانتشار في الأجزاء الجافة من أستراليا)",
 "desert plant": "نبات جفافي, نبات صحراوي (نبات متكيف للحياة مع إمدادات محدودة من الماء؛ قارنه بالنبات المائي والنبات الوسطي)",
 "desert plume": "ريشة الأمير, ستانليا (نبات معمر من جنوب غرب الولايات المتحدة له أوراق ريشية جلدية زرقاء خضراء وسنابل سميكة تشبه الريش من الزهور الصفراء؛ يوضع أحياناً في جنس كليوم)",
 "desert rat": "جرذ الصحراء, جرذ كنغري (أي من القوارض القافزة المتنوعة في المناطق الصحراوية في أمريكا الشمالية والمكسيك؛ أكبر أعضاء فصيلة الفئران المتغايرة)",
 "desert rheumatism": "حمى الوادي, فطار كرواني (عدوى في الرئتين والجلد تتميز ببلغم مفرط وعقيدات)",
 "desert rose": "زَهْرة صَحْراء, وَرْدة صَحْراء",
 "desert sand verbena": "لويسية رملية صحراوية (نبات لزج ناعم الشعر ذو رؤوس من الزهور الوردية الزاهية قمعية الشكل؛ يوجد في التربة الصحراوية الرملية؛ بعد الأمطار الغزيرة قد يفرش أميالاً من الصحراء…)",
 "desert selaginella": "سيلاجينيلا الصحراء (طحلب سنبلة منبطح؛ كاليفورنيا)",
 "desert soil": "تربة صحراوية (نوع من التربة يتطور في المناخات القاحلة)",
 "desert sunflower": "جيريا, دوار الشمس الصحراوي (نبات مشعر نحيل ذو أوراق قليلة ورؤوس زهرية صفراء ذهبية؛ المناطق الصحراوية الرملية من جنوب شرق كاليفورنيا إلى جنوب غرب يوتا وغرب أريزونا وشمال غرب…)",
 "desert tortoise": "سلحفاة صحراوية (سلحفاة تحفر الجحور من المناطق القاحلة في غرب الولايات المتحدة وشمال المكسيك)",
 "desert willow": "شيلوبسيس, صفصاف صحراوي (شجرة شجيرية دائمة الخضرة تشبه الصفصاف في المناطق الجافة في جنوب غرب أمريكا الشمالية، لها زهور أرجوانية بارزة وقرون بذور طويلة)",
 "deserted": "مَهْجُور",
 "deserter": "هَارِب",
 "desertic soil": "تربة صحراوية (نوع من التربة يتطور في المناخات القاحلة)",
 "desertification": "تَصَحُّر",
 "desertion": "فِرَار, هَجْر",
 "deserve": "اِسْتَحَقَّ",
 "deserved": "مجازى, مستحق (مستحق بشكل صحيح)\nمثال: نجاح مستحق",
 "deservedly": "بِاسْتِحْقَاق, عَنْ جَدَارَة (كما يستحق)\nمثال: سجل هدفين مما أعطى بولتون عن جدارة فوزهم الثاني في الموسم",
 "deserving": "جَدِير, مُسْتَحِقّ ((يُسْتَخْدَمُ أَحْيَانًا بِسُخْرِيَةٍ) جَدِيرٌ بِأَنْ يُعَامَلَ بِطَرِيقَةٍ مُعَيَّنَةٍ)",
 "deservingness": "اسْتِحْقَاق, جَدَارَة (صفة كون الشخص مستحقاً (مثلاً، استحقاق المساعدة))",
 "deshabille": "هندام غير مرتب (حالة ارتداء الملابس بإهمال أو جزئياً)",
 "desiccant": "عامل تجفيف, مادة مجففة (مادة تعزز الجفاف (مثل أكسيد الكالسيوم الذي يمتص الماء ويستخدم لإزالة الرطوبة))",
 "desiccate": "جَافّ, عَقِيم (يفتقر إلى الحيوية أو الروح؛ بلا حياة)",
 "desiccated": "جَافّ, عَقِيم (يفتقر إلى الحيوية أو الروح؛ بلا حياة) / مَنْزُوع الرُّطُوبَة, مُجَفَّف (مَحْفُوظ بِإِزَالَة الرُّطُوبَة الطَّبِيعِيَّة) / مُجَفَّف كُلِّيًّا (جُفِّف بالكامل ونُزعت منه كلّ الرطوبة)",
 "desiccation": "تتجفاف, تجفيف (عملية استخلاص الرطوبة) / تجفيف, جفاف (الجفاف الناتج عن إزالة الماء)",
 "desideratum": "بغية, رغبة (شيء مرغوب فيه كضرورة)\nمثال: متطلبات الإجازة هي الوقت والمال",
 "design": "تَخْطِيط, تصميم (مصدر من خَطَّطَ؛ في : فكرةٌ مُثبتة بالرسم، أو الكتابة في حالة الخطّ. تدلّ دلالةً تامَّة على ما يُقصد في الصُّورة أو الرسم أَو اللَّوح المكتوب من المعنى والموضوع…) / تَصْمِيم, ديزاين\nمثال: يعمل في قسم التخطيط.",
 "design criteria": "معايير التصميم (المعايير التي يجب على المصممين الوفاء بها عند تصميم نظام أو جهاز ما)\nمثال: لخصت مواصفات الوظيفة معايير التصميم",
 "designated driver": "سائق مُعَيَّن, سائق مُكَلَّف (عضو في مجموعة يتم تعيينه للامتناع عن الكحول ليكون رصيناً عندما يحين وقت القيادة إلى المنزل)",
 "designated hitter": "ضارب مخصص (لاعب كرة يتم تعيينه للضرب بالمضرب بدلاً من رامي الكرة)",
 "designation": "تحديد الهوية, تعيين (فعل تعيين أو تحديد هوية شيء ما) / تسمية, تعيين (فعل وضع شخص في منصب غير انتخابي) / تسمية, لقب (كلمة أو كلمات تعريفية يُدعى بها شخص أو شيء ويُصنف أو يتميز بها عن الآخرين)\nمثال: كان يجب الموافقة على التعيين من قبل اللجنة بأكملها",
 "designative": "تَعْيِينِيّ (يَخْدُمُ غَرَضَ التَّعْيِينِ وَالتَّحْدِيد)",
 "designatum": "مَدْلُول, مُسَمَّى (شيء (سواء كان موجوداً أم لا) يشار إليه بتعبير لغوي)",
 "designed": "مقصود, مُصمَّم (تم فعله أو صنعه أو أداؤه بغرض ونية)\nمثال: الأسلوب؛ هو أكثر من مجرد إبداع متعمد ومصمم",
 "designedly": "بتعمد, عمداً (بنية؛ بطريقة متعمدة)\nمثال: استخدم تلك الكلمة عمداً",
 "designer": "مُصَمِّم, مُصَمِّمَة",
 "designer drug": "عقار مصمم (عقار ذو تأثير نفسي تم تصنيعه عمداً لتجنب قوانين مكافحة المخدرات؛ يحاكي تأثيرات عقار محظور؛ تم تعديل القانون في عام 1986 لحظر العقاقير المصممة)",
 "designing": "مُحْتَال, مُدَبِّر (يُخفي خططًا ماكرة لتحقيق مصلحته الشخصيّة) / تصميم (فعل استنباط شكل شيء ما (عن طريق عمل رسم تخطيطي أو مخطط أو خطة))\nمثال: ساهم في تصميم آلة موسيقية جديدة",
 "desinential inflection": "إِعْرَاب (في هو)",
 "desipramine": "ديسيبرامين (دواء مضاد للاكتئاب ثلاثي الحلقات ينشط الجهاز النفسي الحركي)",
 "desirability": "إثارة, جاذبية جنسية (الجاذبية للجنس الآخر) / جَاذِبِيَّة, مَرْغُوبِيَّة (صفة كون الشيء جديراً بالرغبة فيه)",
 "desirable": "مرغوب فيه, مستحب (يستحق الامتلاك أو السعي إليه أو تحقيقه) / جَدِير, لَائِق (جدير بالاختيار خاصة كشريك زواج)\nمثال: وظيفة مرغوبة",
 "desirableness": "إثارة, جاذبية جنسية (الجاذبية للجنس الآخر) / جَاذِبِيَّة, مَرْغُوبِيَّة (صفة كون الشيء جديراً بالرغبة فيه)",
 "desire": "رَغِبَ ((رَغُبَ) رُغْبًا، ورَغابةً: اتَّسَع وعظُم؛ يقال: (رَغُبَ) الوادي) / رَغْبَة\nمثال: يمكن لتوم البقاء إن رغب.",
 "desire line": "مَسْلَك بَرِّيّ (المَسْلَك: الطريقُ سلكنا مَسْلكًا لم يسلكه أحد من قبل ، - مسالك الجبال ، - هذا مَسْلك وعر؛ المَسْلَك: سلوك، تصرُّف)\nمثال: يعرف السكان المحليون ذلك المسلك.",
 "desire to know": "رغبة في المعرفة, نهم للعلم (فضول يحفز البحث والدراسة)",
 "desired": "مَرْغُوب, مُشْتَهَى (مطلوب بشدّة وإلحاح)",
 "desirous": "تواق, راغب (لديه أو يعبر عن رغبة في شيء ما)\nمثال: راغب في منصب رفيع",
 "desk": "مَكْتَب, مِنْضَدَة (الموضع الذي يُكتَب عليه. بعكس المَكْتَب الذي يكتب فيه؛ مِنْضَدَة مخصصة للكتابة، سواء كانت للمَكَاتِب أم لغيرها)\nمثال: عاد إلى المكتب.",
 "desk clerk": "كاتب الاستقبال, موظف استقبال الفندق (موظف استقبال في فندق)",
 "desk dictionary": "قاموس مكتبي (قاموس موجز بحجم مناسب للحمل باليد)",
 "desk officer": "ضابط مكتب (ضابط عسكري غير معين في الخدمة الميدانية النشطة)",
 "desk phone": "هاتف مكتبي (جهاز هاتف يوضع على مكتب أو طاولة)",
 "desk sergeant": "رَقِيب المَكْتَب, ضابِط النُّوبِتْجِيَّة (رقيب الشرطة المناوب في مركز الشرطة)",
 "desk-bound": "مَكْتَبِيّ (مقتصر على العمل المكتبيّ دون النشاط البدنيّ)",
 "deskbound": "مَكْتَبِيّ (مقتصر على العمل المكتبيّ دون النشاط البدنيّ)",
 "deskman": "رقيب مكتب (رقيب مكتب ذكر (في الشرطة))",
 "desktop": "سَطْح الْمَكْتَب (سَطحَهُ يَسْطَحَ سَطْحًا: بَسَطَهُ وسَوّاه؛ فهو مَسْطُوحٌ، وسَطِيحٌ)\nمثال: هناك ثقوب على السطح.",
 "desktop computer": "حاسوب مكتبي (حاسوب شخصي صغير بما يكفي ليوضع بشكل ملائم في مساحة عمل فردية)",
 "desktop publishing": "نشر مكتبي ((علم الحاسوب) استخدام الحواسيب الصغيرة ذات القدرات الرسومية لإنتاج مواد مطبوعة)",
 "deskwoman": "رقيبة مكتب (رقيبة مكتب أنثى (في الشرطة))",
 "desmanthus illinoensis": "ديسمانثوس, ميموزا البراري (عشب معمر في براري أمريكا الشمالية له رؤوس كثيفة من الزهور البيضاء الصغيرة)",
 "desmid": "دسميد (طحالب خضراء تعيش في المياه العذبة)",
 "desmodium gyrans": "نبات التلغراف, نبات الراقص (شجيرة آسيوية استوائية منتصبة تدور وريقاتها الجانبية الصغيرة على محاورها وتهتز صعوداً وهبوطاً تحت تأثير أشعة الشمس)",
 "desmodium motorium": "نبات التلغراف, نبات الراقص (شجيرة آسيوية استوائية منتصبة تدور وريقاتها الجانبية الصغيرة على محاورها وتهتز صعوداً وهبوطاً تحت تأثير أشعة الشمس)",
 "desmodium purpureum": "عشبة المتسول (نبات علفي من جزر الهند الغربية يزرع في جنوب الولايات المتحدة كعلف ولتحسين التربة)",
 "desmodium tortuosum": "عشبة المتسول (نبات علفي من جزر الهند الغربية يزرع في جنوب الولايات المتحدة كعلف ولتحسين التربة)",
 "desmodus rotundus": "خفاش مصاص الدماء الشائع (خفاش بحجم الفأر من أمريكا الوسطى والجنوبية الاستوائية له قواطع وأنياب حادة؛ يتغذى على دماء الطيور والثدييات)",
 "desolate": "مُقْفِر, مَهْجُور",
 "desolately": "بِغَمّ, بِكَآبَة (في وحدة منكوبة بالحزن؛ بدون ظروف أو آفاق مريحة)",
 "desolation": "خراب شامل, دمار شامل (حدث يؤدي إلى تدمير كامل) / خواء, وحدة (الحزن الناتج عن الهجر أو الترك) / عراء, قفار (جو موحش ومقفر) / خراب, دمار (حالة التحلل أو التدمير)\nمثال: عراء المنظر الطبيعي",
 "desorption": "انتزاز, فصل الامتزاز (التحول من حالة الامتزاز على سطح ما إلى حالة غازية أو سائلة)",
 "desoxyribonucleic acid": "حمض نووي ريبوزي منقوص الأكسجين (بوليمر خطي طويل يوجد في نواة الخلية ويتكون من نيوكليوتيدات ويشكل لولباً مزدوجاً؛ يرتبط بنقل المعلومات الوراثية)",
 "despair": "يَئِسَ / يَأْس",
 "despairing": "مُسْتَمِيت, يَائِس (ناشئ عن اليأس أو يتَّسم بفقدان الأمل)",
 "despairingly": "بِقُنُوط, بِيَأْس (مع اليأس)\nمثال: 'لماذا لا تستطيع الفهم؟' سألت بيأس",
 "despatch": "إرسال, إيفاد (فعل إرسال شيء ما) / إجهاز, قتل (قتل شخص أو حيوان (بسرعة)) / سرعة الإنجاز, كفاءة (خاصية كونه سريعاً وفعالاً) / برقية, بلاغ (تقرير رسمي (يرسل عادة على عجل))\nمثال: تم إنجازه بسرعة وكفاءة",
 "desperado": "خارج عن القانون يائس (خارج عن القانون جريء (خاصة في الحدود الأمريكية))",
 "desperate": "يَائِس, قَانِط / مَيْئُوس مِنْهُ",
 "desperate criminal": "خارج عن القانون يائس (خارج عن القانون جريء (خاصة في الحدود الأمريكية))",
 "desperate measure": "إجراء يائس (إجراءات يائسة تتخذ كوسيلة لغاية)\nمثال: اضطر للجوء إلى إجراءات يائسة",
 "desperate straits": "ضائقة شديدة, ظروف يائسة (حالة من الضيق الشديد)",
 "desperately": "بإلحاح, بشكل عاجل (بإلحاح شديد) / باستماتة, بيأس (بيأس شديد)\nمثال: إصلاح الرعاية الصحية مطلوب بشكل عاجل",
 "desperation": "استماتة, يأس (تهور يائس) / قنوط, يأس (حالة فقدان كل أمل أو غيابه)\nمثال: كانت سياسة يائسة",
 "despicability": "حقارة, خسة (عدم الجدارة بسبب الافتقار إلى القيم العليا)",
 "despicable": "حَقِير, دَنِيء (مستنكَر أخلاقياً؛ يستحق الاحتقار)",
 "despicableness": "حقارة, خسة (عدم الجدارة بسبب الافتقار إلى القيم العليا)",
 "despicably": "بِخِسَّة, بِدَنَاءَة (بطريقة حقيرة)\nمثال: تصرف بخسة",
 "despisal": "احتقار, ازدراء (شعور بالكراهية المصحوبة بالاحتقار)",
 "despise": "اِحْتَقَرَ, أَهَانَ",
 "despised": "مَمْقُوت, مُحْتَقَر (يُعامَل بكراهية أو ازدراء)",
 "despising": "احتقار, ازدراء (شعور بالكراهية المصحوبة بالاحتقار)",
 "despite": "رَغْمَ, بِالرَّغْمِ مِن ((رَغَمَ) رَغْمًا، ومَرْغَمًا، ومَرْغَمَةً: ذَلَّ؛ (رَغَمَ) ذل عن كَرْه. يقال (رغَمَ) أَنْفُه)\nمثال: إنه سعيد رغم فقره.",
 "despiteful": "اِنْتِقَامِيّ, حَقُود (يُظهر سوء نية خبيثة ورغبة في الإيذاء؛ مدفوع بالحقد)",
 "despitefully": "بِحِقْد, بِغِلّ (بطريقة حاقدة خبيثة)\nمثال: صلوا من أجل أولئك الذين يسيئون إلينا بحقد",
 "despoilation": "تجريد, سلب (فعل التجريد والأخذ بالقوة)",
 "despoiled": "مَنْهُوب, مُخَرَّب (تَعَرَّضَ لِلنَّهْبِ وَالتَّدْمِيرِ بِالقُوَّةِ وَالعُنْف)",
 "despoiler": "سالب, ناهب (شخص يأخذ الغنائم أو الأسلاب (كما في الحرب))",
 "despoilment": "تجريد, سلب (فعل التجريد والأخذ بالقوة)",
 "despoliation": "تجريد, سلب (فعل التجريد والأخذ بالقوة)",
 "despondence": "انكسار, قنوط (الشعور بالإحباط واليأس وتثبيط الهمة)",
 "despondency": "انكسار, قنوط (الشعور بالإحباط واليأس وتثبيط الهمة)",
 "despondent": "قَانِط, أَسْوَان",
 "despondently": "بِقُنُوط, بِيَأْس (مع اليأس)\nمثال: 'لماذا لا تستطيع الفهم؟' سألت بيأس",
 "despot": "طَاغٍ, الطَاغِي",
 "despotic": "اسْتِبْدَادِيّ, دِكْتَاتُورِيّ (يَتَّسِمُ بِخَصَائِصِ الحَاكِمِ المُطْلَقِ أَوِ الحُكْمِ المُطْلَق؛ ذُو سِيَادَةٍ مُطْلَقَة) / اسْتِبْدَادِيّ, طُغْيَانِيّ (يَحْكُمُهُ مُسْتَبِدٌّ أَوْ يَتَّسِمُ بِخَصَائِصِ الاسْتِبْدَاد) / استبدادي, طغياني (ينتمي إلى أو يمتلك خصائص المستبد)",
 "despotical": "استبدادي, طغياني (ينتمي إلى أو يمتلك خصائص المستبد)",
 "despotism": "اِسْتِبْدَاد, ظُلْم (مصدر الفعل \"اسْتَبَدَّ\"؛ الحزم وعدم التردد في اتخاذ القرار وتنفيذه)",
 "desquamation": "انسلاخ, تقشر (فقدان أجزاء من الجلد الخارجي عن طريق التقشير أو التساقط)",
 "dessert": "حَلْوَى, حَلْوَيَات",
 "dessert apple": "تفاح للأكل, تفاح مائدة (تفاح يستخدم بشكل أساسي للأكل نيئًا دون طهي)",
 "dessert plate": "طبق الحلوى (طبق صغير يمكن تقديم الحلوى عليه)",
 "dessert spoon": "ملعقة حلوى (ملعقة أكبر من ملعقة الشاي وأصغر من ملعقة الطعام)",
 "dessert wine": "نبيذ التحلية, نبيذ الحلوى (نبيذ حلو ساكن يُقدم غالباً مع الحلوى أو بعد الوجبة)",
 "dessertspoon": "ملء ملعقة حلوى (بقدر ما تستوعبه ملعقة حلوى)",
 "dessertspoonful": "ملء ملعقة حلوى (بقدر ما تستوعبه ملعقة حلوى)",
 "dessiatine": "ديسياتين (وحدة مساحة روسية سابقة تساوي 2.7 فدان (إيكر))",
 "destabilisation": "زعزعة الاستقرار (فعل زعزعة الاستقرار؛ جعل الشيء أقل استقرارًا (خاصة الحكومة أو البلد أو الاقتصاد))",
 "destabilization": "زعزعة الاستقرار (فعل زعزعة الاستقرار؛ جعل الشيء أقل استقرارًا (خاصة الحكومة أو البلد أو الاقتصاد)) / زعزعة الاستقرار, فقدان التوازن (حدث يسبب فقدان التوازن (كما في السفينة أو الطائرة))",
 "destalinisation": "اجتثاث الستالينية (العملية الاجتماعية لتحييد نفوذ جوزيف ستالين من خلال مراجعة سياساته وإزالة النصب التذكارية المخصصة له وإعادة تسمية الأماكن المسماة باسمه)\nمثال: تم هدم تمثاله كجزء من اجتثاث الستالينية",
 "destalinization": "اِجْتِثَاثُ ٱلستالينِيَّة",
 "destination": "وِجْهَة, وُجْهَة",
 "destined": "مَحْتُوم, مُقَدَّر ((يُتبع عادة بـ 'أن') محكوم بالقدر) / ذَاهِب, مُتَّجِه (متجه أو ينوي التوجه في اتجاه معين)",
 "destiny": "قدر, مصير (حدث (أو مسار أحداث) سيحدث حتماً في المستقبل) / قضاء, قَدَر (القوة النهائية التي يُنظر إليها على أنها تحدد مسار الأحداث مسبقاً) / حظ, قدر (ظروفك العامة أو حالتك في الحياة (بما في ذلك كل ما يحدث لك))\nمثال: نحن عاجزون أمام القدر",
 "destitute": "خَالٍ, عَدِيم (يفتقر بشكل كامل إلى شيء ما) / مُعْدَم, مُعْوِز (فقير لدرجة الحاجة إلى مساعدة الآخرين)",
 "destitution": "إملاق, عدم (حالة بدون أصدقاء أو مال أو آفاق)",
 "destroy": "دَمَّرَ",
 "destroyable": "قَابِلٌ لِلتَّدْمِير (يُمْكِنُ تَدْمِيرُه)",
 "destroyed": "محطم, مدمر (تالف أو خرب أو مهدوم) / خَرِب, مُدَمَّر (مُدمَّر جسدياً أو أخلاقياً)\nمثال: خلفت الحرب العديد من المدن المدمرة",
