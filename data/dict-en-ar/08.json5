 "drixoral": "دريكسورال (الاسم التجاري لدواء يستخدم لعلاج احتقان الجهاز التنفسي العلوي؛ يحتوي على مضاد للهيستامين وموسع للقصبات ومضيق للأوعية)",
 "drizzle": "رَذَّ, بَغَشَ (رذ - يرذ ، رذاذا؛ رذت السماء : أمطرت الرذاذ) / تبول / رَذَاذ, بَغْشَة",
 "drizzling": "رَذَاذِيّ ((عن المَطَر) يَتَسَاقَطُ خَفِيفًا فِي قَطَرَاتٍ دَقِيقَةٍ جِدًّا)",
 "drizzly": "رَذَاذِيّ, مُمْطِر قَلِيلًا (مبلَّل بالمطر الخفيف أو الرذاذ)",
 "drms": "خدمة إعادة الاستخدام والتسويق الدفاعي (المنظمة في وكالة اللوجستيات الدفاعية التي تقوم بجرد وتقييم وبيع الفائض الحكومي الأمريكي القابل لإعادة الاستخدام)",
 "drogue": "مظلة كبح (مظلة تستخدم لإبطاء جسم يتحرك بسرعة) / مرساة عائمة (قيد يتكون من إطار مغطى بالقماش يطفو خلف السفينة؛ يمنع الانجراف أو يحافظ على الاتجاه في مهب الريح) / كم الرياح, مخروط الرياح (مخروط قماشي مبتور مثبت على صارية؛ يستخدم (على سبيل المثال، في المطارات) لإظهار اتجاه الرياح) / هدف جوي (جهاز على شكل قمع تسحبه طائرة كهدف)",
 "drogue chute": "مظلة كبح (مظلة تستخدم لإبطاء جسم يتحرك بسرعة)",
 "drogue parachute": "مظلة كبح (مظلة تستخدم لإبطاء جسم يتحرك بسرعة) / مظلة استخراج (مظلة صغيرة تسحب المظلة الرئيسية من حقيبة تخزينها)",
 "droll": "ظَرِيف, غَرِيب الطَّرَافَة (مُضحك بطريقة غريبة أو طريفة)",
 "drollery": "فكاهة غريبة (مزحة غريبة ومسلية) / طَرَافَة, مَوْقِف هَزْلِيّ (حادث هزلي أو سلسلة من الحوادث)",
 "dromaeosaur": "دروميوصور (نوع من المانيرابتور)",
 "dromaius novaehollandiae": "إيمو (طائر أسترالي كبير لا يطير يشبه النعامة ولكنه أصغر)",
 "drome": "مطار (مهبط طائرات مجهز ببرج مراقبة وحظائر وأماكن إقامة للركاب والبضائع)",
 "dromedary": "جمل عربي (جمل ذو سنام واحد من الصحاري الحارة في شمال أفريقيا وجنوب غرب آسيا)",
 "dronabinol": "درونابينول (مادة ذات تأثير نفسي موجودة في الماريجوانا؛ تستخدم علاجياً للسيطرة على الغثيان المرتبط بعلاج السرطان)",
 "drone": "يَعْسُوب, يَمْخُور / مُسَيَّرَة, طَائِرَة بِدُونِ طَيَّار",
 "drone pipe": "أنبوب النغمة المستمرة (أنبوب في مزمار القربة مضبوط لإنتاج نغمة مستمرة واحدة)",
 "droning": "رتابة, صوت رتيب (تنغيم غير متغير)",
 "drool": "أَسَالَ لُعَابًا (فعل تعدّ من سَالَ؛ جعله يَسِيل؛ جعله يُصبح سائلا بعد أن كان غازًا أو صلبا) / هَذَى",
 "drooler": "مُرَيِّل (شخص يسيل لعابه)\nمثال: ذلك الطفل مريّل؛ يحتاج إلى مريلة",
 "droop": "تدلي, ترهل (شكل يتدلى أو يهبط للأسفل)\nمثال: كان هناك هبوط في مقعد الكرسي",
 "drooping": "مُتَدَلٍّ, مُنْحَنٍ لِلأَسْفَل (ذو فروع أو رؤوس أزهار تنحني إلى الأسفل) / مُتَدَلٍّ, مُتَهَدِّل (مُتَدَلٍّ إِلَى الأَسْفَلِ كَمَا مِنَ الإِرْهَاقِ أَوِ الضَّعْف) / خَائِرُ القُوَى (ضَعِيفٌ مِنْ شِدَّةِ الإِنْهَاك)",
 "drooping brome": "برومس زغبي, عشبة الغش (عشبة سنوية أو شتوية سنوية بأوراق مشعرة بنعومة من البحر الأبيض المتوسط)",
 "drooping juniper": "عرعر متدلي, عرعر مكسيكي (شجرة صغيرة في غرب تكساس وجبال المكسيك ذات فروع منتشرة مع غصينات متدلية)",
 "droopingly": "بِتَدَلٍّ, بِذُبُول (بطريقة متدلية)\nمثال: تدلى غصن منخفضاً بتهدل",
 "droopy": "مُتَدَلٍّ, مُتَهَدِّل (مُتَدَلٍّ إِلَى الأَسْفَلِ كَمَا مِنَ الإِرْهَاقِ أَوِ الضَّعْف)",
 "drop": "قَطْرَة / نُقْطَة (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه) / أَسْقَطَ ((أَسْقَطَ) في قوله أو فعله أخطأ وزل. ويقال تكلم فما أسقط في كلمة ما أخطأ؛ (أَسْقَطَ) له: خاطبه بسقط الكلام)\nمثال: هذه هي نقطة ضعفه.",
 "drop arch": "قوس منخفض (قوس مدبب غير حاد مرسوم من مركزين داخل الامتداد)",
 "drop biscuit": "بيسكويت القطرة (بيسكويت مصنوع من عجين يحتوي على حليب كافٍ بحيث يمكن صبه من ملعقة)",
 "drop cloth": "غطاء واقي (قطعة كبيرة من القماش تفرش فوق الأرضية أو الأثاث أثناء طلاء الغرفة) / ستارة خلفية, ستارة منسدلة (ستارة يمكن إنزالها ورفعها على المسرح من الأعلى؛ غالباً ما تستخدم كمنظر خلفي)",
 "drop curtain": "ستارة خلفية, ستارة منسدلة (ستارة يمكن إنزالها ورفعها على المسرح من الأعلى؛ غالباً ما تستخدم كمنظر خلفي)",
 "drop earring": "قرط متدلي (قرط به حلية متدلية)",
 "drop forge": "مطرقة ساقطة, مكبس طرق (جهاز لصنع المطروقات الكبيرة)",
 "drop hammer": "مطرقة ساقطة, مكبس طرق (جهاز لصنع المطروقات الكبيرة)",
 "drop in the bucket": "قَطْرَة فِي الْمُحِيط",
 "drop in the ocean": "غيض من فيض, نقطة في بحر (جهد أو فعل له تأثير ضئيل جداً بشكل عام، خاصة بالمقارنة مع مشكلة ضخمة)\nمثال: إن التبرع بمبلغ 100 دولار من فرد هو أمر كريم، لكنه نقطة في بحر مقارنة بهدف جمع التبرعات البالغ 500,000 دولار",
 "drop keel": "عارضة منزلقة, لوح مركزي (زعنفة عارضة قابلة للسحب تستخدم في المراكب الشراعية لمنع الانجراف نحو اتجاه الريح)",
 "drop line": "عنوان متدرج (عنوان رئيسي يكون سطره العلوي محاذياً لليسار والأسطور التالية مزاحة لليمين)",
 "drop press": "مطرقة ساقطة, مكبس طرق (جهاز لصنع المطروقات الكبيرة)",
 "drop scone": "بان كيك اسكتلندي, سكون القطرة (سكون يُصنع بصب ملعقة من العجين السائل على صاج)",
 "drop shot": "ضربة ساقطة (رد ناعم بحيث تسقط كرة التنس فجأة بعد عبور الشبكة)",
 "drop zone": "منطقة إسقاط (منطقة متفق عليها حيث يتم إسقاط الإمدادات العسكرية للقوات البرية)",
 "drop-dead": "بشكل مذهل, فاتن (بشكل مذهل أو يخطف الأنفاس)\nمثال: كانت فاتنة بشكل مذهل",
 "drop-down menu": "قائمة منسدلة (قائمة خيارات تظهر أسفل العنصر عندما ينقر مستخدم الكمبيوتر عليه)",
 "drop-leaf": "لوح قابل للطي (لوح مفصلي في طاولة يمكن رفعه ودعمه بقوس)",
 "drop-leaf table": "طاولة ذات أجنحة مطوية (طاولة لها جزء قابل للطي (جناح) لتوسيع سطحها)",
 "drop-off": "انخفاض, تراجع (تغير نحو الأسفل) / جرف, منحدر صخري (واجهة صخرية شديدة الانحدار والمرتفع) / تراجع, ركود (تدهور ملحوظ في الأداء أو الجودة)\nمثال: كان هناك انخفاض في درجة حرارته مع هدوء الحمى",
 "drop-off charge": "رسوم التسليم (رسم يضاف لإعادة سيارة مستأجرة إلى موقع مختلف عن الموقع الذي تم استئجارها منه)",
 "drop-seed": "سبوروبولس, عشب قطرة البذر (عشب من جنس سبوروبولس)",
 "dropkick": "ركلة إسقاط ((كرة القدم الأمريكية) ركل (كما لهدف ميداني) حيث يتم إسقاط الكرة وركلها لحظة ملامستها للأرض)",
 "dropkicker": "راكل الكرة المرتدة (راكل كرة قدم يسقط الكرة ويركلها لحظة ملامستها للأرض)",
 "droplet": "قُطَيْرَة",
 "dropline": "عنوان متدرج (عنوان رئيسي يكون سطره العلوي محاذياً لليسار والأسطور التالية مزاحة لليمين)",
 "dropout": "مُتَسَرِّب (شخص يترك المدرسة قبل التخرج) / منسحب (شخص ينسحب من مجموعة اجتماعية أو بيئة)",
 "dropped egg": "بيض بوشيه, بيض مسلوق بدون قشر (بيض مطبوخ في ماء يغلي برفق (بعد كسر القشرة))",
 "dropper": "قطارة (ماصة تتكون من أنبوب صغير مع بصلة شفط في أحد طرفيه لسحب السائل وإطلاقه قطرة تلو الأخرى)\nمثال: استخدمت قطارة العين لإعطاء الدواء للعينين",
 "dropping": "سَاقِط, مُتَسَاقِط (يَنْزِلُ بِحُرِّيَّةٍ تَحْتَ تَأْثِيرِ الجَاذِبِيَّة)",
 "dropping zone": "منطقة إسقاط (منطقة متفق عليها حيث يتم إسقاط الإمدادات العسكرية للقوات البرية)",
 "droppings": "روث, زبل (فضلات الحيوانات)",
 "dropseed": "سُرَق, قاذِفَة البِذْر (أخذ ما كان لغيره خفية وبدون علم أحد)\nمثال: من سرق التفاحة؟",
 "dropsical": "اسْتِسْقائِيّ, وَذَمِيّ (مُنْتَفِخ بِسَبَب تَراكُم مُفْرِط لِلسَّوائِل)",
 "dropsy": "اِسْتِسْقَاء",
 "droshky": "عربة دروشكي (عربة مفتوحة تجرها الخيول بأربع عجلات؛ كانت تستخدم سابقاً في بولندا وروسيا)",
 "drosky": "عربة دروشكي (عربة مفتوحة تجرها الخيول بأربع عجلات؛ كانت تستخدم سابقاً في بولندا وروسيا)",
 "drosophila": "هَمَجة",
 "drosophila melanogaster": "دروسوفيلا (ذبابة فاكهة صغيرة استخدمها توماس هانت مورغان في دراسة الآليات الأساسية للوراثة)",
 "drosophyllum lusitanicum": "دروسوفيلوم (نبات معمر في الموائل الجافة تمتلك أوراقه شعيرات غدية تفرز سائلاً لاصقاً وهضمياً لاصطياد الحشرات وهضمها؛ البرتغال وجنوب إسبانيا والمغرب)",
 "dross": "خبث, شائب (مادة عديمة القيمة أو خطرة يجب إزالتها) / خَبَث (الزبد المتكون بفعل الأكسدة على سطح المعادن المنصهرة)\nمثال: كانت هناك شوائب في الماء",
 "drought": "جَفَاف",
 "drought-tolerant": "مقاوم للجفاف",
 "drouth": "جفاف, قحط (نقص في هطول الأمطار) / جفاف, قحط (نقص طويل الأمد)\nمثال: المزارعون الأكثر تضرراً من الجفاف يأملون أن يكون هناك مطر كافٍ في بداية موسم النمو",
 "drove": "إزميل تسوية الحجر, إزميل عريض (إزميل بناء بحافة عريضة لتسوية الحجر) / حشد متحرك, سرب (حشد متحرك) / قَطِيع سائر (مجموعة من الحيوانات (قطيع أو سرب) تتحرك معًا)",
 "drove chisel": "إزميل تسوية الحجر, إزميل عريض (إزميل بناء بحافة عريضة لتسوية الحجر)",
 "drover": "راعي (شخص يقود القطيع)",
 "drown": "غَرِقَ / أَغْرَقَ",
 "drowned": "غَرِيق",
 "drowning": "إِغْرَاق",
 "drowse": "غفوة, نعاس (نوم خفيف متقطع)",
 "drowsily": "بِنُعَاس, بِوَسَن (بطريقة ناعسة)\nمثال: 'حان وقت الاستيقاظ'، قالت بنعاس",
 "drowsiness": "نُعَاس, سِنَة",
 "drowsy": "نَعْسَان",
 "drub": "ضَرَبَ (معروف، وهو اللطم أو الدق أو الصكّ و ما أشبه؛ النَوْع أو الصنف أو المثال)\nمثال: ضرب سامي زوجته.",
 "drubbing": "جلد, ضرب (فعل إيقاع العقاب البدني بضربات متكررة) / سحق, هزيمة نكراء (هزيمة قوية)",
 "drudge": "عامل شاق, كادح (عامل ملزم بالقيام بأعمال وضيعة) / أجير لعمل ممل, كادح (شخص يعمل بجد في مهام مملة)",
 "drudgery": "عمل شاق وممل, كدح (عمل روتيني شاق ورتيب)",
 "drudging": "كَادِح, مُتَكَبِّد (يَقُوم بِعَمَلٍ شَاقٍّ أَوْ غَيْر مُسْتَحَبّ)",
 "drug": "مُخَدِّر / عَقَّار (الاسم من العَقْر، وهو القَطْع نهائيا؛ كل مُلْك ثابت له أصْل كالأرْض والدَار. الجمع عَقَارات)\nمثال: قاموا بتجربة لمعرفة ما اذا كان العقار قد حسن الذاكرة.",
 "drug abuse": "إدمان, تعاطي المخدرات (الاستخدام المفرط للعقاقير)",
 "drug addict": "مُدْمِن, حَشَّاش",
 "drug addiction": "إدمان المخدرات (إدمان على مخدر (خاصة المخدرات الأفيونية))",
 "drug baron": "بارون مخدرات, زعيم عصابة مخدرات (شخص يسيطر على منظمة تتعامل في المخدرات غير المشروعة)",
 "drug bust": "ضبط مخدرات (مصادرة المخدرات غير المشروعة من قبل الشرطة)",
 "drug cartel": "عصابة مخدرات, كارتل مخدرات (كارتل غير مشروع تم تشكيله للسيطرة على إنتاج وتوزيع المخدرات)\nمثال: تقوم عصابات المخدرات أحياناً بتمويل المنظمات الإرهابية",
 "drug cocktail": "علاج مضاد للفيروسات القهقرية عالي النشاط, كوكتيل دوائي (مزيج من مثبطات البروتياز تؤخذ مع مثبطات المنتسخة العكسية؛ يستخدم في علاج الإيدز وفيروس نقص المناعة البشرية)",
 "drug company": "شركة أدوية, شركة صيدلانية (شركة تقوم بتصنيع وبيع المستحضرات الصيدلانية)",
 "drug dealer": "تاجر مخدرات, مروج مخدرات (تاجر غير مرخص في المخدرات غير المشروعة)",
 "drug enforcement administration": "إدارة مكافحة المخدرات (وكالة فيدرالية مسؤولة عن تطبيق القوانين واللوائح التي تحكم المخدرات والمواد الخاضعة للرقابة؛ هدفها هو شل حركة منظمات تهريب المخدرات)",
 "drug enforcement agency": "إدارة مكافحة المخدرات (وكالة فيدرالية مسؤولة عن تطبيق القوانين واللوائح التي تحكم المخدرات والمواد الخاضعة للرقابة؛ هدفها هو شل حركة منظمات تهريب المخدرات)",
 "drug lord": "بارون مخدرات, زعيم عصابة مخدرات (شخص يسيطر على منظمة تتعامل في المخدرات غير المشروعة)",
 "drug of abuse": "عقار مُساء استخدامه, مخدرات (عقار يتم تناوله لأسباب غير طبية (عادةً لتأثيراته المغيرة للحالة العقلية)؛ يمكن أن يؤدي تعاطي المخدرات إلى أضرار جسدية وعقلية وإلى الاعتماد والإدمان…)",
 "drug peddler": "تاجر مخدرات, مروج مخدرات (تاجر غير مرخص في المخدرات غير المشروعة)",
 "drug traffic": "اتجار بالمخدرات (الاتجار في المخدرات غير القانونية)",
 "drug trafficker": "تاجر مخدرات, مروج مخدرات (تاجر غير مرخص في المخدرات غير المشروعة)",
 "drug trafficking": "اتجار بالمخدرات (الاتجار في المخدرات غير القانونية)",
 "drug user": "متعاطي مخدرات (شخص يتعاطى المخدرات)",
 "drug war": "حَرْب المُخَدِّرَات (صراع بين سلطات إنفاذ القانون وأولئك الذين يتاجرون بالمخدرات غير المشروعة)",
 "drug withdrawal": "إقلاع عن المخدرات, انسحاب (التوقف عن تعاطي المخدرات)",
 "drug-addicted": "مُدْمِن مُخَدِّرَات (مدمن على مادّة مخدِّرة)",
 "drug-free": "خَالٍ مِنَ المُخَدِّرَات (يَتَّصِف بِعَدَم تَعَاطِي المُخَدِّرَات غَيْر المَشْرُوعَة)",
 "drugged": "تَحْتَ تَأْثِير المُخَدِّرَات, مُخَدَّر (وَاقِع تَحْتَ تَأْثِير المُخَدِّرَات)",
 "drugget": "بساط خشن (بساط مصنوع من قماش خشن له سداة قطنية وحشو صوفي)",
 "drugging": "تخدير, تهدئة (إعطاء مهدئ أو دواء مخدر)",
 "druggist": "صيدلي (مهني صحي مدرب في فن تحضير وصرف الأدوية)",
 "drugless": "بِلا عَقاقير (لا يَعْتَمِد عَلى الأدْوِيَة في العِلاج)",
 "drugs bust": "ضبط مخدرات (مصادرة المخدرات غير المشروعة من قبل الشرطة)",
 "drugstore": "صيدلية (متجر تجزئة تباع فيه الأدوية وسلع أخرى)",
 "druid": "درويد, كاهن كلتي (كاهن ما قبل المسيحية بين السلتيين في بلاد الغال القديمة وبريطانيا وأيرلندا)",
 "druidism": "درويدية (نظام الدين والفلسفة الذي علمه الدرويد وطقوسهم ومراسمهم)",
 "drum": "طَبْل (الضَرْب على الطَبْل؛ آلة موسيقية تشبه الإسطوانة المغطاة فتحتها بالجلد تستخدم بأن يضرب وجهها إما باليد أو بعصا) / طَبْلَة",
 "drum and bass": "درم آند بيس, طَبْل وَبَاس (درم الصَّبِي وَالشَّيْخ: مَشى مشْيَة الأرنب والقنفذ وَنَحْوهمَا؛ درم الكعب والعظم: غطاه اللَّحْم والشحم حَتَّى لم يبن لَهُ حجم)",
 "drum brake": "فرامل طبلة, مكبح أسطواني (مكبح هيدروليكي يتم فيه تطبيق الاحتكاك على الجزء الداخلي لأسطوانة دوارة بواسطة حذاء الفرامل)",
 "drum kit": "طَقْم الطُّبُول",
 "drum machine": "آلَة طُبُول (الفارسية: ماشين؛ الأوردية: مشين)\nمثال: نسى زيري الآلة.",
 "drum major": "عصوي, قائد فرقة استعراضية (قائد فرقة موسيقية استعراضية أو فرقة طبول)",
 "drum majorette": "قائدة فرقة استعراضية (أنثى تقود فرقة استعراضية) / قائدة فرقة الاستعراض, ماجوريت (فتاة تؤدي استعراضاً بالعصا وترافق فرقة موسيقية سائرة)",
 "drum memory": "ذاكرة أسطوانية (جهاز تخزين بيانات مغناطيسي اخترعه غوستاف تاوشيك في عام 1932 في النمسا)\nمثال: احتوت الذاكرة الأسطوانية على أسطوانة معدنية كبيرة، مطلية على السطح الخارجي بمادة تسجيل مغناطيسية",
 "drum monitor": "سماعة مراقبة لقارع الطبول, مونيتور طبل (سماعة مراقبة جانبية مخصصة لقارعي الطبول)",
 "drum printer": "طابعة أسطوانية (طابعة خطية يتم فيها تثبيت الحروف على أسطوانة دوارة تحتوي على مجموعة أحرف كاملة لكل موضع طباعة)",
 "drum roll": "قرع الطبول (صوت الطبل (خاصة الطبل الجانبي) يضرب بسرعة وبشكل مستمر)",
 "drum sander": "آلة صنفرة أسطوانية (أداة كهربائية تستخدم لصنفرة الخشب؛ يتم تحريك حلقة لا نهائية من ورق الصنفرة بسرعة عالية بواسطة محرك كهربائي)",
 "drum-like": "طَبْلِيّ الشَّكْل (على شكل طبلة)",
 "drum-shaped": "طَبْلِيّ الشَّكْل (على شكل طبلة)",
 "drumbeat": "ترويج صاخب, دعوة ملحة (مناصرة قوية وصاخبة لقضية ما) / قرع الطبول ((عسكري) ضرب الطبل كإشارة لإنزال العلم عند غروب الشمس) / قرع الطبل (الصوت الناتج عن ضرب الطبل)\nمثال: واصل دعاة الحرب ترويجهم الصاخب بشأن العراق",
 "drumbeater": "متحزب, متعصب (مؤيد متحمس وحتى متشدد لشيء ما)",
 "drumfire": "قصف مدفعي (نيران مدفعية مكثفة ومستمرة)",
 "drumfish": "سمكة الطبل (أسماك غذائية ورياضية صغيرة إلى متوسطة الحجم تعيش في القاع في المياه الساحلية الضحلة والمياه العذبة وتصدر ضجيجاً يشبه الطبل)",
 "drumhead": "عُرْفِيّ, مُوجَز (يُنفَّذ بسرعة ودون إجراءات رسميّة) / جلد الطبل (غشاء مشدود بإحكام فوق طبلة)",
 "drumhead court-martial": "محكمة عسكرية ميدانية (محكمة عسكرية تُعقد للنظر في تهم عاجلة لجرائم ارتُكبت أثناء العمليات)",
 "drumlin": "دْرَمْلِين, رَابِيَة جَلِيدِيَّة (تل من الركام الجليدي)",
 "drummer": "طبال (شخص يعزف على الطبل)",
 "drumming": "طبل, قرع الطبول (فعل العزف على الطبول)\nمثال: مارس قرع الطبول لعدة ساعات كل يوم",
 "drumstick": "عصا الطبل (عصا تستخدم للقرع على الطبل) / ساق الطائر (الجزء السفلي من ساق الطائر)",
 "drumstick tree": "خيار شمبر, شجرة المطر الذهبي (شجرة متساقطة الأوراق أو شبه دائمة الخضرة لها زهور بنية داكنة إلى صفراء معطرة في عناقيد متدلية وقرون يستخدم لبها طبياً؛ آسيا الاستوائية ووسط وجنوب…)",
 "drunk": "سَكْرَان, ثَمِل (من شرب الخمر حتى سَكِرَ) / سِكِّير, خِمِّير\nمثال: تبدو كأنها سكرانة.",
 "drunk-and-disorderly": "متهم بالسكر والشغب (شخص مقبوض عليه بتهمة السكر وإحداث الفوضى)\nمثال: سلموا المتهمين بالسكر والشغب إلى سجن المقاطعة",
 "drunkard": "سكير, مدمن خمر (شخص يشرب الخمر بشكل مزمن)",
 "drunken": "سِكِّير, مُدْمِن الخَمْر (مُنْغَمِس فِي شُرْب الكُحُول أَوْ يَتَّسِم بِهِ)",
 "drunken reveler": "عربيد, ماجِن (شخص ينخرط في حفلات شراب صاخبة)",
 "drunken reveller": "عربيد, ماجِن (شخص ينخرط في حفلات شراب صاخبة)",
 "drunken revelry": "باخاناليا, حفلة مجون (تجمع جامح ينطوي على الإفراط في الشرب والانحلال الجنسي)",
 "drunkenly": "بثمالة, بسكره (مظهراً آثار شرب الكحول بكثرة)\nمثال: غنى بثمالة",
 "drunkenness": "سُكْرٌ (مادة غذائية حلوة تستخدم لتَحْلِيَة الطعام)\nمثال: حرمني من السكر.",
 "drupaceous": "حسلي, ذو نواة (مكون من أو متعلق بالثمرة الحسلة (ذات النواة))",
 "drupe": "ثمرة نووية, حسلة (فاكهة لحمية غير متفتحة ذات بذرة واحدة: مثل اللوز والخوخ والبرقوق والكرز والخمان والزيتون والعناب)",
 "drupelet": "حسيلة (جزء صغير من فاكهة متجمعة يشبه الحسلة)",
 "druse": "دُرْزِيّ (معتنق لمذهب التوحيد الدرزي)\nمثال: يُسمح للدرزي بالتوافق ظاهرياً مع عقيدة غير المؤمنين الذين يعيش بينهم",
 "drusen": "براريق شفافة (مرض عيني ناتج عن تراكمات صغيرة من أجسام زجاجية تحت الشبكية)",
 "druthers": "أفضلية, تفضيل (الحق أو الفرصة للاختيار)",
 "druze": "مُوَحِّدُون دُرُوز, مُوَحِّدُون",
 "dry": "جَافّ, ناشف (خالٍ من الرطوبة أو الماء؛ قاسٍ أو شديد) / جَفَّ, جَفّ (يَبِسَ)\nمثال: السجق جاف نوعا ما.",
 "dry battery": "بطارية جافة (بطارية فولتية تتكون من خليتين جافتين أو أكثر)",
 "dry cell": "بطارية جافة, خلية جافة (خلية ليكلانشيه صغيرة لا تحتوي على سائل حر؛ الإلكتروليت عبارة عن عجينة وقطب الزنك السالب يشكل حاوية الخلية)",
 "dry cereal": "حبوب باردة, كورن فليكس (حبوب لا تسخن قبل التقديم)",
 "dry cleaner": "مُنَظِّف جَافّ, مَصْبَنَة",
 "dry cleaners": "محل تنظيف جاف, مصبغة (متجر يتم فيه التنظيف الجاف)",
 "dry cleaning": "تَنْظِيف جَافّ",
 "dry dock": "حوض جاف (حوض كبير يمكن ضخ المياه منه؛ يستخدم لبناء السفن أو لإصلاح السفينة أسفل خط الماء)",
 "dry fly": "ذبابة جافة (ذبابة (طعم للصياد) تلامس سطح الماء)",
 "dry gangrene": "غرغرينا جافة (غرغرينا تتطور في وجود انسداد شرياني وتتميز بجفاف الأنسجة الميتة ولونها البني الداكن)",
 "dry ice": "جليد جاف (ثاني أكسيد الكربون المتصلب؛ يتسامى عند -78.5 درجة مئوية ويستخدم بشكل رئيسي كمبرد)",
 "dry kiln": "فرن تجفيف, مجفف أخشاب (فرن لتجفيف الخشب ومعالجته)",
 "dry land": "بَرّ, يَابِسَة (أحسن إلى والديه أو إلى غيره بالخير والاحترام؛ صدق أو وفى بوعد أو عهد)\nمثال: دخل زيري إلى منطقة ببر.",
 "dry masonry": "بناء جاف (بناء بدون ملاط)",
 "dry measure": "مقياس جاف, وحدة جافة (وحدة سعة للسلع الجافة (مثل الفاكهة أو الحبوب))",
 "dry milk": "حليب بودرة, حليب مجفف (حليب منزوع الماء (مجفف))",
 "dry mop": "ممسحة غبار جافة (ممسحة جافة لتنظيف الغبار عن الأرضيات)",
 "dry mouth": "جفاف الحلق",
 "dry mustard": "خردل جاف, مسحوق الخردل (مادة تذوب منها ملعقة إلى ثلاث ملاعق كبيرة في كوب من الماء الدافئ لتكون مقيئاً منزلياً)",
 "dry nurse": "مربية (ممرضة تعتني برضيع ولكن لا ترضعه)",
 "dry pint": "باينت جاف (وحدة جافة أمريكية تساوي 0.5 كوارت)",
 "dry plate": "لوح جاف (طريقة تصوير سابقة استخدمت لوحاً زجاجياً مطلياً بمستحلب جيلاتيني حساس للضوء)",
 "dry plate process": "لوح جاف (طريقة تصوير سابقة استخدمت لوحاً زجاجياً مطلياً بمستحلب جيلاتيني حساس للضوء)",
 "dry point": "إبرة النقش الجاف (إبرة فولاذية للنقش بدون حمض على صفيحة نحاسية عارية) / نقطة جافة (مطبوعة منتجة بنقش النقطة الجافة)",
 "dry quart": "كوارت جاف (وحدة جافة أمريكية تساوي 2 باينت)",
 "dry rot": "عفن جاف (فطر يسبب العفن الجاف) / عفن جاف (تفتت وجفاف للأخشاب أو البصلات أو البطاطس أو الفاكهة بسبب فطر)",
 "dry run": "بروفة, تدريب (جلسة تدريب تحضيراً لأداء عام (كمسرحية أو خطاب أو حفلة موسيقية))\nمثال: فوت الكثير من البروفات",
 "dry season": "موسم الجفاف (أحد الموسمين في المناخات الاستوائية، فترة سنوية يقل فيها هطول الأمطار في المناطق الاستوائية)",
 "dry snow": "ثلج جاف (نوع من الثلج يحتوي على القليل من الماء السائل أو لا يحتوي عليه على الإطلاق، ويكون أقل كثافة من المتوسط وغير لزج)\nمثال: التزلج في ظروف الثلج الجاف أو المسحوق يمكن أن يكون تحدياً",
 "dry socket": "التهاب السنخ الجاف (التهاب في سنخ السن؛ يحدث أحياناً بعد قلع السن وفشل تكون جلطة دموية)",
 "dry unit": "مقياس جاف, وحدة جافة (وحدة سعة للسلع الجافة (مثل الفاكهة أو الحبوب))",
 "dry vermouth": "فيرموث جاف, فيرموث فرنسي (نوع كهرماني شاحب جاف)",
 "dry wall": "جدار جاف (جدار حجري مصنوع من الحجارة المتراصة معاً بدون ملاط) / دريوال, لوح جداري (لوح مسطح عريض يستخدم لتغطية الجدران أو القواطع؛ مصنوع من الجص أو لب الخشب أو مواد أخرى ويستخدم بشكل أساسي لتشكيل الجدران الداخلية للمنازل)",
 "dry walling": "بناء جاف (نشاط بناء الجدران الحجرية بدون ملاط)",
 "dry wash": "مجال سيل, وادي جاف (القاع الجاف لجدول متقطع (كما في قاع وادٍ ضيق))",
 "dry-bulb thermometer": "مقياس حرارة جاف البصلة (مقياس حرارة عادي ببصلة جافة؛ يستخدم لقياس درجة حرارة الهواء)",
 "dry-cleaned": "مُنَظَّف جَافّ (تمّ تنظيفه بالتنظيف الجافّ)",
 "dry-eyed": "بلا دموع, جاف العينين (خالٍ من الدموع)",
 "dry-gulching": "اغتيال من كمين, قتل غدر (فعل القتل من كمين)",
 "dry-shod": "جَافّ الْقَدَمَيْن (ذو قدمين أو حذاء جافّ؛ لم تبتلّ قدماه)",
 "dry-stone wall": "جدار جاف (جدار حجري مصنوع من الحجارة المتراصة معاً بدون ملاط)",
 "dry-wood termite": "نمل الخشب الجاف الأبيض (أي من أنواع النمل الأبيض المتنوعة التي تعيش وتتغذى على الخشب الجاف غير المتصل بالتربة)",
 "dryad": "حورية الغابة, درياد (إلهة أو حورية الغابات)",
 "dryas octopetala": "أفنس الجبل, درياس ثماني البتلات (شجيرة زاحفة دائمة الخضرة بزهور بيضاء كبيرة؛ واسعة الانتشار في الأجزاء الشمالية من أوراسيا وأمريكا الشمالية)",
 "drydock": "حوض جاف (حَوَّضَ: عمِل حوضًا؛ حَوَّضَ (الماءَ): حاضَه)\nمثال: ملأت الحوض ماءا.",
 "dryer": "مجفف (جهاز يقوم بإزالة الرطوبة)",
 "drygoods": "سلع جافة, منسوجات (منسوجات أو ملابس وبضائع ذات صلة)",
 "drying agent": "عامل تجفيف, مادة مجففة (مادة تعزز الجفاف (مثل أكسيد الكالسيوم الذي يمتص الماء ويستخدم لإزالة الرطوبة))",
 "drying oil": "زيت جاف (زيت يتصلب في الهواء بسبب الأكسدة ويُستخدم غالباً كأساس للطلاء أو الورنيش)",
 "drying up": "تتجفاف, تجفيف (عملية استخلاص الرطوبة)",
 "dryland berry": "توت الأراضي الجافة (شجيرة منخفضة متساقطة الأوراق من شرق الولايات المتحدة تحمل توتاً أزرق داكناً حلواً)",
 "dryland blueberry": "توت الأراضي الجافة (شجيرة منخفضة متساقطة الأوراق من شرق الولايات المتحدة تحمل توتاً أزرق داكناً حلواً)",
 "dryly": "بِإِيجَاز, بِجَفَاف (بطريقة جافة وموجزة)\nمثال: 'أعرف ذلك'، قال بجفاف",
 "drymarchon corais": "ثعبان نيلي (ثعبان كبير أزرق داكن غير سام يغزو الجحور؛ يوجد في جنوب أمريكا الشمالية والمكسيك)",
 "drymarchon corais couperi": "ثعبان النيلي الشرقي (نوع من الثعبان النيلي)",
 "drynaria rigidula": "سرخس السلة (سرخس هوائي أو صخري عملاق؛ آسيا إلى بولينيزيا وأستراليا)",
 "dryness": "تجرد, عدم تحيز (الموضوعية والانفصال عن الهوى) / رصانة, صحو (الاعتدال في أو الامتناع عن الكحول أو المخدرات الأخرى) / جفاف, يبوسة (حالة عدم احتواء سائل أو عدم التغطية به (خاصة الماء))\nمثال: اتخذ أسلوبها تجرداً وجفافاً مختلفاً جداً عن نبرتها المعتادة",
 "dryophytes arenicolor": "ضفدع الوادي الشجري (ساكن أرضي صغير بشكل رئيسي يبقى على مسافة قفز سهلة من الماء؛ من جنوب غرب الولايات المتحدة وشمال المكسيك)",
