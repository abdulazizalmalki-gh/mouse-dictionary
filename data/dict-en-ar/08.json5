 "diuril": "ديوريل, كلوروثيازيد (دواء مدر للبول (الاسم التجاري ديوريل) يستخدم في علاج الوذمة وارتفاع ضغط الدم)",
 "diurnal": "نَهَارِيّ",
 "diurnal parallax": "تزيح أرضي المركز, تزيح نهاري (تزيح جرم سماوي باستخدام نقطتين على سطح الأرض أثناء دوران الأرض)",
 "diurnal variation": "تغير نهاري (تقلبات تحدث خلال اليوم الواحد)",
 "diva": "ديفا, مغنية أوبرا رئيسية (مغنية أوبرا متميزة؛ نجمة أوبرا أنثى)",
 "divagation": "انحراف, تحويل (التحول جانباً (عن مسارك أو انتباهك أو اهتمامك)) / اسْتِطْرَاد, جُمْلَة مُعْتَرِضَة (رسالة تخرج عن الموضوع الرئيسي)\nمثال: تحويل عن الطريق السريع الرئيسي",
 "divalent": "ثنائي التكافؤ (لديه تكافؤ اثنين أو لديه تكافؤين)",
 "divan": "دِيوَان",
 "divan bed": "أريكة نهارية, ديوان (أريكة بلا ذراعين؛ تستخدم كمقعد نهاراً وسرير ليلاً)",
 "divarication": "تفرع متباعد (التفرع بزاوية واسعة)",
 "dive": "غَاصَ / غَطْسَ, يقفز الى الماء",
 "dive bomber": "قاذفة انقضاضية",
 "dive brake": "كابح هوائي, مكبح هوائي (مظلة صغيرة أو قلاب مفصلي لتقليل سرعة الطائرة)",
 "dive-bombing": "قصف انقضاضي (طلعة قصف يطلق فيها القاذف القنبلة أثناء الطيران مباشرة نحو الهدف)",
 "diver": "غَطَّاسٌ, غَوَّاصٌ",
 "divergence": "تباعد, تشعب (عملية الابتعاد في اتجاهات مختلفة عن نقطة مشتركة) / تَبَايُن, تَضَارُب (اختلاف بين حقائق أو ادعاءات أو آراء متعارضة) / تَبَاعُد (متسلسلة لا نهائية ليس لها حد) / اختلاف, انحراف (اختلاف ينحرف عن المعيار أو القاعدة)\nمثال: تتشكل الزاوية من تباعد خطين مستقيمين",
 "divergency": "تباعد, تشعب (عملية الابتعاد في اتجاهات مختلفة عن نقطة مشتركة) / تَبَاعُد (متسلسلة لا نهائية ليس لها حد)\nمثال: تتشكل الزاوية من تباعد خطين مستقيمين",
 "divergent": "متباعد, متشعب (يميل للابتعاد في اتجاهات مختلفة) / مُتَبَاعِد, مُنْحَرِف (يبتعد عن غيره أو عن معيار محدَّد)",
 "divergent strabismus": "حول خارجي, حول وحشي (حول تتجه فيه إحدى العينين أو كلتيهما إلى الخارج)",
 "divergent thinker": "مفكر متشعب (مفكر يبتعد عن المشكلة كما طُرحت وغالباً ما يأتي بأفكار وحلول جديدة)",
 "divergent thinking": "تفكير إبداعي, تفكير تباعدي (تفكير يتحرك في اتجاهات متباعدة ليشمل مجموعة متنوعة من الجوانب ويؤدي أحياناً إلى أفكار وحلول جديدة)",
 "diverging": "متباعد, متشعب (يميل للابتعاد في اتجاهات مختلفة)",
 "diverging lens": "عدسة مفرقة, عدسة مقعرة (عدسة تعمل على تفريق أو نشر شعاع الضوء المتوازي المار عبرها)",
 "diverse": "مُتَنَوِّع",
 "diversely": "بشكل متنوع, بشكل مختلف (بطرق متنوعة)\nمثال: البدائل التي يتم تمثيلها بشكل مختلف من قبل المشاركين",
 "diverseness": "اخْتِلَاف, تَعَدُّدِيَّة (عدم تجانس ملحوظ)\nمثال: تنوع في الاحتمالات",
 "diversification": "تَنْوِيع",
 "diversified": "متنوع, منوع (يحتوي على تنوع في الطابع أو الشكل أو المكونات؛ أو لديه تنوع متزايد)\nمثال: برنامج موسيقي متنوع يتراوح من الكلاسيكي إلى الحديث",
 "diversion": "انحراف, تحويل (التحول جانباً (عن مسارك أو انتباهك أو اهتمامك)) / استجمام, ترفيه (نشاط يسلّي أو يمتع أو ينشّط) / تمويه, هجوم تضليلي (هجوم محسوب لجذب دفاع العدو بعيداً عن نقطة الهجوم الرئيسي)\nمثال: تحويل عن الطريق السريع الرئيسي",
 "diversionary": "تَضْلِيلِيّ, تَمْوِيهِيّ ((عَنِ التَّكْتِيكَات) مُصَمَّم لِلإِرْبَاك أَوِ الخِدَاع)",
 "diversionary attack": "تمويه, هجوم تضليلي (هجوم محسوب لجذب دفاع العدو بعيداً عن نقطة الهجوم الرئيسي)",
 "diversionary landing": "إنزال تضليلي (هجوم برمائي تضليلي)",
 "diversionist": "مخرب (شخص يرتكب أعمال تخريب أو يتسبب عمداً في حطام)",
 "diversity": "تَنَوُّع, تَعَدُّدِيَّة",
 "diverted": "مُسْتَمْتِع, مُنْشَغِل بِلَذَّة (مشغول بشكل ممتع وسارّ)",
 "diverticulitis": "التهاب الرتج (التهاب رتج في الجهاز الهضمي (خاصة القولون)؛ يتميز بتقلصات مؤلمة في البطن وحمى وإمساك)",
 "diverticulosis": "داء الرتوج (وجود رتوج (جيوب) متعددة في جدران القولون)",
 "diverticulum": "رتج (فتق من خلال الجدار العضلي لعضو أنبوبي (خاصة القولون))",
 "divertimento": "دِيفِرْتِمِنْتُو, دِفِرْتِمِنْتُو",
 "diverting": "مُضْحِك, مُلَهٍّ (يوفر المتعة والتسلية بشكل لطيف)",
 "divertingly": "بشكل مسلٍ, بشكل ممتع (بطريقة مسلية وممتعة)\nمثال: هوليوود أصبحت معقدة للغاية لدرجة أنها لا تنتج أي شيء سيء بشكل مسلٍ حقاً هذه الأيام",
 "divestiture": "بيع الأصول, تجريد (بيع الشركة لخط إنتاج أو شركة تابعة أو قسم) / أمر بالتجريد, تصفية الاستثمارات القسرية (أمر للطرف المسيء بتخليص نفسه من الممتلكات؛ الغرض منه حرمان المدعى عليه من مكاسب السلوك غير المشروع)\nمثال: وجدت المحكمة أن التجريد ضروري لمنع الاحتكار",
 "divi-divi": "ديفي ديفي (شجرة صغيرة أو شجيرة عديمة الشوك من أمريكا الاستوائية تعد قرون بذورها مصدراً للتانين) / ديفي ديفي (قرون بذور ملتوية لشجرة ديفي ديفي؛ مصدر للتانين)",
 "dividable": "قَابِل لِلقِسْمَة (يُمْكِن قِسْمَتُه عَادَةً بِدُون بَاقٍ)",
 "divide": "قَسَّمَ (فَرَّقَ أو قَسَّمَ الشَّيءَ إلى أجزاء أو أجزاء مختلفة؛ أَحْلَفَ، أَي جَعَلَ يَحْلِفُ على أمرٍ ما)\nمثال: أنا أزين القسم.",
 "divide and rule": "فَرِّقْ تَسُدْ",
 "divided": "مُشْتَرَك, مُقَسَّم (مُوَزَّعٌ عَلَى حِصَصٍ (غَالِبًا مُتَسَاوِيَةٍ) وَفْقَ خُطَّةٍ أَوْ غَرَضٍ مُعَيَّنٍ) / ذُو جَزِيرَةٍ وَسَطِيَّةٍ, مُقَسَّم (به شريط أو جزيرة وسطية تفصل بين حارات المرور المتعاكسة) / مجزأ, منقسم (مفصول إلى أجزاء أو قطع)\nمثال: الآراء منقسمة",
 "divided highway": "طريق مزدوج (طريق سريع مقسوم من المنتصف بحاجز يفصل حركة المرور المتجهة في اتجاهين مختلفين)",
 "divided up": "مُشْتَرَك, مُقَسَّم (مُوَزَّعٌ عَلَى حِصَصٍ (غَالِبًا مُتَسَاوِيَةٍ) وَفْقَ خُطَّةٍ أَوْ غَرَضٍ مُعَيَّنٍ)",
 "dividend": "حِصَّة / مَقْسُوم",
 "dividend warrant": "إذن صرف أرباح الأسهم (أمر دفع (مثل شيك يدفع للمساهم) يتم فيه دفع أرباح الأسهم)",
 "divider": "فرجار تقسيم, مقسم (أداة رسم تشبه الفرجار تستخدم لتقسيم الخطوط إلى أجزاء متساوية أو لنقل القياسات) / حاجز, فاصل (هيكل عمودي يقسم أو يفصل (مثل الجدار الذي يفصل غرفة عن أخرى)) / مُقَسِّم (شخص يفصل شيئاً ما إلى أجزاء أو مجموعات) / مُقسِّم (عالم تصنيف يصنف الكائنات الحية في مجموعات عديدة بناءً على خصائص ثانوية نسبياً)",
 "dividing line": "حد فاصل, خط فاصل (فصل أو تمييز مفاهيمي)\nمثال: هناك خط رفيع بين العقل والجنون",
 "divination": "تنجيم, عرافة (فن أو موهبة النبوءة (أو ادعاء النبوءة) بوسائل خارقة للطبيعة) / نبوءة (تنبؤ ينطق به تحت إلهام إلهي) / حَدْس صَائِب, فِرَاسَة (تخمين ناجح عن طريق بصيرة غير عادية أو حظ جيد)",
 "divinatory": "اِفْتِرَاضِيّ, تَخْمِينِيّ (مبنيّ أساساً على التخمين بدلاً من الأدلة الكافية) / عِرَافِيّ, كَهَنُوتِيّ (يُشبِه أو يتّسم بسمات نبيّ أو نبوءة)",
 "divine": "إِلٰهِيّ / رَجُلُ دِينٍ, رِجالُ دِينٍ (العُضْو في جسد الإنسان يتكون من القَدَم والسَاق والفُخْذ. الجمع أرجُل، وقد تقول العامّة رِجْلين ورجْلينات؛ القَدَم من باب اطلاق اسم الكل على الجزء)\nمثال: هذا الرجل تاجر.",
 "divine guidance": "إلهام, توجيه إلهي ((لاهوت) تأثير خاص من الألوهية على عقول البشر)\nمثال: يعتقدون أن كتب الكتاب المقدس كتبت بتوجيه إلهي",
 "divine law": "شريعة إلهية, قانون إلهي (قانون يُعتقد أنه يأتي مباشرة من الله)",
 "divine liturgy": "قُدَّاس إِلَٰهِيّ",
 "divine messenger": "رسول إلهي (رسول من عند الله)\nمثال: إنهم كائنات خارقة للطبيعة تعمل كرسل إلهيين بين الناس والآلهة",
 "divine office": "الفرض الإلهي (صلاة قانونية يتلوها الكهنة يوميًا)",
 "divine revelation": "كشف إلهي, وحي (إيصال المعرفة للإنسان بواسطة قوة إلهية أو خارقة للطبيعة)",
 "divine right": "الحق الإلهي, الحق الإلهي للملوك (المذهب القائل بأن الملوك يستمدون حقهم في الحكم مباشرة من الله ولا يخضعون لمحاسبة رعاياهم؛ التمرد هو أسوأ الجرائم السياسية)\nمثال: تم الإعلان عن مذهب الحق الإلهي للملوك من قبل عائلة ستيوارت في بريطانيا في القرن السادس عشر",
 "divine right of kings": "الحق الإلهي, الحق الإلهي للملوك (المذهب القائل بأن الملوك يستمدون حقهم في الحكم مباشرة من الله ولا يخضعون لمحاسبة رعاياهم؛ التمرد هو أسوأ الجرائم السياسية)\nمثال: تم الإعلان عن مذهب الحق الإلهي للملوك من قبل عائلة ستيوارت في بريطانيا في القرن السادس عشر",
 "divine service": "خدمة دينية, صلاة جماعية (فعل العبادة العامة باتباع قواعد مقررة)\nمثال: خدمة الأحد",
 "divinely": "إلهياً (بوسائل إلهية)\nمثال: الوسيلة المعينة إلهياً",
 "diviner": "عرّاف (شخص يدعي اكتشاف المعرفة الخفية بمساعدة قوى خارقة للطبيعة)",
 "diving": "غَطس",
 "diving bell": "جرس الغوص (جهاز غوص للعمل تحت الماء؛ له قاع مفتوح ومزود بهواء مضغوط)",
 "diving board": "لوح الغطس (لوح قفز يمكن للسباحين الغطس منه)",
 "diving dress": "بدلة غوص (رداء مزود بالهواء ومحكم الإغلاق ومثقل؛ يرتديه الغواصون تحت الماء)",
 "diving duck": "بط غواص (أي من أنواع البط المختلفة خاصة في الخلجان ومصبات الأنهار التي تغوص للحصول على طعامها)",
 "diving event": "غطس, فعالية غطس (مسابقة رياضية تتضمن الغطس في الماء)",
 "diving petrel": "نوء غواص (أي من عدة طيور غوص صغيرة في بحار نصف الكرة الجنوبي؛ تشبه طيور الأوك إلى حد ما)",
 "diving suit": "بدلة غوص (رداء مزود بالهواء ومحكم الإغلاق ومثقل؛ يرتديه الغواصون تحت الماء)",
 "divining rod": "عصا التكهن, عصا الكشف عن المياه (عصا متشعبة يُزعم أنها تنحني لأسفل للإشارة إلى وجود مياه جوفية أو نفط)",
 "divinity": "إِلَٰهِيَّة",
 "divinity fudge": "ديفينيتي, فادج ديفينيتي (فادج كريمي أبيض مصنوع ببياض البيض)",
 "divinyl ether": "إيثر (سائل متطاير عديم اللون وشديد الاشتعال كان يستخدم سابقاً كمخدر استنشاقي)",
 "divisibility": "قَابِلِيَّةُ الْقِسْمَةِ",
 "divisible": "قابل للتقسيم, قابل للقسمة (قادر على أو عرضة للتقسيم أو الفصل)\nمثال: الأرقام الزوجية تقبل القسمة على اثنين",
 "division": "تَقْسِيم / قِسْمَة (في : هو أن أحد العمليات الحسابية الرئيسية، ضد الضَرْب) / قِسْمَةٌ (في : هو أن أحد العمليات الحسابية الرئيسية، ضد الضَرْب) / فِرْقَة / فُرْقَة\nمثال: الزواج قسمة و نصيب.",
 "division archaebacteria": "البكتيريا القديمة, قسم العتائق (تعتبر مملكة في بعض التصنيفات)",
 "division chlorophyta": "الطحالب الخضراء, قسم الطحالب الخضراء (قسم كبير من الطحالب حقيقية النواة التي تعيش بشكل رئيسي في المياه العذبة وتمتلك الكلوروفيل أ وب وتخزن الغذاء على شكل نشا ولها جدران خلوية سيليلوزية)",
 "division chrysophyta": "الطحالب الذهبية, قسم الطحالب الذهبية (طحالب حقيقية النواة تعيش غالباً في المياه العذبة ويحجب فيها صبغة بنية أو صفراء الكلوروفيل؛ تشمل الطحالب الصفراء الخضراء والذهبية البنية والدياتومات)",
 "division cyanophyta": "الزراقم, الطحالب الخضراء المزرقة (كائنات بدائية النواة تُعتبر أحياناً طائفة أو شعبة أو تحت مملكة؛ تتطابق مع الطحالب الزرقاء)",
 "division cynodontia": "قسم كلبيات الأسنان, كلبيات الأسنان (قسم من رتبة الثيرابسيدا من العصر الترياسي يضم زواحف رباعية الأرجل آكلة للحوم صغيرة الحجم غالباً ما تكون لها أسنان تشبه أسنان الثدييات)",
 "division dicynodontia": "ثنائيات كلبيات الأسنان (قسم من رتبة الثيرابسيدا)",
 "division eubacteria": "قسم البكتيريا الحقيقية (كائنات بدائية النواة وحيدة الخلية ذات جدران صلبة وأسواط (في الأنواع المتحركة))",
 "division euglenophyta": "اليوجلينيات, قسم اليوجلينيات (طحالب سوطية حرة السباحة)",
 "division heterokontophyta": "قسم متباينات السوط, متباينات السوط (فَرَّقَ أو قَسَّمَ الشَّيءَ إلى أجزاء أو أجزاء مختلفة؛ أَحْلَفَ، أَي جَعَلَ يَحْلِفُ على أمرٍ ما)\nمثال: أنا أزين القسم.",
 "division of labour": "تَقْسِيم الْعَمَل",
 "division phaeophyta": "الطحالب البنية, قسم الطحالب البنية",
 "division rhodophyta": "الطحالب الحمراء, قسم الطحالب الحمراء (نباتات دنيا؛ غالباً طحالب حقيقية النواة بحرية وساحلية)",
 "division schizophyta": "الانشطاريات, قسم الانشطاريات",
 "divisional": "فِئَوِيّ, كَسْرِيّ (يشكّل قسمًا أو جزءًا كسريًّا من الوحدة النقدية الأساسية) / تَقْسِيمِيّ, فَاصِل (يَخْدُمُ التَّقْسِيمَ أَوْ يَدُلُّ عَلَى الفَصْلِ) / فرقوي, متعلق بالفرقة العسكرية (من أو متعلق بفرقة عسكرية)\nمثال: مدفعية الفرقة",
 "divisionism": "التقسيمية (الأسلوب المميز في الرسم الانطباعي الجديد الذي يحدده فصل الألوان إلى نقاط أو بقع فردية تتفاعل بصرياً)\nمثال: كان هذا الشكل من التقسيمية، الذي كان سلويترز ممثلاً رئيسياً له، هو الذي أدى إلى ظهور الرسم الطليعي في أمستردام",
 "divisive": "انْشِقَاقِيّ, مُثِيرٌ لِلفُرْقَةِ (مُعَارِضٌ (خَاصَّةً لِرَأْيِ الأَغْلَبِيَّةِ)؛ يُحْدِثُ الِانْقِسَامَ)",
 "divisor": "قَاسِم, مَقْسُوم عَلَيْهِ",
