 "ductileness": "قابلية للسحب, مطيلية (طواعية الشيء الذي يمكن سحبه إلى خيوط أو أسلاك أو طرقه إلى صفائح رقيقة)",
 "ductility": "قابلية للسحب, مطيلية (طواعية الشيء الذي يمكن سحبه إلى خيوط أو أسلاك أو طرقه إلى صفائح رقيقة)",
 "ductless": "لا قنوي (ليس لديه قناة)\nمثال: غدد صماء (لا قنوية)",
 "ductless gland": "غدة صماء, غدة لا قنوية (أي من غدد جهاز الغدد الصماء التي تفرز الهرمونات مباشرة في مجرى الدم)",
 "ductule": "قناة صغيرة, قنية (قناة صغيرة جداً)",
 "ductulus": "قناة صغيرة, قنية (قناة صغيرة جداً)",
 "ductus arteriosus": "قناة شريانية (وعاء دموي في الجنين يتجاوز الدورة الرئوية بربط الشريان الرئوي مباشرة بالأبهر الصاعد؛ تغلق عادة عند الولادة)",
 "ductus deferens": "أسهر, قناة ناقلة (قناة تحمل الحيوانات المنوية من البربخ إلى القناة الدافقة)",
 "dud": "خَامِل, فَاشِل (لا يَنْفَجِر؛ غَيْر مَشْحون بِمادَّة مُتَفَجِّرَة فَعَّالَة) / عمل فاشل, قنبلة (حدث يفشل بشدة أو يكون غير فعال تماماً) / فشل الاشتعال, كبوة (انفجار يفشل في الحدوث) / فاشِل, مُخْفِق (شخص غير ناجح)\nمثال: كانت التجربة الأولى عملاً فاشلاً حقاً",
 "dude": "متأنق (رجل يهتم كثيراً بملابسه ومظهره) / رفيق, صاحب (شكل غير رسمي لمخاطبة الرجل)\nمثال: قل لي يا صاح، ماذا تفعل؟",
 "dude ranch": "مزرعة سياحية (منتجع عطلات يقدم أنشطة المزرعة (ركوب الخيل والتخييم))",
 "dudeen": "غليون قصير (غليون فخاري بساق قصيرة)",
 "dudgeon": "حنق, غيظ مكتوم (شعور بالسخط الشديد)",
 "duds": "ملابس, هدوم (مصطلحات غير رسمية للملابس)",
 "due": "تماماً, مباشرة (مباشرة أو بالضبط؛ مستقيم) / مُسْتَحَقّ (مستحق وواجب الدفع فوراً أو عند الطلب) / لَازِم, وَاجِب (مناسب أو متوقع في الظروف الحالية) / رَاجِع إِلَى, قَابِل لِلنِّسْبَة (قابل للإسناد أو النسبة إلى شيء ما)\nمثال: ذهب شمالاً تماماً",
 "due care": "عناية واجبة (العناية التي يمارسها الرجل العاقل في ظل الظروف؛ المعيار لتحديد الواجب القانوني)",
 "due date": "مَوْعِد (مَوْعِد الإفطار،أي وقت الإفطار؛ لديه مَوْعِد مع صديق)\nمثال: مناد عنده موعد.",
 "due east": "الشَّرْق (نقطة البوصلة الأصلية التي تكون عند 90 درجة)",
 "due north": "الشَّمَال (نقطة البوصلة الأصلية التي تكون عند 0 أو 360 درجة)",
 "due process": "ضَمَان الحُقُوق (مَصْدَرُ ضَمِنَ؛ كَفَالَة)\nمثال: لا أستطيع ضمان أي شيء.",
 "due process of law": "أصول المحاكمة القانونية, إجراءات قانونية واجبة ((قانون) إقامة العدل وفقاً لقواعد ومبادئ راسخة؛ بناءً على مبدأ أنه لا يمكن حرمان الشخص من الحياة أو الحرية أو الممتلكات دون إجراءات قانونية وضمانات…)",
 "due south": "الجَنُوب (نقطة البوصلة الأصلية التي تكون عند 180 درجة)",
 "due to": "بِسَبَب, مِنْ جَرَّاء",
 "due west": "الغَرْب (نقطة البوصلة الأصلية التي تكون عند 270 درجة)",
 "duel": "مُبَارَزَة",
 "dueler": "مُبارز (شخص يخوض المبارزات)",
 "duelist": "مُبارز (شخص يخوض المبارزات)",
 "dueller": "مُبارز (شخص يخوض المبارزات)",
 "duellist": "مُبارز (شخص يخوض المبارزات)",
 "duenna": "دوينا, مُرَبِّيَة مُرافِقَة (امرأة (عادة مسنة) تعمل كمرافقة ومشرفة على الفتيات)",
 "duet": "با دو دو, رقص ثنائي ((في الباليه) رقصة لشخصين (عادة راقصة باليه وراقص نبيل)) / ثنائي, دويتو (تأليف موسيقي لمؤديين اثنين) / ثنائي, زوجان (زوج من الأشخاص يرتبطون ببعضهم البعض) / ثنائي (اثنان من المؤدين أو المغنين يؤدون معاً)\nمثال: الخطيبان",
