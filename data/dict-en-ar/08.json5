 "dot product": "جُدَاء قِيَاسِيّ, ضَرْب نُقَطِيّ (عدد حقيقي (كمية قياسية) هو حاصل ضرب متجهين)",
 "dot-com": "إلكتروني, دوت كوم (متعلق بشركات الإنترنت) / شركة إنترنت, شركة دوت كوم\nمثال: مؤسسة إنترنت (دوت كوم) في سان فرانسيسكو",
 "dotage": "خرف, هرم (الضعف العقلي نتيجة لكبر السن)",
 "dotard": "خرف (مسن في مرحلة الخرف؛ شخص أضعف العمر عقله)",
 "doting": "مُتَيَّم, مُدَلِّل (محب بإفراط أو بحماقة ومُتسامح بلا حدود)",
 "dotrel": "زقزاق أوراسي (زقزاق نادر من المناطق المرتفعة في أوراسيا)",
 "dotted": "مُتَقَطِّع, مُنَقَّط (بِهِ فَجَوَات أَوْ فَرَاغَات) / مُرَشَّش, مُنَقَّط (ذو نقش من النقاط)",
 "dotted gayfeather": "لياتريس منقطة (عشبة ذات سيقان عديدة تحمل عصي نحيلة ضيقة من الزهور الوردية اللافندر المزدحمة؛ وسط الولايات المتحدة وكندا إلى تكساس وشمال المكسيك)",
 "dotted line": "خط منقط (خط مكون من نقاط أو شرطات؛ يستخدم غالباً للإشارة إلى المكان الذي يجب التوقيع فيه على عقد (أو مستندات أخرى))\nمثال: فقط وقع على الخط المنقط",
 "dotterel": "زقزاق أوراسي (زقزاق نادر من المناطق المرتفعة في أوراسيا)",
 "dottily": "بِجُنُون, بِحُمْق (بطريقة جنونية خفيفة)\nمثال: السيدة العجوز بدأت تتصرف بخبل",
 "dottle": "بقايا التبغ (بقايا التبغ المحترق جزئياً المتروكة متكتلة في وعاء الغليون بعد التدخين)",
 "dotty": "مَهْوُوس, مُوَلَّه (شديد الحماسة أو الانشغال بشيء ما) / مَخْبُول, مَعْتُوه ((غير رسمي) مصطلحات عامّيّة تصف الاضطراب العقليّ)",
 "douaouda": "دواودة",
 "double": "ثُنَائِيّ / ضِعْف",
 "double acute accent": "نبرة حادة مزدوجة (علامة تشكيل في النص اللاتيني، تُستخدم بشكل أساسي في المجرية المكتوبة)",
 "double agent": "عَمِيل مُزْدَوِج (من تُعَامِله ويعاملك في التِجَارَة؛ وكيل التَاجِر في الجِهَات)\nمثال: سامي عميل فدرالي.",
 "double bar": "خط مزدوج (تدوين يشير إلى نهاية الأجزاء الرئيسية لمقطوعة موسيقية؛ خطان متجاوران)",
 "double bass": "كَمَان أَجْهَر, كونترباص",
 "double bassoon": "باسون مضاعف, كونتر باسون (الباسون الذي يعد أكبر آلة في عائلة الأوبوا)",
 "double bed": "سرير مزدوج (سرير واسع يكفي لاستيعاب شخصين نائمين)",
 "double bind": "مأزق مزدوج, ورطة مزدوجة ((علم النفس) معضلة غير قابلة للحل؛ وضع يتلقى فيه الشخص رسائل متناقضة من شخص ذي نفوذ قوي)",
 "double blind": "مزدوج التعمية (إجراء اختبار يتم فيه إخفاء هوية من يتلقون التدخل عن كل من المسؤولين والمشاركين حتى اكتمال الاختبار)",
 "double boiler": "حمّام مائي, غلاية مزدوجة (قدران، أحدهما يوضع داخل الآخر)",
 "double bond": "رابطة ثنائية, رابطة مزدوجة (رابطة تساهمية يتم فيها مشاركة زوجين من الإلكترونات بين ذرتين)",
 "double check": "تحقق إضافي, فحص مزدوج (شيء يتحقق من صحة فحص سابق)",
 "double chin": "ذِقْن مُزْدَوِج, لُغْد (الجزء الناتىء البارز في أسفل الوجه تحت الفم، وهو منبت اللِحْيَة عند الرَجُل؛ كناية اللِحْيَة)",
 "double clinch": "عقدة تثبيت مزدوجة (عقدة تثبيت بحلقتين)",
 "double cream": "دوبل كريم (جبن فرنسي طري طازج يحتوي على 60% دهون على الأقل)",
 "double creme": "كريمة خفق ثقيلة, كريمة مزدوجة (كريمة تحتوي على نسبة دهون 48% أو أكثر)",
 "double crochet": "عمود بلفة, غرزة كروشيه مزدوجة (نوع من غرز الكروشيه)",
 "double cross": "خداع مزدوج, غدر (فعل من أفعال الخيانة)\nمثال: لم أعد أتحمل خداعه المزدوج الوقح",
 "double dagger": "خنجر مزدوج (حرف يُستخدم في الطباعة للإشارة إلى مرجع ثالث أو حاشية سفلية بعد استخدام النجمة والخنجر)",
 "double damages": "تعويضات مضاعفة (ضعف المبلغ الذي ستجد المحكمة عادة أن الطرف المتضرر يستحقه)",
 "double date": "موعد مزدوج (موعد يشارك فيه زوجان)",
 "double decomposition": "تبادل مزدوج, تحلل مزدوج",
 "double decomposition reaction": "تبادل مزدوج, تحلل مزدوج",
 "double digit": "عَدَد ثُنَائِيّ الخَانَات, عَدَد مُكَوَّن من رَقَمَيْن (عدد صحيح مكون من رقمين؛ من 10 إلى 99)",
 "double dipper": "مزدوج الدخل (من الحكومة) (شخص يحصل على دخلين من الحكومة (عادة عن طريق الجمع بين الراتب والمعاش التقاعدي))",
 "double dipping": "دخل مزدوج (دخلان مستلمان من نفس المصدر (مثل شغل وظيفة حكومية وتلقي معاش تقاعدي حكومي))",
 "double door": "باب مزدوج (بابان عموديان يلتقيان في منتصف إطار الباب عند إغلاقهما)",
 "double dribble": "تنطيط مزدوج (مراوغة غير قانونية في كرة السلة (يستخدم اللاعب كلتا يديه للتنطيط أو يبدأ اللاعب بالتنطيط مرة ثانية بعد التوقف))",
 "double dutch": "القفز المزدوج, دبل داتش (النسخة الصعبة من قفز الحبل حيث يقفز اللاعبون فوق حبلين يتم أرجحتهما بطريقة متقاطعة) / كَلَام غَيْر مَفْهُوم (حديث غير مفهوم)",
 "double eagle": "النسر المزدوج (عملة ذهبية سابقة في الولايات المتحدة بقيمة 20 دولاراً) / إِيجِل مُزْدَوِج ((في الغولف) تسجيل ثلاث ضربات تحت المعدل في حفرة)",
 "double entendre": "تَوْرِيَة",
 "double entry": "قيد مزدوج (يقوم كاتب الحسابات بخصم المعاملة من حساب وإضافتها إلى آخر)",
 "double fault": "خطأ مزدوج ((تنس) خطآن متتاليان في الإرسال مما يؤدي إلى خسارة النقطة)",
 "double feature": "مباراتان متتاليتان (مباراتان بدلاً من واحدة (خاصة في البيسبول حين يلعب نفس الفريقين مباراتين في نفس اليوم))",
 "double first": "مرتبة الشرف الأولى المزدوجة (درجة شرف من الفئة الأولى في تخصصين)",
 "double flat": "بيمول مزدوج, خفض مزدوج (تدوين موسيقي لعلامتي خفض أمام نوتة يشير إلى وجوب خفضها بمقدار نصفي نغمة)",
 "double glazing": "زجاج مزدوج (نافذة بها لوحان من الزجاج ومساحة بينهما؛ تقلل انتقال الحرارة والضوضاء عبر النافذة)",
 "double gloucester": "دوبل غلوستر (جبن برتقالي محمر خفيف ناعم وصلب)",
 "double gold": "توهج ذهبي (عشب متفرع طويل جداً برؤوس زهور صفراء مزدوجة كثيرة ملفتة للنظر)",
 "double great primer": "برايمر كبير مزدوج (نوع طباعة بحجم 36 نقطة)",
 "double helix": "لولب مزدوج (زوج من الحلزونات المتوازية المتشابكة حول محور مشترك)\nمثال: شكل جزيء الحمض النووي هو لولب مزدوج",
 "double indemnity": "تعويض مزدوج (بند في بوليصة التأمين ينص على دفع ضعف القيمة الاسمية للبوليصة في حالة الوفاة العرضية)",
 "double jeopardy": "خطر مزدوج (محاكمة مدعى عليه لجريمة جنائية سبق محاكمته عليها؛ محظور في التعديل الخامس لدستور الولايات المتحدة)",
 "double knit": "حياكة مزدوجة (قماش محبوك يشبه الجيرسي مصنوع بمجموعتين من الإبر لإنتاج سمك مزدوج متصل بغرز متشابكة)",
 "double leg circle": "دائرة الرجلين المزدوجة (تمرين جمباز يُؤدى على حصان الحلق عندما يؤرجح لاعب الجمباز (مع ضم الساقين) ساقيه في دائرة مع تبديل اليدين على المقابض)",
 "double negative": "نفي مزدوج (نفي غير قياسي نحوياً ولكنه مؤكد) / نفي النفي (إيجاب مبني من نفيين)",
 "double obelisk": "خنجر مزدوج (حرف يُستخدم في الطباعة للإشارة إلى مرجع ثالث أو حاشية سفلية بعد استخدام النجمة والخنجر)",
 "double play": "إخراج مزدوج, لعبة مزدوجة (فعل إخراج لاعبين اثنين في لعبة واحدة)",
 "double plural": "جَمْع الْجَمْع (ضَمَّ، لَمَّ، حَشَدَ؛ في : أَضَافَ أعدادا إلى غيرها)\nمثال: جمع خيل هو خيول.",
 "double pneumonia": "التهاب رئوي مزدوج (التهاب رئوي فصي يشمل كلا الرئتين)",
 "double quick": "بِخُطْوَة سَرِيعَة, بِسُرْعَة مُضَاعَفَة (بسرعة أكبر)\nمثال: الآن دعونا نعزف القطعة مرة أخرى بسرعة مضاعفة",
 "double quotes": "علامات اقتباس مزدوجة (زوج من علامات الاقتباس)",
 "double reed": "ريشة مزدوجة (زوج من القصبات المتصلة التي تهتز معاً لإنتاج الصوت في بعض آلات النفخ الخشبية) / آلة ذات ريشة مزدوجة (آلة نفخ خشبية تحتوي على زوج من القصبات المتصلة التي تهتز معاً)",
 "double refraction": "انكسار مزدوج (انقسام شعاع إلى شعاعين متوازيين مستقطبين بشكل عمودي)",
 "double replacement reaction": "تفاعل إحلال مزدوج (تفاعل كيميائي بين مركبين يتم فيه تبادل الأيون الموجب لمركب مع الأيون الموجب لمركب آخر)",
 "double reverse": "لعبة عكسية مزدوجة ((كرة القدم الأمريكية) لعبة جري تتبع فيها لعبة عكسية أولى لعبة عكسية ثانية)",
 "double rhyme": "قافية مزدوجة (قافية من مقطعين)",
 "double room": "غُرْفَة مُزْدَوِجَة (اسم مفعول لما غُرِفَ من الماء وغيره باليد، الجمع غِرَاف؛ اسم؛ المكان في الدار أو المبنى محاط بأربع جدران وسقف، حُجْرَة، عِلِّيَّة. الجمع وغُرَف وغُرُفَات)\nمثال: الأب في الغرفة.",
 "double salt": "ملح مزدوج (محلول لملحين بسيطين يشكل مادة واحدة عند التبلور)",
 "double saucepan": "حمّام مائي, غلاية مزدوجة (قدران، أحدهما يوضع داخل الآخر)",
 "double sharp": "دييز مزدوج, رفع مزدوج (تدوين موسيقي لعلامتي رفع أمام نوتة يشير إلى وجوب رفعها بمقدار نصفي نغمة)",
 "double shot": "جرعة مزدوجة (100 مل من الخمور، تشرب من كأس جرعات)\nمثال: طلب جرعة مزدوجة من الفودكا وابتلعها بسرعة",
 "double standard": "كَيْلٌ بِمِكْيالَيْنِ, اِزْدِوَاجِيَّة الْمَعَايِير",
 "double standard of sexual behavior": "ازدواجية المعايير الجنسية (قانون يسمح بحرية جنسية أكبر للرجال مقارنة بالنساء (يرتبط بتبعية المرأة))",
 "double star": "نَجْم ثُنَائِيّ, نَجْم مُزْدَوِج (نظام من نجمين يدوران حول بعضهما البعض تحت تأثير جاذبيتهما المتبادلة)",
 "double stitch": "عمود بلفة, غرزة كروشيه مزدوجة (نوع من غرز الكروشيه)",
 "double stopping": "ضغط مزدوج للأوتار (ضغط وترين وإنتاج نغمتين في نفس الوقت)",
 "double take": "إعادة نظر, نظرة ثانية (رد فعل متأخر يشير إلى المفاجأة)",
 "double talk": "كَلَام مُلْتَبِس, مُرَاوَغَة لَفْظِيَّة (رطانة غير مفهومة عمداً)",
 "double time": "بِخُطْوَة سَرِيعَة, بِسُرْعَة مُضَاعَفَة (بسرعة أكبر) / أجر مضاعف (أجر مضاعف (للعمل الإضافي)) / خَطْوَة مُزْدَوِجَة (وتيرة مسير سريعة (180 خطوة/دقيقة) أو هرولة بطيئة)\nمثال: الآن دعونا نعزف القطعة مرة أخرى بسرعة مضاعفة",
 "double vision": "رؤية مزدوجة, شفع (ضعف بصري يُرى فيه الجسم كجسمين)\nمثال: غالباً ما يختفي الشفع عند تغطية إحدى العينين",
 "double-barreled": "مُزْدَوَج الغَرَض (له غرضان؛ ذو طبيعة مزدوجة) / ثنائي الماسورة, مزدوج الماسورة (له ماسورتان مثبتتان جنباً إلى جنب)\nمثال: بندقية صيد مزدوجة الماسورة",
 "double-barrelled": "مُزْدَوَج الغَرَض (له غرضان؛ ذو طبيعة مزدوجة) / ثنائي الماسورة, مزدوج الماسورة (له ماسورتان مثبتتان جنباً إلى جنب)\nمثال: بندقية صيد مزدوجة الماسورة",
 "double-bass": "كُونْتْرَابَاص (بنبرة أوكتاف واحد تحت المدى الطبيعيّ للباص الآليّ أو الصوتيّ)",
 "double-bedded": "ذُو سَرِير مُزْدَوِج (يحتوي على سرير مزدوج)",
 "double-bitted ax": "فأس مزدوجة الحد (فأس لها حواف قاطعة على كلا جانبي الرأس)",
 "double-bitted axe": "فأس مزدوجة الحد (فأس لها حواف قاطعة على كلا جانبي الرأس)",
 "double-blind experiment": "تجربة مزدوجة التعمية (إجراء تجريبي لا يعرف فيه لا الأشخاص الخاضعون للتجربة ولا الأشخاص الذين يديرونها الجوانب الحاسمة للتجربة)\nمثال: يتم استخدام إجراء التعمية المزدوجة للحماية من تحيز المجرب وتأثيرات الدواء الوهمي",
 "double-blind procedure": "تجربة مزدوجة التعمية (إجراء تجريبي لا يعرف فيه لا الأشخاص الخاضعون للتجربة ولا الأشخاص الذين يديرونها الجوانب الحاسمة للتجربة)\nمثال: يتم استخدام إجراء التعمية المزدوجة للحماية من تحيز المجرب وتأثيرات الدواء الوهمي",
 "double-blind study": "تجربة مزدوجة التعمية (إجراء تجريبي لا يعرف فيه لا الأشخاص الخاضعون للتجربة ولا الأشخاص الذين يديرونها الجوانب الحاسمة للتجربة)\nمثال: يتم استخدام إجراء التعمية المزدوجة للحماية من تحيز المجرب وتأثيرات الدواء الوهمي",
 "double-bogey": "بُوغِي مُزْدَوِج, دَبِل بُوغِي ((في الغولف) تسجيل ضربتين فوق المعدل لحفرة)",
 "double-breasted": "مزدوج الصدر ((عن الملابس) يغلق بلف حافة واحدة من الأمام جيداً فوق الأخرى عادةً بصف مزدوج من الأزرار)\nمثال: سترة مزدوجة الصدر",
 "double-breasted jacket": "سترة مزدوجة الصدر (سترة تتداخل مقدمتها بما يكفي لوجود صفين منفصلين من الأزرار)",
 "double-breasted suit": "بدلة مزدوجة الصدر (بدلة ذات سترة مزدوجة الصدر)",
 "double-chinned": "مُتَرَهِّل الفَكّ, مُزْدَوَج الذَّقْن (لَدَيْه طَيَّات لَحْمِيَّة مُتَدَلِّيَة تَحْتَ الذَّقْن أَوِ الفَكّ السُّفْلِيّ)",
 "double-crosser": "خائن, غادر (شخص يقول شيئاً ويفعل شيئاً آخر)",
 "double-crossing": "خداع مزدوج, غدر (فعل من أفعال الخيانة)\nمثال: لم أعد أتحمل خداعه المزدوج الوقح",
 "double-dealer": "خائن, غادر (شخص يقول شيئاً ويفعل شيئاً آخر)",
 "double-dealing": "ازدواجية, تعامل بوجهين (التصرف بسوء نية؛ الخداع بالتظاهر بامتلاك مجموعة من النوايا بينما يتصرف تحت تأثير أخرى) / ذُو وَجْهَيْن, مُرَاوِغ (يتَّسم بخداع متعمَّد خاصَّة بإظهار مشاعر والتصرُّف بمشاعر أخرى)",
 "double-deck carriage": "عربة قطار بطابقين (نوع من عربات السكك الحديدية التي تحتوي على مستويين لإقامة الركاب، بدلاً من مستوى واحد، مما يزيد من سعة الركاب)",
 "double-deck rail car": "عربة قطار بطابقين (نوع من عربات السكك الحديدية التي تحتوي على مستويين لإقامة الركاب، بدلاً من مستوى واحد، مما يزيد من سعة الركاب)",
 "double-deck railcar": "عربة قطار بطابقين (نوع من عربات السكك الحديدية التي تحتوي على مستويين لإقامة الركاب، بدلاً من مستوى واحد، مما يزيد من سعة الركاب)",
 "double-decker": "حافلة بطابقين, حافلة ذات طابقين (وسيلة نَقْل للركاب)\nمثال: لنذهب بالحافلة.",
 "double-decker bus": "حافلة بطابقين, حافلة ذات طابقين (وسيلة نَقْل للركاب)\nمثال: لنذهب بالحافلة.",
 "double-double": "ثنائية مزدوجة (الفوز ببطولتين رياضيتين في كل من عامين متتاليين)",
 "double-edged": "ذُو حَدَّيْن (قابل للتفسير بطريقتين عادة متناقضتين)",
 "double-edged sword": "سَيْفٌ ذُو حَدَّيْنِ (مصدر للفعل سَافَ؛ سِلاح ذو حَدّ واحد طويل يعتبر من الأسْلِحَة البيضاء لأنها مصنوعة من حَدِيد أبيض حاد. كان أهم أنواع الأسلحة قبل اخْتِرَاع الأسلحة النَارِيَّة)\nمثال: القلم أقوى من السيف.",
 "double-entry bookkeeping": "قيد مزدوج (يقوم كاتب الحسابات بخصم المعاملة من حساب وإضافتها إلى آخر)",
 "double-faced": "ذُو وَجْهَيْن, مُرَاوِغ (يتَّسم بخداع متعمَّد خاصَّة بإظهار مشاعر والتصرُّف بمشاعر أخرى) / ذُو وَجْهَيْن ((في الأقمشة) له وجهان صالحان للاستخدام)",
 "double-furrow plough": "محراث ثنائي الأخدود (محراث ذو لوحي تشكيل (قلابين))\nمثال: التربة البركانية الثقيلة، مثل تلك الموجودة في نيوزيلندا، تتطلب استخدام أربعة خيول جر ثقيلة لسحب محراث ثنائي الأخدود",
 "double-furrow plow": "محراث ثنائي الأخدود (محراث ذو لوحي تشكيل (قلابين))\nمثال: التربة البركانية الثقيلة، مثل تلك الموجودة في نيوزيلندا، تتطلب استخدام أربعة خيول جر ثقيلة لسحب محراث ثنائي الأخدود",
 "double-geared": "ذُو تَعْشِيق خَلْفِيّ ((عن المخرطة) مُجهَّز بتروس لتقليل سرعة المِغزل عن سرعة البَكَرة المحركة) / ذُو تَعْشِيق مُزْدَوَج (مُجهَّز بتروس مركبة من تِرسَيْن صغيرين وعَجَلتَيْن متعشقتين لزيادة القوة الميكانيكية)",
 "double-humped": "ثنائي السنام, ذو سنامين (له سنامان)",
 "double-hung window": "نافذة مزدوجة الرفع (نافذة لها درفتان تنزلقان لأعلى ولأسفل)",
 "double-jointed": "مُزْدَوَجُ المَفَاصِل (ذُو مَفَاصِلَ مَرِنَةٍ بِشَكْلٍ غَيْرِ اعْتِيَادِيٍّ خَاصَّةً فِي الأَطْرَافِ أَوِ الأَصَابِعِ)",
 "double-magnum": "زجاجة نبيذ كبيرة (زجاجة نبيذ كبيرة (تحمل 4/5 جالون))",
 "double-prop": "طائرة بمروحتين, طائرة مزدوجة المروحة (طائرة مروحية بمحرك يدير مروحتين في اتجاهين متعاكسين (للاستقرار))",
 "double-propeller plane": "طائرة بمروحتين, طائرة مزدوجة المروحة (طائرة مروحية بمحرك يدير مروحتين في اتجاهين متعاكسين (للاستقرار))",
 "double-quick": "سَرِيع الخُطَى ((عَنْ إِيقَاع المَشْي العَسْكَرِيّ) سَرِيع جِدًّا)",
 "double-reed instrument": "آلة ذات ريشة مزدوجة (آلة نفخ خشبية تحتوي على زوج من القصبات المتصلة التي تهتز معاً)",
 "double-spaced": "مُزْدَوَج التَّبَاعُد ((في الطباعة) يحتوي على سطر فارغ بين سطور النص)",
 "double-spacing": "مسافة مزدوجة (طباعة تترك أسطراً فارغة بالتناوب)",
 "double-tongued": "ذُو وَجْهَيْن, مُرَاوِغ (يتَّسم بخداع متعمَّد خاصَّة بإظهار مشاعر والتصرُّف بمشاعر أخرى)",
 "double-u": "دَابِلْيُو, دَابْلِيُو",
 "doubled": "ضِعْفِيّ, مُضَاعَف (ضعف الكمية أو العدد)",
 "doubleheader": "مباراتان متتاليتان (مباراتان بدلاً من واحدة (خاصة في البيسبول حين يلعب نفس الفريقين مباراتين في نفس اليوم))",
 "doubler": "مضاعف (جهاز إلكتروني يضاعف الجهد أو تردد إشارة الإدخال)",
 "doubles": "زوجي (التنس التي تُلعب بلاعبين في كل جانب) / زوجي (تنس الريشة التي تُلعب بلاعبين في كل جانب)",
 "doublespeak": "لغة مزدوجة (أي لغة تتظاهر بالتواصل ولكنها في الواقع لا تفعل ذلك)",
 "doublet": "دبلت, صدرية ضيقة (سترة رجالية ضيقة؛ كانت تلبس خلال عصر النهضة)",
 "doublethink": "تفكير مزدوج (الإيمان بفكرتين متناقضتين في نفس الوقت)",
 "doubleton": "ثُنَائِيَّة ((في البريدج) زوج من أوراق اللعب وهما الورقتان الوحيدتان من نوعهما في اليد الموزعة للاعب)",
 "doubletree": "عارضة الجر المزدوجة (عارضة في عربة يتم ربط عارضتي جر فرديتين بها لتسخير حصانين جنباً إلى جنب)",
 "doubling": "مضاعفة (زيادة الرهان في لعبة ورق بمعامل 2) / مضاعفة (زيادة بمقدار الضعف)\nمثال: قررت أن مضاعفته كانت خدعة",
 "doubloon": "دبلون",
 "doubly": "بشكل مضاعف, مرتين (لضعف الدرجة) / بشكل مزدوج, بطريقتين (بطريقة مزدوجة)\nمثال: كوفئت بشكل مضاعف",
 "doubly transitive verb": "فعل متعد لمفعولين (فعل متعد يأخذ مفعولاً به مباشراً ومفعولاً به غير مباشر)",
 "doubly transitive verb form": "فعل متعد لمفعولين (فعل متعد يأخذ مفعولاً به مباشراً ومفعولاً به غير مباشر)",
 "doubt": "شَكَّ ((شَكَّ) الشيءُ يَشُكُّ شَكًّا: لَصِقَ بعضُه ببعضَ واتَّصَلَ؛ (شَكَّ) القرابةُ: اتَّصَلَتْ) / شَكّ, شُبْهَة ((شَكَّ) الشيءُ يَشُكُّ شَكًّا: لَصِقَ بعضُه ببعضَ واتَّصَلَ؛ (شَكَّ) القرابةُ: اتَّصَلَتْ) / شُبْهَة\nمثال: إنها بلا شك محقة.",
 "doubter": "لَا أَدْرِيّ, مُتَشَكِّك (شخص متشكك أو غير ملتزم برأي حول شيء ما) / شاك, متشكك (شخص يشك عادة في المعتقدات المقبولة)",
 "doubtful": "مَشْكُوك فِيه, مُرْتَاب (مليء بالشكّ وعدم اليقين) / مَشْبُوه, مَشْكُوكٌ فِيه (يثير الشكّ أو الريبة) / مُبْدَئِيّ, مُتَرَدِّد (غير مستقرّ في الرأي؛ مُتذبذب)",
 "doubtfully": "بِرِيبَة, بِشَكّ (بطريقة مشككة)\nمثال: هز جيرالد رأسه بشك",
 "doubtfulness": "رِيبَة, شَكّ (عدم اليقين بشأن حقيقة أو واقعية أو وجود شيء ما) / ارتياب, شك (حالة عدم التأكد من شيء ما)\nمثال: الشك في ادعائه",
 "doubting": "شَكَّاك, مُتَشَكِّك (يتسم بالشك أو يميل إليه)",
 "doubting thomas": "توما الشكاك (شخص يطلب دليلاً مادياً لكي يقتنع (خاصة عندما يكون هذا الطلب في غير محله))",
 "doubtless": "بلا شك, من دون شك (بدون شك؛ بالتأكيد)\nمثال: إنه بلا شك جميل جداً",
 "doubtlessly": "بلا شك, من دون شك (بدون شك؛ بالتأكيد)\nمثال: إنه بلا شك جميل جداً",
 "douche": "وَابِل, دُوش",
 "douche bag": "دش مهبلي (حقنة صغيرة بفوهات قابلة للفصل؛ تستخدم للغسيل المهبلي والحقن الشرجية)",
 "dough": "عَجِين, عَجِينَة",
 "dough sheeter": "رقاقة عجين (آلة تستخدمها المخابز (الصناعية) لفرد العجين إلى صفيحة عجين (متسقة) بسمك عجين متساوٍ مطلوب)",
 "doughboy": "كرة عجين مقلية (كتلة مستديرة من العجين تقلى في زيت غزير وتقدم كخبز ساخن) / جندي مشاة (جندي مشاة أمريكي في الحرب العالمية الأولى)\nمثال: كانت كرة العجين المقلية سلفاً للدونات",
 "doughiness": "عجينية (جودة أو حالة امتلاك خصائص العجين، خاصة في المظهر أو القوام)\nمثال: كانت تتمتع بقرمشة الدجاج المقلي، المتوازنة مع عجينية الكرواسون المخبوز للتو",
 "doughnut": "دُونَات, شِفَنْج",
 "doughnut fryer": "آلة دونات, قلاية دونات (آلة تستخدم لقلي كميات كبيرة من الدونات في وقت واحد)",
 "doughnut machine": "آلة دونات, قلاية دونات (آلة تستخدم لقلي كميات كبيرة من الدونات في وقت واحد)",
 "doughnut-shaped": "حَلَقِيّ, دَائِرِيّ (ذو شكل يشبه الحلقة أو الخاتم)",
 "doughy": "عَجينِيّ, غَيْر مُخْتَمِر (ذو قِوام العَجين بِسَبَب قِلَّة التَّخْمير أو سوء الطَّبْخ)",
 "douglas fir": "تنوب دوغلاس (شجرة خشبية طويلة دائمة الخضرة في غرب أمريكا الشمالية ذات خشب راتنجي وإبر قصيرة) / شوح دوغلاس (خشب قوي ومتين لشجرة شوح دوغلاس)",
 "douglas hemlock": "تنوب دوغلاس الأخضر, صنوبر أوريغون (تنوب دوغلاس شاهق من شمال غرب أمريكا الشمالية له إبر قصيرة ومخاريط بيضاوية الشكل)",
 "douglas pine": "تنوب دوغلاس الأخضر, صنوبر أوريغون (تنوب دوغلاس شاهق من شمال غرب أمريكا الشمالية له إبر قصيرة ومخاريط بيضاوية الشكل)",
 "douglas scale": "مقياس دوغلاس (مقياس يستخدم لقياس ارتفاع الأمواج)",
 "douglas sea scale": "مقياس دوغلاس (مقياس يستخدم لقياس ارتفاع الأمواج)",
 "douglas spruce": "تنوب دوغلاس الأخضر, صنوبر أوريغون (تنوب دوغلاس شاهق من شمال غرب أمريكا الشمالية له إبر قصيرة ومخاريط بيضاوية الشكل)",
 "douglas squirrel": "سنجاب دوغلاس (نظير السنجاب الأحمر في أقصى غرب الولايات المتحدة)",
 "doula": "دولا, مدرب الولادة (مساعد (غالباً والد الطفل الذي سيولد قريباً) يقدم الدعم لامرأة في المخاض من خلال تشجيعها على استخدام التقنيات المستفادة في فصول التحضير للولادة)",
 "doum palm": "مُقْل, دَوْم",
 "dour": "عَبُوس, كَئِيب (يُظهر مزاجاً قاتماً ومكتئباً) / صَارِم, عَبُوس (غير مرحب بقسوة أو مهيب في الأسلوب أو المظهر) / عَنُود, مُثَابِر (ثابت بإصرار لا يلين ولا يتراجع)",
 "doura": "درة, ذرة بيضاء (سورغم المناطق الجافة في آسيا وشمال أفريقيا)",
 "dourah": "درة, ذرة بيضاء (سورغم المناطق الجافة في آسيا وشمال أفريقيا)",
 "dourly": "بِتَجَهُّم, بِعُبُوس (بطريقة عابسة)\nمثال: جلس على كرسيه بتجهم",
 "douroucouli": "دوروكولي, سعدان ليلي (قرد ليلي يعيش في أمريكا الوسطى والجنوبية، يتميز بعيون كبيرة وفراء كثيف)",
 "dousing": "تغطيس, غمر (فعل تبليل شيء بغمره)",
 "dove": "يَمَام, حَمَام",
 "dove's foot geranium": "إبرة الراعي الناعمة, غرنوقي قدم الحمامة (غرنوقي غربي بزهور وردية صغيرة؛ عشب ضار شائع في المروج والأراضي الفضاء)",
 "dovecote": "برج الحمام (بيت لطيور الحمام)",
 "dovekie": "أوك صغير (طائر أوك صغير قصير المنقار وفير في مناطق القطب الشمالي)",
 "dover's powder": "مسحوق دوفر (مسحوق طبي مصنوع أساساً من عرق الذهب والأفيون؛ كان يستخدم سابقاً لتخفيف الألم والحث على التعرق)",
 "dovetail": "تَعْشِيقَة / عَشَّقَ (فرط الحب حتى لا يستطيع العاشق الابتعاد عن المعشوق) / اِنْسَجَمَ مَعَ, رَكَّبَ\nمثال: أغاني العشق تحرك مشاعري.",
 "dovetail joint": "تعشيق ذيل الحمامة (وصلة نقر ولسان تتشكل عن طريق تداخل ألسنة ونقرات (على شكل ذيل حمامة))",
 "dovetail plane": "مِسْحَج التعشيق, مِسْحَج ذيل الحمام (مسحج نجارة مصمم لعمل الأخاديد لوصلات التعشيق (ذيل الحمامة))",
 "dovetail saw": "منشار التعشيق, منشار دقيق (منشار صغير مقوى الظهر يستخدم لقطع وصلات التعشيق)\nمثال: على الرغم من أن معظم أسنان منشار التعشيق معدة للقطع العرضي، إلا أن نمط أسنان منشار الشق الطولي أكثر كفاءة",
 "dovhe": "دوفهي",
 "dovish": "سَلَامِيّ, مُنَاهِضٌ لِلْحَرْب (مُعَارِضٌ لِلْحَرْب)",
 "dovishness": "سلمية, سياسة الحمائم (أي توجه سياسي يفضل التسوية لتجنب الصراع)",
 "dovyalis caffra": "تفاح كي, شجيرة تفاح كي (شجيرة شائكة قوية من جنوب أفريقيا تزرع لثمارها المستديرة الصفراء العصارية الصالحة للأكل)",
 "dovyalis hebecarpa": "عنب الثعلب السيلاني, كيتمبيلا (شجرة شجيرية شائكة صغيرة تزرع لثمارها المارونية الأرجوانية ذات اللب الأرجواني الحلو الذي طعمه مثل عنب الثعلب؛ سريلانكا والهند)",
 "dowager": "أرملة",
 "dowager's hump": "حدبة الأرملة (انحناء غير طبيعي في العمود الفقري ينتج عندما تسبب هشاشة العظام انهيار العمود الفقري)",
 "dowdily": "بِشَكْل رَثّ, بِشَكْل غَيْر أَنِيق (بطريقة رثة وغير عصرية)\nمثال: ترتدي ملابس رثة",
 "dowdiness": "دَمَامَة, رَثَاثَة (امتلاك صفة رثة أو كئيبة؛ الافتقار إلى الأناقة أو الجمال)",
 "dowdy": "رَثّ, مُتَزَمِّت المَظْهَر (قَدِيم الطِّرَاز بِشَكْلٍ مُتَزَمِّت) / بَلَا ذَوْق, رَدِيء المَظْهَر (يَفْتَقِر إِلَى الأَنَاقَة أَوِ الذَّوْق الحَسَن) / فطيرة تفاح مغطاة (حلوى تفاح عميقة الطبق مغطاة بقشرة غنية)",
 "dowel": "مسمار خشبي, وتد (مثبت يتم إدخاله في ثقوب في قطعتين متجاورتين لتثبيتهما معاً)",
 "dowel pin": "مسمار خشبي, وتد (مثبت يتم إدخاله في ثقوب في قطعتين متجاورتين لتثبيتهما معاً)",
 "doweling": "تثبيت بالأوتاد, تثبيت بالمسامير (التثبيت باستخدام الأوتاد أو المسامير الخشبية)",
 "dower": "نصيب الأرملة (حق انتفاع مدى الحياة يحق للزوجة الحصول عليه عند وفاة زوجها) / جهاز العروس, دوطة (مال أو ممتلكات تجلبها المرأة لزوجها عند الزواج)",
 "dowered": "ذُو مَهْر (مُزوَّد بمهر أو جهاز)",
 "dowerless": "بِلَا مَهْر (يفتقر إلى المهر أو الجهاز)",
 "dowery": "جهاز العروس, دوطة (مال أو ممتلكات تجلبها المرأة لزوجها عند الزواج)",
 "dowitcher": "دويتشر, شنقب طويل المنقار (طائر ساحلي من فصيلة الطيطوي يشبه الشنقب)",
 "down": "تَحْتَ, تَحْت (أَقَلَّ) / حَتَى, إِلَى (يفيد انتهاء الغاية؛ يفيد الغاية) / سقط (تَحَرَّكَ من أعلى إلى أسفل بتأثير الجاذبية، وَقَعَ؛ في كلامه: أخْطَأَ، أو قال قولا لا ينبغي أو لا يريد قوله) / زَغَب\nمثال: أنا تحت الشجرة.",
 "down easter": "ميني (مواطن أو مقيم في مين)",
 "down feather": "رِيش نَاعِم, زَغَب (ريش ناعم ورقيق)",
 "down in the mouth": "كَئِيب, مُكْتَئِب (مَمْلُوءٌ بِالكَآبَةِ وَالقُنُوط)",
 "down payment": "دفعة أولى, عربون (دفعة جزئية تُدفع وقت الشراء؛ والباقي يُدفع لاحقاً)",
 "down quark": "كُوَارْكُ سُفْلِيّ",
 "down syndrome": "مُتَلَازِمَة دَاوْن",
 "down the stairs": "أسفل الدرج, في الطابق السفلي (في طابق أدنى)\nمثال: المستأجرون يعيشون في الطابق السفلي",
 "down town": "مركز المدينة, وسط البلد (مركز المدينة (وغالباً ما يحتوي على المباني الحكومية والتجارية))",
 "down with": "يسقط, تسقط",
 "down's syndrome": "المنغولية, متلازمة داون (اضطراب خلقي ناجم عن وجود كروموسوم 21 إضافي؛ يؤدي إلى وجه مسطح وقصر القامة وتخلف عقلي)",
 "down-and-out": "مُعْدَم, مُفْلِس (يفتقر إلى الموارد أو أي احتمال للحصول عليها) / بائِس, مُعْدَم (شخص يعيش في فقر مدقع)\nمثال: حاول مساعدة البائسين",
 "down-bow": "سحبة قوس لأسفل (ضربة لأسفل من كعب القوس إلى طرفه)",
 "down-to-earth": "عَمَلِيّ, وَاقِعِيّ (عمليّ ومنطقي بعيد عن التنظير)",
 "downbeat": "نبرة هابطة, نقر قوي (النقر الأول في المقياس الموسيقي (مع حركة ذراع المايسترو للأسفل))",
 "downbound": "مُتَّجِهٌ لِلْأَسْفَل (يَسِيرُ فِي اتِّجَاهٍ يُعْتَبَرُ تَقْلِيدِيًّا نُزُولًا)",
 "downcast": "كَئِيب, مُكْتَئِب (مَمْلُوءٌ بِالكَآبَةِ وَالقُنُوط) / مُطْرَق, مُنَكَّس (مُوَجَّهٌ نَحْوَ الأَسْفَل) / بئر تهوية هابط (عمود تهوية يدخل من خلاله الهواء إلى المنجم)",
 "downdraft": "تيار هابط (تيار هوائي هابط قوي)",
 "downer": "دواء مهدئ, مثبط (دواء يقلل من الاستثارية ويهدئ الشخص)",
 "downfall": "دمار, سقوط (فشل يؤدي إلى فقدان المنصب أو السمعة) / انهيار, سقوط (تراجع مفاجئ في القوة أو العدد أو الأهمية) / سقوط, هطول (سقوط أي شكل من أشكال الماء على الأرض (مطر أو ثلج أو برد أو صقيع أو رذاذ))\nمثال: سقوط آل هابسبورغ",
 "downfield": "إلى الأمام, نحو الملعب (في اتجاه نهاية ملعب الفريق المدافع) / نَحْوَ مَلْعَبِ الدِّفَاع (يَقَعُ عِنْدَ أَوْ أَقْرَبَ إلى طَرَفِ المَلْعَبِ الخَاصِّ بِالفَرِيقِ المُدَافِع)\nمثال: أمسك الكرة وركض نحو الملعب 15 ياردة",
 "downgrade": "مَنْزَل, مُنْحَدَر هَابِط (الخاصية التي يمتلكها منحدر أو سطح ينخفض للأسفل)",
 "downhearted": "كَئِيب, مُكْتَئِب (مَمْلُوءٌ بِالكَآبَةِ وَالقُنُوط)",
 "downheartedness": "تثبيط, هبوط المعنويات (شعور بانخفاض المعنويات)\nمثال: شعر بالمسؤولية عن انخفاض معنوياتها",
 "downhill": "مُنْحَدِرًا, نَحْو الأَسْفَل (باتجاه أسفل التل) / فِي انْحِدَار, نَحْو الأَسْوَأ (نحو حالة أدنى أو أسوأ) / مُنْحَدِر, هَابِطٌ بِشِدَّة (يَنْحَدِرُ نَحْوَ الأَسْفَلِ بِحِدَّة) / تزلج الانحدار, سباق الانحدار (سباق تزلج أسفل منحدر)\nمثال: عند الجري نحو الأسفل، اكتسب الكثير من السرعة",
 "downiness": "زغب, هشاشة (نعومة خفيفة)",
 "downing street": "داونينغ ستريت (الحكومة البريطانية)",
 "downlike": "رَقِيق كَالزَّغَب, زَغَبِيّ (ناعِم وخَفيف كالرِّيش أو الزَّغَب)",
 "download": "تَنْزِيل / نَزَّلَ (ضد صَعَدَ، اِنْحَدَرَ أو اِنْخَفَضَ؛ القوم: حَلُّوا في مكان ما)\nمثال: نزل علينا الخوف.",
 "downmarket": "رخيص, شعبي (مصمم للمستهلكين ذوي الدخل المنخفض)",
 "downplay": "قَلَّلَ",
 "downpour": "وَابِل, مَطَر غَزِير",
 "downright": "تماماً, كلياً / صِرْف, مَحْض (تامّ بلا تحفّظ أو تقييد؛ يُستخدم أحيانًا مُكثِّفًا غير رسميّ) / صَرِيح, مُبَاشِر (يتَّسم بالصراحة الواضحة والمباشرة)\nمثال: هو غير صادق تماماً",
 "downrightness": "صراحة, مباشرة (صفة المباشرة والوضوح التام)\nمثال: ما يعتبره بعض الناس وقاحة هو في الحقيقة صراحة",
 "downriver": "مع التيار, نحو المصب (بعيداً عن المصدر أو مع التيار)",
 "downscale": "اِقْتِصَادِيّ, شَعْبِيّ (مُوَجَّهٌ لِذَوِي الدُّخُولِ المُنْخَفِضَة)",
 "downshift": "نقل لسرعة أدنى (التغيير إلى ترس أقل في السيارة أو الدراجة) / تغيير لنمط حياة أبسط (تغيير من مهنة مجزية مالياً ولكنها مرهقة إلى مهنة أقل أجراً ولكنها أكثر إشباعاً)",
 "downside": "جانب سلبي, عيب (جانب سلبي لشيء إيجابي بشكل عام)\nمثال: هناك جانب سلبي حتى للأمومة",
 "downsizing": "تقشف, تقليص النفقات (تخفيض النفقات من أجل الاستقرار المالي)",
 "downslope": "انحدار, نزول (منحدر أو انحناء نحو الأسفل)",
 "downspin": "انهيار, تدهور سريع (تراجع سريع وخطير)",
 "downstage": "فِي مُقَدِّمَة المَسْرَح (عند أو باتجاه مقدمة المسرح) / أمامي (للمسرح) (للنصف الأمامي من خشبة المسرح) / مقدمة المسرح (النصف الأمامي للمسرح (كما يراه الجمهور))\nمثال: تحرك الممثلون أكثر فأكثر نحو مقدمة المسرح",
 "downstair": "سفلي (طابق) (في أو من الطوابق السفلية لمبنى)\nمثال: الهاتف في الطابق السفلي",
 "downstairs": "أسفل الدرج, في الطابق السفلي (في طابق أدنى) / سفلي (طابق) (في أو من الطوابق السفلية لمبنى)\nمثال: المستأجرون يعيشون في الطابق السفلي",
 "downstream": "مع التيار (يفيد الاجتماع والمصاحبة؛ مكان الاجتماع)\nمثال: جئت مع أصدقائي.",
 "downstroke": "خط نازل, شطبة سفلية (خط يُرسم عادة في اتجاه تنازلي)",
 "downswing": "تراجع, ركود (تدهور في النشاط التجاري أو الاقتصادي) / أرجحة لأسفل (أرجحة مضرب الغولف للأسفل)\nمثال: شهد السوق ركوداً",
 "downtick": "انخفاض طفيف, تراجع (معاملة في سوق الأسهم بسعر أقل من سعر المعاملة السابقة)",
 "downtime": "فترة التعطيل",
 "downtown": "وَسَطُ البَلَد",
 "downtrodden": "مَظْلُوم, مُسْتَضْعَف (يَتَعَرَّضُ لِلْقَهْرِ أَوِ الظُّلْمِ مِنْ ذَوِي السُّلْطَةِ)",
 "downturn": "تراجع, ركود (تدهور في النشاط التجاري أو الاقتصادي)\nمثال: شهد السوق ركوداً",
 "downward": "لأسفل, نزولاً (مكانياً أو مجازياً من مستوى أو موضع أعلى إلى أدنى)\nمثال: لا تسقط لأسفل",
 "downward-arching": "مُقَوَّسٌ لِلْأَسْفَل (يَنْحَنِي مُتَقَوِّسًا نَحْوَ الأَسْفَل)",
 "downward-sloping": "مُنْحَدِر, هَابِطٌ بِشِدَّة (يَنْحَدِرُ نَحْوَ الأَسْفَلِ بِحِدَّة)",
 "downwardly": "لأسفل, نزولاً (مكانياً أو مجازياً من مستوى أو موضع أعلى إلى أدنى)\nمثال: لا تسقط لأسفل",
 "downwards": "لأسفل, نزولاً (مكانياً أو مجازياً من مستوى أو موضع أعلى إلى أدنى)\nمثال: لا تسقط لأسفل",
 "downwind": "مع الريح (مع الريح؛ في اتجاه هبوب الريح) / باتجاه الريح (نحو الريح) / مَعَ اتِّجَاه الرِّيح (نحو الجانب البعيد عن مصدر الرياح)\nمثال: طاروا مع الريح",
 "downy": "زَغِب, وَبَرِيّ (مغطى بشعيرات ناعمة ورقيقة أو زغب) / رَقِيق كَالزَّغَب, زَغَبِيّ (ناعِم وخَفيف كالرِّيش أو الزَّغَب)",
 "downy ash": "مران أحمر, مران زغبي (شجرة أمريكية صغيرة نوعاً ما بغصينات مخملية وأسطح أوراق سفلية مخملية)",
 "downy birch": "بتولا بيضاء, بتولا زغبية (بتولا أوروبية بلحاء أبيض باهت إلى بني شاحب وفروع مشعرة متدلية نوعاً ما)",
 "downy brome": "برومس زغبي, عشبة الغش (عشبة سنوية أو شتوية سنوية بأوراق مشعرة بنعومة من البحر الأبيض المتوسط)",
 "downy bromegrass": "برومس زغبي, عشبة الغش (عشبة سنوية أو شتوية سنوية بأوراق مشعرة بنعومة من البحر الأبيض المتوسط)",
 "downy cheat": "برومس زغبي, عشبة الغش (عشبة سنوية أو شتوية سنوية بأوراق مشعرة بنعومة من البحر الأبيض المتوسط)",
 "downy chess": "برومس زغبي, عشبة الغش (عشبة سنوية أو شتوية سنوية بأوراق مشعرة بنعومة من البحر الأبيض المتوسط)",
 "downy ground cherry": "حرنكش, كرز أرضي زغبي (نبات حولي أمريكي زخرفي له توت أصفر لحمي مستدير محاط بقشرة تشبه المثانة)",
 "downy haw": "زعرور أحمر, زعرور زغبي (زعرور أمريكي أحمر الثمار بسيقان وأوراق مغطاة بكثافة بشعر صوفي قصير)",
 "downy manzanita": "مانزانيتا زغبية (شجيرة كاليفورنية قائمة مفتوحة التفرع تكون أغصانها صوفية عندما تكون صغيرة)",
 "downy mildew": "بياض زغبي, بياض كاذب (أي من الفطريات المختلفة من فصيلة بيرونوسبوراسيا تتطفل على العنب والبطاطس والبطيخ وغيرها)",
 "downy poplar": "خشب القطن المستنقعي (حور من أمريكا الشمالية بأوراق كبيرة مستديرة صدفيّة ولحاء وخشب بني)",
 "downy wood mint": "نعناع الخشب الزغبي (صنف من نعناع الخشب بزهور وردية أرجوانية مكدسة لتشبه الباغودا)",
 "downy woodpecker": "نقار الخشب الزغبي (نقار خشب صغير من أمريكا الشمالية ذو ريش أسود وأبيض ومنقار صغير)",
 "downy yellow violet": "بنفسج أصفر زغبي (بنفسج من شرق أمريكا الشمالية له أوراق وسيقان مزغبة ناعمة وزهور صفراء صافية بعروق بنية أرجوانية)",
 "dowry": "مَهْر",
 "dowse": "تكهن بالعصا, كشف المياه (البحث عن المياه الجوفية أو المعادن باستخدام عصا الكشف)",
 "dowser": "عصا التكهن, عصا الكشف عن المياه (عصا متشعبة يُزعم أنها تنحني لأسفل للإشارة إلى وجود مياه جوفية أو نفط) / منقب بالعصا (شخص يستخدم عصا التنقيب للعثور على المياه الجوفية)",
 "dowsing": "تكهن بالعصا, كشف المياه (البحث عن المياه الجوفية أو المعادن باستخدام عصا الكشف)",
 "dowsing rod": "عصا التكهن, عصا الكشف عن المياه (عصا متشعبة يُزعم أنها تنحني لأسفل للإشارة إلى وجود مياه جوفية أو نفط)",
 "doxastic logic": "منطق الاعتقاد (منطق الموجهات المتعلق بالاعتقاد وعدم الاعتقاد)",
 "doxazosin": "دوكسازوسين, كاردورا (دواء خافض لضغط الدم (الاسم التجاري كاردورا) يعمل عن طريق إرخاء الأوعية الدموية بحيث يمر الدم عبرها بسهولة أكبر؛ يستخدم أيضاً لعلاج تضخم البروستاتا…)",
 "doxepin": "أدابين, دوكسيبين (مضاد اكتئاب ثلاثي الحلقات (الأسماء التجارية أدابين وسينيكوان) له آثار جانبية عديدة (جفاف الفم وتهدئة واضطرابات هضمية))",
 "doxepin hydrochloride": "أدابين, دوكسيبين (مضاد اكتئاب ثلاثي الحلقات (الأسماء التجارية أدابين وسينيكوان) له آثار جانبية عديدة (جفاف الفم وتهدئة واضطرابات هضمية))",
 "doxing": "دوكسينغ, كشف الهوية (نشر المعلومات الشخصية لشخص ما على الويب بقصد التسبب في المضايقة)",
 "doxology": "تمجيد, ذوكسولوجيا (ترنيمة أو آية في الليتورجيا المسيحية تمجد الله)",
 "doxorubicin": "دوكسوروبيسين (مضاد حيوي يستخدم كدواء مضاد للسرطان)",
 "doxy": "محظية (امرأة تعيش مع رجل مهم (دون زواج رسمي))",
 "doxycycline": "دوكسيسيكلين, فيبراميسين (مضاد حيوي مشتق من التتراسيكلين فعال ضد العديد من الالتهابات)\nمثال: فيبراميسين هو الاسم التجاري للدوكسيسيكلين",
 "doyen": "عَمِيد (رجل هو العضو الأقدم في مجموعة ما)\nمثال: هو عميد المراسلين الأجانب",
 "doyenne": "عَمِيدَة (امرأة هي العضو الأقدم في مجموعة ما)",
 "doyley": "مفرش دانتيل صغير, مفرش طبق (قطعة دائرية صغيرة من الكتان توضع تحت طبق أو وعاء)",
 "doyly": "مفرش دانتيل صغير, مفرش طبق (قطعة دائرية صغيرة من الكتان توضع تحت طبق أو وعاء)",
 "doze": "غفوة, نعاس (نوم خفيف متقطع)",
 "dozen": "دَزِّينَة / دَسْتَة / دَرْزَن",
 "dozens": "أطنان, أكوام (عدد أو كمية كبيرة)\nمثال: كون الكثير من الصداقات الجديدة",
 "dozer": "بلدوزر, جرافة (جرار قوي كبير؛ شفرة كبيرة في الأمام تسوي مناطق من الأرض)",
 "dozy": "نَاعِس, نَعْسَان (نصف نائم؛ يغالبه النعاس)",
 "dp": "شخص بلا جنسية, نازح (شخص أجبر على الفرار من منزله أو بلده)",
 "dph": "دكتوراه في الصحة العامة (درجة الدكتوراه في الطب الوقائي)",
 "dphil": "دكتوراه في الفلسفة (دكتوراه بريطانية)",
 "dpt vaccine": "لقاح الثلاثي البكتيري (اختصار للقاح مركب ضد الخناق والسعال الديكي والكزاز؛ يعطى عادة في سلسلة من الحقن في مرحلة الطفولة المبكرة)",
 "dr.": "طبيب (ممارس طبي مرخص) / حامل الدكتوراه, دكتور (شخص يحمل درجة الدكتوراه (أو ما يعادلها) من مؤسسة أكاديمية)\nمثال: شعرت بسوء شديد فذهبت لرؤية طبيبي",
 "drab": "قَاتِم, كَئِيب (يبعث على الحزن والكآبة) / أَخْضَر زَيْتُونِيّ بَاهِت (بلون أخضر بني فاتح) / دَاكِن, قَاتِم (ذو لون كئيب وخافت يفتقر إلى الحيويّة) / رَتِيب, كَئِيب (يفتقر إلى الحيوية أو السحر أو المفاجأة)",
 "draba": "درابا, عشبة الجوع (أي من النباتات العديدة منخفضة النمو التي تشكل وسائد من جنس درابا، ولها أوراق وردية وعناقيد طرفية من الزهور الصغيرة بسيقان ورقية أو شبه خالية من…)",
 "draba verna": "دربة, عشبة الداحس (عشبة ضارة حولية من أوروبا وأمريكا الشمالية ذات وريدة من الأوراق القاعدية وأزهار صغيرة تليها كبسولات بذور مستطيلة)",
 "drably": "بِشَكْل بَاهِت, دُونَ بَرِيق (بطريقة باهتة)\nمثال: ترتدي ملابس باهتة",
 "drabness": "دَمَامَة, رَثَاثَة (امتلاك صفة رثة أو كئيبة؛ الافتقار إلى الأناقة أو الجمال)",
 "dracaena": "تنين شجري, دراسينا (نوع من الأغاف يزرع غالباً لأوراقه المزخرفة)",
 "dracaena draco": "شجرة التنين (شجرة طويلة من جزر الكناري؛ مصدر لدم التنين)",
 "drachm": "درهم سائل (وحدة للسعة أو الحجم في نظام الصيدلة تساوي ثُمن الأونصة السائلة) / درهم سائل (مقياس سعة إمبراطوري بريطاني (سائل أو جاف) يساوي 60 مينيماً) / دراخما, درهم (وحدة وزن صيدلانية تساوي ثمن أوقية أو 60 قمحة)",
 "drachma": "دِرَاخْمَا",
 "draco": "تِنِّين",
 "dracocephalum parviflorum": "دراكوسيفالوم, رأس التنين (عشب أمريكي له أوراق رمحية حادة التسنن وسنابل من الزهور الزرقاء إلى البنفسجية)",
 "draconian": "شَدِيد الْقُسْوَة",
 "dracontium": "دراكونتيوم (أي نبات من جنس دراكونتيوم؛ نباتات استوائية أمريكية قوية الرائحة الكريهة عادة بأوراق عملاقة)",
 "dracunculiasis": "داء التنينات, دودة غينيا (عدوى مؤلمة ومنهكة يتم التقاطها عن طريق شرب المياه الراكدة الملوثة بيرقات دودة غينيا التي يمكن أن تنضج داخل بطن الإنسان حتى تخرج الدودة من خلال بثرة…)",
 "dracunculus medinensis": "دودة غينيا (دودة أسطوانية طفيلية في الهند وأفريقيا تعيش في البطن أو تحت جلد البشر والفقاريات الأخرى)",
