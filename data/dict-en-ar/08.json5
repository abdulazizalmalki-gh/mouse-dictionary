 "disinfestation": "إبادة الحشرات, تطهير من الآفات (نشاط التخلص من الآفات والحشرات)",
 "disinfestation officer": "صائد الجرذان, مكافح القوارض (عامل يعمل لتدمير أو طرد الهوام والقوارض)",
 "disinflation": "تراجع التضخم (تخفيض الأسعار بهدف تحسين ميزان المدفوعات)",
 "disinformation": "مَعْلُومَات مُضَلِّلَة",
 "disingenuous": "ماكر, متصنع (غير صريح أو مباشر؛ يعطي مظهراً كاذباً للصراحة)\nمثال: عامل طموح، ومخادع، وجاهل، ومنافق، جسد؛ أكثر السمات البغيضة في عصره",
 "disingenuously": "بِتَصَنُّع, بِخُبْث (بطريقة مخادعة)\nمثال: بمراوغة، طرح أسئلة موجهة حول عمل خصمه",
 "disingenuousness": "خبث, عدم صراحة (صفة عدم الصراحة والافتقار إلى الصدق والمكاشفة)",
 "disinherit": "حَرَمَ مِنَ ٱلْوَرَاثَة (مَنَعَ ولم يعطِ)\nمثال: حرم الإسلام الترويع",
 "disinheritance": "حرمان من الميراث (فعل من قبل المورث ينهي حق الشخص في الميراث)",
 "disinherited": "مَحْرُومٌ مِنَ الإِرْث (حُرِم من إرثه المشروع)",
 "disintegrable": "قَابِلٌ لِلانْصِهَار (يمكن صهره وإذابته بالحرارة)",
 "disintegration": "إبادة, محق (تدمير شامل) / اضمحلال إشعاعي, تفكك إشعاعي (التفكك التلقائي لمادة مشعة مصحوب بانبعاث إشعاع مؤين) / انحلال, تفكك (الانفصال إلى أجزاء مكونة) / تفتت, تفكك (في حالة متحللة)\nمثال: أدت تجارب القنابل إلى إبادة الجزيرة المرجانية",
 "disintegrative": "انحلالي, تفكيكي (يميل للتسبب في التفكك إلى عناصر أو أجزاء مكونة)",
 "disinterest": "حياد, عدم اكتراث (تسامح نابع من عدم الانخراط أو المشاركة) / عدم اهتمام, لا مبالاة (افتقاد الاهتمام)",
 "disinterested": "مُجَرَّدٌ مِنَ الهَوَى, نَزِيه (غَيْرُ مُتَأَثِّرٍ بِالمَصْلَحَةِ الذَّاتِيَّة)",
 "disinterestedly": "بِتَجَرُّد, بِنَزَاهَة (بدون تحيز؛ بدون دوافع أنانية)\nمثال: حكم في القضية بتجرد",
 "disinterestedness": "تجرد, ترفع عن الغرض (الخلو من التحيز أو الدوافع الأنانية)",
 "disinterment": "استخراج الجثة, نبش (فعل حفر الأرض لاستخراج شيء ما (خاصة جثة) من مدفنها)",
 "disinvestment": "سحب الاستثمار (سحب رأس المال من دولة أو شركة)",
 "disjoined": "مَفْكُوك, مُنْفَرِد (فُكَّ اتِّصَالُهُ؛ أَصْبَحَ مُنْفَصِلًا)",
 "disjoint": "لَا تَقَاطُعَ بَيْنَهُمَا, مُنْفَصِل (ليس بينهما عناصر مشتركة)",
 "disjointed": "مُبَعْثَر, مُشَوَّش (يفتقر إلى الاستمرارية المنظمة) / مَخْلُوع, مَفْصُول (منفصل عند المفصل؛ متخلّع) / مَفْصُول, مُفَكَّكُ المَفَاصِل (مَفْصُول عِنْدَ المَفَاصِل)",
 "disjointedly": "بِتَقَطُّع, بِشَكْل مُفَكَّك (بطريقة مفككة)\nمثال: 'نحن لسنا متزوجين، لسنا متزوجين حقاً'، قالت، وببطء، وعلى مضض، وبشكل مفكك خرج الكلام",
 "disjointedness": "تفكك (الافتقار إلى النظام أو التماسك)",
 "disjunct": "قافز, منفصل ((في الموسيقى) يتقدم لحنياً بفترات أكبر من ثانية كبيرة) / مُتَبَاعِد, مُنْفَصِل (يُوصَفُ بِهِ التَّوْزِيعُ الإِحْصَائِيُّ أَوِ الطَّبِيعِيّ المُنْفَصِل) / مَفْصُول, مُنْقَطِع (يتّسم بالانفصال عن العناصر المتاخمة عادةً) / مُنْفَصِلُ الأَجْزَاء (ذُو تَضَيُّقَاتٍ عَمِيقَةٍ تَفْصِل الرَّأْسَ عَن الصَّدْرِ وَالبَطْن، كَمَا فِي الحَشَرَات)",
 "disjunction": "فصل, قطع الاتصال (عملية قطع الاتصال) / انفصال, تفكك (حالة الانفصال)",
 "disjunctive": "انفصالي, فصلي (يخدم أو يميل إلى التقسيم أو الفصل)",
 "disjunctive conjunction": "رَبْط تَخْيِيرِيّ, عَطْف انْفِصَالِيّ (علاقة الربط بين الوحدات التي تعبر عن الفصل بين معانيها (مثل: أو))",
 "disjuncture": "انفصال, تفكك (حالة الانفصال)",
 "disk": "قُرْص / دَائِرَة (في : الشكل الهندسي الذي ليس له نقطة بداية ولا نهاية ويتكون من قَوْس مستمر؛ الهيئة أو الجهة التي تدير امرا ما) / أُسْطُوَانَة\nمثال: رجاء ضع دائرة حول الجواب الصحيح.",
 "disk access": "وصول للقرص (الوصول إلى ذاكرة قرص الكمبيوتر الذي تخزن فيه المعلومات)",
 "disk brake": "فرامل ديسك, مكبح قرصي (مكبح هيدروليكي يتم فيه تطبيق الاحتكاك على جانبي قرص دوار بواسطة وسادات الفرامل)",
 "disk cache": "ذاكرة التخزين المؤقت للقرص",
 "disk clutch": "قابض قرصي (قابض احتكاكي تكون فيه أسطح الاحتكاك عبارة عن أقراص)",
 "disk controller": "وحدة تحكم القرص ((في علم الحاسوب) دائرة أو شريحة تترجم الأوامر إلى شكل يمكنه التحكم في محرك الأقراص الصلبة)",
 "disk drive": "قرص صلب, محرك أقراص (جهاز حاسوب يحمل ويدير قرصاً مغناطيسياً أو ضوئياً ويقرأ ويكتب المعلومات عليه)",
 "disk error": "خطأ في القرص (خطأ ناتج عن خلل في القرص المغناطيسي)",
 "disk file": "ملف قرصي ((علوم الحاسوب) ملف حاسوبي مخزن على قرص مغناطيسي ومعرف بتسمية فريدة)",
 "disk harrow": "مسلفة قرصية (مسلفة ذات سلسلة من الأقراص مثبتة على الحافة بزاوية)",
 "disk jockey": "دي جي, منسق موسيقى (شخص يعلن ويشغل الموسيقى المسجلة الشعبية)",
 "disk operating system": "دوس, نظام تشغيل القرص (نظام تشغيل يوجد على قرص)",
 "disk overhead": "عبء التخزين, مساحة تنظيمية ((علم الحاسوب) مساحة القرص المطلوبة للمعلومات التي ليست بيانات ولكنها تستخدم للموقع والتوقيت)",
 "disk pack": "حزمة أقراص ((علم الحاسوب) حزمة محمولة من الأقراص المغناطيسية تُستخدم في جهاز تخزين الأقراص)",
 "disk shape": "دائرية, شكل قرصي (استدارة شكل ثنائي الأبعاد)",
 "disk space": "مساحة القرص ((علم الحاسوب) المساحة المتوفرة على القرص المغناطيسي)",
 "disk-shaped": "قُرْصِيّ, مُسَطَّحٌ دَائِرِيّ (ذو شكل دائري مسطّح كالقرص)",
 "diskette": "ديسك, قرص مرن (قرص مغناطيسي بلاستيكي صغير مغلف في غلاف صلب بفتحة شعاعية؛ يستخدم لتخزين البيانات أو البرامج للحاسوب الصغير)\nمثال: تشتهر الأقراص المرنة بسرعتها البطيئة نسبياً وسعتها الصغيرة وسعرها المنخفض",
 "disklike": "قُرْصِيّ, مُسَطَّحٌ دَائِرِيّ (ذو شكل دائري مسطّح كالقرص)",
 "dislikable": "مُسْتَكْرَه (من شأنه أن يثير النفور)",
 "dislike": "كَرِهَ (لم يُحِبّ، لم يَسْتطِع تحمُّلَ شَخْص أو أمرٍ، لم يُطِقْه، مقَته وكان عنده نُفورٌ منه؛ كره الشّخص فعل السّوء)\nمثال: هتلر كره اليهود.",
 "disliked": "مكروه (يُنظر إليه بنفور)\nمثال: كان مكروهاً بشدة",
 "dislocated": "مَخْلُوع, مَفْصُول (منفصل عند المفصل؛ متخلّع)",
 "dislocation": "اِنْخِلَاع, خَلْع",
 "dislodgement": "زحزحة, طرد (الإزالة القسرية من موقع متميز)",
 "dislodgment": "زحزحة, طرد (الإزالة القسرية من موقع متميز)",
 "dislogistic": "تَحْقِيرِيّ, ذَمِّيّ (يُعَبِّر عن الاستهجان أو الرفض)",
 "disloyal": "خائن, غير موالٍ (يتخلى عن ولائه أو واجبه تجاه قائد أو قضية أو مبدأ) / خائن, غير وطني (يظهر عدم حب لوطنه)\nمثال: كشف مساعدون غير موالين عن طيشه للصحف",
 "disloyally": "بِخِيَانَة, دُونَ وَلَاء (بدون ولاء؛ بطريقة خائنة)\nمثال: تصرف رجاله بخيانة وخانوه في النهاية",
 "disloyalty": "خِيَانَة, عَدَم وَلَاء (صفة كون الشخص غير موالٍ)",
 "dismal": "قَاتِم, كَئِيب (يبعث على الحزن والكآبة)",
 "dismally": "بِبُؤْس, بِشَكْل ذَرِيع (بطريقة مريعة) / بِغَمّ, بِكَآبَة (بطريقة كئيبة)\nمثال: في أغسطس 1914، كان هناك عشاء عاطفي بكآبة، عندما شرب الأعضاء الفرنسيون والألمان والنمساويون والبلجيكيون في اللجنة معاً نخب سلام المستقبل",
 "dismantled": "مَهْدُوم, مُسَوًّى بِالأَرْض (هُدِمَ وَفُكِّكَ)",
 "dismantlement": "تَفْكِيك",
 "dismantling": "تفكيك (فعل تفكيك شيء ما (كقطعة من الآلات))\nمثال: ناقشت روسيا والولايات المتحدة تفكيك أسلحتهما النووية",
 "dismay": "ذعر, فزع (خوف ناتج عن الوعي بالخطر) / إحباط, تثبيط (شعور اليأس في مواجهة العقبات)",
 "dismayed": "مَصْدُوم, مَهُول (أصابه الخوف أو الهلع أو الذهول)",
 "dismaying": "مُذْهِل, مُفْزِع (يسبب الذعر والفزع)",
 "dismember": "بَتَرَ, فَكَّكَ (بَتَرَهُ بَتْرًا: قطع مستأصِلاً. و- العمل ونحوَه: قطعه قبل أن يُتمُّه، فهو باتِر؛ بَتير بَتَرٌا: انقطع، فهو أبْتَرُ، وهي بَتْراء. (ج) بُتْرٌّ)\nمثال: كان يجب بتر ذراع توم.",
 "dismemberment": "بتر, تقطيع الأوصال (إزالة الأطراف؛ التقطيع إلى أجزاء)",
 "dismiss": "طَرَدَ, أَقَالَ",
 "dismissal": "إِقَالَة",
 "dismissed": "مَفْصُول, مُسَرَّح (فقد وظيفته أو تمّ الاستغناء عنه)",
 "dismissible": "قَابِلٌ لِلصَّرْف, قَابِلٌ لِلْعَزْل (يَخْضَعُ لِإِمْكَانِيَّةِ الإِقَالَةِ أَوِ الصَّرْف)",
 "dismission": "إقالة, تسريح (إنهاء توظيف شخص ما (وتركه حراً للمغادرة)) / إنهاء خدمة, فصل (إشعار رسمي بأنك قد طُردت من وظيفتك)",
 "dismissive": "اِسْتِبْعَادِيّ, صَارِف (يتوقف عن التعامل أو التواصل مع) / اسْتِخْفَافِيّ, رَافِض (يُظهر اللامبالاة أو التجاهل)",
 "dismount": "تَرَجَّل (تَرَجَّلَ: نَزَلَ من مَرْكُوبه؛ تَرَجَّلَت المرأةُ: اسْتَرْجَلَت)",
 "disney": "دِيزْنِي / شَرِكَة وَالْت دِيزْنِي",
 "disneyland": "دِيزْنِي لَانْد",
 "disobedience": "عِصْيَان",
 "disobedient": "عَاصٍ",
 "disobediently": "بِتَمَرُّد, بِعِصْيَان (بطريقة عاصية)\nمثال: مضى قدماً بعصيان وفعل ما حذره مشرفه من فعله",
 "disobey": "عَصَى",
 "disobliging": "غَيْر مُتَعَاوِن (غير متعاون عَمْدًا)",
 "disorder": "اِخْتِلال, اِضْطِراب (الاِخْتِلال : اتّخاذ الخلّ من العصير؛ اختلّ الأمر : وقع فيه الخلل) / اِضْطِرَاب",
 "disordered": "مُبَعْثَر, مُشَوَّش (يفتقر إلى الاستمرارية المنظمة) / غير مرتب, مبعثر (غير مرتب بنظام) / مُبَعْثَر, مُضْطَرِب (أُلقي في حالة من الفوضى أو الارتباك)",
 "disorderliness": "تشوش هندام, شعث (عدم ترتيب (خاصة الملابس والمظهر)) / خشونة, سلوك أهوج (سلوك مشاغب) / اضطراب, فوضى (حالة لا تكون فيها الأشياء في أماكنها المتوقعة)\nمثال: الملفات في فوضى عارمة",
 "disorderly": "غير منضبط, فوضوي (غير منضبط ومشاكس) / عَشْوَائِيّ, فَوْضَوِيّ (غَيْرُ مُنَظَّمٍ تَمَامًا وَغَيْرُ مُتَوَقَّعٍ وَمُرْبِك) / مَقْلُوبٌ رَأْسًا عَلَى عَقِب, مُبَعْثَر (فِي فَوْضَى عَارِمَة)\nمثال: شباب مشاغبون",
 "disorderly behavior": "إقلاق الراحة العامة, سلوك مخل بالنظام العام (أي فعل من أفعال المضايقة أو المقاطعة أو الإعاقة أو الإثارة أو الحرمان من الراحة والهدوء الذي يحق للسكان التمتع به)",
 "disorderly conduct": "إقلاق الراحة العامة, سلوك مخل بالنظام العام (أي فعل من أفعال المضايقة أو المقاطعة أو الإعاقة أو الإثارة أو الحرمان من الراحة والهدوء الذي يحق للسكان التمتع به)",
 "disorganisation": "عدم تنظيم, فوضى (اضطراب الترتيب المنهجي مما يسبب الفوضى والارتباك) / اختلال النظام, تفكك (حالة تعطل فيها نظام منظم)\nمثال: فوضى قوات العدو بسبب هجوم جانبي",
 "disorganised": "غير منظم, مشتت (يفتقر للنظام أو الترتيب المنهجي أو الوظيفة)\nمثال: مؤسسة غير منظمة",
 "disorganization": "عدم تنظيم, فوضى (اضطراب الترتيب المنهجي مما يسبب الفوضى والارتباك) / اختلال النظام, تفكك (حالة تعطل فيها نظام منظم)\nمثال: فوضى قوات العدو بسبب هجوم جانبي",
 "disorganized": "غير منظم, مشتت (يفتقر للنظام أو الترتيب المنهجي أو الوظيفة)\nمثال: مؤسسة غير منظمة",
 "disorganized schizophrenia": "فصام غير منتظم, فصام مراهقة (شكل من أشكال الفصام يتميز بتفكك شديد للشخصية، بما في ذلك الكلام المضطرب والتصرفات الطفولية والسلوك الغريب؛ وعادة ما يتضح خلال فترة البلوغ؛ وهو الفئة…)",
 "disorganized type schizophrenia": "فصام غير منتظم, فصام مراهقة (شكل من أشكال الفصام يتميز بتفكك شديد للشخصية، بما في ذلك الكلام المضطرب والتصرفات الطفولية والسلوك الغريب؛ وعادة ما يتضح خلال فترة البلوغ؛ وهو الفئة…)",
 "disorientation": "توهان, ضياع (ارتباك (عادة ما يكون عابراً) حول مكان وجودك وكيفية المضي قدماً؛ عدم اليقين بشأن الاتجاه) / فقدان التوجيه, هذيان (وهم جامح (خاصة الناتج عن عقار مهلوس))\nمثال: كان توهانه نتيجة لعدم الانتباه",
 "disoriented": "مُغْتَرِب, مُنْعَزِل (مُشَوَّش اجتماعياً ومنفصل عن محيطه) / تَائِه, مُشَوَّش (فقد إحساسه بالاتجاه؛ مرتبك بالنسبة للزمان أو المكان أو الهوية)",
 "disorienting": "مربك, مضلل (يسبب فقدان الاتجاهات المادية أو الفكرية)\nمثال: القيام بالعديد من الانعطافات لليمين ثم اليسار كان مربكاً تماماً",
 "disown": "تَبَرَّأَ, تَبَرَّأَ مِنْ",
 "disowning": "تبرؤ (رفض الاعتراف بالشيء كملك للشخص)",
 "disownment": "تبرؤ (رفض الاعتراف بالشيء كملك للشخص)",
 "disparagement": "استخفاف, انتقاص (فعل التحدث بازدراء عن شيء أو شخص) / اسْتِخْفَاف, انْتِقَاص (تواصل يقلل من شأن شخص أو شيء ما)",
 "disparager": "ذام, مستخف (من يستخف أو يقلل من قيمة شيء ما)",
 "disparaging": "ازْدِرَائِيّ, انْتِقَاصِيّ (يُعَبِّر عن رأي مُتَدَنٍّ)",
 "disparagingly": "بِازْدِرَاء, بِاسْتِخْفَاف (بطريقة مستخفة)\nمثال: توصف هذه الشخصيات الأسطورية باستخفاف بأنها تنتمي 'فقط لقصة'",
 "disparate": "مُتَبَايِن, مُتَفَاوِت (يشتمل على عناصر مختلفة اختلافاً بيِّناً) / مُتَبَايِنٌ جَوْهَرِيًّا, مُتَفَاوِت (مختلف جوهريًّا في النوع أو الطبيعة)",
 "disparateness": "تَبَايُن تَامّ, تَمَايُز (عدم التشابه المطلق)",
 "disparity": "تَبَايُن, تَفَاوُت (عدم المساواة أو الاختلاف في جانب ما)",
 "dispassion": "تجرد, عدم تحيز (الموضوعية والانفصال عن الهوى)\nمثال: اتخذ أسلوبها تجرداً وجفافاً مختلفاً جداً عن نبرتها المعتادة",
 "dispassionate": "مَوْضُوعِيّ, هَادِئُ الحُكْم (غَيْرُ مُتَأَثِّرٍ بِالعَاطِفَةِ القَوِيَّةِ أَوِ التَّحَيُّز)",
 "dispassionately": "بِتَجَرُّد, بِمَوْضُوعِيَّة (بطريقة محايدة وغير منفعلة)\nمثال: على الرغم من أنه كان ينظر إلى الفتاة الأخرى، إلا أنه فعل ذلك بتجرد",
 "dispassionateness": "تجرد, عدم تحيز (الموضوعية والانفصال عن الهوى)\nمثال: اتخذ أسلوبها تجرداً وجفافاً مختلفاً جداً عن نبرتها المعتادة",
 "dispatch": "إرسال, إيفاد (فعل إرسال شيء ما) / إجهاز, قتل (قتل شخص أو حيوان (بسرعة)) / سرعة الإنجاز, كفاءة (خاصية كونه سريعاً وفعالاً) / برقية, بلاغ (تقرير رسمي (يرسل عادة على عجل))\nمثال: تم إنجازه بسرعة وكفاءة",
 "dispatch box": "حقيبة مراسلات (حقيبة تتكون من حاوية مستطيلة (عادة ما يكون لها قفل) لحمل الرسائل أو الأشياء الثمينة الأخرى)",
 "dispatch case": "حقيبة مراسلات (حقيبة تتكون من حاوية مستطيلة (عادة ما يكون لها قفل) لحمل الرسائل أو الأشياء الثمينة الأخرى)",
 "dispatch rider": "ساعي بريد عسكري (رسول يحمل برقيات عسكرية (عادة على دراجة نارية))",
 "dispatcher": "مرسل, منظم حركة (موظف في شركة نقل يتحكم في مغادرة المركبات وفقاً للظروف الجوية ومن أجل كفاءة الخدمة) / مُطلِق إشارة البدء (المسؤول الذي يعطي إشارة بدء سباق أو منافسة)",
 "dispel": "بَدَّدَ, أَزَالَ ((بَدَّدَ) الشَّيْءَ: فرّقه)",
 "dispensability": "إمكانية الاستغناء (الخاصية التي يمتلكها شيء يمكنك تدبر أمرك بدونه)",
 "dispensable": "يمكن الاستغناء عنه (يمكن الاستغناء عنه أو العمل بدونه)\nمثال: عناصر من الممتلكات الشخصية يمكن الاستغناء عنها",
 "dispensableness": "إمكانية الاستغناء (الخاصية التي يمتلكها شيء يمكنك تدبر أمرك بدونه)",
 "dispensary": "مستوصف (عيادة يتم فيها صرف الأدوية والمستلزمات الطبية)",
 "dispensation": "تَحِلَّة",
 "dispensed": "مَصْرُوف, مُوَزَّعٌ بِدِقَّةٍ (مُوَزَّعٌ أَوْ مَوْزُونٌ بِحِصَصٍ مُحَدَّدَةٍ بِعِنَايَةٍ)",
 "dispenser": "موزع (حاوية مصممة بحيث يمكن استخدام المحتويات بكميات محددة) / صارف, موزّع (شخص يقوم بالتوزيع أو الصرف)",
 "dispersal": "تشتت, نثر (عملية تشتيت أو نشر شيء ما)\nمثال: تشتت القوات",
 "dispersed": "مُتَفَرِّق, مُنْتَشِر (مُوَزَّعٌ أَوْ مُمْتَدٌّ عَلَى رُقْعَةٍ جُغْرَافِيَّةٍ وَاسِعَةٍ)",
 "dispersed particles": "جسيمات مشتتة, طور مشتت ((في الغرويات) مادة في الحالة الغروية)",
 "dispersed phase": "جسيمات مشتتة, طور مشتت ((في الغرويات) مادة في الحالة الغروية)",
 "dispersing medium": "طور مشتِّت, وسط التشتت ((في الغرويات) مادة يتم فيها تشتيت مادة أخرى غروياً)",
 "dispersing phase": "طور مشتِّت, وسط التشتت ((في الغرويات) مادة يتم فيها تشتيت مادة أخرى غروياً)",
 "dispersion": "تَشَتُّت",
 "dispersion medium": "طور مشتِّت, وسط التشتت ((في الغرويات) مادة يتم فيها تشتيت مادة أخرى غروياً)",
 "dispersive": "مُتَبَدِّد, مُنْتَشِر (ينتشر عن طريق الانتشار التدريجي)",
 "dispirited": "كَئِيب, مُكْتَئِب (مَمْلُوءٌ بِالكَآبَةِ وَالقُنُوط) / فَاتِرُ الهِمَّة, مُحْبَط (يتّسم بانخفاض المعنويّات وانعدام الحماس)",
 "dispiritedly": "بِإِحْبَاط, بِفُتُور (بطريقة محبطة وبلا أمل)\nمثال: أول أوبرا لموتزارت خضعت لهذه المعالجة الغريبة عُرضت بفتور لخمسة عروض",
 "dispiritedness": "تثبيط, هبوط المعنويات (شعور بانخفاض المعنويات)\nمثال: شعر بالمسؤولية عن انخفاض معنوياتها",
 "dispiriting": "مُحَطِّمٌ لِلرُّوحِ المَعْنَوِيَّة (مدمّر للروح المعنوية والاعتماد على النفس)",
 "displaced fracture": "كسر مزاح (كسر ينفصل فيه طرفا العظم المكسور عن بعضهما البعض)",
 "displaced person": "شخص بلا جنسية, نازح (شخص أجبر على الفرار من منزله أو بلده)",
 "displacement": "إِزَاحَة, نُزُوح / إِزَاحَة",
 "displacement reaction": "إحلال, تفاعل إحلال ((في الكيمياء) تفاعل تحل فيه مادة أولية محل عنصر أساسي وتطرده من المركب)",
 "displacement unit": "وحدة حجم, وحدة سعة (وحدة لقياس الحجم أو السعة)",
 "display": "إِظْهَار, عَرْض / شَاشَة",
 "display adapter": "محول عرض ((علم الحاسوب) جهاز إلكتروني يحول المعلومات في الذاكرة إلى إخراج فيديو لشاشة عرض)",
 "display adaptor": "محول عرض ((علم الحاسوب) جهاز إلكتروني يحول المعلومات في الذاكرة إلى إخراج فيديو لشاشة عرض)",
 "display board": "لوحة عرض (سطح عمودي يمكن عرض المعلومات عليه للجمهور)",
 "display case": "خزانة عرض, فاترينة (حاوية زجاجية تستخدم لتخزين وعرض العناصر في متجر أو متحف أو منزل)",
 "display panel": "لوحة عرض (سطح عمودي يمكن عرض المعلومات عليه للجمهور)",
 "display window": "شُبَّاك, فَاتْرِينَة",
 "displaying incompetence": "بشكل غير كفء (بطريقة تفتقر للكفاءة)\nمثال: أنجز العمل بشكل غير كفء إلى حد ما",
 "displeased": "غير راض, مستاء (غير مسرور؛ يختبر أو يظهر الاستياء)",
 "displeasing": "غير سار, مزعج (يسبب الاستياء أو يفتقر للصفات السارة)\nمثال: أخبار غير سارة",
 "displeasingly": "بِشَكْل غَيْر سَارّ, بِشَكْل مُزْعِج (بطريقة مزعجة)\nمثال: أدلى بملاحظات قاطعة بشكل مزعج حول أصدقائه",
 "displeasure": "استياء, عدم رضا (الشعور بعدم الرضا أو الانزعاج من شخص أو شيء ما)",
 "disposable": "قابل للتخلص منه, يستخدم لمرة واحدة (مصمم ليتم التخلص منه بعد الاستخدام) / تحت اليد, قابل للتصرف فيه (حر أو متاح للاستخدام أو التصرف) / مُسْتَهْلَك, مُنْتَج للاسْتِعْمَالِ لِمَرَّةٍ وَاحِدَة (عنصر يمكن التخلص منه بعد استخدامه)\nمثال: أكواب ورقية تستخدم لمرة واحدة",
 "disposable income": "دخل قابل للإنفاق, دخل متاح (الدخل (بعد الضرائب) المتاح لك للادخار أو الإنفاق)",
 "disposable razor": "شَفْرَة حِلَاقَة لِٱسْتِعْمَال وَاحِد",
 "disposal": "تخلص, تصريف (فعل أو وسيلة التخلص من شيء ما) / إدارة, تصريف أمور (طريقة لرعاية أو إدارة شؤون مجموعة من الناس (خاصة الشؤون التجارية للمجموعة)) / طاحنة نفايات, فرامة مخلفات (جهاز مطبخ للتخلص من مخلفات الطعام) / تصرف (القدرة على استخدام شيء أو شخص (تحت التصرف))\nمثال: استخدم كل الموارد المتاحة تحت تصرفه",
 "disposal plant": "محطة معالجة مياه الصرف الصحي (منشأة للتخلص من مياه الصرف الصحي)",
 "disposition": "تخلص, تصريف (فعل أو وسيلة التخلص من شيء ما) / طبع, مزاج (الحالة المزاجية المعتادة) / استعداد, ميل (عادة طبيعية أو مكتسبة أو ميل مميز في شخص أو شيء) / استعداد, ميل (موقف ذهني يميل لتفضيل بديل على آخر)\nمثال: لديه مزاج سعيد",
 "dispossessed": "بِلَا مَأْوَى, مُشَرَّد (مَحْرُومٌ مِنَ المَسْكَنِ أَوِ الأَمَانِ مَادِّيًّا أَوْ مَعْنَوِيًّا)",
 "dispossession": "إخلاء, طرد (طرد شخص ما (مثل مستأجر) من حيازة أرض بموجب إجراء قانوني) / تخليص من الأرواح, طرد الأرواح (التخليص من الأرواح الشريرة)",
 "dispraise": "استخفاف, انتقاص (فعل التحدث بازدراء عن شيء أو شخص)",
 "disproof": "تفنيد, تكذيب (فعل تحديد أن شيئاً ما زائف) / تفنيد, دحض (أي دليل يساعد على إثبات زيف شيء ما)",
 "disproportion": "اخْتِلَال التَّوَازُن, عَدَم تَنَاسُب (افتقار للتناسب؛ عدم توازن بين أجزاء الشيء)",
 "disproportional": "غير متناسب, متفاوت (خارج عن التناسب أو التوافق)",
 "disproportionate": "غَيْر مُتَنَاسِب (غير متوازن أو متناسب) / غير متناسب, متفاوت (خارج عن التناسب أو التوافق)",
 "disproportionately": "بِتَفَاوُت, بِشَكْل غَيْر مُتَنَاسِب (لدرجة غير متناسبة) / بِشَكْل غَيْر مُتَنَاسِق, بِشَكْل مُتَفَاوِت (بطريقة تفتقر إلى التناسب)\nمثال: كانت فوائده سخية بشكل غير متناسب",
 "disprove": "دَحَضَ (أبطلَ الحُجّة أو دفعها بالحُجّة المضادة؛ زلَّ أو انزلق)",
 "disprover": "مُدْحِض, مُفَنِّد (مناظر يدحض أو يفند من خلال تقديم أدلة أو حجج معاكسة)",
 "disputable": "قَابِلٌ لِلدَّحْض, قَابِلٌ لِلنَّقْض (يُمْكِنُ دَحْضُهُ أَوْ إِثْبَاتُ بُطْلَانِهِ) / خِلَافِيّ, قَابِلٌ لِلنِّقَاش (مَفْتُوحٌ لِلنِّقَاشِ أَوِ الجَدَل)",
 "disputant": "مُجادِل, مُخاصِم (شخص يجادل؛ شخص يجيد أو يستمتع بالجدل)",
 "disputation": "جدل, سجال (فعل كلامي جدلي؛ نزاع حيث يوجد اختلاف قوي في الرأي) / جدل عام, مناظرة (التقديم الرسمي لاقتراح معلن والمعارضة له (يتبعه عادة تصويت))\nمثال: انخرطوا في جدال عنيف",
 "disputatious": "عِدَائِيّ, مُتَخَاصِم (يَمِيلُ إِلَى النِّزَاعِ أَوِ الاخْتِلَافِ، حَتَّى إِلَى رَفْعِ الدَّعَاوَى)",
 "disputatiously": "بِشَكْل جَدَلِيّ, بِمُشَاكَسَة (بطريقة جدلية)",
 "disputative": "عِدَائِيّ, مُتَخَاصِم (يَمِيلُ إِلَى النِّزَاعِ أَوِ الاخْتِلَافِ، حَتَّى إِلَى رَفْعِ الدَّعَاوَى)",
 "dispute": "نِزَاع, شِجَار (حالة المريض المشرف على الموت؛ خُصُومَة بين أفراد أو جماعات قد تقتصر على تبادل الشتائم وقد تمتدّ إلى التماسك بالأيدي أو استخدام أداة ما في المشاجرة أو تُفضي إلى الحرب بين الدول)\nمثال: شمال مالي منطقة نزاع.",
 "disputed": "مَحَلُّ خِلَاف, مُتَنَازَعٌ عَلَيْه (مَوْضِعُ خِلَافٍ وَنِقَاش)",
 "disputed state": "دولة غير معترف بها, دولة محدودة الاعتراف (إقليم يتمتع بسيادة فعلية ولكنه يفتقر إلى الاعتراف الدولي)",
 "disqualification": "إِقْصَاء",
 "disqualified": "غَيْرُ مُؤَهَّل, مَحْرُوم (فاقد الأهلية بموجب القانون أو اللائحة أو الحكم) / مَوْقُوف, مُسْتَبْعَد (ممنوع من المنافسة بسبب مخالفة القواعد)",
 "disqualifying": "مُبطل للأهلية, مُعجِز (الحرمان من الحق القانوني؛ جعل الشخص غير مؤهل قانونياً)\nمثال: بعض القيود المبطلة للأهلية حرمته من الجنسية",
 "disquiet": "عدم ارتياح, قلق (سمة عدم الارتياح) / عدم ارتياح, قلق (شعور بقلق خفيف بشأن التطورات المحتملة)",
 "disquieted": "قَلِق, مَكْرُوب (مصاب بقلق مضطرب أو متاعب أو حزن أو يتسم به)",
 "disquieting": "مُثِير لِلْقَلَق, مُقْلِق (يسبب عدم الراحة الذهنية)",
 "disquietingly": "بِإِزْعَاج, بِشَكْل مُقْلِق (بطريقة مقلقة)\nمثال: أصوات إطلاق النار القريبة بشكل مقلق",
 "disquietude": "توتر, قلق (مشاعر القلق التي تجعلك متوتراً وسريع الانفعال)",
 "disquisition": "بحث مطول (مقالة أو مناقشة تحليلية أو توضيحية مفصلة)",
 "disregard": "إِهْمال",
 "disregarded": "مَنْسِيّ, مُتَجَاهَل (لم يُلاحَظ عن غير قصد)",
 "disregarding": "بصرف النظر, بغض النظر (على الرغم من كل شيء؛ دون اعتبار للعوائق)\nمثال: واصل العمل بغض النظر عن الصعوبات",
 "disregardless": "بصرف النظر, بغض النظر (على الرغم من كل شيء؛ دون اعتبار للعوائق)\nمثال: واصل العمل بغض النظر عن الصعوبات",
 "disrepair": "تهالك, حاجة للإصلاح (في حاجة إلى إصلاحات)",
 "disreputability": "سوء السمعة, قلة الاحترام (الخزي بحكم الافتقار إلى الاحترام أو السمعة الطيبة)",
 "disreputable": "سيء السمعة (يفتقر للاحترام في الشخصية أو السلوك أو المظهر)",
 "disreputable person": "سيء السمعة (شخص يفتقر إلى التقدير العام والاحترام)",
 "disreputableness": "سوء السمعة, قلة الاحترام (الخزي بحكم الافتقار إلى الاحترام أو السمعة الطيبة)",
 "disreputably": "بِسُمْعَة سَيِّئَة, بِشَكْل مُشِين (بطريقة مشينة)",
 "disrepute": "سوء سمعة (حالة كونه موضع تقدير منخفض)\nمثال: ستجلب أفعالك العار لاسمك",
 "disrespect": "عدم احترام (الفقدان ونقيض الوجود؛ يجب عدم فعل كذا: أي يجب الامتناع عن الفعل)\nمثال: عليك عدم الخوف.",
 "disrespectful": "قليل الاحترام, وقح (يظهر قلة احترام؛ وقح وغير مهذب) / عَدِيمُ الاِحْتِرَام (لا يشعر ولا يُظهِر الاحترام)\nمثال: ملاحظات غير محترمة للقانون",
 "disrespectfully": "بِقِلَّة احْتِرَام, بِوَقَاحَة (بطريقة غير محترمة)\nمثال: يعامل والديه بقلة احترام",
 "disrupted": "مُتَصَدِّع, مُعَطَّل (يَتَّسِمُ بِفَجَوَاتٍ أَوِ انْقِطَاعَات)",
 "disrupting explosive": "متفجرات شديدة الانفجار, متفجرات مدمرة (مادة شديدة الانفجار تستخدم لتدمير الهدف الذي يتم مهاجمته)",
 "disruption": "انقطاع, توقف (فعل تأخير أو قطع الاستمرارية) / اضطراب, تعطيل (فعل التسبب في الفوضى) / اضطراب, تعطيل (حدث يؤدي إلى إزاحة أو انقطاع) / اضطراب, قلاقل (ثوران أو صخب غير منظم)\nمثال: تم عرضه بدون فواصل إعلانية",
 "disruptive": "عَاصِف, مُضْطَرِب (يتّسم بالفوضى أو الاضطراب أو التمرّد)",
 "disruptively": "بشكل تخريبي, بشكل معطل (بطريقة تخريبية)",
 "dissatisfaction": "استياء, عدم رضا (الشعور بعدم الرضا والسخط)\nمثال: لم يكن يتردد أبداً في التعبير عن عدم رضاه عن الخدمة التي تلقاها",
 "dissatisfactory": "غَيْرُ مُرْضٍ, مُخَيِّبٌ لِلآمَال (لا يرقى إلى مستوى التوقّعات)",
 "dissatisfied": "مُسْتَاء, سَاخِط",
 "dissected": "مَشْقُوق, مُفَرَّض (ذو شقّ أو أكثر يكاد يصل إلى العرق الأوسط)",
 "dissection": "تبضيع, تشريح (القطع بغرض الفصل إلى قطع) / تحليل نقدي دقيق, تشريح (تحليل نقدي مفصل أو فحص جزء تلو الآخر (كما في العمل الأدبي)) / تحليل دقيق, تشريح (تحليل دقيق ونقدي)",
 "dissembler": "مراءٍ, منافق (شخص يصرح بمعتقدات وآراء لا يحملها من أجل إخفاء مشاعره أو دوافعه الحقيقية)",
 "dissembling": "تدليس, تمويه (فعل الخداع) / ادعاء, تصنع (التظاهر بنية الخداع)",
 "disseminated intravascular coagulation": "تخثر منتشر داخل الأوعية",
 "disseminated lupus erythematosus": "الذئبة الحمامية المجموعية, الذئبة الحمراء (مرض التهابي يصيب النسيج الضام وله سمات متغيرة تشمل الحمى والضعف وسهولة التعب وآلام المفاصل وآفات جلدية على الوجه أو الرقبة أو الذراعين)",
 "disseminated multiple sclerosis": "تصلب متعدد (اضطراب عصبي تدريجي مزمن ينطوي على فقدان غمد المايلين حول ألياف عصبية معينة)",
 "disseminated sclerosis": "تصلب متعدد (اضطراب عصبي تدريجي مزمن ينطوي على فقدان غمد المايلين حول ألياف عصبية معينة)",
 "dissemination": "نَشْر, بَثّ (بَسَطَ، فَرَّقَ، نَشَرَ الشيءَ: جعله منتشراً، مثل نشر الأخبار أو نشر كتاب؛ نَشَرَ: وزع أو عمم شيئًا بين الناس، مثل نشر المقالات)\nمثال: نشر توم الغسيل.",
 "disseminative": "مُتَبَدِّد, مُنْتَشِر (ينتشر عن طريق الانتشار التدريجي)",
 "disseminator": "مذيع, ناشر (شخص ينشر الأخبار)",
 "dissension": "تنافر, شقاق (خلاف بين أولئك المتوقع منهم التعاون) / تنافر, خلاف (صراع في آراء الناس أو أفعالهم أو طباعهم)",
 "dissent": "اِحْتِجَاج, اِعْتِرَاض (فعل الاحتجاج؛ تعبير عام (غالباً ما يكون منظماً) عن المعارضة) / مخالفة في الرأي, معارضة (اختلاف في الرأي) / رأي مخالف ((قانون) اختلاف رأي أحد القضاة عن رأي الأغلبية)\nمثال: عبر عن معارضته في رأي مخالف",
 "dissenter": "محتج, معارض (شخص يعارض سياسة راسخة)",
 "dissentient": "مُخَالِف, مُعَارِض (غير موافق، وخاصة مع الأغلبية) / رَافِض, مُعَارِض ((في الكاثوليكية) يرفض حضور خدمات كنيسة إنجلترا)",
 "dissenting opinion": "رأي مخالف (رأي يختلف مع تصرف المحكمة في القضية)",
 "dissentious": "انْشِقَاقِيّ, مُثِيرٌ لِلفُرْقَةِ (مُعَارِضٌ (خَاصَّةً لِرَأْيِ الأَغْلَبِيَّةِ)؛ يُحْدِثُ الِانْقِسَامَ)",
 "dissertation": "أطروحة, رسالة جامعية (بحث يقدم وجهة نظر جديدة ناتجة عن البحث؛ عادة ما يكون متطلباً لدرجة أكاديمية متقدمة)",
 "disservice": "إساءة, خدمة سيئة (فعل يُقصد به المساعدة ولكن نتائجه تكون سيئة)\nمثال: لقد أساء إليهم",
 "dissidence": "انشقاق, معارضة (خلاف؛ وخاصة الخلاف مع الحكومة)",
 "dissident": "مُنْشَقّ",
 "dissilience": "انتشار البذور, انفلاق (ظهور البذور عند انفتاح قرون البذور عندما تنضج)",
 "dissilient": "مُنْفَتِح بِقُوَّة (ينفجر مُنفتحًا بقوّة، كبعض أوعية البذور الناضجة)",
 "dissimilar": "غير متشابه, متباين (غير متشابه أو مماثل) / غير مشابه, متباين (غير مشابه)\nمثال: مختلفان بقدر ما يمكن لشخصين أن يكونا",
 "dissimilarity": "تَبَايُن, عَدَم تَشَابُه (صفة عدم التشابه)",
 "dissimilation": "أيض هدمي, هدم (تحلل المواد الأكثر تعقيدًا في الكائنات الحية إلى مواد أبسط مع إطلاق الطاقة) / مخالفة (عملية لغوية يصبح فيها أحد الصوتين المتشابهين في الكلمة أقل شبهاً بالآخر)",
 "dissimilitude": "اخْتِلَاف, عَدَم تَمَاثُل (عدم التشابه المثبت بغياب الشبه)",
 "dissimulation": "تدليس, تمويه (فعل الخداع)",
 "dissimulative": "مُتَظَاهِر, مُمَوِّه (يُخْفِي حَقِيقَتَه تَحْتَ مَظْهَر زَائِف بِقَصْد الخِدَاع)",
 "dissimulator": "مراءٍ, منافق (شخص يصرح بمعتقدات وآراء لا يحملها من أجل إخفاء مشاعره أو دوافعه الحقيقية)",
 "dissipated": "مُقَامِر, مُنْغَمِس فِي اللَّهْو (منشغل بالسعي وراء المُتعة وخاصّة ألعاب الحظّ) / فَاسِق, مُسْتَهْتِر (مُتَحَرِّرٌ مِنَ القُيُودِ الأَخْلَاقِيَّةِ وَالأَعْرَاف)",
 "dissipation": "إسراف, تبديد (نشاط غير مجدٍ أو غير مربح؛ استخدام أو إنفاق أو استهلاك بلا تفكير أو بإهمال) / انحلال, فجور (انغماس منحل في الملذات الحسية) / تبدد, تلاشي (التفكك والتشتت عن طريق التفرق)\nمثال: إذا لم يحقق الجهد أي مكسب تعويضي فهو هدر",
 "dissociable": "قَابِل لِلتَّجْزِئَة, قَابِل لِلفَصْل (يُمْكِن تَقْسِيمُه أَوْ فَصْلُه)",
 "dissociation": "فك الارتباط, نأى (عملية الإزالة من الارتباط أو الشراكة) / تفكك ((في الكيمياء) العملية المؤقتة أو القابلة للعكس التي يتحلل فيها الجزيء أو الأيون إلى جزيئات أو أيونات أصغر) / انشقاق, تفكك (حالة ينفصل فيها جزء متكامل من حياة الشخص عن بقية الشخصية ويعمل بشكل مستقل)",
 "dissociation constant": "ثَابِت التَّفَكُّك (ثابت التوازن لتفكك عكسي)",
 "dissociation energy": "طاقة التفكك (الطاقة اللازمة لكسر كل رابطة كيميائية في جزيء وفصل جميع ذراته تماماً)",
 "dissociative": "اِنْفِصَالِيّ, تَفَكُّكِيّ (يَمِيل إِلَى إِحْدَاث التَّفَكُّك)",
 "dissociative disorder": "اضطراب انشقاقي, اضطراب تفارقي (انفصال شديد لدرجة تنهار معه الوظائف المتكاملة عادة للوعي وإدراك الذات)",
 "dissolubility": "انحلالية, قابلية الذوبان (خاصية القابلية للانحلال)\nمثال: قاس قابلية ذوبان السكر في الماء",
 "dissoluble": "قَابِلٌ لِلذَّوَبَان (يمكن إذابته وحلّه)",
 "dissolute": "فَاسِق, مُسْتَهْتِر (مُتَحَرِّرٌ مِنَ القُيُودِ الأَخْلَاقِيَّةِ وَالأَعْرَاف)",
 "dissolutely": "بإسراف, بفجور (بطريقة منحلة)",
 "dissoluteness": "تحلل, خلاعة (عدم انضباط فيما يتعلق بالملذات الحسية)",
 "dissolution": "انحلال, انفصال (إنهاء أو تفكك علاقة (بين أشخاص أو دول)) / رفع الجلسة, فض الاجتماع (إنهاء اجتماع) / انحلال, فجور (انغماس منحل في الملذات الحسية) / انحلال, تفكك (الانفصال إلى أجزاء مكونة)",
 "dissolution of marriage": "حل الرابطة الزوجية, فسخ الزواج (إبطال أو إنهاء الزواج)",
 "dissolvable": "قَابِلٌ لِلذَّوَبَان (يمكن إذابته وحلّه)",
 "dissolve": "تلاشي تدريجي, مزج ((في الفيلم) انتقال تدريجي من مشهد إلى التالي؛ يتم تركيب المشهد التالي تدريجياً بينما يتلاشى المشهد السابق)",
 "dissolved": "مُذَاب, مُنْحَلّ ((لِلْمَادَّةِ الصُّلْبَة) تَحَوَّلَ إِلَى شَكْلٍ سَائِل)",
 "dissolvent": "مذيب, مُحِل (مادة سائلة قادرة على إذابة مواد أخرى)\nمثال: المذيب لا يغير حالته عند تكوين محلول",
 "dissolver": "مذيب, مُحِل (مادة سائلة قادرة على إذابة مواد أخرى)\nمثال: المذيب لا يغير حالته عند تكوين محلول",
 "dissolving": "إذابة, ذوبان (عملية التحول إلى محلول)\nمثال: إذابة الملح في الماء",
 "dissolving agent": "مذيب, مُحِل (مادة سائلة قادرة على إذابة مواد أخرى)\nمثال: المذيب لا يغير حالته عند تكوين محلول",
 "dissonance": "تنافر, نشاز (أصوات غير متوافقة أو مزعجة) / ضجيج, ضوضاء (التجربة السمعية لصوت يفتقر إلى الجودة الموسيقية؛ صوت يمثل تجربة سمعية مزعجة) / تنافر, خلاف (صراع في آراء الناس أو أفعالهم أو طباعهم)\nمثال: الموسيقى الحديثة مجرد ضجيج بالنسبة لي",
 "dissonant": "مُتَبَايِن, مُتَنَافِر (لَيْسَ فِي وِفَاقٍ أَوِ انْسِجَامٍ) / مُتَنافِر, نَشاز (غَيْر مُنْسَجِم صَوْتِيًّا؛ ذو أصْوات مُتَضارِبَة) / غَيْر مَحْلول, مُعَلَّق ((في المُوسيقى) لَمْ يُحَلّ إلى تَوافُق؛ يَظَلّ مُتَنافِرًا)",
 "dissuasion": "إقناع بالعدول, ثني (الإقناع بعدم القيام بشيء أو عدم تصديقه؛ إقناع شخص بالعدول عن معتقد أو مسار عمل مقصود) / إِثْنَاء, نُصْح بِالْعُدُول (تواصل يثنيك عن فعل شيء)",
 "dissuasive": "رادع, مثبط (يثني عن العمل)\nمثال: نصيحة مثبطة",
 "dissyllable": "كلمة ثنائية المقطع (كلمة تحتوي على مقطعين صوتيين)",
 "dissymmetry": "اخْتِلَال التَّوَازُن, عَدَم تَنَاسُب (افتقار للتناسب؛ عدم توازن بين أجزاء الشيء)",
 "distaff": "عَرْنَاس, رُكَّة",
 "distal": "بعيد, قاصٍ (يقع في أبعد نقطة من نقطة الاتصال أو المنشأ، كما في طرف أو عظم) / بعيد عن الوسط, وحشي (موجه بعيداً عن خط الوسط أو المستوى الإنسي للجسم)",
 "distal muscular dystrophy": "حثل عضلي قاصي (شكل من أشكال الحثل العضلي يبدأ بين سن 40 و 60 عاماً ويتميز بضعف وهزال عضلات اليدين والساعدين والساقين السفلية؛ وراثته سائدة)",
 "distally": "بعيداً, قاصياً (بعيداً عن المركز (تشريحياً))\nمثال: تقع القصبة الهوائية بعيداً",
 "distance": "بُعْد (يدل على اللحاق في الزمان؛ يكون مضافا، وينصب أو يجر) / مَسَافَة / بَعَّدَ (يدل على اللحاق في الزمان؛ يكون مضافا، وينصب أو يجر)\nمثال: و بعد قليل أتى.",
 "distance vision": "رؤية عن بعد (رؤية الأشياء التي تبعد 20 قدمًا أو أكثر عن المشاهد)",
 "distant": "بَعِيد (ضد القَرِيب، الذي يفصل بينك وبينه مسافة أو زمان)\nمثال: إنها بعيدة جدا.",
 "distantly": "عَنْ بُعْد, مِن بَعِيد (من أو على مسافة)\nمثال: بشكل خافت، ومن بعيد، دوت أصوات في السكون",
 "distaste": "كراهية, نفور (شعور بالكراهية الشديدة)",
 "distasteful": "مُثِير لِلاشْمِئْزَاز, مُقْرِف (بالغ الكراهة؛ يثير النفور والاشمئزاز) / غَيْرُ مُسْتَسَاغ, كَرِيهُ الطَّعْم (غَيْرُ مُسْتَحَبٍّ فِي الرَّائِحَةِ أَوِ الطَّعْم)",
 "distastefully": "بِشَكْل مُثِير لِلاشْمِئْزَاز, بِشَكْل مُقَزِّز (بطريقة مقززة أو لدرجة مقززة) / بِشَكْل كَرِيه, بِشَكْل مُنَفِّر (بطريقة كريهة ومسيئة)\nمثال: كان المتسول قذراً بشكل مقزز",
 "distastefulness": "إِسَاءَة, بَشَاعَة (صفة كون الشيء مسيئاً أو كريهاً) / إثارة للاشمئزاز, قرف (عدم استساغة شديدة للفم)",
 "distemper": "تمبرا, رسم غراوي (طريقة للرسم تخلط فيها الأصباغ بالماء ومادة رابطة؛ تستخدم لرسم الملصقات أو الجداريات أو مناظر المسرح) / ديستمبر, صباغة غروية (لوحة تم إنشاؤها بطلاء مصنوع عن طريق خلط الأصباغ بالماء ومادة رابطة) / ديستمبر, طلاء غروي (طلاء يصنع بخلط الأصباغ مع الماء ومادة رابطة) / تعكر مزاج, مزاج سيء (مزاج غاضب وغير مقبول)",
 "distended": "مُتَوَرِّم, مُنْتَفِخ (مُتَمَدِّد بِشَكْل غَيْر طَبيعِيّ بِسَبَب السَّوائِل أو الغاز)",
 "distensible": "قَابِل لِلانْتِفَاخ, قَابِل لِلتَّمَدُّد (يمكن أن ينتفخ ويتمدد ويتوسع)",
 "distension": "نَفْخ, اِنْتِفَاخ (أَطْلَقَ الريح من فمه؛ زَفَرَ أو هَبَّ بشدة)\nمثال: يداك أوكتا وفوك نفخ",
 "distention": "انتفاخ, تَمَدُّد (عملية التوسع عن طريق الضغط من الداخل) / تمدد, توسع (حالة التمدد إلى ما وراء الأبعاد الطبيعية)",
 "distich": "ثُنَائِيّ, زَوْج (عنصران من نفس النوع)",
 "distil": "طهر, قطر (أزال الشوائب من، زاد التركيز، وفصل من خلال عملية التقطير)\nمثال: نقى الماء",
 "distillate": "مقطر, ناتج التقطير (سائل منقى يتم إنتاجه عن طريق التكثيف من بخار أثناء التقطير)",
 "distillation": "تَقْطِير",
 "distilled water": "ماء مقطر (السائل الشفاف المعروف الذي تنشأ به الحياة، عديم اللون والرائحة والطعم عندما يكون نقيا؛ علميا فِي : جزيئة متكونة من ذرتي هيدروجين مرتبطين بذرة واحدة من الأوكسيجين)\nمثال: أنا أشرب الماء.",
 "distiller": "مقطّر (شخص يقوم بتقطير المشروبات الكحولية)",
 "distillery": "معمل تقطير, مقطرة (مصنع ومنشآت يتم فيها صنع المشروبات الكحولية عن طريق التقطير)",
 "distillment": "تقطير (عملية تنقية سائل عن طريق غليه وتكثيف أبخرته)",
 "distinct": "بَيِّن, حَاسِم (محدّد بوضوح وحدّة في الذهن) / مَلْحُوظ, وَاضِح (يُمْكِنُ تَمْيِيزُهُ؛ بَارِزٌ وَجَلِيّ) / متمايز, مميز (سهل الإدراك؛ خاصة ما هو محدد المعالم بوضوح) / مُتَمَايِز, مُمَيَّز (غير متشابه؛ مختلف في الطبيعة أو النوعيّة)\nمثال: نكهة مميزة",
 "distinction": "تَمْيِيْز",
 "distinctive": "مُمَيَّز, نَمُوذَجِيّ (خاصّ بسمة تساعد في التمييز بين الأشخاص أو الأشياء) / قَابِل لِلتَّصْنِيف (يمكن تصنيفه ضمن فئات)",
 "distinctive feature": "خاصية فارقة, سمة مميزة (خاصية غريبة أو غير عادية)",
 "distinctively": "بشكل مميز (بطريقة مميزة يمكن التعرف عليها)\nمثال: المنطقة المحافظة بشكل مميز في المقاطعة",
 "distinctiveness": "تَبَايُن تَامّ, تَمَايُز (عدم التشابه المطلق) / خاصية, سمة مميزة (سمة مميزة)",
 "distinctly": "بشكل متميز, بوضوح (واضح للعقل؛ بتمييز عقلي واضح) / بِشَكْل وَاضِح, بِوُضُوح (بدرجة متميزة) / بِتَمَيُّز, بِشَكْل مُمَيَّز (بطريقة مميزة وقابلة للتمييز)\nمثال: إنه ممكن بوضوح",
 "distinctness": "تَمَايُز, حِدَّة (صفة كون الشيء حاداً وواضحاً) / انْفِصَال, تَمَايُز (صفة عدم التشابه؛ كون الشيء متميزاً أو مختلفاً عما هو معروف أو مجرب) / انفصال, تمايز (حالة التعدد والتميز)",
 "distinguishability": "قابلية التمييز (القدرة على الإدراك كشيء مختلف أو متميز)\nمثال: في هذا المقال نأخذ في الاعتبار إمكانية التمييز بين المقاطع من خلال التحقيق أولاً في تماثلها البصري بالتفصيل",
 "distinguishable": "قابل للتمييز, متمايز (قادر على أن يُدرك كشيء مختلف أو متميز) / مُتَمَايِز, مُمَيَّز (غير متشابه؛ مختلف في الطبيعة أو النوعيّة)\nمثال: فقط لمعان معدنهم كان يمكن تمييزه في الظلام",
 "distinguished": "مُمَيَّز, مُمْتَاز / أَنِيق",
 "distinguished conduct medal": "ميدالية السلوك المتميز (وسام عسكري بريطاني للسلوك المتميز في الميدان)",
 "distinguished flying cross": "صليب الطيران المتميز (وسام من القوات الجوية الأمريكية للبطولة أثناء المشاركة في رحلة جوية)",
 "distinguished service cross": "صليب الخدمة المتميزة (وسام من الجيش الأمريكي للبطولة الاستثنائية ضد عدو مسلح)",
 "distinguished service medal": "وسام الخدمة المتميزة (وسام عسكري أمريكي للخدمة الجديرة بالتقدير في واجبات الحرب ذات المسؤولية العظيمة)",
 "distinguished service order": "نيشان الخدمة المتميزة (وسام عسكري بريطاني للخدمة الخاصة في المعركة)",
 "distinguishing characteristic": "خاصية فارقة, سمة مميزة (خاصية غريبة أو غير عادية)",
 "distomatosis": "تعفن الكبد (مرض في الكبد (خاصة في الأغنام والماشية) تسببه المثقوبات الكبدية ومنتجاتها الثانوية)",
 "distort": "شَوَّهَ",
 "distortable": "قَابِل لِلتَّشْوِيه (يمكن تحريف معناه أو تشويهه)",
 "distorted": "مُحَرَّف, مُشَوَّه (تم تغيير معناه المقصود أو تشويهه) / مَعِيب الشَّكْل, مُشَوَّه (سيّئ التكوين إلى حدّ القبح)",
 "distorted shape": "تشوه, شكل مشوه (شكل ناتج عن التشوه)",
 "distortion": "تحريف, تشويه (خطأ تحريف الحقائق) / تشويه, لوي الحقائق (فعل تشويه الشيء ليبدو وكأنه يعني شيئاً لم يكن يقصده) / تحريف, تشويه (تغيير للأسوأ) / تشوه, زيغ (ظاهرة بصرية ناتجة عن فشل عدسة أو مرآة في إنتاج صورة جيدة)",
