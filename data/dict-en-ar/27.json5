 "stringybark pine": "صنوبر السرو ذو اللحاء الليفي (صنوبر سرو أسترالي ذو لحاء داخلي ليفي)",
 "strip": "شَرِيط / قِطَاع / خَطّ (كِتَابَة؛ ما يَصِل نقطتين أو أكثر)\nمثال: إرسم خط مستقيم.",
 "strip alert": "تأهب أرضي (حالة استعداد لطائرات الدفاع الداخلي (وهي على الأرض))\nمثال: ستبقي القوات الجوية المقاتلات في حالة تأهب أرضي في القواعد في جميع أنحاء البلاد",
 "strip cropping": "زراعة شريطية (زراعة المحاصيل في شرائط تتبع معالم الأرض لتقليل التعرية)",
 "strip lighting": "إضاءة شريطية (ضوء يتكون من أنابيب طويلة (بدلاً من المصابيح) توفر الإضاءة)",
 "strip mall": "مجمع تجاري مفتوح (مؤسسة تجارية تتكون من صف من المتاجر المختلفة والأعمال التجارية والمطاعم على طول طريق أو شارع مزدحم؛ تفتح عادة على موقف للسيارات)",
 "strip mine": "منجم سطحي (منجم مفتوح (عادة للفحم) حيث تكون الطبقات قريبة من السطح)",
 "strip miner": "عامل تعدين سطحي (عامل منجم يقوم بالتعدين السطحي)",
 "strip mining": "تعدين سطحي, تعدين مكشوف (تعدين الخام أو الفحم من منجم مفتوح)",
 "strip poker": "بوكر التعري, ستريب بوكر (بوكر يتم فيه دفع خسائر اللاعب عن طريق إزالة قطعة من الملابس)",
 "strip search": "تفتيش بالتعرية, تفتيش ذاتي (تفتيش شخص ما بحثاً عن أسلحة مخفية أو مخدرات بجعله يخلع ملابسه)",
 "strip show": "تعري, رقص التعري (شكل من أشكال الترفيه الإيروتيكي حيث يخلع الراقص ملابسه تدريجياً على أنغام الموسيقى)\nمثال: قامت بعرض تعري أمام الجميع مباشرة",
 "strip steak": "ستريب ستيك, شريحة نيويورك (شريحة لحم من الجزء العلوي للخاصرة القصيرة)",
 "strip-jack-naked": "بيغر ماي نيبر (لعبة ورق للاعبين اثنين الهدف منها هو كسب جميع أوراق اللاعب الآخر)",
 "strip-mined": "مُسْتَخْرَجٌ سَطْحِيًّا (مُسْتَخْرَجٌ قُرْبَ سَطْحِ الأَرْضِ بِطَرِيقَةِ التَّعْدِينِ السَّطْحِيّ)",
 "stripe": "شريط, نطاق (زينة تتكون من شريط بلون أو مادة مغايرة) / تقليم, خط (علامة ضيقة بلون أو ملمس مختلف عن الخلفية) / صنف, طينة (نوع أو فئة (من الناس أو التوجهات)) / شارة الرتبة, شريط رتبة\nمثال: ضفدع أخضر بخطوط سوداء صغيرة",
 "stripe blight": "لفحة مخططة (مرض يصيب الشوفان)",
 "striped": "مُخَطَّط",
 "striped bass": "قاروص مخطط (سمكة طعام وصيد بحرية ذات خطوط طولية داكنة؛ تهاجر عكس تيار النهر لوضع البيض) / قاروص مقلم (يصاد على طول ساحل المحيط الأطلسي للولايات المتحدة)",
 "striped button quail": "سمان الشجر المخطط (نوع من سمان الشجر المخطط)",
 "striped coral root": "جذر المرجان المخطط (زهرة برية عديمة الأوراق تقريباً بسيقان منتصبة أرجوانية محمرة تحمل عناقيد من الزهور الوردية الشاحبة والمخططة بالبني؛ غرب كندا إلى المكسيك)",
 "striped cucumber beetle": "خُنْفُسَاء الْخِيَارِ الْمُخَطَّطَة",
 "striped dogwood": "خشب الموظ, قيقب مخطط (قيقب من شرق أمريكا الشمالية بلحاء مخطط وأوراق كبيرة ثنائية الفصوص صفراء صافية في الخريف)",
 "striped drum": "طبل مخطط (نوع من أسماك الطبل)",
 "striped gentian": "جنطيانا مخططة (جنطيانا مستنقعات معمرة موطنها شرق أمريكا الشمالية)",
 "striped hyena": "ضبع مخطط (من شمال أفريقيا والجزيرة العربية والهند)",
 "striped killifish": "سمكة كيلي المخططة, سمكة مايو (سمكة مخططة بالأسود تعيش في الخلجان والمستنقعات الساحلية للمحيط الأطلسي وساحل الخليج في الولايات المتحدة)",
 "striped maple": "خشب الموظ, قيقب مخطط (قيقب من شرق أمريكا الشمالية بلحاء مخطط وأوراق كبيرة ثنائية الفصوص صفراء صافية في الخريف)",
 "striped marlin": "مارلين مخطط (سمكة طعام وصيد في المحيط الهادئ معلمة بخطوط عمودية زرقاء داكنة)",
 "striped muishond": "ابن عرس مخطط (ابن عرس بحجم النمس غالباً ما يتم ترويضه)",
 "striped mullet": "بوري مخطط (أهم أنواع البوري التجارية في شرق الولايات المتحدة)",
 "striped racer": "ثعبان سوط كاليفورنيا, متسابق مخطط (ثعبان سوط يعيش في الأراضي الشجرية وسفوح التلال الصخرية)",
 "striped skunk": "ظربان مخطط (أكثر أنواع الظربان شيوعاً وانتشاراً في أمريكا الشمالية)",
 "striped squirrel": "صيدناني شرقي (سنجاب أمريكي شرقي صغير مخطط شبه أرضي ذو جيوب خدية)",
 "striped violet": "بنفسج شاحب (بنفسج مورق الساق من شرق أمريكا الشمالية له زهور بيضاء كبيرة أو كريمية معلمة بشكل خافت بالأرجواني)",
 "striper": "قاروص مخطط (سمكة طعام وصيد بحرية ذات خطوط طولية داكنة؛ تهاجر عكس تيار النهر لوضع البيض) / قاروص مقلم (يصاد على طول ساحل المحيط الأطلسي للولايات المتحدة) / ذو الرتبة, صاحب شريط (جندي يرتدي أشرطة على الزي الرسمي للإشارة إلى الرتبة أو سنوات الخدمة)",
 "stripes": "شارة الرتبة, شريط رتبة",
 "striping": "تقليم (فعل وضع خطوط مقلمة)",
 "stripling": "مراهق, يافع (حدث في المرحلة بين بداية البلوغ والنضج)",
 "stripped": "مُجَرَّد مِنَ الثِّيَاب (نُزعت عنه الملابس) / عَارٍ, مُجَرَّد (أُزِيلَ مِنْهُ كُلّ شَيْء زَائِد بِمَا فِي ذَلِكَ المُحْتَوَيَات) / مُجَرَّد, مُقَلَّص (لا يحتوي إلا على السمات الأساسية أو الحد الأدنى منها)",
 "stripped-down": "مُجَرَّد, مُقَلَّص (لا يحتوي إلا على السمات الأساسية أو الحد الأدنى منها)",
 "stripper": "بئر ناضب (بئر نفط انخفض إنتاجه إلى أقل من عشرة براميل يومياً) / راقصة تعري, متعرية (فنانة تقدم ترفيهاً مثيراً بخلع الملابس على أنغام الموسيقى) / نازع العروق (عامل ينزع السيقان من أوراق التبغ المرطبة ويربط الأوراق معاً) / مزيل الطلاء (مركب كيميائي يستخدم لإزالة الطلاء أو الورنيش)",
 "stripper well": "بئر ناضب (بئر نفط انخفض إنتاجه إلى أقل من عشرة براميل يومياً)",
 "stripping": "تعرية, كشف (إزالة الغطاء)",
 "striptease": "رَقْص تَعَرِيّ, اِسْتْرِبْتِيز (حركة الجسم بتنسيق موسيقي أو لحن، حيث يتحرك الشخص بشكل إيقاعي أو متناسق مع الموسيقى أو أنغام معينة؛ نشاط جسدي يتم على عادة أو تقليد، حيث يشارك الأفراد في الاحتفالات أو الفعاليات الاجتماعية)\nمثال: كنت تجيد الرقص.",
 "striptease artist": "راقصة تعري, متعرية (فنانة تقدم ترفيهاً مثيراً بخلع الملابس على أنغام الموسيقى)",
 "stripteaser": "راقصة تعري, متعرية (فنانة تقدم ترفيهاً مثيراً بخلع الملابس على أنغام الموسيقى)",
 "stripy": "مُقَلَّم (مُزيَّن بخطوط طوليّة)",
 "strive": "كَافَحَ, اِجْتَهَدَ / جَاهَدَ",
 "striver": "عامل كادح (شخص يعمل بجد مثل العبد)",
 "striving": "سعي, كفاح (محاولة جاهدة لتحقيق هدف)",
 "strix aluco": "بومة سمراء (بومة أوروبية بنية محمرة لها رأس مستدير وعيون سوداء)",
 "strix nebulosa": "بومة رمادية عظمى (بومة كبيرة ذات وجه مسطح من شمال أمريكا الشمالية وغرب أوراسيا)",
 "strix occidentalis": "بومة رقطاء (بومة كبيرة من أمريكا الشمالية توجد في الغابات من كولومبيا البريطانية إلى وسط المكسيك؛ لها ريش بني داكن وصدر مرقط بكثافة)",
 "strix varia": "بومة مخططة (بومة كبيرة من شرق أمريكا الشمالية صدرها وبطنها مخطط باللون البني)",
 "strizostedion vitreum glaucum": "بايك أزرق (نوع يعيش في البحيرات العظمى)",
 "strobe": "ستروبوسكوب, مصباح وميضي (أداة علمية توفر ضوءاً وامضاً متزامناً مع الحركة الدورية لجسم ما؛ يمكن أن تجعل الجسم المتحرك يبدو ثابتاً)",
 "strobe light": "ستروبوسكوب, مصباح وميضي (أداة علمية توفر ضوءاً وامضاً متزامناً مع الحركة الدورية لجسم ما؛ يمكن أن تجعل الجسم المتحرك يبدو ثابتاً)",
 "strobile": "مخروط (كتلة مخروطية الشكل من حراشف أو قنابات حاملة للبويضات أو الأبواغ)",
 "strobilomyces floccopus": "رجل الغابة العجوز (فطر صالح للأكل معتدل الطعم يوجد في الغابات الصنوبرية في شرق أمريكا الشمالية)",
 "strobilus": "مخروط (كتلة مخروطية الشكل من حراشف أو قنابات حاملة للبويضات أو الأبواغ)",
 "stroboscope": "مُصْطَرِبَة",
 "stroke": "سكتة دِمَاغِيَّة / لَاطَفَ / مَلَّسَ",
 "stroke delimber": "آلة إزالة الفروع (آلة لإزالة الفروع من الأشجار بمنشار أو سلاسل ضاربة)",
 "stroke play": "لعب بالضربات (حساب نقاط الغولف عن طريق إجمالي الضربات)",
 "stroking": "تلميس, مسح (لمسة خفيفة باليدين)",
 "stroll": "تَجَوُّل, تَنَزُّه / تَجَوَّلَ, تَنَزَّهَ",
 "stroller": "عَرَبَةُ أَطْفَال",
 "stroma": "سدى (النسيج الداعم لعضو ما (على عكس المتن أو النسيج الحشوي)) / سدى (الهيكل الكثيف عديم اللون للبلاستيدة الخضراء) / سدى فطري (كتلة من الأنسجة الفطرية التي تحتوي على هياكل حاملة للأبواغ مدمجة فيها أو عليها)",
 "stromateid": "سمكة الزبدة (سمكة بحرية صغيرة ذات جسم مضغوط قصير وأشواك ضعيفة)",
 "stromateid fish": "سمكة الزبدة (سمكة بحرية صغيرة ذات جسم مضغوط قصير وأشواك ضعيفة)",
 "stromatolite": "سْتْرُومَاتُولِيت",
 "strombus gigas": "كونش عملاق (نوع كبير من الكونش)",
 "strong": "قَوِيّ (اسم من أسماء الله الحسنى؛ الشَدِيْد ذو الحَوْل) / مَنِيع, مَتِيْن / قَوِيّ, راسِخ (اسم من أسماء الله الحسنى؛ الشَدِيْد ذو الحَوْل) / شَدِيْد, قَوْيّ / شَدِيْد / حَادّ, ثَقِيْل (مَالَ وَانْحَرَفَ عَنِ الطَّرِيقِ؛ تَجَنَّبَ شَيْئًا أَوِ الْاِلْتِزَامَ بِمَسَارٍ مَعَيَّنٍ) / بِقُوَّة\nمثال: كانت صدمة قوية.",
 "strong belief": "إيمان راسخ, قناعة (إيمان راسخ بشيء ما دون الحاجة إلى إثبات أو دليل)",
 "strong breeze": "نسيم قوي (رياح تتحرك بسرعة 25-31 عقدة؛ 6 على مقياس بوفورت)",
 "strong drink": "خمر مقطر, مشروب روحي (مشروب كحولي يتم تقطيره بدلاً من تخميره)",
 "strong force": "تفاعل قوي, قوة نووية قوية ((في الفيزياء) التفاعل الذي يربط البروتونات والنيوترونات معاً في أنوية الذرات؛ يتوسطه غلوونات)",
 "strong gale": "عاصفة قوية (رياح تتحرك بسرعة 47-54 عقدة؛ 9 على مقياس بوفورت)",
 "strong interaction": "تفاعل قوي, قوة نووية قوية ((في الفيزياء) التفاعل الذي يربط البروتونات والنيوترونات معاً في أنوية الذرات؛ يتوسطه غلوونات)",
 "strong law of large numbers": "قانون الأعداد الكبيرة القوي (نسخة من قانون الأعداد الكبيرة تنص على أن متوسط العينة يتقارب بشكل شبه مؤكد مع القيمة المتوقعة)",
 "strong point": "تَخَصُّص, مَوْطِن قُوَّة (ميزة ذات قيمة أو فائدة خاصة)\nمثال: الطبخ هو نقطة قوته",
 "strong suit": "تَخَصُّص, مَوْطِن قُوَّة (ميزة ذات قيمة أو فائدة خاصة) / نقشة قوية (نقشة طويلة تحتوي على بطاقات عالية القيمة)\nمثال: الطبخ هو نقطة قوته",
 "strong yer": "ير قوي (شبه صائت (ير) لم يُختزل إلى صائت فائق القصر، بل تطور إلى صوت مختلف في لغة سلافية حديثة)",
 "strong-arm": "بِالقُوَّة, قَسْرِيّ (مدفوع بالقوّة الجسدية خاصة ضدّ المقاومة)",
 "strong-armer": "بلطجي, سفاح (مجرم شاب عدواني وعنيف)",
 "strong-boned": "قَوِيّ العِظَام (ذُو عِظَام قَوِيَّة ومَتِينَة)",
 "strong-flavored": "قَوِيُّ النَّكْهَة (ذُو طَعْمٍ قَوِيّ)",
 "strong-growing": "سَرِيع الانْتِشَار, عُدْوَانِيّ (يميل إلى الانتشار بسرعة)",
 "strong-minded": "قَوِيُّ الإِرَادَة (يَتَّسِمُ بِاسْتِقْلَالِيَّةٍ قَوِيَّةٍ فِي الفِكْرِ وَالحُكْم) / صَلْب العَزِيمَة, قَوِيّ الإِرَادَة (ذو إرادة حازمة وعزيمة لا تلين)",
 "strong-scented": "قَوِيّ الرَّائِحَةِ, نَفَّاذ (ذُو رَائِحَة قَوِيَّة نَفَّاذَة)",
 "strong-smelling": "قَوِيّ الرَّائِحَةِ, نَفَّاذ (ذُو رَائِحَة قَوِيَّة نَفَّاذَة)",
 "strong-willed": "صَلْب العَزِيمَة, قَوِيّ الإِرَادَة (ذو إرادة حازمة وعزيمة لا تلين)",
 "strongbox": "خزنة, صندوق أمانات (صندوق قوي الصنع لحفظ المال أو الأشياء الثمينة؛ يمكن قفله)",
 "stronghold": "حِصْن (ما يُتَحَصَّنُ به ويُمْنَع؛ كل مكان محميّ مُحرَز لا يُوصَل إليه؛ عن ما يُتَحصَّن به وإن لم يكن موضعا أو مكانا كالسلاح مثلا)\nمثال: كان هناك حصن على تلك الهضبة في يوم من الأيام.",
 "strongly": "بشدة, بقوة (بقوة أو بطريقة قوية) / بشدة, بقوة (بطريقة قوية)\nمثال: يجادل بقوة لاقتراحه",
 "strongman": "دكتاتور, رجل قوي (شخصية سياسية ذكورية قوية تحكم بممارسة القوة أو العنف) / رجل قوي (رجل يؤدي مآثر القوة في معرض أو سيرك)\nمثال: هو مصمم على إسقاط الرجل القوي العراقي",
 "strongroom": "خزنة, غرفة محصنة (غرفة مقاومة للسرقة والحريق تُحفظ فيها الأشياء الثمينة)",
 "strongwoman": "حاكمة قوية (شخصية سياسية قوية أنثى تحكم بممارسة القوة أو العنف)",
 "strongylodon macrobotrys": "سترونجيلودون, كرمة اليشم (ليانا فلبينية قوية دائمة الخضرة ومتسلقة؛ تزرع من أجل أكاليلها الرائعة من الزهور الخضراء التي تشبه مخالب سرطان البحر)",
 "strontianite": "سترونشيانيت (معدن يتكون من كربونات السترونشيوم)",
 "strontium": "إِسْتُرُنْتِيُوم",
 "strontium 90": "سترونتيوم 90 (نظير مشع للسترونتيوم (برقم كتلي 90) موجود في الغبار المتساقط من الانفجارات النووية)",
 "strop": "قشاط (شريط جلدي يستخدم لشحذ شفرات الحلاقة)",
 "strophanthin": "ستروفانثين",
 "strophanthus": "ستروفانثوس (أي من الشجيرات أو الأشجار الصغيرة المختلفة من جنس ستروفانثوس ذات أوراق ملتفة وأزهار مبهرجة بألوان مختلفة في مجموعات كثيفة ومشطية؛ بعضها يحتوي على…)",
 "strophanthus kombe": "ستروفانثوس كومبي (نبات يعد مصدراً للستروفانثين)",
 "stropharia ambigua": "ستروفاريا غامضة (فطر ذو خياشيم بساق طويل وقبعة لزجة صفراء تتدلى منها شظايا الحجاب المكسور؛ الخياشيم بيضاء في البداية لكنها تصبح بنية داكنة عند إطلاق الأبواغ)",
 "stropharia hornemannii": "ستروفاريا هورنمان (فطر ذو خياشيم بقبعة لزجة كبيرة أرجوانية أو زيتونية؛ تصبح الخياشيم أرجوانية مع تقدم العمر؛ الساق طويل ومزين بقطع من الغمد الأبيض الذي يمتد حتى الحلقة)",
 "stropharia rugoso-annulata": "ستروفاريا مجعدة الحلقة (فطر كبير ذو خياشيم بقبعة عريضة وساق طويل؛ القبعة بنية داكنة؛ تتحول الخياشيم البيضاء إلى بني أرجواني داكن مع تقدم العمر؛ صالح للأكل وممتاز)",
 "strophe": "دور, مقطع (قسم واحد من قصيدة غنائية أو قصيدة كورالية في الدراما اليونانية الكلاسيكية)",
 "stroppy": "جَمُوح, مُتَذَمِّر (صاخب وعنيد ومتمرد)",
 "struck": "مَذْهُول, مَصْدُوم ((يُستخدم في التركيب) متأثر بشيء طاغٍ أو ساحق)",
 "structural": "بِنْيَوِيّ, هَيْكَلِيّ (يَتَعَلَّقُ بِالبِنْيَةِ المُنَظَّمَةِ فِي حَقْلٍ دِرَاسِيٍّ مُعَيَّنٍ) / إِنْشَائِيّ, بِنْيَوِيّ (يُؤَثِّرُ فِي البِنْيَة أَوِ التَّشْيِيد أَوْ يَتَعَلَّقُ بِهِمَا) / إنشائي, بنيوي (متعلق بالهيكل أو البنية أو يتميز بهما) / بنيوي, هيكلي (متعلق بالبنية أو ناتج عنها، خاصة البنية السياسية أو الاقتصادية)\nمثال: مهندس إنشائي",
 "structural anthropology": "أنثروبولوجيا بنيوية, بنيوية (نظرية أنثروبولوجية تفيد بوجود هياكل اجتماعية غير قابلة للملاحظة تولد ظواهر اجتماعية قابلة للملاحظة)",
 "structural concrete": "خرسانة إنشائية (نوع خاص من الخرسانة قادر على حمل حمل إنشائي أو تشكيل جزء لا يتجزأ من الهيكل)",
 "structural formula": "صيغة بنائية (صيغة جزيئية موسعة تظهر ترتيب الذرات داخل الجزيء)",
 "structural gene": "جين هيكلي (جين يتحكم في إنتاج بروتين أو ببتيد معين)",
 "structural genomics": "جينوم هيكلي (فرع علم الجينوم الذي يحدد الهياكل ثلاثية الأبعاد للبروتينات)",
 "structural iron": "حديد إنشائي (حديد تم صبه أو تشكيله في أشكال هيكلية)",
 "structural linguistics": "بنيوية, لسانيات بنيوية (اللسانيات المعرفة كتحليل للهياكل الشكلية في نص أو خطاب)",
 "structural member": "عنصر إنشائي (دعامة تعد جزءاً مكوناً لأي هيكل أو مبنى)",
 "structural sociology": "بنيوية, علم اجتماع بنيوي (نظرية اجتماعية تقوم على فرضية أن المجتمع يأتي قبل الأفراد)",
 "structural steel": "فولاذ إنشائي (فولاذ قوي يتم دحرجته إلى أشكال تستخدم في البناء)",
 "structuralism": "بنيوية, علم اجتماع بنيوي (نظرية اجتماعية تقوم على فرضية أن المجتمع يأتي قبل الأفراد) / أنثروبولوجيا بنيوية, بنيوية (نظرية أنثروبولوجية تفيد بوجود هياكل اجتماعية غير قابلة للملاحظة تولد ظواهر اجتماعية قابلة للملاحظة) / بنيوية, لسانيات بنيوية (اللسانيات المعرفة كتحليل للهياكل الشكلية في نص أو خطاب)",
 "structurally": "بِنْيَوِيًّا, هَيْكَلِيًّا (فيما يتعلق بالهيكل)\nمثال: هيكلياً، المنظمة سليمة",
 "structure": "هَيْكَل",
 "structured": "منظم, مهيكل (لديه هيكل محدد ومنظم للغاية) / مُتَكَامِل, مُهَيْكَل (يُشبه الكائن الحي في التنظيم أو التطور)\nمثال: بيئة منظمة",
 "strudel": "سترودل (ورقة رقيقة من العجين المحشو الملفوف والمخبوز)",
 "struggle": "كِفَاح, نِضَال / كافح, جَاهَدَ",
 "struggler": "مُكَافِح, مُنَاضِل (شخص يصارع الصعوبات أو يبذل جهداً كبيراً)",
 "struggling": "مُكَافِح (منخرط في كفاح للتغلب خاصة على الفقر أو الغموض)",
 "strum": "دندنة, عزف (صوت العزف على الأوتار)\nمثال: عزف الغيتار",
 "struma": "الخنازير, داء الخنازير (شكل من أشكال السل يتميز بتورم الغدد اللمفاوية) / تضخم الغدة الدرقية, دراق (تضخم غير طبيعي للغدة الدرقية)",
 "strumpet": "زانية, فاجرة (امرأة ترتكب الزنا)",
 "strung": "معلق بخيط, منظوم (الذي يكون على خيط)\nمثال: مفاتيح منظومة في حبل أحمر",
 "strung-out": "مُدْمِن مُخَدِّرَات (مدمن على مادّة مخدِّرة)",
 "strut": "تَبَخْتَر",
 "struthio camelus": "نعامة (طائر أفريقي سريع الجري لا يطير له قدمان بإصبعين؛ أكبر طائر حي)",
 "struthiomimus": "ستروثيوميمس (ديناصور صغير خفيف العظام عديم الأسنان يشبه النعامة في الحجم والنسب)",
 "strychnine": "ستريكنين (سم قلويدي نباتي يستخرج بشكل رئيسي من الجوز المقيئ؛ كان يستخدم سابقاً كمنبه)",
 "strymon melinus": "فراشة مخططة رمادية (اليرقات هي آفات لنباتات اقتصادية مختلفة)",
 "stuart": "ستيوارت (العائلة المالكة التي حكمت اسكتلندا من 1371-1714 وحكمت إنجلترا من 1603 إلى 1649 ومرة أخرى من 1660 إلى 1714) / ستيوارت (عضو في العائلة المالكة التي حكمت اسكتلندا وإنجلترا)",
 "stub": "بذرَة",
 "stub nail": "مسمار قصير (مسمار سميك قصير)",
 "stub out": "أَطْفَأَ (أطفأ بالسحق أو الضغط)\nمثال: أطفئ سيجارتك الآن",
 "stubbiness": "اكتناز, قصر وغلظ (خاصية كون الشيء قصيراً وعريضاً)",
 "stubble": "شُعَيْرَات اللِّحْيَة / قَشّ",
 "stubbled": "خَشِن اللِّحْيَة, ذُو شَعْر قَصِير (له نموّ قصير من شعر اللحية)",
 "stubbly": "خَشِن اللِّحْيَة, ذُو شَعْر قَصِير (له نموّ قصير من شعر اللحية)",
 "stubborn": "عَنِيد",
 "stubbornly": "بإصرار, بعناد (بطريقة عنيدة)\nمثال: بقيت بعناد في نفس الوضع",
 "stubbornness": "عِنَاد",
 "stubby": "قَصِير وَغَلِيظ (قَصير وَعَريض وَغَليظ)",
 "stucco": "جص أسمنتي, ستوكو (جص مصنوع الآن في الغالب من الأسمنت البورتلاندي والرمل والجير؛ يطبق وهو لين لتغطية الجدران أو الأسطح الخارجية)",
 "stuck": "عَالِق",
 "stuck-up": "مَغْرُور, مُتَعَالٍ ((غير رسمي) مفرط في الغرور والتعالي)",
 "stud": "فحل",
 "stud farm": "إسطبل تربية, مزرعة خيول أصيلة (مزرعة يتم فيها تربية الخيول)",
 "stud finder": "كاشف المسامير (مغناطيس دائم صغير في حاوية معدنية؛ عندما ينقر المغناطيس ضد الحاوية فإنه يشير إلى أن المغناطيس فوق مسمار حديدي يثبت اللوح الجداري في الدعامة مباشرة)",
 "stud mare": "فرس ولود (أنثى حصان تستخدم للتربية)",
 "stud poker": "ستد بوكر (بوكر يتلقى فيه كل لاعب أوراقاً مقلوبة والباقي مكشوفة؛ توضع الرهانات بعد توزيع كل ورقة)",
 "studbook": "سجل النسب (سجل رسمي لنسب الحيوانات الأصيلة وخاصة الخيول)",
 "studded": "مُثَبَّت عَلَيْه بِرَشَام, مُرَصَّع (منقط أو مزين بمسامير أو برشام زخرفي)",
 "student": "طَالِب, طَالِبَة",
 "student center": "مركز طلابي (مركز للأنشطة الطلابية في كلية أو جامعة)",
 "student lamp": "مصباح دراسة, مصباح مكتب (مصباح قراءة ذو عنق مرن؛ يستخدم على المكتب)",
 "student lodging": "سكن طلابي, مهجع (مبنى كلية أو جامعة يحتوي على أماكن معيشة للطلاب)",
 "student nurse": "ممرضة متدربة (ممرضة قيد التدريب تخضع لفترة تجربة)",
 "student residence": "سكن طلابي, مهجع (مبنى كلية أو جامعة يحتوي على أماكن معيشة للطلاب)",
 "student teacher": "طالب معلم (طالب جامعي يقوم بالتدريس تحت إشراف معلم معتمد للتأهل للحصول على درجة في التعليم)",
 "student union": "اتحاد الطلاب (مبنى في الحرم الجامعي مخصص للأنشطة الاجتماعية والتنظيمية للطلاب)",
 "studentship": "حالة الطالب, منحة دراسية (منصب الطالب أو الباحث (خاصة الممنوح))",
 "studhorse": "فحل (حصان ذكر بالغ يتم الاحتفاظ به للتكاثر)",
 "studied": "متعمد, متكلف (مُنتج أو متميز بتصميم واعي أو سبق إصرار)\nمثال: ابتسامة مدروسة",
 "studio": "إِسْتُودِيُو",
 "studio apartment": "شقة استديو (شقة بمساحة معيشة وحمام ومطبخ صغير)",
 "studio couch": "أريكة استوديو (أريكة منجدة قابلة للتحويل يمكن تحويلها إلى سرير مزدوج)",
 "studious": "حَثِيث, مُجِدّ (يَتَّسِم بِالعِنَايَة والجُهْد المَدْرُوس) / دَؤُوب, مُوَلَّعٌ بِالقِرَاءَة (يتّسم بالدراسة الجادّة والشغف بالمطالعة)",
 "studiously": "باهتمام بالغ, بجدية (بطريقة توحي بالدراسة والاهتمام)\nمثال: فحصت البيانات باهتمام بالغ",
 "studiousness": "اجتهاد في الدراسة (دراسة دؤوبة)",
 "study": "ذَاكَرَ, دَرَسَ / دَرَسَ ((متعدٍّ بنفسه) عَلَّمَ، لَقَّنَ؛ اِمْتَهَنَ التَّعْلِيم) / دَرَسَ, تَعَلَّمَ ((متعدٍّ بنفسه) عَلَّمَ، لَقَّنَ؛ اِمْتَهَنَ التَّعْلِيم) / تَعَلُّم, دِرَاسَة (اكتسب معرفة أو خبرة أو مهارة) / مَكْتَب (الموضع الذي يُكتَب عليه. بعكس المَكْتَب الذي يكتب فيه؛ مِنْضَدَة مخصصة للكتابة، سواء كانت للمَكَاتِب أم لغيرها)\nمثال: أراك بعد الدرس.",
 "study hall": "قاعة المطالعة (فصل دراسي مخصص للدراسة) / حصة دراسة حرة, قاعة استذكار (فترة زمنية خلال اليوم الدراسي تخصص للدراسة والمذاكرة)",
 "studying": "تمحيص, دراسة (القراءة بعناية بقصد التذكر)",
 "stuff": "أشياء, أغراض (أشياء متنوعة غير محددة) / طينة, مقومات (صفات غير محددة مطلوبة للقيام بشيء ما أو لكي تكون شيئاً ما) / عنصر, مادة (مكون مهم جداً أو مميز) / كَلَام فَارِغ, هُرَاء (حديث لا معنى له)\nمثال: كان الصندوق مليئاً بالأغراض",
 "stuff and nonsense": "كَلَام فَارِغ, هُرَاء (حديث لا معنى له)\nمثال: لا تعطيني هذا الهراء",
 "stuff shot": "دانك, رمية ساحقة (رمية كرة سلة يتم فيها دفع الكرة لأسفل داخل السلة)",
 "stuffed": "مَحْشُوّ (مَمْلُوء بِشَيْء مَا) / مَحْشُوّ بِالطَّعَام, مُتْخَم (مَمْلُوء بِالطَّعَام حَتَّى التُّخَمَة)",
 "stuffed cabbage": "محشي كرنب, ملفوف محشو (رأس ملفوف مسلوق جزئياً ومفرغ ومحشو بخليط من اللحم المفروم أو اللحم المقدد ومخبوز؛ يقدم مع صلصة الطماطم أو الجبن)",
 "stuffed derma": "أمعاء محشوة, كيشكي ((في اليهودية) أمعاء طيور مشوية بحشوة متبلة من دقيق الماتزو والشحم)",
 "stuffed egg": "بيض محشو (أنصاف بيض مسلوق جيداً يهرس صفاره مع المايونيز والتوابل ثم يعاد إلى البياض)",
 "stuffed grape leaves": "دولمة, ورق عنب محشو (أرز متبل جيداً (مع المكسرات أو الكشمش أو لحم الضأن المفروم) مطهو ببطء أو مطهو في المرق)",
 "stuffed mushroom": "فطر محشو (فطر محشو بأي من خلطات عديدة مثل اللحوم أو المكسرات أو المأكولات البحرية أو السبانخ)",
 "stuffed peppers": "فلفل محشو, محشي فلفل (فلفل أخضر مسلوق جزئياً محشو عادة بالأرز واللحم ومخبوز لفترة وجيزة)",
 "stuffed shirt": "شخص رسمي جداً, متزمت (شخص ممل يتسم بالرسمية المفرطة والغطرسة والرجعية)",
 "stuffed tomato": "طماطم محشوة ساخنة (حبات طماطم محشوة بخلطات مختلفة ومخبوزة لفترة وجيزة) / طماطم محشوة باردة (حبات طماطم محشوة بخلطات سلطة متنوعة وتقدم باردة)",
 "stuffer": "نَشْرَة مُرْفَقَة (نشرة إعلانية يتم إرفاقها بمواد أخرى و (عادة) ترسل بالبريد) / محنط الحيوانات (حرفي يحشو ويركب جلود الحيوانات للعرض)",
 "stuffily": "بتزمت, برسمية مملة (بطريقة متزمتة ومملة)\nمثال: قال بتزمت: 'تفضل بالدخول'",
 "stuffiness": "ثقل دم, جمود (وقار ممل ومتغطرس) / انعدام التهوية, كتمة (صفة انحباس الهواء وسوء التهوية) / انسداد (حالة انسداد أو توقف الهواء في الأنف أو الحلق)",
 "stuffing": "حشو (حشوة توضع في المراتب والوسائد والأثاث المنجد) / تتبيلة الحشو, حشوة (خليط من المكونات المتبلة يستخدم لحشو اللحوم والخضروات)",
 "stuffing box": "صندوق الحشو (حجرة صغيرة يتم فيها ضغط الحشو حول عمود متردد أو مكبس لتشكيل ختم محكم)",
 "stuffing nut": "صامولة التعبئة, صامولة الحشو (صامولة تستخدم لشد صندوق الحشو)",
 "stuffy": "جَامِد, مُمِلّ (تَقْلِيدِيٌّ بِإِفْرَاطٍ وَيَفْتَقِرُ لِلخَيَالِ مِمَّا يَجْعَلُهُ مُمِلًّا) / خَانِق, مُحْتَقِن (يعاني من إحساس بالانسداد أو الاحتقان) / خَانِق, كَتِيم (يَفْتَقِرُ إِلَى الهَوَاءِ النَّقِيّ)",
 "stultification": "إخماد, إضعاف (فعل جعل الشيء عقيماً وعديم الفائدة (كما بالروتين)) / اسْتِغْبَاء, تَسْفِيه (السخرية من شخص أو شيء ما باعتباره أحمق أو سخيفاً أو غير متسق)",
 "stumble": "عَثْرَة / تَلَعْثَمَ (اضطرب في كلامه) / عَثَرَ",
 "stumble upon": "عَثَرَ",
 "stumblebum": "أبله, أجلف (شخص أخرق وغبي) / ملاكم فاشل (ملاكم محترف من الدرجة الثانية)",
 "stumbler": "أخرق, فاشل (شخص يرتكب أخطاء بسبب عدم الكفاءة) / متعثر (ماش أو عداء يتعثر ويكاد يسقط)",
 "stumbling block": "حجر عثرة (أي عقبة أو عائق)",
 "stump": "جُذْمُور, كُنَّاشَة",
 "stump speech": "خطبة انتخابية (خطابة سياسية)",
 "stump spud": "مجرفة قلع (مجرفة يدوية حادة لاقتلاع الجذور والأعشاب الضارة)",
 "stumper": "سُؤَال مُحَيِّر, مُعْضِلَة (سؤال أو مشكلة صعبة أو محيرة بشكل خاص)",
 "stumping": "جولة خطابية (القيام بحملة لشيء ما عن طريق إلقاء الخطب السياسية)",
 "stumpknocker": "سمكة الشمس المرقطة (تعيش في الجداول من كارولينا الجنوبية إلى فلوريدا؛ سمكة مقلاة محبوبة)",
 "stumpy": "قَصِير مُمْتَلِئ, مُكَتَّل (قصير وسمين؛ ذو ساقين قصيرتين وعضلات ثقيلة)",
 "stun baton": "عصا الصعق, مسدس الصعق (سلاح مصمم لتعطيل الضحية مؤقتاً عن طريق توجيه صدمة كهربائية عالية الجهد غير مميتة)",
 "stun gun": "صَاعِق",
 "stung": "مُتَضَايِق, مُنْزَعِج (أُثير فيه نفاد الصبر أو الغضب)",
 "stunned": "مَذْهُول, مَصْدُوم (في حالة خدر ذهنيّ ناتج عن صدمة أو ضربة) / مَصْرُوع, مُغْمًى عَلَيْهِ (فَقَدَ وَعْيَهُ بِسَبَبِ ضَرْبَةٍ قَوِيَّةٍ) / مَذْهُول, مُنْدَهِش (مملوء بالتأثر العاطفي الناجم عن مفاجأة أو صدمة شديدة)",
 "stunner": "حدث مذهل, مذهلة (حدث غير متوقع ومذهل) / حسناء, فاتنة (امرأة جذابة جداً أو مغرية المظهر)\nمثال: كان الحدث المذهل هو ما حدث يوم السبت",
 "stunning": "خَاطِف لِلْأَنْظَار, مُذْهِل (جميل أو جذاب بشكل لافت) / لَافِت, مُثِير لِلانْتِبَاه (يستحوذ على الانتباه ويأسره) / صَاعِق, مُذْهِل (يسبب أو قادر على التسبب في الذهول أو الصدمة أو فقدان الوعي) / مُذْهِل, مُصْعِق (يُسبب ذهولًا وحيرة شديدين)",
 "stunningly": "بشكل مذهل (بطريقة مذهلة)\nمثال: كانت المنطقة ذات مناظر خلابة بشكل مذهل",
 "stunt": "حيلة مثيرة, مجازفة (عمل صعب أو غير عادي أو خطير؛ يتم عادة لجذب الانتباه) / حيوان متقزم (مخلوق (خاصة الحوت) تم منعه من بلوغ النمو الكامل)",
 "stunt flier": "طيار استعراضي (طيار يسافر في جميع أنحاء البلاد لتقديم عروض الطيران البهلواني والقفز بالمظلات)",
 "stunt flying": "ألعاب بهلوانية جوية, استعراض جوي (أداء حركات بهلوانية أثناء الطيران بطائرة)",
 "stunt kite": "طائرة ورقية رياضية (طائرة ورقية قابلة للمناورة يتم التحكم فيها بخطين وتطير بكلتا اليدين)",
 "stunt man": "دوبلير, ممثل بديل (بديل ذكر لنجوم السينما لأداء الحركات الخطرة)",
 "stunt pilot": "طيار استعراضي (طيار يسافر في جميع أنحاء البلاد لتقديم عروض الطيران البهلواني والقفز بالمظلات)",
 "stunt woman": "دوبليرة, ممثلة بديلة (بديلة أنثى لنجوم السينما لأداء الحركات الخطرة)",
 "stunted": "مُتَقَزِّم, هَزِيل (صغير الحجم أو رديء الجودة)",
 "stuntedness": "تقزم, ضآلة الحجم (صغر القامة أو البنية)",
 "stunting": "ألعاب بهلوانية جوية, استعراض جوي (أداء حركات بهلوانية أثناء الطيران بطائرة)",
 "stupa": "سْتُوبَا",
 "stupe": "أحمق, بليد (شخص ليس ذكياً جداً)\nمثال: إنه الاقتصاد يا غبي!",
 "stupefaction": "تخدير, ذهول (فعل جعل الشخص متبلد الشعور أو خاملاً) / ترنح, ذهول (وعي هامشي) / انصعاق, ذهول (شعور بالدهشة المذهلة)\nمثال: اشتهر الأستاذ بجعل طلابه في حالة ذهول",
 "stupefied": "مَذْهُول, مَصْدُوم (في حالة خدر ذهنيّ ناتج عن صدمة أو ضربة) / مَبْهُوت, مَصْعُوق (كأنه أُصيب بالخرس من شدة الذهول والمفاجأة)",
 "stupefying": "مُذْهِل, مُصْعِق (يصدم بالمفاجأة والذهول) / مُدْهِش, مُذْهِل (مُثير للإعجاب بشكل مُفاجئ لدرجة الذهول أو الإرباك) / مُبَلِّد, مُخَدِّر (يجعل الجسم في حالة بلادة أو خدر أو فقدان إحساس)",
 "stupendous": "جَبَّار, هَائِل (عظيم في الحجم أو القوة أو المدى لدرجة تثير الرهبة)",
 "stupendously": "بدرجة هائلة, بشكل مذهل (بدرجة مذهلة)\nمثال: أناس جاهلون بشكل مذهل",
 "stupid": "غَبِيّ / غَبِيّ, أَحْمَق",
 "stupid person": "أحمق, بليد (شخص ليس ذكياً جداً)\nمثال: إنه الاقتصاد يا غبي!",
 "stupidity": "غَبَاء, غَبَاوَة (بمعنى أن يخفى الأمر، يقال أيضا غَبَاءَة وغَبَاوَة والغباء أعمّ؛ بمعنى ضد الفِطْنة والذَكاء، يقال أيضا غَبَاوة)\nمثال: ما تقترحه غباء.",
 "stupidly": "بغباء (بطريقة غبية)\nمثال: اشترى تذكرة ذهاب فقط بغباء",
 "stupor": "ترنح, ذهول (وعي هامشي) / ذهول, صدمة (شعور بالضيق وعدم التصديق الذي ينتابك عند حدوث شيء سيء بشكل عرضي)\nمثال: كان ترنحه بسبب الإرهاق بقدر ما كان بسبب الضربات",
 "stuporous": "مَخْمُور, مُشَوَّش (مذهول أو مشوّش وبطيء الاستجابة كما من الضربات أو السُّكر أو الإرهاق)",
 "sturdily": "بثبات, بصلابة (بطريقة متينة وقوية)\nمثال: قدمان متباعدتان بصلابة",
 "sturdiness": "صلابة, متانة (حزم يتضح من خلال قوة الشخصية) / صلابة, متانة (خاصية كون الشيء مبنياً بقوة) / صلابة جسدية, متانة (حالة التمتع بالقوة والصلابة)\nمثال: صلابة المبدأ الأخلاقي",
 "sturdy": "صَلْب, مَتِين (مَصْنُوعٌ أَوْ مَبْنِيٌّ بِمَتَانَةٍ وَصَلَابَة) / صارم, لا هوادة فيه (لا يقدم تنازلات) / صُلْب, قَوِيُّ البُنْيَة (ذو قوة بدنية متينة؛ متمرّس على التعب والمشقّة)\nمثال: اتخذ موقفاً متشدداً في محادثات السلام",
 "sturgeon": "حَفْش (دخل في شيءٍ بسرعة أو اقتحمَه بطريقة مفاجئة؛ عمل شيئًا بسرعة أو دون تدقيق)",
 "sturm und drang": "اضطراب, قلاقل (حالة من الاضطراب والفوضى العنيفة (كما في السياسة أو الظروف الاجتماعية بشكل عام))\nمثال: كانت الثورة الصناعية فترة اضطراب كبير",
 "sturmabteilung": "كتيبة العاصفة (ميليشيا نازية أنشأها هتلر عام 1921 ساعدته في الوصول إلى السلطة ولكن طغت عليها القوات الخاصة بعد عام 1943)",
 "sturnella magna": "قبرة المروج الشرقية (قبرة مروج من شرق أمريكا الشمالية)",
 "sturnella neglecta": "قبرة المروج الغربية (قبرة مروج من غرب أمريكا الشمالية)",
 "sturnus vulgaris": "زرزور شائع (طائر اجتماعي ذو ريش بلمعان معدني داكن؛ يبني أعشاشاً حول المساكن والهياكل الأخرى؛ متوطن في جميع أنحاء العالم)",
 "sturt pea": "بازلاء الصحراء, بازلاء ستورت (نبات معمر شجيري مترامي الأطراف يشتهر بزهوره القرمزية المعلمة بالأسود؛ واسع الانتشار في الأجزاء الجافة من أستراليا)",
 "sturt's desert pea": "بازلاء الصحراء, بازلاء ستورت (نبات معمر شجيري مترامي الأطراف يشتهر بزهوره القرمزية المعلمة بالأسود؛ واسع الانتشار في الأجزاء الجافة من أستراليا)",
 "stutter": "تاتاة, تلعثم (اضطراب في الكلام ينطوي على تردد وتكرار لا إرادي لأصوات معينة)",
 "stutterer": "أَرَتُّ ((أَرَتَّه) الله: جعل فِي لِسَانه رُتَّة)\nمثال: أرت لي ألبومها.",
