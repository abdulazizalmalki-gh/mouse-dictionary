 "storm": "عَاصِفَة / طُوفَان (عاصفة) / عَاصْفة",
 "storm cellar": "قبو العواصف, ملجأ الأعاصير (ملجأ تحت الأرض يمكنك الذهاب إليه حتى تمر العاصفة)",
 "storm center": "عين العاصفة, مركز العاصفة (المنطقة المركزية أو المكان ذو الضغط الجوي الأدنى داخل العاصفة) / مركز العاصفة (مركز المشاكل أو الاضطرابات)",
 "storm centre": "عين العاصفة, مركز العاصفة (المنطقة المركزية أو المكان ذو الضغط الجوي الأدنى داخل العاصفة) / مركز العاصفة (مركز المشاكل أو الاضطرابات)",
 "storm cloud": "سحابة عاصفة (سحابة داكنة كثيفة تنذر بمطر أو عاصفة)",
 "storm cone": "مخروط التحذير من العواصف (مخروط قماشي يُرفع للتحذير من الرياح العاتية)",
 "storm door": "باب الحماية من العواصف (باب خارجي إضافي للحماية من الطقس القاسي أو الشتاء)",
 "storm drain": "شبكة صرف, نظام تصريف (نظام من المجاري المائية أو المصارف لتصريف المياه الزائدة)",
 "storm lamp": "فانوس العاصفة, مصباح العاصفة (مصباح زيت بمدخنة زجاجية وغطاء معدني مثقوب لحماية اللهب من الرياح العاتية؛ شمعدان بمدخنة زجاجية)",
 "storm lantern": "فانوس العاصفة, مصباح العاصفة (مصباح زيت بمدخنة زجاجية وغطاء معدني مثقوب لحماية اللهب من الرياح العاتية؛ شمعدان بمدخنة زجاجية)",
 "storm petrel": "طائر النوء (أي من طيور النوء الصغيرة المتنوعة ذات الريش الداكن والأجزاء السفلية الشاحبة)",
 "storm sash": "نافذة واقية (نافذة خارج نافذة عادية للحماية من الطقس القاسي أو الشتاء)",
 "storm sewer": "شبكة صرف, نظام تصريف (نظام من المجاري المائية أو المصارف لتصريف المياه الزائدة)",
 "storm signal": "إشارة تحذير من العاصفة (إشارة تعلن عن اقتراب عاصفة (خاصة عاصفة شديدة العنف))",
 "storm trooper": "جندي العاصفة (عضو في القوات شبه العسكرية النازية)",
 "storm troops": "كتيبة العاصفة (ميليشيا نازية أنشأها هتلر عام 1921 ساعدته في الوصول إلى السلطة ولكن طغت عليها القوات الخاصة بعد عام 1943)",
 "storm window": "نافذة واقية (نافذة خارج نافذة عادية للحماية من الطقس القاسي أو الشتاء)",
 "storm-beaten": "مُتَضَرِّرٌ مِنَ العَاصِفَةِ (أصابه ضرر بسبب العواصف)",
 "storm-tossed": "مُبْتَلًى بِالعَوَاصِف, مُعَصَّف بِه (تعرض للضرب المتكرر من العواصف أو المحن)",
 "stormbound": "مَحْصُورٌ بِالعَاصِفَةِ (مُتَأَخِّرٌ أَوْ مَحْبُوسٌ أَوْ مَعْزُولٌ بِسَبَبِ عَاصِفَةٍ)",
 "stormily": "باضطراب, بشغف (بطريقة عاصفة أو عنيفة)",
 "storminess": "حدة, هياج (عاطفة عنيفة في الكلام أو العمل) / اضطراب جوي, عصف (حالة كونه عاصفاً)\nمثال: خائف من حدة جدالهم",
 "stormproof": "مُقَاوِم لِلْعَوَاصِف (محميّ ضدّ العواصف أو قادر على تحمّلها)",
 "stormwater drain": "شبكة صرف, نظام تصريف (نظام من المجاري المائية أو المصارف لتصريف المياه الزائدة)",
 "stormy": "عَاصِف",
 "stormy petrel": "نوء العاصفة (طائر نوء أسود فحمي مع علامات بيضاء؛ يعيش في شمال المحيط الأطلسي والبحر الأبيض المتوسط)",
 "story": "قِصَّة, حِكَايَة",
 "story arc": "مُنْعَطَف القِصَّة, تَسَلْسُل أَحْدَاث",
 "storybook": "كتاب قصص (كتاب يحتوي على مجموعة من القصص (عادة للأطفال))",
 "storyline": "خط القصة, مسار الأحداث (حبكة كتاب أو مسرحية أو فيلم)",
 "storyteller": "قَصَّاص, قَصَّاصَة",
 "stotinka": "ستوتينكا (100 ستوتينكا تساوي 1 ليف في بلغاريا)",
 "stoup": "حوض الماء المقدس (حوض للماء المقدس) / كوب شرب قديم (وعاء شرب قديم)",
 "stout": "بَادِن, مُمْتَلِئ الجِسْم (تَعْبِيرات مُلَطَّفَة لِلدَّلَالَة عَلَى البَدَانَة) / صَلْبٌ, وَفِيٌّ (يُعتمد عليه ولا يتراجع) / صُلْب, قَوِيُّ البُنْيَة (ذو قوة بدنية متينة؛ متمرّس على التعب والمشقّة) / بدين, ممتلئ (مقاس ملابس لشخص كبير أو ثقيل الوزن)",
 "stout-billed": "غَلِيظ المِنْقَار (ذو منقار قوي وغليظ)",
 "stout-stemmed": "غَلِيظ السَّاق (ذو ساق غليظة وقويّة)",
 "stouthearted": "ثَابِت الجَأْش, رَابِط الجَأْش (يُوصَف بِهِ الأَشْخَاص بِشَكْلٍ خَاصّ؛ قَوِيّ العَزِيمَة)",
 "stoutheartedness": "رباطة جأش, قوة قلب (سمة امتلاك روح شجاعة)",
 "stoutly": "ببسالة, بصلابة (بطريقة حازمة)\nمثال: كان يرد ببسالة على منتقديه",
 "stoutness": "سِمَن (الدُهُون التي تؤكل، وتشمل الزُبْد والقِشْطَة وما يستخرج من الحَيْوَان والنبات. قيل السمن من الحيوان والدهن من النبات وقيل السمن ما يؤكل والدهن ما لا…)",
 "stove": "مَوْقِد, مِدْفَأَة / مَوْقِد",
 "stove bolt": "مسمار برغي صغير (مسمار آلة صغير)",
 "stove poker": "مِحْراك النار (قضيب معدني بمقبض؛ يستخدم لتحريك النار)",
 "stovepipe": "قبعة رسمية, قبعة عالية (قبعة رجالية ذات تاج عالٍ؛ عادة ما تكون مغطاة بالحرير أو بفرو القندس) / أنبوب الموقد (مدخنة تتكون من أنبوب معدني بقطر كبير يستخدم لتوصيل الموقد بمجرى الدخان)",
 "stovepipe iron": "حديد الأنابيب (لوح حديدي أرق من حديد الخزانات)",
 "stovepiped": "مجزأ, منعزل (مكون من أو متعلق بالبيانات المخزنة في قواعد بيانات منفصلة (غير مترابطة))\nمثال: معلومات مجزأة",
 "stovepiping": "استرجاع منعزل (استرجاع المعلومات من قواعد بيانات غير متصلة؛ الوضع الذي يتطلب الخروج من قاعدة بيانات واحدة للدخول في أخرى)",
 "stover": "سيقان العلف, قش الذرة (السيقان والأوراق المجففة لمحصول حقلي (خاصة الذرة) تستخدم كعلف للحيوانات بعد حصاد الحبوب)",
 "stowage": "ترتيب البضائع, تستيف (عملية التعبئة أو التخزين) / غرفة تخزين, مخزن (غرفة تُخزن فيها الأشياء) / أجرة التستيف, رسوم التستيف (الرسم لتستيف (تخزين وترتيب) البضائع)",
 "stowaway": "مسافر خلسة (شخص يختبئ على متن سفينة أو طائرة أملاً في الحصول على رحلة مجانية)",
 "stowing": "ترتيب البضائع, تستيف (عملية التعبئة أو التخزين)",
 "stp": "درجة الحرارة والضغط القياسيين",
 "strabismus": "حول (محاذاة غير طبيعية لإحدى العينين أو كلتيهما)",
 "strabo": "سترابو",
 "strabotomy": "بضع الحول (العملية الجراحية لقطع عضلة أو وتر في العين لتصحيح الحول)",
 "strad": "ستراديفاريوس (كمان صنعه أنطونيو ستراديفاري أو أحد أفراد عائلته)",
 "stradavarius": "ستراديفاريوس (كمان صنعه أنطونيو ستراديفاري أو أحد أفراد عائلته)",
 "straddle": "اِمْتَطَى",
 "strafe": "تمشيط جوي, قصف جوي منخفض (هجوم بنيران الرشاشات أو نيران المدافع من طائرة تحلق على علو منخفض)\nمثال: نفذوا في صباح اليوم التالي تمشيطاً جوياً لمطارات العدو",
 "strafer": "طيار قاصف (طيار مقاتل يقصف العدو على ارتفاع منخفض)",
 "straggle": "شرذمة, مجموعة متفرقة (تجمع متجول أو غير منظم (لأشياء أو أشخاص))\nمثال: مجموعة متناثرة من المباني الملحقة",
 "straggler": "شارد, متخلف عن الركب (شخص يضل الطريق أو يتخلف عن المجموعة)",
 "straggling": "مُتَرَامِي الأَطْرَاف, مُتَنَاثِر (يَمْتَدُّ فِي اتِّجَاهَاتٍ مُخْتَلِفَةٍ أَوْ مُوَزَّعٌ بِشَكْلٍ غَيْرِ مُنْتَظِم)",
 "stragglingly": "بشكل مبعثر, بشكل متناثر (بطريقة متناثرة وغير منتظمة)\nمثال: جدار حجري يمتد بشكل متناثر عبر الغابة",
 "straggly": "مُتَمَدِّدٌ بِتَفَرُّقٍ (يَنْمُو أَوْ يَنْتَشِرُ بِشَكْلٍ مُتَفَرِّقٍ أَوْ غَيْرِ مُنْتَظِمٍ) / مُتَرَامِي الأَطْرَاف, مُتَنَاثِر (يَمْتَدُّ فِي اتِّجَاهَاتٍ مُخْتَلِفَةٍ أَوْ مُوَزَّعٌ بِشَكْلٍ غَيْرِ مُنْتَظِم)",
 "straight": "مُسْتَقِيم (ما جُعِلَ قَائِمًا غير مُنْحَنٍ؛ ما ليس به عِوَج) / عَلَى طُول (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: إرسم خط مستقيم.",
 "straight ahead": "عَلَى طُول (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال.",
 "straight and narrow": "الصراط المستقيم, الطريق القويم (طريق السلوك الصحيح والصادق)\nمثال: علم أطفاله الالتزام الصارم بالطريق القويم",
 "straight angle": "زَاوِيَة مُسْتَقِيمَة",
 "straight arch": "قوس مستقيم, قوس مسطح (قوس ذو أحجار عقد داعمة متبادلة له ظهر وبطن أفقي مستقيم)",
 "straight arrow": "شخص مستقيم, نزيه (شخص صريح وصادق)",
 "straight chain": "سلسلة مستقيمة (سلسلة مفتوحة من الذرات ليس لها سلاسل جانبية)",
 "straight chair": "كرسي جانبي, كرسي مستقيم الظهر (كرسي بظهر مستقيم وبدون ذراعين)",
 "straight face": "وجه جاد (تعبير وجهي جاد لا يعطي أي دليل على الاهتمام أو التسلية)",
 "straight fairlead": "مجرى حبال مستقيم (نوع من مجاري الحبال يستخدم لتوجيه حبال المرساة)",
 "straight flush": "تسلسل منتظم, ستريت فلاش (يد بوكر تحتوي على بطاقات متتالية من نفس النقشة)",
 "straight flute": "مثقاب ذو تجويف مستقيم (مثقاب صخري بتجاويف مستقيمة)",
 "straight hang": "تعلق مستقيم (تعلق يُؤدى على الحلقات أو المتوازي والجسم منتصب والذراعان على الجانبين)",
 "straight life insurance": "تأمين مدى الحياة (تأمين على حياة المؤمن عليه بمبلغ ثابت بقسط محدد يُدفع كل عام بنفس المبلغ طوال عمر المؤمن عليه)",
 "straight line": "خط مستقيم (خط ترسمه نقطة تتحرك في اتجاه ثابت؛ خط انحناؤه صفر)\nمثال: أقصر مسافة بين نقطتين هي خط مستقيم",
 "straight man": "الممهد الكوميدي (مؤدٍ ذكر يلعب دور الشخصية الجادة الممهدة للمهرج أو الكوميدي)",
 "straight off": "الآن, حالاً (بدون تأخير أو تردد؛ بدون وقت فاصل)\nمثال: أجاب فوراً",
 "straight person": "غيري الجنس, مباين الجنس (شخص لديه ميول جنسية تجاه أشخاص من الجنس الآخر)",
 "straight pin": "دبوس مستقيم (دبوس يتكون من قطعة سلك قصيرة مستقيمة صلبة بطرف مدبب؛ يستخدم لتثبيت قطع القماش أو الورق معاً)",
 "straight poker": "ستريت بوكر (بوكر يحصل فيه كل لاعب على 5 أوراق مقلوبة ويتم الرهان دون سحب أي أوراق أخرى)",
 "straight razor": "موس حلاقة مستقيم (موس حلاقة بحافة قطع مستقيمة مطوية في علبة تشكل مقبضاً عند فتح الموس للاستخدام)",
 "straight shooter": "شخص مستقيم, نزيه (شخص صريح وصادق)",
 "straight sinus": "جيب مستقيم (جيب غير مزدوج للأم الجافية)",
 "straight thrust": "اندفاعة ((مبارزة) طعنة هجومية تتم بقدم واحدة للأمام والساق الخلفية مستقيمة وذراع السيف ممدودة للأمام)",
 "straight ticket": "تصويت القائمة الواحدة (بطاقة اقتراع يدلي بها ناخب يصوت لجميع مرشحي حزب واحد)",
 "straight up": "بِدُونِ ثَلْج ((في المشروبات الكحولية) يُحَرَّك أو يُخْلَط مع الثلج لكن يُقَدَّم بدونه)",
 "straight woman": "الممهدة الكوميدية (مؤدية أنثى تلعب دور الشخصية الجادة الممهدة للمهرج أو الكوميدي)",
 "straight-arm": "صد الخصم بالذراع ((كرة القدم الأمريكية) فعل صد المهاجم عن طريق إبقاء الذراع ممدودة بالكامل مع وضع اليد ضد الخصم)",
 "straight-arrow": "قَوِيم, مُسْتَقِيم السُّلُوك (أخلاقي ومستقيم وفقًا للأعراف التقليدية)",
 "straight-backed": "مُسْتَقِيم الظَّهْر (ذو ظهر مستقيم ومعتدل) / بقامة منتصبة, منتصباً (بأسلوب تكون فيه القامة منتصبة ومستقيمة الظهر)\nمثال: لا يزال الرجل العجوز يمشي منتصباً",
 "straight-billed": "مُسْتَقِيم المِنْقَار (ذو منقار مستقيم)",
 "straight-fluted drill": "مثقاب ذو تجويف مستقيم (مثقاب صخري بتجاويف مستقيمة)",
 "straight-from-the-shoulder": "صَرِيح, فَصِيح (يَتَّسِم بِالمُبَاشَرَة فِي الأُسْلُوب أَوِ الكَلَام؛ بِدُون مُوَارَبَة أَوْ تَهَرُّب)",
 "straight-grained": "مُسْتَقِيم الأَلْيَاف (عن الخشب؛ ذو ألياف تجري بشكل متوازٍ)",
 "straight-laced": "مُتَحَفِّظ بِإِفْرَاط, مُتَزَمِّت (مبالِغ في التمسّك باللياقة والتحفّظ)",
 "straight-legged": "مُسْتَقِيم السَّاقَيْن (ذو سَاقَيْن مُسْتَقيمَتَيْن)",
 "straight-line method": "طريقة القسط الثابت ((محاسبة) طريقة لحساب الإهلاك عن طريق أخذ مبلغ متساوٍ من تكلفة الأصل كمصروف لكل سنة من العمر الإنتاجي للأصل)",
 "straight-line method of depreciation": "طريقة القسط الثابت ((محاسبة) طريقة لحساب الإهلاك عن طريق أخذ مبلغ متساوٍ من تكلفة الأصل كمصروف لكل سنة من العمر الإنتاجي للأصل)",
 "straight-out": "صَرِيح, مُطْلَق (بلا تحفّظ أو استثناء)",
 "straightaway": "الآن, حالاً (بدون تأخير أو تردد؛ بدون وقت فاصل) / عَاجِل, فَوْرِيّ (يُنْجَز بِتَأْخِير قَلِيل أَوْ بِدُون تَأْخِير) / طريق مستقيم (قطاع مستقيم من طريق أو مضمار سباق)\nمثال: أجاب فوراً",
 "straightedge": "مِيزَان زِئْبَقِيّ (آلة تُوزن بها الأشياء ويُعْرف مِقْدارها؛ عَدْل)",
 "straighten": "اِسْتَقَامَ (أَقَامَ نفسه)",
 "straightener": "جهاز تمليس, مقوم (جهاز للتمليس أو التقويم)\nمثال: مملس الشعر",
 "straightforward": "صَرِيح, مُسْتَقِيم",
 "straightforwardly": "بشكل مباشر, بصراحة (بحزم وقناعة؛ بدون مساومة)\nمثال: وقف بصلابة من أجل الحرية الدينية والتسامح",
 "straightforwardness": "استقامة, تفرد (بدون نفاق) / صراحة, مباشرة (صفة المباشرة والوضوح التام)\nمثال: لا يمكن التشكيك في نزاهة دوافعه",
 "straightjacket": "سترة تقييد, قميص المجانين (رداء يشبه السترة يستخدم لربط الذراعين بإحكام ضد الجسم كوسيلة لتقييد شخص عنيف)",
 "straightlaced": "مُتَحَفِّظ بِإِفْرَاط, مُتَزَمِّت (مبالِغ في التمسّك باللياقة والتحفّظ)",
 "straightness": "غيرية جنسية (انجذاب جنسي (أو علاقات جنسية) لأشخاص من الجنس الآخر) / استقامة, حسن نية (امتلاك نوايا صادقة) / استقامة, مباشرة (صحة المسار نحو الهدف) / استقامة (الخلو من الانحناءات أو المنعطفات أو الزوايا)\nمثال: تصرف بحسن نية",
 "straightway": "مباشرة (في مسار مباشر) / فوراً, في الحال (على الفور)\nمثال: سقط مباشرة نحو الصخور في الأسفل",
 "strain": "سُلَالَة",
 "strain gage": "مقياس الانفعال (مقياس لقياس الانفعال في سطح ما)",
 "strain gauge": "مقياس الانفعال (مقياس لقياس الانفعال في سطح ما)",
 "strained": "مُتَكَلِّف, مُجْهَد (يناضل من أجل إحداث أثر أو انطباع) / قَسْرِيّ, مُتَكَلَّف (يفتقر إلى العفوية؛ غير طبيعي) / مُتَكَلَّف, مُجْهَد (يفتقر إلى السلاسة والطبيعية) / مُتَكَلَّف, مُجْهَد (يُظْهِرُ عَلَامَاتِ التَّوَتُّرِ الذِّهْنِيِّ وَالعَاطِفِيّ)",
 "strainer": "مِصْفَاة",
 "strainer vine": "لوف, ليفة (أي من عدة نباتات متسلقة حولية استوائية لها أزهار صفراء كبيرة وثمار صغيرة صالحة للأكل؛ تُزرع تجارياً للحصول على اللب الليفي المجفف للثمار الناضجة الذي…)",
 "straining": "إجهاد, توتر (مجهود مكثف أو عنيف) / تشويه, لوي الحقائق (فعل تشويه الشيء ليبدو وكأنه يعني شيئاً لم يكن يقصده) / شَاقّ, مُجْهِد (يُرهق إلى أقصى حدّ؛ يختبر قدرات التحمّل)",
 "strait": "مَضِيق, مُخْتَنَق (البَحْر حين يضيق لإقتراب البرَ من الجهتين)",
 "strait and narrow": "الصراط المستقيم, الطريق القويم (طريق السلوك الصحيح والصادق)\nمثال: علم أطفاله الالتزام الصارم بالطريق القويم",
 "strait of dover": "مَضِيق دُوْفَر (البَحْر حين يضيق لإقتراب البرَ من الجهتين)",
 "strait of gibraltar": "مَضِيق جَبَل طَارِق (البَحْر حين يضيق لإقتراب البرَ من الجهتين)",
 "strait of hormuz": "مَضِيق هُرْمُز (البَحْر حين يضيق لإقتراب البرَ من الجهتين)",
 "strait of magellan": "مَضِيق مَاجِلَان (البَحْر حين يضيق لإقتراب البرَ من الجهتين)",
 "strait of malacca": "مَضِيق مَلَقَا (البَحْر حين يضيق لإقتراب البرَ من الجهتين)",
 "strait of messina": "مَضِيْق مِسِّينَة (البَحْر حين يضيق لإقتراب البرَ من الجهتين)",
 "strait of sicily": "مَضِيْق صِقِلِّيَّة, مَضِيْق الوَطَن القِبْلِي (البَحْر حين يضيق لإقتراب البرَ من الجهتين)",
 "strait-laced": "مُتَحَفِّظ بِإِفْرَاط, مُتَزَمِّت (مبالِغ في التمسّك باللياقة والتحفّظ)",
 "straitjacket": "سترة تقييد, قميص المجانين (رداء يشبه السترة يستخدم لربط الذراعين بإحكام ضد الجسم كوسيلة لتقييد شخص عنيف) / قميص المجانين, قيد صارم (أي شيء غير مادي يعيق أو يقيد بشدة)\nمثال: انشقوا لأن الرقص الروسي كان في قيد صارم",
 "straitlaced": "مُتَحَفِّظ بِإِفْرَاط, مُتَزَمِّت (مبالِغ في التمسّك باللياقة والتحفّظ)",
 "straits": "مأزق, موقف حرج (مفترق طرق صعب أو موقف حرج) / ضيق, مأزق (وضع سيء أو صعب)\nمثال: مأزق جميل",
 "strake": "لوح جانبي (لوح سميك يشكل حافة على طول جانب سفينة خشبية)",
 "stralsund": "شترالزوند",
 "strand": "خيط, سلسلة (قلادة مصنوعة من ربط أشياء ببعضها) / جديلة, خصلة (خيط يتكون من مجموعة معقدة من الألياف أو الشعيرات المجدولة معاً لتشكيل خيط أو حبل أو كابل) / خيط (نمط يشكل وحدة داخل كل هيكلي أكبر) / ساحل, شاطئ (مصطلح شعري للشاطئ (كمنطقة تغطيها وتكشفها المد والجزر بشكل دوري))\nمثال: خيط من الخرز",
 "strand wolf": "ضبع بني (من جنوب أفريقيا)",
 "stranded": "مَحْصُور, مَعْزُول (مقطوع عن الآخرين أو متروك خلفهم)",
 "strange": "غَرِيب, عَجِيب / أَجْنَبِيّ, غَرِيب",
 "strange attractor": "جاذب غريب, جاذب فوضوي (جاذب يكون الاقتراب من نقطته النهائية في فضاء الطور فوضويًا)",
 "strange particle": "جُسَيْم غَرِيب (جسيم أولي ذو غرابة غير صفرية)",
 "strange quark": "كُوَارْك غَرِيب",
 "strangely": "بشكل عجيب, بغرابة (بطريقة غريبة)\nمثال: ورقة مكتوبة بغرابة",
 "strangeness": "غَرَابَة",
 "stranger": "غَرِيب, غَرِيبَة / أَجْنَبِيّ",
 "strangle": "خَنَقَ (خَنَقَ (خنقه) خنقا: عصر حلقه حتى مات؛ خَنَقَ الوقت: أخره وضيقه)\nمثال: خنق زيري وليد بعمامته.",
 "strangled": "مَخْنُوق, مَقْمُوع (مُحتبَس بصعوبة ومُسيطَر عليه بالكاد)",
 "stranglehold": "مسكة خنق (مسكة مصارعة تضغط فيها الذراعان على القصبة الهوائية للخصم) / إحكام القبضة, خناق (السلطة الكاملة على شخص أو موقف)\nمثال: تملك الشركات قبضة خانقة على وسائل الإعلام",
 "strangler": "خانِق (شخص يقتل عن طريق الخنق) / شجرة خانقة, نبات خانق (نبات متسلق هوائي أو شجرة تمتد جذورها الهوائية أسفل جذع الشجرة الداعمة وتلتحم حولها لتخنق الشجرة في النهاية)",
 "strangler fig": "تفاح القطران, تين خانق (كلوزيا أمريكية استوائية شائعة لها أزهار بيضاء أو وردية منعزلة) / تين خانق, تين ذهبي (شجرة خانقة موطنها جنوب فلوريدا وجزر الهند الغربية؛ تبدأ كنبات هوائي وتطور في النهاية العديد من الجذور الهوائية السميكة وتغطي مساحات هائلة)",
 "strangler tree": "شجرة خانقة, نبات خانق (نبات متسلق هوائي أو شجرة تمتد جذورها الهوائية أسفل جذع الشجرة الداعمة وتلتحم حولها لتخنق الشجرة في النهاية)",
 "strangling": "خنق (فعل خنق (شخص ما) عن طريق الضغط على القصبة الهوائية)\nمثال: لا يوجد دليل على أن الخنق تم بواسطة المتهم",
 "strangulation": "خنق (فعل خنق (شخص ما) عن طريق الضغط على القصبة الهوائية) / اختناق, انحباس ((علم الأمراض) انقباض جزء من الجسم بحيث يقطع تدفق الدم أو السوائل الأخرى) / اختناق, خنق (حالة توقف التنفس عن طريق ضغط ممر الهواء)\nمثال: لا يوجد دليل على أن الخنق تم بواسطة المتهم",
 "strap": "رِبَاط",
 "strap fern": "سرخس الحزام (سرخس بأوراق طويلة ضيقة تشبه الحزام)",
 "strap hinge": "مفصلة شريطية (مفصلة ذات شريطين طويلين؛ يتم تثبيت أحدهما على سطح الجزء المتحرك (مثل باب أو غطاء) والآخر على الإطار الثابت المجاور)",
 "strapado": "تعليق من الخلف, سترابادو (شكل من أشكال التعذيب حيث تُربط يدا الشخص خلف ظهره ويُرفع عن الأرض بحبل مربوط بمعصميه، ثم يُترك ليسقط حتى يتم وقف سقوطه فجأة بواسطة الحبل)",
 "straphanger": "راكب واقف (راكب واقف في مترو الأنفاق أو الحافلة يمسك بحزام معلق للدعم) / راكب المواصلات العامة (مسافر يومي يستخدم وسائل النقل العام)",
 "strapless": "بِلَا أَشْرِطَة, بِلَا حَمَّالَات (ليس له أشرطة أو حمالات) / فستان بلا حمالات (رداء نسائي يكشف الكتفين وليس له حمالات كتف)",
 "straplike": "شَرِيطِيّ الشَّكْل (طويل وضيّق كالشريط)",
 "strapline": "شعار, عنوان تمهيدي (عنوان ثانوي، خاصة الذي يطبع فوق آخر)",
 "strappado": "تعليق من الخلف, سترابادو (شكل من أشكال التعذيب حيث تُربط يدا الشخص خلف ظهره ويُرفع عن الأرض بحبل مربوط بمعصميه، ثم يُترك ليسقط حتى يتم وقف سقوطه فجأة بواسطة الحبل)",
 "strapper": "ثور, رجل قوي (رجل ضخم وقوي وثقيل الوزن)\nمثال: كان رجلاً كالثور",
 "strapping": "ضَخْمُ البِنْيَة, مَفْتُول (عضليّ وثقيل البنية)",
 "strasbourg": "سْتْرَاسْبُورْغ",
 "stratagem": "حيلة, مناورة (مناورة في لعبة أو محادثة) / حيلة, خديعة (مخطط مفصل أو خادع تم تدبيره للخداع أو التهرب)\nمثال: كانت شهادته مجرد حيلة لإبعادنا عن المسار",
 "strategian": "استراتيجي, خبير استراتيجي (خبير في الاستراتيجية (خاصة في الحرب))",
 "strategic": "إِسْتِرَاتِيجِيّ",
 "strategic buyout": "استحواذ استراتيجي (استحواذ يعتمد على تحليل فوائد الدمج تحسباً لزيادة القوة الكسبية)",
 "strategic intelligence": "استخبارات استراتيجية (الاستخبارات المطلوبة لتشكيل السياسات والخطط العسكرية على المستويين الوطني والدولي)",
 "strategic warning": "تحذير استراتيجي ((عسكري) تحذير قبل بدء عمل عدائي)",
 "strategical": "استراتيجي (يتعلق بالاستراتيجية أو معني بها)\nمثال: سلاح استراتيجي",
 "strategically": "استراتيجياً (فيما يتعلق بالاستراتيجية)\nمثال: قرارات هامة استراتيجياً",
 "strategics": "علم الاستراتيجية (علم أو فن الاستراتيجية)",
 "strategist": "استراتيجي, خبير استراتيجي (خبير في الاستراتيجية (خاصة في الحرب))",
 "strategy": "إِسْتْرَاتِيجِيَّة (الإستراتيجية فن وعلم وضع خُطط الحرب وإدارة العمليَّات الحربيَّة: إستراتيجيَّة القوَّات المسلَّحة؛ خُطَّة شاملة في أي مجال من المجالات: وضعت الحكومة إستراتيجيَّة مستقبليَّة للنهوض بالاقتصاد القوميّ)\nمثال: ستحمي روسيا مصالحها الإستراتيجية كما تفعل الولايات المتحدة.",
 "stratification": "تنضيد (وضع البذور في رمل رطب أو نشارة خشب لحفظها أو تعزيز الإنبات) / تراصف, تطبقات (فعل أو عملية ترتيب الأشخاص في طبقات أو شرائح اجتماعية) / تطبق (تكوين طبقي) / ترسب طبقي, تطبّق (التشكيل أو الترسيب في طبقات)",
 "stratified": "طَبَقِيّ, مُرَسَّب (مترسب أو مرتب في طبقات أفقية) / طَبَقِيّ, مُتَرَاتِب ((للمجتمع) ذو تراتبيَّة اجتماعيَّة طبقيَّة) / مُدَرَّج, مُرَتَّب (منظَّم في تسلسل من الدرجات أو الرُّتَب)\nمثال: صخور طبقية",
 "stratified language": "لغة طبقية, لغة مصنفة (لغة لا يمكن استخدامها كلغة واصفة لنفسها)",
 "stratified sample": "عينة طبقية, عينة ممثلة (يتم تقسيم المجتمع إلى طبقات ويتم أخذ عينة عشوائية من كل طبقة)",
 "stratified sampling": "أخذ عينات طبقي (تقسيم المجتمع الإحصائي إلى طبقات وأخذ عينات عشوائية من كل طبقة)",
 "stratigraphy": "علم الطبقات (فرع الجيولوجيا الذي يدرس ترتيب وتتابع الطبقات الصخرية)",
 "stratocracy": "حكم عسكري, حكومة عسكرية (الحكم بواسطة الجيش والقوات المسلحة)",
 "stratosphere": "سْتْرَاتُوسْفِير",
 "stratum": "طبقة (مجموعة فرعية مقسمة في عينة طبقية) / طبقة, مستوى (مكان مجرد يُتصور عادةً أن له عمقاً) / طبقة, طبقة اجتماعية (مجموعة من الناس لديهم نفس الوضع الاجتماعي أو الاقتصادي أو التعليمي) / طبقة (واحدة من عدة طبقات متوازية من المواد مرتبة واحدة فوق الأخرى (مثل طبقة من الأنسجة أو الخلايا في كائن حي أو طبقة من الصخور الرسوبية))\nمثال: الممثل الجيد يتواصل على عدة مستويات",
 "stratum basale": "طبقة قاعدية, طبقة نامية (الطبقة الداخلية للبشرة)",
 "stratum corneum": "طبقة قرنية, طبقة متقرنة (الطبقة الخارجية من البشرة وتتكون من خلايا ميتة تتساقط)",
