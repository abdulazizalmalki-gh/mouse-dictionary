 "styler": "حلاق, مصفف شعر (شخص يقص أو يجمل الشعر)",
 "stylet": "قلم, مرود (زائدة صغيرة تشبه الإبرة؛ خاصة عضو التغذية في بطيئات المشية)",
 "styling": "تصفيف, هندمة (فعل تصفيف الشعر)",
 "stylisation": "أسلوبية, تنميط (فعل التنميط؛ الجعل مطابقاً لأسلوب معين)",
 "stylised": "مُؤَسْلَب, مُنَمَّط (يستخدم أشكالًا وأعرافًا فنية لخلق تأثيرات؛ غير طبيعي أو تلقائي)",
 "stylish": "أنيق, عصري (كائن أو متوافق مع الموضات الاجتماعية الحالية) / أنيق, عصري (لديه أناقة أو ذوق أو رقي في الأخلاق أو الملبس)\nمثال: ملابس عصرية",
 "stylishly": "بأناقة (بطريقة أنيقة)\nمثال: كانت ترتدي ملابس أنيقة جداً",
 "stylishness": "أَنَاقَة عَصْرِيَّة, شِيَاكَة (الأناقة بحكم مسايرة الموضة)",
 "stylist": "حلاق, مصفف شعر (شخص يقص أو يجمل الشعر) / فنان أسلوب, مصفف (فنان يتقن أسلوباً معيناً)",
 "stylistic": "أُسْلُوبِيّ (يتعلّق بالأسلوب (خاصة في استخدام اللغة))",
 "stylistically": "أسلوبياً (بطريقة أسلوبية بلاغية)\nمثال: معقد أسلوبياً",
 "stylite": "عامودي (ناسك مسيحي مبكر عاش على قمة أعمدة عالية)",
 "stylization": "أسلوبية, تنميط (فعل التنميط؛ الجعل مطابقاً لأسلوب معين)",
 "stylized": "مُؤَسْلَب, مُنَمَّط (يستخدم أشكالًا وأعرافًا فنية لخلق تأثيرات؛ غير طبيعي أو تلقائي)",
 "styloid process": "نتوء إبري (يمتد من قاعدة العظم الصدغي)",
 "stylomastoid vein": "وريد إبري خشائي (وريد يصرف التجويف الطبلي ويصب في الوريد خلف الفك السفلي)",
 "stylomecon heterophyllum": "خشخاش الرياح, خشخاش ملتهب (خشخاش بري في كاليفورنيا بزهور حمراء زاهية)",
 "stylophorum diphyllum": "خشخاش الغابة, خشخاش عروق الصباغين (عشبة معمرة موطنها غابات شرق الولايات المتحدة ذات زهور صفراء)",
 "stylopodium": "وسادة القلم (تضخم عند قاعدة القلم في بعض نباتات الفصيلة الخيمية)",
 "stylostixis": "وخز بالإبر (علاج الألم أو المرض عن طريق إدخال أطراف الإبر في نقاط محددة على الجلد)",
 "stylus": "إبرة نقش, قلم (أداة مدببة للكتابة أو الرسم أو النقش) / إبرة التسجيل, إبرة الفونوغراف (جهاز مدبب حاد متصل بخرطوشة مشغل الأسطوانات)\nمثال: رسم التصميم على الاستنسل بقلم فولاذي",
 "stylus printer": "طابعة نقطية (طابعة تصادمية يتم فيها تمثيل كل حرف بنمط من النقاط بواسطة أسلاك أو إبر)",
 "stymie": "عقبة كأداء, وضع معرقل (وضع محبط ومؤلم) / إعاقة, ستيمي (وضع في الغولف تعيق فيه كرة الخصم الخط بين كرتك والحفرة)",
 "stymy": "عقبة كأداء, وضع معرقل (وضع محبط ومؤلم) / إعاقة, ستيمي (وضع في الغولف تعيق فيه كرة الخصم الخط بين كرتك والحفرة)",
 "styphelia humifusum": "توت الأرض, توت بري أصلي (شجيرة صغيرة منبطحة أو صاعدة ذات أزهار قرمزية وثمار عصارية تشبه التوت البري)",
 "styphelia triflora": "خماسية الزوايا الوردية (شجيرة تشبه الخلنج من جنوب غرب أستراليا تزرع لأوراقها ذات الرائحة الحادة وأزهارها الوردية التي تليها ثمار خماسية الأضلاع)",
