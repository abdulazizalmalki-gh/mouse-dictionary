 "storage tank": "خزان, صهريج (وعاء كبير (معدني عادة) لحفظ الغازات أو السوائل)",
 "storage warehouse": "مستودع بضائع (مستودع للبضائع والسلع)",
 "storage-battery grid": "شبكة البطارية (لوحة معدنية مثقبة أو مموجة تستخدم في بطارية التخزين كموصل ودعم للمادة النشطة)",
 "storax": "أَصْطَرَك, أَسْطَرَك",
 "store": "خَزَنَ (حفظ، إدخر، أودع في مخزن)",
 "store cheese": "جبن المتجر (أسماء غير رسمية للشيدر الأمريكي)",
 "store detective": "مخبر المتجر (محقّق خاص يوظفه تاجر لمنع السرقات البسيطة)",
 "store-bought": "مُشْتَرًى مِنَ المَتْجَرِ (مشترى وليس مصنوعاً في المنزل)",
 "stored program": "برنامج مخزن (برنامج يتم تخزينه في ذاكرة الحاسوب الذي ينفذه)",
 "stored-program": "مخزن البرنامج (من أو متعلق بالبرامج المخزنة في ذاكرة الحاسوب الخاصة)",
 "storefront": "واجهة المتجر (الجانب الأمامي لمتجر يواجه الشارع؛ يحتوي عادة على نوافذ عرض)",
 "storehouse": "مخزن, مستودع (مستودع للبضائع)\nمثال: بُنيت المستودعات بالقرب من الأرصفة",
 "storekeeper": "صاحب دكان, صاحب متجر (تاجر يمتلك أو يدير متجراً)",
 "storeria occipitamaculata": "ثعبان أحمر البطن (ثعبان غابات غير ضار من جنوب شرق الولايات المتحدة)",
 "storeroom": "غرفة تخزين, مخزن (غرفة تُخزن فيها الأشياء)",
 "storey": "طَابَق, دَوْر",
 "storeyed": "ذُو طَوَابِق (له طوابق بحسب ما هو محدَّد)",
 "storge": "حب أسري (الزرع، كبيرا كان أم صغيرا؛ بَذْرُ الزرع)\nمثال: زيري بحب المال.",
