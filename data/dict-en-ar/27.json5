 "steeper": "وعاء نقع (وعاء (عادة قدر أو حوض) يستخدم للنقع)",
 "steepish": "مُنْحَدِر نَوْعًا مَا (حاد الانحدار إلى حد ما)",
 "steeple": "برج مستدق, قمة البرج (برج طويل يشكل البنية الفوقية لمبنى (عادة كنيسة أو معبد) ويضيق حتى يصل إلى نقطة في الأعلى)",
 "steeplechase": "سباق قفز الموانع (سباق خيل عبر مضمار مليء بالعوائق) / سباق الموانع (سباق جري عادة لمسافة 3000 متر عبر مضمار مغلق مع حواجز وقفزة مائية)",
 "steeplechaser": "حصان سباق الحواجز (حصان مدرب للركض في سباقات الحواجز)",
 "steeplejack": "متسلق الأبراج (شخص يبني أو يصون الهياكل العالية جداً)",
 "steeply": "بانحدار شديد (بطريقة شديدة الانحدار)\nمثال: ارتفع الشارع بانحدار شديد نحو القلعة",
 "steepness": "اِنْحِدَار شَدِيد, شِدَّة الانْحِدَار (الخاصية التي يمتلكها منحدر شديد الانحدار)",
 "steer": "قَادَ / ثَوْر (حُمْرَة الشفق الثائرة فيه؛ الطُحْلُب وما أشبهه فوق الماء. سميّ كذلك لأنه يثور فجأة)\nمثال: حرث ما حرث الثور.",
 "steer roping": "صيد الثيران بالحبل (إمساك ثور بحبل)",
 "steerable": "قَابِلٌ لِلتَّوْجِيه (يمكن توجيهه أو قيادته)",
 "steerage": "توجيه السفينة (فعل توجيه السفينة) / درجة أدنى (أرخص أماكن الإقامة على متن سفينة ركاب)",
 "steerageway": "سُرْعَة المُنَاوَرَة ((ملاحة) الحد الأدنى لمعدل الحركة اللازم للسفينة لكي تتمكن من المناورة)",
 "steerer": "طُعم, مستدرج (مخادع يقود شخصاً ما إلى الخطر (عادة كجزء من مؤامرة)) / عامل التوجيه, موجّه (شخص يوجه السفينة)",
 "steering": "توجيه السفينة (فعل توجيه السفينة) / توجيه, قيادة (فعل تحديد المسار والحفاظ عليه) / إرشاد, توجيه (فعل التوجيه أو إظهار الطريق)\nمثال: تم تنصيب مجلس جديد بتوجيه من الملك",
 "steering committee": "لجنة توجيهية (لجنة لترتيب جدول أعمال هيئة (تشريعية) أكبر)",
 "steering gear": "ترس التوجيه (ترس يربط عجلة القيادة بوصلة التوجيه لمركبة آلية)",
 "steering linkage": "وصلة توجيه (آلية تتكون من نظام من القضبان والرافعات المتصلة بالعجلات الأمامية لمركبة آلية؛ يدفعها ترس التوجيه لليسار أو اليمين مما يؤدي إلى دوران العجلات…)",
 "steering mechanism": "آلية توجيه, نظام توجيه (آلية يتم من خلالها توجيه شيء ما (خاصة مركبة آلية))",
 "steering system": "آلية توجيه, نظام توجيه (آلية يتم من خلالها توجيه شيء ما (خاصة مركبة آلية))",
 "steering wheel": "مِقْوَد, عَجَلَةُ الْقِيَادَةِ (الآلَة التي تستخدم للتحكم في اتجاه حركة السَيَّارَة وغيرها من المَرْكَبَات عموماً، وهو عادةً مُسْتَدِير الشكل)\nمثال: لاحظت ليلى دما يقطر من مقود سيارة سامي.",
 "steersman": "ربان, موجه الدفة (رجل يوجه السفينة)",
 "steerswoman": "ربانة, موجهة الدفة (امرأة توجه السفينة)",
 "steganography": "تشفير, تعمية (فعل الكتابة برمز أو شفرة)",
 "steganopus tricolor": "فلروب ويلسون (يتكاثر في السهول الكبرى الشمالية لكندا)",
 "stegosaur": "ستيغوصور (ديناصور عاشب من رتبة طيريات الورك، يتميز بصف من الصفائح العظمية على ظهره وذيل شائك يُحتمل أنه استخدم كسلاح)",
 "stegosaurus": "ستيغوصور (ديناصور عاشب من رتبة طيريات الورك، يتميز بصف من الصفائح العظمية على ظهره وذيل شائك يُحتمل أنه استخدم كسلاح)",
 "stegosaurus stenops": "ستيغوصور (ديناصور عاشب من رتبة طيريات الورك، يتميز بصف من الصفائح العظمية على ظهره وذيل شائك يُحتمل أنه استخدم كسلاح)",
 "stein": "كوب بيرة (كوب مخصص لتقديم البيرة)",
 "steinbok": "ستينبوك (ظبي سهول صغير في جنوب شرق أفريقيا)",
 "steinert's disease": "حثل عضلي توتري (شكل حاد من الحثل العضلي يتميز بضعف عام وهزال عضلي يؤثر على الوجه والقدمين واليدين والرقبة؛ وصعوبة في الكلام وصعوبة في اليدين تمتد إلى الذراعين…)",
 "stela": "لوح حجري, مسلة (لوح حجري قديم منتصب يحمل نقوشاً)",
 "stele": "لَوْحَة تِذْكَارِيَّة",
 "stelis": "ستيليس (أي من بساتين الفاكهة الأمريكية الاستوائية الصغيرة المختلفة من جنس ستيليس ذات عناقيد نحيلة طويلة من الزهور الصغيرة إلى الدقيقة العديدة)",
 "stellar": "نَجْمِيّ",
 "stellar association": "تجمع نجمي (تجمع كبير وفضفاض للنجوم من نوع طيفي مماثل وأصل حديث نسبياً)",
 "stellar parallax": "تزيح نجمي (التزيح شمسي المركز لنجم)",
 "stellar wind": "رِيح نَجْمِيَّة",
 "stellar's sea eagle": "عقاب البحر ستيلر (يوجد على سواحل شمال غرب المحيط الهادئ)",
 "stellaria holostea": "حشيشة القزاز الكبرى (عشبة منخفضة النمو في المنطقة المعتدلة الشمالية ذات أزهار بيضاء صغيرة على شكل نجمة؛ سميت لقدرتها المزعومة على تخفيف الآلام الحادة في الجانب)",
 "stellaria media": "حشيشة القزاز, عشبة الطيور الشائعة (عشبة ضارة حولية شائعة منخفضة النمو في الحدائق ذات أزهار بيضاء صغيرة؛ عالمية الانتشار؛ سميت كذلك لأن الدجاج يأكلها)",
 "stellate": "شُعَاعِيّ, نَجْمِيّ (مُرتَّب كالأشعة؛ ينبثق من مركز مشترك)",
 "stellate venule": "وريد نجمي (مجموعة نجمية الشكل من الأوردة الدقيقة في قشرة الكلية)",
 "steller sea lion": "أسد البحر ستيلر (أكبر أسود البحر؛ يعيش في شمال المحيط الهادئ)",
 "steller's sea cow": "بقر البحر ستيلر (ثديي خيلاني ضخم منقرض كان يوجد سابقاً بالقرب من الساحل الآسيوي لبحر بيرينغ)",
 "steller's sea lion": "أسد البحر ستيلر (أكبر أسود البحر؛ يعيش في شمال المحيط الهادئ)",
 "stellion": "حِرْذَوْن",
 "stellite": "ستالايت (سبيكة صلبة جداً من الكوبالت والكروم حيث الكوبالت هو المكون الرئيسي؛ تستخدم لصنع أدوات القطع والأسطح المعرضة للاحتكاك الشديد)",
 "stem": "سَاق نَبَات / أَصْل (جعله أصيلًا أو ثابت الجذور؛ أي عَمَّق وأحكم أصوله؛ نسب شيئًا إلى أصله أو وضّح جذوره)\nمثال: أخشى أن أصل متأخرا.",
 "stem blight": "لفحة الساق (لفحة فطرية تهاجم سيقان النباتات)",
 "stem canker": "البطاطس الصغيرة, تقرح الساق (مرض الريزوكتونيا الذي يصيب البطاطس)",
 "stem cell": "خَلِيَّة جِذْعِيَّة",
 "stem ginger": "زنجبيل, زنجبيل شائع (نبات آسيوي استوائي يزرع على نطاق واسع لجذره اللاذع؛ مصدر لجذر الزنجبيل والزنجبيل المسحوق)",
 "stem lettuce": "خس الساق, خس الهليون (خس يقدر خاصة لسيقانه الصالحة للأكل)",
 "stem turn": "دوران بالجذع (دوران يتم في التزلج؛ يتم دفع الجزء الخلفي من إحدى الزلاجات للخارج ويتم جلب الزلاجة الأخرى لتوازيها)",
 "stem vowel": "حركة الجذر (حركة تنهي الجذر وتسبق التصريف)",
 "stem-cell research": "أبحاث الخلايا الجذعية (البحث في الخلايا الجذعية واستخدامها في الطب)",
 "stem-winder": "ساعة تعبئة يدوية (ساعة يتم تعبئتها (ملؤها) بتدوير مقبض عند الساق)",
 "stemless": "عَدِيم السَّاق ((للنباتات) ليس لديها ساق ظاهرة فوق الأرض) / بلا ساق (ليس له ساق)\nمثال: أواني زجاجية بلا سيقان",
 "stemless carline thistle": "أداد عديم الساق (نبات معمر عديم الساق له زهور كبيرة بزهيرات بيضاء أو بنية أرجوانية متداخلة في وردة من أوراق شوكية طويلة مشعرة من الأسفل؛ يتواجد في المناطق الألبية…)",
 "stemless daisy": "أقحوان الفصح, أقحوان عديم الساق (عشب قزم متكتل يكاد يكون عديم الساق له وردة من أوراق صوفية ورؤوس زهور كبيرة بيضاء الأشعة؛ وسط كندا والولايات المتحدة غرباً إلى أريزونا)",
 "stemless golden weed": "عشب ذهبي عديم الساق (عشب قائم أخضر داكن في شمال غرب الولايات المتحدة وجنوب غرب كندا له أوراق صلبة في خصلات كثيفة ورؤوس زهرية صفراء؛ يوضع أحياناً في جنس هابلوبابوس)",
 "stemless hymenoxys": "هيمينوكسيس عديم الساق (نبات معمر له أوراق قاعدية معنقدة وسيقان قصيرة خالية من الأوراق تحمل كل منها رأس زهرة صفراء وحيدة؛ سفوح التلال الجافة وسهول غرب وسط أمريكا الشمالية)",
 "stemma": "عين بسيطة, عيينة (عين لها عدسة واحدة) / أصل, سلالة (الاشتقاق الوراثي للفرد) / مخطط النسب (مخطط شجري يظهر إعادة بناء انتقال مخطوطات عمل أدبي)\nمثال: كل سلالته كانت محاربين",
 "stemmatic": "شجري, نسب نصي (مكون من أو متعلق بشجرة نسب المخطوطات)",
 "stemmatics": "ستيماتولوجيا, علم الأصول النصية (التخصص الإنساني الذي يحاول إعادة بناء نقل النص (خاصة النص في شكل مخطوطة) على أساس العلاقات بين مختلف المخطوطات الباقية)",
 "stemmatology": "ستيماتولوجيا, علم الأصول النصية (التخصص الإنساني الذي يحاول إعادة بناء نقل النص (خاصة النص في شكل مخطوطة) على أساس العلاقات بين مختلف المخطوطات الباقية)",
 "stemmed": "ذُو سَاق, سَاقِيّ ((للنباتات) تنتج ساقاً متطورة فوق الأرض) / ذو ساق, مُعنَّق (له ساق أو سيقان أو ساق كما هو محدد؛ غالبًا ما تستخدم في المركبات) / مَنْزُوع السَّاق, مُجَرَّد مِن السَّاق (أُزيلَت منه الساق)\nمثال: كؤوس ذات سيقان",
 "stemmer": "نازع السيقان (جهاز لإزالة السيقان من الفاكهة (مثل العنب أو التفاح)) / مِدَكّ الحشوة (قضيب دك يستخدمه عمال المناجم لدك الحشوة فوق شحنة التفجير) / خوارزمية التجذير (خوارزمية لإزالة النهايات التصريفية والاشتقاقية لتقليل أشكال الكلمات إلى جذر مشترك) / صانع السيقان (عامل يصنع أو يضيف سيقاناً للزهور الاصطناعية)",
 "stemming algorithm": "خوارزمية التجذير (خوارزمية لإزالة النهايات التصريفية والاشتقاقية لتقليل أشكال الكلمات إلى جذر مشترك)",
 "sten gun": "رشاش ستين (رشاش خفيف الوزن بريطاني الصنع)",
 "stench": "نَتَانَة",
 "stench bomb": "قنبلة نتنة (قنبلة صغيرة مصممة لإطلاق رائحة كريهة عند انفجارها)",
 "stench trap": "مِصْيَدَة مَائِيَّة",
 "stencil": "رَوْسَم",
 "stenocarpus salignus": "خشب البقر المقشر (شجرة أو شجيرة طويلة ذات أوراق لامعة وخيمات من الزهور البيضاء الكريمية العطرة؛ تنتج خشباً محمراً ثقيلاً صلباً)",
 "stenocarpus sinuatus": "شجرة العجلة, شجرة عجلة النار (شجرة من شرق أستراليا تزرع على نطاق واسع كشجرة ظل ولأوراقها اللامعة وعناقيدها الدائرية من الزهور الحمراء إلى البرتقالية القرمزية المبهرجة)",
 "stenograph": "آلة الاختزال (آلة لكتابة أحرف الاختزال) / رمز اختزال, ستينوغراف (حرف من حروف الاختزال)",
 "stenographer": "كاتب اختزال (شخص ماهر في نسخ الكلام (خاصة الإملاء))",
 "stenographic": "اِخْتِزَالِيّ",
 "stenographical": "اختزالي (مكون من أو متعلق بـ أو يستخدم الكتابة الاختزالية)",
 "stenography": "اختزال, كتابة مختزلة (فن الكتابة بالاختزال) / اختزال, كتابة مختزلة (طريقة للكتابة بسرعة باستخدام نظام رمزي مختصر)",
 "stenopelmatus fuscus": "صرصور الرمل, صرصور القدس (جندب ليلي كبير عديم الأجنحة يحفر في التربة الرخوة على طول ساحل المحيط الهادئ للولايات المتحدة)",
 "stenopterygius": "ستينوبتريجيوس (عظاية سمكية من جنس ستينوبتريجيوس)",
 "stenopterygius quadrisicissus": "ستينوبتريجيوس (عظاية سمكية من جنس ستينوبتريجيوس)",
 "stenosed": "مُتَضَيِّق, مُتَقَلِّص (قَناة أَوْ مَمَرّ جِسْمِيّ مُتَضَيِّق بِشَكْل غَيْر طَبيعِيّ)",
 "stenosis": "تَضَيُّق",
 "stenotaphrum secundatum": "عشب القديس أوغسطين (عشب منخفض يشكل حصيرة من جنوب الولايات المتحدة وأمريكا الاستوائية؛ يُزرع كعشب للمروج)",
 "stenotic": "مُتَضَيِّق, مُتَقَلِّص (قَناة أَوْ مَمَرّ جِسْمِيّ مُتَضَيِّق بِشَكْل غَيْر طَبيعِيّ)",
 "stenotomus aculeatus": "سكوب, مرجان جنوبي (مرجان المياه الساحلية الأطلسية الجنوبية لأمريكا الشمالية)",
 "stenotomus chrysops": "سكوب, مرجان شمالي (توجد في المياه الساحلية الأطلسية لأمريكا الشمالية من كارولينا الجنوبية إلى ماين؛ تُقدر كسمكة مقلاة)",
 "stenotus acaulis": "عشب ذهبي عديم الساق (عشب قائم أخضر داكن في شمال غرب الولايات المتحدة وجنوب غرب كندا له أوراق صلبة في خصلات كثيفة ورؤوس زهرية صفراء؛ يوضع أحياناً في جنس هابلوبابوس)",
 "stent": "دعامة (أنبوب رفيع يُدخل داخل جزء أنبوبي من الجسم (مثل وعاء دموي) لتوفير الدعم أثناء وبعد المفاغرة الجراحية)",
 "stentor": "بوقية, ستنتور (أي من عدة أوالي هدبية بوقية الشكل تنتمي إلى جنس ستنتور) / جهوري الصوت (متحدث بصوت عالٍ بشكل غير عادي)",
 "stentorian": "جَهْوَرِيّ, مُجَلْجِل ((للصوت) عميق ورنّان)",
 "step": "خُطْوَة, خَطْوَة / خَطْوَة / قِيَافَة, مِشْيَة",
 "step by step": "خُطْوَةً خُطْوَةً, خُطْوَةً بِخُطْوَةٍ",
 "step dancing": "رقص النقر بالقدمين (الرقص الذي تكون فيه الخطوات أكثر أهمية من الإيماءات أو الوضعيات)",
 "step ladder": "سلم مزدوج, سلم نقال (سلم محمول قابل للطي بمفصلات في الأعلى)",
 "step rocket": "صاروخ متعدد المراحل (صاروخ يحتوي على محركين صاروخيين أو أكثر (لكل منهما وقوده الخاص) يتم إشعالها بالتتابع والتخلص منها عند استنفاد الوقود)",
 "step stool": "سلم درج, كرسي سلمي (كرسي يحتوي على درجة أو درجتين تطوى تحت المقعد)",
 "step-by-step": "تَدْرِيجِيًّا, خُطْوَة بِخُطْوَة (شيء واحد في كل مرة؛ على مراحل صغيرة)",
 "step-down": "تخفيض, تقليل (عملية إنقاص أو تقليل شيء ما)",
 "step-down transformer": "محول خفض الجهد (محول يقلل الجهد)",
 "step-in": "سروال داخلي نسائي (سراويل داخلية قصيرة للنساء أو الأطفال)",
 "step-up": "رفع, زيادة (عملية زيادة شيء ما)\nمثال: أعطاني زيادة في الراتب",
 "step-up transformer": "محول رفع الجهد (محول يزيد الجهد)",
 "stepanakert": "سْيِتبَانَاكِيرت",
 "stepbrother": "أخ غير شقيق (أخ يشترك معك في أحد الوالدين فقط)",
 "stepchild": "ابن الزوج, ابن الزوجة (طفل زوجك من زواج سابق)",
 "stepdaughter": "رَبِيبَة",
 "stepfather": "زَوْجُ ٱلْأُمّ, أَب رَبِيب (زَوَّجَ الأَشياءَ تَزْويجًا، وزَواجًا: قرن بعضَها ببعض؛ زَوَّجَ فلانًا امرأةً، وبها: جعله يتزوَجَها)\nمثال: زوجة ماري طبيبة.",
 "stephanion": "ستيفانيون (نقطة قياس القحف على الدرز الإكليلي فوق الصماخ السمعي)",
 "stephanomeria malheurensis": "خس سلكي (نبات صغير من أوريغون يشبه الخردل؛ نوع مهدد بالانقراض)",
 "stephanotis": "ستيفانوتيس, ياسمين مدغشقر (أي من شجيرات التسلق دائمة الخضرة المتنوعة من جنس ستيفانوتيس لها زهور شمعية عطرة)",
 "stephanotis floribunda": "زهرة الشمع, ياسمين مدغشقر (كرمة خشبية ملتفة في مدغشقر ذات أوراق دائمة الخضرة شمعية داكنة سميكة وعناقيد من الزهور البيضاء الشمعية العطرة الكبيرة على طول السيقان؛ تزرع على نطاق…)",
 "stephead": "عنوان متدرج (عنوان رئيسي يكون سطره العلوي محاذياً لليسار والأسطور التالية مزاحة لليمين)",
 "stephen": "إِسْطِفَانُوس, اِسْتِفَانُوس",
 "stepladder": "سلم مزدوج, سلم نقال (سلم محمول قابل للطي بمفصلات في الأعلى)",
 "stepmother": "زَوْجَةُ الْأَب / رَابَّة",
 "stepparent": "زوج الأم, زوجة الأب (زوج والدك أو زوجة والدك من زواج لاحق)",
 "steppe": "مَرْعَى, سْتِيب",
 "steppe eagle": "عُقَاب سُهُول (طَيْر من الجَوَارِح، أكبر التي تصيد منها يكنى بأبي الهَيْثَم ومعروف بحِدَّة البصر؛ حَجَر ناتئ في جَوْف البِئْر يخرق الدَلُو. ونادر)\nمثال: هو من تلقى العقاب الأكبر.",
 "stepped line": "عنوان متدرج (عنوان رئيسي يكون سطره العلوي محاذياً لليسار والأسطور التالية مزاحة لليمين)",
 "stepper": "حصان عالي الخطوة (حصان مدرب على رفع قدميه عالياً عن الأرض أثناء المشي أو الخبب) / محرك خطوي (محرك (خاصة محرك كهربائي) يتحرك أو يدور في خطوات منفصلة صغيرة) / راقص محترف (راقص محترف (غالباً ما يستخدم لراقصي النقر أو الاستعراض))",
 "stepping down": "تنازل عن العرش (فعل التنازل عن العرش) / تنازل عن العرش, تنحي (استقالة رسمية وتنازل عن السلطات)",
 "stepping motor": "محرك خطوي (اسم فاعل من حَرَّكَ؛ اسم آلة)\nمثال: المحرك لا يعمل.",
 "stepping stone": "حجر أساس, نقطة انطلاق (أي وسيلة للتقدم) / حَجَرُ عُبُور (حجر في مستنقع أو مياه ضحلة يمكن الوقوف عليه للعبور)\nمثال: كانت الوظيفة مجرد نقطة انطلاق في طريقه إلى الشهرة والثراء",
 "steprelationship": "قَرَابَة زَوْجِيَّة (علاقة أسرية بحكم الزواج الثاني (مثل زوج الأم))",
 "steps": "درج, سلالم (شوط من السلالم أو مجموعة من الدرجات) / خطى (المسار الذي سار عليه شخص ما أو يسير فيه)\nمثال: اتبعت خطاه",
 "stepsister": "أخت غير شقيقة (أخت تشترك معك في أحد الوالدين فقط)",
 "stepson": "رَبِيب",
 "stepwise": "بشكل متدرج, خطوة بخطوة (المضي في خطوات) / تَدْرِيجِيًّا, خُطْوَة بِخُطْوَة (شيء واحد في كل مرة؛ على مراحل صغيرة)\nمثال: تم زيادة الجهد بشكل متدرج",
 "steradian": "زاوية مجسمة, ستيراديان (وحدة الزاوية المجسمة المعتمدة في النظام الدولي للوحدات)",
 "stercobilinogen": "ستيركوبيلينوجين, يوروبيلينوجين (مولد لون يتكون في الأمعاء نتيجة تحلل البيليروبين؛ ينتج اليوروبيلين عند الأكسدة؛ يُفرز بعضه في البراز ويمتص البعض الآخر ويُفرز في الصفراء أو البول)",
 "stercolith": "حَصَاة بَرَازِيَّة (كتلة صلبة من المواد البرازية)",
 "stercorarius parasiticus": "كركر طفيلي, كركر قطبي (نوع من الكركر)",
 "sterculia": "برازية, ستركوليا (أي شجرة من جنس ستركوليا)",
 "sterculia acerifolia": "شجرة اللهب (شجرة جنوب أسترالية لها عناقيد من الزهور القرمزية المتألقة)",
 "sterculia apetala": "شجرة بنما (شجرة كبيرة متساقطة الأوراق موطنها بنما والتي أخذت الدولة اسمها منها؛ ذات تاج كثيف الأوراق وجذع عار)",
 "sterculia foetida": "زيتون جاوة, كالومبانغ (شجرة كبيرة في المناطق الاستوائية بالعالم القديم ذات زهور برتقالية حمراء كريهة الرائحة تليها قرون حمراء تحيط ببذور غنية بالزيت تستخدم أحياناً كغذاء)",
 "sterculia gum": "صمغ الكارايا (إفراز شجرة آسيوية؛ يستخدم لإنهاء المنسوجات ولتثخين المواد الغذائية ومستحضرات التجميل)",
 "sterculia rupestris": "شجرة الزجاجة الكوينزلاندية (شجرة كبيرة من كوينزلاند لها زهور كريمية اللون ملطخة بالأحمر من الداخل)",
 "stereo": "سْتِيرِيُو إِسْتِيرِيُو",
 "stereo photography": "تصوير ثلاثي الأبعاد, تصوير مجسم (التصوير الذي ينتج صورًا تبدو ذات عمق وصلابة ويتم إنشاؤها باستخدام جهاز خاص للنظر إلى صورتين مختلفتين قليلاً لشيء ما في نفس الوقت)",
 "stereo system": "ستيريو, نظام ستيريو (جهاز إعادة إنتاج صوتي يغذي فيه ميكروفونان مكبري صوت أو أكثر لإعطاء تأثير ثلاثي الأبعاد للصوت)",
 "stereochromy": "طباعة مجسمة ملونة (عملية للرسم الجداري يتم فيها تثبيت الصبغة بواسطة سلسلة من التفاعلات الكيميائية)",
 "stereoisomer": "متصاوغ فراغي (أي من مجموعة من المتصاوغات التي ترتبط فيها الذرات بنفس الترتيب ولكن تختلف في ترتيبها الفراغي)",
 "stereophonic": "سْتِيرِيُو, مُجَسَّم الصَّوْت (يشير إلى نقل الصوت أو تسجيله باستخدام قناتين صوتيتين مستقلتين أو أكثر)",
 "stereophonic system": "ستيريو, نظام ستيريو (جهاز إعادة إنتاج صوتي يغذي فيه ميكروفونان مكبري صوت أو أكثر لإعطاء تأثير ثلاثي الأبعاد للصوت)",
 "stereophony": "ستيريو, نظام ستيريو (جهاز إعادة إنتاج صوتي يغذي فيه ميكروفونان مكبري صوت أو أكثر لإعطاء تأثير ثلاثي الأبعاد للصوت)",
 "stereophotography": "تصوير ثلاثي الأبعاد, تصوير مجسم (التصوير الذي ينتج صورًا تبدو ذات عمق وصلابة ويتم إنشاؤها باستخدام جهاز خاص للنظر إلى صورتين مختلفتين قليلاً لشيء ما في نفس الوقت)",
 "stereoscope": "ستيريوسكوب, منظار مجسم (جهاز بصري لعرض الصور المجسمة)",
 "stereoscopic": "تجسيمي, ستيريوسكوبي (من أو متعلق بالتنظير التجسيمي (الرؤية ثلاثية الأبعاد)) / تجسيمي, ستيريوسكوبي (من أو متعلق بالمجسم (جهاز عرض الصور المجسمة))\nمثال: رؤية تجسيمية",
 "stereoscopic photograph": "ستيريو, صورة مجسمة (صورتان ملتقطتان من زوايا مختلفة قليلاً تبدوان ثلاثية الأبعاد عند مشاهدتهما معاً)",
 "stereoscopic photography": "تصوير ثلاثي الأبعاد, تصوير مجسم (التصوير الذي ينتج صورًا تبدو ذات عمق وصلابة ويتم إنشاؤها باستخدام جهاز خاص للنظر إلى صورتين مختلفتين قليلاً لشيء ما في نفس الوقت)",
 "stereoscopic picture": "ستيريو, صورة مجسمة (صورتان ملتقطتان من زوايا مختلفة قليلاً تبدوان ثلاثية الأبعاد عند مشاهدتهما معاً)",
 "stereoscopic vision": "تجسيم, رؤية مجسمة (رؤية ثلاثية الأبعاد ناتجة عن دمج مشهدين مختلفين قليلاً على كل شبكية)",
 "stereoscopy": "تجسيم, رؤية مجسمة (رؤية ثلاثية الأبعاد ناتجة عن دمج مشهدين مختلفين قليلاً على كل شبكية)",
 "stereotype": "صُورَة نَمَطِيَّة",
 "stereotyped": "مُكَرَّر, نَمَطِيّ (يَفْتَقِرُ إِلَى العَفْوِيَّةِ أَوِ الأَصَالَةِ أَوِ التَّفَرُّد)",
 "stereotypic": "مُكَرَّر, نَمَطِيّ (يَفْتَقِرُ إِلَى العَفْوِيَّةِ أَوِ الأَصَالَةِ أَوِ التَّفَرُّد)",
 "stereotypical": "مُكَرَّر, نَمَطِيّ (يَفْتَقِرُ إِلَى العَفْوِيَّةِ أَوِ الأَصَالَةِ أَوِ التَّفَرُّد)",
 "stereotypically": "بشكل نمطي (بطريقة نمطية)",
 "sterile": "عَقِيم, عَقِيمَة",
 "sterileness": "تعقيم, خلو من الجراثيم ((للأشياء غير الحية) حالة الخلو من الكائنات الحية المسببة للأمراض)",
 "sterilisation": "تعقيم (إجراء جعل شيء ما خالياً من البكتيريا الحية أو الكائنات الحية الدقيقة الأخرى (عادةً عن طريق الحرارة أو الوسائل الكيميائية)) / تعقيم (فعل جعل الكائن الحي عقيماً أو غير قادر على الإنجاب)",
 "sterilised": "مُعَقَّم (جُعِلَ عَقِيمًا بِإِجْرَاء طِبِّيّ)",
 "steriliser": "أوتوكلاف, جهاز تعقيم بالبخار المضغوط (جهاز لتسخين المواد فوق درجة غليانها؛ يستخدم لتصنيع المواد الكيميائية أو لتعقيم الأدوات الجراحية)",
 "sterility": "عقم (حالة عدم القدرة على إنتاج النسل؛ عند المرأة هو عدم القدرة على الحمل؛ عند الرجل هو عدم القدرة على التلقيح) / تعقيم, خلو من الجراثيم ((للأشياء غير الحية) حالة الخلو من الكائنات الحية المسببة للأمراض)",
 "sterilization": "تعقيم (إجراء جعل شيء ما خالياً من البكتيريا الحية أو الكائنات الحية الدقيقة الأخرى (عادةً عن طريق الحرارة أو الوسائل الكيميائية)) / تعقيم (فعل جعل الكائن الحي عقيماً أو غير قادر على الإنجاب)",
 "sterilized": "مُعَقَّم (جُعِلَ عَقِيمًا بِإِجْرَاء طِبِّيّ)",
 "sterilizer": "أوتوكلاف, جهاز تعقيم بالبخار المضغوط (جهاز لتسخين المواد فوق درجة غليانها؛ يستخدم لتصنيع المواد الكيميائية أو لتعقيم الأدوات الجراحية)",
 "sterling": "جنيَه إِسْتِرْلِينِيّ",
 "sterling area": "منطقة الإسترليني (مجموعة الدول التي ترتبط عملاتها بالجنيه الإسترليني البريطاني)",
 "sterling bloc": "منطقة الإسترليني (مجموعة الدول التي ترتبط عملاتها بالجنيه الإسترليني البريطاني)",
 "sterling silver": "فضة إسترليني (سبيكة فضة تحتوي على ما لا يزيد عن 7.5% نحاس)",
 "stern": "صَارِم, مُتَشَدِّد / مُؤَخَّرَة",
 "stern chaser": "مدفع المؤخرة (مدفع بحري قادر على إطلاق النار نحو الخلف على سفينة مطاردة)",
 "sterna hirundo": "خرشنة مألوفة (خرشنة شائعة في أوراسيا وأمريكا ذات ريش أبيض وأسود ورمادي)",
 "sternal": "قصي (من أو يتعلق بعظم القص أو يقع بالقرب منه)",
 "sternly": "بِحَزْم, بِصَرَامَة (بصرامة؛ بطريقة شديدة)\nمثال: قالت بصرامة: 'لا'",
 "sternness": "حزم, صرامة (عزم لا هوادة فيه) / تجهم, قتامة (الجودة (كما في المناظر الطبيعية) لكونها قاتمة وكئيبة ومنفرة)\nمثال: تجهم محيطه جعله غير مرتاح",
 "sternocleido mastoideus": "عضلة قترائية (واحدة من عضلتين سميكتين تمتدان من القص والترقوة إلى الخشاء والعظم القذالي؛ تدير الرأس بشكل مائل إلى الجانب المعاكس؛ عند العمل معاً تثنيان الرقبة…)",
 "sternocleidomastoid": "عضلة قترائية (واحدة من عضلتين سميكتين تمتدان من القص والترقوة إلى الخشاء والعظم القذالي؛ تدير الرأس بشكل مائل إلى الجانب المعاكس؛ عند العمل معاً تثنيان الرقبة…)",
 "sternocleidomastoid muscle": "عضلة قترائية (واحدة من عضلتين سميكتين تمتدان من القص والترقوة إلى الخشاء والعظم القذالي؛ تدير الرأس بشكل مائل إلى الجانب المعاكس؛ عند العمل معاً تثنيان الرقبة…)",
 "sternocleidomastoid vein": "وريد قصي ترقوي خشائي (يصرف العضلة القصية الترقوية الخشائية؛ يصب في الوريد الوداجي الباطن)",
 "sternpost": "قائم المؤخرة ((ملاحة) الخشب الرأسي الرئيسي في مؤخرة السفينة)",
 "sternum": "عظم القص, قص (العظم المسطح الذي يتمفصل مع الترقوتين والأزواج السبعة الأولى من الأضلاع)",
 "sternutation": "عطاس, عطس (عَرَض يتكون من طرد لا إرادي للهواء من الأنف)",
 "sternutative": "مُعَطِّس (يتسبّب في العطاس)",
 "sternutator": "مادة معطسة (مادة كيميائية تسبب العطس والسعال والبكاء)\nمثال: استخدمت الشرطة مادة معطسة لإخضاع الغوغاء",
 "sternutatory": "مُعَطِّس (يتسبّب في العطاس) / معطس, منشط للعطاس (يميل للتسبب في العطاس) / مادة معطسة (مادة كيميائية تسبب العطس والسعال والبكاء)\nمثال: استخدمت الشرطة مادة معطسة لإخضاع الغوغاء",
 "sternwheeler": "باخرة ذات عجلة خلفية (باخرة ببدالات لها عجلة البدالة في المؤخرة)",
 "steroid": "ستيرويد, هرمون ستيرويدي (أي هرمون يؤثر على نمو وتطور الأعضاء الجنسية) / ستيرويد (أي من المركبات العضوية المتعددة القابلة للذوبان في الدهون والتي تتكون أساساً من 17 ذرة كربون في أربع حلقات؛ وللعديد منها تأثيرات فسيولوجية مهمة)",
 "steroid alcohol": "ستيرول, كحول ستيرويدي (أي من مجموعة الكحولات الستيرويدية الطبيعية المشتقة من النباتات أو الحيوانات؛ وهي مواد شمعية غير قابلة للذوبان)",
 "steroid hormone": "ستيرويد, هرمون ستيرويدي (أي هرمون يؤثر على نمو وتطور الأعضاء الجنسية)",
 "steroidal": "ستيرويدي (مكون من أو متعلق بالهرمونات الستيرويدية أو تأثيراتها)",
 "sterol": "ستيرول, كحول ستيرويدي (أي من مجموعة الكحولات الستيرويدية الطبيعية المشتقة من النباتات أو الحيوانات؛ وهي مواد شمعية غير قابلة للذوبان)",
 "sterope": "ستيروبي ((الأساطير اليونانية) واحدة من البلياديس السبعة)",
 "stertor": "شخير (فعل الشخير أو إصدار صوت الشخير)",
 "stertorous": "غَطِيطِيّ (في التنفّس ذو صوت شخير ثقيل)",
 "stertorously": "بشخير, بصوت حشرجة (بطريقة صاخبة تتسم بالشخير)\nمثال: كان يتنفس بصوت شخير",
 "stethoscope": "سَمَّاعَةُ الطَّبِيب, سَمَّاعَة",
 "stetson": "فيدورا, قبعة لباد (قبعة مصنوعة من اللباد ذات تاج مجعد)",
 "stevedore": "عامل الميناء, عامل شحن وتفريغ (عامل يقوم بتحميل وتفريغ السفن في الميناء)",
 "stevens' law": "قانون القوة, قانون ستيفنز ((فيزياء نفسية) المفهوم القائل بأن حجم الإحساس الذاتي يزداد بما يتناسب مع قوة (أس) شدة التحفيز)",
 "stevens' power law": "قانون القوة, قانون ستيفنز ((فيزياء نفسية) المفهوم القائل بأن حجم الإحساس الذاتي يزداد بما يتناسب مع قوة (أس) شدة التحفيز)",
 "stevia": "بيكويريا, ستيفيا (أي نبات من جنس بيكويريا أو الجنس الوثيق الصلة ستيفيا) / ستيفيا (أي نبات من جنس ستيفيا أو الجنس الوثيق الصلة بيكويريا له أوراق لزجة وأزهار بيضاء أو أرجوانية؛ أمريكا الوسطى والجنوبية)",
 "stew": "يَخْنَة",
 "stew meat": "لحم الطهي البطيء, لحم اليخنة (لحم قاسٍ يحتاج إلى السلق أو الطهي البطيء ليصبح صالحاً للأكل)",
 "steward": "أَمِين, حارِس (شخص يتولى مسؤولية المباني أو الأراضي أو الحيوانات) / مندوب عمالي (عضو نقابة يُنتخب لتمثيل زملائه العمال في التفاوض مع الإدارة) / ناظر, وكيل (شخص يدير الممتلكات أو الشؤون الأخرى لشخص آخر) / مضيف, مضيف طيران (مرافق على متن طائرة)",
 "stewardess": "مُضِيفَةْ طَيَرَان, مُضِيفَة",
 "stewardship": "إشراف, وكالة (منصب الوكيل أو المشرف)",
 "stewed": "مَسْلُوق, مَطْبُوخٌ بِالمَاء (مَطْهُوٌّ فِي مَاءٍ سَاخِن)",
 "stewing": "سلق, غلي (الطهي في سائل تم غليه) / غليان, قلق شديد (حالة قصوى من القلق والاضطراب)\nمثال: غليانه بشأن الشجار أبقاه مستيقظاً معظم الليل",
 "stewing pan": "طنجرة, قِدر الطهي (وعاء يستخدم للطهي البطئ (اليخنة))",
 "stewpan": "طنجرة, قِدر الطهي (وعاء يستخدم للطهي البطئ (اليخنة))",
 "sth": "سوماتروبين, هرمون النمو (هرمون تنتجه الغدة النخامية الأمامية؛ يعزز النمو عند البشر)",
 "sthene": "سثين (وحدة قوة تساوي 1000 نيوتن)",
 "stheno": "سثينو ((الأساطير اليونانية) الكبرى بين الغورغونات الثلاث)",
 "stibnite": "ستيبنيت (معدن رمادي ناعم؛ الخام الرئيسي للأنتيمون)",
 "sticherus flabellatus": "سرخس المروحة, سرخس المظلة (سرخس أسترالاسي كبير بسعف متشعب بشكل متكرر يشبه المروحة؛ يوضع أحياناً في جنس جليشينيا)",
 "stichic verse": "شعر غير مقطعي, شعر متسلسل (شعر يتكون من أسطر بنفس الوزن والطول التقريبي، غير مقسم إلى مقطوعات)",
 "sticht plate": "لوحة شتيخت, لوحة كبح (أول كابح ميكانيكي للحبل يتكون من لوحة معدنية صغيرة بها فتحة تسمح بمرور حلقة من الحبل خلالها إلى حلقة تسلق (كارابينر) مقفلة ومن ثم الخروج منها)\nمثال: أصبحت لوحات شتيخت أقل شيوعاً لأن التصميمات الأكثر حداثة توفر تحكماً أكثر سلاسة في الحبل وتكون أقل عرضة للتشويش",
 "stick": "غُصَيْن / عَصًا (ما يتخذ من خَشَب للتوكؤ أو الضرب؛ تطلق مجازا على عَظْم السَاق وعلى اللِسَان) / لَصَّقَ, لَصِقَ\nمثال: لا تمسك العصا من الوسط.",
 "stick cinnamon": "عواد قرفة (شرائح ملفوفة مجففة من لحاء القرفة)",
 "stick figure": "رسم عود (رسم لإنسان أو حيوان يمثل الرأس بدائرة وبقية الجسم بخطوط مستقيمة)",
 "stick horse": "عصا الحصان (لعبة أطفال تتكون من رأس حصان مقلد على أحد طرفي عصا)",
 "stick insect": "حشرة عصوية (أي من الحشرات المتنوعة الاستوائية غالباً التي لها أجسام طويلة تشبه الأغصان)",
 "stick lac": "لك العيدان (اللك في حالته الطبيعية كما يُكشط من الأغصان ويجفف)",
 "stick moxa": "عُود الموكسا (عصا مصنوعة من أوراق مجففة لنوع آسيوي من الشيح، تستخدم في العلاج بالكي)",
 "stick one's nose into": "حَشَرَ أَنْفَهُ (جَمَعَ الناسَ أو الأشياءَ في مكانٍ ضيّق؛ ساقهم إلى مكان معين، أو جمعهم قهرًا)",
 "stick shift": "ناقل حركة يدوي (ناقل حركة يتم تشغيله يدوياً برافعة تروس ودواسة قابض)",
 "stick-in-the-mud": "بطيء الحركة, بليد (شخص يتحرك ببطء)",
 "stick-on": "لَاصِق مُسْبَقًا (مُصمَّغ مسبقًا (كملصقات الورق أو الطوابع))",
 "stickball": "ستيكبول (شكل من أشكال البيسبول يُلعب في الشوارع بكرة مطاطية ومقبض مكنسة)",
 "stickball game": "ستيكبول (شكل من أشكال البيسبول يُلعب في الشوارع بكرة مطاطية ومقبض مكنسة)",
 "sticker": "مُلْصَق",
 "stickily": "بلزوجة (بطريقة لزجة ودبقة)\nمثال: شعر بالدم يتحرك بلزوجة من فروة رأسه المشقوقة ويسيل على جبهته",
 "stickiness": "دبق, لزوجة (خاصية الالتصاق بسطح ما)",
 "sticking plaster": "بلاستر, لاصق طبي (شريط لاصق يستخدم في تضميد الجروح)",
 "sticking point": "عقبة, نقطة خلاف (نقطة ينشأ عندها طريق مسدود في التقدم نحو اتفاق أو هدف)",
 "stickleback": "سمك شائك الظهر (أسماك صغيرة (2-4 بوصات) عدوانية غالباً عديمة الحراشف وشائكة الظهر تعيش في المياه العذبة والساحلية الشمالية ولها طقوس تزاوج معقدة؛ موضوع لكثير من…)",
 "stickler": "متشدد, متمسك (شخص يصر بشدة على شيء ما أو قاعدة معينة)\nمثال: متشدد بشأن الدقة في المواعيد",
 "sticklerism": "تَشَدُّد, تَمَسُّك حَرْفِيّ بِالقَوَاعِد (سلوك المتشدد؛ التمسك غير المرن بالقواعد)",
 "stickpin": "دبوس ربطة العنق (دبوس مزخرف يوضع في ربطة العنق)",
 "sticks and stone": "مواد بناء أولية (مصطلح عام لمواد البناء)",
 "sticktight": "برغوث الدجاج (طفيلي يتواجد خاصة على رؤوس الدجاج) / حسك السيدة, قواض (أي من عدة نباتات من جنس بايدنس لها زهور صفراء وثمار شائكة تلتصق بالفراء والملابس)",
 "sticktight flea": "برغوث الدجاج (طفيلي يتواجد خاصة على رؤوس الدجاج)",
 "stickup": "سطو مسلح (سطو تحت تهديد السلاح)",
 "stickup man": "قاطع طريق, لص مسلح (لص مسلح ذكر)",
 "stickup woman": "لصة مسلحة (لصة أنثى مسلحة)",
 "stickweed": "عشبة لاصقة (أي من عدة نباتات عشبية لها بذور تلتصق بالملابس)",
 "sticky": "دَبِق, صَمْغِيّ (له خصائص اللصق اللزجة كالمواد اللاصقة) / لَاصِق, لَزِق (مُغطّى بمادّة لاصقة) / حَرِج, مُحْرِج (صَعْب التَّعَامُل مَعَهُ؛ يُسَبِّب أَلَمًا أَوْ إِحْرَاجًا) / حَارّ وَرَطْب, خَانِق (حارّ أو دافئ ورطب بشكل مزعج)",
 "sticky aster": "أستر لزج (أستر بري له سيقان ورقية ورؤوس زهرية بأشعة ضيقة أرجوانية زاهية أو بنفسجية؛ غرب كولورادو إلى أريزونا)",
 "sticky bun": "كعكة العسل, كعكة لزجة (عجين ملفوف مدهون بالسكر والمكسرات ثم يقطع ويخبز في قوالب مافن مع العسل أو السكر والزبدة في القاع)",
 "sticky end": "طرف لزج (طرف من الحمض النووي يمتد فيه أحد شريطي اللولب المزدوج بضع وحدات أبعد من الآخر)",
 "sticky geranium": "غرنوقي لزج (غرنوقي من غرب أمريكا الشمالية له زهور وردية أرجوانية في عناقيد مفتوحة)",
 "stictopelia cuneata": "يمام أسترالي (حمامة أسترالية صغيرة)",
 "stiff": "بتصلب, بجمود (بطريقة متصلبة) / بشدة, حتى التجمد (لدرجة كبيرة (غالباً مع الخوف أو الملل)) / ثَمِل تَمَامًا, سَكْرَان طَافِح (فِي حَالَة سُكْرٍ شَدِيد) / جَامِد, مُتَصَلِّب (غَيْرُ قَابِلٍ لِلِانْثِنَاءِ أَوْ مُقَاوِمٌ لَهُ)\nمثال: استقرت يداه بتصلب",
 "stiff aster": "أستر صلب, أستر كتاني الأوراق (نبات معمر معنقد سلكي في شرق الولايات المتحدة بسيقان خشنة منتصبة صلبة وأوراق خطية وزهور بنفسجية كبيرة)",
 "stiff gentian": "جنطيانا خماسية الأوراق (جنطيانا من شرق أمريكا الشمالية لها عناقيد من الزهور الزرقاء الشائكة)",
 "stiff upper lip": "جلد, رباطة جأش (ضبط النفس في التعبير عن المشاعر (خاصة الخوف أو الحزن))\nمثال: يحب البريطانيون الحفاظ على رباطة جأشهم",
 "stiff-backed": "صُلْب الظَّهْر, مُنْتَصِب (ذو ظهر صلب ومستقيم)",
 "stiff-branched": "صُلْبُ الأَغْصَان (لَهُ أَغْصَانٌ صُلْبَة)",
 "stiff-haired": "قَاسِي الشَّعْر (ذو شعر صلب وقاسٍ)",
 "stiff-necked": "مُتَصَلِّب, مُتَكَبِّر العِنَاد (عنيد بتكبّر وغطرسة)",
 "stiff-tailed": "صُلْب الذَّيْل (ذو ذيل متصلّب)",
 "stiffen": "جَمَدَ (صَارَ صُلْبًا أو قَاسِيًا بَعْدَ السَّيُولَةِ؛ تَوَقَّفَ عَنِ الحَرَكَةِ أو النَّمُوِّ)",
 "stiffener": "دعك, مادة مقوية (مادة تستخدم لتصلب شيء ما) / دعامة تقوية, مقوي (عضو متصل بقلب العارضة لمنع فقدان القوة بسبب انبعاج القلب)",
 "stiffening": "تصلب, تقوية (عملية التحول إلى الصلابة) / تصلب, تصلد (عملية التحول إلى صلب أو قاسي)",
 "stiffly": "بتصلب, بجمود (بطريقة متصلبة) / بتيبس, بصلابة (بطريقة صلبة)\nمثال: استقرت يداه بتصلب",
 "stiffness": "شدة, صرامة (صرامة مفرطة) / ارْتِبَاك, ثِقَل ظِلّ (عدم الأناقة لشخص متصلب وغير مسترخٍ (بسبب الحرج مثلاً)) / جمود, صلابة (حزم ثابت في الغرض أو الرأي أو العمل) / تشنج, تصلب (خاصية التحرك بألم أو صعوبة)\nمثال: صرامة الشخصية",
 "stifle": "خنق, مفصل الركبة (المفصل بين عظم الفخذ والساق في ذوات الأربع؛ يقابل الركبة البشرية)",
 "stifled": "مَخْنُوق, مَقْمُوع (مُحتبَس بصعوبة ومُسيطَر عليه بالكاد)",
 "stifler": "خَانِق, كَابِت (شخص يكبت أو يخنق أو يقمع)\nمثال: هو شخص خانق للمحادثة حقاً",
 "stifling": "إخماد, قمع (منع بالقوة؛ القضاء على الشيء بالسلطة أو القوة) / حَارّ رَطْب, خَانِق (يتَّسم بحرارة ورطوبة خانقتَين)\nمثال: قمع الهرطقة",
 "stigma": "مِيسَم",
 "stigmata": "آثار الجروح, وصمات (علامات تشبه الجروح على جسد المسيح المصلوب)",
 "stigmatic": "لَا لَابُؤْرِيّ (ليس لابؤرياً (يصحح اللابؤرية)) / لا بؤري, مصحيح اللابؤرية (متعلق بعدسة أو نظام عدسات خالٍ من اللابؤرية (قادر على تكوين صور نقطية)) / ميسيمِي, وسمي (متعلق بـ أو يشبه أو يمتلك مياسماً (في النبات) أو سمات/علامات) / موسوم (شخص يحمل جسده علامات دينية (مثل علامات تشبه جروح المسيح المصلوب))",
 "stigmatisation": "تشويه السمعة, وصم بالعار (فعل الوصم بالعار)",
 "stigmatism": "إبصار سوي, بصر طبيعي (نور البصر الطبيعي) / نقطية ((بصريات) حالة نظام بصري (مثل العدسة) تتجمع فيه أشعة الضوء من نقطة واحدة في نقطة بؤرية واحدة) / سمة, وصم (حالة وجود أو التميز بوجود وصمات (علامات))",
 "stigmatist": "موسوم (شخص يحمل جسده علامات دينية (مثل علامات تشبه جروح المسيح المصلوب))",
 "stigmatization": "تشويه السمعة, وصم بالعار (فعل الوصم بالعار)",
 "stigmatize": "وَصَمَ",
 "stilbesterol": "ثنائي إيثيل ستيلبوستيرول (مادة اصطناعية غير ستيرويدية لها خصائص الإستروجين؛ كانت تستخدم سابقاً لعلاج مشاكل الدورة الشهرية)",
 "stilbestrol": "ثنائي إيثيل ستيلبوستيرول (إستروجين قوي يستخدم في الطب وفي علف الماشية والدواجن)",
 "stilboestrol": "ثنائي إيثيل ستيلبوستيرول (إستروجين قوي يستخدم في الطب وفي علف الماشية والدواجن)",
 "stile": "قائم (قائم هو عضو في إطار باب أو نافذة)",
 "stiletto": "خُنَيْجِر",
 "stiletto heel": "كعب خنجري, كعب عالٍ (كعب ضيق وعالٍ جداً في أحذية النساء)",
 "still": "سَاكِن, ثَابِت / سَاكِنًا / لَا يَزَال, مَا زَالَ (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها) / رَغِم ذٰلِك, مَعَ ذٰلِك ((رَغَمَ) رَغْمًا، ومَرْغَمًا، ومَرْغَمَةً: ذَلَّ؛ (رَغَمَ) ذل عن كَرْه. يقال (رغَمَ) أَنْفُه)\nمثال: لا أحب المدرسة.",
 "still hunt": "تتبع, مطاردة خلسة (صيد الطرائد عن طريق تتبعها خلسة أو الانتظار في كمين)",
 "still life": "طبيعة صامتة (لوحة لأشياء جامدة مثل الفاكهة أو الزهور)",
 "still room": "غرفة تحضير المشروبات (مخزن متصل بالمطبخ (خاصة في منزل كبير) لتحضير الشاي والمشروبات وتخزين المشروبات والمربيات والشاي وغيرها)",
 "still's disease": "التهاب المفاصل الروماتويدي اليفعي, داء ستيل (شكل من أشكال التهاب المفاصل الروماتويدي يصيب الأطفال؛ تلتهب المفاصل الكبيرة وقد يتأخر نمو العظام)",
 "stillbirth": "إجهاض تلقائي, إسقاط (فقدان طبيعي لنتاج الحمل)",
 "stillborn": "إِمْلَاص",
 "stillborn infant": "مولود ميت, ميت ولادة (رضيع لا يظهر أي علامات للحياة بعد الولادة)",
 "stillness": "سكون, هدوء تام ((شعرياً) صمت وسكون مطمئن) / انعدام الحركة, جمود (حالة عدم وجود حركة) / انعدام الرياح, سكون (هدوء بدون رياح)\nمثال: سكون الليل",
 "stillroom": "غرفة تحضير المشروبات (مخزن متصل بالمطبخ (خاصة في منزل كبير) لتحضير الشاي والمشروبات وتخزين المشروبات والمربيات والشاي وغيرها)",
 "stillson wrench": "مفتاح أنابيب, مفتاح ستيلسون (مفتاح)\nمثال: بحث عن المفتاح.",
 "stilly": "سَاجٍ, هَادِئ ((شعريّ) ساكن أو هادئ)",
 "stilt": "كُرْسُوع, أَبُو الْمَغَازِل",
 "stilt plover": "أبو المغازل (طائر خوض طويل الساقين ثلاثي الأصابع أسود وأبيض يعيش في البرك الداخلية والمستنقعات أو البحيرات قليلة الملوحة)",
 "stiltbird": "أبو المغازل (طائر خوض طويل الساقين ثلاثي الأصابع أسود وأبيض يعيش في البرك الداخلية والمستنقعات أو البحيرات قليلة الملوحة)",
 "stilted": "مُتَصَلِّب, مُصْطَنَع (رسمي بشكل مصطنع ومتكلّف)",
 "stiltedly": "بتكلف, برسمية مفرطة (بطريقة متكلفة)\nمثال: أجابته بتكلف",
 "stilton": "ستيلتون (جبن أزرق إنجليزي)",
 "stimulant": "مُنَشِّط, مُنَبِّه",
 "stimulant drug": "منبه, منشط (عقار يسرع مؤقتاً بعض العمليات الحيوية)",
 "stimulated": "مُتَأَثِّر, مُسْتَثَار (مُثَار عاطفياً ووجدانياً)",
 "stimulating": "مُبْهِج, مُحَفِّز (يجعل النفس حيّة ومبتهجة) / مثير, محفز (يثير أو ينشط النشاط أو الحواس) / مُحَفِّز, مُنَبِّه (ذو تأثير تنبيهي وتحفيزي)\nمثال: مناقشة محفزة",
 "stimulation": "إثارة, مداعبة (الملاطفة الجنسية المتبادلة قبل الجماع) / تحفيز, تنشيط (فعل استنهاض كائن حي للعمل) / مثير, محفز (أي معلومة أو حدث محفز؛ يعمل على إثارة العمل) / تحفيز, تنبيه ((في علم وظائف الأعضاء) تأثير منبه (على الأعصاب أو الأعضاء وما إلى ذلك))",
 "stimulative": "منبه, منشط (قادر على إثارة أو تسريع النشاط الفسيولوجي أو النفسي أو الاستجابة بواسطة عامل كيميائي)",
 "stimulus": "مثير, محفز (أي معلومة أو حدث محفز؛ يعمل على إثارة العمل)",
 "stimulus generalisation": "تعميم, تعميم المحفز ((علم النفس) نقل استجابة تم تعلمها لمحفز واحد إلى محفز مشابه)",
 "stimulus generalization": "تعميم, تعميم المحفز ((علم النفس) نقل استجابة تم تعلمها لمحفز واحد إلى محفز مشابه)",
 "sting": "لَسَعَ",
 "sting operation": "عملية سرية, كمين (عملية مصممة للقبض على شخص يرتكب فعلاً إجرامياً) / عملية إيقاع, كمين للشرطة (لعبة ثقة معقدة مخطط لها ومنفذة بعناية كبيرة (خاصة عملية ينفذها عملاء سريون للقبض على المجرمين))\nمثال: نفذت الشرطة عملية سرية",
 "stingaree-bush": "بازلاء الشابارال (شجيرة دائمة الخضرة شائكة تتحمل الجفاف، لها زهور وردية وأرجوانية بارزة وتشكل غابات كثيفة؛ تنمو في المنحدرات الجبلية الصخرية الجافة في كاليفورنيا)",
 "stinger": "ضربة لاذعة (ضربة حادة مؤلمة) / إبرة لاسعة (عضو حاد للهجوم أو الدفاع (كما في الدبور أو سمك الراي اللاسع أو العقرب) غالباً ما يكون متصلاً بغدة سم) / ستينغر (نظام صواريخ أرض-جو محمول منخفض الارتفاع يستخدم التوجيه بالأشعة تحت الحمراء وصمام تصادم؛ يطلق من الكتف) / طَعْنَة, كَلِمَة جَارِحَة (ملاحظة قادرة على الجرح معنوياً)\nمثال: الطعنة الأكثر قسوة على الإطلاق",
 "stingily": "ببخل, بتقتير (بطريقة بخيلة)\nمثال: عاملهم عمهم الغني ببخل",
 "stinginess": "بُخْل (بَخِلَ :ضَنَّ بما عنده،أمسك ومنع؛ البُخْل:ضِدُّ الْكَرَم والْجُود)",
 "stinging": "جَارِح, لَاذِع ((في الكلام) حادّ أو مؤذٍ في النبرة أو الطابع) / لسعة (نوع من الألم؛ شيء مفاجئ ومؤلم كأنك تعرضت للدغ)\nمثال: لسعة الموت",
 "stinging hair": "شعيرة لاسعة (شعرة متعددة الخلايا في نباتات مثل القراص اللاسع تطرد سائلاً مهيجاً)",
 "stinging nettle": "قراص, قراص لاذع (قراص أوراسي معمر مستقر في أمريكا الشمالية ذو أوراق عريضة مسننة بخشنة مع شعيرات لاذعة غزيرة)",
 "stingless": "عديم اللسع (بدون إبرة لسع)",
 "stingray": "سَمَكَة رَاي لَاسِع, سْتِينْغْرَي (مصطلح شمولي لأي حيوان فقاري مائي خيشومي التنفس)\nمثال: سمكة ميناد ماتت",
 "stingy": "بَخِيل (الجمع : بُخَلاءُ ، المؤنث : بخيلة ، و الجمع للمؤنث : بخيلات و بُخَلاءُ؛ شَحِيْح، مُقْتِر)\nمثال: بئس الرجل البخيل.",
 "stink": "نَتُنَ, نَتِنَ",
 "stink bell": "جرس النتن (عشبة كاليفورنيا كريهة الرائحة بأزهار على شكل جرس؛ عشبة ضارة شائعة في حقول الحبوب)",
 "stink bomb": "قنبلة نتنة (قنبلة صغيرة مصممة لإطلاق رائحة كريهة عند انفجارها)",
 "stink fly": "شبكية الأجنحة الخضراء (ذبابة شبكية الأجنحة خضراء شاحبة كريهة الرائحة لها يرقات آكلة للحوم)",
 "stinkbird": "هواتزين (طائر جنوب أمريكي ذو عرف كريه الرائحة لصغاره مخالب في الإصبعين الأول والثاني من الأجنحة)",
 "stinker": "خردة, سلعة معيبة (منتج (خاصة السيارات) يكون معيباً أو غير مرضٍ) / شيء كريه الرائحة, مُنْتِن (أي شيء تنبعث منه رائحة كريهة (خاصة السيجار الرخيص)) / حقير, دنيء (شخص يُعتبر حقيراً أو مُزدرى)\nمثال: وحده الدنيء يفعل ذلك",
 "stinkhorn": "فطر الجيفة, فطر القرن النتن (أي من الفطريات المختلفة ذات القبعة البنية كريهة الرائحة من رتبة فالاليس)\nمثال: تجذب الرائحة الكريهة لفطر القرن النتن الحشرات التي تحمل الأبواغ بعيداً على أقدامها",
 "stinkiness": "رائحة كريهة, نتانة (سمة امتلاك رائحة كريهة قوية)",
 "stinking": "زَنِخ, مُنْتِن (ذُو رَائِحَةٍ كَرِيهَةٍ بِشَكْلٍ مُؤْذٍ) / تَافِه, رَدِيء جِدًّا ((غير رسمي) سيء جداً ومُقزِّز)",
 "stinking bean trefoil": "خروب الخنزير, نفل الفول (شجيرة ذات أوراق ثلاثية وأزهار صفراء تليها قرون بذور منحنية للخلف؛ الأوراق كريهة الرائحة عند سحقها)",
 "stinking cedar": "أرز نتن, طقسوس نتن (شجرة دائمة الخضرة صغيرة نادرة من شمال فلوريدا؛ أوراقها الخضراء اللامعة لها رائحة كريهة عند سحقها)",
 "stinking chamomile": "أقحوان نتن, شمر الكلاب (عشبة ضارة واسعة الانتشار كريهة الرائحة ذات رؤوس زهور بيضاء الأشعة بأقراص صفراء)",
 "stinking clover": "نبات النحل, نفل نتن (نبات من غرب أمريكا الشمالية ذو أوراق ثلاثية وأزهار بيضاء أو وردية تشبه العنكبوت؛ يستخدم أحياناً كنبات زينة)",
 "stinking elder": "بيلسان أحمر أمريكي (شجيرة أو شجرة صغيرة شائعة في أمريكا الشمالية)",
 "stinking gladwyn": "سوسن كريه الرائحة (سوسن بزهور أرجوانية وأوراق كريهة الرائحة؛ جنوب وغرب أوروبا وشمال أفريقيا)",
 "stinking goosefoot": "رجل الوزة النتن (رجل الوزة الأوروبي ذو أوراق قوية الرائحة؛ دخيل في شرق أمريكا الشمالية)",
 "stinking hellebore": "خربق كريه الرائحة, خربق منتن (خربق ذو أوراق كفية وله رائحة كريهة وخصائص مهيجة عند تناوله داخلياً)",
 "stinking horehound": "بلوطة, فراسيون أسود (عشب أوروبي كريه الرائحة بأوراق مجعدة ودوامات من الزهور الأرجوانية الداكنة)",
 "stinking iris": "سوسن كريه الرائحة (سوسن بزهور أرجوانية وأوراق كريهة الرائحة؛ جنوب وغرب أوروبا وشمال أفريقيا)",
 "stinking mayweed": "أقحوان نتن, شمر الكلاب (عشبة ضارة واسعة الانتشار كريهة الرائحة ذات رؤوس زهور بيضاء الأشعة بأقراص صفراء)",
 "stinking nightshade": "بنج, بنج أسود (عشب سام منتن من العالم القديم له أوراق مشعرة لزجة وأزهار بنية صفراء؛ ينتج الهيوسيامين والسكوبولامين)",
 "stinking smut": "تفحم نتن, تيليتيا فوئتيدا (مشابه لتيليتيا كاريس) / تفحم نتن (مرض يصيب القمح يتميز باستبدال الحبوب بكتل دهنية من أبواغ التفحم ذات الرائحة الكريهة)",
 "stinking wattle": "جيدجي, سنط كريه الرائحة (سنط أسترالي شجيري ذو أزهار كريهة الرائحة للغاية)",
 "stinking weed": "سنا القهوة, عشبة منتنة (شجيرة استوائية مورقة جداً كريهة الرائحة استخدمت بذورها كمغشوش للقهوة؛ تصنف أحياناً في جنس كاسيا)",
 "stinking yew": "أرز نتن, طقسوس نتن (شجرة دائمة الخضرة صغيرة نادرة من شمال فلوريدا؛ أوراقها الخضراء اللامعة لها رائحة كريهة عند سحقها)",
 "stinkpot": "سلحفاة المسك (سلحفاة مياه عذبة صغيرة لها رائحة مسك قوية) / حقير, دنيء (شخص يُعتبر حقيراً أو مُزدرى)\nمثال: وحده الدنيء يفعل ذلك",
 "stinkweed": "ثلاسبي حقلي, خردل الميثريبات (عشبة أوراسية كريهة الرائحة ذات قرون مسطحة مستديرة؛ متوطنة في جميع أنحاء أمريكا الشمالية)",
 "stinky": "نَتِن, مُنْتِن",
 "stinky squid": "الحبار النتن (فطر نتن من جنس بسودوكولوس؛ يشبه الجسم الثمري في البداية فطراً نفاثاً صغيراً ينفتح قريباً ليشكل ساقاً بأذرع مستدقة تتقوس وتستدق إلى نقطة مشتركة)",
 "stint": "حصة عمل, فترة عمل (حصة الفرد المقررة من العمل) / دريجة صغيرة, فطيرة (أصغر طيطوي أمريكي) / فترة, مدة (فترة زمنية غير منقطعة تقوم خلالها بشيء ما)\nمثال: أرهقتها فترة عملها كمنقذة",
 "stinter": "مقتر (مقتصد يبخل على شخص ما بشيء ما)",
 "stinting": "زَاهِد, مُقْتَصِد (يَتَجَنَّبُ الإِسْرَافَ وَالهَدْر)",
 "stipe": "سويقة (ساق داعمة أو هيكل يشبه الساق خاصة لمدقة أو سعفة سرخس أو تدعم غطاء الفطر)",
 "stipend": "راتب, مخصص (مبلغ من المال يخصص بشكل منتظم؛ عادة لغرض محدد)",
 "stipendiary": "مَأْجُور, مَدْفُوعُ الأَجْر (يُدْفَعُ مُقَابِلُهُ مَال) / بِرَاتِب, يَتَقَاضَى أَجْرًا (يَتَلَقَّى تَعْوِيضًا مَالِيًّا أَوْ مُؤَهَّلٌ لِذَلِك) / راتبي, مدفوع الأجر (متعلق بـ أو من طبيعة الراتب أو البدل المالي) / قاضٍ مدفوع الأجر ((المملكة المتحدة) قاضٍ يتقاضى راتباً (يعينه وزير الداخلية) للتعامل مع قضايا الشرطة)\nمثال: أموال الرواتب",
 "stipendiary magistrate": "قاضٍ مدفوع الأجر ((المملكة المتحدة) قاضٍ يتقاضى راتباً (يعينه وزير الداخلية) للتعامل مع قضايا الشرطة)",
 "stippled": "مُرَشَّش, مُنَقَّط (ذو نقش من النقاط)",
 "stippler": "منقّط (رسام يستخدم التنقيط (يخلق تأثيراً منقطاً))",
 "stipulation": "اشتراط, شرط (قيد يتم الإصرار عليه كشرط للاتفاق) / شرط, شرط مسبق (افتراض تعتمد عليه صحة أو تأثير شيء آخر) / إقرار قضائي, اشتراط ((قانون) اتفاق أو تنازل يقدمه الأطراف في دعوى قضائية يتعلق بالعمل المعروض على المحكمة؛ يجب أن يكون مكتوبًا ما لم يكن جزءًا من سجل المحكمة)\nمثال: تم عمل إقرار بالوقائع لتجنب التأخير",
 "stipulative definition": "تعريف اشتراطي (تعريف يشترطه شخص ما ولا يعد استخداماً قياسياً)",
 "stipulatory": "اشْتِرَاطِيّ, مُتَّفَقٌ عَلَيْه (مُنْشَأٌ أَوْ مُبْرَمٌ بِمُوجَبِ اتِّفَاقٍ أَوِ اشْتِرَاط)",
 "stipule": "أذينة (نمو ورقي صغير عند قاعدة ورقة أو ساقها؛ عادة ما يحدث في أزواج ويسقط قريباً)",
 "stir": "تَحَرَّكَ (حَرُكَ)\nمثال: لا أستطيع التحرك.",
 "stirk": "عجل حولي (عجلة أو عجل يبلغ من العمر سنة واحدة)",
 "stirred": "مَمْزُوج, مُحَرَّك (وُضِع في حركة دائرية عادة للخلط أو المزج) / مُتَأَثِّر, مُسْتَثَار (مُثَار عاطفياً ووجدانياً) / متأثر, منفعل (في حالة انفعال أو استثارة للتعبير عن عاطفة)\nمثال: متأثر جداً لدرجة عدم القدرة على الكلام",
 "stirred up": "مُتَأَثِّر, مُسْتَثَار (مُثَار عاطفياً ووجدانياً)",
 "stirrer": "أداة تحريك, محراك (أداة تستخدم للتحريك أو التقليب) / مثير للفتنة, مروج للخوف (شخص ينشر شائعات مخيفة ويثير المشاكل)",
 "stirring": "تحريك, تقليب (تحريك سائل باستخدام أداة) / إلهام, تحريك المشاعر (الاستنهاض لعاطفة أو فعل معين) / مُثِير, مُحَرِّك لِلْمَشَاعِر (يثير مشاعر قوية لكنها غير مزعجة) / حَمَاسِيّ, مُلْهِم (قادر على إثارة الحماس أو الإثارة)\nمثال: التحريك المستمر يمنعه من الاحتراق في قاع المقلاة",
 "stirringly": "بحماس, بشكل مثير للمشاعر (بطريقة تحرك المشاعر)\nمثال: تحدث بشكل مثير للمشاعر عن أيامه خلال الحرب",
 "stirrup": "رِكَاب",
 "stirrup cup": "كأس الوداع (مشروب وداع (خاصة الذي يقدم لراكب الخيل المستعد للمغادرة)؛ عادة ما يكون كحولياً)",
 "stirrup iron": "ركاب (دعامة تتكون من حلقات معدنية توضع فيها أقدام الراكب)",
 "stirrup pump": "مضخة ركاب (مضخة ترددية تعمل باليد؛ تستخدم في مكافحة الحرائق)",
 "stirrup-shaped": "رِكَابِيّ الشَّكْل (على شكل رِكاب)",
 "stitch": "غَرَزَة",
 "stitched": "مَخِيط, مُرَقَّع (مثبّت بغُرَز خياطة)",
 "stitcher": "عامل خياطة (صانع ملابس ينفذ خطوات التشطيب)",
 "stitchery": "خياطة (أشغال إبرة تعمل عليها بإبرة وخيط)\nمثال: أعادت خياطتها إلى السلة",
 "stitching": "حياكة, خياطة (وصل أو تثبيت بواسطة الغرز)",
 "stitchwort": "حشيشة القزاز الكبرى (عشبة منخفضة النمو في المنطقة المعتدلة الشمالية ذات أزهار بيضاء صغيرة على شكل نجمة؛ سميت لقدرتها المزعومة على تخفيف الآلام الحادة في الجانب)",
 "stizolobium deeringiana": "فاصولياء مخملية, ميقونة (كرمة خشبية حولية من آسيا لها عناقيد طويلة من الزهور الأرجوانية وقرون مشعرة كثيفة؛ تزرع في جنوب الولايات المتحدة للسماد الأخضر والرعي)",
 "stizostedion vitreum": "الوالي, سمك الجاحظ (أسماك فرخ المياه العذبة تشبه الكراكي)",
 "stm": "ذاكرة فورية, ذاكرة قصيرة المدى (ما يمكنك تكراره فوراً بعد إدراكه)",
 "stoat": "قاقم (حيوان القاقم في معطفه الصيفي البني مع ذيل أسود الطرف)",
 "stob": "عصا قصيرة, وتد قصير (عصا خشبية قصيرة ومستقيمة)",
 "stochastic": "عَشْوَائيّ, غَيْر مُصَمَّم",
 "stochastic process": "عملية عشوائية (عملية إحصائية تنطوي على عدد من المتغيرات العشوائية التي تعتمد على متغير بارامتري (عادة ما يكون الوقت))",
 "stochastic variable": "متغير عشوائي (كمية متغيرة عشوائية)",
 "stochastically": "بشكل تصادفي, عشوائياً (بوسائل عشوائية (احتمالية))\nمثال: قدرنا الإجابة عشوائياً",
 "stochasticity": "اعْتِبَاطِيَّة, عَشْوَائِيَّة (صفة الافتقار إلى أي نظام أو خطة يمكن التنبؤ بها)",
 "stock": "جَرْد, خَزِين (جَرَدَ الشيءَ: أحصى ما فيه، ضبط قيمته؛ جَرَدَ البطاطسَ: قشّرها وأزال ما عليها) / مَخْزُون / مَرَقَة, حَسَاء (الطَعَام السائل الخفيف فيه ماء اللحم وقد يكون فيه خضار أو غير ذلك. يؤكل عادة مع الرز أو الخبز. يجوز قول مَرَق، والمَرَقَة أخص من المرَق) / مَنْثُور / قَنْدَاق\nمثال: كان سامي جرد طفل.",
 "stock breeder": "مربي حيوانات, مُرَبٍّ (شخص يقوم بتربية الحيوانات بغرض التكاثر والإنتاج)",
 "stock buyback": "إعادة شراء الأسهم (شراء الشركة لأسهمها القائمة؛ مما يزيد من ربحية السهم وبالتالي يرتفع سعر السهم (مما قد يثبط محاولات الاستحواذ))",
 "stock car": "سيارة سباق قياسية (سيارة سباق بالهيكل الأساسي لسيارة متاحة تجارياً) / سيارة مخزنة (سيارة محفوظة في مخزون التجار للبيع المنتظم)",
 "stock certificate": "سهم, شهادة سهم (شهادة توثق ملكية المساهم في الشركة)\nمثال: تضاعفت قيمة أسهمه خلال العام الماضي",
 "stock company": "فرقة ريبيرتوار, فرقة مسرحية دائمة (فرقة مسرحية تؤدي مسرحيات من مخزون جاهز) / شركة مساهمة (شركة يتم تمثيل رأس مالها بأسهم)",
 "stock cube": "مكعب مرقة (مكعب من المرق المجفف)",
 "stock dividend": "أرباح الأسهم, توزيعات أسهم (أرباح مدفوعة في شكل أسهم بدلاً من النقد)",
 "stock epithet": "نعت نمطي, وصف تقليدي (كلمة أو عبارة وصفية يستخدمها المؤلف بانتظام أو بشكل قياسي لوصف شيء أو شخص)\nمثال: النعوت النمطية شائعة الاستخدام في الأدب القائم على التقاليد الشفهية القوية",
 "stock exchange": "بُورْصَة, سُوقُ الْأَوْرَاقِ الْمَالِيَّةِ",
 "stock farmer": "مربي الماشية, مربي المواشي (مزارع يقوم بتربية المواشي وتنميتها)",
 "stock image": "صورة أرشيفية, صورة مخزنة (صورة موجودة يتم ترخيصها لاستخدام محدد)",
 "stock index": "مؤشر سوق الأسهم (مؤشر يعتمد على تجميع إحصائي لأسعار أسهم عدد من الأسهم التمثيلية)",
 "stock issue": "إصدار أسهم (تفويض وتسليم أسهم للبيع للجمهور)",
 "stock list": "جرد, مخزون (قائمة مفصلة بجميع العناصر في المخزون)",
 "stock market": "سُوقُ الْأَوْرَاقِ الْمَالِيَّةِ, بُورْصَة (مكان للبيع والشراء؛ جمع ساق، قال الله تعالى: 《رُدُّوهَا عَلَيَّ فَطَفِقَ مَسْحًا بِالسُّوقِ وَالْأَعْنَاقِ》)\nمثال: ذهبت إلى السوق.",
 "stock market index": "مؤشر سوق الأسهم (مؤشر يعتمد على تجميع إحصائي لأسعار أسهم عدد من الأسهم التمثيلية)",
 "stock of record": "أسهم مسجلة (أسهم يحتفظ بها المساهمون المسجلون في تاريخ معين)",
 "stock option": "خيار الأسهم, خيار شراء الأسهم (ميزة تمنحها الشركة للموظف في شكل خيار لشراء أسهم في الشركة بخصم أو بسعر ثابت) / خيار الأسهم (الحق في شراء أو بيع سهم بسعر محدد خلال فترة محددة)",
 "stock photograph": "صورة أرشيفية, صورة مخزنة (صورة موجودة يتم ترخيصها لاستخدام محدد)",
 "stock power": "توكيل نقل ملكية أسهم (وثيقة توكيل لنقل ملكية ورقة مالية مسجلة من المالك إلى طرف آخر)",
 "stock purchase plan": "خطة شراء الأسهم (خطة منظمة لموظفي الشركة لشراء أسهم من أسهمها)",
 "stock raiser": "مربي الماشية, مربي المواشي (مزارع يقوم بتربية المواشي وتنميتها)",
 "stock room": "غرفة البضائع, مستودع (مخزن لتخزين البضائع والمستلزمات المستخدمة في العمل التجاري)",
 "stock saddle": "سرج غربي (سرج مزخرف يستخدمه رعاة البقر؛ له قرن مرتفع لحمل الوهق)",
 "stock split": "تجزئة الأسهم (زيادة في عدد الأسهم القائمة للشركة دون تغيير حقوق المساهمين)\nمثال: أعلنوا عن تجزئة اثنين مقابل واحد للأسهم العادية",
 "stock symbol": "رمز السهم (الأحرف المستخدمة لتحديد الشركات المدرجة في البورصات حيث يتم تداولها)",
 "stock ticker": "جهاز التيكر, شريط الأسعار (طابعة أحرف تطبع تلقائياً أسعار الأسهم على شريط ورقي)",
 "stock trader": "متداول أسهم (شخص يشتري ويبيع الأسهم)",
 "stock warrant": "حَقّ خِيَار الشِّرَاء, مُذَكِّرَة اكْتِتَاب (شهادة مكتوبة تعطي حاملها الحق في شراء أسهم بسعر محدد خلال فترة زمنية محددة) / مذكرة الاكتتاب, مذكرة ضمان الأسهم (نوع من الأوراق المالية تصدره شركة (عادة مع سند أو سهم ممتاز) يمنح حامله الحق في شراء كمية معينة من الأسهم العادية بسعر محدد)",
 "stock-in-trade": "أدوات المهنة, عدة العمل (أي معدات تستخدم باستمرار كجزء من مهنة أو وظيفة)\nمثال: الود هو أداة البائع في عمله",
 "stock-index futures": "عقود آجلة لمؤشر الأسهم (عقد مستقبلي يعتمد على مؤشر أسهم؛ رهان على السعر المستقبلي لمجموعة الأسهم المفهرسة)",
 "stock-purchase warrant": "مذكرة الاكتتاب, مذكرة ضمان الأسهم (نوع من الأوراق المالية تصدره شركة (عادة مع سند أو سهم ممتاز) يمنح حامله الحق في شراء كمية معينة من الأسهم العادية بسعر محدد)",
 "stock-still": "بسكون تام, بلا حراك (بدون حركة أو إصدار صوت) / رَاسِخ, مُتَسَمِّر (ساكن تمامًا؛ لا يتحرك إطلاقًا)\nمثال: جلس بلا حراك كالتمثال",
 "stock-take": "عملية جرد (حالة من الجرد)",
 "stock-taker": "جارد المخزون (موظف وظيفته إجراء جرد للمخزون)\nمثال: كان يجب استئجار جارد مخزون خارجي",
 "stock-taking": "إحصاء المخزون, جرد (عمل قائمة مفصلة بالبضائع أو الإمدادات المتاحة) / تقييم الموقف, جرد (إعادة تقييم لوضع أو منصب أو نظرة مستقبلية)\nمثال: قد يكون الجرد ضرورياً لمعرفة ما إذا كان هناك شيء مفقود",
 "stockade": "محتشد, معسكر اعتقال (معسكر عقابي يتم فيه احتجاز السجناء السياسيين أو أسرى الحرب (عادة في ظل ظروف قاسية)) / سياج خشبي محصن (تحصين يتكون من سياج مصنوع من صف من الأعمدة القوية المثبتة بإحكام للدفاع)",
 "stockbroker": "سمسار بورصة, وسيط أوراق مالية (وكيل في بيع وشراء الأسهم والسندات)",
 "stockbroker belt": "ضاحية الأثرياء (ضاحية سكنية للأثرياء)",
 "stockcar": "عربة نقل المواشي (عربة شحن مغلقة بجوانب شبكية؛ لنقل الماشية)",
 "stocked": "مُخَزَّن, مُمَوَّن (مُزوَّد بأكثر مما يكفي من البضائع أو المواد)",
 "stocked with": "مُخَزَّن, مُمَوَّن (مُزوَّد بأكثر مما يكفي من البضائع أو المواد)",
 "stocker": "ماشية تسمين (حيوان داجن (خاصة عجل صغير) يتم الاحتفاظ به كماشية حتى يتم تسمينه أو نضجه ومناسبته لمؤسسة التربية)",
 "stockfish": "سمك مجفف (سمك محفوظ بشقه وتجفيفه بالهواء دون ملح)",
 "stockholder": "حامل أسهم, مساهم (شخص يمتلك حصصاً من الأسهم في شركة مساهمة)",
 "stockholder of record": "المساهم المسجل (المساهم الذي سُجل اسمه في دفاتر الشركة كمالك للأسهم في وقت معين)",
 "stockholders meeting": "اِجْتِمَاع المُسَاهِمِين, جَمْعِيَّة عُمُومِيَّة (اجتماع تقدم فيه الإدارة تقارير لمساهمي الشركة)",
 "stockholding": "حِيَازَة الأَسْهُم (ملكية الأسهم؛ حالة أو حقيقة امتلاك الأسهم) / حيازة أسهم (عدد محدد من الأسهم المملوكة)\nمثال: بيع حيازات الأسهم التي يملكها في الشركات",
 "stockholdings": "حيازة أسهم (عدد محدد من الأسهم المملوكة)\nمثال: بيع حيازات الأسهم التي يملكها في الشركات",
 "stockholm": "سْتُوكْهُولْم, إِسْتُوكْهُولْم",
 "stockhorn": "مزمار القرن, هورن بايب (آلة نفخ خشبية قديمة (لم تعد مستخدمة) ذات قصبة واحدة؛ مصنوعة عادة من العظم)",
 "stockily": "باكتناز, بامتلاء وقصر (بطريقة ممتلئة الجسم وقصيرة)\nمثال: كان ممتلئ البنية",
 "stockiness": "اكتناز, تراص (جودة كونه مدمجاً وقوياً وسميك البنية نسبياً)\nمثال: لا تخطئ، اكتنازه يخفي روتيناً يومياً شاقاً من التمارين ورؤيته بدون العدسات الزجاجية العادية ممتازة",
 "stockinet": "ستوكينيت (نسيج محبوك يستخدم بشكل خاص لملابس الرضع والملابس الداخلية)",
 "stockinette": "ستوكينيت (نسيج محبوك يستخدم بشكل خاص لملابس الرضع والملابس الداخلية)",
 "stockinette stitch": "غرزة الجورب, غرزة سادة (غرزة حياكة لها صفوف متبادلة من الغرز العدلة والمقلوبة، تنتج نسيجاً كما في الجوارب)",
 "stocking": "جَوْرَب",
 "stocking cap": "قبعة تزلج, قبعة صوفية (قبعة صوفية محكمة القياس؛ غالباً ما يكون لها ذيل مستدق مع شرابة)",
 "stocking filler": "هدية صغيرة (هدية عيد ميلاد صغيرة توضع في جورب عيد الميلاد)",
 "stocking stuffer": "هدية صغيرة (هدية عيد ميلاد صغيرة توضع في جورب عيد الميلاد)",
 "stockinged": "مُرْتَدٍ جَوَارِب (يرتدي جوارب طويلة)",
 "stockist": "بائع معتمد, مخزن بضائع (جهة (كتاجر تجزئة أو موزع) تقوم بتخزين البضائع)",
 "stockjobber": "مضارب أسهم (شخص يتعامل فقط مع الوسطاء أو المضاربين الآخرين)",
 "stockman": "مربي مواشي (مزارع ذكر يقوم بتربية الماشية)",
 "stockpile": "مخزون, مخزون احتياطي (كومة تخزين متراكمة للاستخدام المستقبلي) / احتياطي, مخزون استراتيجي (شيء يُحتفظ به أو يُدخر للاستخدام المستقبلي أو لغرض خاص)",
 "stockpiling": "تخزين احتياطي (تجميع وتخزين إمدادات احتياطية)\nمثال: تخزين مواد الحرب",
 "stockpot": "قدر مرق (وعاء يستخدم لإعداد مرق الحساء)",
 "stockroom": "غرفة البضائع, مستودع (مخزن لتخزين البضائع والمستلزمات المستخدمة في العمل التجاري)",
 "stocks": "مقطرة (أداة عقاب سابقة تتكون من إطار خشبي ثقيل بفتحات يمكن فيها قفل قدمي (وأحياناً يدي) المخالف) / ملقط تثبيت الحيوانات (إطار لتقييد الحيوان أثناء تلقيه رعاية بيطرية أو أثناء وضع حدوة له) / دعامات بناء السفن (إطار يدعم قارباً أثناء البناء)",
 "stocktake": "عملية جرد (حالة من الجرد)",
 "stocktaker": "جارد المخزون (موظف وظيفته إجراء جرد للمخزون)\nمثال: كان يجب استئجار جارد مخزون خارجي",
 "stocktaking": "إحصاء المخزون, جرد (عمل قائمة مفصلة بالبضائع أو الإمدادات المتاحة) / تقييم الموقف, جرد (إعادة تقييم لوضع أو منصب أو نظرة مستقبلية)\nمثال: قد يكون الجرد ضرورياً لمعرفة ما إذا كان هناك شيء مفقود",
 "stockwoman": "مربية مواشي (مزارعة أنثى تقوم بتربية الماشية)",
 "stocky": "مَتِين البُنْيَة, مُمْتَلِئ الجِسْم (ذو بنية قصيرة وصلبة)",
 "stockyard": "حظيرة مواشي (ساحة مسيجة حيث يتم الاحتفاظ بالماشية أو الخنازير أو الخيول أو الأغنام مؤقتاً)",
 "stodge": "طعام ثقيل, طعام نشوي (طعام ثقيل ومشبع (وعادة ما يكون نشوياً))",
 "stodgily": "بتزمت, برسمية مملة (بطريقة متزمتة ومملة)\nمثال: قال بتزمت: 'تفضل بالدخول'",
 "stodginess": "ثقل دم, جمود (وقار ممل ومتغطرس)",
 "stodgy": "جَامِد, مُمِلّ (تَقْلِيدِيٌّ بِإِفْرَاطٍ وَيَفْتَقِرُ لِلخَيَالِ مِمَّا يَجْعَلُهُ مُمِلًّا) / رَجْعِيّ, مُتَحَجِّر ((ازدرائيًّا) قَدِيم الطِّرَاز وَمُتَخَلِّف عَنِ العَصْر) / ثَقيل, نَشَوِيّ (ثَقيل ومَليء بِالنَّشا وصَعْب الهَضْم)",
 "stoep": "بسطة المدخل, عتبة (شرفة صغيرة أو مجموعة من الدرجات عند المدخل الأمامي للمنزل)",
 "stogie": "ستوجي (سيجار رخيص)",
 "stogy": "ستوجي (سيجار رخيص)",
 "stoic": "رِوَاقِيّ / جَلِد, رَزِين (ضَرَبَ بشدّة بعصا أو سوط أو نحوهما؛ تَحَمَّلَ المصاعب بصبر وشدّة)\nمثال: هذا حزام من الجلد.",
 "stoical": "رُوَاقِيّ, صَبُور (يبدو غير متأثّر باللذة أو الألم؛ جَلْد)",
 "stoically": "بجلد, برباطة جأش (بدون عاطفة؛ بطريقة رواقية)\nمثال: تقبل كل المعاناة بجلد",
 "stoichiometric": "ستوكيومتري, متكافئ العناصر (مكون من أو متعلق بقياس اتحادية العناصر (الستوكيومتريا))",
 "stoichiometry": "سْتُويكُيُومِتْرِيّ, قِيَاس اِتِّحَادِيّ ((الكيمياء) العلاقة بين كميات المواد التي تشارك في تفاعل أو تكون مركباً (عادة ما تكون نسبة من أعداد صحيحة))",
 "stoicism": "رِوَاقِيَّة",
 "stokehold": "عنبر الوقود, غرفة الإيقاد (حجرة أو مقصورة في السفينة يتم فيها إيقاد الأفران)",
 "stokehole": "عنبر الوقود, غرفة الإيقاد (حجرة أو مقصورة في السفينة يتم فيها إيقاد الأفران)",
 "stoker": "عَطَشْجِيّ",
 "stokes' aster": "أستر ستوكس (نبات معمر قائم من جنوب شرق الولايات المتحدة له رؤوس كبيرة من الزهور الزرقاء عادة)",
 "stokes-adams syndrome": "إحصار القلب, حصار أذيني بطيني (نوبات مفاجئة متكررة من فقدان الوعي ناجمة عن ضعف توصيل الإشارة التي تنظم ضربات القلب)",
 "stokesia laevis": "أستر ستوكس (نبات معمر قائم من جنوب شرق الولايات المتحدة له رؤوس كبيرة من الزهور الزرقاء عادة)",
 "stole": "ستول, وشاح كتف عريض (وشاح عريض ترتديه النساء حول أكتافهن)",
 "stolen": "مَسْرُوق",
 "stolen property": "ممتلكات مسروقة (الممتلكات التي تمت سرقتها)",
 "stolid": "بَلِيد, جَامِدُ المَلَامِح (قليل العاطفة أو الحساسية؛ لا ينفعل بسهولة)",
 "stolidity": "بلادة, جلد (اللامبالاة باللذة أو الألم) / برود عاطفي, جمود (اللامبالاة التي تظهر من خلال غياب ردود الفعل العاطفية)",
 "stolidly": "ببلادة, بفتور (بطريقة بليدة)\nمثال: قال 'لا' ببلادة",
 "stolidness": "بلادة, جلد (اللامبالاة باللذة أو الألم)",
 "stollen": "إشتولن",
 "stolon": "رئد, ساق جارية (فرع أفقي من قاعدة النبات ينتج نباتات جديدة من براعم في أطرافه)",
 "stoloniferous": "رئدي (منتج للرئد (ساق زاحفة))",
 "stoma": "فغرة (فم أو فتحة تشبه الفم (خاصة تلك التي يتم إنشاؤها جراحياً على سطح الجسم لإنشاء فتحة لعضو داخلي)) / ثغر, مسام (مسام بشروي دقيق في ورقة أو ساق يمكن للغازات وبخار الماء المرور من خلاله)",
 "stomach": "مَعِدَة, مِعْدَة",
 "stomach ache": "ألم المعدة, مغص (وجع موضعي في المعدة أو منطقة البطن)",
 "stomach exercise": "تمرين بطن (تمرين مصمم لتقوية عضلات البطن)",
 "stomach flu": "التهاب المعدة والأمعاء (التهاب في المعدة والأمعاء)",
 "stomach pump": "مضخة معدة (مضخة شفط تستخدم لإزالة محتويات المعدة)",
 "stomach sweetbread": "بنكرياس, حلويات البطن (بنكرياس الحيوان الصالح للأكل)",
 "stomach upset": "عسر الهضم (اضطراب في وظيفة الجهاز الهضمي يتميز بعدم الراحة أو حرقة المعدة أو الغثيان)",
 "stomachache": "مَغْص",
 "stomachal": "معدي (متعلق بـ أو ينطوي على المعدة)\nمثال: قرحة معدية",
 "stomacher": "صدرية مزخرفة (المنسوبة إلى الصدر، غالبا ما يقصد بالصدر معنى الجزء من جسم الإنسان؛ في : هي المَرْيُول، ثوب يُغطي الجزء الأمامي من الجسم ويُربط من خلف يُرتدى فوق الملابس لحمايتها أثناء الطبخ أو العمل. الجمع صداري)",
 "stomachic": "معدي (متعلق بـ أو ينطوي على المعدة)\nمثال: قرحة معدية",
 "stomatal": "ثغري (يتعلق بـ أو يشكل الثغور النباتية) / فموي (يتعلق بـ أو ذو طبيعة فموية أو له فتحة تشبه الفم)\nمثال: فتحات ثغرية",
 "stomate": "ثغر, مسام (مسام بشروي دقيق في ورقة أو ساق يمكن للغازات وبخار الماء المرور من خلاله)",
 "stomatitis": "التهاب الفم (التهاب الغشاء المخاطي للفم)",
 "stomatopod": "فميات الأرجل (نوع من القشريات)",
 "stomatopod crustacean": "فميات الأرجل (نوع من القشريات)",
 "stomatous": "فموي (له فم أو فتحة تشبه الفم) / ثغري (يتعلق بـ أو يشكل الثغور النباتية) / فموي (يتعلق بـ أو ذو طبيعة فموية أو له فتحة تشبه الفم)\nمثال: فتحات ثغرية",
 "stomp": "دَاسَ, دَهَسَ (داس الأرض: وطئها بالقدم؛ داس الشيء: أهانه أو احتقره)\nمثال: شخص ما داس على قدمي.",
 "stomper": "داهس, ضارب بقدمه (شخص يمشي بمشية ثقيلة صاخبة أو يضرب بقدمه على الأرض)",
 "stone": "حَجَر, حجر (حَجَرَ عليه الأمرَ:مَنَعَه منه ، حجر الشّيء على نفسه:خَصَّها به وقصره عليها؛ الحجْرُ: المَنْعُ مِن التَّصَرُّفِ ، وحَجَرَ عَلَيْهِ القاضِي يَحْجُرُ حَجْراً، إِذا مَنَعَه مِن التَّصَرُّفِ فِي مالِه) / حجر, حصى (حَجَرَ عليه الأمرَ:مَنَعَه منه ، حجر الشّيء على نفسه:خَصَّها به وقصره عليها؛ الحجْرُ: المَنْعُ مِن التَّصَرُّفِ ، وحَجَرَ عَلَيْهِ القاضِي يَحْجُرُ حَجْراً، إِذا مَنَعَه مِن التَّصَرُّفِ فِي مالِه) / نواة, عضم / رَجَمَ (رَجَمَ:تكلّم بالظنّ ويُقال:رجم بـ الغيب تكلّم بما لا يعلم ،والقبر :وضع عليه الرّجام،رجمه رَجْماً:رماه بالحجارة وقتله بها…؛ رجم الشخص:رماه بالحجارة ، أو قتله بها (رجم الشّعبُ القتلةَ)،رجمه بالقول:قذفه وشتمه،رجم بالغيب:تكلّم بما لا يعلم)\nمثال: عوقب زيري بالحجر.",
 "stone age": "الْعَصْر الْحَجَرِيّ, عَصْر حَجَرِيّ",
 "stone bass": "قاروص الحجارة (سمكة بنية من المحيط الأطلسي والبحر الأبيض المتوسط توجد حول الصخور وحطام السفن)",
 "stone bramble": "عليق الحجر (عليق زاحف أوروبي بثمار تشبه التوت الأحمر)",
 "stone breaker": "كسّار الحجارة (شخص يكسر الحجارة)",
 "stone crab": "سرطان الحجر (سرطان كبير صالح للأكل من الساحل الجنوبي للولايات المتحدة (خاصة فلوريدا)) / سلطعون حجري (لحم شاحب ذو ملمس ونكهة دقيقة؛ يوجد في فلوريدا ولكنه الآن نادر جداً)",
 "stone cress": "أيثيونيما, رشاد الصخر (أي عشب من العالم القديم من جنس أيثيونيما؛ موطنه الموائل الجيرية المشمسة)",
 "stone curlew": "كروان الحصى (طائر شاطئي كبير الرأس والعينين ينشط عند الغسق أو ليلاً من العالم القديم وأمريكا الاستوائية وله مفصل ركبة سميك)",
 "stone drill": "ريشة حفر الصخر, مثقاب الصخور (مثقاب لاختراق الصخور)",
 "stone facing": "تكسية حجرية, جدار ساند (تكسية (عادة من البناء) تدعم سداً أو حافة ترابية)",
 "stone fly": "ذبابة الحجر (حشرة مجنحة بدائية بجسم مسطح؛ تستخدم كطعم من قبل الصيادين؛ اليرقات المائية ذات الخياشيم لاحمة وتعيش تحت الحجارة)",
 "stone fruit": "ثمرة نووية, حسلة (فاكهة لحمية غير متفتحة ذات بذرة واحدة: مثل اللوز والخوخ والبرقوق والكرز والخمان والزيتون والعناب)",
 "stone life face": "الحصى الحية, ليثوبس",
 "stone marten": "دلق الحجر (دلق أوراسي ذو معطف بني مع صدر وحلق شاحب)",
 "stone mimicry plant": "جرانيت حي, صخر حي (نباتات شديدة العصارية عديمة الساق تشكل كُتلاً بأوراق رمادية مخضرة تشبه في نسيجها كتل الجرانيت؛ جنوب أفريقيا)",
 "stone parsley": "جزر القمر, سيسيلي (جَزَرَ الماءُ عن الأَرضِ يَجْزُرُ جَزْراً: نَضَبَ وحَسَرَ؛ ويقال: جَزَرَ البَحْرُ والنَّهْرُ: انْحسرَ ماؤُهُ) / بقدونس الحجر, سيسون (عشب نحيل على جانب الطريق في غرب أوروبا ومناطق البحر الأبيض المتوسط له أوراق تشبه البقدونس وأزهار بيضاء مع بذور عطرية)\nمثال: ضع الجزر في القدر.",
 "stone pine": "صنوبر المظلة, صنوبر ثمري (صنوبر ثنائي الإبر متوسط الحجم من جنوب أوروبا له تاج منتشر؛ يزرع على نطاق واسع لبذوره الحلوة التي تشبه اللوز)",
 "stone pit": "حفرة, محجر (حفر سطحي لاستخراج الحجر أو الأردواز)",
 "stone plant": "الحصى الحية, ليثوبس",
 "stone root": "بلسم الحصان, جذر الحجر (عشب معمر قائم قوي الرائحة بأوراق مسننة مدببة وعثكول فضفاض من الزهور المصفرة؛ شرق الولايات المتحدة)",
 "stone splitter": "آلة شق الحجر (آلة لشق الحجر الطبيعي بما في ذلك الجرانيت والرخام والحجر الرملي)",
 "stone splitting machine": "آلة شق الحجر (آلة لشق الحجر الطبيعي بما في ذلك الجرانيت والرخام والحجر الرملي)",
 "stone wall": "جدار حجري (سياج مبني من الحجارة الخشنة؛ يستخدم لفصل الحقول)",
 "stone's throw": "عَلَى مَرْمَى حَجَر (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال.",
 "stone-blind": "أَعْمَى تَمَامًا (فاقد البصر كُلِّيًّا)",
 "stone-broke": "مُفْلِس (يفتقر إلى الأموال)",
 "stone-cold": "بَارِد تَمَامًا (بارد بالكامل؛ فاقد الحرارة كلّيًّا)",
 "stone-dead": "مَيِّت تَمَامًا (ميت كالحجر؛ بلا أي علامة حياة)",
 "stone-deaf": "أَصَمُّ تَمَامًا, أَصَمُّ كَالحَجَرِ (أصم كلياً؛ عاجز عن سماع أي شيء)",
 "stone-face": "الحصى الحية, ليثوبس",
 "stone-gray": "رَمَادِيّ أَرْدُوَازِيّ (بلون الأردواز أو الجرانيت)",
 "stone-grey": "رَمَادِيّ أَرْدُوَازِيّ (بلون الأردواز أو الجرانيت)",
 "stone-root": "بلسم الحصان, جذر الحجر (عشب معمر قائم قوي الرائحة بأوراق مسننة مدببة وعثكول فضفاض من الزهور المصفرة؛ شرق الولايات المتحدة)",
 "stone-sober": "صَاحٍ تَمَامًا (فِي حَالَة صَحْوٍ كَامِل)",
 "stonechat": "قليعي مطوق (طائر أوروبي شائع ذو ريش أسود وصدر بني محمر)",
 "stonecress": "أيثيونيما, رشاد الصخر (أي عشب من العالم القديم من جنس أيثيونيما؛ موطنه الموائل الجيرية المشمسة)",
 "stonecrop": "حَيّ الْعَالَم (ضد المَيِّت، على قيد الحَيَاة؛ جمع حَيَاء)\nمثال: ينبح كلب في الحي.",
 "stonecutter": "قاطع الحجارة, نحات الحجارة (شخص يقطع أو ينحت الحجر)",
 "stoned": "مَسْطُول (تَحْتَ تَأْثِير المُخَدِّرَات وَخَاصَّةً القِنَّب)",
 "stoneface": "الحصى الحية, ليثوبس",
 "stonefish": "السمكة الصخرية (سمكة بحرية استوائية سامة تشبه قطعة من الصخر)",
 "stonefly": "ذبابة الحجر (حشرة مجنحة بدائية بجسم مسطح؛ تستخدم كطعم من قبل الصيادين؛ اليرقات المائية ذات الخياشيم لاحمة وتعيش تحت الحجارة)",
 "stonehenge": "سْتُونْهِنْج",
 "stoneless": "مَنْزُوعُ النَّوَاة ((في الفواكه ذات النوى) أُزيلت نواته)",
 "stonelike": "شَبِيه بِالحَجَر, صَخْرِيّ (ذو كَثافَة وصَلابَة كَالصَّخْر)",
 "stonemason": "بنّاء, حجّار (حرفي يعمل بالحجر أو الطوب)",
 "stoner": "حَشَّاش",
 "stoneroot": "بلسم الحصان, جذر الحجر (عشب معمر قائم قوي الرائحة بأوراق مسننة مدببة وعثكول فضفاض من الزهور المصفرة؛ شرق الولايات المتحدة)",
 "stoneseed": "قُلْب",
 "stonewaller": "مُتَعَنِّت, مُماطِل (الشخص الذي يماطل أو يرفض الإجابة أو التعاون؛ شخص يؤخر الأمور بخطب طويلة ونحوها)",
 "stonewalling": "تسويف, تعنت (المماطلة أو التأخير خاصة برفض الإجابة على الأسئلة أو التعاون)",
 "stoneware": "فخار حجري (أواني خزفية يتم حرقها في حرارة عالية وتكون مزججة وغير مسامية)",
 "stonework": "أعمال حجرية (بناء يتم باستخدام الحجر)",
 "stonewort": "عشب الحجر, كارا (أي من الطحالب المائية المغمورة المختلفة من جنس كارا لها عقد ذات فروع تشبه الخيوط؛ عادة ما تكون مغطاة برواسب كربونات الكالسيوم)",
 "stonily": "بتحجر, بجمود (بطريقة حجرية قاسية)\nمثال: غير مبال بالوقت بجمود",
 "stoning": "رجم (فعل الرمي بالحجارة؛ عقاب يتم برمي الحجارة على الضحية (حتى الموت))",
 "stony": "حَجَرِيّ, صَخْرِيّ (شَبيه بالصَّخْر أو الغْرانِيت في الصَّلابَة) / عَنيد, غَليظ (شَديد القَسْوَة وعَديم الرَّحْمَة؛ لا يَرِقّ قَلْبُه) / حَجَرِيّ, صَخْرِيّ (مليء بالصخور أو الأحجار)",
 "stony coral": "مرجان حجري (مرجان له هياكل جيرية تشكل تجمعاتها شعاباً وجزراً)",
 "stony-broke": "مُفْلِس (يفتقر إلى الأموال)",
 "stonyhearted": "عَدِيمُ الإِحْسَاس, قَاسِي القَلْب (خالٍ من الشعور بالآخرين والتعاطف معهم)",
 "stooge": "أضحوكة, هدف السخرية (ضحية للسخرية أو المقالب) / إِمَّعَة, تابِع ذَلِيل (شخص يطيع دون تساؤل)",
 "stool": "مِقْعَد (كل ما يُقْعَدُ ويُجْلَسُ عليه؛ مَكَان القُعُود) / مَقْعَدَة / بِرَاز\nمثال: نام ياني على مقعد.",
 "stool pigeon": "حمامة شرك (حمامة وهمية تستخدم كشرك للآخرين) / عصفورة, مخبر للشرطة (شخص يعمل كمخبر أو طُعم للشرطة)",
 "stool test": "فحص البراز, فحص الدم الخفي في البراز (اختبار يتم إجراؤه في المنزل للكشف عن آثار الدم في البراز)",
 "stoolie": "عصفورة, مخبر للشرطة (شخص يعمل كمخبر أو طُعم للشرطة)",
 "stoolpigeon": "عصفورة, مخبر للشرطة (شخص يعمل كمخبر أو طُعم للشرطة)",
 "stoop": "انحناء (انحناء النصف العلوي من الجسم للأمام وللأسفل) / بسطة المدخل, عتبة (شرفة صغيرة أو مجموعة من الدرجات عند المدخل الأمامي للمنزل) / حوض الماء المقدس (حوض للماء المقدس)",
 "stooped": "مُحْدَوْدِب, مُنْحَنِي الظَّهْر (ذو ظهر وكتفَين مُنحنيَين؛ غير منتصب)",
 "stooper": "مُنْحَنِي الظَّهْر (شخص يحمل نفسه ورأسه وكتفاه منحنيان للأمام عادة) / جَامِع التَّذَاكِر (شخص في مضمار سباق يبحث عن تذاكر الرهان الرابحة التي تم التخلص منها بإهمال من قبل الآخرين)",
 "stooping": "مُحْدَوْدِب, مُنْحَنِي الظَّهْر (ذو ظهر وكتفَين مُنحنيَين؛ غير منتصب)",
 "stop": "وَقَفَ, تَوَقَّفَ (قَامَ، اِنْتَصَبَ، نَهَضَ؛ ثَبَتَ) / أَوْقَفَ, وَقَفَ / تَوَقَّفَ, وَقَّف / مَوْقِف / وَقْفَة\nمثال: وقف وراء الباب.",
 "stop bath": "حمام إيقاف (حمام حمضي يستخدم لإيقاف عمل المظهر في التحميض الفوتوغرافي)",
 "stop consonant": "صامت وقفي, صوت انفجاري (صامت يُنتج عن طريق إيقاف تدفق الهواء عند نقطة معينة ثم إطلاقه فجأة)",
 "stop leak": "مانع التسرب (سائل يضاف إلى المبرد لوقف التسربات)\nمثال: استخدام مانع التسرب هو حل سريع للمشكلة وليس إصلاحًا دائمًا",
 "stop number": "النِّسْبَة البُؤْرِيَّة, رَقَم البُؤْرَة (نسبة البعد البؤري إلى قطر نظام عدسة (الكاميرا))",
 "stop order": "أمر وقف, أمر وقف الخسارة (أمر لوسيط بالبيع (أو الشراء) عندما ينخفض (أو يرتفع) سعر ورقة مالية إلى مستوى محدد)",
 "stop payment": "إيقاف صرف شيك (أمر من المودع للبنك برفض صرف شيك)",
 "stop press": "خبر عاجل (مطبعة) (أخبار متأخرة يتم إدراجها في الصحيفة في اللحظة الأخيرة)",
 "stop sign": "علامة قف (علامة تأمر السائقين بالتوقف والانتظار حتى يتمكنوا من المتابعة بأمان)",
 "stop watch": "ساعة إيقاف (ساعة يمكن تشغيلها أو إيقافها لقياس الوقت بدقة (كما في السباق))",
 "stop-leak": "مانع التسرب (سائل يضاف إلى المبرد لوقف التسربات)\nمثال: استخدام مانع التسرب هو حل سريع للمشكلة وليس إصلاحًا دائمًا",
 "stop-limit order": "أمر إيقاف محدد (أمر يوضع لدى وسيط يتم تنفيذه بعد الوصول إلى سعر إيقاف معين، ويصبح بعد ذلك أمراً محدداً للشراء (أو البيع) بالسعر المحدد أو أفضل)",
 "stop-loss order": "أمر وقف, أمر وقف الخسارة (أمر لوسيط بالبيع (أو الشراء) عندما ينخفض (أو يرتفع) سعر ورقة مالية إلى مستوى محدد)",
 "stop-motion": "إِيقَاف الْحَرَكَة",
 "stopcock": "مِحْبَس",
 "stopgap": "بديل مؤقت, حل مؤقت (شيء يتم تدبيره لتلبية حاجة ملحة أو طارئة)",
 "stoplight": "إشارة المرور, ضوء المرور (إشارة بصرية للتحكم في تدفق حركة المرور عند التقاطعات) / ضوء التوقف, ضوء الفرامل (ضوء أحمر في الجزء الخلفي من المركبة يشير إلى استخدام الفرامل للإبطاء أو التوقف)",
 "stopover": "توقف, محطة استراحة (إقامة قصيرة أثناء رحلة) / استراحة, محطة توقف (مكان توقف في رحلة)\nمثال: توقفوا لزيارة أصدقائهم",
 "stoppable": "قابل للإيقاف (يمكن إيقافه)\nمثال: إذا زدنا سرعتنا قد يكون قابلاً للإيقاف",
 "stoppage": "إيقاف, توقف (فعل إيقاف شيء ما) / انسداد, سدادة (عائق في أنبوب أو مجرى) / توقف, كبح (حالة عدم النشاط بعد انقطاع)\nمثال: إيقافه للتدفق أدى إلى فيضان",
 "stopped": "مَحْشُوّ, مَسْدُود ((يوصف به الأنف) مسدود ومحتقن)",
 "stopped-up": "مَحْشُوّ, مَسْدُود (ذو فتحات ضيقة مملوءة ومسدودة)",
 "stopper": "سدادة (انسداد يتكون من جسم مصمم لسد حفرة بإحكام) / مانع, ورقة حاكمة ((في البريدج) ورقة لعب ذات قيمة عالية تكفي لضمان الفوز بالجولة في نقش معين) / قاطع الحديث, مفحم (ملاحظة لا يوجد عليها رد مهذب في المحادثة) / فقرة مذهلة (عرض مذهل أو مثير للإعجاب لدرجة أن العرض يجب أن يتأخر حتى يهدأ الجمهور)\nمثال: إذا كان شريكي يملك ورقة بستوني حاكمة يمكنني المراهنة بـ بلا حكم",
 "stopper knot": "عقدة سدادة (عقدة تمنع الحبل من المرور عبر ثقب)",
 "stoppered": "مَسْدُود بِسِدَادَة ((يوصف به وعاء) فيه سدادة في فتحته)",
 "stopping": "ضغط الأوتار (نوع العزف الذي يتضمن الضغط بالأصابع على أوتار آلة وترية للتحكم في النغمة) / حشوة, شريط لحام (مثبت يتكون من شريط ضيق من المعدن الملحوم يستخدم لربط الأعضاء الفولاذية)\nمثال: كان ضغط عازف الكمان للأوتار ممتازاً",
 "stopping point": "ختام, نقطة التوقف (النهاية الزمنية؛ وقت الختام)\nمثال: تمت الإشارة إلى نقطة توقف كل جولة بجرس",
 "stopple": "سدادة (انسداد يتكون من جسم مصمم لسد حفرة بإحكام)",
 "stops": "ميشيغان (لعبة ورق قمار توضع فيها الرقائق على الآس والملك والملكة والولد من بدلات منفصلة)",
 "stopwatch": "سَاعَةُ سِبَاق, سَاعَةُ إِيقَاف (ثُلْث ثُمْن اليَوْم بمعنى مجموع النَهَار واللَيْل، أي جزء من أربعة وعشرين جزءا من مجموع النهار والليل وتتكون من ستين دَقِيقَة؛ الوَقْت الحاضر، الآن)\nمثال: درست لمدة ساعة.",
 "storage": "إيداع, تخزين (الإيداع في مستودع) / تخزين (فعل تخزين شيء ما) / تخزين (المشروع التجاري لتخزين البضائع والمواد) / ذاكرة, ذاكرة حاسوب (جهاز ذاكرة إلكتروني)\nمثال: قرروا إيداع أثاثهم في مستودع موصى به في بروكلين",
