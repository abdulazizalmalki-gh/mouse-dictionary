 "styptic": "مُرْقِئ, مُوقِف لِلنَّزِيف (يميل إلى وقف النزيف عبر تقليص الأنسجة أو الأوعية الدموية) / دواء قابض, مادة قابضة (دواء يسبب انكماش أنسجة وقنوات الجسم)",
 "styptic weed": "سنا القهوة, عشبة منتنة (شجيرة استوائية مورقة جداً كريهة الرائحة استخدمت بذورها كمغشوش للقهوة؛ تصنف أحياناً في جنس كاسيا)",
 "styracosaur": "ستيراكوصور (ديناصور سيراتوبسي غير عادي له العديد من الأشواك الكبيرة حول حافة كشكشه العظمي وقرن أنفي طويل؛ من أواخر العصر الطباشيري)",
 "styracosaurus": "ستيراكوصور (ديناصور سيراتوبسي غير عادي له العديد من الأشواك الكبيرة حول حافة كشكشه العظمي وقرن أنفي طويل؛ من أواخر العصر الطباشيري)",
 "styrax": "إصطرك, ستيراكس",
 "styrax japonicum": "إصطرك ياباني, جرس الثلج الياباني (شجرة شجيرية في الصين والياباني)",
 "styrax obassia": "إصطرك أوباسي, جرس الثلج (شجرة صغيرة موطنها اليابان)",
 "styrax texana": "إصطرك تكساس, جرس ثلج تكساس (نوع من الإصطرك في جنوب غرب الولايات المتحدة؛ وهو نوع مهدد بالانقراض)",
 "styrene": "ستايرين, فينيل بنزين (سائل زيتي عديم اللون؛ هو المونومر للبوليسترين)",
 "styrofoam": "ستايروفوم",
 "suability": "قابلية المقاضاة (الخضوع للمساءلة القانونية أو المقاضاة)",
 "suasible": "قَابِل لِلْإِقْنَاع (سريع الاستجابة للإقناع)",
 "suasion": "إقناع (فعل الإقناع (أو محاولة الإقناع)؛ تواصل يهدف إلى حمل الآخرين على الاعتقاد أو العمل)",
 "suave": "دَمِث, لَبِق (مُجَامِل بِسَلَاسَة وَأَدَب مَعَ قَدْرٍ مِنَ الرُّقِيّ) / أَنِيقٌ, وَسِيمٌ (يتمتع بسحر رفيع وأناقة)",
 "suavely": "بدماثة, بلباقة (برقة وتهذيب؛ بطريقة لبقة)\nمثال: إنه ساحر بلباقة وجميع السيدات يحببنه",
 "suaveness": "رقة, نعومة (جودة كون المرء لطيفاً ودمثاً أو متودداً في الأسلوب)",
 "suavity": "رقة, نعومة (جودة كون المرء لطيفاً ودمثاً أو متودداً في الأسلوب)",
 "sub": "غواصة (سفينة حربية غاطسة مسلحة عادة بطوربيدات) / سابمارين, سندويتش غواصة (شطيرة كبيرة مصنوعة من لفافة خبز طويلة مقسومة طولياً ومحشوة باللحوم والجبن (والطماطم والبصل والخس والتوابل))",
 "sub judice": "قَيْدَ النَّظَر (مَعْروض أَمامَ المَحْكَمَة وَلَم يُبَتّ فيه بَعْد)",
 "sub rosa": "سِرًّا (في السر أو الخفاء)\nمثال: عقد اجتماعاً سرياً لتجنب النقد العام",
 "sub-assembly": "تجميع فرعي (وحدة مجمعة بشكل منفصل ولكنها مصممة لتتناسب مع وحدات أخرى في منتج مصنع)",
 "sub-interval": "فترة جزئية (فترة مشمولة ضمن فترة أخرى)",
 "sub-rosa": "خَلْفَ الكَوَالِيس, سِرِّيّ (مُصَمَّمٌ وَمُنَفَّذٌ بِسِرِّيَّةٍ أَوْ بِشَكْلٍ سِرِّيّ)",
 "sub-saharan": "أفريقي جنوب الصحراء, جنوب الصحراء (مكون من أو متعلق بـ أو يقع في المنطقة جنوب الصحراء الكبرى)",
