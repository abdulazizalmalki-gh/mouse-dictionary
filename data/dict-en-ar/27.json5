 "subacute": "تَحْت حَادّ, شِبْه حَادّ (أقلّ حِدّة من الحادّ؛ يتعلّق بمرض موجود لدى شخص بلا أعراض ظاهرة)",
 "subacute bacterial endocarditis": "التهاب الشغاف الجرثومي تحت الحاد (عدوى بكتيرية مزمنة في الشغاف وصمامات القلب؛ تتطور الأعراض ببطء)",
 "subacute inclusion body encephalitis": "التهاب الدماغ المصلب تحت الحاد (التهاب دماغ مزمن نادر ومترقٍ يسببه فيروس الحصبة ويحدث بشكل أساسي عند الأطفال والشباب؛ تحدث الوفاة عادة في غضون ثلاث سنوات)",
 "subacute sclerosing leukoencephalitis": "التهاب الدماغ المصلب تحت الحاد (التهاب دماغ مزمن نادر ومترقٍ يسببه فيروس الحصبة ويحدث بشكل أساسي عند الأطفال والشباب؛ تحدث الوفاة عادة في غضون ثلاث سنوات)",
 "subacute sclerosing panencephalitis": "التهاب الدماغ المصلب تحت الحاد (التهاب دماغ مزمن نادر ومترقٍ يسببه فيروس الحصبة ويحدث بشكل أساسي عند الأطفال والشباب؛ تحدث الوفاة عادة في غضون ثلاث سنوات)",
 "subalpine": "شِبْه أَلْبِيّ (ينمو على ارتفاعات عالية دون خطّ الأشجار)",
 "subalpine fir": "شوح ألبي, شوح تحت ألبي (شجرة خشب متوسطة الطول من جبال روكي لها تاج مخروطي ضيق إلى عمودي)",
 "subalpine larch": "أرزية ألبية (أرزية متوسطة الحجم من جبال روكي؛ وثيقة الصلة بالأرزية الغربية)",
 "subaltern": "ثَانَوِيّ, وَضِيع الرُّتْبَة (أدنى في الرتبة أو المكانة) / ضابط مرؤوس (ضابط جيش بريطاني مفوض رتبته أقل من نقيب)",
 "subaquatic": "شِبْه مَائِيّ, نِصْف مَائِيّ (مائيّ جزئيًّا؛ يعيش أو ينمو جزئيًّا على اليابسة وجزئيًّا في الماء) / تَحْت مَائِيّ, مَغْمُور (ينمو أو يبقى تحت سطح الماء)",
 "subaqueous": "تَحْت مَائِيّ, مَغْمُور (ينمو أو يبقى تحت سطح الماء)",
 "subarachnoid space": "الحيز تحت العنكبوتية (مساحة في السحايا تحت الغشاء العنكبوتي وفوق الأم الحنون تحتوي على السائل النخاعي)",
 "subarctic": "شبه قطبي (مكون من أو متعلق بخطوط العرض الواقعة جنوب الدائرة القطبية الشمالية مباشرة)",
 "subartesian": "دُون ارْتِوَازِيّ ((للماء) يرتفع بشكل طبيعي في بئر إلى ارتفاع أعلى بشكل ملحوظ من منسوب المياه الجوفية المحيطة ولكنه لا يتدفق خارج البئر)",
 "subaru": "سُوبَارُو",
 "subatomic": "دُون ذَرِّيّ (أصغر من الأبعاد الذرية) / دون ذري (متعلق بمكونات الذرة أو القوى داخل الذرة)\nمثال: جسيمات دون ذرية",
 "subatomic particle": "جُسَيْم (جسم له كتلة محدودة وهيكل داخلي ولكن أبعاده ضئيلة)",
 "subbase": "قاعدة سفلية (الإطار السفلي لقاعدة معمارية أو لإزار الحائط)",
 "subbing": "استبدال, العمل كبديل (العمل كبديل لشخص مريض أو في إجازة)",
 "subception": "إدراك دون الوعي, إدراك لا شعوري ((علم النفس) إدراك أو رد فعل تجاه محفز يحدث دون وعي أو شعور)",
 "subclass": "طويئفة ((في الأحياء) فئة تصنيفية تحت الطائفة وفوق الرتبة)",
 "subclass diapsida": "ثنائيات الأقواس (تستخدم في التصنيفات السابقة لتشمل جميع الزواحف الحية باستثناء السلاحف)",
 "subclavian": "تحت الترقوة (يقع تحت الترقوة)",
 "subclavian artery": "شريان تحت الترقوة (أي من شريانين يغذيان الرقبة والذراعين بالدم)",
 "subclavian vein": "وريد تحت الترقوة (استمرار للوريد الإبطي؛ ينضم إلى الوريد الوداجي الباطن لتكوين الوريد العضدي الرأسي)",
 "subclinical": "دون السريري (متعلق بمرحلة تطور المرض قبل ظهور الأعراض)",
 "subclinical absence": "غيبة تحت سريرية (ضعف عابر في الوظيفة القشرية يمكن إثباته فقط من خلال ذروات موجات دماغية بمعدل 3 في الثانية)",
 "subcommittee": "لجنة فرعية (مجموعة فرعية من أعضاء لجنة منظمة لغرض محدد)",
 "subcompact": "سيارة صغيرة الحجم (سيارة أصغر من السيارة المدمجة)",
 "subcompact car": "سيارة صغيرة الحجم (سيارة أصغر من السيارة المدمجة)",
 "subconscious": "اللَّاوَعِيّ",
 "subconscious mind": "تحت الوعي, عقل باطن (نشاط نفسي تحت مستوى الوعي مباشرة)",
 "subconsciously": "فِي العَقْل البَاطِن, لَا شُعُورِيًّا (من العقل الباطن)\nمثال: جاءته الصورة لا شعورياً",
 "subconsciousness": "عقل باطن, لاوعي (حالة ذهنية غير متاحة للوعي المباشر)",
 "subcontinent": "شِبْه قارَة",
 "subcontract": "عقد من الباطن (عقد يسند إلى طرف آخر بعض التزامات عقد سابق)",
 "subcontractor": "مقاول",
 "subcortical": "تحت قشري (مكون من أو متعلق بـ أو كونه أو يتضمن المراكز العصبية تحت القشرة المخية)",
 "subculture": "ثقافة فرعية (مجموعة اجتماعية داخل ثقافة وطنية لها أنماط مميزة من السلوك والمعتقدات)",
 "subcutaneous": "تحت الجلد (متعلق بالمنطقة الواقعة تحت البشرة أو يقع فيها)\nمثال: إبرة تحت الجلد",
 "subcutaneous injection": "حقن تحت الجلد (حقنة تحت الجلد)",
 "subcutaneous test": "اختبار داخل الأدمة (شكل من أشكال اختبار الجلد يتم فيه حقن مسبب الحساسية المشتبه به داخل الجلد)",
 "subcutaneously": "تحت الجلد (تحت سطح الجلد)\nمثال: يُحقن تحت الجلد",
 "subdata base": "قاعدة بيانات فرعية (مجموعة فرعية من البيانات في قاعدة بيانات تُستخدم في تطبيق معين)",
 "subdeacon": "شماس مساعد (رجل دين رتبته أقل من الشماس؛ إحدى الرتب المقدسة في الكنيسة المسيحية الغربية غير المصلحة والكنائس الكاثوليكية الشرقية ولكن تم إلغاؤها الآن في الكنيسة…)",
 "subdimension": "بُعد فرعي (بعد جزئي يشكل البعد الكامل لجسم معين)",
 "subdirectory": "دليل فرعي ((علوم الكمبيوتر) دليل مدرج في دليل آخر)",
 "subdivider": "مُقَسِّم الْأَرَاضِي, مُقَسِّم فَرْعِيّ (شخص يقسم الأجزاء إلى أجزاء أصغر (خاصة مقسم الأراضي إلى مواقع بناء))",
 "subdivision": "تقسيم فرعي (عملية التقسيم الفرعي؛ تقسيم شيء مقسم سابقاً) / شعبة, قسم فرعي (قسم من قسم؛ جزء من جزء؛ أي جزء من شيء مقسم بالفعل) / جزء, فرع (جزء قائم بذاته من عمل أكبر (مكتوب أو موسيقي)) / شُعبة, فرع (قسم من منظمة أكبر أو أكثر تعقيدًا)\nمثال: يتجه دائماً أولاً إلى قسم الأعمال",
 "subdominant": "تحت المهيمنة ((موسيقى) النغمة الرابعة في السلم الدياتوني)",
 "subduable": "قَابِلٌ لِلإِخْضَاعِ (عُرْضَةٌ لِلتَّطْوِيعِ وَالإِخْضَاعِ)",
 "subduction": "اندساس (عملية جيولوجية يتم فيها دفع حافة صفيحة قشرية جانبياً وإلى الأسفل في الوشاح تحت صفيحة أخرى)",
 "subdue": "طَوَّعَ, تَغَلَّبَ عَلَى",
 "subdued": "خَافِت, مُعْتَدِل الإِضَاءَة (ضَعِيف الضَّوْء؛ غَيْر سَاطِعٍ أَوْ قَاسٍ) / خَفِيف, هَادِئ الضَّوْء (غَيْر بَرَّاق وَلَا سَاطِع) / خَفِيض, مَهْمُوس (بنبرة مُخفَّضة ولَيِّنة) / خَافِت, هَادِئ (مُعتدِل في الأسلوب أو الجودة)",
 "subduedness": "حلم, وداعة (ميل لأن يكون المرء صبوراً ومتحملاً) / خفوت, عتمة (خاصية الأضواء أو الأصوات التي تفتقر إلى البريق أو منخفضة الشدة)",
 "subduer": "خاضع, قاهر (شخص يتغلب ويؤسس للهيمنة والسيطرة بالقوة أو الإقناع)",
 "subdural": "تحت الجافية (تحت الأم الجافية ولكن فوق الغشاء العنكبوتي للسحايا)",
 "subeditor": "محرر فرعي, مساعد محرر (مساعد محرر)",
 "subentry": "مدخل فرعي (مدخل، مثل مدخل في حساب أو مرجع، يتم تضمينه ضمن مدخل رئيسي)\nمثال: يتم إعطاء الجذر الأوسط لمعظم الأفعال المتعدية كمدخل فرعي (بخط مائل) تحت مدخل الفعل المتعدي (بخط غامق)",
 "suberic acid": "حمض السوبريك (حمض ثنائي الكربوكسيل يوجد في الفلين)",
 "subfamily": "أسرة, فصيلة فرعية ((في الأحياء) فئة تصنيفية تحت الفصيلة)",
 "subfigure": "شكل فرعي (شكل يمثل جزءاً من شكل آخر)",
 "subfusc": "بَاهِت, كَئِيب (خالٍ من الإشراق أو الجاذبية)",
 "subgenus": "جنس فرعي, جنيس ((في الأحياء) مجموعة تصنيفية بين الجنس والنوع)",
 "subgiant": "شبه عملاق",
 "subgross": "دُونَ المَرْئِيّ (أَصْغَرُ مِنْ أَنْ يُرَى بِالعَيْنِ المُجَرَّدَة)",
 "subgroup": "زمرة جزئية (مجموعة جزئية (غير خالية) من زمرة رياضية) / مجموعة فرعية (مجموعة مميزة وغالباً ما تكون تابعة داخل مجموعة)",
 "subhead": "عنوان فرعي (عنوان لقسم فرعي من نص)",
 "subheading": "عنوان فرعي (عنوان لقسم فرعي من نص)",
 "subhuman": "دُونَ المُسْتَوَى البَشَرِيّ (غَيْرُ صَالِحٍ لِلْبَشَرِ) / أقل من البشر, دون المستوى البشري (أقل من البشر أو لا يليق بالإنسان)\nمثال: عامل السكان الأصليين كأنهم دون البشر",
 "subjacent": "تحتي (يقع بالجوار ولكن في الأسفل)\nمثال: التلال والوديان التحتية",
 "subject": "فَاعِل, مُبْتَدَأ (الشيء :فعله) / مَوْضُوع / دَوْرَة, مَادَّة (في غرب العراق على نهر الفرات قرب الحدود السورية؛ حَيّ في جنوب بغداد تقع فيه محطة تكرير للنفط تسمّى بإسمه) / رَعِيَّة\nمثال: تظن الشرطة أن سامي يعلم من الفاعل.",
 "subject area": "تخصص, حقل معرفي (فرع من فروع المعرفة)\nمثال: في أي تخصص حصل على الدكتوراه؟",
 "subject case": "حالة الرفع (فئة الأسماء التي تعمل كفاعل نحوي للفعل)",
 "subject field": "تخصص, حقل معرفي (فرع من فروع المعرفة)\nمثال: في أي تخصص حصل على الدكتوراه؟",
 "subject matter": "الموضوع، مادة البحث",
 "subjection": "إخضاع, غزو (فعل الغزو) / إخضاع, خضوع (الخضوع القسري لسيطرة الآخرين)",
 "subjective": "ذاتي, كامِن (لفعل عقلي يتم تنفيذه بالكامل داخل العقل) / ذاتي, شخصي (يحدث داخل العقل ومعدل بالتحيز الفردي)\nمثال: الإدراك هو فعل كامن للعقل",
 "subjectively": "بذاتية (بطريقة ذاتية)\nمثال: لا يمكنك النظر إلى هذه الحقائق بذاتية",
 "subjectiveness": "ذاتية (الحكم القائم على الانطباعات والمشاعر والآراء الشخصية الفردية بدلاً من الحقائق الخارجية)",
 "subjectivism": "ذاتية (صفة كون الشيء ذاتياً) / ذاتية ((فلسفة) المذهب القائل بأن المعرفة والقيمة تعتمدان على وتحددهما تجربتك الذاتية)",
 "subjectivist": "ذاتي (شخص يؤيد الذاتية)",
 "subjectivity": "ذاتية (الحكم القائم على الانطباعات والمشاعر والآراء الشخصية الفردية بدلاً من الحقائق الخارجية)",
 "subjoining": "إلحاق, تكميل (عملية التكميل)",
 "subjugable": "قَابِلٌ لِلإِخْضَاعِ (عُرْضَةٌ لِلتَّطْوِيعِ وَالإِخْضَاعِ)",
 "subjugate": "اِسْتَعْبَدَ, قَهَرَ",
 "subjugated": "خَاضِع, مُسْتَعْبَد (أُخْضِعَ لِلاسْتِسْلَامِ وَالإِذْعَان)",
 "subjugation": "إخضاع, غزو (فعل الغزو) / إخضاع, ظلم (فعل الإخضاع بالقسوة) / إخضاع, خضوع (الخضوع القسري لسيطرة الآخرين)\nمثال: قمع الطاغية للشعب",
 "subjugator": "مُخضِع, مُستعبِد (فاتح يهزم ويستعبد)",
 "subjunction": "إلحاق, تكميل (عملية التكميل)",
 "subjunctive": "شرطي, نصبي (متعلق بصيغة للأفعال (الصيغة الشرطية أو المنصوبة)) / صِيغَة افْتِرَاضِيَّة, صِيغَة شَرْطِيَّة (صيغة تمثل فعلاً أو حالة (ليس كحقيقة) بل كأمر محتمل أو مشروط)\nمثال: نهايات الفعل الشرطية",
 "subjunctive mood": "حالَةُ النَّصْبِ",
 "subjunctivize": "نصب",
 "subkingdom": "عويلم, مملكة فرعية ((في الأحياء) مجموعة تصنيفية تشكل قسماً رئيسياً من المملكة)",
 "sublease": "تأجير من الباطن (إيجار من مستأجر إلى مستأجر آخر)",
 "sublet": "تأجير من الباطن (إيجار من مستأجر إلى مستأجر آخر)",
 "sublieutenant": "ملازم فرعي (ضابط رتبته تلي الملازم مباشرة)",
 "sublimate": "مُصَفًّى, مُنَقًّى (جُعِل نقيًّا عبر التصفية) / مادة متسامية, مُتسامى (ناتج تبخر مادة صلبة (دون المرور بالحالة السائلة))",
 "sublimated": "متسامي (يمر أو مر من الحالة الصلبة إلى الحالة الغازية (أو العكس) دون أن يصبح سائلاً)",
 "sublimation": "تسامي ((في علم النفس) تعديل التعبير الطبيعي عن دافع أو غريزة (خاصة الجنسية) إلى تعبير مقبول اجتماعياً) / تسامي ((في الكيمياء) تغير مباشر من الحالة الصلبة إلى الغازية دون المرور بالحالة السائلة)",
 "sublimaze": "سوبليماز, فينتانيل (مسكن مخدر يمكن استنشاقه يؤثر على الجهاز العصبي المركزي وقد يسبب الإدمان؛ يستخدم كمخدر بيطري ومع أدوية أخرى قبل وأثناء وبعد الجراحة)",
 "sublime": "رَفِيع, سَامٍ (مَرْفُوعُ الشَّأْنِ؛ فِي حَالَةِ سُمُوٍّ رُوحِيّ) / جَلِيل, سَامٍ (يبعث على الرهبة والإجلال؛ عُلْوِيّ) / أَسْمَى, سَامٍ (في أعلى درجة أو أقصاها؛ بالغ الشدة) / رَفِيع, سَامٍ (ذو قيمة أخلاقية أو فكرية عالية؛ سامٍ في طبيعته أو أسلوبه)",
 "sublime porte": "البَاب العَالِي",
 "sublimed": "متسامي (يمر أو مر من الحالة الصلبة إلى الحالة الغازية (أو العكس) دون أن يصبح سائلاً)",
 "sublimely": "إلى أقصى حد, بشكل سام (إلى أقصى درجة) / بروعة, بمهابة (بطريقة سامية ورفيعة)\nمثال: كان واثقاً إلى أقصى حد",
 "subliminal": "دُونَ العَتَبَةِ الوَاعِيَة (تَحْتَ عَتَبَةِ الإِدْرَاكِ الوَاعِي)",
 "subliminal perception": "إدراك دون الوعي, إدراك لا شعوري ((علم النفس) إدراك أو رد فعل تجاه محفز يحدث دون وعي أو شعور)",
 "sublimit": "حد فرعي ((في التأمين) قيد في مبلغ تغطية الخسارة)",
 "sublimity": "جلال, روعة (النبل في الفكر أو الشعور أو الأسلوب)",
 "sublingual": "تحت اللسان (يقع أسفل اللسان)",
 "sublingual gland": "غدة تحت اللسان (غدة لعابية صغيرة تنتج الميوسين (المكون اللزج للعاب)؛ توجد في البشر على جانبي الفم تحت اللسان)",
 "sublingual salivary gland": "غدة تحت اللسان (غدة لعابية صغيرة تنتج الميوسين (المكون اللزج للعاب)؛ توجد في البشر على جانبي الفم تحت اللسان)",
 "sublingual vein": "وريد تحت اللسان (رافد للوريد اللساني)",
 "subliterary": "دُونَ أَدَبِيّ (لَمْ يُكْتَبْ بِوَصْفِهِ أَدَبًا وَلَمْ يُقْصَدْ بِهِ ذَلِكَ)",
