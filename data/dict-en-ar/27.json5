 "super c": "أسيد سوبر, سوبر سي (أسماء دارجة للكيتامين)",
 "super heavyweight": "وزن فوق الثقيل (ملاكم هاوٍ يزيد وزنه عن 201 رطل (حوالي 91 كجم)) / وزن ثقيل, وزن ثقيل فائق (فئة وزن في الرياضات القتالية، وغالباً ما تكون الأثقل)",
 "super-automatic espresso machine": "ماكينة إسبريسو أوتوماتيكية بالكامل (ماكينة إسبريسو تقوم بطحن القهوة وكبسها واستخلاص جرعة الإسبريسو تلقائياً؛ تحتوي بعض النماذج على جهاز آلي لخفق الحليب وصبه)\nمثال: الآلات الأوتوماتيكية بالكامل تلغي القدرة على كبس وطحن القهوة يدوياً، مما قد يؤثر على جودة الإسبريسو",
 "super-speed": "سرعة فائقة (جودة السرعة القصوى)\nمثال: قبل أن يتمكنوا من القيام بمحاولة ثانية، يضربه البرق مرة أخرى، مما يجعله يستعيد سرعته الفائقة",
 "superable": "قَابِل لِلتَّغَلُّب عَلَيْه (يمكن التغلب عليه أو تجاوزه)",
 "superabundance": "إفراط, فرط (كمية تزيد عما هو مناسب)\nمثال: الأطفال في سن الرابعة لديهم فرط في الطاقة",
 "superabundant": "فَائِق الوَفْرَة (في أعلى درجات الوَفْرة والغزارة)",
 "superannuated": "بَالٍ, عَفَا عَلَيْهِ الزَّمَن (قديم؛ لم يعد صالحاً أو مواكباً للعصر) / عَفَا عَلَيْه الزَّمَن, مُتَجَاوِز السِّنّ (تجاوز السنّ المناسبة بحيث لم يعد صالحاً للعمل)",
 "superannuation": "إحالة للتقاعد, تقاعد لبلوغ السن (فعل تسريح شخص ما بسبب العمر (خاصة لإحالته للتقاعد بمعاش)) / بطلان, تقادم (خاصية كون الشيء عفا عليه الزمن ولم يعد جارياً) / صندوق التقاعد, معاش التقاعد (دفعة شهرية تُقدم لشخص تقاعد عن العمل)",
 "superannuation fund": "صندوق تقاعد (صندوق مخصص لدفع رواتب التقاعد للعمال عند تقاعدهم من الخدمة)",
 "superb": "رَفِيع, فَائِق (فائق الجودة بشكل استثنائي) / بَاهِر, رَائِع (ذو تميز يفوق الوصف)",
 "superbia": "غرور, كبرياء (تقدير غير معقول ومفرط للذات (تُشخص كإحدى الخطايا السبع المميتة))",
 "superbly": "بشكل رائع, بشكل مذهل ((يستخدم للمبالغة) بشكل ممتاز)\nمثال: صوتها منضبط بشكل رائع",
 "superbug": "ذبابة بيضاء فائقة (سلالة من الآفات تم استيرادها عن طريق الخطأ إلى فلوريدا من الشرق الأوسط ثم انتشرت إلى كاليفورنيا حيث تعد آفة خطيرة جداً تتغذى على جميع محاصيل الخضروات…) / بكتيريا خارقة (سلالة من البكتيريا مقاومة لجميع المضادات الحيوية)",
 "supercargo": "مشرف الشحن (ضابط على سفينة تجارية مسؤول عن البضائع وبيعها وشرائها)",
 "supercharged": "مَشْحُون, مُتَّقِد (مُفعَم بعاطفة شديدة) / مُشَحَّن ((عن المحركات) زيدت قوته بتركيب شاحن توربيني)",
 "supercharger": "شاحن فائق (ضاغط يدفع المزيد من الأكسجين إلى أسطوانات محرك الاحتراق الداخلي)",
 "superciliary arch": "حافة فوق الحجاج, قوس حاجبية (حافة على العظم الجبهي فوق محجر العين)",
 "superciliary ridge": "حافة فوق الحجاج, قوس حاجبية (حافة على العظم الجبهي فوق محجر العين)",
 "supercilious": "سَاخِر, مُتَعَجْرِف (يُعَبِّر عن الازدراء والتعالي) / مُتَعَجْرِف, مُتَكَبِّر (لديه أو يُظهِر تفوّقًا متعجرفًا واحتقارًا لمن يعتبرهم أدنى منه)",
 "superciliously": "باستهزاء, بتهكم (مع سخرية؛ بطريقة تهكمية غير مجاملة)\nمثال: قال باستهزاء: 'أنا لا أؤمن بهذه العادات'",
 "superciliousness": "تعال, تكبر (سمة إظهار الغطرسة من خلال معاملة من يعتبرون أدنى منزلة بفوقية)",
 "supercilium": "حَاجِب (قوس الشعر فوق كل عين)",
 "superclass": "فوق طائفة ((في الأحياء) فئة تصنيفية تحت الشعبة وفوق الطائفة)",
 "supercomputer": "حاسوب فائق (حاسوب مركزي يعتبر واحداً من أقوى الحواسيب المتاحة في وقت معين)",
 "superconducting supercollider": "مصادم فائق فائق التوصيل (مصادم يعمل عند درجات حرارة منخفضة جداً)",
 "superconductivity": "موصلية فائقة (اختفاء المقاومة الكهربائية عند درجات حرارة منخفضة جداً)",
 "supercritical": "فَوْقَ حَرِج ((خاصة في المواد الانشطارية) قادر على استدامة تفاعل متسلسل بحيث يزداد معدل التفاعل)",
 "superdad": "أب خارق (مصطلح غير رسمي للأب الذي يمكنه الجمع بين رعاية الأطفال والعمل بدوام كامل)",
 "superego": "الْأَنَا الْعُلْيَا, الْأَنَا الْأَعْلَى",
 "supererogation": "تطوع, عمل فائق للواجب (جهد يفوق نداء الواجب)",
 "supererogatory": "زَائِد, فَائِض (أكثر مما هو مطلوب أو مرغوب فيه أو لازم)",
 "superfamily": "فوق فصيلة ((في الأحياء) مجموعة تصنيفية تقع تحت الرتبة ولكن فوق الفصيلة)",
 "superfatted": "فَائِق الدُّهْنِيَّة ((عَنِ الصَّابُون) يَحْتَوِي عَلَى دُهُون إِضَافِيَّة غَيْر مُتَصَبِّنَة)",
 "superfecta": "سوبرفكتا (رهان على اختيار الفائزين الأربعة الأوائل في سباق بالترتيب الصحيح)",
 "superfecundation": "إخصاب مفرط (إخصاب بويضتين أو أكثر تم إطلاقهما خلال نفس الدورة الشهرية بواسطة حيوانات منوية من أفعال جماع منفصلة (خاصة من ذكور مختلفين))",
 "superfetation": "حمل إضافي, حمل على حمل (إخصاب بويضة ثانية بعد بدء الحمل؛ ينتج عنه جنينان بأعمار مختلفة في الرحم في نفس الوقت)\nمثال: الحمل الإضافي طبيعي في بعض أنواع الحيوانات",
 "superficial": "سَطْحِيّ",
 "superficial epigastric vein": "وريد شرسوفي سطحي (يصب في الوريد الصافن الكبير)",
 "superficial middle cerebral vein": "وريد مخي أوسط سطحي (وريد كبير على طول خط شق سيلفيان إلى الجيب الكهفي)",
 "superficial temporal vein": "وريد صدغي سطحي (ينضم إلى الوريد الصدغي الأوسط ليصب في الوريد خلف الفك السفلي)",
 "superficiality": "سَطْحِيَّة",
 "superficially": "سطحياً (بطريقة سطحية)\nمثال: كان مهتماً سطحياً",
 "superficies": "سطح خارجي (السطح الخارجي لمنطقة أو جسم) / سطحية, مظهر خارجي (الجانب الخارجي البحت لشيء ما؛ المظهر السطحي)\nمثال: انشغل الجمهور بجوهر المسرحية بدلاً من المظاهر السطحية للإنتاج",
 "superfine": "رَفِيع, فَائِق الجَوْدَة ((يُستخدم خاصة للبضائع) بالغ الجودة والنعومة) / مُبَالَغٌ فِي رِقَّتِهِ, مُفْرِطُ التَّهْذِيبِ (مفرط في الرقة أو التهذيب) / فَائِقُ النُّعُومَةِ (بالغ الدقّة في الحجم أو القوام)",
 "superfinishing machine": "آلة تشطيب دقيق (آلة تستخدم لتحسين تشطيب السطح وهندسة قطعة العمل عن طريق إزالة الطبقة السطحية الرقيقة غير المتبلورة التي خلفتها العملية السابقة باستخدام حجر كاشط أو…)",
 "superfluity": "فائض, وفرة مفرطة (إفراط شديد)\nمثال: وفرة محرجة من الثروات",
 "superfluous": "زَائِد, فَائِض (أكثر مما هو مطلوب أو مرغوب فيه أو لازم) / عَبَثِيّ, لَا طَائِلَ مِنْه (لَا يَخْدِمُ أَيَّ غَرَضٍ مُفِيد؛ لَا مُبَرِّرَ لِوُجُودِه)",
 "superfluously": "بشكل زائد, بلا ضرورة (بطريقة زائدة عن الحاجة)\nمثال: أضاف تعليقاته السخيفة بلا ضرورة إلى المناقشة",
 "superfood": "سوبر فود, طعام خارق (طعام ذو فوائد صحية)",
 "superfund": "برنامج الصندوق الممتاز, سوبرفاند (برنامج الحكومة الفيدرالية الأمريكية لتحديد والتحقيق في وتنظيف أسوأ مواقع النفايات السامة)",
 "superfund program": "برنامج الصندوق الممتاز, سوبرفاند (برنامج الحكومة الفيدرالية الأمريكية لتحديد والتحقيق في وتنظيف أسوأ مواقع النفايات السامة)",
 "superfund site": "موقع سام (موقع تم فيه إلقاء النفايات السامة وصنفته وكالة حماية البيئة للتنظيف)",
 "supergiant": "عِمْلَاق عَظِيم (نجم شديد السطوع ذو قطر كبير جداً وكثافة منخفضة)",
 "supergrass": "مخبر رئيسي (مخبر للشرطة يورط العديد من الناس)",
 "superhero": "بَطَل خارِق (شخصية خيالية تتمتع بقوى خارقة للطبيعة)\nمثال: لنفترض أن لدينا نملة ذكية للغاية - ربما صديقة للبطل الخارق في الكتب المصورة (الرجل النملة) - تم تدريبها على المشي في خط مستقيم",
 "superhet": "مستقبل هيتروداين (جهاز استقبال راديو يجمع تردداً مولداً محلياً مع تردد الموجة الحاملة لإنتاج إشارة فوق صوتية يتم استخلاصها وتضخيمها)",
 "superheterodyne receiver": "مستقبل هيتروداين (جهاز استقبال راديو يجمع تردداً مولداً محلياً مع تردد الموجة الحاملة لإنتاج إشارة فوق صوتية يتم استخلاصها وتضخيمها)",
 "superhigh frequency": "تَرَدُّد بَالِغ العُلُوّ (3 إلى 30 جيجاهرتز)",
 "superhighway": "أوتوستراد, طريق سريع (طريق سريع عريض مصمم لحركة المرور عالية السرعة) / الطريق السريع للمعلومات (شبكة إلكترونية واسعة (مثل الإنترنت) تستخدم للنقل السريع للصوت والفيديو والرسومات في شكل رقمي)",
 "superhuman": "خارق للبشر, فائق للطبيعة البشرية (فوق أو أبعد من البشر أو يتطلب قوة أو قدرة تحمل أكثر من البشرية)\nمثال: كائنات خارقة للبشر",
 "superhumanity": "قُدْرَة خَارِقَة لِلْبَشَر (حالة أو شرط تجاوز ما هو ممكن للبشر)",
 "superimposed": "مُتَرَاكِب, مُطَبَّق (بطبقة فوق أخرى بشكل متراكب) / مُتَرَاكِب, مُرَكَّب فَوْق (موضوع فوق شيء آخر)",
 "superincumbent": "ضَاغِط مِنْ فَوْق (يرقد ويضغط على ما تحته)",
 "superinfection": "عدوى إضافية (عدوى تحدث أثناء العلاج من عدوى أخرى)",
 "superintelligence": "ذكاء خارق, ذكاء فائق (ذكاء ملحوظ، عند مستوى أو أعلى من مستوى العبقرية)",
 "superintendence": "إشراف, رقابة (الإدارة من خلال الإشراف على أداء أو تشغيل شخص أو مجموعة)",
 "superintendent": "مشرف عام, ناظر (شخص يوجه ويدير منظمة) / مَسْؤُول العِمارَة, مُشْرِف المَبْنَى (حارس مبنى سكني يمثل المالك ويعمل كبواب وجامع للإيجار)",
 "superior": "أَجْدَر (أَجْدَرَ النَّبْتُ: جَدَرَ؛ يقال: أَجْدَرَتِ الأَرْضُ) / مُتَفَوِّق / يعلو",
 "superior alveolar artery": "الشريان السنخي العلوي (الشريان السنخي الذي يغذي الأسنان العلوية)",
 "superior cerebellar artery": "شريان مخيخي علوي (الفرع العلوي للشريان المخيخي)",
 "superior cerebral vein": "وريد مخي علوي (وريد مخي يصرف التحدب الظهري لنصف الكرة المخية ويصب في الجيب الكهفي)",
 "superior colliculus": "أكيمة علوية (مركز بصري أساسي بين الشبكية والقشرة المخططة)",
 "superior conjunction": "اقتران علوي ((في علم الفلك) محاذاة الأرض وكوكب على الجانب المقابل من الشمس)",
 "superior court": "محكمة عليا (أي محكمة لها اختصاص أعلى من محكمة أدنى)",
 "superior epigastric veins": "أوردة شرسوفية علوية (أوردة ترافق الشريان الشرسوفي العلوي)",
 "superior general": "رئيس عام (رئيس رهبانية دينية أو جماعة)",
 "superior labial artery": "شريان شفوي علوي (شريان هو فرع من الشريان الوجهي يغذي الشفة العليا)",
 "superior labial vein": "وريد شفوي علوي (رافد للوريد الوجهي يصرف الشفة العليا)",
 "superior mesenteric artery": "شريان مساريقي علوي (ينشأ من الجزء العلوي للأبهر ويغذي الأمعاء الدقيقة والأعور والقولون)",
 "superior ophthalmic vein": "وريد عيني علوي (وريد يبدأ عند الزاوية الداخلية لمحجر العين ويمر عبر الشق الحجاجي العلوي ليصب في الجيب الكهفي)",
 "superior planet": "كَوْكَب عُلْوِيّ (أي من الكواكب التي يقع مدارها خارج مدار الأرض)",
 "superior pulmonary vein": "وريد رئوي علوي (أي من وريدين رئويين (أيسر وأيمن) يعيدان الدم من الفصوص العلوية للرئتين)",
 "superior rectus": "مستقيمة علوية (عضلة العين التي يدير انقباضها مقلة العين لأعلى وللداخل)",
 "superior rectus muscle": "مستقيمة علوية (عضلة العين التي يدير انقباضها مقلة العين لأعلى وللداخل)",
 "superior skill": "مهارة فائقة (قدرة أكثر من عادية)",
 "superior thalamostriate vein": "وريد مهادي مخططي علوي (وريد طويل يساعد في تكوين الوريد المخي الباطن)",
 "superior thyroid vein": "وريد درقي علوي (وريد على كل جانب يصرف الجزء العلوي من الغدة الدرقية ويصب في الوريد الوداجي الباطن)",
 "superior vena cava": "وريد أجوف علوي (يتلقى الدم من الرأس والذراعين والصدر ويصب في الأذين الأيمن للقلب؛ يتكون من الوريد الفرد وكلا الوريدين العضديين الرأسيين)",
 "superior vocal cord": "حبل صوتي كاذب (أي من الحبلين الصوتيين العلويين غير المشاركين في التصويت)",
 "superiority": "تَفَوُّق",
 "superiority complex": "عقدة التفوق (تقدير مبالغ فيه لقيمة وأهمية المرء)",
 "superjacent": "فوقي (يقع مباشرة فوق أو على شيء آخر)",
 "superlative": "دَرَجَة فَائِقَة",
 "superlative degree": "دَرَجَة فَائِقَة",
 "superlatively": "بامتياز, بدرجة فائقة (إلى درجة فائقة)",
 "superload": "حمل حي (حمل متغير على هيكل (مثل الجسر) مثل حركة المرور المتحركة)",
 "superlunar": "أَثيرِيّ, فَوْق قَمَرِيّ (بَعيد عَن العالَم المادِّيّ؛ روحانِيّ وسامٍ) / عبر قمري, فوق قمري (يقع خلف القمر أو مداره حول الأرض)\nمثال: من يتخيل زائراً من فوق القمر في تايمز سكوير؟",
 "superlunary": "أَثيرِيّ, فَوْق قَمَرِيّ (بَعيد عَن العالَم المادِّيّ؛ روحانِيّ وسامٍ) / عبر قمري, فوق قمري (يقع خلف القمر أو مداره حول الأرض)\nمثال: من يتخيل زائراً من فوق القمر في تايمز سكوير؟",
 "supermajority": "غَالِبِيَّة عُظْمَى, أَغْلَبِيَّة عُظْمَى",
 "superman": "سُوبَرْمَان",
 "supermarket": "سُوبَرْمَارْكِت, سُوبَر مَارْكِت",
 "supermarketeer": "مشغل سوبر ماركت (مشغل لمتجر سوبر ماركت)",
 "supermarketer": "مشغل سوبر ماركت (مشغل لمتجر سوبر ماركت)",
 "supermodel": "عارضة أزياء عالمية (عارضة أزياء حققت مكانة المشاهير)",
 "supermolecule": "جزيء ضخم, جزيء كبير (أي جزيء معقد كبير جداً؛ يوجد فقط في النباتات والحيوانات)",
 "supermom": "أم خارقة (مصطلح غير رسمي للأم التي يمكنها الجمع بين رعاية الأطفال والعمل بدوام كامل)",
 "supernal": "أَثيرِيّ, سَماوِيّ (مُتَعَلِّق بِالسَّماء أو الرُّوح؛ عُلْوِيّ وأَثيرِيّ) / سماوي, علوي (كائن أو قادم من العلياء)\nمثال: فسر الطاعون على أنه زيارة من السماء، عقاب سماوي لخطايا البشر",
 "supernatant": "رَائِق, طَافٍ ((للسوائل) يطفو على السطح فوق الراسب أو الرُّسابة) / سائل طافٍ (السائل الصافي الذي يطفو فوق الرواسب أو المواد المترسبة)",
 "supernatural": "خَارِق, مِيتَافِيزِيقِيّ (الشيء) / اِسْتِثْنَائِيّ\nمثال: ذلك خارق للعادة.",
 "supernatural being": "كائن خارق للطبيعة, كيان روحي (كائن غير مادي يُعتقد أن له قوى تؤثر على مسار الأحداث البشرية)",
 "supernatural virtue": "فضيلة لاهوتية (وفقاً للأخلاق المسيحية: واحدة من الفضائل الثلاث (الإيمان والرجاء والمحبة) التي خلقها الله لتكمل الفضائل الطبيعية)",
 "supernaturalism": "خَوَارِقِيَّة, فَوْق طَبِيعِيَّة (صفة كون الشيء منسوباً لقوة تبدو وكأنها تنتهك أو تتجاوز القوى الطبيعية) / الإيمان بالخوارق, غيبية (اعتقاد بوجود قوى تتجاوز الفهم البشري العادي)",
 "supernaturalist": "خارقي, فوق طبيعي (متعلق بالاعتقاد بالخوارق (ما وراء الطبيعة))\nمثال: معتقدات خارقة للطبيعة",
 "supernaturalistic": "خارقي, فوق طبيعي (متعلق بالاعتقاد بالخوارق (ما وراء الطبيعة))\nمثال: معتقدات خارقة للطبيعة",
 "supernaturally": "بشكل خارق للطبيعة (بطريقة تفوق الطبيعة)\nمثال: كانت جميلة بشكل خارق للطبيعة",
 "supernaturalness": "خَوَارِقِيَّة, فَوْق طَبِيعِيَّة (صفة كون الشيء منسوباً لقوة تبدو وكأنها تنتهك أو تتجاوز القوى الطبيعية)",
 "supernormal": "فَوْق الطَّبِيعِيّ (يتجاوز المستوى الطبيعي أو المتوسط) / خَارِق لِلْعَادَة, فَوْق طَبِيعِيّ (يتجاوز نطاق ما هو طبيعي أو قابل للتفسير علميًّا)",
 "supernova": "مُسْتَعِر أَعْظَم",
 "supernumerary": "زَائِد, فَائِض (أكثر مما هو مطلوب أو مرغوب فيه أو لازم) / كومبارس, ممثل إضافي (ممثل ثانوي يظهر في مشاهد الحشود) / زَائِد عَنِ الْحَاجَة, عَمَالَة فَائِضَة (شخص لا يؤدي وظيفة ظاهرة)",
 "superorder": "فوق رتبة ((في الأحياء) مجموعة تصنيفية تقع فوق الرتبة وتحت الطائفة أو الطويئفة)",
 "superordinate": "أَعْلَى رُتْبَةً (ذو رتبة أو مكانة أو قيمة أعلى) / اسم شامل, لفظ أعم (كلمة أكثر شمولاً وعمومية من كلمة أخرى) / أعلى مرتبة, رئيس (شخص ذو رتبة أو مكانة أو جودة أعلى)",
 "superordinate word": "اسم شامل, لفظ أعم (كلمة أكثر شمولاً وعمومية من كلمة أخرى)",
 "superordination": "اشْتِمَال, فَوْقِيَّة دَلَالِيَّة (العلاقة الدلالية لكون الكلمة شاملة أو تابعة لرتبة أو فئة أعلى (مثل: فاكهة شاملة لتفاحة))",
 "superoxide": "أَنْيُون السُّوبَر أُوكْسِيد, فَوْق أُكْسِيد / سوبر أكسيد",
 "superoxide anion": "أَنْيُون السُّوبَر أُوكْسِيد, فَوْق أُكْسِيد",
 "superoxide dismutase": "ديسموتاز الفائق (إنزيم يحفز تحويل الأكسيد الفائق إلى بيروكسيد الهيدروجين والأكسجين)\nمثال: تتم إزالة الجذور الحرة للأكسجين عادة في أجسامنا بواسطة إنزيمات ديسموتاز الفائق",
 "superpatriotic": "شُوفِينِيّ, مُتَعَصِّبٌ وَطَنِيًّا (مُتَعَصِّبٌ لِلْوَطَنِيَّةِ تَعَصُّبًا مُفْرِطًا)",
 "superpatriotism": "تَعَصُّب وَطَنِيّ, شُوفِينِيَّة (وطنية متعصبة)",
 "superphylum": "فوق شعبة ((في الأحياء) مجموعة تصنيفية تقع بين الشعبة وتحت الطائفة أو الطويئفة)",
 "superposable": "قَابِلٌ لِلتَّطَابُقِ, مُتَمَاثِل (يَتَطَابَقُ تَمَامًا عِنْدَ وَضْعِهِ فَوْقَ الآخَرِ)",
 "superposition": "تراكب, تطابق (وضع شيء فوق شيء آخر) / تطابق هندسي ((هندسة) وضع كائن بشكل مثالي في موضع آخر لإظهار أن الاثنين يتطابقان) / مبدأ التراكب, مبدأ التعاقب الطبقي ((جيولوجيا) المبدأ القائل بأنه في سلسلة من الصخور الرسوبية الطبقية، تكون الطبقة السفلى هي الأقدم) / تراكب, تطابق الطبقات ((في الجيولوجيا) ترسب طبقة جيولوجية فوق أخرى)",
 "superposition principle": "مبدأ التراكب, مبدأ التعاقب الطبقي ((جيولوجيا) المبدأ القائل بأنه في سلسلة من الصخور الرسوبية الطبقية، تكون الطبقة السفلى هي الأقدم)",
 "superpower": "قُوَى عُظْمَى",
 "supersaturated": "فَائِق التَّشَبُّع (أَكْثَر تَرْكِيزًا مِمَّا هُوَ مُمْكِن عَادَةً؛ لَيْسَ فِي حَالَة تَوَازُن)",
 "superscript": "علوي, مرتفع (نص) (مكتوب أو مطبوع فوق وإلى جانب حرف آخر) / حرف علوي, نص مرتفع (حرف أو رمز يوضع أو يُطبع أو يُكتب فوق وإلى جانب حرف آخر مباشرة)",
 "superscription": "كتابة فوقية (نشاط الكتابة فوق شيء ما) / كتابة فوقية (نص مكتوب فوق شيء آخر)",
 "supersedure": "إحلال, حلول محل (فعل استبدال شخص أو شيء بآخر خاصة إذا كان يعتبر متفوقاً)",
 "supersensitised": "تَحَسُّسِيّ, مُفْرِط الحَسَاسِيَّة (لديه حساسية أو قابلية مفرطة أو خاصة (تجاه عامل معين))",
 "supersensitive": "تَحَسُّسِيّ, مُفْرِط الحَسَاسِيَّة (لديه حساسية أو قابلية مفرطة أو خاصة (تجاه عامل معين))",
 "supersensitized": "تَحَسُّسِيّ, مُفْرِط الحَسَاسِيَّة (لديه حساسية أو قابلية مفرطة أو خاصة (تجاه عامل معين))",
 "supersession": "إحلال, حلول محل (فعل استبدال شخص أو شيء بآخر خاصة إذا كان يعتبر متفوقاً)",
 "superslasher": "يوتارابتور (ديناصور لاحم كبير (20 قدماً) وسريع له مخلب قاطع منتصب بطول 15 بوصة في كل قدم خلفية؛ من أوائل العصر الطباشيري)",
 "supersonic": "فَوْق سَمْعِيّ, فَوْق صَوْتِيّ (ذو ترددات أعلى من الصوت المسموع) / أَسْرَع مِن الصَّوْت, فَوْق صَوْتِيّ ((للسرعة) أكبر من سرعة الصوت في وسط معين (خاصة الهواء))\nمثال: قاذفة تفوق سرعة الصوت تطير بسرعة كبيرة لدرجة أنها يجب أن تطلق قنابلها بينما لا يزال الهدف فوق الأفق",
 "superstar": "بارع, جهبذ (شخص يتمتع بمهارة مذهلة في أي مجال)",
 "superstition": "خُرَافَة",
 "superstitious": "خُرَافِيّ",
 "superstitious notion": "تطير, خرافة (معتقد غير عقلاني نابع من الجهل أو الخوف)",
 "superstitiously": "باعتقاد خرافي, بخرافة (بطريقة خرافية)\nمثال: رفض السفر يوم الجمعة الثالث عشر بسبب اعتقاد خرافي",
 "superstrate": "لغة فوقية (لغة شعب غازٍ لاحق تُفرض على السكان الأصليين وتساهم بخصائص في لغتهم) / طبقة علوية, طبقة فوقية (أي طبقة توضع فوق أخرى)",
 "superstratum": "لغة فوقية (لغة شعب غازٍ لاحق تُفرض على السكان الأصليين وتساهم بخصائص في لغتهم) / طبقة علوية, طبقة فوقية (أي طبقة توضع فوق أخرى)",
 "superstring": "وَتَر فَائِق (جسيم افتراضي يعتبر الجسيم الأولي في نظرية الزمكان)",
 "superstructure": "بنية فوقية (هيكل يتكون من جزء السفينة الموجود فوق السطح الرئيسي)",
 "supersymmetry": "تتناظر فائق ((فيزياء) نظرية تحاول الربط بين القوى الأساسية الأربع)",
 "supertanker": "ناقلة نفط عملاقة (أكبر فئة من ناقلات النفط)",
 "supertax": "ضريبة إضافية (ضريبة إضافية على أنواع معينة من الدخل الذي تم فرض ضريبة عليه بالفعل)",
 "supertitle": "ترجمة علوية (ترجمة كلمات أوبرا أجنبية (أو عمل كورالي) تُعرض على شاشة فوق المسرح)",
 "supertonic": "فوق النغمة الأساسية ((موسيقى) النغمة الثانية في سلم دياتوني)",
 "supertwister": "إعصار قمعي فائق (أقوى أنواع الأعاصير القمعية التي يمكن أن تخلف دماراً هائلاً)\nمثال: الأعاصير القمعية الفائقة نادرة لحسن الحظ",
 "supervention": "حدوث إضافي, طروء (الحدوث بشكل تالٍ أو إضافي)",
 "supervillain": "شرير خارق (شرير يتمتع بقوى خارقة)",
 "supervised": "خاضع للإشراف, مُراقب (تحت المراقبة أو تحت توجيه مشرف أو ناظر)\nمثال: لعب تحت الإشراف",
 "supervising": "إشراف, رقابة (الإدارة من خلال الإشراف على أداء أو تشغيل شخص أو مجموعة)",
 "supervision": "إشراف, رقابة (الإدارة من خلال الإشراف على أداء أو تشغيل شخص أو مجموعة)",
 "supervisor": "مُشْرِف, مُشْرِفَة",
 "supervisor call instruction": "استدعاء النظام (تعليمة تقاطع البرنامج الجاري تنفيذه وتمرر التحكم إلى المشرف (نظام التشغيل))",
 "supervisory": "إشرافي, رقابي (متعلق بالإشراف أو يقتصر عليه أو ينطوي عليه)\nمثال: بصفة إشرافية",
 "supervisory program": "برنامج إشرافي, برنامج تنفيذي (برنامج يتحكم في تنفيذ البرامج الأخرى)",
 "supervisory routine": "روتين إشرافي, روتين تنفيذي (روتين ينسق تشغيل الروتينات الفرعية)",
 "supervisory software": "برمجيات إشرافية (برامج متخصصة توجد بشكل دائم في الذاكرة الرئيسية للحاسوب وتتحكم في معالجة برامج المستخدم)",
 "supination": "استلقاء, بسط الراحة (تدوير اليدين والساعدين بحيث تتجه راحة اليد لأعلى)",
 "supinator": "عضلة استلقائية (عضلة (خاصة في الساعد) تنتج أو تساعد في الاستلقاء)",
 "supine": "مُتَخَاذِل, مُتَقَاعِس (سلبيّ نتيجة الكسل أو اللامبالاة) / مُسْتَلْقٍ عَلَى ظَهْرِه (مستلقٍ على الظهر ووجهه للأعلى)",
 "supinely": "بخنوع, بسلبية (بطريقة خاملة وغير مبالية) / مستلقياً على الظهر (والوجه للأعلى)\nمثال: فرض عليّ الأمر وقبلته بخنوع",
 "supper": "عَشَاء (طَعَام العَشِيّ. وهو الطعام الذي يؤكل في المَسَاء) / تَعَشَّى (تَنَاوَلَ العَشَاء)\nمثال: هل العشاء جاهز؟",
 "supper club": "نادٍ للعشاء (عادة ما يكون ملهى ليلي صغير فاخر)",
 "supperless": "بِلَا عَشَاء (بدون وجبة عشاء)",
 "suppertime": "وقت العشاء (الساعة المعتادة أو العرفية لتناول وجبة المساء)",
 "supping": "احتساء, تعشي (تناول الطعام السائل بملعقة أو بالشرب)",
 "supplanter": "مغتصب للسلطة (من يستولي على مكان آخر ويحتفظ به ظلماً أو بشكل غير قانوني)",
 "supplanting": "إزاحة, استبدال (فعل أخذ مكان آخر خاصة باستخدام تكتيكات ملتوية)",
 "supple": "رَشِيق, لَدْن ((عَنْ أَجْسَادِ الأَشْخَاصِ) قَادِرٌ عَلَى الحَرَكَةِ أَوِ الِانْثِنَاءِ بِحُرِّيَّةٍ) / سَلِس, طَيِّع ((عَنْ سِمَاتِ الشَّخْصِيَّةِ) سَرِيعُ التَّكَيُّفِ) / رَشِيق, لَدِن (نحيل بأناقة ويتحرك وينثني بسهولة ويُسر)",
 "supplejack": "عصا خيزران أمريكية (عصا مشي مصنوعة من خشب كرمة استوائية أمريكية)",
 "supplement": "ملحق / مُكَمِّل",
 "supplemental": "إِضَافِيّ, تَكْمِيلِيّ (يُضاف لإتمام النقص أو سدّ الحاجة) / إِضَافِيّ, تَكْمِيلِيّ (يعمل في صفة داعمة ومساندة)",
 "supplementary": "إِضَافِيّ (إِضافيّ : ما يُضاف ، ما يُزاد؛ ما يُتْبَع شيئاً آخر ، ما يُلْحَق به ، ما يُزاد على الأصل)\nمثال: ستعطيني بطانية إضافية.",
 "supplementary benefit": "إعانة تكميلية, مساعدة اجتماعية (مزايا تُدفع لرفع الدخل إلى الحد الأدنى للمستويات التي يحددها القانون)",
 "supplementation": "إلحاق, تكميل (عملية التكميل) / إضافة, تكملة (كمية تضاف (مثلاً لتعويض نقص))",
 "suppleness": "طواعية, ليونة (القدرة على التكيف في العقل أو الشخصية) / لدونة, ليونة (رشاقة شخص أو حيوان مرن ولين) / لدونة, ليونة (خاصية كون الشيء ليناً ومرناً)\nمثال: كان مقدرًا لموثوقيته وطواعيته",
 "suppliant": "خَاشِع, مُتَضَرِّع (يَتَوَسَّلُ بِتَوَاضُعٍ وَخُشُوع) / مستعطف, ملتمس (شخص يطلب شيئاً بتواضع)\nمثال: مستعطف لرضاها",
 "supplicant": "خَاشِع, مُتَضَرِّع (يَتَوَسَّلُ بِتَوَاضُعٍ وَخُشُوع) / مستعطف, ملتمس (شخص يطلب شيئاً بتواضع) / مبتهل, مصلٍ (شخص يصلي لله)\nمثال: مستعطف لرضاها",
 "supplication": "ابتهال, دعاء (فعل التواصل مع إله (خاصة كطلب أو في العبادة أو الندم أو الشكر)) / استعطاف, التماس (طلب متواضع للمساعدة من شخص في السلطة) / ابتهال, دعاء (صلاة لطلب عون الله كجزء من خدمة دينية)\nمثال: جثا الكاهن على ركبتيه في صلاة",
 "supplicatory": "خَاشِع, مُتَضَرِّع (يَتَوَسَّلُ بِتَوَاضُعٍ وَخُشُوع)",
 "supplier": "مُزَوِّد, مُزَوِّدَة",
 "supply": "زَوَّدَ (زَوَّدَ (زوده): أزاده. ويقال زودته كتابا إلى فلان؛ زَوَّدَ(هـ) بكذا: أمده به) / تَوْرِيد, تَزْوِيد / ذَخِيرَة",
 "supply and demand": "الْعَرْض وَالْطَلَب",
 "supply chamber": "غرفة التزويد (جهاز ميكانيكي لحمل شيء ما وتزويده حسب الحاجة)",
 "supply closet": "خزانة مؤن (خزانة لتخزين الإمدادات)",
 "supply curve": "منحنى العرض (في الاقتصاد، تمثيل بياني للعلاقة بين سعر المنتج وكمية المنتج التي يرغب البائع ويقدر على توريدها)",
 "supply line": "خط إمداد, طريق إمداد (طريق يمكن من خلاله توصيل الإمدادات)",
 "supply officer": "ضابط إمداد (ضابط مفوض مسؤول عن الخدمات اللوجستية)",
 "supply route": "خط إمداد, طريق إمداد (طريق يمكن من خلاله توصيل الإمدادات)",
 "supply ship": "سفينة تموين (سفينة توفر عادة الإمدادات لسفن أخرى)",
 "supply-side economics": "اقتصاد جانب العرض (مدرسة النظرية الاقتصادية التي تؤكد على تكاليف الإنتاج كوسيلة لتحفيز الاقتصاد)",
 "supplying": "إمداد, تزويد (نشاط توريد أو توفير شيء ما)",
 "support": "دَعَمَ, دَعَّمَ (• دَعَمَهُ، كمنَعهُ: مالَ فأقامَهُ) / أَيَّدَ, دَعَمَ ((أَيَّدَه): قوّاه بالإياد) / تَأْيِيد, دَعْم\nمثال: ياني هنا لدعم ريمة.",
 "support column": "عمود دعم (عمود يدعم وزناً ثقيلاً)",
 "support hose": "جوارب داعمة, جوارب طبية (جورب مرن يهدف إلى تخفيف الضغط على أوردة الساق (كما في حالة الدوالي))",
 "support level": "مستوى الدعم ((سوق الأسهم) السعر الذي تصبح عنده ورقة مالية معينة جذابة للمستثمرين)",
