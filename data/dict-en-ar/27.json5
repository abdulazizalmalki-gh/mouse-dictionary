 "streptococci": "ستربتوكوكس, مكورة عقدية (بكتيريا كروية موجبة الجرام توجد في أزواج أو سلاسل؛ تسبب أمراضاً مثل الحمى القرمزية والتهاب اللوزتين)",
 "streptococcic": "بكتيري عقدي, عقدي (من أو متعلق بـ أو ناتج عن المكورات العقدية)",
 "streptococcus": "ستربتوكوكس, مكورة عقدية (بكتيريا كروية موجبة الجرام توجد في أزواج أو سلاسل؛ تسبب أمراضاً مثل الحمى القرمزية والتهاب اللوزتين)",
 "streptococcus anhemolyticus": "ستربتوكوكس, مكورة عقدية (بكتيريا كروية موجبة الجرام توجد في أزواج أو سلاسل؛ تسبب أمراضاً مثل الحمى القرمزية والتهاب اللوزتين)",
 "streptococcus tonsilitis": "التهاب الحلق العقدي (عدوى في البلعوم الفموي واللوزتين بواسطة المكورات العقدية)",
 "streptodornase": "ستربتودورناز (إنزيم تنتجه بعض سلالات العقديات المحللة للدم يذيب الإفرازات الليفية من العدوى؛ يُستخدم طبياً (غالباً مع الستربتوكيناز))",
 "streptokinase": "ستربتوكيناز (إنزيم تنتجه بعض سلالات العقديات يمكنه تسييل جلطات الدم عن طريق تحويل البلازمينوجين إلى بلازمين؛ يُستخدم طبياً في بعض حالات احتشاء عضلة القلب…)",
 "streptolysin": "ستريبتوليسين (أي من عدة حالات الدم المشتقة من سلالات المكورات العقدية)",
 "streptomyces": "ستربتوميسيس, متسلسلة (بكتيريا هوائية (ينتج بعضها المضاد الحيوي ستربتومايسين))",
 "streptomyces erythreus": "متسلسلة حمراء (مصدر للمضاد الحيوي إريثروميسين)",
 "streptomyces griseus": "متسلسلة رمادية (مصدر للمضاد الحيوي ستربتومايسين)",
 "streptomyces scabies": "بكتيريا جرب البطاطس, متسلسلة جربية (مسبب لمرض البطاطس الذي يتميز بأنسجة فلينية بنية اللون)",
 "streptomycin": "ستربتوميسين",
 "streptopelia risoria": "يمامة مطوقة (يمامة من العالم القديم رمادية اللون ذات شريط أسود حول الرقبة؛ غالباً ما تُربى في أقفاص)",
 "streptopelia turtur": "قمري (الحمامة البرية الأوروبية الشائعة المعروفة بهديلها الحزين)",
 "streptosolen jamesonii": "شجيرة المربى, شجيرة النار (شجيرة دائمة الخضرة من أمريكا الجنوبية لها زهور برتقالية بارزة بوقية الشكل؛ تزرع كنبات زينة أو نبات منزلي)",
 "streptothricin": "ستربتوتريسين (مضاد حيوي قاعدي مشتق من شعيات التربة)",
 "stress": "إِجْهَاد",
 "stress fracture": "كسر إجهادي (كسر ناتج عن نشاط مفرط بدلاً من إصابة محددة)",
 "stress incontinence": "سلس الإجهاد (سلس البول الذي يحدث عند وضع ضغط لا إرادي على المثانة عن طريق السعال أو الضحك أو العطس أو الرفع أو الإجهاد)",
