 "taleteller": "نمّام, واشٍ (شخص يثرثر بشكل غير حكيم)",
 "taliban": "طَالِبَان",
 "talinum augustissimum": "زهرة اللهب ضيقة الأوراق",
 "talinum aurantiacum": "تالينوم برتقالي, زهرة اللهب (نبات ذو جذور لحمية وسيقان منتصبة بأوراق عصارية ضيقة وزهرة واحدة برتقالية محمرة في كل إبط ورقة علوية؛ جنوب غرب الولايات المتحدة؛ كان الهنود يطبخون…)",
 "talinum brevifolium": "تالينوم قزم (نبات منخفض ذو أوراق عصارية ضيقة مزدحمة وأزهار إبطية وردية داكنة كبيرة نوعاً ما تبدو وكأنها تجلس على الأرض؛ جنوب غرب الولايات المتحدة)",
 "talinum calycinum": "قرنفل الصخر (نبات معمر ذو أزهار وردية من المناطق الصخرية بغرب الولايات المتحدة)",
 "talinum paniculatum": "تالينوم عنقودي, جواهر أوبار (نبات منتصب ذو جذور درنية وعناقيد طرفية من الزهور الحمراء إلى الصفراء؛ جنوب غرب أمريكا الشمالية إلى أمريكا الوسطى؛ أدخل على نطاق واسع في أماكن أخرى)",
 "talinum spinescens": "تالينوم شوكي (نبات منخفض يشكل وسادة ذو أزهار وردية إلى قرمزية أرجوانية وأضلاع أوراق وسطية تستمر كأشواك عند موت الأوراق؛ جنوب غرب الولايات المتحدة)",
 "taliped": "أَفْحَج, مُشَوَّه القَدَم (ذو قدم مشوّهة أو مصابة بحنف القدم)",
 "talipes": "حنف القدم, قدم حنفاء (تشوه خلقي في القدم يتميز عادةً بشكل ملتوي أو وضعية ملتوية للكاحل والكعب وأصابع القدم)",
 "talipes calcaneus": "حنف القدم العقبي (حنف قدم تكون فيه أصابع القدم موجهة لأعلى ويمشي الشخص على كعب القدم)",
 "talipes equinus": "حنف القدم الخيلي (حنف قدم تكون فيه أصابع القدم موجهة لأسفل)",
 "talipes valgus": "حنف القدم الروحي (تشوه في القدم تكون فيه القدم ملتوية للخارج)",
