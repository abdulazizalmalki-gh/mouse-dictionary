 "swagger stick": "عصا التبختر (عصا قصيرة أو عكاز مغطى بالجلد يحمله ضباط الجيش)",
 "swaggerer": "متبختر (شخص يمشي بطريقة متغطرسة)",
 "swaggering": "مُتَبَخْتِر, مُتَهَوِّر بِمَرَح (مغامر بطريقة استعراضية وبَاهرة) / مُتَعَجْرِف, مُتَكَبِّر (لديه أو يُظهِر تفوّقًا متعجرفًا واحتقارًا لمن يعتبرهم أدنى منه)",
 "swaggie": "عامل متجول أسترالي (عامل أسترالي متجول يحمل ممتلكاته الشخصية في صرة أثناء سفره بحثاً عن عمل)",
 "swaging machine": "آلة تشكيل بالطرق (آلة تشكل الصفائح المعدنية باستخدام قالبين أو أربعة قوالب مقسمة تنفصل وتغلق حتى 2000 مرة في الدقيقة)",
 "swagman": "عامل متجول (عامل أسترالي متجول ذكر يحمل ممتلكاته الشخصية في حزمة أثناء سفره بحثاً عن عمل)",
 "swagwoman": "عاملة متجولة (عاملة أسترالية متجولة أنثى تحمل ممتلكاتها الشخصية في حزمة أثناء سفرها بحثاً عن عمل)",
 "swahili": "السَّوَاحِلِيَّة",
 "swahili language": "السواحيلية (أكثر لغات البانتو انتشارًا؛ اللغة الرسمية لكينيا وتنزانيا وتستخدم على نطاق واسع كلغة مشتركة في شرق ووسط أفريقيا)",
 "swain": "حبيب, صديق حميم (رجل هو عشيق لرجل أو امرأة)\nمثال: لو علمت أنه حبيبها لما سألت",
 "swainsona galegifolia": "بازلاء دارلينج الملساء (نبات معمر منتصب أو زاحف في شرق أستراليا ذو عناقيد إبطية من الزهور الزرقاء إلى الأرجوانية أو الحمراء)",
 "swainsona grandiflora": "بازلاء دارلينج المشعرة (نبات معمر شجيري في جنوب أستراليا ذو سيقان وجوانب سفلية للأوراق زغبية أو صوفية وعناقيد من الزهور الحمراء إلى الوردية)",
 "swainsona greyana": "بازلاء دارلينج المشعرة (نبات معمر شجيري في جنوب أستراليا ذو سيقان وجوانب سفلية للأوراق زغبية أو صوفية وعناقيد من الزهور الحمراء إلى الوردية)",
 "swale": "أرض منخفضة, منخفض (منطقة منخفضة (خاصة منطقة مستنقعية بين التلال))",
 "swallow": "جَرَعَ, بَلَعَ ((جَرَعَ) المَاء وَنَحْوه جرعا: بَلِعَه) / جَرْعَة, شَرْبَة / سُنُونُو",
 "swallow dive": "غطسة البجعة (غطسة يقوس فيها الغطاس ظهره وذراعاه ممدودتان قبل دخول الماء)",
 "swallow hole": "بالوعة, حفرة إذابة (منخفض في الأرض يتصل بممر تحت الأرض (خاصة في الحجر الجيري) ويتكون عن طريق الذوبان أو انهيار سقف كهف)",
 "swallow shrike": "سنونو الغابة (طائر أسترالي وآسيوي قريب من الصرد ويشبه السنونو)",
 "swallow wort": "بقلة الخطاطيف, عروق الصباغين (عشبة معمرة بجذع خشبي متفرع وزهور صفراء زاهية)",
 "swallow-tailed": "سُنُونِيّ الذَّيْل ((خاصّة للفراشات والطيور) ذو ذيل متشعّب كذيل السنونو)",
 "swallow-tailed coat": "بدلة ذيل, معطف ذيل السنونو (سترة رسمية للرجال بذيلين طويلين مدببين في الخلف)",
 "swallow-tailed hawk": "حدأة خطافية الذيل (حدأة رشيقة سوداء وبيضاء من أمريكا الشمالية)",
 "swallow-tailed kite": "حدأة خطافية الذيل (حدأة رشيقة سوداء وبيضاء من أمريكا الشمالية)",
 "swallowtail": "بدلة ذيل, معطف ذيل السنونو (سترة رسمية للرجال بذيلين طويلين مدببين في الخلف)",
 "swallowwort": "بقلة الخطاطيف, عروق الصباغين (عشبة معمرة بجذع خشبي متفرع وزهور صفراء زاهية) / زهرة الدم, صقلاب قرمزي (عشب استوائي له زهور برتقالية حمراء تليها قرون توحي بابتلاع بأجنحة مفرودة؛ عشب ضار في جميع أنحاء المناطق الاستوائية)",
 "swami": "سوامي (معلم ديني هندوسي؛ يستخدم كلقب للاحترام)",
 "swamp": "مُسْتَنْقَع",
 "swamp ash": "مران المستنقعات (مران صغير في المناطق المستنقعية بجنوب شرق الولايات المتحدة)",
 "swamp azalea": "أزاليا المستنقعات (شجيرة تنمو في المستنقعات في جميع أنحاء شرق الولايات المتحدة ولها زهور بيضاء إلى وردية صغيرة تشبه زهر العسل)",
 "swamp bay": "غار حلو, ماغنوليا فرجينيا (شجيرة أو شجرة صغيرة ذات زهور بيضاء عطرية صغيرة نوعاً ما؛ وفيرة في جنوب شرق الولايات المتحدة)",
 "swamp birch": "بتولا المستنقعات, بتولا مائية (بتولا من غرب الولايات المتحدة تشبه البتولا الورقية ولكن لها لحاء بني)",
 "swamp blackberry": "ديوبيري المستنقعات",
 "swamp blueberry": "توت أزرق عالي الشجيرة (شجيرة متساقطة الأوراق عالية النمو من شرق أمريكا الشمالية تحمل توتاً مائلاً للزرقة إلى السواد صالحاً للأكل مع طبقة شمعية مميزة؛ مصدر لمعظم التوت…)",
 "swamp buggy": "عربة المستنقعات (مركبة برمائية عادة ذات دفع رباعي وجسم مرتفع)",
 "swamp candleberry": "توت الشمع, شمعية (شجيرة عطرية نفضية من شرق أمريكا الشمالية بتوت مغطى بالشمع الرمادي الأخضر)",
 "swamp candles": "شموع المستنقع (نبات من أمريكا الشمالية ذو سنابل من الزهور الصفراء، يوجد في الأماكن الرطبة)",
 "swamp chestnut oak": "سنديان المستنقعات الكستنائي, سنديان كستنائي (شجرة نفضية متوسطة إلى كبيرة الحجم تنمو في المناطق الرطبة بجنوب شرق الولايات المتحدة، تشبه سنديان السلال)",
 "swamp cottonwood": "خشب القطن المستنقعي (حور من أمريكا الشمالية بأوراق كبيرة مستديرة صدفيّة ولحاء وخشب بني)",
 "swamp cypress": "سرو أصلع, سرو المستنقعات (خشب سرو شائع في جنوب شرق الولايات المتحدة له جذع موسع عند القاعدة؛ يوجد في المستنقعات الساحلية وقيعان الأنهار الفيضية) / سرو أصلع, سرو المستنقعات (سرو شائع في جنوب شرق الولايات المتحدة له جذع متوسع عند القاعدة؛ يوجد في المستنقعات الساحلية وقيعان الأنهار الفيضية)",
 "swamp dewberry": "ديوبيري المستنقعات",
 "swamp fever": "حمى المستنقعات, داء البريميات (مرض معد تسببه البريميات وينتقل إلى البشر من الحيوانات الأليفة؛ يتميز باليرقان والحمى)",
 "swamp fly honeysuckle": "عسلة الذباب المستنقعية (صنف من عسلة الذباب)",
 "swamp gum": "صمغ المستنقعات (شجرة متوسطة الحجم من جنوب أستراليا)",
 "swamp hare": "أرنب المستنقعات (أرنب غابات يعيش في مستنقعات وأراضي جنوب شرق الولايات المتحدة المنخفضة)",
 "swamp hickory": "جوز مر (جوز من شرق الولايات المتحدة له أوراق بـ 7 أو 9 وريقات ومكسرات مرة جداً رقيقة القشرة)",
 "swamp honeysuckle": "أزاليا المستنقعات (شجيرة تنمو في المستنقعات في جميع أنحاء شرق الولايات المتحدة ولها زهور بيضاء إلى وردية صغيرة تشبه زهر العسل)",
 "swamp horsetail": "ذيل الحصان المائي, ذيل الحصان المستنقعي (أوراسيا؛ شمال أمريكا الشمالية إلى فرجينيا)",
 "swamp laurel": "غار حلو, ماغنوليا فرجينيا (شجيرة أو شجرة صغيرة ذات زهور بيضاء عطرية صغيرة نوعاً ما؛ وفيرة في جنوب شرق الولايات المتحدة) / غار المستنقعات (غار مستنقعات شمال غرب الولايات المتحدة له زهور أرجوانية صغيرة وأوراق شاحبة زرقاء من الأسفل)",
 "swamp lily": "ذيل السحلية, زنبق المستنقع (نبات معمر عشبي من أمريكا الشمالية في الأماكن الرطبة له عناقيد رفيعة مجعدة من الزهور البيضاء الصغيرة)",
 "swamp locust": "جراد الماء, خروب المستنقعات (شجرة خروب العسل في المستنقعات والأراضي المنخفضة بجنوب الولايات المتحدة لها قرون بيضاوية قصيرة؛ تنتج خشباً ثقيلاً داكناً)",
 "swamp mallow": "ختمية المستنقعات, ختمية وردية (شجيرة مبهرجة في المستنقعات المالحة بشرق الولايات المتحدة ذات زهور وردية كبيرة)",
 "swamp maple": "قيقب أحمر, قيقب قرمزي (قيقب من شرق ووسط أمريكا؛ أوراقه خماسية الفصوص تتحول إلى القرمزي والأصفر في الخريف)",
 "swamp milkweed": "صقلاب المستنقعات (نبات معمر كثيف التفرع من شرق الولايات المتحدة بزهور بيضاء إلى قرمزية أو أرجوانية)",
 "swamp oak": "بلوط المستنقعات, سنديان المستنقعات الأبيض (سنديان نفضي كبير موطنه شرق الولايات المتحدة، ذو لحاء مقشر وأوراق تحتوي على فصوص أقل من السنديان الأبيض الآخر؛ ينتج خشباً ثقيلاً وقوياً يستخدم في…) / بلوط المستنقعات, بلوط دبوسي (شجرة متساقطة الأوراق هرمية سريعة النمو متوسطة إلى كبيرة من شمال شرق الولايات المتحدة وجنوب شرق كندا لها أوراق ريشية عميقة تتحول إلى الأحمر الساطع في…) / بلوط المستنقعات, فيميناريا (شجيرة أسترالية بلا أوراق تشبه الوزال ولها زهور صفراء صغيرة)",
 "swamp pine": "صنوبر المستنقعات (أي من عدة أنواع من الصنوبر التي تفضل أو تتحمل المواقف الرطبة مثل صنوبر لوبلولي أو الصنوبر طويل الأوراق)",
 "swamp plant": "نبات المستنقعات (نبات شبه مائي ينمو في الأراضي الرطبة الرخوة؛ معظمها من ذوات الفلقة الواحدة: السعادى، الطحالب، الأعشاب، البردي، إلخ؛ وربما الخلنج)",
 "swamp poplar": "خشب القطن المستنقعي (حور من أمريكا الشمالية بأوراق كبيرة مستديرة صدفيّة ولحاء وخشب بني)",
 "swamp rabbit": "أرنب المستنقعات (أرنب غابات يعيش في مستنقعات وأراضي جنوب شرق الولايات المتحدة المنخفضة) / أرنب الأهوار (أرنب غابات يعيش في المناطق الساحلية المستنقعية من نورث كارولينا إلى فلوريدا)",
 "swamp red oak": "سنديان أحمر جنوبي, سنديان إسباني (شجرة نفضية كبيرة مستديرة القمة ذات فروع منتشرة وأوراق ضيقة منجلية الشكل ذات فصوص عميقة التموج، وخشبها مشابه لخشب السنديان الأحمر الشمالي؛ تنتشر من…)",
 "swamp rose mallow": "ختمية المستنقعات, ختمية وردية (شجيرة مبهرجة في المستنقعات المالحة بشرق الولايات المتحدة ذات زهور وردية كبيرة)",
 "swamp sparrow": "عصفور المستنقع (عصفور من أمريكا الشمالية يعيش في المناطق المستنقعية)",
 "swamp sunflower": "عباد شمس المستنقعات (عباد شمس في شرق أمريكا الشمالية ذو أوراق ضيقة ويوجد في المستنقعات)",
 "swamp white oak": "بلوط المستنقعات, سنديان المستنقعات الأبيض (سنديان نفضي كبير موطنه شرق الولايات المتحدة، ذو لحاء مقشر وأوراق تحتوي على فصوص أقل من السنديان الأبيض الآخر؛ ينتج خشباً ثقيلاً وقوياً يستخدم في…)",
 "swamp willow": "صفصاف أسود, صفصاف المستنقعات (صفصاف شجيري في أمريكا الشمالية ذو لحاء داكن وأوراق خطية ينمو بالقرب من الجداول والبحيرات)",
 "swamphen": "دجاجة الماء (طَيْر من الدواجن، لا يطير ويربيه البشر لبيضه ولحمه وريشه؛ أنثى بعض الطيور من الفصائل التي لا تطير كالقَبَج وغيره)\nمثال: وضعت الدجاجة بيضة.",
 "swampland": "مستنقع (أرض منخفضة تغمرها المياه موسمياً؛ تحتوي على نباتات خشبية أكثر من الهور وتصريفها أفضل من المستنقعات الخثية)",
 "swampy": "مُسْتَنْقَعِيّ, وَحِل ((عن التربة) ليّنة ومشبَعة بالماء)",
 "swampy beggar-ticks": "قراد المتسول المستنقعي (قطيفة شائكة في شرق وشمال الولايات المتحدة وكندا شائعة في المراعي والمروج الرطبة)",
 "swan": "تَمّ, قُقْنُس",
 "swan dive": "غطسة البجعة (غطسة يقوس فيها الغطاس ظهره وذراعاه ممدودتان قبل دخول الماء)",
 "swan orchid": "أوركيد البجعة, زهرة البجعة (أي من عدة بساتين فاكهة من جنس سيكنوتشيس ذات أعمدة مقوسة نحيلة من الزهور توحي برقبة بجعة)",
 "swan river daisy": "أقحوان نهر سوان (نبات حولي من غرب أستراليا يُزرع كثيراً لرؤوس أزهاره ذات الأشعة البيضاء أو المائلة للزرقة إلى البنفسجية أو المتنوعة)",
 "swan river everlasting": "رودانث",
 "swan song": "أغنية البجعة, العمل الأخير (أداء أو جهد أخير (خاصة قبل التقاعد))",
 "swan's down": "زَغَبُ البَجَع (زغب البجع) / زغب البجع (قماش صوفي ناعم يستخدم خاصة لملابس الأطفال)",
 "swan-flower": "أوركيد البجعة, زهرة البجعة (أي من عدة بساتين فاكهة من جنس سيكنوتشيس ذات أعمدة مقوسة نحيلة من الزهور توحي برقبة بجعة)",
 "swan-neck": "أوركيد البجعة, زهرة البجعة (أي من عدة بساتين فاكهة من جنس سيكنوتشيس ذات أعمدة مقوسة نحيلة من الزهور توحي برقبة بجعة)",
 "swanflower": "أوركيد البجعة, زهرة البجعة (أي من عدة بساتين فاكهة من جنس سيكنوتشيس ذات أعمدة مقوسة نحيلة من الزهور توحي برقبة بجعة)",
 "swank": "فَخْم, مُتَبَاهٍ بِالأَنَاقَة (أَنِيق وَفَاخِر بِشَكْلٍ مُهِيب) / أَنَاقَة عَصْرِيَّة, شِيَاكَة (الأناقة بحكم مسايرة الموضة)",
 "swanky": "فَخْم, مُتَبَاهٍ بِالأَنَاقَة (أَنِيق وَفَاخِر بِشَكْلٍ مُهِيب)",
 "swanneck": "أوركيد البجعة, زهرة البجعة (أي من عدة بساتين فاكهة من جنس سيكنوتشيس ذات أعمدة مقوسة نحيلة من الزهور توحي برقبة بجعة)",
 "swap": "مُبَادَلَة",
 "swap file": "مساحة التبادل, ملف التبادل (مساحة القرص المخصصة للذاكرة الافتراضية)",
 "swap space": "مساحة التبادل, ملف التبادل (مساحة القرص المخصصة للذاكرة الافتراضية)",
 "sward": "طبقة عشبية, عشب (طبقة سطحية من الأرض تحتوي على حصير من العشب وجذوره)",
 "swarm": "ثَوْل (بدا فيه الجنون) / اِزْدِحَام",
 "swart": "أَسْمَر البَشَرَة, دَاكِن البَشَرَة (ذو بشرة داكنة بطبيعتها)",
 "swarthiness": "سمرة داكنة (بشرة سمراء داكنة)",
 "swarthy": "أَسْمَر البَشَرَة, دَاكِن البَشَرَة (ذو بشرة داكنة بطبيعتها)",
 "swash": "تلاطم, خضخضة (حركة أو صوت الماء)\nمثال: تلاطم الأمواج على الشاطئ",
 "swashbuckler": "طائش, متهور (شخص متهور مندفع غير مسؤول)",
 "swashbuckling": "مُتَبَخْتِر, مُتَهَوِّر بِمَرَح (مغامر بطريقة استعراضية وبَاهرة) / تبجح, عنترية (سلوك متهور ومتباهٍ بشكل استعراضي)",
 "swastika": "صَلِيب مَعْقُوف",
 "swat": "سْوَات",
 "swat squad": "سوات, فريق التدخل السريع (فرقة من رجال الشرطة تم تدريبهم للتعامل مع المواقف العنيفة والخطيرة)",
 "swat team": "سوات, فريق التدخل السريع (فرقة من رجال الشرطة تم تدريبهم للتعامل مع المواقف العنيفة والخطيرة)",
 "swatch": "سواتش, عينة قماش (قطعة عينة من القماش)",
 "swath": "مَمَرّ (على مَمَرّ العصور: على طولها ومداها؛ على مَمَرّ الفصول: على تواليها وتعاقبها)\nمثال: الباب في نهاية الممر.",
 "swathe": "لفافة (ضمادة مغلفة)",
 "swathing": "قماط, لفافة (أغطية قماشية ملفوفة حول شيء ما (مثل جرح أو طفل رضيع))",
 "swatter": "مضرب الذباب, منشة ذباب (أداة ذات جزء مسطح (من شبكة أو بلاستيك) ومقبض طويل؛ تستخدم لقتل الحشرات)",
 "sway": "تأرجح, تمايل (الترنح بشكل خطير إلى جانب واحد) / سطوة, سيادة (تأثير مسيطر)",
 "swayback": "أَهْدَل الظَّهْر, مُتَقَعِّرُ الظَّهْر (يُعَانِي مِنْ تَقَعُّرٍ غَيْرِ طَبِيعِيٍّ فِي العَمُودِ الفِقَرِيِّ (خَاصَّةً فِي الخَيْلِ))",
 "swaybacked": "أَهْدَل الظَّهْر, مُتَقَعِّرُ الظَّهْر (يُعَانِي مِنْ تَقَعُّرٍ غَيْرِ طَبِيعِيٍّ فِي العَمُودِ الفِقَرِيِّ (خَاصَّةً فِي الخَيْلِ))",
 "swayer": "حاكم, عاهل (شخص يحكم أو يأمر)\nمثال: حاكم الكون",
 "swazi": "سوازي (من أو متعلق أو مميز لسوازيلاند أو شعبها أو لغتهم) / السوازي (لغة بانتو وثيقة الصلة بالزولو، يتحدث بها حوالي ثلاثة ملايين شخص) / سْوازِي (عضو في شعب جنوب شرق أفريقي يعيش في سوازيلاند والمناطق المجاورة)",
 "swazi language": "السوازي (لغة بانتو وثيقة الصلة بالزولو، يتحدث بها حوالي ثلاثة ملايين شخص)",
 "swaziland": "سُوَازِيلَانْدَ",
 "swaziland monetary unit": "وحدة نقدية لسوازيلاند (الوحدة النقدية في سوازيلاند)",
 "swbs": "الجَنُوب الغَرْبِيّ المَائِل لِلجَنُوب, جَنُوب غَرْبِيّ لِجَنُوب (نقطة البوصلة التي تقع جنوب الجنوب الغربي بنقطة واحدة)",
 "swbw": "الجَنُوب الغَرْبِيّ المَائِل لِلغَرْب, جَنُوب غَرْبِيّ لِغَرْب (نقطة البوصلة التي تقع غرب الجنوب الغربي بنقطة واحدة)",
 "swear": "شَتَمَ, سَبَّ",
 "swear word": "بَذَاءَة, شَتِيمَة",
 "swearer": "حالِف (شخص يقسم يمينًا رسميًا) / سبّاب, شتّام (شخص يستخدم الألفاظ النابية)",
 "swearing": "قَسَم, يَمِين (التزام بقول الحقيقة (خاصة في محكمة قانونية)؛ الكذب تحت القسم يعرض الشخص للمحاكمة بتهمة الحنث باليمين) / سبة, شتيمة (تعبير دنس أو فاحش عادة للتعبير عن المفاجأة أو الغضب)\nمثال: تم حذف الشتائم",
 "swearword": "سبة, شتيمة (تعبير دنس أو فاحش عادة للتعبير عن المفاجأة أو الغضب)\nمثال: تم حذف الشتائم",
 "sweat": "عَرَق, عرق (وريد أو شريان، مجرى الدَّم في الجسَد؛ جِنْس؛ سُلَالَة من النّاس يُصنَّفون بناء على التَّاريخ أو الجنسيّة أو التّوزيع الجغرافيّ المشترك) / عَرِقَ, عِرِق (وريد أو شريان، مجرى الدَّم في الجسَد؛ جِنْس؛ سُلَالَة من النّاس يُصنَّفون بناء على التَّاريخ أو الجنسيّة أو التّوزيع الجغرافيّ المشترك)\nمثال: هذا القميص مبلل بالعرق.",
 "sweat bag": "قربة تبريد, كيس تبريد بالتبخير (كيس مسامي (عادة من القماش) يحمل الماء ويبرده عن طريق التبخر)",
 "sweat duct": "قناة عرقية (قناة صغيرة تنقل العرق من الغدة العرقية إلى سطح الجلد)",
 "sweat equity": "مساهمة بالجهد (مصلحة في مبنى يكتسبها المستأجر من خلال المساهمة في تجديده أو صيانته)",
 "sweat gland": "غدة عرقية (أي من الغدد الموجودة في الجلد التي تفرز العرق)",
 "sweat pants": "بنطال رياضي, سويت بانتس (سراويل فضفاضة بأساور مطاطية؛ يرتديها الرياضيون)",
 "sweat room": "ساونا (حمام بخار فنلندي؛ يتم إنتاج البخار عن طريق صب الماء على صخور ساخنة)",
 "sweat sock": "جورب رياضي (جورب يُرتدى للأنشطة الرياضية)",
 "sweat suit": "بدلة تدريب, سويت سوت (رداء يتكون من بنطال رياضي وسترة رياضية)",
 "sweatband": "عصابة العرق (شريط من القماش أو الجلد مخيط داخل تاج القبعة) / عصابة العرق (شريط من مادة يُربط حول الجبهة أو المعصم لامتصاص العرق)",
 "sweatbox": "صندوق تعريق (جهاز يسبب تعرق أوراق التبغ أو الفاكهة أو الجلود) / زنزانة ضيقة (زنزانة صغيرة أو ضيقة)",
 "sweater": "سْوِيتَر",
 "sweater girl": "فتاة السترة (فتاة ذات صدر جذاب ترتدي سترات ضيقة)",
 "sweating": "عَرَق (وريد أو شريان، مجرى الدَّم في الجسَد؛ جِنْس؛ سُلَالَة من النّاس يُصنَّفون بناء على التَّاريخ أو الجنسيّة أو التّوزيع الجغرافيّ المشترك)\nمثال: هذا القميص مبلل بالعرق.",
 "sweating sickness": "مرض التعرق (وباء انتشر في القرنين الخامس عشر والسادس عشر وتميز بالتعرق الغزير والوفيات المرتفعة) / مرض التعرق (مرض يصيب الماشية (خاصة العجول))",
 "sweatpants": "بنطال رياضي, سويت بانتس (سراويل فضفاضة بأساور مطاطية؛ يرتديها الرياضيون)",
 "sweats": "بدلة تدريب, سويت سوت (رداء يتكون من بنطال رياضي وسترة رياضية)",
 "sweatshirt": "سترة قطنية, سويت شيرت (بلوفر قطني محبوك بأكمام طويلة يُرتدى أثناء النشاط الرياضي)",
 "sweatshop": "مشغل استغلالي (مصنع يقوم فيه العمال بالعمل بالقطعة مقابل أجر زهيد ويمنعون من تشكيل نقابات؛ شائع في صناعة الملابس)",
 "sweatsuit": "بدلة تدريب, سويت سوت (رداء يتكون من بنطال رياضي وسترة رياضية)",
 "swede": "سُوِيدِيّ",
 "sweden": "السُّوَيْد (دولة تقع في إسكندنافيا في شمال قارة أوروبا، اسمها الرسمي مملكة السويد وعاصمتها ستوكهولم)\nمثال: أعيش في شمال السويد.",
 "swedish": "سُوَيْدِيَّة",
 "swedish iron": "حديد سويدي (حديد مطاوع عالي النقاء مصنوع في السويد)",
 "swedish krona": "كرونا, كرونا سويدية (وحدة المال الأساسية في السويد)",
 "swedish language": "اللغة السويدية (لغة إسكندنافية وهي اللغة الرسمية للسويد وإحدى اللغتين الرسميتين لفنلندا)",
 "swedish massage": "تدليك سويدي (تدليك مقترن بنظام من التمارين النشطة والسلبية للعضلات والمفاصل)",
 "swedish meatball": "كرات اللحم السويدية (كرات لحم مطهية ببطء في المرق)",
 "swedish mile": "ميل سويدي (وحدة طول سويدية تعادل 10 كم)",
 "swedish monetary unit": "وحدة نقدية سويدية (الوحدة النقدية في السويد)",
 "swedish rye": "خبز الجاودار السويدي (خبز رطب وعطري مخمر بالخميرة مصنوع من دقيق الجاودار والدبس وقشر البرتقال)",
 "swedish rye bread": "خبز الجاودار السويدي (خبز رطب وعطري مخمر بالخميرة مصنوع من دقيق الجاودار والدبس وقشر البرتقال)",
 "swedish turnip": "لفت سويدي (الجذر الأصفر الكبير لنبات اللفت السويدي المستخدم كغذاء) / روتاباغا, لفت سويدي (نبات صليبي بجذر أصفر سميك بصلي صالح للأكل)",
 "swedishness": "الطابع السويدي (حالة أو شرط كون الشيء سويدياً)\nمثال: ما هو الطابع السويدي؟ حسناً، إنه مفهوم واسع جداً، مع رموز اجتماعية تستغرق سنوات لإتقانها",
 "sweep": "مَسَحَ (مَرَّ عليه بكفه وهو يلامسه؛ مَحَا، مرَّ عليه بكفه حتى يُزيله)\nمثال: مسح توم الطاولة.",
 "sweep hand": "عقرب الثواني المركزي (عقرب ثواني مثبت على نفس مركز عقربي الساعة والدقيقة ويقرأ على الدقائق)",
 "sweep oar": "مِجداف طويل (مجداف طويل يستخدم في القوارب المفتوحة)",
 "sweep-second": "عقرب الثواني المركزي (عقرب ثواني مثبت على نفس مركز عقربي الساعة والدقيقة ويقرأ على الدقائق)",
 "sweeper": "كَنَّاس",
 "sweeping": "كنس (فعل التنظيف بالمكنسة) / شَامِل, عَشْوَائِيّ (يَتَجَاهَل الفُرُوقَات وَالتَّمَايُزَات) / شَامِل, وَاسِع النِّطَاق (يشمل مساحة واسعة أو يتحرّك عبرها)",
 "sweepingly": "بشكل شامل, بشكل كاسح (بطريقة شاملة وواسعة النطاق)\nمثال: أدان بشكل شامل جميع سكان البلاد بسبب جرائم الحرب",
 "sweepstakes": "مراهنات اليانصيب, مسابقة جوائز (يانصيب تتكون فيه الجائزة من الأموال التي يدفعها المشاركون)",
 "sweet": "حُلْو (متَّصِف بالحلاوة، وهي ذوق أساسي يُشعر به غالبًا عند تناول الأكلات الغنية بالسكر، ويرتبط بشكل عام باللذة، إلا عندما يتم التفريط به) / حَلْوَى\nمثال: الكعكة حلوة جدا",
 "sweet acacia": "أكاسيا حلوة, سنط عنبري (شجيرة شائكة أو شجرة صغيرة من أمريكا الاستوائية؛ تستخدم زهورها الصفراء العطرة في صناعة العطور)",
 "sweet alison": "أليسم حلو, خرم الإبرة (نبات أوروبي معمر له عناقيد من الزهور البيضاء الصغيرة العطرة عادة؛ يزرع على نطاق واسع في الحدائق)",
 "sweet almond": "لوز, لوز حلو (شجرة نفضية شجيرية صغيرة موطنها آسيا وشمال أفريقيا لها أزهار وردية جميلة ومكسرات صالحة للأكل ذات قيمة عالية محاطة بقشرة خضراء صلبة؛ تزرع في جنوب…)",
 "sweet almond oil": "زيت اللوز (زيت دهني أصفر شاحب يُعصر من اللوز الحلو أو المر)",
 "sweet alyssum": "أليسم حلو, خرم الإبرة (نبات أوروبي معمر له عناقيد من الزهور البيضاء الصغيرة العطرة عادة؛ يزرع على نطاق واسع في الحدائق)",
 "sweet balm": "ترنجان, عشبة الليمون (نعناع معمر كثيف من العالم القديم له أزهار بيضاء أو مصفرة صغيرة وأوراق عطرية بنكهة الليمون؛ هارب من الحدائق في شمال أوروبا وأمريكا الشمالية)",
 "sweet basil": "ريحان (أوراق الريحان الشائع؛ تستخدم طازجة أو مجففة) / حبق, ريحان (نبات حولي أو معمر من آسيا الاستوائية له سنابل من الزهور البيضاء الصغيرة وأوراق عطرية؛ أحد أهم أعشاب الطهي؛ يستخدم في السلطات والأطعمة والصلصات وبعض…)",
 "sweet bay": "غار حلو, ماغنوليا فرجينيا (شجيرة أو شجرة صغيرة ذات زهور بيضاء عطرية صغيرة نوعاً ما؛ وفيرة في جنوب شرق الولايات المتحدة)",
 "sweet bells": "أجراس حلوة (شجيرة نفضية كثيفة من شرق الولايات المتحدة مع عناقيد طويلة من الزهور الوردية)",
 "sweet birch": "بتولا حلوة, بتولا كرزية (بتولا شائعة في شرق الولايات المتحدة لها لحاء بني حار ينتج زيتاً طياراً وخشباً داكناً صلباً يستخدم للأثاث)",
 "sweet buckeye": "بكية حلوة, كستناء الحصان الحلوة (شجرة بكية طويلة تزرع غالباً في وسط الولايات المتحدة)",
 "sweet calabash": "قرع حلو (فاكهة عاطفة بحجم التفاحة في جزر الهند الغربية) / قرع حلو (زهرة العاطفة من جزر الهند الغربية بثمار صالحة للأكل بحجم التفاحة)",
 "sweet calamus": "عود الوج, قصب الذريرة (نبات مستنقعات معمر ذو أوراق تشبه السيف وجذور عطرية)",
 "sweet cassava": "كسافا حلوة (نبات أمريكي جنوبي ذو جذور تستخدم كخضروات وأعشاب تستخدم كعلف للماشية)",
 "sweet cherry": "كرز حلو (أي من عدة فواكه لأشجار الكرز المزروعة التي لها لحم حلو) / كرز حلو (شجرة أوراسية كبيرة تنتج فاكهة مرة داكنة صغيرة في البرية ولكن فاكهة حلوة صالحة للأكل عند الزراعة)",
 "sweet cherry liqueur": "ليكير الكرز الحلو (ليكير بنكهة الكرز الحلو)",
 "sweet chestnut": "أبو فروة, كستناء أوروبية (برية أو مزروعة في جميع أنحاء جنوب أوروبا وشمال غرب أفريقيا وجنوب غرب آسيا)",
 "sweet cicely": "سيسلي حلو (أوراق سرخسية طازجة وبذور خضراء تستخدم للزينة في السلطات والخضروات الباردة) / صمغ المُر, مُر (راتنج عطري يُحرق كبخور ويُستخدم في العطور) / سيسلي حلوة, مرّيس (عشب أوروبي بأوراق سرخسية ناعمة وأزهار بيضاء)",
 "sweet cider": "عصير تفاح (عصير تفاح غير مخمر)",
 "sweet clover": "حَنْدَقُوق",
 "sweet coltsfoot": "حشيشة السعال العطرة, رقيب الشمس الشتوي (عشب أوروبي ذو أزهار بيضاء وردية برائحة الفانيليا) / حشيشة السعال الحلوة (عشب أمريكي ذو رائحة حلوة)",
 "sweet corn": "ذرة حلوة (ذرة يمكن أن تؤكل كخضار وهي لا تزال صغيرة وطرية) / ذرة حلوة (نبات ذرة تم تطويره ليكون له أكواز صغيرة حلوة ومناسبة للأكل)",
 "sweet corn plant": "ذرة حلوة (نبات ذرة تم تطويره ليكون له أكواز صغيرة حلوة ومناسبة للأكل)",
 "sweet cup": "كوب حلو, ليمون مائي (الفاكهة الصفراء الصالحة للأكل لصريمة الجدي الجاميكية)",
 "sweet dreams": "لَيْلَة سَعِيدَة وَأَحْلَام لَذِيذَة (واحِدَة اللَيْل، وهو الزمن في اليوم من مَغْرِب الشمس حتى طلوع الفَجْر. قيل الليل والليلة واحد وقيل الليل ضد النهار والليلة ضد اليوم وقيل الليلة مفرد…؛ أحيانا تستخدم بمعنى اليَوْم كما يستخدم اليوم بمعنى النَهَار)\nمثال: كانت ليلة رائعة.",
 "sweet elder": "بيلسان أمريكي, خمان كندي (بيلسان شائع في وسط وشرق أمريكا الشمالية يحمل توتاً أرجوانياً أسود؛ تستخدم الفاكهة في النبيذ والمربيات)",
 "sweet false chamomile": "بابونج ألماني, بابونج بري (عشب حولي أوراسي يشبه البابونج في العطر والاستخدامات الطبية وإن كان طعمه أكثر مرارة وتأثيره يعتبر أقل جودة)",
 "sweet fanny adams": "لا شيء على الإطلاق (القليل أو لا شيء على الإطلاق)\nمثال: طلبت علاوة ولم يعطوني شيئاً يذكر",
 "sweet fern": "سرخس حلو (شجيرة نفضية من شرق أمريكا الشمالية ذات أوراق تشبه السرخس معطرة برائحة حلوة وأزهار بيضاء صغيرة جداً) / بوليبودي شائع, سرخس الجدار (سرخس صخري أو أرضي يشكل حصيرة بجذامير زاحفة وسعف ريشي كبير يوجد في جميع أنحاء أمريكا الشمالية وأوروبا وأفريقيا وشرق آسيا)",
 "sweet flag": "وَجّ, ذَرِيرَة",
 "sweet four o'clock": "شب الليل الحلو, مارافيلا (زهرة برية ورقية ذات زهور بوقية الشكل بيضاء أو وردية شاحبة عطرة ونحيلة؛ جنوب غرب الولايات المتحدة وشمال المكسيك)",
 "sweet gale": "آس المستنقعات, شمعية عاصفة (شجيرة مستنقعات من المنطقة المعتدلة الشمالية ذات أوراق عطرية مرة المذاق)",
 "sweet goldenrod": "شاي الجبل الأزرق, عصا الذهب الحلوة (عصا ذهب من شرق أمريكا ذات أوراق عطرية يصنع منها شاي طبي)",
 "sweet granadilla": "غرانديلا حلوة (تعتبر الأفضل للفاكهة)",
 "sweet grass": "عشبة المن, عشبة حلوة (أي من عدة أعشاب محبة للرطوبة من جنس جليسيريا ذات نكهة أو رائحة حلوة)",
 "sweet gum": "عَنْبَر دَمَّاع / مَيْعَة سَائِلَة / لِيْكِيْدَنْبَار",
 "sweet gum tree": "شجرة الصمغ الحلو, ليكويدامبر (نبات قائم على سَاق صلبة؛ مخطط له تفرعات)\nمثال: أنا تحت الشجرة.",
 "sweet jazz": "سويت جاز (جاز يؤدى بإيقاع منتظم، وسرعة معتدلة، وافتقار للارتجال، مع التركيز على النغمة الدافئة واللحن المحدد بوضوح)",
 "sweet lemon": "ليم حلو, ليمون حلو (شجرة ليمون لها فاكهة بلب حلو نوعاً ما غير مستساغ)",
 "sweet lime": "ليم حلو, ليمون حلو (شجرة ليمون لها فاكهة بلب حلو نوعاً ما غير مستساغ)",
 "sweet marjoram": "مردقوش, مردقوش حلو (نبات أوروبي عطري موطنه البحر الأبيض المتوسط وتركيا؛ غير واسع الانتشار في أوروبا)",
 "sweet melon": "شمام (ثمرة كرمة الشمام؛ أي من عدة شمامات حلوة مرتبطة بالخيار) / بطيخ أصفر, شمام (أي من عدة أصناف من الكروم ثمارها ذات قشرة شبكية ولب صالح للأكل ورائحة مسكية)",
 "sweet melon vine": "بطيخ أصفر, شمام (أي من عدة أصناف من الكروم ثمارها ذات قشرة شبكية ولب صالح للأكل ورائحة مسكية)",
 "sweet nothings": "كلمات معسولة, همسات الحب (تعبيرات عاطفية غير مهمة المضمون)\nمثال: همس بكلمات معسولة في أذنها",
 "sweet oil": "زيت حلو (زيت نباتي معتدل عند استخدامه كغذاء؛ خاصة زيت الزيتون أو زيت السلجم الصالح للأكل)",
 "sweet orange": "برتقال حلو (برتقال ذو لب عصيري حلو؛ غالباً ما يكون له قشرة رقيقة) / برتقال حلو (ربما موطنه جنوب الصين؛ يزرع على نطاق واسع كمصدر لبرتقال المائدة والعصير)",
 "sweet orange tree": "برتقال حلو (ربما موطنه جنوب الصين؛ يزرع على نطاق واسع كمصدر لبرتقال المائدة والعصير)",
 "sweet pea": "بَازِلَّاء الزُهُور",
 "sweet pepper": "فلفل حلو, فلفل رومي (فلفل كبير معتدل مقرمش سميك الجدار عادة ما يكون جرسي الشكل أو مستطيلاً إلى حد ما؛ يستخدم عادة في السلطات) / بابريكا, فلفل حلو (نبات يحمل ثماراً كبيرة معتدلة سميكة الجدران عادة ما تكون على شكل جرس؛ فلفل السلطة الرئيسي)",
 "sweet pepper plant": "بابريكا, فلفل حلو (نبات يحمل ثماراً كبيرة معتدلة سميكة الجدران عادة ما تكون على شكل جرس؛ فلفل السلطة الرئيسي)",
 "sweet pepperbush": "ألدر أبيض, شجيرة الفلفل الحلوة (شجيرة من شرق وجنوب الولايات المتحدة الساحلية ذات عناقيد جميلة من الزهور البيضاء المعطرة برائحة التوابل)",
 "sweet pickle": "مخلل حلو (مخلل معالج في محلول ملحي ومحفوظ في السكر والخل)",
 "sweet potato": "بَطَاطَا حُلْوَة",
 "sweet potato vine": "بطاطا حلوة, كرمة البطاطا الحلوة (كرمة استوائية شاملة تزرع على نطاق واسع في عدة أصناف لجذرها الدرني الحلو الكبير ذي اللب البرتقالي)",
 "sweet reseda": "خزامى, ريزيدا عطرة (نبات حولي خشبي متوسطي يزرع على نطاق واسع لعناقيده الطرفية الكثيفة التي تشبه السنابل من الزهور البيضاء المخضرة أو الصفراء ذات الرائحة الحارة القوية)",
 "sweet rocket": "منثور دمشقي, هيسبيرس (عشب مزروع منذ فترة طويلة له زهور تكون رائحتها أكثر وضوحاً في المساء؛ تم توطينه في جميع أنحاء أوروبا إلى سيبيريا وإلى أمريكا الشمالية)",
 "sweet roll": "لفافة حلوة, لفافة قهوة (أي من العديد من اللفائف الحلوة المخمرة بالخميرة مع أو بدون الزبيب أو المكسرات أو التوابل أو طبقة سكرية)",
 "sweet sand verbena": "كرة الثلج, لويسية رملية عطرة (نبات ذو رؤوس من الزهور البيضاء العطرة قمعية الشكل؛ ينمو في المناطق الرملية القاحلة) / لويسية رملية عطرة",
 "sweet scabious": "جرب الحلو, زهرة وسادة الدبابيس (نبات حولي من العالم القديم له رؤوس زهور عطرة أرجوانية إلى قرمزية عميقة؛ متوطن في الولايات المتحدة)",
 "sweet shrub": "بهار كارولينا, شجيرة الفراولة (شجيرة قوية من جنوب شرق الولايات المتحدة لها خشب برائحة القرنفل وزهور بنية حمراء عطرة)",
 "sweet sorghum": "سورغم حلو, سورغو (أي من عدة أنواع من السورغم تزرع كمصدر للشراب)",
 "sweet sultan": "سلطان جميل, عنبر كشميري (نبات آسيوي يُزرع على نطاق واسع لزهوره الوردية ذات الرائحة الحلوة؛ يوضع أحياناً في جنس القنطريون) / سلطان جميل, قنطريون إمبراطوري (نبات معمر في جبال إيران والعراق؛ يُزرع لزهوره الوردية العطرة) / شوك مبارك, قنطريون مبارك (نبات حولي من البحر الأبيض المتوسط إلى البرتغال ذو سيقان مشعرة وأوراق مسننة شائكة بدقة ورؤوس كبيرة من الزهور الصفراء)",
 "sweet talk": "كلام معسول, ملاطفة (تملق مصمم لكسب الرضا)",
 "sweet talker": "ساحر, متملق (شخص ذو أسلوب واثق ومتملق)",
 "sweet tooth": "ولع بالحلويات (شهية قوية للطعام الحلو)",
 "sweet unicorn plant": "نبات وحيد القرن الحلو (مصدر للفعل نَبَتَ؛ اسم جنس شامل لكل ما تنبته الأرض من شجر أو بقل أو عشب أو غيره)\nمثال: هذا النبات مهدد بالانقراض.",
 "sweet vermouth": "فيرموث إيطالي, فيرموث حلو (نوع كهرماني داكن حلو)",
 "sweet vetch": "بيقية حلوة, هيديساروم شمالي (نبات معمر من غرب الولايات المتحدة له عناقيد من الزهور الوردية إلى الأرجوانية تليها قرون مسطحة تنفصل إلى مفاصل دائرية تقريباً)",
 "sweet violet": "بنفسج الحديقة, بنفسج عطري (بنفسج أوروبي يتميز عادة بزهور أرجوانية إلى بيضاء؛ متوطن على نطاق واسع)",
 "sweet wattle": "أكاسيا حلوة, سنط عنبري (شجيرة شائكة أو شجرة صغيرة من أمريكا الاستوائية؛ تستخدم زهورها الصفراء العطرة في صناعة العطور)",
 "sweet white violet": "بنفسج أبيض حلو (بنفسج قصير الساق من شرق أمريكا الشمالية له زهور بيضاء عطرة بعروق أرجوانية)",
 "sweet william": "قرنفل الشاعر, قرنفل ملتحي (قرنفل أوراسي يزرع على نطاق واسع لعناقيده الكثيفة مسطحة القمة من الزهور متنوعة الألوان)",
 "sweet woodruff": "غديرة, وودروف حلو (أوراق خضراء داكنة عطرة تستخدم لتنكيه نبيذ مايو) / جويسئة عطرة, نبات الخشبة",
 "sweet wormwood": "شيح حلو, شيح حولي (شيح من جنوب شرق أوروبا إلى إيران)",
 "sweet-birch oil": "زيت القضبان, ساليسيلات الميثيل (إستر سائل له رائحة قوية من وينترجرين؛ يطبق خارجياً لآلام العضلات والمفاصل الخفيفة)",
 "sweet-breathed": "طَيِّب النَّفَس, عَطِر الأَنْفَاس (ذُو نَفَسٍ مَوْصُوف بِالطِّيب والعُذُوبَة)",
 "sweet-faced": "عَذْب المُحَيَّا (ذو وجه لطيف أو يدل على طبع حلو)",
 "sweet-flavored": "حُلْو, مُحَلًّى (أُضيف إليه مادة تحلية)",
 "sweet-potato ring rot": "عفن حلقي للبطاطا الحلوة (مرض يصيب البطاطا الحلوة حيث تحاط الجذور بحلقات من العفن الجاف)",
 "sweet-potato whitefly": "ذبابة البطاطا الحلوة البيضاء (نوع من الذباب الأبيض)",
 "sweet-scented": "عَبِق, فَوَّاح (ذُو عُطْرٍ طَبِيعِيٍّ)",
 "sweet-scented geranium": "غرنوقي الورد, لقلقي نفاذ (أي من عدة نباتات غرنوقي من جنوب إفريقيا لها أوراق عطرية ثلاثية إلى خماسية الفصوص وزهور وردية)",
 "sweet-smelling": "عَبِق, فَوَّاح (ذُو عُطْرٍ طَبِيعِيٍّ)",
 "sweetbread": "حلويات اللحم, لحم الغدد (غدد حيوانية صالحة للأكل (مثل البنكرياس والغدة التيموسية))",
 "sweetbreads": "حلويات اللحم, لحم الغدد (غدد حيوانية صالحة للأكل (مثل البنكرياس والغدة التيموسية))",
 "sweetbriar": "نسرين, ورد ياقوتي (ورد أوراسي ذو سيقان شائكة وأوراق عطرة وزهور وردية زاهية تليها ثمار قرمزية)",
 "sweetbrier": "نسرين, ورد ياقوتي (ورد أوراسي ذو سيقان شائكة وأوراق عطرة وزهور وردية زاهية تليها ثمار قرمزية)",
 "sweetened": "حُلْو, مُحَلًّى (أُضيف إليه مادة تحلية)",
 "sweetener": "مُحَلِّيّ",
 "sweetening": "تحلية (فعل إضافة مُحلي إلى الطعام) / تحسين, تعزيز (تحسين يجعل الشيء أكثر قبولاً) / مُحلي (شيء يضاف للأطعمة لجعل مذاقها أكثر حلاوة)",
 "sweetheart": "حَبِيب, حَبِيبَة",
 "sweetie": "حبيب, عزيز (شخص محبوب؛ تستخدم ككلمات تودد) / حبيب, معشوق (شخص محبوب من قبل شخص آخر)",
 "sweetish": "حُلْوِيّ, مَائِل لِلْحَلَاوَة (حلو إلى حد ما)",
 "sweetleaf": "ورقة حلوة (شجرة خشب أصفر صغيرة من جنوب الولايات المتحدة لها زهور بيضاء عطرة صغيرة؛ الأوراق واللحاء ينتجان صبغة صفراء)",
 "sweetly": "برقة, بعذوبة (بطريقة حنونة أو محبة)\nمثال: تؤدي سوزان هيوار دور الزوجة بحدة وعذوبة",
 "sweetmeat": "أطايب حلوة, حلوى (طعام شهي محلى (مثل المحفوظات أو المعجنات))",
 "sweetness": "حَلَاوَةٌ",
 "sweetness and light": "لطف بالغ, وداعة وصفاء (عقلانية وديعة ولطيفة)\nمثال: عندما علم من أنا أصبح كله وداعة وصفاء",
 "sweetpea": "بازلاء عطرية, بسلة الزهور (نبات حدائق متسلق له أزهار عطرة بألوان الباستيل)",
 "sweets": "حَلْوَيَات",
 "sweetshop": "صَنَاعَةُ الْحَلْوَيَات (إيجاد الشيء وخَلْقُه؛ (استخدام حديث) قطاع اقتصادي)\nمثال: هذا البلد مدعوم بالصناعة.",
 "sweetsop": "تفاح السكر, قشطة سكرية (فاكهة استوائية لبية حلوة ذات قشرة حرشفية سميكة وبذور سوداء لامعة) / سكر التفاح, قشطة حرشفية (شجرة استوائية أمريكية تحمل فاكهة لبية حلوة بقشرة حرشفية سميكة وبذور سوداء لامعة)",
 "sweetsop tree": "سكر التفاح, قشطة حرشفية (شجرة استوائية أمريكية تحمل فاكهة لبية حلوة بقشرة حرشفية سميكة وبذور سوداء لامعة)",
 "sweetwood bark": "قِشْرَةُ العَنْبَر, كَسْكَارِيلا (لحاء عطري للكسكاريلا؛ يستخدم كمقوٍ ولصنع البخور)",
 "swell": "اِنْتَفَخَ, وَرِمَ",
 "swelled": "مَزْهُوّ بِنَفْسِه, مُتَعَاظِم (يشعر بأهمية ذاتية مبالَغ فيها)",
 "swelled head": "أنانية, حب الذات (رأي مبالغ فيه حول أهمية الذات)",
 "swellhead": "أناني, شخص متمركز حول ذاته (شخص مغرور ومهتم بنفسه فقط)",
 "swelling": "انتفاخ (الزيادة في حجم بعض المواد عند تسخينها (غالباً ما تكون مصحوبة بإطلاق الماء)) / انتفاخ, بروز (شيء ينتفخ للخارج أو يبرز عن محيطه) / انتفاخ, تضخم (بروز غير طبيعي أو تضخم موضعي)\nمثال: أحدث المسدس في جيبه انتفاخاً واضحاً",
 "sweltering": "شَدِيد الحَرّ, مُعَرِّق (شديد الحرارة والرطوبة بشكل مفرط يُسبِّب التعرُّق والإعياء)",
 "sweltry": "شَدِيد الحَرّ, مُعَرِّق (شديد الحرارة والرطوبة بشكل مفرط يُسبِّب التعرُّق والإعياء)",
 "swept": "مرتد, منحني للخلف (يمتلك انحناء للخلف)\nمثال: أجنحة الطائرة الملساء المرتدة للخلف",
 "sweptback": "مُمَشَّط إِلَى الخَلْف (يُستخدم للشعر المسحوب إلى الوراء) / مُرْتَدّ لِلْخَلْف ((خاصة لأجنحة الطائرات) مائل للخلف من نقطة التثبيت)",
 "sweptwing": "ذُو أَجْنِحَة مُرْتَدَّة ((للطائرات) ذو أجنحة مائلة للخلف)",
 "swertia perennis": "جنطيانا المستنقعات, سويرتيا (نبات معمر في الأماكن الرطبة في جبال أوراسيا وأمريكا الشمالية له أزهار زرقاء أو بنفسجية باهتة اللون)",
 "swertia speciosa": "جنطيانا خضراء (عشب طويل له عثاكيل من الزهور البيضاء المشوبة بالخضرة؛ شمال غرب الولايات المتحدة؛ يوضع أحياناً في جنس سويرتيا)",
 "swerve": "انحراف مفاجئ, زيغ (عملية الانحراف جانباً فجأة) / انحراف, زيغان (انحراف غير منتظم عن المسار المقصود)",
 "swerving": "انحراف مفاجئ, زيغ (عملية الانحراف جانباً فجأة)",
 "swietinia macrophylla": "ماهوجني كبير الأوراق, ماهوجني هندوراس (شجرة ماهوجني مهمة في أمريكا الوسطى)",
 "swietinia mahogani": "ماهوجني حقيقي, ماهوجني كوبي (شجرة الماهوجني في جزر الهند الغربية)",
 "swift": "خُطَّاف",
 "swift-footed": "خَفِيفُ القَدَم, سَرِيعُ الخُطَى (ذُو أَقْدَامٍ سَرِيعَةِ الحَرَكَةِ)",
 "swiftie": "سْوِيفْتِي (معجب بالمغنية تايلور سويفت)",
 "swiftlet": "سمامة الكهوف (سمامة من شرق آسيا؛ تنتج عش الطائر الصالح للأكل)",
 "swiftly": "بخفة, بسرعة (بطريقة سريعة)\nمثال: تحركت بسرعة",
 "swiftness": "سرعة (معدل (عادة سريع) يحدث به شيء ما)\nمثال: تقدم المشروع بسرعة مرضية",
 "swig": "تجرع, عب (بلعة كبيرة وسريعة)\nمثال: أنهاه بجرعة واحدة",
 "swill": "حساء الخنازير, غسالة (علف رطب (خاصة للخنازير) يتكون غالباً من فضلات المطبخ ممزوجة بالماء أو الحليب منزوع الدسم)",
 "swilling": "جرع, عب (شرب ملء الفم بسرعة كبيرة)",
 "swim": "سَبَحَ (الشيءَ: غطس وتصرف به؛ الأمر :استكشفه، وبحث فيه بعمق) / سَبْحَة, سِبَاحَة\nمثال: سبح مع الدلافين.",
 "swim bladder": "نَفَّاخَة الْعَوْم, مَثَانَة الْعَوْم",
 "swim meet": "بطولة سباحة, ملتقى سباحة (مسابقة سباحة بين فريقين أو أكثر)",
 "swimmer": "سَبَّاح, عَوَّام",
 "swimmer's itch": "التهاب الجلد المنشق, حكة السباحين (تفاعل تحسسي لغزو الجلد المتكرر بواسطة مذنبات المنشقات (طفيليات))",
 "swimmeret": "رجل عائمة, قدم سباحة (واحدة من الزوائد البطنية المزدوجة لبعض القشريات المائية التي تعمل بشكل أساسي لحمل البيض عند الإناث وتتكيف عادة للسباحة)",
 "swimming": "سِبَاحَة",
 "swimming bath": "حمام سباحة, مسبح (حوض يوفر منشأة للسباحة)",
 "swimming cap": "قبعة سباحة (قبعة محكمة القياس تبقي الشعر جافاً أثناء السباحة)",
 "swimming costume": "مايوه, ملابس سباحة (رداء ضيق يلبس للسباحة)",
 "swimming crab": "سرطان سابح (سرطان بحري بعض أرجله مفلطحة ومزينة بأهداب للسباحة)",
 "swimming event": "سباق سباحة, فعالية سباحة (مسابقة رياضية تتضمن السباحة)",
 "swimming hole": "حفرة سباحة (جسم مائي صغير (عادة في جدول) عميق بما يكفي لاستخدامه للسباحة)",
 "swimming kick": "ركلة سباحة (حركة الساقين في السباحة)",
 "swimming meet": "بطولة سباحة, ملتقى سباحة (مسابقة سباحة بين فريقين أو أكثر)",
 "swimming pool": "مَسْبَح, حَمَّام سِبَاحَة",
 "swimming stroke": "سباحة, طريقة سباحة (طريقة لتحريك الذراعين والساقين للدفع ضد الماء وتحريك السباح للأمام)",
 "swimming trunks": "مايوه رِجالي",
 "swimmingly": "بسلاسة (بدون مشاكل أو صعوبات)\nمثال: نفذ الخطط بسرعة وسلاسة",
 "swimsuit": "بَدْلَةُ الْحَمَّامِ, لِبَاسُ السِّبَاحَةِ (لباس افرنجي حديث للرجال يتكون من بَنْطَلَوْن وجَاكَيْت وقد يكون معه صُدَيْرِيّ؛ في فُسْتَان مخصص للمناسبات، خاصة ما يكون منه طويل ومزكش)\nمثال: ارتدى سامي بدلة للشرطة.",
 "swimwear": "مايوه, ملابس سباحة (رداء ضيق يلبس للسباحة)",
 "swindle": "غَشَّ, جَدَعَ",
 "swindler": "مُحْتَال",
 "swine": "خنزير (حيوانات قارتة ممتلئة الجسم قصيرة الأرجل)",
 "swine flu": "إِنْفْلُوَنْزَا خَنَازِير",
 "swine influenza": "إنفلونزا الخنازير (مرض تنفسي حاد وشديد العدوى يصيب الخنازير يسببه فيروس أورثوميكسو يُعتقد أنه نفس الفيروس الذي تسبب في جائحة الإنفلونزا عام 1918)",
 "swineherd": "راعي خنازير (راعي للخنازير)",
 "swing": "تَأَرْجَحَ / أُرْجُوحَة, مُرْجِيحَة",
 "swing door": "باب متأرجح (باب يتأرجح على مفصل مزدوج؛ يفتح في أي من الاتجاهين)",
 "swing music": "سوينغ, موسيقى السوينغ (نمط من الجاز تعزفه فرق كبيرة اشتهر في الثلاثينيات؛ إيقاعات متدفقة ولكن أقل تعقيداً من أنماط الجاز اللاحقة)",
 "swing shift": "وردية مسائية (وردية العمل خلال المساء (مثل من 4 مساءً إلى منتصف الليل))",
 "swing state": "وِلَايَة مُتَأَرْجِحَة (منطقة إدارية لها استقلالها الإداري والمعنوي؛ ويختلف المعنى من بلد لآخر كما يختلف من فترة زمنية لأخرى)\nمثال: كان زيري من ولاية أخرى.",
 "swing voter": "ناخب متأرجح (ناخب ليس لديه ولاء لأي حزب سياسي ويمكن لقراراته غير المتوقعة أن ترجح كفة الانتخابات)",
 "swingeing": "بَالِغ الشِّدَّة, قَاسٍ (شديد؛ سيء بصورة عقابية)",
 "swinger": "منحل جنسياً (شخص يمارس الجنس بحرية وبشكل عشوائي) / ضارب, مُلوح (شخص يلوح بأدوات رياضية (مثل المضرب))",
 "swinging": "تأرجح (تغيير الموقع عن طريق التحرك ذهاباً وإياباً) / خَفِيفُ الإِيقَاع, مَرِح (يتميّز بإيقاع مرح ومتمايل)",
 "swinging chad": "قصاصة ثقب متأرجحة (قصاصة ثقب لم تزال بالكامل ولا تزال متصلة بزاويتين)",
 "swinging door": "باب متأرجح (باب يتأرجح على مفصل مزدوج؛ يفتح في أي من الاتجاهين)",
 "swinging post": "عمود التعليق, عمود المفصلات (عمود البوابة الذي تعلق عليه البوابة)",
 "swingletree": "عارضة الجر, ميزان الجر (عارضة مستعرضة تُربط بزمام حصان الجر وبالمركبة أو الأداة التي يسحبها الحصان)",
 "swingy": "خَفِيفُ الإِيقَاع, مَرِح (يتميّز بإيقاع مرح ومتمايل)",
 "swinish": "بَهِيمِيّ, خِنْزِيرِيّ (يُشبِه الخنازير في النَّهَم والجشع) / غَلِيظٌ, فَظٌّ (سيئ السلوك وخشن ومحتقر في التصرف أو المظهر)",
 "swinishness": "خنازيرية, دناءة (صفة تشبه الخنازير؛ الشراهة والغلظة والانحطاط)\nمثال: أصر على أن الفلاح الروسي خنزير ويحب الخنازيرية، ولإخراجه من خنازيريته لا بد من وجود سلطة",
 "swipe": "ضربة قوية عشوائية (ضربة كاسحة أو عنيفة)",
 "swirl": "دُوَّامَة",
 "swish": "رَاقٍ, فَاخِر (أَنِيق وَعَصْرِيّ وَمِنَ الطَّبَقَة الرَّفِيعَة) / حفيف, خشخشة (صوت احتكاك أو حفيف)",
 "swishy": "حَفِيفِيّ (يشبه صوت الحفيف المستمرّ أو الهمس الناعم)",
 "swiss": "سْوِيسْرِيّ, سُوِيسْرِيّ",
 "swiss army knife": "سِكِّين سْوِيسِرِيّ (أَدَاةٌ حَادَةٌ تُسْتَخْدَمُ فِي تَقْطِيعِ مُخْتَلَفِ أَصْنَافِ الطَّعَامِ كَاللَّحْمِ وَالْخُضَرِ، وَلِذَبْحِ الْحَيَوَانَاتِ؛ أَدَاةٌ حَادَةٌ تُصْنَعُ غَالِباً مِنَ الْمَعْدِنِ، لِلدِّفَاعِ عَنِ النَّفْسِ وَاسْتِخْدَامِهَا أَثْنَاءَ الْقِتَالِ)\nمثال: أحتاج الى سكين.",
 "swiss canton": "كانتون سويسري (أحد كانتونات سويسرا)",
 "swiss chard": "سلق, سلق سويسري (سيقان بيضاء طويلة عصارية ذات أوراق خضراء كبيرة) / سلق, سلق سويسري (شمندر يفتقر إلى الجذر المتضخم؛ يزرع كخضروات لأوراقه وسيقانه الصالحة للأكل)",
 "swiss cheese": "جبنة سويسرية",
 "swiss confederation": "الاِتِّحَاد السُّوِيسْرِيّ, الاِتِّحَاد السّْوِيسْرِيّ",
 "swiss franc": "فْرَنْك سْوِيسِرِيّ",
 "swiss mountain pine": "صنوبر جبلي سويسري, صنوبر موغو (صنوبر شجيري منخفض من وسط أوروبا بإبر خضراء زاهية قصيرة في حزم من اثنتين)",
 "swiss people": "السويسريون (السكان الأصليون أو سكان سويسرا)",
 "swiss pine": "صنوبر حجري سويسري, صنوبر سويسري (صنوبر أوروبي كبير خماسي الإبر؛ ينتج مكسرات سيمبرا وإفرازات راتنجية)",
 "swiss roll": "سويسرول",
 "swiss steak": "ستيك سويسري (ستيك مطهو ببطء في خليط الطماطم والبصل)",
 "swiss stone pine": "صنوبر حجري سويسري, صنوبر سويسري (صنوبر أوروبي كبير خماسي الإبر؛ ينتج مكسرات سيمبرا وإفرازات راتنجية)",
 "switch": "مِقْلَاد",
 "switch cane": "قصب صغير (قصب صغير في المناطق المائية أو الرطبة في جنوب الولايات المتحدة)",
 "switch engine": "محرك تحويل (قاطرة لتبديل القاطرات والعربات في ساحة السكك الحديدية)",
 "switch grass": "ثمام عصوي, عشب التبديل (عشب من غرب أمريكا يستخدم للتبن)",
 "switch-hitter": "ضارب مزدوج (لاعب بيسبول يستطيع الضرب بالمضرب باستخدام اليد اليمنى أو اليسرى) / مزدوج (مصطلح عامي لشخص مزدوج الميول الجنسية)",
 "switch-ivy": "غار الكلب (شجيرة دائمة الخضرة سريعة النمو من جنوب شرق الولايات المتحدة ذات فروع متشابكة مقوسة وعناقيد من الزهور البيضاء)",
 "switchblade": "سكين كبس, مِطواة زنبركية (سكين جيب بشفرة تفتح بالزنبرك عند الضغط على زر)",
 "switchblade knife": "سكين كبس, مِطواة زنبركية (سكين جيب بشفرة تفتح بالزنبرك عند الضغط على زر)",
 "switchboard": "لوحة مفاتيح, مقسم (مركز هاتف حيث يتم إكمال الدوائر بأسلاك التوصيل)",
 "switchboard operator": "عامل هاتف, مأمور مقسم (شخص يساعد المتصلين في الوصول إلى الشخص الذي يتصلون به)",
 "switcher": "جلاد, ضارب بالسوط (شخص ينفذ العقوبة باستخدام قضيب أو سوط)",
 "switcheroo": "تبديل مفاجئ (تبديل مفاجئ غير متوقع)",
 "switching": "تبديل, تحول (عملية تغيير شيء أو منصب بآخر)\nمثال: تحوله بشأن الإجهاض كلفه الانتخابات",
 "switchman": "عامل التحويلة (رجل يقوم بتشغيل محولات (تحويلات) السكك الحديدية)",
 "swither": "غمة, قلق (هياج ناتج عن قلق نشط)\nمثال: لا تقع في الهم",
 "switzerland": "سُوِيسْرَا (دولة في جنوب أوروبا؛ اسمها الرسمي الاتحاد السويسري، ولا عاصمة قانونية لها)\nمثال: سويسرا بلد جميل.",
 "swivel": "وصلة دوارة (قارنة (كما في سلسلة) لها طرف يدور على مسمار برأس)",
 "swivel chair": "كرسي دوار (كرسي يدور على قاعدته)",
 "swivel pin": "كينغ بين, مسمار المحور الرئيسي (مسمار يوفر مفصل توجيه في المركبة)",
 "swivet": "اضطراب, نوبة ذعر (ذعر أو اضطراب شديد)\nمثال: أدخلها ذلك في حالة ذعر",
 "swiz": "خديعة (مصطلح عامي بريطاني للنصب)",
 "swizzle": "سويزل (أي من المشروبات المخلوطة الطويلة الرغوية المتنوعة المصنوعة عادة من الرم وعصير الليمون والسكر المخفوق مع الثلج)",
 "swizzle stick": "عود تحريك المشروبات (عصا صغيرة تستخدم لتحريك المشروبات المختلطة)",
 "swob": "ممسحة (أداة تنظيف تتكون من مادة ماصة مثبتة بمقبض؛ لتنظيف الأرضيات)",
 "swole": "مَفْتُولُ العَضَلَاتِ ((غير رسمي) شَدِيدُ العَضَلَاتِ بِشَكْلٍ بَارِزٍ)",
 "swollen": "مُنْتَفِخ, مُتَوَرِّم",
 "swollen-headed": "مَغْرُور, مُعْجَب بِنَفْسِه (يتّسم بكبرياء زائف؛ لديه شعور مبالَغ فيه بأهمية الذات)",
 "swoon": "إِغْمَاء",
 "swooning": "مُغْمًى عَلَيْه تَقْرِيبًا, يَكَاد يُغْشَى عَلَيْه (ضعيف ومعرَّض لفقدان الوعي)",
 "swoop": "انقضاض (هبوط سريع عبر الهواء) / انقضاض (غارة سريعة جداً) / انزلاق ((موسيقى) انزلاق سريع صعوداً أو هبوطاً في السلم الموسيقي)\nمثال: كان عازف الكمان متساهلاً في انزلاقاته النغمية",
 "swoosh": "اندفاع, هفير (الضجيج الناتج عن الاندفاع المفاجئ لسائل (غاز أو سائل))",
 "swop": "مبادلة, مقايضة (تبادل متكافئ)\nمثال: لم يكن لدينا مال لذا اضطررنا للعيش عن طريق المقايضة",
 "sword": "سَيْف, حُسَام (مصدر للفعل سَافَ؛ سِلاح ذو حَدّ واحد طويل يعتبر من الأسْلِحَة البيضاء لأنها مصنوعة من حَدِيد أبيض حاد. كان أهم أنواع الأسلحة قبل اخْتِرَاع الأسلحة النَارِيَّة) / سَيَّافٌ\nمثال: القلم أقوى من السيف.",
 "sword bean": "فاصوليا سيفية (نبات استوائي ملتف من العالم القديم يحمل قروناً طويلة عادة مع حبوب حمراء أو بنية؛ يزرع منذ فترة طويلة في الشرق للغذاء)",
 "sword cane": "عصا سيف (عصا تخفي سيفاً أو خنجراً)",
 "sword dance": "رقصة السيف (أي من الرقصات المختلفة التي يؤديها رجال يخطون برشاقة فوق السيوف أو يلوحون بها في الهواء)",
 "sword dancing": "رقصة السيف (أي من الرقصات المختلفة التي يؤديها رجال يخطون برشاقة فوق السيوف أو يلوحون بها في الهواء)",
 "sword fern": "سرخس السيف (أي من عدة سراخس استوائية لها سعف يشبه السيف تقريباً بما في ذلك واحد تطور منه سرخس بوسطن)",
 "sword grass": "عشب سيفي (أي من أعشاب أو نباتات السعد المختلفة التي لها أوراق سيفية الشكل ذات حواف حادة)",
 "sword knot": "عقدة السيف (شرابة زخرفية على مقبض السيف)",
 "sword lily": "زنبق السيف, سوسن (نباتات ذات أوراق تشبه السيف وسيقان منتصبة تحمل أزهاراً زاهية الألوان تتكون من ثلاث بتلات وثلاث سبلات متدلية) / دلبوث, زنبق السيف (أي من النباتات المتعددة من جنس دلبوث موطنها الرئيسي المناطق الاستوائية وجنوب أفريقيا ذات أوراق تشبه السيف وسنابل أحادية الجانب من الزهور القمعية…)",
 "sword of damocles": "سيف مسلت (مصدر للفعل سَافَ؛ سِلاح ذو حَدّ واحد طويل يعتبر من الأسْلِحَة البيضاء لأنها مصنوعة من حَدِيد أبيض حاد. كان أهم أنواع الأسلحة قبل اخْتِرَاع الأسلحة النَارِيَّة)\nمثال: القلم أقوى من السيف.",
 "sword stick": "عصا سيف (عصا تخفي سيفاً أو خنجراً)",
 "sword-cut": "جرح سيف, ندبة سيف (ندبة ناتجة عن جرح بسيف)",
 "sword-shaped": "سَيْفِيّ الشَّكْل (على شكل نصل السيف)",
 "swordfish": "سَمَكَة سَيْف (مصطلح شمولي لأي حيوان فقاري مائي خيشومي التنفس)\nمثال: سمكة ميناد ماتت",
 "swordlike": "سَيْفِيّ الشَّكْل (على شكل نصل السيف)",
 "swordplay": "مبارزة (فعل استخدام السيف (أو سلاح آخر) بقوة ومهارة)",
 "swordsman": "سَيَّاف",
 "swordsmanship": "مبارزة, مهارة استخدام السيف (المهارة في المبارزة)",
 "swordsmith": "سَيَّاف, سَلَّال",
 "swordswoman": "مبارزة (امرأة ماهرة في المبارزة)",
 "swordtail": "سيفية الذيل (سمكة مياه عذبة من أمريكا الوسطى لها ذيل طويل يشبه السيف؛ سمكة أحواض شعبية)",
 "sworn": "مُعَاهِد, مُقْسِم (مُلزَم بقسَم أو عهد أو ما يشبههما) / لدود, محلوف (ملزم أو مُقر بقسم)\nمثال: الآن صديقي الحميم وبعد ذلك عدوي اللدود",
 "swot": "دحيح, مجتهد ممل (طالب غير مهم يتعرض للسخرية لكونه متصنعاً أو مجتهداً بشكل ممل)",
 "swot analysis": "تحليل سوات, تحليل نقاط القوة والضعف والفرص والتهديدات (طريقة تخطيط هيكلية تستخدم لتقييم نقاط القوة والضعف والفرص والتهديدات المتضمنة في مشروع أو في مشروع تجاري)",
 "swot matrix": "تحليل سوات, تحليل نقاط القوة والضعف والفرص والتهديدات (طريقة تخطيط هيكلية تستخدم لتقييم نقاط القوة والضعف والفرص والتهديدات المتضمنة في مشروع أو في مشروع تجاري)",
 "swung dash": "شرطة متموجة (علامة ترقيم ('⁓') تستخدم في النص للإشارة إلى حذف كلمة)",
 "sybarite": "منغمس في الملذات (شخص مدمن على الرفاهية وملذات الحواس)",
 "sybaritic": "أَبِيقُورِيّ, مُتَرَفّ (يعرض الترف ويُمتِّع الحواسّ)",
 "sycamore": "جُمَّيْز",
 "sycamore fig": "جميز (شجرة واسعة الانتشار سميكة الفروع من أفريقيا وجنوب غرب آسيا المجاور مدعمة غالباً بفروع ترتفع من قرب الأرض؛ تنتج عناقيد من التين الصالح للأكل ولكنه…)",
 "syconium": "ثمرة تينية (الفاكهة المتعددة اللحمية للتين التي تتكون من وعاء مجوف متضخم يحتوي على العديد من الثميرات)",
 "sycophancy": "مداهنة, نفاق (تذلل متملق)",
 "sycophantic": "مُتَزَلِّف, مُتَمَلِّق (يَسْعَى لِكَسْب الوُدّ بِالتَّمَلُّق) / مُتَزَلِّف, مُتَمَلِّق (يُحَاوِل كَسْب وُدّ ذَوِي النُّفُوذ بِالتَّمَلُّق)",
 "sydenham's chorea": "رقص سيدنهام, رقصة القديس فيتوس (رقص يحدث بشكل رئيسي عند الأطفال ويرتبط بالحمى الروماتيزمية)",
 "sydney": "سِيدْنِي / سِدْنِي",
 "sydney opera house": "دار أُوبِرَا سِيدْنِي (المحل يجمع البِنَاء والعَرَصَة. قيل سمي كذلك لدوران الناس به وعليه وحوله. يجمع على دُور؛ المنزل المَبْني. يجمع على دُور)\nمثال: إذهب إلى الدار.",
 "sydney silky": "تيريير حريري, سيلكي تيريير (سلالة أسترالية من الكلاب اللعبة ذات فراء أزرق حريري)",
 "syeda": "سَيِّدَة",
 "syktyvkar": "سِيكْتِيفْكَار",
 "sylhet": "سِلْهَت",
 "sylhet district": "ضِلْع سِلْهَتْ",
 "sylheti": "سِلْهَتِيّ",
 "sylheti bengali": "اَلْبَنْغَالِيَة اَلسِّلْهَتِيَّة",
 "syllabary": "كتابة مقطعية, نظام مقطعي (نظام كتابة تمثل رموزه مقاطع صوتية)",
 "syllabic": "مقطعي ((لأصوات الكلام) تشكل نواة مقطع لفظي) / مقطعي (مكون من مقطع أو مقاطع) / مقطعي ((للشعر) يحتوي على أسطر تعتمد على عدد المقاطع بدلاً من الترتيب الإيقاعي للنبرات أو الكميات) / مقطعي (يتكون من أو يستخدم نظام كتابة مقطعي)\nمثال: الإسكيمو في القطب الشمالي الشرقي لديهم نظام للكتابة المقطعية",
 "syllabic script": "كتابة مقطعية, نظام مقطعي (نظام كتابة تمثل رموزه مقاطع صوتية)",
 "syllabically": "مقطعياً (في أو بمقاطع لفظية)\nمثال: ملفوظ مقطعياً",
 "syllabication": "تقطيع مقطعي (تشكيل أو تقسيم الكلمات إلى مقاطع لفظية)",
 "syllabicity": "نظام المقطعية (نمط تكوين المقطع في لغة معينة)",
 "syllabification": "تقطيع مقطعي (تشكيل أو تقسيم الكلمات إلى مقاطع لفظية)",
 "syllable": "مَقْطَع لَفْظِيّ, مَقْطَع",
 "syllable structure": "بنية الكلمة, صرف (الترتيب المقبول للأصوات في الكلمات)",
 "syllabled": "مُقَطَّع (يُنطَق بمقاطع واضحة ومُفَصَّلة)",
 "syllabub": "سيلابوب (كريمة محلاة مخفوقة مع النبيذ أو المشروب الكحولي) / سيلابوب (حليب ساخن متبل مع الروم أو النبيذ)",
 "syllabus": "برنامج دراسي, منهج دراسي (دورة متكاملة من الدراسات الأكاديمية)\nمثال: تم قبوله في برنامج جديد في الجامعة",
 "syllepsis": "سيلبسيس (استخدام كلمة لتحكم كلمتين أو أكثر مع الموافقة في العدد أو الحالة وما إلى ذلك مع واحدة فقط)",
 "syllogiser": "خبير القياس المنطقي (منطقي ماهر في الاستدلال القياسي)",
 "syllogism": "قياس منطقي (استدلال استنتاجي يتم فيه استخلاص نتيجة من مقدمتين)",
 "syllogist": "خبير القياس المنطقي (منطقي ماهر في الاستدلال القياسي)",
 "syllogistic": "قياسي (متعلق بالقياس المنطقي أو يتكون منه) / منطق القياس (في المنطق، التحليل الرسمي للمصطلحات والمعاملات المنطقية والهياكل التي تجعل من الممكن استنتاج استنتاجات صحيحة من مقدمات معطاة)\nمثال: استدلال قياسي",
 "syllogizer": "خبير القياس المنطقي (منطقي ماهر في الاستدلال القياسي)",
 "sylph": "حورية الهواء, سيلف (كائن عنصري يعتقد أنه يسكن الهواء) / حسناء رشيقة (شابة رشيقة ونحيلة)",
 "sylphic": "رَشِيقَة كَالحُورِيَّة ((عَنِ المَرْأَة أَوِ الفَتَاة) نَحِيلَة وَرَشِيقَة كَالحُورِيَّة)",
 "sylphlike": "رَشِيقَة كَالحُورِيَّة ((عَنِ المَرْأَة أَوِ الفَتَاة) نَحِيلَة وَرَشِيقَة كَالحُورِيَّة)",
 "sylva": "أشجار الغابة, سيلفا (أشجار الغابات التي تنمو في بلد أو منطقة معينة)",
 "sylvan": "حَرَجِيّ, غَابِيّ (مُتَعَلِّقٌ بِالغَابَاتِ أَوْ مِنْ سِمَاتِهَا) / سيلفان (روح تعيش في الغابات أو تتردد عليها)",
 "sylvanite": "سيلفانيت (معدن فضي أبيض يتكون من تيلوريد الذهب والفضة؛ مصدر للذهب في أستراليا وأمريكا)",
 "sylvester": "سيلفستر",
 "sylvia atricapilla": "أبو قلنسوة (هازجة صغيرة رمادية بنية ذات تاج أسود)",
 "sylvia communis": "هازجة بيضاء الزور (هازجة من العالم القديم بنية رمادية ذات حلق وأجزاء سفلية بيضاء)",
 "sylvia curruca": "هازجة بيضاء الزور الصغرى (هازجة من العالم القديم تشبه الهازجة بيضاء الزور الكبرى ولكنها أصغر)",
 "sylvian aqueduct": "قناة سيلفيان, مسال مخي (قناة تربط البطينين الثالث والرابع)",
 "sylvian fissure": "التلم الجانبي, شق سيلفيوس (أعمق وأبرز الشقوق القشرية؛ يفصل الفصوص الجبهية عن الفصوص الصدغية في كلا نصفي الكرة المخية)",
 "sylvilagus aquaticus": "أرنب المستنقعات (أرنب غابات يعيش في مستنقعات وأراضي جنوب شرق الولايات المتحدة المنخفضة)",
 "sylvilagus floridanus": "أرنب قطني الذيل الشرقي (واسع الانتشار في الولايات المتحدة باستثناء المناطق الشمالية الغربية والغربية البعيدة)",
 "sylvilagus palustris": "أرنب الأهوار (أرنب غابات يعيش في المناطق الساحلية المستنقعية من نورث كارولينا إلى فلوريدا)",
 "sylvine": "سيلفيت (معدن يتكون من كلوريد البوتاسيوم الطبيعي؛ خام مهم للبوتاسيوم يوجد في الطبقات الرسوبية)",
 "sylvite": "سيلفيت (معدن يتكون من كلوريد البوتاسيوم الطبيعي؛ خام مهم للبوتاسيوم يوجد في الطبقات الرسوبية)",
 "symbion pandora": "سيمبيون باندورا (النوع الوحيد المعروف من حاملات العجل؛ يعيش ملتصقاً تكافلياً بشفة الكركند)",
 "symbiosis": "تَكَافُل",
 "symbiotic": "تَكَافُلِيّ (يُسْتَخْدَمُ لِلكَائِنَاتِ الَّتِي تَعِيشُ مَعًا وَإِنْ لَمْ تَكُنِ العَلَاقَةُ نَافِعَةً لِلطَّرَفَيْن)",
 "symbiotically": "تكافلياً (بطريقة تكافلية)",
 "symbol": "رَمْز, عَلَامَة (رمز (جمعه رموز)؛ الرمز يعني الرسم الذي يعبر عن شيء معين وعموما فأن العلامة ينبغي نقل رسالتها بنظرة واحدة دون الحاجة للكلمات)\nمثال: تمثال الحرية رمز لأمريكا.",
 "symbol-worship": "تقديس الرموز (عبادة الرموز)",
 "symbolatry": "تقديس الرموز (عبادة الرموز)",
 "symbolic": "رَمْزِيّ, شِعَارِيّ (يعمل كرمز مرئي لشيء مجرد) / رمزي (متعلق بـ أو يستخدم أو يمضي عن طريق الرموز) / رمزي (يستخدم الرمزية)\nمثال: منطق رمزي",
 "symbolic logic": "منطق رمزي, منطق رياضي (أي نظام منطقي يجرد شكل العبارات بعيدًا عن محتواها لتأسيس معايير مجردة للاتساق والصحة)",
 "symbolic logician": "منطقي رمزي (شخص ماهر في المنطق الرمزي)",
 "symbolic representation": "ترميز, رمز (شيء مرئي يمثل بالارتباط أو العرف شيئاً آخر غير مرئي)\nمثال: النسر هو رمز للولايات المتحدة",
 "symbolical": "رَمْزِيّ, شِعَارِيّ (يعمل كرمز مرئي لشيء مجرد) / رمزي (متعلق بـ أو يستخدم أو يمضي عن طريق الرموز)\nمثال: منطق رمزي",
 "symbolically": "رمزياً (بطريقة رمزية) / رمزياً (بواسطة الرموز)\nمثال: أهداف مقبولة رمزياً",
 "symbolisation": "ترميز, رمزية (ممارسة إضفاء معنى رمزي على الأشياء) / ترميز, رمز (شيء مرئي يمثل بالارتباط أو العرف شيئاً آخر غير مرئي) / تَرْمِيز, تَمْثِيل رَمْزِيّ (استخدام الرموز لنقل المعنى)\nمثال: النسر هو رمز للولايات المتحدة",
 "symboliser": "رمزياتي, مفسر الرموز (شخص ماهر في تفسير أو تمثيل الرموز)",
 "symbolising": "ترميز (فعل تمثيل شيء ما برمز)",
 "symbolism": "رَمْزِيَّة",
 "symbolist": "رمزي, فنان رمزي (عضو في حركة فنية عبرت عن الأفكار بشكل غير مباشر عبر الرموز) / رمزياتي, مفسر الرموز (شخص ماهر في تفسير أو تمثيل الرموز)",
 "symbolization": "ترميز, رمزية (ممارسة إضفاء معنى رمزي على الأشياء) / ترميز, رمز (شيء مرئي يمثل بالارتباط أو العرف شيئاً آخر غير مرئي) / تَرْمِيز, تَمْثِيل رَمْزِيّ (استخدام الرموز لنقل المعنى)\nمثال: النسر هو رمز للولايات المتحدة",
 "symbolizer": "رمزياتي, مفسر الرموز (شخص ماهر في تفسير أو تمثيل الرموز)",
 "symbolizing": "ترميز (فعل تمثيل شيء ما برمز)",
 "symbology": "علم الرموز (دراسة أو استخدام الرموز والرمزية)",
 "symbololatry": "تقديس الرموز (عبادة الرموز)",
 "symmachy": "حلف عسكري (القتال معاً أو في تحالف مع حليف (أو حلفاء))\nمثال: بلغة فنية، كانت الرابطة البيلوبونيسية حلفاً عسكرياً مهيمناً",
 "symmetric": "متماثل, متناظر (له تشابه في الحجم والشكل والموقع النسبي للأجزاء المقابلة)",
 "symmetric difference": "فرق تماثلي",
 "symmetrical": "مُتَنَاظِر, مُتَمَاثِل",
 "symmetrically": "بشكل متناظر (بطريقة متناظرة)\nمثال: كانت مرتبة بشكل متناظر",
 "symmetricalness": "تناظر, توازن ((رياضيات) سمة لشكل أو علاقة؛ انعكاس دقيق للشكل على الجانبين المتقابلين لخط أو مستوى فاصل)",
 "symmetry": "تَنَاظُر",
 "sympathectomy": "قطع الودي (قطع جراحي لمسار عصبي في الجهاز العصبي الودي)",
 "sympathetic": "تَوافُقِيّ, رَنّانِيّ (يَتَعَلَّق بِالتَّوافُقِيّات أو الرَّنين المُتَعاطِف) / خَيِّر, طَيِّب القَلْب (يُظهر التعاطف والتفهّم والسخاء أو مدفوع بها) / مُتَعَاطِف, مُتَوَافِقُ المِزَاج (ذو مزاج وأذواق متشابهة) / متعاطف, مشفق (يعبر عن أو يشعر بـ أو ناتج عن تعاطف أو شفقة أو مشاعر أخوية ودية؛ ميال لـ)\nمثال: متعاطف مع قضية الطلاب",
 "sympathetic nervous system": "الجهاز العصبي السمبثاوي, الجهاز العصبي الودي (ينشأ في المناطق الصدرية من الحبل الشوكي؛ يعارض التأثيرات الفسيولوجية للجهاز الودي: يقلل من الإفرازات الهضمية؛ يسرع القلب؛ يقبض الأوعية الدموية)",
 "sympathetic strike": "إِضْرَاب تَضَامُنِيّ (إضراب لدعم عمال آخرين مضربين؛ إضراب لا ينتج عن مظالم مباشرة ضد صاحب عمل العمال)",
 "sympathetic vibration": "اهتزاز تعاطفي ((في الفيزياء) اهتزاز ناتج عن الرنين)",
 "sympathetically": "ودياً (عصبياً) (فيما يتعلق بالجهاز العصبي الودي) / بتعاطف (بطريقة متعاطفة)\nمثال: عمل المحفز ودياً",
 "sympathiser": "مؤيد, متعاطف (شخص يشاركك مشاعرك أو آرائك ويأمل أن تنجح) / متعاطف, مواسٍ (شخص يواسي شخصًا تعرض لمصيبة)",
 "sympathize": "تَعَاطَفَ",
 "sympathizer": "مؤيد, متعاطف (شخص يشاركك مشاعرك أو آرائك ويأمل أن تنجح) / متعاطف, مواسٍ (شخص يواسي شخصًا تعرض لمصيبة)",
 "sympathomimetic": "أدرينالي (يتعلق بالإيبينفرين (إطلاقه أو عمله))",
 "sympathy": "تَعَاطُف / عَطْف (عِطْف: عُنُق، رَقبة؛ الجمع: أَعْطَافٌ، و عِطَافٌ، و عُطُوفٌ) / حُنُو",
 "sympathy card": "بطاقة تعزية (بطاقة تعبر عن المواساة)",
 "sympathy strike": "إِضْرَاب تَضَامُنِيّ (إضراب لدعم عمال آخرين مضربين؛ إضراب لا ينتج عن مظالم مباشرة ضد صاحب عمل العمال)",
 "sympatric": "مستوطن مشترك ((للأنواع البيولوجية) توجد في نفس المناطق الجغرافية أو في مناطق متداخلة)",
 "sympatry": "توطن مشترك (وجود الكائنات الحية في مناطق جغرافية متداخلة، ولكن دون تزاوج)",
 "sympetalous": "مُلْتَحِم البَتَلَات (ذو تويج مكوَّن من بتلات ملتحمة كلّيًّا أو جزئيًّا على شكل أنبوب أو قمع)",
 "symphalangus syndactylus": "سيامانج (جيبون أسود كبير يعيش في سومطرة يتميز بأن إصبعي القدم الثاني والثالث متصلان جزئياً بغشاء)",
 "symphilid": "مئوية أرجل الحدائق (مفصلي دقيق يصيب غالباً الأجزاء الموجودة تحت الأرض من محاصيل الحدائق والدفيئات)",
 "symphonic": "سِيمْفونِيّ (مُتَناغِم كالسِّيمْفونِيَّة؛ ذو انْسِجام مُوسيقِيّ) / سيمفوني (يتعلق بالسيمفونية أو يميزها أو يوحي بها)\nمثال: جوقة سيمفونية",
 "symphonic music": "سيمفونية (سوناتا طويلة ومعقدة للأوركسترا السيمفونية)",
 "symphonic poem": "قصيدة سيمفونية, قصيدة نغمية (تكوين أوركسترالي مبني على الأدب أو الحكايات الشعبية)",
 "symphonious": "مُتَنَاغِم",
 "symphonist": "مؤلف سيمفونيات (مؤلف موسيقي يكتب السيمفونيات)",
 "symphony": "سِيمْفُونِيَّة, سِيمْفُونِي",
 "symphony orchestra": "أُورْكِسْتْرَا سِّمْفُونِي",
 "symphoricarpos alba": "توت الثلج, سيمفوريكاربوس (شجيرة متساقطة الأوراق من غرب أمريكا الشمالية لها سنابل من الأزهار الوردية يليها توت أبيض مستدير)",
 "symphoricarpos orbiculatus": "توت المرجان, كشمش هندي (شجيرة نفضية من أمريكا الشمالية تزرع لعناقيدها الغزيرة من الثمار الحمراء المرجانية الشبيهة بالتوت)",
 "symphysion": "ارتفاقية (النقطة الأكثر تقدماً للنتوء السنخي للفك السفلي)",
 "symphysis": "ارتفاق, التحام (نمو الأجزاء أو الهياكل معًا) / ارتفاق (التصاق غير طبيعي بين هيكلين أو أكثر)",
 "symphytum officinale": "سمفوطن, سنفيتون مخزني (عشب أوروبي له زهور صغيرة بيضاء أو وردية أو أرجوانية؛ تم توطينه كعشب ضار في أمريكا الشمالية)",
 "symplocarpus foetidus": "عشبة الظربان, ملفوف الظربان (نبات مستنقعات معمر نفضي منخفض النمو كريه الرائحة في شرق أمريكا الشمالية له أزهار دقيقة محاطة بقنابة مرقطة خضراء أو أرجوانية تشبه القلنسوة)",
 "symploce": "تكرار مزدوج (تكرار كلمة أو عبارة في البداية وأخرى في النهاية لجمل متتالية)",
 "symplocus paniculata": "توت الياقوت, ورقة الحلوى الآسيوية (شجيرة متساقطة الأوراق من شرق آسيا تحمل ثماراً زرقاء زاهية للزينة)",
 "symplocus tinctoria": "ورقة حلوة (شجرة خشب أصفر صغيرة من جنوب الولايات المتحدة لها زهور بيضاء عطرة صغيرة؛ الأوراق واللحاء ينتجان صبغة صفراء)",
 "symposiarch": "عريف المأدبة, مقدم الأنخاب (الشخص الذي يقترح الأنخاب ويقدم المتحدثين في مأدبة)",
 "symposiast": "مُشارِك فِي نَدْوَة (شخص يشارك في ندوة)",
 "symposium": "سِمْبُوزِيُوم, نَدْوَة",
 "symptom": "عَرَض, عَلَامَة (أتى العروض، أي مكّة والمدينة وما حولهما؛ الفَرَسَ: سار به بالعُرض) / عَرَض (أتى العروض، أي مكّة والمدينة وما حولهما؛ الفَرَسَ: سار به بالعُرض)\nمثال: قبل كلاي العرض.",
 "symptomatic": "تَشْخِيصِيّ, عَرَضِيّ (يدلّ على مرض معيّن أو يُميّزه) / أعراضي, عرضي (متعلق بـ أو وفقاً لـ أو يؤثر على عرض أو أعراض)\nمثال: تخفيف الأعراض",
 "symptomatically": "عرضياً (بواسطة الأعراض)",
 "symptomatology": "عِلْم اَلْأَعْرَاض (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "symptomless": "بِلَا أَعْرَاض, عَدِيم الأَعْرَاض (لا تظهر عليه أعراض مرض أو عِلّة)",
 "synaeresis": "انكماش الهلام, نضْح (انفصال السائل عن الهلام الناتج عن الانكماش (كما في صناعة الجبن)) / دمج الحركات (انكماش حرفين متحركين في إدغام)",
 "synaesthesia": "حس مواكب, مرافق حسية (إحساس يحدث عادة في حاسة معينة عند تحفيز حاسة أخرى)",
 "synaesthetic": "ترافق حسي, حسي متزامن (متعلق بـ أو يختبر الحس المرافق (السينسثيزيا)؛ ينطوي على أكثر من حاسة)\nمثال: استجابة حسية متزامنة للموسيقى",
 "synagogue": "كَنِيس, بِيعَة",
 "synagrops bellus": "قاروص أسود الفم (سمكة بحرية صغيرة ذات فم وتجويف خيشومي أسود)",
 "synanceja verrucosa": "السمكة الصخرية (سمكة بحرية استوائية سامة تشبه قطعة من الصخر)",
 "synapse": "مشبك",
 "synapsid": "مدموجة الأقواس (زاحف منقرض له زوج واحد من الفتحات الصدغية الجانبية في الجمجمة)",
 "synapsid reptile": "مدموجة الأقواس (زاحف منقرض له زوج واحد من الفتحات الصدغية الجانبية في الجمجمة)",
 "synapsis": "اقتران, تشابك (الاقتران جنباً إلى جنب للكروموسومات المتماثلة للأم والأب في بداية الانقسام المنصف)",
 "synaptic": "تشابكي, عصبي تشابكي ((علم الأعصاب) من أو يتعلق بالتشابكات العصبية)",
 "synaptomys borealis": "لاموس المستنقعات الشمالي (من المروج الألبية وشبه الألبية الرطبة في كندا وألاسكا)",
 "synaptomys cooperi": "لاموس المستنقعات الجنوبي (من المستنقعات المنخفضة والمروج في شمال شرق ووسط الولايات المتحدة وجنوب كندا)",
 "syncarp": "ثمرة متجمعة (فاكهة تتكون من العديد من الفواكه الصغيرة الفردية أو النواة المشتقة من مبايض منفصلة داخل وعاء مشترك: مثل التوت الأسود والتوت الأحمر والأناناس)",
 "syncarpous": "مُلْتَحِم الكَرَابِل ((لمبايض النباتات الزهرية) تتكون من كرابل متحدة)",
 "syncategorem": "كلمة دالة, لفظ غير مستقل (تعبير لا معنى له بذاته؛ كلمة لا يمكن استخدامها بمفردها كحد في قضية منطقية)\nمثال: المحددات المنطقية، والظروف، وحروف الجر، وأدوات العطف تسمى ألفاظاً غير مستقلة",
 "syncategorematic": "مشارك الدلالة (لمصطلح لا يمكن أن يقف كموضوع أو (خاصة) كمحمول لقضية ولكن يجب استخدامه بالاقتران مع مصطلحات أخرى)\nمثال: 'أو' هو مصطلح مشارك الدلالة",
 "syncategoreme": "كلمة دالة, لفظ غير مستقل (تعبير لا معنى له بذاته؛ كلمة لا يمكن استخدامها بمفردها كحد في قضية منطقية)\nمثال: المحددات المنطقية، والظروف، وحروف الجر، وأدوات العطف تسمى ألفاظاً غير مستقلة",
 "synchro": "سيلسين, نظام متزامن (نظام يتكون من مولد ومحرك متصلين بحيث يتخذ المحرك نفس الوضع النسبي للمولد؛ يكون المولد والمحرك متزامنن)",
 "synchrocyclotron": "سنكروسيكلوترون (سيكلوترون يحقق سرعات نسبية عن طريق تعديل تردد المجال الكهربائي المسرع)",
 "synchroflash": "فلاش متزامن (جهاز يستخدم في التصوير الفوتوغرافي لمزامنة ذروة الفلاش مع فتح مصراع الكاميرا)",
 "synchromesh": "تعشيق متزامن (نظام للسيارات لتغيير التروس تدور فيه التروس بنفس السرعة وبالتالي تتغير بسلاسة)",
 "synchronal": "تواقتي, متزامن (يحدث أو يوجد في نفس الوقت أو له نفس الفترة أو المرحلة)\nمثال: الشفاء كان متزامناً مع العلاج",
 "synchroneity": "تَزَامُن (العلاقة التي توجد عندما تحدث الأشياء في نفس الوقت)\nمثال: ينتج الدواء تزامنًا متزايدًا لموجات الدماغ",
 "synchronic": "تزامني (معني بالظواهر (خاصة اللغة) في فترة معينة دون النظر إلى السوابق التاريخية) / تواقتي, متزامن (يحدث أو يوجد في نفس الوقت أو له نفس الفترة أو المرحلة) / تَزَامُنِيّ ((للأصنوفات) يقع في نفس الحقبة الجيولوجية)\nمثال: علم اللغة التزامني",
 "synchronic linguistics": "لسانيات تزامنية (دراسة لغة دون الرجوع إلى سياقها التاريخي)",
 "synchronicity": "تَزَامُن (العلاقة التي توجد عندما تحدث الأشياء في نفس الوقت)\nمثال: ينتج الدواء تزامنًا متزايدًا لموجات الدماغ",
 "synchronisation": "تزامن, مزامنة (التنسيق عن طريق جعل الأشياء تشير إلى نفس الوقت أو تحدث فيه) / تزامن, مزامنة (تعديل يجعل شيئاً يحدث أو يتكرر في انسجام) / تَزَامُن (العلاقة التي توجد عندما تحدث الأشياء في نفس الوقت)\nمثال: كانت مزامنة ساعاتهم خطوة أولية مهمة",
