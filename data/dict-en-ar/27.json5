 "sun heater": "مدفأة كهربائية مشعة, مدفأة هالوجين (نوع من السخانات الكهربائية المحمولة والدوارة التي تستخدم عناصر الهالوجين لتدفئة المكان)",
 "sun helmet": "خوذة استوائية, قبعة الفلين (قبعة خفيفة الوزن تلبس في البلدان الاستوائية للحماية من الشمس)",
 "sun lamp": "مصباح شمسي (مصباح بخار الزئبق يستخدم في العلاجات الطبية أو التجميلية)",
 "sun letter": "حُرُوف شَمْسِيَّة, حَرْف شَمْسِيّ (صِيْغَةُ جَمْعٍ مُفْرَدُهَا: حرف)\nمثال: كيف أتذكر الحروف الصينية؟",
 "sun lounge": "غرفة مشمسة, مقصورة شمسية (غرفة محاطة بالزجاج بشكل كبير وتوفر التعرض للشمس)",
 "sun marigold": "قطيفة الرأس, قطيفة الشمس (أي من عدة نباتات من جنوب أفريقيا تُزرع لغزارة زهورها التي تشبه الأقحوان وعادة ما تكون صفراء وأوراقها العطرية)",
 "sun parlor": "غرفة مشمسة, مقصورة شمسية (غرفة محاطة بالزجاج بشكل كبير وتوفر التعرض للشمس)",
 "sun parlour": "غرفة مشمسة, مقصورة شمسية (غرفة محاطة بالزجاج بشكل كبير وتوفر التعرض للشمس)",
 "sun pitcher": "إبريق الشمس, هيليامفورا (أي من عدة أعشاب في مرتفعات غيانا ذات عناقيد من الزهور البيضاء أو الوردية المتدلية؛ تصطاد وتهضم الحشرات في أوراق على شكل إبريق ذات أغطية تشبه الملعقة)",
 "sun plant": "بقلة الزهور, رجلة الزهور (تزرع على نطاق واسع في العديد من الأصناف لأوراقها اللحمية التي تشبه الطحالب ووفرة زهورها زاهية الألوان)",
 "sun porch": "غرفة مشمسة, مقصورة شمسية (غرفة محاطة بالزجاج بشكل كبير وتوفر التعرض للشمس)",
 "sun protection factor": "عامل الحماية من الشمس (الدرجة التي يحمي بها واقي الشمس البشرة من أشعة الشمس المباشرة)",
 "sun rose": "هيليانثيموم, وردة الشمس (أي نبات من جنس هيليانثيموم؛ نباتات قوية في المروج الألبية الصخرية ومناطق الأحراش الجافة)",
 "sun spurge": "حليب الشيطان, فربيون الشمس (عشبة أوروبية غير جذابة تتحول زهورها نحو الشمس)",
 "sun tea": "شاي الشمس (شاي يُصنع بتعريض أوراق الشاي المنقوعة في الماء لأشعة الشمس المباشرة؛ يقدم عادة مع الثلج)",
 "sun visor": "حاجب الشمس (مظلة (أحياناً من الميكا الخضراء) تثبت فوق الزجاج الأمامي للسيارة)",
 "sun worshiper": "عابد الشمس (شخص يعبد الشمس)",
 "sun worshipper": "عَابِدُ شَمْسٍ, عابِدٌ لِلشَّمْسِ",
 "sun-drenched": "مُغْمَر بِالشَّمْس (مغمور ومغطى بأشعة الشمس)",
 "sun-dried": "مُجَفَّف بِالشَّمْس (مُجَفَّف طَبِيعِيًّا بِأَشِعَّة الشَّمْس)",
 "sun-loving": "مُحِبّ لِلشَّمْس ((في النَّبات) يَنْمو بِشَكْل أفْضَل في ضَوْء الشَّمْس المُباشِر)",
 "sun-ray": "شعاع شمس اصطناعي (شعاع من ضوء فوق بنفسجي اصطناعي من مصباح شمسي)",
 "sun-ray lamp": "مصباح شمسي (مصباح بخار الزئبق يستخدم في العلاجات الطبية أو التجميلية)",
 "sun-worship": "عبادة الشمس (عبادة الشمس)",
 "sunamganj district": "ضِلْع سُنَامْغَنْج",
 "sunbae": "سنباي (أنثى تشير إلى ذكر أكبر سناً (مصطلح كوري))",
 "sunbaked": "مُجَفَّفٌ بِالشَّمْس (تَصَلَّبَ بِالتَّعَرُّضِ لِأَشِعَّةِ الشَّمْسِ دُونَ احْتِرَاق) / مُحْتَرِق, يَابِس مِنَ الحَرّ (جفّ بفعل الحرارة أو التعرّض المفرط لأشعّة الشمس)",
 "sunbath": "حَمَّام شَمْس, حَمَّام شَمْسِيّ (قضاء الموت وقدره؛ جمع حُمَّة وهو قدر الفراق)\nمثال: هل الحمام جاهز؟",
 "sunbather": "مستحم بالشمس (شخص يستلقي تحت أشعة الشمس للحصول على سمرة)",
 "sunbathing": "حَمَّام شَمْس (قضاء الموت وقدره؛ جمع حُمَّة وهو قدر الفراق)\nمثال: هل الحمام جاهز؟",
 "sunbeam": "شعاع الشمس (شعاع من ضوء الشمس)",
 "sunberry": "توت العجائب, عنب الذيب البستاني (صنف حديقة محسن من عنب الذيب الأسود يحمل ثماراً برتقالية أو سوداء صغيرة صالحة للأكل)",
 "sunblind": "تنده, مظلة قماشية (ظلة مصنوعة من قماش القنب لحماية الناس أو الأشياء من المطر أو الشمس)",
 "sunblock": "كريم واقي من الشمس, واقي شمسي (نبيل النفس عزيزها ذو الخلق العالي والخير الكثير والعطاء السخي. الكَرَم يشمل مجموعة من الأخلاق أهمها العطاء؛ الجَوَاد السخيّ تحديدا)\nمثال: يا لك من رجل كريم!",
 "sunbonnet": "بونيه شمسي, قبعة شمسية (قبعة بونيه كبيرة تظلل الوجه؛ ترتديها الفتيات والنساء)",
 "sunburn": "حَرْق شَمْسِيّ, لَفْح الشَّمْس (الفعل له عدة معانٍ تتعلق بالتأثير والتلف، منها: برد الحديد، حكّ الأنياب، إتلاف الثوب بالدق، وحرق الشيء بالنار؛ إتلاف شيء ما بالنار أو بأداة حادة، كما يشمل المعنى المجازي للألم الشديد والحزن الذي يُؤثر في القلب)\nمثال: قامت ليلى بحرق كل كتب آرت المتعلقة بالأدب العنصري.",
 "sunburned": "مَحْروق بِالشَّمْس (مُصاب بِحُروق ناتِجَة عَن التَّعَرُّض المُفْرِط لِأشِعَّة الشَّمْس)",
 "sunburnt": "مَحْروق بِالشَّمْس (مُصاب بِحُروق ناتِجَة عَن التَّعَرُّض المُفْرِط لِأشِعَّة الشَّمْس)",
 "sunburst": "بروش مشع (بروش مرصع بالجواهر بنمط يشبه الشمس) / تصميم مشع (تصميم يتكون من قرص مركزي يشبه الشمس وأشعة تنبعث منه) / سطوع الشمس المفاجئ (ظهور مفاجئ للشمس من خلف الغيوم)",
 "sunburst pleat": "كسرة مشعة (كسرة سكين مقصوصة بشكل مائل لإنتاج تأثير متسع)",
 "sunchoke": "أرضي شوكي قدسي, خرشوف قدسي (درنة دوار الشمس تؤكل نيئة أو مسلوقة أو مقطعة إلى شرائح رقيقة ومقلية)",
 "sundacarpus amara": "بودوكاربوس مر, سونداكاربوس (شجرة استوائية دائمة الخضرة كبيرة سريعة النمو أحادية المسكن ذات أوراق رمحية لامعة كبيرة؛ من الغابات المطيرة في سومطرة والفلبين إلى شمال كوينزلاند)",
 "sundae": "آيس كريم صانداي, صانداي (آيس كريم يُقدم مع إضافة علوية (توبينج))",
 "sundanese": "اللغة السوندانية (اللغة الإندونيسية التي يتم التحدث بها في غرب جاوة)",
 "sundanese language": "اللغة السوندانية (اللغة الإندونيسية التي يتم التحدث بها في غرب جاوة)",
 "sundate": "موعد الأحد (موعد يوم الأحد)",
 "sunday": "الْأَحَد, يَوْم الْأَحَد",
 "sunday best": "أفضل الثياب, ملابس الأحد (أفضل الملابس التي يمتلكها الشخص والتي تلبس عادة للكنيسة يوم الأحد)",
 "sunday clothes": "أفضل الثياب, ملابس الأحد (أفضل الملابس التي يمتلكها الشخص والتي تلبس عادة للكنيسة يوم الأحد)",
 "sunday punch": "لكمة قاضية (لكمة قوية تجعل الخصم غير قادر على مواصلة الملاكمة)",
 "sunday school": "مدرسة الأحد (مدرسة تجتمع أيام الأحد للتعليم الديني)",
 "sunderland": "سندرلاند",
 "sundew": "نبات الندية, ندية (مصدر للفعل نَبَتَ؛ اسم جنس شامل لكل ما تنبته الأرض من شجر أو بقل أو عشب أو غيره)\nمثال: هذا النبات مهدد بالانقراض.",
 "sundew plant": "نبات الندية, ندية (مصدر للفعل نَبَتَ؛ اسم جنس شامل لكل ما تنبته الأرض من شجر أو بقل أو عشب أو غيره)\nمثال: هذا النبات مهدد بالانقراض.",
 "sundial": "مِزْوَلَة",
 "sundial lupine": "ترمس بري, ترمس معمر (نبات معمر قوي من شرق ووسط أمريكا الشمالية له أوراق كفية وزهور زرقاء عنقودية مبهرجة)",
 "sundog": "شمس كاذبة, شمس وهمية (بقعة ساطعة على الدائرة الشمسية؛ ناتجة عن انكسار الضوء بواسطة بلورات الجليد)\nمثال: عادة ما تُرى شمسين وهميتين أو أكثر في وقت واحد",
 "sundown": "غروب, غروب الشمس (الوقت في المساء الذي تبدأ فيه الشمس بالنزول تحت الأفق)",
 "sundowner": "مشروب الغروب (مشروب يتم تناوله عند غروب الشمس) / متشرد الغروب (متشرد يصل عادة عند غروب الشمس)",
 "sundress": "فستان صيفي (فستان صيفي خفيف وفضفاض بلا أكمام بفتحة رقبة واسعة وحمالات كتف رفيعة تكشف الذراعين والكتفين)",
 "sundried": "مُجَفَّف بِالشَّمْس (مُجَفَّف طَبِيعِيًّا بِأَشِعَّة الشَّمْس)",
 "sundries": "متفرقات (أشياء متنوعة عديدة جداً أو صغيرة جداً بحيث لا يمكن تحديدها)",
 "sundrops": "قطرات الشمس (نبات ثنائي الحول أو معمر يزهر نهاراً من جنس زهرة الربيع المسائية)",
 "sunfish": "سمكة الشمس (أسماك فرخية صغيرة آكلة للحوم تعيش في المياه العذبة بأمريكا الشمالية، عادة ما يكون جسمها مضغوطاً جانبياً ولها بريق معدني) / سمكة شمس المحيط, مولا (من بين أكبر الأسماك العظمية؛ سمكة تعيش في عرض البحر ذات جسم بيضاوي مضغوط وزعانف ظهرية وشرجية عالية وزعنفة ذيلية مختزلة إلى فص يشبه الدفة؛ توجد…) / سمكة الشمس (اللحم قليل الدهن لأي من العديد من الأسماك الأمريكية الشبيهة بالفرخ)",
 "sunflower": "زَهْرَة اَلشَّمْس, دَوَّار اَلشَّمْس",
 "sunflower oil": "زيت عباد الشمس (زيت مستخرج من بذور عباد الشمس)",
 "sunflower seed": "حَبّ الشَّمْسِ (الزرع، كبيرا كان أم صغيرا؛ بَذْرُ الزرع)\nمثال: زيري بحب المال.",
 "sunflower-seed oil": "زيت عباد الشمس (زيت مستخرج من بذور عباد الشمس)",
 "sung": "سلالة سونغ, سونغ (السلالة الإمبراطورية للصين من 960 إلى 1279؛ اشتهرت بالفن والأدب والفلسفة)",
 "sung dynasty": "سلالة سونغ, سونغ (السلالة الإمبراطورية للصين من 960 إلى 1279؛ اشتهرت بالفن والأدب والفلسفة)",
 "sunglass": "عدسة حارقة (عدسة محدبة تركز أشعة الشمس؛ تستخدم لإشعال النار)",
 "sunglasses": "نَظَّارَة شَمْسِيَّة, نَظَّارَة شَمْس",
 "sunhat": "قبعة شمسية (قبعة ذات حافة عريضة تحمي الوجه من التعرض المباشر للشمس)",
