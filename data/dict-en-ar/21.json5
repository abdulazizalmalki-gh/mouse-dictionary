 "piety": "تَقْوَى / بِرّ (أحسن إلى والديه أو إلى غيره بالخير والاحترام؛ صدق أو وفى بوعد أو عهد)\nمثال: دخل زيري إلى منطقة ببر.",
 "piezo effect": "بيزوكهربائية, كهرباء انضغاطية (كهرباء ناتجة عن الضغط الميكانيكي على بلورات معينة (خاصة الكوارتز أو ملح روشيل)؛ أو بدلاً من ذلك، ينتج الإجهاد الكهروستاتيكي تغيراً في الأبعاد الخطية…)",
 "piezoelectric": "بيزوكهريائي, كهروضغطي (يتعلق بالكهرباء الضغطية أو يتضمنها)\nمثال: صفائح كهروضغطية",
 "piezoelectric crystal": "بلورة كهروضغطية (بلورة يمكن استخدامها كمحول للطاقة)",
 "piezoelectric effect": "بيزوكهربائية, كهرباء انضغاطية (كهرباء ناتجة عن الضغط الميكانيكي على بلورات معينة (خاصة الكوارتز أو ملح روشيل)؛ أو بدلاً من ذلك، ينتج الإجهاد الكهروستاتيكي تغيراً في الأبعاد الخطية…)",
 "piezoelectric material": "مادة بيزوكهربائية, مادة كهروضغطية (مادة تراكم شحنة كهربائية استجابة للإجهاد الميكانيكي)",
 "piezoelectricity": "بيزوكهربائية, كهرباء انضغاطية (كهرباء ناتجة عن الضغط الميكانيكي على بلورات معينة (خاصة الكوارتز أو ملح روشيل)؛ أو بدلاً من ذلك، ينتج الإجهاد الكهروستاتيكي تغيراً في الأبعاد الخطية…)",
 "piezometer": "بيزومتر, مقياس الانضغاطية (أداة قياس لقياس الضغوط العالية)",
 "piffle": "ثَرْثَرَة فَارِغَة, سَخَافَة (هراء تافه)",
 "piffling": "تَافِه, زَهِيد ((غير رسمي) صغير ولا أهمّيّة له)",
 "pig": "خِنْزِير / حَلُوف / خنزير / حلوف / خَنْزير",
 "pig bed": "قالب صب الحديد (قالب يتكون من سرير من الرمل يُصب فيه الحديد الغفل)",
 "pig farm": "حظيرة خنازير, مزرعة خنازير (مزرعة يتم فيها تربية الخنازير أو الاحتفاظ بها)",
 "pig iron": "حديد غفل (مَعْدِن صَلْب قَوِيّ يستخرج من الأرض له ألوان تتراوح بين الرَمَاديّ والأسْوَد)\nمثال: حملت الحديد فلم أجد أثقل من الدين.",
 "pig laurel": "غار الغنم, كلمية ضيقة الأوراق (شجيرة قزمية من أمريكا الشمالية تشبه غار الجبل ولكن بأوراق أضيق وزهور حمراء صغيرة؛ سامة للماشية الصغيرة)",
 "pig lead": "رصاص غفل, سبائك الرصاص الخام (رصاص مصبوب في قوالب (سبائك))",
 "pig's ears": "أذن الخنزير (غاريقون صالح للأكل بجسم ثمري بني غالباً ما يكون مركباً)",
 "pig-a-back": "أوباً, على الظهر (على الظهر أو الكتفين أو الركوب على الورك) / محمولاً (على عربة مسطحة للسكك الحديدية (شحن الحاويات))\nمثال: حملت طفلها على ظهرها",
 "pig-headedly": "بإصرار, بعناد (بطريقة عنيدة)\nمثال: بقيت بعناد في نفس الوضع",
 "pig-sized": "بِحَجْمِ الْخِنْزِيرِ (بحجم خنزير تقريبًا)",
 "pigboat": "غواصة (سفينة حربية غاطسة مسلحة عادة بطوربيدات)",
 "pigeon": "حَمَامَة",
 "pigeon berry": "توت الحمام, صبغة أمريكية (عشبة أمريكية معمرة طويلة خشنة ذات أزهار بيضاء صغيرة تليها توت أسود محمر على عناقيد متدلية طويلة؛ السيقان اللحمية الصغيرة صالحة للأكل؛ التوت والجذر…)",
 "pigeon breast": "صدر حمامي (بروز غير طبيعي لعظم القص بسبب الكساح)",
 "pigeon droppings": "زرق الحمام, فضلات الحمام (فضلات الحمام)",
 "pigeon guillemot": "غلموت الحمام (غلموت شمال المحيط الهادئ)",
 "pigeon hawk": "يؤيؤ (صقر صغير من أوروبا وأمريكا ذو ريش داكن وذيل مخطط بالأسود؛ يستخدم في الصيد بالصقور)",
 "pigeon keeping": "تربية الحمام (فن وعلم تربية الحمام المستأنس)\nمثال: بالنسبة لشخص سليم وذو مناعة قوية، تعتبر تربية الحمام وفقاً للمعايير الحالية نشاطاً آمناً جداً",
 "pigeon loft": "برج حمام (مأوى مرتفع يتم فيه تربية الحمام)",
 "pigeon pea": "بَازِلَّاء هِنْدِيَّة, بِسِلَّة هِنْدِيَّة",
 "pigeon toes": "إصبع الحمامة (إعاقة تتجه فيها أصابع القدم إلى الداخل)",
 "pigeon-breasted": "بَارِز القَصّ, مُقَعَّر الصَّدْر (ذو تشوُّه في الصدر يتميَّز ببروز عظم القصّ بسبب الكُساح في الطفولة)",
 "pigeon-pea plant": "بازلاء الحمام, لوبيا العدس (عشبة خشبية استوائية ذات أزهار صفراء مبهرجة وقرون مسطحة؛ تزرع بكثرة في المناطق الاستوائية)",
 "pigeon-toed": "أروح, حنف القدم (ذو قدمين تتجهان نحو الداخل)",
 "pigeonhole": "حجيرة, رف رسائل (حجرة صغيرة) / تصنيف نمطي, خانة (فئة محددة (غالبًا ما تكون مبسطة))",
 "pigeonholing": "تجميع, تصنيف (نظام لتصنيف الأشياء إلى مجموعات)",
 "pigfish": "سمكة الخنزير (توجد من لونغ آيلاند جنوباً) / سمكة الخنزير العملاقة (توجد حول الحاجز المرجاني العظيم)",
 "piggery": "حظيرة خنازير, مزرعة خنازير (مزرعة يتم فيها تربية الخنازير أو الاحتفاظ بها)",
 "piggish": "بَهِيمِيّ, خِنْزِيرِيّ (يُشبِه الخنازير في النَّهَم والجشع)",
 "piggishly": "بأنانية, بشراهة (بطريقة جشعة وأنانية)\nمثال: بأنانية، أخذ قطعتين من الكعك",
 "piggishness": "جشع, شره (رغبة مفرطة في الطعام)",
 "piggy": "بَهِيمِيّ, خِنْزِيرِيّ (يُشبِه الخنازير في النَّهَم والجشع) / خنزير صغير, خنوص (خنزير صغير)",
 "piggy bank": "حَصَّالَة",
 "piggyback": "أبوش, حمل على الظهر (عملية حمل شخص أو شيء على الظهر) / أوباً, على الظهر (على الظهر أو الكتفين أو الركوب على الورك) / محمولاً (على عربة مسطحة للسكك الحديدية (شحن الحاويات))\nمثال: حملت طفلها على ظهرها",
 "piggyback plant": "تولميا, نبات الشباب (عشب معمر قوي بأزهار في عناقيد منتصبة وتتطور نباتات صغيرة عند اتصال نصل الورقة بسويقتها)",
 "pigheaded": "أَحْمَق العِنَاد, عَنِيد بِغَبَاء (عنيد وغبيّ في آن واحد)",
 "pigheadedness": "عناد (التمسك الحازم بأفكار أو رغبات المرء)",
 "piglet": "خِنَّوْص",
 "pigman": "راعي خنازير (راعي ذكر للخنازير)",
 "pigment": "دهان, طلاء (مادة تستخدم كطلاء لحماية أو تزيين سطح (خاصة خليط من صبغة معلقة في سائل)؛ تجف لتشكل طبقة صلبة) / خضاب, صبغة (مادة تلوين جافة (خاصة مسحوق يخلط مع سائل لإنتاج الطلاء، إلخ)) / خضاب, صبغة (أي مادة ينتج عن وجودها في الأنسجة النباتية أو الحيوانية لون مميز)",
 "pigmentation": "تصبغ (تلوين الأنسجة الحية بواسطة صبغة) / تصبغ (ترسب الصبغة في الحيوانات أو النباتات أو البشر)",
 "pigmy": "قزم (أي عضو من شعوب مختلفة يقل متوسط طولهم عن خمسة أقدام) / قزم (فرد صغير الحجم بشكل غير عادي)",
 "pigmy talinum": "تالينوم قزم (نبات منخفض ذو أوراق عصارية ضيقة مزدحمة وأزهار إبطية وردية داكنة كبيرة نوعاً ما تبدو وكأنها تجلس على الأرض؛ جنوب غرب الولايات المتحدة)",
 "pignolia": "صنوبر (البذرة الصالحة للأكل لأي من عدة أنواع من الصنوبر خاصة بعض أنواع الصنوبر في جنوب غرب أمريكا الشمالية)",
 "pignut": "جوز الخنزير (شجرة جوز أمريكية لها مكسرات مرة)",
 "pignut hickory": "جوز الخنزير (شجرة جوز أمريكية لها مكسرات مرة)",
 "pigpen": "خم خنازير, زريبة خنازير (حظيرة للخنازير)",
 "pigs in blankets": "نقانق في عجين (نقانق صغيرة ملفوفة في عجينة ومخبوزة)",
 "pigs' feet": "أقدام خنزير, كوارع خنزير (أقدام أو مفاصل الخنازير تستخدم كطعام؛ مخللة أو مطهية ببطء أو هلامية)",
 "pigs' knuckles": "أقدام خنزير, كوارع خنزير (أقدام أو مفاصل الخنازير تستخدم كطعام؛ مخللة أو مطهية ببطء أو هلامية)",
 "pigskin": "جلد الخنزير (جلد مصنوع من جلد الخنازير)",
 "pigsticking": "صيد الخنزير البري (رياضة صيد الخنازير البرية بالرماح)",
 "pigsty": "زَرِيبَةُ خَنَازِير",
 "pigswill": "حساء الخنازير, غسالة (علف رطب (خاصة للخنازير) يتكون غالباً من فضلات المطبخ ممزوجة بالماء أو الحليب منزوع الدسم)",
 "pigtail": "ضَفِيرَة صَغِيرَة (جديلة من الشعر المضفر)",
 "pigwash": "حساء الخنازير, غسالة (علف رطب (خاصة للخنازير) يتكون غالباً من فضلات المطبخ ممزوجة بالماء أو الحليب منزوع الدسم)",
 "pigweed": "رجل الوز, سرمق (أوراق تجمع من البرية) / عشبة الخنازير, قطيفة خضراء (تستخدم الأوراق أحياناً كبقوليات؛ تستخدم البذور كحبوب؛ جنوب الولايات المتحدة إلى أمريكا الوسطى؛ الهند والصين) / رجل الوزة, سبانخ بري (نبات عشبي أوروبي شائع دخيل في أمريكا الشمالية؛ غالباً ما يستخدم كبقلة)",
 "pika": "بيكا (ثديي حفار صغير قصير الأذن من المرتفعات الصخرية في آسيا وغرب أمريكا الشمالية)",
 "pikachu": "بيكاتشو",
 "pike": "بايك, سمك الكراكي (أي من عدة أسماك صيد وغذاء ممدودة طويلة الخطم تعيش في المياه العذبة وتنتشر على نطاق واسع في الأجزاء الباردة من نصف الكرة الشمالي) / أوتوستراد, طريق سريع (طريق سريع عريض مصمم لحركة المرور عالية السرعة) / رمح (سلاح من العصور الوسطى يتكون من رأس رمح مثبت على عمود طويل؛ حل محله الحربة) / سنان (نقطة حادة (كما في نهاية الرمح))",
 "pike perch": "فرخ الكراكي (أي من عدة أسماك تشبه الكراكي من فصيلة الفرخ)",
 "pike-perch": "فرخ الكراكي (أي من عدة أسماك تشبه الكراكي من فصيلة الفرخ)",
 "pikeblenny": "بايك بليني (أسماك أمريكية استوائية؛ الذكور يدافعون بقوة عن مناطقهم)",
 "piked reverse hang": "تعلق عكسي مثني (تعلق عكسي يؤدى على الحلقات)",
 "piked whale": "حوت المنك, حوت المنك الشمالي (حوت زعنفي صغير يعيش في المياه الساحلية للمحيط الأطلسي والهادئ)",
 "pikestaff": "نصاب الرمح (عصا الرمح)",
 "pilaf": "بِيلَاو",
 "pilaff": "بيلاف, بيلاو (أرز مطبوخ في مرق متبل جيداً مع البصل أو الكرفس وعادة الدواجن أو الصيد أو المحار وأحياناً الطماطم)",
 "pilar": "شعري (مكون من أو متعلق بشعرة)",
 "pilar cyst": "كيس دهني (كيس شائع في الجلد مملوء بمادة دهنية تفرزها غدة دهنية مسدودة)",
 "pilary": "ذُو وَبَر نَاعِم, مُشَعَّر (مغطى بشعيرات خاصة الناعمة والرقيقة منها)",
 "pilaster": "دعامة جدارية, عمود ناتئ (عمود مستطيل يبرز عادة حوالي ثلث عرضه من الجدار المتصل به)",
 "pilate": "بِيلَاطُس",
 "pilau": "بيلاف, بيلاو (أرز مطبوخ في مرق متبل جيداً مع البصل أو الكرفس وعادة الدواجن أو الصيد أو المحار وأحياناً الطماطم)",
 "pilaw": "بيلاف, بيلاو (أرز مطبوخ في مرق متبل جيداً مع البصل أو الكرفس وعادة الدواجن أو الصيد أو المحار وأحياناً الطماطم)",
 "pilchard": "بلشار, سردين (أسماك صغيرة توجد في أسراب كبيرة على طول سواحل أوروبا؛ أصغر وأكثر استدارة من الرنجة) / سردين (سمكة دهنية صغيرة تعلب عادة)",
 "pile": "كَوْم",
 "pile driver": "مِدَقّ, مَاكِنَة دَقّ الرَكَائِز (ما يدق او يطرق به ويسمى كذلك مطرقة)",
 "pile dwelling": "مسكن بحيري (مسكن مبني على ركائز في بحيرة أو بالقرب منها؛ تحديداً في قرى ما قبل التاريخ)",
 "pilea involucrata": "باناميكا, نبات الصداقة (قراص منخفض غير لاذع من أمريكا الوسطى والجنوبية ذو أوراق مسننة بنية مخضرة مخملية وعناقيد من الزهور الخضراء الصغيرة)",
 "pilea microphylla": "نبات المدفعية (قراص استوائي أمريكي غير لاذع يطلق حبوب اللقاح بشكل متفجر)",
 "pilea pumilla": "عشبة غنية, قراص ميت (نباتات من جنس بيليا ذات عناقيد زهرية خضراء متدلية وسيقان وأوراق شفافة ملساء)",
 "pileous": "شَعْرِيّ",
 "piles": "أطنان, أكوام (عدد أو كمية كبيرة) / بواسير (تضخم وريدي خارجي أو داخلي للمصرة الشرجية)\nمثال: كون الكثير من الصداقات الجديدة",
 "pileup": "تصادم متسلسل (تصادمات متعددة للمركبات)",
 "pileus": "غطاء الفطر, قلنسوة (هيكل ثمري يشبه المظلة أو المخروط يشكل قمة فطر لحمي ذي ساق مثل المشروم)",
 "pilewort": "بقلة الخطاطيف الصغرى, حوذان التين (عشب معمر موطنه أوروبا ولكن تم توطينه في أماكن أخرى له أوراق على شكل قلب وزهور صفراء تشبه الحوذان؛ استخدمت جذوره الدرنية كلبخة لتخفيف البواسير)",
 "pilferage": "سرقة بسيطة, نشل (فعل سرقة كميات صغيرة أو أشياء صغيرة)",
 "pilferer": "لص متسلل (لص يسرق دون استخدام العنف)",
 "pilgrim": "حَاجّ, حَجِّيّ (افتقر)\nمثال: لا أرى لذلك حاجة.",
 "pilgrim father": "أحد الآباء الحجاج, حاج (أحد المستعمرين الإنجليز الذين أبحروا إلى أمريكا على متن سفينة ماي فلاور وأسسوا مستعمرة بليموث في نيو إنجلاند عام 1620)",
 "pilgrim's journey": "حج, زيارة مقدسة (رحلة إلى مكان مقدس)",
 "pilgrimage": "حَجّ (القَصْد والزِيَارَة على جهة التَعْظِيم؛ زيارة مكان مُقَدَّس بهدف ديني ويوجد عند معظم الديانات منها اليَهُودِيَّة والمَسِيحِيَّة والإسْلام)\nمثال: ذهب رجل للحج وترك خلفه خمس بنات وكلبة.",
 "piling": "ركيزة, وتد (عمود من الخشب أو الفولاذ أو الخرسانة يتم دقه في الأرض لتوفير الدعم لهيكل ما)",
 "piling hammer": "مطرقة دق الخوازيق (جهاز كبير لدق الركائز (الخوازيق))",
 "pill": "حَبَّة دَوَاء (واحدة الحَبّ؛ البَذْرَة، لأنها صغيرة مثل الحبة) / قُرْص / حَبّ (الزرع، كبيرا كان أم صغيرا؛ بَذْرُ الزرع) / حَبَّة (واحدة الحَبّ؛ البَذْرَة، لأنها صغيرة مثل الحبة)\nمثال: أكلت حبة طماطم.",
 "pill bottle": "زجاجة دواء, عبوة حبوب (زجاجة صغيرة لحفظ الحبوب)",
 "pill bug": "قملة الخشب المكورة (متماثل أرجل أرضي صغير ذو جسم مقسم محدب يمكنه الالتفاف على شكل كرة)",
 "pill head": "مدمن حبوب (مستهلك لحبوب الأمفيتامين)",
 "pill pusher": "صيدلي (مهني صحي مدرب في فن تحضير وصرف الأدوية)",
 "pill roller": "صيدلي (مهني صحي مدرب في فن تحضير وصرف الأدوية)",
 "pillage": "غَزَاوَة",
 "pillaged": "مَنْهُوب, مُخَرَّب (تَعَرَّضَ لِلنَّهْبِ وَالتَّدْمِيرِ بِالقُوَّةِ وَالعُنْف) / مَسْلُوب, مَنْهُوب (فُرِّغَ ظُلْمًا مِنْ كُلّ مَا لَهُ قِيمَة)",
 "pillager": "سالب, ناهب (شخص يأخذ الغنائم أو الأسلاب (كما في الحرب))",
 "pillaging": "سلب, نهب (فعل سرقة أشياء ثمينة من مكان ما)\nمثال: نهب البارثينون",
 "pillar": "عمود",
 "pillar box": "صندوق بريد عمودي (صندوق رسائل أحمر على شكل عمود)",
 "pillar of islam": "ركن من أركان الإسلام ((الإسلام) أحد الواجبات الدينية الخمسة التي يقبلها جميع المسلمين)",
 "pillar of strength": "ركن شديد, سند قوي (شخص يمكن الاعتماد عليه لتقديم قدر كبير من الدعم والراحة)",
 "pillar-shaped": "عَمُودِيُّ الشَّكْلِ (ذو شكل أسطواني يشبه العمود)",
 "pillared": "ذُو دَعَائِم, مُعَمَّد (يحتوي على دعائم أو أعمدة ضخمة)",
 "pillars of hercules": "أَعْمِدَة هِرَقْل",
 "pillbox": "دشمة, صندوق وقاية (موضع مدفع صغير مغلق (عادة من الخرسانة المحصنة)) / علبة حبوب, علبة دواء (علبة صغيرة لحفظ الحبوب الدوائية) / توك, قبعة علبة الدواء (قبعة نسائية صغيرة مستديرة)",
 "pillion": "مقعد رديف (مقعد خلف راكب الحصان أو الدراجة النارية وما إلى ذلك)",
 "pillock": "أحمق, بليد (شخص ليس ذكياً جداً)\nمثال: إنه الاقتصاد يا غبي!",
 "pillory": "مقطرة (أداة عقاب خشبية على عمود بفتحات للمعصمين والرقبة؛ كان المخالفون يُحبسون فيها ويتعرضون للسخرية العامة)",
 "pillow": "وِسَادَة, مِخَدَّة (ما يوضع تحت الرأس عند النوم أو الاستلقاء)\nمثال: غطى توم رأسه بوسادة.",
 "pillow block": "كراسي تحميل (كتلة من الحديد الزهر أو الصلب لدعم محور أو محمل)",
 "pillow fight": "حرب الوسائد (لعبة للأطفال تتضمن القتال بالوسائد)",
 "pillow lace": "دانتيل البكرة, دانتيل الوسادة (دانتيل مصنوع يدوياً يعمل على وسادة بخيوط ملفوفة على بكرات؛ يتم تحديد النمط على الوسادة بواسطة دبابيس)",
 "pillow lava": "لابة وسادية (حمم تصلبت في أشكال مستديرة توحي بالوسائد؛ يعتقد أنها ناتجة عن ثورات تحت الماء)",
 "pillow sham": "غطاء وسادة مزخرف (بياضات سرير تتكون من غطاء تزييني للوسادة)",
 "pillow slip": "غطاء وسادة, كيس وسادة (بياضات سرير تتكون من غطاء للوسادة)\nمثال: حمل اللص مسروقاته في كيس وسادة",
 "pillow talk": "حديث الوسادة (محادثة حميمة بين العشاق (تحدث عادة في السرير))",
 "pillowcase": "غطاء وسادة, كيس وسادة (بياضات سرير تتكون من غطاء للوسادة)\nمثال: حمل اللص مسروقاته في كيس وسادة",
 "pillwort": "بيلولاريا, عشبة الحبوب (سرخس مائي أوروبي يوجد حول هوامش المسطحات المائية أو في التربة الحمضية الرطبة ذو أكياس بوغية كروية صغيرة)",
 "pilocarpine": "بيلوكاربين (قلويد كوليني يستخدم في قطرات العين لعلاج الغلوكوما)",
 "pilomotor reflex": "قشعريرة, منعكس محرك للشعر (انتصاب انعكاسي لشعر الجلد استجابة للبرد أو الضغط العاطفي أو تهيج الجلد)",
 "pilose": "ذُو وَبَر نَاعِم, مُشَعَّر (مغطى بشعيرات خاصة الناعمة والرقيقة منها)",
 "pilosebaceous": "شعري دهني (مكون من أو متعلق بجريب الشعرة وغدتها الدهنية)",
 "pilosella aurantiaca": "حشيشة الغراب البرتقالية (حشيشة غراب أوروبية لها رؤوس زهرية بأشعة حمراء برتقالية زاهية؛ عشب ضار مزعج خاصة في شمال شرق أمريكا الشمالية؛ توضع أحياناً في جنس هيراسيوم)",
 "pilosella officinarum": "صقور أذن الفأر (صقور أوروبي ذو أوراق مشعرة ناعمة)",
 "pilosity": "شعرانية, غزارة الشعر (صفة امتلاك الشعر)",
 "pilot": "طَيَّار, طَيَّارَة (اسم فاعل للمبالغة على وزن فَعَّال؛ الذي يقود الطَائِرَة سواء كانت مهنته أم لا)\nمثال: لم توجه أبدا تهمة القيادة غير المسؤولة للطيار.",
 "pilot balloon": "بالون رصد التيارات (بالون أرصاد جوية يستخدم لمراقبة التيارات الهوائية)",
 "pilot biscuit": "بقسماط السفينة, خبز البحارة (بسكويت أو خبز صلب جداً غير مملح؛ كان غذاءً أساسياً في السفن قديماً)",
 "pilot bit": "ريشة استرشادية (ريشة صغيرة تحفر ثقباً أولياً لتوجيه مثقاب أكبر)",
 "pilot blacksnake": "ثعبان أسود, ثعبان الجرذ الأسود (ثعبان أسود لامع كبير غير سام من أمريكا الشمالية)",
 "pilot boat": "قارب المرشد (قارب لنقل المرشدين من وإلى السفن الكبيرة)",
 "pilot bread": "بقسماط السفينة, خبز البحارة (بسكويت أو خبز صلب جداً غير مملح؛ كان غذاءً أساسياً في السفن قديماً)",
 "pilot burner": "شعلة إرشادية, شعلة دليل (موقد غاز مساعد صغير يوفر لهباً لإشعال موقد غاز أكبر)",
 "pilot chart": "خريطة بحرية (خريطة للملاح تظهر الظروف الجوية والهيدروغرافية والملاحية السائدة)",
 "pilot cloth": "قماش أزرق ثقيل, قماش البحارة (قماش أزرق سميك يستخدم لصنع المعاطف والسترات للبحارة وغيرهم)",
 "pilot engine": "قاطرة استكشافية (قاطرة تسبق القطار لفحص المسار)",
 "pilot experiment": "تجربة أولية, تجربة استطلاعية (تجربة أولية يمكن أن تؤدي نتيجتها إلى تجربة أكثر شمولاً)",
 "pilot film": "حلقة تجريبية (برنامج يمثل نموذجاً لسلسلة مقترحة؛ يهدف إلى جذب الرعاة)",
 "pilot ladder": "سلم حبلي ((في الملاحة) سلم معلق من الحبال أو السلاسل يدعم درجات خشبية أو معدنية)",
 "pilot lamp": "مصباح بيان (مؤشر يتكون من ضوء للإشارة إلى ما إذا كانت الطاقة قيد التشغيل أو المحرك قيد التشغيل)",
 "pilot light": "شعلة إرشادية, شعلة دليل (موقد غاز مساعد صغير يوفر لهباً لإشعال موقد غاز أكبر) / مصباح بيان (مؤشر يتكون من ضوء للإشارة إلى ما إذا كانت الطاقة قيد التشغيل أو المحرك قيد التشغيل)",
 "pilot program": "مشروع تجريبي, مشروع ريادي (نشاط مخطط كاختبار أو تجربة) / حلقة تجريبية (برنامج يمثل نموذجاً لسلسلة مقترحة؛ يهدف إلى جذب الرعاة)\nمثال: مولوا مشروعاً تجريبياً في ست ولايات",
 "pilot project": "مشروع تجريبي, مشروع ريادي (نشاط مخطط كاختبار أو تجربة)\nمثال: مولوا مشروعاً تجريبياً في ست ولايات",
 "pilot whale": "حوت طيار (حوت صغير داكن اللون يعيش في ساحل المحيط الأطلسي للولايات المتحدة؛ يعمل الذكر الأكبر كطيار أو قائد للسرب)",
 "pilotage": "إرشاد, قيادة (مهنة الطيار أو المرشد البحري) / توجيه, ملاحة (توجيه السفن أو الطائرات من مكان إلى آخر)",
 "pilotfish": "سمكة الدليل (سمكة صغيرة تعيش في عرض البحر ترافق غالباً أسماك القرش أو المانتا)",
 "pilothouse": "غرفة القيادة, قمرة القيادة (مقصورة مغلقة يمكن من خلالها توجيه السفينة)",
 "piloting": "إرشاد, قيادة (مهنة الطيار أو المرشد البحري) / توجيه, ملاحة (توجيه السفن أو الطائرات من مكان إلى آخر)",
 "pilotless": "بِلَا طَيَّار (يفتقر إلى طيار)",
 "pilotless aircraft": "درون, طائرة بدون طيار (طائرة بدون طيار يتم تشغيلها بواسطة التحكم عن بعد)",
 "pilous": "ذُو وَبَر نَاعِم, مُشَعَّر (مغطى بشعيرات خاصة الناعمة والرقيقة منها)",
 "pilsener": "بلسنر (بيرة لاغر شاحبة بنكهة قوية من حشيشة الدينار؛ خُمرت لأول مرة في مدينة بلزن البوهيمية)",
 "pilsner": "بلسنر (بيرة لاغر شاحبة بنكهة قوية من حشيشة الدينار؛ خُمرت لأول مرة في مدينة بلزن البوهيمية)",
 "piltdown hoax": "إنسان بلتداون (إنسان بدائي مزعوم ثبت لاحقاً أنه خدعة)",
 "piltdown man": "إنسان بلتداون (إنسان بدائي مزعوم ثبت لاحقاً أنه خدعة)",
 "pilularia globulifera": "بيلولاريا, عشبة الحبوب (سرخس مائي أوروبي يوجد حول هوامش المسطحات المائية أو في التربة الحمضية الرطبة ذو أكياس بوغية كروية صغيرة)",
 "pilus": "شعيرة (بنية تشبه الشعر خاصة على سطح خلية أو كائن دقيق) / شعر, شعرة (أي من الخيوط الأسطوانية التي تنمو بشكل مميز من بشرة الثدييات)\nمثال: توجد شعرة في حسائي",
 "pim": "أداة إدارة المعلومات الشخصية, مدير المعلومات الشخصية (نوع من البرامج التطبيقية يعمل كمنظم شخصي)\nمثال: بصفتها أداة لإدارة المعلومات، فإن الغرض من أداة إدارة المعلومات الشخصية هو تسهيل تسجيل وتتبع وإدارة أنواع معينة من 'المعلومات الشخصية'",
 "pim tool": "أداة إدارة المعلومات الشخصية, مدير المعلومات الشخصية (نوع من البرامج التطبيقية يعمل كمنظم شخصي)\nمثال: بصفتها أداة لإدارة المعلومات، فإن الغرض من أداة إدارة المعلومات الشخصية هو تسهيل تسجيل وتتبع وإدارة أنواع معينة من 'المعلومات الشخصية'",
 "pima": "لغة بيما (لغة يوتو-أزتيكية يتحدث بها شعب بيما) / بيما (فرد من شعب الهنود في أمريكا الشمالية يعيش في جنوب أريزونا وشمال المكسيك)",
 "pima language": "لغة بيما (لغة يوتو-أزتيكية يتحدث بها شعب بيما)",
 "pimenta acris": "شجرة الباي, شجرة رم الباي (شجرة من جزر الهند الغربية؛ مصدر لرم الباي)",
 "pimenta dioica": "شجرة البهار, فلفل إفرنجي (شجرة عطرية من جزر الهند الغربية تنتج حبوب الفلفل الإفرنجي (البهار))",
 "pimenta officinalis": "شجرة البهار الطبية (شجرة استوائية أمريكية لها زهور بيضاء صغيرة وتوت عطري)",
 "pimento": "فُلْفُل حُلُو (حَبّ حريف يوضع في الطعام أو يطحن يستخدم كتابل. يكون منه أسود أو أبيض، حرارته متوسطة؛ فُلْفُل حَارّ: نبات ثمره حريف لونه أخضر وقد يحمرّ شديد الحرارة. يؤكل كما هو أو يجفف ويطحن ويستخدم كتابل)\nمثال: نحب الفلفل الحار.",
 "pimento butter": "زبدة الفليفلة (زبدة ممزوجة بالفليفلة المهروسة)",
 "pimento tree": "شجرة البهار, فلفل إفرنجي (شجرة عطرية من جزر الهند الغربية تنتج حبوب الفلفل الإفرنجي (البهار))",
 "pimiento": "فليفلة (فلفل أحمر حلو ناضج تماماً؛ عادة ما يطبخ) / بابريكا, فلفل حلو (نبات يحمل ثماراً كبيرة معتدلة سميكة الجدران عادة ما تكون على شكل جرس؛ فلفل السلطة الرئيسي)",
 "pimozide": "بيموزيد (أكثر أنواع ثنائي فينيل بوتيل بيبيريدين استخداماً)",
 "pimp": "قَوَّاد, عرص / قَادَ, قَوَّدَ",
 "pimpernel": "أَنَاغَالِس, أُذْن الفَأْر",
 "pimpinella anisum": "يانسون (موطنه مصر ولكنه يزرع على نطاق واسع لبذوره العطرية والزيت المستخرج منها المستخدم طبياً وكمنكه في الطبخ)",
 "pimping": "قِوَادَة",
 "pimple": "بَثْرَة, بَثْر",
 "pimpled": "حَبِيبِيّ, مُبَثَّر ((للبشرة) مشوَّه بعيوب جلدية)",
 "pimply": "حَبِيبِيّ, مُبَثَّر ((للبشرة) مشوَّه بعيوب جلدية)",
 "pin": "دَبُّوس",
 "pin bone": "عظم الدبوس (جزء من السيرلوين بين العظم المسطح والبورترهاوس)",
 "pin cherry": "كرز الدبوس (كرز بري شجيري صغير من أمريكا الشمالية بفاكهة حمضية حمراء زاهية صغيرة)",
 "pin clover": "رقمة شوكرانية, منقار اللقلق أحمر الساق (عشب ضار أوروبي توطن في جنوب غرب الولايات المتحدة والمكسيك له سيقان منبطحة محمرة بأوراق صغيرة تشبه السرخس وزهور صغيرة خزامية حمراء عميقة تليها ثمار…)",
 "pin curl": "لَفَّة شَعْر (تجعيدة شعر تصنع بترطيب خصلة شعر ولفها وتثبيتها بمشبك)",
 "pin grass": "رقمة شوكرانية, منقار اللقلق أحمر الساق (عشب ضار أوروبي توطن في جنوب غرب الولايات المتحدة والمكسيك له سيقان منبطحة محمرة بأوراق صغيرة تشبه السرخس وزهور صغيرة خزامية حمراء عميقة تليها ثمار…)",
 "pin money": "مصروف الجيب (نقد للإنفاق اليومي على المصاريف العرضية)",
 "pin number": "الرقم السري, رقم التعريف الشخصي (رقم تختاره وتستخدمه للوصول إلى حسابات مختلفة)",
 "pin oak": "بلوط الغار (بلوط كبير شبه دائم الخضرة تقريباً من جنوب شرق الولايات المتحدة؛ يزدهر في التربة الرطبة) / بلوط المستنقعات, بلوط دبوسي (شجرة متساقطة الأوراق هرمية سريعة النمو متوسطة إلى كبيرة من شمال شرق الولايات المتحدة وجنوب شرق كندا لها أوراق ريشية عميقة تتحول إلى الأحمر الساطع في…)",
 "pin table": "آلة الكرة والدبابيس, بينبول (معدات ألعاب تلعب عليها لعبة الكرة والدبابيس)\nمثال: في بريطانيا يسمون آلة الكرة والدبابيس 'طاولة الدبابيس'",
 "pin tumbler": "مسمار القفل (ريش قفل أسطوانية تتكون من جزأين يتم تثبيتهما في مكانهما بواسطة نوابض؛ عندما تتم محاذاتها بمفتاح يمكن تحريك اللسان)",
 "pin wrench": "مفتاح مسماري (مفتاح ربط به مسمار بارز يتناسب مع تجويف على الشيء المراد تدويره)",
 "pin-tailed duck": "بط بلبول, بلبول (بط نهري طويل العنق من العالم القديم والجديد له ريش ذيل مركزي ممدود)",
 "pin-tailed grouse": "قطا دبوسي الذيل, قطا عراقي (قطا من أوروبا وأفريقيا ذو ريش ذيل أوسط طويل)",
 "pin-tailed sandgrouse": "قطا دبوسي الذيل, قطا عراقي (قطا من أوروبا وأفريقيا ذو ريش ذيل أوسط طويل)",
 "pin-up": "فتاة الغلاف (فتاة جميلة جداً تعمل كعارضة للمصورين)",
 "pina cloth": "قماش البينا (قماش ناعم مصنوع من ألياف الأناناس)",
 "pina colada": "بينا كولادا (مشروب مخلوط مصنوع من عصير الأناناس وكريمة جوز الهند والرم)",
 "pinafore": "فستان بلا أكمام, مريول (فستان بلا أكمام يشبه المئزر؛ يلبس فوق ملابس أخرى)",
 "pinata": "بنياتا (لعبة تتكون من حاوية مليئة بالألعاب والحلوى؛ تعلق من ارتفاع ليقوم الأطفال معصوبو الأعين بكسرها بالعصي)",
 "pinball": "الكرة والدبابيس, بينبول (لعبة تُلعب على لوحة مائلة؛ والهدف هو دفع كرات الرخام ضد الدبابيس أو في الجيوب)",
 "pinball game": "الكرة والدبابيس, بينبول (لعبة تُلعب على لوحة مائلة؛ والهدف هو دفع كرات الرخام ضد الدبابيس أو في الجيوب)",
 "pinball machine": "آلة الكرة والدبابيس, بينبول (معدات ألعاب تلعب عليها لعبة الكرة والدبابيس)\nمثال: في بريطانيا يسمون آلة الكرة والدبابيس 'طاولة الدبابيس'",
 "pince-nez": "نظارة مشبك الأنف (نظارات تُثبت على الأنف بواسطة زنبرك)",
 "pincer": "كلاب, مخلب (هيكل للإمساك على طرف القشريات أو مفصليات الأرجل الأخرى) / كماشة, ملقط (أداة يدوية للإمساك تتكون من رافعة مركبة للقبض)",
 "pincers": "كَلْبَتَان",
 "pinch": "قَرَصَ / قَرْصَة",
