 "portuguese escudo": "إسكودو, إسكودو برتغالي (سابقاً وحدة المال الأساسية في البرتغال؛ تساوي 100 سنتافو)",
 "portuguese heath": "خلنج إسباني, خلنج برتغالي (شجيرة كثيفة منتصبة موطنها غرب شبه الجزيرة الأيبيرية ذات زهور بيضاء أو وردية غزيرة؛ متوطنة في جنوب غرب إنجلترا)",
 "portuguese language": "اللغة البرتغالية (اللغة الرومانسية التي يتم التحدث بها في البرتغال والبرازيل)",
 "portuguese man-of-war": "رجل الحرب البرتغالي (سحاري كبير له عوامة تشبه المثانة ومجسات لاسعة)",
 "portuguese monetary unit": "وحدة نقدية برتغالية (الوحدة النقدية في البرتغال)",
 "portuguese republic": "الْجُمْهُورِيَّة الْبُرْتُغَالِيَّة",
 "portugueseness": "الطابع البرتغالي (الجودة أو الحالة لكون الشيء برتغالياً)",
 "portulaca": "بقلة, رجلة",
 "portulaca grandiflora": "بقلة الزهور, رجلة الزهور (تزرع على نطاق واسع في العديد من الأصناف لأوراقها اللحمية التي تشبه الطحالب ووفرة زهورها زاهية الألوان)",
 "portulaca oleracea": "بقلة, رجلة (عشبة زاحفة تشكل حصيرة ذات أزهار صفراء زاهية تزرع لأوراقها الصالحة للأكل ذات الطعم الحمضي الخفيف وتؤكل نيئة أو مطبوخة خاصة في المطبخ الهندي واليوناني…)",
 "portunus puber": "سلطعون مخملي (سلطعون السواحل الإنجليزية)",
 "portwatcher": "حارِس المِيناء, مُراقِب المِيناء (حارس يعمل على رصيف الميناء)",
 "porzana porzana": "مرعة رقطاء (طائر مرعة أوراسي يعيش في المستنقعات والأهوار)",
 "pos tagger": "موسّم أقسام الكلام (برنامج توسيم تشير تسمياته إلى قسم الكلام الخاص بالكلمة)",
 "pose": "جِلْسَة, جَلْسَة / تَكَلُّف",
 "posed": "متخذ وضعية (مرتب لأغراض التصوير)",
 "poseidon": "بُوسِيدُون, بُوسَيْدُون",
 "poser": "سُؤَال مُحَيِّر, مُعْضِلَة (سؤال أو مشكلة صعبة أو محيرة بشكل خاص) / عارض, موديل (شخص يتخذ وضعية لمصور أو رسام أو نحات) / متصنع, مدعٍ (شخص يتظاهر عادةً بكونه شيئاً ليس عليه)\nمثال: لم يكن لدى الرئيس وقت ليكون موديلاً لذا عمل الفنان من الصور",
 "poseur": "متصنع, مدعٍ (شخص يتظاهر عادةً بكونه شيئاً ليس عليه)",
 "poseuse": "متصنعة (امرأة متصنعة)",
 "posh": "رَاقٍ, فَاخِر (أَنِيق وَعَصْرِيّ وَمِنَ الطَّبَقَة الرَّفِيعَة)",
 "posing": "جلوس للرسم ((تصوير) فعل اتخاذ وضعية معينة (كما في صورة فوتوغرافية أو لوحة))\nمثال: أراد رسم صورته لكنه لم يستطع توفير الوقت للجلوس للرسم",
 "posit": "افتراض أساسي, مسلمة ((منطق) قضية مقبولة على أنها صحيحة لتوفير أساس للتفكير المنطقي)",
 "position": "مَوْقِع, مَكَان (موضع الوُقُوع؛ الموضع الذي حَدَثَ أو يحدث فيه حادث) / مَنْصِب / مَكَانَة, رُتْبَة / رَأْي, مَوْقِف / جِلْسَة, وَقْفَة\nمثال: هنا موقع الحادث.",
 "position effect": "تأثير الموقع ((في علم الوراثة) التأثير على تعبير الجين الناتج عن تغيير موقعه في الكروموسوم)",
 "position paper": "مذكرة إيضاحية, ورقة موقف (مذكرة تلخص بنود اتفاقية (تستخدم خاصة في المراسلات الدبلوماسية)) / ورقة موقف (تقرير يشرح أو يبرر أو يوصي بسياسة معينة)",
 "positionable": "قابل للتموضع (قادر على أن يوضع في موضع معين)",
 "positional": "موضعي, موقعي (مكون من أو متعلق بـ أو محدد بالموضع)",
 "positional notation": "تدوين موضعي, نظام تمثيل موضعي (نظام عد يتم فيه تمثيل العدد الحقيقي بمجموعة مرتبة من الأحرف حيث تعتمد قيمة الحرف على موضعه)",
 "positional representation system": "تدوين موضعي, نظام تمثيل موضعي (نظام عد يتم فيه تمثيل العدد الحقيقي بمجموعة مرتبة من الأحرف حيث تعتمد قيمة الحرف على موضعه)",
 "positioner": "محدد الموضع, مشغل دوار ((في علم الحاسوب) المشغل الذي يحرك رأس القراءة/الكتابة إلى مسار البيانات المناسب) / ضابط وضع, محدد موضع (جهاز يستخدم للتحكم في فتح أو إغلاق المشغل بناءً على إشارات كهربائية أو هوائية)",
 "positioning": "تحديد الموقع, تمركز (فعل وضع شيء ما في مكان معين) / مُحَاذٍ, مُوَضِّع (يجعل الأشياء تنتظم في صف أو في موضعها)",
 "positive": "مُوجَب / إِيجَابِيّ / صُورَة مُوجَبَة",
 "positive adverb": "ظرف مجرد (حالة الظرف التي تشير إلى الكيفية البسيطة دون مقارنة أو علاقة زيادة أو نقصان)",
 "positive balance": "رَصِيد دَائِن, رَصِيد مُوجَب (رصيد حساب تتجاوز فيه الاعتمادات (الإيداعات) الديون (المدفوعات)، ويكون البنك مديناً للعميل بالمال)",
 "positive charge": "شحنة موجبة (وجود نقص في الإلكترونات؛ وجود جهد كهربائي أعلى)",
 "positive chemotaxis": "انتحاء كيميائي إيجابي (حركة تجاه محفز كيميائي)",
 "positive correlation": "ارتباط طردي, ارتباط موجب (ارتباط ترتبط فيه القيم الكبيرة لمتغير واحد بقيم كبيرة للآخر والصغيرة بالصغيرة)",
 "positive degree": "درجة إيجابية, صيغة مجردة (الشكل الأساسي للصفة أو الظرف؛ يدل على صفة دون تحديد أو مقارنة أو زيادة أو نقصان)",
 "positive economics": "اقتصاد إيجابي (فرع الاقتصاد الذي يهتم بوصف وشرح الظواهر الاقتصادية)",
 "positive feedback": "تغذية راجعة إيجابية (تغذية راجعة في نفس طور المدخلات (تعمل على زيادتها))",
 "positive fraud": "غش فعلي (خداع فعلي؛ إخفاء شيء ما أو تقديم عرض كاذب بنية شريرة لإلحاق الضرر بشخص آخر)",
 "positive identification": "إثبات هوية مؤكد, تحديد هوية إيجابي (دليل يثبت أنك من تدعي أنك هو؛ دليل يثبت أنك ضمن مجموعة من الأشخاص المعروفين بالفعل للنظام؛ التعرف من قبل النظام يؤدي إلى القبول)\nمثال: نظام لتحديد الهوية الإيجابي يمكن أن يمنع استخدام هوية واحدة من قبل عدة أشخاص",
 "positive magnetic pole": "قطب شمالي, قطب مغناطيسي موجب (قطب المغناطيس الذي يشير نحو الشمال عند تعليق المغناطيس بحرية)",
 "positive muon": "نَقِيض المِيُون (الجسيم المضاد للميون؛ يتحلل إلى بوزيترون ونيوترينو ونقيض النيوترينو)",
 "positive number": "عَدَد مُوجَب (مِقْدَار مَا يُعَدّ)\nمثال: كم عدد سكان الجزائر؟",
 "positive pole": "قطب شمالي, قطب مغناطيسي موجب (قطب المغناطيس الذي يشير نحو الشمال عند تعليق المغناطيس بحرية) / قطب موجب (طرف البطارية المتصل باللوح الموجب)",
 "positive reinforcer": "مثير معزز إيجابي, معزز إيجابي (مثير معزز يعمل على زيادة احتمالية الاستجابة التي تنتجه)",
 "positive reinforcing stimulus": "مثير معزز إيجابي, معزز إيجابي (مثير معزز يعمل على زيادة احتمالية الاستجابة التي تنتجه)",
 "positive stimulus": "مثير إيجابي (مثير له عواقب مرغوبة)",
 "positive-degree adverb": "ظرف مجرد (حالة الظرف التي تشير إلى الكيفية البسيطة دون مقارنة أو علاقة زيادة أو نقصان)",
 "positively": "تماماً, قطعاً (بشكل مطلق) / بإيجابية (بطريقة إيجابية)\nمثال: كان هائلاً قطعاً",
 "positively charged": "إِيجَابِيّ, مُوجَب الشِّحْنَة (ذو شحنة كهربائيّة موجبة)",
 "positiveness": "عَدَم قَابِلِيَّة الدَّحْض, قَطْعِيَّة (صفة كون الشيء غير قابل للإنكار ولا يستحق الجدال حوله) / إيجابية (كمية أكبر من الصفر) / إِيجَابِيَّة, مُوَاتَاة (صفة كون الشيء مشجعاً أو مبشراً بنتيجة ناجحة) / إِيجَابِيَّة, يَقِين (صفة أو حالة تتميز باليقين أو القبول أو التأكيد والتوكيد الجازم)",
 "positivism": "إِيجَابِيَّة, يَقِين (صفة أو حالة تتميز باليقين أو القبول أو التأكيد والتوكيد الجازم) / وضعية, وضعية منطقية (شكل التجريبية الذي يبني كل المعرفة على التجربة الإدراكية (وليس على الحدس أو الوحي))",
 "positivist": "وَاقِعِيّ",
 "positivistic": "وضعي (مكون من أو متعلق بالفلسفة الوضعية)\nمثال: مفكرون وضعيون",
 "positivity": "عَدَم قَابِلِيَّة الدَّحْض, قَطْعِيَّة (صفة كون الشيء غير قابل للإنكار ولا يستحق الجدال حوله) / إيجابية (كمية أكبر من الصفر) / إِيجَابِيَّة, مُوَاتَاة (صفة كون الشيء مشجعاً أو مبشراً بنتيجة ناجحة) / إِيجَابِيَّة, يَقِين (صفة أو حالة تتميز باليقين أو القبول أو التأكيد والتوكيد الجازم)",
 "positron": "بُوزِيتْرُون",
 "positron emission tomography": "تصوير مقطعي بالإصدار البوزيتروني (استخدام تقنية تصوير إشعاعي محوسبة لفحص النشاط الأيضي في أنسجة مختلفة (خاصة في الدماغ))",
 "positron emission tomography scanner": "ماسح التصوير المقطعي بالإصدار البوزيتروني (جهاز تصوير مقطعي ينتج صور أشعة سينية مقطعية للعمليات الأيضية في الجسم)",
 "posology": "علم الجرعات (التحديد الدوائي للجرعات المناسبة من العقاقير والأدوية)",
 "posse": "فرقة مطاردة (قوة شرطة مؤقتة)",
 "posse comitatus": "فرقة مطاردة (قوة شرطة مؤقتة)",
 "posseman": "عضو في فرقة المطاردة (رجل قادر بدنياً يخدم كعضو في فرقة مطاردة)",
 "possess": "مَلَكَ, اِمْتَلَكَ (لغة في المَالِك، وهو الذي يَمْلِكُ؛ السُلْطَان الحَاكِم الذي يملك الأَرْض والبِلاد)\nمثال: زيري ملك لنفسه.",
 "possessed": "مجنون, مَلْبُوس",
 "possession": "مَسّ, تَلَبُّس / مُمْتَلَك / حَوْزَة, مُلْكِيّة / اِسْتِحْوَاذ / حِيَازَة",
 "possessive": "تَمَلُكِي, صِيغَةُ اْلتَمَلُكِ",
 "possessive case": "حالة الإضافة, حالة الملكية (الحالة التي تعبر عن الملكية)",
 "possessive pronoun": "ضمير ملكية (ضمير يشير إلى الملكية، مثل 'لي'، 'لك'، 'لها')",
 "possessively": "بتملك (بطريقة تملك)\nمثال: كان نائماً، وإحدى ذراعيه ملقاة بتملك عبر زوجته",
 "possessiveness": "تملك, حب التملك (رغبة مفرطة في الامتلاك أو السيطرة)",
 "possessor": "صَاحِب, صَاحِبَة (اَلْمُرَافِق، الْمُلَازِمُ، وَلَا يُقَالُ عُرْفاً إِلَّا لِمَنْ كَثُرَتْ مُلَازَمَتُهُ؛ صَاحِبُ الشَّيْءِ: مَالِكُهُ)\nمثال: من صاحب هذه الأرض؟",
 "posset": "بوسيت (حليب ساخن حلو ومتبل ومخثر بالبيرة أو النبيذ)",
 "possibility": "اِحْتِمَال (ما يكمن توقع حدوثه. يقول الجرجاني: «الاحتمال ما لا يكون تصور طرفيه كافيًا، بل يتردد في النسبة بينهما، ويراد به الإمكان الذهني») / إِمْكَانِيَّة\nمثال: هناك احتمال أن لا ينجح.",
 "possible": "مُمْكِن",
 "possible action": "إمكانية, احتمال (بديل ممكن)\nمثال: الإفلاس احتمال دائم",
 "possibleness": "إمكانية, احتمال (القدرة على الوجود أو الحدوث أو الصحة)\nمثال: هناك احتمال أن حاسة الشم لديه قد تضررت",
 "possibly": "رُبَّمَا, لَعَلَّ (عن طريق الصدفة (أو الاحتمال)) / بِأَيّ حَال, بِإِمْكَان (إلى درجة يمكن تحقيقها أو بوسائل ممكنة)\nمثال: ربما ستتصل غداً",
 "possum": "أبوسوم (جرابي شجري ليلي له ذيل قابض عارٍ يوجد من جنوب أمريكا الشمالية إلى شمال أمريكا الجنوبية) / أبوسوم, فلنجر (جرابيات شجرية أسترالية صغيرة ذات فراء ولها ذيول طويلة قابضة عادة)",
 "possum haw": "بهشية نفضية, توت الشتاء (شجيرة نفضية من جنوب شرق ووسط الولايات المتحدة)",
 "possum oak": "بلوط مائي (بلوط مائي متساقط الأوراق طويل نسبياً من جنوب شرق الولايات المتحدة يُزرع غالباً كشجرة ظل؛ يزدهر في التربة الرطبة)",
 "possumwood": "خرمة أمريكية (شجرة متوسطة الحجم في الغابات الجافة في جنوب وشرق الولايات المتحدة تحمل فاكهة صفراء أو برتقالية قابضة جداً تكون صالحة للأكل عندما تنضج تماماً)",
 "post": "عَارِضَة, عَارْضَة / مَنْشوُر, بُوسْت / نَشَرَ, نشر (بَسَطَ، فَرَّقَ، نَشَرَ الشيءَ: جعله منتشراً، مثل نشر الأخبار أو نشر كتاب؛ نَشَرَ: وزع أو عمم شيئًا بين الناس، مثل نشر المقالات)\nمثال: نشر توم الغسيل.",
 "post and lintel": "نظام العتبة والعمود (هيكل يتكون من عوارض رأسية (أعمدة) تدعم عارضة أفقية (عتبة))",
 "post card": "بطاقة بريدية (بطاقة لإرسال الرسائل بالبريد دون ظرف)",
 "post chaise": "عربة البريد السريع (عربة مغلقة تجرها الخيول بأربع عجلات؛ كانت تستخدم سابقاً لنقل الركاب والبريد)",
 "post doc": "باحث ما بعد الدكتوراه (باحث يشارك في دراسة أكاديمية تتجاوز مستوى درجة الدكتوراه) / منحة ما بعد الدكتوراه (منحة تمول دراسة أو بحث ما بعد الدكتوراه)",
 "post exchange": "بي إكس, متجر عسكري (مجمع استهلاكي في موقع للجيش الأمريكي)",
 "post hoc": "مغالطة البعدية (المغالطة المنطقية للاعتقاد بأن التتابع الزمني يعني علاقة سببية)",
 "post hoc ergo propter hoc": "مغالطة البعدية (المغالطة المنطقية للاعتقاد بأن التتابع الزمني يعني علاقة سببية)",
 "post hole": "حفرة العمود (حفرة محفورة في الأرض لتثبيت عمود السياج)",
 "post horn": "بوق البريد (آلة نفخ كان يستخدمها سعاة البريد في القرنين الثامن عشر والتاسع عشر)",
 "post horse": "حصان البريد (حصان يُحفظ في نزل أو مركز بريد لاستخدامه من قبل سعاة البريد أو لتأجيره للمسافرين)",
 "post house": "محطة البريد, نزل البريد (نزل لتبادل خيول البريد واستيعاب الفرسان)",
 "post meridiem": "بَعْد الظُّهْر, مَسَاءً (بين الظهر ومنتصف الليل)\nمثال: لنلتقي في الساعة 8 مساءً",
 "post oak": "بلوط عمودي (شجرة متساقطة الأوراق صغيرة من شرق ووسط الولايات المتحدة لها أوراق ريشية قيثارية خضراء داكنة وخشب قوي مقاوم للرطوبة يستخدم خاصة لأعمدة السياج)",
 "post office": "مَكْتَب الْبَرِيد, بَرِيد (الموضع الذي يُكتَب عليه. بعكس المَكْتَب الذي يكتب فيه؛ مِنْضَدَة مخصصة للكتابة، سواء كانت للمَكَاتِب أم لغيرها) / بَرِيد\nمثال: عاد إلى المكتب.",
 "post road": "طريق البريد (طريق يتم نقل البريد عبره)",
 "post-alveolar": "صوت خلف لثوي ((صوتيات) أي صوت يُنطق باللسان بالقرب من أو يلمس الجزء الخلفي من الحافة اللثوية)",
 "post-alveolar consonant": "صوت خلف لثوي ((صوتيات) أي صوت يُنطق باللسان بالقرب من أو يلمس الجزء الخلفي من الحافة اللثوية)",
 "post-communist": "ما بعد الشيوعية (لم يعد شيوعياً؛ لاحق لكونه شيوعياً)\nمثال: أعلن البنك عن أول قرض له لدولة ما بعد الشيوعية",
 "post-free": "خالص الأجرة البريدية (مدفوع الأجرة البريدية من قبل المرسل) / مُعْفًى مِنْ رَسْمِ البَرِيد (مَدْفُوعُ رَسْمِ البَرِيد)\nمثال: سأرسلها خالصة الأجرة البريدية",
 "post-haste": "بِأَقْصَى سُرْعَة (بأسرع ما يمكن؛ بكل سرعة ممكنة)\nمثال: أرسله لي بأقصى سرعة",
 "post-hole digger": "حفار الأعمدة, حفار الحفر (مجرفة تستخدم لحفر حفر الأعمدة)",
 "post-horse": "حصان البريد (حصان يُحفظ في نزل أو مركز بريد لاستخدامه من قبل سعاة البريد أو لتأجيره للمسافرين)",
 "post-impressionism": "ما بعد الانطباعية (في الرسم الغربي، حركة في فرنسا مثلت امتداداً للانطباعية ورفضاً للقيود المتأصلة في ذلك الأسلوب)",
 "post-impressionist": "ما بعد انطباعي (فنان من مدرسة ما بعد الانطباعية التي ثارت ضد الانطباعية)",
 "post-it": "ورق ملاحظات لاصق (اسم تجاري لقصاصة من ورق الملاحظات تحتوي على مادة لاصقة تسمح لها بالالتصاق بسطح وإزالتها دون الإضرار بالسطح)",
 "post-it note": "ورقة لاصقة",
 "post-maturity": "سن اليأس, ما بعد النضج (الحالة التي تتوقف فيها النساء عن الإباضة)",
 "post-menopause": "سن اليأس, ما بعد النضج (الحالة التي تتوقف فيها النساء عن الإباضة)",
 "post-mortem": "تشريح الجثة, فحص ما بعد الوفاة (فحص وتشريح جثة ميت لتحديد سبب الوفاة أو التغيرات الناتجة عن المرض) / تحليل لاحق, مراجعة ما بعد الحدث (مناقشة لحدث ما بعد وقوعه)",
 "post-mortem examination": "تشريح الجثة, فحص ما بعد الوفاة (فحص وتشريح جثة ميت لتحديد سبب الوفاة أو التغيرات الناتجة عن المرض)",
 "post-obit bond": "سند يدفع بعد الوفاة (سند يحرره شخص سيرث لضمان قرض؛ يدفع من ميراثه)",
 "post-office box": "صندوق بريد (حجرة مرقمة في مكتب بريد حيث يتم وضع البريد لاستلامه)",
 "post-office box number": "رقم صندوق البريد (رقم صندوق رسائل في مكتب البريد حيث يتم جمع البريد)",
 "post-paid": "خالص الأجرة البريدية (مدفوع الأجرة البريدية من قبل المرسل)\nمثال: سأرسلها خالصة الأجرة البريدية",
 "post-rotational nystagmus": "رأرأة ما بعد الدوران (رأرأة ناجمة عن التوقف المفاجئ للدوران السريع للجسم؛ تكون الحركات البطيئة الكبيرة لمقل العيون في الاتجاه المعاكس لاتجاه الدوران)",
 "post-traumatic embitterment disorder": "اِضْطِرَاب الْكَدَر التَّالِيّ لِلصَّدْمَة",
 "post-traumatic stress disorder": "اِضْطِرَاب الْكَرْب التَّالِيّ لِلصَّدْمَة النَّفْسِيَّة",
 "postage": "طابع, طابع بريد (رمز لاصق صغير يوضع على رسالة أو طرد للإشارة إلى أن رسوم البريد قد دُفعت) / رسوم بريدية (الرسم لإرسال شيء بالبريد)",
 "postage franking": "تخليص بريدي (طوابع بريدية، أو أي علامات أخرى معترف بها ومقبولة من قبل النظام البريدي أو الأنظمة التي تقدم الخدمة، والتي تشير إلى دفع رسوم كافية لفئة الخدمة التي…)",
 "postage meter": "عداد البريد (عداد للبريد بالجملة يطبع رسوم البريد المدفوعة مسبقاً الصحيحة على قطع البريد ويسجل التكلفة الإجمالية)",
 "postage stamp": "طَابِع, طَابِع بَرِيدِيّ",
 "postal": "بَرِيدِيّ",
 "postal address": "عُنْوَان بَرِيدِيّ, عِنْوَان بَرِيدِيّ (عُنْوَان)\nمثال: نسيت عنوان توم.",
 "postal card": "بطاقة بريدية (بطاقة لإرسال الرسائل بالبريد دون ظرف)",
 "postal clerk": "موظف بريد (كاتب في مكتب البريد)",
 "postal code": "الرمز البريدي (رمز من الحروف والأرقام يُضاف إلى العنوان البريدي للمساعدة في فرز البريد)",
 "postal order": "حوالة بريدية (أمر مكتوب بدفع مبلغ لفرد مسمى؛ يمكن الحصول عليه وصرفه في مكتب البريد)",
 "postal rate commission": "لجنة الأسعار البريدية (وكالة فيدرالية مستقلة توصي بتغييرات في أسعار البريد)",
 "postal service": "بريد, خدمة بريدية (النظام الذي يتم بموجبه نقل الرسائل عبر مكتب البريد)\nمثال: يتعامل البريد مع مليارات العناصر كل يوم",
 "postalveolar": "لِثَوِيّ غَارِيّ",
 "postalveolar consonant": "صوت خلف لثوي ((صوتيات) أي صوت يُنطق باللسان بالقرب من أو يلمس الجزء الخلفي من الحافة اللثوية)",
 "postbag": "حقيبة بريد (حقيبة كتف يحملها ساعي البريد)",
 "postbiblical": "ما بعد التوراة, ما بعد الكتاب المقدس (لاحق للعصور التوراتية)",
 "postbox": "صندوق بريد (صندوق عام لإيداع البريد)",
 "postcard": "كَرْت بَرِيدِيّ",
 "postcava": "وريد أجوف سفلي (يتلقى الدم من الأطراف السفلية وأعضاء البطن ويصب في الجزء الخلفي من الأذين الأيمن للقلب؛ يتكون من اتحاد الوريدين الحرقفيين)",
 "postcentral gyrus": "تلفيف خلف المركزي (تلفيف الفص الجداري الذي يحده من الأمام التلم المركزي)",
 "postcode": "رَمْز بَرِيدِيّ (رمز (جمعه رموز)؛ الرمز يعني الرسم الذي يعبر عن شيء معين وعموما فأن العلامة ينبغي نقل رسالتها بنظرة واحدة دون الحاجة للكلمات)\nمثال: تمثال الحرية رمز لأمريكا.",
 "postdiluvian": "ما بعد الطوفان (موجود أو يحدث بعد طوفان نوح) / ما بعد الطوفان (أي شيء يعيش بعد طوفان نوح)",
 "postdoc": "باحث ما بعد الدكتوراه (باحث يشارك في دراسة أكاديمية تتجاوز مستوى درجة الدكتوراه) / منحة ما بعد الدكتوراه (منحة تمول دراسة أو بحث ما بعد الدكتوراه)",
 "postdoctoral": "ما بعد الدكتوراه (مكون من أو متعلق بالدراسة أو البحث الذي يتم بعد إتمام درجة الدكتوراه) / منحة ما بعد الدكتوراه (منحة تمول دراسة أو بحث ما بعد الدكتوراه)",
 "poste restante": "بريد الحفظ, بريد مكاتيب (ملاحظة مكتوبة على البريد الذي سيتم الاحتفاظ به في مكتب البريد حتى يتم طلبه (ليس في الولايات المتحدة أو كندا)) / بريد عام, تسليم في المكتب (جزء من مكتب البريد يتعامل مع البريد للأشخاص الذين يطلبونه)",
 "posted": "معلن, منشور (معروض علناً)\nمثال: السرعة القصوى المعلنة",
 "poster": "مُلْصَق, أَفِيش",
 "poster board": "لوح ورقي, ورق ملصقات (ورق مقوى مناسب لعمل الملصقات)",
 "poster boy": "فتى الملصق (طفل ملصق ذكر)",
 "poster child": "رمز, طفل الملصق (طفل مصاب بمرض أو تشوه تستخدم صورته على الملصقات لجمع التبرعات لأغراض خيرية)\nمثال: كانت طفلة الملصق لضمور العضلات",
 "poster color": "ألوان الملصقات, تمبرا (صبغة ممزوجة بمواد غلوتينية قابلة للذوبان في الماء مثل الغراء وصفار البيض)",
 "poster colour": "ألوان الملصقات, تمبرا (صبغة ممزوجة بمواد غلوتينية قابلة للذوبان في الماء مثل الغراء وصفار البيض)",
 "poster girl": "فتاة الملصق (طفلة ملصق أنثى)",
 "poster paint": "ألوان الملصقات, تمبرا (صبغة ممزوجة بمواد غلوتينية قابلة للذوبان في الماء مثل الغراء وصفار البيض)",
 "posterboard": "لوح ورقي, ورق ملصقات (ورق مقوى مناسب لعمل الملصقات)",
 "posterior": "خَلْفِيّ",
 "posterior cardinal vein": "وريد رئيسي خلفي (قناة تصريف رئيسية من الجزء الذيلي للجسم)",
 "posterior cerebral artery": "شريان مخي خلفي (ينشأ من الشريان القاعدي؛ وينقسم إلى ثلاثة فروع)",
 "posterior facial vein": "وريد خلف الفك السفلي (الفرع الخلفي للوريد الوجهي؛ يتكون من الأوردة الصدغية أمام الأذن)",
 "posterior horn": "جذر خلفي, جذر ظهري (أحد جذري العصب الشوكي الذي يمر ظهرياً من الحبل الشوكي ويتكون من ألياف حسية)",
 "posterior labial veins": "أوردة شفرية خلفية (أوردة تمر خلفياً من الشفرين الكبيرين إلى الوريد الفروجي الداخلي)",
 "posterior meningeal artery": "شريان سحائي خلفي (فرع من الشريان البلعومي الصاعد يغذي الأم الجافية للحفرة القحفية الخلفية)",
 "posterior naris": "منخر خلفي (أي من الفتحتين الخلفيتين في مؤخرة التجويف الأنفي المؤديتين إلى البلعوم الأنفي)",
 "posterior nasal aperture": "منخر خلفي (أي من الفتحتين الخلفيتين في مؤخرة التجويف الأنفي المؤديتين إلى البلعوم الأنفي)",
 "posterior pituitary": "غدة نخامية خلفية, نخامية خلفية (الفص الخلفي للغدة النخامية؛ ذو طبيعة غدية في المقام الأول)",
 "posterior pituitary gland": "غدة نخامية خلفية, نخامية خلفية (الفص الخلفي للغدة النخامية؛ ذو طبيعة غدية في المقام الأول)",
 "posterior root": "جذر خلفي, جذر ظهري (أحد جذري العصب الشوكي الذي يمر ظهرياً من الحبل الشوكي ويتكون من ألياف حسية)",
 "posterior serratus muscle": "منشارية خلفية (عضلة هيكلية تسحب القفص الصدري للخلف وللأسفل)",
 "posterior subcapsular cataract": "ساد تحت المحفظة الخلفية (ساد في الجزء الخلفي من محفظة العدسة)",
 "posterior synechia": "التصاق خلفي (التصاق بين القزحية والعدسة)",
 "posterior temporal artery": "شريان صدغي خلفي (شريان صدغي يغذي الجزء الخلفي من قشرة الفص الصدغي)",
 "posterior vein of the left ventricle": "وريد البطين الأيسر الخلفي (ينشأ بالقرب من قمة القلب ويصب في الجيب التاجي)",
 "posteriority": "تالية, لاحقية (التتبع في الزمن) / تَأَخُّر, خَلْفِيَّة (صفة الوجود باتجاه الخلف أو باتجاه الطرف الخلفي)",
 "posterity": "الأجيال القادمة, الخَلَف (جميع الأجيال المستقبلية) / أحفاد, ذُرِّيَّة (كل نسل سلف معين)\nمثال: علينا تأمين فوائد الحرية لأنفسنا ولذريتنا",
 "postern": "بوابة خلفية (بوابة صغيرة في الجزء الخلفي من حصن أو قلعة)",
 "postexilic": "ما بعد السبي (مكون من أو متعلق بالفترة في التاريخ اليهودي بعد 539 قبل الميلاد (بعد السبي البابلي))",
 "postfix": "لاحقة (زائدة تضاف في نهاية الكلمة)",
 "postfix notation": "التدوين البولندي العكسي, تدوين لاحق (تدوين خالٍ من الأقواس لتكوين التعبيرات الرياضية يتبع فيه كل معامل المعاملات الخاصة به)",
 "postganglionic": "تالي للعقدة (بعد أو أبعد من عقدة عصبية (يشير خاصة إلى الألياف غير المايلينية التي تنشأ من خلايا في العقد اللاإرادية))",
 "postglacial": "ما بعد الجليدي (متعلق بـ أو يحدث خلال الوقت التالي لفترة جليدية)",
 "postgraduate": "جَامِعِيّ عُلْوِيّ, لِلدِّرَاسَات العُلْيَا (متعلِّق بالدراسات بعد درجة البكالوريوس) / طالب دراسات عليا (طالب يواصل دراسته بعد التخرج)",
 "posthitis": "التهاب القلفة (التهاب قلفة القضيب؛ عادة ما تسببه عدوى بكتيرية)",
 "posthole": "حفرة العمود (حفرة محفورة في الأرض لتثبيت عمود السياج)",
 "posthole digger": "حفار الأعمدة, حفار الحفر (مجرفة تستخدم لحفر حفر الأعمدة)",
 "posthouse": "محطة البريد, نزل البريد (نزل لتبادل خيول البريد واستيعاب الفرسان)",
 "posthumous": "بَعْدَ وَفَاتِيّ (يحدث أو يظهر بعد وفاة الشخص)",
 "posthumous birth": "ولادة بعد وفاة الأم (ولادة طفل بعملية قيصرية بعد وفاة الأم) / ولادة بعد وفاة الأب (ولادة طفل بعد وفاة الأب)",
 "posthumously": "بعد الوفاة (بعد الموت)\nمثال: نُشرت مقطوعات البيانو هذه بعد الوفاة",
 "posthypnotic amnesia": "فقدان ذاكرة ما بعد التنويم (فقدان ذاكرة انتقائي بعد الخروج من حالة التنويم المغناطيسي للأحداث التي وقعت خلاله أو للمعلومات التي حددها المنوم المغناطيسي)",
 "posthypnotic suggestion": "إيحاء ما بعد التنويم (اقتراح يتم تقديمه لشخص تحت التنويم المغناطيسي يحدد إجراءً سيقوم به (عادةً استجابة لإشارة) بعد استيقاظه)",
 "postiche": "زائف, مزيف (شيء هو تزييف؛ ليس كما يبدو) / شعر مستعار, وصلة شعر (غطاء أو خصلة من شعر بشري أو صناعي تستخدم للتنكر أو الزينة)",
 "postictal": "تالي للنوبة (متعلق بالفترة التي تلي نوبة صرع أو تشنج)\nمثال: نحاس تالي للنوبة",
 "postilion": "سائس العربة (شخص يركب الحصان الأيسر من زوج خيول لتوجيه الخيول التي تجر عربة (خاصة عربة بدون حوذي))",
 "postillion": "سائس العربة (شخص يركب الحصان الأيسر من زوج خيول لتوجيه الخيول التي تجر عربة (خاصة عربة بدون حوذي))",
 "postimpressionist": "ما بعد انطباعي (فنان من مدرسة ما بعد الانطباعية التي ثارت ضد الانطباعية)",
 "postindustrial": "مَا بَعْد صِنَاعِيّ (يتعلّق بمجتمع أو اقتصاد يتميّز بتراجع أهمّيّة التصنيع وازدياد الخدمات والمعلومات والبحث)",
 "posting": "إرسال بالبريد (إرسال رسالة عبر البريد) / قيد محاسبي ((مسك الدفاتر) إدراج في سجلات الشركة) / إعلان ورقي, ملصق (لافتة منشورة في مكان عام كإعلان)\nمثال: يشير ختم البريد إلى وقت الإرسال",
 "postlude": "بوستلود, خاتمة موسيقية (مقطوعة حرة تُعزف في نهاية الخدمة الدينية)",
 "postman": "ساعي البريد (رجل يقوم بتوصيل البريد)",
 "postmark": "خَتْم بَرِيدِيّ (أنهى الشيءَ وأتمّه؛ طبع بخاتم أو ختم رسميّ)\nمثال: ختم سامي القرآن في شهر رمضان.",
 "postmaster": "مدير البريد (الشخص المسؤول عن مكتب البريد)",
 "postmaster general": "مدير البريد العام (المسؤول عن الخدمة البريدية الوطنية)",
 "postmature infant": "طفل متأخر الولادة (رضيع يولد بعد 42 أسبوعاً من الحمل؛ عادة ما يظهر علامات قصور المشيمة)"
}
