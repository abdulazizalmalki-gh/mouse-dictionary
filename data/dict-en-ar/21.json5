 "pinnately": "بشكل ريشي (له شكل ريشي (في علم النبات))\nمثال: ورقة مركبة بشكل ريشي",
 "pinnatifid": "رِيشِيّ التَّفْصِيص ((عن شكل الورقة) مشقوق تقريبًا حتّى العرق الأوسط بأقسام عريضة غير منفصلة)",
 "pinnatiped": "زعنفيات الأقدام (ثديي مائي آكل للحوم له جسم انسيابي متخصص للسباحة مع أطراف متحورة كزعانف)",
 "pinnatisect": "رِيشِيّ الِانْقِسَام ((عن شكل الورقة) مشقوق تقريبًا حتّى العرق الأوسط بأقسام ضيّقة غير منفصلة)",
 "pinner": "قلنسوة ذات شريطين (قبعة نسائية ذات طرفين طويلين مثبتين بدبابيس)",
 "pinning": "تثبيت العلاقة (وعد متبادل بين حبيبين بعدم مواعدة أي شخص آخر)",
 "pinniped": "زعنفيات الأقدام (ثديي مائي آكل للحوم له جسم انسيابي متخصص للسباحة مع أطراف متحورة كزعانف)",
 "pinniped mammal": "زعنفيات الأقدام (ثديي مائي آكل للحوم له جسم انسيابي متخصص للسباحة مع أطراف متحورة كزعانف)",
 "pinnotheres ostreum": "سلطعون المحار (سلطعون صغير ناعم الجسم يعيش داخل تجويف عباءة المحار)",
 "pinnule": "ريشة (قسم من ورقة مقسمة ريشياً عادة)",
 "pinny": "فستان بلا أكمام, مريول (فستان بلا أكمام يشبه المئزر؛ يلبس فوق ملابس أخرى)",
 "pinocchio": "بِينُوكْيُو",
 "pinochle": "بينوكل (لعبة ورق تُلعب بحزمة من ثمانية وأربعين ورقة (اثنتان من كل بدلة للأوراق العالية)؛ يشبه اللعب الويست)",
 "pinocle": "بينوكل (لعبة ورق تُلعب بحزمة من ثمانية وأربعين ورقة (اثنتان من كل بدلة للأوراق العالية)؛ يشبه اللعب الويست)",
 "pinocytosis": "احتساء خلوي, شرب خلوي (عملية يمكن للخلايا من خلالها ابتلاع ودمج قطرات من السائل)",
 "pinole": "بينولي (دقيق مصنوع من الذرة المطحونة ناعماً والمخلوطة بالسكر والتوابل)",
 "pinon": "صنوبر بينيون (أي من عدة أنواع من الصنوبر منخفض النمو في غرب أمريكا الشمالية)",
 "pinon nut": "صنوبر (البذرة الصالحة للأكل لأي من عدة أنواع من الصنوبر خاصة بعض أنواع الصنوبر في جنوب غرب أمريكا الشمالية)",
 "pinon pine": "صنوبر الجوز المكسيكي, صنوبر بينيون (بينيون صغير ثنائي أو ثلاثي الإبر من المكسيك وجنوب تكساس)",
 "pinot": "بينو, عنب بينو (أي من عدة أنواع من عنب النبيذ الأرجواني أو الأبيض المستخدم خاصة للبورغندي والشمبانيا)",
 "pinot blanc": "بينو بلان (نبيذ مائدة كاليفورني أبيض جاف مصنوع من عنب بينو الأبيض) / بينو بلان (عنب نبيذ أبيض؛ يزرع خاصة في كاليفورنيا لصنع نبيذ يشبه نبيذ شابلي بفرنسا)",
 "pinot chardonnay": "بينو شاردونيه, شاردونيه (نبيذ مائدة أبيض جاف يشبه الشابلي ولكنه مصنوع من عنب شاردونيه)",
 "pinot grape": "بينو, عنب بينو (أي من عدة أنواع من عنب النبيذ الأرجواني أو الأبيض المستخدم خاصة للبورغندي والشمبانيا)",
 "pinot noir": "بينو نوار (نبيذ مائدة أحمر جاف من كاليفورنيا مصنوع من عنب بينو الأرجواني) / بينو نوار (عنب نبيذ أحمر؛ يزرع خاصة في كاليفورنيا لصنع نبيذ يشبه نبيذ بورغوندي بفرنسا)",
 "pinpoint": "رأس الدبوس (النقطة الحادة للدبوس) / ذرة, نقطة صغيرة (بقعة صغيرة جداً) / لحظة خاطفة (لحظة قصيرة جداً)\nمثال: كانت الطائرة مجرد نقطة في السماء",
 "pinprick": "وخزة دبوس (ثقب صغير (كأنه مصنوع بواسطة دبوس)) / إزعاج بسيط, وخزة (انزعاج بسيط)",
 "pins and needles": "خدر وتنميل (إحساس وخز حاد ناتج عن نقص الدورة الدموية)",
 "pinscher": "بينشر (أي من ثلاث سلالات من الكلاب التي عادة ما يتم قص آذانها وذيولها)",
 "pinstripe": "تقليم رفيع, خط رفيع (شريط رفيع جداً (خاصة شريط أبيض على قماش داكن)) / بينسترايب, قماش مقلم (قماش به خطوط رفيعة جداً) / بدلة مقلمة (بدلة مصنوعة من قماش بخطوط رفيعة جداً)",
 "pinstriped": "مُخَطَّط بِخُطُوط رَفِيعَة (ذو خطوط رفيعة جدًّا)",
 "pint": "باينت (وحدة سائلة أمريكية تساوي 16 أونصة سائلة؛ 2 باينت تساوي 1 كوارت) / باينت جاف (وحدة جافة أمريكية تساوي 0.5 كوارت) / باينت (مقياس سعة إمبراطوري بريطاني (سائل أو جاف) يساوي 4 جيلات)",
 "pint-size": "ضَئِيل الحَجْم, قَزَم (أقل بكثير من متوسط الطول)",
 "pint-sized": "ضَئِيل الحَجْم, قَزَم (أقل بكثير من متوسط الطول)",
 "pintado": "بينتادو, سيرو (ماكريل كبير صالح للأكل في المياه الساحلية الأطلسية المعتدلة للولايات المتحدة)",
 "pintail": "بط بلبول, بلبول (بط نهري طويل العنق من العالم القديم والجديد له ريش ذيل مركزي ممدود)",
 "pintle": "مسمار مفصلي (دبوس أو مسمار يشكل محور مفصلة)",
 "pinto": "بينتو (حصان أو مهر مرقط)",
 "pinto bean": "فاصولياء بينتو (فاصولياء مرقطة أو منقطة من جنوب غرب الولايات المتحدة؛ عادة ما تكون مجففة)",
 "pinus albicaulis": "صنوبر أبيض اللحاء (صنوبر صغير من غرب أمريكا الشمالية؛ له لحاء أبيض رمادي أملس وخشب هش ناعم؛ يشبه الصنوبر المرن)",
 "pinus aristata": "صنوبر المخروط الشائك, صنوبر بريستلكون (صنوبر مرتفعات صغير بطيء النمو من غرب الولايات المتحدة (جبال روكي) له فروع كثيفة ولحاء بني صدئ متشقق وإبر قصيرة في حزم من 5 وحراشف مخروطية مدببة…)",
 "pinus attenuata": "صنوبر المخروط المعقد, صنوبر نوبكون (صنوبر متوسط الحجم ثلاثي الإبر من ساحل المحيط الهادئ للولايات المتحدة له عقدة بارزة على كل حرشفة من المخروط)",
 "pinus banksiana": "صنوبر بانكس, صنوبر جاك (صنوبر نحيل متوسط الحجم ثنائي الإبر من شرق أمريكا الشمالية؛ بإبر صفراء خضراء ولحاء حرشفي رمادي إلى أحمر بني متشقق)",
 "pinus californiarum": "بينيون كاليفورنيا أحادي الورقة (شجرة صغيرة جداً تشبه بينيون جبال روكي ولكن لها إبرة واحدة لكل حزمة؛ تشبه بينيون باري في النطاق)",
 "pinus cembra": "صنوبر حجري سويسري, صنوبر سويسري (صنوبر أوروبي كبير خماسي الإبر؛ ينتج مكسرات سيمبرا وإفرازات راتنجية)",
 "pinus cembroides": "صنوبر الجوز المكسيكي, صنوبر بينيون (بينيون صغير ثنائي أو ثلاثي الإبر من المكسيك وجنوب تكساس)",
 "pinus contorta": "صنوبر الشاطئ, صنوبر لودجبول (صنوبر شجيري ثنائي الإبر من الساحل الشمالي الغربي للولايات المتحدة؛ لحاء أحمر إلى أصفر بني متشقق إلى مربعات صغيرة)",
 "pinus contorta murrayana": "صنوبر لودجبول سييرا (نويع طويل من صنوبر لودجبول)",
 "pinus densiflora": "صنوبر أحمر ياباني (صنوبر موطنه اليابان وكوريا له تاج غير منتظم واسع الانتشار عند النضج؛ يزرع للزينة)",
 "pinus echinata": "صنوبر أصفر قصير الأوراق, صنوبر قصير الأوراق (صنوبر كبير من جنوب الولايات المتحدة له إبر قصيرة في حزم من 2-3 ولحاء بني محمر عند النضج)",
 "pinus edulis": "بينيون جبال روكي (بينيون صغير مدمج ثنائي الإبر من جنوب غرب الولايات المتحدة؛ مهم كصنوبر جوز)",
 "pinus flexilis": "صنوبر مرن (صنوبر من غرب أمريكا الشمالية بإبر طويلة وأطراف مرنة جداً ولحاء رمادي داكن مخدد)",
 "pinus glabra": "صنوبر التنوب (صنوبر كبير ثنائي الإبر من جنوب شرق الولايات المتحدة بخشب ناعم خفيف)",
 "pinus jeffreyi": "صنوبر أسود, صنوبر جيفري (صنوبر متناظر طويل من غرب أمريكا الشمالية له إبر زرقاء خضراء طويلة في حزم من 3 ومخاريط ممدودة على فروع منتشرة متدلية نوعاً ما؛ يصنف أحياناً كصنف من…)",
 "pinus longaeva": "صنوبر قديم (صنوبر صغير بطيء النمو من غرب الولايات المتحدة يشبه صنوبر بريستلكون؛ لحاء بني شوكولاتي في صفائح وإبر قصيرة في حزم من 5؛ التاج مخروطي ولكنه يصبح خشناً…)",
 "pinus monophylla": "بينيون أحادي الورقة (بينيون من جنوب غرب الولايات المتحدة له إبر منفردة وغالباً سيقان عديدة؛ مهم كصنوبر جوز)",
 "pinus monticola": "صنوبر أبيض غربي, صنوبر فضي (صنوبر طويل من غرب أمريكا الشمالية بإبر زرقاء خضراء قوية؛ اللحاء رمادي بني بصفائح مستطيلة عند النضج)",
 "pinus mugo": "صنوبر جبلي سويسري, صنوبر موغو (صنوبر شجيري منخفض من وسط أوروبا بإبر خضراء زاهية قصيرة في حزم من اثنتين)",
 "pinus muricata": "صنوبر الأسقف (بينيون ثنائي أو ثلاثي الإبر غالباً من الساحل الشمالي الغربي لكاليفورنيا)",
 "pinus nigra": "صنوبر أسود (صنوبر خشب كبير ثنائي الإبر من جنوب شرق أوروبا)",
 "pinus palustris": "صنوبر أصفر جنوبي, صنوبر طويل الأوراق (صنوبر كبير ثلاثي الإبر من جنوب شرق الولايات المتحدة له إبر طويلة جداً وأطراف ملتوية معقدة؛ اللحاء بني محمر مخدد بعمق؛ شجرة خشب مهمة)",
 "pinus parryana": "بينيون باري",
 "pinus pinea": "صنوبر المظلة, صنوبر ثمري (صنوبر ثنائي الإبر متوسط الحجم من جنوب أوروبا له تاج منتشر؛ يزرع على نطاق واسع لبذوره الحلوة التي تشبه اللوز)",
 "pinus ponderosa": "صنوبر أصفر غربي, صنوبر بونديروسا (صنوبر خشب طويل شائع وواسع الانتشار في غرب أمريكا الشمالية له إبر خضراء داكنة في حزم من 2 إلى 5 ولحاء سميك بصفائح بنية داكنة عند النضج)",
 "pinus pungens": "صنوبر الجبل المسطح, صنوبر شائك (صنوبر مرتفعات صغير ثنائي الإبر من شرق الولايات المتحدة (الأبالاش) له لحاء بني داكن متقشر وحراشف مخروطية مدببة الأشواك)",
 "pinus quadrifolia": "بينيون باري",
 "pinus radiata": "صنوبر مونتيري (صنوبر كاليفورنيا طويل بإبر طويلة في حزم من 3، وتاج كثيف، ولحاء بني داكن متشقق بعمق)",
 "pinus resinosa": "صنوبر أحمر, صنوبر أحمر كندي (صنوبر من شرق أمريكا الشمالية له إبر طويلة في حزم من اثنتين ولحاء محمر)",
 "pinus rigida": "صنوبر القار, صنوبر القار الشمالي (صنوبر كبير ثلاثي الإبر من شرق الولايات المتحدة وجنوب شرق كندا؛ وثيق الصلة بصنوبر البرك)",
 "pinus serotina": "صنوبر البرك (صنوبر كبير ثلاثي الإبر من المستنقعات الرملية بجنوب شرق الولايات المتحدة؛ إبره أطول من تلك الموجودة في صنوبر القار الشمالي)",
 "pinus strobiformis": "صنوبر أبيض جنوبي غربي (صنوبر متوسط الحجم من شمال غرب المكسيك؛ اللحاء بني داكن ومخدد عند النضج)",
 "pinus strobus": "صنوبر أبيض أمريكي, صنوبر أبيض شرقي (صنوبر طويل النمو من شرق أمريكا الشمالية؛ اللحاء بني بشقوق طولية عند النضج؛ يقدر كشجرة خشب)",
 "pinus sylvestris": "صنوبر اسكتلندي, صنوبر بري (صنوبر متوسط الكبر ثنائي الإبر من شمال أوروبا وآسيا له لحاء أحمر بني متقشر)",
 "pinus taeda": "صنوبر اللبان, صنوبر لوبلولي (صنوبر طويل منتشر ثلاثي الإبر من جنوب شرق الولايات المتحدة له لحاء متشقق بني محمر ورأس علوي كثيف ممتلئ)",
 "pinus thunbergii": "صنوبر أسود ياباني (نبات زينة ياباني كبير له إبر طويلة في حزم من 2؛ يزرع على نطاق واسع في الولايات المتحدة لمقاومته للملح والضباب الدخاني)",
 "pinus torreyana": "صنوبر توري (صنوبر متوسط الحجم خماسي الإبر من جنوب غرب كاليفورنيا له مخاريط أسطوانية طويلة)",
 "pinus virginiana": "صنوبر جيرسي, صنوبر فرجينيا (صنوبر شجيري صغير شائع في شرق الولايات المتحدة له فروع متناثرة ملتوية غالباً وإبر قصيرة في حزم من 2)",
 "pinwheel": "دولاب نار, عجلة كاثرين (لعبة نارية دائرية تدور حول نفسها وتطلق نيرانًا ملونة) / دولاب الهواء (لعبة تتكون من ريش من الورق الملون أو البلاستيك مثبتة بدبوس على عصا وتدور عندما توجه نحو الرياح) / عجلة الدبابيس (لعبة) (عجلة بها العديد من الدبابيس المثبتة بزوايا قائمة على حافتها) / أيونيم هاورثي, دولاب الهواء (شجيرة معمرة في تينيريفي ذات أوراق في وريدات تشبه دواليب الهواء)\nمثال: أدار عجلة الدبابيس وتوقفت والمؤشر على 'انطلق'",
 "pinwheel flower": "تفاحة آدم, زهرة الطاحونة (شجيرة استوائية ذات أوراق لامعة وأزهار ليلية عطرة ذات تيجان مجعدة أو متموجة؛ من شمال الهند إلى تايلاند)",
 "pinwheel roll": "لفافة المروحة (لفائف على شكل مروحة مدهونة بالقرفة والسكر ومحشوة بالمربى مثلاً قبل الخبز)",
 "pinwheel wind collector": "دولاب الهواء (لعبة تتكون من ريش من الورق الملون أو البلاستيك مثبتة بدبوس على عصا وتدور عندما توجه نحو الرياح)",
 "pinwheel-shaped": "دُولَابِيُّ الشَّكْل (ذو شكل دائري كالدولاب الهوائي)",
 "pinworm": "دودة خيطية, دودة دبوسية (دودة صغيرة تشبه الخيط تصيب أمعاء الإنسان والمستقيم خاصة عند الأطفال)",
 "pinyin": "بِينْيِن",
 "pinyon": "صنوبر بينيون (أي من عدة أنواع من الصنوبر منخفض النمو في غرب أمريكا الشمالية)",
 "piolet": "فأس جليد (فأس يستخدمها متسلقو الجبال لقطع مواطئ للأقدام في الجليد)",
 "pion": "بِيُون, مِيزُون-باي (ميزون يشارك في تماسك النواة معاً؛ ينتج عن تصادم جسيمات عالي الطاقة)",
 "pioneer": "رَائِد",
 "pious": "صَالِح, وَرِع ((في الإسلام) نبي ورد ذكره في القرآن، أُرسل إلى قوم ثمود؛ اسم شخصي معطًى للذكور من العرب)\nمثال: قم بما هو صالح.",
 "pious platitude": "كلام معسول, نفاق (حديث غير صادق عن الدين أو الأخلاق)",
 "piously": "بِتَدَيُّن, بِتَقْوَى (بطريقة ورعة وتقية)\nمثال: كانت كاثوليكية ورعة",
 "piousness": "تقوى, ورع (الصلاح بحكم كون الشخص تقياً)",
 "pip": "عَجَمَة / عَجَم (خلاف العُرْب والعَرَب، ويشمل كل الأقوام من غيرهم؛ عند البعض من أهل المشرق العربي هم الفُرْس تحديدا من باب إطلاق اسم الكل على البعض)",
 "pip-squeak": "إمّعة, تافه (شخص صغير وغير مهم)",
 "pipa americana": "علجوم سورينام (علجوم من أمريكا الجنوبية؛ يحضن صغاره في حفر في جلد ظهره)",
 "pipa pipa": "علجوم سورينام (علجوم من أمريكا الجنوبية؛ يحضن صغاره في حفر في جلد ظهره)",
 "pipage": "أنبوب, ماسورة (أنبوب طويل مصنوع من المعدن أو البلاستيك يستخدم لنقل الماء أو النفط أو الغاز وما إلى ذلك) / رسوم الأنابيب (رسم يُفرض لاستخدام الأنابيب)",
 "pipal": "بيبال, تين مقدس (شجرة تين من الهند تشتهر بحجمها الكبير وطول عمرها؛ تفتقر إلى الجذور الداعمة للبانيان؛ تعتبر مقدسة لدى البوذيين)",
 "pipal tree": "بيبال, تين مقدس (شجرة تين من الهند تشتهر بحجمها الكبير وطول عمرها؛ تفتقر إلى الجذور الداعمة للبانيان؛ تعتبر مقدسة لدى البوذيين)",
 "pipe": "أُنْبُوبَة",
