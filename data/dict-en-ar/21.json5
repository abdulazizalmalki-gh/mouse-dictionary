 "pfannkuchen": "بان كيك ألماني (خليط بيض منتفخ خفيف الحلاوة بنكهة الليمون مرشوش بسكر الحلواني ويقدم مع المربى أو صلصة النبيذ أو الفاكهة)",
 "pfc": "بيرفلوروكربون (غاز دفيئة قوي ينبعث أثناء إنتاج الألومنيوم)",
 "pfennig": "بفنيغ (100 بفنيغ كانت تساوي سابقاً 1 مارك ألماني)",
 "pflops": "بيتا فلوب ((علم الحاسوب) وحدة لقياس سرعة نظام الحاسوب، تساوي كوادريليون (10 أس 15) عملية نقطة عائمة في الثانية)",
 "ph": "رقم هيدروجيني, مقياس الأس الهيدروجيني (اللوغاريتم لمقلوب تركيز أيون الهيدروجين بالذرات الجرامية لكل لتر؛ يوفر مقياساً من 0 إلى 14 لحموضة أو قلوية محلول (حيث 7 متعادل وأكبر من 7 أكثر قاعدية…)",
 "ph scale": "رقم هيدروجيني, مقياس الأس الهيدروجيني (اللوغاريتم لمقلوب تركيز أيون الهيدروجين بالذرات الجرامية لكل لتر؛ يوفر مقياساً من 0 إلى 14 لحموضة أو قلوية محلول (حيث 7 متعادل وأكبر من 7 أكثر قاعدية…)",
 "ph.d.": "دكتوراه (دكتوراه تعتمد عادةً على 3 سنوات على الأقل من الدراسات العليا وأطروحة؛ وهي أعلى درجة تمنح في الدراسات العليا)",
 "phacelia": "عشبة العقرب, فاسيليا (أي نبات من جنس فاسيليا)",
 "phacelia campanularia": "جريس كاليفورنيا (نبات حولي من جنوب كاليفورنيا بسيقان متفرعة بشكل معقد ونوارات فضفاضة من الزهور العطرية الزرقاء العميقة بوقية الشكل)",
 "phacelia minor": "جريس كاليفورنيا, ويتلافيا (نبات صحراوي من جنوب كاليفورنيا بزهور أنبوبية زرقاء أو بنفسجية في عناقيد طرفية)",
 "phacelia tanacetifolia": "عنق الكمان (نبات حولي زغبي من كاليفورنيا إلى المكسيك بنوارات مزدحمة من الزهور الصغيرة الزرقاء إلى الليلكية أو البنفسجية الفاتحة)",
 "phacelia whitlavia": "جريس كاليفورنيا, ويتلافيا (نبات صحراوي من جنوب كاليفورنيا بزهور أنبوبية زرقاء أو بنفسجية في عناقيد طرفية)",
 "phacoemulsification": "استحلاب العدسة (جراحة الساد خارج المحفظة التي تقوم فيها الموجات فوق الصوتية بتفتيت قشرة ونواة العدسة إلى أجزاء صغيرة يتم شفطها بعد ذلك عبر أنبوب صغير)",
 "phaeochromocytoma": "ورم القواتم (ورم وعائي في الغدة الكظرية)",
 "phaeophyta": "الطحالب البنية, قسم الطحالب البنية",
 "phaeton": "سيارة سياحية (سيارة مفتوحة كبيرة تتسع لأربعة أشخاص مع سقف قابل للطي)",
 "phage": "بكتيريوفاج, عاثية (فيروس يتطفل (يكرر نفسه) داخل البكتيريا)\nمثال: تستخدم العاثية آليات البكتيريا وطاقتها لإنتاج المزيد من العاثيات حتى يتم تدمير البكتيريا وإطلاق العاثيات لغزو البكتيريا المحيطة",
 "phagnalon": "طَعَام الْأَرْنَب (كُلُّ مَا يُؤْكَلُ. مُرادفه أَكْل)\nمثال: ليس لدينا طعام.",
 "phagocyte": "بلعم, خلية بلعمية (خلية تبتلع وتهضم الحطام والكائنات الحية الدقيقة الغازية)",
 "phagocytic": "بلعمي (قادر على العمل كخلية بلعمية)",
 "phagocytosis": "بلعمة (عملية تقوم فيها الخلايا البلعمية بابتلاع وهضم الكائنات الحية الدقيقة والحطام الخلوي؛ دفاع مهم ضد العدوى)",
 "phagun": "فالغونا (الشهر الثاني عشر من التقويم الهندوسي)",
 "phaius": "فايوس (أوركيد من جنس فايوس ذو أوراق مطوية كبيرة وعناقيد من الزهور المبهرجة)",
 "phalacrocorax carbo": "غاق (طائر بحري كبير شره داكن اللون طويل العنق ذو كيس قابل للتمدد لحمل الأسماك؛ يستخدم في آسيا لصيد الأسماك)",
 "phalacrosis": "صلع (حالة عدم وجود شعر في أعلى الرأس)",
 "phalaenopsis amabilis": "سحلب الفراشة, فالاينوبسيس (سحلب له أوراق لحمية كبيرة بيضاوية إلى بيضاوية مقلوبة وزهور وردية وبيضاء عطرة منقطة بالأحمر)",
 "phalaenoptilus nuttallii": "طائر المسكين (سبد من غرب أمريكا الشمالية)",
 "phalangeal": "سلامي (مكون من أو متعلق بعظام الأصابع أو أصابع القدم (السلاميات))",
 "phalanger": "أبوسوم, فلنجر (جرابيات شجرية أسترالية صغيرة ذات فراء ولها ذيول طويلة قابضة عادة)",
 "phalangist": "كتائبي (عضو إسباني في حزب الجنرال فرانكو السياسي)",
 "phalangitis": "التهاب السلاميات (التهاب إصبع اليد أو القدم)",
 "phalangium opilio": "أوبليون, حاصد (عنكبوتي يشبه العنكبوت بجسم مستدير صغير وأرجل رفيعة طويلة جداً)",
 "phalanx": "سُلَامَى, سُلَامِيَّة",
 "phalaris aquatica": "عشب هاردينغ (عشب معمر من أستراليا وجنوب أفريقيا؛ أدخل إلى أمريكا الشمالية كعشب علف)",
 "phalaris arundinacea": "عشب الشريط, عشب القصب الكناري (عشب معمر في مروج المستنقعات والخنادق له أوراق عريضة؛ أوروبا وأمريكا الشمالية)",
 "phalaris canariensis": "عشب الكناري, عشب طعام الطيور (عشب من جزر الكناري؛ تستخدم بذوره كعلف لطيور الأقفاص)",
 "phalaris tuberosa": "عشب هاردينغ (عشب معمر من أستراليا وجنوب أفريقيا؛ أدخل إلى أمريكا الشمالية كعشب علف)",
 "phalarope": "فلروب (طائر شاطئي صغير يشبه الطيطوي له أصابع مفصصة ويجيد السباحة؛ يتكاثر في القطب الشمالي ويشتي في المناطق الاستوائية)",
 "phalaropus fulicarius": "فلروب أحمر (فلروب من المحيطات والبحيرات الشمالية)",
 "phalaropus tricolor": "فلروب ويلسون (يتكاثر في السهول الكبرى الشمالية لكندا)",
 "phalguna": "فالغونا (الشهر الثاني عشر من التقويم الهندوسي)",
 "phallic": "قَضِيبِيّ",
 "phallic phase": "المرحلة القضيبية ((التحليل النفسي) المرحلة الثالثة في نمو الطفل عندما يُفترض أن يكون الوعي بالأعضاء التناسلية والتلاعب بها مصدراً أساسياً للمتعة)",
 "phallic stage": "المرحلة القضيبية ((التحليل النفسي) المرحلة الثالثة في نمو الطفل عندما يُفترض أن يكون الوعي بالأعضاء التناسلية والتلاعب بها مصدراً أساسياً للمتعة)",
 "phalloidin": "فالويدين (أحد مجموعة الذيفانات المستخرجة من فطر قبعة الموت المعروفة باسم السموم الفالويدية)\nمثال: كان الفالويدين أحد أوائل الببتيدات الحلقية التي تم اكتشافها",
 "phalloplasty": "رأب القضيب (جراحة ترميمية على القضيب لإصلاح تشوه خلقي أو إصابة)",
 "phallus": "فَالُوس",
 "phallus impudicus": "فطر القرن النتن الشائع (فطر شائع كان يستخدم سابقاً في تحضير مرهم للروماتيزم)",
 "phallus ravenelii": "فالوس رافينيلي (هذا الفطر النتن له قبعة بسطح حبيبي عند القمة ورائحته تشبه اللحم المتحلل)",
 "phalsa": "غرويا, فالسا (شجيرة شجرية آسيوية مقاومة للجفاف تحمل ثماراً حمراء صغيرة حمضية بشكل لطيف صالحة للأكل تستخدم عادة في المشروبات)",
 "phanerogam": "ظاهرة التزاوج, نبات بذري (نبات يتكاثر عن طريق البذور وليس الأبواغ)",
 "phaneromania": "فانيرومانيا, هوس العبث بالجسم (رغبة لا تقاوم في العبث بأجزاء سطحية من الجسم (مثل قضم الأظافر القهري))",
 "phantasm": "خيال, شبح (شيء موجود في الإدراك فقط) / شبح, طيف (شكل شبحي ظاهر)\nمثال: طيف شبحي في منتصف الليل",
 "phantasma": "خيال, شبح (شيء موجود في الإدراك فقط) / شبح, طيف (شكل شبحي ظاهر)\nمثال: طيف شبحي في منتصف الليل",
 "phantasmagoria": "أخيلة متغيرة, سلسلة أوهام (مزيج متغير باستمرار من الصور الحقيقية أو المتخيلة (كما في الحلم))",
 "phantasmagoric": "سُرْيَالِيّ, فَانْتَاسْمَاغُورِيّ (يتّسم بصور خيالية غريبة وتجاورات غير متوقّعة)",
 "phantasmagorical": "سُرْيَالِيّ, فَانْتَاسْمَاغُورِيّ (يتّسم بصور خيالية غريبة وتجاورات غير متوقّعة)",
 "phantasmal": "شَبَحِيّ, طَيْفِيّ (يشبه الأشباح أو يتسم بخصائصها)",
 "phantasy": "خيال, فانتازيا (خيال غير مقيد بالواقع) / خيال, وهم (شيء يعتقد الكثير من الناس أنه حقيقي وهو باطل) / أدب عجائبي, فانتازيا (أدب خيالي يحتوي على قدر كبير من الخيال الجامح)\nمثال: خيال تلميذة",
 "phantasy life": "حياة الخيال (حياة وهمية تعاش في عالم الخيال)",
 "phantasy world": "أرض الخيال, عالم خيالي (شيء موجود فقط في الخيال (ولكن غالبًا ما يُخطئ في اعتباره واقعًا))",
 "phantom": "سَرَاب, شَبَح",
 "phantom limb": "طرف وهمي (الوهم بأن طرفاً لا يزال موجوداً بعد بتره)",
 "phantom limb pain": "ألم الطرف الشبح (ألم يشعر به مبتور الطرف ويبدو وكأنه موجود في الطرف المفقود)",
 "phantom limb syndrome": "متلازمة الطرف الشبح (متلازمة تتكون من عدم الراحة أو الألم في طرف تم بتره)",
 "phantom orchid": "أوركيد الثلج, أوركيد الشبح (نبات أبيض شمعي عديم الأوراق تقريباً بسيقان في مجموعات وعناقيد من الزهور البيضاء؛ شمال غرب الولايات المتحدة إلى شمال كاليفورنيا وشرقاً إلى أيداهو)",
 "pharaoh": "فِرْعَوْن (لقب أُطلق على أي حاكمي مِصْرَ قديمًا؛ (استخدام مجازي) لقب يُطلق على أي طاغٍ متمرد؛ شخص متصف بصفات فرعون؛ طَاغِيَة)",
 "pharaoh ant": "نمل فرعون (نمل أحمر صغير من المناطق الدافئة؛ آفة منزلية شائعة)",
 "pharaoh of egypt": "فرعون (لقب ملوك مصر القديمة)",
 "pharaoh's ant": "نمل فرعون (نمل أحمر صغير من المناطق الدافئة؛ آفة منزلية شائعة)",
 "pharaoh's chicken": "رخمة مصرية (نسر صغير أبيض في الغالب من أفريقيا وجنوب أوراسيا)",
 "pharaonic": "فرعوني (مكون من أو متعلق بملوك مصر القديمة)",
 "pharisaic": "مُتَظَاهِر بِالتَّقْوَى, مُرَائِي (مُفرِط في إظهار التقوى بشكل نفاقيّ)",
 "pharisaical": "مُتَظَاهِر بِالتَّقْوَى, مُرَائِي (مُفرِط في إظهار التقوى بشكل نفاقيّ)",
 "pharisee": "فَرِّيسِيّ",
 "pharma": "شركة أدوية, شركة صيدلانية (شركة تقوم بتصنيع وبيع المستحضرات الصيدلانية)",
 "pharmaceutic": "صيدلاني (من أو متعلق بالصيدلة أو الصيادلة) / دواء صيدلاني, مستحضر صيدلاني (عقار أو دواء يتم تحضيره أو صرفه في الصيدليات ويستخدم في العلاج الطبي)\nمثال: الصناعة الصيدلانية",
 "pharmaceutical": "صيدلاني (من أو متعلق بالصيدلة أو الصيادلة) / دوائي, صيدلاني (من أو متعلق بالأدوية المستخدمة في العلاج الطبي) / دواء صيدلاني, مستحضر صيدلاني (عقار أو دواء يتم تحضيره أو صرفه في الصيدليات ويستخدم في العلاج الطبي)\nمثال: الصناعة الصيدلانية",
 "pharmaceutical chemist": "عالم صيدلة, فارماكولوجي (شخص مدرب في علم الأدوية (تركيبها واستخداماتها وتأثيراتها))",
 "pharmaceutical company": "شركة أدوية, شركة صيدلانية (شركة تقوم بتصنيع وبيع المستحضرات الصيدلانية)",
 "pharmaceutics": "صيدلة (فن وعلم تحضير وصرف الأدوية والعقاقير)",
 "pharmacist": "صَيْدَلِيّ, صَيْدَلَانِيّ",
 "pharmacogenetics": "علم الصيدلة الجيني (فرع علم الوراثة الذي يدرس الاختلافات المحددة وراثياً في الاستجابات للأدوية لدى البشر أو الكائنات المخبرية)",
 "pharmacokinetics": "حركية الدواء (دراسة عمل الأدوية في الجسم: طريقة ومعدل الإخراج، ومدة التأثير، إلخ)",
 "pharmacologic": "دوائي, فارماكولوجي (متعلق بعلم الأدوية)",
 "pharmacological": "دوائي, فارماكولوجي (متعلق بعلم الأدوية)",
 "pharmacological medicine": "علم الأدوية, فارماكولوجيا (علم أو دراسة الأدوية: تحضيرها وخصائصها واستخداماتها وتأثيراتها)",
 "pharmacologically": "دوائياً, فارماكولوجياً (فيما يتعلق بعلم العقاقير)\nمثال: دوائياً، قد يكون لهذا النبات تطبيقات مهمة",
 "pharmacologist": "عالم صيدلة, فارماكولوجي (شخص مدرب في علم الأدوية (تركيبها واستخداماتها وتأثيراتها))",
 "pharmacology": "عِلْم اَلصَّيْدَلَة (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "pharmacopeia": "دستور الأدوية ((علم الأدوية) كتاب يحتوي على تجميع للمنتجات الصيدلانية مع صيغها وطرق تحضيرها)",
 "pharmacopoeia": "دُسْتُور أَدْوِيَة (قَاعِدَة)\nمثال: العدالة مضمونة في الدستور.",
 "pharmacovigilance": "صيدلة احتراسية, اليَقَظةُ الدَّوائِيَّة",
 "pharmacy": "صَيْدَلِيَّة / صَيْدَلَة",
 "pharomacrus mocino": "كيتزال براق (طائر نادر جداً من أمريكا الوسطى؛ الطائر الوطني لغواتيمالا)",
 "pharos": "فنار, منارة (برج به ضوء يعطي تحذيراً للسفن العابرة من الأرصفة الصخرية أو المياه الضحلة)",
 "pharyngeal": "بُلْعُومِيّ / حَلْقِيّ",
 "pharyngeal consonant": "صوت بلعومي, صوت حلقي (صامت يُنطق في مؤخرة الفم أو الحلق)",
 "pharyngeal recess": "الردب البلعومي (فجوة صغيرة في جدار البلعوم)",
 "pharyngeal reflex": "منعكس البلعوم, منعكس التقيؤ (منعكس طبيعي يتكون من التهوع؛ قد ينتج عن لمس الحنك الرخو في الجزء الخلفي من الفم)",
 "pharyngeal tonsil": "لحمية, لوزة بلعومية (تجمع من الأنسجة اللمفاوية في الحلق خلف اللهاة (على الجدار الخلفي وسقف البلعوم الأنفي))\nمثال: تضخم اللوزتين البلعوميتين يسمى اللحمية",
 "pharyngeal vein": "وريد بلعومي (أوردة من الضفيرة البلعومية تصب في الوريد الوداجي الباطن)",
 "pharyngitis": "التهاب البلعوم, التهاب الحلق (التهاب الحلق والبلعوم)",
 "pharynx": "بُلْعُوم",
 "phascolarctos cinereus": "كوالا (جرابي شجري أسترالي بطيء الحركة عديم الذيل ذو آذان ومعطف رمادي مكسو بالفراء؛ يتغذى على أوراق الكافور ولحائه)",
 "phase": "مَرْحَلَة",
 "phase angle": "زاوية الطور, طور (نقطة معينة في وقت دورة ما؛ مقاسة من صفر تعسفي ومعبر عنها كزاوية)",
 "phase change": "تحول الطور, تغير الطور (تغير من حالة (صلبة أو سائلة أو غازية) إلى أخرى دون تغيير في التركيب الكيميائي)",
 "phase i": "المرحلة الأولى من التجارب السريرية (تجربة سريرية على عدد قليل من الأشخاص لتحديد سلامة دواء جديد)",
 "phase i clinical trial": "المرحلة الأولى من التجارب السريرية (تجربة سريرية على عدد قليل من الأشخاص لتحديد سلامة دواء جديد)",
 "phase ii": "المرحلة الثانية من التجارب السريرية (تجربة سريرية على أشخاص أكثر من المرحلة الأولى؛ تهدف إلى تقييم فعالية العلاج)",
 "phase ii clinical trial": "المرحلة الثانية من التجارب السريرية (تجربة سريرية على أشخاص أكثر من المرحلة الأولى؛ تهدف إلى تقييم فعالية العلاج)",
 "phase iii": "المرحلة الثالثة من التجارب السريرية (تجربة سريرية كبيرة لعلاج أو دواء ثبتت فعاليته في المرحلتين الأولى والثانية)",
 "phase iii clinical trial": "المرحلة الثالثة من التجارب السريرية (تجربة سريرية كبيرة لعلاج أو دواء ثبتت فعاليته في المرحلتين الأولى والثانية)",
 "phase iv": "المرحلة الرابعة من التجارب السريرية (مراقبة مستمرة لتأثيرات الدواء بعد موافقة إدارة الغذاء والدواء عليه للاستخدام العام)",
 "phase iv clinical trial": "المرحلة الرابعة من التجارب السريرية (مراقبة مستمرة لتأثيرات الدواء بعد موافقة إدارة الغذاء والدواء عليه للاستخدام العام)",
 "phase modulation": "تضمين الطور (تضمين طور الموجة الحاملة)",
 "phase of cell division": "مرحلة انقسام الخلية (مرحلة في الانقسام المنصف أو المتساوي)",
 "phase of the moon": "طور القمر, منزلة القمر (وقت يقدم فيه القمر مظهراً متكرراً معيناً)",
 "phase space": "فضاء الطور ((الفيزياء) فضاء مثالي تمثل فيه الأبعاد الإحداثية المتغيرات المطلوبة لوصف نظام أو مادة)\nمثال: فضاء طور متعدد الأبعاد",
 "phase transition": "تحول الطور, تغير الطور (تغير من حالة (صلبة أو سائلة أو غازية) إلى أخرى دون تغيير في التركيب الكيميائي)",
 "phase velocity": "سرعة الطور",
 "phase-out": "إلغاء تدريجي (الفعل أو الحالة لإيقاف مخطط وتدريجي)",
 "phaseolus aconitifolius": "فاصولياء العث, لوبياء مقرنة (بقوليات من جزر الهند الشرقية لها أوراق مشعرة وزهور صفراء صغيرة تليها قرون أسطوانية؛ تستخدم خاصة في الهند للغذاء والعلف وكمحسن للتربة)",
 "phaseolus acutifolius latifolius": "فاصولياء تيباري (نبات متسلق من جنوب غرب الولايات المتحدة والمكسيك له فاصولياء مستديرة بيضاء أو صفراء أو بنية أو سوداء)",
 "phaseolus angularis": "فاصولياء الأزوكي, لوبياء زاوية (نبات حولي كثيف يزرع على نطاق واسع في الصين واليابان للدقيق المصنوع من بذوره)",
 "phaseolus aureus": "فول المونج, لوبياء شعاعية (نبات حولي منتصب كثيف يزرع على نطاق واسع في المناطق الدافئة في الهند وإندونيسيا والولايات المتحدة للعلف وخاصة لبذوره الصالحة للأكل؛ المصدر الرئيسي…)",
 "phaseolus caracalla": "زهرة الحلزون, لوبياء كاراكالا (كرمة معمرة من أمريكا الاستوائية تزرع لعناقيدها من الزهور الصفراء والأرجوانية البارزة التي يكون تويجها ملفوفاً مثل قوقعة الحلزون)",
 "phaseolus coccineus": "فاصولياء العداء القرمزي, فاصولياء قرمزية (فاصولياء استوائية أمريكية ذات زهور حمراء وفاصولياء سوداء مرقطة تشبه الفاصولياء الشائعة ولكنها معمرة؛ وهي فاصولياء مفضلة للأكل في بريطانيا العظمى)",
 "phaseolus limensis": "فاصولياء ليمية (نبات فاصولياء شجيري أو طويل النمو له بذور مسطحة كبيرة صالحة للأكل)",
 "phaseolus lunatus": "فاصولياء الزبدة, فاصولياء سيفا (نبات فاصولياء شجيري يزرع خاصة في جنوب الولايات المتحدة له بذور مسطحة صغيرة صالحة للأكل)",
 "phaseolus multiflorus": "فاصولياء العداء القرمزي, فاصولياء قرمزية (فاصولياء استوائية أمريكية ذات زهور حمراء وفاصولياء سوداء مرقطة تشبه الفاصولياء الشائعة ولكنها معمرة؛ وهي فاصولياء مفضلة للأكل في بريطانيا العظمى)",
 "phaseolus vulgaris": "فاصولياء شائعة (نبات الفاصولياء الحولي المتسلق أو الشجيري الشائع الذي يزرع لبذوره أو قرونه الصالحة للأكل)",
 "phasianid": "تدرجية (نوع من طيور الصيد في فصيلة التدرجية)",
 "phasianus colchicus": "تدرج مطوق (تدرج شائع ذو ريش زاهي وحلقة عنق بيضاء)",
 "phasmid": "شبحيات (حشرات استوائية كبيرة أسطوانية أو مسطحة بأرجل قوية طويلة تتغذى على النباتات؛ الحشرات العصوية والحشرات الورقية)",
 "phasmid insect": "شبحيات (حشرات استوائية كبيرة أسطوانية أو مسطحة بأرجل قوية طويلة تتغذى على النباتات؛ الحشرات العصوية والحشرات الورقية)",
 "phatic communication": "حديث تواصلي, كلام مجاملة (حديث محادثة يستخدم للتواصل الاجتماعي أكثر من نقل المعلومات)",
 "phatic speech": "حديث تواصلي, كلام مجاملة (حديث محادثة يستخدم للتواصل الاجتماعي أكثر من نقل المعلومات)",
 "phd": "دكتوراه (دكتوراه تعتمد عادةً على 3 سنوات على الأقل من الدراسات العليا وأطروحة؛ وهي أعلى درجة تمنح في الدراسات العليا)",
 "pheasant": "تَدْرُج",
 "pheasant coucal": "كوكال تدرجي (طائر أسترالي ذو ذيل يشبه التدرج)",
 "pheasant cuckoo": "كوكال تدرجي (طائر أسترالي ذو ذيل يشبه التدرج)",
 "pheasant under glass": "تدرج تحت الزجاج (طبق من طائر التدرج المشوي يُقدم بطريقة مميزة للمطاعم الفاخرة)",
 "pheasant's-eye": "أدونيس حولي, عين الديك (عشب أوراسي يزرع لزهوره الحمراء العميقة ذات المراكز الداكنة)",
 "phegopteris connectilis": "سرخس الزان الشمالي, سرخس الزان الطويل (سرخس زان في أمريكا الشمالية وأوراسيا)",
 "phegopteris hexagonoptera": "سرخس الزان الجنوبي, سرخس الزان العريض (سرخس زان في غابات أمريكا الشمالية بخطوط بلون القش)",
 "phellem": "فِلِّين, نَسِيج فِلِّينِيّ ((في علم النبات) النسيج الخارجي للحاء؛ طبقة واقية من الخلايا الميتة)",
 "phellodendron amurense": "شجرة الفلين, فيلوديندرون (شجرة نفضية من الصين ومنشوريا لها رائحة التربنتين وأوراق مركبة جميلة تتحول للأصفر في الخريف ولحاء فليني عميق التشققات)",
 "phenacetin": "أسيتوفينيتيدين, فيناسيتين (مركب بلوري أبيض يستخدم كمسكن للألم وكذلك كخافض للحرارة)",
 "phenacomys": "فيناكوميس (أي من عدة قوارض أرضية أو شجرية تشبه فئران الحقل في المناطق الغابية الباردة في كندا وغرب الولايات المتحدة)",
 "phenakistoscope": "قُرْصُ المُصْطَرِبَة",
 "phenaphen": "أسيتامينوفين, باراسيتامول (مسكن للألم الخفيف ولكن ليس للالتهابات؛ يستخدم أيضاً كخافض للحرارة (تايلينول وبانادول وغيرها هي علامات تجارية لأقراص الأسيتامينوفين))",
 "phenazopyridine": "بيريديوم, فينازوبيريدين (مسكن (الاسم التجاري بيريديوم) يستخدم لعلاج التهابات المسالك البولية)",
 "phencyclidine": "بي سي بي, غبار الملاك (عقار يستخدم كمخدر من قبل الأطباء البيطريين؛ يؤخذ بشكل غير مشروع (أصلاً في شكل مسحوق أو 'غبار') لتأثيراته كمهلوس)",
 "phencyclidine hydrochloride": "بي سي بي, غبار الملاك (عقار يستخدم كمخدر من قبل الأطباء البيطريين؛ يؤخذ بشكل غير مشروع (أصلاً في شكل مسحوق أو 'غبار') لتأثيراته كمهلوس)",
 "phenelzine": "فينيلزين, نارديل (مثبط أكسيداز أحادي الأمين (الاسم التجاري نارديل) يستخدم لعلاج الاكتئاب السريري)",
 "phenergan": "بروميثازين, فينيرغان (مضاد للهيستامين (الاسم التجاري فينيرغان) يستخدم لعلاج الحساسية؛ وأيضاً مضاد للقيء يستخدم لعلاج دوار الحركة)",
 "pheniramine": "فينيرامين (مضاد للهيستامين يستخدم في المستحضرات لعلاج الحساسية والتهابات الجهاز التنفسي؛ يستخدم لعلاج التهاب الأنف والطفح الجلدي والحكة)",
 "pheno-safranine": "فينو-سافرانين (صبغة حمراء أرجوانية قابلة للذوبان في الماء تستخدم في الفحص المجهري)",
 "phenobarbital": "ثيوبنتال الصوديوم, فينوباربيتال (باربيتورات طويل المفعول يستخدم كمهدئ)",
 "phenobarbitone": "ثيوبنتال الصوديوم, فينوباربيتال (باربيتورات طويل المفعول يستخدم كمهدئ)",
 "phenol": "فِينُول, أَسْفَنِيك / فِينُول",
 "phenolic": "راتنج فينولي (راتنج متصلب بالحرارة)",
 "phenolic glycoside": "غليكوزيد فينولي (مركب نشط ضوئياً يتحلل بسهولة بواسطة الأحماض المعدنية أو القلويات أو إنزيم مناسب)",
 "phenolic plastic": "بلاستيك فينولي (بلاستيك يتكون من راتنجات الفينول)",
 "phenolic resin": "راتنج فينولي (راتنج متصلب بالحرارة)",
 "phenolic urea": "بلاستيك فينولي (بلاستيك يتكون من راتنجات الفينول)",
 "phenolphthalein": "فينول فثالين (ملين يستخدم في العديد من المستحضرات تحت أسماء تجارية مختلفة؛ يستخدم أيضاً كمؤشر حمض-قاعدة في المعايرة التي تتضمن أحماضاً ضعيفة وقواعد قوية لأنه يكون…)",
 "phenomenal": "رَائِع, عَظِيم (جيد أو عظيم بشكل استثنائي؛ يُستخدم خاصة كمكثف) / ظاهراتي (متعلق بالظواهر)\nمثال: علم ظاهراتي",
 "phenomenality": "إِعْجَاز, ظَاهِرِيَّة فَذَّة (حالة أو خاصية كون الشيء لافتاً للغاية؛ استثنائي جداً؛ مذهل)",
 "phenomenally": "بشكل استثنائي, بشكل هائل (لدرجة استثنائية أو ظاهرة)\nمثال: كان رد فعله سريعاً بشكل استثنائي",
 "phenomenology": "ظاهراتية, فينومينولوجيا (مذهب فلسفي اقترحه إدموند هوسرل يعتمد على دراسة التجربة البشرية التي لا تؤخذ فيها اعتبارات الواقع الموضوعي في الحسبان)",
 "phenomenon": "ظَاهِرَة (ظَاهِرَة: اسم؛ تطلق على شيء يَظْهر أي يبين. \"ظَاهِرة قَوس قُزَح بعد المَطَر\"؛ ظَاهِرَة: اسم؛ الإبل أو الغنم ترِد نصف النهار أي ظُهراً. استعمال قديم)\nمثال: علينا أن نكشف تستر الحكومة بشأن ظاهرة الأجسام الطائرة المجهولة.",
 "phenoplast": "راتنج فينولي (راتنج متصلب بالحرارة)",
 "phenothiazine": "فينوثيازين (مركب يستخدم أساساً في الطب البيطري لتخليص حيوانات المزرعة من الطفيليات الداخلية)",
 "phenotype": "نَمَط ظَاهِرِيّ",
 "phenotypic": "ظاهري, مظهري (من أو يتعلق بالنمط الظاهري أو يشكله)\nمثال: ملف مظهري",
 "phenotypical": "ظاهري, مظهري (من أو يتعلق بالنمط الظاهري أو يشكله)\nمثال: ملف مظهري",
 "phenoxymethyl penicillin": "بنسلين في, فينوكسي ميثيل بنسلين (بنسلين بلوري مشابه في تأثيره للبنسلين جي ولكنه أكثر مقاومة لتأثير أحماض المعدة)",
 "phensuximide": "فينسوكسيميد, ميلونتين (مضاد للاختلاج (الاسم التجاري ميلونتين) يستخدم لعلاج الصرع الصغير)",
 "phentolamine": "فينتولامين (عقار للفحولة (الاسم التجاري فاسوماكس) لعلاج ضعف الانتصاب لدى الرجال)",
 "phenyl salicylate": "سالول, ساليسيلات الفينيل (مسحوق أبيض ذو طعم ورائحة لطيفين؛ يستخدم لامتصاص الضوء في مستحضرات الوقاية من الشمس أو كمادة حافظة أو مطهر أو طلاء للحبوب التي يقصد بها الإطلاق المعوي)",
 "phenylacetamide": "أسيتانيليد, فينيل أسيتاميد (مادة كيميائية صلبة عديمة الرائحة تشبه الأوراق أو الرقائق؛ تستخدم في مسرعات المطاط والأصباغ وتخليق الكافور؛ وتُستقلب إلى باراسيتامول (أسيتامينوفين))",
 "phenylalanine": "فينيل ألانين (حمض أميني أساسي يوجد في البروتينات ويحتاجه الأطفال للنمو وللتمثيل الغذائي للبروتين؛ يتحول عادة إلى تيروسين في جسم الإنسان)",
 "phenylamine": "أنيلين (أمين سائل سام زيتي يتم الحصول عليه من النيتروبنزين ويُستخدم لصنع الأصباغ والبلاستيك والأدوية)",
 "phenylbutazone": "بوتازوليدين, فينيل بوتازون (دواء مضاد للالتهاب (الاسم التجاري بوتازوليدين))",
 "phenylephrine": "فينيليفرين (مقبض للأوعية قوي يستخدم لتوسيع حدقة العين وتخفيف احتقان الأنف)",
 "phenylethylene": "ستايرين, فينيل بنزين (سائل زيتي عديم اللون؛ هو المونومر للبوليسترين)",
 "phenylic acid": "حمض الكربوليك, فينول (مشتق حمضي بلوري أبيض سام للبنزين قابل للذوبان؛ يستخدم في التصنيع وكمطهر ومعقم)",
 "phenylketonuria": "بيلة الفينيل كيتون (اضطراب وراثي في التمثيل الغذائي؛ يؤدي نقص الإنزيم اللازم لتحويل الفينيل ألانين إلى تيروزين إلى تراكم الفينيل ألانين في سوائل الجسم مما يسبب درجات…)",
 "phenylpropanolamine": "فينيل بروبانولامين (دواء أدرينالي يُستخدم في العديد من المستحضرات لتخفيف ردود الفعل التحسسية أو التهابات الجهاز التنفسي)\nمثال: يتم سحب الأدوية التي تحتوي على فينيل بروبانولامين",
 "phenyltoloxamine": "فينيل تولوكسامين (مضاد للهيستامين مدرج في بعض المستحضرات المستخدمة لعلاج السعال واحتقان الأنف)",
 "phenytoin": "ديلانتين, فينيتوين (دواء مضاد للاختلاج (الاسم التجاري ديلانتين) يستخدم لعلاج الصرع وهو ليس مهدئاً)",
 "pheochromocytoma": "ورم القواتم (ورم وعائي في الغدة الكظرية)",
 "pheresis": "فصادة (إجراء يتم فيه سحب الدم وفصله إلى مكوناته بواسطة الغسيل الكلوي (أو جهاز الطرد المركزي)؛ يتم الاحتفاظ بالبعض وإعادة الباقي إلى المتبرع)",
 "pheromone": "فِيرُومُون",
 "phi": "فَاي",
 "phi coefficient": "ارتباط فاي, معامل فاي (مؤشر للعلاقة بين أي مجموعتين من الدرجات يمكن تمثيلهما بأبعاد ثنائية مرتبة (مثل ذكر-أنثى))",
 "phi correlation": "ارتباط فاي, معامل فاي (مؤشر للعلاقة بين أي مجموعتين من الدرجات يمكن تمثيلهما بأبعاد ثنائية مرتبة (مثل ذكر-أنثى))",
 "phial": "أمبولة, قارورة صغيرة (زجاجة صغيرة تحتوي على دواء (خاصة حاوية معقمة ومحكمة الغلق للحقن))",
 "philadelphi corridor": "مِحْوَر فِيلَادِلْفْيَا, مِحْوَر صَلَاح الدِّين",
 "philadelphia fleabane": "يرغوث فيلادلفيا (نبات جميل بشكل خاص له هامش دقيق من الأشعة الخيطية حول رؤوس الزهور ذات الأشعة البيضاء أو الوردية النحيلة جداً؛ الولايات المتحدة وكندا)",
 "philadelphia pepper pot": "بيبر بوت (حساء مصنوع من الخضروات والكرشة ومتبل بحبوب الفلفل؛ يحتوي غالباً على الزلابية)",
 "philadelphus": "سرنجة, فيلادلفوس (أي من شجيرات الزينة النفضية المتنوعة بشكل رئيسي من جنس فيلادلفوس لها زهور بيضاء حلوة الرائحة، مفردة أو في عناقيد؛ تزرع على نطاق واسع في المناطق…)",
 "philadelphus coronarius": "برتقال كاذب, سرينقة (شجيرة كبيرة قوية التحمل ذات زهور بيضاء كريمية مبهرجة وعطرة بقوة في عناقيد طرفية قصيرة)",
 "philaenus spumarius": "حشرة بصاق المروج (حشرة من أمريكا الشمالية تتلف الأعشاب بشدة)",
 "philanderer": "زير نساء (رجل يحب العديد من النساء ويقيم علاقات جنسية قصيرة معهن)",
 "philanthropic": "خَيِّر, مُحْسِن (سخيّ في مساعدة الفقراء والمحتاجين) / إنساني, خيري (من أو يتعلق بعمل الخير والإحسان)\nمثال: جمعية خيرية",
 "philanthropic foundation": "مؤسسة خيرية مانحة, مؤسسة فيلانثروبية (مؤسسة تقدم أموالاً للعلوم أو الفن أو التعليم أو الدين أو التخفيف من الأمراض وما إلى ذلك)",
 "philanthropic gift": "عمل خيري, هدية خيرية (التعزيز الطوعي لرفاهية الإنسان)",
 "philanthropically": "بشكل خيري, خيرياً (بطريقة خيرية إنسانية)",
 "philanthropist": "سَخِيّ ((سَخِيَ) سَخاً: كَانَ جوادًا كَرِيمًا؛ (سَخِيَت) نَفسه عَن الشَّيْء: تركته)\nمثال: هو سخي بأمواله.",
 "philanthropy": "عمل خيري, هدية خيرية (التعزيز الطوعي لرفاهية الإنسان)",
 "philatelic": "طوابعي (من أو يتعلق بجمع الطوابع أو يهم هواة جمع الطوابع)",
 "philatelical": "طوابعي (من أو يتعلق بجمع الطوابع أو يهم هواة جمع الطوابع)",
 "philatelically": "في طوابع البريد (بطريقة تتعلق بجمع الطوابع)\nمثال: يكرم مكتب البريد الأمريكيين العظماء في طوابع البريد",
 "philatelist": "جامع طوابع, هاوي طوابع (جامع ودارس للطوابع البريدية)",
 "philately": "جمع الطوابع, فيلاتلي (جمع ودراسة الطوابع البريدية)",
 "philemon": "الرِّسَالَة إِلَى فِلِيمُون / فِلِيمُون",
 "philharmonic": "فِيلْهَارْمُونِيّ, مُحِبٌّ لِلْمُوسِيقَى (مُكَرَّسٌ لِلْمُوسِيقَى أَوْ مُقَدِّرٌ لَهَا) / أوركسترالي, فيلهارموني (يشكل أو يميز مجموعة أوركسترالية) / أوركسترا سيمفونية, أوركسترا فيلهارمونية (أوركسترا كبيرة؛ يمكنها أداء السيمفونيات)\nمثال: عازفون فيلهارمونيون",
 "philharmonic pitch": "دوزان الحفلات, طبقة الحفلات",
 "philhellene": "محب لليونان (يتميز بحب اليونان والأشياء اليونانية) / محب لليونان (معجب باليونان وكل ما هو يوناني)\nمثال: الجمعية المحبة لليونان",
 "philhellenic": "محب لليونان (يتميز بحب اليونان والأشياء اليونانية)\nمثال: الجمعية المحبة لليونان",
 "philhellenism": "حب الإغريق (الإعجاب باليونان واليونانيين والعادات اليونانية)",
 "philhellenist": "محب لليونان (معجب باليونان وكل ما هو يوناني)",
 "philia": "عاطفة, محبة (شعور إيجابي بالإعجاب)\nمثال: وجد صعوبة في التعبير عن المودة التي شعر بها",
 "philip": "فِيلِيب, فِيلِبُس / فِيلِيب",
 "philippian": "فيليبي (مواطن أو ساكن في فيليبي في مقدونيا القديمة)",
 "philippic": "تنديد عنيف, خطبة لاذعة (خطاب استنكار عنيف)",
 "philippine": "فلبيني (من أو متعلق أو مميز للفلبين أو شعبها أو عاداتها) / اللغة الفلبينية (اللغة الرسمية للفلبين؛ تعتمد على التاغالوغ؛ وتستمد مفرداتها من اللغات الفلبينية الأخرى)\nمثال: الرئيس الفلبيني",
 "philippine cedar": "أرز فلبيني, ماهوجني فلبيني (شجرة خشبية فلبينية ذات خشب أحمر صلب وعطري)",
 "philippine eagle": "عِقَاب فِيلِبِينِيّ (طَيْر من الجَوَارِح، أكبر التي تصيد منها يكنى بأبي الهَيْثَم ومعروف بحِدَّة البصر؛ حَجَر ناتئ في جَوْف البِئْر يخرق الدَلُو. ونادر)\nمثال: هو من تلقى العقاب الأكبر.",
 "philippine language": "اللغة الفلبينية (اللغة الرسمية للفلبين؛ تعتمد على التاغالوغ؛ وتستمد مفرداتها من اللغات الفلبينية الأخرى)",
 "philippine mahogany": "أرز فلبيني, ماهوجني فلبيني (شجرة خشبية فلبينية ذات خشب أحمر صلب وعطري) / ماهوجني فلبيني (خشب صلب أحمر لشجرة الماهوجني الفلبينية يستخدم لصناديق السيجار والتشطيب الداخلي)",
 "philippine monetary unit": "وحدة نقدية فلبينية (الوحدة النقدية في الفلبين)",
 "philippine peso": "بيزو, بيزو فلبيني (وحدة المال الأساسية في الفلبين؛ تساوي 100 سنتافو)",
 "philippine sea": "بَحْر الْفِلِبِّين (شَقّ الأرض؛ التَحَيُّر والبَهْت من الفزع أو من شدة العَطَش فنظر لا يقصد شيئا)\nمثال: هبطت على البحر.",
 "philippines": "الْفِلِبِّين (دولة في جنوب شرق آسيا؛ اسمها الرسمي جمهورية الفلبين، وعاصمتها مانيلا؛ جزر الفلبين، أرخبيل في جنوب شرق قارة آسيا يمثل أساس جمهورية الفلبين)\nمثال: الفلبين بلد كاثوليكي أساسا.",
 "philistine": "فلستيون",
 "philistinism": "مادية (الرغبة في الثروة والممتلكات المادية مع القليل من الاهتمام بالأمور الأخلاقية أو الروحية)",
 "phillips screw": "برغي فيليبس (برغي برأس خاص به فتحات متقاطعة)",
 "phillips screwdriver": "مفك صليبة, مفك فيليبس (مفك براغي للاستخدام مع براغي فيليبس)",
 "phillipsite": "فيليبسيت (مجموعة من المعادن البلورية البيضاء أو المحمرة من عائلة الزيوليت تتكون من سيليكات مائية للكالسيوم والبوتاسيوم والألومنيوم)",
 "philodendron": "شجرة الحب, فيلوديندرون (غالباً ما يزرع كنبات منزلي)",
 "philogyny": "تقدير النساء, حب النساء (الإعجاب بالنساء)",
 "philohela minor": "دجاجة الأرض الأمريكية (دجاجة أرض صغيرة طويلة المنقار؛ تُقدر كطائر صيد)",
 "philological": "فقهي لغوي, فيلولوجي (من أو يتعلق بفقه اللغة (الفيلولوجيا) أو يتعامل معه)",
 "philologist": "فقيه لغوي, فيلولوجي (إنساني متخصص في الدراسات الكلاسيكية واللغوية)",
 "philologue": "فقيه لغوي, فيلولوجي (إنساني متخصص في الدراسات الكلاسيكية واللغوية)",
 "philology": "فِقْهُ اللُّغَة (عَلِمَ، أو فَهِمَ، وَهو لمطلق الفهم) / عِلْمُ فِقْهِ اللُّغَة (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "philomachus pugnax": "حجوالة, دريجة شرسة (طيطوي أوراسي شائع؛ يتميز الذكر بطوق عنق قابل للانتصاب في موسم التكاثر)",
 "philomath": "محب للعلم (محب للتعلم)",
 "philosopher": "فَيْلَسُوف (تلميذ للفلسفة)\nمثال: إنك فيلسوف ، أليس ذلك صحيحا؟",
 "philosopher's stone": "حَجَر اَلْفَلَاسِفَة (حَجَرَ عليه الأمرَ:مَنَعَه منه ، حجر الشّيء على نفسه:خَصَّها به وقصره عليها؛ الحجْرُ: المَنْعُ مِن التَّصَرُّفِ ، وحَجَرَ عَلَيْهِ القاضِي يَحْجُرُ حَجْراً، إِذا مَنَعَه مِن التَّصَرُّفِ فِي مالِه)\nمثال: عوقب زيري بالحجر.",
 "philosopher's wool": "أكسيد الخارصين, أكسيد الزنك (أكسيد الزنك؛ مسحوق أبيض يستخدم كصبغة أو في مستحضرات التجميل أو الزجاج أو الأحبار وفي مرهم الزنك)",
 "philosophers' stone": "الإكسير, حجر الفلاسفة (مادة افتراضية اعتقد الخيميائيون أنها قادرة على تحويل المعادن الخسيسة إلى ذهب)",
 "philosophers' wool": "أكسيد الخارصين, أكسيد الزنك (أكسيد الزنك؛ مسحوق أبيض يستخدم كصبغة أو في مستحضرات التجميل أو الزجاج أو الأحبار وفي مرهم الزنك)",
 "philosophic": "حَكِيم, فَلْسَفِيّ (يتّسم بموقف الفيلسوف؛ يواجه المشاكل بانفصال رزين) / فلسفي (متعلق بالفلسفة أو الفلاسفة)\nمثال: كتابة فلسفية",
 "philosophical": "فَلْسَفِيّ",
 "philosophical doctrine": "مذهب فلسفي, نظرية فلسفية (مذهب يقبله أتباع فلسفة ما)",
 "philosophical system": "عقيدة, فلسفة (معتقد (أو نظام معتقدات) مقبول كسلطة من قبل مجموعة أو مدرسة ما)",
 "philosophical theory": "مذهب فلسفي, نظرية فلسفية (مذهب يقبله أتباع فلسفة ما)",
 "philosophically": "برباطة جأش, فلسفياً (بطريقة فلسفية (أو بصبر وحكمة)) / فلسفياً (فيما يتعلق بالفلسفة)\nمثال: تقبلت الأمر فلسفياً",
 "philosophicalness": "حكمة, فلسفة (حالة أو صفة امتلاك موقف الفيلسوف؛ تحديداً، الهدوء وعدم التزعزع في مواجهة المشاكل أو الهزيمة أو الخسارة)",
 "philosophiser": "متفلسف (شخص ينظر إلى المواقف من وجهة نظر فلسفية)",
 "philosophize": "فَلْسَفَ",
 "philosophizer": "متفلسف (شخص ينظر إلى المواقف من وجهة نظر فلسفية)",
 "philosophizing": "تفلسف (عرض (غالباً بشكل سطحي) لفلسفة معينة)",
 "philosophy": "فَلْسَفَة (في : عِلْمُ الفَلْسَفَة: علم يعنى بوجه الإجمال على بيان أسباب الأشياءِ المادّية والغير المادّية أو ذكر الأشياءِ مع أسبابها وهو يدرس المبادئ الأُولى…؛ في : التشبُّه بالإله حسب الطاقة البشريَّة لتحصيل السعادة الأبديَّة) / مَذْهَب, عَقِيدَة (المَذْهَب : بمعنى الذَهْاب، السَيْر، المَسْلَك، الإزَالَة؛ المَذْهَب: المُعْتَقَد الديني الذي يُذهب إليه) / مَبْدَأ, مَذْهَب (أَسَاس، أَصْل؛ مُسَلَّمَة، اِفْتِرَاض، ما يسلّم به لوضوحه) / فَلْسَفَة, مَذْهَب (في : عِلْمُ الفَلْسَفَة: علم يعنى بوجه الإجمال على بيان أسباب الأشياءِ المادّية والغير المادّية أو ذكر الأشياءِ مع أسبابها وهو يدرس المبادئ الأُولى…؛ في : التشبُّه بالإله حسب الطاقة البشريَّة لتحصيل السعادة الأبديَّة)\nمثال: درس الفلسفة الإسلامية.",
 "philosophy department": "قسم الفلسفة (القسم الأكاديمي المسؤول عن تدريس الفلسفة)",
 "philter": "ترياق الحب, شراب الحب (شراب يُعتقد أن له قوة سحرية؛ يمكن أن يجعل من يتناوله يقع في حب من أعطاه إياه)",
 "philtre": "ترياق الحب, شراب الحب (شراب يُعتقد أن له قوة سحرية؛ يمكن أن يجعل من يتناوله يقع في حب من أعطاه إياه)",
 "philtrum": "نَثْرَة",
 "phimosis": "تضيق القلفة, شبم (ضيق غير طبيعي في القلفة يمنع تراجعها فوق الحشفة)",
 "phiz": "سحنة, محيا (الوجه البشري)",
 "phlebectomy": "استئصال الوريد (إزالة جراحية لكل أو جزء من الوريد؛ يتم إجراؤها أحياناً في حالات الدوالي الشديدة)",
 "phlebitis": "التهاب الوريد (التهاب الوريد (عادة في الساقين))",
 "phlebodium aureum": "بوليبودي ذهبي, سرخس قدم الأرنب (سرخس أمريكي استوائي بجذامير قشرية بنية يزرع لسعفه الكبير المفصص بعمق ذي اللون الأخضر المزرق الداكن؛ يوضع أحياناً في جنس بوليبوديوم)",
 "phlebogram": "صورة الوريد (أشعة سينية لوريد محقون بوسط تباين ظليل للأشعة)",
 "phlebothrombosis": "تخثر وريدي (تخثر الوريد دون التهاب سابق للوريد؛ يرتبط ببطء تدفق الدم (كما في الراحة الطويلة في الفراش أو الحمل أو الجراحة) أو بتخثر سريع للدم)",
 "phlebotomist": "فاصد",
 "phlebotomus": "حمى ذبابة الرمل (مرض فيروسي خفيف ينتقل عن طريق لدغة ذبابة الرمل)",
 "phlebotomus papatasii": "ذبابة الرمل (أي من الذباب الصغير ثنائي الأجنحة المتنوع؛ يمكن للإناث الماصة للدماء نقل حمى ذباب الرمل وداء الليشمانيات)",
 "phlebotomy": "فصد الوريد (شق جراحي في الوريد؛ يستخدم لعلاج داء ترسب الأصبغة الدموية)",
 "phlegm": "بَلْغَم / بَلْغَم, قُشَاعَة",
 "phlegmasia alba dolens": "التهاب الوريد الخثاري, رجل الحليب (تخثر مؤلم للوريد الفخذي في الساق بعد الولادة)",
 "phlegmatic": "بَارِدُ الطَّبْع, بَلْغَمِيّ (قليل الانفعال والتعبير العاطفي)",
 "phlegmatical": "بَارِدُ الطَّبْع, بَلْغَمِيّ (قليل الانفعال والتعبير العاطفي)",
 "phlegmatically": "ببرود أعصاب, ببلادة (بطريقة هادئة وغير مبالية)\nمثال: تقبل القرار ببرود أعصاب",
 "phlegmatizer": "فليغماتايزر, مادة مهدئة للمتفجرات (مادة تضاف إلى مادة متفجرة لجعلها أقل عرضة للانفجار وبالتالي أكثر استقرارًا وأمانًا في التعامل والنقل)",
 "phlegmon": "فَلْغَمُون",
 "phlegmy": "بلغمي (يتميز بوجود البلغم)\nمثال: إفرازات بلغمية",
 "phleum pratense": "تيموثي, عشب القطيع (عشب بسنابل أسطوانية طويلة يُزرع في شمال الولايات المتحدة وأوروبا للقش)",
 "phloem": "لحاء ((علم النبات) نسيج يوصل المواد الغذائية المصنعة (مثل من الأوراق) إلى الأجزاء التي تحتاج إليها؛ يتكون أساسًا من الأنابيب الغربالية)",
 "phlogiston": "فلوجستون (مادة افتراضية كان يعتقد سابقاً بوجودها في جميع المواد القابلة للاحتراق ويتم إطلاقها أثناء الاحتراق)",
 "phlogopite": "فلوغوبيت (شكل بني من الميكا يتكون من سيليكات مائية للبوتاسيوم والمغنيسيوم والألمنيوم)",
 "phlomis": "أذينة, فلوميس (أي من النباتات المختلفة من جنس فلوميس؛ تزرع أساساً لدواماتها الكثيفة من الزهور الشفوية وأوراقها الجذابة)",
 "phlomis fruticosa": "فلوميس شجيري, ميرمية القدس (شجيرة منتشرة في مناطق البحر الأبيض المتوسط تزرع لدواماتها الإبطية الكثيفة من الزهور الأرجوانية أو الصفراء)",
 "phlox": "قبس (قَبَس يقبِس منه النّار واقتبسها:أخذها،والعلم :استفاده؛ قَبَسَ يَقْبِس مِنْهُ نَارا، من حَدِّ ضَرَبَ، واقْتَبَسَهَا: أَخَذَهَا. واقْتَبَسَ العِلْمَ وَمن العِلْم: اسْتَفادَه)",
 "phlox bifida": "قبس رملي (عشب منخفض يشكل حصيرة في الأماكن الصخرية في الولايات المتحدة)",
 "phlox stellaria": "قبس رملي (عشب منخفض يشكل حصيرة في الأماكن الصخرية في الولايات المتحدة)",
 "phlox subulata": "قبس جبلي, قبس طحلبي (قبس معمر منخفض ذو خصلات بأوراق دائمة الخضرة تشبه الإبر وزهور وردية أو بيضاء؛ موطنه الولايات المتحدة ويزرع على نطاق واسع كغطاء أرضي)",
 "phnom penh": "بْنُوم بِنْه",
 "pho": "فُو",
 "phobia": "رُهَاب, فُوبِيَا",
 "phobic": "رُهَابِيّ, فُوبِيّ (يعاني من مخاوف غير عقلانية)",
 "phobic disorder": "اضطراب رهابي, رهاب (اضطراب قلق يتميز بخوف شديد وغير عقلاني من أشياء بسيطة أو مواقف اجتماعية)\nمثال: الاضطراب الرهابي هو مصطلح عام لجميع أنواع الرهاب",
 "phobic neurosis": "اضطراب رهابي, رهاب (اضطراب قلق يتميز بخوف شديد وغير عقلاني من أشياء بسيطة أو مواقف اجتماعية)\nمثال: الاضطراب الرهابي هو مصطلح عام لجميع أنواع الرهاب",
 "phobophobia": "رهاب الرهاب (خوف مرضي من الإصابة برهاب)",
 "phobos": "فوبوس",
 "phoca vitulina": "فقمة الميناء, فقمة شائعة (فقمة مرقطة صغيرة تعيش في المياه الساحلية لنصف الكرة الشمالي)",
 "phocine": "فقمي (متعلق بالفقمات)",
 "phocoena phocoena": "خنزير البحر المينائي (خنزير البحر الشائع في شمال المحيط الأطلسي والمحيط الهادئ)",
 "phocoena sinus": "خنزير البحر الخليجي, فاكيتا (خنزير بحر قصير يعيش في خليج كاليفورنيا؛ نوع مهدد بالانقراض)",
 "phocomelia": "تفقم الأطراف (شذوذ في النمو يكون فيه الجزء العلوي من الذراع أو الساق مفقوداً بحيث تكون اليدين أو القدمين متصلة بالجسم مثل الجذوع؛ حالة نادرة ناتجة عن تناول…)",
 "phoebe": "فيبي",
 "phoebe bird": "فيبي (صائد ذباب صغير بني اللون من أمريكا الشمالية)",
 "phoenicia": "فِينِيقِيَا",
 "phoenician": "فِينِيقِيّ",
 "phoenician language": "الفينيقية (اللغة المنقرضة لشعب سامي قديم هيمن على التجارة في العالم القديم)",
 "phoenix": "فِينِيكْس, فُقْنُس",
 "phoenix dactylifera": "نخلة, نخيل التمر (نخلة استوائية طويلة ريشية الأوراق موطنها سوريا وتحمل فاكهة حلوة صالحة للأكل)",
 "phoenix tree": "شجرة المظلة الصينية, ورنيش ياباني (شجرة نفضية تزرع على نطاق واسع في جنوب الولايات المتحدة كزينة لأوراقها الجميلة التي تشبه القيقب وعناقيدها الطويلة من الزهور الصفراء الخضراء تليها قرون…)",
 "pholiota astragalina": "فوليوت أستراغالينا (فطر بقبعة برتقالية ملساء وخياشيم صفراء وساق أصفر شاحب)",
 "pholiota aurea": "فوليوت ذهبي (فطر جميل ذو خياشيم صفراء يوجد من ألاسكا جنوباً على طول الساحل)",
 "pholiota destruens": "فوليوت مدمر (فطر كبير بقشور بيضاء على القبعة وبقايا الحجاب تتدلى من القبعة؛ الساق سميك وصلب)",
 "pholiota flammans": "فوليوت ملتهب (فطر بقبعة صفراء مغطاة بقشور دقيقة وكذلك الساق)",
