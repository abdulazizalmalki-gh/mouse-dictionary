 "plurale tantum": "اِسْم جَمْع (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)\nمثال: ما اسم حصان توم؟",
 "pluralisation": "تَثْنِيَة وَجَمْع, جَمْع (فعل جعل الكلمة جمعاً أو نسبة التعدد إليها)",
 "pluralism": "تعددية وظيفية (ممارسة شخص واحد لشغل أكثر من منصب ديني في وقت واحد) / تعددية (المذهب القائل بأن الواقع يتكون من عدة مواد أو عناصر أساسية) / تعددية (تنظيم اجتماعي يتم فيه التسامح مع تنوع الجماعات العرقية أو الدينية أو الإثنية أو الثقافية)",
 "pluralist": "تعددي (شخص يعتقد أن المجموعات العرقية أو الثقافية أو الدينية المتميزة يمكن أن تتعايش معاً في المجتمع) / تعددي (فيلسوف يعتقد أنه لا يوجد تفسير واحد يمكن أن يفسر جميع ظواهر الطبيعة) / متعدد المناصب (رجل دين يحمل أكثر من منصب كنسي مدر للدخل في وقت واحد)",
 "pluralistic": "تعددي (من أو يتعلق بمذهب التعددية الفلسفي)\nمثال: ثقافة تعددية",
 "plurality": "أكثرية نسبية, تعددية ((في انتخابات بها أكثر من خيارين) عدد الأصوات للمرشح أو الحزب الذي يحصل على أكبر عدد (ولكن أقل من نصف الأصوات)) / جموع, حشد (كمية كبيرة غير محددة) / تعدد, جمع (حالة الجمع)\nمثال: حشد من النمل",
 "pluralization": "تَثْنِيَة وَجَمْع, جَمْع (فعل جعل الكلمة جمعاً أو نسبة التعدد إليها)",
 "pluralize": "جَمَعَ (ضَمَّ، لَمَّ، حَشَدَ؛ في : أَضَافَ أعدادا إلى غيرها)\nمثال: جمع خيل هو خيول.",
 "plurinational state of bolivia": "دَوْلَة بُولِيڤْيَا مُتَعَدِّدَة الْقَوْمِيَّات (بَلَد يتميز بحُدُود معروفة وشَعْب وحُكُومَة ومُؤَسَسَات مُنَظَّمَة؛ مجموعة من الناس مستقلين متحدين معا لتكوين مجتمع لحماية حقوقهم و وضع قوانينهم الخاصة)\nمثال: لبنان دولة صغيرة.",
 "plus": "زَائِد / بِالْإِضَافَة إِلَى",
 "plus fours": "سروال جولف (سراويل ركبة فضفاضة للرجال تتدلى تحت الركبتين؛ كانت تلبس سابقاً للرياضة (وخاصة الجولف))",
 "plus sign": "عَلَامَة زَائِد, عَلَامَةُ جَمْع (سِمَةٌ أو أمارة أو شِعَار تُعرف به الأشياء؛ رَمْز)\nمثال: تحصلت على علامة أ.",
 "plush": "بَاذِخ, سَخِيّ (يتميّز بالإسراف والوفرة) / قطيفة, قماش وبري (قماش ذو وبر أطول وأنعم من المخمل)",
 "plush-like": "شَبِيهٌ بِالْقَطِيفَةِ, قَطِيفِيّ ((في القوام) يشبه القطيفة)",
 "plushy": "بَاذِخ, سَخِيّ (يتميّز بالإسراف والوفرة) / شَبِيهٌ بِالْقَطِيفَةِ, قَطِيفِيّ ((في القوام) يشبه القطيفة)",
 "pluteus aurantiorugosus": "بلوتوس برتقالي (غاريقون بقبعة قرمزية لامعة وساق نحيلة)",
 "pluteus cervinus": "فطر الغزال (غاريقون صغير صالح للأكل بساق نحيلة؛ يوجد عادة على الأخشاب الصلبة المتعفنة)",
 "pluteus magnus": "فطر نشارة الخشب (غاريقون صالح للأكل يوجد في أكوام نشارة الخشب الصلب؛ القبعات سوداء ومجعدة بشكل خشن)",
 "pluto": "بْلُوتُو (طريقة هجاء بديلة لـ\"بُلُوتُو\")\nمثال: بلوتو مظلم جدا.",
 "plutocracy": "بلوتوقراطية",
 "plutocrat": "بلوتوقراطي (شخص يمارس السلطة بحكم الثروة)",
 "plutocratic": "بلوتوقراطي, حكم الأثرياء (مكون من أو متعلق بـ أو مميز للبلوتوقراطي (حكم الأثرياء))",
 "plutocratical": "بلوتوقراطي, حكم الأثرياء (مكون من أو متعلق بـ أو مميز للبلوتوقراطي (حكم الأثرياء))",
 "pluton": "باثوليت, صخر بلوتوني (كتلة كبيرة من الصخور النارية المتطفلة يعتقد أنها تصلبت في أعماق الأرض)",
 "plutonian": "بُلُوتُونِيّ, جَحِيمِيّ (مُتعلق بالجحيم أو العالم السفلي أو من سماته)",
 "plutonic": "اقْتِحَامِيّ, بُلُوتُونِيّ (صخر ناري تصلّب تحت سطح الأرض؛ كالغرانيت أو الديوريت أو الغابرو)",
 "plutonic rock": "باثوليت, صخر بلوتوني (كتلة كبيرة من الصخور النارية المتطفلة يعتقد أنها تصلبت في أعماق الأرض)",
 "plutonium": "بُلُوتُونِيُوم",
 "plutonium 239": "بلوتونيوم 239 (نظير للبلوتونيوم شديد القابلية للانشطار يُستخدم في الأسلحة الذرية وكوقود للمفاعلات)",
 "plutonium bomb": "قنبلة ذرية, قنبلة نووية (سلاح نووي يتم فيه إطلاق طاقة هائلة عن طريق الانشطار النووي (شطر نوى عنصر ثقيل مثل اليورانيوم 235 أو البلوتونيوم 239))",
 "plutonium pit": "زناد بلوتونيوم (كرة من الصلب أو البريليوم تحتوي على بلوتونيوم 239 تطلق الانشطار النووي عند ضغطها بالمتفجرات)",
 "plutonium trigger": "زناد بلوتونيوم (كرة من الصلب أو البريليوم تحتوي على بلوتونيوم 239 تطلق الانشطار النووي عند ضغطها بالمتفجرات)",
 "pluvianus aegyptius": "زقزاق مصري, طائر التمساح (طائر جليل أفريقي يتغذى على الطفيليات الحشرية على التماسيح)",
 "pluviometer": "مقياس المطر (مقياس يتكون من أداة لقياس كمية هطول الأمطار)",
 "pluviose": "بلوفيوز (الشهر الخامس من التقويم الثوري (يناير وفبراير)؛ الشهر الممطر)",
 "pluviôse": "بْلُوفِيُوز",
 "ply": "طبقة, طية ((عادة في تركيبات) واحدة من عدة طبقات من القماش أو الورق أو الخشب كما في الخشب الرقائقي) / طاقة, طية (إحدى الجدائل المجدولة معاً لصنع خيط أو حبل أو خيط؛ غالباً ما تستخدم في التركيبات)\nمثال: حبل ثلاثي الطيات",
 "plyboard": "أبلكاش, خشب رقائقي (مادة صفائحية مصنوعة من طبقات رقيقة من الخشب)",
 "plyer": "ممارس المهنة (شخص يمارس حرفة ما)",
 "plyers": "زردية, كماشة (أداة يدوية للإمساك بذراعين مفصليين وفكين (عادة) مسننين)",
 "plymouth": "بْلِيمُوث",
 "plymouth rock": "دجاج بليموث روك (سلالة أمريكية من الدجاج المنزلي)",
 "plywood": "خَشَب رَقَائِقِيّ, خَشَب مُعَاكِس (هو ما غَلَظَ وصَلُبَ من أصول الشَجَر وفروعها مثل الجِذْع والأغْصَان؛ هو ما صنع من جذوع أو أغصان الشَجَر)\nمثال: نحن نقطع الخشب.",
 "pm": "تشريح الجثة, فحص ما بعد الوفاة (فحص وتشريح جثة ميت لتحديد سبب الوفاة أو التغيرات الناتجة عن المرض) / بَعْد الظُّهْر, مَسَاءً (بين الظهر ومنتصف الليل) / تضمين الطور (تضمين طور الموجة الحاملة) / رئيس الوزراء البريطاني (الشخص الذي يشغل منصب رئيس الحكومة في المملكة المتحدة)\nمثال: لنلتقي في الساعة 8 مساءً",
 "pmo": "مكتب إدارة المشاريع (الموضع الذي يُكتَب عليه. بعكس المَكْتَب الذي يكتب فيه؛ مِنْضَدَة مخصصة للكتابة، سواء كانت للمَكَاتِب أم لغيرها)\nمثال: عاد إلى المكتب.",
 "pms": "متلازمة ما قبل الحيض (متلازمة تحدث لدى العديد من النساء قبل 2 إلى 14 يوماً من بدء الحيض)",
 "pneumatic": "نيوماتيكي, هوائي (متعلق بالهواء (أو غاز مشابه) أو يستخدمه)\nمثال: مقدح هوائي",
 "pneumatic caisson": "صندوق غاطس, قيسون (حجرة كبيرة مانعة لتسرب الماء تستخدم للبناء تحت الماء)",
 "pneumatic drill": "مقدح هوائي (مقدح آلي يعمل بالهواء المضغوط)",
 "pneumatic hammer": "جاك هامر, مطرقة تكسير (مطرقة تعمل بالهواء المضغوط)",
 "pneumatic tire": "إطار هوائي (إطار مصنوع من المطاط المقوى ومملوء بالهواء المضغوط؛ يستخدم في المركبات والدراجات وغيرها)",
 "pneumatic tyre": "إطار هوائي (إطار مصنوع من المطاط المقوى ومملوء بالهواء المضغوط؛ يستخدم في المركبات والدراجات وغيرها)",
 "pneumatically": "بالهواء المضغوط, هوائياً (بطريقة هوائية (تعمل بالهواء))\nمثال: في الوقت الحاضر، غالباً ما يتم النقل هيدروليكياً أو هوائياً",
 "pneumatics": "علم الغازات المضغوطة, نيوماتيك (فرع الميكانيكا الذي يتعامل مع الخصائص الميكانيكية للغازات)",
 "pneumatophore": "جذر هوائي (جذر مملوء بالهواء (مغمور أو مكشوف) يمكن أن يعمل كعضو تنفسي لنبات المستنقعات)",
 "pneumococcal": "رئوي, مكوري رئوي (متعلق ببكتيريا المكورات الرئوية أو مشتق منها أو ناتج عنها)",
 "pneumococcal pneumonia": "التهاب رئوي بالمكورات الرئوية (التهاب رئوي تسببه بكتيريا من جنس المكورات الرئوية)",
 "pneumococcal vaccine": "لقاح المكورات الرئوية",
 "pneumococcus": "مكورة رئوية (بكتيريا تسبب الالتهاب الرئوي في الفئران والبشر)",
 "pneumoconiosis": "تغبر الرئة, سحار (مرض تنفسي مزمن ناتج عن استنشاق جزيئات معدنية)",
 "pneumocystis carinii pneumonia": "التهاب رئوي بالمتكيسة الجؤجؤية (التهاب رئوي يحدث عند الرضع أو الأشخاص الذين يعانون من ضعف في جهاز المناعة (مثل ضحايا الإيدز))",
 "pneumocystis pneumonia": "التهاب رئوي بالمتكيسة الجؤجؤية (التهاب رئوي يحدث عند الرضع أو الأشخاص الذين يعانون من ضعف في جهاز المناعة (مثل ضحايا الإيدز))",
 "pneumocytosis": "التهاب رئوي بالمتكيسة الجؤجؤية (التهاب رئوي يحدث عند الرضع أو الأشخاص الذين يعانون من ضعف في جهاز المناعة (مثل ضحايا الإيدز))",
 "pneumoencephalogram": "تصوير الدماغ بالغاز, مخطط الدماغ (أشعة سينية للدماغ تُجرى باستبدال السائل النخاعي بغاز (عادة الأكسجين) لتحسين التباين)",
 "pneumogastric": "رئوي معدي (مكون من أو متعلق بـ أو ينطوي على الرئتين والمعدة) / مبهمي (متعلق بالعصب المبهم) / عصب قحفي عاشر, عصب مبهم (عصب مختلط يغذي البلعوم والحنجرة والرئتين والقلب والمريء والمعدة ومعظم الأحشاء البطنية)",
 "pneumogastric nerve": "عصب قحفي عاشر, عصب مبهم (عصب مختلط يغذي البلعوم والحنجرة والرئتين والقلب والمريء والمعدة ومعظم الأحشاء البطنية)",
 "pneumonectomy": "استئصال الرئة (إزالة جراحية لرئة (عادة لعلاج سرطان الرئة))",
 "pneumonia": "ذَات اَلرِّئَة, اِلْتِهَاب رِئَوِيّ",
 "pneumonic": "رئوي (يتعلق بالرئتين أو يؤثر عليهما) / التهابي رئوي (يخص أو يتميز بـ أو مصاب بالالتهاب الرئوي)\nمثال: مرض رئوي",
 "pneumonic plague": "طاعون رئوي (شكل سريع التطور ومميت غالبًا من الطاعون يمكن أن ينتشر عبر الهواء من شخص لآخر؛ يتميز بإصابة الرئة مع قشعريرة ونفث دموي وحمى شديدة)",
 "pneumonitis": "التهاب رئوي (التهاب الرئتين؛ يسببه فيروس أو رد فعل تحسسي)",
 "pneumonoconiosis": "تغبر الرئة, سحار (مرض تنفسي مزمن ناتج عن استنشاق جزيئات معدنية)",
 "pneumothorax": "استرواح الصدر (وجود غير طبيعي للهواء في التجويف الجنبي مما يؤدي إلى انخماص الرئة؛ قد يكون تلقائياً (بسبب إصابة في الصدر) أو مستحثاً (كعلاج لمرض السل))",
 "pneumovax": "لقاح المكورات الرئوية",
 "pnyx": "بنيكس",
 "po": "مكتب البريد الأمريكي (وكالة مستقلة تابعة للحكومة الفيدرالية مسؤولة عن تسليم البريد (وأحيانًا الاتصالات) بين الأفراد والشركات في الولايات المتحدة) / ضابط صف بحري (ضابط صف في البحرية أو خفر السواحل برتبة تعادل رقيب في الجيش) / بولونيوم (عنصر فلزي مشع يشبه التيلوريوم والبزموت)",
 "po box": "صندوق بريد (حجرة مرقمة في مكتب بريد حيث يتم وضع البريد لاستلامه)",
 "po box no": "رقم صندوق البريد (رقم صندوق رسائل في مكتب البريد حيث يتم جمع البريد)",
 "po box number": "رقم صندوق البريد (رقم صندوق رسائل في مكتب البريد حيث يتم جمع البريد)",
 "po valley": "وَادِي بُو",
 "po-faced": "عَابِس, مُسْتَنْكِر (خالٍ من الفكاهة ومُستهجن)",
 "poa nemoralis": "قبأ الغابات (عشبة أوروبية نحيلة في الأماكن الظليلة؛ تزرع أيضاً في شمال شرق أمريكا وآسيا المعتدلة)",
 "poa pratensis": "عشبة كنتاكي الزرقاء, قبأ كنتاكي (عشبة مروج ومراعي قيمة في أوروبا وخاصة وسط الولايات المتحدة ذات سيقان طويلة وأوراق خضراء زاهية نحيلة؛ مكون رئيسي في مخاليط عشب المروج)",
 "poached": "مَسْلُوق, مَطْبُوخٌ بِالمَاء (مَطْهُوٌّ فِي مَاءٍ سَاخِن)",
 "poached egg": "بَيْض مَسْلُوق بِدُونَ قِشْر (الأيام البِيض: الأيام التي توافق اليوم الثالث عشر، والرابع عشر، والخامس عشر من كل شهر من أشهر العام الهجري، وقد سُمِّيت بذلك…)\nمثال: ياني يحب البيض.",
 "poacher": "صَيَّاد غَيْر قَانُونِيّ (اِسْمٌ وَصِفَةٌ لِلْأَسَد)\nمثال: قتل الصياد دبا.",
 "poaching": "صَيْد جَائِر",
 "pob": "صندوق بريد (حجرة مرقمة في مكتب بريد حيث يتم وضع البريد لاستلامه)",
 "pochard": "بط حمرواي, حمرواي (بطة غواصة ثقيلة الجسم من العالم القديم ذات جسم رمادي وأسود ورأس محمر)",
 "pock": "بثرة (بثرة قيحية في مرض طفحي)",
 "pocked": "مُجَدَّر, مُنَقَّر (مُعَلَّم بآثار كآثار الجدري أو حب الشباب) / مُحَفَّر, مُنَقَّر (مليء بالحُفر أو النُّقر الصغيرة على السطح)",
 "pocket": "جَيْب (جيَّب القميص:جَابَ، جعل له جيبًا)\nمثال: جيب سامي مثقوب.",
 "pocket battleship": "بارجة جيب (بارجة صغيرة بنيت للتوافق مع قيود المعاهدات على الحمولة والتسليح (من 1925 إلى 1930))",
 "pocket billiards": "بلياردو الجيوب, بول (أي من الألعاب المختلفة التي تُلعب على طاولة بلياردو لها 6 جيوب)",
 "pocket book": "كتاب جيب (كتاب غلاف ورقي بحجم الجيب)",
 "pocket borough": "دائرة الجيب (بلدة قليلة السكان تكون فيها كل أو معظم الأراضي مملوكة لعائلة واحدة (تاريخياً في بريطانيا))",
 "pocket bread": "خبز بيتا, خبز عربي (خبز مستدير صغير عادة يمكن أن يفتح ليشكل جيباً للحشو)",
 "pocket calculator": "آلة حاسبة للجيب, آلة حاسبة يدوية (آلة حاسبة صغيرة بما يكفي لحملها في اليد أو وضعها في الجيب)",
 "pocket calendar": "تقويم جيب, مفكرة جيب (تقويم صغير مصمم ليوضع في الجيب أو المحفظة؛ يأتي في إصدارات مختلفة، من بطاقة بلاستيكية بسيطة إلى كتيب أو دفتر ملاحظات)\nمثال: جدي لا يزال يستخدم تقويمات الجيب",
 "pocket comb": "مشط جيب (مشط صغير مناسب للحمل في الجيب)",
 "pocket dictionary": "قاموس جيب (قاموس صغير بما يكفي لحمله في جيبك)",
 "pocket edition": "كتاب جيب (كتاب غلاف ورقي بحجم الجيب)",
 "pocket flap": "غطاء الجيب (لسان يغطي فتحة الجيب)",
 "pocket flask": "قارورة جيب (قارورة مسطحة لحفظ المشروبات الروحية)",
 "pocket gopher": "غوفر, غوفر جيبي (قارض حفار من فصيلة الغوفرية له جيوب خدية خارجية كبيرة؛ من أمريكا الوسطى وجنوب غرب أمريكا الشمالية)",
 "pocket knife": "سكين جيب, مِطواة (سكين بشفرة تطوى داخل المقبض؛ مناسب للحمل في الجيب)",
 "pocket lighter": "قداحة, ولاعة سجائر (ولاعة للسيجار أو السجائر)",
 "pocket mirror": "مرآة جيب, مرآة صغيرة (مرآة صغيرة محمولة باليد عادة ما تكون في علبة معدنية أو بلاستيكية مستديرة؛ تستخدم غالباً لتعديل المكياج خارج المنزل)",
 "pocket money": "مَصْرُوف جَيْب, مَصْرُوف",
 "pocket mouse": "فأر جيبي (أي من القوارض الصحراوية الصغيرة الليلية الحفارة ذات جيوب خدية وأرجل خلفية وذيل طويل)",
 "pocket planner": "تقويم جيب, مفكرة جيب (تقويم صغير مصمم ليوضع في الجيب أو المحفظة؛ يأتي في إصدارات مختلفة، من بطاقة بلاستيكية بسيطة إلى كتيب أو دفتر ملاحظات)\nمثال: جدي لا يزال يستخدم تقويمات الجيب",
 "pocket rat": "جرذ الجيب (أي من قوارض متنوعة ذات جيوب خدية)",
 "pocket veto": "فيتو الجيب, نقض غير مباشر (نقض غير مباشر للتشريع برفض توقيعه)",
 "pocket watch": "ساعة جيب (ساعة تُحمل في جيب ساعة صغير)",
 "pocket-handkerchief": "منديل جيب (منديل يُحمل في الجيب)",
 "pocket-size": "بِحَجْم الجَيْب (صغير بما يكفي لحمله في جيب الثوب) / صَغِير, مَحْدُود النِّطَاق (صَغير الحَجْم أَوْ مَحْدود في النِّطاق أَوْ الأَهَمِّيَّة)",
 "pocket-sized": "بِحَجْم الجَيْب (صغير بما يكفي لحمله في جيب الثوب) / صَغِير, مَحْدُود النِّطَاق (صَغير الحَجْم أَوْ مَحْدود في النِّطاق أَوْ الأَهَمِّيَّة)",
 "pocketable": "بِحَجْم الجَيْب (صغير بما يكفي لحمله في جيب الثوب)",
 "pocketbook": "حقيبة يد (حاوية تستخدم لحمل النقود والأغراض الشخصية الصغيرة (خاصة من قبل النساء)) / كتاب جيب (كتاب غلاف ورقي بحجم الجيب) / محفظة (حافظة بحجم الجيب لحمل الأوراق والنقود الورقية) / جيب, مقدرة مالية (وسائلك المالية الشخصية)\nمثال: مدت يدها في حقيبتها ووجدت مشطاً",
 "pocketbook issue": "قضية معيشية, مسألة اقتصادية (قضية ستؤثر تسويتها على الموارد المالية)",
 "pocketcomb": "مشط جيب (مشط صغير مناسب للحمل في الجيب)",
 "pocketed bat": "خفاش ذيل حر جيبي (خفاش بني صغير من كاليفورنيا وشمال المكسيك)",
 "pocketed free-tailed bat": "خفاش ذيل حر جيبي (خفاش بني صغير من كاليفورنيا وشمال المكسيك)",
 "pocketed freetail bat": "خفاش ذيل حر جيبي (خفاش بني صغير من كاليفورنيا وشمال المكسيك)",
 "pocketful": "ملء جيب (الكمية التي يستوعبها جيب)",
 "pocketknife": "سكين جيب, مِطواة (سكين بشفرة تطوى داخل المقبض؛ مناسب للحمل في الجيب)",
 "pockmark": "أثر بثرة, ندبة جدري (ندبة أو حفرة على الجلد تتركها بثرة جدري أو حب شباب أو مرض طفح جلدي آخر)",
 "pockmarked": "مُجَدَّر, مُنَقَّر (مُعَلَّم بآثار كآثار الجدري أو حب الشباب) / مُحَفَّر, مُنَقَّر (مليء بالحُفر أو النُّقر الصغيرة على السطح)",
 "pod": "حاوية وقود قابلة للفصل (حاوية وقود قابلة للفصل في الطائرة) / قطيع مائي (مجموعة من الثدييات المائية) / قرن (فاكهة متفتحة متعددة البذور كما في النباتات البقولية) / غِلافُ البُذُور, قَرْن (الوعاء الذي يحتوي على بذور النبات (وليس البذور نفسها))",
 "podalgia": "ألم القدم (ألم في القدم)",
 "podaxaceae": "بوداكساسيا (نوع من الفطريات المعدية)",
 "podetium": "حامل ثمري, سويقة (عضو أو جسم يشبه الساق؛ خاصة النتوء من مشرة بعض الأشنات الذي يحمل الجسم الثمري)",
 "podgorica": "بُودْغُورِيتْشَا",
 "podgy": "قَصِير وَبَدِين, مُكَتَّل (قَصِير القَامَة وَمُمْتَلِئ الجِسْم)",
 "podiatrist": "أخصائي أقدام, طبيب أقدام (أخصائي في العناية بالقدمين)",
 "podiatry": "طب الأقدام (فرع الطب المعني بالقدمين)",
 "podiceps cristatus": "غطاس متوج كبير (غطاس كبير من العالم القديم ذو خصلات أذن سوداء)",
 "podiceps grisegena": "غطاس أحمر الرقبة (غطاس ممتلئ الجسم كبير من المناطق القطبية ذو رقبة داكنة)",
 "podiceps nigricollis": "غطاس أسود الرقبة (غطاس صغير ذو خصلات أذن صفراء ورقبة سوداء؛ يوجد في أوراسيا وجنوب أفريقيا وكذلك غرب الولايات المتحدة)",
 "podiceps ruficollis": "غطاس صغير (غطاس أوروبي صغير)",
 "podicipitiform seabird": "غطاسيات (طيور مائية قريبة من الغواصات)",
 "podilymbus podiceps": "غطاس مبقع المنقار (غطاس أمريكي ذو منقار مبيض مخطط بالأسود)",
 "podium": "مِنَصَّة",
 "podlike": "شَبِيه بِالقَرْن (يُشبه القَرن أو الغِمد النباتيّ)",
 "podocarp": "بودوكارب, معلاقية (أي شجرة دائمة الخضرة في نصف الكرة الجنوبي من جنس بودوكاربوس ذات ثمار لبية ببذرة واحدة صلبة)",
 "podocarpus amara": "بودوكاربوس مر, سونداكاربوس (شجرة استوائية دائمة الخضرة كبيرة سريعة النمو أحادية المسكن ذات أوراق رمحية لامعة كبيرة؛ من الغابات المطيرة في سومطرة والفلبين إلى شمال كوينزلاند)",
 "podocarpus coriaceus": "بودوكاربوس جلدي, ياكا (شجرة دائمة الخضرة في جزر الهند الغربية بأوراق متوسطة إلى طويلة)",
 "podocarpus dacrydioides": "صنوبر أبيض نيوزيلندي, كاهيكاتيا (شجرة دائمة الخضرة في نيوزيلندا تقدر لخشبها الخفيف سهل التشغيل)",
 "podocarpus elatus": "بودوكاربوس روكينغهام, صنوبر بني (شجرة أسترالية كبيرة بخشب أصفر مستقيم الحبيبات يتحول إلى البني عند التعرض للهواء)",
 "podocarpus elongatus": "خشب أصفر أفريقي, خشب أصفر الكاب (شجرة أو شجيرة جنوب أفريقية ذات تاج مستدير)",
 "podocarpus ferruginea": "صنوبر أسود, ميرو (صنوبرية نيوزيلندية تستخدم للأخشاب؛ يستخدم الخشب الداكن للنجارة الداخلية)",
 "podocarpus latifolius": "بودوكاربوس عريض الأوراق, خشب أصفر جنوب أفريقي (شجرة منتصبة أو شجيرية في أفريقيا ذات لحاء رمادي داكن مخدد وأوراق صلبة لامعة متوسطة إلى طويلة)",
 "podocarpus nivalis": "توتارا ألبية (شجيرة صنوبرية منخفضة واسعة الانتشار في جبال نيوزيلندا)",
 "podocarpus spicata": "صنوبر أسود, ماتاي (صنوبرية في أستراليا ونيوزيلندا)",
 "podocarpus totara": "بودوكاربوس توتارا, توتارا (شجرة خشبية قيمة في نيوزيلندا تنتج خشباً محمراً صلباً يستخدم للأثاث والجسور والأرصفة)",
 "podophyllum peltatum": "تفاح مايو, يبروح بري (عشب من أمريكا الشمالية ذو ساق جذري سام وثمرة صالحة للأكل رغم طعمها غير المستساغ)",
 "podsol": "بودزول (تربة تتطور في المناخات المعتدلة إلى الباردة الرطبة تحت الغطاء النباتي الصنوبري أو الخلنجي؛ حصيرة عضوية فوق طبقة رمادية مغسولة)",
 "podsol soil": "بودزول (تربة تتطور في المناخات المعتدلة إلى الباردة الرطبة تحت الغطاء النباتي الصنوبري أو الخلنجي؛ حصيرة عضوية فوق طبقة رمادية مغسولة)",
 "podsolic soil": "بودزول (تربة تتطور في المناخات المعتدلة إلى الباردة الرطبة تحت الغطاء النباتي الصنوبري أو الخلنجي؛ حصيرة عضوية فوق طبقة رمادية مغسولة)",
 "podzol": "بودزول (تربة تتطور في المناخات المعتدلة إلى الباردة الرطبة تحت الغطاء النباتي الصنوبري أو الخلنجي؛ حصيرة عضوية فوق طبقة رمادية مغسولة)",
 "podzol soil": "بودزول (تربة تتطور في المناخات المعتدلة إلى الباردة الرطبة تحت الغطاء النباتي الصنوبري أو الخلنجي؛ حصيرة عضوية فوق طبقة رمادية مغسولة)",
 "poecile atricapillus": "قرقف أسود التاج (قرقف ذو تاج داكن)",
 "poecile carolinensis": "قرقف كارولينا (قرقف من جنوب الولايات المتحدة يشبه القرقف أسود التاج ولكنه أصغر)",
 "poeciliid": "بوسيلي, سمك البعوض (أسماك صغيرة ولودة زاهية الألوان عادة، تتغذى عند السطح في المياه العذبة أو قليلة الملوحة الدافئة؛ تستخدم غالباً في مكافحة البعوض)",
 "poeciliid fish": "بوسيلي, سمك البعوض (أسماك صغيرة ولودة زاهية الألوان عادة، تتغذى عند السطح في المياه العذبة أو قليلة الملوحة الدافئة؛ تستخدم غالباً في مكافحة البعوض)",
 "poecilocapsus lineatus": "بق النبات رباعي الخطوط (بق أوراق أصفر أو برتقالي بأربعة خطوط سوداء أسفل الظهر؛ واسع الانتشار في وسط وشرق أمريكا الشمالية)",
 "poecilogale albinucha": "ابن عرس الثعباني (ابن عرس صغير نحيل يحفر الجحور ذو قمة رأس بيضاء)",
 "poem": "قَصِيدَة, شِعْر",
 "poenology": "علم العقاب (فرع علم الجريمة المعني بإدارة السجون وإعادة تأهيل السجناء)",
 "poephila castanotis": "عصفور الزيبرا (طائر حباك أسترالي صغير ذو علامات تشبه الحمار الوحشي)",
 "poesy": "شعر, نظم (أدب في شكل موزون)",
 "poet": "شَاعِر, شَاعِرَة",
 "poet laureate": "شاعر البلاط (الشاعر المعين رسمياً في البلاط الملكي في بريطانيا العظمى) / أمير الشعراء, شاعر متوج (شاعر يُنظر إليه بشكل غير رسمي على أنه يشغل منصباً فخرياً في مجموعة أو منطقة معينة)\nمثال: يُتوقع من شاعر البلاط تقديم قصائد للمناسبات الوطنية الكبرى",
 "poet-singer": "تروبادور, مغني شعبي (مغنٍ للأغاني الشعبية والفلكلورية)",
 "poetaster": "شُوَيْعِر, مُتَشَاعِر",
 "poetess": "شَاعِرَة",
 "poetic": "شِعْرِيّ",
 "poetic justice": "عدالة شعرية (مصدر للفعل عَدَلَ بمعنى أقْسَطَ ولم يجر؛ العَدْل، هو التعامل مع الناس بالقِسْط والإنْصَاف)\nمثال: يريدون العدالة.",
 "poetic licence": "ضَرُورَة شِعْرِيَّة",
 "poetic license": "رخصة شعرية, ضرورة شعرية (رخصة يستخدمها الكاتب أو الفنان لتعزيز تأثير عمله)",
 "poetic rhythm": "إيقاع شعري, عروض ((عروض) نظام للنظم الشعري)",
 "poetical": "شَاعِرِيّ, شِعْرِيّ (من خصائص الشعر أو يليق به) / شعري (متعلق بالشعر)\nمثال: أعمال شعرية",
 "poetically": "شعرياً (بطريقة شعرية)\nمثال: معبر عنه شعرياً",
 "poeticism": "تعبير شعري (عبارة أو قول شعري)",
 "poetics": "شعرية, فن الشعر (دراسة الأعمال الشعرية)",
 "poetiser": "شويعر, ناظم القوافي (كاتب يؤلف القوافي؛ صانع أبيات رديئة (تستخدم عادة كعبارة ازدراء للشعراء القصر أو الدونيين))",
 "poetizer": "شويعر, ناظم القوافي (كاتب يؤلف القوافي؛ صانع أبيات رديئة (تستخدم عادة كعبارة ازدراء للشعراء القصر أو الدونيين))",
 "poetry": "شِعْر (العِلْم؛ في : هو كلام مُقَفَّى ومُوَازَن على أوزان معروفة يُقصد به إظهار الكلام بصيغة فنية)\nمثال: شعر ماريا طويل.",
 "poets": "سورة الشعراء",
 "pogey": "إعانة البطالة, صدقة حكومية (أموال يتم تلقيها من الدولة (كمساعدة))",
 "pogge": "بوجي, رأس الثور المدرع (صياد بحر شمال الأطلسي)",
 "pogo stick": "عصا القفز (لعبة تتكون من عمود به مساند للقدمين ونابض قوي؛ تدفع عن طريق القفز)",
 "pogonia": "بوجونيا (أي أوركيد مستنقعات قوي التحمل من جنس بوجونيا: بساتين فاكهة أرضية ذات جذامير نحيلة وسيقان منتصبة تحمل ورقة واحدة أو بضع أوراق وزهرة طرفية وحيدة)",
 "pogonia divaricata": "أوركيد برعم الورد قمعي العرف, بوجونيا منتشرة (أوركيد في شمال شرق الولايات المتحدة بزهور وردية أرجوانية ذات شفة قمعية الشكل؛ يوضع أحياناً في جنس بوجونيا)",
 "pogonia rosea": "أوركيد برعم الورد (أوركيد في وسط وشمال أمريكا الجنوبية ذو عناقيد من 1 إلى 3 زهرات وردية كبيرة مبهرجة؛ يوضع أحياناً في جنس بوجونيا)",
 "pogonion": "ذقينية (نقطة قياس القحف التي تعد النقطة الأكثر بروزاً للأمام على السطح الأمامي للذقن)",
 "pogonip": "ضباب جليدي (ضباب شتوي كثيف يحتوي على جزيئات ثلجية)",
 "pogonophoran": "دودة لحوية (حيوان نحيل له مجسات وغطاء خارجي يشبه الأنبوب؛ يعيش في قاع المحيط العميق)",
 "pogostemon cablin": "باتشولي, بتشول (نعناع شجيري صغير من جزر الهند الشرقية؛ يستخدم الزيت العطري المستخرج من أوراقه في العطور)",
 "pogrom": "مَذْبَحَة, بُوجْرُوم (الحَادِثَة أو المَعْرَكَة التي يقتل فيها ناس كثيرون)",
 "pogy": "إعانة البطالة, صدقة حكومية (أموال يتم تلقيها من الدولة (كمساعدة))",
 "poi": "بوي (طبق من هاواي من جذور القلقاس المهروسة لتصبح عجينة وغالباً ما تترك لتتخمر)",
 "poignance": "تأثر شديد, شجن (حالة من الضيق أو الحزن العميق)\nمثال: لحظة من الشجن الاستثنائي",
 "poignancy": "إثارة المشاعر, شجن (صفة تثير العواطف (خاصة الشفقة أو الحزن)) / تأثر شديد, شجن (حالة من الضيق أو الحزن العميق)\nمثال: الفيلم جسد كل الشجن في وضعهم",
 "poignant": "مُؤَثِّر, مُبَكٍّ (يثير المشاعر والعواطف) / مُؤَثِّر, مُحْزِن (بَالِغُ الإِيلَامِ لِلنَّفْسِ أَوِ المَشَاعِر)",
 "poignantly": "بشكل مؤثر, بشكل يلامس المشاعر (بطريقة مؤثرة أو تلامس المشاعر)\nمثال: تحدثت بشكل مؤثر",
 "poikilotherm": "ذوات الدم البارد, كائن متغير الحرارة (حيوان تتغير درجة حرارة جسمه مع درجة حرارة محيطه؛ أي حيوان باستثناء الطيور والثدييات)",
 "poikilothermic": "مُتَغَيِّر الحَرَارَة (ذو حرارة جسم تتغيّر بحسب البيئة؛ يوصف به الحيوانات عدا الطيور والثدييّات)",
 "poikilothermous": "مُتَغَيِّر الحَرَارَة (ذو حرارة جسم تتغيّر بحسب البيئة؛ يوصف به الحيوانات عدا الطيور والثدييّات)",
 "poilu": "بيرلو (يخنة كثيفة مصنوعة من الأرز والدجاج والصيد الصغير؛ جنوب الولايات المتحدة) / بوالو (جندي فرنسي (خاصة في الحرب العالمية الأولى))",
 "poinciana": "بوانسيانا, عصفور الجنة (شجيرة مزهرة استوائية لها زهور برتقالية زاهية أو حمراء؛ تصنف أحياناً في جنس بوانسيانا)",
 "poinciana gilliesii": "بوانسيانا, عصفور الجنة (شجيرة مزهرة استوائية لها زهور برتقالية زاهية أو حمراء؛ تصنف أحياناً في جنس بوانسيانا)",
 "poinciana pulcherrima": "زهرة الجنة, زهرة الطاووس (شجيرة استوائية أو شجرة صغيرة لها زهور صفراء إلى برتقالية حمراء مبهرجة؛ تصنف أحياناً في جنس بوانسيانا)",
 "poinciana regia": "بوانسيانا ملكية, زهرة الطاووس (شجرة استوائية مبهرجة أو شجيرة موطنها مدغشقر؛ تزرع على نطاق واسع في المناطق الاستوائية لعناقيدها الضخمة من الزهور القرمزية والبرتقالية؛ تصنف أحياناً…)",
 "poinsettia": "بنت القنسول",
 "poinsettia strain": "ذبابة بيضاء فائقة (سلالة من الآفات تم استيرادها عن طريق الخطأ إلى فلوريدا من الشرق الأوسط ثم انتشرت إلى كاليفورنيا حيث تعد آفة خطيرة جداً تتغذى على جميع محاصيل الخضروات…)",
 "point": "نُقْطَة (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه) / مَوْقِع (موضع الوُقُوع؛ الموضع الذي حَدَثَ أو يحدث فيه حادث) / أَشَارَ\nمثال: هذه هي نقطة ضعفه.",
 "point after": "نقطة إضافية (في كرة القدم الأمريكية، نقطة تُمنح لركلة ناجحة بعد التاتش داون)",
 "point after touchdown": "نقطة إضافية (في كرة القدم الأمريكية، نقطة تُمنح لركلة ناجحة بعد التاتش داون)",
 "point duty": "خدمة تنظيم المرور (السيطرة على حركة المرور بواسطة شرطي متمركز عند تقاطع)",
 "point in time": "لحظة, نقطة زمنية (لحظة من الزمن)\nمثال: في تلك اللحظة اضطررت للمغادرة",
 "point lace": "تطريز بالإبرة, دانتيل الإبرة (دانتيل مشغول بإبرة بغرزة العروة على نمط ورقي)",
 "point man": "رجل المقدمة (شخص في طليعة مشروع مهم) / جندي الطليعة (جندي ذكر يتقدم دورية الاستطلاع)\nمثال: هو رجل المقدمة للرئيس في القضايا الاقتصادية",
 "point mass": "كتلة نقطية (مفهوم لمادة صغيرة جداً بشكل لا نهائي، أو جسم يمكن اعتباره صغيراً جداً بشكل لا نهائي)\nمثال: على عكس الجسيمات النقطية، لا ينطبق مفهوم الكتلة النقطية إلا على جسم صغير بشكل لا نهائي",
 "point mutation": "طفرة جينية, طفرة نقطية ((في علم الوراثة) طفرة ناتجة عن إعادة تنظيم داخل الجزيء لجين ما)",
 "point of accumulation": "حد رياضي, نهاية (القيمة الرياضية التي تتجه إليها الدالة عندما يقترب المتغير المستقل من اللانهاية)",
 "point of apoapsis": "أوج, نقطة الأوج ((في الفلك) النقطة في المدار الأبعد عن الجرم الذي يتم الدوران حوله)",
 "point of articulation": "مَخْرَج",
 "point of departure": "منصة انطلاق, نقطة انطلاق (بداية ينطلق منها مشروع) / نقطة الانطلاق (مكان يتم منه إطلاق مشروع أو رحلة استكشافية)\nمثال: يستخدم أفكار الآخرين كنقطة انطلاق لأفكاره الخاصة",
 "point of entry": "منفذ دخول, ميناء دخول (ميناء في الولايات المتحدة يتمركز فيه مسؤولو الجمارك للإشراف على دخول وخروج الأشخاص والبضائع)",
 "point of honor": "مسألة شرف (اهتمام يعكس بجدية شرفك)",
 "point of intersection": "تقاطع, نقطة تقاطع (نقطة تتقاطع فيها الخطوط)",
 "point of no return": "نُقْطَةُ اللَّاعَوْدَةِ, حُصِّلَ مَا فِي الصُّدُورِ (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه)\nمثال: هذه هي نقطة ضعفه.",
 "point of order": "نُقْطَة نِظَام (تساؤل حول ما إذا كانت الإجراءات الحالية مسموحاً بها وفقاً للقواعد البرلمانية)",
 "point of periapsis": "حضيض, نقطة الحضيض ((في الفلك) النقطة في المدار الأقرب إلى الجسم الذي يتم الدوران حوله)",
 "point of reference": "مرجع, نقطة مرجعية (مؤشر يوجهك بشكل عام)",
 "point of view": "وِجْهَة نَظَر, حَيْثِيَّة / وِجْهَة نَظَر",
 "point out": "أَشَارَ",
 "point person": "جندي استطلاع, رأس الحربة (جندي يتقدم دورية الاستطلاع)",
 "point size": "حجم النقطة (عرض وارتفاع المحرف، مقاساً بالنقاط)",
 "point source": "مصدر نقطي (مصدر مركز (خاصة للإشعاع أو التلوث) يكون محدودًا مكانيًا)",
 "point system": "نظام النقاط (نظام للتقييم يعتمد على منح النقاط وفقًا لقواعد محددة) / نظام النقط (نظام للكتابة أو الطباعة يستخدم أنماطاً من النقاط البارزة التي يمكن قراءتها باللمس) / نظام النقاط (نظام لتدريج أحجام الحروف الطباعية بمضاعفات النقطة)",
 "point woman": "امرأة المقدمة (امرأة في طليعة مشروع مهم) / جندية الطليعة (جندية أنثى تتقدم دورية الاستطلاع)",
 "point-and-shoot camera": "كاميرا صوّب والتقط, كاميرا مدمجة (كاميرا تصوير خفيفة الوزن ذات تركيز تلقائي)",
 "point-blank": "بشكل مباشر, بصراحة تامة (بطريقة مباشرة ولا لبس فيها) / مِنْ مَسَافَةٍ قَرِيبَة (قَرِيب بِمَا يَكْفِي لِلإِصَابَة المُبَاشِرَة لِلهَدَف) / صَرِيح, فَصِيح (يَتَّسِم بِالمُبَاشَرَة فِي الأُسْلُوب أَوِ الكَلَام؛ بِدُون مُوَارَبَة أَوْ تَهَرُّب)\nمثال: سألته بصراحة تامة عما إذا كان يريد الوظيفة",
 "point-contact diode": "ثنائي نقطي, ديود نقطة الاتصال (مقوم شبه موصل يستخدم الحاجز المتشكل بين سطح شبه موصل مُجهز بشكل خاص ونقطة معدنية لإنتاج عمل التقويم)\nمثال: يعمل ديود نقطة الاتصال على نفس مبدأ ديود الوصلة، لكن تركيبه أبسط",
 "point-of-sale": "عند نقطة البيع (من أو متعلق بـ أو كونه الموقع الذي يتم فيه شراء شيء ما)",
 "pointed": "لَاذِع, مَقْصُود (مُبَاشِر وَوَاضِح فِي المَعْنَى أَوِ الإِشَارَة؛ غَالِبًا غَيْر مُسْتَحَبّ) / حاد الرأس, مدبب (له رأس حاد أو نقطة)",
 "pointed arch": "قوس مدبب (قوس بقمة مدببة؛ سمة من سمات العمارة القوطية)",
 "pointed cabbage": "مَلْفُوف مَخْرُوطِيّ",
 "pointed-leaf maple": "قيقب مدبب الأوراق (نبات ياباني شجيري صغير بأوراق لها 5 إلى 7 فصوص مستدقة؛ أصفر في الخريف)",
 "pointed-toe": "مُدَبَّبُ المُقَدِّمَة (ذُو مُقَدِّمَةٍ مُدَبَّبَةٍ (فِي الحِذَاءِ))",
 "pointedly": "بتعمد, بشكل ملحوظ (بطريقة تجعل أمراً ما واضحاً وجلياً)\nمثال: تجاهل السؤال بشكل متعمد",
 "pointedness": "حدة, خصوصية التوجيه (صفة التوجيه الواضح لشخص أو شيء معين) / تدبب (خاصية شكل يستدق لينتهي بطرف حاد)\nمثال: كانت حدة سخريته لا لبس فيها",
 "pointel": "أداة نقش, منقاش (أداة يستخدمها النقاش)",
 "pointer": "مُؤَشِّر",
 "pointfulness": "أَهَمِّيَّة, مَغْزَى (حالة أو شرط امتلاك معنى أو صلة أو قوة)",
 "pointillism": "تنقيطية (نوع من الرسم يتميز بتطبيق الطلاء في نقاط وضربات صغيرة؛ طوره جورج سوراه وأتباعه في أواخر القرن التاسع عشر في فرنسا) / التنقيطية (مدرسة للرسامين استخدمت تقنية الرسم بنقاط صغيرة من الألوان النقية تمتزج في عين المشاهد؛ طورت بواسطة جورج سوراه وأتباعه في أواخر القرن التاسع عشر في…)",
 "pointillist": "تَنْقِيطِيّ (متعلّق بالأسلوب التنقيطيّ في الرسم) / تنقيطي, فنان تنقيطي (رسام يستخدم تقنية التنقيط)",
 "pointillistic": "تَنْقِيطِيّ (متعلّق بالأسلوب التنقيطيّ في الرسم)",
 "pointing out": "إشارة, تبيان (دلالة عن طريق العرض أو التوضيح)",
 "pointing trowel": "مسطرين الكحلة (مسطرين يستخدم لملء وإنهاء فواصل البناء بالملاط أو الأسمنت)",
 "pointless": "بدون جدوى",
 "pointlessly": "بلا جدوى, بلا هدف (بطريقة لا طائل منها)\nمثال: قضى حياته في كدح متعب بلا جدوى",
 "pointlessness": "حماقة, سخف (الافتقار التام للمعنى أو الأفكار)",
 "pointlike mass": "كتلة نقطية (مفهوم لمادة صغيرة جداً بشكل لا نهائي، أو جسم يمكن اعتباره صغيراً جداً بشكل لا نهائي)\nمثال: على عكس الجسيمات النقطية، لا ينطبق مفهوم الكتلة النقطية إلا على جسم صغير بشكل لا نهائي",
 "pointrel": "أداة نقش, منقاش (أداة يستخدمها النقاش)",
 "points": "مَفْصِل, مِفْتَاح",
 "pointsman": "شرطي مرور (شرطي يتمركز عند تقاطع لتوجيه حركة المرور)",
 "pointswoman": "شرطية مرور (شرطية تتمركز عند تقاطع لتوجيه حركة المرور)",
 "pointy": "مُدَبَّب",
 "pointy-toed": "مُدَبَّبُ المُقَدِّمَة (ذُو مُقَدِّمَةٍ مُدَبَّبَةٍ (فِي الحِذَاءِ))",
 "poise": "ثبات, ثقة بالنفس (برود أعصاب وهدوء كبير تحت الضغط) / بواز (وحدة للزوجة الديناميكية في نظام السنتيمتر-غرام-ثانية) / اتزان, توازن (حالة من التوازن المستقر)\nمثال: حافظ على هدوئك",
 "poised": "مُتَأَهَّب, ّمُسْتَعِدّ / تَوَازُن",
 "poison": "سُمّ, سَمّ (في : حرف جواب بمعنى مُرْ يأتي بعد النداء فقط) / سَمَّمَ, سَمَّ\nمثال: تناول سامي السم.",
 "poison arrow plant": "حلوى الشتاء, نبات السهم السام (شجرة شجيرية متوسطة الحجم من جنوب أفريقيا ذات أوراق جلدية سميكة دائمة الخضرة وأزهار بيضاء أو وردية وثمار كروية عادة ما تكون سوداء أرجوانية ذات بذرتين)",
 "poison ash": "سم الشجر, سماق سام (شجيرة مستنقعات أمريكية ملساء ذات أوراق ريشية وأزهار مخضرة يليها توت أبيض مخضر؛ تنتج زيتاً مهيجاً)",
 "poison bush": "بازلاء دارلينغ, سواينسونا (أي من نباتين أستراليين من جنس سواينسونا سامة للأغنام) / بازلاء سامة, جاسترولوبيوم (أي من الشجيرات الأسترالية دائمة الخضرة المتنوعة من جنس جاسترولوبيوم، لها أوراق مركبة دوارية سامة للماشية وزهور صفراء أو برتقالية محمرة بارزة تليها…)",
 "poison camas": "زيجادينوس نوتالي, كاماسيا سامة (كاماسيا موت معمرة شائعة؛ تينيسي إلى كانساس إلى تكساس)",
 "poison dogwood": "سم الشجر, سماق سام (شجيرة مستنقعات أمريكية ملساء ذات أوراق ريشية وأزهار مخضرة يليها توت أبيض مخضر؛ تنتج زيتاً مهيجاً)",
 "poison gas": "غاز سام (غاز سام عند التنفس أو التلامس؛ يستخدم في الحرب الكيميائية)",
 "poison hemlock": "سيكران, شوكران (عشب كبير متفرع ثنائي الحول موطنه أوراسيا وأفريقيا ووافد إلى أمريكا الشمالية، له أوراق كبيرة تشبه السرخس وأزهار بيضاء؛ يوجد عادة في البيئات الرطبة؛…)",
 "poison ivy": "لَبْلَاب",
 "poison milkweed": "صقلاب ذيل الحصان, صقلاب سام (صقلاب من جنوب غرب الولايات المتحدة والمكسيك؛ سام للماشية)",
 "poison oak": "لبلاب سام (نبات متسلق شائع في شرق ووسط الولايات المتحدة بأوراق ثلاثية وأزهار مخضرة يليها توت أبيض؛ ينتج زيتاً مهيجاً يسبب طفحاً جلدياً عند اللمس) / البلوط السام (التهاب الجلد الناتج عن ملامسة نبات البلوط السام)",
 "poison parsley": "سيكران, شوكران (عشب كبير متفرع ثنائي الحول موطنه أوراسيا وأفريقيا ووافد إلى أمريكا الشمالية، له أوراق كبيرة تشبه السرخس وأزهار بيضاء؛ يوجد عادة في البيئات الرطبة؛…)",
 "poison pea": "بازلاء سامة, جاسترولوبيوم (أي من الشجيرات الأسترالية دائمة الخضرة المتنوعة من جنس جاسترولوبيوم، لها أوراق مركبة دوارية سامة للماشية وزهور صفراء أو برتقالية محمرة بارزة تليها…)",
 "poison pill": "حبة سامة (استراتيجية دفاعية تجعل أسهم الشركة المستهدفة أقل جاذبية للمستحوذ)",
 "poison sumac": "سم الشجر, سماق سام (شجيرة مستنقعات أمريكية ملساء ذات أوراق ريشية وأزهار مخضرة يليها توت أبيض مخضر؛ تنتج زيتاً مهيجاً) / السماق السام (التهاب الجلد الناتج عن ملامسة نبات السماق السام)",
 "poison-berry": "عنب الديب, مغد أسود (عشب أوراسي تم توطينه في أمريكا له زهور بيضاء وأوراق مشعرة سامة ويحمل توتاً أسود يكون ساماً أحياناً ولكنه صالح للأكل أحياناً أخرى)",
 "poisonberry": "عنب الديب, مغد أسود (عشب أوراسي تم توطينه في أمريكا له زهور بيضاء وأوراق مشعرة سامة ويحمل توتاً أسود يكون ساماً أحياناً ولكنه صالح للأكل أحياناً أخرى)",
 "poisoned": "مَسْمُوم",
 "poisoner": "داسّ السم, مُسَمِّم (شخص يقتل باستخدام السم)",
 "poisoning": "تَسْمِيم / تَسَمُّم",
 "poisonous": "سَامّ",
 "poisonous nightshade": "عنب الديب, مغد حلو ومر (كرمة معمرة سامة من العالم القديم لها زهور بنفسجية وتوت أحمر مرجاني بيضاوي؛ عشب ضار واسع الانتشار في أمريكا الشمالية)",
 "poisonous parasol": "مظلة سامة (غاريقون يعتبر ساماً)",
 "poisonous plant": "نبات سام (نبات يمكن أن يكون ضاراً أو مميتاً للكائن الحي عند لمسه أو تناوله بكمية كافية)",
 "poisonous substance": "سم, مادة سامة (أي مادة تسبب إصابة أو مرض أو موت كائن حي)",
 "poisonously": "بخبث, بسمية (بطريقة خبيثة جداً)",
 "poisson distribution": "توزيع بواسون (توزيع نظري يعد تقريباً جيداً للتوزيع ذي الحدين عندما يكون الاحتمال صغيراً وعدد المحاولات كبيراً)",
 "poitou-charentes": "بواتو شارنت",
 "poitrine d'agneau": "صدر ضأن (قطعة من الضأن تشمل عظم القص والعضلات المتصلة به مجهزة كلحم)",
 "poivrade": "بويفراد, صلصة الفلفل (للحم الغزال: صلصة بنية مع خضروات مقلية وتتبيلة والكثير من الفلفل)",
 "poke": "خَزَّ (\"خَزَّهُ بسكِّينٍ\" : طَعَنَهُ بِهِ؛ \"خَزَّهُ بِبَصَرِهِ\" : أَصَابَتْهُ عَيْنُه)\nمثال: إذا كنت وخز لنا، هل نحن لا ينزف؟",
 "poke bonnet": "بونيه, قبعة مربوطة (قبعة تُربط تحت الذقن)",
 "poke check": "إبعاد بالعصا, وخز القرص (إبعاد القرص عن طريق وخزه بعصا الهوكي)",
 "poke milkweed": "صقلاب طويل (صقلاب من شرق الولايات المتحدة بأوراق تشبه أوراق الصبغة الأمريكية)",
 "poker": "سِطَام, مِسْعَار / بُوكَر, بُوكِر",
 "poker alumroot": "هيوشيرا أسطوانية (نبات بنصال أوراق جلدية على شكل قلب متجمعة عند قاعدة سيقان طويلة مع زهور بيضاء مخضرة متجمعة على الجزء العلوي؛ غرب أمريكا الشمالية)",
 "poker chip": "رقاقة بوكر, فيشة (عداد صغير على شكل قرص يستخدم لتمثيل المال عند المقامرة)",
 "poker face": "وجه بلا تعبير, وجه جامد (وجه بلا أي تعبير قابل للتفسير (مثل وجه لاعب البوكر الجيد))",
 "poker game": "بوكر (أي من ألعاب الورق المختلفة التي يراهن فيها اللاعبون على أنهم يحملون اليد الأعلى تصنيفاً)",
 "poker hand": "يد بوكر (البطاقات الخمس التي يحملها اللاعب في لعبة البوكر)",
 "poker heuchera": "هيوشيرا أسطوانية (نبات بنصال أوراق جلدية على شكل قلب متجمعة عند قاعدة سيقان طويلة مع زهور بيضاء مخضرة متجمعة على الجزء العلوي؛ غرب أمريكا الشمالية)",
 "poker plant": "نبات البوكر (نبات يشكل كتلاً من جنوب أفريقيا مع سنابل من الزهور القرمزية)",
 "poker-faced": "جَامِدُ المَلَامِح, عَدِيمُ التَّعْبِير (متعمّد عدم إظهار أيّ تعبير أو انفعال على وجهه)",
 "pokeweed": "صبغة, فيتولاكا",
