 "photographically": "تصويرياً, فوتوغرافياً (بواسطة وسائل التصوير الفوتوغرافي)\nمثال: مشاهد مسجلة فوتوغرافياً",
 "photography": "تَصْوِير, فُوتُوغْرَافِيَّا",
 "photogravure": "حفر ضوئي, روتوجرافور (استخدام التصوير الفوتوغرافي لإنتاج لوحة للطباعة) / حفر ضوئي, طباعة غائرة (مطبوعة غائرة يتم إنتاجها عن طريق الحفر) / حفر ضوئي, فوتوغرافيور (الطباعة من لوح غائر مُعد بطرق فوتوغرافية)",
 "photoheliograph": "فوتوهيليوغراف, مصوّر الشمس (تلسكوب متصل بكاميرا، يستخدم لتصوير الشمس)",
 "photojournalism": "صحافة مصورة (الصحافة التي تقدم القصة بشكل أساسي من خلال استخدام الصور)",
 "photojournalist": "مصور صحفي (صحفي يقدم القصة بشكل أساسي من خلال استخدام الصور الفوتوغرافية)",
 "photolithograph": "طباعة حجرية ضوئية (طباعة حجرية منتجة بواسطة ألواح منتجة فوتوغرافياً)",
 "photolithography": "طباعة حجرية ضوئية, فوتو ليثوغرافيا (عملية طباعة مستوية تستخدم ألواحاً مصنوعة من صورة فوتوغرافية)",
 "photomechanical": "تصويري ميكانيكي, فوتوميكانيكي (مكون من أو متعلق بـ أو يتضمن طرقاً مختلفة لاستخدام التصوير الفوتوغرافي لعمل ألواح للطباعة)",
 "photomechanics": "ميكانيكا ضوئية (تقنية استخدام الأساليب الميكانيكية الضوئية لتحويل الصور الفوتوغرافية إلى لوحات للطباعة) / صناعة الألواح الضوئية, ميكانيكا ضوئية (العملية التي يتم فيها إنتاج أسطح الطباعة (الألواح أو الأسطوانات) بطرق فوتوغرافية)\nمثال: أحدثت الميكانيكا الضوئية ثورة في ممارسة الطباعة",
 "photometer": "مقياس الضوء (معدات تصوير فوتوغرافي تقيس شدة الضوء) / فوتومتر, مقياس الضوء (أداة قياس لقياس الشدة الضوئية لمصدر بمقارنته (بصرياً أو كهروضوئياً) بمصدر قياسي)",
 "photometric": "فوتومتري, قياسي ضوئي (مكون من أو متعلق بقياس الضوء (الفوتومتريا))",
 "photometrical": "فوتومتري, قياسي ضوئي (مكون من أو متعلق بقياس الضوء (الفوتومتريا))",
 "photometrically": "ضوئياً (بواسطة وسائل قياس الضوء (الفوتومترية))\nمثال: مُقاسة ضوئياً",
 "photometrician": "مُخْتَصّ بِقِيَاس الضَّوْء (شخص يمارس قياس الضوء)",
 "photometrist": "مُخْتَصّ بِقِيَاس الضَّوْء (شخص يمارس قياس الضوء)",
 "photometry": "فوتومترية, قياس الضوء (قياس خصائص الضوء (خاصة الشدة الضوئية))",
 "photomicrograph": "صورة مجهرية (صورة ملتقطة بمساعدة المجهر)",
 "photomontage": "مونتاج صور (مونتاج يستخدم صوراً فوتوغرافية)",
 "photomosaic": "فسيفساء صور جوية (ترتيب لصور جوية يشكل صورة مركبة)",
 "photon": "فُوتُون",
 "photophobia": "ألم العين الضوئي, رهاب الضوء (ألم في العين ناتج عن التعرض للضوء الساطع (غالباً ما يرتبط بالمهق)) / رهاب الضوء (خوف مرضي من الضوء)",
 "photopic vision": "رؤية ضوئية, رؤية نهارية (رؤية طبيعية في ضوء النهار؛ رؤية بإضاءة كافية لتنشيط المخاريط وإدراك تدرج اللون)",
 "photopigment": "خضاب ضوئي (خضاب خاص موجود في العصي والمخاريط في شبكية العين)",
 "photoplate making": "صناعة الألواح الضوئية, ميكانيكا ضوئية (العملية التي يتم فيها إنتاج أسطح الطباعة (الألواح أو الأسطوانات) بطرق فوتوغرافية)\nمثال: أحدثت الميكانيكا الضوئية ثورة في ممارسة الطباعة",
 "photoretinitis": "التهاب الشبكية الضوئي (تلف الشبكية الناتج عن تعرض العين للشمس دون حماية كافية)",
 "photosensitive": "حَسَّاس لِلضَّوْء, ضَوْئِيّ الحَسَاسِيَّة (حسّاس للضوء المرئي)",
 "photosensitivity": "حساسية إشعاعية, حساسية للضوء (الحساسية لتأثير الطاقة المشعة)",
 "photosphere": "غلاف ضوئي, فوتوسفير (السطح المضيء بشكل مكثف للنجم (وخاصة الشمس))",
 "photostat": "جهاز تصوير, فوتوستات (آلة نسخ تقوم بعمل نسخ موجبة أو سالبة سريعة مباشرة على سطح ورق محضر) / فوتوستات (نسخة مصورة مصنوعة على جهاز فوتوستات)",
 "photostat machine": "جهاز تصوير, فوتوستات (آلة نسخ تقوم بعمل نسخ موجبة أو سالبة سريعة مباشرة على سطح ورق محضر)",
 "photosynthesis": "تَمْثِيل ضَوْئِيّ / تَرْكِيب ضَوْئِيّ (اسم للشيء الذي يُرَّكبُ بالعادة)",
 "photosynthetic": "تركيبي ضوئي, تمثيلي ضوئي (متعلق بـ أو يستخدم أو يتكون عن طريق التمثيل الضوئي)",
 "phototelegraph": "تلغراف مصور (جهاز لنقل الصور عن طريق التلغراف المصور)",
 "phototelegraphy": "إبراق ضوئي, إرسال صور بالتلغراف (تقنية مبكرة لنقل النسخ المماثلة (الفاكس))\nمثال: وجه آيفز انتباهه بعد ذلك إلى التلفزيون، الذي اعتبره مجرد شكل مسرع من الإبراق الضوئي",
 "phototherapy": "علاج ضوئي (استخدام الضوء القوي لعلاج حب الشباب أو فرط بيليروبين الدم لدى حديثي الولادة)",
 "phototrophic bacteria": "بكتيريا ضوئية التغذية (بكتيريا خضراء وأرجوانية؛ تستمد الطاقة للنمو من ضوء الشمس؛ ويشتق الكربون من ثاني أكسيد الكربون أو الكربون العضوي)",
 "phototropic bacteria": "بكتيريا ضوئية التغذية (بكتيريا خضراء وأرجوانية؛ تستمد الطاقة للنمو من ضوء الشمس؛ ويشتق الكربون من ثاني أكسيد الكربون أو الكربون العضوي)",
 "phototropism": "انتحاء ضوئي (استجابة توجيهية للضوء)",
 "photovoltaic": "فلطائي ضوئي, كهروضوئي (ينتج جهداً كهربائياً عند التعرض لطاقة إشعاعية (وخاصة الضوء))",
 "photovoltaic cell": "خلية شمسية, خلية كهروضوئية (خلية تحول الطاقة الشمسية إلى طاقة كهربائية)",
 "phoxinus phoxinus": "منوة (سمكة مياه عذبة أوروبية صغيرة جداً شائعة في الجداول الحصوية)",
 "phragmacone": "مَخْرُوطٌ حاجِزِيّ (الصدفة الداخلية الرقيقة المخروطية والمقسمة لحجرات (سواء كانت مستقيمة أو منحنية) لحيوان البلمنيت)",
 "phragmites communis": "قصب الخنادق, قيصوب شائع (قصب طويل من أمريكا الشمالية له أوراق عريضة نسبياً وعناقيد كبيرة تشبه الريش؛ واسع الانتشار في المناطق الرطبة؛ يستخدم للحصير والستائر وأعمدة السهام)",
 "phragmocone": "مَخْرُوطٌ حاجِزِيّ (الصدفة الداخلية الرقيقة المخروطية والمقسمة لحجرات (سواء كانت مستقيمة أو منحنية) لحيوان البلمنيت)",
 "phrasal": "تركيبي, عباري\nمثال: فعل مركب (عباري)",
 "phrasal idiom": "تعبير اصطلاحي, مصطلح (تعبير لا يمكن استنتاج معانيه من معاني الكلمات التي يتكون منها)",
 "phrasal verb": "فعل مركب (فعل إنجليزي يتبعه حرف أو أكثر حيث يتصرف المزيج كوحدة نحوية ودلالية)",
 "phrase": "جُمْلَة, تَعْبِير (مؤنث جُمْل، وهو الحبل الغليظ أو الجماعة من الناس؛ المَجْمُوع)\nمثال: يا لها من جملة!",
 "phrase book": "كتاب عبارات (كتاب يحتوي على تعبيرات شائعة بلغة أجنبية مع ترجمتها)",
 "phrase structure": "بناء الجملة, نحو (الترتيب النحوي للكلمات في الجمل)",
 "phrasebook": "كِتَابُ ٱلْعِبَارَات (موضع تعليم الكتابة. الاستخدام الأصلي؛ مدرسة شبه رسمية لتعليم الأطفال الكِتَابَة والقِرَاءَة ومباديء الحِسَاب وبعض القُرَآن…)\nمثال: هذا الكتاب جديد",
 "phraseology": "ألفاظ, صياغة (الطريقة التي يتم بها التعبير عن شيء ما بالكلمات)",
 "phrasing": "صياغة لحنية (تجميع العبارات الموسيقية في خط لحني) / ألفاظ, صياغة (الطريقة التي يتم بها التعبير عن شيء ما بالكلمات)",
 "phratry": "آل, أسرة ممتدة (أشخاص ينحدرون من سلف مشترك)\nمثال: عاش أهله في ماساتشوستس منذ سفينة ماي فلاور",
 "phreatic": "جوفي, فرياتي (مكون من أو متعلق بالمياه الجوفية)",
 "phrenetic": "مَجْنُون, مَحْمُوم (في حالة هياج مفرط؛ مذهول من الخوف أو العاطفة العنيفة)",
 "phrenic": "حجابي (من أو يتعلق بالحجاب الحاجز)\nمثال: عصب حجابي",
 "phrenic nerve": "عصب حجابي (أحد زوجين من الأعصاب ينشأ من الجذور الشوكية العنقية ويمر أسفل القفص الصدري ليعصب الحجاب الحاجز ويتحكم في التنفس)",
 "phrenic vein": "وريد حجابي (أي من وريدين يصرفان الحجاب الحاجز)",
 "phrenitis": "التهاب الدماغ (التهاب الدماغ عادة ما يسببه فيروس؛ تشمل الأعراض الصداع وألم الرقبة والنعاس والغثيان والحمى)",
 "phrenological": "فراسي, متعلق بعلم فراسة الدماغ (مكون من أو متعلق بعلم فراسة الدماغ)",
 "phrenologist": "أخصائي فراسة الدماغ (شخص يدعي القدرة على قراءة شخصيتك من شكل جمجمتك)",
 "phrenology": "علم فراسة الدماغ, فرينولوجيا (دراسة مهجورة الآن لشكل الجمجمة كمؤشر على قوى الملكات العقلية المختلفة)",
 "phrontistery": "دار علم, مكان للتفكير والدراسة (مؤسسة للدراسة والتعلم (تشمل أحياناً الجامعات الحديثة))",
 "phrygian": "اللغة الفريجية (لغة تراقية فريجية كان يتحدث بها سكان فريجيا القدماء وهي الآن منقرضة — محفوظة فقط في القليل من النقوش) / فريجي (مواطن أو ساكن في فريجيا)",
 "phrygian cap": "قُبَّعَة فْرِيجِيَة (خرقة تخاطُ كالبُرْنس يلبسها الصِّبيان؛ غطاء للرأس يكون مُخّيَّط على عكس العَمَامَة التي لا يكون فيها خِيَاطَة. قُلُنْسُوَة) / قلنسوة فريجية (القُلُنْسُوَة: لباس داخلي للرأس يُلبس غالبا داخليا تحت العَمَامَة أو الكُوفِيَّة أو غيره من أغطية الرأس للرجال والنساء، يسمى أيضا الطَاقِيَّة؛ القُلُنْسُوَة: لباس للرأس يشبه الداخلي إلا أنه يلبس لوحده، قد يكون أبيضا وقد يكون مطرزا، يسمى أيضا الطَاقِيَّة)\nمثال: لقد اشترى قبعة.",
 "phrygian deity": "إله فريجي (إله للفريجيين القدماء في غرب وسط آسيا الصغرى)",
 "phrygian language": "اللغة الفريجية (لغة تراقية فريجية كان يتحدث بها سكان فريجيا القدماء وهي الآن منقرضة — محفوظة فقط في القليل من النقوش)",
 "phrynosoma cornutum": "سحلية تكساس القرناء (تعيش في المناطق المفتوحة القاحلة وشبه القاحلة)",
 "phs": "دائرة الصحة العامة الأمريكية (وكالة تعمل كمكتب للجراح العام؛ تشمل وكالات مهمتها تحسين الصحة العامة)",
 "phthalic acid": "حمض الفثاليك (حمض عديم اللون يُستخدم لصنع الأصباغ والعطور)",
 "phthalic anhydride": "أنهيدريد الفثاليك (أنهيدريد حلقي أبيض)",
 "phthirius pubis": "قملة العانة (قملة تغزو منطقة العانة في جسم الإنسان)",
 "phthisis": "سُحَاف",
 "phthorimaea operculella": "عثة البطاطس, عثة درنات البطاطس (عثة بنية رمادية يرقتها هي دودة درنات البطاطس) / دودة درنات البطاطس (يرقة عثة البطاطس؛ تحفر في أوراق وسيقان البطاطس والتبغ)",
 "phugoid": "فوغويد",
 "phuket": "بُوكِيت",
 "phycobilin": "فيكوبيلين (أصباغ بروتينية قابلة للذوبان في الماء توجد في الطحالب الحمراء والبكتيريا الزرقاء)",
 "phycocyanin": "فيكوسيانين (صبغة زرقاء في الطحالب)",
 "phycoerythrin": "فيكوإريثرين (صبغة حمراء في الطحالب الحمراء)",
 "phycology": "علم الطحالب (فرع علم النبات الذي يدرس الطحالب)",
 "phycomycosis": "فطار طحلب, فطار عفني (أي عدوى فطرية تسببها فطريات مجموعة الفطريات الطحلبية)",
 "phylactery": "تَمِيمَة صَلَاة يَهُودِيَّة, تِيفِيلِين ((اليهودية) إحدى علبتين جلديتين صغيرتين تحتويان على نصوص من الكتاب المقدس العبري؛ يرتديها الرجال اليهود تقليدياً (على الجبهة والذراع اليسرى) أثناء…)",
 "phyle": "قبيلة أثينية (قبيلة من قبائل الأثينيين القدماء)",
 "phyletic": "تطوري سلالي, فيلوجيني (من أو يتعلق بالتطور السلالي للكائنات الحية)\nمثال: تطور سلالي",
 "phylliform": "وَرَقِيّ الشَّكْل (على شكل ورقة نبات)",
 "phyllitis scolopendrium": "سرخس لسان الأيل, لسان الأيل (سرخس أوراسي بسعف رمحي بسيط)",
 "phyllo": "دَيُول",
 "phylloclad": "ساق ورقية (ساق مسطحة تشبه ورقة الشجر وتعمل عملها)",
 "phylloclade": "ساق ورقية (ساق مسطحة تشبه ورقة الشجر وتعمل عملها)",
 "phyllocladus alpinus": "صنوبر الكرفس الألبي (صنوبر كرفس شجيري صغير من نيوزيلندا)",
 "phyllocladus asplenifolius": "صنوبر الكرفس (صنوبر كرفس متوسط الطول من تسمانيا)",
 "phyllocladus trichomanoides": "تانيكاها (صنوبر كرفس متوسط الطول من نيوزيلندا)",
 "phyllode": "فيلود, ورقة كاذبة (سويقة متوسعة تأخذ وظيفة نصل الورقة)",
 "phyllodial": "ورقي الساق (لديه ساق ورقية (فيلود))",
 "phyllodoce breweri": "خلنج أرجواني (عشب شبه منبطح دائم الخضرة من غرب الولايات المتحدة)",
 "phyllodoce caerulea": "خلنج الجبل (شجيرة صغيرة بأوراق دائمة الخضرة وزهور وردية أو أرجوانية؛ القمم الألبية والأراضي المرتفعة في آسيا وأوروبا والولايات المتحدة)",
 "phylloporus boletinoides": "فيلوبوروس بوليتينويدس (فطر بقبعة بنية محدبة عريضة ومسام تمتد جزئياً لأسفل الساق)",
 "phylloquinone": "فيتامين ك1 (شكل من أشكال فيتامين ك)",
 "phylloscopus sibilatrix": "نقشارة الغياض (هازجة غابات أوروبية ذات ريش أصفر باهت)",
 "phyllostachys aurea": "خيزران صنارة السمك (خيزران صغير من جنوب شرق الصين له سيقان رفيعة مرنة عندما تكون صغيرة)",
 "phyllostachys bambusoides": "خيزران الخشب العملاق, ماداكي (خيزران كبير له سيقان سميكة الجدران؛ موطنه الصين وربما اليابان؛ يُزرع على نطاق واسع في أماكن أخرى)",
 "phyllostachys nigra": "خيزران أسود (خيزران صغير له سيقان خضراء رقيقة تتحول إلى اللون الأسود اللامع)",
 "phyllostomus hastatus": "خفاش رمحي الأنف الكبير (نوع من الخفافيش ورقية الأنف)",
 "phylloxera vitifoleae": "قمل العنب (مدمر لنباتات العنب المختلفة)",
 "phylogenesis": "تطور, تطور عضوي ((علم الأحياء) تسلسل الأحداث المتضمنة في التطور التطوري لنوع أو مجموعة تصنيفية من الكائنات الحية)",
 "phylogenetic": "تطوري سلالي, فيلوجيني (من أو يتعلق بالتطور السلالي للكائنات الحية)\nمثال: تطور سلالي",
 "phylogenetic relation": "تَشَابُه, قَرَابَة نُشُوئِيَّة ((الأحياء) حالة العلاقة بين الكائنات الحية أو مجموعات الكائنات الحية الناتجة عن التشابه في البنية أو الأجزاء الهيكلية)\nمثال: في البنية التشريحية يظهر إنسان ما قبل التاريخ قرابة وثيقة مع البشر المعاصرين",
 "phylogenetically": "تطورياً (فيما يتعلق بالتطور السلالي)\nمثال: جزء بدائي تطورياً من الدماغ",
 "phylogeny": "تطور, تطور عضوي ((علم الأحياء) تسلسل الأحداث المتضمنة في التطور التطوري لنوع أو مجموعة تصنيفية من الكائنات الحية)",
 "phylum": "شُعْبَة",
 "physa": "فيزا (أي عضو من جنس فيزا)",
 "physalis alkekengi": "فانوس صيني, كرز الشتاء (نبات معمر من العالم القديم يزرع لكأسه الورقي البرتقالي المحمر المنفوخ الزخرفي)",
 "physalis ixocarpa": "توماتيلو, طماطم قشرية مكسيكية (نبات حولي من المكسيك وجنوب الولايات المتحدة له ثمار لزجة أرجوانية صالحة للأكل تشبه الطماطم الصغيرة)",
 "physalis peruviana": "حرنكش, عنب الثعلب البيروفي (نبات حولي من أمريكا الجنوبية الاستوائية له ثمار أرجوانية صالحة للأكل)",
 "physalis philadelphica": "توماتيلو, ميلتومات (نبات حولي مكسيكي تم توطينه في شرق أمريكا الشمالية له ثمار صفراء إلى أرجوانية صالحة للأكل تشبه الطماطم الصغيرة)",
 "physalis pruinosa": "حرنكش, طماطم الفراولة (نبات حولي مشعر قوي من شرق أمريكا الشمالية بثمار صفراء حلوة)",
 "physalis pubescens": "حرنكش, كرز أرضي زغبي (نبات حولي أمريكي زخرفي له توت أصفر لحمي مستدير محاط بقشرة تشبه المثانة)",
 "physalis viscosa": "بنج أصفر, حرنكش لزج (يوجد على شواطئ البحر من فرجينيا إلى أمريكا الجنوبية له زهور صفراء مخضرة وتوت برتقالي أو أصفر)",
 "physeter catodon": "حوت العنبر (حوت كبير ذو تجويف كبير في الرأس يحتوي على العنبر والزيت؛ وهو أيضاً مصدر للعنبر الرمادي)",
 "physiatrics": "علاج طبيعي, فيزيوثيرابي (علاج يستخدم العوامل الفيزيائية: التمرين والتدليك وطرق أخرى)",
 "physic": "مسهل, ملين قوي (دواء مسهل؛ يحفز إخلاء الأمعاء)",
 "physic nut": "جاتروفا, جوزة مقيئة (شجرة أمريكية استوائية صغيرة تنتج صبغة أرجوانية ومستخلص دباغة وتحمل جوزاً يحتوي على زيت مسهل سام بكميات كبيرة)",
 "physical": "مَادِّيّ, مَلْمُوس",
 "physical ability": "قدرة بدنية (القدرة على أداء فعل بدني ما)",
 "physical anthropology": "أنثروبولوجيا فيزيائية (فرع الأنثروبولوجيا الذي يتعامل مع نشأة وتنوع البشر)",
 "physical attraction": "رغبة جنسية, شهوة (رغبة في الحميمية الجنسية)",
 "physical body": "جَسَد, جِسْمُ الإِنْسَان (أسماء بديلة لجسد الإنسان)\nمثال: درس ليوناردو جسم الإنسان",
 "physical change": "تحول الطور, تغير الطور (تغير من حالة (صلبة أو سائلة أو غازية) إلى أخرى دون تغيير في التركيب الكيميائي)",
 "physical chemistry": "كيمياء فيزيائية (فرع الكيمياء الذي يتعامل مع الخصائص الفيزيائية للمواد الكيميائية)",
 "physical composition": "بنية, تركيب (الطريقة التي يتكون بها شخص أو شيء ما)",
 "physical condition": "حَالَة بَدَنِيَّة, حَالَة فِسْيُولُوجِيَّة (حالة الجسم أو وظائفه الحيويّة)",
 "physical contact": "اتصال, تلامس جسدي (فعل اللمس جسدياً)\nمثال: لامست أصابعها مفتاح الضوء",
 "physical distancing": "تباعد اجتماعي, تباعد جسدي (الحفاظ على مسافة آمنة بينك وبين الآخرين وتجنب الحشود لإبطاء انتشار الأمراض المعدية)\nمثال: لممارسة التباعد الاجتماعي، ابق على مسافة 6 أقدام على الأقل من الآخرين",
 "physical education": "تَعْلِيم جَسَدِيّ, تَعْلِيم بَدَنِيّ (الأوامر والنواهي التي يحددها دِين ما أو مَذْهَب ما. يُجمع جَمْع تَكْسِير على تَعَالِيم؛ ما دون الأمْر المُلْزِم والمستدعي للعقوبة وفوق الطَلَب الإختياري. أكثر ما يستخدم بصيغة الجمع تَعْلِيمَات)\nمثال: هو بارع في التعليم.",
 "physical entity": "كِيَان مَادِّيّ (كيان له وجود مادّيّ ملموس في العالم الفيزيائيّ)",
 "physical examination": "فَحْص طِبِّيّ (مصدر للفعل فَحَصَ بمعنى حفر الأرض أو كشف الشيء أو الاستقصاء عن الشيء؛ في : استقصاء ما بالمريض من علة أو مرض)\nمثال: فحص الطبيب بطني.",
 "physical exercise": "تمرين, تمرين بدني (نشاط بذل الجهد العضلي بطرق مختلفة للحفاظ على اللياقة)\nمثال: أوصى الطبيب بممارسة الرياضة بانتظام",
 "physical exertion": "تمرين, تمرين بدني (نشاط بذل الجهد العضلي بطرق مختلفة للحفاظ على اللياقة)\nمثال: أوصى الطبيب بممارسة الرياضة بانتظام",
 "physical fitness": "لياقة بدنية (حالة بدنية جيدة؛ التمتع بلياقة عالية)",
 "physical geography": "جغرافيا طبيعية (دراسة السمات الفيزيائية لسطح الأرض)",
 "physical goods": "بضائع مادية, سلع ملموسة (أي نوع من السلع التي يمكن لمسها مادياً، وتُقتنى لتلبية الحاجات والرغبات)\nمثال: قد تكون تكلفة السلعة المادية أعلى من السلعة غير الملموسة، لكن تتبعها أو إعادتها أسهل",
 "physical impossibility": "استحالة فيزيائية (يكون الموقف مستحيلاً فيزيائياً إذا كان وصفه يتعارض مع القوانين الفيزيائية (أي مع قوانين الطبيعة))",
 "physical object": "جِسْم, شَيْء مَادِّيّ (كيان ملموس ومرئيّ؛ كيان يمكن أن يُلقيَ ظِلًّا)",
 "physical pendulum": "بندول فيزيائي, بندول مركب (بندول يتكون من جسم فعلي يسمح له بالدوران بحرية حول محور أفقي)",
 "physical phenomenon": "ظاهرة فيزيائية (ظاهرة طبيعية تنطوي على الخواص الفيزيائية للمادة والطاقة)",
 "physical process": "عَمَلِيَّة, عَمَلِيَّة فِيزْيَائِيَّة (ظاهرة مستمرّة أو ظاهرة تتميّز بتغيّرات تدريجيّة عبر سلسلة من الحالات)",
 "physical property": "خاصية فيزيائية (أي خاصية تستخدم لتوصيف المادة والطاقة وتفاعلاتهما)",
 "physical quantity": "كَمِّيَّة فِيزِيَائِيَّة",
 "physical rehabilitation": "تأهيل بدني, علاج طبيعي (تقديم المساعدة للأشخاص ذوي الإعاقة؛ إزالة أو تقليل الإعاقات)",
 "physical restoration": "تأهيل بدني, علاج طبيعي (تقديم المساعدة للأشخاص ذوي الإعاقة؛ إزالة أو تقليل الإعاقات)",
 "physical science": "خصائص فيزيائية, فيزياء (الخصائص الفيزيائية والظواهر والقوانين لشيء ما)\nمثال: درس فيزياء الإشعاع",
 "physical therapist": "أخصائي علاج طبيعي, معالج فيزيائي (معالج يعالج الإصابات أو الخلل الوظيفي بالتمارين والعلاجات الفيزيائية الأخرى)",
 "physical therapy": "علاج طبيعي, فيزيوثيرابي (علاج يستخدم العوامل الفيزيائية: التمرين والتدليك وطرق أخرى)",
 "physical topology": "طوبولوجيا مادية (المظهر المادي للشبكة)\nمثال: تشمل الطوبولوجيا المادية للشبكات المحلية الناقل والحلقة والنجمة",
 "physical value": "القيمة المادية, تكلفة إعادة الإنتاج (تكلفة إعادة إنتاج الممتلكات المادية مطروحاً منها المخصصات المختلفة (خاصة الإهلاك))",
 "physicalism": "فيزيائية, مادية ((فلسفة) النظرية الفلسفية القائلة بأن المادة هي الواقع الوحيد)",
 "physicality": "شهوانية, مادية جسدية (الانشغال بإشباع الدوافع والشهوات الجسدية)",
 "physically": "فيزيائياً (بما يتفق مع القوانين الفيزيائية)\nمثال: إنه مستحيل فيزيائياً",
 "physicalness": "جُسْمَانِيَّة, مَادِّيَّة (صفة كون الشيء مادياً؛ مكوناً من مادة)",
 "physician": "طَبِيب, طَبِيبة (العالم بالطب)\nمثال: سوف تصبح طبيبة.",
 "physician, heal thyself": "أَيُّهَا ٱلطَّبِيبُ ٱشْفِ نَفْسَكَ, يَا طَبِيبُ طُبَّ لِنَفْسِكَ",
 "physician-assisted suicide": "انتحار بمساعدة الطبيب (انتحار بمساعدة الغير حيث يكون المساعد طبيباً)",
 "physician-patient privilege": "سرية الطبيب والمريض (حق الطبيب في رفض الكشف عن معلومات سرية من مريض دون موافقة المريض)",
 "physicist": "فِيزِيَائِيّ, فِيزِيَائِيَّة",
 "physicochemical": "فيزيائي كيميائي (يتعلق بالكيمياء الفيزيائية)",
 "physics": "فِيزِيَاء, فِيزِيقَا (علم الطَّبيعة أو علم الطَّبيعيَّات)\nمثال: تدرس الفيزياء النووية.",
 "physics department": "قسم الفيزياء (القسم الأكاديمي المسؤول عن التدريس والبحث في الفيزياء)",
 "physics lab": "مختبر فيزياء (مختبر للبحوث في الفيزياء)",
 "physics laboratory": "مختبر فيزياء (مختبر للبحوث في الفيزياء)",
 "physiognomy": "سحنة, محيا (الوجه البشري)",
 "physiography": "جغرافيا طبيعية (دراسة السمات الفيزيائية لسطح الأرض)",
 "physiologic": "فِسْيُولُوجِيّ, وَظَائِفِيّ (متوافق مع الأداء الطبيعيّ للكائن الحيّ)",
 "physiological": "فَسْلَجِي, فِسْيُولُوجِي",
 "physiological anatomy": "تشريح وظيفي (دراسة التشريح في علاقته بالوظيفة)",
 "physiological condition": "حَالَة بَدَنِيَّة, حَالَة فِسْيُولُوجِيَّة (حالة الجسم أو وظائفه الحيويّة)",
 "physiological jaundice of the newborn": "يرقان وليدي (مظهر مصفر عند الرضع حديثي الولادة؛ عادة ما يهدأ تلقائياً)",
 "physiological nystagmus": "رأرأة فسيولوجية (رعشات لا إرادية صغيرة لمقل العيون؛ عندما يتم القضاء عليها عن طريق تثبيت الصورة على الشبكية، يتلاشى الإدراك البصري بسرعة بسبب إرهاق مستقبلات الشبكية)",
 "physiological property": "خاصية فسيولوجية (خاصية تتعلق بعمل الجسم)",
 "physiological psychology": "علم النفس العصبي, علم النفس الفسيولوجي (فرع علم النفس المعني بالأسس الفسيولوجية للعمليات النفسية)",
 "physiological reaction": "رد فعل منعكس, منعكس (رد فعل تلقائي غريزي غير متعلم لمحفز)",
 "physiological sphincter": "مصرة فيزيولوجية (مصرة لا يمكن التعرف عليها عند التشريح لأن ترتيبها الساكن لا يمكن تمييزه عن الأنسجة المجاورة)",
 "physiological state": "حَالَة بَدَنِيَّة, حَالَة فِسْيُولُوجِيَّة (حالة الجسم أو وظائفه الحيويّة)",
 "physiologically": "فسيولوجياً (من أو يتعلق بالعمليات الفسيولوجية؛ فيما يتعلق بعلم وظائف الأعضاء)\nمثال: جاهز فسيولوجياً",
 "physiologist": "عالم وظائف الأعضاء, فيزيولوجي (عالم أحياء متخصص في علم وظائف الأعضاء)",
 "physiology": "فِيزْيُولُوجِيَا, عِلْم وَظَائِف اَلْأَعْضَاء",
 "physiotherapeutic": "علاجي طبيعي (متعلق بالعلاج الطبيعي أو مستخدم فيه)",
 "physiotherapist": "أخصائي في العلاج الطبيعي, أخصائية في العلاج الطبيعي",
 "physiotherapy": "عِلَاج طَبِيعِيّ",
 "physique": "بنية, قوام (تكوين الجسم البشري) / جَسَد, جِسْمُ الإِنْسَان (أسماء بديلة لجسد الإنسان)\nمثال: درس ليوناردو جسم الإنسان",
 "physostegia": "زهرة الطاعة, فيزوستيجيا",
 "physostegia virginiana": "رأس التنين الكاذب, فيزوستيغيا (نبات أمريكي شمالي له سنبلة من الزهور الوردية أو البيضاء ثنائية الشفة)",
 "physostigma venenosum": "فول كالابار (كرمة خشبية أفريقية استوائية تنتج حبوب كالابار)",
 "physostigmine": "فيزوستيغمين (يستخدم في علاج مرض الزهايمر والغلوكوما)",
 "phytelephas macrocarpa": "نخيل العاج (نخلة عديمة الساق من البرازيل وبيرو تحمل مكسرات العاج)",
 "phytochemical": "فايتوكيميكال, كيميائي نباتي (مادة كيميائية يتم الحصول عليها من النباتات وتكون نشطة بيولوجيًا ولكنها ليست مغذية)",
 "phytochemist": "كيميائي نباتي (كيميائي متخصص في كيمياء النباتات)",
 "phytochemistry": "كيمياء نباتية (فرع الكيمياء العضوية المعني بكيمياء النباتات)",
 "phytohormone": "منظم نمو, هرمون نباتي ((علم النبات) منتج نباتي يعمل مثل الهرمون)",
 "phytolacca acinosa": "صبغة هندية (نبات الصبغة من جنوب شرق آسيا والصين)",
 "phytolacca americana": "توت الحمام, صبغة أمريكية (عشبة أمريكية معمرة طويلة خشنة ذات أزهار بيضاء صغيرة تليها توت أسود محمر على عناقيد متدلية طويلة؛ السيقان اللحمية الصغيرة صالحة للأكل؛ التوت والجذر…)",
 "phytolacca dioica": "أومبو (شجرة عشبية سريعة النمو دائمة الخضرة من أمريكا الجنوبية ذات جذع عريض بمحتوى مائي عالٍ وأوراق بيضاوية خضراء داكنة)",
 "phytologist": "عالم نبات (عالم أحياء متخصص في دراسة النباتات)",
 "phytology": "علم النبات (فرع علم الأحياء الذي يدرس النباتات)",
 "phytonadione": "فيتامين ك1 (شكل من أشكال فيتامين ك)",
 "phytophagic": "آكِل النَّبَاتَات, نَبَاتِيّ التَّغْذِيَة ((عَنِ الحَيَوَانَات) يَتَغَذَّى عَلَى النَّبَاتَات)",
 "phytophagous": "آكِل النَّبَاتَات, نَبَاتِيّ التَّغْذِيَة ((عَنِ الحَيَوَانَات) يَتَغَذَّى عَلَى النَّبَاتَات)",
 "phytophilous": "آكِل النَّبَاتَات, نَبَاتِيّ التَّغْذِيَة ((عَنِ الحَيَوَانَات) يَتَغَذَّى عَلَى النَّبَاتَات)",
 "phytophthora citrophthora": "فيتوفثورا الحمضيات (يسبب التصمغ العفني البني في الحمضيات)",
 "phytophthora infestans": "فطر اللفحة المتأخرة, فيتوفثورا إنفستنس (فطر يسبب اللفحة المتأخرة في النباتات الباذنجانية خاصة الطماطم والبطاطس)",
 "phytoplankton": "عوالق نباتية, فيتوبلانكتون (مكون نباتي أو ضوئي التخليق من العوالق؛ يتكون أساساً من طحالب وحيدة الخلية)",
 "phytotherapy": "طب نباتي, علاج بالأعشاب (استخدام النباتات أو المستخلصات النباتية لأغراض طبية (خاصة النباتات التي ليست جزءاً من النظام الغذائي العادي))",
 "phytotoxin": "ذيفان نباتي, سم نباتي (أي مادة تنتجها النباتات وتكون مشابهة في خصائصها للذيفان البكتيري الخارجي)",
 "phú quốc": "فُو كُوُك",
 "pi": "بِي, پِي / ط, بَاي (الحرف السادس عشر في الترتيب الهجائي العربي والتاسع في ترتيب الأبجدية العربية؛ يسبقه \"ض\" ويتبعه \"ظ\"؛ عدد غير نسبي يمثل محيط الدائرة إلى قُطْرِهَا)",
 "pi day": "يوم ط (فترة من الزمان تبدأ عند غُرُوب الشمس وتنتهي عند غُرُوب شمس النهار التالي ويشمل اللَيْلَة ونَهَارا. طوله أربع وعشرين سَاعَة؛ النَهَار، يبدأ من طلوع الفَجْر إلى غُرُوب الشَمس، على المجاز)\nمثال: طقس اليوم جميل.",
 "pi-meson": "بِيُون, مِيزُون-باي (ميزون يشارك في تماسك النواة معاً؛ ينتج عن تصادم جسيمات عالي الطاقة)",
 "pia": "أروروت هندي, تاكا (عشب معمر من جزر الهند الشرقية إلى بولينيزيا وأستراليا؛ يزرع لجذره الكبير الصالح للأكل الذي ينتج نشا أروروت تاهيتي)",
 "pia mater": "الأم الحنون",
 "piaffe": "بياف (خبب إيقاعي ينفذه الحصان في مكانه)",
 "piagetian": "بياجيه (من أو يتعلق بجان بياجيه أو يشبهه أو على طريقته)",
 "pianism": "عزف بيانو (أداء أو تقنية عازف البيانو)\nمثال: برنامج لعزف البيانو",
 "pianissimo": "بهدوء شديد (توجيه في الموسيقى؛ للعزف بنعومة شديدة) / بِيَانِيسِيمُو ((بشكل رئيسي توجيه أو وصف في الموسيقى) ناعم جداً) / بيانو, خفوت ((موسيقى) انخفاض في الجهارة)",
 "pianissimo assai": "بِيَانِيسِيمُو أَسَّاي ((بشكل رئيسي توجيه أو وصف في الموسيقى) ناعم جداً جداً)",
 "pianist": "عَازِف بِيَانُو",
 "pianistic": "بيانوي (ماهر في أو مهيأ للبيانو) / بيانوي (من أو يتعلق بالبيانو)\nمثال: قدرات بيانوية",
 "piano": "بِيَانُو, مِعْزَف",
 "piano accordion": "أكورديون بيانو (أكورديون مزود بلوحة مفاتيح لليد اليمنى)",
 "piano action": "آلية البيانو (آلية تتكون من نظام من الروافع تحرك مطرقة من اللباد لضرب الأوتار عند الضغط على مفتاح)",
 "piano damper": "كتلة إخماد, مخمّد بيانو (مخمّد يتكون من كتلة صغيرة مبطنة باللباد تسقط على وتر البيانو لإيقاف اهتزازه)",
 "piano keyboard": "لوحة مفاتيح بيانو (مجموعة من المفاتيح على آلة موسيقية)",
 "piano lesson": "درس بيانو (درس في عزف البيانو)",
 "piano maker": "صانع بيانو (شخص يصنع آلات البيانو)",
 "piano music": "موسيقى البيانو (صوت الموسيقى الناتج عن البيانو) / موسيقى البيانو (نوتة موسيقية مخصصة للعزف على البيانو)\nمثال: ظن أنه سمع موسيقى بيانو في الجوار",
 "piano player": "عازف بيانو (شخص يعزف على البيانو)",
 "piano quartet": "رباعي بيانو (مجموعة من أربعة عازفين، بما في ذلك عازف بيانو وعازف كمان وعازف فيولا وعازف تشيلو)",
 "piano reduction": "اختزال للبيانو (نوتة موسيقية للبيانو كانت في الأصل موسيقى لآلات أخرى تم اختزالها إلى مكوناتها الأساسية ضمن مدرج موسيقي للبيانو)",
 "piano sonata": "سوناتا البيانو (سوناتا للبيانو)",
 "piano stool": "كرسي البيانو (مقعد لعازفي البيانو؛ عادة ما يكون قابل للتعديل في الارتفاع)",
 "piano teacher": "معلم بيانو (شخص يعلم الطلاب العزف على البيانو)",
 "piano transcription": "اختزال للبيانو (نوتة موسيقية للبيانو كانت في الأصل موسيقى لآلات أخرى تم اختزالها إلى مكوناتها الأساسية ضمن مدرج موسيقي للبيانو)",
 "piano tuner": "مدوزن البيانو (شخص يضبط البيانو)",
 "piano wire": "سلك بيانو, وتر بيانو (سلك فولاذي رفيع ذو قوة شد عالية)",
 "pianoforte": "بيانو (آلة لوحة مفاتيح تُلعب بالضغط على المفاتيح التي تجعل المطارق تضرب الأوتار المضبوطة وتنتج أصواتاً)",
 "pianola": "بيانو ميكانيكي (بيانو يعمل ميكانيكياً يستخدم لفة من الورق المثقوب لتنشيط المفاتيح)",
 "piassava palm": "نخيل بياسافا (نخيل برازيلي ينتج أليافاً تستخدم في صنع الحبال والحصير والفرش)",
 "piaster": "قرش (100 قرش تساوي 1 ليرة في تركيا) / قرش (وحدة نقدية كسرية في مصر ولبنان والسودان وسوريا)",
 "piastre": "قِرْش",
 "piauí": "بِيَاوِي",
 "piazza": "باحة, ساحة (ساحة عامة بها مساحة للمشاة)\nمثال: التقوا في ساحة إلم",
 "pib": "بيبي بايت, بيتابايت (وحدة معلومات تساوي 1024 تيبي بايت أو 2 أس 50 بايت)",
 "pibgorn": "مزمار القرن, هورن بايب (آلة نفخ خشبية قديمة (لم تعد مستخدمة) ذات قصبة واحدة؛ مصنوعة عادة من العظم)",
 "pibit": "بيبي بت (وحدة معلومات تساوي 1024 تيبي بت أو 2 أس 50 بت)",
 "pibroch": "بيبروخ (موسيقى عسكرية مع تنويعات؛ تُعزف بواسطة القرب)",
 "pic": "صورة, صورة فوتوغرافية (تمثيل لشخص أو مشهد في شكل مطبوعة أو شريحة شفافة أو بتنسيق رقمي) / فيلم, فيلم سينمائي (شكل من أشكال الترفيه يجسد قصة بالصوت وتسلسل من الصور يعطي وهماً بالحركة المستمرة)\nمثال: ذهبوا لمشاهدة فيلم كل ليلة سبت",
 "pica": "إم (وحدة خطية (1/6 بوصة) تستخدم في الطباعة) / القو, شهوة الغرائب (اضطراب في الأكل، يتكرر عند الأطفال، يتم فيه تناول مواد غير مغذية بشكل مستمر)",
 "pica em": "إم (وحدة خطية (1/6 بوصة) تستخدم في الطباعة)",
 "pica pica": "عقعق أوروبي (عقعق شائع في أوراسيا)",
 "pica pica hudsonia": "عقعق أمريكي (عقعق من جبال روكي في أمريكا الشمالية)",
 "pica-pica": "عشبة لاسعة, قراص الدربيون (عشب لاسع في أمريكا الاستوائية)",
 "picador": "بي كادور (الفارس الذي يغرز الثور برمح في وقت مبكر من مصارعة الثيران لتحريض الثور وجعله يبقي رأسه منخفضًا)",
 "picaninny": "طفل أسود ((إهانة عرقية) مصطلح مهين لطفل أسود)",
 "picaresque": "رواية شطارية",
 "picayune": "تَافِه, زَهِيد ((غير رسمي) صغير ولا أهمّيّة له)",
 "piccalilli": "بيكاليللي (مقبلات من الخيار المخلل المفروم والفلفل الأخضر والبصل)",
 "piccaninny": "طفل أسود ((إهانة عرقية) مصطلح مهين لطفل أسود)",
 "piccolo": "بيكولو (مزمار صغير؛ نغمته أعلى بأوكتاف من المزمار القياسي)",
 "picea abies": "تنوب نرويجي (تنوب هرمي طويل موطنه شمال أوروبا له أوراق خضراء داكنة على فروع منتشرة بغصينات متدلية ومخاريط طويلة متدلية)",
 "picea breweriana": "تنوب باكي, تنوب بروير (تنوب متوسط الحجم من كاليفورنيا وأوريغون له فروع متدلية)",
 "picea engelmannii": "تنوب إنجلمان (تنوب طويل من جبال روكي وكولومبيا البريطانية بإبر زرقاء خضراء وتاج مخروطي حاد؛ يستخدم الخشب للألواح الخشنة والصناديق)",
 "picea glauca": "تنوب أبيض (تنوب متوسط الحجم من شمال شرق أمريكا الشمالية له أوراق زرقاء خضراء قصيرة ومخاريط نحيلة)",
 "picea mariana": "تنوب أسود (تنوب صغير في المناطق المستنقعية بشمال شرق أمريكا الشمالية له فروع منتشرة بأوراق كثيفة؛ خشب رديء)",
 "picea obovata": "تنوب سيبيري (تنوب طويل من شمال أوروبا وآسيا؛ يشبه التنوب النرويجي)",
 "picea orientalis": "تنوب شرقي (شجرة دائمة الخضرة من القوقاز وآسيا الصغرى تستخدم للزينة ولها غصينات متدلية)",
 "picea pungens": "تنوب أزرق, تنوب كولورادو (تنوب طويل بإبر زرقاء خضراء وتاج مخروطي كثيف؛ الأشجار الأقدم تصبح عمودية مع فروع سفلية تتجه للأسفل)",
 "picea rubens": "تنوب أحمر (تنوب متوسط الحجم من شرق أمريكا الشمالية؛ تنوب الخشب الرئيسي في المنطقة؛ ومصدر لخشب اللب)",
 "picea sitchensis": "تنوب سيتكا (تنوب كبير ينمو فقط على طول الساحل الشمالي الغربي للولايات المتحدة وكندا؛ له إبر صلبة حادة ولحاء رقيق؛ الخشب له نسبة عالية من القوة إلى الوزن)",
 "pichi": "بيتشي, فابيانا (شجيرة بيروفية بزهور أنبوبية صغيرة وردية إلى خزامية؛ تنتج الأوراق مقوياً ومدر للبول)",
 "pichiciago": "مدرع الجني, مدرع قزم (مدرع أرجنتيني صغير جداً ذو شعر حريري شاحب وصفائح وردية على الرأس والرقبة)",
 "pichiciego": "مدرع الجني, مدرع قزم (مدرع أرجنتيني صغير جداً ذو شعر حريري شاحب وصفائح وردية على الرأس والرقبة)",
 "piciform": "نَقَّارِيّ / نَقَّارِيَّة",
 "piciform bird": "نقاريات (أي من الطيور المتسلقة آكلة الحشرات غير الجاثمة العديدة التي لها عادة مناقير قوية لثقب الخشب)",
 "pick": "مِعْوَل, فَأْس (الفأس الكبيرة العظيمة، تستخدم في الزراعة والصناعة)",
 "pick mattock": "معول فأس (أداة يدوية متعددة الاستخدامات تجمع بين المعول والقدوم، تستخدم للحفر في التربة الصلبة والتضاريس الصخرية)",
 "pick one's nose": "دَخَّلَ إِصْبَعَهُ فِي أَنْفِهِ (وَلَجَ؛ أَدْخَلَ. (تعدية خاصة بالباء))\nمثال: دخل توم المبنى.",
 "pick up": "قَطَفَ (قطفت الدّابّة قِطَافاً: أَبْطَأَتْ، في أمثالهم: (أَقْطَفُ من أرنب)؛ قَطَفَ الزّهرةَ: قطعها، قَطَفَ الثّمرَ: جناه وجمعه)\nمثال: أحب قطف الورود.",
 "pick up the phone": "رَفَعَ السَّمَّاعَة (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ)\nمثال: رفع سامي نظارته.",
 "pick's disease": "مرض بيك (شكل تقدمي من الخرف المبكر يوجد غالباً عند النساء في منتصف العمر والمسنات، ويتميز بضمور الفصين الجبهي والصدغي مع فقدان القدرة الفكرية وحبسة كلامية…)",
 "pick-mattock": "معول فأس (أداة يدوية متعددة الاستخدامات تجمع بين المعول والقدوم، تستخدم للحفر في التربة الصلبة والتضاريس الصخرية)",
 "pick-me-up": "مشروب مقوي, منشط (مقوي أو منشط (خاصة مشروب كحولي)) / مقوّي, منشط (أي شيء ذو قوى تجديدية)\nمثال: كانت بحاجة إلى المنشط الذي كانت تمنحه لها القهوة دائماً",
 "pick-off": "إمساك العداء, صيد العداء (لعبة بيسبول يتم فيها الإمساك بعداء القاعدة بعيداً عن القاعدة ولمسه لإخراجه)",
 "pickaback": "أوباً, على الظهر (على الظهر أو الكتفين أو الركوب على الورك) / محمولاً (على عربة مسطحة للسكك الحديدية (شحن الحاويات))\nمثال: حملت طفلها على ظهرها",
 "pickaback plant": "تولميا, نبات الشباب (عشب معمر قوي بأزهار في عناقيد منتصبة وتتطور نباتات صغيرة عند اتصال نصل الورقة بسويقتها)",
 "pickaninny": "طفل أسود ((إهانة عرقية) مصطلح مهين لطفل أسود)",
 "pickax": "فأس حفر, معول (أداة حديدية ثقيلة بمقبض خشبي ورأس منحني مدبب من كلا الطرفين)\nمثال: استخدموا المعاول والمطارق لكسر الصخور",
 "pickaxe": "مِعْوَل, فَأْس (الفأس الكبيرة العظيمة، تستخدم في الزراعة والصناعة)",
 "pickelhaube": "بيكلهاوبه, خوذة ذات مسمار (خوذة مدببة ارتداها الجنود الألمان)",
 "picker": "قاطف (شخص يجمع المحاصيل أو الفاكهة وما إلى ذلك) / مُخْتَار, مُنْتَقٍ (شخص يختار أو ينتقي)",
 "pickerel": "بيكريل (أي من عدة أنواع من الكراكي الصغير في أمريكا الشمالية) / كراكي صغير (لحم صغار الكراكي)",
 "pickerel frog": "ضفدع البيكريل (ضفدع مروج من شرق أمريكا الشمالية)",
 "pickerel weed": "بونتيديريا, عشبة البيكريل (نبات أمريكي له سنابل من الزهور الزرقاء وينمو في المياه الضحلة للجداول والبرك)",
 "pickerelweed": "بونتيديريا, عشبة البيكريل (نبات أمريكي له سنابل من الزهور الزرقاء وينمو في المياه الضحلة للجداول والبرك)",
 "pickeringia montana": "بازلاء الشابارال (شجيرة دائمة الخضرة شائكة تتحمل الجفاف، لها زهور وردية وأرجوانية بارزة وتشكل غابات كثيفة؛ تنمو في المنحدرات الجبلية الصخرية الجافة في كاليفورنيا)",
 "picket": "وَتَد, شَاخِص (العصا تثبت في الأرض لتثبيت شيء ما بربطه إليها)",
 "picket boat": "قارب حراسة (قارب يخدم كحارس)",
 "picket fence": "سياج وتدي (سياج مصنوع من أوتاد عمودية)",
 "picket line": "خط اعتصام (خط من الناس يعملون كمعتصمين)",
 "picket ship": "سفينة حراسة وإنذار مبكر (سفينة تخدم كحارس)",
 "picking": "جني, قطف (فعل قطف (المحاصيل أو الفاكهة أو القفزات، إلخ)) / حصاد, قطاف (كمية المحصول التي يتم حصادها)\nمثال: أرسل أول قطاف من التوت إلى السوق",
 "pickings": "أخذ, غنيمة (فعل شخص يلتقط أو يأخذ شيئًا ما)\nمثال: كانت الغنائم سهلة",
