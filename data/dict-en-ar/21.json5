 "pistacia vera": "شجرة الفستق, فستق (شجرة صغيرة من جنوب أوروبا وآسيا الصغرى تحمل مكسرات صغيرة صلبة القشرة)",
 "piste": "منحدر تزلج (مسار تزلج مكسو بالثلج المعبأ بكثافة) / بساط المبارزة, ممر المبارزة (منطقة مستطيلة مسطحة لمباريات المبارزة)",
 "pistia": "بستيا, خس الماء (نبات عائم استوائي يشكل وردة من أوراق إسفينية الشكل؛ عشب ضار واسع الانتشار في الأنهار والبحيرات)",
 "pistia stratiotes": "بستيا, خس الماء (نبات عائم استوائي يشكل وردة من أوراق إسفينية الشكل؛ عشب ضار واسع الانتشار في الأنهار والبحيرات)",
 "pistia stratoites": "بستيا, خس الماء (نبات عائم استوائي يشكل وردة من أوراق إسفينية الشكل؛ عشب ضار واسع الانتشار في الأنهار والبحيرات)",
 "pistil": "مِدَقَّة",
 "pistillate": "كَرْبَلِيّ, مِدَقِّيّ (يحمل أو يتكون من كرابل) / مَدَقِّيّ (يمتلك مدقات؛ وهي أعضاء حمل البويضات في النبات البذري)",
 "pistillode": "مدقة عقيمة (مدقة أثرية عقيمة متبقية في الزهرة المذكرة)",
 "pistol": "مُسَدَّس (اسم مفعول من سَدَّسَ؛ في : شَكْل هندسي مُسَطَّح له سِتَّة أضلاع متساوية فإن لم تكن متساوية سميّ بالسُدَاسِيّ) / فَرْد / طَبَنْجَة / غَدَّارَة\nمثال: كان عند زيري مسدس.",
 "pistol grip": "مقبض مسدسي (مقبض (كما في بندقية أو منشار) على شكل مؤخرة المسدس)",
 "pistol shrimp": "روبيان طقاق (روبيان صغير يصدر صوت طقطقة بأحد مخالبه المتضخمة)",
 "pistoleer": "مسلح بمسدس (شخص مسلح بمسدس (خاصة جندي))",
 "piston": "مِدَكّ",
 "piston chamber": "أسطوانة, غرفة المكبس (حجرة يتحرك بداخلها المكبس)",
 "piston ring": "حلقة المكبس (ختم يتكون من حلقة معدنية مشقوقة تسد الفجوة بين المكبس وجدار الأسطوانة)",
 "piston rod": "ذراع المكبس (ذراع توصيل يحرك المكبس أو يحركه المكبس)",
 "pistonphone": "معاير صوتي مكبسي (معاير صوتي (مصدر صوت) يستخدم حجم اقتران مغلق لتوليد ضغط صوت دقيق لمعايرة ميكروفونات القياس)",
 "pisum arvense": "بازلاء الحقل (صنف من نبات البازلاء موطنه منطقة البحر الأبيض المتوسط وشمال أفريقيا ويزرع على نطاق واسع خاصة للعلف)",
 "pisum sativum": "بازلاء الحديقة, بازلاء شائعة (نبات ينتج بازلاء تؤكل عادة طازجة بدلاً من مجففة)",
 "pisum sativum arvense": "بازلاء الحقل (صنف من نبات البازلاء موطنه منطقة البحر الأبيض المتوسط وشمال أفريقيا ويزرع على نطاق واسع خاصة للعلف)",
 "pisum sativum macrocarpon": "بازلاء الثلج, بازلاء سكرية (صنف من نبات البازلاء ينتج بازلاء ذات قرون ناعمة سميكة صالحة للأكل تفتقر إلى البطانة الليفية للبازلاء الشائعة)",
 "pit": "حُفْرَة",
 "pit bull terrier": "ستافوردشاير تيريير أمريكي (سلالة أمريكية من التيريير العضلي ذو فراء قصير صلب ملتصق بالجسم)",
 "pit of the stomach": "الحفرة الشرسوفية, فم المعدة (انخفاض طفيف في خط الوسط أسفل القص مباشرة (حيث يمكن لضربة أن تؤثر على الضفيرة الشمسية))",
 "pit run": "حصى طبيعي, حصى نهري (حصى كما يوجد في الرواسب الطبيعية)",
 "pit stop": "وقفة صيانة (توقف قصير في حظيرة الصيانة أثناء سباق السيارات للتزود بالوقود أو خدمة السيارة) / استراحة الطريق (توقف أثناء رحلة بالسيارة للراحة وتناول المرطبات)",
 "pit viper": "أفعى الحفر (أفاعي العالم الجديد ذات أنياب مجوفة وحفرة حساسة للحرارة على كل جانب من الرأس)",
 "pit-a-pat": "خفقاً, دقا (وصف لضربات إيقاعية (مثل القلب)) / بخطوات خفيفة, طقطقة (كما في صوت الخطوات الخفيفة)\nمثال: قلبه كان يخفق",
 "pit-house": "مخبأ أرضي, منزل حفرة (مأوى للبشر أو الحيوانات الأليفة والماشية يعتمد على حفرة أو منخفض محفور في الأرض)\nمثال: المخابئ الأرضية هي واحدة من أقدم أنواع المساكن البشرية التي يعرفها علماء الآثار",
 "pit-run gravel": "حصى طبيعي, حصى نهري (حصى كما يوجد في الرواسب الطبيعية)",
 "pita": "عيش بلدى (مصدر للفعل عَاشَ؛ هو الحَيَاة)\nمثال: أريد العيش هنا.",
 "pitahaya": "بتايا, فاكهة التنين (فاكهة صالحة للأكل ملونة للغاية لصبار البتايا ذات عصير أحمر ساطع؛ غالباً بحجم الدراق) / صبار بيتاهايا (صبار من جنوب غرب الولايات المتحدة وشمال المكسيك له ثمار عصارية صالحة للأكل)",
 "pitahaya cactus": "صبار بيتاهايا (صبار من جنوب غرب الولايات المتحدة وشمال المكسيك له ثمار عصارية صالحة للأكل)",
 "pitanga": "بيتانغا, كرز سورينام (شجرة برازيلية ذات ثمار حمراء حارة؛ تزرع غالباً في كاليفورنيا وفلوريدا)",
 "pitcairn islands": "جُزُر بِيتْكِيرْن (جَزَرَ الماءُ عن الأَرضِ يَجْزُرُ جَزْراً: نَضَبَ وحَسَرَ؛ ويقال: جَزَرَ البَحْرُ والنَّهْرُ: انْحسرَ ماؤُهُ)\nمثال: ضع الجزر في القدر.",
 "pitch": "زِفْت",
 "pitch accent": "نبر نغمي (تأكيد ينتج عن الحدة بدلاً من الجهارة)",
 "pitch apple": "تفاح القطران, تين خانق (كلوزيا أمريكية استوائية شائعة لها أزهار بيضاء أو وردية منعزلة)",
 "pitch black": "أبنوسي, أسود حالك (أسود داكن جداً)",
 "pitch blackness": "حلكة, سواد (الغياب التام للضوء)\nمثال: تحسسوا طريقهم في ظلام دامس",
 "pitch contour": "تغيير النبرة, تنغيم (ارتفاع وانخفاض حدة الصوت)",
 "pitch pine": "صنوبر القار, صنوبر القار الشمالي (صنوبر كبير ثلاثي الإبر من شرق الولايات المتحدة وجنوب شرق كندا؛ وثيق الصلة بصنوبر البرك) / صنوبر أصفر جنوبي, صنوبر طويل الأوراق (صنوبر كبير ثلاثي الإبر من جنوب شرق الولايات المتحدة له إبر طويلة جداً وأطراف ملتوية معقدة؛ اللحاء بني محمر مخدد بعمق؛ شجرة خشب مهمة)",
 "pitch pipe": "أنبوب النغمة (أنبوب صغير يصدر نغمة بتردد قياسي؛ يستخدم لتحديد نغمة البداية للغناء غير المصحوب بآلات)",
 "pitch shot": "بيتش, ضربة قصيرة عالية (ضربة اقتراب عالية في الغولف)",
 "pitch-black": "حَالِك, دَامِس (شَدِيد الظُّلْمَة لِأَقْصَى دَرَجَة)",
 "pitch-dark": "حَالِك, دَامِس (شَدِيد الظُّلْمَة لِأَقْصَى دَرَجَة)",
 "pitchblende": "بتشبيند, يورانينيت (معدن يتكون من أكسيد اليورانيوم وآثار من الراديوم والثوريوم والبولونيوم والرصاص والهيليوم؛ يسمى اليورانينيت في شكله الكتلي بتشبيند وهو خام اليورانيوم…)",
 "pitched": "مُمَال (مضبوط بميلان) / ذو طبقة صوتية, منغم ((للصوت) مضبوط على طبقة أو مفتاح معين؛ تستخدم عادة كصيغة مركبة)\nمثال: عالي النبرة",
 "pitched battle": "معركة ضارية",
 "pitcher": "إِبْرِيق, زِير",
 "pitcher plant": "سراسينية, نبات الإبريق (أي من الأعشاب الآكلة للحشرات المتعددة من رتبة السراسنيات)",
 "pitcher sage": "ليبيشينيا, ميرمية الجرة (نبات من كاليفورنيا بسيقان وأوراق صوفية وزهور بيضاء كبيرة) / قصعين جبي, ميرمية الجرة (نبات معمر منتصب وقليل التفرع في كاليفورنيا)",
 "pitcher's mound": "تل الرامي ((بيسبول) الارتفاع الطفيف الذي يقف عليه الرامي)",
 "pitcher-shaped": "إِبْرِيقِيّ الشَّكْل (على شكل إبريق)",
 "pitcherful": "ملء إبريق (الكمية المحتواة في إبريق)",
 "pitchfork": "شَوْكَة (أداة لتناول الطعام تتكون عادةً من مقبض وعدة أسنان حادة، وتُستعمل لغرز الطعام وحمله إلى الفم) / مِذْرَاة\nمثال: هناك شوكة ناقصة.",
 "pitching": "رمي ((في البيسبول) اللعب في مركز الرامي) / تأرجح رأسي, ترنح (حركة صعود وهبوط مفاجئة (كما تسببها سفينة أو وسيلة نقل أخرى))\nمثال: كان التأرجح والتقلب مثيراً للغاية",
 "pitching change": "تغيير الرامي (استبدال الرامي في البيسبول)",
 "pitching coach": "مدرب الرمي (مساعد مدرب بيسبول مسؤول عن الرماة)",
 "pitching wedge": "مضرب إسفين الرمي (مضرب إسفين يستخدم لرفع كرة الغولف فوق العقبات)",
 "pitchman": "بائع متجول (شخص يتجول لبيع بضائعه (كما في الشوارع أو الكرنفالات)) / بائع متجول (بائع عدواني يستخدم أسلوب حديث سريع لبيع شيء ما)",
 "pitchstone": "بتشستون, حجر القار (زجاج جرانيتي حمضي داكن)",
 "pitchy": "رَاتِنْجِيّ, قَطْرَانِيّ (له خصائص القطران أو الراتنج) / أَسْوَد حَالِك, أَسْوَد فَاحِم (بأشد درجات السواد؛ كلون الفحم الحجري أو القار)",
 "piteous": "بَائِس, مُثِيرٌ لِلشَّفَقَة (يَسْتَحِقُّ الشَّفَقَةَ أَوْ يَسْتَدْعِيهَا)",
 "piteously": "ببؤس, بشكل يثير الشفقة (بطريقة مثيرة للشفقة)",
 "pitfall": "حفرة, فخ (فخ على شكل حفرة مخفية) / شرك, فخ (صعوبة غير متوقعة أو مفاجئة)",
 "pith": "نُخَاع",
 "pith hat": "خوذة استوائية, قبعة الفلين (قبعة خفيفة الوزن تلبس في البلدان الاستوائية للحماية من الشمس)",
 "pith helmet": "خوذة استوائية, قبعة الفلين (قبعة خفيفة الوزن تلبس في البلدان الاستوائية للحماية من الشمس)",
 "pithead": "رأس البئر, مدخل المنجم (مدخل منجم الفحم)",
 "pithecanthropus": "إنسان القرد, بيثكانثروبوس (جنس سابق من البشر البدائيين الشبيهين بالقردة، يُصنف الآن كإنسان منتصب)",
 "pithecanthropus erectus": "إنسان القرد, بيثكانثروبوس (جنس سابق من البشر البدائيين الشبيهين بالقردة، يُصنف الآن كإنسان منتصب)",
 "pithecellobium dulce": "تمرهندي مانيلا, كاماشيل (شجرة استوائية أمريكية شائكة شائعة ذات عناقيد طرفية من الزهور الصفراء تليها قرون صالحة للأكل منجلية أو دائرية وتنتج خشباً جيداً وصبغة صفراء وصمغاً…)",
 "pithecellobium unguis-cati": "خرز أسود, مخلب القط (شجيرة منتصبة ذات أشواك صغيرة إن وجدت، ولها عناقيد من الزهور البيضاء إلى الصفراء تليها قرون منحنية مدببة وبذور سوداء لامعة؛ جزر الهند الغربية وفلوريدا)",
 "pithily": "بإيجاز بليغ, بجزالة (بطريقة موجزة وبليغة)\nمثال: عبرت عن نفسها بإيجاز بليغ",
 "pithiness": "إيجاز, بلاغة الإيجاز (الإيجاز والاقتصاد في الكتابة والتحدث من خلال التعبير عن الكثير في بضع كلمات فقط)",
 "pithouse": "مخبأ أرضي, منزل حفرة (مأوى للبشر أو الحيوانات الأليفة والماشية يعتمد على حفرة أو منخفض محفور في الأرض)\nمثال: المخابئ الأرضية هي واحدة من أقدم أنواع المساكن البشرية التي يعرفها علماء الآثار",
 "pithy": "بَلِيغ, ذُو مَغْزًى (مُوجَزٌ وَمَلِيءٌ بِالمَعْنَى)",
 "pitiable": "مُثِير لِلشَّفَقَة, مُزْرٍ (يُثِير مَزيجاً مِن الاحتقار والشَّفَقة) / بَائِس, مُثِيرٌ لِلشَّفَقَة (يَسْتَحِقُّ الشَّفَقَةَ أَوْ يَسْتَدْعِيهَا)",
 "pitiably": "بشكل مؤثر, بشكل يدمي القلب (بطريقة تثير التعاطف والشفقة)\nمثال: بكى الطفل المريض بشكل مؤثر",
 "pitiful": "مُثِير لِلشَّفَقَة, مُزْرٍ (يُثِير مَزيجاً مِن الاحتقار والشَّفَقة) / بَائِس, مُثِيرٌ لِلشَّفَقَة (يَسْتَحِقُّ الشَّفَقَةَ أَوْ يَسْتَدْعِيهَا) / مُؤْسِف, مُحْزِن (سيء ومؤسف؛ يبعث على الأسى)",
 "pitifully": "بشكل مخز, بشكل يثير الرثاء (لدرجة تثير الشفقة والرثاء)\nمثال: كانت الأجور منخفضة بشكل يثير الرثاء، خاصة أجور النساء",
 "pitiless": "بِلَا شَفَقَة, قَاسِي القَلْب (يفتقر إلى المشاعر الإنسانية واللطف) / بِلَا رَحْمَة, عَدِيمُ الشَّفَقَة (خَالٍ مِنَ الرَّحْمَةِ أَوِ الشَّفَقَة)",
 "pitilessly": "بقسوة بالغة, بلا رحمة (بدون شفقة؛ بطريقة لا ترحم)\nمثال: تعرض لهزيمة نكراء بلا رحمة من قبل خصمه في المجلس",
 "pitilessness": "ضَرَاوَة, عَدَم رَحْمَة (قسوة تتميز بافتقار الشفقة) / قسوة, وحشية (مشاعر انعدام الرحمة الشديدة)",
 "pitman": "عامل منجم (رجل يعمل في منجم فحم)",
 "pitocin": "أوكسيتوسين (هرمون تفرزه الغدة النخامية الخلفية؛ يحفز تقلصات الرحم وإدرار الحليب)",
 "piton": "وتد تسلق, وتد صخري (مسمار معدني به ثقب للحبل؛ يغرسه متسلقو الجبال في الجليد أو الصخر لاستخدامه كمقبض أو مرتكز)",
 "pitot": "أنبوب بيتوت (أداة قياس تتكون من أنبوب قائم الزاوية بطرف مفتوح موجه عكس تدفق السائل ويستخدم لقياس سرعة تدفق السائل)",
 "pitot head": "أنبوب بيتوت الساكن (أداة قياس تتكون من أنبوب بيتوت وأنبوب ساكن مدمجين تقيس الضغط الكلي والساكن؛ تستخدم في الطائرات لقياس السرعة الجوية)",
 "pitot tube": "أنبوب بيتوت الساكن (أداة قياس تتكون من أنبوب بيتوت وأنبوب ساكن مدمجين تقيس الضغط الكلي والساكن؛ تستخدم في الطائرات لقياس السرعة الجوية) / أنبوب بيتوت (أداة قياس تتكون من أنبوب قائم الزاوية بطرف مفتوح موجه عكس تدفق السائل ويستخدم لقياس سرعة تدفق السائل)",
 "pitot-static tube": "أنبوب بيتوت الساكن (أداة قياس تتكون من أنبوب بيتوت وأنبوب ساكن مدمجين تقيس الضغط الكلي والساكن؛ تستخدم في الطائرات لقياس السرعة الجوية)",
 "pitprop": "دعامة منجم (دعامة خشبية تستخدم لدعم سقف المنجم)",
 "pitressin": "الهرمون المضاد لإدرار البول, فازوبريسين (هرمون تفرزه الغدة النخامية الخلفية؛ يؤثر على ضغط الدم ويقلل تدفق البول)",
 "pitsaw": "منشار شقي كبير (منشار كبير يستخدم بكلتا اليدين كان يستخدم سابقاً لقطع جذوع الأشجار إلى ألواح؛ يقف رجل فوق الجذع والآخر في حفرة تحته)",
 "pitta": "بيتا, طائر الغلوة",
 "pittance": "أجر زهيد, مبلغ ضئيل (دفعة غير كافية)\nمثال: يعملون طوال اليوم مقابل مبلغ زهيد",
 "pitted": "سِنْخِيّ, مُجَوَّف (مليء بتجاويف تشبه الخلايا (كقرص العسل))",
 "pitter-patter": "خفقاً, دقا (وصف لضربات إيقاعية (مثل القلب)) / بخطوات خفيفة, طقطقة (كما في صوت الخطوات الخفيفة) / طقطقة, نقر سريع (سلسلة من أصوات النقر السريعة)\nمثال: قلبه كان يخفق",
 "pitting": "تخشّن, تنقر (تشكل نقر صغيرة في سطح ما نتيجة للتآكل)",
 "pittosporum": "حُبَض ((حَبَضَ) الْوَتَرُ: انْطَلَقَ بِشدَّة فصَوَّتَ؛ (حَبَضَ) بالْوَتَرُ: جَذَبه إِلَيْهِ ثمَّ أرْسلهُ فصوّت)",
