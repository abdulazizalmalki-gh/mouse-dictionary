 "photoelectric": "كهرضوئي (متعلق بالكهرباء الضوئية)\nمثال: التأثير الكهرضوئي",
 "photoelectric cell": "خلية كهروضوئية (محول طاقة يستخدم للكشف عن الضوء والإشعاعات الأخرى وقياسها)",
 "photoelectric emission": "انبعاث كهرضوئي (إطلاق أو امتصاص الكمات فوق مستوى طاقة معين)",
 "photoelectrical": "كهرضوئي (متعلق بالكهرباء الضوئية)\nمثال: التأثير الكهرضوئي",
 "photoelectrically": "كهروضوئياً (بواسطة وسائل كهروضوئية)\nمثال: قاسوا ذلك كهروضوئياً",
 "photoelectricity": "كهرباء ضوئية (كهرباء مولدة بواسطة الضوء أو تتأثر بالضوء)",
 "photoelectron": "فُوتُوإِلِكْتْرُون (إلكترون ينبعث من ذرة أو جزيء بواسطة فوتون ساقط)",
 "photoemission": "انبعاث ضوئي (انبعاث للإلكترونات الضوئية (خاصة من سطح معدني))",
 "photoemissive": "انبعاثي ضوئي (متعلق بالانبعاث الضوئي)",
 "photoengraving": "لوحة تظليل, نقش ضوئي (نقش يستخدم لإعادة إنتاج رسم توضيحي)",
 "photoflash": "فلاش, مصباح وميضي (مصباح لتوفير ضوء لحظي لالتقاط صورة فوتوغرافية)",
 "photoflood": "كشاف ضوئي, مصباح غامر (ضوء يعد مصدراً للإضاءة الاصطناعية ذات شعاع عريض؛ يستخدم في التصوير الفوتوغرافي)",
 "photogelatin process": "طباعة النمط الغروي, كولوتيب (عملية طباعة ميكانيكية ضوئية تستخدم لوحاً زجاجياً بسطح جيلاتيني يحمل الصورة المراد استنساخها؛ يمكن استخدامها مع لون واحد أو أكثر)",
 "photogenic": "حَسَن المَظْهَر فِي الصُّوَر, فُوتُوجِينِيّ (يبدو جذاباً في الصور الفوتوغرافية)",
 "photogenic epilepsy": "صرع ضوئي المنشأ (صرع انعكاسي يحفزه ضوء وامض)",
 "photograph": "صُورَة, صُورَة شَمْسِيَّة / اِلْتَقَطَ صُورَة",
 "photograph album": "ألبوم صور (ألبوم للصور الفوتوغرافية)",
 "photographer": "مُصَوِّر, مُصَوِّرَة",
 "photographer's model": "موديل تصوير (عارض يتخذ وضعيات للمصورين)",
 "photographic": "فُوتُوغْرَافِيّ (يُمَثِّل الناس أو الطبيعة بدقة وأمانة كالصورة الفوتوغرافية) / تصويري, فوتوغرافي (متعلق بالتصوير الفوتوغرافي أو تم الحصول عليه باستخدامه)\nمثال: معدات تصوير",
 "photographic camera": "آلة تصوير, كاميرا (معدات لالتقاط الصور (تتكون عادة من صندوق مانع للضوء مع عدسة في أحد الطرفين وفيلم حساس للضوء في الطرف الآخر))",
 "photographic density": "امتصاصية, كثافة ضوئية ((فيزياء) مقياس لمدى نقل المادة للضوء أو الإشعاع الكهرومغناطيسي الآخر)",
 "photographic emulsion": "مستحلب, مستحلب فوتوغرافي (طلاء حساس للضوء على الورق أو الفيلم؛ يتكون من حبيبات دقيقة من بروميد الفضة معلقة في جيلاتين)",
 "photographic equipment": "معدات تصوير (معدات يستخدمها المصور)",
 "photographic film": "فيلم, فيلم فوتوغرافي (مادة فوتوغرافية تتكون من قاعدة من السيلولويد مغطاة بمستحلب فوتوغرافي؛ تستخدم لعمل السلبيات أو الشفافيات)",
 "photographic material": "ورق تصوير (ورق حساس للضوء يمكن طباعة صورة فوتوغرافية عليه)",
 "photographic paper": "ورق تصوير (ورق حساس للضوء يمكن طباعة صورة فوتوغرافية عليه)",
 "photographic plate": "لوح فوتوغرافي (ورقة مسطحة من المعدن أو الزجاج يمكن تسجيل صورة فوتوغرافية عليها)",
