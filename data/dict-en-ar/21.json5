 "poltergeist": "رُوح شَرِيرَة (رَوَّحَ عليه بالمِرْوحَة: حَرَّكَها ليجلبَ إِليه نسيمَ الهواء؛ رَوَّحَ بالقوم: صلَّى بهم التراويح)\nمثال: كان سامي هو روح الحفلة.",
 "poltroon": "رَعْدِيد تَامّ (يَتَّسِم بِالجُبْن الكَامِل والمُطْلَق) / جبان, رعديد (جبان ذليل)",
 "poltroonery": "جبن مخز (صغر نفس ذليل)",
 "polyamide": "بولي أميد (بوليمر يحتوي على مجموعات أميد متكررة)",
 "polyamory": "تعدد علاقات الحب, علاقات الحب المتعددة",
 "polyandrist": "امرأة متعددة الأزواج (امرأة لديها زوجان أو أكثر)",
 "polyandrous": "مُتَعَدِّدَةُ الأَزْوَاج (لَهَا أَكْثَرُ مِنْ زَوْجٍ فِي الوَقْتِ ذَاتِه)",
 "polyandry": "تَعَدُّد اَلْأَزْوَاج",
 "polyanthus": "بوليانثوس (زهور الربيع الخاصة بائعي الزهور؛ تعتبر هجيناً معقداً مشتقاً من زهرة الربيع العالية وزهرة الربيع الشائعة)",
 "polyarteritis": "التهاب الشرايين المتعدد (التهاب عدة شرايين)",
 "polyarteritis nodosa": "التهاب الشرايين العقدة (مرض تدريجي للأنسجة الضامة يتميز بوجود عقيدات على طول الشرايين)",
 "polyatomic": "متعدد الذرات (متعلق بجزيء يتكون من أكثر من ذرتين)",
 "polyborus cheriway audubonii": "كاراكارا أودوبون (منتشر من جنوب الولايات المتحدة إلى أمريكا الوسطى؛ أسود صدئ مع صدر وذيل أبيض وأسود)",
 "polyborus plancus": "كارانشا (كاراكارا من أمريكا الجنوبية)",
 "polybotria cervina": "أولفيرسيا, لسان الأيل (سرخس أرضي أمريكي استوائي بسعف رمحي جلدي؛ يوضع أحياناً في جنس بوليبوتريا)",
 "polybotrya cervina": "أولفيرسيا, لسان الأيل (سرخس أرضي أمريكي استوائي بسعف رمحي جلدي؛ يوضع أحياناً في جنس بوليبوتريا)",
 "polybutene": "بولي بوتيلين, بولي بوتين (بوليمر من البوتيلين؛ يستخدم في زيوت التشحيم والمطاط الصناعي)",
 "polybutylene": "بولي بوتيلين, بولي بوتين (بوليمر من البوتيلين؛ يستخدم في زيوت التشحيم والمطاط الصناعي)",
 "polycarboxylate cement": "أسمنت بولي كربوكسيلات (أسمنت أسنان يستخدم كعامل لاصق لترميمات الأسنان وكبطانة للتجاويف)",
 "polycarp": "القِدِّيس بُولِيكارْبُوس (أسقف سميرنا اليوناني الذي رفض التراجع عن إيمانه المسيحي وحُرق حتى الموت (حوالي 69-155))",
 "polychaete": "كثيرات الأشواك (ديدان حلقية بحرية بشكل رئيسي تمتلك كلا الجنسين ولها زوائد مزدوجة (نظائر الأرجل) تحمل شعيرات)",
 "polychaete worm": "كثيرات الأشواك (ديدان حلقية بحرية بشكل رئيسي تمتلك كلا الجنسين ولها زوائد مزدوجة (نظائر الأرجل) تحمل شعيرات)",
 "polychete": "كثيرات الأشواك (ديدان حلقية بحرية بشكل رئيسي تمتلك كلا الجنسين ولها زوائد مزدوجة (نظائر الأرجل) تحمل شعيرات)",
 "polychete worm": "كثيرات الأشواك (ديدان حلقية بحرية بشكل رئيسي تمتلك كلا الجنسين ولها زوائد مزدوجة (نظائر الأرجل) تحمل شعيرات)",
 "polychromatic": "مُتَعَدِّد الأَلْوَان ((للضوء أو الإشعاع الكهرومغناطيسي الآخر) يتكون من أكثر من طول موجي واحد) / مُتَعَدِّد الأَلْوَان (ذو ألوان عديدة ومتنوّعة)\nمثال: ضوء متعدد الألوان",
 "polychrome": "مُتَعَدِّد الأَلْوَان (ذو ألوان عديدة ومتنوّعة) / متعدد الألوان (قطعة عمل مكونة من أو مزينة بألوان عديدة)",
 "polychromic": "مُتَعَدِّد الأَلْوَان (ذو ألوان عديدة ومتنوّعة)",
 "polycillin": "أمبيسيلين (بنسلين شبه صناعي (الأسماء التجارية برينسيبين وبوليسيلين وغيرها))",
 "polyclitus": "بُولِيكِلَيْتُوس",
 "polyconic projection": "إسقاط متعدد المخاريط (إسقاط مخروطي لخريطة تكون فيه المسافات بين خطوط الطول مساوية لتلك المسافات على الكرة الأرضية)",
 "polycrystalline": "مُتَعَدِّد البَلُّورَات (مُكَوَّن مِنْ تَجَمُّعَات بَلُّورِيَّة مُتَعَدِّدَة)",
 "polycystic kidney disease": "مرض الكلى المتعدد الكيسات (مرض كلوي يتميز بتضخم الكلى واحتوائها على العديد من التكيسات)",
 "polycystic ovary syndrome": "مُتَلَازِمَة تَكَيُّس الْمَبَايِض",
 "polycythemia": "احمرار الدم, كثرة الحمر (اضطراب يتميز بزيادة غير طبيعية في عدد خلايا الدم الحمراء في الدم)",
 "polydactyl": "عديد الأصابع (مكون من أو متعلق بشخص (أو فقاريات أخرى) لديه أكثر من العدد الطبيعي للأصابع)",
 "polydactylous": "عديد الأصابع (مكون من أو متعلق بشخص (أو فقاريات أخرى) لديه أكثر من العدد الطبيعي للأصابع)",
 "polydactylus virginicus": "باربو (توجد على طول ساحل المحيط الأطلسي الغربي)",
 "polydactyly": "كَثْرَة اَلْأَصَابِع",
 "polydipsia": "عطش مفرط, نهام للسوائل (عطش مفرط (كما في حالات السكري أو خلل وظائف الكلى))",
 "polyelectrolyte": "إلكتروليت مبلمر, بولي إلكتروليت (إلكتروليت ذو وزن جزيئي عالي)",
 "polyergus rufescens": "نملة أمازونية (نوع نمل صغير محمر مستعبد)",
 "polyester": "بُولْيَسْتَر",
 "polyester fiber": "ألياف البوليستر (ألياف صناعية مرنة سريعة الجفاف تتكون أساساً من البوليستر)",
 "polyestrous": "مُتَعَدِّد الشِّبْق (له أكثر من دورة شبق واحدة في السنة)",
 "polyethylene": "بولي إثيلين",
 "polyfoam": "رغوة البولي يوريثان (رغوة تُصنع بإضافة الماء إلى بلاستيك البولي يوريثان)",
 "polygala alba": "سينيغا (عشب شجيري معمر من وسط وجنوب الولايات المتحدة له زهور بيضاء بمراكز خضراء وغالباً عرف أرجواني؛ يشبه جذر ثعبان سينيكا)",
 "polygala lutea": "مستدرة برتقالية, مستدرة صفراء (نبات مستنقعات في غابات الصنوبر بجنوب شرق الولايات المتحدة له سنابل من الزهور الصفراء البرتقالية غير المنتظمة)",
 "polygala paucifolia": "مستدرة مهدبة, وينترغرين مزهر (مستدرة معمرة زاحفة شائعة في شرق أمريكا الشمالية لها أوراق تشبه الوينترغرين وزهور وردية أرجوانية عادة بسبلات مجنحة)",
 "polygala senega": "جذر ثعبان سينيكا, جذر سينيغا (نبات من شرق أمريكا الشمالية له عنقود طرفي من الزهور البيضاء الصغيرة وجذور طبية)",
 "polygala vulgaris": "مستدرة شائعة (نبات معمر أوروبي صغير له فروع عديدة تحمل عناقيد من الزهور الزرقاء أو الوردية أو البيضاء؛ كان يشتهر سابقاً بتعزيز الرضاعة البشرية)",
 "polygamist": "متعدد الزوجات (شخص متزوج من شخصين أو أكثر في نفس الوقت)",
 "polygamous": "مُتَعَدِّدُ المَسَاكِن (لَهُ عِدَّةُ أَشْكَالٍ مِنْ أَعْضَاءِ التَّكَاثُرِ عَلَى نَفْسِ النَّبَات) / متعدد الأزواج, متعدد الزوجات (له أكثر من شريك في وقت واحد؛ يستخدم للعلاقات والأفراد)",
 "polygamy": "تَعَدُّدُ الأَزْوَاج",
 "polygene": "بوليجين, جين متعدد (جين له تأثير ضئيل بمفرده على النمط الظاهري ولكنه يمكن أن يعمل مع جينات أخرى لإنتاج تغييرات ملحوظة)",
 "polygenic": "مُتَعَدِّدُ الْجِينَات (متعلق بصفة وراثية تتحكم بها عدة جينات في آنٍ واحد)",
 "polygenic disease": "اضطراب متعدد الجينات (مرض وراثي تتحكم فيه عدة جينات في وقت واحد)",
 "polygenic disorder": "اضطراب متعدد الجينات (مرض وراثي تتحكم فيه عدة جينات في وقت واحد)",
 "polyglot": "مَزِيج مِن اللُّغَات, بُولِيجْلُوت",
 "polygon": "مُضَلَّع",
 "polygonal": "مُضَلَّع",
 "polygonal chain": "سلسلة مضلعة (في الهندسة، سلسلة متصلة من القطع المستقيمة)",
 "polygonal shape": "مضلع (شكل مستو مغلق تحده أضلاع مستقيمة)",
 "polygonally": "بشكل مضلع, مضلعاً (بطريقة مضلعة الشكل)",
 "polygonatum biflorum": "خاتم سليمان العظيم (عشب معمر من أمريكا الشمالية بأوراق ناعمة وزهور خضراء أنبوبية متدلية)",
 "polygonatum commutatum": "خاتم سليمان العظيم (عشب معمر من أمريكا الشمالية بأوراق ناعمة وزهور خضراء أنبوبية متدلية)",
 "polygonia comma": "فراشة الفاصلة (فراشة زاوية الجناح بعلامة على شكل فاصلة على الجانب السفلي لكل جناح خلفي)",
 "polygonum aubertii": "كرمة الدانتيل الفضي, كرمة الصوف الصيني (كرمة معمرة ملتفة لها عناقيد من الزهور المخضرة العطرية؛ غرب الصين إلى روسيا)",
 "polygonum fagopyrum": "حنطة سوداء",
 "polygonum orientale": "بطباط شرقي, ريشة الأمير (نبات حولي بأوراق بيضاوية عريضة وسنابل متدلية رفيعة من الزهور القرمزية؛ جنوب شرق آسيا وأستراليا؛ توطن في أمريكا الشمالية)",
 "polygraph": "بوليجراف, جهاز كشف الكذب (أداة طبية تسجل عدة عمليات فسيولوجية في وقت واحد (مثل معدل النبض وضغط الدم والتنفس والتعرق))",
 "polygynist": "رجل متعدد الزوجات (رجل لديه زوجتان أو أكثر)",
 "polygynous": "مُتَعَدِّدُ الزَّوْجَات (لَهُ أَكْثَرُ مِنْ زَوْجَةٍ فِي الوَقْتِ ذَاتِه)",
 "polygyny": "تَعَدُّد اَلزَّوْجَات",
 "polyhedral": "متعدد السطوح (مكون من أو متعلق بـ أو يشبه متعدد السطوح)",
 "polyhedral angle": "زاوية متعددة السطوح (الفضاء المحاط بثلاثة مستويات أو أكثر تتقاطع في رأس)",
 "polyhedron": "متعدد السطوح, مجسم كثير السطوح (شكل صلب تحدّه مضلعات أو أوجه مستوية)",
 "polyhidrosis": "فرط التعرق (تعرق مفرط وغزير)",
 "polymastigote": "متعدد الأسواط (سوطيات لها عدة أسواط)",
 "polymath": "عَلَّامَة, بحر العلوم (سِمَةٌ أو أمارة أو شِعَار تُعرف به الأشياء؛ رَمْز)\nمثال: تحصلت على علامة أ.",
 "polymer": "بُولِيمَر",
 "polymerase": "بوليميراز",
 "polymeric": "بوليمري, مبلمر (مكون من أو متعلق بـ أو يتكون من بوليمر)\nمثال: مركب بوليمري",
 "polymeric amide": "بولي أميد (بوليمر يحتوي على مجموعات أميد متكررة)",
 "polymerisation": "بلمرة (عملية كيميائية تجمع عدة مونومرات لتكوين بوليمر أو مركب بوليمري)",
 "polymerization": "بلمرة (عملية كيميائية تجمع عدة مونومرات لتكوين بوليمر أو مركب بوليمري)",
 "polymethyl methacrylate": "بولي ميثيل ميثاكريلات (بلاستيك شفاف يُستخدم كبديل للزجاج)",
 "polymetry": "تعدد الإيقاعات (الجمع بين أوزان موسيقية مختلفة في وقت واحد)\nمثال: يعني تعدد الإيقاعات النموذجي في الموسيقى السوداء وجود إيقاعين على الأقل، وعادة أكثر، جنباً إلى جنب مع إيقاع المستمع الخاص",
 "polymonium caeruleum van-bruntiae": "سلم يعقوب, ناردين يوناني (نبات معمر أوروبي ذو أوراق ريشية له زهور زرقاء زاهية أو بيضاء)",
 "polymorph": "متعدد الأشكال (كائن يمكن أن يتخذ أكثر من شكل بالغ واحد كما في طوائف النمل أو النمل الأبيض)",
 "polymorphemic": "متعدد المورفيمات (يتكون من اثنين أو أكثر من المورفيمات)",
 "polymorphic": "مُتَعَدِّدُ الْأَشْكَالِ (له أو يظهر في عدة أشكال متمايزة) / متعدد الأشكال (متعلق بوجود أكثر من نوع واحد من الأفراد (بغض النظر عن الاختلافات الجنسية) في مجموعة متزاوجة) / متعدد الأشكال (متعلق بتبلور مركب في شكلين مختلفين أو أكثر)\nمثال: نوع متعدد الأشكال",
 "polymorphism": "تعدد الأشكال ((في علم الأحياء) وجود شكلين أو أكثر من الأفراد ضمن نفس النوع الحيواني (بشكل مستقل عن الفروق الجنسية)) / تعدد الأشكال, تعدد الأشكال البلورية ((في الكيمياء) وجود أنواع مختلفة من البلورات لنفس المركب الكيميائي) / تعدد الأشكال الجينية ((في علم الوراثة) التباين الوراثي داخل مجتمع ما الذي يمكن للانتقاء الطبيعي أن يعمل عليه)",
 "polymorphous": "مُتَعَدِّدُ الْأَشْكَالِ (له أو يظهر في عدة أشكال متمايزة) / متعدد الأشكال (متعلق بوجود أكثر من نوع واحد من الأفراد (بغض النظر عن الاختلافات الجنسية) في مجموعة متزاوجة) / متعدد الأشكال (متعلق بتبلور مركب في شكلين مختلفين أو أكثر)\nمثال: نوع متعدد الأشكال",
 "polymox": "أموكسيسيلين, أموكسيل (مضاد حيوي؛ بنسلين فموي شبه صناعي (الأسماء التجارية أموكسيل وأوجمنتين وغيرها) يستخدم لعلاج الالتهابات البكتيرية)",
 "polymyositis": "التهاب العضلات المتعدد (التهاب عضلات يتميز بضعف عضلات الأطراف والرقبة والكثير من آلام العضلات والتورم؛ يختلف التقدم والشدة بين الأفراد)",
 "polymyxin": "بوليميكسين (أي من عدة مضادات حيوية سامة يتم الحصول عليها من بكتيريا تربة معينة)",
 "polynesia": "بُولِينِزِيَا",
 "polynesian": "بولينيزي (من أو يتعلق ببولينيزيا أو شعبها أو ثقافتها) / اللغات الملايو بولينيزية (فرع اللغات الأسترونيزية الذي يتم التحدث به من مدغشقر إلى وسط المحيط الهادئ) / بولينيزي (مواطن أو ساكن في بولينيزيا)",
 "polynesian tattler": "ثرثارة بولينيزية (طائر ثرثار يعيش في المناطق الساحلية للمحيط الهادئ)",
 "polyneuritic psychosis": "خرف كحولي, ذهان كورساكوف (خرف يلاحظ خلال المراحل الأخيرة من إدمان الكحول المزمن الشديد؛ ينطوي على فقدان الذاكرة للأحداث الأخيرة على الرغم من سلامة الذاكرة طويلة المدى)",
 "polyneuritis": "التهاب الأعصاب المتعدد (التهاب العديد أو كل الأعصاب المحيطية (كما في الجذام))",
 "polynomial": "متعدد الحدود (لديه طابع متعدد الحدود) / كَثِيرَة الحُدُود, مُتَعَدِّدَة الحُدُود (دالة رياضية هي مجموع عدد من الحدود)\nمثال: تعبير متعدد الحدود",
 "polynucleotide": "عديد النيوكليوتيد (بوليمر خطي يتكون جزيئه من العديد من وحدات النيوكليوتيدات التي تشكل قسماً من جزيء الحمض النووي)",
 "polynya": "بولينيا, فجوة جليدية (مساحة من المياه المفتوحة محاطة بالجليد (خاصة في البحار القطبية))",
 "polyodon spathula": "سمكة المجداف (سمكة بدائية في وادي المسيسيبي لها خطم طويل يشبه المجداف)",
 "polyoestrous": "مُتَعَدِّد الشِّبْق (له أكثر من دورة شبق واحدة في السنة)",
 "polyoicous": "مُتَعَدِّدُ المَسَاكِن (لَهُ عِدَّةُ أَشْكَالٍ مِنْ أَعْضَاءِ التَّكَاثُرِ عَلَى نَفْسِ النَّبَات)",
 "polyoma": "بوليونا, فيروس الورم المتعدد (فيروس يمكن أن يبدأ أنواعاً مختلفة من الأورام في الفئران)",
 "polyoma virus": "بوليونا, فيروس الورم المتعدد (فيروس يمكن أن يبدأ أنواعاً مختلفة من الأورام في الفئران)",
 "polyose": "سكر متعدد, عديد السكاريد (أي فئة من الكربوهيدرات تحتوي جزيئاتها على سلاسل من جزيئات السكر الأحادي)",
 "polyostotic fibrous dysplasia": "خلل التنسج الليفي متعدد العظام, متلازمة أولبرايت (خلل التنسج الليفي للعظام الذي يؤثر على عظام متعددة)",
 "polyp": "بوليب, سليلة (أحد الشكلين اللذين تتخذهما الجوفمعويات (مثل الهيدرا أو المرجان): عادة ما تكون لاطئة بجسم أسطواني مجوف عادة مع حلقة من المجسات حول الفم) / بوليب, سليلة (نمو وعائي صغير على سطح الغشاء المخاطي)\nمثال: في بعض أنواع الجوفمعويات، تكون السلائل مرحلة في دورة الحياة تتناوب مع مرحلة الميدوزا",
 "polypectomy": "استئصال السليلة (إزالة جراحية للسليلة (ورم حميد))",
 "polypeptide": "عديد الببتيد (ببتيد يحتوي على 10 إلى أكثر من 100 حمض أميني)",
 "polypetalous": "مُنْفَصِل البَتَلَات (ذو تويج مكوَّن من بتلات متعدّدة منفصلة)",
 "polyphase": "متعدد الأطوار (نظام كهربائي يستخدم أو يولد جهدين مترددين أو أكثر بنفس التردد ولكن بزوايا طور مختلفة)",
 "polyphemus moth": "عثة بوليفيموس (عثة دودة قز أمريكية كبيرة جداً بنية مصفرة ببقع عينية كبيرة على الأجنحة الخلفية؛ تتغذى اليرقات على أشجار الفاكهة والظل)",
 "polyphone": "حرف متعدد الأصوات (حرف له نطقان أو أكثر)",
 "polyphonic": "بوليفوني, طباقي (يحتوي على جزأين لحنيين مستقلين أو أكثر مترابطين توافقياً ويعزفان معاً) / بوليفوني, متعدد الأصوات (متعلق بتعدد الأصوات (البوليفونية) أو يتميز به) / متعدد الأصوات (له قيمتان صوتيتان أو أكثر)\nمثال: تقاليد الباروك متعددة الأصوات",
 "polyphonic letter": "حرف متعدد الأصوات (حرف له نطقان أو أكثر)",
 "polyphonic music": "بوليفونية, تعدد الأصوات (موسيقى مرتبة في أجزاء لعدة أصوات أو أدوات)",
 "polyphonic prose": "نثر متعدد الأصوات (نثر إيقاعي يستخدم الأدوات الشعرية للجناس والسجع)",
 "polyphonically": "بوليفونياً, متعدد الأصوات (بطريقة متعددة الأصوات)\nمثال: مؤلفة بأسلوب متعدد الأصوات",
 "polyphonous": "بوليفوني, متعدد الأصوات (متعلق بتعدد الأصوات (البوليفونية) أو يتميز به)\nمثال: تقاليد الباروك متعددة الأصوات",
 "polyphony": "بوليفونية, تعدد الأصوات (موسيقى مرتبة في أجزاء لعدة أصوات أو أدوات)",
 "polyphosphate": "بولي فوسفات (ملح أو إستر لحمض البولي فوسفوريك)",
 "polyphosphoric acid": "حمض البولي فوسفوريك (سلسلة من الأحماض الأكسجينية للفوسفور)",
 "polyplacophore": "خيتون, عديد الأصداف (رخوي بحري بدائي ممدود متناظر ثنائياً له عباءة مغطاة بثماني صفائح جيرية)",
 "polyploid": "متعدد الصيغة الصبغية (لخلية أو كائن حي يحتوي على أكثر من ضعف العدد الأحادي من الكروموسومات) / متعدد الصيغة الصبغية ((في علم الوراثة) كائن أو خلية تحتوي على أكثر من ضعف العدد الأحادي من الكروموسومات)\nمثال: خلية متعددة الصيغة الصبغية",
 "polyploidy": "تعدد الصيغة الصبغية (حالة كون الكائن متعدد الصيغة الصبغية)",
 "polypodium aureum": "بوليبودي ذهبي, سرخس قدم الأرنب (سرخس أمريكي استوائي بجذامير قشرية بنية يزرع لسعفه الكبير المفصص بعمق ذي اللون الأخضر المزرق الداكن؛ يوضع أحياناً في جنس بوليبوديوم)",
 "polypodium glycyrrhiza": "سرخس عرق السوس (سرخس ذو جذمور بنكهة حلوة)",
 "polypodium polypodioides": "بوليبودي رمادي, سرخس القيامة (سرخس ينمو على الصخور أو جذوع الأشجار وله سعف رمادي وحرشفي من الأسفل؛ الأمريكتين وجنوب أفريقيا)",
 "polypodium scouleri": "بوليبودي جلدي, ورقة الجلد (سرخس صلب جلدي الأوراق في غرب أمريكا الشمالية ذو سعف بيضاوي مفترق حتى العرق الوسطي)",
 "polypodium virgianum": "بوليبودي الصخر, سرخس الجدار الأمريكي (سرخس صخري أو هوائي بشكل رئيسي في أمريكا الشمالية وشرق آسيا)",
 "polypodium vulgare": "بوليبودي شائع, سرخس الجدار (سرخس صخري أو أرضي يشكل حصيرة بجذامير زاحفة وسعف ريشي كبير يوجد في جميع أنحاء أمريكا الشمالية وأوروبا وأفريقيا وشرق آسيا)",
 "polypody": "بَسْبَايَج",
 "polypore": "بوليبور, فطر متعدد المسام (فطريات مسامية خشبية؛ أي فطر من فصيلة بوليبوراسيا أو فصيلة بوليتاسيا يكون سطحه الحامل للأبواغ داخل أنابيب أو مسام؛ الأجسام الثمرية عادة ما تكون خشبية…)",
 "polyporus frondosus": "دجاجة الغابة, فطر دجاجة الغابة (فطر كبير صالح للأكل بني رمادي يشكل كتلة من القبعات المتداخلة تشبه الدجاجة إلى حد ما عند قاعدة الأشجار)",
 "polyporus squamosus": "بوليبور حرشفي (فطر بساق جانبي (عند وجود ساق) وقبعة حرشفية تصبح سوداء تقريباً عند النضج؛ واسع الانتشار في نصف الكرة الشمالي)",
 "polyporus tenuiculus": "بوليبوروس تينويكولوس (فطر بقبعة بيضاء كلوية الشكل ومسام ممدودة؛ يسبب العفن الأبيض في الأخشاب الصلبة الميتة)",
 "polyprion americanus": "قاروص الحجارة (سمكة بنية من المحيط الأطلسي والبحر الأبيض المتوسط توجد حول الصخور وحطام السفن)",
 "polypropene": "بولي بروبيلين (بوليمر من البروبيلين يستخدم كمادة صب حرارية)",
 "polypropenonitrile": "أكريلان, بولي بروبينونتريل (راتنج أكريليك يُستخدم لصنع نسيج قوي وناعم مقاوم للتجعد)",
 "polypropylene": "بولي بروبيلين (بوليمر من البروبيلين يستخدم كمادة صب حرارية)",
 "polyptoton": "جناس اشتقاقي (تكرار كلمة في حالة إعرابية أو تصريف مختلف في نفس الجملة)",
 "polypus": "بوليب, سليلة (نمو وعائي صغير على سطح الغشاء المخاطي)",
 "polysaccharide": "سكر متعدد, عديد السكاريد (أي فئة من الكربوهيدرات تحتوي جزيئاتها على سلاسل من جزيئات السكر الأحادي)",
 "polysemant": "متعدد المعاني, مشترك لفظي (كلمة لها أكثر من معنى)",
 "polysemantic": "مُتَعَدِّد الدَّلَالَات ((للكلمات) ذو معانٍ كثيرة)",
 "polysemantic word": "متعدد المعاني, مشترك لفظي (كلمة لها أكثر من معنى)",
 "polysemous": "مُتَعَدِّد الدَّلَالَات ((للكلمات) ذو معانٍ كثيرة)",
 "polysemous word": "متعدد المعاني, مشترك لفظي (كلمة لها أكثر من معنى)",
 "polysemy": "تَعَدُّدُ مَعَانٍ",
 "polysexuality": "تَعَدُّدِيَّة جِنْسِيَّة",
 "polysomy": "تعدد الصبغي (عيب خلقي يتمثل في وجود كروموسوم إضافي واحد أو أكثر في الخلايا الجسدية)",
 "polystichum acrostichoides": "سرخس الخنجر, سرخس عيد الميلاد (سرخس دائم الخضرة من أمريكا الشمالية له أوراق ريشية وعناقيد كثيفة من السعف رمحي الشكل)",
 "polystichum aculeatum": "سرخس مسنن, سرخس هولي (سرخس استوائي من العالم القديم له سعف لامع يوحي بالهولي؛ يوضع أحياناً في جنس بوليستيشوم)",
 "polystichum adiantiformis": "سرخس جلدي, سرخس ذو أوراق جلدية (سرخس واسع الانتشار في نصف الكرة الجنوبي الاستوائي له سعف جلدي مفصص ريشياً)",
 "polystichum braunii": "سرخس الدرع الشائك, سرخس بهشية براون (سرخس أمريكي شمالي سعفه الجلدي دائم الخضرة تقريباً مغطى بحراشف تشبه القش البني الشاحب)",
 "polystichum lonchitis": "سرخس البهشية الشمالي (سرخس أوروبي دائم الخضرة يزرع على نطاق واسع)",
 "polystichum scopulinum": "سرخس البهشية الغربي (سرخس أمريكي شمالي، يعرف أيضاً بأسماء سرخس البهشية الجبلي وسرخس السيف الصخري)",
 "polystichum setiferum": "سرخس الدرع الناعم (سرخس درعي أوروبي يزرع في العديد من الأصناف)",
 "polystyrene": "بوليسترين (بوليمر الستايرين؛ بلاستيك حراري شفاف صلب)\nمثال: البوليسترين الممدد يشبه الرغوة البيضاء الصلبة ويُستخدم كحشوة أو عازل",
 "polysyllabic": "مُتَعَدِّد المَقَاطِع ((في الكلمات) طَويل وَثَقيل؛ ذو مَقاطِع كَثيرَة) / مُتَعَدِّدُ المَقَاطِع (يتألّف من كلمات ذات أكثر من ثلاثة مقاطع صوتيّة)",
 "polysyllabic word": "كلمة متعددة المقاطع (كلمة تتكون من أكثر من ثلاثة مقاطع)",
 "polysyllabically": "بمقاطع متعددة (بطريقة متعددة المقاطع)",
 "polysyllable": "كلمة متعددة المقاطع (كلمة تتكون من أكثر من ثلاثة مقاطع)",
 "polysyndeton": "تعدد حروف العطف (استخدام عدة حروف عطف في تتابع وثيق، خاصة حيث يمكن حذف بعضها)",
 "polysynthetic": "إِلْصَاقِيّ, تَرْكِيبِيّ مُتَعَدِّد (يُشكِّل كلمات مشتقّة أو مركّبة بضمّ مكوّنات يحتفظ كلّ منها بمعناه المستقلّ)",
 "polytechnic": "مدرسة هندسة, معهد بوليتكنيك (مدرسة فنية تقدم تعليمات في العديد من الفنون الصناعية والعلوم التطبيقية)",
 "polytechnic institute": "مدرسة هندسة, معهد بوليتكنيك (مدرسة فنية تقدم تعليمات في العديد من الفنون الصناعية والعلوم التطبيقية)",
 "polytetrafluoroethylene": "بولي تترافلوروإيثيلين, تيفلون (مادة تستخدم لطلاء أواني الطهي وفي التطبيقات الصناعية لمنع الالتصاق)",
 "polytheism": "شِرْك, تَعَدُّد الْآلِهَة ((شَرِكَتِ) النَّعْلُ تَشْرَكُ شَرَكًا: انقطَعَ شِراكُها؛ (شَرِكَتْ) فُلانًا في الأمْرِ شِرْكًا، وشَرِكَةً، وشِرْكَةً: كان لكل منهما نصيب منه)\nمثال: هذه شركة صينية.",
 "polytheist": "مُشْرِك",
 "polytheistic": "متعدد الآلهة, مشرك",
 "polythene": "بولي إيثيلين (بلاستيك حراري خفيف الوزن؛ يستخدم بشكل خاص في التغليف والعزل)",
 "polytonal": "مُتَعَدِّد المَقَامَات (يستخدم أكثر من مقام أو نغمية في آن واحد)",
 "polytonalism": "بوليتونية, تعدد المقامية (موسيقى تستخدم مفتاحين موسيقيين مختلفين أو أكثر في نفس الوقت)",
 "polytonality": "بوليتونية, تعدد المقامية (موسيقى تستخدم مفتاحين موسيقيين مختلفين أو أكثر في نفس الوقت)",
 "polytropic process": "عملية بوليتراوبيك, عملية متعددة التوجهات",
 "polyunsaturated": "مُتَعَدِّد عَدَم التَّشَبُّع ((عَنِ المُرَكَّبَات الكَرْبُونِيَّة خَاصَّةً الدُّهُون) يَحْتَوِي عَلَى رَوَابِط غَيْر مُشَبَّعَة كَثِيرَة)",
 "polyunsaturated fat": "دهون متعددة غير مشبعة (فئة من الدهون لها سلاسل كربون طويلة مع العديد من الروابط المزدوجة غير المشبعة بذرات الهيدروجين؛ تُستخدم في بعض أنواع المارجرين؛ ويعتقد أنها مرتبطة…)",
 "polyunsaturated fatty acid": "حمض دهني متعدد غير مشبع (حمض دهني غير مشبع تحتوي سلسلة الكربون الخاصة به على أكثر من رابطة تكافؤ مزدوجة أو ثلاثية لكل جزيء؛ يوجد بشكل رئيسي في السمك وزيت الذرة وزيت فول…)",
 "polyurethan": "بولي يوريثان (أي من البوليمرات المختلفة التي تحتوي على شق اليوريثان؛ تُصنع منه مجموعة متنوعة من الأشكال الاصطناعية وتستخدم كمواد لاصقة أو بلاستيك أو طلاء أو مطاط)",
 "polyurethane": "بولي يوريثان (أي من البوليمرات المختلفة التي تحتوي على شق اليوريثان؛ تُصنع منه مجموعة متنوعة من الأشكال الاصطناعية وتستخدم كمواد لاصقة أو بلاستيك أو طلاء أو مطاط)",
 "polyurethane foam": "رغوة البولي يوريثان (رغوة تُصنع بإضافة الماء إلى بلاستيك البولي يوريثان)",
 "polyuria": "بوال (اضطراب كلوي يتميز بإنتاج كميات كبيرة من البول المخفف الشاحب)",
 "polyvalence": "تعدد التكافؤ ((علم السموم) حالة القدرة على مواجهة أكثر من سم أو مستضد أو نوع من الكائنات الحية الدقيقة) / تعدد التكافؤ ((كيمياء) حالة امتلاك تكافؤ أكبر من اثنين)",
 "polyvalency": "تعدد التكافؤ ((علم السموم) حالة القدرة على مواجهة أكثر من سم أو مستضد أو نوع من الكائنات الحية الدقيقة) / تعدد التكافؤ ((كيمياء) حالة امتلاك تكافؤ أكبر من اثنين)",
 "polyvalent": "متعدد التكافؤ (له أكثر من تكافؤ، أو تكافؤه 3 أو أعلى) / متعدد التكافؤ (يحتوي على عدة أجسام مضادة كل منها قادر على مقاومة مستضد معين)\nمثال: لقاح متعدد التكافؤ",
 "polyvinyl acetate": "بولي فينيل أسيتات (بوليمر فينيل يُستخدم خاصة في الدهانات أو المواد اللاصقة)",
 "polyvinyl chloride": "بي في سي, كلوريد البوليفينيل (بوليمر من كلوريد الفينيل يُستخدم بدلاً من المطاط في الكابلات الكهربائية)",
 "polyvinyl resin": "بوليمر الفينيل, راتنج الفينيل (بلاستيك حراري مشتق عن طريق البلمرة من مركبات تحتوي على مجموعة الفينيل)",
 "polyvinyl-formaldehyde": "بولي فينيل فورمالدهيد (بوليمر من فينيل الفورمالدهيد)",
 "polyzoan": "حيوان طحلبي, مرجانيات (حيوان مائي لاطئ يشكل مستعمرات طحلبية من سلائل صغيرة)",
 "pom": "بومي (مصطلح ازدرائي للشخص البريطاني)",
 "pom-pom": "مدفع مضاد للطائرات (مدفعية مصممة لإطلاق النار لأعلى باتجاه الطائرات) / بوم بوم, كرة صوفية (زينة تتكون من كرة من خيوط الصوف أو الحرير؛ توضع عادة على القبعة)",
 "pomace": "ثجير / جِفْت (في : أنزل محرك السيارة ونظّفه وأصلحه وأبدل القطع التالفة فيه ثم أعاده)\nمثال: بكت حتى جفت دموعها.",
 "pomace fly": "ذبابة الفاكهة (أي من الحشرات الصغيرة المتعددة التي تتغذى يرقاتها على الفواكه)",
 "pomacentrus leucostictus": "سمكة بيوغريغوري, نوع من الأسماك القعيسية (سمكة قعيسية زرقاء وصفراء اللون تعيش في برمودا وفلوريدا وجزر الهند الغربية)",
 "pomade": "مَرْهَم, بُومَادَة",
 "pomaded": "مُدَهَّنٌ بِالبُومَاد ((لِلشَّعْرِ) مَعْنِيٌّ بِدُهْنِ البُومَاد)",
 "pomaderris apetala": "بندق, شجرة البندق (شجرة أسترالية تزرع خاصة للزينة ولخشبها دقيق الحبيبات وتحمل مكسرات صالحة للأكل)",
 "pomatomus saltatrix": "سمكة زرقاء (سمكة غذائية ورياضية بحرية زرقاء تعيش في المياه الدافئة وتتبع أسراب الأسماك الصغيرة إلى المياه الضحلة)",
 "pomatum": "دهن شعر, مرهم شعر (مستحضر للشعر يتكون من زيت معطر أو مرهم)",
 "pome": "ثمرة تفاحية (فاكهة لحمية (تفاح أو كمثرى أو فواكه ذات صلة) تحتوي على غرف بذور وجزء خارجي لحمي)",
 "pomegranate": "رُمَّان",
 "pomegranate molasses": "دِبْس الرُّمَّان (دبسه:ستره وواراه.1؛ الخف: رقعه.1)",
 "pomegranate tree": "رمان, شجرة الرمان (شجيرة أو شجرة صغيرة موطنها جنوب غرب آسيا لها ثمار حمراء كبيرة كثيرة البذور)",
 "pomelo": "زَنْبُوع, بُومَلِيّ",
 "pomelo tree": "بوملي, ليمون هندي (شجرة من جنوب شرق آسيا تنتج ثماراً كبيرة تشبه الجريب فروت)",
 "pomeranian": "بوميرانيان (سلالة من الكلاب الصغيرة جداً المدمجة طويلة الشعر من نوع السبيتز)",
 "pomfret": "بومفريت (سمكة شائكة الزعانف عميقة الجسم سوداء فحمية تعيش في عرض البحر في شمال المحيط الأطلسي وشمال المحيط الهادئ؛ تُقدر كطعام)",
 "pomme blanche": "جذر الخبز, سوراليا (نبات معمر كثيف الشعر في وسط أمريكا الشمالية له جذور درنية صالحة للأكل)",
 "pomme de prairie": "جذر الخبز, سوراليا (نبات معمر كثيف الشعر في وسط أمريكا الشمالية له جذور درنية صالحة للأكل)",
 "pommel": "مقبض مزخرف (زخرفة على شكل كرة على مقبض السيف أو الخنجر) / قربوس السرج, مقدم السرج (مقبض يد يتشكل من الجزء الأمامي المرتفع للسرج) / مقبض حصان الحلق (مقبض يستخدمه لاعب الجمباز عند أداء التمارين على حصان الحلق)",
 "pommel horse": "حصان الحلق (حصان جمباز بجسم أسطواني مغطى بالجلد ومقابض قائمة (حلقات) بالقرب من المركز؛ مثبت بواسطة دعامتين فولاذيتين)",
 "pommy": "بومي (مصطلح ازدرائي للشخص البريطاني)",
 "pomo": "لغة بومو (لغة كولانابان يتحدث بها شعب بومو) / بومو (فرد من شعب هندي في شمال كاليفورنيا يعيش على طول وادي نهر روسيا وساحل المحيط الهادئ المجاور)",
 "pomo language": "لغة بومو (لغة كولانابان يتحدث بها شعب بومو)",
 "pomolobus pseudoharengus": "ألوف (سمكة غذائية تشبه الشاد تصعد الأنهار للتكاثر؛ غالباً ما تُملح أو تدخن)",
 "pomologist": "بستاني فواكه, عالم فاكهة (شخص ضليع في علم الفاكهة أو شخص يزرع أشجار الفاكهة)",
 "pomology": "علم زراعة الفاكهة (فرع علم النبات الذي يدرس ويزرع الفواكه)",
 "pomoxis annularis": "كرابي أبيض (نوع من سمك الكرابي لونه أبيض)",
 "pomoxis nigromaculatus": "كرابي أسود (نوع من سمك الكرابي لونه أسود)",
 "pomp": "أُبَّهَة, مَوْكِب فَخْم (الأناقة والفخامة الاحتفالية) / بهرجة, فخفخة (عرض رخيص أو متكلف أو مغرور)\nمثال: دخل بأبهة كبيرة في عربة تجرها ثمانية خيول بيضاء",
 "pompadour": "تَسْرِيحَة بُومْبَادُور (تصفيفة شعر يسرح فيها الشعر الأمامي للأعلى بعيداً عن الجبهة)",
 "pompano": "بومبانو (أي من عدة أسماك غذائية عميقة الجسم في غرب المحيط الأطلسي وخليج المكسيك) / بومبانو (لحم البومبانو؛ سمكة مياه دافئة دهنية)",
 "pompeii": "بُومْبِي, بومبي",
 "pompon": "بومبون (سمكة غذائية رمادية داكنة توجد من لويزيانا وفلوريدا جنوباً) / بوم بوم, كرة صوفية (زينة تتكون من كرة من خيوط الصوف أو الحرير؛ توضع عادة على القبعة)",
 "pomposity": "انْتِفَاخ, تَبَاهِي (انعدام الأناقة نتيجة التفاخر والغرور وانتفاخ الذات)",
 "pompous": "طَنَّان, مُتَنَطِّع (متورّم بالغرور والتباهي الفارغ) / فخم, مهيب (يتميز بالأبهة والمراسم والعرض الفخم)",
 "pompously": "بِتَكَلُّف, بِغُرُور (بطريقة متغطرسة)\nمثال: وصف إنجازاته بغرور",
 "pompousness": "انْتِفَاخ, تَبَاهِي (انعدام الأناقة نتيجة التفاخر والغرور وانتفاخ الذات)",
 "ponca": "لغة بونكا (لهجة دهيجيا التي يتحدث بها شعب بونكا) / بونكا (فرد من الشعب السيوي في وادي نهر ميسوري في شمال شرق نبراسكا)",
 "ponce": "قواد (شخص يجلب الزبائن للمومسات) / رجل متأنق, قواد (رجل مخنث في تصرفاته ومبالغ في طريقة لباسه)",
 "ponce de leon": "بونس دي ليون, خوان بونس دي ليون (مستكشف إسباني اكتشف فلوريدا عام 1513 أثناء البحث عن ينبوع الشباب الأسطوري (1460-1521))",
 "poncho": "بونشو (عباءة تشبه البطانية بها ثقب في المنتصف للرأس)",
 "poncirus trifoliata": "برتقال بري, برتقال ثلاثي الأوراق (شجرة برتقال صينية نفضية شائكة صغيرة سريعة النمو تحمل زهوراً حلوة الرائحة وثماراً زخرفية ولكن غير صالحة للأكل: تستخدم كأصل في التطعيم وللأسوار الحية)",
 "pond": "بِرْكَة, غَدِير (مُسْتَنْقَع الماء أو أو بُحِيْرَة صغيرة؛ حوض الماء المصنوع لتزيين الحدائق وريها)\nمثال: البركة عميقة جدا.",
 "pond apple": "تفاح البركة, قشطة المستنقعات (فاكهة صفراء بيضاوية ذات لحم عطري جداً بلون الخوخ) / تفاح المستنقعات (شجرة صغيرة دائمة الخضرة من أمريكا الاستوائية بفاكهة صالحة للأكل؛ تستخدم بشكل رئيسي كأصل للتطعيم)",
 "pond bald cypress": "سرو أصلع, سرو المستنقعات (خشب سرو شائع في جنوب شرق الولايات المتحدة له جذع موسع عند القاعدة؛ يوجد في المستنقعات الساحلية وقيعان الأنهار الفيضية) / سرو أصلع, سرو المستنقعات (سرو شائع في جنوب شرق الولايات المتحدة له جذع متوسع عند القاعدة؛ يوجد في المستنقعات الساحلية وقيعان الأنهار الفيضية)",
 "pond cypress": "سرو المستنقعات (خشب صنوبر متساقط الأوراق من جنس التاكسوديوم، موطنه أمريكا الشمالية) / سرو البرك",
 "pond lily": "حورية الماء, زنبق الماء العطر (زنبق ماء ذو أوراق كبيرة وأزهار عطرية مبهرجة تطفو على الماء؛ من المناطق المعتدلة والاستوائية)",
 "pond pine": "صنوبر البرك (صنوبر كبير ثلاثي الإبر من المستنقعات الرملية بجنوب شرق الولايات المتحدة؛ إبره أطول من تلك الموجودة في صنوبر القار الشمالي)",
 "pond scum": "زبد البركة (طحالب خضراء تطفو بحرية في المياه العذبة)",
 "pond-apple tree": "تفاح المستنقعات (شجرة صغيرة دائمة الخضرة من أمريكا الاستوائية بفاكهة صالحة للأكل؛ تستخدم بشكل رئيسي كأصل للتطعيم)",
 "pond-scum parasite": "طفيلي زبد البركة (فطر مائي من فصيلة سينكيترياسيا يتطفل على زبد البركة)",
 "pond-skater": "بق الماء المتزحلق (بق طويل الأرجل ينزلق على سطح الماء)",
 "ponder": "تَفَكَّرَ, فَكَّرَ",
 "ponderable": "جدير بالاعتبار, قابل للوزن (يمكن وزنه أو التفكير فيه وتقديره) / قَابِلٌ لِلتَّأَمُّل (يُمْكِنُ التَّفْكِيرُ فِيهِ وَتَأَمُّلُه)\nمثال: شيء ملموس من العالم الخارجي - شيء يمكننا القول إن وزنه كذا وكذا",
 "ponderer": "متأمل, مستغرق في التفكير (مفكر تأملي يتسم بالتفكر الهادئ)",
 "pondering": "تَأَمُّلِيّ, مُتَدَبِّر (مُسْتَغْرِقٌ فِي تَفْكِيرٍ عَمِيقٍ وَجِدِّيّ)",
 "ponderosa": "صنوبر أصفر غربي, صنوبر بونديروسا (صنوبر خشب طويل شائع وواسع الانتشار في غرب أمريكا الشمالية له إبر خضراء داكنة في حزم من 2 إلى 5 ولحاء سميك بصفائح بنية داكنة عند النضج)",
 "ponderosa pine": "صنوبر أصفر غربي, صنوبر بونديروسا (صنوبر خشب طويل شائع وواسع الانتشار في غرب أمريكا الشمالية له إبر خضراء داكنة في حزم من 2 إلى 5 ولحاء سميك بصفائح بنية داكنة عند النضج)",
 "ponderosity": "ثقل, جسامة (خاصية كون الشيء كبيراً في الكتلة)",
 "ponderous": "ثقيل",
 "ponderously": "بتثاقل, بثقل (بطريقة ثقيلة ومتثاقلة) / برتابة, بملل ثقيل (بطريقة مملة وثقيلة)\nمثال: يتحرك بتثاقل",
 "ponderousness": "ثقل, جسامة (خاصية كون الشيء كبيراً في الكتلة) / تَكَلُّف, ثِقَل (صفة ثقيلة ومجهدة وجادة تفتقر إلى الرشاقة أو السلاسة)\nمثال: كتاب جاد لدرجة التكلف",
 "pondweed": "بواق, جار النهر",
 "pone": "كورن بون (خبز ذرة يصنع غالباً بدون حليب أو بيض ويخبز أو يقلى)",
 "pong": "رائحة كريهة, رائحة نفاذة (رائحة غير مستحبة)",
 "pongamia glabra": "بونجاميا, زان هندي (شجرة آسيوية دائمة الخضرة لها أوراق ريشية لامعة وزهور عنقودية بيضاء كريمية عطرة؛ تستخدم كشجرة ظل)",
 "pongee": "بونجي (قماش رقيق ناعم منسوج من الحرير الخام (أو تقليد له))",
 "pongid": "قرد عظيم (أي من القردة العليا الكبيرة من فصيلة البونجيد)",
 "pongo pygmaeus": "أورانغوتان, إنسان الغاب (قرد كبير طويل الذراعين يعيش في بورنيو وسومطرة وله عادات شجرية)",
 "poniard": "خنجر رفيع (خنجر ذو نصل نحيف)",
 "ponka": "لغة بونكا (لهجة دهيجيا التي يتحدث بها شعب بونكا) / بونكا (فرد من الشعب السيوي في وادي نهر ميسوري في شمال شرق نبراسكا)",
 "pons": "جسر (شَجُعَ، جرُؤ؛ أقدم على الخطر واجترأ)\nمثال: اذهب إلى الجسر.",
 "pons asinorum": "اخْتِبَار صَعْب, قَنْطَرَة الْحِمَار (مشكلة تختبر بشدة قدرة الشخص عديم الخبرة)",
 "pons varolii": "جسر, قنطرة فارول (حزمة من الألياف العصبية تربط النخاع المستطيل والمخيخ بالدماغ المتوسط)",
 "ponstel": "بونستيل, حمض الميفيناميك (دواء مضاد للالتهاب ومسكن غير ستيرويدي (الاسم التجاري بونستيل) يستخدم لعلاج الألم الخفيف (خاصة تقلصات الدورة الشهرية))",
 "pontederia cordata": "بونتيديريا, عشبة البيكريل (نبات أمريكي له سنابل من الزهور الزرقاء وينمو في المياه الضحلة للجداول والبرك)",
 "pontifex": "حبر, كاهن روماني (عضو في أعلى مجلس للكهنة في روما القديمة)",
 "pontiff": "بابا, حبر أعظم (رئيس الكنيسة الكاثوليكية الرومانية)",
 "pontifical": "طَنَّان, مُتَنَطِّع (متورّم بالغرور والتباهي الفارغ) / أسقفي, بابوي (يشير إلى أو يحكم بواسطة أو يتعلق بأسقف أو أساقفة) / بابوي, رسولي (صادر عن البابا أو بأمر منه أو خاضع له، أو للبابوية بصفتها خليفة الرسل) / ملابس حبرية (الملابس والشارات الأخرى للحبر (خاصة الأسقف))\nمثال: إعفاء بابوي",
 "pontificate": "البابوية (حكومة الكنيسة الرومانية الكاثوليكية)",
 "pontius pilate": "بيلاطس, بيلاطس البنطي (الوالي الروماني على اليهودية الذي أمر بصلب المسيح (توفي عام 36 م))",
 "pontoon": "طوافة (عوامة تدعم طائرة مائية) / طوافة, عائمة ((بحري) هيكل عائم (كقارب مسطح القاع) يعمل كرصيف أو لدعم جسر)",
 "pontoon bridge": "جِسْر عَائِم (شَجُعَ، جرُؤ؛ أقدم على الخطر واجترأ)\nمثال: اذهب إلى الجسر.",
 "pontoon plane": "طائرة طافية, طائرة عائمة (طائرة مائية مجهزة بعوامات للهبوط أو الإقلاع من الماء)",
 "pontos": "بونتوس ((الأساطير اليونانية) تجسيد قديم للبحر؛ والد نيريوس)",
 "pontus": "بونتوس",
 "pony": "فَرَس قَزَم (أقوام تسكن شرق العِرَاق، يقال أنهم أقوام آرِيَّة)\nمثال: الفرس هي أنثى الحصان",
 "pony cart": "عربة بوني, عربة حمير (عربة بمحور سفلي ومقعدين)",
 "pony express": "بوني إكسبريس (بريد سريع يُنقل عن طريق تناوب الفرسان على ظهور الخيل؛ خاصة بين ميسوري وكاليفورنيا حوالي عام 1860)",
 "pony-trekking": "تجوال بالمهور (رياضة يركب فيها الناس عبر الريف على المهور)",
 "ponycart": "عربة بوني, عربة حمير (عربة بمحور سفلي ومقعدين)",
 "ponytail": "ذَيْل الْحِصَان (ذَيَّلَ (ذيله): جعل له ذيلا؛ (ذَيَّلَ) أطال ذيله وطوله. ويقال ذيل كتابه أو كلامه: أردفه بكلام كالتتمة له)\nمثال: للبقرة ذيل طويل.",
 "pooch": "كلب (مصطلحات غير رسمية للكلاب)",
 "pood": "بود (وحدة وزن روسية تساوي حوالي 36 رطلاً)",
 "poodle": "كَانِيش",
 "poodle dog": "بودل, كلب البودل (كلب ذكي ذو معطف ثقيل مجعد بلون واحد يتم قصه عادة؛ سلالة قديمة تدرب أحياناً ككلاب رياضية أو كلاب استعراض)",
 "pooecetes gramineus": "عصفور المساء (عصفور شائع في أمريكا الشمالية يشتهر بغنائه المسائي)",
 "poof": "شاذ (مصطلح مهين لرجل مثلي الجنس)",
 "pooh-bah": "شخصية مغرورة (شخص متعجرف أو مغرور ذو أهمية)",
 "pool": "بِرْكَة (مُسْتَنْقَع الماء أو أو بُحِيْرَة صغيرة؛ حوض الماء المصنوع لتزيين الحدائق وريها)\nمثال: البركة عميقة جدا.",
 "pool ball": "كرة بلياردو (كرة تستخدم في لعب البلياردو)",
 "pool cue": "عصا البلياردو (أداة رياضية تتكون من قضيب مستدق الطرف يستخدم لضرب كرة البلياردو)",
 "pool player": "لاعب بلياردو",
 "pool stick": "عصا البلياردو (أداة رياضية تتكون من قضيب مستدق الطرف يستخدم لضرب كرة البلياردو)",
 "pool table": "طاولة بلياردو (معدات ألعاب تتكون من طاولة ثقيلة تلعب عليها البلياردو)",
 "pooler": "مُساهِم فِي صُنْدُوق مُشْتَرَك (شخص يشارك ويساهم في صندوق عام ليستخدمه الجميع)",
 "pooling of interest": "تجميع المصالح (طريقة محاسبية تستخدم في دمج الشركات؛ يتم إضافة الميزانيات العمومية معاً بنداً ببند؛ هذه الطريقة معفاة من الضرائب)",
 "poolroom": "غرفة البلياردو (غرفة بها طاولات بلياردو حيث تُلعب البلياردو)",
 "poon": "بون (أي من أشجار شرق الهند المتعددة من جنس كالوفيلوم ذات أوراق جلدية لامعة وخشب صلب خفيف الوزن) / خشب البون (خشب أي شجرة بون؛ يستخدم للصواري والدعامات)",
 "poop": "بَرَّزَ, تَغَوَّطَ (خَرَجَ؛ نَبُه بعد خُمول) / بُرَاز, كَاكَا",
 "poop deck": "سطح الكوثل (سطح مكشوف جزئي على البنية الفوقية لمؤخرة السفينة)",
 "poor": "فَقِير / مِسْكِين / فُقَرَاء",
 "poor box": "صندوق الصدقات (صندوق لجمع الصدقات، خاصة الموجود في الكنيسة)",
 "poor boy": "سابمارين, سندويتش غواصة (شطيرة كبيرة مصنوعة من لفافة خبز طويلة مقسومة طولياً ومحشوة باللحوم والجبن (والطماطم والبصل والخس والتوابل))",
 "poor devil": "بائِس, مِسْكِين (شخص تشعر بالأسف تجاهه)",
 "poor fish": "أحمق, بليد (شخص ليس ذكياً جداً)\nمثال: إنه الاقتصاد يا غبي!",
 "poor law": "قانون الفقراء (قانون يوفر الدعم للفقراء)",
 "poor man's orchid": "أوركيد الفقراء, زهرة الفراشة (أي نبات من جنس شيزانثوس ذو أوراق مقسمة بدقة وزهور مبهرجة متنوعة الألوان)",
 "poor man's pulse": "حمص الحصان, ماكروتيولما (حَمَصَ الجُرْحُ: سَكَنَ وَرَمُه؛ حَمَصَ القَذَاةَ: أَخْرَجَها مِنْ عَيْنِه بِرِفْقٍ)\nمثال: الحمص مكون أساسي في طبق الفلافل.",
 "poor man's weatherglass": "أناغالس حقلي, زهرة الطقس (عشبة ذات أزهار قرمزية أو بيضاء أو أرجوانية تغلق عند اقتراب الطقس الممطر)",
 "poor people": "فقراء (الناس الذين ليس لديهم ممتلكات أو ثروة (يُعتبرون كمجموعة))\nمثال: فقراء الحضر بحاجة للمساعدة",
 "poor person": "فَقِير, مُعْدَم (شخص لديه القليل من الممتلكات أو لا يملك شيئاً)",
 "poor rates": "ضريبة الفقراء (ضريبة محلية لإغاثة الفقراء)",
 "poor relation": "قريب فقير, نسخة أقل جودة (شخص أو شيء يعتبر أقل شأناً من آخر أو آخرين)",
 "poor speller": "متهجئ (شخص يتهجى الكلمات)",
 "poor white trash": "حُثالَة البِيض ((عامية) مصطلح مهين للبيض الفقراء)",
 "poor-spirited": "خَوَّار العَزِيمَة, ضَعِيف النَّفْس (يَفْتَقِر إِلَى الشَّجَاعَة والحَزْم والعَزِيمَة؛ جَبَان بِصُورَة مُحْتَقَرَة)",
 "poorhouse": "ملجأ الفقراء (مؤسسة تدار على نفقة الدولة لتوفير السكن للفقراء والمشردين)",
 "poorly": "بشكل سيء, على نحو رديء (بطريقة فقيرة أو غير لائقة أو غير مرضية؛ ليس جيداً)\nمثال: كان مستعداً بشكل سيء",
 "poorness": "رداءة, سوء (جودة كون الشيء مصنوعاً أو محافظاً عليه بشكل سيء) / شح, ضآلة (صفة كون الشيء هزيلاً أو ضئيلاً) / رَدَاءَة, فَقْر (أقل من الكفاية) / عوز, فقر (حالة امتلاك القليل من المال أو عدم امتلاكه وقلة الممتلكات المادية)\nمثال: لم يكن من الممكن التعرف عليها بسبب رداءة التصوير",
 "poorwill": "طائر المسكين (سبد من غرب أمريكا الشمالية)",
 "poove": "شاذ (مصطلح مهين لرجل مثلي الجنس)",
 "pop": "بُوب, مُوسِيقَى شَعْبِيَّة",
 "pop art": "بوب آرت, فن البوب (مدرسة فنية ظهرت في المملكة المتحدة في الخمسينيات وأصبحت سائدة في الولايات المتحدة والمملكة المتحدة في الستينيات؛ قلدت تقنيات الفن التجاري (مثل علب…)",
 "pop bottle": "زجاجة مشروب غازي (زجاجة لحفظ المشروبات الغازية)",
 "pop fly": "كرة عالية قصيرة (كرة طائرة عالية وقصيرة المدى)",
 "pop group": "مَجْمُوعَة بُوب (مؤنث مَجْمُوع وهو اسم مفعول من جَمَعَ؛ الطَائِفَة أو الجَمَاعَة من الناس)\nمثال: شكرا لإضافتي للمجموعة.",
 "pop music": "مُوسِيقَى الْبُوب, مُوسِيقَى شَعْبِيَّة (مُوسِيقى، فنُّ تأليف الألحان وتوزيعها وإيقاعها والغناء والتطريب بضروب المعازف؛ علم الموسيقى : علمٌ يُبحَثُ فيه عن أُصَول النغم من حيث تأَتلف أَو تتنافر، وأَحوال الأَزمنة المتخللة بينها، ليُعلَمَ كيف يؤلَّف اللَّحْن)\nمثال: أتعلم الموسيقى.",
 "pop out": "برز, ظهر فجأة (ظهر أو حدث بشكل مفاجئ أو غير متوقع)\nمثال: ظهرت المزرعة فجأة عندما انعطفنا",
 "pop quiz": "رَائِز, اِمْتِحَان مُفَاجِئ",
 "pop tent": "خيمة سريعة النصب (خيمة صغيرة سهلة الحمل وسريعة الإعداد)",
 "pop-fly": "كرة عالية قصيرة (كرة طائرة عالية وقصيرة المدى)",
 "pop-up": "كرة عالية قصيرة (كرة طائرة عالية وقصيرة المدى) / كتاب مجسم, كتاب منبثق (كتاب (عادة للأطفال) يحتوي على صفحة أو أكثر بحيث يرتفع هيكل ثلاثي الأبعاد عند فتح الصفحة) / متجر مؤقت (متجر يفتح لفترة زمنية محدودة في مقر مؤقت)",
 "pop-up book": "كتاب مجسم, كتاب منبثق (كتاب (عادة للأطفال) يحتوي على صفحة أو أكثر بحيث يرتفع هيكل ثلاثي الأبعاد عند فتح الصفحة)",
 "pop-up menu": "قَائِمَة مُنْبَثِقَة",
 "pop-up toaster": "محمصة آلية, محمصة خبز نابضة (محمصة يتم إدخال شرائح الخبز فيها عمودياً في فتحات وتقفز لأعلى بعد اكتمال دورة التحميص)\nمثال: محمصة الخبز النابضة الخاصة بي سيئة، فهي دائماً ما تلقي الخبز المحمص على الأرض",
 "popcorn": "فِشَار / فُشَار",
 "popcorn ball": "كرة الفشار (فشار ممزوج بشراب السكر الكثيف أو الدبس أو الكراميل ومشكل على هيئة كرات)",
 "pope": "بَابَا / حَبْر أَعْظَم ((حَبَرَه): سَرَّه ونَعَّمَه؛ (حَبَرَ) الْبُرْدَ: وَشّاه وزَيَّنَه) / حَبْر ((حَبَرَه): سَرَّه ونَعَّمَه؛ (حَبَرَ) الْبُرْدَ: وَشّاه وزَيَّنَه) / الْبَابَا, الْأَب\nمثال: لا تكتب بالحبر.",
 "pope's nose": "ذيل الطائر (ذيل الطائر المجهز للأكل)",
 "popery": "بابوية (مصطلحات مسيئة لممارسات وطقوس الكنيسة الرومانية الكاثوليكية)",
 "popeye": "بَابَاي, بَبَّاي",
 "popeyed": "جَاحِظ العَيْنَيْن (ذو عينين بارزتين ناتئتين) / جَاحِظ العَيْنَيْن, فَاغِر الفَم (مفتوح العينين أو الفم من شدة الدهشة)",
 "popgun": "مسدس الفلين, مسدس لعبة (لعبة تتكون من مسدس لعبة يصدر صوت فرقعة)",
 "popillia japonica": "خنفساء يابانية (خنفساء صغيرة خضراء وبنية معدنية موطنها شرق آسيا؛ آفة نباتية خطيرة في أمريكا الشمالية)",
 "popinjay": "سَطْحِيّ, سَطْحِيَّة",
 "popish": "روماني, كاثوليكي روماني (متعلق بالكنيسة الرومانية الكاثوليكية أو مؤيد لها)\nمثال: الكنيسة الرومانية الكاثوليكية",
 "popishly": "بأسلوب كاثوليكي, ببابوية (مثل البابا؛ بطريقة كاثوليكية)",
 "poplar": "حَوْر (حَوَّرَ (الدقيقَ أو الثوبَ): بيَّضَه؛ حَوَّرَ (الأديمَ): صبغه بحُمرة)",
 "poplar tree": "حور, شجرة الحور (أي من الأشجار العديدة في المناطق المعتدلة الشمالية ذات الخشب الخفيف اللين والزهور المحمولة في نورات هرية)",
 "poplin": "بوبلين (قماش مضلع يستخدم في الملابس والتنجيد)",
 "popliteal": "مأبضي (مكون من أو متعلق بالمنطقة خلف مفصل الركبة)",
 "popliteal artery": "شريان مأبضي (استمرار للشريان الفخذي يتفرع لتغذية الساقين والقدمين)",
 "popliteal vein": "وريد مأبضي (وريد ينشأ في الركبة ويصعد ليصبح الوريد الفخذي)",
 "popover": "بوب أوفر (مافن خفيف أجوف مصنوع من عجين منتفخ ويخبز في كوب مافن عميق)",
 "popper": "آلة فشار, وعاء فشار (وعاء لطهي الفشار) / بوبر (حاوية لعقار منشط (نترات الأميل أو نتريت البوتيل)) / كارل بوبر (فيلسوف بريطاني (ولد في النمسا) جادل بأن النظريات العلمية لا يمكن أبداً إثبات صحتها، ولكن يتم اختبارها بمحاولات دحضها (1902-1994))",
 "poppet": "صمام قفاز (صمام على شكل فطر يرتفع عمودياً من مقعده؛ يستخدم عادة في محركات الاحتراق الداخلي)",
 "poppet valve": "صمام قفاز (صمام على شكل فطر يرتفع عمودياً من مقعده؛ يستخدم عادة في محركات الاحتراق الداخلي)",
 "poppin": "صَاخِب, مُفْعَمٌ بِالحَيَوِيَّةِ ((غير رسمي) لِحَدَثٍ قَائِمٍ وَمَلِيءٍ بِالنَّشَاطِ)",
 "popping": "فرقعة (صوت انفجاري حاد كما هو الحال عند إطلاق النار أو سحب الفلين)",
 "poppy": "خشخاش",
 "poppy day": "يوم الخشخاش, يوم الذكرى (الأحد الأقرب إلى 11 نوفمبر عندما يتم إحياء ذكرى أولئك الذين ماتوا في الحرب العالمية الأولى والحرب العالمية الثانية)",
 "poppy mallow": "خبازة الخشخاش (نبات من جنس كاليرهوي بأوراق كفية مشقوقة وزهور بيضاء إلى حمراء أو أرجوانية تظهر طوال الصيف)",
 "poppy seed": "خشخاش بَذْرَة",
 "poppycock": "كَلَام فَارِغ, هُرَاء (حديث لا معنى له)\nمثال: لا تعطيني هذا الهراء",
 "popsicle": "دُنْدُرْمَة",
 "populace": "جُمْهُور, جَمَاهِير",
 "popular": "مَحْبُوب",
 "popular front": "جبهة شعبية (تحالف يساري منظم ضد خصم مشترك)",
 "popular music": "مُوسِيقَى الْبُوب, بُوب (مُوسِيقى، فنُّ تأليف الألحان وتوزيعها وإيقاعها والغناء والتطريب بضروب المعازف؛ علم الموسيقى : علمٌ يُبحَثُ فيه عن أُصَول النغم من حيث تأَتلف أَو تتنافر، وأَحوال الأَزمنة المتخللة بينها، ليُعلَمَ كيف يؤلَّف اللَّحْن)\nمثال: أتعلم الموسيقى.",
 "popular music genre": "موسيقى رائجة, موسيقى شعبية (أي نوع من الموسيقى له جاذبية واسعة (ولكن عادة لفترة قصيرة فقط))",
 "popular opinion": "رأي عام, صوت الشعب (معتقد أو شعور يشاركه معظم الناس)\nمثال: طلب إجراء استطلاع للرأي العام",
 "popularisation": "ابتذال, تعميم (فعل جعل الشيء جذاباً للجمهور العام) / تبسيط, تعميم (تفسير يسهل فهمه وقبوله)",
 "populariser": "مقرِّب للعامة, مُبَسِّط (شخص يجعل شيئًا ما جذابًا للجمهور العام)",
 "popularism": "شعبوية موسيقية (موسيقى مكيفة لتناسب فهم وذوق الأغلبية)",
 "popularity": "شَعْبِيَّة",
 "popularity contest": "مُسَابَقَة شَعْبِيَّة (منافسة (حقيقية أو مجازية) للحصول على الدعم الشعبي)",
 "popularization": "ابتذال, تعميم (فعل جعل الشيء جذاباً للجمهور العام) / تبسيط, تعميم (تفسير يسهل فهمه وقبوله)",
 "popularizer": "مقرِّب للعامة, مُبَسِّط (شخص يجعل شيئًا ما جذابًا للجمهور العام)",
 "popularly": "شعبياً (بين الناس)\nمثال: نوقش هذا الموضوع شعبياً",
 "populated": "آهِل, مَسْكُون (فيه سكان يقيمون فيه)",
 "populated area": "منطقة حضرية, منطقة مأهولة (منطقة جغرافية تشكّل مدينة أو بلدة)",
 "population": "سُكَّان / سُكَّانِيَّة",
 "population commission": "لجنة السكان (لجنة المجلس الاقتصادي والاجتماعي للأمم المتحدة المعنية بالتحكم في السكان)",
 "population control": "تحديد النسل, ضبط السكان (السيطرة على نمو السكان؛ برنامج حكومي)",
 "population density": "كَثَافَة سُكَّانِيَّة (مصدر لكَثَفَ؛ اللغلظ والثخانة)\nمثال: هذه منطقة من الغابة أقل كثافة",
 "population growth": "نمو سكاني (زيادة في عدد الأشخاص الذين يسكنون منطقة أو دولة)",
 "population profile": "هرم سكاني (مخطط يوضح عدد الأشخاص كدالة لأعمارهم)",
 "population pyramid": "هَرَم سُكَّانِيّ ((في الهندسة) منشور كثير السطوح، قاعدته مضلع، وأوجهه الأخرى مثلثات، قواعدها أضلاع مضلع القاعدة، ورؤوسها مجتمعة في نقطة واحدة خارجة عنه؛ بناء أثري بناه الفراعنة في مصر بالحجارة الصلبة، ذو قاعدة مربعة، له أربع واجهات، وكل واجهة مثلثة الشكل، تلتقي رؤوسها فتكون رأسًا واحدًا هو قمة الهرم)",
 "population scientist": "ديموغرافي, عالم سكان (عالم يدرس نمو وكثافة السكان وإحصاءاتهم الحيوية)",
 "population shift": "تحول سكاني (تغير في الأعداد النسبية لمجموعات الأفراد المختلفة التي تشكل السكان)",
 "populism": "شَعْبَوِيَّة",
 "populist": "شَعْبَوِيّ, شَعْبَوِيَّة",
 "populist party": "الحزب الشعبوي, حزب الشعب (حزب سياسي سابق في الولايات المتحدة؛ تشكل عام 1891 للدعوة إلى التوسع في العملة وسيطرة الدولة على السكك الحديدية)",
 "populous": "آهِلٌ بِالسُّكَّان, كَثِيفُ السُّكَّان (ذو كثافة سكانية عالية)",
 "populus alba": "حور أبيض (حور يزرع على نطاق واسع في الولايات المتحدة؛ له لحاء أبيض وأوراق ذات أسطح سفلية بيضاء)",
 "populus balsamifera": "حور بلسمي (حور من شمال شرق أمريكا الشمالية بأوراق عريضة على شكل قلب)",
 "populus canescens": "حور رمادي (حور كبير سريع النمو بأوراق مسننة مفصصة بشكل خافت رمادية على السطح السفلي؛ موطنه أوروبا ولكنه أدخل وتوطن في أماكن أخرى)",
 "populus deltoides": "خشب القطن الشرقي (حور شائع في شرق ووسط الولايات المتحدة؛ يزرع في الولايات المتحدة لنموه السريع وأوراقه الغزيرة وفي أوروبا للخشب)",
 "populus grandidentata": "حور كبير الأسنان, حور كندي (حور بتاج ضيق؛ شرق أمريكا الشمالية)",
 "populus heterophylla": "خشب القطن المستنقعي (حور من أمريكا الشمالية بأوراق كبيرة مستديرة صدفيّة ولحاء وخشب بني)",
 "populus nigra": "حور أسود (حور أوروبي كبير)",
 "populus nigra italica": "حور لومباردي (يتميز بشكله العمودي المتسامي وفروعه المنتصبة)",
 "populus tremula": "حور أوروبي, حور راجف (حور من العالم القديم بتاج عريض كثير التفرع؛ شمال غرب أوروبا وسيبيريا إلى شمال أفريقيا)",
 "populus tremuloides": "حور راجف أمريكي (حور نحيل موطنه أمريكا الشمالية)",
 "populus trichocarpa": "خشب القطن الأسود (خشب قطن من غرب أمريكا الشمالية بأوراق خضراء داكنة لامعة من الأعلى وصدئة أو فضية من الأسفل)",
 "porbeagle": "لِيَّاءٌ",
 "porc": "لحم خنزير (لحم مأخوذ من خنزير داجن)",
 "porcelain": "خَزَف (خَزَفَ في مَشْيه يَخْزِفُ خَزْفًا: رفع يدَه ووَضعها؛ خَزَفَ الثوبَ: خَرَقه وشقَّه)",
 "porcelain clay": "طين صيني, كاولين (طين ناعم عادة ما يكون أبيض ناتج عن تجوية المعادن الألومينية (مثل الفلسبار)؛ يستخدم في السيراميك وكمادة ماصة وكمادة مالئة (على سبيل المثال، في الورق))",
 "porch": "رِوَاق, رُوَاق (مَمَرّ خارج المَبْنَى وملاصق له يمتد عليه السَقْف ويُصفّ على الجانب الآخر الأعمدة؛ في العصر الحديث يُطلق على الممر عامة)\nمثال: ذهب إلى الرواق.",
 "porcine": "خِنْزِيرِيّ",
 "porcupine": "نَيْص, دُلْدُل",
 "porcupine ball": "كرات اللحم بالأرز (أقراص لحم ملفوفة في الأرز ومطهية ببطء في صلصة الطماطم)",
 "porcupine fish": "سمكة النيص (تنتصب أشواكها عندما ينتفخ الجسم؛ توجد عالمياً في المياه الدافئة)",
 "porcupine provision": "إجراء طارد للاستحواذ, طارد القروش (إجراء تتخذه شركة لإحباط محاولات الاستحواذ غير المرغوب فيها)",
 "porcupinefish": "سمكة النيص (تنتصب أشواكها عندما ينتفخ الجسم؛ توجد عالمياً في المياه الدافئة)",
 "porcupines": "كرات اللحم بالأرز (أقراص لحم ملفوفة في الأرز ومطهية ببطء في صلصة الطماطم)",
 "pore": "مَسَمّ",
 "pore clogging ingredient": "مكوّن ساد للمسام (مكون يوجد في بعض مستحضرات التجميل يسد المسام)\nمثال: تتحدد فعالية المكونات السادة للمسام بنوع البشرة",
 "pore fungus": "بوليبور, فطر متعدد المسام (فطريات مسامية خشبية؛ أي فطر من فصيلة بوليبوراسيا أو فصيلة بوليتاسيا يكون سطحه الحامل للأبواغ داخل أنابيب أو مسام؛ الأجسام الثمرية عادة ما تكون خشبية…)",
 "pore mushroom": "بوليبور, فطر متعدد المسام (فطريات مسامية خشبية؛ أي فطر من فصيلة بوليبوراسيا أو فصيلة بوليتاسيا يكون سطحه الحامل للأبواغ داخل أنابيب أو مسام؛ الأجسام الثمرية عادة ما تكون خشبية…)",
 "porgy": "بورجي (سمكة غذائية ورياضية مهمة عميقة الجسم تعيش في المياه الساحلية الدافئة والاستوائية؛ توجد في جميع أنحاء العالم) / أبراميس, سمك المرجان (لحم قليل الدهن لسمكة توجد في المياه الدافئة للساحل الجنوبي للمحيط الأطلسي للولايات المتحدة)",
 "poriferan": "إسفنج, إسفنجيات (حيوان بحري بدائي متعدد الخلايا يدعم جسمه المسامي هيكل ليفي؛ يوجد عادة في مستعمرات لاطئة)",
