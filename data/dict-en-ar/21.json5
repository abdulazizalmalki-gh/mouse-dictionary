 "plague spot": "بقعة الطاعون (بقعة على الجلد مميزة لمرض الطاعون)",
 "plaguey": "مُزْعِج, مُضَايِق (يسبب الانزعاج أو الضيق) / بشكل بغيض, بشكل مزعج (بطريقة خبيثة أو مزعجة) / مُعْدٍ, وَبِيء (مِنَ المُرَجَّح أَن يَنْتَشِر وَيُسَبِّب وَباءً)\nمثال: الجو بارد بشكل مزعج!",
 "plaguily": "بشكل بغيض, بشكل مزعج (بطريقة خبيثة أو مزعجة)\nمثال: الجو بارد بشكل مزعج!",
 "plaguy": "مُزْعِج, مُضَايِق (يسبب الانزعاج أو الضيق) / بشكل بغيض, بشكل مزعج (بطريقة خبيثة أو مزعجة)\nمثال: الجو بارد بشكل مزعج!",
 "plaice": "بليس, سمك موسى (سمكة طعام أوروبية كبيرة) / سمك البليس (لحم سمكة مفلطحة أوروبية كبيرة)",
 "plaid": "ترتان, قماش كاروهات (قماش ذو تصميم متقاطع)",
 "plain": "بَسِيط / سَهْل (ضد الصَعْب، اليَسِير. لا جمع له؛ الشيء المُمَهَّد اللَيِّن. لا جمع له)\nمثال: هذا الشعور سهل.",
 "plain clothes": "زي مدني, ملابس مدنية (الملابس العادية تمييزاً لها عن الزي الرسمي أو ملابس العمل أو الزي الديني)",
 "plain clothes detective": "مُحَقِّق بِمَلابِس مَدَنِيَّة, مُخْبِر سِرِّيّ (محقق يرتدي ملابس مدنية أثناء الخدمة)",
 "plain flour": "دقيق عادي (دقيق لا يحتوي على عامل تخمير)",
 "plain paper": "وَرَق عَادِيّ (ما ينمو على النبات من الأعلى والجوانب بشكل صفائح ذات لون أخضر أو مائل إلى الخضرة. انظر الصورة؛ جلود رقاق يُكتَبُ عليها)\nمثال: هات ورقة بيضاء.",
 "plain sailing": "تقدم سهل, طريق ممهد (تقدم سهل غير معاق)\nمثال: بعد أن قمنا بحل تلك المشكلة، كان الباقي سهلاً وممهداً",
 "plain stitch": "غرزة عدلة (غرزة حياكة أساسية مصنوعة بوضع الإبرة عبر الجزء الأمامي من الغرزة من الجانب الأيسر)",
 "plain turkey": "حبارى أسترالية (طائر صيد أسترالي شهير)",
 "plain wanderer": "جوال السهول (طائر أسترالي صغير قريب من سمان الشجر؛ يصنف كطائر خوض ولكنه يسكن السهول)",
 "plain weave": "نسيج سادة (نمط أساسي للنسيج تتشابك فيه خيوط اللحمة والسدى بالتناوب لإنتاج تأثير رقعة الشطرنج)",
 "plain-woven": "مَنْسُوجٌ نَسْجًا سَادَةً ((لِلْقُمَاشِ) مَصْنُوعٌ بِالنَّسْجِ السَّادَةِ)",
 "plainchant": "ترتيل كنسي, غناء بسيط ((الكنيسة الكاثوليكية) ترتيل طقسي يتكون من خط لحني واحد غير مصحوب بآلات)",
 "plainclothesman": "شرطي سري, مخبر بملابس مدنية (محقق ذكر يرتدي ملابس مدنية أثناء الخدمة)",
 "plainclotheswoman": "شرطية سرية, مخبرة بملابس مدنية (محقة أنثى ترتدي ملابس مدنية أثناء الخدمة)",
 "plainly": "ببساطة, بتواضع (بطريقة بسيطة؛ دون إسراف أو زخرفة) / بوضوح, جلياً (بشكل لا لبس فيه)\nمثال: كانت ترتدي ملابس بسيطة",
 "plainness": "بساطة المظهر, تواضع الجمال (مظهر ليس جذاباً أو جميلاً) / بساطة (مظهر كونه بسيطاً وغير متكلف) / بَيَان, جَلَاء (الوضوح كنتيجة لكون الشيء بيناً) / بساطة, خلوص (حالة عدم الاختلاط بمواد أخرى)\nمثال: الملابس الفاخرة لم تستطع إخفاء تواضع جمال الفتاة",
 "plains indian": "هندي السهول (فرد من إحدى قبائل الهنود الأمريكيين الذين عاشوا حياة بدوية يتبعون الجاموس في السهول الكبرى لأمريكا الشمالية)",
 "plains inhabitant": "ساكن السهول (أحد سكان منطقة سهول (خاصة السهول الكبرى في أمريكا الشمالية))",
 "plains lemon monarda": "مونردة السهول الليمونية (نبات حولي من جنوب الولايات المتحدة)",
 "plains pocket gopher": "غوفر جيبي للسهول (غوفر يعيش بشكل رئيسي في الأراضي العشبية بوسط أمريكا الشمالية)",
 "plains pocket mouse": "فأر جيبي للسهول (قارض صغير يعيش في المناطق المفتوحة لولايات السهول الأمريكية)",
 "plains spadefoot": "علجوم قدم المجرفة السهلي (يعيش هذا العلجوم ذو قدم المجرفة في السهول والتلال وقيعان الأنهار في المناطق قليلة الأمطار شرق جبال روكي)",
 "plainsman": "ساكن السهول (ساكن ذكر في منطقة سهلية (خاصة السهول الكبرى في أمريكا الشمالية))",
 "plainsong": "ترتيل كنسي, غناء بسيط ((الكنيسة الكاثوليكية) ترتيل طقسي يتكون من خط لحني واحد غير مصحوب بآلات)",
 "plainspoken": "صَرِيح, فَصِيح (يَتَّسِم بِالمُبَاشَرَة فِي الأُسْلُوب أَوِ الكَلَام؛ بِدُون مُوَارَبَة أَوْ تَهَرُّب) / صَرِيح, مُبَاشِرُ الكَلَام (يستخدم لغة بسيطة ومباشرة)",
 "plainswoman": "ساكنة السهول (ساكنة أنثى في منطقة سهلية (خاصة السهول الكبرى في أمريكا الشمالية))",
 "plaint": "رثاء, عويل (صرخة حزن وأسى) / عريضة دعوى, لائحة شكوى ((المملكة المتحدة) بيان مكتوب بأسباب الشكوى يقدم إلى محكمة قانونية لطلب رفع الظلم)\nمثال: يمكن سماع نواحهم المثير للشفقة في جميع أنحاء الجناح",
 "plaintiff": "مُدَّعٍ, الْمُدَّعِي",
 "plaintiff in error": "طاعن, مستأنف (الطرف الذي يستأنف قرار محكمة أدنى)",
 "plaintive": "حَزِين, شَجِيّ (يعبّر عن الحزن والأسى)",
 "plaintively": "بأسى, بحزن (بطريقة حزينة وشاكية)\nمثال: رنّت النغمة الأخيرة للأغنية بحزن",
 "plaintiveness": "شجا (التعبير عن الحزن)",
 "plait": "طية, كسرة (أي نوع من الطيات يتشكل عن طريق ثني القماش على نفسه ثم ضغطه أو خياطته) / جَدِيلَة, ضَفِيرَة (تسريحة شعر تتشكل بجدل أو لف الشعر)",
 "plaiter": "ضافر, مجدل (شخص يقوم بجدل أو ضفر (الشعر أو القماش وما إلى ذلك))",
 "plan": "خِطَّة, خُطَّة / خَطَّطَ (وضع خطة مُحكَمة لتحقيق هدف معين؛ رسم خطوط أو تقسيم مساحة بخطوط) / نَوَى, بلاني\nمثال: خطط زيري لهجومه.",
 "plan of action": "خطة عمل (خطة للقيام بشيء ما بنشاط)",
 "plan of attack": "أسلوب معالجة, خطة عمل (أفكار أو إجراءات تهدف إلى التعامل مع مشكلة أو موقف)\nمثال: نهجه تجاه كل مشكلة هو إعداد قائمة بالإيجابيات والسلبيات",
 "planar": "ثنائي الأبعاد, مستوٍ (ينطوي على أو له بعدان)",
 "planaria": "بلاناريا, مستورقات (ديدان مفلطحة حرة السباحة تعيش غالباً في المياه العذبة؛ شائعة في الدراسات المختبرية لقدرتها على تجديد الأجزاء المفقودة)",
 "planarian": "بلاناريا, مستورقات (ديدان مفلطحة حرة السباحة تعيش غالباً في المياه العذبة؛ شائعة في الدراسات المختبرية لقدرتها على تجديد الأجزاء المفقودة)",
 "planate": "مُفَلْطَح (تم تسطيحه أو تفليطحه)",
 "planation": "تسوية (عملية التعرية التي يتم بموجبها إنتاج سطح مستوٍ)",
 "planchet": "قرص العملة الخام (قرص معدني مسطح جاهز للختم كعملة معدنية)",
 "planchette": "مؤشر ويجا (لوح مثلثي مدعوم بعجلات؛ عند لمسه بخفة بأطراف الأصابع يفترض أن يتهجى رسائل خارقة للطبيعة (أو لا واعية))",
 "planck": "بْلَانْك",
 "planck's constant": "ثَابِت بُلَانْك (اسم فاعل من ثَبَتَ؛ المُسْتَقِرّ الذي لا يتحرك، ضد المُتَحَرِّك)\nمثال: الشاحنة غير ثابتة.",
 "planck's law": "قانون بلانك ((فيزياء) أساس نظرية الكم؛ طاقة الموجات الكهرومغناطيسية موجودة في كمات غير قابلة للتجزئة يجب أن تشع أو تمتص ككل)",
 "planck's radiation law": "قانون إشعاع بلانك ((فيزياء) معادلة تعبر عن توزيع الطاقة في الطيف المشع لجسم أسود مثالي)",
 "plane": "مِسْحَاج, مِنْجَرَة / سَحَجَ (سَحَجَهُ يَسْحَجَ سَحْجًا: خَدَشهُ وقَشَرَهُ؛ فهو مَسحُوجٌ، وسَحِيجٌ) / طَائِرَة, طَيَّارَة (مَرْكَبَة كبيرة لها جناحان وتنقل الرُكَّاب والبَضَائِع بالجَوّ. ؛ كل من تَطِير، مؤنث طائر) / دُلْب, صِنَار\nمثال: لقد وصلت الطائرة.",
 "plane angle": "زاوية مستوية (زاوية مشكلة من خطين مستقيمين (في نفس المستوى))",
 "plane figure": "شكل ثنائي الأبعاد, شكل مستو (شكل ثنائي الأبعاد)",
 "plane geometry": "هندسة مستوية (هندسة الأشكال ثنائية الأبعاد)",
 "plane seat": "مقعد طائرة (مقعد على طائرة تجارية)",
 "plane section": "مقطع, مقطع مستو ((في الهندسة) المنطقة الناتجة عن قطع مستوى لجسم صلب)",
 "plane table": "طاولة مسح (أداة مسح تتكون من لوحة رسم ومسطرة مثبتة على حامل ثلاثي القوائم؛ تستخدم لرؤية ورسم التفاصيل الطبوغرافية)",
 "plane ticket": "تَذْكِرَة طَيَرَان",
 "plane tree": "دلب, شجرة الدلب",
 "plane-polarized": "مستقطب مستويا ((عن الموجة المتحركة) تهتز في مستوى واحد)\nمثال: ضوء مستقطب مستويا",
 "planeness": "تسطح, ثنائية الأبعاد (خاصية امتلاك بعدين)",
 "planer": "فارة, مسحاج (أداة كهربائية لتنعيم أو تشكيل الخشب)",
 "planet": "كَوْكَب سَيَّار, كَوْكَب ((قديمًا) جرم سماوي من البلازما مضيئ بذاته متماسك بفعل الجاذبية؛ جرم سماوي يدور حول الشمس) / كَوْكَب ((قديمًا) جرم سماوي من البلازما مضيئ بذاته متماسك بفعل الجاذبية؛ جرم سماوي يدور حول الشمس)\nمثال: كوكب الأرض جميل.",
 "planet gear": "ترس تداويري, ترس كوكبي (ترس خارجي يدور حول ترس شمسي مركزي في مجموعة تروس تداويرية)",
 "planet wheel": "ترس تداويري, ترس كوكبي (ترس خارجي يدور حول ترس شمسي مركزي في مجموعة تروس تداويرية)",
 "planetal": "كوكبي (مكون من أو متعلق بـ أو يشبه الخصائص الفيزيائية أو المدارية لكوكب أو الكواكب)\nمثال: حركة كوكبية",
 "planetarium": "القبة السماوية, نموذج النظام الشمسي (جهاز أو نموذج لتمثيل الأنظمة الشمسية) / قبة فلكية (جهاز بصري لعرض صور الأجرام السماوية والظواهر الفلكية الأخرى على السطح الداخلي لقبة نصف كروية) / بلانيتاريوم, قبة فلكية (مبنى يضم أداة لعرض مواقع الكواكب على سقف مقبب)",
 "planetary": "كَوْكَبِيّ, كَوْنِيّ (يشمل الأرض بأسرها؛ غير محدود بنطاق إقليمي) / بِلَا مَسَار ثَابِت, شَارِد (ليس له مسار محدّد أو ثابت) / كوكبي (مكون من أو متعلق بـ أو يشبه الخصائص الفيزيائية أو المدارية لكوكب أو الكواكب) / أرضي, كوكبي (مكون من أو متعلق بـ أو مميز لكوكب الأرض أو سكانه)\nمثال: حركة كوكبية",
 "planetary gear": "ترس تداويري, ترس كوكبي (ترس خارجي يدور حول ترس شمسي مركزي في مجموعة تروس تداويرية)",
 "planetary house": "برج, برج فلكي ((علم التنجيم) واحدة من 12 منطقة متساوية تنقسم إليها دائرة البروج)",
 "planetary mixer": "خلاط كوكبي (خلاط يتكون من وعاء ومحرك يتحرك بسرعة حول الوعاء لخلط محتوياته)\nمثال: مع القدرة على خلط مجموعة واسعة من المكونات، تعتبر الخلاطات الكوكبية أكثر تنوعاً من نظيراتها الحلزونية",
 "planetary nebula": "سَدِيم كَوْكَبِيّ",
 "planetesimal": "كُوَيْكِب أَوْلِيّ (واحد من العديد من الأجرام السماوية الصلبة الصغيرة التي يعتقد أنها كانت موجودة في مرحلة مبكرة من تطور النظام الشمسي)",
 "planetesimal hypothesis": "فرضية الكواكب المصغرة ((علم الكونيات) النظرية القائلة بأن النظام الشمسي تشكل عن طريق التراكم الجاذبي للكواكب المصغرة)",
 "planetless": "بلا كوكب",
 "planetocentric": "كَوْكَبِيّ الْمَرْكَز",
 "planetoid": "كُوَيْكِب (أي من الأجرام السماوية الصغيرة العديدة التي تتحرك حول الشمس)",
 "plangency": "جهارة, دوي (امتلاك طابع صوت عميق وعالٍ؛ خاصية الرنين)",
 "plangent": "رَنَّان, طَنَّان (عالٍ ومدوٍّ)",
 "planimeter": "مقياس المساحة, مكامل (أداة قياس لقياس مساحة شكل مستوٍ غير منتظم)",
 "planing machine": "فارة, مسحاج (أداة كهربائية لتنعيم أو تشكيل الخشب)",
 "plank": "عَارِضَة",
 "plank-bed": "سرير ألواح, سرير خشبي (سرير مكون من ألواح خشبية (بدون مرتبة))",
 "planking": "تبليط بالألواح الخشبية (عمل تغطية منطقة بألواح خشبية) / أرضية خشبية, تبليط خشبي ((بحرياً) غطاء أو أرضية مصنوعة من الألواح الخشبية (كما في السفينة)) / ألواح خشبية (الألواح الخشبية بشكل جماعي؛ كمية من الألواح)",
 "plankton": "عَوَالِق",
 "planktonic": "بلانكتوني, عوالقي (مكون من أو متعلق بالعوالق (البلانكتون))",
 "planktonic algae": "طحالب عوالقية (طحالب وحيدة الخلية، وهي إحدى العائلات الأربع للطحالب الخضراء الكارية)",
 "planless": "تَائِه, هَائِم (يسير بلا وجهة ولا اتّجاه محدّد)",
 "planned": "مخطط, مدبر (مُصمم أو مُنفذ وفقاً لخطة) / مُبَيَّت, مُتَعَمَّد (بتخطيط ونية مسبقة)\nمثال: النفقات المخططة للمعدات الجديدة",
 "planned community": "مجتمع مخطط (منطقة سكنية تم تخطيطها لفئة معينة من السكان)",
 "planner": "مُخَطِّط",
 "planning": "تخطيط (فعل أو عملية وضع خطط أو مخططات لمشروع أو مؤسسة ما) / تخطيط (فعل صياغة برنامج لمسار عمل محدد) / إعداد, تحضير (العملية المعرفية للتفكير فيما ستفعله في حالة حدوث شيء ما)\nمثال: كان التخطيط أكثر متعة من الرحلة نفسها",
 "planning board": "لجنة تخطيط, مجلس استشاري (مجلس مُعين لتقديم المشورة للمسؤول الإداري الأول)",
 "planning commission": "لجنة التخطيط (لجنة مفوضة لاقتراح خطط للأنشطة والتطورات المستقبلية)",
 "planning frame": "إطار تخطيط أثري (إطار خشبي مربع يستخدم في علم الآثار)",
 "planococcus citri": "بق الحمضيات الدقيقي (يتغذى على مجموعة واسعة من النباتات المزروعة ولكنه مدمر للحمضيات بشكل خاص)",
 "planoconcave": "مُسْتَوٍ مُقَعَّر (مسطّح من جهة ومقعّر من الأخرى)",
 "planoconvex": "مُسْتَوٍ مُحَدَّب (مُسْتَوٍ مِنْ جِهَةٍ وَمُحَدَّبٌ مِنَ الأُخْرَى)",
 "planographic": "بلانوغرافي, طباعي مسطح (مكون من أو متعلق بـ أو يتضمن الطباعة المسطحة)",
 "planographic printing": "بلانوغرافيا, طباعة مستوية (عملية الطباعة من سطح لا تكون فيه مناطق الطباعة بارزة ولكنها مستقبلة للحبر (على عكس طاردة الحبر))",
 "planography": "بلانوغرافيا, طباعة مستوية (عملية الطباعة من سطح لا تكون فيه مناطق الطباعة بارزة ولكنها مستقبلة للحبر (على عكس طاردة الحبر))",
 "plant": "نَبَات (مصدر للفعل نَبَتَ؛ اسم جنس شامل لكل ما تنبته الأرض من شجر أو بقل أو عشب أو غيره) / زَرَعَ, غَرَسَ (بَذَرَ الحَبَّ؛ أَنْبَتَ، نَمَّى)\nمثال: هذا النبات مهدد بالانقراض.",
 "plant bug": "بق النبات (حشرة صغيرة زاهية الألوان تتغذى على عصارة النباتات)",
 "plant cell": "خلية نباتية (خلية تشكل وحدة هيكلية ووظيفية للنبات)",
 "plant closing": "إغلاق المصنع (فعل إغلاق تشغيل مصنع)",
 "plant department": "قسم المباني, قسم المنشآت (قسم في مؤسسة تجارية مسؤول عن بناء وصيانة المنشآت المادية)",
 "plant disease": "مرض نباتي (مرض يصيب النباتات)",
 "plant family": "فصيلة نباتية (فصيلة من النباتات)",
 "plant fiber": "ألياف نباتية (ألياف مشتقة من النباتات)",
 "plant fibre": "ألياف نباتية (ألياف مشتقة من النباتات)",
 "plant food": "سماد, مخصب (أي مادة مثل الروث أو خليط من النترات تستخدم لجعل التربة أكثر خصوبة)",
 "plant genus": "جنس نباتي (جنس من النباتات)",
 "plant hopper": "نطاط النبات (قريب من نطاطات الأوراق وحشرات البصاق ولكنه نادراً ما يضر بالنباتات المزروعة)",
 "plant hormone": "منظم نمو, هرمون نباتي ((علم النبات) منتج نباتي يعمل مثل الهرمون)",
 "plant life": "حياة نباتية, فلورا ((علم النبات) كائن حي يفتقر إلى القدرة على الانتقال الحركي)",
 "plant louse": "قمل النبات, من (أي من الحشرات الصغيرة المتعددة وخاصة المن التي تتغذى عن طريق امتصاص العصارة من النباتات)",
 "plant material": "مادة نباتية (مادة مشتقة من النباتات)",
 "plant milk": "حَلِيب نَبَاتِيّ (هو اللَبَن المَحْلُوْب، أو ما لم يتغير طعمه. أصل التسمية؛ هو ما لم يَرُوْب واللَبَن هو ما رَابَ)\nمثال: كنت أشرب الحليب",
 "plant order": "رتبة نباتية (رتبة من النباتات)",
 "plant organ": "عضو نباتي (وحدة وظيفية وهيكلية للنبات أو الفطر)",
 "plant part": "جُزْء نَبَاتِيّ, عُضْو نَبَاتِيّ (أيّ جزء من أجزاء النبات أو الفطر)",
 "plant process": "بروز نباتي, نتوء نباتي (بروز طبيعي أو نتوء من جسم النبات أو عضو فيه)",
 "plant product": "منتج نباتي (منتج مصنوع من مادة نباتية)",
 "plant scientist": "عالم نبات (عالم أحياء متخصص في دراسة النباتات)",
 "plant structure": "جُزْء نَبَاتِيّ, عُضْو نَبَاتِيّ (أيّ جزء من أجزاء النبات أو الفطر)",
 "plant substance": "مادة نباتية (مادة مشتقة من النباتات)",
 "plant tissue": "نسيج نباتي (نسيج النبات)",
 "plant toxin": "ذيفان نباتي, سم نباتي (أي مادة تنتجها النباتات وتكون مشابهة في خصائصها للذيفان البكتيري الخارجي)",
 "plant virus": "فيروس نباتي",
 "plantagenet": "بلانتاجينت (اسم عائلة لخط من الملوك الإنجليز حكموا من 1154 إلى 1485)",
 "plantagenet line": "بلانتاجينت (اسم عائلة لخط من الملوك الإنجليز حكموا من 1154 إلى 1485)",
 "plantago lanceolata": "لسان الحمل السهاني, لسان الحمل ضيق الأوراق (نبات لسان حمل من العالم القديم بأوراق مضلعة ضيقة طويلة راسخ في المناطق المعتدلة)",
 "plantago major": "لسان الحمل الكبير, لسان الحمل عريض الأوراق (نبات معمر أوروبي شائع تم توطينه في جميع أنحاء العالم؛ يعتبر عشباً ضاراً مزعجاً)",
 "plantago media": "لسان الحمل المتوسط (نبات معمر من العالم القديم واسع الانتشار تم توطينه في أمريكا الشمالية، له أوراق مشعرة بدقة وزهور بيضاء عطرة غير بارزة)",
 "plantago psyllium": "قطونة, لسان الحمل الأسيوي (نبات لسان الحمل في مناطق البحر الأبيض المتوسط تنتفخ بذوره وتصبح هلامية عند ترطيبها وتستخدم كملين خفيف)",
 "plantago rugelii": "لسان الحمل روجيل (نبات لسان حمل أمريكي شمالي له أعناق أوراق محمرة وأوراق عريضة)",
 "plantago virginica": "لسان الحمل الفرجيني (نبات حولي أو ثنائي الحول أمريكي شمالي بشعيرات ناعمة طويلة على الأوراق)",
 "plantain": "لِسَان الْحَمَل, لِسَان الْخَرُوف (فِي : جسم لحميّ مستطيل متحرك، يكون في الفم، ويصلح للتّذوُّق والبلع، وللنطق؛ جَارِحَة الْكَلَام؛ كَلِمَة)\nمثال: ماري لها فم ليس لها لسان.",
 "plantain lily": "زنبق لسان الحمل, هوستا (أي من النباتات المعمرة العديدة التي تتميز بكتل من الأوراق المضلعة العريضة الفخمة وعناقيد من الزهور البيضاء أو الزرقاء أو الليلكية؛ تستخدم كغطاء أرضي)",
 "plantain tree": "للسان الحمل, موز الجنة (شجرة موز تحمل عناقيد متدلية من الثمار النشوية الخضراء الزاوية الصالحة للأكل؛ المناطق الاستوائية وشبه الاستوائية)",
 "plantain-leaved pussytoes": "رجل القط لسانية الأوراق (صنف من نبات رجل القط)",
 "plantal": "نباتي (متعلق بالنباتات)",
 "plantar": "أخمصي (متعلق بـ أو يحدث على السطح السفلي للقدم)\nمثال: يمكن أن تكون الثآليل الأخمصية مؤلمة جداً",
 "plantar fasciitis": "اِلْتِهَاب اللِّفَافَة الْأَخْمَصِيَّة",
 "plantar reflex": "منعكس أخمصي (انثناء أصابع القدم عند حك باطن القدم بقوة على الجانب الخارجي من الكعب إلى الأمام في الأشخاص فوق سن عامين)",
 "plantar wart": "ثؤلول أخمصي (ثؤلول يحدث على باطن القدم)\nمثال: الضغط يجعل الثآليل الأخمصية تطور مسماراً مؤلمًا حول المركز الناعم",
 "plantation": "مَزْرَعَة",
 "plantation owner": "صاحب المزرعة (مالك أو مدير لمزرعة كبيرة (خاصة المزارع الاستعمارية أو الاستثمارية))",
 "plantation walking horse": "حصان تينيسي المشاء (حصان يتميز بالقدرة على التحمل ومدرب على التحرك بمشية سريعة)",
 "planted": "رَاسِخ, عَمِيق الجُذُور ((يستخدم خاصة للأفكار أو المبادئ) عميق الجذور؛ ثابت ومتمكّن بقوّة) / مزروع (وضع في التربة للنمو)",
 "planter": "أصيص مزخرف, حوض زرع (وعاء مزخرف للنباتات المنزلية) / صاحب المزرعة (مالك أو مدير لمزرعة كبيرة (خاصة المزارع الاستعمارية أو الاستثمارية)) / غارس (عامل يضع أو يزرع البذور أو الشتلات في الأرض)",
 "planter's punch": "بلانترز بانش (كوكتيل مصنوع من الرم وعصير الليمون الأخضر أو الأصفر مع سكر وأحياناً بيترز)",
 "planthopper": "نطاط النبات (قريب من نطاطات الأوراق وحشرات البصاق ولكنه نادراً ما يضر بالنباتات المزروعة)",
 "plantigrade": "أخمضي السير, مترجل على باطن القدم ((عن الثدييات) السير على كامل باطن القدم (كما تفعل الأرانب والراكون والدببة والبشر)) / حيوان أخمصي السير (حيوان يمشي بحيث يلامس باطن القدم بالكامل الأرض مثل الدببة والبشر)",
 "plantigrade mammal": "حيوان أخمصي السير (حيوان يمشي بحيث يلامس باطن القدم بالكامل الأرض مثل الدببة والبشر)",
 "planting": "زراعة, غرس (وضع البذور أو النباتات الصغيرة في الأرض لتنمو) / زرع, غرس (فعل التثبيت بإحكام في المكان) / مشجر, مغرس (مجموعة من النباتات (أشجار أو شجيرات أو زهور) في منطقة معينة)\nمثال: زراعة الذرة عمل شاق",
 "plantlet": "شتلة صغيرة, نُبيتة (نبات صغير أو نبات يافع)",
 "plantlike flagellate": "سوطي نباتي (كائنات وحيدة الخلية لها العديد من خصائص الطحالب النموذجية)",
 "plantsman": "خبير نباتات (خبير ذكر في علم زراعة النباتات (الفاكهة أو الزهور أو الخضروات أو نباتات الزينة))",
 "plantswoman": "خبيرة نباتات (خبيرة أنثى في علم زراعة النباتات (الفاكهة أو الزهور أو الخضروات أو نباتات الزينة))",
 "planula": "يرقة مستوية (اليرقة المسطحة المهدبة حرة السباحة للجوفمعويات الهيدرية)",
 "plaque": "لوحة تذكارية نحاسية, لوحة معدنية (نصب تذكاري مصنوع من النحاس الأصفر) / لويحة ((علم الأمراض) رقعة غير طبيعية صغيرة على أو داخل الجسم)",
 "plaquenil": "بلاكوينيل, هيدروكسي كلوروكوين (دواء مضاد للالتهاب (الاسم التجاري بلاكوينيل) يستخدم في علاج التهاب المفاصل الروماتويدي والملاريا والذئبة الحمامية)",
 "plash": "رشق, طرطشة (الصوت الذي يشبه طرطشة الماء)",
 "plasm": "بلازما, مصورة (سائل مائي عديم اللون من الدم واللمف لا يحتوي على خلايا، ولكن تعلق فيه خلايا الدم (كريات الدم الحمراء وكريات الدم البيضاء والصفائح الدموية)) / جبلة جرثومية (بروتوبلازم الخلايا الجرثومية الذي يحتوي على الكروموسومات والجينات)",
 "plasma": "بِلَزْمَا / مُصَوِّرَة, بِلَزْمَا الدّم",
 "plasma cell": "خلية بلازمية (خلية تتطور من الخلية اللمفاوية البائية كرد فعل لمستضد معين؛ توجد في نخاع العظم وأحياناً في الدم)",
 "plasma membrane": "غشاء الخلية, غشاء بلازمي (غشاء رقيق (طبقة مزدوجة من الدهون) يحيط بسيتوبلازم الخلية؛ تتحكم البروتينات في الغشاء في مرور الأيونات (مثل الصوديوم أو البوتاسيوم أو الكالسيوم) داخل…)",
 "plasma physics": "فيزياء البلازما (فرع الفيزياء المعني بالمادة في طور البلازما)",
 "plasma protein": "بروتين البلازما (أي من البروتينات الموجودة في بلازما الدم)",
 "plasma thromboplastin antecedent": "سلف ثرومبوبلاستين البلازما (عامل تخثر يؤدي نقصه إلى ميل للنزيف)",
 "plasmablast": "أرومة بلازمية (سلف الخلية البلازمية)",
 "plasmacyte": "خلية بلازمية (خلية تتطور من الخلية اللمفاوية البائية كرد فعل لمستضد معين؛ توجد في نخاع العظم وأحياناً في الدم)",
 "plasmacytoma": "ورم بلازمي (ورم في خلايا البلازما (عادة في نخاع العظم))",
 "plasmapheresis": "فصادة البلازما (يتم فصل البلازما عن الدم الكامل وإعادة الباقي إلى المتبرع)",
 "plasmid": "بِلَازْمِيد",
 "plasmid dna": "بِلَازْمِيد",
 "plasmin": "بلازمين (إنزيم يذيب الفيبرين في جلطات الدم)",
 "plasminogen": "بلازمينوجين (شكل غير نشط من البلازمين يوجد في البلازما ويتحول إلى بلازمين بواسطة المذيبات العضوية)",
 "plasminogen activator": "منشط البلازمينوجين, يوروكيناز (بروتياز يُنتج في الكلى يحول البلازمينوجين إلى بلازمين وبالتالي يبدأ انحلال الفيبرين)",
 "plasmodial slime mold": "عفن غروي حقيقي, ميكسوميسيت (عفن غروي من طائفة الميكسوميسيت)",
 "plasmodiophora brassicae": "فطر الجذر الصولجاني (فطر يشبه العفن الغروي يسبب تورمات أو تشوهات في جذور الملفوف والنباتات ذات الصلة)",
 "plasmodium": "بلازموديوم, متصورة (أوالي طفيلي من جنس المتصورة يسبب الملاريا لدى البشر) / بلازموديوم (طبقة متعددة الأنوية من السيتوبلازم تميز بعض مراحل الكائنات الحية مثل العفن الغروي)",
 "plasmodium vivax": "بلازموديوم, متصورة (أوالي طفيلي من جنس المتصورة يسبب الملاريا لدى البشر)",
 "plasmolysis": "اِنْحِلَال السِيتُوبْلَازْم",
 "plaster": "مِلَاط, جِبْس",
 "plaster bandage": "جبس, جبيرة (ضمادة تتكون من غطاء صلب (غالباً من الجبس) يثبت العظام المكسورة أثناء التئامها)",
 "plaster cast": "جبس, جبيرة (ضمادة تتكون من غطاء صلب (غالباً من الجبس) يثبت العظام المكسورة أثناء التئامها)",
 "plaster machine": "آلة لياسة (آلة للياسة الجدران)",
 "plaster of paris": "جص, جص باريس (أي من أسمنتات الجبس المختلفة؛ مسحوق أبيض (شكل من أشكال كبريتات الكالسيوم) يشكل عجينة عند خلطه بالماء ويتصلب؛ يستخدم في صنع القوالب والمنحوتات…)",
 "plaster printing": "طباعة جصية (الطباعة من لوحة غائرة تم تحويلها إلى طباعة بارزة عن طريق عمل قالب جصي منها)",
 "plaster saint": "قديس مزيف, مدعي الفضيلة (شخص (يُعتقد أنه) بلا عيوب بشرية)\nمثال: إنه ليس قديساً منزهاً",
 "plasterboard": "جبس بورد, لوح جصي (لوح جداري بقلب من الجص الجبسي مرتبط بطبقات من الورق أو الألواح الليفية؛ يستخدم بدلاً من الجص أو الألواح الجدارية لعمل الجدران الداخلية)",
 "plastered": "ثَمِل تَمَامًا, سَكْرَان طَافِح (فِي حَالَة سُكْرٍ شَدِيد) / مُجَصَّص ((للجدران) مغطى بطبقة من الجص) / مُمَلَّس ((لِلشَّعْرِ) جُعِلَ أَمْلَسَ بِاسْتِخْدَامِ مَادَّةٍ لَزِجَةٍ أَوْ لَامِعَة)",
 "plasterer": "جَصّاص, عامل جص (عامل ماهر في وضع الجص (الجبس) على الجدران)",
 "plasterer's float": "مِسْحاة التمليط, مِملَج (أداة يدوية ذات وجه مسطح تستخدم لتنعيم وإنهاء سطح الجص أو الأسمنت)",
 "plastering": "تطيين, قصارة (وضع الجص)",
 "plastering machine": "آلة لياسة (آلة للياسة الجدران)",
 "plastering trowel": "مالج, مسطرين التلييس (مسطرين يستخدم لفرد وتنعيم الجص)",
 "plasterwork": "جص, طبقة الجص (سطح من الجص المتصلب (كما على الحائط أو السقف))\nمثال: كانت هناك شقوق في الجص",
 "plastic": "بْلَاسْتِيك (مادّة لدائنيّة ( مرنة ) عضويّة الأصل أو مركّبة ، يمكن سبكها تحت تأثير الحرارة أو الضَّغط ، تقبل التَّشكيل ، وتصنع منها أدواتٌ مختلفة) / بْلَاسْتِيكِيّ\nمثال: لدي قبعه من البلاستيك .",
 "plastic art": "فن تشكيلي (فنون التشكيل أو النمذجة؛ النحت والحفر)",
 "plastic bag": "كِيس نَايْلُون",
 "plastic blow molding machine": "آلة قولبة بالنفخ (آلة تشكل الأجزاء البلاستيكية المجوفة)",
 "plastic blow moulding machine": "آلة قولبة بالنفخ (آلة تشكل الأجزاء البلاستيكية المجوفة)",
 "plastic bomb": "قنبلة بلاستيكية (قنبلة مصنوعة من متفجرات بلاستيكية)",
 "plastic explosive": "بلاستيك, متفجرات بلاستيكية (مادة متفجرة يسهل تشكيلها حول الهدف المراد تدميره)",
 "plastic film": "غشاء بلاستيكي, فيلم (ورقة رقيقة من مادة (عادة بلاستيكية وشفافة) تستخدم للف أو تغطية الأشياء)",
 "plastic laminate": "صفائح بلاستيكية, لامينيت بلاستيكي (مادة صفائحية مصنوعة عن طريق ربط طبقات بلاستيكية)",
 "plastic surgeon": "جراح تجميل (جراح يقوم بتجميل الجسم (خاصة الوجه))",
 "plastic surgery": "جِرَاحَةْ تَجْمِيل",
 "plastic wrap": "غلاف بلاستيكي (غلاف يتكون من ورقة بلاستيكية شفافة رقيقة جداً)",
 "plastically": "بِشَكْل لَدِن, تَّشْكِيلِيًّا (بطريقة قابلة للتشكيل أو التعديل)\nمثال: استخدم الطين بشكل تشكيلي",
 "plasticine": "بلاستيسين, صلصال (مادة صناعية تشبه الطين ولكنها تظل طرية؛ تستخدم كبديل للطين أو الشمع في النمذجة (خاصة في المدارس))",
 "plasticiser": "مادة ملدنة, ملدن (مادة تضاف إلى البلاستيك أو المواد الأخرى لجعلها أكثر مرونة)",
 "plasticity": "طواعية, قابلية للطرق (خاصية القابلية للتشكيل مادياً؛ خاصية الشيء الذي يمكن تشغيله أو طرقه أو تشكيله دون أن ينكسر)",
 "plasticizer": "مادة ملدنة, ملدن (مادة تضاف إلى البلاستيك أو المواد الأخرى لجعلها أكثر مرونة)",
 "plastics industry": "صناعة البلاستيك (صناعة تصنع المنتجات البلاستيكية)",
 "plastid": "بلاستيد, صانعة (أي من الجسيمات الصغيرة المختلفة في سيتوبلازم خلايا النباتات وبعض الحيوانات تحتوي على أصباغ أو نشا أو زيت أو بروتين)",
 "plastination": "تلدين, لدنة (عملية تتضمن التثبيت والجفاف والتشريب القسري وتصلب الأنسجة البيولوجية؛ يتم استبدال الماء والدهون بالبوليمرات القابلة للمعالجة (السيليكون أو الإيبوكسي…)\nمثال: تعتبر عملية تلدين العينات ذات قيمة للبحث والتدريس",
 "plastique": "بلاستيك, متفجرات بلاستيكية (مادة متفجرة يسهل تشكيلها حول الهدف المراد تدميره)",
 "plastron": "صُدْرَة ((علم الحيوان) جزء من صدفة السلحفاة يشكل جانبها السفلي) / وسادة حماية الصدر (وسادة كبيرة يرتديها المبارز لحماية الصدر) / صدرية درعية (صفيحة صدرية معدنية كانت تلبس تحت معطف الزرد) / صدرية القميص (مقدمة قميص الرجل الرسمي)",
 "plat": "خريطة مساحية, مخطط أرض (خريطة تظهر الميزات المخططة أو الفعلية لمنطقة (شوارع وقطع أراضي بناء وما إلى ذلك))",
 "plat du jour": "طَبَق اليَوْم (جَعَلَ شيئًا يغطي شيئًا آخر بشكل كامل؛ نفَّذَ أمرًا أو خطةً عمليةً)\nمثال: هذا الطبق لذيذ.",
 "platalea leucorodia": "أبو ملعقة الشائع (أبو ملعقة أبيض نقي ذو عرف من جنوب أوراسيا وشمال شرق أفريقيا)",
 "platan": "دلب, شجرة الدلب",
 "platanthera bifolia": "أوركيد الفراشة الصغير (أوركيد جنوب أوروبي ذو زهور بيضاء مخضرة عطرة؛ يوضع أحياناً في جنس هابيناريا)",
 "platanthera chlorantha": "أوركيد الفراشة الكبير (أوركيد جنوب أوروبي بزهور خضراء داكنة أكبر وأقل عطراً من أوركيد الفراشة الصغير؛ يوضع أحياناً في جنس هابيناريا)",
 "platanthera leucophea": "أوركيد البراري الأبيض المهدب (من وسط أمريكا الشمالية؛ نوع مهدد بالانقراض)",
 "platanus acerifolia": "دلب قيقبي الأوراق, دلب لندني (شجرة كبيرة جداً سريعة النمو تزرع كثيراً كشجرة شوارع)",
 "platanus occidentalis": "جميز أمريكي, دلب غربي (شجرة دلب كبيرة جداً منتشرة في شرق ووسط أمريكا الشمالية إلى المكسيك)",
 "platanus orientalis": "دلب مشرقي (شجرة كبيرة في جنوب شرق أوروبا إلى آسيا الصغرى)",
 "platanus racemosa": "جميز كاليفورنيا, دلب عنقودي (شجرة طويلة في باها كاليفورنيا ذات لحاء متساقط وأوراق كبيرة مفصصة راحياً متبادلة وعناقيد كروية من الزهور)",
 "platanus wrightii": "جميز أريزونا, دلب رايتي (شجرة متوسطة الحجم في أريزونا والمناطق المجاورة ذات أوراق مفصصة بعمق وثمار مجمعة في مجموعات من 3 إلى 5)",
 "plate": "طَبَق, صَحْن (جَعَلَ شيئًا يغطي شيئًا آخر بشكل كامل؛ نفَّذَ أمرًا أو خطةً عمليةً)\nمثال: هذا الطبق لذيذ.",
 "plate and frame filter press": "مكبس الترشيح, مكبس ترشيح الإطارات والألواح (نوع من مكابس الترشيح يتكون من العديد من الألواح والإطارات المجمعة بالتناوب مع دعامات زوج من القضبان)\nمثال: يستخدم مكبس ترشيح الألواح على نطاق واسع في عمليات السكر مثل إنتاج شراب القيقب في كندا، نظراً لأنه يوفر كفاءة وموثوقية عالية جداً",
 "plate armor": "تصفيح, درع صفيحي (صفيحة فولاذية مقواة خصيصاً تستخدم لحماية التحصينات أو المركبات من نيران العدو) / درع صفائحي, درع صفيحي (نوع تاريخي من الدروع الشخصية المصنوعة من صفائح الحديد أو الصلب، حلت محل الزرد خلال القرن الرابع عشر)\nمثال: أدت القوة المتزايدة للأسلحة النارية وتوفرها إلى التخلي عن أجزاء من الدرع الصفائحي لصالح قوات أرخص وأكثر قدرة على الحركة",
 "plate armour": "تصفيح, درع صفيحي (صفيحة فولاذية مقواة خصيصاً تستخدم لحماية التحصينات أو المركبات من نيران العدو) / درع صفائحي, درع صفيحي (نوع تاريخي من الدروع الشخصية المصنوعة من صفائح الحديد أو الصلب، حلت محل الزرد خلال القرن الرابع عشر)\nمثال: أدت القوة المتزايدة للأسلحة النارية وتوفرها إلى التخلي عن أجزاء من الدرع الصفائحي لصالح قوات أرخص وأكثر قدرة على الحركة",
 "plate compactor": "دكاكة صفيحية هزازة (آلة تعمل بمحرك، يتم توجيهها من الخلف، تستخدم لدمج مجموعة واسعة من الرمل والحصى ومواد الأساس الحبيبية)",
 "plate filter press": "مكبس الترشيح, مكبس ترشيح الإطارات والألواح (نوع من مكابس الترشيح يتكون من العديد من الألواح والإطارات المجمعة بالتناوب مع دعامات زوج من القضبان)\nمثال: يستخدم مكبس ترشيح الألواح على نطاق واسع في عمليات السكر مثل إنتاج شراب القيقب في كندا، نظراً لأنه يوفر كفاءة وموثوقية عالية جداً",
 "plate glass": "زجاج ألواح, زجاج مسطح (زجاج مُشكل في أوراق رقيقة كبيرة)",
 "plate iron": "لوح حديدي (صفيحة من الحديد)",
 "plate rack": "رف الأطباق (رف لحمل الأطباق لتجف بعد غسلها)",
 "plate rail": "رف الصحون (سكة أو رف ضيق مثبت على الحائط لعرض الصحون)",
 "plate tectonic theory": "تكتونيات, تكتونية الصفائح (فرع الجيولوجيا الذي يدرس الطي والتصدع في القشرة الأرضية)",
 "plate tectonics": "تكتونيات, تكتونية الصفائح (فرع الجيولوجيا الذي يدرس الطي والتصدع في القشرة الأرضية)",
 "plate-and-frame filter press": "مكبس الترشيح, مكبس ترشيح الإطارات والألواح (نوع من مكابس الترشيح يتكون من العديد من الألواح والإطارات المجمعة بالتناوب مع دعامات زوج من القضبان)\nمثال: يستخدم مكبس ترشيح الألواح على نطاق واسع في عمليات السكر مثل إنتاج شراب القيقب في كندا، نظراً لأنه يوفر كفاءة وموثوقية عالية جداً",
 "plateau": "هَضْبَة",
 "plateau striped whiptail": "سحلية السوط المخططة (تتميز بخطوط طولية مميزة: توجد في هضبة كولورادو من أريزونا إلى غرب كولورادو)",
 "plateful": "ملء طبق (الكمية المحتواة في طبق)",
 "platelayer": "ممدد السكك (عامل يضع ويصلح خطوط السكك الحديدية)",
 "platelet": "صَفِيحَةُ دَمٍ",
 "plateletpheresis": "فصادة الصفائح الدموية (يتم فصل الصفائح الدموية عن الدم الكامل وإعادة الباقي إلى المتبرع)",
 "platelike": "شَبِيهٌ بِالصَّفِيحَةِ, صَفَائِحِيّ (كالحراشف الصلبة المسطحة لدى أسماك القرش مثلاً)",
 "platen": "أسطوانة الآلة الكاتبة, سطوانة (الأسطوانة الدوارة في الآلة الكاتبة التي تضرب عليها المفاتيح) / قرص الطباعة (اللوحة المسطحة في المطبعة التي تضغط الورق مقابل الحروف) / صفيحة ارتكاز, قاعدة الماكينة (طاولة العمل في أداة آلية (مخرطة أو مكبس))",
 "plater": "عامل طلاء, مطلّي (عامل ماهر يغطي الأشياء بطبقة من المعدن (عادة الفضة أو الذهب))",
 "platform": "مِنَصَّة / رَصِيف, مِنَصَّة",
 "platform bed": "سرير منصة (سرير بدون نوابض (زنبرك))",
 "platform rocker": "كرسي هزاز بقاعدة (كرسي هزاز مثبت على قاعدة ثابتة)",
 "platform screen door": "أَبْوَاب المِنَصَّة",
 "platichthys flesus": "السمكة المفلطحة الأوروبية (سمكة طعام مهمة في أوروبا)",
 "plating": "طلاء معدني (وضع طبقة رقيقة من المعدن (كما هو الحال في التحليل الكهربائي)) / طلاء معدني (طبقة رقيقة من المعدن مترسبة على سطح ما)",
 "platinum": "بَلَاتِين / بَلَاتِينُوم",
 "platinum black": "أسود البلاتين (مسحوق أسود ناعم من البلاتين؛ يستخدم كمحفز في التفاعلات الكيميائية)",
 "platinum blond": "أشقر بلاتيني (شخص أشقر شعره أشقر فضي شاحب (غالباً ما يكون مصبوغاً صناعياً))",
 "platinum blonde": "أشقر بلاتيني (شخص أشقر شعره أشقر فضي شاحب (غالباً ما يكون مصبوغاً صناعياً))",
 "platinum thermometer": "مقياس حرارة المقاومة, مقياس حرارة بلاتيني (مقياس حرارة يقيس درجة الحرارة عن طريق التغيرات في مقاومة لولب من سلك البلاتين)",
 "platinum-blonde": "أَشْقَر بَلَاتِينِيّ, أَشْقَر رَمَادِيّ (بلون شعر أبيض مائل إلى الرمادي)",
 "platitude": "عبارة مبتذلة, قول مأثور مبتذل (ملاحظة مبتذلة أو واضحة بشكل مفرط)",
 "platitudinal": "سَخِيف, سَطْحِيّ (مُمِلّ ومُرهِق مع ادعاءات بالأهمية أو الأصالة)",
 "platitudinarian": "مردد كليشيهات, مكثر من المبتذلات (شخص ممل يكثر من استخدام العبارات المبتذلة)",
 "platitudinous": "سَخِيف, سَطْحِيّ (مُمِلّ ومُرهِق مع ادعاءات بالأهمية أو الأصالة)",
 "plato": "أَفْلَاطُون (فيلسوف إغريقي، عاش بين عامَي ٤٢٧ و٣٤٧ قبل الميلاد، وكان أحد تلاميذ سُقْرَاط؛ اسم شخصي معطًى للذكور من الإغريقيين)",
 "plato's academy": "أكاديمية أفلاطون (مدرسة أسسها أفلاطون في أثينا القديمة)\nمثال: استمرت أكاديمية أفلاطون لعدة مئات من السنين بعد وفاة أفلاطون",
 "platonic": "أَفْلَاطُونِيّ",
 "platonic body": "متعدد سطوح منتظم, مجسم أفلاطوني (أي واحد من خمسة مجسمات أوجهها مضلعات منتظمة متطابقة وزواياها متعددة السطوح متطابقة)",
 "platonic solid": "متعدد سطوح منتظم, مجسم أفلاطوني (أي واحد من خمسة مجسمات أوجهها مضلعات منتظمة متطابقة وزواياها متعددة السطوح متطابقة)",
 "platonic year": "سنة أفلاطونية, سنة عظمى (الوقت اللازم لدورة كاملة واحدة لمبادرة الاعتدالين، حوالي 25,800 سنة)",
 "platonism": "أَفْلَاطُونِيَّة",
 "platonist": "أفلاطوني (مدافع عن الأفلاطونية)",
 "platonistic": "أفلاطوني (يخص أو يميز أو يتوافق مع الأفلاطونية)",
 "platoon": "فَصِيلَة عَسْكَرِيَّة, فَصِيلَة (ولد الناقة أو البقرة بعد أن يفصل عن أمه، الجمع فِصال وفصلان؛ فصيلة الرجل: المقرّبون إليه من عشيرته)\nمثال: يريد سامي أن يبيع كلبه من فصيلة الشيبا إينو.",
 "plattdeutsch": "الألمانية السفلى, بلات دويتش (لهجة ألمانية يتم التحدث بها في شمال ألمانيا)",
 "platte river penstemon": "بنستيمون نهر بلات (نبات قائم بأزهار زرقاء بنفسجية في حلقات بالقرب من أطراف السيقان؛ أيداهو إلى يوتا ووايومنغ)",
 "platter": "أسطوانة, أسطوانة فونوغراف (تسجيل صوتي يتكون من قرص به أخدود مستمر؛ يستخدم لإعادة إنتاج الموسيقى عن طريق الدوران بينما تتبع إبرة الفونوغراف الأخدود) / طبق تقديم كبير (طبق كبير ضحل يستخدم لتقديم الطعام)",
 "platy": "بلاتي (سمكة مكسيكية صغيرة ممتلئة الجسم؛ سمكة أحواض شعبية)",
 "platycerium alcicorne": "سرخس قرن الأيل, سرخس قرن الوعل الشائع (سرخس يزرع عادة في أستراليا وجنوب شرق آسيا وبولينيزيا)",
 "platycerium andinum": "قرن الوعل الأمريكي الجنوبي (سرخس في بيرو وبوليفيا)",
 "platycerium bifurcatum": "سرخس قرن الأيل, سرخس قرن الوعل الشائع (سرخس يزرع عادة في أستراليا وجنوب شرق آسيا وبولينيزيا)",
 "platycladus orientalis": "عفص شرقي (شجيرة أو شجرة صغيرة آسيوية تزرع على نطاق واسع في الولايات المتحدة وأوروبا؛ في بعض التصنيفات تخصص لجنسها الخاص)",
 "platyctenean": "مشطيات مسطحة (مشطيات لها مجسات طويلة وجسم مسطح)",
 "platyhelminth": "دودة مفلطحة (ديدان طفيلية أو حرة المعيشة لها جسم مسطح)",
 "platylobium formosum": "بازلاء مسطحة جميلة, بلاتيلوبيوم (شجيرة دائمة الخضرة ذات أوراق شبه قلبية وزهور صفراء زاهية تشبه البازلاء تليها قرون مسطحة ذات أجنحة مسطحة؛ موطنها أستراليا وتاسمانيا)",
 "platymiscium pinnatum": "خشب بنما الأحمر (شجيرة قائمة كبيرة من كولومبيا لها أوراق ريشية فردية كبيرة بوريقات كبيرة وعناقيد إبطية من الزهور الصفراء العطرة)",
 "platymiscium trinitatis": "بلاتيميسيوم, روبل (شجرة كبيرة من ترينيداد وغيانا لها أوراق ريشية فردية وعناقيد إبطية برائحة البنفسج من الزهور الصفراء وقرون ناعمة طويلة؛ تزرع كعينة في المتنزهات…)",
 "platypoecilus maculatus": "بلاتي (سمكة مكسيكية صغيرة ممتلئة الجسم؛ سمكة أحواض شعبية)",
 "platypus": "خُلْدُ ٱلْمَاء, مِنْقَارُ ٱلْبَطّ (الثَبَات المَدِيد والبَقَاء لفترة طويلة؛ دَوَام البَقَاء، يختلف عن السَرْمَد في أن السرمد مختص بالزمان تحديدا والخلد في غير ذلك)\nمثال: خلد ياني إلى النوم.",
 "platyrhine": "عريض الأنف (من أو يتعلق بقرود العالم الجديد التي لها فتحات أنف متباعدة أو لأشخاص ذوي أنوف عريضة)",
 "platyrhinian": "عريض الأنف (من أو يتعلق بقرود العالم الجديد التي لها فتحات أنف متباعدة أو لأشخاص ذوي أنوف عريضة)",
 "platyrrhine": "عريض الأنف (من أو يتعلق بقرود العالم الجديد التي لها فتحات أنف متباعدة أو لأشخاص ذوي أنوف عريضة) / قرد العالم الجديد (قرود شجرية ذات وجوه مشعرة ولها فتحتا أنف متباعدتان وذيول طويلة عادة ما تكون قابضة)",
 "platyrrhinian": "عريض الأنف (من أو يتعلق بقرود العالم الجديد التي لها فتحات أنف متباعدة أو لأشخاص ذوي أنوف عريضة) / قرد العالم الجديد (قرود شجرية ذات وجوه مشعرة ولها فتحتا أنف متباعدتان وذيول طويلة عادة ما تكون قابضة)",
 "platyrrhinic": "عريض الأنف (من أو يتعلق بقرود العالم الجديد التي لها فتحات أنف متباعدة أو لأشخاص ذوي أنوف عريضة)",
 "platysma": "عضلة مبطحة (إحدى عضلتين عريضتين تقعان على جانبي الرقبة ويعصبهما العصب الوجهي؛ تمتد من الفك السفلي إلى الترقوة وتشارك في تحريك الفم والفك)",
 "platystemon californicus": "أكواب القشطة, بلاتيستيمون (نبات كاليفورني بزهور صفراء شاحبة صغيرة)",
 "plaudit": "إشادة, استحسان (موافقة حماسية)\nمثال: لقي الكتاب استحساناً متواضعاً",
 "plaudits": "إشادة, استحسان (موافقة حماسية)\nمثال: لقي الكتاب استحساناً متواضعاً",
 "plausibility": "مَعْقُولِيَّة (صحة ظاهرية)",
 "plausible": "قابل للتصديق, معقول (يبدو معقولاً وموثوقاً، وبالتالي مقنعاً) / مَعْسُول الكَلَام, مُقْنِع زَيْفًا (يَتَّسِم بِتَقْدِيم حُجَج خَادِعَة تَبْدُو مَقْبُولَة)\nمثال: عذر وجيه",
 "plausibleness": "مَعْقُولِيَّة (صحة ظاهرية)",
 "plausibly": "بِشَكْل مَعْقُول, بِشَكْل مُقْنِع (سهل التصديق على أساس الأدلة المتاحة)\nمثال: تحدث بشكل معقول أمام اللجنة",
 "plausive": "اسْتِحْسَانِيّ, مُوَافِق (يُعَبِّر عَنِ المَدْح أَوِ الاسْتِحْسَان أَوْ يُظْهِرُهُمَا)",
 "plautus alle": "أوك صغير (طائر أوك صغير قصير المنقار وفير في مناطق القطب الشمالي)",
