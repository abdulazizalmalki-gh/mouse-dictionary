 "plethodon cinereus": "سمندل أحمر الظهر الشرقي (سمندل شائع في شرق أمريكا الشمالية)",
 "plethodon vehiculum": "سمندل أحمر الظهر الغربي (سمندل من ساحل المحيط الهادئ لأمريكا الشمالية)",
 "plethodont": "سمندل عديم الرئة (سمندل بري في الغالب يتنفس من خلال جلده الرطب الرقيق؛ يضع البيض في أماكن رطبة على الأرض؛ نادراً ما يدخل الماء)",
 "plethora": "فائض, وفرة مفرطة (إفراط شديد)\nمثال: وفرة محرجة من الثروات",
 "plethoric": "مُفْرِط الوَفْرَة (وافر بشكل مفرط)",
 "plethysmograph": "مقياس التحجم (أداة قياس لقياس التغيرات في حجم جزء أو عضو أو الجسم كله (عادة نتيجة لتقلبات في كمية الدم التي يحتوي عليها))",
 "pleura": "جنب, غشاء الجنب (الغشاء المصلي الرقيق حول الرئتين والجدران الداخلية للصدر)",
 "pleural": "بلوري, جنبي (من أو يتعلق بغشاء الجنب أو جدران الصدر)\nمثال: عضلات جنب",
 "pleural cavity": "تجويف جنبي (التجويف في الصدر الذي يحتوي على الرئتين والقلب)",
 "pleural space": "حيز جنبي (المساحة المحتملة الصغيرة بين الطبقات الجدارية والحشوية للغشاء الجنبي)",
 "pleuralgia": "ألم الضلوع, ألم جنبي (ألم في الصدر ناتج عن التهاب العضلات بين الضلوع)",
 "pleurisy": "ذات الجنب (التهاب غشاء الجنب الرئوي)",
 "pleurisy root": "صقلاب درني, عشبة الفراشة (نبات معمر منتصب من شرق وجنوب الولايات المتحدة له زهور برتقالية بارزة)",
 "pleurocarp": "حزاز جانبي الثمار (حزاز توجد فيه الأرشيجونة أو الأنثريديا على فرع جانبي قصير بدلاً من الساق الرئيسي)",
 "pleurocarpous": "جانبي الثمار ((للحزازيات) وجود الأرشيجونة (عضو التأنيث) على فروع جانبية قصيرة)",
 "pleurocarpous moss": "حزاز جانبي الثمار (حزاز توجد فيه الأرشيجونة أو الأنثريديا على فرع جانبي قصير بدلاً من الساق الرئيسي)",
 "pleurodont": "جانبي الأسنان (حيوان له أسنان ملتحمة بالسطح الداخلي للحافة السنخية بدون تجاويف)",
 "pleurodynia": "ألم الضلوع, ألم جنبي (ألم في الصدر ناتج عن التهاب العضلات بين الضلوع)",
 "pleuronectes platessa": "بليس, سمك موسى (سمكة طعام أوروبية كبيرة)",
 "pleuropneumonia": "التهاب الجنبة والرئة, ذات الجنب والرئة (التهاب الجنبة والالتهاب الرئوي معاً)",
 "pleuropneumonialike organism": "كائن شبيه بالالتهاب الرئوي الجنبي (مفطورة مقاومة للمضادات الحيوية تسبب نوعاً من الالتهاب الرئوي لدى البشر)",
 "pleurothallis": "بلوروثاليس (أي من بساتين الفاكهة المعنقدة الصغيرة العديدة من جنس بلوروثاليس ذات أوراق جلدية إلى لحمية وعناقيد من زهرة واحدة إلى العديد من الزهور الصغيرة)",
 "pleurotus ostreatus": "فطر المحار (غاريقون صالح للأكل بقبعة رمادية ناعمة ينمو في كتل رفية على الخشب الميت)",
 "pleurotus phosphoreus": "غاريقون شجرة الزيتون (فطر أحمر مضيء في أوروبا)",
 "plexiglas": "بليكسي غلاس (بلاستيك حراري شفاف خفيف مقاوم للعوامل الجوية)",
 "plexiglass": "بليكسي غلاس (بلاستيك حراري شفاف خفيف مقاوم للعوامل الجوية)",
 "pleximeter": "مقرعة طبية (لوحة معدنية رقيقة صغيرة تُحمل ضد الجسم وتُضرب بمطرقة في الفحوصات الطبية بالقرع)",
 "pleximetry": "قرع (النقر على جزء من الجسم لأغراض التشخيص)",
 "plexor": "مطرقة المنعكسات, مطرقة طبية ((طب) مطرقة صغيرة برأس مطاطي تستخدم في فحوصات الطرق على الصدر واختبار ردود الفعل)",
 "plexus": "ضَفِيرَة",
 "plexus autonomici": "ضفيرة ذاتية (ضفيرة من الألياف العصبية الودية واللاودية)",
 "plexus brachialis": "ضفيرة عضدية (شبكة من الأعصاب تتكون من الأعصاب الشوكية العنقية والصدرية وتغذي الذراع وأجزاء من الكتف)",
 "plexus cardiacus": "ضفيرة قلبية (ضفيرة من الأعصاب تغذي القلب والهياكل المجاورة)",
 "plexus caroticus": "ضفيرة سباتية (ضفيرة من الأعصاب تحيط بالشريان السباتي الباطن)",
 "plexus celiacus": "ضفيرة زلاقية, ضفيرة شمسية (ضفيرة كبيرة من الأعصاب الودية في البطن خلف المعدة)",
 "plexus cervicalis": "ضفيرة عنقية (ضفيرة عصبية تقع تحت العضلة القصية الترقوية الخشائية)",
 "plexus choroideus": "ضفيرة مشيموية (ضفيرة وعائية في بطينات الدماغ تنظم الضغط داخل البطين)",
 "plexus coccygeus": "ضفيرة عصعصية (ضفيرة صغيرة تتكون من الأعصاب العجزية الخامسة والعصعصية)",
 "plexus dentalis": "ضفيرة سنية (ضفيرة من الأعصاب تخدم الأسنان)",
 "plexus hypogastricus": "ضفيرة خثلية (ضفيرة من الأعصاب تخدم أحشاء الحوض)",
 "plexus lumbalis": "ضفيرة قطنية (ضفيرة من الأعصاب تتكون من الفروع البطنية للأعصاب القطنية الأربعة الأولى) / ضفيرة قطنية (ضفيرة ليمفاوية تقع على طول الجزء السفلي من الأبهر والأوعية الحرقفية)",
 "plexus mesentericus": "ضفيرة مساريقية (ضفيرة من الأعصاب الذاتية)",
 "plexus myentericus": "ضفيرة عضلية معوية (ضفيرة من الألياف غير الميالينية وأجسام الخلايا الذاتية ما بعد العقدة في الغلاف العضلي للمريء والمعدة والأمعاء)",
 "plexus periarterialis": "ضفيرة حول الشريان (ضفيرة ذاتية ترافق الشريان)",
 "plexus pulmonalis": "ضفيرة رئوية (واحدة من ضفيرتين عصبيتين ذاتيتين في كل رئة)",
 "plexus sacralis": "ضفيرة عجزية (ضفيرة عصبية تتكون من الأعصاب القطنية الرابعة والخامسة والأعصاب العجزية الأولى والثانية والثالثة؛ تغذي منطقة الحوض والأطراف السفلية)",
 "pliability": "طواعية, ليونة (القدرة على التكيف في العقل أو الشخصية) / طواعية, قابلية الانحناء (خاصية سهولة الانحناء دون انكسار)\nمثال: كان مقدرًا لموثوقيته وطواعيته",
 "pliable": "طَيِّع, قَابِلٌ لِلثَّنْي (يُمْكِنُ ثَنْيُهُ أَوْ لَيُّهُ دُونَ أَنْ يَنْكَسِرَ) / طَيِّع, مَرِن (قَادِرٌ عَلَى التَّكَيُّفِ بِسُهُولَةٍ مَعَ ظُرُوفٍ مُخْتَلِفَةٍ) / طَيِّع, قَابِل لِلتَّشْكِيل (قابل للتشكيل أو الثني أو السحب) / سَهْل الانْقِيَاد, طَيِّع (قابل للقيادة أو التوجيه بسهولة)",
 "pliancy": "طواعية, ليونة (القدرة على التكيف في العقل أو الشخصية) / لدونة, ليونة (خاصية كون الشيء ليناً ومرناً)\nمثال: كان مقدرًا لموثوقيته وطواعيته",
 "pliant": "طَيِّع, قَابِلٌ لِلثَّنْي (يُمْكِنُ ثَنْيُهُ أَوْ لَيُّهُ دُونَ أَنْ يَنْكَسِرَ) / طَيِّع, مَرِن (قَادِرٌ عَلَى التَّكَيُّفِ بِسُهُولَةٍ مَعَ ظُرُوفٍ مُخْتَلِفَةٍ) / طَيِّع, قَابِل لِلتَّشْكِيل (قابل للتشكيل أو الثني أو السحب) / قَابِل لِلتَّشْكِيل, مَرِن (قابل للتأثير أو التشكيل)",
 "pliantness": "طواعية, ليونة (القدرة على التكيف في العقل أو الشخصية) / لدونة, ليونة (خاصية كون الشيء ليناً ومرناً)\nمثال: كان مقدرًا لموثوقيته وطواعيته",
