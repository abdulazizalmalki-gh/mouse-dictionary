 "kegful": "ملء برميل صغير (الكمية المحتواة في برميل صغير)",
 "kei apple": "تفاح كي, شجيرة تفاح كي (شجيرة شائكة قوية من جنوب أفريقيا تزرع لثمارها المستديرة الصفراء العصارية الصالحة للأكل)",
 "kei apple bush": "تفاح كي, شجيرة تفاح كي (شجيرة شائكة قوية من جنوب أفريقيا تزرع لثمارها المستديرة الصفراء العصارية الصالحة للأكل)",
 "keir": "كير",
 "keister": "أرداف, ألية (الجزء اللحمي من جسم الإنسان الذي يجلس عليه)\nمثال: يستحق ركلة جيدة في مؤخرته",
 "kekchi": "لغة كيكتشي (لغة مايانية يتحدث بها شعب كيكتشي) / كيكتشي (فرد من شعب ماياني في شمال وسط غواتيمالا)",
 "kekchi language": "لغة كيكتشي (لغة مايانية يتحدث بها شعب كيكتشي)",
 "kekule formula": "حلقة البنزين (سلسلة مغلقة من 6 ذرات كربون مع ذرات هيدروجين مرتبطة بها)",
 "kelantan": "كِلَنتَن",
 "keloid": "جدرة, ندبة متضخمة (نسيج ندبي وردي مرتفع في موقع إصابة؛ ينتج عن إصلاح الأنسجة المفرط)",
 "kelp": "عشب البحر, كيلب (أعشاب بحرية بنية كبيرة لها سعف جلدي متموج)",
 "kelp greenling": "جرينلينج عشب البحر (سمكة طعام ورياضة شائعة في الساحل الغربي لأمريكا الشمالية)",
 "kelpie": "كلب الراعي الأسترالي, كيلبي (كلب راعي أسترالي ذو آذان مدببة) / كيلبي ((فلكلور اسكتلندي) روح مائية على شكل حصان تحب إغراق راكبيها)",
 "kelpwort": "خريزة, شنان (نبات كثيف في المستنقعات المالحة وشواطئ البحر في العالم القديم ذو أوراق شائكة؛ يُحرق لإنتاج رماد الصودا الخام)",
 "kelpy": "كيلبي ((فلكلور اسكتلندي) روح مائية على شكل حصان تحب إغراق راكبيها)",
 "kelt": "سلتي, كلتي (فرد من شعب أوروبي سكن بريطانيا وإسبانيا والغال قبل العصر الروماني)",
 "kelter": "انتظام, حالة جيدة (في حالة صالحة للعمل)\nمثال: خارج عن الانتظام (معطل)",
 "kelvin": "كِلْفِن",
 "kelvin scale": "المقياس المطلق, مقياس كلفن (مقياس درجة حرارة يحدد الصفر المطلق عند 0 درجة)",
 "kemadrin": "بروسيكليدين (دواء (الاسم التجاري كيمادرين) يستخدم لتقليل الرعشات في مرض باركنسون)",
 "kemerovo": "كِيمِيرُوفُو",
 "kemi": "كيمي",
 "kempt": "مُرَتَّبُ الشَّعْر ((لِلشَّعْرِ) أَنِيقٌ وَمُنَظَّم)",
 "ken": "مدى الرؤية, مرمى البصر (نطاق الرؤية أو المعرفة) / مدارك, نطاق المعرفة (نطاق ما يمكن للمرء معرفته أو فهمه)\nمثال: بعيدًا عن مرأى اليابسة",
 "kenaf": "تيل, كيناف (نبات ليفي قيم من جزر الهند الشرقية واسع الانتشار الآن في الزراعة) / تيل, كنيف",
 "kenalog": "تريامسينولون (كورتيكوستيرويد اصطناعي يستخدم كعامل مضاد للالتهابات)",
 "kenan": "قِينَان",
 "kencur": "كينكور (جذمور مجفف أو شكله المسحوق، يستخدم في الطبخ في إندونيسيا)",
 "kendal": "أخضر كندال (صبغة خضراء، تستخدم غالباً لتلوين القماش، ويتم الحصول عليها من نبات الوسمة)",
 "kendal green": "أخضر كندال (صبغة خضراء، تستخدم غالباً لتلوين القماش، ويتم الحصول عليها من نبات الوسمة)",
 "kendall partial rank correlation": "ارتباط الرتب الجزئي لكندال (مقياس لامعلمي للارتباط الجزئي)",
 "kendall rank correlation": "ارتباط رتب كندال, تاو كندال (مقياس لامعلمي للاتفاق بين تصنيفين (ترتيبين))",
 "kendall test": "اختبار كندال (أي من المقاييس اللامعلمية للارتباط (تستخدم عندما لا تتحقق افتراضات تحليل الارتباط القياسي))",
 "kendall's tau": "ارتباط رتب كندال, تاو كندال (مقياس لامعلمي للاتفاق بين تصنيفين (ترتيبين))",
 "kennan": "جورج كينان, كينان (دبلوماسي أمريكي أوصى بسياسة الاحتواء في التعامل مع العدوان السوفيتي (1904-2005))",
 "kennedia coccinea": "كرمة المرجان, كينيديا كوكينيا (كرمة خشبية زاحفة أو متسلقة ذات أوراق جلدية صغيرة وعناقيد خيمية من الزهور الحمراء؛ موطنها أستراليا وتاسمانيا)",
 "kennedia prostrata": "ساعي البريد الجاري, كينيديا مفترشة (كرمة زاحفة مشعرة من غرب أستراليا ذات زهور وردية قرمزية زاهية)",
 "kennedy": "كِينِيدِي",
 "kennel": "وِجَار / بَيْت اَلْكَلْب (بمعنى قضى الليل؛ الخَيْمَة من الشَعْر يَبِيت فيها البَدَوي أو المُسافر. الجمع بُيُوت)\nمثال: لنعد إلى البيت.",
 "kenneth": "كِينِيث",
 "kenning": "كنية شعرية (اسم مجازي تقليدي لشيء ما، يستخدم بشكل خاص في الشعر الإنجليزي القديم والنرويجي القديم)",
 "keno": "بينغو, لوتو (لعبة يتم فيها سحب كرات مرقمة عشوائياً ويغطي اللاعبون الأرقام المقابلة على بطاقاتهم)",
 "kenogenesis": "تطور محدث, تكون مستحدث (إدخال صفات أو بنية أثناء التطور الجنيني لم تكن موجودة في التاريخ التطوري السابق للسلالة أو النوع (مثل إضافة المشيمة في تطور الثدييات))",
 "kenosis": "إخلاء الذات, كينوسيس (مفهوم إفراغ المرء لإرادته الخاصة واستقبال إرادة الله، في الكاثوليكية)",
 "kenotron": "كينوترون (نوع من الأنابيب المفرغة كان يستخدم سابقاً كمقوم للجهد العالي)",
 "kent": "كنت",
 "kentan": "زنبق النمر (نبات معمر شرق آسيوي له زهور برتقالية محمرة كبيرة منقطة بالأسود ببتلات منحنية للخلف)",
 "kentish": "الكنتية (لهجة من الإنجليزية الوسطى، كان يتم التحدث بها أصلاً في الجزء الجنوبي الشرقي من إنجلترا، بما في ذلك لندن وإسيكس) / الكنتية (لهجة جنوبية للإنجليزية القديمة، كان يتم التحدث بها في مملكة كنت الأنجلو ساكسونية)",
 "kentuckian": "كنتاكي (مواطن أو مقيم في كنتاكي)",
 "kentucky": "كِنْتَاكِي",
 "kentucky black bass": "قاروص كنتاكي الأسود (نوع من القاروص الأسود)",
 "kentucky blue": "عشبة كنتاكي الزرقاء, قبأ كنتاكي (عشبة مروج ومراعي قيمة في أوروبا وخاصة وسط الولايات المتحدة ذات سيقان طويلة وأوراق خضراء زاهية نحيلة؛ مكون رئيسي في مخاليط عشب المروج)",
 "kentucky bluegrass": "عشبة كنتاكي الزرقاء, قبأ كنتاكي (عشبة مروج ومراعي قيمة في أوروبا وخاصة وسط الولايات المتحدة ذات سيقان طويلة وأوراق خضراء زاهية نحيلة؛ مكون رئيسي في مخاليط عشب المروج)",
 "kentucky coffee tree": "بندق هندي, شجرة البن الكنتاكية (شجرة جميلة من وسط وشرق أمريكا الشمالية ذات أوراق كبيرة ثنائية الريش وأزهار خضراء بيضاء تليها قرون بنية خشبية كبيرة تستخدم بذورها كبديل للقهوة)",
 "kentucky derby": "ديربي كنتاكي (سباق سنوي للخيول بعمر ثلاث سنوات؛ يقام في تشرشل داونز في لويزفيل، كنتاكي)",
 "kentucky wonder": "فاصولياء كنتاكي (فاصولياء خضراء ذات قرون مسطحة)",
 "kentucky wonder bean": "فاصولياء كنتاكي (فاصولياء خضراء ذات قرون مسطحة)",
 "kentucky yellowwood": "خشب أصفر كنتاكي (شجرة نفضية صغيرة وسيمة مستديرة الرأس لها زهور بيضاء ملفتة للنظر في عناقيد طرفية وخشب صلب ثقيل ينتج صبغة صفراء)",
 "kentucy blue grass": "عشبة كنتاكي الزرقاء, قبأ كنتاكي (عشبة مروج ومراعي قيمة في أوروبا وخاصة وسط الولايات المتحدة ذات سيقان طويلة وأوراق خضراء زاهية نحيلة؛ مكون رئيسي في مخاليط عشب المروج)",
 "kenya": "كِينِيَا",
 "kenya fever": "حمى بوتونية, حمى مرسيليا (مرض تسببه الريكيتسيا وينتقل للبشر عن طريق القراد)",
 "kenyan": "كيني (من أو متعلق أو مميز لكينيا أو شعبها) / كِينِيّ (مواطن أو ساكن في كينيا)\nمثال: جبال كينية",
 "kenyan monetary unit": "وحدة نقدية كينية (الوحدة النقدية في كينيا)",
 "kenyan shilling": "شلن, شلن كيني (وحدة المال الأساسية في كينيا؛ تساوي 100 سنت)",
 "keogh plan": "خطة كيوغ (خطة تقاعد مؤجلة الضرائب لموظفي الشركات غير المدمجة أو للأفراد العاملين لحسابهم الخاص)",
 "kepi": "قبعة عسكرية, كيبي (قبعة ذات قمة دائرية مسطحة وحاجب)",
 "kepler's first law": "قانون كبلر الأول (قانون ينص على أن مدار كل كوكب هو قطع ناقص تقع الشمس في إحدى بؤرتيه)",
 "kepler's law": "قانون كبلر ((فلك) أحد ثلاثة قوانين تجريبية لحركة الكواكب وضعها يوهانس كبلر)",
 "kepler's law of planetary motion": "قانون كبلر ((فلك) أحد ثلاثة قوانين تجريبية لحركة الكواكب وضعها يوهانس كبلر)",
 "kepler's second law": "قانون المساحات, قانون كبلر الثاني (قانون يتعلق بالسرعة التي تسافر بها الكواكب؛ الخط الواصل بين الكوكب والشمس يمسح مساحات متساوية في أزمنة متساوية)\nمثال: يعني قانون كبلر الثاني أن السرعة المدارية للكوكب تتغير مع بعده عن الشمس",
 "kepler's third law": "القانون التوافقي, قانون كبلر الثالث (قانون ينص على أن نسبة مربع الفترة المدارية (بالسنوات) إلى مكعب المحور المداري (بالوحدات الفلكية) هي نفسها لجميع الكواكب)",
 "kept": "مَحْفُوظ, مُوفًى بِه ((خاصة للوعود أو العقود) لم يتم انتهاكه أو تجاهله)\nمثال: وعود محفوظة",
 "kept man": "عشيق مدعوم مالياً (رجل زانٍ؛ رجل لديه علاقة جنسية مستمرة خارج نطاق الزواج مع امرأة (تنفق عليه))",
 "kept woman": "عشيقة (امرأة زانية؛ امرأة تقيم علاقة جنسية مستمرة خارج نطاق الزواج مع رجل)",
 "kera": "كيرا (لغة تشادية يتم التحدث بها في تشاد)",
 "kera language": "كيرا (لغة تشادية يتم التحدث بها في تشاد)",
 "kerala": "كِيرَلَا",
 "keratalgia": "ألم القرنية (ألم في القرنية)",
 "keratectasia": "توسع القرنية (انتفاخ غير طبيعي لقرنية العين)",
 "keratin": "كيراتين",
 "keratinisation": "تقرن (عملية عضوية يتم فيها ترسيب الكيراتين في الخلايا وتصبح الخلايا قرنية (كما في الأظافر والشعر))",
 "keratinization": "تقرن (عملية عضوية يتم فيها ترسيب الكيراتين في الخلايا وتصبح الخلايا قرنية (كما في الأظافر والشعر))",
 "keratitis": "التهاب القرنية (التهاب القرنية يسبب دمع العين وألم وتشوش الرؤية)",
 "keratoacanthoma": "ورم شائكي ملتهب (ورم جلدي ينمو بسرعة (خاصة لدى كبار السن) ويشبه السرطانة ولكنه لا ينتشر؛ وعادة ما يختفي تلقائيًا، وغالبًا ما يترك ندبة)",
 "keratocele": "قيلة قرنية (فتق في القرنية)",
 "keratoconjunctivitis": "التهاب القرنية والملتحمة (التهاب القرنية والملتحمة)",
 "keratoconus": "القرنية المخروطية (بروز مخروطي غير طبيعي لقرنية العين؛ يمكن علاجه برأب القرنية الفوقي)",
 "keratoderma": "تقرن الجلد (أي اضطراب جلدي يتكون من نمو يبدو قرنياً)",
 "keratoderma blennorrhagica": "تقران سيلاني (مرض جلدي يتميز بطفح حرشفي على الراحتين والأخمصين؛ مرتبط بمتلازمة رايتر)",
 "keratodermia": "تقرن الجلد (أي اضطراب جلدي يتكون من نمو يبدو قرنياً)",
 "keratohyalin": "كيراتوهيالين (هيالين في الحبيبات الكبيرة للطبقة الحبيبية)",
 "keratoiritis": "التهاب القرنية والقزحية (التهاب القرنية وقزحية العين)",
 "keratomalacia": "تلين القرنية (تلين وجفاف وتقرح القرنية الناتج عن نقص فيتامين أ؛ عرض للتليف الكيسي أو الذرب)",
 "keratomycosis": "فطار قرني (عدوى فطرية في القرنية)",
 "keratonosis": "داء تقرني (أي حالة غير طبيعية للجلد الخارجي (البشرة))",
 "keratonosus": "اعتلال القرنية (أي مرض يصيب القرنية)",
 "keratoplasty": "رأب القرنية, زراعة القرنية (إجراء جراحي يتم فيه استبدال جزء أو كل القرنية التالفة أو المريضة بأنسجة قرنية سليمة من متبرع)",
 "keratoscleritis": "التهاب القرنية والصلبة (التهاب القرنية وصلبة العين)",
 "keratoscope": "منظار القرنية (أداة طبية لفحص القرنية من أجل الكشف عن المخالفات في سطحها الأمامي)",
 "keratoscopy": "تنظير القرنية (فحص القرنية بمنظار القرنية للكشف عن عدم الانتظام في سطحها الأمامي)",
 "keratosis": "تقرن (حالة جلدية تتميز بفرط نمو طبقات الجلد القرنية)",
 "keratosis blennorrhagica": "تقران سيلاني (مرض جلدي يتميز بطفح حرشفي على الراحتين والأخمصين؛ مرتبط بمتلازمة رايتر)",
 "keratosis follicularis": "تقران جريبي, داء دارييه (حالة وراثية نادرة تتميز ببقع قشرية داكنة (تحتوي أحيانًا على قيح))",
 "keratosis nigricans": "شواك أسود (مرض جلدي يتميز ببقع داكنة تشبه الثآليل في ثنايا الجسم)",
 "keratosis pilaris": "تقران شعري (تقران يتميز بارتفاعات مخروطية صلبة في فتحات الغدد الدهنية (خاصة في الذراعين والفخذين))",
 "keratotomy": "بضع القرنية (شق جراحي في القرنية)",
 "kerb": "حافة الرصيف (حافة بين الرصيف والطريق تتكون من خط من أحجار الرصيف (عادة ما تشكل جزءاً من المزراب))",
 "kerb crawler": "متحرش الطريق, متسكع بالسيارة (شخص يقود سيارته ببطء بجانب الرصيف بحثاً عن بائعات الهوى أو لمضايقة النساء)",
 "kerbstone": "حجر الرصيف (حجر رصف يشكل جزءاً من الرصيف)",
 "kerchief": "غِفَارَة, لِفَاع",
 "kerfuffle": "اضطراب, قلاقل (ثوران أو صخب غير منظم)\nمثال: لقد ذهلوا من الاضطراب العنيف الذي سببوه",
 "kerion": "شهدة (عدوى سعفة في بصيلات الشعر في فروة الرأس واللحية تؤدي عادةً إلى تورم مغطى ببثور وتنز سائلاً)",
 "kerite": "كيريت (مركب يُمزج فيه القطران أو الأسفلت بزيوت حيوانية أو نباتية ويُفلكن بالكبريت، ويشبه المنتج المطاط إلى حد كبير)\nمثال: كان الكيريت يستخدم سابقاً كمادة عازلة في التلغراف",
 "kermanshah": "كِرْمَانْشَاه",
 "kern": "بروز الحرف (جزء من الحرف المعدني الذي يبرز خارج جسمه)",
 "kernel": "نَوَاة",
 "kernicterus": "يرقان نووي (تراكم غير طبيعي لصبغة الصفراء في الدماغ والأنسجة العصبية الأخرى؛ يسبب تلوناً أصفر وتلفاً في الأنسجة)",
 "kernig's sign": "علامة كيرنيغ (عرض لالتهاب السحايا؛ لا يستطيع المريض تمديد الساق عند الركبة عندما يكون الفخذ مثنياً بسبب تيبس في أوتار الركبة)",
 "kernite": "كيرنيت (معدن ناعم خفيف يتكون من بورات الصوديوم المائية في شكل بلوري؛ مصدر مهم للبورون)",
 "kerosene": "كِيرُوسِين",
 "kerosene heater": "سخان كيروسين, مدفأة زيت (سخان يحرق الزيت (مثل الكيروسين) للتدفئة أو الطهي)",
 "kerosene lamp": "مصباح زيت, مصباح كيروسين (مصباح يحرق الزيت (مثل الكيروسين) للضوء)",
 "kerosine": "كاز, كيروسين (زيت هيدروكربوني قابل للاشتعال يستخدم كوقود في المصابيح والسخانات)",
 "kerosine heater": "سخان كيروسين, مدفأة زيت (سخان يحرق الزيت (مثل الكيروسين) للتدفئة أو الطهي)",
 "kerosine lamp": "مصباح زيت, مصباح كيروسين (مصباح يحرق الزيت (مثل الكيروسين) للضوء)",
 "kerr cell": "خلية كير (جهاز بصري يتكون من خلية شفافة بها قطبان كهربائيان بين وسطين مستقطبين؛ يمرر الضوء فقط إذا كان مستويا الاستقطاب متوازيين؛ يستخدم كمصراع عالي السرعة أو…)",
 "kerry blue terrier": "كيري بلو تيريير (سلالة أيرلندية من التيريير متوسط الحجم ذو فراء حريري أزرق رمادي)",
 "kerugma": "تبشير, كرازة (التبشير بإنجيل المسيح على طريقة الكنيسة الأولى)",
 "kerygma": "تبشير, كرازة (التبشير بإنجيل المسيح على طريقة الكنيسة الأولى)",
 "kestrel": "عوسق (صقر صغير من العالم القديم يحوم في الهواء ضد الريح) / عوسق أمريكي (صقر صغير من أمريكا الشمالية)",
 "ketalar": "كيتامين (مخدر عام ومهدئ (ليس من الباربيتورات) يعطى عن طريق الوريد أو العضل؛ يستخدم بشكل رئيسي من قبل الأطباء البيطريين أو للجراحة البسيطة للمرضى المسنين أو…)",
 "ketamine": "كيتامين (مخدر عام ومهدئ (ليس من الباربيتورات) يعطى عن طريق الوريد أو العضل؛ يستخدم بشكل رئيسي من قبل الأطباء البيطريين أو للجراحة البسيطة للمرضى المسنين أو…)",
 "ketamine hydrochloride": "كيتامين (مخدر عام ومهدئ (ليس من الباربيتورات) يعطى عن طريق الوريد أو العضل؛ يستخدم بشكل رئيسي من قبل الأطباء البيطريين أو للجراحة البسيطة للمرضى المسنين أو…)",
 "ketch": "كتش (سفينة شراعية بصاريتين؛ الصارية الخلفية تقع أمام عمود الدفة)",
 "ketchup": "عَصِير الْبَنْدُورَة, كَتْشَب (سائلٌ سُكَّريٌّ يُستخرج من بعض الثّمار عند عَصْرها)\nمثال: هل تريد عصير فاكهة؟",
 "ketchup bottle": "زجاجة كاتشب (زجاجة تحتوي على الكاتشب)",
 "keteleeria": "كيتيليريا (صنوبريات آسيوية تشبه الشوح)",
 "ketembilla": "عنب الثعلب السيلاني, كيتمبيلا (فاكهة تشبه عنب الثعلب أرجوانية كستنائية من الهند ذات لب أرجواني حامض حلو) / عنب الثعلب السيلاني, كيتمبيلا (شجرة شجيرية شائكة صغيرة تزرع لثمارها المارونية الأرجوانية ذات اللب الأرجواني الحلو الذي طعمه مثل عنب الثعلب؛ سريلانكا والهند)",
 "ketembilla tree": "عنب الثعلب السيلاني, كيتمبيلا (شجرة شجيرية شائكة صغيرة تزرع لثمارها المارونية الأرجوانية ذات اللب الأرجواني الحلو الذي طعمه مثل عنب الثعلب؛ سريلانكا والهند)",
 "ketoacidosis": "حماض كيتوني (حماض مع تراكم أجسام كيتونية؛ يحدث في المقام الأول في داء السكري)",
 "ketoacidosis-prone diabetes": "السكري المعتمد على الأنسولين, السكري من النوع الأول (داء سكري شديد يظهر مبكرًا؛ يتميز بكثرة التبول والعطش الشديد وزيادة الشهية وفقدان الوزن والحماض الكيتوني العرضي؛ يتطلب النظام الغذائي وحقن الأنسولين…)",
 "ketoacidosis-resistant diabetes": "السكري غير المعتمد على الأنسولين, السكري من النوع الثاني (شكل خفيف من داء السكري يتطور تدريجيًا لدى البالغين؛ يمكن أن يحدث بسبب السمنة أو الإجهاد الشديد أو انقطاع الطمث أو عوامل أخرى؛ يمكن السيطرة عليه عادة…)",
 "ketoacidosis-resistant diabetes mellitus": "السكري غير المعتمد على الأنسولين, السكري من النوع الثاني (شكل خفيف من داء السكري يتطور تدريجيًا لدى البالغين؛ يمكن أن يحدث بسبب السمنة أو الإجهاد الشديد أو انقطاع الطمث أو عوامل أخرى؛ يمكن السيطرة عليه عادة…)",
 "ketoaciduria": "بيلة كيتونية (كميات مفرطة من الأجسام الكيتونية في البول كما في داء السكري أو الجوع)",
 "ketoconazole": "كيتوكونازول",
 "ketoheptose": "كيتوهبتوز (سكر سباعي الكربون يمتلك مجموعة كيتون)",
 "ketohexose": "كيتوهكسوز (سكر أحادي يحتوي على ست ذرات كربون ومجموعة كيتون)",
 "ketone": "كيتون (أي من فئة المركبات العضوية التي تحتوي على مجموعة كربونيل مرتبطة بذرة كربون في كل من شقين هيدروكربونيين)",
 "ketone body": "جسم أسيتوني, جسم كيتوني (كيتون وهو منتج وسيط لتحلل الدهون في الجسم؛ أي من ثلاثة مركبات توجد بزيادة في دم وبول الأشخاص الذين يعانون من اضطرابات التمثيل الغذائي)",
 "ketone group": "مجموعة كيتون (مجموعة تمتلك الخصائص المميزة للكيتونات)",
 "ketonemia": "فرط كيتون الجسم, كيتونية الدم (زيادة غير طبيعية في الأجسام الكيتونية في الدم كما في داء السكري)",
 "ketonuria": "بيلة كيتونية (كميات مفرطة من الأجسام الكيتونية في البول كما في داء السكري أو الجوع)",
 "ketoprofen": "أوروديس, كيتوبروفين (دواء مضاد للالتهاب غير ستيرويدي (الأسماء التجارية أوروديس وغيرها))",
 "ketorolac": "أكولار, كيتورولاك تروميثامين (دواء مضاد للالتهاب غير ستيرويدي (الأسماء التجارية أكولار وغيرها) يعطى في العضل فقط)",
 "ketorolac tromethamine": "أكولار, كيتورولاك تروميثامين (دواء مضاد للالتهاب غير ستيرويدي (الأسماء التجارية أكولار وغيرها) يعطى في العضل فقط)",
 "ketose": "كيتوز (أي سكر أحادي يحتوي على مجموعة كيتون)",
 "ketosis": "فرط كيتون الجسم, كيتونية الدم (زيادة غير طبيعية في الأجسام الكيتونية في الدم كما في داء السكري)",
 "ketosis-prone diabetes": "السكري المعتمد على الأنسولين, السكري من النوع الأول (داء سكري شديد يظهر مبكرًا؛ يتميز بكثرة التبول والعطش الشديد وزيادة الشهية وفقدان الوزن والحماض الكيتوني العرضي؛ يتطلب النظام الغذائي وحقن الأنسولين…)",
 "ketosis-resistant diabetes": "السكري غير المعتمد على الأنسولين, السكري من النوع الثاني (شكل خفيف من داء السكري يتطور تدريجيًا لدى البالغين؛ يمكن أن يحدث بسبب السمنة أو الإجهاد الشديد أو انقطاع الطمث أو عوامل أخرى؛ يمكن السيطرة عليه عادة…)",
 "ketosis-resistant diabetes mellitus": "السكري غير المعتمد على الأنسولين, السكري من النوع الثاني (شكل خفيف من داء السكري يتطور تدريجيًا لدى البالغين؛ يمكن أن يحدث بسبب السمنة أو الإجهاد الشديد أو انقطاع الطمث أو عوامل أخرى؛ يمكن السيطرة عليه عادة…)",
 "ketosteroid": "كيتوستيرويد (ستيرويد يحتوي على مجموعة كيتون)",
 "ketotetrose": "كيتوتتروز (سكر أحادي يحتوي على مجموعة كيتون وأربع ذرات كربون)",
 "ketotriose": "كيتوتريوز (أي كيتوز يحتوي على ثلاث ذرات كربون؛ في الواقع هو ثنائي هيدروكسي أسيتون فقط)",
 "kettle": "غَلَّايَة",
 "kettle hole": "حفرة غلاجلية, كتل ((جيولوجيا) تجويف (غالباً ما تملأه بحيرة) ينتج عن ذوبان كتلة من الجليد المحاصر في الرواسب الجليدية)",
 "kettle of fish": "حيص بيص, مأزق (مصطلحات غير رسمية لموقف صعب)\nمثال: وقع في ورطة رهيبة",
 "kettledrum": "تيمباني, طبلة نحاسية (آلة إيقاعية نحاسية أو نحاسية كبيرة نصف كروية ذات رأس طبل يمكن ضبطه عن طريق تعديل الشد عليه)",
 "kettleful": "ملء غلاية (الكمية التي تستوعبها غلاية)",
 "keurboom": "فيرجيليا, كيربوم (شجرة ذات أوراق ريشية فردية وعناقيد من الزهور العطرة الوردية إلى الأرجوانية) / فيرجيليا متباعدة, كيربوم (شجرة سريعة النمو مستديرة الرأس ذات زهور بيضاء عطرة إلى زهرية داكنة؛ تزرع للزينة)",
 "kevin": "كِيفِن",
 "kevlar": "كِيفْلَار",
 "key": "زِرّ",
 "key fob": "تعليقة مفاتيح, ميدالية مفاتيح (جسم صغير مثبت بسلسلة مفاتيح أو حلقة مفاتيح ومصمم ليسهل إمساكه بشكل مريح)",
 "key fruit": "ثمرة جناحية, جناحية (فاكهة مجنحة غالباً ما تكون ذات بذرة واحدة غير متفتحة كما في الدردار أو القيقب)",
 "key lime": "ليم كي, ليمون مكسيكي (ليم أصفر مخضر صغير من جنوب فلوريدا)",
 "key palm": "بالميتو فضي, نخيل المفتاح (نخيل مروحي ممتلئ الجسم صغير من جنوب فلوريدا وكوبا)",
 "key pattern": "تعشيق هندسي, مفتاح إغريقي (نمط زخرفي يتكون من خطوط عمودية وأفقية متكررة (غالباً بشكل بارز))\nمثال: كان هناك تعشيق هندسي بسيط في أعلى الجدران",
 "key ring": "حلقة المفاتيح (حلقة دائرية من المعدن لحمل المفاتيح)",
 "key signature": "توقيع المفتاح, دليل المفتاح (علامات الرفع (الدييز) أو الخفض (البيمول) التي تتبع المفتاح وتشير إلى السلم الموسيقي)",
 "key stroke": "ضربة مفتاح (ضربة مفتاح؛ ضغطة واحدة على مفتاح في لوحة المفاتيح)\nمثال: تم استخدام عدد ضربات المفاتيح كمقياس للعمل",
 "key word": "كلمة مفتاحية (كلمة مهمة تستخدم في الفهرسة أو التصنيف) / كلمة مفتاحية (كلمة تستخدم كنمط لفك تشفير رسالة مشفرة)",
 "keyboard": "لَوْحَةُ مَفَاتِيح",
 "keyboard buffer": "مخزن لوحة المفاتيح (ذاكرة مؤقتة تتعقب ضربات المفاتيح حتى يصبح الحاسوب جاهزاً للاستجابة لها)",
 "keyboard instrument": "آلة مفاتيح (آلة موسيقية يتم العزف عليها بواسطة لوحة مفاتيح)",
 "keyboard layout": "تَخْطِيطُ لَوْحَةُ الْمَفَاتِيح (مصدر من خَطَّطَ؛ في : فكرةٌ مُثبتة بالرسم، أو الكتابة في حالة الخطّ. تدلّ دلالةً تامَّة على ما يُقصد في الصُّورة أو الرسم أَو اللَّوح المكتوب من المعنى والموضوع…)\nمثال: يعمل في قسم التخطيط.",
 "keyboard shelf": "درج لوحة المفاتيح, رف لوحة المفاتيح (درج منزلق يعد جزءاً من مكتب الحاسوب، يستخدم لحمل لوحة المفاتيح)",
 "keyboard tray": "درج لوحة المفاتيح, رف لوحة المفاتيح (درج منزلق يعد جزءاً من مكتب الحاسوب، يستخدم لحمل لوحة المفاتيح)",
 "keyboardist": "عازف لوحة مفاتيح, كييبورديست (موسيقي يعزف على آلة ذات لوحة مفاتيح)",
 "keycard": "بطاقة دخول, بطاقة مفتاحية (بطاقة بلاستيكية تحتوي على شريط مشفر مغناطيسياً يتم مسحه ضوئياً لتشغيل آلية ما)",
 "keychain": "حَمَّالَة مَفَاتِيح",
 "keyed": "بمفتاح, مفتاحي (مجهز بـأو مؤمن بمفتاح) / مُلَحَّن, مُنَغَّم (مضبوط على مقام أو نغمة معينة)\nمثال: آلة ذات مفاتيح",
 "keyfob": "تعليقة مفاتيح, ميدالية مفاتيح (جسم صغير مثبت بسلسلة مفاتيح أو حلقة مفاتيح ومصمم ليسهل إمساكه بشكل مريح)",
 "keyhole": "ثقب المفتاح (الثقب الذي يتم إدخال المفتاح فيه)",
 "keyhole limpet": "بطلينوس ثقب المفتاح (بطلينوس بحري له صدفة مخروطية مع فتحة في القمة)",
 "keyhole neck": "فتحة رقبة مفتاحية الشكل (خط عنق يشكل ثقباً أسفل عظام الترقوة)",
 "keyhole neckline": "فتحة رقبة مفتاحية الشكل (خط عنق يشكل ثقباً أسفل عظام الترقوة)",
 "keyhole saw": "منشار ثقوب المفاتيح (منشار يدوي بنصل ضيق طويل لقطع منحنيات نصف قطرها قصير؛ يشبه منشار المنحنيات)",
 "keyless": "بلا مفتاح (يفتقر أو لا يحتاج إلى مفتاح)\nمثال: قفل بلا مفتاح يعمل بواسطة سلسلة من الأزرار",
 "keynesian": "كِنْزِيٌّ",
 "keynesianism": "كِنْزِيَّةٌ",
 "keynote": "فكرة رئيسية, محور (فكرة أساسية أو مركزية) / قرار, نغمة الأساس ((موسيقى) النغمة الأولى في سلم دياتوني) / فِكْرَة رَئِيسِيَّة, مِحْوَر أَسَاسِيّ (الموضوع الرئيسي في خطاب أو عمل أدبي)",
 "keynote address": "خطاب افتتاحي, كلمة رئيسية (خطاب يحدد الموضوع الرئيسي)",
 "keynote speech": "خطاب افتتاحي, كلمة رئيسية (خطاب يحدد الموضوع الرئيسي)",
 "keypad": "لوحة مفاتيح حاسوب (لوحة مفاتيح تعد جهاز إدخال بيانات للحواسيب؛ ترتيب المفاتيح مصمم على غرار لوحة مفاتيح الآلة الكاتبة)",
 "keystone": "حجر العقد (حَجَرَ عليه الأمرَ:مَنَعَه منه ، حجر الشّيء على نفسه:خَصَّها به وقصره عليها؛ الحجْرُ: المَنْعُ مِن التَّصَرُّفِ ، وحَجَرَ عَلَيْهِ القاضِي يَحْجُرُ حَجْراً، إِذا مَنَعَه مِن التَّصَرُّفِ فِي مالِه)\nمثال: عوقب زيري بالحجر.",
 "keystone stater": "بنسلفاني (مواطن أو مقيم في بنسلفانيا)",
