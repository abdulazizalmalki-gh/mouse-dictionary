 "kiley": "بوميرانغ, كايلي (بوميرانغ أسترالي؛ أحد جانبيه مسطح والآخر محدب)",
 "kilgore": "كِيلْغُور",
 "kilimanjaro": "كليمنجارو",
 "kiliwa": "لغة كيليوا (اللغة اليومية التي يتحدث بها شعب كيليوا) / كيليوا (فرد من شعب هندي في أمريكا الشمالية يعيش في شمال باجا كاليفورنيا)",
 "kiliwa language": "لغة كيليوا (اللغة اليومية التي يتحدث بها شعب كيليوا)",
 "kiliwi": "لغة كيليوا (اللغة اليومية التي يتحدث بها شعب كيليوا) / كيليوا (فرد من شعب هندي في أمريكا الشمالية يعيش في شمال باجا كاليفورنيا)",
 "kiliwi language": "لغة كيليوا (اللغة اليومية التي يتحدث بها شعب كيليوا)",
 "kill": "قَتَلَ, قتل (تعمّد جعله يَمُوتُ، أزهق روحه، أمَاتَه متعمدا؛ الوقتَ: ضيعه بشيء غير ذي فائدة وهو ينتظر أمرا آخر) / قَتْلَة\nمثال: قتل الصياد دبا.",
 "kill two birds with one stone": "اِصْطَادَ عُصْفُورَيْن بِحَجَر وَاحِد",
 "kill zone": "منطقة قتل (منطقة وقعت فيها معركة مع العديد من الوفيات)",
 "killable": "صَالِحٌ لِلذَّبْح (مناسب للذبح خاصة لأغراض الطعام)",
 "killarney fern": "سرخس كيلارني (سرخس قوي كبير في أقصى غرب أوروبا)",
 "killdeer": "زقزاق صياح (زقزاق أمريكي يعيش في المياه الداخلية والحقول وله صرخة مميزة)",
 "killdeer plover": "زقزاق صياح (زقزاق أمريكي يعيش في المياه الداخلية والحقول وله صرخة مميزة)",
 "killer": "قَاتِل (اسم فاعل من الفعل قَتَلَ، الذي قَامَ بالقَتْل. الجمع قَاتِلُون؛ المُجْرِم الذي يقتل بلا حَقّ. الجمع قتلة) / قَاتِلَة (مؤنث قَاتِل)\nمثال: بيتي قاتلة أمك.",
 "killer bee": "نحل أفريقي, نحل قاتل (سلالة من النحل نشأت في البرازيل في الخمسينيات كتهجين بين نحل أفريقي عدواني ونحل عسل؛ تحتفظ بمعظم سمات النحل الأفريقي) / المصرفي المدافع, النحلة القاتلة (مصرفي استثماري يبتكر استراتيجيات لجعل الشركة المستهدفة أقل جاذبية للاستحواذ)",
 "killer cell": "خلية تائية سامة للخلايا, خلية تائية قاتلة",
 "killer t cell": "خلية تائية سامة للخلايا, خلية تائية قاتلة",
 "killer whale": "حُوت قَاتِل (سمكة صَغيرة كانت أو كبيرة؛ حوت كبير: صاحب مال وسَطْوَة ونفوذ)\nمثال: هل الحوت من الثدييات؟",
 "killifish": "كيلي فيش (أسماك صغيرة تعيش في أسراب تشبه الشبوط وتعيش في المياه الدافئة البحرية غالباً؛ تستخدم كطعم أو أسماك أحواض أو في مكافحة البعوض)",
 "killing": "مُمِيت, قَاتِل / قَتْل (تعمّد جعله يَمُوتُ، أزهق روحه، أمَاتَه متعمدا؛ الوقتَ: ضيعه بشيء غير ذي فائدة وهو ينتظر أمرا آخر)\nمثال: قتل الصياد دبا.",
 "killing field": "حقل قتل ((عادة بالجمع) منطقة مات فيها العديد من الأشخاص (عادة عن طريق المذابح أو الإبادة الجماعية أثناء الحرب أو الاضطرابات المدنية العنيفة))",
 "killing zone": "منطقة قتل (منطقة وقعت فيها معركة مع العديد من الوفيات)",
 "killingly": "بشكل مضحك جداً (بطريقة فكاهية للغاية)",
 "killjoy": "ثقيل الظل, مفسد البهجة (شخص يفسد متعة الآخرين)",
 "kiln": "فُرْن",
 "kiln-dried": "مُجَفَّف فِي فُرْن (جُفِّف في فرن حراريّ)",
 "kilo": "كِيلُو",
 "kilobit": "كيلوبت (وحدة معلومات تساوي 1000 بت)",
 "kilobyte": "كِيلُوبَايْت",
 "kilocalorie": "سُعر غذائي, سُعر كبير (وحدة حرارة تساوي كمية الحرارة اللازمة لرفع درجة حرارة كيلوغرام واحد من الماء درجة واحدة؛ يستخدمها خبراء التغذية لتوصيف طاقة الغذاء)",
 "kilocycle": "كِيلُوهَرْتز (ألف دورة في الثانية)",
 "kilocycle per second": "كِيلُوهَرْتز (ألف دورة في الثانية)",
 "kilogram": "كِيلوغْرَام, كِيلوجْرَام",
 "kilogram calorie": "سُعر غذائي, سُعر كبير (وحدة حرارة تساوي كمية الحرارة اللازمة لرفع درجة حرارة كيلوغرام واحد من الماء درجة واحدة؛ يستخدمها خبراء التغذية لتوصيف طاقة الغذاء)",
 "kilogram-meter": "كيلوغرام-متر (وحدة شغل تساوي الشغل المبذول بواسطة قوة كيلوغرام واحد تعمل خلال مسافة متر واحد)",
 "kilohertz": "كِيلُوهَرْتز (ألف دورة في الثانية)",
 "kilojoule": "كِيلُوجُول",
 "kiloliter": "كيلولتر, متر مكعب (وحدة مترية للحجم أو السعة تساوي 1000 لتر)",
 "kilolitre": "كيلولتر, متر مكعب (وحدة مترية للحجم أو السعة تساوي 1000 لتر)",
 "kilometer": "كيلومتر (وحدة مترية للطول تساوي 1000 متر)",
 "kilometers per hour": "كِيلُومِتْر فِي السَّاعَة (نسبة المسافة المقطوعة (بالكيلومترات) إلى الوقت المستغرق في السفر (بالساعات))",
 "kilometers per second": "كِيلُومِتْر فِي الثَّانِيَة (نسبة المسافة المقطوعة (بالكيلومترات) إلى الوقت المستغرق في السفر (بالثواني))\nمثال: يسافر الضوء في الفراغ بسرعة تبلغ حوالي 300,000 كيلومتر في الثانية",
 "kilometrage": "المسافة المقطوعة (عدد الكيلومترات التي تقطعها مركبة)\nمثال: أتوقع أن تتداعى هذه السيارة، بالنظر إلى المسافة التي قطعتها",
 "kilometre": "كيلومتر",
 "kilometres per hour": "كِيلُومِتْر فِي السَّاعَة (نسبة المسافة المقطوعة (بالكيلومترات) إلى الوقت المستغرق في السفر (بالساعات))",
 "kilometres per second": "كِيلُومِتْر فِي الثَّانِيَة (نسبة المسافة المقطوعة (بالكيلومترات) إلى الوقت المستغرق في السفر (بالثواني))\nمثال: يسافر الضوء في الفراغ بسرعة تبلغ حوالي 300,000 كيلومتر في الثانية",
 "kiloton": "كيلو طن (مقياس للقوة التفجيرية (لسلاح نووي) يساوي قوة 1000 طن من مادة تي إن تي) / كيلو طن",
 "kilovolt": "كيلوفولت (وحدة للجهد تساوي ألف فولت)",
 "kilovolt-ampere": "كيلوفولت-أمبير (وحدة للقدرة الكهربائية تساوي 1000 فولت-أمبير)",
 "kilowatt": "كيلوواط (وحدة للقدرة تساوي 1000 واط)",
 "kilowatt hour": "كيلوواط ساعي (وحدة طاقة تساوي الشغل المبذول بقدرة 1000 واط تعمل لمدة ساعة واحدة)",
 "kilt": "إزار اسكتلندي, كيلت (تنورة ترتان ذات طيات تصل للركبة يرتديها الرجال كجزء من الزي التقليدي في مرتفعات شمال اسكتلندا)",
 "kilter": "انتظام, حالة جيدة (في حالة صالحة للعمل)\nمثال: خارج عن الانتظام (معطل)",
 "kim": "كِيم",
 "kimberlite": "كيمبرليت (نوع نادر من البيريدوتيت يحتوي أحياناً على الألماس؛ يوجد في جنوب إفريقيا وسيبيريا)",
 "kimono": "كِيمُونُو",
 "kin": "أَهْل, أَقَارِب (أَهِلَ به يَأْهَلُ أَهَلاً: أنِس، فهو أَهِلٌ)\nمثال: أهل أبدو أنيقا؟",
 "kin group": "عشيرة, قبيلة (مجموعة من الناس يرتبطون بالدم أو الزواج)",
 "kina": "كينا (وحدة المال الأساسية في بابوا غينيا الجديدة)",
 "kinaesthesia": "إحساس حركي, حاسة العضلات (القدرة على الشعور بحركات الأطراف والجسم) / إحساس حركي, شعور بالحركة (إدراك وضعية الجسم وحركته وتوترات العضلات وما إلى ذلك)",
 "kinaesthesis": "إحساس حركي, حاسة العضلات (القدرة على الشعور بحركات الأطراف والجسم)",
 "kinaesthetic": "حركي, حسي حركي (متعلق بالحس الحركي (الإحساس بحركة الجسم))",
 "kinaesthetically": "حركياً (بطريقة حركية؛ عن طريق الحس الحركي)\nمثال: يمكنه إدراك الأشكال حركياً",
 "kinanesthesia": "فقدان الحس الحركي (عدم القدرة على استشعار الحركة)",
 "kinase": "كيناز (إنزيم يحفز تحويل طليعة الإنزيم إلى إنزيم نشط)",
 "kind": "نوع (صِنْف؛ في : وحدة تصنيفية أقل من الجنس) / حَنُون, لَطِيف\nمثال: انه نوع من الفطر.",
 "kind of": "إلى حد ما, نسبياً (إلى حد (كبير أو صغير) ما)\nمثال: كان الجو بارداً نوعاً ما",
 "kind-hearted": "حَنُون بِالفِطْرَة, طَيِّب القَلْب (ذو طبع فطري طيّب وحنون)",
 "kind-heartedness": "طيبة قلب (تعاطف نابع من قلب طيب)",
 "kinda": "إلى حد ما, نسبياً (إلى حد (كبير أو صغير) ما)\nمثال: كان الجو بارداً نوعاً ما",
 "kindergarten": "رَوْضَة, رَوْضَة أَطْفَال",
 "kindergartener": "طفل ما قبل المدرسة (طفل يرتاد حضانة أو روضة أطفال)",
 "kindergartner": "طفل ما قبل المدرسة (طفل يرتاد حضانة أو روضة أطفال)",
 "kindhearted": "رَقِيق, شَفُوق (نحيف وخفيف الوزن؛ لين وناعم الملمس، يمكن ثنيه بسهولة)\nمثال: لدى بتي صوت رقيق.",
 "kindheartedness": "طيبة قلب (تعاطف نابع من قلب طيب)",
 "kindjal": "خنجر القوقاز, كيندجال (نوع من السيوف القصيرة أو الخناجر ذات نصل منحني قليلاً، نشأ غالباً في الشيشان)\nمثال: عادة ما كان القوزاق الروس يحملون خناجر الكيندجال كسلاح مميز لهم",
 "kindle": "شَعَّلَ (شَعَلَ يَشْعُلُ: شَعْلاً؛ شعلت النار: اشتعلت، اتقدت)\nمثال: القبائل هم أول من حمل شعلة اللغة الأمازيغية.",
 "kindled": "مُضْرَم, مُوقَد (أُشعلت فيه النار)",
 "kindliness": "حب المساعدة, طيبة (ود يتضح من خلال طبع طيب ومحب للمساعدة)",
 "kindling": "إشعال, إضرام (عملية إضرام النار في شيء ما) / صوفان, قشاشة (مادة لبدء إشعال النار)",
 "kindly": "برفق, بلطف (بطريقة لطيفة أو نابعة من اللطف) / لَطِيف, مُسْتَحَبّ (ممتع ومقبول) / خَيِّر, طَيِّب القَلْب (يُظهر التعاطف والتفهّم والسخاء أو مدفوع بها)\nمثال: تحدث بلطف مع الصبي",
 "kindness": "إِحْسَان",
 "kindred": "ذُو قُرْبَى (مرتبط بصلة الدم أو المصاهرة) / قَرِيبُ الشَّبَه, مُتَقَارِب (متشابه في النوعيّة أو الطابع) / عشيرة, قبيلة (مجموعة من الناس يرتبطون بالدم أو الزواج)",
 "kine": "أبقار, ماشية (الحيوانات البقرية المستأنسة كمجموعة بغض النظر عن الجنس أو العمر)\nمثال: عدد كبير من رؤوس الماشية",
 "kinematics": "علم الحركة المجردة, كينماتيكا (فرع الميكانيكا المعني بالحركة دون الإشارة إلى القوة أو الكتلة)",
 "kinescope": "أنبوب الصورة, كينسكوب (أنبوب أشعة الكاثود في جهاز استقبال التلفزيون؛ يترجم الإشارة المستلمة إلى صورة على شاشة مضيئة)",
 "kinesiology": "علم الحركة (فرع علم وظائف الأعضاء الذي يدرس الميكانيكا والتشريح فيما يتعلق بحركة الإنسان)",
 "kinesis": "حركة غير موجهة, كاينسيس (حركة تكون استجابة لمحفز ولكنها غير موجهة بالنسبة لمصدر التحفيز)",
 "kinesthesia": "إحساس حركي, حاسة العضلات (القدرة على الشعور بحركات الأطراف والجسم) / إحساس حركي, شعور بالحركة (إدراك وضعية الجسم وحركته وتوترات العضلات وما إلى ذلك)",
 "kinesthesis": "إحساس حركي, حاسة العضلات (القدرة على الشعور بحركات الأطراف والجسم)",
 "kinesthetic": "حركي, حسي حركي (متعلق بالحس الحركي (الإحساس بحركة الجسم))",
 "kinesthetically": "حركياً (بطريقة حركية؛ عن طريق الحس الحركي)\nمثال: يمكنه إدراك الأشكال حركياً",
 "kinesthetics": "إحساس حركي, حاسة العضلات (القدرة على الشعور بحركات الأطراف والجسم)",
 "kinetic": "حَرَكِيّ",
 "kinetic energy": "طَاقَة حَرَكِيَّة (القُدْرَة والشِدَّة؛ هي مقدار ما يمكن للإنسان أن يفعله بمشقة، كأن قدرته محددة بطَوْق)\nمثال: طلب بطاقة اعتماد.",
 "kinetic theory": "نظرية حركية, نظرية حركية للغازات ((فيزياء) نظرية تفيد بأن الغازات تتكون من جزيئات صغيرة في حركة عشوائية)",
 "kinetic theory of gases": "نظرية حركية, نظرية حركية للغازات ((فيزياء) نظرية تفيد بأن الغازات تتكون من جزيئات صغيرة في حركة عشوائية)",
 "kinetic theory of heat": "النظرية الحركية للحرارة (نظرية تفيد بأن درجة حرارة الجسم تزداد بزيادة الطاقة الحركية)",
 "kinetics": "ديناميكا, علم الحركة (فرع الميكانيكا المعني بالقوى التي تسبب حركة الأجسام)",
 "kinetochore": "سِنْترومِير, قَسِيم مَرْكَزِيّ\nمثال: من الصعب تحديد تسلسل القسيم المركزي",
 "kinetoscope": "كينتوسكوب (جهاز اخترعه إديسون يعطي انطباعاً بالحركة حيث يتحرك شريط لا نهائي من الفيلم بشكل مستمر فوق مصدر ضوء مع مصراع سريع؛ وهو سلف السينما الحديثة)",
 "kinetosis": "داء الحركة, دوار الحركة (حالة الشعور بالدوار أو الغثيان بسبب الحركات التي تحدث أثناء السفر في أو على مركبة متحركة)",
 "kinfolk": "آل, أسرة ممتدة (أشخاص ينحدرون من سلف مشترك)\nمثال: عاش أهله في ماساتشوستس منذ سفينة ماي فلاور",
 "king": "مَلِك, شاه (لغة في المَالِك، وهو الذي يَمْلِكُ؛ السُلْطَان الحَاكِم الذي يملك الأَرْض والبِلاد) / مَلِك (لغة في المَالِك، وهو الذي يَمْلِكُ؛ السُلْطَان الحَاكِم الذي يملك الأَرْض والبِلاد)\nمثال: زيري ملك لنفسه.",
 "king arthur": "اَلمَلِك آرثر",
 "king begonia": "بيغونيا الملك, بيغونيا ريكس (أي من العديد من البيغونيا الهجينة الجذمورية عادةً المشتقة من نبات من جزر الهند الشرقية، لها أوراق خشنة الملمس منقوشة بالفضة والبرونز والأرجواني…)",
 "king cake": "كَعْكَة عِيد الغَطَّاس (واحدة الكَعْك؛ حَلْوَى تُصْنع من الدَقِيق والحَلِيب والسُكَّر والزَيت ويخبز طريًا وقد يوضع عليه القِشْطَة. يُسمى عند البعض كَيْك وعند البعض تُورْتَة)\nمثال: خبزت كعكة لتوم.",
 "king charles spaniel": "سبانييل الملك شارل (سبانييل إنجليزي لعبة بمعطف أسود وأسمر؛ سمي تيمناً بتشارلز الثاني الذي جعله مشهوراً)",
 "king cobra": "كوبرا ملك (كوبرا كبيرة من جنوب شرق آسيا وجزر الهند الشرقية؛ أكبر ثعبان سام؛ توضع أحياناً في جنس ناجا)",
 "king crab": "سرطان حدوة الحصان, سلطعون حدوة الحصان (مفصلي بحري كبير من ساحل المحيط الأطلسي لأمريكا الشمالية له درقة مقببة تشبه حدوة الحصان وذيل مدبب صلب) / سرطان الملك (سرطان كبير صالح للأكل من مياه شمال المحيط الهادئ وخاصة على طول سواحل ألاسكا واليابان) / سلطعون العنكبوت الأوروبي (سلطعون عنكبوت كبير من أوروبا) / سلطعون الملك الألاسكي (لحم سلطعون مياه باردة كبير؛ لحم الأرجل بشكل أساسي)",
 "king devil": "حشيشة الغراب الصفراء (حشيشة الغراب الأوروبية التي أدخلت إلى شمال شرق الولايات المتحدة؛ أعشاب ضارة مزعجة محلياً)",
 "king fern": "أسمندة ملكية, سرخس ملكي (سرخس كبير عميق الجذور واسع الانتشار عالمياً بسعف مركب ثنائي الريش منتصب) / توديا, سرخس الملك (سرخس الغابات المطيرة في أستراليا الاستوائية ونيوزيلندا وجنوب إفريقيا)",
 "king kong": "كِينْغ كُونْغ",
 "king mackerel": "كافالا, ماكريل الملك (ماكريل كبير ذو خطم مدبب طويل؛ سمكة طعام وصيد مهمة في ساحل المحيط الأطلسي الشرقي جنوباً إلى البرازيل)",
 "king nut": "جوز القشرة الكبيرة, جوز الملك (جوز من شرق الولايات المتحدة يشبه الجوز أشعث اللحاء ولكن له جوزة أكبر بكثير)",
 "king nut hickory": "جوز القشرة الكبيرة, جوز الملك (جوز من شرق الولايات المتحدة يشبه الجوز أشعث اللحاء ولكن له جوزة أكبر بكثير)",
 "king of beasts": "مَلِك الوُحُوش (لغة في المَالِك، وهو الذي يَمْلِكُ؛ السُلْطَان الحَاكِم الذي يملك الأَرْض والبِلاد)\nمثال: زيري ملك لنفسه.",
 "king of birds": "مَلِك الطُيُور (لغة في المَالِك، وهو الذي يَمْلِكُ؛ السُلْطَان الحَاكِم الذي يملك الأَرْض والبِلاد)\nمثال: زيري ملك لنفسه.",
 "king of england": "ملك إنجلترا (الحاكم السيادي لإنجلترا عندما يكون ذكراً)",
 "king of france": "ملك فرنسا (الحاكم السيادي لفرنسا)",
 "king of great britain": "ملك إنجلترا (الحاكم السيادي لإنجلترا عندما يكون ذكراً)",
 "king of kings": "مَلِكُ الْمُلُوكِ (لغة في المَالِك، وهو الذي يَمْلِكُ؛ السُلْطَان الحَاكِم الذي يملك الأَرْض والبِلاد)\nمثال: زيري ملك لنفسه.",
 "king of the germans": "ملك الألمان (الحاكم السيادي للألمان)",
 "king of the herring": "سمكة المجداف, ملك الرنجة (سمكة استوائية رفيعة تعيش في المياه العميقة يتراوح طولها بين 20 و 30 قدماً ولها زعنفة ظهرية حمراء)",
 "king orange": "برتقال المعبد, تانغور (شجرة حمضيات كبيرة لها فاكهة برتقالية عميقة حلوة كبيرة سهلة التقشير؛ تزرع على نطاق واسع في فلوريدا)",
 "king penguin": "بطريق ملك (بطريق كبير في الجزر المحاذية للدائرة القطبية الجنوبية)",
 "king post": "عمود التاج, عمود رئيسي (عمود يربط العارضة المستعرضة بقمة الجملون المثلث)",
 "king protea": "بروطيا عملاقة, بروطيا ملكية (شجيرة من جنوب أفريقيا تكون زهورها عند التفتح كأسية الشكل تشبه الخرشوف)",
 "king salmon": "سلمون شينوك, سلمون ملكي (سلمون كبير من المحيط الهادئ يُقدر كطعام؛ يموت البالغون بعد وضع البيض) / تشينوك, سلمون الملك (لحم وردي أو أبيض لسلمون المحيط الهادئ الكبير)",
 "king snake": "ثعبان الملك (أي من عاصرات أمريكا الشمالية غير السامة العديدة؛ تتغذى على ثعابين أخرى وثدييات صغيرة)",
 "king trumpet mushroom": "محاري ايرنغي",
 "king vulture": "نسر الملك (نسر كبير أسود وأبيض من أمريكا الجنوبية والوسطى؛ له زوائد لحمية ملونة ونتوءات تشبه الثآليل على الرأس والرقبة)",
 "king whiting": "بياض الملك (سمكة بياض في الساحل الجنوبي الشرقي لأمريكا الشمالية)",
 "king william pine": "صنوبر الملك ويليام (شجرة دائمة الخضرة في جبال تاسمانيا ذات أوراق حادة الرؤوس تنحني للداخل)",
 "king's counsel": "مستشار الملك (مستشار للتاج عندما يكون العاهل البريطاني ملكاً)",
 "king's english": "النطق المستلم (النطق المعتمد للإنجليزية البريطانية؛ كان يستند في الأصل إلى إنجليزية الملك كما يتحدث بها في المدارس العامة وفي جامعتي أكسفورد وكامبريدج)",
 "king's evil": "الخنازير, داء الخنازير (شكل من أشكال السل يتميز بتورم الغدد اللمفاوية)",
 "king's ransom": "ثروة ضخمة, فدية ملك (كنز كبير جداً)",
 "king's spear": "بروق أصفر, رمح الملك (بروق بساق مورقة وزهور صفراء عطرة)",
 "king-size": "فَائِق الحَجْم, كَبِير جِدًّا (أكبر من الحجم الاعتيادي)",
 "king-sized": "فَائِق الحَجْم, كَبِير جِدًّا (أكبر من الحجم الاعتيادي)",
 "kingbird": "طائر الملك (صائد ذباب أمريكي كبير)",
 "kingbolt": "كينغ بين, مسمار المحور الرئيسي (مسمار يوفر مفصل توجيه في المركبة)",
 "kingcup": "حوذان, زهرة الزبدة / آذريون المستنقع, قطيفة المستنقع (نبات مستنقعات من أوروبا وأمريكا الشمالية ذو أزهار صفراء زاهية تشبه الحوذان)",
 "kingdom": "مَمْلَكَة, مُلْك (دَوْلَةً يَحْكُمُهَا مَلِكٌ) / مَمْلَكَة (دَوْلَةً يَحْكُمُهَا مَلِكٌ)\nمثال: نعيش في المملكة المتحدة.",
 "kingdom come": "نهاية العالم, يوم الدين (نهاية الزمان) / العالم الآخر (العالم التالي (الموت))\nمثال: يمكنك تبليل الفراش حتى يوم الدين، بالنسبة لي لا أهتم",
 "kingdom of bahrain": "مَمْلَكَة اَلْبَحْرَيْن (دَوْلَةً يَحْكُمُهَا مَلِكٌ)\nمثال: نعيش في المملكة المتحدة.",
 "kingdom of belgium": "مَمْلَكَة بَلْجِيكَا (دَوْلَةً يَحْكُمُهَا مَلِكٌ)\nمثال: نعيش في المملكة المتحدة.",
 "kingdom of cambodia": "مَمْلَكَة كَامْبُودِيَا (دَوْلَةً يَحْكُمُهَا مَلِكٌ)\nمثال: نعيش في المملكة المتحدة.",
 "kingdom of denmark": "مَمْلَكَة الدَّنْمَارْك (دَوْلَةً يَحْكُمُهَا مَلِكٌ)\nمثال: نعيش في المملكة المتحدة.",
 "kingdom of england": "مَمْلَكَةُ إِنْجِلْتِرَا (دَوْلَةً يَحْكُمُهَا مَلِكٌ)\nمثال: نعيش في المملكة المتحدة.",
 "kingdom of eswatini": "مملكة إسواتيني (دَوْلَةً يَحْكُمُهَا مَلِكٌ)\nمثال: نعيش في المملكة المتحدة.",
 "kingdom of god": "ملكوت الله (المجال الروحي الذي يخضع لسيادة الله)",
 "kingdom of great britain": "الْمَمْلَكَة لِبِرِيطَانِيَا الْعُظْمَى",
 "kingdom of heaven": "مَلَكُوت السَّمَاوَات",
 "kingdom of italy": "مملكة إيطاليا (دَوْلَةً يَحْكُمُهَا مَلِكٌ)\nمثال: نعيش في المملكة المتحدة.",
 "kingdom of morocco": "الْمَمْلَكَة الْمَغْرِبِيَّة",
 "kingdom of norway": "مَمْلَكَة اَلنُّرْوِيج (دَوْلَةً يَحْكُمُهَا مَلِكٌ)\nمثال: نعيش في المملكة المتحدة.",
 "kingdom of saudi arabia": "المَمْلَكَة العَرَبِيَّة السَّعُودِيَّة, المَمْلَكَة العَرَبِيَّة السُّعُودِيَّة",
 "kingdom of scotland": "مَمْلَكَةُ إِسْكُتْلَنْدَا (دَوْلَةً يَحْكُمُهَا مَلِكٌ)\nمثال: نعيش في المملكة المتحدة.",
 "kingdom of spain": "مَمْلَكَة إِسْبَانِيَا (دَوْلَةً يَحْكُمُهَا مَلِكٌ)\nمثال: نعيش في المملكة المتحدة.",
 "kingdom of sweden": "مَمْلَكَةُ السُّوَيْد (دَوْلَةً يَحْكُمُهَا مَلِكٌ)\nمثال: نعيش في المملكة المتحدة.",
 "kingdom of thailand": "مَمْلَكَة تَايْلَنْد (دَوْلَةً يَحْكُمُهَا مَلِكٌ)\nمثال: نعيش في المملكة المتحدة.",
 "kingdom of the netherlands": "مَمْلَكَة هُولَنْدَا (دَوْلَةً يَحْكُمُهَا مَلِكٌ)\nمثال: نعيش في المملكة المتحدة.",
 "kingfish": "السمكة الملك, كينج فيش (سمكة صيد كبيرة في أستراليا ونيوزيلندا) / السمكة الملك, كينج فيش (أي من عدة أسماك طعام وصيد من عائلة الطبل موطنها المياه الأطلسية الدافئة لساحل أمريكا الشمالية) / كرواكر أبيض (سمكة طعام بحرية فضية صغيرة توجد قبالة كاليفورنيا) / بينتادو, سيرو (ماكريل كبير صالح للأكل في المياه الساحلية الأطلسية المعتدلة للولايات المتحدة)",
 "kingfisher": "سَلْدَج / قِرِلَّى / رَفْرَاف",
 "kingfisher daisy": "أقحوان الرفراف (عشب مشعر ناعم من جنوب أفريقيا له زهور بأشعة زرقاء ساطعة)",
 "kinglet": "صعوة (طيور صغيرة تشبه الهازجة ولكن لديها بعض عادات القرقف)",
 "kinglike": "كَالمَلِك, مَلَكِيّ (له رتبة ملك أو يشبهه أو يليق به)",
 "kingly": "كَالمَلِك, مَلَكِيّ (له رتبة ملك أو يشبهه أو يليق به)",
 "kingmaker": "صانع الملوك (شخص مهم يمكنه إيصال القادة إلى السلطة من خلال ممارسة النفوذ السياسي)\nمثال: كان إيرل وارويك أول صانع للملوك",
 "kingpin": "القنيمة الأمامية (قنيمة البولينج الأمامية في الترتيب المثلث للعشر قناني) / كينغ بين, مسمار المحور الرئيسي (مسمار يوفر مفصل توجيه في المركبة) / زعيم, شخصية محورية (أهم شخص في مجموعة أو مشروع)",
 "kingship": "ملكية, مُلك (كرامة أو رتبة أو منصب الملك)",
 "kingsnake": "ثعبان الملك (أي من عاصرات أمريكا الشمالية غير السامة العديدة؛ تتغذى على ثعابين أخرى وثدييات صغيرة)",
 "kingston": "كِينْغْسْتُون",
 "kingstown": "كِينْغْسْتَاوُن",
 "kingwood": "خشب الملك, شجرة خشب الملك (شجرة برازيلية تنتج خشب خزائن جميلاً) / خشب الملك (خشب وسيم بخطوط بنفسجية لشجرة خشب الملك؛ يستخدم خاصة في الخزائن)",
 "kingwood tree": "خشب الملك, شجرة خشب الملك (شجرة برازيلية تنتج خشب خزائن جميلاً)",
 "kinin": "سيتوكينين, كينين (أي من فئة الهرمونات النباتية التي تعزز انقسام الخلايا وتؤخر شيخوخة الأوراق)",
 "kink": "خلل بسيط, عقدة (صعوبة أو عيب في خطة أو عملية) / شطحة, فكرة غريبة (فكرة غريبة الأطوار) / شَاذّ, مُنْحَرِف جِنْسِيّاً (شخص ذو ميول جنسية غير عادية) / التواء, عقدة (انحناء حاد في خط ناتج عن سحب خط به حلقة بقوة)\nمثال: لا يزال هناك بعض العقد التي يجب حلها",
 "kinkajou": "بوتو (نوع من الليمور الرمادي البني) / دب العسل, كنكاج (ثديي شجري آكل للفاكهة من أمريكا الاستوائية ذو ذيل طويل قابض)",
 "kinky": "غَرِيب, مُثِيرٌ لِلدَّهْشَة ((غير رسمي) غَيْرُ تَقْلِيدِيٍّ بِشَكْلٍ لَافِت) / شَدِيدُ التَّجْعِيد, مُكَرَّش ((عَنِ الشَّعْرِ) ذُو تَجْعِيدَاتٍ صَغِيرَةٍ وَمُحْكَمَةٍ) / شَاذّ جِنْسِيًّا, مُنْحَرِف جِنْسِيًّا (يُظهر أو يميل إلى أذواق جنسية شاذة أو منحرفة (يوصف به السلوك الجنسي))",
 "kino": "بتيروكاربوس مارسوبيوم, كينو (شجرة من جزر الهند الشرقية تنتج راتنجاً أو مستخلصاً يستخدم غالباً طبياً وفي الدباغة) / صمغ الكينو, كينو (صمغ يتم الحصول عليه من نباتات استوائية مختلفة؛ يستخدم كقابض وفي الدباغة)",
 "kino gum": "صمغ الكينو, كينو (عصير أو راتنج محمر أو أسود من أشجار معينة ويستخدم في الطب والدباغة) / صمغ الكينو, كينو (صمغ يتم الحصول عليه من نباتات استوائية مختلفة؛ يستخدم كقابض وفي الدباغة)",
 "kinsfolk": "آل, أسرة ممتدة (أشخاص ينحدرون من سلف مشترك)\nمثال: عاش أهله في ماساتشوستس منذ سفينة ماي فلاور",
 "kinshasa": "كِنْشَاسَة / كِنْشَاسَا / كِينْشَاسَا",
 "kinship": "قَرَابَة",
 "kinship group": "عشيرة, قبيلة (مجموعة من الناس يرتبطون بالدم أو الزواج)",
 "kinship system": "نظام قرابة ((أنثروبولوجيا) نظام العلاقات الاجتماعية التي تشكل القرابة في ثقافة معينة، بما في ذلك المصطلحات المستخدمة والالتزامات المتبادلة المترتبة عليها)",
 "kinsman": "قريب (قريب ذكر)",
 "kinsperson": "أسرة, أهل (شخص لديه قرابة مع شخص آخر أو آخرين)\nمثال: إنه قريب",
 "kinswoman": "قريبة (قريبة أنثى)",
 "kinyarwanda": "كينيارواندا (لغة بانتو، وهي اللغة الرسمية لرواندا)",
 "kinyarwanda language": "كينيارواندا (لغة بانتو، وهي اللغة الرسمية لرواندا)",
 "kiosk": "كُشْك (هو الكِشْك في بعض اللهجات العربية؛ شبه رِوَاق بارز عن مساواة بقية البيت)",
 "kiowa": "لغة كيوا (اللغة التانوية التي يتحدث بها شعب كيوا) / كيوا (فرد من شعب تانوان يعيش في جنوب غرب الولايات المتحدة)",
 "kiowa language": "لغة كيوا (اللغة التانوية التي يتحدث بها شعب كيوا)",
 "kip": "كِيب",
 "kiplingesque": "كيبلنغي (على طريقة روديارد كيبلينغ)",
 "kipp's apparatus": "جهاز كيب (جهاز مختبري لإنتاج غاز (عادة كبريتيد الهيدروجين) عن طريق تفاعل سائل مع مادة صلبة دون تسخين)",
 "kippah": "قُبَّة, كِبَّة",
 "kipper": "رنجة مدخنة, كيبر (رنجة مملحة ومدخنة)",
 "kippered herring": "رنجة مدخنة, كيبر (رنجة مملحة ومدخنة)",
 "kippered salmon": "سلمون مملح ومدخن (سلمون مملح ومدخن)",
