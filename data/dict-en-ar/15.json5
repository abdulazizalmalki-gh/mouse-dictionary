 "jumper cable": "كابل اشتراك, كابل توصيل (وصلة تتكون من قطعة قصيرة من السلك)\nمثال: كانت عبارة عن تشابك من كابلات التوصيل والأسلاك المشبكية",
 "jumper lead": "كابل اشتراك, كابل توصيل (وصلة تتكون من قطعة قصيرة من السلك)\nمثال: كانت عبارة عن تشابك من كابلات التوصيل والأسلاك المشبكية",
 "jumper stay": "دعامة القفز, سلك داعم للصاري (دعامة إضافية تحد من مقدار انحناء الجزء العلوي من الصاري، وبالتالي تمكن من نقل الشد بفعالية من الدعامة الخلفية إلى الدعامة الأمامية)\nمثال: كانت دعامات القفز شائعة في الجزء الأول من القرن العشرين",
 "jumpiness": "توتر, عصبية (شعور القلق الذي ينتابك عندما تكون متوتراً)",
 "jumping": "قفز, وثب (فعل القفز؛ دفع النفس عن الأرض) / قفز (فعل المشاركة في منافسة رياضية يجب عليك فيها القفز)\nمثال: تقدم بسلسلة من القفزات",
 "jumping bean": "فاصوليا قافزة (بذرة شجيرات مكسيكية تحتوي على يرقة عثة تسبب حركاتها اهتزاز الفاصوليا أو تدحرجها)",
 "jumping bristletail": "هدبيات الذيل القافزة (حشرة غير مجنحة تعيش في الأماكن الرطبة المظلمة مثل تحت جذوع الأشجار الميتة؛ تقوم بقفزات عشوائية عند إزعاجها)",
 "jumping gene": "ترانسبوزون, جين قافز (جزء من الحمض النووي يمكن أن يندمج في العديد من المواقع المختلفة على طول الكروموسوم (خاصة جزء من الحمض النووي البكتيري يمكن نقله ككل))",
 "jumping jack": "لعبة القفز الميكانيكية (لعبة تتكون من شكل لعبة بمفاصل متحركة يمكن جعلها ترقص عن طريق سحب الخيوط)",
 "jumping mouse": "فأر قفاز (أي من عدة قوارض بدائية تشبه الفأر ذات أرجل خلفية طويلة وبدون جيوب خدية؛ تعيش في غابات أوراسيا وأمريكا الشمالية)",
 "jumping orchid": "أوركيد قافز, كاتاسيتوم (أوركيد ذو زهور ذكرية وأنثوية في نفس العنقود؛ عندما يتم لمس نتوء حساس عند قاعدة عمود الزهرة الذكرية يتم قذف حبوب اللقاح فجأة)",
 "jumping plant louse": "قمل النبات القافز (حشرة صغيرة نشطة تشبه الزيز لها أرجل خلفية متكيفة للقفز؛ تتغذى على عصارة النبات)",
 "jumping seed": "فاصوليا قافزة (بذرة شجيرات مكسيكية تحتوي على يرقة عثة تسبب حركاتها اهتزاز الفاصوليا أو تدحرجها)",
 "jumping up and down": "قفز في المكان (القفز في بقعة واحدة (كما في الإثارة))\nمثال: أرهقه العويل والقفز في المكان",
 "jumping-off place": "نقطة الانطلاق (مكان يتم منه إطلاق مشروع أو رحلة استكشافية)\nمثال: في أحد الأيام عندما كنت في نقطة انطلاق مناسبة قررت معرفة ما إذا كان بإمكاني العثور عليه",
 "jumping-off point": "منصة انطلاق, نقطة انطلاق (بداية ينطلق منها مشروع)\nمثال: يستخدم أفكار الآخرين كنقطة انطلاق لأفكاره الخاصة",
 "jumpstart": "بدء تشغيل مساعد, تشغيل بالاشتراك (تشغيل محرك السيارة الذي ببطاريته ضعف عن طريق كابلات التوصيل بسيارة أخرى)\nمثال: كانت بطاريتي ميتة لذا اضطررت للحصول على تشغيل بالاشتراك من جاري",
 "jumpsuit": "بدلة قفز, جمبسوت (رداء من قطعة واحدة مصمم على غرار زي المظليين)",
 "jumpy": "متخبط, مهتز (يسبب أو يتسم بالاهتزازات والحركات غير المنتظمة) / حَسَّاسُ الأَعْصَاب, عَصَبِيّ (فِي حَالَةِ تَوَتُّرٍ وَانْفِعَال)\nمثال: ركوب وعر",
 "junco": "جنكو, طائر الثلج (عصفور صغير من أمريكا الشمالية يُرى بشكل رئيسي في الشتاء)",
 "junco hyemalis": "جنكو (طائر جنكو شائع في أمريكا الشمالية ذو ريش رمادي وعيون ذات قزحية بنية داكنة)",
 "junction": "ربط, وصل (عملية ضم أو إلحاق الأشياء) / تقاطع, نقطة اتصال (المكان الذي يجتمع فيه شيئان أو أكثر) / ملتقى, نقطة اتصال (شيء يربط أو يصل) / مفصل, ملتقى (الشكل أو الطريقة التي تلتقي بها الأشياء ويتم الاتصال)",
 "junction barrier": "حاجز توصيل, شريط توصيل (وحدة توصيل لربط كبلين دون الحاجة إلى مقابس)",
 "junction rectifier": "دايود, صمام ثنائي",
 "junction transistor": "ترانزستور (جهاز شبه موصل قادر على التضخيم)",
 "juncture": "وُصْل (ضَمَّ وَلَأَمَ. (مصدره وَصْل وصِلَة)؛ بَلَغَ الشيءَ، أَدْرَكَه. (يتعدى بإلى) (مصدره وُصُول)) / فُتْرَة حَاسِمَة\nمثال: وصل السيد باكر.",
 "juncus articulatus": "أسل مفصلي (أسل من أستراليا)",
 "juncus bufonius": "أسل ضفدعي, سمار الضفادع (أسل حولي منخفض النمو في الأراضي المنخفضة الرطبة؛ عالمي الانتشار تقريباً)",
 "juncus effusus": "أسل شائع, سمار ناعم (أسل طويل بسيقان ناعمة منتصبة أو مقوسة يوجد في أوراسيا وأستراليا ونيوزيلندا وشائع في أمريكا الشمالية)",
 "juncus inflexus": "أسل صلب, سمار صلب (أسل طويل من المناطق المعتدلة)",
 "juncus leseurii": "أسل ملحي (أسل ساحل المحيط الهادئ في أمريكا الشمالية)",
 "juncus tenuis": "أسل رفيع, سمار رفيع (أسل سلكي ذو خصلات واسع الانتشار)",
 "june": "يُونِيُو, حَزِيرَان (الشهر السادس في السنة الميلادية الغربية المعرّبة)\nمثال: ستتزوج ابنتي في يونيو",
 "june 14": "14 يونيو, يوم العلم (إحياء لذكرى اعتماد علم الولايات المتحدة عام 1777)",
 "june 21": "انقلاب صيفي (21 يونيو، عندما تكون الشمس في أقصى نقطة شمالية لها)",
 "june 23": "23 يونيو, ليلة منتصف الصيف (الليلة التي تسبق يوم منتصف الصيف)",
 "june 24": "24 يونيو, يوم منتصف الصيف (يوم ربع سنوي في إنجلترا وويلز وأيرلندا)",
 "june 29": "29 يونيو, عيد بطرس وبولس (احتُفل به لأول مرة في القرن الثالث)",
 "june 3": "3 يونيو, عيد ميلاد جيفرسون ديفيس (عطلة بمناسبة تاريخ ميلاد جيفرسون ديفيس، يُحتفل بها في 3 يونيو في جنوب الولايات المتحدة)",
 "june beetle": "خنفساء مايو, خنفساء يونيو (أي من خنافس كبيرة بنية عادة في أمريكا الشمالية تأكل الأوراق وشائعة في أواخر الربيع؛ تتغذى اليرقات على جذور الأعشاب وما إلى ذلك)",
 "june bug": "خنفساء مايو, خنفساء يونيو (أي من خنافس كبيرة بنية عادة في أمريكا الشمالية تأكل الأوراق وشائعة في أواخر الربيع؛ تتغذى اليرقات على جذور الأعشاب وما إلى ذلك)",
 "june grass": "عشبة كنتاكي الزرقاء, قبأ كنتاكي (عشبة مروج ومراعي قيمة في أوروبا وخاصة وسط الولايات المتحدة ذات سيقان طويلة وأوراق خضراء زاهية نحيلة؛ مكون رئيسي في مخاليط عشب المروج)",
 "juneau": "جُونُو",
 "juneberry": "ساسكاتون (توت أرجواني أو أحمر صالح للأكل) / أملنشير, توت يونيو (أي من الأشجار أو الشجيرات المتنوعة في أمريكا الشمالية التي لها زهور بيضاء بارزة وثمار زرقاء مسودة أو أرجوانية صالحة للأكل)",
 "juneberry holly": "بهشية يونيو",
 "juneteenth": "جونتينث",
 "jungian": "يونغي (من أو يتعلق بكارل يونغ أو نظرياته النفسية) / يُونْغِيّ (تابع أو مدافع عن نظريات كارل يونغ)",
 "jungian psychology": "علم النفس اليونغي (النظريات النفسية لكارل يونغ)",
 "jungle": "أَجَمَة, أَدْغَال",
 "jungle cat": "قط الأدغال (قط بري آسيوي صغير)",
 "jungle cock": "ديك الأدغال (ذكر دجاج الأدغال)",
 "jungle fever": "حمى الغابة (شكل حاد من الملاريا يحدث في المناطق الاستوائية)",
 "jungle fowl": "دجاج الأدغال (طائر بري آسيوي صغير؛ يعتقد أنه سلف الدجاج الداجن)",
 "jungle gym": "لعبة التسلق, هيكل تسلق (هيكل من قضبان رأسية وأفقية حيث يمكن للأطفال التسلق واللعب)",
 "jungle hen": "دجاجة الأدغال (أنثى دجاج الأدغال)",
 "jungle rot": "تعفن الغابة (اضطراب جلدي يسببه المناخ الاستوائي)",
 "jungly": "أَدْغَالِيّ, غَابِيّ اسْتِوَائِيّ (مُكْتَظّ بِالنَّبَاتَاتِ الاسْتِوَائِيَّةِ)",
 "junin virus": "فيروس جونين (فيروس رنا يسبب الحمى النزفية الأرجنتينية؛ تحمله الجرذان والفئران)",
 "junior": "لِلشَّبَاب, لِلنَّاشِئَة (يشمل الأشخاص اليافعين أو مُعَدّ لهم) / أدنى رتبة, أصغر سناً (أصغر سنًا؛ أدنى رتبة؛ أقصر في مدة الولاية أو الخدمة) / الأَصْغَر, الاِبْن (يُستخدم للأصغر سنًّا من شخصين يحملان الاسم ذاته؛ خاصة لتمييز الابن عن أبيه) / أَصْغَر سِنّاً (الشخص الأصغر سناً بين اثنين)\nمثال: هي أصغر مني بسنتين",
 "junior class": "السنة الثالثة جامعية, الصف قبل النهائي (الصف قبل الأخير في المدرسة الثانوية أو الكلية)",
 "junior college": "كلية متوسطة, كلية مجتمع (كلية تقدم فقط السنتين الأوليين وتنتهي بدرجة مشارك)",
 "junior featherweight": "وزن الديك الممتاز (ملاكم لا يزيد وزنه عن 122 رطلاً (حوالي 55 كجم))",
 "junior high": "مدرسة إعدادية, مدرسة متوسطة (مدرسة ثانوية تشمل عادة الصفين السابع والثامن)",
 "junior high school": "مدرسة إعدادية, مدرسة متوسطة (مدرسة ثانوية تشمل عادة الصفين السابع والثامن)",
 "junior lightweight": "وزن الريشة الممتاز (ملاكم لا يزيد وزنه عن 130 رطلاً (حوالي 59 كجم))",
 "junior middleweight": "وزن خفيف المتوسط (ملاكم لا يزيد وزنه عن 154 رطلاً (حوالي 70 كجم))",
 "junior school": "مدرسة ابتدائية عليا (مدرسة بريطانية للأطفال الذين تتراوح أعمارهم بين 7-11 عاماً)",
 "junior status": "حداثة, درجة مبتدئ (في منصب مبتدئ)",
 "junior varsity": "فريق الناشئين (فريق كلية أو جامعة يتنافس بمستوى أقل من فريق الجامعة الرسمي)",
 "junior welterweight": "وزن خفيف الممتاز (ملاكم لا يزيد وزنه عن 140 رطلاً (حوالي 63.5 كجم))",
 "junior-grade": "ثَانَوِيّ, وَضِيع الرُّتْبَة (أدنى في الرتبة أو المكانة)",
 "juniper": "عَرْعَر",
 "juniper berries": "توت العرعر (مخروط يشبه التوت للعرعر الشائع؛ يستخدم في صنع الجن)",
 "juniper berry": "توت العرعر (فاكهة تشبه التوت لنبات من جنس العرعر خاصة المخروط الذي يشبه التوت للعرعر الشائع)",
 "juniper bush": "رتامة, رتم",
 "juniperic acid": "حمض الجونيبريك (حمض بلوري يوجد في إفرازات بعض الصنوبريات)",
 "juniperus bermudiana": "عرعر برمودا (عرعر هرمي كثيف للزينة في برمودا؛ كبير إلى حد ما بالنسبة لعرعر)",
 "juniperus communis": "عرعر شائع (شجيرة كثيفة التفرع أو شجرة صغيرة لها توت أزرق لاذع يستخدم لنكهة الجن؛ واسعة الانتشار في نصف الكرة الشمالي؛ الصنوبرية الوحيدة على سواحل أيسلندا…)",
 "juniperus communis depressa": "عرعر زاحف (نوع منبسط من العرعر الشائع)",
 "juniperus flaccida": "عرعر متدلي, عرعر مكسيكي (شجرة صغيرة في غرب تكساس وجبال المكسيك ذات فروع منتشرة مع غصينات متدلية)",
 "juniperus horizontalis": "عرعر أفقي (شجيرة منخفضة إلى منبسطة في كندا وشمال الولايات المتحدة؛ أرجوانية برونزية في الشتاء)",
 "juniperus procera": "عرعر شرق أفريقيا (شجرة خشبية أفريقية استوائية ذات خشب عطري)",
 "juniperus sabina": "عرعر قزم (عرعر منبسط أو منتشر)",
 "juniperus silicicola": "عرعر أحمر جنوبي (عرعر المناطق الساحلية المستنقعية في جنوب شرق الولايات المتحدة؛ مشابه للعرعر الأحمر الشرقي)",
 "juniperus virginiana": "عرعر أحمر شرقي (عرعر صغير يوجد شرق جبال روكي له تاج مخروطي ولحاء بني يتقشر في شرائح وإبر صغيرة حادة)",
 "junk": "جُنْك",
 "junk bond": "سند خردة, سند عالي العائد (سند (مضاربة) بتصنيف ائتماني منخفض؛ يصدر لعمليات الاستحواذ بالرافعة المالية وغيرها من عمليات الاستحواذ من قبل شركات ذات ائتمان مشكوك فيه)",
 "junk dna": "حمض نووي خردة (أجزاء من الحمض النووي لا ترمز للجينات)\nمثال: يتكون معظم الجينوم من حمض نووي خردة",
 "junk e-mail": "بريد مزعج, سبام (بريد إلكتروني غير مرغوب فيه (عادة ذو طبيعة تجارية يرسل بكميات كبيرة))",
 "junk food": "طعام غير صحي, وجبات سريعة (طعام طعمه جيد ولكنه مرتفع السعرات الحرارية وقليل القيمة الغذائية)",
 "junk heap": "كومة خردة, كومة قمامة (تراكم للنفايات والمواد المهملة)",
 "junk mail": "بريد دعائي, بريد غير مرغوب فيه (بريد من الدرجة الثالثة يتكون من إعلانات وغالباً ما يُعنون إلى 'مقيم' أو 'شاغل المكان')",
 "junk pile": "كومة خردة, كومة قمامة (تراكم للنفايات والمواد المهملة)",
 "junk shop": "متجر خردة, محل بضائع مستعملة (متجر يبيع سلعاً مستعملة رخيصة)",
 "junker": "يونكر (عضو في الطبقة الأرستقراطية البروسية المعروفة خاصة بالنزعة العسكرية)",
 "junket": "رحلة رسمية (رحلة يقوم بها مسؤول على نفقة الدولة) / رحلة ترفيهية, نزهة (رحلة تُتخذ للمتعة) / جنكت, خثرة حليب (تحلية مصنوعة من الحليب المحلى المتخثر بالمنفحة)\nمثال: العديد من النزهات الصيفية إلى الشاطئ",
 "junketing": "تنزه (القيام بنزهة للمتعة)",
 "junkie": "مدمن, مهووس (شخص مكرس لشيء ما بحماس شديد يشبه الإدمان) / مدمن مخدرات (مدمن على المخدرات)\nمثال: مدمن غولف",
 "junky": "مدمن, مهووس (شخص مكرس لشيء ما بحماس شديد يشبه الإدمان) / مدمن مخدرات (مدمن على المخدرات)\nمثال: مدمن غولف",
 "junkyard": "ساحة خردة (حقل يتم فيه جمع الخردة وتخزينها لإعادة بيعها)",
 "juno": "جُونُو",
 "junoesque": "فَارِع, كَالتِّمْثَال (يُوحي بتمثال في مهابته وتناسقه)",
 "junta": "خُونْتَا, مَجْلِس عَسْكَرِيّ",
 "junto": "زمرة سرية, عصبة (زمرة (غالباً ما تكون سرية) تسعى للسلطة عادة من خلال المؤامرات)",
 "jupati": "جوباتي, نخيل جوباتي (نخيل ريشي برازيلي طويل له تاج طرفي من أوراق ريشية جلدية كبيرة جداً ترتفع من سيقان قوية طويلة تستخدم لأغراض هيكلية)",
 "jupati palm": "جوباتي, نخيل جوباتي (نخيل ريشي برازيلي طويل له تاج طرفي من أوراق ريشية جلدية كبيرة جداً ترتفع من سيقان قوية طويلة تستخدم لأغراض هيكلية)",
 "jupaty": "جوباتي, نخيل جوباتي (نخيل ريشي برازيلي طويل له تاج طرفي من أوراق ريشية جلدية كبيرة جداً ترتفع من سيقان قوية طويلة تستخدم لأغراض هيكلية)",
 "jupiter": "اَلْمُشْتَرِي (أحد كَوَاكِب المجموعة الشمسية السَّيَّارَة، وهو أكبرها) / يُوبِيتَر\nمثال: كوكب المشتري متكون من الغاز.",
 "jupiter's beard": "شجيرة الفضة, لحية المشتري (شجيرة أوروبية مشعرة فضية ذات أوراق دائمة الخضرة وأزهار صفراء باهتة)",
 "jura": "جُورَا",
 "jural": "حُقُوقِيّ, فِقْهِيّ (مُتَعَلِّق بِالقانون أَوْ بِالحُقوق وَالاِلتِزامات القانونِيَّة)",
 "jurassic": "اَلْعَصْر اَلْجُورَاسِيّ",
 "juridic": "قضائي (متعلق بإقامة العدل أو وظيفة القاضي) / فقهي, قانوني (مكون من أو متعلق بالقانون أو الفقه)\nمثال: نظام قضائي",
