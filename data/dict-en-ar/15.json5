 "land site": "موقع (قطعة الأرض التي يقع عليها شيء ما (أو سيقع عليها))\nمثال: موقع جيد للمدرسة",
 "land tax": "ضريبة الأراضي, ضريبة الأملاك (ضريبة رأسمالية تفرضها البلديات على الممتلكات؛ وتعتمد على القيمة المقدرة للعقار)",
 "land tenure": "حيازة الأرض, نظام الحيازة (الحق في حيازة الممتلكات؛ جزء من نظام هرمي قديم لحيازة الأراضي)",
 "land-office business": "أعمال مزدهرة جداً (حجم كبير جداً ومربح من النشاط التجاري)",
 "landau": "عربة لاندو (عربة مغطاة بأربع عجلات وسقف مقسم إلى جزأين (أمامي وخلفي) يمكن إنزالهما بشكل منفصل)",
 "landed": "إِقْطَاعِيّ, مَالِك لِلأَرْض (يملك أو يتكون من أرض أو عقارات)\nمثال: طبقة النبلاء الملاك للأراضي",
 "landed estate": "إقطاعية, ضيعة (ممتلكات واسعة من الأراضي (خاصة في الريف) يحتفظ بها المالك لاستخدامه الخاص)\nمثال: كانت العائلة تمتلك ضيعة كبيرة في لونغ آيلاند",
 "landed gentry": "أعيان الريف, ملاك الأراضي (الأعيان الذين يمتلكون الأراضي (يُعتبرون كطبقة))",
 "lander": "مركبة هبوط, مسبار هبوط (مركبة فضائية مصممة للهبوط على القمر أو كوكب آخر)",
 "landfall": "رؤية اليابسة (أول رؤية لليابسة من البحر بعد رحلة (أو طيران فوق الماء)) / اليابسة الأولى (ساحل البحر الذي يُشاهد أولاً في رحلة (أو رحلة طيران فوق الماء))",
 "landfill": "مَرْدَم",
 "landform": "شَكْل اَلْأَرْض ((شَكَلَ) الأمْرُ يَشْكُلُ شُكُولاً: الْتَبَسَ؛ (شَكَلَ) المريضُ: تماثَلَ)\nمثال: اجلس بشكل مريح.",
 "landgrave": "لاندغريف (كونت كان له ولاية قضائية على منطقة كبيرة في ألمانيا في العصور الوسطى)",
 "landholder": "مالك أرض (حائز أو مالك لأرض)",
 "landholding": "حيازة أرض (حيازة تكون في شكل أرض) / حِيَازَة الأَرَاضِي, مِلْكِيَّة الأَرْض (ملكية الأرض؛ حالة أو حقيقة امتلاك الأرض)",
 "landing": "هُبُوط / بَسْطَة",
 "landing approach": "اقتراب للهبوط, نهج الهبوط (اقتراب طائرة من مهبط الهبوط)",
 "landing craft": "سفينة إنزال, مركبة إنزال (مركبة بحرية مصممة لإنزال القوات والمعدات على الشاطئ)",
 "landing deck": "سطح الطيران (السطح العلوي لحاملة طائرات؛ يستخدم كمدرج)",
 "landing field": "مطار, مهبط طائرات (مكان تقلع منه الطائرات وتهبط فيه)",
 "landing flap": "قلاب الهبوط (قلاب على الجانب السفلي من الجناح يتم إنزاله لإبطاء الطائرة للهبوط)",
 "landing gear": "عجلات الهبوط, معدات الهبوط (هيكل سفلي يدعم وزن الطائرة عندما تكون على الأرض)",
 "landing net": "شبكة هبوط (شبكة صيد على شكل كيس بمقبض طويل لأخذ سمكة تم صيدها من الماء)",
 "landing party": "فريق الإنزال (جزء من طاقم السفينة منظم لمهام خاصة على الشاطئ)",
 "landing place": "رصيف إنزال, مرسى (هيكل يوفر مكاناً يمكن للقوارب فيه إنزال الأشخاص أو البضائع)",
 "landing skid": "زلاجة هبوط (أحد جزأين من معدات هبوط طائرة هليكوبتر)",
 "landing stage": "منصة الهبوط (منصة يمكن منها تحميل أو تفريغ الركاب والبضائع)",
 "landing strip": "مَهْبِط",
 "landlady": "مالكة العقار (مالك عقار أنثى)",
 "landler": "لاندلر (رقصة ريفية نمساوية بطيئة نوعاً ما بإيقاع ثلاثي؛ تتضمن الدوران والتصفيق) / لاندلر (موسيقى في زمن ثلاثي لرقص اللاندلر)",
 "landless": "بِلَا أَرْض, مُعْدَم (لا يملك أرضاً)\nمثال: الفلاحون المعدمون",
 "landline": "هَاتِف ثَابِت (جهاز يستخدم للتحدث؛ الصوت يسمع دون أن يرى صاحبه)\nمثال: رن الهاتف تكرارا.",
 "landlocked": "حَبِيس اليَابِسَة (محاط باليابسة كلياً أو شبه كلي)",
 "landlocked salmon": "سلمون البحيرات, سلمون حبيس (سلمون أطلسي محصور في بحيرات نيو إنجلاند وجنوب شرق كندا)",
 "landlord": "مؤجر, مالك العقار (مالك أرض يقوم بتأجيرها للآخرين)",
 "landlord's lien": "حجز المالك (حجز على ممتلكات المستأجر للوفاء بإيجار غير مدفوع أو تلف في الممتلكات؛ يُعطى المالك وضع الدائن المفضل فيما يتعلق بممتلكات المستأجر)",
 "landlubber": "بحار مبتدئ, ساكن اليابسة (بحار قليل الخبرة؛ أو بحار في رحلته الأولى) / ساكن البر, قليل الخبرة بالبحر (شخص يعيش ويعمل على اليابسة)",
 "landlubberly": "أَخْرَق بَحْرِيًّا, عَدِيم الخِبْرَة البَحْرِيَّة (يفتقر إلى الخبرة في فنون الملاحة البحرية)",
 "landman": "رجل بري, عامل يابسة (شخص ذكر يعيش ويعمل على اليابسة (عكس البحار))",
 "landmark": "مَعْلَم (من يمتهن التعليم، مُدَرِّس)\nمثال: هي أصبحت معلمة.",
 "landmass": "كتلة أرضية, كتلة يابسة (مساحة كبيرة متصلة من الأرض)",
 "landowner": "مالك أرض (حائز أو مالك لأرض)",
 "landrover": "سيارة جيب, لاند روفر (سيارة مناسبة للسفر فوق التضاريس الوعرة)",
 "landry's paralysis": "متلازمة غيلان باريه (شكل من أشكال التهاب الأعصاب المتعدد المحيطي يتميز بالألم والضعف وأحياناً شلل الأطراف؛ السبب غير معروف)",
 "landscape": "مَنْظَر طَبِيعِيّ, مَنْظَر",
 "landscape architect": "منسق حدائق, مهندس مناظر طبيعية (شخص يقوم بترتيب ميزات المناظر الطبيعية أو الحديقة بشكل جذاب)",
 "landscape architecture": "تنسيق المواقع, هندسة المناظر الطبيعية (فن وتخطيط وتصميم وإدارة وحفظ وإعادة تأهيل الأرض وتصميم الإنشاءات الكبيرة من صنع الإنسان)",
 "landscape gardener": "منسق حدائق, مهندس مناظر طبيعية (شخص يقوم بترتيب ميزات المناظر الطبيعية أو الحديقة بشكل جذاب)",
 "landscape gardening": "تنسيق الحدائق (العمل كبستاني مناظر طبيعية)",
 "landscape painting": "فن المناظر الطبيعية (نوع فني يتعامل مع تصوير المناظر الطبيعية)",
 "landscaped": "مُنَسَّق بُسْتَانِيًّا ((عن الأراضي) حُسِّنت بالبستنة أو هندسة المناظر الطبيعيّة)",
 "landscaper": "منسق حدائق, مهندس مناظر طبيعية (شخص يقوم بترتيب ميزات المناظر الطبيعية أو الحديقة بشكل جذاب)",
 "landscaping": "تنسيق الحدائق (العمل كبستاني مناظر طبيعية) / تنسيق حدائق (حديقة مصممة لتأثير جمالي)\nمثال: أنفقوا قدراً كبيراً من المال على تنسيق الحدائق",
 "landscapist": "منسق حدائق, مهندس مناظر طبيعية (شخص يقوم بترتيب ميزات المناظر الطبيعية أو الحديقة بشكل جذاب) / رسام مناظر طبيعية (شخص يرسم المناظر الطبيعية)",
 "landside": "الجانب الأرضي (مكون يتكون من قطعة جانبية مقابلة للوحة القلابة في المحراث)",
 "landslide": "اِنْهِيَار أَرْضِيّ (سقوط شيء أو تهاويه بشكل مفاجئ نتيجة ضعف أو خلل؛ تدهور نفسي أو عاطفي يؤدي إلى فقدان القدرة على التحمل)\nمثال: يوشك الجسر على الانهيار.",
 "landslip": "انزلاق أرضي, انهيار أرضي (انزلاق كتلة كبيرة من التراب والصخور أسفل جبل أو منحدر)",
 "landsmaal": "النرويجية الجديدة, نينوشك (إحدى اللغتين الرسميتين للنرويج؛ تعتمد على اللهجات الريفية)",
 "landsmal": "النرويجية الجديدة, نينوشك (إحدى اللغتين الرسميتين للنرويج؛ تعتمد على اللهجات الريفية)",
 "landsman": "رجل بري, عامل يابسة (شخص ذكر يعيش ويعمل على اليابسة (عكس البحار)) / بحار مبتدئ (بحار ذكر عديم الخبرة؛ أو بحار في رحلته الأولى)",
 "landswoman": "بحارة مبتدئة (بحارة أنثى عديمة الخبرة؛ أو بحارة في رحلتها الأولى) / عاملة يابسة (شخص أنثى تعيش وتعمل على اليابسة)",
 "landward": "باتجاه البر (نحو اليابسة)\nمثال: باتجاه البر، تذوب أميال من مستنقعات العشب الخشنة في المرتفعات المنخفضة",
 "landwards": "باتجاه البر (نحو اليابسة)\nمثال: باتجاه البر، تذوب أميال من مستنقعات العشب الخشنة في المرتفعات المنخفضة",
 "landwoman": "عاملة يابسة (شخص أنثى تعيش وتعمل على اليابسة)",
 "lane": "زُقَاق, ممر / مَسَار (المَسَار: اسم مكان من سارَ : مسلك ، طريق ؛ خَطُّ السَّيْر؛ مَسَار كوكب حول الشَّمس : مدار)\nمثال: هذا من شأنه أن يضع العاصفة في مسار تصادم افتراضي مع بركان كيلويا ، في الجزء الجنوبي من الجزيرة.",
 "lane's prince albert": "تفاح لينز برنس ألبرت (تفاح يستخدم بشكل أساسي في الطهي)",
 "lang syne": "قديماً, منذ زمن بعيد (من الماضي البعيد أو البعيد نسبياً) / أيام الخوالي (أوقات ماضية يتم تذكرها بحنين)\nمثال: التقينا مرة منذ زمن بعيد",
 "langbeinite": "لانغبينيت (معدن يتكون من كبريتات المغنيسيوم والبوتاسيوم المزدوجة؛ يستخدم كسماد)",
 "langlaufer": "متزلج الضاحية (متزلج عبر البلاد (مسافات طويلة))",
 "langley": "لانغلي (وحدة للإشعاع الشمسي)",
 "langobard": "لومباردي (فرد من شعب جرماني غزا شمال إيطاليا في القرن السادس)",
 "langouste": "جراد البحر الشائك (قشري بحري كبير صالح للأكل له درقة شوكية ولكنه يفتقر إلى المخالب الكبيرة للكركند الحقيقي) / إستاكوزا شائكة, كركند شائك (كركند المياه الدافئة بدون مخالب؛ تلك القادمة من أستراليا وجنوب أفريقيا تسوق عادة كذيول مجمدة؛ تصاد أيضاً في فلوريدا وكاليفورنيا)",
 "langoustine": "لانغوستين (يصاد في المياه الأوروبية؛ أنحف من الكركند الأمريكي)",
 "langsat": "لانسيت, لانسيوم (شجرة من جزر الهند الشرقية تحمل توتاً أصفر صالحاً للأكل) / لانغسات (فاكهة صغيرة ذات لب لحمي؛ طعمها يشبه مزيجاً من العنب والجريب فروت)",
 "langset": "لانسيت, لانسيوم (شجرة من جزر الهند الشرقية تحمل توتاً أصفر صالحاً للأكل)",
 "langsyne": "قديماً, منذ زمن بعيد (من الماضي البعيد أو البعيد نسبياً) / أيام الخوالي (أوقات ماضية يتم تذكرها بحنين)\nمثال: التقينا مرة منذ زمن بعيد",
 "language": "لُغَة, لِسَان (هِيَ مجموعة من الأصوات التي يصدرها الإنسان على شكل كلمات منظمة بقواعد، ليتواصل به الناس وينقلون به الافكار والمعاني، اللسان؛ يقصد بها أحيانا اللهجة) / لُغَة (هِيَ مجموعة من الأصوات التي يصدرها الإنسان على شكل كلمات منظمة بقواعد، ليتواصل به الناس وينقلون به الافكار والمعاني، اللسان؛ يقصد بها أحيانا اللهجة)\nمثال: الأمازيغية لغة.",
 "language area": "منطقة اللغة (منطقة قشرية كبيرة (في النصف الأيسر لدى معظم الناس) تحتوي على جميع المراكز المرتبطة باللغة)",
 "language barrier": "حاجز لغوي (حاجز أمام التواصل ناتج عن التحدث بلغات مختلفة)",
 "language exchange": "تَبَادُل لُغَوِيّ",
 "language family": "عائلة اللغات (اسم فاعل من الفعل عَالَ؛ مؤنث عَائِل؛ إحدى طبقات الأنساب وهي آخرها دون الفصيلة وتشمل ثلاث أجيال من جد واحد: الجد والأبناء وأبناء الأبناء)\nمثال: هو طفل العائلة.",
 "language learning": "تعلم اللغة (تعلم استخدام لغة ما)",
 "language lesson": "درس لغة (فترة تعليمية لتعلم لغة)",
 "language proficiency": "كفاءة لغوية (مصدر؛ المماثلة والمساواة في القُوَّة والشَرَف، وقد يكون في المَال والعِلْم والثَقَافَة. لا جمع له؛ اسم؛ التقارب في القُوَّة والشَرَف. لا جمع له)\nمثال: ياني لديه الكفاءة لذلك.",
 "language requirement": "متطلب لغوي (شرط أن يعرف الطالب لغات معينة)",
 "language school": "مَدْرَسَةُ لُغَات (الموضع الذي تُدَرَّس فيه العلوم؛ البناء فيه عدة غرف تُدَرَّسُ فيها العلوم وتمنح شهادة رسمية بعد إكمال الدروس)\nمثال: لا أحب المدرسة.",
 "language system": "نظام لغوي (نظام من الوحدات أو العناصر اللغوية المستخدمة في لغة معينة)",
 "language teaching": "تعليم اللغات (تعليم الناس التحدث وفهم لغة أجنبية)",
 "language unit": "وحدة لغوية (واحدة من الوحدات الطبيعية التي يمكن تحليل الرسائل اللغوية إليها)",
 "language zone": "منطقة اللغة (منطقة قشرية كبيرة (في النصف الأيسر لدى معظم الناس) تحتوي على جميع المراكز المرتبطة باللغة)",
 "languas speciosa": "زنجبيل الصدفة, زهرة الصدفة (يزرع لأوراقه المستطيلة اللامعة وعناقيده المقوسة من الزهور البيضاء ذات الظلال الوردية والشفاه الصفراء المجعدة ذات الخطوط الأرجوانية المبرقشة)",
 "langue d'oc": "البروفنسالية, القسطانية (لهجات العصور الوسطى للغات أوش (جنوب فرنسا))",
 "langue d'oc french": "البروفنسالية, القسطانية (لهجات العصور الوسطى للغات أوش (جنوب فرنسا))",
 "langue d'oil": "الفرنسية القديمة (أقدم شكل للغة الفرنسية؛ من القرن التاسع إلى الخامس عشر)",
 "langue d'oil french": "الفرنسية القديمة (أقدم شكل للغة الفرنسية؛ من القرن التاسع إلى الخامس عشر)",
 "languedoc": "لانغيدوك",
 "languid": "خَامِلُ الهِمَّة, فَاتِر (يفتقر إلى الحيوية أو النشاط)",
 "languidly": "بتراخٍ, بفتور (بطريقة فاترة وخاملة)\nمثال: ارتدى الرجال ستراتهم بتراخٍ",
 "languish": "فَتَرَ, ضَعُفَ / قَبَعَ / أُهْمِلَ",
 "languisher": "ذامِل, ضاوٍ (شخص يعاني من الوهن أو الإهمال)",
 "languor": "تراخ, سبات (خمول؛ إظهار نقص غير عادي في الطاقة) / خمول, فتور (شعور بقلة الاهتمام أو الطاقة) / استرخاء حالم, فتور (شعور مريح بالاسترخاء) / خمول الجو, ركود الهواء (هواء ساكن بشكل خانق)\nمثال: أقلق المظهر العام للسبات أصدقاءه",
 "languorous": "خَامِلُ الهِمَّة, فَاتِر (يفتقر إلى الحيوية أو النشاط)",
 "languorously": "باسترخاء, بكسل لذيذ (بطريقة مسترخية)\nمثال: كان ممدداً باسترخاء على الأريكة",
 "langur": "لانغور (قرد آسيوي نحيل طويل الذيل)",
 "laniard": "حبل الشد ((مصطلح بحري) حبل يستخدم لتمديد أو تثبيت التجهيزات على السفن) / حبل تعليق, قيطان (حبل يُرتدى حول الرقبة لحمل سكين أو صافرة) / حبل الإطلاق (حبل مزود بخطاف مرفق يستخدم لإطلاق أنواع معينة من المدافع)",
 "laniary": "نابي (من أو متعلق بالسن المخروطي المدبب (الناب))",
 "lanius borealis": "صرد شمالي (طائر صرد من شمال أمريكا الشمالية)",
 "lanius excubitor": "صرد رمادي كبير (طائر صرد أوروبي شائع)",
 "lanius lucovicianus": "صرد كبير الرأس (صرد شائع في جنوب شرق الولايات المتحدة له شرائط سوداء حول العينين)",
 "lanius ludovicianus": "صرد كبير الرأس (صرد شائع في جنوب شرق الولايات المتحدة له شرائط سوداء حول العينين)",
 "lanius ludovicianus excubitorides": "صرد أبيض الردف (طائر صرد من غرب أمريكا الشمالية؛ رمادي مع أجزاء سفلية بيضاء)",
 "lanius ludovicianus migrans": "صرد مهاجر (صرد من وسط أمريكا الشمالية؛ يشتي في تكساس ووادي المسيسيبي الجنوبي)",
 "lank": "مُمْتَدّ وَنَحِيل (طَوِيل وَنَحِيف كَالمِغْزَل) / مُتَدَلٍّ, نَحِيل (طَويل وَرَفيع وَغالِبًا مُرْتَخٍ)",
