 "lateral cerebral sulcus": "التلم الجانبي, شق سيلفيوس (أعمق وأبرز الشقوق القشرية؛ يفصل الفصوص الجبهية عن الفصوص الصدغية في كلا نصفي الكرة المخية)",
 "lateral condyle": "لقمة وحشية (لقمة على الجانب الخارجي للطرف السفلي لعظم الفخذ)",
 "lateral epicondyle": "لقيمة وحشية (لقيمة بالقرب من اللقمة الوحشية لعظم الفخذ)",
 "lateral epicondylitis": "التهاب اللقيمة الجانبي, مرفق التنس (التهاب مؤلم للوتر عند الحافة الخارجية للمرفق ناتج عن الإفراط في استخدام عضلات الساعد (كما في التواء اليد))",
 "lateral geniculate": "جسم ركبي وحشي (بنية عصبية تعمل كمحطة معالجة في الطريق من الشبكية إلى الفص القذالي للقشرة المخية)",
 "lateral geniculate body": "جسم ركبي وحشي (بنية عصبية تعمل كمحطة معالجة في الطريق من الشبكية إلى الفص القذالي للقشرة المخية)",
 "lateral humeral epicondylitis": "التهاب اللقيمة الجانبي, مرفق التنس (التهاب مؤلم للوتر عند الحافة الخارجية للمرفق ناتج عن الإفراط في استخدام عضلات الساعد (كما في التواء اليد))",
 "lateral line": "خط جانبي (أعضاء حسية للأسماك والبرمائيات؛ يُعتقد أنها تكتشف تغيرات الضغط في الماء)",
 "lateral line organ": "خط جانبي (أعضاء حسية للأسماك والبرمائيات؛ يُعتقد أنها تكتشف تغيرات الضغط في الماء)",
 "lateral pass": "تمريرة عرضية (تمريرة إلى مستقبل في الملعب بعيدًا عن الممرر)",
 "lateral rectus": "مستقيمة وحشية (عضلة العين التي يدير انقباضها مقلة العين للخارج)",
 "lateral rectus muscle": "مستقيمة وحشية (عضلة العين التي يدير انقباضها مقلة العين للخارج)",
 "lateral surface": "سطح جانبي (سَطحَهُ يَسْطَحَ سَطْحًا: بَسَطَهُ وسَوّاه؛ فهو مَسْطُوحٌ، وسَطِيحٌ)\nمثال: هناك ثقوب على السطح.",
 "lateral thinking": "تفكير جانبي (نهج استكشافي لحل المشكلات؛ حيث تحاول النظر إلى المشكلة من زوايا عديدة بدلاً من معالجتها بشكل مباشر)",
 "lateral ventricle": "بطين جانبي (أي من بطينين على شكل حدوة حصان في كل نصف كرة مخية؛ يتصلان بالبطين الثالث عبر ثقبة مونرو)",
 "lateralisation": "تجانب, جانبية (توطين الوظيفة في الجانب الأيمن أو الأيسر من الدماغ)",
 "laterality": "جانبية, هيمنة جانبية (تطور متفوق لجانب واحد من الجسم) / استخدام اليد, هيمنة جانبية (خاصية استخدام يد واحدة أكثر من الأخرى) / تجانب, جانبية (توطين الوظيفة في الجانب الأيمن أو الأيسر من الدماغ)",
 "lateralization": "تجانب, جانبية (توطين الوظيفة في الجانب الأيمن أو الأيسر من الدماغ)",
 "laterally": "جانبياً, من الجانب (في اتجاه أو موقع جانبي) / جانبياً (إلى أو بواسطة أو من الجانب)\nمثال: الجسم مغزلي الشكل ومضغوط قليلاً فقط من الجانب",
 "lateran council": "مجمع اللاتران, مجمع لاتران (أي من خمسة مجامع عامة للكنيسة الكاثوليكية الغربية عقدت في قصر لاتران)",
 "latergram": "ليترغرام (صورة يتم نشرها على إنستغرام في تاريخ لاحق)",
 "laterite": "لاتريت (تربة حمراء ناتجة عن تحلل الصخور؛ تحتوي على رواسب غير قابلة للذوبان من أكاسيد الحديديك والألومنيوم)",
 "latest": "آخِرُ مَا صَدَرَ, أَحْدَث (مواكب للحاضر المباشر؛ الأكثر حداثة) / رَائِج, عَلَى المُوضَة (وَفْقًا لِلمُوضَة أَوِ الأُسْلُوب السَّائِد حَالِيًّا) / آخر الأخبار, مستجدات (أحدث الأخبار أو التطورات)\nمثال: هل سمعت آخر الأخبار؟",
 "latex": "طلاء اللاتكس (طلاء مائي يحتوي على مادة رابطة من اللاتكس) / لاتكس, لثى (إفراز حليبي من بعض النباتات يتخثر عند تعرضه للهواء)",
 "latex paint": "طلاء اللاتكس (طلاء مائي يحتوي على مادة رابطة من اللاتكس)",
 "lath": "شريحة خشبية (شريط رفيع ضيق من الخشب يستخدم كدعم للجص أو لعمل الشبكات الخشبية)",
 "lath and plaster": "شرائح خشبية وجص (مادة بناء تتكون من شرائح رقيقة من الخشب توفر أساساً لطبقة من الجص)",
 "lathe": "مِخْرَطَة",
 "lathee": "هراوة لاثي (هراوة تتكون من عصا ثقيلة (غالباً من الخيزران) مربوطة بالحديد؛ تستخدمها الشرطة في الهند)",
 "lather": "زبد العرق (الرغوة الناتجة عن التعرق المفرط (كما في الحصان)) / رغوة الصابون (الرغوة التي ينتجها الصابون أو المنظفات) / مركب ألواح الجص (هو مَرْكَبَة للبحر، أكبر من القَارِب وأصغر السَفِينَة) / غمة, قلق (هياج ناتج عن قلق نشط)\nمثال: لا تقع في الهم\nمثال: أطلقت الشرطة النار على إطارات مركبة توم.",
 "lathery": "رغوي, صابوني (يشبه الرغوة أو مغطى بالرغوة)",
 "lathi": "هراوة لاثي (هراوة تتكون من عصا ثقيلة (غالباً من الخيزران) مربوطة بالحديد؛ تستخدمها الشرطة في الهند)",
 "lathyrus hirsutus": "بازلاء سنجلتاري, جلبان مشعر (نبات حولي شتوي ضعيف الساق موطنه منطقة البحر الأبيض المتوسط واستقر منذ فترة طويلة في جنوب الولايات المتحدة؛ يزرع كمحصول تغطية ومرعى)",
 "lathyrus japonicus": "بازلاء الشاطئ, جلبان بحري (بازلاء برية في شواطئ المنطقة المعتدلة الشمالية لها جذور قوية وزهور أرجوانية ومفيدة كمثبت للرمال)",
 "lathyrus latifolius": "بازلاء دائمة عريضة الأوراق, جلبان عريض الأوراق (نبات متسلق معمر من وسط وجنوب أوروبا له زهور أرجوانية أو وردية أو بيضاء؛ تم توطينه في أمريكا الشمالية)",
 "lathyrus maritimus": "بازلاء الشاطئ, جلبان بحري (بازلاء برية في شواطئ المنطقة المعتدلة الشمالية لها جذور قوية وزهور أرجوانية ومفيدة كمثبت للرمال)",
 "lathyrus niger": "بازلاء سوداء, جلبان أسود (نبات معمر من أوروبا وشمال إفريقيا؛ تتحول أوراقه إلى اللون الأسود عند التجفيف)",
 "lathyrus nissolia": "بيقية عشبية, جلبان عشبي (نبات بيقية حولي أوروبي ذو زهور حمراء)",
 "lathyrus odoratus": "بازلاء عطرية, بسلة الزهور (نبات حدائق متسلق له أزهار عطرة بألوان الباستيل)",
 "lathyrus palustris": "بازلاء المستنقعات, جلبان المستنقعات (نبات معمر متسلق في المناطق الرطبة أو المستنقعية في أوراسيا وأمريكا الشمالية بزهور أرجوانية)",
 "lathyrus pratensis": "بازلاء المروج, بيقية شائعة (بازلاء برية أوراسية معمرة متسلقة لها زهور مصفرة وقرون بذور مضغوطة؛ تزرع للعلف)",
 "lathyrus sativus": "بيقية هندية, جلبان (نبات حولي أوروبي يزرع للعلف؛ تستخدم بذوره كغذاء في الهند وعلف للماشية في أماكن أخرى)",
 "lathyrus splendens": "جلبان رائع, فخر كاليفورنيا (نبات معمر شجيري كاليفورني له زهور وردية أو بنفسجية كبيرة؛ يزرع للزينة)",
 "lathyrus sylvestris": "بازلاء مسطحة, جلبان حرجي (نبات معمر أوروبي ذو زهور مرقشة باللون الأرجواني والوردي؛ يزرع أحياناً كعلف أو سماد أخضر)",
 "lathyrus tuberosus": "بسلة الأرض, جلبان درني (عشب أوروبي يحمل درنات صغيرة تستخدم للغذاء وفي اسكتلندا لتنكيه الويسكي)",
 "lathyrus vernus": "جلبان ربيعي (نبات معمر أوروبي كثيف له زهور بنفسجية زرقاء عنقودية مائلة للأسفل)",
 "laticifer": "قناة لبنية (قناة نباتية تحتوي على اللاتكس)",
 "latimeria chalumnae": "سمك السيلاكانث (سمكة كان يُعتقد أنها انقرضت منذ العصر الطباشيري ولكن عُثر عليها عام 1938 قبالة سواحل أفريقيا)",
 "latin": "لَاتِينِيّ, الرُّومِيَّة (المنسوب إلى لَاتِيْن، وهي المنطقة المحيطة بمدينة روما والتي كان الروم يسمونها لاتين وأصبح اسمها الآن لَازِيَوْ؛ المنسوب إلى اللاتين، وهم دول أمريكا الجنوبية والوسطى الذين يتحدثون لغات من أصل لاتيني، خصوصا الإسبانية والبرتغالية) / لَاتِينِيّ, الرُّومِيّ (المنسوب إلى لَاتِيْن، وهي المنطقة المحيطة بمدينة روما والتي كان الروم يسمونها لاتين وأصبح اسمها الآن لَازِيَوْ؛ المنسوب إلى اللاتين، وهم دول أمريكا الجنوبية والوسطى الذين يتحدثون لغات من أصل لاتيني، خصوصا الإسبانية والبرتغالية)\nمثال: العديد من الكلمات الإنجليزية أصلها لاتيني.",
 "latin alphabet": "كِتَابَة لَاتِينِيَّة, لَاتِينِيَّة (الخَطّ أو ما كُتِبَ؛ ما يُكْتَبُ عموما)\nمثال: تعبت من الكتابة.",
 "latin america": "أَمْرِيكَا اَللَّاتِينِيَّة",
 "latin american": "أمريكي لاتيني, لاتيني (مواطن من أمريكا اللاتينية)",
 "latin church": "الكنيسة اللاتينية",
 "latin cross": "صليب لاتيني (صليب يكون ذراعه السفلي أطول من الأذرع الأخرى)",
 "latin square": "مربع لاتيني (كُلُّ ما يُرَبَّعُ؛ كُلُّ ما له أربعة أركانٍٍ)\nمثال: لا توجد مثلثات مربعة.",
 "latin-american": "أمريكي لاتيني (مكون من أو متعلق بدول أمريكا اللاتينية أو شعوبها)\nمثال: دول أمريكا اللاتينية",
 "latinate": "لاتيني الطابع, متلتن (مشتق من اللاتينية أو مقلد لها)",
 "latinesce": "لاتينيسك (لغة مصطنعة مشتقة من الإسبرانتو، وبشكل غير مباشر، من اللاتينية)",
 "latinian language": "اللغات الرومانسية (مجموعة اللغات المشتقة من اللاتينية)",
 "latinise": "كَوْثَلَ (تسبب في اعتناق الكاثوليكية)",
 "latinism": "لاتينية (كلمة أو عبارة مستعارة من اللاتينية)",
 "latinist": "متخصص في اللاتينية (متخصص في اللغة اللاتينية)",
 "latinization": "لَاتِينِيَّة (المنسوبة إلى المنطقة المحيطة بمدينة روما والتي كانت تسمى لَاتِيْن في عصر الروم وأصبحت الآن تسمى لَازِيُو؛ المنسوبة إلى اللَاتِيْن، وهم دول أمريكا الشمالية والوسطى الذين يتحدثون لغات من أصل لاتينيّ، خصوصا الإِسْبَانِيَّة والبُرْتُغَالِيَّة)\nمثال: أعرف اللاتينية.",
 "latinize": "كَوْثَلَ (تسبب في اعتناق الكاثوليكية)",
 "latino": "لاتيني, هسباني (متعلق بشعوب أو ثقافة ناطقة بالإسبانية) / أمريكي لاتيني, لاتيني (مواطن من أمريكا اللاتينية)\nمثال: السكان الهسبان في كاليفورنيا يزدادون بسرعة",
 "latish": "مُتَأَخِّرٌ نَوْعاً مَا (متأخّر إلى حدّ ما)",
 "latissimus dorsi": "ظَهْرِيَّة عَرِيضَة",
 "latitude": "دَائِرَة عَرْض, خَطّ عَرْض (في : الشكل الهندسي الذي ليس له نقطة بداية ولا نهاية ويتكون من قَوْس مستمر؛ الهيئة أو الجهة التي تدير امرا ما)\nمثال: رجاء ضع دائرة حول الجواب الصحيح.",
 "latitudinal": "عرضي (متعلق بدوائر العرض شمالاً أو جنوباً)",
 "latitudinarian": "حُرّ الفِكْر, لَاعَقَائِدِيّ (يَرْفُض الانْصِيَاع لِلسُّلْطَة أَوِ العَقِيدَة الجَامِدَة (خَاصَّةً فِي الدِّين)) / متسامح (شخص واسع الأفق ومتسامح (خاصة في معايير المعتقد والسلوك الديني))",
 "latium": "لَاتْيُوم",
 "latke": "فطيرة البطاطس, لاتكس (مصنوعة من البطاطس المبشورة والبيض مع قليل من الدقيق)",
 "latona": "لاتونا, ليتو (زوجة أو عشيقة زيوس ووالدة أبولو وأرتميس في الأساطير القديمة؛ تسمى لاتونا في الأساطير الرومانية)",
 "latria": "توقير, عبادة (العبادة المقدمة لله وحده)",
 "latrine": "دورة مياه عسكرية, مرحاض ميداني (مرحاض عام في منطقة عسكرية)",
 "latrodectus mactans": "أرملة سوداء (عنكبوت سام من العالم الجديد؛ الأنثى سوداء بعلامة حمراء على شكل ساعة رملية على الجانب السفلي من البطن)",
 "lats": "لاتس (وحدة المال الأساسية في لاتفيا)",
 "latte": "لَاتَيه",
 "latten": "صفائح نحاسية مطروقة, لاتين (نحاس أصفر (أو سبيكة صفراء تشبه النحاس الأصفر) كانت تطرق لتتحول إلى صفائح رقيقة؛ كانت تستخدم قديماً لأواني الكنيسة)",
 "latter": "الأخير, المذكور آخراً (الثاني من بين اثنين أو المذكور ثانياً بين اثنين)\nمثال: كان توم وديك بطلين لكن الأخير فقط هو من يُذكر اليوم",
 "latter-day": "حَدِيث, مُعَاصِر (يَنْتَمِي لِلْعَصْرِ الحَالِيِّ أَوِ الأَزْمِنَةِ الأَخِيرَة)",
 "latter-day saint": "قديس الأيام الأخيرة, مورموني (عضو في كنيسة يسوع المسيح لقديسي الأيام الأخيرة)",
 "latterly": "حديثاً, في الآونة الأخيرة (في الماضي القريب)\nمثال: كان في باريس مؤخراً",
 "lattice": "شبكة خشبية (هيكل يتكون من تصميم زخرفي مصنوع من شرائط من الخشب أو المعدن) / شباك صغير, كوة (فتحة صغيرة (مثل نافذة في باب) يمكن من خلالها إجراء المعاملات) / شبكة بلورية, شبيكة (ترتيب للنقاط أو الجسيمات أو الأشياء في نمط دوري منتظم في بعدين أو 3 أبعاد)",
 "latticed": "مُتَشَابِك, مُشَبَّك (ذو نمط زخرفيّ شبكيّ أو مُخرَّم)",
 "latticelike": "مُتَشَابِك, مُشَبَّك (ذو نمط زخرفيّ شبكيّ أو مُخرَّم)",
 "latticework": "شبكة خشبية (هيكل يتكون من تصميم زخرفي مصنوع من شرائط من الخشب أو المعدن)",
 "latvia": "لَاتْفِيَا",
 "latvian": "لَاتْفِيّ",
 "latvian monetary unit": "وحدة نقدية لاتفية (الوحدة النقدية في لاتفيا)",
 "latvianness": "الطابع اللاتفي (حالة أو جودة كون الشيء لاتفياً)",
 "laudability": "جَدَارَة بِالثَّنَاء, مَحْمَدَة (صفة كون الشيء مستحقاً للمدح)",
 "laudable": "جَدِيرٌ بِالثَّنَاءِ, مَحْمُود (يَسْتَحِقُّ الثَّنَاءَ الكَبِيرَ وَالتَّقْدِيرَ)",
 "laudableness": "جَدَارَة بِالثَّنَاء, مَحْمَدَة (صفة كون الشيء مستحقاً للمدح)",
 "laudably": "بشكل جدير بالثناء, بشكل مثير للإعجاب (بطريقة مثيرة للإعجاب)\nمثال: كانت استجابات الأطفال طبيعية بشكل مثير للإعجاب",
 "laudanum": "صبغة الأفيون, لودانوم (مخدر يتكون من محلول كحولي للأفيون أو أي مستحضر يكون الأفيون فيه المكون الرئيسي)",
 "laudator": "مادح (شخص يبلغ الثناء العالي)",
 "laudatory": "إِطْرَائِيّ, ثَنَائِيّ (مَلِيء بالثناء أو يُقَدِّم المديح)",
 "lauder": "مادح (شخص يبلغ الثناء العالي)",
 "laugh": "ضَحْكَة / ضَحِكَ, ضحك (أثار الضحك أو جعل شخصًا يضحك بشيء مضحك أو طريف؛ سلّى أو أبهج شخصًا بجعل الأجواء مرحة)\nمثال: ضحك الجميع علي.",
 "laugh line": "بيت القصيد, خاتمة النكتة (مغزى نكتة أو قصة فكاهية) / تجاعيد الضحك, قدم الغراب (تجعد في الجلد عند الزاوية الخارجية للعينين)",
 "laugh track": "مسار الضحك المسجل (ضحك مسجل مسبقاً يضاف إلى المسار الصوتي لبرنامج إذاعي أو تلفزيوني)",
 "laughable": "كُومِيدِيّ, مُضْحِك (يُثير الضحك أو يستدعيه) / سَخِيف, مُثِير لِلسُّخْرِيَة (بالغ اللامعقوليّة بحيث يستدعي الاستهزاء والسخرية)",
 "laughably": "بشكل مضحك, بشكل يثير السخرية (بشكل يثير الضحك أو يستحقه)\nمثال: كان دخلها صغيراً بشكل مضحك، لكنها تمكنت من العيش بشكل جيد",
 "laugher": "ضَاحِك",
 "laughing dove": "قُمْرِيّ, شِفْنِين",
 "laughing gas": "أكسيد النيتروز, غاز الضحك (مخدر استنشاقي يستخدم كمخدر في طب الأسنان والجراحة)",
 "laughing gull": "نورس ضاحك (نورس أوروبي صغير أسود الرأس)",
 "laughing hyena": "ضبع ضاحك, ضبع مرقط (ضبع أفريقي يشتهر بعوائه المميز)",
 "laughing jackass": "بومة ضاحكة (بومة شبه منقرضة من نيوزيلندا) / كوكابورا (رفراف أسترالي له صرخة عالية تشبه القهقهة)",
 "laughing kookaburra": "كوكابورا",
 "laughing owl": "بومة ضاحكة (بومة شبه منقرضة من نيوزيلندا)",
 "laughing stock": "أُضْحُوكَة, مَضْحَكَة",
 "laughingly": "ضاحكاً, مع الضحك (مع الضحك؛ أثناء الضحك)\nمثال: روى القصة ضاحكاً",
 "laughingstock": "أضحوكة, هدف السخرية (ضحية للسخرية أو المقالب)",
 "laughter": "ضَحِك, ضِحْك (أثار الضحك أو جعل شخصًا يضحك بشيء مضحك أو طريف؛ سلّى أو أبهج شخصًا بجعل الأجواء مرحة)\nمثال: ضحك الجميع علي.",
 "laughter is the best medicine": "الضحك افضل دواء",
 "lauhala": "كاذي سقفي, لاوهالا (صنوبر لولبي بولينيزي)",
 "launce": "رماه الرمال, سمك الرمل (أسماك صغيرة جداً فضية اللون تشبه الثعابين تعيش في أسراب وتحفر في الشواطئ الرملية)",
 "launch": "أَطْلَقَ, قَذَفَ",
 "launch area": "منصة إطلاق (منصة تطلق منها الصواريخ أو المركبات الفضائية)",
 "launch pad": "منصة إطلاق (منصة تطلق منها الصواريخ أو المركبات الفضائية)",
 "launcher": "قاذفة إقلاع, منجنيق (جهاز يطلق الطائرات من على متن سفينة حربية) / قاذفة, منصة إطلاق (تسليح على شكل جهاز قادر على إطلاق صاروخ)",
 "launching": "إطلاق, قذف (فعل الدفع بقوة) / إطلاق سفينة, تدشين (فعل تحريك سفينة مبنية حديثاً إلى الماء لأول مرة) / إطلاق, تدشين (فعل البدء بشيء جديد)\nمثال: تطلعوا إلى الظهور الأول لخط إنتاجهم الجديد",
 "launching pad": "منصة إطلاق (منصة تطلق منها الصواريخ أو المركبات الفضائية)",
 "launching site": "موقع إطلاق (مكان لمنصات الإطلاق)",
 "launchpad": "منصة إطلاق (منصة تطلق منها الصواريخ أو المركبات الفضائية)",
 "launderette": "مغسلة ذاتية (مغسلة ذاتية الخدمة حيث تتوفر غسالات تعمل بقطع النقود المعدنية للعملاء الأفراد)",
 "laundering": "تبييض, غسيل الملابس (غسل الملابس وبياضات الأسرّة)",
 "laundress": "غسالة (امرأة عاملة تستقبل الغسيل)",
 "laundromat": "مغسلة ذاتية (مغسلة ذاتية الخدمة حيث تتوفر غسالات تعمل بقطع النقود المعدنية للعملاء الأفراد)",
 "laundry": "غَسِيل, غَسْل / مَصْبَغَة, مَغْسَلَة / مَغْسَلَة (مكان الغسل، لا تخلط بينها وبين مِغْسَلَة؛ حانوت يقوم بغسل وكيّ الملابس وغيرها من الستائر والبُسُط مقابل أجر)\nمثال: كان في المغسلة.",
 "laundry basket": "سلة غسيل (سلة توضع فيها الملابس المتسخة لغسلها أو الملابس المبللة لتجفيفها)",
 "laundry cart": "عربة غسيل (عربة يدوية لنقل حمولة من الغسيل)",
 "laundry detergent": "منظف الغسيل (أي من المنظفات المختلفة المصممة للاستخدام في الغسالة للملابس)",
 "laundry stiffener": "مقوم النسيج, منشي الملابس (مستحضر يضاف إلى الغسيل لتقوية النسيج)",
 "laundry truck": "شاحنة المغسلة (شاحنة تلتقط وتسلم الغسيل)\nمثال: شاحنة المغسلة تتوقف كل أسبوع",
 "laundryman": "غسال (رجل يشغل غسالة صناعية)",
 "laundrywoman": "غسالة (امرأة عاملة تستقبل الغسيل)",
 "laureate": "جَدِير بِأَعْلَى تَكْرِيم, مُتَوَّج (يستحقّ أعلى شرف أو تمييز) / حائز على جائزة, مُتوَّج (شخص مكرم لإنجازات عظيمة)",
 "laurel": "غَار",
 "laurel cherry": "غار الكرز, كرز الغار (شجرة مزهرة صغيرة دائمة الخضرة من جنوب الولايات المتحدة) / غار الكرز, كرز الغار (شجيرة أو شجرة صغيرة أوراسية دائمة الخضرة تزرع كثيراً، لها عناقيد بارزة من الزهور البيضاء وأوراق لامعة وتنتج زيتاً يشبه زيت اللوز المر)",
 "laurel oak": "بلوط الألواح, بلوط الغار (شجرة متساقطة الأوراق صغيرة من شرق ووسط الولايات المتحدة لها أوراق تلمع مثل الغار؛ يستخدم الخشب في الولايات الغربية للألواح الخشبية) / بلوط الغار (بلوط كبير شبه دائم الخضرة تقريباً من جنوب شرق الولايات المتحدة؛ يزدهر في التربة الرطبة)",
 "laurel sumac": "سماق الغار, مالوسما (شجيرة عطرية صغيرة دائمة الخضرة من كاليفورنيا لها أوراق عنقودية وتوت مبيض؛ في بعض التصنيفات تدرج في جنس السماق)",
 "laurel willow": "صفصاف الغار, صفصاف خماسي الأسدية (شجرة صفصاف أوروبية بأوراق جلدية لامعة؛ متوطنة على نطاق واسع في شرق الولايات المتحدة)",
 "laurel wreath": "إِكْلِيل الْغَار",
 "laurel-tree": "بيرسيا بوربونيا, غار أحمر (شجرة صغيرة في جنوب الولايات المتحدة ذات خشب قلب أحمر داكن)",
 "laureled": "متوج بالغار, مكلل (متوج بالغار أو كما لو كان به كرمز للنصر)",
 "laurelled": "متوج بالغار, مكلل (متوج بالغار أو كما لو كان به كرمز للنصر)",
 "laurels": "تكريم, جائزة (رمز ملموس يدل على الاستحسان أو التميز) / تكريم, شرف (حالة كونه مكرماً)\nمثال: جائزة للشجاعة",
 "laurelwood": "خشب الرمح, خشب الغار (شجرة أمريكية استوائية؛ تقدر لخشبها الصلب المتين)",
 "laurence": "لورانس",
 "lauric acid": "حمض اللوريك (حمض دهني بلوري يحدث كغليسريدات في الدهون والزيوت الطبيعية (خاصة زيت جوز الهند وزيت نواة النخيل))",
 "laurus nobilis": "شجرة الغار, غار (شجرة متوسطية صغيرة دائمة الخضرة ذات ثمار سوداء صغيرة وأوراق عطرية لامعة تستخدم للنكهة في الطهي؛ استخدمها الإغريق القدماء أيضاً لتتويج المنتصرين)",
 "lauryl alcohol": "كحول اللوريل (كحول صلب عديم اللون غير قابل للذوبان يستخدم لصنع المنظفات والأدوية)",
 "lav": "حمام, دورة مياه (غرفة أو مبنى مجهز بمرحاض واحد أو أكثر)",
 "lava": "حُمَم بُرْكَانِيَّة, لَابَة (الماء: سَخَّنَه؛ الغلام: بدت لحيته)",
 "lavabo": "حوض غسيل, مغسلة (حوض لغسل اليدين)",
 "lavage": "غسيل, غسيل معدي (غسل عضو مجوف (خاصة المعدة) عن طريق الدفق بالماء)",
 "lavalava": "لافالافا (تنورة تتكون من مستطيل من الكاليكو أو القطن المطبوع؛ يرتديها البولينيزيون (وخاصة السامويين))",
 "lavalier": "قلادة متدلية (قلادة مرصعة بالجواهر تلبس بسلسلة حول العنق)",
 "lavaliere": "قلادة متدلية (قلادة مرصعة بالجواهر تلبس بسلسلة حول العنق)",
 "lavalliere": "قلادة متدلية (قلادة مرصعة بالجواهر تلبس بسلسلة حول العنق)",
 "lavandula angustifolia": "خزامى إنجليزية, ضرم ضيق الأوراق (شجيرة متوسطية عطرية تزرع على نطاق واسع لزهورها الليلكية التي تجفف وتستخدم في أكياس التعطير)",
 "lavandula latifolia": "خزامى سنبلية, ضرم عريض الأوراق (نبات متوسطي ذو زهور أرجوانية شاحبة ينتج زيت الخزامى السنبلي)",
 "lavandula officinalis": "خزامى إنجليزية, ضرم ضيق الأوراق (شجيرة متوسطية عطرية تزرع على نطاق واسع لزهورها الليلكية التي تجفف وتستخدم في أكياس التعطير)",
 "lavandula stoechas": "خزامى فرنسية, ضرم سطوخي (خزامى شجيرية رمادية في جنوب غرب أوروبا ذات زهور أرجوانية محمرة عادة)",
 "lavash": "لَافَاش",
 "lavatera arborea": "خبازة شجرية, ورقة المخمل (شجيرة معمرة شجرية ذات أوراق فروية مفصصة كفياً وأزهار حمراء أرجوانية مبهرجة؛ جنوب غرب الولايات المتحدة)",
 "lavation": "غسل, غسيل (عمل التنظيف (عادة بالماء والصابون))",
 "lavatory": "مرحاض دافق (مرحاض يتم تنظيفه من الفضلات عن طريق تدفق المياه عبره) / حمام, دورة مياه (غرفة أو مبنى مجهز بمرحاض واحد أو أكثر) / مغسلة (حوض حمام مثبت بشكل دائم ومتصل بمصدر للمياه وأنبوب تصريف؛ حيث يمكنك غسل يديك ووجهك)\nمثال: شغل بعض الماء في المغسلة ورشه على وجهه",
 "lavender": "خُزَامَى, ضِرْم",
 "lavender cotton": "قيصوم قطني, لافندر القطن (شجيرة متوسطية عطرية متفرعة ذات سيقان وأوراق صوفية وأزهار صفراء)",
 "lavender-pink": "وَرْدِيّ بَنَفْسَجِيّ, وَرْدِيّ لَيْلَكِيّ (وردي مع مسحة خزامية)",
 "lavender-tinged": "مَصْبُوغ بِالخُزَامِيّ (بلون ممزوج بمسحة خزامية)",
 "laver": "خس البحر (عشب بحري ذو سعف أخضر مجعد شفاف صالح للأكل) / لافر أحمر (أعشاب بحرية حمراء صالحة للأكل) / حوض تطهير, مغسل ((العهد القديم) حوض كبير استخدمه الكهنة في المعابد اليهودية القديمة لأداء طقوس الاغتسال)",
 "lavish": "بَاذِخ, مُسْرِف فِي العَطَاء (بالغ السخاء؛ يُعطي بإسراف ودون حساب) / بَاذِخ, سَخِيّ (يتميّز بالإسراف والوفرة)",
 "lavishly": "ببذخ, بسخاء (بطريقة غنية ومسرفة) / بإسراف, ببذخ (بطريقة مبذرة)\nمثال: مزينة ببذخ",
 "lavishness": "إسراف, بذخ (نشاط الإنفاق المفرط) / بذخ, ترف (الجودة التي يمتلكها شيء باهظ الثمن بشكل مفرط)",
 "law": "قَانُون, حُقُوق (مقياس كل شيء وطريقه؛ أمر كليّ ينطبق على جميع جزئياته التي تعرف أحكامها منه) / قَانُون (مقياس كل شيء وطريقه؛ أمر كليّ ينطبق على جميع جزئياته التي تعرف أحكامها منه)\nمثال: ذكرني بالقانون.",
 "law agent": "وكيل قانوني (محامي استشاري في اسكتلندا)",
 "law court": "دار العدالة, محكمة قانونية (محكمة يترأسها قاضي صلح أو قاض واحد أو أكثر يديرون العدالة وفقاً للقوانين)",
 "law degree": "درجة في القانون (درجة تُمنح لشخص يكمل بنجاح كلية الحقوق)",
 "law enforcement": "إنفاذ القانون (ضمان طاعة القوانين)",
 "law enforcement agency": "وكالة إنفاذ القانون (وكالة مسؤولة عن ضمان الامتثال للقوانين)",
 "law firm": "شركة محاماة, مكتب محاماة (شركة من المحامين)",
 "law merchant": "قانون تجاري (مجموعة القواعد المطبقة على المعاملات التجارية؛ مستمدة من ممارسات التجار بدلاً من الفقه القانوني)",
 "law of action and reaction": "قانون الفعل ورده الفعل, قانون نيوتن الثالث (لكل فعل رد فعل مساوٍ له في المقدار ومعاكس له في الاتجاه)",
 "law of archimedes": "قانون أرخميدس, مبدأ أرخميدس ((هيدروستاتيكا) الفقد الظاهري في وزن جسم مغمور في مائع يساوي وزن المائع المزاح)",
 "law of areas": "قانون المساحات, قانون كبلر الثاني (قانون يتعلق بالسرعة التي تسافر بها الكواكب؛ الخط الواصل بين الكوكب والشمس يمسح مساحات متساوية في أزمنة متساوية)\nمثال: يعني قانون كبلر الثاني أن السرعة المدارية للكوكب تتغير مع بعده عن الشمس",
 "law of averages": "قانون المتوسطات (قانون يؤكد أنه على المدى الطويل ستحدد الاحتمالات الأداء)",
 "law of chemical equilibrium": "قانون التوازن الكيميائي ((كيمياء) المبدأ القائل بأنه (عند التوازن الكيميائي) في تفاعل عكسي، تكون نسبة معدل التفاعل الأمامي إلى معدل التفاعل العكسي ثابتة لذلك التفاعل)",
 "law of closure": "إغلاق, قانون الإغلاق (مبدأ تنظيم غيشتالتي ينص على وجود ميل فطري لإدراك الأشياء غير المكتملة على أنها مكتملة وسد الثغرات وإدراك المحفزات غير المتماثلة على أنها متماثلة)",
 "law of common fate": "المصير المشترك, قانون المصير المشترك (مبدأ تنظيم غيشتالتي ينص على أن جوانب المجال الإدراكي التي تتحرك أو تعمل بطريقة مماثلة سيتم إدراكها كوحدة واحدة)",
 "law of conservation of energy": "حفظ الطاقة, قانون حفظ الطاقة (المبدأ الأساسي في الفيزياء القائل بأن الطاقة الكلية لنظام معزول ثابتة على الرغم من التغيرات الداخلية)",
 "law of conservation of mass": "حفظ الكتلة, قانون حفظ المادة (مبدأ أساسي في الفيزياء الكلاسيكية ينص على أن المادة لا تفنى ولا تستحدث في نظام معزول)",
 "law of conservation of matter": "حفظ الكتلة, قانون حفظ المادة (مبدأ أساسي في الفيزياء الكلاسيكية ينص على أن المادة لا تفنى ولا تستحدث في نظام معزول)",
 "law of constant proportion": "قانون النسب الثابتة ((كيمياء) قانون ينص على أن كل مادة نقية تحتوي دائمًا على نفس العناصر مجتمعة بنفس النسب بالوزن)",
 "law of continuation": "الاستمرارية الجيدة, قانون الاستمرارية (مبدأ تنظيم غيشتالتي ينص على وجود ميل فطري لإدراك الخط كاستمرار لاتجاهه المحدد)",
 "law of definite proportions": "قانون النسب الثابتة ((كيمياء) قانون ينص على أن كل مادة نقية تحتوي دائمًا على نفس العناصر مجتمعة بنفس النسب بالوزن)",
 "law of diminishing returns": "قانون تناقص العوائد (قانون يؤكد أن الاستمرار بعد الوصول إلى مستوى معين من الأداء سيؤدي إلى انخفاض في الفعالية)",
 "law of effect": "قانون الأثر ((علم النفس) المبدأ القائل بأن السلوكيات يتم اختيارها بناءً على عواقبها؛ السلوك الذي له عواقب جيدة يميل إلى التكرار بينما السلوك الذي يؤدي إلى عواقب…)",
 "law of equal areas": "قانون المساحات, قانون كبلر الثاني (قانون يتعلق بالسرعة التي تسافر بها الكواكب؛ الخط الواصل بين الكوكب والشمس يمسح مساحات متساوية في أزمنة متساوية)\nمثال: يعني قانون كبلر الثاني أن السرعة المدارية للكوكب تتغير مع بعده عن الشمس",
 "law of equivalent proportions": "قانون النسب المكافئة ((كيمياء) قانون ينص على أن النسب التي يتحد بها عنصران بشكل منفصل مع عنصر ثالث هي أيضًا النسب التي يتحدان بها معًا)",
 "law of gravitation": "قانون الجاذبية, قانون نيوتن للجاذبية ((فيزياء) القانون الذي ينص على أن أي جسمين يتجاذبان بقوة تتناسب طردياً مع حاصل ضرب كتلتيهما وعكسياً مع مربع المسافة بينهما)",
 "law of independent assortment": "قانون التوزيع المستقل (ينفصل كل عضو من زوج الكروموسومات المتماثلة بشكل مستقل عن أعضاء الأزواج الأخرى، لذا تكون النتائج عشوائية)",
 "law of large numbers": "قانون الأعداد الكبيرة ((إحصاء) قانون ينص على أن عددًا كبيرًا من العناصر المأخوذة عشوائيًا من مجتمع إحصائي سيكون له (في المتوسط) إحصائيات المجتمع)",
 "law of mass action": "قانون فعل الكتلة ((كيمياء) القانون الذي ينص على المبدأ التالي: معدل التفاعل الكيميائي يتناسب طردياً مع التركيزات الجزيئية للمواد المتفاعلة)",
 "law of moses": "شريعة موسى (القوانين (بدءاً من الوصايا العشر) التي أعطاها الله لبني إسرائيل عن طريق موسى؛ وتتضمن العديد من قواعد الشعائر الدينية الواردة في الكتب الخمسة الأولى…)",
 "law of motion": "قانون الحركة, قانون نيوتن للحركة (أحد القوانين الأساسية الثلاثة للميكانيكا الكلاسيكية)",
 "law of multiple proportions": "قانون النسب المتضاعفة ((كيمياء) قانون ينص على أنه عندما يمكن لعنصرين أن يتحدوا لتكوين أكثر من مركب واحد، فإن كميات أحدهما التي تتحد مع كمية ثابتة من الآخر ستظهر علاقة…)",
 "law of nations": "قانون دولي (مجموعة القوانين التي تحكم العلاقات بين الدول)",
 "law of nature": "قانون, قانون طبيعي (تعميم يصف حقائق أو أحداث متكررة في الطبيعة)\nمثال: قوانين الديناميكا الحرارية",
 "law of parsimony": "مبدأ الإيجاز, نصل أوكام (المبدأ القائل بأنه لا ينبغي مضاعفة الكيانات دون داع؛ يجب تفضيل أبسط النظريتين المتنافستين)",
 "law of partial pressures": "قانون الضغوط الجزئية, قانون دالتون ((كيمياء وفيزياء) قانون ينص على أن الضغط الذي يمارسه خليط من الغازات يساوي مجموع الضغوط الجزئية للغازات في الخليط)",
 "law of proximity": "التقارب, قانون التقارب (مبدأ تنظيم غيشتالتي ينص على أن الأشياء أو الأحداث القريبة من بعضها البعض (في المكان أو الزمان) يُنظر إليها على أنها تنتمي لبعضها البعض كوحدة واحدة…)",
 "law of reciprocal proportions": "قانون النسب المكافئة ((كيمياء) قانون ينص على أن النسب التي يتحد بها عنصران بشكل منفصل مع عنصر ثالث هي أيضًا النسب التي يتحدان بها معًا)",
 "law of segregation": "قانون الانعزال (تنفصل أعضاء زوج الكروموسومات المتماثلة أثناء تكوين الأمشاج وتتوزع على أمشاج مختلفة بحيث يتلقى كل مشيج عضوًا واحدًا فقط من الزوج)",
 "law of similarity": "التشابه, قانون التشابه (مبدأ تنظيم غيشتالتي ينص على أن أجزاء مجال التحفيز المتشابهة تميل إلى أن يُنظر إليها على أنها تنتمي لبعضها البعض كوحدة واحدة (مع تساوي العوامل الأخرى))",
 "law of the jungle": "شريعَة الغاب, قانون الغابَة (النهج والتبيين؛ العتبة)\nمثال: ما معنى كلمة \"شريعة\"؟",
 "law of the land": "قانون البلاد (عبارة استخدمت في الماجنا كارتا للإشارة إلى القانون الراسخ للمملكة آنذاك (التميز عن القانون الروماني أو المدني)؛ اليوم تشير إلى المبادئ الأساسية…)\nمثال: يعلن دستور الولايات المتحدة نفسه على أنه 'القانون الأعلى للبلاد'",
 "law of thermodynamics": "قانون الديناميكا الحرارية ((فيزياء) قانون يحكم العلاقات بين حالات الطاقة في نظام مغلق)",
 "law of volumes": "قانون الأحجام, قانون شارل ((فيزياء) كثافة الغاز المثالي عند ضغط ثابت تتناسب عكسياً مع درجة الحرارة)",
 "law offender": "مخالف للقانون (شخص يخالف القانون)",
 "law officer": "رَجُل شُرْطَة, رَجُل قانُون (موظف مكلف بتطبيق القانون)",
 "law practice": "ممارسة المحاماة (مزاولة مهنة القانون)",
 "law school": "كلية الحقوق, كلية القانون (كلية دراسات عليا تقدم دراسة تؤدي إلى درجة في القانون)",
 "law student": "طالب حقوق (طالب في كلية الحقوق)",
 "law-abiding": "مُطِيع, مُلْتَزِم بِالقَانُون ((للأفراد) يلتزم بدقّة بالقوانين والقواعد والأعراف)",
 "law-abidingness": "الْتِزَام بِالقَانُون (خاصية الالتزام بالقانون أو طاعته)",
 "law-breaking": "جريمة, جناية ((القانون الجنائي) فعل يعاقب عليه القانون؛ عادة ما يعتبر فعلاً شريراً)\nمثال: سجل طويل من الجرائم",
 "law-makers": "سلطة تشريعية, مشرعون (أشخاص يسنون القوانين أو يعدلونها أو يلغونها)",
 "lawbreaker": "مخالف للقانون (شخص يخالف القانون)",
 "lawcourt": "دار العدالة, محكمة قانونية (محكمة يترأسها قاضي صلح أو قاض واحد أو أكثر يديرون العدالة وفقاً للقوانين)",
 "lawfare": "حرب القانون (حَرَبَ (حربه) بالحربة حربا: طعنه بها؛ حَرَبَ (ه) حربا: سلبه جميع ما يملك)\nمثال: بوتين مجرم حرب.",
 "lawful": "قانوني",
 "lawfully": "شَرْعًا, قَانُونِيًّا (بموجب القانون؛ مطابق للقانون) / بحق, بشكل قانوني (بطريقة مقبولة للعرف العام)\nمثال: نحن متزوجان قانونياً الآن",
 "lawfully-begotten": "مُنْجَب شَرْعِيًّا (وُلِدَ مِن زَواج شَرْعِيّ مُعْتَرَف بِه)",
 "lawfulness": "قَانُونِيَّة, مَشْرُوعِيَّة (صفة الامتثال للقانون)",
 "lawgiver": "مُشَرِّع, واضع القوانين (صانع للقوانين؛ شخص يضع مدونة قوانين)",
 "lawless": "فَوْضَوِيّ, لَا قَانُونِيّ (بِلَا قَانُونٍ أَوْ سَيْطَرَة) / خَارِج عَن القَانُون, فَوْضَوِيّ (عاصٍ للقانون أو متمرّد عليه) / بِلَا ضَوَابِط, مُتَسَاهِل (متراخٍ في تطبيق القوانين)",
 "lawlessly": "بشكل غير قانوني, خلسة (بطريقة غير قانونية)\nمثال: تخلصوا من النفايات بشكل غير قانوني",
 "lawlessness": "عَدَم وُجُود قَوَانِين (الفقدان ونقيض الوجود؛ يجب عدم فعل كذا: أي يجب الامتناع عن الفعل)\nمثال: عليك عدم الخوف.",
 "lawmaker": "مُشَرِّع, واضع القوانين (صانع للقوانين؛ شخص يضع مدونة قوانين)",
 "lawmaking": "تشريع, سن القوانين (عملية سن أو تشريع القوانين)",
 "lawman": "رجل قانون, شرطي (ضابط ذكر لإنفاذ القانون)",
 "lawn": "غَضْراء, مَرْجة",
 "lawn bowling": "الكرة الخشبية, بولينغ العشب (لعبة بولينغ تُلعب على عشب مستوٍ بكرات خشبية منحازة يتم دحرجتها نحو كرة هدف صغيرة)",
 "lawn cart": "برويطة, عربة يدوية بعجلة واحدة (عربة لحمل الأحمال الصغيرة؛ لها مقابض وعجلة واحدة أو أكثر)",
 "lawn chair": "كرسي حديقة (كرسي يترك في الخارج للاستخدام في الحديقة أو الفناء)",
 "lawn furniture": "أثاث الحدائق (أثاث مخصص للاستخدام على العشب أو في الحديقة)",
 "lawn mower": "جزازة العشب (أداة حديقة لجز العشب في المروج)",
 "lawn party": "حفلة حديقة, حفلة خارجية (حفلة يجتمع فيها الناس للتفاعل الاجتماعي في الهواء الطلق)",
 "lawn tennis": "تنس, كرة المضرب (لعبة تُلعب بمضارب من قبل لاعبين أو أربعة يضربون كرة ذهاباً وإياباً فوق شبكة تقسم الملعب)",
 "lawn tool": "أداة بستنة, أداة حديقة (أداة تستخدم للعمل في الحدائق أو الساحات)",
 "lawnmower": "جُزَازَة عُشْب",
 "lawrencium": "لُورِنْسِيُوم",
 "lawson's cedar": "أرز أوريغون, سرو لوسون (شجرة خشب كبيرة من غرب أمريكا الشمالية بقطر جذع يصل إلى 12 قدماً وارتفاع يصل إلى 200 قدم)",
 "lawson's cypress": "أرز أوريغون, سرو لوسون (شجرة خشب كبيرة من غرب أمريكا الشمالية بقطر جذع يصل إلى 12 قدماً وارتفاع يصل إلى 200 قدم)",
