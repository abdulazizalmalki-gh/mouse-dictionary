 "keffiyeh": "كُوفِيَّة, شُمَاغ",
 "kefir": "كِيفِير",
 "keflex": "سيفاليكسين, كيفليكس (مضاد حيوي من السيفالوسبورين (الأسماء التجارية كيفليكس وغيرها) يوصف عادة للعدوى الخفيفة إلى المتوسطة الشدة في الجلد أو الأذنين أو الحلق أو الرئتين أو…)",
 "keflin": "سيفاليكسين, كيفليكس (مضاد حيوي من السيفالوسبورين (الأسماء التجارية كيفليكس وغيرها) يوصف عادة للعدوى الخفيفة إلى المتوسطة الشدة في الجلد أو الأذنين أو الحلق أو الرئتين أو…)",
 "keftab": "سيفاليكسين, كيفليكس (مضاد حيوي من السيفالوسبورين (الأسماء التجارية كيفليكس وغيرها) يوصف عادة للعدوى الخفيفة إلى المتوسطة الشدة في الجلد أو الأذنين أو الحلق أو الرئتين أو…)",
 "keg": "برميل صغير (برميل خشبي صغير) / ملء برميل صغير (الكمية المحتواة في برميل صغير)",
