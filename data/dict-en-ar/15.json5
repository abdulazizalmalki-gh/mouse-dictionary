 "kali": "خريزة, شنان (نبات كثيف في المستنقعات المالحة وشواطئ البحر في العالم القديم ذو أوراق شائكة؛ يُحرق لإنتاج رماد الصودا الخام)",
 "kalian": "أرجيلة, شيشة (غليون تبغ شرقي ذو أنبوب مرن طويل متصل بوعاء حيث يتم تبريد الدخان بمروره عبر الماء)\nمثال: عالم ثنائي القطب مع الأرجيلة والقهوة التركية مقابل الهامبرغر والكوكا كولا",
 "kalif": "خليفة (الزعيم المدني والديني لدولة إسلامية ويعتبر ممثلاً لله على الأرض)\nمثال: يعتقد العديد من المسلمين المتطرفين أن الخليفة سيوحد جميع الأراضي والشعوب الإسلامية ويخضع بقية العالم",
 "kalimantan": "كَلِيمَنْتَان",
 "kaliningrad": "كَالِينِينْغْرَاد",
 "kaliph": "خليفة (الزعيم المدني والديني لدولة إسلامية ويعتبر ممثلاً لله على الأرض)\nمثال: يعتقد العديد من المسلمين المتطرفين أن الخليفة سيوحد جميع الأراضي والشعوب الإسلامية ويخضع بقية العالم",
 "kaliuresis": "بيلة بوتاسية (وجود البوتاسيوم الزائد في البول)",
 "kalka": "الخالخا (لغة الخالخا وهي اللغة الرسمية لجمهورية منغوليا الشعبية) / خالخا (الشعب المنغولي الذي يعيش في الأجزاء الوسطى والشرقية من منغوليا الخارجية)",
 "kalka language": "الخالخا (لغة الخالخا وهي اللغة الرسمية لجمهورية منغوليا الشعبية)",
 "kallman's syndrome": "متلازمة كالمان (قصور الغدد التناسلية مع فقدان الشم؛ اضطراب جنسي خلقي يمنع الخصيتين من النضوج عند البلوغ)",
 "kalmia": "كالميا (أي نبات من جنس كالميا)",
 "kalmia angustifolia": "غار الغنم, كلمية ضيقة الأوراق (شجيرة قزمية من أمريكا الشمالية تشبه غار الجبل ولكن بأوراق أضيق وزهور حمراء صغيرة؛ سامة للماشية الصغيرة)",
 "kalmia latifolia": "غار الجبل, كلمية عريضة الأوراق (شجيرة دائمة الخضرة من أمريكا الشمالية لها أوراق لامعة وزهور بيضاء أو وردية اللون)",
 "kalmia polifolia": "غار المستنقعات (غار مستنقعات شمال غرب الولايات المتحدة له زهور أرجوانية صغيرة وأوراق شاحبة زرقاء من الأسفل)",
 "kalmykia": "قلميقيا, كالميكيا",
 "kalon tripa": "كالون تريبا (رئيس الكاشاج (مجلس الوزراء) وهو في الأساس رئيس حكومة التبت في المنفى)",
 "kalpac": "قلق (قبعة سوداء عالية التاج (مصنوعة عادة من اللباد أو جلد الغنم) يرتديها الرجال في تركيا وإيران والقوقاز)",
 "kaluga": "كَالُوغَا",
 "kalumpang": "زيتون جاوة, كالومبانغ (شجرة كبيرة في المناطق الاستوائية بالعالم القديم ذات زهور برتقالية حمراء كريهة الرائحة تليها قرون حمراء تحيط ببذور غنية بالزيت تستخدم أحياناً كغذاء)",
 "kaluresis": "بيلة بوتاسية (وجود البوتاسيوم الزائد في البول)",
 "kam muang": "تاي يوان, كام موانغ (فرع من لغات تاي، يُتحدث به في عدة مقاطعات في تايلاند)",
 "kam-sui": "كام-سوي (مجموعة من لغات كاداي)",
 "kam-tai": "كام-تاي, لغات كاداي (عائلة من اللغات الصينية التبتية يتم التحدث بها في جنوب شرق آسيا)",
 "kama sutra": "كَامَاسُوتْرَا",
 "kamarupan": "لغات كاماروبان (لغة تبتية بورمية يتم التحدث بها في شمال شرق الهند والمناطق المجاورة في غرب بورما)",
 "kamarupan language": "لغات كاماروبان (لغة تبتية بورمية يتم التحدث بها في شمال شرق الهند والمناطق المجاورة في غرب بورما)",
 "kamba": "كامبا (لغة بانتو يتحدث بها الكامبا في كينيا)",
 "kamba language": "كامبا (لغة بانتو يتحدث بها الكامبا في كينيا)",
 "kamchatka": "كَامْتْشَاتْكَا, كَامْشَاتْكَا",
 "kamchatkan sea eagle": "عقاب البحر ستيلر (يوجد على سواحل شمال غرب المحيط الهادئ)",
 "kameez": "قميص هندي, كامي (سترة طويلة يرتديها الكثيرون في شبه القارة الهندية (عادة مع سروال أو تشوريدار))",
 "kami": "كامي (أحد آلهة الشنتو (بما في ذلك الكائنات الأسطورية، وأرواح الرجال المتميزين، وقوى الطبيعة))",
 "kamia": "لغة كاميا (اللغة اليومية التي يتحدث بها شعب كاميا) / كاميا (فرد من شعب هندي في أمريكا الشمالية في جنوب شرق كاليفورنيا وشمال غرب المكسيك)",
 "kamia language": "لغة كاميا (اللغة اليومية التي يتحدث بها شعب كاميا)",
 "kamikaze": "اِنْتِحَارِيّ, كَامِيكَازِي",
 "kamilavka": "قلنسوة أسطوانية, كاملافكا (غطاء رأس يرتديه الرهبان ورجال الدين المسيحيون الأرثوذكس)\nمثال: الكاملافكا هي قبعة على شكل غطاء رأس أسطواني صلب",
 "kampala": "كَمْبَالَا",
 "kampong": "كامبونغ (قرية ماليزية أصلية)",
 "kampuchea": "كمبوتشيا",
 "kampuchean": "كمبودي (من أو يتعلق بكمبوديا أو شعبها أو لغتها أو يميزهم) / كمبودي (مواطن أو ساكن في كمبوديا)",
 "kan": "كَان (اِتَّصَفَ. (فعل ناقص)؛ حَدَثَ)\nمثال: كان الكلب ميتا.",
 "kana": "كَانَا",
 "kanaf": "تيل, كيناف (نبات ليفي قيم من جزر الهند الشرقية واسع الانتشار الآن في الزراعة)",
 "kanafeh": "كُنَافَة (نوع من الحلوى تصنع من طبقات من الشعرية والجبن وترش عليها المكسرات وتشوى ثم يُصبّ عليها القَطْر، اشتهرب بها فِلَسْطِين وخصوصا نَابْلُس)",
 "kanagawa": "كَانَاغَاوَا",
 "kanaky": "كاناكي",
 "kanamycin": "كاناميسين, كانتريكس (مضاد حيوي (الاسم التجاري كانتريكس) يستخدم لعلاج الالتهابات الشديدة)",
 "kanarese": "الكانادا (لغة درافيدية يتم التحدث بها في جنوب الهند) / كناري (عضو في مجموعة من الناس تتحدث الكانادا وتعيش بشكل رئيسي في كانارا في جنوب الهند)",
 "kanarese language": "الكانادا (لغة درافيدية يتم التحدث بها في جنوب الهند)",
