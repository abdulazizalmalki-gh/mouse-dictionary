 "lactation": "إرضاع, رضاعة (تغذية الرضيع بإعطائه الثدي) / إدرار الحليب, رضاعة (إنتاج وإفراز الحليب بواسطة الغدد الثديية) / رضاعة, فترة الرضاعة (الفترة التي تلي الولادة والتي يتم خلالها إفراز الحليب)\nمثال: تستمر الرضاعة عادة حتى الفطام",
 "lacteal": "حليبي, لبني (متعلق بالحليب أو مكون منه أو ينتجه أو يشبهه) / وعاء لبني (أي من الأوعية الليمفاوية التي تنقل الكيلوس من الأمعاء الدقيقة إلى القناة الصدرية)\nمثال: سوائل لبنية",
 "lactic": "حَلِيبِيّ, لَبَنِيّ",
 "lactic acid": "حمض اللاكتيك, حمض اللبنيك (حمض كربوكسيلي شرابي شفاف عديم الرائحة استرطابي يوجد في الحليب الحامض وفي العديد من الفواكه)",
 "lactide": "لاكتيد (أي من فئة المركبات الحلقية غير المتجانسة، وهي رسمياً أنهيدريدات أحماض، تتكون عن طريق تسخين ألفا-لاكتون)\nمثال: يمكن تحضير اللاكتيد عن طريق تسخين حمض اللاكتيك في وجود محفز حمضي",
 "lactiferous duct": "قناة لبنية (قنوات الغدة الثديية التي تحمل الحليب إلى الحلمة)",
 "lactifuge": "قاطع لللبن, مانع لإفراز الحليب (أي عامل يقلل من إفراز الحليب (يعطى مثلاً للمرأة التي لا ترضع))",
 "lacto-ovo vegetarianism": "نباتية الألبان والبيض, نباتية لبنية بيضية (نظام غذائي يتكون أساساً من أطعمة نباتية المصدر ولكنه يشمل بعض المنتجات الحيوانية مثل البيض والحليب والجبن، دون اللحوم والأسماك والدواجن)\nمثال: نباتية الألبان والبيض هي النمط الأكثر شيوعاً للنباتية في الولايات المتحدة",
 "lacto-vegetarianism": "نباتية الألبان, نباتية لبنية (نظام غذائي نباتي يشمل منتجات الألبان والخضروات والفواكه والحبوب والمكسرات)\nمثال: يأتي مفهوم وممارسة نباتية الألبان لدى عدد كبير من الناس من الهند القديمة",
 "lactobacillus": "عصوية لبنية, لاكتوباسيلوس (بكتيريا عصوية موجبة الجرام تنتج حمض اللاكتيك (خاصة في الحليب))",
 "lactobacillus acidophilus": "أسيدوفيلوس, عصوية لبنية حمضية (بكتيريا تستخدم لصنع الزبادي وتكملة البروبيوتيك)",
 "lactoflavin": "ريبوفلافين, فيتامين ب2 (فيتامين ب يمنع الآفات الجلدية وفقدان الوزن)",
 "lactogen": "لاكتوجين, مدر لللبن (أي عامل يعزز إنتاج الحليب)",
 "lactogenic": "مدر للبن (محفز لإدرار الحليب (الرضاعة))",
 "lactogenic hormone": "برولاكتين, هرمون الحليب (هرمون موجه للغدد التناسلية تفرزه الغدة النخامية الأمامية؛ يحفز نمو الغدد الثديية والرضاعة عند الإناث بعد الولادة)",
 "lactoglobulin": "لاكتوغلوبولين (بروتين كروي موجود في الحليب)\nمثال: يتكون اللاكتوغلوبولين البقري من سلسلة من 162 حمضاً أمينياً",
 "lactone": "لاكتون (إستر حلقي داخل الجزيء مشتق من حمض هيدروكسي)",
 "lactophrys quadricornis": "سمكة البقرة (سمكة صندوقية لها أشواك تشبه القرون فوق العينين)",
 "lactose": "لَاكْتُوز",
 "lactose intolerance": "عدم تحمل اللاكتوز (اضطراب خلقي يتمثل في عدم القدرة على هضم الحليب ومنتجاته)",
 "lactosuria": "بيلة لبنية, لاكتوزية البول (وجود اللاكتوز في البول؛ يمكن أن يحدث أثناء الحمل أو الرضاعة)",
 "lactuca sativa": "خس, خس الحدائق (نبات حديقة حولي أو معمر ذو أوراق عصارية تستخدم في السلطات؛ يزرع على نطاق واسع)",
 "lactuca sativa asparagina": "خس الساق, خس الهليون (خس يقدر خاصة لسيقانه الصالحة للأكل)",
 "lactuca sativa capitata": "خس الرؤوس (يتميز بأوراق مرتبة في وريدة كثيفة تتطور إلى كرة مدمجة)",
 "lactuca sativa crispa": "خس ورقي (يتميز بأوراق مجعدة أو محززة تشكل وريدة فضفاضة لا تتطور إلى رأس مدمج)",
 "lactuca sativa longifolia": "خس روماني (خس ذو أوراق طويلة خضراء داكنة على شكل ملعقة)",
 "lactuca scariola": "خس شائك (خس بري حولي أوروبي له سيقان شائكة؛ عشبة ضارة مزعجة في أجزاء من الولايات المتحدة)",
 "lactuca serriola": "خس شائك (خس بري حولي أوروبي له سيقان شائكة؛ عشبة ضارة مزعجة في أجزاء من الولايات المتحدة)",
 "lacuna": "جَوْبَة",
 "lacunar": "لوحة غائرة (لوحة غائرة زخرفية في سقف أو قبة)",
 "lacustrine": "بحيري (من أو يتعلق بالبحيرات أو يعيش بالقرب منها)",
 "lacy": "دَانْتِيلِيّ, شَبِيه بِالدَّانْتِيل (مصنوع من الدانتيل أو يشبهه) / شَبِيهٌ بِالشَّبَكَة, نَسِيجِيّ (ذو فراغات مفتوحة أو يشبه نسيج العنكبوت)",
 "lad": "شَابّ, فَتًى",
 "lad's love": "أفسنتين, شيح ابن سينا (عشبة عطرية في أوراسيا المعتدلة وشمال أفريقيا ذات طعم مر تستخدم في صنع مشروب الأفسنتين)",
 "lada": "لَادَا",
 "ladanum": "لابدانوم, لادانوم (إفرازات راتنجية بنية مسودة ناعمة من ورود صخرية مختلفة تُستخدم في العطور خاصة كمثبت)",
 "ladder": "سُلَّم (أَمِنَ على نفسه وحالته؛ بَرِئَ من الآفات والْأَذَى)\nمثال: هم يريدون السلم.",
 "ladder truck": "سيارة إطفاء بسلم (سيارة إطفاء تحمل سلالم)",
 "ladder-back": "ظهر السلم (مسند ظهر الكرسي الذي يتكون من قائمين مع شرائح توصيل) / كرسي سلمي الظهر (كرسي ذو ظهر يشبه السلم)",
 "ladder-back chair": "كرسي سلمي الظهر (كرسي ذو ظهر يشبه السلم)",
 "ladder-proof": "مُقَاوِم لِلتَّمَزُّق ((في الجوارب) مقاوم للتمزّق والسحب)",
 "laddie": "صبي, فتى (طفل ذكر (مصطلح مألوف لمخاطبة صبي))",
 "laden": "مَكْلُوم, مُضْطَهَد (مُثقَل نفسياً أو ذهنياً) / مُحَمَّل, مُكَدَّس (مَمْلُوء بِكَمِّيَّة كَبِيرَة)",
 "ladened": "مُحَمَّل, مُكَدَّس (مَمْلُوء بِكَمِّيَّة كَبِيرَة)",
 "ladies and gentlemen": "سَيِّدَاتِي وَسَادَتِي",
 "ladies first": "السيدات أولاً",
 "ladies' man": "زير نساء, مغوٍ (رجل يستغل النساء)",
 "ladies' room": "حمام السيدات (مرحاض للسيدات في مبنى عام (أو شبه عام))",
 "ladies' slipper": "أوركيد الخف, خف السيدة (أي من عدة أزهار برية أمريكية بشكل رئيسي ذات شفة منتفخة تشبه الجراب؛ صعبة أو مستحيلة الزراعة في الحديقة)",
 "ladies' tobacco": "تبغ الستات, رجل القط الموزية (نبات معمر من أمريكا الشمالية يتكاثر عن طريق السيقان الجارية (المدادات))",
 "ladies' tresses": "جدائل السيدة (أوركيد من جنس سبيرانثيس ذو سنابل نحيلة ملتوية غالباً من الزهور البيضاء)",
 "ladies'-eardrop": "فوشية, قرط السيدة (شجيرة قائمة أو متسلقة من البرازيل بزهور وردية عميقة إلى حمراء)",
 "ladies'-eardrops": "فوشية, قرط السيدة (شجيرة قائمة أو متسلقة من البرازيل بزهور وردية عميقة إلى حمراء)",
 "ladin": "لادين (لهجة رومانشية يتحدث بها في جنوب شرق سويسرا)",
 "lading": "بضاعة منقولة, حمولة (بضائع تحملها مركبة كبيرة)",
 "ladino": "اللادينو, اليهودية الإسبانية (اللهجة الإسبانية التي يتحدث بها اليهود السفارديم ولكنها تكتب بالحروف العبرية)",
 "ladle": "مِغْرَفَة",
 "ladoga": "بُحِيرَة لَادُوغَا (مسطح مائي واسع كالبحر المغلق فيه ماء حلو أو شبه حلو صالح للشرب)\nمثال: سبحنا في البحيرة.",
 "lady": "رَبَّة, رَبَّةْ اَلْبَيْت / خَاتُون, سَيِّدَة / لِيدِي",
 "lady beetle": "خنفساء أبو العيد, دعسوقة (خنفساء صغيرة مستديرة زاهية الألوان ومرقطة تتغذى عادة على المن والآفات الحشرية الأخرى)",
 "lady chapel": "مصلى السيدة العذراء (مصلى صغير في كنيسة؛ مخصص للعذراء مريم)",
 "lady crab": "سلطعون السيدة الأمريكي (سلطعون مرقط بزهو يعيش في الشواطئ الرملية لساحل المحيط الأطلسي للولايات المتحدة)",
 "lady day": "25 مارس, عيد البشارة (مهرجان يحيي ذكرى إعلان التجسد من قبل الملاك جبرائيل للسيدة العذراء مريم؛ يوم ربع سنوي في إنجلترا وويلز وأيرلندا)",
 "lady fern": "سرخس السيدة (أكثر أنواع السراخس نمواً من جنس أثيريوم لأوراقها الدقيقة)",
 "lady friend": "حبيبة, صديقة (فتاة أو شابة يرتبط بها رجل عاطفياً)\nمثال: طردته حبيبته",
 "lady killer": "زير نساء, مغوٍ (رجل يستغل النساء)",
 "lady of pleasure": "بائعة هوى, عاهرة (امرأة تمارس الجماع الجنسي مقابل المال)",
 "lady of the house": "ربة منزل (زوجة تدير منزلاً بينما يكسب زوجها دخل الأسرة)",
 "lady palm": "رابيس, نخيل السيدة (أي من عدة أشجار نخيل صغيرة من جنس رابيس؛ تزرع كنباتات منزلية)",
 "lady slipper": "أوركيد الخف, خف السيدة (أي من عدة أزهار برية أمريكية بشكل رئيسي ذات شفة منتفخة تشبه الجراب؛ صعبة أو مستحيلة الزراعة في الحديقة)",
 "lady tulip": "توليب السيدة, توليب الشمعدان (توليب أوراسي بزهور صغيرة ملطخة عند القاعدة)",
 "lady's earrings": "بلسم البرتقال, قرط السيدة (نبات حولي في أمريكا الشمالية بأزهار صفراء أو برتقالية عادة؛ ينمو بشكل رئيسي في التربة الرطبة والحمضية نوعاً ما)",
 "lady's laces": "عشب الشريط, عشب القصب الكناري (عشب معمر في مروج المستنقعات والخنادق له أوراق عريضة؛ أوروبا وأمريكا الشمالية)",
 "lady's leek": "بصل مائل, كراث السيدة (بصل بري واسع الانتشار في أمريكا الشمالية ذو زهور بيضاء إلى وردية)",
 "lady's maid": "خادمة خاصة, وصيفة (خادمة تكون مرافقة شخصية لسيدة)",
 "lady's mantle": "رِجْل الْأَسَد, لُوف السِبَاع (العُضْو في جسد الإنسان يتكون من القَدَم والسَاق والفُخْذ. الجمع أرجُل، وقد تقول العامّة رِجْلين ورجْلينات؛ القَدَم من باب اطلاق اسم الكل على الجزء)\nمثال: هذا الرجل تاجر.",
 "lady's slipper": "أوركيد الخف, خف السيدة (أي من عدة أزهار برية أمريكية بشكل رئيسي ذات شفة منتفخة تشبه الجراب؛ صعبة أو مستحيلة الزراعة في الحديقة)",
 "lady's smock": "حرف مرجي, زهرة الوقواق (رشاد مر من أوروبا وأمريكا)",
 "lady's thistle": "حرشوف بري, خرفيش (شوك ثنائي الحول طويل من العالم القديم بأوراق كبيرة محيطة بالساق ومبقعة بالأبيض ورؤوس زهرية أرجوانية؛ مستوطن في كاليفورنيا وأمريكا الجنوبية)",
 "lady's tobacco": "تبغ الستات, رجل القط الموزية (نبات معمر من أمريكا الشمالية يتكاثر عن طريق السيقان الجارية (المدادات))",
 "lady's tresses": "جدائل السيدة (أوركيد من جنس سبيرانثيس ذو سنابل نحيلة ملتوية غالباً من الزهور البيضاء)",
 "lady's-eardrop": "فوشية, قرط السيدة (شجيرة قائمة أو متسلقة من البرازيل بزهور وردية عميقة إلى حمراء)",
 "lady's-eardrops": "فوشية, قرط السيدة (شجيرة قائمة أو متسلقة من البرازيل بزهور وردية عميقة إلى حمراء)",
 "lady's-finger": "أصابع الست, بامية (نبات حولي طويل وخشن من المناطق الاستوائية في العالم القديم يزرع على نطاق واسع في جنوب الولايات المتحدة وجزر الهند الغربية لقرونه الخضراء المخاطية…)",
 "lady's-slipper": "أوركيد الخف, خف السيدة (أي من عدة أزهار برية أمريكية بشكل رئيسي ذات شفة منتفخة تشبه الجراب؛ صعبة أو مستحيلة الزراعة في الحديقة)",
 "lady-in-waiting": "وصيفة الشرف (سيدة تُعين لخدمة ملكة أو أميرة)",
 "lady-of-the-night": "برونفيلسيا أمريكية, سيدة الليل (شجيرة من جزر الهند الغربية بزهور بيضاء مصفرة بارزة عطرة)",
 "lady-slipper": "أوركيد الخف, خف السيدة (أي من عدة أزهار برية أمريكية بشكل رئيسي ذات شفة منتفخة تشبه الجراب؛ صعبة أو مستحيلة الزراعة في الحديقة)",
 "ladybeetle": "خنفساء أبو العيد, دعسوقة (خنفساء صغيرة مستديرة زاهية الألوان ومرقطة تتغذى عادة على المن والآفات الحشرية الأخرى)",
 "ladybird": "دُعْسُوقَة (دُوَيْبَة صغيرة كالخُنْفُسَة ظهرها أحمر وعليه نقط سوداء)",
 "ladybird beetle": "خنفساء أبو العيد, دعسوقة (خنفساء صغيرة مستديرة زاهية الألوان ومرقطة تتغذى عادة على المن والآفات الحشرية الأخرى)",
 "ladybug": "خنفساء أبو العيد, دعسوقة (خنفساء صغيرة مستديرة زاهية الألوان ومرقطة تتغذى عادة على المن والآفات الحشرية الأخرى)",
 "ladyfinger": "أصابع الست, ليدي فينغر (كعكة إسفنجية صغيرة على شكل إصبع)",
 "ladyfish": "سمكة السيدة (سمكة صيد تشبه الطربون ولكنها أصغر)",
 "ladylike": "أُنْثَوِيُّ الطِّبَاعِ (يليق بامرأة حسنة التربية)",
 "ladylikeness": "تهذب, رقي (سلوك يليق بسيدة)",
 "ladylove": "عشيقة, محبوبة (امرأة هي حبيبة لرجل)",
 "ladyship": "سيادة (لقب يستخدم لمخاطبة أي نبيلة باستثناء الدوقة)",
 "laelia": "ليليا (أي من النباتات المذهلة المختلفة من جنس ليليا ذات زهور مبهرجة بألوان عديدة)",
 "laetrile": "لايتريل (مادة مشتقة من الأميغدالين؛ تم الترويج لها كدواء مضاد للأورام على الرغم من عدم وجود أدلة تدعم ذلك)",
 "laevulose": "سكر الفاكهة, فركتوز (سكر بسيط يوجد في العسل وفي العديد من الفواكه الناضجة)",
 "laffer curve": "منحنى لافر (رسم بياني يهدف إلى إظهار العلاقة بين معدلات الضرائب والدخل الحكومي؛ يزداد الدخل مع زيادة معدلات الضرائب حتى حد أمثل يتناقص بعده الدخل)",
 "lafora's disease": "داء لافورا, صرع رمعي عضلي (صرع يتميز بارتعاش مجموعات عضلية وتدهور عقلي تدريجي ومنشأ وراثي)",
 "lag": "تباطؤ, تلكؤ (فعل الإبطاء أو التخلف عن الركب) / ضلع البرميل (واحدة من عدة شرائح خشبية رفيعة تشكل جوانب برميل أو دلو) / أثناء ذلك, فترة مؤقتة (الوقت بين حدث أو عملية أو فترة وأخرى)\nمثال: في غضون ذلك، يدير الاشتراكيون الحكومة",
 "lag b'omer": "لاغ بعومر ((اليهودية) يوم مقدس يهودي؛ اليوم الثالث والثلاثون بعد اليوم الثاني من عيد الفصح؛ اليوم الثامن عشر من أيار)",
 "lag bolt": "برغي خشب كبير, مسمار لاغ (برغي خشب ثقيل برأس مربع أو سداسي يتم تثبيته بمفتاح ربط)",
 "lag screw": "برغي خشب كبير, مسمار لاغ (برغي خشب ثقيل برأس مربع أو سداسي يتم تثبيته بمفتاح ربط)",
 "lagan": "بضائع غارقة موسومة (بضائع (أو حطام) في قاع البحر مربوطة بعوامة لتسهيل استعادتها)",
 "lagarostrobus colensoi": "صنوبر فضي, صنوبر ويستلاند (شجرة خشبية في نيوزيلندا ذات خشب أبيض لامع)",
 "lagarostrobus franklinii": "صنوبر هوون (شجرة خشبية تاسمانية بخشب أصفر عطري متموج الحبيبات يستخدم للنحت وبناء السفن؛ توضع أحياناً في جنس داكريديوم)",
 "lagenaria siceraria": "قرع القنينة, يقطين (نبات متسلق من العالم القديم ذو ثمار قرعية صلبة القشرة تشبه الزجاجة)",
 "lagend": "بضائع غارقة موسومة (بضائع (أو حطام) في قاع البحر مربوطة بعوامة لتسهيل استعادتها)",
 "lager": "لاجر, مخيم محصن (معسكر تدافع عنه تشكيلة دائرية من العربات) / جعة مخزنة, لاغر (مصطلح عام للبيرة المصنوعة باستخدام خميرة التخمير السفلي (عادة عن طريق الهرس بالغلي)؛ كانت تصنع أصلاً في مارس أو أبريل وتُعتّق حتى سبتمبر)",
 "lager beer": "جعة مخزنة, لاغر (مصطلح عام للبيرة المصنوعة باستخدام خميرة التخمير السفلي (عادة عن طريق الهرس بالغلي)؛ كانت تصنع أصلاً في مارس أو أبريل وتُعتّق حتى سبتمبر)",
 "lagerphone": "لاغرفون (آلة إيقاعية أسترالية تستخدم لعزف موسيقى الأدغال؛ عصا طويلة مثبت عليها أغطية زجاجات بشكل فضفاض؛ تُلعب بضربها بعصا أو ضربها على الأرض)",
 "lagerstroemia indica": "تمرحنة, وردية الكريب (شجيرة زينة من شرق الهند تزرع بكثرة في جنوب الولايات المتحدة)",
 "lagerstroemia speciosa": "لاجرستروميا, وردة الهند (موطنها آسيا وأستراليا وجزر الهند الشرقية، حيث توفر خشباً يسمى بيينما؛ تستخدم في أماكن أخرى للزينة لزهورها الكبيرة المبهرجة)",
 "laggard": "مُتَبَاطِئ, مُتَلَكِّئ (يُضَيِّع الوَقْت وَيَتَأَخَّر) / متباطئ, متلكئ (شخص يستغرق وقتاً أكثر من اللازم؛ شخص يتخلف عن الركب)",
 "lagger": "متباطئ, متلكئ (شخص يستغرق وقتاً أكثر من اللازم؛ شخص يتخلف عن الركب)",
 "lagging": "تغليف عازل (عازل يستخدم لللف حول الأنابيب أو الغلايات أو يوضع في السندرات لمنع فقدان الحرارة)",
 "lagniappe": "بقشيش للبائع, هدية إضافية (هدية صغيرة (خاصة تلك التي يقدمها التاجر للعميل الذي يقوم بالشراء))",
 "lagodon rhomboides": "سمكة الدبوس (تشبه الدنيس؛ سمكة صغيرة شائكة الزعانف توجد في الخلجان على طول الساحل الجنوبي الشرقي للولايات المتحدة)",
 "lagomorph": "أرنبيات الشكل (حيوانات قاضمة كبيرة نسبياً؛ تتميز عن القوارض بوجود زوجين من القواطع العلوية المتخصصة للقضم)",
 "lagoon": "بُحَيْرة شاطِئَة, لَاجُون (مسطح مائي واسع كالبحر المغلق فيه ماء حلو أو شبه حلو صالح للشرب)\nمثال: سبحنا في البحيرة.",
 "lagophthalmos": "عين أرنبية, لاقوفثالموس (حالة غير طبيعية لا يمكن فيها إغلاق العين تماماً)",
 "lagopus scoticus": "طيهوج أحمر (طيهوج بني محمر يعيش في المستنقعات المرتفعة في بريطانيا العظمى)",
 "lagostomus maximus": "فيسكاتشا (قارض اجتماعي يحفر الجحور أكبر من الشنشيلة)",
 "lagrange point": "نُقْطَة لَاغْرَانْج (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه)\nمثال: هذه هي نقطة ضعفه.",
 "laguna": "بحيرة شاطئية, لاجون (مسطح مائي مفصول عن مسطح أكبر بواسطة حاجز رملي أو شعاب مرجانية)",
 "laguncularia racemosa": "مانغروف أبيض (شجيرة إلى شجرة متوسطة الحجم تنمو في المياه قليلة الملوحة على طول سواحل غرب أفريقيا وأمريكا الاستوائية؛ مهمة محلياً كمصدر للتانين)",
 "lagune": "بحيرة شاطئية, لاجون (مسطح مائي مفصول عن مسطح أكبر بواسطة حاجز رملي أو شعاب مرجانية)",
 "lah": "لا (المقطع الذي يسمي النغمة السادسة لسلم كبير أو صغير في الصولفيج)",
 "lahaina": "لَاهَايْنَا",
 "lahar": "تدفق طيني بركاني, لاهار (انهيار للمياه والطين البركاني أسفل منحدرات البركان)",
 "lahmacun": "لَحْم عَجِين, لَحْمَاجُون (ما يبقى من جسم الحيوان أو الإنسان بعد إزالة الجلد الأحشاء والعظم والشحم والدم والأعصاب. يتكون أساسا من العَضَلَات؛ ما يؤكل من لحم من الحيوان والطير والسمك عامة)\nمثال: أفضل لحم البقر.",
 "lahore": "لَاهُور",
 "lahori": "لَاهُوْرِيّ",
 "lahti": "لاهتي",
 "lahu": "لغة لاهو (لغة لولو يتم التحدث بها في جنوب غرب مقاطعة يونان)",
 "lahu language": "لغة لاهو (لغة لولو يتم التحدث بها في جنوب غرب مقاطعة يونان)",
 "laic": "دُنْيَوِيّ, عِلْمَانِيّ (يتّسم بسمات من ليسوا من رجال الدين)",
 "laid": "مَوْضُوع, مُرَتَّب (موضوع وفقاً لخطة محددة)",
 "laid paper": "ورق مسطر مائياً (ورق كتابة يحتوي على علامة مائية لخطوط دقيقة تجري عبر النسيج)",
 "laid-back": "رَائِق, هَادِئُ الطَّبْع (غَيْرُ مُسْتَعْجِلٍ وَمُسْتَرْخٍ)",
 "laid-off": "مَفْصُول, مُسَرَّح (فقد وظيفته أو تمّ الاستغناء عنه)",
 "lair": "عرين, وكر (مسكن الحيوانات البرية)",
 "laird": "إقطاعي, ليرد (مالك أرض (خاصة في اسكتلندا))",
 "laissez faire": "سياسة عدم التدخل, فردانية (المذهب القائل بأن الحكومة لا ينبغي أن تتدخل في الشؤون التجارية)",
 "laissez passer": "تصريح مرور (وثيقة تشير إلى الإذن بالقيام بشيء ما دون قيود)\nمثال: كان لدى ممثلي وسائل الإعلام تصاريح خاصة",
 "laissez-faire economy": "اقتصاد السوق, مشروع حر (اقتصاد يعتمد بشكل رئيسي على قوى السوق لتخصيص السلع والموارد وتحديد الأسعار)",
 "laity": "العلمانيون, العوام (في المسيحية، أعضاء مجتمع ديني ليس لديهم المسؤوليات الكهنوتية لرجال الدين المرسومين)",
 "lake": "بُحَيْرَة (مسطح مائي واسع كالبحر المغلق فيه ماء حلو أو شبه حلو صالح للشرب) / بحيرة (مسطح مائي واسع كالبحر المغلق فيه ماء حلو أو شبه حلو صالح للشرب) / بُحيرَة (مسطح مائي واسع كالبحر المغلق فيه ماء حلو أو شبه حلو صالح للشرب) / ضاية / لَكّ\nمثال: سبحنا في البحيرة.",
 "lake bed": "قاع البحيرة (الجزء السفلي من البحيرة)",
 "lake bottom": "قاع البحيرة (الجزء السفلي من البحيرة)",
 "lake como": "بُحَيْرَة كومو (مسطح مائي واسع كالبحر المغلق فيه ماء حلو أو شبه حلو صالح للشرب)\nمثال: سبحنا في البحيرة.",
 "lake constance": "بُحَيْرَة كُوْنْسْتْاَنْس (مسطح مائي واسع كالبحر المغلق فيه ماء حلو أو شبه حلو صالح للشرب)\nمثال: سبحنا في البحيرة.",
 "lake district": "ليك ديستريكت",
 "lake duck": "زرقاي صغير (بط غواص شائع في أمريكا الشمالية؛ الذكور لها رؤوس أرجوانية)",
 "lake dwelling": "مسكن بحيري (مسكن مبني على ركائز في بحيرة أو بالقرب منها؛ تحديداً في قرى ما قبل التاريخ)",
 "lake erie": "بُحَيْرَة إِرِي (مسطح مائي واسع كالبحر المغلق فيه ماء حلو أو شبه حلو صالح للشرب)\nمثال: سبحنا في البحيرة.",
 "lake geneva": "بُحَيْرَة لِيْمْاَن (مسطح مائي واسع كالبحر المغلق فيه ماء حلو أو شبه حلو صالح للشرب) / بُحَيْرَة جِنِيف (مسطح مائي واسع كالبحر المغلق فيه ماء حلو أو شبه حلو صالح للشرب)\nمثال: سبحنا في البحيرة.",
 "lake herring": "سيسكو (سمكة طعام مهمة في البحيرات العميقة الباردة في أمريكا الشمالية) / رنجة البحيرة (سمكة مياه باردة يتم اصطيدها في بحيرة سوبيريور وشمالاً)",
 "lake huron": "بُحَيْرَة هُرُون (مسطح مائي واسع كالبحر المغلق فيه ماء حلو أو شبه حلو صالح للشرب)\nمثال: سبحنا في البحيرة.",
 "lake michigan": "بُحَيْرَة مِيشِيغَان (مسطح مائي واسع كالبحر المغلق فيه ماء حلو أو شبه حلو صالح للشرب)\nمثال: سبحنا في البحيرة.",
 "lake ontario": "بُحَيْرَة أُونْتَارْيُو (مسطح مائي واسع كالبحر المغلق فيه ماء حلو أو شبه حلو صالح للشرب)\nمثال: سبحنا في البحيرة.",
 "lake poets": "شعراء البحيرة (شعراء إنجليز في بداية القرن التاسع عشر عاشوا في منطقة البحيرة واستلهموا منها)",
 "lake salmon": "سلمون البحيرات, سلمون حبيس (سلمون أطلسي محصور في بحيرات نيو إنجلاند وجنوب شرق كندا)",
 "lake skadar": "بُحَيْرَة سْكِيُوتَارِي (مسطح مائي واسع كالبحر المغلق فيه ماء حلو أو شبه حلو صالح للشرب)\nمثال: سبحنا في البحيرة.",
 "lake superior": "بُحَيْرَة سُوبِيرِيوُر (مسطح مائي واسع كالبحر المغلق فيه ماء حلو أو شبه حلو صالح للشرب)\nمثال: سبحنا في البحيرة.",
 "lake trout": "تروتة البحيرة (تروتة كبيرة متشعبة الذيل تعيش في بحيرات كندا وشمال الولايات المتحدة) / تراوت البحيرة (لحم تراوت كبير من البحيرات الشمالية)",
 "lake victoria": "بُحَيْرَة فِيكْتُورِيَا (مسطح مائي واسع كالبحر المغلق فيه ماء حلو أو شبه حلو صالح للشرب)\nمثال: سبحنا في البحيرة.",
 "lake whitefish": "سمك أبيض بحيري (يوجد في البحيرات العظمى وشمالاً حتى ألاسكا)",
 "lakefront": "واجهة البحيرة (الأرض المتاخمة لبحيرة)",
 "lakeland terrier": "ليكلاند تيريير (سلالة من التيريير سلكي الشعر أصلها من منطقة البحيرات في إنجلترا وتستخدم للصيد)",
 "lakeshore": "شاطئ البحيرة (شاطئ بحيرة)",
 "lakeside": "شاطئ البحيرة (شاطئ بحيرة)",
 "lakh": "لَاك",
 "lakhnauti": "لَكْنُوتِي",
 "lakota": "تيتون, لاكوتا (فرد من الفرع الغربي الكبير لشعب السيوكس الذي كان يتألف من عدة مجموعات عاشت في السهول)",
 "laksa": "لَاكْسَا",
 "lalibela": "لاليبيلا",
 "lallans": "الاسكتلندية المنخفضة, لالانز (لهجة من الإنجليزية يتم التحدث بها في الأراضي المنخفضة في اسكتلندا)",
 "lallation": "ثَرْثَرَة, مُنَاغَاة (رطانة تشبه أصوات الطفل) / لثغة لامية",
 "lally": "عمود لالي (عمود دعم يتكون من أسطوانة فولاذية مملوءة بالخرسانة)",
 "lally column": "عمود لالي (عمود دعم يتكون من أسطوانة فولاذية مملوءة بالخرسانة)",
 "lalthyrus tingitanus": "بازلاء طنجة, جلبان طنجة (نبات حولي من شمال أفريقيا يشبه البازلاء الحلوة وله زهور مبهرجة ولكن عديمة الرائحة)",
 "lam": "فرار, هروب (هروب سريع (خاصة من قبل المجرمين))\nمثال: قام اللصوص بفرار ناجح",
 "lama": "لَامَا",
 "lama guanicoe": "غواناكو (لاما برية)",
 "lama pacos": "ألبكة (لاما مستأنسة ذات صوف حريري طويل؛ يُعتقد أنها صنف مستأنس من الغواناكو)",
 "lama peruana": "لاما (تُستخدم في جبال الأنديز كدابة حمل ومصدر للصوف؛ تُعتبر صنفاً مستأنساً من الغواناكو)",
 "lamaism": "بوذية تبتية, لامية (عقيدة بوذية تتضمن عناصر من الهند ليست بوذية وعناصر من الشامانية الموجودة مسبقاً)",
 "lamaist": "لامِيّ ((في البوذية) معتنق للمذهب اللامي (بوذية التبت))",
 "lamarckian": "لَامَارْكِيّ",
 "lamarckism": "لَامَارْكِيّة",
 "lamasery": "دير اللاما (دير لرهبان اللاما)",
 "lamaze method": "طريقة لاماز (طريقة تُعد الأم للولادة الطبيعية؛ تمارس المرأة الحامل (في الفصول الدراسية وفي المنزل) وتتعلم (عادة بمساعدة مدرب) حول فسيولوجيا الولادة وتقنيات…)",
 "lamaze method of childbirth": "طريقة لاماز (طريقة تُعد الأم للولادة الطبيعية؛ تمارس المرأة الحامل (في الفصول الدراسية وفي المنزل) وتتعلم (عادة بمساعدة مدرب) حول فسيولوجيا الولادة وتقنيات…)",
 "lamb": "حَمَل, خَرُوف (رَفَعَ، أَقَلَّ) / لَحْم اَلضَّأْن, خَرُوف (ما يبقى من جسم الحيوان أو الإنسان بعد إزالة الجلد الأحشاء والعظم والشحم والدم والأعصاب. يتكون أساسا من العَضَلَات؛ ما يؤكل من لحم من الحيوان والطير والسمك عامة)\nمثال: حمل سامي سلاحه.",
 "lamb chop": "شريحة لحم ضأن, كستليتة ضأن (شريحة لحم مقطوعة من حمل)",
 "lamb curry": "كاري لحم الضأن (كاري مصنوع من لحم الضأن)",
 "lamb of god": "حَمَلُ اَللهِ (رَفَعَ، أَقَلَّ)\nمثال: حمل سامي سلاحه.",
 "lamb roast": "شواء ضأن, لحم ضأن للتحمير (قطعة من لحم الضأن مناسبة للتحمير)",
 "lamb succory": "أرنوسيريس, هندباء الحمل (عشب أوروبي صغير بأزهار صفراء صغيرة)",
 "lamb's lettuce": "خس النعجة, فاليريانلا (يزرع على نطاق واسع كمحصول سلطة وعشب وعائي؛ غالباً ما يكون عشباً ضاراً)",
 "lamb's-quarter": "رجل الوز, سرمق (أوراق تجمع من البرية)",
 "lamb's-quarters": "رجل الوزة, سبانخ بري (نبات عشبي أوروبي شائع دخيل في أمريكا الشمالية؛ غالباً ما يستخدم كبقلة)",
 "lamb-chop": "شريحة لحم ضأن, كستليتة ضأن (شريحة لحم مقطوعة من حمل)",
 "lambada": "لَمْبَادَا",
 "lambchop": "شريحة لحم ضأن, كستليتة ضأن (شريحة لحم مقطوعة من حمل)",
 "lambda": "لَامْدَا",
 "lambda hyperon": "جُسَيْم لَامْدَا (باريون متعادل كهربائياً ذو لف نظائري 1)",
 "lambda particle": "جُسَيْم لَامْدَا (باريون متعادل كهربائياً ذو لف نظائري 1)",
 "lambdacism": "لثغة اللام",
 "lambency": "بريق, بصيص (مظهر لضوء منعكس)",
 "lambent": "مُشِعّ بِرِقَّة, وَهَّاج (سَاطِع أَوْ مُشِعّ بِنُعُومَةٍ وَلُطْف)",
 "lambert": "لامبرت (وحدة للإضاءة في نظام السنتيمتر-غرام-ثانية تساوي سطوع سطح منتشر تماماً ينبعث منه أو يعكس لومن واحد لكل سنتيمتر مربع)",
 "lambert-eaton syndrome": "متلازمة لامبرت-إيتون (مرض يظهر لدى مرضى سرطان الرئة ويتميز بضعف وإعياء عضلات الورك والفخذ)",
 "lambertia formosa": "زهرة العسل, شيطان الجبل (شجيرة كثيفة منتصبة من شرق أستراليا ذات عناقيد طرفية من الزهور الحمراء تنتج الكثير من الرحيق)",
 "lambkill": "غار الغنم, كلمية ضيقة الأوراق (شجيرة قزمية من أمريكا الشمالية تشبه غار الجبل ولكن بأوراق أضيق وزهور حمراء صغيرة؛ سامة للماشية الصغيرة)",
 "lambkin": "حمل صغير (حمل صغير جداً)",
 "lamblike": "كَالحَمَل, وَدِيع (يُشْبِهُ الحَمَلَ فِي الوَدَاعَةِ وَاللُّطْف)",
 "lamboid suture": "درز لامي (الدرز بين العظم القذالي والعظمين الجداريين)",
 "lambrequin": "برقع النافذة (معلقة قصيرة ومزخرفة لحافة الرف أو أعلى إطار النافذة) / غطاء خوذة الفارس (وشاح يغطي خوذة الفارس)",
 "lambskin": "برشمان, رِقّ (جلد شاة أو ماعز معد للكتابة عليه) / جلد الحمل (جلد الحمل مع الصوف الذي لا يزال عليه)",
 "lame": "أَعْرَج / أَكْسَح / أَشَلّ ((أَشَلَّ) فلانٌ: أصَابه الشَّلَل؛ (أَشَلَّ) اللهُ فلانًا أَو يَدَهُ: أصابَها بالشَّلَل)",
 "lame duck": "الْبَطَّةُ الْعَرْجَاءُ",
 "lamedh": "لامد (الحرف الثاني عشر من الأبجدية العبرية)",
 "lamella": "صفيحة رقيقة (لوحة رقيقة) / صفيحة (غشاء رقيق هو إحدى الطبقات المتكلسة التي تشكل العظام) / خيشوم, صفيحة (أي من الهياكل المشعة الشبيهة بالأوراق المنتجة للأبواغ على الجانب السفلي من غطاء الفطر أو فطريات مماثلة)",
 "lamellar mixture": "خليط صفائحي (خليط تتواجد فيه المواد في طبقات مميزة)",
 "lamellate placentation": "وضع مشيمة صفائحي (مع وجود بويضات على امتدادات رقيقة للمشيمة داخل مبيض مركب)",
 "lamellibranch": "ذوات الصدفتين (رخويات بحرية أو مياه عذبة لها جسم رخو مع خياشيم تشبه الصفائح محاطة بصدفتين مفصليتين معاً) / صَفَائِحِيُّ الخَيَاشِيم (ثُنَائِيُّ الصَّدَفَة؛ مِنَ الرَّخَوِيَّاتِ ذَاتِ الصَّدَفَتَيْن)",
 "lamellicorn beetle": "خنفساء صفائحية القرون (خنفساء لها قرون استشعار ذات أجزاء طرفية صلبة تشبه الصفائح)",
 "lamely": "بشكل غير مقنع, بضعف (بطريقة ضعيفة وغير مقنعة)\nمثال: أجابت بضعف: لا أعرف يا إدوارد",
 "lameness": "ركاكة, ضعف (نقص أو عيب (خاصة في الحجج أو الأعمال الأدبية)) / عرج (إعاقة في المشي بسبب عجز في الساقين أو القدمين)\nمثال: كاتب مشهور بركاكة حبكاته",
 "lament": "عَوِيل, رَثَاء / مَرْثِيَة / بَكَى, نَاحَ (دَمَعَتْ عَيناهُ حزنا؛ بكى الْمَيِّت: رثاه) / بَكَى, رَثَى (دَمَعَتْ عَيناهُ حزنا؛ بكى الْمَيِّت: رثاه)\nمثال: بكى زيري كثيرا.",
 "lamentable": "مُؤْسِف",
 "lamentably": "بشكل مؤسف, بشكل محزن (بطريقة مؤسفة أو تدعو للرثاء)\nمثال: كان مهملاً بشكل محزن",
 "lamentation": "حداد, ندب (النشاط العاطفي والظاهر للتعبير عن الحزن) / رثاء, عويل (صرخة حزن وأسى)\nمثال: يمكن سماع نواحهم المثير للشفقة في جميع أنحاء الجناح",
 "lamentations": "مَرَاثِي إِرْمِيَا",
 "lamented": "مأسوف عليه, مبكى عليه (يتم النحيب أو الحزن عليه)\nمثال: بصمة صديقنا الحكيم والمأسوف عليه",
 "lamenter": "ثاكِل, حَزِين (شخص يشعر بالحزن (خاصة الحزن على شخص مات))",
 "lamenting": "عَوِيل, نَائِح (يعبّر بصوته عن الحزن والأسى أو يشبه هذا التعبير)",
 "lamia": "لاميا, مصاص دماء ((فلكلور) جثة تنهض ليلاً لتشرب دماء الأحياء)",
 "lamina": "صفيحة رقيقة (صفيحة رقيقة أو طبقة (خاصة من العظم أو المعدن))",
 "lamina arcus vertebrae": "صفيحة القوس الفقرية (صفيحة القوس الفقرية؛ الجزء الخلفي المسطح للقوس الفقرية الذي يمتد منه النتوء الشوكي)",
 "laminal": "رِقَاقِيّ, صَفِيحِيّ (مرتب في صفائح أو يتكون من رقائق)",
 "laminar": "رِقَاقِيّ, صَفِيحِيّ (مرتب في صفائح أو يتكون من رقائق)",
 "laminar flow": "تدفق صفائحي (تدفق انسيابي غير مضطرب في طبقات متوازية)",
 "laminar flow clean room": "غرفة نظيفة ذات تدفق رقائقي (غرفة نظيفة خالية من جميع الجسيمات الدخيلة؛ تستخدم في تصنيع المعالجات الدقيقة)",
 "laminate": "صفيحة, مادة صفائحية (ورقة من مادة مصنوعة عن طريق ربط ورقتين أو أكثر أو طبقات)",
 "laminated glass": "زجاج أمان, زجاج مصفح (زجاج مصنوع بوضع ألواح من البلاستيك أو الراتنج بين لوحين من الزجاج لمنع التحطم)",
 "laminating machine": "آلة تغليف, مغلفة (أي من مجموعة الآلات المستخدمة للتغليف)",
 "lamination": "ترقيق, تصفيح (ربط صفائح رقيقة معًا) / بنية صفائحية, تصفيح (هيكل مكون من طبقات)",
 "laminator": "عامل تصفيح, مُصَفِّح (شخص يقوم بصناعة الرقائق أو تغليف المواد بطبقات رقيقة (خاصة الرقائق البلاستيكية)) / آلة تغليف, مغلفة (أي من مجموعة الآلات المستخدمة للتغليف)",
 "laminectomy": "استئصال الصفيحة الفقرية (إزالة جراحية للأقواس العظمية في فقرة واحدة أو أكثر)",
 "laminitis": "التهاب الصفيحة (التهاب الأنسجة الصفائحية التي تربط الحافر بقدم الحصان)",
 "lamisil": "تيربينافين, لاميسيل",
 "lamium album": "قراص أبيض, لاميون أبيض (نبات قراص أوروبي ميت بزهور بيضاء)",
 "lamium amplexicaule": "أذن القسيس, لاميون متموج (نبات أوراسي له أوراق مسننة وزهور صغيرة ثنائية الشفة بيضاء أو حمراء أرجوانية)",
 "lamivudine": "لاميفودين (مثبط المنتسخة العكسية النوكليوزيدي فعال جداً عند دمجه مع زيدوفودين في علاج الإيدز وفيروس نقص المناعة البشرية)",
 "lammas": "1 أغسطس, عيد الحصاد (يحيي ذكرى تحرير القديس بطرس المعجز من السجن؛ يوم ربع سنوي في اسكتلندا؛ مهرجان حصاد في إنجلترا)",
 "lammas day": "1 أغسطس, عيد الحصاد (يحيي ذكرى تحرير القديس بطرس المعجز من السجن؛ يوم ربع سنوي في اسكتلندا؛ مهرجان حصاد في إنجلترا)",
 "lammastide": "موسم عيد الحصاد (موسم عيد الحصاد (لاماس))",
 "lammergeier": "نَسْر مِلَّتْحَيّ (الكشط والجرح والنقب؛ طَيْر من الجَوَارِح أكبرها حجما يقتات الجِيَف وله منقار معقوف)\nمثال: الصغر أسرع من النسر",
 "lammergeyer": "كاسر العظام, نسر ملتحي (أكبر طائر جارح أوراسي؛ له ريش أسود يتدلى حول المنقار)",
 "lamna nasus": "قرش بوريجل (قرش نهم مدبب الأنف يعيش في شمال المحيط الأطلسي والهادئ)",
 "lamp": "مِصْبَاح (كل ما يستضاء به، منه الفانوس والقنديل والنبراس والسراج والمشكاة؛ جهاز كهربائي يُسْتَضَاءُ بِه، مِصْبَاح كَهْرَبَائِيّ) / لَمْبَة / قِنْدِيل (مصباح فيه فتيل يُضاء بالزيت) / سِرَاج\nمثال: ليس كل مصباح سحريا.",
 "lamp chimney": "زجاجة المصباح (أنبوب زجاجي يحيط بفتيل مصباح الزيت)",
 "lamp house": "بيت المصباح (مبيت يحمل مصباحاً (كما في جهاز عرض الأفلام))",
 "lamp housing": "بيت المصباح (مبيت يحمل مصباحاً (كما في جهاز عرض الأفلام))",
 "lamp oil": "كاز, كيروسين (زيت هيدروكربوني قابل للاشتعال يستخدم كوقود في المصابيح والسخانات)",
 "lamp shade": "غطاء المصباح, مظلة المصباح (غطاء واقٍ مزخرف للمصباح، يستخدم لحجب المصباح الكهربائي عن الرؤية المباشرة)",
 "lamp shell": "عضدي الأرجل (حيوان بحري ذو صدفة ذات مصراعين وله زوج من الأذرع تحمل مجسات لالتقاط الطعام)",
 "lampblack": "أسود الكربون, سخام (مادة غروانية سوداء تتكون كلياً أو أساساً من الكربون غير المتبلور وتستخدم لصنع الأصباغ والحبر)",
 "lampedusa": "لَنْبَذُوشَة",
 "lamper eel": "جلكى (دائريات فم بدائية تشبه الثعبان تعيش في المياه العذبة أو مهاجرة لها فم ماص مستدير بلسان كاشط)",
 "lamphouse": "بيت المصباح (مبيت يحمل مصباحاً (كما في جهاز عرض الأفلام))",
 "lamplight": "ضوء المصباح (الضوء الصادر من مصباح)",
 "lamplighter": "مشعل المصابيح ((عندما كان الغاز يستخدم لإنارة الشوارع) شخص يضيء ويطفئ مصابيح الشوارع)",
 "lamplit": "مُضَاء بِمِصْبَاح (مُنَار بِوَاسِطَة مِصْبَاح)",
 "lampmaker": "صَانِعُ الْقَنَادِيل (كل من يَصْنَعُ شيئا؛ من يَمْتَهِنُ الصِّنَاعَة)\nمثال: أحب أن أكون صانع محتوى.",
 "lampoon": "بَارُودِيَا, مُحَاكَاة سَاخِرَة (تكوين يقلد أو يحرف أسلوب شخص ما، عادة بطريقة فكاهية)",
 "lampoon artist": "رسام ساخر, رسام هجائي (رسام كاريكاتير يرسم محاكاة ساخرة أو صوراً هجائية للأوضاع الثقافية أو الاجتماعية أو السياسية)",
 "lampooner": "محاكي ساخر, مقلد ساخر (شخص يقلد الأسلوب الأدبي أو الموسيقي بغرض التأثير الكوميدي الساخر)",
 "lamppost": "عَمُود مِصْبَاح, عَمُود إِنَارَة",
 "lamprey": "جلكى (دائريات فم بدائية تشبه الثعبان تعيش في المياه العذبة أو مهاجرة لها فم ماص مستدير بلسان كاشط)",
 "lamprey eel": "جلكى (دائريات فم بدائية تشبه الثعبان تعيش في المياه العذبة أو مهاجرة لها فم ماص مستدير بلسان كاشط)",
 "lampris guttatus": "أوبا العالم الجديد (توجد من نوفا سكوشا إلى جزر الهند الغربية وخليج المكسيك)",
 "lampris regius": "أوبا, سمكة القمر (سمكة كبيرة بيضاوية الشكل زاهية الألوان تعيش في أعماق المحيط الأطلسي والهادئ والبحر الأبيض المتوسط)",
 "lampropeltis getulus": "ثعبان الملك الشائع (واسع الانتشار في الولايات المتحدة باستثناء المناطق الشمالية؛ أسود أو بني مع أشرطة صفراء)",
 "lampropeltis triangulum": "ثعبان الحليب (ثعبان ملك غير سام أسمر وبني مع بقعة قذالية على شكل سهم؛ الأنواع الجنوبية الشرقية لها خطوط حمراء مثل الثعابين المرجانية)",
 "lampshade": "أَبَاجُور, عَاكِس النُّور",
 "lampshell": "عضدي الأرجل (حيوان بحري ذو صدفة ذات مصراعين وله زوج من الأذرع تحمل مجسات لالتقاط الطعام)",
 "lan": "شبكة محلية, لان (شبكة كمبيوتر محلية للاتصال بين أجهزة الكمبيوتر؛ خاصة الشبكة التي تربط أجهزة الكمبيوتر ومعالجات النصوص وغيرها من المعدات المكتبية الإلكترونية لإنشاء…)",
 "lanai": "شرفة مسقوفة, لاناي (شرفة أو فناء مسقوف غالباً ما يكون مؤثثاً ويستخدم كغرفة معيشة)",
 "lanate": "صُوفِيّ, قُطْنِيّ الشَّعْر (مغطى بشعيرات كثيفة قطنية تشبه الصوف)",
 "lancaster": "بيت لانكستر, لانكستر (البيت الملكي الإنجليزي الذي حكم من 1399 إلى 1461؛ كان شعاره وردة حمراء)",
 "lancastrian": "لانكستري (من أو متعلق بمدينة لانكستر الإنجليزية أو سكانها) / لانكستري (من أو متعلق بالبيت الملكي الإنجليزي السابق (لانكستر) أو أنصارهم) / لانكاستري (مقيم في لانكستر) / لانكاستري (عضو (أو مؤيد) لبيت لانكستر)\nمثال: مركز مدينة لانكستر",
 "lancastrian line": "بيت لانكستر, لانكستر (البيت الملكي الإنجليزي الذي حكم من 1399 إلى 1461؛ كان شعاره وردة حمراء)",
 "lance": "مشرط (سكين جراحي بشفرة مدببة ذات حدين؛ يستخدم للثقب والشقوق الصغيرة) / رمح (قضيب طويل مدبب يستخدم كأداة أو سلاح) / حربة صيد, رمح الصيد (أداة ذات عمود ورأس شائك تستخدم لصيد الأسماك)",
 "lance corporal": "عريف رمح, وكيل عريف (جندي في سلاح مشاة البحرية رتبته أعلى من جندي درجة أولى وأقل من عريف)",
 "lance-shaped": "رُمْحِيّ الشَّكْل (على شكل رمح)",
 "lancelet": "رميح, سهيم (حيوان بحري صغير شفاف يشبه المشرط يحفر في الرمل؛ سلف بدائي للفقاريات)",
 "lancelike": "رُمْحِيّ ((عن شكل الورقة) كرأس الرمح؛ ضيّق يتدرَّج إلى قمّة مُدبَّبة)",
 "lanceolate": "رُمْحِيّ ((عن شكل الورقة) كرأس الرمح؛ ضيّق يتدرَّج إلى قمّة مُدبَّبة)",
 "lanceolate leaf": "ورقة سنانية (ورقة على شكل رأس رمح؛ تستدق إلى نقطة في كل طرف)",
 "lanceolate spleenwort": "طحال رمحي (طحال من غرب أوروبا)",
 "lancer": "رماح, فارس الرمح ((سابقاً) جندي خيال مسلح برمح)",
 "lancers": "لانسر (رقصة كادريل لـ 8 أو 16 زوجاً)",
 "lancet": "مِفْصَد, فَاصِد",
 "lancet arch": "قوس رمحي (قوس قوطي مدبب بحدة، مثل الرمح)",
 "lancet fish": "سمكة الذئب, سمكة المبضع (أسماك محيطية كبيرة ممدودة عديمة القشور ذات أسنان حادة وزعنفة ظهرية طويلة تشبه الشراع)",
 "lancet window": "نافذة رمحية (نافذة ضيقة ذات قوس رمحي وبدون زخارف)",
 "lancet-shaped": "مِبْضَعِيّ الشَّكْل (على شكل مِبضَع)",
 "lancetfish": "سمكة الذئب, سمكة المبضع (أسماك محيطية كبيرة ممدودة عديمة القشور ذات أسنان حادة وزعنفة ظهرية طويلة تشبه الشراع)",
 "lancewood": "خشب الرمح (مصدر لمعظم خشب الرمح التجاري) / خشب الرمح (خشب متين مستقيم الحبيبات لشجرة خشب الرمح؛ يستخدم للبناء والخزائن والأدوات)",
 "lancewood tree": "خشب الرمح (مصدر لمعظم خشب الرمح التجاري) / خشب الرمح, خشب الغار (شجرة أمريكية استوائية؛ تقدر لخشبها الصلب المتين)",
 "lancinate": "طَاعِن, لَاذِع (مؤلم كما لو كان ناتجاً عن أداة حادّة)",
 "lancinating": "طَاعِن, لَاذِع (مؤلم كما لو كان ناتجاً عن أداة حادّة)",
 "land": "بَرّ, أَرْض (أحسن إلى والديه أو إلى غيره بالخير والاحترام؛ صدق أو وفى بوعد أو عهد) / بِلَاد, أَرْض / هَبَطَ\nمثال: دخل زيري إلى منطقة ببر.",
 "land agent": "وكيل أراضي (شخص يدير عقاراً من الأراضي) / سمسار عقارات, وسيط عقاري (شخص مخول للعمل كوكيل لبيع الأراضي والعقارات)",
 "land area": "رقعة أرض, مساحة أرض (مساحة من الأرض تستخدم لغرض معين (مثل البناء أو الزراعة))\nمثال: أراد بعض المساحة من الأرض للبناء عليها",
 "land bridge": "جسر يابسة (شَجُعَ، جرُؤ؛ أقدم على الخطر واجترأ)\nمثال: اذهب إلى الجسر.",
 "land cress": "رشاد أمريكي, رشاد الأرض (من جنوب غرب أوروبا؛ يزرع في فلوريدا)",
 "land development": "استصلاح الأراضي, تطوير الأراضي (جعل مساحة من الأرض أكثر فائدة)",
 "land grant": "منحة أرض (منحة أرض عامة (كما هو الحال لخط سكة حديد أو كلية))",
 "land line": "خط أرضي (خط هاتف ينتقل عبر دوائر أرضية (سلكية أو ألياف بصرية))\nمثال: يمكن أن يكون الخط الأرضي سلكياً أو أليافاً بصرية أو ميكروويف",
 "land mass": "كتلة أرضية, كتلة يابسة (مساحة كبيرة متصلة من الأرض)",
 "land mile": "ميل (وحدة للطول تساوي 1,760 ياردة أو 5,280 قدماً؛ تساوي بالضبط 1609.344 متراً)",
 "land mine": "لَغْم, لَغْم أَرْضِيّ",
 "land of israel": "أَرْض إِسْرَائِيل (الكَوْكَب الذي نعيش عليه. لا جمع له؛ البَرّ، ضد البَحْر. يجمع على أرضون)\nمثال: أرض الله واسعة.",
 "land of the rising sun": "أَرْضُ الشَّمْسِ الْمُشْرِقَةِ (الكَوْكَب الذي نعيش عليه. لا جمع له؛ البَرّ، ضد البَحْر. يجمع على أرضون)\nمثال: أرض الله واسعة.",
