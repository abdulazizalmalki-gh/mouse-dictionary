 "jerry-built": "رَدِيء البِنَاء, مُرْتَجَل (مبنيّ بطريقة رديئة أو متسرعة)",
 "jersey": "جِيرْزِي",
 "jersey elm": "دردار جيرسي (صنف من الدردار الإنجليزي بفروع قائمة وأوراق أعرض)",
 "jersey fern": "سرخس جيرسي, سرخس حولي (سرخس صغير قصير العمر من أمريكا الوسطى والجنوبية)",
 "jersey knapweed": "قنطريون جيرسي (صنف من القنطريون)",
 "jersey pine": "صنوبر جيرسي, صنوبر فرجينيا (صنوبر شجيري صغير شائع في شرق الولايات المتحدة له فروع متناثرة ملتوية غالباً وإبر قصيرة في حزم من 2)",
 "jerusalem": "الْقُدْس, بَيْت الْمَقْدِس",
 "jerusalem artichoke": "أرضي شوكي قدسي, خرشوف قدسي (درنة دوار الشمس تؤكل نيئة أو مسلوقة أو مقطعة إلى شرائح رقيقة ومقلية) / أرضي شوكي, خرشوف القدس (نبات معمر طويل بسيقان وأوراق مشعرة؛ يزرع على نطاق واسع لدرناته الكبيرة غير المنتظمة الصالحة للأكل) / خرشوف القدس, طرطوفة (درنة صالحة للأكل لخرشوف القدس)",
 "jerusalem artichoke sunflower": "أرضي شوكي, خرشوف القدس (نبات معمر طويل بسيقان وأوراق مشعرة؛ يزرع على نطاق واسع لدرناته الكبيرة غير المنتظمة الصالحة للأكل)",
 "jerusalem cherry": "كرز الشتاء, كرز القدس (شجيرة صغيرة من أمريكا الجنوبية تزرع كنبات منزلي لثمارها الحمراء أو الصفراء الزخرفية الوفيرة ولكن السامة بحجم الكرز)",
 "jerusalem cricket": "صرصور الرمل, صرصور القدس (جندب ليلي كبير عديم الأجنحة يحفر في التربة الرخوة على طول ساحل المحيط الهادئ للولايات المتحدة)",
 "jerusalem cross": "صليب القدس (صليب بأذرع متساوية، ينتهي كل منها بعارضة صغيرة)",
 "jerusalem oak": "إبرة الراعي الريشية, بلوط القدس (رجل الوزة الأوراسي العطري ذو الأوراق الشبيهة بالبلوط والعديد من الزهور الصفراء الخضراء؛ متوطن في أمريكا الشمالية)",
 "jerusalem sage": "فلوميس شجيري, ميرمية القدس (شجيرة منتشرة في مناطق البحر الأبيض المتوسط تزرع لدواماتها الإبطية الكثيفة من الزهور الأرجوانية أو الصفراء)",
 "jerusalem thorn": "سنط الكادي, كاث هندي (شجرة شائكة من جزر الهند الشرقية لها أوراق ريشية مزدوجة وزهور صفراء تليها قرون مسطحة؛ مصدر للكاث الأسود) / شوكة القدس, فاصوليا الحصان (شجيرة كبيرة أو شجرة شجيرية ذات أشواك حادة وأوراق ريشية وريقات صغيرة متساقطة وأزهار صفراء برتقالية عنقودية حلوة الرائحة؛ تزرع كزينة أو سياج أو طعام…) / سدر, عناب (شجرة شائكة ذات ثمار حمراء داكنة صالحة للأكل) / باليورس, شوك المسيح (شجيرة أوراسية شائكة بثمار مجنحة خشبية جافة)",
 "jerusalemite": "مَقْدِسِيّ",
 "jessamine": "ياسمين حقيقي, ياسمين شائع (شجيرة متساقطة الأوراق متسلقة بزهور عطرة بيضاء أو صفراء أو حمراء تستخدم في العطور ولتنكيه الشاي)",
 "jessica": "جِيسِيكَا",
 "jessie": "جِيسِي",
 "jessore": "جَسَر (شَجُعَ، جرُؤ؛ أقدم على الخطر واجترأ)\nمثال: اذهب إلى الجسر.",
 "jessore district": "ضِلْع جَسَر",
 "jessorite": "جَسَرِيّ",
 "jest": "دعابة, مزاح (نشاط يتميز بالمرح والفكاهة) / طُرْفَة, مَزْحَة (حكاية فكاهية أو ملاحظة تهدف إلى إثارة الضحك)\nمثال: روى نكتة مضحكة جداً",
 "jester": "بَهْلُول",
 "jesting": "مَزَّاح, هَزْلِيّ (يتّسم بالمُزاح وحُسن الدعابة)",
 "jestingly": "على سبيل المزاح, مازحاً\nمثال: سألته مازحاً عما إذا كان يعتقد أنه يستطيع قيادة قطار كالكوتا-بيشاور السريع (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال.",
 "jesuit": "يَسُوعِيّ, يَسُوعِيَّة",
 "jesuit order": "الرهبنة اليسوعية, جمعية اليسوعيين (نظام كاثوليكي روماني أسسه القديس إغناطيوس لويولا عام 1534 للدفاع عن الكاثوليكية ضد الإصلاح والقيام بعمل تبشيري؛ ملتزم بشدة بالتعليم والمنح الدراسية)",
 "jesuit's bark": "كِينَا, لِحَاء الكِينَا (لحاء طبي لأشجار الكينا؛ مصدر للكينين والكينيدين)",
 "jesuitic": "يسوعي (لديه صفات مميزة لليسوعيين أو الرهبنة اليسوعية)\nمثال: تعليم يسوعي",
 "jesuitical": "يسوعي (لديه صفات مميزة لليسوعيين أو الرهبنة اليسوعية)\nمثال: تعليم يسوعي",
 "jesuitism": "اليسوعية (لاهوت أو ممارسات اليسوعيين (غالبًا ما تعتبر مراوغة))",
 "jesuitry": "اليسوعية (لاهوت أو ممارسات اليسوعيين (غالبًا ما تعتبر مراوغة))",
 "jesuits' nut": "جوز اليسوعيين, كستناء الماء (نوع من كستناء الماء)",
 "jesus": "عِيسَى ((في الإسلام) عيسى بن مريم، نبي أُرسل إلى بني إسرائيل؛ آتاه الله الإنجيل، وورد ذكره في القرآن ٢٥ مرة، وهو أحد أولي العزم؛ اسم شخصي معطى للذكور من المسلمين العرب)\nمثال: كان عيسى يهوديا.",
 "jesus christ": "يَسُوع الْمَسِيح, عِيسَى الْمَسِيح ((في المسيحية) الْمَسِيح يَسُوع النَّاصِرِيّ، وهو الشخصية المركزية في المسيحية، حيث يؤمنون بأنه ابن الله…)\nمثال: كان يسوع يهوديا.",
 "jet": "مُحَرِّك نَفَّاث (اسم فاعل من حَرَّكَ؛ اسم آلة) / دفق (دَفَقَ: صَبَّهُ، وَهُوَ ماءٌ دافِقٌ، دَفَقَ اللهُ رُوحَه أَي: أَماتَهُ، ودَفَقَ الكُوزَ: بَدَّدَ مَا فِيه بمَرَّةِ)\nمثال: المحرك لا يعمل.",
 "jet black": "أبنوسي, أسود حالك (أسود داكن جداً)",
 "jet bridge": "جسر الركاب, ممر الصعود للطائرة (جسر قابل للتمديد لتحميل الركاب على الطائرات التجارية الكبيرة؛ يوفر وصولاً محمياً للطائرة من البوابة)",
 "jet engine": "محرك نفاث (توربين غازي ينتج تياراً من الغاز الساخن يدفع الطائرة النفاثة بواسطة الدفع التفاعلي)",
 "jet lag": "إعياء السفر, اضطراب الرحلات الجوية الطويلة (تعب واضطراب في النوم ناتج عن خلل في الإيقاع اليومي الطبيعي للجسم نتيجة السفر بالطائرة)",
 "jet plane": "طَائِرَة نَفَّاثَة (مَرْكَبَة كبيرة لها جناحان وتنقل الرُكَّاب والبَضَائِع بالجَوّ. ؛ كل من تَطِير، مؤنث طائر)\nمثال: لقد وصلت الطائرة.",
 "jet propulsion": "دفع نفاث (دفع عن طريق تصريف تيار نفاث من المائع نحو الخلف)",
 "jet set": "الأثرياء المتنقلون, النفاثون (مجموعة من الأثرياء والعصريين الذين يسافرون على نطاق واسع للمتعة)",
 "jet ski": "دَرَّاجَة مَائِيَّة, جِيت سْكِي (مَرْكَبَة من عجلتين أو ثلاث، ولها مقعد واحد عادة، مثل الدراجة الهوائية والدراجة النارية؛ دراجة هوائية. (تخصيص))\nمثال: كين يريد دراجة.",
 "jet stream": "تيار نفاث (تيار هوائي عالي السرعة والارتفاع يهب من الغرب إلى الشرق قرب قمة التروبوسفير؛ وله تأثيرات مهمة على تشكيل الجبهات الجوية)",
 "jet-black": "فَحْمِيّ",
 "jet-propelled": "مدفوع بالنفاث (مدفوع (أو كأنه مدفوع) بمحرك نفاث)",
 "jet-propelled plane": "طائرة نفاثة (طائرة تعمل بمحرك نفاث واحد أو أكثر)",
 "jeth": "جيايشثا (الشهر الثالث من التقويم الهندوسي)",
 "jethro": "يَثْرُون",
 "jetliner": "طائرة ركاب نفاثة (طائرة نفاثة كبيرة تنقل الركاب)",
 "jetsam": "حطام عائم (حطام سفينة يطفو على الماء) / حمولة مطروحة (جزء من معدات السفينة أو حمولتها يُرمى في البحر لتخفيف الحمل أثناء العاصفة)",
 "jetting": "مُتَطَاير, مُنْدَفِع (يُدفَع بقوَّة في مجرى ضيِّق عادةً)",
 "jetty": "كاسر الأمواج (هيكل واقي من الحجر أو الخرسانة؛ يمتد من الشاطئ إلى الماء لمنع جرف الشاطئ)",
 "jeu d'esprit": "دُعَابَة بَارِعَة, نُكْتَة ذَكِيَّة (تعليق أو كتابة بارعة)",
 "jeune fille": "صبية, فتاة (فتاة أو شابة غير متزوجة)",
 "jew": "يَهُودِيّ, يَهُودِيَّة (صفة المنسوب إلى اليَهُود، سواء كان شخصا أو شيئا أو فكرة أو غيره؛ معتنق الديانة اليهودية)\nمثال: أنا يهودي أمريكي.",
 "jew bush": "شجيرة اليهودي, صبار الطائر الأحمر (شجيرة أمريكية استوائية منخفضة ذات خصائص مقيئة قوية)",
 "jew's harp": "القيثار الفكي, قيثارة اليهود (آلة موسيقية صغيرة على شكل قيثارة توضع بين الأسنان ويتم العزف عليها بنقر لسان سلكي مع تغيير شكل تجويف الفم)",
 "jew's-ear": "أذن يهوذا, فطر الأذن (فطر صالح للأكل واسع الانتشار على شكل أذن بشرية وينمو على الخشب المتحلل)",
 "jew's-ears": "أذن يهوذا, فطر الأذن (فطر صالح للأكل واسع الانتشار على شكل أذن بشرية وينمو على الخشب المتحلل)",
 "jew-baiter": "معاد للسامية (شخص يكره اليهود ويضطهدهم)",
 "jew-bush": "شجيرة اليهودي, صبار الطائر الأحمر (شجيرة أمريكية استوائية منخفضة ذات خصائص مقيئة قوية)",
 "jewbush": "شجيرة اليهودي, صبار الطائر الأحمر (شجيرة أمريكية استوائية منخفضة ذات خصائص مقيئة قوية)",
 "jewel": "جَوْهَر, جَوْهَرَة (جَوْهَر)\nمثال: الجمال في الجوهر لا المظهر",
 "jewel casket": "صندوق مجوهرات (صندوق صغير ومزخرف غالباً لحفظ المجوهرات أو الأشياء الثمينة الأخرى)",
 "jewel orchid": "أوركيد الجوهرة (أي من عدة بساتين فاكهة آسيوية رقيقة تزرع خاصة لأوراقها المخملية ذات التعريق الأبيض المعدني أو الذهبي)",
 "jeweled": "مُرَصَّع, مُزَيَّن بِالجَوَاهِر (مُغطّى بالخرز أو الجواهر أو الترتر)",
 "jeweled headdress": "غطاء رأس مرصع بالمجوهرات (غطاء رأس مزين بالمجوهرات)",
 "jeweler": "صَائِغ, صَائِغَة",
 "jeweler's glass": "عدسة الجواهرجي (أداة بصرية يستخدمها الصاغة؛ تحتوي على عدسة واحدة أو أكثر وتستخدم لعرض الميزات التي لا يمكن رؤيتها بسهولة)",
 "jeweler's loupe": "عدسة الجواهرجي, لوب (عدسة مكبرة صغيرة (توضع عادة في عدسة عينية) يستخدمها صاغة المجوهرات والساعاتيون)",
