 "jacket": "جَاكِيت, جَاكِت",
 "jacket crown": "تاج, تلبيسة ((طب الأسنان) جهاز سني يتكون من تاج صناعي لسن مكسور أو مسوس)\nمثال: غداً سيقوم طبيب الأسنان بتركيب تاج لي",
 "jacket potato": "بطاطس بقشرها (بطاطس مخبوزة تقدم بقشرتها)",
 "jackfruit": "جاكية",
 "jackfruit tree": "جاك فروت, جاكية (شجرة من جزر الهند الشرقية تزرع لفاكهتها الضخمة الصالحة للأكل وبذورها)",
 "jackhammer": "آلَات ثَقْب الصُخُور",
 "jacking off": "استمناء, جلك (مصطلحات عامية للاستمناء)",
 "jackknife": "غطسة المطواة (غطسة ينحني فيها الغطاس للمس كاحليه قبل أن يستقيم) / سكين جيب كبير, مِطواة (سكين كبير بشفرة أو أكثر قابلة للطي)",
 "jackknife clam": "محار الموس (محار بحري له صدفة رقيقة منحنية ضيقة طويلة)",
 "jackknife-fish": "سمكة المطواة (سمكة طبل سوداء وبيضاء ذات زعنفة ظهرية ممدودة منتصبة)",
 "jacklight": "مصباح الصيد (ضوء يستخدم كطعم في الصيد أو صيد الأسماك ليلاً)",
 "jackpot": "الجَائِزَةُ الكُبْرَى",
 "jackrabbit": "أرنب جاك (أرنب بري كبير من غرب أمريكا الشمالية)",
 "jacks": "الكعاب, اللقف (لعبة تُلعب برمي قطع صغيرة والتقاطها في مجموعات مختلفة بين ارتدادات كرة مطاطية صغيرة)",
 "jackscrew": "رافعة لولبية (رافعة تعمل باللولب)",
 "jacksmelt": "جاكسميلت (سمكة فضية الجوانب كبيرة نسبياً تعيش في ساحل المحيط الهادئ لأمريكا الشمالية (يصل طولها إلى 18 بوصة))",
 "jacksnipe": "دريجة سوداء الظهر (طيطوي أمريكي ينفخ صدره عند المغازلة) / شنقب صغير (شنقب صغير قصير المنقار من العالم القديم)",
 "jackson": "جَاكْسُون",
 "jacksonian": "جاكسوني (من أو متعلق بأندرو جاكسون أو رئاسته أو مفاهيمه عن الديمقراطية الشعبية) / جاكْسُونِيّ (تابع لأندرو جاكسون أو أفكاره)",
 "jacksonian epilepsy": "صرع جاكسوني (صرع بؤري تنتقل فيه النوبة عادة من عضلات الأطراف البعيدة إلى القريبة على نفس الجانب من الجسم)",
 "jackstones": "الكعاب, اللقف (لعبة تُلعب برمي قطع صغيرة والتقاطها في مجموعات مختلفة بين ارتدادات كرة مطاطية صغيرة) / العظيمات, جاك (معدات ألعاب تتكون من واحدة من عدة قطع معدنية صغيرة سداسية الرؤوس يتم التقاطها أثناء ارتداد الكرة في لعبة العظيمات)",
 "jackstraw": "عود اللعب (شريط رفيع من الخشب يستخدم في لعبة \"جاك سترو\")",
 "jackstraws": "جاك ستروز, لعبة التقاط القش (لعبة يحاول فيها اللاعبون التقاط قشة (أو عود) من كومة دون تحريك أي من القشات الأخرى)",
 "jacob": "يَعْقُوب (اسم شخصي معطًى للعرب وغيرهم من المسلمين)\nمثال: يعقوب يهودي لائكي.",
 "jacob's ladder": "سلم حبلي ((في الملاحة) سلم معلق من الحبال أو السلاسل يدعم درجات خشبية أو معدنية) / سلم يعقوب, ناردين يوناني (نبات معمر أوروبي ذو أوراق ريشية له زهور زرقاء زاهية أو بيضاء)",
 "jacob's rod": "قضيب يعقوب (بروق له ساق قائمة ناعمة غير متفرعة إما متعرجة أو مستقيمة)",
 "jacob's staff": "أوكوتيلو, سوط المدرب (شجيرة صحراوية من جنوب غرب الولايات المتحدة والمكسيك لها فروع شائكة عارية رفيعة تخرج أوراقاً وعناقيد من الزهور الحمراء بعد موسم الأمطار)",
 "jacobean": "يعقوبي (من أو متعلق بالملك جيمس الأول أو عهده أو عصره) / يعقوبي (أي شخصية بارزة خلال عهد جيمس الأول)\nمثال: كتاب يعقوبيون",
 "jacobean lily": "زنبق الأزتيك, زنبق جاكوبيان (عشبة بصلية مكسيكية تزرع لزهرتها الحمراء الزاهية المنفردة الجميلة)",
 "jacobin": "يعقوبي (عضو في الحركة الراديكالية التي أسست عهد الإرهاب خلال الثورة الفرنسية)",
 "jacobinic": "يعقوبي (من أو متعلق باليعقوبيين في الثورة الفرنسية)\nمثال: إرهاب يعقوبي",
 "jacobinical": "يعقوبي (من أو متعلق باليعقوبيين في الثورة الفرنسية)\nمثال: إرهاب يعقوبي",
 "jacobinism": "يعقوبية (أيديولوجية العنصر الأكثر راديكالية في الثورة الفرنسية الذي أسس عهد الإرهاب)",
 "jacobite": "يعقوبي (مؤيد لجيمس الثاني بعد الإطاحة به أو مؤيد لأسرة ستيوارت)",
 "jaconet": "جاكونيت (قماش قطني خفيف الوزن ذو لمسة ناعمة وصلبة قليلاً؛ يستخدم للملابس والضمادات)",
 "jacquard": "نول جاكارد (نول بملحق لتشكيل فتحات لمرور المكوك بين خيوط السدى؛ يستخدم في نسج الأقمشة المزخرفة) / جاكار (قماش ذو نقوش معقدة منسوج على نول الجاكار)",
 "jacquard loom": "نول جاكارد (نول بملحق لتشكيل فتحات لمرور المكوك بين خيوط السدى؛ يستخدم في نسج الأقمشة المزخرفة)",
 "jacquemier's sign": "علامة جاكيمييه (تغير لون الغشاء المخاطي للمهبل إلى الأرجواني الذي يحدث في وقت مبكر من الحمل)",
 "jacquinia armillaris": "خشب السوار (شجيرة أو شجرة صغيرة من جزر الهند الغربية ذات بذور لامعة صلبة منقوشة بالأصفر والبني تستخدم لصنع الأساور)",
 "jacquinia keyensis": "بارباسكو, خشب جو (شجيرة أو شجرة صغيرة من جزر الهند الغربية ذات أوراق صابونية جلدية وخشب صلب للغاية)",
 "jactation": "تقلب, تململ مرضي ((علم الأمراض) تقلب وتشنج شديد القلق عادة لدى شخص مصاب بمرض خطير)",
 "jactitation": "تقلب, تململ مرضي ((علم الأمراض) تقلب وتشنج شديد القلق عادة لدى شخص مصاب بمرض خطير) / تبجح كاذب ((قانون) تفاخر كاذب يمكن أن يضر بالآخرين؛ خاصة الادعاء الكاذب بالزواج من شخص ما (كان سابقاً قابلاً للمقاضاة قانونياً)) / تباهي, تفاخر (الحديث عن النفس بصيغ التفخيم)",
 "jaculus jaculus": "يربوع مصري صغير (نوع من اليربوع)",
 "jacuzzi": "جَاكُوزِي",
 "jade": "يَشْم / يَشْب",
 "jade green": "أخضر يشمي (لون أخضر فاتح يتراوح من الأزرق المخضر إلى الأخضر المصفر)",
 "jade vine": "سترونجيلودون, كرمة اليشم (ليانا فلبينية قوية دائمة الخضرة ومتسلقة؛ تزرع من أجل أكاليلها الرائعة من الزهور الخضراء التي تشبه مخالب سرطان البحر)",
 "jade-green": "يَشْمِيّ اللَّوْن (بلون اليشم؛ يتراوح بين الأخضر المزرق والأخضر المصفر)",
 "jaded": "مُنْهَك",
 "jadeite": "جاديت (معدن أخضر صلب يتكون من سيليكات صوديوم ألمنيوم في شكل بلوري أحادي الميل؛ مصدر لليشم)",
 "jadestone": "حجر اليشم, يشم (حجر كريم شبه نفيس يقبل الصقل العالي؛ عادة ما يكون أخضر اللون ولكن أحياناً مائل للبياض، ويتكون من الجاديت أو النفريت)",
 "jaeger": "كركر (طائر بحري مفترس يطارد الطيور الأضعف لجعلها تسقط فريستها)",
 "jaffa": "يَافَا",
 "jaffa orange": "برتقال يافاوي, شموطي (برتقال حلو يكاد يخلو من البذور من فلسطين)",
 "jafnea semitosta": "جافنيا سيميتوستا (الأجسام الثمرية لهذا الفطر القرصي لها ملمس صلب وتحتفظ بشكل الكأس لفترة طويلة؛ يمتزج الداخل البني الشاحب مع لون الأوراق الميتة)",
 "jag": "نوبة تعاطي, نوبة سكر (نوبة من الشرب أو تعاطي المخدرات) / شراشيب, هدبة (لسان على طول حافة الثوب؛ استخدم في ملابس العصور الوسطى) / شق زخرفي (شق في الملابس يكشف عن مادة بلون مختلف تحته؛ استُخدم في ملابس عصر النهضة) / سن صخري, نتوء حاد (نتوء حاد على حافة أو سطح)\nمثال: تمسك بنتوء صخري",
 "jagatai": "التركية الشرقية, الجغتائية (لغة أدبية تركية لوسط آسيا في العصور الوسطى (سميت باسم أحد أبناء جنكيز خان))",
 "jagatai language": "التركية الشرقية, الجغتائية (لغة أدبية تركية لوسط آسيا في العصور الوسطى (سميت باسم أحد أبناء جنكيز خان))",
 "jaggary": "جاغري, سكر النخيل غير المكرر (سكر بني غير مكرر مصنوع من عصارة النخيل)",
 "jagged": "خَشِن, مُسَنَّن (ذو سطح أو محيط حادّ الانعراج) / مُتَآكِل, مُحَزَّز (ذو حافة محزّزة أو مسنّنة بشكل غير منتظم كأنّها مقضومة)",
 "jaggedly": "بشكل خشن, بشكل غير مستو (بمظهر غير مستو وخشن)\nمثال: لحية طويلة مقصوصة بشكل غير مستو",
 "jaggedness": "تسنّن, نُتُوء (شيء غير منتظم مثل نتوء أو شق في سطح أملس)",
 "jaggery": "جاغري, سكر النخيل غير المكرر (سكر بني غير مكرر مصنوع من عصارة النخيل)",
 "jaggery palm": "نخيل النبيذ, نخيل ذيل السمكة (نخيل ذيل السمكة من الهند إلى شبه جزيرة الملايو؛ تنتج عصارتها سكراً بنياً (جاغري) ولب الجذع ينتج الساغو)",
 "jagghery": "جاغري, سكر النخيل غير المكرر (سكر بني غير مكرر مصنوع من عصارة النخيل)",
 "jaggy": "خَشِن, مُسَنَّن (ذو سطح أو محيط حادّ الانعراج) / مُتَآكِل, مُحَزَّز (ذو حافة محزّزة أو مسنّنة بشكل غير منتظم كأنّها مقضومة)",
 "jaghatai": "التركية الشرقية, الجغتائية (لغة أدبية تركية لوسط آسيا في العصور الوسطى (سميت باسم أحد أبناء جنكيز خان))",
 "jaghatai language": "التركية الشرقية, الجغتائية (لغة أدبية تركية لوسط آسيا في العصور الوسطى (سميت باسم أحد أبناء جنكيز خان))",
 "jagua": "جاغوا, جنيباب (شجرة من جزر الهند الغربية وشمال أمريكا الجنوبية تحمل فاكهة عصيرية صالحة للأكل بحجم البرتقال)",
 "jaguar": "يَغْوَر",
 "jaguarondi": "جاغوارندي (قط بري استوائي أمريكي طويل الجسم وطويل الذيل)",
 "jaguarundi": "جاغوارندي (قط بري استوائي أمريكي طويل الجسم وطويل الذيل)",
 "jaguarundi cat": "جاغوارندي (قط بري استوائي أمريكي طويل الجسم وطويل الذيل)",
 "jahangirnagar": "مَدِينَة جَهَانْغِير, مَدِينَة جَهَانْكِير",
 "jahannam": "جَهَنَّم",
 "jai alai": "جاي ألاي (لعبة باسكية أو إسبانية تُلعب في ملعب بكرة ومضرب من الخوص)",
 "jail": "سِجْن, حَبْس (وضع شخصًا أو شيئًا في السجن أو الحبس؛ قيّد حرية شخص أو حركة شيء)\nمثال: دخل سامي السجن.",
 "jail bird": "سجين معتاد (مجرم سُجن مراراً وتكراراً)",
 "jail cell": "زنزانة, زنزانة سجن (غرفة يُحبس فيها السجين)",
 "jail delivery": "تهريب سجناء (استخدام القوة لتحرير السجناء)",
 "jailbird": "سجين معتاد (مجرم سُجن مراراً وتكراراً)",
 "jailbreak": "هروب من السجن (هروب من السجن) / كسر الحماية (إزالة أقفال الأمان من جهاز إلكتروني)\nمثال: تم التخطيط للهروب بعناية",
 "jailed": "أَسِير, سَجِين (فِي حَالَة أَسْر أَوِ احْتِجَاز)",
 "jailer": "حارِس سِجْن, سَجَّان (شخص يحرس السجناء)",
 "jailhouse": "حبس, سجن (مؤسسة إصلاحية تستخدم لاحتجاز الأشخاص الموجودين في الحجز القانوني للحكومة (إما متهمين ينتظرون المحاكمة أو مدانين يقضون عقوبة))",
 "jailor": "حارِس سِجْن, سَجَّان (شخص يحرس السجناء)",
 "jain": "يَايْنِيَّة, جَايْنِيَّة",
 "jainism": "جَيْنِيَّة, جَايْنِيَّة",
 "jainist": "جايني (متعلق بالجاينية أو مميز لها) / جاينِيّ (مؤمن بالجاينية)\nمثال: آلهة جاينية",
 "jaipur": "جايبور",
 "jak": "الكاكايا, جاك فروت (فاكهة هندية شرقية ضخمة تشبه ثمرة الخبز؛ تحتوي على لب صالح للأكل وبذور مغذية تحمص عادة وتؤكل كالمكسرات)",
 "jakarta": "جَاكَرْتَا",
 "jakes": "مرحاض خارجي (مبنى خارجي صغير به مقعد يحتوي على ثقوب يمكن للمستخدم التبرز من خلالها)",
 "jakob-creutzfeldt disease": "مرض كروتزفيلد جاكوب (مرض دماغي نادر (قاتل عادة) (يحدث عادة في منتصف العمر) يسببه فيروس بطيء غير محدد؛ يتميز بخرف تدريجي وفقدان تدريجي للتحكم العضلي)",
 "jalal-abad": "جلال آباد (مَصْدَرُ الْفِعْلِ جَلَّ؛ اِسْمُ عَلَمٍ مَعْنَاهُ الرِّفْعَةَ وَالسُّمُوَّ)\nمثال: ويبقى وجه ربك ذو الجلال والإكرام.",
 "jalalabad": "جَلَال آبَاد (مَصْدَرُ الْفِعْلِ جَلَّ؛ اِسْمُ عَلَمٍ مَعْنَاهُ الرِّفْعَةَ وَالسُّمُوَّ)\nمثال: ويبقى وجه ربك ذو الجلال والإكرام.",
 "jalapeno": "هلابينو (فلفل حار أخضر أو أحمر من جنوب غرب الولايات المتحدة والمكسيك) / فلفل تشيلي, فلفل حريف (نبات يحمل فلفلاً طويلاً حاراً جداً ومستدقاً بدقة؛ عادة ما يكون أحمر)",
 "jalapeno pepper": "هلابينو (فلفل حار أخضر أو أحمر من جنوب غرب الولايات المتحدة والمكسيك)",
 "jalapeño": "هَلَبِينْيُو, هَالَابِينْيُو",
 "jalebi": "زَلَابِيَة, شُبَّاكِيَّة",
 "jalopy": "سَيَّارَة بَالِيَة (مؤنث سَيَّار، صفة للكثير السَيْر؛ القَافِلَة أوالقَوْم الذين يسيرون)\nمثال: إنه يملك سيارة.",
 "jalousie": "شيش, كوة شرائحية (مصراع مصنوع من شرائح مائلة) / نافذة شيش (نافذة ذات ريش زجاجية)",
 "jam": "مُرَبًّى / شَوَّشَ",
 "jam box": "مسجل محمول كبير (جهاز ستيريو محمول)",
 "jam session": "جلسة ارتجال موسيقي (حفلة جاز مرتجلة)",
 "jam-packed": "مَحْشُوّ, مُكْتَظّ (مُزْدَحِمٌ لِلغَايَةِ أَوْ مَمْلُوءٌ حَتَّى أَقْصَى طَاقَتِهِ)",
 "jamaat": "جَمَاعَة (العَدَد الكثير من النَاس أو الحَيْوَان أو النَبَات أو غيره. المَجْمُوعَة؛ طَائِفَة من الناس التي يجمعها مكان و بيئة واحدة أو تتشارك اهداف و غايات واحدة)\nمثال: توم قائد جماعة أنونيموس.",
 "jamahiriya": "جَمَاهِيرِيَّة",
 "jamaica": "جَامَايْكَا",
 "jamaica apple": "قشطة شبكية, قلب الثور (فاكهة استوائية كبيرة على شكل قلب ذات لب حمضي طري)",
 "jamaica bayberry": "شجرة الباي, شجرة رم الباي (شجرة من جزر الهند الغربية؛ مصدر لرم الباي)",
 "jamaica caper tree": "شجرة القبار الجامايكية (شجيرة من جنوب فلوريدا إلى جزر الهند الغربية)",
 "jamaica dogwood": "بيسيديا, قرانيا جامايكا (شجرة صغيرة في جزر الهند الغربية وفلوريدا لها أوراق ريشية فردية كبيرة وعناقيد من الزهور المخططة بالأحمر والأرجواني والأبيض تليها قرون بذور مجنحة…)",
 "jamaica honeysuckle": "صريمة الجدي الجامايكية, غرانديلا صفراء (زهرة العاطفة من جزر الهند الغربية؛ تزرع لثمارها الصفراء الصالحة للأكل)",
 "jamaica quassia": "بيكراسما سامقة, كواسيا جامايكية (شجرة في جزر الهند الغربية تنتج عقار الكواسيا الجامايكي) / قاسية جامايكا (مشابه للمستخلص من نبات القاسية المرة)",
 "jamaica rum": "رم جامايكا (رم ثقيل لاذع من جامايكا)",
 "jamaica shorts": "شورت برمودا ((تستخدم بصيغة الجمع) سراويل قصيرة تنتهي عند الركبة)",
 "jamaica sorrel": "حميض أحمر, غجر (عشبة سنوية شائكة قليلاً من شرق الهند أو شجيرة معمرة تزرع على نطاق واسع لكؤوسها اللحمية المستخدمة في الفطائر والهلام ولألياف اللحاء)",
 "jamaican": "جامايكي, جامايكية",
 "jamaican cherry": "شجرة كالابور, كرز جامايكي (شجرة استوائية أمريكية سريعة النمو دائمة الخضرة ذات أزهار بيضاء وثمار صالحة للأكل لحمية؛ ينتج اللحاء أليافاً حريرية تستخدم في الحبال والخشب قيم للألواح)",
 "jamaican creole": "كَرِيُولِيَّة جَامَايْكِيَّة, اَلبَاتْوَا الْجَامَايْكِيَّة",
 "jamaican dollar": "دولار جامايكي (وحدة المال الأساسية في جامايكا)",
 "jamais vu": "جيمي فو, مألوف منسي (تجربة عدم الألفة مع شخص أو موقف مألوف جداً في الواقع؛ ترتبط بأنواع معينة من الصرع)",
 "jamal": "جَمَال",
 "jamalpur district": "ضِلْع جَمَالْفُور",
 "jamb": "عضادة (قائم يتكون من عضو جانبي عمودي لإطار باب أو نافذة)",
 "jambalaya": "جَامْبَالَايَا",
 "jambeau": "واقي الساق (درع صفيحي يحمي الساقين أسفل الركبة)",
 "jamberry": "توماتيلو, طماطم قشرية مكسيكية (نبات حولي من المكسيك وجنوب الولايات المتحدة له ثمار لزجة أرجوانية صالحة للأكل تشبه الطماطم الصغيرة) / توماتيلو, ميلتومات (نبات حولي مكسيكي تم توطينه في شرق أمريكا الشمالية له ثمار صفراء إلى أرجوانية صالحة للأكل تشبه الطماطم الصغيرة)",
 "jambiya": "جَنْبِيَّة",
 "jambon": "فخذ الخنزير, هام (لحم مقطوع من فخذ الخنزير (عادة مدخن))",
 "jamboree": "مخيم",
 "jambosa": "تفاح الورد, جامبوزا (شجرة استوائية من جزر الهند الشرقية تزرع لفاكهتها الصالحة للأكل)",
 "james": "يَعْقُوب (اسم شخصي معطًى للعرب وغيرهم من المسلمين) / جَايْمْز, جَيْمْس\nمثال: يعقوب يهودي لائكي.",
 "james bond": "جِيمْس بُونْد, جَيْمْس بُونْد",
 "jamesian": "جيمسي (مكون من أو متعلق بـ أو مميز لهنري جيمس أو كتاباته) / جيمسي (مكون من أو متعلق بـ أو مميز لوليام جيمس أو فلسفته أو تعاليمه)",
 "jamestown weed": "تفاح شوكي, داتورا صفراوية (عشبة استوائية سنوية طويلة خشنة وسامة للغاية ذات أوراق كريهة الرائحة وزهور بيضاء أو بنفسجية كبيرة على شكل بوق وثمار شائكة)",
 "jamila": "جَمِيلَة",
 "jamjar": "برطمان مربى, وعاء مربى (جرة لحفظ الهلام أو المربى)",
 "jammed": "مَحْشُوّ, مُكْتَظّ (مُزْدَحِمٌ لِلغَايَةِ أَوْ مَمْلُوءٌ حَتَّى أَقْصَى طَاقَتِهِ)",
 "jammer": "جهاز تشويش (جهاز إرسال يستخدم لبث التشويش الإلكتروني)",
 "jammies": "بيجامة, منامة ((عادة جمع) ملابس نوم فضفاضة للنوم أو الاسترخاء؛ لها سترة علوية وسروال)",
 "jamming": "تشويش, تشويش إلكتروني (إشعاع أو عكس متعمد للطاقة الكهرومغناطيسية لغرض تعطيل استخدام العدو للأجهزة أو الأنظمة الإلكترونية)",
 "jammu and kashmir": "جَامُو وَكَشْمِير",
 "jampan": "جامبان (نوع من الكراسي المحمولة المستخدمة في الهند)",
 "jampot": "برطمان مربى, وعاء مربى (جرة لحفظ الهلام أو المربى)",
 "jan": "كانون الثاني, يناير (الشهر الأول من السنة)",
 "jan mayen": "يَان مَايِن",
 "jane": "جِيهَان / جِين",
 "jane doe": "جين دو, فلانة (امرأة مجهولة أو وهمية تكون طرفاً في إجراءات قانونية)",
 "jangle": "خشخشة, رنين (صوت معدني)\nمثال: خشخشة العملات المعدنية",
 "jangling": "مُصَلْصِل, مُطَنْطِن (كَالرَّنِين المُتَنَافِر لِأَجْسَام مَعْدَنِيَّة غَيْر مُوسِيقِيَّة تَصْطَدِم بِبَعْضِهَا)",
 "jangly": "مُصَلْصِل, مُطَنْطِن (كَالرَّنِين المُتَنَافِر لِأَجْسَام مَعْدَنِيَّة غَيْر مُوسِيقِيَّة تَصْطَدِم بِبَعْضِهَا)",
 "janissary": "إِنْكِشَارِيّ",
 "janitor": "بَوَّاب",
 "jankoy": "دجانكوي",
 "jannatabad": "جَنَّت آبَاد, جَنَّت أَبَاد (جَنَّة)\nمثال: على نفسها جنت براقش!",
 "jansenism": "جانسينية (العقيدة الكاثوليكية الرومانية لكورنيليس جانسين وتلاميذه؛ الخلاص يقتصر على أولئك الذين يخضعون للحتمية الخارقة للطبيعة والباقي مصيرهم الهلاك)",
 "jansenist": "جانسيني (مدافع عن الجانسينية)",
 "january": "يَنَايِر, كَانُون اَلثَّانِي (الشهر الأول من السنة الروميّة)\nمثال: لتبدأ الاحتفالات بيناير.",
 "january 1": "أول أيام السنة, يوم رأس السنة (اليوم الأول من السنة) / 1 يناير, عيد مريم والدة الله ((الكنيسة الكاثوليكية) يوم مقدس واجب) / 1 يناير, عيد الختان ((الكنيسة الكاثوليكية والكنيسة الأنجليكانية) عيد يحتفل بختان يسوع؛ يُحتفل به في الأول من يناير)",
 "january 19": "19 يناير, عيد ميلاد روبرت إي لي (عطلة بمناسبة تاريخ ميلاد الجنرال الكونفدرالي روبرت إي لي، يُحتفل بها كل عام في 19 يناير في جنوب الولايات المتحدة)",
 "january 20": "20 يناير, يوم التنصيب (اليوم المخصص لتنصيب رئيس الولايات المتحدة) / 20 يناير, عشية القديسة أغنيس (يوم مقدس مسيحي يُقال فيه إن النساء اللواتي يؤدين طقوسًا معينة يحلمن بزوج المستقبل)",
 "january 6": "6 يناير, عيد الغطاس (بعد اثني عشر يومًا من عيد الميلاد؛ يحتفل بزيارة الحكماء الثلاثة للطفل يسوع)",
 "janus": "يَانُوس",
 "janus-faced": "ذُو وَجْهَيْن (له وجهان أحدهما يتطلع إلى المستقبل والآخر إلى الماضي) / ذُو وَجْهَيْن, مُرَاوِغ (يتَّسم بخداع متعمَّد خاصَّة بإظهار مشاعر والتصرُّف بمشاعر أخرى) / ذُو وَجْهَيْن, يَانُوسِيّ (يتعامل مع الأقطاب أو التناقضات أو يتعلق بها)",
 "jap": "ياباني (مصطلح مسيء) ((عامية مسيئة) مصطلح مسيء لشخص من أصل ياباني)",
 "jap clover": "برسيم ياباني, ليسبيديزا مخططة (نبات حولي من آسيا الاستوائية تم توطينه في الولايات المتحدة)",
 "japan": "الْيَابَان (دولة جزرية في شرق قارة آسيا، عاصمتها طوكيو)\nمثال: أنا من اليابان.",
 "japan allspice": "بهار ياباني, حلوى الشتاء (شجيرة يابانية نفضية تزرع لأزهارها الصفراء العطرة)",
 "japan bittersweet": "حلوة مرة يابانية, سيلاستروس ياباني (كرمة زينة آسيوية بثمار برتقالية صفراء مبهرجة مع غلاف قرمزي؛ مستوطنة في أمريكا الشمالية)",
 "japan cedar": "أرز ياباني, سوجي (شجرة دائمة الخضرة طويلة من اليابان والصين تنتج خشباً ناعماً قيماً)",
 "japan clover": "برسيم ياباني, ليسبيديزا مخططة (نبات حولي من آسيا الاستوائية تم توطينه في الولايات المتحدة)",
 "japan current": "تيار اليابان, تيار كوروشيو (تيار محيطي دافئ يتدفق باتجاه الشمال الشرقي قبالة ساحل اليابان إلى شمال المحيط الهادئ)",
 "japan tallow": "شمع اليابان (شمع أصفر يُستخرج من توت السماق؛ يُستخدم في التلميع)",
 "japan wax": "شمع اليابان (شمع أصفر يُستخرج من توت السماق؛ يُستخدم في التلميع)",
 "japanese": "يَابَانِيّ",
 "japanese allspice": "بهار ياباني, حلوى الشتاء (شجيرة يابانية نفضية تزرع لأزهارها الصفراء العطرة)",
 "japanese andromeda": "أندروميدا يابانية, شجرة زنبق الوادي (شجيرة آسيوية دائمة الخضرة عريضة الأوراق ذات أوراق لامعة وعناقيد متدلية من الزهور البيضاء)",
 "japanese angelica tree": "شجرة أنجليكا اليابانية (شجيرة آسيوية نفضية تشكل كتلاً أو شجرة صغيرة؛ دخيلة في شرق الولايات المتحدة)",
 "japanese apricot": "مشمش ياباني (شجرة زينة يابانية بزهور بيضاء أو وردية عطرة وثمار صفراء صغيرة)",
 "japanese banana": "موز ياباني (نبات موز آسيوي يزرع خاصة كنبات ورقي في اليابان)",
 "japanese barberry": "باربيريس ياباني (شجيرة نفضية مدمجة لها توت أحمر دائم؛ واسعة الانتشار في الزراعة خاصة للأسوار الحية)",
 "japanese barnyard millet": "دخن ياباني (عشب حولي خشن يزرع في اليابان وجنوب شرق آسيا لبذوره الصالحة للأكل وللعلف؛ غذاء مهم للحياة البرية في الولايات المتحدة)",
 "japanese beech": "زان ياباني (زان موطنه اليابان له خشب بني مصفر فاتح ناعم)",
 "japanese beetle": "خنفساء يابانية (خنفساء صغيرة خضراء وبنية معدنية موطنها شرق آسيا؛ آفة نباتية خطيرة في أمريكا الشمالية)",
 "japanese bittersweet": "حلوة مرة يابانية, سيلاستروس ياباني (كرمة زينة آسيوية بثمار برتقالية صفراء مبهرجة مع غلاف قرمزي؛ مستوطنة في أمريكا الشمالية)",
 "japanese black pine": "صنوبر أسود ياباني (نبات زينة ياباني كبير له إبر طويلة في حزم من 2؛ يزرع على نطاق واسع في الولايات المتحدة لمقاومته للملح والضباب الدخاني)",
 "japanese brome": "برومس ياباني (عشبة من البحر الأبيض المتوسط وآسيا المعتدلة)",
 "japanese carpet grass": "عشبة السجاد اليابانية, عشبة مانيلا (عشبة مروج شائعة في الفلبين؛ تزرع أيضاً في الولايات المتحدة)",
 "japanese cedar": "أرز ياباني, سوجي (شجرة دائمة الخضرة طويلة من اليابان والصين تنتج خشباً ناعماً قيماً)",
 "japanese cherry": "كرز شرقي, كرز ياباني (شجرة زينة بفاكهة غير صالحة للأكل تزرع على نطاق واسع في العديد من الأصناف لأزهارها البيضاء)",
 "japanese chess": "برومس ياباني (عشبة من البحر الأبيض المتوسط وآسيا المعتدلة)",
 "japanese chestnut": "كستناء يابانية (شجرة منتشرة في اليابان لها جذع قصير)",
 "japanese clover": "برسيم ياباني, ليسبيديزا مخططة (نبات حولي من آسيا الاستوائية تم توطينه في الولايات المتحدة)",
 "japanese crab": "سلطعون ياباني (لحم سلطعون يعلب عادة؛ من اليابان)",
 "japanese deer": "أيل سيكا, أيل ياباني (أيل صغير في اليابان ذو قرون متشعبة قليلاً)",
 "japanese deity": "إله ياباني (إله عبده اليابانيون)",
 "japanese flowering cherry": "كرز شرقي, كرز ياباني (شجرة زينة بفاكهة غير صالحة للأكل تزرع على نطاق واسع في العديد من الأصناف لأزهارها البيضاء) / كرز ياباني مزهر (شجرة زينة بفاكهة غير صالحة للأكل تزرع على نطاق واسع في العديد من الأصناف لأزهارها الوردية)",
 "japanese honeysuckle": "صريمة الجدي اليابانية, عسلة يابانية (عسلة آسيوية دائمة الخضرة زاحفة بأوراق نصف دائمة الخضرة وزهور بيضاء عطرة تتحول إلى صفراء مع تقدم العمر؛ أصبحت عشباً ضاراً في بعض المناطق)",
 "japanese hop": "جنجل ياباني (كرمة زينة موطنها شرق آسيا؛ تزرع لأوراقها المبرقشة)",
 "japanese iris": "سوسن دموي",
 "japanese ivy": "لبلاب بوسطن, لبلاب ياباني (كرمة آسيوية بأوراق ثلاثية الفصوص وثمار أرجوانية)",
 "japanese lacquer tree": "شجرة اللك, شجرة الورنيش (شجرة آسيوية صغيرة تفرز مادة سامة يتم الحصول منها على اللك (الورنيش))",
 "japanese language": "اللغة اليابانية (اللغة (التي تعتبر عادة ألطية) التي يتحدث بها اليابانيون)",
 "japanese lawn grass": "عشبة المروج الكورية, عشبة المروج اليابانية (عشبة مروج شائعة في الصين واليابان؛ تزرع أيضاً في الولايات المتحدة)",
 "japanese leaf": "أجلونيما, خضرة صينية (عشب قائم أو متسلق جزئياً ذو أوراق خضراء كبيرة أو مبرقشة)",
 "japanese leek": "بصل ويلزي, كراث ياباني (بصل آسيوي ذو بصيلات نحيلة؛ يستخدم كبصل أخضر مبكر)",
 "japanese lilac": "ليلك ياباني (ليلك من شمال الصين له أوراق بيضاوية وزهور وردية ليلكية غزيرة في أوائل الصيف)",
 "japanese lime": "زيزفون ياباني (شجرة متوسطة الحجم من اليابان تستخدم للزينة)",
 "japanese linden": "زيزفون ياباني (شجرة متوسطة الحجم من اليابان تستخدم للزينة)",
 "japanese maple": "قيقب البدر, قيقب ياباني (أوراق محززة بعمق وحمراء زاهية في الخريف؛ اليابان) / قيقب ياباني كفي (شجيرة زينة أو شجرة صغيرة من اليابان وكوريا بأوراق محززة بعمق؛ تزرع في العديد من الأصناف)",
 "japanese medlar": "أسكدنيا, أكي دنيا (شجرة دائمة الخضرة في المناطق الدافئة لها فاكهة صفراء زغبية بحجم الزيتون مع نواة كبيرة حرة؛ موطنها الصين واليابان)",
 "japanese millet": "دخن ياباني (عشب حولي خشن يزرع في اليابان وجنوب شرق آسيا لبذوره الصالحة للأكل وللعلف؛ غذاء مهم للحياة البرية في الولايات المتحدة)",
 "japanese monetary unit": "وحدة نقدية يابانية (الوحدة النقدية في اليابان)",
 "japanese morning glory": "أثمان نيلي, مجد الصباح الياباني (عشب متسلق استوائي حولي من العالم القديم يتميز بمجموعة واسعة من الألوان وزهور مكشكشة أو مزدوجة)",
 "japanese oak": "بلوط ياباني (شجرة صغيرة دائمة الخضرة من الصين والياباني) / بلوط منغولي, بلوط ياباني (بلوط بخشب ناعم الحبيبات خفيف معتدلاً؛ اليابان)",
 "japanese oyster": "محار ياباني (محار كبير موطنه اليابان وأدخل على طول ساحل المحيط الهادئ للولايات المتحدة؛ مرشح للإدخال في خليج تشيسابيك)",
 "japanese pagoda tree": "شجرة الباغودا اليابانية, صفيراء يابانية (شجرة نفضية جميلة مستديرة الرأس لها أوراق مركبة خضراء داكنة وعناقيد غزيرة من الزهور البيضاء الكريمية العطرة؛ موطنها الصين واليابان)",
 "japanese persimmon": "خرمة يابانية, كاكي (شجرة آسيوية صغيرة نفضية تحمل فاكهة كبيرة حمراء أو برتقالية صالحة للأكل قابضة)",
 "japanese pink": "قرنفل ياباني (صنف مزهر من القرنفل الصيني يتميز ببتلات ذات حواف مسننة)",
 "japanese plum": "اسكدنيا, مشمش هندي (فاكهة شبه استوائية صفراء بحجم الزيتون ذات نواة حرة كبيرة ولحم قليل نسبياً) / أسكدنيا, أكي دنيا (شجرة دائمة الخضرة في المناطق الدافئة لها فاكهة صفراء زغبية بحجم الزيتون مع نواة كبيرة حرة؛ موطنها الصين واليابان) / برقوق ياباني (شجرة صغيرة من الصين واليابان تحمل برقوقاً كبيراً أصفر إلى أحمر عادة ما يكون أقل جودة نوعاً ما من البرقوق الأوروبي في النكهة)",
 "japanese poinsettia": "بنت القنصل اليابانية, فربيون متباين الأوراق (بنت القنصل المبهرجة توجد من جنوب الولايات المتحدة إلى بيرو)",
 "japanese privet": "تمرحنة يابانية (شجيرة دائمة الخضرة من اليابان وكوريا لها أوراق داكنة صغيرة وزهور في عناقيد فضفاضة؛ مرتبطة بالتمرحنة الصينية ولكنها أصغر)",
 "japanese quince": "سفرجل ياباني (شجيرة شائكة متساقطة الأوراق موطنها الصين لها أزهار حمراء أو بيضاء)",
 "japanese radish": "دايكون, فجل ياباني (فجل من اليابان له جذر طويل صلب دائم يؤكل نيئاً أو مطبوخاً)",
 "japanese red pine": "صنوبر أحمر ياباني (صنوبر موطنه اليابان وكوريا له تاج غير منتظم واسع الانتشار عند النضج؛ يزرع للزينة)",
 "japanese rose": "ورد متعدد الأزهار, ورد ياباني (ورد قوي النمو له عناقيد من الزهور الصغيرة العديدة؛ يستخدم للأسيجة وكأصل للتطعيم)",
 "japanese snowbell": "إصطرك ياباني, جرس الثلج الياباني (شجرة شجيرية في الصين والياباني)",
 "japanese spaniel": "سبانييل ياباني (سلالة من كلاب الزينة نشأت في اليابان لها معطف حريري أسود وأبيض أو أحمر وأبيض)",
 "japanese spurge": "فربيون ياباني (شجيرة يابانية دائمة الخضرة بطيئة النمو لها سنابل طرفية من الزهور البيضاء؛ تزرع كغطاء أرضي)",
 "japanese stranglehold": "خنق ياباني (مسكة مصارعة تتقاطع فيها ذراعي الخصم أمام رقبته للضغط على القصبة الهوائية)",
 "japanese sumac": "شجرة اللك, شجرة الورنيش (شجرة آسيوية صغيرة تفرز مادة سامة يتم الحصول منها على اللك (الورنيش))",
 "japanese table pine": "صنوبر أحمر ياباني (صنوبر موطنه اليابان وكوريا له تاج غير منتظم واسع الانتشار عند النضج؛ يزرع للزينة)",
 "japanese tree lilac": "ليلك ياباني شجري (شجرة صغيرة من اليابان لها أوراق مدببة ضيقة وزهور بيضاء كريمية)",
 "japanese umbrella pine": "صنوبر المظلة الياباني (شجرة طويلة دائمة الخضرة ذات تاج منتشر متماثل وإبر تنمو في دوامات تشبه المظلات عند أطراف الأغصان)",
 "japanese varnish tree": "شجرة المظلة الصينية, ورنيش ياباني (شجرة نفضية تزرع على نطاق واسع في جنوب الولايات المتحدة كزينة لأوراقها الجميلة التي تشبه القيقب وعناقيدها الطويلة من الزهور الصفراء الخضراء تليها قرون…) / شجرة اللك, شجرة الورنيش (شجرة آسيوية صغيرة تفرز مادة سامة يتم الحصول منها على اللك (الورنيش))",
 "japanese wistaria": "ستارية يابانية, ويستيريا يابانية (نبات له زهور وردية إلى بنفسجية أو زرقاء بنفسجية)",
 "japanese yew": "طقسوس ياباني (شجيرة دائمة الخضرة قوية من الصين واليابان لها أوراق خضراء داكنة لامعة؛ تزرع في شرق الولايات المتحدة)",
 "japanese-speaking": "نَاطِقٌ بِاليَابَانِيَّة (قادر على التواصل باللغة اليابانية)",
 "japaneseness": "الطابع الياباني (صفة كون المرء يابانياً)",
 "japanophilia": "يَابَانُوفِيلِيَا",
 "jape": "طُرْفَة, مَزْحَة (حكاية فكاهية أو ملاحظة تهدف إلى إثارة الضحك)\nمثال: روى نكتة مضحكة جداً",
 "japery": "تهريج (التصرف مثل المهرج أو البهلوان)",
 "japheth": "يَافَث",
 "japonica": "سفرجل مول, سفرجل ياباني (شجيرة شائكة متساقطة الأوراق موطنها اليابان لها أزهار حمراء) / جابونيكا, كاميليا يابانية (شجيرة دفيئة ذات أوراق خضراء لامعة وزهور مبهرجة عطرة تشبه الورد؛ تزرع في العديد من الأصناف)",
 "japorn": "إباحية يابانية (المواد الإباحية المنتجة في اليابان)",
 "jar": "مرطبان / جَرَّة (اسم للمَرَّة الواحدة من الجَرّ؛ إناء من خَزَف أو صُلْصَال له بطن كبير وعروتان وفمّ واسع)\nمثال: من ترك الجرة مفتوحة؟",
 "jarful": "برطمان, ملء جرة (الكمية المحتواة في جرة أو برطمان)\nمثال: شرب جرة من البيرة",
 "jargon": "رطانة, لغة اصطلاحية (مصطلحات تقنية متخصصة مميزة لموضوع معين) / رطانة, عامية خاصة (لغة مميزة لمجموعة معينة (كما بين اللصوص)) / جارغون (نوع عديم اللون (أو أصفر شاحب أو دخاني) من الزركون)\nمثال: هم لا يتحدثون لغتنا",
 "jargoon": "جارغون (نوع عديم اللون (أو أصفر شاحب أو دخاني) من الزركون)",
 "jarring": "مُزْعِج لِلسَّمْع, مُنَفِّر (يُحْدِث أَوْ يُسَبِّب صَوْتًا قَاسِيًا ومُزْعِجًا)",
 "jarringly": "بشكل متنافر, بشكل مزعج (بطريقة تزعج وتثير الأعصاب)\nمثال: كان البيانو نشازاً بشكل مزعج",
 "jarvik artificial heart": "قلب جارفيك (نوع من القلوب الاصطناعية التي استخدمت ببعض النجاح)",
 "jarvik heart": "قلب جارفيك (نوع من القلوب الاصطناعية التي استخدمت ببعض النجاح)",
 "jasmine": "يَاسَمِين (جنس نباتي يضم نحو مائتي نوع من الشجيرات المزهرة التي تتبع الفصيلة الزيتونية؛ اسم شخصي معطًى للإناث من العرب)\nمثال: أنا أفضل رائحة الياسمين.",
 "jasmine tobacco": "تبغ الياسمين, تبغ مزهر (نبات معمر للزينة من أمريكا الجنوبية له زهور بيضاء مخضرة عطرة ليلاً)",
 "jasminum mesnyi": "ياسمين الزهرة الربيعية (شجيرة متسلقة دائمة الخضرة صفراء الأزهار من غرب الصين)",
 "jasminum nudiflorum": "ياسمين شتوي (شجيرة متسلقة متساقطة الأوراق تُزرع على نطاق واسع لزهورها الصفراء التي تتفتح في الشتاء)",
 "jasminum officinale": "ياسمين حقيقي, ياسمين شائع (شجيرة متساقطة الأوراق متسلقة بزهور عطرة بيضاء أو صفراء أو حمراء تستخدم في العطور ولتنكيه الشاي)",
 "jasminum sambac": "فل, ياسمين عربي (كرمة دائمة الخضرة من شرق الهند تُزرع لزهورها البيضاء العطرة الغزيرة)",
 "jasper": "يَشْب / يَشْم",
 "jassid": "جاسيد (نوع من نطاط الأوراق)",
 "jat": "جَات (عضو في شعب هندي أوروبي منتشر على نطاق واسع في شمال غرب شبه القارة الهندية)",
 "jati": "جاتي ((في الهندوسية) طائفة هندوسية أو مجموعة اجتماعية مميزة يوجد الآلاف منها في جميع أنحاء الهند؛ وغالباً ما تتميز بالمهنة الحصرية لأعضائها الذكور (مثل…)",
 "jatropha curcus": "جاتروفا, جوزة مقيئة (شجرة أمريكية استوائية صغيرة تنتج صبغة أرجوانية ومستخلص دباغة وتحمل جوزاً يحتوي على زيت مسهل سام بكميات كبيرة)",
 "jatropha stimulosus": "عشبة لاسعة, قراص الدربيون (عشب لاسع في أمريكا الاستوائية)",
 "jatropha urens": "عشبة لاسعة, قراص الدربيون (عشب لاسع في أمريكا الاستوائية)",
 "jaundice": "صُفَار, يَرَقَان",
 "jaundice of the newborn": "يرقان وليدي (مظهر مصفر عند الرضع حديثي الولادة؛ عادة ما يهدأ تلقائياً)",
 "jaundiced": "حَاسِد, حَاقِد (يُظْهِر تَحَيُّزًا أَوْ حَسَدًا أَوِ اسْتِيَاءً) / مُصاب بِاليَرَقان, يَرَقانِيّ (مُصاب بِاليَرَقان الَّذي يُسَبِّب اصْفِرار الجِلْد)",
 "jaunpur": "جَوْنَفُور",
 "jaunt": "رحلة ترفيهية, نزهة (رحلة تُتخذ للمتعة)\nمثال: العديد من النزهات الصيفية إلى الشاطئ",
 "jauntily": "بزهو, بمرح (بطريقة مرحة وأنيقة)\nمثال: استقرت قبعته بزهو على شعره البني الكثيف",
 "jauntiness": "انطلاق, مرح (حيوية مرحة) / أَنَاقَة, هِنْدَام (الأناقة كما تظهر في المظهر الذكي والمرتب)\nمثال: انطلاق مبهج في الأسلوب",
 "jaunting car": "عربة نزهة آيرلندية (عربة مفتوحة بعجلتين وحصان واحد كانت تستخدم على نطاق واسع في أيرلندا)",
 "jaunty": "أَنِيق, رَشِيق (ذو طابع مرح وحيويّ وواثق من نفسه) / أَنِيق, مُتَأَلِّق (يَتَمَيَّز بِمُوَاكَبَة العَصْر فِي المَلْبَس وَالسُّلُوك)",
 "jaunty car": "عربة نزهة آيرلندية (عربة مفتوحة بعجلتين وحصان واحد كانت تستخدم على نطاق واسع في أيرلندا)",
 "java": "جَاوَة / جَافَا",
 "java finch": "عصفور الأرز, عصفور جاوة (طائر نساج إندونيسي صغير يشبه العصفور يتردد على حقول الأرز)",
 "java man": "إنسان جاوة (كَائِن بَشَرِيّ؛ سَوَاد العَيْن)\nمثال: أنا إنسان صادق.",
 "java olives": "زيتون جاوة, كالومبانغ (شجرة كبيرة في المناطق الاستوائية بالعالم القديم ذات زهور برتقالية حمراء كريهة الرائحة تليها قرون حمراء تحيط ببذور غنية بالزيت تستخدم أحياناً كغذاء)",
 "java pepper": "فلفل جاوة, كبابة (كرمة شجيرية استوائية من جنوب شرق آسيا تحمل ثماراً تشبه التوت حارة)",
 "java sea": "بَحْر جَاوَة (شَقّ الأرض؛ التَحَيُّر والبَهْت من الفزع أو من شدة العَطَش فنظر لا يقصد شيئا)\nمثال: هبطت على البحر.",
 "java sparrow": "عصفور جاوة",
 "javan": "جاوي (من أو متعلق أو مميز لجزيرة جاوة أو سكانها أو لغتهم) / جاوي (مواطن أو ساكن في جاوة)\nمثال: معابد جاوية",
 "javanese": "جاوي (من أو متعلق أو مميز لجزيرة جاوة أو سكانها أو لغتهم) / اللغة الجاوية (اللغة الإندونيسية التي يتم التحدث بها في جاوة) / جاوي (مواطن أو ساكن في جاوة)\nمثال: معابد جاوية",
 "javanese language": "اللغة الجاوية (اللغة الإندونيسية التي يتم التحدث بها في جاوة)",
 "javanthropus": "إنسان جاوة, جافانثروبوس (جنس سابق للإنسان البدائي؛ يُعرف الآن باسم هومو سولوينسيس: يضم إنسان سولو)",
 "javel": "جافيل",
 "javel water": "ماء جافيل (محلول مائي من هيبوكلوريت الصوديوم)",
 "javelin": "مِزْرَاق",
 "javelin throw": "رمي الرمح",
 "javelina": "بيكاري مطوق (بيكاري رمادي داكن ذو طوق أبيض غير واضح؛ من المناطق شبه الصحراوية في المكسيك وجنوب غرب الولايات المتحدة)",
 "javelle water": "ماء جافيل (محلول مائي من هيبوكلوريت الصوديوم)",
 "jaw": "فَكّ",
 "jawan": "جندي هندي ((الهند) جندي خاص أو شرطي ذكر)",
 "jawbone": "فك سفلي (الفك في الفقاريات الذي يتمفصل ليفتح الفم)",
 "jawbreaker": "كلمة عسرة النطق (كلمة يصعب نطقها) / جوبيكر, حلوى قاسية جداً (حلوى صلبة مستديرة كبيرة)",
 "jawed": "ذوات الفك, فكيات (للحيوانات التي لها فكوك من نوع محدد)",
 "jawfish": "سمكة الفك (أسماك بحرية استوائية صغيرة كبيرة الفم شائعة على طول القيعان الرملية؛ يحتضن الذكور كرات البيض في أفواههم؛ أسماك أحواض شعبية)",
 "jawless": "لافكيات (للحيوانات التي ليس لها فك)",
 "jawless fish": "لا فكيات (فقاري يشبه الثعبان بدون فكوك أو زوائد مزدوجة بما في ذلك دائريات الفم وبعض الأشكال المنقرضة)",
 "jawless vertebrate": "لا فكيات (فقاري يشبه الثعبان بدون فكوك أو زوائد مزدوجة بما في ذلك دائريات الفم وبعض الأشكال المنقرضة)",
 "jaws of life": "أداة إنقاذ هيدروليكية, فكوك الحياة (أداة هيدروليكية تُدخل في المركبات المحطمة وتستخدم لفتح الحطام لتوفير الوصول إلى الأشخاص المحاصرين بالداخل)",
 "jay": "زُرَيْق / جَاي",
 "jaybird": "قيق أزرق (قيق شائع في شرق أمريكا الشمالية؛ لونه أزرق ساطع مع صدر رمادي)",
 "jaywalker": "عابر طريق متهور (مشاة متهور يعبر الشارع بشكل غير قانوني)",
 "jazz": "جَاز (عَبَرَ أو قَطَعَ مَوْضِعًا؛ تَعَدَّاه و خَلَّفَه وَرَاءَهُ)\nمثال: هم بحبون الجاز.",
 "jazz age": "عصر الجاز (عقد العشرينيات في الولايات المتحدة كما وُصف في روايات ف. سكوت فيتزجيرالد كفترة من الثراء والوفرة الشبابية والمتعة الخالية من الهموم)",
 "jazz band": "فرقة جاز, كومبو (فرقة صغيرة من موسيقيي الجاز)",
 "jazz festival": "مهرجان الجاز (مهرجان يضم عروضاً لفناني الجاز)",
 "jazz fusion": "جاز روك, فيوجن جاز (نوع من الموسيقى تطور في السبعينيات، يجمع بين أنماط الجاز وموسيقى الروك ويستخدم الآلات الإلكترونية مثل الغيتارات وأجهزة التوليف)",
 "jazz group": "فرقة جاز, كومبو (فرقة صغيرة من موسيقيي الجاز)",
 "jazz musician": "موسيقي جاز (موسيقي يعزف أو يؤلف موسيقى الجاز)",
 "jazz-rock": "جاز روك, فيوجن جاز (نوع من الموسيقى تطور في السبعينيات، يجمع بين أنماط الجاز وموسيقى الروك ويستخدم الآلات الإلكترونية مثل الغيتارات وأجهزة التوليف)",
 "jazzman": "عازف جاز (موسيقي ذكر يعزف أو يؤلف موسيقى الجاز)",
 "jazzwoman": "عازفة جاز (موسيقية أنثى تعزف أو تؤلف موسيقى الجاز)",
 "jazzy": "صَارِخ, مُبَهْرَج (ذو ألوان صارخة وبرّاقة تجذب الانتباه بشكل مفرط) / جَازِيّ (يشبه موسيقى الجاز (خاصة في إيقاعها))",
 "jdam": "ذخيرة الهجوم المباشر المشترك (جهاز توجيه دقيق للقنابل يمكن ربطه بقنبلة الجاذبية لتحويل القنابل \"الغبية\" إلى قنابل ذكية)",
 "je ne sais quoi": "شيء لا يوصف (شيء يتعذر وصفه أو تحديده بدقة)",
 "jealous": "غَيُور",
 "jealously": "بِحَسَد, بِغَيْرَة (مع الغيرة؛ بطريقة حاسدة) / بحرص شديد, بغيرة (مع الغيرة (الحرص الشديد على الشيء))\nمثال: نظر إلى سيارة صديقه الجديدة بحسد",
 "jealousy": "حَسَد, غَبْط (تمنيّ زوال نعمة الغير)\nمثال: الكره لا يظهر بكل بساطة من فراغ. إنه بالعادة يبدأ من الحسد أو الخوف.",
 "jean": "جينز, دنيم (قماش قطني خشن متين ذو نسج مبرد)",
 "jeans": "جِينْز",
 "jeddah": "جِدَّة (هي أم الأب أو أم الأم؛ مدينة في السُعُودِيَّة قرب مَكَّة، قيل أنها سميت هكذا لأن حواء دفنت فيها والله أعلم)\nمثال: كان لزيري جد و جدة.",
 "jedi": "جَدَيْ",
 "jeep": "جِيب (جيَّب القميص:جَابَ، جعل له جيبًا)\nمثال: جيب سامي مثقوب.",
 "jeer": "اسْتِهْزَاء, تَهَكُّم (إظهار الازدراء عن طريق السخرية)",
 "jeerer": "ساخر, شامت (شخص يسخر أو يتهكم أو يعامل شيئاً باحتقار)",
 "jeering": "سَاخِر, مُسْتَهْزِئ (يُسيء لفظياً؛ يُعبِّر عن الازدراء أو السخرية) / اسْتِهْزَاء, تَهَكُّم (إظهار الازدراء عن طريق السخرية)",
 "jeeringly": "باستهزاء, بسخرية (بطريقة ساخرة وغير محترمة)",
 "jefferson": "جَفَرْسُون",
 "jefferson davis' birthday": "3 يونيو, عيد ميلاد جيفرسون ديفيس (عطلة بمناسبة تاريخ ميلاد جيفرسون ديفيس، يُحتفل بها في 3 يونيو في جنوب الولايات المتحدة)",
 "jeffersonian": "جيفرسوني (متعلق بـ أو مميز لتوماس جيفرسون أو مبادئه أو نظرياته) / جِيفَرْسُونِيّ (تابع لتوماس جيفرسون أو أفكاره ومبادئه)\nمثال: ديمقراطية جيفرسونية",
 "jeffrey pine": "صنوبر أسود, صنوبر جيفري (صنوبر متناظر طويل من غرب أمريكا الشمالية له إبر زرقاء خضراء طويلة في حزم من 3 ومخاريط ممدودة على فروع منتشرة متدلية نوعاً ما؛ يصنف أحياناً كصنف من…)",
 "jeffrey's pine": "صنوبر أسود, صنوبر جيفري (صنوبر متناظر طويل من غرب أمريكا الشمالية له إبر زرقاء خضراء طويلة في حزم من 3 ومخاريط ممدودة على فروع منتشرة متدلية نوعاً ما؛ يصنف أحياناً كصنف من…)",
 "jehad": "جهاد (نضال مقدس أو سعي من قبل المسلم لهدف أخلاقي أو روحي أو سياسي)",
 "jehovah": "يَهْوَه, يهوه",
 "jehovah's witness": "شاهد يهوه (اسم فاعلٍ للفعل شَهِدَ؛ هو مَنْ رَأَى وَعَايَنَ وَحَضَرَ ٱلْأَمْرَ)\nمثال: شاهد هذا الفيلم.",
 "jehovah's witnesses": "شُهُودُ يَهْوَه",
 "jeju-do": "جيجو دو",
 "jejunal artery": "شريان صائمي (شريان هو فرع من الشريان المساريقي العلوي يغذي الصائم)",
 "jejune": "تَافِه, سَخِيف (يفتقر إلى الأهمية أو التأثير) / سَاذَج, صِبْيَانِيّ (يُظهر أو يوحي بافتقار إلى النضج) / شَحِيح, غَيْر كَافٍ (أقل من الكمية اللازمة لتلبية الحاجة)",
 "jejunely": "بصبيانية, بعدم نضج (بطريقة غير ناضجة)\nمثال: لا يزال ابنه المراهق يتصرف بصبيانية شديدة",
 "jejuneness": "افْتِقَار غِذَائِيّ, جَدْب (صفة القيمة الغذائية غير الكافية) / تَفَاهَة, رَكَاكَة (صفة كون الشيء تافهاً وغير متطور) / سذاجة, قلة خبرة (الافتقار إلى خبرة الحياة وإظهار ذلك)",
 "jejunitis": "التهاب الصائم (التهاب الصائم في الأمعاء الدقيقة)",
 "jejunity": "افْتِقَار غِذَائِيّ, جَدْب (صفة القيمة الغذائية غير الكافية) / تَفَاهَة, رَكَاكَة (صفة كون الشيء تافهاً وغير متطور)",
 "jejunoileitis": "التهاب الصائم واللفائفي (التهاب الصائم واللفائفي في الأمعاء الدقيقة)",
