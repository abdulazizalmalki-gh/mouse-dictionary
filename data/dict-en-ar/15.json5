 "lacquerware": "أشغال اللك (عمل زخرفي مصنوع من الخشب ومغطى باللك وغالباً ما يكون مرصعاً بالعاج أو المعادن الثمينة)",
 "lacrimal": "دمعي (متعلق بالعضو الذي ينتج الدموع أو يقع قربه) / دمعي (متعلق بالدموع)",
 "lacrimal apparatus": "جِهَاز دَمْعِيّ (الهياكل التي تفرز وتصرف الدموع من العين)",
 "lacrimal artery": "شريان دمعي (شريان ينشأ من الشريان العيني ويغذي الغدة الدمعية وعضلات العين المستقيمة والجفن العلوي والجبهة)",
 "lacrimal bone": "عظم دمعي (عظم هش صغير يشكل جزءاً من الجدران الداخلية الأمامية لكل محجر عين ويوفر مساحة لمرور القنوات الدمعية)",
 "lacrimal duct": "قناة دمعية (أي من عدة قنوات صغيرة تحمل الدموع من الغدد الدمعية)",
 "lacrimal gland": "غدة دمعية (أي من الغدد الموجودة في العين التي تفرز الدموع)",
 "lacrimal sac": "كيس دمعي (إحدى النهايتين المتسعتين للقنوات الدمعية عند النهايات الأنفية للعينين والتي تمتلئ بالدموع التي تفرزها الغدد الدمعية)",
 "lacrimal secretion": "إفراز دمعي, دمع (سائل ملحي تفرزه الغدد الدمعية؛ يزيت سطح مقلة العين)",
 "lacrimal vein": "وريد دمعي (يصرف الغدة الدمعية؛ يصب في الوريد العيني العلوي)",
 "lacrimation": "إدماع, تدميع (ذرف الدموع)",
