{
 "allis shad": "شابل أوروبي (شابل أوروبي)",
 "alliteration": "جناس استهلالي, قافية أولية (استخدام نفس الحرف الساكن في بداية كل مقطع مشدد في بيت الشعر)",
 "alliterative": "جِنَاسِيّ (يتشابه فيه الحرف الساكن في بداية كل مقطع مُشَدَّد)",
 "alliteratively": "بِسَجْع (بطريقة مسجوعة)\nمثال: كتب الشعراء الإسكندنافية الأوائل بسجع",
 "alliterator": "مستخدم الجناس, ناظم الجناس (متحدث أو كاتب يستخدم الجناس في تعبيره)",
 "allium acuminatum": "بصل هوكر (بصل بري شائع في أمريكا الشمالية ذو رائحة بصل قوية وخيمة من الزهور الوردية فوق ساق عديمة الأوراق؛ من كولومبيا البريطانية إلى كاليفورنيا وأريزونا…)",
 "allium ampeloprasum": "ثوم المشرق, كراث بري (نبات معمر خشن من العالم القديم له بصلة كبيرة وساق طويل من زهور مخضرة مشوبة بالأرجواني؛ متوطن على نطاق واسع)",
 "allium ascalonicum": "شالوت, كراث أندلسي (نوع من نبات البصل ينتج بصيلات صغيرة عنقودية خفيفة النكهة تستخدم كتوابل)",
 "allium canadense": "ثوم كندي (نبات بصلي من أمريكا الشمالية)",
 "allium carinatum": "ثوم زورقي (نبات بصلي أوراسي)",
 "allium cepa": "بصل (نبات بصلي له أوراق مجوفة يزرع في جميع أنحاء العالم لبصلته المستديرة الصالحة للأكل)",
 "allium cepa aggregatum": "شالوت, كراث أندلسي (نوع من نبات البصل ينتج بصيلات صغيرة عنقودية خفيفة النكهة تستخدم كتوابل)",
 "allium cepa viviparum": "بصل الشجرة, بصل مصري (نوع من البصل المعمر يزرع بشكل رئيسي للغرابة أو كبصل أخضر مبكر؛ له بصيلات صغيرة تحل محل الزهور)",
 "allium cernuum": "بصل مائل, كراث السيدة (بصل بري واسع الانتشار في أمريكا الشمالية ذو زهور بيضاء إلى وردية)",
 "allium fistulosum": "بصل ويلزي, كراث ياباني (بصل آسيوي ذو بصيلات نحيلة؛ يستخدم كبصل أخضر مبكر)",
 "allium haematochiton": "بصل أحمر القشرة (بصل ذو غلاف أبيض إلى أحمر عميق؛ كاليفورنيا)",
 "allium neopolitanum": "ثوم مزهر, ثوم نابولي (بصل أوروبي بزهور بيضاء)",
 "allium paradoxum": "كراث قليل الأزهار (كراث ينتج بصيلات صغيرة بدلاً من الزهور؛ روسيا وإيران)",
 "allium porrum": "بصل أخضر, كراث (نبات له بصلة بيضاء رفيعة كبيرة وأوراق خضراء داكنة مسطحة متداخلة؛ يستخدم في الطهي؛ يعتقد أنه مشتق من الكراث البري)",
 "allium sativum": "ثوم (عشب بصلي من جنوب أوروبا متوطن على نطاق واسع؛ تنفصل البصلة إلى فصوص منفصلة قوية النكهة)",
 "allium schoenoprasum": "ثوم معمر (نبات معمر له أوراق أسطوانية مجوفة تستخدم للتتبيل)",
 "allium scorodoprasum": "ثوم عملاق, كراث رملي (كراث أوروبي يزرع ويستخدم مثل الكراث)",
 "allium sphaerocephalum": "كراث كروي الرأس (كراث من العالم القديم ببصلة كروية)",
 "allium tricoccum": "رامب, كراث بري (نبات معمر من أمريكا الشمالية له بصلة رفيعة وزهور بيضاء)",
 "allium triquetrum": "كراث ثلاثي الزوايا (كراث أوروبي متوطن في بريطانيا العظمى؛ الأوراق مثلثة الشكل)",
 "allium tuberosum": "ثوم معمر صيني, كراث صيني (نبات من شرق آسيا؛ أكبر من الثوم المعمر)",
 "allium ursinum": "ثوم الدببة, ثوم بري (نبات عشبي نفاذ من العالم القديم)",
 "allium vineale": "ثوم الكرمة, ثوم بري (بصل بري لاذع من العالم القديم)",
 "allmouth": "سمكة الصنارة, سمكة الصياد (أسماك لها أفواه كبيرة مع خيط يشبه الدودة متصل بها لجذب الفريسة)",
 "alloantibody": "جسم مضاد خيفي (جسم مضاد يحدث طبيعياً ضد الأنسجة الغريبة من شخص من نفس النوع)",
 "allocable": "قَابِل لِلتَّخْصِيص, قَابِل لِلتَّوْزِيع (يمكن توزيعه أو تخصيصه)",
 "allocatable": "قَابِل لِلتَّخْصِيص, قَابِل لِلتَّوْزِيع (يمكن توزيعه أو تخصيصه)",
 "allocate": "خَصَّصَ (خَصَّصَ الشيءَ: جعله خاصًّا؛ خَصَّصَ فلانًا بالشيءِ: خَصَّهُ به)\nمثال: حاول توفير بعض المال من ما خصص للسفر.",
 "allocation": "تَخْصِيص",
 "allocation unit": "عنقود, وحدة تخصيص (مجموعة قطاعات على قرص مغناطيسي يمكن حجزها لاستخدام ملف معين)",
 "allocator": "مخصص, موزّع (شخص لديه سلطة التخصيص أو التوزيع)",
 "allochronic": "مُتَبَايِن الأَزْمِنَة ((للأصنوفات) يقع في أزمنة جيولوجية مختلفة)",
 "allochthonous": "دَخِيل, مَنْقُول (للصخور والرواسب، إلخ؛ توجد في مكان غير المكان الذي تشكلت فيه هي ومكوناتها)",
 "allocution": "توجيه, خطاب رسمي ((بلاغة) خطاب رسمي أو سلطوي ينصح أو يحث)",
 "allogamous": "إخصابي خلطي, تزاوجي خلطي (يتعلق بالإخصاب الخلطي في النباتات)",
 "allogamy": "إخصاب متبادل, تزاوج خلطي (الإخصاب الخلطي في النباتات)",
 "allogeneic": "مغاير المنشأ (يدل على أو يتعلق بخلايا أو أنسجة من أفراد ينتمون لنفس النوع ولكنهم غير متماثلين وراثيًا (وبالتالي غير متوافقين مناعيًا))",
 "allograft": "طعم مباين (نسيج أو عضو يُنقل من متبرع من نفس النوع ولكن بتركيب وراثي مختلف؛ يجب قمع الجهاز المناعي للمتلقي لمنع رفض الطعم)",
 "allograph": "توقيع بالنيابة (توقيع يكتبه شخص لشخص آخر) / شكل الحرف, متغير خطي ((شَكَلَ) الأمْرُ يَشْكُلُ شُكُولاً: الْتَبَسَ؛ (شَكَلَ) المريضُ: تماثَلَ)\nمثال: اجلس بشكل مريح.",
 "allographic": "ألوغرافي, مغير خطي (من أو متعلق بتغاير الشكل الكتابي (أو التوقيع نيابة عن شخص آخر))",
 "allomerism": "تغير كيميائي دون بلوري ((في الكيمياء) تباين في التركيب الكيميائي دون اختلاف في الشكل البلوري)",
 "allomerous": "متماثل التبلور كيميائياً (متعلق بتشابه الشكل البلوري مع اختلاف التركيب الكيميائي)",
 "allometric": "متعلق بالقياس التبايني, متعلق بالنمو التبايني (يتعلق بـ أو يتميز بالنمو التبايني (تغير نسب الجسم مع النمو))",
 "allometry": "قياس النمو النسبي (دراسة النمو النسبي لجزء من كائن حي وعلاقته بنمو الكائن ككل)",
 "allomorph": "ألومورف, بديل صرفي (تمثيل صوتي متغير لمورفيم ما) / شكل بلوري مغاير, متآصل (أي من عدة أشكال بلورية مختلفة لنفس المركب الكيميائي)\nمثال: كربونات الكالسيوم توجد في الأشكال المغايرة كالكالسيت والأراجونيت",
 "allomorphic": "ألومورفي, مغير شكلي (متعلق ببدائل الشكل (سواء في اللغة أو التبلور))",
 "allopathic": "ألوباثي, علاجي بالضد (من أو متعلق بممارسة الطب الألوباثي (الطب التقليدي))\nمثال: علاجات ألوباثية",
 "allopathy": "طب الوباتى, طب تقليدي (الطريقة المعتادة لعلاج المرض بعلاجات تنتج تأثيرات مختلفة عن تلك التي ينتجها المرض نفسه)",
 "allopatric": "مستوطن متباين ((للأنواع البيولوجية) توجد في مناطق معزولة جغرافياً عن بعضها البعض)",
 "allopatry": "توطن متباين (وجود الكائنات الحية ذات الصلة في مناطق جغرافية منفصلة دون تداخل)",
 "allophilia": "ألفة الآخرين",
 "allophone": "ألوفون, بديل صوتي ((لغويات) أي من الأشكال المختلفة صوتياً لنفس الفونيم)",
 "allophonic": "ألوفوني, تنوعي صوتي (متعلق بالبدائل الصوتية (الألوفونات))",
 "allopurinol": "الوبيورينول, زيلوبريم (دواء (الاسم التجاري زيلوبريم) يستخدم لعلاج النقرس وحالات أخرى يزداد فيها تراكم حمض اليوريك)",
 "allosaur": "ألوصور (ديناصور لاحم من أواخر العصر الجوراسي؛ يشبه التيرانوصور ولكنه أصغر قليلاً)",
 "allosaurus": "ألوصور (ديناصور لاحم من أواخر العصر الجوراسي؛ يشبه التيرانوصور ولكنه أصغر قليلاً)",
 "allosteric": "تَفَارُغِيّ",
 "allot": "خَصَّصَ (خَصَّصَ الشيءَ: جعله خاصًّا؛ خَصَّصَ فلانًا بالشيءِ: خَصَّهُ به)\nمثال: حاول توفير بعض المال من ما خصص للسفر.",
 "allotment": "تخصيص, تقسيم (فعل التوزيع عن طريق التخصيص أو التقسيم؛ التوزيع وفقاً لخطة) / تخصيص, مخصص (حصة مخصصة لغرض محدد)\nمثال: يعتمد توزيع المقاعد في مجلس النواب على الكثافة السكانية لكل ولاية",
 "allotrope": "تآصل, شكل تآصلي (شكل مختلف هيكلياً لعنصر ما)\nمثال: الجرافيت والماس هما متآصلان للكربون",
 "allotropic": "تآصلي (من أو متعلق بـ أو يظهر ظاهرة التآصل)\nمثال: الكربون والكبريت والفوسفور عناصر تآصلية",
 "allotropical": "تآصلي (من أو متعلق بـ أو يظهر ظاهرة التآصل)\nمثال: الكربون والكبريت والفوسفور عناصر تآصلية",
 "allotropism": "تآصل, ظاهرة التآصل (ظاهرة وجود عنصر في شكلين فيزيائيين أو أكثر)",
 "allotropy": "تآصل, ظاهرة التآصل (ظاهرة وجود عنصر في شكلين فيزيائيين أو أكثر)",
 "allotted": "مُخَصَّص (أُعطِي كمهمّة أو مسؤولية)",
 "allover": "شَامِلٌ لِلسَّطْح, مُغَطٍّ بِالكَامِل (يغطّي السطح بأكمله)",
 "allow": "سَمَحَ, أَذِنَ (يَسَّرَ وسَهَّلَ وهَيَّأَ لَهُ الأَمْرَ، جَعَلَه مُمْكِنًا. (يتعدى بالباء)؛ سَهُلَ) / سَمَحَ بِـ, سَمَحَ (يَسَّرَ وسَهَّلَ وهَيَّأَ لَهُ الأَمْرَ، جَعَلَه مُمْكِنًا. (يتعدى بالباء)؛ سَهُلَ)\nمثال: سمح لسكورة بالسباحة.",
 "allowable": "مَسْمُوحٌ بِخَصْمِهِ (قابل للخصم وفقاً لقوانين الضرائب) / جائز, مسموح (ما يمكن السماح به خاصة وفقاً للقواعد) / جَائِز, مُبَاح (يستحقّ أن يُسمَح به أو يُنظَر فيه)\nمثال: سلوك مسموح به في المدرسة",
 "allowably": "بشكل مسموح به (بطريقة مسموح بها)",
 "allowance": "سماح (فعل السماح) / تَفَاوُت مَسْمُوح, سَمَاحِيَّة (فرق مسموح به؛ السماح ببعض الحرية للحركة ضمن حدود) / بدل, تعديل (مبلغ يضاف أو يخصم بناءً على ظروف مؤهلة) / بدل, مخصص (مبلغ مسموح به أو ممنوح (كما خلال فترة معينة))\nمثال: اعترض على السماح بالتدخين في غرفة الطعام",
 "allowance account": "احتياطي التقييم, حساب المخصصات (صندوق احتياطي يتم إنشاؤه بخصم من الأرباح لتوفير التغيرات في قيمة أصول الشركة)",
 "allowed": "مَسْمُوح",
 "alloy": "أُشَابَة",
