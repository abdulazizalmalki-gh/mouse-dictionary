 "apple nut": "جوز العاج, عاج نباتي (بذرة تشبه الجوز لنخيل أمريكي جنوبي؛ القشرة البيضاء الصلبة تأخذ تلميعاً عالياً وتستخدم للأزرار مثلاً)",
 "apple of discord": "تُفاحة الشقاق ((الأساطير الكلاسيكية) تفاحة ذهبية ألقتها إيريس (إلهة الشقاق) في وليمة للآلهة؛ كُتب عليها 'للأجمل'، مما أدى إلى نزاع بين هيرا وأثينا وأفروديت، وأشعل…)",
 "apple of peru": "تفاح شوكي, داتورا صفراوية (عشبة استوائية سنوية طويلة خشنة وسامة للغاية ذات أوراق كريهة الرائحة وزهور بيضاء أو بنفسجية كبيرة على شكل بوق وثمار شائكة) / تفاح بيرو, نيكاندرا (عشب خشن في أمريكا الجنوبية يزرع لزهوره الزرقاء والبيضاء التي تليها ثمرة تشبه المثانة تحيط بثمرة لبية جافة)",
 "apple of sodom": "عُشَر (الثَلَاثُ العُشَر: الليلة العاشرة والحادية عشر والثانية عشر من كل شهر قمري…)\nمثال: لدي عشرة أقلام.",
 "apple of someone's eye": "قُرَّةُ عَيْن",
 "apple orchard": "بستان تفاح (بستان من أشجار التفاح)",
 "apple pie": "فطيرَة التفاح",
 "apple polisher": "خَنُوع, مُتَذَلِّل (شخص يذل نفسه كعلامة على الاحترام؛ يتصرف وكأنه بلا كرامة)",
 "apple rust": "صدأ الأرز والتفاح, صدأ التفاح (فطر صدأ يسبب بقع صدأ على التفاح والكمثرى وغيرها)",
 "apple sauce": "صلصة التفاح (مهروس التفاح المطبوخ عادة ما يكون محلى ومتبلاً)",
 "apple tart": "تارت التفاح (تارت محشوة بشرائح التفاح والسكر) / تارت التفاح (فطيرة صغيرة مفتوحة محشوة بشرائح التفاح والسكر)",
 "apple tree": "شَجَرَةُ اَلتُّفَّاحِ (نبات قائم على سَاق صلبة؛ مخطط له تفرعات)\nمثال: أنا تحت الشجرة.",
 "apple turnover": "فطيرة التفاح المطوية (فطيرة مطوية بحشوة التفاح)",
 "apple vodka": "فودكا التفاح (مشروب كحولي قوي بنكهة التفاح)",
 "apple-scented": "بِرَائِحَةِ التُّفَّاح (ذُو رَائِحَة التُّفَّاح)",
 "apple-shaped": "تُفَّاحِيُّ الشَّكْل (ذو شكل عامّ يشبه التفاحة)",
 "apple-sized": "بِحَجْمِ التُّفَّاحَةِ (بحجم تفاحة تقريبًا)",
 "applecart": "عربة بيع التفاح (عربة يدوية يباع منها التفاح والفاكهة الأخرى في الشارع) / ترتيبات, خطة (التخطيط الذي يتعطل عندما يفسد شخص ما الترتيبات)",
 "applejack": "أبل جاك (مشروب مقطر من سيدر التفاح القوي)",
 "applemint": "نعناع تفاحي (نعناع بسيقان برائحة التفاح من جنوب وغرب أوروبا؛ تم توطينه في الولايات المتحدة)",
 "applesauce": "تُرَّهَات, كَلَام تَافِه (حديث أو كتابة لا معنى لها) / صلصة التفاح (مهروس التفاح المطبوخ عادة ما يكون محلى ومتبلاً)",
 "applesauce cake": "كعكة صلصة التفاح (كعكة رطبة متبلة تحتوي على صلصة التفاح)",
 "applet": "بريمج, تطبيق مصغر (تطبيق جافا؛ برنامج تطبيقي يستخدم متصفح الويب الخاص بالعميل لتوفير واجهة مستخدم)",
 "applewood": "خشب التفاح (خشب أي من أشجار التفاح المختلفة)",
 "appliance": "جِهَاز",
 "applicability": "قَابِلِيَّة التَّطْبِيق, مُلَاءَمَة (الصلة بحكم كون الشيء قابلاً للتطبيق على الموضوع المطروح)",
 "applicable": "قابل للتطبيق (واجه، وقف مُقبلا نحو شخص والآخر مقبل نحوه؛ فلانٌ فلانًا: التقى به)\nمثال: قابل زيري ريمة.",
 "applicant": "مُقَدِّم طَلَب (الذي قُدِّمَ؛ في : رتبة عسكرية هي خامس الرتب في الترتيب التصاعدي الرَائِد أدنى منه والعَقِيْد أعلى منه) / مُتَقَدِّم\nمثال: تزحلقت العربة المسرعة و اصطدمت مقدمة العربة ب مؤخرة الشاحنة بشكل مفاجئ جدا .",
 "application": "تَطْبِيق / كِتَاب, اِسْتِمَارَة (موضع تعليم الكتابة. الاستخدام الأصلي؛ مدرسة شبه رسمية لتعليم الأطفال الكِتَابَة والقِرَاءَة ومباديء الحِسَاب وبعض القُرَآن…)\nمثال: هذا الكتاب جديد",
 "application form": "استمارة طلب, نموذج تقديم (نموذج يستخدم عند تقديم طلب)",
 "application program": "برنامج تطبيقي, تطبيق (برنامج يعطي تعليمات للحاسوب توفر للمستخدم أدوات لإنجاز مهمة ما)\nمثال: لقد جرب عدة تطبيقات مختلفة لمعالجة النصوص",
 "application programming interface": "وَاجِهَة بَرْمَجَة اَلتَّطْبِيقَات",
 "application-oriented language": "لغة موجهة للتطبيق, لغة موجهة للمشكلات (لغة تشبه عباراتها مصطلحات المستخدم)",
 "applications programme": "برنامج تطبيقي, تطبيق (برنامج يعطي تعليمات للحاسوب توفر للمستخدم أدوات لإنجاز مهمة ما)\nمثال: لقد جرب عدة تطبيقات مختلفة لمعالجة النصوص",
 "applicative": "تَطْبِيقِيّ, قَابِل لِلتَّطْبِيق (سهل التطبيق أو عملي الاستخدام)",
 "applicator": "أداة تطبيق, أداة وضع (جهاز أو أداة لوضع مادة ما)",
 "applicatory": "تَطْبِيقِيّ, قَابِل لِلتَّطْبِيق (سهل التطبيق أو عملي الاستخدام)",
 "applied": "تبيقي (يهتم بالمشاكل أو البيانات الملموسة بدلاً من المبادئ الأساسية)\nمثال: فيزياء تطبيقية",
 "applied anatomy": "تشريح سريري (التطبيق العملي للمعرفة التشريحية للتشخيص والعلاج)",
 "applied math": "رياضيات تطبيقية (فروع الرياضيات المعنية بدراسة العالم المادي أو البيولوجي أو الاجتماعي)",
 "applied mathematics": "رياضيات تطبيقية (فروع الرياضيات المعنية بدراسة العالم المادي أو البيولوجي أو الاجتماعي)",
 "applied psychology": "علم النفس التطبيقي, علم النفس الصناعي (أي من عدة فروع لعلم النفس التي تسعى لتطبيق المبادئ النفسية على المشاكل العملية في التعليم أو الصناعة أو التسويق وغيرها)",
 "applied science": "تكنولوجيا, علم الهندسة (التخصص الذي يتعامل مع فن أو علم تطبيق المعرفة العلمية على المشاكل العملية)\nمثال: واجه صعوبة في تحديد أي فرع من الهندسة سيدرس",
 "applied scientist": "تقني, مهندس (شخص يستخدم المعرفة العلمية لحل المشاكل العملية)",
 "applier": "أداة تطبيق, أداة وضع (جهاز أو أداة لوضع مادة ما) / طالب, متقدم (شخص يطلب أو يسعى للحصول على شيء مثل المساعدة أو الوظيفة أو القبول)",
 "applique": "أبليك, تطريز مضاف (تصميم زخرفي مصنوع من مادة واحدة مخيطة فوق أخرى)",
 "apply": "وَضَعَ (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه) / طَبَّقَ (جَعَلَ شيئًا يغطي شيئًا آخر بشكل كامل؛ نفَّذَ أمرًا أو خطةً عمليةً)\nمثال: لقد أزمت الوضع.",
 "appoggiatura": "نوتة زينة (نوتة تجميلية تُكتب عادة بحجم أصغر)",
 "appointed": "بالتعيين, تعييني (خاضع للتعيين (وليس الانتخاب)) / مُعَيَّن (اختير لشغل وظيفة أو مهمّة) / مُؤَثَّث بِذَوْق (مُزوَّد بالأثاث والتجهيزات (خاصة من النوع الأنيق)) / مَفْرُوض, مُقَرَّر (ثابت أو مقرّر خاصّة بأمر أو قرار رسميّ)",
 "appointee": "مُعَيَّن (شخص تم تعيينه في وظيفة أو منصب) / معيّن (مسؤول يتم تعيينه)",
 "appointive": "بالتعيين, تعييني (خاضع للتعيين (وليس الانتخاب)) / تعييني (يتعلق بفعل التعيين (في منصب))\nمثال: سلطات تعيينية",
 "appointment": "مَوْعِد, مِيعَاد (مَوْعِد الإفطار،أي وقت الإفطار؛ لديه مَوْعِد مع صديق)\nمثال: مناد عنده موعد.",
 "appointment book": "دفتر مواعيد (كتاب يحتوي على تقويم ومساحة لحفظ سجل المواعيد)",
 "appointment calendar": "دفتر مواعيد (كتاب يحتوي على تقويم ومساحة لحفظ سجل المواعيد)",
 "apportionable": "قَابِل لِلتَّخْصِيص, قَابِل لِلتَّوْزِيع (يمكن توزيعه أو تخصيصه)",
 "apportioned": "مُقَسَّم, مُوَزَّعٌ بِالتَّقْسِيطِ (مُوَزَّعٌ عَلَى حِصَصٍ أَوْ أَنْصِبَةٍ)",
 "apportioning": "تخصيص, تقسيم (فعل التوزيع عن طريق التخصيص أو التقسيم؛ التوزيع وفقاً لخطة)\nمثال: يعتمد توزيع المقاعد في مجلس النواب على الكثافة السكانية لكل ولاية",
 "apportionment": "تَوَزُّع",
 "apposable": "قابل للمقابلة (قادر على أن يوضع في مقابلة شيء آخر (مثل الإبهام))\nمثال: الإبهام قابل للمقابلة مع السبابة",
 "apposite": "مُنَاسِب تَمَامًا, وَثِيق الصِّلَة (بالغ الملاءمة والصلة بالموضوع بشكل لافت)",
 "appositeness": "جَدَارَة, مُنَاسَبَة (الملاءمة للمناسبة)\nمثال: العبارة كانت ذات مناسبة كبيرة",
 "apposition": "بدل (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: بدل سامي ملابسه.",
 "appositional": "بدلي (يتعلق بـ أو يكون في حالة بدل (في النحو))\nمثال: اسم بدلي",
 "appositive": "بدلي (يتعلق بـ أو يكون في حالة بدل (في النحو))\nمثال: اسم بدلي",
 "appositively": "بدلياً, على سبيل البدل (بطريقة تدل على البدل (في النحو))\nمثال: تُستخدم هذه الصفة بدلياً",
 "appraisal": "تثمين, تخمين (تقدير خبير للجودة والكمية والخصائص الأخرى لشخص أو شيء ما) / تقدير, تقييم (تصنيف شخص أو شيء ما فيما يتعلق بقيمته) / تثمين, تقدير (وثيقة تقدر قيمة شيء ما (مثل التأمين أو الضرائب))",
 "appraisal cost": "تكلفة التقييم (التكاليف التي يتم تكبدها في تقييم أن المنتجات/الخدمات تتوافق مع المتطلبات)",
 "appraiser": "مُثمِّن, مُقدِّر القيمة (شخص يقدر رسميًا قيمة أو جودة الأشياء) / خبير توثيق, مُوثِّق (من يحدد الأصالة (كما في الأعمال الفنية) أو يضمن الصلاحية)",
 "appreciable": "مَحْسُوس, مَلْمُوس (كَافٍ لِيُمْكِنَ تَقْدِيرُهُ أَوْ قِيَاسُه)",
 "appreciably": "بشكل ملحوظ, بشكل ملموس (بدرجة يمكن ملاحظتها)\nمثال: كان الطقس أبرد بشكل ملموس",
 "appreciate": "قَدَّرَ (قضاء الله وحكمه وما قَدَّرَه؛ مبلغ الشيء وكميتّه، بنفس معنى قَدْر) / عَلِمَ (أَدْرَكَ حقيقة الشيء) / رَفَعَ قِيمَة, زَادَ فِي قِيمَة (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ)\nمثال: خذ قدر ما تريد.",
 "appreciated": "مُدْرَك, مُسْتَوْعَب (مفهوم أو مُستوعَب بالكامل)",
 "appreciation": "تَقْدِير",
 "appreciative": "ذُو تَقْدِير, مُقَدِّر (يُبْدِي تَقْدِيرًا أَوْ حُكْمًا نَقْدِيًّا إِيجَابِيًّا) / عِرْفَانِيّ, مُقَدِّر (يشعر بالامتنان أو يعبر عنه)",
 "appreciatively": "بِامْتِنَان, بِتَقْدِير (مع التقدير؛ بطريقة ممتنة)\nمثال: قبل عرضي بتقدير",
 "appreciativeness": "شكر, عرفان بالجميل (مشاعر الامتنان الودية الدافئة)",
 "appreciator": "مُتَذَوِّق, مُقَدِّر (شخص يدرك شيئاً ما تماماً ويفهمه)\nمثال: هو ليس مقدراً للمعضلة التي نحن فيها",
 "apprehend": "فَهِمَ (فهم الأمر أو الكلام أو نحو ذلك، أدركه، علمه، أحسن تصوّره، استوعبه)\nمثال: لقد أسئت الفهم.",
 "apprehended": "مُدْرَك, مُسْتَوْعَب (مفهوم أو مُستوعَب بالكامل)",
 "apprehender": "قَابِض, مُعْتَقِل (شخص يقوم بالقبض أو الاعتقال (خاصة باسم العدالة)) / عَارِف, مُدْرِك (شخص يعرف أو يدرك)",
 "apprehensible": "مَفْهُوم, وَاضِح (يمكن إدراكه وفهمه واستيعابه)",
 "apprehension": "اعتقال, قبض (فعل القبض (خاصة القبض على مجرم)) / إدراك, استيعاب (الحالة المعرفية لشخص يفهم) / تخوف, توجس (توقع مؤلم أو شعور بالقلق من المستقبل) / توجس, خشية (توقع أو تحسب خائف)\nمثال: حصل الشرطي المناوب على التقدير للقبض على المجرم",
 "apprehensive": "مُتَوَتِّر",
 "apprehensively": "بتوجس, بقلق (مع قلق أو توجس)\nمثال: راقبنا بقلق",
 "apprehensiveness": "توجس, خشية (توقع أو تحسب خائف)\nمثال: نظر الطالب حول قاعة الامتحان بتوجس",
 "apprentice": "مُبْتَدِئ, مُبْتَدِئَة (من يبتدئ في تعلّم علم أو فنّ، شخص قليل الخبرة)\nمثال: إنك محترف وأنا مبتدئ.",
 "apprenticed": "مُتَعَاقِد, مُلْزَم بِعَقْد (مُقَيَّد بِمُوجَب عَقْد)",
 "apprenticeship": "تدريب مهني, تلمذة مهنية (منصب المتدرب المهني)",
 "appressed": "مُلْتَصِق, مُنْبَطِح (مضغوط على شيء أو مسطح عليه)",
 "apprisal": "إبلاغ, إخبار (الإعلام بالكلمات)",
 "apprise": "أَخْبَرَ, أَطْلَعَ (أَنْبَأَ، أَعْلَمَ)\nمثال: أخبر سامي أباه.",
 "appro": "تحت التجربة, مشروط بالموافقة (اختصار بريطاني غير رسمي للموافقة (غالبًا في سياق الشراء تحت التجربة))\nمثال: قبله بشرط الموافقة بعد التجربة",
 "approach": "اِقْتَرَبَ / اِقْتِرَاب, مُقَارَبَة (اقتراب) / كَيْفِيَّة, طَرِيقَة\nمثال: هو واصل الاقتراب مني.",
 "approach path": "مسار الاقتراب, مسار الانزلاق (المسار النهائي الذي تتبعه الطائرة أثناء هبوطها)",
 "approach pattern": "نمط الاقتراب, نمط المرور الجوي (المسار المحدد لطائرة تستعد للهبوط في مطار)\nمثال: أنماط المرور حول أوهير مزدحمة جداً",
 "approach shot": "ضربة اقتراب (ضربة غولف قصيرة نسبياً تهدف لوضع الكرة في المنطقة الخضراء)\nمثال: خسر الحفرة عندما تدحرجت ضربة اقترابه وتجاوزت المنطقة الخضراء",
 "approach trench": "خندق مواصلات (خندق يوفر ممراً محمياً بين الخطوط الخلفية والأمامية لموقع دفاعي)",
 "approachability": "تيسر الوصول, سهولة المعشر (سمة كونه سهلاً للقاء أو التعامل معه)",
 "approachable": "سَهْل المُقَارَبَة, يَسْهُل الوُصُول إِلَيْه (يسهل الاقتراب منه أو الوصول إليه) / دَمِث الخُلُق, سَهْل المَعْشَر (من السهل مقابلته أو التحدث معه أو التعامل معه) / سَهْلُ القِرَاءَة, مَيْسُورُ الفَهْم (يمكن قراءته وفهمه بسهولة)\nمثال: شخص ودود سهل المعشر",
 "approaching": "اقتراب, دنو (فعل الاقتراب مكانياً من شيء ما) / قَادِم, مُقْبِل (فِي المُسْتَقْبَلِ القَرِيبِ نِسْبِيًّا) / اقتراب, دنو (الخاصية الزمنية المتمثلة في الاقتراب في الوقت) / اقتراب, دنو (حدث اقتراب شيء من شيء آخر)\nمثال: اقتراب الصياد شتت الإوز",
 "approbation": "استحسان رسمي, موافقة رسمية (اعتراف رسمي أو موافقة) / استحسان رسمي, مصادقة (موافق رسمية)",
 "approbative": "اسْتِحْسَانِيّ, مُوَافِق (يُعَبِّر عَنِ المَدْح أَوِ الاسْتِحْسَان أَوْ يُظْهِرُهُمَا)",
 "approbatory": "اسْتِحْسَانِيّ, مُوَافِق (يُعَبِّر عَنِ المَدْح أَوِ الاسْتِحْسَان أَوْ يُظْهِرُهُمَا)",
 "appropriable": "قَابِل لِلتَّخْصِيص (يمكن تخصيصه أو الاستيلاء عليه)",
 "appropriate": "مُنَاسِب / لَائِق",
 "appropriately": "بشكل لائق, بشكل مناسب (بما يتوافق مع ما هو مناسب أو ملائم للظروف)\nمثال: كان يرتدي ملابس مناسبة",
 "appropriateness": "مُلَاءَمَة, مُوَافَقَة (صفة كون الشيء مناسباً بشكل خاص) / صوابية, ملاءمة (السلوك المناسب؛ فعل الشيء الصحيح)",
 "appropriation": "استيلاء, مصادرة (فعل متعمد لاكتساب شيء ما، غالباً دون إذن المالك) / استيلاء, ضم (الدمج عن طريق الانضمام أو الاتحاد) / اعتماد مالي, مخصصات مالية (أموال مخصصة (كما من قبل هيئة تشريعية) لغرض محدد)\nمثال: تم الحصول على الأموال اللازمة من خلال استيلاء الحكومة على الوحدة التشغيلية للشركة",
 "appropriation bill": "مشروع قانون المخصصات (عمل تشريعي يقترح السماح بإنفاق الأموال العامة لغرض محدد)",
 "appropriative": "استحواذي (من أو متعلق بـ أو يميل إلى فعل أخذ الشيء لنفسك)",
 "appropriator": "مستحوذ, مستولٍ (شخص يأخذ شيئاً لاستخدامه الخاص (خاصة بدون إذن))",
 "approval": "قُبُول, قَبُول (القبول: الرِّضَا بالشيء وميل النفس إليه والحسن والشارة وريح الصبا؛ (المعجم الوسيط)؛ ريح شرقية)\nمثال: أميل إلى قبول العرض.",
 "approve": "صَدَّقَ, وَافَقَ (نقيض الْكِذْب والكَذِب؛ قول ما يعتقدهُ القائل مطابقا للوَاقِع) / اِسْتَحَسَنَ, وَافَقَ (عَدَّه حَسَنا بمعنى جميل؛ عدَّه حسنًا بمعنى جَيِّد) / وَافَقَ (صَادَفَ؛ صَادَقَ)\nمثال: صدق سامي كل شيء.",
 "approved": "مُقَرّ, مُوَافَق عَلَيْه (مُقَرّ من قِبَل السلطة؛ حاصل على الموافقة الرسمية)",
 "approver": "مُعتمِد, مُوافق (سلطة لديها القدرة على الموافقة)",
 "approving": "اسْتِحْسَانِيّ, مُوَافِق (يُعَبِّر عَنِ المَدْح أَوِ الاسْتِحْسَان أَوْ يُظْهِرُهُمَا) / استحسان, مباركة (الفعل الرسمي للموافقة)\nمثال: أعطى المشروع مباركته",
