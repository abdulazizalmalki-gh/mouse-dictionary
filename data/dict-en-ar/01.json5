 "fine": "غَرَامَة / غَرَّمَ (التزم بدفع شيء مقابل عمل أو خطأ أو ضرر؛ تحمل مسؤولية أو عقوبة نتيجة لفعل)",
 "fine arts": "فُنُون جَمِيلَة (بمعنى الضرب من الشيء والنوع؛ بمعنى بعض الصناعات الراقية التي تحتاج إلى مهارة يحكمها الذوق والمواهب)\nمثال: زيري يحب الفنون.",
 "finesse": "بَرَاعَة",
 "finger": "إِصْبَع (عضو مستطيل ينشعِب من طرف الكفّ أو القدم) / بَنَان (أَطْرَافُ الأَصَابِعِ) / صَبَّعَ ((صَبَعَ) به، وصَبَعَ عليه يَصْبَعُ صَبْعًا: أشار نحوه بِإِصبَعِهِ سخريةً؛ (صَبَعَ) في الشيءِ: أَدخل إصبَعَه فيه)\nمثال: كان أول ما لفت انتباهه هي بصمة الإصبع على الزجاج.",
 "fingernail": "ظُفْر (الجزء المتقرن الميت على طرف الأصبع من الإنْسَان وبعض الحَيْوَانَات)\nمثال: نبت ظفر أصبع رجلي الكبير.",
 "fingerprint": "بَصْمَة",
 "fingertip": "بَنَان, أُنْمُلَة (أَطْرَافُ الأَصَابِعِ)\nمثال: لبنان دولة صغيرة.",
 "finish": "فَرَغَ, أَنْهَى / اِنْتَهَى (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات)\nمثال: انتهى أمر زيري.",
 "finistère": "فنستير",
 "finland": "فِنْلَنْدَا, فِنْلَنْدَة",
 "finn": "فِنْلَنْدِيّ, فِنْلَنْدِيَّة"
}
