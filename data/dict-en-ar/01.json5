 "alveolar rhabdosarcoma": "ساركومة عضلية مخططة سنخية (شكل من أشكال الساركومة العضلية المخططة يحدث بشكل رئيسي عند المراهقين والشباب)",
 "alveolar ridge": "سِنْخ, نَاتِئ سِنْخِيّ",
 "alveolate": "سِنْخِيّ, مُجَوَّف (مليء بتجاويف تشبه الخلايا (كقرص العسل))",
 "alveolitis": "التهاب الأسناخ (التهاب الأسناخ في الرئتين الناتج عن استنشاق الغبار؛ مع التعرض المتكرر قد تصبح الحالة مزمنة) / التهاب السنخ الجاف (التهاب في سنخ السن؛ يحدث أحياناً بعد قلع السن وفشل تكون جلطة دموية)",
 "alveolus": "حويصلة هوائية",
 "alvin": "أَلْفِين",
 "alvine": "بطني, معوي (متعلق بالأمعاء)",
 "always": "دَائِمًا, أَبَدًا",
 "alyssum": "أليسم, زهرة العسل (أي نبات حديقة من جنس الأليسم له عناقيد من الزهور الصفراء أو البيضاء الصغيرة)",
 "alytes cisternasi": "علجوم قابلة إيبيري (مشابه في العادة لعلجوم القابلة)",
 "alytes obstetricans": "علجوم قابلة (علجوم أوروبي يحمل ذكره البيض المخصب ملفوفاً حول أرجله الخلفية حتى يفقس)",
 "alzheimer's": "مرض ألزهايمر (شكل تقدمي من الخرف المبكر يشبه خرف الشيخوخة إلا أنه يبدأ عادة في الأربعينيات أو الخمسينيات من العمر؛ أول الأعراض ضعف الذاكرة يليه ضعف التفكير والكلام…)",
 "alzheimer's disease": "أَلْزْهَايْمْر",
 "alzheimers": "مرض ألزهايمر (شكل تقدمي من الخرف المبكر يشبه خرف الشيخوخة إلا أنه يبدأ عادة في الأربعينيات أو الخمسينيات من العمر؛ أول الأعراض ضعف الذاكرة يليه ضعف التفكير والكلام…)",
 "am": "صَبَاحًا, قَبْل الظُّهْر (قبل الساعة 12 ظهراً) / تضمين السعة (تضمين سعة الموجة الحاملة (للراديو)) / ماجستير الآداب (درجة الماجستير في الآداب والعلوم) / أمريسيوم (عنصر فلزي مشع ما بعد اليورانيوم؛ اكتشف بقصف اليورانيوم بذرات الهيليوم)\nمثال: لنلتقي في الساعة 11 صباحاً",
 "amabilis fir": "شوح بهي, شوح فضي باسيفيكي (شوح متوسط إلى طويل من غرب أمريكا الشمالية له تاج مخروطي وفروع في طبقات؛ الأوراق تفوح منها رائحة البرتقال عند سحقها)",
 "amadavat": "أفادافات (طيور نساجة آسيوية حمراء تُربى غالباً كطيور زينة)",
 "amah": "خادمة (عاملة منزلية) / مرضعة (امرأة تُستأجر لإرضاع طفل شخص آخر)",
 "amain": "بِكُلّ قُوَّة (بكل قوتك) / بِأَقْصَى سُرْعَة (بسرعة كاملة؛ مع عجلة كبيرة)\nمثال: سحب الحبال بكل قوته",
 "amalgam": "مَلْغَم / مَلْغَمَة",
 "amalgamate": "مُنْدَمِج, مُوَحَّد (اندمج في كلّ واحد متكامل)",
 "amalgamated": "مُنْدَمِج, مُوَحَّد (اندمج في كلّ واحد متكامل)",
 "amalgamation": "اندماج, دمج (اتحاد شركتين تجاريتين أو أكثر)",
 "amalgamative": "اندماجي, دمج (يتسم بـ أو يميل نحو الاندماج أو الخلط)",
 "amalgamator": "دامِج الشركات (رجل أعمال يرتب لدمج شركتين تجاريتين أو أكثر)",
 "aman": "أمان (الاستخبارات العسكرية الإسرائيلية التي تنتج إيجازات استخباراتية وطنية شاملة لرئيس الوزراء ومجلس الوزراء)",
 "amanita caesarea": "أمانيت قيصري, غاريقون ملكي (فطر صالح للأكل واسع الانتشار يشبه فطر الذباب)",
 "amanita mappa": "قبعة الموت الكاذبة (غاريقون غالباً ما يتم الخلط بينه وبين كأس الموت)",
 "amanita muscaria": "أمانيت مسكاري, فطر الذباب (فطر غابات سام (ولكن نادراً ما يكون قاتلاً) له قبعة قرمزية مع ثآليل بيضاء وخياشيم بيضاء)",
 "amanita phalloides": "أمانيت فالوسي, قبعة الموت (فطر سام للغاية عادة ما يكون أبيض اللون بقاعدة بارزة تشبه الكأس؛ يختلف عن الغاريقون الصالح للأكل فقط في خياشيمه البيضاء)",
