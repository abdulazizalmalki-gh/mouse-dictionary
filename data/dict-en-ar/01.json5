 "amateurish": "غَيْر مَاهِر, هَاوٍ (يفتقر إلى المهارة أو الخبرة المهنية)",
 "amateurishly": "بأسلوب الهواة, بشكل هاو (بطريقة الهواة)\nمثال: أدى القطعة بأسلوب الهواة",
 "amateurishness": "أسلوب الهواة (شيء يظهر نقصاً في الكفاءة المهنية)",
 "amateurism": "الهواية, مبدأ الهواية (القناعة بوجوب ممارسة الرياضة كهواية (للمتعة) وليس من أجل المال)",
 "amati": "أَماتي (كمان صنعه نيكولو أماتي أو أحد أفراد عائلته)",
 "amative": "عَاشِق, غَرَامِيّ (يميل إلى الحب أو يُظهره)",
 "amativeness": "إثارة جنسية, شبق (إثارة مشاعر الرغبة الجنسية)",
 "amatory": "رُومَانْسِيّ, غَزَلِيّ (يُعبِّر عن الحب الجنسي أو الرومانسية أو يُثيرهما)",
 "amatriciana": "أَمَاتْرِيسِيَانَا",
 "amatungulu": "خوخ ناتال, كاريس كبير الثمار (شجيرة كبيرة جداً كثيفة التفرع من جنوب إفريقيا لها أشواك خضراء زاهية متشعبة وأوراق لامعة)",
 "amaurosis": "كُمْنَة",
 "amaurotic": "كمني (متعلق بالعمى الناجم عن الكمنة (فقدان البصر بدون آفة ظاهرة))",
 "amaze": "عَجَّبَ",
 "amazed": "مَذْهُول, مُنْدَهِش (مملوء بالتأثر العاطفي الناجم عن مفاجأة أو صدمة شديدة)",
 "amazement": "دهشة, ذهول (الشعور الذي يصاحب شيئاً مفاجئاً للغاية)\nمثال: نظر إلي في دهشة",
 "amazing": "مُدْهِش, مُذْهِل",
 "amazingly": "عَجَبًا",
 "amazon": "نَهْر الأمازون, الأَمَزونْ (صَارَ عَصَبِيًّا وغَضِبَ؛ أَصَابَ الشَّيْءَ أو الكَائِنَ بِغَضَبٍ أو صَارَ يَأْمُرُهُ)\nمثال: عبر جوناس النهر.",
 "amazon ant": "نملة أمازونية (نوع نمل صغير محمر مستعبد)",
 "amazonas": "اَلْأَمَازُونْ, أَمَازُونَاسْ",
 "amazonia": "أمازون, الأمازون",
 "ambage": "إطناب, لف ودوران (أسلوب يتضمن طرقاً غير مباشرة للتعبير عن الأشياء)",
 "ambages": "طرق ملتوية ((قديم) طرق عمل ملتوية أو غامضة)",
 "ambagious": "إِطْنَابِيّ, مُسْهِب (مُوَارِب وَمُطْنِب بِلَا دَاعٍ)",
 "ambassador": "سَفِير, سَفِيرَة (السَّفير: ما سقط من ورق الشجر وتَحَاتَّ)\nمثال: طموحها هو أن تصبح سفيرة.",
 "ambassadorial": "سفيري (من أو يتعلق بالسفراء أو يميزهم)",
 "ambassadorship": "سفارة, منصب السفير (منصب السفير)",
 "ambassadress": "سفيرة (امرأة تعمل كسفير)",
 "amber": "كَهْرَمَان (عَلَك أُحْفُوْرِيّ افرزته اشجار من المخروطيات نبتت في عصور جيولوجية قديمة، وقد يقال قَهْرَمَان) / كَهْرَمَانِيّ",
 "amber lily": "زنبق العنبر (نبات ذو أوراق قاعدية تشبه العشب وعنقود مفتوح ضيق من الزهور البرتقالية المصفرة الشبيهة بالنجوم فوق ساق عديم الأوراق؛ جنوب غرب الولايات المتحدة؛ النوع…)",
 "amber-green": "أَخْضَر كَهْرَمَانِيّ (ذو لون أخضر بمسحة كهرمانيّة)",
 "amberbell": "زنبق السلمون المرقط, لسان الحية الأصفر (نبات سن الكلب من شرق أمريكا الشمالية له زهور صفراء منفردة معلمة بالبني أو الأرجواني وداخل منقط)",
 "amberboa moschata": "سلطان جميل, عنبر كشميري (نبات آسيوي يُزرع على نطاق واسع لزهوره الوردية ذات الرائحة الحلوة؛ يوضع أحياناً في جنس القنطريون)",
 "amberfish": "سمكة العنبر, عنبر جاك (أي من عدة أسماك كارانجيد تعيش في المياه الدافئة ولها ذيل متشعب ولون عنبري إلى نحاسي)",
 "ambergris": "عَنْبَر",
 "amberjack": "سمكة العنبر, عنبر جاك (أي من عدة أسماك كارانجيد تعيش في المياه الدافئة ولها ذيل متشعب ولون عنبري إلى نحاسي)",
 "ambiance": "أجواء, جو (الغلاف الجوي للبيئة المحيطة) / أجواء, جو (بيئة معينة أو تأثير محيط)\nمثال: كان هناك جو من الإثارة",
 "ambidexterity": "براعة يدوية مزدوجة, مهارة كلتا اليدين (خاصية المهارة المتساوية بكلتا اليدين)",
 "ambidextrous": "أَضْبَط",
 "ambidextrousness": "براعة يدوية مزدوجة, مهارة كلتا اليدين (خاصية المهارة المتساوية بكلتا اليدين)",
 "ambience": "أجواء, جو (الغلاف الجوي للبيئة المحيطة) / أجواء, جو (بيئة معينة أو تأثير محيط)\nمثال: كان هناك جو من الإثارة",
 "ambient": "مُحِيط (يحيط بالشيء إحاطة كاملة)",
 "ambiguity": "اِلْتِبَاس / إِبْهَام (الإِصْبَعُ الغليظةُ الخامسةُ من أَصابع اليد والرِّجل، وهي ذات سُلامَيَيْن (مؤنثة وقد تذكَّر) والجمع: أباهيم، وإبهامات)",
 "ambiguous": "غَامِض",
 "ambiguously": "بشكل ملتبس, بغموض (بطريقة غامضة)\nمثال: هذه الرسالة مصاغة بغموض",
 "ambit": "حيز, مجال (منطقة يعمل فيها شيء ما أو يكون له فيها قوة أو سيطرة)\nمثال: البيانو لديه نطاق أكبر من الصوت البشري",
 "ambition": "مَطْمَح",
 "ambitionless": "بِلَا طُمُوح, غَيْر طَمُوح (لديه رغبة قليلة في النجاح أو الإنجاز)",
 "ambitious": "طَمُوح",
 "ambitiously": "بِطُمُوح (مع الطموح؛ بطريقة طموحة وحيوية)\nمثال: تابعت أهدافها بطموح",
 "ambitiousness": "طموح (دافع قوي للنجاح)",
 "ambivalence": "ازدواجية المشاعر, تناقض وجداني (مشاعر أو عواطف مختلطة)",
 "ambivalency": "ازدواجية المشاعر, تناقض وجداني (مشاعر أو عواطف مختلطة)",
 "ambivalent": "حَائِر, مُتَذَبْذِب (غير قادر على اتّخاذ قرار بشأن المسار الذي يتّبعه)",
 "ambiversion": "توازن ((علم النفس) طبع متوازن وسط بين الانبساط والانطواء)",
 "ambiversive": "متوازن, مزدوج التوجه (وسط بين الانطوائية والانبساطية)",
 "amble": "تجوال, تنزة (مشي متمهل (عادة في مكان عام))",
 "ambler": "متسكع, متمش (شخص يمشي بخطى متمهلة)",
 "ambloplites rupestris": "باس الصخور (سمكة غذائية ورياضية في أعالي المسيسيبي والبحيرات العظمى)",
 "amblygonite": "أمبليغونيت (معدن أبيض أو رمادي يتكون من فوسفات الليثيوم والألمنيوم؛ وهو مصدر لليثيوم)",
 "amblyopia": "عين كسولة, غمش (ضعف بصري دون وجود مرض عضوي ظاهر)",
 "amblyopic": "غمشي (متعلق بنوع من ضعف البصر دون وجود مرض عضوي واضح (الغمش))",
 "amblyrhynchus cristatus": "إغوانة بحرية (سحلية تعيش على الشاطئ وتأكل الأعشاب البحرية في جزر غالاباغوس)",
 "ambo": "منبر, منصة الخطابة (منصة مرتفعة عن المستوى المحيط لإبراز الشخص الموجود عليها)",
 "amboceptor": "مستقبل ثنائي (جسم مناعي يتكون في الدم أثناء العدوى أو التحصين ويعمل على ربط المتمم بالمستضد)",
 "amboina pine": "صنوبر أمبوينا (موطنها جزر الملوك والفلبين؛ مصدر لراتنج الدامار)",
 "amboyna": "أمبوينا, بادوك (شجرة موطنها جنوب شرق آسيا ذات خشب محمر ذو عروق سوداء مرقشة أو مخططة) / خشب الأمبوينا (خشب ذو عروق مجعدة مبقعة)",
 "amboyna pine": "صنوبر أمبوينا (موطنها جزر الملوك والفلبين؛ مصدر لراتنج الدامار)",
 "ambrosia": "أمبروزيا, طعام الآلهة ((الأساطير الكلاسيكية) طعام وشراب الآلهة؛ البشر الذين أكلوه أصبحوا خالدين) / أمبروزيا (تحلية فواكه مصنوعة من البرتقال والموز مع جوز الهند المبشور) / أمبروزية, دمسيسة (أي من العديد من النباتات الضارة في أمريكا الشمالية التي تشكل جنس الأمبروزية والتي تنتج حبوب لقاح مسببة للحساسية الشديدة المسؤولة عن الكثير من حمى…) / خبز النحل (خليط من الرحيق وحبوب اللقاح يعده النحل العامل ويُطعم لليرقات)",
 "ambrosia artemisiifolia": "دمسيسة شائعة, عشبة الرجيد (عشبة ضارة حولية ذات أوراق مقسمة بدقة وسنابل من الزهور الخضراء؛ شائعة في أمريكا الشمالية؛ أدخلت في أماكن أخرى عن طريق الخطأ)",
 "ambrosia psilostachya": "دمسيسة غربية, رجيد معمر (رجيد معمر خشن ذو جذور زاحفة في الأراضي الجرداء الجافة بجنوب غرب الولايات المتحدة والمكسيك)",
 "ambrosia trifida": "دمسيسة كبيرة, رجيد كبير (نبات حولي خشن ببعض الأوراق مشقوقة بعمق وبشكل كفي إلى ثلاثة أو خمسة شقوق)",
 "ambrosial": "أَمْبروسِيّ, إلَهِيّ المَذاق (جَدير بِالآلِهَة؛ فائِق اللَّذَّة والعُذوبَة) / رَحِيقِيّ, سَمَاوِيُّ المَذَاق (بَالِغُ اللَّذَّةِ فِي الطَّعْمِ؛ حُلْوٌ وَعَطِر)",
 "ambrosian": "أَمْبروسِيّ, إلَهِيّ المَذاق (جَدير بِالآلِهَة؛ فائِق اللَّذَّة والعُذوبَة) / رَحِيقِيّ, سَمَاوِيُّ المَذَاق (بَالِغُ اللَّذَّةِ فِي الطَّعْمِ؛ حُلْوٌ وَعَطِر) / أمبروزي (من أو بواسطة أو متعلق بالقديس أمبروز)\nمثال: أناشيد أمبروزية",
 "ambulacral": "حركي, قدمي أنبوبي (متعلق بالميازيب الحركية لشوكيات الجلد الشعاعية)",
 "ambulacrum": "ميزاب حركي (إحدى المناطق الخمس على السطح السفلي لشوكيات الجلد التي توجد عليها الأقدام الأنبوبية)",
 "ambulance": "سَيَّارَة إِسْعَاف (مؤنث سَيَّار، صفة للكثير السَيْر؛ القَافِلَة أوالقَوْم الذين يسيرون)\nمثال: إنه يملك سيارة.",
 "ambulance chaser": "محامي تعويضات, مطارد الإسعاف (محامٍ غير أخلاقي يحرض ضحايا الحوادث على رفع دعاوى قضائية)",
 "ambulant": "قَادِرٌ عَلَى المَشْي, مُتَجَوِّل (قَادِرٌ عَلَى المَشْيِ وَالتَّنَقُّلِ عَلَى قَدَمَيْه)",
 "ambulant plague": "طاعون متجول (شكل خفيف من الطاعون الدملي)",
 "ambulation": "تجوال, مشي (المشي في الجوار)\nمثال: شجعت المستشفى على المشي المبكر",
 "ambulatory": "قَادِرٌ عَلَى المَشْي, مُتَجَوِّل (قَادِرٌ عَلَى المَشْيِ وَالتَّنَقُّلِ عَلَى قَدَمَيْه) / متنقل, مشي (يتعلق بـ أو متكيف للمشي) / رواق, ممشى مسقوف (ممشى مغطى (كما في الدير))\nمثال: ممر للمشي",
 "ambulatory plague": "طاعون متجول (شكل خفيف من الطاعون الدملي)",
 "ambuscade": "كمين (فعل إخفاء نفسك والتربص للهجوم على حين غرة)",
 "ambush": "كَمين / كَمِين",
 "ambusher": "رامي كمين (مهاجم ينتظر في موقع مخفي لشن هجوم مفاجئ)",
 "ambystoma maculatum": "سمندل أرقط (سمندل أسود لامع من أمريكا الشمالية ذو بقع صفراء)",
 "ambystoma mexicanum": "أكسولوتل, عفريت الماء (يرقة سمندل من البحيرات الجبلية في المكسيك تعيش عادة دون أن تتحول)",
 "ambystoma talpoideum": "سمندل الخلد (سمندل حفار بني مسود من جنوب شرق الولايات المتحدة)",
 "ambystoma tigrinum": "سمندل النمر (سمندل بني أو أسود واسع الانتشار في أمريكا الشمالية ذو بقع صفراء عمودية)",
 "ambystomid": "سمندل الخلد (سمندل العالم الجديد صغير إلى متوسط الحجم بري أو شبه مائي)",
 "ambystomid salamander": "سمندل الخلد (سمندل العالم الجديد صغير إلى متوسط الحجم بري أو شبه مائي)",
 "amchur": "أَمْجُور",
 "amd": "تنكس بقعي مرتبط بالعمر (تنكس بقعي مرتبط بالتقدم في العمر)",
 "ame-no-uzume": "أَمِه نُو أُوزُومِه, أَمَه نُو أُوزُومِه (أَمِهَ يَأْمَهُ أَمَهًا: نَسيَ؛ أَمِهَ الشيء: نَسِيَهُ)\nمثال: كانت أمه مسلمة.",
 "ameba": "أميبا, متحولة (أوالي عارية تعيش في المياه العذبة أو البحرية أو طفيلية تشكل أقداماً كاذبة مؤقتة للتغذية والحركة)",
 "ameban": "أميببي, متمور (يخص أو يشبه الأميبا)\nمثال: زحار أميبي",
 "amebiasis": "داء الأميبات (عدوى تسببها الأميبا المسببة للأمراض)",
 "amebic": "أميببي, متمور (يخص أو يشبه الأميبا)\nمثال: زحار أميبي",
 "amebic dysentery": "زحار أميبي (التهاب الأمعاء الذي تسببه المتحولة الحالة للنسج؛ يكتسب عادة عن طريق تناول الطعام أو الماء الملوث بالبراز؛ يتميز بإسهال شديد)",
 "amebiosis": "داء الأميبات (عدوى تسببها الأميبا المسببة للأمراض)",
 "ameboid": "أميبي, متحول (يشبه الأميبا (خاصة في وجود شكل غير منتظم ومتغير))",
 "amebous": "أميببي, متمور (يخص أو يشبه الأميبا)\nمثال: زحار أميبي",
 "ameer": "أمير (حاكم مستقل أو زعيم (خاصة في أفريقيا أو الجزيرة العربية))",
 "ameiurus melas": "سلور مقرن (سلور شائع في شرق الولايات المتحدة)",
 "amelanchier alnifolia": "جوجي بيري, خدمية ألنية الأوراق (شجيرة أو شجرة صغيرة من شمال غرب أمريكا الشمالية لها زهور بيضاء كريمية عطرة وثمار صغيرة شمعية أرجوانية حمراء)",
 "amelanchier bartramiana": "خدمية بارترام (شجيرة مفتوحة النمو من شرق أمريكا الشمالية لها زهور بيضاء نقية وثمار صغيرة شمعية سوداء تقريباً)",
 "amelia": "انعدام الأطراف (غياب خلقي لذراع أو ساق)",
 "amelioration": "تحسين, تلطيف (فعل تخفيف العلل والتغيير للأفضل)",
 "ameliorative": "إِصْلَاحِيّ, تَحْسِينِيّ (يميل إلى التحسين والإصلاح)",
 "amelioratory": "إِصْلَاحِيّ, تَحْسِينِيّ (يميل إلى التحسين والإصلاح)",
 "ameloblast": "أرومة الميناء (خلية يتطور منها ميناء الأسنان)",
 "amelogenesis": "تكون الميناء (العملية التطورية لتشكيل ميناء الأسنان)",
 "amen": "آمْيْن (اسم فعل أمر مبن على الفتح بمعنى \"اسْتَجِبْ\"، تأتي في خاتمة الدعاء) / آمِين (اسم فعل أمر مبن على الفتح بمعنى \"اسْتَجِبْ\"، تأتي في خاتمة الدعاء) / أَمَّنَ (وَثِقَ به وأرْكَنَ إليه)\nمثال: اتصل زيري بالأمن.",
 "amen cadence": "قفلة آمين, قفلة بلاجال (قفلة (تنهي غالباً الموسيقى الكنسية) يسبق فيها كورد الدرجة الرابعة كورد الدرجة الأولى)",
 "amen corner": "ركن الآمين (منطقة مخصصة للأشخاص الذين يقودون ترديد 'آمين' بشكل جماعي)",
 "amenability": "استجابة, طواعية (سمة كون المرء متعاوناً)",
 "amenable": "قَابِلٌ لِلامْتِثَال, مُطَاوِع (مُسْتَعِدٌّ لِلامْتِثَالِ وَالتَّكَيُّف) / خَاضِعٌ لِسُلْطَة (مُلْزَم بالإجابة أمام سلطة أعلى) / قَابِل لِلْعِلَاج, مُسْتَجِيب (مفتوح للتأثر أو المعالجة بطريقة معينة) / سَلِس, مُذْعِن (يستجيب للاقتراحات والتأثيرات)",
 "amenableness": "استجابة, طواعية (سمة كون المرء متعاوناً)",
 "amend": "حَسَّنَ (جَمِيل؛ مُبْهِج) / حَسُنَ (جَمِيل؛ مُبْهِج)\nمثال: إيمي فتاة حسنة.",
 "amendable": "قَابِلٌ لِلتَّصْوِيب, قَابِلٌ لِلتَّعْدِيل (يُمْكِنُ تَصْحِيحُهُ بِإِضَافَاتٍ أَوْ تَعْدِيلَات)",
 "amendatory": "تَعْدِيلِيّ (يُحدث تعديلاً أو إصلاحاً)",
 "amended": "مُعَدَّل, مُنَقَّح (مُعدَّل نحو الأفضل) / مُعَدَّل (للتشريعات)",
 "amended return": "إقرار معدل (إقرار ضريبي يصحح المعلومات الواردة في إقرار سابق)",
 "amendment": "تَعْدِيل",
 "amends": "إصلاح الضرر, تعويض (شيء يتم فعله أو دفعه تكفيراً عن خطأ) / تعويضات, غرامة تعويضية (مبلغ من المال يُدفع كتعويض عن خسارة أو إصابة)\nمثال: كيف يمكنني التكفير عن خطئي",
 "amenia": "انقطاع الطمث (غياب أو قمع تدفق الطمث الطبيعي)",
 "amenities": "مرافق الراحة, وسائل الراحة (الأشياء التي تجعلك مرتاحاً ومطمئناً)\nمثال: كل وسائل الراحة المنزلية",
 "amenity": "مِرْفَق (مَا يُتَّكَأُ عَلَيْهِ)\nمثال: يؤلمني ذراعي من الكتف إلى المرفق.",
 "amenorrhea": "انقطاع الطمث (غياب أو قمع تدفق الطمث الطبيعي)",
 "amenorrheal": "منقطع الطمث (يتعلق بانقطاع تدفق الطمث الطبيعي لأي سبب غير الحمل)",
 "amenorrheic": "منقطع الطمث (يتعلق بانقطاع تدفق الطمث الطبيعي لأي سبب غير الحمل)",
 "amenorrhoea": "انقطاع الطمث (غياب أو قمع تدفق الطمث الطبيعي)",
 "amenorrhoeal": "منقطع الطمث (يتعلق بانقطاع تدفق الطمث الطبيعي لأي سبب غير الحمل)",
 "amenorrhoeic": "منقطع الطمث (يتعلق بانقطاع تدفق الطمث الطبيعي لأي سبب غير الحمل)",
 "ament": "نورة هرية, هريرة (نورة أسطوانية تشبه السنبلة)",
 "amentaceous": "حَامِل لِلنَّوْرَات, هِرِّيّ الزَّهْر ((عن النباتات) يحمل أو يتميّز بالنورات الهرّية)",
 "amentia": "عته (تخلف عقلي شديد)",
 "amentiferous": "حَامِل لِلنَّوْرَات, هِرِّيّ الزَّهْر ((عن النباتات) يحمل أو يتميّز بالنورات الهرّية)",
 "amercement": "غرامة (أموال تُنتزع كعقوبة)",
 "amerciable": "مُعَرَّض لِلغَرَامَة (قابِل لِلمُعاقَبَة بِغَرامَة مالِيَّة)",
 "american": "أَمْرِيكِيّ, أَمْرِيكِيَّة",
 "american agave": "أغاف أمريكي, صبار أمريكي (نبات أمريكي أحادي الإثمار يزرع على نطاق واسع بأزهار بيضاء مخضرة على ساق طويل؛ يزهر فقط بعد عشر إلى عشرين سنة ثم يموت)",
 "american alligator": "قاطور أمريكي (قاطور كبير من جنوب شرق الولايات المتحدة)",
 "american aloe": "أغاف, ألوة أمريكية (نباتات أمريكية استوائية ذات وريدات قاعدية من أوراق ليفية تشبه السيف وأزهار في سنابل طويلة؛ يزرع بعضها للزينة أو للألياف)",
 "american angelica tree": "شجرة أنجليكا الأمريكية, عصا الشيطان (شجرة أو شجيرة نفضية صغيرة تشكل كتلاً في شرق الولايات المتحدة)",
 "american antelope": "ظبي أمريكي, وعل شوكي القرون (مجتر سريع يشبه الظبي من سهول غرب أمريكا الشمالية ذو قرون صغيرة متفرعة)",
 "american arborvitae": "أرز أبيض شمالي, عفص غربي (شجرة دائمة الخضرة صغيرة من شرق أمريكا الشمالية لها أوراق صغيرة تشبه الحراشف على غصينات مسطحة)",
 "american arrowroot": "أروروت, أروروت أمريكي (نبات أبيض الزهر من جزر الهند الغربية ينتج جذره نشا الأروروت)",
 "american aspen": "حور راجف أمريكي (حور نحيل موطنه أمريكا الشمالية)",
 "american badger": "غرير أمريكي (نوع من الغرير موطنه أمريكا)",
 "american baptist convention": "المؤتمر المعمداني الأمريكي, المؤتمر المعمداني الشمالي (رابطة المعمدانيين الشماليين)",
 "american barberry": "باربيريس أمريكي (شجيرة نفضية من شرق أمريكا الشمالية تتحول أوراقها إلى القرمزي في الخريف ولها عناقيد من الزهور الصفراء تليها ثمار بيضاوية حمراء لامعة)",
 "american basswood": "زيزفون أمريكي (شجرة ظل أمريكية كبيرة بأوراق خضراء داكنة كبيرة وتاج مستدير)",
 "american beech": "زان أمريكي (شجرة غابات أمريكية شمالية بأوراق خضراء فاتحة وجوز صالح للأكل)",
 "american bison": "بيسون أمريكي (بيسون بني كبير أشعث الشعر يعيش في سهول أمريكا الشمالية)",
 "american bittern": "واق أمريكي (نوع من الواق، أصغر قليلاً من الواق الأوروبي)",
 "american bittersweet": "حلوة مرة أمريكية, سيلاستروس (شجيرة ملتفة في أمريكا الشمالية لها كبسولات صفراء تحيط ببذور قرمزية)",
 "american black bear": "دب أسود أمريكي (دب بني إلى أسود من أمريكا الشمالية؛ أصغر وأقل شراسة من الدب البني)",
 "american blight": "من التفاح الصوفي (يتغذى بشكل رئيسي على اللحاء في الأجزاء الهوائية وجذور التفاح وأشجار أخرى)",
 "american bog asphodel": "بروق المستنقعات الأمريكي (من شرق الولايات المتحدة: نيو جيرسي إلى ساوث كارولينا)",
 "american brooklime": "زهرة الوحل الأمريكية, فيرونيكا أمريكية (نبات من غرب أمريكا الشمالية وشمال شرق آسيا له سيقان مفترشة مع عناقيد كثيفة من الزهور البنفسجية الشاحبة إلى الليلكية)",
 "american buffalo": "بيسون أمريكي (بيسون بني كبير أشعث الشعر يعيش في سهول أمريكا الشمالية)",
 "american bugbane": "بق توت أمريكي, كوهوش صيفي (نبات البق توت من شرق الولايات المتحدة ذو عناقيد منتصبة من الزهور البيضاء)",
 "american centaury": "قرنفل المستنقعات, قنطريون أمريكي (أي من عدة نباتات مستنقعات زهرية اللون من شرق الولايات المتحدة تشبه القنطريون الحقيقي)",
 "american chameleon": "أنول (سحالي شجرية صغيرة آكلة للحشرات من أمريكا الاستوائية مع القدرة على تغيير لون الجلد)",
 "american cheese": "جبن شيدر, شيدر (جبن صلب ناعم الملمس؛ صنع أصلاً في شيدر في جنوب غرب إنجلترا)",
 "american chestnut": "كستناء أمريكية (شجرة كبيرة توجد من مين إلى ألاباما)",
 "american cockroach": "صرصور أمريكي (صرصور كبير بني محمر حر الطيران أصله من جنوب الولايات المتحدة ولكنه الآن واسع الانتشار)",
 "american columbo": "فراسيرا, كولومبو أمريكي",
 "american coot": "غر أمريكي (غر يوجد في أمريكا الشمالية)",
 "american copper": "فراشة نحاسية أمريكية (فراشة نحاسية شائعة في وسط وشرق أمريكا الشمالية)",
 "american crab apple": "تفاح بري أمريكي (شجرة متوسطة الحجم من شرق الولايات المتحدة لها أزهار وردية وفاكهة صفراء صغيرة)",
 "american cranberry": "توت بري أمريكي, كرانبيري كبير (نبات زاحف ذو ثمار حمراء)",
 "american cranberry bush": "رباطية ثلاثية الفصوص, شجيرة التوت البري الأمريكية (شجيرة نفضية أو شجرة صغيرة من أمريكا الشمالية لها أوراق ثلاثية الفصوص وتوت أحمر)",
 "american crayfish": "جراد البحر الأمريكي (جراد بحر كبير شائع في شرق أمريكا الشمالية)",
 "american creeper": "دابة الشجر البنية (دابة شجر شائعة في أمريكا الشمالية بمنقار منحني لأسفل)",
 "american cress": "رشاد أمريكي, رشاد الأرض (من جنوب غرب أوروبا؛ يزرع في فلوريدا)",
 "american crow": "غراب أمريكي (الغراب الشائع في أمريكا الشمالية)",
 "american dewberry": "ديوبيري أمريكي (ديوبيري من أمريكا الشمالية) / ديوبيري شمالي",
 "american dog tick": "قراد الخشب, قراد الكلب الأمريكي (قراد شائع يمكن أن ينقل حمى الجبال الصخرية المبقعة وداء التولاريميا)",
 "american dog violet": "بنفسج الكلب الأمريكي (بنفسج من شرق أمريكا الشمالية له زهور بنفسجية شاحبة إلى بيضاء)",
 "american dogwood": "قرانيا أمريكية, قرانيا حمراء (شجيرة شائعة في أمريكا الشمالية بغصينات أرجوانية محمرة وزهور بيضاء)",
 "american dream": "الحلم الأمريكي (تطلع واسع الانتشار لدى الأمريكيين للعيش بشكل أفضل مما عاشه آباؤهم)",
 "american dwarf birch": "بتولا نيوفاوندلاند القزمية (شجيرة صغيرة في الأجزاء الباردة من أمريكا الشمالية وجرينلاند)",
 "american eagle": "عقاب رخماء (عقاب كبيرة من أمريكا الشمالية لها رأس أبيض وأجنحة وجسم داكن)",
 "american egret": "بلشون أمريكي (بلشون شائع من جنس إغريتا يوجد في أمريكا؛ وهو نوع من البلشون الأبيض للعالم القديم)",
 "american elder": "بيلسان أمريكي, خمان كندي (بيلسان شائع في وسط وشرق أمريكا الشمالية يحمل توتاً أرجوانياً أسود؛ تستخدم الفاكهة في النبيذ والمربيات)",
 "american elk": "أيل أحمر (أيل شائع في المناطق المعتدلة من أوروبا وآسيا) / إلكة أمريكية, وابيتي (أيل كبير في أمريكا الشمالية يتميز الذكر منه بقرون كبيرة كثيرة التفرع)",
 "american elm": "دردار أمريكي (شجرة زينة كبيرة بفروع رشيقة تنتشر تدريجياً شائعة في شرق أمريكا الشمالية)",
 "american english": "اَلْإِنْجِلِيزِيَّة اَلْأَمْرِيكِيَّة",
 "american english orthography": "الإملاء الأمريكي, التهجئة الأمريكية (قواعد الإملاء الإنجليزية المستخدمة في الولايات المتحدة)",
 "american english spelling": "الإملاء الأمريكي, التهجئة الأمريكية (قواعد الإملاء الإنجليزية المستخدمة في الولايات المتحدة)",
 "american featherfoil": "ريشة الماء الأمريكية (ريشة ماء في شرق الولايات المتحدة ذات سيقان زهرية منتفخة إسفنجية مغمورة وأزهار بيضاء)",
 "american federalist party": "الحزب الفيدرالي (حزب سياسي رئيسي في الولايات المتحدة في أوائل القرن التاسع عشر؛ أسسه ألكسندر هاميلتون؛ فضل حكومة مركزية قوية)",
 "american federation of labor": "الاتحاد الأمريكي للعمل (اتحاد لنقابات العمال في أمريكا الشمالية اندمج مع مؤتمر المنظمات الصناعية في عام 1955)",
 "american federation of labor and congress of industrial organizations": "الاتحاد الأمريكي للعمل ومؤتمر المنظمات الصناعية (أكبر اتحاد لنقابات العمال في أمريكا الشمالية؛ تأسس عام 1955)",
 "american feverfew": "أقحوان الحمى الأمريكي, كينا برية (عشب معمر قوي من شرق الولايات المتحدة بزهور بيضاء؛ استخدم الهنود أوراقه تقليدياً لعلاج الحروق)",
 "american flag": "العلم الأمريكي, علم النجوم والخطوط (العلم الوطني للولايات المتحدة الأمريكية)",
 "american flagfish": "سمكة العلم, سمكة العلم الأمريكية (سمكة ذات ظهر أزرق داكن وجوانب بيضاء مع خطوط حمراء؛ توجد في مستنقعات وجداول فلوريدا)",
 "american fly honeysuckle": "صريمة الجدي الأمريكية, عسلة أمريكية (شجيرة أمريكية شمالية متساقطة الأوراق قائمة بزهور بيضاء مصفرة)",
 "american flying squirrel": "سنجاب طائر أمريكي (اسم يستخدم لوصف كل من السناجب الطائرة الشمالية والجنوبية)",
 "american football": "كُرَة الْقَدَم الْأَمْرِيكِيَّة, الكُرة الأَمْرِيكِيّة",
 "american football game": "كرة قدم أمريكية (لعبة يلعبها فريقان من 11 لاعباً في ملعب مستطيل طوله 100 ياردة؛ تحاول الفرق الاستحواذ على الكرة والتقدم بها عبر خط مرمى الخصم في سلسلة من اللعبات…)",
 "american foxhound": "فوكس هاوند أمريكي (سلالة أمريكية من كلاب صيد الثعالب تستخدم للصيد في مجموعات أو بشكل فردي)",
 "american frogbit": "لكمة الضفدع الأمريكية, ليمنوبيوم (نبات أمريكي بأوراق دائرية على شكل قلب أو كلية؛ يتجذر عادة في القيعان الطينية للبرك والخنادق)",
 "american gallinule": "دجاجة الماء الأمريكية (دجاجة ماء أرجوانية أمريكية)",
 "american gentian": "فراسيرا, كولومبو أمريكي",
 "american germander": "جعدة أمريكية, مريمية الخشب (شجيرة بأوراق مسننة وزهور كريمية إلى وردية أو أرجوانية في عناقيد تشبه السنابل؛ أمريكا الشمالية)",
 "american ginseng": "جنسنغ أمريكي (عشب الغابات في أمريكا الشمالية يشبه الجنسنغ الصيني ويستخدم كبديل له)",
 "american gray birch": "بتولا رمادية (بتولا متوسطة الحجم من شرق أمريكا الشمالية لها لحاء أبيض أو رمادي شاحب وخشب قليل القيمة؛ توجد غالباً كشجرة غابات ثانوية النمو)",
 "american green toad": "علجوم أخضر أمريكي (علجوم صغير أخضر أو أصفر مخضر مع قضبان وخطوط سوداء صغيرة)",
 "american grey birch": "بتولا رمادية (بتولا متوسطة الحجم من شرق أمريكا الشمالية لها لحاء أبيض أو رمادي شاحب وخشب قليل القيمة؛ توجد غالباً كشجرة غابات ثانوية النمو)",
 "american hackberry": "ميس أمريكي (شجرة ظل متساقطة الأوراق كبيرة من جنوب الولايات المتحدة بتوت أرجواني عميق صغير)",
 "american harvest mouse": "فأر الحصاد الأمريكي (أي من عدة فئران رمادية صغيرة من العالم الجديد تعيش في حقول الحبوب مثلاً)",
 "american hazel": "بندق أمريكي (شجيرة تحمل مكسرات من شرق أمريكا الشمالية)",
 "american hellebore": "خربق أبيض, خربق أمريكي (نبات من أمريكا الشمالية له أوراق كبيرة وزهور خضراء مصفرة تنمو في عناقيد؛ ينتج قلويداً ساماً يستخدم طبياً)",
 "american holly": "بهشية أمريكية, بهشية عيد الميلاد",
 "american hop": "جنجل أمريكي (نبات أمريكي أصلي يخلط أحياناً مع الجنجل الأوروبي)",
 "american hornbeam": "شجرة النير الأمريكية (شجرة أو شجيرة كبيرة بلحاء رمادي وأوراق زرقاء خضراء تتحول إلى الأحمر البرتقالي في الخريف)",
 "american indian": "اللغة الأمرندية, لغة السكان الأصليين للأمريكيتين (أي من اللغات التي يتحدث بها السكان الأصليون للأمريكيتين (الهنود الحمر))",
 "american indian day": "يوم الهنود الأمريكيين (الولايات المتحدة: رابع يوم جمعة في سبتمبر)",
 "american indian language": "اللغة الأمرندية, لغة السكان الأصليين للأمريكيتين (أي من اللغات التي يتحدث بها السكان الأصليون للأمريكيتين (الهنود الحمر))",
 "american ivy": "فرجينيا الزاحفة, لبلاب أمريكي (كرمة شائعة في أمريكا الشمالية بأوراق مركبة وثمار تشبه التوت الأسود المزرق)",
 "american kestrel": "عوسق أمريكي (صقر صغير من أمريكا الشمالية)",
 "american labor party": "حزب العمل الأمريكي (حزب سياسي سابق في الولايات المتحدة؛ تشكل عام 1936 في نيويورك عندما انشق العمال والليبراليون عن الحزب الديمقراطي)",
 "american lady crab": "سلطعون السيدة الأمريكي (سلطعون مرقط بزهو يعيش في الشواطئ الرملية لساحل المحيط الأطلسي للولايات المتحدة)",
 "american language": "الإنجليزية الأمريكية (اللغة الإنجليزية كما تُستخدم في الولايات المتحدة)",
 "american larch": "أرزية أمريكية, تاماراك (أرزية متوسطة الحجم من كندا وشمال الولايات المتحدة بما في ذلك ألاسكا لها تاج مخروطي عريض ولحاء حرشفي بني صدئ)",
 "american laurel": "غار الجبل, كلمية عريضة الأوراق (شجيرة دائمة الخضرة من أمريكا الشمالية لها أوراق لامعة وزهور بيضاء أو وردية اللون)",
 "american legion": "الفيلق الأمريكي (أكبر منظمة للمحاربين القدامى في الولايات المتحدة)",
 "american leishmaniasis": "ليشمانيا جلدية مخاطية (شكل من أشكال داء الليشمانيات؛ تقتصر القروح على الجلد والأغشية المخاطية)",
 "american licorice": "عرق سوس أمريكي, عرق سوس بري (نبات من أمريكا الشمالية يشبه العرق سوس الحقيقي وله جذر بخصائص مماثلة)",
 "american lime": "زيزفون أمريكي (شجرة ظل أمريكية كبيرة بأوراق خضراء داكنة كبيرة وتاج مستدير)",
 "american liquorice": "عرق سوس أمريكي, عرق سوس بري (نبات من أمريكا الشمالية يشبه العرق سوس الحقيقي وله جذر بخصائص مماثلة)",
 "american lobster": "كركند أمريكي (كركند ساحل المحيط الأطلسي لأمريكا) / كركند أمريكي (لحم كركند المياه الباردة ذو المخالب الكبيرة الطرية؛ يصاد من ماين إلى كارولينا)",
 "american lotus": "لوتس أمريكي, نلومبو أصفر (زنبق ماء من شرق أمريكا الشمالية له أزهار صفراء شاحبة وبذور كروية تشبه الجوز صالحة للأكل)",
 "american magpie": "عقعق أمريكي (عقعق من جبال روكي في أمريكا الشمالية)",
 "american maidenhair fern": "كزبرة البئر الأمريكية, كزبرة البئر خماسية الأصابع (سرخس أمريكي شمالي قوي التحمل متفرع راحياً بفروع منحنية متباعدة محمولة على سويقات حمراء داكنة لامعة)",
 "american marten": "دلق أمريكي (يُقدر لفروه)",
 "american mastodon": "ماستودون أمريكي (ماستودون من أمريكا الشمالية؛ يُعتبر في بعض التصنيفات ماموثاً بدلاً من ماستودون)",
 "american mastodont": "ماستودون أمريكي (ماستودون من أمريكا الشمالية؛ يُعتبر في بعض التصنيفات ماموثاً بدلاً من ماستودون)",
 "american merganser": "بلقشة أمريكية (بط غواص شائع في أمريكا الشمالية يعتبر صنفاً من البلقشة الشائعة الأوروبية)",
 "american mink": "منك أمريكي (عادة ما يكون لونه بني داكن غني)",
 "american mistletoe": "هدال أمريكي (عشب صغير بأوراق تشبه القشور على سيقان بنية محمرة وثمار تشبه التوت؛ يتطفل على أشجار التنوب واللاركس) / هدال أمريكي (الهدال التقليدي لعيد الميلاد في أمريكا: ينمو على الأشجار المتساقطة ويمكن أن يضعف النبات العائل بشدة)",
 "american mountain ash": "مران الجبل الأمريكي (صنف من مران الجبل)",
 "american oil palm": "نخيل الزيت الأمريكي (نخيل من أمريكا الوسطى والجنوبية)",
 "american olive": "خشب الشيطان, زيتون أمريكي (شجرة صغيرة من جنوب الولايات المتحدة ذات عناقيد من الزهور البيضاء الباهتة تليها ثمار أرجوانية داكنة)",
 "american organ": "أرغن أمريكي (آلة ذات قصبات حرة يتم فيها سحب الهواء عبر القصبات بواسطة منفاخ شفط)",
 "american oriole": "صفارية العالم الجديد (طائر مغرد أمريكي؛ الذكر أسود وبرتقالي أو أصفر)",
 "american parasol": "مظلة أمريكية (غاريقون بقبعة شاحبة وساق متضخم بالقرب من القاعدة)",
 "american parsley fern": "سرخس البقدونس الأمريكي (سرخس صخري في شمال أمريكا الشمالية ينمو في كتل ضخمة وله سعف يشبه البقدونس)",
 "american party": "الحزب الأمريكي, حزب لا أدري (حزب سياسي سابق في الولايات المتحدة؛ كان نشطاً في خمسينيات القرن التاسع عشر لإبعاد السلطة عن أيدي المهاجرين والروم الكاثوليك)",
 "american pasqueflower": "زهرة الفصح الأمريكية, شقائق النعمان البراري (نبات معمر قصير مشعر ذو أزهار زرقاء بنفسجية أو ليلكية في أوائل الربيع؛ أمريكا الشمالية وسيبيريا)",
 "american pennyroyal": "فوتنج, نعناع بري أمريكي (عشب أمريكي قائم مشعر متفرع له أزهار زرقاء أرجوانية؛ ينتج زيتاً أساسياً يستخدم كطارد للحشرات وأحياناً في الطب الشعبي)",
 "american persimmon": "خرمة أمريكية (شجرة متوسطة الحجم في الغابات الجافة في جنوب وشرق الولايات المتحدة تحمل فاكهة صفراء أو برتقالية قابضة جداً تكون صالحة للأكل عندما تنضج تماماً)",
 "american pit bull terrier": "ستافوردشاير تيريير أمريكي (سلالة أمريكية من التيريير العضلي ذو فراء قصير صلب ملتصق بالجسم)",
 "american plaice": "بليس أمريكي (سمكة طعام أمريكية كبيرة)",
 "american plan": "إقامة كاملة, خطة أمريكية (خطة فندقية تشمل ثلاث وجبات يومياً)",
 "american plane": "جميز أمريكي, دلب غربي (شجرة دلب كبيرة جداً منتشرة في شرق ووسط أمريكا الشمالية إلى المكسيك)",
 "american pulsatilla": "زهرة الفصح الأمريكية, شقائق النعمان البراري (نبات معمر قصير مشعر ذو أزهار زرقاء بنفسجية أو ليلكية في أوائل الربيع؛ أمريكا الشمالية وسيبيريا)",
 "american quaking aspen": "حور راجف أمريكي (حور نحيل موطنه أمريكا الشمالية)",
 "american raspberry": "توت العليق الأمريكي (توت العليق الأحمر من أمريكا الشمالية)",
 "american rattlebox": "صندوق الخشخشة الأمريكي (عشبة حولية استوائية أمريكية ذات قرن منتفخ تخشخش فيه البذور الناضجة)",
 "american red elder": "بيلسان أحمر أمريكي (شجيرة أو شجرة صغيرة شائعة في أمريكا الشمالية)",
 "american red plum": "برقوق أحمر أمريكي (أشجار برقوق برية من شرق ووسط أمريكا الشمالية لها فاكهة حمراء برتقالية بلحم أصفر)",
 "american red squirrel": "سنجاب أحمر أمريكي (من شمال الولايات المتحدة وكندا)",
 "american redstart": "حميراء أمريكية (طائر مغرد صائد للذباب يعيش في شرق أمريكا الشمالية، يتميز الذكر بلون برتقالي ساطع على الجوانب والأجنحة والذيل)",
 "american revolutionary leader": "قائد الثورة الأمريكية (زعيم وطني في الثورة الأمريكية وفي إنشاء الولايات المتحدة)",
 "american robin": "أبو الحناء الأمريكي (سمنة أمريكية كبيرة ذات صدر وبطن أحمر صدئ)",
 "american rock brake": "سرخس البقدونس الأمريكي (سرخس صخري في شمال أمريكا الشمالية ينمو في كتل ضخمة وله سعف يشبه البقدونس)",
 "american sable": "دلق أمريكي (يُقدر لفروه)",
 "american saddle horse": "حصان السرج الأمريكي (حصان عالي الخطوة نشأ في كنتاكي)",
 "american samoa": "سَامُوَّا اَلْأَمْرِيكِيَّة",
 "american shrew mole": "خلد زبابي أمريكي (خلد زبابي أسود رمادي من الولايات المتحدة وكندا)",
 "american sign language": "لُغَة اَلْإِشَارَة الْأَمْرِيكِيَّة (هِيَ مجموعة من الأصوات التي يصدرها الإنسان على شكل كلمات منظمة بقواعد، ليتواصل به الناس وينقلون به الافكار والمعاني، اللسان؛ يقصد بها أحيانا اللهجة)\nمثال: الأمازيغية لغة.",
 "american smelt": "هف أمريكي (الهف الشائع في شرق أمريكا الشمالية وألاسكا)",
 "american smokewood": "شجرة الدخان الأمريكية (شجرة شجيرية في جنوب الولايات المتحدة ذات أعمدة كبيرة من الزهور الريشية تشبه نفثات الدخان)",
 "american smooth dogfish": "كلب البحر الأملس الأمريكي (يوجد على طول ساحل المحيط الأطلسي للأمريكتين)",
 "american spelling": "الإملاء الأمريكي, التهجئة الأمريكية (قواعد الإملاء الإنجليزية المستخدمة في الولايات المتحدة)",
 "american spicebush": "شجيرة البنزوين, شجيرة التوابل (شجيرة نفضية في شرق الولايات المتحدة ذات أوراق ولحاء عطري للغاية وأزهار صفراء تليها توت قرمزي أو أصفر)",
 "american spikenard": "أراليا عنقودية, سنبل هندي أمريكي (نبات معمر جذموري خشبي غير مسلح يتميز عن الفشاغ البري بجذور أكثر عطرية وخيمات عنقودية؛ جنوب شرق أمريكا الشمالية إلى المكسيك)",
 "american staffordshire terrier": "ستافوردشاير تيريير أمريكي (سلالة أمريكية من التيريير العضلي ذو فراء قصير صلب ملتصق بالجسم)",
 "american standard code for information interchange": "أسكي, الشيفرة المعيارية الأمريكية لتبادل المعلومات ((علم الحاسوب) شيفرة لتبادل المعلومات بين الحواسيب المصنوعة من قبل شركات مختلفة؛ حيث تمثل سلسلة من 7 أرقام ثنائية كل حرف)",
 "american star grass": "عشب النجمة الأمريكي (عشب نجمة معمر من أمريكا الشمالية)",
 "american state": "ولاية أمريكية (واحدة من الولايات الخمسين في الولايات المتحدة)",
 "american sweet chestnut": "كستناء أمريكية (شجرة كبيرة توجد من مين إلى ألاباما)",
 "american sweet gum": "شجرة الصمغ الحلو, ليكويدامبر (نبات قائم على سَاق صلبة؛ مخطط له تفرعات)\nمثال: أنا تحت الشجرة.",
 "american sycamore": "جميز أمريكي, دلب غربي (شجرة دلب كبيرة جداً منتشرة في شرق ووسط أمريكا الشمالية إلى المكسيك)",
 "american toad": "علجوم أمريكي (علجوم شائع في أمريكا)",
 "american turkey oak": "بلوط تركي أمريكي (شجرة شجيرية صغيرة بطيئة النمو متساقطة الأوراق في الأراضي الرملية القاحلة بجنوب شرق الولايات المتحدة لها أوراق ذات فصوص شائكة الأطراف تشبه أصابع الديك…)",
 "american twinflower": "زهرة التوأم الأمريكية (تشبه زهرة التوأم في شمال أوروبا وآسيا)",
 "american wall fern": "بوليبودي الصخر, سرخس الجدار الأمريكي (سرخس صخري أو هوائي بشكل رئيسي في أمريكا الشمالية وشرق آسيا)",
 "american water ouzel": "دج الماء الأمريكي (دج ماء من غرب أمريكا الشمالية)",
 "american water shrew": "زباب الماء الأمريكي (زباب ماء من أمريكا الشمالية)",
 "american water spaniel": "سبانييل الماء الأمريكي (سلالة من سبانييل متوسطة الحجم نشأت في أمريكا ذات معطف مجعد بلون الشوكولاتة أو الكبد)",
 "american watercress": "رشاد أمريكي, رشاد الأرض (من جنوب غرب أوروبا؛ يزرع في فلوريدا) / جرجير أمريكي, جرجير الجبل (نبات معمر يشكل حصيرة يوجد في الينابيع الباردة في شرق الولايات المتحدة)",
 "american white birch": "بتولا بيضاء أمريكية, بتولا ورقية (بتولا أمريكية صغيرة بلحاء أبيض مقشر يُشكل غالباً في سلال أو قوارب لعبة)",
 "american white oak": "بلوط أبيض أمريكي, سنديان أبيض (شجرة نفضية كبيرة بطيئة النمو موطنها شرق الولايات المتحدة، لها فروع قوية منتشرة وأوراق ذات 7 فصوص مستديرة عادة؛ وتنتج خشباً صلباً قوياً ومتيناً)",
 "american white pine": "صنوبر أبيض أمريكي, صنوبر أبيض شرقي (صنوبر طويل النمو من شرق أمريكا الشمالية؛ اللحاء بني بشقوق طولية عند النضج؛ يقدر كشجرة خشب)",
 "american widgeon": "صواي أمريكي (نوع من البط يتميز الذكر منه بتاج أبيض)",
 "american wigeon": "ودجون أمريكي",
 "american wisteria": "ستارية أمريكية, ويستيريا أمريكية (نبات أصلي في شرق الولايات المتحدة يشبه الستارية اليابانية المزروعة وله زهور ليلك أرجوانية شاحبة)",
 "american woodcock": "دجاجة الأرض الأمريكية (دجاجة أرض صغيرة طويلة المنقار؛ تُقدر كطائر صيد)",
 "american wormseed": "دودة البذور الأمريكية, شاي مكسيكي (عشبة الخنازير الاستوائية الأمريكية كريهة الرائحة)",
 "american-indian language": "اللغة الأمرندية, لغة السكان الأصليين للأمريكيتين (أي من اللغات التي يتحدث بها السكان الأصليون للأمريكيتين (الهنود الحمر))",
 "americana": "مقتنيات أمريكية تراثية (أي قطعة (مثل الكتب أو الأثاث أو الفن) تعتبر مميزة للثقافة الأمريكية)",
 "americanisation": "أَمْرَكَة (تحوّل الشيء أو تأثره بالنمط الأمريكي في الثقافة أو السياسة أو غيرهما)",
 "americanism": "تقليد أمريكي, عادة أمريكية (عادة خاصة بالولايات المتحدة أو مواطنيها) / وَلَاء أَمْرِيكِيّ (الولاء للولايات المتحدة ومؤسساتها) / تعبير أمريكي (تعبير يميز اللغة الإنجليزية كما يتحدثها الأمريكيون)",
 "americanization": "أمركة (الاستيعاب في الثقافة الأمريكية)",
 "americanize": "أَمْرَكَ",
 "americanness": "الطابع الأمريكي (الجودة أو الخاصية لكون الشيء أمريكياً)",
 "americano": "أَمْرِيكَانُو, أَمِرِيكَانُو",
 "americas": "أَمْرِيكَا, أَمِيرِكَا",
 "americium": "أَمِرِيكِيُوم",
 "amerind": "أمريكي أصلي, هندي أحمر (متعلق بالأمريكيين الأصليين أو ثقافتهم أو لغاتهم) / اللغة الأمرندية, لغة السكان الأصليين للأمريكيتين (أي من اللغات التي يتحدث بها السكان الأصليون للأمريكيتين (الهنود الحمر))\nمثال: ديانات الأمريكيين الأصليين",
 "amerind language": "اللغة الأمرندية, لغة السكان الأصليين للأمريكيتين (أي من اللغات التي يتحدث بها السكان الأصليون للأمريكيتين (الهنود الحمر))",
 "amerindian": "أمريكي أصلي, هندي أمريكي (أي فرد من الشعوب التي عاشت في أمريكا الشمالية أو الجنوبية قبل وصول الأوروبيين)",
 "amerindian language": "اللغة الأمرندية, لغة السكان الأصليين للأمريكيتين (أي من اللغات التي يتحدث بها السكان الأصليون للأمريكيتين (الهنود الحمر))",
 "amerindian race": "عرق الهنود الحمر (يُدرج عادة ضمن العرق المغولي)",
 "amerindic": "أمريكي أصلي, هندي أحمر (متعلق بالأمريكيين الأصليين أو ثقافتهم أو لغاتهم)\nمثال: ديانات الأمريكيين الأصليين",
 "ametabolic": "غير متحول, لا استقلابي (يخضع لتحول طفيف أو لا يخضع له) / عَدِيمُ التَّحَوُّل (لَا يَمُرُّ بِتَحَوُّلٍ أَوْ يَمُرُّ بِتَحَوُّلٍ طَفِيف)",
 "ametabolous": "غير متحول, لا استقلابي (يخضع لتحول طفيف أو لا يخضع له)",
 "amethopterin": "ميثوتريكسات (مضاد مستقلب سام يحد من التكاثر الخلوي من خلال العمل كمضاد لحمض الفوليك؛ يستخدم لعلاج بعض أنواع السرطان والصدفية والتهاب المفاصل الروماتويدي)",
 "amethyst": "جَمَشْت",
 "amethystine": "جمشتي (يحتوي على أو يشبه الجمشت (حجر كريم بنفسجي))",
 "amethystine python": "بايثون جمشتي (بايثون له لون الجمشت)",
 "ametria": "انعدام الرحم (غياب خلقي للرحم)",
 "ametropia": "سوء الانكسار (خطأ في انكسار أشعة الضوء في العين كما في اللابؤرية أو قصر النظر)",
 "ametropic": "لَا سَوِيّ البَصَر (يتعلق بحالة غير طبيعية للعين لا تكون فيها الصور المرئية في بؤرة التركيز على الشبكية)",
 "amhara": "أَمْهَرِيّ (عضو في الشعب الناطق بالسامية في شمال إثيوبيا)",
 "amharic": "أَمْهَرِيّ, أَمْهَرِيَّة",
 "amharic language": "الأمهرية (اللغة المهيمنة والرسمية لإثيوبيا؛ لغة سامية متأثرة كثيرًا باللغة الكوشية)",
 "amia calva": "مقوسة الزعنفة (سمكة بدائية طويلة الجسم آكلة للحوم تعيش في المياه العذبة ولها زعنفة ظهرية طويلة جداً؛ توجد في المياه الراكدة في أمريكا الشمالية)",
 "amiability": "بشاشة, دماثة (الميل لكون المرء ودوداً ويسهل التعامل معه) / انشراح, روقان (مزاج مبتهج ومقبول)",
 "amiable": "بَشُوش, لَطِيف (يَنْشُرُ الدِّفْء وَالوُدّ مِنْ حَوْلِه) / لَطِيف المَزَاج, وَدُود (ميّال إلى إسعاد الآخرين وإرضائهم)",
 "amiableness": "بشاشة, دماثة (الميل لكون المرء ودوداً ويسهل التعامل معه)",
 "amiably": "بلطف, بود (بطريقة ودودة)\nمثال: قال بود: 'تعال لزيارتي'",
 "amianthum muscaetoxicum": "سم الذباب (جميع أجزاء النبات شديدة السمية؛ البصلة تسحق وتستخدم كسم للذباب)",
 "amianthum muscitoxicum": "سم الذباب (جميع أجزاء النبات شديدة السمية؛ البصلة تسحق وتستخدم كسم للذباب)",
 "amicability": "صداقة, ود (امتلاك طبع يتسم بالدفء والود) / مسالمة, ودية (عدم الميل للشجار)",
 "amicable": "حبي, ودي (يتميز بالصداقة وحسن النية)\nمثال: اتفاق ودي",
 "amicableness": "صداقة, ود (امتلاك طبع يتسم بالدفء والود) / مسالمة, ودية (عدم الميل للشجار)",
 "amicably": "وُدِّيًّا (بطريقة ودية)\nمثال: انفصلا ودياً",
