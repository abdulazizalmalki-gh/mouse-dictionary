 "arrested development": "تثبيت, توقف النمو (حالة غير طبيعية يتوقف فيها النمو قبل الأوان)",
 "arrester": "خطاف كبح, كابح (قيد يبطئ الطائرات عند هبوطها على سطح حاملة الطائرات)",
 "arrester hook": "خطاف كبح, كابح (قيد يبطئ الطائرات عند هبوطها على سطح حاملة الطائرات)",
 "arresting": "لَافِت, مُثِير لِلانْتِبَاه (يستحوذ على الانتباه ويأسره)",
 "arrhenatherum elatius": "شوفان طويل, شوفان كاذب (عشب أوراسي معمر خشن يشبه الشوفان؛ يوجد على حواف الطرق والأراضي العشبية الوعرة وفي مروج القش؛ أدخل إلى أمريكا الشمالية كعلف)",
 "arrhenius theory of dissociation": "نظرية التفكك, نظرية التفكك الإلكتروليتي ((كيمياء) نظرية تصف المحاليل المائية من حيث الأحماض (التي تتفكك لتعطي أيونات الهيدروجين) والقواعد (التي تتفكك لتعطي أيونات الهيدروكسيل))",
 "arrhenogenic": "مِذْكَار (لا يلد (أو لا تلد) سوى ذكور)",
 "arrhythmia": "اِضْطِرَاب نَظْم القَلْب",
 "arrhythmic": "لَا إِيقَاعِيّ (بلا اعتبار للإيقاع) / غَيْر إِيقَاعِيّ, مُتَرَجْرِج (يفتقر إلى إيقاع ثابت ومنتظم)",
 "arrhythmical": "لَا إِيقَاعِيّ (بلا اعتبار للإيقاع)",
 "arriere pensee": "تحفظ, تحفظ ذهني (شك غير معلن يمنعك من قبول شيء ما بقلب خالص)",
 "arrival": "وُصُول, وِفَادَة",
 "arrival gate": "بوابة الوصول (بوابة ينزل عندها الركاب)",
 "arrival time": "وقت الوصول (الوقت المقرر لوصول وسيلة نقل عامة إلى وجهة معينة)",
 "arrive": "وَصَلَ (ضَمَّ وَلَأَمَ. (مصدره وَصْل وصِلَة)؛ بَلَغَ الشيءَ، أَدْرَكَه. (يتعدى بإلى) (مصدره وُصُول))\nمثال: وصل السيد باكر.",
 "arrivederci": "إِلَى اللِّقَاء, مَعَ السَّلَامَة (عبارة وداع)\nمثال: تبادلوا عبارات الوداع",
 "arriver": "قادم, واصل (شخص يصل (أو قد وصل))",
 "arriviste": "حديث النعمة, متسلق طبقي (شخص صعد فجأة إلى وضع اقتصادي أعلى ولكنه لم ينل القبول الاجتماعي من الآخرين في تلك الطبقة)",
 "arroba": "أروبا (مقياس سائل (بقيم مختلفة) يستخدم في بعض البلدان الناطقة بالإسبانية) / أروبا (وحدة وزن تستخدم في بعض البلدان الناطقة بالإسبانية)",
 "arrogance": "تَكَبُّر, غُرُور",
 "arrogant": "مُتَكَبِّر, مَغْرُور (شعب مُتكبِّر : مُتعجرف ، شامخ الرأس؛ مُتكَبِّر : فاعل من تَكَبَّر)\nمثال: هو متكبر للغاية.",
 "arrogantly": "بِتَكَبُّر, بِغَطْرَسَة (بطريقة متغطرسة)\nمثال: في الأيام الخوالي كانت قاسية ومتصلبة؛ خائفة من زوجها ومع ذلك فخورة بغطرسة بأن لديها زوجاً قوياً وشرساً بما يكفي ليجعلها خائفة",
 "arrogation": "انتزاع ملكية, مصادرة (الاستيلاء من قبل الحكومة)",
 "arrogator": "مُدَّعٍ, مُدَّعٍ دُونَ حَقّ (شخص يدعي بتباهٍ حقوقاً أو مزايا لا يستحقها أو صفات لا يمتلكها)",
 "arrondissement": "دَائِرَة (في : الشكل الهندسي الذي ليس له نقطة بداية ولا نهاية ويتكون من قَوْس مستمر؛ الهيئة أو الجهة التي تدير امرا ما)\nمثال: رجاء ضع دائرة حول الجواب الصحيح.",
 "arrow": "سَهْم, سهم (سَهَمَ؛ سَهَّمَ)\nمثال: لم يصب السهم توم.",
 "arrow arum": "بيلتاندرا, لوف سهمي",
 "arrow grass": "تريغلوشين بحري, عشب السهم (نبات معمر ذو خصلات يوجد في المياه الضحلة أو المستنقعات؛ يسمم الماشية أحياناً)",
 "arrow leaved aster": "أستر سهمي الأوراق",
 "arrow wood": "خشب السهم, رباطية مسننة (شجيرة نفضية من شرق أمريكا الشمالية لها توت أزرق مسود وخشب مرن قوي كان يستخدم سابقاً لصنع السهام) / خشب السهم, رباطية (وثيقة الصلة بخشب السهم الجنوبي؛ تنمو في شرق الولايات المتحدة من ماين إلى أوهايو وجورجيا)",
 "arrow-shaped": "سَهْمِيّ الشَّكْل ((عن شكل الورقة) كرأس السهم بدون فصوص قاعديّة مُنفرجة)",
 "arrowhead": "رأس السهم, نصل (الرأس المدبب أو الطرف الضارب للسهم)",
 "arrowleaf groundsel": "شيخة سهمية الأوراق (نبات معمر بأوراق مثلثة حادة التسنن على سيقان ورقية تحمل عنقوداً من رؤوس الزهور الصفراء؛ الأماكن الرطبة في جبال غرب أمريكا الشمالية)",
 "arrowroot": "أكيرا, كنا هندية (كنا تزرع خاصة لجذمورها الصالح للأكل الذي يتم الحصول منه على نشا الأروروت) / أروروت, أروروت أمريكي (نبات أبيض الزهر من جزر الهند الغربية ينتج جذره نشا الأروروت) / أروروت (نشا مغذٍ يتم الحصول عليه من جذر نبات الأروروت)",
 "arrowsmith": "صانع السهام (صانع السهام)",
 "arrowworm": "دودة سهمية, فكيات (أي دودة من الفكيات؛ دودة بحرية شفافة ذات زعانف جانبية وذيلية أفقية وصف من الأشواك المنحنية المتحركة على كل جانب من الفم)",
 "arroyo": "أرويو (جدول أو جدول صغير)",
 "arroyo willow": "صفصاف أرويو (صفصاف شجيري في غرب الولايات المتحدة)",
 "arroz con pollo": "أرز بالدجاج (أرز ودجاج مطبوخان معاً على الطريقة الإسبانية؛ متبل جداً خاصة بالزعفران)",
 "arsaces": "أَرْشَك",
 "arsacid": "أَرْشَكِيّ, أَشْكَانِيّ",
 "arse": "ثقب المؤخرة (مصطلح عامي مبتذل للشرج) / أرداف, ألية (الجزء اللحمي من جسم الإنسان الذي يجلس عليه)\nمثال: يستحق ركلة جيدة في مؤخرته",
 "arsehole": "ثقب المؤخرة (مصطلح عامي مبتذل للشرج)",
 "arsenal": "تِرْسَانَة",
 "arsenate": "زرنيخات (ملح أو إستر لحمض الزرنيخيك)",
 "arsenic acid": "حمض الزرنيخيك (حمض يتكون من خماسي أكسيد الزرنيخ)",
 "arsenic group": "شق كاكديل, كاكديل (المجموعة أحادية التكافؤ المشتقة من الأرسين)",
 "arsenic trioxide": "ثلاثي أكسيد الزرنيخ, زرنيخ (مسحوق أبيض سام من ثلاثي أكسيد الزرنيخ؛ يستخدم في صناعة الزجاج وكمبيد للآفات (سم الفئران) ومبيد للأعشاب)",
 "arsenical": "زرنيخي (يتعلق بـ أو يحتوي على الزرنيخ) / زرنيخي, مركب زرنيخي (مبيد آفات أو دواء يحتوي على الزرنيخ)\nمثال: بخار زرنيخي",
 "arsenical copper": "نُحَاسٌ مُزَرْنَخٌ (في : عنصرْ فِلزيّ قابل للطَّرْق ، يوصَف عادة بالأحمر لقرب لونه من الحمرة؛ ما سقَط من شرر الصُّفْر أو الحدود إِذا طُرق)\nمثال: هي تصهر النحاس.",
 "arsenide": "زرنيخيد (مركب من الزرنيخ مع عنصر أكثر إيجابية)",
 "arsenious": "زرنيخوز (يتعلق بالمركبات التي يكون فيها الزرنيخ ثلاثي التكافؤ)",
 "arsenopyrite": "أرسينوبيريت (خام الزرنيخ ذو لون أبيض فضي أو رمادي)",
 "arsenous anhydride": "ثلاثي أكسيد الزرنيخ, زرنيخ (مسحوق أبيض سام من ثلاثي أكسيد الزرنيخ؛ يستخدم في صناعة الزجاج وكمبيد للآفات (سم الفئران) ومبيد للأعشاب)",
 "arsenous oxide": "ثلاثي أكسيد الزرنيخ, زرنيخ (مسحوق أبيض سام من ثلاثي أكسيد الزرنيخ؛ يستخدم في صناعة الزجاج وكمبيد للآفات (سم الفئران) ومبيد للأعشاب)",
 "arsine": "أرسين, زرنيخيد الهيدروجين (غاز سام عديم اللون وقابل للاشتعال يستخدم في التركيب العضوي ولتطعيم الترانزستورات وكغاز سام في الحروب)",
 "arson": "حَرِيق مُتَعَمَّد (النَار المشتعلة في شيء كالدَار او الغَابَة)\nمثال: أين هو الحريق إذا؟",
 "arsonist": "مفتعل حرائق (مجرم يشعل النار في الممتلكات بشكل غير قانوني)",
 "art": "فَنّ, فُنُون (نوع، صنف؛ كل عمل جميل يؤثر في المشاعر والعواطف)\nمثال: هذا مدرسنا في الفن.",
