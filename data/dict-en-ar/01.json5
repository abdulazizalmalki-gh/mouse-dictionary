 "arilus cristatus": "بق العجلة (بق مفترس كبير من أمريكا الشمالية يمتص دماء الحشرات الأخرى)",
 "ariocarpus fissuratus": "صخرة حية (صبار غير متفرع عادة وعديم الأشواك مغطى بدرنات ثؤلولية وله أزهار أرجوانية وثمار بيضاء أو خضراء؛ يشبه مسكال البيوت؛ شمال شرق المكسيك وجنوب غرب الولايات…)",
 "ariose": "غِنَائِيّ, لَحْنِيّ (ذُو لَحْنٍ مُمَيَّزٍ (بِخِلَافِ التَّرْتِيلِ الرَّتِيب))",
 "arioso": "أريوسو ((موسيقى) رسيتاتيف قصير لحني ولكنه ليس آريا كاملة)",
 "arisaema atrorubens": "أريسيما, لفت هندي (عشبة غابات أمريكية شائعة تزهر في الربيع ذات أوراق غمدية وطلع منتصب يشبه الهراوة مع قنابة خضراء وأرجوانية متقوسة تنتج توتاً قرمزياً)",
 "arisaema dracontium": "تنين أخضر (نبات يزهر في أوائل الربيع في شرق أمريكا الشمالية يشبه اللفت الهندي ولكنه ذو أوراق كفية وقنابة صفراء مخضرة نحيلة وطلع ممدود)",
 "arisaema triphyllum": "أريسيما, لفت هندي (عشبة غابات أمريكية شائعة تزهر في الربيع ذات أوراق غمدية وطلع منتصب يشبه الهراوة مع قنابة خضراء وأرجوانية متقوسة تنتج توتاً قرمزياً)",
 "arisarum vulgare": "قلنسوة الراهب (نبات معمر درني ذو قنابة كستنائية أو بنفسجية سوداء تشبه القلنسوة: موطنه البحر الأبيض المتوسط وجزر الكناري وجزر الآزور)",
 "arise": "نَهَضَ (قَامَ)\nمثال: نهض توم على قدميه.",
 "arishth": "أزاديراشتا إنديكا, شجرة النيم (شجرة كبيرة شبه دائمة الخضرة من جزر الهند الشرقية؛ يفرز جذعها صمغاً متماسكاً؛ يستخدم لحاؤها المر كمقوٍ؛ وتنتج البذور زيتاً عطرياً)",
 "arista": "سفا (نتوء يشبه الشعيرة بالقرب من طرف هوائي (قرن استشعار) بعض الذباب)",
 "aristocort": "تريامسينولون (كورتيكوستيرويد اصطناعي يستخدم كعامل مضاد للالتهابات)",
 "aristocracy": "أَرِسْتُقْرَاطِيَّة",
 "aristocrat": "أَرِسْتُقْرَاطِيّ, أَرِسْتُقْرَاطِيَّة",
 "aristocratic": "أَرِسْتُقْرَاطِيّ",
 "aristocratical": "أَرِسْتُقْرَاطِيّ, نَبِيل المَحْتِد (ينتمي إلى طبقة النبلاء أو الأرستقراطية أو يتسم بسماتها)",
 "aristocratically": "أرستقراطياً (بطريقة أرستقراطية)\nمثال: تصرفوا بأرستقراطية",
 "aristocratism": "أرستقراطية (مبادئ أو ممارسات أو خصائص الأرستقراطية)\nمثال: هذا التصميم مذهل تماماً ويحمل روح الأرستقراطية",
 "aristolochia clematitis": "زراوند (نبات زاحف له أزهار منحنية يُعتقد أنها تشبه الأجنة؛ موطنه أوروبا؛ ومستوطن في بريطانيا العظمى وشرق أمريكا الشمالية)",
 "aristolochia durior": "غليون الهولندي, كرمة الغليون (كرمة نفضية قوية التحمل ذات أوراق كبيرة وأزهار ذات أنبوب كأس منحني مثل وعاء الغليون)",
 "aristolochia macrophylla": "غليون الهولندي, كرمة الغليون (كرمة نفضية قوية التحمل ذات أوراق كبيرة وأزهار ذات أنبوب كأس منحني مثل وعاء الغليون)",
 "aristolochia serpentaria": "جذر الثعبان الفرجيني (نبات من الغابات الشرقية للولايات المتحدة)",
 "aristopak": "تريامسينولون (كورتيكوستيرويد اصطناعي يستخدم كعامل مضاد للالتهابات)",
 "aristophanes": "أرِسْطُفان, أرِسْطُفانِس",
 "aristotelean": "أرسطي, مشائي (من أو يتعلق بأرسطو أو فلسفته) / أَرِسْطِيّ, مَشَّائِيّ (تابع لأرسطو أو معتنق للأرسطية)\nمثال: منطق أرسطي",
 "aristotelia racemosa": "توت النبيذ النيوزيلندي, ماكوماكو (شجيرة نفضية رشيقة أو شجرة صغيرة ذات أوراق جذابة وتوت أحمر صغير يتحول إلى الأسود عند النضج ويستخدم لصنع النبيذ)",
 "aristotelia serrata": "توت النبيذ النيوزيلندي, ماكوماكو (شجيرة نفضية رشيقة أو شجرة صغيرة ذات أوراق جذابة وتوت أحمر صغير يتحول إلى الأسود عند النضج ويستخدم لصنع النبيذ)",
 "aristotelian": "أرسطي, مشائي (من أو يتعلق بأرسطو أو فلسفته) / أَرِسْطِيّ, مَشَّائِيّ (تابع لأرسطو أو معتنق للأرسطية)\nمثال: منطق أرسطي",
 "aristotelian logic": "المنطق الأرسطي (المنطق القياسي لأرسطو كما طوره بوثيوس في العصور الوسطى)",
 "aristotelianism": "أرسطية, مشائية ((فلسفة) فلسفة أرسطو التي تتعامل مع المنطق والميتافيزيقيا والأخلاق والشعر والسياسة والعلوم الطبيعية)\nمثال: أثرت الأرسطية بشكل عميق في الفكر الغربي",
 "aristotelic": "أرسطي, مشائي (من أو يتعلق بأرسطو أو فلسفته)\nمثال: منطق أرسطي",
 "aristotle": "أَرِسْطُو, أَرِسْطُوطَالِيس",
 "arithmancy": "عرافة الأعداد (التنجيم بواسطة الأرقام)",
 "arithmetic": "حساب, العدّ (بمعنى عَدَّ وجَمَعَ وطَرَحَ كلها معا. جمعه حُسْبَان؛ الاسم من المُحَاسَبَة، لأن فيه تُحسب المحاسن والأخطاء)\nمثال: الحساب لو سمحت.",
 "arithmetic mean": "المتوسط الحسابي",
 "arithmetic operation": "عملية حسابية (عملية رياضية تتضمن أرقاماً)",
 "arithmetic progression": "مُتَتَالِيَةٌ حِسَابِيَّة",
 "arithmetical": "حسابي (يتعلق بالحساب أو يتضمنه)\nمثال: حسابات رقمية",
 "arithmetically": "حِسَابِيًّا (فيما يتعلق بالحساب)\nمثال: هذه المشكلة سهلة حسابياً",
 "arithmetician": "عالم حساب (شخص يتخصص في الحساب)",
 "arity": "رُتْبَة الدَّالَّة, عَدَد الوَسَائِط (عدد الوسائط أو المدخلات التي يمكن أن تأخذها دالة ما)",
