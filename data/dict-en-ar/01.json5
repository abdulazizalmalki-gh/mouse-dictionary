 "aminic": "أميني (متعلق بـ أو يحتوي على أي من مجموعة المركبات العضوية النيتروجينية المشتقة من الأمونيا)",
 "amino": "أميني (متعلق بـ أو يحتوي على أي من مجموعة المركبات العضوية النيتروجينية المشتقة من الأمونيا) / أمينو, مجموعة أمينو",
 "amino acid": "حمض أميني (أصبح حامضًا، تغير الطعم إلى الحموضة؛ ارتفعت نسبة الحموضة في شيء ما، كما في الطعام أو السوائل)\nمثال: رمى ياني الحمض على وجه سكورة.",
 "amino group": "أمينو, مجموعة أمينو",
 "amino plastic": "بلاستيك أميني, راتنج أميني (بلاستيك (راتينج اصطناعي) مصنوع من مركبات أمينية؛ يستخدم كمادة لاصقة وطلاء)",
 "amino resin": "بلاستيك أميني, راتنج أميني (بلاستيك (راتينج اصطناعي) مصنوع من مركبات أمينية؛ يستخدم كمادة لاصقة وطلاء)",
 "aminoaciduria": "بيلة حمضية أمينية (وجود غير طبيعي للأحماض الأمينية في البول؛ عادة ما يكون عرضاً لعيوب التمثيل الغذائي)",
 "aminoalkane": "أمين (مركب مشتق من الأمونيا باستبدال ذرات الهيدروجين بشقوق هيدروكربونية أحادية التكافؤ)",
 "aminoalkanoic acid": "حمض أميني (مركبات عضوية تحتوي على مجموعة أمينية ومجموعة حمض كربوكسيلي)\nمثال: تتكون البروتينات من نسب مختلفة لحوالي 20 حمضاً أمينياً شائعاً",
 "aminobenzine": "أنيلين (أمين سائل سام زيتي يتم الحصول عليه من النيتروبنزين ويُستخدم لصنع الأصباغ والبلاستيك والأدوية)",
 "aminobenzoic acid": "حمض أمينوبنزويك (مشتق من حمض البنزويك)",
 "aminomethane": "أمينو ميثان (ميثيل تم استبدال ذرة هيدروجين فيه بشق أميني)",
 "aminopherase": "ترانساميناز (فئة من الترانسفيرازات التي تحفز نقل الأمين (تنقل مجموعة أمين من حمض أميني إلى مركب آخر))",
 "aminophylline": "أمينوفيلين (مشتق من الثيوفيلين يستخدم كموسع للقصبات في علاج الربو الشعبي وانتفاخ الرئة والتهاب الشعب الهوائية)",
 "aminoplast": "بلاستيك أميني, راتنج أميني (بلاستيك (راتينج اصطناعي) مصنوع من مركبات أمينية؛ يستخدم كمادة لاصقة وطلاء)",
 "aminopyrine": "أميدوبيرين, أمينوبيرين (مادة بلورية بيضاء تستخدم كمسكن وخافض للحرارة)",
 "aminotransferase": "ترانساميناز (فئة من الترانسفيرازات التي تحفز نقل الأمين (تنقل مجموعة أمين من حمض أميني إلى مركب آخر))",
 "amiodarone": "أميودارون, كوردارون (دواء مضاد لاضطراب النظم (الاسم التجاري كوردارون) له آثار جانبية خطيرة محتملة ويستخدم للسيطرة على مشاكل ضربات القلب الخطيرة فقط عندما تكون الأدوية…)",
 "amir": "أَمِير",
 "amish": "آميش (تابع أمريكي للديانة المينونية)",
 "amish sect": "الأميش, طائفة الأميش (طائفة أرثوذكسية من قائلين بتجديد العماد انفصلت عن المينونايت في أواخر القرن السابع عشر؛ استقرت بشكل رئيسي في جنوب شرق ولاية بنسلفانيا)",
 "amiss": "بشكل سيء, بشكل غير كامل (بطريقة غير كاملة أو معيبة) / بشكل خاطئ, في غير محله (بطريقة غير لائقة أو خاطئة أو مؤسفة) / عَلَى نَحْو خَاطِئ, مُنْحَرِفًا (بعيداً عن المسار الصحيح أو المتوقع)\nمثال: تطور الفص بشكل غير كامل",
 "amitosis": "انقسام مباشر, لا تفتلي (الطريقة المباشرة لانقسام الخلية التي تتميز بالانقسام البسيط للنواة دون تكوين كروموسومات)",
 "amitotic": "لا خيطي (متعلق بطريقة بسيطة لانقسام الخلايا (الانقسام المباشر))",
 "amitriptyline": "أميتريبتيلين, إيلافيل (دواء مضاد للاكتئاب ثلاثي الحلقات (الاسم التجاري إيلافيل) له آثار جانبية خطيرة؛ يتفاعل مع العديد من الأدوية الأخرى)",
 "amitriptyline hydrochloride": "أميتريبتيلين, إيلافيل (دواء مضاد للاكتئاب ثلاثي الحلقات (الاسم التجاري إيلافيل) له آثار جانبية خطيرة؛ يتفاعل مع العديد من الأدوية الأخرى)",
 "amity": "مؤاكلة, وئام / صداقة, وئام (حالة من الصداقة والمودة)",
 "amla": "أَمْلَج",
 "amlodipine besylate": "أملوديبين, نورفاسك (موسع للأوعية الدموية (الاسم التجاري نورفاسك) يؤخذ على شكل أقراص؛ يوصف لارتفاع ضغط الدم والذبحة الصدرية)",
 "amman": "عَمَّان (دولة في جنوب غرب آسيا؛ اسمها الرسمي سلطنة عمان، وعاصمتها مَسْقَط)\nمثال: تعيش لينة في عمان.",
 "ammeter": "أُمِيتْر",
 "ammine": "أمين (مركب غير عضوي معقد يحتوي على جزيئات الأمونيا)",
 "ammino": "أميني معدني (متعلق بـ أو من خصائص الأمين (مركب تناسقي غير عضوي من الأمونيا وملح معدني))",
 "ammit": "أمت ((أَمَّتَ) فلانا بشر: اتهمه به)",
 "ammiyya": "الْعَامِّيَّة, الدَّارِجَة",
 "ammo": "ذخيرة (مقذوفات تطلق من سلاح ناري)",
 "ammobium": "أموبيوم (أي نبات من جنس الأموبيوم يتميز بزهور صفراء وأوراق فضية)",
 "ammobium alatum": "أموبيوم, زهرة الخلود المجنحة (نبات أسترالي يزرع على نطاق واسع لزهوره البيضاء الفضية الجميلة ذات المراكز الصفراء الزاهية على سيقان مجنحة طويلة)",
 "ammonal": "أمونال (مادة متفجرة تتكون من نترات الأمونيوم ومسحوق الألمنيوم)\nمثال: الأمونال المستخدم لأغراض التعدين العسكري كان يُعبأ عمومًا داخل علب معدنية أو أكياس مطاطية لمنع مشاكل دخول الرطوبة",
 "ammonia": "أَمُونِيَا, نُشَادِر (غاز لا لون له رائحته كريهة نفّاذة، سام؛ في : مركب يكون في الطبيعة بشكل غاز يحتوى على عنصري النيتروجين والهيدروجين)",
 "ammonia alum": "شب, شب الأمونيوم (كبريتات مزدوجة بلورية بيضاء للألومنيوم والأمونيوم)",
 "ammonia clock": "ساعة الأمونيا (ساعة ذرية تعتمد على التردد الاهتزازي لذرة النيتروجين في جزيء الأمونيا)",
 "ammonia water": "ماء الأمونيا, هيدروكسيد الأمونيوم (محلول مائي من الأمونيا)",
 "ammoniac": "أمونياكي, نشادري (متعلق بـ أو يحتوي على أو يشبه الأمونيا (النشادر)) / أمونياك, صمغ النشادر (الصمغ العطري لنبات النشادر)",
 "ammoniacal": "أمونياكي, نشادري (متعلق بـ أو يحتوي على أو يشبه الأمونيا (النشادر))",
 "ammoniacum": "أُشَّق",
 "ammoniated": "معالج بالأمونيا, منشدر (ممزوج أو معالج بالأمونيا)\nمثال: زئبق منشدر",
 "ammonification": "معالجة بالأمونيا, نشدرة (التشبيع بالأمونيا أو مركب من مركبات الأمونيا)",
 "ammonite": "أمونيت (أحد الأصداف الأحفورية الملتفة والمقسمة لرخويات منقرضة)",
 "ammonitic": "أمونيتي (من أو متعلق برتبة من رأسيات الأرجل الأحفورية)",
 "ammonium": "أمونيوم, أيون الأمونيوم",
 "ammonium alum": "شب, شب الأمونيوم (كبريتات مزدوجة بلورية بيضاء للألومنيوم والأمونيوم)",
 "ammonium carbamate": "كربامات الأمونيوم (ملح لحمض الكرباميك يستخدم كسماد نيتروجيني)",
 "ammonium carbonate": "كربونات الأمونيوم (كربونات الأمونيوم؛ تستخدم في تصنيع أملاح الشم ومسحوق الخبز ومركبات الأمونيوم)",
