 "ammonium hydroxide": "ماء الأمونيا, هيدروكسيد الأمونيوم (محلول مائي من الأمونيا)",
 "ammonium ion": "أمونيوم, أيون الأمونيوم",
 "ammonium nitrate": "نترات الأمونيوم (تستخدم كمتفجرات وسماد ووقود للصواريخ)",
 "ammonium nitrate/fuel oil": "أنفو, نترات الأمونيوم وزيت الوقود (مادة متفجرة صناعية تتكون من مزيج من نترات الأمونيوم وزيت الوقود)",
 "ammonium salt": "ملح الأمونيوم",
 "ammoniuria": "بيلة أمونية (وجود أمونيا مفرطة في البول)",
 "ammonoid": "أمونيت (أحد الأصداف الأحفورية الملتفة والمقسمة لرخويات منقرضة)",
 "ammotragus lervia": "كبش بربري, وداد (خروف بري يعيش في شمال أفريقيا)",
 "ammunition": "ذُخِيرَة",
 "ammunition chest": "صندوق ذخيرة (صندوق لحفظ الذخيرة)",
 "amnesia": "فِقْدَان ذَاكِرَة",
 "amnesiac": "فَاقِدٌ لِلذَّاكِرَةِ, نِسْيَانِيّ (يعاني من فقدان جزئي للذاكرة) / فاقد الذاكرة (شخص يعاني من فقدان الذاكرة)",
 "amnesic": "فَاقِدٌ لِلذَّاكِرَةِ, نِسْيَانِيّ (يعاني من فقدان جزئي للذاكرة) / فقدان الذاكرة, نسياني (من أو متعلق بـ أو ناتج عن فقدان الذاكرة) / فاقد الذاكرة (شخص يعاني من فقدان الذاكرة)",
 "amnesic aphasia": "حبسة تسمية, عجز عن التسمية (عدم القدرة على تسمية الأشياء أو التعرف على الأسماء المكتوبة أو المنطوقة للأشياء)",
 "amnestic": "فقدان الذاكرة, نسياني (من أو متعلق بـ أو ناتج عن فقدان الذاكرة)",
 "amnestic aphasia": "حبسة تسمية, عجز عن التسمية (عدم القدرة على تسمية الأشياء أو التعرف على الأسماء المكتوبة أو المنطوقة للأشياء)",
 "amnesty": "عَفْو",
 "amnic": "أمينوسي, سلوي (من أو متعلق بالسلى (الغشاء المحيط بالجنين) أو يتميز بتطويره)\nمثال: الغشاء السلوي",
 "amnio": "بزل السلى (استخراج السائل الأمنيوسي من المرأة الحامل (بعد الأسبوع الخامس عشر من الحمل) للمساعدة في تشخيص تشوهات الجنين)",
 "amniocentesis": "بزل السلى (استخراج السائل الأمنيوسي من المرأة الحامل (بعد الأسبوع الخامس عشر من الحمل) للمساعدة في تشخيص تشوهات الجنين)",
 "amnion": "سَلى, أَمْنِيُون (جعله يَسْلَو، أي ينسى الهمّ والهجر وغيره مما كان عنده. فرّج همه؛ الشاة ونحوها: نزهى سلاها)",
 "amnionic": "أمينوسي, سلوي (من أو متعلق بالسلى (الغشاء المحيط بالجنين) أو يتميز بتطويره)\nمثال: الغشاء السلوي",
 "amnionic fluid": "سائل أمينوسي, سائل سلوي (السائل المصلي الذي يعلق فيه الجنين داخل السلى)",
 "amnios": "سلى, كيس سلوي (أعمق كيس غشائي يحيط بالجنين النامي للفقاريات العليا (الزواحف والطيور والثدييات))",
 "amniota": "سلويات (الفقاريات العليا (الزواحف والطيور والثدييات) التي تمتلك سلوي (غشاء جنيني) أثناء التطور)",
 "amniote": "حيوان سلوي (أي عضو من السلويات)",
 "amniotic": "أَمْنِيُوتِيّ",
 "amniotic cavity": "تجويف سلوي (التجويف المملوء بالسائل الذي يحيط بالجنين النامي)",
 "amniotic fluid": "سُخْد, سَائِل سَلْوِيّ",
 "amniotic sac": "كِيس سَلْوِيّ, سُخْد",
 "amobarbital": "أموباربيتال (باربيتورات له تأثيرات مهدئة ومنومة؛ يستخدم لتخفيف الأرق وكمضاد للاختلاج)",
 "amobarbital sodium": "أموباربيتال الصوديوم, أميتال (ملح الصوديوم للأموباربيتال الذي يستخدم كباربيتورات؛ يستخدم كمهدئ ومنوم)",
 "amoeba": "أَمِيبَا, مُتَحَوِّلَة",
 "amoeban": "أميببي, متمور (يخص أو يشبه الأميبا)\nمثال: زحار أميبي",
 "amoebiasis": "داء الأميبات (عدوى تسببها الأميبا المسببة للأمراض)",
 "amoebic": "أَمِيبِيّ",
 "amoebic dysentery": "زحار أميبي (التهاب الأمعاء الذي تسببه المتحولة الحالة للنسج؛ يكتسب عادة عن طريق تناول الطعام أو الماء الملوث بالبراز؛ يتميز بإسهال شديد)",
 "amoebiosis": "داء الأميبات (عدوى تسببها الأميبا المسببة للأمراض)",
 "amoeboid": "أميبي, متحول (يشبه الأميبا (خاصة في وجود شكل غير منتظم ومتغير))",
 "amoebous": "أميببي, متمور (يخص أو يشبه الأميبا)\nمثال: زحار أميبي",
 "amok": "مُسْتَشِيط, هَائِج (في حالة هياج عنيف وخارج عن السيطرة) / بِهَيَجَان قَاتِل (في نوبة قتل جنونية) / بِجُنُون, بِلَا ضَابِط (بشكل وحشي؛ بدون ضبط للنفس)\nمثال: مشاغبون يركضون بهيجان ويلقون العصي والزجاجات والحجارة",
 "among": "مِنْ (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "amontillado": "أمونتيلادو (شيري شاحب متوسط الجفاف من إسبانيا)",
 "amora": "أمورا (واحد من مجموعة من الحاخامات (نشطوا 250-500 م) الذين ناقشوا قانون المشنا في مدارس القانون في فلسطين وبلاد ما بين النهرين حيث شرحوا وطبقوا التعاليم…)",
 "amoral": "غَيْر أَخْلَاقِيّ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به) / عَدِيم الأَخْلَاق (عديم: فقير؛ عديم: أحمق، غبي)\nمثال: أنا غير متفاجئ.",
 "amoralism": "لاأخلاقية (المذهب القائل بأن التمييزات الأخلاقية غير صالحة)",
 "amoralist": "لا أَخْلاقِيّ (شخص يلتزم بمذهب أن التمييز الأخلاقي العادي غير صالح)",
 "amorality": "لا أخلاقية (صفة التجرد من المعايير الأخلاقية (خارج نطاق الحكم الأخلاقي))",
 "amorally": "بشكل غير أخلاقي, بفجور (دون مراعاة للأخلاق)\nمثال: تصرف بشكل غير أخلاقي عندما كانت مصالحه الخاصة على المحك",
 "amorist": "عاشِق, مُحِبّ (شخص مكرس للحب والعشق، خاصة من يكتب عن الحب)",
 "amoristic": "عشقي, غرامي (من أو متعلق بالحب الرومانسي)",
 "amorous": "عِشْقِيّ, غَرَامِيّ / عَاشِق",
 "amorously": "بِعِشْق, بِغَرَام (بطريقة غرامية)\nمثال: نظر إليها بغرام",
 "amorousness": "إثارة جنسية, شبق (إثارة مشاعر الرغبة الجنسية) / عشق, غرام (شعور بالحب أو الولع)",
 "amorpha": "أمورفا, نيلة كاذبة (أي نبات من جنس أمورفا ذو أوراق ريشية فردية وأزهار سنبلية أرجوانية)",
 "amorpha californica": "نيلة كاذبة, نيلة كاليفورنية (شجيرة مشعرة قائمة إلى منتشرة من ساحل المحيط الهادئ للولايات المتحدة لها عناقيد من الزهور الحمراء إلى النيلية)",
 "amorpha canescens": "نبات الرصاص (شجيرة في الغابات الرملية وضفاف الجداول في غرب الولايات المتحدة لها زهور ريشية شيباء وزهور عنقودية باهتة اللون؛ يعتقد أنها تشير إلى وجود خام الرصاص)",
 "amorpha fruticosa": "نيلة شجيرية, نيلة كاذبة (شجيرة كثيفة على ضفاف الأنهار الرطبة والسهول الفيضية في شرق الولايات المتحدة لها أوراق عطرة جذابة وعناقيد كثيفة من الزهور الأرجوانية الداكنة)",
 "amorphophallus": "أمورفوفالس, زهرة الجثة (أي نبات من جنس أمورفوفالس)",
 "amorphophallus campanulatus": "أمورفوفالس فاونيا, يام الفيل (نبات لوفي كريه الرائحة من جنوب شرق آسيا (خاصة الفلبين) يزرع لدرنته الصالحة للأكل)",
 "amorphophallus paeonifolius": "أمورفوفالس فاونيا, يام الفيل (نبات لوفي كريه الرائحة من جنوب شرق آسيا (خاصة الفلبين) يزرع لدرنته الصالحة للأكل)",
 "amorphophallus rivieri": "لسان الشيطان, نخيل الثعبان (نبات استوائي لحمي نوعاً ما كريه الرائحة من جنوب شرق آسيا يزرع لكورماته الصالحة للأكل أو في البيوت الزجاجية لأوراقه الكبيرة وقنابته الحمراء الداكنة…)",
 "amorphophallus titanum": "زهرة الجثة, لوف عملاق (نبات استوائي كريه الرائحة له قنابة تشبه تويج مجد الصباح ويصل قطرها إلى عدة أقدام)",
 "amorphous": "عَدِيم الشَّكْل, لَابَلُّورِيّ (بِدُون شَكْلٍ بَلُّورِيٍّ حَقِيقِيٍّ أَوْ ظَاهِر) / عَشْوَائِيّ, مُبْهَم (غامض بسبب ضعف التنظيم أو عدم الوضوح) / غَيْر مُتَبَلْوِر, لَا شَكْلِيّ ((يوصف بمجموعة من الناس أو منظمة) غير منظم أو غير مركز) / غَيْر مُهَيْكَل, لَا شَكْلِيّ (يفتقر للنظام أو البنية المميزة للأجسام الحية)",
 "amorphous shape": "شكل عشوائي, شكل غير متبلور (شكل غير محدد أو عشوائي)",
 "amort": "مَكْسُور, مُحْبَطٌ تَمَامًا (فِي حَالَةِ يَأْسٍ شَدِيدٍ وَانْكِسَارٍ تَامّ)",
 "amortisation": "إطفاء الدين, سداد بالتقسيط (دفع التزام في سلسلة من الأقساط أو التحويلات) / إطفاء الدين, إهلاك (تخفيض قيمة أصل ما عن طريق توزيع تكلفته على مدى سنوات)",
 "amortization": "إطفاء الدين, سداد بالتقسيط (دفع التزام في سلسلة من الأقساط أو التحويلات) / إطفاء الدين, إهلاك (تخفيض قيمة أصل ما عن طريق توزيع تكلفته على مدى سنوات)",
 "amos": "عَامُوس, سِفْر عَامُوس",
 "amount": "مَبْلَغ, مِقْدَار / بَلَغَ",
 "amount of money": "مبلغ, مقدار من المال (كمية من المال)\nمثال: اقترض مبلغاً كبيراً",
 "amour": "علاقة غير شرعية, نزوة (علاقة جنسية سرية أو غير مشروعة عادة)",
 "amour propre": "خيلاء, عجب (مشاعر الفخر المفرط)",
 "amoxicillin": "أموكسيسيلين, أموكسيل (مضاد حيوي؛ بنسلين فموي شبه صناعي (الأسماء التجارية أموكسيل وأوجمنتين وغيرها) يستخدم لعلاج الالتهابات البكتيرية)",
 "amoxil": "أموكسيسيلين, أموكسيل (مضاد حيوي؛ بنسلين فموي شبه صناعي (الأسماء التجارية أموكسيل وأوجمنتين وغيرها) يستخدم لعلاج الالتهابات البكتيرية)",
 "amoy": "فوكين, لغة مين (أي من أشكال اللغة الصينية التي يتم التحدث بها في مقاطعة فوجيان)",
 "amoy language": "فوكين, لغة مين (أي من أشكال اللغة الصينية التي يتم التحدث بها في مقاطعة فوجيان)",
 "amp": "أمبير (الوحدة الأساسية للتيار الكهربائي المعتمدة في النظام الدولي للوحدات) / أدينوسين أحادي الفوسفات\nمثال: الدائرة المنزلية النموذجية تحمل من 15 إلى 50 أمبير",
 "amperage": "أمبيرية, شدة التيار (بالأمبير) (قوة التيار الكهربائي مقاسة بالأمبير)",
 "ampere": "أَمْبِير",
 "ampere-hour": "أمبير-ساعة (وحدة شحنة تساوي 3600 كولوم)",
 "ampere-minute": "أمبير-دقيقة (وحدة شحنة تساوي 60 كولوم)",
 "ampere-second": "أمبير-ثانية, كولوم (وحدة للشحنة الكهربائية تساوي مقدار الشحنة التي ينقلها تيار مقداره 1 أمبير في ثانية واحدة)",
 "ampere-turn": "أمبير-لفة (وحدة للقوة الدافعة المغناطيسية تساوي القوة الدافعة المغناطيسية الناتجة عن مرور 1 أمبير خلال لفة كاملة واحدة لملف؛ تساوي 1.257 جيلبرت)",
 "ampersand": "وَاو اَللَّاتِينِيَّة",
 "amphetamine": "أَمْفِيتامين",
 "amphetamine sulfate": "كبريتات الأمفيتامين (مشتق كبريتي للأمفيتامين يستخدم كمنشط للجهاز العصبي المركزي)",
 "amphetamine sulphate": "كبريتات الأمفيتامين (مشتق كبريتي للأمفيتامين يستخدم كمنشط للجهاز العصبي المركزي)",
 "amphibian": "بَرْمَائِيّ / بَرْمَائِيّ, قَازِب",
 "amphibian family": "فصيلة برمايئات (أي فصيلة من البرمائيات)",
 "amphibian genus": "جنس برمائي (أي جنس من البرمائيات)",
 "amphibiotic": "بَرْمَائِيّ, شِبْه مَائِيّ (ذو طور يرقيّ مائيّ وطور بالغ بَرّيّ)",
 "amphibious": "بَرْمَائِيّ (يعمل أو يعيش على اليابسة وفي الماء) / برمائي (متعلق بحيوانات طائفة البرمائيات أو مميز لها)\nمثال: مركبات برمائية",
 "amphibious aircraft": "طائرة برمائية (طائرة مصممة للإقلاع والهبوط على الماء)",
 "amphibious assault": "هجوم برمائي (عملية برمائية تهاجم قاعدة برية وتنفذها قوات يتم إنزالها بواسطة السفن البحرية)",
 "amphibious demonstration": "استعراض برمائي, تمويه برمائي (عملية برمائية تُجرى لغرض خداع العدو وقيادته إلى مسار عمل غير مواتٍ له)",
 "amphibious landing": "إنزال برمائي (عمل عسكري لقوات برية وبحرية وجوية منسقة ومنظمة لغرض الغزو)\nمثال: نظم ماك آرثر إنزالاً برمجياً ضخماً خلف خطوط العدو",
 "amphibious operation": "عملية برمائية (عملية عسكرية تقوم بها قوات برية وبحرية)",
 "amphibious vehicle": "مركبة برمائية (مركبة آلية مسطحة القاع يمكنها السفر على الأرض أو الماء)",
 "amphibole": "أمفيبول (معدن أو نوع معدني ينتمي إلى مجموعة الأمفيبول)",
 "amphibole group": "مجموعة الأمفيبول (مجموعة من المعادن ذات هياكل بلورية متشابهة تحتوي على سلسلة سيليكات ومجموعات من الصوديوم والكالسيوم والمغنيسيوم والحديد والألمنيوم بشكل أساسي)",
 "amphibolite": "أمفيبوليت (صخر متحول يتكون أساساً من الأمفيبول والبلاجيوكلاز)",
 "amphibology": "إبهام تركيبي, التباس نحوي (تركيب نحوي غامض يحمل أكثر من معنى)",
 "amphiboly": "إبهام تركيبي, التباس نحوي (تركيب نحوي غامض يحمل أكثر من معنى)",
 "amphibrach": "تفعيلة أمفيبراخ, تفعيلة قصيرة-طويلة-قصيرة (وحدة مترية بمقاطع غير مشددة-مشددة-غير مشددة)",
 "amphicarpa bracteata": "فول الخنزير, فول سوداني بري (كرمة واسعة الانتشار في شرق أمريكا الشمالية تنتج عناقيد من الزهور الأرجوانية إلى المارونية وقروناً وفيرة (تحت الأرض عادة) صالحة للأكل ذات بذرة واحدة…)",
 "amphicarpaea bracteata": "فول الخنزير, فول سوداني بري (كرمة واسعة الانتشار في شرق أمريكا الشمالية تنتج عناقيد من الزهور الأرجوانية إلى المارونية وقروناً وفيرة (تحت الأرض عادة) صالحة للأكل ذات بذرة واحدة…)",
 "amphictyony": "أمفيكتيوني, رابطة دينية (رابطة الدول أو القبائل المجاورة في اليونان القديمة؛ أنشئت في الأصل للدفاع عن مركز ديني مشترك)",
 "amphidiploid": "مزدوج الصيغة الصبغية المزدوج ((في علم الوراثة) كائن أو خلية تحتوي على مجموعة مزدوجة الصيغة الصبغية من الكروموسومات من كل والد)",
 "amphidiploidy": "ثنائية الضعفانية (حالة كون الكائن ثنائي الضعفانية)",
 "amphigory": "كِتَابَة بِلَا مَعْنًى, هُرَاء شِعْرِيّ (كتابة لا معنى لها (عادة شعر))",
 "amphimixis": "إخصاب مختلط, تمازج الأمشاج (اتحاد الحيوان المنوي والبويضة في التكاثر الجنسي) / تكاثر جنسي (تكاثر يتضمن اتحاد أو اندماج مشيج ذكري وأنثوي)",
 "amphioxus": "رميح, سهيم (حيوان بحري صغير شفاف يشبه المشرط يحفر في الرمل؛ سلف بدائي للفقاريات)",
 "amphipod": "مزدوجات الأرجل (نوع من القشريات لينة الدرقة)",
 "amphiprion percula": "سمكة المهرج, سمكة شقائق النعمان المهرجة (مصطلح شمولي لأي حيوان فقاري مائي خيشومي التنفس)\nمثال: سمكة ميناد ماتت",
 "amphiprostylar": "ذُو رِوَاقَيْن, مُتَعَدِّد الأَعْمِدَة (يتّسم بأعمدة حرّة في أروقة عند كلا الطرفين أو على كلا الجانبين)",
 "amphiprostyle": "ذُو رِوَاقَيْن, مُتَعَدِّد الأَعْمِدَة (يتّسم بأعمدة حرّة في أروقة عند كلا الطرفين أو على كلا الجانبين)",
 "amphiprotic": "أَمْفُوتِيرِيّ, مُتَرَدِّد (له خصائص كل من الحمض والقاعدة وقادر على التفاعل كأي منهما)",
 "amphisbaena": "أمفيسباينا, الثعبان ذو الرأسين ((الأساطير الكلاسيكية) ثعبان برأس في كل طرف من جسده)",
 "amphistylar": "ذُو رِوَاقَيْن, مُتَعَدِّد الأَعْمِدَة (يتّسم بأعمدة حرّة في أروقة عند كلا الطرفين أو على كلا الجانبين) / ثُنَائِيّ الأَعْمِدَة (ذو أعمدة عند كلا الطرفين أو على كلا الجانبين)",
 "amphitheater": "مدرج (ملعب بيضاوي كبير بصفوف مقاعد متدرجة؛ ساحة تقام فيها المسابقات والعروض) / مدرج (رواق مائل بمقاعد للمشاهدين (كما في غرفة العمليات أو المسرح))",
 "amphitheatre": "مُدَرَّج",
 "amphitheatric": "مدرجي (من أو متعلق بالمدرج الروماني)",
 "amphitheatrical": "مدرجي (من أو متعلق بالمدرج الروماني)",
 "amphitropous": "مستعرض البويضة ((عن بويضة النبات) مقلوبة جزئياً؛ منعطفة للخلف بزاوية 90 درجة على سويقتها)",
 "amphitropous ovule": "بويضة نصف منعكسة (بويضة مقلوبة جزئياً تميل للخلف بمقدار 90 درجة على عنقها)",
 "amphiuma": "أمفيوما (سمندل مائي يشبه الثعبان له زوجان من الأقدام الصغيرة جداً؛ من المياه الطينية الراكدة في جنوب الولايات المتحدة)",
 "ampholyte": "إلكتروليت أمفوتيري, مادة مترددة",
 "amphora": "أمفورا, جرة إغريقية (جرة قديمة بمقبضين وعنق ضيق؛ استخدمت لحفظ الزيت أو النبيذ)",
 "amphoric": "جراتي, جرة (الصوت المسموع عند التسمع والذي يشبه الصوت الأجوف الناتج عن النفخ عبر فوهة زجاجة)\nمثال: يشير التنفس الجراتي إلى وجود تجويف في الرئة",
 "amphoteric": "أَمْفُوتِيرِيّ, مُتَرَدِّد (له خصائص كل من الحمض والقاعدة وقادر على التفاعل كأي منهما)",
 "amphoteric electrolyte": "إلكتروليت أمفوتيري, مادة مترددة",
 "amphotericin": "أمفوتيريسين (مضاد حيوي وعامل مضاد للفطريات)",
 "ampicillin": "أمبيسيلين (بنسلين شبه صناعي (الأسماء التجارية برينسيبين وبوليسيلين وغيرها))",
 "ample": "سَخِيّ, غَزِير (يُوفِّر إمدادًا وافرًا وغزيرًا) / فَسِيح, كَافٍ (أكثر من كافٍ في الحجم أو النطاق أو السعة) / لَا بَأْسَ بِهِ, وَافِر (كبير نوعاً ما في الحجم)\nمثال: كان لديه طعام وفير للحفلة",
 "ampleness": "سعة, ضخامة (خاصية الكبر المثير للإعجاب في الحجم) / سعة, وفرة (خاصية كون الشيء أكثر من كافٍ؛ الكفاية المريحة)\nمثال: أُعجب بسعة أبعادها",
 "amplexicaul leaf": "ورقة معانقة (ورقة تحتضن قاعدتها الساق)",
 "amplification": "تضخيم ((إلكترونيات) عملية زيادة الجهد أو الطاقة أو التيار) / تفصيل, توضيح (إضافة مواد إضافية أو توضيح أو تفاصيل شارحة) / تضخيم, كسب (مقدار الزيادة في طاقة الإشارة أو الجهد أو التيار معبراً عنه كنسبة المخرجات إلى المدخلات)\nمثال: بضع ملاحظات أضيفت كتوضيح ودفاع",
 "amplifier": "مضخم إلكتروني",
 "amplitude": "سعة, مدى (عِظَم المقدار) / جود, سعة (خاصية الوفرة الغزيرة) / سعة ((في الفيزياء) أقصى إزاحة لموجة دورية)",
 "amplitude distortion": "تشويه السعة, تشويه غير خطي (تشويه يحدث عندما لا تكون إشارة الخرج ذات علاقة خطية بإشارة الدخل)",
 "amplitude level": "مستوى السعة (المستوى على مقياس السعة)",
 "amplitude modulation": "تضمين السعة (تضمين سعة الموجة الحاملة (للراديو))",
 "amply": "بشكل واف, تماماً (بشكل كاف؛ أكثر من ملائم) / بثراء, بشكل وافٍ (لدرجة وفيرة أو بطريقة وافية)\nمثال: الأدلة تؤكد شكوكنا بشكل واف",
 "ampoule": "أَمْبُولَة",
 "ampul": "أمبولة, قارورة صغيرة (زجاجة صغيرة تحتوي على دواء (خاصة حاوية معقمة ومحكمة الغلق للحقن))",
 "ampule": "أمبولة, قارورة صغيرة (زجاجة صغيرة تحتوي على دواء (خاصة حاوية معقمة ومحكمة الغلق للحقن))",
 "ampulla": "أمبولا, قنينة رومانية (قارورة لها مقبضان؛ استخدمها الرومان للنبيذ أو الزيوت) / أمبولة, انتفاخ قاروري (الجزء المتوسع من قناة أو مجرى خاصة القنوات الهلالية للأذن)",
 "ampullar": "أمبولي, قنيني (من أو متعلق بالأمبولة (توسع في قناة))",
 "ampullary": "أمبولي, قنيني (من أو متعلق بالأمبولة (توسع في قناة))",
 "amputate": "بَتَرَ (بَتَرَهُ بَتْرًا: قطع مستأصِلاً. و- العمل ونحوَه: قطعه قبل أن يُتمُّه، فهو باتِر؛ بَتير بَتَرٌا: انقطع، فهو أبْتَرُ، وهي بَتْراء. (ج) بُتْرٌّ)\nمثال: كان يجب بتر ذراع توم.",
 "amputation": "بَتْر, قَطْع (بَتَرَهُ بَتْرًا: قطع مستأصِلاً. و- العمل ونحوَه: قطعه قبل أن يُتمُّه، فهو باتِر؛ بَتير بَتَرٌا: انقطع، فهو أبْتَرُ، وهي بَتْراء. (ج) بُتْرٌّ)\nمثال: كان يجب بتر ذراع توم.",
 "amputator": "جراح بتر (جراح يقوم بإزالة جزء أو كل الطرف)",
 "amputee": "أَبْتَر, أَقْطَع ((أَبْتَرَه) بَتَرَه؛ (أَبْتَرَ) الله فلَاناً: أعقَمَه)",
 "amramites": "سورة آل عمران",
 "amrinone": "أمرينون, إينوكور (دواء (الاسم التجاري إينوكور) يستخدم عن طريق الوريد في حالات فشل القلب؛ يزيد من قوة انقباض عضلة القلب)",
 "amsinckia grandiflora": "أمسينكيا كبيرة الزهر, عنق الكمان كبير الزهر (نبات حولي في غرب الولايات المتحدة له سنابل زهرية كبيرة ملفوفة؛ نوع مهدد بالانقراض)",
 "amsinckia intermedia": "أمسينكيا شائعة (نبات حولي في غرب الولايات المتحدة بسنابل ملفوفة من الزهور الصفراء البرتقالية)",
 "amsler grid": "شبكة آمسلر (نمط من المربعات الصغيرة يستخدم للمراقبة الذاتية من قبل المرضى الذين يعانون من الضمور البقعي المرتبط بالعمر)",
 "amsonia tabernaemontana": "أمسونيا, نجمة زرقاء (شجيرات فرعية في جنوب شرق الولايات المتحدة تشكل كتل بطيئة النمو ولها زهور زرقاء في سيمات طرفية قصيرة)",
 "amstelveen": "أمستلفين",
 "amsterdam": "أَمْسْتِرْدَام",
 "amu darya": "جَيْحُون, جِيحُون",
 "amuck": "مُسْتَشِيط, هَائِج (في حالة هياج عنيف وخارج عن السيطرة) / بِهَيَجَان قَاتِل (في نوبة قتل جنونية) / بِجُنُون, بِلَا ضَابِط (بشكل وحشي؛ بدون ضبط للنفس)\nمثال: مشاغبون يركضون بهيجان ويلقون العصي والزجاجات والحجارة",
 "amulet": "تَمِيمَة, أُخْذَة",
 "amun": "آمُون",
 "amur": "آمُور",
 "amur privet": "تمرحنة آمور (شجيرة شرق آسيوية تُزرع خاصة لأوراقها المستمرة)",
 "amurca": "مَاء الزَّيْتُون, دُرْدِيّ (السائل الشفاف المعروف الذي تنشأ به الحياة، عديم اللون والرائحة والطعم عندما يكون نقيا؛ علميا فِي : جزيئة متكونة من ذرتي هيدروجين مرتبطين بذرة واحدة من الأوكسيجين)\nمثال: أنا أشرب الماء.",
 "amusd": "دكتوراه في الفنون الموسيقية (درجة الدكتوراه في الفنون الموسيقية)",
 "amused": "مُسْتَمْتِع, مُنْشَغِل بِلَذَّة (مشغول بشكل ممتع وسارّ)",
 "amusement": "تَسْلِيَة",
 "amusement arcade": "صالة ألعاب (رواق يضم آلات ألعاب تعمل بالعملات المعدنية)",
 "amusement park": "مَدِينَة تَرْفِيهِيَّة, مَدِينَة الْمَلْهَى",
 "amusing": "مُمْتِع",
 "amusingly": "بشكل مسلٍ, بشكل ممتع (بطريقة مسلية وممتعة)\nمثال: هوليوود أصبحت معقدة للغاية لدرجة أنها لا تنتج أي شيء سيء بشكل مسلٍ حقاً هذه الأيام",
 "amusive": "مُضْحِك, مُلَهٍّ (يوفر المتعة والتسلية بشكل لطيف)",
 "amygdala": "لوزة دماغية (بنية عصبية لوزية الشكل في الجزء الأمامي من الفص الصدغي للمخ؛ مرتبطة ارتباطاً وثيقاً بالوطاء والحصين والتلفيف الحزامي؛ وتلعب دوراً مهماً في الدافع…)",
 "amygdaliform": "لَوْزِيُّ الشَّكْلِ, لَوْزِيّ (ذو شكل يشبه حبّة اللوز)",
 "amygdalin": "أميغدالين (غليكوزيد سيانوجيني مر يُستخرج من بذور المشمش والبرقوق واللوز المر)",
 "amygdaline": "لوزي (متعلق بـ أو يشبه اللوز)",
 "amygdaloid": "لَوْزِيُّ الشَّكْلِ, لَوْزِيّ (ذو شكل يشبه حبّة اللوز) / أميجدالويد, لوزية (صخر بركاني أصبحت فيه التجاويف المستديرة التي شكلها الغاز المتمدد مملوءة لاحقاً برواسب معدنية)",
 "amygdaloid nucleus": "لوزة دماغية (بنية عصبية لوزية الشكل في الجزء الأمامي من الفص الصدغي للمخ؛ مرتبطة ارتباطاً وثيقاً بالوطاء والحصين والتلفيف الحزامي؛ وتلعب دوراً مهماً في الدافع…)",
 "amygdaloidal": "لَوْزِيُّ الشَّكْلِ, لَوْزِيّ (ذو شكل يشبه حبّة اللوز)",
 "amygdalotomy": "بضع اللوزة (جراحة نفسية يتم فيها قطع ألياف اللوزة الدماغية التي تتوسط نشاط الجهاز الحوفي (في حالات العنف الشديد غير القابل للسيطرة))",
 "amygdalus communis": "لوز, لوز حلو (شجرة نفضية شجيرية صغيرة موطنها آسيا وشمال أفريقيا لها أزهار وردية جميلة ومكسرات صالحة للأكل ذات قيمة عالية محاطة بقشرة خضراء صلبة؛ تزرع في جنوب…)",
 "amygdalus communis amara": "لوز مر (أشجار لوز لها أزهار بيضاء ومكسرات سامة تنتج زيتاً يستخدم للنكهة ولأغراض طبية)",
 "amyl": "أميل (شق هيدروكربوني يوجد في العديد من المركبات العضوية)",
 "amyl alcohol": "كحول الأميل (خليط من 2 أو أكثر من الكحولات المتصاوغة؛ يستخدم كمذيب وفي التخليق العضوي)",
 "amyl nitrite": "نترات الأميل (موسع للأوعية الدموية يستخدم أحياناً لعلاج الذبحة الصدرية)",
 "amylaceous": "شَبِيه بِالنَّشَا, نَشَوِيّ الشَّكْل (يشبه النشا في مظهره أو خصائصه)",
 "amylase": "أميلاز (أي من مجموعة البروتينات الموجودة في اللعاب وعصير البنكرياس وأجزاء من النباتات؛ تساعد في تحويل النشا إلى سكر)",
 "amyloid": "شَبِيه بِالنَّشَا, نَشَوِيّ الشَّكْل (يشبه النشا في مظهره أو خصائصه) / أميلويد, نشواني ((علم الأمراض) بروتين معقد شمعي شفاف يشبه النشا وينتج عن تنكس الأنسجة) / نشاء (مادة غذائية غير نيتروجينية تتكون أساساً من النشا؛ أي مادة تشبه النشا)",
 "amyloid plaque": "لويحة أميلويد (لويحة تتكون من تشابك بروتين الأميلويد في الأنسجة العصبية (علامة مرضية لمرض الزهايمر))",
 "amyloid protein plaque": "لويحة أميلويد (لويحة تتكون من تشابك بروتين الأميلويد في الأنسجة العصبية (علامة مرضية لمرض الزهايمر))",
 "amyloidal": "شَبِيه بِالنَّشَا, نَشَوِيّ الشَّكْل (يشبه النشا في مظهره أو خصائصه)",
 "amyloidosis": "داء النشواني (اضطراب يتميز بترسب الأميلويد (النشواني) في الأعضاء أو الأنسجة؛ غالباً ما يكون ثانوياً لالتهاب المفاصل الروماتويدي المزمن أو السل أو الورم النقوي…)",
 "amylolysis": "تحلل النشا (تحول النشا إلى سكر)",
 "amylolytic": "حال للنشا (من أو متعلق بعملية تحلل النشا)",
 "amylum": "نشا (كربوهيدرات معقدة توجد بشكل رئيسي في البذور والفواكه والدرنات والجذور ولب سيقان النباتات، وخاصة في الذرة والبطاطس والقمح والأرز؛ وهي مادة غذائية مهمة…)",
 "amyotonia": "ارتخاء, فقدان التوتر العضلي (غياب التوتر العضلي الطبيعي)",
 "amyotrophia": "ضمور عضلي (هزال تدريجي للأنسجة العضلية)",
 "amyotrophic lateral sclerosis": "التَّصَلُّب الضُّمُورِي الْجَانِبِي",
 "amyotrophy": "ضمور عضلي (هزال تدريجي للأنسجة العضلية)",
 "amytal": "أموباربيتال الصوديوم, أميتال (ملح الصوديوم للأموباربيتال الذي يستخدم كباربيتورات؛ يستخدم كمهدئ ومنوم)",
 "amyxia": "عوز المخاط (حالة لا يتم فيها إنتاج المخاط)",
 "an": "مشارك في التمريض (درجة مشارك في التمريض)",
 "an apple a day keeps the doctor away": "تُفَّاحَةٌ وَاحِدَةٌ فِي الْيَوْمِ تُغْنِيكَ عَنْ زِيَارَةِ الطَّبِيبِ",
 "an eye for an eye, a tooth for a tooth": "الْعَيْن بِالْعَيْن وَالسِّنّ بِالسِّنّ",
 "ana": "طرائف, مختارات أدبية (مجموعة من الحكايات والنوادر عن شخص أو مكان)",
 "anabaptism": "أنابابتيست, تجديد العماد (حركة بروتستانتية في القرن السادس عشر آمنت بأولوية الكتاب المقدس، وعمدت المؤمنين فقط وليس الأطفال، وآمنت بالفصل التام بين الكنيسة والدولة)",
 "anabaptist": "أنابابتيست, تجديدي العماد (أحد أتباع مذهب تجديدية العماد)",
 "anabaptist denomination": "أنابابتيست, طائفة تجديدية العماد (طائفة بروتستانتية تنكر معمودية الرضع وتعمد المؤمنين فقط)",
 "anabas testudineus": "فرخ متسلق (فرخ صغير من الهند تحورت خياشيمه لتسمح له بتنفس الهواء؛ وله زعانف صدرية شوكية تمكنه من التنقل على الأرض)",
 "anabatic": "صَاعِد (لتيار هوائي أو رياح؛ يرتفع خاصة فوق منحدر)\nمثال: رياح صاعدة",
 "anabiosis": "إحياء, عودة الحياة (حيوية معلقة في الكائنات الحية خلال فترات الجفاف الشديد والتي تنتعش منها عند عودة الرطوبة)",
 "anabiotic": "إحيائي, متعلق بعودة الحياة (من أو متعلق بحالة الانتعاش (عودة الحياة بعد توقف ظاهري))",
 "anabolic": "بِنَائِيّ (يتميز بـ أو يعزز الأيض البنائي) / بنائي (من أو متعلق بمرحلة البناء في التمثيل الغذائي (الأيض))\nمثال: يتناول بعض الرياضيين المنشطات البنائية لزيادة حجم العضلات مؤقتاً",
 "anabolic steroid": "ستيرويد بنائي, منشط (أي من مجموعة الهرمونات الستيرويدية الاصطناعية التي تستخدم لتحفيز نمو العضلات والعظام؛ يستخدمها الرياضيون أحياناً بشكل غير قانوني لزيادة قوتهم)",
 "anabolism": "عَمَلِيَّة التَّمْثِيلِ الْغِذَائِي",
 "anabrus simplex": "صرصور المورمون (نطاط كبير داكن عديم الأجنحة يشبه الصرصور من المناطق القاحلة في غرب الولايات المتحدة)",
 "anacardium occidentale": "بلاذر, شجرة الكاجو (شجرة استوائية أمريكية دائمة الخضرة تحمل مكسرات كلوية الشكل لا تؤكل إلا محمصة)",
 "anachronic": "مُفَارِق لِزَمَانِه (في غير موضعه الزمني الصحيح)",
 "anachronism": "أداة لا تتناسب مع العصر, شيء في غير زمنه (غرض أو أداة تنتمي إلى زمن آخر غير الذي توجد فيه) / شَخْص مِن زَمَن آخَر, مُفَارَقَة تَارِيخِيَّة (شخص يبدو وكأنه في غير زمانه؛ ينتمي لعصر آخر) / خطأ في التوقيت, مفارقة تاريخية (شيء يقع في وقت لم يكن من الممكن أن يوجد أو يحدث فيه)",
 "anachronistic": "مُفَارِق لِزَمَانِه (في غير موضعه الزمني الصحيح)",
 "anachronistically": "بِشَكْل مُفَارِق لِلزَّمَن, خَارِج السِّيَاق الزَّمَنِيّ (بطريقة لا تتناسب مع الفترة الزمنية الحالية أو المقصودة)\nمثال: دعونا ننظر إلى هذه الظاهرة بمفارقة زمنية",
 "anachronous": "مُفَارِق لِزَمَانِه (في غير موضعه الزمني الصحيح)",
 "anacin iii": "أسيتامينوفين, باراسيتامول (مسكن للألم الخفيف ولكن ليس للالتهابات؛ يستخدم أيضاً كخافض للحرارة (تايلينول وبانادول وغيرها هي علامات تجارية لأقراص الأسيتامينوفين))",
 "anaclinal": "عَكْسِيّ الاِنْحِدَار (للوديان والأنهار؛ تتقدم في اتجاه معاكس للميل في طبقات الصخور المحيطة)",
 "anaclisis": "اتكالية, اعتماد عاطفي ((التحليل النفسي) علاقة تتميز بالاعتماد القوي على الآخرين؛ خاصة التعلق الليبيدي بشخصية مثل الوالدين)",
 "anaclitic": "اتكالي, اعتمادي (من أو متعلق بالعلاقات التي تتميز بالاعتماد القوي لشخص على آخر)",
 "anaclitic depression": "اكتئاب اتكالي (اكتئاب شديد وتدريجي عند الرضع الذين يفقدون أمهاتهم ولا يحصلون على بديل مناسب)",
 "anacoluthia": "انقطاع التسلسل, تنافر تركيبي (تغيير مفاجئ داخل الجملة من بنية نحوية إلى أخرى)",
 "anacoluthic": "انقطاعي, غير مترابط نحوياً (من أو متعلق بالتناقضات النحوية من النوع المعروف باسم الانقطاع (أناكولوثون))",
 "anacoluthon": "انقطاع التسلسل, تنافر تركيبي (تغيير مفاجئ داخل الجملة من بنية نحوية إلى أخرى)",
 "anaconda": "أَنَاكُنْدَة",
 "anacyclus pyrethrum": "عاقر قرحا, قحوان إسباني (نبات متوسطي صغير يحتوي على زيت طيار كان يستخدم سابقاً لتخفيف وجع الأسنان)",
 "anadama bread": "خبز أناداما (خبز مخمر بالخميرة مصنوع من الدقيق الأبيض ودقيق الذرة والدبس)",
 "anadenanthera colubrina": "أنا دي نانت هيرا, أنتان (شجيرة برازيلية ذات أوراق ثنائية الريش وأزهار سنبلية صغيرة تليها قرون مسطحة أو ملتوية بشكل غير منتظم)",
 "anadiplosis": "تكرار استهلالي, تكرار الكلمة الأخيرة (تكرار الكلمات الأخيرة من جملة أو سطر في بداية الجملة التالية)",
 "anadromous": "نَهْرِيُّ السَّرْءِ / نَهْرِيَّةُ السَّرْءِ",
 "anadyr": "أَنَادِير",
 "anaemia": "أنيميا, فقر الدم (نقص في خلايا الدم الحمراء) / أنيميا, فقر الدم (نقص في الحيوية (مجازياً))",
 "anaemic": "فَاقِد الحَيَوِيَّة, هَزِيل (يفتقر إلى النشاط والطاقة) / أنيمي, فقر دمي (يتعلق بفقر الدم أو يعاني منه)",
 "anaerobe": "لاهوائي (كائن (خاصة بكتيريا) لا يحتاج إلى الهواء أو الأكسجين الحر ليعيش)",
 "anaerobic": "لَا هَوَائِيّ (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: لا أحب المدرسة.",
 "anaerobic exercise": "بناء العضلات, تمرين لاهوائي (تمرين يبني العضلات من خلال التوتر والمقاومة)",
 "anaerobiotic": "لَاهَوَائِيّ (يعيش أو ينشط في غياب الأكسجين الحر)\nمثال: بكتيريا لاهوائية",
 "anaesthesia": "تخدير (فقدان الإحساس الجسدي مع أو بدون فقدان الوعي)",
 "anaesthetic": "بنج, مخدر (عقار يسبب فقدان مؤقت للإحساس الجسدي) / تخديري, مخدر (يتعلق بالتخدير أو يسبب فقدان الإحساس)",
 "anaesthetic agent": "بنج, مخدر (عقار يسبب فقدان مؤقت للإحساس الجسدي)",
 "anaesthetist": "أخصائي تخدير, طبيب تخدير (أخصائي يقوم بإعطاء المخدر للمريض قبل العلاج)",
 "anagallis arvensis": "أناغالس حقلي, زهرة الطقس (عشبة ذات أزهار قرمزية أو بيضاء أو أرجوانية تغلق عند اقتراب الطقس الممطر)",
 "anagallis tenella": "أناغالس المستنقع (عشبة أوروبية زاحفة صغيرة ذات أزهار وردية دقيقة)",
 "anagasta kuehniella": "عثة دقيق البحر المتوسط (عثة صغيرة تتلف يرقاتها الحبوب والدقيق المخزن)",
 "anagen": "طور التنامي",
 "anaglyph": "أناغليف, نقش بارز منخفض (أي شيء منحوت بنقش بارز منخفض) / أناغليف, صورة مجسمة متباينة الألوان (صور متحركة أو ثابتة بألوان متباينة تبدو ثلاثية الأبعاد عند تراكبها)",
 "anaglyphic": "أناغليفي, بارز النقش (متعلق بالصور المجسمة (أناغليف) أو فن النحت البارز)",
 "anaglyphical": "أناغليفي, بارز النقش (متعلق بالصور المجسمة (أناغليف) أو فن النحت البارز)",
 "anaglyphy": "تصوير مجسم, نقش بارز (عملية إنتاج صور بألوان متباينة تبدو ثلاثية الأبعاد عند تركيبها ومشاهدتها من خلال نظارات بعدسة حمراء وأخرى خضراء)",
 "anaglyptic": "أناغليفي, بارز النقش (متعلق بالصور المجسمة (أناغليف) أو فن النحت البارز)",
 "anaglyptical": "أناغليفي, بارز النقش (متعلق بالصور المجسمة (أناغليف) أو فن النحت البارز)",
 "anagnost": "قارئ (رجل دين في الرتب الصغرى للكنيسة الأرثوذكسية الشرقية يقرأ الدروس بصوت عالٍ في الليتورجيا (يقابله القارئ في الكنيسة الكاثوليكية))",
 "anagoge": "تأويل صوفي, تفسير مجازي (تفسير صوفي أو رمزي (خاصة للكتاب المقدس))",
 "anagogic": "تأويلي صوفي, تصعيدي (مبني على أو يمثل التفسير الروحي أو الصوفي للنصوص)",
