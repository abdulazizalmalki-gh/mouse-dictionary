 "antares": "قَلْب الْعَقْرَب",
 "antbird": "طائر النمل (أي من الطيور المتنوعة باهتة اللون في أمريكا الجنوبية التي تتغذى على النمل وبعضها يتبع أسراب النمل الجيش)",
 "ante": "رهان أولي ((بوكر) المساهمة الأولية التي يقدمها كل لاعب في مجموع الرهان)",
 "ante meridiem": "صَبَاحًا, قَبْل الظُّهْر (قبل الساعة 12 ظهراً)\nمثال: لنلتقي في الساعة 11 صباحاً",
 "anteater": "آكَل النَّمْل (أكل معه؛ آكَلَه الشيءَ: أَطعمه إِياه)\nمثال: لا آكل الفواكه.",
 "antebellum": "مَا قَبْلَ الحَرْب (يَنْتَمِي إِلَى فَتْرَةٍ سَابِقَةٍ لِلحَرْبِ خَاصَّةً الحَرْبِ الأَهْلِيَّةِ الأَمْرِيكِيَّة)",
 "antecedence": "أسبقية, أولوية (السبق في الزمن)",
 "antecedency": "أسبقية, أولوية (السبق في الزمن)",
 "antecedent": "سَابِق (يسبق في الوقت أو الترتيب) / سَابِق (مرجع الجناس؛ عبارة أو جملة يشار إليها بضمير عائد) / سابقة, مقدمة (حدث أو سبب أو واقعة سابقة) / جد, سلف (شخص تنحدر منه (لكنه عادة أبعد من الجد))",
 "antecedently": "سابقاً, فيما سبق (في وقت سابق أو قديماً)\nمثال: كانت تعيش سابقاً في شيكاغو",
 "antechamber": "غُرْفَة الاِنْتِظَار (اسم مفعول لما غُرِفَ من الماء وغيره باليد، الجمع غِرَاف؛ اسم؛ المكان في الدار أو المبنى محاط بأربع جدران وسقف، حُجْرَة، عِلِّيَّة. الجمع وغُرَف وغُرُفَات)\nمثال: الأب في الغرفة.",
 "antecubital": "أمام المرفق (من أو متعلق بمنطقة الذراع أمام المرفق)\nمثال: سُحب الدم من المنطقة أمام المرفق",
 "antediluvial": "ما قبل الطوفان (متعلق بالفترة التي سبقت الطوفان التوراتي)\nمثال: إنسان ما قبل الطوفان",
 "antediluvian": "أَثَرِيّ, بَائِد (بالغ القِدَم لدرجة يبدو معها منتمياً إلى حقبة سابقة) / ما قبل الطوفان (متعلق بالفترة التي سبقت الطوفان التوراتي) / طاعن في السن, معمر (شخص كبير جداً في السن) / ما قبل الطوفان (أي من البطاركة الأوائل الذين عاشوا قبل طوفان نوح)\nمثال: إنسان ما قبل الطوفان",
 "antediluvian patriarch": "ما قبل الطوفان (أي من البطاركة الأوائل الذين عاشوا قبل طوفان نوح)",
 "antefix": "زخرفة طرفية (حلية منحوتة عند حواف السقف القرميدي لإخفاء المفاصل بين القرميد)",
 "antelope": "ظَبْي (الغَزَال ذو القُرُون الحادة، سمي ظبيا لأن قِرْنه يَظْبِي أي يجرح)\nمثال: أبو ظبي هي عاصمة الإمارات العربية المتحدة.",
 "antelope chipmunk": "سنجاب الظبي (سنجاب أرضي صغير من غرب الولايات المتحدة)",
 "antelope squirrel": "سنجاب الظبي (سنجاب أرضي صغير من غرب الولايات المتحدة)",
 "antemeridian": "صَبَاحِيّ, قَبْل الظُّهْر (قبل الظهر)",
 "antemortem": "قَبْل المَوْت (يسبق الموت)\nمثال: اعتراف قبل الموت",
 "antenatal": "قَبْل الوِلَادَة (يحدث أو يوجد قبل الولادة)\nمثال: فترة ما قبل الولادة",
 "antenna": "قَرْن اِسْتِشْعَار, زُبَانَى (مصدر للفعل قَرَنَ؛ القوم يعيشون سوية فترة طويلة جذا من الزمن، أو هو الفترة الطويلة من الزمن بدون تحديد عدد السنين)\nمثال: هذه الشجرة عمرها أكثر من قرن.",
 "antennal": "قرني الاستشعار, هوائي (من أو متعلق بقرون الاستشعار (الهوائيات))\nمثال: الحواس في قرون الاستشعار للحشرات",
 "antennaria dioica": "رجل القط, هوضل (عشب معمر منخفض النمو له أوراق ذات زغب مبيض وعناقيد من الزهور البيضاء الصغيرة)",
 "antennaria plantaginifolia": "تبغ الستات, رجل القط الموزية (نبات معمر من أمريكا الشمالية يتكاثر عن طريق السيقان الجارية (المدادات))",
 "antennary": "قرني الاستشعار, هوائي (من أو متعلق بقرون الاستشعار (الهوائيات))\nمثال: الحواس في قرون الاستشعار للحشرات",
 "antenuptial": "ما قبل الزواج (يتعلق بالأحداث التي تسبق الزواج)\nمثال: اتفاق ما قبل الزواج",
 "antepartum": "قَبْل الوِلَادَة (يحدث أو يوجد قبل الولادة)\nمثال: فترة ما قبل الولادة",
 "antepenult": "المقطع قبل قبل الأخير (المقطع الثالث من الكلمة بالعد من النهاية)",
 "antepenultima": "المقطع قبل قبل الأخير (المقطع الثالث من الكلمة بالعد من النهاية)",
 "antepenultimate": "ثَالِثٌ مِنَ النِّهَايَة (الثَّالِثُ مِنَ الآخِرِ فِي تَرْتِيبِ سِلْسِلَةٍ) / المقطع قبل قبل الأخير (المقطع الثالث من الكلمة بالعد من النهاية)",
 "anterior": "أَمَامِيّ",
 "anterior cardinal vein": "وريد رئيسي أمامي (قناة تصريف رئيسية من الجزء الرأسي للجسم)",
 "anterior cerebral artery": "شريان مخي أمامي (أحد فرعي الشريان السباتي الباطن؛ ينقسم إلى فرعين يخدمان (1) المهاد و (2) أجزاء من القشرة الجبهية والجدارية)",
 "anterior cerebral vein": "وريد مخي أمامي (يرافق الشريان المخي الأمامي ويصب في الوريد القاعدي)",
 "anterior crural nerve": "عصب فخذي (أحد زوجين من الأعصاب التي تنشأ من الأعصاب القطنية وتغذي العضلات والجلد في الجزء الأمامي من الفخذ)",
 "anterior facial vein": "وريد وجهي أمامي (استمرار للوريد الزاوي؛ يتحد مع الوريد خلف الفك السفلي قبل أن يصب في الوريد الوداجي الباطن)",
 "anterior fontanelle": "يافوخ أمامي (يقابل البريغما عند تعظم العظام)",
 "anterior horn": "جذر أمامي, جذر بطني (أحد جذري العصب الشوكي الذي يمر بطنياً من الحبل الشوكي ويتكون من ألياف حركية)",
 "anterior jugular vein": "وريد وداجي أمامي (ينشأ أسفل الذقن من أوردة تصرف الوجه السفلي؛ ينضم إلى الوريد الوداجي الظاهر)",
 "anterior labial veins": "أوردة شفرية أمامية (أوردة من الشفرين الكبيرين إلى الوريد الفروجي الخارجي)",
 "anterior meningeal artery": "شريان سحائي أمامي (فرع من الشريان الغربالي الأمامي يغذي السحايا في الحفرة القحفية الأمامية)",
 "anterior naris": "منخر أمامي (أي من الفتحتين الخارجيتين للتجويف الأنفي في الأنف)",
 "anterior pituitary": "غدة نخامية أمامية, نخامية أمامية (الفص الأمامي للغدة النخامية؛ ذو طبيعة غدية في المقام الأول)",
 "anterior pituitary gland": "غدة نخامية أمامية, نخامية أمامية (الفص الأمامي للغدة النخامية؛ ذو طبيعة غدية في المقام الأول)",
 "anterior root": "جذر أمامي, جذر بطني (أحد جذري العصب الشوكي الذي يمر بطنياً من الحبل الشوكي ويتكون من ألياف حركية)",
 "anterior serratus muscle": "منشارية أمامية (عضلات تدير لوح الكتف وترفع القفص الصدري)",
 "anterior synechia": "التصاق أمامي (التصاق بين القزحية والقرنية)",
 "anterior temporal artery": "شريان صدغي أمامي (شريان صدغي يذهب إلى الجزء الأمامي من القشرة المخية للفص الصدغي)",
 "anterior vertebral vein": "وريد فقري أمامي (وريد يرافق الشريان العنقي الصاعد ويصب في الوريد الفقري)",
 "anteriority": "أسبقية, أولوية (السبق في الزمن) / أَمَامِيَّة, تَقَدُّم (صفة الوجود في المقدمة أو (في الحيوانات الدنيا) باتجاه الرأس)",
 "anteriorly": "أَمَامِيًّا (في اتجاه أمامي)",
 "anterograde": "تَقَدُّمِيّ (فقدان ذاكرة) (لفقدان الذاكرة؛ يؤثر على الوقت الذي يلي الصدمة مباشرة)",
 "anterograde amnesia": "فقدان الذاكرة التقدمي, نسيان تقدمي (فقدان الذاكرة للأحداث التي تلي الصدمة مباشرة؛ وأحياناً يسري على الأحداث أثناء الصدمة ولفترة طويلة بعدها)",
 "anteroom": "بهو, ردهة (مدخل كبير أو غرفة استقبال أو منطقة استقبال)",
 "anthelminthic": "طارِد لِلدِّيدان, مُبيد لِلطُّفَيْلِيّات (يَقْتُل الدِّيدان والطُّفَيْلِيّات المِعَوِيَّة) / طارد للديدان (دواء قادر على التسبب في إخلاء الديدان المعوية الطفيلية)",
 "anthelmintic": "طارِد لِلدِّيدان, مُبيد لِلطُّفَيْلِيّات (يَقْتُل الدِّيدان والطُّفَيْلِيّات المِعَوِيَّة) / طارد للديدان (دواء قادر على التسبب في إخلاء الديدان المعوية الطفيلية)",
 "anthem": "نَشِيد, نَشِيد وَطَنِيّ",
 "anthem trance": "أبليفتنغ ترانس, ترانس حماسي (نوع فرعي كبير من موسيقى الترانس، سمي بذلك للشعور الذي يدعي المستمعون الحصول عليه (يوصف غالباً بـ 'الاندفاع'))",
 "anthemis arvensis": "أقحوان الحقول, بابونج الحقول (عشبة أوروبية بيضاء الزهور متوطنة في أمريكا الشمالية)",
 "anthemis cotula": "أقحوان نتن, شمر الكلاب (عشبة ضارة واسعة الانتشار كريهة الرائحة ذات رؤوس زهور بيضاء الأشعة بأقراص صفراء)",
 "anthemis nobilis": "بابونج, بابونج روماني",
 "anthemis tinctoria": "أقحوان الصباغين, بابونج أصفر (عشبة أوراسية معمرة بأوراق مقسمة مشعرة وزهور صفراء؛ متوطنة في أمريكا الشمالية)",
 "anther": "مِئْبَر",
 "antheraea mylitta": "عثة التوسا (عثة شرقية تنتج حريراً بنياً)",
 "antheraea pernyi": "عثة بيرني (عثة صينية تنتج حريراً بنياً)",
 "antheraea polyphemus": "عثة بوليفيموس (عثة دودة قز أمريكية كبيرة جداً بنية مصفرة ببقع عينية كبيرة على الأجنحة الخلفية؛ تتغذى اليرقات على أشجار الفاكهة والظل)",
 "antheral": "سَدَائِيّ, مُذَكَّر (قادر على تلقيح الأعضاء الأنثوية)",
 "anthericum liliago": "زنبق القديس برنارد (نبات من جنوب أوروبا يزرع عادة لسنابله من الزهور البيضاء المخضرة الصغيرة الشبيهة بالنجوم)",
 "anthericum torreyi": "زنبق العنبر (نبات ذو أوراق قاعدية تشبه العشب وعنقود مفتوح ضيق من الزهور البرتقالية المصفرة الشبيهة بالنجوم فوق ساق عديم الأوراق؛ جنوب غرب الولايات المتحدة؛ النوع…)",
 "antheridial": "مئبري (يتعلق بـ أو يتميز بوجود المئبر (عضو التذكير في النباتات))",
 "antheridiophore": "حامل المئبرية (حامل أمشاج يحمل مئبريات كما في بعض الحزازيات وحشيشة الكبد)",
 "antheridium": "مئبرية, معفر (العضو الجنسي الذكري للنباتات المنتجة للأبواغ؛ ينتج الحيوانات المنوية النباتية؛ يعادل المئبر في الزهور)",
 "antheropeas wallacei": "أقحوان صوفي, إريوفيلوم والاسي (نبات حولي صغير رمادي صوفي معنقد ذو رؤوس زهرية صفراء ذهبية صغيرة؛ جنوب شرق كاليفورنيا إلى شمال غرب أريزونا وجنوب غرب يوتا؛ يوضع أحياناً في جنس…)",
 "antherozoid": "حيوان منوي نباتي, مشيج ذكري متحرك (مشيج ذكري متحرك لنبات مثل الطحالب أو السرخس أو عاريات البذور)",
 "anthesis": "إزهار, تفتح الزهور (وقت وعملية تبرعم وتفتح الزهور)",
 "anthill": "مَسْكَن نَمْل (الموضع الذي يسكن فيه الإنسان بمعنى يُقيم؛ البَيْت أو الدار)\nمثال: كان دوري كي أنظف المسكن",
 "anthologist": "جامع المختارات (محرر يقوم باختيارات لمختارات أدبية)",
 "anthology": "تَجْمِيعَة, دِيوَان",
 "anthonomus grandis": "سوسة اللوز (سوسة رمادية تضع بيضها في لوز القطن وتدمر القطن)",
 "anthony": "أَنْتُونِيّ, أنطوني",
 "anthophagous": "آكِل الأَزْهَار, مُحِبّ الزُّهُور (يَتَغَذَّى عَلَى الأَزْهَار)",
 "anthophilous": "آكِل الأَزْهَار, مُحِبّ الزُّهُور (يَتَغَذَّى عَلَى الأَزْهَار)",
 "anthophyllite": "أنثوفيليت (معدن بني غامق من مجموعة الأمفيبول؛ سيليكات المغنيسيوم والحديد)",
 "anthozoan": "زهريات شعاعية (جوفمعويات بحرية لاطئة تشمل السلائل المنفردة والاستعمارية؛ يتم قمع مرحلة الميدوزا تماماً)",
 "anthracite": "أنتراسيت, فحم حجري صلب (فحم طبيعي صلب يحترق ببطء ويعطي حرارة شديدة)",
 "anthracite coal": "أنتراسيت, فحم حجري صلب (فحم طبيعي صلب يحترق ببطء ويعطي حرارة شديدة)",
 "anthracitic": "أنثراسايتي (يتعلق بـ أو يشبه فحم الأنثراسايت)",
 "anthracosis": "رئة سوداء, سحار فحم (مرض رئوي ناجم عن استنشاق غبار الفحم)",
 "anthrax": "جَمْرَة خَبِيثَة",
 "anthrax bacillus": "عصوية الجمرة الخبيثة (نوع من العصويات يسبب الجمرة الخبيثة في البشر والحيوانات (الماشية والخنازير والأغنام والأرانب والفئران وخنازير غينيا)؛ يمكن استخدامها سلاحاً بيولوجياً)",
 "anthrax pneumonia": "جمرة خبيثة رئوية (شكل من أشكال عدوى الجمرة الخبيثة المكتسبة عن طريق استنشاق الغبار المحتوي على البكتيريا)",
 "anthrenus scrophulariae": "خنفساء السجاد الجاموس (خنفساء سجاد صغيرة سوداء وحمراء وبيضاء)",
 "anthriscus cereifolium": "بقدونس إفرنجي, سرفيل (عشب حولي عطري من العالم القديم يزرع لأوراقه المقسمة بدقة والمجعدة غالباً للاستخدام خاصة في الحساء والسلطات)",
 "anthriscus sylvestris": "بقدونس البقر, سرفيل بري (عشب ثنائي الحول خشن قائم من العالم القديم أدخل كعشب ضار في شرق أمريكا الشمالية)",
 "anthropic": "إنساني, بشري (يتعلق بالبشرية أو فترة وجود الجنس البشري)",
 "anthropical": "إنساني, بشري (يتعلق بالبشرية أو فترة وجود الجنس البشري)",
 "anthropocentric": "متمركز حول الإنسان (يتمحور حول الإنسان)\nمثال: نظرتنا للعالم التي تتمركز حول الإنسان",
 "anthropocentricity": "مركزية بشرية (الميل لتقييم الواقع حصرياً من حيث القيم البشرية)",
 "anthropocentrism": "مركزية بشرية (الميل لتقييم الواقع حصرياً من حيث القيم البشرية)",
 "anthropogenesis": "نشوء الإنسان (تطور أو نشأة الجنس البشري)",
 "anthropogenetic": "أنثروبوجيني, نشوئي بشري (من أو متعلق بدراسة أصول وتطور البشر)",
 "anthropogenic": "أنثروبوجيني, نشوئي بشري (من أو متعلق بدراسة أصول وتطور البشر)",
 "anthropogeny": "نشوء الإنسان (تطور أو نشأة الجنس البشري)",
 "anthropoid": "شَبِيه بِالإِنْسَان (يُشبه البشر في الشكل أو الصفات) / شَبِيه بِالقُرُود, قِرْدِيّ (يُشبه القُرود) / شبيه الإنسان (أي عضو في رتيبة السعالي التي تشمل السعادين والقردة والبشر) / شبيه القرد (شخص يشبه الرئيسيات غير البشرية)",
 "anthropoid ape": "قرد شبيه بالإنسان, قرد عليا (أي قرد عديم الذيل من فصيلتي البونجيد والهيلوباتيد)",
 "anthropoidal": "شَبِيه بِالقُرُود, قِرْدِيّ (يُشبه القُرود)",
 "anthropolatry": "عبادة البشر (عبادة الكائنات البشرية)",
 "anthropological": "أنثروبولوجي (متعلق بعلم الإنسان (الأنثروبولوجيا))\nمثال: دراسات أنثروبولوجية",
 "anthropologism": "أنثروبولوجية, مذهب الإنسان (وجهة نظر تتحدد فيها الطبيعة البشرية بشكل شامل من خلال الثقافة التي يعيش فيها الشخص، مما لا يترك مجالاً للوكالة البشرية)",
 "anthropologist": "أنثروبولوجي, عالم أنثروبولوجيا (عالم اجتماعي متخصص في الأنثروبولوجيا)",
 "anthropology": "عِلْمُ الإِنْسَان, أَنْطْرُوبُولُوجْيَا (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "anthropology department": "قسم الأنثروبولوجيا, قسم علم الإنسان (القسم الأكاديمي المسؤول عن التدريس والبحث في علم الإنسان (الأنثروبولوجيا))",
 "anthropometric": "أنثروبومتري, قياسي بشري (من أو متعلق بالقياسات البشرية)",
 "anthropometrical": "أنثروبومتري, قياسي بشري (من أو متعلق بالقياسات البشرية)",
 "anthropometry": "أنثروبومترية, قياسات بشرية (قياس ودراسة جسم الإنسان وأجزائه وقدراته)",
 "anthropomorphic": "أَنْسَنِيّ, مُؤَنْسَن (يُضفي صفات بشرية على الحيوانات أو الجمادات)",
 "anthropomorphism": "تَجْسِيم",
 "anthropomorphous": "أَنْسَنِيّ, مُؤَنْسَن (يُضفي صفات بشرية على الحيوانات أو الجمادات)",
 "anthropopathism": "إضفاء المشاعر البشرية (عزو المشاعر البشرية إلى أشياء غير بشرية، مثل الجمادات أو الحيوانات أو الظواهر الطبيعية)",
 "anthropophagite": "آكل لحوم البشر (شخص يأكل اللحم البشري)",
 "anthropophagous": "آكل لحوم البشر (من أو متعلق بآكلي لحوم البشر)",
 "anthropophagus": "آكل لحوم البشر (شخص يأكل اللحم البشري)",
 "anthropophagy": "أكل لحوم البشر (أكل لحم الإنسان)",
 "anthroposophy": "أنثروبوصوفيا (نظام من المعتقدات والممارسات القائمة على فلسفة رودولف شتاينر؛ تدعي دمج الجوانب العملية والنفسية في التعليم المتمحور حول الطفل)",
 "anthurium": "أنتوريوم, زهرة الفلامنغو (أي من النباتات الأمريكية الاستوائية المتنوعة التي تُزرع لأوراقها وأزهارها المبهرجة)",
 "anthurium andraeanum": "أنتوريوم, زهرة الفلامنغو (نوع من الأنتوريوم يُزرع عادة وله قنابة وطلع قرمزي ساطع)",
 "anthurium scherzerianum": "أنتوريوم, زهرة الفلامنغو (نوع من الأنتوريوم يُزرع عادة وله قنابة وطلع قرمزي ساطع)",
 "anthus pratensis": "جشنة المروج (جشنة شائعة بنية من الأعلى وبيضاء من الأسفل؛ واسعة الانتشار في شمال ووسط أوروبا وآسيا)",
 "anthyllis barba-jovis": "شجيرة الفضة, لحية المشتري (شجيرة أوروبية مشعرة فضية ذات أوراق دائمة الخضرة وأزهار صفراء باهتة)",
 "anthyllis vulneraria": "أنثليس, نفل الكلى (عشب أوراسي معمر له رؤوس من الزهور الحمراء أو الصفراء وشائع في المروج والمراعي؛ كان يستخدم سابقاً طبياً لاضطرابات الكلى)",
 "anti": "معارض, مناهض (ليس لصالح (عمل أو اقتراح إلخ)) / مُعَارِض (شخص يعارض (إجراءً أو سياسة أو ممارسة، إلخ))\nمثال: شم المعارضون رائحة النصر بعد معركة طويلة",
 "anti-": "ضِدّ, مُضَادّ",
 "anti-aestheticism": "معاداة الجمالية (معارضة أو رفض للحركة الفنية الجمالية)\nمثال: صور ساي لفناء سامب يمكن قراءتها كتوسيع لمعاداة الجمالية في عمل سامب بعدة طرق",
 "anti-aging": "مُضَادّ لِلشَّيْخُوخَة",
 "anti-aircraft cruiser": "طراد مضاد للطائرات (طراد خفيف تم فيه استبدال أنابيب الطوربيد والمدافع عيار 6 بوصات منخفضة الزاوية بعشرة مدافع عيار 4 بوصات عالية الزاوية لتوفير الحماية للسفن الحربية…)",
 "anti-american": "معاد لأمريكا (يعارض الولايات المتحدة وسياساتها) / مُعَادٍ لِأَمْرِيكَا (شخص يعارض الولايات المتحدة وسياساتها)",
 "anti-americanism": "مُعَادَاة أَمْرِيكَا, مُنَاهَضَة أَمْرِيكَا",
 "anti-arabism": "شُعُوبِيَّة (مؤنث الشُعُوْبِيّ؛ المنسوب إلى الشُعُوْب؛ مؤنث الشُعُوبِيّ؛ واحد أتباع الشعوبيّة)",
 "anti-ballistic missile": "صاروخ مضاد للصواريخ الباليستية (صاروخ دفاعي مصمم لإسقاط الصواريخ الباليستية العابرة للقارات القادمة)\nمثال: محادثات الحد من الأسلحة الاستراتيجية وضعت حدوداً على نشر الصواريخ المضادة للصواريخ الباليستية",
 "anti-beijing": "مناهض لبكين (معارض سياسياً للحزب الشيوعي الصيني)",
 "anti-catholicism": "معاداة الكاثوليكية (توجه ديني معارض للكاثوليكية)",
 "anti-democracy": "معاداة الديمقراطية (معارضة الديمقراطية، وترتبط عادة (وإن لم يكن دائماً) بمعاداة المساواة)\nمثال: تشمل معاداة الديمقراطية لدى اليمين المتطرف نفوراً من قواعد اللعبة الديمقراطية",
 "anti-drug law": "قانون مكافحة المخدرات (قانون يحظر بيع أو تعاطي المخدرات)",
 "anti-dumping duty": "رسوم مكافحة الإغراق (تعريفة تفرض لمنع الإغراق)",
 "anti-establishment": "مناهض للمؤسسة (معارض للمؤسسة الحاكمة)\nمثال: ظهرت وجوه شابة وجديدة في أعضاء المجلس الجديد، مع تنحي السياسيين المخضرمين في كل من المعسكر المناهض للمؤسسة والموالي لبكين",
 "anti-fascism": "مُعَادَاة الْفَاشِيَّة",
 "anti-g suit": "بدلة جي, بدلة مضادة للجاذبية (بدلة ضغط يرتديها الطيارون ورواد الفضاء لمواجهة قوى الجاذبية والتسارع)",
 "anti-impotence drug": "دواء علاج العجز الجنسي, عقار الفحولة (دواء لعلاج العجز الجنسي الناتج عن ضعف الانتصاب)",
 "anti-inflammatory": "دواء مضاد للالتهاب, مضاد للالتهاب (دواء يهدف إلى تقليل الالتهاب)",
 "anti-inflammatory drug": "دواء مضاد للالتهاب, مضاد للالتهاب (دواء يهدف إلى تقليل الالتهاب)",
 "anti-intellectual": "جَاهِلِيّ, مُعَادٍ لِلْفِكْر (مغرور وجاهل ولا مبالٍ أو معادٍ للقيم الفنية والثقافية) / جاهل بالفنون, شخص مادي (شخص غير مهتم بالمساعي الفكرية أو الثقافية)",
 "anti-lebanon": "جِبَال لُبْنَان الشَّرْقِيَّة",
 "anti-masonic party": "حزب مناهضة الماسونية (حزب سياسي سابق في الولايات المتحدة؛ تأسس عام 1825 لمعارضة الماسونية في الشؤون العامة)",
 "anti-personnel bomb": "قنبلة شظية, قنبلة مضادة للأفراد (قنبلة تحتوي على 10 إلى 20 في المائة فقط من المواد المتفجرة والباقي يتكون من أغلفة مصممة لتتفتت إلى العديد من الشظايا الصغيرة عالية السرعة؛ وهي الأكثر…)",
 "anti-racketeering law": "قانون ريكو, قانون مكافحة الابتزاز (قانون يهدف إلى القضاء على الجريمة المنظمة بفرض عقوبات قوية وأحكام بالمصادرة)",
 "anti-selection": "اختيار عكسي, انتقاء سلبي (حالة يمتلك فيها البائعون معلومات لا يمتلكها المشترون (أو العكس) حول جانب من جوانب جودة المنتج)",
 "anti-semite": "مُعَادٍ لِلسَّامِيَّةِ",
 "anti-semitic": "مُعَاد لِلْسَامِيَّة",
 "anti-semitism": "مُعَادَاة السَّامِيَّة",
 "anti-submarine rocket": "صاروخ مضاد للغواصات (نظام على متن سفينة لإطلاق الصواريخ على الغواصات)",
 "anti-sway bar": "قضيب توازن (قضيب معدني صلب بين أنظمة التعليق الأمامية وبين أنظمة التعليق الخلفية للسيارات والشاحنات؛ يعمل على تثبيت الهيكل)",
 "anti-takeover defense": "دفاع ضد الاستحواذ (مقاومة أو دفاع ضد الاستحواذ العدائي)",
 "anti-theatre": "مناهضة المسرح (أي شكل من أشكال الدراما ليس طبيعياً أو تقليدياً أو 'شرعياً'؛ وبالتالي، المسرح الذي يعصي أو يخالف القوانين والقواعد المقبولة للدراما)\nمثال: معظم مناهضة المسرح، بما في ذلك ست شخصيات تبحث عن مؤلف، لا تحقق أبداً ذلك المستوى من القبول في ذهن الجمهور",
 "anti-tnf compound": "مركب مضاد لعامل نخر الورم (هو مَرْكَبَة للبحر، أكبر من القَارِب وأصغر السَفِينَة)\nمثال: أطلقت الشرطة النار على إطارات مركبة توم.",
 "anti-torque rotor": "دوار الذيل (دوار يتكون من جناح دوار على ذيل طائرة هليكوبتر ذات دوار واحد؛ يمنع الهليكوبتر من الدوران في الاتجاه المعاكس لدوران الدوار الرئيسي)",
 "anti-traditionalism": "معاداة التقليدية (معارضة التقليدية)",
 "anti-virus program": "برنامج مضاد للفيروسات, مكافح الفيروسات (برنامج حاسوبي يفحص الحاسوب بحثاً عن الفيروسات ويمنع انتشارها)",
 "anti-war movement": "حركة مناهضة للحرب (حملة ضد دخول الحرب أو استمرارها)",
 "anti-white": "مناهض للبيض (معارض للأشخاص من أصل أوروبي)",
 "anti-zionism": "مُعَادَاة الصَهْيُونِيَّة, مُعَادَاة الصِهْيُونِيَّة",
 "antiacid": "عامل قلوي, مضاد للحموضة (عامل يقاوم أو يعادل الحموضة (خاصة في المعدة))",
 "antiadrenergic": "مضاد للأدرينالين (يتعلق بمنع أو تقليل التأثيرات الأدرينالية في الجسم)",
 "antiaircraft": "مُضَادّ لِلطَّائِرَات (مصمَّم للدفاع من موقع أرضيّ ضدّ الهجمات الجوّيّة) / مدفع مضاد للطائرات (مدفعية مصممة لإطلاق النار لأعلى باتجاه الطائرات)",
 "antiaircraft fire": "نيران مضادة للطائرات (إطلاق النار على طائرات العدو)",
 "antiaircraft gun": "مدفع مضاد للطائرات (مدفعية مصممة لإطلاق النار لأعلى باتجاه الطائرات)",
 "antialiasing": "إزالة التعرجات, تنعيم الحواف ((في رسومات الحاسوب) تقنية تستخدم لتنعيم التشوهات المسننة في المنحنيات والخطوط القطرية لتظهر أكثر سلاسة)",
 "antianxiety agent": "عقار مهدئ, مهدئ أعصاب (دواء يستخدم لتقليل التوتر أو الشد العصبي دون تقليل الوضوح العقلي)",
 "antianxiety drug": "دواء مضاد للقلق, مهدئ بسيط (مهدئ يستخدم لتخفيف القلق وتقليل التوتر والتهيج)",
 "antiapartheid": "مناهض للفصل العنصري (يعارض سياسة الفصل العنصري (الأبارتايد) في جنوب أفريقيا)\nمثال: زعيم مناهض للفصل العنصري",
 "antiarmor": "مضاد للدروع",
 "antiarrhythmic": "دواء مضاد لاضطراب النظم, مضاد عدم انتظام ضربات القلب (دواء يستخدم لعلاج إيقاع القلب غير الطبيعي)",
 "antiarrhythmic drug": "دواء مضاد لاضطراب النظم, مضاد عدم انتظام ضربات القلب (دواء يستخدم لعلاج إيقاع القلب غير الطبيعي)",
 "antiarrhythmic medication": "دواء مضاد لاضطراب النظم, مضاد عدم انتظام ضربات القلب (دواء يستخدم لعلاج إيقاع القلب غير الطبيعي)",
 "antiauthoritarian": "مُعَادٍ لِلسُّلْطَوِيَّة (مُعَارِضٌ لِلاسْتِبْدَادِ وَالسُّلْطَوِيَّة)",
 "antibacterial": "دواء مضاد للبكتيريا, مبيد للجراثيم (أي دواء يقضي على البكتيريا أو يثبط نموها) / مضاد للبكتيريا, مضاد للجراثيم (يدمر البكتيريا أو يثبط نموها)",
 "antibacterial drug": "دواء مضاد للبكتيريا, مبيد للجراثيم (أي دواء يقضي على البكتيريا أو يثبط نموها)",
 "antiballistic missile": "صاروخ مضاد للصواريخ الباليستية (صاروخ دفاعي مصمم لإسقاط الصواريخ الباليستية العابرة للقارات القادمة)\nمثال: محادثات الحد من الأسلحة الاستراتيجية وضعت حدوداً على نشر الصواريخ المضادة للصواريخ الباليستية",
 "antibaryon": "نَقِيض البَارِيُون (الجسيم المضاد للباريون؛ هادرون ذو عدد باريوني -1)",
 "antiberiberi factor": "ثيامين, فيتامين ب1 (فيتامين ب يمنع مرض البري بري؛ يحافظ على الشهية والنمو)",
 "antibes": "أنتيب",
 "antibiosis": "تَضَادّ حَيَوِيّ",
 "antibiotic": "مُضَادّ حَيَوِيّ",
 "antibiotic drug": "دواء مضاد حيوي, مضاد حيوي (مادة كيميائية مشتقة من العفن أو البكتيريا يمكنها قتل الكائنات الحية الدقيقة وعلاج الالتهابات البكتيرية)\nمثال: عندما اكتشفت المضادات الحيوية لأول مرة أطلق عليها اسم الأدوية المعجزة",
 "antiblack": "عُنْصُرِيّ (تَمْيِيزِيّ خَاصَّةً عَلَى أَسَاس العِرْق أَوِ الدِّين)",
 "antibody": "جِسْم مُضَادّ (شيء مادي؛ جسد الإنسان أو الحيوان)\nمثال: الحليب مفيد للجسم.",
 "antic": "دُعابة, مَقلَب (فعل مضحك أو غريب يتم القيام به للمرح والتسلية) / غَرُوتِسْكِيّ, مُضْحِك الغَرَابَة (غَرِيب بِشَكْلٍ مُثِير لِلسُّخْرِيَة)",
 "anticancer": "مضاد للأورام, مضاد للسرطان (يستخدم في علاج السرطان)\nمثال: دواء مضاد للسرطان",
 "anticatalyst": "مثبط الحفز, مضاد الحفز ((في الكيمياء) مادة تؤخر التفاعل الكيميائي أو تقلل من نشاط المحفز)",
 "anticholinergic": "مُضَادّ لِلْكُولِين (يثبط أو يمنع عمل الأسيتيل كولين في موقع المستقبل) / دواء مضاد للكولين, مضاد كوليني (مادة تعارض أو تحجب عمل الأسيتيل كولين)\nمثال: عقاقير مضادة للكولين",
 "anticholinergic drug": "دواء مضاد للكولين, مضاد كوليني (مادة تعارض أو تحجب عمل الأسيتيل كولين)",
 "anticholinesterase": "مضاد الكولين إستراز (دواء يثبط الكولين إستراز عن طريق الاتحاد معه وبالتالي يكون له تأثير كوليني)",
 "antichrist": "ضِدّ الْمَسِيح, الدَّجَّال",
 "anticipant": "مُتَرَقِّب, مُتَلَهِّف (يتَّسم بترقُّب شديد وتلهُّف) / مستبق, مستشرف (من يستبق الأحداث)",
 "anticipate": "تَوَقَّعَ, اِرْتَقَبَ",
 "anticipated": "مَأْمُول, مُنْتَظَر (مُتَوَقَّع بأمل وترقب)",
 "anticipation": "تنبؤ, توقع (فعل التنبؤ (عن طريق التفكير في المستقبل)) / ترقب, توقع (شيء متوقع حدوثه (بناءً على معيار معين)) / ترقب, توقع (توقع حدوث شيء) / ترقب, توقع (الترقب مع الثقة بالتحقق)\nمثال: كان لكل منهم توقعاته الخاصة",
 "anticipative": "مُتَرَقِّب, مُتَلَهِّف (يتَّسم بترقُّب شديد وتلهُّف)",
 "anticipator": "مستبق, مستشرف (من يستبق الأحداث)",
 "anticipatory": "اسْتِبَاقِيّ, تَوَقُّعِيّ (يأتي على سبيل التوقّع أو الاستباق)",
 "anticipatory breach": "إخلال استباقي (إخلال بالعقد يرتكب قبل وقت الأداء المطلوب)",
 "anticlimactic": "محبط, مخيب للآمال (بعد الذروة) (يأتي بعد الذروة خاصة في حبكة درامية أو سردية) / مخيب للآمال, هبوطي مفاجئ (من أو متعلق بتغيير مفاجئ من أسلوب مثير للإعجاب إلى أسلوب سخيف)\nمثال: كل شيء بعد اكتشاف القاتل كان مخيبًا للآمال",
 "anticlimactical": "مخيب للآمال, هبوطي مفاجئ (من أو متعلق بتغيير مفاجئ من أسلوب مثير للإعجاب إلى أسلوب سخيف)",
 "anticlimax": "انحدار في الأسلوب, هبوط مفاجئ (تغيير من موضوع جاد إلى موضوع مخيب للآمال) / تراجع مخيب, خيبة أمل (تراجع مخيب للآمال بعد ارتفاع سابق)\nمثال: النهاية المخيبة لمهنة رائعة",
 "anticlinal": "مُحَدَّب (ينحدر لأسفل بعيداً عن قمة مشتركة)",
 "anticlockwise": "عَكْس عَقَارِب السَّاعَة (في اتجاه معاكس لاتجاه حركة عقارب الساعة) / عَكْس اتِّجَاه عَقَارِب السَّاعَة (في الاتجاه المعاكس لدوران عقارب الساعة)\nمثال: الرجاء التحرك عكس اتجاه عقارب الساعة في دائرة!",
 "anticoagulant": "دواء مضاد للتخثر, مضاد تخثر (دواء يمنع أو يؤخر تخثر الدم)",
 "anticoagulant medication": "دواء مضاد للتخثر, مضاد تخثر (دواء يمنع أو يؤخر تخثر الدم)",
