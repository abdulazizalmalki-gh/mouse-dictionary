 "anagram": "جِنَاس نَاقِص, قَلْب (في : هو تشابه كلمتين في اللفظ فقط لا في المعنى)",
 "anagrammatic": "جناس تصحيفي, مقلوب الحروف (متعلق بالجناس التصحيفي (إعادة ترتيب الحروف لتكوين كلمات جديدة))",
 "anagrammatical": "جناس تصحيفي, مقلوب الحروف (متعلق بالجناس التصحيفي (إعادة ترتيب الحروف لتكوين كلمات جديدة))",
 "anagrams": "جناس ناقص (لعبة هدفها تكوين كلمات من مجموعة من الحروف المختارة عشوائياً)",
 "anagyris foetida": "خروب الخنزير, نفل الفول (شجيرة ذات أوراق ثلاثية وأزهار صفراء تليها قرون بذور منحنية للخلف؛ الأوراق كريهة الرائحة عند سحقها)",
 "anah": "عانة",
 "anal": "شَرَجِيّ",
 "anal gland": "غُدَّة شَرَجِيَّة",
 "anal intercourse": "جنس شرجي, لواط (الجماع عبر فتحة الشرج، يرتكبه رجل مع رجل أو امرأة)",
 "anal personality": "شخصية شرجية ((التحليل النفسي) شخصية تتميز بالدقة المتناهية والشك والتحفظ؛ يقال إنها تتشكل في الطفولة المبكرة عن طريق التثبيت خلال المرحلة الشرجية من التطور (عادة…)",
 "anal phase": "المرحلة الشرجية ((التحليل النفسي) المرحلة الجنسية والاجتماعية الثانية لنمو الطفل والتي يتم خلالها تعلم التحكم في الأمعاء)",
 "anal retentive": "شَرْجِيّ (مرحلة في التطور النفسي الجنسي عندما يتركز اهتمام الطفل على المنطقة الشرجية؛ يقال إن التثبيت في هذه المرحلة يؤدي إلى الترتيب، البخل، العناد، القهرية،…)",
 "anal retentive personality": "شخصية شرجية ((التحليل النفسي) شخصية تتميز بالدقة المتناهية والشك والتحفظ؛ يقال إنها تتشكل في الطفولة المبكرة عن طريق التثبيت خلال المرحلة الشرجية من التطور (عادة…)",
 "anal sex": "جِمَاع شَرَجِيّ (الموافقة والمساعدة في أي شيء كان؛ الشيء: جمعه)\nمثال: توم قائد جماعة أنونيموس.",
 "anal sphincter": "مصرة الشرج (العضلة العاصرة للشرج)",
 "anal stage": "المرحلة الشرجية ((التحليل النفسي) المرحلة الجنسية والاجتماعية الثانية لنمو الطفل والتي يتم خلالها تعلم التحكم في الأمعاء)",
 "anal vein": "عِرْق خَلْفِيّ, عِرْق شَرَجِيّ (وريد أو شريان، مجرى الدَّم في الجسَد؛ جِنْس؛ سُلَالَة من النّاس يُصنَّفون بناء على التَّاريخ أو الجنسيّة أو التّوزيع الجغرافيّ المشترك)\nمثال: هذا القميص مبلل بالعرق.",
 "analbuminemia": "فقر ألبومين الدم (مستوى منخفض بشكل غير طبيعي من الألبومين في مصل الدم)",
 "analecta": "مختارات أدبية, مقتطفات (مجموعة من المقتطفات من عمل أدبي)",
 "analects": "مختارات أدبية, مقتطفات (مجموعة من المقتطفات من عمل أدبي)",
 "analeptic": "مُنَشِّط عَصَبِيّ (يحفز الجهاز العصبي المركزي) / دواء منشط (دواء يستخدم كمنشط للجهاز العصبي المركزي)",
 "analgesia": "تسكين الألم, فقدان الإحساس بالألم (غياب الإحساس بالألم دون فقدان الوعي)",
 "analgesic": "مسكن ألم (الموضع الذي يسكن فيه الإنسان بمعنى يُقيم؛ البَيْت أو الدار)\nمثال: كان دوري كي أنظف المسكن",
