 "analyzer": "جهاز تحليل, محلل (أداة تقوم بإجراء التحليلات)",
 "anamnesis": "سِيرَة مَرَضِيَّة, تَارِيخ مَرَضِيّ",
 "anamnestic": "استذكاري (من أو متعلق بسوابق المريض (التاريخ المرضي)؛ مساعد للذاكرة)",
 "anamnestic reaction": "استجابة تذكرية, استجابة ثانوية (إنتاج سريع متجدد لجسم مضاد عند المواجهة الثانية (أو اللاحقة) مع نفس مولد الضد)",
 "anamnestic response": "استجابة تذكرية, استجابة ثانوية (إنتاج سريع متجدد لجسم مضاد عند المواجهة الثانية (أو اللاحقة) مع نفس مولد الضد)",
 "anamorphic": "أنامورفي, مشوه بصرياً (متعلق بنوع من الأنظمة البصرية المشوهة للصورة) / تطوري تدريجي (متعلق بالتطور التدريجي من نوع كائن حي إلى آخر)\nمثال: عدسة مشوهة (أنامورفية)",
 "anamorphism": "تشويه بصري, صورة مشوهة (إسقاط أو منظور مشوه؛ خاصة صورة مشوهة بطريقة تجعلها مرئية فقط عند عرضها بطريقة خاصة) / تحول تماثلي (تحول يحدث في أعماق سطح الأرض؛ يغير المعادن البسيطة إلى معادن معقدة) / تحول تشكلي, تطور تدرجي (تطور نوع من الكائنات الحية من نوع آخر عبر سلسلة طويلة من التغييرات التدريجية)",
 "anamorphosis": "تشويه بصري, صورة مشوهة (إسقاط أو منظور مشوه؛ خاصة صورة مشوهة بطريقة تجعلها مرئية فقط عند عرضها بطريقة خاصة) / تحول تشكلي, تطور تدرجي (تطور نوع من الكائنات الحية من نوع آخر عبر سلسلة طويلة من التغييرات التدريجية)",
 "ananas": "أناناس (فاكهة استوائية لحمية حلوة كبيرة ذات خصلة طرفية من الأوراق الصلبة؛ تزرع على نطاق واسع)",
 "ananas comosus": "أناناس (نبات أمريكي استوائي يحمل فاكهة كبيرة لحمية صالحة للأكل مع خصلة طرفية من الأوراق الصلبة؛ يزرع على نطاق واسع في المناطق الاستوائية)",
 "anancasm": "قسرية, هوس قهري (مصطلح قديم لفعل طقوسي أو سلسلة من الأفعال يؤديها شخص مصاب بعصاب الوسواس القهري)",
 "anapa": "أَنَابَا",
 "anapaest": "تفعيلة أنابيستية, تفعيلة قصيرة-قصيرة-طويلة (وحدة مترية بمقاطع غير مشددة-غير مشددة-مشددة)",
 "anapaestic": "أنابيستي, تفعيلي ((عن التفاعيل الشعرية) تتميز بمقطعين قصيرين يليهما مقطع طويل)",
 "anapest": "تفعيلة أنابيستية, تفعيلة قصيرة-قصيرة-طويلة (وحدة مترية بمقاطع غير مشددة-غير مشددة-مشددة)",
 "anapestic": "أنابيستي, تفعيلي ((عن التفاعيل الشعرية) تتميز بمقطعين قصيرين يليهما مقطع طويل)",
 "anaphalis margaritacea": "أناغاليس لؤلؤي (نبات خالد أمريكي له أوراق بشعيرات صوفية ناعمة ورؤوس عذقية بقنابات بيضاء لؤلؤية)",
 "anaphase": "طور انفصالي (مرحلة في الانقسام المنصف أو المتساوي عندما تتحرك الكروموسومات نحو أطراف متقابلة من المغزل النووي)",
 "anaphasic": "طوري نهائي (من أو متعلق بمرحلة الانقسام الفتيلي المعروفة باسم الطور الانفصالي)",
 "anaphor": "عَائِد",
 "anaphora": "جناس استهلالي (تكرار كلمة أو عبارة في بداية الجمل المتتالية) / إحالة, جناس (استخدام ضمير أو كلمة مشابهة بدلاً من تكرار كلمة استخدمت سابقاً)",
 "anaphoric": "إحالي قبلي, جناسي (يتعلق بالإحالة القبلية (الجناس))\nمثال: إحالة مرجعية",
 "anaphoric pronoun": "ضمير عائد (ضمير يشير إلى سابق (مرجع))",
 "anaphoric relation": "جِنَاس, عَلَاقَة إِحَالِيَّة (العلاقة بين لفظ إحالي (مثل الضمير) ومرجعه السابق)",
 "anaphrodisia": "برود جنسي (تراجع أو غياب الرغبة الجنسية)",
 "anaphrodisiac": "مثبط للشهوة (يميل إلى تقليل الرغبة الجنسية)",
 "anaphylactic": "تأقي, تحسسي مفرط (مرتبط بفرط الحساسية المعروف باسم التأق)\nمثال: صدمة تأقية",
 "anaphylactic antibody": "جسم مضاد محب للخلايا\nمثال: الأجسام المضادة المحبة للخلايا مسؤولة عن الاستجابة المناعية التحسسية للكائن الحي (شيء مادي؛ جسد الإنسان أو الحيوان)\nمثال: الحليب مفيد للجسم.",
 "anaphylactic shock": "تأق",
 "anaphylaxis": "إِعْوَار, عَوَار",
 "anaplasia": "فشم, كشم (فقدان التمايز الهيكلي داخل خلية أو مجموعة من الخلايا غالباً مع زيادة القدرة على التكاثر، كما هو الحال في الورم الخبيث)",
 "anaplasmosis": "أنابلازما (مرض يصيب الماشية وينتقل عن طريق قراد الماشية)",
 "anaplastic": "كشمي (من أو متعلق بالكشم (فقدان التمايز الخلوي))",
 "anaplasty": "جراحة تجميلية, جراحة ترميمية (جراحة تعنى بالإصلاح العلاجي أو التجميلي للأنسجة)",
 "anaprox": "أليف, أنابروكس (دواء مضاد للالتهاب غير ستيرويدي (العلامات التجارية أليف وأنابروكس وغيرها) يحارب الألم والالتهاب)",
 "anapsid": "لا ثقوبيات (زاحف بدائي ليس له فتحة في المنطقة الصدغية من الجمجمة؛ جميعها منقرضة باستثناء السلاحف)",
 "anapsid reptile": "لا ثقوبيات (زاحف بدائي ليس له فتحة في المنطقة الصدغية من الجمجمة؛ جميعها منقرضة باستثناء السلاحف)",
 "anarchic": "فَوْضَوِيّ, لَا قَانُونِيّ (بِلَا قَانُونٍ أَوْ سَيْطَرَة)",
 "anarchical": "فَوْضَوِيّ, لَا قَانُونِيّ (بِلَا قَانُونٍ أَوْ سَيْطَرَة)",
 "anarchically": "بِفَوْضَوِيَّة (بطريقة متمردة خارجة عن القانون)",
 "anarchism": "لَاسُلْطَوِيَّة",
 "anarchist": "فَوْضَوِيّ, فَوْضَوِيَّة",
 "anarchist communism": "شيوعية لاسلطوية (نظرية لاسلطوية تدعو إلى إلغاء الدولة والرأسمالية والأجور والملكية الخاصة، وتؤيد الملكية المشتركة لوسائل الإنتاج والديمقراطية المباشرة)\nمثال: في الوقت نفسه، كان يتطور من اللاسلطوية الجماعية لباكونين إلى مذهب الشيوعية اللاسلطوية",
 "anarchistic": "لَاسُلْطَوِيّ",
 "anarcho-capitalism": "لاسلطوية رأسمالية",
 "anarcho-collectivism": "لاسلطوية جماعية (مذهب لاسلطوي ثوري يدعو إلى إلغاء الدولة والملكية الخاصة لوسائل الإنتاج)",
 "anarcho-communism": "شيوعية لاسلطوية (نظرية لاسلطوية تدعو إلى إلغاء الدولة والرأسمالية والأجور والملكية الخاصة، وتؤيد الملكية المشتركة لوسائل الإنتاج والديمقراطية المباشرة)\nمثال: في الوقت نفسه، كان يتطور من اللاسلطوية الجماعية لباكونين إلى مذهب الشيوعية اللاسلطوية",
 "anarchy": "فَوْضَى, فَوْضَوِيَّة",
 "anarthria": "تعذر التلفظ (فقدان جزئي أو كلي للكلام المفصّل الناتج عن آفات في الجهاز العصبي المركزي)",
 "anas acuta": "بط بلبول, بلبول (بط نهري طويل العنق من العالم القديم والجديد له ريش ذيل مركزي ممدود)",
 "anas americana": "صواي أمريكي (نوع من البط يتميز الذكر منه بتاج أبيض)",
 "anas clypeata": "أبو مجرفة, كيش (بط مياه عذبة من نصف الكرة الشمالي له منقار عريض مسطح)",
 "anas crecca": "حذف أخضر الجناح (بط صغير شائع في أوراسيا وأمريكا الشمالية)",
 "anas discors": "حذف أزرق الجناح (بط صغير أمريكي)",
 "anas penelope": "بط صواي, صواي (بط مياه عذبة من أوراسيا وشمال أفريقيا قريب من البركة والحذف)",
 "anas platyrhynchos": "بركة, بط بري (بط بري مخوض ينحدر منه البط المنزلي؛ واسع الانتشار)",
 "anas querquedula": "شرشير صيفي (بط صغير أوراسي)",
 "anas rubripes": "بط أسود, بطة سوداء (بط داكن اللون يعيش في شمال شرق الولايات المتحدة وكندا)",
 "anasa tristis": "بق القرع (بق أمريكي أسود كبير يمتص عصارة كروم فصيلة القرعيات)",
 "anasarca": "استسقاء عام (وذمة معممة مع تراكم المصل في النسيج الضام تحت الجلد)",
 "anasarcous": "استسقائي عام, ودمي (يتميز بـ أو مصاب بالاستسقاء العام (تراكم السوائل في الأنسجة))",
 "anasazi": "أناسازي (هندي أمريكي عاش في ما يعرف الآن بجنوب كولورادو ويوتا وشمال أريزونا ونيو مكسيكو، وبنى مساكن في المنحدرات)",
 "anaspid": "لا درقيات (سمكة مياه عذبة صغيرة منقرضة عديمة الفك لها عادة ذيل غير متناظر ورأس مدرع؛ من العصر السيلوري والديفوني)",
 "anastalsis": "تموّج عكسي (عمل عضلي للقناة الهضمية في اتجاه معاكس للتموج الطبيعي)",
 "anastasia": "أَنَاسْتَازْيَا, أَنَسْتَسِيَّة",
 "anastatica hierochuntica": "كف مريم, نبات القيامة (نبات صحراوي آسيوي رمادي صغير يحمل أزهاراً بيضاء دقيقة يلتف عند الجفاف ويتمدد عند الرطوبة)",
 "anastigmat": "عدسة لا نقطية (عدسة مركبة أو نظام عدسات مصمم ليكون خالياً من اللابؤرية وقادراً على تكوين صور نقطية تقريباً)",
 "anastigmatic": "لَا لَابُؤْرِيّ (ليس لابؤرياً (يصحح اللابؤرية)) / لا بؤري, مصحيح اللابؤرية (متعلق بعدسة أو نظام عدسات خالٍ من اللابؤرية (قادر على تكوين صور نقطية))",
 "anastigmatic lens": "عدسة مصححة للابؤرية (عدسة مصممة لتصحيح اللابؤرية)",
 "anastomosis": "تشابك, مفاغرة (ربط طبيعي أو جراحي لأجزاء أو فروع الهياكل الأنبوبية بحيث تصبح متصلة)",
 "anastomotic": "تشابكي, تفغري (من أو يتعلق بالتفغر (اتصال بين أوعية) أو يظهره)",
 "anastomotic vein": "وريد مفاغر (أي من وريدين متصلين يخدمان الدماغ)",
 "anastrophe": "تقديم وتأخير, قلب (عكس الترتيب الطبيعي للكلمات)",
 "anastylosis": "أناستيلوسيس, إعادة تجميع الآثار (إعادة التجميع الأثري للآثار المدمرة من شظايا ساقطة أو متحللة (مع دمج مواد جديدة عند الضرورة))",
 "anathema": "مُلاعنة / لَعْنَة (أي رغبة صريحة في أن تصيب المحن أو أي شكل من أشكال سوء الحظ كيانًا ما، سواء كان شخصًا، أو مكانًا، أو كائنًا)\nمثال: اللعنة حولها ومعرفة",
 "anathematisation": "حرمان كنسي, لعن (الفعل الرسمي لإعلان (شخص أو شيء) ملعوناً)",
 "anathematization": "حرمان كنسي, لعن (الفعل الرسمي لإعلان (شخص أو شيء) ملعوناً)",
 "anatoli": "أَنَاتُولِي",
 "anatolia": "الأَنَاضُول, الْأَنَضُول",
 "anatolian": "اللغات الأناضولية (فرع منقرض من عائلة اللغات الهندية الأوروبية معروف من النقوش ومهم في إعادة بناء الهندية الأوروبية البدائية)",
 "anatolian language": "اللغات الأناضولية (فرع منقرض من عائلة اللغات الهندية الأوروبية معروف من النقوش ومهم في إعادة بناء الهندية الأوروبية البدائية)",
 "anatolius": "أَنَاتُولِي",
 "anatomic": "تشريحي (متعلق بتركيب الجسم) / تشريحي (متعلق بفرع المورفولوجيا (علم الشكل) الذي يدرس تركيب الكائنات الحية)\nمثال: سمات تشريحية",
 "anatomical": "تشريحي (متعلق بتركيب الجسم) / تشريحي (متعلق بفرع المورفولوجيا (علم الشكل) الذي يدرس تركيب الكائنات الحية) / إشارة تشريحية (تعبير يتعلق بالتشريح)\nمثال: سمات تشريحية",
 "anatomical reference": "إشارة تشريحية (تعبير يتعلق بالتشريح)",
 "anatomical sphincter": "عضلة عاصرة, مصرة (حلقة من العضلات تنقبض لإغلاق فتحة)",
 "anatomical structure": "بِنْيَة جِسْمِيَّة, تَرْكِيب تَشْرِيحِيّ (جزء تشريحيّ معقّد من كائن حيّ وطريقة بنائه وترتيبه)",
 "anatomically": "تشريحياً (فيما يتعلق بالتشريح)\nمثال: صحيح تشريحياً",
 "anatomist": "مُشَرِّح, مُشَرِّحَة",
 "anatomy": "تَشْرِيح",
 "anatotitan": "أناتوتيتان (واحد من أكبر وأشهر الديناصورات بطية المنقار)",
 "anatoxin": "تكسويد, ذيفان موهن (ذيفان بكتيري تم إضعافه حتى لم يعد ساماً ولكنه قوي بما يكفي لتحفيز تكوين الأجسام المضادة والمناعة)\nمثال: ذيفان الدفتيريا الموهن",
 "anatropous": "معكوس البويضة, منقلب البويضة ((عن بويضة النبات) مقلوبة تماماً؛ منعطفة للخلف بزاوية 180 درجة على سويقتها)",
 "anatropous ovule": "بويضة منعكسة (بويضة مقلوبة تماماً تميل للخلف بمقدار 180 درجة على عنقها)",
 "anaxyrus americanus": "علجوم أمريكي (علجوم شائع في أمريكا)",
 "anaxyrus canorus": "علجوم يوسمايت (من مروج سييرا نيفادا العالية وحدود الغابات)",
 "anaxyrus debilis": "علجوم أخضر أمريكي (علجوم صغير أخضر أو أصفر مخضر مع قضبان وخطوط سوداء صغيرة)",
 "anaxyrus speciosus": "علجوم تكساس (علجوم ليلي حفار من غابات المسكيت والبراري في جنوب غرب الولايات المتحدة)",
 "anbar": "اَلْأَنْبَار",
 "anc": "تِعْدَاد العَدِلَات المُطْلَق",
 "ancestor": "سَلَف (مضى أو سبق في الزمن؛ تسوية الأرض للمزارعة باستخدام أداة تسمى \"المِسْلَفَة\")",
 "ancestor worship": "عبادة الأسلاف (عبادة الأجداد) / عبادة الأسلاف (عادة تبجيل الأسلاف المتوفين الذين يُعتبرون ما زالوا جزءاً من العائلة، ويُعتقد أن أرواحهم تمتلك القدرة على التدخل في شؤون الأحياء)\nمثال: معظم ممارسات عبادة الأسلاف المعروفة تاريخياً في اليابان هي تعديلات لعادات صينية",
 "ancestral": "أَبَوِيّ, مَوْرُوث (مُتوارَث وفق قواعد راسخة (عادة قانونية) للإرث) / جدي, سلفي (من أو ينتمي إلى أو موروث من سلف)",
 "ancestress": "جدة, سلف أنثى (سلف من الإناث)",
 "ancestry": "أصل, سلالة (الخصائص الموروثة المشتركة مع الآخرين من نفس سلالة الدم) / أصل, سلالة (الاشتقاق الوراثي للفرد)\nمثال: كل سلالته كانت محاربين",
 "anchor": "مِرْسَاة, أَنْجَر / مُذِيع, مُذِيعَة / رَسَا ((رَسَا) الشيءُ يَرْسُو رَسْواً، ورُسُوّاً: ثَبَتَ؛ رَسا الجبلُ: ثَبَتَ أصَله في الأَرض)",
 "anchor chain": "جنزير الهلب, سلسلة المرساة (السلسلة أو الحبل الذي يربط المرساة بالسفينة)",
 "anchor light": "ضوء المرساة (ضوء في تجهيزات السفينة التي ترسو)",
 "anchor ring": "حلقة, طوق (شكل حلقي)\nمثال: حلقة من السفن في الميناء",
 "anchor rope": "جنزير الهلب, سلسلة المرساة (السلسلة أو الحبل الذي يربط المرساة بالسفينة)",
 "anchorage": "أَنْكُورِيج",
 "anchorage ground": "مرسى (مكان لرسو السفن)",
 "anchorite": "متوحد, ناسك (شخص اعتزل المجتمع لأسباب دينية)",
 "anchoritic": "زُهْدِيّ, نَاسِكِيّ (يَتَّسِمُ بِالعُزْلَةِ الزُّهْدِيَّةِ وَالتَّنَسُّكِ)",
 "anchorman": "مُذِيع أَخْبَار, قَارِئ أَخْبَار",
 "anchorperson": "مذيع رئيسي (مراسل تلفزيوني ينسق بثًا يساهم فيه عدة مراسلين)",
 "anchorwoman": "مذيعة رئيسية (مراسلة تلفزيونية أنثى تنسق بثاً يساهم فيه عدة مراسلين)",
 "anchovy": "أَنْشُوفة, بَلَم",
 "anchovy butter": "زبدة الأنشوفة (زبدة ممزوجة بالأنشوفة المهروسة)",
 "anchovy dressing": "تتبيلة الأنشوفة (فينيغريت وأنشوفة مهروسة)",
 "anchovy paste": "معجون الأنشوفة (معجون مصنوع أساساً من الأنشوفة؛ يستخدم في الصلصات والدهن)",
 "anchovy pear": "كمثرى الأنشوفة, كمثرى النهر (فاكهة من جزر الهند الغربية تشبه المانجو؛ غالباً ما تُخلل) / إجاص الأنشوفة (شجرة من جزر الهند الغربية تحمل فاكهة صالحة للأكل تشبه المانجو)",
 "anchovy pear tree": "إجاص الأنشوفة (شجرة من جزر الهند الغربية تحمل فاكهة صالحة للأكل تشبه المانجو)",
 "anchovy pizza": "بيتزا الأنشوجة (بيتزا الطماطم والجبن مع الأنشوجة)",
 "anchovy sauce": "صلصة الأنشوفة (مصنوعة من الصلصة البيضاء والأنشوفة المهروسة)",
 "anchusa": "أنشوزا, كحلاء",
 "anchusa capensis": "أذن الفأر الرأسي, كحلاء رأسية (كحلاء من جنوب إفريقيا لها زهور زرقاء بحلوق بيضاء)",
 "anchusa officinalis": "كحلاء مخزنية, لسان الثور (عشب معمر أو ثنائي الحول يزرع لزهوره الرقيقة الزرقاء عادة)",
 "anchusa riparia": "كحلاء ضفافية (كحلاء من جنوب إفريقيا لها زهور زرقاء إلى حمراء أرجوانية)",
 "anchylosis": "تيبس المفصل, قسط (التصاق وتصلب غير طبيعي في عظام المفصل)",
 "ancien regime": "عهد بائد, نظام قديم (نظام سياسي واجتماعي لم يعد يحكم (خاصة النظام الذي كان موجوداً في فرنسا قبل الثورة الفرنسية))",
 "ancient": "قَدِيم, عَتِيق (شيء مر عليه زمن طويل)\nمثال: هذه خدعة قديمة.",
 "ancient astronaut hypothesis": "فرضية رواد الفضاء القدماء (فرضية علمية زائفة تفترض أن كائنات ذكية من خارج الأرض قد زارت الأرض واتصلت بالبشر في العصور القديمة وما قبل التاريخ)",
 "ancient egypt": "مِصْر اَلْقَدِيمَة (تقع في أقصى شمال شرق إفريقيا وجنوب غرب آسيا؛ اسمها الرسمي جُمْهُورِيَّة مِصْر الْعَرَبِيَّة، وعاصمتها الْقَاهِرَة؛ الحَاجِز بين الشيئين، والحَدُّ بين الأرضَيْن (جمعها مُصُور))\nمثال: ولد سامي في مصر.",
 "ancient greece": "الْيُونَان الْقَدِيمَة (دولة في جنوب شرق أوروبا؛ اسمها الرسمي الْجُمْهُورِيَّة الهِيلِينِيَّة، وعاصمتها أَثِينَا)\nمثال: أنا من اليونان.",
 "ancient greek": "اللُّغَة الْيُونَانِيَّة الْقَدِيمَة, الإِغْرِيقِيَّة",
 "ancient greek language": "اليونانية القديمة (اللغة اليونانية قبل الإمبراطورية الرومانية)",
 "ancient history": "تاريخ قديم (معرفة حقيقة أو حدث حديث أصبح معروفاً لدرجة أنه فقد أهميته الأصلية) / التاريخ القديم (تاريخ العالم القديم)",
 "ancient pine": "صنوبر قديم (صنوبر صغير بطيء النمو من غرب الولايات المتحدة يشبه صنوبر بريستلكون؛ لحاء بني شوكولاتي في صفائح وإبر قصيرة في حزم من 5؛ التاج مخروطي ولكنه يصبح خشناً…)",
 "ancient rome": "رُومَا الْقَدِيمَة (ولاية إيطالية؛ مدينة هي عاصمة ولاية روما الإيطالية)\nمثال: روما مدينة قديمة.",
 "anciently": "في العصور القديمة, قديماً (في الأزمنة القديمة؛ منذ زمن بعيد)\nمثال: اهتمام بما قد حدث قديماً",
 "ancientness": "عراقة, قدم (قدم شديد)",
 "ancients": "الأسلاف, قدماء (الناس الذين عاشوا في أزمنة غابرة (خاصة خلال الفترة التاريخية قبل سقوط الإمبراطورية الرومانية في أوروبا الغربية))",
 "ancillary": "مُلْحَق",
 "anconeous muscle": "عضلة مرفقية (العضلة التي تمد الساعد وتبعد الزند في كب المعصم)",
 "ancylus fluviatilis": "بطلينوس نهري (بطني قدم مخروطي دقيق يشبه البطلينوس ظاهرياً ولكنه يعيش ويتغذى على نباتات المياه العذبة)",
 "and": "وَـ (الحرف السابع والعشرون من حروف الهجاء؛ يفيد الجمع والإشراك) / وَ (الحرف السابع والعشرون من حروف الهجاء؛ يفيد الجمع والإشراك)",
 "and circuit": "بوابة و, دائرة و (دائرة في الحاسوب تعمل فقط عندما تعمل جميع مدخلاتها)",
 "and gate": "بوابة و, دائرة و (دائرة في الحاسوب تعمل فقط عندما تعمل جميع مدخلاتها)",
 "and how": "بالتأكيد, وبشدة (تعبير عن الموافقة المؤكدة)",
 "and so": "إذن, ثم (لاحقاً أو بعد ذلك بقليل (تستخدم غالباً كروابط للجمل))",
 "and so forth": "وَهٰكَذَا, وَهَلُمَّ جَرًّا",
 "and so on": "إلخ, وما إلى ذلك (الاستمرار بنفس الطريقة)",
 "and then some": "وأكثر من ذلك (وأكثر بكثير بالإضافة إلى ذلك)\nمثال: كلفني راتب أسبوع وأكثر من ذلك",
 "andalusia": "أَنْدَلُسِيَا, أَنْدَلُسِيَة (طريقة هجاء بديلة لـ\"أَنْدَلُسِيَة\" (إقليم إداري في إسبانيا))",
 "andalusian": "أَنْدَلُسِيّ",
 "andalusian arabic": "العربية الأندلسية",
 "andaman marble": "خشب الرخام, ديوسبيروس كورزي (شجرة آسيوية كبيرة ذات خشب مخطط صلب رخامي)",
 "andaman redwood": "خشب الأمبوينا (خشب ذو عروق مجعدة مبقعة)",
 "andaman sea": "بَحْر أَنْدَامَان (شَقّ الأرض؛ التَحَيُّر والبَهْت من الفزع أو من شدة العَطَش فنظر لا يقصد شيئا)\nمثال: هبطت على البحر.",
 "andante": "بِنَغَم مُتَوَسِّط البُطْء (بإيقاع بطيء باعتدال) / أَنْدَانْتِي ((في الإيقاع الموسيقيّ) بَطِيء بِشَكْلٍ مُعْتَدِل) / أندانتي (تأليف موسيقي أو مقطع يُؤدى ببطء معتدل) / أندانتي (وتيرة بطيئة باعتدال (سرعة المشي))\nمثال: يجب عزف هذا المقطع بنغم متوسط البطء",
 "andantino": "أَنْدَانْتِينُو ((في الإيقاع الموسيقيّ) سَرِيع بِشَكْلٍ مُعْتَدِل)",
 "andean": "أنديزي (يتعلق بجبال الأنديز وسكانها)",
 "andean condor": "كندور الأنديز (نسر كبير من جبال الأنديز العالية ذو ريش أسود وطوق رقبة أبيض)",
 "andelmin": "أنجيليم (أي من الأشجار الاستوائية الأمريكية المتعددة من جنس أنديرا)",
 "anderlecht": "أندرلخت",
