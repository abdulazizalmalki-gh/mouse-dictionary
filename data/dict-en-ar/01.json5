 "arab spring": "اَلرَّبِيع اَلْعَرَبِيّ, اَلثَّوْرَات اَلْعَرَبِيَّة",
 "arab world": "الْعَالَم الْعَرَبِيّ, الوَطَن الْعَرَبِيّ",
 "arab-berbers": "أمازيغ, بربر (أقلية عرقية تنحدر من الأمازيغ والعرب وتعيش في شمال أفريقيا)",
 "araba": "عَرَبَة",
 "arabesque": "أرابيسك, زخرفة عربية (زخرفة تتداخل فيها أشكال نباتية محاكية في تصميم معقد) / أرابيسك (وضعية يرفع فيها الراقص ساقاً واحدة للخلف ويمد ذراعيه في وقفة تقليدية)",
 "arabia": "شِبْهُ اَلْجَزِيرَةِ اَلْعَرَبِيَّةُ",
 "arabian": "عَرَبِي (هو واحد العَرَب؛ من يتكلم العَرَبِيَّة كلغة أم أو يرجع نسبه إلى العرب؛ المنسوب إلى العرب)\nمثال: نحن ندرس العربي",
 "arabian camel": "جمل عربي (جمل ذو سنام واحد من الصحاري الحارة في شمال أفريقيا وجنوب غرب آسيا)",
 "arabian coffee": "بن عربي, قهوة عربية (شجرة شجيرية من شمال شرق أفريقيا الاستوائية تزرع على نطاق واسع في المناطق الاستوائية أو شبه الاستوائية لبذورها التي تشكل معظم القهوة التجارية)",
 "arabian horse": "حِصَان عَرَبِيّ, فَرَس عَرَبِيّ (الواحد الذكر من الخَيْل؛ يطلق مجازًا على الواحد من الخيل الذي لا يُعرف ذكر كان أم أنثى)\nمثال: لم يشفى الحصان.",
 "arabian iraq": "عِرَاق الْعَرَب, الْعِرَاق الْعَرَبِيّ (تُستعمل للإشارة إلى العراق؛ شاطئ البحر أو النهر طولًا)\nمثال: إيران ليست العراق.",
 "arabian jasmine": "فُلّ (فَلُّ السَّيْفِ: كَسْرٌ فِي حَدِّهِ؛ فَلُّ الْحَدِيدِ أَوِ الفِضَّةِ أَوِ الذَّهَبِ أَوِ النَّارِ : مَا تَنَاثَرَ مِنْ ذَلِكَ)",
 "arabian peninsula": "شِبْه اَلْجَزِيرَة اَلْعَرَبِيَّة",
 "arabian sea": "بَحْر اَلْعَرَب (شَقّ الأرض؛ التَحَيُّر والبَهْت من الفزع أو من شدة العَطَش فنظر لا يقصد شيئا)\nمثال: هبطت على البحر.",
 "arabian tea": "قات (أوراق شجيرة كاثا إدوليس التي تُمضغ مثل التبغ أو تستخدم لصنع الشاي؛ لها تأثير المنشط المبهج)\nمثال: في اليمن، يستخدم 85% من البالغين القات يومياً",
 "arabic": "عَرَبِيّ (هو واحد العَرَب؛ من يتكلم العَرَبِيَّة كلغة أم أو يرجع نسبه إلى العرب؛ المنسوب إلى العرب)\nمثال: نحن ندرس العربي",
 "arabic alphabet": "الأبجدية العربية (أبجدية مكونة من 28 حرفاً مشتقة من الآرامية وتُستخدم لكتابة اللغة العربية (واستعيرت لكتابة الأردية))",
 "arabic language": "اللغة العربية (اللغة السامية للعرب؛ يتم التحدث بها في مجموعة متنوعة من اللهجات)",
 "arabic numeral": "رَقْم عَرَبِيّ (وضع أرقامًا على شيء ما للتنظيم أو التمييز)\nمثال: سجلت رقم هاتفه.",
 "arabicised": "مُعَرَّب",
 "arabidopsis lyrata": "أرابيدوبسيس قيثاري",
 "arabidopsis thaliana": "رشاد أذن الفأر (عشب ضار صغير غازٍ ذاتي التلقيح بزهور بيضاء صغيرة؛ يدرسه علماء وراثة النبات كثيراً؛ أول نبات راقٍ تم وصف تسلسل جينومه الكامل)",
 "arability": "صلاحية للزراعة, قابلية الزراعة (جودة الأرض المناسبة للزراعة والحرث)",
 "arabis canadensis": "أرابيس كندي, قرن المنجل (رشاد صخري أمريكي شمالي ذو قرون منحنية طويلة جداً)",
 "arabis glabra": "خردل البرج, رشاد البرج (أو جنس أرابيس: رشاد منتصب واسع الانتشار في جميع أنحاء أوروبا)",
 "arabis turrita": "خردل البرج, رشاد البرج (رشاد أوروبي ذو سيقان منتصبة صلبة؛ يوضع أحياناً في جنس توريتيس)",
 "arabisation": "تَعْرِيب",
 "arabism": "عُرُوبَة",
 "arabist": "متخصص في العربية, مستشرق (عالم متخصص في اللغات والثقافة العربية)",
 "arabize": "أَعْرَبَ, عَرَّبَ",
 "arable": "صَالِح لِلزِّرَاعَة, قَابِل لِلْحَرْث ((عن الأراضي الزراعية) قابل للزراعة المنتجة)",
 "arabness": "عُرُوبَة",
 "arabophobia": "مُعَادَاة اَلْعَرَب, كَرْه اَلْعَرَب",
 "arabophone": "مُتَحَدِثُ العَرَبِيَةِ, مُتَحَدِثُةُ العَرَبِيَةِ",
 "araceous": "قلقاسي (يتعلق بنبات من الفصيلة القلقاسية)",
 "arachis hypogaea": "فول سوداني (نبات أمريكي يُزرع على نطاق واسع في المناطق الاستوائية والدافئة؛ له أزهار صفراء مبهرجة على سيقان تنحني نحو التربة بحيث تنضج قرون البذور تحت الأرض)",
 "arachnid": "حَيَوَان عَنْكَبُوتِيّ (بمعنى أصبح له حياة؛ الحَيَاة. والحَيَوَان أبلغ من الحَيَاة؛ جنس الحَيّ الذي يأكل وينمو ويتحرك بالإرادة وبه حِسّ بخلاف ما به حياة فقط دون الحس مثل النَبَات. بعض العامة تقول حَيْوَان وهو غلط)\nمثال: هذا حيوان أليف.",
 "arachnidian": "عنكبوتي (يتعلق بـ أو يشبه عضواً من فئة العناكب)",
 "arachnoid": "عنكبوتيات (مفصليات تتنفس الهواء تتميز بعيون بسيطة وأربعة أزواج من الأرجل) / عنكبوتي (يتعلق بـ أو يشبه عضواً من فئة العناكب) / أم عنكبوتية, غشاء عنكبوتي (الوسطى من السحايا الثلاث)",
 "arachnoid membrane": "أم عنكبوتية, غشاء عنكبوتي (الوسطى من السحايا الثلاث)",
 "arachnophobia": "رُهَاب اَلْعَنَاكِب",
 "arafura sea": "بَحْر آرَافُورَا (شَقّ الأرض؛ التَحَيُّر والبَهْت من الفزع أو من شدة العَطَش فنظر لا يقصد شيئا)\nمثال: هبطت على البحر.",
 "aragonite": "أراغونيت (شكل معدني من كربونات الكالسيوم البلورية؛ ثنائي الشكل مع الكالسيت)",
 "arak": "عَرَق (وريد أو شريان، مجرى الدَّم في الجسَد؛ جِنْس؛ سُلَالَة من النّاس يُصنَّفون بناء على التَّاريخ أو الجنسيّة أو التّوزيع الجغرافيّ المشترك)\nمثال: هذا القميص مبلل بالعرق.",
 "aral sea": "بَحْر آرَال (شَقّ الأرض؛ التَحَيُّر والبَهْت من الفزع أو من شدة العَطَش فنظر لا يقصد شيئا)\nمثال: هبطت على البحر.",
 "aralia": "أراليا (أي من النباتات المتنوعة لجنس أراليا؛ غالباً ما تكون نباتات عطرية ذات أوراق مركبة وأزهار خيمية صغيرة)",
 "aralia elata": "شجرة أنجليكا اليابانية (شجيرة آسيوية نفضية تشكل كتلاً أو شجرة صغيرة؛ دخيلة في شرق الولايات المتحدة)",
 "aralia hispida": "أراليا خشنة, فشاغ شائك (عشب شائك من شرق ووسط أمريكا الشمالية له ثمار سوداء ولحاء طبي)",
 "aralia nudicaulis": "أراليا عارية الساق, سارساباريلا كاذبة (عشب معمر شائع له جذور عطرية تستخدم كبديل للسارساباريلا؛ وسط وشرق أمريكا الشمالية)",
 "aralia racemosa": "أراليا عنقودية, سنبل هندي أمريكي (نبات معمر جذموري خشبي غير مسلح يتميز عن الفشاغ البري بجذور أكثر عطرية وخيمات عنقودية؛ جنوب شرق أمريكا الشمالية إلى المكسيك)",
 "aralia spinosa": "شجرة أنجليكا الأمريكية, عصا الشيطان (شجرة أو شجيرة نفضية صغيرة تشكل كتلاً في شرق الولايات المتحدة)",
 "aralia stipulata": "أنجليكا صينية (تشبه شجرة الأنجليكا الأمريكية ولكنها أقل شوكاً؛ الصين)",
 "aram": "آرام",
 "aramaean": "آرامي (من أو متعلق بآرام أو سكانها أو ثقافتهم أو لغتهم) / آرامي (عضو في إحدى المجموعات السامية التي سكنت آرام وأجزاء من بلاد ما بين النهرين من القرن الحادي عشر إلى القرن الثامن قبل الميلاد)",
 "aramaic": "آرَامِيَّة",
 "aramaic language": "الآرامية (لغة سامية كانت في الأصل للآراميين القدماء ولكن لا يزال يتحدث بها أشخاص آخرون في جنوب غرب آسيا)",
 "aramaic script": "الآرامية, الخط الآرامي (خط أبجدي (أو ربما مقطعي) استُخدم منذ القرن التاسع قبل الميلاد لكتابة اللغة الآرامية؛ واشتق منه العديد من الخطوط الأخرى لاحقاً)",
 "aramaicism": "آرامية (سمة مميزة للغة الآرامية تظهر في لغة أخرى)",
 "aramaism": "آرامية (سمة مميزة للغة الآرامية تظهر في لغة أخرى)",
 "arame": "أرامي (عشب بحري صالح للأكل ذو نكهة خفيفة)",
 "aramean": "آرَامِيّ",
 "aramus guarauna": "كورلان (طائر خوض من أمريكا الجنوبية وأمريكا الوسطى)",
 "aramus pictus": "ليمبكين (طائر خوض من فلوريدا وكوبا وجامايكا له منقار متدلي ونداء عويل مميز)",
 "arancino": "أَرَانْشِينِي",
 "aranea diademata": "عنكبوت الحديقة (عنكبوت شائع في الحدائق الأوروبية)",
 "araneidal": "عنكبوتي (يتعلق بـ أو يشبه العنكبوت)",
 "araneidan": "عنكبوتي (يتعلق بـ أو يشبه العنكبوت)",
 "araneus cavaticus": "عنكبوت الحظيرة (عنكبوت برتقالي وأسمر بأرجل مخططة بشكل داكن يغزل شبكة دائرية يومياً)\nمثال: اشتهر عنكبوت الحظيرة في كتاب إي. بي. وايت 'شبكة شارلوت'",
 "arapaho": "لغة الأراباهو (لغة ألغونكوية يتحدث بها شعب الأراباهو) / أراباهو (فرد من قبيلة من هنود السهول كانت تسكن سابقاً شرق كولورادو ووايومنغ (تعيش الآن في أوكلاهوما ووايومنغ))",
 "arapaho language": "لغة الأراباهو (لغة ألغونكوية يتحدث بها شعب الأراباهو)",
 "arapahoe": "لغة الأراباهو (لغة ألغونكوية يتحدث بها شعب الأراباهو) / أراباهو (فرد من قبيلة من هنود السهول كانت تسكن سابقاً شرق كولورادو ووايومنغ (تعيش الآن في أوكلاهوما ووايومنغ))",
 "arapahoe language": "لغة الأراباهو (لغة ألغونكوية يتحدث بها شعب الأراباهو)",
 "arariba": "أراريبا, سنترولوبيوم (شجرة برازيلية ذات خشب مميز بشكل جميل)",
 "araroba": "أراروبا, مسحوق جوا (مسحوق أصفر مر يستخدم لعلاج الأمراض الجلدية)",
 "araucaria": "أراوكاريا (أي من عدة أشجار طويلة في أمريكا الجنوبية أو أستراليا ذات مخاريط كبيرة وبذور صالحة للأكل)",
 "araucaria araucana": "أروكاريا أروكانية, لغز القرد (صنوبرية تشيلية كبيرة دائمة الخضرة لها فروع متشابكة وتحمل مكسرات صالحة للأكل)",
 "araucaria bidwillii": "بونيا بونيا (صنوبرية أسترالية تحمل بذوراً بحجم بوصتين طعمها مثل الكستناء المحمصة؛ بين السكان الأصليين تعتبر الشجرة ملكية وراثية محمية بالقانون)",
 "araucaria columnaris": "صنوبر كاليدونيا الجديدة (شجرة دائمة الخضرة طويلة جداً من كاليدونيا الجديدة وهيبريدس الجديدة تشبه صنوبر جزيرة نورفولك)",
 "araucaria cunninghamii": "صنوبر الطوق (صنوبر من أستراليا وغينيا الجديدة؛ ينتج خشباً قيماً خفيفاً متساوي الملمس)",
 "araucaria excelsa": "صنوبر جزيرة نورفولك (شجرة دائمة الخضرة من أستراليا وجزيرة نورفولك في جنوب المحيط الهادئ)",
 "araucaria heterophylla": "صنوبر جزيرة نورفولك (شجرة دائمة الخضرة من أستراليا وجزيرة نورفولك في جنوب المحيط الهادئ)",
 "araujia sericofera": "أروجا, نبات قاسي (شجيرة ملتفة قوية لها عناقيد من الزهور البيضاء أو الوردية العطرة ببتلات طرفية مسطحة منتشرة تحبس الفراشات الليلية وتمسك بها حتى الفجر)",
 "arava": "أرافا, ليفلونوميد",
 "arawak": "الأراواكية, لغات الأراواك (عائلة من لغات الهنود الحمر في أمريكا الجنوبية يتم التحدث بها في شمال شرق أمريكا الجنوبية) / أراواك (فرد من مجموعة واسعة الانتشار من الهنود الحمر تعيش في شمال شرق أمريكا الجنوبية)",
 "arawakan": "أراواكي (من أو متعلق بالشعوب التي تتحدث لغة الأراواك) / الأراواكية, لغات الأراواك (عائلة من لغات الهنود الحمر في أمريكا الجنوبية يتم التحدث بها في شمال شرق أمريكا الجنوبية) / أراواك (فرد من مجموعة واسعة الانتشار من الهنود الحمر تعيش في شمال شرق أمريكا الجنوبية)",
 "arb": "تاجر المراجحة, مراجح (شخص يمارس المراجحة (شراء الأوراق المالية في سوق لإعادة بيعها فوراً في سوق آخر أملاً في الربح من فرق السعر))",
 "arbalest": "أرباليست, قوس مستعرض فولاذي (نسخة متأخرة من القوس المستعرض بقوس فولاذي)",
 "arbalist": "أرباليست, قوس مستعرض فولاذي (نسخة متأخرة من القوس المستعرض بقوس فولاذي) / رامي القوس المستعرض (رامي سهام يستخدم القوس المستعرض (النشاب))",
 "arbil": "أَرْبِيل",
 "arbiter": "حَكَم, مُحكِّم (شخص يتم اختياره للحكم والبت في قضية متنازع عليها) / حَكَم, فيصل (شخص لديه السلطة لتسوية الأمور حسب إرادته)\nمثال: اعتُبر الناقد حكماً للأدب الحديث",
 "arbitrable": "قَابِل لِلتَّحْكِيم (مناسب أو خاضع للتسوية عن طريق التحكيم)\nمثال: سياسة الأجور والمزايا الصحية القابلة للتحكيم",
 "arbitrage": "مراجحة (نوع من الاستثمار المحوط يهدف إلى الاستفادة من الفروق الطفيفة في السعر؛ عندما يكون هناك فرق في سعر شيء ما في سوقين مختلفين، يقوم المراجح بالشراء…)",
 "arbitrager": "تاجر المراجحة, مراجح (شخص يمارس المراجحة (شراء الأوراق المالية في سوق لإعادة بيعها فوراً في سوق آخر أملاً في الربح من فرق السعر))",
 "arbitrageur": "تاجر المراجحة, مراجح (شخص يمارس المراجحة (شراء الأوراق المالية في سوق لإعادة بيعها فوراً في سوق آخر أملاً في الربح من فرق السعر))",
 "arbitral": "تحكيمي (يتعلق بـ أو ناتج عن التحكيم)\nمثال: التسوية التحكيمية للنزاع",
 "arbitrament": "تحكيم (فعل اتخاذ القرار كمحكم؛ إعطاء حكم رسمي)\nمثال: قدموا خلافهم للتحكيم",
 "arbitrarily": "بشكل عشوائي, دون تمييز (بطريقة عشوائية)\nمثال: كانت المنازل مبعثرة عشوائياً",
 "arbitrariness": "تقلب, نزوة (سمة التصرف بشكل غير متوقع وبدافع نزوة أكثر منه بدافع العقل أو الحكم)\nمثال: أيأس من تقلب ونزوة ذاكرتي",
 "arbitrary": "اِعْتِبَاطِيّ",
 "arbitrate": "يَفْصِل, يَحْكُم",
 "arbitration": "تَحْكِيم (تنصيب حُكْم؛ عملية يلجأ فيها متنازعان في ميدان الشغل إلى تحكيم طرف ثالث يوافقان عليه. قد يكون الحكم مجموعة أو جمعية بدلا من شخص)",
 "arbitration clause": "بند التحكيم, شرط التحكيم (بند في عقد ينص على التحكيم في النزاعات الناشئة بموجب العقد)",
 "arbitrational": "تحكيمي (يتعلق بـ أو ناتج عن التحكيم)\nمثال: التسوية التحكيمية للنزاع",
 "arbitrative": "تحكيمي (يتعلق بـ أو يمتلك سلطة التحكيم)\nمثال: مجلس تحكيمي",
 "arbitrator": "حَكَم, مُحكِّم (شخص يتم اختياره للحكم والبت في قضية متنازع عليها)\nمثال: اعتُبر الناقد حكماً للأدب الحديث",
