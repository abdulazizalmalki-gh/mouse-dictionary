 "almighty": "كُلِّيّ القُدْرة, جَبّار",
 "almond": "لَوْز, لَوْزَة",
 "almond cookie": "بسكويت اللوز, هلال اللوز (بسكويت غني جداً يحتوي على لوز مطحون؛ عادة ما يكون على شكل هلال)",
 "almond crescent": "بسكويت اللوز, هلال اللوز (بسكويت غني جداً يحتوي على لوز مطحون؛ عادة ما يكون على شكل هلال)",
 "almond extract": "مستخلص اللوز (نكهة مصنوعة من اللوز المنقوع في الكحول)",
 "almond moth": "عثة التين, عثة اللوز (عثة تتغذى يرقاتها على منتجات مخزنة متنوعة من أصل نباتي وتربطها معاً بشباك)",
 "almond oil": "زيت اللوز (زيت دهني أصفر شاحب يُعصر من اللوز الحلو أو المر)",
 "almond paste": "مَعْجُون لَوْز",
 "almond tree": "شجرة اللوز (أي من عدة أشجار شجيرية صغيرة لها أزهار وردية أو بيضاء وتحمل عادة مكسرات)",
 "almond willow": "صفصاف اللوز (صفصاف من العالم القديم بأوراق خضراء فاتحة يزرع للاستخدام في صناعة السلال)",
 "almond-eyed": "لَوْزِيّ العَيْنَيْن (ذو عينين بشكل اللوزة)",
 "almond-leaves willow": "صفصاف خوخي الأوراق (صفصاف في غرب الولايات المتحدة بأوراق تشبه أوراق أشجار الخوخ أو اللوز)",
 "almond-scented": "بِرَائِحَةِ اللَّوْز (ذُو رَائِحَة اللَّوْز)",
 "almond-shaped": "لَوْزِيُّ الشَّكْلِ, لَوْزِيّ (ذو شكل يشبه حبّة اللوز)",
 "almoner": "أخصائي اجتماعي طبي, مسؤول التبرعات (مسؤول في مستشفى بريطاني يعتني بالاحتياجات الاجتماعية والمادية للمرضى)",
 "almoravid": "مُرابِطِيّ (عضو في سلالة إسلامية من المحاربين الأمازيغ التي ازدهرت من 1049 إلى 1145 وأسست هيمنة سياسية على شمال غرب أفريقيا وإسبانيا)",
 "almost": "تَقْرِيبًا, عَلَى وَشْك",
 "alms": "صَدَقَة, خَيْر",
 "alms box": "صندوق الصدقات (صندوق لجمع الصدقات، خاصة الموجود في الكنيسة)",
 "alms dish": "طبق الصدقات (صينية لجمع التبرعات من الجماعة)",
 "alms tray": "طبق الصدقات (صينية لجمع التبرعات من الجماعة)",
 "alms-giving": "إيتاء الصدقة, تصدق (تقديم مساهمات طوعية لمساعدة الفقراء)",
 "almsgiver": "متصدق, مزكي (شخص يعطي الصدقات)",
 "almsgiving": "إيتاء الصدقة, تصدق (تقديم مساهمات طوعية لمساعدة الفقراء)",
 "alnico": "ألنيكو (اسم تجاري لسبيكة تستخدم لصنع مغناطيسات دائمة عالية الطاقة؛ تحتوي على الألمنيوم والحديد والنيكل بالإضافة إلى الكوبالت أو النحاس أو التيتانيوم)",
 "alnus crispa": "نغت أخضر (شجيرة من أمريكا الشمالية بأوراق خضراء فاتحة وجوز مجنح)",
 "alnus glutinosa": "نغت أسود أوروبي, نغت دابق (شجرة متوسطة الحجم بلحاء بني أسود وعناقيد ثمرية خشبية؛ الأوراق مشعرة من الأسفل)",
 "alnus incana": "نغت رمادي (موطنه أوروبا ولكن أدخل إلى أمريكا)",
 "alnus maritima": "نغت بحري (شجيرة أو شجرة صغيرة من جنوب شرق الولايات المتحدة لها خشب بني فاتح ناعم)",
 "alnus rhombifolia": "نغت أبيض, نغت جبلي (شجرة من غرب الولايات المتحدة)",
 "alnus rubra": "نغت أحمر (شجرة كبيرة من ساحل المحيط الهادئ لأمريكا الشمالية لها خشب أحمر صلب يستخدم كثيراً للأثاث)",
 "alnus rugosa": "نغت مرقط (شجيرة شائعة في كندا وشمال شرق الولايات المتحدة لها براعم متناثرة بزغب بلون الصدأ)",
 "alnus serrulata": "نغت ناعم (شجيرة شائعة في شرق الولايات المتحدة بلحاء ناعم)",
 "alnus veridis crispa": "نغت أخضر (شجيرة من أمريكا الشمالية بأوراق خضراء فاتحة وجوز مجنح)",
 "alnus viridis": "نغت أخضر (شجيرة من المناطق الجبلية في أوروبا)",
 "alnus vulgaris": "نغت أسود أوروبي, نغت دابق (شجرة متوسطة الحجم بلحاء بني أسود وعناقيد ثمرية خشبية؛ الأوراق مشعرة من الأسفل)",
 "alocasia": "أذن الفيل, ألوكاسيا (أي نبات من جنس الألوكاسيا ذو أوراق قاعدية كبيرة مبهرجة وقنابة قاربيه الشكل وتوت محمر)",
 "alocasia macrorrhiza": "ألوكاسيا, قلقاس عملاق (نبات دائم الخضرة كبير بأوراق منتصبة أو منتشرة كبيرة جداً؛ يزرع على نطاق واسع في المناطق الاستوائية لجذموره وبراعمه الصالحة للأكل؛ يستخدم في المناطق…)",
 "alodia": "علوة",
 "aloe": "أَلْوَة, صَبْر",
 "aloe ferox": "صبار الكاب (نبات جنوب أفريقي كثير التفرع ذو أوراق عصارية شائكة محمرة)",
 "aloe vera": "صَبِر, صَبِر حَقِيقِيّ ((صَبَرَ) يَصْبِرُ صَبْرًا: تجلَّد ولم يَجْزَع؛ (صَبَرَ): انتظر في هدوء واطمئنان)\nمثال: الصبر أم العلوم.",
 "aloes": "صبار, صبار مر (مسهل مصنوع من أوراق الصبار)",
 "aloft": "في الأعالي, في الجو (في الغلاف الجوي الأعلى فوق الأرض) / عالياً, مرتفعاً (في أو إلى ارتفاع كبير؛ عالياً في الهواء) / صعوداً, نحو الأعلى / على الصارية, فوق (عند أو على أو إلى رأس الصارية أو الحبال العليا للسفينة)\nمثال: الظروف الجوية في الأعلى جيدة",
 "aloha": "أَلُوهَا, تْشَاو (إقرار يمكن استخدامه لقول مرحبًا أو وداعًا)",
 "alone": "وَحِيد, مُنْفَرِد",
 "aloneness": "انطواء, عزلة (ميل نحو البقاء وحيداً)",
 "along": "عَلَى طُول (يفيد الاستعلاء؛ يفيد التعليل) / بِالتَّوَازِي مَعَ\nمثال: أجب على السؤال.",
 "along the lines of": "عَلَى غِرَار (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال.",
 "along with": "تَضَامُنًا مَعَ",
 "alongside": "تَزَامُنًا",
 "aloof": "بَعِيدًا عَنّ, بِمَعْزِل عَن",
 "aloofness": "انعزال, تحفظ (الميل لكون المرء بعيداً وغير متعاطف في أسلوبه) / انعزال, ترفع (اللامبالاة عن طريق الانسحاب الشخصي)\nمثال: مسافة عاطفية",
 "alopecia": "ثَعْلَبَة, حَاصَّة (مؤنث ثَعْلَب؛ اسم لمَرَض يصيب فروة الرأس ويسبب سقوط الشعر والصَلَع)",
 "alopecia areata": "ثعلبة بقعية (صلع متقطع (على شكل بقع))",
 "alopecic": "ثعلبي, صلعي (متعلق بفقدان الشعر أو الصوف أو الريش)",
 "alopecurus pratensis": "ذيل الثعلب المروجي (عشب معمر منتصب قوي من الأجزاء الشمالية للعالم القديم له سنابل مزهرة حريرية؛ يزرع على نطاق واسع للمراعي والتبن؛ متوطن في أمريكا الشمالية)",
 "alopex lagopus": "ثعلب أبيض, ثعلب قطبي (ثعلب كثيف الفرو من المناطق القطبية؛ بني في الصيف وأبيض في الشتاء)",
 "alopius vulpinus": "قرش دراس (قرش كبير يعيش في عرض البحار الدافئة ذو ذيل يشبه السوط يستخدمه لتجميع الأسماك الصغيرة ليتغذى عليها)",
 "alor setar": "ألور ستار",
 "alosa alosa": "شابل أوروبي (شابل أوروبي)",
 "alosa chrysocloris": "شابل نهري (شابل يضع بيضه في جداول حوض المسيسيبي؛ يشبه الشابل الأمريكي جداً)",
 "alosa pseudoharengus": "ألوف (سمكة غذائية تشبه الشاد تصعد الأنهار للتكاثر؛ غالباً ما تُملح أو تدخن)",
 "alosa sapidissima": "شابل أمريكي (شابل من ساحل المحيط الأطلسي لأمريكا الشمالية؛ تم توطينه في ساحل المحيط الهادئ)",
 "aloud": "بصوت عالٍ, جهراً (باستخدام الصوت؛ ليس صمتاً) / بصوت عال, بصوت مرتفع (بحجم صوت مرتفع نسبياً)\nمثال: يرجى قراءة المقطع بصوت عالٍ",
 "alp": "ألب, جبل عالٍ (أي جبل مرتفع)",
 "alpaca": "أَلْبَكَة",
 "alpenglow": "شَفَق أَلْبِيّ ((شَفِقَ) منه، وعليه يَشْفَقَ شَفَقًا: خاف وحَذِرَ، فهو شَفِقٌ؛ (شَفِقَ) عليه: رَقَّ له وعطف عليه؛ فهو شَفِيقٌ)\nمثال: أثارت تلك السلحفاة شفقة زيري.",
 "alpenstock": "عصا الألب, عصا التسلق (عصا قوية ذات طرف معدني؛ يستخدمها متسلقو الجبال)",
 "alpestrine": "شِبْه أَلْبِيّ (ينمو على ارتفاعات عالية دون خطّ الأشجار)",
 "alpha": "أَلْفَا",
 "alpha and omega": "اَلْأَلْف وَالْيَاء",
 "alpha blocker": "حاصر ألفا, مناهض ألفا الأدرينالي (أي من الأدوية المختلفة التي تحجب مستقبلات ألفا الأدرينالية؛ تستخدم في علاج تضخم البروستاتا الحميد؛ ترخي عضلات البروستاتا والمثانة)",
 "alpha brass": "نحاس أصفر ألفا (سبيكة من النحاس والزنك؛ تستخدم بشكل أساسي للتشكيل على البارد)",
 "alpha bronze": "برونز ألفا (سبيكة من النحاس والقصدير يمكن تشكيلها)",
 "alpha centauri": "رِجْل قِنْطَوْر (العُضْو في جسد الإنسان يتكون من القَدَم والسَاق والفُخْذ. الجمع أرجُل، وقد تقول العامّة رِجْلين ورجْلينات؛ القَدَم من باب اطلاق اسم الكل على الجزء)\nمثال: هذا الرجل تاجر.",
 "alpha decay": "اضمحلال ألفا (اضمحلال إشعاعي لنواة ذرية مصحوب بانبعاث جسيم ألفا)",
 "alpha fetoprotein": "ألفا فيتو بروتين, البروتين الجنيني ألفا (كمية كبيرة غير طبيعية من هذا البروتين الجنيني في الجنين يمكن أن تشير إلى خلل في الأنبوب العصبي (مثل السنسنة المشقوقة))",
 "alpha foetoprotein": "ألفا فيتو بروتين, البروتين الجنيني ألفا (كمية كبيرة غير طبيعية من هذا البروتين الجنيني في الجنين يمكن أن تشير إلى خلل في الأنبوب العصبي (مثل السنسنة المشقوقة))",
 "alpha globulin": "ألفا غلوبولين (غلوبولين في بلازما الدم أو المصل يكون قلوياً وله قابلية عالية للحركة الكهربائية)",
 "alpha iron": "حديد ألفا (تآصل مغناطيسي للحديد؛ مستقر تحت 906 درجة مئوية)",
 "alpha male": "أَلْفَا, حَيَوان أَلْفَا / فَحْل, رَجُل أَلْفَا",
 "alpha methyl dopa": "ألدوميت, ميثيل دوبا (دواء خافض لضغط الدم (الاسم التجاري ألدوميت) يستخدم في علاج ارتفاع ضغط الدم)",
 "alpha particle": "جُسَيْم أَلْفَا (جسيم مشحون إيجابياً وهو نواة ذرة الهيليوم؛ ينبعث من النظائر الطبيعية أو المشعة)",
 "alpha privative": "ألف السلب (العدد الذي يساوي عَشْر مِئَات. يُذَكَّر بإعتبار لفظه المذكر وإذا كان عن النُقُود يؤنث بإعتبار أن النقود مؤنثه)\nمثال: ألف شكر على لطفك.",
 "alpha radiation": "أشعة ألفا, إشعاع ألفا (إشعاع جسيمات ألفا أثناء التحلل الإشعاعي)",
 "alpha ray": "أشعة ألفا, إشعاع ألفا (إشعاع جسيمات ألفا أثناء التحلل الإشعاعي)",
 "alpha receptor": "مستقبل أدرينالي ألفا, مستقبل ألفا (مستقبلات يفترض وجودها على أغشية الخلايا العصبية للجهاز العصبي الودي لتفسير خصوصية بعض العوامل التي تؤثر فقط على بعض الأنشطة الودية (مثل تضيق الأوعية…)",
 "alpha rhythm": "إيقاع ألفا, موجة ألفا (الموجة الدماغية الطبيعية في مخطط كهربية الدماغ لشخص مستيقظ ولكنه مسترخٍ؛ تحدث بتردد 8-12 هرتز)",
 "alpha software": "برنامج ألفا, نسخة ألفا (الإصدار الأول لمنتج برمجي والذي يُختبر عادةً من قبل المطورين فقط)",
 "alpha test": "اختبار ألفا ((علوم الكمبيوتر) اختبار أول لمنتج تجريبي (مثل برامج الكمبيوتر) يجريه المطور)",
 "alpha wave": "إيقاع ألفا, موجة ألفا (الموجة الدماغية الطبيعية في مخطط كهربية الدماغ لشخص مستيقظ ولكنه مسترخٍ؛ تحدث بتردد 8-12 هرتز)",
 "alpha-adrenergic blocker": "حاصر ألفا, مناهض ألفا الأدرينالي (أي من الأدوية المختلفة التي تحجب مستقبلات ألفا الأدرينالية؛ تستخدم في علاج تضخم البروستاتا الحميد؛ ترخي عضلات البروستاتا والمثانة)",
 "alpha-adrenergic blocking agent": "حاصر ألفا, مناهض ألفا الأدرينالي (أي من الأدوية المختلفة التي تحجب مستقبلات ألفا الأدرينالية؛ تستخدم في علاج تضخم البروستاتا الحميد؛ ترخي عضلات البروستاتا والمثانة)",
 "alpha-adrenergic receptor": "مستقبل أدرينالي ألفا, مستقبل ألفا (مستقبلات يفترض وجودها على أغشية الخلايا العصبية للجهاز العصبي الودي لتفسير خصوصية بعض العوامل التي تؤثر فقط على بعض الأنشطة الودية (مثل تضيق الأوعية…)",
 "alpha-adrenoceptor": "مستقبل أدرينالي ألفا, مستقبل ألفا (مستقبلات يفترض وجودها على أغشية الخلايا العصبية للجهاز العصبي الودي لتفسير خصوصية بعض العوامل التي تؤثر فقط على بعض الأنشطة الودية (مثل تضيق الأوعية…)",
 "alpha-beta brass": "معدن مونتز, نحاس أصفر ألفا-بيتا (نحاس أصفر يحتوي على زنك أكثر ويكون أقوى من نحاس ألفا؛ يستخدم في صنع المسبوكات والمنتجات المشكلة على الساخن)",
 "alpha-blocker": "حاصر ألفا, مناهض ألفا الأدرينالي (أي من الأدوية المختلفة التي تحجب مستقبلات ألفا الأدرينالية؛ تستخدم في علاج تضخم البروستاتا الحميد؛ ترخي عضلات البروستاتا والمثانة)",
 "alpha-fe": "حديد ألفا (تآصل مغناطيسي للحديد؛ مستقر تحت 906 درجة مئوية)",
 "alpha-ferrite": "حديد ألفا (تآصل مغناطيسي للحديد؛ مستقر تحت 906 درجة مئوية)",
 "alpha-interferon": "ألفا إنترفيرون (شكل من أشكال الإنترفيرون يتم إنتاجه داخلياً وتجارياً لتأثيراته الدوائية (بما في ذلك تنظيم الجهاز المناعي وتأثيراته المضادة للفيروسات والمضادة للأورام))",
 "alpha-linolenic acid": "حمض ألفا-لينولينيك (حمض دهني متعدد غير مشبع يحتوي على 18 ذرة كربون؛ حمض أوميغا 3 الدهني الوحيد الموجود في المنتجات النباتية؛ وهو أكثر وفرة في زيت الكانولا؛ حمض دهني…)",
 "alpha-lipoprotein": "بروتين دهني عالي الكثافة (بروتين دهني ينقل الكوليسترول في الدم؛ يتكون من نسبة عالية من البروتين وقليل نسبياً من الكوليسترول؛ يُعتقد أن المستويات العالية منه ترتبط بانخفاض خطر…)",
 "alpha-naphthol": "ألفا-نافثول (متصاوغ للنافثول يستخدم في الأصباغ)",
 "alpha-naphthol test": "اختبار موليش, كاشف موليش (مؤشر بيوكيميائي لوجود الكربوهيدرات في المحلول؛ في حال وجود الكربوهيدرات تتشكل حلقة بنفسجية)",
 "alpha-terpinene": "ألفا-تيربينين (هيدروكربون متصاوغ معزول من زيوت الهيل والمردقوش، وكذلك من مصادر طبيعية أخرى)\nمثال: ألفا-تيربينين مادة كيميائية للعطور والنكهات تُستخدم في مستحضرات التجميل والصناعات الغذائية",
 "alpha-tocopheral": "ألفا توكوفيرول (شكل قوي من فيتامين هـ يتم الحصول عليه من زيوت الأجنة أو عن طريق التصنيع)",
 "alphabet": "حُرُوف هِجَاء, أَبْجَد (صِيْغَةُ جَمْعٍ مُفْرَدُهَا: حرف)\nمثال: كيف أتذكر الحروف الصينية؟",
 "alphabet soup": "شوربة الحروف (حساء يحتوي على معكرونة صغيرة على شكل حروف الأبجدية) / خليط مربك, شوربة الحروف (تشكيلة مربكة (وخاصة من الاختصارات))\nمثال: أنشأ روزفلت خليطاً مربكاً من الوكالات الفيدرالية",
 "alphabetic": "أَبْجَدِيّ, هِجَائِيّ (مرتب بالترتيب وفقاً للأبجدية) / أبجدي, ألفبائي (يتعلق بـ أو يُعبر عنه بنظام كتابة يستخدم الأبجدية)\nمثال: ترتيب أبجدي",
 "alphabetic character": "حرف, حرف أبجدي (الأحرف التقليدية للأبجدية المستخدمة لتمثيل الكلام)\nمثال: علمته جدته الحروف",
 "alphabetic script": "كتابة أبجدية (نظام كتابة يعتمد على الحروف الأبجدية)",
 "alphabetic writing": "كتابة أبجدية (نظام كتابة يعتمد على الحروف الأبجدية)",
 "alphabetical": "أَلِفْبَائِيّ, أَبْجَدِيّ",
 "alphabetically": "أَبْجَدِيًّا",
 "alphabetisation": "ترتيب أبجدي (فعل الوضع بالترتيب الأبجدي)",
 "alphabetised": "مُرَتَّب أَبْجَدِيًّا (تمّ وضعه في ترتيب أبجدي)",
 "alphabetiser": "مفهرس أبجدي (شخص متعلم يستطيع ترتيب العناصر بترتيب أبجدي)",
 "alphabetization": "ترتيب أبجدي (فعل الوضع بالترتيب الأبجدي)",
 "alphabetized": "مُرَتَّب أَبْجَدِيًّا (تمّ وضعه في ترتيب أبجدي)",
 "alphabetizer": "مفهرس أبجدي (شخص متعلم يستطيع ترتيب العناصر بترتيب أبجدي)",
 "alphameric": "أبجدي رقمي (من أو متعلق بالأحرف الأبجدية والأرقام)",
 "alphamerical": "أبجدي رقمي (من أو متعلق بالأحرف الأبجدية والأرقام)",
 "alphanumeric": "أبجدي رقمي (من أو متعلق بالأحرف الأبجدية والأرقام)",
 "alphanumeric characters": "محارف أبجدية رقمية (مجموعة أحرف تتضمن الحروف والأرقام وعلامات الترقيم)",
 "alphanumeric display": "شاشة رقمية (شاشة تعرض المعلومات في شكل أحرف (أرقام أو حروف))",
 "alphanumerical": "أبجدي رقمي (من أو متعلق بالأحرف الأبجدية والأرقام)",
 "alphanumerics": "محارف أبجدية رقمية (مجموعة أحرف تتضمن الحروف والأرقام وعلامات الترقيم)",
 "alphavirus": "أَلْفَافَيْرُوس",
 "alpine": "أَلْبِيّ (يعيش أو ينمو فوق خطّ الأشجار) / ألبي (يتعلق بجبال الألب وسكانها) / ألبي (يتعلق بالجبال العالية أو يميزها)\nمثال: دول جبال الألب، سويسرا وإيطاليا وفرنسا وألمانيا",
 "alpine anemone": "شقائق النعمان الألبية, شقائق النعمان الجبلية (عشبة ذات أوراق حريرية في جبال روكي بزهور بيضاء مزرقة)",
 "alpine ash": "بلوط الجبل, مران ألبي (شجرة خشبية طويلة ذات خشب صلب ثقيل وردي أو بني فاتح)",
 "alpine azalea": "أزاليا ألبية, أزاليا جبلية (شجيرة دائمة الخضرة زاحفة تشكل حصيرة من المناطق الجبلية العالية في نصف الكرة الشمالي تزرع لأزهارها الوردية)",
 "alpine bearberry": "عنب الدب الألبي, قطلب ألبي (شجيرة زاحفة متساقطة الأوراق تكون حمراء زاهية في الخريف ولها توت أسود أو أزرق مسود؛ ألبية وقطبية)",
 "alpine besseya": "بيسيا ألبية (نبات شاحب صغير ذو سنابل كثيفة من الزهور البنفسجية المزرقة الشاحبة؛ من المروج الباردة العالية من وايومنغ ويوتا إلى نيو مكسيكو)",
 "alpine celery pine": "صنوبر الكرفس الألبي (صنوبر كرفس شجيري صغير من نيوزيلندا)",
 "alpine clover": "نفل ألبي (نفل جبلي أوروبي ذو أزهار عطرة عادة ما تكون وردية)",
 "alpine clubmoss": "رجل الذئب الألبي (نوع من طحالب النادي يوجد في جميع أنحاء خطوط العرض الشمالية في نصف الكرة الشمالي)",
 "alpine coltsfoot": "حشيشة السعال الألبية (عشب جذموري ذو أزهار حمراء أرجوانية مناسب كغطاء أرضي؛ يوضع أحياناً في جنس توسيلاغو)",
 "alpine enchanter's nightshade": "عشبة الساحرة الألبية (صنف ألبي من عشبة الساحرة)",
 "alpine fir": "شوح ألبي, شوح تحت ألبي (شجرة خشب متوسطة الطول من جبال روكي لها تاج مخروطي ضيق إلى عمودي)",
 "alpine glacier": "نهر جليدي ألبي (نهر جليدي يتحرك نزولاً من وادٍ مرتفع)",
 "alpine gold": "ذهب ألبي, هولسيا (نبات معنقد منخفض له سيقان مشعرة يعلو كل منها رأس زهرة بأشعة صفراء ضيقة قصيرة؛ شمال غرب الولايات المتحدة)",
 "alpine golden chain": "سلسلة ذهبية ألبية, لابورنوم اسكتلندي (شجيرة زينة أو شجرة من جنس لابورنوم)",
 "alpine goldenrod": "عصا الذهب الألبية (عصا ذهب تشبه عصا الذهب الضيقة ولكن لها شعيرات خشنة على حواف سيقان الأوراق؛ المناطق الجبلية في غرب أمريكا)",
 "alpine hulsea": "ذهب ألبي, هولسيا (نبات معنقد منخفض له سيقان مشعرة يعلو كل منها رأس زهرة بأشعة صفراء ضيقة قصيرة؛ شمال غرب الولايات المتحدة)",
 "alpine lady fern": "سرخس السيدة الألبي (سرخس سيدة بقطاعات أوراق مقطوعة بعمق؛ يوجد في جبال روكي)",
 "alpine lift": "مصعد تي بار (مصعد سطحي حيث يمسك الركاب بقضيب ويسحبون إلى أعلى التل وهم على زلاجاتهم)",
 "alpine milk vetch": "قتاد ألبي (نبات معمر في المناطق الجبلية في أوراسيا وأمريكا الشمالية)",
 "alpine mouse-ear": "أذن الفأر الألبي, أذن الفأر القطبي (منتشرة في القطب الشمالي وعلى الجبال في أوروبا)",
 "alpine salamander": "سمندل الألب (برمائي بيوض ولود من جبال الألب)",
 "alpine scurvy": "بلاغرا (مرض ناتج عن نقص النياسين أو التريبتوفان (أو عن خلل في التحويل الأيضي للتريبتوفان إلى نياسين)؛ يتميز باضطرابات الجهاز الهضمي والحمامي واضطرابات عصبية…)",
 "alpine sunflower": "دوار الشمس الألبي, شيخ الجبل (نبات مشعر مبيض بأوراق تشبه الريش وبضعة سيقان قوية تحمل كل منها رأس زهرة صفراء كبيرة وحيدة وجميلة بشكل خاص؛ المناطق الجبلية شمال وسط الولايات المتحدة)",
 "alpine totara": "توتارا ألبية (شجيرة صنوبرية منخفضة واسعة الانتشار في جبال نيوزيلندا)",
 "alpine type of glacier": "نهر جليدي ألبي (نهر جليدي يتحرك نزولاً من وادٍ مرتفع)",
 "alpine woodsia": "وودسيا ألبية, وودسيا شمالية (سرخس نحيل في شمال أمريكا الشمالية بسويقات بلون الكستناء اللامع وسعف ثنائي الريش مع بثرات بوغية هامشية مميزة عادة)",
 "alpinia galanga": "خولنجان (نبات معمر من جنوب شرق آسيا بجذور عطرية)",
 "alpinia officinalis": "خولنجان صغير (نبات صيني معمر ذو عناقيد هرمية من الزهور البيضاء وجذور عطرية لاذعة تستخدم طبياً وكنكهة)",
 "alpinia officinarum": "خولنجان صغير (نبات صيني معمر ذو عناقيد هرمية من الزهور البيضاء وجذور عطرية لاذعة تستخدم طبياً وكنكهة)",
 "alpinia purpurata": "زنجبيل أحمر (زنجبيل زينة موطنه جزر المحيط الهادئ)",
 "alpinia speciosa": "زنجبيل الصدفة, زهرة الصدفة (يزرع لأوراقه المستطيلة اللامعة وعناقيده المقوسة من الزهور البيضاء ذات الظلال الوردية والشفاه الصفراء المجعدة ذات الخطوط الأرجوانية المبرقشة)",
 "alpinia zerumbet": "زنجبيل الصدفة, زهرة الصدفة (يزرع لأوراقه المستطيلة اللامعة وعناقيده المقوسة من الزهور البيضاء ذات الظلال الوردية والشفاه الصفراء المجعدة ذات الخطوط الأرجوانية المبرقشة)",
 "alpinism": "تسلُق الألب (تسلق الجبال (غير مقتصر على جبال الألب))",
 "alpinist": "متسلق جبال الألب (متسلق جبال يتخصص في التسلق الصعب)",
 "alprazolam": "ألبرازولام, زاناكس (عامل مضاد للقلق (الاسم التجاري زاناكس) من فئة البنزوديازيبين)",
 "alps": "جِبَال اَلْأَلْب",
 "alpuente": "البُنْت, الفُنت / طائفة البُنْت, طائفة الفُنت (مؤنث طَائِف؛ التي تطوفُ؛ القطعة أو الجزء من الشيء أو الواحدة منه)",
 "already": "قَد, مِنْ قَبْلُ (يفيد التحقيق. (مع الماضي والمضارع)؛ يفيد التقريب. (مع الماضي)) / لقد\nمثال: قد أثلجت كثيرا.",
 "alright": "بشكل حسن, على ما يرام (بطريقة مرضية أو كافية) / تمام, حسناً (تعبير عن الموافقة يحدث عادة في بداية الجملة) / بالتأكيد, بلا شك (بدون شك (تستخدم لتعزيز تأكيد)) / مَقْبُول ((استخدام غير معياريّ) مُرْضٍ)\nمثال: ستبلي حسناً بمفردها",
 "als": "التصلب الجانبي الضموري (سماكة الأنسجة في المسالك الحركية للحبل الشوكي؛ يؤدي إلى ضمور عضلي تدريجي)",
 "alsace": "أَلْزَاس",
 "alsatian": "كلب الراعي الألماني (سلالة من كلاب الرعي الكبيرة تستخدم في أعمال الشرطة وكدليل للمكفوفين) / ألزاسي (من أو يتعلق بمنطقة الألزاس أو سكانها أو يميزهم) / ألزاسي (مواطن أو ساكن في الألزاس)",
 "also": "أَيْضًا, كَذٰلِكَ",
 "also known as": "المَعْرُوف بِـ, بِاسْم مُسْتَعَار (كما هو معروف أو مسمى في وقت أو مكان آخر)\nمثال: السيد سميث، المعروف بالسيد لافاييت",
 "also-ran": "خاسر, منهزم (متسابق يخسر المسابقة)",
 "alsobia dianthiflora": "إبيسيا, كرمة زهرة الدانتيل (نبات معمر زاحف منخفض النمو في أمريكا الوسطى ذو زهور بيضاء مهدبة بعمق؛ يوضع أحياناً في جنس إبيسيا)",
 "alsophila pometaria": "عثة دودة القياس الخريفية (عثة من أمريكا الشمالية ذكورها رمادية الأجنحة وإناثها عديمة الأجنحة؛ اليرقات هي ديدان القياس الخريفية)",
 "alstonia scholaris": "ديتا, شجرة الشيطان (شجرة دائمة الخضرة من شرق آسيا والفلبين ذات أوراق جلدية كبيرة وأزهار خضراء بيضاء صغيرة في مجموعات كثيفة؛ كان يستخدم لحاؤها طبياً)",
 "alstroemeria": "ألستروميريا (أي من النباتات الأمريكية الجنوبية المختلفة من جنس ألستروميريا التي تقدر لخيماتها الجميلة من الزهور)",
 "alstroemeria pelegrina": "زنبق الإنكا, زنبق بيروفي (عشب من الأنديز له مظلات من زهور وردية أرجوانية مبهرجة تشبه الزنبق)",
 "alt": "اِرْتِفَاع, عُلُوّ (المسافة الزاوية فوق الأفق (خاصة لجرم سماوي))",
 "alt key": "مِفْتَاح التَّبْدِيلِ (مفتاح)\nمثال: بحث عن المفتاح.",
 "alt-right": "اليمين البديل",
 "altace": "ألتاس, راميبريل (مثبط للإنزيم المحول للأنجيوتنسين (الاسم التجاري ألتاس) يستخدم لعلاج ارتفاع ضغط الدم أو لدى بعض المرضى الذين أصيبوا بنوبة قلبية)",
 "altai": "أَلْتَاي, أَلْطَاي",
 "altai republic": "جُمْهُورِيَّة أَلْطَاي, جُمْهُورِيَّة أَلْتَاي",
 "altaic": "أَلْتَائِيّ, أَلْطَائِيّ",
 "altaic language": "اللغات الألطية (مجموعة من اللغات ذات الصلة يتم التحدث بها في آسيا وجنوب شرق أوروبا)",
 "altair": "النَّسْر الطَّائِر",
 "altar": "مَذْبَح, هَيْكَل",
 "altar boy": "خادم المذبح (صبي يخدم كمساعد للكاهن)",
 "altar girl": "فتاة المذبح (فتاة تخدم كمساعدة للكاهن)",
 "altar wine": "نبيذ القربان, نبيذ مقدس (يستخدم في خدمة المناولة (القربان المقدس))",
 "altarpiece": "ستار المذبح, لوحة المذبح الخلفية (ساتر مطلي أو منحوت يوضع فوق وخلف المذبح أو مائدة العشاء الرباني)",
 "altazimuth": "مقياس الارتفاع والسمت (أداة تقيس ارتفاع وسمت الأجرام السماوية؛ تستخدم في الملاحة)",
 "altcoin": "عملة بديلة (عملة مشفرة بديلة)",
 "alter": "غَيَّرَ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "alter ego": "الأنا الآخر, توأم الروح (صديق مقرب جداً وموثوق يبدو وكأنه جزء من نفسك)",
 "alterability": "قَابِلِيَّة لِلتَّعْدِيل (صفة القابلية للتعديل)",
 "alterable": "قَابِل لِلتَّخْفِيف ((للعقوبة القضائيّة) يمكن تغييرها إلى عقوبة أخفّ) / قَابِل لِلتَّعْدِيل, قَابِل لِلتَّغْيِير (قادر على أن يتغير أو يعدل في بعض الخصائص)\nمثال: ملابس قابلة للتعديل",
 "alteration": "تَغَيُّر (صَارَ غير ما كان)\nمثال: هل تغير أي شيء؟",
 "alterative": "شِفائِيّ, عِلاجِيّ (لَه قُدْرَة عَلى الشِّفاء والعِلاج)",
 "altercation": "هَوْشَة, نِزَاع",
 "altered": "مُعَدَّل (هو الأمر الذي جرى عليه تَعْدِيل فهو أفضل من ما يناظره؛ السيارة المعدّلة تسير بسرعة أكبر من مثيلاتها)\nمثال: انخفض معدل الجريمة.",
 "altering": "إخصاء, تعقيم الحيوانات (تعقيم الحيوان)\nمثال: أخذوه إلى الطبيب البيطري للإخصاء",
 "alternanthera philoxeroides": "عشبة التمساح (عشب مائي غزير الإنتاج في أمريكا الجنوبية له أوراق تشبه العشب وسنابل قصيرة من الزهور البيضاء؛ يسد الممرات المائية بكتل عائمة كثيفة)",
 "alternate": "متبادل (للأوراق والفروع ونحوها؛ تظهر أولاً على جانب ثم على الآخر في صفين على طول المحور؛ غير مزدوجة) / بَدِيل (يُستخدَم أو يَخدُم مكان شيء آخر) / بَدِيل, عِوَض (شخص يأخذ مكان شخص آخر)\nمثال: سيقان بأوراق متبادلة",
 "alternately": "بالتناوب (في تسلسل أو وضع متناوب)\nمثال: زرع أشجار التنوب والصنوبر بالتناوب",
 "alternating": "متردد, متناوب ((عن التيار الكهربائي) يعكس اتجاهه)\nمثال: تيار متردد",
 "alternating current": "تَيَّار مُتَرَدِّد",
 "alternating electric current": "تيار متردد (تيار كهربائي يعكس اتجاهه بشكل جيبي)\nمثال: في الولايات المتحدة، معظم التيار المنزلي هو تيار متردد بتردد 60 دورة في الثانية",
 "alternation": "تناوب (تغيير متتالي من شيء أو حالة إلى أخرى والعودة مرة أخرى)",
 "alternation of generations": "تعاقب الأجيال, تولد متباين (تناوب شكلين مختلفين أو أكثر في دورة حياة نبات أو حيوان)",
 "alternative": "بَدِيلِيّ, تَخْيِيرِيّ (يَسْتَلْزِمُ الِاخْتِيَارَ بَيْنَ احْتِمَالَاتٍ مُتَنَافِيَةٍ) / بَدِيل (يَتَعَلَّقُ بِخِيَارَاتٍ غَيْرِ تَقْلِيدِيَّة) / بَدِيل (يُستخدَم أو يَخدُم مكان شيء آخر) / بديل, خيار (واحد من عدد من الأشياء التي يمكن اختيار واحد منها فقط)\nمثال: ما الخيار الذي كان لدي؟",
 "alternative birth": "ولادة بديلة (طريقة للولادة تتجنب الطب عالي التقنية المتطفل لصالح بيئات أكثر طبيعية ومنزلية)",
 "alternative birthing": "ولادة بديلة (طريقة للولادة تتجنب الطب عالي التقنية المتطفل لصالح بيئات أكثر طبيعية ومنزلية)",
 "alternative energy": "طاقة بديلة (طاقة مستمدة من مصادر لا تستنفد الموارد الطبيعية أو تضر بالبيئة)",
 "alternative medicine": "اَلطِّبّ الْبَدِيل",
 "alternative metal": "مِيتَال بَدِيل",
 "alternative pleading": "مرافعة بديلة (مرافعة تدعي وقائع منفصلة جداً بحيث يصعب تحديد الوقائع التي ينوي الشخص الاعتماد عليها)",
 "alternatively": "بدلاً من ذلك, بديلاً عن ذلك (بدلاً من، أو كبديل لـ)\nمثال: أصبح فيليكس عالم زواحف بدلاً من ذلك",
 "alternator": "منوب, مولد تيار متردد (مصطلح قديم لمولد كهربائي ينتج تياراً متردداً (خاصة في السيارات))",
 "althaea": "ألثيا, ختمية (أي من نباتات متنوعة من جنس ألثيا؛ تشبه ولكن بزهور أصغر من جنس ألسيا)",
 "althea": "ألثيا, ختمية (أي من نباتات متنوعة من جنس ألثيا؛ تشبه ولكن بزهور أصغر من جنس ألسيا)",
 "althea officinalis": "ختمية طبية, خطمي مخزني (نبات معمر أوروبي متوطن في الولايات المتحدة ذو أوراق بيضاوية مثلثة وزهور وردية ليلكية)",
