 "art director": "مدير فني (المخرج المسؤول عن الجوانب الفنية لإنتاج مسرحي (الأزياء والمناظر والإضاءة))",
 "art editor": "محرر فني (محرر مسؤول عن الرسوم التوضيحية والتخطيطات في المواد المطبوعة)",
 "art exhibition": "معرض فني (معرض للأعمال الفنية (لوحات أو تماثيل))",
 "art form": "شكل فني ((في العمارة) شكل من أشكال التعبير الفني (مثل الكتابة أو الرسم أو العمارة))",
 "art gallery": "غاليري, معرض فني (غرفة أو سلسلة من الغرف حيث يتم عرض الأعمال الفنية)",
 "art historian": "مُؤَرِّخ الفَنّ, مُؤَرِّخة الفَنّ",
 "art history": "تاريخ الفن (التخصص الأكاديمي الذي يدرس تطور الرسم والنحت)",
 "art informel": "إنفورميل, الفن غير الرسمي (مدرسة فنية فرنسية نشأت في الخمسينيات وتتميز بضربات غير منتظمة وبقع لونية تطبق عشوائياً على القماش؛ تقارن بالتعبيرية التجريدية الأمريكية)\nمثال: حوالي عام 1945، أسس عدد من الرسامين الأوروبيين والأمريكيين مرحلة حاسمة في الفن الحديث تُعرف عموماً باسم الفن غير الرسمي",
 "art movement": "حركة فنية (مجموعة من الفنانين يتفقون على مبادئ عامة)",
 "art nouveau": "آرت نوفو, الفن الجديد (مدرسة فرنسية للفن والعمارة شاعت في تسعينيات القرن التاسع عشر؛ تتميز بأشكال طبيعية منمقة وخطوط متعرجة لأشياء مثل الأوراق والكروم والزهور)",
 "art object": "تحفة فنية, قطعة فنية (عمل فني ذو قيمة فنية ما)\nمثال: يبيع هذا المتجر التحف الفنية فقط",
 "art paper": "ورق صقيل, ورق فني (ورق عالي الجودة (يحتوي عادة على حشوة من الصلصال الصيني))",
 "art rock": "آرت روك, روك تقدمي (نمط من موسيقى الروك ظهر في السبعينيات؛ يرتبط بمحاولات الجمع بين الروك والجاز وأشكال أخرى؛ مخصص للاستماع وليس للرقص)",
 "art school": "مدرسة فنون (مدرسة متخصصة في الفن)",
 "art student": "طالب فنون (شخص يدرس ليصبح فناناً)",
 "art teacher": "معلم فنون (شخص يدرس الفن)",
 "arta": "أَرْتَا",
 "artaxerxes": "أَرْدَشِير",
 "artefact": "صَنِيعَة, مَصْنُوعَة (شيء من صنع الإنسان يُؤخَذ ككلّ متكامل)",
 "artefactual": "اصطناعي, مصنوع (من أو يتعلق بالأشياء التي من صنع الإنسان (اللقى الأثرية))",
 "artemia salina": "روبيان ملحي (شائع في البحيرات المالحة)",
 "artemis": "أَرْتِمِيس",
 "artemis pontica": "شيح روماني (شيح أوروبي؛ مصدر ثانوي للأفسنتين)",
 "artemisia": "أرطماسيا, شيح (أي من الشجيرات أو الأعشاب المركبة المختلفة من جنس الشيح ذات أوراق خضراء أو رمادية عطرية)",
 "artemisia abrotanum": "شيح قيصوم, قيصوم (شيح أوروبي شجيري متوطن في أمريكا الشمالية؛ يستخدم أحياناً في تخمير البيرة)",
 "artemisia absinthium": "أفسنتين, شيح ابن سينا (عشبة عطرية في أوراسيا المعتدلة وشمال أفريقيا ذات طعم مر تستخدم في صنع مشروب الأفسنتين)",
 "artemisia annua": "شيح حلو, شيح حولي (شيح من جنوب شرق أوروبا إلى إيران)",
 "artemisia californica": "شيح كاليفورنيا, ميرمية كاليفورنيا (شجيرة كاليفورنية رمادية منخفضة)",
 "artemisia campestris": "شيح الحقول (شيح أوروبي مشابه للشيح الشائع في خصائصه)",
 "artemisia cana": "شيح فضي, ميرمية فضية (نبات معمر منخفض كثير التفرع في غرب الولايات المتحدة ذو أوراق فضية؛ نبات علف ومأوى مهم)",
 "artemisia dracunculus": "طرخون (نبات معمر عطري من جنوب شرق روسيا)",
 "artemisia filifolia": "شيح فضي, ميرمية الرمل (شجيرة فضية الشعر في وسط وجنوب الولايات المتحدة والمكسيك؛ عشبة ضارة مزعجة في المراعي)",
 "artemisia frigida": "شيح بارد, ميرمية الشيح (نبات معمر عطري حريري الأوراق في المناطق الشمالية الجافة من نصف الكرة الشمالي؛ له زهيرات سمراء)",
 "artemisia gnaphalodes": "شيح لويزيانا, مريمية بيضاء (عشب معمر أبيض قطني من جنوب غرب الولايات المتحدة)",
 "artemisia ludoviciana": "شيح لويزيانا, مريمية بيضاء (عشب معمر أبيض قطني من جنوب غرب الولايات المتحدة)",
 "artemisia maritima": "شيح البحر (نباتات السواحل الأوروبية الغربية والشمالية)",
 "artemisia spinescens": "شيح شائك, فرشاة البراعم (نبات معمر ذو قيمة كعلف للأغنام في الولايات المتحدة)",
 "artemisia stelleriana": "شيح الشاطئ, طاحونة الغبار (عشبة بأوراق رمادية توجد على طول الساحل الشرقي لأمريكا الشمالية؛ تستخدم كنبات زينة)",
 "artemisia tridentata": "شيح ثلاثي الأسنان, ميرمية كبيرة (شجيرة عطرية في المناطق القاحلة بغرب أمريكا الشمالية ذات أوراق شيباء)",
 "artemisia vulgaris": "حبق الراعي, شيح شائع (عشب عطري معمر أوروبي ذو خصلات له سيقان حمراء أو أرجوانية مشعرة وأوراق خضراء داكنة زغبية بيضاء من الأسفل وزهيرات بنية حمراء)",
 "arteria": "شريان, وعاء دموي شرياني (وعاء دموي ينقل الدم من القلب إلى الجسم)",
 "arteria alveolaris": "شريان سنخي (فرع من الشريان الفكي العلوي يغذي النتوء السنخي)",
 "arteria alveolaris inferior": "الشريان السنخي السفلي (الشريان السنخي الذي يمر عبر قناة الفك السفلي لتغذية الأسنان السفلية)",
 "arteria alveolaris superior": "الشريان السنخي العلوي (الشريان السنخي الذي يغذي الأسنان العلوية)",
 "arteria angularis": "الشريان الزاوي (الفرع النهائي للشريان الوجهي)",
 "arteria appendicularis": "شريان زائدي (فرع الشريان اللفائفي القولوني الذي يغذي الزائدة الدودية)",
 "arteria arcuata": "شريان مقوس (شريان منحني في القدم)",
 "arteria ascendens": "شريان صاعد (فرع الشريان اللفائفي القولوني الذي يغذي القولون الصاعد)",
 "arteria auricularis": "شريان أذني (شريان يغذي الأذن بالدم)",
 "arteria axillaris": "شريان إبطي (جزء من الشريان الرئيسي للذراع يقع في الإبط وهو استمرار للشريان تحت الترقوة من الأعلى والشريان العضدي من الأسفل)",
 "arteria basilaris": "شريان قاعدي (شريان غير مزدوج؛ يغذي الجسر والمخيخ والجزء الخلفي من المخ والأذن الداخلية)",
 "arteria brachialis": "شريان عضدي (الشريان الرئيسي للذراع العلوي؛ استمرار للشريان الإبطي؛ يتفرع إلى الشرايين الكعبرية والزندية عند المرفق)",
 "arteria buccalis": "شريان شدقي (فرع من الشريان الفكي العلوي يغذي العضلة المبوقة والخد بالدم)",
 "arteria bulbi penis": "شريان بصلة القضيب (فرع من الشريان الفروجي الداخلي للذكور يغذي بصلة القضيب)",
 "arteria bulbi vestibuli": "شريان بصلة الدهليز (فرع من الشريان الفروجي الداخلي في الإناث يغذي بصلة الدهليز)",
 "arteria carotis": "شريان سباتي (أحد الشريانين الرئيسيين في الرقبة والرأس؛ يتفرع من الأبهر)",
 "arteria celiaca": "جذع زلاقي, شريان زلاقي (شريان ينشأ من الأبهر البطني أسفل الحجاب الحاجز مباشرة ويتفرع إلى الشريان المعدي الأيسر والشريان الكبدي المشترك والشريان الطحالي)",
