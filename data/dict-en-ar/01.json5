 "angas": "أنغاس (لغة تشادية يتم التحدث بها في شمال نيجيريا ووثيقة الصلة بالهوسا)",
 "angas language": "أنغاس (لغة تشادية يتم التحدث بها في شمال نيجيريا ووثيقة الصلة بالهوسا)",
 "angel": "مَلَاك / مَلْأَك / مَلَك (لغة في المَالِك، وهو الذي يَمْلِكُ؛ السُلْطَان الحَاكِم الذي يملك الأَرْض والبِلاد)\nمثال: زيري ملك لنفسه.",
 "angel cake": "كعكة الملاك (كعكة إسفنجية خفيفة مصنوعة بدون صفار البيض)",
 "angel dust": "بي سي بي, غبار الملاك (عقار يستخدم كمخدر من قبل الأطباء البيطريين؛ يؤخذ بشكل غير مشروع (أصلاً في شكل مسحوق أو 'غبار') لتأثيراته كمهلوس)",
 "angel food cake": "كعكة الملاك (كعكة إسفنجية خفيفة مصنوعة بدون صفار البيض)",
 "angel of death": "مَلَك الْمَوْت (لغة في المَالِك، وهو الذي يَمْلِكُ؛ السُلْطَان الحَاكِم الذي يملك الأَرْض والبِلاد) / مَلَك مَوْت (لغة في المَالِك، وهو الذي يَمْلِكُ؛ السُلْطَان الحَاكِم الذي يملك الأَرْض والبِلاد)\nمثال: زيري ملك لنفسه.",
 "angel shark": "قرش ملاك (أسماك قرش ذات أجسام عريضة مسطحة وزعانف صدرية تشبه الأجنحة ولكنها تسبح بطريقة أسماك القرش)",
 "angel's trumpet": "بوق الملاك, داتورا شجرية (نبات من أمريكا الجنوبية يزرع لزهوره الكبيرة العطرة بوقية الشكل) / بروجمانسيا عطرة, بوق الملاك (نبات من أمريكا الجنوبية يزرع لزهوره الكبيرة جداً بوقية الشكل العطرة ليلاً)",
 "angel-wing begonia": "بيغونيا جناح الملاك (بيغونيا ليفية الجذور من أمريكا الجنوبية لها فصوص أوراق قاعدية بارزة توحي بأجنحة الملائكة وعناقيد من الزهور الحمراء المرجانية)",
 "angelfish": "قرش ملاك (أسماك قرش ذات أجسام عريضة مسطحة وزعانف صدرية تشبه الأجنحة ولكنها تسبح بطريقة أسماك القرش) / سمكة المجرفة (سمكة غذائية عميقة الجسم قرصية الشكل تعيش في المياه الساحلية الدافئة لغرب المحيط الأطلسي) / سمكة الملاك (مصطلح شمولي لأي حيوان فقاري مائي خيشومي التنفس)\nمثال: سمكة ميناد ماتت",
 "angelic": "قِدِّيسِيّ, مَلَائِكِيّ (يتسم بالطيبة المطلقة؛ يشبه أو يليق بملاك أو قديس) / عَذْب, مَلَائِكِيّ (ذو طبيعة لطيفة تليق بملاك أو كروب) / ملائكي (متعلق بالملائكة)\nمثال: رسول ملائكي",
 "angelica": "حَشِيشَة المَلَاك",
 "angelica archangelica": "أنجليكا بستانية, حشيشة الملاك (عشب ثنائي الحول مزروع؛ سيقانه تسكر وتؤكل وجذوره تستخدم طبياً)",
 "angelica sylvestris": "أنجليكا برية, حشيشة الملاك البرية (عشب أوروبي بأوراق مركبة وزهور بيضاء؛ دخيل على جزيرة كيب بريتون)",
 "angelical": "قِدِّيسِيّ, مَلَائِكِيّ (يتسم بالطيبة المطلقة؛ يشبه أو يليق بملاك أو قديس) / عَذْب, مَلَائِكِيّ (ذو طبيعة لطيفة تليق بملاك أو كروب) / ملائكي (متعلق بالملائكة)\nمثال: رسول ملائكي",
 "angelically": "كَمَلَاك (مثل الملاك)\nمثال: كان الطفل نائماً كملاك",
 "angelim": "أنجيليم (أي من الأشجار الاستوائية الأمريكية المتعددة من جنس أنديرا)",
 "angelique": "أنجليكا, حشيشة الملاك",
 "angelology": "علم الملائكة (فرع اللاهوت المعني بالملائكة)",
 "angelus": "جرس التبشير (صوت جرس يدق في الكنائس الكاثوليكية للإعلان عن وقت تلاوة التبشير)",
 "angelus bell": "جرس التبشير (صوت جرس يدق في الكنائس الكاثوليكية للإعلان عن وقت تلاوة التبشير)",
 "anger": "غَضَب / أَغْضَبَ / غَضِبَ",
 "angered": "ثَائِر, مُسْتَشِيط (يتّسم بغضب شديد بالغ الحدّة)",
 "angevin": "أنجوفي (مقيم في أنجو)",
 "angevine": "أنجوفي (مقيم في أنجو)",
 "angiitis": "التهاب وعائي (التهاب في وعاء دموي أو قناة ليمفاوية)",
 "angina": "ذَبْحَة صَدْرِيَّة (حادثة ذَبْح واحدة؛ الوجع في الحلق كأن به سكين. استخدام قديم)",
 "angina pectoris": "ذَبْحَة صَدْرِيَّة (حادثة ذَبْح واحدة؛ الوجع في الحلق كأن به سكين. استخدام قديم)",
 "anginal": "ذبحي (من أو متعلق بألم الذبحة الصدرية)",
 "anginose": "ذبحي (من أو متعلق بألم الذبحة الصدرية)",
 "anginous": "ذبحي (من أو متعلق بألم الذبحة الصدرية)",
 "angiocardiogram": "مخطط الأوعية القلبية (سلسلة من صور الأشعة السينية تمثل عمل القلب وأوعيته الدموية بعد حقن مادة ظليلة للأشعة)",
 "angiocarp": "نبات مغلف الثمار (شجرة تحمل ثماراً محاطة بقشرة أو غلاف أو قشور)",
 "angiocarpic": "مغطى الثمار (يمتلك ثمرة أو يكون ثمرة مغطاة بقشرة أو غلاف)",
 "angiocarpous": "مغطى الثمار (يمتلك ثمرة أو يكون ثمرة مغطاة بقشرة أو غلاف)",
 "angioedema": "وذمة وعائية (مناطق محددة كبيرة متكررة من وذمة تحت الجلد؛ تبدأ فجأة وتختفي خلال 24 ساعة؛ تظهر بشكل رئيسي عند الشابات، غالباً كرد فعل تحسسي للطعام أو الأدوية)",
 "angiogenesis": "تكون الأوعية الدموية (تكوين أوعية دموية جديدة)",
 "angiogenesis inhibitor": "مثبط تكوين الأوعية الدموية (دواء مصمم لمنع نمو الأوعية الدموية التي تغذي الأورام)",
 "angiogram": "صورة الأوعية الدموية (تمثيل بالأشعة السينية للأوعية الدموية يتم إجراؤه بعد حقن مادة ظليلة للأشعة)\nمثال: يتم إنتاج صور الأوعية الدموية عن طريق تصوير الأوعية",
 "angiography": "تصوير الأوعية (فحص بالأشعة السينية للأوعية الدموية بعد حقن وسيط تباين غير شفاف للأشعة)",
 "angiohemophilia": "مرض فون ويليبراند (شكل من أشكال الهيموفيليا اكتشفه إريك فون ويليبراند؛ وهو اضطراب وراثي ينتقل كصفة جسدية متنحية؛ يتميز بنقص في عامل التخثر ونزيف الغشاء المخاطي)",
 "angiologist": "أخصائي أوعية دموية (طبيب متخصص في علم الأوعية الدموية)",
 "angiology": "علم الأوعية الدموية (فرع العلوم الطبية الذي يدرس الأوعية الدموية والليمفاوية واضطراباتها)",
 "angioma": "ورم وعائي (ورم يتكون من كتلة من الأوعية الدموية أو الليمفاوية)",
 "angiomatous": "ورمي وعائي (من أو متعلق بـ أو مصاب بورم من النوع المعروف باسم الورم الوعائي)",
 "angiopathy": "اعتلال وعائي (أي مرض يصيب الأوعية الدموية أو القنوات الليمفاوية)",
 "angioplasty": "رأب الوعاء (عملية لإصلاح وعاء دموي تالف أو فتح شريان تاجي مسدود)",
 "angiopteris": "أنجيوبتريس, سرخس عملاق (نوع متغير للغاية من السراخس البدائية الكبيرة جداً في المناطق الاستوائية بالمحيط الهادئ ذات الأمطار الغزيرة)",
 "angiopteris evecta": "أنجيوبتريس, سرخس عملاق (نوع متغير للغاية من السراخس البدائية الكبيرة جداً في المناطق الاستوائية بالمحيط الهادئ ذات الأمطار الغزيرة)",
 "angiosarcoma": "ساركومة وعائية (ورم خبيث نادر ينشأ من الأنسجة الوعائية؛ يحدث عادة في الثدي والجلد ويُعتقد أنه ينشأ من الخلايا البطانية للأوعية الدموية)",
 "angioscope": "منظار الأوعية (مجهر معدل يستخدم لدراسة الأوعية الشعرية)",
 "angiosperm": "كاسيات البذور, نباتات مزهرة (نباتات توجد بذورها داخل مبيض مغلق)",
 "angiospermous": "مغطى البذور (من أو متعلق بـ أو من خصائص النباتات كاسيات البذور)",
 "angiospermous tree": "شجرة كاسية البذور, شجرة مزهرة (أي شجرة تحتوي على بذور وبويضات داخل المبيض)",
 "angiospermous yellowwood": "خشب أصفر كاسي البذور (أي من الأشجار كاسية البذور المتنوعة ذات الخشب الأصفر)",
 "angiotelectasia": "توسع الأوعية الانتهائي, توسع الشعيرات (تمدد وتضخم الشرايين الصغيرة)",
 "angiotensin": "أنجيوتنسين, أنجيوتونين (أي من عدة مواد مقبضة للأوعية تسبب تضيق الأوعية الدموية)",
 "angiotensin converting enzyme": "إنزيم محول للأنجيوتنسين",
 "angiotensin i": "أنجيوتنسين 1 (شكل غير نشط فسيولوجياً من الأنجيوتنسين وهو السلف للأنجيوتنسين 2)",
 "angiotensin ii": "أنجيوتنسين 2 (عامل قوي رافع للضغط يتكون من الأنجيوتنسين 1)",
 "angiotensin ii inhibitor": "مثبط الأنجيوتنسين 2 (عامل يؤخر أو يكبح عمل الأنجيوتنسين 2)",
 "angiotensin-converting enzyme": "إنزيم محول للأنجيوتنسين",
 "angiotensin-converting enzyme inhibitor": "مثبط الإنزيم المحول للأنجيوتنسين (دواء خافض لضغط الدم يمنع تكوين الأنجيوتنسين 2 في الكلى، مما يؤدي إلى استرخاء الشرايين؛ يعزز إخراج الملح والماء عن طريق تثبيط نشاط الإنزيم المحول…)",
 "angiotonin": "أنجيوتنسين, أنجيوتونين (أي من عدة مواد مقبضة للأوعية تسبب تضيق الأوعية الدموية)",
 "angkor wat": "أَنْغْكُور وَات",
 "angle": "زَاوِيَة",
 "angle bracket": "زاوية حديدية, كتيفة زاوية / قوس زاوية (إحدى علامتي الترقيم  المستخدمة في برمجة الكمبيوتر وتستخدم أحياناً لتطويق مادة نصية)",
 "angle grinder": "جَلَّاخَة زَاوِيَةٍ",
 "angle iron": "زاوية حديدية, كتيفة زاوية",
 "angle of attack": "زاوية الهجوم (الزاوية الحادة بين اتجاه الرياح النسبية غير المضطربة ووتر الجنيح)",
 "angle of dip": "زاوية الميل, ميل مغناطيسي ((في الفيزياء) الزاوية التي تصنعها الإبرة المغناطيسية مع مستوى الأفق)",
 "angle of extinction": "زاوية الانطفاء (الزاوية من محورها التي يجب تدوير البلورة بها قبل أن تظهر مظلمة إلى أقصى حد عند رؤيتها في الضوء المستقطب)",
 "angle of incidence": "زاوية السقوط, زاوية الورود (الزاوية التي يصنعها خط مع خط عمودي على السطح عند نقطة السقوط)",
 "angle of inclination": "زاوية الميل, ميل ((هندسة) الزاوية التي يشكلها المحور السيني وخط معين (مقاسة عكس اتجاه عقارب الساعة من النصف الموجب للمحور السيني))",
 "angle of reflection": "زاوية الانعكاس (الزاوية بين شعاع منعكس وخط عمودي على السطح العاكس عند نقطة السقوط)",
 "angle of refraction": "زاوية الانكسار (الزاوية بين شعاع منكسر وخط عمودي على السطح بين الوسطين عند نقطة الانكسار)",
 "angle of view": "زاوية الرؤية, زاوية النظر (الزاوية التي تغطيها عدسة التصوير الفوتوغرافي)",
 "angle vise": "ملزمة زاوية (ملزمة يمكنها تثبيت قطعة العمل بزوايا مختلفة (توفر عادة تعديلاً كاملاً بمقدار 90 درجة))",
 "angle-closure glaucoma": "زرق حاد, زرق مغلق الزاوية (زرق (غلوكوما) تقوم فيه القزحية بسد تدفق الخلط المائي)\nمثال: يمكن للزرق مغلق الزاوية أن يسبب تراكمًا سريعًا لضغط العين المرتفع مما يؤدي إلى تلف بصري دائم في غضون يومين",
 "angled": "ذُو زَاوِيَة, مُزَوًّى (يُشكِّل زاوية أو موضوع بزاوية)",
 "angled loofah": "لوف مضلع (لوف باكستاني؛ يزرع على نطاق واسع في جميع أنحاء المناطق الاستوائية)",
 "angledozer": "جرافة زاوية (جرافة بلوح تشكيل مائل لدفع التربة إلى جانب واحد)",
 "angler": "سمكة الصنارة, سمكة الصياد (أسماك لها أفواه كبيرة مع خيط يشبه الدودة متصل بها لجذب الفريسة) / صياد بالسنارة (صياد يستخدم الخطاف والخيط) / صياد الفرص, مخادع (شخص متآمر؛ شخص يخطط للحصول على ميزة)",
 "angler fish": "سمكة الصنارة, سمكة الصياد (أسماك لها أفواه كبيرة مع خيط يشبه الدودة متصل بها لجذب الفريسة)",
 "anglerfish": "سمكة الصنارة, سمكة الصياد (أسماك لها أفواه كبيرة مع خيط يشبه الدودة متصل بها لجذب الفريسة)",
 "anglewing": "فراشة زاوية الجناح (فراشة من الحورائيات لها شقوق زاوية على الحواف الخارجية للأجنحة الأمامية)",
 "angleworm": "دودة الأرض (دودة برية تحفر في التربة وتساعد في تهويتها؛ تظهر غالباً عندما تكون الأرض باردة أو رطبة؛ تستخدم كطعم من قبل الصيادين)",
 "anglian": "الأنجلية (تضم لهجتي مرسيا ونورثمبريا، وهما اثنتان من اللهجات الرئيسية للإنجليزية القديمة وتصنفان معًا في كثير من الأحيان على أنها لهجات أنجلية)",
 "anglican": "أنجليكاني (من أو يخص أو يميز الكنيسة الأنجليكانية) / أنجليكاني (بروتستانتي يتبع المذهب الأنجليكاني)\nمثال: أسقف أنجليكاني",
 "anglican catholic": "كاثوليكي أنجليكاني (عضو في الكنيسة الأنجليكانية يؤكد على طابعها الكاثوليكي)",
 "anglican church": "الكنيسة الإنجليكانية, كنيسة إنجلترا (الكنيسة الوطنية لإنجلترا (وجميع الكنائس الأخرى في بلدان أخرى تشاركها معتقداتها)؛ مقرها في كانتربري والملك هو رئيسها الزمني)",
 "anglican communion": "الِٱتِّحَاد الأَنْجِلِيكَانِيّ",
 "anglicanism": "أنجليكانية (إيمان وعقيدة وممارسة الكنيسة الأنجليكانية)",
 "anglicisation": "أَنْجَلَة",
 "anglicise": "تَأَنْجَلَ",
 "anglicism": "بريطانية, تقليد إنجليزي (عادة خاصة بإنجلترا أو مواطنيها) / تعبير بريطاني (تعبير يُستخدم في بريطانيا العظمى (خاصة عند مقارنته بالإنجليزية الأمريكية))",
 "anglicization": "أنجلة (جعل الشيء إنجليزياً في مظهره)",
 "angling": "صيد بالصنارة (صيد الأسماك بخطاف وخيط (وعادة صنارة))",
 "anglo-american": "أنجلو-أمريكي (أمريكي ولد في بريطانيا أو من أجداد بريطانيين)",
 "anglo-catholic": "أنجلو-كاثوليكي (مؤيد للكنيسة الأنجليكانية)",
 "anglo-catholicism": "أنجلو-كاثوليكية (عقيدة وممارسة داخل كنيسة إنجلترا تؤكد على التقليد الكاثوليكي)",
 "anglo-egyptian sudan": "السُّودَان الْإِنْجْلِيزِيّ الْمِصْرِيّ (دولة في شمال شرق إفريقيا؛ عاصمتها الْخُرْطُوم، واسمها الرسمي جمهورية السودان)\nمثال: السودان جمهورية.",
 "anglo-french": "الأنجلو فرنسية, الأنجلو نورماندية (اللغة الفرنسية (النورماندية) المستخدمة في إنجلترا في العصور الوسطى)",
 "anglo-french language": "الأنجلو فرنسية, الأنجلو نورماندية (اللغة الفرنسية (النورماندية) المستخدمة في إنجلترا في العصور الوسطى)",
 "anglo-german concertina": "كونسرتينا أنجلو-ألمانية (كونسرتينا ذات منفاخ وأزرار على كلا الطرفين)",
 "anglo-indian": "أنجلو-هندي (متعلق بالهند البريطانية أو بالإنجليز في الهند) / أنجلو-هندي (شخص يحمل الجنسية الإنجليزية ولد أو يعيش في الهند)",
 "anglo-jewish": "أنجلو-يهودي (متعلق باليهود الناطقين بالإنجليزية وثقافتهم)\nمثال: صحف أنجلو-يهودية",
 "anglo-norman": "الأنجلو فرنسية, الأنجلو نورماندية (اللغة الفرنسية (النورماندية) المستخدمة في إنجلترا في العصور الوسطى)",
 "anglo-norman language": "الأنجلو فرنسية, الأنجلو نورماندية (اللغة الفرنسية (النورماندية) المستخدمة في إنجلترا في العصور الوسطى)",
 "anglo-saxon": "أَنْجْلُوسَكْسُونِيّ",
 "anglo-saxon deity": "إله أنجلوساكسوني ((الأساطير الأنجلوساكسونية) إله عبده الأنجلوساكسون)",
 "anglo-saxon language": "الأنجلو ساكسونية, الإنجليزية القديمة (الإنجليزية قبل حوالي 1100)",
 "anglomania": "أنغلومانيا, ولع بالإنجليز (حماس مفرط لكل ما هو إنجليزي)",
 "anglophil": "محب للإنجليز (معجب بإنجلترا والأشياء الإنجليزية)",
 "anglophile": "محب للإنجليز (معجب بإنجلترا والأشياء الإنجليزية)",
 "anglophilia": "حب الإنجليز (الإعجاب ببريطانيا والعادات البريطانية)",
 "anglophilic": "محب للإنجليز (يتميز بحب أو تأييد الإنجليز أو الثقافة الإنجليزية)",
 "anglophobe": "كاره للإنجليز (شخص يكره إنجلترا وكل ما هو إنجليزي)",
 "anglophobia": "كراهية الإنجليز (كراهية (أو الخوف من) بريطانيا والعادات البريطانية)",
