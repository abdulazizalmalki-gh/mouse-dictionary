 "analog": "تَنَاظِرِيَّة",
 "analog clock": "ساعة بعقارب, ساعة تناظرية (ساعة تعرض الوقت بواسطة موضع العقارب على قرص)",
 "analog computer": "حاسوب تناظري (حاسوب يمثل المعلومات بكميات متغيرة (مثل المواضع أو الفولتية))",
 "analog watch": "ساعة يد تناظرية (ساعة يد تمثل الوقت بواسطة موضع العقارب على قرص)",
 "analog-digital converter": "محول تناظري رقمي, مرقم (جهاز لتحويل الإشارات التناظرية إلى إشارات رقمية)",
 "analog-to-digital converter": "محول تناظري رقمي, مرقم (جهاز لتحويل الإشارات التناظرية إلى إشارات رقمية)",
 "analogical": "تَمْثِيلِيّ, قِيَاسِيّ (يُعَبِّر عَن شَيْء بِالقِياس عَلى شَيْء آخَر أَوْ يَقوم عَلَيْه)",
 "analogist": "مستدل بالقياس, مقياس (شخص يبحث عن التناظر أو يستدل بالقياس)",
 "analogous": "مُمَاثِل",
 "analogously": "بشكل مماثل, قياساً على ذلك (بطريقة مماثلة)\nمثال: قياساً على ذلك، لدينا متغير",
 "analogue": "تَنَاظُرِيّ, خَطِّيّ (لدائرة أو جهاز له مخرج يتناسب مع المدخل) / شَبِيه, مَثِيل (شيء يمتلك خاصية كونه مناظراً لشيء آخر)\nمثال: جهاز تناظري",
 "analogue computer": "حاسوب تناظري (حاسوب يمثل المعلومات بكميات متغيرة (مثل المواضع أو الفولتية))",
 "analogy": "قِيَاس",
 "analphabet": "أُمِّي, جاهل بالأبجدية (شخص أمي لا يعرف الحروف الأبجدية)",
 "analphabetic": "غَيْر أَبْجَدِيّ (ليس أبجدياً) / شِبْه أُمِّيّ (ذو مَعْرِفَة ضَئيلَة بِالقِراءَة وَالكِتابَة) / لا أبجدي (يتعلق بـ أو يُعبر عنه بنظام كتابة ليس أبجدياً) / أُمِّي, جاهل بالأبجدية (شخص أمي لا يعرف الحروف الأبجدية)\nمثال: ترتيب غير أبجدي للحروف",
 "analphabetism": "أمية (عدم القدرة على القراءة)",
 "analysand": "خاضِع لِلتَّحْلِيل النَّفْسِيّ (شخص يخضع للتحليل النفسي)",
 "analyser": "جهاز تحليل, محلل (أداة تقوم بإجراء التحليلات)",
 "analysis": "تَحْلِيل / تَحْلِيل رِيَاضِيّ / تَحْلِيلْ مُخْتَبَرِيّ",
 "analysis of variance": "أنوفا, تحليل التباين (طريقة إحصائية لإجراء مقارنات متزامنة بين متوسطين أو أكثر)",
 "analysis situs": "طوبولوجيا (فرع الرياضيات البحتة الذي يتعامل فقط مع خصائص الشكل س التي تظل صحيحة لكل شكل يمكن تحويل س إليه بتناظر واحد لواحد مستمر في كلا الاتجاهين)",
 "analyst": "مُحَلِّل, مُتَخَصِّص",
 "analytic": "تَحْلِيلِيّ (لقضية تكون صحيحة بالضرورة بغض النظر عن الحقيقة أو التجربة) / تَحْلِيلِيّ, غَيْر تَصْرِيفِيّ (يعبر عن فئة نحوية باستخدام كلمتين أو أكثر بدلاً من التصريف) / تَحْلِيلِيّ (يستخدم أو ماهر في استخدام التحليل (أي فصل الكل - الفكري أو الجوهري - إلى أجزائه العنصرية أو مبادئه الأساسية)) / تحليلي (يستخدم أو يخضع لمنهجية تستخدم الجبر وحساب التفاضل والتكامل)\nمثال: 'كل العوانس غير متزوجات' هي قضية تحليلية",
 "analytic geometry": "هندسة إحداثية, هندسة تحليلية (استخدام الجبر لدراسة الخصائص الهندسية)",
 "analytic thinking": "تحليل, تفكير تحليلي (الفصل المجرد للكل إلى أجزائه المكونة من أجل دراسة الأجزاء وعلاقاتها)",
 "analytical": "تَحْلِيلِيّ (لقضية تكون صحيحة بالضرورة بغض النظر عن الحقيقة أو التجربة) / تَحْلِيلِيّ (يستخدم أو ماهر في استخدام التحليل (أي فصل الكل - الفكري أو الجوهري - إلى أجزائه العنصرية أو مبادئه الأساسية))\nمثال: 'كل العوانس غير متزوجات' هي قضية تحليلية",
 "analytical balance": "ميزان تحليلي, ميزان كيميائي (ميزان ذو عارضة عالي الدقة يستخدم في التحليل الكيميائي الكمي)",
 "analytical cubism": "التكعيبية التحليلية (المرحلة المبكرة من التكعيبية)",
 "analytical geometry": "هندسة إحداثية, هندسة تحليلية (استخدام الجبر لدراسة الخصائص الهندسية)",
 "analytical review": "مراجعة تحليلية (إجراء تدقيق يعتمد على النسب بين الحسابات ويحاول تحديد التغييرات المهمة)",
 "analytically": "تَحْلِيلِيًّا (بموجب التحليل)\nمثال: بافتراض الحفاظ على التمييز، قد يتساءل المرء أيهما له الأسبقية تحليلياً؟",
 "analyticity": "تحليلية (خاصية كون الشيء تحليلياً)",
 "analytics": "تَحْلِيلَات",
 "analyzable": "قَابِل لِلتَّجْزِئَة, قَابِل لِلتَّحْلِيل (قابل للتقسيم إلى أجزاء أو عناصر)",
