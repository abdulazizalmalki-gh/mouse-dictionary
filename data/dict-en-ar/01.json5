 "alloyed": "مَخْلُوط, مَسْبُوك ((في المعادن) مُمتزج للحصول على خاصية مطلوبة) / مَخْلُوط, مَسْبُوك ((في المعادن) أُضعِف بخلطه بعنصر أقلّ جودة)",
 "allspice": "بَهَار حُلْو, فِلْفِل إِفْرَنْجِيّ",
 "allspice tree": "شجرة البهار, فلفل إفرنجي (شجرة عطرية من جزر الهند الغربية تنتج حبوب الفلفل الإفرنجي (البهار)) / شجرة البهار الطبية (شجرة استوائية أمريكية لها زهور بيضاء صغيرة وتوت عطري)",
 "allure": "إِغْرَاء, فِتْنَة (القدرة على الجذب أو الاستمالة من خلال السحر الشخصي)",
 "allurement": "إغواء للرذيلة, استدراج (فعل إغراء شخص للقيام بشيء خاطئ (مثل عرض الجنس مقابل المال)) / إِغْرَاء, فِتْنَة (القدرة على الجذب أو الاستمالة من خلال السحر الشخصي) / جاذبية, فتنة (الجاذبية والإغراء)\nمثال: كانت جاذبيته تكمن في عزلته",
 "alluring": "سَاحِر, فَتَّان (شديد الجاذبية وقادر على إثارة الأمل أو الرغبة)",
 "allusion": "تَلْمِيح",
 "allusive": "إِشَارِيّ, تَلْمِيحِيّ (يَتَّسِم بِالإِشَارَات غَيْر المُبَاشِرَة)",
 "allusiveness": "إشارة غير مباشرة, تلميح (صفة تتميز بالإشارة غير المباشرة)",
 "alluvial": "رسوبي, طمي (من أو يتعلق بالطمي (الترسبات النهرية))",
 "alluvial cone": "مخروط طميي, مروحة رسوبية (رواسب على شكل مروحة حيث يستوي مجرى مائي سريع التدفق)",
 "alluvial deposit": "رواسب طميية, طمي (طين أو غرين أو حصى تحمله التيارات المائية الجارفة ويترسب حيث تتباطأ سرعة التيار)",
 "alluvial fan": "مخروط طميي, مروحة رسوبية (رواسب على شكل مروحة حيث يستوي مجرى مائي سريع التدفق)",
 "alluvial flat": "سهل طمي (أرض منبسطة ناتجة عن رواسب متكررة من المواد الطميية بواسطة المياه الجارية)",
 "alluvial plain": "سهل طمي (أرض منبسطة ناتجة عن رواسب متكررة من المواد الطميية بواسطة المياه الجارية)",
 "alluvial sediment": "رواسب طميية, طمي (طين أو غرين أو حصى تحمله التيارات المائية الجارفة ويترسب حيث تتباطأ سرعة التيار)",
 "alluvial soil": "تربة طميية (تربة خصبة ناعمة الحبيبات ترسبها المياه المتدفقة فوق سهول الفيضانات أو في قيعان الأنهار)",
 "alluviation": "ترسب, ترسيب (ظاهرة تراكم الرواسب أو الحصى)",
 "alluvion": "رواسب طميية, طمي (طين أو غرين أو حصى تحمله التيارات المائية الجارفة ويترسب حيث تتباطأ سرعة التيار) / طوفان, غمر (ارتفاع مسطح مائي وفيضانه على أرض جافة عادة) / ترسب طمي, طمي (التشكل التدريجي لأرض جديدة، عن طريق انحسار البحر أو ترسب الرواسب)\nمثال: سهول مخصبة بفيضانات سنوية",
