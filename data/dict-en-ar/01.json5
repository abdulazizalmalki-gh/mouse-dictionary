 "antiphon": "أنتيفون, نشيد تجاوبي (آية أو أغنية تُرتل أو تُغنى كاستجابة (رد))",
 "antiphonal": "تناوبي (يتعلق بـ أو يشبه الغناء التناوبي (أنتيفون)) / تبادلي, تجاوبي (يحتوي على أو يستخدم استجابات؛ متناوب) / كتاب الترانيم التجاوبية (مجموعة مجلدة من الأنتيفونات (الترانيم التجاوبية))\nمثال: قراءة تجاوبية",
 "antiphonary": "تناوبي (يتعلق بـ أو يشبه الغناء التناوبي (أنتيفون)) / كتاب الترانيم التجاوبية (مجموعة مجلدة من الأنتيفونات (الترانيم التجاوبية))",
 "antiphony": "أنتيفون, نشيد تجاوبي (آية أو أغنية تُرتل أو تُغنى كاستجابة (رد)) / أنتيفوني, غناء تجاوبي (غناء متبادل (استجابي) بواسطة جوقة في جزأين)",
 "antiphospholipid antibody": "جسم مضاد للفوسفوليبيد (أي من مجموعة الأجسام المضادة الذاتية الشائعة الموجودة في الدم)\nمثال: قد يؤدي وجود جسم مضاد للفوسفوليبيد في الدم، مثل مضاد تخثر الذئبة، إلى تخثر الدم",
 "antiphrasis": "تضاد ساخر (استخدام كلمة بمعنى معاكس لمعناها الطبيعي (خاصة في السخرية))",
 "antipodal": "متقابل قطرياً, نقيضي (يتعلق بالنقاط المتقابلة قطرياً على الكرة الأرضية أو يقع في جوانب متقابلة) / تَقَابُل قُطْرِيّ (علاقة التقابل على طول القطر)\nمثال: خطوط العرض المتقابلة",
 "antipodal opposition": "تَقَابُل قُطْرِيّ (علاقة التقابل على طول القطر)",
 "antipode": "نَقِيض (المقابل المباشر)\nمثال: الهدوء: نقيض الانشغال المركز",
 "antipodean": "متقابل قطرياً, نقيضي (يتعلق بالنقاط المتقابلة قطرياً على الكرة الأرضية أو يقع في جوانب متقابلة)\nمثال: خطوط العرض المتقابلة",
 "antipodes": "الأنتيبود, نقطة مقابلة (أي مكانين أو منطقتين على جانبين متقابلين تماماً من الأرض)\nمثال: القطب الشمالي والقطب الجنوبي متقابلان",
 "antipollution": "مضاد للتلوث, مكافح للتلوث (يهدف إلى الحد من التلوث)\nمثال: قوانين مكافحة التلوث",
 "antipope": "بابا مزيف, بابا مضاد (شخص يُنتخب بابا في معارضة لشخص آخر يُعتبر منتخباً بشكل قانوني)\nمثال: أقام الباباوات المزيفون في أفينيون خلال الانشقاق العظيم",
 "antiproton": "نَقِيض البُرُوتُون (بروتون غير مستقر سالب الشحنة؛ الجسيم المضاد للبروتون)",
 "antiprotozoal": "دواء مضاد للأوالي, مضاد للأوالي (دواء طبي يستخدم لمكافحة الأمراض (مثل الملاريا) التي تسببها الأوالي)",
 "antiprotozoal drug": "دواء مضاد للأوالي, مضاد للأوالي (دواء طبي يستخدم لمكافحة الأمراض (مثل الملاريا) التي تسببها الأوالي)",
 "antipruritic": "مضاد للحكة",
 "antipsoriatic": "مضاد الصدفية",
 "antipsychotic": "مضاد ذهان, مهدئ رئيسي (مهدئ يستخدم لعلاج الحالات الذهانية عندما يكون التأثير المهدئ مطلوباً)",
 "antipsychotic agent": "مضاد ذهان, مهدئ رئيسي (مهدئ يستخدم لعلاج الحالات الذهانية عندما يكون التأثير المهدئ مطلوباً)",
 "antipsychotic drug": "مضاد ذهان, مهدئ رئيسي (مهدئ يستخدم لعلاج الحالات الذهانية عندما يكون التأثير المهدئ مطلوباً)",
 "antipyresis": "خفض الحرارة, مداواة الحمى (المداواة بخافضات الحرارة لعلاج الحمى)",
 "antipyretic": "خافض للحرارة",
 "antiquarian": "أثري, عتيق (من أو يتعلق بالتحف أو الآثار القديمة) / أثري (من أو يتعلق بالأشخاص الذين يدرسون أو يتاجرون في التحف أو الآثار) / أثري, جامع تحف (خبير أو جامع للآثار والتحف القديمة)",
 "antiquark": "نَقِيض الكُوَارْك (الجسيم المضاد للكوارك)",
 "antiquary": "أثري, جامع تحف (خبير أو جامع للآثار والتحف القديمة)",
 "antiquated": "عَتِيق, بَالٍ (قَدِيم، أَثَرِيّ؛ مُحَرَّر، حُرّ)\nمثال: هذا سوق عتيق للبعير.",
 "antiquatedness": "خروج عن الموضة, عتق (حالة أو جودة كون الشيء عتيقاً أو فاقداً للمصداقية بسبب العمر، أو كونه خارجاً عن الأسلوب أو الموضة)\nمثال: حيث لا تزال هذه العادات موجودة فهي رمزية عملياً لعتق الدين",
 "antique": "عَتِيق, قَدِيم (قَدِيم، أَثَرِيّ؛ مُحَرَّر، حُرّ)\nمثال: هذا سوق عتيق للبعير.",
 "antiqueness": "أثرية, عراقة (جودة أو حالة كون الشيء على نمط أو موضة العصور السابقة)\nمثال: قد نكتشف شيئاً مبجلاً في أثرية العمل",
 "antiquity": "تَارِيخ قَدِيم (جملة الأَحوال والأحداث التي يمر بها كائن ما، ويَصْدق على الفرد والمجتمع، كما يَصْدق على الظواهر الطبيعية والإنسانية؛ هو تحديد الزمن باليَوْم والشَهْر والسَنَة أو ببعضهما. الأجَل أو الوَقْت)\nمثال: ما تاريخ اليوم؟",
 "antiracism": "مُنَاهَضَة الْعُنْصُرِيَّة",
 "antiredeposition": "منع إعادة الترسيب (عملية منع إعادة الترسيب)",
 "antireligiousness": "معاداة الدين (حالة أو شرط المعارضة للدين)\nمثال: صحيح أيضاً أن أي تقسيم دقيق بين الكوميديا الدينية والعلمانية سيبدو مهدداً بالمعاداة الظاهرة للدين لكتاب مثل إيراسموس ورابيليه",
 "antirrhinum coulterianum": "أنف العجل الأبيض (نبات من كاليفورنيا بعناقيد نحيلة من الزهور البيضاء)",
 "antirrhinum filipes": "أنف العجل الأصفر المتسلق (نبات من جنوب غرب الولايات المتحدة بزهور صفراء على سيقان تلتف وتتسلق عبر النباتات الأخرى)",
 "antirrhinum majus": "أنف العجل المتوسطي, فم السمكة (نبات معمر موطنه البحر الأبيض المتوسط ولكن يزرع على نطاق واسع لزهوره الأرجوانية أو الوردية)",
 "antisatellite": "مضاد للأقمار الصناعية (من أو متعلق بنظام لتدمير الأقمار الصناعية في المدار)\nمثال: أسلحة مضادة للأقمار الصناعية",
 "antisemitic": "معاد للسامية (يتعلق بمعاداة السامية أو يتميز بها؛ كاره لليهود)",
 "antisemitism": "معاداة السامية (الكراهية الشديدة والتحيز ضد الشعب اليهودي)",
 "antisepsis": "تطهير, تعقيم (عملية تثبيط نمو وتكاثر الكائنات الحية الدقيقة) / تعقيم, خلو من الجراثيم ((للأشياء غير الحية) حالة الخلو من الكائنات الحية المسببة للأمراض)",
 "antiseptic": "مُعَقِّمٌ",
 "antiserum": "مصل مضاد (مصل دم يحتوي على أجسام مضادة ضد مستضدات معينة؛ يوفر مناعة ضد مرض ما)",
 "antisocial": "مُعَادٍ لِلْمُجْتَمَع (معادٍ للمعايير الاجتماعيّة السليمة أو مخلّ بها) / مُعَادٍ لِلاخْتِلَاط (يتجنّب الاتّصال بالآخرين وينفر منه)",
 "antisocial personality disorder": "اضطراب الشخصية المعادية للمجتمع, شخصية سيكوباتية (اضطراب في الشخصية يتميز باللاأخلاقية ونقص العاطفة؛ قادر على ارتكاب أعمال عنيفة دون شعور بالذنب)",
 "antispasmodic": "حال للتشنج, مضاد للتشنج (دواء يستخدم لتخفيف أو منع التشنجات (خاصة العضلات الملساء))",
 "antispasmodic agent": "حال للتشنج, مضاد للتشنج (دواء يستخدم لتخفيف أو منع التشنجات (خاصة العضلات الملساء))",
 "antistrophe": "الدور المضاد, رد المقطع (قسم القصيدة الكورالية الذي يجيب على مقطع سابق في الدراما اليونانية الكلاسيكية؛ الثاني من قسمين متوافقين إيقاعياً في قصيدة)",
 "antistrophic": "عكسي (من أو متعلق بالرد على الجوقة (في الدراما اليونانية))",
 "antisubmarine": "مُضَادّ لِلْغَوَّاصَات (دفاعيّ ضدّ غوّاصات العدوّ)",
 "antisyphilitic": "مضاد للزهري (دواء (أو عامل كيميائي آخر) فعال ضد مرض الزهري)",
 "antitank": "مضاد للدبابات",
 "antitauon": "نَقِيض التَّاوُون (نقيض لبتون ذو كتلة كبيرة جداً)",
 "antiterrorism": "مُكَافَحَة اَلْإِرْهَاب",
 "antithesis": "تضاد, طباق (تجاور كلمات أو أفكار متناقضة لإعطاء شعور بالتوازن) / ضِدّ, عَكْس (المقابل التام)\nمثال: نظريته هي عكس نظريتي تماماً",
 "antithetic": "مُتَضَادّ, مُتَنَاقِض (متباين بشكل حادّ في الطابع أو الغرض)",
 "antithetical": "مُتَضَادّ, مُتَنَاقِض (متباين بشكل حادّ في الطابع أو الغرض)",
 "antithetically": "تَنَاقُضِيًّا (مع التناقض؛ بطريقة متناقضة)",
 "antithyroid": "مضاد للدرقية (له تأثير مضاد لنشاط الغدة الدرقية المفرط)\nمثال: أدوية مضادة للدرقية",
 "antitoxic": "مُضَادّ لِلسُّمُوم (يقاوم السمّ أو يبطل مفعوله)",
 "antitoxin": "تِرْيَاق (دواء مركب يدفع السموم؛ ما يضاد عمل السمّ)",
 "antitrade": "رياح عكسية تجارية (رياح تهب من الغرب إلى الشرق وتقع فوق الرياح التجارية في المناطق المدارية)",
 "antitrade wind": "رياح عكسية تجارية (رياح تهب من الغرب إلى الشرق وتقع فوق الرياح التجارية في المناطق المدارية)",
 "antitrades": "رياح تجارية عكسية (رياح في الغلاف الجوي العلوي تهب فوق الرياح التجارية ولكن في الاتجاه المعاكس)",
 "antitrust": "مُضَادّ لِلاحْتِكَار (عَنِ القَوَانِين وَالأَنْظِمَة؛ مُصَمَّم لِحِمَايَة التِّجَارَة مِنَ المُمَارَسَات التِّجَارِيَّة غَيْر العَادِلَة)",
 "antitrust case": "قضية مكافحة الاحتكار (إجراء قانوني مرفوع ضد أطراف متهمة بالحد من المنافسة الحرة في السوق)",
 "antitrust law": "قانون مكافحة الاحتكار (قانون يهدف إلى تعزيز المنافسة الحرة في السوق عن طريق حظر الاحتكارات)",
 "antitrust legislation": "قانون مكافحة الاحتكار (قانون يهدف إلى تعزيز المنافسة الحرة في السوق عن طريق حظر الاحتكارات)",
 "antitumor": "مضاد للأورام, مضاد للسرطان (يستخدم في علاج السرطان)\nمثال: دواء مضاد للسرطان",
 "antitumour": "مضاد للأورام, مضاد للسرطان (يستخدم في علاج السرطان)\nمثال: دواء مضاد للسرطان",
 "antitussive": "مضاد للسعال (أي دواء يستخدم لقمع أو تخفيف السعال)",
 "antitype": "نقيض, نوع مناقض (نوع معاكس أو متباين) / حقيقة المرموز, مرموز إليه (شخص أو شيء تم تمثيله أو التنبؤ به بواسطة رمز أو نوع سابق؛ خاصة في اللاهوت كشخصية أو حدث في العهد الجديد له نظير في العهد القديم)\nمثال: هارون ويسوع المسيح هما الرمز والمرموز إليه للكاهن الأكبر الذي كفر عن خطايا الشعب",
 "antitypic": "رمزي مقابل (من أو متعلق بالنموذج المقابل الذي يعتبر رمزاً) / ضدي, نقيضي (من أو متعلق بالنموذج المقابل الذي يمثل الضد أو النقيض)",
 "antitypical": "رمزي مقابل (من أو متعلق بالنموذج المقابل الذي يعتبر رمزاً) / ضدي, نقيضي (من أو متعلق بالنموذج المقابل الذي يمثل الضد أو النقيض)",
 "antivenene": "مصل مضاد للسم (مضاد ذيفان يبطل تأثيرات السم من لدغة ثعبان أو حشرة أو حيوان آخر)",
 "antivenin": "مصل مضاد للسم (مضاد ذيفان يبطل تأثيرات السم من لدغة ثعبان أو حشرة أو حيوان آخر)",
 "antivenom": "مضاد السم",
 "antivert": "أنتيفيرت, ميكليزين (مضاد للهيستامين (الاسم التجاري أنتيفيرت) يستخدم لعلاج أو منع دوار الحركة)",
 "antiviral": "مضاد للفيروسات",
 "antiviral agent": "دواء مضاد للفيروسات, مضاد للفيروسات (أي دواء يدمر الفيروسات)",
 "antiviral drug": "دواء مضاد للفيروسات, مضاد للفيروسات (أي دواء يدمر الفيروسات)",
 "antiwrinkle": "مضاد للتجاعيد",
 "antler": "قَرْن الْأَيِّل (مصدر للفعل قَرَنَ؛ القوم يعيشون سوية فترة طويلة جذا من الزمن، أو هو الفترة الطويلة من الزمن بدون تحديد عدد السنين)\nمثال: هذه الشجرة عمرها أكثر من قرن.",
 "antler moth": "عثة قرن الوعل (عثة أوروبية بعلامات بيضاء تشبه قرن الوعل على الأجنحة الأمامية؛ تتلف اليرقات المراعي والأراضي العشبية)",
 "antler-like": "شَبِيهٌ بِالْقُرُون (يشبه القرون في شكله)",
 "antlered": "ذُو قُرُون (يمتلك قروناً متفرّعة)",
 "antlion": "لَيْث عِفِرِّين, أَسَد النَّمْلِ (أَسَد)\nمثال: إذا رأيت نيوب الليث بارزة، فلا تظنن أن الليث يبتسم.",
 "antlion fly": "أسد النمل (حشرة مجنحة تشبه اليعسوب؛ تحفر يرقاتها حفراً مخروطية حيث تنتظر لاصطياد النمل وغيره)",
 "antonomasia": "تسمية باللقب (استبدال الاسم بلقب)",
 "antonym": "عَكْس / نَقِيض",
 "antonymous": "متضاد (للكلمات: لها معانٍ متضادة)",
 "antonymy": "تَضَادّ (العلاقة الدلالية التي تربط بين كلمتين يمكن (في سياق معين) أن تعبرا عن معانٍ متضادة)",
 "antrorse": "مُتَّجِه لِلْأَمَام (منحني أو مقوس للأمام أو للأعلى)\nمثال: نبات له شعيرات متجهة للأمام على الساق",
 "antrozous pallidus": "خفاش الكهف, خفاش شاحب (خفاش كبير الأذن مصفر باهت يعيش في الكهوف)",
 "antrum": "غار (تجويف طبيعي أو فراغ في عظم)",
 "antsy": "قَلِق, مُتَمَلْمِل (عَصَبِيٌّ وَغَيْرُ قَادِرٍ عَلَى الاسْتِرْخَاء)",
 "antwerp": "أَنْتْوِيرْبْ",
 "anubis": "أنوبيس",
 "anunnaki": "أنوناكي (أي من مجموعة أرواح الأرض البابلية القوية أو الجن؛ خدم الآلهة)",
 "anuran": "ضفدع, علجوم (أي من البرمائيات المختلفة عديمة الذيل ممتلئة الجسم ذات أطراف خلفية طويلة للقفز؛ أنواع شبه مائية وأرضية) / بتراواني (يتعلق بالضفادع والعلاجيم)",
 "anuresis": "انحباس البول, انقطاع البول (عدم القدرة على التبول)",
 "anuretic": "احتباسي بولي (من أو متعلق بعدم القدرة على التبول)",
 "anuria": "انحباس البول, انقطاع البول (عدم القدرة على التبول)",
 "anuric": "احتباسي بولي (من أو متعلق بعدم القدرة على التبول)",
 "anurous": "بِلَا ذَيْل, عَدِيم الذَّيْل (ليس له ذيل)",
 "anus": "اِسْت (فتحة الدُبُر أو مقعد الإنسان؛ الأصل والأساس) / شَرْج",
 "anvers island": "جزيرة أنفيرس",
 "anvil": "سَنْدان, سِنْدَان",
 "anwar": "أنور, أَنْوَار",
 "anxiety": "قَلَق (شاعر بالقَلَق؛ تَحَرّك/اهتزاز/اضطراب في الوضع الطبيعي للشيء) / قَلَق, اِضْطِرَاب الْقَلَق (شاعر بالقَلَق؛ تَحَرّك/اهتزاز/اضطراب في الوضع الطبيعي للشيء)\nمثال: ليلى قلقة بشأنك.",
 "anxiety attack": "نوبة قلق (نوبة حادة مفاجئة من القلق الشديد ومشاعر الذعر)",
 "anxiety disorder": "اضطراب القلق (مصطلح شامل لمجموعة متنوعة من الاضطرابات النفسية التي يكون فيها القلق الشديد عرضاً بارزاً)",
 "anxiety hysteria": "هستيريا القلق (شكل من أشكال الهستيريا يجمع بين سمات الاضطراب التحويلي وعصاب القلق)",
 "anxiety neurosis": "عصاب القلق (يتميز بقلق منتشر وغالباً مظاهر جسدية للخوف)",
 "anxiety reaction": "اضطراب القلق العام (اضطراب قلق يتميز بقلق مزمن غير محدد وأعراض مثل التوتر أو التعرق أو الارتجاف أو الدوار أو التهيج وما إلى ذلك، والتي استمرت لأكثر من ستة أشهر)",
 "anxiolytic": "مزيل للقلق, مضاد للقلق (يخفف القلق) / دواء مضاد للقلق, مهدئ بسيط (مهدئ يستخدم لتخفيف القلق وتقليل التوتر والتهيج)",
 "anxiolytic drug": "دواء مضاد للقلق, مهدئ بسيط (مهدئ يستخدم لتخفيف القلق وتقليل التوتر والتهيج)",
 "anxious": "قَلِق, قَلِقَة (شاعر بالقَلَق؛ تَحَرّك/اهتزاز/اضطراب في الوضع الطبيعي للشيء)\nمثال: ليلى قلقة بشأنك.",
 "anxiously": "بتوجس, بقلق (مع قلق أو توجس)\nمثال: راقبنا بقلق",
 "anxiousness": "عدم ارتياح, قلق (شعور بقلق خفيف بشأن التطورات المحتملة) / اضطراب القلق, قلق ((الطب النفسي) حالة دائمة نسبياً من القلق والعصبية تحدث في مجموعة متنوعة من الاضطرابات العقلية، وعادة ما تكون مصحوبة بسلوك قهري أو نوبات هلع)",
 "any": "أَيّ (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير) / أَيّ, كُلّ (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى.",
 "any longer": "بعد الآن, مرة أخرى (في الوقت الحاضر أو من الآن فصاعداً؛ تستخدم عادة مع النفي)\nمثال: أليس لا تعيش هنا بعد الآن",
 "any-and-all bid": "عَرْض شَامِل (عرض استحواذ حيث يعرض المستحوذ شراء أي وجميع الأسهم القائمة)",
 "anyhow": "بأي حال, على أي حال (تستخدم للإشارة إلى أن بياناً يشرح أو يدعم بياناً سابقاً) / بأي طريقة, كيفما كان (بأي طريقة كانت)\nمثال: على أي حال، هو ميت الآن",
 "anymore": "بعد الآن, مرة أخرى (في الوقت الحاضر أو من الآن فصاعداً؛ تستخدم عادة مع النفي)\nمثال: أليس لا تعيش هنا بعد الآن",
 "anyplace": "أي مكان, في أي مكان (في أو عند أو إلى أي مكان)\nمثال: يمكنك العثور على هذا الطعام في أي مكان",
 "anything": "أَيُّ شَيْءٍ (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى.",
 "anytime": "أَيّ وَقْت (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى.",
 "anyway": "عَلَى كُلِّ حَال, على كل حال (يفيد الاستعلاء؛ يفيد التعليل) / عَلَى أَيُّ حَالٍ, على كل حال (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال.",
 "anyways": "بأي حال, على أي حال (تستخدم للإشارة إلى أن بياناً يشرح أو يدعم بياناً سابقاً)\nمثال: على أي حال، هو ميت الآن",
 "anywhere": "أي مكان, في أي مكان (في أو عند أو إلى أي مكان)\nمثال: يمكنك العثور على هذا الطعام في أي مكان",
 "anzac": "أنزاك (جندي في الفيلق الاسترالي والنيوزيلندي خلال الحرب العالمية الأولى)",
 "ao dai": "آو داي (الزي التقليدي للنساء الفيتناميات المكون من سترة بأكمام طويلة وألواح أمامية وخلفية؛ تلبس السترة فوق بنطال)",
 "aorist": "الأوريست, الماضي غير المحدد (زمن فعل في بعض اللغات (مثل اليونانية الكلاسيكية والسنسكريتية) يعبر عن حدث (خاصة حدث ماض) دون الإشارة إلى اكتماله أو استمراره)",
 "aoristic": "أوريستي (من أو متعلق بالزمن الماضي غير المحدد (الأوريست))",
 "aorta": "أَبْهَر, وَتِين",
 "aortal": "أبهري, أورطي (من أو متعلق بالشريان الأورطي)",
 "aortic": "أبهري, أورطي (من أو متعلق بالشريان الأورطي)",
 "aortic aneurysm": "أم الدم الأبهرية, تمدد الشريان الأورطي (تمدد الأوعية الدموية في الشريان الأورطي)",
 "aortic arch": "قوس الأبهر (الجزء من الأبهر الذي يتقوس وينحني لأسفل)",
 "aortic isthmus": "برزخ الأبهر (القسم الأخير من قوس الأبهر؛ تضييق في الأبهر نتيجة لانخفاض تدفق الدم أثناء الحياة الجنينية)",
 "aortic orifice": "فتحة الأبهر (الفتحة من الغرفة اليسرى السفلية للقلب إلى الأبهر)",
 "aortic plexus": "ضفيرة أبهرية (ضفيرة من العقد الليمفاوية في الجزء السفلي من الأبهر البطني)",
 "aortic stenosis": "تضيق الأبهر (تضيق غير طبيعي في الصمام الأبهري)",
 "aortic valve": "صمام أبهري (صمام هلالي بين البطين الأيسر والأبهر؛ يمنع الدم من التدفق من الأبهر عائداً إلى القلب)",
 "aortitis": "التهاب الأبهر (التهاب الشريان الأبهر)",
 "aosta": "أَوْسْتَا",
 "aotus trivirgatus": "دوروكولي, سعدان ليلي (قرد ليلي يعيش في أمريكا الوسطى والجنوبية، يتميز بعيون كبيرة وفراء كثيف)",
 "aoudad": "كبش بربري, وداد (خروف بري يعيش في شمال أفريقيا)",
 "aoun": "عون",
 "apace": "بسرعة, سريعاً / بسرعة ((شاعري، أدبي) بسرعة)\nمثال: يعمل بسرعة",
 "apache": "لغة الأباتشي (لغة شعب الأباتشي) / أباتشي (رجل عصابة باريسي) / أباتشي (أي فرد من قبائل أثاباسكان التي هاجرت إلى الصحراء الجنوبية الغربية؛ خاضوا معركة خاسرة من 1861 إلى 1886 مع الولايات المتحدة وتم إعادة توطينهم في…)",
 "apache dance": "رقصة الأباتشي (رقصة سريعة وعنيفة في الفودفيل الفرنسي (الأباتشي هو عضو في العالم السفلي الفرنسي))",
 "apache devil dance": "رقصة شيطان الأباتشي (رقصة طقسية لقبيلة الأباتشي)",
 "apache language": "لغة الأباتشي (لغة شعب الأباتشي)",
 "apadana": "أبادانا (القاعة الكبرى في القصور الفارسية القديمة)",
 "apalachicola rosemary": "إكليل الجبل أبالاتشيكولا, كونرادينا جلابرا (شجيرة صغيرة في منطقة نهر أبالاتشيكولا في جنوب شرق الولايات المتحدة لها زهور وردية عطرية للغاية؛ نوع مهدد بالانقراض)",
 "apamea": "أفاميا",
 "apamena": "أَفَامِينَة",
 "apanage": "إقطاعة (منحة (من قبل حاكم أو هيئة تشريعية) من الموارد لإعالة فرد معال من عائلة حاكمة) / امتياز, حق مكتسب (أي امتياز عرفي ومشروع يتناسب مع مقامك في الحياة)\nمثال: تم استلام الأسقفيات كإقطاعات للأبناء الأصغر سناً للعائلات الكبيرة",
 "apar": "مدرع ثلاثي الأحزمة (مدرع من أمريكا الجنوبية بثلاثة أحزمة من الصفائح العظمية)",
 "apart": "بصرف النظر, جانباً (غير مأخوذ في الاعتبار أو مستبعد) / إرباً, قطعاً (إلى أجزاء أو قطع) / بعيداً عن بعض, متباعدين (منفصلين أو على مسافة في المكان أو الزمان) / التمييز بينهما, عن بعضهما (واحداً عن الآخر)\nمثال: بصرف النظر عن هذه المشاكل، البلاد تبلي بلاءً حسناً",
 "apart from": "بِغَضّ النَظَر عَن (البُغْض ضدّ الحبّ ، بغَض جَدُّك:كتعس جدّك،ونعِمَ الله بك عيناً وبغَض بعدوّك عيناً؛ بغَضَ فلانٌ الشّيءَ أو الشّخصَ:كَرِهَه ومَقَتَه وأعرض عنه)\nمثال: سأذهب بغض النظر عن مجيئه.",
 "apartheid": "أَپَارْتْهِيد, فَصْلٌ عُنْصُرِيّ",
 "apartment": "شَقَّة (نِصْف الشيء إذا شُقَّ؛ القطعة المَشْقُوقَة بشكل مستطيل من الثَوْب أو العَصَا)\nمثال: فتش ياني الشقة.",
 "apartment building": "عمارة سكنية, مبنى سكني (مبنى مقسم إلى شقق)",
 "apartment house": "عمارة سكنية, مبنى سكني (مبنى مقسم إلى شقق)",
 "apatetic coloration": "تلوين تمويهي (تلوين يعمل كتمويه طبيعي)",
 "apatheism": "لاكتراثية",
 "apathetic": "لَا مُبَالٍ (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: لا أحب المدرسة.",
 "apathetically": "بِفُتُور, بِلَا مُبَالَاة (بطريقة غير مبالية)\nمثال: تتصرف بلامبالاة هذه الأيام",
 "apathy": "لَامُبَالَاة, عَدَم اِكْتِرَاث",
 "apatite": "أباتيت",
 "apatosaur": "أباتوصور, برونتوصور (ديناصور عاشب ضخم رباعي الأرجل كان شائعاً في أمريكا الشمالية في أواخر العصر الجوراسي)",
 "apatosaurus": "أباتوصور, برونتوصور (ديناصور عاشب ضخم رباعي الأرجل كان شائعاً في أمريكا الشمالية في أواخر العصر الجوراسي)",
 "apatosaurus excelsus": "أباتوصور, برونتوصور (ديناصور عاشب ضخم رباعي الأرجل كان شائعاً في أمريكا الشمالية في أواخر العصر الجوراسي)",
 "apatura iris": "إمبراطور أرجواني (فراشة أوروبية كبيرة يتميز الذكر منها بأجنحة مظللة بالأرجواني)",
 "apc": "إيه بي سي (مزيج دوائي يوجد في بعض علاجات الصداع التي لا تستلزم وصفة طبية (أسبرين وفيناسيتين وكافيين)) / ناقلة جنود مدرعة ((عسكري) مركبة مدرعة (مجهزة عادة بجنازير) تستخدم لنقل المشاة)",
 "ape": "قِرْد, قِرْد بَشَرِيّ",
 "ape-man": "رجل القردة, فتى الأدغال (شخص يُفترض أنه نشأ بين القردة) / الحلقة المفقودة, الرجل القرد (كائن افتراضي كان يُعتقد سابقاً أنه حلقة وصل بين القردة والبشر)",
 "apelike": "قِرْدِيّ التَّقْلِيد, مُقَلِّد بِعَمَى (يُقلِّد تقليداً ذليلاً وخاضعاً بلا تفكير) / شَبِيه بِالقُرُود, قِرْدِيّ (يُشبه القُرود)",
 "apennines": "اَلْأَبِينِينِي",
 "aper": "مُحَاكٍ, مُقَلِّد (شخص ينسخ كلمات أو سلوك شخص آخر)",
 "apercu": "لمحة موجزة, نظرة عامة (ملخص قصير)",
 "aperea": "كافياء برية (كافياء من أمريكا الجنوبية؛ ربما تكون سلف خنزير غينيا المستأنس)",
 "aperient": "مُلَيِّنٌ خَفِيف (ذو تأثير مُلَيِّن خفيف) / مسهل, ملين قوي (دواء مسهل؛ يحفز إخلاء الأمعاء)",
 "aperiodic": "لا دوري (لا يتكرر على فترات منتظمة)",
 "aperitif": "أبيرتيف, فاتح للشهية (مشروب كحولي يؤخذ قبل الوجبة لفتح الشهية)",
 "aperture": "ثقب, فتحة (فتحة من صنع الإنسان؛ عادة ما تكون صغيرة) / فتحة عدسة (جهاز يتحكم في كمية الضوء المسموح بدخولها) / فتحة (فتحة طبيعية في شيء ما)",
 "apery": "تقليد, محاكاة (فعل المحاكاة؛ سلوك تقليدي)",
 "apetalous": "عديم البتلات ((للزهور) لا تحتوي على بتلات)",
 "apetalous flower": "زهرة عديمة البتلات (زهرة ليس لها بتلات)",
 "apex": "ذروَة (أعلى كلِّ شيء؛ أعلى نقطة أو أرفع موضع)",
 "apex of the sun's way": "أوج شمسي, قمة (النقطة على الكرة السماوية التي تبدو الشمس والنظام الشمسي وكأنهما يتحركان نحوها بالنسبة للنجوم الثابتة)",
 "apgar score": "درجة أبغار, مقياس أبغار (تقييم للحالة الجسدية للمولود الجديد؛ يتضمن معدل ضربات القلب ومرونة العضلات والجهد التنفسي واللون والاستجابة للمنعكسات)",
 "aphaeresis": "ترخيم, حذف استهلالي ((في اللغويات) الحذف في بداية الكلمة)",
 "aphaeretic": "حذفي (يتعلق بـ أو يتكون من أو يتميز بحذف مقطع أو حرف من بداية الكلمة)",
 "aphagia": "تعذر البلع, لا بلع (فقدان القدرة على البلع)",
 "aphakia": "انعدام العدسة (غياب العدسة الطبيعية للعين)",
 "aphakic": "لا عدسي (من أو متعلق بـ أو مصاب بغياب عدسة العين) / فاقد العدسة (شخص مصاب بفقدان العدسة؛ شخص يفتقر إلى العدسات الطبيعية للعينين)",
 "aphanite": "أفانيت (صخر متجانس ناعم الحبيبات (مثل البازلت) يحتوي على معادن لا يمكن اكتشافها بالعين المجردة)",
 "aphanitic": "أفانيتي (من أو متعلق بالأفانيت (صخر دقيق الحبيبات))",
 "aphantasia": "أفانتازيا",
 "aphasia": "حبسة, فقدان القدرة على الكلام (عدم القدرة على استخدام أو فهم اللغة (المنطوقة أو المكتوبة) بسبب آفة دماغية)",
 "aphasic": "حُبْسِيّ, مُصَاب بِالحُبْسَة (عاجز عن الكلام بسبب إصابة دماغيّة) / حبسي (متعلق بـ أو مصاب بالحبسة الكلامية (الأفازيا)) / حبسي, مصاب بالحبسة (شخص مصاب بالحبسة أو عدم القدرة على استخدام أو فهم اللغة)\nمثال: كلام حبسي",
 "aphelion": "أَوْج",
 "apheresis": "فصادة (إجراء يتم فيه سحب الدم وفصله إلى مكوناته بواسطة الغسيل الكلوي (أو جهاز الطرد المركزي)؛ يتم الاحتفاظ بالبعض وإعادة الباقي إلى المتبرع) / ترخيم, حذف استهلالي ((في اللغويات) الحذف في بداية الكلمة)",
 "apheretic": "حذفي (يتعلق بـ أو يتكون من أو يتميز بحذف مقطع أو حرف من بداية الكلمة)",
 "aphesis": "حذف المقطع الأول (الاختفاء التدريجي لحرف متحرك أو مقطع لفظي أولي (عادة غير مشدد))",
 "aphetic": "مختزل, مرخم (ناتج عن الترخيم (حذف حرف علة غير مشدد من بداية الكلمة))",
 "aphid": "مَنّ, مَنَّة (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "aphid lion": "أَسَد الْمَنِّ (نوع من السباع مفترس من فصيلة السنوريات، يشتهر بفروة تحيط برقبته. أنثاه لبوة. يُعرَف بمَلِك الغابة؛  الرجل الشجاع القوي. مؤنثه أَسَدَة)\nمثال: الأسد حيوان بري.",
 "aphis fabae": "من الفاصوليا (من مسود يغزو الفاصوليا وبنجر السكر مثلاً)",
 "aphis lion": "أسد المن (يرقة آكلة للحوم لذباب شبكي الأجنحة)",
 "aphis pomi": "من التفاح (من أخضر ساطع؛ يتغذى على أوراق التفاح ويسبب تجعدها)",
 "aphonia": "بحة, خرس (اضطراب في أعضاء الصوت يؤدي إلى فقدان الصوت)",
 "aphonic": "أَبَحّ, فَاقِد الصَّوْت (فاقد الصوت بسبب إصابة أو مرض ولا يقدر إلّا على الهمس)",
 "aphorism": "حكمة موجزة, قول مأثور (قول تعليمي موجز وبليغ)",
 "aphorist": "صاحب حِكَم, ناظم حِكَم (شخص يصيغ الأقوال المأثورة أو يردد الحكم)",
 "aphoristic": "أَقْوَالِيّ, حِكَمِيّ (مُوجَزٌ وَظَرِيفٌ وَشَبِيهٌ بِالحِكْمَةِ أَوِ المَثَلِ) / بديهي, مأثوري (يحتوي على أقوال مأثورة أو حكم)\nمثال: حكمة مأثورة",
 "aphotic": "لَاضَوْئِيّ, مُعْتِم (خَالٍ مِنَ الضَّوْء؛ خَاصَّةً لَا يَصِل إِلَيْه ضَوْء الشَّمْس)",
 "aphriza virgata": "طائر الأمواج (طائر شاطئي يشبه الطيطوي يعيش على سواحل المحيط الهادئ لأمريكا الشمالية والجنوبية)",
 "aphrodisia": "شبق (رغبة في الحميمية الجنسية المغايرة)",
 "aphrodisiac": "مثير للشهوة, مقو للباه (محفز للرغبة الجنسية) / منشط جنسي (عقار أو عامل آخر يحفز الرغبة الجنسية)",
 "aphrodisiacal": "مثير للشهوة, مقو للباه (محفز للرغبة الجنسية)",
 "aphrodite": "أَفْرُودِيت",
 "aphrophora saratogensis": "حشرة بصاق ساراتوجا (تتغذى على الصنوبر في شمال الولايات المتحدة)",
 "aphthous ulcer": "قُرْحَة فَمَوِيَّة",
 "aphyllous": "عَدِيم الأَوْرَاق (خالٍ من الأوراق تماماً)",
 "apia": "آبيا",
 "apian": "نحلي (يتعلق بـ أو له خصائص النحل)",
 "apiarian": "نحال (يتعلق بالنحل أو تربية النحل)",
 "apiarist": "مربي النحل, نحّال (مزارع يربي النحل للحصول على العسل)",
 "apiary": "مَنْحَل",
 "apical": "ذِرْوِيّ, قِمِّيّ (يقع عند القمة أو الذروة)",
 "apical placentation": "وضع مشيمة قمي (حيث تتطور بويضة واحدة أو بضع بويضات في قمة مبيض بسيط أو مركب)",
 "apicalization": "تلقين ذلقي, نطق ذلقي ((علم الأصوات) ميزة نطقية للأصوات، عادة الحروف الساكنة، تنتج عن طريق إعاقة ممر الهواء بطرف اللسان)",
 "apiculate": "مُحَدَّد الطَّرَف ((عن شكل الورقة) ذو طرف قصير حادّ مُدبَّب)",
 "apicultural": "تربية النحل, نحلي (يتعلق برعاية وتربية النحل)",
 "apiculture": "تربية النحل (تربية النحل على نطاق تجاري لإنتاج العسل)",
 "apiculturist": "مربي النحل, نحّال (مزارع يربي النحل للحصول على العسل)",
 "apiece": "لِكُلّ وَاحِد (لكل فرد من اثنين أو أكثر (يعتبرون بشكل فردي))\nمثال: حصل كل واحد منهم على 10 دولارات",
 "apios americana": "أبيوس, بطاطس هندية (كرمة من أمريكا الشمالية ذات أزهار عطرة ودرنات صالحة للأكل؛ محصول غذائي مهم للأمريكيين الأصليين)",
 "apios tuberosa": "أبيوس, بطاطس هندية (كرمة من أمريكا الشمالية ذات أزهار عطرة ودرنات صالحة للأكل؛ محصول غذائي مهم للأمريكيين الأصليين)",
 "apis mellifera": "نحل العسل (نحل اجتماعي يتم تدجينه غالباً من أجل العسل الذي ينتجه)",
 "apis mellifera adansonii": "نحل أفريقي, نحل قاتل (سلالة من النحل نشأت في البرازيل في الخمسينيات كتهجين بين نحل أفريقي عدواني ونحل عسل؛ تحتفظ بمعظم سمات النحل الأفريقي)",
 "apis mellifera scutellata": "نحل أفريقي, نحل قاتل (سلالة من النحل نشأت في البرازيل في الخمسينيات كتهجين بين نحل أفريقي عدواني ونحل عسل؛ تحتفظ بمعظم سمات النحل الأفريقي)",
 "apish": "قِرْدِيّ التَّقْلِيد, مُقَلِّد بِعَمَى (يُقلِّد تقليداً ذليلاً وخاضعاً بلا تفكير)",
 "apishamore": "بطانية سرج من جلد الجاموس (بطانية سرج مصنوعة من جلد الجاموس)",
 "apium graveolens": "كرفس بري (عشب من أوروبا وآسيا المعتدلة)",
 "apium graveolens dulce": "كرفس (عشب يزرع على نطاق واسع بسيقان أوراق عطرية تؤكل نيئة أو مطبوخة)",
 "apium graveolens rapaceum": "كرفس جذري, كرفس لفتي (يزرع لجذره العطري السميك الصالح للأكل)",
 "apivorous": "آكِل لِلنَّحْل (يتغذى على النحل)",
 "aplacental": "لا مشيمي (ليس له مشيمة)\nمثال: أحاديات المسلك والجرابيات هي ثدييات لا مشيمية",
 "aplacophoran": "محاريات دودية (رخويات تشبه الديدان تعيش في المياه العميقة تفتقر إلى الصفائح الجيرية على الجسم ولكن لها شويكات لزجة دقيقة على العباءة المغطية)",
 "aplanatic": "لَا كُرَوِيُّ الزَّيَغ (خَالٍ مِنَ الزَّيَغِ الكُرَوِيِّ أَوْ مُصَحَّحٌ مِنْه)",
 "aplasia": "عدم التنسج, لاتنسج (فشل بعض الأنسجة أو الأعضاء في النمو)",
 "aplastic anaemia": "فقر الدم اللاتنسجي (فقر دم يتميز بقلة الكريات الشاملة الناتجة عن فشل نخاع العظم؛ يمكن أن يكون سببه ورم أو تعرض لسموم)",
 "aplastic anemia": "فقر الدم اللاتنسجي (فقر دم يتميز بقلة الكريات الشاملة الناتجة عن فشل نخاع العظم؛ يمكن أن يكون سببه ورم أو تعرض لسموم)",
 "aplectrum hyemale": "آدم وحواء, جذر المعجون (أوركيد أمريكي شمالي يحمل ورقة واحدة وزهوراً بنية مصفرة)",
 "aplite": "أبليت (صخر جرانيتي فاتح اللون وناعم الحبيبات يتكون بشكل رئيسي من الكوارتز والفلسبار)",
 "aplitic": "أبليتي (من أو متعلق بصخر الأبليت)",
 "aplodontia rufa": "قندس الجبل (قارض ليلي ضخم يحفر الجحور في مرتفعات ساحل المحيط الهادئ لأمريكا الشمالية؛ وهو أكثر القوارض الحية بدائية)",
 "aplomb": "ثبات, ثقة بالنفس (برود أعصاب وهدوء كبير تحت الضغط)\nمثال: حافظ على هدوئك",
 "aplysia punctata": "أرنب البحر (بطني قدم بحري عارٍ له جسم رخو بصدفة داخلية مختزلة وزوجين من المجسات تشبه الأذن)",
 "apnea": "انقطاع النفس (توقف التنفس المؤقت)",
 "apneic": "توقفي التنفس (من أو متعلق بانقطاع التنفس)",
 "apneumone": "أَبْنِيُومُون",
 "apnoeic": "توقفي التنفس (من أو متعلق بانقطاع التنفس)",
 "apoapsis": "أوج, نقطة الأوج ((في الفلك) النقطة في المدار الأبعد عن الجرم الذي يتم الدوران حوله)",
 "apocalypse": "الْقِيَامَة, نِهَايَةُ الْعَالَم",
 "apocalyptic": "أَخْرَوِيّ, كَارِثِيّ (يُنبِئ بالدمار أو الهلاك النهائي) / رؤيوي, قيامي (من أو متعلق بنهاية العالم (أبوكاليبس))",
 "apocalyptical": "أَخْرَوِيّ, كَارِثِيّ (يُنبِئ بالدمار أو الهلاك النهائي)",
 "apocarpous": "مُنْفَصِل الكَرَابِل ((لمبايض النباتات الزهرية) تتكون من كرابل (خباء) منفصلة عن بعضها البعض كما في الحوذان أو الورود)",
 "apocatastasis": "اِسْتِعَادَة كُلِّيَّة",
 "apochromatic": "لَا لَوْنِيٌّ كُرَوِيّ (مُصَحَّحٌ مِنَ الزَّيَغِ اللَّوْنِيِّ وَالكُرَوِيِّ مَعًا)",
 "apocope": "ترخيم, حذف الآخر (اختصار الكلمة عن طريق حذف الصوت أو الأصوات الأخيرة)",
 "apocrine": "مُفْرِز ((للغدد خارجية الإفراز) تنتج إفرازاً يتم فيه إطلاق جزء من الخلية المفرزة مع الإفراز)\nمثال: حليب الأم هو أحد الإفرازات المفترزة",
 "apocrine gland": "غدة مفترزة (غدة عرقية كبيرة تنتج كلاً من السائل والإفراز المفترز؛ توجد في البشر في المناطق المشعرة من الجسم)",
 "apocrypha": "أبوكريفا, الأسفار المنحولة (كتب من العهد القديم مضمنة في الفولجاتا ولكنها محذوفة في النسخ اليهودية والبروتستانتية للكتاب المقدس)",
 "apocryphal": "شاذ, منكر / مشكوك في صحته, ضعيف",
 "apocryphalness": "شكية, منحولية (خاصية كون الشيء مشكوكاً في صحته، أو يفتقر إلى السلطة، أو لا يعتبر قانونياً) / عدم موثوقية, مشكوكية (خاصية كون الشيء مشكوكاً في صحته؛ أو مشكوكاً في دقته أو صدقه)\nمثال: لست متأكداً من مدى عدم موثوقية هذه القصة",
 "apocynaceous": "دفلية (من أو متعلق بالنباتات الاستوائية من الفصيلة الدفلية)",
 "apocynum androsaemifolium": "دفل شائع, قاتل الكلب الشائع (نبات معمر في أمريكا الشمالية له أزهار وردية في نورات محدودة سائبة؛ يستخدم في الطب الشعبي لعلاج الألم أو الالتهاب في المفاصل)",
 "apocynum cannabinum": "دفل كندي, قنب هندي (دفل كندي ينتج أليافاً قوية يستخدمها الأمريكيون الأصليون كحبال؛ يستخدم في الطب الشعبي لألم المفاصل أو الالتهابات)",
 "apocynum pumilum": "دفل جبال الروكي (نبات من أمريكا الشمالية يشبه الدفل الشائع)",
 "apodal": "عَدِيمُ القَوَائِم ((عَنِ الأَفَاعِي وَالأَنْقَلَيْسِ) بِلَا أَقْدَامٍ بِطَبِيعَتِهِ)",
 "apodeictic": "بُرْهَانِيّ, يَقِينِيّ ((يوصف به القضية) صحيح بالضرورة أو مؤكد منطقيًّا)",
 "apodeme": "أَبُودِيم",
 "apodemus sylvaticus": "فأر الخشب الأوروبي (فأر ليلي بني مصفر يسكن الغابات والحقول والحدائق)",
 "apodictic": "بُرْهَانِيّ, يَقِينِيّ ((يوصف به القضية) صحيح بالضرورة أو مؤكد منطقيًّا)",
 "apodictic certainty": "قضية يقينية (قضية صحيحة بالضرورة أو يقينية منطقياً)",
 "apodictic proposition": "قضية يقينية (قضية صحيحة بالضرورة أو يقينية منطقياً)",
 "apodiform bird": "سماميات (طائر غير جاثم له أجنحة طويلة وأقدام ضعيفة؛ يقضي معظم وقته في الطيران)",
 "apodosis": "جَوَابُ الشَّرْط (الجَوَاب : ما يكون رَدًّا على سؤالٍ أَو دعاءٍ أَو دَعْوَى، أَو رسالةٍ أَو اعتراضٍ ونحو ذلك والجمع : أَجوبة الأعراف - 82؛ الجَوَاب: صوت جَوْبِ الطير وفي حديث بناءِ الكعبة: حديث شريف فسمعنا جواباً من السماءِ، فإِذا بطائر أَعظم من النَّسر)\nمثال: لقد وجدتم الجواب.",
 "apodous": "عَدِيمُ القَوَائِم ((عَنِ الأَفَاعِي وَالأَنْقَلَيْسِ) بِلَا أَقْدَامٍ بِطَبِيعَتِهِ)",
 "apoenzyme": "أبوإنزيم (بروتين يتحد مع إنزيم مساعد لتكوين إنزيم نشط)",
 "apogametic": "تولدي لا تزاوجي (من أو متعلق بتطور الجنين في غياب الإخصاب)",
 "apogamic": "تولدي لا تزاوجي (من أو متعلق بتطور الجنين في غياب الإخصاب)",
 "apogamous": "تولدي لا تزاوجي (من أو متعلق بتطور الجنين في غياب الإخصاب)",
 "apogamy": "توالد مشيجي لا تزاوجي ((علم النبات) تطور جنين دون إخصاب؛ وخاصة تطور النبات البوغي من النبات المشيجي في بعض السراخس دون إخصاب)",
 "apogean": "أوجي (يتعلق بـ أو من خصائص الأوج (أبعد نقطة في المدار))\nمثال: تحدث المد والجزر الأوجي عندما يكون القمر في أوج مداره",
 "apogee": "أَوْج",
 "apogon maculatus": "سمكة اللهب (سمكة كاردينال توجد في المياه الساحلية الأطلسية الاستوائية)",
 "apojove": "أوج المشتري (نقطة الأوج في المدار حول كوكب المشتري)",
 "apolemia": "أبوليما (سحاري كبير يصل طوله إلى 50 قدماً)",
 "apolitical": "لَا سِيَاسِيّ, مُحَايِد سِيَاسِيًّا (محايد من الناحية السياسية)",
 "apoliticism": "عزوف عن السياسة, لا سياسية (اللامبالاة و/أو الكراهية تجاه جميع الانتماءات السياسية)\nمثال: وهكذا أدى السعي الفرنسي بين الحربين للعزوف عن السياسة إلى أكثر المحاكمات سياسية في تاريخ الأمة",
 "apollo": "أَبُولُّو, هَدَّاب",
 "apologetic": "اعتذاري, معتذر (يقدم أو يعبر عن اعتذار)\nمثال: مذكرة اعتذار",
 "apologetically": "بأسف, باعتذار (بطريقة اعتذارية)\nمثال: تحدث بأسف عن ماضيه",
 "apologetics": "دِفَاعِيَّات",
 "apologia": "دفاع مكتوب (دفاع رسمي مكتوب عن شيء تؤمن به بقوة)",
 "apologist": "مدافع, مُبرر (شخص يجادل للدفاع عن أو تبرير سياسة أو مؤسسة ما)\nمثال: مدافع عن عقوبة الإعدام",
 "apologize": "اِعْتَذَرَ, اِسْتَعْذَرَ",
 "apologue": "أمثولة, حكاية رمزية (قصة أخلاقية قصيرة (غالباً ما تكون شخصياتها من الحيوانات))",
 "apology": "اِعْتِذَار, عُذْر / دِفَاع, تَبْرِير",
 "apolune": "أوج قمري (نقطة الأوج في المدار حول القمر)",
 "apolysis": "اِنْسِلَاخ دَاخِلِيّ, اِنْفِصَال",
 "apomict": "نبات تكاثر لا جنسي, نبات لا تزاوجي (مصدر للفعل نَبَتَ؛ اسم جنس شامل لكل ما تنبته الأرض من شجر أو بقل أو عشب أو غيره)\nمثال: هذا النبات مهدد بالانقراض.",
 "apomictic": "تَوَالُدِيّ عَذْرِيّ, لَاجِنْسِيّ ((عن التكاثر) لا ينطوي على اندماج خلايا ذكرية وأنثوية) / تولدي لا جنسي",
 "apomictical": "تولدي لا جنسي",
 "apomixis": "أبوميكسيس, تكون لاجنسي (أي من عدة أنواع من التكاثر دون إخصاب)",
 "apomorphine": "أبومورفين (مشتق من المورفين ليس بقوة المورفين؛ يستخدم كمقيئ وبجرعات صغيرة كمهدئ)",
 "aponeurosis": "وَتَر عَرِيض (خيط شديد أو سلك يربط بين طرفي القوس ليستخدم في إطلاق السهام. سمي كذلك لأنه واحد، مشتق من الوِتْر وهو الفرد؛ خيط شديد أو سلك يربط على الآلة الموسيقية لإطلاق الصوت. سمي كذلك تشبيها له بوَتَر القَوْس)",
 "aponeurotic": "سفاقي (من أو متعلق بالسفاق (غشاء وتر عريض))\nمثال: عضلات متصلة بغشاء سفاقي مسطح",
 "apopemptic": "وداعي (موجه لمن هو على وشك المغادرة)\nمثال: ترانيم وداعية",
 "apophasis": "تجاهل متعمد (ذكر شيء ما بالقول إنه لن يتم ذكره)",
 "apophatic": "تنزيلي, تنزيهي (من أو متعلق بالاعتقاد بأن الله لا يمكن للبشر معرفته إلا من حيث ما ليس هو عليه (مثل 'الله لا يدرك'))",
 "apophatism": "تنزيه مطلق, لاهوت سلبي (الاعتقاد الديني بأن الله لا يمكن معرفته ولكنه 'مغاير' تماماً ويجب وصفه بمصطلحات سلبية (بما ليس هو عليه))",
 "apophis": "أبوفيس",
 "apophthegm": "حكمة موجزة, قول مأثور (قول تعليمي موجز وبليغ)",
 "apophyseal": "ناتئ (من أو متعلق بالناتئ (بروز عظمي))",
 "apophysis": "زَائِدَة جِدَارِيَّة",
 "apoplectic": "سكتي (متعلق بـ أو من خصائص السكتة الدماغية)\nمثال: نوبة سكتية",
 "apoplectiform": "شبيه بالسكتة (يشبه السكتة الدماغية)",
 "apoplectoid": "شبيه بالسكتة (يشبه السكتة الدماغية)",
 "apoplexy": "جلطة, سكتة دماغية (فقدان مفاجئ للوعي ناتج عن تمزق أو انسداد الأوعية الدموية مما يؤدي إلى نقص الأكسجين في الدماغ)",
 "apoptosis": "اسْتِماتَة",
 "aporocactus flagelliformis": "صبار ذيل الجرذ (صبار استوائي أمريكي يزرع عادة وله سيقان زاحفة نحيلة وأزهار قرمزية مبهرجة كبيرة جداً تتفتح لعدة أيام)",
 "aporophobia": "رهاب الفقراء",
 "aposelene": "أوج قمري (نقطة الأوج في المدار حول القمر)",
 "aposematic coloration": "تلوين تحذيري (تلوين أو علامات واضحة للحيوان تعمل على تحذير الحيوانات المفترسة)\nمثال: التلوين التحذيري للظربان",
 "aposematism": "مَظْهَر تَحْذِيرِيّ (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠)\nمثال: تبدو بمظهر جميل",
