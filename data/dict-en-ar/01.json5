 "armenia": "أَرْمِينِيَا ((تاريخًا) مملكة أرمينيا، مملكة حكمت ما بين عامي ٣٨٠ قبل الميلاد و٣٨٧/٤٢٨ للميلاد؛ (تاريخًا) مملكة أرمينيا، مملكة حكمت في العصور الوسطى، ما بين عامي ٨٨٥ و١٠٤٥ للميلاد)\nمثال: خسرت أرمينيا الحرب.",
 "armenian": "أَرْمَنِيّ, أَرْمِينِيّ",
 "armenian alphabet": "الأبجدية الأرمنية (نظام كتابة يحتوي على أبجدية من 38 حرفاً تُكتب بها اللغة الأرمنية)",
 "armenian apostolic orthodox church": "الكنيسة الأرمنية, الكنيسة الرسولية الأرمنية (كنيسة مسيحية مستقلة تأسست في أرمينيا منذ عام 300؛ تأثرت بالتقاليد الرومانية والبيزنطية)",
 "armenian church": "الكنيسة الأرمنية, الكنيسة الرسولية الأرمنية (كنيسة مسيحية مستقلة تأسست في أرمينيا منذ عام 300؛ تأثرت بالتقاليد الرومانية والبيزنطية)",
 "armenian cucumber": "فَقُّوس, قِثَّاء",
 "armenian language": "اللغة الأرمينية (اللغة الهندية الأوروبية التي يتم التحدث بها في الغالب في أرمينيا، ولكن أيضًا في أذربيجان)",
 "armenian monetary unit": "وحدة نقدية أرمينية (الوحدة النقدية في أرمينيا)",
 "armeria maritima": "قرنفل البحر, ورد الجرف (نبات معنقد في السواحل والجبال في المنطقة المعتدلة الشمالية؛ يزرع أحياناً كغطاء أرضي)",
 "armerican cheddar": "جبن شيدر, شيدر (جبن صلب ناعم الملمس؛ صنع أصلاً في شيدر في جنوب غرب إنجلترا)",
 "armet": "خوذة أرميت (خوذة من العصور الوسطى ذات قناع وواقي للرقبة)",
 "armful": "حِضن, ملء الذراعين (الكمية التي يمكن احتواؤها بين الذراعين)",
 "armguard": "حامي الساعد, واقي الذراع (غطاء واقٍ للمعصم أو الذراع يستخدم في الرماية والمبارزة ورياضات أخرى)",
 "armhole": "فتحة الذراع, فتحة الكم (ثقب تضع ذراعك من خلاله وحيث يمكن ربط الكم)",
 "armiger": "حامل الشعار (نبيل يحق له حمل شعار النبالة) / حامل الدروع (مرافق يحمل درع الفارس)",
 "armilla": "سوار الذراع ((علم الآثار) سوار يلبس حول المعصم أو الذراع) / الإسطرلاب الكروي, ذات الحلق (كرة سماوية تتكون من أطواق معدنية؛ استخدمها علماء الفلك الأوائل لتحديد مواقع النجوم)",
 "armillaria caligata": "أرميلاريا منتعلة (فطر بقبعة بنية وخياشيم بيضاء وحلقة غشائية في منتصف الساق)",
 "armillaria ponderosa": "ماتسوتاكي أبيض (فطر أبيض كبير يطور بقعاً بنية مع تقدمه في العمر؛ الخياشيم بيضاء؛ الرائحة حارة وعطرية؛ يجمع تجارياً للطبخ الشرقي في شمال غرب المحيط الهادئ)",
 "armillaria zelleri": "أرميلاريا زيلر (فطر كبير بقبعة لزجة تجف وتتحول إلى بنية مع تقدم العمر؛ الخياشيم بيضاء مائلة للصفرة)",
 "armillariella mellea": "فطر العسل (فطر صالح للأكل بلون العسل يرتبط عادة بجذور الأشجار في أواخر الصيف والخريف؛ لا يؤكل نيئاً)",
 "armillary": "حلقية, سوارية (من أو متعلق بالأساور (أو الحلقات الفلكية))",
 "armillary sphere": "الإسطرلاب الكروي, ذات الحلق (كرة سماوية تتكون من أطواق معدنية؛ استخدمها علماء الفلك الأوائل لتحديد مواقع النجوم)",
 "arming": "تجهيز, تسليح (فعل التجهيز بالأسلحة استعداداً للحرب)",
 "arminian": "أرميني (من أو متعلق بالأرمينية (مذهب ديني مسيحي)) / أَرْمِينِيّ (معتنق للأرمينية (اللاهوتية))",
 "arminian baptist": "المعمدانيون الأرمينيون, المعمدانيون العامون (مجموعة من التجمعات المعمدانية التي تؤمن بتعاليم اللاهوتي الهولندي جاكوبوس أرمينيوس (الذي عارض عقيدة القدر الصارمة للكالفينيين))",
 "arminian church": "الكنيسة الأرمينية (الطائفة البروتستانتية الملتزمة بآراء جاكوبوس أرمينيوس)",
 "arminianism": "أرمينيانية (لاهوت القرن السابع عشر (سُمي باسم مؤسسه يعقوب أرمينيوس) الذي يعارض الجبرية المطلقة لجون كالفن ويرى أن الإرادة الحرة للإنسان متوافقة مع سيادة الله)",
 "armistice": "هُدْنَة / هُدْنَة, وَقْفُ نَار",
 "armistice day": "11 نوفمبر, يوم المحاربين القدامى (عطلة قانونية في الولايات المتحدة؛ كانت تسمى سابقًا يوم الهدنة ولكن سميت يوم المحاربين القدامى منذ عام 1954)",
 "armless": "بِلَا أَذْرُع, مَبْتُور الذِّرَاعَيْن (ليس لديه أذرع)\nمثال: فينوس دي ميلو مبتورة الذراعين",
