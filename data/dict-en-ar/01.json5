 "arcsecond": "ثانية, ثانية قوسية (الجزء الستون من دقيقة القوس)\nمثال: الكنز يقع على بعد دقيقتين و45 ثانية جنوب هنا",
 "arcsin": "قَوْس الجَيْب, مَعْكُوس الجَيْب (الدالة العكسية للجيب؛ الزاوية التي لها جيب يساوي عدداً معيناً)",
 "arcsine": "قَوْس الجَيْب, مَعْكُوس الجَيْب (الدالة العكسية للجيب؛ الزاوية التي لها جيب يساوي عدداً معيناً)",
 "arctan": "قَوْس الظِّلّ, مَعْكُوس الظِّلّ (الدالة العكسية للظل؛ الزاوية التي لها ظل يساوي عدداً معيناً)",
 "arctangent": "قَوْس الظِّلّ, مَعْكُوس الظِّلّ (الدالة العكسية للظل؛ الزاوية التي لها ظل يساوي عدداً معيناً)",
 "arctic": "قُطْبِيّ شَمَالِيّ",
 "arctic char": "شار قطبي (ترويت صغير في المياه الشمالية؛ توجد مجموعات حبيسة في كيبيك وشمال نيو إنجلاند)",
 "arctic circle": "الدَّائِرَة الْقُطْبِيَّة الشَّمَالِيَّة",
 "arctic fox": "ثعلب أبيض, ثعلب قطبي (ثعلب كثيف الفرو من المناطق القطبية؛ بني في الصيف وأبيض في الشتاء)",
 "arctic ground squirrel": "سنجاب الأرض القطبي (سنجاب أرضي كبير من أقصى شمال أمريكا الشمالية)",
 "arctic hare": "أرنب قطبي (أرنب بري كبير من شمال أمريكا الشمالية؛ يكون أبيض بالكامل تقريباً في الشتاء)",
 "arctic moss": "طحلب الرنة (أشنة متفرعة رمادية منتصبة في القطب الشمالي وحتى بعض المناطق المعتدلة الشمالية تشكل الغذاء الرئيسي للرنة والكاريبو وأحياناً يأكلها البشر)",
 "arctic mouse-ear": "أذن الفأر الألبي, أذن الفأر القطبي (منتشرة في القطب الشمالي وعلى الجبال في أوروبا)",
 "arctic ocean": "الْمُحِيط الْمُتَجَمِّد الشَّمَالِيّ, الْمُحِيط الشَّمَالِيّ",
 "arctic poppy": "خشخاش آيسلندا, خشخاش قطبي (خشخاش معمر شبه قطبي في نصفي الكرة الأرضية ذو زهور عطرة بيضاء أو صفراء إلى برتقالية أو خوخية)",
 "arctic skua": "كركر طفيلي, كركر قطبي (نوع من الكركر)",
 "arctic willow": "صفصاف قطبي (شجيرة زاحفة منخفضة في القطب الشمالي لأوروبا وأمريكا)",
 "arctic wolf": "ذئب أبيض, ذئب قطبي (ذئب من القطب الشمالي لأمريكا الشمالية ذو فرو أبيض وذيل أسود الطرف)",
 "arcticonus thibetanus": "دب أسود آسيوي (دب ذو معطف أسود يعيش في وسط وشرق آسيا)",
 "arctictis bintourong": "بنتورونغ, قط دب (زباد شجري من آسيا ذو ذيل طويل قابض وشعر أسود أشعث)",
 "arctictis binturong": "بنتورونغ, قط دب (زباد شجري من آسيا ذو ذيل طويل قابض وشعر أسود أشعث)",
 "arctiid": "عثة النمر (عثة ممتلئة الجسم عريضة الأجنحة ذات أجنحة مخططة أو مرقطة بشكل واضح؛ اليرقات هي يرقات مشعرة)",
 "arctiid moth": "عثة النمر (عثة ممتلئة الجسم عريضة الأجنحة ذات أجنحة مخططة أو مرقطة بشكل واضح؛ اليرقات هي يرقات مشعرة)",
 "arctium lappa": "أرقطيون كبير, لزيق (أرقطيون بأوراق على شكل قلب يوجد في الغابات المفتوحة والأسيجة والمراعي الوعرة في أوروبا (باستثناء أقصى الشمال) وآسيا الصغرى؛ يزرع أحياناً للاستخدام…)",
 "arctium minus": "أرقطيون شائع, أرقطيون صغير (نبات موجود في كل مكان ما عدا التربة شديدة الحموضة؛ يوجد في معظم أوروبا وشمال أفريقيا)",
 "arctocebus calabarensis": "أنغوانتيبو, بوتو ذهبي (نوع من الليمور الأصفر أو الذهبي)",
 "arctocephalus townsendi": "فقمة غوادالوبي (فقمة فراء تعيش في ساحل المحيط الهادئ لكاليفورنيا وجنوباً)",
 "arctonyx collaris": "غرير الخنزير (غرير من جنوب شرق آسيا له خطم مثل الخنزير)",
 "arctostaphylos alpina": "عنب الدب الألبي, قطلب ألبي (شجيرة زاحفة متساقطة الأوراق تكون حمراء زاهية في الخريف ولها توت أسود أو أزرق مسود؛ ألبية وقطبية)",
 "arctostaphylos andersonii": "مانزانيتا قلبية الأوراق (شجيرة كاليفورنية قائمة لها أوراق ذات فصوص قلبية الشكل عند القاعدة)",
 "arctostaphylos manzanita": "مانزانيتا باري (شجيرة تشبه الشجرة قائمة تشكل غابات كثيفة ولها عناقيد متدلية من الزهور البيضاء أو الوردية وثمار حمراء تشبه التوت؛ كاليفورنيا)",
 "arctostaphylos tomentosa": "مانزانيتا زغبية (شجيرة كاليفورنية قائمة مفتوحة التفرع تكون أغصانها صوفية عندما تكون صغيرة)",
 "arctostaphylos uva-ursi": "عنب الدب, قطلب عنب الدب (شجيرة دائمة الخضرة تشكل حصيرة من أمريكا الشمالية وشمال أوراسيا لها زهور بيضاء صغيرة وتوت أحمر؛ تتحول الأوراق إلى الأحمر في الخريف)",
 "arctotis stoechadifolia": "أقحوان أفريقي أزرق العينين (نبات معمر كثيف من جنوب أفريقيا ذو زهور بيضاء أو بنفسجية؛ يغطي في موطنه الأصلي جوانب الوديان بأكملها بغطاء ملون)",
 "arctotis venusta": "أقحوان أفريقي أزرق العينين (نبات معمر كثيف من جنوب أفريقيا ذو زهور بيضاء أو بنفسجية؛ يغطي في موطنه الأصلي جوانب الوديان بأكملها بغطاء ملون)",
 "arcturus": "السماك الرامح",
 "arcuate": "قَنْطَرِيّ, مُقَوَّس (يشكل قوسًا أو يشبهه)",
 "arcuate artery": "شريان مقوس (شريان منحني في القدم)",
