 "article of commerce": "سلعة تجارية (سلعة معروضة للبيع)",
 "article of faith": "إيمان راسخ, قناعة (إيمان راسخ بشيء ما دون الحاجة إلى إثبات أو دليل) / بند إيمان ((المسيحية) أي من الأقسام التي ينقسم إليها قانون الإيمان أو أي بيان عقائدي آخر)",
 "article of furniture": "أثاث, عفش (المفروشات التي تجعل الغرفة أو أي منطقة أخرى جاهزة للإشغال)\nمثال: كان لديهم الكثير من الأثاث للشقة الصغيرة",
 "articled": "مُتَعَاقِد, مُلْزَم بِعَقْد (مُقَيَّد بِمُوجَب عَقْد)",
 "articles of agreement": "عقد العمل البحري (عقد بين الطاقم وقبطان السفينة)",
 "articles of incorporation": "النظام الأساسي للشركة, عقد التأسيس (وثيقة قانونية تنشئ شركة؛ يتم تقديمها إلى الولاية من قبل مؤسسي الشركة وتحكمها قوانين الولاية)",
 "articular": "مفصلي (يتعلق بـ أو يؤثر على مفاصل الجسم)\nمثال: الأسطح المفصلية للعظام",
 "articular muscle": "عضلة مفصلية (عضلة ترتكز مباشرة على محفظة المفصل)",
 "articulary": "مفصلي (يتعلق بـ أو يؤثر على مفاصل الجسم)\nمثال: الأسطح المفصلية للعظام",
 "articulate": "تَلَفَّظَ",
 "articulated": "مَفْصِلِيّ (يتكون من أجزاء متماسكة بواسطة مفاصل)",
 "articulated ladder": "سلم مفصلي (سلم يتكون من قطاعات (عادة أربعة) متماسكة بواسطة مفاصل يمكن تثبيتها في مكانها)",
 "articulated lorry": "تريلا, شاحنة مقطورة (شاحنة تتكون من جرار ومقطورة معاً)",
 "articulately": "بِبيَان, بِفَصَاحَة (بطريقة فصيحة) / بِبَلَاغَة, بِبَيَان (مع الفصاحة)\nمثال: جادل بفصاحة لخطته",
 "articulateness": "طلاقة, فصاحة (جودة السهولة في الكلام والكتابة)",
 "articulatio": "مفصل ((في التشريح) نقطة الاتصال بين عظمين أو عناصر هيكل عظمي (خاصة إذا كانت تسمح بالحركة))",
 "articulatio coxae": "مفصل الورك, ورك (المفصل الكروي بين رأس عظم الفخذ والحق)",
 "articulatio cubiti": "مرفق, مفصل المرفق (مفصل رزي بين الساعد والعضد والمفصل المقابل في الطرف الأمامي لذوات الأربع)",
 "articulatio genus": "ركبة, مفصل الركبة (مفصل رزي في الساق البشرية يربط القصبة والشظية بعظم الفخذ وتحميه الرضفة من الأمام)",
 "articulatio humeri": "كتف, مفصل الكتف (مفصل كروي بين رأس عظم العضد وتجويف لوح الكتف)",
 "articulatio plana": "مفصل انزلاقي, مفصل مسطح (مفصل حر الحركة تسمح فيه التمفصلات بحركات انزلاقية فقط)",
 "articulatio radiocarpea": "رسغ, مفصل الرسغ (مفصل بين النهاية البعيدة للكعبرة والصف القريب من عظام الرسغ)",
 "articulatio spheroidea": "مفصل كروي, مفصل كروي وحقي (مفصل حر الحركة تتناسب فيه كرة على رأس عظم مع تجويف دائري في العظم الآخر)",
 "articulatio synovialis": "مفصل زليلي (مفصل يتمفصل بحيث يتحرك بحرية)",
 "articulatio talocruralis": "كاحل, مفصل الكاحل (مفصل انزلاقي بين النهايات البعيدة للقصبة والشظية والنهاية القريبة للكاحل)",
 "articulatio temporomandibularis": "مفصل صدغي فكي, مفصل فكي (المفصل بين رأس عظم الفك السفلي والعظم الصدغي)",
 "articulatio trochoidea": "مفصل محوري, مفصل مداري (مفصل حر الحركة تقتصر فيه الحركة على الدوران)\nمثال: مفصل الكعبرة والزند في الذراع هو مفصل محوري",
 "articulation": "تمفصل (عملية ربط الأشياء بطريقة تجعل الحركة ممكنة) / مفصل ((في التشريح) نقطة الاتصال بين عظمين أو عناصر هيكل عظمي (خاصة إذا كانت تسمح بالحركة)) / تعبير, نطق (التعبير بشكل لفظي متماسك) / تلفظ, نطق مخارج الحروف (جانب النطق الذي يتضمن جمع أعضاء النطق معاً لتشكيل أصوات الكلام)\nمثال: التعبير عن مشاعري",
 "articulative": "نطقي (من أو متعلق بالنطق (مخارج الحروف))\nمثال: سمات نطقية",
 "articulator": "عضو ناطق (عضو نطق متحرك) / لافظ (شخص يلفظ الكلمات)",
 "articulatory": "نطقي (من أو متعلق بالنطق (مخارج الحروف))\nمثال: سمات نطقية",
 "articulatory system": "الجهاز المفصلي (نظام المفاصل في الجسم)",
 "artifact": "صَنِيعَة, مَصْنُوعَة (شيء من صنع الإنسان يُؤخَذ ككلّ متكامل)",
 "artifactual": "اصطناعي, مصنوع (من أو يتعلق بالأشياء التي من صنع الإنسان (اللقى الأثرية))",
 "artifice": "خدعة, مكيدة (مناورة خادعة (خاصة لتجنب الأسر))",
 "artificer": "صانع أسلحة, مسؤول تسليح (جندي مجند مسؤول عن صيانة الأسلحة الصغيرة والمدافع الرشاشة وما إلى ذلك) / حرفي, صانع ماهر (عامل ماهر يمارس حرفة أو صناعة يدوية) / مخترع, مكتشف (شخص هو أول من فكر في شيء أو صنعه)",
 "artificial": "مُتَصَنَّع, صِنَاعِيّ",
 "artificial additive": "مادة مضافة للطعام, مضاف غذائي (مادة تضاف للطعام لتحسين نكهته أو مظهره أو فترة صلاحيته)",
 "artificial blood": "دم اصطناعي (سائل يمكنه حمل كميات كبيرة من الأكسجين ويمكن أن يكون بديلاً مؤقتاً للدم)",
 "artificial flower": "زهرة اصطناعية (تقليد مصنوع يدوياً لزهرة)",
 "artificial heart": "قلب اصطناعي (مضخة تحل محل القلب الطبيعي)",
 "artificial horizon": "أفق اصطناعي, مؤشر الطيران (أداة ملاحية تعتمد على الجيروسكوب؛ توفر أفقاً محاكياً للطيار بشكل اصطناعي)",
 "artificial insemination": "تلقيح صناعي (إدخال السائل المنوي إلى قناة فالوب أو الرحم بوسيلة غير الجماع الجنسي)",
 "artificial intelligence": "ذَكَاء اِصْطِنَاعِيّ",
 "artificial joint": "مفصل اصطناعي (جزء معدني أو بلاستيكي يُزرع جراحياً ليحل محل مفصل طبيعي (قد يكون الكوع أو الرسغ ولكن عادة الورك أو الركبة))",
 "artificial kidney": "جهاز غسيل الكلى, كلية اصطناعية (آلة تستخدم الديلزة لإزالة الشوائب والفضلات من مجرى الدم قبل إعادة الدم إلى جسم المريض)",
 "artificial lake": "بحيرة صناعية, خزان مائي (بحيرة تستخدم لتخزين المياه للاستخدام المجتمعي؛ بحيرة (طبيعية أو اصطناعية) تستخدم لتخزين المياه واستخدامها كمصدر للمياه)",
 "artificial language": "لغة مبنية, لغة مصطنعة (لغة تم إنشاؤها عمداً لغرض محدد)",
 "artificial pacemaker": "منظم ضربات القلب, ناظمة قلبية (جهاز إلكتروني مزروع يتولى وظيفة ناظمة القلب الطبيعية)",
 "artificial respiration": "تَنَفُّس اِصْطِنَاعِيّ",
 "artificial satellite": "تابع, قمر اصطناعي (معدات من صنع الإنسان تدور حول الأرض أو القمر)",
 "artificial script": "خط مُختلق, نظام كتابة مصطنع (نظام كتابة جديد تم إنشاؤه خصيصاً من قبل فرد أو مجموعة، بدلاً من تطوره كجزء من لغة أو ثقافة مثل الخط الطبيعي)\nمثال: بالين-سيليل هو خط مصطنع اخترعه آيوش شاتورفيدي في نوفمبر 2014 لكتابة لغته المصطنعة التي تحمل الاسم نفسه",
 "artificial selection": "اِنْتِخَاب اِصْطِنَاعِيّ",
 "artificial skin": "جلد صناعي (غطاء اصطناعي من طبقتين يستخدم تجريبياً لعلاج ضحايا الحروق)",
 "artificial turf": "عُشْبٌ اصْطِنَاعِيّ",
 "artificialism": "الاصطناعية, المصطنعة (السريالية التشيكية التي أسسها يندريش شتيرسكي وتوين (ماري سيرمينوفا) في عام 1928)",
 "artificiality": "اصْطِنَاع, تَكَلُّف (صفة كون الشيء من صنع الناس ولا يحدث بشكل طبيعي)",
 "artificially": "اصطناعياً, بشكل غير طبيعي (ليس وفقاً للطبيعة؛ ليس بوسائل طبيعية)\nمثال: ظروف مفتعلة اصطناعياً",
 "artillery": "مِدْفَعِيّة",
 "artillery fire": "نيران مدفعية (نيران تطلقها المدفعية)",
 "artillery plant": "نبات المدفعية (قراص استوائي أمريكي غير لاذع يطلق حبوب اللقاح بشكل متفجر)",
 "artillery shell": "قذيفة مدفعية (قذيفة تطلقها المدفعية)",
 "artillery unit": "مدفعية (وحدة جيش تستخدم المدافع الكبيرة)",
 "artilleryman": "جندي مدفعية, مدفعي (جندي ذكر في سلاح المدفعية)",
 "artillerywoman": "جندية مدفعية (جندية أنثى في سلاح المدفعية)",
 "artiodactyl": "شفعيات الأصابع, مزدوجات الأصابع (ثدييات مشيمية لها حوافر بعدد زوجي من الأصابع الوظيفية في كل قدم) / شفعي الأصابع (من أو متعلق بـ أو ينتمي إلى الثدييات من رتبة مزدوجات الأصابع)",
 "artiodactyl mammal": "شفعيات الأصابع, مزدوجات الأصابع (ثدييات مشيمية لها حوافر بعدد زوجي من الأصابع الوظيفية في كل قدم)",
 "artiodactylous": "شفعي الأصابع (من أو متعلق بـ أو ينتمي إلى الثدييات من رتبة مزدوجات الأصابع)",
 "artisan": "صَانِع, حِرَفِيّ (كل من يَصْنَعُ شيئا؛ من يَمْتَهِنُ الصِّنَاعَة)\nمثال: أحب أن أكون صانع محتوى.",
 "artisan's lien": "حق حبس للحرفي (حق حجز يسمح للحرفي بالاحتفاظ بحيازة قطعة عمل حتى يتم دفع ثمنها)",
 "artist": "فَنَّان, فَنَّانَة (من يصنع الفَنَّ، من يمتهنه؛ مَوْهُوب)\nمثال: إنه فنان مشهور.",
 "artist's loft": "مرسم علوي (طابق علوي لمصنع تم تحويله إلى ورشة عمل ومنطقة معيشة للفنان)",
 "artist's model": "موديل الفنان (شخص يتخذ وضعية لرسام أو نحات)",
 "artist's workroom": "أتيليه, مرسم (استوديو خاص لفنان أو مصمم)",
 "artiste": "فنان استعراضي, مؤدٍ محترف (مؤدٍ عام (راقص أو مغنٍ))",
 "artistic": "ذَوَّاقِيّ, فَنِّيّ (يُلبّي المعايير والحساسيات الجمالية) / جَمَالِيّ, فَنِّيّ (مُمْتِعٌ مِنَ النَّاحِيَةِ الجَمَالِيَّة) / فني (يتعلق بالفن أو الفنانين أو يميزهم)\nمثال: خلفيته الفنية",
 "artistic creation": "إبداع فني, فن (خلق أشياء جميلة أو ذات مغزى)\nمثال: الفن لا يحتاج إلى أن يكون مبتكرًا ليكون جيدًا",
 "artistic language": "لغة خيالية, لغة فنية (لغة مبنية مصممة للمتعة الجمالية)",
 "artistic movement": "حركة فنية (مجموعة من الفنانين يتفقون على مبادئ عامة)",
 "artistic production": "إبداع فني, فن (خلق أشياء جميلة أو ذات مغزى)\nمثال: الفن لا يحتاج إلى أن يكون مبتكرًا ليكون جيدًا",
 "artistic style": "أسلوب فني, طابع فني (أسلوب فنان معين أو مدرسة أو حركة فنية)\nمثال: طابع أوركسترالي خيالي",
 "artistically": "فَنِّيًّا (بطريقة فنية)\nمثال: كان مزيناً فنياً",
 "artistry": "براعة, فن (مهارة فائقة يمكنك تعلمها بالدراسة والممارسة والملاحظة)\nمثال: فن المحادثة",
 "artium baccalaurens": "بكالوريوس الآداب, ليسانس الآداب (درجة البكالوريوس في الآداب والعلوم الإنسانية)",
 "artium magister": "ماجستير الآداب (درجة الماجستير في الآداب والعلوم)",
 "artlang": "لغة خيالية, لغة فنية (لغة مبنية مصممة للمتعة الجمالية)",
 "artless": "بَسِيط, سَاذَج (بسيط وطبيعي؛ بدون مكر أو خداع) / بسيط, ساذج (يتميز بعدم القدرة على إخفاء المشاعر؛ غير ماكر) / سَاذَجٌ, غَيْرُ مُثَقَّفٍ ((عن الأشخاص) يفتقر إلى الثقافة أو المعرفة) / خَالٍ مِنَ الْبَرَاعَةِ, سَاذَج (يُظهر افتقارًا إلى الحرفية والفنّ)\nمثال: أسلوب بسيط",
 "artlessly": "بِبَرَاءَة, بِسَذَاجَة (بطريقة ساذجة) / بِفَجَاجَة, دُونَ مَهَارَة (بطريقة فجة وغير ماهرة)\nمثال: أجابت على أسئلة القاضي بسذاجة",
 "artlessness": "براءة, عفوية (البراءة والصراحة بحكم الخلو من المكر والخداع) / بَرَاءَة, عَفْوِيَّة (صفة السذاجة البريئة)",
 "artocarpus altilis": "شجرة الخبز, فاكهة الخبز (موطنها جزر المحيط الهادئ ولها فاكهة صالحة للأكل ذات قوام يشبه الخبز)"
}
