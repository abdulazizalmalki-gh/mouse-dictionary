 "two-seater": "سيارة رودستر (سيارة مكشوفة لها مقعد أمامي ومقعد خلفي إضافي)",
 "two-sided": "ثُنَائِيّ الجَانِب (ذو جانبين أو جزأين) / ذو وجهين, قابل للقلب (يمكن قلبه أو استخدامه على أي من الجانبين)\nمثال: سترة ذات وجهين",
 "two-spotted ladybug": "دعسوقة ذات نقطتين (دعسوقة حمراء مع بقعة سوداء على كل جناح)",
 "two-step": "تو ستيب, خطوتين (رقصة صالونات بإيقاع ثنائي؛ تتميز بخطوات انزلاقية)",
 "two-thirds": "ثُلْثَان (اثنان من ثلاثة أجزاء متساوية لكل قابل للقسمة)",
 "two-tier bid": "عَرْض مُزْدَوِج السِّعْر (عرض استحواذ حيث يعرض المستحوذ دفع المزيد مقابل الأسهم اللازمة للسيطرة مقارنة بالأسهم المتبقية)",
 "two-timer": "خائن, غادر (شخص يقول شيئاً ويفعل شيئاً آخر) / خائن الشريك (شخص يخدع حبيباً أو زوجاً بإقامة علاقة جنسية مع شخص آخر)",
 "two-toe": "ثُنَائِيُّ الأَصَابِع (لَهُ إِصْبَعَانِ فِي كُلِّ قَدَمٍ)",
 "two-toed": "ثُنَائِيُّ الأَصَابِع (لَهُ إِصْبَعَانِ فِي كُلِّ قَدَمٍ)",
 "two-toed anteater": "آكل النمل الحريري (آكل نمل من أمريكا الجنوبية بحجم السنجاب وعديم الأسنان ذو فرو ذهبي حريري طويل)",
 "two-toed sloth": "كسلان ثنائي الأصابع (كسلان صغير نسبياً وسريع الحركة يمتلك مخلبين طويلين في كل قدم أمامية) / كسلان هوفمان (كسلان من أمريكا الوسطى يمتلك مخلبين طويلين في كل قدم أمامية وثلاثة مخالب طويلة في كل قدم خلفية)",
 "two-way": "ذُو اِتِّجَاهَيْن (يعمل أو يسمح بالعمل في أي من اتجاهين متعاكسين) / ثُنَائِيّ, مِن جُزْأَيْن (يتضمن جزأين أو عنصرين) / ثُنَائِيُّ الحِزْبِيَّة (مَدْعُومٌ مِنْ كِلَا الجَانِبَيْن)",
 "two-way street": "شارع ذو اتجاهين (شارع يمكن لحركة مرور المركبات أن تتحرك فيه في أي من الاتجاهين)\nمثال: عليك أن تنظر في كلا الاتجاهين عند عبور شارع ذي اتجاهين",
 "two-wheel": "ثنائي العجلات, ذو عجلتين (متعلق بالمركبات ذات العجلتين)\nمثال: عربة ذات عجلتين",
 "two-wheeled": "ثنائي العجلات, ذو عجلتين (متعلق بالمركبات ذات العجلتين)\nمثال: عربة ذات عجلتين",
 "two-wing flying fish": "سمكة طائرة أحادية الجناح (تتميز بتضخم الزعانف الصدرية فقط)",
 "two-winged insects": "ثنائيات الأجنحة (حشرات لها عادة زوج واحد من الأجنحة الوظيفية (الزوج الأمامي) مع اختزال الزوج الخلفي إلى هياكل صغيرة تشبه المقبض وأجزاء فم مهيأة للمص أو اللعق أو الثقب)",
 "two-year": "ثنائي الحول, سنتوي (له دورة حياة تستمر لموسمين)\nمثال: دورة حياة ثنائية الحول",
 "two-year-old": "بِعُمُر سَنَتَيْن (في عامه الثاني من العمر)",
 "two-year-old horse": "حصان السنتين (حصان سباق عمره سنتان)",
 "twofer": "قسيمة اثنان بسعر واحد (قسيمة تسمح لحاملها بشراء عنصرين (مثل تذكرتين لمسرحية) بسعر واحد) / عَرْض اثْنَيْن بِسِعْر وَاحِد (عرض لاثنين بسعر واحد)",
 "twofold": "ثُنَائِيّ, مُزْدَوِج / ثُنَائِيّ",
 "twopence": "بنسان (عملة معدنية في المملكة المتحدة قيمتها بنسان)",
 "twopenny": "تَافِه القِيمَة, زَهِيد (ذو قيمة زهيدة لا تُذكَر)",
 "twopenny-halfpenny": "تَافِه القِيمَة, زَهِيد (ذو قيمة زهيدة لا تُذكَر)",
 "twoscore": "أَرْبَعُونَ (يَدُلُّ عَلَى العَدَد 40)",
 "twosome": "ثنائي, زوجان (زوج من الأشخاص يرتبطون ببعضهم البعض) / ثُنَائِيّ, زَوْج (عنصران من نفس النوع)\nمثال: الخطيبان",
 "tycoon": "إمبراطور مالي, بارون (رجل أعمال ثري جداً أو قوي النفوذ)\nمثال: بارون نفط",
 "tying": "ربط, عقد (عملية ربط أو توثيق الأشياء ببعضها البعض)",
 "tying arrangement": "بيع مشروط, ترتيب ربط (اتفاق من قبل طرف لبيع منتج واحد ولكن بشرط أن يشتري المشتري أيضاً منتجاً مختلفاً (أو مرتبطاً)، وعادة ما يكون غير ذي صلة)\nمثال: في السنوات الأخيرة، وضعت الممارسات التجارية المتغيرة المحيطة بالتقنيات الجديدة شرعية ترتيبات الربط قيد الاختبار",
 "tying up": "إرساء, ربط السفينة (فعل تأمين سفينة واصلة بالحبال)",
 "tyiyn": "تيين (100 تيين تساوي 1 سوم في قيرغيزستان)",
 "tyke": "صغير, طفل (شخص صغير السن من أي من الجنسين) / عديم التربية, فظ (شخص فظ غير مهذب يفتقر للثقافة أو الرقي) / تايك (مواطن من يوركشاير)\nمثال: هي تكتب كتباً للأطفال",
 "tylenchus tritici": "دودة القمح (دودة أسطوانية صغيرة تتطفل على القمح)",
 "tylenol": "أسيتامينوفين, باراسيتامول (مسكن للألم الخفيف ولكن ليس للالتهابات؛ يستخدم أيضاً كخافض للحرارة (تايلينول وبانادول وغيرها هي علامات تجارية لأقراص الأسيتامينوفين))",
 "tympan": "طبل (آلة إيقاعية موسيقية؛ تتكون عادة من أسطوانة مجوفة مع غشاء مشدود عبر كل طرف)",
 "tympani": "تيمباني, طبلة نحاسية (آلة إيقاعية نحاسية أو نحاسية كبيرة نصف كروية ذات رأس طبل يمكن ضبطه عن طريق تعديل الشد عليه)",
 "tympanic": "طبلي (مرتبط بطبلة الأذن) / طبلي (يشبه الطبل)",
 "tympanic bone": "عظم طبلي (العظم الذي يحيط بالأذن الوسطى)",
 "tympanic cavity": "أذن وسطى, تجويف طبلي (التجويف الرئيسي للأذن؛ بين طبلة الأذن والأذن الداخلية)",
 "tympanic membrane": "طبلة الأذن, غشاء الطبل (الغشاء الموجود في الأذن الذي يهتز للصوت)",
 "tympanic vein": "وريد طبلي (أوردة من التجويف الطبلي تصب في الوريد خلف الفك السفلي)",
 "tympanist": "عازف التمباني (شخص يعزف على الطبول النحاسية (التمباني))",
 "tympanites": "تطبل البطن (انتفاخ البطن الناجم عن تراكم الغازات في الأمعاء أو التجويف البريتوني)",
 "tympanitic": "طبلي (من أو يتعلق بانتفاخ البطن بالغازات (تطبل))",
 "tympanitis": "التهاب الأذن الداخلية, التهاب الطبلة (التهاب الأذن الداخلية)",
 "tympanoplasty": "رأب الطبلة (تصحيح أو إصلاح جراحي لعيوب أو إصابات طبلة الأذن أو عظام الأذن الوسطى)",
 "tympanuchus cupido": "دجاجة البراري الكبرى (أكثر أنواع دجاج البراري شيوعاً)",
 "tympanuchus cupido cupido": "دجاجة الخلنج (دجاجة براري منقرضة)",
 "tympanuchus pallidicinctus": "دجاجة البراري الصغرى (دجاجة براري أصغر حجماً من غرب تكساس)",
 "tympanum": "قَلْب القَوْصَرَة",
 "tyndall effect": "تأثير تيندال (الظاهرة التي يتشتت فيها الضوء بواسطة جسيمات صغيرة جداً في مساره؛ مما يجعل شعاع الضوء مرئياً؛ الضوء المشتت يكون أزرقاً بشكل رئيسي)",
 "tyne and wear": "تَايْنَ وَوِير",
 "type": "نَوْع, نَمَط (صِنْف؛ في : وحدة تصنيفية أقل من الجنس) / طَبَعَ (طَبَعَ الله الخلقَ : أَنشأَهُ؛ طبَعَت الدَّوْلةُ النَّقْد : صاغتْه ونقشته)\nمثال: انه نوع من الفطر.",
 "type family": "عائلة الخط (مجموعة كاملة من الحروف المناسبة لطباعة النص)",
 "type genus": "جِنْس نَمُوذَجِيّ (الجَمَاعَة أو المَجْمُوعَة الواحدة التي لها صفات تجعلها تنتمي إلى بعض تسمى جِنْسا وهو أعمُّ من النَوْع. ليس للجنس أو النوع ما يحددهما فالبشر كلهم جنس…؛ أحيانا يقصد به ذكر أم أنثى تحديدا)\nمثال: أنا مثلي الجنس.",
 "type i allergic reaction": "تأتب, حساسية فورية (رد فعل تحسسي يظهر بوضوح لدى الشخص المتحسس بعد دقائق فقط من الاتصال)",
 "type i diabetes": "السكري المعتمد على الأنسولين, السكري من النوع الأول (داء سكري شديد يظهر مبكرًا؛ يتميز بكثرة التبول والعطش الشديد وزيادة الشهية وفقدان الوزن والحماض الكيتوني العرضي؛ يتطلب النظام الغذائي وحقن الأنسولين…)",
 "type ii diabetes": "السكري غير المعتمد على الأنسولين, السكري من النوع الثاني (شكل خفيف من داء السكري يتطور تدريجيًا لدى البالغين؛ يمكن أن يحدث بسبب السمنة أو الإجهاد الشديد أو انقطاع الطمث أو عوامل أخرى؛ يمكن السيطرة عليه عادة…)",
 "type iv allergic reaction": "حساسية متأخرة (رد فعل تحسسي يظهر بوضوح فقط بعد ساعات من الاتصال)",
 "type metal": "سبيكة الطباعة, معدن الحروف (سبيكة من القصدير والرصاص والأنتيمون تستخدم لصنع حروف الطباعة)",
 "type of architecture": "أسلوب معماري, طراز معماري (الهندسة المعمارية كنوع من الأشكال الفنية)",
 "type slug": "سبيكة سطرية, سطر طباعي (شريط من معدن الطباعة يستخدم للمباعدة)",
 "type species": "نوع نمطي ((في الأحياء) النوع الذي يمثل أفضل تمثيل للخصائص الأساسية للجنس الذي ينتمي إليه)",
 "type specimen": "عينة نمطية, عينة نموذجية (العينة الأصلية التي يتم بناءً عليها وصف نوع جديد (في البيولوجيا))",
 "typeface": "خط, نمط الخط (حجم وأسلوب محدد للحروف ضمن عائلة خطوط معينة)",
 "typescript": "نص مطبوع (مادة مكتوبة على الآلة الكاتبة خاصة نسخة مطبوعة من مخطوطة)",
 "typeset": "نَضَّدَ (جعل الأشياء بعضها فوق بعض بطريقة مُرَتَّبَة ومُنَظَّمَة)",
 "typesetter": "صفاف, منضد الحروف (شخص يصف المواد المكتوبة في قوالب الطباعة)",
 "typesetter's case": "صندوق الحروف الطباعية ((الطباعة) الوعاء الذي يضع فيه عامل التصفيف حروفه، مقسم إلى خانات للحروف المختلفة)\nمثال: بالنسبة للغة الإنجليزية، عادة ما يكون لدى عامل التصفيف صندوقان من هذا النوع، الصندوق العلوي للحروف الكبيرة والصندوق السفلي للحروف الصغيرة",
 "typesetting": "تَنْضِيد",
 "typesetting machine": "آلة تنضيد الحروف (طابعة تضبط المواد النصية في شكل حروف)",
 "typewrite": "طَبَعَ (طَبَعَ الله الخلقَ : أَنشأَهُ؛ طبَعَت الدَّوْلةُ النَّقْد : صاغتْه ونقشته)\nمثال: بالطبع هي مزحة!",
 "typewriter": "آلَة كَاتِبَة, مِكْتَاب (الفارسية: ماشين؛ الأوردية: مشين)\nمثال: نسى زيري الآلة.",
 "typewriter carriage": "عربة الآلة الكاتبة (عربة لحمل ورقة)",
 "typewriter font": "خط الآلة الكاتبة, خط ثابت العرض (نمط خط يتم فيه إعطاء كل حرف نفس العرض (كما في الآلة الكاتبة))",
 "typewriter keyboard": "لوحة مفاتيح آلة كاتبة (لوحة مفاتيح لإدخال الأحرف يدوياً لطباعتها)",
 "typewriter paper": "ورق آلة كاتبة (ورق كتابة مناسب للاستخدام في الآلة الكاتبة)",
 "typewriter ribbon": "شريط الآلة الكاتبة (شريط طويل من مادة محبرة لطباعة الأحرف على الورق باستخدام الآلة الكاتبة)",
 "typewriting": "طباعة, كتابة على الآلة الكاتبة (الكتابة التي تتم باستخدام آلة كاتبة)",
 "typha angustifolia": "بوط ضيق الأوراق (بوط من أمريكا، أوروبا، شمال أفريقيا، آسيا)",
 "typha latifolia": "بردي, بوط عريض الأوراق (نبات مستنقعات طويل برؤوس بذور أسطوانية تنفجر عند النضج وتذرف كميات كبيرة من الزغب؛ تستخدم أوراقه الطويلة المسطحة لصنع الحصير ومقاعد الكراسي؛ من…)",
 "typhoeus": "تايفوس ((الأساطير اليونانية) ابن غايا وتارتاروس الذي خلق الزوابع؛ كان له صوت مرعب و 100 رأس تنين تنفث النار)",
 "typhoid": "تيفوئيد, حمى التيفوئيد (عدوى خطيرة تتميز بالتهاب وتقرح معوي؛ تسببها السلمونيلا التيفية التي يتم تناولها مع الطعام أو الماء)",
 "typhoid bacillus": "سالمونيلا تيفية, عصوية التيفوئيد (شكل من أشكال السالمونيلا يسبب حمى التيفوئيد)",
 "typhoid bacteriophage": "لاقمة التيفوئيد (لاقمة بكتيرية مخصصة لبكتيريا السالمونيلا التيفية)",
 "typhoid fever": "الْحُمَّى التِّيفِيَّة",
 "typhon": "تايفوس",
 "typhoon": "تَايْفُون, إِعْصَار",
 "typhus": "تِيفُوس",
 "typhus fever": "تيفوس, حمى التيفوس (مرض ريكتسي ينقله قمل الجسم ويتميز بطفح جلدي وحمى شديدة)",
 "typic": "تَمْثِيلِيّ, نَمُوذَجِيّ (يُمثِّل نوعًا معينًا أو يكون مثالًا عليه)",
 "typical": "نَمُوذَجِيّ, مِثَالِيّ",
 "typical jerboa": "يربوع نموذجي (قوارض قفازة ليلية صغيرة ذات أرجل خلفية طويلة؛ من المناطق القاحلة في آسيا وشمال أفريقيا)",
 "typicality": "نموذجية (حالة كون الشيء نموذجياً)",
 "typically": "بشكل نموذجي, عادةً (بطريقة نموذجية أو معتادة)\nمثال: كان توم عدائياً كعادته",
 "typification": "تمثيل رمزي (فعل التمثيل بنوع أو رمز) / تجسيد, تمثيل نمطي (شكل أو نموذج تمثيلي أو نمطي)",
 "typing": "طباعة, كتابة على الآلة الكاتبة (الكتابة التي تتم باستخدام آلة كاتبة)",
 "typing paper": "ورق آلة كاتبة (ورق كتابة مناسب للاستخدام في الآلة الكاتبة)",
 "typing pool": "قسم النسخ, مجموعة الطباعة (مجموعة من الطابعين أو الناسخين الذين يمكنهم العمل لأشخاص مختلفين)",
 "typist": "ضارب على الآلة الكاتبة, طابع (شخص يتقاضى أجراً لتشغيل الآلة الكاتبة)",
 "typo": "خَطَأ مَطْبَعِيّ (تعني ضدّ الصواب. يشمل ذلك الفعل، القول، والرأي. يُستخدم الفعل \"أخطأ\" للدلالة على عدم الإصابة…؛ قام بعمل بعيد عن الصواب أو مخالف للحق سواء كان ذلك في السلوك أو القول أو الكتابة)\nمثال: كان خطأ حاسوبي.",
 "typographer": "صفاف, منضد الحروف (شخص يصف المواد المكتوبة في قوالب الطباعة)",
 "typographic": "طباعي (متعلق بالطباعة أو يحدث فيها أو مستخدم فيها)\nمثال: الفن الطباعي",
 "typographical": "طباعي (متعلق بالطباعة أو يحدث فيها أو مستخدم فيها)\nمثال: الفن الطباعي",
 "typographical error": "خطأ مطبعي, هفوة مطبعية (خطأ في المادة المطبوعة ناتج عن أعطال ميكانيكية من نوع ما)",
 "typographically": "طباعياً (بطريقة طباعية)",
 "typography": "طِبَاعَة, طِبَاعَة الْحَرْفِ",
 "typology": "تصنيف نمطي, نمذجة (التصنيف وفقاً للنوع العام)",
 "tyramine": "تيرامين (حمض أميني مشتق من التيروزين؛ له تأثير محاكي للودي؛ يوجد في الشوكولاتة ومشروبات الكولا والجبن الناضج والبيرة)",
 "tyrannic": "اسْتِبْدَادِيّ, دِكْتَاتُورِيّ (يَتَّسِمُ بِخَصَائِصِ الحَاكِمِ المُطْلَقِ أَوِ الحُكْمِ المُطْلَق؛ ذُو سِيَادَةٍ مُطْلَقَة)",
 "tyrannical": "ظَالِم, غَاشِم",
 "tyrannicide": "قتل الطاغية (قتل حاكم مستبد)",
 "tyrannid": "تيرانيد (طائر جاثم من رتيبة تيراني)",
