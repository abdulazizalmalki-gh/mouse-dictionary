 "trading partner": "شَرِيك تِجَارِيّ",
 "trading post": "متجر ريفي, متجر عام (متجر بيع بالتجزئة يخدم منطقة ذات كثافة سكانية منخفضة؛ عادة ما يكون مخزناً بمجموعة واسعة من البضائع)",
 "trading stamp": "طابع تجاري (رمز يشبه الطابع يعطيه بائع التجزئة للمشتري؛ الرمز قابل للاستبدال بمواد من قائمة خاصة)",
 "tradition": "تَقْلِيد",
 "traditional": "تَقْلِيدِيّ",
 "traditional chinese": "حُرُوف صِينِيَّة تَقْلِيدِيَّة (صِيْغَةُ جَمْعٍ مُفْرَدُهَا: حرف)\nمثال: كيف أتذكر الحروف الصينية؟",
 "traditional chinese medicine": "اَلطِّبّ اَلصِّينِيّ",
 "traditional knowledge": "مأثورات, معرفة تقليدية (المعرفة المكتسبة من خلال التقليد أو الحكايات المتوارثة)\nمثال: نقلت الشعوب المبكرة مأثورات النبات والحيوان من خلال الأساطير",
 "traditionalism": "تقليدية, تمسك بالتقاليد (الالتزام بالتقاليد (خاصة في المسائل الثقافية أو الدينية)) / تَقْلِيدِيَّة, تَمَسُّك بِالتَّقَالِيد (الالتزام الصارم بالأساليب أو التعاليم التقليدية) / تقليدية (المذهب القائل بأن كل المعرفة مستمدة أصلاً من الوحي الإلهي وأنها تنتقل عن طريق التقاليد)",
 "traditionalist": "ضَيِّقُ الأُفُقِ, مُتَزَمِّت (مُحَافِظٌ بِعِنَادٍ وَضَيِّقُ التَّفْكِيرِ) / تقليدي (من يلتزم بالآراء التقليدية)",
 "traditionalistic": "تَقْلِيدَوِيّ, مُحَافِظٌ عَلَى التُّرَاث (يَتَمَسَّكُ بِالتَّقَالِيدِ خُصُوصًا فِي المُمَارَسَاتِ الثَّقَافِيَّةِ أَوِ الدِّينِيَّة)",
 "traditionality": "تَقْلِيدِيَّة, تَمَسُّك بِالتَّقَالِيد (الالتزام الصارم بالأساليب أو التعاليم التقليدية)",
