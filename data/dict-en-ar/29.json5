 "transphobia": "رُهَاب التَحَوُّل الجَنْدَرِيّ, رُهَاب التَحَوُّل الجِنْسِيّ",
 "transphobic": "كَارِهٌ لِلْعَابِرِينَ جِنْسِيًّا (مُتَحَامِلٌ عَلَى المُتَحَوِّلِينَ جِنْسِيًّا)",
 "transpiration": "نتح (انبعاث بخار الماء من أوراق النباتات) / انصباب, نتح (مرور الغازات عبر أنابيب دقيقة بسبب الاختلافات في الضغط أو درجة الحرارة) / نتح (عملية إخراج أو زفر بخار الماء من خلال الجلد أو الأغشية المخاطية)",
 "transpiring": "مترشح, ناضح (الذي يمر من خلال شيء ما)\nمثال: غاز ناضح",
 "transplacental": "عَبْر المَشِيمَة (يحدث عبر المشيمة أو بواسطتها)",
 "transplant": "زَرَعَ, شَتَلَ (بَذَرَ الحَبَّ؛ أَنْبَتَ، نَمَّى) / زَرَعَ (بَذَرَ الحَبَّ؛ أَنْبَتَ، نَمَّى) / زَرْع (بَذَرَ الحَبَّ؛ أَنْبَتَ، نَمَّى)\nمثال: يريد الإنفصاليون زرع رايتهم بمواقع الأنترنت.",
 "transplantable": "قَابِلٌ لِلزَّرْع (يُمْكِنُ نَقْلُهُ وَزَرْعُهُ فِي مَكَانٍ آخَر)",
 "transplantation": "زرع, نقل (عملية إزالة شيء من مكان وإدخاله في مكان آخر) / زراعة الأعضاء, نقل الأعضاء (عملية نقل عضو من كائن حي (المتبرع) إلى آخر (المتلقي))\nمثال: لم تزهر الشتلة المزروعة حتى السنة الثانية",
 "transplanter": "ناقل النباتات (بستاني ينقل النباتات إلى مواقع جديدة)",
 "transplanting": "زرع, نقل (عملية إزالة شيء من مكان وإدخاله في مكان آخر)\nمثال: لم تزهر الشتلة المزروعة حتى السنة الثانية",
 "transpolar": "عابر للقطب (يمتد عبر أحد القطبين أو يقطعه)\nمثال: طرق جوية عابرة للقطب",
