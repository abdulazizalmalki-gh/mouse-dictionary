 "transistor": "تْرَانْزِسْتُور",
 "transistorised": "مُزوَّد بِترانْزِسْتورات ((عن الأجهزة الإلكترونية) مُجهَّز بترانزستورات)",
 "transistorized": "مُزوَّد بِترانْزِسْتورات ((عن الأجهزة الإلكترونية) مُجهَّز بترانزستورات)",
 "transit": "مُرُور / عُبُور",
 "transit declinometer": "مقياس الانحراف المغناطيسي (أداة لقياس الانحراف المغناطيسي)",
 "transit instrument": "أداة العبور (تلسكوب مثبت على محور يمتد شرقاً وغرباً ويستخدم لتوقيت عبور جرم سماوي عبر خط الزوال)",
 "transit line": "خط نقل عام (خط يوفر النقل العام)",
 "transit zone": "منطقة عبور (منطقة مساحتها ستة ملايين ميل مربع تشمل البحر الكاريبي وخليج المكسيك وشرق المحيط الهادئ؛ وتشمل الطرق الرئيسية التي يستخدمها مهربو المخدرات)",
 "transition": "تَحَوُّل, نَقِل (صَارَ غير ما كان)\nمثال: تحول ياني إلى وحش.",
 "transitional": "انتقالي (من أو يتعلق بالانتقال أو يتميز به)\nمثال: المراهقة هي مرحلة انتقالية بين الطفولة والبلوغ",
 "transitionally": "انتقالياً (كخطوة انتقالية أو بطريقة انتقالية)",
 "transitive": "مُتَعَدٍّ",
 "transitive verb": "فِعْل مُتَعَدٍّ (عَمِلَ وصَنَعَ، بعلم أو بدون علم، عن قصد أو دون قصد)\nمثال: ماذا فعل للحمي؟",
 "transitive verb form": "فعل متعد (فعل (أو بناء فعلي) يتطلب مفعولاً به ليكون صحيحاً نحوياً)",
 "transitively": "بشكل متعد, متعدياً (بطريقة متعدية (نحوياً))\nمثال: يمكنك استخدام الفعل (أكل) متعدياً أو لازماً",
 "transitiveness": "تَعَدٍّ (العلاقة النحوية التي ينشئها الفعل المتعدي)",
 "transitivity": "تَعَدٍّ (العلاقة النحوية التي ينشئها الفعل المتعدي) / تَعَدٍّ ((المنطق والرياضيات) علاقة بين ثلاثة عناصر بحيث إذا كانت قائمة بين الأول والثاني وبين الثاني والثالث، فإنها بالضرورة تكون قائمة بين الأول والثالث)",
 "transitorily": "زوالاً, لفترة وجيزة (لفترة قصيرة جداً)",
 "transitoriness": "زوال, عبرية (عدم ديمومة يوحي بحتمية النهاية أو الموت)",
 "transitory": "سَرِيع الزَّوَال, عَابِر (لا يدوم إلّا وقتًا قصيرًا جدًّا)",
 "translatable": "قَابِل لِلتَّحَوُّل, قَابِل لِلتَّحْوِيل (يمكن تغيير جوهره أو طبيعته كما لو بالخيمياء) / قابل للترجمة (قادر على التحول إلى شكل أو أسلوب أو لغة أخرى)\nمثال: مواد قابلة للترجمة بسهولة إلى المائدة المنزلية الأمريكية",
