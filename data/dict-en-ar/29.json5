 "ulmus parvifolia": "دردار صيني (شجرة صغيرة سريعة النمو موطنها آسيا؛ تزرع على نطاق واسع كمصدات رياح وتحوطات)",
 "ulmus procera": "دردار إنجليزي (دردار عريض الانتشار خشن الأوراق شائع في جميع أنحاء أوروبا ويزرع في أماكن أخرى)",
 "ulmus pumila": "دردار سيبيري (شجرة آسيوية شجيرية سريعة النمو توطنت في الولايات المتحدة للمأوى أو الزينة)",
 "ulmus rubra": "دردار أحمر, دردار لزج (دردار من أمريكا الشمالية له أوراق خشنة تكون حمراء عند تفتحها؛ ينتج خشباً صلباً)",
 "ulmus sarniensis": "دردار جيرسي (صنف من الدردار الإنجليزي بفروع قائمة وأوراق أعرض)",
 "ulmus serotina": "دردار أحمر, دردار سبتمبر (دردار خريفي الإزهار من جنوب شرق الولايات المتحدة)",
 "ulmus thomasii": "دردار صخري (دردار طويل واسع التوزيع في شرق أمريكا الشمالية)",
 "ulna": "زِنْد (زَنَّدَ: أوْرَى زَنْدُه؛ زَنَّدَ كذَبَ)",
 "ulnar": "زندي (متعلق بعظم الزند أو بالقرب منه)",
 "ulnar artery": "شريان زندي (شريان كبير يتفرع من الشريان العضدي لتغذية عضلات الساعد والرسغ واليد)",
 "ulnar nerve": "عصب زندي (عصب يمتد على طول الجانب الداخلي للذراع ويمر بالقرب من الكوع؛ يغذي العضلات الداخلية لليد والجلد على الجانب الإنسي لليد)",
 "ulnar vein": "وريد زندي (أي من عدة أوردة في الساعد)",
 "ulsan": "أُولْسَان",
 "ulster": "معطف ألستر (معطف طويل فضفاض من قماش ثقيل؛ عادة ما يكون بحزام)",
 "ult": "مِنَ الشَّهْرِ المَاضِي (فِي الشَّهْرِ السَّابِقِ لِلشَّهْرِ الحَالِيّ)",
 "ulterior": "تَالٍ, لَاحِق (يأتي في وقت أو مرحلة لاحقة) / بَعِيد, خَفِيّ (يتجاوز نطاق الاهتمام المباشر أو يقع خارجه) / خَفِيّ, مُبَطَّن (يَكْمُنُ وَرَاءَ مَا يُعْلَنُ أَوْ يُكْشَفُ عَنْهُ ظَاهِرِيًّا)",
 "ulteriority": "إضمار, خفاء (صفة كون الشيء خفياً أو غير معلن)\nمثال: كانت محادثتهم تقتصر على النوايا الخفية",
 "ulteriorly": "في المستقبل, لاحقاً (في وقت لاحق أو بطريقة خفية)",
 "ultima": "المقطع الأخير (المقطع الأخير في الكلمة)",
 "ultimacy": "قصوى, نهائية (حالة أو درجة كون الشيء نهائياً؛ الأخير أو الأكثر تطرفاً في الدرجة أو الحجم أو الوقت أو المسافة)\nمثال: نهائية هذه القيم الاجتماعية",
 "ultimate": "قُصْوَى, نِهَائِيّ (يَكُونُ العُنْصُرَ الأَخِيرَ أَوِ الخِتَامِيَّ فِي سِلْسِلَةٍ) / أقصى, مطلق (الأبعد أو الأعلى في الدرجة أو الترتيب؛ الأقصى أو المتطرف) / قمة, منتهى (الجودة الأرقى أو الأكثر تفوقاً من نوعها)\nمثال: الإنجاز النهائي",
 "ultimate frisbee": "ألتيميت فريسبي (لعبة بين فريقين يحاول لاعبوهما رمي الطبق الطائر (الفريسبي) لبعضهم البعض حتى يعبروا مرمى الخصم)",
 "ultimately": "أخيراً, في الختام (كنتيجة نهائية لتتابع أو عملية)\nمثال: في النهاية كان عليه الاستسلام",
 "ultimateness": "قصوى, نهائية (حالة أو درجة كون الشيء نهائياً؛ الأخير أو الأكثر تطرفاً في الدرجة أو الحجم أو الوقت أو المسافة)\nمثال: نهائية هذه القيم الاجتماعية",
 "ultimatum": "بِلَاغ نِهَائِيّ",
 "ultimo": "مِنَ الشَّهْرِ المَاضِي (فِي الشَّهْرِ السَّابِقِ لِلشَّهْرِ الحَالِيّ)",
 "ultra": "رَادِيكَالِيّ, مُتَطَرِّف ((لِلآرَاءِ وَالأَفْعَال) بَعِيدٌ جِدًّا عَنِ المِعْيَارِ المَقْبُول)",
 "ultra vires": "تجاوزاً للسلطة, خارج الصلاحيات (خارج نطاق أو تجاوزاً للسلطة القانونية أو الصلاحية) / تجاوز للسلطة, خارج الصلاحيات (خارج القوة القانونية أو السلطة لشخص أو مسؤول أو هيئة، إلخ)\nمثال: عقد باطل لتجاوز الصلاحيات",
 "ultra-lightweight concrete": "خرسانة خلوية, خرسانة رغوية (نوع من الخرسانة المهواة مع إضافة عامل تهوية (أو ركام خفيف الوزن مثل ركام الطين الممدد أو حبيبات الفلين والفيرميكوليت))\nمثال: لا تخلط بين الخرسانة الخلوية والخرسانة المهواة المعالجة بالأوتوكلاف، والتي يتم تصنيعها خارج الموقع باستخدام طريقة مختلفة تماماً",
 "ultracef": "ألتراسيف, سيفادروكسيل (مضاد حيوي من السيفالوسبورين (الاسم التجاري ألتراسيف))",
 "ultracentrifugation": "طرد مركزي فائق (طرد مركزي بسرعات عالية جداً)",
 "ultracentrifuge": "جهاز طرد مركزي فائق (جهاز طرد مركزي عالي السرعة يستخدم لتحديد الكتل الجزيئية النسبية للجزيئات الكبيرة في البوليمرات العالية والبروتينات)",
 "ultraconservative": "بَالِغُ المُحَافَظَةِ, مُتَطَرِّفٌ فِي المُحَافَظَةِ (مُحَافِظٌ إِلَى أَقْصَى حَدٍّ) / رجعي, يميني متطرف (محافظ متطرف؛ معارض للتقدم أو الليبرالية)",
 "ultrahigh frequency": "تَرَدُّد فَائِق العُلُوّ (300 إلى 3000 ميجاهرتز)",
 "ultraism": "الألترايسمو, ما بعد الحداثة الإسبانية (حركة في الشعر الإسباني والأمريكي الإسباني بعد الحرب العالمية الأولى، تميزت بالميل لاستخدام الشعر الحر، والابتكارات الموزونة المعقدة، والصور الجريئة…)\nمثال: أعلن خورخي لويس بورخيس أن 'الجمالية الأحدث'، الألترايسمو، هي البديل الشعري لـ 'الروبينية والقصصية السائدة'",
 "ultramarine": "أَزْرَق لَازَوَرْدِيّ (بلون أزرق صافٍ زاهٍ إلى أزرق أرجواني) / أزرق فاقع, أزرق ما وراء البحار (لون أزرق زاهٍ إلى أزرق أرجواني) / ألترامارين, لازوردي (خضاب أزرق مصنوع من اللازورد المسحوق)",
 "ultramarine blue": "ألترامارين, لازوردي (خضاب أزرق مصنوع من اللازورد المسحوق)",
 "ultramicroscope": "مجهر فوقي",
 "ultramicroscopic": "مجهري فائق (صغير جداً بحيث لا يمكن رؤيته بدون مجهر فائق)",
 "ultramodern": "فَائِقُ الحَدَاثَة (حَدِيثٌ لِأَقْصَى دَرَجَة)",
 "ultramodernity": "حداثة فائقة (خاصية كونه حديثاً للغاية)\nمثال: أعرب فاحص دولة إيطالي، صُدم بطبعتي لكافالكانتي، عن إعجابه بالحداثة الفائقة للغة غيدو تقريباً",
 "ultramontane": "جَنُوب جِبَال الأَلْب (واقع في الجانب الإيطاليّ أو الجنوبيّ من جبال الألب) / عَبْر جِبَال الأَلْب (واقع على الجانب الآخر من جبال الألب؛ شمال الألب بالنسبة لإيطاليا) / ما وراء الجبال (من أو متعلق بمذهب ما وراء الجبال (سلطة البابا المطلقة)) / ألترامونتاني, مؤيد للسلطة البابوية المطلقة (كاثوليكي روماني يدافع عن الألترامونتانية (السلطة البابوية العليا في مسائل العقيدة والتأديب))",
 "ultramontanism": "ألترامونتانية, الولاء البابوي المطلق ((الكنيسة الكاثوليكية) السياسة القائلة بأن السلطة المطلقة للكنيسة يجب أن تكون مخولة للبابا)",
 "ultranationalism": "تَعَصُّب وَطَنِيّ, شُوفِينِيَّة (وطنية متعصبة)",
 "ultranationalistic": "شُوفِينِيّ, مُتَعَصِّبٌ وَطَنِيًّا (مُتَعَصِّبٌ لِلْوَطَنِيَّةِ تَعَصُّبًا مُفْرِطًا)",
 "ultrasonic": "فَوْق سَمْعِيّ, فَوْق صَوْتِيّ (ذو ترددات أعلى من الصوت المسموع)",
 "ultrasonic flaw detector": "كاشف عيوب بالموجات فوق الصوتية (جهاز يستخدم للكشف عن الشقوق والفراغات والمسامية وغيرها من المخالفات الداخلية المخفية في المعادن والمركبات والبلاستيك والسيراميك)",
 "ultrasonic pulse analyzer": "جهاز فحص سرعة النبضات فوق الصوتية (معدات قياس تستخدم لاختبار قوة الخرسانة)",
 "ultrasonic pulse velocity tester": "جهاز فحص سرعة النبضات فوق الصوتية (معدات قياس تستخدم لاختبار قوة الخرسانة)",
 "ultrasonically": "بالموجات فوق الصوتية (بواسطة وسائل الموجات فوق الصوتية)\nمثال: أُزيلت حصى الكلى بالموجات فوق الصوتية",
 "ultrasonography": "تصوير بالموجات فوق الصوتية, سونار (استخدام انعكاسات الموجات الصوتية عالية التردد لبناء صورة لعضو من أعضاء الجسم؛ يُستخدم عادة لمراقبة نمو الجنين أو دراسة أعضاء الجسم)",
 "ultrasound": "الْمَوْجَات فَوْقَ الصَّوْتِيَّة",
 "ultrasound scanner": "جهاز سونار, ماسح بالموجات فوق الصوتية (جهاز يستخدم لفحص البنية الداخلية للجسم باستخدام الموجات فوق الصوتية، خاصة لتشخيص التشوهات في الجنين)",
 "ultrasuede": "ألترا سويد (قماش شمواه صناعي)",
 "ultraviolet": "فَوْقَ البَنَفْسَجِيّ (ذُو أَطْوَالٍ مَوْجِيَّةٍ أَقْصَرَ مِنَ الضَّوْءِ المَرْئِيِّ وَأَطْوَلَ مِنَ الأَشِعَّةِ السِّينِيَّة) / أشعة فوق بنفسجية (إشعاع يقع في النطاق فوق البنفسجي؛ أطوال موجية أقصر من الضوء ولكن أطول من الأشعة السينية)",
 "ultraviolet illumination": "أشعة فوق بنفسجية (إشعاع يقع في النطاق فوق البنفسجي؛ أطوال موجية أقصر من الضوء ولكن أطول من الأشعة السينية)",
 "ultraviolet lamp": "مصباح أشعة فوق بنفسجية (أي مصدر إضاءة ينبعث منه إشعاع فوق بنفسجي)",
 "ultraviolet light": "أشعة فوق بنفسجية (إشعاع يقع في النطاق فوق البنفسجي؛ أطوال موجية أقصر من الضوء ولكن أطول من الأشعة السينية)",
 "ultraviolet radiation": "أشعة فوق بنفسجية (إشعاع يقع في النطاق فوق البنفسجي؛ أطوال موجية أقصر من الضوء ولكن أطول من الأشعة السينية)",
 "ultraviolet source": "مصباح أشعة فوق بنفسجية (أي مصدر إضاءة ينبعث منه إشعاع فوق بنفسجي)",
 "ultraviolet spectrum": "طيف الأشعة فوق البنفسجية (طيف الإشعاع فوق البنفسجي)",
 "ululation": "زَغْرَدَة, هَلْهُولَة",
 "uluru": "أُولُورُو",
 "ulyanovsk": "أُولْيَانُوفْسْك",
 "uma notata": "سحلية هدبية الأصابع (ذات حراشف طويلة مدببة حول أصابع القدم؛ من صحاري الولايات المتحدة والمكسيك)",
 "umami": "أُومَامِي",
 "uman": "أومان",
 "umayya": "أُمَيَّة",
 "umayyad": "أُمَوِيّ",
 "umbel": "خيمة, نورة خيمية (نورة مسطحة القمة أو مستديرة تميز الفصيلة الخيمية حيث تنشأ سيقان الزهور الفردية من نفس النقطة تقريبًا؛ الزهور الأصغر سنًا تكون في المركز)",
 "umbel-like": "خَيْمِيّ, شِبْهُ خَيْمَةٍ (يُشْبِهُ الخَيْمَةَ النَّبَاتِيَّةَ فِي شَكْلِهِ)",
 "umbellar": "خيمي (يحمل أو يتكون من أو يشبه الخيمات (نورات زهرية))",
 "umbellate": "خَيْمِيّ, شِبْهُ خَيْمَةٍ (يُشْبِهُ الخَيْمَةَ النَّبَاتِيَّةَ فِي شَكْلِهِ) / خيمي (يحمل أو يتكون من أو يشبه الخيمات (نورات زهرية))",
 "umbellifer": "خيميات, نبات خيمي",
 "umbelliferous": "خيمي (متعلق بالنباتات من الفصيلة الخيمية)",
 "umbelliferous plant": "خيميات, نبات خيمي",
 "umbelliform": "خيمي الشكل (يشبه الخيمة أو النورة الخيمية)",
 "umbellularia californica": "آس أوريغون, غار كاليفورنيا (شجرة ساحل المحيط الهادئ ذات أوراق عطرية وزهور خيمية صغيرة تليها ثمار تشبه الزيتون؛ تنتج خشباً صلباً متيناً)",
 "umber": "أُمْبِرِيّ اللَّوْن (بلون أصباغ الأرض البنية الطبيعية) / بني قهوة, بني محروق (لون بني متوسط إلى بني داكن) / أمبر (صبغة ترابية بنية)",
 "umbilical": "سُرِّيّ",
 "umbilical cord": "حَبْل سُرِّيّ ((حَبَلَه): شَدّه بالحبْل؛ (حَبَلَه) الصَّيْدَ: نَصَب لَهُ الحِبَالةَ وصاده بهَا. وَيُقَال: حَبَلَت فُلَانَةُ فلَانًا: أوقعَتْه فِي شِباك حُبّها وسحَرته)\nمثال: حبل الكذب قصير.",
 "umbilical hernia": "فتق سري (بروز الأمعاء والثروب عبر فتق في جدار البطن بالقرب من السرة)",
 "umbilical vein": "وريد سري (وريد في الحبل السري؛ يعيد الدم المغذي من المشيمة إلى الجنين)",
 "umbilical vesicle": "حويصلة سرية, كيس المح (بنية غشائية تعمل كجهاز دوري في أجنة الثدييات حتى يصبح القلب وظيفياً)",
 "umbilicate": "ذُو تَجْوِيفٍ سُرِّيّ, سُرِّيّ (ذو تجويف يشبه السُّرّة)",
 "umbilicus": "سُرة, سُرة البطن (ندبة حيث كان الحبل السري متصلاً)\nمثال: لم يكن من المفترض أن تظهر سرتك على التلفزيون",
 "umbo": "سُرّة الطبلة (ارتفاع دائري طفيف حيث تلتصق المطرقة بطبلة الأذن)",
 "umbra": "منطقة الظل التام (منطقة من الظل الكامل ناتجة عن الانسداد الكلي للضوء)",
 "umbrage": "إهانة, استياء (شعور بالغضب ناتج عن التعرض للإهانة)\nمثال: لقد شعر بالاستياء من سؤالي",
 "umbrageous": "مُتَسَخِّط, مُسْتَنْكِر (غاضب بسبب ظلم أو خطأ؛ ساخط لأمر غير عادل) / ظَلِيل, وَارِف الظِّلّ (مَمْلُوء بِالظِّلّ)",
 "umbrella": "مِظَلَّة, شَمْسِيَّة / وَاقٍ, الْوَاقِي",
 "umbrella arum": "لسان الشيطان, نخيل الثعبان (نبات استوائي لحمي نوعاً ما كريه الرائحة من جنوب شرق آسيا يزرع لكورماته الصالحة للأكل أو في البيوت الزجاجية لأوراقه الكبيرة وقنابته الحمراء الداكنة…)",
 "umbrella bird": "طائر المظلة (طائر أمريكي استوائي أسود له عرف كبير متدلٍ ودلاية طويلة مغطاة بالريش)",
 "umbrella fern": "سرخس المروحة, سرخس المظلة (سرخس أسترالاسي كبير بسعف متشعب بشكل متكرر يشبه المروحة؛ يوضع أحياناً في جنس جليشينيا)",
 "umbrella magnolia": "شجرة المظلة, ماغنوليا ثلاثية البتلات (شجرة صغيرة متساقطة الأوراق في شرق أمريكا الشمالية ذات زهور بيضاء كريمية وأوراق كبيرة في تشكيلات تشبه المظلات عند أطراف الفروع)",
 "umbrella pine": "صنوبر المظلة, صنوبر ثمري (صنوبر ثنائي الإبر متوسط الحجم من جنوب أوروبا له تاج منتشر؛ يزرع على نطاق واسع لبذوره الحلوة التي تشبه اللوز)",
 "umbrella plant": "سعد المظلة, نبات المظلة (سعد أفريقي يُزرع على نطاق واسع كنبات مائي للزينة لعناقيده الطرفية التي تشبه المظلة من أوراق رفيعة تشبه العشب) / نبات المظلة (نبات معمر متأخر الإزهار ينمو في الأراضي الصخرية بفرجينيا وله زهور في عناقيد مسطحة القمة) / راوند هندي, نبات المظلة (عشب معمر جذموري بأوراق درعية درامية كبيرة وأزهار بيضاء إلى وردية زاهية في رؤوس مستديرة على سيقان خالية من الأوراق؛ يستعمر ضفاف الأنهار في سييرا…)",
 "umbrella sedge": "سعد المظلة, نبات المظلة (سعد أفريقي يُزرع على نطاق واسع كنبات مائي للزينة لعناقيده الطرفية التي تشبه المظلة من أوراق رفيعة تشبه العشب)",
 "umbrella tent": "خيمة مظلة (خيمة صغيرة بعمود داعم واحد وأضلاع معدنية مشعة)",
 "umbrella tree": "شجرة المظلة, ماغنوليا ثلاثية البتلات (شجرة صغيرة متساقطة الأوراق في شرق أمريكا الشمالية ذات زهور بيضاء كريمية وأوراق كبيرة في تشكيلات تشبه المظلات عند أطراف الفروع) / شجرة المظلة, شفليرا (شجيرة دائمة الخضرة منتصبة أو شجرة صغيرة من أستراليا وشمال غينيا الجديدة ذات أوراق مركبة كفية)",
 "umbrella-shaped": "مِظَلِّيّ الشَّكْل (على شكل مِظلّة)",
 "umbrellalike": "مِظَلِّيُّ الشَّكْلِ (يشبه المظلّة في شكله)",
 "umbrellawort": "شب الليل, عشبة المظلة",
 "umbrian": "اللغة الأومبرية (لغة إيطاليقية منقرضة من جنوب إيطاليا القديمة، تحدث بها الأومبريون)",
 "umbrian language": "اللغة الأومبرية (لغة إيطاليقية منقرضة من جنوب إيطاليا القديمة، تحدث بها الأومبريون)",
 "umbrina roncador": "كرواكر أصفر الزعانف (سمكة من ساحل المحيط الهادئ لأمريكا الشمالية)",
 "umbundu": "أمبوندو (لغة بانتو يتم التحدث بها في أنغولا)",
 "umbundu language": "أمبوندو (لغة بانتو يتم التحدث بها في أنغولا)",
 "umlaut": "مُغَيِّرَة",
 "umm al-quwain": "أُمّ ٱلقَيْوَيْن (الوَالِدَة أو الجَدَّة، وقد يطلق على والدة الزوج مجازا؛ أمّ بالرضاعة: المرأة التي أرضعت الطِفْل صغيرا فتصبح كوالدته)\nمثال: هل ستأتي أم لا؟",
 "umma": "الأمة, الأمة الإسلامية (المجتمع أو الشعب المسلم، الذي يمتد من موريتانيا إلى باكستان)\nمثال: يحث المسلمون المعتدلون الأمة على رفض إرهاب المتطرفين",
 "umma tameer-e-nau": "أمة تعمير ناو (منظمة غير حكومية من العلماء الباكستانيين كانت داعمة للإرهاب؛ قدمت معلومات حول الحرب الكيميائية والبيولوجية والنووية لأسامة بن لادن والقاعدة وطالبان)",
 "ummah": "أُمَّة (المرأة المملوكة، خلاف الحرة)\nمثال: الأمة تطلب العدالة الاجتماعية.",
 "ump": "حكم (حكم في مباراة بيسبول)",
 "umpirage": "تحكيم (فعل التحكيم (في الرياضة)) / تحكيم رياضي (وساطة يقوم بها حكم رياضي (أو حكم بشكل عام))\nمثال: كان التحكيم ممتازاً",
 "umpire": "حكم (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ)\nمثال: حكم علي بالموت.",
 "umpteen": "لَا يُحْصَى, لَا يُعَدّ (كثير جدًّا بحيث لا يمكن عدّه أو حصره)",
 "umpteenth": "لَا يُعَدّ (الأَخِير فِي سِلْسِلَة غَيْر مُحَدَّدَة العَدَد)",
 "umptieth": "لَا يُعَدّ (الأَخِير فِي سِلْسِلَة غَيْر مُحَدَّدَة العَدَد)",
 "umrah": "عُمْرَة",
 "umteen": "لَا يُحْصَى, لَا يُعَدّ (كثير جدًّا بحيث لا يمكن عدّه أو حصره)",
 "umteenth": "لَا يُعَدّ (الأَخِير فِي سِلْسِلَة غَيْر مُحَدَّدَة العَدَد)",
 "un": "الأمم المتحدة (منظمة للدول المستقلة تشكلت عام 1945 لتعزيز السلام والأمن الدوليين)",
 "un agency": "وكالة تابعة للأمم المتحدة (وكالة من وكالات الأمم المتحدة)",
 "un security council": "مَجْلِس الْأَمْن الْأُمَم الْمُتَّحِدَة",
 "un-american": "مُعَادٍ لِلْقِيَمِ الأَمْرِيكِيَّة (يُعْتَبَرُ مُنَاقِضًا لِمَصَالِحِ الوِلَايَاتِ المُتَّحِدَة)",
 "un-come-at-able": "عَسِير المَنَال (صعب الوصول إليه أو بلوغه)",
 "un-get-at-able": "عَسِير المَنَال (صعب الوصول إليه أو بلوغه)",
 "unabashed": "غَيْر مُحْرَج, غَيْر مُرْتَبِك (لا يشعر بالحرج أو الارتباك)",
 "unabashedly": "بجرأة, دون خجل (بطريقة لا تشوبها الخجل أو الارتباك)\nمثال: طلب المزيد دون خجل",
 "unabated": "لَا يَنْقَطِع, مُسْتَمِرُّ الشِّدَّة (مُسْتَمِرٌّ بِكَامِلِ قُوَّتِهِ وَشِدَّتِه)",
 "unable": "عَاجِز",
 "unabridged": "غَيْر مُخْتَصَر, كَامِل ((يستخدم للنصوص) غير مُقصّر أو مُختصر) / قاموس شامل, قاموس غير موجز (قاموس لم يتم تقصيره بحذف المصطلحات أو التعريفات؛ قاموس شامل)\nمثال: رواية كاملة",
 "unabridged dictionary": "قاموس شامل, قاموس غير موجز (قاموس لم يتم تقصيره بحذف المصطلحات أو التعريفات؛ قاموس شامل)",
 "unabused": "غَيْر مُسَاء مُعَامَلَتُه (لم يتعرض للإيذاء الجسدي؛ عومل بشكل لائق)",
 "unaccented": "خَفِيف, غَيْر مَنْبُور ((للحروف المتحركة أو المقاطع) يُنطَق بنبر ضعيف أو بلا نبر) / غير منبور, لا نغمي ((للمقاطع) لا تحمل أي نبرة)\nمثال: المقطع اللانغمي لا يحمل أي نبرة",
 "unacceptability": "عَدَم قَبُول (عدم الإرضاء بحكم عدم المطابقة للمعايير المعتمدة)",
 "unacceptable": "غَيْر مَقْبُول, مَرْفُوض (غير مقبول؛ غير مرحب به) / غَيْرُ مَقْبُول (لا يكفي لتحقيق الرضا) / غَيْر مَقْبُول, مَرْفُوض (لا يتوافق مع الاستخدام اللغوي المعياري) / غَيْرُ مَقْبُول, مُسْتَحِيل ((يوصف به الأشخاص أو سلوكهم) غير مقبول أو معقول)\nمثال: كلمة غير مقبولة في المجتمع المهذب",
 "unacceptableness": "عَدَم قَبُول (عدم الإرضاء بحكم عدم المطابقة للمعايير المعتمدة)",
 "unacceptably": "بشكل غير مقبول, بشكل لا يطاق (لدرجة غير مقبولة)\nمثال: نسبة الرصاص في مياه الشرب لدينا مرتفعة بشكل غير مقبول",
 "unaccepted": "غَيْر مَقْبُول, مَرْفُوض (لا يتوافق مع الاستخدام اللغوي المعياري)",
 "unaccessible": "صَعْب المَنَال, يَتَعَذَّر الوُصُول إِلَيْه (لا يمكن الوصول إليه إلا بصعوبة كبيرة أو لا يمكن الوصول إليه إطلاقاً)",
 "unaccommodating": "غَيْر مُتَعَاوِن (غير متعاون أو غير مجامل) / جَامِد, غَيْر مُتَعَاوِن (لا يُقدِّم أيَّ مساعدة أو تسهيل)\nمثال: تحرك سائق الحافلة غير المتعاون بينما كانت تطرق على الباب",
 "unaccompanied": "منفرداً, وحده (دون أي شخص أو شيء آخر) / بِدُون, غَيْر مَصْحُوب ((عن حالة أو حدث) يحدث دون شيء محدّد مصاحب له) / غير مصحوب, وحيد (بدون مرافقة) / غير مصحوب (بموسيقى) (عزف أو غناء بدون مصاحبة)\nمثال: بقي الطفل في المنزل وحده",
 "unaccountable": "غَيْر مُفَسَّر, لَا يُعَلَّل (لا يمكن تعليله أو تفسيره) / غَيْرُ خَاضِعٍ لِلْمُسَاءَلَة (حُرّ من الرقابة أو المسؤولية)",
 "unaccountably": "بشكل لا يفسر, لسبب غير مفهوم (بطريقة غير قابلة للتفسير)\nمثال: في الكتاب، يصبح أحد الأثرياء صديقاً للبطل لسبب غير مفهوم",
 "unaccredited": "غَيْر مُرَخَّص, غَيْر مُعْتَمَد (يفتقر إلى الموافقة الرسمية)",
 "unaccustomed": "غَيْرُ مُعْتَاد, مُسْتَغْرَب (غير مألوف أو غير معتاد عليه)",
 "unaccustomed to": "غَيْر مُعْتَاد عَلى (غير متعود على؛ غير مألوف لديه)\nمثال: غير معتاد على ارتداء البدلات",
 "unachievable": "بَعِيد المَنَال, مُسْتَحِيل التَّحْقِيق (يستحيل تحقيقه أو بلوغه)",
 "unachievably": "بشكل بعيد المنال (بطريقة لا يمكن بلوغها أو إلى درجة لا يمكن الوصول إليها)\nمثال: هذا المنزل باهظ الثمن بشكل بعيد المنال",
 "unacknowledged": "غَيْر مُعْتَرَف بِه (غير معترف به أو غير مُقر به) / غَيْرُ مُعْتَرَفٍ بِهِ (لم يُعتَرَف به علانيةً)",
 "unacquisitive": "زَاهِد, غَيْر مُحِبّ لِلاِقْتِنَاء (ليس لديه حب الاقتناء؛ غير مهتم باكتساب أو امتلاك أي شيء)",
 "unactable": "غير قابل للتمثيل (لا يمكن تمثيله)\nمثال: مسرحية غير قابلة للتمثيل",
 "unadaptability": "عَدَم القَابِلِيَّة لِلتَّكَيُّف (العجز عن التغيير أو التغيُّر لملائمة الظروف المتغيرة)",
 "unadaptable": "غير قابل للتكيف (غير قادر على التكيف)",
 "unadapted": "غَيْر مُتَكَيِّف (لم يتأقلم مع الظروف الجديدة) / غَيْرُ مُكَيَّف (لَمْ يُغَيَّرْ شَكْلُهُ أَوْ طَبِيعَتُهُ لِغَرَضٍ مُعَيَّن)",
 "unaddicted": "غَيْر مُدْمِن (غير مدمن)",
 "unaddressed": "غَيْر مُعَنْوَن (غير معنون)\nمثال: ظرف غير معنون",
 "unadjustable": "غَيْر قَابِل لِلتَّعْدِيل (لَا يُمْكِن ضَبْطُه أَوْ تَعْدِيلُه)",
 "unadjusted": "غَيْر مَضْبُوط, غَيْر مُعَدَّل (لم يتم تغييره ليتناسب مع متطلبات معينة) / غَيْر مُتَكَيِّف (لم يتأقلم مع الظروف الجديدة)\nمثال: رقم غير معدل بنسبة 8.5 في المائة",
 "unadoptable": "غَيْر قَابِل لِلتَّبَنِّي (من الصعب وضعه في منزل بالتبني)",
 "unadorned": "بَسِيط, غَيْر مُزَيَّن (غير مزين بشيء لزيادة جماله أو تميزه)",
 "unadulterated": "تَامّ, خَالِص (بِلَا تَحَفُّظ؛ يُسْتَخْدَمُ بِشَكْلٍ غَيْرِ رَسْمِيٍّ كَأَدَاةِ تَوْكِيدٍ (غَالِبًا ذَمِّيَّة)) / غَيْرُ مَغْشُوش (لم يُخْلَط بشوائب أو مواد دخيلة)",
 "unadventurous": "تَقْلِيدِيّ, غَيْر مُغَامِر (يفتقر إلى الجرأة)",
 "unadvisable": "غَيْر مَنْصُوح بِه, غَيْر مُسْتَحْسَن (ليس حكيماً أو عاقلاً؛ غير موصى به)\nمثال: الجري على الجليد غير مستحسن",
 "unadvised": "غَيْر سَدِيد, غَيْر مَدْرُوس (بدون تداول مسبق متأنٍ أو مشورة) / غَيْرُ مُبَلَّغ (لم يتلقَّ أي معلومات أو إخطار)\nمثال: جهود غير مدروسة",
 "unadvisedly": "بتهور, دون تروٍ (بطريقة تفتقر إلى النصح أو الحكمة)",
 "unaerated": "غَيْرُ مُؤَكْسَج ((يُستخدم عن الدم) غَيْرُ مُزَوَّدٍ بِالأُكْسِجِين)",
 "unaesthetic": "غَيْر جَمَالِيّ, قَبِيح (ينتهك القوانين أو المتطلبات الجمالية؛ يفتقر إلى الذوق أو الجمال)\nمثال: غير جمالي وغير فكري تماماً",
 "unaffected": "غَيْر مُتَأَثِّر (لا يخضع لأي تغيير عند التأثير عليه) / طَبِيعِيّ, عَفْوِيّ (خالٍ من التصنع؛ صادق وحقيقي) / جامد المشاعر, غير مبال (غير منفعل عاطفياً)\nمثال: غير متأثر تماماً بكتابات بعضهم البعض",
 "unaffectedness": "بَسَاطَة, عَدَم تَكَلُّف (غير متكلف؛ أسلوب شخصي غير مقيد بوعي)",
 "unaffecting": "غَيْر مُثِير لِلْمَشَاعِر (لا يثير المشاعر أو العواطف)",
 "unaffectionate": "بَارِدُ المَشَاعِر, مُتَجَرِّد (يفتقر إلى العاطفة أو الدفء الوجداني)",
 "unaffiliated": "غَيْرُ مُنْتَسِب (لَيْسَ لَدَيْهِ انْتِسَابٌ أَوِ ارْتِبَاطٌ بِجِهَةٍ مَا)",
 "unaffixed": "سَائِب, غَيْر مُلْصَق (غير مثبت)\nمثال: أصبح الطابع سائباً",
 "unafraid": "آمن, مرتاح البال (خالٍ من الخوف أو الشك؛ مرتاح البال)\nمثال: كان مطمئناً بأنه لن يُحاسب على أي شيء",
 "unaged": "غَيْرُ مُعَتَّق (لم يخضع لعملية تعتيق)",
 "unaggressive": "غَيْر عُدْوَانِيّ, مُسَالِم (ليس عدوانياً؛ لا يميل إلى القتال أو تأكيد الذات)",
 "unagitated": "غَيْر مُضْطَرِب, هَادِئ (ليس مضطرباً أو منزعجاً عاطفياً) / سَاكِن, غَيْر مُهْتَاج (غير مضطرب جسدياً أو لم يوضع في حالة حركة) / سَاكِن, هَادِئ (غير مضطرب؛ يحافظ على ضبط النفس)",
 "unai": "كسلان ثنائي الأصابع (كسلان صغير نسبياً وسريع الحركة يمتلك مخلبين طويلين في كل قدم أمامية) / كسلان هوفمان (كسلان من أمريكا الوسطى يمتلك مخلبين طويلين في كل قدم أمامية وثلاثة مخالب طويلة في كل قدم خلفية)",
 "unaided": "بِدُونِ مُسَاعَدَة (يُنجز بدون عون أو مساعدة)",
 "unaired": "خَانِق, كَتِيم (يَفْتَقِرُ إِلَى الهَوَاءِ النَّقِيّ)",
 "unairworthy": "غير صالح للطيران (غير مناسب للطيران)",
 "unalarming": "غَيْر مُقْلِق, مُطَمْئِن (غير مقلق؛ يخفف الانزعاج)",
 "unalert": "غَافِل, غَيْر يَقِظ (غير متنبه لما هو خطير محتمل)",
 "unalienable": "غَيْر قَابِل لِلتَّصَرُّف فِيه, غَيْر قَابِل لِلنَّقْل (غير قابل للتنصل منه أو نقله إلى شخص آخر)\nمثال: وهبهم خالقهم حقوقاً معينة غير قابلة للتصرف",
 "unalike": "غير متشابه, متباين (غير متشابه أو مماثل)\nمثال: مختلفان بقدر ما يمكن لشخصين أن يكونا",
 "unalloyed": "خَالِص, غَيْرُ مَشُوب (خالٍ من أيّ خلط أو مزج)",
 "unalterability": "ثَبَات, جُمُود (صفة كون الشيء ثابتاً وغير قابل للتغيير) / عَدَم قَابِلِيَّة لِلتَّعْدِيل (صفة عدم القابلية للتعديل)\nمثال: أزعجها ثبات نظراته",
 "unalterable": "دَائِم, لَا يَتَغَيَّر (يبقى على حاله لفترات طويلة غير محدّدة) / غَيْر قَابِل لِلتَّعْدِيل ((للحكم القضائيّ) لا يمكن تغييره) / غَيْر قَابِل لِلتَّغْيِير, لَا يَتَبَدَّل (غير قادر على أن يتغير أو يعدل)\nمثال: عزم لا يلين",
 "unalterably": "بشكل ثابت, بشكل غير قابل للتغيير (بطريقة غير قابلة للتغيير أو التبديل)\nمثال: كانت آراؤه ثابتة بشكل غير قابل للتغيير",
 "unaltered": "غَيْر مُغَيَّر (باقٍ في حالة أصلية)\nمثال: استمر غير متغير عبر الزمن",
 "unambiguity": "عَدَم لَبْس, وُضُوح قَاطِع (الوضوح المتحقق بتجنب الغموض)",
 "unambiguous": "غَيْر مُبْهَم (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "unambiguously": "بشكل فريد, بشكل لا لبس فيه (بحيث يكون فريداً) / بشكل لا لبس فيه, بوضوح تام (بطريقة واضحة تماماً)\nمثال: استطاع تحديد خصائص المركب بشكل فريد",
 "unambitious": "بِلَا طُمُوح, غَيْر طَمُوح (لديه رغبة قليلة في النجاح أو الإنجاز)",
 "unambitiously": "دُونَ طُمُوح (بطريقة غير طموحة)\nمثال: يقوم بعمله، لكنه يعمل دون طموح",
 "unamended": "غَيْر مُعَدَّل ((للتشريعات) غير معدل)",
 "unanalyzable": "غَيْر قَابِل لِلتَّحْلِيل (يُمثِّل أقصى حدّ ممكن من التحليل أو التقسيم)",
 "unanalyzed": "غَيْر مُحَلَّل (غير محلل أو مفكك للفحص التفصيلي)\nمثال: مركب غير محلل",
 "unanimated": "بِلَا حَيَوِيَّة, خَامِل (غير منشط أو مبهج؛ ممل)",
 "unanimity": "إجماع تام (أن يكون الجميع على رأي واحد)",
 "unanimous": "إِجْمَاعِيّ, بِالإِجْمَاعِ (فِي اتِّفَاقٍ تَامٍّ وَكَامِلٍ) / بِالإِجْمَاع, مُوَحَّد (يَعْمَل مَعًا كَكُتْلَة وَاحِدَة غَيْر مُتَنَوِّعَة)",
 "unanimously": "بالإجماع (برأي واحد؛ بدون معارضة)\nمثال: وافق مجلس الشيوخ بالإجماع على مشروع القانون",
 "unannealed": "غَيْرُ مُلَدَّن, هَشّ ((لِلْمَعْدَنِ أَوِ الزُّجَاج) لَمْ يُلَدَّنْ وَبِالتَّالِي سَهْلُ التَّشَقُّقِ أَوِ الكَسْر)",
 "unannounced": "بِلَا إِنْذَار, غَيْر مُعْلَن (بدون تحذير أو إعلان مُسبَق)",
 "unanswerable": "دَامِغ, لَا يُمْكِنُ الرَّدُّ عَلَيْه (يَسْتَحِيلُ الرَّدُّ عَلَيْهِ أَوْ دَحْضُهُ)",
 "unanswered": "بِلَا مُقَابِلٍ, غَيْرُ مَرْدُودٍ (لا يُرَدُّ بالمثل)",
 "unanticipated": "غَيْر مَنْظُور, غَيْر مُتَوَقَّع (لم يكن في الحسبان ولم يُتَرَقَّب)",
 "unapologetic": "غير معتذر, غير نادم (غير راغب في تقديم اعتذار أو التعبير عنه)\nمثال: مؤمن غير نادم",
 "unappareled": "خَالِع مَلَابِسَهُ, مُتَعَرٍّ (أزال عنه الملابس)",
 "unapparent": "غَيْر ظَاهِر (ليس واضحاً أو بديهياً على الفور)",
 "unappealable": "غَيْر قَابِل لِلاِسْتِئْنَاف (لا يخضع للاستئناف)\nمثال: صدر حكم القاضي في جلسة استماع أولية وليس في محاكمة، وبالتالي كان غير قابل للاستئناف",
 "unappealing": "غَيْر جَذَّاب, غَيْر مُغْرٍ (غير قادر على جذب الانتباه الإيجابي) / بغيض, غير محبوب ((للشخصيات في الأدب أو الدراما) تميل إلى إثارة مشاعر النفور)\nمثال: جعلوا المكان غير جذاب قدر الإمكان",
 "unappealingly": "بِشَكْل غَيْر جَذَّاب (بطريقة غير جذابة)\nمثال: كان المطبخ قذراً بشكل غير جذاب",
 "unappeasable": "صَارِم, لَا يَرْحَم (لا يمكن استرضاؤه أو ثَنيه بالتوسّل)",
 "unappendaged": "بِلَا زَوَائِد (ليس له زائدة)",
 "unappetising": "غَيْر مُشَهٍّ (غير فاتح للشهية في المظهر أو الرائحة أو المذاق)",
 "unappetisingness": "غير فاتح للشهية (خاصية إفساد الشهية)",
 "unappetizing": "غَيْر مُشَهٍّ (غير فاتح للشهية في المظهر أو الرائحة أو المذاق)",
 "unappetizingness": "غير فاتح للشهية (خاصية إفساد الشهية)",
 "unappreciated": "غَيْر مُقَدَّر, مَجْهُول القَدْر (له قيمة لا يُعتَرف بها) / غَيْرُ مُقَدَّر, نَاكِرٌ لِلْجَمِيل (من غير المرجّح أن يُكافَأ عليه)",
 "unappreciative": "جَاحِد, غَيْر مُقَدِّر (لا يشعر بالامتنان ولا يُعبِّر عنه)",
 "unappreciatively": "بِجُحُود, بِنُكْرَان جَمِيل (بطريقة ناكرة للجميل)",
 "unapprehensive": "غَيْر مُدْرِك لِلخَطَر (لا يدرك الخطر أو بطيء في التعرف عليه)",
 "unapproachability": "صعوبة المراس, منعة (الميل لكون المرء صعب المراس؛ غير ودود ولا يمكن الوصول إليه)",
 "unapproachable": "بَعِيد المَنَال, لَا يُمكِن الوُصُول إِلَيْه (يقع في مكان يتعذّر الوصول إليه) / صَعْب المِرَاس, مُتَحَفِّظ (لا يشجع على الألفة؛ متحفظ)\nمثال: مدير تنفيذي يصعب الوصول إليه (متحفظ)",
 "unarbitrary": "غير تعسفي, موضوعي (غير خاضع للتقدير الفردي البحت)",
 "unarguable": "غَيْرُ قَابِلٍ لِلنِّقَاش, لَا يُمْكِنُ دَحْضُهُ (لَا يُمْكِنُ تَقْدِيمُ حُجَّةٍ ضِدَّهُ)",
 "unarguably": "بشكل قاطع, بلا جدال (بطريقة لا تقبل الجدل أو النزاع)\nمثال: أنت تكتب كما لو أن هذه الحقيقة، وإن كانت تدينني بلا جدال بالانضمام إلى صفوف البوهيمية، إلا أنها أكسبتني حق الدخول إلى أي رفقة",
 "unargumentative": "غير مجادل, مسالم (لا يميل إلى أو يتميز بالجدل)",
 "unarmed": "أَعْزَل",
 "unarmored": "غَيْر مُدَرَّع ((يستخدم للأشخاص أو الأشياء العسكرية) بدون درع واقٍ) / رَخْو, غَيْر مُدَرَّع (يستخدم للحيوانات؛ بدون غطاء واقٍ)",
 "unarmoured": "غَيْر مُدَرَّع ((يستخدم للأشخاص أو الأشياء العسكرية) بدون درع واقٍ) / رَخْو, غَيْر مُدَرَّع (يستخدم للحيوانات؛ بدون غطاء واقٍ)",
 "unarticulate": "أَعْجَم, عَاجِز عَن التَّعْبِير (بدون أو محروم من استخدام الكلام أو الكلمات)\nمثال: بهائم عجماء",
 "unarticulated": "غَيْر مَنْطُوق, غَيْر مُفَصَّل (صادر دون استخدام كلمات أو مقاطع طبيعيّة) / غَيْر مَفْصِلِيّ (لا يتكون من أجزاء متماسكة بواسطة مفاصل)",
 "unartistic": "عَدِيم الذَّوْق الفَنِّيّ (يفتقر إلى الحس الجمالي)",
 "unary": "أُحَادِيّ (يتكوّن من عنصر أو مكوّن واحد أو ينطوي عليه) / نظام العد الأحادي (مَنْهَج، طَرِيقَة؛ تَرْتِيب واتِّسَاق)\nمثال: ليس بنظام كامل.",
 "unary numeral system": "نظام العد الأحادي (مَنْهَج، طَرِيقَة؛ تَرْتِيب واتِّسَاق)\nمثال: ليس بنظام كامل.",
 "unary operation": "عملية أحادية (عملية ذات معامل واحد بالضبط)",
 "unascertainable": "غَيْرُ قَابِلٍ لِلتَّحَقُّق (لَا يُمْكِنُ التَّأَكُّدُ مِنْهُ؛ يُقَاوِمُ الاكْتِشَاف)",
 "unascribable": "غَيْر مَنْسُوب, لَا يُعْزَى (غير قابل للعزو)",
 "unashamed": "غَيْر خَجِل, وَقِح (يستخدم للأشخاص أو سلوكهم؛ لا يشعر بأي خجل)",
 "unashamedly": "بلا خجل, بوقاحة (بدون خجل)\nمثال: تخلى بلا خجل عن المشروع",
 "unasked": "غَيْرُ مَدْعُوٍّ (لم تُوَجَّه إليه دعوة)",
 "unasked-for": "تَطَوُّعِيّ, غَيْرُ مَطْلُوبٍ (لم يُطلب ولم يُلتمس)",
 "unassailable": "رَاسِخ, مَنِيع (خَالٍ مِنَ الثَّغَرَاتِ أَوِ العُيُوب) / لَا يُمَسّ, لَا يُنَال (يَسْتَحِيلُ الاِعْتِدَاءُ عَلَيْه) / لَا يُقْهَر, مَنِيع (مُحَصَّنٌ ضِدَّ الهُجُوم؛ لَا يُمْكِنُ العَبَثُ بِه)",
 "unassailably": "بشكل ثابت, بشكل غير قابل للتغيير (بطريقة غير قابلة للتغيير أو التبديل)\nمثال: كانت آراؤه ثابتة بشكل غير قابل للتغيير",
 "unassertive": "خَجُول, غَيْر حَازِم (يميل إلى الخجل أو عدم الثقة بالنفس)\nمثال: شخص خجول وغير حازم",
 "unassertively": "دُونَ حَزْم (بطريقة غير حازمة)\nمثال: بدون حزم، تتبع دائماً اقتراحات زوجها",
 "unassertiveness": "ضعف الشخصية, عدم الحزم (التردد في الترويج للذات)",
 "unassignable": "غَيْر قَابِل لِلتَّحْوِيل (لا يمكن نقله أو تحويله إلى شخص آخر)",
 "unassigned": "غير معين, غير مكلف (لم يتم تعيينه)\nمثال: موظفون غير معينين (بدون مهام)",
 "unassisted": "بِلَا مُسَانَدَة, مُنْفَرِد (غير مدعوم من أشخاص آخرين) / بلا مساعدة, منفرد (يفتقر إلى المساعدة)",
 "unassuming": "غَيْرُ مُتَكَبِّر, مُتَوَاضِع (لَيْسَ مُتَعَجْرِفًا وَلَا مُتَطَاوِلًا)",
 "unassumingly": "بتواضع, بدون ادعاء (بطريقة متواضعة)\nمثال: هي متشككة بتواضع في عملها الخاص",
 "unassumingness": "إِخْلَاص, تَوَاضُع (صفة الطبيعية والبساطة)\nمثال: الصدق البسيط للأغاني الشعبية",
 "unassured": "غَيْر وَاثِق, مُتَرَدِّد (يفتقر إلى الجرأة أو الثقة بالنفس)",
 "unasterisked": "غَيْرُ مُنَجَّم (غير مُعلَّم بعلامة النجمة)",
 "unattached": "أَعْزَب, غَيْر مُرْتَبِط (غير مرتبط في علاقة جنسية حصرية) / حُرّ السِّبَاحَة, طَلِيق ((عن الحيوانات) قادر على السباحة بحرّيّة؛ غير مُثبَّت) / سَائِب, غَيْرُ مُثَبَّتٍ (غَيْرُ مُرْتَبِطٍ أَوْ مُثَبَّتٍ بَعْضُهُ بِبَعْضٍ)",
 "unattackable": "لَا يُقْهَر, مَنِيع (مُحَصَّنٌ ضِدَّ الهُجُوم؛ لَا يُمْكِنُ العَبَثُ بِه)",
 "unattainability": "اسْتِحَالَة التَّحْقِيق, تَعَذُّر المَنَال (حقيقة كون الشيء بعيد المنال، أو لا يمكن الوصول إليه أو اكتسابه)",
 "unattainable": "بَعِيد المَنَال, مُسْتَحِيل التَّحْقِيق (يستحيل تحقيقه أو بلوغه)",
 "unattainableness": "استحالة المنال (حالة كون الشيء غير قابل للتحقيق)",
 "unattainably": "بشكل بعيد المنال (بطريقة لا يمكن بلوغها أو إلى درجة لا يمكن الوصول إليها)\nمثال: هذا المنزل باهظ الثمن بشكل بعيد المنال",
 "unattended": "مَتْرُوك, مُهْمَل (يَفْتَقِر إِلَى مَنْ يَعْتَنِي بِه) / بِلَا مُرَافِق, غَيْرُ مَصْحُوب (يفتقر إلى مرافقة أو حراسة أو مُصاحبة) / غَيْر مُرَاقَب, مَتْرُوك (غير خاضع للمراقبة)",
 "unattired": "خَالِع مَلَابِسَهُ, مُتَعَرٍّ (أزال عنه الملابس)",
 "unattractive": "غَيْر جَذَّاب, مُنَفِّر (يفتقر إلى الجمال أو السحر) / غَيْر مُسْتَمِيل (يفتقر إلى القدرة على إثارة الاهتمام) / غَيْر مُسْتَسَاغ, مُنَفِّر (لا يستهوي الحواس)\nمثال: غير جذاب مثل معظم مناطق التعدين",
 "unattractively": "بِشَكْل مُنَفِّر, بِقُبْح (بطريقة غير جذابة)\nمثال: كانت ترتدي ملابس غير جذابة الليلة الماضية",
 "unattractiveness": "دمامة, عدم جاذبية (قبح في المظهر غير جذاب للمشاهدين)",
 "unattributable": "غَيْر مَنْسُوب, لَا يُعْزَى (غير قابل للعزو)",
 "unau": "كسلان ثنائي الأصابع (كسلان صغير نسبياً وسريع الحركة يمتلك مخلبين طويلين في كل قدم أمامية) / كسلان هوفمان (كسلان من أمريكا الوسطى يمتلك مخلبين طويلين في كل قدم أمامية وثلاثة مخالب طويلة في كل قدم خلفية)",
 "unauthentic": "زَائِف, مَنْحُول (كاذب أو مُقلَّد؛ ليس كما يبدو عليه)",
 "unauthorised": "غَيْر مُخَوَّل, غَيْر مُصَرَّح بِه (غير ممنوح السلطة) / غَيْر مَأْذُون, غَيْر مُصَرَّح بِه (بدون تصريح أو إذن رسميّ)",
 "unauthorized": "غَيْر مُخَوَّل, غَيْر مُصَرَّح بِه (غير ممنوح السلطة) / غَيْر مَأْذُون, غَيْر مُصَرَّح بِه (بدون تصريح أو إذن رسميّ)",
 "unauthorized absence": "تغيب عسكري, غياب غير مصرح به (غياب عسكري غير مصرح به)",
 "unavailability": "عَدَم إِتَاحَة, عَدَم تَوَفُّر (صفة كون الشيء غير متوفر عند الحاجة)",
 "unavailable": "غير متوفر (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "unavailing": "عَبَثِيّ, عَقِيم (لَا يُنْتِجُ أَيَّ نَتِيجَةٍ أَوْ أَثَر)",
 "unavenged": "غير منتقم له (الذي لم يتم أخذ الثأر له)\nمثال: جريمة قتل لم يُنتقم لها",
 "unavoidability": "حَتْمِيَّة, عَدَم قَابِلِيَّة التَّجَنُّب (صفة استحالة تجنب الشيء أو التهرب منه)",
 "unavoidable": "وَاجِب (اسم لما يُوجَبُ فعله؛ اسم لما صار حدوثه أكيد)\nمثال: لا شكر على واجب.",
 "unavoidable casualty": "قضاء وقدر, قوة قاهرة (كارثة طبيعية لا مفر منها تقطع المسار المتوقع للأحداث)\nمثال: اكتشف أن منزله لم يكن مؤمناً ضد القضاء والقدر",
 "unavoidably": "بشكل حتمي, لا محالة (بحكم الضرورة؛ بشكل لا مفر منه)\nمثال: انزلق الوضع لا محالة نحو الكارثة",
 "unavowed": "سِرِّيّ, غَيْر مُعْلَن (لا يُفصَح عنه علنًا) / غَيْرُ مُصَرَّحٍ بِهِ (لم يُؤكَّد أو يُذكَر أو يُعلَن عنه) / غَيْرُ مُعْلَن, مَكْتُوم (لا يُعبَّر عنه علانية؛ غير مُصرَّح به)",
 "unawakened": "غَيْر مُوقَظ (لا يزال نائماً ولم يُوقَظ بعد) / غافل, غير مستثار (لم يتم إثارته أو تنشيطه)\nمثال: عواطف غير مستثارة",
 "unaware": "غَافِل, غَيْر مُدْرِك ((غالباً يتبعه 'بـ') غير مدرك)\nمثال: بدا غافلاً عن التدقيق",
 "unawareness": "عدم معرفة, غفلة (غياب الوعي الناتج عن نقص المعرفة أو الانتباه)",
 "unawares": "على حين غرة, في موقف حرج (في وضع غير موات أو مفاجئ) / على حين غرة, فجأة (فجأة وبشكل غير متوقع) / دون قصد, عن غير عمد (بدون تفكير مسبق أو خطة؛ سهواً)\nمثال: أُخذت على حين غرة (نفد ما لدي)",
 "unawed": "غير مبهور (غير مأخوذ بالرهبة)",
 "unbacked": "بِلَا مُسَانَدَة, مُنْفَرِد (غير مدعوم من أشخاص آخرين)",
 "unbaffled": "صَافِي الذِّهْن, غَيْر مُرْتَبِك (غير متحيّر من المواقف أو الأقوال المتناقضة)",
 "unbalance": "اختلال, عدم استقرار (نقص التوازن أو حالة اختلال التوازن) / اضطراب عقلي, خلل عقلي (حالة من الاضطراب والتوهان العقلي)\nمثال: اختلال هرموني",
 "unbalanced": "غَيْرُ مُتَوَازِن (المدين والدائن ليسا متساويين) / غير متوازن, مختل التوازن (كونه خارج التوازن أو تم إخراجه عن التوازن) / مَجْنُون, مُخْتَلّ (مصاب بالجنون أو الاضطراب العقليّ)",
 "unbalconied": "بِلَا شُرْفَة (ليس لديه شرفات)",
 "unbanded": "غَيْر مَوْسُوم (لم يتم تعريفه بشريط)\nمثال: طائر غير موسوم",
 "unbaptised": "غير معمد (لم يخضع لطقوس المعمودية المسيحية)",
 "unbaptized": "غير معمد (لم يخضع لطقوس المعمودية المسيحية)",
 "unbarred": "غَيْر مُقْفَل, مَحْلُول (غير مثبّت أو مؤمّن بإحكام)",
 "unbarreled": "غَيْر مُعَبَّأ فِي بَرْمِيل (ليس في برميل)",
 "unbarrelled": "غَيْر مُعَبَّأ فِي بَرْمِيل (ليس في برميل)",
 "unbearable": "غير محتمل, لا يطاق (لا يمكن تحمله أو الصبر عليه)\nمثال: درجة لا تطاق من العاطفية",
 "unbearably": "بِشَكْلٍ لَا يُطَاقُ",
 "unbeatable": "لَا يُغْلَب, لَا يُقْهَر (لَا يُمْكِنُ هَزِيمَتُهُ أَوْ إِخْضَاعُهُ) / عَصِيٌّ عَلَى الهَزِيمَة, لَا يُقْهَر (يصعب التغلّب عليه أو هزيمته)",
 "unbeaten": "غَيْرُ مَغْلُوب, لَمْ يُقْهَر (لَمْ يُغْلَبْ أَوْ يُقْهَر)",
 "unbecoming": "غَيْر لَائِق, مُنَافٍ لِلآدَاب (لا يتوافق مع المعايير المقبولة للسلوك اللائق في المجتمع المهذّب)",
 "unbecomingly": "بِشَكْل غَيْر لَائِق, دُونَ لِيَاقَة (بدون لياقة)",
 "unbecomingness": "عدم ملاءمة (جودة كون الشيء غير لائق) / عدم اللياقة, عدم المناسبة (حالة عدم كون الشيء جذاباً أو مناسباً)",
 "unbefitting": "غَيْر لَائِق (غير ملائم أو غير مناسب للموقف)",
 "unbeknown": "دون علم, في غفلة من (بدون علم شخص ما)\nمثال: دون علمي، قامت هي بجميع الترتيبات",
 "unbeknownst": "مُبْهَم",
 "unbelief": "جحود, عدم إيمان (رفض الاعتقاد أو الإيمان)",
 "unbelievable": "لا يصدق (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: لا أحب المدرسة.",
 "unbelievably": "بِشَكْل لَا يُصَدَّق (بطريقة لا تصدق) / بِإِعْجَاز, بِشَكْل لَا يُصَدَّق (ليس من السهل تصديقه)\nمثال: كان غاضباً بشكل لا يصدق",
 "unbelieving": "مُتَشَكِّك, مُرْتَاب (يُنكِر أو يُشَكِّك في عقائد دين ما خاصةً) / غَيْرُ مُؤْمِن, لَاأَدْرِيّ (يرى أن المعرفة تقتصر على الظواهر المادية وأن المسائل الروحية لا يمكن معرفتها) / إِلْحَادِيّ, مُلْحِد (يرفض الإيمان بأيّ إله)",
 "unbelievingly": "بِاسْتِنْكَار, بِتَشَكُّك (بطريقة شاكة وغير مصدقة)\nمثال: نظرت المرأة إليها بعدم تصديق",
 "unbeloved": "مَحْرُومُ الحُبّ, وَالِه (تعيس في الحب؛ يعاني من حب بلا مقابل)",
 "unbelted": "بِلَا حِزَام, غَيْر مُحَزَّم (يفتقر إلى حزام)\nمثال: السترات غير المحزمة رائجة هذا الموسم",
 "unbendable": "ثَابِتٌ, رَاسِخٌ (يتميز بعزيمة راسخة لا تتزعزع)",
 "unbending": "جَامِد, صَارِم (غَيْرُ قَادِرٍ عَلَى التَّكَيُّفِ أَوِ التَّغَيُّرِ لِمُوَاجَهَةِ الظُّرُوفِ)",
 "unbeneficed": "غَيْر مُسْتَفِيد (كنسياً) (ليس لديه وظيفة كنسية ذات دخل)",
 "unbent": "مُسْتَقِيم, مُنْتَصِب القَامَة (مستقيم في وضعيَّة الجسم؛ منتصب) / غَيْر مَثْنِيّ, مُسْتَقِيم (لم يتم ثنيه أو طيّه)",
 "unbiased": "غَيْرُ مُتَحَيِّز, مُحَايِد (بِلَا تَحَيُّزٍ أَوِ انْحِيَاز) / غَيْرُ مُتَحَيِّز, مُحَايِد (يَتَّسِمُ بِانْعِدَامِ التَّحَيُّز)",
 "unbiassed": "غَيْرُ مُتَحَيِّز, مُحَايِد (بِلَا تَحَيُّزٍ أَوِ انْحِيَاز) / غَيْرُ مُتَحَيِّز, مُحَايِد (يَتَّسِمُ بِانْعِدَامِ التَّحَيُّز)",
 "unbigoted": "غَيْرُ مُتَعَصِّب (لا يتمسك بآرائه بتعصب)",
 "unbitter": "بِلَا ضَغِينَة, غَيْر حَاقِد (لا يحمل استياءً ولا رغبة في الانتقام)",
 "unbleached": "غَيْر مَصْبُوغ, غَيْر مُبَيَّض (لم يُلوَّن أو يُبيَّض صناعيًّا)",
 "unblemished": "بِلَا شَائِبَة, نَاصِع (خال من البقع أو اللطخات الجسدية أو الأخلاقية)\nمثال: سجل ناصع",
 "unblended": "غير مخلوط, غير ممزوج (غير ممزوج أو مخلوط معاً)",
 "unblessed": "غَيْرُ مُنْعَمٍ عَلَيْهِ (لم يُزوَّد بشيء مرغوب فيه)",
 "unblinking": "ثَابِت, لَا يَتَرَاجَع (لا يتراجع أمام الخطر ولا يرتدع) / ثَابِتُ الجَأْش (لا يُظهِر أيّ انفعال مرئيّ)",
 "unblinkingly": "بجمود, دون أن يرف له جفن (دون إظهار أي عاطفة)\nمثال: استمع القاتل المدان دون أن يرف له جفن لقراءة حكمه",
 "unbloody": "بِلَا دِمَاء, سِلْمِيّ (يتحقق بدون سفك دماء)",
 "unblushing": "بِلَا خَجَل, عَدِيم الحَيَاء (لا يشعر بأيّ خجل أو حياء)",
 "unblushingly": "بلا خجل, بوقاحة (بدون احمرار الوجه خجلاً)\nمثال: أعلن خصمه الرئيسي بلا خجل فوزه قبل فرز الأصوات",
 "unbodied": "بلا جسد, غير مجسد (ليس له جسد) / بِلَا جَسَد, غَيْرُ مُتَجَسِّد (لَيْسَ لَهُ جَسَدٌ مَادِّيّ)",
 "unbolted": "غَيْر مُقْفَل, مَحْلُول (غير مثبّت أو مؤمّن بإحكام)",
 "unbooked": "غَيْرُ مَحْجُوزٍ (لم يُحجز مسبقاً)",
 "unbordered": "بِلَا حُدُود, غَيْر مُحَاط (ليس له حدود)",
 "unborn": "جنيني, غير مولود (لم يولد بعد)\nمثال: أجيال لم تولد بعد",
 "unbound": "طَلِيق, غَيْر مُقَيَّد (غير مقيد أو مربوط بقيود) / غَيْر مُجَلَّد (غير مؤمن داخل غطاء) / غَيْر مُرْتَبِط (غَيْر مُحْتَجَز فِي ارْتِبَاط كِيمِيَائِيّ أَوْ فِيزْيَائِيّ)\nمثال: كتاب غير مجلد",
 "unbounded": "بِلَا حُدُود, لَامَحْدُود (يَبْدُو بِلَا حُدُودٍ فِي الكَمِّيَّةِ أَوِ العَدَدِ أَوِ الدَّرَجَةِ أَوِ المَدَى)",
 "unbounded interval": "فترة مفتوحة (فترة لا تتضمن نقطتي نهايتها)",
 "unboundedness": "لا محدودية, لا نهائية (صفة كون الشيء لا نهائياً؛ بلا حدود أو قيود)",
 "unbowed": "شَامِخ, غَيْرُ مُنْحَنٍ (لَمْ يُجْبَرْ عَلَى الانْحِنَاءِ أَمَامَ غَازٍ) / مُسْتَقِيم, مُنْتَصِب القَامَة (مستقيم في وضعيَّة الجسم؛ منتصب)",
 "unbraced": "بِلَا دِعَامَات (بدون دعامات أو ركائز)",
 "unbrainwashed": "غير مغسول الدماغ (لم يتم إخضاعه بنجاح لغسيل الدماغ)\nمثال: على الرغم من التعذيب والضغط النفسي، ظل بعض أسرى الحرب غير مغسولي الدماغ",
 "unbrako key": "مفتاح ألن, مفتاح سداسي (مفتاح ربط للبراغي السداسية (ألن))",
 "unbrako wrench": "مفتاح ألن, مفتاح سداسي (مفتاح ربط للبراغي السداسية (ألن))",
 "unbranched": "بِلَا أَغْصَان, غَيْرُ مُتَفَرِّع (خَالٍ مِنَ الأَغْصَانِ أَوِ الفُرُوع)",
 "unbranching": "بِلَا أَغْصَان, غَيْرُ مُتَفَرِّع (خَالٍ مِنَ الأَغْصَانِ أَوِ الفُرُوع)",
 "unbranded": "غير موسوم (غير معلم بعلامة)\nمثال: ماشية غير موسومة",
 "unbreakable": "غير قابل للكسر, متين (من المستحيل كسره خاصة في ظل الاستخدام العادي)\nمثال: أواني طعام بلاستيكية غير قابلة للكسر",
 "unbreakableness": "عدم قابلية الكسر (قوام الشيء الذي لا ينكسر تحت الضغط)",
 "unbridgeable": "غَيْر قَابِل لِلتَّجْسِير, لَا يُمْكِن عُبُورُه (غير قابل للتجسير)\nمثال: نهر عريض لا يمكن عبوره",
 "unbridled": "جَامِح, مُنْفَلِت (غير مكبوح أو غير مسيطَر عليه)",
 "unbroken": "سَلِيم, غَيْر مَكْسُور (غير مكسور؛ كامل وسليم؛ قطعة واحدة) / مَحْفُوظ, مُوفًى بِه ((خاصة للوعود أو العقود) لم يتم انتهاكه أو تجاهله) / غَيْر مُتَقَطِّع, مُتَّصِل (يتميز بامتدا مستمر أو غير منقطع في المكان أو الزمان أو التسلسل) / بور, غير محروث ((للأراضي الزراعية) لم تحرث)\nمثال: لحسن الحظ العدسة الأخرى سليمة",
 "unbrushed": "غَيْرُ مُمَشَّط ((لِلشَّعْرِ أَوِ المَلَابِسِ) لَمْ يُفْرَشْ بِالفُرْشَاة)",
 "unburdened": "بِلَا عِبْء, خَفِيفُ الحِمْل (غير مُثقَل بحمل مادّي) / غير مثقل بالأعباء, مرتاح (غير مثقل بالصعوبات أو المسؤوليات)\nمثال: غير مثقل بنظرية شاملة",
 "unburied": "غَيْر مَدْفُون (غير مدفون)",
 "unburnished": "بَاهِت, غَيْر مَجْلُوّ ((عن المعادن) لم يُجعل لامعاً وناعماً بالاحتكاك)",
 "unbuttoned": "مَفْكُوك الأَزْرَار (غير مزرر) / طَلِيق, مُتَحَلِّل (غير مقيّد في الفعل أو التعبير)\nمثال: التقطت الريح حاشية معطفها مفكوك الأزرار",
 "uncalled-for": "لَا مُبَرِّر لَه, مَجَّانِيّ (غير ضروري وغير مبرر) / غَيْر مَطْلُوب, لَا دَاعِيَ لَه (غير مطلوب وغير مُلتمَس)",
 "uncamphorated": "خَالٍ مِن الكَافُور (لا يحتوي على الكافور)",
 "uncannily": "بشكل خارق, بصورة غريبة (بطريقة خارقة للعادة)\nمثال: روبوتات بشرية بشكل خارق",
 "uncanny": "خَارِق, غَرِيب (يوحي بعمل قوى خارقة للطبيعة) / خَارِق لِلْعَادَة, غَرِيب (يتجاوز ما هو عادي أو طبيعي)",
 "uncanny valley": "وَادٍ غَرِيب (حوض أو منخفض طبيعي على سطح الأرض، يمتد بين السهول والهضاب والجبال)\nمثال: بإمكاني السباحة في الواد.",
 "uncapped": "غَيْرُ مُلَبَّس (يُستخدَم خاصة عن الأسنان الأمامية بلا تيجان اصطناعية)",
 "uncarbonated": "غَيْرُ مُكَرْبَن (لا يحتوي على كربنة أو غاز ثاني أكسيد الكربون)",
 "uncared-for": "غَيْر مُعْتَنًى بِه, مُهْمَل (يفتقر إلى الرعاية والاهتمام اللازمين)",
 "uncaring": "غَافِل, لَامُبَالٍ (بلا اكتراث أو اهتمام بالآخرين) / بَارِدُ المَشَاعِر, مُتَجَرِّد (يفتقر إلى العاطفة أو الدفء الوجداني)",
 "uncarpeted": "بِلَا سَجَّاد, غَيْر مَفْرُوش بِالسَّجَّاد (غير مفروش بالسجاد)\nمثال: أرضيات عارية غير مفروشة بالسجاد",
 "uncarved": "غَيْر مَنْحُوت (غير منحوت)",
 "uncastrated": "غير مخصي, فحل (لم يتم خصيه)",
 "uncategorised": "غَيْر مُصَنَّف (لم يُصنَّف أو يُرتَّب في فئات)",
 "uncategorized": "غَيْر مُصَنَّف (لم يُصنَّف أو يُرتَّب في فئات)",
 "uncaulked": "غير مُقلفط (غير مسدود الشقوق أو مختوم)",
 "uncaused": "اتِّفَاقِيّ, بِلَا سَبَب (ليس له سبب أو سبب ظاهر)",
 "unceasing": "دَائِم, لَا يَنْقَطِع (غَيْرُ مُنْقَطِعٍ فِي الزَّمَنِ وَمُسْتَمِرٌّ إِلَى أَجَلٍ غَيْرِ مُسَمًّى) / أَبَدِيّ, أَزَلِيّ (مستمرّ إلى الأبد أو إلى أجل غير مُسمًّى)",
 "unceasingly": "بِلَا انْقِطَاع, بِلَا تَوَقُّف (بعزيمة لا تكل)\nمثال: الرقص يلهمه بلا توقف للسعي أعلى وأعلى نحو قمة الكمال المشرقة",
 "uncensored": "غَيْر خَاضِع لِلرَّقَابَة (لا يخضع للرقابة)\nمثال: تقارير إخبارية غير خاضعة للرقابة",
 "unceremonial": "بِلَا تَكَلُّف, بِلَا مَرَاسِم (دُونَ مَرَاسِمَ أَوْ رَسْمِيَّاتٍ)",
 "unceremonious": "بِلَا مُجَامَلَات, غَيْرُ رَسْمِيّ (بدون المراسم أو الشكليات اللازمة) / بِلَا تَكَلُّف, بِلَا مَرَاسِم (دُونَ مَرَاسِمَ أَوْ رَسْمِيَّاتٍ)",
 "unceremoniously": "بدون مراسم, بشكل مفاجئ (بطريقة غير رسمية أو فظة)\nمثال: طُرد بدون مراسم",
 "unceremoniousness": "تبسط, عدم تكلف (أسلوب غير مراسمي)",
 "uncertain": "غَيْر مُحَدَّد (غامض (يُستخدم خاصة في صيغة النفي)) / غَيْر مُؤَكَّد, مَشْكُوك فِيه (غير ثابت بما لا يدع مجالاً للشك؛ لا يزال غير مقرر أو غير معروف) / غَيْر وَاثِق, مُتَرَدِّد (يفتقر إلى أو يشير إلى نقص الثقة أو الاطمئنان) / غَيْر مُؤَكَّد (غير مؤكد الحدوث؛ ليس حتمياً)\nمثال: مستقبل غير مؤكد",
 "uncertainly": "بترنح, بشكل غير مستقر (بطريقة غير ثابتة) / بتردد, دون يقين (بإظهار عدم اليقين)\nمثال: مشى مترنحاً نحو المخرج",
 "uncertainness": "تَزَعْزُع, شَكّ (كون الشيء غير مستقر أو مشكوك فيه أو معتمد على الصدفة)\nمثال: عدم يقين النتيجة",
 "uncertainty": "تَزَعْزُع, شَكّ (كون الشيء غير مستقر أو مشكوك فيه أو معتمد على الصدفة) / ارتياب, شك (حالة عدم التأكد من شيء ما)\nمثال: عدم يقين النتيجة",
 "uncertainty principle": "مبدأ الريبة, مبدأ عدم اليقين ((نظرية الكم) النظرية القائلة بأنه من المستحيل قياس كل من الطاقة والوقت (أو الموقع والزخم) بدقة كاملة في نفس الوقت)",
 "uncertified": "غَيْر مُعْتَمَد (يفتقر إلى الوثائق الرسمية المطلوبة أو الإقرار)",
 "unchained": "طَلِيق, مَحْلُول القُيُود (غير مُقيَّد بأغلال أو سلاسل)",
 "unchallengeable": "غَيْرُ قَابِلٍ لِلتَّحَدِّي, لَا يَقْبَلُ الطَّعْن (لَا يُمْكِنُ الاعْتِرَاضُ عَلَيْهِ أَوْ مُنَاقَشَتُه)",
 "unchallenged": "بِلَا مُنَازِع, مُسَلَّمٌ بِه (مُتَّفَقٌ عَلَيْهِ عُمُومًا؛ لَا يَخْضَعُ لِلنِّزَاع)",
 "unchangeability": "اسْتِقْرَار, ثَبَات (صفة عدم القابلية للتغيير؛ وجود ميل ملحوظ للبقاء دون تغيير)",
 "unchangeable": "ثَابِت, غَيْر قَابِل لِلتَّغْيِير (غير قابل للتغيير أو الخضوع للتغيير)\nمثال: جزء ثابت وغير قابل للتغيير من البلازما الجرثومية",
 "unchangeableness": "اسْتِقْرَار, ثَبَات (صفة عدم القابلية للتغيير؛ وجود ميل ملحوظ للبقاء دون تغيير)",
 "unchangeably": "بشكل ثابت, بشكل غير قابل للتغيير (بطريقة غير قابلة للتغيير أو التبديل)\nمثال: كانت آراؤه ثابتة بشكل غير قابل للتغيير",
 "unchanged": "غَيْر مُغَيَّر (باقٍ في حالة أصلية) / ثَابِت, غَيْر مُتَغَيِّر (لم يُصنع أو يصبح مختلفاً)\nمثال: استمر غير متغير عبر الزمن",
 "unchanging": "سَاكِن, مُسْتَقِرّ (لا يُظهر تغيّرًا يُذكر إن وُجد) / ثَابِت, مُطَّرِد (يَلْتَزِمُ بِالمَبَادِئِ أَوِ المَسَارِ ذَاتِهِ عَبْرَ الزَّمَنِ)",
 "unchangingness": "اسْتِقْرَار, ثَبَات (صفة عدم القابلية للتغيير؛ وجود ميل ملحوظ للبقاء دون تغيير)",
 "uncharacteristic": "غَيْر مُمَيِّز, غَيْر نَمَطِيّ (متميز وغير نمطي)\nمثال: كتاب غير مميز لمؤلفه (لا يشبه أسلوبه المعتاد)",
 "uncharacteristically": "عَلَى غَيْر العَادَة (بطريقة غير معهودة)\nمثال: كان بارداً على غير العادة",
 "uncharged": "غَيْر مَشْحُون (لجسيم أو جسم أو نظام؛ ليس لديه شحنة)\nمثال: جسيم غير مشحون",
 "uncharitable": "غَيْر خَيْرِيّ, قَاسٍ (يفتقر إلى الحب والكرم)\nمثال: كل الكلمات التقية والأفعال غير الخيرية",
 "uncharted": "غَيْر مَرْسُوم, غَيْر مُسْتَكْشَف ((لمناطق مجهولة) لم يُجرَ مسحها أو استكشافها بعد)",
 "unchartered": "غَيْر مُسْتَأْجَر (غير مستأجر)",
 "unchaste": "غَيْر عَفِيف, فَاسِق (غير عفيف)\nمثال: سلوك غير عفيف",
 "uncheckable": "غَيْرُ قَابِلٍ لِلْكَبْح (لا يمكن ضبطه أو كبح جماحه)",
 "unchecked": "جَامِح, مُنْفَلِت (غير مكبوح أو غير مسيطَر عليه)",
 "uncheerful": "كَئِيب, كَنُود (يسبب مشاعر حزينة من الكآبة وعدم الكفاءة)\nمثال: التوقعات الاقتصادية محبطة",
 "uncheerfulness": "انقباض, كآبة (غير مؤدٍ للبهجة أو الروح المعنوية الجيدة) / انقباض, كآبة (شعور بالحزن الكئيب أو التشاؤمي)",
 "unchewable": "عَصَبِيّ, لِيفِيّ ((يوصف به اللحم) مليء بالأوتار؛ خاصة يستحيل مضغه)",
 "unchivalrous": "غَيْرُ فُرُوسِيّ, وَقِح (فظّ بشكل مُسِيء)",
 "unchivalrously": "بغير نبل, بقلة مروءة (بطريقة تفتقر للفروسية والشهامة)\nمثال: بقلة مروءة، بدأ الأزواج الذين كان عليهم توفير مثل هذه الملذات البريئة في حساب التكاليف",
 "unchristian": "غَيْر مَسِيحِيّ (ليس من العقيدة المسيحية)",
 "unchristianly": "غَيْر لَائِق بِالمَسِيحِيّ (لا يتّفق مع المبادئ والأخلاق المسيحيّة)",
 "unchristlike": "غَيْر لَائِق بِالمَسِيحِيّ (لا يتّفق مع المبادئ والأخلاق المسيحيّة)",
 "uncial": "بوصي (متعلق بالحروف الكبيرة المستديرة (نمط خط تاريخي) أو مكتوب بها) / الخط الأنسيالي, الخط البوصي (نمط من الكتابة يتميز بحروف كبيرة مستديرة نوعاً ما؛ وجد خاصة في المخطوطات اليونانية واللاتينية من القرن الرابع إلى الثامن)\nمثال: حروف بوصية",
 "unciform bone": "عظم كلابي (عظم الرسغ المحاذي للإصبعين الرابع والخامس)",
 "uncircumcised": "أَغْلَف",
 "uncivil": "سليط اللسان, غير مهذب (يفتقر إلى التحضر أو الأخلاق الحميدة)\nمثال: لا أريد منك شيئاً سوى الابتعاد عن لسانك السليط",
 "uncivilised": "بَرْبَرِيّ, مُتَوَحِّش (يفتقر إلى الحضارة والتمدّن؛ وحشيّ السلوك)",
 "uncivilized": "هَمَجِيّ",
 "uncivilly": "بشكل غير متحضر, بفضاضة (بطريقة غير متحضرة أو فظة)\nمثال: يعامل زوجته السابقة بفضاضة",
 "unclad": "خَالِع مَلَابِسَهُ, مُتَعَرٍّ (أزال عنه الملابس)",
 "unclaimed": "غَيْرُ مُطَالَب بِه (لم يُطالِب به مالكه أو صاحب الحقّ فيه)",
 "unclassifiable": "غَيْر قَابِل لِلتَّصْنِيف (لا يمكن تصنيفه)",
 "unclassified": "غَيْر مُصَنَّف (غير مرتب في أي تجميع محدد) / عَلَنِيّ, غَيْر سِرِّيّ (لا يخضع لتصنيف أمني)",
 "uncle": "عَمّ, خَال (هو أخ الأب؛ في : هو إضافة إلى الفعل المضارع تشبه سَوْفَ إلا أنها تستخدم للتعبير عن الحاضر المستمر)\nمثال: أنا وهو أولاد عم.",
 "uncle sam": "اَلْعَمّ سَام",
 "uncle scrooge": "العم دهب",
 "uncle tom": "العم توم ((إهانة عرقية) اسم مهين لرجل أسود خاضع ومذعن للبيض)",
 "unclean": "قَذِر, مُتَّسِخ (متسخ أو من المحتمل أن يتسخ بالأوساخ أو القذارة) / غَيْر طَاهِر, نَجِس (لديه شائبة جسدية أو أخلاقية تجعله غير نقي وفقاً للقوانين الغذائية أو الاحتفالية)\nمثال: أرصفة قذرة غير مكنوسة",
 "uncleanliness": "عدم نظافة, قذارة (نقص في عادات النظافة)",
 "uncleanly": "قَلِيل النَّظَافَة (يعتاد عدم النظافة بشكل مستمرّ)",
 "uncleanness": "عدم نظافة, قذارة (حالة كون الشيء غير صحي)",
 "unclear": "غَامِض, غَيْر وَاضِح (غير واضح للعقل) / سيء التحديد, غير واضح (مصرح به أو موصوف بشكل سيء) / غَيْر مَقْرُوء, مُسْتَغْلَق (يَتَعَذَّر قِراءَتُه أَوْ فَكّ رُموزِه)\nمثال: القانون نفسه كان غير واضح بشأن تلك النقطة",
 "uncleared": "غير خالٍ, غير مُطهَّر (لم يتم تطهيره؛ لم يتم تخليصه من الأشياء أو العوائق)\nمثال: أرض غير مطهرة",
 "unclearly": "بشكل غير واضح (بطريقة غير واضحة)",
 "unclearness": "عَدَم وُضُوح (عدم القدرة على الفهم نتيجة لعدم الوضوح)",
 "unclehood": "عُمُومَة, خُؤُولَة",
 "unclimbable": "غَيْرُ قَابِلٍ لِلتَّسَلُّق, مُسْتَعْصٍ (لَا يُمْكِنُ تَجَاوُزُهُ أَوْ تَسَلُّقُه) / غير قابل للتسلق, وعر (يعجز المرء عن صعوده)",
 "unclipped": "غَيْرُ مَقْصُوص (لم يُقصّ أو يُشذَّب)",
 "unclogged": "مُزَال الانْسِدَاد (أُزيلت منه العوائق والانسدادات)",
 "unclothed": "عَارٍ, غَيْر مَكْسُوّ (لا يرتدي ملابس)",
 "unclouded": "غَيْر مُعَكَّر (لم يصبح معتماً أو عكراً بسبب الرواسب) / سَلِيم العَقْل (غير مضطرب عقليّاً؛ واضح التفكير) / خَالٍ مِنَ الغُيُوم, صَافٍ (خالٍ من الغيوم) / صَافٍ, نَقِيّ ((في الصوت أو اللون) خالٍ من كلّ ما يُكَدِّر أو يُعَتِّم)",
 "uncloudedness": "صَفَاء, نَقَاء (صفة الماء الصافي)\nمثال: عندما استيقظت عاد الصفاء إلى عينيها",
 "uncluttered": "خَالٍ مِنَ الفَوْضَى (لَيْسَ فِيهِ شَيْءٌ زَائِدٌ أَوْ غَيْرُ ضَرُورِيّ)",
 "unco": "بشكل غير عادي, بشكل لافت (لدرجة أو مدى ملحوظ)\nمثال: كانت طويلة بشكل غير عادي",
 "uncoated": "غير مطلي, غير مغلف (ليس لديه طبقة طلاء)\nمثال: ورق غير مطلي",
 "uncoerced": "رَاغِب, غَيْرُ مُكْرَه (لَمْ يُحْدَث بِالإِكْرَاهِ أَوِ القُوَّة)",
 "uncoiled": "مبسوط, مستقيم (لم يعد ملتفًا)",
 "uncollected": "غير مجموع (لم يتم إحضاره معاً في مكان واحد)\nمثال: قمامة غير مجمعة في الشوارع",
 "uncollectible": "مَعْدُومُ التَّحْصِيل (غَيْرُ قَابِلٍ لِلتَّحْصِيل)",
 "uncolored": "غَيْر مُلَوَّن (بدون لون) / غَيْر مَصْبُوغ, غَيْر مُبَيَّض (لم يُلوَّن أو يُبيَّض صناعيًّا)\nمثال: الماء النقي غير ملون",
 "uncoloured": "غَيْر مُلَوَّن (بدون لون)\nمثال: الماء النقي غير ملون",
 "uncolumned": "بِلَا أَعْمِدَة, غَيْر مُعَمَّد (ليس لديه أعمدة)",
 "uncombable": "غَيْرُ قَابِلٍ لِلتَّمْشِيط (لَا يُمْكِنُ تَمْشِيطُه)",
 "uncombed": "غير ممشط, منكوش ((للشعر) غير ممشط)\nمثال: كان غير مغتسل وغير ممشط وملابسه نصف مزررة",
 "uncombined": "غير مُجمَّع, منفصل (غير منضم أو متحد في واحد)",
 "uncomely": "غَيْر لَائِق, مُنَافٍ لِلآدَاب (لا يتوافق مع المعايير المقبولة للسلوك اللائق في المجتمع المهذّب)",
 "uncomfortable": "غَيْر مُرِيح (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "uncomfortableness": "ارتباك, وعي مفرط بالذات (إحراج نابع من الشعور بأن الآخرين يراقبونك بشكل نقدي) / انزعاج, عدم راحة (حالة التوتر والشعور بالألم)",
 "uncomfortably": "بشكل غير مريح (بانزعاج جسدي)\nمثال: استلقت على الأريكة وجسمها ملتوي بشكل غير مريح",
 "uncommercial": "غَيْر مُرْبِح (لا يفضي إلى النجاح التجاري)",
 "uncommercialised": "غَيْر مُسَوَّق (لم يُسوّق تجارياً)",
 "uncommercialized": "غَيْر مُسَوَّق (لم يُسوّق تجارياً)",
 "uncommitted": "أَعْزَب, غَيْر مُرْتَبِط (غير مرتبط في علاقة جنسية حصرية) / غير ملتزم (غير مقيد أو غير متعهد) / غَيْر مَشْغُول, مُتَاح (لَيْسَ مَشْغُولًا؛ غَيْر مُلْتَزِم بِشَيْء آخَر)",
 "uncommon": "غير شائع, غير مألوف (غير شائع أو لا يصادف عادة؛ عظيم المقدار بشكل غير عادي أو لافت للنظر في طابعه أو نوعه) / فَرِيد, نَادِر (يتميز بجودة غير مألوفة؛ خاصة من الدرجة العليا أو المتطرفة في نوعه)\nمثال: طيور غير شائعة",
 "uncommonly": "بشكل استثنائي, بشكل غير مألوف (بشكل استثنائي)\nمثال: من الصعب بشكل استثنائي العثور على علاج شائع",
 "uncommonness": "نُدْرَة (الاستثنائية نتيجة لكون الشيء نادراً وقليل المصادفة) / تَمَيُّز, نُدْرَة (الاستثنائية نتيجة للاتصاف بصفة نادرة أو فائقة)",
 "uncommunicative": "انطوائي, غير تواصلي (لا يميل إلى التحدث أو إعطاء المعلومات أو التعبير عن الآراء)",
 "uncommunicativeness": "انعزال, قلة كلام (سمة كون المرء غير متواصل)",
 "uncomparable": "غير قابل للمقارنة, لا يضاهى (بحيث تكون المقارنة مستحيلة؛ غير مناسب للمقارنة أو يفتقر للميزات التي يمكن مقارنتها)\nمثال: أسبوع لا يضاهى من الراحة والمتعة",
 "uncomparably": "بشكل لا يضاهى, بشكل منقطع النظير (بطريقة لا يمكن مقارنتها أو لدرجة لا تضاهى)\nمثال: إنها موهوبة بشكل لا يضاهى",
 "uncompartmented": "غَيْر مُقَسَّم إِلَى حُجَيْرَات (غير مقسم؛ غير مقسم إلى حجيرات أو وحدات معزولة)",
 "uncompassionate": "عديم الرحمة, قاسي القلب (يفتقر إلى الرحمة أو الشعور بالآخرين)\nمثال: لم تستطع الدموع الفضية اختراق قلب أبيها عديم الرحمة",
 "uncompensated": "بِلَا رَاتِب, غَيْرُ مَأْجُور (لَا يَدْفَعُ رَاتِبًا)",
 "uncompetitive": "غَيْرُ تَنَافُسِيّ (لا يميل إلى المنافسة)",
 "uncompetitiveness": "عدم تنافسية (صفة عدم الكفاءة للمنافسة بنجاح مع الآخرين)\nمثال: في توازن الفصل، تشير الحكومة المحلية إلى عدم تنافسية الشركة المحلية من خلال تحديد تعريفة أقل مما هو أمثل في ظل المعلومات الكاملة",
 "uncomplaining": "صبور, غير شاكٍ (لا يشتكي)\nمثال: شجاعة صامتة (غير شاكية)",
 "uncomplainingly": "بِلَا شَكْوَى, دُونَ تَذَمُّر (بدون شكوى)\nمثال: زوجة وأم صغيرة شهمة بنفس القدر تحافظ دون تذمر على إنتاج وجبات لذيذة ومغذية",
 "uncomplete": "غير مكتمل, ناقص (غير كامل أو غير كلي؛ لم يتم إنجازه)\nمثال: سرد غير مكتمل لحياته",
 "uncompleted": "غَيْرُ مُلْتَقَط, غَيْرُ مُنْجَز (لم يُلتقَط أو لم يُلتقَط داخل الحدود المسموحة) / غَيْرُ مُكْتَمِل, نَاقِص (لَمْ يَكْتَمِلْ بَعْدُ)",
 "uncomplicated": "بَسِيط, غَيْر مُعَقَّد (سَهْل وَغَيْر مُعَقَّد أَوْ مُتَشَعِّب) / بَسِيط, غَيْر مُعَقَّد (يفتقر إلى التعقيد)",
 "uncomplimentary": "ذم, غير مجامل (يميل إلى (أو يهدف إلى) الانتقاص أو الاستخفاف) / غير جذاب, غير لائق (يظهر أو يمثل بشكل غير مواتٍ)\nمثال: صورة غير جذابة (تظهر العيوب)",
 "uncompounded": "بَسِيط, غَيْرُ مُرَكَّب (لا يشكّل مركّبًا؛ غير ممزوج)",
 "uncomprehended": "غَيْر مُسْتَوْعَب (غير مفهوم بشكل كامل)",
 "uncomprehending": "عَاجِز عَنِ الفَهْم, غَيْر مُسْتَوْعِب (يَفْتَقِر إِلَى الفَهْم)",
 "uncomprehensible": "غامض, غير مفهوم (صعب الفهم)\nمثال: الشيء الأكثر غموضاً (عدم قابلية للفهم) في الكون هو أنه قابل للفهم",
 "uncompromising": "صارم, لا هوادة فيه (لا يقدم تنازلات)\nمثال: اتخذ موقفاً متشدداً في محادثات السلام",
 "uncompromisingly": "بشكل صارم, بلا هوادة (بطريقة لا تقبل المساومة)",
 "unconcealed": "ظاهر, غير مخفي (غير مخفي أو مستتر)\nمثال: عداؤها المكشوف سمم الجو",
 "unconcern": "برود, لا مبالاة (سمة البقاء هادئاً وعدم الاكتراث؛ نقص عرضي في الاهتمام) / عدم اكتراث (شعور بعدم الاهتمام)",
 "unconcerned": "غير مبالٍ, غير مكترث (يفتقر إلى الاهتمام أو الرعاية أو الشعور) / غَيْرُ مُنْشَغِل, غَيْرُ مُهْتَمّ (لَيْسَ مُنْشَغِلًا أَوْ مُنْخَرِطًا فِي أَمْرٍ مَا) / غَيْرُ مُبَالٍ, غَيْرُ مُكْتَرِث (مرتاح النفس؛ غير قلق)",
 "unconcernedly": "بلا مبالاة (بطريقة غير مبالية)\nمثال: كانت الحرب تندلع في أوروبا، لكنها خططت لقضاء عطلة بلا مبالاة",
 "unconditional": "غَيْر مَشْرُوط (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "unconditional surrender": "استسلام غير مشروط",
 "unconditionality": "إِطْلَاق, لَا مَشْرُوطِيَّة (خاصية أو حالة كون الشيء مطلقاً؛ أي بدون شروط أو قيود أو تحفظات أو مؤهلات)",
 "unconditionally": "بشكل قاطع, بشكل مطلق (بطريقة غير مشروطة) / بِلَا شُرُوط, دُونَ قَيْد (غير خاضع لشرط)\nمثال: نفى التهم بشكل قاطع",
 "unconditioned": "غير مشروط, مطلق (غير مقيد بشروط) / غريزي, غير شرطي (لم يتم تثبيته عن طريق الاشتراط أو التعلم)\nمثال: استسلام غير مشروط",
 "unconditioned reflex": "رد فعل منعكس, منعكس (رد فعل تلقائي غريزي غير متعلم لمحفز)",
 "unconfessed": "غَيْر مُعْتَرَف بِه (لم يُعتَرف به أو يُقَرّ به) / غير المعترفين (الناس الذين لم يعترفوا (بذنوبهم))\nمثال: لا يمكن مسامحة غير المعترفين",
 "unconfined": "طليق, غير مقيد (غير محبوس أو مقيد) / طَلِيق, غَيْر مَحْبُوس (غَيْر خَاضِع لِلْحَبْس أَوِ التَّقْيِيد الجَسَدِيّ)",
 "unconfirmed": "غير مؤكد (لم يتم إقراره أو تسويته نهائياً)\nمثال: خطاب اعتماد غير مؤكد",
 "unconformable": "غَيْرُ مُطَابِقٍ (غَيْرُ مُتَوَافِقٍ أَوْ مُتَطَابِقٍ)",
 "unconformist": "خارج عن العرف, غير ممتثل (لا يمتثل لبعض المعايير أو الأنماط السلوكية أو الفكرية المقبولة اجتماعياً)\nمثال: سلوكهم غير الممتثل بشدة جعلهم أسطوريين",
 "unconfused": "صَافِي الذِّهْن, غَيْر مُرْتَبِك (غير متحيّر من المواقف أو الأقوال المتناقضة)",
 "uncongenial": "غَيْرُ مُلَائِم, مُتَنَافِر ((يُقال عن أصول النباتات) غير قابل للتطعيم) / غير متوافق, غير ملائم (غير مناسب لأذواقك أو احتياجاتك) / غَيْر مُلَائِم, مُعَادٍ (غير ملائم للحياة أو النموّ إطلاقاً)\nمثال: كان رفقاء الغرفة غير المتوافقين يتشاجرون دائماً",
 "uncongeniality": "تنافر, عدم انسجام (الميل لعدم التوافق) / تَنَافُر, عَدَم انْسِجَام (صفة كون الشيء غير سار أو غير متوافق)",
 "unconnected": "مُبَعْثَر, مُشَوَّش (يفتقر إلى الاستمرارية المنظمة) / غير متصل, منفصل (غير مربوط أو غير مرتبط معاً) / غَيْرُ مُتَّصِلٍ (ليست له صلة بالولادة أو العائلة)",
 "unconnectedness": "انْفِصَال, عَدَم التَّرَابُط (عدم وجود صلة بين الأشياء)",
 "unconquerable": "عصي على القهر, لا يقهر (غير قابل للقهر أو الهزيمة أو التغلب عليه) / عَصِيّ, لَا يُقْهَر (لا يمكن التغلب عليه أو تجاوزه)\nمثال: تحية لشجاعته ؛ وإرادته التي لا تقهر",
 "unconquered": "غَيْرُ مَغْلُوب, لَمْ يُقْهَر (لَمْ يُغْلَبْ أَوْ يُقْهَر)",
 "unconscientious": "غير حي الضمير, غير مكترث (ليس حي الضمير)",
 "unconscientiousness": "عدم اكتراث, موت الضمير (سمة عدم الاجتهاد أو الحذر) / انعدام الضمير (صفة الاستعداد لتجاهل إملاءات الضمير)",
 "unconscionable": "بَاهِظ, فَاحِش (يَتَجَاوَزُ حُدُودَ المَعْقُولِ وَالاعْتِدَالِ بِكَثِير) / بِلَا وَازِع, عَدِيمُ الضَّمِير (يفتقر إلى الضمير والوازع الأخلاقيّ)",
 "unconscious": "فاقد الوعي, لاواعٍ (غير واعٍ؛ يفتقر إلى الوعي والقدرة على الإدراك الحسي كما لو كان نائماً أو ميتاً) / لَا وَاعٍ (بِدُونِ إِرَادَةٍ وَاعِيَة) / عقل لاواعي, لاوعي (ذلك الجزء من العقل الذي يحدث فيه النشاط النفسي الذي لا يدركه الشخص)\nمثال: مستلقٍ فاقداً للوعي على الأرض",
 "unconscious mind": "عقل لاواعي, لاوعي (ذلك الجزء من العقل الذي يحدث فيه النشاط النفسي الذي لا يدركه الشخص)",
 "unconscious process": "عملية لاواعية (عملية عقلية لا تدركها بشكل مباشر)\nمثال: عملية الإنكار",
 "unconsciously": "لَاشُعُورِيًّا",
 "unconsciousness": "فِقْدَان اَلْوَعْي, إِغْمَاء",
 "unconsecrated": "غَيْرُ مُقَدَّس, مُدَنَّس (غير مقدّس لأنّه لم يُكرَّس أو لكونه نجسًا أو مدنَّسًا)",
 "unconsidered": "غَيْرُ مُتَرَوٍّ, مُتَسَرِّع (بِدُونِ تَفْكِيرٍ أَوْ تَأَمُّلٍ كَافٍ)",
 "unconsolable": "بائس, غير قابل للمواساة (حزين لدرجة لا يمكن معها المواساة؛ غير قادر على تلقي العزاء)\nمثال: مفجوعة عند وفاة ابنها",
 "unconsolidated": "سَائِب, غَيْرُ مُتَمَاسِك (رخو وغير مُطَبَّق أو متماسك)",
 "unconstipated": "غير مصاب بالإمساك, منتظم الإخراج (غير مصاب بالإمساك)",
 "unconstitutional": "غَيْرُ دُسْتُورِيّ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "unconstitutionality": "عَدَم دُسْتُورِيَّة (الفقدان ونقيض الوجود؛ يجب عدم فعل كذا: أي يجب الامتناع عن الفعل)\nمثال: عليك عدم الخوف.",
 "unconstitutionally": "بشكل غير دستوري (بطريقة مخالفة للدستور)\nمثال: تصرف الرئيس بشكل غير دستوري",
 "unconstrained": "بِلَا قُيُود, غَيْر مُقَيَّد (مُتَحَرِّر مِنْ أَيِّ قَيْد)",
 "unconstraint": "تهتك, جموح (سمة الافتقار للتحفظ أو السيطرة؛ حرية متهورة من الكبت أو القلق)\nمثال: رقصت بجموح",
 "unconstricted": "غير متضيق, غير منقبض (غير منقبض جسدياً أو بالتبعية نفسياً)\nمثال: شرايين سليمة غير متضيقة",
 "unconstructive": "غَيْر بَنَّاء, هَدَّام (ليس بنَّاءً؛ لا يُسهِم في التحسين)",
 "unconsumed": "غَيْر مُسْتَهْلَك (لم يتم استهلاكه)",
 "unconsummated": "غير متمم, غير مدخول به (لم يتم إتمامه (خاصة في الزواج))\nمثال: الزواج غير المدخول به يمكن فسخه",
 "uncontaminated": "غَيْرُ مُلَوَّث (خالٍ من الاختلاط بعناصر ضارّة؛ نظيف) / غير ملوث, نقي (غير فاسد بسبب الاتصال أو الاختلاط)\nمثال: لا توجد ثقافة غير ملوثة بالاتصال بالعالم الخارجي",
 "uncontaminating": "غَيْر مُلَوِّث, نَظِيف (لا ينشر التلوث أو التلوث الإشعاعي خاصة)\nمثال: وقود نظيف",
 "uncontested": "غير متنازع عليه (غير متنازع عليه ولم يجعل موضوعاً للمنافسة)\nمثال: سلطة غير متنازع عليها",
 "uncontrived": "تلقائي, عفوي (ليس بتصميم أو تصنع؛ غير قسري وارتجالي)\nمثال: جو من الكلام العفوي التلقائي غالباً ما يتم تحقيقه بجهد شاق",
 "uncontrollable": "جَامِح, لَا يُمْكِنُ كَبْحُهُ (يَسْتَحِيلُ قَمْعُهُ أَوِ السَّيْطَرَةُ عَلَيْه) / لَا يُمْكِنُ السَّيْطَرَةُ عَلَيْه, مُسْتَعْصٍ (غَيْرُ قَابِلٍ لِلسَّيْطَرَةِ أَوِ الإِدَارَة) / جَامِح, مُتَمَرِّد (لا يمكن السيطرة عليه أو إخضاعه) / عَصِيّ عَلَى الحَلّ, لَا يُمْكِن السَّيْطَرَة عَلَيْه (صعب الحل أو التخفيف منه)",
 "uncontrollably": "بجنون, بشكل لا يمكن السيطرة عليه (بطريقة غير منضبطة)\nمثال: ضحكت بشكل لا يمكن السيطرة عليه",
 "uncontrolled": "خارج عن السيطرة, غير منضبط (غير خاضع للسيطرة؛ خارج السيطرة)\nمثال: أكبر مشكلة صحية غير مسيطر عليها هي الإيدز",
 "uncontroversial": "غير مثير للجدل (من غير المرجح أن يثير الجدل)",
 "uncontroversially": "بِلَا خِلَاف, دُونَ جَدَل (لا ينطوي على أي جدل)",
 "unconventional": "خارج عن المألوف, غير تقليدي (غير مطابق للقواعد أو المعايير المقبولة) / غير تقليدي, متحرر (غير تقليدي أو غير مساير للأعراف) / غَيْرُ تَقْلِيدِيّ, غَيْرُ مَشْرُوعٍ (لا يتوافق مع القانون أو الأعراف الاجتماعية)\nمثال: ملابسها وتسريحة شعرها غير التقليدية",
 "unconventionality": "لَا تَقْلِيدِيَّة (الخروج عن المألوف بحكم كون الشيء غير تقليدي) / خروج عن المألوف, عدم التقليدية (الأصالة بحكم كونها غير تقليدية)",
 "unconventionally": "بشكل غير تقليدي (بطريقة غير تقليدية)\nمثال: تتصرف دائماً بشكل غير تقليدي إلى حد ما",
 "unconverted": "غَيْرُ مُقْتَنِعٍ, غَيْرُ مُهْتَدٍ (لم يتحول أو يقتنع)",
 "unconvertible": "غير قابل للاستبدال, غير قابل للتحويل (يستخدم خاصة للعملات؛ غير قادر على أن يتم استبداله أو مقايضته بعملة أخرى ذات قيمة مساوية)",
 "unconvinced": "غَيْر مُقْتَنِع (يفتقر إلى القناعة)\nمثال: ما زلت غير مقتنع",
 "unconvincing": "غير مقنع, واهٍ (ليس مقنعاً) / غَيْر مُقْنِع, مُسْتَبْعَد (ذو احتمالية منخفضة جداً لا تبعث على التصديق)\nمثال: حجة واهية",
 "unconvincingly": "بشكل غير مقنع (بطريقة غير مقنعة)\nمثال: جادل بشكل غير مقنع",
 "uncooked": "غَيْرُ مَطْبُوخ (لَمْ يُطْهَ)",
 "uncool": "غَيْر رَائِج, مُمِلّ ((عامية) غير عصري وممل)",
 "uncooperative": "غَيْر مُتَعَاوِن (غير متعاون عَمْدًا) / غير متعاون (غير راغب في التعاون)\nمثال: شاهد غير متعاون",
 "uncoordinated": "غَيْر مُنَسَّق الحَرَكَة (يفتقر إلى التفاعل الماهر والفعّال للحركات العضلية) / غَيْر مُنَسَّق (يفتقر للتخطيط والتنظيم التعاوني)",
 "uncordial": "غَيْر وَدُود (يَفْتَقِرُ إِلَى الدِّفْء أَوِ الوُدّ)",
 "uncorrectable": "لَا يُمْكِنُ السَّيْطَرَةُ عَلَيْه, مُسْتَعْصٍ (غَيْرُ قَابِلٍ لِلسَّيْطَرَةِ أَوِ الإِدَارَة)",
 "uncorrected": "غير مصحح (تُرك معيباً أو خاطئاً) / غَيْرُ مُؤَدَّب, غَيْرُ مُصَحَّح (لم يخضع للتأديب أو التصحيح)\nمثال: لابؤرية (استجماتيزم) غير مصححة",
 "uncorrelated": "غَيْرُ مُتَرَابِطٍ (لا يتغير بالتوازي مع غيره)",
 "uncorroborated": "غَيْر مُؤَيَّد بِأَدِلَّة, غَيْر مُوَثَّق (غير مدعوم بأدلة أخرى)",
 "uncorrupted": "سَلِيم, غَيْرُ مُفْسَد (لَمْ يَتَدَنَّ أَوْ يَنْحَطّ) / سَلِيم, غَيْرُ فَاسِد (لَمْ يَتَحَلَّلْ أَوْ يَتَعَفَّن) / صَافٍ, غَيْر مُشَوَّه ((في اللغة) لم تُنتقَص نقاوته أو جودته)",
 "uncounted": "لَا يُحْصَى, لَا يُعَدّ (أَكْثَر مِنْ أَنْ يُحْصَى أَوْ يُعَدّ)",
 "uncoupled": "مَفْصُولُ الوَصْلَةِ (فُكَّتْ وَصْلَتُهُ أَوِ ارْتِبَاطُهُ)",
 "uncousinly": "غَيْر وُدِّيّ, مُجَافٍ (لا يليق بابن العم)",
 "uncouth": "فَظّ",
 "uncouthly": "بفظاظة, بقلة ذوق (بطريقة فظة وغير مهذبة)\nمثال: سرد بفظاظة قصصاً جعلت كل من على الطاولة يشمئز",
 "uncouthness": "جَلَافَة, غَلَاظَة (انعدام الأناقة بسبب كون الشخص غليظاً وجلفاً)",
 "uncovered": "غَيْر مُغَطًّى, مَكْشُوف (غير مغطى بالملابس)",
 "uncovering": "اكتشاف, كشف (فعل اكتشاف شيء ما) / تعرية, كشف (إزالة الغطاء)",
 "uncrannied": "أَمْلَس, غَيْر مُتَصَدِّع (بدون شقوق أو صدوع)",
 "uncreased": "خَالٍ مِنَ التَّجَاعِيدِ ((يُستخدم خاصّة للأقمشة) بلا تجاعيد أو ثنايا)",
 "uncreated": "أَزَلِيّ, قَدِيم",
 "uncreative": "غير مبدع (ليس مبدعاً)\nمثال: خيال غير مبدع",
 "uncreativeness": "افتقار للإبداع (نقص الإبداع)",
 "uncritical": "أعمى (في الاتباع), غير انتقادي (غير ناقد؛ لا يميل إلى البحث عن الأخطاء أو لفت الانتباه إليها) / غير ممحص, غير نقدي (يتميز بتجاهل المعايير أو الإجراءات النقدية)\nمثال: معجب مخلص وتقريباً غير انتقادي (أعمى)",
 "uncritically": "بشكل غير نقدي, دون تمحيص (بطريقة تفتقر للنقد أو التمحيص)\nمثال: قبل قراراتها دون تمحيص",
 "uncropped": "غَيْر مُسْتَغَلّ زِرَاعِيًّا (لا يُستخدم لزراعة المحاصيل)",
 "uncrossed": "غير متقاطع, مبسوط (غير متقاطع) / غير مسطر ((عن الشيك) غير مسطر)\nمثال: تجلس باحتشام وساقاها غير متقاطعتين",
 "uncrowded": "خالٍ, غير مزدحم (يحتوي على أو يتيح مساحة كافية)\nمثال: قطار غير مزدحم",
 "uncrowned": "بلا تاج, غير متوج (غير مزود (خاصة ليس بعد) بتاج) / غير متوج (ليس لديه تاج (اصطناعي) على السن؛ يستخدم بشكل خاص للأضراس والضواحك)\nمثال: الملك غير المتوج",
 "uncrystallised": "عَدِيم الشَّكْل, لَابَلُّورِيّ (بِدُون شَكْلٍ بَلُّورِيٍّ حَقِيقِيٍّ أَوْ ظَاهِر) / غير متبلور (لم يتشكل بشكل نهائي أو محدد)\nمثال: أفكار غير متبلورة",
 "uncrystallized": "عَدِيم الشَّكْل, لَابَلُّورِيّ (بِدُون شَكْلٍ بَلُّورِيٍّ حَقِيقِيٍّ أَوْ ظَاهِر) / غير متبلور (لم يتشكل بشكل نهائي أو محدد)\nمثال: أفكار غير متبلورة",
 "unction": "مسحة مقدسة (المسح بالزيت كجزء من احتفال ديني أو طقس شفاء) / بلسم, مرهم (مستحضر شبه صلب (يحتوي عادة على دواء) يطبق خارجياً كعلاج أو لتهدئة تهيج) / تملق, مداهنة (الجدية المفتعلة المليئة بالرضا عن الذات والتملق لخدمة المصالح الشخصية) / تملق لزج, نفاق (مجاملات مفرطة ولكن سطحية تُعطى بسحر متصنع)",
 "unctuous": "لَزِج, مُتَمَلِّق بِكَرَاهَة (مُبَالِغ فِي اللُّطْف بِشَكْل مُنَفِّر وَبَغِيض)",
 "unctuously": "بتملق, بنفاق (بطريقة متملقة)",
 "unctuousness": "تملق, مداهنة (الجدية المفتعلة المليئة بالرضا عن الذات والتملق لخدمة المصالح الشخصية)",
 "uncultivable": "غَيْر صَالِح لِلزِّرَاعَة (لا يصلح للزراعة أو الفلاحة)",
 "uncultivatable": "غَيْر صَالِح لِلزِّرَاعَة (لا يصلح للزراعة أو الفلاحة)",
 "uncultivated": "سَطْحِيّ, غَيْرُ مُثَقَّف (يتصف بعدم التهذيب الثقافي أو افتقار الذوق الفكري) / بور, غير مزروع ((للأرض أو الحقول) غير معدة لزراعة المحاصيل) / سَاذَجٌ, غَيْرُ مُثَقَّفٍ ((عن الأشخاص) يفتقر إلى الثقافة أو المعرفة)",
 "uncultured": "سَاذَجٌ, غَيْرُ مُثَقَّفٍ ((عن الأشخاص) يفتقر إلى الثقافة أو المعرفة)",
 "uncurbed": "جَامِح, مُنْفَلِت (غير مكبوح أو غير مسيطَر عليه)",
 "uncured": "غَيْرُ مُعَالَج (لم يُعالج أو يُجفَّف)",
 "uncurled": "غَيْرُ مُجَعَّد ((عَنِ الشَّعْرِ) لَمْ يُجَعَّدْ) / غَيْر مُجَعَّد, مَفْرُود (غير مجعد أو ملتف)",
 "uncurtained": "بلا ستائر, غير مستور (غير مزود بستائر)\nمثال: نوافذ فارغة وبلا ستائر حدقت بها",
 "uncurved": "بِلَا انْحِنَاء, غَيْر مُنْحَنٍ (ليس به انحناءات أو تقوسات)",
 "uncurving": "بِلَا انْحِنَاء, غَيْر مُنْحَنٍ (ليس به انحناءات أو تقوسات)",
 "uncus": "معقف ((أحياء) أي نتوء أو جزء خطافي الشكل)",
 "uncut": "غَيْر مُختَصَر, كَامِل (كامل بلا حذف أو اختصار) / سليم, غير مقطوع (لم يتم قطعه) / غير مفصول الصفحات, غير مقصوص ((عن صفحات كتاب) تكون الأوراق المتجاورة لا تزال متصلة عند الحافة الأمامية) / خام, غير مصقول (لم يتم تشكيله عن طريق القطع أو التشذيب)\nمثال: كتاب أوراقه لا تزال غير مفصولة",
 "undamaged": "سليم, غير تالف (لم يلحق به أذى أو تلف؛ صحيح)",
 "undatable": "غير قابل للتأريخ (لا يمكن تحديد تاريخه)",
 "undated": "بِلَا تَارِيخ, غَيْرُ مُؤَرَّخ (لا يحمل تاريخاً)",
 "undaunted": "غَيْر مُرْتَاع, لَا يَهَاب (شُجَاع بِعَزْمٍ رَاسِخ) / لَا يَرْتَدِعُ, لَا يَهَابُ (لا يتزعزع في عزمه وهدفه)",
 "undecagon": "أحد عشري الأضلاع (مضلع له أحد عشر ضلعاً)",
 "undeceived": "مُتَحَرِّرٌ مِنَ الوَهْم (تحرّر من فكرة خاطئة أو مُضلِّلة)",
 "undecidable": "غَيْرُ قَابِلٍ لِلْبَتِّ (لَا يُمْكِنُ الحُكْمُ عَلَيْهِ بِأَنَّهُ مُشْتَقٌّ أَوْ غَيْرُ مُشْتَقٍّ مِنْ بَدِيهِيَّاتِ نِظَامٍ مَنْطِقِيٍّ)",
 "undecideable": "غَيْرُ قَابِلٍ لِلْبَتِّ (لَا يُمْكِنُ الحُكْمُ عَلَيْهِ بِأَنَّهُ مُشْتَقٌّ أَوْ غَيْرُ مُشْتَقٍّ مِنْ بَدِيهِيَّاتِ نِظَامٍ مَنْطِقِيٍّ)",
 "undecided": "غَيْر مَحْسُوم (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به) / مُتَرَدِّد\nمثال: أنا غير متفاجئ.",
 "undecipherable": "صَعْب فَكّ تَشْفِيرَة",
 "undecipherably": "بخط غير مقروء, بشكل مبهم (بطريقة غير مقروءة)\nمثال: هذا الطالب يكتب بخط غير مقروء",
 "undeciphered": "غير مفكك الشفرة, مستعصٍ (لم يتم فك شفرته)\nمثال: النظام الخطي أ لا يزال غير مفكك الرموز",
 "undeclared": "غير معلن (غير مصرح به أو معترف به علانية)\nمثال: خوض حرب غير معلنة",
 "undecomposable": "غَيْر قَابِل لِلتَّحْلِيل (يُمثِّل أقصى حدّ ممكن من التحليل أو التقسيم)",
 "undecomposed": "سَلِيم, غَيْر مُتَحَلِّل (لَمْ يَتَحَلَّل أَوْ يَتَعَفَّن)",
 "undecorated": "بَسِيط, غَيْر مُزَيَّن (غير مزين بشيء لزيادة جماله أو تميزه)",
 "undecylenic acid": "حمض الأنديسيلينيك (حمض يعد مكوناً من مكونات العرق)",
 "undedicated": "غير مخصص, غير مكرس (غير مكرس أو مخصص لغرض معين)\nمثال: اكتمل الملعب ولكنه لا يزال غير مكرس (غير مفتتح رسمياً)",
 "undefeated": "بلا هزيمة, غير مهزوم (منتصر (لم يهزم))\nمثال: غير مهزوم في المعركة",
 "undefendable": "غَيْرُ مُدَافَعٍ عَنْه, مَكْشُوف (غَيْرُ مُحَصَّنٍ أَوْ غَيْرُ قَابِلٍ لِلدِّفَاعِ عَنْه)",
 "undefended": "غَيْرُ مُدَافَعٍ عَنْه, مَكْشُوف (غَيْرُ مُحَصَّنٍ أَوْ غَيْرُ قَابِلٍ لِلدِّفَاعِ عَنْه)",
 "undeferential": "غَيْرُ مُحْتَرِم (لا يُظهِر الاحترام اللائق)",
 "undefiled": "صَافٍ, غَيْر مُشَوَّه ((في اللغة) لم تُنتقَص نقاوته أو جودته) / بِلَا دَنَس, نَقِيّ (خالٍ من الشوائب أو العيوب الأخلاقية)",
 "undefinable": "عَصِيٌّ عَلَى الوَصْف, غَيْرُ قَابِلٍ لِلتَّعْرِيف (لَا يُمْكِنُ وَصْفُهُ أَوْ تَحْدِيدُهُ بِدِقَّة؛ يَصْعُبُ التَّعْبِيرُ عَنْهُ بِالكَلِمَات)",
 "undefined": "غامض, غير محدد (غير محدود أو مقرر أو مميز بدقة)\nمثال: مصطلح غير محدد (مبهم)",
 "undelineated": "غير محدد, غير موصوف (لم يتم تمثيله بدقة أو تحديده)",
 "undemanding": "سهل, غير متطلب (يتطلب القليل من الصبر أو الجهد أو المهارة إن وجد)\nمثال: كان الأجر كافياً والوظيفة غير متطلبة",
 "undemocratic": "غير ديمقراطي (لا يتفق مع أو لا يتوافق مع العقيدة أو الممارسة أو المثل الديمقراطية)\nمثال: قطعت النقابة علاقتها بإجراءاتها غير الديمقراطية السابقة",
 "undemocratically": "بشكل غير ديمقراطي (بطريقة غير ديمقراطية)\nمثال: اتخذ جميع القرارات المهمة بشكل غير ديمقراطي دون زملائه",
 "undemonstrative": "غير معبر عن المشاعر, متحفظ (لا يميل إلى التعبير الصريح عن العاطفة)",
 "undeniable": "لا جدال فيه, لا يمكن إنكاره (لا يمكن نفيه أو دحضه)",
 "undeniably": "بلا ريب, مما لا يمكن إنكاره (إلى درجة لا يمكن إنكارها أو بطريقة لا تقبل الإنكار)\nمثال: هي بلا ريب الطالبة الأكثر موهبة في الصف",
 "undenominational": "غَيْر مُنْتَمٍ لِطَائِفَة (غير مرتبط بترويج طائفة أو مذهب بعينه)",
 "undependability": "عدم الاعتمادية, عدم الموثوقية (سمة عدم كون الشخص أو الشيء جديراً بالاعتماد أو الثقة)",
 "undependable": "غير موثوق, لا يعول عليه (لا يستحق الاعتماد أو الثقة) / غَيْر مَوْثُوق, لَا يُعْتَمَد عَلَيْه (مُحْتَمَل أَنْ يَكُون خَاطِئًا أَوْ مُضَلِّلًا)\nمثال: في أوائل الخمسينيات كانت الحواسيب كبيرة ومكلفة وغير موثوقة",
 "undependableness": "عدم الاعتمادية, عدم الموثوقية (سمة عدم كون الشخص أو الشيء جديراً بالاعتماد أو الثقة)",
 "undependably": "بِخِيَانَة, بِدُون إِخْلَاص (بطريقة تفتقر إلى الأمانة أو الاعتمادية)",
 "undepicted": "غَيْرُ مُصَوَّر (لَمْ يُصَوَّرْ أَوْ يُرْسَم)",
 "under": "تَحْتَ (أَقَلَّ)\nمثال: أنا تحت الشجرة.",
 "under arms": "تحت السلاح, مدججاً بالسلاح (مسلح ومستعد للقتال)",
 "under someone's nose": "واضح, جَلِيّ",
 "under the circumstances": "في ظل الظروف الراهنة, نظراً للظروف (بسبب الظروف السائدة)\nمثال: في ظل الظروف الراهنة لا أستطيع شراء المنزل",
 "under the influence": "تَحْتَ اَلتَّأْثِير (أَقَلَّ)\nمثال: أنا تحت الشجرة.",
 "under the weather": "عَلِيل, مُتَوَعِّك (يعاني من وعكة صحّيّة خفيفة أو معرَّض للمرض)",
 "under way": "قَيْد التَّنْفِيذ, قَيْد الحَرَكَة (في حالة حركة؛ بدأ في التحرك)\nمثال: تحركت السفينة",
 "under-the-counter": "تَحْتَ الطَّاوِلَة (يُباع خُفْيَةً بِشَكْل غَيْر قانونِيّ)",
 "under-the-table": "خَلْفَ الكَوَالِيس, سِرِّيّ (مُصَمَّمٌ وَمُنَفَّذٌ بِسِرِّيَّةٍ أَوْ بِشَكْلٍ سِرِّيّ)",
 "underachievement": "أداء دون المستوى, تقصير (أداء أضعف من المتوقع (أقل مما كان يمكن التنبؤ به من اختبارات الذكاء))",
 "underachiever": "طالب متعثر (طالب لا يؤدي بشكل جيد كما هو متوقع أو كما يشير معدل ذكائه)",
 "underactive": "قَلِيل النَّشَاط (أقلّ نشاطًا من المعتاد بشكل غير طبيعيّ)",
 "underage": "قَاصِر",
 "underarm": "من تحت الذراع (مع أرجحة اليد تحت مستوى الكتف) / من أسفل الذراع (مع تقديم اليد ورفعها من تحت مستوى الكتف)\nمثال: رمي الكرة من تحت الذراع",
 "underbelly": "بطن, خاصرة رخوة (جودة كون الشيء ضعيفاً أو غير محمي) / أسفل البطن, بطن (البطن اللين أو الجانب السفلي من جسم الحيوان) / بطن, جانب سفلي (الجانب السفلي)\nمثال: الخاصرة الرخوة للمحور",
 "underbodice": "بروتيل, قميص داخلي نسائي (رداء داخلي قصير بلا أكمام للنساء)",
 "underbody": "أسفل البطن, بطن (البطن اللين أو الجانب السفلي من جسم الحيوان)",
 "underboss": "نائب الزعيم (مساعد أو الرجل الثاني لرئيس (خاصة في عصابات الجريمة))",
 "underbred": "رَدِيءُ السُّلَالَة (من سلالة مختلطة أو متدنّية) / سَيِّئُ التَّرْبِيَةِ, قَلِيلُ الْأَدَبِ ((عن الأشخاص) يفتقر إلى الرقة أو اللباقة)",
 "underbrush": "أحراش, شجيرات تحتية (الشجيرات (الأشجار الصغيرة والشجيرات والسراخس وما إلى ذلك) التي تنمو تحت الأشجار الأطول في غابة أو حرش)",
 "undercarriage": "عجلات هبوط, هيكل سفلي (إطار يعمل كدعامة لجسم المركبة)",
 "undercharge": "شحنة غير كافية, شحنة ناقصة (شحنة غير كافية) / تسعير منخفض, سعر بخس (سعر منخفض جداً)",
 "underclass": "الطبقة الدنيا, الطبقة المسحوقة (الطبقة الاجتماعية الأدنى في التسلسل الهرمي الاجتماعي)",
 "underclassman": "طالب مبتدئ (طالب جامعي ليس في السنة النهائية بعد)",
 "underclothed": "شَحِيح اللِّبَاس, شِبْه عَارٍ (يرتدي ملابس غير كافية)",
 "underclothes": "ثياب داخلية, ملابس داخلية (رداء داخلي يلبس مباشرة على الجلد وتحت الملابس الخارجية)",
 "underclothing": "ثياب داخلية, ملابس داخلية (رداء داخلي يلبس مباشرة على الجلد وتحت الملابس الخارجية)",
 "undercoat": "فَرْو تَحْتِيّ, وَبَر (فراء ناعم وكثيف يقع تحت شعر الحماية الأطول والأخشن) / بطانة, طلاء أولي (الطبقة الأولى أو التمهيدية من الطلاء أو الغراء المطبق على سطح ما) / عازل سفلي (عازل يتكون من طبقة من القطران أو مادة تشبه المطاط على الجانب السفلي للمركبة لتأخير التآكل)",
 "undercoated": "مَطْلِيُّ الهَيْكَلِ السُّفْلِيّ ((في المركبات) مطليّ بمادّة القطران أو مادّة أخرى مضادّة للصدأ على الهيكل السفلي)",
 "undercover": "خَفِيّ, سِرِّيّ (يُجْرَى بِأَهْدَافٍ أَوْ أَسَالِيبَ خَفِيَّة)",
 "undercover agent": "جاسوس, عميل سري ((عسكرية) عميل سري تستأجره دولة للحصول على معلومات عن أعدائها أو شركة للحصول على أسرار صناعية من المنافسين)",
 "undercover operation": "عملية تخفي, عملية سرية (عملية تنطوي على عمل سري داخل مجتمع أو مؤسسة)",
 "undercover work": "تجسس, عمل سري (فعل المراقبة السرية لأغراض استخباراتية)",
 "undercurrent": "معنى مبطن, نبرة خفية (جودة عاطفية خفية تكمن وراء الكلام؛ معنى ضمني) / تيار تحتي (تيار تحت سطح سائل)",
 "undercut": "قطع تحتي (قطع يتم في الجانب السفلي لإزالة مادة) / ضربة مقطوعة, قص ((رياضة) ضربة تضع دوراناً عكسياً على الكرة) / حز التوجيه, قطع تحتي (حز يُقطع في جذع الشجرة لتحديد اتجاه سقوطها) / تندرلوين, فيليه الظهر (اللحم الطري لعضلة الخاصرة على جانبي العمود الفقري)\nمثال: الضربات المقطوعة لا تزعج لاعب التنس الجيد",
 "underdeveloped": "مُتَخَلِّف",
