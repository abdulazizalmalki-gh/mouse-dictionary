 "undesirably": "بشكل غير مرغوب فيه (بطريقة غير مرغوب فيها)\nمثال: كان ودوداً بشكل غير مرغوب فيه",
 "undesired": "غَيْرُ مَرْغُوب, غَيْرُ مَنْشُود (غير مرغوب فيه ولا مطلوب)",
 "undesiring": "زاهد, غير راغب (لا يملك أو لا يشعر بأي رغبة)\nمثال: رجل منعزل جداً، غير راغب تماماً في المناصب العامة",
 "undesirous": "زاهد, غير راغب (لا يملك أو لا يشعر بأي رغبة)\nمثال: رجل منعزل جداً، غير راغب تماماً في المناصب العامة",
 "undestroyable": "غَيْرُ قَابِلٍ لِلتَّدْمِير (لَا يُمْكِنُ تَدْمِيرُه) / بَاقٍ, عَصِيّ عَلَى الفَنَاء (يدوم مدّة طويلة جدًّا)",
 "undetectable": "خَفِيّ, غَيْرُ مَحْسُوس (بِالكَادِ يُمْكِنُ إِدْرَاكُه) / غَيْرُ قَابِلٍ لِلْكَشْف (لَا يُرَى بِسُهُولَة)",
 "undetected": "غير مرصود, غير مكتشف (لم يتم إدراكه أو تمييزه)\nمثال: خشوا وجود أثر غير مكتشف للسم",
 "undeterminable": "غير قابل للتحديد (غير قادر على أن يتم تقريره أو التأكد منه بشكل قاطع)",
 "undetermined": "غير محدد, غير مقرر (غير محدد أو مقرر بدقة؛ غير ثابت أو معروف مسبقاً) / غير محدد, مجهول (لم يتم التأكد منه أو تحديده بعد) / غَيْر مَحْسُوم, مَفْتُوح (لم يُبَتّ فيه بعد؛ قابل لمزيد من التفكير والنقاش)\nمثال: من عمر غير محدد",
 "undeterred": "غَيْرُ مُثَبَّطٍ, لَا يُثْنَى (لا يردعه شيء عن المضي قدماً)",
 "undeveloped": "غير متطور, غير نامٍ (لم يتطور أو ينضج أو يكتمل صياغته) / غير مستغل, غير مطور (لم يتم تطويره أو تحسينه أو استغلاله أو استخدامه)\nمثال: كانت دورات التصميم الداخلي نادرة وغير متطورة",
 "undeviating": "ثَابِت, لَا يَحِيد (يُسْتَخْدَمُ لِلقِيَمِ وَالمَبَادِئ؛ لَا يَتَغَيَّرُ وَلَا يَنْحَرِف) / ثَابِت الِاتِّجَاه, لَا يَحِيد (يَسِير مُبَاشَرَةً مِنْ نُقْطَة إِلَى أُخْرَى بِدُون انْحِرَاف)",
 "undiagnosable": "غَيْر قَابِل لِلتَّشْخِيص (لا يمكن تشخيصه)",
 "undiagnosed": "غَيْر مُشَخَّص (يستعصي على التشخيص)",
 "undies": "ملابس داخلية نسائية (ملابس داخلية للنساء)",
 "undifferentiated": "غير متمايز, متجانس (غير متمايز)",
 "undigested": "غَيْر مَهْضوم (لَمْ يَتِمّ هَضْمُه بَعْد) / غَيْر مَهْضُوم ذِهْنِيًّا (لم يُفكَّر فيه ويُرتَّب بشكل منهجي في العقل؛ لم يُستوعَب ذهنياً)",
 "undignified": "غير وقور, مبتذل (يفتقر إلى الوقار أو الكرامة)",
 "undiluted": "صافٍ, غير مخفف (لم يتم تخفيفه)\nمثال: حليب غير مخفف",
 "undiminished": "غَيْرُ مُتَنَاقِص, لَا يَخِفّ (لَمْ يَنْقُصْ وَلَمْ تَتَرَاجَعْ شِدَّتُه)",
 "undimmed": "سَاطِع, غَيْر مُعْتِم (لم يُجعل معتماً أو أقل سطوعاً)\nمثال: مصابيح أمامية غير مخفتة (ساطعة)",
 "undine": "أوندين (أي من أرواح المياه الأنثوية المختلفة)",
 "undiplomatic": "غير دبلوماسي, غير لبق (غير ماهر في التعامل مع الآخرين)",
 "undiplomatically": "بشكل غير دبلوماسي (بدون دبلوماسية)\nمثال: رفضت الدعوة بشكل غير دبلوماسي",
 "undirected": "تَائِه, هَائِم (يسير بلا وجهة ولا اتّجاه محدّد)",
 "undirected graph": "رسم بياني غير موجه (في الرياضيات، رسم بياني لا يكون للحواف فيه اتجاه)",
 "undiscerning": "ضعيف التمييز, غير فطن (يفتقر إلى الفطنة والتمييز)",
 "undischarged": "غَيْر مُنْفَجِر (لا يَزال قابِلًا لِلاِنْفِجار أَوْ الإِطْلاق) / غَيْرُ مُسَدَّد, مُسْتَحَقّ (مُسْتَحَقٌّ كَدَيْن)",
 "undiscipline": "تسيب, عدم انضباط (سمة الافتقار للانضباط)",
 "undisciplined": "غَيْرُ مُنْضَبِط, فَاقِدُ الانْضِبَاط (يَفْتَقِرُ إِلَى الانْضِبَاطِ أَوِ السَّيْطَرَة) / غَيْرُ مُؤَدَّب, غَيْرُ مُصَحَّح (لم يخضع للتأديب أو التصحيح) / غَيْرُ مُنْضَبِط (لم يخضع للانضباط أو التأديب)",
 "undisclosed": "غَيْرُ مَكْشُوف, غَيْرُ مُعْلَن (لَمْ يُفْصَحْ عَنْهُ أَوْ يُعْلَن)",
 "undiscouraged": "غَيْرُ مُثَبَّطٍ, لَا يُثْنَى (لا يردعه شيء عن المضي قدماً)",
 "undiscoverable": "غَيْرُ قَابِلٍ لِلتَّحَقُّق (لَا يُمْكِنُ التَّأَكُّدُ مِنْهُ؛ يُقَاوِمُ الاكْتِشَاف)",
 "undiscovered": "غَيْر مُكْتَشَف (لم يُكتشَف بعد) / غَيْر مُكْتَشَف (لم يُكتَشَف بعد)",
 "undiscriminating": "غير ذواق, غير مميز (غير قادر على التمييز أو الانتقاء)",
 "undisguised": "غَيْرُ مُقَنَّع, مَكْشُوف (وَاضِحٌ لِلْعِيَان)",
 "undismayed": "لَا يَرْتَدِعُ, لَا يَهَابُ (لا يتزعزع في عزمه وهدفه)",
 "undisputable": "لَا جِدَال فِيه, لَا يُنَازَع (لَا يَقْبَلُ الطَّعْنَ أَوِ الشَّكّ؛ صَحِيحٌ بِوُضُوح)",
 "undisputed": "بِلَا مُنَازِع, مُسَلَّمٌ بِه (مُتَّفَقٌ عَلَيْهِ عُمُومًا؛ لَا يَخْضَعُ لِلنِّزَاع)",
 "undisputedly": "بشكل قاطع, بلا جدال (بطريقة لا تقبل الجدل أو النزاع)\nمثال: أنت تكتب كما لو أن هذه الحقيقة، وإن كانت تدينني بلا جدال بالانضمام إلى صفوف البوهيمية، إلا أنها أكسبتني حق الدخول إلى أي رفقة",
 "undissolved": "غَيْرُ مُذَاب, غَيْرُ مُنْحَلّ (مُحْتَفِظٌ بِشَكْلِهِ الصُّلْب)",
 "undistinguishable": "غير متمايز, لا يمكن تمييزه (غير قادر على أن يتم تمييزه أو التفريق بينه وبين غيره)\nمثال: العينتان في الواقع مختلفتان عن بعضهما البعض لكن الاختلافات تكاد لا يمكن تمييزها",
 "undistinguished": "عَادِيّ, غَيْر مُمَيَّز (ليس مميزاً بأي شكل؛ يفتقر للتميز)",
 "undistorted": "غَيْرُ مُحَرَّف, غَيْرُ مُشَوَّه (بلا تحريف أو تشويه)",
 "undistributed": "غَيْر مُوَزَّع ((عَنِ الِاسْتِثْمَارَات) غَيْر مُوَزَّع عَلَى أَوْرَاق مَالِيَّة مُتَنَوِّعَة)",
 "undisturbed": "غَيْرُ مُزْعَج (لا يقلقه تدخل أو إزعاج)",
 "undiversified": "غير متنوع, غير منوع (غير متنوع)",
 "undividable": "غَيْر قَابِل لِلقِسْمَة (لَا يُمْكِن قِسْمَتُه بِدُون بَاقٍ)",
 "undivided": "غَيْرُ مُقَسَّم, مُوَحَّد (غير مُجزَّأ إلى أقسام أو حصص؛ يشكّل وحدة غير مقسّمة) / حَصْرِيّ, مُوَحَّد (غَيْرُ مُقَسَّمٍ بَيْنَ أَكْثَرَ مِنْ هَدَفٍ أَوْ غَرَضٍ وَاحِدٍ) / غَيْر مُقَسَّم, غَيْر مُوَزَّع (غير مشترك مع الآخرين أو موزَّع بينهم) / غَيْرُ مُنْقَسِم (لم يُفرِّقه خلاف في الرأي)",
 "undivided interest": "حق غير مقسم, ملكية مشاعة (المصلحة في الممتلكات المملوكة لمستأجرين حيث يكون لكل مستأجر حق متساوٍ في التمتع بالممتلكات بالكامل)",
 "undivided right": "حق غير مقسم, ملكية مشاعة (المصلحة في الممتلكات المملوكة لمستأجرين حيث يكون لكل مستأجر حق متساوٍ في التمتع بالممتلكات بالكامل)",
 "undoable": "بَعِيد المَنَال, مُسْتَحِيل التَّحْقِيق (يستحيل تحقيقه أو بلوغه)",
 "undocumented": "بدون وثائق, غير موثق (يفتقر إلى الوثائق اللازمة (مثل إذن العيش أو العمل في بلد ما))\nمثال: أجانب غير موثقين (بدون أوراق رسمية)",
 "undoer": "مخرب, مدمر (شخص يدمر أو يخرب) / حَالّ, فَاكّ (شخص يفك أو يفتح شيئاً ما) / غاوٍ, مُفسد (مغوي يتسبب في خراب امرأة)\nمثال: مدمر للبيئة",
 "undogmatic": "حُرّ الفِكْر, لَاعَقَائِدِيّ (يَرْفُض الانْصِيَاع لِلسُّلْطَة أَوِ العَقِيدَة الجَامِدَة (خَاصَّةً فِي الدِّين))",
 "undogmatical": "حُرّ الفِكْر, لَاعَقَائِدِيّ (يَرْفُض الانْصِيَاع لِلسُّلْطَة أَوِ العَقِيدَة الجَامِدَة (خَاصَّةً فِي الدِّين))",
 "undoing": "حل, فك (إرخاء الأربطة التي تثبت شيئاً ما) / إبطال, إلغاء (فعل يجعل فعلاً سابقاً بلا تأثير (كما لو لم يتم))\nمثال: ربط ربطات العنق فن؛ أما فكها فهو سهل",
 "undomestic": "غير بيتوتي, غير منزلي (غير منزلي أو غير مرتبط بالبيت)\nمثال: أسست نفسها في حياتها المهنية على حساب كونها غير بيتوتية لدرجة أنها لم تكن تعرف حتى كيفية إشعال الفرن",
 "undomesticated": "غَيْرُ أَلِيفٍ لِلْبَيْت (غَيْرُ مُعْتَادٍ عَلَى الحَيَاةِ المَنْزِلِيَّةِ) / غَيْرُ مُدَجَّن (لَمْ يَتِمَّ تَدْجِينُه)",
 "undone": "غَيْرُ مُنْجَز (لَمْ يُنْجَزْ أَوْ لَمْ يُؤَدَّ) / مُفَكَّك, مُنْهَار (أُلقي في حالة من التفكك أو عدم الترابط) / مَحْلُول, مَفْكُوك (غير مربوط أو مشدود أو مؤمّن) / مُنْتَهٍ, هَالِك (محكوم عليه بالفناء والزوال)",
 "undoubtedly": "بلا شك, من دون شك (بدون شك؛ بالتأكيد)\nمثال: إنه بلا شك جميل جداً",
 "undrained": "غير مُجفف, غير مُصرَّف (لم يتم تصريف محتواه)\nمثال: الحفاظ على الأراضي الرطبة: إبقاؤها غير مجففة",
 "undramatic": "غير درامي, غير مثير (يفتقر إلى القوة والجودة الدرامية)\nمثال: تحرك بقوة هادئة وسلوك غير درامي",
 "undramatically": "بشكل غير درامي (بطريقة تفتقر إلى الدراما أو الإثارة)",
 "undraped": "بِلَا سَتَائِر (يفتقر للستائر أو الأغطية المعلقة) / عَارٍ, مَنْزُوعُ السِّتَار (مُجَرَّدٌ مِنَ السُّتُورِ أَوِ الأَغْطِيَة)",
 "undrawn": "غَيْرُ مَرْسُوم (لَمْ يُمَثَّلْ فِي رَسْم)",
 "undreamed": "غَيْرُ مُتَخَيَّل, لَا يَخْطُرُ عَلَى بَال (لم يُتَخَيَّل حتى في الأحلام)",
 "undreamed of": "غَيْرُ مُتَخَيَّل, لَا يَخْطُرُ عَلَى بَال (لم يُتَخَيَّل حتى في الأحلام)",
 "undreamt": "غَيْرُ مُتَخَيَّل, لَا يَخْطُرُ عَلَى بَال (لم يُتَخَيَّل حتى في الأحلام)",
 "undreamt of": "غَيْرُ مُتَخَيَّل, لَا يَخْطُرُ عَلَى بَال (لم يُتَخَيَّل حتى في الأحلام)",
 "undress": "تَعَرَّى, اِنْجَرَدَ / تَعَرَّى",
 "undressed": "خَالِع مَلَابِسَهُ, مُتَعَرٍّ (أزال عنه الملابس) / غَيْرُ مُعَالَج ((عَنِ الخَشَبِ أَوِ الحَجَرِ أَوِ الجُلُودِ) لَمْ يُشَطَّبْ أَوْ يُعَالَجْ)",
 "undried": "غَيْر جَافّ, لَمْ يَجِفّ بَعْد (لا يزال رطبًا ولم يجفّ)",
 "undrinkable": "غير صالح للشرب (غير مناسب للشرب)",
 "undue": "غَيْر مُسْتَحَقّ (لم يحن موعد استحقاقه بعد) / زَائِد, غَيْر مُنَاسِب (غير مناسب أو غير لائق (أو حتى قانوني) في الظروف الحالية) / غَيْرُ مَعْقُول, مُفْرِط (يَتَجَاوَزُ الحُدُودَ الطَّبِيعِيَّة) / غَيْرُ مُبَرَّرٍ, غَيْرُ مُسَوَّغٍ (يفتقر إلى التبرير أو التفويض)\nمثال: قرض غير مستحق",
 "undulant": "تموجي (يشبه الأمواج في الشكل أو المحيط أو الحركة)",
 "undulant fever": "حمى مالطية, حمى متموجة (مرض بكتيري معد يصيب البشر ينتقل عن طريق الاتصال بالحيوانات المصابة أو اللحوم أو منتجات الألبان المصابة؛ يتميز بالحمى والصداع)",
 "undulate": "مُتَمَوِّج (ذو حافة متموّجة وسطح مُجَعَّد)",
 "undulation": "تموج, موجة ((في الفيزياء) حركة صعود وهبوط أو جيئة وذهاباً) / تموج (حركة تشبه الموج؛ ارتفاع وانخفاض لطيف بطريقة الأمواج) / تموج, موجة (منحنى متموج)",
 "undulatory": "تموجي (يشبه الأمواج في الشكل أو المحيط أو الحركة)",
 "undulatory theory": "نظرية موجية ((فيزياء) النظرية القائلة بأن الضوء ينتقل كموجات)",
 "unduly": "بشكل مفرط, بغير حق (بدرجة غير مبررة)\nمثال: كانت متشائمة بشكل مفرط بشأن مستقبلها",
 "undutiful": "عَاقّ, غَيْرُ بَارّ (يفتقر إلى الاحترام أو الطاعة الواجبة)",
 "undutifulness": "تقصير في الواجب, عقوق (عدم التقوى التي تتميز بعدم الإخلاص للواجب)",
 "undyed": "غَيْر مَصْبُوغ, غَيْر مُبَيَّض (لم يُلوَّن أو يُبيَّض صناعيًّا)",
 "undying": "خَالِد أَبَدًا, لَا يَمُوت (لا يموت أبدًا؛ باقٍ إلى الأبد)",
 "undynamic": "خامل, غير ديناميكي (يتميز بغياب القوة أو الحيوية)",
 "uneager": "غير متحمس, فاتر الهمة (يفتقر إلى الاهتمام أو الروح أو الحيوية)\nمثال: أشياء واهية وباهتة وغير متحمسة",
 "unearned": "غير مستحق, غير مكتسب (لم يتم الحصول عليه عن طريق الجدارة أو العمل أو الخدمة)\nمثال: قبل المكافآت غير المكتسبة التي جاءت في طريقه وكذلك النقد غير المستحق",
 "unearned income": "إيراد غير مكتسب ((محاسبة) دخل تم استلامه ولكن لم يتم اكتسابه بعد (يعتبر عادة التزاماً حالياً في الميزانية العمومية للشركة)) / دخل غير مكتسب (دخل شخصي لم تكسبه (على سبيل المثال، أرباح الأسهم أو الفوائد أو دخل الإيجار))",
 "unearned increment": "زيادة غير مكتسبة (ارتفاع غير مكتسب في القيمة السوقية للممتلكات ناتج عن عوامل السوق العامة)",
 "unearned revenue": "إيراد غير مكتسب ((محاسبة) دخل تم استلامه ولكن لم يتم اكتسابه بعد (يعتبر عادة التزاماً حالياً في الميزانية العمومية للشركة)) / دخل غير مكتسب (دخل شخصي لم تكسبه (على سبيل المثال، أرباح الأسهم أو الفوائد أو دخل الإيجار))",
 "unearned run": "ركضة غير مكتسبة (ركضة سُجلت نتيجة لخطأ من الفريق الآخر)",
 "unearthly": "خَارِق, غَرِيب (يوحي بعمل قوى خارقة للطبيعة) / رُوحَانِيّ, رُوحِيّ (مُتَعَلِّقٌ بِالرُّوحِ أَوِ النَّفْسِ أَوْ مُؤَثِّرٌ فِيهِمَا)",
 "unease": "عدم ارتياح, قلق (سمة عدم الارتياح) / اعتلال, توعك (انزعاج جسدي (كمرض خفيف أو اكتئاب))",
 "uneasily": "بتوجس, بقلق (مع قلق أو توجس)\nمثال: راقبنا بقلق",
 "uneasiness": "تململ, قلق (عدم القدرة على الراحة أو الاسترخاء أو السكون) / عدم ارتياح, قلق (سمة عدم الارتياح) / ارتباك, وعي مفرط بالذات (إحراج نابع من الشعور بأن الآخرين يراقبونك بشكل نقدي) / توتر, قلق (مشاعر القلق التي تجعلك متوتراً وسريع الانفعال)",
 "uneasy": "مُتَوَتِّر جَسَدِيّاً (متعلق بقلق جسدي يسبب عدم الارتياح) / غَيْر مُرْتَاح, مُرْتَبِك (يشعر بعدم الارتياح الاجتماعي؛ غير واثق ومتحفظ) / غير مرتاح, قلق (يفتقر إلى الشعور بالأمان أو لا يوفر راحة أو طمأنينة) / غير مريح, قلق (يفتقر أو لا يوفر راحة جسدية أو عقلية)\nمثال: كان المزارعون قلقين حتى نزل المطر أخيراً",
 "uneatable": "غير صالح للأكل (غير مناسب كطعام)",
 "uneconomic": "غَيْرُ اقْتِصَادِيّ (مُهْدِرٌ لِلمَوَارِد)",
 "uneconomical": "مُبَذِّر, مُسْرِف (غير كفء في استخدام الوقت والجهد والموارد) / غَيْرُ اقْتِصَادِيّ (مُهْدِرٌ لِلمَوَارِد)",
 "unedifying": "غير تهذيبي (غير مفيد من الناحية الأخلاقية أو الفكرية)",
 "unedited": "غَيْر مُحَرَّر (لم يُغيَّر عن طريق التحرير)",
 "uneducated": "جاهل, غير متعلم (لا يمتلك تعليماً جيداً)",
 "uneducated person": "جاهل, غير متعلم (شخص يفتقر للمعرفة)",
 "uneffective": "غير فعال, غير مؤثر (لا ينتج تأثيراً مقصوداً)\nمثال: معلم غير فعال",
 "unelaborate": "غَيْر مُتَقَن, غَيْر مُعَقَّد (يفتقر إلى التفاصيل الغنيّة أو المعقّدة)",
 "unelaborated": "سَطْحِيّ, مُوجَز (يقتصر على النقاط الرئيسية فقط؛ يفتقر إلى الاكتمال)",
 "unembarrassed": "غَيْر مُحْرَج, غَيْر مُرْتَبِك (لا يشعر بالحرج أو الارتباك)",
 "unembellished": "خَالٍ مِنَ الزَّخْرَفَة, سَادَة (يفتقر إلى التزيين أو الزخرفة)",
 "unembodied": "بِلَا جَسَد, غَيْرُ مُتَجَسِّد (لَيْسَ لَهُ جَسَدٌ مَادِّيّ)",
 "unemotional": "كَتُوم, مُتَحَفِّظ (بَارِدٌ وَرَسْمِيٌّ فِي أُسْلُوبِهِ) / جامد المشاعر, غير عاطفي (غير قابل للتأثر أو مجرد من العاطفة أو لا يظهر أي عاطفة)",
 "unemotional person": "جَلِد, رَوَاقِيّ (شخص يبدو غير مبالٍ بالعواطف)",
 "unemotionality": "تبلد عاطفي, جمود (غياب العاطفة) / برود عاطفي, جمود (اللامبالاة التي تظهر من خلال غياب ردود الفعل العاطفية)",
 "unemotionally": "بجمود, بلا عاطفة (بدون عاطفة)\nمثال: حدق المتهم بلا عاطفة في عائلة الضحية",
 "unemphatic": "بِلَا تَشْدِيد, غَيْر مُؤَكَّد (لا يُنطَق بتأكيد أو تشديد)",
 "unemployable": "غير قابل للتوظيف (غير مقبول للتوظيف كعامل)\nمثال: أميته جعلته غير قابل للتوظيف",
 "unemployed": "مُتَبَطِّل, مُتَبَطِّلَة",
 "unemployed people": "عاطلون, عاطلون عن العمل (الناس الذين هم خارج العمل قسراً (يُعتبرون كمجموعة))\nمثال: العاطلون عن العمل لفترة طويلة يحتاجون إلى المساعدة",
 "unemployed person": "عاطل عن العمل (شخص بلا وظيفة)",
 "unemployment": "بِطَالَة, بَطَالَة",
 "unemployment compensation": "تعويض البطالة (مدفوعات من وكالة حكومية أمريكية للأشخاص العاطلين عن العمل)",
 "unemployment line": "طابور البطالة (طابور من الناس ينتظرون التوظيف أو إعانة البطالة)",
 "unemployment rate": "مُعَدَّل البَطَالَة (النسبة المئوية للقوى العاملة العاطلة عن العمل في أي تاريخ معين)",
 "unenclosed": "غير محاط, غير مغلق (غير مقفول عليه أو محاط أو متضمن)\nمثال: شرفة مفتوحة",
 "unencouraging": "غَيْرُ مُشَجِّع (لا يبعث على التشجيع)",
 "unencumbered": "خالٍ من الأعباء, غير مثقل (خالٍ من الأعباء أو العوائق) / خَالٍ مِنَ الأَعْبَاء, طَلِيق (غير مُثقَل بالهموم أو المسؤوليات)\nمثال: ورث تركة غير مثقلة (بالديون)",
 "unended": "بِلَا نِهَايَة, غَيْرُ مُخْتَتَم (لَمْ يَنْتَهِ؛ يَفْتَقِرُ إِلَى نِهَايَةٍ أَوْ خَاتِمَةٍ)",
 "unending": "أَبَدِيّ, أَزَلِيّ (مستمرّ إلى الأبد أو إلى أجل غير مُسمًّى)",
 "unendingly": "بِلَا انْقِطَاع, بِلَا تَوَقُّف (بعزيمة لا تكل)\nمثال: الرقص يلهمه بلا توقف للسعي أعلى وأعلى نحو قمة الكمال المشرقة",
 "unendowed": "غير مزود, غير موهوب (غير مجهز أو مزود)\nمثال: غير موهوب بالعبقرية",
 "unendurable": "غير محتمل, لا يطاق (لا يمكن تحمله أو الصبر عليه)\nمثال: درجة لا تطاق من العاطفية",
 "unenergetic": "خامل, فاتر (يفتقر إلى اليقظة أو النشاط) / بَطِيء, مُتَرَاخٍ (لا يميل إلى المبادرة أو الاجتهاد)\nمثال: أصبحت الضفادع خاملة مع أول ليالي البرد",
 "unenergetically": "بخمول, بلا طاقة (بدون طاقة؛ بطريقة خاملة)\nمثال: تسكع في المنزل بخمول",
 "unenforceable": "غير قابل للتنفيذ (لا يمكن فرضه؛ غير قادر على تحقيقه بالإجبار)\nمثال: قانون غير قابل للتنفيذ",
 "unenforced": "غير مطبق, غير مفروض (غير مطبق؛ غير مجبر خاصة عن طريق القانون أو إجراءات الشرطة)\nمثال: الكثير من القوانين غير المطبقة يمكن أن تولد ازدراء للقانون",
 "unengaged": "حُرّ, غَيْر مَخْطُوب (لم يُعطِ وعدًا بالزواج؛ غير مرتبط) / غَيْر مَشْغُول, فَارِغ (غَيْر مُنْشَغِل؛ حُرّ ومُتَاح)",
 "unenlightened": "جاهل, غير مستنير (ليس مستنيراً؛ جاهل) / سَاذَج, غَيْرُ مُوَجَّه (يفتقر إلى المعلومات أو التوجيه)\nمثال: الوسائل التي حفظ بها الرجال غير المستنيرين النظام الاجتماعي غير العادل",
 "unenlightening": "غير تهذيبي (غير مفيد من الناحية الأخلاقية أو الفكرية) / غير تنويري, مبهم (يفشل في الإعلام أو التوضيح)\nمثال: تعليق غير موضح",
 "unenlightenment": "ظلامية, عدم استنارة (الافتقار إلى الفهم)",
 "unenlivened": "غَيْر مُنْتَعِش (لم يصبح حيوياً أو مشرقاً)\nمثال: حياة غير مفعمة بالرومانسية",
 "unenterprising": "غير مقدام, مفتقر للمبادرة (يفتقر إلى روح المبادرة؛ ليس جريئاً أو مغامراً)",
 "unenthusiastic": "غير متحمس, فاتر (غير متحمس؛ يفتقر إلى الإثارة أو الحماسة)\nمثال: أداء غير متحمس (فاتر) للأوركسترا",
 "unenthusiastically": "بفتور, دون حماس (بدون حماس)\nمثال: فتح الأطفال الهدايا بفتور",
 "unentitled": "بِلَا حَقّ, غَيْرُ مُسْتَحِقّ (لا يملك حقاً أو استحقاقاً)",
 "unenviable": "لَا يُحْسَدُ عَلَيْه (غَيْرُ مَرْغُوبٍ إِلَى حَدٍّ لَا يُثِيرُ الحَسَد) / حَرِج, مُحْرِج (صَعْب التَّعَامُل مَعَهُ؛ يُسَبِّب أَلَمًا أَوْ إِحْرَاجًا)",
 "unequal": "غَيْر كَافٍ, غَيْر مُلَائِم (لفتقار إلى الصفات أو الموارد اللازمة لتلبية مهمة ما) / غير متساوٍ, متفاوت (سيء التوازن أو التوافق في الكمية أو القيمة أو القياس)\nمثال: تدريب غير كافٍ",
 "unequaled": "فَرِيدٌ مِنْ نَوْعِه, لَا يُضَاهَى (مُتميّز جذريًّا وليس له مثيل أو نظير)",
 "unequalised": "غَيْرُ مُسَوًّى (لم يُجعَل متساوياً)",
 "unequalized": "غَيْرُ مُسَوًّى (لم يُجعَل متساوياً)",
 "unequalled": "فَرِيدٌ مِنْ نَوْعِه, لَا يُضَاهَى (مُتميّز جذريًّا وليس له مثيل أو نظير)",
 "unequally": "بشكل غير عادل, بشكل غير متكافئ (بطريقة غير متساوية أو متحيزة)\nمثال: تم توزيع الأرباح بشكل غير متكافئ",
 "unequipped": "غير مُجهَّز (بدون المعدات المادية أو الفكرية اللازمة)\nمثال: رجال عصابات غير مجهزين لمعركة ضارية",
 "unequivocal": "صريح, قاطع (لا يقبل الشك أو سوء الفهم؛ له معنى أو تفسير واحد فقط ويؤدي إلى استنتاج واحد فقط) / قَاطِع, لَا لَبْس فِيه (مُحَدَّد أو مُصَاغ بوضوح تام)\nمثال: دليل قاطع",
 "unequivocally": "بشكل لا لبس فيه, بوضوح تام (بطريقة واضحة تماماً)\nمثال: أعلنت نواياها بشكل لا لبس فيه",
 "unequivocalness": "عَدَم لَبْس, وُضُوح قَاطِع (الوضوح المتحقق بتجنب الغموض)",
 "unerasable": "رَاسِخ, لَا يُمْحَى (لا يمكن إزالته أو محوه)",
 "unerect": "غير منتصب (ليس في وضع مستقيم أو وضعية قائمة)",
 "unerring": "لَا يُخْطِئ, مُصِيب دَائِمًا (غَيْر قَابِل لِلخَطَأ؛ دَقِيق دَائِمًا)",
 "unerringly": "بِدِقَّة لَا تُخْطِئ, بِلَا خَطَأ (دون ارتكاب أخطاء)\nمثال: أصلح الأمور لنا بدقة لا تخطئ",
 "unesco": "يُونِسْكُو (مُنَظّمة الأمم المتحدة للتَّربية والعلوم والثَّقافة، والمقرّ الرَّئيسيّ لها باريس…)",
 "unessential": "ثانوي, غير أساسي (ليس أساسياً أو جوهرياً)",
 "unestablished": "غير راسخ, غير مثبت (غير راسخ أو مؤسس)\nمثال: سمعة لم تترسخ بعد",
 "unethical": "غير أخلاقي (غير مطابق للمعايير المعتمدة للسلوك الاجتماعي أو المهني)\nمثال: ممارسات تجارية غير أخلاقية",
 "unethically": "بشكل غير أخلاقي, لا أخلاقياً (بطريقة تتنافى مع الأخلاق)\nمثال: لقد تصرف بشكل غير أخلاقي",
 "uneven": "غَيْرُ مُنْتَظِمٍ, مُتَفَاوِت (يَفْتَقِرُ إِلَى الِاتِّسَاقِ وَالِانْتِظَامِ) / غَيْرُ مُتَكَافِئ ((عن مسابقة أو متنافسين) غير متكافئ كخصوم) / غير مستوٍ, متفاوت (غير مستوٍ أو غير منتظم كما في الشكل أو الملمس) / فردي (لا يقبل القسمة على اثنين)\nمثال: لون غير منتظم",
 "uneven bars": "المتوازي مختلف الارتفاع, عارضتان غير مستويتين (زوج من القضبان المتوازية مثبتة على ارتفاعات مختلفة؛ تستخدم في جمباز السيدات)",
 "uneven parallel bars": "المتوازي مختلف الارتفاع, عارضتان غير مستويتين (زوج من القضبان المتوازية مثبتة على ارتفاعات مختلفة؛ تستخدم في جمباز السيدات)",
 "unevenly": "بتفاوت, بشكل غير مستوٍ (بطريقة غير مستوية وغير منتظمة) / بشكل غير عادل, بشكل غير متكافئ (بطريقة غير متساوية أو متحيزة) / بشكل غير منتظم, بشكل متقطع (بطريقة متقطعة وغير مستوية)\nمثال: تم توزيع الأرباح بشكل غير متكافئ",
 "unevenness": "تَفَاوُت, عَدَم اسْتِوَاء (صفة عدم التوازن) / تَبَايُن, تَفَاوُت (صفة كون الشيء غير مستوٍ وتنقصه الوحدة)",
 "uneventful": "خالٍ من الأحداث, رتيب (يتميز بعدم وجود أحداث جديرة بالملاحظة أو هامة)\nمثال: حياة خالية من الأحداث",
 "uneventfully": "بهدوء, دون حوادث (بطريقة خالية من الأحداث)\nمثال: هبط مكوك الفضاء بهدوء",
 "unexacting": "غَيْرُ صَارِم, مُتَسَامِح (لَا يَتَّسِمُ بِالصَّرَامَةِ أَوِ التَّشَدُّد)",
 "unexampled": "غَيْر مَسْبُوق, لَا مَثِيل لَهُ (لا يوجد له مثال أو سابقة أو نظير من قبلُ)",
 "unexceeded": "لَا نَظِير لَهُ, لَا يُضَاهَى (لا يمكن تحسينه أو التفوق عليه)",
 "unexcelled": "لَا نَظِير لَهُ, لَا يُضَاهَى (لا يمكن تحسينه أو التفوق عليه)",
 "unexceptionable": "لَا غُبَار عَلَيْه, لَا يُعتَرَض عَلَيْه (مقبول تمامًا؛ لا يُمكن الاعتراض عليه أو انتقاده)",
 "unexceptional": "عَادِيّ, غَيْر مُمَيَّز (ليس مميزاً بأي شكل؛ يفتقر للتميز)",
 "unexchangeability": "عَدَم قَابِلِيَّة لِلتَّبَادُل (صفة العجز عن التبادل أو الاستبدال)",
 "unexchangeable": "غير قابل للاستبدال, غير قابل للتحويل (يستخدم خاصة للعملات؛ غير قادر على أن يتم استبداله أو مقايضته بعملة أخرى ذات قيمة مساوية) / غير قابل للاستبدال (غير مناسب للاستبدال)",
 "unexcitable": "غير قابل للإثارة, هادئ الطبع (لا يسهل إثارته)\nمثال: مزاج هادئ",
 "unexcited": "غير مثار, هادئ (غير مثار)\nمثال: أجرى تقييماً هادئاً (غير منفعل) للموقف",
 "unexciting": "غير مثير, ممل (غير مثير) / غير محفز, ممل (لا يثير أو ينشط)\nمثال: رواية غير مثيرة",
 "unexcitingly": "برتابة, بشكل غير مثير (بطريقة لا تبعث على الإثارة)\nمثال: لم تكن هذه اللوحة سوى قماش رمادي غير مثير مع بضع بقع حمراء",
 "unexclusive": "غَيْر حَصْرِيّ, غَيْر مُقَيَّد (غير محصور أو مقيَّد بفئة معيّنة)",
 "unexcused": "بِلَا عُذْر, غَيْر مُعْذَر (لم يُمنح عذرًا أو استثناءً)",
 "unexhausted": "غير مستنفد, غير ناضب (لم يستهلك بالكامل)\nمثال: بئر غير ناضبة",
 "unexpansive": "غير تمددي, غير توسعي (لا يظهر ميلاً للتمدد) / غَيْرُ مُنْفَتِح, مُتَحَفِّظ (لا يميل إلى الحماس الشديد أو الانفعال)\nمثال: أجسام غير تمددية",
 "unexpected": "مُفَاجِئ",
 "unexpectedly": "بالصدفة, عرضياً (بدون تخطيط مسبق) / بشكل غير متوقع, فجأة (بطريقة لم تكن متوقعة)\nمثال: التقيا بالصدفة",
 "unexpectedness": "مُبَاغَتَة, مُفَاجَأَة (الاستثنائية بحكم كون الشيء غير متوقع)\nمثال: مفاجأة الترحيب الحار",
 "unexpendable": "غير قابل للاستهلاك, لا يمكن التضحية به (غير مناسب للاستهلاك)",
 "unexpended": "فَائِض, مُتَبَقٍّ (لم يُسْتَهْلَك بعد) / غَيْر مُنْفَق ((عن الموارد المالية) لم يُنْفَق بعد)",
 "unexpired": "سارٍ, غير منتهي الصلاحية (لم ينتهِ أو يُلغَ بمرور الوقت)\nمثال: انتخب لملء فترة السيناتور غير المنتهية",
 "unexplainable": "غَيْر مُفَسَّر, لَا يُعَلَّل (لا يمكن تعليله أو تفسيره)",
 "unexplained": "غَيْر مُوَضَّح (لم يتم توضيح سببه أو علته) / غَيْر مُفَسَّر (لم يُفسَّر أو يُوضَّح)",
 "unexploded": "غَيْر مُنْفَجِر (لا يَزال قابِلًا لِلاِنْفِجار أَوْ الإِطْلاق)",
 "unexploited": "غير مستغل, غير مطور (لم يتم تطويره أو تحسينه أو استغلاله أو استخدامه)\nمثال: موارد طبيعية هائلة غير مستغلة (أو غير مطورة)",
 "unexplorative": "غير استكشافي (ليس استكشافياً)",
 "unexploratory": "غير استكشافي (ليس استكشافياً)",
 "unexplored": "غَيْر مُكْتَشَف (لم يُكتشَف بعد)",
 "unexportable": "غير قابل للتصدير (غير مناسب للتصدير)",
 "unexpressed": "غَيْر مُعَبَّر عَنْه, مَسْكُوت عَنْه (لم يُصَرَّح به أو يُفْصَح عنه)",
 "unexpressible": "لا يمكن التعبير عنه, لا يوصف (يتحدى التعبير)",
 "unexpressive": "جَامِدُ المَلَامِح, عَدِيمُ التَّعْبِير (متعمّد عدم إظهار أيّ تعبير أو انفعال على وجهه)",
 "unexpurgated": "غَيْر مُنَقَّح, كَامِل (لم تُحذف منه أيّ مواد)",
 "unextended": "غير ممدود (غير ممتد أو مبسوط)\nمثال: ذراع غير ممدودة",
 "unfaceted": "غير مضلع (يفتقر إلى الأوجه)\nمثال: جوهرة غير مضلعة",
 "unfading": "دَائِم, لَا يَذْبُل (كزهرة خيالية لا تذبل أبدًا؛ خالد لا يزول)",
 "unfailing": "لَا يَفْتُر, لَا يَكِلّ (لَا يَعْرِفُ الكَلَلَ أَوِ الفُتُورَ) / دَائِم العَطَاء, لَا يَنْقَطِع (قادر دائماً على تقديم المزيد) / لَا يُخْطِئ, مَضْمُون (غَيْر قَابِل لِلفَشَل؛ مُحْكَم)",
 "unfailingly": "دائماً, دون فشل (بدون فشل)",
 "unfair": "ظالم, غير عادل (غير عادل؛ يتميز بالظلم أو التحيز أو الخداع)\nمثال: استخدم أساليب غير عادلة",
 "unfairly": "بِإِجْحَاف, بِظُلْم (بطريقة غير عادلة)\nمثال: تعاملوا معه بظلم",
 "unfairness": "ظُلْم (الثَلَاثُ الظُلَم: الليلة التاسعة عشر، والعشرون، والحادية والعشرون من كل شهر قمري، وسميت بذلك لظلمتها. يسبقها الثلاث الدُرَع ويليها الثلاث الحنادس)\nمثال: نحن نرفض الظلم.",
 "unfaithful": "كَافِر / خَائِن (الشخص الذي قام بالخِيَانَة)\nمثال: نمر مفترس أمامك خير من خائن ورائك!",
 "unfaithfully": "بِخِيَانَة, بِدُون إِخْلَاص (بطريقة تفتقر إلى الأمانة أو الاعتمادية)",
 "unfaithfulness": "خِيَانَة",
 "unfaltering": "ثَابِتٌ, رَاسِخٌ (يتميز بعزيمة راسخة لا تتزعزع)",
 "unfalteringly": "بتصميم, بعزم (مع تصميم؛ بطريقة مصممة)\nمثال: تشبث بالماضي بتصميم",
 "unfamiliar": "غَيْر مَأْلُوف (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "unfamiliarity": "عَدَم أُلْفَة, غَرَابَة (الغرابة نتيجة لعدم كون الشيء معروفاً جيداً)",
 "unfashionable": "غير مواكب للموضة, قديم الطراز (لا يتفق مع أو لا يتبع الموضة الحالية) / خَارِج المُوضَة, غَيْر عَصْرِيّ (غير رائج ويُعتبر غير جذاب أو قديم الطراز)\nمثال: ملابس غير عصرية",
 "unfashionably": "بشكل غير مساير للموضة, بشكل قديم الطراز (بطريقة غير عصرية)\nمثال: بدت وكأنها تتعمد ارتداء ملابس غير مسايرة للموضة",
 "unfastened": "غَيْر مَرْبُوط, مَحْلُول (غير مربوط) / مَفْكُوك الأَزْرَار (غير مزرر) / مفتوح (يتيح الدخول والخروج دون عوائق؛ غير مغلق) / غير موصد, محلول (غير مغلق أو غير مؤمن)\nمثال: التقطت الريح حاشية معطفها مفكوك الأزرار",
 "unfastener": "حَالّ, فَاكّ (شخص يفك أو يفتح شيئاً ما)\nمثال: الأطفال موهوبون في فك أربطة أحذيتهم",
 "unfastening": "حل, فك (إرخاء الأربطة التي تثبت شيئاً ما)\nمثال: ربط ربطات العنق فن؛ أما فكها فهو سهل",
 "unfastidious": "غير مدقق, غير مكترث (يتميز بغياب الرعاية المناسبة أو الاهتمام بالتفاصيل؛ غير مهتم بالنظافة) / غير متطلب (غذائياً) (غير دقيق في المتطلبات الغذائية)\nمثال: غير مكترثة بملبسها",
 "unfathomable": "غَيْرُ قَابِلٍ لِلسَّبْر (يستحيل فهمه واستيعابه بالكامل) / سَحِيق, لَا قَرَار لَهُ (يُشْبِهُ الهَاوِيَةَ فِي عُمْقِهِ؛ عَمِيقٌ جِدًّا لَا يُمْكِنُ قِيَاسُهُ) / عميق جداً, لا يسبر غوره (عن العمق؛ غير قادر على أن يسبر أو يقاس)",
 "unfathomed": "سَحِيق, غَوْر (يَقَعُ فِي عُمْقٍ كَبِيرٍ أَوْ يَمْتَدُّ إِلَيْهِ؛ أَعْمَقُ مِنْ أَنْ يُسْبَرَ)",
 "unfattened": "غَيْرُ مُسَمَّن ((عَنْ حَيَوَانَاتِ السُّوقِ) لَيْسَ فِي الحَالَةِ المُثْلَى لِلتَّسْوِيقِ)",
 "unfavorable": "ضَارّ, غَيْر مُفِيد (ينطوي على أو يخلق ظروفاً تضر بالنجاح أو الفعالية) / غير مؤاتٍ, معاكس ((عن الرياح أو الطقس) تميل إلى الإعاقة أو المعارضة) / سلبي, غير مؤيد (غير مشجع أو غير موافق أو غير مبهج)\nمثال: نتيجة غير مواتية",
 "unfavorable judgment": "انْتِقَاد, نَقْد (التعبير عن عدم الرضا من خلال الإشارة إلى الأخطاء أو العيوب)\nمثال: تلقى السناتور انتقادات شديدة من خصمه",
 "unfavorable position": "دونية, وضع أدنى (صفة كون الشخص في وضع تنافسي أضعف)",
 "unfavorableness": "سلبية, عدم ملاءمة (صفة عدم التشجيع أو الدلالة على النجاح)",
 "unfavorably": "بِاسْتِهْجَان, بِسَلْبِيَّة (إظهار عدم الموافقة؛ بطريقة استخفافية)\nمثال: استعرض المسرحية بسلبية",
 "unfavourable": "ضَارّ, غَيْر مُفِيد (ينطوي على أو يخلق ظروفاً تضر بالنجاح أو الفعالية) / غير مؤاتٍ, معاكس ((عن الرياح أو الطقس) تميل إلى الإعاقة أو المعارضة) / سلبي, غير مؤيد (غير مشجع أو غير موافق أو غير مبهج)\nمثال: نتيجة غير مواتية",
 "unfavourableness": "سلبية, عدم ملاءمة (صفة عدم التشجيع أو الدلالة على النجاح)",
 "unfavourably": "بِاسْتِهْجَان, بِسَلْبِيَّة (إظهار عدم الموافقة؛ بطريقة استخفافية)\nمثال: استعرض المسرحية بسلبية",
 "unfearing": "بَاسِل, جَسُور (لا يهاب الخوف أو الترهيب)",
 "unfeasibility": "اسْتِحَالَة, عَدَم جَدْوَى (صفة كون الشيء غير قابل للقيام به)",
 "unfeasible": "غَيْر عَمَلِيّ, غَيْر قَابِل لِلتَّطْبِيق (لا يمكن تنفيذه أو وضعه موضع التطبيق)",
 "unfeathered": "أمعط, بلا ريش (ليس لديه ريش) / عَارٍ مِن الرِّيش ((عن الطيور) لا يملك ريشاً)\nمثال: كائن ثنائي الأرجل بلا ريش",
 "unfed": "غَيْر مَدْعُوم, غَيْر مُغَذًّى (لم يُمنح دعماً أو تغذية) / غَيْر مُطْعَم (لم يُقدَّم له طعام)",
 "unfeeling": "عَدِيم الإِحْسَاس, فَاقِد الشُّعُور (خالٍ من الشعور أو الإحساس الجسديّ) / عَدِيمُ الإِحْسَاس, قَاسِي القَلْب (خالٍ من الشعور بالآخرين والتعاطف معهم)",
 "unfeelingly": "بِقَسْوَة, بِلَا إِحْسَاس (بطريقة قاسية) / بتحجر قلب, بقسوة (بدون مشاعر رحمة)\nمثال: استغل مشاعرهم بقسوة",
 "unfeelingness": "تَبَلُّد شُعُورِيّ, غِلْظَة (الخلو من العاطفة أو الشعور؛ قسوة القلب)",
 "unfeigned": "حَقِيقِيّ, صَادِق (غَيْر مُصْطَنَع؛ مَحْسُوس أَوْ مُعَبَّر عَنْهُ بِصِدْق)",
 "unfeignedly": "بإخلاص, بصدق (بصدق؛ دون تصنع)\nمثال: مدحته بصدق لانتصاره",
 "unfeminine": "غَيْرُ أُنْثَوِيّ (لا يليق بالمرأة)",
 "unfenced": "غَيْر مَسْيَج (غير محاط بسياج)",
 "unfermented": "طَازَج, غَيْر مُخَمَّر (غير حامض وغير محفوظ)",
 "unfertile": "عقيم (غير قادر على التكاثر)\nمثال: زوجان عقيمان",
 "unfertilised": "غَيْرُ مُخْصَب, غَيْرُ مُلَقَّح (لَمْ يَتِمَّ تَلْقِيحُهُ أَوْ إِخْصَابُهُ)",
 "unfertilized": "غَيْرُ مُخْصَب, غَيْرُ مُلَقَّح (لَمْ يَتِمَّ تَلْقِيحُهُ أَوْ إِخْصَابُهُ)",
 "unfettered": "طَلِيق, مَحْلُول القُيُود (غير مُقيَّد بأغلال أو سلاسل)",
 "unfilled": "غير منفذ (عن أوامر الشراء التي لم يتم تنفيذها)",
 "unfilmed": "غَيْر مُسَجَّل (لَمْ يُسَجَّل عَلى فِيلْم أَوْ شَريط)",
 "unfinished": "غير مكتمل, غير منتهٍ (لم يتم الانتهاء منه أو اختتامه) / غير تام الصنع, غير جاهز (لم يتم إيصاله للحالة النهائية المطلوبة) / خَامّ, غَيْرُ مَطْلِيّ (يَفْتَقِرُ إِلَى تَشْطِيبٍ سَطْحِيٍّ كَالطِّلَاء)\nمثال: أعمال غير منتهية",
 "unfinished business": "عمل غير منجز, مسائل عالقة (عمل تُرِك غير مكتمل)",
 "unfirm": "غَيْرُ ثَابِت, مُتَحَرِّك ((يُقال عن التربة) غير مستقرّ ومتحرّك) / غَيْر ثَابِت, مُتَزَعْزِع (غَيْر مُسْتَقِرّ أَوْ رَاسِخ فِي مَكَانِه)",
 "unfit": "غير لائق بدنياً, معتل (ليس في حالة جسدية أو عقلية جيدة؛ فاقد للياقة) / غير صالح, غير لائق (دون المعايير المطلوبة لغرض ما) / سَقيم, مَعيب (غَيْر سَليم جَسَدِيًّا؛ مُصاب بِعِلَّة)\nمثال: سمين وغير لائق بدنياً جداً",
 "unfitness": "عَدَم أَهْلِيَّة, عَدَم صَلَاحِيَّة (صفة كون الشيء غير مناسب) / عَجْز, عَدَم قُدْرَة (افتقاد القدرة على الأداء) / ترهل, عدم لياقة (حالة بدنية سيئة؛ عدم تناسق الجسم أو فقدان اللياقة (بسبب حياة الراحة والرفاهية))\nمثال: اتفق القضاة على عدم أهليته للتعيين",
 "unfitting": "غَيْرُ لَائِقٍ, غَيْرُ مُنَاسِبٍ (لَا يَتَّسِقُ مَعَ مَا هُوَ صَحِيحٌ أَوْ لَائِقٌ)",
 "unfixed": "ضَبَابِيّ, غَامِض (يَفْتَقِرُ إِلَى التَّحْدِيدِ أَوِ المُحْتَوَى الوَاضِح) / سائب, غير مثبت (غير موضوع أو مثبت بإحكام)",
 "unflagging": "لَا يَفْتُر, لَا يَكِلّ (لَا يَعْرِفُ الكَلَلَ أَوِ الفُتُورَ) / دَائِبٌ بِلَا هَوَادَة, لَا يَكِلّ (يُظهِر نشاطاً متواصلاً بحيوية لا تفتر)",
 "unflappable": "لَا يَتَزَعْزَع, وَقُور (لا يسهل إزعاجه أو إثارته؛ يتّسم بهدوء وضبط نفس شديدَين)",
 "unflattering": "غير جذاب, غير لائق (يظهر أو يمثل بشكل غير مواتٍ)\nمثال: صورة غير جذابة (تظهر العيوب)",
 "unflavored": "غَيْرُ مُنَكَّه (بِدُونِ إِضَافَةِ مُنَكِّهَات)",
 "unflavoured": "غَيْرُ مُنَكَّه (بِدُونِ إِضَافَةِ مُنَكِّهَات)",
 "unflawed": "بِلَا عَيْب, خَالٍ مِنَ العُيُوب (خالٍ من أيّ عيب أو شائبة)",
 "unfledged": "غِرّ, نَاشِئ (صغير السن وعديم الخبرة) / بِلَا رِيش ((عَنِ السَّهْم) غَيْر مُزَوَّد بِالرِّيش) / غير مكسو بالريش, غير ناضج ((عن الطيور) لم تطور ريشاً بعد)\nمثال: عصفور صغير غير مكسو بالريش على حافة النافذة",
 "unflinching": "ثَابِت, لَا يَتَرَاجَع (لا يتراجع أمام الخطر ولا يرتدع)",
 "unfluctuating": "ثَابِت, مُسْتَقِرّ (غير معرّض للتقلّب أو الانخفاض)",
 "unflurried": "غَيْرُ مُضْطَرِب, مُطْمَئِنّ (خالٍ من الاضطراب العاطفيّ والتوتّر العصبيّ)",
 "unflustered": "غَيْرُ مُضْطَرِب, مُطْمَئِنّ (خالٍ من الاضطراب العاطفيّ والتوتّر العصبيّ)",
 "unfocused": "غَيْرُ مُرَكَّز, مُشَتَّت (غَيْرُ مُتَمَرْكِزٍ فِي نُقْطَةٍ وَاحِدَةٍ أَوْ عَلَى هَدَفٍ وَاحِدٍ) / خارج البؤرة, غير مبأر ((عن الصورة) ليست في بؤرة التركيز أو لم يتم ضبط بؤرتها)\nمثال: عند حوافها، كانت الأشياء غير واضحة (خارج البؤرة) إلى حد كبير",
 "unfocussed": "غَيْرُ مُرَكَّز, مُشَتَّت (غَيْرُ مُتَمَرْكِزٍ فِي نُقْطَةٍ وَاحِدَةٍ أَوْ عَلَى هَدَفٍ وَاحِدٍ) / خارج البؤرة, غير مبأر ((عن الصورة) ليست في بؤرة التركيز أو لم يتم ضبط بؤرتها)\nمثال: عند حوافها، كانت الأشياء غير واضحة (خارج البؤرة) إلى حد كبير",
 "unfolding": "ازدهار, تفتح (عملية تنموية)\nمثال: ازدهار ثقافة ما قبل الحرب",
 "unforbearing": "غَيْرُ مُتَسَامِح (غَيْرُ رَاغِبٍ فِي التَّحَمُّل)",
 "unforced": "طَبِيعِيّ, غَيْرُ مُتَكَلَّف (لا ينتج عن جهد مفرط؛ غير مُكرَه) / رَاغِب, غَيْرُ مُكْرَه (لَمْ يُحْدَث بِالإِكْرَاهِ أَوِ القُوَّة)",
 "unforceful": "بلا قوة, ضعيف (يفتقر إلى القوة؛ ضعيف)\nمثال: حجة واهية",
 "unforeseeable": "غَيْر قَابِل لِلتَّوَقُّع (لا يمكن استباقه أو توقعه مسبقاً)",
 "unforeseen": "غَيْر مَنْظُور, غَيْر مُتَوَقَّع (لم يكن في الحسبان ولم يُتَرَقَّب)",
 "unforesightful": "قَصِيرُ النَّظَر (يفتقر إلى بُعْد النظر أو الشمولية)",
 "unforested": "خَالٍ مِنَ الغَابَاتِ, غَيْرُ مُحَرَّجٍ (غَيْرُ مُغَطَّى بِالغَابَاتِ)",
 "unforethoughtful": "غَيْرُ مُتَرَوٍّ (يفتقر إلى التفكير المسبق والتدبّر)",
 "unforfeitable": "غَيْرُ قَابِلٍ لِلْمُصَادَرَة, لَا يُسْلَب (لَا يَخْضَعُ لِلْمُصَادَرَةِ أَوِ الانْتِزَاع)",
 "unforgettable": "غَيْر مَنْسِيّ, لَا يُنْسَى (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "unforgettably": "بشكل لا ينسى (بطريقة لا تُنسى)\nمثال: كان هوروويتز يعزف شوبان بشكل لا ينسى",
 "unforgivable": "لَا يُغْتَفَرُ (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: لا أحب المدرسة.",
 "unforgivably": "بشكل غير مقبول, بشكل لا يغتفر (بطريقة لا يمكن الصفح عنها أو إلى درجة لا تغتفر)\nمثال: كان قاسياً بشكل لا يغتفر تجاه زوجته",
 "unforgiving": "غير متسامح, قاس (غير راغب أو غير قادر على المسامحة أو إظهار الرحمة) / صَارِم, لَا يَرْحَم (لا يمكن استرضاؤه أو ثَنيه بالتوسّل)\nمثال: امرأة عجوز فظة غير متسامحة",
 "unforgivingly": "بلا شفقة, دون مسامحة (بدون مسامحة؛ بأسلوب غير متسامح)\nمثال: دون مسامحة، أصر على أن تسدد دينها حتى آخر فلس",
 "unforgivingness": "عدم تسامح, قسوة (صفة عدم السماح بالضعف)",
 "unformatted capacity": "السعة الخام, السعة غير المهيأة ((في علم الحاسوب) العدد الإجمالي للبايتات على القرص بما في ذلك المساحة التي ستكون مطلوبة لتهيئته)",
 "unformed": "غَيْر مُتَشَكِّل (لم يتشكل أو يُنظَّم بعد) / غير متبلور, غير مشكل (ليس له شكل أو هيئة محددة)\nمثال: طين غير مشكل",
 "unfortunate": "غَيْر مُبَشِّر, مَشْؤُوم (غير مبشر؛ ينذر بالسوء) / غَيْر مُلَائِم, مُؤْسِف (غَيْر مُنَاسِب أَوْ مُؤْسِف الاخْتِيَار) / سيء الحظ, مؤسف (غير مفضل من قبل الحظ؛ يتسم أو يرافقه أو ينتج عنه سوء طالع) / بائِس, سَيِّئ الحَظّ (شخص يعاني من سوء الحظ أو المصائب)\nمثال: تحول مؤسف للأحداث",
 "unfortunate person": "بائِس, سَيِّئ الحَظّ (شخص يعاني من سوء الحظ أو المصائب)",
 "unfortunately": "لِلْأَسَف, لِسُوءِ الْحَظِّ",
 "unfounded": "لَا أَسَاس لَه, وَاهٍ (بدون أساس في العقل أو الواقع)",
 "unframed": "غير مؤطر (غير مزود بإطار)\nمثال: صور غير مؤطرة",
 "unfree": "غير حر, مُقيد (مُعاق وغير حر؛ غير قادر على التصرف حسب الرغبة) / غير حر, مستعبد (محتجز في العبودية)\nمثال: ولد لأبوين غير أحرار",
 "unfrequented": "مُنْعَزِل, مُوحِش (خالٍ من الكائنات الحية)",
 "unfretted": "عديم الدساتين (بدون دساتين)",
 "unfriendliness": "جفاء, عداء (طبع غير ودود) / جفاء, عدائية (الكراهية التي يتم اختبارها كغياب للود)",
 "unfriendly": "عدائي, غير ودود (غير ميال للصداقة أو الود) / صعب الاستخدام, غير صديق للمستخدم (ليس سهلاً في الفهم أو الاستخدام) / غَيْر مُلَائِم, مُعَادٍ (غير ملائم للحياة أو النموّ إطلاقاً) / غَيْر وُدِّيّ, مُعَادٍ (ليس ودِّيّاً؛ يتَّسم بالجفاء)\nمثال: برود في التصرف غير ودود",
 "unfrightened": "غَيْر مُرْتَعِب (لم يتأثر بالفزع أو الترويع)",
 "unfrosted": "غَيْر مُجَمَّد (خالٍ من الطلاء المُجمَّد (يُقال عن الزجاج))",
 "unfrozen": "غير متجمد (ليس متجمداً)\nمثال: أرض غير متجمدة",
 "unfruitful": "عقيم, غير مثمر (غير مثمر؛ لا يساعد على الإنتاج الوفير)",
 "unfueled": "غير مُزوَّد بالوقود (غير مزود بالوقود)",
 "unfulfilled": "غَيْر مُتَحَقِّق, غَيْر مُنْجَز ((للأشخاص) يتميز بالفشل في تحقيق كامل إمكاناته)",
 "unfunctional": "غَيْر وَظِيفِيّ (لا يتعلق بالاحتياجات اليومية أو لا يناسبها)",
 "unfunded": "غير ممول (غير مزود بالأموال)\nمثال: مشروع غير ممول",
 "unfunny": "غَيْر مُضْحِك (ليس مُضحكًا؛ خاصّة يفشل في تحقيق الفكاهة المقصودة)",
 "unfurnished": "غير مؤثث, غير مفروش (غير مجهز بما هو مطلوب وخاصة الأثاث)\nمثال: شقة غير مفروشة",
 "unfurrowed": "غير مخدد (غير معلم بانخفاضات ضحلة أو أخاديد)\nمثال: حقل غير محروث",
 "ungainliness": "حرج شديد, خرق (هيئة شخص تكون حركاته ووضعيته غير رشيقة للغاية وغير أنيقة)",
 "ungainly": "أَخْرَق, ثَقِيل الحَرَكَة (يفتقر إلى الرشاقة في الحركة أو الوقفة) / صَعْب التَّنَاوُل, مُرْبِك الشَّكْل (صعب المناولة أو الإدارة خاصّةً بسبب شكله)",
 "ungallant": "غَيْرُ فُرُوسِيّ, وَقِح (فظّ بشكل مُسِيء)",
 "ungarbed": "خَالِع مَلَابِسَهُ, مُتَعَرٍّ (أزال عنه الملابس)",
 "ungarmented": "خَالِع مَلَابِسَهُ, مُتَعَرٍّ (أزال عنه الملابس)",
 "ungathered": "غير مجموع (لم يتم إحضاره معاً في مكان واحد)\nمثال: قمامة غير مجمعة في الشوارع",
 "ungeared": "غير مُعشَّق التروس (ذو تروس غير معشقة أو مفصولة)\nمثال: ترس الآلة غير المعشق",
 "ungenerous": "بخيل, شحيح (غير راغب في إنفاق (المال، الوقت، الموارد، إلخ)) / غير كريم, لئيم (يفتقر إلى الشهامة والنبل)\nمثال: تمارس الاقتصاد دون أن تكون بخيلة",
 "ungentle": "بِلَا لَقَب, غَيْر نَبِيل (لا ينتمي إلى طبقة النبلاء)",
 "ungentlemanlike": "غَيْرُ لَائِقٍ بِالرِّجَالِ (لا يليق بسلوك الرجل المهذب)",
 "ungentlemanly": "غَيْرُ لَائِقٍ بِالرِّجَالِ (لا يليق بسلوك الرجل المهذب)",
 "ungetatable": "عَسِير المَنَال (صعب الوصول إليه أو بلوغه)",
 "unglamorous": "رَتِيب, عَادِيّ (غير مُلهِم ولا يُشكِّل تحدياً؛ باهت وخالٍ من الإثارة)",
 "unglamourous": "رَتِيب, عَادِيّ (غير مُلهِم ولا يُشكِّل تحدياً؛ باهت وخالٍ من الإثارة)",
 "unglazed": "غير لامع, غير مصقول (ليس له طبقة لامعة) / غير مزجج (غير مزود بالزجاج)\nمثال: ورق غير مصقول",
 "ungodliness": "فجور, كفر (عدم التقوى بحكم عدم كون الشخص ربانياً)",
 "ungodly": "غَيْر مَعْقُول (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "ungovernable": "جَامِح, مُتَمَرِّد (لا يمكن السيطرة عليه أو إخضاعه)",
 "ungoverned": "غَيْرُ مُنْضَبِط, فَاقِدُ الانْضِبَاط (يَفْتَقِرُ إِلَى الانْضِبَاطِ أَوِ السَّيْطَرَة) / جَامِح, مُنْفَلِت (غير مكبوح أو غير مسيطَر عليه)",
 "ungraceful": "عَدِيم الرَّشَاقَة, فَاقِد الأَنَاقَة (يفتقر إلى الرشاقة والأناقة؛ أخرق)",
 "ungracefully": "بجمود, بلا كياسة (بدون لطف؛ بصلابة)\nمثال: تحركوا بجمود",
 "ungracefulness": "انعدام الرشاقة (افتقار مزعج للرشاقة في الهيئة أو الشكل أو الحركة أو التعبير)",
 "ungracious": "جِلْف, خَشِن (يفتقر إلى اللباقة الاجتماعية) / جاف, غير لطيف (يفتقر إلى السحر والذوق الرفيع)\nمثال: مدينة صناعية خالية من الجمال",
 "ungraciously": "بجمود, بلا كياسة (بدون لطف؛ بصلابة)\nمثال: تحركوا بجمود",
 "ungraciousness": "جحود, فظاظة (نقص مهين في الأخلاق الحميدة)",
 "ungradable opposition": "تَقَابُل غَيْر مُتَدَرِّج (تعارض ليس له درجة وسطية؛ إما هذا أو ذاك)",
 "ungraded": "غَيْر مُدَرَّج, غَيْر مُرَتَّب (غير منظَّم ترتيباً هرميّاً) / تُرَابِيّ, غَيْر مُمَهَّد ((عن الطرق) غير مُسوّاة أو مصرّفة؛ لا تصلح للسفر على مدار العام)",
 "ungrammatical": "مَلْحُون",
 "ungrammaticality": "خَطَأ نَحْوِيّ, لَحْن (حالة أو صفة عدم اتباع قواعد النحو)",
 "ungrammatically": "بشكل مخالف للقواعد (بطريقة غير نحوية)\nمثال: هذا الطفل يتحدث بشكل مخالف للقواعد",
 "ungrasped": "غَيْر مُدْرَك (لم يُستوعَب بالكامل)",
 "ungrateful": "جاحد, غير ممتن (لا يشعر أو لا يظهر الامتنان) / ثَقِيل, غَيْر مُسْتَسَاغ (غير مقبول أو غير مستساغ)\nمثال: ورثة جاحدون",
 "ungrateful person": "جاحد, ناكر للجميل (شخص لا يظهر أي امتنان)",
 "ungratefully": "بِجُحُود, بِنُكْرَان جَمِيل (بطريقة ناكرة للجميل)",
 "ungratefulness": "جحود, نكران الجميل (الافتقار إلى الامتنان)",
 "ungratified": "غَيْرُ مُرْتَاح, قَلِق (مَشْغُول البَال وَغَيْر مُطْمَئِنّ)",
 "ungratifying": "غَيْرُ مُقَدَّر, نَاكِرٌ لِلْجَمِيل (من غير المرجّح أن يُكافَأ عليه)",
 "ungreased": "غير مزيت, غير مشحم (لم يتم تزييته أو تشحيمه)",
 "ungregarious": "انفرادي, غير قطيعي ((للحيوانات) ليست قطيعية) / غير تجمعي ((للنباتات) تنمو معًا في مجموعات غير متقاربة) / غَيْرُ أُلْفِيّ, نَافِرٌ مِنَ الصُّحْبَة (غير ميّال إلى طلب صحبة الآخرين)",
 "ungroomed": "شعث, غير مهندم (ليس أنيقًا ولا ذكيًا في المظهر)\nمثال: كان مجعدًا وغير مهندم، بلحية عمرها يومين",
 "ungrudging": "بِلَا تَرَدُّد, بِلَا ضَغِينَة (بدون حسد أو تردد في العطاء)",
 "ungrudgingly": "بسخاء, بلا تردد (بطريقة سخية وغير مترددة)\nمثال: وافق عن طيب خاطر على دفع ثمن عشاء الجميع عندما وجد الضيوف أنفسهم بلا نقود",
 "ungual": "ظُفْرِيّ",
 "unguaranteed": "بِلَا ضَمَان, غَيْر مَضْمُون (بدون ضمان ماليّ)",
 "unguarded": "غَيْر مُتَيَقِّظ, مَكْشُوف (لا يُبدي أيّ حذر أو احتراس) / غَيْرُ مَحْرُوس (يَفْتَقِرُ إِلَى الحِرَاسَةِ أَوِ الحِمَايَة)",
 "unguent": "بلسم, مرهم (مستحضر شبه صلب (يحتوي عادة على دواء) يطبق خارجياً كعلاج أو لتهدئة تهيج)",
 "unguiculata": "ذوات المخالب (في التصنيفات السابقة قسم رئيسي من الثدييات يضم الثدييات ذات الأظافر أو المخالب؛ تتميز عن الثدييات ذات الحوافر والحيتان)",
 "unguiculate": "حيوان ذو مخالب (ثديي له أظافر أو مخالب) / ذو مخالب, مخلبي (يمتلك أو يشبه المخالب أو الأظافر)\nمثال: حيوانات مخلبية",
 "unguiculate mammal": "حيوان ذو مخالب (ثديي له أظافر أو مخالب)",
 "unguiculated": "ذو مخالب, مخلبي (يمتلك أو يشبه المخالب أو الأظافر)\nمثال: حيوانات مخلبية",
 "unguided": "غير موجه (لا يخضع للتوجيه أو التحكم بعد الإطلاق)\nمثال: صواريخ غير موجهة",
 "unguis": "بنية قرنية (أي بنية جسدية صلبة تتكون أساساً من الكيراتين)",
 "ungulata": "ذوات الحوافر (في التصنيفات السابقة قسم رئيسي من الثدييات يضم جميع الثدييات ذات الحوافر؛ يقسم الآن إلى رتب مفردات الأصابع ومزدوجات الأصابع)",
 "ungulate": "حيوان ذو حوافر (أي من عدد من الثدييات ذات الحوافر التي تتشابه ظاهرياً ولكنها ليست بالضرورة مرتبطة ارتباطاً وثيقاً من الناحية التصنيفية) / حافري, ذو حوافر (يمتلك أو يشبه الحوافر)\nمثال: الخيول والحيوانات الأخرى ذات الحوافر",
 "ungulated": "حافري, ذو حوافر (يمتلك أو يشبه الحوافر)\nمثال: الخيول والحيوانات الأخرى ذات الحوافر",
 "ungummed": "غَيْر مُصَمَّغ (لم يُعالَج بالصمغ اللاصق)",
 "ungusseted": "غَيْر مُدَعَّم (ليس لديه وصلات تقوية)",
 "unhallowed": "دنس, غير مقدس (غير مقدس أو مكرس دينيًا)",
 "unhampered": "بِلَا عَوَائِق, غَيْر مُعَاق (غَيْر مُكَبَّل أَوْ خَاضِع لِلسَّيْطَرَة) / بِلَا عَوَائِق, غَيْرُ مُعَاق (غير مُبطَّأ أو مُعرقَل أو مُتدخَّل فيه)",
 "unhappily": "بشكل محزن, للأسف (بطريقة مؤسفة) / بتعاسة, بشكل غير سعيد (بطريقة غير سارة)\nمثال: للأسف مات قبل أن يتمكن من رؤية حفيده",
 "unhappiness": "تعاسة, حزن (العواطف التي يتم اختبارها عندما لا يكون الشخص في حالة رفاهية) / تعاسة, شقاء (حالة تتميز بمشاعر تتراوح من السخط الخفيف إلى الحزن العميق)",
 "unhappy": "لَعُوق",
 "unhardened": "غير مصلد, غير مقسى (لم يتم إيصاله إلى القوام أو الصلابة المناسبة)\nمثال: ملاط غير متماسك",
 "unharmed": "سَالِم, مُعَافًى (لم يُصَب بأذى أو ضرر)",
 "unharmonious": "غير متناغم, نشاز (ليس في انسجام)",
 "unharmoniously": "بِتَنَافُر, بِنَشَاز (بطريقة متنافرة)\nمثال: انتهت القطعة الموسيقية بنشاز",
 "unhatched": "غَيْرُ مَفْقُوس (لَمْ يَخْرُجْ مِنَ البَيْضَةِ بَعْد)",
 "unhazardous": "بِلَا مُخَاطَرَة, خَالٍ مِنَ المَخَاطِر (يُعتَقد أنّه خالٍ من المخاطر)",
 "unheaded": "غير مُعنوَن (ليس له عنوان أو ترويسة)\nمثال: أقسام غير مُعنوَنة",
 "unhealed": "غَيْرُ مُلْتَئِم (لم يُشفَ ولم يلتئم بعد)",
 "unhealthful": "غير صحي, مضر بالصحة (ضار بالصحة الجيدة) / غير صحي, ملوث (ليس صحيًا أو نظيفًا) / ضَارّ بِالصِّحَّة, غَيْر صِحِّيّ (مُضِرّ بالصحّة)\nمثال: تلوث الهواء غير الصحي",
 "unhealthfulness": "عَدَم صِحِّيَّة (صفة التسبب في تدهور الصحة)",
 "unhealthiness": "اعتلال الصحة, توعك (حالة تعجز فيها عن العمل بشكل طبيعي وبدون ألم)",
 "unhealthy": "غَيْر صِحِّيّ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "unhearable": "غَيْر مَسْمُوع (مستحيل السماع؛ غير مدرك بالأذن)\nمثال: محادثة غير مسموعة",
 "unheard": "غَيْر مَسْمُوع (ليس بالضرورة خافتاً لكنه لم يُسمع)",
 "unheard-of": "غَيْر مَسْبُوق, لَمْ يُسْمَع بِهِ (لم يكن معروفاً من قبل)",
 "unhearing": "أَصَمُّ تَمَامًا, أَصَمُّ كَالحَجَرِ (أصم كلياً؛ عاجز عن سماع أي شيء)",
 "unheated": "غَيْر مُدَفَّأ, غَيْر مُسَخَّن (لم يتمّ تسخينه أو تدفئته)",
 "unheeded": "مُتَجَاهَل, مُهْمَل (لم يُؤبَه له؛ أُهمِل عمداً)",
 "unheeding": "طائش, غافل (يتسم بـأو يولي القليل من الاهتمام أو الانتباه)\nمثال: لقد عرفنا دائماً أن المصلحة الذاتية الطائشة هي أخلاق سيئة؛ ونعلم الآن أنها اقتصاد سيء",
 "unhelpful": "غير مساعد, غير مفيد (لا يقدم أي مساعدة)",
 "unhelpfully": "بشكل غير مفيد (بطريقة غير مساعدة)\nمثال: وقف بشكل غير مفيد بينما احترق المنزل",
 "unhelpfulness": "خِذْلَان, عَدَم تَعَاوُن (عدم القدرة على تقديم المساعدة)",
 "unheralded": "بِلَا إِنْذَار, غَيْر مُعْلَن (بدون تحذير أو إعلان مُسبَق)",
 "unhesitating": "بِلَا تَرَدُّد, عَازِم (يتميز بالسرعة والحزم في اتخاذ القرار)",
 "unhesitatingly": "دون تردد (بلا تردد)\nمثال: قالت نعم دون تردد",
 "unhewn": "غَيْرُ مَنْحُوت ((عَنِ الحَجَرِ خَاصَّةً) لَمْ يُعْطَ شَكْلًا نِهَائِيًّا بِالنَّحْتِ)",
 "unhindered": "بِلَا عَوَائِق, غَيْرُ مُعَاق (غير مُبطَّأ أو مُعرقَل أو مُتدخَّل فيه)",
 "unhinged": "مَجْنُون, مُخْتَلّ (مصاب بالجنون أو الاضطراب العقليّ)",
 "unholiness": "دَنَس, نَجَاسَة (صفة كون الشيء غير مقدس)",
 "unholy": "جَهَنَّمِيّ, شَيْطَانِيّ (بالغ الشر أو القسوة؛ يُعبِّر عن الوحشية أو يليق بالجحيم) / آثِم, شِرِّير (ارتكب أفعالاً غير صالحة) / دنس, غير مقدس (غير مقدس أو مكرس دينيًا)",
 "unhomogenised": "غَيْرُ مُتَجَانِس (لم يخضع لعملية التجنيس أو التجانس)",
 "unhomogenized": "غَيْرُ مُتَجَانِس (لم يخضع لعملية التجنيس أو التجانس)",
 "unhoped": "غَيْر مَأْمُول, لَا يَخْطُر عَلَى البَال (بالغ عدم التوقع لدرجة أنه لم يُتَخَيَّل)",
 "unhoped-for": "غَيْر مَأْمُول, لَا يَخْطُر عَلَى البَال (بالغ عدم التوقع لدرجة أنه لم يُتَخَيَّل)",
 "unhopeful": "فَاقِد الأَمَل, يَائِس (يُظهِر استسلاماً تامّاً أو فقداناً للأمل)",
 "unhuman": "مُجَرَّد مِنَ الإِنْسَانِيَّة (مسلوب الصفات أو الخصائص البشرية)",
 "unhumorous": "جاف, جامد (يفتقر إلى الفكاهة)\nمثال: كانت غمزة خالية من الدعابة؛ غمزة تحذير",
 "unhurried": "غير مستعجل, متأنٍ (مسترخٍ ومتمهل؛ بلا عجلة أو تسرع) / غَيْرُ مُسْتَعْجِل, مُتَمَهِّل (قَادِرٌ عَلَى قَبُولِ التَّأْخِيرِ بِرَاحَةِ بَال)\nمثال: أناس يتجولون بطريقة متأنية",
 "unhurriedly": "بتأن, بدون عجلة (بدون تسرع)\nمثال: مضت بتأن",
 "unhurriedness": "بطء, تأنٍ (معدل يظهر غياب العجلة أو التسرع)",
 "unhurt": "سَالِم, مُعَافًى (لم يُصَب بأذى أو ضرر) / سَالِمٌ مُعَافًى (سليم من الخطر أو الأذى)",
 "unhygienic": "غَيْر صِحِّيّ, قَذِر (غير نظيف ويُشكّل سببًا محتملًا للمرض)",
 "unhygienically": "بشكل غير صحي (بطريقة غير صحية)\nمثال: تتم معالجة اللحوم بشكل غير صحي على طاولات خشبية",
 "uniat": "أونياتي, كاثوليكي شرقي (عضو في الكنيسة الشرقية المتحدة مع روما)",
 "uniat church": "الكنيسة الكاثوليكية الشرقية, الكنيسة الموحدة (أي من عدة كنائس في أوروبا الشرقية أو الشرق الأوسط تعترف بالسلطة البابوية ولكنها تحتفظ بطقوسها الخاصة)",
 "uniate": "موحد (متعلق بالكنائس المسيحية الشرقية التي تتبع الكنيسة الكاثوليكية في روما مع الاحتفاظ بطقوسها الخاصة) / أونياتي, كاثوليكي شرقي (عضو في الكنيسة الشرقية المتحدة مع روما)",
 "uniate christian": "أونياتي, كاثوليكي شرقي (عضو في الكنيسة الشرقية المتحدة مع روما)",
 "uniate church": "الكنيسة الكاثوليكية الشرقية, الكنيسة الموحدة (أي من عدة كنائس في أوروبا الشرقية أو الشرق الأوسط تعترف بالسلطة البابوية ولكنها تحتفظ بطقوسها الخاصة)",
 "unicameral": "أُحَادِيّ المَجْلِس (مكون من هيئة تشريعية واحدة)",
 "unicameral script": "نظام كتابة أحادي الحجم (نص بحالة واحدة للحروف (لا يوجد تمييز بين الحروف الكبيرة والصغيرة))",
 "unicef": "يونيسيف",
 "unicellular": "وحيد الخلية (يتكون من خلية واحدة)",
 "unicode": "يُونِيكُود (سلسلة من معايير ترميز الأحرف تهدف إلى دعم الأحرف التي تستخدمها عدد كبير من لغات العالم؛ معايير يونيكود، جنبًا إلى جنب مع معايير تمثيل سَلَاسِل الأحرف كسَلَاسِل بَايْت)",
 "unicorn": "أُحَادِيُّ القَرْن, حَرِيش",
 "unicorn root": "جذر المغص, عشبة النجمة (أي من النباتات المعمرة العديدة من جنس ألتريس ذات أوراق تشبه العشب وجذور مرة تشتهر بعلاج المغص)",
 "unicuspid": "أُحَادِيُّ الشُّرْفَة (ذو شُرفة أو نتوء حادّ واحد)",
 "unicycle": "دَرَّاجَة أُحَادِيَّة (مَرْكَبَة من عجلتين أو ثلاث، ولها مقعد واحد عادة، مثل الدراجة الهوائية والدراجة النارية؛ دراجة هوائية. (تخصيص))\nمثال: كين يريد دراجة.",
 "unicyclist": "راكب الدراجة الأحادية (شخص يركب دراجة أحادية العجلة)",
 "unidentifiable": "غير قابل للتعرف عليه, مجهول الهوية (يستحيل التعرف عليه أو تحديده)",
 "unidentified": "غَيْر مُعَرَّف, مَجْهُول الهُوِيَّة (ذو مصدر مجهول أو غير مُسمَّى) / مَجْهُول الهُوِيَّة (لم تُحدَّد هويته بعد)",
 "unidentified flying object": "صَحْن طَائِر (ساحة وسط الدَار. الجمع صحون؛ المستوي من الأرض)\nمثال: توم يلعب الصحن الطائر.",
 "unidimensional": "أحادي البعد, سطحي (يتعلق ببعد أو جانب واحد؛ ليس له عمق أو نطاق)\nمثال: بيان الحقيقة النثري أحادي البعد، حيث تقاس قيمته كلياً من حيث صدقه",
 "unidirectional": "أُحَادِيّ الاِتِّجَاه (يعمل أو يتحرك أو يسمح بالحركة في اتجاه واحد فقط)\nمثال: تدفق أحادي الاتجاه",
 "unifacial": "أُحَادِيّ الوَجْه (ذو سطح رئيسي أو متخصص واحد فقط)",
 "unification": "تَوْحِيد",
 "unification church": "كنيسة التوحيد (كنيسة مسيحية (بها بعض العناصر البوذية) أسسها صن ميونغ مون عام 1954 وتشتهر بإقامة حفلات زفاف جماعية وأنشطة مجتمعية أخرى)",
 "unified": "مُتَرَابِط, مُنَسَّق (يعمل كوحدة واحدة متناسقة) / مُتَكَامِل, مُدْمَج (تشكّل أو اتحد في كلّ واحد متكامل)",
 "unifilar": "أحادي الخيط (يمتلك أو يستخدم خيطاً واحداً فقط)",
 "unifoliate": "أُحَادِيّ الوَرَقَة (ذو ورقة واحدة فقط)",
 "uniform": "زَيّ, زِي",
 "uniform acceleration": "تَسَارُع ثَابِت, تَسَارُع مُنْتَظِم (نوع من الحركة تتغير فيه سرعة الجسم بمقدار متساوٍ في كل فترة زمنية متساوية)",
 "uniform resource locator": "رابط, عنوان ويب (عنوان صفحة ويب على الشبكة العنكبوتية العالمية)",
 "uniformed": "مُرْتَدٍ زِيّاً مُوَحَّداً (يرتدي زياً رسمياً موحداً)",
 "uniformity": "اطِّرَاد, انْتِظَام (صفة الافتقار إلى التنوع أو التباين (حتى درجة الملل)) / اتِّسَاق, انْتِظَام (حالة يكون فيها كل شيء منتظماً وغير متغير)",
 "uniformly": "بِانْتِظَام, بِتَجَانُس (بطريقة موحدة)\nمثال: سطح مشرق بانتظام",
 "uniformly decelerated motion": "حركة متباطئة بانتظام ((في الميكانيكا) حركة ذات سرعة ثابتة التناقص باستمرار)",
 "uniformness": "اطِّرَاد, انْتِظَام (صفة الافتقار إلى التنوع أو التباين (حتى درجة الملل))",
 "unifying": "تَوْحِيدِيّ, دَمْجِيّ (يجمع في وحدة واحدة)",
 "unilateral": "أُحَادِيّ الجَانِب",
 "unilateral contract": "عقد أحادي الجانب (اتفاق من جانب واحد تعد فيه بالقيام (أو الامتناع عن القيام) بشيء ما مقابل أداء (وليس وعداً))",
 "unilateral descent": "نَسَب أُحَادِيّ (خط النسب المتتبع عبر جانب واحد من العائلة)",
 "unilateral paralysis": "شلل نصفي (شلل جانب واحد من الجسم)",
 "unilateralism": "أحادية الجانب (المذهب القائل بأن الأمم يجب أن تدير شؤونها الخارجية بشكل فردي دون مشورة أو مشاركة دول أخرى)",
 "unilateralist": "مؤيد للأحادية (مدافع عن العمل الأحادي الجانب)",
 "unilaterality": "أحادية الجانب (حالة أو صفة كون الشيء أحادي الجانب)\nمثال: تأملت في أحادية الجانب لعلاقة السيد بالعبد",
 "unilaterally": "أُحَادِيًّا, مِن طَرَف وَاحِد (بطريقة أحادية الجانب؛ بواسطة جزء أو طرف واحد)\nمثال: توصلوا إلى اتفاق بشكل أحادي",
 "unilluminated": "بِلَا إِضَاءَة, غَيْر مُنَار (بِدُون إِنَارَة أَوْ إِضَاءَة)",
 "unilluminating": "غير تنويري, مبهم (يفشل في الإعلام أو التوضيح)\nمثال: تعليق غير موضح",
 "unimaginable": "غَيْرُ وَارِد, مُسْتَحِيل (مُسْتَبْعَدٌ تَمَامًا؛ لَا يُمْكِنُ تَصَوُّرُه)",
 "unimaginably": "بشكل لا يصدق, فوق التصور (إلى حد لا يمكن تخيله)",
 "unimaginative": "مُكَرَّر, نَمَطِيّ (يَفْتَقِرُ إِلَى العَفْوِيَّةِ أَوِ الأَصَالَةِ أَوِ التَّفَرُّد) / جَامِد, عَقِيم (يفتقر إلى الأصالة أو الإبداع؛ عاجز عن الابتكار) / حَرْفِيّ, غَيْر خَيَالِيّ (يتعامل فقط مع الحقائق الملموسة)",
 "unimaginatively": "بلا خيال (بدون خيال) / برتابة, بشكل عادي (بطريقة واقعية خالية من الخيال)\nمثال: صممت ديكورات المسرح بلا خيال",
 "unimagined": "غَيْرُ مُتَخَيَّل, لَا يَخْطُرُ عَلَى بَال (لم يُتَخَيَّل حتى في الأحلام)",
 "unimodal": "أُحَادِيّ المِنْوَال (لديه منوال واحد)",
 "unimpaired": "سليم, غير معتل (لم يتضرر أو يتضاءل في أي جانب)\nمثال: بقي نطقه سليماً",
 "unimpassioned": "غَيْرُ عَاطِفِيّ, هَادِئ (خَالٍ مِنَ النِّدَاءِ العَاطِفِيّ؛ يَتَّسِمُ بِالعَقْلَانِيَّة)",
 "unimpeachable": "لَا غُبَار عَلَيْه, لَا يُعتَرَض عَلَيْه (مقبول تمامًا؛ لا يُمكن الاعتراض عليه أو انتقاده) / بَرِيء, لَا تَشُوبُهُ شَائِبَة (خالٍ من الذنب؛ لا يستحق اللوم) / فَوْقَ الشُّبُهَات, لَا يُطْعَنُ فِيه (فوق مستوى الشكّ أو اللوم)",
 "unimpeachably": "بشكل لا جدال فيه, بلا شك (بدون تساؤل)\nمثال: فريد وينتر هو الفارس الذي يجب متابعته بلا شك",
 "unimpeded": "دُونَ عَوَائِق, غَيْر مُعَاق (لم يُبطَّأ أو يُمنَع)",
 "unimportance": "تفاهة, عدم أهمية (صفة عدم كون الشيء مهماً أو جديراً بالملاحظة) / تواضع المكانة, خمول (حالة كونه متواضعاً وغير مهم)",
 "unimportant": "تافه, غير مهم (ليس مهماً) / تافه, ضئيل الشأن (خالٍ من الأهمية أو المعنى أو القوة)\nمثال: ميزة غير مهمة نسبياً للنظام",
 "unimposing": "غَيْر مُهِيب (يفتقر إلى ما يُثير الإعجاب)",
 "unimpregnated": "غَيْرُ مُخْصَب, غَيْرُ مُلَقَّح (لَمْ يَتِمَّ تَلْقِيحُهُ أَوْ إِخْصَابُهُ)",
 "unimpressed": "غَيْر مُنْبَهِر (لم ينتقل إلى الاهتمام الجدي أو الإعجاب)",
 "unimpressionable": "غير سريع التأثر (ليس حساسًا أو عرضة للانطباع)\nمثال: عقل غير قابل للتأثر",
 "unimpressive": "عادي, غير مثير للإعجاب (غير قادر على إثارة الإعجاب)",
 "unimpressively": "بشكل غير مثير للإعجاب (بطريقة غير مثيرة للإعجاب)\nمثال: سجلت درجة منخفضة بشكل غير مثير للإعجاب",
 "unimprisoned": "طَلِيق, غَيْر مَحْبُوس (غَيْر خَاضِع لِلْحَبْس أَوِ التَّقْيِيد الجَسَدِيّ)",
 "unimproved": "غير مطور, غير مُحسَّن (لم يتم جعله مرغوباً أكثر أو ذا قيمة أو ربحية أكبر؛ خاصة لم يتم تجهيزه للاستخدام أو التسويق) / بِكْر, غَيْر مُطَهَّر ((عن الأراضي) لم تُزَل منها الأشجار والشجيرات؛ في حالتها البرّيّة الطبيعيّة)\nمثال: الضرائب على الأراضي غير المطورة منخفضة",
 "unincorporated": "غَيْر مُسَجَّل كَشَرِكَة (غير منظم أو مُدار ككيان قانوني مؤسسي)",
 "unindustrialised": "غَيْرُ مُصَنَّع (لم يتحول إلى النظام الصناعي)",
 "unindustrialized": "غَيْرُ مُصَنَّع (لم يتحول إلى النظام الصناعي)",
 "uninebriated": "صَاحٍ, غَيْر سَكْرَان (لَيْسَ فِي حَالَة سُكْر)",
 "uninfected": "غَيْر مُصَاب, نَظِيف (خالٍ من التعفّن أو العدوى)",
 "uninflected": "تَحْلِيلِيّ, غَيْر تَصْرِيفِيّ (يعبر عن فئة نحوية باستخدام كلمتين أو أكثر بدلاً من التصريف) / جامد, غير مصرف (غير مصرف) / رتيب, غير منغم ((عن الصوت) غير متغير النبرة)\nمثال: كلمات غير منغمة",
 "uninfluenced": "غَيْر مُتَأَثِّر, غَيْر مُنْقَاد (لم يتأثر أو لم ينقد لتأثير خارجي)",
 "uninfluential": "عديم النفوذ, غير مؤثر (ليس مؤثراً)",
 "uninformative": "غير مفيد بالمعلومات (يفتقر إلى المعلومات)",
 "uninformatively": "بشكل غير مفيد, دون إفادة (بطريقة تفتقر للمعلومات)\nمثال: قال بشكل غير مفيد إلى حد ما: لا أستطيع أن أخبرك متى سيصل المدير",
 "uninformed": "جاهل, غير مطلع (غير مطلع؛ يفتقر إلى المعرفة أو المعلومات)\nمثال: الجمهور غير المطلع",
 "uninhabitable": "غَيْر صَالِح لِلسَّكَن (لا يَصْلُح لِلإِقامَة أَوْ العَيْش فيه)",
 "uninhabited": "خالٍ من السكان, غير مأهول (ليس به سكان؛ لا يُعاش فيه)\nمثال: جزيرة غير مأهولة",
 "uninhibited": "غير مكبوت, متحرر (غير مكبوت أو مقيد)\nمثال: حيوية غير مكبوتة",
 "uninitiate": "سَاذَج, غَيْر مُطَّلِع (غير مُبَادَر؛ يعوزه الخبرة في المجال المعني) / الجاهلون بالأمر, غير المطلعين (الناس الذين لم يتم تعريفهم بأسرار مجال أو نشاط معين)\nمثال: إنه يحول انتباه غير المطلعين",
 "uninitiated": "سَاذَج, غَيْر مُطَّلِع (غير مُبَادَر؛ يعوزه الخبرة في المجال المعني)",
 "uninjectable": "غير قابل للحقن ((يستخدم للأدوية) غير قابل لأن يُحقن)",
 "uninjured": "سليم, غير مصاب (لم يصب بأذى جسدي أو عقلي)",
 "uninominal": "أُحَادِيُّ التَّمْثِيل (قائم على نظام يكون فيه عضو واحد فقط عن كل دائرة)",
 "uninominal system": "نظام الدوائر الفردية, نظام العضو الواحد (قائم على مبدأ اختيار عضو واحد فقط (كما في المجلس التشريعي) من كل دائرة انتخابية)",
 "uninominal voting system": "نظام الدوائر الفردية, نظام العضو الواحد (قائم على مبدأ اختيار عضو واحد فقط (كما في المجلس التشريعي) من كل دائرة انتخابية)",
 "uninquiring": "عَدِيمُ الفُضُولِ, غَيْرُ مُسْتَطْلِع (يفتقر إلى حب الاستطلاع) / غير فضولي, غير متسائل (لا يميل إلى التساؤل أو البحث)",
 "uninquisitive": "عَدِيمُ الفُضُولِ, غَيْرُ مُسْتَطْلِع (يفتقر إلى حب الاستطلاع) / غير فضولي, غير متسائل (لا يميل إلى التساؤل أو البحث)",
 "uninspired": "جَامِد, عَقِيم (يفتقر إلى الأصالة أو الإبداع؛ عاجز عن الابتكار) / بَلِيد, غَيْر مُلْهَم (يفتقر إلى الحماس الفكري أو العاطفي أو الروحي)",
 "uninspiring": "عادي, غير ملهم (محبط للروح أو لا يبعث على الإلهام)\nمثال: فيلا ذات تصميم غير ملهم",
 "uninstructed": "سَاذَج, غَيْرُ مُوَجَّه (يفتقر إلى المعلومات أو التوجيه)",
 "uninstructive": "غير تعليمي, غير مفيد (يفشل في التعليم أو تقديم الفائدة)",
 "uninstructively": "بشكل غير مفيد, دون إفادة (بطريقة تفتقر للمعلومات)\nمثال: قال بشكل غير مفيد إلى حد ما: لا أستطيع أن أخبرك متى سيصل المدير",
 "uninsurability": "عَدَم قَابِلِيَّة التَّأْمِين (صفة كون الشيء غير قابل للتأمين عليه)",
 "uninsurable": "غَيْر قَابِل لِلتَّأْمِين (لا يمكن التأمين عليه أو غير مؤهّل للتأمين)",
 "uninsured": "غير مؤمن عليه (غير مغطى بالتأمين)\nمثال: سائق سيارة غير مؤمن عليه",
 "unintegrated": "معزول, مفصول عنصرياً (مفصول أو معزول عن الآخرين أو المجموعة الرئيسية) / غير متكامل, غير مدمج (غير متكامل؛ لم يتم ضمه أو جعله جزءاً من الكل)\nمثال: نظام مدرسي مفصول عنصرياً",
 "unintelligent": "غبي, غير ذكي (يفتقر إلى الذكاء)\nمثال: وظيفة مملة مع زملاء كسالى وأغبياء",
 "unintelligently": "بغباء (بطريقة غير ذكية)\nمثال: تصرف بغباء نوعاً ما في هذه الأزمة",
 "unintelligibility": "طَلْسَمَة, عَدَم قَابِلِيَّة الفَهْم (عدم الفهم كنتيجة لكون الشيء غير مفهوم بذاته) / تَفَكُّك, عَدَم تَرَابُط (هراء غير متماسك وغير مفهوم ببساطة)",
 "unintelligible": "غَيْرُ مَفْهُوم, مُعْتِم (صعب أو مستحيل الفهم والاستيعاب) / غير مفهوم, مبهم (ملفوظ أو منطوق بشكل سيء، أو طغت عليه الضوضاء)\nمثال: كلام غير مفهوم",
 "unintelligibly": "بشكل غير مفهوم (بطريقة لا يمكن فهمها)\nمثال: تحدث الأجانب بشكل غير مفهوم",
 "unintended": "عفوي, غير مقصود (ليس متعمداً)",
 "unintentional": "غَيْرُ مَقْصُود, غَيْرُ مُخَطَّط (لم يُفعَل عن قصد أو نية) / مقصود, مُصمَّم (تم فعله أو صنعه أو أداؤه بغرض ونية)\nمثال: الأسلوب؛ هو أكثر من مجرد إبداع متعمد ومصمم",
 "unintentionally": "عَنْ غَفْلَةٍ (يُفِيدُ المُجَاوَزَة؛ يُفِيدُ الاستعلاء، عَلَى)\nمثال: سألتني عن عمري.",
 "uninterested": "غَيْرُ مُكْتَرِث, غَيْرُ مُهْتَمّ (لا يبالي ولا يهتم بالمعرفة) / غير مهتم, لا مبالٍ (ليس لديه أو لا يظهر اهتماماً)\nمثال: متفرج غير مهتم",
 "uninteresting": "مُمِلّ المُؤَسَّسَاتِيَّة (يتَّسم بطابع المؤسَّسة خاصَّة في الرتابة والجمود) / غير مثير للاهتمام, ممل (لا يثير أي اهتمام أو انتباه أو فضول أو إثارة)\nمثال: رواية غير مثيرة للاهتمام للغاية عن رحلتها",
 "uninterestingly": "بشكل غير مثير للاهتمام (بطريقة غير مثيرة للاهتمام)",
 "uninterestingness": "عَدَم إِثَارَة, مَلَل (عدم القدرة على جذب انتباه المرء أو الحفاظ عليه)",
 "uninterrupted": "مُتَّصِل, مُتَوَاصِل",
 "uninterruptedly": "بشكل متواصل, دون انقطاع (بدون انقطاع)\nمثال: استمرت هذه الحالة الممتعة بسلام ودون انقطاع لسنوات عديدة",
 "unintimidated": "ثَابِت, لَا يَتَرَاجَع (لا يتراجع أمام الخطر ولا يرتدع)",
 "unintoxicated": "صَاحٍ, غَيْر سَكْرَان (لَيْسَ فِي حَالَة سُكْر)",
 "unintrusive": "غير تطفلي, غير فضولي (لا يتدخل أو يتطفل)",
 "uninucleate": "أحادي النواة (يحتوي على نواة واحدة)",
 "uninventive": "جَامِد, عَقِيم (يفتقر إلى الأصالة أو الإبداع؛ عاجز عن الابتكار)",
 "uninvited": "غَيْرُ مَدْعُوّ ((عن الشخص) لم تُوجَّه إليه دعوة) / غَيْرُ مَرْغُوب فِيه, لَا إِرَادِيّ ((عن فكرة أو فعل) غير مرحَّب به أو لا إراديّ)",
 "uninvitedly": "تطفلاً, دون دعوة (بدون دعوة)\nمثال: وصلت النساء دون دعوة",
 "uninviting": "مُنَفِّر, مُسْتَكْرَه",
 "uninvolved": "غَيْرُ مُنْخَرِطٍ, مُنْفَصِلٌ عَاطِفِيًّا (يُظْهِرُ عَدَمَ انْخِرَاطٍ عَاطِفِيٍّ) / غير متورط, غير معني (غير متورط)\nمثال: لكونه غير متورط، بقي موضوعياً",
 "uniocular dichromat": "ثنائي اللون أحادي العين (شخص لديه رؤية طبيعية في عين وعمى ألوان ثنائي في الأخرى؛ نادر جداً ولكنه مفيد جداً لتجارب رؤية الألوان)",
 "union": "اِتِّحَاد, اِتِّفَاق (اِتِّحَاد؛ الاتِّحاد الأوربيّ : (السياسة) اتِّحاد أوربيّ إقليميّ أنشئ بمقتضى معاهدة ماستريخت في عام 1993 م…) / زَوَاج\nمثال: عاش الاتحاد السوفيتي!",
 "union army": "جيش الاتحاد (الجيش الشمالي خلال الحرب الأهلية الأمريكية)",
 "union card": "بطاقة نقابية (بطاقة تثبت العضوية في نقابة عمالية)",
 "union flag": "علم الاتحاد (العلم الوطني للمملكة المتحدة)",
 "union jack": "علم الاتحاد (العلم الوطني للمملكة المتحدة)",
 "union member": "نقابي (عامل ينتمي إلى نقابة عمالية)",
 "union of soviet socialist republics": "اِتِّحَاد الْجُمْهُورِيَّات السُّوفْيَاتِيَّة الاِشْتِرَاكِيَّة (اِتِّحَاد؛ الاتِّحاد الأوربيّ : (السياسة) اتِّحاد أوربيّ إقليميّ أنشئ بمقتضى معاهدة ماستريخت في عام 1993 م…)\nمثال: عاش الاتحاد السوفيتي!",
 "union of the comoros": "الاِتِّحَاد الْقُمُرِيّ",
 "union representative": "ممثل نقابي (ممثل لنقابة عمالية)",
 "union shop": "مؤسسة نقابية (شركة يُسمح لها بتعيين عمال غير نقابيين بشرط انضمامهم إلى النقابة في غضون وقت محدد)",
 "union soldier": "فيدرالي (عضو في جيش الاتحاد خلال الحرب الأهلية الأمريكية)",
 "union suit": "ملابس داخلية طويلة, يونيو سوت (رداء داخلي يتكون من قميص وسروال في قطعة واحدة)",
 "unionisation": "تنظيم نقابي (فعل تشكيل النقابات العمالية)\nمثال: كانت القضية الأساسية للإضراب هي التنظيم النقابي",
 "unionised": "غَيْر مُتَأَيِّن (غير محول إلى أيونات) / مُنَقَّب, مُنْتَسِب لِلنِّقَابَة (عضو في نقابة عمالية أو مُشكَّل ضمنها)",
 "unionism": "النقابية (نظام أو مبادئ ونظرية النقابات العمالية)",
 "unionist": "نقابي (عامل ينتمي إلى نقابة عمالية)",
 "unionization": "تنظيم نقابي (فعل تشكيل النقابات العمالية)\nمثال: كانت القضية الأساسية للإضراب هي التنظيم النقابي",
 "unionized": "غَيْر مُتَأَيِّن (غير محول إلى أيونات) / مُنَقَّب, مُنْتَسِب لِلنِّقَابَة (عضو في نقابة عمالية أو مُشكَّل ضمنها)",
 "uniovular": "وحيد البويضة (يحتوي على بويضة واحدة)",
 "uniovulate": "وحيد البويضة (يحتوي على بويضة واحدة)",
 "uniparous": "وحيد الولادة (ينتج نسلًا واحدًا فقط في كل مرة)",
 "unipolar": "أحادي القطب (له قطب واحد)",
 "unipolar depression": "اكتئاب أحادي القطب (نوبة اكتئاب كبرى تحدث دون مرحلة الهوس التي تحدث في الشكل الكلاسيكي للاضطراب ثنائي القطب)",
 "unique": "فَرِيد, فَذّ",
 "uniquely": "بشكل فريد, بشكل لا لبس فيه (بحيث يكون فريداً)\nمثال: استطاع تحديد خصائص المركب بشكل فريد",
 "uniqueness": "تميز, فرادة (صفة كون الشيء فريداً من نوعه)\nمثال: ميزه ذلك التفرد عن جميع رفاقه",
 "unironed": "غير مكوي, مجعد ((للمفروشات أو الملابس) غير مكوي)\nمثال: كومة من الغسيل غير المكوي",
 "unisex": "أُحَادِيُّ الجِنْس (لا يُمَيَّز على أساس الجنس)",
 "unisexual": "أُحَادِيّ الجِنْس (يتعلّق بجنس واحد فقط أو له نوع واحد من الأعضاء الجنسية)",
 "unison": "انسجام, تطابق صوتي ((موسيقى) صوتان أو نغمتان أو أكثر بنفس الطبقة أو في أوكتافات متطابقة) / انسجام, توافق (الحدوث معاً أو في وقت واحد) / انسجام, توافق (المطابقة التامة)\nمثال: الغناء في انسجام",
 "unit": "وَحْدَة",
 "unit cell": "خلية الوحدة, وحدة الخلية (أصغر مجموعة من الذرات أو الجزيئات التي ينتج عن تكرارها بانتظام في ثلاثة أبعاد شبكات البلورة)",
 "unit character": "صفة أحادية ((علم الوراثة) صفة تورث على أساس الكل أو لا شيء وتعتمد على وجود جين واحد)",
 "unit cost": "تكلفة الوحدة (التكلفة المحسوبة لوحدة معينة من المنتج)",
 "unit investment trust": "صندوق استثمار بالوحدات (شركة استثمار منظمة تتكون من مديرين محترفين يصدرون أوراقاً مالية قابلة للاسترداد تمثل محفظة من العديد من الأوراق المالية المختلفة)\nمثال: يمكنك الاستثمار في صندوق استثمار بالوحدات بمبلغ لا يتجاوز 1000 دولار",
 "unit matrix": "مصفوفة الوحدة, مصفوفة محايدة (مصفوفة سلمية تكون فيها جميع العناصر القطرية مساوية للواحد)",
 "unit of ammunition": "جولة, طلقة (شحنة ذخيرة لطلقة واحدة)",
 "unit of measurement": "وَحْدَة قِيَاس (أيّ قسمة للكمّيّة مقبولة معيارًا للقياس أو التبادل)",
 "unit of time": "وحدة زمنية (وحدة لقياس الفترات الزمنية)",
 "unit of viscosity": "وحدة لزوجة (وحدة قياس للزوجة)",
 "unit trust": "صندوق استثمار بالوحدات (شركة استثمار منظمة تتكون من مديرين محترفين يصدرون أوراقاً مالية قابلة للاسترداد تمثل محفظة من العديد من الأوراق المالية المختلفة)\nمثال: يمكنك الاستثمار في صندوق استثمار بالوحدات بمبلغ لا يتجاوز 1000 دولار",
 "unit vector": "مُتَّجِهٌ وَحْدَةَ",
 "unitard": "بدلة رقص, جمبسوت ضيق (رداء ضيق من مادة مطاطية يغطي الجسم من الكتفين إلى الفخذين (أو الكاحلين)؛ يرتديه راقصو الباليه ولاعبو الأكروبات)",
 "unitarian": "توحيدي (من أو يتعلق بالتوحيدية المسيحية أو يميزها) / مُوَحِّد (معتنق للتوحيدية (في المسيحية))",
 "unitarian church": "الكنيسة الموحدة, كنيسة التوحيديين (الطائفة البروتستانتية التي ترفض عقيدة الثالوث)",
 "unitarianism": "توحيدية (دين غير عقائدي يشدد على الحرية الفردية في الاعتقاد ويرفض الثالوث)",
 "unitariness": "أحادية, وحدوية (الصفة أو الحالة المتعلقة بالوحدة، امتلاك صفة الوحدانية)\nمثال: مال التفكير الحداثي إلى رؤية وحدوية الجماعات والمجتمعات على أنها معادلة لتلك الخاصة بالأفراد",
 "unitarism": "مركزية, وحدوية (سياسة تفضل عملية توحيد كيان سياسي يتكون من مناطق أصغر، إما عن طريق إلغاء المناطق تماماً أو نقل سلطتها إلى الحكومة المركزية)",
 "unitary": "مركزي, موحد (يتميز بـأو يشكل شكلاً من أشكال الحكم تكون فيه السلطة بيد سلطة مركزية واحدة) / وَاحِد, وَحْدَوِيّ (له طابع الوحدة غير القابلة للتجزئة) / وحدوي (متعلق باستخدام الوحدات أو يعتمد عليها (في الرياضيات والقياس)) / توحيدي, وحدوي (متعلق بالوحدة أو يهدف إليها أو يتميز بها)\nمثال: شكل موحد للحكومة في مقابل الشكل الفيدرالي",
 "unitary state": "دَوْلَة وَحْدَوِيَّة (بَلَد يتميز بحُدُود معروفة وشَعْب وحُكُومَة ومُؤَسَسَات مُنَظَّمَة؛ مجموعة من الناس مستقلين متحدين معا لتكوين مجتمع لحماية حقوقهم و وضع قوانينهم الخاصة)\nمثال: لبنان دولة صغيرة.",
 "unite": "اِتَّحَدَ, أَلَّفَ",
 "united": "مُتَّحِد",
 "united arab emirate dirham": "درهم, درهم إماراتي (وحدة المال الأساسية في الإمارات العربية المتحدة؛ تساوي 100 فلس)",
 "united arab emirate monetary unit": "وحدة نقدية إماراتية (الوحدة النقدية في الإمارات العربية المتحدة)",
 "united arab emirates": "الْإِمَارَات الْعَرَبِيَّة الْمُتَّحِدَة, الْإِمَارَات (اسم مختصر للإمارات العربية المتحدة (دولة في جنوب غرب آسيا))\nمثال: أبو ظبي هي عاصمة الإمارات العربية المتحدة.",
 "united arab republic": "الْجُمْهُورِيَّةُ الْعَرَبِيَّة الْمُتَّحِدَة",
 "united church of christ": "كنيسة المسيح المتحدة (اندماج الكنيسة المسيحية التجمعية والكنيسة الإنجيلية والإصلاحية في عام 1957)",
 "united front": "التحالف الشمالي, الجبهة المتحدة (تحالف متعدد الأعراق في أفغانستان يمارسون شكلاً معتدلاً من الإسلام ومتحدون في معارضتهم لطالبان)",
 "united kingdom": "الْمَمْلَكَةُ الْمُتَّحِدَة",
 "united kingdom of great britain": "الْمَمْلَكَة الْمُتَّحِدَة لِبِرِيطَانِيَا الْعُظْمَى",
 "united methodist church": "الكنيسة الميثودية المتحدة (اتحاد الكنيسة الميثودية الويسليانية وكنيسة الإخوة المتحدين الإنجيلية)",
 "united mexican states": "الولايات المتحدة المكسيكية",
 "united mine workers": "عمال المناجم المتحدون في أمريكا (نقابة صناعية لعمال المناجم في أمريكا الشمالية)",
 "united mine workers of america": "عمال المناجم المتحدون في أمريكا (نقابة صناعية لعمال المناجم في أمريكا الشمالية)",
 "united nations": "الْأُمَم الْمُتَّحِدَة",
 "united nations agency": "وكالة تابعة للأمم المتحدة (وكالة من وكالات الأمم المتحدة)",
 "united nations children's fund": "اليونيسف, منظمة الأمم المتحدة للطفولة (وكالة تابعة للأمم المتحدة مسؤولة عن برامج دعم التعليم وصحة الأطفال والأمهات في البلدان النامية)",
 "united nations crime prevention and criminal justice": "مركز منع الجريمة الدولي (مكتب الأمم المتحدة المسؤول عن منع الجريمة والعدالة الجنائية وإصلاح القانون)",
 "united nations day": "24 أكتوبر, يوم الأمم المتحدة (يوم للاحتفال بتأسيس الأمم المتحدة)",
 "united nations educational scientific and cultural organization": "اليونسكو, منظمة الأمم المتحدة للتربية والعلم والثقافة (وكالة تابعة للأمم المتحدة تعزز التعليم والاتصال والفنون)",
 "united nations general assembly": "الْجَمْعِيَّةُ الْعَامَّةُ لِلْأُمَمِ الْمُتَّحِدَةِ",
 "united nations international children's emergency fund": "اليونيسف, منظمة الأمم المتحدة للطفولة (وكالة تابعة للأمم المتحدة مسؤولة عن برامج دعم التعليم وصحة الأطفال والأمهات في البلدان النامية)",
 "united nations office for drug control and crime prevention": "مكتب الأمم المتحدة لمكافحة المخدرات والجريمة (وكالة تابعة للأمم المتحدة تعزز مكافحة المخدرات ومنع الجريمة)",
 "united nations secretariat": "الأمانة العامة للأمم المتحدة (الذراع الإداري للأمم المتحدة)",
 "united society of believers in christ's second appearing": "الشيكرز, المجتمع المتحد للمؤمنين بظهور المسيح الثاني (طائفة مسيحية تمارس العزوبة والمشاعية في الولايات المتحدة)",
 "united states": "الْوِلَايَاتُ الْمُتَّحِدَة",
 "united states air force": "القوات الجوية الأمريكية (القوات الجوية للولايات المتحدة الأمريكية؛ الوكالة التي تدافع عن الولايات المتحدة من خلال السيطرة واستغلال الجو والفضاء)",
 "united states air force academy": "أكاديمية القوات الجوية الأمريكية (مدرسة لتدريب الرجال والنساء ليصبحوا ضباطاً في القوات الجوية الأمريكية)",
 "united states army": "الجيش الأمريكي (جيش الولايات المتحدة الأمريكية؛ الوكالة التي تنظم وتدرب الجنود للحرب البرية)",
 "united states army criminal investigation command": "قيادة التحقيقات الجنائية للجيش الأمريكي (وكالة إنفاذ القانون الرئيسية للجيش الأمريكي المسؤولة عن إجراء التحقيقات الجنائية لجميع مستويات الجيش في أي مكان في العالم)",
 "united states army rangers": "رينجرز الجيش الأمريكي (وحدة نخبة مدربة تدريباً خاصاً في الجيش الأمريكي)",
 "united states army special forces": "القوات الخاصة (فرقة من الجيش الأمريكي مدربة خصيصًا لحرب العصابات)",
 "united states attorney general": "المدعي العام (الشخص الذي يشغل منصب وزير وزارة العدل)\nمثال: كان إدموند راندولف أول مدع عام، عينه الرئيس واشنطن",
 "united states border patrol": "حرس الحدود الأمريكي (الذراع المتنقل لإنفاذ القانون التابع لدائرة الهجرة والتجنيس الذي يكشف ويمنع الدخول غير القانوني للأجانب إلى الولايات المتحدة)",
 "united states cabinet": "مجلس وزراء الولايات المتحدة (مجلس لتقديم المشورة للرئيس؛ أعضاؤه هم أمناء الإدارات التنفيذية؛ دستور الولايات المتحدة لا ينص على مجلس الوزراء)",
 "united states coast guard": "خفر السواحل الأمريكي (وكالة تابعة لوزارة النقل مسؤولة عن تسيير دوريات على الشواطئ وتسهيل التجارة البحرية)",
 "united states code": "قانون الولايات المتحدة (تجميع وتدوين للقوانين العامة والدائمة للولايات المتحدة حسب الموضوع؛ يتم إعداده ونشره من قبل وحدة تابعة لمجلس النواب الأمريكي)",
 "united states congress": "الكونغرس, الكونغرس الأمريكي (الهيئة التشريعية لحكومة الولايات المتحدة)",
 "united states customary system": "نظام الوحدات العرفية الأمريكي (نظام الأوزان والمقاييس القائم على القدم والباوند والثانية والبايت)",
 "united states department of defense": "البنتاغون, وزارة الدفاع (الإدارة الفيدرالية المسؤولة عن حماية الأمن القومي للولايات المتحدة؛ أنشئت عام 1947)",
 "united states department of state": "وزارة الخارجية, وزارة الخارجية الأمريكية (الإدارة الفيدرالية في الولايات المتحدة التي تضع وتحافظ على السياسات الخارجية)\nمثال: تأسست وزارة الخارجية عام 1789",
 "united states dollar": "دولار أمريكي (وحدة المال الأساسية في الولايات المتحدة)",
 "united states dry unit": "وحدة جافة أمريكية (وحدة لقياس السعة للمواد الجافة معتمدة رسمياً في النظام العرفي الأمريكي)",
 "united states fish and wildlife service": "المؤسسة الأمريكية للأسماك والحياة البرية (وكالة في وزارة الداخلية تحافظ على الأسماك والحياة البرية وموائلها وتحميها؛ تقيم الأثر البيئي للمبيدات الحشرية ومواقع الطاقة النووية والسدود…)",
 "united states government": "الولايات المتحدة, حكومة الولايات المتحدة (الفروع التنفيذية والتشريعية والقضائية للحكومة الفيدرالية للولايات المتحدة)",
 "united states government accounting office": "مكتب المحاسبة الحكومي (وكالة فيدرالية مستقلة غير حزبية تعمل كذراع تحقيق للكونغرس، مما يجعل السلطة التنفيذية مسؤولة أمام الكونغرس والحكومة مسؤولة أمام مواطني الولايات المتحدة)",
 "united states government printing office": "مكتب الطباعة الحكومي الأمريكي (وكالة تابعة للسلطة التشريعية تقدم خدمات الطباعة والتجليد للكونغرس والإدارات والمؤسسات التابعة للحكومة الفيدرالية)",
 "united states house of representatives": "مجلس النواب الأمريكي (المجلس التشريعي الأدنى في الكونغرس الأمريكي)",
 "united states intelligence agency": "وكالة استخبارات أمريكية (جهاز استخبارات في الولايات المتحدة)",
 "united states intelligence community": "مجتمع الاستخبارات (مجموعة من الوكالات والمنظمات الحكومية التي تقوم بأنشطة استخباراتية لحكومة الولايات المتحدة؛ يرأسها مدير الاستخبارات المركزية)",
 "united states liquid unit": "وحدة سائلة أمريكية (وحدة سائلة معتمدة رسمياً في نظام القياس العرفي الأمريكي)",
 "united states marine corps": "مشاة البحرية الأمريكية (فرقة برمائية تابعة للبحرية الأمريكية)",
 "united states marines": "مشاة البحرية الأمريكية (فرقة برمائية تابعة للبحرية الأمريكية)",
 "united states marshals service": "خدمة المارشال الأمريكية (أقدم وكالة إنفاذ قانون فيدرالية في الولايات المتحدة مسؤولة اليوم عن حماية القضاء الفيدرالي ونقل السجناء الفيدراليين وحماية الشهود الفيدراليين وإدارة…)",
 "united states military academy": "الأكاديمية العسكرية الأمريكية (مدرسة لتدريب الرجال والنساء ليصبحوا ضباطاً في جيش الولايات المتحدة)",
 "united states minor outlying islands": "جُزُر الوِلَايَات المُتَّحِدَة الصَغِيرَة النَائِيَة (جَزَرَ الماءُ عن الأَرضِ يَجْزُرُ جَزْراً: نَضَبَ وحَسَرَ؛ ويقال: جَزَرَ البَحْرُ والنَّهْرُ: انْحسرَ ماؤُهُ)\nمثال: ضع الجزر في القدر.",
 "united states naval academy": "الأكاديمية البحرية الأمريكية (مدرسة لتدريب الرجال والنساء ليصبحوا ضباطاً في البحرية الأمريكية)",
 "united states navy": "البحرية الأمريكية (بحرية الولايات المتحدة الأمريكية؛ الوكالة التي تحافظ وتدرب وتجهز القوات البحرية الجاهزة للقتال)",
 "united states of america": "الْوِلَايَات الْمُتَّحِدَة الْأَمْرِيكِيَّة, الْوِلَايَات الْمُتَّحِدَة",
 "united states post office": "مكتب البريد الأمريكي (وكالة مستقلة تابعة للحكومة الفيدرالية مسؤولة عن تسليم البريد (وأحيانًا الاتصالات) بين الأفراد والشركات في الولايات المتحدة)",
 "united states postal inspection service": "خدمة التفتيش البريدي الأمريكي (الذراع الرئيسي لإنفاذ القانون لخدمة البريد الأمريكية)",
 "united states postal service": "خدمة البريد الأمريكية (وكالة فيدرالية مستقلة تقدم خدمة معالجة وتسليم البريد للأفراد والشركات في الولايات المتحدة)",
 "united states president": "الرئيس الأمريكي, رئيس الولايات المتحدة (الشخص الذي يشغل منصب رئيس الدولة في حكومة الولايات المتحدة)\nمثال: يحب الرئيس الركض كل صباح",
 "united states public health service": "دائرة الصحة العامة الأمريكية (وكالة تعمل كمكتب للجراح العام؛ تشمل وكالات مهمتها تحسين الصحة العامة)",
 "united states secret service": "الخدمة السرية الأمريكية (وكالة الاستخبارات الأمريكية التي تحمي الرؤساء ونواب الرئيس الحاليين والسابقين وعائلاتهم المباشرة وتحمي الزوار الأجانب المتميزين؛ تكشف وتقبض على مزوري…)",
 "united states senate": "مجلس الشيوخ الأمريكي (المجلس الأعلى في الكونغرس الأمريكي)",
 "united states supreme court": "المحكمة العليا, المحكمة العليا للولايات المتحدة (أعلى محكمة فيدرالية في الولايات المتحدة؛ لها اختصاص استئنافي نهائي وسلطة قضائية على جميع المحاكم الأخرى في البلاد)",
 "united states trade representative": "الممثل التجاري للولايات المتحدة (الوكالة التنفيذية التي تدير سياسات الرئيس بشأن التجارة الدولية)",
 "united states treasury": "الخزانة الأمريكية, وزارة الخزانة (الإدارة الفيدرالية التي تجمع الإيرادات وتدير المالية الفيدرالية؛ تأسست وزارة الخزانة عام 1789)",
 "united states virgin islands": "جزر العذراء الأمريكية, جزر العذراء التابعة الولايات المتحدة (جَزَرَ الماءُ عن الأَرضِ يَجْزُرُ جَزْراً: نَضَبَ وحَسَرَ؛ ويقال: جَزَرَ البَحْرُ والنَّهْرُ: انْحسرَ ماؤُهُ)\nمثال: ضع الجزر في القدر.",
 "united we stand, divided we fall": "مُتَّحِدِين نَقِف، مُتَفَرِّقِين نَسْقُط",
 "unitedly": "بتعاون, معاً (مع التعاون والتبادل)\nمثال: عملنا معاً في المشروع",
 "uniting": "اتحاد, توحيد (عملية صنع أو صيرورة الشيء وحدة واحدة) / اندماج, دمج (اتحاد شركتين تجاريتين أو أكثر)\nمثال: اتحاد الفصائل المتعارضة",
 "unitisation": "تطوير وحدوي, توحيد (التطوير المشترك لمورد نفطي يمتد عبر أراض تسيطر عليها شركات مختلفة) / توحيد الاستثمار (تحويل صندوق استثمار إلى صندوق استثمار مشترك) / توحيد الشحنات (عملية تعبئة البضائع في وحدات تحميل) / تجميع الوحدات, تقسيم ((علم النفس) تشكيل وحدات أصغر من المعلومات في وحدات منسقة كبيرة)",
 "unitization": "تطوير وحدوي, توحيد (التطوير المشترك لمورد نفطي يمتد عبر أراض تسيطر عليها شركات مختلفة) / توحيد الاستثمار (تحويل صندوق استثمار إلى صندوق استثمار مشترك) / توحيد الشحنات (عملية تعبئة البضائع في وحدات تحميل) / تجميع الوحدات, تقسيم ((علم النفس) تشكيل وحدات أصغر من المعلومات في وحدات منسقة كبيرة)",
 "unity": "وَحْدَة, اِتِّحَاد",
 "univalent": "أحادي التكافؤ (له تكافؤ كيميائي يساوي 1) / أحادي التكافؤ (يستخدم للكروموسوم الذي لا يقترن أو يتحد مع كروموسومه المتماثل أثناء التشابك الصبغي)\nمثال: كروموسوم أحادي التكافؤ",
 "univalve": "بطنيات القدم (طائفة من الرخويات لها عادة صدفة ملفوفة من قطعة واحدة وقدم عضلية مسطحة ورأس يحمل عيوناً ذات سويقات) / أحادي الصدفة (يستخدم للرخويات، خاصة بطنيات القدم، مثل القواقع وغيرها)",
 "univerbation": "نَحْت (وهو القَطْع والبَري والنشر والقشر وتشكيل الخشب أو الحجر أو غيره؛ الشيء الذي نُحِتَ، النقش أو التمثال أو غيره مما كان ناتج النحت)\nمثال: من علمك نحت الخشب.",
 "universal": "كُلِّيَّة (مصدر صناعيّ من كُلّ؛ شمول، مجموع من الأوّل إلى الآخر)\nمثال: في أي كلية تدرس؟",
 "universal agent": "وكيل شامل, وكيل عام (شخص مفوض لإجراء كل أنواع الأعمال للموكل)",
 "universal donor": "متبرع عام",
 "universal gas constant": "ثَابِت الْغَاز, ثَابِت الْغَازَات الْعَامّ (اسم فاعل من ثَبَتَ؛ المُسْتَقِرّ الذي لا يتحرك، ضد المُتَحَرِّك)\nمثال: الشاحنة غير ثابتة.",
 "universal gravitational constant": "ثَابِت الْجَاذِبِيَّة, ثَابِت الْجَذْب الْعَامّ ((في الفيزياء) الثابت العام الذي يربط القوة بالكتلة والمسافة في قانون نيوتن للجاذبية)",
 "universal joint": "مفصل عام, وصلة كاردان (قارنة تربط عمودين دوارين مما يسمح بحرية الحركة في جميع الاتجاهات)\nمثال: في المركبات الآلية، يسمح المفصل العام لعمود التدوير بالتحرك صعوداً وهبوطاً أثناء مرور المركبة فوق المطبات",
 "universal meter": "متر عالمي, متر كاثوليكي (وحدة طول تعادل طول بندول الثواني الحر؛ تختلف عن المتر الحديث بنصف سنتيمتر)",
 "universal metre": "متر عالمي, متر كاثوليكي (وحدة طول تعادل طول بندول الثواني الحر؛ تختلف عن المتر الحديث بنصف سنتيمتر)",
 "universal product code": "الرمز الشريطي, باركود (رمز يتكون من سلسلة من الأشرطة العمودية ذات عرض متغير يتم مسحها بواسطة الليزر؛ تُطبع على عبوات المنتجات الاستهلاكية لتعريف الصنف للحاسوب الذي يوفر…)",
 "universal proposition": "قضية كلية ((منطق) قضية تؤكد شيئاً عن جميع أعضاء فئة ما)",
 "universal quantifier": "سور كلي (محدد منطقي لقضية يؤكد أن القضية صحيحة لجميع أفراد فئة معينة)",
 "universal resource locator": "رابط, عنوان ويب (عنوان صفحة ويب على الشبكة العنكبوتية العالمية)",
 "universal set": "مجموعة شاملة (المجموعة التي تحتوي على جميع العناصر أو الأشياء المعنية في المسألة قيد النظر)\nمثال: جميع المجموعات الأخرى هي مجموعات جزئية من المجموعة الشاملة",
 "universal solvent": "الكاهست, المذيب العام (مذيب عالمي افتراضي سعى إليه الخيميائيون قديماً)",
 "universal suffrage": "اقتراع عام (حق التصويت لجميع البالغين الذين لا تحرمهم قوانين البلاد من ذلك)",
 "universal time": "التوقيت العالمي, توقيت غرينتش (التوقيت المحلي عند خط الصفر المار عبر غرينتش، إنجلترا؛ وهو نفسه في كل مكان)",
 "universal veil": "حجاب شامل (غشاء يغلف في البداية حامل الأبواغ الصغير لفطريات مختلفة بالكامل ويتمزق بالنمو؛ يظهر في الفطر الناضج كغمد حول الجزء السفلي من الساق وحراشف على السطح…)",
 "universalism": "خلاصية شاملة (العقيدة اللاهوتية القائلة بأن جميع الناس سيخلصون في النهاية)",
 "universalist": "شمولي, عالمي (من أو يتعلق بالشمولية أو يميل إليها)",
 "universalistic": "شمولي, عالمي (من أو يتعلق بالشمولية أو يميل إليها) / شمولي, عالمي (من أو متعلق بالكل)",
 "universality": "شُمُولِيَّة, عَالَمِيَّة (صفة كون الشيء عالمياً؛ موجوداً في كل مكان)",
 "universally": "بشكل شامل, عالمياً (في كل حالة)\nمثال: يتفق الناس عالمياً على هذا",
 "universe": "كَوْن, الْكَوْن",
