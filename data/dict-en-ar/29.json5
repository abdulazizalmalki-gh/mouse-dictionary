 "tricholoma pardinum": "تريكولوما نمرية (غاريقون سام له قبعة شاحبة بألياف رمادية دقيقة)",
 "tricholoma pessundatum": "تريكولوما بيسونداتوم (غاريقون سام بشكل خفيف بقبعة بنية محمرة لزجة وخياشيم وساق بيضاء)",
 "tricholoma populinum": "فطر رملي (غاريقون صالح للأكل يثمر في مجموعات كبيرة (خاصة في التربة الرملية تحت أشجار القطن))",
 "tricholoma sejunctum": "تريكولوما سيجونكتوم (غاريقون بقبعة مغطاة بألياف داكنة في المركز ولها حواف مصفرة)",
 "tricholoma vaccinum": "تريكولوما فاكسينوم (غاريقون بقبعة مغطاة بكثافة بألياف محمرة وخياشيم وساق شاحبة)",
 "tricholoma venenata": "تريكولوما سامة (غاريقون أبيض سام)",
 "trichomanes boschianum": "سرخس قدم الأرنب الشائك (نوع من السرخس الشائك)",
 "trichomanes reniforme": "سرخس الكلى (سرخس كبير في نيوزيلندا ذو سعف على شكل كلية)",
 "trichomanes speciosum": "سرخس كيلارني (سرخس قوي كبير في أقصى غرب أوروبا)",
 "trichomonad": "مشعرة (مسبب داء المشعرات في النساء والماشية والطيور)",
 "trichomoniasis": "داء المشعرات (عدوى في المهبل)",
 "trichophaga tapetzella": "عثة السجاد (تتغذى اليرقات على السجاد والمنسوجات الصوفية الأخرى)",
 "trichopteran": "شعريات الأجنحة (ذبابة القمص)",
 "trichopteron": "شعريات الأجنحة (ذبابة القمص)",
 "trichopterous insect": "شعريات الأجنحة (ذبابة القمص)",
 "trichostema dichotomum": "نعناع كاذب (نبات عطري من شرق الولايات المتحدة)",
 "trichostema lanatum": "تجعيدات زرقاء صوفية, مريمية سوداء (نبات عطري بأوراق صوفية يوجد في جنوب كاليفورنيا والمكسيك)",
 "trichostema lanceolatum": "عشبة الخل, عشبة كافور التربنتين (نبات عطري من غرب الولايات المتحدة)",
 "trichosurus vulpecula": "بوسوم كثيف الذيل (بوسوم ذو ذيل كثيف الشعر)",
 "trichotillomania": "هوس نتف الشعر",
 "trichotomy": "انقسام ثلاثي (كون الشيء ثلاثياً؛ تصنيف إلى ثلاثة أجزاء أو فئات فرعية)",
 "trichroism": "ثلاثية اللون (تعدد ألوان لبلورة بحيث تظهر ثلاثة ألوان مختلفة عند النظر إليها من ثلاثة اتجاهات مختلفة)",
 "trichromacy": "إبصار لوني, رؤية الألوان (القدرة الطبيعية على رؤية الألوان)",
 "trichromatic": "ثُلَاثِيّ الأَلْوَان (ذو ثلاثة ألوان)",
 "trichrome": "ثُلَاثِيّ الأَلْوَان (ذو ثلاثة ألوان)",
 "trichuriasis": "داء المسلكات (الإصابة بالديدان الأسطوانية؛ شائعة في المناطق الاستوائية ذات الصرف الصحي السيئ)",
 "trichys lipura": "شيهم طويل الذيل (شيهم من بورنيو وسومطرة ذو أشواك قصيرة وذيل طويل)",
 "trick": "حِيلَة",
 "trick or treat": "خدعة أم حلوى (طلب يقدمه الأطفال في الهالوين؛ حيث يمرون من باب إلى باب يطلبون الحلوى ويهددون بعمل مقالب في من يرفض)",
 "trick question": "سُؤَال خَادِع (سُؤَال)\nمثال: أجب على السؤال.",
 "tricked-out": "مُجَمَّل, مُزَيَّن بِعِنَايَة (مزين بطريقة خاصة ومميزة)",
 "tricker": "صاحب مقالب, مخادع مازح (شخص يقوم بتدبير المقالب والمزاح العملي ضد الآخرين)",
 "trickery": "حيلة, خديعة (استخدام الحيل لخداع شخص ما (عادة لانتزاع المال منه)) / احتيال, تلاعب (تضليل لفظي يهدف إلى استغلالك بطريقة ما)",
 "trickily": "بِاحْتِيَال, بِخُبْث (بطريقة خفية وماكرة)\nمثال: رتب بمكر ليكون هناك عندما أعلن القرار",
 "trickiness": "خِدَاع, صُعُوبَة (صفة التطلب لمهارة أو حذر) / احتيال, مراوغة (صفة الشخص المحتال والمراوغ الذي يصعب الإمساك به)\nمثال: هذه الألغاز مشهورة بصعوبتها",
 "trickle": "تقاطر, تنقيط (التدفق على شكل قطرات؛ تشكل وسقوط قطرات من السائل)\nمثال: هناك تقاطر عبر السقف",
 "trickster": "المخادع (كائن خارق للطبيعة مؤذٍ موجود في فلكلور العديد من الشعوب البدائية؛ يتميز أحياناً بدوافع بيولوجية هائلة وأجزاء جسدية مبالغ فيها) / غشاش, محتال (شخص يجعلك تعتقد شيئاً غير حقيقي) / صاحب مقالب, مخادع مازح (شخص يقوم بتدبير المقالب والمزاح العملي ضد الآخرين)",
 "tricksy": "خَبِيث, مُحْتَال (يتّسم بالمهارة في الخداع والمكر)",
 "tricky": "خَبِيث, مُحْتَال (يتّسم بالمهارة في الخداع والمكر) / مُخَادِع, مُلْتَبِس (يَنْطَوِي عَلَى صُعُوبَة خَفِيَّة) / زَلِق, مَاكِر (لا يمكن الوثوق به؛ مراوغ ومتملص)",
 "triclinic": "ثُلَاثِيّ المَيْل (لديه ثلاثة محاور بلورية غير متساوية تتقاطع بزوايا مائلة)\nمثال: نظام ثلاثي الميل",
 "triclinium": "تريكلينيوم, غرفة طعام رومانية (طاولة طعام تحيط بها أرائك على ثلاثة جوانب في روما القديمة) / ترايكلينيوم, غرفة طعام رومانية (غرفة طعام (خاصة غرفة طعام تحتوي على طاولة طعام مع أرائك على ثلاثة جوانب))",
 "tricolor": "ثُلَاثِيّ الأَلْوَان (ذو ثلاثة ألوان) / علم ثلاثي الألوان (علم به ثلاثة خطوط ملونة (خاصة العلم الفرنسي))",
 "tricolor television tube": "أنبوب تلفزيون ثلاثي الألوان (أنبوب تلفزيون ملون يتم فيه دمج ثلاثة ألوان أساسية لإعطاء النطاق الكامل للألوان)",
 "tricolor tube": "أنبوب تلفزيون ثلاثي الألوان (أنبوب تلفزيون ملون يتم فيه دمج ثلاثة ألوان أساسية لإعطاء النطاق الكامل للألوان)",
 "tricolour": "عَلَم ثُلَاثِيّ الْأَلْوَانِ (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "tricolour television tube": "أنبوب تلفزيون ثلاثي الألوان (أنبوب تلفزيون ملون يتم فيه دمج ثلاثة ألوان أساسية لإعطاء النطاق الكامل للألوان)",
 "tricolour tube": "أنبوب تلفزيون ثلاثي الألوان (أنبوب تلفزيون ملون يتم فيه دمج ثلاثة ألوان أساسية لإعطاء النطاق الكامل للألوان)",
 "tricorn": "قبعة ثلاثية الزوايا (قبعة مرفوعة الحواف تشكل ثلاث زوايا)",
 "tricorne": "قبعة ثلاثية الزوايا (قبعة مرفوعة الحواف تشكل ثلاث زوايا)",
 "tricot": "تريكو (قماش محبوك أو قماش يشبه الحياكة)",
 "tricuspid": "ثُلَاثِيُّ الشُّرَف (ذو ثلاث شُرَف أو نتوءات حادّة؛ خاصّة في الأسنان الطاحنة)",
 "tricuspid valve": "صمام ثلاثي الشرف (صمام ذو ثلاث شرفات؛ يقع بين الأذين الأيمن والبطين الأيمن؛ يسمح للدم بالمرور من الأذين إلى البطين ويغلق لمنع التدفق العكسي عند انقباض البطين)",
 "tricuspidate": "ثُلَاثِيُّ الشُّرَف (ذو ثلاث شُرَف أو نتوءات حادّة؛ خاصّة في الأسنان الطاحنة)",
 "tricycle": "دراجة ثلاثية العجلات (مركبة بثلاث عجلات يتم تحريكها بواسطة دواسات القدم)",
 "tricyclic": "مضاد اكتئاب ثلاثي الحلقات (دواء مضاد للاكتئاب يعمل عن طريق منع استرداد النوربينفرين والسيروتونين وبالتالي إتاحة المزيد من هذه المواد للعمل على المستقبلات في الدماغ)",
 "tricyclic antidepressant": "مضاد اكتئاب ثلاثي الحلقات (دواء مضاد للاكتئاب يعمل عن طريق منع استرداد النوربينفرين والسيروتونين وبالتالي إتاحة المزيد من هذه المواد للعمل على المستقبلات في الدماغ)",
 "tricyclic antidepressant drug": "مضاد اكتئاب ثلاثي الحلقات (دواء مضاد للاكتئاب يعمل عن طريق منع استرداد النوربينفرين والسيروتونين وبالتالي إتاحة المزيد من هذه المواد للعمل على المستقبلات في الدماغ)",
 "tridacna gigas": "محار عملاق (محار كبير يسكن الشعاب المرجانية في جنوب المحيط الهادئ ويزن ما يصل إلى 500 رطل)",
 "trident": "رمح ثلاثي الشعب (رمح له ثلاثة رؤوس مدببة)",
 "tridymite": "تريديميت (شكل معدني من السيليكا)",
 "tried": "مُجَرَّب, مُخْتَبَر (تَمَّ اخْتِبَارُهُ وَثَبَتَتْ مَوْثُوقِيَّتُهُ) / مُجَرَّب, مُخْتَبَر (تمّ اختباره وثبتت فائدته أو صحّته)",
 "tried and true": "مُجَرَّب, مُخْتَبَر (تَمَّ اخْتِبَارُهُ وَثَبَتَتْ مَوْثُوقِيَّتُهُ)",
