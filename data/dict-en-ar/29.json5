 "traffic cop": "شُرْطِيّ مُرُور (شرطي ينظم حركة مرور السيارات)",
 "traffic court": "محكمة المرور (محكمة لديها سلطة الملاحقة القضائية لمخالفات المرور)",
 "traffic island": "جزيرة مرورية (منطقة محددة في الطريق يُمنع مرور السيارات فيها؛ توفر منطقة آمنة للمشاة)",
 "traffic jam": "اِزْدِحَام الْمُرُور, اِخْتِنَاق مُرُورِيّ",
 "traffic lane": "حارة مرورية, مسار (حارة في طريق رئيسي محددة بخطوط مرسومة)\nمثال: تلك السيارة في الحارة المرورية الخاطئة",
 "traffic light": "إِشَارَة مُرُور / إِشَارَة ضَوْئِيَّة",
 "traffic pattern": "نمط الاقتراب, نمط المرور الجوي (المسار المحدد لطائرة تستعد للهبوط في مطار)\nمثال: أنماط المرور حول أوهير مزدحمة جداً",
 "traffic sign": "لَافِتَة مُرُور, عَلَامَة طَرِيق",
 "traffic signal": "إشارة المرور, ضوء المرور (إشارة بصرية للتحكم في تدفق حركة المرور عند التقاطعات)",
 "trafficator": "إشارة الانعطاف, غمّاز (ضوء وامض في مركبة بمحرك يشير إلى الاتجاه الذي توشك المركبة على الانعطاف إليه)",
 "trafficker": "بائع, مروّج (شخص يروج أو يتبادل البضائع أو الخدمات مقابل المال)",
 "tragedian": "ممثل تراجيدي (ممثل يتخصص في الأدوار التراجيدية) / كاتب تراجيدي (كاتب (وخاصة كاتب مسرحي) يكتب التراجيديا)",
 "tragedienne": "ممثلة تراجيدية (ممثلة تتخصص في الأدوار التراجيدية)",
 "tragedy": "مَأْسَاة, تْرَاجِيدْيَا / تْرَاجِيدْيَا / مَأْسَاة, فَاجِعَة",
 "tragelaphus angasi": "نيالا (ظبي جنوب أفريقي ذو قرون لولبية مع هامش من الشعر الأبيض على طول الظهر والرقبة)",
 "tragelaphus buxtoni": "نيالا الجبل (ظبي أشعث يعيش في جبال إثيوبيا)",
 "tragelaphus eurycerus": "بونغو (ظبي غابات كبير في وسط أفريقيا ذو معطف بني محمر بخطوط بيضاء وقرون لولبية)",
 "tragelaphus imberbis": "كودو أصغر (نوع أصغر من الكودو)",
 "tragelaphus scriptus": "بوشبوك, ظبي الشجيرات (ظبي بعلامات بيضاء تشبه السرج وقرون ملتوية)",
 "tragelaphus strepsiceros": "كودو أكبر (نوع من الكودو)",
 "tragic": "مَأْسَاوِيّ, تْرَاجِيدِيّ",
 "tragic flaw": "الخطيئة المأساوية, العيب المأساوي (عيب الشخصية أو خطأ البطل المأساوي الذي يؤدي إلى سقوطه)",
 "tragical": "فَاجِع, مَأْسَاوِيّ (بالغ الحزن؛ خاصة ما يتضمن الأسى أو الموت أو الدمار)",
 "tragically": "بِشَكْل فَاجِع, بِمَأْسَاوِيَّة (بطريقة مأساوية؛ مع عواقب مأساوية)\nمثال: انتهت المغامرة بشكل مأساوي",
 "tragicomedy": "تراجيكوميديا, كوميديا جادة (كوميديا ذات عناصر أو نغمات جادة) / تراجيكوميديا, مأساة ملهاة (مؤلف درامي يتضمن عناصر من كل من المأساة والملهاة وعادة ما تسود المأساة)",
 "tragicomic": "مَأْسَاهَزْلِيّ (يجمع بين الطابع المُؤثّر والمُضحك في آنٍ واحد) / تْرَاجِيكُومِيدِيّ (يجمع بين الجانبين المأساوي والهزلي معاً) / تراجيكوميدي, مأساوي هزلي (من أو يتعلق بالتراجيديا الكوميدية أو يميزها)\nمثال: كاتب مسرحي متخصص في الدراما التراجيكوميدية",
 "tragicomical": "مَأْسَاهَزْلِيّ (يجمع بين الطابع المُؤثّر والمُضحك في آنٍ واحد) / تْرَاجِيكُومِيدِيّ (يجمع بين الجانبين المأساوي والهزلي معاً)",
 "tragifarce": "تراجيفارس, مهزلة مأساوية (شكل متطرف من التراجيكوميديا (الكوميديا المأساوية))",
 "tragopan": "تراجوبان (تدرج آسيوي زاهي الألوان له دلايات وزائدتان لحميتان على الرأس)",
 "tragopogon dubius": "تيس الجبل الأصفر, ساسفي أصفر (نبات معمر أوروبي مستوطن في جميع أنحاء الولايات المتحدة له سيقان مجوفة مع عدد قليل من الأوراق الضيقة الطويلة المدببة ويحمل كل منها زهرة صفراء شاحبة…)",
 "tragopogon porrifolius": "تيس الجبل, ساسفي (عشب متوسطي ثنائي الحول برؤوس طويلة العنق من أزهار شعاعية أرجوانية وعصارة لبنية وجذر طويل صالح للأكل؛ مستوطن في جميع أنحاء الولايات المتحدة)",
 "tragopogon pratensis": "ساسفي المروج, لحية التيس (نبات حولي أوروبي ضار بأزهار صفراء؛ مستوطن في الولايات المتحدة)",
 "tragulus javanicus": "نابو (طرغول أكبر قليلاً من الكانشيل؛ يوجد في الهند والملايو)",
 "tragulus kanchil": "كانشيل (طرغول صغير يعيش في جنوب شرق آسيا)",
 "tragus": "زنمة (سديلة غضروفية صغيرة أمام الفتحة الخارجية للأذن)",
 "trail": "جَرَّ (جَرَّ الحيوانَ وغيرَه: جذبه وسحبه؛ جَرَّ أذيالَه: تبختر، زها بنفسه، اختال) / أَثَر (عَلَامَة؛ بَقِيَّة؛ رَسْم مُتَخَلَّف من شيء ما؛ تأثير؛ انطباع) / مَسْلَك (المَسْلَك: الطريقُ سلكنا مَسْلكًا لم يسلكه أحد من قبل ، - مسالك الجبال ، - هذا مَسْلك وعر؛ المَسْلَك: سلوك، تصرُّف)\nمثال: اضطررت إلى جر سامي.",
 "trail bike": "دراجة نارية للطرق الوعرة (دراجة نارية خفيفة الوزن مجهزة بإطارات ونظام تعليق متين؛ دراجة نارية للطرق الوعرة مصممة للركوب عبر البلاد أو فوق الأرض غير المعبدة)",
 "trail boss": "قائد قطيع الماشية (الشخص المسؤول عن قيادة قطيع من الماشية)",
 "trail head": "بداية المسار (بداية طريق أو مسار مشي)",
 "trail of tears": "دَرْب الدُّمُوع (الدَّرْبُ: كُلُّ طريقٍ يصلُ بين مكانَيْن. يقال: مَنْ سار على الدَّرب وصل : معناه أنّ المهارة تكتسبُ بالمِران؛ الدَّرْبُ: المَضيقُ في الجبال الْمَضْيَقُ فِي الجَبَلِ)\nمثال: درب على يد خبير.",
 "trail riding": "ركوب في المسارات الوعرة (الركوب على طول مسار وعر)",
 "trailblazer": "رائد, سبّاق (شخص يساعد في فتح مجال جديد للبحث أو التكنولوجيا أو الفن) / رائد طريق, واضع علامات الطريق (شخص يحدد المسار بوضع علامات على الأشجار)",
 "trailer": "مَقْطُورَة / تَشْوِيقَة",
 "trailer camp": "مخيم مقطورات (مخيم يمكن فيه استئجار مساحة لمقطورات المنازل؛ تتوفر المرافق عموماً)",
 "trailer park": "مخيم مقطورات (مخيم يمكن فيه استئجار مساحة لمقطورات المنازل؛ تتوفر المرافق عموماً)",
 "trailer truck": "تريلا, شاحنة مقطورة (شاحنة تتكون من جرار ومقطورة معاً)",
 "trailhead": "بداية المسار (بداية طريق أو مسار مشي)",
 "trailing": "تتبع الأثر, ملاحقة (ملاحقة (شخص أو حيوان) باتباع الآثار أو العلامات التي تركوها وراءهم)",
 "trailing arbutus": "زهرة مايو, قطلب زاحف (شجيرة دائمة الخضرة منخفضة النمو من شرق أمريكا الشمالية ذات أوراق جلدية وعناقيد من الزهور العطرية الوردية أو البيضاء)",
 "trailing axle": "محور تابع, محور خلفي (في قاطرة بخارية، محور يربط زوجاً مقترناً من العجلات غير المزودة بالطاقة ويقع خلف عجلات القيادة)",
 "trailing edge": "حافة خلفية (الحافة الخلفية لسطح انسيابي (مثل الجناح))",
 "trailing four o'clock": "أليونيا, شب الليل الزاحف (نبات زاحف له عناقيد مزدحمة من 3 أزهار وردية داكنة لامعة تشبه زهرة واحدة تتفتح بالقرب من الأرض؛ جنوب غرب الولايات المتحدة والمكسيك)",
 "trailing windmills": "أليونيا, شب الليل الزاحف (نبات زاحف له عناقيد مزدحمة من 3 أزهار وردية داكنة لامعة تشبه زهرة واحدة تتفتح بالقرب من الأرض؛ جنوب غرب الولايات المتحدة والمكسيك)",
 "train": "ذَيْل (ذَيَّلَ (ذيله): جعل له ذيلا؛ (ذَيَّلَ) أطال ذيله وطوله. ويقال ذيل كتابه أو كلامه: أردفه بكلام كالتتمة له) / قَافِلَة (مؤنث القافل؛ الراجعة؛ جماعة من الناس تسير معًا مع أمتعتها وركوبها في سفر قافلين كانوا أو خارجين. سميّت كذلك تفائلا برجوعها) / تَدَرَّبَ, تَمَرَّنَ / دَرَّبَ, درب (الدَّرْبُ: كُلُّ طريقٍ يصلُ بين مكانَيْن. يقال: مَنْ سار على الدَّرب وصل : معناه أنّ المهارة تكتسبُ بالمِران؛ الدَّرْبُ: المَضيقُ في الجبال الْمَضْيَقُ فِي الجَبَلِ) / درب, أهل (الدَّرْبُ: كُلُّ طريقٍ يصلُ بين مكانَيْن. يقال: مَنْ سار على الدَّرب وصل : معناه أنّ المهارة تكتسبُ بالمِران؛ الدَّرْبُ: المَضيقُ في الجبال الْمَضْيَقُ فِي الجَبَلِ)\nمثال: للبقرة ذيل طويل.",
 "train depot": "محطة سكة حديد, محطة قطار (محطة طرفية حيث تقوم القطارات بتحميل أو تفريغ الركاب أو البضائع)",
 "train dispatcher": "مدير الساحة, ناظر المحطة (موظف سكة حديد مسؤول عن ساحة القطارات)",
 "train fare": "أجرة القطار, تذكرة قطار (الأجرة المفروضة للسفر بالقطار)",
 "train of thought": "تسلسل الأفكار, حبل الأفكار (الروابط التي تربط أجزاء مختلفة من حدث أو حجة معاً)\nمثال: لم أستطع متابعة حبل أفكاره",
 "train oil": "زيت الحوت (زيت أبيض إلى بني يتم الحصول عليه من شحم الحوت؛ كان يستخدم سابقاً للإضاءة)",
 "train set": "مجموعة قطار (لعبة تتكون من نماذج صغيرة لقطارات السكك الحديدية والمسار الذي تسير عليه)",
 "train station": "محطة سكة حديد, محطة قطار (محطة طرفية حيث تقوم القطارات بتحميل أو تفريغ الركاب أو البضائع)",
 "train ticket": "تذكرة قطار (تذكرة صالحة لركوب القطار)",
 "trainband": "فرقة مدربة (سرية ميليشيا في إنجلترا أو أمريكا من القرن السادس عشر إلى القرن الثامن عشر)",
 "trainbandsman": "عضو ميليشيا مدنية (عضو ذكر في فرقة تدريب عسكرية مدنية)",
 "trainbearer": "حامل الذيل (شخص يمسك بذيل الثوب أو الرداء في مناسبة احتفالية)",
 "trained": "مُدَرَّب",
 "trained nurse": "ممرضة خريجة, ممرضة مؤهلة (شخص أكمل الدورة الدراسية (بما في ذلك الممارسة في المستشفى) في مدرسة لتدريب الممرضات)",
 "trained worker": "حِرَفِيّ, عَامِل مَاهِر (عامل اكتسب مهارات متخصّصة)",
 "trainee": "مُتَدَرِّب, مُتَدَرِّبَة",
 "traineeship": "منحة تدريبية (مساعدة مالية تمكنك من الحصول على تدريب لوظيفة محددة)\nمثال: قدم مشروع القانون منحاً تدريبية في إعادة التأهيل المهني",
 "trainer": "مُدَرِّب, مُدَرِّبَة",
 "training": "تَدْرِيب, تَمْرِين (تزويدُ الدَّارسين بالدّراسات العلميَّة والعمليّة التي تؤدِّي إلى رفع درجة المهارة عندهم في أداء واجبات الوظيفة؛ إعداد شخص أو مجموعة لتأدية مهمة أو وظيفة معينة)\nمثال: واصل زيري التدريب.",
 "training college": "كلية تدريب (مدرسة توفر التدريب في مجال أو مهنة خاصة)",
 "training program": "برنامج تدريبي (برنامج مصمم للتدريب على مهارات محددة)",
 "training school": "إصلاحية, دار رعاية الأحداث (مؤسسة إصلاحية لاحتجاز وتأديب وتدريب الأحداث أو المجرمين لأول مرة) / مدرسة تدريب (مدرسة توفر تدريباً مهنياً وتقنياً عملياً)",
 "training ship": "سفينة تدريب (سفينة تستخدم لتدريب الطلاب كبحارة)",
 "training table": "مائدة التدريب (وجبات مخططة للرياضيين أثناء التدريب (تقدم عادة في قاعة طعام مخصصة))",
 "trainload": "حمولة قطار (الكمية التي يمكن أن يحملها قطار)",
 "trainman": "عامل سكة حديد, موظف قطار (موظف ذكر يعمل في السكك الحديدية)",
 "trainmaster": "مدير الساحة, ناظر المحطة (موظف سكة حديد مسؤول عن ساحة القطارات)",
 "trainwoman": "عاملة سكة حديد (موظفة أنثى تعمل في السكك الحديدية)",
 "trait": "صِفَة, شِيْمَة (صُفَّة المَسْجِد هي موضع مُظَلَّل منه بين جدران ثلاثة؛ هي غُرْفَة ذات ثلاث جُدْرَان وسَقْف والإتجاه الرابع مَفْتُوح بلا بِنَاء. تستخدم غالبا للجلوس وتواجه صَحْن البَيْت)\nمثال: محاسبة النفس صفة حميدة.",
 "traitor": "خَائِن, خَائِنَة (الشخص الذي قام بالخِيَانَة)\nمثال: نمر مفترس أمامك خير من خائن ورائك!",
 "traitorous": "خَائِن, غَدَّار (ذُو طَبِيعَة خِيَانِيَّة أَوْ مِنْ سِمَات الخَوَنَة)",
 "traitorously": "بشكل خائن, خيانةً (بطريقة غير مخلصة وعديمة الوفاء)\nمثال: لقد تصرف بغدر",
 "traitorousness": "تَآمُر, خِيَانَة عُظْمَى (عدم الولاء عن طريق السلوك التخريبي)",
 "traitress": "خائنة (خائنة أنثى)",
 "trajectory": "مَسَار (المَسَار: اسم مكان من سارَ : مسلك ، طريق ؛ خَطُّ السَّيْر؛ مَسَار كوكب حول الشَّمس : مدار)\nمثال: هذا من شأنه أن يضع العاصفة في مسار تصادم افتراضي مع بركان كيلويا ، في الجزء الجنوبي من الجزيرة.",
 "tralatitious": "مَنْقُول, مُتَوَارَث (اِنْتَقَلَ مِنْ جِيلٍ إِلَى جِيل)",
 "tralee": "ترالي",
 "tram": "تْرَام, تْرَامْوَاي",
 "tramcar": "ترام, قطار شوارع (مركبة بعجلات تسير على قضبان وتدفع بالكهرباء) / عربة منجم (عربة بأربع عجلات تسير على قضبان في منجم)\nمثال: تحمل عربة المنجم الفحم خارج منجم الفحم",
 "tramline": "سكة الترام, مسار الترام (المسار أو السكة التي تسير عليها عربات الترام)",
 "trammel": "صفد, قيد (قيد يحد أو يقيد الحرية (خاصة شيء يستخدم لربط أو تقييد سجين)) / قيد (قيد يستخدم لتعليم الحصان المشي ببطء) / خطاف القدر (خطاف قابل للتعديل يوضع في الموقد لتعليق القدور) / شبكة ثلاثية الطبقات, شرك (شبكة صيد ذات ثلاث طبقات؛ الطبقتان الخارجيتان ذات فتحات واسعة والطبقة الداخلية الفضفاضة ذات فتحات دقيقة)",
 "trammel net": "شبكة ثلاثية الطبقات, شرك (شبكة صيد ذات ثلاث طبقات؛ الطبقتان الخارجيتان ذات فتحات واسعة والطبقة الداخلية الفضفاضة ذات فتحات دقيقة)",
 "tramontana": "رياح ترامونتانا (رياح باردة وجافة تهب جنوباً من الجبال إلى إيطاليا وغرب البحر الأبيض المتوسط)",
 "tramontane": "عَبْر الجَبَل, مَا وَرَاء الجَبَل (على أو قادم من الجانب الآخر من الجبال (من المتحدث)) / عَابِرٌ لِلْحُدُود, وَرَاءَ الجِبَال (قَادِمٌ مِنْ بَلَدٍ آخَرَ) / رياح ترامونتانا (رياح باردة وجافة تهب جنوباً من الجبال إلى إيطاليا وغرب البحر الأبيض المتوسط)\nمثال: القسم الواقع وراء الجبل من الولاية",
 "tramp": "تنزه جبلي, سير طويل (مشي طويل عادة للرياضة أو المتعة) / سفينة شحن متجولة (باخرة تجارية للإيجار؛ ليس لها جدول زمني منتظم) / دوس, وقع أقدام ثقيلة (وقع أقدام ثقيل) / رحالة, متجول (مسافر على الأقدام؛ شخص يذهب في نزهة طويلة (للمتعة))\nمثال: تستمتع بنزهة جبلية في وقت فراغها",
 "tramp steamer": "سفينة شحن متجولة (باخرة تجارية للإيجار؛ ليس لها جدول زمني منتظم)",
 "tramp's spurge": "فربيون بري, فربيون مزهر (فربيون معمر شائع في الولايات المتحدة ذو قنابات بيضاء مبهرجة تشبه البتلات)",
 "tramper": "رحالة, متجول (مسافر على الأقدام؛ شخص يذهب في نزهة طويلة (للمتعة)) / داهس, ضارب بقدمه (شخص يمشي بمشية ثقيلة صاخبة أو يضرب بقدمه على الأرض)",
 "trample": "دَعَسَ, وَطِئَ (الدَّعْسُ، كالمَنْعِ: حَشْوُ الوِعَاءِ، وَقد دَعَسَه: حَشَاهُ. والدَّعْسُ: شِدَّةُ الَوطْء)",
 "trampler": "داهس, ضارب بقدمه (شخص يمشي بمشية ثقيلة صاخبة أو يضرب بقدمه على الأرض) / دائس (شخص يصيب الآخرين بالدوس عليهم)",
 "trampling": "دوس, وطء (صوت الدوس الثقيل أو الخبط)\nمثال: سمع وطء العديد من الأقدام",
 "trampoline": "مِنَطَّة",
 "tramway": "سكة الترام, مسار الترام (المسار أو السكة التي تسير عليها عربات الترام) / ترامواي, تلفريك (وسيلة نقل تنقل الركاب أو البضائع في عربات معلقة بكابلات ومحمولة بواسطة سلسلة من الأبراج)",
 "trance": "ترانس",
 "trance music": "موسيقى الترانس (مُوسِيقى، فنُّ تأليف الألحان وتوزيعها وإيقاعها والغناء والتطريب بضروب المعازف؛ علم الموسيقى : علمٌ يُبحَثُ فيه عن أُصَول النغم من حيث تأَتلف أَو تتنافر، وأَحوال الأَزمنة المتخللة بينها، ليُعلَمَ كيف يؤلَّف اللَّحْن)\nمثال: أتعلم الموسيقى.",
 "trancelike": "فِي غَيْبُوبَة, كَالمَسْحُور (كأنّه في حالة نشوة أو غيبوبة)",
 "tranche": "شريحة (جزء من شيء ما (خاصة المال))",
 "trandate": "ترانديت, لابيتاول (دواء خافض لضغط الدم (الأسماء التجارية ترانديت وغيرها) يمنع مستقبلات ألفا وبيتا الأدرينالية للجهاز العصبي الودي (مما يؤدي إلى انخفاض في ضغط الدم))",
 "trandolapril": "تراندولابريل, مافيك (دواء مثبط للإنزيم المحول للأنجيوتنسين (الاسم التجاري مافيك) يستخدم لدى بعض المرضى بعد نوبة قلبية أو لعلاج ارتفاع ضغط الدم)",
 "tranquil": "رَاكِد, سَاجٍ ((عَنْ جِسْمٍ مَائِيّ) خَالٍ مِنَ الاضْطِرَاب بِسَبَب الأَمْوَاج الكَبِيرَة) / سَاكِن, هَادِئ (غير مضطرب؛ يحافظ على ضبط النفس)",
 "tranquilising": "مُسَكِّن, مُهَدِّئ (يميل إلى التهدئة أو التسكين)",
 "tranquility": "سكينة, طمأنينة (طبع خالٍ من التوتر أو الانفعال) / سكون, طمأنينة (حالة من السلام والهدوء) / سكينة, هدوء (حالة خالية من المتاعب والاضطرابات)",
 "tranquilizer": "عقار مهدئ, مهدئ أعصاب (دواء يستخدم لتقليل التوتر أو الشد العصبي دون تقليل الوضوح العقلي)",
 "tranquilizing": "مُسَكِّن, مُهَدِّئ (يميل إلى التهدئة أو التسكين)",
 "tranquilliser": "عقار مهدئ, مهدئ أعصاب (دواء يستخدم لتقليل التوتر أو الشد العصبي دون تقليل الوضوح العقلي)",
 "tranquillising": "مُسَكِّن, مُهَدِّئ (يميل إلى التهدئة أو التسكين)",
 "tranquillity": "سكينة, طمأنينة (طبع خالٍ من التوتر أو الانفعال) / سكون, طمأنينة (حالة من السلام والهدوء) / سكينة, هدوء (حالة خالية من المتاعب والاضطرابات)",
 "tranquillizer": "عقار مهدئ, مهدئ أعصاب (دواء يستخدم لتقليل التوتر أو الشد العصبي دون تقليل الوضوح العقلي)",
 "tranquillizing": "مُسَكِّن, مُهَدِّئ (يميل إلى التهدئة أو التسكين)",
 "tranquilly": "بسكينة, بطمأنينة (دون اضطراب عاطفي)\nمثال: واصلت عملها بسكينة",
 "trans fatty acid": "حمض دهني متحول (حمض دهني تم إنتاجه عن طريق هدرجة حمض دهني غير مشبع؛ يوجد في الأطعمة المصنعة مثل السمن)",
 "trans woman": "مُتَحَوِّلَة, عَابِرَة",
 "transactinide": "ما بعد الأكتينيدات (متعلق بالعناصر ذات الأعداد الذرية الأكبر من 103) / عنصر ما بعد الأكتينيدات (أي من العناصر المنتجة صناعياً ذات الأعداد الذرية الأكبر من 103)",
 "transaction": "صَفْقَة (عَقْد، اتِّفَاق؛ ضرب اليدين عند العقد) / مُعَامَلَة (كيفية التَصَرُّف مع الآخرين ومدى احترامهم أو خلافه؛ عند الفقهاء: العَقْد على العَمَل ببعض الخارج مع سائِر شرائِط جوازها. وتُطَلق المعاملات على الأحكام الشرعية المتعلّقة بأمر الدنيا باعتبار بقاءِ الشخص…)\nمثال: إنها صفقة جيدة.",
 "transaction cost": "تكلفة المعاملة (تكلفة المشاركة في السوق)",
 "transaction file": "ملف التفاصيل, ملف المعاملات ((علوم الحاسوب) ملف حاسوبي يحتوي على بيانات مؤقتة نسبياً حول مهمة معالجة بيانات معينة)",
 "transactional immunity": "حصانة المعاملات (شكل أوسع من حصانة الاستخدام يحمي الشاهد أيضاً من أي ملاحقة قضائية تتعلق بالمعاملات التي أدلى بشهادته حولها)",
 "transactions": "محضر, مداولات (وصف مكتوب لما دار في اجتماع ما)",
 "transactor": "القائم بالمعاملة, مفاوض (شخص يدير أو يقوم بأعمال تجارية أو مفاوضات)",
 "transalpine": "عَبْر جِبَال الأَلْب (واقع على الجانب الآخر من جبال الألب؛ شمال الألب بالنسبة لإيطاليا) / ساكن ما وراء الألب (شخص يعيش في أو قادم من الجانب الآخر لجبال الألب بالنسبة لإيطاليا)",
 "transaminase": "ترانساميناز (فئة من الترانسفيرازات التي تحفز نقل الأمين (تنقل مجموعة أمين من حمض أميني إلى مركب آخر))",
 "transamination": "نقل الأمين (عملية نقل مجموعة أمينية من مركب إلى آخر) / نقل الأمين الداخلي (عملية تغيير موضع مجموعة أمينية داخل مركب كيميائي)",
 "transatlantic": "عبر الأطلسي (عابر للمحيط الأطلسي)\nمثال: رحلة عبر الأطلسي",
 "transcendence": "تسامي, تعالي (حالة التفوق أو التجاوز أو تخطي الحدود المعتادة) / تسام, تعال (حالة من الوجود فوق حدود التجربة المادية وخارجها)",
 "transcendency": "تسامي, تعالي (حالة التفوق أو التجاوز أو تخطي الحدود المعتادة) / تسام, تعال (حالة من الوجود فوق حدود التجربة المادية وخارجها)",
 "transcendent": "مُتَسَامٍ, مُتَعَالٍ (يتجاوز نطاق التجربة الإنسانية العادية أو يفوق الإدراك) / فَائِق, مُتَعَالٍ (يتجاوز الحدود المعتادة لا سيما في التفوق)",
 "transcendental": "متسام",
 "transcendental number": "عَدَد مُتَسَامٍ (عدد غير نسبي ليس جبرياً (لا يمكن أن يكون حلاً لمعادلة جبرية))",
 "transcendental philosophy": "تسامي, فلسفة متعالية (أي نظام فلسفي يؤكد على الحدسي والروحي فوق التجريبي والمادي)",
 "transcendentalism": "تسامي, فلسفة متعالية (أي نظام فلسفي يؤكد على الحدسي والروحي فوق التجريبي والمادي)",
 "transcendentalist": "ترانسندنتالي, متسامي (مدافع عن الفلسفة المتعالية (الترانسندنتالية))",
 "transcendentally": "بشكل متعال, فائقاً للطبيعة (بطريقة متعالية أو إلى حد متعال)",
 "transcontinental": "عَابِر لِلْقَارَّة (يمتد عبر القارة أو يعبرها أو يقع على الجانب الآخر منها)",
 "transcortical aphasia": "حبسة عبر القشرة (مصطلح عام للحبسة الناتجة عن آفات خارج منطقة بروكا أو منطقة فيرنيكه في القشرة الدماغية)",
 "transcribed": "مُسَجَّل لِلبَثّ, مُعَلَّب (تَمَّ تَسْجيلُه مُسْبَقًا لِلبَثّ الإِذاعِيّ أَوْ التِّلْفِزْيُونِيّ)",
 "transcriber": "مُبَيِّض",
 "transcript": "نُسْخَة",
 "transcriptase": "بوليميراز الحمض النووي الريبوزي, ترانسكريبتيز",
 "transcription": "كَرْشَنَة, نَقْصَوَة",
 "transcultural": "عابر للثقافات (يمتد عبر جميع الثقافات البشرية)\nمثال: مثل أعلى عابر للثقافات للحرية يشمل جميع شعوب العالم",
 "transcutaneous": "عبر الجلد (عبر الجلد السليم؛ يشير إلى الأدوية التي توضع مباشرة على الجلد (كريمات أو مراهم) أو بأشكال ممتدة المفعول (لصقات جلدية))\nمثال: إستروجين عبر الجلد",
 "transdermal": "عبر الجلد (عبر الجلد السليم؛ يشير إلى الأدوية التي توضع مباشرة على الجلد (كريمات أو مراهم) أو بأشكال ممتدة المفعول (لصقات جلدية))\nمثال: إستروجين عبر الجلد",
 "transdermal patch": "لصقة جلدية (لبادة لاصقة طبية توضع على الجلد لامتصاص جرعة دواء محددة زمنياً في مجرى الدم)",
 "transdermic": "عبر الجلد (عبر الجلد السليم؛ يشير إلى الأدوية التي توضع مباشرة على الجلد (كريمات أو مراهم) أو بأشكال ممتدة المفعول (لصقات جلدية))\nمثال: إستروجين عبر الجلد",
 "transducer": "محول طاقة (جهاز كهربائي يحول شكلاً من أشكال الطاقة إلى آخر)",
 "transducing vector": "ناقل توصيل الجينات, ناقل جيني (ناقل لتوصيل الجينات إلى داخل الخلايا)",
 "transduction": "تحويل الطاقة (العملية التي يقبل بها محول الطاقة الطاقة بشكل ما ويعيد طاقة ذات صلة بشكل مختلف) / تحويل, نقل جيني ((علم الوراثة) عملية نقل المادة الوراثية من خلية إلى أخرى بواسطة بلازميد أو عاثية)\nمثال: تحويل الموجات الصوتية إلى فولتية بواسطة ميكروفون",
 "transept": "جناح الكنيسة, مجاز مستعرض (هيكل يشكل الجزء المستعرض للكنيسة المصلبة؛ يقطع صحن الكنيسة بزوايا قائمة)",
 "transeunt": "عابر, متعدٍ (لفعل عقلي؛ يسبب آثاراً خارج العقل)",
 "transexual": "متحول جنسياً, مغاير الجنس (شخص تتماهى هويته الجنسية تماماً مع الجنس الآخر) / متحول جنسياً (شخص خضع لعملية تغيير الجنس)",
 "transfeminism": "نِسْوِيَّة الْعَابِرَات",
 "transfer": "حَوَّلَ (جَعَلَ الشيءَ غير ما كان؛ نقل الشيء من موضع إلى آخر) / اِنْتِقَال\nمثال: رقصنا حول النار.",
 "transfer agent": "وكيل تحويل (وكالة (عادة ما تكون بنكاً) يتم تعيينها من قبل شركة للاحتفاظ بسجلات مالكي الأسهم والسندات وحل المشكلات المتعلقة بالشهادات)",
 "transfer of training": "نقل التدريب, نقل التعلم (تطبيق مهارة تم تعلمها في موقف ما على موقف مختلف ولكنه مشابه)",
 "transfer paper": "ورق نقل (ورق مطلي بمستحضر لنقل تصميم إلى سطح آخر)",
 "transfer payment": "مدفوعات تحويلية (إنفاق عام (كما هو الحال بالنسبة لتعويضات البطالة أو مزايا المحاربين القدامى) ليس مقابل سلع وخدمات)",
 "transfer rna": "حمض نووي ريبوزي ناقل (أصبح حامضًا، تغير الطعم إلى الحموضة؛ ارتفعت نسبة الحموضة في شيء ما، كما في الطعام أو السوائل)\nمثال: رمى ياني الحمض على وجه سكورة.",
 "transfer tax": "ضريبة نقل الملكية (أي ضريبة تفرض على نقل سند ملكية الممتلكات)",
 "transferability": "قَابِلِيَّة لِلتَّحْوِيل, قَابِلِيَّة لِلنَّقْل (صفة القابلية للنقل أو التبادل)",
 "transferable": "قَابِل لِلتَّحْوِيل, قَابِل لِلتَّدَاوُل (يمكن نقل ملكيته قانونياً إلى شخص آخر) / قَابِلٌ لِلنَّقْل, مُتَحَرِّك (يُمْكِنُ نَقْلُهُ أَوْ تَحْوِيلُهُ مِنْ مَكَانٍ لِآخَر)",
 "transferase": "ترانسفيراز (أي من الإنزيمات المختلفة التي تنقل مجموعة كيميائية من مركب إلى مركب آخر)",
 "transferee": "مَنْقُول, مُحَوَّل (شخص ينتقل أو يتم نقله من منصب إلى آخر) / المحال إليه ((قانون) شخص يُنقل إليه سند ملكية أو ممتلكات)\nمثال: كان أفضل طالب منقولاً من جامعة ولاية لويزيانا",
 "transference": "تحويل, نقل (فعل نقل شيء ما من شكل إلى آخر) / تحويل, نقل (نقل الملكية) / تحويل, نقل ((في التحليل النفسي) العملية التي يتم من خلالها تمرير المشاعر أو إزاحتها من شخص إلى آخر؛ أثناء التحليل النفسي، إزاحة المشاعر تجاه الآخرين (عادة…)\nمثال: أدى نقل الموسيقى من الأسطوانة إلى الشريط إلى كبت الكثير من الضوضاء الخلفية",
 "transferer": "ناقل (شخص ينقل شيئاً)",
 "transferor": "ناقل الملكية ((قانون) شخص ينقل سند ملكية أو ممتلكات إلى آخر)",
 "transferrable": "قَابِل لِلتَّحْوِيل, قَابِل لِلتَّدَاوُل (يمكن نقل ملكيته قانونياً إلى شخص آخر) / قَابِلٌ لِلنَّقْل, مُتَحَرِّك (يُمْكِنُ نَقْلُهُ أَوْ تَحْوِيلُهُ مِنْ مَكَانٍ لِآخَر)",
 "transferral": "مواصلات, نقل (عملية نقل شيء ما من موقع إلى آخر)",
 "transferred possession": "ملكية منقولة, ممتلكات محولة (حيازة تتغير ملكيتها أو تنقضي)",
