 "traveller's tree": "رافينالا, شجرة المسافر (نبات عملاق يشبه الشجرة له جوز صالح للأكل وأعناق أوراق تنتج مشروباً منعشاً من عصارة مائية صافية؛ يشاع أنه مصدر طوارئ للمياه للمسافرين)",
 "travelling": "ترحال, سفر (فعل الذهاب من مكان إلى آخر)\nمثال: استمتع بالبيع لكنه كره السفر",
 "travelling bag": "حقيبة سفر, شنطة (حاوية مستطيلة محمولة لحمل الملابس)\nمثال: حمل حقيبته الصغيرة معه إلى الطائرة",
 "travelling salesman": "مندوب مبيعات متجول (بائع يسافر لزيارة العملاء)",
 "travelling wave": "موجة متنقلة, موجة مسافرة (موجة يتحرك فيها الوسط في اتجاه انتشار الموجة)",
 "travelog": "فيلم سياحي, محاضرة عن الرحلات (فيلم أو محاضرة مصورة عن السفر)",
 "travelogue": "فيلم سياحي, محاضرة عن الرحلات (فيلم أو محاضرة مصورة عن السفر)",
 "traversable": "سَالِك, قَابِلٌ لِلْعُبُور (يُمْكِنُ عُبُورُهُ أَوِ السَّيْرُ فِيه)",
 "traversal": "اجتياز, عبور (السفر عبر) / اجتياز متعرج (اتخاذ مسار متعرج على الزلاجات)",
 "traverse": "اِجْتَازَ, عَبَرَ",
 "traverser": "عابر (شخص يتحرك أو يمر عبر)\nمثال: العابرون صعدوا الجبل ببطء",
 "travesty": "بَارُودِيَا, مُحَاكَاة سَاخِرَة (تكوين يقلد أو يحرف أسلوب شخص ما، عادة بطريقة فكاهية) / فارس, مهزلة (كوميديا تتميز بالسخرية الواسعة والمواقف غير المحتملة)",
 "trawl": "جرافة, شبكة الجر (شبكة صيد مخروطية تُسحب عبر الماء في أعماق كبيرة) / خيط الشباك, خيط الصيد بالجر (خيط صيد طويل ترتبط به العديد من الخيوط القصيرة والخطافات (عادة ما يكون معلقاً بين عوامات))",
 "trawl line": "خيط الشباك, خيط الصيد بالجر (خيط صيد طويل ترتبط به العديد من الخيوط القصيرة والخطافات (عادة ما يكون معلقاً بين عوامات))",
 "trawl net": "جرافة, شبكة الجر (شبكة صيد مخروطية تُسحب عبر الماء في أعماق كبيرة)",
 "trawler": "تراولر, سفينة صيد بشباك الجر (قارب صيد يستخدم شبكة الجر لصيد الأسماك) / صياد بشباك الجر (صياد يستخدم شباك الجر)",
 "tray": "صِينِيَّة (نوع من آنية المطبخ تستخدم لوضع الآواني عليها حين تنقل تكون مسطحة وواسعة؛ القُصْعَة؛ آنية واسعة يُصَّب فيها طعام يكفي عصبة من الناس)\nمثال: هذه شركة صينية.",
 "tray cloth": "مفرش صينية (بياضات مائدة تتكون من قطعة قماش صغيرة للصينية)",
 "trayful": "ملء صينية (بقدر ما تستوعبه صينية؛ ما يكفي لملء صينية)",
 "trazodone": "ترازودون, ديسيريل (مضاد اكتئاب فموي (الاسم التجاري ديسيريل) وهو دواء غير ثلاثي الحلقات يستخدم كمهدئ)",
 "trazodone hydrochloride": "ترازودون, ديسيريل (مضاد اكتئاب فموي (الاسم التجاري ديسيريل) وهو دواء غير ثلاثي الحلقات يستخدم كمهدئ)",
 "treacherous": "خَؤُون, غَادِر (يَمِيل إِلَى الخِيَانَة؛ خَاصَّةً ذُو طَبِيعَة غَادِرَة) / غَدَّار, لَا يُوثَقُ بِهِ (غير مستقرّ وغير متوقَّع بشكل خطير)",
 "treacherously": "بشكل خائن, خيانةً (بطريقة غير مخلصة وعديمة الوفاء)\nمثال: لقد تصرف بغدر",
 "treacherousness": "خطورة خفية, غدر (صفة توفير موطأ قدم غير آمن أو الانطواء على مخاطر خفية)\nمثال: كنا نأمل أن تؤدي خطورة الطريق المؤدي إلى بداية المسار إلى تثبيط الآخرين، لكن المسار كان مزدحمًا بالفعل بالعديد من مجموعات المتنزهين",
 "treachery": "خيانة, غدر (فعل خيانة متعمد) / خِيَانَة, غَدْر (خيانة الأمانة)",
 "treacle": "ابتذال عاطفي (كتابة أو موسيقى حلوة وعاطفية بشكل مفرط) / تريكل, شراب ذهبي (شراب قصب شاحب اللون)",
 "treacly": "سَكَرِينِيّ, مُفْرِط الحَلَاوَة (حلو أكثر من اللازم حتى يصبح مُقَرِّفًا)",
 "tread": "دَعَسَ, دَاسَ (الدَّعْسُ، كالمَنْعِ: حَشْوُ الوِعَاءِ، وَقد دَعَسَه: حَشَاهُ. والدَّعْسُ: شِدَّةُ الَوطْء)",
 "tread-softly": "عشبة لاسعة, قراص الدربيون (عشب لاسع في أمريكا الاستوائية)",
 "tread-wheel": "طاحونة الدوس (طاحونة تعمل بقوة الرجال أو الحيوانات الذين يمشون على حزام دائري أو يتسلقون درجات)",
 "treading water": "الطفو العمودي, مراوحة الماء (ضربة تبقي الرأس فوق الماء عن طريق تحريك الساقين والذراعين)",
 "treadle": "دواسة (رافعة يتم تشغيلها بالقدم)",
 "treadmill": "جِهَاز الْمَشْي, جِهَاز الْجَرْي",
 "treadmill test": "اختبار جهاز المشي (اختبار إجهاد يمشي فيه المريض على جهاز مشي متحرك بينما تتم مراقبة معدلات القلب والتنفس)",
 "treadwheel": "طاحونة الدوس (طاحونة تعمل بقوة الرجال أو الحيوانات الذين يمشون على حزام دائري أو يتسلقون درجات)",
 "treason": "خِيَانَة",
 "treasonable": "خَائِن, غَدَّار (ذُو طَبِيعَة خِيَانِيَّة أَوْ مِنْ سِمَات الخَوَنَة)",
 "treasonably": "بشكل خائن, خيانةً (بطريقة غير مخلصة وعديمة الوفاء)\nمثال: لقد تصرف بغدر",
 "treasonist": "خائن (شخص يخون بلده بارتكاب الخيانة العظمى)",
 "treasonous": "خَائِن, غَدَّار (ذُو طَبِيعَة خِيَانِيَّة أَوْ مِنْ سِمَات الخَوَنَة)",
 "treasure": "كَنْز",
 "treasure chest": "صندوق كنز (صندوق مملوء بالأشياء الثمينة)",
 "treasure flower": "جازانيا, زهرة الكنز (نبات معمر جنوب أفريقي مفترش بسيقان قصيرة كثيفة الأوراق وأشعة زهور برتقالية ببقع عينية سوداء عند القاعدة)",
 "treasure house": "بيت الكنز (مستودع للكنوز)",
 "treasure hunt": "البحث عن الكنز (لعبة يحاول فيها اللاعبون العثور على أغراض مخفية باستخدام سلسلة من الأدلة)",
 "treasure ship": "سفينة كنز (سفينة من القرن السادس عشر محملة بالكنوز)",
 "treasure trove": "كنز مكتشف (أي مجموعة من الأشياء الثمينة التي يتم اكتشافها) / كنز دفين (كنز مجهول المالك وجد مخبأ (عادة في الأرض))\nمثال: كان كتابها كنزاً من الأفكار الجديدة",
 "treasured": "ثَمِين, غَالٍ (يتسم بالمودة الحانية والتقدير العميق)",
 "treasurer": "أمين الصندوق, خازن (موظف مسؤول عن استلام وصرف الأموال)",
 "treasurer's check": "شيك أمين الصندوق, شيك مصرفي (شيك يصدره مسؤول في البنك على حساب البنك الخاص (وليس حساب شخص خاص))\nمثال: الشيكات المصرفية جيدة كالنقد",
 "treasurer's cheque": "شيك أمين الصندوق, شيك مصرفي (شيك يصدره مسؤول في البنك على حساب البنك الخاص (وليس حساب شخص خاص))\nمثال: الشيكات المصرفية جيدة كالنقد",
 "treasurership": "أمانة الصندوق (منصب أمين الصندوق)",
 "treasury": "خَزِينَة",
 "treasury agent": "عميل الخزانة (عميل خاص لإنفاذ القانون في وزارة الخزانة الأمريكية)",
 "treasury bill": "أذونات الخزانة (التزام قصير الأجل لا يحمل فائدة (يتم شراؤه بخصم)؛ يمكن تداوله على أساس الخصم لمدة 91 يوماً)",
 "treasury bond": "سندات الخزانة (أداة دين بآجال استحقاق تبلغ 10 سنوات أو أكثر)",
 "treasury department": "الخزانة الأمريكية, وزارة الخزانة (الإدارة الفيدرالية التي تجمع الإيرادات وتدير المالية الفيدرالية؛ تأسست وزارة الخزانة عام 1789)",
 "treasury note": "أوراق الخزانة (أوراق مالية بآجال استحقاق من 1 إلى 10 سنوات؛ تباع نقداً أو مقابل إصدارات مستحقة أو في مزاد)",
 "treasury obligations": "التزامات الخزانة, سندات الخزانة (التزامات دين قابلة للتداول للحكومة الأمريكية والتي تضمن دفع الفائدة وأصل الدين في الوقت المحدد)",
 "treasury secretary": "وزير الخزانة (منصب رئيس وزارة الخزانة) / وزير الخزانة (الشخص الذي يشغل منصب وزير وزارة الخزانة)\nمثال: تم إنشاء منصب وزير الخزانة عام 1789",
 "treasury shares": "أسهم الخزينة (أسهم أعادت الشركة المصدرة شراءها ومتاحة للإلغاء أو إعادة البيع؛ وهي مصدرة ولكنها غير متداولة؛ لا يمكن التصويت بها ولا تدفع أرباحاً)",
 "treasury stock": "أسهم الخزينة (أسهم أعادت الشركة المصدرة شراءها ومتاحة للإلغاء أو إعادة البيع؛ وهي مصدرة ولكنها غير متداولة؛ لا يمكن التصويت بها ولا تدفع أرباحاً)",
 "treat": "عَالَجَ",
 "treated": "مُصلّد, مُعالَج (ما جُعل صلباً أو مرناً أو مقاوماً خاصةً عن طريق المعالجة الحرارية) / معالج (خاضع لمعالجة فيزيائية (أو كيميائية) أو فعل أو عامل) / معالج (تلقى رعاية أو علاجاً طبياً)\nمثال: سيف من الفولاذ المصلد (المقسى)",
 "treater": "مفاوض (شخص يتفاوض (يتشاور مع الآخرين للوصول إلى تسوية))",
 "treatise": "رِسَالَة",
 "treatment": "مُعَامَلَة (كيفية التَصَرُّف مع الآخرين ومدى احترامهم أو خلافه؛ عند الفقهاء: العَقْد على العَمَل ببعض الخارج مع سائِر شرائِط جوازها. وتُطَلق المعاملات على الأحكام الشرعية المتعلّقة بأمر الدنيا باعتبار بقاءِ الشخص…) / عِلَاج, مُعَالَجَة\nمثال: أساء توم معاملة ماري.",
 "treaty": "مُعَاهَدَة, مُقَاوَلَة (مؤنث مُعَاهَد، وهو اسم مفعول من عَاهَدَ؛ اتِّفَاق مُقَرّر بين دَوْلَتَيْن أو أكثر على أمور معينة)\nمثال: أمضيت المعاهدة يوم 18 نوفمبر 1903.",
 "treaty port": "ميناء معاهدة (ميناء في الصين أو كوريا أو اليابان كان مفتوحًا للتجارة الخارجية بموجب معاهدة تجارية)",
 "treble": "سُوبْرَانُو (ذو مدى صوتيّ عالٍ أو يدلّ عليه) / ذُو وَجْهَيْنِ, مُتَعَدِّدُ الْأَوْجُهِ (له أكثر من جانب أو صفة مختلفة بوضوح) / ثُلَاثِيّ (ذو ثلاث وحدات أو مكوّنات أو عناصر) / ثَلَاثَةُ أَضْعَافٍ (ثلاثة أمثال الكمية أو العدد)",
 "treble clef": "مفتاح الثلاثي, مفتاح صول (مفتاح)\nمثال: بحث عن المفتاح.",
 "treble damages": "تعويضات ثلاثية (ثلاثة أضعاف المبلغ الذي ستجد المحكمة عادة أن الطرف المتضرر يستحقه)",
 "treble recorder": "فلاجوليت (مزمار) (مزمار صغير بفتحات للأصابع وإبهامين)",
 "treble staff": "مفتاح الثلاثي, مفتاح صول (مفتاح)\nمثال: بحث عن المفتاح.",
 "trebuchet": "منجنيق",
 "trebucket": "مجنقة, منجنيق (منجنيق يستخدم ذراعاً متأرجحة لرمي قذيفة)",
 "tree": "شَجَر, شَجَرَة (الأمر المختلف بين الناس؛ مخرج الفَم أو مُؤَخَّره. ومنه الحروف الشَجْرِيَّة) / شَجَرَة (نبات قائم على سَاق صلبة؛ مخطط له تفرعات)\nمثال: توم يتسلق شجرة.",
 "tree branch": "فرع رئيسي (أي من الفروع الرئيسية الناشئة من الجذع أو غصن شجرة)",
 "tree celandine": "بوكونيا (شجرة صغيرة من أمريكا الوسطى لها عناقيد رخوة من الزهور الخضراء المشوبة بالأرجواني)",
 "tree clubmoss": "تنوب أرضي, صنوبر الأميرة (صنف من طحلب النادي، يسمى عادة الصنوبر الأرضي، أو صنوبر الأمير، أو صنوبر الأميرة)",
 "tree cotton": "قطن شجري (شجيرة من شرق الهند تُزرع خاصة للزينة لزهورها الصفراء الشاحبة إلى الأرجوانية الداكنة) / قطن جزر البحر (شجرة كثيفة صغيرة تنمو في جزر الكاريبي وقبالة الساحل الأطلسي لجنوب الولايات المتحدة؛ تنتج قطناً بألياف حريرية طويلة بشكل غير عادي)",
 "tree creeper": "متسلق الأخشاب (أي من الطيور العديدة في أمريكا الجنوبية والوسطى ذات منقار منحني وريش ذيل صلب تتسلق وتتغذى مثل نقار الخشب) / دابة الشجر, متسلق (أي من الطيور الصغيرة المتنوعة آكلة الحشرات في نصف الكرة الشمالي التي تتسلق جذوع الأشجار مستندة على ريش ذيل صلب وأقدامها)",
 "tree cricket": "صرصور الشجر (صرصور أمريكي شجري شاحب يشتهر بصريره العالي)",
 "tree diagram": "شجرة, مخطط شجري (شكل يتفرع من جذر واحد)\nمثال: شجرة العائلة",
 "tree farm": "مزرعة أشجار (غابة (أو جزء من غابة) تزرع فيها الأشجار للاستخدام التجاري)",
 "tree farmer": "حراجي, خبير الغابات (شخص مدرب في علم الحراجة وزراعة الغابات)",
 "tree farming": "زراعة الأشجار (العناية بالأشجار ورعايتها)",
 "tree fern": "سرخس شجري",
 "tree frog": "ضِفْدَع شَجَر (مِنْ فَصِيلَةِ الضِّفْدَعِيَّاتِ ، بَرْمَائِيٌّ لاَ ذَنَبَ لَهُ ، رَخْوٌ ، دَقِيقُ العِظَامِ ، جَمِيلُ السِّبَاحَةِ ، وَهُوَ أَنْوَاعٌ…؛ \" نَقَّتْ ضَفَادِعُ بَطْنِهِ \" : صَوَّتَتْ عَصَافِيرُ بَطْنِهِ ، أَيْ جَاعَ)\nمثال: الضفدع في البئر.",
 "tree fuchsia": "فوشية شجرية, كونيني (شجيرة أو شجرة متساقطة الأوراق قائمة يصل ارتفاعها إلى 10 أقدام بزهور كستنائية؛ نيوزيلندا)",
 "tree heath": "خلنج, خلنج شجري (شجيرة متوسطية دائمة الخضرة تشبه الشجرة ذات زهور بيضاء عطرة في عناقيد طرفية كبيرة وجذور خشبية صلبة تستخدم لصنع غليون التبغ) / خلنج شجري, شجرة العشب (شجرة شجيرية تسمانية دائمة الخضرة نحيلة بأوراق مدببة رفيعة طولها 3 إلى 5 أقدام)",
 "tree house": "بيت الشجرة (بيت لعب مبني في أغصان شجرة)",
 "tree hugger": "مُعانِق الأَشْجار (مصطلح ازدرائي لعلماء البيئة الذين يدعمون القيود المفروضة على صناعة قطع الأشجار والحفاظ على الغابات)",
 "tree kangaroo": "كنغر شجري, ولب الشجر (ولب شجري من غينيا الجديدة وشمال أستراليا له أرجل خلفية وأمامية متساوية الطول)",
 "tree line": "خط الأشجار (الخط الذي يمثل الحد الأعلى لنمو الأشجار في الجبال أو خطوط العرض الشمالية)",
 "tree lizard": "سحلية الشجر (سحلية متسلقة من غرب الولايات المتحدة وشمال المكسيك)",
 "tree lupine": "ترمس شجري (شجيرة دائمة الخضرة من ساحل المحيط الهادئ للولايات المتحدة لها زهور صفراء أو زرقاء بارزة؛ تم توطينها في أستراليا)",
 "tree mallow": "خبازة شجرية, ورقة المخمل (شجيرة معمرة شجرية ذات أوراق فروية مفصصة كفياً وأزهار حمراء أرجوانية مبهرجة؛ جنوب غرب الولايات المتحدة)",
 "tree martin": "سنونو الشجر (من أستراليا وبولينيزيا؛ يعشش في تجاويف الأشجار)",
 "tree of heaven": "إيلنط باسق, شجرة السماء (شجرة نفضية سريعة النمو من الصين بأوراق تشبه السماق وزهور كريهة الرائحة حلوة المذاق؛ تزرع على نطاق واسع في الولايات المتحدة كشجرة شوارع لمقاومتها…)",
 "tree of knowledge": "شجرة المعرفة (الشجرة التوراتية في جنة عدن التي ذاق آدم وحواء ثمرتها المحرمة)",
 "tree of the gods": "إيلنط باسق, شجرة السماء (شجرة نفضية سريعة النمو من الصين بأوراق تشبه السماق وزهور كريهة الرائحة حلوة المذاق؛ تزرع على نطاق واسع في الولايات المتحدة كشجرة شوارع لمقاومتها…)",
 "tree onion": "بصل الشجرة, بصل مصري (نوع من البصل المعمر يزرع بشكل رئيسي للغرابة أو كبصل أخضر مبكر؛ له بصيلات صغيرة تحل محل الزهور)",
 "tree poppy": "خشخاش شجري, خشخاش شجيري (شجيرة دائمة الخضرة من جنوب غرب الولايات المتحدة والمكسيك تزرع غالباً لأزهارها الصفراء الذهبية العطرة)",
 "tree shrew": "زبابيات الشجر (ثديي شجري آكل للحشرات من جنوب شرق آسيا يشبه السنجاب وله عيون كبيرة وخطم حاد طويل)",
 "tree sloth": "كسلان, كسلان الشجر (أي من عدة ثدييات شجرية بطيئة الحركة في أمريكا الجنوبية والوسطى؛ تتدلى من الأغصان بظهرها للأسفل وتتغذى على الأوراق والفواكه)",
 "tree sparrow": "عصفور الشجر (عصفور شائع في الشتاء في شمال الولايات المتحدة) / عصفور الشجر (عصفور أوراسي أصغر من عصفور الدوري)",
 "tree squirrel": "سنجاب الشجر (أي سنجاب شجري نموذجي)",
 "tree stump": "جِذْع, جِذْل (في علم النبات: أحد أجزاء النبات الذي يحمل الأغصان ويتصل في أسفله بالجذر)",
 "tree surgeon": "أخصائي أشجار, جراح أشجار (متخصص في علاج الأشجار المتضررة)",
 "tree surgery": "جراحة الأشجار (علاج الأشجار التالفة أو المتحللة)",
 "tree swallow": "سنونو الشجر (من أستراليا وبولينيزيا؛ يعشش في تجاويف الأشجار) / سنونو أبيض البطن (سنونو أخضر مزرق وأبيض من أمريكا الشمالية؛ يعشش في تجاويف الأشجار)",
 "tree swift": "سمامة الشجر (طيور من جنوب شرق آسيا وجزر الهند الشرقية تختلف عن السمامات الحقيقية في وجود أعراف منتصبة والتعشيش في الأشجار)",
 "tree toad": "علجوم الشجر (برمائيات شجرية لها عادة أقراص لاصقة عند طرف كل إصبع؛ من جنوب شرق آسيا وأستراليا وأمريكا)",
 "tree tobacco": "تبغ شجري, شجرة الخردل (شجيرة دائمة الخضرة من أمريكا الجنوبية تم توطينها في الولايات المتحدة؛ مسؤولة أحياناً عن تسمم الماشية)",
 "tree tomato": "تماريلو, طماطم شجرية (شجيرة شجرية من أمريكا الجنوبية لها أزهار وردية شاحبة تليها ثمار بنية محمرة بيضاوية صالحة للأكل تشبه الطماطم نوعاً ما)",
 "tree trunk": "جِذْع (في علم النبات: أحد أجزاء النبات الذي يحمل الأغصان ويتصل في أسفله بالجذر)",
 "tree wallaby": "كنغر شجري, ولب الشجر (ولب شجري من غينيا الجديدة وشمال أستراليا له أرجل خلفية وأمامية متساوية الطول)",
 "tree-frog": "ضفدع الشجر (أي من الضفادع الشجرية المختلفة في العالم القديم تتميز عن الضفادع الحقيقية بممصات لاصقة على أصابع القدم) / علجوم الشجر (برمائيات شجرية لها عادة أقراص لاصقة عند طرف كل إصبع؛ من جنوب شرق آسيا وأستراليا وأمريكا)",
 "tree-living": "سَاكِن الأَشْجَار, شَجَرِيّ (يعيش في أو يرتاد الأشجار)\nمثال: قرود شجرية",
 "tree-shaped": "ذُو بِنْيَةٍ تَفَرُّعِيَّة, شَجَرِيّ (يُشْبِهُ الشَّجَرَةَ فِي شَكْلِهِ وَبِنْيَتِهِ المُتَفَرِّعَة)",
 "tree-worship": "عبادة الأشجار (عبادة الأشجار)",
 "treed": "فِي مَأْزِق, مُحَاصَر (مُجْبَر عَلَى مُوَاجَهَة المُهَاجِمِين دُونَ مَفَرّ)",
 "treehopper": "نطاط الشجر (حشرة صغيرة قافزة تمتص عصارة الفروع والأغصان)",
 "treeless": "أجرد, غير مشجر (غير مشجر)",
 "treelet": "شجرة صغيرة, شجيرة (شجرة صغيرة)",
 "treelike": "ذُو بِنْيَةٍ تَفَرُّعِيَّة, شَجَرِيّ (يُشْبِهُ الشَّجَرَةَ فِي شَكْلِهِ وَبِنْيَتِهِ المُتَفَرِّعَة)",
 "treenail": "مسمار خشبي (وتد خشبي يستخدم لتثبيت الأخشاب في بناء السفن؛ الماء يجعل الوتد ينتفخ ويثبت الأخشاب بإحكام)",
 "treetop": "تاج الشجرة, قمة الشجرة (الفروع والأوراق العليا لشجرة أو نبات آخر)",
 "tref": "حَرَام يَهُودِيًّا, غَيْر كُوشَر (غير مطابق لقوانين الطعام الدينيّة)",
 "trefoil": "نَفَل (الثَلَاثُ النُفَل: الليلة الرابعة والخامسة والسادسة من كل شهر قمري…)",
 "trefoil arch": "قوس ثلاثي الفصوص (قوس مدبب له نتوءات في البطن على جانبي القمة)",
 "treillage": "تعريشة (شبكة خشبية تستخدم لدعم النباتات المتسلقة)",
 "trek": "رحلة شاقة (أي رحلة طويلة وصعبة) / رحلة شاقة, هجرة بالعربات (رحلة بعربة تجرها الثيران (خاصة هجرة منظمة لمجموعة من المستوطنين))",
 "trekker": "رحالة في الطبيعة (مسافر يقوم برحلة شاقة وطويلة (مثل المشي لمسافات طويلة عبر المناطق الجبلية))",
 "trellis": "تعريشة (شبكة خشبية تستخدم لدعم النباتات المتسلقة)",
 "trematode": "تريماتودا, مثقوبات (ديدان مفلطحة طفيلية لها ممصات خارجية للالتصاق بالمضيف)",
 "trematode worm": "تريماتودا, مثقوبات (ديدان مفلطحة طفيلية لها ممصات خارجية للالتصاق بالمضيف)",
 "tremble": "اِخْتَلَجَ, اِرْتَجَفَ / رَجْفَة (المرّة الواحدة من الرَجْف؛ الزَلْزَلَة)",
 "trembler": "مرتجف (من يرتجف ويهتز خوفاً)",
 "trembles": "ارتعاش (مرض يصيب الماشية خاصة الأبقار نتيجة التسمم بتناول أنواع معينة من جذر الثعبان)",
 "trembling": "مُرْتَجِف, مُرْتَعِش (يهتز بشكل طفيف وغير منتظم كما من الخوف أو البرد) / ارتعاش, اهتزاز (حركة مهتزة)\nمثال: ارتعاش أصابعه وهو يشعل غليونه",
 "tremella foliacea": "تريميلا فولياكيا (فطر هلامي بجسم ثمري عرضه 5-15 سم وقوام هلامي؛ يشبه حزمة من خس الأوراق؛ معظمه ماء ولونه بني)",
 "tremella fuciformis": "فطر الثلج (شائع في الصين واليابان وتايوان؛ فطر هلامي؛ معظمه مجفف)",
 "tremella lutescens": "زبدة الساحرات (فطر هلامي أصفر)",
 "tremella reticulata": "تريميلا ريتيكولاتا (فطر هلامي بجسم ثمري مبيض منتصب وشكل متغير للغاية (يشبه أحياناً الفطريات المرجانية))",
 "tremendismo": "الرهابية, تريمينديسمو (أسلوب أدبي إسباني بعد الحرب يتميز بالميل إلى التأكيد على العنف والصور البشعة)\nمثال: يتميز التريمينديسمو بالإلقاء المسرف والصاخب الموجه نحو القبح، وبنوبات من الفكاهة الساخرة القاتمة، وتقديم شخصيات غير عقلانية ومغتربة",
 "tremendous": "عَظِيم, هَائِل (كبير بشكل استثنائي في الحجم أو المدى أو الكمية أو القوة أو الدرجة) / رَائِع, عَظِيم (جيد أو عظيم بشكل استثنائي؛ يُستخدم خاصة كمكثف) / شَدِيد, مَهُول (بالغ في الدرجة أو المدى أو المقدار أو التأثير)",
 "tremendously": "بشدة, بشكل هائل (بدرجة كبيرة جداً)\nمثال: كان محبوباً بشكل هائل",
 "tremolite": "تريموليت (معدن أبيض أو أخضر باهت (سيليكات الكالسيوم والمغنيسيوم) من مجموعة الأمفيبول يستخدم كشكل من أشكال الأسبستوس)",
 "tremolo": "ارتجاف, تريمولو (فيبراتو صوتي خاصة المفرط أو سيئ التحكم) / تريمولو, رجفة صوتية ((موسيقى) تأثير مرتعش ينتج عن التكرار السريع لنغمة واحدة أو التبادل السريع لنغمتين)",
 "tremor": "ارتجاف, رعشة (اهتزاز لا إرادي (كما لو كان بسبب المرض أو الخوف)) / رعشة أرضية, زلزال صغير (زلزال صغير) / ارتجاف, رعشة (اهتزاز أو ارتعاش (ناتج عادة عن ضعف أو توتر أو مرض))",
 "tremulous": "مرتجف, مترجفة",
 "tremulously": "بارتعاش, باهتزاز (بطريقة مرتجفة)\nمثال: حفت أوراق الشجر بارتعاش في الريح",
 "trenail": "مسمار خشبي (وتد خشبي يستخدم لتثبيت الأخشاب في بناء السفن؛ الماء يجعل الوتد ينتفخ ويثبت الأخشاب بإحكام)",
 "trench": "خَنْدَق, أُخْدُود / خَنْدَق",
 "trench coat": "ترنش كوت, معطف خندق (معطف واق من المطر بتصميم عسكري؛ بحزام وجيوب عميقة)",
 "trench fever": "حمى الخنادق (تتميز بألم في العضلات والمفاصل وينقلها القمل)",
 "trench foot": "قدم الخندق (حالة تشبه قضمة الصقيع ولكن دون تجمد؛ ناتجة عن التعرض للبرد والرطوبة)",
 "trench knife": "سكين الخنادق (سكين ذو نصل حاد من الجانبين للقتال المباشر بالأيدي)",
 "trench mortar": "مورتر, هاون (مدفع يلقم من الفوهة ذو سبطانة قصيرة يطلق القذائف بزوايا مرتفعة لمدى قصير)",
 "trench mouth": "ذباح فنسنت, فم الخندق (عدوى حادة سارية في الجهاز التنفسي والفم تتميز بتقرح الغشاء المخاطي)",
 "trench warfare": "حرب الخنادق (نوع من القتال المسلح تقاتل فيه القوات المتعارضة من خنادق تواجه بعضها البعض) / حَرْب خَنَادِق (صراع (طويل الأمد عادة) بين كيانات متنافسة لا يستطيع فيه أي من الطرفين الفوز)\nمثال: بدلاً من أن تنتهي الحرب بسرعة، تعثرت في حرب الخنادق",
 "trenchancy": "حدة الذهن, قاطعية (حدة وقوة الفكر أو التعبير)",
 "trenchant": "بَيِّن, حَاسِم (محدّد بوضوح وحدّة في الذهن) / حَاسِم, قَوِيُّ التَّأْثِير (يتميّز بالقوّة والحزم الشديدين) / ثَاقِب, نَافِذ (ذو حدة ونفاذ في الفكر أو التعبير)",
 "trenchantly": "بشكل قاطع, بفعالية (بطريقة قوية وفعالة)\nمثال: دافع عن الحقوق المدنية لموكله بشكل قاطع",
 "trencher": "لوح تقديم خشبي (لوح خشبي أو طبق يتم عليه تقديم الطعام أو تقطيعه) / حافر خنادق (شخص يحفر الخنادق)",
 "trencherman": "أكول, نهم (شخص ذكر مكرس للأكل والشرب بإفراط)",
 "trencherwoman": "أكولة, نهمة (شخص أنثى مكرسة للأكل والشرب بإفراط)",
 "trenching spade": "مجرفة خنادق (مجرفة يدوية يحملها جنود المشاة لحفر الخنادق)",
 "trend": "رَائِج, مُتَدَاوَل / يَرُوج, يُتَدَاوَل",
 "trend analysis": "تحليل الاتجاه (تحليل التغيرات بمرور الوقت)",
 "trend extrapolation": "استقراء الاتجاه (تقنية التنبؤ التي تستخدم الأساليب الإحصائية لتوقع النمط المستقبلي لبيانات السلاسل الزمنية)",
 "trend line": "خط الاتجاه (خط على رسم بياني يشير إلى اتجاه إحصائي)",
 "trend setting": "تحديد الاتجاه, صنع الصيحات (بدء أو نشر اتجاه أو موضة)",
 "trend-setter": "مبتكر الموضة, واضع الصيحة (شخص يروج لموضة جديدة ويجعلها شائعة)",
 "trend-setting": "رَائِد لِلمُوضَة (يُبَادِر بِإِطْلَاق أَوْ نَشْر اتِّجَاه جَدِيد)",
 "trendsetting": "رَائِد لِلمُوضَة (يُبَادِر بِإِطْلَاق أَوْ نَشْر اتِّجَاه جَدِيد)",
 "trendy": "عَصْرِيّ, مُوَاكِب لِلصَّرْعَة (مُتَوَافِق مَعَ أَحْدَث صَرْعَات المُوضَة)",
 "trental": "بنتوكسيفيلين, ترينتال (دواء (الاسم التجاري ترينتال) يستخدم لعلاج العرج؛ يُعتقد أنه يزيد من مرونة خلايا الدم الحمراء بحيث يمكنها التدفق عبر الأوعية الدموية إلى الساقين…)",
 "trente-et-quarante": "روج إي نوار (لعبة ورق يتم فيها توزيع صفين من الأوراق ويمكن للاعبين الرهان على لون الأوراق أو على الصف الذي سيكون له عد أقرب لعدد معين)",
 "trepan": "تريبان, مِثْقَاب تاجي (مثقاب لقطع ثقوب دائرية حول مركز) / منشار الترفين, مِثقب الجمجمة (أداة جراحية تستخدم لإزالة أجزاء من عظم الجمجمة)",
 "trepanation": "نَقَب الجَمْجَمَة (في الأرض: ذَهَبَ؛ كأن الشخص خرق الأرض إذا سار فيها. غالبا ما يقصد أن يكون ذلك طلبا للمهرب ولا يشترط؛ عن الشيء: فحصه فحصا دقيقا ليعرف تفاصيله)\nمثال: تم مراقبة قردة الأورانج أوتان و هي تستعمل عصي لنقب البذور المغذية من النباتات الشائكة.",
 "trepang": "خيار البحر الصالح للأكل (من السواحل الدافئة من أستراليا إلى آسيا؛ يستخدم كطعام خاصة من قبل الصينيين)",
 "trephination": "نقب الجمجمة (عملية تزيل قسماً دائرياً من عظم الجمجمة)",
 "trephine": "منشار الترفين, مِثقب الجمجمة (أداة جراحية تستخدم لإزالة أجزاء من عظم الجمجمة)",
 "trepid": "هَيُوب, وَجِل (خجول بطبعه أو يُظهر الخجل والوجل)",
 "trepidation": "ارتياب, رجفة خوف (شعور بالجزع أو الرهبة)",
 "trepidly": "بتهيب, بوجل (بطريقة خائفة ومترددة)",
