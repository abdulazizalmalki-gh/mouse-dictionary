 "unmalicious": "سَلِيم النِّيَّة, غَيْر خَبِيث (ليس خبيثاً أو حقوداً)",
 "unmalleability": "عدم الطواعية, عدم القابلية للطرق (الافتقار إلى القابلية للطرق)",
 "unmalleable": "غَيْرُ قَابِل لِلتَّشْكِيل (صعب أو مستحيل التشكيل أو المعالجة)",
 "unmalted": "غير مملت (من الحبوب التي لم يتم تحويلها إلى شعير (مالت))\nمثال: شعير غير مملت",
 "unmanageable": "لَا يُمْكِنُ السَّيْطَرَةُ عَلَيْه, مُسْتَعْصٍ (غَيْرُ قَابِلٍ لِلسَّيْطَرَةِ أَوِ الإِدَارَة) / صعب المراس, مستعصٍ (يصعب التحكم فيه) / عَصِيّ عَلَى الحَلّ, لَا يُمْكِن السَّيْطَرَة عَلَيْه (صعب الحل أو التخفيف منه) / ثقيل, صعب الاستخدام (صعب الاستخدام أو التعامل معه أو إدارته بسبب الحجم أو الوزن أو الشكل)\nمثال: طفل صعب المراس",
 "unmanageableness": "تمرد, شموس (سمة صعوبة الإدارة)",
 "unmanageably": "بشكل لا يمكن التحكم فيه, بشكل هائل (بحيث لا يمكن إدارته)\nمثال: اشتكت قائلة: هذا المنزل كبير بشكل لا يمكن التحكم فيه",
 "unmanful": "غير رجولي (لا يمتلك صفات تليق بالرجل)",
 "unmanfully": "بجبن, بغير رجولة (بدون صفات يُعتقد أنها تليق بالرجل)",
 "unmanlike": "غير رجولي (لا يمتلك صفات تليق بالرجل)",
 "unmanliness": "تخنث, ميوعة (سمة التخنث (استخدام ازدرائي للرجل))\nمثال: ربط الطلاب العلم بالرجولة والفنون بالتخنث",
 "unmanly": "خَوَّار العَزِيمَة, ضَعِيف النَّفْس (يَفْتَقِر إِلَى الشَّجَاعَة والحَزْم والعَزِيمَة؛ جَبَان بِصُورَة مُحْتَقَرَة) / بجبن, بغير رجولة (بدون صفات يُعتقد أنها تليق بالرجل) / غير رجولي (لا يمتلك صفات تليق بالرجل)",
 "unmanned": "غير مأهول, مُسير عن بعد (يفتقر إلى طاقم)\nمثال: قمر صناعي غير مأهول إلى المريخ",
 "unmannered": "بِلَا تَكَلُّف (دون تصنع أو تكلّف؛ طبيعي وعفوي) / سَيِّئُ الأَدَبِ, وَقِح (غير صحيح السلوك اجتماعياً)",
 "unmannerly": "سَيِّئُ الأَدَبِ, وَقِح (غير صحيح السلوك اجتماعياً)",
 "unmapped": "غَيْر مَرْسُوم, غَيْر مُسْتَكْشَف ((لمناطق مجهولة) لم يُجرَ مسحها أو استكشافها بعد)",
 "unmarked": "غير موسوم, غير مُميز (ليس لديه علامة تعريف) / غَيْر مُلَاحَظ, مُغْفَل (لم يُؤخَذ في الحسبان)\nمثال: أوراق لعب غير معلمة",
 "unmarketable": "غَيْرُ قَابِلٍ لِلبَيْع (لا يمكن بيعه أو تسويقه) / غَيْرُ صَالِحٍ لِلبَيْع (لا يصلح للعرض في السوق أو البيع)",
 "unmarred": "بِلَا شَائِبَة, نَاصِع (خال من البقع أو اللطخات الجسدية أو الأخلاقية)\nمثال: سجل ناصع",
 "unmarried": "أعزب, غير متزوج (غير متزوج أو يتعلق بحالة العزوبية)\nمثال: رجال ونساء غير متزوجين",
 "unmarried man": "أعزب (رجل لم يتزوج قط)",
 "unmarried woman": "امرأة غير متزوجة, عزباء (امرأة ليست متزوجة)",
 "unmasking": "فضح, كشف القناع (فضح محتال أو مخادع)\nمثال: نشر فضيحة عن الرشوة والفساد في حكومة المدينة",
 "unmatchable": "لَا مَثِيلَ لَهُ, لَا نَظِيرَ لَهُ (بارز يفوق أيّ مقارنة؛ فريد لا يُضاهى)",
 "unmatched": "لَا مَثِيلَ لَهُ, لَا نَظِيرَ لَهُ (بارز يفوق أيّ مقارنة؛ فريد لا يُضاهى) / بِلَا نَظِير, فَرْدِيّ (العضو المتبقي من زوج)",
 "unmated": "غير متزاوج (لم يتزاوج جنسياً) / بِلَا نَظِير, فَرْدِيّ (العضو المتبقي من زوج)",
 "unmeaning": "خَاوِي المَعْنَى (بلا معنى ولا دلالة)",
 "unmeasurable": "لا يحصى, لا يُقاس (يستحيل قياسه)\nمثال: أبعاد لا تُقاس للفضاء الخارجي",
 "unmeasured": "لَا حَدَّ لَه, لَا مَحْدُود (بلا حدود في المدى أو الحجم أو الكمية) / غَيْرُ مَوْزُون (لا يتألّف من مقاطع موزونة؛ ليس عروضياً)",
 "unmechanical": "غَيْر مِيكَانِيكِيّ ((للشخص) يفتقر إلى المهارات الميكانيكية)",
 "unmechanised": "غَيْرُ مُمَيْكَن (لَمْ يَتِمَّ تَحْوِيلُهُ إِلَى العَمَلِ بِالآلَات)",
 "unmechanized": "غَيْرُ مُمَيْكَن (لَمْ يَتِمَّ تَحْوِيلُهُ إِلَى العَمَلِ بِالآلَات)",
 "unmediated": "بِلَا وَسِيط, مُبَاشِر (لَيْسَ لَهُ أَشْخَاص أَوْ وُكَلَاء أَوْ ظُرُوف وَسِيطَة)",
 "unmedical": "غَيْر دَوائِيّ, غَيْر طِبِّيّ (لَيْس لَه خَصائِص عِلاجِيَّة أو دَوائِيَّة)",
 "unmedicative": "غَيْر دَوائِيّ, غَيْر طِبِّيّ (لَيْس لَه خَصائِص عِلاجِيَّة أو دَوائِيَّة)",
 "unmedicinal": "غَيْر دَوائِيّ, غَيْر طِبِّيّ (لَيْس لَه خَصائِص عِلاجِيَّة أو دَوائِيَّة)",
 "unmelodic": "غير شجي, غير موسيقي (يفتقر إلى اللحن)",
 "unmelodious": "غير شجي, غير موسيقي (يفتقر إلى اللحن) / بلا نغم, نشاز (ليس لديه صوت موسيقي أو نغمة ممتعة)",
 "unmelodiously": "بشكل غير منغم, بنشاز (بطريقة غير شجية)\nمثال: تغني بنشاز إلى حد ما",
 "unmelted": "غير ذائب\nمثال: شوارع غير سالكة بسبب أكوام الثلج غير الذائب (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "unmemorable": "لَا يَسْتَحِقُّ التَّذَكُّر (لَيْسَ جَدِيرًا بِالتَّذَكُّرِ)",
 "unmemorably": "بشكل لا يعلق بالذاكرة (بطريقة غير جديرة بالتذكر)",
 "unmentionable": "لَا يُذْكَر, مُسْتَهْجَن (غير لائق أو محظور كموضوع للحديث) / ملابس داخلية (رداء يلبس تحت ملابس أخرى)",
 "unmercenary": "غَيْرُ نَفْعِيّ, مُتَجَرِّدٌ مِنَ المَطَامِعِ (غَيْرُ مَدْفُوعٍ بِالمَكَاسِبِ المَالِيَّةِ)",
 "unmerchantable": "غَيْرُ صَالِحٍ لِلبَيْع (لا يصلح للعرض في السوق أو البيع)",
 "unmerciful": "عديم الرحمة, قاسٍ (ليس لديه أو لا يظهر أي رحمة)\nمثال: العدو عديم الرحمة",
 "unmercifully": "بقسوة بالغة, بلا رحمة (بدون شفقة؛ بطريقة لا ترحم)\nمثال: تعرض لهزيمة نكراء بلا رحمة من قبل خصمه في المجلس",
 "unmercifulness": "عَدَم رَحْمَة, قَسْوَة (اللاإنسانية التي يدل عليها عدم الرغبة في أن يكون لطيفاً أو متسامحاً)",
 "unmerited": "غير مستحق (غير مستحق أو مجازى به) / غَيْرُ مُسْتَحَقٍّ (لَمْ يُكْتَسَبْ عَنْ جَدَارَةٍ)\nمثال: حصل على درجة فخرية غير مستحقة",
 "unmeritorious": "عَدِيمُ الجَدَارَةِ (بِلَا اسْتِحْقَاقٍ أَوْ جَدَارَةٍ)",
 "unmethodical": "غَيْر مَنْهَجِيّ (ليس فعالاً أو منهجياً في الترتيب)",
 "unmilitary": "غير عسكري, مدني (غير مرتبط بالجنود أو الجيش)\nمثال: دوائر حكومية غير عسكرية",
 "unmindful": "ساه, غافل (غير منتبه أو يقظ)\nمثال: وبينما كان غافلاً عن خطواته تعثر",
 "unmindfully": "بغفلة, دون انتباه (بطريقة مهملة ودون تفكير)",
 "unmindfulness": "سهو, غفلة (سمة نسيان أو تجاهل مسؤولياتك)",
 "unmined": "غير مُستخرَج (لم يتم استخراجه)\nمثال: رواسب يورانيوم غير مستخرجة",
 "unmingled": "صِرْف, غَيْرُ مَمْزُوج (غير مخلوط بعناصر دخيلة)",
 "unmistakable": "لَا لَبْسَ فِيه (بيّن للعقل بشكل لا يقبل الخطأ أو اللبس) / بَيِّن, جَلِيّ (مكشوف بوضوح للعقل أو الحواسّ أو الحكم)",
 "unmistakably": "بشكل لا لبس فيه (بدون احتمال للخطأ) / بشكل لافت, بشكل ملحوظ (بطريقة بارزة أو مميزة)\nمثال: هذه اللوحة المائية هي بشكل لا لبس فيه توليفة من الطبيعة",
 "unmitigable": "غَيْر قَابِل لِلتَّخْفِيف (لا يمكن تخفيفه أو تلطيفه)",
 "unmitigated": "صرف, غير مخفف (غير منقوص أو ملطف في الشدة؛ يستخدم أحياناً كأداة توكيد)\nمثال: معاناة غير مخففة",
 "unmixable": "غير قابل للامتزاج, غير مزوج ((في الكيمياء والفيزياء) غير قابل للخلط)",
 "unmixed": "بَسِيط, غَيْرُ مُرَكَّب (لا يشكّل مركّبًا؛ غير ممزوج) / صِرْف, غَيْرُ مَمْزُوج (غير مخلوط بعناصر دخيلة)",
 "unmoderated": "غَيْرُ مُعْتَدِل (لَمْ يُجْعَلْ أَقَلَّ تَطَرُّفًا)",
 "unmodernised": "غَيْر مُحَدَّث (لم يتمّ تحديثه أو عصرنته)",
 "unmodernized": "غَيْر مُحَدَّث (لم يتمّ تحديثه أو عصرنته)",
 "unmodifiable": "غَيْر قَابِل لِلتَّعْدِيل (غير قادر على أن يُعدل في الشكل أو الشخصية أو القوة (خاصة بجعله أقل تطرفاً))\nمثال: هذه الاختلافات عن العرف غير منطقية وغير مفهومة وغير قابلة للتعديل",
 "unmodified": "على حاله, غير معدل (لم يتغير شكله أو طابعه)",
 "unmodulated": "رتيب, غير منغم (يتسم بانعدام التنوع في الطبقة الصوتية أو النبرة أو الحجم)\nمثال: حاضر بصوت رتيب مشوب بالهستيريا",
 "unmolested": "غَيْرُ مُتَعَرَّض لِلْأَذَى (لم يتعرض لتدخل أو إزعاج أو أذى)",
 "unmortgaged": "خَالِصٌ مِنَ الرُّهُون, صَافٍ ((خاصة عن سند ملكية) خالٍ من أيّ رهن أو قيد يطرح مسألة واقعية أو قانونية)",
 "unmotivated": "غير متحمس, فاقد للدافع (بدون دافع)",
 "unmotorised": "بلا محرك, غير آلي (لا يحتوي على محرك)",
 "unmotorized": "بلا محرك, غير آلي (لا يحتوي على محرك)",
 "unmourned": "غير مأسوف عليه (لا يُحزن عليه؛ لا يسبب الحداد)\nمثال: دُفن في قبر غير مأسوف عليه",
 "unmovable": "رَاسِخ, غَيْرُ قَابِلٍ لِلتَّحْرِيك (لَا يُمْكِنُ تَحْرِيكُهُ أَوْ لَا يُقْصَدُ بِهِ أَنْ يُنْقَل)",
 "unmoved": "فِي مَوْضِعِه الأَصْلِيّ (في موقعه الأصليّ؛ لم يُنقَل من مكانه)",
 "unmoving": "غير مؤثر (لا يثير المشاعر) / ساكن, غير متحرك (ليس في حالة حركة)",
 "unmown": "غير محشوش, غير مقصوص ((يستخدم للعشب أو النباتات) لم يتم قطعه بأداة يدوية أو آلة)\nمثال: عشب غير مقصوص",
 "unmusical": "غير شجي, غير موسيقي (يفتقر إلى اللحن) / غير موسيقي (غير موسيقي بطبيعته) / عديم الموهبة الموسيقية (يفتقر إلى الاهتمام بالموسيقى أو الموهبة فيها)\nمثال: صرخة طائر القيق الأزرق غير الموسيقية",
 "unmusicality": "افْتِقَار لِلْحِسّ المُوسِيقِيّ (حالة أو وضع الافتقار إلى القدرة الموسيقية)"
}
