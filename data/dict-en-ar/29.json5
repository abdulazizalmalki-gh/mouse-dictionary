 "trier": "مُحَاوِل (من يحاول) / فاحص, مقرر (الشخص (كالقاضي) الذي يفحص ويفصل في قضية)",
 "trieste": "تْرِيِيسْتِي",
 "trifid": "ثُلَاثِيُّ الفُصُوص (مُنْقَسِمٌ إِلَى ثَلَاثَةِ فُصُوص)",
 "trifid beggar-ticks": "قراد المتسول الأوروبي, قطيفة شائكة ثلاثية الفصوص (قطيفة شائكة في أوراسيا المعتدلة)",
 "trifid bur marigold": "قراد المتسول الأوروبي, قطيفة شائكة ثلاثية الفصوص (قطيفة شائكة في أوراسيا المعتدلة)",
 "trifle": "تفاهة, شيء تافه (شيء قليل الأهمية) / أمر تافه, تفاهة (تفصيل يعتبر غير مهم) / ترافل (بودينغ بارد مصنوع من طبقات من الكعك الاسفنجي المدهون بالفاكهة أو الجيلي؛ وقد يُزين بالمكسرات أو الكريمة أو الشوكولاتة)",
 "trifler": "عابث (شخص يتصرف بخفة أو عدم جدية)",
 "trifling": "تضييع الوقت, عبث (الفعل المتعمد للتأخير واللعب بدلاً من العمل) / زَهِيد, ضَئِيل (لَا يَسْتَحِقُّ الاِعْتِبَار)",
 "trifluoromethane": "فلوروفورم",
 "trifoliata": "برتقال بري, برتقال ثلاثي الأوراق (شجرة برتقال صينية نفضية شائكة صغيرة سريعة النمو تحمل زهوراً حلوة الرائحة وثماراً زخرفية ولكن غير صالحة للأكل: تستخدم كأصل في التطعيم وللأسوار الحية)",
 "trifoliate": "ثُلَاثِيّ الأَوْرَاق ((عن شكل الورقة) ذو ثلاث وريقات)",
 "trifoliate orange": "برتقال بري, برتقال ثلاثي الأوراق (شجرة برتقال صينية نفضية شائكة صغيرة سريعة النمو تحمل زهوراً حلوة الرائحة وثماراً زخرفية ولكن غير صالحة للأكل: تستخدم كأصل في التطعيم وللأسوار الحية)",
 "trifoliated": "ثُلَاثِيّ الأَوْرَاق ((عن شكل الورقة) ذو ثلاث وريقات)",
 "trifoliolate": "ثُلَاثِيّ الأَوْرَاق ((عن شكل الورقة) ذو ثلاث وريقات)",
 "trifoliolate leaf": "ورقة ثلاثية الوريقات (لها ثلاث وريقات)",
 "trifolium alpinum": "نفل ألبي (نفل جبلي أوروبي ذو أزهار عطرة عادة ما تكون وردية)",
 "trifolium dubium": "نفل صغير, نفل مشكوك (نفل موطنه أيرلندا ذو أزهار مصفرة؛ غالباً ما يعتبر النفل الحقيقي أو الأصلي)",
 "trifolium incarnatum": "نفل إيطالي, نفل قرمزي (نبات حولي من جنوب أوروبا ذو رؤوس شائكة من الزهور القرمزية؛ يزرع بكثافة في الولايات المتحدة كعلف)",
 "trifolium pratense": "نفل المروج, نفل بنفسجي (نبات معمر قصير العمر، منتصب إلى منبطح، ذو أزهار حمراء أرجوانية إلى وردية؛ أكثر أنواع نفل العلف زراعة)",
 "trifolium reflexum": "نفل الجاموس (نفل من غرب الولايات المتحدة)",
 "trifolium repens": "نفل أبيض, نفل زاحف (نفل أوروبي زاحف ذو أزهار بيضاء إلى وردية وأوراق خضراء زاهية؛ متوطن في الولايات المتحدة؛ يزرع على نطاق واسع كعلف)",
 "trifolium stoloniferum": "نفل الجاموس (نفل من غرب الولايات المتحدة)",
 "trifurcation": "تفرع ثلاثي (عملية الانقسام إلى ثلاثة فروع)",
 "trig": "أَنِيقُ المَظْهَر, مُهَذَّب (مُرَتَّبٌ وَأَنِيقٌ فِي المَظْهَر) / حساب المثلثات (رياضيات المثلثات والدوال المثلثية)",
 "trigeminal": "عصب ثلاثي التوائم, عصب قحفي خامس (العصب الحسي الرئيسي للوجه والعصب الحركي لعضلات المضغ)",
 "trigeminal nerve": "عصب ثلاثي التوائم, عصب قحفي خامس (العصب الحسي الرئيسي للوجه والعصب الحركي لعضلات المضغ)",
 "trigeminal neuralgia": "ألم العصب الثلاثي التوائم (ألم عصبي انتيابي شديد على طول العصب الثلاثي التوائم)",
 "trigeminus": "عصب ثلاثي التوائم, عصب قحفي خامس (العصب الحسي الرئيسي للوجه والعصب الحركي لعضلات المضغ)",
 "trigger": "زِنَاد",
 "trigger-happy": "جَامِح, حَادّ (يَتَّسِمُ بِشِدَّةٍ مُتَطَرِّفَةٍ فِي المَشَاعِرِ أَوِ القَنَاعَات؛ يَمِيلُ إِلَى رَدِّ الفِعْلِ العَنِيف) / مُتَهَوِّرٌ فِي اسْتِخْدَامِ السِّلَاح (غير مسؤول في استخدام الأسلحة النارية)",
 "triggerfish": "سمكة الزناد (أي من الأسماك الاستوائية العديدة المضغوطة عميقة الجسم ذات جلد يشبه ورق الصنفرة وأشواك قابلة للانتصاب في الزعنفة الظهرية الأولى)",
 "triggerman": "قاتل مأجور, مسلح مأجور (قاتل محترف يستخدم سلاحاً نارياً)",
 "trigla lucerna": "الخرنار, الغرنار الأصفر (نوع من أسماك الغرنار)",
 "triglochin maritima": "تريغلوشين بحري, عشب السهم (نبات معمر ذو خصلات يوجد في المياه الضحلة أو المستنقعات؛ يسمم الماشية أحياناً)",
 "triglyceride": "تريغليسريد, دهن ثلاثي (غليسريد يوجد طبيعياً في الأنسجة الحيوانية والنباتية؛ يتكون من ثلاثة أحماض دهنية فردية مرتبطة معاً في جزيء واحد كبير؛ وهو مصدر مهم للطاقة يشكل معظم…)",
 "trigon": "قيثارة مثلثة (قيثارة مثلثة الشكل من اليونان وروما القديمة) / مثلث ((في التنجيم) واحدة من أربع مجموعات من الأبراج، حيث تتكون كل مجموعة من ثلاثة أبراج تفصل بينها 120 درجة) / مثلث (مضلع له ثلاثة أضلاع)",
 "trigonal": "ثُلَاثِيّ, مُعَيَّنِيّ السُّطُوح (ذو تناظر ثلاثي)",
 "trigonella foenumgraecum": "حلبة (عشب حولي في جنوب أوروبا وشرق آسيا له أزهار بيضاء مائلة للصفرة وبذور عطرية تستخدم طبياً وفي الكاري)",
 "trigonella ornithopodioides": "تريغونيلا, نفل الطيور (عشب من العالم القديم يرتبط بالحلبة)",
 "trigonometric": "مثلثي (متعلق بمبادئ علم المثلثات أو وفقاً لها)\nمثال: دالة مثلثية",
 "trigonometric function": "دَالَّة دَائِرِيَّة, دَالَّة مُثَلَّثِيَّة (دالة لزاوية معبر عنها كنسبة لطول أضلاع مثلث قائم الزاوية يحتوي على الزاوية)",
 "trigonometrician": "عالم حساب المثلثات (عالم رياضيات متخصص في حساب المثلثات)",
 "trigonometry": "عِلْم اَلْمُثَلَثَات, عِلْم حِسَاب اَلْمُثَلَثَات (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "trigonum cerebrale": "قبو (حزمة مقوسة من الألياف البيضاء في قاعدة الدماغ من خلالها يسقط الحصين في كل نصف كرة مخية إلى الحصين المقابل وإلى المهاد والأجسام الحلمية)",
 "trigram": "كلمة ثلاثية الحروف (كلمة تُكتب بثلاثة أحرف في نظام كتابة أبجدي)",
 "trihydroxy": "ثلاثي الهيدروكسيل (يحتوي على ثلاث مجموعات هيدروكسيل)",
 "triiodomethane": "ثلاثي يود ميثان, يودوفورم (مادة صلبة بلورية صفراء ذات رائحة نفاذة؛ تستخدم أحياناً كضمادة مطهرة)",
 "triiodothyronine": "ثلاثي يود الثيرونين (هرمون درقي يشبه الثيروكسين ولكن مع ذرة يود واحدة أقل لكل جزيء وينتج بكمية أقل؛ يمارس نفس التأثيرات البيولوجية للثيروكسين ولكنه أكثر فاعلية وأقصر مدة)",
 "trike": "دراجة ثلاثية العجلات (مركبة بثلاث عجلات يتم تحريكها بواسطة دواسات القدم)",
 "trilateral": "ثُلَاثِيّ الأَضْلَاع (ذو ثلاثة أضلاع) / ثُلَاثِيّ الْأَطْرَافِ (يشمل ثلاثة أطراف) / مثلث (مضلع له ثلاثة أضلاع)",
 "trilby": "فيدورا, قبعة لباد (قبعة مصنوعة من اللباد ذات تاج مجعد)",
 "trilingual": "ثُلَاثِيُّ اللُّغَة (يَسْتَخْدِمُ أَوْ يُتْقِنُ ثَلَاثَ لُغَات)",
 "trilisa odoratissima": "تريليسا, فانيليا برية (نبات معمر في جنوب شرق الولايات المتحدة بأوراق لها رائحة الفانيليا)",
 "trill": "تَكْرِير",
 "trilled": "مُرَجَّع, مُكَرَّر (يُنطَق بترجيع أو ترعيد)",
 "trillion": "بِلْيُون (مَلْيُونُ مَلْيُونٍ (بريطانيا)؛ الف مِلْيون أي مِلْيار (الولايات المتحدة الأمريكية)) / تِرِيلِيُون / تِرِيلِْيُون\nمثال: الشركة عانت من خسارة واحد بليون ين السنة الماضية.",
 "trillion floating point operations per second": "تيرا فلوب ((علم الحاسوب) وحدة لقياس سرعة نظام الحاسوب، حيث 1 تيرا فلوب يعادل تريليون عملية نقطة عائمة في الثانية)",
 "trillionaire": "بِلْيُونِير / تْرِلْيُونِير",
 "trillionth": "اَلتِّرِلْيُونُ (العدد الترتيبي لتريليون في العدّ) / جُزْء مِن تِرِيلْيُون (جزء واحد من تريليون جزء متساوي)",
 "trillium": "تريليوم, زنبق الخشب (أي نبات زنبقي من جنس التريليوم له دوامة من ثلاث أوراق في قمة الساق مع زهرة واحدة بثلاث بتلات)",
 "trillium erectum": "تريليوم أحمر, تريليوم أرجواني (تريليوم من شرق أمريكا الشمالية له زهور وردية إلى أرجوانية كريهة الرائحة وجذر قابض يستخدم في الطب الشعبي خاصة لتسهيل الولادة)",
 "trillium recurvatum": "تريليوم البراري, تريليوم منحني (تريليوم من وسط الولايات المتحدة له زهور أرجوانية داكنة لاطئة)",
 "trillium sessile": "تريليوم أحمر, تريليوم لاطئ (تريليوم من شمال شرق الولايات المتحدة بأوراق لاطئة وزهور حمراء أو أرجوانية لها رائحة نفاذة)",
 "trilobate": "ثُلَاثِيّ الفُصُوص ((عن شكل الورقة) مُقسَّم إلى ثلاثة فُصوص)",
 "trilobated": "ثُلَاثِيّ الفُصُوص ((عن شكل الورقة) مُقسَّم إلى ثلاثة فُصوص)",
 "trilobed": "ثُلَاثِيّ الفُصُوص ((عن شكل الورقة) مُقسَّم إلى ثلاثة فُصوص)",
 "trilobite": "ثلاثي الفصوص (مفصلي منقرض كان وفيراً في عصور حقب الحياة القديمة؛ كان له هيكل خارجي مقسم إلى ثلاثة أجزاء)",
 "trilogy": "ثُلَاثِيَّة",
 "trim": "شَذَّبَ, قَلَّمَ",
 "trimaran": "قارب ثلاثي البدن (قارب شراعي سريع بثلاثة أبدان متوازية)",
 "trimer": "تريمر, ثلاثي الوحدات (بوليمر (أو جزيء من بوليمر) يتكون من ثلاثة مونومرات متطابقة)",
 "trimester": "أُثْلُوث",
 "trimipramine": "تريميبرامين, سورمونتيل (دواء مضاد للاكتئاب ثلاثي الحلقات (الاسم التجاري سورمونتيل) يستخدم لعلاج الاكتئاب والقلق و(أحياناً) الأرق)",
 "trimly": "بأناقة, بترتيب (بطريقة مرتبة وأنيقة)\nمثال: كان يرتدي ملابس أنيقة ومرتبة",
 "trimmed": "مشذب, مقصص (مرتب وأنيق عن طريق التشذيب)\nمثال: شعره المشذب بأناقة",
 "trimmer": "رافدة عرضية (رافدة تتلقى نهاية رأسية في تأطير الأرضية أو السقف لترك فتحة لدرج أو مدخنة وما إلى ذلك) / مكثف ضبط دقيق (مكثف ذو سعة متغيرة؛ يستخدم لإجراء تعديلات دقيقة) / آلة تشذيب (آلة تشذب الأخشاب) / مقلّم الأشجار (عامل يخفف ويشذب الأشجار والشجيرات)\nمثال: لم يمسها فأس مقلّم الأشجار",
 "trimmer arch": "قوس الموقد (قوس مبني في أرضية (لدعم وزن الموقد))",
 "trimmer joist": "رافدة عرضية (رافدة تتلقى نهاية رأسية في تأطير الأرضية أو السقف لترك فتحة لدرج أو مدخنة وما إلى ذلك)",
 "trimming": "تزيين (فعل إضافة الزينة) / تشذيب, تقليم (القص وصولاً للحجم أو الشكل المطلوب) / تزيين الأطراف, حاشية (زينة أو زخرفة عادة ما تكون على حافة الملابس)\nمثال: كان يجب أن يكون الأطفال في السرير قبل أن يحين وقت تزيين الشجرة",
 "trimming capacitor": "مكثف ضبط دقيق (مكثف ذو سعة متغيرة؛ يستخدم لإجراء تعديلات دقيقة)",
 "trimmings": "زينة, لوازم (الملحقات التي تصاحب عادةً (شيئاً ما أو نشاطاً ما))\nمثال: عشاء رسمي فاخر مع كامل لوازمه",
 "trimness": "ترتيب, هيئة (حالة من الترتيب أو المظهر)\nمثال: في هيئة جيدة",
 "trimorphodon lambda": "ثعبان القيثارة سونوران (من المناطق الصحراوية في جنوب غرب أمريكا الشمالية)",
 "trimotored": "ثُلَاثِيّ المُحَرِّكَات (مزود بثلاثة محركات)",
 "trimox": "أموكسيسيلين, أموكسيل (مضاد حيوي؛ بنسلين فموي شبه صناعي (الأسماء التجارية أموكسيل وأوجمنتين وغيرها) يستخدم لعلاج الالتهابات البكتيرية)",
 "trine": "ثَلَاثَة, ثُلَاثِيّ (العدد الأصلي الذي هو مجموع واحد وواحد وواحد)",
 "trine immersion": "تغطيس ثلاثي (المعمودية بالتغطيس ثلاث مرات)",
 "trinectes maculatus": "خانق الخنزير (غير مفيدة كطعام؛ توجد في الجداول الساحلية من مين إلى تكساس وبنما)",
 "tringa flavipes": "صفراء الساق الصغرى (نوع من طيور صفراء الساق، طائر شاطئي صغير في أمريكا الشمالية)",
 "tringa melanoleuca": "صفراء الساق الكبرى (نوع من طيور صفراء الساق، طائر شاطئي كبير في أمريكا الشمالية)",
 "tringa nebularia": "طيطوي أخضر الساق (طيطوي أوروبي كبير ذو أرجل مخضرة)",
 "tringa totanus": "طيطوي أحمر الساق (طائر خوض شائع في العالم القديم ذو أرجل حمراء طويلة)",
 "trinidad": "ترينيداد",
 "trinidad and tobago": "تْرِينِيدَاد وَتُوبَاغُو",
 "trinidad and tobago dollar": "دولار ترينيداد وتوباغو (وحدة المال الأساسية في ترينيداد وتوباغو)",
 "trinidadian": "ترينيدادي (من أو متعلق بجزيرة ترينيداد) / ترينيدادي (مواطن أو ساكن في ترينيداد)\nمثال: رم ترينيدادي",
 "trinil man": "إنسان جاوة (كَائِن بَشَرِيّ؛ سَوَاد العَيْن)\nمثال: أنا إنسان صادق.",
 "trinitarian": "ثالُوثِيّ (معتنق لعقيدة الثالوث)",
 "trinitarianism": "تثليث, عقيدة الثالوث (عقيدة مسيحية تؤكد الإيمان بالثالوث)",
 "trinitroglycerin": "ثلاثي نيتروجليسرين, نيتروجليسرين (سائل زيتي ثقيل أصفر سام متفجر يتم الحصول عليه عن طريق نيترة الجلسرين؛ يستخدم في صنع المتفجرات وطبياً كموسع للأوعية الدموية)",
 "trinitrotoluene": "تي إن تي, ثلاثي نتروتولوين (مادة متفجرة تتكون من مركب بلوري أصفر وهو مشتق سام وقابل للاشتعال من التولوين)",
 "trinity": "ثَالُوث",
 "trinity sunday": "أحد الثالوث (ثامن أحد بعد عيد الفصح)",
 "trinket": "حلي رخيصة, حلية مبهرجة (مجوهرات رخيصة ومبهرجة أو زينة على الملابس)",
 "trinketry": "حلي, زينة (الحلي وغيرها من زينة الملابس مجتمعة)",
 "trinuclear": "ثُلَاثِيّ النَّوَى (لديه ثلاث نوى)",
 "trinucleate": "ثُلَاثِيّ النَّوَى (لديه ثلاث نوى)",
 "trinucleated": "ثُلَاثِيّ النَّوَى (لديه ثلاث نوى)",
 "trio": "تريو, ثلاثي (تأليف موسيقي لثلاثة مؤديين) / ثالثة, ثلاثي (ثلاثة أشخاص يُنظر إليهم كوحدة واحدة) / ثلاثي (مجموعة من ثلاثة أشياء متشابهة تُعتبر كوحدة واحدة) / ثلاثي (ثلاثة مؤدين أو مغنين يؤدون معاً)",
 "triode": "ترايود, ثلاثي المساري (أنبوب مفرغ حراري يحتوي على ثلاثة أقطاب كهربائية؛ تقلبات الشحنة على الشبكة تتحكم في التدفق من الكاثود إلى الأنود مما يجعل التضخيم ممكناً)",
 "triolein": "أولين, تريولين (غليسريد يحدث طبيعياً لحمض الأوليك ويوجد في الدهون والزيوت)",
 "trionyx muticus": "سلحفاة ناعمة ملساء (سلحفاة نهرية من حوض المسيسيبي؛ تفضل المياه الجارية)",
 "trionyx spiniferus": "سلحفاة ناعمة شوكية (سلحفاة نهرية من غرب الولايات المتحدة ذات صدفة ثؤلولية؛ تفضل المياه الهادئة)",
 "triose": "تريوز, سكر ثلاثي (أي سكر أحادي يحتوي على ثلاث ذرات كربون في الجزيء)",
 "triosteum perfoliatum": "جذر الحمى, جنطيانا الحصان (عشب أمريكي معمر خشن ضار بأوراق كبيرة عادة ما تكون محيطة بالساق وأزهار أرجوانية أو حمراء باهتة)",
 "triostium perfoliatum": "جذر الحمى, جنطيانا الحصان (عشب أمريكي معمر خشن ضار بأوراق كبيرة عادة ما تكون محيطة بالساق وأزهار أرجوانية أو حمراء باهتة)",
 "trioxide": "ثلاثي أكسيد (أكسيد يحتوي على ثلاث ذرات من الأكسجين في الجزيء)",
 "trip": "هَذَيَان / هَذَى",
 "trip line": "حبل التحرير (حبل خفيف يستخدم في قطع الأشجار لتحرير خطاف التثبيت من جذع خشبي عن بعد)",
 "trip wire": "سلك تفجير, سلك عثرة (سلك ممدود بالقرب من الأرض يفعل شيئاً (فخاً أو كاميرا أو سلاحاً) عند التعثر به) / سلك عثرة, قوة إنذار مبكر (قوة عسكرية صغيرة تعمل كخط دفاع أول؛ إذا انخرطت في أعمال عدائية، فسيؤدي ذلك إلى تدخل قوات عسكرية أقوى)",
 "trip-up": "عثرة, كبوة (خطأ غير مقصود ولكنه محرج)\nمثال: تلا القصيدة كاملة دون عثرة واحدة",
 "tripalmitin": "تريبالستين (ثلاثي غليسريد لحمض البالمتيك)",
 "tripartite": "ثُلَاثِيّ الأَطْرَاف (يشمل ثلاثة أطراف أو عناصر)",
 "tripe": "كرشة",
 "triphammer": "مطرقة آلية, مطرقة ساقطة (مطرقة كهربائية ضخمة؛ ترفع بواسطة حدبة ثم تُترك لتسقط بفعل الجاذبية)",
 "triphosphopyridine": "ثلاثي فوسفوبيريدين (حلقة بيريدين مع ثلاث مجموعات فوسفور)",
 "triphosphopyridine nucleotide": "ثلاثي فوسفوبيريدين نوكليوتيد (مرافق إنزيم للعديد من الإنزيمات)",
 "triphosphoric acid": "حمض ثلاثي الفوسفوريك (حمض هو أنهيدريد جزئي لثلاثة جزيئات من حمض الفوسفوريك؛ يعرف بشكل رئيسي في شكل أملاحه وإستراته)",
 "triphthong": "تْرِفْثُنْغ",
 "tripinnate": "ثُلَاثِيّ التَّرِيُّش ((عن شكل الورقة) ريشيّ ثلاثيّ المُستوى)",
 "tripinnated": "ثُلَاثِيّ التَّرِيُّش ((عن شكل الورقة) ريشيّ ثلاثيّ المُستوى)",
 "tripinnatifid": "ثُلَاثِيّ التَّفْصِيص الرِّيشِيّ ((عن شكل الورقة) ثنائيّ التفصيص الريشيّ مع أجزاء ريشيّة التفصيص بدورها)",
 "triple": "ثُلَاثِيّ",
 "triple cream": "تريبل كريم (جبن فرنسي طري طازج يحتوي على 72% دهون على الأقل)",
 "triple creme": "تريبل كريم (جبن فرنسي طري طازج يحتوي على 72% دهون على الأقل)",
 "triple crown": "التاج الثلاثي ((بيسبول) لقب غير رسمي يفوز به الضارب الذي يتصدر الدوري في متوسط الضرب، والركضات المسجلة، والضربات الرئيسية) / التاج الثلاثي ((سباق الخيل) لقب يفوز به الحصان الذي يمكنه الفوز بديربي كنتاكي وبيلمونت ستيكس وبريكنيس)",
 "triple jump": "القفز الثلاثي, الوثب الثلاثي (مسابقة رياضية يجب على المنافس فيها أداء قفزة وخطوة وقفزة بشكل متواصل)",
 "triple play": "إخراج ثلاثي, لعبة ثلاثية (فعل إخراج ثلاثة لاعبين في لعبة واحدة)",
 "triple sec": "تريبل سيك (نوع من الكوراساو ذو محتوى كحولي أعلى)",
 "triple time": "وزن ثلاثي (زمن موسيقي بثلاث نقرات في كل مقياس)",
 "triple-crown season": "موسم التاج الثلاثي (موسم بيسبول يفوز فيه لاعب بالتاج الثلاثي)",
 "triple-decker": "كلوب سندويتش (مصنوعة من ثلاث شرائح من الخبز المحمص عادة)",
 "triple-spacing": "مسافة ثلاثية (طباعة تترك سطرين فارغين بين أسطر الكتابة)",
 "triplet": "ثلاثي (مجموعة من ثلاثة أشياء متشابهة تُعتبر كوحدة واحدة) / توأم ثلاثي (واحد من ثلاثة أبناء ولدوا في نفس الوقت من نفس الحمل) / ثَلَاثَة, ثُلَاثِيّ (العدد الأصلي الذي هو مجموع واحد وواحد وواحد)",
 "triplet code": "شفرة ثلاثية (النسخة الطبيعية من الشفرة الوراثية حيث يرمز تسلسل من ثلاثة نيوكليوتيدات لتخليق حمض أميني معين)",
 "tripletail": "ثلاثية الذيل (سمكة غذائية كبيرة في المياه الدافئة حول العالم لها زعانف شرجية وظهرية طويلة توحي مع الزعنفة الذيلية بذيل ثلاثي الفصوص)",
 "tripleurospermum inodorum": "اقحوان الحقول, بابونج غير معطر",
 "tripleurospermum oreades tchihatchewii": "بابونج مرجي",
 "tripleurospermum tchihatchewii": "بابونج تركي",
 "triplex": "ثُلَاثِيّ (ذو ثلاث وحدات أو مكوّنات أو عناصر)",
 "triplicate": "نسخة ثالثة (واحدة من ثلاث نسخ؛ أي من ثلاثة أشياء تتوافق مع بعضها البعض تماماً)",
 "triplicity": "تثليث, ثلاثية (خاصية كون الشيء ثلاثياً) / مثلث ((في التنجيم) واحدة من أربع مجموعات من الأبراج، حيث تتكون كل مجموعة من ثلاثة أبراج تفصل بينها 120 درجة)",
 "tripling": "مضاعفة ثلاث مرات (زيادة بمقدار ثلاثة أضعاف)",
 "triplochiton scleroxcylon": "أوبتشي, سامبا (شجرة كبيرة من غرب أفريقيا ذات أوراق كبيرة مفصصة كفياً وعناقيد سيمية إبطية من الزهور البيضاء الصغيرة وبذور مجنحة واحدة؛ تنتج خشباً ناعماً أبيض إلى…)",
 "triplochiton scleroxylon": "أوبتشي, سامبا (شجرة كبيرة من غرب أفريقيا ذات أوراق كبيرة مفصصة كفياً وعناقيد سيمية إبطية من الزهور البيضاء الصغيرة وبذور مجنحة واحدة؛ تنتج خشباً ناعماً أبيض إلى…)",
 "triploid": "ثُلَاثِيّ الصِّيغَة الصِّبْغِيَّة (لخلية أو كائن حي يحتوي على ثلاث مجموعات كاملة من الكروموسومات)",
 "tripod": "حامل ثلاثي القوائم (رف بثلاثة أرجل يستخدم للدعم)",
 "tripoli": "طَرَابُلُس, طَرَابُلُس الشَّام (عاصمة دولة ليبيا؛ مدينة في دولة لبنان)\nمثال: جدي رح ع طرابلس",
 "tripolitan": "طَرَابُلْسِيّ",
 "tripos": "امتحان الترايبوس (امتحانات درجة الشرف النهائية في جامعة كامبريدج)",
 "tripper": "آلية الفصل, قاطع (آلية التقاط تعمل كمفتاح) / متجول سياحي, متنزه (سائح يزور المعالم السياحية) / متعثر (ماش أو عداء يتعثر ويكاد يسقط) / متهلوس ((عامية) شخص تعاطى عقاراً مخدراً ويمر بهلوسات)\nمثال: الضغط ينشط القاطع ويطلق الماء",
 "tripping": "خَفيف الحَرَكَة, رَشيق (يَتَحَرَّك بِسُهولَة وسُرْعَة وخِفَّة) / خَفِيفُ الإِيقَاع, مَرِح (يتميّز بإيقاع مرح ومتمايل)",
 "trippingly": "بخفة, برشاقة (يتحرك بخطوات خفيفة وسريعة)\nمثال: مشت بخفة ورشاقة أسفل الدرج الطويل",
 "tripton": "تريبتون (المواد الجسيمية غير العضوية العالقة في المسطحات المائية مثل البحيرات والبحار)",
 "triptote": "مُنْصَرِف, مُتَمَكِّن",
 "triptych": "تريبتيك, لوحة ثلاثية (فن يتكون من لوحة أو نحت (خاصة كقطعة مذبح) على ثلاثة ألواح (عادة ما تكون مفصلية معاً))",
 "tripura": "ترايبورا",
 "triquetral": "عظم مثلثي (عظم رسغي يتمفصل مع العظام الحمصية والكلابية والهلالية)",
 "triquetral bone": "عظم مثلثي (عظم رسغي يتمفصل مع العظام الحمصية والكلابية والهلالية)",
 "triquetrous leek": "كراث ثلاثي الزوايا (كراث أوروبي متوطن في بريطانيا العظمى؛ الأوراق مثلثة الشكل)",
 "trireme": "سفينة ثلاثية المجاديف (قادس يوناني أو روماني قديم أو سفينة حربية لها ثلاثة صفوف من المجاديف على كل جانب)",
 "trisaccharide": "سكر ثلاثي (أي من مجموعة متنوعة من الكربوهيدرات التي تنتج ثلاثة جزيئات من السكر الأحادي عند التحلل المائي الكامل)",
 "trisect": "ثَلَّثَ الزَاوِيَة (ثَلَثَ الحبل ونحوه يَثْلُثُ ثَلْثًا: فَتَلَهُ من ثلاث قُوى؛ ثَلَثَ العمل: عمله ثلات مرات)\nمثال: الساعة العاشرة والثلث.",
 "triskaidekaphobia": "رهاب الرقم 13 (خوف مرضي من الرقم 13)",
 "triskaidekaphobic": "رُهَابِيّ العَدَد ثَلَاثَة عَشَر (يعاني من رهاب العدد ثلاثة عشر (خوف غير طبيعي منه))",
 "triskele": "تريسكليون, رمز ثلاثي الأذرع (شكل يتكون من ثلاثة أذرع أو أرجل بشرية منمقة (أو ثلاثة خطوط منحنية) تشع من المركز)",
 "triskelion": "تريسكليون, رمز ثلاثي الأذرع (شكل يتكون من ثلاثة أذرع أو أرجل بشرية منمقة (أو ثلاثة خطوط منحنية) تشع من المركز)",
 "trismus": "ضزز, كزاز الفك (تشنج طويل الأمد لعضلات الفك)",
 "trisodium orthophosphate": "فوسفات ثلاثي الصوديوم (الفوسفات الثالثي للصوديوم يستخدم كمحسن في الصابون والمنظفات)",
 "trisodium phosphate": "فوسفات ثلاثي الصوديوم (الفوسفات الثالثي للصوديوم يستخدم كمحسن في الصابون والمنظفات)",
 "trisomy": "تثلث الصبغي (شذوذ كروموسومي يكون فيه كروموسوم واحد أكثر من العدد الطبيعي للكروموسومات في الخلية)",
 "trisomy 21": "المنغولية, متلازمة داون (اضطراب خلقي ناجم عن وجود كروموسوم 21 إضافي؛ يؤدي إلى وجه مسطح وقصر القامة وتخلف عقلي)",
 "tristan da cunha": "تريستان دا كونا",
 "tristearin": "تريستيرين (ثلاثي غليسريد لحمض الستياريك)",
 "trisyllable": "كلمة ثلاثية المقاطع (كلمة تحتوي على ثلاثة مقاطع)",
 "tritanopia": "عمى الأزرق (شكل نادر من عمى الألوان الثنائي يتميز بانخفاض الحساسية للضوء الأزرق مما يؤدي إلى عدم القدرة على التمييز بين الأزرق والأصفر)",
 "tritanopic": "مُصَاب بِعَمَى الأَزْرَق (عدم القدرة على رؤية اللون الأزرق أو التمييز بين الأزرق والأصفر)",
 "trite": "مُبْتَذَل, مُسْتَهْلَك (مُكرَّر أكثر من اللازم؛ مألوف بشكل مفرط بسبب كثرة الاستخدام)",
 "tritely": "بابتذال (بطريقة مبتذلة)\nمثال: عواطف معبر عنها بابتذال",
 "triteness": "ابتذال (عدم الأصالة نتيجة كون الشيء مملاً ومكرراً)",
 "tritheism": "عقيدة الآلهة الثلاثة ((المسيحية) الاعتقاد المهرطق بأن الآب والابن والروح القدس هم ثلاثة آلهة منفصلة)",
 "tritheist": "مؤمن بالثلاثة (شخص (ليس مسيحياً أرثوذكسياً) يعتقد أن الآب والابن والروح القدس هم ثلاثة آلهة منفصلة)",
 "triticum aestivum": "قمح الخبز, قمح طري (يزرع على نطاق واسع في المناطق المعتدلة في العديد من الأصناف لحبوبه المهمة تجارياً)",
 "triticum aestivum spelta": "حنطة, قمح سبلتا (قمح قوي يزرع غالباً في أوروبا لعلف الماشية)",
 "triticum dicoccum": "إيمر, قمح ثنائي الحبة (قمح أحمر صلب يزرع خاصة في روسيا وألمانيا؛ وفي الولايات المتحدة كعلف للماشية)",
 "triticum dicoccum dicoccoides": "قمح بري (يوجد برياً في فلسطين؛ يعتبر النموذج الأولي للقمح المزروع)",
 "triticum durum": "قمح المعكرونة, قمح ديورم (قمح ذو حبات صلبة داكنة اللون غنية بالغلوتين ويستخدم للخبز والمعكرونة؛ يزرع خاصة في جنوب روسيا وشمال أفريقيا وشمال وسط أمريكا الشمالية)",
 "triticum spelta": "حنطة, قمح سبلتا (قمح قوي يزرع غالباً في أوروبا لعلف الماشية)",
 "triticum turgidum": "قمح المعكرونة, قمح ديورم (قمح ذو حبات صلبة داكنة اللون غنية بالغلوتين ويستخدم للخبز والمعكرونة؛ يزرع خاصة في جنوب روسيا وشمال أفريقيا وشمال وسط أمريكا الشمالية)",
 "tritium": "تريتيوم (نظير مشع للهيدروجين؛ ذرات التريتيوم لها ثلاثة أضعاف كتلة ذرات الهيدروجين العادي)",
 "tritoma": "تريتوما, زهرة الشعلة",
 "triton": "تْرَايْتُون",
 "triturus vulgaris": "سمندل الماء الشائع (سمندل صغير شبه مائي)",
 "triumph": "نصر (نصر بمعنى: أعان، نصره الله: أعانه)\nمثال: هذا النصر هو نصركم.",
 "triumphal": "ظَافِر, مُبْتَهِج (فَرِحٌ وَفَخُورٌ خَاصَّةً بِسَبَبِ نَصْرٍ أَوْ نَجَاح) / انتصاري, ظفري (يتعلق بالاحتفال بانتصار أو نصر)\nمثال: موكب نصر",
 "triumphal arch": "قوس النصر (قوس تذكاري ضخم؛ يُبنى عادة لإحياء ذكرى انتصار بارز)",
 "triumphant": "ظَافِر, مُنْتَصِر (يَعِيشُ تَجْرِبَةَ النَّصْرِ وَالظَّفَر) / ظَافِر, مُبْتَهِج (فَرِحٌ وَفَخُورٌ خَاصَّةً بِسَبَبِ نَصْرٍ أَوْ نَجَاح)",
 "triumphantly": "بانتصار, بزهو (بطريقة منتصرة)\nمثال: صرخت بانتصار",
 "triumvir": "عضو مجلس الحكم الثلاثي (واحد من مجموعة من ثلاثة أشخاص يتقاسمون الإدارة العامة أو السلطة المدنية خاصة في روما القديمة)",
 "triumvirate": "حكم ثلاثي, مجلس ثلاثي (مجموعة من ثلاثة رجال مسؤولين عن الإدارة العامة أو السلطة المدنية)",
 "triune": "ثَالُوثِيّ (ثلاثة في واحد؛ يُستخدم خاصة للثالوث المسيحي)",
 "trivalent": "ثلاثي التكافؤ (لديه تكافؤ ثلاثة)",
 "trivalent live oral poliomyelitis vaccine": "لقاح سابين, لقاح شلل الأطفال الفموي (لقاح فموي (يحتوي على فيروس شلل أطفال حي ولكن ضعيف) يعطى لتوفير المناعة ضد شلل الأطفال)",
 "trivet": "حامل ثلاثي (حامل بأرجل قصيرة يستخدم تحت طبق ساخن على طاولة) / حامل ثلاثي (حامل معدني بثلاثة أرجل لدعم وعاء الطهي في الموقد)",
 "trivia": "تفاهة, شيء تافه (شيء قليل الأهمية)",
 "trivial": "تافِه",
 "triviality": "تفاهة, شيء تافه (شيء قليل الأهمية) / تفاهة, ضآلة (صفة كون الشيء غير مهم وتافهاً أو سطحياً) / أمر تافه, تفاهة (تفصيل يعتبر غير مهم)",
 "trivially": "بتفاهة (بطريقة تافهة وعابثة) / بسهولة تامة, بشكل بديهي (بجهد ضئيل)\nمثال: طلبات ذات دوافع تافهة",
 "trivium": "الثلاثية ((العصور الوسطى) منهج تمهيدي في جامعة من العصور الوسطى يشمل النحو والمنطق والبلاغة؛ يعتبر طريقاً ثلاثياً للفصاحة)",
 "trm": "وقت الإرسال (التوقيت العالمي المنسق عند إرسال بث من الأرض إلى مركبة فضائية أو جرم سماوي آخر)",
 "trna": "حمض نووي ريبوزي ناقل (أصبح حامضًا، تغير الطعم إلى الحموضة؛ ارتفعت نسبة الحموضة في شيء ما، كما في الطعام أو السوائل)\nمثال: رمى ياني الحمض على وجه سكورة.",
 "troak": "قايض",
 "trochaic": "تروكي (من أو يتكون من التفاعيل التروكية (مقطع مشدد يليه مقطع غير مشدد))\nمثال: داكتيل تروكي",
 "trochanter": "مدور (أحد النتوءات العظمية التي تنمو بالقرب من الطرف العلوي لعظم الفخذ والتي تتصل بها العضلات)",
 "troche": "حلوى الحلق, قرص السعال (قرص طبي يستخدم لتهدئة الحلق)",
 "trochee": "تفعيلة تروكية, تفعيلة طويلة-قصيرة (وحدة مترية بمقاطع مشددة-غير مشددة)",
 "trochlear": "عصب بكري, عصب قحفي رابع (أي من العصبين القحفيين على كلا الجانبين اللذين يتحكمان في العضلات المائلة العلوية للعينين)",
 "trochlear nerve": "عصب بكري, عصب قحفي رابع (أي من العصبين القحفيين على كلا الجانبين اللذين يتحكمان في العضلات المائلة العلوية للعينين)",
 "trochlearis": "عصب بكري, عصب قحفي رابع (أي من العصبين القحفيين على كلا الجانبين اللذين يتحكمان في العضلات المائلة العلوية للعينين)",
 "trogium pulsatorium": "قمل الكتب الشائع (نوع من قمل الكتب)",
 "troglodyte": "ساكن الكهوف (شخص يعيش في كهف) / زاهد, معتزل (من يعيش في عزلة)",
 "troglodytes aedon": "نمنمة المنازل (نمنمة أمريكية شائعة تعشش حول المنازل)",
 "troglodytes troglodytes": "نمنمة الشتاء (نمنمة صغيرة تعيش في الغابات الصنوبرية في نصف الكرة الشمالي)",
 "trogon": "نهاس (طائر غابات في المناطق الدافئة من العالم الجديد له ريش لامع وذيول طويلة)",
 "troika": "عربة ترويكا (عربة روسية تجرها ثلاثة خيول جنباً إلى جنب) / ترويكا, تريكا (حكم ثلاثي روسي حديث) / ثَلَاثَة, ثُلَاثِيّ (العدد الأصلي الذي هو مجموع واحد وواحد وواحد)",
 "trojan": "طروادي (من أو متعلق بمدينة طروادة القديمة أو سكانها) / تروجان, حصان طروادة (برنامج يبدو مرغوباً فيه ولكنه يحتوي في الواقع على شيء ضار) / طروادي (مواطن من طروادة القديمة)\nمثال: مدن طروادية",
 "trojan horse": "حِصَان طَرْوَادَة (الواحد الذكر من الخَيْل؛ يطلق مجازًا على الواحد من الخيل الذي لا يُعرف ذكر كان أم أنثى)\nمثال: لم يشفى الحصان.",
 "trojniak": "تروينياك (نبيذ عسل بولندي، يُصنع باستخدام وحدتين من الماء لكل وحدة من العسل)",
 "troll": "طْرُول / مُتَصَيِّد, طْرُول",
 "troller": "صياد بالسنارة (صياد يستخدم الخطاف والخيط)",
 "trolley": "ترام, قطار شوارع (مركبة بعجلات تسير على قضبان وتدفع بالكهرباء)",
 "trolley bus": "تْرُولِي بَاص",
 "trolley car": "ترام, قطار شوارع (مركبة بعجلات تسير على قضبان وتدفع بالكهرباء)",
 "trolley coach": "ترولي باص, حافلة كهربائية (حافلة ركاب بمحرك كهربائي تستمد الطاقة من أسلاك علوية)",
 "trolley line": "خط ترام (خط عبور يستخدم عربات الترام أو حافلات الترولي)",
 "trolleybus": "ترولي باص, حافلة كهربائية (حافلة ركاب بمحرك كهربائي تستمد الطاقة من أسلاك علوية)",
 "trolling": "صيد بالجر (الصيد عن طريق سحب خط به طعم عبر الماء)",
 "trolling line": "خيط الصيد المجرور (خيط صيد مزود بخطاف مطعم (طبيعي أو صناعي) تسحبه سفينة بالقرب من السطح أو عند عمق معين)\nمثال: يُسحب خيط الصيد المجرور بسرعة تعتمد على الأنواع المستهدفة، من 2.3 عقدة إلى 7 عقد على الأقل",
 "trollop": "زانية, فاجرة (امرأة ترتكب الزنا) / امرأة قذرة (امرأة قذرة وغير مرتبة) / عاهرة, فاجرة (امرأة منحلّة جنسياً)",
 "trombiculiasis": "داء الخطماوات",
 "trombiculid": "سوس ترومبيكوليد (سوس يتغذى كحورية وبالغ على المراحل المبكرة من مفصليات الأرجل الصغيرة ولكن يرقاته تتطفل على الفقاريات الأرضية)",
 "trombidiid": "سوس ترومبيديد (سوس يتغذى في جميع مراحله على مفصليات الأرجل الأخرى)",
 "trombone": "مُتَرَدِّدَة, تْرُومْبُون",
 "trombone player": "عازف ترومبون (موسيقي يعزف على الترومبون)",
 "trombonist": "عازف ترومبون (موسيقي يعزف على الترومبون)",
 "trompe l'oeil": "ترمبلوي, خداع العين (لوحة مقدمة بتفاصيل دقيقة جداً لخداع المشاهد بشأن حقيقتها)",
 "trompillo": "باذنجان بري, مغد فضي الأوراق (نبات مغد ضار بأوراق فضية وزهور بنفسجية أو زرقاء أو بيضاء؛ تستخدم ثمرته المستديرة على نطاق واسع لتخثير الحليب؛ من وسط الولايات المتحدة إلى أمريكا…)",
 "troop": "فرقة جنود (مجموعة من الجنود) / سرية خيالة (وحدة سلاح الفرسان المقابلة لسرية المشاة) / سرب, فوج (حشد منظم) / فرقة كشافة (وحدة من الكشافة)\nمثال: فوج من الأطفال",
 "troop carrier": "ناقلة جنود (أي مركبة برية أو بحرية أو جوية مصممة لحمل القوات)",
 "troop movement": "تحرك القوات (نقل الوحدات العسكرية إلى موقع جديد)",
 "troop transport": "ناقلة جنود (أي مركبة برية أو بحرية أو جوية مصممة لحمل القوات)",
 "trooper": "جندي خيال, فارس (جندي يمتطي صهوة جواد) / جندي مدرعات (جندي في وحدة جيش آلية) / شُرْطِيّ خَيَّالَة (ضابط شرطة يمتطي حصاناً) / شُرْطِيّ الوِلايَة (ضابط شرطة تابع للولاية)\nمثال: الخيال يعتني دائماً بجواده جيداً",
 "troops": "قُوَّات, عَسْكَرِيَّة",
 "troopship": "سفينة نقل جنود (سفينة لنقل القوات)",
 "tropaeolum majus": "كبوسين كبير, لادن (نبات متسلق حولي قوي النمو له زهور كبيرة بجميع ظلال البرتقالي من الأحمر البرتقالي إلى البرتقالي المصفر وبذور تخلل وتستخدم مثل الكبر)",
 "tropaeolum minus": "كبوسين صغير, لادن شجيري (نبات حولي بزهور صفراء عميقة أصغر من اللادن الشائع)",
 "tropaeolum peregrinum": "زهرة الكناري, كرمة الكناري (نبات متسلق له زهور بلون طيور الكناري)",
 "trope": "صورة بلاغية, مجاز (اللغة المستخدمة بمعنى مجازي أو غير حرفي)",
 "trophic": "غذائي (من أو يتعلق بالتغذية)\nمثال: مستوى غذائي في السلسلة الغذائية",
 "trophobiosis": "تَكَافُل غِذَائِيّ (علاقة تكافلية يحمي فيها كائن حي الآخر مقابل نوع من المنتج الغذائي)",
 "trophoblast": "أرومة مغذية (الغشاء الذي يشكل جدار الكيسة الأريمية في التطور المبكر؛ يساعد في الانغراس في جدار الرحم)",
 "trophoblastic": "أرومي غاذي (من أو متعلق بالأرومة الغاذية)\nمثال: سرطان الأرومة الغاذية",
 "trophoblastic cancer": "سرطان الأرومة الغاذية (ورم خبيث في الرحم مشتق من ظهارة المشيماء)",
 "trophotropic": "انتحائي تغذوي (من أو متعلق بالانتحاء التغذوي)",
 "trophotropism": "انتحاء غذائي (استجابة توجيهية للغذاء)",
 "trophozoite": "أتروفة, تروفوزويت (بوغي في مرحلة التغذية النشطة من دورة حياته)",
 "trophy": "غَنِيمَة",
 "trophy case": "خزانة الجوائز (خزانة لعرض الجوائز والكؤوس)",
 "trophy husband": "زوج زينة, زوج للتباهي (زوج يكون شاباً جذاباً؛ نادراً ما يكون الزوج الأول لامرأة ثرية أكبر سناً)",
 "trophy wife": "زوجة للتباهي (زوجة شابة وجذابة؛ نادراً ما تكون الزوجة الأولى لرجل مسن ثري)\nمثال: كانت زوجته الشابة مكسباً لعمله",
 "tropic": "مَدَار (اسم مَفْعُول من أدَارَ، الشيء أو الشخص الذي أُدِير)\nمثال: انتشرت الشائعة على مدار الدولة.",
 "tropic bird": "طائر استوائي (طائر بحري استوائي أبيض في الغالب مكفف القدمين يوجد غالباً بعيداً عن اليابسة)",
 "tropic of cancer": "مَدَار السَّرَطَان (اسم مَفْعُول من أدَارَ، الشيء أو الشخص الذي أُدِير)\nمثال: انتشرت الشائعة على مدار الدولة.",
 "tropic of capricorn": "مَدَار الْجَدْي (اسم مَفْعُول من أدَارَ، الشيء أو الشخص الذي أُدِير)\nمثال: انتشرت الشائعة على مدار الدولة.",
 "tropical": "مَدَارِيّ",
 "tropical medicine": "طب المناطق الحارة (فرع الطب الذي يتعامل مع تشخيص وعلاج الأمراض الموجودة غالباً في المناطق الاستوائية)",
 "tropical pitcher plant": "نابنط, نبات الإبريق الاستوائي (أي من الشجيرات الاستوائية اللاحمة أو الأعشاب الخشبية من جنس نابنط)",
 "tropical prawn": "قريدس استوائي (قريدس استوائي ومياه دافئة صالح للأكل)",
 "tropical rain forest": "سيلفا, غابة مطيرة استوائية (غابة مطيرة في منطقة استوائية)",
 "tropical rainforest": "غَابَة مَطِيرَة مَدَارِيَّة (الغَابَةُ: الأَجَمَةُ ذاتُ الشَّجَرِ المُتَكَاثِف؛ لأَنَّها تُغَيِّبُ مَا فِيهَا. أو الأَجَمَةُ الَّتِي طالتْ، وَلَهَا أَطْراف مُرْتَفِعَةٌ باسِقَة؛ الغابةُ أَجَمة القَصَب، قَالَ: وَقَدْ جُعِلَتْ جماعةَ الشَّجَرِ، لأَنه مأْخوذ مِنَ الغَيابةِ)\nمثال: مشينا في الغابة",
 "tropical sore": "حبة حلب, ليشمانيا جلدية (ليشمانيا تصيب الجلد؛ تتميز بآفات جلدية تقرحية)",
 "tropical sprue": "إسهال مداري, ذرب (اضطراب مزمن يحدث بأشكال مدارية وغير مدارية وفي كل من الأطفال والبالغين؛ لا يتم امتصاص العناصر الغذائية؛ تشمل الأعراض إسهالاً كريه الرائحة وهزالاً)",
 "tropical year": "سنة شمسية, سنة فلكية (الوقت اللازم للأرض لعمل دورة واحدة حول الشمس، مقاسة بين اعتدالين ربيعيين)",
 "tropically": "استوائياً (بطريقة استوائية)\nمثال: كان الجو حاراً استوائياً في الدفيئة",
 "tropicbird": "طائر استوائي (طائر بحري استوائي أبيض في الغالب مكفف القدمين يوجد غالباً بعيداً عن اليابسة)",
 "tropidoclonion lineatum": "ثعبان مخطط (ثعبان كتوم يعيش في مكبات المدن والحدائق وكذلك البراري والغابات المفتوحة؛ يتغذى على ديدان الأرض؛ من وسط الولايات المتحدة)",
 "tropism": "انتحاء",
 "troponomy": "أسماء الأماكن (أسماء الأماكن في منطقة أو لغة تعتبر مجتمعة)",
 "troponym": "اسم الهيئة (كلمة تدل على طريقة فعل شيء ما)",
 "troponymy": "أسماء الأماكن (أسماء الأماكن في منطقة أو لغة تعتبر مجتمعة) / عَلَاقَة الكَيْفِيَّة (العلاقة الدلالية لكون الفعل طريقة للقيام بفعل آخر (مثل: همس طريقة للتحدث))",
 "tropopause": "تروبوبوز (منطقة الانقطاع بين التروبوسفير والستراتوسفير)",
 "troposphere": "تروبوسفير, غلاف متقلب (أدنى طبقة في الغلاف الجوي؛ من 4 إلى 11 ميلاً ارتفاعاً (حسب خط العرض))",
 "trot": "خبب (مشية أسرع من المشي؛ تضرب الأرجل المتقابلة قطرياً الأرض معاً) / هرولة (وتيرة جري بطيئة) / ترجمة حرفية مساعدة (ترجمة حرفية تُستخدم في دراسة لغة أجنبية (غالباً ما تُستخدم بشكل غير مشروع للغش)) / تروتسكي (راديكاليون يدعمون نظرية تروتسكي بأن الاشتراكية يجب أن تتأسس في جميع أنحاء العالم من خلال الثورة المستمرة)",
 "troth": "عَهْد, مِيثَاق (تعهد رسمي بالوفاء والإخلاص) / خطبة, خطوبة (وعد متبادل بالزواج)",
 "trotline": "خيط الشباك, خيط الصيد بالجر (خيط صيد طويل ترتبط به العديد من الخيوط القصيرة والخطافات (عادة ما يكون معلقاً بين عوامات))",
 "trotskyism": "تْرُوتْسْكِيَّة",
 "trotskyist": "تروتسكي (راديكاليون يدعمون نظرية تروتسكي بأن الاشتراكية يجب أن تتأسس في جميع أنحاء العالم من خلال الثورة المستمرة)",
 "trotskyite": "تروتسكي (راديكاليون يدعمون نظرية تروتسكي بأن الاشتراكية يجب أن تتأسس في جميع أنحاء العالم من خلال الثورة المستمرة)",
 "trotter": "حصان الهرولة (حصان مدرب على الهرولة؛ خاصة حصان مدرب لسباق العربات) / كراع (قدم خنزير أو خروف خاصة عند استخدامها كطعام)",
 "trotting horse": "حصان الهرولة (حصان مدرب على الهرولة؛ خاصة حصان مدرب لسباق العربات)",
 "trou-de-loup": "حفرة الذئب (حفرة مائلة بها وتد في الوسط تستخدم كعائق للعدو)",
 "troubadour": "تْرُوبَادُور",
 "trouble": "مُشْكِلَة, مَتاعِب",
 "trouble maker": "مثير للمشاكل, مشاغب (شخص يثير المشاكل أو الفتن عمداً)",
 "trouble shooter": "مشخص المشاكل, مصلح الأعطال (عامل وظيفته تحديد وإصلاح مصادر الأعطال (خاصة في الأجهزة الميكانيكية))",
 "trouble spot": "بؤرة توتر, نقطة ساخنة (مكان للاضطرابات السياسية والعنف المحتمل) / بؤرة توتر, نقطة اضطراب (مكان توجد فيه المشاكل أو تحدث بانتظام)\nمثال: لا تستطيع الولايات المتحدة مراقبة جميع النقاط الساخنة في العالم",
 "trouble-free": "خَالٍ مِنَ المَشَاكِل (بدون مشاكل أو صعوبات)",
 "troubled": "عَاصِف, مُضْطَرِب (يتّسم بالفوضى أو الاضطراب أو التمرّد) / قلق, مضطرب (يتميز بـ أو يدل على ضيق أو بلاء أو خطر أو حاجة)\nمثال: مناطق مضطربة",
 "troublemaker": "مُثِير لِلْمَشاكِل, مُثِير لِلْمَتَاعِب",
 "troubler": "مثير للمشاكل, مشاغب (شخص يثير المشاكل أو الفتن عمداً)",
 "troubleshooter": "مشخص المشاكل, مصلح الأعطال (عامل وظيفته تحديد وإصلاح مصادر الأعطال (خاصة في الأجهزة الميكانيكية))",
 "troublesome": "مُتْعِب, مُزْعِج (يُسَبِّب صُعُوبَةً أَوْ إِزْعَاجًا)",
 "troublesomeness": "إزعاج, إقلاق (صعوبة تسبب القلق)",
 "troubling": "مُزْعِج, مُقْلِق (يُسَبِّب القَلَق أو الانْزِعاج أو الكَرْب)",
 "troublous": "عَصِيب, مَلِيء بِالمَتَاعِب (حافل بالمشاكل والمتاعب)",
 "trough": "فِنْطَاس",
 "trouncing": "جلد, ضرب (فعل إيقاع العقاب البدني بضربات متكررة) / سحق, هزيمة نكراء (هزيمة قوية)",
 "troupe": "فرقة, فرقة مسرحية (منظمة من المؤدين والموظفين المرتبطين بهم (خاصة المسرحية))\nمثال: أقامت الفرقة المتجولة كلها في نفس الفندق",
 "trouper": "ممثل متجول (ممثل يسافر في أنحاء البلاد لتقديم المسرحيات) / شخص دؤوب, شخص يعتمد عليه (شخص جدير بالثقة ولا يشتكي ويعمل بجد)",
 "trouser": "رجل البنطال (جزء من رداء مصمم للسراويل أو متعلق بها)\nمثال: في جيب بنطاله",
 "trouser clip": "مشبك بنطال (مشبك يوضع حول كاحلي راكب الدراجة لمنع البنطال من التعلق في سلسلة الدراجة)",
 "trouser cuff": "ثنية السروال (كفة في أسفل ساق السروال)",
 "trouser leg": "رجل السروال (ساق زوج من السراويل)",
 "trouser press": "ضاغطة بناطيل, مكبس سراويل (جهاز منزلي تُعلق فيه السراويل لإزالة التجاعيد بالضغط)",
 "trousered": "مُرْتَدٍ سِرْوَالاً (يرتدي سروالاً)",
 "trousering": "قماش البناطيل (أي قماش يستخدم لصنع السراويل)",
 "trousers": "بنطال, سروال ((عادة بصيغة الجمع) رداء يمتد من الخصر إلى الركبة أو الكاحل، ويغطي كل ساق على حدة)\nمثال: كان لديه كسرة حادة في بنطاله",
 "trousseau": "جِهَاز العَرُوس",
 "trout": "تَرُوتَة, أُطْرُوط",
 "trout lily": "زنبق السلمون المرقط, لسان الحية الأصفر (نبات سن الكلب من شرق أمريكا الشمالية له زهور صفراء منفردة معلمة بالبني أو الأرجواني وداخل منقط)",
 "trove": "كنز دفين (كنز مجهول المالك وجد مخبأ (عادة في الأرض))",
 "trowel": "مِجْرَفَة, مَالَج / مَالَج",
 "troy": "طَرْوَادَة",
 "troy ounce": "أوقية ترويسية, أونصة ترويسية (وحدة وزن صيدلانية تساوي 480 قمحة أو واحد من اثني عشر من الرطل الترويسي)",
 "troy pound": "رطل الصيدلة, رطل ترويسي (وزن صيدلاني يساوي 12 أوقية أو 373.242 غرام)",
 "troy unit": "وحدة ترويسية (أي وحدة من وحدات نظام الوزن الترويسي)",
 "troy weight": "وزن تروي (نظام أوزان يستخدم للمعادن الثمينة والأحجار الكريمة؛ يعتمد على باوند 12 أونصة وأونصة 480 حبة)",
 "troyes": "تروا",
 "truancy": "تَمَلُّص, هُرُوب مِن المَدْرَسَة (الفشل في الحضور (خاصة المدرسة))",
 "truant": "مُتَغَيِّب",
 "truce": "هُدْنَة",
 "truck": "شَاحِنَة, كَمْيُون (اسم فاعل مؤنث من الفعل \"شَحَنَ\"؛ أي عربة أو سيارة تُستخدم للشحن أو النقل)\nمثال: انقلبت الشاحنة.",
 "truck bed": "صندوق الشاحنة, قعر الشاحنة (أرضية أو قاع عربة أو شاحنة أو مقطورة)",
 "truck dealer": "وكيل شاحنات (شركة تبيع وتشتري الشاحنات)",
 "truck driver": "سائق شاحنة (شخص يقود شاحنة كمهنة)",
 "truck farm": "مزرعة خضروات تسويقية (مزرعة تزرع فيها الخضروات للسوق)",
 "truck farming": "زراعة الخضروات للسوق (زراعة الخضروات للسوق)",
 "truck garden": "مزرعة خضروات تسويقية (مزرعة تزرع فيها الخضروات للسوق)",
 "truck stop": "استراحة شاحنات (محطة خدمة على الطريق (ومطعم) تلبي احتياجات سائقي الشاحنات)",
 "truck traffic": "حركة الشاحنات (الشاحنات القادمة والذاهبة)",
 "truckage": "نقل بالشاحنات (نشاط نقل البضائع بواسطة الشاحنات) / أجرة النقل بالشاحنات (رسم يُفرض لنقل البضائع بالشاحنات)",
 "trucker": "سائق شاحنة (شخص يقود شاحنة كمهنة)",
 "trucking": "نقل بالشاحنات (نشاط نقل البضائع بواسطة الشاحنات)",
 "trucking company": "شركة نقل بالشاحنات, شركة نقل بري (شركة تقوم بشحن البضائع أو الممتلكات عن طريق الشاحنات)",
 "trucking industry": "صناعة النقل بالشاحنات (صناعة توفر النقل للمنتجات التجارية)",
 "trucking rig": "تريلا, شاحنة مقطورة (شاحنة تتكون من جرار ومقطورة معاً)",
 "truckle": "سرير جرار, سرير سفلي متحرك (سرير منخفض يمكن دحرجته تحت سرير أعلى)",
 "truckle bed": "سرير جرار, سرير سفلي متحرك (سرير منخفض يمكن دحرجته تحت سرير أعلى)",
 "truckler": "خَنُوع, مُتَذَلِّل (شخص يذل نفسه كعلامة على الاحترام؛ يتصرف وكأنه بلا كرامة)",
 "truckling": "تَذَلُّل, خُنُوع (فعل الطاعة بخسة (خاصة الطاعة بطريقة متواضعة أو لأسباب غير جديرة))",
 "truculence": "شراسة, وحشية (عدوانية صاخبة ومتحدية)",
 "truculency": "شراسة, وحشية (عدوانية صاخبة ومتحدية)",
 "truculent": "شَرِس العُدْوَانِيَّة, مُتَحَدٍّ (عدواني بتحدٍّ وعناد)",
 "truculently": "بتحد, بشراسة (بطريقة متحدية وشرسة) / بشراسة, بعدوانية (بطريقة عدوانية وشرسة)\nمثال: نظر الصبي بتحد إلى معلمه",
 "trudge": "سير شاق (مشي طويل وصعب)",
 "trudger": "سائر بتثاقل (شخص يمشي بطريقة مجهدة وثقيلة الخطى)",
 "true": "حَقٌّ (اسم من الأسماء الحسنى وهو من صفات الله. لا جمع له؛ ضد البَاطِل، العَدْل والحَقِيْقَة والوُجُوْد الثَابِت والصِدْق والذي لا جدال فيه. لا جمع له)\nمثال: الأستاذ على حق.",
 "true anomaly": "شذوذ حقيقي (المسافة الزاوية لنقطة في مدار ما بعد نقطة الحضيض مقاسة بالدرجات)",
 "true bacteria": "بكتيريا حقيقية (مجموعة كبيرة من البكتيريا ذات جدران خلوية صلبة؛ الأنواع المتحركة منها تمتلك أسواطاً)",
 "true bill": "لائحة اتهام مصدقة (لائحة اتهام مصادق عليها من قبل هيئة محلفين كبرى)",
 "true blackberry": "توت العليق, عليق حقيقي (العليق الحقيقي لأوروبا وكذلك أي من العديد من الأصناف التي لها توت أسود أو أرجواني داكن حلو صالح للأكل)",
 "true bug": "بق حقيقي (أي من الحشرات المتنوعة من رتبة نصفيات الأجنحة وخاصة من رتيبة متباينات الأجنحة)",
 "true cat": "قط, هر (ثديي سنوري عادة ما يكون له فراء ناعم كثيف ولا يمتلك القدرة على الزئير: القطط المنزلية؛ القطط البرية)",
 "true cedar": "أرز, شجرة الأرز ((أَرَزَّت) الجرادةُ: رَزَّت)\nمثال: هكذا نطهي الأرز",
 "true dwarf": "قزم أولي (قزم ودروي ناتج صغر حجمه عن عيب وراثي؛ أجزاء الجسم والنمو العقلي والجنسي طبيعية)",
 "true fir": "شجرة الشوح, شوح (نبات قائم على سَاق صلبة؛ مخطط له تفرعات)\nمثال: أنا تحت الشجرة.",
 "true flycatcher": "صائد الذباب (العالم القديم) (أي من مجموعة كبيرة من الطيور المغردة الصغيرة التي تتغذى على الحشرات التي يتم اصطيادها أثناء الطيران)",
 "true frog": "ضفدع حقيقي (برمائي آكل للحشرات عادة ما يكون شبه مائي وتري القدمين بجلد رطب أملس وأرجل خلفية طويلة)",
 "true fungus": "فطر حقيقي (أي من الفطريات العديدة من قسم الفطريات الحقيقية)",
 "true glottis": "مزمار, مزمار حقيقي (الحيز بين الطيتين الصوتيتين الحقيقيتين)",
 "true guava": "جوافة, شجرة الجوافة (شجرة شجيرية استوائية أمريكية صغيرة؛ تزرع على نطاق واسع في المناطق الدافئة لفاكهتها الصفراء الكروية الحلوة)",
 "true heath": "خلنج (أي نبات من جنس إريكا)",
 "true jasmine": "ياسمين حقيقي, ياسمين شائع (شجيرة متساقطة الأوراق متسلقة بزهور عطرة بيضاء أو صفراء أو حمراء تستخدم في العطور ولتنكيه الشاي)",
 "true laurel": "شجرة الغار, غار (شجرة متوسطية صغيرة دائمة الخضرة ذات ثمار سوداء صغيرة وأوراق عطرية لامعة تستخدم للنكهة في الطهي؛ استخدمها الإغريق القدماء أيضاً لتتويج المنتصرين)",
 "true lobster": "كركند حقيقي (قشريات بحرية كبيرة صالحة للأكل لها مخالب كبيرة على الزوج الأول من الأرجل)",
 "true lover's knot": "عقدة الصيادين (عقدة لربط نهايات حبلين معاً) / عقدة الحب (عقدة منمقة أو زخرفية تستخدم كشعار للحب)",
 "true lovers' knot": "عقدة الحب (عقدة منمقة أو زخرفية تستخدم كشعار للحب)",
 "true mahogany": "ماهوجني حقيقي, ماهوجني كوبي (شجرة الماهوجني في جزر الهند الغربية)",
 "true pepper": "فلفل حقيقي, كرمة الفلفل (حَبّ حريف يوضع في الطعام أو يطحن يستخدم كتابل. يكون منه أسود أو أبيض، حرارته متوسطة؛ فُلْفُل حَارّ: نبات ثمره حريف لونه أخضر وقد يحمرّ شديد الحرارة. يؤكل كما هو أو يجفف ويطحن ويستخدم كتابل)\nمثال: نحب الفلفل الحار.",
 "true pine": "شجرة الصنوبر, صنوبر (شجرة صنوبرية)",
 "true puffball": "فطر نفاث, فطر نفاث حقيقي (أي من الفطريات المختلفة من فصيلة ليكوبيرداسيا التي يطلق جسمها الثمري المستدير سحابة من الأبواغ عند النضج)",
 "true rib": "ضلع حقيقي (أحد الأضلاع السبعة الأولى في الإنسان التي تتصل بعظم القص)",
 "true sago palm": "نخيل الساغو الحقيقي (نخيل ماليزي ينتج جذعه اللبي الساغو - وهو نشا يستخدم كمكثف للطعام ومقوي للأقمشة؛ من الملايو إلى فيجي)",
 "true sandalwood": "شجرة الصندل, صندل أبيض (شجرة طفيلية من إندونيسيا وماليزيا ذات خشب قلب مصفر عطري ناعم الحبيبات بخصائص طاردة للحشرات ويستخدم، على سبيل المثال، لصنع الصناديق)",
 "true seal": "فقمة حقيقية, فقمة عديمة الأذن (أي من عدة فقمات تفتقر إلى سديلات الأذن الخارجية ولها معطف صلب يشبه الشعر مع أطراف خلفية مختزلة إلى زعانف للسباحة)",
 "true senna": "سنا إسكندراني, سنا مكي (شجيرة قائمة لها عناقيد من الزهور الصفراء السمراء؛ تستخدم الأوراق المجففة طبياً كمسهل؛ تصنف أحياناً في جنس كاسيا)",
 "true slime mold": "عفن غروي حقيقي, ميكسوميسيت (عفن غروي من طائفة الميكسوميسيت)",
 "true sparrow": "عصفور دوري (أي من عدة طيور مغردة صغيرة باهتة اللون تتغذى على البذور أو الحشرات)",
 "true statement": "حقيقة, صدق (بيان أو قول صادق)\nمثال: لقد قال الحقيقة",
 "true toad": "علجوم حقيقي (برمائي عديم الذيل يشبه الضفدع ولكنه أكثر برية وله جلد ثؤلولي أكثر جفافاً)",
 "true tulipwood": "خشب الحور الأصفر, خشب الزنبق (خشب خفيف سهل العمل لشجرة الزنبق؛ يستخدم للأثاث والقشرة)",
 "true vampire bat": "خفاش مصاص الدماء (أي من خفافيش أمريكية استوائية متنوعة تعض الثدييات والطيور لتتغذى على دمائها)",
 "true vocal cord": "حبل صوتي حقيقي (أي من الطيتين الصوتيتين السفليتين اللتين تلتقيان لتكوين المزمار؛ تنتجان نغمة صوتية عند تقاربهما ومرور الهواء من الرئتين بينهما)",
 "true vocal fold": "حبل صوتي حقيقي (أي من الطيتين الصوتيتين السفليتين اللتين تلتقيان لتكوين المزمار؛ تنتجان نغمة صوتية عند تقاربهما ومرور الهواء من الرئتين بينهما)",
 "true warbler": "هازجة العالم القديم (طيور صغيرة نشطة بنية أو رمادية من العالم القديم)",
 "true-blue": "رَاسِخ الوَلَاء, شَدِيد الإِخْلَاص (يَتَمَيَّز بِوَلَاء لَا يَتَزَعْزَع)",
 "true-false": "صح أو خطأ (يقدم سلسلة من العبارات التي يجب الحكم على كل منها بأنها صحيحة أو خاطئة)\nمثال: اختبار صح أو خطأ",
 "truehearted": "رَاسِخ, مُخْلِص (ثَابِت لَا يَتَزَعْزَع فِي الإِخْلَاص لِصَدِيق أَوْ عَهْد أَوْ قَضِيَّة)",
 "truelove": "حبيب, معشوق (شخص محبوب من قبل شخص آخر)",
 "truelove knot": "عقدة الصيادين (عقدة لربط نهايات حبلين معاً)",
 "trueness": "دِقَّة, صِحَّة (دقة التعديل أو الضبط) / صِدْق, وَلَاء (صفة كون الشخص موالياً) / حقيقة, صحة (المطابقة للواقع أو الفعليّة)\nمثال: تعجبت من دقة تصويبه",
 "truffle": "كَمْأَة",
 "truism": "بديهية, حقيقة واضحة (حقيقة واضحة بذاتها)",
 "truly": "بصدق, حقاً (وفقاً للحقيقة أو الواقع) / بصدق, حقاً (في الواقع (تستخدم للتوكيد أو تعديل الجملة)) / بِجَدَارَة, بِحَقّ (بموجب الحق أو الشرعية) / بإخلاص, بصدق (بصدق؛ دون تصنع)\nمثال: أصبحت الآن أمريكية حقاً",
 "truman doctrine": "مبدأ ترومان (سياسة الرئيس ترومان لتقديم المساعدات الاقتصادية والعسكرية لأي دولة مهددة بالشيوعية أو الأيديولوجية الشمولية)",
 "trump": "وَرَقَة رَابِحَة",
 "trump card": "ورقة حكم, ورقة رابحة (ورقة لعب من النقش الذي تم إعلانه كحكم)\nمثال: آس الحكم هو فائز مؤكد",
 "trumpery": "حلي تافهة, خردوات (أشياء زخرفية ليس لها قيمة كبيرة) / تُرَّهَات, كَلَام تَافِه (حديث أو كتابة لا معنى لها)",
 "trumpet": "بُوق (فَسَد؛ باق الرجل: كَذَب)\nمثال: كان سامي ينبه بالبوق.",
 "trumpet arch": "قوس بوقي (حنية ركنية مخروطية)",
 "trumpet flower": "عسلة البوق, عسلة مرجانية (كرمة عسلة أمريكية شمالية دائمة الخضرة لها زهور حمراء مرجانية أو برتقالية) / زهرة البوق, كرمة الصليب (كرمة خشبية مزهرة في جنوب الولايات المتحدة؛ تظهر السيقان صليباً في المقطع العرضي) / زهرة البوق, سولاندرا (نبات متسلق دائم الخضرة مكسيكي له زهور صفراء عطرة كبيرة قمعية الشكل مفردة مع حواف بنية أرجوانية في الحلق)",
 "trumpet honeysuckle": "عسلة البوق, عسلة مرجانية (كرمة عسلة أمريكية شمالية دائمة الخضرة لها زهور حمراء مرجانية أو برتقالية)",
 "trumpet section": "قسم الأبواق (قسم الفرقة أو الأوركسترا الذي يعزف على الأبواق أو الكورنيت)",
 "trumpet tree": "سيكروبيا, شجرة البوق (شجرة أمريكية استوائية بأوراق درعية كبيرة وسيقان مجوفة)",
 "trumpet vine": "عسلة البوق, عسلة مرجانية (كرمة عسلة أمريكية شمالية دائمة الخضرة لها زهور حمراء مرجانية أو برتقالية)",
 "trumpet weed": "جو باي الأرجواني, غافث أرجواني (عشب من أمريكا الشمالية له أوراق محيطية وعناقيد طرفية من الزهور المرقطة بالأرجواني)",
 "trumpet-like": "بُوقِيّ (يشبه صوت البوق)",
 "trumpet-shaped": "بُوقِيّ الشَّكْل (على شكل بُوق)",
 "trumpet-wood": "سيكروبيا, شجرة البوق (شجرة أمريكية استوائية بأوراق درعية كبيرة وسيقان مجوفة)",
 "trumpeter": "تم بواق (بجعة برية بيضاء نقية كبيرة من غرب أمريكا الشمالية لها صرخة رنانة) / بوقي (طائر اجتماعي كبير يشبه الكركي من غابات أمريكا الجنوبية له ريش أسود لامع وصرخة طويلة عالية؛ يسهل تدجينه) / بشير, منادي ((رسمياً) شخص يعلن عن أخبار مهمة) / عازف بوق, عازف كورنيت (موسيقي يعزف على البوق أو الكورنيت)\nمثال: كان لدى الزعيم منادٍ يعلن عن وصوله بالبوق",
 "trumpeter swan": "تم بواق (بجعة برية بيضاء نقية كبيرة من غرب أمريكا الشمالية لها صرخة رنانة)",
 "trumpetfish": "سمكة البوق (سمكة أطلسية استوائية ذات خطم طويل؛ تسبح ورأسها للأسفل)",
 "trumpets": "بوق الصياد, سراسينية صفراء (نبات إبريق في جنوب شرق الولايات المتحدة ذو أباريق صفراء منتصبة على شكل بوق ذات أفواه واسعة وأغطية منتصبة)",
 "trumpetwood": "سيكروبيا, شجرة البوق (شجرة أمريكية استوائية بأوراق درعية كبيرة وسيقان مجوفة)",
 "trumpian": "تِرَمْبِيٌّ",
 "trumping": "استخدام الورقة الرابحة, قطع بالرابحة ((ألعاب الورق) فعل أخذ جولة بورقة رابحة عند عدم القدرة على اتباع اللون المطلوب)",
 "trumpism": "تِرَمْبِيَّةٌ",
 "trumpistan": "تْرَامْبِسْتَان",
 "truncate": "بَتَرَ (بَتَرَهُ بَتْرًا: قطع مستأصِلاً. و- العمل ونحوَه: قطعه قبل أن يُتمُّه، فهو باتِر؛ بَتير بَتَرٌا: انقطع، فهو أبْتَرُ، وهي بَتْراء. (ج) بُتْرٌّ) / شَذَّبَ / قَطَعَ (قطع الشيء : جزه؛ قطع الشيء : فصل بعضه عن بعضه الآخر) / قَلَّمَ (قَطَعَ جزءا من شيء لتزيينه وتحسينه)\nمثال: كان يجب بتر ذراع توم.",
 "truncated": "مَبْتُور, مَقْطُوع (يَنْتَهي فَجْأَة كَأَنَّ طَرَفَه قُطِع) / مُخْتَصَر, مُقْتَضَب (تَمَّ اخْتِصارُه في المُدَّة)",
 "truncated cone": "مخروط ناقص (جذع مُشكل من مخروط)",
 "truncated pyramid": "هرم ناقص (جذع مُشكل من هرم)",
 "truncation": "اجتزاء, بتر (عملية القطع القصير) / شطب, قطع (استبدال حافة أو زاوية صلبة (كما في قطع الأحجار الكريمة) بمستوى) / بتر, قِصَر (خاصية كون الشيء مبتوراً أو قصيراً)\nمثال: إنه اجتزاء واضح للبيت الشعري",
 "truncation error": "خطأ البتر ((رياضيات) خطأ في الحساب ينتج عن قطع عملية حسابية رقمية قبل انتهائها)",
 "truncheon": "هراوة الشرطي (هراوة قصيرة قوية يستخدمها رجال الشرطة بشكل أساسي)",
 "truncocolumella citrina": "ترانكوكولوميلا ليمونية (فطر ذو جسم ثمري أصفر إلى برتقالي مستدير يوجد على سطح الأرض أو مدفون جزئياً؛ له عمود عقيم مميز يمتد داخل النسيج الحامل للأبواغ)",
 "truncus atrioventricularis": "حزمة أذينية بطينية, حزمة هيس (حزمة من عضلة القلب المعدلة تنقل النبض القلبي من العقدة الأذينية البطينية إلى البطينين مسببة انقباضهما)",
 "truncus celiacus": "جذع زلاقي, شريان زلاقي (شريان ينشأ من الأبهر البطني أسفل الحجاب الحاجز مباشرة ويتفرع إلى الشريان المعدي الأيسر والشريان الكبدي المشترك والشريان الطحالي)",
 "truncus pulmonalis": "جذع رئوي (الشريان الذي يحمل الدم الوريدي من البطين الأيمن للقلب وينقسم إلى الشرايين الرئوية اليمنى واليسرى)",
 "trundle": "عجلة صغيرة (عجلة صغيرة أو أسطوانة دوارة) / سرير جرار, سرير سفلي متحرك (سرير منخفض يمكن دحرجته تحت سرير أعلى)",
 "trundle bed": "سرير جرار, سرير سفلي متحرك (سرير منخفض يمكن دحرجته تحت سرير أعلى)",
 "trunk": "جِذْع (في علم النبات: أحد أجزاء النبات الذي يحمل الأغصان ويتصل في أسفله بالجذر) / خُرْطُوم / صَنْدُوق, صُنْدُوق (وعاء كبيرة من الخشب غالبا وقد يكون حديدًا يستخدم لوضع الاشياء داخله، ويكون لها عادة جهة قابلة للفتح سواء بمفاصل او بالازالة الكاملة؛ صُنْدُوْقُ السَيَّارَة قمرة تشبه الصندوق في الجزء الخلفي من السيارة يستخدم كالصندوق) / حَقِيبَة أَمْتِعَة, صُنْدُوقُ السَّيَّارَةِ\nمثال: أين صندوق البريد؟",
 "trunk call": "مكالمة بعيدة المدى, مكالمة دولية (مكالمة هاتفية تتم خارج منطقة الاتصال المحلية)\nمثال: تحدثت معها عبر مكالمة بعيدة المدى",
 "trunk hose": "سروال منتفخ (سراويل منتفخة من القرنين السادس عشر والسابع عشر تلبس عادة فوق الجوارب)",
 "trunk lid": "غطاء الصندوق الخلفي (غطاء مفصلي لصندوق السيارة)",
 "trunk line": "خط رئيسي, خط ربط (خط هاتف يربط بين مقسمين (سنترالين) مباشرة) / خط رئيسي (الخط الذي يمثل المسار الرئيسي في السكك الحديدية)",
 "trunk road": "طريق رئيسي (طريق سريع)",
 "trunk route": "خط رئيسي (الخط الذي يمثل المسار الرئيسي في السكك الحديدية)",
 "trunkfish": "سمكة الصندوق (أي من الأسماك الاستوائية الصغيرة العديدة التي يكون جسمها ورأسها مغلفين بصفائح عظمية)",
 "trunks": "سروال قصير, شورت ((تستخدم بصيغة الجمع) سراويل تنتهي عند الركبة أو فوقها)",
 "trunnel": "مسمار خشبي (وتد خشبي يستخدم لتثبيت الأخشاب في بناء السفن؛ الماء يجعل الوتد ينتفخ ويثبت الأخشاب بإحكام)",
 "truss": "طنف, كابول ((في العمارة) دعامة مثلثة من الطوب أو الحجر (عادة ما تكون ذات امتداد بسيط)) / جملون, دعامة (هيكل من العوارض (العوارض الخشبية والأعمدة والدعامات) تشكل هيكلاً صلباً يدعم سقفاً أو جسراً أو هيكلاً آخر) / حزام الفتق ((طبياً) ضمادة تتكون من وسادة وحزام؛ ترتدى لتثبيت الفتق في مكانه عن طريق الضغط)",
 "truss bridge": "جسر جمالوني (جسر مدعوم بجمالونات)",
 "trussed": "مَرْبُوط بِإِحْكَام, مَشْدُود (مربوط أو مثبت بإحكام)",
 "trust": "ثِقَة / تْرَسْت, اِئْتِمَان / وَثِقَ (أمن له ولم يظن انه يخون)\nمثال: وثق سامي بليلى ثقة عمياء.",
 "trust account": "ائتمان توتن, ائتمان حساب التوفير (حساب توفير يودعه شخص يجعل نفسه أميناً لمستفيد ويتحكم فيه خلال حياته؛ وبعد ذلك يُدفع الرصيد للمستفيد المسمى مسبقاً)",
 "trust busting": "مكافحة الاحتكار ((قانون) أنشطة حكومية تسعى لحل التكتلات الاحتكارية للشركات (خاصة بموجب قوانين مكافحة الاحتكار الأمريكية))",
 "trust company": "شركة أمينة, شركة ائتمان (منظمة (عادة مع بنك تجاري) تعمل كوصي أو وكيل ائتماني في التعامل مع صناديق الائتمان أو التركات أو ترتيبات الحفظ أو تحويلات الأسهم أو الخدمات ذات الصلة)",
 "trust corporation": "شركة أمينة, شركة ائتمان (منظمة (عادة مع بنك تجاري) تعمل كوصي أو وكيل ائتماني في التعامل مع صناديق الائتمان أو التركات أو ترتيبات الحفظ أو تحويلات الأسهم أو الخدمات ذات الصلة)",
 "trust deed": "سند الوصاية, صك الائتمان (صك مكتوب ينقل الملكية قانوناً إلى وصي يستخدم غالباً لتأمين التزام مثل الرهن العقاري أو السند الإذني)",
 "trust fund": "صندوق ائتمان (صندوق يُحفظ في أمانة)",
 "trust territory": "إقليم خاضع للوصاية (بلد تابع؛ يُدار بواسطة بلد آخر تحت إشراف الأمم المتحدة)",
 "trust, but verify": "ثِقْ وَلٰكِن تُحَقِّقْ, ثِقِي وَلٰكِن تُحَقِّقِي",
 "trustbuster": "مكافح الاحتكار (عميل فيدرالي يشارك في مكافحة الاحتكار)",
 "trusted": "مَوْثُوق بِه, مُؤْتَمَن ((يوصف به الأشخاص) جدير بالثقة والاعتماد)",
 "trustee": "عُضْو مَجْلِس أُمَناء, وَصِيّ (أعضاء في مجلس حاكم أو مجلس أمناء) / أمين, وصي قانوني (شخص (أو مؤسسة) يُعهد إليه بالملكية القانونية للممتلكات لاستخدامها لصالح شخص آخر)",
 "trustee account": "ائتمان توتن, ائتمان حساب التوفير (حساب توفير يودعه شخص يجعل نفسه أميناً لمستفيد ويتحكم فيه خلال حياته؛ وبعد ذلك يُدفع الرصيد للمستفيد المسمى مسبقاً)",
 "trustee-beneficiary relation": "عَلَاقَة الأَمِين بِالمُسْتَفِيد (مسؤولية الأمين في التصرف بما يخدم مصلحة المستفيد)",
 "trusteeship": "أمانة, وصاية (منصب الوصي أو عضو مجلس الأمناء) / إقليم خاضع للوصاية (بلد تابع؛ يُدار بواسطة بلد آخر تحت إشراف الأمم المتحدة)",
 "trusteeship council": "مجلس الوصاية (مجلس دائم للأمم المتحدة يكلف دولة (أو دول) بتولي إدارة إقليم ما)",
 "truster": "مؤمن, مصدق (مؤيد يقبل شيئًا على أنه حقيقة)",
 "trustful": "مصدق, واثق (يميل إلى التصديق أو الائتمان بسهولة؛ مليء بالثقة)\nمثال: عين بنية كبيرة، صادقة وواثقة",
 "trustfully": "بثقة (بطريقة واثقة) / بِاطْمِئْنَان, بِثِقَة (مع الثقة؛ بطريقة واثقة)\nمثال: ابتسم بثقة",
 "trustfulness": "ثقة (سمة الإيمان بصدق وموثوقية الآخرين)\nمثال: دمرت التجربة ثقته وكرامته الشخصية",
 "trustiness": "أمانة, جدارة بالثقة (سمة استحقاق الثقة والاعتماد)",
 "trusting": "مصدق, واثق (يميل إلى التصديق أو الائتمان بسهولة؛ مليء بالثقة)\nمثال: عين بنية كبيرة، صادقة وواثقة",
 "trustingly": "بِاطْمِئْنَان, بِثِقَة (مع الثقة؛ بطريقة واثقة)\nمثال: نظرت إلى والدها بثقة",
 "trustingness": "ثقة (سمة الإيمان بصدق وموثوقية الآخرين)\nمثال: دمرت التجربة ثقته وكرامته الشخصية",
 "trustor": "الواقف, منشئ الوقف ((في القانون) الشخص الذي ينشئ وقفاً عن طريق منح ممتلكات عقارية أو شخصية في عهدة وصي لصالح مستفيد)",
 "trustworthiness": "أمانة, جدارة بالثقة (سمة استحقاق الثقة والاعتماد)",
 "trustworthy": "ثِقَةٌ",
 "trusty": "أمين, جدير بالثقة (يستحق الثقة أو التصديق) / سَجِين مَوْثُوق (سجين يُعتبر جديراً بالثقة ويُمنح امتيازات خاصة)\nمثال: تقرير موثوق",
 "truth": "حَقِيقَة (الحَقّ، نقيض البَاطِل؛ نقيض المَجَاز)\nمثال: هي صديقة حقيقة.",
 "truth drug": "مصل الحقيقة (عقار مخدر وريدي له تأثير منوم؛ يحفز الاسترخاء ويضعف الموانع؛ يُعتقد أنه يدفع الناس للتحدث بحرية)",
 "truth quark": "كُوَارْك قِمِّيّ (كوارك افتراضي بشحنة +2/3 وكتلة تزيد عن 100,000 ضعف كتلة الإلكترون)",
 "truth serum": "مصل الحقيقة (عقار مخدر وريدي له تأثير منوم؛ يحفز الاسترخاء ويضعف الموانع؛ يُعتقد أنه يدفع الناس للتحدث بحرية)",
 "truthful": "صَادِق (الشخص: أصبح صديقا له؛ الوثيقة: قد تستخدم بمعنى صَدَّقَ)\nمثال: إنه صادق دائما.",
 "truthfully": "بِصِدْقٍ",
 "truthfulness": "صِدْق (نقيض الْكِذْب والكَذِب؛ قول ما يعتقدهُ القائل مطابقا للوَاقِع)\nمثال: صدق سامي كل شيء.",
 "try": "حَاوَلَ, سَعَى (طَلَبَ، رَامَ) / حَاكَمَ (حَاكَمَ القاضي فلانا: أقام عليه محكمة ليرى ما إذا كان مجرما أم لا؛ حَاكَمَ فلانٌ فلانا: رفع عليه قضية؛ اشتكى عليه عند القضاء فأقاموا محكمة للحكم في الأمر) / مُحَاوَلَة (بذل الجهد أو السعي لتحقيق هدف أو الوصول إلى نتيجة معينة؛ التجربة أو القيام بشيء ما للحصول على نتيجة مرغوبة)\nمثال: حاول توم قتلنا!",
 "try out": "جَرَّبَ (أَصابَهُ الجَرَب؛ السَّيْفُ: صَدِئَ)\nمثال: جرب هذا الكسكس.",
 "try square": "زاوية قائمة (زاوية لها مسطرة معدنية موضوعة بزاوية قائمة على قطعة مستقيمة أخرى)",
 "try-on": "تجربة الملابس, قياس (ارتداء الملابس لمعرفة ما إذا كانت مناسبة)",
 "trying": "مُجْهِد, مُرْهِق لِلأَعْصَاب (مُثير للأعصاب بشكل شديد ومُضنٍ) / شَاقّ لِلتَّحَمُّل, مُرْهِق (صَعْب التَّحَمُّل)",
 "trying on": "تجربة الملابس, قياس (ارتداء الملابس لمعرفة ما إذا كانت مناسبة)",
 "tryout": "تجربة أداء (اختبار لمدى ملاءمة فنان أو مؤدٍ) / اختبار, تجربة (تجربة شيء ما لمعرفة المزيد عنه)\nمثال: عينة للتجربة المجانية لمدة عشرة أيام",
 "trypanosome": "مِثْقَبِيَة",
 "trypsin": "تريبسين (إنزيم من أصل بنكرياسي؛ يحفز التحلل المائي للبروتينات إلى وحدات ببتيد أصغر)",
 "trypsinogen": "تريبسينوجين (سلف غير نشط للتريبسين؛ مادة يفرزها البنكرياس وتتحول إلى تريبسين نشط بواسطة الإنتيروكيناز في الأمعاء الدقيقة)",
 "tryptophan": "تريبتوفان (حمض أميني يوجد في البروتينات؛ ضروري للنمو والتمثيل الغذائي الطبيعي؛ وهو مقدمة للنياسين)",
 "tryptophane": "تريبتوفان (حمض أميني يوجد في البروتينات؛ ضروري للنمو والتمثيل الغذائي الطبيعي؛ وهو مقدمة للنياسين)",
 "tryst": "مَوْعِد, لِقَاء اَلْحُبّ (مَوْعِد الإفطار،أي وقت الإفطار؛ لديه مَوْعِد مع صديق)\nمثال: مناد عنده موعد.",
 "tsa": "إدارة أمن النقل (وكالة تأسست عام 2001 لحماية أنظمة النقل الأمريكية وضمان السفر الجوي الآمن)",
 "tsade": "صَاد, ص",
 "tsar": "تْسَار, قَيْصَر",
 "tsardom": "قَيْصَرِيَّة",
 "tsarina": "قَيْصَرَة",
 "tsarist": "قَيْصَرِيّ",
 "tsaristic": "قيصري (مكون من أو متعلق بـ أو مميز للقيصر)",
 "tsaritsa": "قيصرة (زوجة أو أرملة القيصر)",
 "tsatske": "حلية رخيصة (حلية رخيصة ومبهرجة) / امرأة جذابة ((اليديشية) امرأة جذابة وغير تقليدية)",
 "tsetse": "ذبابة تسي تسي (ذبابة أفريقية ماصة للدماء؛ تنقل مرض النوم وغيره)",
 "tsetse fly": "ذبابة تسي تسي (ذبابة أفريقية ماصة للدماء؛ تنقل مرض النوم وغيره)",
 "tsh": "الهرمون المنبه للدرقية, ثيروتروبين (هرمون الغدة النخامية الأمامية الذي يحفز وظيفة الغدة الدرقية)",
 "tshatshke": "حلية رخيصة (حلية رخيصة ومبهرجة) / امرأة جذابة ((اليديشية) امرأة جذابة وغير تقليدية)",
 "tshiluba": "لوبا (لغة بانتو يتم التحدث بها في جنوب شرق الكونغو)",
 "tshiluba language": "لوبا (لغة بانتو يتم التحدث بها في جنوب شرق الكونغو)",
 "tsimshian": "لغة تسيمشيان (لغة بينوتية يتحدث بها شعب تسيمشيان) / تسيمشيان (فرد من شعب بينوتيان عاش على الأنهار والمضائق في كولومبيا البريطانية)",
 "tsimshian language": "لغة تسيمشيان (لغة بينوتية يتحدث بها شعب تسيمشيان)",
 "tsine": "بانتنغ (ثور بري من أرخبيل الملايو)",
 "tskhinvali": "تْسْخِينْفَالِي",
 "tsoris": "متاعب, هموم ((اليديشية) المتاعب والمعاناة)",
 "tsouic": "لغة تسويك (مجموعة من لغات فورموزا تضم تسو وكاناكانابو وساروا)",
 "tsouic language": "لغة تسويك (مجموعة من لغات فورموزا تضم تسو وكاناكانابو وساروا)",
 "tss": "صدمة سمية, متلازمة الصدمة التسممية (متلازمة ناتجة عن عدوى حادة خطيرة (أحياناً مميتة) مرتبطة بوجود المكورات العنقودية؛ تتميز بالحمى والإسهال والغثيان وحمامى منتشرة وصدمة؛ تحدث بشكل خاص…)",
 "tsu": "تْسُو",
 "tsuga canadensis": "تسوغا شرقية, تسوغا كندية (شجرة غابات شائعة في شرق الولايات المتحدة وكندا؛ تستخدم خاصة لخشب اللب)",
 "tsuga caroliniana": "تسوغا كارولينا (شجرة دائمة الخضرة متوسطة الحجم من جنوب شرق الولايات المتحدة لها فروع منتشرة وحراشف مخروطية متباعدة على نطاق واسع)",
 "tsuga heterophylla": "تسوغا غربية (شجرة دائمة الخضرة طويلة من غرب أمريكا الشمالية؛ شجرة خشب مهمة تجارياً)",
 "tsuga mertensiana": "تسوغا جبلية (شجرة دائمة الخضرة كبيرة من غرب الولايات المتحدة؛ خشبها أصلب بكثير من التسوغا الكندية)",
 "tsukuyomi": "تْسُوكُويُومِي",
 "tsunami": "تْسُونَامِي",
 "tsundere": "تْسُونْدِرِي",
 "tsuris": "متاعب, هموم ((يديشية) مشكلة مثيرة للغضب أو الإزعاج)\nمثال: المتاعب المحبطة التي عرض نفسه لها",
 "tsutsugamushi disease": "تيفوس الأجمة, مرض تسوتسوغاموشي (ينقله يرقات العث وينتشر في آسيا)",
 "tswana": "تسوانا (لهجة السوتو التي يتحدث بها التسوانا في بوتسوانا) / بِيتْشُوانا, تْسُوانا (عضو في شعب بانتو يعيش بشكل رئيسي في بوتسوانا وغرب جنوب أفريقيا)",
 "tt": "التوقيت الأرضي, توقيت التقويم الفلكي ((علم الفلك) مقياس للوقت محدد بحركة الأرض المدارية؛ التوقيت الأرضي هو التوقيت الشمسي المتوسط مصححاً لعدم انتظام حركات الأرض)",
 "tuareg": "طَارِق, طَوَارِق",
 "tuatara": "تواتارا (العضو الوحيد الباقي من رتبة منقاريات الرأس من الزواحف الكبيرة الشائكة الشبيهة بالسحالي ثنائية الثقوب في الجزر الساحلية قبالة نيوزيلندا)",
 "tuatha de": "تواتا دي دانان (مجموعة من الآلهة أو أنصاف الآلهة الكلتية؛ حكموا أيرلندا في العصر الذهبي)",
 "tuatha de danann": "تواتا دي دانان (مجموعة من الآلهة أو أنصاف الآلهة الكلتية؛ حكموا أيرلندا في العصر الذهبي)",
 "tub": "بانيو, حوض استحمام (حاوية مفتوحة كبيرة نسبياً تملأ بالماء وتستخدم لغسل الجسم) / حوض كبير, دن (وعاء مفتوح كبير لحفظ أو تخزين السوائل) / ملء حوض (الكمية التي يستوعبها حوض)\nمثال: حوض من الماء",
 "tub gurnard": "الخرنار, الغرنار الأصفر (نوع من أسماك الغرنار)",
 "tub stopper": "سدادة حوض (سدادة مخصصة لأحواض الغسيل وأحواض الاستحمام وحاويات المياه المماثلة)",
 "tub-cart": "عربة بوني, عربة حمير (عربة بمحور سفلي ومقعدين)",
 "tub-thumper": "خطيب غوغائي (متحدث عام صاخب ونشيط أو مهتاج)",
 "tuba": "توبا, سوسافون (أخفض آلة نفخ نحاسية)",
 "tuba root": "جذر التوبا, جذر ديريس (كرمة خشبية لها أوراق خضراء زاهية وعناقيد من الزهور البيضاء المشوبة بالوردي؛ تحتوي الجذور المتورمة على الروتينون)",
 "tubal": "أنبوبي, بوقي (متعلق بـ أو يحدث في أنبوب مثل قناة فالوب أو قناة استاكيوس)\nمثال: ربط البوق (قناة فالوب)",
 "tubal ligation": "ربط قناة فالوب (إجراء تعقيم للنساء؛ يتم ربط قناتي فالوب في مكانين وإزالة الأنابيب بين الأربطة)",
 "tubal pregnancy": "حمل بوقي (حمل خارج الرحم في قناة فالوب)",
 "tubbiness": "اكتناز, بدانة طفولية (خاصية امتلاك جسم ممتلئ ومستدير)",
 "tubby": "قَصِير وَبَدِين, مُكَتَّل (قَصِير القَامَة وَمُمْتَلِئ الجِسْم)",
 "tube": "أُنْبُوبَة",
 "tube foot": "قدم أنبوبية (ناتئ أنبوبي ذو مجسات لمعظم شوكيات الجلد (نجم البحر وقنفذ البحر وخيار البحر) له ممص في النهاية ويستخدم مثلاً للحركة والتنفس)",
 "tube well": "بئر أنبوبي (بئر يتم صنعه عن طريق دفع أنبوب في الأرض إلى طبقة تحمل الماء)",
 "tube wrench": "مفتاح أنابيب (مفتاح ربط قابل للتعديل للإمساك بالأنابيب وتدويرها؛ له فكان مسننان يتم ضبطهما للإمساك بالأنبوب)",
 "tube-nosed": "أُنْبُوبِيّ الأَنْف (ذو أنف أنبوبي الشكل)",
 "tube-nosed bat": "خفاش أنبوبي الأنف (أي من خفافيش الفاكهة المتنوعة التي تتميز بفتحات أنف ممتدة إلى أنابيب متباعدة)",
 "tube-nosed fruit bat": "خفاش أنبوبي الأنف (أي من خفافيش الفاكهة المتنوعة التي تتميز بفتحات أنف ممتدة إلى أنابيب متباعدة)",
 "tube-shaped": "أُنْبُوبِيّ (يشكّل أنبوبًا أو يحتوي على أنابيب مجوّفة لمرور السوائل)",
 "tube-shaped structure": "أنبوب, بنية أنبوبية ((في التشريح) أي بنية جسدية أسطوانية مجوفة)",
 "tubed": "ذو أنبوب داخلي (لإطار؛ يحتوي على أنبوب داخلي)",
 "tubeless": "بدون أنبوب داخلي, تيوبلس (لإطار؛ لا يحتاج إلى أنبوب داخلي) / إطار بدون أنبوب, تيوبلس (إطار هوائي لا يحتاج إلى أنبوب داخلي ليكون محكماً ضد الهواء)",
 "tubeless tire": "إطار بدون أنبوب, تيوبلس (إطار هوائي لا يحتاج إلى أنبوب داخلي ليكون محكماً ضد الهواء)",
 "tubelike": "أُنْبُوبِيّ (يشكّل أنبوبًا أو يحتوي على أنابيب مجوّفة لمرور السوائل)",
 "tuber": "درنة (ساق أو جذر تحت أرضي لحمي يخدم في التكاثر وتخزين الغذاء)",
 "tuber root": "صقلاب درني, عشبة الفراشة (نبات معمر منتصب من شرق وجنوب الولايات المتحدة له زهور برتقالية بارزة)",
 "tubercle": "أحدوبة, حديبة (نتوء على عظم خاصة لربط عضلة أو رباط) / درينة, عقيدة (نتوء صغير مستدير يشبه الثالول على النبات) / درنة (تورم يعتبر الآفة المميزة لمرض السل)",
 "tubercle bacillus": "عصوية السل, متفطرة سلية (مسبب مرض السل)",
 "tubercular": "دَرَنِيّ, سُلِّيّ (مصاب بالسلّ أو ناتج عنه أو مرتبط بعُصَيَّات السلّ) / سلي, مسلول (متعلق بمرض السل أو المصابين به) / حدبي (متعلق بطبيعة الحدبة أو النتوء العظمي الطبيعي) / درني, سلي (يتميز بوجود آفات السل أو الدرنات)\nمثال: مستشفى السل",
 "tuberculate": "متدرن, مدرن (مغطى بالدرنات)",
 "tuberculin": "تيوبركولين (سائل معقم يحتوي على مشتق بروتيني منقى من بكتيريا السل؛ يستخدم في تشخيص مرض السل)",
 "tuberculin skin test": "اختبار الجلد للتدرن, اختبار السل (اختبار جلدي لتحديد العدوى السابقة أو الحالية ببكتيريا السل)",
 "tuberculin test": "اختبار الجلد للتدرن, اختبار السل (اختبار جلدي لتحديد العدوى السابقة أو الحالية ببكتيريا السل)",
 "tuberculoid": "شبيه السل (يشبه مرض السل)\nمثال: آفات شبيهة بالسل",
 "tuberculoid leprosy": "جذام درني (جذام يتميز بأورام في الجلد والأعصاب الجلدية)",
 "tuberculosis": "سُلّ",
 "tuberculous": "دَرَنِيّ, سُلِّيّ (مصاب بالسلّ أو ناتج عنه أو مرتبط بعُصَيَّات السلّ)",
 "tuberose": "مسك الروم (عشب مكسيكي درني له أوراق تشبه العشب ويزرع لسنابله من الزهور البيضاء الشمعية التي تشبه الزنبق وشديدة العطرية)",
 "tuberosity": "أحدوبة, حديبة (نتوء على عظم خاصة لربط عضلة أو رباط)",
 "tuberous": "درني (من أو يتعلق بالدرنة أو يشبهها)\nمثال: جذر درني",
