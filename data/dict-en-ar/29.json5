 "turn signal": "إشارة الانعطاف, غمّاز (ضوء وامض في مركبة بمحرك يشير إلى الاتجاه الذي توشك المركبة على الانعطاف إليه)",
 "turn upside down": "جَعَلَ عَالِيَ الشَّيْءِ سَافِلَهُ, قَلَبَ (صَيَّرَ؛ أَنْشَأَ)\nمثال: جعل الأمور أسوء.",
 "turn-on": "شيء مثير, مثير للاهتمام (شيء يسبب الإثارة أو يحفز الاهتمام)",
 "turnability": "قابلية الدوران, قدرة على الانعطاف (خاصية القدرة على الدوران)",
 "turnabout": "ارتداد, انعكاس (التحول في الاتجاه المعاكس) / انقلاب, تراجع (قرار بعكس قرار سابق)",
 "turnaround": "ارتداد, انعكاس (التحول في الاتجاه المعاكس) / تجهيز للرحلة العودة, وقت الدوران (عمل أو عملية تفريغ وتحميل وخدمة سفينة أو طائرة لرحلة العودة) / منطقة دوران (منطقة كبيرة بما يكفي لتدور المركبة فيها) / انقلاب, تراجع (قرار بعكس قرار سابق)",
 "turnaround time": "وقت الاستجابة, وقت التحول (الوقت اللازم لتجهيز سفينة أو مركبة لرحلة العودة)",
 "turnbuckle": "حلقة شد, شدادة (وصلة معدنية مستطيلة بقطب دوار في أحد طرفيها وسن لولبي داخلي في الآخر لضبط الطول أو الشد)",
 "turncoat": "خَائِن, مُرْتَدّ (شخص غير مخلص يخون أو يتخلى عن قضيته أو دينه أو حزبه السياسي أو صديقه، إلخ)",
 "turncock": "صنبور, محبس (صنبور يتكون من جهاز دوار لتنظيم تدفق السائل) / عامل محابس المياه (شخص يعمل للتحكم في إمدادات المياه عن طريق فتح وإغلاق أنابيب المياه الرئيسية)",
 "turndown": "رفض, عدم قبول (فعل رفض عرض ما)\nمثال: كان الرفض مؤدباً ولكن حازماً جداً",
 "turned": "حَامِض, فَاسِد (في حالة غير مستساغة للأكل) / مخروط, مشكَّل بالخراطة (تم تحريكه حول محور أو مركز (أثناء التشكيل))",
 "turned out": "أَنِيق المَظْهَر (يرتدي ملابس حسنة أو أنيقة)",
 "turner": "خَرَّاط",
 "turner's syndrome": "متلازمة تيرنر",
 "turnery": "خراطة, فن الخراطة (منتجات مصنوعة على مخرطة) / ورشة خراطة (ورشة يتم فيها صنع الأشياء على المخرطة)",
 "turning": "تحول (فعل التغيير في الممارسة أو العادة) / انعطاف, دوران (عملية تغيير أو عكس اتجاه المسار) / خراطة (نشاط تشكيل شيء ما على المخرطة) / خراطة, مشغولات مخرطة (المنتج النهائي الذي تم إنشاؤه بتشكيل شيء ما على مخرطة)\nمثال: اتخذ القانون العديد من التحولات على مر السنين",
 "turning and boring mill": "آلة الخراطة والتجويف, مخرطة رأسية (نوع من المخارط ذات محور دوران رأسي ولوحة وجه أفقية، تستخدم لخراطة وتجويف القطع الكبيرة)",
 "turning away": "تجنب, تحاشي (التجنب المتعمد؛ الابتعاد عن شيء أو منع حدوثه)",
 "turning point": "نقطة تحوّل (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه)\nمثال: هذه هي نقطة ضعفه.",
 "turnip": "لِفْت ((لَوَاهُ) علَى غيرِ جِهَتِه؛ الصَّرْفُ)\nمثال: كان أول ما لفت انتباهه هي بصمة الإصبع على الزجاج.",
 "turnip bed": "حوض لفت (حوض ينمو فيه اللفت)",
 "turnip cabbage": "كرنب ساقي, كولرابي (ساق لحمية صالحة للأكل تشبه اللفت لنبات الكرنب الساقي) / روتاباغا, لفت سويدي (نبات صليبي بجذر أصفر سميك بصلي صالح للأكل)",
 "turnip greens": "أوراق اللفت (أوراق طرية للفت الأبيض الصغير)",
 "turnip plant": "لفت, نبات اللفت (أي من النباتات المزروعة على نطاق واسع ذات جذور صالحة للأكل)",
 "turnip-rooted celery": "كرفس جذري, كرفس لفتي (يزرع لجذره العطري السميك الصالح للأكل)",
 "turnip-rooted parsley": "بقدونس لفتي الجذر, بقدونس هامبورغ (بقدونس بأوراق ملساء وجذر وتدي صالح للأكل متضخم يشبه الجزر الأبيض اللذيذ)",
 "turnip-shaped": "لَفْتِيّ الشَّكْل (على شكل لَفْتة (شَلْجَم))",
 "turnix sylvatica": "سمان الشجر المخطط (نوع من سمان الشجر المخطط)",
 "turnkey": "حارِس سِجْن, سَجَّان (شخص يحرس السجناء)",
 "turnoff": "مخرج, منعطف (طريق جانبي حيث يمكنك الانعطاف) / تثبيط, مُنَفِّر (شيء يسبب العداء أو فقدان الاهتمام)\nمثال: فوت المخرج وقطعت 15 ميلاً خارج طريقي",
 "turnout": "دوران للخارج ((باليه) الدوران الخارجي لساق الراقص من الورك) / إِقْبَال (الحضور لحدث أو غرض معين (كما في التصويت في الانتخابات)) / طقم ملابس, هندام (مجموعة متناسقة من الملابس (مع الإكسسوارات)) / إنتاج, مخرجات (ما يتم إنتاجه في فترة زمنية معينة)\nمثال: الإقبال على التجمع",
 "turnover": "انقلاب, قلب (عملية قلب شيء ما) / إجمالي العائدات, حجم التداول (الحجم المقاس بالدولار) / تيرن أوفر, فطيرة مطوية (طبق يُصنع بطي قطعة من العجين فوق الحشوة) / دَوَرَان المُوَظَّفِين, مُعَدَّل الدَّوَرَان (نسبة عدد العمال الذين تم استبدالهم في فترة زمنية معينة إلى متوسط عدد العمال)\nمثال: أصيب برضوض شديدة بسبب انقلاب زلاجته بسرعة عالية",
 "turnover rate": "دَوَرَان المُوَظَّفِين, مُعَدَّل الدَّوَرَان (نسبة عدد العمال الذين تم استبدالهم في فترة زمنية معينة إلى متوسط عدد العمال)",
 "turnpike": "طريق برسوم مرور (طريق سريع يتم تحصيل رسوم مرور عليه) / بوابة عبور ((من القرن السادس عشر إلى التاسع عشر) بوابات توضع عبر طريق لمنع المرور حتى يتم دفع رسوم)",
 "turnround": "تجهيز للرحلة العودة, وقت الدوران (عمل أو عملية تفريغ وتحميل وخدمة سفينة أو طائرة لرحلة العودة)",
 "turnspit": "سيخ شواء دوار (سيخ تحمير يمكن تدويره)",
 "turnstile": "باب دوار (بوابة تتكون من عمود يعمل كمحور لأذرع دوارة؛ توضع في ممر للتحكم في الأشخاص الداخلين)",
 "turnstone": "قنبرة الماء (طيور ساحلية مهاجرة من فصيلة الزقزاق تقلب الحجارة بحثاً عن الطعام)",
 "turnt": "مُتَحَمِّسٌ جِدًّا ((غير رسمي) شَدِيدُ الحَمَاسِ وَالإِثَارَةِ خَاصَّةً فِي الحَفَلَاتِ)",
 "turntable": "قرص دوار (منصة أفقية دائرية تقوم بتدوير اسطوانة الفونوغراف أثناء تشغيلها) / صينية دوارة (منصة قابلة للدوران مع سكة؛ تستخدم لتدوير القاطرات والعربات) / صينية دوارة (صينية دوارة توضع على طاولة الطعام)",
 "turnup": "ثنية الكم, كُفّة (طية تتكون من حاشية مقلوبة للخلف تطوق نهاية الكم أو الساق)",
 "turnverein": "نادي جمباز (نادي للاعبي الجمباز)",
 "turp": "استئصال البروستاتا عبر الإحليل (إزالة كميات كبيرة من أنسجة البروستاتا (كما في حالات تضخم البروستاتا الحميد))",
 "turpan": "تُورْبَان",
 "turpentine": "تِرْبَنْتِين, نَفْط",
 "turpentine camphor weed": "عشبة الخل, عشبة كافور التربنتين (نبات عطري من غرب الولايات المتحدة)",
 "turpentine weed": "عشبة الأرنب, عشبة الثعبان المكنسية (شجيرة منخفضة النمو لزجة في جنوب غرب الولايات المتحدة ذات أوراق خطية ضيقة على العديد من الفروع الرفيعة ومئات من رؤوس الزهور الصفراء الصغيرة)",
 "turpitude": "انحطاط أخلاقي, رذيلة (فعل أو ممارسة فاسدة أو منحطة أو منحلة)\nمثال: مختلف أشكال الانحطاط في المجتمع الحديث",
 "turps": "زيت التربنتين (سائل متطاير مقطر من راتنج التربنتين؛ يُستخدم كمخفف للطلاء ومذيب وطبياً)",
 "turquoise": "فَيْرُوزِيّ",
 "turraea": "توريا (أي من الأشجار والشجيرات العديدة التي تزرع لأوراقها اللامعة الجميلة وزهورها النجمية حلوة الرائحة)",
 "turret": "برج حربي, برج مدفع (منصة أسلحة مستقلة تحتوي على مدافع وقابلة للدوران) / برج صغير, بريج (برج صغير يمتد فوق مبنى)",
 "turret clock": "ساعة برج (ساعة لها أكثر من قرص لإظهار الوقت في جميع الاتجاهات من برج)",
 "turritis glabra": "خردل البرج, رشاد البرج (أو جنس أرابيس: رشاد منتصب واسع الانتشار في جميع أنحاء أوروبا)",
 "tursiops gilli": "دلفين قاروري الأنف الهادئ (دلفين قاروري الأنف يوجد في المحيط الهادئ)",
 "tursiops truncatus": "دلفين قاروري الأنف الأطلسي (أكثر الدلافين شيوعاً في شمال المحيط الأطلسي والبحر الأبيض المتوسط؛ غالباً ما يُحتفظ به في الأسر ويُدرب لتقديم العروض)",
 "turtle": "سُلَحْفَاة / غَيْلَم (منبع الماء في الآبار؛ الجارية المغتلمة)",
 "turtle bean": "فاصولياء سوداء (فاصولياء سوداء البذور من أمريكا الجنوبية؛ عادة ما تكون مجففة)",
 "turtle dove": "تُرْغُلَّة",
