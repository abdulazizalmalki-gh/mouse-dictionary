 "tormenter": "حاجب الكواليس (لوح مسطح في كل جانب من جوانب المسرح لمنع الجمهور من الرؤية داخل الأجنحة) / مضطهد, معذب (شخص يقوم بتعذيب الآخرين أو التنكيل بهم)",
 "tormentor": "حاجب الكواليس (لوح مسطح في كل جانب من جوانب المسرح لمنع الجمهور من الرؤية داخل الأجنحة) / مضطهد, معذب (شخص يقوم بتعذيب الآخرين أو التنكيل بهم)",
 "torn": "مُمَزَّق, مُهَتَّك (ذو حواف خشنة ممزقة من أثر الإصابة) / مُتَشَتِّت, مُمَزَّق (مُضْطَرِبٌ بِسَبَبِ جَذْبِ قُوًى مُتَضَادَّة)",
 "tornado": "إِعْصَار (الرِيَاح التي تهب من الأرض وتثير الغبار فترتفع كالعمود إلى نحو السماء. زَوْبَعَة؛ دوّامات هوائيّة شديدة السرعة تدور حول مراكزٍ من الهواء عالي الضغط، سواء كانت فوق الأرض أو فوق الماء. [])\nمثال: السطح دمر من قبل الإعصار.",
 "tornado cellar": "قبو العواصف, ملجأ الأعاصير (ملجأ تحت الأرض يمكنك الذهاب إليه حتى تمر العاصفة)",
 "tornado lantern": "فانوس العاصفة, مصباح العاصفة (مصباح زيت بمدخنة زجاجية وغطاء معدني مثقوب لحماية اللهب من الرياح العاتية؛ شمعدان بمدخنة زجاجية)",
 "tornillo": "فول لولبي, مسكيت لولبي (شجيرة أو شجرة صغيرة في جنوب غرب الولايات المتحدة وشمال غرب المكسيك لها قرون ملتوية لولبياً)",
 "toroid": "سطح حلقي, طارة (سطح على شكل حلقة يتولد عن تدوير دائرة حول محور لا يقطع الدائرة) / طارة, مجسم حلقي (الجسم الذي يشبه الكعكة المحاط بسطح حلقي)",
 "toroidal": "حلقي, طارة (متعلق بالطارة أو شكله يشبه الكعكة (الدونات))",
 "toronto": "تُورُونْتُو",
 "torpedo": "طُرْبِيد",
 "torpedo boat": "قارب طوربيد (سفينة حربية صغيرة عالية السرعة مصممة لهجمات الطوربيد في المياه الساحلية)",
 "torpedo tube": "أنبوب طوربيد (أنبوب بالقرب من خط الماء للسفينة يتم من خلاله إطلاق الطوربيد)",
 "torpedo-boat destroyer": "مدمرة قوارب الطوربيد (مدمرة صغيرة كانت سلف المدمرات الحديثة؛ مصممة لتدمير قوارب الطوربيد)",
 "torpid": "بَلِيد, خَامِل (بطيء ولا مُبالٍ) / خَامِل, سَابِت (في حالة سكون بيولوجي أو سُبات)",
 "torpidity": "خدر, فتور (خمول ناتج عن السبات ونقص القوة أو الطاقة) / خمول, سبات (حالة من الخمول الحركي والعقلي مع تعليق جزئي للحساسية)\nمثال: دخل في سبات عميق",
 "torpidly": "بِتَرَنُّح, بِذُهُول (في حالة ذهول؛ بطريقة مذهولة)\nمثال: تساءل بذهول عما إذا كان الفصل الدراسي بعد القادم في مدرسته الجديدة لن يهم كثيراً",
 "torpidness": "خدر, فتور (خمول ناتج عن السبات ونقص القوة أو الطاقة)",
 "torpor": "خدر, فتور (خمول ناتج عن السبات ونقص القوة أو الطاقة) / خمول, سبات (حالة من الخمول الحركي والعقلي مع تعليق جزئي للحساسية)\nمثال: دخل في سبات عميق",
 "torque": "التواء, عزم الدوران",
 "torque converter": "محول عزم (محول لنقل وتضخيم العزم (خاصة بالوسائل الهيدروليكية))",
 "torque wrench": "مفتاح العزم (مفتاح ربط يحتوي على مقياس يشير إلى مقدار العزم المطبق)",
 "torr": "تور, مليمتر زئبقي (وحدة ضغط تساوي 0.001316 ضغط جوي؛ سُميت نسبة إلى تورشيللي)",
 "torrent": "تيار جارف, سيل (تيار مائي سريع وعنيف (أو سائل آخر)) / طوفان, هطول غزير (مطر غزير) / سيل, طوفان (عدد أو كمية هائلة)\nمثال: جرفت المنازل في السيل",
 "torrential": "جَارِف, سَيْلِيّ (ينهمر بغزارة شديدة) / جَارِف, عَارِم (يُشْبِهُ السَّيْلَ فِي قُوَّتِهِ وَوَفْرَتِه) / جارف, سيلي (متعلق بالسيل أو ناتج عن تدفق قوي للمياه)\nمثال: تعرية سيلية",
 "torres strait": "مَضِيق تُوْرِيس (البَحْر حين يضيق لإقتراب البرَ من الجهتين)",
 "torrey pine": "صنوبر توري (صنوبر متوسط الحجم خماسي الإبر من جنوب غرب كاليفورنيا له مخاريط أسطوانية طويلة)",
 "torrey tree": "أرز نتن, طقسوس نتن (شجرة دائمة الخضرة صغيرة نادرة من شمال فلوريدا؛ أوراقها الخضراء اللامعة لها رائحة كريهة عند سحقها)",
 "torrey's pine": "صنوبر توري (صنوبر متوسط الحجم خماسي الإبر من جنوب غرب كاليفورنيا له مخاريط أسطوانية طويلة)",
 "torreya californica": "جوزة الطيب الكاليفورنية (شجرة دائمة الخضرة من كاليفورنيا لها فاكهة تشبه جوزة الطيب ولكن بنكهة تربنتين قوية)",
 "torreya taxifolia": "أرز نتن, طقسوس نتن (شجرة دائمة الخضرة صغيرة نادرة من شمال فلوريدا؛ أوراقها الخضراء اللامعة لها رائحة كريهة عند سحقها)",
 "torrid": "حَارِق, لَافِح (شديد الحرارة والجفاف) / جَيَّاش, مُفْعَم بِالحَيَوِيَّة (مشحون عاطفيًّا ونشيط بقوّة) / حَمَاسِيّ, مُتَحَمِّس (يَتَّسِمُ بِعَاطِفَةٍ شَدِيدَة)",
 "torridity": "حرارة شديدة, قيظ (حرارة شديدة)",
 "torsion": "التواء, عزم الدوران / التواء, تلوّي (شكل أو وضع ملتو ومتعرج)\nمثال: قام البهلوان بالتواءات لا تصدق",
 "torsion angle": "زاوية الالتواء, زاوية زوجية (الزاوية بين مستويين)",
 "torsion balance": "ميزان الالتواء (أداة قياس مصممة لقياس القوى الصغيرة عن طريق الالتواء الذي تمارسه على سلك رفيع)",
 "torsion bar": "قضيب الالتواء (قضيب معدني يعمل كنابض التواء، يستخدم في أنظمة تعليق بعض المركبات)\nمثال: الدوران المفرط لقضبان الالتواء يمكن أن يتسبب في اصطدام نظام التعليق بمصد الصدمات قبل الأوان، مما يسبب قيادة قاسية",
 "torsk": "كاسك (سمكة بحرية كبيرة صالحة للأكل تعيش في المياه الساحلية الشمالية؛ مرتبطة بالقد)",
 "torso": "جِذْع, جِسْم (في علم النبات: أحد أجزاء النبات الذي يحمل الأغصان ويتصل في أسفله بالجذر)",
 "tort": "الضرر في القانون",
 "tort-feasor": "مرتكب الضرر (طرف ارتكب ضرراً مدنياً)",
 "torte": "تورتة (كعكة غنية مغطاة عادة بالكريمة والفاكهة أو المكسرات؛ نشأت في النمسا)",
 "tortellini": "تورتيليني (مكرونة محشوة صغيرة على شكل حلقة)",
 "tortfeasor": "مرتكب الضرر (طرف ارتكب ضرراً مدنياً)",
 "torticollis": "تشنج الرقبة, صعر (حالة غير طبيعية يميل فيها الرأس إلى جانب واحد بسبب تقلص عضلات الرقبة على ذلك الجانب)",
 "tortilla": "تورتيلا, خبز التورتيلا (خبز مسطح رقيق غير مخمر مصنوع من دقيق الذرة أو دقيق القمح)",
 "tortilla chip": "رقائق التورتيلا (قطعة صغيرة من التورتيلا)",
 "tortious": "تقصيري, ضار (متعلق بطبيعة الفعل الضار أو المسؤولية التقصيرية (قانون))\nمثال: أعمال ضارة (تقصيرية)",
 "tortoise": "سُلَحْفَاة",
 "tortoise plant": "ديسقوريا الفيل, قدم الفيل (كرمة من جنوب أفريقيا لها ساق جذري ضخم مغطى بلحاء عميق التشقق)",
 "tortoiseshell": "قط ذبل, قط كاليكو (قط ذو علامات سوداء وكريمية وصفراء) / فراشة صدفة السلحفاة (زاهية الألوان؛ تتغذى اليرقات على نبات القراص) / ذبل, صدفة السلحفاة (المادة القرنية المبقعة لصدفة بعض السلاحف)",
 "tortoiseshell butterfly": "فراشة صدفة السلحفاة (زاهية الألوان؛ تتغذى اليرقات على نبات القراص)",
 "tortoiseshell turtle": "سلحفاة صقرية المنقار (سلحفاة بحرية استوائية عدوانية ذات منقار يشبه الصقر؛ مصدر للغذاء وأفضل أنواع صدف السلاحف)",
 "tortoiseshell-cat": "قط ذبل, قط كاليكو (قط ذو علامات سوداء وكريمية وصفراء)",
 "tortosa": "طُرْطُوشَة",
 "tortricid": "عثة تورتريكس (أي من العث الصغير المتعدد الذي له أجنحة مهدبة قليلاً؛ اليرقات هي لفافات الأوراق أو تعيش في الفواكه والعفص)",
 "tortricid moth": "عثة تورتريكس (أي من العث الصغير المتعدد الذي له أجنحة مهدبة قليلاً؛ اليرقات هي لفافات الأوراق أو تعيش في الفواكه والعفص)",
 "tortrix": "عثة الشاي (عثة هندية صغيرة تغزو نباتات الشاي والبن مثلاً) / عثة البرتقال (عثة من كاليفورنيا تعيش يرقاتها في البرتقال بشكل خاص)",
 "tortuosity": "التواء, تلوّي (شكل أو وضع ملتو ومتعرج)\nمثال: قام البهلوان بالتواءات لا تصدق",
 "tortuous": "مُعَقَّد, مُلْتَوٍ (غَيْر مُبَاشِر وَلَا وَاضِح) / شَائِك, مُعَقَّد (بَالِغ التَّعْقِيد أَوِ التَّشَابُك وَأَحْيَانًا مُخَادِع) / مُتَعَرِّج, مُلْتَوٍ (يتميز بمنعطفات وانحناءات متكررة)",
 "tortuously": "بتعقيد, بشكل ملتو (بطريقة ملتوية) / بتعرج (مع التقلبات والمنعطفات)\nمثال: يساومون بشكل ملتو على السعر",
 "tortuousness": "تَشَابُك, تَعْقِيد (تعقيد محير) / التواء, تلوّي (شكل أو وضع ملتو ومتعرج)\nمثال: قام البهلوان بالتواءات لا تصدق",
 "torture": "تَعْذِيب / عَذَاب / عَذَّبَ",
 "torture chamber": "غرفة تعذيب (غرفة يتم فيها ممارسة التعذيب)",
 "tortured": "مُتَأَلِّم, مُعَذَّب (يعاني ألماً شديداً خاصة الألم النفسي)",
 "torturer": "جَلَّاد",
 "torturesome": "مُبَرِّح, مُمِضّ (شَدِيدُ الإِيلَامِ إِلَى أَقْصَى حَدّ)",
 "torturing": "تعذيب (الإلحاق المتعمد أو المنهجي أو العشوائي للألم الجسدي أو العقلي من قبل شخص أو أكثر في محاولة لإجبار شخص آخر على تقديم معلومات أو الاعتراف أو لأي سبب آخر) / مُبَرِّح, مُمِضّ (شَدِيدُ الإِيلَامِ إِلَى أَقْصَى حَدّ)\nمثال: تطلب الأمر تعذيباً غير طبيعي لانتزاع اعتراف",
 "torturous": "مُبَرِّح, مُمِضّ (شَدِيدُ الإِيلَامِ إِلَى أَقْصَى حَدّ)",
 "torturously": "بِأَلَم شَدِيد, بِعَذَاب (بطريقة مؤلمة جداً)\nمثال: كان التقدم بطيئاً بشكل مؤلم",
 "torulose": "سُبْحِيّ, مُعَقَّد الشَّكْل (ذو جسم أسطوانيّ أو إهليلجيّ؛ منتفخ ومُنقبض على فترات)",
 "torus": "طَارَة (في و: هو اسم آخر للمِقْوَد، وخصوصاً مقوَد السَيَّارَة؛ في و: الشخص الماهر في قيادة السيارات)",
 "tory": "توري (أمريكي فضل الجانب البريطاني خلال الثورة الأمريكية) / توري, محافظ (مؤيد للمؤسسات السياسية والاجتماعية التقليدية ضد قوى الإصلاح؛ محافظ سياسي) / توري (عضو في حزب سياسي في بريطانيا العظمى يُعرف بحزب المحافظين منذ عام 1832؛ كان حزب المعارضة للويغز)",
 "tosh": "تَفَاهَة, دَجَل (حديث أو كتابة مدعية أو سخيفة)",
 "tosk": "لهجة التوسك (لهجة الألبانية التي يتم التحدث بها في جنوب ألبانيا وفي مناطق من اليونان وإيطاليا)",
 "tosk dialect": "لهجة التوسك (لهجة الألبانية التي يتم التحدث بها في جنوب ألبانيا وفي مناطق من اليونان وإيطاليا)",
 "toss": "تمرير, رمي ((رياضة) فعل رمي الكرة لعضو آخر في فريقك) / رمي, هز (حركة مفاجئة) / رمي العملة, قرعة (فعل تقليب العملة)\nمثال: تم إهدار التمريرة",
 "toss a coin": "قَذَفَ العُمْلَةَ, رَمَى بِالعُمْلَةِ (بمعنى رَمَى؛ قذَف بالحقّ: أمر به وأبانه)",
 "toss bombing": "قصف قذفي (طلعة قصف يقترب فيها القاذف من الهدف على ارتفاع منخفض ويرتفع قبل إطلاق القنبلة مباشرة)",
 "toss-up": "أمر غير محسوم, احتمالية متساوية (ظاهرة لا يمكن التنبؤ بها)\nمثال: إنه أمر غير محسوم ما إذا كان سيفوز أم يخسر",
 "tossed salad": "سلطة مخلوطة, سلطة مقلبة (سلطة مخلوطة مع تتبيلة)",
 "tosser": "قاذف (شخص يرمي بخفة (كما مع راحة اليد لأعلى)) / مُسْتَمْنٍ (مصطلحات مسيئة لوصف من يمارس العادة السرية)",
 "tossup": "أمر غير محسوم, احتمالية متساوية (ظاهرة لا يمكن التنبؤ بها)\nمثال: إنه أمر غير محسوم ما إذا كان سيفوز أم يخسر",
 "tostada": "توستادا (تورتيلا مسطحة مقرمشة) / توستادا (تورتيلا مسطحة مكدسة بحشوات متنوعة)",
 "tot": "طفل صغير, طفل يحبو (طفل صغير بدأ للتو في المشي) / جرعة صغيرة (كمية صغيرة (خاصة من مشروب))\nمثال: جرعة صغيرة من الروم",
 "total": "مَجْمُوع",
 "total aphasia": "حبسة شاملة, حبسة كلية (فقدان كلي للقدرة على التواصل)",
 "total darkness": "حلكة, سواد (الغياب التام للضوء)\nمثال: تحسسوا طريقهم في ظلام دامس",
 "total depravity": "فساد كلي (العقيدة الكالفينية القائلة بأن الجميع يولدون في حالة فساد نتيجة للخطيئة الأصلية)",
 "total eclipse": "كسوف كلي (كسوف كما يُرى من مكان يكون فيه الجرم المحجوب مخفياً تماماً)",
 "total heat": "إنثالبي, محتوى حراري (كمية ديناميكية حرارية تساوي الطاقة الداخلية للنظام زائد حاصل ضرب حجمه وضغطه)\nمثال: المحتوى الحراري هو مقدار الطاقة في النظام القادر على القيام بعمل ميكانيكي",
 "total hysterectomy": "استئصال الرحم الكلي (إزالة جراحية للرحم وعنق الرحم)",
 "total parenteral nutrition": "تغذية وريدية كاملة (إعطاء محلول كافٍ غذائياً عبر قسطرة في الوريد الأجوف)",
 "total war": "الحَرْب الشَّامِلَة",
 "totaled": "مُحَطَّمٌ كُلِّيًّا ((عَنِ السَّيَّارَاتِ) دُمِّرَ بِالكَامِل)",
 "totalisator": "آلة الرهان المتبادل, توتاليزيتور (حاسوب يسجل الرهانات ويقسم المبلغ الإجمالي للرهان بين الفائزين)",
 "totaliser": "آلة جمع (آلة حاسبة تؤدي وظائف حسابية بسيطة) / آلة الرهان المتبادل, توتاليزيتور (حاسوب يسجل الرهانات ويقسم المبلغ الإجمالي للرهان بين الفائزين)",
 "totalism": "حكم مطلق, شمولية (معتقد أيديولوجي في السلطة الكاملة وغير المقيدة للحكومة)",
 "totalistic": "شمولي, كلياني (متعلق بمبادئ الشمولية حيث تنظم الدولة كل مجالات الحياة)\nمثال: النظرية والممارسة الشمولية",
 "totalitarian": "شُمُولِيّ",
 "totalitarian regime": "دولة شمولية, نظام شمولي (حكومة تخضع الفرد للدولة وتسيطر بصرامة على جميع جوانب الحياة من خلال تدابير قسرية)",
 "totalitarian state": "دولة شمولية, نظام شمولي (حكومة تخضع الفرد للدولة وتسيطر بصرامة على جميع جوانب الحياة من خلال تدابير قسرية)",
 "totalitarianism": "شُمُولِيَّة",
 "totality": "إِجْمَالِيّ, كُلِّيَّة (الكمية الكاملة أو الشيء بمجمله) / شُمُول, كُلِّيَّة (صفة كون الشيء كاملاً وغير مميز) / تمام, كليّة (حالة كونه كلياً وكاملاً)\nمثال: شمولية الحرب وعواقبها",
 "totalizator": "آلة الرهان المتبادل, توتاليزيتور (حاسوب يسجل الرهانات ويقسم المبلغ الإجمالي للرهان بين الفائزين)",
 "totalizer": "آلة جمع (آلة حاسبة تؤدي وظائف حسابية بسيطة) / آلة الرهان المتبادل, توتاليزيتور (حاسوب يسجل الرهانات ويقسم المبلغ الإجمالي للرهان بين الفائزين)",
 "totalled": "مُحَطَّمٌ كُلِّيًّا ((عَنِ السَّيَّارَاتِ) دُمِّرَ بِالكَامِل)",
 "totally": "بالكامل, بشكل تام (إلى درجة كاملة أو إلى الحد الأقصى؛ بالكامل)\nمثال: كان مقتنعاً كلياً",
 "totara": "بودوكاربوس توتارا, توتارا (شجرة خشبية قيمة في نيوزيلندا تنتج خشباً محمراً صلباً يستخدم للأثاث والجسور والأرصفة)",
 "tote": "حقيبة حمل, حقيبة كبيرة (حقيبة أو سلة واسعة تتسع لأشياء كثيرة)",
 "tote bag": "حقيبة حمل, حقيبة كبيرة (حقيبة أو سلة واسعة تتسع لأشياء كثيرة)",
 "totem": "طَوْطَم",
 "totem pole": "عَمُود رَمْز",
 "totemic": "طوطمي (يتعلق بالطوطمية)\nمثال: غرض طوطمي",
 "totemism": "طوطمية",
 "totemist": "طُوطَمِيّ (شخص ينتمي إلى عشيرة أو قبيلة لها طوطم)",
 "toter": "حامل, ناقل (شخص تتضمن وظيفته حمل شيء ما)\nمثال: نُقلت السندات بواسطة حامل",
 "totipotence": "طاقة كاملة, قدرة كاملة (قدرة الخلية على التمايز إلى خلايا مختلفة وتكوين كائن جديد)\nمثال: تفقد الخلايا الحيوانية قدرتها الكاملة في مرحلة مبكرة من التطور الجنيني",
 "totipotency": "طاقة كاملة, قدرة كاملة (قدرة الخلية على التمايز إلى خلايا مختلفة وتكوين كائن جديد)\nمثال: تفقد الخلايا الحيوانية قدرتها الكاملة في مرحلة مبكرة من التطور الجنيني",
 "totipotent": "شامل الوسع, كامل القدرة (تمتلك القدرة على التمايز لإنتاج خلايا مختلفة الأنواع)\nمثال: الخلايا الجذعية الجنينية كاملة القدرة",
 "totten trust": "ائتمان توتن, ائتمان حساب التوفير (حساب توفير يودعه شخص يجعل نفسه أميناً لمستفيد ويتحكم فيه خلال حياته؛ وبعد ذلك يُدفع الرصيد للمستفيد المسمى مسبقاً)",
 "tottenham": "توتنهام",
 "totterer": "مترنح (شخص يمشي بشكل غير مستقر وكأنه على وشك السقوط)",
 "tottering": "آيِل لِلسُّقُوط, مُتَدَاعٍ ((للهياكل أو المؤسسات) فقد استقراره؛ يتهاوى أو على وشك الانهيار) / مُتَخَاذِل, مُتَهَالِك (غير ثابت في مشيته بسبب الوهن أو الشيخوخة)",
 "tottery": "مُتَخَاذِل, مُتَهَالِك (غير ثابت في مشيته بسبب الوهن أو الشيخوخة)",
 "tottori": "تُوتُورِي",
 "toucan": "طُوقَان",
 "toucanet": "طوقان صغير (طوقان صغير الحجم)",
 "touch": "لَمَسَ (اتصل بشيء أو شخص بشكل مباشر بواسطة جزء من الجسم مثل اليد، التواصل الحسي أو المعنوي مع شيء ما؛ يدل على التواصل، سواء كان ماديًا أو معنويًا، مع شيء ما) / لَمْسَة, مُلَامَسَة / لَمْس (اتصل بشيء أو شخص بشكل مباشر بواسطة جزء من الجسم مثل اليد، التواصل الحسي أو المعنوي مع شيء ما؛ يدل على التواصل، سواء كان ماديًا أو معنويًا، مع شيء ما)\nمثال: إياك ولمس شطيرتي!",
 "touch football": "كرة قدم اللمس (نسخة من كرة القدم الأمريكية يتم فيها لمس حامل الكرة بدلاً من عرقلته)",
 "touch modality": "حاسة اللمس, لمس (الملكة التي تدرك بها الأشياء أو القوى الخارجية من خلال الاتصال بالجسم (وخاصة اليدين))\nمثال: فقط البصر واللمس يمكننا من تحديد مواقع الأشياء في الفضاء حولنا",
 "touch perception": "إحساس لمسي, لمسية (ملكة الإدراك (عبر الجلد) للضغط أو الحرارة أو الألم)",
 "touch screen": "شَاشَة لَمْس",
 "touch sensation": "لمس, ملمس (الإحساس الناتج عن مستقبلات الضغط في الجلد)\nمثال: هي تحب ملمس الحرير على بشرتها",
 "touch system": "الطباعة باللمس (الكتابة على الآلة الكاتبة حيث تُدرَّب الأصابع على ضرب مفاتيح معينة؛ ويستطيع الطابع القراءة والكتابة في نفس الوقت)",
 "touch typing": "الطباعة باللمس (الكتابة على الآلة الكاتبة حيث تُدرَّب الأصابع على ضرب مفاتيح معينة؛ ويستطيع الطابع القراءة والكتابة في نفس الوقت)",
 "touch-and-go": "مَحْفُوفٌ بِالخَطَر, وَخِيم (مليء بالأخطار والمهالك)",
 "touch-me-not": "ست المستحية, ميموزا خجولة (شجيرة فرعية مفترشة أو شبه منتصبة من أمريكا الاستوائية وأستراليا؛ مسلحة بشدة بأشواك منحنية ولها وريقات خضراء رمادية ناعمة حساسة تطوى وتتدلى في الليل…) / فقوس الحمار, قثاء الحمار (كرمة متوسطية ذات ثمار مستطيلة تطرد بذورها وعصيرها بعنف عند النضج عند لمسها) / بلسم البرتقال, قرط السيدة (نبات حولي في أمريكا الشمالية بأزهار صفراء أو برتقالية عادة؛ ينمو بشكل رئيسي في التربة الرطبة والحمضية نوعاً ما)",
 "touch-typist": "طابع باللمس (طابع ماهر يمكنه طباعة وثيقة دون النظر إلى لوحة المفاتيح)",
 "touchable": "محسوس, ملموس (يمكن إدراكه بالحواس وخاصة حاسة اللمس)\nمثال: جلد ذو خشونة ملموسة",
 "touchback": "تاتش باك, لمسة عودة ((كرة القدم الأمريكية) لعبة يقوم فيها الفريق المنافس بركل الكرة إلى منطقة النهاية الخاصة بك)",
 "touchdown": "تاتش داون, هدف لمس الأرض (تسجيل في كرة القدم الأمريكية؛ بامتلاك الكرة عبر خط مرمى الخصم) / ملامسة الأرض, هبوط (هبوط (عندما تلمس العجلات مدرج الهبوط)؛ خاصة للطائرات)",
 "touched": "متأثر, منفعل (في حالة انفعال أو استثارة للتعبير عن عاطفة) / ملموس, ممسوس (حدث بينه وبين شيء آخر تلامس)\nمثال: متأثر جداً لدرجة عدم القدرة على الكلام",
 "toucher": "لَامِس (شخص يجعل جزءاً من جسده يلامس شخصاً أو شيئاً ما أو يسمح بذلك)",
 "touchily": "بحساسية زائدة, بسرعة تأثر (بطريقة حساسة)\nمثال: رفض بحساسية زائدة كل عروض المساعدة",
 "touchiness": "حدة طبع, نزق (الشعور بسهولة التهيج)",
 "touching": "مُؤَثِّر / لَمْس (اتصل بشيء أو شخص بشكل مباشر بواسطة جزء من الجسم مثل اليد، التواصل الحسي أو المعنوي مع شيء ما؛ يدل على التواصل، سواء كان ماديًا أو معنويًا، مع شيء ما)\nمثال: إياك ولمس شطيرتي!",
 "touchingly": "بشكل مؤثر, بشكل يلامس المشاعر (بطريقة مؤثرة أو تلامس المشاعر)\nمثال: تحدثت بشكل مؤثر",
 "touchline": "خط التماس (أي من الخطوط الجانبية في كرة القدم أو الرجبي)",
 "touchscreen": "شاشة لمس (شاشة كمبيوتر تمكن المستخدم من التفاعل مع الكمبيوتر عن طريق لمس مناطق على الشاشة)",
 "touchstone": "مِحَكّ (محك الشّخص:أكثر من الجدل بالباطل ، لَجَّ في المنازعة؛ محَكَ ، يَمْحَكُ مَحْكًا: لَجَّ فِي الأَمْرِ، وقِيلَ:المَحْكُ: التَّمادِي فِي اللَّجاجَةِ عِنْد المُساوَمَةِ والغَضَب ونَحْوِ ذَلِك)\nمثال: مستقبلنا على المحك.",
 "touchwood": "صوفان, قشاشة (مادة لبدء إشعال النار)",
 "touchy": "حَسَّاس, دَقِيق (صَعْب المُعَالَجَة؛ يَسْتَلْزِم لَبَاقَةً كَبِيرَة) / حَسَّاس, سَرِيع الغَضَب (سريع التأثّر والانزعاج من أيّ إساءة)",
 "touchy-feely": "حَمِيمِيّ, عَاطِفِيّ ((غالباً ازدرائي) يُعبِّر عن الحب والعاطفة علانية خاصة عبر التلامس الجسدي)",
 "touché": "مَلْمُوس",
 "tough": "مُتَوَعِّك, مُتْعَب (يشعر بعدم الراحة الجسدية أو الألم) / صَلْب, مَتِين (مَصْنُوعٌ أَوْ مَبْنِيٌّ بِمَتَانَةٍ وَصَلَابَة) / عَوِيص, مُحَيِّر (يَفْرِض مُتَطَلَّبَات ذِهْنِيَّة كَبِيرَة؛ صَعْب الفَهْم أَوِ الحَلّ) / شَرِس, قَاسٍ (بَالِغ الصُّعُوبَة؛ يَخْتَبِر القُدْرَة عَلَى التَّحَمُّل بِشِدَّة)",
 "tough guy": "بلطجي, رجل قوي (رجل يتنمر على الأشخاص الأضعف)",
 "tough luck": "سوء الحظ, مصيبة (حالة مؤسفة ناتجة عن نتائج غير مواتية)",
 "tough-minded": "غَيْرُ عَاطِفِيّ, وَاقِعِيّ (يواجه الحقائق أو الصعوبات بواقعية وعزيمة)",
 "tough-skinned": "غَلِيظ الجِلْد, لَا يُبَالِي بِالنَّقْد (غير حسّاس للنقد والانتقاد) / سَمِيك القِشْرَة (ذو غلاف خارجي صلب نسبيًّا)",
 "toughened": "مُصلّد, مُعالَج (ما جُعل صلباً أو مرناً أو مقاوماً خاصةً عن طريق المعالجة الحرارية) / خشن, متصلب (متصلب جسدياً)\nمثال: سيف من الفولاذ المصلد (المقسى)",
 "toughie": "سُؤَال مُحَيِّر, مُعْضِلَة (سؤال أو مشكلة صعبة أو محيرة بشكل خاص) / بلطجي, سفاح (مجرم شاب عدواني وعنيف)",
 "toughly": "بشدة, بصرامة (بطريقة صارمة وقوية)\nمثال: سرد قصصي قوي وصارم",
 "toughness": "شدة, صعوبة هائلة (صعوبة مثيرة للإعجاب) / صلابة, متانة (مرونة وصلابة جسم معدني؛ قدرته على امتصاص طاقة كبيرة قبل التشقق) / خشونة, قوة (خاصية كون الشخص كبيراً وقوياً) / جلد, قوة احتمال (قوة وطاقة دائمة)",
 "toulon": "تولون",
 "toulouse": "تُولُوز, طُلُوشَة",
 "toupe": "باروكة صغيرة, شعر مستعار جزئي (قطعة شعر صغيرة لتغطية الصلع الجزئي)",
 "toupee": "باروكة صغيرة, شعر مستعار جزئي (قطعة شعر صغيرة لتغطية الصلع الجزئي)",
 "toupeed": "مُرْتَدٍ شَعْرًا مُسْتَعَارًا (يرتدي قطعة شعر مستعارة صغيرة لتغطية صلع جزئيّ)",
 "tour": "رِحْلَة / جَوْلَة",
 "tour de force": "إنجاز فذ, عمل إعجازي (مأثرة بارعة أو عبقرية)",
 "tour de france": "طَوَاف فَرَنْسَا",
 "tour guide": "مُرْشِد, مُرْشِد سِيَاحِيّ (المُرْشِد : من يقوم بدور التَّوجيه والإرشاد؛ من يُساعد السُّفن بتعليماته لاجتياز القنوات أو للإرساء في المرافئ)\nمثال: كيف استطيع الحصول على مرشد سياحي.",
 "tour of duty": "فترة تجنيد, فترة خدمة (فترة زمنية تقضى في الخدمة العسكرية)",
 "tour operator": "مُنَظِّم رِحْلَات, مُنَظِّم الرِّحْلَات",
 "touraco": "توراكو (طائر أفريقي كبير ذو عرف زاهي الألوان)",
 "tourer": "سيارة سياحية (سيارة مفتوحة كبيرة تتسع لأربعة أشخاص مع سقف قابل للطي) / سائح (شخص يسافر للمتعة)",
 "tourette's syndrome": "متلازمة توريت (اضطراب عصبي يتميز بتكشيرات الوجه وتشنجات لا إرادية وحركات في الجزء العلوي من الجسم وهمهمات وصراخ وبذاءة)",
 "touring car": "سيارة سياحية (سيارة مفتوحة كبيرة تتسع لأربعة أشخاص مع سقف قابل للطي)",
 "touring ski": "زلاجة تجوال (نوع من الزلاجات مع مثبت خاص يسمح للمتزلج بتحرير كعب الحذاء وتثبيت مقدمته عند الصعود، وتثبيت الاثنين عند النزول)",
 "tourism": "سِيَّاحَة",
 "tourist": "سَائِح, سَائِحَة",
 "tourist attraction": "معلم سياحي, منطقة جذب سياحي (خاصية تجذب السياح)",
 "tourist class": "درجة سياحية (أماكن إقامة غير مكلفة على متن سفينة أو قطار)",
 "tourist court": "موتيل, نزل للسيارات (فندق لسائقي السيارات؛ يوفر وصولاً مباشراً من الغرف إلى منطقة وقوف السيارات)",
 "tourist tax": "ضريبة سياحية (ضريبة تفرضها بلديات أو مناطق معينة، يدفعها الزوار الذين يقيمون في مساكن سياحية لأكثر من 24 ساعة)",
 "touristed": "سِيَاحِيّ, مُكْتَظّ بِالسُّيَّاح (يزوره أعداد كبيرة من السياح)",
 "touristry": "سياحة (عمل توفير الخدمات للسياح)\nمثال: السياحة عمل تجاري رئيسي في برمودا",
 "touristy": "سِيَاحِيّ, مُكْتَظّ بِالسُّيَّاح (يزوره أعداد كبيرة من السياح)",
 "tourmaline": "تورمالين (معدن معقد من البوروسيليكات وهيدروكسيد الألمنيوم يحتوي على الحديد والمغنيسيوم والكالسيوم والليثيوم والصوديوم؛ يوجد عادة باللون الأسود ولكن يوجد في…)",
 "tournament": "بطولة, دورة (منافسة رياضية يلعب فيها المتسابقون سلسلة من الألعاب لتحديد الفائز) / بطولة مبارزة, مبارزة (سلسلة من المبارزات بين الفرسان للتنافس على جائزة)",
 "tournedos": "تورنيدو (شريحة لحم سميكة مقطوعة من التندرلوين البقري)",
 "tourney": "بطولة, دورة (منافسة رياضية يلعب فيها المتسابقون سلسلة من الألعاب لتحديد الفائز)",
 "tourniquet": "عاصِبَة",
 "tours": "تور",
 "tourtiere": "فطيرة اللحم الكندية (فطيرة لحم تؤكل عادة في عيد الميلاد في كيبيك)",
 "tousled": "أَشْعَث, مُنَكَّش (فِي حَالَةِ فَوْضَى شَدِيدَة)",
 "tout": "مُخبر المراهنات (شخص يبيع النصائح حول المقامرة أو المضاربة (خاصة في سباق الخيل)) / دلال, سمسار (شخص يعلن للزبائن بطريقة وقحة بشكل خاص) / بائع تذاكر في السوق السوداء (شخص يشتري تذاكر لحدث ما لإعادة بيعها بربح)",
 "tout ensemble": "بشكل عام, في الإجمال (مع أخذ كل شيء في الاعتبار) / المجمل, المظهر العام (انطباع كلي أو تأثير لشيء يتكون من أجزاء فردية) / طاقم, فرقة (تجميع لأجزاء أو تفاصيل (كما في عمل فني) تُعتبر كأنها تشكل كلاً واحداً)\nمثال: في الإجمال، أنا آسف لما حدث",
 "touter": "دلال, سمسار (شخص يعلن للزبائن بطريقة وقحة بشكل خاص)",
 "tovarich": "رفيق (رفيق (خاصة في الشيوعية الروسية))",
 "tovarisch": "رفيق (رفيق (خاصة في الشيوعية الروسية))",
 "tovarish": "تَاوَارِيش",
 "tow": "سحب, قطر (فعل سحب شيء (مثل مركبة) بواسطة حبل أو مشبك)\nمثال: سحبته الشاحنة إلى المرآب",
 "tow car": "شاحنة قطر, ونش سحب (شاحنة مجهزة لرفع وسحب السيارات المحطمة (أو لإزالة السيارات من مناطق ممنوع الوقوف))",
 "tow truck": "شاحنة قطر, ونش سحب (شاحنة مجهزة لرفع وسحب السيارات المحطمة (أو لإزالة السيارات من مناطق ممنوع الوقوف))",
 "tow-headed snake": "أصلة مطاطية (أصلة تعيش في المراعي والغابات في غرب أمريكا الشمالية؛ تبدو وتشعر وكأنها مطاطية ولها ذيل ورأس متشابهان في الشكل)",
 "towage": "سحب, قطر (فعل سحب شيء (مثل مركبة) بواسطة حبل أو مشبك)\nمثال: سحبته الشاحنة إلى المرآب",
