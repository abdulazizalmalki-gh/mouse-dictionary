 "tilia americana": "زيزفون أمريكي (شجرة ظل أمريكية كبيرة بأوراق خضراء داكنة كبيرة وتاج مستدير)",
 "tilia cordata": "زيزفون صغير الأوراق (زيزفون أوروبي كبير الانتشار بأوراق خضراء داكنة صغيرة؛ يُزرع غالباً للزينة)",
 "tilia heterophylla": "زيزفون أبيض (زيزفون أمريكي من منطقة أليغني)",
 "tilia japonica": "زيزفون ياباني (شجرة متوسطة الحجم من اليابان تستخدم للزينة)",
 "tilia tomentosa": "زيزفون فضي (شجرة كبيرة موطنها شرق أوروبا وآسيا الصغرى لها أوراق بزغب أبيض على الجانب السفلي؛ تُزرع على نطاق واسع للزينة)",
 "tiling": "تبليط (وضع البلاط لتغطية سطح)",
 "till": "حَتَّى, إِلَى أَنّ (يفيد انتهاء الغاية؛ يفيد الغاية) / حَرَثَ (حرث الأرض: شقها بالمحراث ليزرعها؛ حرث النار: حركها وأثارها)\nمثال: انتظر حتى أجلس.",
 "till death do us part": "حَتَّى الْمَوْت عَلَيْنَا الْجُزْء (يفيد انتهاء الغاية؛ يفيد الغاية)\nمثال: انتظر حتى أجلس.",
 "till now": "بعد, حتى الآن (تستخدم في الجمل المنفية لوصف موقف كان قائماً حتى هذه النقطة أو حتى الوقت الحاضر)\nمثال: حتى الآن لم يتصل",
 "tillable": "صَالِح لِلزِّرَاعَة, قَابِل لِلْحَرْث ((عن الأراضي الزراعية) قابل للزراعة المنتجة)",
 "tillage": "حراثة (زراعة التربة لتربية المحاصيل) / أرض زراعية, أرض محروثة (أرض صالحة للزراعة يتم حرثها وزرعها وإنتاج المحاصيل منها)",
 "tillandsia usneoides": "طحلب إسباني, لحية العجوز (أكاليل كثيفة من خيوط مرنة تشبه الشعر بلون رمادي مخضر مثبتة بجذوع الأشجار وفروعها بواسطة جذور سلكية متفرقة؛ جنوب شرق الولايات المتحدة وجزر الهند…)",
 "tilled": "مَفْلُوح, مُعَزَّق (قُلبت تربته بالحرث أو التمشيط أو العزق)",
 "tilled land": "أرض زراعية, أرض محروثة (أرض صالحة للزراعة يتم حرثها وزرعها وإنتاج المحاصيل منها)",
 "tiller": "زَارِع",
 "tilletia caries": "تفحم نتن, تيليتيا كاريس (فطر يدمر حبات القمح عن طريق استبدالها بكتل دهنية من الأبواغ كريهة الرائحة)",
 "tilletia foetida": "تفحم نتن, تيليتيا فوئتيدا (مشابه لتيليتيا كاريس)",
 "tilling": "حرث (زراعة الأرض من أجل تربية المحاصيل)",
 "tilt": "تأرجح, تمايل (الترنح بشكل خطير إلى جانب واحد) / اِنْحِنَاء, مَيَلَان (الخاصية التي يمتلكها خط أو سطح ينحرف عن الوضع العمودي) / انحياز طفيف, ميل (تحيز طفيف ولكنه ملحوظ) / جدل, سجال (فعل كلامي جدلي؛ نزاع حيث يوجد اختلاف قوي في الرأي)\nمثال: كان للبرج ميل واضح",
 "tilt angle": "زاوية الإمالة (الزاوية التي يصنعها الصاروخ مع الخط العمودي أثناء انحنائه على طول مساره)",
 "tilt barrier": "حاجز المبارزة (حاجز خشبي أو سياج يستخدم في المبارزة بالرماح لمنع الاصطدامات والحفاظ على المتنافسين في زاوية مثالية لكسر الرمح)",
 "tilt-top table": "طاولة ذات سطح قلاب (طاولة ذات قاعدة مركزية وسطح مفصلي بحيث يمكن إمالته إلى وضع عمودي)",
 "tilted": "مَائِل, مُنْحَرِف (يبتعد أو يُجعَل يبتعد عن العمود الحقيقيّ أو الأفق)",
 "tilter": "أداة إمالة (جهاز لتفريغ برميل عن طريق إمالته دون تعكير الرواسب) / مبارز",
 "tilth": "أرض زراعية, أرض محروثة (أرض صالحة للزراعة يتم حرثها وزرعها وإنتاج المحاصيل منها) / تهيئة التربة, حالة التربة (حالة تجمّع التربة وحالتها من حيث ملائمتها لنمو النبات)",
 "tilting board": "أرجوحة التوازن, سيسو (لعبة تتكون من لوح متوازن على نقطة ارتكاز؛ يركبه الأطفال صعوداً وهبوطاً عند كلا الطرفين)",
 "tiltyard": "ساحة المبارزة ((سابقاً) حقل مسيج لمسابقات المبارزة بالرماح)",
 "timbale": "تمبال (قشرة معجنات صغيرة لخلطات كريمية من الأطعمة المفرومة) / تيمبال (حصة فردية من اللحم المفروم أو السمك في صلصة كريمية غنية مخبوزة في قالب معجنات صغير أو قشرة تيمبال)",
 "timbale case": "تمبال (قشرة معجنات صغيرة لخلطات كريمية من الأطعمة المفرومة)",
 "timber": "خَشَب (هو ما غَلَظَ وصَلُبَ من أصول الشَجَر وفروعها مثل الجِذْع والأغْصَان؛ هو ما صنع من جذوع أو أغصان الشَجَر) / خَشَب!\nمثال: نحن نقطع الخشب.",
 "timber hitch": "عقدة الحطاب (عقدة تستخدم لتثبيت حبل بجذع أو عارضة؛ وغالباً ما تدعم بعقدة نصفية)",
 "timber line": "خط الأشجار (الخط الذي يمثل الحد الأعلى لنمو الأشجار في الجبال أو خطوط العرض الشمالية)",
 "timber rattlesnake": "أفعى جرسية خشبية (واسعة الانتشار في الأراضي الوعرة بشرق الولايات المتحدة)",
 "timber tree": "شجرة خشب (أي شجرة ذات قيمة كمصدر للأخشاب)",
 "timber wolf": "ذئب الغياض, ذئب رمادي (ذئب ذو معطف رمادي مبقع يعيش في المناطق الشمالية المشجرة في أمريكا الشمالية)",
 "timber-framed": "ذُو إِطَارٍ خَشَبِيّ (مُؤَطَّرٌ بِأَخْشَابٍ مَكْشُوفَة)",
 "timbered": "خشبي, مبني بالأخشاب (مزود بـ أو مصنوع من الخشب أو الأخشاب) / ذُو أَخْشَابٍ, مُحَرَّج (مُغَطَّى بِالأَخْشَابِ النَّامِيَةِ)\nمثال: جدران خشبية",
 "timberland": "أحراج, غابة (أرض مغطاة بالأشجار والشجيرات)",
 "timberline": "خط الأشجار (الخط الذي يمثل الحد الأعلى لنمو الأشجار في الجبال أو خطوط العرض الشمالية)",
 "timberman": "تاجر أخشاب (مالك أو مدير ذكر لشركة تعمل في قطع الأشجار)",
 "timbre": "جرس الصوت, خامة الصوت ((موسيقى) الخاصية المميزة لصوت مركب (صوت بشري أو ضجيج أو صوت موسيقي))\nمثال: كان جرس صوت السوبرانو الخاص بها غنياً وجميلاً",
 "timbrel": "دف صغير, طبلة يدوية (طبل يدوي صغير يشبه الدف؛ كان يحمله المهرجون المتجولون قديماً)",
 "timbuktu": "طَفْرَاوَى",
 "time": "وَقْت (\"بَقِيَ وَقْتاً عِنْدَهُ \" : أَيْ مِقْدَاراً مِنَ الزَّمَنِ؛ \"جَاءَ فِي الوَقْتِ الْمُنَاسِبِ \" : فِي اللَّحْظَةِ الْمُنَاسِبَةِ) / مَرَّة, مرة (مؤنث مُرّ، صفة ما كان بها مرارة) / حِين, وَقْت ((حَيَّنَه): جعل لَهُ حينا؛ (حَيَّنَ) الله فلَانا: لم يوفقه للرشاد)\nمثال: حان وقت الذهاب.",
 "time after time": "طورا بعد طور",
 "time and a half": "أجر الوقت ونصف (معدل أجر يبلغ 1.5 مرة المعدل العادي؛ للعمل الإضافي)",
 "time and again": "مِرَارًا وَتِكْرَارًا",
 "time and motion study": "دراسة الوقت والحركة (تحليل لوظيفة معينة في محاولة لإيجاد الطريقة الأكثر كفاءة من حيث الوقت والجهد)",
 "time and time again": "مراراً وتكراراً (بشكل متكرر)\nمثال: ظهرت الكلمة غير المعروفة مراراً وتكراراً",
 "time being": "وقت راهن (المناسبة الحالية)\nمثال: للوقت الراهن",
 "time bill": "سفتجة لأجل, كمبيالة مؤجلة الدفع (كمبيالة تدفع في تاريخ مستقبلي محدد)",
 "time bomb": "قُنْبُلَةٌ مَوْقُوتَةٌ",
 "time capsule": "كپسول زمان",
 "time clock": "ساعة تسجيل الدوام (ساعة تستخدم لتسجيل ساعات عمل الموظفين)",
 "time complexity": "تَعْقِيد زَمَنِيّ",
 "time constant": "ثَابِت الزَّمَن (نسبة محاثة الدائرة بالهنري إلى مقاومتها بالأوم) / ثابت الزمن ((إلكترونيات) الوقت اللازم للتيار أو الجهد في دائرة للارتفاع أو الانخفاض أسيًا بحوالي 63 في المائة من سعته)",
 "time deposit": "وديعة لأجل (شهادة إيداع لا يمكن السحب منها إلا بعد إشعار مسبق أو في تاريخ مستقبلي محدد)",
 "time deposit account": "حساب وديعة, حساب وديعة لأجل (حساب توفير يتم الاحتفاظ فيه بالوديعة لمدة محددة أو لا يمكن إجراء عمليات السحب إلا بعد إعطاء إشعار أو مع خسارة الفائدة)",
 "time difference": "فَارِق اَلتَّوْقِيت",
 "time draft": "سفتجة لأجل, كمبيالة مؤجلة الدفع (كمبيالة تدفع في تاريخ مستقبلي محدد)",
 "time exposure": "تعريض زمني (تعريض الفيلم لفترة طويلة نسبيًا (أكثر من نصف ثانية)) / تعريض زمني, صورة بتعريض طويل (صورة منتجة بوقت تعريض طويل نسبياً)",
 "time flies": "الْوَقْتُ يَمْضِي",
 "time frame": "إطار زمني, مدى زمني (فترة زمنية يحدث خلالها شيء ما أو يتوقع حدوثه)\nمثال: يمكن التوصل إلى اتفاق في إطار زمني قصير معقول",
 "time heals all wounds": "الزَّمَن يُعَالِجُ كُل الأَجْرَاح",
 "time immemorial": "زمن سحيق, قديم الزمان (الماضي البعيد وراء الذاكرة)",
 "time interval": "فاصل زمني, فترة (طول زمني محدد بين لحظتين)",
 "time is money": "اَلْوَقْتُ مِنْ ذَهَبٍ",
 "time lag": "انتظار, تأجيل (الوقت الذي يتم فيه انتظار إجراء ما)\nمثال: تسببت الإعادة الفورية في تأخير طويل جداً",
 "time limit": "حد زمني, مهلة (فترة زمنية يجب خلالها إنجاز شيء ما أو إكماله)",
 "time loan": "قرض لأجل, قرض مؤجل (قرض واجب السداد في تاريخ محدد أو قبله)",
 "time machine": "آلَةُ زَمَن (الفارسية: ماشين؛ الأوردية: مشين)\nمثال: نسى زيري الآلة.",
 "time management": "الوقَة",
 "time note": "سند مؤجل (سند يحدد وقت (أو أوقات) السداد)",
 "time of arrival": "وقت الوصول (الوقت المقرر لوصول وسيلة نقل عامة إلى وجهة معينة)",
 "time of day": "ساعة, وقت من اليوم (التوقيت بحسب الساعة)\nمثال: تأخرت الساعة",
 "time of departure": "وقت المغادرة (الوقت المقرر لمغادرة وسيلة نقل عامة من نقطة انطلاق معينة)",
 "time of life": "فترة من الحياة, مرحلة عمرية (فترة زمنية يكون فيها الشخص عادة في حالة حياتية معينة)",
 "time of origin": "زمن المنشأ, عتق (قدم النبيذ)",
 "time of year": "فصل, موسم (إحدى الفترات الطبيعية التي تنقسم إليها السنة)\nمثال: التتابع المنتظم للفصول",
 "time off": "إجازة, وقت راحة (فترة زمنية لا يُطلب منك العمل فيها)\nمثال: طلب إجازة لحضور جنازة جدته",
 "time out": "استراحة, فترة راحة (توقف مؤقت عن فعل شيء ما (كالعمل))\nمثال: أخذنا استراحة لمدة 10 دقائق",
 "time out of mind": "زمن سحيق, قديم الزمان (الماضي البعيد وراء الذاكرة)",
 "time period": "مُدَّة زَمَنِيَّة",
 "time plan": "خطة تقسيط, شراء بالتقسيط (نظام لدفع ثمن البضائع على أقساط)",
 "time scale": "مقياس زمني (ترتيب للأحداث يُستخدم كمقياس للمدة)\nمثال: على المقياس الزمني الجيولوجي، وجد البشر للحظة وجيزة فقط",
 "time series": "سلسلة زمنية (سلسلة من قيم متغير في أوقات متتالية)",
 "time sharing": "مُشَارَكَة الزَّمَن ((علم الحاسوب) استخدام كمبيوتر مركزي من قبل العديد من المستخدمين في وقت واحد)",
 "time sheet": "سجل الدوام, ورقة الحضور (سجل لساعات العمل التي قضاها الموظفون)",
 "time signal": "إشارة الوقت (إشارة (خاصة إلكترونية أو لاسلكية) تشير إلى الوقت الصحيح بدقة)",
 "time signature": "الميزان الموسيقي, توقيع الوقت (تدوين موسيقي يشير إلى عدد النبضات في المقياس ونوع النوتة التي تأخذ نبضة)",
 "time slot": "فترة زمنية, فسحة زمنية (وقت مخصص في جدول أو أجندة)\nمثال: البرنامج التلفزيوني لديه موعد بث جديد",
 "time study": "دراسة الوقت والحركة (تحليل لوظيفة معينة في محاولة لإيجاد الطريقة الأكثر كفاءة من حيث الوقت والجهد)",
 "time to come": "مستقبل (الزمن الذي لم يأت بعد)",
 "time unit": "وحدة زمنية (وحدة لقياس الفترات الزمنية)",
 "time value": "قيمة النغمة, قيمة زمنية ((موسيقى) المدة النسبية لنغمة موسيقية)",
 "time zone": "مِنْطَقَة زَمَنِيَّة (المِنْطَقةُ: المَنْطِقَةُ؛ مِنْطَقَةُ: مُقَاطَعَةٌ)\nمثال: غزة منطقة مكشوفة.",
 "time-and-motion study": "دراسة الوقت والحركة (تحليل لوظيفة معينة في محاولة لإيجاد الطريقة الأكثر كفاءة من حيث الوقت والجهد)",
 "time-ball": "كرة الوقت (كرة تنزلق لأسفل عمود لإظهار وقت محدد؛ خاصة في المراصد)",
 "time-consuming": "مُسْتَغْرِق وَقْتًا طَوِيلًا",
 "time-delay measuring instrument": "كرونوسكوب, مقياس التأخير الزمني (مقياس زمن (كرونوسكوب) لقياس الفرق الزمني بين حدثين)",
 "time-delay measuring system": "كرونوسكوب, مقياس التأخير الزمني (مقياس زمن (كرونوسكوب) لقياس الفرق الزمني بين حدثين)",
 "time-fuse": "فتيل التوقيت (فتيل مصنوع ليحترق لفترة زمنية محددة (خاصة لتفجير قنبلة))",
 "time-honored": "عَرِيق, مُوَقَّر بِالقِدَم (محترم بسبب القِدَم أو طول الاستخدام) / عَرِيقٌ, مُتَوَارَثٌ (مقبول منذ زمن طويل أو ذو تاريخ عريق)",
 "time-honoured": "عَرِيق, مُوَقَّر بِالقِدَم (محترم بسبب القِدَم أو طول الاستخدام) / عَرِيقٌ, مُتَوَارَثٌ (مقبول منذ زمن طويل أو ذو تاريخ عريق)",
 "time-lapse": "تايم لابس",
 "time-motion study": "دراسة الوقت والحركة (تحليل لوظيفة معينة في محاولة لإيجاد الطريقة الأكثر كفاءة من حيث الوقت والجهد)",
 "time-out": "وَقْت مُسْتَقْطَع (\"بَقِيَ وَقْتاً عِنْدَهُ \" : أَيْ مِقْدَاراً مِنَ الزَّمَنِ؛ \"جَاءَ فِي الوَقْتِ الْمُنَاسِبِ \" : فِي اللَّحْظَةِ الْمُنَاسِبَةِ)\nمثال: حان وقت الذهاب.",
 "time-release": "تدريجي الإطلاق, ممتد المفعول (متعلق بمستحضر يطلق مادة فعالة (خاصة دواء) تدريجياً خلال فترة زمنية)",
 "time-scale factor": "عَامِل القِيَاس الزَّمَنِيّ (نسبة وقت المحاكاة إلى وقت العملية الحقيقية)",
 "time-switch": "مفتاح مؤقت (مفتاح مضبوط للعمل في وقت مرغوب)",
 "time-tested": "مُجَرَّب, مُخْتَبَر (تَمَّ اخْتِبَارُهُ وَثَبَتَتْ مَوْثُوقِيَّتُهُ)",
 "timecard": "بطاقة دوام (بطاقة تستخدم مع ساعة دوام لتسجيل أوقات بدء وانتهاء عمل الموظف كل يوم) / بطاقة دوام (بطاقة تسجل أوقات بدء وانتهاء عمل الموظف كل يوم عمل)",
 "timed": "مَوْقُوتٌ, مُؤَقَّتٌ (مُوَزَّع بانتظام على فترات زمنية)",
 "timekeeper": "أداة توقيت, ساعة (أداة قياس أو جهاز لحفظ الوقت) / مراقب الدوام, مسجل الوقت (كاتب يتتبع ساعات عمل الموظفين) / ميقاتي ((رياضة) مسؤول يتتبع الوقت المنقضي)",
 "timekeeping": "توقيت, ضبط الوقت (فعل أو عملية تحديد الوقت)",
 "timeless": "أَبَدِيّ, خَالِد (لا يتأثّر بمرور الزمن)",
 "timeless existence": "أبدية, خلود (حالة الوجود الأبدي التي يعتقد في بعض الأديان أنها تميز الحياة الآخرة)",
 "timelessness": "أبدية, خلود (حالة الوجود الأبدي التي يعتقد في بعض الأديان أنها تميز الحياة الآخرة) / أَزَلِيَّة, لَا زَمَنِيَّة (خاصية عدم التقيد بوقت أو تاريخ معين)",
 "timeline": "جدول زمني, خط زمني (تسلسل لأحداث مترابطة مرتبة زمنياً ومعروضة على طول خط (عادة ما يُرسم من اليسار إلى اليمين أو من الأعلى إلى الأسفل))",
 "timeliness": "تَوْقِيت مُنَاسِب, مُوَاتَاة (الملاءمة الزمنية) / توقيت مناسب, مناسبة الوقت (الكون في الوقت المناسب)",
 "timely": "فِي الوَقْت المُنَاسِب (في وقت ملائم) / فِي أَوَانِه, فِي الوَقْت المُنَاسِب (يحدث أو يتم في الوقت الملائم أو المناسب) / فِي الوَقْتِ المُنَاسِب (قبل انتهاء المهلة الزمنية المحدّدة)\nمثال: وصلت رسالتك في الوقت المناسب",
 "timepiece": "أداة توقيت, ساعة (أداة قياس أو جهاز لحفظ الوقت)",
 "times": "فِي (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "times sign": "علامة الضرب, نقطة الضرب (علامة تشير إلى عملية الضرب)",
 "times square": "مَيْدَان اَلتَّايْمْز",
 "timeserver": "اِنْتِهازِيّ",
 "timeserving": "انْتِهَازِيّ, وُصُولِيّ (ينتهز الفرصة فوراً وبشكل غير أخلاقي في كثير من الأحيان)",
 "timestamp": "خَتَم زَمَنِيّ, طَابَع زَمَنِيّ (أنهى الشيءَ وأتمّه؛ طبع بخاتم أو ختم رسميّ)\nمثال: ختم سامي القرآن في شهر رمضان.",
 "timetable": "جَدْوَل مَوَاعِيد, جَدْوَل",
 "timework": "عمل بالوقت (عمل يدفع مقابله بمعدل لكل وحدة زمنية)",
 "timeworn": "مُبْتَذَل, مُسْتَهْلَك (مُكرَّر أكثر من اللازم؛ مألوف بشكل مفرط بسبب كثرة الاستخدام)",
 "timid": "جَبَان (شديد الخوف ممتنع عن الإقدام؛ ضد الشجاع)\nمثال: إيدير مجرد جبان.",
 "timidity": "تهيب, جبن (الخوف عند الخوض في أماكن أو أنشطة جديدة ومجهولة) / جبن, خجل (الخوف من المجهول أو غير المألوف أو الخوف من اتخاذ القرارات)",
 "timidly": "بِاسْتِحْيَاء, بِخَجَل (بطريقة تتسم بالخجل أو التردد)\nمثال: ابتسم بخجل",
 "timidness": "خَجَل (كلمة \"خَجِلَ\" تتراوح معانيها بين الحرج الشخصي والتأثر بالحمل أو البيئة، وتُستخدم في العديد من السياقات التي تعبر عن الاستحياء أو الحيرة؛ شعر بالخجل أو الحياء نتيجة لموقف محرج أو بسبب تصرف غير لائق)\nمثال: توم لص بلا خجل.",
 "timing": "تَوْقِيت (وقّتَ اللهُ الصّلاة : حدّد لها وقتاً ، يُقال :وقّته-(يقِته)وقْتاً:جعل له وقتاً يُفعل فيه؛ تَحْدِيدُ الأَوْقَاتِ ، كالتَّوْقِيتِ تَقول:وَقَّتُّه لِيَوْمِ كَذَا، مثل أَجَّلْتُه)\nمثال: هل ساعتك على التوقيت الصحيح؟",
 "timolol": "بلوكادرين, تيمولول (حاصر بيتا (الاسم التجاري بلوكادرين) يعطى بعد النوبات القلبية)",
 "timor sea": "بَحْر تِيمُوْر (شَقّ الأرض؛ التَحَيُّر والبَهْت من الفزع أو من شدة العَطَش فنظر لا يقصد شيئا)\nمثال: هبطت على البحر.",
 "timorese": "تيموري (متعلق بتيمور أو سكانها أو خصائصها) / تيموري (مواطن أو ساكن في تيمور)",
 "timorous": "هَيُوب, وَجِل (خجول بطبعه أو يُظهر الخجل والوجل)",
 "timorously": "بتهيب, بوجل (بطريقة خائفة ومترددة)",
 "timorousness": "تهيب, جبن (الخوف عند الخوض في أماكن أو أنشطة جديدة ومجهولة) / جبن, خجل (الخوف من المجهول أو غير المألوف أو الخوف من اتخاذ القرارات)",
 "timothy": "تِيمُوثَاوُس",
 "timpani": "تيمباني, طبلة نحاسية (آلة إيقاعية نحاسية أو نحاسية كبيرة نصف كروية ذات رأس طبل يمكن ضبطه عن طريق تعديل الشد عليه)",
 "timpanist": "عازف التمباني (شخص يعزف على الطبول النحاسية (التمباني))",
 "timucu": "تيموكو (توجد في المياه الدافئة لغرب المحيط الأطلسي)",
 "tin": "صَفِيحَة, علبة",
 "tin can": "عُبُوَّةُ الصَّفِيح, عُلْبَةُ الصَّفِيح",
 "tin disease": "طاعون القصدير, مرض القصدير (تحول القصدير الأبيض العادي إلى مسحوق القصدير الرمادي في درجات الحرارة المنخفضة جداً)",
 "tin ear": "افْتِقَار لِلذَّوْق الفَنِّيّ, تَبَلُّد سَمْعِيّ (عدم الإحساس بمدى ملائمة اللغة أو دقتها) / صمم النغمات (عدم القدرة على تمييز الاختلافات في طبقة الصوت)\nمثال: لديه تبلد سمعي تجاه الحوار",
 "tin foil": "رقائق الألومنيوم, قصدير (رقائق مصنوعة من الألومنيوم) / رقائق القصدير, ورق القصدير (رقائق مصنوعة من القصدير أو سبيكة من القصدير والرصاص)",
 "tin hat": "خوذة أمان, خوذة صلبة (خوذة واقية خفيفة الوزن (بلاستيكية أو معدنية) يرتديها عمال البناء)",
 "tin opener": "فتاحة علب (جهاز لفتح العلب)",
 "tin pan alley": "تين بان ألي (حي في المدينة (أصلاً في نيويورك) حيث يمارس ملحنو وناشرو الموسيقى الشعبية أعمالهم)",
 "tin pest": "طاعون القصدير, مرض القصدير (تحول القصدير الأبيض العادي إلى مسحوق القصدير الرمادي في درجات الحرارة المنخفضة جداً)",
 "tin plague": "طاعون القصدير, مرض القصدير (تحول القصدير الأبيض العادي إلى مسحوق القصدير الرمادي في درجات الحرارة المنخفضة جداً)",
 "tin plate": "صاج مقصدر, صفيح (ورقة رقيقة من المعدن (الحديد أو الصلب) مطلية بالقصدير لمنع الصدأ؛ تستخدم خاصة للعلب والأواني)",
 "tin pyrites": "بايريت القصدير, ستانيت (معدن رمادي غامق بلمعان معدني يعد مصدراً للقصدير)",
 "tin whistle": "صافرة معدنية, مزمار القصدير (مزمار رخيص الثمن)",
 "tin-plating": "طلاء بالقصدير, قصدرة (وضع طبقة واقية من القصدير)",
 "tinamou": "تنام (طائر صيد ثقيل الجسم صغير الجناحين من أمريكا الجنوبية يشبه الطيور الدجاجية ولكنه قريب من الطيور المسطحة الصدر)",
 "tinca tinca": "تنش (سمكة صيد تشبه الديس تعيش في المياه العذبة في أوروبا وغرب آسيا وتشتهر بقدرتها على البقاء خارج الماء)",
 "tincture": "صبغة ((علم الأدوية) دواء يتكون من مستخلص في محلول كحولي) / درجة لونية, صبغة (جودة لون معين تختلف قليلاً عن لون آخر) / أثر, بقية (دلالة على أن شيئاً ما كان موجوداً) / صبغة, محلول صبغي (مادة تلون أو تصبغ)\nمثال: بعد عدة محاولات، مزج درجة اللون الوردي التي أرادتها",
 "tincture of iodine": "صبغة اليود, يود (صبغة تتكون من محلول اليود في الكحول الإيثيلي؛ تطبق موضعياً على الجروح كمطهر)",
 "tincture of opium": "صبغة الأفيون, لودانوم (مخدر يتكون من محلول كحولي للأفيون أو أي مستحضر يكون الأفيون فيه المكون الرئيسي)",
 "tinder": "وَرْيَة نَار, رِيَّة",
 "tinderbox": "علبة الصوان, علبة القدح (صندوق لحفظ مادة سريعة الاشتعال (الصوفان) لإشعال النار) / برميل بارود, وضع قابل للانفجار (حالة خطيرة؛ وضع يمثل مصدراً محتملاً للعنف)\nمثال: البلقان هي برميل بارود أوروبا",
 "tine": "سن, شعبة (سن في شوكة طعام أو مذراة أو قرن الوعل)",
 "tine harrow": "مسلفة ذات أسنان, مشط مسنن (مشط يستخدم لتحسين حالة مهاد البذور قبل الزراعة، ولإزالة الأعشاب الضارة الصغيرة في المحاصيل النامية وتفتيت التربة بين الصفوف للسماح للماء بالتسرب إلى…)\nمثال: غالباً ما تكون الأمشاط المسننة وذات السلسلة مدعومة فقط بقضيب سحب صلب في مقدمة المجموعة",
 "tine test": "اختبار الوخز المتعدد (اختبار للسل يستخدم فيه قرص بعدة رؤوس تحمل مستضد التوبركولين لثقب الجلد)",
 "tine weeder": "عزاقة ذات أسنان مرنة, مشط مرن (مشط يتكون من أسنان زنبركية دقيقة مثبتة على إطار مرن يتكيف مع التضاريس، يستخدم لإزالة الأعشاب الضارة من المحاصيل)",
 "tinea": "سعفة, قوباء حلقية (عدوى الجلد أو الأظافر تسببها الفطريات وتظهر على شكل بقع دائرية تسبب الحكة)",
 "tinea barbae": "حكة الحلاق, سعفة اللحية (عدوى فطرية في الوجه والرقبة)",
 "tinea capitis": "سعفة الرأس (عدوى فطرية في فروة الرأس تتميز ببقع صلعاء)",
 "tinea corporis": "سعفة الجسد (عدوى فطرية في الأجزاء غير المشعرّة من الجلد)",
 "tinea cruris": "حكة جوك, سعفة الفخذ (عدوى فطرية في الفخذ (الأكثر شيوعاً عند الرجال))",
 "tinea pedis": "سعفة القدم, قدم الرياضي (عدوى فطرية في القدمين)",
 "tinea pellionella": "عثة الملابس صانعة الغمد (تعيش يرقاتها في أنابيب من مادة غذائها مثبتة بالحرير الذي تغزله)",
 "tinea unguium": "سعفة الأظافر (عدوى فطرية في الأظافر (خاصة أظافر القدمين))",
 "tined": "ذُو أَسْنَان, مُشَعَّب (ذُو شُعَبٍ أَوْ أَسْنَان؛ يُسْتَخْدَم عَادَةً فِي التَّرْكِيب)",
 "tineid": "عثة الملابس, عثة تينيد (عثث صفراء صغيرة تتغذى يرقاتها على الصوف أو الفراء)",
 "tineid moth": "عثة الملابس, عثة تينيد (عثث صفراء صغيرة تتغذى يرقاتها على الصوف أو الفراء)",
 "tineoid": "عثة تينويد (عثة صغيرة باهتة اللون ذات أجزاء فم قارضة)",
 "tineoid moth": "عثة تينويد (عثة صغيرة باهتة اللون ذات أجزاء فم قارضة)",
 "tineola bisselliella": "عثة الملابس الناسجة (عثة تشكل شبكة تعيش فيها)",
 "tinfoil": "رقائق القصدير, ورق القصدير (رقائق مصنوعة من القصدير أو سبيكة من القصدير والرصاص)",
 "tinfoil hat": "قُبْعَةِ الْأَلُومِنْيُوم (خرقة تخاطُ كالبُرْنس يلبسها الصِّبيان؛ غطاء للرأس يكون مُخّيَّط على عكس العَمَامَة التي لا يكون فيها خِيَاطَة. قُلُنْسُوَة)\nمثال: لقد اشترى قبعة.",
 "ting": "رنين, طنطنة (صوت معدني واضح خفيف كما لجرس صغير)",
 "tinge": "لون خفي, مسحة (لون شاحب أو هادئ) / ذرة, رشة (كمية طفيفة ولكن محسوسة)\nمثال: هذا الطبق يحتاج لمسة من الثوم",
 "tingle": "وَخَزَ (الطعن بآلة حادة بدون يكون نافذا ولا يكسر الجلد) / نَمِلَ\nمثال: إذا كنت وخز لنا، هل نحن لا ينزف؟",
 "tingling": "دَاغِدِغ, مُوَخِّز (يُثِير بلمسة خفيفة تُسَبِّب الضحك أو الارتعاش) / تنميل, وخز (إحساس جسدي يشبه العديد من اللسعات الصغيرة)",
 "tininess": "تناهي في الصغر, دقة (خاصية الصغر الشديد في الحجم)\nمثال: ومن هنا جاءت دقة التفاصيل في اللوحة",
 "tinker": "ماكريل تشوب (ماكريل صغير يوجد في جميع أنحاء العالم تقريباً) / سمكري متجول (قديماً، شخص (غالباً غجري) يسافر من مكان لآخر لإصلاح الأواني والمقالي وغيرها من الأواني المعدنية كوسيلة لكسب العيش) / عَابِث بِالْآلَات, مُصْلِح هَاوٍ (شخص يستمتع بإصلاح وتجربة الآلات وأجزائها)",
 "tinker's dam": "تَافِه, لَا يُسَاوِي فَلْساً (شيء ذو قيمة قليلة جداً)\nمثال: وعده لا يساوي فلساً",
 "tinker's damn": "تَافِه, لَا يُسَاوِي فَلْساً (شيء ذو قيمة قليلة جداً)\nمثال: وعده لا يساوي فلساً",
 "tinker's root": "جذر الحمى, جنطيانا الحصان (عشب أمريكي معمر خشن ضار بأوراق كبيرة عادة ما تكون محيطة بالساق وأزهار أرجوانية أو حمراء باهتة)",
 "tinkerbell": "تينكربيل",
 "tinkerer": "عَابِث بِالْآلَات, مُصْلِح هَاوٍ (شخص يستمتع بإصلاح وتجربة الآلات وأجزائها) / مُصلّح هاوٍ (شخص غير ماهر يحاول الإصلاح أو الترميم)",
 "tinkle": "رنين, طنطنة (صوت معدني واضح خفيف كما لجرس صغير)",
 "tinkling": "ذُو طَنِين, مُتَرَنِّم (يشبه صوت الرنين القصير العالي لجرس صغير)",
 "tinkly": "ذُو طَنِين, مُتَرَنِّم (يشبه صوت الرنين القصير العالي لجرس صغير)",
 "tinned": "مُعَلَّب (مَحْفُوظ فِي عُلْبَة أَوْ بُرْطُمَان مُغْلَق)",
 "tinned goods": "أغذية معلبة, طعام معلب (طعام محفوظ بالتعليب)",
 "tinned meat": "لحم معلب (لحم محفوظ في علبة أو صفيحة)",
 "tinner": "سمكري, صانع الصفيح (شخص يصنع أو يصلح الأواني الصفيحية)",
 "tinnevelly senna": "سنا إسكندراني, سنا مكي (شجيرة قائمة لها عناقيد من الزهور الصفراء السمراء؛ تستخدم الأوراق المجففة طبياً كمسهل؛ تصنف أحياناً في جنس كاسيا)",
 "tinning": "طلاء بالقصدير, قصدرة (وضع طبقة واقية من القصدير) / قصدرة (وضع طبقة رقيقة من اللحام اللين على أطراف الأسلاك قبل لحامها)\nمثال: القصدرة الدقيقة لأطراف الأسلاك تؤدي إلى وصلة أفضل عند لحامها",
 "tinnitus": "طَنِين",
 "tinny": "صَفِيحِيُّ الصَّوْت, مُعَلَّب (رَقِيقُ الصَّوْتِ وَذُو نَبْرَةٍ مَعْدَنِيَّةٍ؛ يَفْتَقِرُ إِلَى الرَّنِين) / تَافِه, رَخِيص (رديء الجودة جدًا؛ هَشّ) / قصديري (مصنوع من القصدير أو محتوٍ عليه)",
 "tinplate": "صاج مقصدر, صفيح (ورقة رقيقة من المعدن (الحديد أو الصلب) مطلية بالقصدير لمنع الصدأ؛ تستخدم خاصة للعلب والأواني)",
 "tinsel": "بهرج, خيط زينة لامع (خيط ملحق به رقائق معدنية لامعة) / بهرج, زينة لامعة (زينة مبهرجة لا قيمة لها أساساً)\nمثال: كل بهرج الترويج الذاتي",
 "tinseled": "بَرَّاق, لَامِع بِالذَّهَب (متلألئ بالذهب أو الفضة)",
 "tinselly": "بَرَّاق, لَامِع بِالذَّهَب (متلألئ بالذهب أو الفضة)",
 "tinsmith": "سمكري, صانع الصفيح (شخص يصنع أو يصلح الأواني الصفيحية)",
 "tinsnips": "مقص صفيح ((جمع) مقص يدوي لقطع الصفائح المعدنية)",
 "tint": "درجة لونية, صبغة (جودة لون معين تختلف قليلاً عن لون آخر) / أثر, لمحة (كمية يمكن اكتشافها بالكاد) / صبغة شعر (صبغة لتلوين الشعر)\nمثال: بعد عدة محاولات، مزج درجة اللون الوردي التي أرادتها",
 "tintack": "مسمار صفيح (مسمار صغير أو مسمار تثبيت مصنوع من الحديد المقصدر)",
 "tinter": "صبّاغ شعر (مصفف شعر يصبغ الشعر)",
 "tinting": "تلوين خفيف, صباغة (فعل إضافة مسحة من اللون)\nمثال: أعطى مصفف الشعر شعرها صبغة خفيفة",
