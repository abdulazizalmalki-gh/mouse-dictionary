 "television program": "بَرْنَامَج تِلِفِزْيُون (عَرْضٌ (تلْفَزِيٌّ،…)؛ مُفَكَّرَةٌ يَوْمِيَّةٌ)\nمثال: نشط البرنامج الآن.",
 "television receiver": "تلفاز, جهاز تلفزيون (جهاز إلكتروني يستقبل إشارات التلفزيون ويعرضها على شاشة)",
 "television reporter": "مراسل تلفزيوني (شخص يبلغ عن القصص الإخبارية عبر التلفزيون)",
 "television room": "غرفة تلفزيون (غرفة مخصصة لمشاهدة التلفزيون)",
 "television set": "تلفاز, جهاز تلفزيون (جهاز إلكتروني يستقبل إشارات التلفزيون ويعرضها على شاشة)",
 "television show": "بَرْنَامِج تِلِفِزْيُون (عَرْضٌ (تلْفَزِيٌّ،…)؛ مُفَكَّرَةٌ يَوْمِيَّةٌ)\nمثال: نشط البرنامج الآن.",
 "television star": "نجم تلفزيوني (نجم في برنامج تلفزيوني)",
 "television station": "مَحَطَّة تِلِفِزْيُون",
 "television system": "تلفاز, تلفزيون (نظام اتصالات ينقل صوراً للأشياء (الثابتة أو المتحركة) بين نقاط متباعدة)",
 "television transmitter": "جهاز إرسال تلفزيوني (جهاز إرسال يمثل جزءاً من نظام التلفزيون)",
 "television tube": "أنبوب الصورة, كينسكوب (أنبوب أشعة الكاثود في جهاز استقبال التلفزيون؛ يترجم الإشارة المستلمة إلى صورة على شاشة مضيئة)",
 "television-camera tube": "أنبوب كاميرا التلفزيون (أنبوب يمسح بسرعة صورة بصرية ويحولها إلى إشارات إلكترونية)",
 "televisuality": "تلفزيونية, صلاحية تلفزيونية (جودة الارتباط بالبث التلفزيوني أو الملاءمة له)",
 "teleworking": "عمل عن بعد, عمل من المنزل (التوظيف من المنزل مع التواصل مع مكان العمل عبر الهاتف أو الفاكس أو المودم)",
 "telex": "تِلِكْس",
 "telex machine": "آلة كاتبة عن بعد, تلكس (طابعة أحرف متصلة بجهاز تلغراف تعمل مثل الآلة الكاتبة)",
 "telfer": "عربة تلفريك, عربة سلكية (واحدة من عربات النقل في نظام النقل المعلق بالسلك (التلفريك))",
 "telferage": "نقل بالتلفريك (نظام نقل تُعلق فيه العربات من كابلات وتعمل بالكهرباء)",
 "telingo potato": "أمورفوفالس فاونيا, يام الفيل (نبات لوفي كريه الرائحة من جنوب شرق آسيا (خاصة الفلبين) يزرع لدرنته الصالحة للأكل)",
 "telint": "استخبارات القياس عن بعد (استخبارات مستمدة من اعتراض ومعالجة وتحليل القياس عن بعد الأجنبي)",
 "teliospore": "بوغ تيلي, بوغ نهائي (بوغ كلاميدي ينمو في المرحلة الأخيرة من دورة حياة فطر الصدأ)",
 "tell": "أَخْبَرَ, قَالَ (أَنْبَأَ، أَعْلَمَ) / تَلّ (في الْمُرتَفَعِ مِنَ الأرْضِ قَليلا، وهو دون الجَبَل؛ رَابِيَة)\nمثال: أخبر سامي أباه.",
 "tell me about it": "حَدِّثْ وَلَا حَرَجَ (وَقَعَ الأمر؛ نقيض قَدُمَ، كان حَدِيثا)\nمثال: لا أصدق ما حدث.",
 "tell off": "وَبَّخَ (التأنيب بشدة)",
 "tell the truth": "صَدَقَ (نقيض الْكِذْب والكَذِب؛ قول ما يعتقدهُ القائل مطابقا للوَاقِع)\nمثال: صدق سامي كل شيء.",
 "teller": "راوٍ, قاص (شخص يحكي قصة) / أمين صندوق, صراف بنك (موظف في بنك يستلم ويدفع الأموال) / عداد, فارز الأصوات (مسؤول معين لعد الأصوات (خاصة في الجمعية التشريعية))",
 "tellima affinis": "ليثوفراجما, نجمة الغابة (عشبة معمرة في كاليفورنيا تزرع لزهورها البيضاء العنقودية ذات البتلات واسعة الانتشار؛ توضع أحياناً في جنس تيليما)",
 "tellima grandiflora": "أكواب مهدبة, تيليما (نبات ينمو في كتل بأوراق قاعدية غالباً وأزهار مهدبة قشدية اللون أو وردية باهتة في عدة عناقيد طويلة؛ ألاسكا إلى ساحل وسط كاليفورنيا وشرقاً إلى أيداهو)",
 "telling": "بَلِيغ, مُؤَثِّر (يُنتج أثراً قويّاً) / فَاضِح, كَاشِف (يكشف عن غير قصد شيئًا مخفيًّا) / دَامِغ, مُؤَثِّر (مقنع بقوّة ووجاهة الحجّة) / إفشاء, وشاية (كشف معلومات أو تقديم أدلة عن شخص آخر)",
 "tellingly": "بدلالة واضحة, بشكل معبر (بطريقة فعالة ومعبرة)\nمثال: الأسلوب البسيط في كتابته يشير بشكل معبر إلى رعب القضية",
 "telltale": "نمّام, واشٍ (شخص يثرثر بشكل غير حكيم)",
 "tellurian": "أرضي, بري (مكون من أو متعلق بـ أو يسكن اليابسة بدلاً من البحر أو الجو) / أرضي, من سكان الأرض (أحد سكان الأرض)",
 "telluric": "أرضي, بري (مكون من أو متعلق بـ أو يسكن اليابسة بدلاً من البحر أو الجو) / تيلوري (مكون من أو متعلق بـ أو يحتوي على عنصر التيلوريوم الكيميائي)",
 "telluride": "تيلوريد (أي مركب ثنائي للتيلوريوم مع عناصر أخرى أكثر إيجابية كهربائية)",
 "tellurium": "تِلُّورِيُوم, تِيلُورِيُوم",
 "telly": "تلفاز, جهاز تلفزيون (جهاز إلكتروني يستقبل إشارات التلفزيون ويعرضها على شاشة)",
 "telocentric": "انتهائي المركز (لديه شكل قضيب مستقيم لأن السنترومير في موضع طرفي)\nمثال: كروموسوم انتهائي المركز",
 "telocentric chromosome": "كْرُومُوسُوم اِنْتِهَائِيّ المَرْكَز (كروموسوم يشبه قضيباً مستقيماً مع وجود السنترومير في موضع طرفي)",
 "telomerase": "تيلوميراز (إنزيم في الخلايا حقيقية النواة يمكنه إضافة التيلوميرات إلى نهايات الكروموسومات بعد انقسامها)",
 "telomere": "تيلومير, قسيم طرفي (أي من الطرفين (الحرين) لكروموسوم حقيقي النواة)\nمثال: تعمل التيلوميرات كأغطية لمنع الأطراف اللزجة للكروموسومات من التكتل العشوائي معاً",
 "telopea oreades": "وراته (شجيرة طويلة من شرق أستراليا ذات أوراق سنانية مقلوبة إلى بيضاوية مقلوبة وأزهار حمراء في عناقيد مدمجة)",
 "telopea speciosissima": "وراته (شجيرة متناثرة ذات أوراق ضيقة وأزهار حمراء بارزة في عناقيد كروية كثيفة)",
 "telophase": "الطور النهائي (المرحلة النهائية من الانقسام المتساوي) / الطور النهائي (المرحلة النهائية من الانقسام المنصف حيث تتحرك الكروموسومات نحو الأطراف المتقابلة للمغزل النووي)",
 "telos": "غَايَة",
 "telpher": "عربة تلفريك, عربة سلكية (واحدة من عربات النقل في نظام النقل المعلق بالسلك (التلفريك))",
 "telpherage": "نقل بالتلفريك (نظام نقل تُعلق فيه العربات من كابلات وتعمل بالكهرباء)",
 "telsontail": "أوليات الذنب (أي من الحشرات البدائية الدقيقة عديمة الأجنحة والعيون التي لها رأس مخروطي الشكل؛ تعيش في التربة الرطبة أو المواد العضوية المتحللة)",
 "telugu": "لغَة تيلوغو, تِيلُوغُو (هِيَ مجموعة من الأصوات التي يصدرها الإنسان على شكل كلمات منظمة بقواعد، ليتواصل به الناس وينقلون به الافكار والمعاني، اللسان؛ يقصد بها أحيانا اللهجة)\nمثال: الأمازيغية لغة.",
 "telugu language": "التيلوغو (لغة درافيدية يتحدث بها التيلوغو في جنوب شرق الهند)",
 "temazepam": "تيمازيبام, ريستوريل (بنزوديازيبين يوصف بشكل متكرر (الاسم التجاري ريستوريل)؛ يأخذ مفعوله ببطء ويستمر لفترة كافية لمساعدة أولئك الذين يستيقظون بشكل متكرر أثناء الليل)",
 "temblor": "زلزال, هزة أرضية (اهتزاز وارتجاج في سطح الأرض ناتج عن حركة تحت الأرض على طول مستوى فالق أو من نشاط بركاني)",
 "temerarious": "أَهْوَج, مُتَهَوِّر (جريء بشكل متهور ومُفرِط)",
 "temerity": "تَهَوُّر (التسرع والاندفاع لفعل شيء دون التفكير بالنتائج)\nمثال: إنه خطر أن تقود بتهور.",
 "temp": "موظف مؤقت (عامل (خاصة في مكتب) يتم تعيينه على أساس مؤقت)",
 "temper": "حدة المزاج, سرعة الغضب (الميل لإظهار غضب غير منضبط) / صلابة, متانة (مرونة وصلابة جسم معدني؛ قدرته على امتصاص طاقة كبيرة قبل التشقق) / فورة غضب, هيجان (نوبة مفاجئة من الغضب) / مزاج (حالة شعورية مميزة (عادة أو مؤقتة نسبياً))\nمثال: كانت حدة مزاجه معروفة لجميع موظفيه",
 "tempera": "ألوان الملصقات, تمبرا (صبغة ممزوجة بمواد غلوتينية قابلة للذوبان في الماء مثل الغراء وصفار البيض)",
 "temperament": "طَبْع (طَبَعَ الله الخلقَ : أَنشأَهُ؛ طبَعَت الدَّوْلةُ النَّقْد : صاغتْه ونقشته)\nمثال: بالطبع هي مزحة!",
 "temperamental": "غَيْرُ مُنْتَظِم, مُتَقَلِّب (مِنَ المُرَجَّحِ أَنْ يَعْمَلَ بِشَكْلٍ غَيْرِ مُتَوَقَّع) / مُتَقَلِّبُ المِزَاج, مِزَاجِيّ (خاضع لتقلّبات حادّة في المزاج) / مزاجي (متعلق بـ أو ناتج عن المزاج)\nمثال: لا مبالاة مزاجية تجاه الترتيب",
 "temperamentally": "مزاجياً (بحكم المزاج أو الطبع)\nمثال: متناسبان مزاجياً مع بعضهما",
 "temperance": "تعديل, تلطيف (عملية التلطيف أو المزج المعتدل) / اعتدال, رصانة (الامتناع عن الإفراط) / اعتدال, عفة (سمة تجنب التجاوزات والإفراط)",
 "temperate": "مُتَوَسِّط, مُعْتَدِل (لَيْسَ مُتَطَرِّفًا؛ بَعِيدٌ عَنِ الإِفْرَاط) / رزين, معتدل (غير متطرف في السلوك) / معتدل ((للطقس أو المناخ) خالٍ من التطرف؛ لطيف؛ أو يتميز بمثل هذا الطقس أو المناخ)\nمثال: معتدل في عاداته",
 "temperate rain forest": "غابة مطيرة معتدلة (غابة مطيرة في منطقة معتدلة المناخ)",
 "temperate zone": "المنطقة المعتدلة (جزء سطح الأرض الواقع بين الدائرة القطبية الشمالية ومدار السرطان أو بين الدائرة القطبية الجنوبية ومدار الجدي؛ ويتميز بمناخ معتدل)",
 "temperately": "بِاعْتِدَال, بِتَقَشُّف (بطريقة مقتصدة؛ بدون إفراط) / باعتدال (بدون إسراف) / بتمالك نفس, برزانة (مع ضبط النفس)\nمثال: أكل وشرب باعتدال",
 "temperateness": "تمالك النفس (إظهار التحفظ المفروض على الذات) / إشراق, طقس صحو (طقس معتدل؛ مناسب للأنشطة الخارجية)\nمثال: اعتدال فعال في النقاش",
 "temperature": "دَرَجَةْ الْحَرَارَة / حُمَّى (حمَى الشيءُ فلانًا: منَعه ودفع عنه؛ حمى المريضَ: منعه ما يضره)\nمثال: ليس لديك أي حمى.",
 "temperature change": "تغير درجة الحرارة (عملية تتغير فيها درجة سخونة جسم (أو وسط))",
 "temperature gradient": "تَدَرُّج دَرَجَة الحَرَارَة (تغير في درجة الحرارة كدالة للمسافة (وخاصة الارتفاع))",
 "temperature reduction": "تبريد, خفض درجة الحرارة (عملية التحول إلى البرودة؛ انخفاض درجة الحرارة)",
 "temperature scale": "مقياس درجة الحرارة (نظام لقياس درجة الحرارة)",
 "temperature unit": "وحدة درجة الحرارة (وحدة لقياس درجة الحرارة)",
 "tempered": "معدل, ملطف (مُعدل أو مُخفف بإضافة عنصر موازن) / مُصلّد, مُعالَج (ما جُعل صلباً أو مرناً أو مقاوماً خاصةً عن طريق المعالجة الحرارية)\nمثال: نقد ملطف بتعاطف لطيف",
 "tempering": "تطبيع, تلدين (تقسية شيء ما بالمعالجة الحرارية) / مُعَدِّل, مُهَدِّئ (يُلَطّف ويجعل الأمر أكثر اعتدالًا)",
 "tempest": "عاصفة هوجاء ((أدبياً) رياح عنيفة) / عاصفة (هيجان أو اضطراب عنيف)\nمثال: اجتاحت عاصفة هوجاء الجزيرة",
 "tempest-swept": "مُبْتَلًى بِالعَوَاصِف, مُعَصَّف بِه (تعرض للضرب المتكرر من العواصف أو المحن)",
 "tempest-tossed": "مُبْتَلًى بِالعَوَاصِف, مُعَصَّف بِه (تعرض للضرب المتكرر من العواصف أو المحن)",
 "tempest-tost": "مُبْتَلًى بِالعَوَاصِف, مُعَصَّف بِه (تعرض للضرب المتكرر من العواصف أو المحن)",
 "tempestuous": "عَاتٍ, هَائِج ((عَنِ العَنَاصِر الطَّبِيعِيَّة) كَأَنَّهُ يُظْهِر غَضَبًا عَنِيفًا) / عَاصِف, هَائِج (يَتَّسِمُ بِعَوَاطِفَ أَوْ سُلُوكٍ عَنِيف)",
 "tempestuousness": "غليان, قلق (حالة من الهياج أو التغيير المضطرب أو التطور) / عصف شديد (حالة من العواصف الجامحة)\nمثال: أنتج الغليان السياسي قيادة جديدة",
 "templar": "فارس الهيكل (فارس في نظام عسكري ديني تأسس عام 1118 لحماية الحجاج والقبر المقدس)",
 "template": "قَالَب, قالِب",
 "template rna": "حمض نووي ريبوزي رسول (القالب لتخليق البروتين؛ شكل الحمض النووي الريبوزي الذي يحمل المعلومات من الحمض النووي في النواة إلى مواقع الريبوسوم لتخليق البروتين في الخلية)",
 "temple": "مَعْبَد / هَيْكَل / صَدْغ / ذِرَاع",
 "temple in jerusalem": "بَيْت المُقَدَّس, بَيْت المَقْدِس (بمعنى قضى الليل؛ الخَيْمَة من الشَعْر يَبِيت فيها البَدَوي أو المُسافر. الجمع بُيُوت)\nمثال: لنعد إلى البيت.",
 "temple mount": "الحرم الشريف",
 "temple orange": "برتقال تيمبل (فاكهة فلوريدا كبيرة حلوة سهلة التقشير ذات قشرة برتقالية عميقة) / برتقال المعبد, تانغور (شجرة حمضيات كبيرة لها فاكهة برتقالية عميقة حلوة كبيرة سهلة التقشير؛ تزرع على نطاق واسع في فلوريدا)",
 "temple orange tree": "برتقال المعبد, تانغور (شجرة حمضيات كبيرة لها فاكهة برتقالية عميقة حلوة كبيرة سهلة التقشير؛ تزرع على نطاق واسع في فلوريدا)",
 "temple tree": "بلوميريا, فتنة (فرانجيباني من الهند ذو عادة منتصبة وشكل مخروطي؛ يزرع في حدائق المعابد)",
 "templet": "دليل, قالب (نموذج أو معيار لإجراء المقارنات)",
 "templetonia retusa": "تيمبلتونيا, شجيرة المرجان (شجيرة أسترالية لها أوراق بيضاوية مقلوبة بسيطة وزهور قرمزية لامعة)",
 "tempo": "تمبو, سرعة الإيقاع ((موسيقى) السرعة التي ستُعزف بها المقطوعة) / إِيقَاع, وُتَيْرَة (معدل حدث متكرر)",
 "temporal": "دُنْيَوِيّ, زَمَنِيّ (مُتَعَلِّق بِالحَياة الدُّنْيا والوُجود الزَّمَنِيّ) / دُنْيَوِيّ, زَمَنِيّ (غير أبديّ؛ مرتبط بالحياة الدنيا الفانية) / دنيوي, زمني (من سمات أو مكرس للعالم الدنيوي مقابل العالم الروحي) / صدغي (مكون من أو متعلق بالصدغين (جانبي الجمجمة خلف محجر العين))\nمثال: متاع الدنيا والتقدم",
 "temporal adverbial": "ظرف زمان (عبارة ظرفية تصف متى تم تنفيذ الفعل)",
 "temporal arrangement": "ترتيب زمني, نظام زمني (ترتيب الأحداث في الوقت)",
 "temporal arteritis": "التهاب الشريان الصدغي (التهاب الشرايين الصدغية؛ يتميز بالصداع وصعوبة المضغ و(أحياناً) ضعف البصر)",
