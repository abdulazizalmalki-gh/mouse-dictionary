 "titular": "اِسْمِيّ, شَرَفِيّ (لَا يُوجَدُ إِلَّا بِالِاسْمِ فَقَطْ) / شرفي, لقبي (مرتبط بلقب أو يحمل لقباً يدل على النبالة) / عنواني (متعلق بعنوان عمل فني) / اسمي, صوري (يحمل لقباً يشير إلى مكانة أو وظيفة (غالباً دون السلطة الفعلية))\nمثال: كبار الشخصيات من أصحاب الألقاب",
 "titulary": "سندي, ملكي (متعلق بحق الملكية القانوني لشيء ما)\nمثال: حقوق الملكية",
 "titus": "الرسالة إلى تيطس",
 "tivoli": "تِيفُولِي",
 "tiyin": "تين (100 تين تساوي 1 تنغي في كازاخستان) / تيين (100 تيين تساوي 1 سوم في أوزبكستان)",
 "tizzy": "اضطراب, حيرة (حالة من الهياج المثار)\nمثال: كان في حيرة من أمره",
 "tkm": "طن-كيلومتر (وحدة قياس تُستخدم في نقل البضائع تحدد نقل طن واحد من البضائع لمسافة كيلومتر واحد)",
 "tko": "ضربة قاضية فنية (ضربة قاضية يعلنها الحكم الذي يقرر أن أحد الملاكمين غير قادر على الاستمرار)",
 "tl": "ثاليوم (عنصر فلزي ناعم رمادي قابل للطرق يشبه القصدير ولكنه يتغير لونه عند التعرض للهواء؛ وهو شديد السمية)",
 "tlc": "رعاية محبة وحنونة (رعاية تراعي المشاعر وتهتم)\nمثال: يحتاج الأطفال الصغار إلى الكثير من الرعاية المحبة والحنونة",
 "tlemcen": "تِلِمْسَان",
 "tlingit": "لغة تلينغيت (لغة نا-ديني التي يتحدث بها شعب تلينغيت) / تلينغيت (فرد من مجموعة بحرية من هنود أمريكا الشمالية تعيش في جنوب ألاسكا)",
 "tlingit language": "لغة تلينغيت (لغة نا-ديني التي يتحدث بها شعب تلينغيت)",
 "tm": "ثوليوم (عنصر فلزي فضي ناعم من مجموعة الأتربة النادرة)",
 "tmp": "ديوكسي ثيميدين أحادي الفوسفات",
 "tmv": "فيروس تبرقش التبغ, فيروس فسيفساء التبغ (فيروس نباتي مدروس على نطاق واسع يسبب تبرقش التبغ؛ وكان أول فيروس تم اكتشافه (1892))",
 "tnf": "عامل نخر الورم (سيتوكين محفز للالتهاب تنتجه خلايا الدم البيضاء (الخلايا الوحيدة والضامة)؛ له تأثير مضاد للأورام ولكنه يسبب الالتهاب (كما في التهاب المفاصل…)",
 "tnt": "تي إن تي, ثلاثي نتروتولوين (مادة متفجرة تتكون من مركب بلوري أصفر وهو مشتق سام وقابل للاشتعال من التولوين)",
 "to": "أَنّ (يفيد التوكيد) / إِلَى, عَلَى (حرف جر يُفيد الغاية الزمنية؛ حرف جر يُفيد الغاية المكانية)\nمثال: كيف لي أن أعرف؟",
 "to a fault": "بإفراط, بشكل مبالغ فيه (لدرجة تتجاوز الحدود الطبيعية أو المناسبة)\nمثال: كبير جداً",
 "to a great extent": "بثقل, بشكل كبير (بدرجة كبيرة)\nمثال: اعتمد بشكل كبير على بيانات الآخرين",
 "to a greater extent": "أكثر (تستخدم لتشكيل المقارنة لبعض الصفات والظروف، تشير إلى أن الصفة أو الظرف أكثر من شيء ما)\nمثال: أكثر إثارة للاهتمام",
 "to a higher place": "فوق, في الأعلى (في أو إلى مكان أعلى)",
 "to a lesser extent": "أقل (تستخدم لتشكيل المقارنة لبعض الصفات والظروف، تشير إلى أن الصفة أو الظرف أقل من شيء ما)\nمثال: أقل إثارة للاهتمام",
 "to a lower place": "تحت, في الأسفل (في أو إلى مكان أقل انخفاضاً)",
 "to a man": "بلا استثناء, عن بكرة أبيهم (دون استثناء)\nمثال: صوتوا للنقابة عن بكرة أبيهم",
 "to a t": "بالحرف, تماماً (في كل تفصيل)\nمثال: المنزل الجديد ناسبهم تماماً",
 "to advantage": "بشكل مفيد, لإبراز المحاسن (بطريقة تستخدم أفضل الجوانب)\nمثال: أبرز الفستان قوامها",
 "to all intents and purposes": "عملياً, لجميع الأغراض العملية (بكل معنى عملي)\nمثال: عملياً القضية مغلقة",
 "to and fro": "جيئة وذهاباً, ذهاباً وإياباً (التحرك من مكان إلى آخر والعودة مرة أخرى)\nمثال: سافر ذهاباً وإياباً بين لوس أنجلوس ونيويورك",
 "to be continued": "يُتْبَعُ",
 "to be honest": "بِصَراحة",
 "to be precise": "حقاً, فعلياً (في واقع الأمر)\nمثال: لا أحد رأى القرش فعلياً",
 "to be sure": "بلا شك, مما لا شك فيه (باستدراك أو تسليم)\nمثال: مما لا شك فيه، هو ليس أينشتاين",
 "to begin with": "أصلاً, في المقام الأول (قبل الآن)\nمثال: لماذا لم تخبرني في المقام الأول؟",
 "to boot": "بالإضافة إلى ذلك, علاوة على ذلك (بالإضافة؛ علاوة على ذلك)\nمثال: يعمل بالإضافة إلى ذلك كمدير تنفيذي",
 "to both ears": "بكلتا الأذنين (بطريقة تستخدم الأذنين معاً)\nمثال: تم تقديم المحفز بكلتا الأذنين",
 "to date": "حتّى الآن (يفيد انتهاء الغاية؛ يفيد الغاية)\nمثال: انتظر حتى أجلس.",
 "to do with": "عَلَى صِلَة بِـ (يفيد الاستعلاء؛ يفيد التعليل) / عَلَى عِلَاقَة بِـ (يفيد الاستعلاء؛ يفيد التعليل) / يَمُت لِـ\nمثال: أجب على السؤال.",
 "to each his own": "كل شخص حرّ في ذوقه",
 "to each one": "لِكُلّ وَاحِد (لكل فرد من اثنين أو أكثر (يعتبرون بشكل فردي))\nمثال: حصل كل واحد منهم على 10 دولارات",
 "to err is human": "كُلّ اِبْن آدَم خَطَّاء",
 "to it": "لذلك, له\nمثال: مع جميع الملحقات المناسبة لذلك",
 "to leeward": "الجَانِب المَحْجُوب عَن الرِّيح, تَحْت الرِّيح (الجانب المحمي من الرياح)",
 "to no avail": "دون جدوى (مصدر من الفعل دَانَ يَدُون بمعنى خَسَّ وضَعُف؛ تَحت؛ ضد فَوق. ويختلف عن التحت بأن التحت موضعه في الأسفل والدون هو تقصير عن الغاية أو عدم القدرة على الوصول إلى أعلى)\nمثال: زيري بدون مؤوى.",
 "to no degree": "بأي وجه, بتاتاً (بأي حال من الأحوال)\nمثال: إنهن لسن مختلفات بتاتاً",
 "to one ear": "بأذن واحدة (بطريقة تستخدم أذناً واحدة)\nمثال: تم تقديم المحفزات بأذن واحدة",
 "to order": "حسب الطلب (حسب المواصفات)\nمثال: صنع الأحذية حسب الطلب",
 "to perfection": "بالحرف, تماماً (في كل تفصيل)\nمثال: المنزل الجديد ناسبهم تماماً",
 "to say the least": "على أقلّ تقدير (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال.",
 "to taste": "حَسَبَ الرَغَبَة (عَدَّ مع الجَمْع والطَرْح وغيرها من العمليات الحِسَابية؛ عند أكثر العامة: هو العَدّ مطلقا)\nمثال: حسب سامي المال.",
 "to that": "لذلك, له\nمثال: مع جميع الملحقات المناسبة لذلك",
 "to that degree": "إلى هذا الحد, بقدر ما (إلى الدرجة أو المدى الذي)\nمثال: بقدر ما يمكن التأكد، رئة الحصان قابلة للمقارنة برئة الإنسان",
 "to that effect": "بهذا المعنى (بذلك المعنى العام)\nمثال: قالت شيئاً بهذا المعنى",
 "to that extent": "إلى هذا الحد, بقدر ما (إلى الدرجة أو المدى الذي)\nمثال: بقدر ما يمكن التأكد، رئة الحصان قابلة للمقارنة برئة الإنسان",
 "to the contrary": "على العكس (خلافاً للتوقعات)\nمثال: لم يبق في المنزل؛ على العكس، خرج مع أصدقائه",
 "to the full": "بالكامل, تماماً (إلى أقصى درجة أو مدى؛ بشكل كامل أو كلي)\nمثال: نمى بالكامل",
 "to the highest degree": "الأكثر (تستخدم لتشكيل التفضيل، الأكبر في الحجم أو الدرجة)\nمثال: الكوبرا الملك هو الثعبان الأكثر خطورة",
 "to the hilt": "حتى النهاية, لأقصى حد\nمثال: أنت متورط في هذا حتى النهاية (يفيد انتهاء الغاية؛ يفيد الغاية)\nمثال: انتظر حتى أجلس.",
 "to the letter": "بالحرف, تماماً (في كل تفصيل)\nمثال: المنزل الجديد ناسبهم تماماً",
 "to the limit": "حتى النهاية, لأقصى حد\nمثال: أنت متورط في هذا حتى النهاية (يفيد انتهاء الغاية؛ يفيد الغاية)\nمثال: انتظر حتى أجلس.",
 "to the lowest degree": "الأقل (تستخدم لتشكيل التفضيل، الأصغر في الحجم أو الدرجة)\nمثال: ثعبان الرباط هو الثعبان الأقل خطورة",
 "to the point": "فِي صَمِيمِ الْمَوْضُوعِ (ذو صلة دقيقة أو منطقية بالمسألة المطروحة)",
 "to the power of": "أُسّ",
 "to the south": "جَنُوبًا (في اتجاه الجنوب)\nمثال: انتقلنا جنوباً",
 "to whom it may concern": "إِلَى مَنْ يَهُمُّهُ الْأَمْرُ (حرف جر يُفيد الغاية الزمنية؛ حرف جر يُفيد الغاية المكانية)\nمثال: تعال إلى منزلي.",
 "to wit": "أي, تحديداً (كما يلي (تستخدم للتفصيل))",
 "to-do": "اضطراب, قلاقل (ثوران أو صخب غير منظم)\nمثال: لقد ذهلوا من الاضطراب العنيف الذي سببوه",
 "toad": "عُلْجُوم, ضِفْدَع طِين",
 "toad frog": "ضفدع, علجوم (أي من البرمائيات المختلفة عديمة الذيل ممتلئة الجسم ذات أطراف خلفية طويلة للقفز؛ أنواع شبه مائية وأرضية)",
 "toad lily": "زنبق الضفدع (خس هندي طافٍ أو زاحف ذو عناقيد طرفية من الزهور الوردية الباهتة؛ المناطق الرطبة في المرتفعات بغرب أمريكا الشمالية)",
 "toad rush": "أسل ضفدعي, سمار الضفادع (أسل حولي منخفض النمو في الأراضي المنخفضة الرطبة؛ عالمي الانتشار تقريباً)",
 "toad-in-the-hole": "سجق في العجين (سجق مخبوز في خليط العجين)",
 "toadfish": "سمكة العلجوم (سمكة تعيش في القاع ذات جلد لزج عديم القشور ورأس عريض سميك وفم واسع)",
 "toadflax": "كَتَّانِيَّة, لِينَارِيَة",
 "toadshade": "تريليوم أحمر, تريليوم لاطئ (تريليوم من شمال شرق الولايات المتحدة بأوراق لاطئة وزهور حمراء أو أرجوانية لها رائحة نفاذة)",
 "toadstool": "فطر سام (اسم شائع للغاريقون غير الصالح للأكل أو السام (على عكس الفطر الصالح للأكل))",
 "toady": "ذَيْل, ماسِح الجُوخ (شخص يحاول إرضاء شخص ما من أجل الحصول على ميزة شخصية)",
 "toadyish": "مُتَزَلِّف, مُتَمَلِّق (يَسْعَى لِكَسْب الوُدّ بِالتَّمَلُّق) / مُتَزَلِّف, مُتَمَلِّق (يُحَاوِل كَسْب وُدّ ذَوِي النُّفُوذ بِالتَّمَلُّق)",
 "toast": "توست, خبز محمص (شرائح من الخبز تم تحميصها) / نخب (شرب نخب تكريماً لشخص أو حدث أو للصحة) / مُنْتَهٍ, هالِك (شخص في مأزق يائس؛ شخص محكوم عليه بالهلاك) / نجم المجتمع (مشهور يتلقى الكثير من الإشادة والاهتمام)\nمثال: سأكون هالكاً إذا لم تنجح هذه الخطة",
 "toast mistress": "عريفة الحفل (امرأة تدير الحفل)",
 "toasted": "مُحَمَّص (اسْمَرَّ لَوْنُهُ بِفِعْلِ التَّعَرُّضِ لِلحَرَارَة)",
 "toaster": "مُحَمِصَّة, مُحَمِّصَة خُبْز",
 "toaster oven": "فرن تحميص (جهاز مطبخ يتكون من فرن كهربائي صغير لتحميص أو تسخين الطعام)",
 "toasting": "تحمير, تحميص (الطهي حتى يصبح لونه بنياً ومقرمشاً فوق نار أو شواية)\nمثال: التحميص الجيد يجب أن يحمر جانبي قطعة الخبز",
 "toasting fork": "شوكة التحميص (شوكة طويلة المقبض لطهي أو تحميص النقانق أو الخبز وما إلى ذلك (خاصة فوق نار مفتوحة))",
 "toastmaster": "عريف المأدبة, مقدم الأنخاب (الشخص الذي يقترح الأنخاب ويقدم المتحدثين في مأدبة)",
 "toastrack": "رف التوست (رف لحمل شرائح الخبز المحمص)",
 "tobacco": "تِبْغ, تَبْغ / تَبْغ, تَبَغ",
 "tobacco budworm": "دودة كوز الذرة (يرقة عثة ليلية؛ مدمرة للغاية خاصة لمحاصيل الذرة والقطن والطماطم)",
 "tobacco hornworm": "دودة التبغ القرنية (يرقة عثة صقرية خضراء كبيرة مخططة بالأبيض تتغذى على التبغ والنباتات ذات الصلة)",
 "tobacco industry": "صناعة التبغ (صناعة تقوم بتصنيع وبيع المنتجات المحتوية على التبغ)",
 "tobacco juice": "عصير التبغ (لعاب ملون باللون البني بسبب التبغ (النشوق أو تبغ المضغ))",
 "tobacco mildew": "بياض التبغ (فطر يسبب بياضاً زغبياً على التبغ النامي)",
 "tobacco mosaic": "فسيفساء التبغ (مرض نباتي يسبب تلون أوراق نباتات التبغ)",
 "tobacco mosaic virus": "فيروس تبرقش التبغ, فيروس فسيفساء التبغ (فيروس نباتي مدروس على نطاق واسع يسبب تبرقش التبغ؛ وكان أول فيروس تم اكتشافه (1892))",
 "tobacco moth": "عثة التبغ (عثة صغيرة تتغذى يرقاتها على التبغ ومنتجات نباتية مجففة أخرى)",
 "tobacco pipe": "غَلْيُون, بِيبَة",
 "tobacco plant": "تبغ, نبات التبغ (أعشاب وشجيرات عطرية حولية أو معمرة)",
 "tobacco pouch": "كيس تبغ (جراب لحمل تبغ الغليون)",
 "tobacco product": "منتج تبغ (أي منتج مصنوع جزئياً على الأقل من أوراق التبغ القابلة للاستهلاك، مثل السجائر أو تبغ المضغ أو النشوق)",
 "tobacco shop": "محل تبغ (متجر يبيع الغليون وتبغ الغليون والسيجار والسجائر)",
 "tobacco smoke": "دخان التبغ (الدخان الناتج عن حرق المنتجات المصنوعة من أوراق التبغ المجففة، مثل السجائر)\nمثال: يجب أن تقلع عن التدخين، ألا تعلم أن دخان التبغ يحتوي على مواد ضارة؟",
 "tobacco thrips": "تربس التبغ (ضار بالتبغ والفول السوداني النامي)",
 "tobacco user": "مدخن (شخص يدخن التبغ)",
 "tobacco wilt": "عفن حلقي, مرض حلقي (مرض يصيب الطماطم والبطاطس والتبغ وغيرها تسببه بكتيريا 'سودوموناس سولاناسيروم')",
 "tobacconist": "محل تبغ (متجر يبيع الغليون وتبغ الغليون والسيجار والسجائر) / بائع تبغ, دخاخني (تاجر تجزئة في التبغ والمواد المتعلقة به)",
 "tobacconist shop": "محل تبغ (متجر يبيع الغليون وتبغ الغليون والسيجار والسجائر)",
 "tobago": "توباغو",
 "tobagonian": "توباغوي (من أو متعلق بتوباغو أو شعبها) / توباغوني (مواطن أو ساكن في جزيرة توباغو في جزر الهند الغربية)\nمثال: شواطئ توباغوية",
 "tobias": "طُوبِيَا",
 "tobin bronze": "نحاس أدميرالي, نحاس بحري (نحاس أصفر ألفا-بيتا يحتوي على القصدير؛ مقاوم لمياه البحر)",
 "tobit": "سِفْر طُوبِيَا (السَّفَرُ : قَطْعُ المسافة؛ هو مِنِّي سفَرٌ : بعيد)\nمثال: صاحبته في السفر.",
 "toboggan": "زلاجة توبوجان (زلاجة طويلة وضيقة بدون زحافات؛ تنحني ألواحها للأعلى في المقدمة)",
 "toboggan cap": "قبعة تزلج, قبعة صوفية (قبعة صوفية محكمة القياس؛ غالباً ما يكون لها ذيل مستدق مع شرابة)",
 "tobogganing": "تزلج بالتوبوجان (الركوب على زلاجة طويلة خفيفة ذات حواجز يدوية منخفضة)",
 "tobogganist": "راكب زلاجة التوبوغان (شخص يركب زلاجة التوبوغان)",
 "tobramycin": "توبراميسين, نيبسين (مضاد حيوي (الاسم التجاري نيبسين) فعال بشكل خاص ضد البكتيريا سلبية الغرام)",
