 "tenor": "تِينُور (قريب في المدى من أعلى صوت ذكوريّ طبيعيّ بالغ) / تِينُورِيّ ((لآلة موسيقيَّة) وسط بين الألتو والباريتون أو الباص) / تينور, صوت رجالي حاد (نطاق الطبقة الصوتية لأعلى صوت رجالي) / فحوى, مضمون (المعنى العام أو جوهر الكلام)\nمثال: على الرغم من أنني اختلفت معه، إلا أنني استطعت متابعة فحوى حجته",
 "tenor clef": "مفتاح تينور (مفتاح يضع دو الوسطى على الخط الرابع للمدرج؛ يُستخدم لكتابة الموسيقى للباسون أو التشيلو أو أبواق التينور)",
 "tenor drum": "توم توم, طبل تينور (أي من الطبول المتنوعة ذات الرؤوس الصغيرة)",
 "tenor saxophonist": "عازف ساكسفون تينور (موسيقي يعزف على ساكسفون التينور)",
 "tenor voice": "تينور (صوت غنائي للذكور البالغين أعلى من الباريتون)",
 "tenoretic": "تينوريتيك (اسم تجاري لدواء خافض لضغط الدم يتكون من مزيج ثابت من أتينولول ومدر للبول)",
 "tenorist": "عازف ساكسفون تينور (موسيقي يعزف على ساكسفون التينور)",
 "tenormin": "أتينولول, تينورمين (حاصر بيتا فموي (الاسم التجاري تينورمين) يستخدم في علاج ارتفاع ضغط الدم والذبحة الصدرية؛ له آثار جانبية ضارة (الاكتئاب وتفاقم فشل القلب الاحتقاني وما…)",
 "tenoroon": "باسون تينور, تينورون (باسون تينور؛ مضبوط بنغمة خامسة أعلى من الباسون العادي)",
 "tenosynovitis": "التهاب الوتر وغمده (التهاب الوتر وغمده المحيط)",
 "tenpence": "عشرة بنسات (عملة عشرية قيمتها عشرة بنسات)",
 "tenpenny nail": "مسمار ثلاثة بوصة (مسمار طوله 3 بوصات)",
 "tenpin": "قننية البولينج (واحدة من القوارير الخشبية المستخدمة في لعبة البولينج)",
