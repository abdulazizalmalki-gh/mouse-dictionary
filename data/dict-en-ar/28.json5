 "tongue fern": "سرخس اللباد, سرخس اللسان (سرخس شرق آسيوي له سعف يشبه الألسنة؛ يوضع أحياناً في جنس سيكلوفوروس)",
 "tongue tie": "التصاق اللسان, عقدة اللسان (شذوذ خلقي يكون فيه الغشاء المخاطي تحت اللسان قصيراً جداً مما يحد من حركة اللسان)",
 "tongue twister": "جملة صعبة النطق, عقدة لسان (تعبير يصعب نطقه بوضوح)",
 "tongue worm": "دودة اللسان (مفصلي يشبه الدودة له زوجان من الخطافات على جانبي الفم؛ طفيلي في الجيوب الأنفية للثدييات)",
 "tongue-fish": "سمكة اللسان (سمكة بحرية مفلطحة يسرى العين يستدق ذيلها إلى نقطة؛ ذات قيمة تجارية قليلة)",
 "tongue-flower": "زهرة اللسان (أوركيد ذو زهور زرقاء إلى أرجوانية بنتوءات (ثفنات) على شكل لسان أو شريط عند قاعدة الشفة)",
 "tongue-in-cheek": "على سبيل المزاح, مازحاً (ليس بجدية) / بِدُعَابَة, بِمُزَاح (بطريقة مازحة) / فَكِه, مُمَازِح (مُسَلٍّ بذكاء في الأسلوب)\nمثال: قصدت ذلك مازحاً",
 "tongue-lashing": "تَعْنِيف, تَقْرِيع (توبيخ شخص ما بقسوة)",
 "tongue-shaped": "لِسَانِيُّ الشَّكْلِ (ذو شكل يشبه اللسان)",
 "tongue-tied": "عَاجِز عَن التَّعْبِير, مُتَلَعْثِم (غير قادر على التعبير عن نفسه بوضوح أو طلاقة)",
 "tongue-twister": "تَنَافُر",
 "tongued": "ذُو لِسَان, مُتَكَلِّم بِطَرِيقَة مُعَيَّنَة (ذو أسلوب كلام محدّد؛ يُستعمَل غالبًا في التركيب) / ذو لسان (مزود بلسان أو ما يشبه اللسان؛ غالبًا ما تستخدم في المركبات)\nمثال: أحذية ذات ألسنة",
 "tonguefish": "سمكة اللسان (سمكة بحرية مفلطحة يسرى العين يستدق ذيلها إلى نقطة؛ ذات قيمة تجارية قليلة)",
 "tongueflower": "زهرة اللسان (أوركيد ذو زهور زرقاء إلى أرجوانية بنتوءات (ثفنات) على شكل لسان أو شريط عند قاعدة الشفة)",
 "tongueless": "بِلَا كَلَام, صَامِت (مُعبَّر عنه دون استخدام الكلام أو الألفاظ) / بلا لسان (يفتقر إلى لسان)\nمثال: خف (موكاسين) بلا لسان",
 "tongueless frog": "ضفدع عديم اللسان (ضفدع مائي بالكامل تقريباً موطنه أفريقيا وبنما وشمال أمريكا الجنوبية)",
 "tonguelike": "لِسَانِيُّ الشَّكْل (يُشْبِهُ اللِّسَانَ فِي الشَّكْلِ أَوِ الوَظِيفَة)",
 "tonguetip": "ذَلَق, أَسَلَة (ذَلِقَ اللِّسانُ: كَانَ ذَلِقًا، ذَليقًا، أَيْ فَصِيحًا، طَلْقًا؛ ذَلِقَ السَّيْفُ: كَانَ حَادًّا، يقال زَلَّقَ أي حَدَّدَهُ، زَلَقَهُ)",
 "tonguing and grooving plane": "مِسْحَج التعشيق, مِسْحَج التلسين (مسحج يحتوي على قواطع مصممة لعمل الألسنة والأخاديد على حواف الألواح المتطابقة)",
 "tonic": "مُنَبِّه, مُنْعِش (يبثّ الحيوية والطاقة) / منبور, نغمي ((للمقاطع) تحمل النبرة الرئيسية، وعادة ما تكون مصحوبة بتغيير في طبقة الصوت) / أَسَاسِيّ نَغْمِيّ (متعلق بالنغمة الأساسية في السلم الكبير أو الصغير أو كائنها) / نغمي (يستخدم تنوعات في طبقة الصوت لتمييز معاني الكلمات المتشابهة)\nمثال: المقطع النغمي يحمل النبرة الرئيسية في الكلمة",
 "tonic accent": "نبر نغمي (تأكيد ينتج عن الحدة بدلاً من الجهارة)",
 "tonic epilepsy": "صرع توتري (صرع يكون فيه الجسم متصلباً أثناء النوبة)",
 "tonic key": "سلم أساسي, مفتاح المنزل (السلم الأساسي الذي كُتبت به مقطوعة موسيقية)",
 "tonic solfa": "صولفا (نظام صولفيج يستخدم مقاطع الصولفا: دو، ري، مي، فا، صول، لا، سي)",
 "tonic water": "مَاء التُونِك (السائل الشفاف المعروف الذي تنشأ به الحياة، عديم اللون والرائحة والطعم عندما يكون نقيا؛ علميا فِي : جزيئة متكونة من ذرتي هيدروجين مرتبطين بذرة واحدة من الأوكسيجين)\nمثال: أنا أشرب الماء.",
 "tonicity": "توتر عضلي, توترية (التوتر المرن للعضلات الحية والشرايين وما إلى ذلك مما يسهل الاستجابة للمحفزات)\nمثال: اختبر الطبيب توتر عضلاتي",
 "tonight": "هٰذَا الْمَسَاء, اللَّيْلَ / اَللَّيْلَة",
 "tonka bean": "شجرة التونكا, فول التونكا (شجرة طويلة في أمريكا الجنوبية الاستوائية لها قرون لبية بيضاوية الشكل تحتوي على بذور سوداء عطرية تشبه اللوز تستخدم للنكهة) / فول التونكا (بذور عطرية سوداء تشبه الجوز لشجرة فول التونكا؛ تستخدم في العطور والأدوية وكبديل للفانيليا)",
 "tonka bean tree": "شجرة التونكا, فول التونكا (شجرة طويلة في أمريكا الجنوبية الاستوائية لها قرون لبية بيضاوية الشكل تحتوي على بذور سوداء عطرية تشبه اللوز تستخدم للنكهة)",
 "tonkin cane ski pole": "عصا تزلج تونكين (عصا تزلج مصنوعة من قصب تونكين، وهو نوع من الخيزران)",
 "tonkin ski pole": "عصا تزلج تونكين (عصا تزلج مصنوعة من قصب تونكين، وهو نوع من الخيزران)",
 "tonnage": "رسوم الحمولة (ضريبة تفرض على السفن التي تدخل الولايات المتحدة؛ وتعتمد على حمولة السفينة)",
 "tonnage duty": "رسوم الحمولة (ضريبة تفرض على السفن التي تدخل الولايات المتحدة؛ وتعتمد على حمولة السفينة)",
 "tonne": "طن, طن متري (وحدة وزن تعادل 1000 كيلوغرام)",
 "tonne-kilometer": "طن-كيلومتر (وحدة قياس تُستخدم في نقل البضائع تحدد نقل طن واحد من البضائع لمسافة كيلومتر واحد)",
 "tonne-kilometre": "طن-كيلومتر (وحدة قياس تُستخدم في نقل البضائع تحدد نقل طن واحد من البضائع لمسافة كيلومتر واحد)",
 "tonocard": "توكاينيد, تونوكارد (دواء مضاد لاضطراب النظم (الاسم التجاري تونوكارد) يستخدم لعلاج عدم الانتظام البطيني عندما تفشل الأدوية الأقل خطورة)",
 "tonograph": "تونوجراف, مسجل التوتر (مقياس توتر مسجل، يستخدم في الطب)\nمثال: مقياس التوتر هو جهاز يقوم بتسجيل قياسات التوتر",
 "tonometer": "تونومتر, مقياس التوتر (أداة قياس لقياس التوتر أو الضغط (خاصة لقياس ضغط العين في اختبار الجلوكوما))",
 "tonometry": "قياس ضغط العين (قياس ضغط العين عن طريق تحديد مقدار القوة اللازمة لعمل مسافة بادئة طفيفة في القرنية)",
 "tons": "أطنان, أكوام (عدد أو كمية كبيرة)\nمثال: كون الكثير من الصداقات الجديدة",
 "tonsil": "لَوْزَة",
 "tonsilla": "لوزة, لوزة حنكية (إحدى كتلتين من النسيج اللمفاوي تقعان على جانبي البلعوم الفموي)",
 "tonsilla adenoidea": "لحمية, لوزة بلعومية (تجمع من الأنسجة اللمفاوية في الحلق خلف اللهاة (على الجدار الخلفي وسقف البلعوم الأنفي))\nمثال: تضخم اللوزتين البلعوميتين يسمى اللحمية",
 "tonsilla pharyngealis": "لحمية, لوزة بلعومية (تجمع من الأنسجة اللمفاوية في الحلق خلف اللهاة (على الجدار الخلفي وسقف البلعوم الأنفي))\nمثال: تضخم اللوزتين البلعوميتين يسمى اللحمية",
 "tonsillectomy": "استئصال اللوزتين (إزالة جراحية للوزتين الحنكيتين؛ تجرى عادة جنباً إلى جنب مع استئصال اللحمية)",
 "tonsillitis": "التهاب اللوزتين (التهاب اللوزتين (خاصة اللوزتين الحنكية))",
 "tonsorial": "حلاقي (من أو متعلق بالحلاقين والحلاقة)\nمثال: عمل الحلاقة",
 "tonsure": "حلاقة الترهب, طونسورة (حلاقة قمة الرأس من قبل الكهنة أو أعضاء الرهبنة) / قرعة (تاج الرأس المحلوق للراهب أو الكاهن)",
 "tonsured": "مَحْلُوق الرَّأْس, مُقَصَّر (ذو بقعة صلعاء محلوقة أو طبيعية على الرأس)",
 "tontine": "تونتين (نظام للمعاشات السنوية يتشارك فيه المشاركون مزايا معينة، وعند وفاة أي مشارك يعاد توزيع مزاياه بين المشاركين الباقين؛ يمكن أن يستمر لفترة محددة أو حتى…) / تأمين تونتين (شكل من أشكال التأمين على الحياة حيث يتم توزيع حصة المشارك عند وفاته أو تخلفه عن السداد على الأعضاء المتبقين)",
 "tontine insurance": "تأمين تونتين (شكل من أشكال التأمين على الحياة حيث يتم توزيع حصة المشارك عند وفاته أو تخلفه عن السداد على الأعضاء المتبقين)",
 "tonus": "توتر عضلي, توترية (التوتر المرن للعضلات الحية والشرايين وما إلى ذلك مما يسهل الاستجابة للمحفزات)\nمثال: اختبر الطبيب توتر عضلاتي",
 "too": "أَيْضًا, كَذٰلِكَ / أَكْثَرَ مِنَ اللّازِمِ, لِلْغايةِ",
 "too bad": "مُؤْسِف, يُؤْسَفُ لَهُ (يَسْتَحِقُّ الأَسَفَ أَوِ النَّدَمَ)",
 "too big for one's breeches": "مَغْرُور, مُتَعَالٍ ((غير رسمي) مفرط في الغرور والتعالي)",
 "too large": "مُفْرِط الكِبَر (كبير بشكل مفرط)",
 "too much": "بإفراط, كثيراً جداً (أكثر مما يلزم)\nمثال: إنها تأكل كثيراً جداً",
 "too soon": "قبل الأوان, مبكراً (قبل الوقت المعتاد أو المتوقع)\nمثال: تخرجت مبكراً",
 "too-careful": "مُفْرِط الحَذَر (حَذِر بِشَكْلٍ مُبَالَغ فِيه أَوْ زَائِد عَنِ الحَدّ)",
 "too-generous": "بَاذِخ, مُسْرِف فِي العَطَاء (بالغ السخاء؛ يُعطي بإسراف ودون حساب)",
 "too-greedy": "مُفْرِط الشَّرَه (شَرِه بإفراط مُبالَغ فيه)",
 "tool": "أَدَاة",
 "tool bag": "حقيبة أدوات (حقيبة تُحمل فيها الأدوات)",
 "tool cabinet": "صندوق أدوات (صندوق أو خزانة لحفظ الأدوات اليدوية)",
 "tool case": "صندوق أدوات (صندوق أو خزانة لحفظ الأدوات اليدوية)",
 "tool chest": "صندوق أدوات (صندوق أو خزانة لحفظ الأدوات اليدوية)",
 "tool kit": "عدة نجار (مجموعة من أدوات النجار)",
 "tool steel": "صلب العدة, فولاذ العدد (فولاذ سبائكي مناسب لصنع الأدوات؛ صلب ومتين ويمكنه الحفاظ على حافة القطع)",
 "tool-and-die work": "صناعة القوالب والعدد (حرفة صنع الأدوات والقوالب الخاصة)",
 "toolbox": "صَنْدُوق اَلْعِدَّة (وعاء كبيرة من الخشب غالبا وقد يكون حديدًا يستخدم لوضع الاشياء داخله، ويكون لها عادة جهة قابلة للفتح سواء بمفاصل او بالازالة الكاملة؛ صُنْدُوْقُ السَيَّارَة قمرة تشبه الصندوق في الجزء الخلفي من السيارة يستخدم كالصندوق)\nمثال: أين صندوق البريد؟",
 "toolhouse": "سقيفة الأدوات (سقيفة لتخزين الأدوات)",
 "toolkit": "المعدات / الأدوات",
 "toolmaker": "صانع أدوات (شخص ماهر في صنع أو إصلاح الأدوات)",
 "toolshed": "سقيفة الأدوات (سقيفة لتخزين الأدوات)",
 "tooltip": "تَلْمِيح",
 "toon": "رسوم متحركة, كرتون (فيلم مصنوع بتصوير سلسلة من الرسومات الكرتونية لإعطاء وهم الحركة عند عرضها في تسلسل سريع)",
 "toona calantas": "أرز فلبيني, ماهوجني فلبيني (شجرة خشبية فلبينية ذات خشب أحمر صلب وعطري)",
 "tooshie": "أرداف, ألية (الجزء اللحمي من جسم الإنسان الذي يجلس عليه)\nمثال: يستحق ركلة جيدة في مؤخرته",
 "toot": "حفل سُكْر, معاقرة الخمر (الاحتفال الصاخب بشرب الكحول؛ حفلة شرب مرحة) / زمير (نفخة بوق)",
 "toot one's own horn": "يتفاخر",
 "tooth": "سِنّ, سن ((سَنَّ) السِّكِّينَ و نحْوَهُ يَسُنُّ سَنًّا: أَحَدَّهُ؛ فهو مسنون وسَنِين)\nمثال: هم في نفس السن.",
 "tooth and nail": "باستماتة, بكل قوة (بقوة وشراسة)\nمثال: قاتلت باستماتة",
 "tooth decay": "تسوس, تسوس الأسنان (منطقة لينة متآكلة في السن؛ ويمكن أن يؤدي التسوس التدريجي إلى موت السن)",
 "tooth doctor": "طبيب أسنان (شخص مؤهل لممارسة طب الأسنان)",
 "tooth enamel": "مينا, مينا الأسنان (مادة بيضاء صلبة تغطي تاج السن)",
 "tooth fairy": "جِنِّيّ أَسْنَان (جَنِيَ يَجْنَى جَنًى: خرج ظهرُه ودخلَ صدرُه؛ فهو أَجْنى)",
 "tooth fungus": "فطر مسنن (فطر من فصيلة هيدناسيا)",
 "tooth powder": "مسحوق الأسنان (مستحضر لتنظيف الأسنان في شكل مسحوق)",
 "tooth shell": "صدفة سنية (أي من رخويات شاطئ البحر المختلفة التي لها صدفة أنبوبية مستدقة مفتوحة من كل طرف وقدم مدببة مثل المجرفة للحفر)",
 "tooth socket": "سنخ السن (تجويف عظمي في النتوء السنخي يحمل سناً)",
 "toothache": "أَلَمُ أَسْنَان, أَلَمُ الْأَسْنَان (الوَجَع)\nمثال: ألم أقل لك ذلك؟",
 "toothache tree": "شجرة ألم الأسنان, فاغرة أمريكية (شجيرة (أو شجرة) عطرية صغيرة متساقطة الأوراق ذات فروع شائكة وزهور صفراء؛ موطنها شرق أمريكا الشمالية)",
 "toothbrush": "فُرْشَاة أَسْنَان",
 "toothbrush tree": "أَرَاك",
 "toothed": "مُتَآكِل, مُحَزَّز (ذو حافة محزّزة أو مسنّنة بشكل غير منتظم كأنّها مقضومة) / مُسَنَّنٌ تَسْنِينًا مِنْشَارِيًّا, مِنْشَارِيّ (محزّز كالمنشار بأسنان تتّجه نحو القمّة) / ذو أسنان, مسنن (له أسنان خاصة بعدد أو نوع معين؛ غالبًا ما تستخدم في المركبات)\nمثال: منشاري الأسنان",
 "toothed spurge": "فربيون مسنن (عشبة سنوية في شمال شرق أمريكا الشمالية ذات أوراق مسننة)",
 "toothed sword fern": "سرخس السلة, سرخس السيف المسنن (سرخس أمريكي استوائي يزرع لأوراقه الخضراء الرمادية المقسمة بدقة؛ جزر الهند الغربية وجنوب المكسيك إلى بيرو والبرازيل)",
 "toothed whale": "حوت مسنن (أي من عدة حيتان لها أسنان مخروطية بسيطة وتتغذى على الأسماك وما إلى ذلك)",
 "toothed wheel": "عجلة مسننة للتخريم (عجلة ذات أسنان لعمل صف من الثقوب)",
 "toothless": "بِلَا أَنْيَاب, عَاجِز (يفتقر إلى القوّة اللازمة للفاعلية) / أدرد, بلا أسنان (يفتقر إلى الأسنان)\nمثال: معظم الطيور بلا أسنان",
 "toothlessness": "خلو الفم من الأسنان, درد (حالة أو وضعية عدم وجود أسنان)\nمثال: بشكل غير متوقع، استحضر صورة طبيب الأسنان المسؤول عن خلو فمه من الأسنان",
 "toothlike": "سِنِّيّ الشَّكْل (يشبه السن في شكله)",
 "toothpaste": "مَعْجُون الأَسْنَان",
 "toothpick": "عُود تَخْلِيل أَسْنَان, خِلَال (قطعة من الخشب كالعصا جمعه عيدان؛ ما يُتَبَخَّر به)\nمثال: أشعلت عود ثقاب.",
 "toothpowder": "مسحوق الأسنان (مستحضر لتنظيف الأسنان في شكل مسحوق)",
 "toothsome": "لذيذ, مستساغ (مقبول للطعم أو للعقل) / فَاتِن, مُغْرٍ جِنْسِيًّا (ذو جاذبية جنسية قوية) / شَهِيٌّ لِلغَايَة, لَذِيذٌ جِدًّا (بَالِغُ اللَّذَّةِ لِحَاسَّةِ التَّذَوُّق)\nمثال: طعام مستساغ",
 "toothsomeness": "شهية, لذة شديدة (جاذبية شديدة للشهية)",
 "toothwort": "جذر مجعد, عشبة الأسنان (عشبة أمريكية شمالية بجذور حرشفية أو مسننة لاذعة)",
 "toothy": "بَارِز الأَسْنَان (له أسنان بارزة أو يُظهرها)",
