 "tammy": "تام, قبعة تام (قبعة صوفية من أصل اسكتلندي) / تامي (قماش سادة النسج (غالباً مصقول) من الصوف أو الصوف والقطن يستخدم خاصة قديماً للبطانات والملابس والستائر)",
 "tamoxifen": "تاموكسيفين, مضاد الاستروجين (مضاد للاستروجين يستخدم في علاج سرطان الثدي)",
 "tamp": "مِدَكّ (أداة للدك (مثل دك التبغ في الغليون أو الحشوة في ثقب الحفر وما إلى ذلك))",
 "tampax": "تامباكس (حشوة قطنية تستخدم لامتصاص تدفق الحيض)",
 "tamper": "عَبِثَ (لعب بما لا يعنيه؛ عَمَلَ بلا هدف أو فائدة)\nمثال: انه لهو عبث ان نناقش.",
 "tampering": "تدخل, تلاعب (فعل تغيير شيء ما سراً أو بشكل غير لائق)",
 "tamping bar": "مِدَكّ (أداة للدك (مثل دك التبغ في الغليون أو الحشوة في ثقب الحفر وما إلى ذلك))",
 "tampion": "سدادة فوهة المدفع (سدادة لفوهة السلاح لإبعاد الغبار والرطوبة)",
 "tampon": "سِدَادَة, سِدَادَة قُطْنِيَّة",
 "tamponade": "اندكاك, سدادة (انسداد أو إغلاق (لجرح أو تجويف في الجسم) بواسطة (أو كما لو كان بواسطة) سدادة قطنية (خاصة لوقف النزيف))",
 "tamponage": "اندكاك, سدادة (انسداد أو إغلاق (لجرح أو تجويف في الجسم) بواسطة (أو كما لو كان بواسطة) سدادة قطنية (خاصة لوقف النزيف))",
 "tamus communis": "تاموس شائع, كرمة سوداء (كرمة أوروبية شائعة ملتفة ذات جذور درنية وأوراق قلبية الشكل وثمار لبية حمراء)",
 "tan": "حِنْطِيّ / قَمْحِيُّ اللَّوْن / اِسْمَرَّ / دَبَغَ (عالجه بمادة ليلين وَيَزُول مَا بِهِ من رُطُوبَة ونتن؛ دبغ الْمَطَر الأَرْض بمائه فَهُوَ دابغ ودبوغ وَالْمَفْعُول مدبوغ ودبيغ)",
 "tanabe": "تانابي, تانابه",
 "tanacetum balsamita": "بلسم الحدائق, حشيشة مريم (عشب معمر أوراسي برائحة حشيشة الدود له أزهار صفراء تشبه الأزرار؛ يستخدم كبقلة أو خضروات للسلطة وأحياناً في المعطرات المجففة أو الشاي أو النكهة؛ يوضع…)",
 "tanacetum camphoratum": "حشيشة الدود الكافورية (نبات مشعر بكثافة بأزهار عديمة الشعاع؛ منطقة خليج سان فرانسيسكو)",
 "tanacetum cinerariifolium": "بيرثروم, عاقر قرحا (بيرثروم أبيض الزهر من منطقة البلقان أوراقه الريشية بيضاء ومشعرّة حريرياً من الأسفل؛ مصدر لمبيد حشري؛ يوضع أحياناً في جنس أقحوان)",
 "tanacetum coccineum": "أقحوان ملون, بيريثروم (نبات حديقة معمر يزهر في الربيع من أصل آسيوي له أوراق عطرية مقسمة بدقة وزهور بيضاء إلى وردية أرجوانية؛ مصدر لمبيد حشري)",
 "tanacetum douglasii": "حشيشة الدود الشمالية (نبات معمر جذموري مشعر قليلاً له أوراق ريشية عطرية وسيقان تحمل عناقيد مفتوحة من الزهور الصفراء الصغيرة التي تشبه الأزرار؛ الكثبان الرملية لساحل المحيط…)",
 "tanacetum parthenium": "اقحوان زهرة الذهب, زهرة اللبن (عشب معمر أوروبي عطري كثيف له عناقيد من رؤوس زهرية بيضاء الشعاع تشبه الأزرار؛ ذو قيمة تقليدية للاستخدامات الطبية؛ يوضع أحياناً في جنس أقحوان)",
 "tanacetum ptarmiciflorum": "دانتيل فضي, طاحونة الغبار (شجيرة معمرة في جزر الكناري ذات زهور وأوراق بيضاء وسيقان مشعرة مغطاة بزغب يشبه الغبار؛ توضع أحياناً في جنس الأقحوان)",
 "tanacetum vulgare": "أزرار ذهبية, حشيشة الدود (عشبة عطرية معمرة شائعة موطنها أوراسيا ذات رؤوس زهور صفراء تشبه الأزرار وأوراق ريشية مرة الطعم تستخدم أحياناً طبياً)",
 "tanager": "تناجر (أي من الطيور العديدة في غابات العالم الجديد التي يتميز ذكورها بألوان زاهية)",
 "tanakh": "تَنَاخ",
 "tanbark": "قَرَظ, لِحَاء الدِّبَاغَة (لحاء غني بالتانين؛ يهرس ويقطع لقطع لاستخدامه في الدباغة؛ يستخدم اللحاء المستهلك كغطاء للأرضية)",
 "tanbark oak": "بلوط الدباغة (شجرة دائمة الخضرة في منطقة ساحل المحيط الهادئ ذات أوراق جلدية كبيرة؛ تنتج مادة الدباغة)",
 "tanbur": "طنبور",
 "tandearil": "أوكسيفينبوتازون, تاندياريل (دواء مضاد للالتهاب (الاسم التجاري تاندياريل) يستخدم لعلاج التهاب المفاصل والتهاب الجراب)",
 "tandem": "بالتَّرَادُف, خَلْف بَعْضِهِمَا (واحد خلف الآخر) / تاندم, دراجة ثنائية المقاعد (دراجة بمجموعتين من الدواسات ومقعدين) / تَرَادُف, تَرْتِيب تَرَادُفِيّ (ترتيب لشيئين أو شخصين أو أكثر، واحد خلف الآخر)\nمثال: ركوب بالتتابع على دراجة مصممة لراكبين",
 "tandem bicycle": "تاندم, دراجة ثنائية المقاعد (دراجة بمجموعتين من الدواسات ومقعدين)",
 "tandem trailer": "شاحنة بمقطورتين (شاحنة نقل مع مقطورتين جنباً إلى جنب)",
 "tandoor": "تَنُّور",
 "tanekaha": "تانيكاها (صنوبر كرفس متوسط الطول من نيوزيلندا)",
