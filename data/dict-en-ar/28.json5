 "tasmanian": "تسماني (مكون من أو متعلق بتسمانيا)",
 "tasmanian devil": "شيطان تسمانيا ((في الأديان الإبراهيمية) الرُّوح الشِّرِّير الَّذِي يَرْمِي بِكَ لِلتَّهْلُكَةِ لِبُعْدِهِ عَنِ الْخَيْرِ وَطَرِيقِ الْحَقِّ؛ (استعمال مجازي) كُلّ وَلَدٍ مُشَاكِسٍ أَوْ مُتَمَرِّدٍ)\nمثال: العجلة من الشيطان.",
 "tasmanian tiger": "ذئب تسماني, نمر تسماني (جرابي لاحم نادر يشبه الكلب من تسمانيا له خطوط على ظهره؛ ربما يكون منقرضاً)",
 "tasmanian wolf": "ذئب تسماني, نمر تسماني (جرابي لاحم نادر يشبه الكلب من تسمانيا له خطوط على ظهره؛ ربما يكون منقرضاً)",
 "tasse": "واقي الفخذ العلوي (واحدة من قطعتين من الدرع الصفيحي تتدليان من تنورة الدرع لحماية الفخذين العلويين)",
 "tassel": "شُرَّابَة",
 "tassel flower": "حب الحب, زهرة القطيفة (تستخدم الأوراق الصغيرة على نطاق واسع كخضروات ورقية؛ تستخدم البذور كحبوب) / إميليا قرمزية, زهرة الشرابة (نبات حولي أفريقي استوائي له رؤوس زهرية قرمزية على شكل شرابة؛ يوضع أحياناً في جنس كاكاليا) / زهرة الشرابة (نبات حولي آسيوي استوائي يزرع لرؤوسه الصغيرة ذات الشكل الشرابي من الزهور القرمزية)",
 "tassel hyacinth": "مسكاري شرابة, ياقوتية شرابة (نوع متوسطي كبير جميل له زهور بنفسجية مزرقة عقيمة بتويجات مهدبة تشكل خصلة فوق الزهور الخصبة)",
 "tassel-shaped": "شُرَّابِيّ الشَّكْل (على شكل شُرّابة)",
 "tasseled": "ذُو شَرَابَات, مُزَيَّن بِشَرَابَات (مهدب أو مزين بشرابات زخرفية)",
 "tasselled": "ذُو شَرَابَات, مُزَيَّن بِشَرَابَات (مهدب أو مزين بشرابات زخرفية)",
 "tasset": "واقي الفخذ العلوي (واحدة من قطعتين من الدرع الصفيحي تتدليان من تنورة الدرع لحماية الفخذين العلويين)",
 "taste": "ذَوْق, طَعْم (الذَّوْقُ : حَاسَّةُ اللِّسَانِ وَبِهَا قُوَّةٌ تُدْرِكُ خَوَاصَّ الأَجْسَامِ الطَّعْمِيَّةَ؛ الذَّوْقُ : آدابُ السلوك التي تقتضي معرفة ما هو لائق أو مناسب في موقف اجتماعيّ معيّن) / ذَوْق (الذَّوْقُ : حَاسَّةُ اللِّسَانِ وَبِهَا قُوَّةٌ تُدْرِكُ خَوَاصَّ الأَجْسَامِ الطَّعْمِيَّةَ؛ الذَّوْقُ : آدابُ السلوك التي تقتضي معرفة ما هو لائق أو مناسب في موقف اجتماعيّ معيّن) / ذَاقَ, تَذَوَّقَ (تناول شيئا من الطعام أو الشراب ليختبر طَعْمَه؛ جَرَّبَ، اِخْتًبَرَ، أَحَسَّ)\nمثال: أكره ذوق الكحول.",
 "taste bud": "برعم ذوقي (عضو حسي بيضاوي نهائي على سطح اللسان)",
 "taste cell": "خلية ذوقية (خلية طلائية في برعم التذوق تنشط الألياف الحسية للعصب الوجهي أو العصب البلعومي اللساني أو العصب المبهم)",
 "taste perception": "تذوق, ذوق (الإحساس الناتج عندما تنقل براعم التذوق في اللسان والحلق معلومات حول التركيب الكيميائي لمادة قابلة للذوبان)\nمثال: تركت الحلوى طعماً سيئاً لديه",
 "taste property": "خاصية ذوقية (خاصية تُقدر عن طريق حاسة التذوق)",
 "taste sensation": "تذوق, ذوق (الإحساس الناتج عندما تنقل براعم التذوق في اللسان والحلق معلومات حول التركيب الكيميائي لمادة قابلة للذوبان)\nمثال: تركت الحلوى طعماً سيئاً لديه",
 "taste tester": "ذوّاق, مُختبر الطعم (شخص يتذوق الطعام أو الشراب لتقييم جودته)",
 "taste-maker": "مبتكر الموضة, واضع الصيحة (شخص يروج لموضة جديدة ويجعلها شائعة)",
 "taste-tester": "ذوّاق, مُختبر الطعم (شخص يتذوق الطعام أو الشراب لتقييم جودته)",
 "tastebud": "بُرْعُم تَذَوُّق, بُرْعُم ذَوْقِيّ",
 "tasteful": "أنيق, ذو ذوق رفيع (يمتلك أو يظهر أو يتوافق مع الذوق السليم)",
 "tastefully": "بذوق رفيع (بذوق؛ بطريقة تنم عن ذوق)\nمثال: كان المنزل مزيناً بذوق رفيع",
 "tastefulness": "ذَوْق رَفِيع (الأناقة التي يدل عليها الذوق الرفيع)",
 "tasteless": "عديم الذوق, مبتذل (يفتقر إلى الذوق الجمالي أو الاجتماعي) / عديم النكهة, لا طعم له (يفتقر إلى النكهة)",
 "tastelessly": "بلا ذوق (بدون ذوق أو بذوق سيء)\nمثال: كان المنزل مزيناً بلا ذوق",
 "tastelessness": "انْعِدَام الذَّوْق (عدم الأناقة الذي يدل عليه الافتقار إلى الذوق الرفيع) / انعدام النكهة, تفاهة (خاصية عدم امتلاك أي نكهة)",
 "taster": "مُتَذَوِّق",
 "tastily": "بذوق رفيع (بذوق؛ بطريقة تنم عن ذوق) / بشهية, بمذاق طيب (بطريقة لذيذة)\nمثال: كان المنزل مزيناً بذوق رفيع",
 "tastiness": "طيب المذاق, لذة (استساغة ممتعة)",
 "tasting": "مَذَاق (مَا تُدْرِكُهُ حَاسَّةُ الذَّوْق)\nمثال: التين حلو المذاق.",
 "tasty": "شهي, طيب المذاق (ممتع لحاسة التذوق)\nمثال: لقمة لذيذة",
 "tat": "اختبار تفهم الموضوع (تقنية إسقاطية تستخدم صورًا بالأبيض والأسود؛ يروي الأشخاص قصة عن كل صورة) / ابْتِذَال, رُخْص (انعدام الذوق لكون الشيء رخيصاً ومبتذلاً)",
