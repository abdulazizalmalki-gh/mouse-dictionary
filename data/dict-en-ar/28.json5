 "thick": "سَمِيك, غَلِيظ / غَلِيظ",
 "thick skin": "جِلْد سَمِيك (جلد سميك جداً (كما في الفيل أو وحيد القرن))",
 "thick-billed": "سَمِيك المِنْقَار (ذو منقار سميك وعريض)",
 "thick-billed murre": "مور غليظ المنقار (نوع من طائر المور)",
 "thick-bodied": "سَمِيكُ الجَسَد (لَهُ جَسَدٌ سَمِيكٌ وَضَخْم)",
 "thick-branched": "غَلِيظُ الأَغْصَان (لَهُ أَغْصَانٌ سَمِيكَة)",
 "thick-footed morel": "موريل سميك القدم (موريل لذيذ بجزء خصب مخروطي به حفر عميقة وغير منتظمة)",
 "thick-haired": "كَثِيف الشَّعْر (ذو شعر غزير وكثيف)",
 "thick-knee": "كروان الحصى (طائر شاطئي كبير الرأس والعينين ينشط عند الغسق أو ليلاً من العالم القديم وأمريكا الاستوائية وله مفصل ركبة سميك)",
 "thick-lipped": "غَلِيظُ الشَّفَتَيْنِ (ذُو شِفَاهٍ سَمِيكَة)",
 "thick-skinned": "غَلِيظ الجِلْد, لَا يُبَالِي بِالنَّقْد (غير حسّاس للنقد والانتقاد)",
 "thick-skulled": "بَلِيد, غَلِيظ الفَهْم ((غير رسمي) غبيّ وبطيء الفهم)",
 "thick-spread": "مَدْهُون بِسَمَاكَة (مغطى بطبقة سميكة)",
 "thick-stemmed": "سَمِيك السَّاق (ذو ساق سميكة)",
 "thicken": "غَلَّظَ / عَقَّدَ (العَشْر من السَنَوَات؛ الاتِّفَاق والعَهْد بين طرفين)\nمثال: أمضى زيري العقد.",
 "thickened": "مُثَخَّن (جُعِلَ سَمِيكًا أَوْ أَصْبَحَ سَمِيكًا) / مُكَثَّف (جُعِلَ ثَخِينَ القِوَام) / سَمِيك الجِلْد, مُتَثَفِّن (عليه ثفن؛ ذو جلد أصبح سميكًا وخشنًا من كثرة الاستعمال)",
 "thickener": "مادة مكثفة, مكثف (أي مادة تستخدم للتثخين)\nمثال: يستخدم النشا في الطهي كمكثف",
 "thickening": "تثخين, تغليظ (فعل التغليظ أو التثخين) / مُتَزَايِد التَّعْقِيد (يَزْدَاد تَعْقِيدًا وَتَشَابُكًا) / تغلظ, عقدة (أي تضخم سميك) / مادة مكثفة, مكثف (أي مادة تستخدم للتثخين)\nمثال: يستخدم النشا في الطهي كمكثف",
 "thicket": "عَرِين (اِسْمٌ لِمَاْوَى الأَسَد)",
 "thicket-forming": "مُكَوِّنٌ لِلْأَجَمَاتِ (يَمِيلُ إِلَى تَكْوِينِ أَجَمَاتٍ كَثِيفَةٍ)",
 "thickhead": "صفار (طيور أسترالية وجنوب شرق آسيوية ذات نداء صفير شجي)",
 "thickheaded": "بَلِيد, غَلِيظ الفَهْم ((غير رسمي) غبيّ وبطيء الفهم)",
 "thickly": "بِاكْتِظَاظ, بِكَثَافَة (بطريقة مركزة) / بتتابع سريع, بكثافة (في تتابع سريع) / بلسان ثقيل (التحدث بلفظ ضعيف كما لو كان اللسان ثقيلاً) / بطبقة سميكة, بكثافة (بسمك؛ بطريقة سميكة)\nمثال: المنازل القديمة غالباً ما تكون مكتظة بكثافة لدرجة أنه ربما يجب هدم ثلاثة أو أربعة مقابل كل منزل جديد يبنى",
 "thickly settled": "آهِلٌ بِالسُّكَّان, كَثِيفُ السُّكَّان (ذو كثافة سكانية عالية)",
 "thickness": "سَمَاكَة",
 "thickset": "كَثِيفُ الغَرْسِ, مُتَلَاصِق (مَزْرُوعٌ أَوْ نَامٍ بِشَكْلٍ مُتَقَارِبٍ) / مَتِين البُنْيَة, مُمْتَلِئ الجِسْم (ذو بنية قصيرة وصلبة)",
 "thickspread": "مَدْهُون بِسَمَاكَة (مغطى بطبقة سميكة)",
 "thief": "لِصّ, لِصَّة",
 "thielavia basicola": "فطر عفن الجذور البني (فطر يسبب عفن الجذور البني في نباتات فصائل البازلاء والبطاطس والخيار)",
 "thieve": "سَرَقَ (أخذ ما كان لغيره خفية وبدون علم أحد)\nمثال: من سرق التفاحة؟",
 "thievery": "سرقة, لصوصية (فعل أخذ شيء من شخص ما بشكل غير قانوني)\nمثال: اللصوصية فظيعة في مطار كينيدي الدولي",
 "thieving": "سرقة, لصوصية (فعل أخذ شيء من شخص ما بشكل غير قانوني)\nمثال: اللصوصية فظيعة في مطار كينيدي الدولي",
 "thievish": "سَرَّاق, لُصُوصِيّ (ميَّال إلى السرقة)",
 "thievishly": "بأسلوب اللصوص (بطريقة مميزة للصوص)",
 "thievishness": "لصوصية, نزعة للسرقة (امتلاك ميل أو استعداد للسرقة)",
 "thigh": "فَخِذ, فَخْذ",
 "thigh boot": "جزمة الصيد, جزمة الفخذ (حذاء طويل جداً؛ يستخدم خاصة للصيد)",
 "thigh pad": "واقي فخذ (ملابس واقية تتكون من وسادة تلبس فوق الفخذين من قبل لاعبي كرة القدم)",
 "thigh-slapper": "نُكْتَة صَارِخَة, نُكْتَة مُضْحِكَة جِدًّا (نكتة تبدو مضحكة للغاية)",
 "thighbone": "عَظْم اَلْفَخِذ",
 "thill": "عريش العربة (أحد عمودين يمتدان من جسم العربة على جانبي الحيوان الذي يجرها)",
 "thimble": "كُشْتُبَان, كُسْتِبَان",
 "thimble-shaped": "كُشْتُبَانِيّ الشَّكْل (على شكل كُشتُبان)",
 "thimbleberry": "توت العليق الأسود (توت شوكي موطنه شرق أمريكا الشمالية له فاكهة سوداء على شكل كشتبان) / توت السلمون, توت الكشتبان (توت شوكي أبيض الزهور من غرب أمريكا الشمالية وشمال المكسيك بتوت برتقالي على شكل كشتبان) / توت العليق المزهر (توت شوكي شجيري من شرق أمريكا الشمالية له زهور وردية إلى أرجوانية ملفتة للنظر وفاكهة حمراء أو برتقالية على شكل كشتبان)",
 "thimbleful": "مقدار ضئيل, ملء كشتبان (بقدر ما يستوعبه كشتبان (يستخدم للكناية عن الكمية القليلة))",
 "thimblerig": "لعبة الثلاث ورقات, لعبة الكشتبان (لعبة خفة يد احتيالية؛ حيث يخمن الضحية أي من الأشياء الثلاثة توجد تحته الكرة)",
 "thimbleweed": "شقائق النعمان الأسطوانية, عشبة الكشتبان (شقائق نعمان شائعة في أمريكا الشمالية بعناقيد ثمار أسطوانية تشبه الكشتبانات)",
 "thimerosal": "ثيميروسال, ميرثيولات (مسحوق بلوري فاتح اللون (الاسم التجاري ميرثيولات) يستخدم كمطهر جراحي)",
 "thimphu": "تِيمْفُو (عاصمة مملكة بوتان)",
 "thin": "رَفِيع, رَقِيق / ضعيف, ضعيفة",
 "thin air": "فراغ, هواء (لا يمكن العثور عليه في أي مكان وكأنه اختفى في فراغ)\nمثال: اختفى في الهواء (كفص ملح وذاب)",
 "thin person": "نحيل, هزيل (شخص نحيف وهزيل بشكل غير عادي)",
 "thin-bodied": "نَحِيلُ الجَسَد (لَهُ جَسَدٌ نَحِيلٌ وَرَفِيع)",
 "thin-leaved bilberry": "عنب الجبل (توت أزرق قائم من غرب الولايات المتحدة له زهور منفردة وتوت حامض نوعاً ما)",
 "thin-leaved stringybark": "لحاء الخيط الأبيض (لحاء خيط له خشب أبيض)",
 "thin-shelled": "رَقِيقُ القِشْرَةِ (لِلْحَيَوَانَاتِ أَوِ النَّبَاتَاتِ الَّتِي لَهَا صَدَفَةٌ أَوْ قِشْرَةٌ رَقِيقَةٌ)",
 "thin-shelled mussel": "بلح البحر رقيق الصدفة (بلح بحر ذو أصداف رقيقة هشة لها أسنان مفصلية بدائية فقط)",
 "thin-skinned": "حَسَّاس, سَرِيع الغَضَب (سريع التأثّر والانزعاج من أيّ إساءة)",
 "thine": "لَك, لَكِ",
 "thing": "شَيْء, حاجة (الموجود عرضاً كان أو جوهراً، ويصح أن يتصور ويخبر عنه؛ مَا أُخْبِرَ عَنْهُ: سواء كان ما له وجود ماديّ أو معنوي، أو كان صفة أو فكرَة أو أمرًا)\nمثال: في يدها شيء ما.",
 "thing-in-itself": "شَيْء فِي ذَاتِهِ (الموجود عرضاً كان أو جوهراً، ويصح أن يتصور ويخبر عنه؛ مَا أُخْبِرَ عَنْهُ: سواء كان ما له وجود ماديّ أو معنوي، أو كان صفة أو فكرَة أو أمرًا)\nمثال: في يدها شيء ما.",
 "thingamabob": "أداة, أداة مبهمة الاسم (شيء غير محدد تم نسيان اسمه أو غير معروف)\nمثال: أعادت الأداة كروية الشكل إلى مكانها",
 "thingamajig": "أداة, أداة مبهمة الاسم (شيء غير محدد تم نسيان اسمه أو غير معروف)\nمثال: أعادت الأداة كروية الشكل إلى مكانها",
 "thingmabob": "أداة, أداة مبهمة الاسم (شيء غير محدد تم نسيان اسمه أو غير معروف)\nمثال: أعادت الأداة كروية الشكل إلى مكانها",
 "thingmajig": "أداة, أداة مبهمة الاسم (شيء غير محدد تم نسيان اسمه أو غير معروف)\nمثال: أعادت الأداة كروية الشكل إلى مكانها",
 "things": "أشياء, حوائج (أي حيازة منقولة (خاصة الملابس))\nمثال: حزمت أغراضها وغادرت",
 "thingumabob": "أداة, أداة مبهمة الاسم (شيء غير محدد تم نسيان اسمه أو غير معروف)\nمثال: أعادت الأداة كروية الشكل إلى مكانها",
 "thingumajig": "أداة, أداة مبهمة الاسم (شيء غير محدد تم نسيان اسمه أو غير معروف)\nمثال: أعادت الأداة كروية الشكل إلى مكانها",
 "thingummy": "أداة, أداة مبهمة الاسم (شيء غير محدد تم نسيان اسمه أو غير معروف)\nمثال: أعادت الأداة كروية الشكل إلى مكانها",
 "think": "فَكَرَ, فَكَّرَ (أَعْمَلَ عقله ليصل إلى شيءٍ، ليحل مشكلةً. (يتعدى تعدية عامة بفي)) / فَكَّرَ (أَعْمَلَ عقله ليصل إلى شيءٍ، ليحل مشكلةً. (يتعدى تعدية عامة بفي)) / ظَنَّ (عَلِمَ بغير يقين؛ عَلِمَ بيقين)\nمثال: إنها فكرة جيدة.",
 "think factory": "مؤسسة فكرية, مركز أبحاث (شركة تقوم بإجراء أبحاث مقابل أجر وتصدر تقارير حول التبعات)",
 "think piece": "مقال تحليلي, مقال رأي (مقال في صحيفة أو مجلة أو دورية يمثل آراء وأفكاراً ومناقشات بدلاً من مجرد حقائق مجردة)",
 "think tank": "خَلِيَّة تَفْكِير",
 "thinkable": "معقول, ممكن التفكير فيه (يمكن تصوره أو تخيله أو النظر فيه)",
 "thinker": "مُفَكِّر (اسم فاعل للفعل فَكَّرَ؛ اصطلاحا: هو شَخْص له عِلْم وفِكْر ودراية يعتد بها وقادر على التَنْظِير والتَحْلِيل، غالبا ما يؤخذ رأيه في أمور العامة وغالبا ما يؤلف كتبا)\nمثال: \"مفكرة الموت\" هو واحد من أفضل عشرة مسلسلات تلفزيونية عندي.",
 "thinking": "تفكير, فكر (عملية استخدام عقلك للنظر في شيء ما بعناية)\nمثال: التفكير دائماً ما يجعله يعبس",
 "thinking cap": "حالة تأمل, وضعية التفكير (حالة ينهمك فيها المرء بالتفكير)",
 "thinly": "بشكل خفيف, بقلة كثافة (بطريقة موزعة على نطاق واسع وقليلة الكثافة) / بشكل رقيق, بطبقة خفيفة (بكمية صغيرة أو مدى قليل) / بسيولة, بميوعة (بدون لزوجة) / بضعف, بفتور (بدون قوة أو جهد صادق)\nمثال: سفح جبل مغطى بالنباتات بشكل خفيف",
 "thinned": "مَمْزُوج بِالمَاء, مُخَفَّف (مَمْزُوج بِالمَاء)",
 "thinner": "مادة مخففة, مخفف (عامل تخفيف)",
 "thinness": "رِقَّة",
 "thinning": "تخفيف, مزج (عملية تخفيف شيء ما)\nمثال: تخفيف الويسكي بالماء",
 "thinning shears": "مقص تخفيف الشعر (مقص بشفرة واحدة مسننة؛ يستخدم لتخفيف الشعر)",
 "thiobacillus": "ثيوباسيلوس, عصوية كبريتية (بكتيريا صغيرة عصوية الشكل تعيش في مياه الصرف الصحي أو التربة وتؤكسد الكبريت)",
 "thiobacteria": "بكتيريا الكبريت (أي بكتيريا من جنس ثيوباسيلوس)",
 "thiocyanate": "ثيوسيانات (ملح لحمض الثيوسيانيك؛ يتكون عند صهر السيانيدات القلوية مع الكبريت)",
 "thiocyanic acid": "حمض الثيوسيانيك (حمض غير مستقر يمكن الحصول عليه بتقطير ملح الثيوسيانات)",
 "thiodiphenylamine": "فينوثيازين (مركب يستخدم أساساً في الطب البيطري لتخليص حيوانات المزرعة من الطفيليات الداخلية)",
 "thioguanine": "ثيوغوانين (دواء مضاد للأورام يستخدم لعلاج اللوكيميا الحادة)",
 "thiopental": "بنتوثال, ثيوبنتال (باربيتورات عبارة عن مسحوق استرطابي (الاسم التجاري بنتوثال) وهو باربيتورات قوي يعمل بسرعة؛ يحفز حالة استرخاء عند حقنه كمخدر عام)",
 "thiopental sodium": "بنتوثال, ثيوبنتال (باربيتورات عبارة عن مسحوق استرطابي (الاسم التجاري بنتوثال) وهو باربيتورات قوي يعمل بسرعة؛ يحفز حالة استرخاء عند حقنه كمخدر عام)",
 "thiopentobarbital sodium": "بنتوثال, ثيوبنتال (باربيتورات عبارة عن مسحوق استرطابي (الاسم التجاري بنتوثال) وهو باربيتورات قوي يعمل بسرعة؛ يحفز حالة استرخاء عند حقنه كمخدر عام)",
 "thioridazine": "ثيوريدازين, ميلاريل (مهدئ (الاسم التجاري ميلاريل) يستخدم لعلاج الفصام والاضطرابات الذهانية الأخرى)",
 "thiosulfil": "ثيوسولفيل (اسم تجاري لمضاد بكتيري من السلفوناميد)",
 "thiotepa": "ثيوتيبا (دواء مضاد للأورام يستخدم لعلاج بعض الأورام الخبيثة)",
 "thiothixene": "ثيوثيكسين, نافان (مهدئ (الاسم التجاري نافان) يستخدم لعلاج الفصام)",
 "thiouracil": "ثيويوراسيل (يثبط وظيفة الغدة الدرقية)",
 "third": "ثَالِث, ثَالِثَة / ثُلْث (ثَلَثَ الحبل ونحوه يَثْلُثُ ثَلْثًا: فَتَلَهُ من ثلاث قُوى؛ ثَلَثَ العمل: عمله ثلات مرات)\nمثال: الساعة العاشرة والثلث.",
 "third base": "القاعدة الثالثة (مركز اللعب للاعب في فريق البيسبول المتمركز بالقرب من القاعدة الثالثة في الملعب الداخلي) / القاعدة الثالثة (القاعدة التي يجب أن يلمسها العداء ثالثاً في لعبة البيسبول)\nمثال: هو يلعب في القاعدة الثالثة",
 "third baseman": "لاعب القاعدة الثالثة ((في البيسبول) شخص ذكر يلعب في القاعدة الثالثة)",
 "third basewoman": "لاعبة القاعدة الثالثة ((في البيسبول) شخص أنثى تلعب في القاعدة الثالثة)",
 "third class": "درجة سياحية (أماكن إقامة غير مكلفة على متن سفينة أو قطار) / بريد الدرجة الثالثة (بريد يتكون من مواد مطبوعة مؤهلة لأسعار بريدية مخفضة)",
 "third council of constantinople": "مجمع القسطنطينية الثالث (المجمع المسكوني السادس عام 680-681 الذي أدان المونوثيليتية بتعريف مشيئتين في المسيح، إلهية وبشرية)",
 "third cranial nerve": "عصب قحفي ثالث, عصب محرك للعين (يغذي العضلات الخارجية للعين)",
 "third deck": "السطح السفلي (السطح الموجود أسفل السطح الرئيسي)",
 "third degree": "استجواب قسري, الدرجة الثالثة (استجواب يصاحبه غالبًا تعذيب لانتزاع معلومات أو اعتراف)",
 "third dimension": "البعد الثالث (البعد الذي يختلف بموجبه الجسم الصلب عن رسمه ثنائي الأبعاد)",
 "third estate": "الطبقة الثالثة, عامة الشعب (عامة الناس)",
 "third eye": "عين ثالثة, عين صنوبرية (هيكل حسي قادر على استقبال الضوء يقع على الجانب الظهري للدماغ البيني في الزواحف المختلفة)",
 "third eyelid": "جفن ثالث, غشاء راف (طية واقية من الجلد في عيون الزواحف والطيور وبعض الثدييات)",
 "third gear": "الترس الثالث, السرعة الثالثة (الترس الثالث من أدنى نسبة أمامية في صندوق تروس المركبة)\nمثال: لا يجب أن تحاول البدء بالترس الثالث",
 "third house": "جماعة ضغط, مجموعة مصالح خاصة (مجموعة مصالح تحاول التأثير على المشرعين أو البيروقراطيين للعمل لصالحهم، عادة من خلال الضغط)",
 "third lateran council": "مجمع لاتران الثالث (مجمع لاتران عام 1179 الذي أدان هرطقات الألبيجنسيين والوالدنسيين)",
 "third law of motion": "قانون الفعل ورده الفعل, قانون نيوتن الثالث (لكل فعل رد فعل مساوٍ له في المقدار ومعاكس له في الاتجاه)",
 "third law of thermodynamics": "القانون الثالث للديناميكا الحرارية (قانون ينص على أن إنتروبيا مادة ما تقترب من الصفر مع اقتراب درجة حرارتها من الصفر المطلق)",
 "third party": "حزب ثالث (حزب سياسي منظم في معارضة للأحزاب الرئيسية في نظام الحزبين) / طرف ثالث (شخص آخر غير الأطراف الرئيسية المشاركة في معاملة ما)",
 "third person": "غَائِب",
 "third power": "قُوَّة ثَالِثَة, مُكَعَّب (حاصل ضرب ثلاثة حدود متساوية)",
 "third rail": "السكة الثالثة (سكة يتم من خلالها تزويد القاطرة الكهربائية بالتيار الكهربائي)",
 "third reich": "الرَّايْخ الثَّالِث",
 "third sacker": "لاعب القاعدة الثالثة ((في البيسبول) الشخص الذي يلعب في القاعدة الثالثة)",
 "third stomach": "أم التلافيف, المعدة الثالثة (القسم الثالث من معدة الحيوان المجتر)",
 "third time is the charm": "الثالثة ثابتة",
 "third tonsil": "لحمية, لوزة بلعومية (تجمع من الأنسجة اللمفاوية في الحلق خلف اللهاة (على الجدار الخلفي وسقف البلعوم الأنفي))\nمثال: تضخم اللوزتين البلعوميتين يسمى اللحمية",
 "third trimester": "الثلث الثالث من الحمل (فترة زمنية تمتد من الأسبوع 28 من الحمل حتى الولادة)",
 "third ventricle": "بطين ثالث (بطين ضيق في المستوى المتوسط أسفل الجسم الثفني؛ يتصل بالبطين الرابع عبر قناة سيلفيان)",
 "third world": "الْعَالَم الثَّالِث",
 "third-class mail": "بريد الدرجة الثالثة (بريد يتكون من مواد مطبوعة مؤهلة لأسعار بريدية مخفضة)",
 "third-degree burn": "حرق من الدرجة الثالثة (حرق يتميز بتدمير كل من البشرة والأدمة)",
 "third-dimensional": "ثُلَاثِيُّ الأَبْعَادِ (ينطوي على ثلاثة أبعاد أو جوانب أو يتصل بها؛ يُعطي إيهاماً بالعمق)",
 "third-dimensionality": "ثلاثية الأبعاد (خاصية امتلاك ثلاثة أبعاد)",
 "third-place finish": "المركز الثالث (الانتهاء في المركز الثالث (كما في السباق))",
 "third-rate": "مِنَ الدَّرَجَة الثَّالِثَة (أقل جودة من الدرجة الثانية)",
 "third-rater": "شَخْص مِنَ الدَّرَجَة الثَّالِثَة, مُتَدَنِّي الْمُسْتَوَى (شخص من الدرجة الثالثة أو أقل جودة بوضوح)",
 "third-year": "فِي السَّنَةِ الثَّالِثَة (يُسْتَخْدَمُ لِوَصْفِ السَّنَةِ الثَّالِثَةِ أَوْ مَا قَبْلَ الأَخِيرَةِ فِي المَدْرَسَةِ الثَّانَوِيَّةِ أَوِ الجَامِعَةِ الأَمْرِيكِيَّةِ)",
 "thirdhand": "بشكل غير مباشر للغاية (بوسائل غير مباشرة مضاعفة) / مَنْقُول بِوَاسِطَتَيْن (مشتقّ ممّا هو أوّليّ أو أصليّ عبر خطوتين وسيطتين)\nمثال: حصلت على الأخبار بشكل غير مباشر للغاية",
 "thirdly": "ثَالِثًا",
 "thirst": "عَطَش, ظَمَأ (مصدر للفعل \"عَطِشَ\"؛ الإحساس بالجفاف في الحلق المتعلق بالتشوق من أجل السوائل بسبب انعدام الشرب أو لسبب آخر، كالخوف أو غيرها، مما يوقف إنتاج الغشاء المخاطي) / عَطِشَ, ظَمِئَ (مصدر للفعل \"عَطِشَ\"؛ الإحساس بالجفاف في الحلق المتعلق بالتشوق من أجل السوائل بسبب انعدام الشرب أو لسبب آخر، كالخوف أو غيرها، مما يوقف إنتاج الغشاء المخاطي)\nمثال: لا أشعر بالعطش.",
 "thirst for knowledge": "رغبة في المعرفة, نهم للعلم (فضول يحفز البحث والدراسة)",
 "thirster": "تَوَّاق, مُتَلَهِّف (شخص لديه رغبة قوية في شيء ما)\nمثال: تواق للمال",
 "thirstily": "بشوق, بلهفة / بظمأ, بعطش (بطريقة عطشى)\nمثال: كانت الأخبار منتظرة بلهفة",
 "thirstiness": "عَطَش (مصدر للفعل \"عَطِشَ\"؛ الإحساس بالجفاف في الحلق المتعلق بالتشوق من أجل السوائل بسبب انعدام الشرب أو لسبب آخر، كالخوف أو غيرها، مما يوقف إنتاج الغشاء المخاطي)\nمثال: لا أشعر بالعطش.",
 "thirsty": "عَطْشَان, ظَمْآن",
 "thirteen": "ثَلَاثَةَ عَشَرَ (في هو أحد الأعداد الرياضية، وهو أصغر عدد فردي أولي)\nمثال: حملت ثلاثة كتب.",
 "thirteenth": "ثَالِثَ عَشَرَ, ثَالِثَةَ عَشْرَةَ",
 "thirties": "الثلاثينات (الفترة من العمر بين 30 و 40) / الثلاثينات (1930), عقد 1930 (العقد من 1930 إلى 1939)",
 "thirtieth": "ثَلَاثُون (العَدَد التَّرْتِيبِيّ 30) / الثلاثون (المركز 30 في سلسلة معدودة من الأشياء)",
 "thirty": "ثَلَاثِينَ, ثَلَاثُونَ",
 "thirty years' war": "حَرْب الثَّلَاثِين عَامًا (حَرَبَ (حربه) بالحربة حربا: طعنه بها؛ حَرَبَ (ه) حربا: سلبه جميع ما يملك)\nمثال: بوتين مجرم حرب.",
 "thirty-eight": "ثَمَانْيَة وْثَلَاثِين",
 "thirty-eighth": "اَلثَّامِنُ وَالثَّلَاثُونَ (العدد الترتيبي لثمانية وثلاثين في العدّ)",
 "thirty-fifth": "خَامِس وَثَلَاثُونَ (العَدَد التَّرْتِيبِيّ 35)",
 "thirty-first": "حَادِي وَثَلَاثُونَ (العَدَد التَّرْتِيبِيّ 31)",
 "thirty-five": "خَمْسَة وَثَلَاثُون (قيمة عددية تساوي \"٥\"؛ الرقم ما بعد \"أَرْبَعَة\" وقبل \"سِتَّة\")\nمثال: رأيت خمسة رجال.",
 "thirty-four": "أَرْبَعَة وَثَلَاثُون (أَرْبِعَة؛ أربعَة)\nمثال: مرت أربعة أيام.",
 "thirty-fourth": "رَابِع وَثَلَاثُونَ (العَدَد التَّرْتِيبِيّ 34)",
 "thirty-nine": "تِسْعَة وَثَلَاثُون",
 "thirty-ninth": "اَلتَّاسِعُ وَالثَّلَاثُونَ (العدد الترتيبي لتسعة وثلاثين في العدّ)",
 "thirty-one": "وَاحِد وَثَلَاثُون (في وَ: العدد واحد العدد الاول)\nمثال: رأيت واحدة مرة.",
 "thirty-second": "ثَانِي وَثَلَاثُونَ (العَدَد التَّرْتِيبِيّ 32) / جُزْء مِن اثْنَيْن وَثَلَاثِين (جزء واحد من اثنين وثلاثين جزءاً متساوياً)",
 "thirty-second note": "ذات الثلاثة أسن, نوتة اثنين وثلاثين (نوتة موسيقية لها قيمة زمنية تعادل واحد على اثنين وثلاثين من نوتة كاملة)",
 "thirty-second part": "جُزْء مِن اثْنَيْن وَثَلَاثِين (جزء واحد من اثنين وثلاثين جزءاً متساوياً)",
 "thirty-seven": "سَبْعَة وَثَلَاثُون",
 "thirty-seventh": "سَابِع وَثَلَاثُونَ (العَدَد التَّرْتِيبِيّ 37)",
 "thirty-six": "سِتَّة وَثَلَاثُون",
