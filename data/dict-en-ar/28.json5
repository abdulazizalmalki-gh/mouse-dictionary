 "tickseed sunflower": "بيدنس متوج, عباد شمس القراد (قطيفة شائكة في أمريكا الشمالية بزهور كبيرة)",
 "ticktack": "تيك تاك (نظام للإشارات اليدوية يستخدمه صانعو المراهنات في سباقات الخيل)",
 "ticktacktoe": "إكس أو, تيك تاك تو (لعبة يضع فيها لاعبان بالتناوب صلباناً ودوائر في أحد أقسام شبكة مربعة من تسع مساحات؛ الهدف هو الحصول على صف من ثلاثة صلبان أو ثلاث دوائر قبل الخصم)",
 "ticktacktoo": "إكس أو, تيك تاك تو (لعبة يضع فيها لاعبان بالتناوب صلباناً ودوائر في أحد أقسام شبكة مربعة من تسع مساحات؛ الهدف هو الحصول على صف من ثلاثة صلبان أو ثلاث دوائر قبل الخصم)",
 "ticktock": "تيك تاك (صوت تكتكة متكرر ثابت كما تصدره الساعة)",
 "tickweed": "أشرفية, بذر القراد",
 "tictac": "تيك تاك (صوت تكتكة متكرر ثابت كما تصدره الساعة)",
 "tidal": "مدي (متعلق بالمد والجزر أو ناتج عنهما)\nمثال: موجة مدية",
 "tidal basin": "حوض المد والجزر (حوض يمتلئ بالمياه عند المد العالي)",
 "tidal bore": "طغيان المد, موجة المد العارمة (موجة عالية (غالباً ما تكون خطرة) ناتجة عن تدفق المد والجزر (كما هو الحال عند تصادم تيارات المد والجزر أو في مصب ضيق))",
 "tidal current": "تيار المد والجزر (تيار مائي ناتج عن المد والجزر)",
 "tidal flow": "تيار المد والجزر (تيار مائي ناتج عن المد والجزر)",
 "tidal locking": "حَرَكَة تَزَامُنِيَّة",
 "tidal river": "نهر مدّي (مجرى مائي تمتد فيه تأثيرات المد والجزر لمسافة بعيدة باتجاه المنبع)",
 "tidal stream": "نهر مدّي (مجرى مائي تمتد فيه تأثيرات المد والجزر لمسافة بعيدة باتجاه المنبع)",
 "tidal wave": "موجة مدية (موجة ناتجة عن التدفق الدوري للمد والجزر الناتج عن الجذب الجاذبي للقمر والشمس) / موجة مد عارمة (ارتفاع غير عادي (وغالباً ما يكون مدمراً) للمياه على طول شاطئ البحر ناجم عن عاصفة أو مزيج من الرياح والمد العالي) / طوفان, موجة عارمة (تجلي ساحق لعاطفة أو ظاهرة ما)\nمثال: موجة عارمة من الغثيان",
 "tidal zone": "منطقة المد والجزر (منطقة خاضعة لتأثير المد والجزر)",
 "tidbit": "قطعة لذيذة, لقمة شهية (قطعة صغيرة ولذيذة من الطعام)",
 "tiddler": "صغير, طفل (شخص صغير السن من أي من الجنسين)\nمثال: هي تكتب كتباً للأطفال",
 "tiddly": "مُتَرَنِّح, نَشْوَان (فِي حَالَة سُكْرٍ خَفِيف)",
 "tiddlywinks": "تيدلي وينكس (لعبة يحاول فيها اللاعبون قذف أقراص بلاستيكية في كوب عن طريق الضغط على جانبها بقرص أكبر)",
 "tide": "مَدّ وَجَزْر (جذب ومطل حتى يصبح أطول او اوسع؛ بسط ووسع)\nمثال: مد سامي يده لليلى.",
 "tide rip": "تيار ساحب, تيار عنيف (امتداد من المياه المضطربة في نهر أو في البحر ناتج عن تدفق تيار في تيار آخر أو عبره)",
 "tideland": "أرض المد (أرض بالقرب من البحر يغمرها المد)",
 "tidemark": "علامة المد (مؤشر يتكون من خط عند حدود المد العالي أو المنخفض)",
 "tidewater": "أرض مدية (أرض ساحلية منخفضة تصرفها تيارات المد والجزر)",
 "tidewater river": "نهر مدّي (مجرى مائي تمتد فيه تأثيرات المد والجزر لمسافة بعيدة باتجاه المنبع)",
 "tidewater stream": "نهر مدّي (مجرى مائي تمتد فيه تأثيرات المد والجزر لمسافة بعيدة باتجاه المنبع)",
 "tideway": "مجرى المد (قناة يجري فيها تيار المد والجزر)",
 "tidily": "بترتيب, بنظام (بطريقة مرتبة)\nمثال: أتاح الباب الوصول إلى غرفة جلوس مؤثثة بترتيب حيث يغلب عليها قماش الشنتز وخشب البلوط",
 "tidiness": "هِنْدَام",
 "tidings": "أخبار, أنباء (معلومات حول أحداث حديثة ومهمة)\nمثال: انتظروا أخبار النتيجة",
