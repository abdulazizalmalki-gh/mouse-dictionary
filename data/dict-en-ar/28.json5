 "theelin": "إسترون (هرمون إستروجيني ضعيف يوجد طبيعياً ويفرزه مبيض الثدييات)",
 "theft": "سَرِقَة, سَرَقَة",
 "theine": "ثيين (الكافيين عند وجوده في الشاي)",
 "their": "لَهُم, ـهُمْ",
 "theism": "ألوهية, إيمان بوجود إله (العقيدة أو الإيمان بوجود إله أو آلهة)",
 "theist": "ألوهي, توحيدي (من أو يتعلق بالإيمان بوجود إله) / مؤله, مؤمن بوجود إله (من يؤمن بوجود إله أو آلهة)",
 "theistic": "ألوهي, توحيدي (من أو يتعلق بالإيمان بوجود إله)",
 "theistical": "ألوهي, توحيدي (من أو يتعلق بالإيمان بوجود إله)",
 "thelarche": "بدء نمو الثدي (بداية نمو الثدي عند المرأة في بداية البلوغ)",
 "thelema": "ثيليما",
 "thelypteris dryopteris": "سرخس البلوط (سرخس أزرق مخضر ساطع واسع الانتشار خاصة في الغابات الحمضية الرطبة في المنطقة المعتدلة الشمالية)",
 "thelypteris hexagonoptera": "سرخس الزان الجنوبي, سرخس الزان العريض (سرخس زان في غابات أمريكا الشمالية بخطوط بلون القش)",
 "thelypteris palustris": "سرخس المستنقعات (سرخس له سعف مفصص ريشياً وينمو في الأماكن الرطبة؛ عالمي الانتشار في المناطق المعتدلة الشمالية)",
 "thelypteris palustris pubescens": "سرخس المرج, سرخس صندوق السعوط (سرخس في شمال شرق أمريكا الشمالية)",
 "thelypteris phegopteris": "سرخس الزان الشمالي, سرخس الزان الطويل (سرخس زان في أمريكا الشمالية وأوراسيا)",
 "thelypteris simulata": "سرخس ماساتشوستس (سرخس درعي ريشي رقيق في شرق الولايات المتحدة؛ يوضع أحياناً في جنس ثيليبترس)",
 "them": "ـهُم / ـهُنَّ (أحد الأسماء الستة، بمعنى شيء، ويُستخدم كناية عن الشيء الذي يُستقبح ذكره) / ـهُمَا / إِيَّاهُم / إِيَّاهُنَّ / إيَّاهُمَا\nمثال: هن يحببن الجاز.",
 "thematic": "موضوعي (متعلق بموضوع الحديث أو يشكله) / لحني, موضوعي (متعلق بموضوع لحني موسيقي)",
 "thematic apperception test": "اختبار تفهم الموضوع (تقنية إسقاطية تستخدم صورًا بالأبيض والأسود؛ يروي الأشخاص قصة عن كل صورة)",
 "thematic vowel": "حركة الجذر (حركة تنهي الجذر وتسبق التصريف)",
 "thematically": "موضوعياً (فيما يتعلق بالمحتوى الموضوعي)\nمثال: مرتبط موضوعياً",
 "theme": "مَوْضُوع",
 "theme park": "متنزه ترفيهي متخصص (مدينة ملاهي منظمة حول موضوع معين (مثل عالم الغد))",
 "theme song": "شارة مُوسِيقِيّة",
 "then": "آنَذَاكَ, حِينَئِذٍ / ثُمَّ (يفيد الترتيب والتراخي) / إِذًا, إِذَنْ\nمثال: ثم هناك مشكلة؛",
 "then again": "من جهة أخرى, من ناحية أخرى ((للمقابلة) من وجهة نظر أخرى)\nمثال: من ناحية أخرى، هي طموحة جداً لمصلحتها الخاصة",
 "thenal": "راحي (متعلق براحة اليد أو بالمنطقة عند قاعدة الإبهام)",
 "thenar": "بَرْزَة رَاحِيَّة",
 "thence": "مِن هُنَاكَ, ثَمَّ (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "thenceforth": "بعد ذلك, منذ ذلك الحين (من ذلك الوقت فصاعداً)\nمثال: بعد ذلك لم يتصل أبداً مرة أخرى",
 "theobid": "إليكسوفيلين, ثيوفيلين (قلويد بلوري عديم اللون مشتق من أوراق الشاي أو يصنع صناعياً؛ يستخدم في الطب كموسع للشعب الهوائية)",
 "theobroma cacao": "شجرة الكاكاو, كاكاو (شجرة أمريكية استوائية تنتج حبوب الكاكاو)",
 "theocentrism": "مركزية الإله (الاعتقاد بأن الله هو الجانب المركزي لوجودنا)",
 "theocracy": "ثِيُقْرَاطِيَّة",
 "theocratic": "ثيوقراطي, ديني الحكم (من أو يتعلق بالثيوقراطية أو يمثلها)\nمثال: دولة ثيوقراطية",
 "theodicy": "ثيوديسيا, عدالة الإله (فرع اللاهوت الذي يدافع عن صلاح الله وعدله في مواجهة وجود الشر)",
 "theodolite": "ثيودوليت, مزواة (أداة مسح لقياس الزوايا الأفقية والعمودية، تتكون من تلسكوب صغير مثبت على حامل ثلاثي القوائم)",
 "theodora": "ثيودورة",
 "theodore": "ثِيُودُور",
 "theodosius": "ثَاوُدُسِيُوس, ثِيُودُوسِيُوس",
 "theogony": "أصل الآلهة, ثيوغونيا (دراسة أصول وأنساب الآلهة)",
 "theologian": "عَالِم لَاهُوت, لَاهُوتِيّ (الذي يعلم؛ متخصص في عِلْم ما وباحث فيه)\nمثال: هو عالم أحيائي.",
 "theological": "لاهوتي (متعلق باللاهوت (علم العقائد))\nمثال: ندوة لاهوتية",
 "theological doctrine": "عقيدة لاهوتية (عقيدة مجموعة دينية)",
 "theological system": "علم اللاهوت, لاهوت (نظام أو مدرسة معينة للمعتقدات والتعاليم الدينية)\nمثال: اللاهوت اليهودي",
 "theological virtue": "فضيلة لاهوتية (وفقاً للأخلاق المسيحية: واحدة من الفضائل الثلاث (الإيمان والرجاء والمحبة) التي خلقها الله لتكمل الفضائل الطبيعية)",
 "theologically": "لاهوتياً (بطريقة لاهوتية) / من الناحية اللاهوتية (فيما يتعلق باللاهوت)\nمثال: تعامل مع مشكلة الشر لاهوتياً، وليس فلسفياً",
 "theologiser": "لاهوتي (شخص ملم بعلم اللاهوت أو يتأمل فيه)",
 "theologist": "لاهوتي (شخص ملم بعلم اللاهوت أو يتأمل فيه)",
 "theologizer": "لاهوتي (شخص ملم بعلم اللاهوت أو يتأمل فيه)",
 "theology": "إِلٰهِيَّات",
 "theophany": "ظُهُورٌ إِلَهِيّ (عِيْدُ الظُّهُوْر: عيد للنَصَارَى يُسَمَّى أيضا عيد التَجَلِّي)\nمثال: لا أحد لاحظ ظهور الدب.",
 "theophylline": "إليكسوفيلين, ثيوفيلين (قلويد بلوري عديم اللون مشتق من أوراق الشاي أو يصنع صناعياً؛ يستخدم في الطب كموسع للشعب الهوائية)",
 "theorem": "مُبَرْهَنَة",
 "theoretic": "نَظَرِيّ (المنسوب إلى النَظَر؛ في : العِلْم النَظَرِيّ هو العلم الذي يُفحص بالنظر لا بالاختبار ويشمل غالبا العلوم التي تعتمد على ما في بطون الكتب مثل الفَلْسَفَة والآدَاب…)\nمثال: إنها مجرد نظرية.",
 "theoretical": "نَظَرِيّ (المنسوب إلى النَظَر؛ في : العِلْم النَظَرِيّ هو العلم الذي يُفحص بالنظر لا بالاختبار ويشمل غالبا العلوم التي تعتمد على ما في بطون الكتب مثل الفَلْسَفَة والآدَاب…)\nمثال: إنها مجرد نظرية.",
 "theoretical account": "إطار نظري, نموذج (وصف افتراضي لكيان أو عملية معقدة)\nمثال: كان برنامج الكمبيوتر يعتمد على نموذج للدورة الدموية والجهاز التنفسي",
 "theoretically": "على الورق, نظرياً (في النظرية؛ وفقاً للحقائق المفترضة) / نظرياً (بطريقة نظرية)\nمثال: على الورق يبدو المرشح واعداً",
 "theoretician": "مُنظِّر (شخص يضع النظريات (خاصة في العلوم أو الفن))",
 "theorisation": "تنظير (إنتاج أو استخدام النظريات)",
 "theoriser": "مُنظِّر (شخص يضع النظريات (خاصة في العلوم أو الفن))",
 "theorist": "مُنَظِّر",
 "theorization": "تنظير (إنتاج أو استخدام النظريات)",
 "theorizer": "مُنظِّر (شخص يضع النظريات (خاصة في العلوم أو الفن))",
 "theory": "نَظَرِيَّة (مؤنث نَظَرْيّ، أي يفحض بالنظر لا بالإختبار؛ قضية غير مثبتة ولا مبرهنة لتفسير أمر ما)\nمثال: إنها مجرد نظرية.",
 "theory of dissociation": "نظرية التفكك, نظرية التفكك الإلكتروليتي ((كيمياء) نظرية تصف المحاليل المائية من حيث الأحماض (التي تتفكك لتعطي أيونات الهيدروجين) والقواعد (التي تتفكك لتعطي أيونات الهيدروكسيل))",
 "theory of electrolytic dissociation": "نظرية التفكك, نظرية التفكك الإلكتروليتي ((كيمياء) نظرية تصف المحاليل المائية من حيث الأحماض (التي تتفكك لتعطي أيونات الهيدروجين) والقواعد (التي تتفكك لتعطي أيونات الهيدروكسيل))",
 "theory of everything": "نظريَة كل شيء (مؤنث نَظَرْيّ، أي يفحض بالنظر لا بالإختبار؛ قضية غير مثبتة ولا مبرهنة لتفسير أمر ما)\nمثال: إنها مجرد نظرية.",
 "theory of evolution": "تطورية, نظرية التطور ((أحياء) نظرية علمية لأصل أنواع النباتات والحيوانات)",
 "theory of games": "نظرية الألعاب ((اقتصاد) نظرية للمنافسة مصاغة من حيث المكاسب والخسائر بين لاعبين متعارضين)",
 "theory of gravitation": "نظرية الجاذبية, نظرية نيوتن للجاذبية ((فيزياء) النظرية القائلة بأن أي جسيمين من المادة يجذبان بعضهما البعض بقوة تتناسب طردياً مع ناتج كتلتيهما وعكسياً مع مربع المسافة بينهما)",
 "theory of gravity": "نظرية الجاذبية, نظرية نيوتن للجاذبية ((فيزياء) النظرية القائلة بأن أي جسيمين من المادة يجذبان بعضهما البعض بقوة تتناسب طردياً مع ناتج كتلتيهما وعكسياً مع مربع المسافة بينهما)",
 "theory of indicators": "نظرية المؤشرات ((كيمياء) النظرية القائلة بأن جميع المؤشرات هي إما أحماض ضعيفة أو قواعد ضعيفة يختلف فيها لون الشكل المتأين عن اللون قبل التفكك)",
 "theory of inheritance": "نظرية الوراثة ((أحياء) نظرية حول كيفية اشتقاق خصائص جيل واحد من أجيال سابقة)",
 "theory of organic evolution": "تطورية, نظرية التطور ((أحياء) نظرية علمية لأصل أنواع النباتات والحيوانات)",
 "theory of preformation": "تكون مسبق, نظرية التكون المسبق (نظرية (كانت شائعة في القرن الثامن عشر وفقدت مصداقيتها الآن) تفيد بأن الفرد يتطور بتضخم بسيط لكائن حي صغير كامل التكوين موجود في الخلية الجرثومية)",
 "theory of probability": "نظرية الاحتمالات (فرع الرياضيات التطبيقية الذي يتعامل مع الاحتمالات)",
 "theory of punctuated equilibrium": "توازن متقطع, توازن نقطي (نظرية للتطور ترى أن التغيير التطوري في السجل الأحفوري جاء في نوبات وبدايات بدلاً من عملية ثابتة من التغيير البطيء)",
 "theory of relativity": "نسبية, نظرية النسبية ((فيزياء) النظرية القائلة بأن المكان والزمان مفاهيم نسبية وليست مطلقة)",
 "theory of weak interaction": "نظرية التفاعل الضعيف (في الفيزياء، النظرية التي تصف القوة النووية الضعيفة)",
 "theory-based": "قَائِمٌ عَلَى النَّظَرِيَّة (مبنيّ على النظرية بدلاً من التجربة)",
 "theosophical": "ثيوصوفي, حكمي إلهي (من أو متعلق بالثيوصوفيا (الحكمة الإلهية))\nمثال: كتابات ثيوصوفية",
 "theosophism": "ثيوصوفية, حكمة إلهية (الإيمان بالثيوصوفية (مذهب الحكمة الإلهية))",
 "theosophist": "ثيوصوفي (مؤمن بالثيوصوفيا)",
 "theosophy": "الحكمة الإلهية, ثيوصوفيا (نظام عقائدي يقوم على البصيرة الصوفية في طبيعة الله والروح)",
 "theoterrorism": "إرهاب ديني (إرهاب لغرض ديني)",
 "theotokos": "والدة الإله, ام الاله (اسم فاعل مؤنث للفعل \"وَلَدَ\"؛ مرادف لـ\"أُمّ\")\nمثال: ألست والدة توم؟",
 "therapeutic": "شِفائِيّ, عِلاجِيّ (لَه قُدْرَة عَلى الشِّفاء والعِلاج) / علاجي (متعلق بالعلاج أو مشارك فيه) / دواء شافي, علاج (دواء أو علاج يشفي المرض أو يخفف الألم)\nمثال: نهج علاجي للإجرام",
 "therapeutic abortion": "إجهاض علاجي (إجهاض مفتعل قانونياً لأسباب طبية (مثل تهديد حياة الأم))",
 "therapeutic cloning": "استنساخ طبي حيوي, استنساخ علاجي (زرع نووي لخلايا المريض نفسه لصنع خلية بيضية يمكن منها استخلاص خلايا متوافقة مناعياً (خاصة الخلايا الجذعية) للزرع)",
 "therapeutic rehabilitation": "تأهيل بدني, علاج طبيعي (تقديم المساعدة للأشخاص ذوي الإعاقة؛ إزالة أو تقليل الإعاقات)",
 "therapeutical": "علاجي (متعلق بالعلاج أو مشارك فيه)\nمثال: نهج علاجي للإجرام",
 "therapeutically": "علاجياً (لأغراض علاجية)",
 "therapeutics": "علاجيات, علم المداواة (فرع الطب المعني بعلاج الأمراض)",
 "therapist": "معالج (شخص ماهر في نوع معين من العلاج)",
 "therapsid": "ثيرابسيد (من المحتمل أن يكون من ذوات الدم الحار؛ يعتبر سلفاً مباشراً للثدييات)",
 "therapy": "عِلَاج / مُعَالَجَة",
 "theravada": "بوذية التيرافادا, تيرافادا (واحدة من مدرستين عظيمتين للعقيدة البوذية تؤكدان على الخلاص الشخصي من خلال الجهود الذاتية؛ شكل محافظ من البوذية يلتزم بنصوص بالي والمثل غير الإلهي…)",
 "theravada buddhism": "بوذية التيرافادا, تيرافادا (واحدة من مدرستين عظيمتين للعقيدة البوذية تؤكدان على الخلاص الشخصي من خلال الجهود الذاتية؛ شكل محافظ من البوذية يلتزم بنصوص بالي والمثل غير الإلهي…)",
 "there": "هُنَاكَ",
 "there are": "هُنَاك, يُوجَد",
 "there are two sides to every question": "لكل حادث روايتان",
 "there be": "وُجِدَ (أَدْرَكَ المطلوب، أَدْرَكَ الشيء الذي أَرَادَهُ وبَحَثَ عنه؛ غَضِبَ عليه. (يتعدى بعلى))\nمثال: وجد ياني هاتفه.",
 "there is": "هُنَاكَ, يُوجَدُ",
 "there is an exception to every rule": "لِكُلِّ قَاعِدَةٍ ٱسْتِثْنَاءٌ, لِكُلِّ قَاعِدَةٍ شَوَاذُّ",
 "there is nothing new under the sun": "فليس تحت الشمس جديد",
 "there isn't any easy way to say this": "ليس من سروري قول هذا",
 "there's been an accident": "حَدَثَتْ حَادِثَةٌ",
 "there's more than one way to skin a cat": "هناك أكثر من طريقَة لسلخ القط",
 "there's no place like home": "لَا مَكَان كَالْوَطَن (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: لا أحب المدرسة.",
 "thereabout": "في ذلك الجوار, هناك تقريباً (بالقرب من ذلك المكان) / في ذلك الوقت تقريباً (بالقرب من ذلك الوقت أو التاريخ)\nمثال: أقام في لندن أو جوارها لعدة أسابيع",
 "thereabouts": "في ذلك الجوار, هناك تقريباً (بالقرب من ذلك المكان) / في ذلك الوقت تقريباً (بالقرب من ذلك الوقت أو التاريخ)\nمثال: أقام في لندن أو جوارها لعدة أسابيع",
 "thereafter": "بعد ذلك, منذ ذلك الحين (من ذلك الوقت فصاعداً)\nمثال: بعد ذلك لم يتصل أبداً مرة أخرى",
 "thereby": "بذلك, بسبب ذلك (بتلك الوسيلة أو بسبب ذلك)\nمثال: أسقط النبيذ الأحمر، وبذلك أفسد مفرش الطاولة",
 "therefor": "لذلك, لهذا الغرض ((في الاستخدام الرسمي، وخاصة القانوني) لذلك أو من أجله)\nمثال: طلب بضائع وإرفاق الدفع لذلك",
 "therefore": "إِذَنْ, لِذٰلِكَ (و جزاء ينصب الفعل المضارع إذا كان متصدرا غير مفصول عنه)\nمثال: تحتاج لإذن خطي.",
 "therefrom": "من ذلك المكان, من هناك (من ذلك المكان أو من هناك) / بناءً على ذلك, من ذلك (من ذلك الظرف أو المصدر)\nمثال: انطلق من هناك مباشرة إلى الكلية",
 "therein": "فِي ذَلِك, فِي ذَلِك المَكَان ((رسمي) في أو داخل ذلك الشيء أو المكان)\nمثال: يمكنهم أن يقرؤوا في ذلك ما هي خططنا",
 "thereinafter": "في الجزء التالي, فيما بعد (في الجزء التالي من مسألة معينة، كما في وثيقة أو خطاب)",
 "theremin": "ثيرمين (آلة موسيقية إلكترونية؛ يمكن عزف الألحان عن طريق تحريك اليد اليمنى بين قضيبين يعملان كهوائيات للتحكم في النغمة؛ تتحكم اليد اليسرى في الصياغة)",
 "thereness": "هناكية, وجود هناك (حالة الوجود هناك - وليس هنا - من حيث الموقع) / واقعية, وجودية (الوجود الحقيقي)\nمثال: الأشياء موجودة حقاً هناك؛ التقط واقعيتها",
 "thereof": "بناءً على ذلك, من ذلك (من ذلك الظرف أو المصدر) / من ذلك, منه (من أو بخصوص هذا أو ذاك)\nمثال: الصيغ الذرية وجميع المركبات القابلة للبناء من ذلك",
 "thereon": "على ذلك, عليه\nمثال: النص والتعليق عليه (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال.",
 "thereto": "لذلك, له\nمثال: مع جميع الملحقات المناسبة لذلك",
 "theretofore": "حتى ذلك الحين, قبل ذلك (حتى ذلك الوقت)\nمثال: لم يقوموا بأي عمل حتى ذلك الحين",
 "therewith": "بذلك, به (مع ذلك أو هذا)\nمثال: لقد تعلمت أنه في أي حال كنت، أن أكون به راضياً",
 "therewithal": "فضلاً عن ذلك, مع ذلك (إلى جانب كل ذلك؛ بالإضافة)\nمثال: افتراءاتك أغفرها؛ وفضلاً عن ذلك أعفو عن زلاتك الأخرى",
 "theriac": "تِرْيَاق (دواء مركب يدفع السموم؛ ما يضاد عمل السمّ)",
 "theridiid": "عنكبوت مشطي القدم (عنكبوت له صف يشبه المشط من الشعيرات على كل قدم خلفية)",
 "therm": "ثيرم (وحدة حرارة تساوي 100,000 وحدة حرارية بريطانية)",
 "thermal": "حَرَارِيّ (ناتج عن الحرارة أو مُصمَّم للاحتفاظ بها) / حراري, حموي (متعلق بالينابيع الحارة) / حراري (متعلق بالحرارة أو مرتبط بها) / تيار حراري, تيار صاعد حراري (تيار هواء دافئ صاعد)\nمثال: مياه حمونية (حارة)",
 "thermal barrier": "حاجز حراري (حد لسرعة الطيران العالية يفرضه التسخين الديناميكي الهوائي)",
 "thermal conductivity": "موصلية حرارية (في الفيزياء، خاصية المادة لتوصيل الحرارة)\nمثال: عندما تخضع مادة لتغير في الطور من صلب إلى سائل أو من سائل إلى غاز، قد تتغير الموصلية الحرارية",
 "thermal emission": "انبعاث أيوني حراري (انبعاث الإلكترونات من مواد ساخنة جداً)",
 "thermal equilibrium": "توازن حراري (حالة تكون فيها جميع أجزاء النظام عند نفس درجة الحرارة)",
 "thermal insulation": "عزل حراري (تقليل انتقال الحرارة بين الأجسام المتلامسة حرارياً أو في نطاق التأثير الإشعاعي)\nمثال: هناك عدد من المنتجات المتاحة المصممة لتحسين العزل الحراري للمنازل، بما في ذلك الزجاج الحراري مثل بلانيثيرم",
 "thermal pollution": "تلوث حراري (ضرر يلحق بالبحيرات والأنهار ناتج عن إطلاق حرارة زائدة فيها)",
 "thermal printer": "طابعة حرارية (طابعة تنتج أحرفاً عن طريق تطبيق الحرارة على ورق خاص حساس للحرارة)",
 "thermal reactor": "مفاعل حراري (مفاعل نووي تحدث فيه الانشطارات النووية بواسطة نيوترونات يتم إبطاؤها بواسطة وسيط)",
 "thermal resistance": "مقاومة حرارية (قياس لفرق درجة الحرارة الذي يقاوم به جسم أو مادة تدفق الحرارة)",
 "thermal resistor": "ثرمستور, مقاومة حرارية (جهاز شبه موصل مصنوع من مواد تتغير مقاومتها كدالة لدرجة الحرارة؛ يمكن استخدامه لتعويض التباين في درجة الحرارة في مكونات أخرى للدائرة)",
 "thermal spring": "نبع حار, نبع حراري (نبع طبيعي للمياه بدرجة حرارة 70 فهرنهايت أو أعلى)",
 "thermalgesia": "ألم حراري (ألم ناتج عن الحرارة)",
 "thermally": "حرارياً (بواسطة الحرارة أو فيما يتعلق بالخصائص الحرارية)",
 "thermel": "مقياس حرارة كهربائي حراري (مقياس حرارة يستخدم التيار الكهربائي الحراري لقياس درجة الحرارة)",
 "thermic": "حراري (متعلق بالحرارة أو مرتبط بها)\nمثال: الحركات الحرارية للجزيئات",
 "thermic fever": "ضربة شمس (انهيار مفاجئ بسبب التعرض للشمس أو الحرارة المفرطة)",
 "thermidor": "تِيرْمِيدُور",
 "thermion": "أَيُون حَرَارِيّ (جسيم مشحون كهربائياً (إلكترون أو أيون) ينبعث من مادة عند درجة حرارة عالية)",
 "thermionic": "أيوني حراري (من أو متعلق بـ أو مميز للأيونات الحرارية)\nمثال: كاثود أيوني حراري",
 "thermionic current": "تيار أيوني حراري (تيار كهربائي ينتج بين قطبين نتيجة لانبعاث الإلكترونات بالانبعاث الأيوني الحراري)",
 "thermionic emission": "انبعاث أيوني حراري (انبعاث الإلكترونات من مواد ساخنة جداً)",
 "thermionic tube": "أنبوب إلكتروني, صمام مفرغ (جهاز إلكتروني يتكون من نظام من الأقطاب الكهربائية مرتبة في غلاف زجاجي أو معدني مفرغ)",
 "thermionic vacuum tube": "أنبوب إلكتروني, صمام مفرغ (جهاز إلكتروني يتكون من نظام من الأقطاب الكهربائية مرتبة في غلاف زجاجي أو معدني مفرغ)",
 "thermionic valve": "أنبوب إلكتروني, صمام مفرغ (جهاز إلكتروني يتكون من نظام من الأقطاب الكهربائية مرتبة في غلاف زجاجي أو معدني مفرغ)",
 "thermionics": "علم الانبعاث الحراري الأيوني (فرع الإلكترونيات الذي يتعامل مع الظواهر الحرارية الأيونية (خاصة الأنابيب المفرغة))",
 "thermistor": "ثرمستور, مقاومة حرارية (جهاز شبه موصل مصنوع من مواد تتغير مقاومتها كدالة لدرجة الحرارة؛ يمكن استخدامه لتعويض التباين في درجة الحرارة في مكونات أخرى للدائرة)",
 "thermoacidophile": "أليف الحرارة والحموضة (بكتيريا قديمة تزدهر في بيئات شديدة الحموضة ودرجات حرارة عالية)",
 "thermobaric bomb": "قنبلة حرارية ضغطية, قنبلة فراغية (قنبلة تستخدم متفجرات الوقود والهواء)\nمثال: يمكن للقنبلة الفراغية أن تخلق ضغوطاً زائدة تعادل القنبلة الذرية",
 "thermobia domestica": "سمكة النار (تعيش في المناطق الرطبة الدافئة مثل حول الأفران)",
 "thermocautery": "كي حراري (الكي (تدمير الأنسجة) بالحرارة)",
 "thermochemistry": "كيمياء حرارية (فرع الكيمياء الذي يدرس العلاقة بين العمل الكيميائي وكمية الحرارة الممتصة أو المتولدة)",
 "thermocoagulation": "تخثر حراري (تجميد الأنسجة بالحرارة (كما في التيار الكهربائي))",
 "thermocompressor": "حاقن بخاري, ضاغط حراري (الحاقن أو اللافظ أو الحاقن البخاري أو المضخة النفاثة هو نوع من المضخات)\nمثال: بناءً على التطبيق المحدد، يمكن للحاقن أن يتخذ شكل مضخة نفاثة، أو قاذف مياه، أو قاذف تفريغ، أو قاذف بخار نفاث، أو شفاط",
 "thermocouple": "مزدوجة حرارية (نوع من مقاييس الحرارة يتكون من سلكين من معدنين مختلفين متصلين في كلا الطرفين؛ حيث يولد التيار في الدائرة بما يتناسب مع فرق درجات الحرارة)",
 "thermocouple junction": "مزدوجة حرارية (نوع من مقاييس الحرارة يتكون من سلكين من معدنين مختلفين متصلين في كلا الطرفين؛ حيث يولد التيار في الدائرة بما يتناسب مع فرق درجات الحرارة)",
 "thermodynamic": "ترموديناميكي, ديناميكي حراري (متعلق بالديناميكا الحرارية)\nمثال: الحد الديناميكي الحراري",
 "thermodynamic equilibrium": "توازن ترموديناميكي",
 "thermodynamical": "ترموديناميكي, ديناميكي حراري (متعلق بالديناميكا الحرارية)\nمثال: الحد الديناميكي الحراري",
 "thermodynamically": "ديناميكياً حرارياً (فيما يتعلق بالديناميكا الحرارية)\nمثال: هذه الظاهرة مستحيلة ديناميكياً حرارياً",
 "thermodynamics": "دِينَامِيكَا حَرَارِيَّة",
 "thermodynamics of equilibrium": "الديناميكا الحرارية للتوازن, ترموستاتيكا (جانب الديناميكا الحرارية المعني بالتوازن الحراري)",
 "thermoelectric": "كهروحراري (متعلق بالكهرباء الحرارية أو ناتج عنها)",
 "thermoelectric thermometer": "مقياس حرارة كهربائي حراري (مقياس حرارة يستخدم التيار الكهربائي الحراري لقياس درجة الحرارة)",
 "thermoelectrical": "كهروحراري (متعلق بالكهرباء الحرارية أو ناتج عنها)",
 "thermoelectricity": "كهرباء حرارية (كهرباء ناتجة عن الحرارة (كما في المزدوجة الحرارية))",
 "thermogram": "مخطط حراري (سجل بياني ينتجه المسجل الحراري)",
 "thermograph": "ترموغراف, مسجل الحرارة (مقياس حرارة يسجل تغيرات درجة الحرارة على رسم بياني كدالة للوقت) / ثيرموجراف, مخطط حراري (أداة طبية تستخدم كاميرا تعمل بالأشعة تحت الحمراء للكشف عن تغيرات درجة الحرارة على سطح الجسم)",
 "thermography": "تصوير حراري (تقنية تشخيصية تستخدم جهاز التصوير الحراري لتسجيل الحرارة الناتجة عن أجزاء مختلفة من الجسم)",
 "thermogravimeter": "مقياس كثافة السوائل الحراري (مقياس كثافة السوائل يشتمل على مقياس حرارة)",
 "thermogravimetric": "حراري مائي (من أو يتعلق بالهيدرومتري الحرارية)",
 "thermogravimetry": "قياس الوزن الحراري (قياس التغيرات في الوزن كدالة للتغيرات في درجة الحرارة، وتستخدم كتقنية لتحليل المواد كيميائياً)",
 "thermohydrometer": "مقياس كثافة السوائل الحراري (مقياس كثافة السوائل يشتمل على مقياس حرارة)",
 "thermohydrometric": "حراري مائي (من أو يتعلق بالهيدرومتري الحرارية)",
 "thermojunction": "وصلة حرارية (وصلة بين معدنين غير متماثلين يظهر عبرها جهد كهربائي)",
 "thermolabile": "حَسَّاسٌ لِلحَرَارَة ((في الكيمياء والفيزياء والأحياء) يتغيّر أو يتلف بسهولة بفعل الحرارة)",
 "thermometer": "تِرْمُومِتْر, مِقْيَاسُ الْحَرَارَة",
 "thermometric": "تررمومتري, ميزان حراري (من أو متعلق بقياس الحرارة (التررمومترية))\nمثال: كان غاز الهيليوم هو السائل التررمومتري",
 "thermometrograph": "ترموغراف, مسجل الحرارة (مقياس حرارة يسجل تغيرات درجة الحرارة على رسم بياني كدالة للوقت)",
 "thermometry": "قياس الحرارة (قياس درجة الحرارة)",
 "thermonuclear": "نَوَوِيٌّ حَرَارِيّ (يَسْتَخْدِمُ أَسْلِحَةً نَوَوِيَّةً قَائِمَةً عَلَى الاِنْدِمَاجِ وَلَيْسَ الانْشِطَار)",
 "thermonuclear bomb": "قنبلة هيدروجينية (سلاح نووي يطلق طاقة ذرية عن طريق اتحاد نوى خفيفة (هيدروجين) عند درجات حرارة عالية لتكوين الهيليوم)",
 "thermonuclear reaction": "تفاعل نووي حراري (تفاعل اندماج نووي يحدث في درجات حرارة عالية جداً (كما في الشمس))",
 "thermonuclear reactor": "مفاعل اندماجي, مفاعل نووي حراري (مفاعل نووي يستخدم الاندماج النووي المتحكم فيه لتوليد الطاقة)",
 "thermonuclear warhead": "رأس حربي ذري, رأس نووي (الرأس الحربي لصاروخ مصمم لإيصال قنبلة ذرية)",
 "thermopile": "بطارية حرارية, عمود حراري (نوع من مقاييس الحرارة لقياس الإشعاع الحراري؛ يتكون من عدة مزدوجات حرارية متسلسلة)",
 "thermoplastic": "لدائني الحرارة, لدن بالحرارة (له خاصية الليونة أو الانصهار عند التسخين والتصلب مرة أخرى عند التبريد) / بلاستيك حراري, لدائن حرارية (مادة تلين عند تسخينها وتتصلب مرة أخرى عند تبريدها)\nمثال: المواد اللدائنية الحرارية يمكن إعادة صهرها وتبريدها مرارًا دون الخضوع لأي تغيير كيميائي ملحوظ",
 "thermoplastic resin": "بلاستيك حراري, لدائن حرارية (مادة تلين عند تسخينها وتتصلب مرة أخرى عند تبريدها)",
 "thermopsis macrophylla": "بازلاء ذهبية, ترمس كاذب (عشب كثيف في غرب الولايات المتحدة له زهور صفراء تشبه البازلاء)",
 "thermopsis villosa": "ترمس كارولينا (شجيرة بازلاء في شرق الولايات المتحدة)",
 "thermoreceptor": "مستقبل حراري (مستقبل حسي يستجيب للحرارة والبرودة)",
 "thermoregulator": "ترموستات, منظم الحرارة (منظم لتنظيم درجة الحرارة تلقائياً عن طريق بدء أو إيقاف إمدادات الحرارة)",
 "thermos": "تِرْمُس, كَظِيمَة",
 "thermos bottle": "ترمس (قارورة مفرغة تحفظ درجة حرارة المشروبات الساخنة أو الباردة)",
 "thermos flask": "ترمس (قارورة مفرغة تحفظ درجة حرارة المشروبات الساخنة أو الباردة)",
 "thermoset": "تصلبي الحرارة, صلد بالحرارة (له خاصية التصلب الدائم عند التسخين أو المعالجة)\nمثال: كانت راتنجات الفينول والبلاستيك هي المواد الاصطناعية الأصلية المتصلبة بالحرارة",
 "thermosetting": "تصلبي الحرارة, صلد بالحرارة (له خاصية التصلب الدائم عند التسخين أو المعالجة)\nمثال: كانت راتنجات الفينول والبلاستيك هي المواد الاصطناعية الأصلية المتصلبة بالحرارة",
 "thermosetting compositions": "راتينج تصلب بالحرارة, لدائن تصلب بالحرارة (مادة تتصلب عند تسخينها ولا يمكن إعادة تشكيلها)",
 "thermosetting resin": "راتينج تصلب بالحرارة, لدائن تصلب بالحرارة (مادة تتصلب عند تسخينها ولا يمكن إعادة تشكيلها)",
 "thermosphere": "ثِيرْمُوسْفِير",
 "thermostat": "منظم حرارة",
 "thermostatic": "ترموستاتي, منظم للحرارة (من أو متعلق بالترموستات (منظم الحرارة))\nمثال: تحكم ترموستاتي",
 "thermostatically": "بالمنظم الحراري, ترموستاتياً (بواسطة الثرموستات؛ بطريقة تنظيم الحرارة الآلي)\nمثال: يتم التحكم في درجة الحرارة بالمنظم الحراري",
 "thermostatics": "الديناميكا الحرارية للتوازن, ترموستاتيكا (جانب الديناميكا الحرارية المعني بالتوازن الحراري)",
 "thermotherapy": "علاج حراري (استخدام الحرارة لعلاج مرض أو اضطراب؛ تستخدم وسادات التدفئة أو الكمادات الساخنة أو زجاجات الماء الساخن لتعزيز الدورة الدموية في أمراض الأوعية الدموية…)",
 "thermotropism": "انتحاء حراري (استجابة توجيهية للدفء)",
 "theropod": "ثيروبود, ديناصور ثيروبود (أي من العديد من الديناصورات اللاحمة من العصر الترياسي إلى الطباشيري ذات أطراف أمامية قصيرة وكانت تمشي أو تركض على أرجل خلفية قوية)",
 "theropod dinosaur": "ثيروبود, ديناصور ثيروبود (أي من العديد من الديناصورات اللاحمة من العصر الترياسي إلى الطباشيري ذات أطراف أمامية قصيرة وكانت تمشي أو تركض على أرجل خلفية قوية)",
 "thesaurus": "مَكْنَز",
 "these": "هٰذِهِ, هٰؤُلَاءِ",
 "theseus": "ثيسيوس",
 "thesis": "أُطْرُوحَة",
 "thespesia populnea": "شجرة بورشيا, ماهو ساحلي (شجرة استوائية في السواحل عادة تزرع أحياناً للزينة لأوراقها القلبية المستديرة وزهورها الصفراء والأرجوانية المبهرجة)",
 "thespian": "تمثيلي, مسرحي (من أو متعلق بالدراما) / مشخصاتي, ممثل (فنان يؤدي أدواراً مسرحية أو تمثيلية)\nمثال: كان لمخرج الفيلم تعاون تمثيلي",
 "thessalian": "ثيسالي (مواطن أو ساكن في ثيساليا)",
 "thessalonian": "سالونيكي (مواطن أو ساكن في سالونيك (ثيسالونيكي))",
 "thessaloniki": "سَالُونِيك",
 "theta": "ثِيتَا",
 "theta rhythm": "إيقاع ثيتا, موجة ثيتا (الموجة الدماغية الطبيعية في مخطط الدماغ لشخص مستيقظ ولكنه مسترخٍ ويشعر بالنعاس؛ تحدث بتردد منخفض وسعة منخفضة)",
 "theta wave": "إيقاع ثيتا, موجة ثيتا (الموجة الدماغية الطبيعية في مخطط الدماغ لشخص مستيقظ ولكنه مسترخٍ ويشعر بالنعاس؛ تحدث بتردد منخفض وسعة منخفضة)",
 "thetis": "ثيتيس ((الأساطير اليونانية) واحدة من النيريدات الخمسين؛ والدة أخيل من بيليوس)",
 "theurgy": "ثيورجيا, خيمياء روحانية (سحر أبيض يُمارس بمساعدة أرواح خيرة (كما كان يمارسه الأفلاطونيون الجدد)) / خوارق إلهية, سحر ديني (تأثير التدخل الخارق أو الإلهي في الشؤون البشرية)",
 "thevetia neriifolia": "تيفتيا, دفلى صفراء (شجيرة أو شجرة صغيرة استوائية أمريكية ذات أوراق خضراء داكنة لامعة وأزهار عطرية صفراء زعفرانية إلى برتقالية أو بلون الخوخ؛ جميع أجزائها سامة للغاية)",
 "thevetia peruviana": "تيفتيا, دفلى صفراء (شجيرة أو شجرة صغيرة استوائية أمريكية ذات أوراق خضراء داكنة لامعة وأزهار عطرية صفراء زعفرانية إلى برتقالية أو بلون الخوخ؛ جميع أجزائها سامة للغاية)",
 "they": "هُمَا / هُم / هُنَّ (أحد الأسماء الستة، بمعنى شيء، ويُستخدم كناية عن الشيء الذي يُستقبح ذكره) / هِيَ (في : مبني على السكون بمعنى نَعَم أو إيْ، وقد تحرك الياء فيقال هَيه؛ اسم فعل مبني على السكون يُقال للطفل بمعنى ها أناذا) / هما / هم\nمثال: هن يحببن الجاز.",
 "thiabendazole": "ثيابندازول (عامل مضاد للفطريات وطارد للديدان)",
 "thiamin": "ثيامين, فيتامين ب1 (فيتامين ب يمنع مرض البري بري؛ يحافظ على الشهية والنمو)",
 "thiamine": "ثيامين, فيتامين ب1 (فيتامين ب يمنع مرض البري بري؛ يحافظ على الشهية والنمو)",
 "thiamine pyrophosphate": "بيروفوسفات الثيامين, كوكاربوكسيلاز (مرافق إنزيم مهم في التنفس في دورة كريبس)",
 "thiazide": "ثيازيد (أي من مجموعة من الأدوية تستخدم عادة كمدرات للبول في علاج ارتفاع ضغط الدم؛ تمنع إعادة امتصاص الصوديوم في الكلى)",
