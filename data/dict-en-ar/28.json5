 "thirty-something": "الثلاثينات (الفترة من العمر بين 30 و 40)",
 "thirty-third": "ثَالِث وَثَلَاثُونَ (العَدَد التَّرْتِيبِيّ 33)",
 "thirty-three": "ثَلَاثَة وَثَلَاثُون (في هو أحد الأعداد الرياضية، وهو أصغر عدد فردي أولي)\nمثال: حملت ثلاثة كتب.",
 "thirty-two": "اِثْنَان وَثَلَاثُون (في اِثْنان هو رقم مرتبته بين الواحد والثلاثة)\nمثال: واحد زائد اثنان يساوي ثلاثة.",
 "this": "هَٰذَا, هَٰذِهِ / هٰذَا, هٰذِهِ",
 "this evening": "الليلة, هذا المساء (خلال ليلة اليوم الحالي)\nمثال: مر علي الليلة",
 "this morning": "هٰذَا الصَّبَاح",
 "this night": "الليلة, هذا المساء (خلال ليلة اليوم الحالي)\nمثال: مر علي الليلة",
 "this one": "هٰذَا",
 "thistle": "شوك, قردمان",
 "thistledown": "زغب الشوك (زغب نبات الشوك المكون من شعيرات حريرية تشبه الريش)",
 "thistlelike": "شَبِيه بِالشَّوْك (يُشبه نبات الشوك في مظهره)",
 "thither": "إِلَى هُنَاك (حرف جر يُفيد الغاية الزمنية؛ حرف جر يُفيد الغاية المكانية)\nمثال: تعال إلى منزلي.",
 "thlaspi arvense": "ثلاسبي حقلي, خردل الميثريبات (عشبة أوراسية كريهة الرائحة ذات قرون مسطحة مستديرة؛ متوطنة في جميع أنحاء أمريكا الشمالية)",
 "thm": "ماجستير اللاهوت (درجة الماجستير في اللاهوت)",
 "tho": "لغة تاي (فرع من لغات تاي، يُتحدث به في وسط وشمال شرق فيتنام، بالقرب من الحدود الصينية)",
 "thole": "مسند المجداف, وتد المجداف (حامل مثبت على حافة القارب يثبت المجداف في مكانه ويعمل كنقطة ارتكاز للتجديف)",
 "tholepin": "مسند المجداف, وتد المجداف (حامل مثبت على حافة القارب يثبت المجداف في مكانه ويعمل كنقطة ارتكاز للتجديف)",
 "thomas": "تُومَا",
 "thomism": "توماوية (العقيدة اللاهوتية الشاملة التي أنشأها القديس توما الأكويني في القرن الثالث عشر ولا تزال تدرس من قبل الدومينيكان)",
 "thomomys bottae": "غوفر جيبي للوادي (يعيش في الوديان والمروج الجبلية بغرب الولايات المتحدة)",
 "thomomys talpoides": "غوفر جيبي شمالي (غوفر رمادي إلى بني يعيش في غرب ووسط الولايات المتحدة)",
 "thompson seedless": "تومسون سيدلس, عنب تومسون (عنب مائدة أخضر بدون بذور من كاليفورنيا)",
 "thompson submachine gun": "تومي غان, رشاش تومسون (رشاش خفيف عيار 0.45)",
 "thomsen's disease": "تأتر خلقي, مرض تومسن (شكل خفيف ونادر وخلقي من التأتر يتميز بتصلب العضلات)",
 "thomson's gazelle": "غزال طومسون (غزال شرق أفريقي؛ أصغر الغزلان)",
 "thong": "زنوبَة, شِبْشِب",
 "thoracentesis": "بزل الصدر (إزالة السوائل من الصدر عن طريق البزل لأغراض تشخيصية أو علاجية)",
 "thoracic": "صدري (متعلق بالصدر أو القفص الصدري)\nمثال: عضو صدري",
 "thoracic actinomycosis": "داء الشعيات الصدري (شكل خطير من داء الشعيات يصيب الصدر)",
 "thoracic aorta": "أبهر صدري (فرع من الأبهر النازل؛ ينقسم إلى الشرايين الحرقفية)",
 "thoracic cavity": "قَفَص صَدْرِيّ",
 "thoracic duct": "قناة صدرية (القناة الرئيسية للجهاز الليمفاوي)",
 "thoracic medicine": "طب الصدر (فرع الطب الذي يتعامل مع تشخيص وعلاج أمراض الصدر)",
 "thoracic nerve": "عصب صدري (أي من اثني عشر زوجاً من الأعصاب الشوكية الخارجة من المنطقة الصدرية للحبل الشوكي)",
 "thoracic outlet syndrome": "متلازمة مخرج الصدر (أحاسيس وخز في الأصابع؛ ناجمة عن الضغط على العصب المغذي للذراع)",
 "thoracic vein": "وريد صدري (أوردة تصرف الجدران الصدرية)",
 "thoracic vertebra": "فَقَرَة صَدْرِيَّة",
 "thoracocentesis": "بزل الصدر (إزالة السوائل من الصدر عن طريق البزل لأغراض تشخيصية أو علاجية)",
 "thoracoepigastric vein": "وريد صدري شرسوفي (وريد ينشأ من منطقة الوريد الشرسوفي السطحي ويفتح في الوريد الإبطي أو الوريد الصدري)",
 "thoracotomy": "بضع الصدر (شق جراحي في جدران الصدر لفتح التجويف الجنبي)",
 "thorax": "صدر (جزء جسم الحشرة الذي يحمل الأجنحة والأرجل) / صدر, قفص صدري (جزء الجذع البشري بين الرقبة والحجاب الحاجز أو الجزء المقابل في الفقاريات الأخرى) / صدر (المنطقة الوسطى من جسم المفصليات بين الرأس والبطن)",
 "thorazine": "ثورازين, كلوربرومازين (دواء (الاسم التجاري ثورازين) مشتق من الفينوثيازين له تأثيرات مضادة للذهان ويستخدم كمهدئ ومهدئ للأعصاب)",
 "thoreauvian": "ثوروي (يتعلق بـ أو يشبه أو على طريقة هنري ديفيد ثورو)",
 "thoriated": "مضحك, مقهقه (كونه أو يبدو كضحك عصبي أو مكبوت)",
 "thorite": "ثوريت (معدن مشع يتكون من سيليكات الثوريوم؛ مصدر للثوريوم يوجد في الجرانيت الخشن)",
 "thorium": "ثُورِيُوم",
 "thorium-228": "ثوريوم-228, راديوثوريوم (نظير مشع للثوريوم برقم كتلي 228)",
 "thorn": "أَسَلَة / شَوْكَة (أداة لتناول الطعام تتكون عادةً من مقبض وعدة أسنان حادة، وتُستعمل لغرز الطعام وحمله إلى الفم)\nمثال: هناك شوكة ناقصة.",
 "thorn apple": "تفاح شائك, داتورا (أي من عدة نباتات من جنس داتورا)",
 "thorn-tipped": "ذُو طَرَفٍ شَائِك ((لِلنَّبَاتِ) ذُو طَرَفٍ يَنْتَهِي بِقَتَادَة)",
 "thornbill": "منقار الشوك (أي من الطيور الطنانة المتنوعة في أمريكا الجنوبية ذات منقار مدبب حاد)",
 "thornbush": "شَوْك",
 "thorniness": "حدة, ضغينة (أبوب خشن ومرير) / شوكية, وخز (جودة التغطية بأشواك وخازة) / تعقيد, صعوبة (صفة الامتلاء بالصعوبات أو التعقيدات أو النقاط المثيرة للجدل)\nمثال: ونظراً لتعقيد القضايا المطروحة، لا يمكن استبعاد توقف العمل في جميع موانئ الساحل الغربي",
 "thornless": "عَدِيم الأَشْوَاك (خالٍ من الأشواك أو الإبر)",
 "thorny": "شَائِك",
 "thorny amaranth": "قطيفة شائكة (نبات حولي قائم في آسيا الوسطى الاستوائية وأفريقيا له زوج من الأشواك المتباعدة عند معظم عقد الأوراق)",
 "thorny skate": "ورنك شائك (سمكة قاع تعيش في المياه الباردة ولها أشواك على الظهر؛ يصل طولها إلى 40 بوصة)",
 "thorough": "مُفَصَل / شَامِل",
 "thorough bass": "باص مرقم, باص مستمر (جزء باص مكتوب بالكامل ومصحوب بأرقام للإشارة إلى الكوردات التي سيتم عزفها)",
 "thoroughbred": "أَصِيل",
 "thoroughbred race": "سباق الخيول الأصيلة (سباق بين الخيول الأصيلة)",
 "thoroughbred racing": "سباق الخيول الأصيلة (رياضة سباق الخيول الأصيلة)",
 "thoroughfare": "شَارِع رَئِيسِيّ",
 "thoroughgoing": "شَامِل, مُسْتَقْصٍ (يُنفَّذ بشمول وإحاطة تامّة؛ ليس سطحيًّا أو جزئيًّا)",
 "thoroughly": "باستفاضة, بدقة (بطريقة شاملة) / بشكل جيد, بقوة (كلياً وبالكامل)\nمثال: بحثنا في الملفات بدقة",
 "thoroughness": "استقصاء, شمولية (اجتهاد في أداء جميع جوانب المهمة) / اسْتِيعَاب, شُمُول (خاصية التميز بالتفصيل الكامل، والاكتمال في جميع النواحي)",
 "thoroughwort": "جابر العظام, غافث مثقوب (عشب معمر في جنوب شرق الولايات المتحدة له رؤوس زهرية بيضاء الشعاع؛ كان يستخدم سابقاً في الطب الشعبي)",
 "thortveitite": "ثورتفيتيت (معدن يتكون من سيليكات الإسكانديوم والإيتريوم؛ مصدر للإسكانديوم)",
 "those": "أُولَٰئِكَ, تِلْكَ",
 "thoth": "تحوت",
 "thou": "أَنْتَ, أَنْتِ (أنْتَ ضَميرُ رَفْعٍ مُنْفَصِلٌ لِلْمُخاطَبِ وَالْمُخاطَبَةِ)\nمثال: أنت لست صديقنا.",
 "though": "رَغْم أَنّ ((رَغَمَ) رَغْمًا، ومَرْغَمًا، ومَرْغَمَةً: ذَلَّ؛ (رَغَمَ) ذل عن كَرْه. يقال (رغَمَ) أَنْفُه)\nمثال: إنه سعيد رغم فقره.",
 "thought": "فِكْر, فِكْرَة (أَعْمَلَ عقله ليصل إلى شيءٍ، ليحل مشكلةً. (يتعدى تعدية عامة بفي)) / فِكْر, تَفْكِير (أَعْمَلَ عقله ليصل إلى شيءٍ، ليحل مشكلةً. (يتعدى تعدية عامة بفي))\nمثال: إنها فكرة جيدة.",
 "thought police": "بوليس الفكر",
 "thought process": "تفكير, فكر (عملية استخدام عقلك للنظر في شيء ما بعناية)\nمثال: التفكير دائماً ما يجعله يعبس",
 "thought transference": "انتقال الأفكار, تخاطر (تواصل ظاهري من عقل إلى آخر دون استخدام الإدراك الحسي)",
 "thought-image": "صورة الفكر, صورة خيالية (صورة ذهنية ينتجها الخيال)",
 "thought-out": "عَمِيق اَلتَّفْكِير",
 "thought-provoking": "مُثِير لِلاهْتِمَام, مُحَفِّز لِلتَّفْكِير (يحفز الاهتمام أو التفكير العميق)",
 "thought-reader": "قارئ الأفكار (ساحر يبدو كأنه يميز أفكار شخص آخر (عادة عن طريق إشارات ذكية من شريك)) / قارئ الأفكار, متخاطر (شخص لديه القدرة على توصيل الأفكار مباشرة)",
 "thoughtful": "عَمِيق اَلتَّفْكِير",
 "thoughtfully": "بتفكير, بعناية (إظهار المراعاة والتفكير) / بتأمل, بشرود (بطريقة متأملة)\nمثال: جلب معه بعناية بعض الطعام للمشاركة",
 "thoughtfulness": "اهتمام, مراعاة (عمل ينم عن مراعاة وتفكير بالآخرين) / تفكير, روية (سمة التفكير بعناية قبل التصرف) / اهتمام بالآخرين, مراعاة (احترام ومراعاة لطيفة للآخرين) / تأمل, تفكر (تفكير هادئ ومطول ومركّز)\nمثال: لم يظهر أي مراعاة لمشاعرها",
 "thoughtless": "غَافِل, لَامُبَالٍ (بلا اكتراث أو اهتمام بالآخرين) / أرعن, طائش (يظهر نقصًا في التفكير المتأني)\nمثال: تحول النقاش إلى مشاحنات طائشة",
 "thoughtlessly": "باستهتار, بلا تفكير (إظهار عدم التفكير) / دون تفكير (بطريقة خالية من التفكير)\nمثال: عامل والديه باستهتار",
 "thoughtlessness": "طيش, عدم اكتراث (سمة عدم التفكير بعناية قبل التصرف) / اسْتِهْتَار, طَيْش (صفة الفشل في مراعاة شعور الآخرين)",
 "thousand": "أَلْف, ١٠٠٠ (العدد الذي يساوي عَشْر مِئَات. يُذَكَّر بإعتبار لفظه المذكر وإذا كان عن النُقُود يؤنث بإعتبار أن النقود مؤنثه)\nمثال: ألف شكر على لطفك.",
 "thousand island dressing": "تتبيلة ثاوزند آيلاند (مايونيز مع صلصة الفلفل الحار أو الكاتشب وزيتون وفلفل مفروم وبيض مسلوق)",
 "thousand times": "ألف ضعف (بمقدار ثلاثة درجات أسية (ألف مرة))\nمثال: هذا السم أكثر سمية بألف ضعف",
 "thousand-fold": "ألف ضعف (بمقدار ثلاثة درجات أسية (ألف مرة))\nمثال: هذا السم أكثر سمية بألف ضعف",
 "thousandth": "اَلْأَلْفُ (العدد الترتيبي لألف في العدّ) / جُزْء مِن أَلْف, وَاحِد بِالأَلْف (جزء واحد من ألف جزء متساوي) / الألف, المتمم للألف (المركز 1,000 في سلسلة معدودة من الأشياء)",
 "thracian": "تراقي, ثراقي (من أو يتعلق بتراقيا أو شعبها أو ثقافتها) / اللغة التراقية (لغة تراقية فريجية كان يتحدث بها شعب تراقيا القديم ولكنها انقرضت بحلول أوائل العصور الوسطى) / تراقي (أحد سكان تراقيا القديمة)",
 "thracian language": "اللغة التراقية (لغة تراقية فريجية كان يتحدث بها شعب تراقيا القديم ولكنها انقرضت بحلول أوائل العصور الوسطى)",
 "thraco-phrygian": "تراقي فريجي (فرع منقرض من عائلة اللغات الهندية الأوروبية يعتقد البعض أنه مرتبط بالأرمينية)",
 "thraldom": "رق, عبودية (حالة الخضوع لسيطرة شخص آخر)",
 "thrall": "رقيق, عبد (شخص محتجز في العبودية) / رق, عبودية (حالة الخضوع لسيطرة شخص آخر)",
 "thralldom": "رق, عبودية (حالة الخضوع لسيطرة شخص آخر)",
 "thrash": "خبط (ركلة سباحة تستخدم أثناء الطفو في الماء)",
 "thrasher": "قرش دراس (قرش كبير يعيش في عرض البحار الدافئة ذو ذيل يشبه السوط يستخدمه لتجميع الأسماك الصغيرة ليتغذى عليها) / دراس (طائر مغرد أمريكي يشبه السمنة قادر على تقليد أغاني الطيور الأخرى) / آلة درس, دراسة (آلة زراعية لفصل البذور أو الحبوب عن القشور والقش)",
 "thrashing": "جلد, ضرب (فعل إيقاع العقاب البدني بضربات متكررة) / سحق, هزيمة نكراء (هزيمة قوية)",
 "thread": "خَيْط, خيط ((خَيَّطَ) الشَّيْبُ في رأسِهِ تَخْييطًا: بَدَا، أو صارَ كالخُيُوطِ فَتَخَيَّطَ رأسُهُ بالشَّيْبِ؛ (خَيَّطَ) الثَّوْب: خاطه) / خَيْط ((خَيَّطَ) الشَّيْبُ في رأسِهِ تَخْييطًا: بَدَا، أو صارَ كالخُيُوطِ فَتَخَيَّطَ رأسُهُ بالشَّيْبِ؛ (خَيَّطَ) الثَّوْب: خاطه) / مَوْضُوع\nمثال: حل الصرة تلقى خيط.",
 "thread blight": "لفحة خيطية (مرض يصيب النباتات الخشبية الاستوائية (الكاكاو أو الشاي أو الحمضيات))",
 "thread maker": "غزّال (شخص يغزل (يبرم الألياف لتصبح خيوطاً))",
 "thread-fish": "السمكة الخيطية (سمكة لها أشعة أمامية ممدودة جداً على الزعانف الظهرية والشرجية)",
 "threadbare": "مُبْتَذَل, مُسْتَهْلَك (مُكرَّر أكثر من اللازم؛ مألوف بشكل مفرط بسبب كثرة الاستخدام) / بَالٍ, مَسْحُوقُ الوَبَرِ (قَدْ زَالَ وَبَرُهُ بِحَيْثُ تَظْهَرُ الخُيُوطُ)",
 "threaded": "مسنن, مقلوظ ((عن البراغي والمسامير) له أسنان لولبية)",
 "threader": "إبرة غليظة, مِخْلال (إبرة غير حادة لادخال شريط عبر الحلقات)",
 "threadfin": "خيطية الزعانف (أسماك بحرية استوائية تشبه البوري لها زعانف صدرية ذات أشعة طويلة تشبه الخيوط)",
 "threadfish": "السمكة الخيطية (سمكة لها أشعة أمامية ممدودة جداً على الزعانف الظهرية والشرجية)",
 "threadiness": "تليف, خيطية (حالة أو صفة التكون من ألياف أو خيوط دقيقة)\nمثال: يسير الغزل بشكل أفضل مما توقعت بسبب خيطية الغزل",
 "threadleaf groundsel": "شيخة خيطية الأوراق (نبات ورقي كثيف أزرق مخضر مغطى بصوف أبيض كثيف ويحمل عناقيد متفرعة من رؤوس الزهور الصفراء؛ جنوب غرب الولايات المتحدة؛ سام لحيوانات المراعي)",
 "threadlike": "خَيْطِيّ (رَقِيقُ القُطْرِ؛ يُشْبِهُ الخَيْط)",
 "threads": "ثريدز",
 "threadworm": "دودة خيطية, دودة دبوسية (دودة صغيرة تشبه الخيط تصيب أمعاء الإنسان والمستقيم خاصة عند الأطفال)",
 "thready": "خَيْطِيّ (رَقِيقُ القُطْرِ؛ يُشْبِهُ الخَيْط) / لَزِجٌ خَيْطِيّ (يُشَكِّلُ خُيُوطًا لَزِجَةً أَوْ غَرَوِيَّة)",
 "threat": "تَهْدِيد",
 "threaten": "هَدَّدَ / أَنْذَرَ",
 "threatened": "مُهَدَّد ((عن النباتات أو الحيوانات) مُرَجَّحٌ أَنْ يُصْبِحَ مُهَدَّدًا بِالاِنْقِرَاضِ قَرِيبًا)",
 "threatened abortion": "إجهاض منذر, تهديد بالإجهاض (ظهور أعراض تشير إلى فقدان وشيك لنتاج الحمل)",
 "threatening": "مُتَوَعِّد, مُنْذِر بِالشَّرّ (يهدد أو ينذر بتطورات شريرة أو مأساوية) / مُتَجَهِّم, مُكْفَهِرّ (مُعتم بالغيوم مع إيحاء بالتهديد)",
 "threateningly": "بتهديد, بوعيد (بطريقة مهددة)\nمثال: انخفض الصوت على الطرف الآخر من الخط بتهديد",
 "three": "ثَلَاثَة, ثَلَاث (في هو أحد الأعداد الرياضية، وهو أصغر عدد فردي أولي)\nمثال: حملت ثلاثة كتب.",
 "three hundred": "ثَلَاثُمِئَة, ثَلَاثُمِا۟ئَة",
 "three kings' day": "6 يناير, عيد الغطاس (بعد اثني عشر يومًا من عيد الميلاد؛ يحتفل بزيارة الحكماء الثلاثة للطفل يسوع)",
 "three o'clock": "اَلسَّاعَة اَلثَّالٰثَة",
 "three thousand": "ثَلَاثَة آلَاف (في هو أحد الأعداد الرياضية، وهو أصغر عدد فردي أولي)\nمثال: حملت ثلاثة كتب.",
 "three times": "ثلاثة أضعاف (بمعامل ثلاثة)\nمثال: زاد إيجارنا ثلاثة أضعاف في السنوات الخمس الماضية",
 "three year old": "حصان الثلاث سنوات (حصان سباق عمره ثلاث سنوات)",
 "three-bagger": "ضربة ثلاثية (ضربة قاعدة يتوقف عندها الضارب بأمان عند القاعدة الثالثة)",
 "three-banded armadillo": "مدرع ثلاثي الأحزمة (مدرع من أمريكا الجنوبية بثلاثة أحزمة من الصفائح العظمية)",
 "three-base hit": "ضربة ثلاثية (ضربة قاعدة يتوقف عندها الضارب بأمان عند القاعدة الثالثة)",
 "three-card monte": "ثري كارد مونتي, مونتي (لعبة ورق قمار من أصل إسباني؛ يتم توزيع 3 أوراق مكشوفة ويراهن اللاعبون على أن إحداها ستطابق قبل الأخريات أثناء توزيع الأوراق من الحزمة واحدة تلو الأخرى)",
 "three-centered arch": "قوس ثلاثي المراكز (قوس مستدير يُرسم منحناه الداخلي بدوائر لها ثلاثة مراكز)",
 "three-cornered": "ثُلَاثِيّ (يشمل مجموعة أو ثلاثة أطراف) / ثُلَاثِيُّ الأَرْكَانِ (ذو ثلاثة أركان أو زوايا)",
 "three-cornered leek": "كراث ثلاثي الزوايا (كراث أوروبي متوطن في بريطانيا العظمى؛ الأوراق مثلثة الشكل)",
 "three-d": "ثُلَاثِيُّ الأَبْعَادِ (ينطوي على ثلاثة أبعاد أو جوانب أو يتصل بها؛ يُعطي إيهاماً بالعمق) / ثلاثي الأبعاد (ذو شكل أو مظهر ثلاثي الأبعاد) / ثلاثي الأبعاد (فيلم بصور لها شكل أو مظهر ثلاثي الأبعاد)\nمثال: أليست الأحلام دائماً ثلاثية الأبعاد؟",
 "three-day event": "سباق الأيام الثلاثة (منافسة فروسية؛ اليوم الأول هو الترويض، والثاني هو اختراق الضاحية، والثالث هو قفز الحواجز)",
 "three-day measles": "حصبة ألمانية (مرض فيروسي معدٍ هو شكل أخف من الحصبة يستمر ثلاثة أو أربعة أيام؛ يمكن أن يضر بالجنين خلال الأشهر الثلاثة الأولى)",
 "three-decker": "سفينة حربية بثلاثة أسطح (سفينة حربية تحمل مدافع على ثلاثة أسطح) / سفينة بثلاثة أسطح (أي سفينة لها ثلاثة طوابق (أسطح)) / كلوب سندويتش (مصنوعة من ثلاث شرائح من الخبز المحمص عادة)",
 "three-dimensional": "ثُلَاثِيُّ الْأَبْعَادِ",
 "three-dimensional figure": "شكل ثلاثي الأبعاد, شكل صلب (شكل يمكن وصفه بثلاثة معايير أو الهندسة الديكارتية)",
 "three-dimensional radar": "رادار ثلاثي الأبعاد (رادار يحدد الارتفاع وكذلك السمت والمسافة للهدف)",
 "three-dimensionality": "ثلاثية الأبعاد (خاصية امتلاك ثلاثة أبعاد)",
 "three-figure": "مِنْ ثَلَاثَةِ أَرْقَام ((في الأعداد) مكتوب بثلاثة أرقام)",
 "three-fold": "ذُو وَجْهَيْنِ, مُتَعَدِّدُ الْأَوْجُهِ (له أكثر من جانب أو صفة مختلفة بوضوح) / ثَلَاثَةُ أَضْعَافٍ (ثلاثة أمثال الكمية أو العدد)",
 "three-fourths": "ثَلَاثَة أَرْبَاع (ثلاثة من أربعة أجزاء متساوية)\nمثال: ثلاثة أرباع الرطل",
 "three-hitter": "مباراة بثلاث ضربات (مباراة لا يسمح فيها الرامي للفريق المنافس سوى ب3 ضربات)",
 "three-hundredth": "اَلثَّلَاثُمِئَةِ (العدد الترتيبي لثلاثمئة في العدّ)",
 "three-lane": "ذُو ثَلَاثِ حَارَاتٍ (به حارة في كل اتجاه وحارة وسطى للتجاوز)",
 "three-legged": "ثُلَاثِيّ الأَرْجُل (لَهُ ثَلاث أَرْجُل أَوْ ما يُشْبِهُها)",
 "three-lipped": "ثُلَاثِيُّ الشَّفَة (لَهُ ثَلَاثُ شِفَاه)",
 "three-lobed": "ثُلَاثِيّ الفُصُوص (ذو ثلاثة فصوص) / ثُلَاثِيّ الفُصُوص ((عن شكل الورقة) مُقسَّم إلى ثلاثة فُصوص)",
 "three-membered": "ثُلَاثِيُّ الأَعْضَاء (مُرَكَّبٌ كِيمِيَائِيٌّ لَهُ حَلْقَةٌ مِنْ ثَلَاثَةِ أَعْضَاء)",
 "three-mile limit": "حد الثلاثة أميال (حد المياه الإقليمية لدولة ما)",
 "three-mover": "مَسْأَلَة ثَلَاث نَقَلَات (مسألة بشرط 'الأبيض يتحرك وينفذ كش مات للأسود في ما لا يزيد عن ثلاث نقلات ضد أي دفاع')",
 "three-needled": "ذُو ثَلَاث إِبَر ((عن الصَّنَوْبَريّات) ذو ثلاث إبر)",
 "three-part harmony": "تناغم ثلاثي الأجزاء (تناغم يحتوي فيه كل كورد على ثلاث نغمات تخلق ثلاثة خطوط لحنية)",
 "three-party": "ثُلَاثِيّ الأَطْرَاف (يشمل ثلاثة أطراف أو عناصر)",
 "three-petaled": "ثُلَاثِيّ البَتَلَات ((في الأزهار) ذو ثلاث بتلات)",
 "three-petalled": "ثُلَاثِيّ البَتَلَات ((في الأزهار) ذو ثلاث بتلات)",
 "three-piece": "ثلاث قطع ((للملابس) مصنوع من أو يتكون من ثلاثة أجزاء أو قطع)\nمثال: البدلة الرسمية القياسية المكونة من ثلاث قطع: سترة وسروال وصدرية",
 "three-piece suit": "بدلة ثلاثية القطع (بدلة عمل تتكون من سترة وصدرية وبنطال)",
 "three-ply": "ثُلَاثِيُّ الطَّبَقَات (ذُو سَمَاكَةٍ مُكَوَّنَةٍ مِنْ ثَلَاثِ طَبَقَاتٍ أَوْ خُيُوط)",
 "three-point landing": "هبوط ثلاثي النقاط (هبوط تلمس فيه جميع عجلات الطائرة الثلاث الأرض في نفس الوقت)",
 "three-point switch": "مفتاح ثلاثي, مفتاح ثلاثي الاتجاهات (مفتاح كهربائي له ثلاثة أطراف توصيل؛ يستخدم للتحكم في دائرة كهربائية من موقعين مختلفين)",
 "three-point turn": "دوران ثلاثي النقاط (عملية تدوير المركبة في مساحة محدودة عن طريق التحرك في سلسلة من الأقواس الخلفية والأمامية)",
 "three-pronged": "ثُلَاثِيُّ الشُّعَب (ذُو ثَلَاثِ شُعَب)",
 "three-quarter binding": "تجليد ثلاثة أرباع (تجليد يكون فيه الكعب ومعظم الجوانب من مادة مختلفة عن بقية الغلاف)",
 "three-quarters": "ثَلَاثَة أَرْبَاع (ثلاثة من أربعة أجزاء متساوية)\nمثال: ثلاثة أرباع الرطل",
 "three-ring circus": "سيرك ثلاثي الحلقات (سيرك يقدم عروضاً متزامنة في ثلاث حلقات)",
 "three-seeded": "ثُلَاثِيُّ البُذُور (يحتوي على ثلاث بذور)",
 "three-seeded mercury": "أكاليفا فرجينيا (عشب ضار في شرق أمريكا الشمالية)",
 "three-sided": "ثُلَاثِيّ الأَضْلَاع (ذو ثلاثة أضلاع)",
 "three-spined stickleback": "شائكة الظهر ثلاثية الأشواك (تعيش في الأنهار والمناطق الساحلية)",
 "three-toed sloth": "كسلان ثلاثي الأصابع (حيوان الكسلان الذي يمتلك ثلاثة مخالب طويلة في كل قدم أمامية وخلفية)",
 "three-way": "ثُلَاثِيّ الأَطْرَاف (يشمل ثلاثة أطراف أو عناصر)",
 "three-way calling": "مكالمة ثلاثية (طريقة لإضافة طرف ثالث إلى محادثتك دون مساعدة عامل الهاتف)",
 "three-way switch": "مفتاح ثلاثي, مفتاح ثلاثي الاتجاهات (مفتاح كهربائي له ثلاثة أطراف توصيل؛ يستخدم للتحكم في دائرة كهربائية من موقعين مختلفين)",
 "three-wheel": "ثلاثي العجلات (مكون من أو متعلق بالمركبات ذات العجلات الثلاث)\nمثال: دراجة ثلاثية العجلات",
 "three-wheeled": "ثلاثي العجلات (مكون من أو متعلق بالمركبات ذات العجلات الثلاث)\nمثال: دراجة ثلاثية العجلات",
 "three-year-old": "بِعُمُر ثَلَاث سَنَوَات (في عامه الثالث من العمر)",
 "three-year-old horse": "حصان الثلاث سنوات (حصان سباق عمره ثلاث سنوات)",
 "threefold": "ثلاثة أضعاف (بمعامل ثلاثة) / ذُو وَجْهَيْنِ, مُتَعَدِّدُ الْأَوْجُهِ (له أكثر من جانب أو صفة مختلفة بوضوح) / ثَلَاثَةُ أَضْعَافٍ (ثلاثة أمثال الكمية أو العدد)\nمثال: زاد إيجارنا ثلاثة أضعاف في السنوات الخمس الماضية",
 "threepence": "ثلاثة بنسات (عملة سابقة من النيكل والنحاس للمملكة المتحدة تعادل ثلاثة بنسات)",
 "threepenny": "تَافِه القِيمَة, زَهِيد (ذو قيمة زهيدة لا تُذكَر) / ثُلَاثِيُّ الْبِنْس ((في قياس المسامير) بطول 1.25 بوصة)",
 "threescore": "سِتُّونَ (يَدُلُّ عَلَى العَدَد 60) / ستون (مجموعة مكونة من 3 ضرب 20 عضواً (ستون))",
 "threesome": "ثالثة, ثلاثي (ثلاثة أشخاص يُنظر إليهم كوحدة واحدة) / ثَلَاثَة, ثُلَاثِيّ (العدد الأصلي الذي هو مجموع واحد وواحد وواحد)",
 "threnody": "جنائزية, رثاء (أغنية أو ترنيمة حداد تؤلف أو تؤدى كذكرى لشخص ميت)",
 "threonine": "ثريونين (حمض أميني بلوري عديم اللون يوجد في البروتين؛ وهو عنصر أساسي في تغذية الإنسان)",
 "thresh": "دَرَسَ ((متعدٍّ بنفسه) عَلَّمَ، لَقَّنَ؛ اِمْتَهَنَ التَّعْلِيم)\nمثال: أراك بعد الدرس.",
 "thresher": "قرش دراس (قرش كبير يعيش في عرض البحار الدافئة ذو ذيل يشبه السوط يستخدمه لتجميع الأسماك الصغيرة ليتغذى عليها) / آلة درس, دراسة (آلة زراعية لفصل البذور أو الحبوب عن القشور والقش)",
 "thresher shark": "قرش دراس (قرش كبير يعيش في عرض البحار الدافئة ذو ذيل يشبه السوط يستخدمه لتجميع الأسماك الصغيرة ليتغذى عليها)",
 "thresher's lung": "رئة المزارع (التهاب الأسناخ الناتج عن رد فعل تحسسي للأبواغ الفطرية في الغبار المستنشق من القش المتعفن)",
 "threshing": "دِيَاسَة",
 "threshing floor": "جُرْن, جَرِين (تَعَوَّدَ أَمْرًا وَمَرَنَ عَلَيْهِ؛ جَرَنَ الثَّوْبُ وَالدِّرْعُ وَالأَدِيمُ: لَانَ وَانْسَحَقَ)",
 "threshing machine": "آلة درس, دراسة (آلة زراعية لفصل البذور أو الحبوب عن القشور والقش)",
 "threshing sledge": "نَوْرَج, مِدْرَسَة",
 "threshold": "عَتَبَة / بِدَايَة (في بِدَايَة الأمْرِ كانَ مُهَذَّباً : فِي أوّلِهِ؛ البِدَايَة والنِّهاية: المبتدأ والمنتهى)\nمثال: هذه بداية جيدة.",
 "threshold element": "عنصر العتبة (عنصر منطقي يؤدي عملية العتبة)",
 "threshold function": "دَالَّة العَتَبَة (دالة تأخذ القيمة 1 إذا تجاوزت دالة محددة للحجج عتبة معينة و 0 خلاف ذلك)",
 "threshold gate": "عنصر العتبة (عنصر منطقي يؤدي عملية العتبة)",
 "threshold level": "مستوى العتبة (مستوى الشدة الذي بالكاد يمكن إدراكه)",
 "threshold operation": "عملية عتبة (عملية تجرى على المعاملات للحصول على قيمة دالة العتبة)",
 "threskiornis aethiopica": "أبو منجل المقدس (أبو منجل أفريقي كان يقدسه المصريون القدماء)",
 "thrice": "ثَلَاثَ مَرَّاتٍ, ثَلَاثًا",
 "thrift": "بخل, تقتير (الحرص الشديد في إنفاق المال؛ التردد في إنفاق المال بلا ضرورة) / أرميريا, زهرة الثريفت (أي من العديد من النباتات دائمة الخضرة المحبة للشمس ومنخفضة النمو من جنس أرميريا لها رؤوس مستديرة من الزهور الوردية أو البيضاء)",
 "thrift institution": "مؤسسة ادخار (مؤسسة مالية إيداعية تهدف إلى تشجيع المدخرات الشخصية وشراء المنازل)",
 "thriftily": "باقتصاد, بتوفير (بطريقة مقتصدة)\nمثال: منشفة مستعملة تركها باقتصاد على الحافة أسفل المرآة بدلاً من وضعها في سلة الغسيل",
 "thriftiness": "اقتصاد, تدبير (الاقتصاد في إنفاق المال أو الموارد)\nمثال: يشتهر الاسكتلنديون باقتصادهم",
 "thriftless": "لَا يُبَالِي بِالمُسْتَقْبَل, مُسْرِف (لا يكترث بالمستقبل في إنفاقه)",
 "thriftlessly": "بإسراف, بلا تدبير (بطريقة مسرفة)\nمثال: يعيش بلا تدبير يوماً بيوم",
 "thriftlessness": "إتلاف, إهدار (سمة إهدار الموارد)\nمثال: حياة تتسم بسوء التدبير والإهدار",
 "thriftshop": "متجر خيري, متجر سلع مستعملة (متجر يبيع بضائع مستعملة بأسعار مخفضة)",
 "thrifty": "حَرِيص, مُقْتَصِد (حريص على المستقبل في إنفاق المال) / مدبر, مقتصد (حريص ومجتهد في استخدام الموارد)",
 "thrill": "إثارة, تشويق (شيء يجعلك تشعر بشعور أو إحساس مفاجئ ومكثف) / رجفة, رعشة (إحساس بالخوف يكاد يكون ممتعاً) / إثارة, متعة شديدة (الإطلاق السريع لقوة عاطفية مخزنة)\nمثال: إثارة السفر عبر الفضاء",
 "thrilled": "مُبْتَهِج, مُنْتَشٍ (يشعر بإثارة ممتعة شديدة)",
 "thriller": "إِثَارَة, فِلْم مُثِيرَة (إِثَارَة: يُجمع على إثارات)\nمثال: كف عن إثارة غضبي.",
 "thrillful": "مَلِيء بِالإِثَارَة (مليء بالحماس والإثارة)",
 "thrilling": "مُشَوِّق, مُكَهْرِب (يُسَبِّب موجة من المشاعر أو الحماس) / مُرْعِد, مُقْشَعِرّ (يسبب الارتعاش أو القشعريرة كما من البرد أو الخوف أو الصدمة)",
 "thrinax keyensis": "بالميتو فضي, نخيل المفتاح (نخيل مروحي ممتلئ الجسم صغير من جنوب فلوريدا وكوبا)",
 "thrinax microcarpa": "بالميتو فضي, نخيل المفتاح (نخيل مروحي ممتلئ الجسم صغير من جنوب فلوريدا وكوبا)",
 "thrinax morrisii": "بالميتو فضي, نخيل المفتاح (نخيل مروحي ممتلئ الجسم صغير من جنوب فلوريدا وكوبا)",
 "thrinax parviflora": "نخيل القش, نخيل المكنسة (نخيل صغير من جنوب فلوريدا وجزر الهند الغربية يشبه كثيراً بالميتو الفضي)",
 "thrip": "تربس (أي من الحشرات الماصة الصغيرة إلى الدقيقة ذات أجنحة ريشية ضيقة إن وجدت؛ تتغذى على عصارة النبات والعديد منها مدمر)",
 "thripid": "تربس (أي من الحشرات الماصة الصغيرة إلى الدقيقة ذات أجنحة ريشية ضيقة إن وجدت؛ تتغذى على عصارة النبات والعديد منها مدمر)",
 "thrips": "تربس (أي من الحشرات الماصة الصغيرة إلى الدقيقة ذات أجنحة ريشية ضيقة إن وجدت؛ تتغذى على عصارة النبات والعديد منها مدمر)",
 "thrips tobaci": "تربس البصل (ضار بنباتات البصل وأحياناً التبغ)",
 "thrive": "اِزْدَهَرَ, أَهَلَّ",
 "thriving": "رَائِج, مُزْدَهِر (حيوي ومربح للغاية؛ في حالة ازدهار ونمو)",
 "throat": "حَلْق, حُلْقُوم (أصاب حَلْقه أو ضربه في حلقه؛ أزال شعر رأسه أو ذقنه كله بالمُوسَى)\nمثال: حلق زيري لحيته.",
 "throat infection": "التهاب الحلق العقدي (عدوى في البلعوم الفموي واللوزتين بواسطة المكورات العقدية)",
 "throat protector": "واقي حلق (ملابس واقية يرتديها حارس مرمى الهوكي والماسك في البيسبول)",
 "throat sweetbread": "غدة توتية, غدة تيموسية (الغدة التيموسية الصالحة للأكل في الحيوان)",
 "throated": "ذُو حَلْق (له حلق بمواصفات معيَّنة)",
 "throatwort": "جريس قراصي الأوراق, عشبة الحلق (زهرة جرس أوروبية بأزهار زرقاء بنفسجية إلى ليلكية كانت تستخدم سابقاً لعلاج التهاب الحلق)",
 "throaty": "حَلْقِيّ (يبدو كأنَّه يُنطَق من أعماق الحلق)",
 "throb": "خَفَقَ (الجذر يعبر عن الحركة والاضطراب الخفيف الذي ينشأ عن الرياح أو القلوب أو الرايات، ويستخدم لوصف الطبيعة والأحاسيس والجوانب الحسية المختلفة؛ عبّر عن حركة سريعة، سواء كانت اضطراباً أو ضرباً خفيفاً أو صوتاً، بالإضافة إلى صفةٍ تُوصف بها الخيل) / خَفَقَ, نَبَضَ (الجذر يعبر عن الحركة والاضطراب الخفيف الذي ينشأ عن الرياح أو القلوب أو الرايات، ويستخدم لوصف الطبيعة والأحاسيس والجوانب الحسية المختلفة؛ عبّر عن حركة سريعة، سواء كانت اضطراباً أو ضرباً خفيفاً أو صوتاً، بالإضافة إلى صفةٍ تُوصف بها الخيل) / خَفَقَان",
 "throbbing": "خَافِق, نَابِض (ينبض أو يخفق بقوة أو بعنف) / خفقان, نبض (صوت ذو نبض إيقاعي قوي) / خفقان, نبض قوي (حالة من النبض القوي والسريع (للقلب))\nمثال: خفقان المحركات",
 "throe": "سكرة, نوبة ألم (تشنج شديد من الألم) / ألم شديد, مخاض (مشكلة أو صراع صعب أو مؤلم)\nمثال: سكرات الموت",
 "throes": "سكرات, مخاض (نوبات عنيفة من المعاناة)\nمثال: سكرات الموت",
 "thrombasthenia": "وهن الصفيحات (مرض وراثي جسمي متنحٍ نادر لا تنتج فيه الصفائح الدموية جلطات بالطريقة الطبيعية مما يؤدي إلى النزيف)",
 "thrombectomy": "استئصال الخثرة (إزالة جراحية لجلطة دموية (خثرة) من وعاء دموي)",
 "thrombin": "ثرومبين (إنزيم يعمل على الفيبرينوجين في الدم مما يسبب تجلطه)",
 "thrombocyte": "صفيحة دموية (قطع صغيرة من البروتوبلازم توجد في دم الفقاريات؛ ضرورية لتخثر الدم)",
 "thrombocytopenia": "نقص الصفائح الدموية (مرض دموي يتميز بعدد قليل بشكل غير طبيعي من الصفائح الدموية في الدم)",
 "thrombocytopenic purpura": "فرفرية قليلة الصفيحات (فرفرية مرتبطة بانخفاض في الصفائح الدموية الدائرة والتي يمكن أن تنتج عن مجموعة متنوعة من العوامل)",
 "thrombocytosis": "كثرة الصفيحات (زيادة في عدد الصفائح الدموية في الدم مما يميل إلى التسبب في تكوين جلطات؛ يرتبط بالعديد من الأورام والالتهابات المزمنة وأمراض أخرى)",
 "thromboembolism": "انصمام خثاري (انسداد وعاء دموي بصمة انفصلت عن خثرة)",
 "thrombokinase": "ثرومبوبلاستين (إنزيم يتحرر من الصفائح الدموية ويحول البروثرومبين إلى ثرومبين عند بدء تجلط الدم)",
 "thrombolysis": "إذابة الجلطة (عملية تفتيت وإذابة جلطات الدم)",
 "thrombolytic": "حال للتخثر, مذيب للجلطات (نوع من المستحضرات الصيدلانية يمكنه تفتيت الجلطات التي تمنع تدفق الدم إلى عضلة القلب)",
 "thrombolytic agent": "حال للتخثر, مذيب للجلطات (نوع من المستحضرات الصيدلانية يمكنه تفتيت الجلطات التي تمنع تدفق الدم إلى عضلة القلب)",
 "thrombolytic therapy": "علاج حال للتخثر (علاج يتكون من إعطاء عامل دوائي للتسبب في انحلال جلطة دموية غير طبيعية)",
 "thrombopenia": "نقص الصفائح الدموية (مرض دموي يتميز بعدد قليل بشكل غير طبيعي من الصفائح الدموية في الدم)",
 "thrombophlebitis": "التهاب الوريد الخثري (التهاب الوريد بالتزامن مع تكوين جلطة دموية (خثرة))",
 "thromboplastin": "ثرومبوبلاستين (إنزيم يتحرر من الصفائح الدموية ويحول البروثرومبين إلى ثرومبين عند بدء تجلط الدم)",
 "thrombosed": "مُتَخَثِّر, مُصَاب بِجَلْطَة (مصاب أو مسدود بجلطة دم متخثّرة)",
 "thrombosis": "خُثار",
 "thrombus": "خُثْرَة, جُلْطَة",
 "throne": "عَرْش, كُرْسِيّ (هو كُرْسِيّ المَلِك تحديدا؛ العَرْش: هو عَرش الرَحْمَان فوق سِدْرَة المنتهى)\nمثال: ولي العهد هو من يرث العرش.",
 "throng": "جمهور, حشد كبير (تجمع كبير للناس)",
 "thronged": "مَمْلُوءٌ بِالحُشُودِ (مَلِيءٌ بِأَعْدَادٍ كَبِيرَةٍ مُتَزَاحِمَةٍ)",
 "throstle": "سمنة مغردة (سمنة شائعة من العالم القديم تشتهر بتغريدها) / آلة غزل, مغزل (آلة غزل كانت تستخدم قديماً لفتل ولف ألياف القطن أو الصوف بشكل مستمر)",
 "throttle": "دواسة الوقود, صمام الخانق (صمام ينظم إمداد المحرك بالوقود) / دواسة البنزين, دواسة الوقود (دواسة تتحكم في صمام الخانق)\nمثال: داس على دواسة الوقود",
 "throttle valve": "دواسة الوقود, صمام الخانق (صمام ينظم إمداد المحرك بالوقود)",
 "throttlehold": "إحكام القبضة, خناق (السلطة الكاملة على شخص أو موقف)\nمثال: تملك الشركات قبضة خانقة على وسائل الإعلام",
 "throttler": "خانِق (شخص يقتل عن طريق الخنق)",
 "throttling": "خنق (فعل خنق (شخص ما) عن طريق الضغط على القصبة الهوائية)\nمثال: لا يوجد دليل على أن الخنق تم بواسطة المتهم",
 "through": "عَبْر (الشيء: اجتازه وقطعه من طرف إلى الطرف الآخر كاملا؛ الشخص: مات) / خِلَالَ, عَبْرَ / فِي (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة) / بِوَاسِطَة\nمثال: عبر جرذ الطريق.",
 "through an experiment": "تجريبياً (بأسلوب تجريبي)\nمثال: يمكن تحديد هذا تجريبياً",
 "through and through": "تماماً, كلياً (عبر النطاق بالكامل)\nمثال: تبلل تماماً في المطر",
 "through ball": "تَمْرِيرَةٌ كَاسِرَة, تَمْرِيرَةٌ أَمَامِيَّةٌ",
 "through bill of lading": "بُولِيصَة شَحْن شَامِلَة, بُولِيصَة شَحْن مُوَحَّدَة (بوليصة شحن تصدر عندما تمر الشحنة عبر وسائط نقل مختلفة أو مراكز توزيع مختلفة)",
 "through empirical observation": "إمبيريقياً, تجريبياً (بطريقة تجريبية)\nمثال: يمكن اختبار هذا تجريبياً",
 "throughout": "طَوَال",
 "throughput": "إنتاجية, معدل المعالجة (المخرجات بالنسبة للمدخلات؛ الكمية التي تمر عبر نظام من المدخلات إلى المخرجات (خاصة لبرنامج كمبيوتر خلال فترة زمنية))",
 "throughway": "أوتوستراد, طريق سريع (طريق سريع عريض مصمم لحركة المرور عالية السرعة)",
 "throw": "رَمَى, صَبَّ ((مُتَعَدٍّ بِنَفْسِهِ) جَعَلَهُ يَتَحَرَّكُ فِي الهَوَاءِ)\nمثال: رمى تلك الموزة.",
 "throw away": "طَرَحَ (طَرَحَ الشَّيْءَ: أَلْقَاهُ؛ طَرَحَ فُلَاناً أَرْضاً: أَوْقَعَهُ)\nمثال: طرح زيري سؤالا.",
 "throw pillow": "وسادة زينة (وسادة صغيرة تستخدم لأغراض الديكور)",
 "throw rug": "بساط منثور, سجادة صغيرة (سجادة صغيرة؛ يمكن استخدام العديد منها في غرفة واحدة)",
 "throw stick": "بوميرانغ, عصا الرمي (قطعة خشبية منحنية؛ عند رميها بشكل صحيح تعود إلى الرامي)",
 "throw-in": "رَمْيَةُ تَمَاسّ",
 "throw-weight": "وزن الإطلاق, وزن الحمولة (وزن حمولة الصاروخ (لا يشمل وزن الصاروخ نفسه))",
 "throwaway": "جملة عرضية, كلام عابر (كلمات منطوقة بطريقة عارضة مع تقليل متعمد في التركيز) / مَنْشُور, نَشْرَة إِعْلَانِيَّة (إعلان (عادة ما يطبع على صفحة أو في نشرة) معد للتوزيع على نطاق واسع) / طفل شوارع, متشرد ((أحياناً مهين) صبي بلا مأوى تم التخلي عنه ويجوب الشوارع)\nمثال: أرسل المنشور بالبريد إلى جميع المشتركين",
 "throwback": "ارتداد وراثي, رجعة (عودة ظهور صفة وراثية قديمة) / متأصل, مرتد (كائن له خصائص نوع أكثر بدائية من ذلك الكائن)",
 "thrower": "رَامٍ ((رَامَ) الجُرحُ يَرِيمُ رَيْمًا، ورَيَمَانًا: انْضَمَّ فَمُهُ للبُرْءِ؛ (رَامَ) الحِمْلُ: مالَ)",
 "throwing away": "تخلص, رمي (التخلص من شيء يعتبر عديم الفائدة أو غير مرغوب فيه)",
 "throwing board": "عصا رمي, قاذفة رماح (جهاز يشبه المقلاع يستخدم في مجتمعات بدائية مختلفة لدفع سهم أو رمح)",
 "throwing stick": "بوميرانغ, عصا الرمي (قطعة خشبية منحنية؛ عند رميها بشكل صحيح تعود إلى الرامي) / عصا رمي, قاذفة رماح (جهاز يشبه المقلاع يستخدم في مجتمعات بدائية مختلفة لدفع سهم أو رمح)",
 "thrown": "مَبْرُوم, مَفْتُول (مُلتَفّ معاً كالخيوط المغزولة) / مَطْرُوح أَرْضًا (أُسْقِطَ إِلَى الأَرْضِ بِفِعْلِ قُوَّة)",
 "thrown and twisted": "مَبْرُوم, مَفْتُول (مُلتَفّ معاً كالخيوط المغزولة)",
 "throwster": "فالت الحرير (شخص يفتل خيوط الحرير أو الرايون إلى خيط أو غزل)",
 "thrum": "دندنة (صوت دندنة)\nمثال: كان بإمكانه سماع دندنة البانجو",
 "thrush": "دُجّ (دب وأسرع وتجر؛ يُقَال مَا حج وَلَكِن دج لم يقْصد النّسك بل قصد التِّجَارَة)",
 "thrush nightingale": "عندليب السمنة (عندليب كبير من شرق أوروبا)",
 "thrust": "دفع, قوة دافعة (فعل تطبيق قوة لدفع شيء ما) / نكز, وكز (إيماءة يد حادة (تشبه الضربة)) / طعنة (ضربة قوية بسكين أو أداة حادة أخرى مدببة) / طَعْنَة, نَقْد لَاذِع (نقد لفظي حاد)\nمثال: بعد الوصول إلى السرعة المطلوبة يتم قطع الدفع",
 "thrust bearing": "محمل الدفع (محمل مصمم لتحمل الدفع الموازي لمحور الدوران)",
 "thrust fault": "صدع الدسر, صدع عكسي (صدع جيولوجي يبدو فيه أن الجانب العلوي قد تم دفعه للأعلى بفعل الضغط)",
 "thrust stage": "مسرح ممتد (مسرح يمتد إلى منطقة الجمهور وله مقاعد من ثلاثة جوانب)",
 "thruster": "دافع, صاروخ مناورة (محرك صاروخي صغير يوفر الدفع اللازم لمناورة المركبة الفضائية) / شخص لجوج, متدافع (شخص يقحم نفسه أو يندفع إلى الأمام بقوة)",
 "thrusting": "نكز, وكز (إيماءة يد حادة (تشبه الضربة))\nمثال: حذرني بنكزة بإصبعه",
 "thruway": "أوتوستراد, طريق سريع (طريق سريع عريض مصمم لحركة المرور عالية السرعة)",
 "thryothorus ludovicianus": "نمنمة كارولينا (نمنمة أمريكية كبيرة ذات نداء موسيقي)",
 "thucydides": "ثوقيديدس",
 "thud": "خبط, دبدبة (صوت مكتوم ثقيل (كما ينتج عن ارتطام أشياء ثقيلة))",
 "thudding": "أَصَمّ, كَتِيم (غير صافٍ ولا رنّان؛ يبدو كأنه يضرب شيئاً ليّناً نسبياً)",
 "thug": "بَلْطَجِيّ",
 "thuggee": "البلطجة, الثغي (القتل والسرقة من قبل قطاع الطرق)",
 "thuggery": "أعمال البلطجة, بلطجة (أعمال عنيفة أو وحشية مثل أعمال البلطجية)",
 "thuja occidentalis": "أرز أبيض شمالي, عفص غربي (شجرة دائمة الخضرة صغيرة من شرق أمريكا الشمالية لها أوراق صغيرة تشبه الحراشف على غصينات مسطحة)",
 "thuja orientalis": "عفص شرقي (شجيرة أو شجرة صغيرة آسيوية تزرع على نطاق واسع في الولايات المتحدة وأوروبا؛ في بعض التصنيفات تخصص لجنسها الخاص)",
 "thuja plicata": "أرز أحمر غربي, عفص مطوي (عفص كبير قيم من شمال غرب الولايات المتحدة)",
 "thujopsis dolobrata": "عفص هيبا, هيبا (شجرة يابانية دائمة الخضرة متوسطة إلى كبيرة بطيئة النمو تستخدم للزينة)",
 "thulium": "ثُولِيُوم / تُولِيُوم",
 "thuluth": "ثُلُث (ثَلَثَ الحبل ونحوه يَثْلُثُ ثَلْثًا: فَتَلَهُ من ثلاث قُوى؛ ثَلَثَ العمل: عمله ثلات مرات)\nمثال: الساعة العاشرة والثلث.",
 "thumb": "إِبْهَام (الإِصْبَعُ الغليظةُ الخامسةُ من أَصابع اليد والرِّجل، وهي ذات سُلامَيَيْن (مؤنثة وقد تذكَّر) والجمع: أباهيم، وإبهامات)",
 "thumb index": "دليل القص, فهرس الإبهام (واحدة من سلسلة من الثلمات المستديرة في الحافة الأمامية للكتاب للإشارة إلى الأقسام)",
 "thumbed": "مُتَّسِخٌ مِنَ التَّقْلِيبِ ((لِلصَّفَحَاتِ) بَالٍ أَوْ مُتَّسِخٌ بِسَبَبِ كَثْرَةِ اللَّمْسِ وَالتَّقْلِيبِ)",
 "thumbelina": "ثُومْبِلِينَا",
 "thumbhole": "ثقب الإبهام (ثقب إصبع مصنوع ليلائم الإبهام (كما في كرة البولينج)) / ثقب الإبهام (الثقب في آلة النفخ الخشبية الذي يتم إغلاقه وفتحه بالإبهام)",
 "thumbnail": "ظفر الإبهام (ظفر إصبع الإبهام)",
 "thumbnut": "صامولة فراشة, صامولة مجنحة (صامولة مسننة ذات نتوءات تشبه الأجنحة لتدويرها بالإبهام والسبابة)",
 "thumbprint": "بصمة الإبهام (بصمة إصبع مأخوذة من الإبهام (خاصة من باطن الإبهام))",
 "thumbs up": "إبهام للأعلى, إشارة الرضا (مؤشر على الرضا أو الموافقة)\nمثال: أصبحت عبارة 'إبهامان للأعلى' تستخدم كدلالة على الجودة العالية جداً أو الإجماع على الثناء",
 "thumbscrew": "برغي إبهامي, لولب إبهامي (برغي مصمم ليتم تدويره بالإبهام والأصابع) / معصرة الإبهام (أداة تعذيب تسحق الإبهام)",
 "thumbstall": "واقي الإبهام (غطاء واقٍ لإبهام مصاب)",
 "thumbtack": "دَبُّوس",
 "thump": "خبطة, ضربة قوية (ضربة ثقيلة باليد) / خبط, دبدبة (صوت مكتوم ثقيل (كما ينتج عن ارتطام أشياء ثقيلة))",
 "thumping": "ضَخْم جِدًّا ((غير رسمي) كبير جداً) / خبط, دبدبة (صوت مكتوم ثقيل (كما ينتج عن ارتطام أشياء ثقيلة))",
 "thun": "ثون",
 "thunbergia alata": "ثونبيرغيا, سوزان سوداء العينين (نبات متسلق أفريقي استوائي له أزهار صفراء بمركز أرجواني داكن)",
 "thunder": "رَعْد, رعد (الصَوْت الذي يصدر حين تفرغ الغَيْمَة شحنة كَهْرَبَائيَّة إلى غَيْمَة أخرى أو إلى الأرْض، ويكون معه بَرْق، وغالبا ما يكون مُصَاحَبا بالمَطَر) / رَعَدَ (الصَوْت الذي يصدر حين تفرغ الغَيْمَة شحنة كَهْرَبَائيَّة إلى غَيْمَة أخرى أو إلى الأرْض، ويكون معه بَرْق، وغالبا ما يكون مُصَاحَبا بالمَطَر)\nمثال: البرق يسبق الرعد",
 "thunder lizard": "أباتوصور, برونتوصور (ديناصور عاشب ضخم رباعي الأرجل كان شائعاً في أمريكا الشمالية في أواخر العصر الجوراسي)",
 "thunder mug": "مبولة ليلية, نونية (وعاء للتبول أو التغوط في غرفة النوم)",
 "thunder snake": "ثعبان الدودة (ثعبان صغير محمر يشبه الدودة من شرق الولايات المتحدة)",
 "thunderbird": "طائر الرعد ((الأساطير) روح الرعد والبرق التي يعتقد بعض الأمريكيين الأصليين أنها تتخذ شكل طائر عظيم)",
 "thunderbolt": "صَاعِقَة",
 "thunderclap": "صاعقة, قنبلة (مفاجأة صادمة) / قصفة رعد, هزيم الرعد (دوي رعد حاد واحد)\nمثال: جاءت أنباء الهجوم كالقنبلة",
 "thundercloud": "سَحَاب رَاعِد, سَحَابَة رَاعِدَة (الغيوم المتحركة؛ غُيُوم، دَيْم)\nمثال: القمر موجود خلف السحاب.",
 "thunderer": "صانع الرعد (صانع ضجيج يصدر صوتاً مثل الرعد)",
 "thunderhead": "رأس الركام, قمة رعدية (كتلة بارزة مستديرة من سحابة ركامية ذات حواف لامعة؛ تظهر غالباً قبل العاصفة الرعدية)",
 "thundering": "مُدَوٍّ, هَائِل (كبير أو مُثير للإعجاب بشكل استثنائيّ) / مُدَوٍّ, مُرْعِد (يُصْدِر صوتًا كالرعد)",
 "thunderous": "شَدِيد الشُّؤْم, مُدَوٍّ (شديد النذير بالسوء والشؤم) / مُدَوٍّ, مُصِمّ (عالٍ بما يكفي لإحداث فقدان سمع مؤقت)",
 "thunderousness": "دوي هائل, صوت كالرعد (حالة كون الصوت عالياً جداً وموحياً بالرعد؛ جهارة مدوية)\nمثال: دوي صوت المعلم لم يترك للطلاب شكاً بأنهم في ورطة",
 "thundershower": "زخات رعدية (عاصفة مطرية قصيرة مصحوبة برعد وبرق)",
 "thunderstorm": "عَاصِفَة رَعْدِيَّة",
 "thunderstruck": "مَبْهُوت, مَصْعُوق (كأنه أُصيب بالخرس من شدة الذهول والمفاجأة)",
 "thundery": "رَعْدِيّ (مَصْحُوب بِالرَّعْد) / مُدَوٍّ, مُصِمّ (عالٍ بما يكفي لإحداث فقدان سمع مؤقت)",
 "thunk": "خبطة مكتومة (صوت أجوف مكتوم)\nمثال: أصدرت كرة السلة صوتاً مكتوماً عندما ضربت الحافة",
 "thunnus alalunga": "باكور, تونة بيضاء (تونة كبيرة تعيش في عرض البحر وهي مصدر معظم التونة المعلبة؛ تصل إلى 93 رطلاً ولها زعانف صدرية طويلة؛ توجد في جميع أنحاء العالم في المياه الاستوائية…)",
 "thunnus albacares": "تونة صفراء الزعانف (قد تصل إلى 400 رطل؛ توجد عالمياً في المناطق الاستوائية)",
 "thunnus thynnus": "تونة زرقاء الزعانف (أكبر أنواع التونة؛ تصل إلى 1500 رطل؛ تعيش غالباً في البحار المعتدلة: تتغذى في المناطق القطبية ولكن تتكاثر في المناطق الاستوائية)",
 "thurible": "مبخرة (وعاء لحرق البخور (خاصة تلك التي تتأرجح بسلسلة في الطقوس الدينية))",
 "thurifer": "حامل المبخرة (مساعد كاهن يحمل المبخرة)",
 "thursday": "الْخَمِيس, يَوْم الْخَمِيس",
 "thus": "هَكَذَا, كَذَا / وَهٰكَذَا, لِذَا",
 "thus far": "بعد, حتى الآن (تستخدم في الجمل المنفية لوصف موقف كان قائماً حتى هذه النقطة أو حتى الوقت الحاضر)\nمثال: حتى الآن لم يتصل",
 "thusly": "على هذا النحو, كذلك (بالطريقة المشار إليها)\nمثال: أمسك الفرشاة هكذا",
 "thutmose": "تُحُتْمُس",
 "thwack": "كف",
 "thwart": "فَشَّلَ, أَحْبَطَ (فَشَلَ الطالبُ في الامتحان: لم ينجح في الاختبار ولم يحقق النتيجة المطلوبة؛ فَشَلَ الشيءُ: انهار أو انكسر أو توقف عن العمل)\nمثال: فشل ياني مجددا.",
 "thwarted": "مَهْزُوم, مُحْبَط (فاشل بشكل مخيّب للآمال)",
 "thwarter": "مُعَرْقِل, مُعَوِّق (شخص يعيق بشكل منهجي إجراءً يريد الآخرون اتخاذه)",
 "thwarting": "إحباط, إفشال (فعل إعاقة خطط أو جهود شخص ما) / مُحْبِط, مُعَطِّل (يحول دون تحقيق رغبة أو هدف)",
