 "tape": "شَرِيط",
 "tape cartridge": "خرطوشة شريط, شريط كاسيت (خرطوشة تحتوي على شريط ممغنط؛ للاستخدام مع مسجلات الصوت أو الفيديو أو أنظمة الكمبيوتر)",
 "tape deck": "سطح الشريط, مشغل أشرطة (معدات إلكترونية لتسجيل أو تشغيل الأشرطة المغناطيسية (ولكن بدون مكبرات صوت أو سماعات)؛ مكون في نظام صوتي)",
 "tape drive": "محرك شريط, ناقل شريط (آلية تنقل الشريط المغناطيسي عبر رؤوس القراءة/الكتابة لمشغل/مسجل الشريط)",
 "tape grass": "عشب الشريط, فاليسنيريا (نبات مائي مغمور بأوراق تشبه الشريط؛ العالم القديم وأستراليا)",
 "tape machine": "مسجل أشرطة, مسجل صوت (مسجل مغناطيسي يستخدم الشريط المغناطيسي)",
 "tape measure": "شَرْيِط قِيَاس",
 "tape player": "مشغل أشرطة (معدات إلكترونية لتشغيل الأشرطة المغناطيسية)",
 "tape reader": "قارئ الشريط الورقي (جهاز يستخدم لقراءة المعلومات المشفرة على شريط مثقب)\nمثال: استخدم قارئ الشريط الهواء المضغوط الذي مر عبر الثقوب",
 "tape recorder": "مُسَجِّل",
 "tape recording": "تسجيل شريطي, شريط (تسجيل مصنوع على شريط مغناطيسي)\nمثال: تم دمج التسجيلات المتعددة على شريط رئيسي",
 "tape transport": "محرك شريط, ناقل شريط (آلية تنقل الشريط المغناطيسي عبر رؤوس القراءة/الكتابة لمشغل/مسجل الشريط)",
 "tape-recorded": "مُسَجَّل عَلَى شَرِيط (تَمَّ تَسْجيلُه عَلى شَريط صَوْتِيّ أَوْ مَرْئِيّ)",
 "taped": "مُثَبَّت بِشَرِيط, مُلَصَّق (مُثَبَّت فِي مَكَانِه بِوَاسِطَة شَرِيط لَاصِق) / مُسَجَّل عَلَى شَرِيط (تَمَّ تَسْجيلُه عَلى شَريط صَوْتِيّ أَوْ مَرْئِيّ)",
 "tapeline": "شريط قياس (أداة قياس تتكون من شريط ضيق (قماش أو معدن) معلم بالبوصات أو السنتيمترات ويستخدم لقياس الأطوال)\nمثال: كان يجب على النجار استخدام شريط القياس الخاص به",
 "tapenade": "تابيناد (معجون مكون من القبار والزيتون الأسود والأنشوفة المهروسة مع زيت الزيتون)",
 "taper": "شمعة (عصا من الشمع بداخلها فتيل في المنتصف) / فتيل (خيط منسوج برخاوة (في شمعة أو مصباح زيتي) يسحب الوقود بواسطة الخاصية الشعرية إلى اللهب) / استدقاق (الخاصية التي يمتلكها شكل يضيق باتجاه نقطة (كالإسفين أو المخروط)) / استدقاق, تضاؤل (شكل محدب يضيق باتجاه نقطة معينة)",
 "taper file": "مبرد مستدق (مبرد بحواف متقاربة)",
 "tapered": "مُتَدَرِّج الضِّيق, مُسْتَدَقّ (يضيق تدريجيًّا نحو أحد الأطراف)",
 "tapering": "تخفيض تدريجي, تدريج (عملية تقليل الحجم أو الكمية تدريجياً) / آخِذ فِي التَّلَاشِي, مُتَضَائِل (يتناقص تدريجيًّا حتّى لا يبقى منه إلّا القليل) / مُتَدَرِّج الضِّيق, مُسْتَدَقّ (يضيق تدريجيًّا نحو أحد الأطراف)\nمثال: وصف الطبيب تخفيضاً تدريجياً للجرعة",
 "tapering off": "آخِذ فِي التَّلَاشِي, مُتَضَائِل (يتناقص تدريجيًّا حتّى لا يبقى منه إلّا القليل)",
 "tapestried": "مُعَلَّق بِالنَّسِيج (معلق أو مزين بالأنسجة المزخرفة)",
 "tapestry": "تابيستري, نسيج مزخرف (معلقة حائطية من قماش ثقيل منسوج يدوياً غالباً بتصاميم تصويرية) / بساط حائط, نسيج مزخرف (نستيج ثقيل بتصميم منسوج؛ يستخدم للستائر والتنجيد) / نَسِيج مُعَقَّد (شيء يشبه نسيج التنجيد في تعقيده وتشابكه)\nمثال: نسيج التاريخ الأوروبي",
 "tapestry moth": "عثة السجاد (تتغذى اليرقات على السجاد والمنسوجات الصوفية الأخرى)",
 "tapeworm": "دودة شريطية (ديدان مفلطحة تشبه الشريط تتطفل في أمعاء البشر والفقاريات الأخرى)",
 "tapeworm infection": "عدوى الدودة الشريطية (عدوى معوية بنوع من الديدان الشريطية الطفيلية؛ عادة نتيجة لتناول لحم أو سمك غير مطهو جيداً)",
 "taphephobia": "رهاب الدفن حياً, رهاب المقابر (خوف مرضي من الدفن حياً)",
 "taphouse": "بار, حانة عامة (حانة تتكون من مبنى به بار وغرف عامة؛ غالباً ما توفر وجبات خفيفة)",
 "taping": "تسجيل شريطي, شريط (تسجيل مصنوع على شريط مغناطيسي)\nمثال: تم دمج التسجيلات المتعددة على شريط رئيسي",
 "tapinosis": "تحقير ((بلاغة) شكل من أشكال الكلام يُعطى فيه لشيء ما أهمية أقل من خلال الاسم الذي يطلق عليه مما يستحقه)",
 "tapioca": "تابيوكا (تحضير حبيبي لنشا الكسافا يستخدم لتثخين البودنغ خاصة)",
 "tapioca plant": "بفرة, كسافا مرة (كسافا ذات جذور درنية طويلة صالحة للأكل وسيقان هشة ناعمة؛ تستخدم خاصة لصنع الكاسيري (مشروب مسكر) والتابيوكا)",
 "tapioca pudding": "بودينغ التابيوكا (بودينغ حلو مكثف بالتابيوكا)",
 "tapir": "تَابِير",
 "tapirus indicus": "تابير ملايوي, تابير هندي (تابير يوجد في الملايو وسومطرة)",
 "tapirus terrestris": "تابير العالم الجديد (تابير يوجد في أمريكا الجنوبية وأمريكا الوسطى)",
 "tapis": "بساط حائط, نسيج مزخرف (نستيج ثقيل بتصميم منسوج؛ يستخدم للستائر والتنجيد)",
 "tapotement": "تدليك بالنقر, نقر (تدليك يتم فيه النقر على الجسم بشكل إيقاعي بالأصابع أو بحركات سريعة قصيرة بجوانب اليد؛ يستخدم لفك المخاط على جدران الصدر للمرضى المصابين بالتهاب الشعب…)",
 "tappa": "تابا (قماش يشبه الورق يصنع في جنوب المحيط الهادئ عن طريق طرق لحاء التابا) / تَابَا, قُمَاش اللِّحَاء (اللحاء الليفي الرقيق لتوت الورق ونباتات أخرى)",
 "tappa bark": "تَابَا, قُمَاش اللِّحَاء (اللحاء الليفي الرقيق لتوت الورق ونباتات أخرى)",
 "tapped": "مبزول, مستغل (في حالة تسمح بإخراج السائل المسحوب كما في الثقب أو سحب سدادة)\nمثال: اللاتكس من أشجار المطاط المبزولة",
 "tapper": "راقص التاب, راقص النقر (راقص يصدر إيقاعات باستخدام قطع معدنية في مقدمة وكعب الحذاء) / متنصت, مراقب الهاتف (شخص يتنصت على سلك هاتف أو تلغراف) / قلوظ (عامل يستخدم أداة لقطع خيوط البراغي) / نَاقِر (شخص يضرب سطحاً بخفة وعادة بشكل متكرر)\nمثال: كان ناقرو الأصابع يزعجونها",
 "tappet": "تابع الكامة, رابعة (رافعة يتم تحريكها لكي تنقر شيئاً آخر)",
 "tappet wrench": "مفتاح مفتوح الطرف (مفتاح ربط بفكوك متوازية بتباعد ثابت (غالباً في كلا طرفي المقبض))",
 "tapping": "طرق, نقر (صوت ضربة خفيفة أو طرق)\nمثال: سمع نقر عصا الرجل",
 "taproom": "بار, حانة (غرفة أو منشأة يتم فيها تقديم المشروبات الكحولية عبر طاولة تقديم)\nمثال: أغرق أحزانه في الويسكي في الحانة",
 "taproot": "جِذْر وَتَدِيّ, جَذْر وَتَدِيّ (جِذْرُ ٱلشَّيْءِ هُوَ: أَصْلُهُ؛ في : جذر العدد النوني هو عدد ما إذا رفعناه لقوة ما أعطانا العدد الأصلي)\nمثال: أحسب جذر خمسة بالآلة الحاسبة.",
 "taps": "نداء إطفاء الأنوار ((عسكري) إشارة لإطفاء الأنوار)",
 "tapster": "ساقي البراميل (صاحب حانة يقوم بفتح البراميل الخشبية)",
 "tapuria": "طبرستان",
 "taqiyah": "طَاقِيَّة",
 "taqiyya": "تَقِيَّة",
 "tar": "قَطْرَان (قَطِرَان: مادة سوداء سائلة لزجة القوام)",
 "tar paper": "ورق تسقيف, ورق قطران (ورق ثقيل مشبع بالقطران ويستخدم كجزء من السقف للعزل المائي)",
 "tar pit": "حفرة القطران (تجمع طبيعي للبيتومين على سطح الأرض؛ غالباً ما يعمل كفخ للحيوانات التي تُحفظ عظامها بهذه الطريقة)",
 "tar-wood": "خشب القطران (صنوبر فضي نيوزيلندي ذو شكل مخروطي وفروع مرنة رفيعة طويلة؛ متكيف مع الصيف الرطب البارد والارتفاعات العالية) / خشب القطران, صنوبر جبلي نيوزيلندي (شجيرة نيوزيلندية)",
 "tara vine": "أكتينيديا حادة, كيوي هاردي (كرمة آسيوية متسلقة لها أوراق طويلة مسننة بدقة وعناقيد من الزهور البيضاء تليها ثمار صفراء مخضرة صالحة للأكل)",
 "taracahitian": "تاراكاهيتيان (فرد من مجموعة شعوب في المكسيك)",
 "taradiddle": "تَفَاهَة, دَجَل (حديث أو كتابة مدعية أو سخيفة) / كذبة بيضاء, كذبة تافهة (كذبة تافهة)\nمثال: قال كذبة صغيرة حول أكل سبانخه",
 "tarahumara": "تاراهومارا (فرد من شعب تاراكاهيتيان في شمال وسط المكسيك)",
 "tarahumara frog": "ضفدع تاراهومارا (ضفدع مكسيكي يوجد على مسافة قفزة أو اثنتين من الماء)",
 "taraktagenos kurzii": "تشالموجرا (شجرة من شرق الهند ذات بذور زيتية تنتج زيت التشالموجرا المستخدم لعلاج الجذام)",
 "taraktogenos kurzii": "تشالموجرا (شجرة من شرق الهند ذات بذور زيتية تنتج زيت التشالموجرا المستخدم لعلاج الجذام)",
 "tarantella": "تارانتيلا (رقصة إيطالية دوارة حيوية لشخصين) / تارنتيلا (موسيقى مؤلفة في زمن ستة أثمان لرقص التارنتيلا)",
 "tarantelle": "تارانتيلا (رقصة إيطالية دوارة حيوية لشخصين)",
 "tarantism": "تارانتيسم, هوس الرقص (اضطراب عصبي يتميز بدافع لا يمكن السيطرة عليه للرقص؛ يُعزى شعبياً إلى لدغة العنكبوت الذئبي أو الرتيلاء في جنوب أوروبا)",
 "taranto": "تارانتو",
 "tarantula": "رُتَيْل",
 "tarawih": "تَرَاويِح, صَلَاة التَّرَاوِيح",
 "taraxacum kok-saghyz": "هندباء روسية (هندباء معمرة موطنها كازاخستان تزرع لجذورها اللحمية التي تحتوي على نسبة عالية من المطاط)",
 "taraxacum officinale": "هندباء شائعة (نبات أوراسي متوطن على نطاق واسع كعشبة ضارة في أمريكا الشمالية؛ يستخدم كخضروات للسلطة ولصنع النبيذ)",
 "taraxacum ruderalia": "هندباء شائعة (نبات أوراسي متوطن على نطاق واسع كعشبة ضارة في أمريكا الشمالية؛ يستخدم كخضروات للسلطة ولصنع النبيذ)",
 "tarboosh": "طربوش (قبعة لباد (حمراء عادة) للرجل؛ على شكل مخروط مسطح القمة مع شرابة تتدلى من التاج)",
 "tarchanoff phenomenon": "استجابة الجلد الجلفانية (تغير في الخصائص الكهربائية للجلد استجابة للتوتر أو القلق)",
 "tardigrade": "بطيء الخطو, دب الماء (مفصلي من شعبة بطيئات الخطو)",
 "tardily": "بشكل متأخر, متأخراً (في وقت لاحق عن المعتاد أو المتوقع) / ببطء, على مهل (بدون سرعة)\nمثال: وصل القطار متأخراً",
 "tardiness": "تأخر, تباطؤ (صفة أو عادة عدم الالتزام بالوقت الصحيح أو المعتاد أو المتوقع)",
 "tardive": "مُتَأَخِّرُ الظُّهُور (يحدث متأخّراً (خاصة بالنسبة لأعراض مرض))",
 "tardive dyskinesia": "خلل الحركة المتأخر (دوران لا إرادي لللسان وارتعاش في الوجه أو الجذع أو الأطراف؛ يحدث غالباً في مرضى باركنسون الذين يعالجون بالفينوثيازين)",
 "tardy": "مُتَأَخِّر, مُتَلَكِّئ (بعد الوقت المتوقّع أو المعتاد؛ مُؤَجَّل)",
 "tare": "وَزْن فَارِغ",
 "taret organ": "عضو مستهدف ((في الغدد الصماء) العضو الأكثر تأثراً بهرمون معين)",
 "target": "دَرِيئَة, نِيشَان / هَدَف, مَرْمًى (جاء إلى الهَدَف؛ ارتفع عن الأرض) / يَسْتَهْدِفُ\nمثال: لقد أخطأ الهدف.",
 "target acquisition system": "نظام الاستحواذ على الهدف (نظام على متن السفينة للكشف عن الهدف وتحديده وموقعه بتفاصيل كافية للسماح بفعالية استخدام السلاح)",
 "target area": "منطقة الهدف (موقع الهدف المراد إصابته)",
 "target cell": "خلية هدفية (خلية دم حمراء غير طبيعية تظهر كحلقة داكنة تحيط بمركز داكن؛ مرتبطة بفقر الدم) / خلية مستهدفة (أي خلية لديها مستقبل محدد لمستضد أو جسم مضاد أو هرمون أو دواء، أو تكون محور اتصال لفيروس أو خلية بلعمية أو ليف عصبي وما إلى ذلك)",
 "target company": "شركة مستهدفة (شركة تم اختيارها كهدف جذاب للاستحواذ من قبل مستحوذ محتمل)",
 "target language": "اللغة المترجم إليها, اللغة الهدف (اللغة التي يتم ترجمة نص مكتوب بلغة أخرى إليها) / لغة الكائن, لغة الهدف (لغة حاسوبية يتم ترجمة شيء مكتوب بلغة حاسوبية أخرى إليها)",
 "target organ": "عضو مستهدف ((في الأشعة) العضو المراد أن يتلقى الجرعة العلاجية لمادة مشعة)",
 "target practice": "تدريب الرماية (التدريب على إطلاق النار على أهداف)",
 "target program": "برنامج الهدف (برنامج تم تجميعه أو تجميعه بالكامل وجاهز للتحميل في الحاسوب)",
 "target range": "ميدان رماية (ميدان للتدرب على إصابة الأهداف)",
 "target-hunting": "مُوَجَّه نَحْوَ الهَدَف (يَتَوَجَّه تِلْقائِيًّا نَحْوَ الهَدَف)",
 "tarheel": "شمال كاروليني (مواطن أو مقيم في كارولينا الشمالية)",
 "taricha granulosa": "سمندل خشن الجلد (سمندل من الساحل الرطب من ألاسكا إلى جنوب كاليفورنيا)",
 "taricha torosa": "سمندل كاليفورنيا (سمندل يشبه السمندل خشن الجلد في الخصائص والموطن)",
 "tariff": "تَعَارِيف, تَعْرِفَة / تَعَارِيف",
 "tariq": "سورة الطارق",
 "tarkhan": "طرخان",
 "tarmac": "طريق معبد بالقار, مكادام (سطح مرصوف يحتوي على طبقات مضغوطة من الصخور المكسرة متماسكة مع القطران) / تارماك, مكدام بالقطران (مادة رصف من القطران والحجر المكسر؛ تخلط في مصنع وتشكل أثناء الرصف)",
 "tarmacadam": "طريق معبد بالقار, مكادام (سطح مرصوف يحتوي على طبقات مضغوطة من الصخور المكسرة متماسكة مع القطران) / تارماك, مكدام بالقطران (مادة رصف من القطران والحجر المكسر؛ تخلط في مصنع وتشكل أثناء الرصف)",
 "tarn": "بحيرة جبلية (مسطح مائي واسع كالبحر المغلق فيه ماء حلو أو شبه حلو صالح للشرب)\nمثال: سبحنا في البحيرة.",
