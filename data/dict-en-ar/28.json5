 "terminable": "قَابِل لِلْإِنْهَاء, مَحْدُود المُدَّة (يمكن إنهاؤه بعد مدّة محدّدة)",
 "terminable interest": "مصلحة قابلة للإنهاء (مصلحة في ممتلكات تنتهي في ظل ظروف محددة)",
 "terminal": "فِي مَرْحَلَة مُتَأَخِّرَة, نِهَائِيّ (يُسَبِّب أَوْ يَنْتَهِي بِالمَوْت أَوْ يَقْتَرِب مِنْه) / أَخِير, خِتَامِيّ (يَقَعُ فِي نِهَايَةِ شَيْءٍ أَوْ يُشَكِّلُ خَاتِمَتَهُ) / طرفي, نهائي (كائن أو واقع في النهاية أو الطرف) / دوري, فصلي (متعلق بـ أو يحدث في فصل دراسي أو فترة زمنية محددة)\nمثال: العمود الطرفي",
 "terminal emulation": "محاكاة الطرفية ((علم الحاسوب) جعل جهاز الكمبيوتر يتصرف تمامًا مثل المحطة الطرفية)",
 "terminal figure": "تمثال حدودي ((في العمارة) تمثال أو تمثال نصفي بشري أو حيوان منحوت من أعلى عمود مربع؛ استخدم أصلاً كعلامة حدودية في روما القديمة)",
 "terminal leave": "إجازة نهائية (الإجازة الأخيرة قبل التسريح من الخدمة العسكرية)",
 "terminal point": "حد أقصى, نقطة النهاية (آخر أو أقصى نقطة حدية)",
 "terminal velocity": "سُرْعَة قُصْوَى, سُرْعَة نِهَائِيَّة (السرعة القصوى الثابتة التي يصل إليها جسم يسقط عبر الغلاف الجوي تحت تأثير الجاذبية)",
 "terminality": "إفضاء للموت, مرحلة الاحتضار (صفة أو حالة كون الشيء قاتلاً أو مؤدياً للموت)\nمثال: قد لا يتم احترام التوجيه دائماً بسبب عدم قدرة الطب على تحديد ما إذا كانت حالة المريض مفضية للموت",
 "terminally": "في المرحلة النهائية, نهائياً (في النهاية (يستخدم طبياً للحالات الميؤوس منها))\nمثال: مريض في مرحلة الاحتضار",
 "terminated": "مُنْتَهٍ, مُنْقَضٍ ((عن عقد أو فترة ولاية مثلاً) وصل إلى نهايته) / تَامّ, مُنْتَهٍ (بَلَغَ خِتَامَهُ أَوْ وَصَلَ إِلَى نِهَايَتِهِ)",
 "termination": "إنهاء, خاتمة (فعل إنهاء شيء ما) / خاتمة, نهاية (نهاية الكلمة (لاحقة أو نهاية تصريفية أو مورفيم نهائي)) / عاقبة, نتيجة (شيء ينتج عن أمر ما) / محطة أخيرة, نقطة نهاية (مكان ينتهي فيه شيء أو يكتمل)\nمثال: إنهاء الاتفاقية",
 "terminative": "إِنْهَائِيّ, خَتْمِيّ (يُؤْذِنُ بِالِانْتِهَاءِ أَوْ يَصِلُ إِلَى نِهَايَتِهِ)",
 "terminator": "مُبِيد (مَادَّةٌ كيميائيَّة سَامَّةٌ تُستخدم لإِبَادَةِ الْحَشَرَاتِ والجراثيم)\nمثال: اشترى ياني مبيد النمل.",
 "terminography": "صِنَاعَة مُصْطَلَح (إيجاد الشيء وخَلْقُه؛ (استخدام حديث) قطاع اقتصادي)\nمثال: هذا البلد مدعوم بالصناعة.",
 "terminological": "اصطلاحي, مصطلحي (من أو بخصوص المصطلحات)\nمثال: خلافات اصطلاحية",
 "terminology": "عِلْمُ المُصْطَلَحِ (أَدْرَكَ حقيقة الشيء) / مُصْطَلَح (اسم مفعول من الفعل \"اصْطَلَحَ\"؛ كل كلمة لها دلالة معينة، متفق عليها بين العلماء في علم ما)\nمثال: أدرس علم النفس.",
 "terminus": "محطة, محطة طرفية (محطة تقوم فيها مركبات النقل بتحميل أو تفريغ الركاب أو البضائع) / محطة نهائية (أي من نهايتي طريق السكك الحديدية أو الحافلات) / تمثال حدودي ((في العمارة) تمثال أو تمثال نصفي بشري أو حيوان منحوت من أعلى عمود مربع؛ استخدم أصلاً كعلامة حدودية في روما القديمة) / غاية نهائية, وجهة (الهدف النهائي الذي يتم عمل شيء من أجله)",
 "terminus a quo": "نقطة البداية (أقرب نقطة حدية)",
 "terminus ad quem": "حد أقصى, نقطة النهاية (آخر أو أقصى نقطة حدية)",
 "termite": "أَرَضَة",
 "terms": "ثمن, سعر (مبلغ المال اللازم لشراء شيء ما) / علاقة, وضع (الوضع فيما يتعلق بالعلاقات بين الناس أو الجماعات)\nمثال: سعر البنزين",
 "tern": "خَرْشَنَة",
 "ternary": "ثُلَاثِيّ (ذو ثلاث وحدات أو مكوّنات أو عناصر) / ثَلَاثَة, ثُلَاثِيّ (العدد الأصلي الذي هو مجموع واحد وواحد وواحد)",
 "ternate": "ثُلَاثِيّ الوُرَيْقَات ((عن شكل الورقة) يتألَّف من ثلاث وريقات أو أقسام)",
 "ternion": "ثَلَاثَة, ثُلَاثِيّ (العدد الأصلي الذي هو مجموع واحد وواحد وواحد)",
 "terpene": "تربين (هيدروكربون غير مشبع يتم الحصول عليه من النباتات)",
 "terpinene": "تيربينين (أي من مجموعة الهيدروكربونات المتصاوغة المصنفة كتربينات)\nمثال: ألفا تيربينين هو مثال على التيربينين",
 "terpsichore": "تِيرْبْسِيكُورِي",
 "terpsichorean": "رقصي (من أو متعلق بالرقص) / راقص, راقص محترف (مؤدٍ يرقص بشكل احترافي)\nمثال: أنشطتها الرقصية",
 "terra alba": "طين صيني, كاولين (طين ناعم عادة ما يكون أبيض ناتج عن تجوية المعادن الألومينية (مثل الفلسبار)؛ يستخدم في السيراميك وكمادة ماصة وكمادة مالئة (على سبيل المثال، في الورق)) / طين الغليون (طين أبيض ناعم يستخدم في صنع غليون التبغ والفخار وفي تبييض الجلود) / جبس مسحوق, طين أبيض (جبس مسحوق ناعم يُستخدم خاصة كصبغة)",
 "terra cotta": "تيراكوتا, فخار نضيج (خزف بني محمر صلب غير مصقول) / أحمر فخاري, تراكوتا (لون برتقالي بني يشبه التراكوتا (الفخار))\nمثال: صُنع الطوب من مواد معاد تدويرها، ودهنه بلون التيراكوتا يثير أجواء قرية قديمة",
 "terra firma": "أرض, بر (الجزء الصلب من سطح الأرض)\nمثال: انحرفت الطائرة بعيداً عن البحر وعادت فوق اليابسة",
 "terra incognita": "المجهول, منطقة مجهولة (منطقة مجهولة وغير مستكشفة)\nمثال: جاؤوا مثل الملائكة من المجهول",
 "terra sigillata": "تيرا سيجيلاتا, خزف سامي (خزف مصنوع من الطين البني المحمر الموجود في جزيرة ليمنوس في بحر إيجة)",
 "terrace": "شرفة أرضية, فناء (منطقة خارجية مبلطة عادة مجاورة للمسكن) / شرفة, صف منازل (صف من المنازل مبني بنمط مماثل وله جدران فاصلة مشتركة (أو الشارع الذي تطل عليه)) / شرفة, مصطبة (رف مستوٍ من الأرض يقطع انحداراً (مع منحدرات حادة فوقه وتحته))",
 "terraced house": "منزل متصل, منزل مدرج (منزل يشكل جزءاً من صف منازل متصلة)",
 "terracotta": "تيراكوتا, فخار نضيج (خزف بني محمر صلب غير مصقول)",
 "terraforming": "إِعَادَة تَأْهِيل, تِيرَافُورْمِينْغ",
 "terrain": "مِنْطَقَة, أَرْض (المِنْطَقةُ: المَنْطِقَةُ؛ مِنْطَقَةُ: مُقَاطَعَةٌ)\nمثال: غزة منطقة مكشوفة.",
 "terrain flight": "طيران منخفض (الطيران على ارتفاعات منخفضة جداً)",
 "terrain intelligence": "استخبارات التضاريس (استخبارات تكتيكية حول الخصائص الطبيعية والتي من صنع الإنسان لمنطقة ما)",
 "terramare": "تِيرَّامَارَت",
 "terramycin": "أوكسي تتراسيكلين, تيراميسين (مضاد حيوي بلوري أصفر (العلامة التجارية تيراميسين) يتم الحصول عليه من شعيات التربة؛ يستخدم لعلاج الالتهابات البكتيرية والريكتسية المختلفة)",
 "terrapene ornata": "سلحفاة صندوقية غربية (سلحفاة براري بشكل أساسي من غرب الولايات المتحدة وشمال المكسيك)",
 "terrapin": "حَمَسَة, رَقّ",
 "terrarium": "تراريوم, حوض نباتات زجاجي (حوض تربية تُحفظ فيه نباتات حية مختارة وتُراقب)",
 "terrene": "أَرْضِيّ, دُنْيَوِيّ (يَنْتَمي إلى هذا العالَم الأرْضِيّ؛ لَيْس مِثالِيًّا أو سَماوِيًّا) / أرضي, بري (مكون من أو متعلق بـ أو يسكن اليابسة بدلاً من البحر أو الجو)",
 "terreplein": "سطح المتراس (مساحة مستوية يمكن نصب المدافع الثقيلة عليها خلف الجدار المتراس في أعلى الحصن)",
 "terrestrial": "أَرْضِيّ",
 "terrestrial dynamical time": "التوقيت الأرضي, توقيت التقويم الفلكي ((علم الفلك) مقياس للوقت محدد بحركة الأرض المدارية؛ التوقيت الأرضي هو التوقيت الشمسي المتوسط مصححاً لعدم انتظام حركات الأرض)",
 "terrestrial guidance": "توجيه أرضي (طريقة للتحكم في طيران الصاروخ بواسطة أجهزة تستجيب لقوة واتجاه مجال الجاذبية الأرضية)",
 "terrestrial planet": "كَوْكَب أَرْضِيّ, كَوْكَب صَخْرِيّ (كوكب له سطح صخري صلب مثل سطح الأرض؛ الكواكب الأربعة الداخلية في النظام الشمسي)",
 "terrestrial time": "التوقيت الأرضي, توقيت التقويم الفلكي ((علم الفلك) مقياس للوقت محدد بحركة الأرض المدارية؛ التوقيت الأرضي هو التوقيت الشمسي المتوسط مصححاً لعدم انتظام حركات الأرض)",
 "terrestrially": "أرضياً, برياً (بما يتعلق بالبيئة الأرضية (اليابسة)) / أرضياً, دنيوياً (بطريقة دنيوية)\nمثال: متكيف برياً",
 "terrible": "فَظِيع / مُرْعِب / فَظِيع, أَرْبَد",
 "terribleness": "رُعْب, فَظَاعَة (صفة لعدم الارتياح الشديد أو السوء البالغ)",
 "terribly": "بشكل رهيب, جداً (تستخدم للتوكيد) / بشكل سيء للغاية, بشكل فظيع (بطريقة فظيعة)\nمثال: مثير للاهتمام جداً",
 "terrier": "تيرير (أي من عدة سلالات عادة ما تكون صغيرة وقصيرة الجسم تم تدريبها في الأصل لصيد الحيوانات التي تعيش تحت الأرض)",
 "terrietia trifoliolata": "زان أحمر, هريتييرا ثلاثية الأوراق (شجرة كبيرة من أسترالاسيا)",
 "terrific": "مُرْعِب, مُفْزِع (يسبب رعباً شديداً بالغاً) / رَهِيب, هَائِل (عَظِيمٌ جِدًّا أَوْ بَالِغُ الشِّدَّة) / رَائِع, عَظِيم (جيد أو عظيم بشكل استثنائي؛ يُستخدم خاصة كمكثف)",
 "terrifically": "بشكل رائع, بشكل مذهل ((يستخدم للمبالغة) بشكل ممتاز)\nمثال: صوتها منضبط بشكل رائع",
 "terrified": "مَذْعُور, مُرْتَعِب (أصابه ذعر شديد أو يأس غامر)",
 "terrifying": "مُرْعِب, مُفْزِع (يسبب رعباً شديداً بالغاً)",
 "terrine": "ترين, فخارة لحم (باتيه أو رغيف لحم فاخر مخبوز في وعاء فخاري)",
 "territorial": "إِقْلِيمِيّ",
 "territorial army": "الجيش الإقليمي (وحدة بريطانية من الجنود غير المحترفين منظمة للدفاع عن بريطانيا العظمى)",
 "territorial division": "تقسيم إداري, قطاع إداري (منطقة محددة لأغراض إدارية)",
 "territorial dominion": "إِقْلِيم إِدَارِيّ, مُقَاطَعَة (منطقة محدّدة لأغراض إداريّة أو غيرها)",
 "territorial reserve": "قوات إقليمية (وحدة عسكرية إقليمية)",
 "territorial waters": "مياه إقليمية (المياه المحيطة بدولة ما وأقاليمها والتي تمارس تلك الدولة سيادة قضائية عليها)",
 "territorialisation": "تأسيس إقليم (فعل التنظيم كإقليم)",
 "territoriality": "دفاع عن الإقليم, سلوك إقليمي (سلوك الحيوان الذكر الذي يحدد ويدافع عن منطقته)",
 "territorialization": "تأسيس إقليم (فعل التنظيم كإقليم)",
 "territorially": "إقليمياً (فيما يتعلق بالأراضي)\nمثال: مهم إقليمياً",
 "territory": "إِقْلِيم (مساحة مكانية معينة ومحددة تمثل الخطوط الحدودية لمنطقة جغرافية أو مناخية، أو كيان سياسي ما)",
 "terror": "ترويع / إِرْهَاب (ال الإِزعاجُ والإِخَافَةُ، تقولُ: ويَقْشَعِرُّ الإِهَابُ إِذَا وَقَعَ مِنْهُ الإِرْهَابُ؛ الإِرْهَابُ قَدْعُ الإِبِلِ عن الحَوْضِ وذِيَادُهَا)\nمثال: الإنفصاليون مثل الإرهاب.",
 "terror-stricken": "مُصَاب بِالرُّعْب (أصابه الرعب أو امتلأ به)",
 "terror-struck": "مُصَاب بِالرُّعْب (أصابه الرعب أو امتلأ به)",
 "terrorisation": "إرهاب, ترويع (عمل إرهابي) / إرهاب, ترويع (فعل بث الخوف)",
 "terrorism": "إِرْهَاب (ال الإِزعاجُ والإِخَافَةُ، تقولُ: ويَقْشَعِرُّ الإِهَابُ إِذَا وَقَعَ مِنْهُ الإِرْهَابُ؛ الإِرْهَابُ قَدْعُ الإِبِلِ عن الحَوْضِ وذِيَادُهَا)\nمثال: الإنفصاليون مثل الإرهاب.",
 "terrorist": "إِرْهَابِيّ, إِرْهَابِيَّة",
 "terrorist act": "إرهاب, عمل إرهابي (الاستخدام المحسوب للعنف (أو التهديد بالعنف) ضد المدنيين من أجل تحقيق أهداف سياسية أو دينية أو أيديولوجية؛ يتم ذلك من خلال الترهيب أو الإكراه أو بث…)",
 "terrorist attack": "هجوم إرهابي (هجوم مفاجئ ينطوي على الاستخدام المتعمد للعنف ضد المدنيين على أمل تحقيق أهداف سياسية أو دينية)",
 "terrorist cell": "خلية إرهابية (خلية من الإرهابيين (عادة من 3 إلى 5 أعضاء))\nمثال: لضمان الأمن التشغيلي، لا يعرف أعضاء الخلايا الإرهابية المتجاورة بعضهم البعض عادة أو هوية قيادتهم",
 "terrorist group": "جماعة إرهابية, منظمة إرهابية (حركة سياسية تستخدم الإرهاب كسلاح لتحقيق أهدافها)",
 "terrorist organization": "جماعة إرهابية, منظمة إرهابية (حركة سياسية تستخدم الإرهاب كسلاح لتحقيق أهدافها)",
 "terrorization": "إرهاب, ترويع (عمل إرهابي) / إرهاب, ترويع (فعل بث الخوف)",
 "terry": "تيري, قماش بشكير (قماش وبري (عادة قطني) بحلقات غير مقصوصة على الجانبين؛ يستخدم لصنع مناشف الحمام وأرواب الحمام)",
 "terry cloth": "تيري, قماش بشكير (قماش وبري (عادة قطني) بحلقات غير مقصوصة على الجانبين؛ يستخدم لصنع مناشف الحمام وأرواب الحمام)",
 "terry towel": "بشكير, منشفة وبرية (منشفة حمام ذات وبر خشن وفضفاض)",
 "terrycloth": "تيري, قماش بشكير (قماش وبري (عادة قطني) بحلقات غير مقصوصة على الجانبين؛ يستخدم لصنع مناشف الحمام وأرواب الحمام)",
 "terse": "حَادّ, مُقْتَضَب (قَصِيرٌ وَمُبَاشِرٌ؛ مُخْتَصَرٌ بِفَاعِلِيَّةٍ)",
 "tersely": "بإيجاز, باقتضاب (بطريقة قصيرة وموجزة)\nمثال: طائر معين، موصوف بدقة وبإيجاز في كتاب الطيور",
 "terseness": "إيجاز, اختصار (أسلوب تعبيري قصير وموجز بدقة)",
 "tertian": "ثالثي (من أو متعلق بنظام نغمي قائم على الثالثات الكبيرة (في الموسيقى)) / ثلثي, غبّ (متعلق بالأعراض (خاصة حمى الملاريا) التي تظهر كل يومين (حمى الغب))\nمثال: نظام نغمي ثالثي",
 "tertiary": "ثَالِث (العَدَد التَّرْتِيبِيّ 3)",
 "tertiary syphilis": "زهري ثالثي (المرحلة الثالثة؛ تتميز بإصابة الأعضاء الداخلية وخاصة الدماغ والحبل الشوكي وكذلك القلب والكبد)",
 "tertigravida": "حامل للمرة الثالثة (امرأة حامل للمرة الثالثة)",
 "tertium quid": "حَلّ وَسَط, طَرَف ثَالِث (شيء ثالث يشبه نقيضين ولكنه متميز عن كليهما)",
