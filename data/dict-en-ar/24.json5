 "rock bottom": "الحضيض, القاع الصخري (القاع المطلق أو أدنى مستوى)",
 "rock brake": "بوليبودي الصخر, سرخس الجدار الأمريكي (سرخس صخري أو هوائي بشكل رئيسي في أمريكا الشمالية وشرق آسيا) / سرخس الصخر (سراخس قزمة نفضية تعيش على الصخور) / سرخس الجرف, سرخس الصخر (أي من عدة سراخس صغيرة تعيش على الصخور في المناطق الاستوائية والمعتدلة الدافئة)",
 "rock cake": "كعكة الصخر (كعكة صغيرة ذات سطح صلب يقال إنها تشبه الصخرة)",
 "rock candy": "حلوى صخرية, سكر نبات (سكر على شكل بلورات صلبة كبيرة وشفافة على خيط) / حلوى الروك (عصا حلوى صلبة زاهية الألوان (عادة بنكهة النعناع))",
 "rock climber": "متسلق الصخور (متسلق للواجهات الصخرية العمودية)",
 "rock climbing": "تسلق الصخور (رياضة أو هواية تسلق الكتل الصخرية على سفوح الجبال (خاصة بمساعدة الحبال والمعدات الخاصة))",
 "rock concert": "حفلة روك (أداء لموسيقى الروك)",
 "rock cornish": "دجاج روك كورنيش (هجين صغير ممتلئ تم تطويره عن طريق تهجين دجاج بليموث روك ودجاج كورنيش)",
 "rock cornish hen": "دجاج كورنيش الصخري (لحم طائر صغير مهجن للتحمير)",
 "rock crab": "سرطان الصخور (سرطان من الساحل الشرقي لأمريكا الشمالية)",
 "rock cress": "أرابيس, رشاد الصخر (أي من عدة نباتات رشاد محبة للصخور من جنس أرابيس)",
 "rock crystal": "بلور صخري, كوارتز شفاف (كوارتز شفاف يستخدم في صنع المعدات الإلكترونية والبصرية)",
 "rock dove": "حَمَام طُورَانِيّ, حَمَام أَزْرَق (قضاء الموت وقدره؛ جمع حُمَّة وهو قدر الفراق)\nمثال: هل الحمام جاهز؟",
 "rock drill": "ريشة حفر الصخر, مثقاب الصخور (مثقاب لاختراق الصخور)",
 "rock elm": "دردار أمريكي (شجرة زينة كبيرة بفروع رشيقة تنتشر تدريجياً شائعة في شرق أمريكا الشمالية) / دردار صخري (دردار طويل واسع التوزيع في شرق أمريكا الشمالية)",
 "rock fever": "حمى مالطية, حمى متموجة (مرض بكتيري معد يصيب البشر ينتقل عن طريق الاتصال بالحيوانات المصابة أو اللحوم أو منتجات الألبان المصابة؛ يتميز بالحمى والصداع)",
 "rock garden": "حديقة صخرية (حديقة تتميز بالصخور؛ وعادة النباتات الألبية)",
 "rock geranium": "غرنوقي صخري, هيوشيرا أمريكية (نبات بأوراق قاعدية مرقشة بالأبيض وزهور في عناقيد رخوة على سيقان منتصبة)",
 "rock group": "مَجْمُوعَة رُوك (مؤنث مَجْمُوع وهو اسم مفعول من جَمَعَ؛ الطَائِفَة أو الجَمَاعَة من الناس)\nمثال: شكرا لإضافتي للمجموعة.",
 "rock gunnel": "جوني الصخر (سمكة طعام زلقة بلا حراشف في المياه الساحلية لشمال المحيط الأطلسي)",
 "rock hind": "هند الصخور (توجد حول السواحل الصخرية أو على الشعاب المرجانية)",
 "rock hopper": "بطريق متوج, بطريق نطاط الصخور (بطريق صغير من جزر فوكلاند ونيوزيلندا)",
 "rock hyrax": "وبر صخري (وبر يعيش في المناطق الصخرية)",
 "rock kangaroo": "ولب الصخور (ولب أسترالي نحيل طويل الساقين يعيش في الكهوف والمناطق الصخرية)",
 "rock lobster": "جراد البحر الشائك (قشري بحري كبير صالح للأكل له درقة شوكية ولكنه يفتقر إلى المخالب الكبيرة للكركند الحقيقي) / إستاكوزا شائكة, كركند شائك (كركند المياه الدافئة بدون مخالب؛ تلك القادمة من أستراليا وجنوب أفريقيا تسوق عادة كذيول مجمدة؛ تصاد أيضاً في فلوريدا وكاليفورنيا)",
 "rock maple": "قيقب سكري, قيقب صخري (قيقب من شرق ووسط أمريكا الشمالية له أوراق ثلاثية إلى خماسية الفصوص وخشب صلب متقارب الحبيبات يستخدم كثيراً في أعمال الخزائن خاصة الشكل المجعد…)",
 "rock music": "مُوسِيقَى الرُّوك, رُوك (مُوسِيقى، فنُّ تأليف الألحان وتوزيعها وإيقاعها والغناء والتطريب بضروب المعازف؛ علم الموسيقى : علمٌ يُبحَثُ فيه عن أُصَول النغم من حيث تأَتلف أَو تتنافر، وأَحوال الأَزمنة المتخللة بينها، ليُعلَمَ كيف يؤلَّف اللَّحْن)\nمثال: أتعلم الموسيقى.",
 "rock oil": "بترول, نفط خام (زيت داكن يتكون أساساً من الهيدروكربونات)",
 "rock opera": "أوبرا الروك (أوبرا بموسيقى الروك)",
 "rock outcrop": "مُنْكَشَف صَخْرِيّ (جزء من التكوين الصخري يظهر فوق سطح الأرض المحيطة)",
 "rock paper scissors": "حَجَر وَرَقَة مِقَصّ, حَجَر وَرَق مِقَصّ (حَجَرَ عليه الأمرَ:مَنَعَه منه ، حجر الشّيء على نفسه:خَصَّها به وقصره عليها؛ الحجْرُ: المَنْعُ مِن التَّصَرُّفِ ، وحَجَرَ عَلَيْهِ القاضِي يَحْجُرُ حَجْراً، إِذا مَنَعَه مِن التَّصَرُّفِ فِي مالِه)\nمثال: عوقب زيري بالحجر.",
 "rock partridge": "حجل الصخر (من المناطق الجبلية في جنوب أوروبا)",
 "rock penstemon": "بنستيمون صخري (واحدة من أجمل الأزهار البرية في الغرب؛ أزهار كبيرة زاهية وردية أو زهرية في العديد من العثاكيل فوق حصائر سميكة من السيقان والأوراق؛ الحواف والمنحدرات…)",
 "rock pigeon": "حمامة الصخور (حمامة أوراسية رمادية شاحبة ذات أجنحة مخططة بالأسود تنحدر منها معظم الأنواع المستأنسة)",
 "rock pink": "قرنفل الصخر (نبات معمر ذو أزهار وردية من المناطق الصخرية بغرب الولايات المتحدة)",
 "rock plant": "نبات صخري (نبات ينمو على الصخور أو بينها أو مناسب للحدائق الصخرية)",
 "rock polypody": "بوليبودي الصخر, سرخس الجدار الأمريكي (سرخس صخري أو هوائي بشكل رئيسي في أمريكا الشمالية وشرق آسيا)",
 "rock purslane": "رجلة الصخور, كالاندرينا (نبات من جنس كالاندرينا)",
 "rock python": "بايثون الصخور (بايثون كبير جداً يعيش في أفريقيا الاستوائية والجنوبية)",
 "rock rabbit": "بيكا (ثديي حفار صغير قصير الأذن من المرتفعات الصخرية في آسيا وغرب أمريكا الشمالية) / وبر صخري (وبر يعيش في المناطق الصخرية)",
 "rock rattlesnake": "أفعى جرسية صخرية (تعيش في صخور الجبال في المكسيك ومعظم الأجزاء الجنوبية من جنوب غرب الولايات المتحدة)",
 "rock rose": "اللاذن, زهرة الصخر (شجيرات صغيرة من مناطق الأحراش والغابات الجافة في جنوب أوروبا وشمال أفريقيا؛ تزرع لأزهارها المبهرجة وأوراقها دائمة الخضرة الناعمة غالباً ما تكون زغبية…) / هليانثيموم, وردة الصخر (أي من أصناف عديدة من الهليانثيموم لها زهور صغيرة تشبه الورد صفراء أو بيضاء أو حمراء)",
 "rock salmon": "سلمون الصخر (أي من عدة أسماك خشنة (مثل كلب البحر أو سمك الذئب) عند استخدامها كطعام)",
 "rock salt": "ملح صخري, هاليت (كلوريد الصوديوم البلوري الموجود طبيعياً)",
 "rock sandwort": "رملية صخرية (نبات معمر منخفض معنقد في جنوب شرق أمريكا الشمالية)",
 "rock sea bass": "قاروص الصخور (نوع من قاروص البحر)",
 "rock snake": "بايثون الصخور (بايثون كبير جداً يعيش في أفريقيا الاستوائية والجنوبية)",
 "rock spikemoss": "طحلب السنبلة الصخري (طحلب سنبلة ذو خصلات يشكل حصائر منتشرة فضفاضة؛ شرق أمريكا الشمالية)",
 "rock squirrel": "سنجاب الصخور (سنجاب أرضي رمادي كبير من المناطق الصخرية في جنوب غرب الولايات المتحدة)",
 "rock star": "نجم روك (مغنٍ مشهور لموسيقى الروك)",
 "rock sugar": "سكر نبات (سكر على شكل بلورات كبيرة، يستخدم غالباً للزينة)\nمثال: قد يبدو سكر النبات فاخراً، لكنه يستغرق وقتاً أطول بكثير ليذوب",
 "rock sunfish": "باس الصخور (سمكة غذائية ورياضية في أعالي المسيسيبي والبحيرات العظمى)",
 "rock wallaby": "ولب الصخور (ولب أسترالي نحيل طويل الساقين يعيش في الكهوف والمناطق الصخرية)",
 "rock wool": "صوف صخري, صوف معدني (مادة ليفية خفيفة تستخدم كعازل)",
 "rock wren": "نمنمة الصخور (نمنمة تسكن الأراضي الوعرة ومنطقة الميسا في غرب الولايات المتحدة والمكسيك) / نمنمة الصخور (طائر قصير الذيل يشبه النمنمة)",
 "rock'n'roll": "روك, روك أند رول (نوع من الموسيقى الشعبية نشأ في الخمسينيات؛ مزيج من الريذم أند بلوز الأسود مع الكانتري أند ويسترن الأبيض)\nمثال: الروك هو مصطلح عام لمجموعة الأساليب التي تطورت من الروك أند رول",
 "rock-and-roll": "روك, روك أند رول (نوع من الموسيقى الشعبية نشأ في الخمسينيات؛ مزيج من الريذم أند بلوز الأسود مع الكانتري أند ويسترن الأبيض)\nمثال: الروك هو مصطلح عام لمجموعة الأساليب التي تطورت من الروك أند رول",
 "rock-bottom": "بَخْس, مُخَفَّض (أقلّ بكثير من المعتاد خاصَّة في السعر)",
 "rock-climbing equipment": "معدات التسلق, معدات تسلق الصخور (معدات رياضية تستخدم أثناء تسلق الصخور أو أي نوع آخر من التسلق)\nمثال: كيس السحب يشير إلى حقيبة كبيرة وقوية وغالباً ما تكون غير عملية يلقى فيها الإمدادات ومعدات التسلق",
 "rock-inhabiting": "صَخْرِيُّ الْمَوْطِن (يعيش على الصخور (يُقال عن السراخس والأشنات))",
 "rock-loving": "مُحِبّ لِلصُّخور ((في النَّبات) يَنْمو بِشَكْل طَبيعِيّ فَوْق الصُّخور أو بَيْنَها)",
 "rock-ribbed": "مُتَشَبِّثٌ بِالتَّقَالِيد, مُحَافِظٌ عَتِيق (مُتَمَسِّكٌ بِالتَّقَالِيدِ وَعَنِيدٌ فِي آرَائِهِ) / صَخْرِيُّ الْأَطْرَافِ (محاط بالصخور أو ذو حواف صخرية)",
 "rock-steady": "مَوْثُوق, يُعْتَمَد عَلَيْه (ثابت ومتسق في الأداء أو السلوك)",
 "rockabilly": "روكابيلي (دمج بين الموسيقى السوداء وموسيقى الكانتري كان شائعاً في الخمسينيات؛ يوصف أحياناً بأنه بلوز بإيقاع كانتري)",
 "rockbound": "صَخْرِيُّ الْأَطْرَافِ (محاط بالصخور أو ذو حواف صخرية)",
 "rockchuck": "مرموط أصفر البطن (مرموط ثقيل الجسم بني مصفر من المناطق الصخرية في غرب أمريكا الشمالية)",
 "rockcress": "أرابيس, رشاد الصخر (أي من عدة نباتات رشاد محبة للصخور من جنس أرابيس) / بربارة شائعة, جرجير الشتاء (رشاد ضار ذو أزهار صفراء؛ يوضع أحياناً في جنس سيسيمبريم)",
 "rocker": "دعامة مقوسة (دعامة منحنية تسمح للجسم المدعوم بالتأرجح ذهاباً وإياباً) / زلاجة مقوسة (زلاجة جليد ذات نصل منحني) / مهد غسل الذهب (حوض يمكن هزه ذهاباً وإياباً؛ يستخدمه منقبو الذهب لفصل الذهب عن التراب في الماء) / كرسي هزاز (كرسي مثبت على زلاجات مقوسة تسمح له بالتأرجح)",
 "rocker arm": "تابع الكامة, ذراع متأرجح (رافعة تدور حول المركز؛ تستخدم خاصة لدفع الصمام لأسفل في محرك الاحتراق الداخلي)",
 "rockers": "راكبو الدراجات النارية, روكرز (في الأصل ثقافة فرعية شبابية بريطانية تطورت من التيدي بويز في الستينيات؛ ارتدوا سترات جلدية سوداء وجينز وأحذية؛ كان لديهم شعر مدهون وركبوا الدراجات…)",
 "rockery": "حديقة صخرية (حديقة تتميز بالصخور؛ وعادة النباتات الألبية)",
 "rocket": "صَارُوخ, قَذِيفَة (سهم له ساق من قصب و في أحد طرفيه أنبوبة صغيرة من المقوى تحشى بارودا و لها فتيل من فتحتها السفلى فإذا أُشعل الفتيل و احتُرق ما في مُؤخرتها من بارود…؛ سلاح حربي، و رُبما استُخدم في أمور غير حربية، وهو كناية على اسطوانة ضخمة مخروطية الشكل، ذات جناحين صغيرين يثبتانها في خط مجراها…)\nمثال: هبط الصاروخ بدون مشاكل.",
 "rocket base": "قاعدة صواريخ (قاعدة عسكرية للصواريخ)",
 "rocket cress": "بربارة شائعة, جرجير الشتاء (رشاد ضار ذو أزهار صفراء؛ يوضع أحياناً في جنس سيسيمبريم)",
 "rocket engine": "صاروخ, محرك صاروخي (محرك نفاث يحتوي على مادة دافعة خاصة به ويعمل بالدفع النفاث)",
 "rocket engineer": "مهندس صواريخ (مهندس يقوم ببناء واختبار الصواريخ)",
 "rocket firing": "إطلاق صاروخ (إطلاق صاروخ أو قذيفة بقوتها الذاتية)",
 "rocket fuel": "مادة دافعة للصواريخ, وقود الصواريخ (شحنة متفجرة تدفع الصاروخ)",
 "rocket larkspur": "عايق الحقل, عايق الصواريخ (عايق يزرع عادة في جنوب أوروبا له عناقيد غير متفرعة تشبه السنابل من الزهور الزرقاء أو الأرجوانية أو الوردية أحياناً؛ يوضع أحياناً في جنس دلفينيوم)",
 "rocket launcher": "قَاذِفَة صَوَارِيخ",
 "rocket launching": "إطلاق صاروخ (إطلاق صاروخ أو قذيفة بقوتها الذاتية)",
 "rocket propellant": "مادة دافعة للصواريخ, وقود الصواريخ (شحنة متفجرة تدفع الصاروخ)",
 "rocket propellent": "مادة دافعة للصواريخ, وقود الصواريخ (شحنة متفجرة تدفع الصاروخ)",
 "rocket propulsion": "دفع صاروخي (دفع نفاث يستخدم الأكسجين المخزن للاحتراق؛ يستخدم في الأماكن التي لا يوجد فيها أكسجين جوي كافٍ)",
 "rocket range": "ميدان صواريخ (ميدان إطلاق للصواريخ)",
 "rocket salad": "جرجير, روكا (نبات حولي أوروبي قائم يزرع غالباً كمحصول سلطة ليحصد عندما يكون صغيراً وطرياً)",
 "rocket scientist": "مهندس صواريخ (مهندس يقوم ببناء واختبار الصواريخ) / عبقري (مفكر ذكي (مجازياً))\nمثال: لست بحاجة لأن تكون عبقرياً لتكتشف ذلك",
 "rocket-propelled": "صاروخي الدفع (مدفوع (أو كأنه مدفوع) بمحرك صاروخي)",
 "rocketry": "علم الصواريخ (فرع العلوم الهندسية الذي يدرس تصميم وتشغيل الصواريخ)",
 "rockfish": "قاروص مخطط (سمكة طعام وصيد بحرية ذات خطوط طولية داكنة؛ تهاجر عكس تيار النهر لوضع البيض) / سمكة الصخر (سمكة طعام بحرية توجد بين الصخور على طول السواحل الشمالية لأوروبا وأمريكا) / سمك الصخر (اللحم قليل الدهن لأي من أسماك السوق القيمة المختلفة التي يتم صيدها بين الصخور)",
 "rockfoil": "كاسر الحجر (الذي قام بالكَسْر؛ اسم من أسماء العُقَاب)",
 "rockiness": "صَخْرِيَّة, وُعُورَة (صفة الامتلاء بالصخور والأحجار)",
 "rocking chair": "كرسي هزاز (كرسي مثبت على زلاجات مقوسة تسمح له بالتأرجح)",
 "rocking horse": "حصان خشبي, حصان هزاز (لعبة أطفال تتكون من حصان مقلد مثبت على زلاجات؛ يمتطيه الطفل ويتظاهر بالركوب)",
 "rockingham podocarp": "بودوكاربوس روكينغهام, صنوبر بني (شجرة أسترالية كبيرة بخشب أصفر مستقيم الحبيبات يتحول إلى البني عند التعرض للهواء)",
 "rocklike": "حَجَرِيّ, صَخْرِيّ (شَبيه بالصَّخْر أو الغْرانِيت في الصَّلابَة)",
 "rockrose": "اللاذن, زهرة الصخر (شجيرات صغيرة من مناطق الأحراش والغابات الجافة في جنوب أوروبا وشمال أفريقيا؛ تزرع لأزهارها المبهرجة وأوراقها دائمة الخضرة الناعمة غالباً ما تكون زغبية…) / هليانثيموم, وردة الصخر (أي من أصناف عديدة من الهليانثيموم لها زهور صغيرة تشبه الورد صفراء أو بيضاء أو حمراء)",
 "rockslide": "انهيار صخري (انهيار أرضي مكون من الصخور)",
 "rockweed": "عشب الصخور (عشب بحري بني خشن ينمو على الصخور المكشوفة عند الجزر)",
 "rocky": "قَاسٍ, وَعِر (مَلِيء بِالمَشَقَّة وَالمِحَن) / حَجَرِيّ, صَخْرِيّ (مليء بالصخور أو الأحجار) / متخبط, مهتز (يسبب أو يتسم بالاهتزازات والحركات غير المنتظمة) / مُتَأَرْجِح (قابل للتأرجح والتمايل)\nمثال: ركوب وعر",
 "rocky mountain bee plant": "نبات النحل, نفل نتن (نبات من غرب أمريكا الشمالية ذو أوراق ثلاثية وأزهار بيضاء أو وردية تشبه العنكبوت؛ يستخدم أحياناً كنبات زينة)",
 "rocky mountain bighorn": "الضأن كبير القرون, كباش الجبال الصخرية (خروف بري في المناطق الجبلية بغرب أمريكا الشمالية له قرون ضخمة ملتوية)",
 "rocky mountain bristlecone pine": "صنوبر المخروط الشائك, صنوبر بريستلكون (صنوبر مرتفعات صغير بطيء النمو من غرب الولايات المتحدة (جبال روكي) له فروع كثيفة ولحاء بني صدئ متشقق وإبر قصيرة في حزم من 5 وحراشف مخروطية مدببة…)",
 "rocky mountain dogbane": "دفل جبال الروكي (نبات من أمريكا الشمالية يشبه الدفل الشائع)",
 "rocky mountain goat": "ماعز الجبل (ثديي ثابت القدم يعيش في المناطق الجبلية بشمال غرب أمريكا الشمالية)",
 "rocky mountain jay": "قيق جبال روكي (قيق كندي ذو رأس أبيض؛ واسع الانتشار من مونتانا إلى أريزونا)",
 "rocky mountain pinon": "بينيون جبال روكي (بينيون صغير مدمج ثنائي الإبر من جنوب غرب الولايات المتحدة؛ مهم كصنوبر جوز)",
 "rocky mountain sheep": "الضأن كبير القرون, كباش الجبال الصخرية (خروف بري في المناطق الجبلية بغرب أمريكا الشمالية له قرون ضخمة ملتوية)",
 "rocky mountain spotted fever": "حمى جبال روكي المبقعة (تسببها بكتيريا ريكتسي وينقلها قراد الخشب)",
 "rocky mountain whitefish": "سمك أبيض جبلي (سمكة بيضاء من غرب الولايات المتحدة وكندا)",
 "rocky mountains": "جِبَال رُوكِي",
 "rocky mountains cherry": "كرز الرمل الغربي (شجيرة زينة قزمية من غرب الولايات المتحدة لها ثمار صالحة للأكل كبيرة سوداء إلى حمراء وصفراء حلوة)",
 "rocky-mountain maple": "قيقب جبال روكي, قيقب قزمي (قيقب صغير من شمال غرب أمريكا الشمالية)",
 "rococo": "رُوكُوكِيّ, مُزَخْرَف بِإِفْرَاط (ذو زخرفة غير متماثلة مفرطة) / روكوكو (زخرفة خيالية ولكن رشيقة غير متناظرة في الفن والعمارة نشأت في فرنسا في القرن الثامن عشر)",
 "rod": "عَصًا (ما يتخذ من خَشَب للتوكؤ أو الضرب؛ تطلق مجازا على عَظْم السَاق وعلى اللِسَان)\nمثال: لا تمسك العصا من الوسط.",
 "rod cell": "خلية عصوية, عصية (خلية مستقبلة بصرية حساسة للضوء الخافت)",
 "rod puppet": "دمية العصا, عروسة العصا (دمية مبنية حول عصا مركزية مثبتة بالرأس، يتحكم بها محرك الدمى بتحريك القضبان المعدنية المتصلة بيدي الدمية وأي أطراف أخرى وتدوير العصا المركزية المثبتة…)",
 "rod-shaped": "قَضِيبِيُّ الشَّكْلِ (يشبه القضيب أو العصا في شكله) / عُصَيِّيّ الشَّكْل, قَضِيبِيّ (على شكل العُصَيَّة أو القضيب)",
 "rodent": "قَارِض, قَوَارِض",
 "rodeo": "روديو (استعراض لمهارات رعاة البقر) / حلبة الروديو (حظيرة للماشية التي تم تجميعها)",
 "rodeo rider": "خيال الروديو, مستعرض الروديو (مؤدٍ يقدم استعراضات في ركوب الخيول واستخدام الحبال ومصارعة الثيران)",
 "roderick": "لُذَرِيق",
 "rodlike": "قَضِيبِيُّ الشَّكْلِ (يشبه القضيب أو العصا في شكله)",
 "rodolia cardinalis": "فيداليا (موطنها أستراليا؛ أدخلت في أماكن أخرى لمكافحة الحشرات القشرية)",
 "rodomontade": "عجرفة, غطرسة (تفاخر فارغ ومغرور)",
 "rodriguez": "رودريغيز",
 "roe": "بطارخ, بيض السمك (البيض أو المبيض الممتلئ بالبيض للسمك) / بطارخ القشريات (كتلة البيض أو السرء لبعض القشريات مثل الكركند) / بطارخ (بيض إناث الأسماك) / بطارخ (بيض السمك أو المبيض الممتلئ بالبيض؛ له قوام حبيبي)",
 "roe deer": "يَحْمُور, يَأْمُور",
 "roebuck": "يَحْمُور",
 "roentgen": "رونتغن (وحدة للتعرض للإشعاع؛ جرعة الإشعاع المؤين التي تنتج وحدة كهرباء ساكنة واحدة في 1 سم مكعب من الهواء الجاف)",
 "roentgen ray": "أشعة إكس, أشعة سينية (إشعاع كهرومغناطيسي قصير الموجة ينتج عندما تضرب إلكترونات عالية السرعة هدفاً صلباً)",
 "roentgenium": "رُونْتْجِينْيُوم",
 "roentgenogram": "أشعة إكس, صورة أشعة سينية (صورة شعاعية مصنوعة بتعريض فيلم فوتوغرافي للأشعة السينية؛ تستخدم في التشخيص الطبي)",
 "roentgenographic": "شعاعي (يتعلق بالتصوير الشعاعي (رونتجن) أو ناتج عنه)",
 "roentgenography": "تصوير بالأشعة السينية (التصوير الشعاعي الذي يستخدم الأشعة السينية لإنتاج صورة شعاعية)",
 "roentgenoscope": "جهاز كشف بالأشعة, منظار تألقي (آلة أشعة سينية تجمع بين مصدر للأشعة السينية وشاشة فلورية لتمكين المراقبة المباشرة)",
 "rofecoxib": "روفيكوكسيب, فيوكس (مثبط كوكس-2 (الاسم التجاري فيوكس) يخفف الألم والالتهاب دون الإضرار بالجهاز الهضمي؛ سُحب طوعاً من السوق في عام 2004)",
 "rogaine": "روجين, مينوكسيديل (موسع للأوعية الدموية (الاسم التجاري لونيتين) يستخدم لعلاج ارتفاع ضغط الدم الشديد؛ أحد آثاره الجانبية هو الشعرانية لذلك يباع أيضاً (الاسم التجاري…)",
 "rogation": "ابتهال رسمي (مراسم ابتهال رسمية تحددها الكنيسة)",
 "rogation day": "يوم الابتهال (أحد الأيام الثلاثة قبل عيد الصعود؛ يلاحظه بعض المسيحيين كأيام للتضرع)",
 "roger": "عُلِم, حَوِّل (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "rogue": "أفاق, محتال (شخص مخادع ولا يمكن الوثوق به)",
 "rogue elephant": "فيل مارق, فيل هائج (فيل بري وشرس انفصل عن القطيع)",
 "rogue nation": "دولة مارقة (دولة لا تحترم الدول الأخرى في أعمالها الدولية)",
 "rogue state": "دَوْلَة مَارِقَة (بَلَد يتميز بحُدُود معروفة وشَعْب وحُكُومَة ومُؤَسَسَات مُنَظَّمَة؛ مجموعة من الناس مستقلين متحدين معا لتكوين مجتمع لحماية حقوقهم و وضع قوانينهم الخاصة)\nمثال: لبنان دولة صغيرة.",
 "rogue's gallery": "معرض المجرمين (مجموعة من صور المجرمين) / زمرة الأشرار (زمرة من الأشخاص غير المرغوب فيهم)",
 "roguery": "أذى, شقاوة (سلوك متهور أو خبيث يسبب الإزعاج أو الضيق للآخرين)",
 "rogues' gallery": "معرض المحتالين",
 "roguish": "نَذْل, وَغْدِيّ (عديم المبادئ أو الضمير) / شَيْطَانِيّ, مَاكِر بِلُطْف (مرح بجرأة جذّابة ومحبّبة)",
 "roguishly": "بخبث محبب, بمكر مرح (بطريقة ماكرة ولكنها مرحة) / باحتيال, كالأوغاد (مثل المحتال غير الشريف)\nمثال: غمز لها بمكر مرح",
 "roguishness": "أذى, شقاوة (سلوك متهور أو خبيث يسبب الإزعاج أو الضيق للآخرين) / عبث, ميل للمقالب (سمة الانغماس في مقالب سيئة السمعة)",
 "rohypnol": "روهيبنول, فلونيترازيبام (مهدئ ومثبط (الاسم التجاري روهيبنول) يستخدم غالباً في ارتكاب الاعتداء الجنسي؛ متاح قانونياً في أوروبا والمكسيك وكولومبيا)",
 "roi": "العَائِد عَلَى الِاسْتِثْمَار, العَائِد عَلَى رَأْس المَال المُسْتَثْمَر ((المالية) المبلغ، المعبر عنه كنسبة مئوية، الذي يتم كسبه على إجمالي رأس مال الشركة، ويحسب بقسمة إجمالي رأس المال على الأرباح قبل دفع الفوائد أو…)",
 "roiled": "مُتَلَاطِم, مُضْطَرِب ((لسائل) مُحرَّك بعنف؛ في حالة اضطراب وتلاطم) / مُتَضَايِق, مُنْزَعِج (أُثير فيه نفاد الصبر أو الغضب)",
 "roiling": "مُتَلَاطِم, مُضْطَرِب ((لسائل) مُحرَّك بعنف؛ في حالة اضطراب وتلاطم)",
 "roily": "مُتَلَاطِم, مُضْطَرِب ((لسائل) مُحرَّك بعنف؛ في حالة اضطراب وتلاطم)",
 "roisterer": "عِرْبِيد, مُعَرْبِد (محتفل صاخب وغير منضبط بشكل خاص)",
 "rolaids": "رولايدز (نوع من مضادات الحموضة)",
 "rolando's area": "قشرة حركية, منطقة حركية (المنطقة القشرية التي تؤثر على الحركات الحركية)",
 "rolando's fissure": "التلم المركزي, شق رولاندو (شق دماغي يمتد صعودًا على السطح الجانبي لكلا نصفي الكرة المخية؛ يفصل الفصين الجبهي والجداري)",
 "role": "دَوْر (جَعَله يَدُور؛ جَعَلَه مُدَوَّر)\nمثال: في أي دور تسكن؟",
 "role model": "قدوة, مثل أعلى (شخص يستحق التقليد والاقتداء به)\nمثال: كل طفل يحتاج إلى قدوة",
