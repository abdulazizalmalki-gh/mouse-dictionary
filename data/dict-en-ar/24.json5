 "roommate": "رَفِيق السَّكَن",
 "rooms": "جناح (شقة تتكون من سلسلة من الغرف المتصلة تستخدم كوحدة معيشة (كما في فندق))",
 "roomy": "وَاسِع, رَحْب (واسِع: (اسم)؛ واسع: (اسم))\nمثال: أرض الله واسعة.",
 "roosevelt": "رُوزِفِلْت",
 "rooseveltian": "روزفلتي (من أو يتعلق بفرانكلين روزفلت أو يشبهه أو على طريقته)",
 "roost": "مجثم (مجثم تستريح عليه أو تنام عليه الطيور الداجنة) / مَجثَم (مأوى به عوارض لجلوس الدواجن أو الطيور الأخرى)",
 "rooster": "دِيك (ذكر الدَجَاج؛ ذكر أي طير داجن يشبه الدجاج كالقَبَج وغيره)\nمثال: لديك بعض الكتب.",
 "root": "جَذْر, جدر (جِذْرُ ٱلشَّيْءِ هُوَ: أَصْلُهُ؛ في : جذر العدد النوني هو عدد ما إذا رفعناه لقوة ما أعطانا العدد الأصلي) / جَذْر (جِذْرُ ٱلشَّيْءِ هُوَ: أَصْلُهُ؛ في : جذر العدد النوني هو عدد ما إذا رفعناه لقوة ما أعطانا العدد الأصلي) / أَصْل (جعله أصيلًا أو ثابت الجذور؛ أي عَمَّق وأحكم أصوله؛ نسب شيئًا إلى أصله أو وضّح جذوره)\nمثال: أحسب جذر خمسة بالآلة الحاسبة.",
 "root beer": "روت بير, مشروب الجذور (مشروب غازي يحتوي على مستخلصات الجذور والأعشاب)",
 "root beer float": "روت بير فلوت (صودا آيس كريم مصنوعة من آيس كريم عائم في مشروب الروت بير)",
 "root canal": "قناة الجذر (الممر في جذر السن الذي تدخل من خلاله أعصابه وأوعيته الدموية إلى تجويف اللب)",
 "root cap": "قلنسوة الجذر (كتلة من الخلايا على شكل قمع تغطي وتحمي الطرف النامي للجذر)",
 "root celery": "كرفس جذري, كرفس لفتي (يزرع لجذره العطري السميك الصالح للأكل)",
 "root cellar": "قبو جذور, قبو خضروات (حفرة أو قبو حيث يتم تخزين الخضروات الجذرية)",
 "root climber": "متسلق جذري (نبات يتسلق بجذوره العرضية مثل اللبلاب)",
 "root crop": "محصول جذري (محصول يزرع لجذوره المتضخمة: مثل البنجر والبطاطس واللفت)",
 "root hair": "شعيرة جذرية (نمو شعري رقيق لخلية بشرة خلف الطرف مباشرة؛ يمتص العناصر الغذائية من التربة)",
 "root rot": "عفن الجذور (مرض يتميز بتعفن الجذور؛ تسببه فطريات مختلفة)",
 "root system": "مجموع جذري, نظام الجذور (نظام متطور من الجذور)",
 "root vegetable": "خضراوات جذرية (أي من الجذور أو الدرنات الصالحة للأكل اللحمية المختلفة تحت الأرض)",
 "root word": "أصل, جذر ((لغويات) شكل الكلمة بعد إزالة جميع اللواحق)",
 "rootage": "أصل, بداية (المكان الذي يبدأ فيه شيء ما، أو حيث ينبثق إلى الوجود) / مجموع جذري, نظام الجذور (نظام متطور من الجذور) / تجذر, رسوخ (الثبات بواسطة الجذور أو كما لو كان بالجذور)\nمثال: البداية الإيطالية لعصر النهضة",
 "rootbound": "مُتَلَبِّد الجُذُور (ذو جذور متشابكة أو متلبدة بكثافة) / مُقَيَّد الجُذُور, مُكَبَّل بِالأَصِيص ((عن نبتة في أصيص) نمت كثيراً بحيث تشابكت جذورها وضاق عليها الوعاء)",
 "rooter": "مشجع رياضي (مؤيد متحمس للرياضة)",
 "rooter skunk": "ظربان خنزيري الأنف (ظربان كبير عاري الخطم ذو ظهر وذيل أبيض؛ من جنوب غرب أمريكا الشمالية والمكسيك)",
 "rooting": "تجذير (عملية إخراج الجذور والبدء في النمو)",
 "rooting reflex": "منعكس البحث عن الثدي, منعكس التجذير (منعكس يتكون من إدارة الرأس وحركات المص التي تثار عند الرضيع الطبيعي عن طريق لمس جانب الفم أو الخد برفق)",
 "rootless": "صُعْلُوك, مُقْتَلَع الجُذُور (يتشرّد بلا هدف ودون روابط بمكان أو مجتمع)",
 "rootlet": "جذير (جذر صغير أو انقسام للجذر)",
 "roots": "أصول, جذور (حالة الانتماء إلى مكان أو مجموعة معينة بحكم النسب الاجتماعي أو العرقي أو الثقافي)\nمثال: جذوره في تكساس تعود إلى زمن طويل",
 "rootstalk": "جذمور (ساق نبات أفقية ذات براعم فوق وجذور تحت تعمل كهيكل تكاثري)",
 "rootstock": "أصل جذري (جذر أو جزء من جذر يستخدم لإكثار النبات؛ خاصة ذلك الجزء من النبات المطعم الذي يوفر الجذور) / جذمور (ساق نبات أفقية ذات براعم فوق وجذور تحت تعمل كهيكل تكاثري)",
 "rope": "حَبْل ((حَبَلَه): شَدّه بالحبْل؛ (حَبَلَه) الصَّيْدَ: نَصَب لَهُ الحِبَالةَ وصاده بهَا. وَيُقَال: حَبَلَت فُلَانَةُ فلَانًا: أوقعَتْه فِي شِباك حُبّها وسحَرته)\nمثال: حبل الكذب قصير.",
 "rope bridge": "جسر حبال (جسر مصنوع من الحبال)",
 "rope burn": "حرق الحبل (سحجة (عادة في اليدين) ناتجة عن الاحتكاك بحبل)",
 "rope ladder": "سلم حبال (سلم ذو جوانب مصنوعة من الحبال)",
 "rope tow": "حبل سحب المتزلجين (وسيلة لسحب المتزلجين توفر حبلاً متحركاً فقط للتمسك به)",
 "rope yard": "معمل حبال, ممشى الحبال (مكان عمل يتكون من ممر طويل وضيق أو سقيفة حيث يتم صنع الحبال)",
 "rope yarn": "خيط الحبل (الجدائل التي تصنع منها الحبال)",
 "rope-a-dope": "تكتيك الحبال (تكتيك في الملاكمة: التظاهر بأنك محاصر ضد الحبال بينما يرهق خصمك نفسه بتوجيه اللكمات)",
 "rope-maker": "صانع الحبال (حرفي يصنع الحبال)",
 "ropebark": "خشب الجلد, خشب الموس (شجيرة نفضية من شرق أمريكا الشمالية ذات أغصان مرنة قوية ولحاء لين وأزهار صفراء صغيرة)",
 "ropedancer": "راقص على الحبل, ماشي على الحبل (بهلوان يؤدي عروضاً على حبل مشدود على ارتفاع معين فوق الأرض)",
 "ropemaker": "صانع الحبال (حرفي يصنع الحبال)",
 "ropemaking": "حَبَالَة",
 "roper": "صانع الحبال (حرفي يصنع الحبال) / صائد بالوهق, مروض بالوهق (راعي بقر يستخدم الوهق لربط الماشية أو الخيول) / قناص الزبائن (طُعم يجذب الزبائن إلى مؤسسة قمار (خاصة تلك التي بها لعبة ثابتة))",
 "ropewalk": "معمل حبال, ممشى الحبال (مكان عمل يتكون من ممر طويل وضيق أو سقيفة حيث يتم صنع الحبال)",
 "ropewalker": "راقص على الحبل, ماشي على الحبل (بهلوان يؤدي عروضاً على حبل مشدود على ارتفاع معين فوق الأرض)",
 "ropeway": "ترامواي, تلفريك (وسيلة نقل تنقل الركاب أو البضائع في عربات معلقة بكابلات ومحمولة بواسطة سلسلة من الأبراج)",
 "ropey": "رَدِيء ((عامّيّة بريطانيّة) رديء الجودة جدًا) / لَزِجٌ خَيْطِيّ (يُشَكِّلُ خُيُوطًا لَزِجَةً أَوْ غَرَوِيَّة) / حبالي, حبلي (مكون من أو يشبه الحبل (أو الحبال) في كونه طويلاً وقوياً)",
 "rophy": "دواء النسيان, روفي (أسماء دارجة للفلونيترازيبام)",
 "ropiness": "تماسك, لزوجة (خاصية التماسك واللزوجة)",
 "roping": "تكبيل, ربط بالحبل (إمساك الماشية أو الخيول بحبل (الوهق))",
 "ropy": "رَدِيء ((عامّيّة بريطانيّة) رديء الجودة جدًا) / لَزِجٌ خَيْطِيّ (يُشَكِّلُ خُيُوطًا لَزِجَةً أَوْ غَرَوِيَّة) / حبالي, حبلي (مكون من أو يشبه الحبل (أو الحبال) في كونه طويلاً وقوياً)",
 "roquefort": "روكفور (جبن أزرق فرنسي)",
 "roquefort dressing": "تتبيلة الروكفور (فينيغريت (خل وزيت) يحتوي على فتات جبن الروكفور أو الجبن الأزرق)",
 "roquette": "جرجير, روكا (نبات حولي أوروبي قائم يزرع غالباً كمحصول سلطة ليحصد عندما يكون صغيراً وطرياً)",
 "roraima": "رُورَايْمَا",
 "roridula": "روريدولا (أي من نوعين من جنس روريدولا؛ شجيرات خشبية منخفضة النمو معمرة ولزجة من جنوب إفريقيا)",
 "rorippa amphibia": "رشاد أصفر كبير, روريپا برمائية (عشبة معمرة توجد على ضفاف الجداول والأنهار في جميع أنحاء أوروبا باستثناء أقصى الشمال والبحر الأبيض المتوسط؛ توضع أحياناً في جنس ناستورتيوم)",
 "rorippa islandica": "جرجير أصفر, رشاد المستنقعات (رشاد سنوي أو ثنائي الحول ينمو في الأماكن الرطبة يستخدم أحياناً في السلطات أو كعشبة طهي؛ عشبة ضارة مزعجة في بعض المناطق)",
 "rorippa nasturtium-aquaticum": "جرجير الماء, قرة العين (رشاد أوراسي معمر ينمو بشكل رئيسي في الينابيع أو المياه الجارية ذو أوراق لاذعة لحمية تستخدم في السلطات أو كعشبة طهي أو زينة؛ أدخل إلى أمريكا الشمالية…)",
 "rorqual": "هراكلة",
 "rorschach": "اختبار بقع الحبر, اختبار رورشاخ (اختبار إسقاطي يستخدم بقع حبر متناظرة ثنائية الجانب؛ يذكر الأشخاص ما يرونه في بقعة الحبر)",
 "rorschach test": "اختبار بقع الحبر, اختبار رورشاخ (اختبار إسقاطي يستخدم بقع حبر متناظرة ثنائية الجانب؛ يذكر الأشخاص ما يرونه في بقعة الحبر)",
 "rosa banksia": "ورد بانكسيا (ورد متسلق دائم الخضرة صيني ذو زهور مفردة صفراء أو بيضاء)",
 "rosa canina": "نسرين, ورد السياج (ورد بري شائك ذو زهور وردية رقيقة أو بيضاء عديمة الرائحة؛ موطنه أوروبا)",
 "rosa chinensis": "ورد بنغالي, ورد صيني (ورد صيني شجيري؛ سلف العديد من ورود الحدائق المزروعة)",
 "rosa damascena": "ورد جوري, ورد دمشقي (ورد وردي كبير قوي وعطر جداً؛ يزرع في آسيا الصغرى كمصدر لزيت الورد؛ أصل للعديد من الهجائن)",
 "rosa eglanteria": "نسرين, ورد ياقوتي (ورد أوراسي ذو سيقان شائكة وأوراق عطرة وزهور وردية زاهية تليها ثمار قرمزية)",
 "rosa laevigata": "ورد شيروكي (ورد متسلق صيني ذو أزهار بيضاء عطرة)",
 "rosa moschata": "ورد مسكي (ورد موطنه منطقة البحر الأبيض المتوسط له فروع منحنية أو متسلقة وعناقيد فضفاضة من الزهور برائحة المسك)",
 "rosa multiflora": "ورد متعدد الأزهار, ورد ياباني (ورد قوي النمو له عناقيد من الزهور الصغيرة العديدة؛ يستخدم للأسيجة وكأصل للتطعيم)",
 "rosa odorata": "ورد الشاي (أي من عدة ورود شجيرية هجينة مشتقة من ورد صيني برائحة الشاي ذو زهور وردية أو صفراء)",
 "rosa pendulina": "ورد الجبل (ورد ألبي أوروبي ذو زهور قرمزية)",
 "rosa spithamaea": "ورد أرضي (شجيرة شائكة منخفضة النمو من جنوب أوريغون وكاليفورنيا ذات جذور زاحفة وزهور عادة ما تكون عذقية)",
 "rosacea": "العد الوردي, الوردية (مرض جلدي يصيب البالغين (غالبًا النساء) تتضخم فيه الأوعية الدموية في الوجه مما يؤدي إلى مظهر متورد)",
 "rosaceous": "وَرْدِيّ تُرَابِيّ (بلون وردي أرجواني ترابي) / وردي (من أو متعلق بـ أو مميز لنباتات الفصيلة الوردية)",
 "rosary": "مِسْبَحَة, سُبْحَة",
 "rose": "وَرْدَة",
 "rose acacia": "روبينيا شعراء, سنط وردي (شجيرة كبيرة أو شجرة صغيرة في شرق الولايات المتحدة لها سيقان خشنة وعناقيد كبيرة من الزهور الوردية)",
 "rose apple": "تفاح الورد, جامبو (فاكهة استوائية صفراء بيضاوية عطرية تستخدم في الهلام والحلويات) / تفاح الورد, جامبوزا (شجرة استوائية من جزر الهند الشرقية تزرع لفاكهتها الصالحة للأكل)",
 "rose bay": "دفلى, ورد الحمار (شجيرة مزهرة للزينة ولكنها سامة، ذات أوراق دائمة الخضرة ضيقة ومجموعات من الأزهار العطرة البيضاء إلى الوردية أو الحمراء؛ موطنها جزر الهند الشرقية…)",
 "rose bed": "حوض ورود (حوض زهور ينمو فيه الورد)",
 "rose beetle": "خنفساء الورد (خنفساء أوروبية خضراء معدنية شائعة: تتغذى اليرقات على جذور النباتات والبالغات على أوراق وزهور الورد مثلاً)",
 "rose bug": "خنفساء الورد (خنفساء شائعة في أمريكا الشمالية: تتغذى اليرقات على الجذور والبالغون على الأوراق والزهور مثل شجيرات الورد أو أشجار التفاح أو كروم العنب)",
 "rose campion": "قرنفل البوصير, ليخنيس إكليلي (نبات حديقة قديم في جنوب شرق أوروبا يزرع على نطاق واسع لأوراقه الصوفية البيضاء الجذابة وزهوره القرمزية المبهرجة)",
 "rose chafer": "خنفساء الورد (خنفساء شائعة في أمريكا الشمالية: تتغذى اليرقات على الجذور والبالغون على الأوراق والزهور مثل شجيرات الورد أو أشجار التفاح أو كروم العنب) / خنفساء الورد (خنفساء أوروبية خضراء معدنية شائعة: تتغذى اليرقات على جذور النباتات والبالغات على أوراق وزهور الورد مثلاً)",
 "rose chestnut": "خشب الحديد, كستناء الورد (شجرة دائمة الخضرة جميلة من شرق الهند تزرع غالباً كزينة لأزهارها البيضاء العطرة التي تنتج عطراً؛ مصدر لخشب صلب ثقيل جداً يستخدم لروابط السكك الحديدية)",
 "rose garden": "حديقة ورود (حديقة لزراعة الورود)",
 "rose geranium": "غرنوقي الورد, لقلقي نفاذ (أي من عدة نباتات غرنوقي من جنوب إفريقيا لها أوراق عطرية ثلاثية إلى خماسية الفصوص وزهور وردية)",
 "rose globe lily": "زنبق الكرة الوردي (زنبق كروي بزهور بيضاوية الشكل وردية عميقة أو أرجوانية على سيقان مرنة؛ المنحدرات الغربية لسييرا نيفادا في وادي سان جواكين)",
 "rose gum": "صمغ الورد (شجرة طويلة جداً من كوينزلاند ونيو ساوث ويلز)",
 "rose hip": "ثمرة الورد (ثمرة نبات الورد)",
 "rose leek": "ثوم كندي (نبات بصلي من أمريكا الشمالية)",
 "rose mallow": "ختمية وردية, خطمي وردي (نبات ذو عناقيد طرفية من الزهور البيضاء إلى الوردية أو الأرجوانية المبهرجة؛ الختمية الإنجليزية لحدائق الأكواخ) / ختمية المستنقعات, ختمية وردية (شجيرة مبهرجة في المستنقعات المالحة بشرق الولايات المتحدة ذات زهور وردية كبيرة)",
 "rose moss": "بقلة الزهور, رجلة الزهور (تزرع على نطاق واسع في العديد من الأصناف لأوراقها اللحمية التي تشبه الطحالب ووفرة زهورها زاهية الألوان)",
 "rose of china": "كركديه صيني, ورد صيني (شجيرة آسيوية كبيرة مبهرجة أو شجرة صغيرة ذات زهور حمراء إلى حمراء داكنة كبيرة مفردة أو مزدوجة)",
 "rose of jericho": "كف مريم, نبات القيامة (نبات صحراوي آسيوي رمادي صغير يحمل أزهاراً بيضاء دقيقة يلتف عند الجفاف ويتمدد عند الرطوبة) / نبات القيامة, وردة أريحا (حليف سرخس كثيف الخصلات من جنوب غرب الولايات المتحدة إلى بيرو؛ يلتف في كرة محكمة عندما يجف ويتوسع وينمو في الظروف الرطبة)",
 "rose of sharon": "ختمية سورية, ورد شارون (شجيرة آسيوية أو شجرة شجيرية صغيرة ذات زهور وردية أو أرجوانية أو بيضاء مبهرجة على شكل جرس وأوراق ثلاثية الفصوص عادة؛ تزرع على نطاق واسع في أمريكا…)",
 "rose oil": "زيت الورد (زيت عطري متطاير يتم الحصول عليه من الورود الطازجة بالتقطير بالبخار)",
 "rose periwinkle": "عناقية, عين البزون (عشب خشبي من العالم القديم يزرع عادة وله أزهار كبيرة وردية إلى حمراء)",
 "rose pink": "قرنفل المستنقعات, قنطريون أمريكي (أي من عدة نباتات مستنقعات زهرية اللون من شرق الولايات المتحدة تشبه القنطريون الحقيقي)",
 "rose quartz": "كوارتز وردي (نوع وردي محمر نصف شفاف من الكوارتز يستخدم للزينة)",
 "rose water": "ماء الورد (عطر يتكون من الماء المعطر بزيت الورد)",
 "rose window": "نافذة وردية (نافذة دائرية مليئة بالزخارف)",
 "rose wine": "روزيه, نبيذ وردي (نبيذ مائدة وردي اللون من عنب أحمر أزيلت قشوره بعد بدء التخمير)",
 "rose-apple tree": "تفاح الورد, جامبوزا (شجرة استوائية من جزر الهند الشرقية تزرع لفاكهتها الصالحة للأكل)",
 "rose-cheeked": "مُتَوَرِّد, وَرْدِيّ الخَدَّيْن (ذو بَشَرَة مُتَوَرِّدَة تَدُلّ عَلى الصِّحَّة)",
 "rose-colored": "وَرْدِيّ اللَّوْن (ذو لون ورديّ) / مُتَفَائِل, وَرْدِيّ (يعكس التفاؤل ويُظهر نظرة إيجابية)",
 "rose-colored pastor": "زرزور وردي (طائر أسود لامع بظهر وبطن وردي؛ آسيوي بشكل رئيسي)",
 "rose-colored starling": "زرزور وردي (طائر أسود لامع بظهر وبطن وردي؛ آسيوي بشكل رئيسي)",
 "rose-lavender": "خُزَامِيّ وَرْدِيّ (خزامي مع مسحة وردية)",
 "rose-lilac": "خُزَامِيّ وَرْدِيّ (خزامي مع مسحة وردية)",
 "rose-mauve": "بَنَفْسَجِيّ وَرْدِيّ (بنفسجي شاحب مع مسحة وردية)",
 "rose-purple": "أُرْجُوَانِيّ وَرْدِيّ (أرجواني مع مسحة وردية)",
 "rose-red": "أَحْمَر وَرْدِيّ غَامِق (بلون أحمر عميق مائل قليلاً إلى الأزرق)",
 "rose-root": "جذر الورد, سدم وردي (نبات جبلي أوراسي بأوراق لحمية ذات أطراف وردية وعنقود من الزهور الصفراء)",
 "rose-tinged": "مَصْبُوغ بِالوَرْدِيّ (بلون ممزوج بمسحة وردية خفيفة)",
 "rose-tinted": "مَصْبُوغ بِالوَرْدِيّ (بلون ممزوج بمسحة وردية خفيفة)",
 "roseate": "وَرْدِيّ تُرَابِيّ (بلون وردي أرجواني ترابي)",
 "roseate spoonbill": "أبو ملعقة الوردي (أبو ملعقة استوائي وردي اللون من العالم الجديد)",
 "roseau": "رُوسُو",
 "rosebay": "دفلية, ردندرة عظمى (ردندرة تزهر في أواخر الربيع من شرق أمريكا الشمالية لها زهور وردية إلى وردية أرجوانية)",
 "rosebay willowherb": "عشبة الصفصاف العملاقة, عشبة النار (نبات معمر طويل من أمريكا الشمالية ذو جذور زاحفة وأوراق ضيقة وسنابل من الزهور الوردية الأرجوانية توجد بكثرة كبيرة في المناطق المحترقة أو المناطق التي…)",
 "rosebud": "فتاة يافعة ((إشارة أدبية إلى) فتاة شابة جميلة) / برعم الورد (برعم زهرة الورد)",
 "rosebud cherry": "كرز برعم الورد, كرز مزهر شتوي (شجيرة أو شجرة موطنها اليابان تزرع للزينة لأزهارها الوردية)",
 "rosebud orchid": "أوركيد برعم الورد (أوركيد في وسط وشمال أمريكا الجنوبية ذو عناقيد من 1 إلى 3 زهرات وردية كبيرة مبهرجة؛ يوضع أحياناً في جنس بوجونيا)",
 "rosebush": "شجيرة الورد, ورد (أي من شجيرات عديدة من جنس الورد تحمل الورود)",
 "rosefinch": "جَزَم, تُنْجِيّ (قطع أو حسم الشيء بدقة وثبات؛ في : جعل الكلمة في حالة الجزم، وذلك بحذف الحرف الأخير أو حركته)",
 "rosefish": "سمكة الورد, فرخ المحيط (سمكة كبيرة في سواحل شمال المحيط الأطلسي لأمريكا وأوروبا) / سمك أحمر, سمك الصخر (سمك الصخر من شمال الأطلسي)",
 "rosehip": "ثمرة الورد (ثمرة نبات الورد)",
 "roselle": "حميض أحمر, غجر (عشبة سنوية شائكة قليلاً من شرق الهند أو شجيرة معمرة تزرع على نطاق واسع لكؤوسها اللحمية المستخدمة في الفطائر والهلام ولألياف اللحاء)",
 "rosemaling": "رسم نرويجي (نمط إسكندنافي من الزخرفة المحفورة أو المرسومة (كما على الأثاث أو الجدران أو أواني الطعام) يتكون من زخارف نباتية)",
 "rosemary": "إِكْلِيل الْغَار, إِكْلِيل الْجَبَل",
 "roseola": "طفح جلدي (أي طفح أحمر على الجلد)",
 "roseola infantilis": "طفح وردي, وردية الرضيع (مرض فيروسي يصيب الرضع والأطفال الصغار؛ يتميز بحمى عالية مفاجئة تليها طفح جلدي وردي باهت)",
 "roseola infantum": "طفح وردي, وردية الرضيع (مرض فيروسي يصيب الرضع والأطفال الصغار؛ يتميز بحمى عالية مفاجئة تليها طفح جلدي وردي باهت)",
 "rosetta stone": "حَجَر رَشِيد (حَجَرَ عليه الأمرَ:مَنَعَه منه ، حجر الشّيء على نفسه:خَصَّها به وقصره عليها؛ الحجْرُ: المَنْعُ مِن التَّصَرُّفِ ، وحَجَرَ عَلَيْهِ القاضِي يَحْجُرُ حَجْراً، إِذا مَنَعَه مِن التَّصَرُّفِ فِي مالِه)\nمثال: عوقب زيري بالحجر.",
 "rosette": "شارة وردية, وردة شريطية (حلية أو نمط يشبه الوردة يُلبس كشارة منصب أو اعترافاً بالفوز بشرف ما) / نافذة وردية (نافذة دائرية مليئة بالزخارف) / وريدة (مجموعة من الأوراق تنمو في دوائر مزدحمة من مركز مشترك أو تاج (عادة عند الأرض أو بالقرب منها)) / البطاطس الصغيرة, تقرح الساق (مرض الريزوكتونيا الذي يصيب البطاطس)",
 "rosewater": "مَاء وَرْد (السائل الشفاف المعروف الذي تنشأ به الحياة، عديم اللون والرائحة والطعم عندما يكون نقيا؛ علميا فِي : جزيئة متكونة من ذرتي هيدروجين مرتبطين بذرة واحدة من الأوكسيجين)\nمثال: أنا أشرب الماء.",
 "rosewood": "خشب الورد, شجرة خشب الورد (أي من تلك الأشجار الخشبية الصلبة من جنس دالبيرجيا التي تنتج خشب الورد - أخشاب خزائن قيمة ذات لون أحمر داكن أو أرجواني مخطط ومبرقش بالأسود) / خشب الورد (خشب محمر داكن صلب لشجرة خشب الورد له عروق مميزة بقوة؛ يستخدم في الخزائن)",
 "rosewood tree": "خشب الورد, شجرة خشب الورد (أي من تلك الأشجار الخشبية الصلبة من جنس دالبيرجيا التي تنتج خشب الورد - أخشاب خزائن قيمة ذات لون أحمر داكن أو أرجواني مخطط ومبرقش بالأسود)",
 "rosh chodesh": "رأس الشهر, روش خوديش ((اليهودية) بداية كل شهر في التقويم اليهودي؛ يتميز بطقوس خاصة)",
 "rosh hashana": "رأس السنة العبرية, روش هاشانا ((اليهودية) عيد يهودي رسمي يُحتفل به في الأول أو الأول والثاني من تشري؛ يشتهر بنفخ الشوفار)",
 "rosh hashanah": "رَأْس السَّنَة, رَاش هَشَنَه رُوش هَاشَنَاه (عُضْو مِنَ ٱلْجَسَدِ يَحْوِي الدِّمَاغ والفَم والأَنْف والعَيْنَيْن والأُذُنَيْن؛ أَعْلَى ٱلشَّيْءِ)\nمثال: قطع سامي رأس كلب.",
 "rosh hashona": "رأس السنة العبرية, روش هاشانا ((اليهودية) عيد يهودي رسمي يُحتفل به في الأول أو الأول والثاني من تشري؛ يشتهر بنفخ الشوفار)",
 "rosh hashonah": "رأس السنة العبرية, روش هاشانا ((اليهودية) عيد يهودي رسمي يُحتفل به في الأول أو الأول والثاني من تشري؛ يشتهر بنفخ الشوفار)",
 "rosh hodesh": "رأس الشهر, روش خوديش ((اليهودية) بداية كل شهر في التقويم اليهودي؛ يتميز بطقوس خاصة)",
 "rosicrucian": "صليبي وردي (من أو متعلق بالصليب الوردي (روزيكروشيان)) / صَلِيبِيّ وَرْدِيّ (عضو في جمعية سرية في القرن السابع عشر للفلاسفة والعلماء) / عُضْو جَمْعِيَّة الصَّلِيب الوَرْدِيّ (عضو في أي من المنظمات المختلفة التي اشتقت لاحقاً من جمعية القرن السابع عشر)",
 "rosicrucianism": "روزيكروشية, صليب وردي (العقيدة اللاهوتية التي تبجل الوردة والصليب كرموز لقيامة المسيح والفداء؛ تدعي قوى غامضة مختلفة)",
 "rosid dicot family": "فصيلة الوردانيات (فصيلة من النباتات ثنائية الفلقة)",
 "rosid dicot genus": "جنس من الورديات (جنس من النباتات ثنائية الفلقة)",
 "rosilla": "روزيلا (عشبة عطاس من جنوب غرب الولايات المتحدة وخاصة جنوب كاليفورنيا)",
 "rosin": "راتنج (أي من فئة المواد الصلبة أو شبه الصلبة اللزجة التي يتم الحصول عليها إما كإفرازات من نباتات معينة أو يتم تحضيرها عن طريق بلمرة جزيئات بسيطة)",
 "rosin bag": "كيس راتنج, كيس صمغ (كيس مملوء بالراتنج (الصمغ)؛ يستخدمه رماة البيسبول لتحسين قبضتهم على الكرة)",
 "rosiness": "تورد, وردي (لون وردي مغبر) / احمرار, تورد (بشرة محمرة صحية) / تورد, نضارة (لون وردي (خاصة في الخدين) يؤخذ كعلامة على الصحة الجيدة)",
 "rosinweed": "عشبة الصمغ, غرنديليا (أي من النباتات المتنوعة في غرب أمريكا من جنس غرنديليا ذات أوراق وسيقان راتنجية كانت تستخدم طبياً سابقاً؛ غالباً ما تكون سامة للماشية) / سلفيوم مشرشر, عشبة الراتنج (نبات معمر من أمريكا الشمالية له رائحة راتنجية وزهور صفراء)",
 "rosita": "روزيتا, قنطريون كأسية (نبات منتصب ذو عناقيد صغيرة من الزهور الوردية بوقية الشكل، موطنه جنوب غرب الولايات المتحدة)",
 "rosmarinus officinalis": "إكليل الجبل, حصى البان (نبات يزرع على نطاق واسع لأوراقه العطرية الرمادية المخضرة المستخدمة في الطبخ وفي العطور)",
 "roster": "سجل, قائمة أسماء (قائمة بالأسماء)\nمثال: شطب اسمه من السجلات",
 "rostov": "رُوسْتُوف",
 "rostov-on-don": "روستوف-نا-دونو",
 "rostrate": "خُرْطُومِيّ, مِنْقَارِيّ (ذو منقار أو خرطوم يشبه المنقار)",
 "rostrum": "خطم (نتوء يشبه المنقار للجزء الأمامي من رأس بعض الحشرات مثل السوس) / منبر, منصة الخطابة (منصة مرتفعة عن المستوى المحيط لإبراز الشخص الموجود عليها)",
 "rosy": "سَعِيد, وَرْدِيّ (ينبئ بحظ جيد وطالع حسن) / وَرْدِيّ مُتَوَرِّد (بلون الخَجَل؛ وردي مائل إلى الاحمرار) / مُتَوَرِّد, وَرْدِيّ الخَدَّيْن (ذو بَشَرَة مُتَوَرِّدَة تَدُلّ عَلى الصِّحَّة) / مُتَفَائِل, وَرْدِيّ (يعكس التفاؤل ويُظهر نظرة إيجابية)",
 "rosy boa": "أصلة وردية (أصلة تعيش في الصحراء الصخرية بجنوب غرب الولايات المتحدة)",
 "rosy-cheeked": "مُتَوَرِّد, وَرْدِيّ الخَدَّيْن (ذو بَشَرَة مُتَوَرِّدَة تَدُلّ عَلى الصِّحَّة)",
 "rosy-colored": "وَرْدِيّ اللَّوْن (ذو لون ورديّ)",
 "rosy-purple": "أُرْجُوَانِيّ وَرْدِيّ (أرجواني مع مسحة وردية)",
 "rosé wine": "نَبِيذ وَرْدِيّ (نَبِيذ (صفة مفردة مذكرة، مؤنثها نَبِيْذَة، وجمعها السالم نَبِيْذُوْن، وجمعها المؤنث السالم نَبِيْذَات، وجمعها المكسر أَنْبِذَة)؛ نَبِيذ (لا يؤنث، وجمعه أَنْبِذَة))\nمثال: أنا شربت النبيذ.",
 "rot": "أَفْسَدَ, فَسَدَ",
 "rot-resistant": "مُقَاوِم لِلتَّعَفُّن (يقاوم العفن والتحلّل)",
 "rota": "جدول مناوبة (قائمة أسماء تظهر الترتيب الذي يجب أن يؤدي به الأشخاص واجبات معينة) / الروتا, محكمة الروتا الرومانية ((الكنيسة الرومانية الكاثوليكية) المحكمة الكنسية العليا للقضايا المستأنفة إلى الكرسي الرسولي من المحاكم الأبرشية)",
 "rotarian": "رُوتارِيّ, عُضْو نادِي الرُّوتارِي (عضو في نادي الروتاري)",
 "rotary": "دَائِرِيّ, دَوَّارِيّ (يرسم دائرة أو يتحرك في مسار دائري) / دوراني (يتعلق بالدوران أو يتميز به) / محول دوار, محول متزامن (محول كهربائي يتكون من آلة متزامنة تحول التيار المتردد إلى تيار مستمر أو العكس) / دوار, صينية (تقاطع طرق تتدفق فيه حركة المرور بشكل دائري حول جزيرة مركزية)\nمثال: قرص دوراني",
 "rotary actuator": "محدد الموضع, مشغل دوار ((في علم الحاسوب) المشغل الذي يحرك رأس القراءة/الكتابة إلى مسار البيانات المناسب)",
 "rotary club": "نادي الروتاري (مجموعة من رجال الأعمال في بلدة منظمة كنادي خدمة ولتعزيز السلام العالمي)",
 "rotary converter": "محول دوار, محول متزامن (محول كهربائي يتكون من آلة متزامنة تحول التيار المتردد إلى تيار مستمر أو العكس)",
 "rotary encoder": "مشفر دوار (جهاز كهروميكانيكي يحول الموضع الزاوي أو حركة عمود أو محور إلى كود تناظري أو رقمي)",
 "rotary engine": "محرك دوار, محرك شعاعي (محرك احتراق داخلي تترتب فيه الأسطوانات شعاعياً حول علبة مرافق مركزية) / محرك دوراني (محرك احتراق داخلي يتم فيه نقل الطاقة مباشرة إلى المكونات الدوارة)",
 "rotary harrow": "مسلفة دوارة, مشط دوراني (مشط يستخدم سلسلة من العجلات المسننة الدوارة لتفتيت وتسوية سطح التربة)",
 "rotary international": "نادي الروتاري (مجموعة من رجال الأعمال في بلدة منظمة كنادي خدمة ولتعزيز السلام العالمي)",
 "rotary joint": "مفصل محوري, مفصل مداري (مفصل حر الحركة تقتصر فيه الحركة على الدوران)\nمثال: مفصل الكعبرة والزند في الذراع هو مفصل محوري",
 "rotary motion": "تدوير, دوران (عملية الدوران كما لو كان على محور)\nمثال: دوران الراقص حافظ على التزامن مع الموسيقى",
 "rotary press": "مكبس دوار (مكبس طباعة للطباعة من أسطوانة دوارة)",
 "rotary wing": "جناح دوار, شفرة دوارة (السطح الانسيابي الطويل الذي يدور لتوفير الرفع الذي يدعم طائرة الهليكوبتر في الهواء)",
 "rotatable": "قَابِلٌ لِلدَّوَرَان (يُمْكِنُ إِدَارَتُهُ حَوْلَ مِحْوَرِه)",
 "rotate": "أَدَارَ (دَارَ نصف دورة فقط؛ الشيء: جعله يدور؛ فعل تعدّي من دَارَ)\nمثال: أدار فاضل مقبض الباب بهدوء و دخل إلى المنزل.",
 "rotated": "دَائِر, مُدَوَّر (أُدير في دائرة حول محور)",
 "rotating mechanism": "آلية دوارة (آلية تدور)",
 "rotating shaft": "عمود دوار, عمود نقل الحركة (قضيب دوار ينقل الطاقة أو الحركة)",
 "rotation": "دَوْرَة (في غرب العراق على نهر الفرات قرب الحدود السورية؛ حَيّ في جنوب بغداد تقع فيه محطة تكرير للنفط تسمّى بإسمه)\nمثال: خضع زيد لدورة مكثفة",
 "rotational": "دوراني (من أو متعلق بالدوران)\nمثال: قصور ذاتي دوراني",
 "rotational latency": "كمون الدوران ((في علم الحاسوب) الوقت الذي يستغرقه كتلة بيانات محددة على مسار البيانات للدوران نحو رأس القراءة/الكتابة)",
 "rotational nystagmus": "رأرأة دورانية (رأرأة ناجمة عن دوران الجسم بسرعة؛ تكون الحركات البطيئة الكبيرة لمقل العيون في اتجاه الدوران)",
 "rotationally": "دورانياً, دورياً (بطريقة دورانية)\nمثال: يتم العثور على خطوط التأثير المطلوبة عن طريق تعريض النموذج لإزاحات صغيرة أفقياً وعمودياً ودورانياً",
 "rotator cuff": "كُفَّة مُدَوَّرَة",
 "rotatory": "تدويري, دوراني (من أو يتعلق بالدوران المحوري أو المداري أو يسببه)",
 "rotatory joint": "مفصل محوري, مفصل مداري (مفصل حر الحركة تقتصر فيه الحركة على الدوران)\nمثال: مفصل الكعبرة والزند في الذراع هو مفصل محوري",
 "rotavirus": "فيروس روتا, فيروس عجلي (الفيروس الريوي المسبب لالتهاب الأمعاء عند الرضع)",
 "rotc": "فيلق تدريب ضباط الاحتياط (برنامج تدريبي لإعداد طلاب الجامعات ليصبحوا ضباطًا مفوضين)",
 "rote": "تلقين, حفظ عن ظهر قلب (الحفظ عن طريق التكرار)",
 "rote learning": "تلقين, حفظ عن ظهر قلب (الحفظ عن طريق التكرار)",
 "rotenone": "روتينون (مبيد حشري بلوري أبيض قليل السمية للثدييات؛ يستخدم في الحدائق المنزلية؛ يُستخرج من جذور نباتات الديريس والكيوبي)",
 "rotgut": "خمر فاسد, كحول رديء (أي مشروب كحولي ذو جودة رديئة)",
 "rotifer": "حيوان دولابي, دولابيات (كائنات دقيقة متعددة الخلايا مائية لها عضو مهدب يشبه العجلة للتغذية والحركة)",
 "rotisserie": "مشواة (مطعم متخصص في اللحوم المشوية والمشوية على الفحم) / شواية دوارة, مشواة (فرن أو شواية مجهزة بسيخ دوار يُطهى عليه اللحم أثناء دورانه)",
 "rotl": "رطل (وحدة وزن مستخدمة في بعض الدول الإسلامية القريبة من البحر المتوسط؛ تتراوح بين رطل واحد وخمسة أرطال)",
 "rotogravure": "حفر ضوئي, روتوجرافور (استخدام التصوير الفوتوغرافي لإنتاج لوحة للطباعة) / الطباعة الغائرة الدوارة (المواد المطبوعة (نصوص وصور) المنتجة بعملية طباعة غائرة في مطبعة دوارة) / روتوجرافور, طباعة دوارة غائرة (الطباعة عن طريق نقل صورة من لوح حفر ضوئي إلى أسطوانة في مطبعة دوارة)",
 "rotor": "عَمُود نَاقِل الْحَرَكَة",
 "rotor blade": "جناح دوار, شفرة دوارة (السطح الانسيابي الطويل الذي يدور لتوفير الرفع الذي يدعم طائرة الهليكوبتر في الهواء)",
 "rotor coil": "عضو دوار (عضو الإنتاج الدوار لمحرك أو مولد)",
 "rotor head": "رأس الدوار, عمود الدوار (المحور الذي يدور حوله الدوار الرئيسي لطائرة هليكوبتر)",
 "rotor shaft": "رأس الدوار, عمود الدوار (المحور الذي يدور حوله الدوار الرئيسي لطائرة هليكوبتر)",
 "rotted": "فَاسِد, مُتَعَفِّن (تضرّر بالتعفّن فأصبح غير سليم وغير صالح للاستعمال)",
 "rotten": "فَاسِد",
 "rotten borough": "دائرة عفنة (دائرة انتخابية برلمانية إنجليزية ذات عدد قليل من الناخبين (تاريخياً))",
 "rottenly": "بشكل سيء للغاية, بشكل فظيع (بطريقة فظيعة)\nمثال: تغني بشكل فظيع",
 "rottenness": "تَعَفُّن, نَتَانَة (صفة التعفن والتحول إلى شيء نتن) / تفسخ, نتانة (في حالة من التعفن التدريجي)",
 "rottenstone": "تريبولي, حجر متعفن (حجر جيري سيليسي متحلل ومتعرض للعوامل الجوية؛ يستخدم في شكل مسحوق في التلميع)",
 "rotter": "حقير, دنيء (شخص يُعتبر حقيراً أو مُزدرى)\nمثال: وحده الدنيء يفعل ذلك",
 "rotterdam": "روتردام",
 "rotting": "تحلل, تعفن ((في البيولوجيا) عملية التحلل الناجمة عن الفعل البكتيري أو الفطري)",
 "rottol": "رطل ((رَطَلَ) يَرْطُلُ رَطْلاً: عَدَا؛ (رَطَلَ) الشيءَ: رازَهُ بيدِهِ ليعرِفَ وزْنَهُ)",
 "rottweiler": "روت فايلر",
 "rotund": "بَدِين جِدًّا, سَمِين مُفْرِطًا (مُفْرِط فِي السِّمْنَة والبَدَانَة) / فَخْم, مُسْتَدِير ((للأصوات) ممتلئ وغني) / كُرَوِيّ, مُكَوَّر (كرويّ الشكل؛ مستدير تمامًا)",
 "rotunda": "روتندا, غرفة مستديرة (غرفة دائرية كبيرة) / روتندا (مبنى ذو تصميم دائري وقبة)",
 "rotundity": "تكور, كروية (استدارة جسم ثلاثي الأبعاد) / استدارة, رخامة (امتلاء نبرة الصوت)",
 "rotundly": "بجهورية, بصوت رنان (بطريقة ذات صوت عميق ورنان)\nمثال: تألف الحشد بشكل أساسي من قلة من الشباب الذين كانوا يغطون في نوم عميق بصوت شخير رنان",
 "rotundness": "تكور, كروية (استدارة جسم ثلاثي الأبعاد)",
 "rouble": "روبل (وحدة المال الأساسية في روسيا)",
 "roue": "فاسق (رجل منحل في المجتمع الراقي)",
 "rouen": "روان",
 "rouge": "أحمر خدود (مكياج يتكون من مسحوق وردي أو أحمر يوضع على الخدين)",
 "rouge et noir": "روج إي نوار (لعبة ورق يتم فيها توزيع صفين من الأوراق ويمكن للاعبين الرهان على لون الأوراق أو على الصف الذي سيكون له عد أقرب لعدد معين)",
 "rouge plant": "توت الدم, ريفينا (نبات منزلي شجيري له أزهار بيضاء إلى وردية شاحبة تليها عناقيد من التوت القرمزي؛ موطنه المناطق الاستوائية في الأمريكتين)",
 "rougeberry": "توت الدم, ريفينا (نبات منزلي شجيري له أزهار بيضاء إلى وردية شاحبة تليها عناقيد من التوت القرمزي؛ موطنه المناطق الاستوائية في الأمريكتين)",
 "rouged": "مُتَوَرِّد, مُحَمَّر (مُزَيَّنٌ بِاسْتِخْدَامِ أَنْوَاعِ أَحْمَرِ الشِّفَاه)",
 "rough": "خَشِن (صار خشناً أو غير ناعم؛ أصبح صلباً أو غليظ الملمس)\nمثال: زيري خشن الخلق.",
 "rough bindweed": "فشاغ خشن (نبات متسلق أو زاحف دائم الخضرة ذو سيقان متعرجة شائكة وأوراق لامعة وعناقيد من الزهور الخضراء الباهتة؛ جزر الكناري إلى جنوب أوروبا وإثيوبيا والهند)",
 "rough bristlegrass": "ذيل الثعلب الأخضر (ذيل ثعلب أوروبي متوطن في أمريكا الشمالية؛ غالباً ما يكون عشبة ضارة مزعجة)",
 "rough cut": "نسخة أولية (النسخة المطبوعة الأولى لفيلم بعد التحرير الأولي)",
 "rough drawing": "رسم أولي, مسودة (رسم تخطيطي أولي لتصميم أو صورة)",
 "rough fish": "سمك خشن (أي سمكة عديمة الفائدة للطعام أو الرياضة أو حتى كطعم)",
 "rough green snake": "ثعبان أخضر خشن (من جنوب وشرق الولايات المتحدة)",
 "rough horsetail": "ذيل الحصان الخشن, كنباث شتوي (ذيل حصان منتصب دائم الخضرة بسيقان خشنة الحواف؛ كان يستخدم سابقاً لتنظيف الأواني)",
 "rough pea": "بازلاء سنجلتاري, جلبان مشعر (نبات حولي شتوي ضعيف الساق موطنه منطقة البحر الأبيض المتوسط واستقر منذ فترة طويلة في جنوب الولايات المتحدة؛ يزرع كمحصول تغطية ومرعى)",
 "rough rider": "الخيالة المتطوعون, راوف رايدر (عضو في فوج الخيالة المتطوعين بقيادة ثيودور روزفلت في الحرب الإسبانية الأمريكية (1898))",
 "rough sledding": "مشقة, وقت عصيب (صعوبة يمكن التغلب عليها بالجهد)\nمثال: واجهنا وقتاً عصيباً للوصول إلى هنا",
 "rough water": "تلاطم, مياه هائجة (يُستخدم لوصف البحر أثناء الطقس القاسي أو العاصف)",
 "rough-and-ready": "عَمَلِيّ, فَعَّالٌ وَإِنْ بَسِيط (بسيط لكنّه فعّال للغرض المطلوب)",
 "rough-and-tumble": "تَشَابُك بِالأَيْدِي, عِرَاك (قتال غير منظم) / بِلَا قَوَاعِد, عَنِيف (يتسم بالفوضى في الفعل وتجاهل القواعد)",
 "rough-cut": "مَنْحُوتٌ بِخُشُونَة ((عَنِ الحَجَرِ أَوِ الخَشَبِ) مُشَكَّلٌ بِشَكْلٍ خَشِنٍ دُونَ تَشْطِيبٍ) / بَذِيءٌ, سُوقِيّ (يفتقر إلى الرقي أو الثقافة أو الذوق)",
 "rough-haired": "خَشِن الشَّعْر (ذو شعر ذي ملمس خشن)",
 "rough-leaved aster": "أستر خشن الأوراق",
 "rough-legged hawk": "حوام مسرول (صقر كبير من نصف الكرة الشمالي يتغذى بشكل رئيسي على القوارض الصغيرة وهو مفيد للمزارعين)",
 "rough-skinned newt": "سمندل خشن الجلد (سمندل من الساحل الرطب من ألاسكا إلى جنوب كاليفورنيا)",
 "rough-spoken": "فَظُّ الْكَلَامِ (خشن أو غليظ في الكلام)",
 "rough-stemmed goldenrod": "عصا الذهب خشنة الساق (ما يتخذ من خَشَب للتوكؤ أو الضرب؛ تطلق مجازا على عَظْم السَاق وعلى اللِسَان)\nمثال: لا تمسك العصا من الوسط.",
 "rough-textured": "خَشِنُ الْمَلْمَسِ (ذو ملمس خشن أو محبّب أو غير ناعم)",
 "roughage": "ألياف, ألياف غذائية (طعام نباتي خشن عسر الهضم منخفض العناصر الغذائية؛ كتلته تحفز التمعج المعوي)",
 "roughcast": "نموذج أولي, نموذج خشن (نموذج أولي تقريبي) / جص خشن, طرطشة (جص خشن لسطح الجدران الخارجية)",
 "roughdried": "مُجَفَّف بِلَا كَيّ ((للغسيل) مُجفّف لكنه غير مكويّ)",
 "roughened": "خَشِن, مُتَشَقِّق (متشقّق وخشن السطح بفعل الجفاف أو البرد)",
 "roughhewn": "مَنْحُوتٌ بِخُشُونَة ((عَنِ الحَجَرِ أَوِ الخَشَبِ) مُشَكَّلٌ بِشَكْلٍ خَشِنٍ دُونَ تَشْطِيبٍ)",
 "roughish": "خَشِنٌ نَوْعًا مَا (فيه شيء من الخشونة)",
 "roughleg": "حوام مسرول (صقر كبير من نصف الكرة الشمالي يتغذى بشكل رئيسي على القوارض الصغيرة وهو مفيد للمزارعين)",
 "roughly": "تقريباً, حوالي ((للكميات) غير دقيق ولكنه قريب جداً من الصواب) / بخشونة, بعنف (بحركة خشنة كما لو كان فوق سطح خشن) / بخشونة, بعنف (بخشونة أو عنف)\nمثال: استمر حوالي ساعة",
 "roughneck": "بلطجي, فتوة (رجل قاسٍ ووحشي)",
 "roughness": "خشونة, غلظة (كلام أو سلوك قاس أو شديد) / بَدَائِيَّة, خُشُونَة (صفة غير مصقولة وغير مهذبة) / خشونة, وعورة (ملمس سطح أو حافة ليس ناعماً بل غير منتظم ومتفاوت) / خُشُونَة, غِلْظَة (صفة كون الشيء قاسياً أو خشناً أو مزعجاً للحواس)\nمثال: يربط الرجال خشونة كلام الطبقة العاملة غير القياسي بالرجولة",
 "roughrider": "مروض الخيول البرية (فارس ماهر في ترويض الخيول البرية للسرج)",
 "roughshod": "بَاطِش, غَاشِم (مُتَسَلِّط بِظُلْم) / قَاسٍ, هَمَجِيّ ((عن الأشخاص أو أفعالهم) قادر على إلحاق الألم أو المعاناة أو مُيّال لذلك) / خَشِن النَّعْل ((عن الحصان) ذو حدوات بمسامير بارزة لمنع الانزلاق)",
 "roughtail stingray": "لخمة خشنة الذيل (واحدة من أكبر أسماك اللخمة؛ توجد من كيب كود إلى كيب هاتيراس)",
 "roulade": "رولاد, زخرفة صوتية ((موسيقى) تتابع متقن لعدة نغمات تغنى على مقطع لفظي واحد) / رولاد, لفافة اللحم (طبق يتكون من شريحة لحم ملفوفة حول حشوة ومطبوخة)",
 "rouleau": "لفة عملات (لفة من العملات المعدنية مغلفة بالورق) / لفة شريط (لفة من الشريط)",
 "roulette": "رُولِيت",
 "roulette ball": "كرة الروليت (الكرة المستخدمة للعب الروليت)",
 "roulette wheel": "عجلة الروليت (معدات لعب تتكون من عجلة ذات فتحات تستخدم للمقامرة؛ تدور العجلة أفقياً ويراهن اللاعبون على الفتحة التي ستتوقف فيها الكرة)",
 "roumanian": "روماني (من أو يتعلق بدولة رومانيا أو شعبها أو لغاتها أو يميزهم)\nمثال: موسيقى شعبية رومانية",
 "round": "مُسْتَدِير, مُدَوَّر (أدار جسمه باتجاه آخر؛ له شكل دَائِرِيّ) / مُسْتَدِير, كُرَوِيّ (أدار جسمه باتجاه آخر؛ له شكل دَائِرِيّ) / دَائِرَة (في : الشكل الهندسي الذي ليس له نقطة بداية ولا نهاية ويتكون من قَوْس مستمر؛ الهيئة أو الجهة التي تدير امرا ما) / جَوْلَة, مَرْحَلَة / دَوْرَة (في غرب العراق على نهر الفرات قرب الحدود السورية؛ حَيّ في جنوب بغداد تقع فيه محطة تكرير للنفط تسمّى بإسمه)\nمثال: رجاء ضع دائرة حول الجواب الصحيح.",
 "round angle": "زَاوِيَة تَامَّة",
 "round arch": "قوس مستدير (قوس مشكل في منحنى مستمر؛ سمة من سمات العمارة الرومانية)",
 "round bone": "عظم مستدير (عظام ذات شكل مستدير)",
 "round bracket": "أَقْوَاس, قَوْس",
 "round clam": "كواهوج (محار أمريكي صالح للأكل؛ استخدمت أصدافه الثقيلة كنقود من قبل بعض الهنود الأمريكيين) / بطلينوس صلب (بطلينوس دائري ذو قشرة صلبة من الساحل الأطلسي؛ بطلينوس كبير يستخدم عادة للحساء أو أطباق البطلينوس الأخرى)",
 "round dance": "رقص دائري (رقصة صالونات تتميز بحركة دورانية) / رقص حلقي, رقصة دائرية (رقصة شعبية؛ يشكل الراقصون دائرة)",
 "round dancing": "رقص دائري (رقصة صالونات تتميز بحركة دورانية)",
 "round file": "مبرد مستدير (مبرد ذو مقطع عرضي دائري؛ يستخدم لبرد الأجزاء الداخلية من الثقوب)",
 "round hand": "خط مستدير (أسلوب واضح من الكتابة المتصلة بمنحنيات دائرية كبيرة)",
 "round kumquat": "كمكوات مستدير, مارومي (شجيرة تحمل كمكوات مستدير الثمار)",
 "round ligament of the uterus": "رباط مدور للرحم (رباط متصل بالرحم على الجانبين أمام وأسفل فتحة قناة فالوب ويمر عبر القناة الأربية إلى الشفرين الكبيرين)",
 "round of drinks": "جولة, جولة مشروبات (حصة مشروبات تقدم لكل فرد في مجموعة)\nمثال: طلب جولة ثانية",
 "round of golf": "جولة غولف (نشاط لعب 18 حفرة غولف)\nمثال: تستغرق جولة الغولف حوالي 4 ساعات",
 "round robin": "رسالة جماعية, عريضة دائرية (رسالة موقعة من قبل عدد من الأشخاص) / دورة روبن, دوري الكل ضد الكل (بطولة يلعب فيها كل متسابق ضد كل متسابق آخر)",
 "round scad": "سكاد مستدير, سمكة السيجار (سمكة مغزلية صغيرة في غرب المحيط الأطلسي)",
 "round shape": "شكل مستدير (شكل منحني وبدون زوايا حادة)",
 "round shot": "كرة مدفع (مقذوف صلب كان يُطلق في العصور القديمة من مدفع)",
 "round steak": "شريحة الفخذ المدورة (قطعة لحم بقر قليلة الدهن من المنطقة بين الكفل والساق)",
 "round table": "مائدة مستديرة (اجتماع للأقران للمناقشة وتبادل وجهات النظر)\nمثال: مائدة مستديرة حول مستقبل الحوسبة",
 "round the bend": "مَخْبُول, مَعْتُوه ((غير رسمي) مصطلحات عامّيّة تصف الاضطراب العقليّ)",
 "round the clock": "على مدار الساعة (بلا توقف)\nمثال: عملت على مدار الساعة",
 "round top": "خيمة السيرك (خيمة قماشية لإيواء الجمهور في عرض السيرك)\nمثال: كان خائفاً من حريق في خيمة السيرك",
 "round trip": "ذهاب وعودة",
 "round whitefish": "سمك أبيض مستدير (سمكة بيضاء ذات ظهر برونزي؛ من شمال أمريكا الشمالية وسيبيريا)",
 "round window": "نافذة مدورة (نافذة تؤدي إلى القوقعة)",
 "round-arm": "بذراع ممدودة جانبياً (بأرجحة خارجية أو أفقية للذراع) / بِذِرَاع مُسْتَدِيرَة (بأرجحة الذراع عند مستوى الكتف في حركة دائرية)\nمثال: ضرب الكرة بذراع ممدودة جانبياً",
 "round-backed": "مُحْدَوْدِب, مُنْحَنِي الظَّهْر (ذو ظهر وكتفَين مُنحنيَين؛ غير منتصب)",
 "round-bottom": "مُسْتَدِير القَاع (له قاع مستدير الشكل)",
 "round-bottom flask": "قارورة مستديرة القاع (قارورة كروية ذات عنق ضيق)",
 "round-bottomed": "مُسْتَدِير القَاع (له قاع مستدير الشكل)",
 "round-eyed": "مُسْتَدِير العَيْنَيْن (ذو عينين كبيرتين مستديرتين مفتوحتين على وسعهما) / سَاذَج, طِفْلِيُّ البَرَاءَة (يُظهر بساطة طفوليّة وسذاجة في التصديق)",
 "round-faced": "مُسْتَدِير الوَجْه (ذو وجه مستدير)",
 "round-fruited": "ذُو ثِمَار مُسْتَدِيرَة (يَحْمِلُ ثِمَارًا مُسْتَدِيرَة الشَّكْل)",
 "round-headed leek": "كراث كروي الرأس (كراث من العالم القديم ببصلة كروية)",
 "round-leaved rein orchid": "سحلب اللجام مستدير الأوراق (سحلب له عنقود من الزهور البيضاء المخضرة الكبيرة على ساق زهرة واحدة تنمو بين ورقتين قاعديتين بيضاويتين أو مستديرتين ملقاتين على الأرض؛ من شمال أوريغون…)",
 "round-shouldered": "مُحْدَوْدِب, مُنْحَنِي الظَّهْر (ذو ظهر وكتفَين مُنحنيَين؛ غير منتصب)",
 "round-spored gyromitra": "جيروميترا كروية الأبواغ (جيروميترا بجزء خصب بني منتفخ وساق مخدد وردي وأبواغ مستديرة ملساء؛ يوجد على مخلفات الأخشاب الصلبة شرق السهول الكبرى)",
 "round-table conference": "مائدة مستديرة (اجتماع للأقران للمناقشة وتبادل وجهات النظر)\nمثال: مائدة مستديرة حول مستقبل الحوسبة",
 "round-tailed muskrat": "جرذ ماء فلوريدا, فأر المسك مستدير الذيل (من الأراضي الرطبة في فلوريدا)",
 "round-the-clock": "دُونَ تَوَقُّف, عَلَى مَدَارِ السَّاعَة (فِي جَمِيعِ الأَوْقَات؛ دُونَ انْقِطَاع)",
 "round-the-clock patrol": "دورية على مدار الساعة (دورية مستمرة بلا توقف)",
 "round-trip light time": "زمن الضوء ذهاباً وإياباً (الوقت المنقضي الذي تستغرقه الإشارة للسفر من الأرض إلى مركبة فضائية (أو جسم آخر) والعودة إلى نقطة البداية)",
 "round-trip ticket": "تذكرة ذهاب وعودة (تذكرة لمكان ما والعودة منه (عادة عبر نفس الطريق))",
 "roundabout": "دَوَّار (في : هي الدَار الكبيرة الفاخرة أو دار العُمْدَة. الجمع دُوَّارَات)\nمثال: كان لديها دوار.",
 "roundabout way": "تحويلة, طريق التفافي (طريق غير مباشر (خاصة الذي يستخدم مؤقتاً أثناء إغلاق الطريق الرئيسي))",
 "rounded": "مُدَوَّر (اسم فاعل من دَوَّرَ، الشخص الذي يُدَوِّر)\nمثال: هناك طاولة مدورة في غرفة الضيوف.",
 "rounded vowel": "صائت مدور, صائت مضموم ((لغويات) صائت يتم نطقه مع ضم الشفتين وتشكيل فتحة دائرية)",
 "roundedness": "استدارة, انتفاخ (الخاصية التي يمتلكها تحدب مستدير)",
 "roundel": "رونديل (شعار دائري) ((شعارات النبالة) شحنة على شكل دائرة مملوءة) / قرص واقٍ (قطعة مستديرة من الدرع الصفيحي تحمي الإبط) / روندل (الشكل الإنجليزي للروندو يحتوي على ثلاث ثلاثيات مع لازمة)\nمثال: رونديل مجوف",
 "roundelay": "روندلاي (أغنية يتم فيها تكرار سطر أو عبارة كلازمة)",
 "rounder": "أداة تدوير الحواف (أداة لتدوير الزوايا أو الحواف) / فاسق, ماجن (شخص منحل؛ عادة رجل غير منضبط أخلاقياً)",
 "rounders": "راوندرز (لعبة كرة إنجليزية تشبه البيسبول)",
 "roundhead": "صاحب الرأس المستدير (مؤيد للبرلمان وأوليفر كرومويل خلال الحرب الأهلية الإنجليزية) / عريض الرأس (شخص ذو رأس عريض وقصير)",
 "roundheaded": "قَصِير الرَّأْس, مُسْتَدِير الرَّأْس (ذُو رَأْسٍ عَرِيضٍ قَصِيرٍ (مُسْتَعْرِض الرَّأْس))",
 "roundhouse": "لكمة دائرية (لكمة خطافية توجه بأرجحة مبالغ فيها) / مستودع قاطرات دائري (مكان عمل يتكون من مبنى دائري لإصلاح القاطرات)",
 "rounding": "تَقْرِيب",
 "rounding error": "تقريب, خطأ التقريب ((رياضيات) خطأ في الحساب ينتج عن تقريب الأرقام إلى عدد مناسب من الخانات العشرية)\nمثال: كان الخطأ في الحساب يعزى إلى التقريب",
 "roundish": "شِبْهُ مُسْتَدِير (مستدير إلى حدٍّ ما في المظهر أو الشكل)",
 "roundly": "بِتَدْوِير, بِشَكْل مُسْتَدِير (بطريقة أو هيئة دائرية) / بِصَرَاحَة فَجَّة, بِفَظَاظَة (بطريقة مباشرة فظة)\nمثال: كانت نحيفة بشكل مستدير",
 "roundness": "استدارة, امتلاء (الخاصية الجسدية المتمثلة في الامتلاء والاستدارة) / استدارة (الخاصية التي يمتلكها خط أو سطح منحنٍ وغير ذي زوايا) / تقريب (صفة كون الأرقام مقربة (أعداد صحيحة)) / استدارة, رخامة (امتلاء نبرة الصوت)\nمثال: أعطانا النتائج بأرقام تقريبية",
 "roundsman": "عامل جولات (عامل ذكر موظف للقيام بجولات (لتسليم البضائع أو إجراء عمليات تفتيش وما إلى ذلك))",
 "roundsperson": "طوّاف (عامل يعمل للقيام بجولات (لتوصيل البضائع أو إجراء عمليات التفتيش وما إلى ذلك))",
 "roundswoman": "عاملة جولات (عاملة أنثى موظفة للقيام بجولات (لتسليم البضائع أو إجراء عمليات تفتيش وما إلى ذلك))",
 "roundtable": "مائدة مستديرة (اجتماع للأقران للمناقشة وتبادل وجهات النظر)\nمثال: مائدة مستديرة حول مستقبل الحوسبة",
 "roundup": "تجميع المشتبه بهم, حملة اعتقالات (التجميع المنهجي للمشتبه بهم من قبل الشرطة) / تجميع الماشية (نشاط جمع الماشية معاً لعدها أو وسمها أو بيعها) / جولة ملخصة, حصاد (قائمة ملخصة؛ كما في 'حصاد الأخبار')\nمثال: حملة اعتقالات جماعية للمشتبه بهم",
 "roundworm": "دودة أسطوانية, نيماتودا (ديدان غير مقسمة ذات جسم مستدير ممدود مدبب من كلا الطرفين؛ معظمها حرة المعيشة ولكن بعضها طفيلي)",
 "rouser": "موقظ (شخص يوقظ الآخرين من النوم)",
 "rousing": "إثارة, إيقاظ (فعل الإثارة أو الاستنهاض) / حَمَاسِيّ, مُحَفِّز (يحثّ على النشاط أو يُصَعِّد الفعل كأنّه يَحْفِز ويَدْفَع) / حَمَاسِيّ, مُلْهِم (قادر على إثارة الحماس أو الإثارة)\nمثال: الهدف من الفن هو إثارة العواطف",
 "rousseauan": "روسوي (متعلق بالفيلسوف الفرنسي جان جاك روسو أو مميز له)",
 "roustabout": "عامل سطح السفينة (عضو في طاقم السفينة يؤدي عملاً يدوياً)",
 "rout": "دحر, هزيمة منكرة (هزيمة ساحقة) / رعاع, غوغاء (حشد غير منظم من الناس)",
 "route": "طَرِيق, مَسار (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من ٱلشَّارِعِ، سَبِيل)\nمثال: أسأل عن الطريق.",
 "routemarch": "مسير تدريبي (مسير تدريبي طويل للقوات)",
 "router": "راوْتَر, مُوَجَّه",
 "router plane": "مِسْحَج التوجيه, مِسْحَج الحفر (مسحج نجارة برأس قطع ضيق يصنع أخاديد ذات قيعان ناعمة)",
 "routine": "رُوتِين",
 "routinely": "بشكل روتيني (وفقاً للروتين أو الممارسة المتبعة)\nمثال: ركن سيارته بشكل روتيني في منطقة ممنوع الوقوف",
 "routineness": "رُوتِينِيَّة (حالة أو صفة كون الشيء روتينياً، وامتلاك سمات كونه يومياً، وتكرار نمط بانتظام)",
 "roux": "رو (خليط من الدهن والدقيق يسخن ويستخدم كأساس للصلصات)",
 "rove beetle": "خنفساء رواغة (خنفساء نشطة عادة ما تكون لها عادات افتراسية أو رمية (تتغذى على الجيف))",
 "rover": "جَوَّال, قائِد كَشْفِيّ (عضو بالغ في حركة الكشافة) / جوال, متشرد (شخص يعيش حياة تجوال غير مستقرة)",
 "rovigo": "روفيغو, رفيغة",
 "roving": "تجوال, هيام (السفر دون وجهة واضحة) / بَدَوِيّ, رَحَّال (يتنقّل من مكان لآخر دون استقرار)\nمثال: تبعته في ترحاله واعتنت به",
 "roving frame": "آلة البرم, إطار السرعة (آلة نسيج تحول الشريط المسحوب إلى خيط مبروم (فتيل))\nمثال: تعطي آلات البرم الشريط المرقق قدراً صغيراً من الالتواء لضمان القوة المطلوبة للفتيل",
 "row": "صَفّ (سَطْر مستقيم؛ مستوى تعليمي) / جَدَّفَ (معنى الفعل في سياقات متعددة تتراوح بين الطيران والسير، وحتى في الدلالات المجازية كالرمي والقطع؛ الفعل له معانٍ متعددة: رمي (كالسماء بالبرد)، الإسراع في المشي، كفر بالنعم وعدم الرضا بها، ودفع السفينة بالمجاديف) / تَجْدِيف\nمثال: صف كليتي وقلبي‎.",
 "row house": "تاون هاوس, منزل متلاصق (منزل هو واحد من صف من المنازل المتطابقة الواقعة جنباً إلى جنب وتشترك في جدران مشتركة)",
 "row of bricks": "صف طوب (طبقة من الطوب توضع بجانب بعضها البعض (عادة في خط مستقيم))",
 "rowan": "غُبَيْرَاء, غُبَيْرَاء أُورُوبِّيَّة (تصغير غَبْرَاء، وهي الأرض ومؤنث أغْبَر ووأنثى الحجل؛ نبات أو ثمرته)",
 "rowan berry vodka": "فودكا التوت البري (مشروب قوي مصنوع من منقوع التوت البري (الروان) مع إضافة الكراميل الطبيعي وتقطير النبيذ وتقطير الفاكهة)\nمثال: فودكا التوت البري تتماشى جيداً مع لحم الصيد",
 "rowan tree": "روان, شجرة الروان (شجرة أوراسية ذات ثمار تشبه التوت برتقالية حمراء)",
 "rowan vodka": "فودكا التوت البري (مشروب قوي مصنوع من منقوع التوت البري (الروان) مع إضافة الكراميل الطبيعي وتقطير النبيذ وتقطير الفاكهة)\nمثال: فودكا التوت البري تتماشى جيداً مع لحم الصيد",
 "rowanberry": "ثمرة الروان, ثمرة الغبيراء (فاكهة حمراء زخرفية تشبه التوت لشجرة الغبيراء)",
 "rowanberry vodka": "فودكا التوت البري (مشروب قوي مصنوع من منقوع التوت البري (الروان) مع إضافة الكراميل الطبيعي وتقطير النبيذ وتقطير الفاكهة)\nمثال: فودكا التوت البري تتماشى جيداً مع لحم الصيد",
 "rowboat": "زَوْرَق",
 "rowdily": "بشغب, بصخب (بطريقة صاخبة ومشاغبة)\nمثال: سكر الحشد وبدأوا في التصرف بصخب",
 "rowdiness": "خشونة, سلوك أهوج (سلوك مشاغب)",
 "rowdy": "صَخَّاب, مُشَاغِب (يُخِلّ بالسلام العام؛ صاخب وخشن) / بلطجي, فتوة (رجل قاسٍ ووحشي)",
 "rowdyism": "خشونة, سلوك أهوج (سلوك مشاغب)",
 "rowel": "عجلة المهماز (عجلة صغيرة مسننة في نهاية المهماز)",
 "rower": "مجدّف (شخص يجدف قارباً)",
 "rowing": "تَجْدِيف",
 "rowing boat": "قارب تجديف (قارب تجديف)",
 "rowing club": "نادي التجديف (نادي للمجدفين)",
 "rowlock": "مسند المجداف, وتد المجداف (حامل مثبت على حافة القارب يثبت المجداف في مكانه ويعمل كنقطة ارتكاز للتجديف)",
 "rowlock arch": "قوس صفوف (قوس يتكون من أكثر من صف متحد المركز من أحجار العقد)",
 "royal": "مَلَكِيّ, قَيْصَرِيّ",
 "royal academy": "الأكاديمية الملكية, الأكاديمية الملكية للفنون (أكاديمية فخرية في لندن (تأسست عام 1768) تهدف إلى زراعة الرسم والنحت والهندسة المعمارية في بريطانيا)",
 "royal academy of arts": "الأكاديمية الملكية, الأكاديمية الملكية للفنون (أكاديمية فخرية في لندن (تأسست عام 1768) تهدف إلى زراعة الرسم والنحت والهندسة المعمارية في بريطانيا)",
 "royal agaric": "أمانيت قيصري, غاريقون ملكي (فطر صالح للأكل واسع الانتشار يشبه فطر الذباب)",
 "royal air force": "سلاح الجو الملكي (القوات الجوية لبريطانيا العظمى)",
 "royal blue": "أزرق أرجواني, أزرق ملكي (درجة من الأزرق مشوبة بالأرجواني)",
 "royal brace": "حبل توجيه الصاري الملكي (حبل لتأمين الصاري الملكي)",
 "royal canadian mounted police": "شرطة الخيالة الكندية الملكية (قوة الشرطة الفيدرالية لكندا)",
 "royal casino": "رويال كازينو (شكل من أشكال الكازينو يكون لأوراق الصور فيه قيم نقاط إضافية)",
 "royal charter": "مرسوم ملكي, ميثاق ملكي (ميثاق ممنوح من قبل السيادة (خاصة في بريطانيا العظمى))",
 "royal colony": "مستعمرة التاج (مستعمرة بريطانية يسيطر عليها التاج البريطاني، يمثلها حاكم)",
 "royal court": "بلاط ملكي, ديوان (صاحب السيادة ومستشاروه الذين يمثلون القوة الحاكمة للدولة) / بلاط, بلاط ملكي (عائلة وحاشية ملك أو أمير)",
 "royal family": "عَائِلَة مَلِكِيَّة (اسم فاعل من الفعل عَالَ؛ مؤنث عَائِل؛ إحدى طبقات الأنساب وهي آخرها دون الفصيلة وتشمل ثلاث أجيال من جد واحد: الجد والأبناء وأبناء الأبناء)\nمثال: هو طفل العائلة.",
 "royal fern": "أسمندة ملكية, سرخس ملكي (سرخس كبير عميق الجذور واسع الانتشار عالمياً بسعف مركب ثنائي الريش منتصب)",
 "royal flush": "تسلسل ملكي, رويال فلاش (يد بوكر تحتوي على الآس والملك والملكة والولد والعشرة، جميعها من نفس النقشة)",
 "royal house": "عائلة مالكة, ملوك (الأشخاص الملكيون بشكل جماعي)\nمثال: حضر الزفاف أفراد من العائلة المالكة",
 "royal jelly": "غِذَاء مَلَكِيّ, غِذَاء مَلِكَات",
 "royal line": "عائلة مالكة, ملوك (الأشخاص الملكيون بشكل جماعي)\nمثال: حضر الزفاف أفراد من العائلة المالكة",
 "royal mast": "الصاري الملوكي",
 "royal national eisteddfod": "الإستيدفود الوطني الملكي (مهرجان إستيدفود يتضمن مسابقات في الموسيقى والدراما والشعر والفنون الجميلة)",
 "royal osmund": "أسمندة ملكية, سرخس ملكي (سرخس كبير عميق الجذور واسع الانتشار عالمياً بسعف مركب ثنائي الريش منتصب)",
 "royal palm": "نخيل ملكي (نخيل ريشي طويل من جنوب فلوريدا وكوبا)",
 "royal penguin": "بِطْرِيق مَلَكِيّ",
 "royal poinciana": "بوانسيانا ملكية, زهرة الطاووس (شجرة استوائية مبهرجة أو شجيرة موطنها مدغشقر؛ تزرع على نطاق واسع في المناطق الاستوائية لعناقيدها الضخمة من الزهور القرمزية والبرتقالية؛ تصنف أحياناً…)",
 "royal purple": "أرجواني محمر (درجة من الأرجواني مشوبة بالأحمر)",
 "royal road": "طريق ملكي, طريق ممهد (طريقة أو وسيلة مميزة وسهلة لتحقيق شيء ما)\nمثال: الطريق الممهد للنجاح",
 "royal society": "الجمعية الملكية (جمعية إنجليزية فخرية (تم إضفاء الطابع الرسمي عليها في عام 1660 ومنحها تشارلز الثاني ميثاقاً ملكياً في عام 1662) دعمت الحكومة البريطانية من خلالها…)",
 "royal society of london for improving natural knowledge": "الجمعية الملكية (جمعية إنجليزية فخرية (تم إضفاء الطابع الرسمي عليها في عام 1660 ومنحها تشارلز الثاني ميثاقاً ملكياً في عام 1662) دعمت الحكومة البريطانية من خلالها…)",
 "royal stag": "أيل ملكي (أيل بقرون ذات 12 فرعاً أو أكثر)",
 "royal tennis": "تنس ملكي (شكل قديم من التنس يُلعب في ملعب ذي أربعة جدران)",
 "royal velvet plant": "جينورا برتقالية, نبات المخمل (نبات ورقي جاوي يُزرع لأوراقه المخملية الجميلة ذات الشعيرات البنفسجية الأرجوانية)",
 "royal yard": "عارضة الصاري الملوكي (عارضة الصاري الملوكي، التي يُنصب عليها الشراع الملوكي، تلي الصاري المزركش من الأعلى)\nمثال: عوارض الأمير ويليام الملوكية هي أعلى وأصغر العوارض على السفينة، وهي مصنوعة من الخشب، وهي 'عوارض رفع' يمكن رفعها على طول قسم من الصاري",
 "royalism": "ملكية, موالاة للملكية (التمسك أو الولاء لنظام ملكي أو لمبدأ الحكومة الملكية)",
 "royalist": "فارس ملكي (مؤيد ملكي لتشارلز الأول خلال الحرب الأهلية الإنجليزية) / ملكي (مدافع عن مبادئ الملكية)",
 "royally": "ملكياً (بطريقة ملكية)\nمثال: عوملوا معاملة ملكية",
 "royalty": "مَلَكِيَّة",
 "roystonea oleracea": "رويستونيا, نخيل الملفوف (نخيل من جزر الهند الغربية ببراعم أوراق صالحة للأكل عندما تكون صغيرة)",
 "roystonea regia": "نخيل ملكي (نخيل ريشي طويل من جنوب فلوريدا وكوبا)",
 "rozelle": "حميض أحمر, غجر (عشبة سنوية شائكة قليلاً من شرق الهند أو شجيرة معمرة تزرع على نطاق واسع لكؤوسها اللحمية المستخدمة في الفطائر والهلام ولألياف اللحاء)",
 "rpm": "دَوْرَة فِي الدَّقِيقَة (معدل دوران المحرك)\nمثال: كان المحرك يقوم بـ 6000 دورة",
 "rtlt": "زمن الضوء ذهاباً وإياباً (الوقت المنقضي الذي تستغرقه الإشارة للسفر من الأرض إلى مركبة فضائية (أو جسم آخر) والعودة إلى نقطة البداية)",
 "ru": "روثينيوم (عنصر فلزي نادر متعدد التكافؤ من مجموعة البلاتين)",
 "ru 486": "حبوب الإجهاض, ميفيبريستون",
 "ruandan": "رواندي (من أو متعلق برواندا)\nمثال: جبال رواندية",
 "rub": "حَكَّ, فَرَكَ (مَرَّرَ شَيْئًا عَلَى شَيْءٍ آخَرَ بِقُوَّةٍ لِيُزِيلَ مَا عَلَيْهِ؛ حَكَّ جلدَه : فركه بأظفاره)\nمثال: لقد حك سامي كعبه حتى بدأ ينزف.",
 "rub up": "مراجعة سريعة (مراجعة تنعش ذاكرتك)\nمثال: أحتاج إلى مراجعة سريعة للاتينيتي",
 "rub-a-dub": "قرع الطبل (الصوت الناتج عن ضرب الطبل)",
 "rubato": "روباتو (وتيرة مرنة؛ ليست صارمة على الإيقاع)",
 "rubber": "مَطَّاط",
 "rubber band": "شريط مطاطي (شريط ضيق من المطاط المرن يستخدم لتثبيت الأشياء (مثل الأوراق) معاً)",
 "rubber boa": "أصلة مطاطية (أصلة تعيش في المراعي والغابات في غرب أمريكا الشمالية؛ تبدو وتشعر وكأنها مطاطية ولها ذيل ورأس متشابهان في الشكل)",
 "rubber boot": "جزمة مطاطية (حذاء طويل مصنوع من المطاط)",
 "rubber bullet": "رصاصة مطاطية (رصاصة مصنوعة من المطاط الصلب؛ مصممة للاستخدام في السيطرة على الحشود)",
 "rubber cement": "أسمنت مطاطي (مادة لاصقة مصنوعة عن طريق إذابة المطاط غير المفلكن في مذيب مثل البنزين أو النفثا)",
 "rubber eraser": "أستيكة, ممحاة مطاطية (ممحاة مصنوعة من المطاط (أو مادة اصطناعية)؛ تثبت عادة في أحد طرفي قلم الرصاص)",
 "rubber plant": "شجرة المطاط, فيكس (شجرة آسيوية استوائية كبيرة تقزم غالباً كنبات منزلي؛ مصدر لمطاط آسام)",
 "rubber stamp": "خَتْم مَطَّاطِيّ (أنهى الشيءَ وأتمّه؛ طبع بخاتم أو ختم رسميّ)\nمثال: ختم سامي القرآن في شهر رمضان.",
 "rubber tire": "إطار سيارة (إطار يتكون من حلقة مطاطية حول حافة عجلة السيارة)",
 "rubber-base paint": "طلاء اللاتكس (طلاء مائي يحتوي على مادة رابطة من اللاتكس)",
 "rubber-necking": "سياحة, مشاهدة المعالم (التجول للنظر إلى الأماكن ذات الأهمية)",
 "rubberlike": "مَطَّاطِيّ (له قوام مرن يُشبه المطّاط في ليونته أو صلابته)",
 "rubberneck": "فضولي, متطفل (شخص يحدق بفضول) / متجول سياحي, متنزه (سائح يزور المعالم السياحية)",
 "rubbernecker": "فضولي, متطفل (شخص يحدق بفضول)",
 "rubbery": "مَطَّاطِيّ (له قوام مرن يُشبه المطّاط في ليونته أو صلابته) / غُضْرُوفِيّ, مَطَّاطِيّ (صعب المضغ كالغضروف)",
 "rubbing": "احتكاك, فرك (الجهد المبذول في تحريك جسم فوق آخر مع الضغط) / طبع بالفرك (تمثيل يتكون من نسخة (كما لنقش) مصنوعة بوضع ورقة فوق شيء ما وفركها بالفحم) / احتكاك (المقاومة التي يتم مواجهتها عند تحريك جسم متلامس مع آخر)",
 "rubbing alcohol": "كحول طبي, كحول محمر (غسول يتكون من محلول سام من كحول الأيزوبروبيل أو الإيثانول المحول للاستخدام الخارجي)",
 "rubbish": "تُرَّهَات, كَلَام تَافِه (حديث أو كتابة لا معنى لها) / قمامة, نفايات (مادة عديمة القيمة يجب التخلص منها)",
 "rubbish dump": "مزبلة, مقلب قمامة (قطعة أرض يتم فيها تفريغ مواد النفايات)",
 "rubbish heap": "كومة خردة, كومة قمامة (تراكم للنفايات والمواد المهملة)",
 "rubbishy": "رَخِيصٌ وَرَدِيء (رَخِيصٌ وَدُونِيّ؛ بِلَا قِيمَة)",
 "rubble": "أَنْقَاض, رُكام",
 "rubdown": "تدليك بالفرك, فرك الجسم (فعل الفرك، عادة من أجل الاسترخاء أو لأغراض طبية)",
 "rube": "فلاح ساذج, قروي بسيط (شخص ليس ذكياً جداً أو غير مهتم بالثقافة)",
 "rubefacient": "دواء محمر للجلد (دواء للاستخدام الخارجي ينتج احمراراً في الجلد)",
 "rubel": "روبل (وحدة المال الأساسية في بيلاروسيا)",
 "rubella": "حصبة ألمانية (مرض فيروسي معدٍ هو شكل أخف من الحصبة يستمر ثلاثة أو أربعة أيام؛ يمكن أن يضر بالجنين خلال الأشهر الثلاثة الأولى)",
 "rubella panencephalitis": "التهاب الدماغ الشامل الحصبوي (فقدان نادر للمهارات العقلية والبدنية لدى المراهقين؛ يرتبط بفيروس الحصبة الألمانية)",
 "rubeola": "حصبة (مرض فيروسي حاد وشديد العدوى يتميز ببقع حمراء مميزة يتبعها طفح جلدي)",
 "rubia cordifolia": "فوة هندية, منجيت (عشب زاحف أو متسلق معمر من شرق الهند يستخدم للصباغة في الشرق)",
 "rubia tinctorum": "فوة الصباغين (عشب أوراسي له زهور صفراء صغيرة وجذور حمراء كانت مصدراً مهماً لصبغة الأليزارين سابقاً)",
 "rubiaceous plant": "فصيلة فوية, نبات فوي (أي من الأشجار أو الشجيرات أو الكروم العديدة من الفصيلة الفوية)",
 "rubicelle": "روبيسيل (نوع أصفر أو برتقالي من ياقوت الإسبنيل)",
 "rubicon": "روبيكون, نقطة اللاعودة (خط عند تجاوزه لا يسمح بالعودة ويؤدي عادة إلى التزام لا رجعة فيه)",
 "rubicund": "أَحْمَر الوَجْه, مُحْمَرّ (ذو بَشَرَة حَمْراء مُشْرِقَة تَدُلّ عَلى صِحَّة جَيِّدَة)",
 "rubidium": "رُوبِيدِيُوم",
 "rubidium-strontium dating": "تأريخ بالروبيديوم والسترونشيوم (تأريخ جيولوجي يعتمد على نسب الروبيديوم المشع إلى ناتج تحلله السترونشيوم)",
 "rubik's cube": "مُكَعَّب رُوبِيك",
 "rubin test": "اختبار روبين (اختبار لتحديد سالكية أو انسداد قناتي فالوب)",
 "ruble": "رُوبْل",
 "rubor": "التهاب (استجابة أنسجة الجسم للإصابة أو التهيج؛ تتميز بالألم والتورم والاحمرار والحرارة)",
 "rubric": "باب, تصنيف (اسم فئة أو تصنيف) / باب, عنوان بارز (عنوان أو ترويسة مطبوعة باللون الأحمر أو بخط خاص) / باب, عنوان (عنوان يسمي قانوناً أو مشروع قانون تشريعي؛ قد يعطي ملخصاً موجزاً للمسائل التي يتناولها) / قَاعِدَة, مَبْدَأ تَوْجِيهِيّ (قاعدة سلوك أو إجراء ذات سلطة)\nمثال: تتم مناقشته عادة تحت عنوان 'السمنة الوظيفية'",
 "rubus australis": "شجيرة المحامي, محامي الأدغال (شجيرة زاحفة قوية الساق من نيوزيلندا تتسلق فوق النمو الآخر)",
 "rubus caesius": "ديوبيري أوروبي (عليق أوروبي زاحف يحمل الديوبيري)",
 "rubus canadensis": "ديوبيري أمريكي (ديوبيري من أمريكا الشمالية)",
 "rubus chamaemorus": "توت السحاب, توت الغيم (توت شوكي زاحف من المناطق المعتدلة الشمالية بتوت أصفر أو برتقالي)",
 "rubus cissoides": "شجيرة المحامي, محامي الأدغال (شجيرة زاحفة قوية الساق من نيوزيلندا تتسلق فوق النمو الآخر)",
 "rubus cuneifolius": "عليق رملي (عليق شجيري صلب من شرق الولايات المتحدة (كونيتيكت إلى فلوريدا))",
 "rubus flagellaris": "ديوبيري شمالي",
 "rubus fruticosus": "توت العليق, عليق حقيقي (العليق الحقيقي لأوروبا وكذلك أي من العديد من الأصناف التي لها توت أسود أو أرجواني داكن حلو صالح للأكل)",
 "rubus hispidus": "ديوبيري المستنقعات",
 "rubus idaeus": "توت العليق الأوروبي, توت العليق البري (توت العليق الأوروبي الشائع؛ الفاكهة حمراء أو برتقالية)",
 "rubus idaeus strigosus": "توت العليق الأمريكي (توت العليق الأحمر من أمريكا الشمالية)",
 "rubus loganobaccus": "لوغانبيري (عليق أحمر الثمار موطنه من أوريغون إلى باجا كاليفورنيا)",
 "rubus occidentalis": "توت العليق الأسود (توت شوكي موطنه شرق أمريكا الشمالية له فاكهة سوداء على شكل كشتبان)",
 "rubus odoratus": "توت العليق المزهر (توت شوكي شجيري من شرق أمريكا الشمالية له زهور وردية إلى أرجوانية ملفتة للنظر وفاكهة حمراء أو برتقالية على شكل كشتبان)",
 "rubus parviflorus": "توت السلمون, توت الكشتبان (توت شوكي أبيض الزهور من غرب أمريكا الشمالية وشمال المكسيك بتوت برتقالي على شكل كشتبان)",
 "rubus phoenicolasius": "توت النبيذ (توت شوكي من الصين واليابان له زهور وردية شاحبة يزرع للزينة ولثماره الحمراء الصغيرة الحامضة)",
 "rubus saxatilis": "عليق الحجر (عليق زاحف أوروبي بثمار تشبه التوت الأحمر)",
 "rubus spectabilis": "توت السلمون (توت شوكي كبير منتصب أحمر الزهور من غرب أمريكا الشمالية له توت برتقالي وردي كبير)",
 "rubus strigosus": "توت العليق الأمريكي (توت العليق الأحمر من أمريكا الشمالية)",
 "rubus trivialis": "ديوبيري جنوبي (من جنوب أمريكا الشمالية)",
 "rubus ursinus": "عليق غربي (عليق أمريكي بفاكهة سوداء مستطيلة)",
 "rubus ursinus loganobaccus": "لوغانبيري (عليق أحمر الثمار موطنه من أوريغون إلى باجا كاليفورنيا)",
 "ruby": "يَاقُوت",
 "ruby spinel": "ياقوت إسبنيل (إسبنيل يستخدم كحجر كريم (عادة أحمر داكن))",
 "ruby wood": "خشب الصندل الأحمر, خشب ياقوتي (خشب متين صلب لأشجار خشب الصندل الأحمر؛ يُقدر للخزائن)",
 "ruby-crowned kinglet": "صعوة ياقوتية التاج (صعوة أمريكية ذات أغنية مميزة وبقعة تاج حمراء لدى الذكر)",
 "ruby-crowned wren": "صعوة ياقوتية التاج (صعوة أمريكية ذات أغنية مميزة وبقعة تاج حمراء لدى الذكر)",
 "ruby-red": "أَحْمَر, قِرْمِزِيّ (بلون في نهاية الطيف اللوني قرب البرتقالي؛ يشبه لون الدم أو الكرز أو الياقوت)",
 "ruck": "دهماء, عامة (حشد خاصة من الأشخاص أو الأشياء العادية أو غير المتميزة) / تجعد, كشكشة (طية غير منتظمة في سطح مستوٍ خلاف ذلك (كما في القماش))\nمثال: رفعته عبقريته فوق العامة",
 "rucksack": "حقيبة ظهر, حقيبة محمولة على الظهر (حقيبة تُحمل بحزام على الظهر أو الكتف)",
 "ruckus": "جلبة, صخب (فعل إحداث اضطراب صاخب)",
 "ruction": "جلبة, صخب (فعل إحداث اضطراب صاخب)",
 "rudaceous rock": "صخر حصوي (صخر رسوبي تشكل من مادة خشنة الحبيبات)",
 "rudapithecus": "رودابيثكس (أشباه بشر أحفورية من شمال وسط المجر؛ أواخر العصر الميوسيني)",
 "rudbeckia hirta": "رودبيكيا, سوزان سوداء العينين (زهرة ولاية ماريلاند؛ من وسط وجنوب شرق الولايات المتحدة؛ ذات زهور تشبه الأقحوان بمراكز داكنة وأشعة صفراء إلى برتقالية)",
 "rudbeckia laciniata": "زهرة المخروط مقطوعة الأوراق (نبات ورقي طويل بفروع منتصبة تنتهي برؤوس زهور صفراء كبيرة بأشعة مقوسة لأسفل؛ ينمو في جبال روكي جنوباً إلى أريزونا وشرقاً إلى ساحل المحيط الأطلسي)",
 "rudbeckia laciniata hortensia": "توهج ذهبي (عشب متفرع طويل جداً برؤوس زهور صفراء مزدوجة كثيرة ملفتة للنظر)",
 "rudbeckia serotina": "رودبيكيا, سوزان سوداء العينين (زهرة ولاية ماريلاند؛ من وسط وجنوب شرق الولايات المتحدة؛ ذات زهور تشبه الأقحوان بمراكز داكنة وأشعة صفراء إلى برتقالية)",
 "rudd": "رُود",
 "rudder": "دَفَّة, سُكَّان / سُكَّان, دَفَّة",
 "rudder blade": "شفرة الدفة (الشفرة العمودية على الدفة)",
 "rudder-like": "دَفَّاتِيّ الشَّكْل (على شكل دفّة ويعمل عملها)",
 "rudderfish": "سمكة الدفة (سمكة لها عادة تتبع السفن؛ توجد في المياه الساحلية لأمريكا الشمالية والجنوبية) / شوب برمودا (سمكة غذائية ورياضية حول برمودا وفلوريدا؛ تتبع السفن غالباً)",
 "rudderless": "تَائِه, هَائِم (يسير بلا وجهة ولا اتّجاه محدّد)",
 "rudderpost": "عمود الدفة (عمود رأسي عند الحافة الأمامية للدفة يتيح للدفة أن تدور)",
 "rudderstock": "عمود الدفة (عمود رأسي عند الحافة الأمامية للدفة يتيح للدفة أن تدور)",
 "ruddiness": "احمرار, تورد (بشرة محمرة صحية)",
 "ruddle": "حجر تعليم أحمر, مغرة حمراء (خام حديد أحمر يستخدم في الصباغة ووضع العلامات)",
 "ruddles": "آذريون, أقحوان الذهب (القطيفة السنوية الأوروبية الشائعة)",
 "ruddy": "أَحْمَر, قِرْمِزِيّ (بلون في نهاية الطيف اللوني قرب البرتقالي؛ يشبه لون الدم أو الكرز أو الياقوت) / أَحْمَر الوَجْه, مُحْمَرّ (ذو بَشَرَة حَمْراء مُشْرِقَة تَدُلّ عَلى صِحَّة جَيِّدَة)",
 "ruddy duck": "بطة حمراء, بطة رودي (بطة صلبة الذيل بنية محمرة من أمريكا الشمالية وشمال أمريكا الجنوبية)",
 "ruddy turnstone": "قنبرة الماء (قنبرة ماء قطبية شائعة تشتي في أمريكا الجنوبية وأستراليا)",
 "rude": "فَظّ",
 "rudely": "بلا أدب, بوقاحة (بطريقة غير مؤدبة)\nمثال: عاملها بوقاحة",
 "rudeness": "فجاجة, قلة أدب (أسلوب وقح ومهين) / بدائية, خشونة (حالة برية أو غير مهذبة)",
 "rudiment": "بدائية, عضو أثري (بقايا جزء من الجسم كان وظيفيًا في مرحلة مبكرة من الحياة أو التطور)\nمثال: رتج ميكل هو بقايا كيس المح الجنيني",
 "rudimentary": "أَوَّلِيّ, بِدَائِيّ (في أبكر مراحل التطوّر والنموّ) / أَثَرِيّ, بِدَائِيّ (لَمْ يَتَطَوَّرْ بِالكَامِلِ فِي الكَائِنَاتِ البَالِغَة) / أَسَاسِيّ, جَذْرِيّ (يتعلّق بالحقائق أو المبادئ الأساسية أو يتضمّنها)",
 "rudiments": "ألفباء, مبادئ أولية (المراحل الأولية لأي موضوع) / أساسيات, مبادئ أولية (بيان بالحقائق أو المبادئ الأساسية)\nمثال: أتقن فقط مبادئ الهندسة الأولية",
 "rudolph": "رُودُولْف",
 "rue": "سُذَاب, فَيْجَن",
 "rue anemone": "شقائق نعمان السذاب (زهرة غابات موطنها شرق أمريكا الشمالية لها زهور على شكل كوب تذكرنا بشقائق النعمان ولكنها أكثر رقة)",
 "rueful": "تَائِب, نَادِم (يَشْعُرُ بِالأَلَمِ أَوِ النَّدَمِ عَلَى الذُّنُوبِ أَوِ الآثَام)",
 "ruefully": "بأسف, بندم (مع شعور بالندم)\nمثال: قال بأسف: 'ارتكبت خطأ كبيراً'",
 "ruefulness": "أسف, ندم (حزن مرتبط بخطأ ارتكب أو خيبة أمل)\nمثال: شرب ليغرق أحزانه",
 "ruff": "دريجة شرسة",
 "ruffed grouse": "طيهوج مطوق (يُقدر كطائر صيد في شرق الولايات المتحدة وكندا)",
 "ruffian": "بلطجي, فتوة (رجل قاسٍ ووحشي)",
 "ruffianism": "بلطجة, زعرنة (سلوك عنيف خارج عن القانون)",
 "ruffianly": "بَلْطَجِيّ, فَظّ (عَنِيفٌ وَخَارِجٌ عَنِ القَانُون)",
 "ruffle": "شِجَار عَلَنِيّ, عِرَاك (قتال صاخب) / طوق مكشكش, ياقة عالية (ياقة عالية وضيقة) / كشكشة, هدب (شريط من القماش المثني يُستخدم كزينة أو حاشية)",
 "ruffled": "ذُو كَشَاكِش, مُكَشْكَش (ذو كشاكش أو حواشٍ زخرفية) / مُتَمَوِّج (مُهتزّ على شكل موجات أو تموّجات بفعل الرياح)",
 "rufous rubber cup": "كأس مطاطي محمر (نوع من ساركوسوماتاسيا (جاليلا روفا))",
 "rug": "سَجَّادَة",
 "rug beater": "مضرب السجاد, منفضة السجاد (أداة لضرب الغبار لإخراجه من السجاد)",
 "rug merchant": "تاجر سجاد (تاجر يبيع السجاد)",
 "rug pad": "بطانة السجاد (لبادة توضع تحت السجادة)",
 "ruga": "غضن ((في التشريح) طية أو تجعد أو ثنية)\nمثال: غضون المعدة",
 "rugby": "رَغْبِي, رَجْبِي",
 "rugby ball": "كرة الرجبي (كرة بيضاوية منفوخة تستخدم في لعب الرجبي)",
 "rugby football": "رغبي (شكل من أشكال كرة القدم تُلعب بكرة بيضاوية)",
 "rugel's plantain": "لسان الحمل روجيل (نبات لسان حمل أمريكي شمالي له أعناق أوراق محمرة وأوراق عريضة)",
 "rugelach": "روغلاخ (معجنات مصنوعة من عجينة الجبن الكريمي وحشوات مختلفة (مثل الزبيب والجوز والقرفة أو الشوكولاتة والجوز ومربى المشمش))",
 "rugged": "قوي, متين (قوي ومتين في البنية أو البناء؛ دائم التحمل) / شَرِس, قَاسٍ (بَالِغ الصُّعُوبَة؛ يَخْتَبِر القُدْرَة عَلَى التَّحَمُّل بِشِدَّة) / مُتَكَسِّر, وَعِر (غير مستوٍ وخشن السطح) / متجعد, مخدد (به انخفاضات ضحلة ضيقة طويلة (كالأخاديد أو التجاعيد) في السطح)\nمثال: مع منزل مليء بالأولاد، يجب أن يكون لديك أثاث متين",
 "rugged individualism": "الفردانية الصارمة, الفردية القوية (الفردانية في الشؤون الاجتماعية والاقتصادية؛ الإيمان ليس فقط بالحرية الشخصية والاعتماد على الذات بل أيضاً بالمنافسة الحرة)",
 "ruggedisation": "تخشين, تقوية (فعل جعل قطعة من المعدات قوية (تقويتها لمقاومة التآكل أو سوء الاستخدام))",
 "ruggedization": "تخشين, تقوية (فعل جعل قطعة من المعدات قوية (تقويتها لمقاومة التآكل أو سوء الاستخدام))",
 "ruggedly": "بصلابة, بوعورة (بطريقة وعرة)",
 "ruggedness": "صعوبة, وعورة (صفة الصعوبة في القيام بالشيء) / خُشُونَة التَّضَارِيس, وُعُورَة (صفة عدم الاستواء الطوبوغرافي (الجغرافي)) / خشونة, قوة (خاصية كون الشخص كبيراً وقوياً)\nمثال: كلف بسلسلة من المسائل متزايدة الصعوبة",
 "ruggelach": "روغلاخ (معجنات مصنوعة من عجينة الجبن الكريمي وحشوات مختلفة (مثل الزبيب والجوز والقرفة أو الشوكولاتة والجوز ومربى المشمش))",
 "rugger": "رغبي (شكل من أشكال كرة القدم تُلعب بكرة بيضاوية)",
 "rugose": "مُتَغَضِّن (كثير التجاعيد والغضون على السطح)",
 "rugulah": "روغلاخ (معجنات مصنوعة من عجينة الجبن الكريمي وحشوات مختلفة (مثل الزبيب والجوز والقرفة أو الشوكولاتة والجوز ومربى المشمش))",
 "ruhr": "رُورْ, حَوْضُ اُلْرُورْ",
 "ruhr area": "حوض الرور (حَوَّضَ: عمِل حوضًا؛ حَوَّضَ (الماءَ): حاضَه)\nمثال: ملأت الحوض ماءا.",
 "ruin": "خَرَاب, خَرَابَة / دَمَّرَ",
 "ruination": "إفساد, تخريب (التدمير المتحقق عن طريق تحطيم الشيء أو إفساده) / دمار, سقوط (فشل يؤدي إلى فقدان المنصب أو السمعة) / خراب, دمار (حدث يؤدي إلى التدمير) / خراب, هلاك (حالة دمار وتدمير لا يمكن إصلاحها)\nمثال: لقد جلبت الخراب على هذه العائلة بأكملها",
 "ruined": "خَرِب, مُنْتَهٍ (أُوصِلَ إِلَى الخَرَاب) / خَرِب, مُدَمَّر (مُدمَّر جسدياً أو أخلاقياً) / مُنْتَهٍ, هَالِك (محكوم عليه بالفناء والزوال)",
 "ruiner": "مخرب, مدمر (شخص يدمر أو يخرب)\nمثال: مدمر للبيئة",
 "ruining": "إفساد, تخريب (التدمير المتحقق عن طريق تحطيم الشيء أو إفساده)",
 "ruinous": "كَارِثِيّ, مُهْلِك (يُسَبِّبُ الأَذَى أَوِ الآفَةَ؛ يُصِيبُ بِعُنْفٍ مُفَاجِئٍ أَوْ وَبَاءٍ) / كارِثِيّ, مُدَمِّر (يُسَبِّب دَمارًا شامِلًا أو خَرابًا بالِغًا)",
 "ruinously": "بشكل كارثي, بشكل مدمر (بطريقة مهلكة أو إلى درجة تسبب الخراب)\nمثال: أجور مرتفعة بشكل مدمر",
 "ruinousness": "إِهْلَاك, تَدْمِير (الصفة المسببة للخراب أو التي تميل إليه)",
 "rule": "قَانُون, قَاعِدَة (مقياس كل شيء وطريقه؛ أمر كليّ ينطبق على جميع جزئياته التي تعرف أحكامها منه) / حُكْم, حُكُومَة (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ) / حَكَمَ (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ)\nمثال: ذكرني بالقانون.",
 "rule book": "كتاب القواعد, كتيب القواعد (مجموعة من القواعد أو المعايير المحددة التي يتم اتخاذ القرارات بناءً عليها)\nمثال: إنهم يديرون الأمور حسب الكتاب (القواعد) هنا",
 "rule of cy pres": "مبدأ التقريب (قاعدة تنص على أنه عندما يكون الامتثال الحرفي مستحيلاً، يجب تنفيذ نية المانح أو الموصي قدر الإمكان)",
 "rule of evidence": "قَاعِدَة إِثْبَات, قَانُون الْأَدِلَّة ((قانون) قاعدة قانونية يتم بموجبها إثبات أو دحض أي واقعة مزعومة مقدمة للتحقيق في محاكمة قضائية)",
 "rule of grammar": "قاعدة نحوية (قاعدة لغوية لبناء الجمل النحوية)",
 "rule of law": "سيادة القانون (حالة من النظام تتوافق فيها الأحداث مع القانون)",
 "rule of morphology": "قاعدة صرفية (قاعدة لغوية لتكوين الكلمات)",
 "rule of thumb": "قَاعِدَة عَامَّة",
 "rule-governed": "قَانُونِيّ, مَحْكُومٌ بِقَوَاعِدَ (وفقاً للعرف أو القاعدة أو القانون الطبيعي)",
 "ruled": "خَاضِع لِلْحُكْم, مَحْكُوم (يخضع لسلطة حاكمة)",
 "ruled surface": "سطح مسطر (سطح يتولد عن طريق خط مستقيم متحرك بحيث يمكن رسم خط يقع بالكامل في السطح من خلال كل نقطة على السطح)\nمثال: في الهندسة الجبرية، تم تعريف الأسطح المسطرة في الأصل على أنها أسطح إسقاطية في الفضاء الإسقاطي تحتوي على خط مستقيم يمر عبر أي نقطة معطاة",
 "ruler": "مِسْطَرَة (أداة تستخدم لقياس الأطوال أو رسم الخطوط المستقيمة؛ خط مستقيم تحدده مِسطَرة أو بُعد محدد) / حَاكِم (حَاكَمَ القاضي فلانا: أقام عليه محكمة ليرى ما إذا كان مجرما أم لا؛ حَاكَمَ فلانٌ فلانا: رفع عليه قضية؛ اشتكى عليه عند القضاء فأقاموا محكمة للحكم في الأمر)\nمثال: استعارت المسطرة.",
 "rulership": "حكم, سلطة الحاكم (منصب الحاكم)",
 "rules of order": "إِجْرَاءَات بَرْلَمَانِيَّة, قَوَاعِد النِّظَام (مجموعة من القواعد تتبعها جمعية أو هيئة تشريعية)",
 "ruling": "حَاكِم (حَاكَمَ القاضي فلانا: أقام عليه محكمة ليرى ما إذا كان مجرما أم لا؛ حَاكَمَ فلانٌ فلانا: رفع عليه قضية؛ اشتكى عليه عند القضاء فأقاموا محكمة للحكم في الأمر)\nمثال: ميت رومني هو حاكم ولاية ماساتشوستس.",
 "ruling class": "أصحاب السلطة, الطبقة الحاكمة (فئة الناس التي تمارس السلطة أو الحكم)",
