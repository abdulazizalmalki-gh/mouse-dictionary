 "schematization": "تخطيط, نمذجة (عملية التقليل إلى مخطط أو صيغة) / تخطيط, رسم بياني (توفير مخطط أو هيكل لنظام ما)",
 "scheme": "مَكِيدَة",
 "scheme arch": "قوس ناقص (قوس ارتفاعه أقل من نصف عرضه)",
 "schemer": "متآمر, مُدَبِّر (مخطط يضع خطة عمل شخصية)",
 "scheming": "مُحْتَال, مُدَبِّر (يُخفي خططًا ماكرة لتحقيق مصلحته الشخصيّة) / داهِيَة, مُتَآمِر (حاذِق في التَّدْبير والتَّخْطيط بِمَكْر وحِيلَة)",
 "schemozzle": "فوضى, ورطة ((يديشية) موقف أو شأن مربك؛ فوضى)",
 "schengen": "شينجن, شينغن",
 "scheol": "الجحيم, العالم السفلي ((الأديان) عالم الموتى)\nمثال: لا أحد يذهب إلى هاديس بكل ثروته الهائلة",
 "scherzo": "سكيِرتسو (حركة سريعة (عادة في زمن ثلاثي))",
 "schick test": "اختبار شيك (اختبار جلدي للمناعة ضد الدفتيريا)",
 "schiller": "شِيلَر",
 "schilling": "شلن, شلن نمساوي (سابقاً وحدة المال الأساسية في النمسا)",
 "schinus chichita": "شينوس تيربينثيفوليا, فلفل برازيلي (شجرة راتنجية صغيرة أو شجيرة من البرازيل)",
 "schinus molle": "شجرة الفلفل, شينوس مولي (نبات بيروفي دائم الخضرة صغير ذو رأس عريض مستدير وفروع متدلية رفيعة مع عناقيد جذابة من الزهور المخضرة تليها عناقيد من الثمار الوردية)",
 "schinus terebinthifolia": "شينوس تيربينثيفوليا, فلفل برازيلي (شجرة راتنجية صغيرة أو شجيرة من البرازيل)",
 "schipperke": "شيبركي (سلالة من الكلاب السوداء الصغيرة الممتلئة كانت تستخدم في الأصل ككلاب حراسة على القوارب في هولندا وبلجيكا)",
 "schism": "اِنْقِسَام, اِنْفِصَال / اِنْشِقَاق (انشقّ:انصدع،والفجر:طلع وظهر،والبرق:لمع،والرّأي:تبدّد اختلافاً،ويُقال:انشقّت عصا الجماعة:تفرّقوا؛ انشقّ الشّيء انشقاقاً:انْفَلَق،انْصَدَعَ،أو انقسم ، قال تعالى)",
 "schismatic": "اِنْشِقَاقِيّ",
 "schismatical": "انشقاقي (من أو متعلق بـ أو متورط في أو مميز للانشقاق (الديني))\nمثال: طوائف انشقاقية",
 "schismatically": "انشقاقياً (بطريقة انشقاقية)",
 "schist": "شيست (أي صخر متحول يمكن شقه إلى طبقات رقيقة)",
 "schistorrhachis": "السنسنة المشقوقة, الصلب المشقوق (عيب خلقي غير نادر تتشوه فيه فقرة؛ ما لم تتأثر عدة فقرات أو يكون هناك قيلة نخاعية سحائية، تكون الأعراض قليلة؛ يمكن تشخيصه عن طريق بزل السلى)",
 "schistosome": "بلهارسيا, منشقة (ديدان مفلطحة تتطفل في الأوعية الدموية للثدييات)",
 "schistosome dermatitis": "التهاب الجلد المنشق, حكة السباحين (تفاعل تحسسي لغزو الجلد المتكرر بواسطة مذنبات المنشقات (طفيليات))",
 "schistosomiasis": "بلهارسيا, داء البلهارسيات (عدوى طفيلية تسببها طفيليات من جنس البلهارسيا؛ شائعة في المناطق الاستوائية والشرق الأقصى)",
 "schizachyrium scoparium": "عشبة البراري, عشبة لحية المكنسة (عشبة أمريكية شمالية قوية التحمل جميلة تتحول أوراقها إلى البرونزي الشاحب في الخريف)",
 "schizaea pusilla": "سرخس العشب المجعد, عشب مجعد (سرخس صغير نادر في شمال شرق أمريكا الشمالية له العديد من السعف الحلزونية الرفيعة ويشكل خصلات كثيفة)",
 "schizanthus": "أوركيد الفقراء, زهرة الفراشة (أي نبات من جنس شيزانثوس ذو أوراق مقسمة بدقة وزهور مبهرجة متنوعة الألوان)",
 "schizocarp": "ثمرة منشقة (فاكهة جافة متفتحة تنشق عند النضج إلى جزأين أو أكثر لكل منهما بذرة واحدة)",
 "schizogony": "تكاثر انشطاري (تكاثر لاجنسي عن طريق الانشطار المتعدد؛ سمة من سمات العديد من البروتوزوا البوغية)",
 "schizoid": "شِيزُويْدِيّ, فُصَامِيّ (يتسم بالانطواء والعجز عن تكوين علاقات وثيقة) / شيزودي, فصامي (من أو متعلق بـ أو مميز للفصام) / شبه فصامية, شخصية فصامية النوع (تتميز بأعراض تشبه الفصام ولكنها أقل حدة)",
 "schizopetalon": "شيزوبيتالون (نبات حولي أنيق من أمريكا الجنوبية له أوراق ريشية عميقة وعناقيد من الزهور البيضاء الأرجوانية المهدبة برائحة اللوز)",
 "schizopetalon walkeri": "شيزوبيتالون (نبات حولي أنيق من أمريكا الجنوبية له أوراق ريشية عميقة وعناقيد من الزهور البيضاء الأرجوانية المهدبة برائحة اللوز)",
 "schizophragma hydrangeoides": "شيزوفراجما, كوبية متسلقة (شجيرة متسلقة بجذور هوائية لاصقة لها أوراق متقابلة وزهور بيضاء صغيرة في سيمات طرفية؛ من الهيمالايا إلى تايوان واليابان)",
 "schizophrenia": "فُصَام, الْفِصَام الذُّهَانِيّ",
 "schizophrenic": "فُصَامِيّ (مصاب بنوع من أنواع الفصام) / شيزودي, فصامي (من أو متعلق بـ أو مميز للفصام) / فُصامِيّ, مُصاب بِالفُصام (شخص مصاب بالفصام (شيزوفرينيا))",
 "schizophrenic disorder": "شيزوفرينيا, فصام (أي من الاضطرابات الذهانية العديدة التي تتميز بتشوهات الواقع واضطرابات التفكير واللغة والانسحاب من التواصل الاجتماعي)",
 "schizophrenic psychosis": "شيزوفرينيا, فصام (أي من الاضطرابات الذهانية العديدة التي تتميز بتشوهات الواقع واضطرابات التفكير واللغة والانسحاب من التواصل الاجتماعي)",
 "schizophyta": "الانشطاريات, قسم الانشطاريات",
 "schizothymia": "فصامية المزاج (يشبه الفصام ولكنه يبقى ضمن حدود الطبيعية)",
 "schizotypal personality": "شبه فصامية, شخصية فصامية النوع (تتميز بأعراض تشبه الفصام ولكنها أقل حدة)",
 "schlemiel": "أخرق, سيء الحظ ((اليديشية) شخص غبي يرتكب الأخطاء بشكل اعتيادي)",
 "schlemm's canal": "قناة شليم (قناة دائرية في العين تصرف الخلط المائي من الغرفة الأمامية للعين إلى الأوردة الهدبية الأمامية)",
 "schlep": "رحلة متعبة (رحلة مملة أو صعبة) / أخرق, فوضوي ((اليديشية) شخص محرج وغبي)",
 "schlepper": "أخرق, فوضوي ((اليديشية) شخص محرج وغبي)",
 "schlimazel": "سَيِّئ الحَظّ جِدّاً, مَنْحُوس (شخص سيء الحظ للغاية أو غير كفء يفشل في كل شيء)",
 "schlock": "بضاعة رديئة, خردة (بضائع رخيصة أو ذات جودة متدنية)",
 "schlockmeister": "تاجر بضائع رديئة ((عامية) تاجر يتعامل في بضائع رديئة أو منخفضة الجودة)",
 "schlumbergera baridgesii": "صبار عيد الميلاد (صبار نباتي (هوائي) من أصل برازيلي يزرع على نطاق واسع كنبات منزلي له قطع مسطحة مفصلية وعادة أزهار وردية أرجوانية تتفتح في الشتاء)",
 "schlumbergera buckleyi": "صبار عيد الميلاد (صبار نباتي (هوائي) من أصل برازيلي يزرع على نطاق واسع كنبات منزلي له قطع مسطحة مفصلية وعادة أزهار وردية أرجوانية تتفتح في الشتاء)",
 "schlumbergera gaertneri": "صبار الفصح (صبار من أمريكا الجنوبية يزهر في الربيع بمفاصل مستطيلة وأزهار حمراء مرجانية)",
 "schlumbergera truncatus": "صبار السلطعون, صبار عيد الشكر (صبار مفصلي من أمريكا الجنوبية ذو أزهار حمراء عادة؛ غالباً ما يزرع كنبات منزلي)",
 "schmaltz": "عاطفية مبتذلة ((اليديشية) عاطفية مفرطة في الفن أو الموسيقى)",
 "schmaltzy": "رَكِيكُ الحِسّ, مُبْتَذَلُ العَاطِفَة (مُفرِط في العاطفة بشكل مُتصنَّع أو غير صادق)",
 "schmalz": "عاطفية مبتذلة ((اليديشية) عاطفية مفرطة في الفن أو الموسيقى)",
 "schmalzy": "رَكِيكُ الحِسّ, مُبْتَذَلُ العَاطِفَة (مُفرِط في العاطفة بشكل مُتصنَّع أو غير صادق)",
 "schmear": "شملة, مجموعة كاملة ((يديشية) دفعة من الأشياء التي تأتي معاً)\nمثال: اشترى المجموعة بالكامل",
 "schmeer": "شملة, مجموعة كاملة ((يديشية) دفعة من الأشياء التي تأتي معاً)\nمثال: اشترى المجموعة بالكامل",
 "schmegegge": "شْمِيغِيغِي, هُرَاء ((اليديشية) هراء؛ كلام ساخن؛ لا معنى له)",
 "schmidt camera": "تلسكوب شميدت, كاميرا شميدت (تلسكوب عاكس يحتوي على لوحة تصحح الزيغ بحيث يمكن تصوير مساحة واسعة من السماء)",
 "schmidt telescope": "تلسكوب شميدت, كاميرا شميدت (تلسكوب عاكس يحتوي على لوحة تصحح الزيغ بحيث يمكن تصوير مساحة واسعة من السماء)",
 "schmo": "أحمق, مغفل ((اليديشية) أحمق)",
 "schmoose": "حديث ودي, دردشة (محادثة غير رسمية)",
 "schmooze": "حديث ودي, دردشة (محادثة غير رسمية)",
 "schmoozer": "بارع في الحديث, محاور (شخص ماهر في المحادثة)",
 "schmuck": "أحمق, مغفل ((اليديشية) أحمق)",
 "schnapps": "شَنَبْص",
 "schnaps": "شنابس (أي من المشروبات القوية المتنوعة، خاصة الروح الهولندية المقطرة من البطاطس)",
 "schnauzer": "شناوزر (سلالة ألمانية قديمة من التيريير القوي ذو الشعر السلكي الأسود أو الرمادي، له خطم غير حاد ويتراوح حجمه من الصغير إلى الكبير جداً؛ يستخدم كصائد للجرذان…)",
 "schnecken": "كعكة العسل, كعكة لزجة (عجين ملفوف مدهون بالسكر والمكسرات ثم يقطع ويخبز في قوالب مافن مع العسل أو السكر والزبدة في القاع)",
 "schnittlaugh": "ثوم معمر (نبات معمر له أوراق أسطوانية مجوفة تستخدم للتتبيل)",
 "schnitzel": "شْنِيتْزَل",
 "schnook": "ساذج, مغفل ((اليديشية) شخص بسيط ساذج يستحق الشفقة أكثر من الاحتقار)\nمثال: لا تكن مغفلاً كثير الاعتذار",
 "schnorchel": "أنبوب التنفس, سنوركل (ممر هوائي يوفره جهاز قابل للسحب يحتوي على أنابيب سحب وعادم؛ يسمح للغواصة بالبقاء تحت الماء لفترات طويلة)",
 "schnorkel": "أنبوب التنفس, سنوركل (ممر هوائي يوفره جهاز قابل للسحب يحتوي على أنابيب سحب وعادم؛ يسمح للغواصة بالبقاء تحت الماء لفترات طويلة)",
 "schnorrer": "شَحَّاذ, مُتَطَفِّل ((في الثقافة اليديشية) متطفل يستغل كرم الآخرين)",
 "schnoz": "أنف, منقار (مصطلحات غير رسمية للأنف)",
 "schnozzle": "أنف, منقار (مصطلحات غير رسمية للأنف)",
 "schola cantorum": "مدرسة الجوقة (مدرسة تكون جزءاً من كاتدرائية أو دير حيث يمكن للأولاد الذين لديهم قدرة على الغناء الحصول على تعليم عام)",
 "scholar": "عَالِم (الذي يعلم؛ متخصص في عِلْم ما وباحث فيه)\nمثال: هو عالم أحيائي.",
 "scholar's mate": "ضَرْبَة الرَاعِي, خطة نابليون (المرة الواحدة من الضَرْب؛ اللطمو أو الدقة أو الصكّة؛ ضربة طبل: دقة واحدة منه)\nمثال: تلقى مناد ضربة.",
 "scholarly": "أكاديمي, بحثي (من سمات العلماء أو البحث العلمي)\nمثال: أعمال بحثية",
 "scholarly person": "باحث, عالم (شخص متعلم؛ شخص اكتسب التمكن في تخصص واحد أو أكثر من خلال الدراسة الطويلة)",
 "scholarship": "مِنْحَة دِرَاسِيَّة, إِعَانَة دِرَاسِيَّة",
 "scholastic": "دراسي, مدرسي (مكون من أو متعلق بالمدارس) / سكولاستي, مدرسي (مكون من أو متعلق بالمذهب الفلسفي للمدرسية (السكولاستية)) / متحذلق, متفيهق (شخص يولي اهتماماً مفرطاً للقواعد الرسمية والمعرفة الكتبية أكثر مما تستحق) / سكولاستي, مدرسي (فيلسوف أو لاهوتي مدرسي (سكولاستي))\nمثال: سنة دراسية",
 "scholastically": "دراسياً, مدرسياً (فيما يتعلق بالأنشطة الدراسية)\nمثال: مؤهل دراسياً",
 "scholasticism": "سُكُولَائِيَّة, مَدْرَسِيَّة (أرثوذكسية من النوع المدرسي (السكولائي)) / سكولاستية, مدرسية (نظام الفلسفة السائد في أوروبا في العصور الوسطى؛ استند إلى أرسطو وآباء الكنيسة)",
 "scholia": "تعليق هامشي, شرح (ملاحظة هامشية يكتبها شارح (معلق على الأدب القديم أو الكلاسيكي))",
 "scholiast": "شارح الهوامش, مفسر (عالم يكتب ملاحظات توضيحية عن مؤلف (خاصة معلق قديم على مؤلف كلاسيكي))",
 "scholium": "تعليق هامشي, شرح (ملاحظة هامشية يكتبها شارح (معلق على الأدب القديم أو الكلاسيكي))",
 "schollaert channel": "قناة شولارت",
 "scholz": "شُولْتْس",
 "school": "مَدْرَسَة, مَكْتَب (الموضع الذي تُدَرَّس فيه العلوم؛ البناء فيه عدة غرف تُدَرَّسُ فيها العلوم وتمنح شهادة رسمية بعد إكمال الدروس) / كُلِّيَّة, جَامِعَة (مصدر صناعيّ من كُلّ؛ شمول، مجموع من الأوّل إلى الآخر) / قِسِم (فَرَّقَ أو قَسَّمَ الشَّيءَ إلى أجزاء أو أجزاء مختلفة؛ أَحْلَفَ، أَي جَعَلَ يَحْلِفُ على أمرٍ ما) / مَدْرَسَة (الموضع الذي تُدَرَّس فيه العلوم؛ البناء فيه عدة غرف تُدَرَّسُ فيها العلوم وتمنح شهادة رسمية بعد إكمال الدروس)\nمثال: لا أحب المدرسة.",
 "school assignment": "عمل منزلي, واجب مدرسي (عمل، مثل العمل المدرسي أو العمل بالقطعة، يتم في المنزل)",
 "school bell": "جرس المدرسة (جرس يُدق للإعلان عن بدء أو انتهاء الحصة)",
 "school board": "مجلس التعليم, مجلس المدرسة (مجلس مسؤول عن المدارس العامة المحلية)",
 "school bus": "حافلة مدرسية (حافلة تستخدم لنقل الأطفال من وإلى المدرسة)",
 "school crossing": "معبر مدارس (معبر مشاة يعبر فيه تلاميذ المدارس الشارع في طريقهم إلى المدرسة)",
 "school day": "دوام مدرسي, يوم دراسي (فترة التدريس في المدرسة؛ الفترة الزمنية التي تكون فيها المدرسة في حالة انعقاد) / يوم دراسي (أي يوم تكون فيه المدرسة في حالة انعقاد)\nمثال: ابق بعد الدوام المدرسي",
 "school dictionary": "قاموس المتعلم (قاموس مكتوب خصيصاً لمن يتعلمون لغة أجنبية)",
 "school district": "منطقة تعليمية (منطقة تدار مدارسها العامة معاً)",
 "school newspaper": "صحيفة مدرسية (صحيفة يكتبها وينشرها طلاب في مدرسة)",
 "school of dentistry": "كلية طب الأسنان (كلية دراسات عليا تقدم دراسة تؤدي إلى درجات علمية في طب الأسنان)",
 "school of law": "كلية الحقوق, كلية القانون (كلية دراسات عليا تقدم دراسة تؤدي إلى درجة في القانون)",
 "school of medicine": "كلية الطب (كلية دراسات عليا تقدم دراسة تؤدي إلى درجة طبية)",
 "school of music": "مدرسة موسيقى (مدرسة لدراسة الموسيقى)",
 "school of nursing": "كلية التمريض, مدرسة التمريض (مدرسة لتدريب الممرضات)",
 "school of thought": "عقيدة, فلسفة (معتقد (أو نظام معتقدات) مقبول كسلطة من قبل مجموعة أو مدرسة ما)",
 "school paper": "صحيفة مدرسية (صحيفة يكتبها وينشرها طلاب في مدرسة)",
 "school phobia": "رهاب المدرسة (خوف الطفل المفاجئ من الذهاب إلى المدرسة)",
 "school principal": "مدير مدرسة (المربي الذي لديه سلطة تنفيذية لمدرسة)\nمثال: أرسلت التلاميذ المشاغبين لرؤية المدير",
 "school ship": "سفينة تدريب (سفينة تستخدم لتدريب الطلاب كبحارة)",
