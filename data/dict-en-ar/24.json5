 "scour": "مجرف, مكان محفور (مكان تم حفره (خاصة بالمياه الجارية))",
 "scoured": "مَنْحُوت, مُتَآكِل (مُتَآكِلٌ بِفِعْلِ المَاءِ أَوِ الجَلِيدِ أَوِ الرِّيَاحِ)",
 "scourer": "جوال, مستكشف (شخص يسافر على نطاق واسع وبنشاط) / جليّ, منظف بالفرك (شخص ينظف عن طريق الفرك)\nمثال: كان جوالاً في البحار السبعة",
 "scourge": "سوط / وباء, بَلْوَى (المرض العام الذي ينتشر بين الناس)\nمثال: على السلطات أن توقف انتشار الوباء.",
 "scourger": "جلاد, سياط (معذب يقوم بجلد أو ضرب الضحايا بالسوط (خاصة كمسؤول رسمي))",
 "scouring": "جلي, دعك (فعل تنظيف سطح بفركه بفرشاة وصابون وماء) / تمشيط (التحرك عبر منطقة للبحث عن شيء ما)\nمثال: تمشيط المنطقة بأكملها لم يكشف عن شيء",
 "scouring pad": "سلك مواعين, ليفة خشنة (وسادة تنظيف كاشطة صغيرة تستخدم لتنظيف القدور والمقالي)",
 "scouring rush": "ذيل الحصان الخشن, كنباث شتوي (ذيل حصان منتصب دائم الخضرة بسيقان خشنة الحواف؛ كان يستخدم سابقاً لتنظيف الأواني)",
 "scours": "إسهال الماشية (إسهال في الماشية)",
 "scouse": "سكاوس, لابسكس (يخنة من اللحم والخضروات والخبز الجاف (القرشلة) يأكلها البحارة)",
 "scouser": "ليفربولي (مواطن أو مقيم في ليفربول)",
 "scout": "كَشَّاف",
 "scout car": "مركبة استطلاع (مركبة عسكرية مدرعة سريعة ذات دفع رباعي وسقف مفتوح)",
 "scout group": "فرقة كشافة (وحدة من الكشافة)",
 "scout troop": "فرقة كشافة (وحدة من الكشافة)",
 "scouter": "جَوَّال, قائِد كَشْفِيّ (عضو بالغ في حركة الكشافة)",
 "scouting": "استكشاف (الاستكشاف من أجل الحصول على معلومات)\nمثال: الاستكشاف في أراضي العدو خطير جداً",
 "scouting organization": "منظمة كشفية (منظمة تابعة للحركة الكشفية)\nمثال: حافظت دول مثل الولايات المتحدة على منظمات كشفية منفصلة للأولاد والبنات",
 "scouting trip": "رحلة استكشافية (بعثة تهدف للحصول على معلومات)",
 "scoutmaster": "قائد كشفي (قائد فرقة من الكشافة)",
 "scow": "صندل مسطح (صندل يحمل مواد سائبة في عنبر مفتوح) / قارب مسطح (أي من القوارب المتنوعة مسطحة القاع ذات النهايات المائلة)",
 "scowl": "عُبُوس / عَبَسَ",
 "scowling": "عَابِس, مُقَطِّب الجَبِين (كَئِيب أَوْ غَيْر وُدِّيّ فِي المَظْهَر)",
 "scpo": "رئيس ضباط الصف الأول (ضابط صف كبير في البحرية أو خفر السواحل برتبة تعادل رقيب أول في الجيش)",
 "scrabble": "سكرابل (لعبة لوحية يتم فيها تكوين كلمات من حروف بأنماط تشبه الكلمات المتقاطعة) / خربشة, شخبطة (رسم بلا هدف)",
 "scrabbly": "خَفِيفُ التَّشَجُّرِ, شُجَيْرِيّ (مُغَطَّى بِشَكْلٍ مُتَفَرِّقٍ بِأَشْجَارٍ قَزَمَةٍ وَشُجَيْرَاتٍ)",
 "scrag": "عنق العجل (النهاية القليلة الدهن لرقبة العجل) / عنق ضأن (النهاية القليلة الدهن للرقبة) / نحيل, هزيل (شخص نحيف وهزيل بشكل غير عادي)",
 "scrag end": "عنق العجل (النهاية القليلة الدهن لرقبة العجل)",
 "scraggly": "نَاقِص الوَزْن, هَزِيل (شَدِيد النُّحُول والهُزَال) / رَثّ, مُتَهَلْهِل (بَالٍ أَوْ نَحِيلٌ أَوْ غَيْرُ مُرَتَّبٍ فِي المَظْهَر)",
 "scraggy": "خَشِن, مُسَنَّن (ذو سطح أو محيط حادّ الانعراج) / نَاقِص الوَزْن, هَزِيل (شَدِيد النُّحُول والهُزَال)",
 "scram": "غَرَبَ (الجِهَة التي تغرب نحوها الشَمس؛ ضد الشَرْق؛ الأَرَاضِي والبِلَاد التي تقع جهة الغرب في العَالم)\nمثال: تغرب الشمس في الغرب.",
 "scramasax": "سكراماساكس (سكين أو سيف ذو حد واحد استخدمه الأنجلو ساكسون للقتال والصيد)",
 "scramaseax": "سكراماساكس (سكين أو سيف ذو حد واحد استخدمه الأنجلو ساكسون للقتال والصيد)",
 "scramble": "تَهَافَتَ",
 "scrambled": "مَخْلُوط, مُخَلَّط (مجموع بشكل عشوائي وفوضوي)",
 "scrambled egg": "بَيْض مَخْفُوق (الأيام البِيض: الأيام التي توافق اليوم الثالث عشر، والرابع عشر، والخامس عشر من كل شهر من أشهر العام الهجري، وقد سُمِّيت بذلك…)\nمثال: ياني يحب البيض.",
 "scrambled eggs": "بيض مخفوق (بيض مخفوق ومطبوخ حتى يصبح قوامه متماسكاً وطرياً مع التحريك)",
 "scrambler": "جهاز تشويش, مشفر صوتي (معدات إلكترونية تجعل الكلام غير مفهوم أثناء الإرسال وتعيده إلى حالته الأصلية عند الاستقبال) / دراجة نارية للطرق الوعرة (دراجة نارية خفيفة الوزن مجهزة بإطارات ونظام تعليق متين؛ دراجة نارية للطرق الوعرة مصممة للركوب عبر البلاد أو فوق الأرض غير المعبدة) / متحرك سريع (متحرك سريع؛ شخص يهرول أو يتحرك بصعوبة)",
 "scramsax": "سكراماساكس (سكين أو سيف ذو حد واحد استخدمه الأنجلو ساكسون للقتال والصيد)",
 "scrap": "خُرْدَة / يتخلى, نبذ / شجار",
 "scrap iron": "خردة الحديد (حديد يتم صهره مرة أخرى وإعادة تشكيله)",
 "scrap metal": "خردة معدنية (معدن مهمل مناسب لإعادة المعالجة)\nمثال: باع السيارة أخيراً كخردة معدنية",
