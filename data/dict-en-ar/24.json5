 "scarlet bugler": "بنستيمون قرمزي, بوق قرمزي (نبات بأزهار أنبوبية حمراء زاهية في عناقيد ضيقة طويلة بالقرب من أطراف السيقان المنتصبة؛ السلاسل الساحلية من وسط كاليفورنيا جنوباً)",
 "scarlet bush": "شجيرة قرمزية, هاميليا (شجيرة وسيمة بزهور برتقالية إلى قرمزية أو حمراء مبهرجة؛ فلوريدا وجزر الهند الغربية إلى المكسيك والبرازيل)",
 "scarlet clematis": "ياسمين بري قرمزي (كرمة خشبية من تكساس ذات أزهار قرمزية مفردة متدلية مبهرجة)",
 "scarlet cup": "كأس قرمزي (فطر قرصي يبشر بالربيع؛ الجسم الثمري رقيق وقوي وشكل الصحن (بحجم ربع إلى نصف دولار) بسطح علوي أحمر ساطع عميق وخارج مبيض)",
 "scarlet eggplant": "بَاذِنْجَان أَفْرِيقِيّ",
 "scarlet fever": "حمى قرمزية (مرض معد حاد (عادة عند الأطفال) يتميز بالحمى وطفح جلدي أحمر)",
 "scarlet fritillary": "بوقية قرمزية (عشبة غرب الولايات المتحدة بأزهار قرمزية وصفراء ضيقة على شكل جرس)",
 "scarlet hamelia": "شجيرة قرمزية, هاميليا (شجيرة وسيمة بزهور برتقالية إلى قرمزية أو حمراء مبهرجة؛ فلوريدا وجزر الهند الغربية إلى المكسيك والبرازيل)",
 "scarlet haw": "زعرور قرمزي (شجيرة شائعة أو شجرة صغيرة من شرق الولايات المتحدة لها القليل من الأشواك وزهور بيضاء في أعضاء زهرية تليها ثمار برتقالية حمراء زاهية)",
 "scarlet letter": "الحرف القرمزي",
 "scarlet lychnis": "صليب مالطي, ليخنيس قرمزي (نبات حديقة أوراسي معمر ذو زهور قرمزية في رؤوس طرفية كثيفة)",
 "scarlet maple": "قيقب أحمر, قيقب قرمزي (قيقب من شرق ووسط أمريكا؛ أوراقه خماسية الفصوص تتحول إلى القرمزي والأصفر في الخريف)",
 "scarlet musk flower": "زهرة المسك القرمزية, نيكتجينيا (نبات معمر متفرع لزج من جنوب غرب الولايات المتحدة وشمال المكسيك له جذور درنية وزهور حمراء عميقة)",
 "scarlet oak": "بلوط قرمزي (شجرة متساقطة الأوراق متوسطة إلى كبيرة ذات جذع سميك توجد في شرق الولايات المتحدة وجنوب كندا ولها خشب ضيق الحبيبات وأوراق عميقة الفصوص تتحول إلى…)",
 "scarlet pimpernel": "أناغالس حقلي, زهرة الطقس (عشبة ذات أزهار قرمزية أو بيضاء أو أرجوانية تغلق عند اقتراب الطقس الممطر)",
 "scarlet plume": "ريشة قرمزية, فربيون لامع (شجيرة مكسيكية تزرع غالباً لزهورها ذات القنابات القرمزية)",
 "scarlet runner": "فاصولياء قرمزية (قرون فاصولياء طويلة تقطع عادةً؛ مفضلة في بريطانيا) / ساعي البريد الجاري, كينيديا مفترشة (كرمة زاحفة مشعرة من غرب أستراليا ذات زهور وردية قرمزية زاهية) / فاصولياء العداء القرمزي, فاصولياء قرمزية (فاصولياء استوائية أمريكية ذات زهور حمراء وفاصولياء سوداء مرقطة تشبه الفاصولياء الشائعة ولكنها معمرة؛ وهي فاصولياء مفضلة للأكل في بريطانيا العظمى)",
 "scarlet runner bean": "فاصولياء قرمزية (قرون فاصولياء طويلة تقطع عادةً؛ مفضلة في بريطانيا) / فاصولياء العداء القرمزي, فاصولياء قرمزية (فاصولياء استوائية أمريكية ذات زهور حمراء وفاصولياء سوداء مرقطة تشبه الفاصولياء الشائعة ولكنها معمرة؛ وهي فاصولياء مفضلة للأكل في بريطانيا العظمى)",
 "scarlet strawberry": "فراولة فرجينيا, فراولة قرمزية (فراولة برية من أمريكا الشمالية ذات ثمار قرمزية حلوة؛ مصدر للعديد من أصناف الفراولة المزروعة)",
 "scarlet sumac": "سماق أملس, سماق قرمزي (شجيرة شائعة غير سامة في شرق أمريكا الشمالية بأوراق مركبة شمعية وزهور خضراء عنقودية تليها ثمار حمراء)",
 "scarlet tanager": "تناجر قرمزي (الذكر أحمر ساطع بأجنحة وذيل أسود)",
 "scarlet wisteria tree": "سيسبان كبير الأزهار, طائر الطنان النباتي (شجرة خشب لينة ذات عناقيد رخوة من الزهور الحمراء أو الوردية عادة؛ موطنها أستراليا الاستوائية وآسيا؛ وتم توطينها في جنوب فلوريدا وجزر الهند الغربية)",
 "scarlet-crimson": "قِرْمِزِيّ فَاقِع (قرمزي مع مسحة من الأحمر القاني)",
 "scarlet-pink": "وَرْدِيّ قِرْمِزِيّ (وردي مع مسحة قرمزية)",
 "scarp": "منحدر تحصيني (منحدر اصطناعي حاد أمام تحصين) / جرف صخري, منحدر حاد (منحدر طويل وشديد الانحدار أو جرف عند حافة هضبة أو حيد؛ يتكون عادة بفعل التعرية)",
 "scarred": "مَنْدُوب, مُشَوَّه (مشوَّه بالإصابة أو الاستعمال القاسي) / مُشَوَّه, مُنَدَّب (متأثر بعمق بألم جسدي أو نفسي أو إصابة)",
 "scartella cristata": "مولي ميلر (تعيش في كلا ساحلي المحيط الأطلسي الاستوائي)",
 "scary": "مُجَفِّل",
 "scat": "سكات, غناء ارتجالي (غناء الجاز؛ حيث يستبدل المغني كلمات الأغنية بمقاطع لا معنى لها ويحاول أن يبدو وكأنه آلة موسيقية)",
 "scat singing": "سكات, غناء ارتجالي (غناء الجاز؛ حيث يستبدل المغني كلمات الأغنية بمقاطع لا معنى لها ويحاول أن يبدو وكأنه آلة موسيقية)",
 "scathe": "أذى, ضرر (فعل إلحاق الضرر بشيء أو شخص ما)",
 "scathing": "شَاتِم, قَاسٍ (يتسم بالنقد العنيف والمُسِيء)",
 "scathingly": "بحدة بالغة, بشكل لاذع (بطريقة قاسية وناقدة بحدة دون هوادة)\nمثال: انتقدته بشكل لاذع",
 "scatological": "بُرَازِيّ, مُتَعَلِّق بِالإِخْرَاج (يتناول الفضلات ووظائف الإخراج بشكل فاحش)",
 "scatology": "تحليل البراز ((طب) التحليل الكيميائي للفضلات (للتشخيص الطبي أو لأغراض علم الحفريات)) / هوس البذاءة (انشغال بالفحش (خاصة ذلك الذي يتعامل مع الفضلات أو الوظائف الإخراجية))",
 "scatophagy": "أكل القذارة (تناول البراز أو القذارة الأخرى)",
 "scatter": "نَثَرَ, تَفَرَّقَ",
 "scatter pin": "دبوس صغير (دبوس صغير يُلبس عادة في مجموعات من اثنين أو أكثر)",
 "scatter rug": "بساط منثور, سجادة صغيرة (سجادة صغيرة؛ يمكن استخدام العديد منها في غرفة واحدة)",
 "scatterbrain": "طائش, مشتت الذهن (شخص طائش وغير منظم)",
 "scatterbrained": "شَارِد الذِّهْن, مُتَقَلِّب (ينقاد للأهواء والنزوات دون تفكير ثابت) / طَائِش, مُشَتَّت الذِّهْن (يفتقر إلى الحكمة والتمييز)",
 "scattered": "مُتَفَرِّق",
 "scattergood": "متلاف, مسرف (شخص ينفق المال بإسراف)",
 "scattergun": "بندقية خرطوش, بندقية صيد (سلاح ناري يُحمل على الكتف مزدوج السبطانة أملس الجوف لإطلاق الخردق في مديات قصيرة)",
 "scattering": "بعثرة, نثر (عملية البعثرة) / تشتت, تفريق (الانتشار على نطاق واسع أو الطرد بعيداً) / رشراش, زخات خفيفة متفرقة (زخة خفيفة تسقط في بعض المواقع دون غيرها القريبة) / بعثرة, تشتت (العملية الفيزيائية التي تنحرف فيها الجسيمات عشوائياً نتيجة للتصادمات)",
 "scattershot": "عَشْوَائِيّ, مُبَعْثَر (يُغَطِّي نِطَاقًا وَاسِعًا بِطَرِيقَة عَشْوَائِيَّة)",
 "scatty": "سَارِح, شَارِد الذِّهْن (غارق في التفكير؛ يبدو مشغول البال ومنصرفًا عمّا حوله) / طَائِش, مُشَتَّت الذِّهْن (يفتقر إلى الحكمة والتمييز)",
 "scaup": "بط زرقاي, زرقاي (بط غواص من أمريكا الشمالية له منقار رمادي مزرق)",
 "scaup duck": "بط زرقاي, زرقاي (بط غواص من أمريكا الشمالية له منقار رمادي مزرق)",
 "scauper": "إزميل مقعر, مغرفة النقش (أداة نقش تستخدم لغرف مناطق واسعة عند نقش الخشب أو المعدن)",
 "scavenger": "نَبَّاش, قَمَّام",
 "scavenger cell": "بلعم, خلية بلعمية (خلية تبتلع وتهضم الحطام والكائنات الحية الدقيقة الغازية)",
 "scd": "دكتوراه في العلوم (درجة فخرية في العلوم)",
 "sceloglaux albifacies": "بومة ضاحكة (بومة شبه منقرضة من نيوزيلندا)",
 "sceloporus graciosus": "سحلية الميرمية (سحلية أرضية تفضل الأراضي المفتوحة والشجيرات المنخفضة المتناثرة؛ توجد في غرب الولايات المتحدة بين جبال روكي وسييرا نيفادا)",
 "sceloporus occidentalis": "سحلية السياج الغربية (سحلية غربية شائعة؛ تُشاهد على جذوع الأشجار أو الصخور)",
 "sceloporus undulatus": "سحلية السياج الشرقية (سحلية نشطة صغيرة تعيش في الولايات المتحدة وشمالاً حتى كولومبيا البريطانية)",
 "scenario": "سِينَارْيُو",
 "scenarist": "كاتب سيناريو (كاتب لسيناريوهات الأفلام)",
 "scene": "مَنْظَر, مَشْهَد / مَشْهَد",
 "scene of action": "حلبة, ساحة رياضية (ملعب تقام فيه الأحداث الرياضية)",
 "scene painter": "رسام الديكور المسرحي, رسام المشاهد (رسام المناظر المسرحية) / رسام ديكور مسرحي, فنان مناظر (فنان متخصص في المواضيع المشهدية (مثل ديكور المسرح))",
 "scene-stealer": "خاطف الأنظار, سارق الأضواء (ممثل يجذب انتباهاً أكثر من الممثلين الآخرين في نفس المشهد)\nمثال: الأطفال يخطفون الأنظار بطبيعتهم",
 "scenery": "مَشْهَد, مَنْظَر طَبِيعِيّ",
 "sceneshifter": "عامل تغيير المناظر (عامل مسرح مسؤول عن تحريك الديكور)",
 "scenic": "ذُو مَنَاظِر خَلَّابَة (يوصف به الأماكن؛ ذو مناظر طبيعية جميلة) / مسرحي, مشهدي (مكون من أو متعلق بالمسرح أو المناظر المسرحية)\nمثال: تصميم مشهدي",
 "scenic artist": "رسام ديكور مسرحي, فنان مناظر (فنان متخصص في المواضيع المشهدية (مثل ديكور المسرح))",
 "scenic railway": "قطار ملاهي (سكة حديد صغيرة في مدينة ملاهي)",
 "scenically": "مشهدياً (فيما يتعلق بمناظر المسرح أو المشاهد الطبيعية)\nمثال: مذهل مشهدياً",
 "scent": "أَرِيج",
 "scented": "عَبِق, فَوَّاح (ذُو عُطْرٍ طَبِيعِيٍّ) / مُتَضَمِّخٌ بِالعِطْر, مُعَطَّر (مَمْلُوءٌ بِالعِطْرِ أَوْ مُشَبَّعٌ بِهِ) / مُتَضَوِّع, مُعَطَّر ((يُسْتَخْدَمُ فِي التَّرْكِيب) ذُو رَائِحَة مُعَيَّنَة) / ذو حاسة شم (يمتلك حاسة الشم)\nمثال: كلاب صيد قوية الشم",
 "scented fern": "أزرار ذهبية, حشيشة الدود (عشبة عطرية معمرة شائعة موطنها أوراسيا ذات رؤوس زهور صفراء تشبه الأزرار وأوراق ريشية مرة الطعم تستخدم أحياناً طبياً) / سرخس معطر (سرخس أفريقي حلو الرائحة بسعف ريشي مزدوج ضيق) / سرخس برائحة التبن (سرخس من شرق أمريكا الشمالية بسعف أخضر شاحب ورائحة تشبه التبن)",
 "scented penstemon": "بنستيمون معطر, زهرة البالون (أزهار منتفخة عطرة بيضاء إلى وردية محمرة في عناقيد ضيقة طويلة على سيقان منتصبة؛ أريزونا إلى نيو مكسيكو ويوتا)",
 "scented wattle": "أكاسيا حلوة, سنط عنبري (شجيرة شائكة أو شجرة صغيرة من أمريكا الاستوائية؛ تستخدم زهورها الصفراء العطرة في صناعة العطور)",
 "scentless": "بِلَا رَائِحَة, عَدِيم العَبِير (لَا يَنْبَعِثُ مِنْهُ وَلَا يَحْتَفِظُ بِأَيِّ رَائِحَة) / أخشم, فاقد لحاسة الشم (يفتقر إلى حاسة الشم)",
 "scentless camomile": "اقحوان الحقول, بابونج غير معطر",
 "scentless false camomile": "اقحوان الحقول, بابونج غير معطر",
 "scentless hayweed": "اقحوان الحقول, بابونج غير معطر",
 "scentless mayweed": "اقحوان الحقول, بابونج غير معطر",
 "scepter": "صولجان, عصا سحرية (عصا احتفالية أو رمزية) / الصولجان (السلطة الإمبراطورية التي يرمز إليها الصولجان)",
 "sceptered": "ذُو صَوْلَجَان, مُمَكَّن (مُستَثمَر بالسلطة القانونية أو الرسمية خاصة كما يرمز إليه الصولجان)",
 "sceptic": "شاك, متشكك (شخص يشك عادة في المعتقدات المقبولة)",
 "sceptical": "مُتَشَكِّك, مُرْتَاب (يُنكِر أو يُشَكِّك في عقائد دين ما خاصةً) / شَكَّاك, مُتَشَكِّك (يتسم بالشك أو يميل إليه)",
 "sceptically": "بارتياب, بتشكك (مع وجود شك أو عدم تصديق)\nمثال: نظر إليها بتشكك",
 "scepticism": "ارتياب, شك (الشك في حقيقة شيء ما) / شكوكية, لاأدرية (عدم التصديق في أي ادعاءات بالمعرفة المطلقة)",
 "sceptre": "صَوْلَجَان",
 "sceptred": "ذُو صَوْلَجَان, مُمَكَّن (مُستَثمَر بالسلطة القانونية أو الرسمية خاصة كما يرمز إليه الصولجان)",
 "scet": "وقت حدث المركبة الفضائية (التوقيت العالمي المنسق على متن المركبة الفضائية)\nمثال: وقت حدث المركبة = وقت الإرسال + وقت الضوء في اتجاه واحد",
