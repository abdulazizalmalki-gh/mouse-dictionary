 "scrivened": "مَنْسُوخٌ يَدَوِيًّا (نُسِخ بخطّ اليد نقلًا عن الأصل)",
 "scrivener": "ناسخ, ورّاق (شخص يعمل لعمل نسخ مكتوبة من الوثائق والمخطوطات)",
 "scrod": "سكرود (قد أطلسي أو حدوق صغير خاصة المشقوق والمنزوع العظم للطهي) / سمك قد صغير (لحم قد أطلسي صغير يصل وزنه إلى 2 رطل؛ أيضاً صغار الهادوك والبولوك؛ يشوى غالباً)",
 "scrofula": "الخنازير, داء الخنازير (شكل من أشكال السل يتميز بتورم الغدد اللمفاوية)",
 "scrofulous": "خَنَازِيرِيّ المَظْهَر (ذو مظهر مريض يشبه داء الخنازير) / دَنِس, مُلَوَّث أَخْلَاقِيًّا (مُلَوَّث مِن الناحية الأخلاقية؛ فاسد معنويًّا) / خَنَازِيرِيّ (مصاب بالخنازير (التهاب العقد اللمفاويّة السُّلّيّ))",
 "scroll": "طُومَار",
 "scroll saw": "منشار أركت, منشار منحنيات (منشار آلي دقيق الأسنان بشفرة ضيقة؛ يستخدم لقطع الخطوط المنحنية)",
 "scrooge": "بخيل, شحيح (شخص أناني غير راغب في العطاء أو الإنفاق)",
 "scrotal": "صَفَنِيٌّ",
 "scrotal vein": "وريد صفني (أوردة تمر من كيس الصفن إلى الأوردة الفرجية)",
 "scrotum": "صَفَن, كِيس اَلصَّفَن",
 "scrounger": "طُفَيْلِيّ, مُتَطَفِّل (شخص يحاول الحصول على أشياء مجانية من الآخرين)",
 "scrub": "جلي, دعك (فعل تنظيف سطح بفركه بفرشاة وصابون وماء) / غَيْر مُنْتَقًى ((عن الحيوانات الداجنة) لم تتمّ تربيتها بشكل انتقائيّ) / أدغال, شجيرات قصيرة (نباتات كثيفة تتكون من أشجار متقزمة أو شجيرات)",
 "scrub beefwood": "خشب البقر المقشر (شجرة أو شجيرة طويلة ذات أوراق لامعة وخيمات من الزهور البيضاء الكريمية العطرة؛ تنتج خشباً محمراً ثقيلاً صلباً)",
 "scrub bird": "طائر الأدغال (طائر أسترالي صغير سريع الجري يشبه النمنمة ويتردد على الشجيرات أو الأدغال)",
 "scrub brush": "فرشاة فرك, فرشاة كشط (فرشاة ذات شعيرات قصيرة صلبة للتنظيف الشاق)",
 "scrub fowl": "شقبان (طيور كبيرة الأقدام قصيرة الأجنحة من أسترالاسيا؛ تبني أكواماً من النباتات المتحللة لاحتضان البيض)",
 "scrub nurse": "ممرضة عمليات (ممرضة تساعد الجراح في الاستعداد للجراحة)",
 "scrub oak": "بلوط شجيري (أي من أشجار بلوط شجيرية صغيرة أمريكية بشكل رئيسي غالباً ما تكون شكلاً سائداً في التربة الجافة الرقيقة وتشكل أحياناً غابات كثيفة)",
 "scrub palmetto": "بالميتو المنشاري (نخيل شائك صغير قوي يشكل كتل من جنوب الولايات المتحدة)",
 "scrub pine": "صنوبر جيرسي, صنوبر فرجينيا (صنوبر شجيري صغير شائع في شرق الولايات المتحدة له فروع متناثرة ملتوية غالباً وإبر قصيرة في حزم من 2)",
 "scrub plane": "فارة كشط, مِسْحَج كشط (مسحج نجارة ضيق يستخدم لقطع المخزون الزائد)",
 "scrub typhus": "تيفوس الأجمة, مرض تسوتسوغاموشي (ينقله يرقات العث وينتشر في آسيا)",
 "scrub-bird": "طائر الأدغال (طائر أسترالي صغير سريع الجري يشبه النمنمة ويتردد على الشجيرات أو الأدغال)",
 "scrubbed": "مَفْرُوك, مُنَظَّف بِالفَرْك (نُظِّف بالدعك والفرك)",
 "scrubber": "جهاز تنقية, جهاز غسل الغاز (جهاز تنقية يزيل الشوائب من الغاز) / فرشاة فرك, فرشاة كشط (فرشاة ذات شعيرات قصيرة صلبة للتنظيف الشاق) / فرّاك (عامل يستخدم فرشاة فرك لتنظيف سطح (عادة أرضية أو سطح سفينة))",
 "scrubbiness": "تقزم, هزال (خاصية كون الشيء متقزماً ودون المستوى في الحجم أو الجودة)\nمثال: هزال الأشجار المريضة",
 "scrubbing": "جلي, دعك (فعل تنظيف سطح بفركه بفرشاة وصابون وماء)",
 "scrubbing brush": "فرشاة فرك, فرشاة كشط (فرشاة ذات شعيرات قصيرة صلبة للتنظيف الشاق)",
 "scrubbird": "طائر الأدغال (طائر أسترالي صغير سريع الجري يشبه النمنمة ويتردد على الشجيرات أو الأدغال)",
 "scrubby": "مُتَقَزِّم, هَزِيل (صغير الحجم أو رديء الجودة) / خَفِيفُ التَّشَجُّرِ, شُجَيْرِيّ (مُغَطَّى بِشَكْلٍ مُتَفَرِّقٍ بِأَشْجَارٍ قَزَمَةٍ وَشُجَيْرَاتٍ)",
 "scrubland": "أرض الشجيرات (منطقة غير مزروعة مغطاة بنباتات الشجيرات)",
 "scrubs": "رداء جراحي (رداء واقٍ يرتديه الجراحون أثناء العمليات)",
 "scruff": "عنق, قفا (الجانب الخلفي من الرقبة)",
 "scruffy": "رَثّ, مُهْمَل المَظْهَرِ (بَالٍ وَغَيْرُ مُرَتَّبٍ)",
 "scrum": "تكتل بدء اللعب, سكرم ((الرجبي) طريقة بدء اللعب حيث ينحني المهاجمون من كل فريق جنباً إلى جنب بأذرع متشابكة؛ يبدأ اللعب عند رمي الكرة بينهم ويتنافس الجانبان على الاستحواذ)",
 "scrummage": "تكتل بدء اللعب, سكرم ((الرجبي) طريقة بدء اللعب حيث ينحني المهاجمون من كل فريق جنباً إلى جنب بأذرع متشابكة؛ يبدأ اللعب عند رمي الكرة بينهم ويتنافس الجانبان على الاستحواذ)",
 "scrumptious": "شَهِيٌّ لِلغَايَة, لَذِيذٌ جِدًّا (بَالِغُ اللَّذَّةِ لِحَاسَّةِ التَّذَوُّق)",
 "scrumptiously": "بشكل شهي, بلذة (بطريقة تنتج طعماً لذيذاً)\nمثال: اشتريت المزيد من هذا الخوخ الحلو بشكل شهي",
 "scrumpy": "نبيذ التفاح القوي (نبيذ تفاح قوي (كما يُصنع في غرب إنجلترا))",
 "scrunch": "سحق, طحن (ضجيج طحن)",
 "scruple": "تأنيب ضمير, وازع أخلاقي (مبدأ أخلاقي أو قيمي يثبط الفعل أو يمنعه) / توجس, رادع أخلاقي (عدم الارتياح بشأن ملاءمة إجراء ما (لا سيما لأسباب تتعلق بالأخلاق أو اللياقة)) / سكربل (وحدة وزن صيدلانية تساوي 20 قمحة)",
 "scruples": "حس أخلاقي, ضمير (دافع نابع منطقياً من مبادئ أخلاقية تحكم أفكار الشخص وتصرفاته)",
 "scrupulous": "مُجْتَهِد, وَرِع فِي عَمَلِه (يَتَّسِم بِعِنَايَة فَائِقَة وجُهْدٍ كَبِير) / دقيق, ضميري (لديه وازع؛ ينبع من الشعور بالصواب والخطأ؛ صاحب مبادئ)\nمثال: أرسل المنتجون الأقل نزاهة حزماً كانت مخادعة في مظهرها",
 "scrupulously": "بانتظام شديد, بدقة متناهية (بضمير حي شديد أو انتظام)\nمثال: كان يأتي بانتظام شديد كل صباح",
 "scrupulousness": "تدقيق, دقة (انتباه صارم للتفاصيل الدقيقة) / تدقيق, ضمير حي (الامتثال لمعايير عالية من الأخلاق أو التميز)",
 "scrutin de liste": "نظام القوائم (قائم على مبدأ التمثيل النسبي؛ يختار الناخبون بين قوائم الأحزاب، ويتم تحديد عدد المنتخبين من كل قائمة بنسبة الأصوات التي حصلت عليها كل قائمة من إجمالي…)",
 "scrutin de liste system": "نظام القوائم (قائم على مبدأ التمثيل النسبي؛ يختار الناخبون بين قوائم الأحزاب، ويتم تحديد عدد المنتخبين من كل قائمة بنسبة الأصوات التي حصلت عليها كل قائمة من إجمالي…)",
 "scrutin uninomial system": "نظام الدوائر الفردية, نظام العضو الواحد (قائم على مبدأ اختيار عضو واحد فقط (كما في المجلس التشريعي) من كل دائرة انتخابية)",
 "scrutin uninominal voting system": "نظام الدوائر الفردية, نظام العضو الواحد (قائم على مبدأ اختيار عضو واحد فقط (كما في المجلس التشريعي) من كل دائرة انتخابية)",
 "scrutineer": "فاحص الأصوات (شخص يفحص الأصوات في الانتخابات)",
 "scrutiniser": "فاحص دقيق (فاحص حريص؛ شخص يفتش بعناية فائقة)",
 "scrutinizer": "فاحص دقيق (فاحص حريص؛ شخص يفتش بعناية فائقة)",
 "scrutiny": "تَدْقِيق",
 "scsi": "واجهة نظام الحاسوب الصغيرة (واجهة تتكون من منفذ قياسي بين الكمبيوتر وملحقاته)",
 "scuba": "جهاز تنفس تحت الماء, رئة مائية (جهاز يسمح للغواصين بالتنفس تحت الماء)",
 "scuba diver": "غواص سكوبا (غواص تحت الماء يستخدم معدات الغوص (سكوبا))",
 "scuba diving": "غوص سكوبا (الغوص باستخدام جهاز التنفس تحت الماء (سكوبا))",
 "scud": "انطلاق سريع (فعل التحرك بسرعة (كما أمام عاصفة))",
 "scudding": "انطلاق سريع (فعل التحرك بسرعة (كما أمام عاصفة))",
 "scuff": "جر القدمين, حك (فعل الحك (كشط أو جر القدمين)) / خف بدون كعب, شبشب (خف ليس له جزء حول الكعب)",
 "scuffer": "صندل خفيف (صندل مرن خفيف الوزن بنعل قوي؛ يرتديه الأطفال كأحذية لعب والبالغون كملابس رياضية)",
 "scuffle": "تدافع, عراك (صراع غير رسمي وغير منظم) / تَشَابُك بِالأَيْدِي, عِرَاك (قتال غير منظم) / مجرفة دفع, معزقة هولندية (معزقة تستخدم بالدفع بدلاً من السحب)",
 "scuffle hoe": "مجرفة دفع, معزقة هولندية (معزقة تستخدم بالدفع بدلاً من السحب)",
 "scull": "قارب تجديف بمجدافين (قارب سباق يتم دفعه بمجاديف مزدوجة) / مِجداف فردي (كل واحد من زوج من المجاذيف القصيرة يستخدمها جداف واحد) / مِجداف المؤخرة (مجداف طويل يركب في مؤخرة القارب ويحرك يميناً ويساراً لدفع القارب للأمام)",
 "sculler": "مجدّف بمجداف واحد (شخص يجدف (يحرك مجدافاً طويلاً مثبتاً في مؤخرة القارب لدفعه للأمام))",
 "scullery": "غرفة الغسيل, مطبخ التحضير (غرفة صغيرة (في المنازل البريطانية القديمة الكبيرة) بجوار المطبخ؛ حيث يتم تنظيف وحفظ أواني المطبخ والقيام بأعمال منزلية شاقة أخرى)",
 "sculling": "تجديف مزدوج (التجديف بواسطة مجدف واحد في قارب سباق)",
 "scullion": "خادم المطبخ (خادم مطبخ يعمل للقيام بمهام وضيعة (خاصة الغسيل))",
 "sculpin": "إسقلبين (أي من الأسماك العقربية العديدة الشائكة كبيرة الرأس وعديمة القشور عادة ذات أفواه عريضة)",
 "sculpted": "مَنْحُوت, مُجَسَّم (مقطوع إلى الشكل المطلوب)",
 "sculptor": "نَحَّات, مَثَّال (من يمتهن النَّحْتَ، وهو فَنَّان يصنع التماثيل من الحجارة أو الخشب؛ كثير النَّحْتِ)",
 "sculptress": "نحاتة (امرأة نحاتة)",
 "sculptural": "كَالمَنْحُوتَة, نَحْتِيّ (يشبه المنحوتة في تناسقه ووضوح ملامحه) / نحتي (متعلق بالنحت أو يتكون منه)\nمثال: زخارف نحتية",
 "sculptural relief": "نحت ناتئ, نقش بارز (نحت يتكون من أشكال منحوتة على سطح بحيث تبرز عن الخلفية المحيطة)",
 "sculpture": "تِمْثَال, مَنْحُوتَة / نَحْت (وهو القَطْع والبَري والنشر والقشر وتشكيل الخشب أو الحجر أو غيره؛ الشيء الذي نُحِتَ، النقش أو التمثال أو غيره مما كان ناتج النحت)\nمثال: من علمك نحت الخشب.",
 "sculptured": "مَنْحُوت, مُجَسَّم (مقطوع إلى الشكل المطلوب) / كَالمَنْحُوتَة, نَحْتِيّ (يشبه المنحوتة في تناسقه ووضوح ملامحه)",
 "sculpturer": "مثّال, نحات (فنان يبدع المنحوتات)",
 "sculpturesque": "كَالمَنْحُوتَة, نَحْتِيّ (يشبه المنحوتة في تناسقه ووضوح ملامحه)",
 "scum": "رغوة شوائب, زَبَد (طبقة من الشوائب أو النباتات التي يمكن أن تتشكل على سطح السائل) / أراذل, حثالة (أشخاص عديمو القيمة)",
 "scum bag": "حقير, دنيء (شخص يُعتبر حقيراً أو مُزدرى)\nمثال: وحده الدنيء يفعل ذلك",
 "scumbag": "حقير, دنيء (شخص يُعتبر حقيراً أو مُزدرى)\nمثال: وحده الدنيء يفعل ذلك",
 "scumble": "تلوين خفيف (وضع طبقة رقيقة جداً من اللون فوق سطح اللوحة)",
 "scummy": "مُغَطًّى بِالزَّبَد (مُغطّى بطبقة من الرغوة أو الزبد القذر) / خَسِيس, وَضِيع (من أحقر الأنواع وأدناها)",
 "scunner": "نفور شديد (كراهية قوية)\nمثال: شعروا بنفور شديد تجاه الولايات المتحدة",
 "scup": "سكوب, مرجان شمالي (توجد في المياه الساحلية الأطلسية لأمريكا الشمالية من كارولينا الجنوبية إلى ماين؛ تُقدر كسمكة مقلاة) / سكوب, مرجان جنوبي (مرجان المياه الساحلية الأطلسية الجنوبية لأمريكا الشمالية) / أبراميس, سمك المرجان (لحم قليل الدهن لسمكة توجد في المياه الدافئة للساحل الجنوبي للمحيط الأطلسي للولايات المتحدة) / سمك السكب (لحم سمكة توجد في المياه الباردة للساحل الشمالي للمحيط الأطلسي للولايات المتحدة)",
 "scupper": "ثقب التصريف, ميزاب السفينة (مصرف يسمح بتدفق المياه الموجودة على سطح السفينة إلى الخارج)",
 "scuppernong": "سكوبرنونغ (عنب مسكدين أصفر مخضر في جنوب شرق الولايات المتحدة)",
 "scurf": "تَقَشُّر, حَرْشَفَة (رقاقة رفيعة من البشرة الميتة تنسلخ من سطح الجلد) / حَرْشَفَة نباتية, قُشَيْرَة ((في علم النبات) غطاء يشبه القشور أو النخالة يغطي بعض أجزاء النبات)",
 "scurfy": "قِشْرِيّ, مُتَقَشِّر (مغطّى بقشور أو حراشف دقيقة) / حرشفي, قشري (يمتلك أو ينتج أو مغطى بقشور (بشرة))",
 "scurrility": "بَذَاءَة, سِبَاب (إساءة بذيئة أو فاحشة)",
 "scurrilous": "بَذِيء, سَبَّاب (يعبّر عن توبيخ مسيء ومُهين)",
 "scurrilously": "ببذاءة, بوقاحة (بطريقة بذيئة أو مهينة)\nمثال: وصفت إحدى الصحف ببذاءة كيف كان إدوارد يهمل أماً ثكلى ليتفرغ لخدمة والي",
 "scurry": "ركض, هرولة مذعورة (الجري بسرعة في الأرجاء بطريقة تفتقر للوقار)",
 "scurrying": "مُسْرِع, مُنْدَفِع (يَتَحَرَّك بِعَجَلَة شَدِيدَة)",
 "scurvily": "بخسة, بنذالة (بطريقة حقيرة ودنيئة)\nمثال: هذا الزعيم الجديد يهدد بخسة أعمق قيم مجتمعنا",
 "scurvy": "إِسْقَرْبُوط",
 "scurvy grass": "رشاد الشتاء, عشبة القديسة بربارة (أي نبات من جنس برباريا: نباتات رشاد أوراسية صفراء الزهور؛ تزرع على نطاق واسع كسلطة شتوية) / عشبة الأسقربوط, ملعقية (رشاد قطبي واسع التوزيع يشتهر بقيمته في علاج أو الوقاية من الإسقربوط؛ مصدر مركز لفيتامين سي)",
 "scut": "ذيل قصير (ذيل قصير منتصب)",
 "scut work": "عمل روتيني ممل, عمل وضيع (أعمال تافهة وغير مجزية ومملة وقذرة وغير سارة)\nمثال: وظفه المستشفى للقيام بالأعمال الوضيعة",
 "scutch grass": "ثيّل, عشب برمودا (عشب زاحف موطنه أوروبا وعالمي الانتشار الآن في المناطق الدافئة؛ يستخدم للمروج والمراعي خاصة في جنوب الولايات المتحدة والهند)",
 "scutcheon": "تروسة, درع الشعار (ترس؛ خاصة ذلك الذي يعرض شعار النبالة) / لوحة حماية الباب (غطاء واقٍ مسطح (على باب أو حائط إلخ) لمنع الاتساخ بالأصابع المتسخة)",
 "scutching machine": "آلة نفش (آلة تستخدم لنفش القطن أو الحرير أو الكتان)",
 "scute": "حَرْشَفَة دِرْعِيَّة (صفيحة عظمية أو قرنية كبيرة كما في المدرع أو السلحفاة أو الجانب السفلي للثعبان)",
 "scutellaria lateriflora": "درقة الكلب المسعور, درقة زرقاء (نعناع أمريكي ينتج إفرازاً راتنجياً يستخدم خاصة في الماضي كمضاد للتشنج)",
 "scutigera coleoptrata": "مئوية أرجل المنزل (مئوية أرجل طويلة الأرجل شائعة في الأماكن الرطبة مثل الأقبية)",
 "scutigerella immaculata": "مئوية أرجل الحدائق (مفصلي دقيق يصيب غالباً الأجزاء الموجودة تحت الأرض من محاصيل الحدائق والدفيئات)",
 "scuttle": "فتحة, كوة (مدخل مجهز بغطاء؛ خاصة الممرات بين طوابق السفينة) / دلو الفحم, سطل الفحم (حاوية للفحم؛ مشكلة لتسمح بصب الفحم في النار)",
 "scuttlebutt": "ثرثرة, نميمة (تقرير (غالباً ما يكون خبيثاً) عن سلوك أشخاص آخرين)\nمثال: تسبب الطلاق في الكثير من القيل والقال",
 "scyphozoan": "فنجانيات (أي من الجوفمعويات البحرية المختلفة حرة السباحة عادة والتي تكون مرحلة الميدوزا الهلامية هي المرحلة السائدة في دورة حياتها)",
 "scyphus": "سكيفوس (كوب شرب يوناني قديم؛ له مقبضان وقاعدة)",
 "scythe": "مِنْجَل, مِقْضَب",
 "scythia": "سَكِيثِيَا, سَقِيثِيَا",
 "scythian": "سكوثي (مكون من أو متعلق بالسكوثيين القدماء أو ثقافتهم أو لغتهم) / السكيثية (اللغة الإيرانية التي كان يتحدث بها السكيثيون القدماء) / سكوثي (عضو في الشعب البدوي القديم الذي سكن سكيثيا)",
 "scythian lamb": "خروف سكيثيا, سيبوتيوم باروميتز (سرخس شجري آسيوي ذو شعر كثيف متشابك يستخدم أحياناً كمادة قابضة)",
 "scythian language": "السكيثية (اللغة الإيرانية التي كان يتحدث بها السكيثيون القدماء)",
 "sderot": "سديروت, اسديروت",
 "se": "الجَنُوب الشَّرْقِيّ (نقطة البوصلة في منتصف المسافة بين الجنوب والشرق؛ عند 135 درجة) / سيلينيوم (عنصر لافلزي سام مرتبط بالكبريت والتيلوريوم؛ يوجد في عدة أشكال تآصلية)",
 "sea": "بَحْر (شَقّ الأرض؛ التَحَيُّر والبَهْت من الفزع أو من شدة العَطَش فنظر لا يقصد شيئا) / يَمّ (البَحْر) / بَحَر (شَقّ الأرض؛ التَحَيُّر والبَهْت من الفزع أو من شدة العَطَش فنظر لا يقصد شيئا) / بحر (شَقّ الأرض؛ التَحَيُّر والبَهْت من الفزع أو من شدة العَطَش فنظر لا يقصد شيئا)\nمثال: هبطت على البحر.",
 "sea anchor": "مرساة عائمة (قيد يتكون من إطار مغطى بالقماش يطفو خلف السفينة؛ يمنع الانجراف أو يحافظ على الاتجاه في مهب الريح)",
 "sea anemone": "شَقِيقَة نُعْمَانِ اَلْبَحْرِ (مؤنث الشَقِيْق، وهو كل ما شُقَّ نصفين فكل من النصفين شقيق الآخر. الجمع شَقَائِق؛ مؤنث الشَقِيْق، وهو الأَخ من نفس الأُمّ والأبّ)\nمثال: هي أختي غير الشقيقة.",
 "sea animal": "حيوان بحري, كائن بحري (أي من الحيوانات العديدة التي تعيش في البحر بما في ذلك الأسماك والرخويات والعديد من الثدييات)",
 "sea ash": "شجرة ألم الأسنان, فاغرة أمريكية (شجيرة (أو شجرة) عطرية صغيرة متساقطة الأوراق ذات فروع شائكة وزهور صفراء؛ موطنها شرق أمريكا الشمالية)",
 "sea aster": "أستر البحر, نجمة البحر (أستر أوروبي شائع ينمو في المستنقعات المالحة)",
 "sea bass": "قاروس, قاروص",
 "sea bathing": "استجمام بحري, سباحة في البحر (الاستحمام أو السباحة في البحر أو المحيط)",
 "sea bird": "طائر بحري (طائر يتردد على المياه الساحلية والمحيط المفتوح: النوارس، البجع، الأطيش، الغاق، القطرس، النوء، إلخ)",
 "sea biscuit": "بقسماط السفينة, خبز البحارة (بسكويت أو خبز صلب جداً غير مملح؛ كان غذاءً أساسياً في السفن قديماً)",
 "sea boat": "قارب بحري (قارب صالح للإبحار؛ ومتكيف مع البحار المفتوحة)",
 "sea bottom": "قاع البحر, قاع المحيط (الجزء السفلي من بحر أو محيط)",
 "sea bream": "أسبور, دنيس / سمك الدنيس (لحم أي نوع من أسماك المياه المالحة المختلفة من فصيلة الأسبورية أو فصيلة البراميداي)",
 "sea breeze": "نسيم البحر (نسيم منعش من البحر (خلال النهار))",
 "sea buckthorn": "أَبُو قَايِس, شَوْك الْقَصَّار",
 "sea captain": "ربان, قبطان (ضابط مرخص له بقيادة سفينة تجارية)",
 "sea catfish": "سلور بحري (أي من الأسماك البحرية العديدة التي يحتضن معظمها البيض في الفم؛ لا تستخدم كطعام)",
 "sea change": "تغير البحر (صَارَ غير ما كان)\nمثال: هل تغير أي شيء؟",
 "sea chantey": "أغنية البحارة, شانتي (أغنية عمل إيقاعية غناها البحارة في الأصل)",
 "sea chest": "صندوق البحار (صندوق تخزين يستخدمه البحار لممتلكاته الشخصية)",
 "sea chub": "شوب البحر (أسماك تعيش في أسراب غالباً في المحيط الهندي وغرب المحيط الهادئ؛ نوعان في غرب المحيط الأطلسي)",
 "sea coal": "فحم البحر, مسحوق الفحم القاري (فحم قاري مسحوق؛ يستخدم كبطانة في المسابك)",
 "sea cole": "كرامبي, كرنب بحري (نبات معمر في الرمال الساحلية والحصى لشمال أوروبا وبحر البلطيق والبحر الأسود له عناقيد من الزهور البيضاء الصغيرة وأوراق زرقاء خضراء لحمية كبيرة تستخدم…)",
 "sea cow": "بقر البحر (أي من فصيلتين من الثدييات المائية العاشبة الكبيرة ذات ذيول مجدافية الشكل وأطراف أمامية تشبه الزعانف ولا أطراف خلفية)",
 "sea cradle": "خيتون, عديد الأصداف (رخوي بحري بدائي ممدود متناظر ثنائياً له عباءة مغطاة بثماني صفائح جيرية)",
 "sea crawfish": "جراد البحر الشائك (قشري بحري كبير صالح للأكل له درقة شوكية ولكنه يفتقر إلى المخالب الكبيرة للكركند الحقيقي)",
 "sea creature": "حيوان بحري, كائن بحري (أي من الحيوانات العديدة التي تعيش في البحر بما في ذلك الأسماك والرخويات والعديد من الثدييات)",
 "sea cucumber": "خيار البحر (الإسم من الإختيار ، وهو إنتقاء شيء فيكون خير من غيره؛ صيغة جمع لخير ، بمعنى أفضل)\nمثال: لم يكن لدي خيار.",
 "sea dahlia": "داليا البحر (عشبة قوية بأزهار واحدة لكل ساق؛ نبات زينة مطور من زهرة برية مكسيكية)",
 "sea dog": "بحار (رجل يخدم كبحار)",
 "sea duck": "بط بحري (أي من أنواع البط الغواص الكبير الموجود على طول ساحل البحر: العيدر، الأسقطر، البلقشة)",
 "sea eagle": "عقاب البحر (أي من العقبان الكبيرة المتنوعة التي تتغذى عادة على الأسماك) / عقاب نسارية (صقر كبير غير ضار يوجد في جميع أنحاء العالم يتغذى على الأسماك ويبني عشاً ضخماً غالباً ما يتم شغله لسنوات)",
 "sea elephant": "فيل البحر (أي من نوعين من الفقمات الكبيرة عديمة الأذن في شمال المحيط الأطلسي لها خطم يشبه الخرطوم)",
 "sea eryngium": "شوك البحر, قرصعنة بحرية (قرصعنة أوروبية دائمة الخضرة بأوراق شائكة ملتوية تم توطينها في الساحل الشرقي للولايات المتحدة؛ كانت جذورها تستخدم سابقاً كمنشط جنسي)",
 "sea fan": "مروحة البحر (شعاب مرجانية لها هيكل قرني يشبه الشجرة أو المروحة)",
 "sea feather": "ريشة البحر (شعاب مرجانية تشكل مستعمرات تشبه الريش)",
 "sea floor": "قاع البحر, قاع المحيط (الجزء السفلي من بحر أو محيط)",
 "sea god": "إله البحر (إله يجسد البحر ويُعتقد عادةً أنه يعيش فيه أو يسيطر عليه)",
 "sea gooseberry": "عنب البحر (مشطيات لها جسم مستدير مع صفوف طولية من الأهداب)",
 "sea green": "أخضر بحري (خاصية اللون الأخضر المتوسط الذي يشبه مياه البحر)",
 "sea gull": "نورس (طائر مائي أبيض في الغالب ذو أجنحة طويلة مدببة وأرجل قصيرة)",
 "sea hare": "أرنب البحر (بطني قدم بحري عارٍ له جسم رخو بصدفة داخلية مختزلة وزوجين من المجسات تشبه الأذن)",
 "sea holly": "قَرْصَعَنَّة / شِنْدَاب",
 "sea holm": "شوك البحر, قرصعنة بحرية (قرصعنة أوروبية دائمة الخضرة بأوراق شائكة ملتوية تم توطينها في الساحل الشرقي للولايات المتحدة؛ كانت جذورها تستخدم سابقاً كمنشط جنسي)",
 "sea horse": "فَرَس بَحْر (أقوام تسكن شرق العِرَاق، يقال أنهم أقوام آرِيَّة)\nمثال: الفرس هي أنثى الحصان",
 "sea island cotton": "قطن جزر البحر (شجرة كثيفة صغيرة تنمو في جزر الكاريبي وقبالة الساحل الأطلسي لجنوب الولايات المتحدة؛ تنتج قطناً بألياف حريرية طويلة بشكل غير عادي)",
 "sea kale": "كرامبي, كرنب بحري (نبات معمر في الرمال الساحلية والحصى لشمال أوروبا وبحر البلطيق والبحر الأسود له عناقيد من الزهور البيضاء الصغيرة وأوراق زرقاء خضراء لحمية كبيرة تستخدم…)",
 "sea king": "ملك البحر (زعيم قراصنة فايكنج ذكر)",
 "sea ladder": "سلم السفينة, سلم بحري ((في الملاحة) سلم يُنزل على جانب السفينة للصعود إليها)",
 "sea lamprey": "جلكى بحرية (جلكى كبيرة مهاجرة تستخدم أحياناً كغذاء؛ مدمرة لحيوانات الأسماك المحلية في البحيرات العظمى)",
 "sea lane": "طريق ملاحي, ممر بحري (ممر في البحر يعتبر طريقاً منتظماً للسفن)",
 "sea lavender": "لافندر البحر, ليمونيوم (أي من نباتات مختلفة من جنس ليمونيوم في المستنقعات الملحية المعتدلة لها سنابل من الزهور البيضاء أو البنفسجية الباهتة)",
 "sea lawyer": "بحار مجادل (بحار مجادل ومشاكس)",
 "sea lettuce": "خس البحر (عشب بحري ذو سعف أخضر مجعد شفاف صالح للأكل)",
 "sea level": "مُسْتَوَى سَطْح البَحْر (مستوى سطح المحيط (خاصة المتوسط بين المد والجزر)؛ يُستخدم كمعيار في حساب ارتفاع اليابسة أو عمق البحر)",
 "sea lily": "زنبق البحر (كرينويد بأذرع مشعة دقيقة وجسم ذو ساق ملتصق بسطح صلب)",
 "sea lion": "أَسَد بَحْر, كَلْب البَحْر (نوع من السباع مفترس من فصيلة السنوريات، يشتهر بفروة تحيط برقبته. أنثاه لبوة. يُعرَف بمَلِك الغابة؛  الرجل الشجاع القوي. مؤنثه أَسَدَة)\nمثال: الأسد حيوان بري.",
 "sea louse": "قمل البحر (قشريات بحرية متماثلة الأرجل)",
 "sea lyme grass": "عشبة الكثبان الأوروبية, عشبة لايم البحرية (عشبة كثبان في ساحل المحيط الهادئ تستخدم كمثبت للرمال)",
 "sea mat": "حيوان طحلبي, مرجانيات (حيوان مائي لاطئ يشكل مستعمرات طحلبية من سلائل صغيرة)",
 "sea mew": "نورس شائع (النورس الشائع في أوراسيا وشمال شرق أمريكا الشمالية)",
 "sea mile": "ميل بحري (وحدة بريطانية سابقة للطول كانت تستخدم في الملاحة؛ تعادل 6,000 قدم)",
 "sea milkwort": "حلاب البحر, غلوكس (عشب لحمي صغير شائع على طول شواطئ أمريكا الشمالية وفي المستنقعات المالحة وله أزهار وردية أو بيضاء)",
 "sea moss": "طحلب بحري (أي من الطحالب الحمراء المختلفة ذات السعف الوردي إلى الأرجواني الرشيق (مثل الدلسي أو الكاراجين)) / حيوان طحلبي, مرجانيات (حيوان مائي لاطئ يشكل مستعمرات طحلبية من سلائل صغيرة)",
 "sea mouse": "فأر البحر (أي من عدة ديدان كبيرة لها جسم مسطح عريض مع حصيرة من الشعر الخشن تغطي الظهر)",
 "sea nymph": "حورية البحر ((الأساطير اليونانية) حورية ماء كانت ابنة لأوقيانوس أو نيريوس)",
 "sea of azov": "بَحْر آزُوف (شَقّ الأرض؛ التَحَيُّر والبَهْت من الفزع أو من شدة العَطَش فنظر لا يقصد شيئا)\nمثال: هبطت على البحر.",
 "sea of galilee": "بُحَيْرَة طَبَرِيَّة (مسطح مائي واسع كالبحر المغلق فيه ماء حلو أو شبه حلو صالح للشرب)\nمثال: سبحنا في البحيرة.",
 "sea of japan": "بَحْر اَلْيَابَان (شَقّ الأرض؛ التَحَيُّر والبَهْت من الفزع أو من شدة العَطَش فنظر لا يقصد شيئا)\nمثال: هبطت على البحر.",
 "sea of okhotsk": "بَحْر أُوخُوتْسْك (شَقّ الأرض؛ التَحَيُّر والبَهْت من الفزع أو من شدة العَطَش فنظر لا يقصد شيئا)\nمثال: هبطت على البحر.",
 "sea onion": "إشْقِيل, بَصَل الفَأْر",
 "sea otter": "قضاعة البحر (قضاعة بحرية كبيرة من سواحل شمال المحيط الهادئ ذات فراء بني داكن سميك جداً)",
 "sea pea": "بازلاء الشاطئ, جلبان بحري (بازلاء برية في شواطئ المنطقة المعتدلة الشمالية لها جذور قوية وزهور أرجوانية ومفيدة كمثبت للرمال)",
 "sea pen": "قلم البحر (مستعمرات لحمية تشبه الريش تعيش في المياه الدافئة)",
 "sea pink": "قرنفل البحر, ورد الجرف (نبات معنقد في السواحل والجبال في المنطقة المعتدلة الشمالية؛ يزرع أحياناً كغطاء أرضي)",
 "sea poacher": "صيادة (سمكة صغيرة نحيلة (تصل إلى 8 بوصات) جسمها مغطى بصفائح عظمية؛ تعيش بشكل رئيسي في مياه شمال المحيط الهادئ العميقة)",
 "sea poker": "صيادة (سمكة صغيرة نحيلة (تصل إلى 8 بوصات) جسمها مغطى بصفائح عظمية؛ تعيش بشكل رئيسي في مياه شمال المحيط الهادئ العميقة)",
 "sea poppy": "خشخاش أصفر, خشخاش مقرن (عشب أوراسي أزرق مخضر ذو زهور صفراء تم توطينه على طول الشواطئ الرملية في شرق أمريكا الشمالية)",
 "sea power": "قوة بحرية (القوة العسكرية البحرية) / قوة بحرية (أمة تمتلك قوة بحرية هائلة)",
 "sea purse": "تيار ساحب, جرف (تيار تحتي يتجه نحو البحر ينشأ بعد تكسر الأمواج على الشاطئ)",
 "sea puss": "تيار ساحب, جرف (تيار تحتي يتجه نحو البحر ينشأ بعد تكسر الأمواج على الشاطئ)",
 "sea queen": "قرصانة, ملكة البحر (زعيمة قراصنة فايكنغ أنثى)",
 "sea raven": "غراب البحر (سمكة إسقلبين كبيرة في غرب المحيط الأطلسي؛ تنفخ نفسها عند صيدها)",
 "sea robber": "قرصان (شخص يسرق في البحر أو ينهب الأرض من البحر دون أن يكون لديه تفويض من أي دولة ذات سيادة)",
 "sea robin": "السمكة الطيارة, روبن البحر (غرنار أمريكي؛ يوجد غالباً في الخلجان ومصبات الأنهار)",
 "sea room": "مَجَال بَحْرِيّ (مساحة للمناورة في البحر)",
 "sea rover": "قرصان (شخص يسرق في البحر أو ينهب الأرض من البحر دون أن يكون لديه تفويض من أي دولة ذات سيادة)",
 "sea scallop": "إسقلوب البحر (إسقلوب كبير يسكن المياه العميقة لساحل المحيط الأطلسي لأمريكا الشمالية) / إسقالوب البحر (عضلة الإسقالوب الكبير من المياه العميقة)",
 "sea scooter": "دراجة مائية, سكوتر مائي (قارب آلي يشبه السكوتر الآلي)",
 "sea scorpion": "سمكة العقرب, عقرب البحر (أسماك بحرية لها جسم مستدق ورأس مدرع وأشواك سامة)",
 "sea scout": "كشاف بحري (كشاف مسجل في برامج للأنشطة المائية)",
 "sea serpent": "ثعبان البحر الأسطوري (مخلوق ضخم في البحر يشبه الثعبان أو التنين)",
 "sea slater": "قمل البحر (قشريات بحرية متماثلة الأرجل)",
 "sea slug": "بزاق البحر, عاريات الخياشيم (أي من بطنيات القدم البحرية المختلفة من رتيبة عاريات الخياشيم التي لها جسم عديم الصدفة وغالباً ما يكون ملوناً بشكل جميل)",
 "sea snail": "سمكة الحلزون (أسماك صغيرة تشبه الشرغوف تعيش في المياه الباردة مع زعانف حوضية تشكل ممصاً؛ مرتبطة بسمكة الكتل)",
 "sea snake": "ثعبان البحر (أي من الثعابين المائية السامة الولودة العديدة التي لها ذيل يشبه الزعنفة؛ من البحار الساحلية الدافئة؛ تتغذى على الأسماك التي تشلها بسم سريع المفعول)",
 "sea spider": "عنكبوت البحر (أي من المفصليات البحرية الصغيرة المختلفة التي تشبه العناكب ولها أجسام صغيرة رفيعة وأرجل طويلة نحيلة)",
 "sea spray": "رذاذ البحر (رذاذ من أمواج المحيط)",
 "sea spurry": "دحسية حمراء, دحسية رملية (عشب ضار منبسط بأزهار وردية صغيرة؛ واسع الانتشار في جميع أنحاء أوروبا وآسيا على الكثبان الرملية والخلنج والمنحدرات الساحلية؛ مستوطن في شرق أمريكا…)",
 "sea squab": "سمك ينفوخ, سمكة منتفخة (طعام شهي ولكنه خطير جداً بسبب سم عصبي قوي في المبايض والكبد)",
 "sea squill": "بصل البحر, عنصل بحري (ذو سنابل كثيفة من الزهور البيضاء الصغيرة وينتج بصلة ذات خصائص طبية)",
 "sea squirt": "بخاخ البحر (زقاقية يمكنها تقليص جسمها وقذف تيارات من الماء)",
 "sea star": "نجم البحر (شوكيات جلد تتميز بخمسة أذرع تمتد من قرص مركزي)",
 "sea starwort": "أستر البحر, نجمة البحر (أستر أوروبي شائع ينمو في المستنقعات المالحة)",
 "sea steps": "سلم السفينة, سلم بحري ((في الملاحة) سلم يُنزل على جانب السفينة للصعود إليها)",
 "sea swallow": "خرشنة مألوفة (خرشنة شائعة في أوراسيا وأمريكا ذات ريش أبيض وأسود ورمادي)",
 "sea tang": "طحلب بحري (أي من الأعشاب البحرية الخشنة المختلفة)",
 "sea tangle": "لامينارية (أي من أعشاب البحر المختلفة خاصة من جنس لامينارية)",
 "sea trifoly": "حلاب البحر, غلوكس (عشب لحمي صغير شائع على طول شواطئ أمريكا الشمالية وفي المستنقعات المالحة وله أزهار وردية أو بيضاء)",
 "sea trout": "ترويت بحري (نوع بحري فضي اللون من الترويت البني يهاجر إلى المياه العذبة للتكاثر) / ترويت بحري (أي من عدة أسماك بهارية في المياه الساحلية لأمريكا الشمالية) / تراوت بحري (لحم التراوت البحري الذي يهاجر من المياه المالحة إلى العذبة)",
 "sea turtle": "سلحفاة بحرية (أي من سلاحف كبيرة متنوعة ذات أطراف معدلة إلى زعانف؛ واسعة الانتشار في البحار الدافئة)",
 "sea urchin": "قُنْفُذ البَحْر",
 "sea wolf": "أوركا, حوت قاتل (حوت مسنن مفترس أسود وأبيض ذو زعنفة ظهرية كبيرة؛ شائع في البحار الباردة)",
 "sea wormwood": "شيح البحر (نباتات السواحل الأوروبية الغربية والشمالية)",
 "sea wrack": "عشب البحر (نمو النباتات البحرية وخاصة الأشكال الكبيرة مثل طحالب الصخور وعشب البحر) / حشيشة البحر, زوستيرا (نبات بحري مغمور بأوراق ضيقة طويلة جداً يوجد بكثرة على طول سواحل شمال الأطلسي)",
 "sea-coast": "ساحل, ساحل البحر (شاطئ البحر أو المحيط)",
 "sea-duty": "خدمة بحرية (خدمة بحرية على متن سفينة في البحر)",
 "sea-ear": "أذن البحر الأوروبية (أذن بحر توجد بالقرب من جزر القنال)",
 "sea-green": "أَخْضَر بَحْرِيّ (بلون البحر؛ أخضر مزرق)",
 "sea-level": "عَلَى مُسْتَوَى سَطْح البَحْر, مُنْخَفِض (يقع تحت المستوى الطبيعيّ)",
 "sea-level pressure": "ضغط مستوى سطح البحر (الضغط الجوي المخفض بواسطة صيغة إلى الضغط عند مستوى سطح البحر)",
