 "scincid lizard": "سقنقور (سحلية رشيقة يقظة ذات أطراف مختزلة وجسم ممدود مغطى بقشور لامعة؛ تعتمد على الرطوبة أكثر من معظم السحالي؛ توجد في المناطق الاستوائية حول العالم)",
 "scindapsus aureus": "بوثوس, بوثوس ذهبي (ليانا دائمة الخضرة تزرع على نطاق واسع لأوراقها المبرقشة)",
 "scintigram": "مخطط ومضاني (تسجيل للنشاط الإشعاعي المنبعث من مادة تتبع في كائن حي أو نظام عضوي)",
 "scintigraph": "جهاز المسح الومضاني, جهاز الومضان (الجهاز المستخدم لعمل مخطط ومضاني)",
 "scintilla": "بَرِيق, وَمْضَة (جسيم لامع متلألئ) / ذرة, مثقال ذرة (كمية صغيرة جداً أو نادرة الوجود)",
 "scintillant": "بَرَّاق, مُتَلَأْلِئ (ذُو وَمَضَاتٍ قَصِيرَةٍ وبَرَّاقَة مِنَ الضَّوْء)",
 "scintillate": "تَأَلَّقَ, تَلَأْلَأَ",
 "scintillating": "بَرَّاق, مُتَلَأْلِئ (ذُو وَمَضَاتٍ قَصِيرَةٍ وبَرَّاقَة مِنَ الضَّوْء) / فَوَّار, مُتَأَلِّق (يتميّز بروح عالية أو حماسة متّقدة) / لَامِع, مُتَأَلِّق (بارع ومتألق في الذكاء)",
 "scintillating scotoma": "عتمة وميضية (منطقة موضعية من الرؤية الضعيفة محاطة بأضواء ملونة متلألئة؛ تشير عند العديد من الناس إلى بداية الصداع النصفي)",
 "scintillation": "تَلَأْلُؤ, وَمِيض (وميض النجوم الناتج عن التغيرات في كثافة الغلاف الجوي للأرض مما يسبب انكساراً غير متساوٍ لضوء النجوم) / بريق, تألق (صفة اللمعان بضوء منعكس ساطع) / توقد ذهن, تيقظ (عرض رائع للفطنة) / تلألؤ, وميض (تغير سريع في السطوع؛ شرارة قصيرة أو وميض)",
 "scintillation counter": "عداد الومضان (أنبوب عداد تومض فيه الضوء عند تعرضه للإشعاع المؤين)",
 "scintiscanner": "جهاز المسح الومضاني, جهاز الومضان (الجهاز المستخدم لعمل مخطط ومضاني)",
 "sciolism": "ادعاء المعرفة (سطحية مدعية للمعرفة)",
 "sciolist": "متطفل, هاوٍ غير جدي (هاوٍ ينخرط في نشاط دون نوايا جادة ويدعي المعرفة)",
 "sciolistic": "مُتَطَفِّل, هَاوٍ سَطْحِيّ (يُظهِر اهتمامًا سطحيًّا أو تافهًا؛ على مستوى الهواة)",
 "scion": "سليل (حفيد أو وريث)\nمثال: سليل أصل ملكي",
 "scire facias": "أمر إخطار قضائي (أمر قضائي يستند إلى سجل ويتطلب من الطرف الذي رفع ضده إظهار السبب في عدم إنفاذ السجل أو إلغائه)",
 "scirpus acutus": "أسل, بوط صلب الساق (سعد واسع الانتشار في أمريكا الشمالية له سيقان خضراء زيتونية صلبة)",
 "scirpus cyperinus": "عشب الصوف (سعد من شرق أمريكا الشمالية له العديد من السنيبلات الصوفية المتجمعة)",
 "scission": "انشطار, انقسام (عملية التقسيم عن طريق القطع أو الشق)",
 "scissor grip": "مسكة المقص (مسكة مصارعة تلف فيها ساقيك حول جسم الخصم أو رأسه وتضم قدميك وتعصر)",
 "scissor hold": "مسكة المقص (مسكة مصارعة تلف فيها ساقيك حول جسم الخصم أو رأسه وتضم قدميك وتعصر)",
 "scissor kick": "رَكْلَة ازْدِوَاجِيَّة",
 "scissor-tailed": "مِقَصِّيّ الذَّيْل ((للطيور) ذو ذيل متشعّب بعمق)",
 "scissor-tailed flycatcher": "صائد الذباب مقصي الذيل (صائد ذباب رمادي من جنوب غرب الولايات المتحدة والمكسيك وأمريكا الوسطى له ذيل طويل متشعب وصدر أبيض وعلامات بلون السلمون والقرمزي)",
 "scissors": "مِقَصّ, مِقْرَاض",
 "scissors grip": "مسكة المقص (مسكة مصارعة تلف فيها ساقيك حول جسم الخصم أو رأسه وتضم قدميك وتعصر)",
 "scissors hold": "مسكة المقص (مسكة مصارعة تلف فيها ساقيك حول جسم الخصم أو رأسه وتضم قدميك وتعصر)",
 "scissors kick": "ركلة المقص (ركلة تستخدم في سباحة الجنب؛ يتم ضم الساقين معاً في حركة مقصية)",
 "scissortail": "صائد الذباب مقصي الذيل (صائد ذباب رمادي من جنوب غرب الولايات المتحدة والمكسيك وأمريكا الوسطى له ذيل طويل متشعب وصدر أبيض وعلامات بلون السلمون والقرمزي)",
 "scissortailed flycatcher": "صائد الذباب مقصي الذيل (صائد ذباب رمادي من جنوب غرب الولايات المتحدة والمكسيك وأمريكا الوسطى له ذيل طويل متشعب وصدر أبيض وعلامات بلون السلمون والقرمزي)",
 "scissure": "شق, صدع (شق ضيق وطويل)",
 "sciurus carolinensis": "سنجاب رمادي شرقي (سنجاب متوسط إلى كبير شائع في شرق أمريكا الشمالية؛ أُدخل الآن إلى إنجلترا)",
 "sciurus griseus": "سنجاب رمادي غربي (سنجاب رمادي كبير من المناطق الغربية البعيدة للولايات المتحدة)",
 "sciurus hudsonicus": "سنجاب أحمر أمريكي (من شمال الولايات المتحدة وكندا)",
 "sciurus niger": "سنجاب الثعلب (سنجاب شجري كبير بشكل استثنائي من شرق الولايات المتحدة)",
 "sciurus vulgaris": "سنجاب أحمر (سنجاب بني محمر شائع في أوروبا وأجزاء من آسيا)",
 "sclaff": "ضربة كاشطة (ضربة غولف سيئة يضرب فيها رأس المضرب الأرض قبل ضرب الكرة)",
 "sclera": "مُقْلَة, بَيَاض اَلْعَيْن",
 "scleral veins": "أوردة صلبة (روافد للأوردة الهدبية الأمامية التي تصرف صلبة العين)",
 "scleranthus annuus": "كنوال, مصلبة (عشب أوراسي منخفض النمو واسع الانتشار له أوراق ضيقة وأزهار خضراء غير واضحة)",
 "scleredema": "وذمة صلبة (مرض جلدي يتميز بوذمة صلبة في الأنسجة تبدأ عادة في الوجه)",
 "sclerite": "صُلَيْبَة (صفيحة صلبة أو عنصر من الهيكل الخارجي لبعض المفصليات)",
 "scleritis": "التهاب الصلبة (التهاب صلبة العين)",
 "scleroderma": "تصلب الجلد (مرض مناعي ذاتي يصيب الأوعية الدموية والنسيج الضام)",
 "scleroderma aurantium": "سكليروديرما ليمونية (فطر كرة أرضية لونه أصفر بني باهت وداخله أرجواني داكن؛ الغلاف مغطى بنمط من الثآليل الصغيرة)",
 "scleroderma bovista": "سكليروديرما بوفيستا (كرة أرضية ذات غلاف صلب جاف وأملس عندما تكون صغيرة ولكن تتطور فيها شقوق عند النضج؛ برتقالية صفراء شاحبة عندما تكون صغيرة وبنية محمرة عند النضج)",
 "scleroderma citrinum": "سكليروديرما ليمونية (فطر كرة أرضية لونه أصفر بني باهت وداخله أرجواني داكن؛ الغلاف مغطى بنمط من الثآليل الصغيرة)",
 "scleroderma flavidium": "سكليروديرما صفراء (كرة أرضية ذات سطح علوي أملس تكون مدفونة في الرمل في البداية؛ ينفتح الجزء العلوي من الجسم الثمري ليشكل قطعاً تشبه شعاع الخيمة)",
 "sclerometer": "مقياس الصلابة (أداة قياس تقيس صلابة المواد عن طريق اختراقها بقلم له نقطة ماسية)",
 "scleroprotein": "بروتين صلب (بروتين بسيط يوجد في الأنسجة القرنية والغضروفية وفي عدسة العين)",
 "sclerosed": "تصلبي, متصلب (متعلق بـ أو مصاب بالتصلب؛ متصلب)\nمثال: مريض متصلب",
 "sclerosing leukoencephalitis": "التهاب الدماغ المصلب تحت الحاد (التهاب دماغ مزمن نادر ومترقٍ يسببه فيروس الحصبة ويحدث بشكل أساسي عند الأطفال والشباب؛ تحدث الوفاة عادة في غضون ثلاث سنوات)",
 "sclerosis": "تَصَلُّب",
 "sclerotic": "صلبي (مكون من أو متعلق بصلبة العين) / تصلبي, متصلب (متعلق بـ أو مصاب بالتصلب؛ متصلب)\nمثال: نسيج صلبي",
 "sclerotic coat": "صلبة (الغشاء الليفي الأبيض (الغلالة البيضاء) الذي يشكل مع القرنية الغطاء الخارجي وحماية لمقلة العين)",
 "sclerotinia": "سكليروتينيا (أي فطر من جنس سكليروتينيا؛ يسبب بعضها أمراض العفن البني في النباتات)",
 "sclerotium": "جسم حجرى, صلبة (كتلة مدمجة عادة داكنة اللون من الغزل الفطري المتصلب تشكل جسماً نباتياً لتخزين الغذاء في الفطريات الحقيقية المختلفة؛ تنفصل عند النضج ويمكن أن تؤدي إلى…)",
 "sclerotium disease": "عفن متصلب",
 "sclerotium rot": "عفن متصلب",
 "sclerotomy": "بضع الصلبة (شق جراحي للطبقة الصلبة للعين)",
 "sclk": "توقيت ساعة المركبة الفضائية (وقت الساعة المعروض بواسطة ساعة محمولة على متن مركبة فضائية)",
 "scnt": "نقل نواة الخلية الجسدية (نقل نواة الخلية ومادتها الوراثية من خلية إلى أخرى)",
 "scoff": "اسْتِهْزَاء, تَهَكُّم (إظهار الازدراء عن طريق السخرية)",
 "scoffer": "ساخر, شامت (شخص يسخر أو يتهكم أو يعامل شيئاً باحتقار) / أكول, ملتهم (شخص يأكل الطعام بسرعة وشراهة)",
 "scoffing": "اسْتِهْزَاء, تَهَكُّم (إظهار الازدراء عن طريق السخرية)",
 "scoffingly": "بِاسْتِهْزَاء, بِتَهَكُّم (بطريقة غير محترمة وساخرة)\nمثال: 'آسفة'، كررت باستهزاء",
 "scofflaw": "مستهين بالقانون (من يتجاهل القانون عادة ولا يستجيب لاستدعاءات المحكمة)",
 "scoinson arch": "قوس داخلي (قوس يدعم جزءاً من الجدار)",
 "scoke": "توت الحمام, صبغة أمريكية (عشبة أمريكية معمرة طويلة خشنة ذات أزهار بيضاء صغيرة تليها توت أسود محمر على عناقيد متدلية طويلة؛ السيقان اللحمية الصغيرة صالحة للأكل؛ التوت والجذر…)",
 "scold": "اِمْرَأَة سَلِيطَة (أُنْثَى الْإِنْسَانِ الْبَالِغَةُ؛ زَوْجَةٌ) / وَبَّخَ (التأنيب بشدة)\nمثال: أنا امرأة قوية.",
 "scolder": "كثير التذمر, لحوح (شخص (خاصة امرأة) يزعج الناس بكثرة البحث عن الأخطاء)",
 "scolding": "تَعْنِيف, تَقْرِيع (توبيخ شخص ما بقسوة)",
 "scolion": "أغنية المأدبة, سكوليون (أغنية (أحياناً مرتجلة) يغنيها الضيوف في مأدبة)",
 "scoliosis": "جَنَف (مَالَ عَنِ الحَقِّ أَوِ العَدْلِ؛ عَدَلَ عَنْهُ وَابْتَعَدَ وَمَالَ)",
 "scollop": "إسقلوب (رخوي بحري ذو صدفتين صالح للأكل له صدفة مخددة تشبه المروحة يسبح عن طريق طرد الماء من الصدفة في سلسلة من حركات الطقطقة) / إسكالوب, شريحة لحم (شريحة رقيقة من اللحم (خاصة العجل) تُقلى أو تُشوى عادة) / إسقالوب, محار مروحي (عضلة الرخويات ذات الصدفة المروحية الصالحة للأكل؛ تقدم مشوية أو مسلوقة أو في السلطات أو صلصات الكريمة)",
 "scolopax rusticola": "دجاجة الأرض الأوراسية (دجاجة أرض مهاجرة من العالم القديم قصيرة الساقين وطويلة المنقار)",
 "scolopendrium": "سرخس أم أربعة وأربعين, سكولوبندريوم (سرخس يعتقد أنه يشبه دودة الألفية)",
 "scolopendrium nigripes": "شافنيريا (سرخس من جنس شافنيريا)",
 "scolymus hispanicus": "سكوليمس, نبات المحار الإسباني (شوك ذهبي من جنوب غرب أوروبا يُزرع لجذوره الحلوة الصالحة للأكل وأوراقه وسيقانه الصالحة للأكل؛ تستخدم زهوره الصفراء كبديل للزعفران)",
 "scolytus multistriatus": "خنفساء الدردار الهولندية (ناقل للفطر المسبب لمرض الدردار الهولندي)",
 "scomber colias": "ماكريل إسباني (ماكريل متوسط الحجم في المحيط الأطلسي المعتدل وخليج المكسيك)",
 "scomber japonicus": "ماكريل تشوب (ماكريل صغير يوجد في جميع أنحاء العالم تقريباً)",
 "scomber scombrus": "ماكريل شائع (سمكة طعام مهمة في شمال المحيط الأطلسي والبحر الأبيض المتوسط؛ جسمها أزرق مخضر مع قضبان داكنة وحراشف صغيرة إن وجدت)",
 "scomberesox saurus": "سمك الصوري (سمكة نحيلة طويلة المنقار من مياه المحيط الأطلسي المعتدلة)",
 "scomberomorus cavalla": "كافالا, ماكريل الملك (ماكريل كبير ذو خطم مدبب طويل؛ سمكة طعام وصيد مهمة في ساحل المحيط الأطلسي الشرقي جنوباً إلى البرازيل)",
 "scomberomorus maculatus": "ماكريل إسباني أطلسي (ماكريل كبير مهم تجارياً في المياه الساحلية الأطلسية لأمريكا الشمالية)",
 "scomberomorus regalis": "بينتادو, سيرو (ماكريل كبير صالح للأكل في المياه الساحلية الأطلسية المعتدلة للولايات المتحدة)",
 "scomberomorus sierra": "سييرا (ماكريل إسباني في غرب أمريكا الشمالية)",
 "scombroid": "إسقمريات (أسماك غذائية ورياضية بحرية مهمة توجد في جميع البحار الاستوائية والمعتدلة؛ بعضها على الأقل ماص للحرارة جزئياً ويمكن أن يزدهر في المياه الباردة)",
 "scombroid fish": "إسقمريات (أسماك غذائية ورياضية بحرية مهمة توجد في جميع البحار الاستوائية والمعتدلة؛ بعضها على الأقل ماص للحرارة جزئياً ويمكن أن يزدهر في المياه الباردة)",
 "sconce": "شمعدان جداري (دعامة حائط زخرفية لحمل الشموع أو مصادر الضوء الأخرى) / شمعة الشمعدان (شمعة أو شعلة مشتعلة مثبتة في شمعدان جداري) / حصن صغير (حصن صغير أو ساتر ترابي يدافع عن مخاضة أو ممر أو بوابة قلعة) / ساتر (مأوى أو حاجز يوفر الحماية من نيران العدو أو من الطقس)",
 "sconcheon arch": "قوس داخلي (قوس يدعم جزءاً من الجدار)",
 "scone": "سكون, كعكة سكون (بسكويت صغير (غني بالكريمة والبيض) يقطع إلى أشكال معينة ويخبز في فرن أو على صاج)",
 "scooby-doo": "سكوبي دو",
 "scoop": "مِغْرَفَة",
 "scoop shot": "رمية مجرفة (رمية كرة سلة تتم بحركة تجريف من الأسفل)",
 "scoop shovel": "مجرفة غرف, مغرفة (مجرفة أو دلو الجرافة أو الحفار الخلفي)",
 "scoopful": "ملء مغرفة (الكمية التي تستوعبها مغرفة)",
 "scooter": "سْكُوتَر / بِسْكِلِيتَّة",
 "scopal": "نطاقي (من أو يتعلق بالنطاق (في المنطق واللغويات))\nمثال: تبعية نطاقية",
 "scope": "حَيِّز",
 "scopes trial": "محاكمة سكوبس (محاكمة حظيت بدعاية كبيرة في عام 1925 عندما انتهك جون توماس سكوبس قانون ولاية تينيسي بتدريس التطور في المدرسة الثانوية؛ تمت محاكمة سكوبس من قبل ويليام…)",
 "scophthalmus aquosus": "لوح الزجاج, ويندوبين (سمكة مفلطحة شفافة رقيقة جداً في ساحل المحيط الأطلسي لأمريكا الشمالية)",
 "scophthalmus rhombus": "بريل (سمكة طعام أوروبية)",
 "scopolamine": "سكوبولامين, هيوسين (قلويد له تأثيرات مضادة للكولين يستخدم كمهدئ ولعلاج الغثيان ولتوسيع حدقة العين في الإجراءات العينية)\nمثال: يستخدم السكوبولامين عبر الجلد لعلاج دوار الحركة",
 "scopolia carniolica": "سكوبوليا (عشب يعتبر مصدراً للسكوبولامين)",
 "scops owl": "بومة بتي (أي من البوم الصغير المتعدد الذي له خصلات أذن ونداء صفير)",
 "scorbutic": "إسقربوطي (من أو متعلق بـ أو لديه أو يشبه داء الإسقربوط)\nمثال: أعراض إسقربوطية",
 "scorbutus": "إسقربوط (حالة ناتجة عن نقص حمض الأسكوربيك (فيتامين ج))",
 "scorch": "حرق سطحي, شياط (تغير في اللون ناتج عن الحرارة) / لفحة (مرض نباتي ينتج مظهراً بنياً أو محروقاً لأنسجة النبات) / حرق سطحي (حرق في السطح)",
 "scorched": "مَحْرُوقُ الأَرْض (دُمِّرَ كُلُّ شَيْءٍ فِيهِ حَتَّى لَا يَبْقَى مَا يُنْقَذُ مِنَ العَدُوّ) / مُحْتَرِق, يَابِس مِنَ الحَرّ (جفّ بفعل الحرارة أو التعرّض المفرط لأشعّة الشمس)",
 "scorched earth": "سِيَاسَةُ الأَرْضِ المَحْرُوقَة (بمعنى رعى الغنم وقادها؛ بمعنى قاد الناس وحَكَمَهم باللين والحكمة لا بالغصب والقهر)\nمثال: عاد إلى السياسة.",
 "scorched-earth policy": "سِيَاسَةُ الأَرْضِ المَحْرُوقَة (بمعنى رعى الغنم وقادها؛ بمعنى قاد الناس وحَكَمَهم باللين والحكمة لا بالغصب والقهر)\nمثال: عاد إلى السياسة.",
 "scorcher": "تسديدة صاروخية (كرة مضروبة بقوة شديدة) / يوم قائظ (يوم حار للغاية)",
 "scorching": "بشكل حارق, بلهيب (قادر على إحداث حروق (تستخدم عادة لوصف شدة الحرارة)) / حَارِق, لَافِح (شديد الحرارة والجفاف بما يكفي لحرق السطح أو تجفيفه)\nمثال: كان الجو حاراً بشكل حارق",
 "scorchingness": "حرارة لافحة, شدة الحر (صفة الحرارة الحارقة)\nمثال: كان اليوم هو أول يوم تتجاوز فيه الحرارة 100 درجة في موسم الحر اللافح",
 "score": "إِصَابَة (إِلحاق الأَذى بالجسم، الجُرْح؛ مَرَضٌ أو عَدْوَى) / دَرَجَة\nمثال: تعرض زيري لإصابة.",
 "score paper": "ورق موسيقي (ورق مسطر بخطوط مناسبة لكتابة الموسيقى)",
 "scoreboard": "لوحة النتائج (لوحة كبيرة لعرض نتيجة المسابقة (وبعض المعلومات الأخرى))",
 "scorecard": "بطاقة النتائج ((غولف) سجل للنتائج (كما في الغولف))\nمثال: عليك تسليم بطاقتك للحصول على إعاقة",
 "scorekeeper": "مسجل النقاط (مسؤول يسجل النتيجة أثناء سير المباراة)",
 "scoreless": "بِلَا أَهْدَاف, بِلَا نِقَاط (لم يُسجَّل فيه أي نقاط أو أهداف)",
 "scorer": "مسجل النقاط (مسؤول يسجل النتيجة أثناء سير المباراة) / علّام الأشجار (حطاب يضع علامات على الأشجار المراد قطعها) / مُسجّل (لاعب يحرز نقاطاً في لعبة أو مسابقة)",
 "scores": "أطنان, أكوام (عدد أو كمية كبيرة)\nمثال: كون الكثير من الصداقات الجديدة",
 "scoria": "خَبَث (الزبد المتكون بفعل الأكسدة على سطح المعادن المنصهرة)",
 "scoring": "تصحيح, وضع الدرجات (تقييم الأداء عن طريق تعيين درجة أو نتيجة)\nمثال: ما كرهه في التدريس هو كل التصحيح الذي كان عليه القيام به",
 "scoring system": "نظام تسجيل, نظام تقييم (نظام للتصنيف وفقاً للجودة أو الجدارة أو الكمية)",
 "scorn": "اِحْتَقَرَ / استنكف / استخف",
 "scorned": "مَمْقُوت, مُحْتَقَر (يُعامَل بكراهية أو ازدراء)",
 "scorner": "محتقر, مزدري (شخص يعبر عن الازدراء من خلال الملاحظات أو تعابير الوجه)",
