 "saliency": "أهمية, بروز (حالة كونه بارزاً)",
 "salient": "لَافِت, مُلْفِتٌ لِلنَّظَرِ (لَهُ صِفَةٌ تَفْرِضُ نَفْسَهَا عَلَى الِانْتِبَاهِ) / بارز ((للزوايا) تشير إلى الخارج بزاوية أقل من 180 درجة) / جيب ناتئ, نتوء عسكري ((عسكري) جزء من خط المعركة يبرز ليكون الأقرب إلى العدو)",
 "salient angle": "زاوية بارزة (زاوية تشير إلى الخارج؛ زاوية داخلية لمضلع أقل من 180 درجة)",
 "salientian": "ضفدع, علجوم (أي من البرمائيات المختلفة عديمة الذيل ممتلئة الجسم ذات أطراف خلفية طويلة للقفز؛ أنواع شبه مائية وأرضية) / بتراواني (يتعلق بالضفادع والعلاجيم)",
 "saliferous": "حَامِل لِلْمِلْح, مِلْحِيّ (يَحْتَوِي عَلَى مِلْح أَوْ يُنْتِجُه)",
 "saligenin": "ساليجينين, كحول الساليسيليك (كحول بلوري فينولي يتم الحصول عليه عادة عن طريق التحلل المائي للساليسين)\nمثال: يعمل كحول الساليسيليك كمخدر موضعي ويخفف الألم والحمى",
 "salih": "صَالِح ((في الإسلام) نبي ورد ذكره في القرآن، أُرسل إلى قوم ثمود؛ اسم شخصي معطًى للذكور من العرب)\nمثال: قم بما هو صالح.",
 "saline": "مَالِح, مِلْحِيّ (يَحْتَوِي عَلَى مِلْح) / محلول ملحي (محلول متساوي التوتر من كلوريد الصوديوم والماء المقطر)",
 "saline solution": "محلول ملحي (محلول متساوي التوتر من كلوريد الصوديوم والماء المقطر)",
 "salinity": "مِلْحِيَّة",
 "salinometer": "مقياس الملوحة (مقياس كثافة السوائل يحدد تركيز محاليل الملح عن طريق قياس كثافتها)",
 "salisbury": "سالزبوري",
 "salisbury steak": "شريحة لحم سالزبوري (قرص لحم بقر مفروم عادة مع صلصة)",
 "salish": "السالشية, لغات ساليش (عائلة من لغات موسان يتم التحدث بها في شمال غرب الولايات المتحدة وغرب كندا) / ساليش (فرد من مجموعة من هنود أمريكا الشمالية يتحدثون لغة ساليشان ويعيشون على الساحل الشمالي الغربي)",
 "salishan": "السالشية, لغات ساليش (عائلة من لغات موسان يتم التحدث بها في شمال غرب الولايات المتحدة وغرب كندا)",
 "saliva": "لُعَاب, رِيق",
 "salivary": "لُعَابِيّ",
 "salivary calculus": "حَصَاة لُعَابِيَّة (حصاة تتكون في الغدة اللعابية)",
 "salivary duct": "قناة لعابية (قناة يمر عبرها اللعاب من الغدة اللعابية إلى الفم)",
 "salivary gland": "غُدّة لُعَابِيّة",
 "salivation": "إفراز اللعاب, إلعاب (إفراز اللعاب)",
 "salix alba": "صفصاف أبيض (شجرة صفصاف كبيرة في أوراسيا وشمال أفريقيا ذات أوراق رمادية مبيضة ولحاء رمادي)",
 "salix alba caerulea": "صفصاف مضارب الكريكيت (شجرة صفصاف أوراسية ذات أوراق رمادية وفروع صاعدة)",
 "salix alba sericea": "صفصاف حريري, صفصاف فضي (صفصاف أمريكي شمالي بأوراق رمادية حريرية وبرية تسود عادة عند التجفيف)",
 "salix alba vitellina": "صفصاف ذهبي (صفصاف أوروبي له أوراق رمادية وغصينات صفراء برتقالية تستخدم في صناعة السلال)",
 "salix amygdalina": "صفصاف اللوز (صفصاف من العالم القديم بأوراق خضراء فاتحة يزرع للاستخدام في صناعة السلال)",
 "salix amygdaloides": "صفصاف خوخي الأوراق (صفصاف في غرب الولايات المتحدة بأوراق تشبه أوراق أشجار الخوخ أو اللوز)",
 "salix arctica": "صفصاف قطبي (شجيرة زاحفة منخفضة في القطب الشمالي لأوروبا وأمريكا)",
 "salix babylonica": "صفصاف بابلي, صفصاف باكي (صفصاف ذو فروع طويلة متدلية وأوراق رفيعة موطنه الصين؛ يزرع على نطاق واسع كنبات زينة)",
 "salix blanda": "صفصاف ويسكونسن الباكي (صفصاف هجين عادة لا يكون شديد التدلي في نموه)",
 "salix candida": "صفصاف أشيب, صفصاف الميرمية (شجيرة أمريكية شمالية بأوراق بيضاء مبيضة)",
 "salix caprea": "صفصاف الماعز (صفصاف كثير التفرع من العالم القديم له نورات هرية كبيرة وأوراق عريضة كبيرة نسبياً)",
 "salix cinerea": "صفصاف رمادي (صفصاف شجيري أوراسي بأغصان وبرية بيضاء)",
 "salix discolor": "صفصاف الهر, صفصاف ملون (صفصاف صغير في شرق أمريكا الشمالية ذو أوراق رمادية ونورات حريرية تظهر قبل الأوراق)",
 "salix fragilis": "صفصاف هش (شجرة صفصاف كبيرة ذات فروع صلبة تنكسر بسهولة)",
 "salix herbacea": "صفصاف عشبي, صفصاف قزم (صفصاف شجيري شمالي واسع الانتشار بسيقان زاحفة جزئياً تحت الأرض وأوراق خضراء لامعة زاهية)",
 "salix humilis": "صفصاف البراري (صفصاف شجيري نحيل في المناطق الجافة بأمريكا الشمالية)",
 "salix lasiolepis": "صفصاف أرويو (صفصاف شجيري في غرب الولايات المتحدة)",
 "salix lucida": "صفصاف لامع (شجيرة شائعة في أمريكا الشمالية بأوراق رمحية لامعة)",
 "salix nigra": "صفصاف أسود, صفصاف المستنقعات (صفصاف شجيري في أمريكا الشمالية ذو لحاء داكن وأوراق خطية ينمو بالقرب من الجداول والبحيرات)",
 "salix pendulina": "صفصاف ويسكونسن الباكي (صفصاف هجين عادة لا يكون شديد التدلي في نموه)",
 "salix pendulina blanda": "صفصاف ويسكونسن الباكي (صفصاف هجين عادة لا يكون شديد التدلي في نموه)",
 "salix pentandra": "صفصاف الغار, صفصاف خماسي الأسدية (شجرة صفصاف أوروبية بأوراق جلدية لامعة؛ متوطنة على نطاق واسع في شرق الولايات المتحدة)",
 "salix purpurea": "صفصاف أحمر, صفصاف أرجواني (صفصاف أوراسي له غصينات محمرة أو أرجوانية ولحاء غني بالعفص)",
 "salix pyrifolia": "صفصاف بلسمي (شجرة شجيرية صغيرة في شرق أمريكا الشمالية تفرز أوراقها رائحة البلسم عند سحقها)",
 "salix repens": "صفصاف زاحف (شجيرة زاحفة صغيرة في أوروبا وآسيا ذات فروع متناثرة وأوراق خضراء حريرية، وتزرع منها عدة أصناف)",
 "salix sericea": "صفصاف حريري, صفصاف فضي (صفصاف أمريكي شمالي بأوراق رمادية حريرية وبرية تسود عادة عند التجفيف)",
 "salix sitchensis": "صفصاف سيتكا (شجرة شجيرية صغيرة في غرب أمريكا الشمالية (من ألاسكا إلى أوريغون))",
 "salix triandra": "صفصاف اللوز (صفصاف من العالم القديم بأوراق خضراء فاتحة يزرع للاستخدام في صناعة السلال)",
 "salix tristis": "صفصاف رمادي قزم (شجيرة صفصاف في الأماكن الجافة بشرق الولايات المتحدة ذات أوراق ضيقة طويلة مبيضة من الأسفل)",
 "salix uva-ursi": "صفصاف عنب الدب (شجيرة قزمة مفترشة تشكل حصيرة في المناطق القطبية والألبية بأمريكا الشمالية وجرينلاند ذات أوراق بيضاوية خضراء داكنة تستدق نحو القاعدة)",
 "salix viminalis": "صفصاف السلال, صفصاف القنب (صفصاف بغصينات مرنة طويلة تستخدم في صناعة السلال)",
 "salix vitellina": "صفصاف ذهبي (صفصاف أوروبي له أوراق رمادية وغصينات صفراء برتقالية تستخدم في صناعة السلال)",
 "salk vaccine": "لقاح سالك (لقاح فيروس شلل الأطفال يتكون من فيروس غير نشط يتم حقنه تحت الجلد لتوفير المناعة ضد شلل الأطفال)",
 "sallet": "خوذة ساليت (خوذة خفيفة من العصور الوسطى ذات شق للرؤية)",
 "sallow": "ذو مَظْهَر مَريض, شاحِب (ذو بَشَرَة شاحِبَة تَدُلّ عَلى سوء الصِّحَّة) / ساليكس, صفصاف الماعز (أي من عدة أنواع من الصفصاف الشجيري عريض الأوراق في العالم القديم ذو نورات كبيرة؛ بعضها مصادر مهمة للحاء الدباغة والفحم)",
 "sallowness": "اصفرار, شحوب مصفر (لون جلد مصفر مريض)",
 "sally": "انطلاق, خروج (مغامرة خارج المسار المألوف) / خروج للقوات المحاصرة, طلعة جوية (عمل عسكري تندفع فيه القوات المحاصرة من موقعها) / دعابة, نكتة ذكية (ملاحظة بارعة)\nمثال: انطلاقة إلى العالم الواسع خارج منزله",
 "sally lunn": "سالي لون (كعكة شاي مسطحة مستديرة حلوة قليلاً تقدم عادة ساخنة)",
 "sallying forth": "انطلاق, خروج (مغامرة خارج المسار المألوف)\nمثال: انطلاقة إلى العالم الواسع خارج منزله",
 "salmacis": "سالميسيس (حورية اندمجت مع هيرمافروديتوس لتكوين جسد واحد)",
 "salmagundi": "سالمونغندي (لحوم وبيض وخضروات مطبوخة مرتبة عادة في صفوف حول الطبق ومتبلة بصلصة السلطة) / تشكيلة, خليط (مجموعة تحتوي على تشكيلة متنوعة من أنواع الأشياء)\nمثال: كانت هناك تشكيلة كبيرة من السيارات معروضة",
 "salmi": "سالمي (راجو من لحم الصيد في صلصة غنية)",
 "salmo gairdneri": "تروتة قوس قزح (توجد في المياه الساحلية للمحيط الهادئ والجداول من كاليفورنيا السفلى إلى ألاسكا)",
 "salmo salar": "سلمون أطلسي (يوجد في المياه الساحلية الشمالية للمحيط الأطلسي أو روافده؛ لا يموت البالغون بعد وضع البيض)",
 "salmo trutta": "تروتة بنية (تروتة مرقطة من الأنهار الأوروبية؛ أُدخلت إلى أمريكا الشمالية)",
 "salmon": "حُوت سُلَيْمَان, سَلَمُون (سمكة صَغيرة كانت أو كبيرة؛ حوت كبير: صاحب مال وسَطْوَة ونفوذ)\nمثال: هل الحوت من الثدييات؟",
 "salmon berry": "توت السلمون, توت الكشتبان (توت شوكي أبيض الزهور من غرب أمريكا الشمالية وشمال المكسيك بتوت برتقالي على شكل كشتبان)",
 "salmon loaf": "رغيف السلمون (رغيف سمك مصنوع من السلمون المفتت)",
 "salmon oil": "زيت السلمون (زيت دهني يتم الحصول عليه من نفايات تعليب السلمون؛ يُستخدم في صنع الصابون وتجهيز الجلود)",
 "salmon pink": "خوخي, مشمشي (درجة من الوردي مشوبة بالأصفر)",
 "salmon shark": "قرش السلمون",
 "salmon trout": "تروتة بنية (تروتة مرقطة من الأنهار الأوروبية؛ أُدخلت إلى أمريكا الشمالية) / تروتة البحيرة (تروتة كبيرة متشعبة الذيل تعيش في بحيرات كندا وشمال الولايات المتحدة) / تراوت بحري (لحم التراوت البحري الذي يهاجر من المياه المالحة إلى العذبة)",
 "salmonberry": "توت السلمون (توت شوكي كبير منتصب أحمر الزهور من غرب أمريكا الشمالية له توت برتقالي وردي كبير) / توت السلمون, توت الكشتبان (توت شوكي أبيض الزهور من غرب أمريكا الشمالية وشمال المكسيك بتوت برتقالي على شكل كشتبان) / توت السحاب, توت الغيم (توت شوكي زاحف من المناطق المعتدلة الشمالية بتوت أصفر أو برتقالي)",
 "salmonella": "سالمونيلا (بكتيريا معوية عصوية سالبة الجرام؛ تسبب حمى التيفوئيد والتسمم الغذائي؛ يمكن استخدامها سلاحاً بيولوجياً)",
 "salmonella enteritidis": "سالمونيلا معوية, عصوية غارتنر (شكل من أشكال السالمونيلا يسبب التهاب المعدة والأمعاء لدى البشر)",
 "salmonella typhi": "سالمونيلا تيفية, عصوية التيفوئيد (شكل من أشكال السالمونيلا يسبب حمى التيفوئيد)",
 "salmonella typhimurium": "سالمونيلا تيفيموريوم (شكل من أشكال السالمونيلا يسبب التسمم الغذائي لدى البشر)",
 "salmonella typhosa": "سالمونيلا تيفية, عصوية التيفوئيد (شكل من أشكال السالمونيلا يسبب حمى التيفوئيد)",
 "salmonellosis": "داء السلمونيلات (نوع من التسمم الغذائي الناجم عن تناول أطعمة ملوثة بـالسلمونيلا)",
 "salmonid": "سلمونيات (أسماك ناعمة الزعانف تعيش في المياه الباردة والمعتدلة)",
 "salmwood": "دردار إسباني, كورديا (شجرة أمريكية استوائية كبيرة من جنس كورديا تزرع لزهورها البيضاء الكريمية الوفيرة وخشبها القيم)",
 "salo": "سَالُو",
 "salol": "سالول, ساليسيلات الفينيل (مسحوق أبيض ذو طعم ورائحة لطيفين؛ يستخدم لامتصاص الضوء في مستحضرات الوقاية من الشمس أو كمادة حافظة أو مطهر أو طلاء للحبوب التي يقصد بها الإطلاق المعوي)",
 "salon": "صَالُون, صَالَة (مجلسٌ يجتمع فيه بعض أعيان المجتمع عند أحدهم يناقشون فيه أمور الأدب والفنّ؛ هو المَجْلِس في البيت الذي يستقبلون فيه الضيوف، يسمه البعض غرفة الضيوف أو غرفة الاستقبال أو غرفة الخطار. )\nمثال: لدى زيري صالون حلاقة.",
 "saloon": "بار, حانة (غرفة أو منشأة يتم فيها تقديم المشروبات الكحولية عبر طاولة تقديم) / بار, حانة عامة (حانة تتكون من مبنى به بار وغرف عامة؛ غالباً ما توفر وجبات خفيفة) / سيدان, صالون (سيارة مغلقة ولها مقاعد أمامية وخلفية واثنان أو أربعة أبواب)\nمثال: أغرق أحزانه في الويسكي في الحانة",
 "saloon keeper": "صاحب حانة, صاحب صالون (مالك حانة)",
 "salopettes": "بنطال تزلج (سراويل عادة من مادة مطاطية وتبق مشدودة بواسطة شريط تحت القدم، تلبس للتزلج أو كزي موضة)",
 "salp": "سالبا (غلالية بحرية دقيقة عائمة لها جسم شفاف بفتحة في كل طرف)",
 "salpa": "سالبا (غلالية بحرية دقيقة عائمة لها جسم شفاف بفتحة في كل طرف)",
 "salpichroa organifolia": "بيض الديك, سالبكروة (كرمة ضارة في الأرجنتين لها أزهار بيضاء منعزلة تليها ثمرة بيضاء أو صفراء بيضاوية الشكل)",
 "salpichroa rhomboidea": "بيض الديك, سالبكروة (كرمة ضارة في الأرجنتين لها أزهار بيضاء منعزلة تليها ثمرة بيضاء أو صفراء بيضاوية الشكل)",
 "salpiglossis": "سالبجلوسيس, لسان المزمار",
 "salpiglossis sinuata": "سالبجلوسيس, لسان مصبوغ (عشب تشيلي له زهور مخملية قمعية الشكل صفراء أو بنفسجية مع أقلام تشبه اللسان الطويل عند حلق التويج)",
 "salpinctes obsoletus": "نمنمة الصخور (نمنمة تسكن الأراضي الوعرة ومنطقة الميسا في غرب الولايات المتحدة والمكسيك)",
 "salpingectomy": "استئصال قناة فالوب (إزالة جراحية لقناة فالوب واحدة أو كلتيهما)",
 "salpingitis": "التهاب البوق, التهاب قناة فالوب (التهاب قناة فالوب (عادة نتيجة انتشار العدوى من المهبل أو الرحم) أو قناة استاكيوس)",
 "salpinx": "بوق (أنبوب في الرحم أو الأذن)",
 "salsa": "سالسا (صلصة حارة من الطماطم والبصل والفلفل الحار لمرافقة الأطعمة المكسيكية)",
 "salsify": "سلسفي, لحية التيس (أي من جذرين طويلين يؤكلان مطبوخين) / تيس الجبل, ساسفي (عشب متوسطي ثنائي الحول برؤوس طويلة العنق من أزهار شعاعية أرجوانية وعصارة لبنية وجذر طويل صالح للأكل؛ مستوطن في جميع أنحاء الولايات المتحدة) / سلسفي (جذر صالح للأكل لنبات السلسفي)",
 "salsilla": "بوماريا, سالسيلا صالحة للأكل (كرمة استوائية لها أزهار وردية وصفراء مرقطة بالأرجواني وجذور صالحة للأكل تُسلق أحياناً كبديل للبطاطس؛ جزر الهند الغربية إلى شمال أمريكا الجنوبية) / بوماريا, سالسيلا (كرمة استوائية لها خيمات من الزهور الأرجوانية الصغيرة وجذور صالحة للأكل تُسلق أحياناً كبديل للبطاطس؛ كولومبيا)",
 "salsola kali": "خريزة, شنان (نبات كثيف في المستنقعات المالحة وشواطئ البحر في العالم القديم ذو أوراق شائكة؛ يُحرق لإنتاج رماد الصودا الخام)",
 "salsola kali tenuifolia": "شوك روسي, عشبة دحروجة روسية (نبات أوراسي شائك كثيف؛ عشبة ضارة مزعجة في وسط وغرب الولايات المتحدة)",
 "salsola soda": "خريزة, شنان (نبات كثيف في المستنقعات المالحة وشواطئ البحر في العالم القديم ذو أوراق شائكة؛ يُحرق لإنتاج رماد الصودا الخام)",
 "salt": "مِلْح, ملح / مَلَّحَ",
 "salt cod": "قد مملح (سمك القد المحفوظ بالملح؛ يجب إزالة الملح منه ونقعه في الماء وهرسه؛ يستخدم في كعك السمك)",
 "salt depletion": "نقص الملح (فقدان الملح من الجسم دون تعويضه (عن طريق القيء أو التعرق الغزير أو التبول أو الإسهال) مما يخل بتوازن الكهارل)",
 "salt flat": "مسطح ملحي (مساحة مسطحة من الملح خلفتها عملية تبخر جسم مائي مالح)",
 "salt lake": "بُحَيْرَة مِلْحَة (مسطح مائي واسع كالبحر المغلق فيه ماء حلو أو شبه حلو صالح للشرب)\nمثال: سبحنا في البحيرة.",
 "salt lake city": "سولت ليك سيتي, سولت ليك",
 "salt lick": "لعقة ملح, مَلّاحة (ترسبات ملحية تلعقها الحيوانات بانتظام)",
 "salt marsh": "سبخة مالحة (أرض رطبة منخفضة تغمرها المياه المالحة بشكل متكرر)",
 "salt marsh mallow": "ختمية المستنقعات المالحة (شجيرة في جنوب شرق الولايات المتحدة إلى نيويورك)",
 "salt merchant": "تاجر ملح, صانع ملح (شخص يصنع الملح أو يتاجر به)",
 "salt mine": "طاحونة, عمل روتيني شاق (عمل يتضمن الكدح والقيود) / منجم ملح (منجم يُستخرج منه الملح)",
 "salt of the earth": "ملح الأرض",
 "salt plain": "مسطح ملحي (مساحة مسطحة من الملح خلفتها عملية تبخر جسم مائي مالح)",
 "salt pork": "لحم خنزير مملح (دهن من الظهر والجوانب وبطن ذبيحة خنزير محفوظ بالملح)",
 "salt reed grass": "عشبة القصب المالحة (عشبة طويلة تشبه القصب شائعة في المروج المالحة)",
 "salt rush": "أسل ملحي (أسل ساحل المحيط الهادئ في أمريكا الشمالية)",
 "salt shaker": "رَشَّاشَةْ الْمِلْح (مؤنث رَشَّاش، وهو الكثير الرَشّ؛ سِلاح نَارِيّ يَرُشّ الرَصَاص رشّا ولا يحتاج إلى ضغط الزَنَاد لكل رَصَاصَة)",
 "salt tree": "شجرة الملح, هاليمودندرون (شجيرة شائكة في سهول قزوين الملحية وسيبيريا، لها أوراق فضية ناعمة وزهور زهرية أرجوانية عطرة قليلاً)",
 "salt water": "مَاء مِلْح (السائل الشفاف المعروف الذي تنشأ به الحياة، عديم اللون والرائحة والطعم عندما يكون نقيا؛ علميا فِي : جزيئة متكونة من ذرتي هيدروجين مرتبطين بذرة واحدة من الأوكسيجين)\nمثال: أنا أشرب الماء.",
 "salt working": "استخراج الملح, صناعة الملح (تصنيع الملح)",
 "salt-and-pepper": "خَلِيس",
 "salt-cured": "مَحْفُوظ بِالمِلْح, مُمَلَّح ((خَاصَّةً عَنِ اللُّحُوم) مَحْفُوظ فِي المِلْح)",
 "salt-free diet": "حمية خالية من الملح, حمية قليلة الصوديوم (نظام غذائي يحد من تناول الملح (كلوريد الصوديوم)؛ يستخدم غالباً في علاج ارتفاع ضغط الدم أو الوذمة أو اضطرابات أخرى)",
 "salt-rising bread": "خبز مخمر بالملح (خبز قمح أبيض يرتفع بفعل بكتيريا تتحمل الملح في خليط من الملح ودقيق الذرة أو لب البطاطس)",
 "salt-working": "استخراج الملح, صناعة الملح (تصنيع الملح)",
 "saltation": "قفزة, وثبة (حركة خفيفة ذاتية الدفع لأعلى أو للأمام) / رقص (القيام بسلسلة من الخطوات (والحركات) الإيقاعية المتناغمة مع الموسيقى) / طفرة, قفزة (انتقال مفاجئ) / طفرة قافزة ((في علم الوراثة) طفرة تغير النمط الظاهري للكائن الحي أو النوع بشكل جذري)\nمثال: قفزة ناجحة من الكلية إلى الدوريات الكبرى",
 "saltbox": "منزل سولت بوكس (نوع من المنازل بني في نيو إنجلاند؛ له طابقان في الأمام وطابق واحد في الخلف)",
 "saltbush": "سَرْمَق, قَطَف",
 "saltcellar": "مملحة (وعاء صغير لحمل الملح على مائدة الطعام)",
 "salted": "مُمَلَّح",
 "salter": "تاجر ملح, صانع ملح (شخص يصنع الملح أو يتاجر به) / مملّح (شخص يستخدم الملح لحفظ اللحوم أو الأسماك أو الأطعمة الأخرى)",
 "saltine": "بسكويت مملح, سالتين (بسكويت كراكر مرشوش بالملح قبل الخبز)",
 "saltiness": "مُلُوْحَة",
 "salting": "تمليح (فعل إضافة الملح إلى الطعام)",
 "saltire": "صليب القديس أندرو, صليب مائل",
 "saltish": "مَائِل لِلْمُلُوحَة (مَالِح بَعْض الشَّيْء)",
 "saltlike": "مِلْحِيّ (يُشبِه مُركَّبًا يتكوّن من استبدال الهيدروجين في الحمض بمعدن)",
 "saltpan": "حوض ملحي (حوض ضحل في منطقة صحراوية؛ يحتوي على الملح والجبس المترسب من بحيرة مالحة متبخرة)",
 "saltpeter": "ملح البارود, نترات البوتاسيوم",
 "saltpetre": "ملح البارود, نترات البوتاسيوم",
 "saltshaker": "رجاجة ملح, مملحة (رجاجة ذات غطاء مثقوب لرش الملح)",
 "saltwater": "ماء البحر, ماء مالح (ماء يحتوي على أملاح)",
 "saltwater fish": "سمك مياه مالحة (لحم الأسماك البحرية المستخدم كطعام)",
 "saltworks": "معمل ملح, ملاحات (منشأة يتم فيها إنتاج الملح تجارياً)",
 "saltwort": "عشبة الملح (شجيرة ساحلية منخفضة النمو قوية الرائحة في الأجزاء الدافئة من العالم الجديد ذات أزهار أحادية الجنس في سنابل تشبه المخاريط وأوراق عصارية سميكة) / خريزة, شنان (نبات كثيف في المستنقعات المالحة وشواطئ البحر في العالم القديم ذو أوراق شائكة؛ يُحرق لإنتاج رماد الصودا الخام)",
 "salty": "مَالِح / مِلْحِيّ",
 "salubrious": "صِحِّيّ, نَافِع لِلصِّحَّة (يعزّز الصحّة ويدعمها) / صِحِّيّ, مُعَافٍ (نافع لصحّة العقل أو الجسم)",
 "salubriousness": "صِحَّة, مُلَاءَمَة صِحِّيَّة (صفة كون الشيء صحياً ومنشطاً)",
 "salubrity": "صِحَّة, مُلَاءَمَة صِحِّيَّة (صفة كون الشيء صحياً ومنشطاً)",
 "saluki": "سَلُوقِيّ",
 "salutary": "مُفيد لِلصِّحَّة, نافِع (يُحَقِّق فائِدَة صِحِّيَّة)",
 "salutation": "استهلال, تحية الافتتاح (كلمة تحية تستخدم لبدء رسالة) / تَحِيَّة, تَرْحِيب (إقرار أو تعبير عن حسن النية (خاصة عند اللقاء)) / تحية, سلام (فعل تكريم أو اعتراف مهذب)\nمثال: تحية موسيقية للملحن في عيد ميلاده",
 "salutatorian": "طالب الخطاب الترحيبي (الطالب الحاصل على المرتبة الأكاديمية الثانية؛ قد يلقي الخطاب الافتتاحي في حفلات التخرج)",
 "salutatory": "كلمة ترحيبية (بيان افتتاحي أو ترحيبي (خاصة الذي يلقى في حفلات التخرج))",
 "salutatory address": "كلمة ترحيبية (بيان افتتاحي أو ترحيبي (خاصة الذي يلقى في حفلات التخرج))",
 "salutatory oration": "كلمة ترحيبية (بيان افتتاحي أو ترحيبي (خاصة الذي يلقى في حفلات التخرج))",
 "salutatory speaker": "طالب الخطاب الترحيبي (الطالب الحاصل على المرتبة الأكاديمية الثانية؛ قد يلقي الخطاب الافتتاحي في حفلات التخرج)",
 "salute": "تَحِيَّة (فعل التحية بكلمات وإيماءات ودية مثل الانحناء أو رفع القبعة) / تَحِيَّة عَسْكَرِيَّة (إيماءة عسكرية رسمية للاحترام) / تحية, سلام (فعل تكريم أو اعتراف مهذب)\nمثال: تحية موسيقية للملحن في عيد ميلاده",
 "saluter": "مُرَحِّب, مُسْتَقْبِل (شخص يقوم بالترحيب)\nمثال: استقبل القادمين الجدد مرحبون مبتسمون",
 "salvador": "سَلْفَادُور",
 "salvadora persica": "أراك, شجرة الخردل (شجيرة أو شجرة دائمة الخضرة ملساء أو زغبية من جنس سلفادورا؛ أغصانها ليفية وتُربط في حزم في بعض أنحاء العالم وتستخدم كفرشاة أسنان (سواك)؛ وتستخدم…)",
 "salvadoran": "سلفادوري (من أو يتعلق بالسلفادور أو شعبها أو يميزهم) / سلفادوري (مواطن أو ساكن في السلفادور)\nمثال: قهوة سلفادورية",
 "salvadorean": "سلفادوري (من أو يتعلق بالسلفادور أو شعبها أو يميزهم) / سلفادوري (مواطن أو ساكن في السلفادور)\nمثال: قهوة سلفادورية",
 "salvadorian": "سلفادوري (مواطن أو ساكن في السلفادور)",
 "salvage": "إنقاذ السفن, انتشال (فعل إنقاذ سفينة أو طاقمها أو شحنتها من غرق أو حريق) / إنقاذ الممتلكات (فعل إنقاذ البضائع أو الممتلكات التي كانت معرضة لخطر التلف أو الدمار) / بضائع مستنقذة (ممتلكات أو بضائع تم إنقاذها من التلف أو الدمار)",
 "salvageable": "قَابِلٌ لِلْإِنْقَاذ (يمكن إنقاذه من الخراب)",
 "salvager": "مُنْتَشِل, مُنْقِذ الْمُمْتَلَكَات (شخص يقوم بإنقاذ أو استعادة الممتلكات (خاصة من السفن الغارقة أو الحرائق))",
 "salvation": "خَلَاص, تَطْهِير اَلنَّفْس",
 "salvation army": "جيش الخلاص (منظمة خيرية ودينية للتبشير ورعاية الفقراء والمشردين)",
 "salve": "مَرْهَم, زَبْدَة",
