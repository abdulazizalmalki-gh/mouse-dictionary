 "rusty woodsia": "وودسيا صدئة, وودسيا عطرية (سرخس صخري شائع في المناطق المعتدلة الشمالية ذو سويقات بنية صدئة وسعف ريشي رمحي)",
 "rusty-brown": "بُنِّيّ صَدَئِيّ (بلون بني كلون الصدأ)",
 "rusty-red": "أَحْمَر صَدَئِيّ (أحمر مع مسحة صدئية)",
 "rut": "روتين ممل (روتين ثابت ورتيب يصعب الهروب منه) / أخدود, مسار عجل (أخدود أو شق (خاصة في الأرض اللينة الناتج عن العجلات)) / دورة الشبق, شبق (ينطبق على الثدييات غير البشرية: حالة أو فترة من الإثارة الجنسية والنشاط المتزايد)\nمثال: وقعوا في روتين محادثة ممل",
 "ruta graveolens": "سذاب, فيجن (عشب معمر أوروبي قوي الرائحة بأوراق رمادية مخضرة مرة المذاق؛ مهيج يشبه اللبلاب السام)",
 "rutabaga": "لفت سويدي (الجذر الأصفر الكبير لنبات اللفت السويدي المستخدم كغذاء) / روتاباغا, لفت سويدي (نبات صليبي بجذر أصفر سميك بصلي صالح للأكل)",
 "rutabaga plant": "روتاباغا, لفت سويدي (نبات صليبي بجذر أصفر سميك بصلي صالح للأكل)",
 "ruth": "رُوث, رَاعُوث",
 "ruthenium": "رُوثِينِيُوم, رُوتِينِيُوم",
 "rutherford": "رذرفورد (وحدة قوة لمصدر مشع تساوي مليون تفكك في الثانية)",
 "rutherford atom": "ذرة رذرفورد (المفهوم الحديث الأول للتركيب الذري؛ كل الشحنة الموجبة ومعظم كتلة الذرة موجودة في نواة مدمجة؛ ويحتل عدد من الإلكترونات (يساوي العدد الذري) بقية حجم…)",
 "rutherfordium": "رُوذَرْفُورْدِيُوم",
 "ruthful": "تَائِب, نَادِم (يَشْعُرُ بِالأَلَمِ أَوِ النَّدَمِ عَلَى الذُّنُوبِ أَوِ الآثَام)",
 "ruthfulness": "حزن, كآبة (حالة من الأسى الكئيب)",
 "ruthless": "قَاسٍ (شديد وصلب، غير لين؛ جافٍ أو يابس في الملمس أو التعامل)\nمثال: قاس طول السرير.",
 "ruthlessly": "بقسوة, بلا رحمة (بطريقة قاسية تفتقر إلى الشفقة)\nمثال: تم حث الحكومة على اتخاذ إجراءات فورية للتعامل بلا رحمة مع المضربين",
 "ruthlessness": "ضَرَاوَة, عَدَم رَحْمَة (قسوة تتميز بافتقار الشفقة) / قسوة, وحشية (مشاعر انعدام الرحمة الشديدة)",
 "rutile": "روتيل (معدن يتكون من ثاني أكسيد التيتانيوم في شكل بلوري؛ يوجد في الصخور المتحولة والبلوتونية وهو مصدر رئيسي للتيتانيوم)",
 "rutilus rutilus": "روش (سمكة غذائية أوروبية تعيش في المياه العذبة ولها ظهر مخضر)",
 "rutted": "مُحَفَّر",
 "ruttish": "شَبِق, مُثَار جِنْسِيًّا (يشعر برغبة جنسية شديدة)",
 "rutty": "ذُو أَثْلَامٍ, مُحَفَّر (فيه أخاديد عميقة محفورة بفعل الاستعمال)",
 "ruvettus pretiosus": "السمكة الزيتية (ماكريل ثعباني كبير جداً يعيش في المياه العميقة)",
 "rv": "مركبة ترفيهية (مركبة آلية بعجلات تستخدم للتخييم أو الأنشطة الترفيهية الأخرى)",
 "rwanda": "رُوَانْدَا",
 "rwanda franc": "فرنك رواندي (وحدة المال الأساسية في رواندا)",
 "rwandan": "رواندي (من أو متعلق برواندا) / رُوانْدِيّ (مواطن أو ساكن في رواندا)\nمثال: جبال رواندية",
 "rya": "سجاد ريا (سجادة كثيفة الوبر تصنع في السويد)",
 "rya rug": "سجاد ريا (سجادة كثيفة الوبر تصنع في السويد)",
