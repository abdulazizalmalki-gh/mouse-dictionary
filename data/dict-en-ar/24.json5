 "sanctitude": "قَدَاسَة (صفة كون الشيء مقدساً)",
 "sanctity": "قَدَاسَة (صفة كون الشيء مقدساً)",
 "sanctuary": "قدس الأقداس, منطقة المذبح (المنطقة المحيطة بمذبح الكنيسة لرجال الدين والجوقة؛ غالباً ما تكون محاطة بسياج أو درابزين) / ملاذ, ملجأ (مأوى من الخطر أو المصاعب) / مزار, مقدس (مكان مكرس تُحفظ فيه الأشياء المقدسة)",
 "sanctum": "حرم, مكان مقدس (مكان مقدس للحج) / خلوة, قدس الأقداس (مكان ذو خصوصية لا تُنتهك)\nمثال: انسحب إلى خلوته حيث لا يمكن للأطفال الذهاب أبداً",
 "sanctum sanctorum": "قدس الأقداس ((اليهودية) مزار مقدس يتكون من الغرفة الداخلية للمسكن في هيكل سليمان حيث كان يُحفظ تابوت العهد) / خلوة, قدس الأقداس (مكان ذو خصوصية لا تُنتهك)\nمثال: انسحب إلى خلوته حيث لا يمكن للأطفال الذهاب أبداً",
 "sand": "رَمْل (ذرات دقيقة من الصخور أو المعادن، تتكون طبيعياً بفعل الرياح أو الماء؛ تربة رخوة تتكوّن غالباً على الشاطئ أو في الصحارى)\nمثال: وصلت شاحنة الرمل.",
 "sand badger": "غرير الخنزير (غرير من جنوب شرق آسيا له خطم مثل الخنزير)",
 "sand bar": "حَاجِز رَمْلِيّ (حاجز من الرمال)",
 "sand berry": "عنب الدب, قطلب عنب الدب (شجيرة دائمة الخضرة تشكل حصيرة من أمريكا الشمالية وشمال أوراسيا لها زهور بيضاء صغيرة وتوت أحمر؛ تتحول الأوراق إلى الأحمر في الخريف)",
 "sand blackberry": "عليق رملي (عليق شجيري صلب من شرق الولايات المتحدة (كونيتيكت إلى فلوريدا))",
 "sand cat": "قط الرمال (قط بري صحراوي)",
 "sand cherry": "كرز رملي, كرز قزم (كرز أمريكي صغير متناثر ينمو في التربة الرملية وله ثمار سوداء أرجوانية دقيقة تكاد لا تؤكل)",
 "sand crack": "شق الرمل (شق في جدار حافر الحصان يسبب العرج غالباً)",
 "sand cricket": "صرصور الرمل, صرصور القدس (جندب ليلي كبير عديم الأجنحة يحفر في التربة الرخوة على طول ساحل المحيط الهادئ للولايات المتحدة)",
 "sand dab": "داب الرمل (أسماك طعام صغيرة في ساحل المحيط الهادئ لأمريكا الشمالية) / داب الرمل (اللحم قليل الدهن لسمكة هلبوت صغيرة من ساحل المحيط الهادئ لأمريكا الشمالية)",
 "sand devil's claw": "مخالب الشيطان الرملية (يوضع بشكل بديل في جنس مارتينيا)",
 "sand dollar": "دولار الرمل (قنافذ بحر مسطحة تشبه القرص تعيش في القيعان الرملية)",
 "sand dropseed": "سبوروبولوس رملي (عشبة ملساء منتصبة في الأماكن الرملية في شرق أمريكا الشمالية)",
 "sand dune": "كثيب, كثيب رملي (سلسلة من الرمال كونتها الرياح؛ توجد في الصحاري أو بالقرب من البحيرات والمحيطات)",
 "sand eel": "رماه الرمال, سمك الرمل (أسماك صغيرة جداً فضية اللون تشبه الثعابين تعيش في أسراب وتحفر في الشواطئ الرملية)",
 "sand flea": "برغوث الشاطئ (قشريات صغيرة من مزدوجات الأرجل تقفز مثل البراغيث؛ شائعة على شواطئ المحيط)",
 "sand fly": "ذبابة الرمل (أي من الذباب الصغير ثنائي الأجنحة المتنوع؛ يمكن للإناث الماصة للدماء نقل حمى ذباب الرمل وداء الليشمانيات)",
 "sand grouse": "قطا (طائر يشبه الحمام من المناطق القاحلة في العالم القديم له أجنحة وذيل مدببة طويلة وصغار تكسوها الزغب وتعتمد على نفسها مبكراً)",
 "sand hopper": "برغوث الشاطئ (قشريات صغيرة من مزدوجات الأرجل تقفز مثل البراغيث؛ شائعة على شواطئ المحيط)",
 "sand lance": "رماه الرمال, سمك الرمل (أسماك صغيرة جداً فضية اللون تشبه الثعابين تعيش في أسراب وتحفر في الشواطئ الرملية)",
 "sand launce": "رماه الرمال, سمك الرمل (أسماك صغيرة جداً فضية اللون تشبه الثعابين تعيش في أسراب وتحفر في الشواطئ الرملية)",
 "sand leek": "ثوم عملاق, كراث رملي (كراث أوروبي يزرع ويستخدم مثل الكراث)",
 "sand lizard": "سحلية جانبية البقع (واحدة من أكثر السحالي وفرة في المناطق القاحلة بغرب الولايات المتحدة) / سحلية الرمل (سحلية شائعة وموزعة على نطاق واسع في أوروبا وآسيا الوسطى)",
 "sand martin": "سنونو الجرف (سنونو من نصف الكرة الشمالي يعشش في أنفاق محفورة في ضفاف الطين أو الرمل)",
 "sand myrtle": "آس الرمل (شجيرة دائمة الخضرة منخفضة النمو من نيوجيرسي إلى فلوريدا تزرع لأزهارها البيضاء الكثيرة على شكل نجمة وأوراقها اللامعة)",
 "sand painting": "رسم بالرمل (لوحة ينفذها الهنود الحمر (خاصة نافاهو)؛ مصنوعة من رمال ملونة ناعمة على خلفية محايدة)",
 "sand phlox": "قبس رملي (عشب منخفض يشكل حصيرة في الأماكن الصخرية في الولايات المتحدة)",
 "sand rat": "جرذ الرمل (يربوع من جنوب أوروبا) / جرذ الرمل (فأر خلد أفريقي صغير شبه عارٍ يعيش في المناطق الصحراوية)",
 "sand reed": "سعد رملي, كاريكس رملي (سعد بحري أوروبي توطن على طول ساحل المحيط الأطلسي للولايات المتحدة؛ للجذمور خصائص السارساباريلا)",
 "sand sage": "شيح فضي, ميرمية الرمل (شجيرة فضية الشعر في وسط وجنوب الولايات المتحدة والمكسيك؛ عشبة ضارة مزعجة في المراعي)",
 "sand sedge": "سعد رملي, كاريكس رملي (سعد بحري أوروبي توطن على طول ساحل المحيط الأطلسي للولايات المتحدة؛ للجذمور خصائص السارساباريلا)",
 "sand shark": "قرش الرمل, قرش الرمل الببري (قرش المياه الضحلة ذو أسنان حادة مسننة يوجد على جانبي المحيط الأطلسي؛ خطير أحياناً على السباحين)",
 "sand snake": "ثعبان الرمل (ثعبان صغير يحفر الجحور من أمريكا الشمالية)",
 "sand sole": "سمك موسى الرملي (سمكة مفلطحة شائعة من ساحل المحيط الهادئ لأمريكا الشمالية)",
 "sand spurry": "دحسية حمراء, دحسية رملية (عشب ضار منبسط بأزهار وردية صغيرة؛ واسع الانتشار في جميع أنحاء أوروبا وآسيا على الكثبان الرملية والخلنج والمنحدرات الساحلية؛ مستوطن في شرق أمريكا…)",
 "sand stargazer": "محدقة النجوم الرملية (أسماك شاحبة صغيرة تعيش في المياه الضحلة الاستوائية لأمريكا الشمالية والجنوبية ولها عيون على سيقان فوق الرأس؛ تحفر في الرمال لانتظار الفريسة)",
 "sand tiger": "قرش الرمل, قرش الرمل الببري (قرش المياه الضحلة ذو أسنان حادة مسننة يوجد على جانبي المحيط الأطلسي؛ خطير أحياناً على السباحين)",
 "sand toy": "لعبة رمل (أي لعبة مخصصة للاستخدام على الشاطئ أو في حفرة رملية للعب بالرمل)",
 "sand trap": "حفرة رملية (عائق في ملعب الجولف)",
 "sand tumor": "ورم رملي (ورم مشتق من النسيج الليفي للسحايا أو الضفيرة المشيمية)",
 "sand verbena": "أبرونية, رعي الحمام الرملي (أي من نباتات جنس الأبرونية المتنوعة في غرب أمريكا الشمالية والمكسيك التي لها أزهار تشبه رعي الحمام)",
 "sand viper": "ثعبان خنزيري الأنف (ثعبان غير ضار من أمريكا الشمالية ذو أنف مقلوب؛ قد ينشر رأسه ورقبته أو يتظاهر بالموت عند الانزعاج) / أفعى مقرنة (أفعى شديدة السمية من شمال أفريقيا وجنوب غرب آسيا لها شوكة قرنية فوق كل عين)",
 "sand wedge": "إسفين رملي, مضرب رملي (مضرب جولف وتدي الشكل يستخدم لإخراج الكرة من الحفر الرملية)",
 "sand-blind": "شِبْه أَعْمَى, ضَعِيف البَصَر (ذو بصر ضعيف جدًّا)",
 "sand-lime brick": "طوب رملي جيري, طوب سيليكات الكالسيوم (طوب مصنوع من الرمل والجير المطفأ بدلاً من الطين؛ عادة ما يكون لونه رمادياً فاتحاً أو أبيض مائلاً للصفرة)",
 "sandal": "صَنْدَل (شجر طيب الرائحة يشبه شجر الجوز له ثمر يُحمل في عناقيد من حب أخضر، يستخدم غالبا لصنع العطور؛ من الحمير والجمال: ذو الرأس الضخمة)",
 "sandaled": "مُنْتَعِل صَنْدَلاً (يرتدي صندلاً في قدميه)",
 "sandalled": "مُنْتَعِل صَنْدَلاً (يرتدي صندلاً في قدميه)",
 "sandalwood": "صَنْدَل (شجر طيب الرائحة يشبه شجر الجوز له ثمر يُحمل في عناقيد من حب أخضر، يستخدم غالبا لصنع العطور؛ من الحمير والجمال: ذو الرأس الضخمة)",
 "sandalwood tree": "شجرة الصندل, صندل أبيض (شجرة طفيلية من إندونيسيا وماليزيا ذات خشب قلب مصفر عطري ناعم الحبيبات بخصائص طاردة للحشرات ويستخدم، على سبيل المثال، لصنع الصناديق)",
 "sandarac": "سنداروس (شجرة صنوبرية كبيرة دائمة الخضرة في شمال أفريقيا وإسبانيا لها فروع مسطحة وأوراق تشبه القشور تنتج خشباً عطرياً صلباً؛ وينتج لحاؤها راتنجاً يستخدم في…) / سندروس (راتنج شفاف هش وعطري قليلاً يستخدم في الورنيش) / خشب الأترج, خشب السنداروس (خشب عطري متين؛ يستخدم في البناء (كما في سقف كاتدرائية قرطبة، إسبانيا))",
 "sandarac tree": "سنداروس (شجرة صنوبرية كبيرة دائمة الخضرة في شمال أفريقيا وإسبانيا لها فروع مسطحة وأوراق تشبه القشور تنتج خشباً عطرياً صلباً؛ وينتج لحاؤها راتنجاً يستخدم في…)",
 "sandarach": "سندروس (راتنج شفاف هش وعطري قليلاً يستخدم في الورنيش)",
 "sandbag": "كيس رمل (كيس مملوء بالرمل؛ يستخدم كسلاح أو لبناء الجدران أو كثقل موازن)",
 "sandbagger": "مخادع (شخص يخدعك بشأن طبيعته الحقيقية أو نيته من أجل استغلالك)",
 "sandbank": "ضفة رملية (ضفة مغمورة من الرمال بالقرب من الشاطئ أو في النهر؛ يمكن أن تنكشف عند الجزر المنخفض)",
 "sandbar": "ضحضاح ماء",
 "sandbar shark": "قرش الرمل (أكثر أنواع القرش الرمادي شيوعاً على طول سواحل ولايات وسط المحيط الأطلسي؛ بطيء الحركة ويصطاده الصيادون أحياناً) / قرش أسود الطرف (قرش واسع الانتشار في المياه الضحلة، تبدو زعانفه وكأنها مغموسة في الحبر)",
 "sandberry": "عنب الدب, قطلب عنب الدب (شجيرة دائمة الخضرة تشكل حصيرة من أمريكا الشمالية وشمال أوراسيا لها زهور بيضاء صغيرة وتوت أحمر؛ تتحول الأوراق إلى الأحمر في الخريف)",
 "sandblast": "تيار رملي, سفح رملي (هبة رياح محملة بالرمال)",
 "sandblaster": "قاذف الرمل (أداة تقذف تياراً من البخار المحمل بالرمل؛ تستخدم لتنظيف أو طحن الأسطح الصلبة)",
 "sandbox": "صُنْدُوق رَمْل, صَنْدُوق رَمْل (وعاء كبيرة من الخشب غالبا وقد يكون حديدًا يستخدم لوضع الاشياء داخله، ويكون لها عادة جهة قابلة للفتح سواء بمفاصل او بالازالة الكاملة؛ صُنْدُوْقُ السَيَّارَة قمرة تشبه الصندوق في الجزء الخلفي من السيارة يستخدم كالصندوق)\nمثال: أين صندوق البريد؟",
 "sandboy": "بائع الرمل (بائع متجول ذكر شاب للرمل؛ يستخدم الآن فقط للتعبير عن السعادة الكبيرة في عبارة 'سعيد كبائع الرمل')",
 "sandbur": "سَبَط (سَبُطَ يَسْبُطُ سُبُوطًا، وسُبُوطة، وسَباطةً: كان سَبْطًا)",
 "sander": "آلة صنفرة أسطوانية (أداة كهربائية تستخدم لصنفرة الخشب؛ يتم تحريك حلقة لا نهائية من ورق الصنفرة بسرعة عالية بواسطة محرك كهربائي)",
 "sanderling": "مدروان (طيطوي صغير يتكاثر في القطب الشمالي ويهاجر جنوباً على طول السواحل الرملية في معظم أنحاء العالم)",
 "sanders": "سَانْدَرْزْ",
 "sandfish": "سلمون منقاري, سمكة الرمل (سمكة تعيش في المناطق الرملية في غرب المحيط الهادئ والمحيط الهندي، لها خطم زاوي للحفر في الرمال) / سمكة الرمل (إما من نوعين من الأسماك الفضية الصغيرة عديمة القشور في شمال المحيط الهادئ التي تحفر في الرمال)",
 "sandfly": "ذبابة الرمل (أي من الذباب الصغير ثنائي الأجنحة المتنوع؛ يمكن للإناث الماصة للدماء نقل حمى ذباب الرمل وداء الليشمانيات)",
 "sandfly fever": "حمى ذبابة الرمل (مرض فيروسي خفيف ينتقل عن طريق لدغة ذبابة الرمل)",
 "sandglass": "ساعة رملية (ساعة يُشار فيها إلى مرور الوقت بتدفق الرمل من حاوية شفافة إلى أخرى عبر ممر ضيق)",
 "sandgrouse": "قَطًا",
 "sandhi": "سَنْدْهِي, وَصْل",
 "sandhopper": "برغوث الشاطئ (قشريات صغيرة من مزدوجات الأرجل تقفز مثل البراغيث؛ شائعة على شواطئ المحيط)",
 "sandiness": "رملية (ملمس يشبه ملمس الرمل) / رملية (خاصية احتواء الرمل)\nمثال: رملية وجه التربة الممتدة في الليل فوقنا وأمامنا كانت بسبب التفتت التدريجي للصخور بفعل المطر",
 "sandlike": "رَمْلِيّ (يشبه أو يحتوي على أو يكثر فيه الرمل؛ أو ينمو في المناطق الرملية)\nمثال: حجر جيري رملي",
 "sandlime brick": "طوب رملي جيري, طوب سيليكات الكالسيوم (طوب مصنوع من الرمل والجير المطفأ بدلاً من الطين؛ عادة ما يكون لونه رمادياً فاتحاً أو أبيض مائلاً للصفرة)",
 "sandlot": "ساحة رملية (أرض خالية يستخدمها أولاد المدينة للعب)",
 "sandman": "رجل الرمل (قزم في قصص الأطفال ينثر الرمل في عيون الأطفال ليجعلهم ينامون)",
 "sandpaper": "وَرَق زُجَاج (ما ينمو على النبات من الأعلى والجوانب بشكل صفائح ذات لون أخضر أو مائل إلى الخضرة. انظر الصورة؛ جلود رقاق يُكتَبُ عليها)\nمثال: هات ورقة بيضاء.",
 "sandpapery": "شَبِيهٌ بِوَرَقِ الصَّنْفَرَةِ (خشن الملمس كورق الصنفرة)",
 "sandpile": "صندوق الرمل (لعبة تتكون من كومة من الرمل أو صندوق مملوء بالرمل ليلعب فيه الأطفال)",
 "sandpiper": "دُرَّيْجَة",
 "sandpit": "صندوق الرمل (لعبة تتكون من كومة من الرمل أو صندوق مملوء بالرمل ليلعب فيه الأطفال) / حفرة رملية (حفرة كبيرة في أرض رملية يُستخرج منها الرمل)",
 "sandril": "ريزيربين, سرباسيل (خافض لضغط الدم يتكون من قلويد مستخرج من نبات الراوولفية الثعبانية (الأسماء التجارية سرباسيل وغيرها))",
 "sands": "منطقة ساحلية, منطقة شاطئية (منطقة شاطئ بحيرة أو بحر أو محيط)",
 "sandspur": "حسك رملي (عشب من شرق الولايات المتحدة وأمريكا الاستوائية له سنيبلات محاطة بأغلفة شائكة)",
 "sandstone": "حَجَر رَمْلِيّ (حَجَرَ عليه الأمرَ:مَنَعَه منه ، حجر الشّيء على نفسه:خَصَّها به وقصره عليها؛ الحجْرُ: المَنْعُ مِن التَّصَرُّفِ ، وحَجَرَ عَلَيْهِ القاضِي يَحْجُرُ حَجْراً، إِذا مَنَعَه مِن التَّصَرُّفِ فِي مالِه)\nمثال: عوقب زيري بالحجر.",
 "sandstorm": "عَاصِفَة رَمْلِيَّة",
 "sandwich": "سَانْدَوِيتْش, شَطِيرَة",
 "sandwich board": "لافتة حاملة, لوحة ساندويتش (لافتة تتكون من لوحين مفصليين يتدليان من الأمام والخلف على كتفي حاملها وتستخدم لعرض الإعلانات)",
 "sandwich plate": "طبق شطائر (وجبة تتكون من شطيرة أو شطائر مع مقبلات)",
 "sandwichman": "رجل الإعلانات المتجول (شخص ذكر يحمل لوحات إعلانية معلقة من كتفيه)",
 "sandwichwoman": "حاملة لوحات إعلانية (شخص أنثى تحمل لوحات إعلانية معلقة من الكتفين)",
 "sandwort": "رَمْلِيَّة",
 "sandy": "رَمْلِيّ (يشبه أو يحتوي على أو يكثر فيه الرمل؛ أو ينمو في المناطق الرملية) / أَشْقَر رَمْلِيّ, كَتَّانِيّ (بلون شعر أصفر باهت إلى بني مصفر)\nمثال: حجر جيري رملي",
 "sandy mushroom": "فطر رملي (غاريقون صالح للأكل يثمر في مجموعات كبيرة (خاصة في التربة الرملية تحت أشجار القطن))",
 "sane": "عَاقِل (من له عَقْل يعقل به، يطلق على الإنسان وغيره إن كان يعقل؛ ذو النُهَى والرَأي السديد. هذه من الألفاظ التي يستوي فيها الذكر والأنثى)\nمثال: لا عاقل يفعل ذلك.",
 "sanely": "باتزان, بعقلانية (بطريقة عاقلة أو واضحة) / بتعقل, بحكمة (بحس سليم أو بطريقة معقولة)\nمثال: إنها تتصرف بعقلانية نوعاً ما هذه الأيام رغم أننا نعلم أنها مصابة بالفصام",
 "saneness": "رشاد, سلامة العقل (القوى الطبيعية أو السليمة للعقل)",
 "sanfoin": "سانفوان, عنبريس (عشب معمر أوراسي له أزهار وردية شاحبة وقرون منحنية؛ مستوطن في بريطانيا ومراعي أمريكا الشمالية في التربة الجيرية؛ محصول علف مهم ومصدر للعسل في بريطانيا)",
 "sang": "جنسنغ أمريكي (عشب الغابات في أمريكا الشمالية يشبه الجنسنغ الصيني ويستخدم كبديل له)",
 "sang-froid": "ثبات, ثقة بالنفس (برود أعصاب وهدوء كبير تحت الضغط)\nمثال: حافظ على هدوئك",
 "sangapenum": "سكدبينج (مجموعة متنوعة من الصمغ)",
 "sangaree": "سانجريا (نبيذ أحمر محلى وعصير برتقال أو ليمون مع مياه غازية)",
 "sango": "سَانْغُوِيَّة",
 "sango language": "السانغو (لغة تجارية تستخدم على نطاق واسع في تشاد وجمهورية أفريقيا الوسطى)",
 "sangoma": "سانغوما (معالج تقليدي وحكيم في ثقافة الزولو)",
 "sangria": "سانجريا",
 "sanguification": "تكون الدم, تكون الكريات (تكوين خلايا الدم في الجسم الحي (خاصة في نخاع العظم))",
 "sanguinaria canadensis": "جذر الدم, سانغويناريا (نبات معمر من غابات أمريكا الشمالية له جذر أحمر وعصارة حمراء، يحمل ورقة مفصصة وحيدة وزهرة بيضاء في أوائل الربيع وله خصائص مقيأة حريفة؛ يستخدم الساق…)",
 "sanguinary": "سَفَّاح, مُتَعَطِّش لِلدِّمَاء (يتسم بالتلهف على اللجوء إلى العنف وسفك الدماء) / دَامٍ, مُرَوِّع (مصحوب بسفك دماء)",
 "sanguinary ant": "نملة دموية (نملة مستعبدة واسعة الانتشار في نصف الكرة الشمالي)",
 "sanguine": "أَحْمَر الوَجْه, مُحْمَرّ (ذو بَشَرَة حَمْراء مُشْرِقَة تَدُلّ عَلى صِحَّة جَيِّدَة) / دَمَوِيّ, مُتَفَائِل بِثِقَة (متفائل بثقة ومرح) / أحمر دموي, أحمر قانٍ (لون أحمر مثل الدم) / سانغوين, طباشير أحمر (طباشير بلون بني محمر يشبه الدم الجاف)",
 "sanguineness": "استبشار, ثقة (الشعور بالاستبشار؛ تفاؤل مرح وواثق)",
 "sanguineous": "دَامٍ, مُرَوِّع (مصحوب بسفك دماء) / دَمَوِيّ, مُتَفَائِل بِثِقَة (متفائل بثقة ومرح)",
 "sanguinity": "استبشار, ثقة (الشعور بالاستبشار؛ تفاؤل مرح وواثق)",
 "sanhedrin": "السنهدرين, مجلس اليهود الأعلى (المجلس القضائي والكنسي الأعلى في القدس القديمة)",
 "sanicle": "جذر الثعبان, سانيكولة (جِذْرُ ٱلشَّيْءِ هُوَ: أَصْلُهُ؛ في : جذر العدد النوني هو عدد ما إذا رفعناه لقوة ما أعطانا العدد الأصلي)\nمثال: أحسب جذر خمسة بالآلة الحاسبة.",
 "sanicula arctopoides": "خطوات الربيع, سانيكولا صفراء (سانيكولا في شمال غرب الولايات المتحدة وكولومبيا البريطانية لها زهور صفراء)",
 "sanicula bipinnatifida": "سانيكولا أرجوانية (سانيكولا في شمال غرب الولايات المتحدة وكولومبيا البريطانية لها زهور صفراء أو حمراء أو أرجوانية)",
 "sanicula europaea": "سانيكولا أوروبية (سانيكولا في أوروبا وآسيا لها زهور بيضاء إلى وردية شاحبة)",
 "sanies": "صديد, قيح (منتج سائل للالتهاب)",
 "sanious": "صديدي, قيحي مائي (متعلق بالصديد المائي (المصل الدموي) أو يشبهه أو يتميز به)\nمثال: إفراز صديدي مائي",
 "sanitariness": "نظافة صحية (حالة كون الشيء ملائماً للصحة)",
 "sanitarium": "مصح, مصحة (مستشفى للنقاهة أو لعلاج الأمراض المزمنة)",
 "sanitary": "صحي, نظيف (خالٍ من القذارة ومسببات الأمراض)\nمثال: ظروف صحية لإعداد الطعام",
 "sanitary code": "القانون الصحي (مجموعة معايير تضعها وتفرضها الحكومة للمتطلبات الصحية كما في السباكة وغيرها)",
 "sanitary condition": "حالة صحية, وضع صحي (حالة النظافة العامة (نظيف أو قذر))",
 "sanitary landfill": "مكب نفايات صحي (منطقة منخفضة حيث تدفن النفايات بين طبقات من التربة)",
 "sanitary napkin": "فوطة صحية (وسادة ماصة تستخدم لمرة واحدة؛ تُرتدى لامتصاص تدفق الدورة الشهرية)",
 "sanitary towel": "فوطة صحية (وسادة ماصة تستخدم لمرة واحدة؛ تُرتدى لامتصاص تدفق الدورة الشهرية)",
 "sanitation": "اَلصِّحَّة الْعُمُومِيَّة",
 "sanitation department": "إدارة الصرف الصحي, قسم النظافة (إدارة تابعة للحكومة المحلية مسؤولة عن جمع القمامة والتخلص منها)",
 "sanitisation": "تطهير صحي, تعقيم (جعل الشيء صحياً (خالياً من الجراثيم) كما هو الحال عن طريق التعقيم)",
 "sanitised": "مظهر, معقم (تم جعله صحياً)",
 "sanitization": "تَعْقِيم ((وعَقَّمَهُ تَعْقيمًا: أسْكَتَه)؛ عقّم يعقِّم تعقيماً،فهو معقِّم،والمفعول مُعقَّم ، عَقَّمَ حجرة العمليات :أباد ما فيها من جراثيم ضارّة و ميكروبات لمنع تطوّر المرض الناقل لل جراثيم)",
 "sanitize": "عَقَّمَ",
 "sanitized": "مظهر, معقم (تم جعله صحياً)",
 "sanity": "رشاد, سلامة العقل (القوى الطبيعية أو السليمة للعقل)",
 "sanjak": "سَنْجَق",
 "sannup": "سانوب (رجل هندي أمريكي متزوج)",
 "sannyasi": "سانياسي (متسول ديني هندوسي)",
 "sannyasin": "سانياسي (متسول ديني هندوسي)",
 "sans serif": "سانس سيريف, هلفيتيكا",
 "sansevieria": "جلد النمر, سانسيفيريا (يزرع كنبات منزلي لأوراقه اللحمية المبرقشة التي تشبه السيف أو كمصدر للألياف)",
 "sansevieria guineensis": "قنب أفريقي, قنب الوتر الأفريقي (قنب الوتر من جنوب أفريقيا)",
 "sansevieria trifasciata": "جلد النمر, لسان الحماة (نبات عديم الساق له أوراق صلبة ضيقة يزرع غالباً كنبات منزلي)",
 "sansevieria zeylanica": "قنب الوتر السيلاني (نبات له أوراق ليفية سميكة مخططة عرضياً بالأخضر الفاتح والداكن)",
 "sanskrit": "سَنْسْكْرِيتِيّ",
 "sanskrit language": "السنسكريتية (لغة قديمة في الهند (لغة الفيدات والهندوسية)؛ لغة رسمية في الهند على الرغم من أنها تُستخدم الآن فقط للأغراض الدينية)",
 "sanskrit literature": "الأدب السنسكريتي (الأدب الهندوسي المكتوب بالسنسكريتية)",
 "sanskritic language": "السنسكريتية (لغة قديمة في الهند (لغة الفيدات والهندوسية)؛ لغة رسمية في الهند على الرغم من أنها تُستخدم الآن فقط للأغراض الدينية)",
 "sanson-flamsteed projection": "إسقاط جيبي (إسقاط خرائطي متساوي المساحات يظهر دوائر العرض وخط الاستواء كخطوط مستقيمة وخطوط الطول الأخرى كمنحنيات؛ يستخدم لخرائط المناطق الاستوائية)",
 "santa ana": "رياح سانتا آنا (رياح حارة وجافة قوية تهب في الشتاء من صحاري جنوب كاليفورنيا نحو ساحل المحيط الهادئ)",
 "santa catarina": "سَانْتَا كَاتَارِينَا",
 "santa claus": "بَابَا نُوِيل",
 "santa cruz cypress": "سرو سانتا كروز (سرو نادر في كاليفورنيا أطول من سرو غوين ولكنه وثيق الصلة به ويعتبر أحياناً نفس النوع)",
 "santa gertrudis": "سانتا جيرتروديس (سلالة مهجنة من البراهمان وقصير القرون من الماشية الحمراء؛ قوية في المناطق الحارة)",
 "santa lucia fir": "شوح سانتا لوسيا (شوح هرمي من جنوب غرب كاليفورنيا له أوراق مدببة شائكة وحراشف مخروطية ذات أشواك طويلة)",
 "santa maria tree": "شجرة سانتا ماريا, كالابا (شجرة من جزر الهند الغربية ذات عناقيد من الزهور البيضاء العطرة وتنتج خشباً متيناً وعصارة راتنجية)",
 "santa monica": "سَانْتَا مُونِيكَا",
 "santalum album": "شجرة الصندل, صندل أبيض (شجرة طفيلية من إندونيسيا وماليزيا ذات خشب قلب مصفر عطري ناعم الحبيبات بخصائص طاردة للحشرات ويستخدم، على سبيل المثال، لصنع الصناديق)",
 "santee": "لغة سانتي (اللغة السيووية التي يتحدث بها شعب سانتي) / سانتي (فرد من الفرع الشرقي للسيوكس)",
 "santee dakota": "سانتي (فرد من الفرع الشرقي للسيوكس)",
 "santee language": "لغة سانتي (اللغة السيووية التي يتحدث بها شعب سانتي)",
 "santee sioux": "سانتي (فرد من الفرع الشرقي للسيوكس)",
 "santiago": "سَانْتْيَاغُو",
 "santiago de compostela": "سانتياغو دي كومبوستيلا",
 "santims": "سانتيمس (100 سانتيمس تساوي 1 لاتس في لاتفيا)",
 "santo domingo": "سَانْتُو دُومِينْجُو",
 "santolina chamaecyparissus": "قيصوم قطني, لافندر القطن (شجيرة متوسطية عطرية متفرعة ذات سيقان وأوراق صوفية وأزهار صفراء)",
 "santorini": "سَانْتُورِينِي, ثِيرَا",
 "santorum": "سانتوروم (مصطلح عامي يشير إلى الخليط الرغوي من المزلقات والمواد البرازية الناتج العرضي للجنس الشرجي)",
 "santur": "سَنْطُور, سَنْطِير",
 "sanvitalia procumbens": "زينيا زاحفة, سانفيتاليا (نبات حولي ورقي منخفض التفرع له رؤوس زهرية تشبه الزينيا؛ يوجد في جنوب غرب الولايات المتحدة ومن المكسيك إلى غواتيمالا)",
 "sanwa millet": "دخن ياباني (عشب حولي خشن يزرع في اليابان وجنوب شرق آسيا لبذوره الصالحة للأكل وللعلف؛ غذاء مهم للحياة البرية في الولايات المتحدة)",
 "sanya": "سَانْيَا",
 "sanyasi": "سانياسي (متسول ديني هندوسي)",
 "sao thome e principe monetary unit": "وحدة نقدية لساو تومي وبرينسيب (الوحدة النقدية في ساو تومي وبرينسيب)",
 "sap": "نُسْغ, عُصَارَة",
 "sapele mahogany": "سابيلي, ماهوجني أفريقي معطر (شجرة أفريقية ذات خشب خفيف الوزن برائحة الأرز يتراوح لونه من الوردي إلى البني المحمر)",
 "saphar": "صفر (الشهر الثاني من التقويم الهجري)",
 "saphead": "أحمق, ساذج (شخص يفتقر إلى الحكم السليم)",
 "saphenous nerve": "عصب صافن (فرع من العصب الفخذي يوفر فروعاً جلدية للجانب الداخلي للساق والقدم)",
 "saphenous vein": "وريد صافن (أي من وريدين سطحيين رئيسيين في الساق يصرفان الدم من القدم)",
 "sapid": "ذُو مَذَاقٍ زَاخِر, غَنِيُّ النَّكْهَة (مَلِيءٌ بِالنَّكْهَة)",
 "sapidity": "استطابة, لذة (نكهة ممتعة) / مذاق, نكهة (تجربة التذوق عند وضع طعام متبل في الفم)",
 "sapidness": "استطابة, لذة (نكهة ممتعة)",
 "sapience": "حكمة, رجاحة (القدرة على تطبيق المعرفة أو الخبرة أو الفهم أو الحس السليم والبصيرة)",
 "sapiens": "بشري عاقل, عاقل (مكون من أو متعلق بـ أو مميز للإنسان العاقل)",
 "sapient": "بَصِير, حَصِيف (شديد الفطنة والحكمة والبصيرة)",
 "sapiential": "حِكْمِيّ (يتّسم بالحكمة وخاصّةً الحكمة الإلهيّة)",
 "sapiential book": "أدب الحكمة, كتب الحكمة (أي من الكتب الكتابية (أمثال، جامعة، نشيد الإنشاد، حكمة سليمان، يشوع بن سيراخ) التي تعتبر محتوية على الحكمة)",
 "sapiently": "بِدَهَاء, بِفِطْنَة (بطريقة ذكية)\nمثال: استثمر ثروته بذكاء",
 "sapindus drummondii": "شجرة الصابون البرية (شجرة متساقطة الأوراق في جنوب غرب الولايات المتحدة ذات ثمار لبية تحتوي على الصابونين)",
 "sapindus marginatus": "شجرة الصابون البرية (شجرة متساقطة الأوراق في جنوب غرب الولايات المتحدة ذات ثمار لبية تحتوي على الصابونين)",
 "sapindus saponaria": "أزدرخت, زنزلخت (شجرة دائمة الخضرة في أمريكا الاستوائية ذات ثمار لبية تحتوي على الصابونين الذي كان يستخدم كصابون من قبل السكان الأصليين)",
 "sapiosexuality": "الْاِنْجِذَاب لِلْأَذْكِيَاءِ",
 "sapless": "عَدِيم النُّسْغ, يَابِس (خالٍ من النسغ والعصارات الحيوية؛ جاف) / ضَعِيف, وَاهِن (يفتقر إلى القوة البدنية أو العضلية أو الحيوية)",
 "sapling": "شَتْلَة",
 "sapodilla": "سابوديلا, سبوتة (فاكهة استوائية ذات قشرة بنية خشنة ولب بني حلو جداً) / سبوتة, شجرة السبوتة (شجرة استوائية أمريكية كبيرة دائمة الخضرة تنتج صمغ الشيكل وفاكهة صالحة للأكل)",
 "sapodilla plum": "سابوديلا, سبوتة (فاكهة استوائية ذات قشرة بنية خشنة ولب بني حلو جداً)",
 "sapodilla tree": "سبوتة, شجرة السبوتة (شجرة استوائية أمريكية كبيرة دائمة الخضرة تنتج صمغ الشيكل وفاكهة صالحة للأكل)",
 "saponaceous": "صابوني (يشبه الصابون أو له صفاته)\nمثال: قوام صابوني",
 "saponaria officinalis": "صابونية مخزنية, عرق الحلاوة (نبات من أصل أوروبي له زهور وردية أو بيضاء وأوراق تنتج منظفاً عند سحقها)",
 "saponaria vaccaria": "فاكاريا, فوقس (نبات حولي أوروبي بزهور وردية باهتة؛ زهرة مزروعة أو عشب ذاتي البذر في حقول الحبوب؛ أدخل إلى أمريكا الشمالية؛ يصنف أحياناً كصابونية)",
 "saponification": "تصبن (تفاعل كيميائي يتم فيه تسخين إستر مع مادة قلوية (خاصة التحلل المائي القلوي للدهون أو الزيوت لصنع الصابون))",
 "saponified": "متصبن (محول إلى صابون)\nمثال: زيوت متصبنة",
 "saponin": "صابونين (أي من الغليكوزيدات النباتية المختلفة التي تشكل رغوة صابونية عند خلطها ورجّها مع الماء؛ تُستخدم في المنظفات وعوامل الرغوة والمستحلبات)",
 "saporous": "ذُو مَذَاقٍ زَاخِر, غَنِيُّ النَّكْهَة (مَلِيءٌ بِالنَّكْهَة)",
 "sapota": "سابوديلا, سبوتة (فاكهة استوائية ذات قشرة بنية خشنة ولب بني حلو جداً)",
 "sapote": "سابوتي, ماميا (فاكهة بيضاوية بنية لحمها يصنع منه شربات ممتاز) / سابوت, شجرة السابوت (شجرة أمريكية استوائية ذات خشب يشبه الماهوجني وثمار حلوة صالحة للأكل بيضاوية الشكل؛ في بعض التصنيفات توضع في جنس كالوكاربوم)",
 "sapper": "جندي هندسة عسكرية, حفار خنادق (مهندس عسكري يقوم بأعمال الحفر (حفر الخنادق أو تقويض التحصينات))",
 "sapphic": "سُحَاقِيّ (متعلِّق بالعلاقات المثليَّة بين النساء أو يتَّسم بها) / سَافِيّ (بحر شعري استخدمته الشاعرة سافو وسُمِّي باسمها)",
 "sapphic ode": "قصيدة هوراسية (قصيدة غنائية ذات عدة مقطوعات (على نمط هوراس))",
 "sapphire": "أَزْرَق يَاقُوتِيّ (أحد الأَلْوَان الرئيسية (الأَحْمَر والأَزْرَق والأَصْفَر) وهو لون السَمَاء نهارا حين تكون صافية. انظر الصورة؛ صفة ما كان لونه أزرقًا) / يَاقُوت, زَفِير\nمثال: هذا البناء أزرق.",
 "sapphire berry": "توت الياقوت, ورقة الحلوى الآسيوية (شجيرة متساقطة الأوراق من شرق آسيا تحمل ثماراً زرقاء زاهية للزينة)",
 "sapphirine": "ياقوتي (مصنوع من الياقوت أو يشبهه) / سافيرين (معدن نادر أزرق فاتح أو أخضر؛ يتكون من سيليكات الألمنيوم والمغنيسيوم ويوجد كحبوب صغيرة في بعض الصخور المتحولة)",
 "sapphism": "سحاق, مثلية نسائية (المثلية الجنسية عند الإناث)",
 "sapporo": "سَابُورُو",
 "sappy": "رَكِيكُ الحِسّ, مُبْتَذَلُ العَاطِفَة (مُفرِط في العاطفة بشكل مُتصنَّع أو غير صادق) / كَثِير النُّسْغ, نَسْغِيّ (غنيّ بالنُّسغ (عُصارة الشجر))",
 "sapraemia": "تسمم دموي رمي (تسمم الدم الناجم عن بكتيريا التعفن؛ ينتج عن تناول مواد متعفنة)",
 "sapremia": "تسمم دموي رمي (تسمم الدم الناجم عن بكتيريا التعفن؛ ينتج عن تناول مواد متعفنة)",
 "saprobe": "رمام مائي (كائن يعيش في ويستمد غذاءه من المواد العضوية في المياه الراكدة أو الآسنة)",
 "saprobic": "رمي (يعيش في بيئة غنية بالمواد العضوية ولكن تفتقر إلى الأكسجين)",
 "saprolegnia ferax": "فطر أبيض (فطر يهاجم الأسماك الحية والضفادع الصغيرة والبيض مسبباً مرض الفطر الأبيض: طبقة من الخيوط البيضاء خاصة على الأجزاء الطرفية (مثل الزعانف))",
 "saprolite": "سابروليت (رواسب من الطين والصخور المتحللة التي توجد في مكانها الأصلي)",
 "sapropel": "حمأة عضوية, سابروبيل (حمأة (غنية بالمواد العضوية) تتراكم في قاع البحيرات أو المحيطات)",
 "saprophagous": "آكِل الجِيَف, رَمِّيّ التَّغْذِيَة ((عَنْ بَعْض الحَيَوَانَات) يَتَغَذَّى عَلَى المَوَادّ الحَيَوَانِيَّة المَيِّتَة أَوِ المُتَحَلِّلَة)",
 "saprophyte": "رمام, كائن رمي (كائن يتغذى على المواد العضوية الميتة خاصة الفطريات أو البكتيريا)",
 "saprophytic": "رِمِّيّ, مُتَرَمِّم ((عَنْ بَعْض النَّبَاتَات أَوِ الفُطْرِيَّات) يَتَغَذَّى عَلَى المَوَادّ العُضْوِيَّة المَيِّتَة أَوِ المُتَحَلِّلَة) / رمي (يحصل على الغذاء أسموزياً من المواد العضوية المتحللة)",
 "saprophytic organism": "رمام, كائن رمي (كائن يتغذى على المواد العضوية الميتة خاصة الفطريات أو البكتيريا)",
 "saprozoic": "آكِل الجِيَف, رَمِّيّ التَّغْذِيَة ((عَنْ بَعْض الحَيَوَانَات) يَتَغَذَّى عَلَى المَوَادّ الحَيَوَانِيَّة المَيِّتَة أَوِ المُتَحَلِّلَة)",
 "sapsago": "سابسغو (جبن سويسري أخضر صلب مصنوع من خثرة الحليب منزوع الدسم ومنكه بالبرسيم)",
 "sapsucker": "مصاص العصارة (نقار خشب أمريكي صغير يتغذى على العصارة من أشجار التفاح والقيقب وغيرها)",
 "sapwood": "خَشَب النُّسْغِ, خَشَب كَاذِب (هو ما غَلَظَ وصَلُبَ من أصول الشَجَر وفروعها مثل الجِذْع والأغْصَان؛ هو ما صنع من جذوع أو أغصان الشَجَر)\nمثال: نحن نقطع الخشب.",
 "saquinavir": "إنفيراز, ساكوينافير (مثبط ضعيف للبروتياز (الاسم التجاري إنفيراز) يستخدم في علاج فيروس نقص المناعة البشرية)",
 "saraband": "ساراباند (رقصة بلاط فخمة من القرنين السابع عشر والثامن عشر؛ بإيقاع بطيء) / ساراباند (موسيقى مؤلفة لرقص الساراباند)",
 "saracen": "ساراسين ((تاريخياً) مسلم عارض الحملات الصليبية) / ساراسين ((تاريخياً) عضو في الشعوب البدوية في الصحاري السورية والعربية في وقت الإمبراطورية الرومانية) / ساراسين, عربي ((عند استخدامها بشكل واسع تاريخياً) أي عربي)",
 "sarafem": "بروزاك, سارافيم (مثبط استرداد السيروتونين الانتقائي يوصف عادة كمضاد للاكتئاب (الأسماء التجارية بروزاك وسارافيم)؛ يعتقد أنه يعمل عن طريق زيادة نشاط السيروتونين في…)",
 "sarah": "سَارَة",
 "sarajevo": "سَارَايِيفُو / سَرَايِيفُو",
 "saran": "ساران (أي من الراتنجات البلاستيكية الحرارية المختلفة المستخدمة لصنع الأشياء)",
 "saran wrap": "غلاف لاصق, نايلون تغليف (فيلم بلاستيكي رقيق مصنوع من ساران (الاسم التجاري ساران راب) يلتصق بنفسه؛ يستخدم لتغليف الطعام)",
 "saransk": "سَارَانْسْك",
 "sarape": "سارابي (شال طويل زاهي الألوان؛ يرتديه الرجال المكسيكيون بشكل رئيسي)",
 "saratoga chip": "رقائق البطاطس, شيبس (شريحة رقيقة مقرمشة من البطاطس مقلية في زيت غزير)",
 "saratoga spittlebug": "حشرة بصاق ساراتوجا (تتغذى على الصنوبر في شمال الولايات المتحدة)",
 "saratov": "سَارَاتُوف",
 "sarawak": "سراوق, ساراواك",
 "sarawakian": "ساراواكي (من أو متعلق بساراواك أو شعبها) / ساراواكي (مواطن أو ساكن في ساراواك)\nمثال: شواطئ ساراواكية",
 "sarcasm": "النقد الساخر, سُخْرِيَّة",
 "sarcastic": "ساخر",
 "sarcastically": "ساخرًا",
 "sarcenet": "سارسينت (قماش حريري ناعم ورقيق يستخدم غالباً للبطانات)",
 "sarcobatus vermiculatus": "خشب الشحم, خشب الشحم الأسود (شجيرة شائكة منخفضة كثيرة التفرع شائعة في التربة القلوية بغرب أمريكا)",
 "sarcocephalus diderrichii": "أوبيبي, نوكليا (شجرة غابات أفريقية كبيرة تنتج خشباً أصفر قوياً صلباً إلى بني ذهبي؛ توضع أحياناً في جنس ساركوسيفالوس)",
 "sarcocephalus esculentus": "خوخ الزنجي, ساركوسيفالوس (شجيرة استوائية قوية منتشرة أو شبه متسلقة ذات ثمار كروية ثؤلولية بنية محمرة؛ إفريقيا)",
 "sarcocephalus latifolius": "خوخ الزنجي, ساركوسيفالوس (شجيرة استوائية قوية منتشرة أو شبه متسلقة ذات ثمار كروية ثؤلولية بنية محمرة؛ إفريقيا)",
 "sarcochilus falcatus": "أوركيد زهر البرتقال (أوركيد أسترالي صغير بعناقيد رخوة من الزهور البيضاء العطرة بعلامات أرجوانية وبرتقالية على الشفة)",
 "sarcococca": "سُرْكُوك",
 "sarcocolla": "عَنْزَرُوت, أَنْزَرُوت",
 "sarcocystidean": "بوغيات عضلية (طفيل عضلات الفقاريات)",
 "sarcocystieian": "بوغيات عضلية (طفيل عضلات الفقاريات)",
 "sarcodes sanguinea": "نبات الثلج (نبات رمي أحمر زاهي لحمي في جبال غرب أمريكا الشمالية يظهر في أوائل الربيع بينما لا يزال الثلج على الأرض)",
 "sarcodine": "ساركودينا, لحميات (أوالي تتحرك وتلتقط الطعام عن طريق تكوين أقدام كاذبة)",
 "sarcodinian": "ساركودينا, لحميات (أوالي تتحرك وتلتقط الطعام عن طريق تكوين أقدام كاذبة)",
 "sarcoid": "لحمي (مكون من أو متعلق بـ أو يشبه اللحم)",
 "sarcoidosis": "داء الساركويد (مرض مزمن غير معروف السبب يتميز بتكوين عقيدات في الرئتين والكبد والغدد الليمفاوية والغدد اللعابية)",
 "sarcolemma": "غمد الليف العضلي (غشاء قابل للتمدد يحيط بالمادة المنقبضة للألياف العضلية)",
 "sarcolemmal": "غمدي عضلي (من أو يتعلق بغمد الليف العضلي (ساركوليما))",
 "sarcolemmic": "غمدي عضلي (مكون من أو متعلق بغمد الليف العضلي)",
 "sarcolemnous": "غمدي عضلي (مكون من أو متعلق بغمد الليف العضلي)",
 "sarcoma": "ساركومة (ورم خبيث عادة ينشأ من النسيج الضام (العظام أو العضلات وما إلى ذلك)؛ أحد الأنواع الأربعة الرئيسية للسرطان)",
 "sarcomere": "ساركومير, قُسَيْم عضلِي (وحدة من الوحدات التي ينقسم إليها اللييف العضلي)",
 "sarcophaga carnaria": "ذبابة اللحم (ذبابة تتغذى يرقاتها على الجيف أو لحم الحيوانات الحية)",
 "sarcophagus": "نَاوُوس",
 "sarcophilus harrisii": "شيطان تسمانيا (جرابي لاحم شرس صغير ذو معطف أسود في الغالب وذيل طويل)",
 "sarcoplasm": "ساركوبلازم, هيولى عضلية (سيتوبلازم الليفة العضلية المخططة)",
 "sarcoptid": "سوسة الجرب (سوس مبيض يهاجم جلد البشر والحيوانات الأخرى)\nمثال: سوس الجرب يسبب الجرب",
 "sarcorhamphus papa": "نسر الملك (نسر كبير أسود وأبيض من أمريكا الجنوبية والوسطى؛ له زوائد لحمية ملونة ونتوءات تشبه الثآليل على الرأس والرقبة)",
 "sarcoscypha coccinea": "كأس قرمزي (فطر قرصي يبشر بالربيع؛ الجسم الثمري رقيق وقوي وشكل الصحن (بحجم ربع إلى نصف دولار) بسطح علوي أحمر ساطع عميق وخارج مبيض)",
 "sarcosine": "ساركوزين (حمض أميني بلوري حلو المذاق)",
 "sarcosomal": "ساركوزومي (من أو يتعلق بالساركوزوم (ميتوكوندريا العضلات))",
 "sarcosomataceae": "ساركوسوماتاسيا (فصيلة من الفطريات الزقية تحتوي على 10 أجناس و 57 نوعاً)",
 "sarcosome": "جسيم عضلي (ميتوكوندريا كبيرة في الألياف العضلية المخططة)",
 "sarcosporidian": "بوغيات عضلية (طفيل عضلات الفقاريات)",
 "sarcostemma acidum": "سوما, هاوما (كرمة عديمة الأوراق من جزر الهند الشرقية؛ كانت عصارتها اللبنية الحامضة تستخدم سابقاً لصنع مشروب مسكر)",
 "sarcostyle": "لييفة عضلية (واحدة من العديد من الخيوط المتقلصة التي تشكل الألياف العضلية المخططة)",
 "sard": "سارد (نوع برتقالي محمر عميق من الكالسيدوني)",
 "sarda chiliensis": "بونيتو المحيط الهادئ, بونيتو تشيلي (بونيتو شائع في ساحل المحيط الهادئ للأمريكتين؛ لحمه الزيتي الداكن يُعلب جيداً)",
 "sarda sarda": "بونيتو الأطلسي, وثابة (سمكة طعام تشبه التونة متوسطة الحجم في مياه المحيط الأطلسي والهادئ الدافئة؛ أقل قيمة من التونة)",
 "sardina pilchardus": "بلشار, سردين (أسماك صغيرة توجد في أسراب كبيرة على طول سواحل أوروبا؛ أصغر وأكثر استدارة من الرنجة)",
 "sardine": "صَحْنَاة, صِحْنَاة",
 "sardine oil": "زيت السردين (زيت يتم الحصول عليه من السردين ويُستخدم بشكل رئيسي كمزلق وفي الصابون)",
 "sardinia": "سَرْدِينْيَا, سَرْدَانِيَة",
 "sardinian": "سَرْدِينِيَة",
 "sardinops caerulea": "سردين المحيط الهادئ (سردين صغير شائع قبالة ساحل المحيط الهادئ لأمريكا الشمالية)",
 "sardius": "سارد (نوع برتقالي محمر عميق من الكالسيدوني)",
 "sardonic": "سَاخِر, مُسْتَهْزِئ (ساخر باحتقار واستهزاء؛ يسخر ويتهكّم)",
 "sardonically": "بتهكم, بسخرية لاذعة (بطريقة ساخرة ومتهكمة)\nمثال: تدخل بتهكم قائلاً: 'آه، الآن بدأنا نصل إلى الحقيقة'",
 "sardonyx": "ساردونيكس, عقيق جزع (أونيكس يتميز بطبقات متوازية من السارد ومعدن ملون آخر)",
 "saree": "ساري (فستان ترتديه النساء الهندوسيات بشكل أساسي؛ يتكون من عدة ياردات من القماش الخفيف الذي يلف حول الجسم)",
 "sarepta mustard": "خردل ساربتا (خردل حار قليلاً أصله من روسيا)\nمثال: يستمد خردل ساربتا اسمه من مدينة ساربتا",
 "sargasso": "سارجاسم, سرجس (طحالب بنية ذات حويصلات مستديرة تشكل كتل عائمة كثيفة في مياه المحيط الأطلسي الاستوائية كما في بحر سارجاسو)",
 "sargassum": "سارجاسم, سرجس (طحالب بنية ذات حويصلات مستديرة تشكل كتل عائمة كثيفة في مياه المحيط الأطلسي الاستوائية كما في بحر سارجاسو)",
 "sargassum bacciferum": "سارجاسم, سرجس (طحالب بنية ذات حويصلات مستديرة تشكل كتل عائمة كثيفة في مياه المحيط الأطلسي الاستوائية كما في بحر سارجاسو)",
 "sargassum fish": "سمكة السرجس (أسماك صغيرة ذات أشكال وألوان عجيبة توجد بين كتل طحالب السرجس)",
 "sargon": "شَرُوكِين, سَرْجُون",
 "sari": "سَارِي (السَائِر ليلا؛ من لِبَاس النِسَاء الهُنُود بشكل قطعة كَبِيرَة من القِمَاش تلف حول الخَصْر كالتَنُّورَة ثم ترفع فترمى على الكَتِف)\nمثال: جواز سفر ساري المفعول.",
 "sarin": "سَارِين",
 "sark": "سَارك",
 "sarkozy": "سَارْكُوزِي",
 "sarong": "صَارُون",
 "sarracenia flava": "بوق الصياد, سراسينية صفراء (نبات إبريق في جنوب شرق الولايات المتحدة ذو أباريق صفراء منتصبة على شكل بوق ذات أفواه واسعة وأغطية منتصبة)",
 "sarracenia minor": "سراسينية صغرى, نبات الإبريق المقنع (نبات إبريق أصفر الزهور في جنوب شرق الولايات المتحدة ذو أوراق على شكل بوق مع فتحة مغطاة بغطاء مقوس)",
 "sarracenia purpurea": "سراسينية أرجوانية, نبات الإبريق الشائع (عشبة مستنقعات معمرة ذات زهور حمراء داكنة وأباريق مجنحة عريضة تشكل وردية؛ من شمال شرق أمريكا الشمالية ومتوطنة في أوروبا وخاصة أيرلندا)",
 "sarrebourg": "ساربورغ",
 "sars": "سارس, متلازمة تنفسية حادة وخيمة (مرض تنفسي مجهول السبب نشأ على ما يبدو في بر الصين الرئيسي في عام 2003؛ يتميز بالحمى والسعال أو صعوبة التنفس أو نقص الأكسجة؛ يمكن أن يكون قاتلاً)",
 "sarsaparilla": "سارساباريلا (مشروب غازي منكه بمستخلص من جذر السارساباريلا أو بزيت البتولا والسسافراس) / سارساباريلا, فصة",
 "sarsaparilla root": "جذر السارساباريلا, جذر الفشاغ (جذر مجفف لأي من نباتات مختلفة من جنس الفشاغ يستخدم كعامل منكه)",
 "sarsenet": "سارسينت (قماش حريري ناعم ورقيق يستخدم غالباً للبطانات)",
 "sartor": "ترزي, خياط (شخص مهنته صنع وتعديل الملابس)",
 "sartorial": "خاص بالخياطة, خياطي (مكون من أو متعلق بخياط أو بالخياطة) / خياطي (مكون من أو متعلق بالعضلة الخياطية)",
 "sartorius": "عضلة خياطية (عضلة في الفخذ تساعد على تدوير الساق في وضع الجلوس الذي يتخذه الخياط؛ أطول عضلة في جسم الإنسان)",
 "sartorius muscle": "عضلة خياطية (عضلة في الفخذ تساعد على تدوير الساق في وضع الجلوس الذي يتخذه الخياط؛ أطول عضلة في جسم الإنسان)",
