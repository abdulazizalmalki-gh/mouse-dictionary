 "searocket": "إِسْلِيح",
 "seascape": "لوحة بحرية, منظر بحري (لوحة للبحر (لتمييزها عن المناظر الطبيعية البرية)) / منظر بحري (مشهد للبحر)",
 "seashell": "صَدَفَة, صَدَفَة بَحْرِيَّة (الصدفة. جمع: صُدُفات و صُدْفات و صُدَف٬ هي تزامن غير متوقع لحدوث فعلين بدون تخطيط مسبق، رآه صُدْفةً…)\nمثال: لا تدعها للصدفة.",
 "seashore": "سَاحِل, شَاطِئ",
 "seashore mallow": "خبازة الشاطئ (أي من نباتات مختلفة من جنس كوستيليتزيا في الموائل الساحلية غالباً؛ تُزرع لزهورها التي تشبه الخطمي)",
 "seasick": "مُصَاب بِدُوَار السَّفَر (يعاني من دوار ناتج عن الحركة كالسفر بالسيّارة أو الطائرة أو السفينة)",
 "seasickness": "دُوَار اَلْبَحْر, مَيْد (في : هي الدَار الكبيرة الفاخرة أو دار العُمْدَة. الجمع دُوَّارَات)\nمثال: كان لديها دوار.",
 "seaside": "سَاحِل, شَاطِئ",
 "seaside alder": "نغت بحري (شجيرة أو شجرة صغيرة من جنوب شرق الولايات المتحدة لها خشب بني فاتح ناعم)",
 "seaside centaury": "قنطريون ساحلي (صنف من القنطريون يوجد عند شاطئ البحر)",
 "seaside daisy": "أقحوان شاطئي, نجمة الشاطئ (نبات معمر عصاري قليلاً بأوراق قاعدية وسيقان لزجة مشعرة كل منها يحمل رأس زهرة منفرداً بأشعة ضيقة وردية أو لافندر؛ المنحدرات الساحلية من أوريغون إلى…)",
 "seaside goldenrod": "عصا الذهب الشاطئية (عصا ذهب مبهرجة قوية شائعة على طول الساحل الشرقي وساحل الخليج لأمريكا الشمالية)",
 "seaside mahoe": "شجرة بورشيا, ماهو ساحلي (شجرة استوائية في السواحل عادة تزرع أحياناً للزينة لأوراقها القلبية المستديرة وزهورها الصفراء والأرجوانية المبهرجة)",
 "seaside scrub oak": "سنديان آسي (شجيرة أو شجرة صغيرة دائمة الخضرة موطنها جنوب شرق الولايات المتحدة؛ غالباً ما تشكل غابات كثيفة لا يمكن اختراقها في المناطق الساحلية الرملية)",
 "seasnail": "حلزون بحري (أي من بطنيات القدم البحرية الزاحفة ذات صدفة ملفوفة حلزونياً) / سمكة الحلزون (أسماك صغيرة تشبه الشرغوف تعيش في المياه الباردة مع زعانف حوضية تشكل ممصاً؛ مرتبطة بسمكة الكتل)",
 "season": "مَوْسِم / مَوْسِم, جُزْء",
 "season ticket": "تذكرة اشتراك, تذكرة موسمية (تذكرة صالحة لعدة رحلات أو لحضور موسم من الفعاليات الترفيهية؛ تباع بسعر مخفض)",
 "seasonable": "مناسب للموسم (يتماشى مع الموسم) / فِي أَوَانِه, فِي الوَقْت المُنَاسِب (يحدث أو يتم في الوقت الملائم أو المناسب)\nمثال: صقيع قاسٍ ولكن مناسب للموسم",
 "seasonableness": "توقيت مناسب, مناسبة الوقت (الكون في الوقت المناسب)",
 "seasonably": "فِي الوَقْت المُنَاسِب (في وقت ملائم) / وَفْقًا لِلمَوْسِم (وفقاً للموسم)\nمثال: وصلت رسالتك في الوقت المناسب",
 "seasonal": "موسمي (يحدث في أو يعتمد على موسم معين) / عامل موسمي (عامل يجد عملاً فقط في مواسم معينة)\nمثال: عمالة موسمية",
 "seasonal adjustment": "تعديل موسمي (تعديل إحصائي يتم لاستيعاب التقلبات المتوقعة كدالة لموسم السنة)\nمثال: يجب إجراء التعديلات الموسمية لبدايات الإسكان في منتصف الشتاء",
 "seasonal worker": "عامل موسمي (عامل يجد عملاً فقط في مواسم معينة)",
 "seasonally": "موسمياً (اعتماداً على الموسم أو الفصل)\nمثال: الأسعار معدلة موسمياً",
 "seasoned": "مُجَرَّب, مُحَنَّك (اكتسب الكفاءة من خلال التجارب والخبرة العملية) / مجفف, مُعتق (مُعمر أو مُعالج)\nمثال: خشب معتق",
 "seasoned salt": "ملح متبل (مزيج من الملح ومستخلصات الخضروات والتوابل وغلوتامات أحادية الصوديوم)",
 "seasoner": "تابل, مطيب (شيء يضاف للطعام أساساً من أجل النكهة التي يضفيها) / متبّل (طباخ يستخدم التوابل)\nمثال: الطباخ يتبل الطعام بخفة",
 "seasoning": "بَهَار, تَابِل",
 "seat": "مَقْعَد, مَقْعَدَة (كل ما يُقْعَدُ ويُجْلَسُ عليه؛ مَكَان القُعُود)\nمثال: نام ياني على مقعد.",
 "seat belt": "حِزَام أَمَان (خيط أو قطعة من جلد تستخدم لحَزْم النَبَات أو العِيدَان أو غيرها لتكوين حُزْمَة؛ النِطَاق، قطعة من الجِلْد الطَوِيل يلف حول الخَصْر إما ليمسك المَلابِس أو ليظهر الخصر)\nمثال: هذا حزام من الجلد.",
 "seat cushion": "وسادة المقعد (وسادة تجعل المقعد أكثر راحة)",
 "seatbelt": "حزام الأمان (حزام أمان يستخدم في سيارة أو طائرة لتثبيتك في مقعدك في حالة وقوع حادث)",
 "seated": "جالس ((للأشخاص) الجذع منتصب والأرجل مثنية مع ارتكاز الجسم على الأرداف)\nمثال: العذراء الجالسة",
 "seating": "إجلاس, تنظيم الجلوس (خدمة إرشاد الناس إلى مقاعدهم) / أَمَاكِن جُلُوس, مَقَاعِد (منطقة تتضمن أماكن يمكن لعدة أشخاص الجلوس فيها)\nمثال: توجد مقاعد لـ 40 طالباً في هذا الفصل",
 "seating area": "أَمَاكِن جُلُوس, مَقَاعِد (منطقة تتضمن أماكن يمكن لعدة أشخاص الجلوس فيها)\nمثال: توجد مقاعد لـ 40 طالباً في هذا الفصل",
 "seating capacity": "سعة المقاعد (عدد الأشخاص الذين يمكن جلوسهم في مركبة أو قاعة أو ملعب وما إلى ذلك)",
 "seating room": "أَمَاكِن جُلُوس, مَقَاعِد (منطقة تتضمن أماكن يمكن لعدة أشخاص الجلوس فيها)\nمثال: توجد مقاعد لـ 40 طالباً في هذا الفصل",
 "seats": "أَمَاكِن جُلُوس, مَقَاعِد (منطقة تتضمن أماكن يمكن لعدة أشخاص الجلوس فيها)\nمثال: توجد مقاعد لـ 40 طالباً في هذا الفصل",
 "seattle": "سِيَاتَل",
 "seawall": "كاسر الأمواج (هيكل واقي من الحجر أو الخرسانة؛ يمتد من الشاطئ إلى الماء لمنع جرف الشاطئ)",
 "seaward": "باتجاه البحر, نحو البحر (في الاتجاه المؤدي إلى البحر) / بِاتِّجَاهِ البَحْر (متجه أو واقع بعيداً عن اليابسة ونحو البحر) / بَحْرِيّ, نَحْو البَحْر ((للرياح) قادمة من اليابسة) / بَاتِّجَاه البَحْر (الاتجاه نحو البحر)\nمثال: نظر البحار باتجاه البحر",
 "seawards": "باتجاه البحر, نحو البحر (في الاتجاه المؤدي إلى البحر)\nمثال: نظر البحار باتجاه البحر",
 "seawater": "ماء البحر, ماء مالح (ماء يحتوي على أملاح)",
 "seaway": "طريق ملاحي, ممر بحري (ممر في البحر يعتبر طريقاً منتظماً للسفن)",
 "seaweed": "عُشْب بَحْرِيّ",
 "seaworthiness": "صلاحية للإبحار (اللياقة لعبور البحار)",
 "seaworthy": "صالح للإبحار (مناسب للرحلات البحرية)",
 "seax": "ساكس, سكين الساكس (نوع من السيوف أو الخناجر النموذجية للشعوب الجرمانية في فترة الهجرة والعصور الوسطى المبكرة، وخاصة الساكسون)\nمثال: في البداية، تم العثور على الساكس بجانب السيوف ذات الحدين وكان يُقصد بها غالباً أن تكون سلاحاً جانبياً",
 "seb": "ذيفان معوي عنقودي ب (شكل من أشكال الذيفان المعوي العنقودي الذي استخدم كعامل شل القدرة في الحرب البيولوجية)",
 "sebaceous": "دَهِن, زَيْتِيّ (يَحْتَوِي عَلَى كَمِّيَّة غَيْر عَادِيَّة مِنَ الشَّحْم أَوِ الزَّيْت)",
 "sebaceous cyst": "كيس دهني (كيس شائع في الجلد مملوء بمادة دهنية تفرزها غدة دهنية مسدودة)",
 "sebaceous follicle": "غدة دهنية (غدة جلدية تفرز الزهم (عادة في بصيلة الشعر) لترطيب الشعر والجلد)",
 "sebaceous gland": "غُدَّة دُهْنيّة",
 "sebacic acid": "حمض السيباسيك (حمض ثنائي الكربوكسيل يستخدم لصنع الراتنجات)",
 "sebastes caurinus": "سمكة الصخر النحاسية (سمكة صخرية في المياه الساحلية للمحيط الهادئ لأمريكا الشمالية)",
 "sebastes marinus": "سمكة الورد, فرخ المحيط (سمكة كبيرة في سواحل شمال المحيط الأطلسي لأمريكا وأوروبا)",
 "sebastes miniatus": "سمكة الصخر القرمزية (سمكة مهمة تجارياً في ساحل المحيط الهادئ لأمريكا الشمالية)",
 "sebastes ruberrimus": "سمكة الصخر الحمراء (سمكة كبيرة في ساحل المحيط الهادئ لأمريكا الشمالية)",
 "sebastia": "سَبَسْطِيَّة",
 "sebe": "الجَنُوب الشَّرْقِيّ المَائِل لِلشَّرْق, جَنُوب شَرْقِيّ لِشَرْق (نقطة البوصلة التي تقع شرق الجنوب الشرقي بنقطة واحدة)",
 "seborrhea": "سيلان دهني (حالة يؤدي فيها فرط نشاط الغدد الدهنية إلى جعل الجلد دهنياً)",
 "seborrheic dermatitis": "إكزيما دهنية, التهاب الجلد الدهني (مرض جلدي مزمن مرتبط بالسيلان الدهني وقشور دهنية على فروة الرأس أو الجفون أو أجزاء أخرى من الجلد)",
 "seborrheic eczema": "إكزيما دهنية, التهاب الجلد الدهني (مرض جلدي مزمن مرتبط بالسيلان الدهني وقشور دهنية على فروة الرأس أو الجفون أو أجزاء أخرى من الجلد)",
 "seborrheic keratosis": "تقران دهني (حالة جلدية تتميز بآفات تشبه الثآليل محددة الحواف يمكن أن تكون مثيرة للحكة ومغطاة بقشرة دهنية)",
 "sebs": "الجَنُوب الشَّرْقِيّ المَائِل لِلجَنُوب, جَنُوب شَرْقِيّ لِجَنُوب (نقطة البوصلة التي تقع جنوب الجنوب الشرقي بنقطة واحدة)",
 "sebum": "إفراز دهني, زهم (الإفراز الزيتي للغدد الدهنية؛ مع العرق يرطب ويحمي الجلد)",
 "sec": "سِيك, مُعْتَدِل الجَفَاف ((للشمبانيا) جاف بشكل معتدل) / لجنة الأوراق المالية والبورصات (وكالة فيدرالية مستقلة تشرف على تداول الأوراق المالية لحماية المستثمرين) / قَا, قَاطِع (نسبة الوتر إلى الضلع المجاور في مثلث قائم الزاوية) / ثانية (1/60 من الدقيقة؛ الوحدة الأساسية للوقت المعتمدة في النظام الدولي للوحدات)",
 "secale cereale": "جاودار, شيلم (عشبة حبوب سنوية قوية التحمل تزرع على نطاق واسع في شمال أوروبا حيث تعد حبوبها المكون الرئيسي للخبز الأسود وفي أمريكا الشمالية للعلف وتحسين التربة)",
 "secant": "قَاطِع",
 "secateurs": "مقص تقليم صغير (مقص تقليم صغير بنابض يبقي المقابض مفتوحة وشفرة واحدة تغلق على سطح مستو)",
 "secernment": "تفرقة, تمييز (العملية المعرفية التي يتم من خلالها التمييز بين محفزين أو أكثر) / إفراز (العملية العضوية لتركيب وإطلاق مادة ما)",
 "secession": "إِنْشِقَاق",
 "secessionism": "انفصالية (مذهب يؤكد حق الانفصال)",
 "secessionist": "انفصالي (مدافع عن الانفصال)",
 "sechuana": "تسوانا (لهجة السوتو التي يتحدث بها التسوانا في بوتسوانا)",
 "seckel": "كمثرى سيكل (كمثرى صغيرة صفراء إلى بنية محمرة)",
 "seckel pear": "كمثرى سيكل (كمثرى صغيرة صفراء إلى بنية محمرة)",
 "secluded": "مُنْتَبِذ, مُنْعَزِل (يُوفِّر الخصوصية أو العزلة) / خَفِيّ, مَسْتُور (مُخبَّأ عن الأنظار العامّة أو الاستخدام العامّ)",
 "seclusion": "اِعْتِكَاف, عُزْلَة (فعل عزل نفسك عن الآخرين) / خصوصية, عزلة (صفة الانعزال عن وجود أو أنظار الآخرين)",
 "secobarbital": "سيكوباربيتال الصوديوم, سيكونال (باربيتورات عبارة عن مسحوق أبيض عديم الرائحة مر قليلاً (الاسم التجاري سيكونال) يستخدم كملح صوديوم للتهدئة ولعلاج التشنجات)",
 "secobarbital sodium": "سيكوباربيتال الصوديوم, سيكونال (باربيتورات عبارة عن مسحوق أبيض عديم الرائحة مر قليلاً (الاسم التجاري سيكونال) يستخدم كملح صوديوم للتهدئة ولعلاج التشنجات)",
 "seconal": "سيكوباربيتال الصوديوم, سيكونال (باربيتورات عبارة عن مسحوق أبيض عديم الرائحة مر قليلاً (الاسم التجاري سيكونال) يستخدم كملح صوديوم للتهدئة ولعلاج التشنجات)",
 "second": "ثَانٍ, تاني / ثَانِيَة, ثانية (وحدة زمنية تعادل جزءًا من ستين جزءًا من الدقيقة)\nمثال: لن أفعلها ثانية.",
 "second adventism": "أدفنتست, مجيئية (أي دين مسيحي يعتقد أن المجيء الثاني للمسيح وشيك)",
 "second adventist": "أدفنتي, مجيئي (عضو في طائفة مسيحية تتوقع المجيء الوشيك للمسيح)",
 "second balcony": "الدرجة الثالثة, الشرفة الثانية (المنطقة الخلفية أو العلوية في الشرفة التي تحتوي على أرخص المقاعد)",
 "second banana": "دور ثانوي (شخص يخدم بصفة تابعة أو يلعب دوراً ثانوياً) / سنيد, ممثل مساعد للكوميدي (مؤدٍ يلعب دور المساعد أو 'السنيد' للممثل الكوميدي الرئيسي)",
 "second base": "القاعدة الثانية (مركز اللعب للاعب في فريق البيسبول المتمركز بالقرب من القاعدة الثانية في الملعب الداخلي) / القاعدة الثانية (القاعدة التي يجب أن يلمسها العداء ثانياً في لعبة البيسبول)",
 "second baseman": "لاعب القاعدة الثانية ((في البيسبول) رجل يلعب في القاعدة الثانية)",
 "second basewoman": "لاعبة القاعدة الثانية ((في البيسبول) امرأة تلعب في القاعدة الثانية)",
 "second best": "صاحب المركز الثاني, وصيف (المنافس الذي ينهي السباق في المركز الثاني)",
 "second childhood": "خرف, هرم (الضعف العقلي نتيجة لكبر السن)",
 "second class": "بالدرجة الثانية (بواسطة وسائل نقل الدرجة الثانية) / درجة ثانية, درجة سياحية (فئة من أماكن الإقامة على متن سفينة أو قطار أو طائرة أقل تكلفة من أماكن الدرجة الأولى) / درجة ثانية (ليس أعلى جودة في التصنيف) / درجة ثانية (ليست أعلى رتبة في التصنيف)\nمثال: سافرنا بالدرجة الثانية",
 "second council of constantinople": "مجمع القسطنطينية الثاني (المجمع المسكوني الخامس عام 553 الذي اعتبر كتابات أوريجانوس هرطقة)",
 "second council of lyons": "مجمع ليون الثاني (المجمع المنعقد عام 1274 الذي حقق اتحاداً مؤقتاً بين الأرثوذكس اليونانيين والكنيسة الرومانية الكاثوليكية)",
 "second council of nicaea": "مجمع نيقية الثاني (المجمع المسكوني السابع عام 787 الذي دحض حرب الأيقونات ونظم تكريم الصور المقدسة)",
 "second cousin": "قريب من الدرجة الثانية (ابن ابن عم أو ابن خال أحد الوالدين)",
 "second cranial nerve": "عصب بصري, عصب قحفي ثاني (العصب القحفي الذي يخدم الشبكية)",
 "second deck": "السطح الرئيسي (أعلى سطح مغطى يمتد على طول السفينة الكبيرة بالكامل)",
 "second empire": "الإمبراطورية الثانية (الحكومة الإمبراطورية لنابليون الثالث في فرنسا من 1852-1870)",
 "second estate": "الطبقة الثانية, النبلاء (النبلاء في فرنسا وطبقة النبلاء في بريطانيا)",
 "second fiddle": "دور ثانوي (دور أو وظيفة ثانوية) / دور ثانوي (شخص يخدم بصفة تابعة أو يلعب دوراً ثانوياً)\nمثال: كان يكره أن يلعب دوراً ثانوياً لأي شخص",
 "second gear": "الترس الثاني, السرعة الثانية (الترس الذي له ثاني أدنى نسبة تروس أمامية في صندوق تروس المركبة)\nمثال: كان عليه أن ينتقل إلى الترس الثاني لصعود التل",
 "second growth": "غابة ثانوية النمو (نمو ثانوي للأشجار يغطي منطقة تم تدمير الغطاء الأصلي فيها بالحريق أو القطع)",
 "second half": "شوط ثاني (الثاني من شوطين للعب)",
 "second hand": "عَقْرَب ثَوَانِي",
