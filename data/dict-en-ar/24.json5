 "saturnine": "عَبُوس, كَئِيب (يُظهر مزاجاً قاتماً ومكتئباً) / عَابِس, مُتَجَهِّم (لاذع أو ساخر بمرارة وازدراء)",
 "saturnism": "تسمم بالرصاص (حالة سامة تنتج عن امتصاص كمية زائدة من الرصاص في الجسم)",
 "satyagraha": "سَاتْيَاغْرَاهَا, مُقَاوَمَة المَهَاتْمَا غَانْدِي (شكل من أشكال المقاومة اللاعنفية التي بدأها المهاتما غاندي في الهند لمعارضة الحكم البريطاني وتسريع الإصلاحات السياسية)",
 "satyr": "ساتير",
 "satyr orchid": "أوركيد الساتير, سيلوجلوسوم (أوركيد بأوراق بيضاوية عريضة وزهور خضراء طويلة القنابات غير منتظمة جداً)",
 "satyr play": "مسرحية ساتير, مسرحية ساخرة (مسرحية هزلية يونانية قديمة مع جوقة من الساتير (كائنات أسطورية))",
 "satyriasis": "سعار جنسي ذكري (رغبة جنسية شديدة بشكل غير طبيعي لدى الرجال)",
 "satyric": "شبقي, شهواني (من أو متعلق بـ أو لديه خصائص الساتير (المخلوق الشبق))\nمثال: هذا الرجل العجوز الشبق يلاحق الفتيات الصغيرات",
 "satyrical": "شبقي, شهواني (من أو متعلق بـ أو لديه خصائص الساتير (المخلوق الشبق))\nمثال: هذا الرجل العجوز الشبق يلاحق الفتيات الصغيرات",
 "sauce": "صَلْصَة, مَرَق",
 "sauce albert": "صلصة الفجل الحار (صلصة بيضاء كريمية مع الفجل الحار والخردل)",
 "sauce chausseur": "صلصة الصياد (صلصة بنية وهريس طماطم مع بصل وفطر ونبيذ أبيض جاف)",
 "sauce espagnole": "صلصة إسبانيول, صلصة بنية (مرق اللحم مكثف بالزبدة والدقيق (رو) ومتبل بالأعشاب أو ورسيستيرشاير) / إسبانيول (صلصة بنية مع طماطم وخليط مكرمل من الجزر والبصل والكرفس المفروم متبلة بماديرا)",
 "sauce louis": "صلصة لويس (مايونيز وكريمة ثقيلة ممزوجة بالفلفل الأخضر المفروم والبصل الأخضر متبلة بصلصة الفلفل الحار وصلصة ورسيستيرشاير وعصير الليمون)",
 "sauce verte": "مايونيز أخضر (مايونيز مع الطرخون أو الشبت والجرجير المفروم والسبانخ أو الخيار)",
 "sauce vinaigrette": "تتبيلة فرنسية, فينيغريت (زيت وخل مع خردل وثوم)",
 "sauce-alone": "ثوم السياج, خردل الثوم (عشبة أوروبية تفوح منها رائحة الثوم)",
 "sauceboat": "قارب المرق, وعاء الصلصة (طبق (غالباً على شكل قارب) لتقديم المرق أو الصلصة)",
 "saucepan": "قِدْر, طَنْجَرَة (قضاء الله وحكمه وما قَدَّرَه؛ مبلغ الشيء وكميتّه، بنفس معنى قَدْر)\nمثال: خذ قدر ما تريد.",
 "saucepot": "قدر طهي (وعاء طهي له مقابض على كلا الجانبين وغطاء محكم؛ يستخدم للسلق أو الغلي)",
 "saucer": "صُحَيْفَة, طَبَق فِنْجَان",
 "saucer magnolia": "ماغنوليا صحنية, ماغنوليا صينية (شجيرة كبيرة متساقطة الأوراق أو شجرة صغيرة ذات زهور وردية إلى أرجوانية مفتوحة كبيرة؛ موطنها آسيا؛ تقدر كنبات زينة في شرق أمريكا الشمالية)",
 "saucer-eyed": "مُسْتَدِير العَيْنَيْن (ذو عينين كبيرتين مستديرتين مفتوحتين على وسعهما)",
 "saucer-shaped": "صَحْنِيُّ الشَّكْل (ذو شكل مقعّر يشبه الصحن الصغير)",
 "saucily": "بصفاقة, بوقاحة (بطريقة وقحة أو سفيهة)\nمثال: كان رفيق أسمر نحيل يحدق عبر النافذة، مبتسماً بوقاحة",
 "sauciness": "تطاول, وقاحة (مرح غير لائق)",
 "saucy": "سَلِيط, صَفِيق (جريء ومتطاول بشكل غير لائق) / جَرِيءُ اللِّسَان, وَقِح (يتّسم بخفّة وقحة ومرح طافح)",
 "saudi": "سُعُودِيّ (من، أو متعلق بالمملكة العربية السعودية)\nمثال: آية هي مواطنة سعودية.",
 "saudi arabia": "السُّعُودِيَّة, ٱلْعَرَبِيَّة ٱلسُّعُودِيَّة (اسم مختصر للمملكة العربية السعودية)\nمثال: أنا من السعودية.",
 "saudi arabian": "سعودي (مواطن أو ساكن في المملكة العربية السعودية)",
 "saudi arabian monetary unit": "وحدة نقدية سعودية (الوحدة النقدية في المملكة العربية السعودية)",
 "saudi arabian riyal": "ريال, ريال سعودي (وحدة المال الأساسية في المملكة العربية السعودية)",
 "saudi-arabian": "سعودي, سعودي عربي (من أو متعلق بالمملكة العربية السعودية أو شعبها)\nمثال: الصحراء السعودية",
 "sauerbraten": "ساوربراتن (شواء قدر منقوع لعدة أيام في خل متبل قبل الطهي؛ يقدم عادة مع زلابية البطاطس)",
 "sauerkraut": "كُرُنْب مُخَلَّل, زَوَكْرَوْت",
 "sauk": "سوك (فرد من شعب ألغونكي كان يعيش سابقاً في ويسكونسن في وادي نهر فوكس وعلى شواطئ الخليج الأخضر)",
 "saul": "شَاؤُول, طَالُوت / شَاؤُول / سَوْل, شَاؤُول",
 "sauna": "سَاوْنَا, صُونَة",
 "saunter": "تجوال, تنزة (مشي متمهل (عادة في مكان عام)) / تبختر, تسكع (مشية مهملة ومتمهلة)\nمثال: مشى بتسكع كأنه لا يحمل هماً في العالم",
 "saunterer": "متسكع, متمش (شخص يمشي بخطى متمهلة)",
 "saurel": "جاك ماكريل, ماكريل الحصان (سمكة طعام من كاليفورنيا) / ماكريل الحصان (سمكة طعام كبيرة ممدودة ومضغوطة تعيش في مياه المحيط الأطلسي لأوروبا)",
 "saurian": "عظائيات (أي من الزواحف المختلفة من رتيبة العظائيات التي تشمل السحالي؛ في التصنيفات السابقة شملت أيضاً التماسيح والديناصورات) / سحلي, عظائي (متعلق بالسحالي (العظايا))",
 "saurischian": "سحليات الورك (ديناصور عاشب أو لاحم له حوض ثلاثي الشعب مثل التمساح)",
 "saurischian dinosaur": "سحليات الورك (ديناصور عاشب أو لاحم له حوض ثلاثي الشعب مثل التمساح)",
 "sauromalus obesus": "تشاكوالا (سحلية آكلة للأعشاب تعيش بين الصخور في المناطق القاحلة من جنوب غرب الولايات المتحدة والمكسيك)",
 "sauropod": "ديناصور سوروبود, سوروبود (ديناصور عشبي ضخم جداً من العصر الجوراسي والطباشيري له رأس صغير على رقبة طويلة وذيل وأطراف خماسية الأصابع؛ أكبر حيوان بري معروف)",
 "sauropod dinosaur": "ديناصور سوروبود, سوروبود (ديناصور عشبي ضخم جداً من العصر الجوراسي والطباشيري له رأس صغير على رقبة طويلة وذيل وأطراف خماسية الأصابع؛ أكبر حيوان بري معروف)",
 "saururus cernuus": "ذيل السحلية, زنبق المستنقع (نبات معمر عشبي من أمريكا الشمالية في الأماكن الرطبة له عناقيد رفيعة مجعدة من الزهور البيضاء الصغيرة)",
 "saury": "سمك الصوري (سمكة نحيلة طويلة المنقار من مياه المحيط الأطلسي المعتدلة)",
 "sausage": "سُجُق, نَقَانِق",
 "sausage balloon": "منطاد غير صلب, منطاد مراقبة (منطاد صغير غير صلب يستخدم للمراقبة أو كمنطاد حاجز)",
 "sausage curl": "خُصْلَة أُسْطُوَانِيَّة (تجعيدة سميكة تشبه النقانق)",
 "sausage dog": "كلب ألماني, كلب السجق (مصطلح غير رسمي (يطلق عادة على كلب الداشهند))",
 "sausage hound": "كلب ألماني, كلب السجق (مصطلح غير رسمي (يطلق عادة على كلب الداشهند))",
 "sausage maker": "حشابة سجق, مكبس السجق (مكبس يدوي صغير يستخدم لدفع السجق داخل الغلاف)",
 "sausage meat": "لحم السجق (أي لحم مفروم ومتبل ويطهى كأقراص أو يستخدم لحشو السجق)",
 "sausage pizza": "بيتزا السجق (بيتزا الطماطم والجبن مع السجق)",
 "sausage roll": "لفافة السجق (لحم سجق ملفوف ومخبوز في المعجنات)",
 "sausage stuffer": "حشابة سجق, مكبس السجق (مكبس يدوي صغير يستخدم لدفع السجق داخل الغلاف)",
 "sausage-shaped": "نَقَانِقِيُّ الشَّكْل (على شكل النقانق)",
 "saussurea costus": "قسط, قسط هندي (عشب حولي في شرق جبال الهيمالايا (كشمير) له زهور قرصية أرجوانية وجذر عطري ينتج زيتاً طياراً يستخدم في العطور ولحفظ الفراء)",
 "saussurea lappa": "قسط, قسط هندي (عشب حولي في شرق جبال الهيمالايا (كشمير) له زهور قرصية أرجوانية وجذر عطري ينتج زيتاً طياراً يستخدم في العطور ولحفظ الفراء)",
 "saute": "سُوتِيه, مُقَلَّى (مَقْلِيٌّ بِسُرْعَةٍ فِي قَلِيلٍ مِنَ الدُّهْن) / سوتيه, مشوح (طبق من الطعام المشوح)",
 "sauteed": "سُوتِيه, مُقَلَّى (مَقْلِيٌّ بِسُرْعَةٍ فِي قَلِيلٍ مِنَ الدُّهْن)",
 "sauteing": "تشويح, قلي (الطهي في دهن أو زيت في مقلاة أو صاج)",
 "sauterne": "سوترن (نبيذ مائدة أو حلوى ذهبي اللون شبه حلو من حول بوردو في فرنسا؛ نبيذ مماثل من كاليفورنيا)",
 "sauternes": "سوترن (نبيذ مائدة أو حلوى ذهبي اللون شبه حلو من حول بوردو في فرنسا؛ نبيذ مماثل من كاليفورنيا)",
 "sauvignon blanc": "ساوفيجنون بلان (نبيذ من كاليفورنيا) / ساوفيجنون بلانك (عنب نبيذ أبيض يزرع في كاليفورنيا)",
 "sauvignon grape": "عنب ساوفيجنون (عنب أزرق مسود صغير من منطقة ميدوك بفرنسا يحظى بتقدير كبير في صناعة النبيذ)",
 "savage": "مُتَوَحِّش / هَمَجِيّ / مُتَوَحِّش, هَمَجِيّ",
 "savagely": "بضراوة, بوحشية (بطريقة وحشية) / بهمجية, بوحشية (بشكل بري؛ مثل الحيوان)\nمثال: هوجم بوحشية",
 "savageness": "همجية, وحشية (خاصية كون الشيء غير مروض وشرس)\nمثال: الساحل مليء بالشواهد على وحشية المياه",
 "savagery": "بربرية, همجية (فعل همجي وحشي بربري) / شراسة, ضراوة (سمة القسوة المفرطة) / همجية, وحشية (خاصية كون الشيء غير مروض وشرس)\nمثال: الساحل مليء بالشواهد على وحشية المياه",
 "savanna": "سَبْسَب, سَهْل العُشْبِي",
 "savannah": "سافانا",
 "savant": "عَالِم (الذي يعلم؛ متخصص في عِلْم ما وباحث فيه)\nمثال: هو عالم أحيائي.",
 "savant syndrome": "متلازمة الموهوب (حالة يُظهر فيها الشخص الذي يعاني من إعاقة عقلية (مثل اضطراب طيف التوحد) قدرات فائقة ومذهلة تتجاوز بكثير ما يعتبر طبيعيًا)\nمثال: الأفراد الذين تم تشخيصهم بمتلازمة الموهوب يمتلكون قدرة لا مثيل لها في مهارات ومجالات معينة",
 "savara": "سافارا (لغة درافيدية يتحدث بها شعب سافارا في جنوب شرق الهند (شمال مدراس)) / سافارا (عضو في الشعب الدرافيدي الذي يعيش في جنوب الهند)",
 "savara language": "سافارا (لغة درافيدية يتحدث بها شعب سافارا في جنوب شرق الهند (شمال مدراس))",
 "savarin": "سافارين (كعكة إسفنجية مخبوزة في قالب حلقي)",
 "save": "أَنْقَذَ, أَنْجَى / اِدَّخَرَ / حَفِظَ (الحِفْظُ نَقِيضُ النِّسْيَان، وهو التَّعَاهُدُ وقِلَّةُ الغَفْلَةِ؛ قِلَّةُ الغَفْلَةِ)\nمثال: حفظ رقم هاتفها.",
 "save face": "حَفِظَ مَاءَ الوَجْهِ (الحِفْظُ نَقِيضُ النِّسْيَان، وهو التَّعَاهُدُ وقِلَّةُ الغَفْلَةِ؛ قِلَّةُ الغَفْلَةِ)\nمثال: حفظ رقم هاتفها.",
 "save-all": "شبكة تحميل (شبكة تعلق بين السفينة والرصيف أثناء تحميل السفينة) / شراع إضافي, شراع التقاط (شراع يوضع لالتقاط الرياح المتسربة من شراع أكبر) / وعاء تجميع الفواقد (وعاء لالتقاط النفايات لاستخدامها لاحقاً)",
 "saved": "مَحْمِيّ, مُنْقَذ (مَحْرُوسٌ مِنَ الأَذَى أَوِ الدَّمَار) / مخلص, ناجٍ (تم إنقاذه؛ خاصة من قوة وعواقب الخطيئة)\nمثال: روح ناجية",
 "saveloy": "سافيلوي (سجق خنزير مطهو جاهز ومتبل بشدة)",
 "saver": "مُخَلِّص, مُنْقِذ (شخص ينقذ شيئاً أو شخصاً من خطر أو عنف) / مُدَّخِر (شخص يدخر (وخاصة المال))",
 "savin": "أَبْهُل, شَبِينَة (أَبْهَلَ (أبهله): بهله؛ (أَبْهَلَ) الراعي رعيته: تركهم يفعلون ما يشاؤون لا يأخذ على أيديهم فهم مبهلون)",
 "saving": "خَصْم, حَسْم (الخَصْمُ :مُجَادِل، مُنَازِع، مُخَاصِم، عكسه حَلِيف أو صَدِيْق، وقد يستوي فيه المفرد والمثنى والجمع؛ والخَصْمُ (في ) : حَطِيطَة) / مُدَخَرَات",
 "saving grace": "حسنة شافعة, خصلة منجية (صفة أو ميزة تشفع للشخص أو تعوض عن عيوبه) / حالة النعمة, نعمة ((اللاهوت المسيحي) حالة التقديس من قبل الله؛ حالة الشخص الذي يخضع لمثل هذا التأثير الإلهي)\nمثال: حبها للموسيقى يظل حسنتها الشافعة الوحيدة",
 "savings": "تحويشة العمر, مدخرات (صندوق من المال يتم ادخاره كاحتياطي)",
 "savings account": "حِسَابُ تَوْفِير, حِسَابُ إِيدَاع (بمعنى عَدَّ وجَمَعَ وطَرَحَ كلها معا. جمعه حُسْبَان؛ الاسم من المُحَاسَبَة، لأن فيه تُحسب المحاسن والأخطاء)\nمثال: الحساب لو سمحت.",
 "savings account trust": "ائتمان توتن, ائتمان حساب التوفير (حساب توفير يودعه شخص يجعل نفسه أميناً لمستفيد ويتحكم فيه خلال حياته؛ وبعد ذلك يُدفع الرصيد للمستفيد المسمى مسبقاً)",
 "savings and loan": "جمعية ادخار وإقراض (مؤسسة ادخار يُطلب منها قانوناً تقديم نسبة معينة من قروضها كرهون عقارية للمنازل)",
 "savings and loan association": "جمعية ادخار وإقراض (مؤسسة ادخار يُطلب منها قانوناً تقديم نسبة معينة من قروضها كرهون عقارية للمنازل)",
 "savings bank": "مَصْرِفُ اِدِّخَار, بَنْكُ اِدِّخَار (في الاقتصاد: مؤسسة مالية مُرَخصة، تختص بإتمام الخدمات المالية كتلقي عمليات الإيداع، ومنح القروض، وإدارة الثروات، واستبدال العملات)\nمثال: عدن إلى المصرف.",
 "savings bank trust": "ائتمان توتن, ائتمان حساب التوفير (حساب توفير يودعه شخص يجعل نفسه أميناً لمستفيد ويتحكم فيه خلال حياته؛ وبعد ذلك يُدفع الرصيد للمستفيد المسمى مسبقاً)",
 "savings bond": "سند ادخار (سند حكومي غير قابل للتداول؛ لا يمكن شراؤه وبيعه بمجرد الشراء الأصلي)",
 "savior": "مُخَلِّص, مُنْقِذ (الشخص الذي يفي ولا يخون)\nمثال: الغيرة لا تجعل أحد مخلص",
 "saviour": "مُخَلِّص, مُنقِذ (شخص ينقذك من الأذى أو الخطر)",
 "savoie": "سافوا",
 "savoir-faire": "حسن تصرف, دراية (القدرة على فعل أو قول ما هو مناسب للمناسبة)",
 "savor": "مذاق, نكهة (تجربة التذوق عند وضع طعام متبل في الفم)",
 "savoriness": "طيب النكهة, لذة (امتلاك نكهة فاتحة للشهية)",
 "savoring": "تذوق (أخذ كمية صغيرة في الفم لاختبار جودتها)\nمثال: كان الطهي جيدًا ولكن التذوق هو ما استمتع به أكثر",
 "savorless": "تَافِه, عَدِيمُ الطَّعْم (يَفْتَقِرُ إِلَى الطَّعْمِ أَوِ النَّكْهَة)",
 "savorlessness": "انعدام النكهة, تفاهة (خاصية عدم امتلاك أي نكهة)",
 "savory": "شَهِيّ, مَرِيء / مالح / نَدْغ",
 "savour": "مذاق, نكهة (تجربة التذوق عند وضع طعام متبل في الفم)",
 "savouring": "تذوق (أخذ كمية صغيرة في الفم لاختبار جودتها)\nمثال: كان الطهي جيدًا ولكن التذوق هو ما استمتع به أكثر",
 "savourless": "تَافِه, عَدِيمُ الطَّعْم (يَفْتَقِرُ إِلَى الطَّعْمِ أَوِ النَّكْهَة)",
 "savourlessness": "انعدام النكهة, تفاهة (خاصية عدم امتلاك أي نكهة)",
 "savoury": "شَهِيّ, لَذِيذ (ذو مذاق طيّب يُسيل اللعاب) / شريف, طيب السمعة (سليم أو مقبول من الناحية الأخلاقية) / لَذِيعُ المَذَاق, مُتَبَّل (ذُو طَعْمٍ لَاذِعٍ مُسْتَسَاغ) / سافوري, مشهيات مالحة (طبق عطري أو متبل يُقدم في نهاية العشاء أو كمقبلات)\nمثال: ماض لم يكن شريفاً تماماً",
 "savoy": "ملفوف سافوي (رأس من الأوراق المجعدة الناعمة)",
 "savoy cabbage": "ملفوف سافوي (رأس من الأوراق المجعدة الناعمة) / كرنب سافوي, ملفوف سافوي (نبات ملفوف برأس مدمج من الأوراق المجعدة)",
 "savoyard": "سافوي (مقيم في سافوي) / مؤدي سافويارد (شخص يؤدي في أوبريتات جيلبرت وسوليفان)",
 "savvy": "الدهاء",
 "saw": "مِنْشَار / نَشَرَ (بَسَطَ، فَرَّقَ، نَشَرَ الشيءَ: جعله منتشراً، مثل نشر الأخبار أو نشر كتاب؛ نَشَرَ: وزع أو عمم شيئًا بين الناس، مثل نشر المقالات)\nمثال: نشر توم الغسيل.",
 "saw log": "جذع للنشر (جذع كبير بما يكفي ليتم نشره إلى ألواح)",
 "saw palmetto": "بالميتو المنشاري (نخيل شائك صغير قوي يشكل كتل من جنوب الولايات المتحدة)",
 "saw set": "مفتاح تفليج المنشار (أداة تستخدم لثني كل سن بديل للمنشار بزاوية طفيفة للخارج (تفليج))",
 "saw-like": "مِنْشَارِيّ (يشبه المنشار في شكل حوافه المسنّنة)",
 "saw-toothed": "مُسَنَّنٌ تَسْنِينًا مِنْشَارِيًّا, مِنْشَارِيّ (محزّز كالمنشار بأسنان تتّجه نحو القمّة)",
 "sawan": "شرافانا (الشهر الخامس من التقويم الهندوسي)",
 "sawbill": "بلقشة (بط غواص كبير آكل للأسماك ذو عرف ومنقار نحيل معقوف بحواف مسننة)",
 "sawbones": "جراح (طبيب متخصص في الجراحة)",
 "sawbuck": "حامل النشر (هيكل لحمل الخشب الذي يتم نشره)",
 "sawdust": "نُشَارَة",
 "sawdust doll": "دمية نشارة الخشب (دمية محشوة بنشارة الخشب)",
 "sawdust mushroom": "فطر نشارة الخشب (غاريقون صالح للأكل يوجد في أكوام نشارة الخشب الصلب؛ القبعات سوداء ومجعدة بشكل خشن)",
 "sawdust saloon": "حانة نشارة الخشب (حانة أرضيتها مغطاة بنشارة الخشب)",
 "sawdust stove": "موقد نشارة الخشب (موقد رخيص وسهل الصنع يحرق وقوداً مجانياً أو منخفض التكلفة)",
 "sawed-off": "مَقْصُوص, مُقَصَّر (تَمَّ تَقْصيرُه أَوْ قَطْعُه) / ضَئِيل الحَجْم, قَزَم (أقل بكثير من متوسط الطول)",
 "sawed-off shotgun": "بندقية صيد مقصوصة (بندقية صيد ذات مواسير قصيرة)",
 "sawfish": "سمك المنشار (سمكة راي بدائية ذات أسنان حادة على كل حافة من خطم طويل مفلطح)",
 "sawfly": "دبور المنشار, ذبابة المنشار (حشرة تمتلك أنثاها آلة وضع بيض تشبه المنشار لإدخال البيض في أنسجة أوراق أو سيقان النبات العائل)",
 "sawhorse": "حامل النشر (هيكل لحمل الخشب الذي يتم نشره)",
 "sawing machine": "منشار كهربائي (أداة كهربائية لقطع الخشب)",
 "sawm": "صَوْم, صِيَام",
 "sawmill": "مَنْشَرَة",
 "sawn-off": "مَقْصُوص, مُقَصَّر (تَمَّ تَقْصيرُه أَوْ قَطْعُه) / ضَئِيل الحَجْم, قَزَم (أقل بكثير من متوسط الطول)",
 "sawpit": "حفرة النشر (حفرة يوضع فوقها الخشب لنشره بواسطة رجلين باستخدام منشار طويل بمقبضين)",
 "sawtooth": "سن المنشار (تسنن على نصل المنشار)",
 "sawtoothed-edged": "مُسَنَّن الحَافَّة ((للأوراق) ذو حافة تشبه أسنان المنشار)",
 "sawwort": "سيراتولا, عشبة المنشار (نبات أوروبي معمر تنتج أوراقه المسننة صبغة صفراء)",
 "sawyer": "خنفساء ناشرة (أي من الخنافس المتعددة التي تحفر يرقاتها ثقوباً في الأشجار الميتة أو المحتضرة وخاصة الصنوبريات) / نشّار (شخص يتم توظيفه لنشر الخشب)",
 "sawyer beetle": "خنفساء ناشرة (أي من الخنافس المتعددة التي تحفر يرقاتها ثقوباً في الأشجار الميتة أو المحتضرة وخاصة الصنوبريات)",
 "sax": "ساكسفون (آلة نفخ خشبية بقصبة واحدة وتجويف مخروطي)",
 "saxatile": "ساكن الصخور, صخري (ينمو على أو يعيش بين الصخور)",
 "saxaul": "رِمْث, رَمْث (رَمَّثَ على كذا: زاد؛ يقال: رَمَّثَ على الخمسين، ورَمَّثَتْ غَنَمُهُ على المئةِ)",
 "saxe-coburg-gotha": "ساكس-كوبورغ-غوتا (اسم العائلة المالكة التي حكمت بريطانيا العظمى من 1901-1917؛ تم تغيير الاسم إلى وندسور في عام 1917 استجابة للمشاعر المعادية للألمان في الحرب العالمية…)",
 "saxe-gothea conspicua": "طقسوس الأمير ألبرت (طقسوس صغير ذو أوراق جذابة وفروع متدلية جزئياً يزرع كنبات زينة؛ جبال جنوب تشيلي)",
 "saxhorn": "ساكس هورن (أي من عائلة آلات النفخ النحاسية التي تشبه البوق بصمامات)",
 "saxicola rubetra": "قليعي أحمر (طائر مغرد أوروبي بني وأصفر برتقالي يعيش في المروج العشبية)",
 "saxicola torquata": "قليعي مطوق (طائر أوروبي شائع ذو ريش أسود وصدر بني محمر)",
 "saxicoline": "ساكن الصخور, صخري (ينمو على أو يعيش بين الصخور)",
 "saxicolous": "ساكن الصخور, صخري (ينمو على أو يعيش بين الصخور)",
 "saxicolous plant": "نبات صخري (النباتات التي تنمو بين الصخور)",
 "saxifraga aizoides": "كاسر الحجر الجبلي الأصفر (نبات معمر دائم الخضرة ذو خصلات له أوراق مهدبة وزهور خيمية صفراء غالباً ما تكون مرقطة بالبرتقالي)",
 "saxifraga granulata": "ساكسفراجا جرانيولاتا, كاسر الحجر المروجي (نبات معمر يشكل وريدات وله عناقيد مدمجة من الزهور البيضاء؛ أوروبا)",
 "saxifraga hypnoides": "ساكسفراجا هيبنويدس, كاسر الحجر الطحلبي (نبات معمر ذو خصلات أو يشكل حصيرة في جبال أوروبا؛ يزرع لزهوره البيضاء)",
 "saxifraga occidentalis": "كاسر الحجر الغربي (كاسر حجر له عناقيد رخوة من الزهور البيضاء على سيقان مشعرة تنمو من عنقود من الأوراق القاعدية؛ المنحدرات الرطبة في غرب أمريكا الشمالية)",
 "saxifraga oppositifolia": "كاسر الحجر الأرجواني (نباتات تشكل وسائد كثيفة بزهور أرجوانية محمرة زاهية؛ المناطق الصخرية في أوروبا وآسيا وغرب أمريكا الشمالية)",
 "saxifraga sarmentosam": "غرنوقي الفراولة, كاسر الحجر المتدلي (كاسر حجر آسيوي شرقي بعناقيد من الزهور الحمراء والبيضاء الصغيرة؛ ينتشر عن طريق العديد من السيقان الزاحفة)",
 "saxifraga stellaris": "كاسر الحجر النجمي (نبات ألبي صغير يشكل حصيرة غالباً له زهور بيضاء صغيرة تشبه النجوم؛ أوروبا)",
 "saxifraga stolonifera": "غرنوقي الفراولة, كاسر الحجر المتدلي (كاسر حجر آسيوي شرقي بعناقيد من الزهور الحمراء والبيضاء الصغيرة؛ ينتشر عن طريق العديد من السيقان الزاحفة)",
 "saxifrage": "كاسر الحجر (الذي قام بالكَسْر؛ اسم من أسماء العُقَاب)",
 "saxist": "عازف ساكسفون (موسيقي يعزف على الساكسفون)",
 "saxitoxin": "ساكسيتوكسين (سم عصبي قوي تنتجه بعض السوطيات الدوارة الموجودة في المد الأحمر؛ يمكن أن يتراكم في الرخويات ويسبب تسمماً للبشر)",
 "saxon": "سَكْسُونِيّ",
 "saxony": "صاقس, سكسونيا",
 "saxophone": "سَاكْسُفُون",
 "saxophonist": "عازف ساكسفون (موسيقي يعزف على الساكسفون)",
 "say": "قَالَ, قال (نَطَقَ بالكلام) / يَتْلُو / قَالَ, يَقُول (نَطَقَ بالكلام)\nمثال: قال زيري وداعا.",
 "say goodbye": "وَدَّعَ",
 "say grace": "تَلَا صَلاةَ المائِدة (قَرَأَ، نحو: تَلُوتُ القرآن تلاوةً أي قرأته؛ اتّبَعَ، نحو: تلا الكتاب والسنة، أو تبع فلان في عمله وسار على نهجه)",
 "say-so": "تفويض, سلطة (القوة أو الحق في إصدار الأوامر أو اتخاذ القرارات) / تصريح رسمي, قول فصل (إعلان سلطوي أو رسمي) / ادعاء شخصي, زعم (تأكيد تعسفي لشخص ما)\nمثال: لديه السلطة لإصدار مذكرات التوقيف",
 "sayanci": "زار (لغة تشادية يتم التحدث بها في شمال نيجيريا، وخاصة في ولاية باوتشي)",
 "sayanci language": "زار (لغة تشادية يتم التحدث بها في شمال نيجيريا، وخاصة في ولاية باوتشي)",
 "sayeret": "سيريت ماتكال (وحدة الكوماندوز السرية للنخبة في إسرائيل المسؤولة عن مكافحة الإرهاب وجمع المعلومات الاستخباراتية السرية للغاية ومهام إنقاذ الرهائن)",
 "sayeret mat'kal": "سيريت ماتكال (وحدة الكوماندوز السرية للنخبة في إسرائيل المسؤولة عن مكافحة الإرهاب وجمع المعلومات الاستخباراتية السرية للغاية ومهام إنقاذ الرهائن)",
 "sayeret matkal": "سيريت ماتكال (وحدة الكوماندوز السرية للنخبة في إسرائيل المسؤولة عن مكافحة الإرهاب وجمع المعلومات الاستخباراتية السرية للغاية ومهام إنقاذ الرهائن)",
 "saying": "قَوْل",
 "sayonara": "سَايُونَارَا",
 "sayornis phoebe": "فيبي (صائد ذباب صغير بني اللون من أمريكا الشمالية)",
 "sayyid": "سَيِّد",
 "sazerac": "سازيراك (كوكتيل مصنوع من البوربون مع بيترز وبيرنو وسكر يقدم مع قشر ليمون)",
 "saïda": "صَيْدَا",
 "sb": "بكالوريوس العلوم (درجة البكالوريوس في العلوم) / أنتيمون, إثمد (عنصر فلزي له أربعة أشكال تآصلية؛ يستخدم في مجموعة واسعة من السبائك)",
 "sba": "إدارة المشاريع الصغيرة (وكالة مستقلة تابعة لحكومة الولايات المتحدة تحمي مصالح الشركات الصغيرة وتضمن حصولها على حصة عادلة من العقود الحكومية)",
 "sbe": "الجَنُوب المَائِل لِلشَّرْق, جَنُوب لِشَرْق (نقطة البوصلة التي تقع شرق الجنوب بنقطة واحدة)",
 "sbw": "الجَنُوب المَائِل لِلغَرْب, جَنُوب لِغَرْب (نقطة البوصلة التي تقع غرب الجنوب بنقطة واحدة)",
 "sc": "مجلس الأمن (مجلس دائم للأمم المتحدة؛ مسؤول عن حفظ السلام العالمي) / سكانديوم (عنصر فلزي أبيض ثلاثي التكافؤ؛ يصنف أحياناً في مجموعة الأتربة النادرة)",
 "scab": "جُلْبَة",
 "scabbard": "غِمْد, غِلَاف",
 "scabby": "جَرَبِيّ, مُقَشَّر (مغطّى بقشور أو جُلب)",
 "scabicide": "مبيد الجرب (دواء يقضي على سوسة الحكة التي تسبب الجرب)",
 "scabies": "جَرَب (أَصابَهُ الجَرَب؛ السَّيْفُ: صَدِئَ)\nمثال: جرب هذا الكسكس.",
 "scabiosa": "جربن, سكابيوسا (أي من نباتات متنوعة من جنس سكابيوسا)",
 "scabiosa arvensis": "جرب الحقل (نبات معمر له زهور زرقاء ليلكية؛ أدخل إلى شرق الولايات المتحدة)",
 "scabiosa atropurpurea": "جرب الحلو, زهرة وسادة الدبابيس (نبات حولي من العالم القديم له رؤوس زهور عطرة أرجوانية إلى قرمزية عميقة؛ متوطن في الولايات المتحدة)",
 "scabious": "جربن, سكابيوسا (أي من نباتات متنوعة من جنس سكابيوسا)",
 "scablands": "أراضٍ قاحلة متخددة ((جيولوجيا) أرض مرتفعة مسطحة ذات تربة فقيرة وقليل من الغطاء النباتي تتخللها قنوات جافة من أصل جليدي (خاصة في شرق واشنطن))",
 "scabrous": "إِبَاحِيّ (يتناول مواضيع فاحشة أو منافية للآداب) / قِشْرِيّ, مُتَقَشِّر (مغطّى بقشور أو حراشف دقيقة)",
 "scad": "سكاد (أي من عدد من الأسماك من فصيلة الشيميات)",
 "scads": "أطنان, أكوام (عدد أو كمية كبيرة)\nمثال: كون الكثير من الصداقات الجديدة",
 "scaffold": "سِقَالَة, إِسْقَالَة",
 "scaffolding": "سِقَالَات, سِقَالَة",
 "scag": "إتش, سم (أسماء دارجة للهيروين)",
 "scalability": "قَابِلِيَّة التَّوَسُّع, قَابِلِيَّة القِيَاس (صفة القابلية للتوسع أو تغيير الحجم)",
 "scalable": "قابل للتسلق (يمكن تسلقه)\nمثال: منحدر الجبل القابل للتسلق",
 "scalage": "تقدير الكمية, وزن (فعل القياس بالوزن أو الكمية أو البعد) / تقدير الأخشاب (تقدير كمية الخشب في جذع شجرة)",
 "scalar": "سلمي, قياسي (من أو متعلق بمقدار لا اتجاه له (مثل الكتلة أو السرعة وما إلى ذلك) يتم تحديده بالكامل بواسطة مقداره) / سلمي, مقامي (من أو متعلق بمقام موسيقي) / عدد مجرد, كمية قياسية (كمية متغيرة لا يمكن تحليلها إلى مكونات)\nمثال: كمية قياسية",
 "scalar field": "حقل سلمي, حقل قياسي (حقل من الكميات السلمية (القياسية))",
 "scalar matrix": "مصفوفة سلمية (مصفوفة قطرية تكون فيها جميع العناصر القطرية متساوية)",
 "scalar product": "جُدَاء قِيَاسِيّ, ضَرْب نُقَطِيّ (عدد حقيقي (كمية قياسية) هو حاصل ضرب متجهين)",
 "scalawag": "شقي, عفريت (شخص مؤذٍ بمرح) / أفاق, محتال (شخص مخادع ولا يمكن الوثوق به) / سكالواج (جنوبي أبيض دعم سياسات إعادة الإعمار بعد الحرب الأهلية الأمريكية (عادةً لمصلحة ذاتية))",
 "scald": "حرق بالسوائل, سلق (عملية الحرق بالبخار أو الماء الساخن) / سلق (حرق ناتج عن سائل ساخن أو بخار)",
 "scalded milk": "حليب مسخن, حليب مغلي (حليب تم تسخينه حتى درجة الغليان تقريبًا)",
 "scale": "مِقْيَاس / مِيزَان (آلة تُوزن بها الأشياء ويُعْرف مِقْدارها؛ عَدْل) / سُلَّمٌ مُوسِيقِيّ (أَمِنَ على نفسه وحالته؛ بَرِئَ من الآفات والْأَذَى) / سُلَّم (أَمِنَ على نفسه وحالته؛ بَرِئَ من الآفات والْأَذَى) / فَلْس, حَرْشَف\nمثال: هم يريدون السلم.",
 "scale factor": "عَامِل القِيَاس (عدد يستخدم كمضروب في عمليات تغيير الحجم أو القياس)",
 "scale fern": "سرخس حرشفي (سرخس أوروبي صغير بسعف جلدي قشري)",
 "scale insect": "حشرة قشرية (حشرة صغيرة من رتبة متشابهات الأجنحة تعيش وتتغذى عادة على النباتات وتفرز غطاء شمعياً واقياً)",
 "scale leaf": "حرشفة (ورقة متخصصة أو قنابة تحمي برعماً أو نورة هرية)",
