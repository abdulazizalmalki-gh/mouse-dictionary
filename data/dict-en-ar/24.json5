 "s.u.v.": "سيارة رياضية متعددة الأغراض (سيارة دفع رباعي عالية الأداء مبنية على هيكل شاحنة)",
 "s/n": "نِسْبَة الإِشَارَة إِلَى الضَّجِيج (نسبة كثافة الإشارة إلى كثافة الضجيج)",
 "sa": "كتيبة العاصفة (ميليشيا نازية أنشأها هتلر عام 1921 ساعدته في الوصول إلى السلطة ولكن طغت عليها القوات الخاصة بعد عام 1943)",
 "sa node": "عقدة جيبية أذينية, ناظمة قلبية (قطعة متخصصة من نسيج القلب تتحكم في ضربات القلب)",
 "saad": "سورة ص",
 "saale glaciation": "تجلد سال (التجلد قبل الأخير في العصر البليستوسيني في شمال أوروبا والرواسب التي تكونت في ذلك الوقت)",
 "saame": "اللاب, سامي (لغة اللابيين الرحل في شمال إسكندنافيا وشبه جزيرة كولا) / سامي, لابي (فرد من شعب بدوي أصلي يعيش في شمال الدول الإسكندنافية ويرعى الرنة)",
 "saame language": "اللاب, سامي (لغة اللابيين الرحل في شمال إسكندنافيا وشبه جزيرة كولا)",
 "saami": "اللاب, سامي (لغة اللابيين الرحل في شمال إسكندنافيا وشبه جزيرة كولا) / سامي, لابي (فرد من شعب بدوي أصلي يعيش في شمال الدول الإسكندنافية ويرعى الرنة)",
 "saami language": "اللاب, سامي (لغة اللابيين الرحل في شمال إسكندنافيا وشبه جزيرة كولا)",
 "saarburg": "زاربورغ",
 "saarland": "سارلاند",
 "sabaean": "سَبَئِيّ",
 "sabahan": "صباحي (من أو متعلق بولاية صباح (الماليزية) أو شعبها) / صباحي (ماليزي من صباح)\nمثال: رجال قبائل صباحيون",
 "sabal palmetto": "نخيل الملفوف (نخيل مروحي الأوراق منخفض النمو من الساحل الجنوبي للولايات المتحدة له براعم أوراق صالحة للأكل)",
 "sabaoth": "رب الجنود ((جمع) جحافل أو جيوش؛ استخدمت في سفر رومية في العهد الجديد)\nمثال: رب الجنود",
 "sabat": "سَابَاط",
 "sabatia campestris": "ساباتيا البراري, نجمة تكساس (عشب براري بزهور أرجوانية فاتحة منفردة)",
 "sabaton": "حذاء درعي, واقي القدم (درع صفيحي يحمي القدم؛ يتكون من زرد مع مقدمة وكعب صلبين)",
 "sabayon": "زاباليوني, سابايون (تحلية رغوية خفيفة تشبه الكاسترد تُقدم ساخنة أو مبردة)",
 "sabbat": "اجتماع الساحرات, سبت الساحرات (اجتماع ليلي للساحرات لممارسة السحر والشعوذة؛ في العصور الوسطى كان يُعتقد أنه طقوس شيطانية)",
 "sabbatarian": "سبتي (متعلق بيوم السبت ومراعاته) / سبتي (شخص يقدس يوم السبت كيوم راحة (كما في اليهودية))",
 "sabbath": "اَلسَّبْت",
 "sabbath school": "مدرسة الأحد (مدرسة تجتمع أيام الأحد للتعليم الديني)",
 "sabbatia": "سباتيا (أي من النباتات المختلفة من جنس سباتيا ذات أزهار سيمية وردية عادة؛ توجد من المستنقعات الحمضية إلى المستنقعات المالحة)",
 "sabbatia angularis": "قرنفل المستنقعات, قنطريون أمريكي (أي من عدة نباتات مستنقعات زهرية اللون من شرق الولايات المتحدة تشبه القنطريون الحقيقي)",
 "sabbatia campestris": "ساباتيا البراري, نجمة تكساس (عشب براري بزهور أرجوانية فاتحة منفردة)",
 "sabbatia stellaris": "قرنفل المستنقعات, قنطريون أمريكي (أي من عدة نباتات مستنقعات زهرية اللون من شرق الولايات المتحدة تشبه القنطريون الحقيقي)",
 "sabbatic": "سبتي (من أو متعلق بيوم السبت (يوم الراحة))\nمثال: الجمعة هو يوم الراحة (السبت) للمسلمين",
 "sabbatical": "تفرغي (من أو متعلق بإجازة التفرغ) / سبتي (من أو متعلق بيوم السبت (يوم الراحة)) / إجازة تفرغ (إجازة تؤخذ عادة كل سبع سنوات (خاصة للأكاديميين))\nمثال: مشروع بحث التفرغ",
 "sabbatical leave": "إجازة تفرغ (إجازة تؤخذ عادة كل سبع سنوات (خاصة للأكاديميين))",
 "sabbatical year": "سنة تفرغ (إجازة تفرغ تستمر لمدة عام واحد)",
 "sabbatum": "السبت, يوم السبت (اليوم السابع والأخير من الأسبوع؛ يوم السبت عند اليهود)",
 "sabellian": "اللغة السابيلية (لغة أوسكو-أومبريان منقرضة من إيطاليا القديمة، باقية فقط في القليل من النقوش)",
 "sabellian language": "اللغة السابيلية (لغة أوسكو-أومبريان منقرضة من إيطاليا القديمة، باقية فقط في القليل من النقوش)",
 "saber": "سيف الفرسان, سيف مقوس (سيف قوي ذو نصل منحني وظهر سميك) / سيف ضالع, سيف منحني (مصدر للفعل سَافَ؛ سِلاح ذو حَدّ واحد طويل يعتبر من الأسْلِحَة البيضاء لأنها مصنوعة من حَدِيد أبيض حاد. كان أهم أنواع الأسلحة قبل اخْتِرَاع الأسلحة النَارِيَّة)\nمثال: القلم أقوى من السيف.",
 "saber rattling": "التلويح بالقوة, قعقعة السيوف (الاستعراض المتفاخر للقوة العسكرية (مع التهديد الضمني بإمكانية استخدامها))",
 "saber saw": "منشار ترددي, منشار صابر (منشار آلي محمول بشفرة ترددية؛ يمكن استخدامه مع مجموعة متنوعة من الشفرات حسب التطبيق ونوع القطع؛ يحتوي عموماً على لوحة تركب على السطح الذي يتم قطعه)",
 "saber-toothed": "سَيْفِيّ الأَنْيَاب (له أسنان تشبه السيوف)",
 "saber-toothed tiger": "نمر سيفي الأسنان (أي من العديد من القطط المنقرضة في العالم القديم والجديد ذات أنياب علوية طويلة تشبه السيف؛ من العصر الأوليغوسيني حتى البليستوسيني)",
 "sabertooth": "نمر سيفي الأسنان (أي من العديد من القطط المنقرضة في العالم القديم والجديد ذات أنياب علوية طويلة تشبه السيف؛ من العصر الأوليغوسيني حتى البليستوسيني)",
 "sabertoothed": "سَيْفِيّ الأَنْيَاب (له أسنان تشبه السيوف)",
 "sabha": "سَبْهَا",
 "sabian": "صَابِئِيّ",
 "sabianism": "صابئة (دين مجموعة ذكرت في القرآن كأهل كتاب إلى جانب اليهود والمسيحيين، وعادة ما يتم تحديدهم مع المندائيين أو الكسائيين)\nمثال: القرابين تحجب النظرة الخاطئة: الصابئة بالمعنى الواسع للاعتقاد في التنجيم والسحر والخرافات",
 "sabicu": "سابيكو (شجرة من جزر الهند الغربية تنتج نوعاً صلباً من الخشب البني الداكن يشبه الماهوجني في الملمس والقيمة) / خشب السابيكو (خشب السابيكو الذي يشبه الماهوجني)",
 "sabicu wood": "خشب السابيكو (خشب السابيكو الذي يشبه الماهوجني)",
 "sabin": "سابين (وحدة امتصاص صوتي تعادل الامتصاص بواسطة قدم مربع من سطح يمتص كل الصوت الساقط عليه)",
 "sabin vaccine": "لقاح سابين, لقاح شلل الأطفال الفموي (لقاح فموي (يحتوي على فيروس شلل أطفال حي ولكن ضعيف) يعطى لتوفير المناعة ضد شلل الأطفال)",
 "sabine": "سابيني (مكون من أو متعلق بـ أو مميز للسابينيين) / سابيني (فرد من شعب قديم ناطق بالأوسكانية في وسط الأبينيني شمال روما تم غزوهم ودمجهم في الدولة الرومانية)",
 "sabine pine": "صنوبر توري (صنوبر متوسط الحجم خماسي الإبر من جنوب غرب كاليفورنيا له مخاريط أسطوانية طويلة)",
 "sabinea carinalis": "خشب الكاريبي, سابينيا كاريناليس (شجرة دومينيكية صغيرة تحمل كتل من الزهور القرمزية الكبيرة قبل ظهور الأوراق الريشية الدقيقة)",
 "sable": "سَمُّور",
 "sable antelope": "ظَبْي سَمُّورِيّ (الغَزَال ذو القُرُون الحادة، سمي ظبيا لأن قِرْنه يَظْبِي أي يجرح)\nمثال: أبو ظبي هي عاصمة الإمارات العربية المتحدة.",
 "sable brush": "فرشاة السمور (فرشاة فنان مصنوعة من شعر حيوان السمور)",
 "sable coat": "معطف سمور (معطف فرو مصنوع من فراء السمور)",
 "sable's hair pencil": "فرشاة السمور (فرشاة فنان مصنوعة من شعر حيوان السمور)",
 "sabot": "قَبْقَاب (الجمل الهدّار ذو الصوت العالي؛ الكذاب الكثير الكلام والكذب والهذر)",
 "sabotage": "أَعْمَال تَخْرِيبِيَّة, تَخْرِيب (في يطلق على أي عمل حرّ يحتاج إلى رأس مال مثل الصناعة والتجارة وقطاع المال وما أشبه)\nمثال: أنا في رحلة أعمال.",
 "saboteur": "مُخَرِّب",
 "sabra": "صبرا (إسرائيلي المولد)",
 "sabre": "سيف الفرسان, سيف مقوس (سيف قوي ذو نصل منحني وظهر سميك) / سيف ضالع, سيف منحني (مصدر للفعل سَافَ؛ سِلاح ذو حَدّ واحد طويل يعتبر من الأسْلِحَة البيضاء لأنها مصنوعة من حَدِيد أبيض حاد. كان أهم أنواع الأسلحة قبل اخْتِرَاع الأسلحة النَارِيَّة)\nمثال: القلم أقوى من السيف.",
 "sabre rattling": "التلويح بالقوة, قعقعة السيوف (الاستعراض المتفاخر للقوة العسكرية (مع التهديد الضمني بإمكانية استخدامها))",
 "sabre-toothed": "سَيْفِيّ الأَنْيَاب (له أسنان تشبه السيوف)",
 "sac": "كيس (بنية تشبه الكيس في الحيوان) / سوك (فرد من شعب ألغونكي كان يعيش سابقاً في ويسكونسن في وادي نهر فوكس وعلى شواطئ الخليج الأخضر) / غِمْد, كِيس (حافظة أو غلاف، خاصة كيس اللقاح أو كبسولة الطحالب) / جيب, كيس (حيز مغلق)\nمثال: وجد عمال المناجم المحاصرون جيباً من الهواء",
 "sac fungus": "فطر زقي (أي من الفطريات الزقية المختلفة التي تتكون فيها الأبواغ في كيس أو زق)",
 "sac spider": "لَمَّاجِيَّة",
 "saccade": "نترة, هزة مفاجئة (حركة تشنجية مفاجئة) / حركة العين الرمشية, رمش (حركة سريعة ومتقطعة للعينين بين أوضاع الراحة)",
 "saccadic": "ارتعاشي, رمشي (مكون من أو متعلق بالحركة السريعة للعينين بين نقاط التثبيت)",
 "saccharase": "إنفرتاز (إنزيم يحفز التحلل المائي للسكروز إلى جلوكوز وفركتوز)",
 "saccharic acid": "حمض السكريك (حمض ثنائي الكربوكسيل أبيض يتكون من أكسدة السكر أو النشا)",
 "saccharide": "سكريات, كربوهيدرات (مكون هيكلي أساسي للخلايا الحية ومصدر للطاقة للحيوانات؛ تشمل السكريات البسيطة ذات الجزيئات الصغيرة وكذلك المواد الجزيئية الكبيرة)",
 "saccharin": "سكرين (مادة بلورية أحلى 500 مرة من السكر؛ تستخدم كمُحلي خالي من السعرات الحرارية)",
 "saccharine": "سُكَّرِيّ",
 "saccharinity": "حلاوة مفرطة (الحلاوة المفرطة للسكارين)",
 "saccharomyces cerevisiae": "خميرة البيرة, خميرة الخباز (تستخدم كخميرة في الخبز والتخمير)",
 "saccharomyces ellipsoides": "خميرة صانع النبيذ (تستخدم في صنع النبيذ)",
 "saccharose": "سكروز (كربوهيدرات معقدة توجد في العديد من النباتات وتُستخدم كعامل تحلية)",
 "saccharum bengalense": "قصب السكر البنغالي, مونجا (عشب آسيوي قاسي تستخدم سيقانه للحبال والسلال)",
 "saccharum munja": "قصب السكر البنغالي, مونجا (عشب آسيوي قاسي تستخدم سيقانه للحبال والسلال)",
 "saccharum officinarum": "قصب السكر (عشب استوائي طويل من جنوب شرق آسيا ذو سيقان مفصلية ليفية قوية؛ عصارته مصدر رئيسي للسكر)",
 "sacculate": "ذو جيوب, متكيس (مشكل مع أو يمتلك توسعات تشبه الأكياس)\nمثال: القناة الهضمية متكيسة جزئياً",
 "sacculated": "ذو جيوب, متكيس (مشكل مع أو يمتلك توسعات تشبه الأكياس)\nمثال: القناة الهضمية متكيسة جزئياً",
 "saccule": "كييس (كيس صغير أو جيب (خاصة الحجرة الأصغر للتيه الغشائي))",
 "sacculus": "كييس (كيس صغير أو جيب (خاصة الحجرة الأصغر للتيه الغشائي))",
 "sacerdotal": "كهنوتي (مرتبط بالكهنوت أو الكهنة) / كهنوتي (متعلق بالاعتقاد في السلطة الكهنوتية)\nمثال: ثياب كهنوتية",
 "sacerdotalism": "سلطة الكهنوت, كهنوتية (اعتقاد بأن الكهنة يمكنهم العمل كوسطاء بين البشر والله)",
 "saceur": "القائد الأعلى للحلفاء في أوروبا (الضابط القائد لقيادة أوروبا؛ القائد العسكري الأعلى لحلف الناتو في أوروبا)",
 "sachem": "زعيم (رئيس قبيلة أو اتحاد قبائل في أمريكا الشمالية (خاصة زعيم ألغونكوين)) / زعيم سياسي (قائد سياسي (خاصة في قاعة تاماني))",
 "sachertorte": "تَارْت زَاخَا",
 "sachet": "كيس عطر, وسادة معطرة (كيس ناعم صغير يحتوي على مسحوق معطر؛ يستخدم لتعطير الأشياء في الدرج أو الصندوق)",
 "sachs disease": "داء تاي ساكس, مرض تاي ساكس (اضطراب وراثي في استقلاب الدهون يحدث بشكل متكرر لدى الأفراد من أصل يهودي في أوروبا الشرقية؛ يؤدي تراكم الدهون في الأنسجة العصبية إلى الوفاة في مرحلة…)",
 "sack": "كِيس",
 "sack coat": "جاكيت بدلة, سترة بدلة (معطف رجالي يصل للورك بظهر مستقيم؛ سترة البدلة)",
 "sack race": "سباق الأكياس (سباق ترفيهي يقفز فيه المتنافسون للأمام وأقدامهم مقيدة داخل كيس)",
 "sackbut": "ساكبوت (آلة موسيقية من القرون الوسطى تشبه الترومبون)",
 "sackcloth": "قماش الخيش, مسح (قماش خشن يشبه الخيش) / خيش, مسوح (رداء مصنوع من الخيش الخشن؛ كان يرتدى سابقاً كدلالة على الندم)",
 "sackcloth and ashes": "ندم شديد (إظهار للندم الشديد أو التوبة أو الحزن)",
 "sacked": "مَنْهُوب, مُخَرَّب (تَعَرَّضَ لِلنَّهْبِ وَالتَّدْمِيرِ بِالقُوَّةِ وَالعُنْف)",
 "sackful": "شوال, ملء كيس (الكمية المحتواة في كيس)",
 "sacking": "إقالة, تسريح (إنهاء توظيف شخص ما (وتركه حراً للمغادرة)) / خيش, قماش الأكياس (قماش خشن يستخدم للأكياس أو الشوالات)",
 "saclant": "القائد الأعلى للحلفاء في الأطلسي (الضابط القائد لقيادة الأطلسي؛ جنرال من الجيش الأمريكي يرشحه الرئيس الأمريكي ويوافق عليه مجلس شمال الأطلسي)",
 "saclike": "جِرَابِيُّ الشَّكْل, كِيسِيّ (على شكل جراب أو كيس)",
 "sacque": "سترة فضفاضة (سترة نسائية فضفاضة بالكامل تصل للورك)",
 "sacral": "شَعَائِرِيّ, طَقْسِيّ (متعلّق بالطقوس والشعائر المقدّسة) / عجزي (من أو متعلق بـ أو بالقرب من العجز (العظم العجزي))",
 "sacral nerve": "عصب عجزي (أي من خمسة أزواج من الأعصاب الشوكية الخارجة من المنطقة العجزية للحبل الشوكي)",
 "sacral plexus": "ضفيرة عجزية (ضفيرة عصبية تتكون من الأعصاب القطنية الرابعة والخامسة والأعصاب العجزية الأولى والثانية والثالثة؛ تغذي منطقة الحوض والأطراف السفلية)",
 "sacral vein": "وريد عجزي (وريد المنطقة العجزية)",
 "sacral vertebra": "فقرة عجزية (واحدة من 5 فقرات في العمود الفقري البشري تلتحم عند البلوغ لتشكل العجز)",
 "sacrament": "سِرّ (شَعَرَ بِالسُّرُورِ)\nمثال: السر سيبقى سرا.",
 "sacrament of the eucharist": "الإفخارستيا, القربان المقدس (سر مسيحي يحيي ذكرى العشاء الأخير بتكريس الخبز والنبيذ)",
 "sacramental": "سرائري, طقسي مقدس (من أو يتعلق بالأسرار المقدسة الكنسية أو يتضمنها)",
 "sacramental manduction": "تناول, قربان مقدس (فعل المشاركة في الاحتفال بالقربان المقدس (الإفخارستيا))\nمثال: تناول الحاكم القربان المقدس مع بقية الرعية",
 "sacramental oil": "زيت مقدس, ميرون (مرهم مكرس يتكون من خليط من الزيت والبلسم)",
 "sacramental wine": "نبيذ القربان, نبيذ مقدس (يستخدم في خدمة المناولة (القربان المقدس))",
 "sacramento": "سَكْرَامِنْتُو, ساكرامنتو",
 "sacramento sturgeon": "حفش أبيض, حفش المحيط الهادئ (سمكة غذائية ورياضية في المياه البحرية والعذبة للساحل الشمالي الغربي لأمريكا الشمالية)",
 "sacred": "مُقَدَّس",
 "sacred college": "مجمع الكرادلة ((الكنيسة الرومانية الكاثوليكية) هيئة جميع كرادلة الكنيسة؛ تنتخب وتنصح البابا)",
 "sacred college of cardinals": "مجمع الكرادلة ((الكنيسة الرومانية الكاثوليكية) هيئة جميع كرادلة الكنيسة؛ تنتخب وتنصح البابا)",
 "sacred cow": "بقرة مقدسة (شخص يُعتبر بشكل غير معقول محصناً ضد النقد)",
 "sacred fig": "بيبال, تين مقدس (شجرة تين من الهند تشتهر بحجمها الكبير وطول عمرها؛ تفتقر إلى الجذور الداعمة للبانيان؛ تعتبر مقدسة لدى البوذيين)",
 "sacred ibis": "أبو منجل المقدس (أبو منجل أفريقي كان يقدسه المصريون القدماء)",
 "sacred lotus": "لوتس, لوتس مقدس (موطنه شرق آسيا؛ يزرع على نطاق واسع لأزهاره الكبيرة الوردية أو البيضاء)",
 "sacred scripture": "أسفار مقدسة, كتاب مقدس (أي كتابة تعتبر مقدسة من قبل جماعة دينية)",
 "sacred text": "كتابات دينية, نص مقدس (كتابة تحظى بالتبجيل وتستخدم في عبادة إله)",
 "sacred war": "حَرْب مُقَدَّسَة (حَرَبَ (حربه) بالحربة حربا: طعنه بها؛ حَرَبَ (ه) حربا: سلبه جميع ما يملك)\nمثال: بوتين مجرم حرب.",
 "sacred writing": "كتابات دينية, نص مقدس (كتابة تحظى بالتبجيل وتستخدم في عبادة إله)",
 "sacredly": "دينياً (بواسطة الدين)\nمثال: فن مستوحى دينياً",
 "sacredness": "قُدْسِيَّة (صفة كون الشيء مقدساً)",
 "sacrifice": "تَضْحِيَة, قُرْبَان / ضَحَّى",
 "sacrifice fly": "تضحية بكرة طائرة (تضحية تتم بضرب كرة طائرة طويلة)",
 "sacrifice operation": "عملية استشهادية, مهمة انتحارية (قتل أو إصابة الآخرين مع إهلاك النفس؛ يتم عادة بقنبلة)",
 "sacrificeable": "قَابِل لِلتَّضْحِيَة (يمكن التضحية به عمداً لتحقيق هدف)",
 "sacrificer": "مقرب الأضاحي (شخص متدين يقدم تضحية)",
 "sacrificial": "تَضْحِيَة, أُضْحِيَّة / مُضَحٍّ",
 "sacrilege": "تَدْنِيس, تَرْجِيس",
 "sacrilegious": "كَافِر, مُجَدِّف (شديد الاستخفاف بما يُعتبَر مقدّساً)",
 "sacrilegiously": "بانتهاك للحرمات, بتجديف (بطريقة تنتهك المقدسات)",
 "sacrilegiousness": "انْتِهَاك الحُرُمَات (التجديف بحكم ارتكاب انتهاك للمقدسات)",
 "sacristan": "حارس المقدسات, قيم الكنيسة (مسؤول الكنيسة المسؤول عن الأشياء المقدسة)",
 "sacristy": "سقيفة الكنيسة, غرفة الملابس الكنسية (غرفة في كنيسة تُحفظ فيها الأواني المقدسة والملابس الكهنوتية أو تُعقد فيها الاجتماعات)",
 "sacrosanct": "حُرْمِيّ, مَصُون (يجب أن يُصان ولا يُنتَهَك؛ ذو حرمة لا تُمَسّ)",
 "sacrum": "عَجُزِ",
 "sad": "حَزِين, زعلان / مُحْزِنٌ",
 "sad sack": "أخرق, فاشل (شخص يرتكب أخطاء بسبب عدم الكفاءة)",
 "sad-faced": "حَزِين الوَجْه (ذو وجه بتعبير حزين)",
 "saddam": "صَدَّام حُسَيْن",
 "saddam's martyrs": "فدائيو صدام (وحدة شبه عسكرية مخيفة شكلها صدام حسين عام 1995 من الجنود الشباب لخدمته ضد المعارضين المحليين)",
 "sadden": "أَحْزَنَ ((أَحْزَنَ) الْمَكَان: حزن وَيُقَال: أَحْزَن بهم الْمنزل: نبا بهم؛ (أَحْزَنَ) فُلَان: صَار فِي الْحزن)\nمثال: أحزن كثيرا على سامي.",
 "saddhu": "سادهو ((الهندوسية) رجل مقدس زاهد)",
 "saddle": "سَرْج, سرج ((سَرَجَ) فلان سرجا: كذب. ويقال سرج فلان الكذب؛ (سَرَجَ)ت المرأة شعرها: ضفرته)",
 "saddle blanket": "حلس, دثار السرج (من معدات الإسطبل يتكون من بطانية توضع تحت السرج)",
 "saddle block anaesthesia": "تخدير سرجي (تخدير أجزاء جسم المريض التي تلامس السرج إذا كان المريض جالساً فيه، عن طريق حقن مخدر موضعي في الحبل الشوكي)",
 "saddle block anesthesia": "تخدير سرجي (تخدير أجزاء جسم المريض التي تلامس السرج إذا كان المريض جالساً فيه، عن طريق حقن مخدر موضعي في الحبل الشوكي)",
 "saddle feather": "رِيشُ الظَّهْر (ريشة طويلة وضيقة على ظهر الدجاج المستأنس)",
 "saddle hackle": "رِيشُ الظَّهْر (ريشة طويلة وضيقة على ظهر الدجاج المستأنس)",
 "saddle horn": "قرن السرج (قربوس عالٍ لسرج غربي (عادة معدني مغطى بالجلد))",
 "saddle horse": "حصان ركوب (حصان خفيف الوزن يُربى للركوب فقط)",
 "saddle of lamb": "سرج الضأن (العمود الفقري وكلا الخاصرتين لحمل)",
 "saddle oxford": "حذاء السرج (حذاء أكسفورد بقطعة تشبه السرج ذات لون مغاير)",
 "saddle oyster": "محار السرج (ذوات صدفتين رقيقة الصدفة يكون صمامها الأيمن مسنناً بعمق)",
 "saddle roof": "سقف جملوني, سقف سنامي (سقف مزدوج الميل ذو قمة وجملون عند كل طرف)",
 "saddle seat": "مقعد سرجي (مقعد كرسي مقعر قليلاً وأحياناً يكون له حافة سميكة في الوسط)\nمثال: المقعد السرجي ناسب أردافه بشكل جيد",
 "saddle shoe": "حذاء السرج (حذاء أكسفورد بقطعة تشبه السرج ذات لون مغاير)",
 "saddle soap": "صابون السروج (صابون خفيف لتنظيف وتكييف الجلود)",
 "saddle sore": "قرحة السرج (قرحة تصيب راكب الخيل بسبب احتكاك السرج) / قرحة السرج (قرحة مفتوحة على ظهر الحصان ناتجة عن سرج غير مناسب أو معدل بشكل سيء)",
 "saddle stitch": "غرزة السرج (غرزة سرفلة أو سراجة زخرفية، خاصة بلون متباين)",
 "saddle-shaped": "سَرْجِيّ الشَّكْل (على شكل سرج الحصان)",
 "saddle-sore": "مُتَأَلِّمٌ مِنَ السَّرْج ((لِلْفَارِس) مُتَأَلِّمٌ بَعْدَ رُكُوبِ الخَيْل)",
 "saddleback": "سقف جملوني, سقف سنامي (سقف مزدوج الميل ذو قمة وجملون عند كل طرف) / سرج, ظهر السرج (ممر أو حيد ينحدر بلطف بين قمتين (على شكل سرج))",
 "saddleback roof": "سقف جملوني, سقف سنامي (سقف مزدوج الميل ذو قمة وجملون عند كل طرف)",
 "saddlebag": "حقيبة سرج, خرج (حقيبة كبيرة (أو زوج من الحقائب) تعلق فوق السرج)",
 "saddlebill": "لقلق سرج المنقار (لقلق كبير أسود وأبيض من أفريقيا الاستوائية؛ منقاره الأحمر له شريط أسود حول المنتصف)",
 "saddlebow": "قربوس السرج, مقدم السرج (مقبض يد يتشكل من الجزء الأمامي المرتفع للسرج)",
 "saddlecloth": "حلس, دثار السرج (من معدات الإسطبل يتكون من بطانية توضع تحت السرج)",
 "saddled": "مُسْرَج (عليه سرج أو يمتطي حيواناً مسرجاً) / مُحَمَّلٌ قَسْرًا, مُكَبَّل (خاضع لعبء مفروض عليه)\nمثال: مسرج ومهمز ومستعد للركوب",
 "saddled seabream": "حُنْجُولَة",
 "saddled-shaped false morel": "موريل كاذب سرجي الشكل (فطر سام؛ الجزء الخصب على شكل سرج وأصفر باهت إلى بني ومستوٍ نسبياً)",
 "saddler": "سَرَّاج",
 "saddlery": "ورشة سروج (ورشة يعمل فيها السراج) / سروج, عدة الخيل (تجهيزات للحصان)",
 "sadducean": "صدوقي (مكون من أو متعلق بالصدوقيين)",
 "sadducee": "صَدُّوقِيّ",
 "sadhe": "تسادي (الحرف الثامن عشر من الأبجدية العبرية)",
 "sadhu": "سادهو ((الهندوسية) رجل مقدس زاهد)",
 "sadism": "سادية",
 "sadist": "سادي (شخص يحصل على المتعة من إلحاق الألم بالآخرين)",
