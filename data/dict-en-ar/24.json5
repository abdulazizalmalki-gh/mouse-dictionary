 "scorper": "إزميل مقعر, مغرفة النقش (أداة نقش تستخدم لغرف مناطق واسعة عند نقش الخشب أو المعدن)",
 "scorpio": "بُرْج اَلْعَقْرَب, اَلْعَقْرَب (ظهر وارتفع)\nمثال: وصل كارل إلى برج آخر.",
 "scorpioid cyme": "نورة عقربية (سيمة تتناوب فيها الزهور أو الفروع في صفوف متقابلة)",
 "scorpion": "عَقْرَب, عَقْرَبَة",
 "scorpion fish": "سمكة العقرب, عقرب البحر (أسماك بحرية لها جسم مستدق ورأس مدرع وأشواك سامة)",
 "scorpion fly": "ذبابة العقرب (أي من الحشرات طويلة الأجنحة المتنوعة من فصيلة الشمريات في نصف الكرة الشمالي ولها منقار طويل وقرون استشعار طويلة؛ للذكور ذيل يشبه ذيل العقرب إلا أنه…)",
 "scorpion shell": "صدفة العقرب (أي من الحلزونات البحرية الاستوائية العديدة التي يكون للشفة الخارجية لفتحتها سلسلة من الأشواك المنحنية الطويلة عند البلوغ)",
 "scorpion weed": "عشبة العقرب, فاسيليا (أي نبات من جنس فاسيليا)",
 "scorpionfish": "سمكة العقرب, عقرب البحر (أسماك بحرية لها جسم مستدق ورأس مدرع وأشواك سامة)",
 "scorpionfly": "شَوَّالَة",
 "scorpionweed": "عشبة العقرب, فاسيليا (أي نبات من جنس فاسيليا)",
 "scorpius": "بُرْج اَلْعَقْرَب (ظهر وارتفع) / اَلْعَقْرَب\nمثال: وصل كارل إلى برج آخر.",
 "scorzonera": "سلسفي أسود (سلسفي أسود طويل) / تيس الجبل الإسباني, ساسفي أسود (عشب معمر من جنوب أوروبا له أوراق كاملة ضيقة ورؤوس زهرية صفراء منعزلة وجذور طويلة سوداء صالحة للأكل تشبه الجزر)",
 "scorzonera hispanica": "تيس الجبل الإسباني, ساسفي أسود (عشب معمر من جنوب أوروبا له أوراق كاملة ضيقة ورؤوس زهرية صفراء منعزلة وجذور طويلة سوداء صالحة للأكل تشبه الجزر)",
 "scot": "اسكتلندي (مواطن أو ساكن في اسكتلندا)",
 "scot and lot": "الأعباء كاملة, الضرائب والالتزامات (الالتزامات بجميع أنواعها مأخوذة ككل)",
 "scot free": "دُونَ عِقَاب (خالٍ من الأذى أو العقوبة)\nمثال: ذهب دون عقاب",
 "scot-free": "دُونَ عِقَاب (خالٍ من الأذى أو العقوبة)\nمثال: ذهب دون عقاب",
 "scotch": "إسكتلندية",
 "scotch and soda": "سكوتش وصودا (هايبول مع ويسكي الشعير الاسكتلندي والصودا)",
 "scotch asphodel": "بروق اسكتلندي, توفيلديا (بروق كاذب له سنابل من الزهور البيضاء؛ من المناطق الجبلية في أوروبا)",
 "scotch broom": "وزال اسكتلندي, وزال شائع (وزال متساقط الأوراق قائم منتشر موطنه غرب أوروبا؛ يزرع على نطاق واسع لزهوره الصفراء الغنية)",
 "scotch broth": "حساء اسكتلندي, مرق سكوتش (حساء كثيف مصنوع من لحم البقر أو الضأن مع الخضروات والشعير المقشور)",
 "scotch egg": "بيض سكوتش (بيضة مسلوقة جيداً مغلفة بلحم السجق ثم بالبقسماط ومقلية بعمق)",
 "scotch fir": "صنوبر اسكتلندي, صنوبر بري (صنوبر متوسط الكبر ثنائي الإبر من شمال أوروبا وآسيا له لحاء أحمر بني متقشر)",
 "scotch gale": "آس المستنقعات, شمعية عاصفة (شجيرة مستنقعات من المنطقة المعتدلة الشمالية ذات أوراق عطرية مرة المذاق)",
 "scotch kiss": "قُبَل سكوتش (حلوى باترسكوتش صغيرة)",
 "scotch laburnum": "سلسلة ذهبية ألبية, لابورنوم اسكتلندي (شجيرة زينة أو شجرة من جنس لابورنوم)",
 "scotch malt whiskey": "سكوتش, ويسكي اسكتلندي (ويسكي مقطر في اسكتلندا؛ خاصة الويسكي المصنوع من الشعير المملت في وعاء تقطير)",
 "scotch malt whisky": "سكوتش, ويسكي اسكتلندي (ويسكي مقطر في اسكتلندا؛ خاصة الويسكي المصنوع من الشعير المملت في وعاء تقطير)",
 "scotch marigold": "آذريون, أقحوان الذهب (القطيفة السنوية الأوروبية الشائعة)",
 "scotch pancake": "بان كيك اسكتلندي, سكون القطرة (سكون يُصنع بصب ملعقة من العجين السائل على صاج)",
 "scotch pine": "صنوبر اسكتلندي, صنوبر بري (صنوبر متوسط الكبر ثنائي الإبر من شمال أوروبا وآسيا له لحاء أحمر بني متقشر)",
 "scotch tape": "شريط سيلوفان, شريط شفاف (شريط لاصق شفاف أو شبه شفاف (الأسماء التجارية سكوتش تيب وسيلوتيب) يستخدم للختم أو التثبيت أو الإصلاح)",
 "scotch terrier": "تيريير اسكتلندي, سكوتي (سلالة اسكتلندية قديمة من التيريير الصغير طويل الشعر وعادة ما يكون أسود اللون مع ذيل وآذان منتصبة)",
 "scotch thistle": "شوك اسكتلندي, شوك صوفي (شوك أوراسي ثنائي الحول أبيض مشعر ذو أزهار أرجوانية شاحبة؛ متوطن في أمريكا الشمالية)",
 "scotch whiskey": "سكوتش, ويسكي اسكتلندي (ويسكي مقطر في اسكتلندا؛ خاصة الويسكي المصنوع من الشعير المملت في وعاء تقطير)",
 "scotch whisky": "سكوتش, ويسكي اسكتلندي (ويسكي مقطر في اسكتلندا؛ خاصة الويسكي المصنوع من الشعير المملت في وعاء تقطير)",
 "scotch woodcock": "سكوتش وودكوك (بيض مخفوق كريمي على توست مدهون بمعجون الأنشوجة)",
 "scotchman": "اسكتلندي (مواطن أو ساكن ذكر في اسكتلندا)",
 "scotchwoman": "اسكتلندية, امرأة اسكتلندية (أنثى مواطنة أو ساكنة في اسكتلندا)",
