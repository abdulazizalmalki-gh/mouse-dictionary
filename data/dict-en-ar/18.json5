 "myocastor coypus": "كيب, نوتريا (قارض مائي من أمريكا الجنوبية يشبه قندساً صغيراً؛ يُربى من أجل فرائه)",
 "myoclonus": "رمع عضلي (تشنج رمعي لعضلة أو مجموعة عضلية)",
 "myoclonus epilepsy": "داء لافورا, صرع رمعي عضلي (صرع يتميز بارتعاش مجموعات عضلية وتدهور عقلي تدريجي ومنشأ وراثي)",
 "myodynia": "ألم العضلات (ألم في عضلة أو مجموعة من العضلات)",
 "myofibril": "لييفة عضلية (واحدة من العديد من الخيوط المتقلصة التي تشكل الألياف العضلية المخططة)",
 "myofibrilla": "لييفة عضلية (واحدة من العديد من الخيوط المتقلصة التي تشكل الألياف العضلية المخططة)",
 "myoglobin": "ميوغلوبين (بروتين هيمي يستقبل الأكسجين من الهيموغلوبين ويخزنه في الأنسجة حتى الحاجة إليه)",
 "myoglobinuria": "بيلة ميوغلوبينية (وجود الميوغلوبين في البول)",
 "myogram": "مخطط العضلات (تسجيل بياني لنشاط العضلات)",
 "myoid": "عضلي الشكل (يشبه العضلة)",
 "myology": "علم العضلات (فرع علم وظائف الأعضاء الذي يدرس العضلات)",
 "myoma": "ورم عضلي (ورم حميد يتكون من أنسجة عضلية)",
 "myometritis": "التهاب عضل الرحم (التهاب عضل الرحم)",
 "myometrium": "عضل الرحم (العضلة الملساء التي تشكل جدار الرحم)",
 "myonecrosis": "نخر عضلي (موت موضعي لألياف الخلايا العضلية)",
 "myoneural junction": "مشبك عصبي عضلي (الوصلة بين الليف العصبي والعضلة التي يغذيها)",
 "myopathic": "اعتلالي عضلي (مكون من أو متعلق بأي مرض يصيب العضلات ولا ينتج عن خلل في الأعصاب)",
 "myopathy": "اعتلال عضلي (أي حالة مرضية تصيب العضلات ولا تعزى إلى خلل وظيفي عصبي)",
 "myope": "قصير النظر (شخص يعاني من قصر النظر)",
 "myopia": "حسر, قصر النظر ((طب العيون) خلل في البصر ناتج عن خلل في القدرة الانكسارية للعين؛ تظهر الأشياء البعيدة غير واضحة)",
 "myopic": "قَصِيرُ النَّظَر (يفتقر إلى بُعْد النظر أو الشمولية) / قصير النظر, مصاب بقصر النظر (غير قادر على رؤية الأشياء البعيدة بوضوح)",
 "myosarcoma": "ساركومة عضلية (ساركومة الأنسجة العضلية)",
 "myosin": "ميوسين (البروتين الأكثر شيوعاً في العضلات؛ غلوبولين يتحد مع الأكتين لتكوين الأكتوميوسين)",
 "myosis": "تقبض الحدقة, منعكس الضوء (انكماش انعكاسي للعضلة العاصرة للقزحية استجابة لضوء ساطع (أو أدوية معينة) مما يسبب صغر حجم الحدقة) / ألم جنبي وبائي, ألم عضلي وبائي (مرض معد حاد يحدث في شكل وبائي ويتميز بنوبات ألم (عادة في الصدر))",
 "myositis": "التهاب العضلات (التهاب الأنسجة العضلية)",
 "myositis trichinosa": "ترايكينوسس, داء الشعرينات (الإصابة بيرقات الترايكينة التي تنتقل عن طريق تناول اللحوم غير المطهية جيداً (خاصة لحم الخنزير)؛ تهاجر اليرقات من الجهاز الهضمي إلى العضلات حيث تتكيس)",
 "myosotis scorpiodes": "أذن الفأر, لا تنسني (عشب معمر صغير له أزهار زرقاء زاهية أو بيضاء)",
 "myosotis sylvatica": "لا تنسني الحدائقية (عشب صغير ثنائي الحول إلى معمر في أوروبا وشمال أفريقيا وغرب آسيا له أزهار زرقاء أو أرجوانية أو بيضاء)",
 "myotactic reflex": "منعكس التمدد, منعكس عضلي (انكماش انعكاسي لعضلة عند سحب وتر متصل بها؛ مهم في الحفاظ على وضعية الانتصاب)",
 "myotic": "مقبض للحدقة (مكون من أو متعلق بـ أو مسبب لتضيق حدقة العين) / دواء مقبض للحدقة, مقبض للحدقة (دواء يسبب تقبض الحدقة (تضييق حدقة العين))\nمثال: دواء مقبض للحدقة",
 "myotic drug": "دواء مقبض للحدقة, مقبض للحدقة (دواء يسبب تقبض الحدقة (تضييق حدقة العين))",
 "myotis leucifugus": "خفاش بني صغير (الخفاش الصغير الشائع في أمريكا الشمالية؛ واسع الانتشار)",
 "myotis velifer": "خفاش الكهف (خفاش صغير من جنوب غرب الولايات المتحدة يعيش في الكهوف وما إلى ذلك)",
 "myotomy": "بضع العضل (شق أو تقسيم جراحي لعضلة)",
 "myotonia": "تأتر, تشنج عضلي (تقلصات عضلية طويلة بشكل غير طبيعي؛ استرخاء بطيء للعضلة بعد التقلص)",
 "myotonia atrophica": "حثل عضلي توتري (شكل حاد من الحثل العضلي يتميز بضعف عام وهزال عضلي يؤثر على الوجه والقدمين واليدين والرقبة؛ وصعوبة في الكلام وصعوبة في اليدين تمتد إلى الذراعين…)",
 "myotonia congenita": "تأتر خلقي, مرض تومسن (شكل خفيف ونادر وخلقي من التأتر يتميز بتصلب العضلات)",
 "myotonic": "توتري عضلي (من أو يتعلق بالتوتر العضلي أو ناتج عنه)",
 "myotonic dystrophy": "حثل عضلي توتري (شكل حاد من الحثل العضلي يتميز بضعف عام وهزال عضلي يؤثر على الوجه والقدمين واليدين والرقبة؛ وصعوبة في الكلام وصعوبة في اليدين تمتد إلى الذراعين…)",
 "myotonic muscular dystrophy": "حثل عضلي توتري (شكل حاد من الحثل العضلي يتميز بضعف عام وهزال عضلي يؤثر على الوجه والقدمين واليدين والرقبة؛ وصعوبة في الكلام وصعوبة في اليدين تمتد إلى الذراعين…)",
 "myrciaria cauliflora": "جابوتيكابا, عنب برازيلي (شجرة استوائية صغيرة دائمة الخضرة موطنها البرازيل وجزر الهند الغربية ولكن أدخلت إلى جنوب الولايات المتحدة؛ تزرع في البرازيل لفاكهتها الأرجوانية…)",
 "myriad": "لَا يُحْصَى, لَا يُعَدّ (أَكْثَر مِنْ أَنْ يُحْصَى أَوْ يُعَدّ) / عَشَرَة آلَاف (العدد الأصلي الذي هو حاصل ضرب عشرة في ألف) / عدد لا يحصى, كثرة كاثرة (عدد كبير غير محدد)\nمثال: واجه عدداً لا يحصى من التفاصيل",
 "myriagram": "ميرياغرام (واحد من عشرة آلاف من القنطار المتري)",
 "myriameter": "ميريامتر (وحدة مترية للطول تساوي 10,000 متر)",
 "myriametre": "ميريامتر (وحدة مترية للطول تساوي 10,000 متر)",
 "myriapod": "كثيرات الأرجل (مصطلح عام لأي مفصلي بري له جسم ممدود يتكون من العديد من الأجزاء المتشابهة: مثل مئويات الأرجل وألفيات الأرجل)",
 "myrica cerifera": "آس الشمع, شجرة الشمع (شجرة شجيرية عطرية دائمة الخضرة في جنوب شرق الولايات المتحدة لها توت صلب صغير مغطى بكثافة بشمع أبيض يستخدم للشموع)",
 "myrica gale": "آس المستنقعات, شمعية عاصفة (شجيرة مستنقعات من المنطقة المعتدلة الشمالية ذات أوراق عطرية مرة المذاق)",
 "myrica pensylvanica": "توت الشمع, شمعية (شجيرة عطرية نفضية من شرق أمريكا الشمالية بتوت مغطى بالشمع الرمادي الأخضر)",
 "myricaria germanica": "أثل ألماني, أثل كاذب (شجيرة أوراسية تشبه الأثل)",
 "myringa": "طبلة الأذن, غشاء الطبل (الغشاء الموجود في الأذن الذي يهتز للصوت)",
 "myringectomy": "استئصال طبلة الأذن (إزالة جراحية لطبلة الأذن)",
 "myringoplasty": "رأب طبلة الأذن (إصلاح جراحي لطبلة الأذن المثقوبة باستخدام ترقيع نسيجي)",
 "myringotomy": "بضع طبلة الأذن (شق جراحي في طبلة الأذن (لتخفيف الضغط أو إخراج الصديد من الأذن الوسطى))",
 "myristic acid": "حمض الميريستيك (حمض دهني مشبع يوجد طبيعياً في الدهون الحيوانية والنباتية)",
 "myristica fragrans": "جوزة الطيب, شجرة جوزة الطيب (شجرة من شرق الهند تزرع على نطاق واسع في المناطق الاستوائية لبذورها العطرية؛ مصدر لنوعين من التوابل: جوزة الطيب والصولجان)",
 "myrmecobius fasciatus": "آكل النمل المخطط, نمبات (جرابي أسترالي صغير ذو خطم طويل ومخالب قوية للتغذى على النمل الأبيض؛ مهدد بالانقراض)",
 "myrmecophaga jubata": "آكل النمل العملاق (آكل نمل كبير أشعث الشعر وعديم الأسنان ذو لسان طويل ومخالب قوية؛ من أمريكا الجنوبية)",
 "myrmecophagous": "آكِل لِلنَّمْل (يتغذى على النمل)",
 "myrmecophile": "أليف النمل (كائن مثل حشرة تشارك عادة عش نوع من النمل)",
 "myrmecophilous": "مُحِبٌّ لِلنَّمْل (يَعِيشُ فِي تَكَافُلٍ مَعَ النَّمْل)",
 "myrmecophyte": "نبات أليف النمل, نبات النمل (نبات يوفر مأوى أو غذاء للنمل الذي يعيش معه في علاقة تكافلية)",
 "myrmecophytic": "نملي نباتي (من أو يتعلق بالنباتات التي يعيش فيها النمل)",
 "myrmidon": "تابِع أَعْمَى, جُنْدِيّ مُرْتَزَق (تابع ينفذ الأوامر دون تساؤل)",
 "myrobalan": "برقوق كرزي, ميروبالان (شجرة آسيوية صغيرة تحمل فاكهة حمراء أو صفراء صالحة للأكل)",
 "myrobalan plum": "برقوق كرزي, ميروبالان (شجرة آسيوية صغيرة تحمل فاكهة حمراء أو صفراء صالحة للأكل)",
 "myroxylon balsamum": "شجرة بلسم تولو, ميروكسيلون بلسمي (شجرة أمريكية استوائية متوسطة الحجم تنتج بلسم تولو وخشباً صلباً عطرياً يستخدم للأثاث عالي الجودة والخزائن)",
 "myroxylon balsamum pereirae": "شجرة بلسم بيرو (شجرة من أمريكا الجنوبية والوسطى تنتج بلسماً عطرياً)",
 "myroxylon pereirae": "شجرة بلسم بيرو (شجرة من أمريكا الجنوبية والوسطى تنتج بلسماً عطرياً)",
 "myroxylon toluiferum": "شجرة بلسم تولو, ميروكسيلون بلسمي (شجرة أمريكية استوائية متوسطة الحجم تنتج بلسم تولو وخشباً صلباً عطرياً يستخدم للأثاث عالي الجودة والخزائن)",
 "myrrh": "مُرّ (فَاتَ ومَضَى؛ الحدثُ أو الأمرُ: حدث وانتهى)\nمثال: مر زيري بجانبي.",
 "myrrh tree": "شجرة المر, كوميفورا ميرا (شجرة موطنها شرق أفريقيا وآسيا تنتج مادة المر)",
 "myrrhis odorata": "سيسلي حلوة, مرّيس (عشب أوروبي بأوراق سرخسية ناعمة وأزهار بيضاء)",
 "myrtaceous tree": "شجرة آسية (أشجار وشجيرات)",
 "myrtillocactus geometrizans": "جارامبولا, صبار جارامبولا (صبار شجري من غرب المكسيك يحمل ثمرة صغيرة مستطيلة صالحة للأكل تشبه التوت)",
 "myrtle": "آس, رَيْحَان (نوع نباتي من جنس الآس من الفَصِيلَة الآسيّة. وهو شجر دائم الخُضْرَة، بيضيّ الورق، أبيض الزَّهْر أو ورديُّه، يُزرع للتزيين ولرائحته العِطْريّة…؛ ورقة من أوراق اللعب ذات نقطة أو علامة واحدة)\nمثال: لدي الآس الكوبا.",
 "myrtle beech": "زان الآس (شجرة كبيرة دائمة الخضرة من تسمانيا)",
 "myrtle bird": "هازجة الآس (تشبه هازجة أودوبون)",
 "myrtle flag": "عود الوج, قصب الذريرة (نبات مستنقعات معمر ذو أوراق تشبه السيف وجذور عطرية)",
 "myrtle oak": "سنديان آسي (شجيرة أو شجرة صغيرة دائمة الخضرة موطنها جنوب شرق الولايات المتحدة؛ غالباً ما تشكل غابات كثيفة لا يمكن اختراقها في المناطق الساحلية الرملية)",
 "myrtle spurge": "فربيون الكبر, فربيون منشاري (فربيون سام من العالم القديم؛ دخيل في أمريكا؛ تنتج بذوره زيتاً مسهلاً)",
 "myrtle warbler": "هازجة الآس (تشبه هازجة أودوبون)",
 "myrtus communis": "آس شائع, ريحان (مغاربي) (شجيرة أوروبية ذات زهور بيضاء أو وردية يتبعها توت أسود)",
 "myself": "نَفْسِي",
 "mysoandry": "كراهية الرجال (بغض الرجال أو الصبيان)",
 "mysoline": "بريميدون, ميزولين (مضاد للاختلاج (الاسم التجاري ميزولين) يستخدم لعلاج نوبات الصرع الكبير والرعاش الأساسي)",
 "mysophilia": "انجذاب للقذارة (انجذاب غير طبيعي للقذارة)",
 "mysophobia": "رهاب القذارة, وسواس النظافة (خوف مرضي من الأوساخ أو التلوث)",
 "mysophobic": "رُهَابِيّ الأَوْسَاخ (يعاني من رهاب الأوساخ؛ خائف بشكل غير طبيعي من القذارة أو التلوث)",
 "mysore thorn": "شوك ميسور (شجيرة شائكة منتشرة من آسيا الاستوائية تحمل عناقيد منتصبة كبيرة من الزهور الصفراء ذات العلامات الحمراء)",
 "mysterious": "غَامِض",
 "mysteriously": "بِإِبْهَام, بِشَكْل مُلْغِز (بطريقة غامضة)\nمثال: 'سنلتقي مرة أخرى'، قال بغموض",
 "mystery": "سِرّ (شَعَرَ بِالسُّرُورِ) / غُمُوض\nمثال: السر سيبقى سرا.",
 "mystery novel": "رواية بوليسية, رواية غموض (رواية يُتحدى فيها القارئ لحل لغز قبل أن يشرحه المحقق في النهاية)",
 "mystery play": "مسرحية الأسرار (مسرحية من القرون الوسطى تمثل حلقات من حياة المسيح)",
 "mystery story": "قصة غموض, لغز جنائي (قصة تدور حول جريمة (عادة جريمة قتل) تُقدم كرواية أو مسرحية أو فيلم)",
 "mystic": "صُوفِيّ, غَامِض (له مدلول لا تُدرِكه الحواسّ ولا يتّضح للعقل؛ يتجاوز الفهم العادي) / صوفي, عرفاني (متعلق بالتصوف أو مميز له) / صوفي, غامض (متعلق بالتصوف أو يشبهه) / روحاني, صوفي (شخص يؤمن بوجود حقائق تتجاوز الفهم البشري)\nمثال: دين صوفي",
 "mystical": "صُوفِيّ, غَامِض (له مدلول لا تُدرِكه الحواسّ ولا يتّضح للعقل؛ يتجاوز الفهم العادي) / صوفي, عرفاني (متعلق بالتصوف أو مميز له) / صوفي, غامض (متعلق بالتصوف أو يشبهه)\nمثال: دين صوفي",
 "mystically": "باطنياً, صوفياً (بطريقة صوفية)\nمثال: ينشد صوفياً",
 "mysticism": "تصوف, غموضية (فكر غامض أو غير عقلاني) / تصوف, عرفان (دين يقوم على الاتحاد الروحي الغامض مع حقيقة مطلقة)",
 "mystification": "تضليل, تعمية (نشاط حجب فهم الناس وتركهم في حيرة أو ارتباك) / أحجية, شيء مُحيّر (شيء مصمم لإثارة الحيرة أو الإرباك) / ارتباك, حيرة (ارتباك ناتج عن الفشل في الفهم)",
 "mystified": "شَدِيد الحَيْرَة, مُسْتَغْلَق عَلَيْه (في حيرة تامّة واختلاط شديد)",
 "mystifier": "أُحْجِيَّة, لُغْز (مشكلة محيرة بشكل خاص يقال أن لها حلاً صحيحاً)\nمثال: كان يحب حل ألغاز الشطرنج",
 "mystifying": "سِرِّيّ, غَامِض (ذو طبيعة مُلتبِسة وعسيرة الفهم)",
 "mystique": "جَاذِبِيَّة غَامِضَة, سِحْر غَامِض (هالة من القيمة العالية أو الاهتمام أو المعنى تحيط بشخص أو شيء)",
 "myth": "خُرَافَة",
 "mythic": "أُسْطُورِيّ, مِيثُولُوجِيّ (مبنيّ على القصص التقليدية أو مرويّ فيها؛ يفتقر إلى أساس واقعي) / أسطوري (يتعلق بالأسطورة أو له طبيعتها)\nمثال: رواية ذات أهمية أسطورية تقريباً",
 "mythical": "أُسْطُورِيّ, مِيثُولُوجِيّ (مبنيّ على القصص التقليدية أو مرويّ فيها؛ يفتقر إلى أساس واقعي)",
 "mythical being": "كائن أسطوري (كائن خيالي من الأساطير أو الخرافات)",
 "mythical creature": "مخلوق أسطوري, وحش أسطوري (وحش مشهور في الفولكلور والأسطورة)",
 "mythical monster": "مخلوق أسطوري, وحش أسطوري (وحش مشهور في الفولكلور والأسطورة)",
 "mythical place": "مكان أسطوري, مكان خيالي (مكان موجود فقط في الخيال؛ أو مكان يقال إنه موجود في الكتابات الخيالية أو الدينية)",
