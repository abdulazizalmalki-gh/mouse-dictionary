 "neo-aramaic": "آرَامِيَّة حَدِيثَة",
 "neo-baroque": "باروك جديد (فن أو عمارة تعتمد على دراسة باروك القرن السابع عشر)\nمثال: مثل الكامب، يتعامل الباروك الجديد لفناني بارتليم مع الجسد كموقع للأداء والإحساس الملموس",
 "neo-darwinian": "دارويني حديث (من أو يتعلق بنظريات داروين المعدلة بواسطة الاكتشافات الجينية الحديثة)\nمثال: نظريات داروينية حديثة",
 "neo-darwinism": "داروينية حديثة (نظرية داروينية حديثة تشرح الأنواع الجديدة من حيث الطفرات الجينية)",
 "neo-evolutionism": "التطورية الجديدة (مدرسة في الأنثروبولوجيا تهتم بالتغير الثقافي طويل الأمد وأنماط التطور المماثلة التي يمكن رؤيتها في ثقافات غير مترابطة ومتباعدة)\nمثال: كانت التطورية الجديدة الأولى في سلسلة من نظريات التطور متعددة الخطوط الحديثة",
 "neo-gothic": "إحياء العمارة القوطية, القوطية الحديثة (طراز معماري استلهم العمارة في العصور الوسطى وتنافس مع حركات الإحياء الكلاسيكية الجديدة في الولايات المتحدة وبريطانيا العظمى)",
 "neo-gothic architecture": "إحياء العمارة القوطية, القوطية الحديثة (طراز معماري استلهم العمارة في العصور الوسطى وتنافس مع حركات الإحياء الكلاسيكية الجديدة في الولايات المتحدة وبريطانيا العظمى)",
 "neo-impressionism": "انطباعية جديدة (حركة في أواخر القرن التاسع عشر في الرسم الفرنسي سعت لتحسين الانطباعية من خلال نهج منهجي للشكل واللون، باستخدام التقنية التنقيطية بشكل خاص)\nمثال: الانطباعية الجديدة لماكسيميليان لوس ومؤيده روبرت بيرنييه، على سبيل المثال، يجب تمييزها عن تلك الخاصة بسورا ومؤيده غوستاف خان",
 "neo-kantianism": "كانطية جديدة (حركة فلسفية عارضت المادية والمثالية في منتصف القرن التاسع عشر، وتطورت من نظرية المعرفة عند كانط، معتبرة الشيء في ذاته مفهوماً حدودياً ومؤكدة على…)",
 "neo-lamarckian": "لاماركي حديث (من أو يتعلق بنسخة حديثة من اللاماركية)\nمثال: نظريات لاماركية حديثة",
 "neo-lamarckism": "لاماركية حديثة (نظرية لاماركية حديثة تؤكد على أهمية العوامل البيئية في التغيرات الجينية وتحتفظ بمفهوم وراثة الصفات المكتسبة)",
 "neo-latin": "اللاتينية الجديدة (اللاتينية منذ عصر النهضة؛ تستخدم للتسميات العلمية)",
 "neo-latin language": "اللاتينية الجديدة (اللاتينية منذ عصر النهضة؛ تستخدم للتسميات العلمية)",
 "neo-marxism": "ماركسية جديدة (مصطلح يطلق بشكل فضفاض على أي نظرية اجتماعية أو تحليل اجتماعي يعتمد على أفكار كارل ماركس وفريدريك إنجلز، ولكنه يعدلها أو يوسعها، عادة بدمج عناصر من…)",
 "neo-nazi": "نَازِيّ جَدِيد, نَازِيُّون جُدُد",
 "neo-nazism": "نَازِيَّة جَدِيدَة",
 "neo-renaissance": "إحياء عمارة النهضة, عمارة النهضة الحديثة (تسمية شاملة تغطي العديد من أنماط الإحياء المعماري في القرن التاسع عشر التي لم تكن يونانية ولا قوطية بل استلهمت بدلاً من ذلك مجموعة واسعة من الأنماط…)",
 "neo-slavism": "السلافية الجديدة (حركة قصيرة الأجل نشأت في الإمبراطورية النمساوية المجرية حوالي عام 1908 وأثرت على الدول السلافية القريبة في البلقان وكذلك روسيا)",
 "neo-zionism": "صهيونية جديدة",
 "neobaroque": "باروك جديد (فن أو عمارة تعتمد على دراسة باروك القرن السابع عشر)\nمثال: مثل الكامب، يتعامل الباروك الجديد لفناني بارتليم مع الجسد كموقع للأداء والإحساس الملموس",
 "neobehaviorism": "سلوكية جديدة (مدرسة في علم النفس تستند إلى المبادئ العامة للسلوكية ولكنها أوسع وأكثر مرونة في المفهوم)",
 "neobiotic": "نيوبايوتيك, نيومايسين (مضاد حيوي يتم الحصول عليه من شعيات ويستخدم (كبريتات تحت الاسم التجاري نيوبايوتيك) كمطهر معوي في الجراحة)",
 "neoclassic": "نِيُوكْلَاسِيكِيّ (ينتمي إلى المذهب الكلاسيكيّ الجديد أو يتّسم بطابعه)",
 "neoclassical": "نِيُوكْلَاسِيكِيّ (ينتمي إلى المذهب الكلاسيكيّ الجديد أو يتّسم بطابعه)",
 "neoclassicism": "كلاسيكية جديدة (إحياء لأسلوب كلاسيكي (في الفن أو الأدب أو العمارة أو الموسيقى) ولكن من منظور جديد أو بدافع جديد)",
 "neoclassicist": "كلاسيكي حديث (متعلق بالكلاسيكية الحديثة أو مؤيد لها) / كلاسيكي حديث (مدافع عن الكلاسيكية الجديدة)",
 "neoclassicistic": "كلاسيكي حديث (متعلق بالكلاسيكية الحديثة أو مؤيد لها)",
 "neocolonial": "نِيوُكُولُونِيالِيّ",
 "neocolonialism": "اِسْتِعْمَار جَدِيد, نِيوُكُولُونِيالِيّة",
 "neocon": "محافظ جديد (محافظ يتبنى المحافظة الجديدة)",
 "neoconservatism": "محافظة جديدة (نهج في السياسة أو اللاهوت يمثل عودة إلى وجهة نظر تقليدية (على عكس المدارس الفكرية الأكثر ليبرالية أو راديكالية في الستينيات))",
 "neoconservative": "محافظ جديد (محافظ يتبنى المحافظة الجديدة)",
 "neocortex": "قشرة حديثة (الجزء القشري من الدماغ الحديث)",
 "neocortical": "قشري حديث",
 "neocriticism": "نقدية جديدة (شكل من أشكال الكانطية الجديدة طوره بشكل رئيسي رينوفييه وأتباعه رافضين النومن (الشيء في ذاته) عند كانط وقصروا المعرفة على الظواهر كما تشكلها الفئات…)",
 "neodymium": "نِيُودِيمِيُوم",
 "neoencephalon": "دماغ حديث (جزء الدماغ ذو الأصل الفيلوجيني الأحدث؛ القشرة المخية والأجزاء ذات الصلة)",
 "neoevolutionism": "التطورية الجديدة (مدرسة في الأنثروبولوجيا تهتم بالتغير الثقافي طويل الأمد وأنماط التطور المماثلة التي يمكن رؤيتها في ثقافات غير مترابطة ومتباعدة)\nمثال: كانت التطورية الجديدة الأولى في سلسلة من نظريات التطور متعددة الخطوط الحديثة",
 "neoexpressionism": "التعبيرية الجديدة (حركة فنية مبنية على التعبيرية؛ تطورت في الثمانينيات في أوروبا والولايات المتحدة؛ تتميز بلوحات صارخة مرسومة بشكل بدائي)",
 "neofascism": "فَاشِيَّة جَدِيدَة",
 "neofiber alleni": "جرذ ماء فلوريدا, فأر المسك مستدير الذيل (من الأراضي الرطبة في فلوريدا)",
 "neohygrophorus angelesianus": "نيوهيجروفوروس أنجيليسيانوس (فطر بقبعة محدبة بنية صغيرة مع قرص منخفض؛ خياشيم شمعية بلون النبيذ وساق بني؛ يثمر في أو بالقرب من ضفاف الثلج الذائب في الجبال الغربية لأمريكا الشمالية)",
 "neoimperialism": "إمبريالية جديدة",
 "neolentinus ponderosus": "نيولنتينوس بونديروسوس (بوليبور ذو خياشيم بقبعة كبيرة (يصل قطرها إلى 15 بوصة) وساق عريض؛ صالح للأكل عندما يكون صغيراً وطرياً)",
 "neoliberal": "نِيُولِيبْرَالِيّ (يُؤْمِنُ بِضَرُورَةِ النُّمُوِّ الِاقْتِصَادِيِّ إِضَافَةً إِلَى الأَهْدَافِ اللِّيبْرَالِيَّةِ التَّقْلِيدِيَّةِ) / ليبرالي جديد (ليبرالي يتبنى الليبرالية الجديدة)",
 "neoliberalism": "نِيُولِيبِرَالِيَّة",
 "neolith": "أداة من العصر الحجري الحديث, أداة نيوليثية (أداة حجرية من العصر الحجري الحديث)",
 "neolithic": "حجري حديث, نيوليثي (من أو متعلق بأحدث فترة من العصر الحجري (تلي العصر الحجري المتوسط))\nمثال: أدلة على مستوطنات من العصر الحجري الحديث",
 "neologism": "مُوَلَّدَة / تَوْلِيد",
 "neologist": "مبتدع كلمات, واضع المصطلحات (معجمي مختص بالكلمات والتعابير الجديدة)",
 "neology": "اشتقاق جديد, كلمة مستحدثة (فعل اختراع كلمة أو عبارة جديدة) / كلمة مستحدثة, لفظ مولد (كلمة أو عبارة مخترعة حديثاً)",
 "neomycin": "نيوبايوتيك, نيومايسين (مضاد حيوي يتم الحصول عليه من شعيات ويستخدم (كبريتات تحت الاسم التجاري نيوبايوتيك) كمطهر معوي في الجراحة)",
 "neomys anomalus": "زباب الماء المتوسطي (نوع من زباب الماء)",
 "neomys fodiens": "زباب الماء الأوروبي (زباب ماء واسع الانتشار في العالم القديم)",
 "neon": "نِيُون",
 "neon induction lamp": "مصباح نيون (مصباح يتكون من أنبوب تفريغ غازي صغير يحتوي على نيون بضغط منخفض؛ يتم إنتاج التلألؤ بفعل التيارات عند ترددات عالية ملفوفة بضع لفات حول الأنبوب)",
 "neon lamp": "مصباح نيون (مصباح يتكون من أنبوب تفريغ غازي صغير يحتوي على نيون بضغط منخفض؛ يتم إنتاج التلألؤ بفعل التيارات عند ترددات عالية ملفوفة بضع لفات حول الأنبوب)",
 "neon tube": "مصباح نيون (مصباح يتكون من أنبوب تفريغ غازي صغير يحتوي على نيون بضغط منخفض؛ يتم إنتاج التلألؤ بفعل التيارات عند ترددات عالية ملفوفة بضع لفات حول الأنبوب)",
 "neonatal": "حديث الولادة, وليدي (متعلق بـ أو يؤثر على الرضيع خلال الشهر الأول بعد الولادة)\nمثال: رعاية حديثي الولادة",
 "neonatal death": "وفاة حديثي الولادة (وفاة رضيع ولد حياً خلال أول 28 يوماً من الحياة)",
 "neonatal hyperbilirubinemia": "يرقان الوليد (اضطراب شائع يرجع عادة إلى عدم نضج الكبد؛ يزول عادة تلقائياً)",
 "neonatal intensive care unit": "وحدة العناية المركزة لحديثي الولادة (وحدة عناية مركزة مصممة بمعدات خاصة لرعاية الأطفال حديثي الولادة المبتسرين أو المصابين بمرض خطير)",
 "neonatal mortality": "مُعَدَّل وَفَيَات حَدِيثِي الوِلَادَة (معدل الوفيات خلال أول 28 يوماً من الحياة)",
 "neonatal mortality rate": "مُعَدَّل وَفَيَات حَدِيثِي الوِلَادَة (معدل الوفيات خلال أول 28 يوماً من الحياة)",
 "neonatal period": "فترة حديثي الولادة (أول 28 يوماً من الحياة)",
 "neonate": "حديث الولادة, وليد (طفل من الولادة حتى أربعة أسابيع)",
 "neonatology": "طب حديثي الولادة (فرع طب الأطفال المعني بحديثي الولادة؛ تشخيص وعلاج المواليد الجدد)",
 "neopallium": "قشرة حديثة (الجزء القشري من الدماغ الحديث)",
 "neophobia": "رهاب الجديد (خوف مرضي من التجديد)",
 "neophron percnopterus": "رخمة مصرية (نسر صغير أبيض في الغالب من أفريقيا وجنوب أوراسيا)",
 "neophyte": "حديث العهد بالإيمان, موعوظ (معتنق جديد يتم تعليمه مبادئ المسيحية) / قادم جديد, مستجد (أي مشارك جديد في نشاط ما) / نبات دخيل حديث, نبات وافد (نبات موجود في منطقة لم يتم تسجيله فيها سابقاً)",
 "neoplasia": "تكون الورم (العملية المرضية التي تؤدي إلى تكوين ونمو ورم)",
 "neoplasm": "ورم (كتلة نسيجية جديدة غير طبيعية لا تخدم أي غرض)",
 "neoplastic": "ورمي (مكون من أو متعلق بـ أو يمتلك خصائص الورم)\nمثال: خلايا ورمية",
 "neoplastic cell": "خلية ورمية (خلية تشكل جزءاً من ورم)",
 "neoplatonism": "أفلاطونية محدثة (نظام من العقائد الفلسفية واللاهوتية يتألف من عناصر الأفلاطونية والأرسطية والتصوف الشرقي؛ مذهبها الأكثر تميزاً يرى أن المبدأ الأول ومصدر الواقع يتجاوز…)\nمثال: كانت الأفلاطونية المحدثة سائدة في أوروبا الوثنية حتى القرن السادس",
 "neoplatonist": "أَفْلاطُونِيّ مُحْدَث (معتنق للأفلاطونية المحدثة)",
 "neopolitan": "نابوليتاني (مقيم في نابولي)",
 "neoprene": "نيوبرين",
 "neoromanticism": "الرومانسية الجديدة (حركة فنية تستند إلى إحياء الرومانسية في الفن والأدب)",
 "neosporin": "نيوسبورين (اسم تجاري لدواء موضعي يحتوي على العديد من المضادات البكتيرية؛ يستخدم كمرهم لتهيجات الجلد وعلى شكل قطرات للعين للالتهابات الخفيفة)",
 "neostigmine": "بروستيغمين, نيوستيغمين (دواء كوليني (الاسم التجاري بروستيغمين) يستخدم لعلاج بعض حالات العيون ولعلاج الوهن العضلي الوبيل)",
 "neotenic": "نيوتيني, يرقاني\nمثال: تطور يرقاني",
 "neotenous": "نيوتيني, يرقاني\nمثال: تطور يرقاني",
 "neoteny": "استدامة المرحلة اليرقية, نيوطيني (اتجاه تطوري للولادة المبكرة بحيث يتوقف التطور في مرحلة مبكرة ويتم الاحتفاظ بالخصائص الطفولية لدى البالغين من النوع)",
 "neotoma cinerea": "جرذ الخشب كثيف الذيل, جرذ جامع (أي من عدة قوارض كثيفة الذيل من جنس نيوتوما في غرب أمريكا الشمالية؛ يجمع الطعام وأشياء أخرى)",
 "neotoma floridana": "جرذ الخشب الشرقي (جرذ خشب بني رمادي كبير من جنوب شرق الولايات المتحدة)",
 "neotoma fuscipes": "جرذ الخشب داكن القدمين (مضيف لقراد داء لايم في شمال كاليفورنيا)",
 "neotony": "استدامة المرحلة اليرقية, نيوتيني (الحالة الناتجة عند الاحتفاظ بخصائص الصغر (الأحداث) من قبل البالغين من النوع)",
 "nepal": "نِيبَال",
 "nepal trumpet flower": "زهرة بوق نيبال, كرمة زنبق الفصح (نبات متسلق خشبي دائم الخضرة ذو أوراق لامعة كبيرة ونورات خيمية مبهرجة من الأزهار البيضاء العطرة البوقية الشكل)",
 "nepalese": "نيبالي (من أو يخص أو يميز نيبال أو شعبها أو لغتها أو ثقافتها) / نيبالي (مواطن أو ساكن في نيبال)\nمثال: حشدت القوات النيبالية على الحدود",
 "nepalese monetary unit": "وحدة نقدية نيبالية (الوحدة النقدية في نيبال)",
 "nepalese rupee": "روبية, روبية نيبالية (وحدة المال الأساسية في نيبال؛ تساوي 100 بيزة)",
 "nepali": "نِيبَالِيّ",
 "nepali language": "النيبالية (لغة الدولة الرسمية لنيبال)",
 "nepeta cataria": "حشيشة الهر, قطرم (عشب معمر عطري مشعر له دوامات من الزهور البيضاء الصغيرة المرقطة بالأرجواني في سنبلة طرفية؛ استخدم في الماضي كعلاج منزلي؛ جذاب بشدة للقطط)",
 "nepeta hederacea": "جيليكوما, روبن الهارب",
 "nepeta hederaceae": "جيليكوما, روبن الهارب",
 "nepheline": "نيفيلين (معدن مائل للبياض يتكون من سيليكات الصوديوم والألمنيوم أو البوتاسيوم في شكل بلوري؛ يستخدم في صناعة السيراميك والمينا)",
 "nephelinite": "نيفيلينيت (صخر ناري يتكون من النيفيلين والبيروكسين)",
 "nephelite": "نيفيلين (معدن مائل للبياض يتكون من سيليكات الصوديوم والألمنيوم أو البوتاسيوم في شكل بلوري؛ يستخدم في صناعة السيراميك والمينا)",
 "nephelium lappaceum": "رامبوتان, شجرة الرامبوتان (شجرة ماليزية تحمل فاكهة حمراء شائكة)",
 "nephelium litchi": "شجرة الليتشي, ليتشي (شجرة صينية تزرع خاصة في الفلبين والهند لفاكهتها الصالحة للأكل)",
 "nephelium longana": "لونجان, لونغان (شجرة من جنوب شرق آسيا إلى أستراليا تزرع أساساً لفاكهتها الحلوة الصالحة للأكل التي تشبه مكسرات الليتشي)",
 "nephelium mutabile": "بولاسان, شجرة البولاسان (شجرة فاكهة من جزر الهند الشرقية تحمل فاكهة تشبه الرامبوتان ولكنها أحلى)",
 "nephew": "اِبْنُ أَخٍ, اِبْنُ أُخْتٍ (الولد الذكر)\nمثال: هو له ابن صغير.",
 "nephology": "علم السحب (فرع الأرصاد الجوية الذي يدرس السحب وتكوينها)",
 "nephoscope": "مقياس السحب, نيفوسكوب (أداة قياس تستخدم شبكة لقياس الارتفاع والاتجاه وسرعة حركة السحب)",
 "nephralgia": "ألم الكلية (ألم في الكلى (عادة ما يشعر به في الخاصرة))",
 "nephrectomy": "استئصال الكلية (إزالة جراحية للكلية)",
 "nephrite": "نيفرِيت, يشم نيفريت (معدن أمفيبولي يتكون من سيليكات الكالسيوم والمغنيسيوم في شكل بلوري أحادي الميل؛ مصدر لليشم (أقل قيمة من الجاديت)؛ كان يعتقد قديماً أنه يعالج اضطرابات…)",
 "nephritic": "كلوي (متعلق بالكلى) / ملتهب الكلية (مصاب بالتهاب الكلية)",
 "nephritis": "التهاب الكلية, مرض برايت (التهاب في الكلى)",
 "nephroangiosclerosis": "تصلب الكلية (مرض كلوي يرتبط عادة بارتفاع ضغط الدم)",
 "nephroblastoma": "ورم كلوي جنيني, ورم ويلمز (ورم كلوي خبيث يصيب الأطفال الصغار ويتميز بارتفاع ضغط الدم ووجود دم في البول ووجود كتلة محسوسة)",
 "nephrocalcinosis": "تكلس الكلية (تحصي كلوي تتشكل فيه رواسب الكالسيوم في حمة الكلية)",
 "nephrogenic diabetes insipidus": "بيلة تفهة كلوية المنشأ (سكري كاذب ناتج عن فشل الكلى في الاستجابة للمستويات الطبيعية من الفازوبريسين)",
 "nephrolepis exaltata": "سرخس بوسطن (سرخس سيف بسعف ريشي مقوس أو متدلي؛ نبات منزلي شائع)",
 "nephrolepis exaltata bostoniensis": "سرخس بوسطن (سرخس سيف بسعف ريشي مقوس أو متدلي؛ نبات منزلي شائع)",
 "nephrolepis pectinata": "سرخس السلة, سرخس السيف المسنن (سرخس أمريكي استوائي يزرع لأوراقه الخضراء الرمادية المقسمة بدقة؛ جزر الهند الغربية وجنوب المكسيك إلى بيرو والبرازيل)",
 "nephrolith": "حَصَاةُ الكُلْيَة (حصاة تتكون في الكلية)",
 "nephrolithiasis": "حصى الكلى (وجود حصوات الكلى في الكلى)",
 "nephrology": "طب الكلى (فرع الطب المعني بالكلى - تطورها وتشريحها وفسيولوجيتها واضطراباتها)",
 "nephron": "وَحْدَة أُنْبُوبِيَّة كُلْوِيَّة, كُلْيُون",
 "nephropathy": "اعتلال الكلية, مرض كلوي (مرض يصيب الكلى)",
 "nephrops norvegicus": "كركند نرويجي (كركند أوروبي صالح للأكل يشبه الكركند الأمريكي ولكنه أكثر نحافة)",
 "nephroptosia": "تتدلي الكلية, هبوط الكلية (تدلي الكلية)",
 "nephroptosis": "تتدلي الكلية, هبوط الكلية (تدلي الكلية)",
 "nephrosclerosis": "تصلب الكلية (مرض كلوي يرتبط عادة بارتفاع ضغط الدم)",
 "nephrosis": "اعتلال الكلية, مرض كلوي (مرض يصيب الكلى) / متلازمة كلوية, نفروز (متلازمة تتميز بالوذمة ووجود كميات كبيرة من البروتين في البول وعادة زيادة كوليسترول الدم؛ ترتبط عادة بالتهاب كبيبات الكلى أو بمضاعفات أمراض جهازية…)",
 "nephrotic syndrome": "متلازمة كلوية, نفروز (متلازمة تتميز بالوذمة ووجود كميات كبيرة من البروتين في البول وعادة زيادة كوليسترول الدم؛ ترتبط عادة بالتهاب كبيبات الكلى أو بمضاعفات أمراض جهازية…)",
 "nephrotomy": "بضع الكلية (شق في الكلية (عادة لإزالة حصوة الكلى))",
 "nephrotoxic": "سَامّ لِلْكُلْيَة (ذو تأثير سامّ على الكلية)",
 "nephrotoxin": "ذيفان كلوي, سم كلوي (أي سم يؤثر على الكلى)",
 "nephthytis": "نفتيتيس (أي نبات من جنس نفتيتيس)",
 "nephthytis afzelii": "نيفتيتيس (نبات جذموري استوائي يزرع للزينة لأوراقه السهمية الكبيرة)",
 "nepotism": "محسوبية الأقارب (المحاباة التي يظهرها من هم في السلطة للأقارب أو الأصدقاء المقربين (كإعطائهم وظائف))",
 "nepotist": "محابي الأقارب (شخص قوي يظهر المحاباة للأقارب أو الأصدقاء المقربين)",
 "neptune": "نِبْتُون",
 "neptunian": "نِبْتُونِيّ",
 "neptunism": "نبتونية (النظرية القديمة القائلة بأن جميع صخور القشرة الأرضية تشكلت بفعل الماء)",
 "neptunium": "نِبْتُونِيُوم",
 "nerd": "نِيرْد, غِيك",
 "nereid": "نيريد ((الأساطير اليونانية) أي من حوريات البحر الخمسين اللواتي كن بنات إله البحر نيريوس)",
 "nerita": "نيريتا (بطني قدم نيريتيد له صدفة قصيرة ملساء أو ذات حواف حلزونية مع شفة خارجية سميكة مسننة عادة وغطاء مسنن)",
 "nerita peloronta": "سن نازف (بطني قدم له نتوءات تشبه الأسنان المحمرة حول فتحة الصدفة؛ من منطقة البحر الكاريبي)",
 "neritic": "سَاحِلِيّ, نِيرِيتِيّ (مُتَعَلِّقٌ بِمَنْطِقَةِ المِيَاهِ الضَّحْلَةِ المُجَاوِرَةِ لِلسَّاحِل) / شاطئي, نيريتيكي (من أو يتعلق بمنطقة البحر فوق الرصيف القاري التي يقل عمقها عن 200 متر)\nمثال: حيوانات نيريتيكية",
 "neritic zone": "المنطقة الضحلة, النطاق النيريتيكي (مياه المحيط من علامة الجزر المنخفض إلى عمق حوالي 100 قامة)",
 "neritid": "نيريتيد (حلزون بحري ذو غطاء يعيش في المياه الساحلية بصدفة حلزونية قصيرة)",
 "neritid gastropod": "نيريتيد (حلزون بحري ذو غطاء يعيش في المياه الساحلية بصدفة حلزونية قصيرة)",
 "neritina": "نيريتينا (حلزونات مزخرفة وزاهية الألوان من المياه المالحة)",
 "nerium oleander": "دفلى, ورد الحمار (شجيرة مزهرة للزينة ولكنها سامة، ذات أوراق دائمة الخضرة ضيقة ومجموعات من الأزهار العطرة البيضاء إلى الوردية أو الحمراء؛ موطنها جزر الهند الشرقية…)",
 "nero's crown": "تفاحة آدم, زهرة الطاحونة (شجيرة استوائية ذات أوراق لامعة وأزهار ليلية عطرة ذات تيجان مجعدة أو متموجة؛ من شمال الهند إلى تايلاند)",
 "nerodia sipedon": "ثعبان الماء الشائع, ثعبان الماء المخطط (يُوضع في بعض التصنيفات في جنس نيروديا؛ ثعبان من غرب الولايات المتحدة نادراً ما يبتعد عن الماء)",
 "neroli oil": "زيت النيرولي (زيت أصفر عطري يوجد في زهور البرتقال ويُستخدم في العطور وكمنكه)",
 "nerve": "عَصَب",
 "nerve agent": "عامل أعصاب, غاز الأعصاب (غاز سام يتم استنشاقه أو امتصاصه عبر الجلد وله آثار ضارة على الجهاز العصبي والتنفسي)",
 "nerve block anaesthesia": "تخدير توصيلي, حصر العصب (تخدير منطقة يغذيها عصب معين؛ يتم عن طريق تطبيق عامل مخدر على العصب)",
 "nerve block anesthesia": "تخدير توصيلي, حصر العصب (تخدير منطقة يغذيها عصب معين؛ يتم عن طريق تطبيق عامل مخدر على العصب)",
 "nerve cell": "عَصْبُون, خَلِيَّة عَصَبِيَّة",
 "nerve center": "مركز, مركز عصبي (مجموعة من الخلايا العصبية تتحكم في عملية جسدية محددة) / غرفة العمليات, مركز الأعصاب (مركز يوفر المعلومات والتحكم)\nمثال: في معظم الناس يقع مركز الكلام في نصف الكرة الأيسر",
 "nerve centre": "مركز, مركز عصبي (مجموعة من الخلايا العصبية تتحكم في عملية جسدية محددة) / غرفة العمليات, مركز الأعصاب (مركز يوفر المعلومات والتحكم)\nمثال: في معظم الناس يقع مركز الكلام في نصف الكرة الأيسر",
 "nerve compression": "انضغاط العصب (ضغط ضار على العصب (خاصة في الأعصاب التي تمر فوق نتوءات صلبة)؛ يسبب تلف العصب وضعف العضلات)",
 "nerve deafness": "فقدان السمع الحسي العصبي (فقدان السمع بسبب فشل العصب السمعي)",
 "nerve end": "نهاية عصبية (الهيكل الطرفي للمحور العصبي الذي لا ينتهي عند مشبك عصبي)",
 "nerve ending": "نهاية عصبية (الهيكل الطرفي للمحور العصبي الذي لا ينتهي عند مشبك عصبي)",
 "nerve entrapment": "انحباس العصب (ضغط عصبي متكرر وطويل الأمد (عادة في الأعصاب القريبة من المفاصل المعرضة للالتهاب أو التورم))",
 "nerve fiber": "ليف عصبي (امتداد خيطي للخلية العصبية)",
 "nerve fibre": "ليف عصبي (امتداد خيطي للخلية العصبية)",
 "nerve gas": "غَاز أَعْصَاب, عَامِل أَعْصَاب",
 "nerve growth factor": "عامل نمو الأعصاب (بروتين يشارك في نمو الخلايا العصبية الطرفية)",
 "nerve impulse": "سيال عصبي, نبضة عصبية (التفريغ الكهربائي الذي ينتقل عبر الليف العصبي)\nمثال: أثبتوا انتقال النبضات من القشرة الدماغية إلى منطقة تحت المهاد",
 "nerve pathway": "سبيل عصبي, مسلك عصبي (حزمة من الألياف العصبية المغلفة بالمايلين تتبع مساراً عبر الدماغ)",
 "nerve plexus": "ضفيرة عصبية (شبكة من الأعصاب المتقاطعة)",
 "nerve tissue": "نسيج عصبي (نسيج يتكون من عصبونات)",
 "nerve tract": "سبيل عصبي, مسلك عصبي (حزمة من الألياف العصبية المغلفة بالمايلين تتبع مساراً عبر الدماغ)",
 "nerve-racking": "مُجْهِد, مُرْهِق لِلأَعْصَاب (مُثير للأعصاب بشكل شديد ومُضنٍ)",
 "nerve-wracking": "مُجْهِد, مُرْهِق لِلأَعْصَاب (مُثير للأعصاب بشكل شديد ومُضنٍ)",
 "nerveless": "بَارِدُ الأَعْصَاب, رَابِطُ الجَأْش (يتسم بضبط النفس الهادئ خاصةً في الظروف الصعبة؛ غير انفعاليّ) / خَائِر القُوَى, ضَعِيف (يفتقر إلى القوة والعزيمة)",
 "nervelessly": "بِبُرُود, بِرَبَاطَة جَأْش (بطريقة هادئة وغير مبالية)\nمثال: دون مزيد من اللغط، استعار باركر سكيناً من رائد لوائه وشحذها على حجر الكاربورندم ببرود كجزار",
 "nervelessness": "برود الأعصاب, هدوء الأعصاب (تمالك النفس بجرأة في مواجهة الخطر)",
 "nerveroot": "خف السيدة الوردي, زهرة الخف (سحلب غابات وردي كان شائعاً في السابق في شرق أمريكا الشمالية)",
 "nerves": "أعصاب, ثبات (التحكم في العواطف) / توتر عصبي, عصبية (حالة نفسية غير مستقرة)\nمثال: هذا النوع من التوتر ليس جيداً لأعصابي",
 "nerves of steel": "أعصاب حديدية (أعصاب ثابتة جداً؛ صبر وشجاعة كبيرة)\nمثال: كنت خائفاً حتى الموت، لكن فريد، الذي يمتلك أعصاباً حديدية، واجه البلطجية بشجاعة",
 "nervii olfactorii": "عصب شمي, عصب قحفي أول (مصطلح جماعي للعديد من الخيوط الشمية في الغشاء المخاطي للأنف)",
 "nervily": "بِوَقَاحَة (بطريقة وقحة وجريئة)\nمثال: بوقاحة، طلبت خصماً",
 "nervism": "عصبية (الموقف الفلسفي الذي تبناه بافلوف بأن جميع العمليات السلوكية والفسيولوجية ينظمها الجهاز العصبي)",
 "nervous": "عَصَبِيّ",
 "nervous breakdown": "انهيار عصبي (اضطراب عاطفي شديد أو معجز)",
 "nervous disorder": "اضطراب عصبي, مرض عصبي (اضطراب في الجهاز العصبي)",
 "nervous exhaustion": "إنهاك عصبي (اضطراب عاطفي يجعلك منهكاً وغير قادر على العمل)",
 "nervous impulse": "سيال عصبي, نبضة عصبية (التفريغ الكهربائي الذي ينتقل عبر الليف العصبي)\nمثال: أثبتوا انتقال النبضات من القشرة الدماغية إلى منطقة تحت المهاد",
 "nervous prostration": "إنهاك عصبي (اضطراب عاطفي يجعلك منهكاً وغير قادر على العمل)",
 "nervous strain": "إجهاد, إجهاد ذهني ((علم النفس) عصبية ناتجة عن الضغط النفسي)\nمثال: كانت مسؤولياته تشكل ضغطاً مستمراً",
 "nervous system": "جِهَاز عَصَبِيّ",
 "nervous tissue": "نسيج عصبي (نسيج يتكون من عصبونات)",
 "nervously": "بتوتر, بقلق (بطريقة عصبية وقلقة) / باضطراب, بنزق (بإثارة عصبية)\nمثال: راقبنا سوق الأسهم بتوتر",
 "nervousness": "تَوَتُّر",
 "nervure": "عرق (أحد الأضلاع القرنية التي تصلب وتدعم جناح الحشرة) / عرق (أي من الحزم الوعائية أو الأضلاع التي تشكل الإطار المتفرع للأنسجة الموصلة والداعمة في ورقة أو عضو نباتي آخر)",
 "nervus": "عصب (أي حزمة من الألياف العصبية تمتد إلى أعضاء وأنسجة مختلفة في الجسم)",
 "nervus abducens": "عصب قحفي سادس, عصب مبعد (عصب حركي صغير يغذي العضلة المستقيمة الوحشية للعين)",
 "nervus accessorius": "عصب إضافي, عصب قحفي حادي عشر (ينشأ من مجموعتين من الجذور (قحفية وشوكية) تتحد لتشكل العصب)",
 "nervus coccygeus": "عصب عصعصي (أدنى زوج من الأعصاب الشوكية)",
 "nervus facialis": "عصب قحفي سابع, عصب وجهي (عصب قحفي يغذي عضلات الوجه)",
 "nervus femoralis": "عصب فخذي (أحد زوجين من الأعصاب التي تنشأ من الأعصاب القطنية وتغذي العضلات والجلد في الجزء الأمامي من الفخذ)",
 "nervus glossopharyngeus": "عصب بلعومي لساني, عصب قحفي تاسع (عصب حسي للبلعوم ومؤخرة اللسان؛ تعصب الألياف الحركية العضلات التي ترفع البلعوم والحنجرة؛ يشمل أليافاً لاودية إلى العقدة الأذنية)",
 "nervus hypoglosus": "عصب تحت اللسان, عصب قحفي ثاني عشر (يغذي العضلات الداخلية لللسان وعضلات اللسان الأخرى)",
 "nervus ischiadicus": "عصب النسا, عصب وركي (ينشأ من الضفيرة العجزية ويمر حوالي منتصف الطريق أسفل الفخذ حيث ينقسم إلى العصب الشظوي المشترك والعصب الظنبوبي)",
 "nervus oculomotorius": "عصب قحفي ثالث, عصب محرك للعين (يغذي العضلات الخارجية للعين)",
 "nervus opticus": "عصب بصري, عصب قحفي ثاني (العصب القحفي الذي يخدم الشبكية)",
 "nervus phrenicus": "عصب حجابي (أحد زوجين من الأعصاب ينشأ من الجذور الشوكية العنقية ويمر أسفل القفص الصدري ليعصب الحجاب الحاجز ويتحكم في التنفس)",
 "nervus radialis": "عصب كعبري (أكبر فرع من الضفيرة العضدية؛ يمتد أسفل العضد إلى اللقيمة الوحشية حيث ينقسم إلى فرع يذهب إلى الجلد على ظهر اليد وآخر يذهب إلى العضلات الباسطة التحتية)",
 "nervus saphenus": "عصب صافن (فرع من العصب الفخذي يوفر فروعاً جلدية للجانب الداخلي للساق والقدم)",
 "nervus spinalis": "عصب شوكي (أي من الأزواج الـ 31 من الأعصاب الخارجة من كل جانب من الحبل الشوكي (كل منها متصل بالحبل بواسطة جذرين: بطني وظهري))",
 "nervus trigeminus": "عصب ثلاثي التوائم, عصب قحفي خامس (العصب الحسي الرئيسي للوجه والعصب الحركي لعضلات المضغ)",
 "nervus ulnaris": "عصب زندي (عصب يمتد على طول الجانب الداخلي للذراع ويمر بالقرب من الكوع؛ يغذي العضلات الداخلية لليد والجلد على الجانب الإنسي لليد)",
 "nervus vagus": "عصب قحفي عاشر, عصب مبهم (عصب مختلط يغذي البلعوم والحنجرة والرئتين والقلب والمريء والمعدة ومعظم الأحشاء البطنية)",
 "nervus vestibulocochlearis": "عصب دهليزي قوقعي, عصب سمعي (عصب حسي مركب يغذي الخلايا الشعرية للعضو الدهليزي والخلايا الشعرية للقوقعة)",
 "nervy": "قَلِيل الأَدَب, وَقِح (جريء بشكل مسيء وبذيء) / جَرِيء, وَقِح (يُظهر الشجاعة والاستخفاف بالخطر) / حَسَّاسُ الأَعْصَاب, عَصَبِيّ (فِي حَالَةِ تَوَتُّرٍ وَانْفِعَال)",
 "nescience": "جهالة, عدم دراية (الجهل (خاصة بالمعتقدات التقليدية))",
 "nescient": "جَاهِل, غَيْرُ مُتَعَلِّم (غير متعلّم بشكل عامّ؛ يفتقر إلى المعرفة أو الحصافة) / غَيْرُ مُؤْمِن, لَاأَدْرِيّ (يرى أن المعرفة تقتصر على الظواهر المادية وأن المسائل الروحية لا يمكن معرفتها)",
 "ness": "رأس, لسان بري (شريط من الأرض يبرز في مسطح مائي)",
 "nesselrode": "بودينغ نيسلرود (بودينغ مجمد غني مصنوع من الكستناء المفرومة وكرز الماراشينو والفواكه المسكرة والمشروب الكحولي)",
 "nesselrode pudding": "بودينغ نيسلرود (بودينغ مجمد غني مصنوع من الكستناء المفرومة وكرز الماراشينو والفواكه المسكرة والمشروب الكحولي)",
 "nest": "عُشّ / مَسْكَن (الموضع الذي يسكن فيه الإنسان بمعنى يُقيم؛ البَيْت أو الدار) / مُنْتَجَع / مَعْقَل (الملجأ والجبل المرتفع) / عَشَّشَ\nمثال: كان دوري كي أنظف المسكن",
