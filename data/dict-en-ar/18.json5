 "missy": "آنسة, شابة (أنثى شابة)\nمثال: شابة في الثامنة عشرة من عمرها",
 "mist": "سَدِيم",
 "mist-flower": "أجيراتوم, زهرة الضباب (نبات جذموري من وسط وجنوب شرق الولايات المتحدة وجزر الهند الغربية له رؤوس كبيرة مبهرجة من الزهور الزرقاء الصافية)",
 "mistakable": "قَابِلٌ لِلخَلْط, مُلْتَبِس (شديد الشبه بحيث يسهل الخلط بينه وبين شيء آخر)",
 "mistake": "أَسَاء اَلْفَهْم, أَخْطَأَ / خَطَأ, غَلْطَة (تعني ضدّ الصواب. يشمل ذلك الفعل، القول، والرأي. يُستخدم الفعل \"أخطأ\" للدلالة على عدم الإصابة…؛ قام بعمل بعيد عن الصواب أو مخالف للحق سواء كان ذلك في السلوك أو القول أو الكتابة)\nمثال: كان خطأ حاسوبي.",
 "mistaken": "خَاطِئ, مَبْنِيٌّ عَلَى غَلَط (نَاتِجٌ عَنْ خَطَأٍ أَوْ سُوءِ فَهْم) / مُخْطِئ, مُضَلَّل (خاطئ في الرأي أو الحُكم مثلاً)",
 "mistakenly": "خَطَأً (تعني ضدّ الصواب. يشمل ذلك الفعل، القول، والرأي. يُستخدم الفعل \"أخطأ\" للدلالة على عدم الإصابة…؛ قام بعمل بعيد عن الصواب أو مخالف للحق سواء كان ذلك في السلوك أو القول أو الكتابة)\nمثال: كان خطأ حاسوبي.",
 "mistaking": "سوء تفسير, سوء فهم (وضع تفسير خاطئ لشيء ما)\nمثال: تسبب سوء تفسيره للسؤال في خطئه",
 "mister": "سَيِّد, أُسْتَاذ",
 "mistflower": "أجيراتوم, زهرة الضباب (نبات جذموري من وسط وجنوب شرق الولايات المتحدة وجزر الهند الغربية له رؤوس كبيرة مبهرجة من الزهور الزرقاء الصافية)",
 "mistily": "بِشَكْل مُبْهَم, بِغُمُوض (بطريقة غامضة) / بضبابية (بطريقة ضبابية)\nمثال: بدا مألوفاً بشكل غامض",
 "mistiming": "خطأ في التوقيت, مفارقة تاريخية (شيء يقع في وقت لم يكن من الممكن أن يوجد أو يحدث فيه)",
 "mistiness": "تَبَخُّر, ضَبَابِيَّة (تغيم ناتج عن ضباب أو بخار)",
 "mistle thrush": "سمنة الدبق (سمنة أوروبية كبيرة تتغذى على توت الدبق)",
 "mistletoe": "دِبْق, نَبَات طُفَيْلِيّ (لصق أو التصق بشيء؛ التصق بشيء ولم يفارقه)",
 "mistletoe cactus": "صبار الدبق (نبات من جنس ريبساليس)",
 "mistletoe fig": "تين الهدال (شجيرة أو شجرة صغيرة تزرع غالباً كنبات منزلي لها أوراق تشبه الهدال)",
 "mistletoe rubber plant": "تين الهدال (شجيرة أو شجرة صغيرة تزرع غالباً كنبات منزلي لها أوراق تشبه الهدال)",
 "mistletoe thrush": "سمنة الدبق (سمنة أوروبية كبيرة تتغذى على توت الدبق)",
