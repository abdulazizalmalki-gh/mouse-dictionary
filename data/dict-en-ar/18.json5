 "natural action": "عملية طبيعية, فعل طبيعي (عملية موجودة في الطبيعة أو ناتجة عنها (بدلاً من نية البشر))\nمثال: فعل القوى الطبيعية",
 "natural childbirth": "ولادة طبيعية (المخاض والولادة بدون تدخل طبي؛ لا يتم إعطاء أي أدوية لتخفيف الألم أو المساعدة في عملية الولادة)\nمثال: تعتبر الولادة الطبيعية الأكثر أمانًا للطفل",
 "natural covering": "غِشَاء, غِطَاء (جسم طبيعي يغطي أو يغلف شيئاً ما)\nمثال: تحت غطاء من الغبار",
 "natural depression": "منخفض طبيعي (تكوين جيولوجي غائر أو منخفض)",
 "natural disaster": "كارثة طبيعية",
 "natural elevation": "ارتفاع طبيعي, مرتفع (تكوين جيولوجي مرتفع أو بارز)",
 "natural ems salt": "ملح إمس, ملح إمس الطبيعي (ملح ينتج من المياه المعدنية في باد إمس، ويستخدم كدواء لأمراض الجهاز التنفسي العلوي)\nمثال: الغرغرة بماء ملح إمس طريقة سريعة لعلاج الحلق المصاب بالعدوى",
 "natural enclosure": "حيز طبيعي مغلق, مكان مغلق (مساحة مغلقة بشكل طبيعي)",
 "natural endowment": "ملكة, موهبة (قدرات أو صفات طبيعية)",
 "natural event": "حَدَث طَبِيعِيّ, حُدُوث (حدث يقع بشكل طبيعيّ)",
 "natural family planning": "تنظيم الأسرة الطبيعي (أي من طرق تنظيم الأسرة التي لا تتضمن التعقيم أو أجهزة منع الحمل أو الأدوية؛ يتم تجنب الجماع خلال فترة الخصوبة في الدورة الشهرية للمرأة)",
 "natural fiber": "ألياف طبيعية (ألياف مشتقة من النباتات أو الحيوانات)",
 "natural fibre": "ألياف طبيعية (ألياف مشتقة من النباتات أو الحيوانات)",
 "natural gas": "غَاز طَبِيعِيّ",
 "natural glass": "زجاج طبيعي (صهارة بركانية بردت بسرعة كبيرة جداً)",
 "natural history": "تاريخ طبيعي (جملة الأَحوال والأحداث التي يمر بها كائن ما، ويَصْدق على الفرد والمجتمع، كما يَصْدق على الظواهر الطبيعية والإنسانية؛ هو تحديد الزمن باليَوْم والشَهْر والسَنَة أو ببعضهما. الأجَل أو الوَقْت)\nمثال: ما تاريخ اليوم؟",
 "natural immunity": "مناعة طبيعية, مناعة فطرية (مناعة ضد المرض تحدث كجزء من التكوين البيولوجي الطبيعي للفرد)",
 "natural language": "لُغَةْ طَبِيعِيَّة (هِيَ مجموعة من الأصوات التي يصدرها الإنسان على شكل كلمات منظمة بقواعد، ليتواصل به الناس وينقلون به الافكار والمعاني، اللسان؛ يقصد بها أحيانا اللهجة)\nمثال: الأمازيغية لغة.",
 "natural language processing": "مُعَالَجَة اللُّغَات الطَبِيعِيَّة",
 "natural language processing application": "معالج لغة طبيعية (برنامج تطبيقي يتعامل مع نصوص باللغة الطبيعية)",
 "natural language processor": "معالج لغة طبيعية (برنامج تطبيقي يتعامل مع نصوص باللغة الطبيعية)",
 "natural law": "شريعة, قانون (قاعدة أو مجموعة قواعد للسلوك متأصلة في الطبيعة البشرية وضرورية أو ملزمة للمجتمع البشري)",
 "natural logarithm": "لوغاريتم طبيعي",
 "natural number": "عَدَد طَبِيعِيّ (مِقْدَار مَا يُعَدّ)\nمثال: كم عدد سكان الجزائر؟",
 "natural object": "جِسْم طَبِيعِيّ (جسم موجود في الطبيعة؛ ليس من صنع الإنسان)",
 "natural order": "نِظَام طَبِيعِيّ (الكون المادي كمنظومة منظمة تخضع لقوانين طبيعية (وليست بشرية أو خارقة للطبيعة))",
 "natural phenomenon": "ظاهرة طبيعية (جميع الظواهر التي ليست اصطناعية)",
 "natural philosophy": "فيزياء (علم المادة والطاقة وتفاعلاتهما)\nمثال: مادته المفضلة كانت الفيزياء",
 "natural process": "عملية طبيعية, فعل طبيعي (عملية موجودة في الطبيعة أو ناتجة عنها (بدلاً من نية البشر))\nمثال: فعل القوى الطبيعية",
 "natural resin": "راتنج طبيعي (إفرازات نباتية)",
 "natural resource": "مَوْرِد طَبِيعِيّ",
 "natural resources": "موارد طبيعية (موارد (فعلية ومحتملة) توفرها الطبيعة)",
 "natural rubber": "مطاط, مطاط طبيعي (مادة مرنة يتم الحصول عليها من عصارة اللاتكس للأشجار (خاصة أشجار جنس الهيفيا والفيكس) والتي يمكن معالجتها بالكبريت وتشطيبها في مجموعة متنوعة من…)",
 "natural science": "علوم طبيعية (العلوم المعنية بدراسة العالم المادي وظواهره)",
 "natural scientist": "عالم تاريخ طبيعي, عالم طبيعة (عالم أحياء مطلع على التاريخ الطبيعي (خاصة علم النبات وعلم الحيوان))",
 "natural selection": "اِنْتِقَاءٌ طَبِيعِيّ",
 "natural shape": "شكل طبيعي (شكل ناتج عن قوى طبيعية؛ ليس من صنع الإنسان)",
 "natural spring": "عين, نبع (تدفق طبيعي للمياه الجوفية)",
 "natural state": "برية, حالة الطبيعة (حالة بدائية برية لم تمسها الحضارة)\nمثال: عاش في البرية",
 "natural theology": "اللاهوت الطبيعي (لاهوت يرى أن معرفة الله يمكن اكتسابها عن طريق العقل البشري دون مساعدة الوحي الإلهي)",
 "natural virtue": "فضيلة طبيعية ((الفلسفة المدرسية) واحدة من الفضائل الأربع (الحكمة، العدالة، الشجاعة، الاعتدال) المستمدة من الطبيعة)",
 "naturalisation": "تعريب, توطين (تغيير نطق كلمة مستعارة لتتوافق مع صوتيات المقترضين) / أقلمة, توطين (إدخال الحيوانات أو النباتات إلى أماكن تزدهر فيها ولكنها ليست موطناً أصلياً لها) / تجنيس (الإجراء الذي يتم بموجبه منح الأجنبي الجنسية) / تَأَقْلُم, تَطْبِيع (صفة الجلب إلى التوافق مع الطبيعة)\nمثال: توطين العديد من الكلمات الإيطالية في اللغة الإنجليزية",
 "naturalised": "مَزْرُوع طَبِيعِيًّا, مُتَجَنِّس (مزروع بحيث يعطي مظهر النمو البري الطبيعي)",
 "naturalism": "طبيعية ((فلسفة) المذهب القائل بأن العالم يمكن فهمه بمصطلحات علمية دون اللجوء إلى تفسيرات روحية أو خارقة للطبيعة) / الطبيعية, الواقعية (حركة فنية في فرنسا في القرن التاسع عشر؛ سعى الفنانون والكتاب للحصول على وصف واقعي وواقعي مفصل)",
 "naturalist": "عالم تاريخ طبيعي, عالم طبيعة (عالم أحياء مطلع على التاريخ الطبيعي (خاصة علم النبات وعلم الحيوان)) / طبيعاني, فيلسوف الطبيعة (مدافع عن العقيدة القائلة بأن العالم يمكن فهمه بالمصطلحات العلمية)",
 "naturalistic": "طَبِيعِيّ, وَاقِعِيّ (يمثل الواقع كما هو؛ ليس تجريدياً أو مثالياً)",
 "naturalization": "تعريب, توطين (تغيير نطق كلمة مستعارة لتتوافق مع صوتيات المقترضين) / أقلمة, توطين (إدخال الحيوانات أو النباتات إلى أماكن تزدهر فيها ولكنها ليست موطناً أصلياً لها) / تجنيس (الإجراء الذي يتم بموجبه منح الأجنبي الجنسية) / تَأَقْلُم, تَطْبِيع (صفة الجلب إلى التوافق مع الطبيعة)\nمثال: توطين العديد من الكلمات الإيطالية في اللغة الإنجليزية",
 "naturalized": "مُتَأَقْلِم, مُتَجَنِّس (أُدْخِلَ مِنْ مَنْطِقَةٍ أُخْرَى وَاسْتَمَرَّ فِي البَقَاءِ دُونَ زِرَاعَةٍ) / مَزْرُوع طَبِيعِيًّا, مُتَجَنِّس (مزروع بحيث يعطي مظهر النمو البري الطبيعي)",
 "naturally": "بالطبع, بطبيعة الحال (كما هو متوقع) / طبيعياً (وفقاً للطبيعة؛ بوسائل طبيعية؛ دون مساعدة اصطناعية) / بشكل طبيعي, بطبيعية (بطريقة طبيعية أو عادية) / بالفطرة, بطبعه (من خلال الطبيعة المتأصلة)\nمثال: بطبيعة الحال، أرسل لنا المحامي فاتورة ضخمة",
 "naturally occurring": "طَبِيعِيّ الوُجُود, مَوْجُود بِالطَّبِيعَة (موجود بالطبيعة ودون تدخّل اصطناعي)",
 "naturalness": "طَبِيعِيَّة, وَاقِعِيَّة (مماثلة التمثيل للشيء الممثل) / طَبِيعِيَّة, عَفْوِيَّة (صفة كون الشيء طبيعياً أو قائماً على مبادئ طبيعية) / بَرَاءَة, عَفْوِيَّة (صفة السذاجة البريئة)\nمثال: سعى المهندسون لزيادة طبيعية الموسيقى المسجلة",
 "nature": "طَبِيعَة, طبيعة",
 "nature reserve": "مَحْمِيَّة طَبِيعِيَّة",
 "nature study": "دراسة الطبيعة (دراسة الحيوانات والنباتات في العالم الطبيعي (عادة على مستوى ابتدائي))",
 "nature worship": "عبادة الطبيعة (نظام ديني يؤله ويعبد القوى والظواهر الطبيعية)",
 "naturism": "تعري, مذهب العري (البقاء بدون ملابس كممارسة اجتماعية)",
 "naturist": "عُرياني (شخص يمارس العري لأسباب صحية أو دينية)",
 "naturistic": "طبيعاني (متوافق مع مذهب العري أو الطبيعانية)",
 "naturopath": "معالج طبيعي (معالج يمارس العلاج الطبيعي (غير الدوائي))",
 "naturopathy": "علاج طبيعي, نعتالوباثي (طريقة لعلاج المرض باستخدام الغذاء والتمارين والحرارة لمساعدة عملية الشفاء الطبيعية)",
 "nauch": "رقص هندي, نوتش (رقصة تقليدية معقدة في الهند تؤديها راقصات محترفات)",
 "nauclea diderrichii": "أوبيبي, نوكليا (شجرة غابات أفريقية كبيرة تنتج خشباً أصفر قوياً صلباً إلى بني ذهبي؛ توضع أحياناً في جنس ساركوسيفالوس)",
 "naucrates ductor": "سمكة الدليل (سمكة صغيرة تعيش في عرض البحر ترافق غالباً أسماك القرش أو المانتا)",
 "naught": "عدم, لا شيء (فشل كامل) / صفر, عدم (كمية لا أهمية لها؛ شيء ليس له وجود)\nمثال: ذهبت كل جهودي سدى",
 "naughtily": "بشغب, بشكل سيء (بطريقة عاصية أو مشاغبة)\nمثال: تصرف بشكل سيء في المدرسة",
 "naughtiness": "شقاوة, مشاغبة (صفة للأطفال المشاغبين)",
 "naughty": "غَيْر مُطِيع, شَقِيّ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "naumachia": "معركة بحرية وهمية (استعراض بحري؛ معركة بحرية وهمية كان يقيمها الرومان القدماء)",
 "naumachy": "معركة بحرية وهمية (استعراض بحري؛ معركة بحرية وهمية كان يقيمها الرومان القدماء)",
 "naupathia": "داء البحر, دوار البحر (دوار الحركة الذي يحدث أثناء السفر في البحر)",
 "nauru": "نَاوْرُو",
 "nauruan": "ناوروي (من أو متعلق بجمهورية ناورو الجزيرية أو سكانها) / ناوري (مواطن أو ساكن في ناورو)",
 "nausea": "غَثْيَان (جاشت النفس واضطربت واستعدت للقَيء؛ الاِشْمِئْزَاز والقَرَف)\nمثال: كنت أشعر بالغثيان.",
 "nauseant": "دواء مقيئ, مقيئ (دواء يحفز الغثيان والقيء)",
