 "murkily": "بشكل خافت (بضوء خافت) / بعتمة, بغموض (بشكل غير واضح؛ بشكل معتم)\nمثال: غرفة مضاءة بشكل خافت",
 "murkiness": "تَغَيُّم, كُدْرَة (صفة كون الشيء غائماً) / ضباب, قتام (جو تنخفض فيه الرؤية بسبب سحابة من مادة ما)",
 "murky": "قَاتِم, مُعْكَر (مُظْلِم أَوْ كَئِيب) / عَكِر, مُتَكَدِّر (عكر بسبب الرواسب أو الترسّبات؛ يُقال عن السوائل)",
 "murmansk": "ميورمانسك",
 "murmur": "لَغَط, طَبْطَبَة / غَمْغَمَ, تَغَمْغَمَ",
 "murmur vowel": "صوت همس (شوا عارض لنطق صامت ما)",
 "murmuration": "تمتمة, غمغمة (صوت منخفض مستمر غير واضح؛ غالباً ما يكون مصحوباً بحركة الشفاه دون إنتاج كلام واضح)",
 "murmurer": "متمتم (شخص يتحدث بصوت خافت وغير واضح)",
 "murmuring": "خَرِير, هَامِس (يُصدر صوتاً مستمراً منخفضاً غير واضح) / تذمر, تمتمة (شكوى يتم التلفظ بها بنبرة منخفضة وغير واضحة) / تمتمة, غمغمة (صوت منخفض مستمر غير واضح؛ غالباً ما يكون مصحوباً بحركة الشفاه دون إنتاج كلام واضح)",
 "murmurous": "حَفِيف, هَمْهَمِيّ (يتميز بأصوات ناعمة وخافتة)",
 "murphy": "بطاطا, بطاطس (درنة صالحة للأكل موطنها أمريكا الجنوبية؛ طعام أساسي في أيرلندا)",
 "murphy bed": "سرير مورفي (قطعة أثاث للنوم والاستلقاء والجلوس؛ مسطبة من الخشب المزيَّن يوضع عليه كرسي، يغلب على ما تحت عرش الملك)\nمثال: قاس طول السرير.",
 "murphy's law": "قانون مورفي (بديهية فكاهية تنص على أن أي شيء يمكن أن يسير بشكل خاطئ سيسير بشكل خاطئ)",
 "murrain": "مَوْتَان",
 "murray": "مُورَاي",
 "murre": "مور (طائر غواص أبيض وأسود من البحار الشمالية)",
 "murshidabad": "مُرْشِدْ آبَاد, مُرْشِدْ أَبَاد (المُرْشِد : من يقوم بدور التَّوجيه والإرشاد؛ من يُساعد السُّفن بتعليماته لاجتياز القنوات أو للإرساء في المرافئ)\nمثال: كيف استطيع الحصول على مرشد سياحي.",
 "murtabak": "مطبق",
 "mus musculus": "فأر المنزل (فأر بني رمادي من العالم القديم أصبح الآن آفة منزلية شائعة في جميع أنحاء العالم)",
 "mus rose": "خبازة مسكية (نبات معمر قائم من العالم القديم بأوراق ذات رائحة مسك خفيفة وزهور بيضاء أو وردية)",
 "musa": "موسى (اسم شخصي معطًى لدى الذكور من المسلمين؛ حَادَّة من الحَدِيد تُسْتَخدم لحِلَاقَة الرَأْس أو الذِقْن)\nمثال: نحن المسلمون نؤمن بعيسى وموسى.",
 "musa acuminata": "موز قزم (شجرة موز آسيوية منخفضة النمو تزرع خاصة في جزر الهند الغربية لعناقيدها من الفاكهة الصفراء الصالحة للأكل)",
 "musa basjoo": "موز ياباني (نبات موز آسيوي يزرع خاصة كنبات ورقي في اليابان)",
 "musa ensete": "إنست, موز حبشي (عشب شجري دائم الخضرة كبير له أوراق ضخمة تشبه المجداف ويحمل ثماراً تشبه الموز غير صالحة للأكل ولكن براعم أزهاره الصغيرة صالحة للأكل؛ يوضع أحياناً في…)",
 "musa paradisiaca": "للسان الحمل, موز الجنة (شجرة موز تحمل عناقيد متدلية من الثمار النشوية الخضراء الزاوية الصالحة للأكل؛ المناطق الاستوائية وشبه الاستوائية)",
 "musa paradisiaca sapientum": "موز صالح للأكل (أنواع مزروعة على نطاق واسع من أشجار الموز تحمل عناقيد متدلية مدمجة من الفاكهة الصفراء الصالحة للأكل ذات الأهمية التجارية)",
 "musa textilis": "أباكا, قنب مانيلا (شجرة موز فلبينية تنتج أعناق أوراقها قنب مانيلا المستخدم للحبال والورق وما إلى ذلك)",
 "musalla": "مُصَلًّى (موضع الصلاة للشخص والجماعة؛ غرفة تخصص للصلاة في الأماكن العامّة، لا إمام فيها وهي دون المسجد)",
 "musca domestica": "ذبابة منزلية (ذبابة شائعة تتردد على مساكن البشر وتنشر العديد من الأمراض)",
 "musca volitans": "أجسام طافية, ذباب طائر (بقع أمام العينين تسببها شظايا خلايا معتمة في الجسم الزجاجي والعدسة)\nمثال: تبدو الأجسام الطافية وكأنها تنجرف عبر مجال الرؤية",
 "muscadel": "مسقط, نبيذ مسقط (نبيذ مصنوع من عنب المسقط)",
 "muscadelle": "مسقط, نبيذ مسقط (نبيذ مصنوع من عنب المسقط)",
 "muscadet": "مسكاديت (نبيذ أبيض جاف من وادي اللوار في فرنسا) / موسكاديت (عنب أبيض يزرع خاصة في وادي اللوار في فرنسا)",
 "muscadine": "عنب مسكدين (عنب أرجواني باهت في جنوب الولايات المتحدة) / عنب المسك, عنب المسكدين (عنب أصلي في جنوب شرق الولايات المتحدة؛ أصل للعديد من الأصناف المزروعة)",
 "muscae volitantes": "أجسام طافية, ذباب طائر (بقع أمام العينين تسببها شظايا خلايا معتمة في الجسم الزجاجي والعدسة)\nمثال: تبدو الأجسام الطافية وكأنها تنجرف عبر مجال الرؤية",
 "muscardinus avellanarius": "زغبة البندق (نوع من الزغبة)",
 "muscari comosum": "مسكاري شرابة, ياقوتية شرابة (نوع متوسطي كبير جميل له زهور بنفسجية مزرقة عقيمة بتويجات مهدبة تشكل خصلة فوق الزهور الخصبة)",
 "muscari neglectum": "مسكاري عنقودي شائع, ياقوتية عنبية (نوع غزير الإنتاج له زهور زرقاء داكنة جميلة بشكل خاص)",
 "muscat": "مَسْقَط (اسم مكان من السقوط؛ موضع السقوط عامّة؛ رأسه: عن المكان الذي وُلِد فيه. يُقصد بها الدولة أو المدينة لا المبنى)\nمثال: دفنت في مسقط رأسها.",
 "muscat grape": "عنب مسقط (عنب عطري حلو يستخدم للزبيب والنبيذ)",
 "muscatel": "عنب مسقط (عنب عطري حلو يستخدم للزبيب والنبيذ) / مسقط, نبيذ مسقط (نبيذ مصنوع من عنب المسقط)",
 "muscicapa grisola": "صائد الذباب المرقط (صائد ذباب غابات أوروبي شائع بريش بني رمادي)",
 "muscicapa striata": "صائد الذباب المرقط (صائد ذباب غابات أوروبي شائع بريش بني رمادي)",
 "muscivora forficata": "صائد الذباب مقصي الذيل (صائد ذباب رمادي من جنوب غرب الولايات المتحدة والمكسيك وأمريكا الوسطى له ذيل طويل متشعب وصدر أبيض وعلامات بلون السلمون والقرمزي)",
 "muscle": "عَضَلَة / قُوَّة (ضد الضُعْف، الشِدَّة والقُدْرَة الجِسْمَانِيَّة؛ ضد الضُعْف، المَقْدِرَة والحَوْل والتَمَكُّن، القدرة المعنوية)\nمثال: توم شعر بالقوة.",
 "muscle builder": "بَنَّاء عَضَلَات, لَاعِب كَمَال أَجْسَام (شخص يقوم بتمارين خاصة لتنمية عضلات قوية)",
 "muscle building": "بناء العضلات, تمرين لاهوائي (تمرين يبني العضلات من خلال التوتر والمقاومة)",
 "muscle cell": "خلية عضلية, ليف عضلي (خلية متطاولة قابلة للانقباض تشكل عضلات الجسم)",
 "muscle contraction": "انقباض, تقلص عضلي ((فسيولوجيا) تقصير أو توتر جزء أو عضو (خاصة العضلة أو الألياف العضلية))",
 "muscle fiber": "خلية عضلية, ليف عضلي (خلية متطاولة قابلة للانقباض تشكل عضلات الجسم)",
 "muscle fibre": "خلية عضلية, ليف عضلي (خلية متطاولة قابلة للانقباض تشكل عضلات الجسم)",
 "muscle memory": "ذَاكِرَة عَضَلِيَّة",
 "muscle relaxant": "مرخي عضلات (عقار يقلل من انقباض العضلات عن طريق منع انتقال النبضات العصبية أو عن طريق تقليل استثارة الصفيحة الانتهائية الحركية أو عن طريق إجراءات أخرى)",
 "muscle sense": "إحساس حركي, حاسة العضلات (القدرة على الشعور بحركات الأطراف والجسم)",
 "muscle spasm": "تشنج, تقلص عضلي (انقباض عضلي مؤلم وغير إرادي)",
 "muscle system": "بنية عضلية, جهاز عضلي (الجهاز العضلي لكائن حي)",
 "muscle tone": "توتر العضلات (التوترية الطبيعية للعضلات)\nمثال: الرياضة تحسن توتر العضلات",
 "muscle woman": "امرأة مفتولة العضلات, بلطجية (امرأة متنمرة تُستخدم كبلطجية أو حارسة شخصية)",
 "muscle-bound": "مُتَصَلِّبُ العَضَلَات (ذُو عَضَلَاتٍ مُتَصَلِّبَةٍ نَتِيجَةَ الإِفْرَاطِ فِي التَّمَارِينِ)",
 "muscle-builder": "بَنَّاء عَضَلَات, لَاعِب كَمَال أَجْسَام (شخص يقوم بتمارين خاصة لتنمية عضلات قوية)",
 "musclebuilder": "بَنَّاء عَضَلَات, لَاعِب كَمَال أَجْسَام (شخص يقوم بتمارين خاصة لتنمية عضلات قوية)",
 "musclebuilding": "بناء العضلات, تمرين لاهوائي (تمرين يبني العضلات من خلال التوتر والمقاومة)",
 "muscleman": "كمال أجسام, مفتول العضلات (رجل يقوم بتمارين خاصة لتطوير عضلات قوية) / بلطجي, حارس مفتول العضلات (متنمر ذكر يُستخدم كبلطجي أو حارس شخصي)",
 "musclewoman": "امرأة مفتولة العضلات, بلطجية (امرأة متنمرة تُستخدم كبلطجية أو حارسة شخصية) / لاعبة كمال أجسام (امرأة تقوم بتمارين خاصة لتطوير عضلات قوية)",
 "muscovite": "مُوسْكُوفِيّ",
 "muscovy duck": "بطة مسكية (بطة برية متوجة كبيرة من أمريكا الوسطى والجنوبية؛ مستأنسة على نطاق واسع)",
 "muscular": "عَضَلِيّ",
 "muscular contraction": "انقباض, تقلص عضلي ((فسيولوجيا) تقصير أو توتر جزء أو عضو (خاصة العضلة أو الألياف العضلية))",
 "muscular dystrophy": "حثل عضلي, ضمور العضلات (أي من العديد من الأمراض الوراثية للجهاز العضلي التي تتميز بضعف وهزال العضلات الهيكلية)",
 "muscular structure": "بنية عضلية, جهاز عضلي (الجهاز العضلي لكائن حي)",
 "muscular tissue": "نسيج عضلي (نسيج حيواني يتكون بشكل رئيسي من خلايا منقبضة)",
 "muscular tonus": "توتر العضلات (التوترية الطبيعية للعضلات)\nمثال: الرياضة تحسن توتر العضلات",
 "muscularity": "حيوية, طاقة (أسلوب حيوي خيالي (خاصة أسلوب الكتابة)) / فتوة, قوة عضلية (امتلاك قوة عضلية) / بنية عضلية, عضلية (الحالة الفسيولوجية لامتلاك العضلات أو تكون الجسم منها)\nمثال: تنقل كتابته طاقة كبيرة",
 "musculature": "بنية عضلية, جهاز عضلي (الجهاز العضلي لكائن حي)",
 "musculocutaneous": "العضلي الجلدي",
 "musculophrenic artery": "شريان عضلي حجابي (شريان يغذي البطن والعضلات الوربية)",
 "musculophrenic vein": "وريد عضلي حجابي (أوردة تصرف جدار البطن العلوي والمسافات الوربية السفلية والبطن)",
 "musculoskeletal": "عضلي هيكلي (متعلق بالعضلات والهيكل العظمي)",
 "musculoskeletal system": "الجهاز العضلي الهيكلي (نظام العضلات والأوتار والأربطة والعظام والمفاصل والأنسجة المرتبطة بها التي تحرك الجسم وتحافظ على شكله)",
 "musculospiral nerve": "عصب كعبري (أكبر فرع من الضفيرة العضدية؛ يمتد أسفل العضد إلى اللقيمة الوحشية حيث ينقسم إلى فرع يذهب إلى الجلد على ظهر اليد وآخر يذهب إلى العضلات الباسطة التحتية)",
 "musculus": "عضلة (أحد الأعضاء المنقبضة في الجسم)",
 "musculus abductor digiti minimi manus": "مبعدة خنصر اليد (العضلة المبعدة للإصبع الصغير لليد)",
 "musculus abductor digiti minimi pedis": "مبعدة خنصر القدم (العضلات المبعدة لإصبع القدم الصغير)",
 "musculus abductor hallucis": "مبعدة إبهام القدم (العضلة المبعدة لإبهام القدم)",
 "musculus abductor pollicis": "مبعدة إبهام اليد (العضلة المبعدة لإبهام اليد)",
 "musculus adductor brevis": "مقربة قصيرة (العضلة المقربة القصيرة للفخذ)",
 "musculus adductor hallucis": "مقربة إبهام القدم (العضلة المقربة لإبهام القدم)",
 "musculus adductor longus": "مقربة طويلة (العضلة المقربة الطويلة للفخذ)",
 "musculus adductor magnus": "مقربة كبيرة (العضلة التي تقرب وتمد الفخذ)",
 "musculus anconeus": "عضلة مرفقية (العضلة التي تمد الساعد وتبعد الزند في كب المعصم)",
 "musculus articularis cubiti": "مفصلية المرفق (فرع صغير من العضلة ثلاثية الرؤوس يرتكز في محفظة مفصل الكوع)",
 "musculus articularis genus": "مفصلية الركبة (العضلة المفصلية للركبة)",
 "musculus biceps brachii": "عضدية ثنائية الرؤوس (عضلة تثني وتكب الساعد)",
 "musculus biceps femoris": "فخذية ثنائية الرؤوس (العضلة ثنائية الرؤوس للفخذ؛ تثني الركبة وتدير الساق وحشياً)",
 "musculus buccinator": "عضلة مبوقة (عضلة تسطح الخد وتسحب زاوية الفم)",
 "musculus deltoideus": "عضلة دالية (عضلة مثلثة كبيرة تغطي مفصل الكتف وتعمل على إبعاد وثني ومد وتدوير الذراع)",
 "musculus intercostalis": "عضلة بين الضلوع, عضلة ورقية (عضلات بين الأضلاع؛ تنقبض أثناء الشهيق)",
 "musculus obliquus externus abdominis": "منحرفة خارجية (عضلة بطنية مرتبة بشكل قطري على جانبي الجذع)",
 "musculus pectoralis": "عضلة صدرية (إحدى عضلتين كبيرتين في الصدر)",
 "musculus pectoralis major": "صدرية كبرى (عضلة هيكلية تقرب الذراع وتديرها)",
 "musculus pectoralis minor": "صدرية صغرى (عضلة هيكلية تسحب لوح الكتف لأسفل أو ترفع الأضلاع)",
 "musculus quadriceps femoris": "عضلة رباعية الرؤوس (عضلة في الفخذ تمد الساق)",
 "musculus rhomboideus major": "معينية كبرى (عضلة معينية تسحب لوح الكتف باتجاه العمود الفقري)",
 "musculus rhomboideus minor": "معينية صغرى (عضلة معينية تسحب لوح الكتف باتجاه العمود الفقري وإلى الأعلى قليلاً)",
 "musculus sartorius": "عضلة خياطية (عضلة في الفخذ تساعد على تدوير الساق في وضع الجلوس الذي يتخذه الخياط؛ أطول عضلة في جسم الإنسان)",
 "musculus scalenus": "عضلة أخمعية (أي من أربعة أزواج من العضلات تمتد من الفقرات العنقية إلى الضلع الثاني؛ تشارك في تحريك الرقبة وفي التنفس)",
 "musculus serratus anterior": "منشارية أمامية (عضلات تدير لوح الكتف وترفع القفص الصدري)",
 "musculus serratus posterior": "منشارية خلفية (عضلة هيكلية تسحب القفص الصدري للخلف وللأسفل)",
 "musculus sphincter ani": "مصرة الشرج (العضلة العاصرة للشرج)",
 "musculus sphincter ani externus": "مصرة شرجية خارجية (حلقة خارجية من العضلات المخططة تحيط بالشرج)",
 "musculus sphincter ani internus": "مصرة شرجية داخلية (حلقة داخلية من العضلات الملساء تتكون من ألياف دائرية للمستقيم)",
 "musculus sphincter ductus choledochi": "مصرة القناة الصفراوية (العضلة العاصرة الملساء للقناة الصفراوية المشتركة)",
 "musculus sphincter ductus pancreatici": "مصرة القناة البنكرياسية (العضلة العاصرة الملساء للقناة البنكرياسية الرئيسية)",
 "musculus sphincter pupillae": "مصرة الحدقة (حلقة من العضلات الملساء تحيط بالقزحية)",
 "musculus sphincter pylori": "مصرة البواب (العضلة العاصرة للبواب التي تفصل المعدة عن الاثني عشر)",
 "musculus sphincter urethrae": "مصرة الإحليل (عضلة عاصرة مخططة تضيق الإحليل)",
 "musculus sphincter vesicae": "مصرة المثانة (العضلة العاصرة للمثانة البولية؛ تتكون من طبقة عضلية سميكة للمثانة حول فتحة الإحليل)",
 "musculus sternocleidomastoideus": "عضلة قترائية (واحدة من عضلتين سميكتين تمتدان من القص والترقوة إلى الخشاء والعظم القذالي؛ تدير الرأس بشكل مائل إلى الجانب المعاكس؛ عند العمل معاً تثنيان الرقبة…)",
 "musculus temporalis": "عضلة صدغية (عضلة تمتد من الحفرة الصدغية إلى الناتئ المنقاري للفك السفلي؛ تعمل على رفع الفك السفلي وإغلاق الفكين)",
