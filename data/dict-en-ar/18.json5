 "modern ballet": "باليه حديث (أسلوب من الباليه يسمح بمجموعة أوسع من الحركات)",
 "modern dance": "رقص حديث (أسلوب من الرقص المسرحي ليس مقيداً مثل الباليه الكلاسيكي؛ حيث تكون الحركات معبرة عن المشاعر)",
 "modern english": "الإنجليزية الحديثة (الإنجليزية منذ حوالي 1450)",
 "modern era": "العصر الحديث (الأوقات الحالية أو الحديثة)",
 "modern font": "بودوني, خط حديث (نمط خط (يعتمد على تصميم من القرن الثامن عشر لجيانباتيستا بودوني) يتميز بشكل منتظم وزوائد شعرية وخطوط عمودية ثقيلة)",
 "modern greek": "اللُّغَةُ الْيُونَانِيَّةُ الْحَدِيثَة",
 "modern greek language": "اليونانية الحديثة (اللغة اليونانية كما يتم التحدث بها وكتابتها اليوم)",
 "modern hebrew": "العبرية الحديثة (العبرية المستخدمة في إسرائيل اليوم؛ تم إحياؤها من العبرية القديمة)",
 "modern hebrew language": "العبرية الحديثة (العبرية المستخدمة في إسرائيل اليوم؛ تم إحياؤها من العبرية القديمة)",
 "modern jazz": "جاز جديد, جاز حديث (أي من أساليب الجاز المختلفة التي ظهرت بعد عام 1940)",
 "modern man": "إنسان حديث (نويع من الإنسان العاقل؛ يشمل جميع الأعراق الحديثة)",
 "modern standard arabic": "الْفُصْحَى, فُصْحَى الْعَصْر",
 "modern times": "الأوقات المعاصرة, العصر الحديث (ظروف وأفكار العصر الحالي)\nمثال: في أوقات حديثة كهذه",
 "modern world": "الأوقات المعاصرة, العصر الحديث (ظروف وأفكار العصر الحالي)\nمثال: في أوقات حديثة كهذه",
 "modern-day": "حَدِيثُ العَصْر, مُعَاصِر (يَتَّسِمُ بِخَصَائِصِ العَصْرِ الحَالِي)",
 "moderne": "مُودِيرْن (مُتَعَلِّقٌ بِأُسْلُوبِ آرْت دِيكُو الشَّعْبِيِّ ذِي الأَلْوَانِ الزَّاهِيَة)",
 "modernisation": "تحديث, عصرنة (جعل الشيء حديثاً في المظهر أو السلوك)\nمثال: تحديث نيجيريا سيكون عملية طويلة",
 "modernised": "عُصْرِن, مُحَدَّث (تمّ تحديثه وجعله مواكبًا للعصر)",
 "modernism": "حداثة, عصرنة (ممارسات نموذجية للحياة أو الفكر المعاصر) / حداثة (نوع من الفن والأدب يُحدث قطيعة واعية مع الأنواع السابقة) / حداثة, عصرية (صفة كونه حالياً أو من الحاضر)\nمثال: مركز تسوق سيغرس روح الحداثة في هذه القرية",
 "modernist": "حداثي, فنان حداثي (فنان يُحدث قطيعة متعمدة مع الأنماط السابقة)",
 "modernistic": "حَدِيث, عَصْرِيّ (مُتَعَلِّق بِمُوضَة أَوْ أُسْلُوب تَمَّ تَطْوِيرُه حَدِيثًا)",
 "modernity": "حَدَاثَة",
 "modernization": "تَحْدِيث (حَدَّث الشّخصُ:روى حديث الرّسول -صلّى الله عليه وسلّم-،حدّثه الشّخصُ:أخبره وتكلّم إليه،حدّثه قلبه:أعلمه،أحسّ مسبقاً بشيء،حدّث الشيء:جعله حديثاً،جدّده؛ حدّث بالنّعمة:أشاعها وشكر عليها)\nمثال: تم تحديث القاموس.",
 "modernized": "عُصْرِن, مُحَدَّث (تمّ تحديثه وجعله مواكبًا للعصر)",
 "modernness": "حداثة, عصرية (صفة كونه حالياً أو من الحاضر)\nمثال: مركز تسوق سيغرس روح الحداثة في هذه القرية",
 "modest": "مُتْوَاضِع / مُحْتَشِم",
 "modestly": "بِتَوَاضُع (مع التواضع؛ بطريقة متواضعة)\nمثال: كان عنوان الأطروحة بتواضع 'ملاحظات حول مسرحية لشكسبير'",
 "modestness": "تواضع (الخلو من الغرور أو العجب) / اعتدال, تواضع (خاصية الاعتدال في السعر أو النفقات)\nمثال: يشتهر المتجر باعتدال أسعاره",
 "modesty": "تَوَاضُع / حِشْمَة",
 "modicon": "موديكون (اسم تجاري لمانع حمل فموي يحتوي على استراديول ونوريثيندرون)",
 "modicum": "نَزْر",
 "modifiable": "قَابِل لِلتَّعْدِيل (قادر على أن يُعدل في الشكل أو الشخصية أو القوة (خاصة بجعله أقل تطرفاً))\nمثال: إيقاع الوقت الفسيولوجي غير قابل للتعديل إلا عن طريق التدخل في عمليات أساسية معينة",
 "modification": "تَعْدِيل",
 "modified": "محور, معدل (مُغيّر في الشكل أو الطابع) / مَحْدُود, مُتَوَسِّط (متوسّط المستوى؛ ليس مطلقًا)\nمثال: موقفهم المعدل جعل القضية أكثر قبولاً",
 "modified american plan": "خطة أمريكية معدلة, نصف إقامة (خطة فندقية تشمل الإفطار والعشاء (ولكن ليس الغداء))",
 "modified harvard architecture": "معمارية هارفارد المعدلة (نسخة مغايرة من معمارية هارفارد للحاسوب تسمح بالوصول إلى محتويات ذاكرة التعليمات وكأنها بيانات)\nمثال: معظم الحواسيب الحديثة الموثقة كمعمارية هارفارد هي في الواقع معمارية هارفارد المعدلة",
 "modified radical mastectomy": "استئصال الثدي الجذري المعدل (إزالة الثدي والعضلة الصدرية الصغيرة وبعض العقد الليمفاوية في الإبط المجاور)",
 "modifier": "جين معدل (جين يعدل التأثير الذي ينتجه جين آخر) / معدِّل, مُقَيِّد (كلمة محتوى تقيد أو تصف معنى اسم أو فعل) / مُعَدِّل, مُغَيِّر (شخص يغير شيئاً ما) / معدّل (مهدئ يجعل الأمور أقل تطرفًا أو تعنتًا)\nمثال: مغير دائم لقائمة الطعام",
 "modifier gene": "جين معدل (جين يعدل التأثير الذي ينتجه جين آخر)",
 "modillion": "دعامة زخرفية, موديليون ((في العمارة) واحدة من مجموعة من الدعامات الزخرفية تحت الكورنيش)",
 "modiolus": "عميد, محور القوقعة (العمود العظمي المخروطي المركزي للقوقعة)",
 "modish": "رَائِج, عَلَى المُوضَة (وَفْقًا لِلمُوضَة أَوِ الأُسْلُوب السَّائِد حَالِيًّا)",
 "modishly": "بأناقة, على الموضة (بطريقة عصرية وأنيقة)\nمثال: كان يرتدي ملابس أنيقة",
 "modishness": "أَنَاقَة عَصْرِيَّة, شِيَاكَة (الأناقة بحكم مسايرة الموضة)",
 "modiste": "خياطة (امرأة تصنع أو تصلح الفساتين) / صانع قبعات, قبعاتي (شخص يصنع ويبيع القبعات)",
 "mods": "مودس (ثقافة فرعية شبابية بدأت في لندن في أوائل الستينيات؛ حركة للطبقة العاملة بملابس منمقة للغاية وشعر قصير؛ استمعوا إلى موسيقى الريثم أند بلوز وسافروا على…)",
 "modular": "تَرْكِيبِيّ, وَحْدَوِيّ (مُصمَّم بوحدات أو أبعاد موحدة تتيح المرونة والتنوع في الاستخدام)",
 "modulated": "مُعَدَّلُ النَّغْمَة, مُنَغَّم (تَمَّ تَعْدِيلُ حَجْمِهِ وَنَغْمَتِهِ وَطَبَقَتِهِ الصَّوْتِيَّة) / معدل النغمة, منغم (مُغيّر أو مُعدل في الطبقة الصوتية أو النبرة أو الحجم)",
 "modulation": "تحوير",
 "module": "وَحْدَة",
 "modulus": "مُعَامِل, مِعْيَار ((في الفيزياء) معامل يعبر عن مقدار امتلاك مادة معينة لخاصية محددة) / قِيمَة مُطْلَقَة, مِعْيَار (القيمة المطلقة لعدد مركب) / قَاسِم الْمِعْيَار, مِعْيَار (عدد صحيح يمكن قسمة الفرق بين عددين آخرين عليه بدون باقي (في الحساب المقياسي))\nمثال: 2 هو معيار للعددين 5 و 9",
 "modulus of elasticity": "مُعَامِل الْمُرُونَة, مِعْيَار الْمُرُونَة ((في الفيزياء) نسبة الإجهاد المطبق إلى التغير في شكل جسم مرن)",
 "modulus of rigidity": "مُعَامِل الصَّلَابَة, مُعَامِل القَصّ (معامل المرونة لقوة القص)",
 "modus operandi": "روتين, طريقة عمل (طريقة أو إجراء ثابت أو معتاد)",
 "modus vivendi": "أسلوب حياة, نمط حياة (طريقة للعيش تعكس قيم الشخص ومواقفه) / تسوية مؤقتة, وضع مؤقت (تسوية مؤقتة لخلاف بين الأطراف ريثما يتم التوصل إلى تسوية دائمة)",
 "moebius syndrome": "داء موبيوس",
 "moehringia lateriflora": "موهرنجيا جانبية الزهر (عشب منخفض النمو له عناقيد من الزهور البيضاء الصغيرة رباعية البتلات)",
 "moehringia mucosa": "موهرنجيا مخاطية (نبات متشابك بشكل رخو بأوراق تشبه الطحالب مرصعة بزهور بيضاء دقيقة رباعية البتلات تشبه النجوم؛ جبال وسط وجنوب أوروبا)",
 "moeller's glossitis": "التهاب اللسان لمولر (شكل سطحي من التهاب اللسان يتميز ببقع حمراء غير منتظمة على اللسان وحساسية للطعام الساخن أو الحار)",
 "mogadishu": "مَقَدِيشُو, مَقْدِيشُو (مدينة في الصومال، وهي عاصمتها، وتقع في محافظة بنادر)",
 "mogdad coffee": "سنا القهوة, عشبة منتنة (شجيرة استوائية مورقة جداً كريهة الرائحة استخدمت بذورها كمغشوش للقهوة؛ تصنف أحياناً في جنس كاسيا)",
 "mogen david": "خاتم سليمان, نجمة داود (نجمة سداسية مكونة من مثلثين متساويي الأضلاع)",
 "moghul": "مَغُول",
 "mogilev": "مُوغِيلْيُوف",
 "mogul": "إمبراطور مالي, بارون (رجل أعمال ثري جداً أو قوي النفوذ) / مغولي (عضو في السلالة المسلمة التي حكمت الهند حتى عام 1857) / حدبة تزلج, موجول (نتوء أو حدبة في منحدر التزلج)\nمثال: بارون نفط",
 "mogul empire": "إمبراطورية المغول (إمبراطورية أسسها الغزاة المغول في الهند وحكمت من 1526 إلى 1857)",
 "mogul sauce": "صلصة المغول (صلصة تشبه صلصة ورسيستيرشاير تستخدم للحم)",
 "mohair": "موهير (قماش مصنوع بخيوط من شعر ماعز الأنجورا الحريري)",
 "mohammedan": "محمدي",
 "mohammedan calendar": "تقويم إسلامي, تقويم هجري (التقويم القمري الذي يستخدمه المسلمون؛ يؤرخ من عام 622 م (عام الهجرة)؛ وتتراجع بداية السنة الإسلامية خلال السنة الشمسية مكملة الدورة كل 32 عاماً)",
 "mohammedanism": "إسلام (النظام الديني التوحيدي للمسلمين الذي تأسس في شبه الجزيرة العربية في القرن السابع ويقوم على تعاليم محمد كما وردت في القرآن)\nمثال: الإسلام أسلوب حياة كامل، وليس دين يوم الأحد فقط",
 "moharram": "المحرم (الشهر الأول من التقويم الهجري)",
 "mohatra": "مخاطرة",
 "mohave": "لغة موهافي (اللغة اليومية التي يتحدث بها شعب موهافي) / موهافي (فرد من شعب الهنود في أمريكا الشمالية كان يعيش سابقاً في وادي نهر كولورادو في أريزونا ونيفادا وكاليفورنيا)",
 "mohave language": "لغة موهافي (اللغة اليومية التي يتحدث بها شعب موهافي)",
 "mohawk": "مُوهُوك",
 "mohawk haircut": "قَصَّة المُوهُوك (قصة شعر يحلق فيها الرأس ما عدا شريط من الشعر وسط فروة الرأس)",
 "mohawk language": "لغة الموهوك (اللغة الإيروكوية التي يتحدث بها شعب الموهوك)",
 "mohican": "لغة الموهيكان, ماهيكان (لغة ألغونكوية يتحدث بها شعب الموهيكان) / موهيكان (فرد من شعب ألغونكي عاش سابقاً في وادي هدسون وشرقاً حتى نهر هوساتونيك)",
 "mohican language": "لغة الموهيكان, ماهيكان (لغة ألغونكوية يتحدث بها شعب الموهيكان)",
 "mohria caffrorum": "سرخس معطر (سرخس أفريقي حلو الرائحة بسعف ريشي مزدوج ضيق)",
 "mohs scale": "مقياس موس (مقياس لصلابة المواد الصلبة)",
 "moiety": "شطر, نصف عشيرة (أحد التقسيمين الفرعيين الأساسيين للقبيلة) / شَطْر, نِصْف (واحد من جزأين متساويين (تقريباً))",
 "moirae": "مويراي (أي من إلهات القدر أو المصير الثلاث اليونانيات؛ يتماهين مع باركاي الرومانية ويشبهن نورن الإسكندنافية)",
 "moirai": "مويراي (أي من إلهات القدر أو المصير الثلاث اليونانيات؛ يتماهين مع باركاي الرومانية ويشبهن نورن الإسكندنافية)",
 "moire": "مُمَوَّج, مُمَوَّه ((في الحرير) ذو نقش موجيّ متماوج) / حرير متموج, مواريه (قماش حريري بنمط سطح متموج)",
 "moist": "رَطِب, بَلّ (يحتوي على الماء أو الرطوبة، غير جاف؛ لين أو طري الملمس بسبب وجود الرطوبة)\nمثال: ملابسي رطبة ومليئة في التراب علي تبديلها.",
 "moistener": "مبلل, مرطّب (جهاز يقوم بترطيب أو تبيليل شيء ما)\nمثال: استخدم مرطباً لتبليل القمصان قبل كيها",
 "moistening": "ترطيب, تندية (فعل جعل الشيء رطباً قليلاً)",
 "moistly": "بِتَبَلُّل, بِرُطُوبَة (بطريقة رطبة)\nمثال: كان هناك وشاح مربوط حول رأسها لكن الخصلة المتمردة هربت وتدلت برطوبة فوق عينها اليسرى",
 "moistness": "رطوبة, نداوة (بلل خفيف)",
 "moisture": "رُطُوبَة",
 "moisturising cream": "مَرْطَب",
 "moisturize": "رَطَّبَ (يحتوي على الماء أو الرطوبة، غير جاف؛ لين أو طري الملمس بسبب وجود الرطوبة)\nمثال: ملابسي رطبة ومليئة في التراب علي تبديلها.",
 "mojarra": "موجارا (أسماك صغيرة فضية تعيش في أسراب ذات أفواه قابلة للامتداد توجد في المياه الساحلية الدافئة)",
 "mojave": "لغة موهافي (اللغة اليومية التي يتحدث بها شعب موهافي) / موهافي (فرد من شعب الهنود في أمريكا الشمالية كان يعيش سابقاً في وادي نهر كولورادو في أريزونا ونيفادا وكاليفورنيا)",
 "mojave aster": "أستر موهافي (أستر بري له سيقان ورقية رمادية ورؤوس زهرية بأشعة خزامية باهتة أو بنفسجية ضيقة؛ المنحدرات الصحراوية الصخرية من كاليفورنيا إلى أريزونا ويوتا)",
 "mojave language": "لغة موهافي (اللغة اليومية التي يتحدث بها شعب موهافي)",
 "mojave rattlesnake": "أفعى موهافي الجرسية (خطيرة للغاية؛ أكثر شيوعاً في مناطق النمو الشجيري المتناثر؛ من صحراء موهافي إلى غرب تكساس وإلى المكسيك)",
 "mojibake": "مُوجِيبَاكِي",
 "mojito": "مُوخِيتُو",
 "mojo": "تعويذة, سحر (قوة سحرية أو تعويذة سحرية)",
 "moke": "حمار (مصطلح بريطاني غير رسمي للحمار)",
 "mokosh": "مُوكُوش",
 "moksa": "انعتاق, موكشا ((في الهندوسية) التحرر من دورة الولادة الجديدة)",
 "mokulu": "موكولو (لغة تشادية يتم التحدث بها في تشاد، في منطقة غويرا)",
 "mokulu language": "موكولو (لغة تشادية يتم التحدث بها في تشاد، في منطقة غويرا)",
 "mol": "مول (الوزن الجزيئي لمادة معبراً عنه بالغرامات؛ الوحدة الأساسية لكمية المادة في النظام الدولي للوحدات)",
 "mola": "سمكة شمس المحيط, مولا (من بين أكبر الأسماك العظمية؛ سمكة تعيش في عرض البحر ذات جسم بيضاوي مضغوط وزعانف ظهرية وشرجية عالية وزعنفة ذيلية مختزلة إلى فص يشبه الدفة؛ توجد…)",
 "mola lanceolata": "مولا حادة الذيل (الزعنفة الذيلية لها نتوء مركزي)",
 "molal": "مولالي (يشير إلى محلول يحتوي على مول واحد من المذاب لكل كيلوغرام من المذيب)",
 "molal concentration": "تركيز مولالي, مولالية (التركيز مقاساً بعدد مولات المذاب لكل كيلوغرام من المذيب)",
 "molality": "تركيز مولالي, مولالية (التركيز مقاساً بعدد مولات المذاب لكل كيلوغرام من المذيب)",
 "molar": "ضِرْس",
 "molar concentration": "تركيز مولاري, مولارية (التركيز مقاساً بعدد مولات المذاب لكل لتر من المحلول)",
