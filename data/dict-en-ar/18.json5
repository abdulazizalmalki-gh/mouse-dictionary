 "monandry": "اكتفاء بزوج واحد (حالة وجود زوج واحد فقط في المرة الواحدة)",
 "monarch": "عَاهِل",
 "monarch butterfly": "فراشة الصقلاب, فراشة الملك (فراشة أمريكية مهاجرة كبيرة لها أجنحة برتقالية عميقة بعلامات سوداء وبيضاء؛ تتغذى اليرقات على الصقلاب)",
 "monarchal": "مَلَكِيّ (يَحْكُمُهُ مَلِكٌ أَوْ تَكُونُ فِيهِ السُّلْطَةُ العُلْيَا بِيَدِ المَلِك) / مَلَكِيّ الطَّابِع, مُونَارْكِيّ (ذو خصائص تليق بالعاهل أو تستحقه)",
 "monarchic": "مَلَكِيّ (يَحْكُمُهُ مَلِكٌ أَوْ تَكُونُ فِيهِ السُّلْطَةُ العُلْيَا بِيَدِ المَلِك)",
 "monarchical": "مَلَكِيّ (يَحْكُمُهُ مَلِكٌ أَوْ تَكُونُ فِيهِ السُّلْطَةُ العُلْيَا بِيَدِ المَلِك) / مَلَكِيّ الطَّابِع, مُونَارْكِيّ (ذو خصائص تليق بالعاهل أو تستحقه)",
 "monarchism": "ملكية (الإيمان بالملكية كنظام سياسي والدعوة إليها)",
 "monarchist": "ملكي (مدافع عن مبادئ الملكية)",
 "monarchy": "مَلِكِيَّة",
 "monarda": "برغموت بري, موناردا",
 "monarda citriodora": "مونردة ليمونية, نعناع ليموني (نبات حولي من وسط وغرب الولايات المتحدة وشمال المكسيك)",
 "monarda clinopodia": "بلسم الريحان (عشب معمر من أمريكا الشمالية (من نيويورك إلى إلينوي وجبال ألاسكا) له أوراق عطرية وعناقيد من الكرات الوردية المصفرة)",
 "monarda didyma": "شاي أوسويغو, مونردة مزدوجة (عشب عطري معمر من شرق أمريكا الشمالية له زهور أنبوبية بألوان مختلفة في رؤوس بارزة كثيفة)",
 "monarda fistulosa": "بلسم النحل, مونردة أنبوبية (عشب معمر من أمريكا الشمالية)",
 "monarda pectinata": "مونردة السهول الليمونية (نبات حولي من جنوب الولايات المتحدة)",
 "monarda punctata": "مونردة منقطة (نبات معمر أو حولي منتصب طويل له أوراق رمحية ورؤوس من الزهور الكريمية المرقطة بالأرجواني؛ تزرع العديد من سلالاته من شرق إلى جنوب غرب الولايات المتحدة…)",
 "monardella lanceolata": "مونارديلا, نعناع موستانج (عشب حولي عطري في كاليفورنيا له أوراق رمحية وعناقيد من الزهور الوردية الأرجوانية)",
 "monario": "موناريو (لغة مصطنعة أنشأها ألدو لافانييني)",
 "monas": "جَوْهَر فَرْد, مُونَاد (كيان ميتافيزيقي متفرد يُقال إن الخصائص المادية تشتق منه)",
 "monastery": "دَيْر (بيت يسكنه الرُهْبَان أو الرَاهِبَات ممن كان على دين المسيحية)\nمثال: سيداتي و سادتي ، رجاء قفوا للنشيد الوطني للاتحاد الروسي باداء جوقة دير سرتينسكي .",
 "monastic": "دَيْرِيّ, رَهْبَانِيّ (مُتَعَلِّقٌ بِالحَيَاةِ الجَمَاعِيَّةِ المُنْعَزِلَةِ عَنِ العَالَمِ تَحْتَ نُذُورٍ دِينِيَّةٍ) / راهب (رجل متدين يعيش في دير ويكرس نفسه للتأمل والصلاة والعمل)",
 "monastic habit": "ثوب الرهبان (ثوب طويل فضفاض يرتديه الرهبان في الدير)",
 "monastic order": "رهبنة, نظام رهباني (مجموعة من الأشخاص يعيشون تحت قاعدة دينية)\nمثال: نظام القديس بنديكت",
 "monastical": "دَيْرِيّ, رَهْبَانِيّ (مُتَعَلِّقٌ بِالحَيَاةِ الجَمَاعِيَّةِ المُنْعَزِلَةِ عَنِ العَالَمِ تَحْتَ نُذُورٍ دِينِيَّةٍ)",
 "monasticism": "رهبانية (زهد كشكل من أشكال الحياة الدينية؛ يمارس عادة في مجتمع تحت قاعدة مشتركة ويتميز بالعزوبية والفقر والطاعة)",
 "monatomic": "أحادي الذرة (متعلق بعنصر يتكون من ذرة واحدة)\nمثال: الهيليوم والأرجون غازات أحادية الذرة",
 "monaul": "مونال (تدرج زاهي الألوان من جنوب آسيا)",
 "monaural": "أُحَادِيّ الأُذُن (يتعلق بـ أو لديه أو يسمع بأذن واحدة فقط)\nمثال: صمم أحادي الأذن",
 "monaurally": "بأذن واحدة (بطريقة تستخدم أذناً واحدة)\nمثال: تم تقديم المحفزات بأذن واحدة",
 "monazite": "مونازيت (معدن بني محمر يحتوي على معادن أرضية نادرة؛ مصدر مهم للثوريوم والسيريوم)",
 "monday": "الْاِثْنَيْن, يَوْم الْاِثْنَيْن",
 "monecious": "أحادي المسكن, خنثي (يحتوي على أعضاء تناسلية ذكرية وأنثوية في نفس النبات أو الحيوان)",
 "monegasque": "موناكي (من أو يتعلق بموناكو أو شعبها أو يميزهم) / موناكي (مواطن أو ساكن في موناكو)",
 "monel metal": "معدن مونيل (سبيكة من النيكل والنحاس ومعادن أخرى (مثل الحديد و/أو المنغنيز و/أو الألمنيوم))",
 "monell metal": "معدن مونيل (سبيكة من النيكل والنحاس ومعادن أخرى (مثل الحديد و/أو المنغنيز و/أو الألمنيوم))",
 "moneran": "بدائيات النوى, مونيرا (كائنات تتكاثر عادة بالتبرعم اللاجنسي أو الانشطار ونمط تغذيتها الامتصاص أو التمثيل الضوئي أو التمثيل الكيميائي) / بدائي النواة, مونيري (متعلق بمملكة البدائيات (المونيرا))",
 "moneron": "بدائيات النوى, مونيرا (كائنات تتكاثر عادة بالتبرعم اللاجنسي أو الانشطار ونمط تغذيتها الامتصاص أو التمثيل الضوئي أو التمثيل الكيميائي)",
 "moneses uniflora": "بيرولا وحيدة الزهرة (عشب قزم دائم الخضرة ورقيق في المناطق المعتدلة الشمالية له زهرة طرفية بيضاء وحيدة؛ يوضع أحياناً في جنس بيرولا)",
 "monestrous": "أُحَادِيّ الشِّبْق (له دورة شبق واحدة في السنة)",
 "monetarism": "نقدوية (نظرية اقتصادية ترى أن التغيرات في البطالة ومعدل التضخم عادة ما تكون ناجمة عن التغيرات في المعروض النقدي)",
 "monetarist": "نقديّ (مدافع عن النظرية القائلة بأن التقلبات الاقتصادية ناتجة عن الزيادات أو النقصان في عرض النقود)",
 "monetary": "نَقْدِيّ, مَالِيّ",
 "monetary aggregate": "مجمع نقدي (نوع من مقاييس المعروض النقدي لبلد ما)\nمثال: لا يوجد مقياس واحد 'صحيح' للمعروض النقدي",
 "monetary fund": "صندوق, مال مخصص (احتياطي من المال مخصص لغرض ما)",
 "monetary resource": "أموال, موارد مالية (أصول في شكل مال)",
 "monetary standard": "معيار, معيار نقدي (القيمة الكامنة وراء المال في نظام نقدي)",
 "monetary system": "نظام نقدي, وسيط تبادل (أي شيء مقبول عموماً كمعيار للقيمة ومقياس للثروة في بلد أو منطقة معينة)",
 "monetary unit": "عملة, وحدة نقدية (وحدة للمال)",
 "monetary value": "تكلفة, سعر (خاصية امتلاك قيمة مادية (غالباً ما يشار إليها بمبلغ المال الذي سيجلبه الشيء إذا بيع))\nمثال: القيمة النقدية المتقلبة للذهب والفضة",
 "monetisation": "اعتماد كعملة, سك العملة (اعتماد شيء ما (كالذهب أو الفضة) كعملة قانونية للبلد)",
 "monetization": "اعتماد كعملة, سك العملة (اعتماد شيء ما (كالذهب أو الفضة) كعملة قانونية للبلد)",
 "money": "نُقُود, مَال / نُقُود, عُمْلَة / نَقْد, نقود / مَال (ما يملك الإنسان من كل شيء ويشمل النقد والعَيْن؛ عند البدو: هي النعم والإبل تحديدا)\nمثال: أريد بعض المال.",
 "money belt": "حزام نقود, كمر (حزام به قسم مخفي لحفظ النقود)",
 "money box": "خزينة نقود, صندوق النقد (صندوق قوي لحفظ النقود) / حصالة (حاوية (عادة بفتحة في الأعلى) لحفظ النقود في المنزل)\nمثال: كانت حصالة النقود فارغة",
 "money changer": "صَرَّاف",
 "money cowrie": "ودعة النقود (ودعة تستخدم صدفتها كنقود في أجزاء من جنوب المحيط الهادئ وأجزاء من أفريقيا)",
 "money dealer": "صراف, متعامل بالمال (شخص يستلم أو يستثمر أو يدفع المال)",
 "money does not smell": "المَالُ لَا يَنْتِنُ",
 "money handler": "صراف, متعامل بالمال (شخص يستلم أو يستثمر أو يدفع المال)",
 "money laundering": "غَسِيل أَمْوَال, غَسْل أَمْوَال",
 "money market": "سُوق الْمَال (مكان للبيع والشراء؛ جمع ساق، قال الله تعالى: 《رُدُّوهَا عَلَيَّ فَطَفِقَ مَسْحًا بِالسُّوقِ وَالْأَعْنَاقِ》)\nمثال: ذهبت إلى السوق.",
 "money order": "حوالة بريدية (أمر مكتوب بدفع مبلغ لفرد مسمى؛ يمكن الحصول عليه وصرفه في مكتب البريد)",
 "money plant": "زهرة الدراهم, لوناريا (نبات من جنوب شرق أوروبا يُزرع لأزهاره الأرجوانية العطرة وقرون بذوره الورقية الفضية البيضاء المستديرة المسطحة التي تستخدم للزينة الداخلية)",
 "money supply": "الكتلة النقدية, عرض النقود (إجمالي مخزون المال في الاقتصاد؛ العملة التي يحتفظ بها الجمهور بالإضافة إلى الأموال في الحسابات المصرفية)",
 "money-spinner": "بقرة حلوب, مشروع مُدر للربح (مشروع يولد تدفقًا مستمرًا للمال)",
 "moneybag": "صرة نقود, كيس نقود (كيس برباط لحفظ النقود)",
 "moneybags": "غَنِيّ",
 "moneyed": "ثَرِيّ, مُوسِر (يمتلك وفرة من المال أو الممتلكات القيّمة) / ذو مال, مالي (قائم على أو نابع من امتلاك المال أو الثروة)\nمثال: مصالح مالية",
 "moneyer": "سكاك العملة (عامل ماهر يسك أو يختم النقود)",
 "moneygrubber": "جشع للمال, عبد المال (شخص اهتمامه الرئيسي في الحياة هو كسب المال)",
 "moneylender": "مرابٍ (شخص يقرض المال بأسعار فائدة مفرطة)",
 "moneyless": "عَدِيمُ المَال (لا يملك أيّ مال) / بلا مال, لا نقدي (لا يقوم على امتلاك المال)\nمثال: اقتصاد لا نقدي",
 "moneymaker": "بقرة حلوب, مشروع مُدر للربح (مشروع يولد تدفقًا مستمرًا للمال) / صانع ثروة, كاسب المال (شخص ناجح في جمع الثروة)",
 "moneymaking": "كسب المال (فعل جني المال (وتراكم الثروة)) / مُدِرّ لِلْأَرْبَاح, مُرْبِح جِدًّا (ينتج ربحًا كبيرًا ووافرًا)",
 "moneyman": "خبير مالي (شخص ذكر ماهر في المعاملات المالية واسعة النطاق)",
 "moneywoman": "خبيرة مالية (شخص أنثى ماهرة في المعاملات المالية واسعة النطاق)",
 "moneywort": "جيني الزاحفة, عشبة المال (كرمة ليسيماكيا)",
 "monger": "تاجر, مساوم (شخص يشتري ويحافظ على مخزون من البضائع ليتم بيعها)",
 "monggo": "لوبياء شعاعية, ماش (بذور نبات الماش المستخدمة كغذاء) / فول مونج, ماش (بذرة نبات الماش؛ تستخدم للغذاء)",
 "mongo": "مونغو (100 مونغو تساوي 1 توغريك في منغوليا)",
 "mongol": "مغولي, منغولي (من أو متعلق بمنطقة منغوليا أو شعبها أو لغاتهم أو ثقافاتهم) / مغولي (عضو في الشعوب البدوية في منغوليا)\nمثال: الغزاة المغول",
 "mongol dynasty": "السلالة المغولية, سلالة يوان (السلالة الإمبراطورية للصين من 1279 إلى 1368)",
 "mongol tatar": "تتار (عضو في الشعب المنغولي في آسيا الوسطى الذي غزا روسيا في القرن الثالث عشر)",
 "mongolia": "مُنْغُولِيَا",
 "mongolian": "مُغُولِيّ",
 "mongolian monetary unit": "وحدة نقدية منغولية (الوحدة النقدية في منغوليا)",
 "mongolian race": "العرق الأصفر, العرق المغولي (عرق آسيوي)",
 "mongolianism": "المنغولية, متلازمة داون (اضطراب خلقي ناجم عن وجود كروموسوم 21 إضافي؛ يؤدي إلى وجه مسطح وقصر القامة وتخلف عقلي)",
 "mongolic": "اللغات المنغولية (عائلة من اللغات الألطية يتم التحدث بها في منغوليا)",
 "mongolic language": "اللغات المنغولية (عائلة من اللغات الألطية يتم التحدث بها في منغوليا)",
 "mongolism": "المنغولية, متلازمة داون (اضطراب خلقي ناجم عن وجود كروموسوم 21 إضافي؛ يؤدي إلى وجه مسطح وقصر القامة وتخلف عقلي)",
 "mongoloid": "منغولي ((مسيء) من أو متعلق أو يعاني من متلازمة داون) / أصفر, منغولي (من أو متعلق أو مميز لأحد التقسيمات العرقية التقليدية للبشرية ويشمل خاصة شعوب وسط وشرق آسيا) / شبيه بالمغول, منغولي (مميز أو يشبه المغول) / مُنْغُولِيّ (شخص يعاني من متلازمة داون (مصطلح قديم لم يعد يستخدم تقنياً ويعتبر مسيئاً))\nمثال: الطية الموقية المنغولية (في العين)",
 "mongoloid race": "العرق الأصفر, العرق المغولي (عرق آسيوي)",
 "mongoose": "نِمْس",
 "mongrel": "هَجِين",
 "monic polynomial": "كَثِيرَة حُدُود أَحَادِيَّة المَدْخَل, كَثِيرَة حُدُود بِمُتَغَيِّر وَاحِد (كثيرة حدود في متغير واحد)",
 "monied": "ذو مال, مالي (قائم على أو نابع من امتلاك المال أو الثروة)\nمثال: مصالح مالية",
 "moniker": "كنية, لقب تحبب (اسم مألوف لشخص (غالباً نسخة مختصرة من الاسم الأول للشخص))\nمثال: لم تستخدم والدة جو كنيته وكانت تناديه دائماً جوزيف",
 "monilia": "مونيليا (أي من الفطريات الناقصة الشبيهة بالخميرة من جنس مونيليا)",
 "monilia albicans": "كانديدا ألبيكانس, مبيضات بيضاء (فطر طفيلي يمكن أن يصيب الفم أو الجلد أو الأمعاء أو المهبل)",
 "monilia disease": "داء المبيضات, سفاد (عدوى تسببها فطريات من جنس المبيضات (خاصة المبيضة البيضاء))",
 "moniliasis": "داء المبيضات, سفاد (عدوى تسببها فطريات من جنس المبيضات (خاصة المبيضة البيضاء))",
 "monism": "مونية, وحدوية (المذهب القائل بأن الواقع يتكون من مادة أو عنصر أساسي واحد)",
 "monistat": "مونيستات, ميكونازول",
 "monistic": "أحادي (من أو يتعلق بمذهب الواحدية الفلسفي)\nمثال: المدرسة الأحادية تعتبر القانون الوطني والقانون الدولي كلاً متكاملاً",
 "monition": "إنذار قضائي (استدعاء يصدر بعد رفع دعوى يوجه جميع الأطراف المعنية لإظهار السبب في عدم منح الحكم المطلوب) / تَحْذِير, تَنْبِيه (نصيحة تحذيرية حول شيء وشيك (خاصة خطر وشيك أو أمر غير سار)) / إِنْذَار, تَحْذِير (توبيخ حازم)\nمثال: خطاب تحذير حول مخاطر الفسق",
 "monitor": "مُرَاقِب, مُرَاقِبَة / شَاشَة الْعَرْض, شَاشَة / عَرِيف, عَرِيفَة / رَاقَّبَ",
 "monitor lizard": "وَرَل",
 "monitor program": "برنامج مراقبة (برنامج يراقب وينظم ويتحكم أو يتحقق من عمليات نظام معالجة البيانات)",
 "monitor speaker": "سماعة المراقبة, سماعة المسرح (إحدى السماعات الموجودة على المسرح والموجهة نحو المؤدين لمساعدتهم على سماع أنفسهم)",
 "monitoring": "رصد, متابعة (فعل مراقبة شيء ما (وأحياناً الاحتفاظ بسجل له))\nمثال: يلعب رصد اتصالات العدو دوراً مهماً في أوقات الحرب",
 "monitoring device": "جهاز مراقبة, شاشة مراقبة (عرض ينتجه جهاز يأخذ الإشارات ويعرضها على شاشة تلفزيون أو شاشة حاسوب)",
 "monitoring program": "برنامج مراقبة (برنامج يراقب وينظم ويتحكم أو يتحقق من عمليات نظام معالجة البيانات)",
 "monitory": "إِنْذَارِيّ, تَحْذِيرِيّ (يُستخدَم للتحذير والتنبيه)",
 "monitrice": "دولا, مدرب الولادة (مساعد (غالباً والد الطفل الذي سيولد قريباً) يقدم الدعم لامرأة في المخاض من خلال تشجيعها على استخدام التقنيات المستفادة في فصول التحضير للولادة)",
 "monk": "رَاهِب, نَاسِك (اسم فاعل للفعل رَهَبَ؛ عند المَسِيحِيّين هو من تَبَتَّلَ لله واعْتَزَلَ الناس إلى بعض الأدْيِرَة طلبا للعِبَادَة)",
 "monk parakeet": "دُرَّة رَاهِبَة",
 "monk's cloth": "قماش الراهب (قماش ثقيل بنسج السلة)",
 "monkey": "سَعْدَان, قِرْد",
 "monkey bread": "باوباب, ثمرة التبلدي (فاكهة أفريقية تشبه القرع ذات لب صالح للأكل)",
 "monkey bridge": "جسر علوي (أعلى جسر ملاحي على سفينة؛ سطح صغير (غالباً مفتوح) فوق غرفة القيادة) / جسر القرود (منصة ضيقة عالية فوق سطح السفينة أو في غرفة المحرك أو غرفة الغلاية)",
 "monkey business": "ألاعيب, تلاعب (سلوك مؤذٍ أو مخادع)",
 "monkey dog": "أفينبينشر (سلالة أوروبية من الكلاب الصغيرة تشبه التيريير ذات شعر سلكي داكن وخطم معنقد)",
 "monkey jacket": "سترة ضباط (سترة بطول الخصر تضيق لتشكل نقطة في الخلف؛ يرتديها الضباط في قاعة الطعام للعشاء الرسمي)",
 "monkey ladder": "سلم القرود (سلم خفيف يؤدي إلى جسر القرود على السفينة)",
 "monkey nut": "فستق عبيد, فول سوداني (قرن كرمة الفول السوداني يحتوي عادة على حبتين أو بذرتين)",
 "monkey pinscher": "أفينبينشر (سلالة أوروبية من الكلاب الصغيرة تشبه التيريير ذات شعر سلكي داكن وخطم معنقد)",
 "monkey pod": "سامان, شجرة المطر (شجرة أمريكية استوائية كبيرة للزينة بأوراق ريشية مزدوجة وعناقيد كروية من الزهور بأسدية قرمزية وقرون بذور تأكلها الماشية)",
 "monkey puzzle": "أروكاريا أروكانية, لغز القرد (صنوبرية تشيلية كبيرة دائمة الخضرة لها فروع متشابكة وتحمل مكسرات صالحة للأكل)",
 "monkey see, monkey do": "القرد يرى، القرد يفعل",
 "monkey wrench": "مِفْتَاح إِنْجْلِيزِيّ (مفتاح)\nمثال: بحث عن المفتاح.",
 "monkey-bread tree": "باوباب, تبلدي (شجرة أفريقية لها جذع سميك للغاية وثمرة تشبه القرع ولها لب صالح للأكل يسمى خبز القرود)",
 "monkey-wrench": "مفتاح إنجليزي, مفتاح القرود (مفتاح ربط قابل للتعديل له فك ثابت وفك متحرك)",
 "monkeypod": "سامان, شجرة المطر (شجرة أمريكية استوائية كبيرة للزينة بأوراق ريشية مزدوجة وعناقيد كروية من الزهور بأسدية قرمزية وقرون بذور تأكلها الماشية)",
 "monkfish": "قرش ملاك (أسماك قرش ذات أجسام عريضة مسطحة وزعانف صدرية تشبه الأجنحة ولكنها تسبح بطريقة أسماك القرش) / سمكة الصنارة, سمكة الصياد (أسماك لها أفواه كبيرة مع خيط يشبه الدودة متصل بها لجذب الفريسة) / سمك الراهب (لحم سمكة كبيرة الرأس من مياه الأطلسي لأمريكا الشمالية)",
 "monkhood": "رهبانية, نظام الرهبان (الرهبان بشكل جماعي، يُعتبرون كمجموعة)",
 "monkish": "رُهْبَانِيّ, زُهْدِيّ (يليق براهب؛ يميل إلى الزهد وإنكار الذات)",
 "monkshood": "آقونيطن نابلس, قلنسوة الراهب (عشب سام موطنه شمال أوروبا له أزهار زرقاء بنفسجية مقلنسة؛ الأوراق والجذور المجففة تنتج الآقونيت)",
 "mono": "أُحَادِيّ الصَّوْت, مُونُو (يشير إلى نقل الصوت أو تسجيله عبر قناة واحدة) / داء التقبيل, كثرة الوحيدات العدوائية (مرض حاد يتميز بالحمى وتضخم الغدد الليمفاوية وزيادة غير طبيعية في كريات الدم البيضاء وحيدة النواة في مجرى الدم؛ ليس شديد العدوى؛ يعتقد البعض أنه يمكن…)",
 "mono-iodotyrosine": "أحادي يودوتيروسين (تيروسين مضاف إليه ذرة يود واحدة)",
 "monoamine": "أمين أحادي (جزيء يحتوي على مجموعة أمين واحدة (خاصة تلك التي تعمل كناقل عصبي))",
 "monoamine neurotransmitter": "ناقل عصبي أحادي الأمين (أمين أحادي مهم وظيفياً في النقل العصبي)",
 "monoamine oxidase": "أوكسيداز أحادي الأمين (إنزيم يحفز أكسدة العديد من مركبات الجسم (مثل الإبينفرين والنورإبينفرين والسيروتونين))",
 "monoamine oxidase inhibitor": "مثبط أكسيداز أحادي الأمين (أي من مجموعة الأدوية المضادة للاكتئاب التي تثبط عمل أكسيداز أحادي الأمين في الدماغ وتسمح بتراكم أحاديات الأمين)",
 "monoatomic": "أحادي الذرة (متعلق بعنصر يتكون من ذرة واحدة)\nمثال: الهيليوم والأرجون غازات أحادية الذرة",
 "monobasic acid": "حمض أحادي القاعدية (حمض يحتوي على ذرة هيدروجين واحدة قابلة للاستبدال في كل جزيء)",
 "monoblast": "أرومة وحيدة (خلية وحيدة كبيرة غير ناضجة توجد عادة في نخاع العظم)",
 "monoblastic leukaemia": "ابيضاض الدم الوحيدي (لوكيميا تتميز بتكاثر الخلايا الوحيدة والأرومات الوحيدة في الدم)",
 "monoblastic leukemia": "ابيضاض الدم الوحيدي (لوكيميا تتميز بتكاثر الخلايا الوحيدة والأرومات الوحيدة في الدم)",
 "monocarboxylic": "أحادي الكربوكسيل (يحتوي على مجموعة كربوكسيل واحدة)",
 "monocarp": "نبات وحيد الإثمار (نبات يثمر مرة واحدة ثم يموت)",
 "monocarpic": "وحيد الإثمار (يموت بعد إنتاج الثمار مرة واحدة فقط)",
 "monocarpic plant": "نبات وحيد الإثمار (نبات يثمر مرة واحدة ثم يموت)",
 "monocarpous plant": "نبات وحيد الإثمار (نبات يثمر مرة واحدة ثم يموت)",
 "monocentrism": "أحادية المركز (خاصية امتلاك مركز واحد أو الانطلاق منه)\nمثال: باختصار، تتبع المدن المختلفة أشكالاً مختلفة، ولا تناسبها أحادية مركز شيكاغو التاريخية ولا تعددية مراكز لوس أنجلوس",
 "monochromacy": "رؤية أحادية اللون, عمى الألوان الكلي (عمى ألوان كامل؛ لا يمكن التمييز بين الألوان إلا على أساس السطوع)",
 "monochromasy": "رؤية أحادية اللون, عمى الألوان الكلي (عمى ألوان كامل؛ لا يمكن التمييز بين الألوان إلا على أساس السطوع)",
 "monochromat": "أحادي اللون (شخص مصاب بعمى ألوان كلي)",
 "monochromatic": "أُحَادِيّ اللَّوْن ((للضوء أو الإشعاع الكهرومغناطيسي الآخر) لديه طول موجي واحد فقط) / أُحَادِيّ اللَّوْن (ذو لون واحد فقط أو يبدو كذلك) / أحادي اللون (من أو يتعلق بأحادية اللون)\nمثال: ضوء أحادي اللون",
 "monochromatic vision": "رؤية أحادية اللون, عمى الألوان الكلي (عمى ألوان كامل؛ لا يمكن التمييز بين الألوان إلا على أساس السطوع)",
 "monochromatism": "رؤية أحادية اللون, عمى الألوان الكلي (عمى ألوان كامل؛ لا يمكن التمييز بين الألوان إلا على أساس السطوع)",
 "monochrome": "أُحَادِيّ اللَّوْن (ذو لون واحد فقط أو يبدو كذلك) / صورة أبيض وأسود, صورة أحادية اللون (صورة فوتوغرافية أو شريحة بالأبيض والأسود) / لوحة أحادية اللون (لوحة تم تنفيذها بمجموعة من درجات لون واحد)",
 "monochromia": "رؤية أحادية اللون, عمى الألوان الكلي (عمى ألوان كامل؛ لا يمكن التمييز بين الألوان إلا على أساس السطوع)",
 "monochromic": "أُحَادِيّ اللَّوْن (ذو لون واحد فقط أو يبدو كذلك)",
 "monochromous": "أُحَادِيّ اللَّوْن (ذو لون واحد فقط أو يبدو كذلك)",
 "monocle": "نظارة أحادية (عدسة لتصحيح الرؤية المعيبة في عين واحدة؛ تثبت في مكانها بواسطة عضلات الوجه)",
 "monocled": "ذُو نَظَّارَات, مُرْتَدٍ لِلنَّظَّارَات (يرتدي نظارات أو وجهه مزين بها)",
 "monoclinal": "أُحَادِيّ المَيْل (لبنية جيولوجيَّة تميل فيها جميع الطبقات في نفس الاتِّجاه)",
 "monocline": "أحادية الميل (تكوين جيولوجي تميل فيه جميع الطبقات في نفس الاتجاه)",
 "monoclinic": "أُحَادِيّ المَيْل (لديه ثلاثة محاور بلورية غير متساوية مع تقاطع مائل واحد)\nمثال: نظام أحادي الميل",
 "monoclinous": "أحادي المسكن, خنثي (يحتوي على مدقات وأسدية في نفس الزهرة)",
 "monoclonal": "أحادي النسيلة (مشكل أو مشتق من نسيلة واحدة) / جسم مضاد وحيد النسيلة (أي من فئة الأجسام المضادة المنتجة في المختبر بواسطة استنساخ واحد من الخلايا وتتكون من جزيئات أجسام مضادة متطابقة)",
 "monoclonal antibody": "جسم مضاد وحيد النسيلة (أي من فئة الأجسام المضادة المنتجة في المختبر بواسطة استنساخ واحد من الخلايا وتتكون من جزيئات أجسام مضادة متطابقة)",
 "monocot": "أحادي الفلقة, نبات ذو فلقة واحدة (نبات زهري أحادي الفلقة؛ ينمو الساق عن طريق تراكمات في داخله)",
 "monocot family": "فصيلة أحاديات الفلقة (فصيلة من النباتات المزهرة لها فلقة واحدة (ورقة جنينية) في البذرة)",
 "monocot genus": "جنس أحادي الفلقة (جنس من النباتات المزهرة ذات فلقة واحدة (ورقة جنينية) في البذرة)",
 "monocotyledon": "أحادي الفلقة, نبات ذو فلقة واحدة (نبات زهري أحادي الفلقة؛ ينمو الساق عن طريق تراكمات في داخله)",
 "monocotyledonous": "أحادي الفلقة ((عن النباتات المزهرة) يحتوي على فلقة واحدة في البذرة كما في الأعشاب والزنابق)",
 "monocracy": "استبدادية, دكتاتورية (شكل من أشكال الحكم يكون فيه الحاكم دكتاتوراً مطلقاً (غير مقيد بدستور أو قوانين أو معارضة وما إلى ذلك))",
 "monocular microscope": "مجهر أحادي العين (مجهر بعدسة شيئية واحدة وعدسة عينية واحدة، مصمم للرؤية الأحادية)",
 "monocular vision": "رؤية أحادية (الرؤية بعين واحدة فقط)",
 "monoculture": "زراعة أحادية (زراعة محصول واحد (في مزرعة أو منطقة أو بلد))",
 "monocycle": "دراجة أحادية العجلة (مركبة بعجلة واحدة تدار بالدواسات)",
 "monocyte": "خلية وحيدة, كريّة وحيدة (نوع من خلايا الدم البيضاء المحببة تعمل على ابتلاع البكتيريا)",
 "monocytic leukaemia": "ابيضاض الدم الوحيدي (لوكيميا تتميز بتكاثر الخلايا الوحيدة والأرومات الوحيدة في الدم)",
 "monocytic leukemia": "ابيضاض الدم الوحيدي (لوكيميا تتميز بتكاثر الخلايا الوحيدة والأرومات الوحيدة في الدم)",
 "monocytosis": "كثرة الوحيدات (زيادة في عدد الخلايا الوحيدة في الدم؛ عرض لابيضاض الدم الوحيدي)",
 "monodic": "أُحَادِيُّ الصَّوْت (ذُو خَطٍّ غِنَائِيٍّ صَوْتِيٍّ وَاحِد)",
 "monodical": "أُحَادِيُّ الصَّوْت (ذُو خَطٍّ غِنَائِيٍّ صَوْتِيٍّ وَاحِد)",
 "monodon monoceros": "حريش البحر, نروال (حوت قطبي صغير يتميز الذكر منه بناب عاجي حلزوني طويل)",
 "monody": "أحادية الصوت, موسيقى أحادية الصوت (موسيقى تتكون من خط صوتي واحد (عادة مع مرافقة))",
 "monoecious": "أحادي المسكن, خنثي (يحتوي على أعضاء تناسلية ذكرية وأنثوية في نفس النبات أو الحيوان)",
 "monoestrous": "أُحَادِيّ الشِّبْق (له دورة شبق واحدة في السنة)",
 "monofocal iol": "زرعة عدسة أحادية البؤرة (عدسة بؤرة واحدة تُستخدم بعد جراحة الساد لتوفير رؤية واضحة للمسافات البعيدة)",
 "monofocal lens implant": "زرعة عدسة أحادية البؤرة (عدسة بؤرة واحدة تُستخدم بعد جراحة الساد لتوفير رؤية واضحة للمسافات البعيدة)",
 "monogamist": "أحادي الزواج (شخص يمارس الزواج الأحادي (زوج واحد في كل مرة))",
 "monogamous": "أحادي الزوج, أحادي الزوجة ((يستخدم للعلاقات والأفراد) له شريك واحد)\nمثال: زواج أحادي",
 "monogamousness": "زواج أحادي (ممارسة أو حالة وجود زوج واحد فقط في المرة الواحدة)",
 "monogamy": "زواج أحادي (ممارسة أو حالة وجود زوج واحد فقط في المرة الواحدة)",
 "monogenesis": "تكون الأبواغ (تكاثر لاجنسي عن طريق إنتاج وإطلاق الأبواغ)",
 "monogenic": "أُحَادِيُّ الْجِين (متعلق بصفة وراثية يتحكم بها زوج واحد من الجينات)",
 "monogenic disease": "اضطراب أحادي الجين (مرض وراثي يتحكم فيه زوج واحد من الجينات)",
 "monogenic disorder": "اضطراب أحادي الجين (مرض وراثي يتحكم فيه زوج واحد من الجينات)",
 "monogram": "حرف واحد, مونوغرام (رمز رسومي يتكون من حرفين أو أكثر مدمجين (عادة الأحرف الأولى من اسمك)؛ يُطبع على القرطاسية أو يُطرز على الملابس)",
 "monograph": "دراسة مفردة, مونوجراف (أطروحة مفصلة وموثقة حول موضوع معين)",
 "monogynic": "أُحَادِيُّ الزَّوْجَة (لَهُ زَوْجَةٌ رَئِيسِيَّةٌ وَاحِدَةٌ فِي الوَقْتِ ذَاتِه)",
 "monogynist": "أحادي الزواج (شخص يمارس الزواج الأحادي (زوج واحد في كل مرة))",
 "monogynous": "أُحَادِيُّ الزَّوْجَة (لَهُ زَوْجَةٌ رَئِيسِيَّةٌ وَاحِدَةٌ فِي الوَقْتِ ذَاتِه)",
 "monogyny": "اكتفاء بزوجة واحدة (وجود زوجة واحدة فقط في المرة الواحدة)",
 "monohybrid": "هجين أحادي (هجين ناتج عن تزاوج أبوين متماثلي الزيجوت باستثناء موقع جيني واحد له أليلان (كما في تجارب مندل مع بازلاء الحديقة))",
 "monohybrid cross": "تهجين أحادي (تهجين باستخدام صفة واحدة مع أليلين (كما في تجارب مندل مع البازلاء))",
 "monohydrate": "أحادي الهيدرات (هيدرات تحتوي على جزيء واحد من الماء لكل جزيء من المركب)",
 "monoicous": "أحادي المسكن, خنثي (يحتوي على أعضاء تناسلية ذكرية وأنثوية في نفس النبات أو الحيوان)",
 "monoideism": "أحادية الفكرة, استحواذ الفكرة (حالة من الاستغراق الطويل في فكرة واحدة (كما في الاكتئاب العقلي، الغشية، التنويم المغناطيسي))",
 "monolatry": "تفريد العبادة (عبادة إله واحد دون الادعاء بأنه الإله الوحيد الموجود)",
 "monolingual": "أُحَادِي اَللُّغَة",
 "monolingually": "بأحادية اللغة (بطريقة أحادية اللغة)\nمثال: نشأت بأحادية اللغة",
 "monolith": "مُونُولِيث",
 "monolithic": "أُحَادِيّ, صَلْب (يَتَّسِم بِالضَّخَامَة وَالجُمُود وَالتَّجَانُس التَّامّ) / صَرْحِيّ, ضَخْم (مهيب في الحجم أو الكتلة أو الصلابة)",
 "monologist": "مؤدي المونولوج, منولوجست (فنان يقدم عرضه منفرداً)",
 "monologue": "مُونُولُوج, حَدِيث النَّفْس",
 "monomania": "استحواذ فكري, هوس أحادي (هوس يقتصر على شيء واحد أو فكرة واحدة)",
 "monomaniac": "مُصاب بِالهَوَس الأُحادِيّ (شخص يعاني من الهوس الأحادي (جنون بفكرة واحدة))",
 "monomaniacal": "أُحَادِيّ الهَوَس (مهووس بموضوع واحد أو فكرة واحدة)",
 "monomer": "أحادي الجزيء, مونومر (مركب بسيط يمكن لجزيئاته أن ترتبط معاً لتكوين بوليمرات)",
 "monometallic": "أحادي المعدن (يحتوي على ذرة واحدة من المعدن في الجزيء)\nمثال: كربونيلات أحادية المعدن",
 "monometallism": "نظام المعدن الواحد (استخدام معدن واحد فقط (مثل الذهب أو الفضة) في العملة القياسية للبلد، أو كمعيار للقيمة النقدية)",
 "monomorium minimum": "نمل أسود صغير (نمل أسود لامع دقيق؛ يعشش في الهواء الطلق ولكنه يغزو المنازل بحثاً عن الطعام)",
 "monomorium pharaonis": "نمل فرعون (نمل أحمر صغير من المناطق الدافئة؛ آفة منزلية شائعة)",
 "monomorphemic": "أحادي المورفيم (يتكون من مورفيم واحد فقط)",
 "mononeuropathy": "اعتلال العصب الأحادي (أي اعتلال عصبي يصيب جذع عصبي واحد)",
 "mononuclear": "أُحَادِيّ النَّوَاة (لديه نواة واحدة فقط)",
 "mononuclear phagocyte system": "نظام البلعميات وحيدة النواة (نظام واسع الانتشار من البلاعم الحرة والثابتة المشتقة من نخاع العظم)",
 "mononucleate": "أُحَادِيّ النَّوَاة (لديه نواة واحدة فقط)",
 "mononucleosis": "داء التقبيل, كثرة الوحيدات العدوائية (مرض حاد يتميز بالحمى وتضخم الغدد الليمفاوية وزيادة غير طبيعية في كريات الدم البيضاء وحيدة النواة في مجرى الدم؛ ليس شديد العدوى؛ يعتقد البعض أنه يمكن…)",
 "mononychus olecranus": "مونونيكوس (أحفورة بحجم الديك الرومي طويلة الأرجل عمرها 75 مليون سنة عُثر عليها في صحراء غوبي، لها عظام معصم ملتحمة تشبه الطيور وعظم قص زورقي وذيل طويل يشبه…)",
 "monophonic": "أُحَادِيّ الصَّوْت, مُونُو (يشير إلى نقل الصوت أو تسجيله عبر قناة واحدة) / أحادي الصوت, مونوفوني (يتكون من خط لحني واحد)",
 "monophonic music": "أحادية الصوت, موسيقى أحادية الصوت (موسيقى تتكون من خط صوتي واحد (عادة مع مرافقة))",
 "monophony": "أحادية الصوت, موسيقى أحادية الصوت (موسيقى تتكون من خط صوتي واحد (عادة مع مرافقة))",
 "monophysite": "أحادي الطبيعة, مونوفيزيتي (مكون من أو متعلق بالمذهب المونوفيزيتي (الطبيعة الواحدة)) / مُونُوفِيزِيتِيّ, يَعْقُوبِيّ (معتنق لمذهب الطبيعة الواحدة للمسيح)",
 "monophysitic": "أحادي الطبيعة, مونوفيزيتي (مكون من أو متعلق بالمذهب المونوفيزيتي (الطبيعة الواحدة))",
 "monophysitism": "طبيعة واحدة, مونوفيزية (هرطقة مسيحية من القرنين الخامس والسادس تحدت التعريف الأرثوذكسي للطبيعتين (البشرية والإلهية) في يسوع واعتقدت بدلاً من ذلك بوجود طبيعة إلهية واحدة)",
 "monoplane": "طائرة أحادية الجناح, طائرة أحادية السطح (طائرة بجناح واحد)",
 "monoplane flying fish": "سمكة طائرة أحادية الجناح (تتميز بتضخم الزعانف الصدرية فقط)",
 "monoplegia": "شلل أحادي (شلل طرف واحد)",
 "monoploid": "أحادي الصيغة الصبغية (لخلية أو كائن حي يحتوي على مجموعة واحدة من الكروموسومات)",
 "monopolisation": "احتكار (الهيمنة (على سوق أو سلعة) مع استبعاد الآخرين)",
 "monopoliser": "محتكر (شخص يحتكر وسائل إنتاج أو بيع سلعة ما)",
 "monopolist": "محتكر (شخص يحتكر وسائل إنتاج أو بيع سلعة ما)",
 "monopolistic": "اِحْتِكَارِيّ (يملك سيطرة حصرية على نشاط تجاريّ بالحيازة أو بمنحة قانونية)",
 "monopolization": "اِحْتِكَار",
 "monopolize": "اِحْتَكَرَ",
 "monopolizer": "محتكر (شخص يحتكر وسائل إنتاج أو بيع سلعة ما)",
 "monopoly": "اِحْتِكَار, اِنْحِصَار",
 "monopoly board": "لوحة المونوبولي (لوحة تستخدم للعب المونوبولي)",
 "monopsony": "احتكار الشراء ((اقتصاد) سوق يتم فيه عرض السلع أو الخدمات من قبل عدة بائعين ولكن يوجد مشترٍ واحد فقط)",
 "monopteral": "دَائِرِيّ الأَعْمِدَة (ذو أعمدة مرتّبة بشكل دائريّ)",
 "monorail": "قطار أحادي الخط, مونوريل (سكة حديد لها مسار واحد)",
 "monorchidism": "أحادية الخصية (فشل خصية واحدة في النزول إلى كيس الصفن)",
 "monorchism": "أحادية الخصية (فشل خصية واحدة في النزول إلى كيس الصفن)",
 "monoreme": "سفينة أحادية المجاديف (قادس يحتوي على صف واحد من المجاديف)",
 "monosaccharide": "سكر أحادي, سكريات أحادية (سكر (مثل السكريات البسيطة) لا يتحلل مائياً ليعطي سكريات أخرى؛ وهو أبسط مجموعة من الكربوهيدرات)",
 "monosaccharose": "سكر أحادي, سكريات أحادية (سكر (مثل السكريات البسيطة) لا يتحلل مائياً ليعطي سكريات أخرى؛ وهو أبسط مجموعة من الكربوهيدرات)",
 "monosemous": "أُحَادِيّ الدَّلَالَة (له معنى واحد فقط)",
 "monosemy": "أُحَادِيَّة المَعْنَى (امتلاك معنى واحد (غياب الغموض) عادة للكلمات أو العبارات الفردية)",
 "monosexuality": "أُحَادِيَّة جِنْسِيَّة",
 "monosodium glutamate": "غلوتامات أحادية الصوديوم (مركب بلوري أبيض يستخدم كمضاف غذائي لتعزيز النكهة؛ غالباً ما يستخدم في الطبخ الصيني)",
 "monosomy": "أحادية الصبغي (شذوذ كروموسومي يتمثل في غياب كروموسوم واحد من العدد الثنائي الطبيعي)",
 "monospaced font": "خط الآلة الكاتبة, خط ثابت العرض (نمط خط يتم فيه إعطاء كل حرف نفس العرض (كما في الآلة الكاتبة))",
 "monostable relay": "مرحل أحادي الاستقرار (مرحل يعود إلى وضع التلامس المحدد مسبقاً بعد إيقاف التيار)",
 "monostotic fibrous dysplasia": "خلل التنسج الليفي وحيد العظم (خلل التنسج الليفي للعظام يقتصر على عظم واحد)",
 "monosyllabic": "أُحَادِيّ المَقْطَع",
 "monosyllabic word": "كلمة أحادية المقطع (كلمة أو لفظ يتكون من مقطع واحد)",
 "monosyllabically": "بمقطع واحد (بطريقة أحادية المقطع)",
 "monosyllable": "كلمة أحادية المقطع (كلمة أو لفظ يتكون من مقطع واحد)",
 "monotheism": "تَوْحِيد",
 "monotheist": "مُوَحِّد",
 "monotheistic": "توحيدي (يؤمن بوجود إله واحد فقط)",
 "monothelitism": "مشيئة واحدة, مونوثيلية (العقيدة اللاهوتية القائلة بأن المسيح كانت له مشيئة واحدة فقط على الرغم من أن له طبيعتين (بشرية وإلهية)؛ أدينت بالهرطقة في مجمع القسطنطينية الثالث)",
 "monotone": "أُحَادِيُّ النَّغْمَة, رَتِيب (يُنْطَقُ أَوْ يُسْمَعُ بِنَغْمَةٍ ثَابِتَةٍ لَا تَتَفَاوَتُ فِي الطَّبَقَة) / رتيب, مطرد (عن التسلسل أو الدالة؛ تتزايد باستمرار ولا تتناقص أبداً أو تتناقص باستمرار ولا تتزايد أبداً في القيمة) / رتابة, صوت رتيب (تنغيم غير متغير) / نغمة رتيبة, نغمة واحدة (نغمة واحدة تتكرر بكلمات مختلفة أو إيقاعات مختلفة (خاصة في أداء النصوص الليتورجية))",
 "monotonic": "أُحَادِيُّ النَّغْمَة, رَتِيب (يُنْطَقُ أَوْ يُسْمَعُ بِنَغْمَةٍ ثَابِتَةٍ لَا تَتَفَاوَتُ فِي الطَّبَقَة) / رتيب, مطرد (عن التسلسل أو الدالة؛ تتزايد باستمرار ولا تتناقص أبداً أو تتناقص باستمرار ولا تتزايد أبداً في القيمة)",
 "monotonicity": "اِطِّرَادُ دَالَّةٍ",
 "monotonous": "مُمِلّ (ما يسبب الضجر والضيقة، غير مثير للاهتمام)\nمثال: نهار اليوم ممل!",
 "monotonously": "برتابة (بطريقة رتيبة)\nمثال: تاريخ المسرحية طوال الجزء الأخير من القرن الثامن عشر خالٍ من الأحداث برتابة",
 "monotony": "رَتَابَة, وَتِيرَة وَاحِدَة (ثبات النغمة أو الطبقة الصوتية أو التصريف) / رَتَابَة, مَلَل (صفة الثبات المرهق والروتين ونقص التنوع)\nمثال: لم يعتد أبداً على رتابة عمله",
 "monotopism": "أحادية المنشأ المكاني (نشوء مجموعة تصنيفية مرة واحدة فقط (كما هو الحال عن طريق الطفرة) أو في موقع واحد)",
 "monotreme": "كظاميات (أكثر الثدييات بدائية وتضم الأعضاء الحية الوحيدة من طائفة الوحشيات الأولية)",
 "monotropa hypopithys": "شبيه الغليون الهندي, عصارة الصنوبر",
 "monotropa uniflora": "زهرة الشمع, غليون هندي (نبات غابات رمي صغير شمعي أبيض أو وردي مبيض له أوراق تشبه القشور وزهرة متدلية؛ يتحول إلى الأسود مع التقدم في العمر)",
 "monotype": "مونوتيب (آلة تنضيد تعمل من لوحة مفاتيح وتضع أحرفاً منفصلة) / طباعة أحادية, مونوتيب (المطبوعة الوحيدة المصنوعة بضغط الورق على لوح زجاجي أو معدني مطلي أو مكسو بالحبر) / أحادي النوع ((في الأحياء) مجموعة تصنيفية ذات عضو واحد (نوع واحد أو جنس واحد))",
 "monotype caster": "آلة صب الحروف, مونوتايب (آلة تستخدم لتنضيد المواد المطبوعة)",
 "monotype keyboard": "لوحة مفاتيح مونوتايب (نوع من لوحات المفاتيح المستخدمة لإعداد شريط ورقي مثقوب، يسمى الشريط، والذي يوجه صب الحروف بشكل منفصل عن صبها الفعلي)",
 "monotypic": "أحادي النمط (يتكون من نوع (نمط) واحد فقط)",
 "monounsaturated": "أُحَادِيّ عَدَم التَّشَبُّع ((عَنِ المُرَكَّبَات الكَرْبُونِيَّة خَاصَّةً الدُّهُون) مُشَبَّع بِاسْتِثْنَاء رَابِطَة مُتَعَدِّدَة وَاحِدَة)",
 "monounsaturated fatty acid": "حمض دهني أحادي غير مشبع (حمض دهني غير مشبع تحتوي سلسلة الكربون الخاصة به على رابطة تكافؤ مزدوجة أو ثلاثية واحدة لكل جزيء؛ يوجد بشكل رئيسي في زيت الزيتون والدجاج واللوز)",
 "monovalent": "أحادي التكافؤ (له تكافؤ كيميائي يساوي 1) / أحادي التكافؤ (يحتوي على نوع واحد فقط من الأجسام المضادة)",
 "monovular": "أُحَادِيّ البُوَيْضَة, مُتَطَابِق ((للتوائم) مشتق من بيضة واحدة أو بويضة)\nمثال: التوائم المتطابقة هي أحادية البويضة",
 "monoxide": "أحادي أكسيد (أكسيد يحتوي على ذرة أكسجين واحدة فقط في الجزيء)",
 "monozygotic": "أحادي الزيجوت, متماثل (مشتق من بويضة مخصبة واحدة (عن التوائم))\nمثال: توائم متطابقة (أحادية الزيجوت)",
 "monozygotic twin": "توأم متطابق (أحد توأمين تطورا من نفس البويضة المخصبة (لهما نفس المادة الوراثية))",
 "monozygous twin": "توأم متطابق (أحد توأمين تطورا من نفس البويضة المخصبة (لهما نفس المادة الوراثية))",
 "monro's foramen": "الثقبة بين البطينين, ثقبة مونرو (الفتحة الصغيرة (على الجانبين الأيمن والأيسر) التي تربط البطين الثالث في الدماغ البيني بالبطين الجانبي في نصف الكرة المخية)",
 "monroe": "مُونْرُو",
 "monroe doctrine": "مبدأ مونرو (سياسة خارجية أمريكية تعارض التدخل في نصف الكرة الغربي من القوى الخارجية)",
 "monrovia": "مُونْرُوفِيَا",
 "mons": "جبل الزهرة, عانة (تلة من الأنسجة الدهنية تغطي منطقة العانة عند النساء)",
 "mons pubis": "جَبَل اَلْعَانَة (كلمة \"جبل\" لها معانٍ متعددة؛ طبع أو خلق شيئًا أو شخصًا على طبيعة أو سلوك معين)\nمثال: منزلي في الجبل.",
 "mons veneris": "جبل الزهرة, عانة (تلة من الأنسجة الدهنية تغطي منطقة العانة عند النساء)",
 "monsieur": "سيد, مسيو (يستخدم كلقب مجاملة فرنسي؛ يعادل 'سيد' في الإنجليزية)",
 "monsignor": "مونسنيور ((الكنيسة الكاثوليكية الرومانية) لقب شرفي كنسي يُمنح لبعض الكهنة)",
 "monsoon": "رِيَاح مَوْسِمِيَّة",
 "monsoon forest": "غابة موسمية (غابة مفتوحة في منطقة استوائية ذات مناخ موسمي)",
 "monster": "وَحْش (حَيْوَان غير مستأنس يعيش بعيدا عن الناس، وهي أصل الكلمة؛ حيوان مُفْتَرِس)\nمثال: ضرب زيري الوحش.",
 "monstera": "قشطة دندروم, مونستيرا (فاكهة استوائية أسطوانية تشبه مخروط الصنوبر بنكهة الأناناس والموز) / قفص صدري, مونستيرا (أي نبات من جنس مونستيرا؛ غالباً ما يزرع كنباتات منزلية)",
 "monstera deliciosa": "قفص صدري, مونستيرا (كرمة أمريكية استوائية لها جذور تتدلى مثل الحبال وثمار أسطوانية بنكهة الأناناس والموز)",
 "monstrance": "إحقاق, وعاء القربان ((الكنيسة الرومانية الكاثوليكية) وعاء (عادة من الذهب أو الفضة) يُعرض فيه القربان المقدس للتعبد) / إثبات, تبيان (إثبات بعملية جدلية أو سلسلة من القضايا تثبت استنتاجاً مؤكداً)",
 "monstrosity": "بشاعة, قبح (شيء بشع أو مخيف) / شخص مشوه, مسخ (شخص أو حيوان غير عادي أو مشوه بشكل ملحوظ)\nمثال: اعتبروا القنبلة الذرية شيئاً بشعاً",
 "monstrous": "غَرِيب الشَّكْل, مَسْخِيّ (مشوه وغير طبيعي في الشكل أو الحجم؛ شاذ ومنفر) / شَنِيع, فَظِيع (بالغ الوحشية أو القسوة بشكل صادم) / وَحْشِيّ الحَجْم (كبير بشكل غير طبيعي)",
 "monstrously": "بشكل بشع, بشكل مشوه (بطريقة مشوهة وغريبة) / بشكل وحشي, بشناعة (بطريقة شريرة للغاية) / بشكل بشع, بفظاعة (بطريقة بشعة)\nمثال: خلف المنزل رقدت جثتان عاريتان صلعاوان بشكل بشع، مع طعنات سكين متعمدة تميز أجسادهما",
 "mont blanc": "مُونْ بْلَان",
 "montage": "مُونْتَاج",
 "montagu's harrier": "مرزة مونتاجو (مرزة أوروبية بنية اللون)",
 "montan wax": "شمع المونتان (شمع صلب يُستخرج من الليغنيت)",
 "montana": "مُونْتَانَا",
 "montanan": "مونتاني (مواطن أو مقيم في مونتانا)",
 "montane": "جبلي (متعلق بالمناطق الجبلية أو يقطنها)\nمثال: زهور جبلية",
 "montanism": "الْمُونْتَانِيَّة",
 "monte": "ثري كارد مونتي, مونتي (لعبة ورق قمار من أصل إسباني؛ يتم توزيع 3 أوراق مكشوفة ويراهن اللاعبون على أن إحداها ستطابق قبل الأخريات أثناء توزيع الأوراق من الحزمة واحدة تلو الأخرى)",
 "montenegrin": "مُونْتِينِيغْرِيّ",
 "montenegro": "الْجَبَلُ الْأَسْوَد",
 "monterey cypress": "سرو مونتيري (سرو كاليفورنيا طويل متوطن في خليج مونتيري؛ يستخدم على نطاق واسع للزينة وكذلك لإعادة التحريج وزراعة أحزمة الوقاية)",
 "monterey pine": "صنوبر مونتيري (صنوبر كاليفورنيا طويل بإبر طويلة في حزم من 3، وتاج كثيف، ولحاء بني داكن متشقق بعمق)",
 "montevideo": "مُونْتِيفِيدِيُو",
 "montezuma": "مونتيزوما (شجرة دائمة الخضرة ذات أوراق جلدية كبيرة وأزهار وردية إلى برتقالية كبيرة؛ تعتبر نباتاً رابطاً بين العائلتين البومباكاسية والستيركولاسية)",
 "montezuma cypress": "سرو مونتيزوما (شجرة سرو في وديان الأنهار في المرتفعات المكسيكية) / سرو مونتيزوما (خشب السرو في وديان الأنهار بالمرتفعات المكسيكية)",
 "montezuma's revenge": "إسهال المسافرين (إسهال يتم التقاطه في المكسيك أو أمريكا الوسطى)",
 "montferrat": "مُونْفِيرَّاتُو",
 "montgomery's tubercle": "حديبة مونتغمري (إحدى الغدد الدهنية الموجودة على هالة الثدي والتي ترطب الثدي أثناء الرضاعة الطبيعية)",
 "month": "شَهْر (اسم مفرد: مدة زمنية قدرها 28 أو 29 أو 30 أو 31 يوما، والشَّهرُ جزءٌ من اثني عشر جزئا من السَنَة…)\nمثال: رمضان شهر حرام.",
 "month by month": "شهراً بعد شهر, شهرياً (لعدد غير محدد من الأشهر)\nمثال: شهراً بعد شهر، كانت الخيانة تنهش قلبه",
 "month of sundays": "أمد طويل, دهر (وقت يُنظر إليه على أنه طويل)\nمثال: لم أره منذ دهر",
 "monthlong": "لِمُدَّة شَهْر (يَسْتَمِرّ شَهْرًا كامِلًا)",
 "monthly": "شَهْرِيّ / شَهْرِيًّا",
 "monthsary": "ذكرى شهرية (الذكرى الشهرية لشيء ما)",
 "montia chamissoi": "زنبق الضفدع (خس هندي طافٍ أو زاحف ذو عناقيد طرفية من الزهور الوردية الباهتة؛ المناطق الرطبة في المرتفعات بغرب أمريكا الشمالية)",
 "montia cordifolia": "مونتيا عريضة الأوراق (نبات عصاري ذو أوراق قاعدية في الغالب؛ الساق يحمل زوجاً واحداً من الأوراق العريضة البيضاوية أو القلبية وعنقوداً فضفاضاً من 3-10 زهور بيضاء؛ غرب أمريكا…)",
 "montia lamprosperma": "بلينكس, عشبة الطيور المائية (خس هندي صغير من المناطق الشمالية)",
 "montia perfoliata": "خس عامل المنجم, رجلة الشتاء (عشبة عصارية تزرع أحياناً كسلطة أو بقلة؛ تنمو في الكثبان والأراضي البور بساحل المحيط الهادئ لأمريكا الشمالية)",
 "montiform": "شكل الجبل ((شَكَلَ) الأمْرُ يَشْكُلُ شُكُولاً: الْتَبَسَ؛ (شَكَلَ) المريضُ: تماثَلَ)\nمثال: اجلس بشكل مريح.",
 "montrachet": "مونتراشيه (نبيذ بورغوندي أبيض)",
 "montreal": "مُونْتْرِيَال",
 "montserrat": "مُونْتْسِيرَات, مُونْتْسِرَات",
 "montserratian": "مونتسيراتي (من أو متعلق بمونتسيرات أو سكان مونتسيرات) / مونتسيراتي (مواطن أو ساكن في مونتسيرات)\nمثال: السكان الأصليون المونتسيراتيّون",
 "monufia": "المِنُوفِيَّة",
 "monument": "نُصُب, مَعْلَم تَذْكَارِيّ",
 "monumental": "صَرْحِيّ, ضَخْم (مهيب في الحجم أو الكتلة أو الصلابة) / ضَخْم, هَائِل الأَهَمِّيَّة (ذو أهمّيّة استثنائيّة بارزة) / تذكاري, نصبي (متعلق بنصب تذكاري أو ينتمي إليه أو يعمل كواحد)\nمثال: استخدام القوس في العمارة النصبية",
 "moo": "خُوَار / خَارَ (صوت حيوان البقر خاصة؛ في : نطقٌ يحدث من الحلق، أي الصوت الذي يصدر من الحلق بشكل مستمر) / مُو\nمثال: السحابة هي كتلة بخار في السماء.",
 "moo goo gai pan": "مو جو جاي بان (طبق كانتوني من الدجاج والخضروات المشوحة)",
 "moo-cow": "بقرة (أنثى الماشية المستأنسة)",
 "mooch": "طُفَيْلِيّ, مُتَطَفِّل (شخص يحاول الحصول على أشياء مجانية من الآخرين)",
 "moocher": "طُفَيْلِيّ, مُتَطَفِّل (شخص يحاول الحصول على أشياء مجانية من الآخرين)",
 "mood": "مَزَاج",
 "moodily": "بكآبة, بمزاجية (بطريقة متقلبة المزاج)\nمثال: في الحانة، كان رجل شاب حاد العينين يحدق بكآبة في مشروب الجن والمنشط",
 "moodiness": "تقلب المزاج (امتلاك أمزجة متقلبة وحادة الطباع) / تقلب المزاج, كآبة (شعور كئيب عبوس)",
 "moody": "مُتَقَلِّبُ المِزَاج, مِزَاجِيّ (خاضع لتقلّبات حادّة في المزاج) / عَبُوس, كَئِيب (يُظهر مزاجاً قاتماً ومكتئباً)",
 "moolah": "فلوس, نقود (مصطلحات غير رسمية للمال)",
 "moon": "قَمَر, قمر (الكَوْكَب الذي يدور حول الأرْض ويظهر غالبا في الليل ويعكس ضوء الشَمْس. مذكر لا يؤنث؛ أي كوكب يدور حول كوكب آخر، لا يشمل ذلك الكواكب التي تدور حول شُمُوس. مذكر لا يؤنث)\nمثال: ضوء القمر ضعيف.",
 "moon blindness": "عمى القمر (التهاب العين المتكرر في الخيول؛ يؤدي أحياناً إلى العمى) / عشى, عشى ليلي (عدم القدرة على الرؤية بوضوح في الضوء الخافت؛ بسبب نقص فيتامين أ أو اضطراب في الشبكية)",
 "moon carrot": "جزر القمر, سيسيلي (جَزَرَ الماءُ عن الأَرضِ يَجْزُرُ جَزْراً: نَضَبَ وحَسَرَ؛ ويقال: جَزَرَ البَحْرُ والنَّهْرُ: انْحسرَ ماؤُهُ)\nمثال: ضع الجزر في القدر.",
 "moon curser": "مهرب (شخص يستورد أو يصدر دون دفع الرسوم)",
 "moon daisy": "أقحوان أبيض, أقحوان المروج (نبات أوراسي معمر طويل الساق ومورق بزهور بيضاء؛ متوطن على نطاق واسع)",
 "moon landing": "هُبُوط عَلَى الْقَمَر",
 "moon letter": "حُرُوف قَمَرِيَّة, حَرْف قَمَرِيّ (صِيْغَةُ جَمْعٍ مُفْرَدُهَا: حرف)\nمثال: كيف أتذكر الحروف الصينية؟",
 "moon ray": "شعاع القمر (شعاع من ضوء القمر)",
 "moon shell": "صدفة القمر (بطنيات قدم بحرية لها أصداف مستديرة ناعمة تشكل أبراجاً قصيرة)",
 "moon shot": "إطلاق للقمر, رحلة للقمر (إطلاق مركبة فضائية إلى القمر)",
 "moon trefoil": "برسيم قمري, فصة شجرية (شجيرة دائمة الخضرة من مرتفعات جنوب أوروبا ذات أوراق زغبية وسلسلة من الزهور الصفراء طوال الصيف تليها قرون حلزونية الشكل)",
 "moon-curser": "مهرب (شخص يستورد أو يصدر دون دفع الرسوم)",
 "moon-faced": "مُسْتَدِير الوَجْه (ذو وجه مستدير)",
 "moon-ray": "شعاع القمر (شعاع من ضوء القمر)",
 "moon-round": "قَمَرِيُّ الشَّكْل (يشبه القمر في شكله المستدير)",
 "moon-splashed": "مُرَشَّش بِضَوْء القَمَر (مُرَشَّش أو مُغَطًّى جزئياً بضوء القمر)",
 "moon-worship": "عبادة القمر (عبادة القمر)",
 "moonbeam": "شعاع القمر (شعاع من ضوء القمر)",
 "mooncake": "كَعْكَة اَلْقَمَر (واحدة الكَعْك؛ حَلْوَى تُصْنع من الدَقِيق والحَلِيب والسُكَّر والزَيت ويخبز طريًا وقد يوضع عليه القِشْطَة. يُسمى عند البعض كَيْك وعند البعض تُورْتَة)\nمثال: خبزت كعكة لتوم.",
 "mooneye": "عمى القمر (التهاب العين المتكرر في الخيول؛ يؤدي أحياناً إلى العمى)",
 "moonfish": "أوبا, سمكة القمر (سمكة كبيرة بيضاوية الشكل زاهية الألوان تعيش في أعماق المحيط الأطلسي والهادئ والبحر الأبيض المتوسط) / سمكة القمر (أي من عدة أسماك بحرية فضية ذات أجسام مسطحة جداً)",
 "moonflower": "أثمان أبيض, زهرة القمر (متسلق استوائي شامل له زهور ليلية بيضاء عطرة)",
 "moong": "لوبياء شعاعية, ماش (بذور نبات الماش المستخدمة كغذاء) / فول مونج, ماش (بذرة نبات الماش؛ تستخدم للغذاء)",
 "moonie": "موني (مصطلح غالباً ما يكون ازدرائياً لعضو في كنيسة التوحيد)",
 "moonily": "بِحَالِمِيَّة, بِشَكْل حَالِم (بطريقة حالمة)\nمثال: 'ستبدو جميلة في الفستان الجديد'، قال تومي بحالمية",
 "moonless": "غَيْر مُقْمِر (بدون قمر أو قمر مرئي)\nمثال: الليلة المظلمة غير المقمرة",
 "moonlight": "ضَوْء قَمَر (النُّور؛ مصدر ضَاء)\nمثال: ضوء القمر ضعيف.",
 "moonlighter": "عامل بوظيفة إضافية (شخص يشغل وظيفة ثانية (عادة بعد ساعات العمل))",
 "moonlike": "قَمَرِيُّ الشَّكْل (يشبه القمر في شكله المستدير)",
 "moonlit": "مُقْمِر",
 "moonrise": "شَفَق, غَسَق ((شَفِقَ) منه، وعليه يَشْفَقَ شَفَقًا: خاف وحَذِرَ، فهو شَفِقٌ؛ (شَفِقَ) عليه: رَقَّ له وعطف عليه؛ فهو شَفِيقٌ)\nمثال: أثارت تلك السلحفاة شفقة زيري.",
 "moonseed": "بذرة القمر",
 "moonset": "سُدْفَة, فَحْمَة",
 "moonshell": "صدفة القمر (بطنيات قدم بحرية لها أصداف مستديرة ناعمة تشكل أبراجاً قصيرة)",
 "moonshine": "خمر مهرب, مون شاين (ويسكي مقطر بشكل غير قانوني من هريس الذرة) / ضوء القمر (ضوء القمر)\nمثال: ضوء القمر هو عدو المهرب",
 "moonshiner": "مهرب كحول (شخص يصنع أو يبيع الخمور غير القانونية)",
 "moonshot": "مشروع رائد, مشروع طموح (مشروع طموح ذو احتمالية فشل عالية)",
 "moonstone": "حَجَرُ ٱلْقَمْر (حَجَرَ عليه الأمرَ:مَنَعَه منه ، حجر الشّيء على نفسه:خَصَّها به وقصره عليها؛ الحجْرُ: المَنْعُ مِن التَّصَرُّفِ ، وحَجَرَ عَلَيْهِ القاضِي يَحْجُرُ حَجْراً، إِذا مَنَعَه مِن التَّصَرُّفِ فِي مالِه)\nمثال: عوقب زيري بالحجر.",
 "moonstruck": "مَسْلُوبُ العَقْل, مَمْسُوسٌ بِالقَمَر (مجنون ويُعتَقد أنّ جنونه مرتبط بأطوار القمر)",
 "moonwalk": "مِشْيَة الْقَمَرِ",
 "moonwort": "بوتريشيوم قمري, عشبة القمر (من أمريكا وأوراسيا وأستراليا)",
 "moony": "حَالِم, سَارِح فِي الخَيَال (ذو طبيعة حالمة؛ يستغرق في أحلام اليقظة) / مُضَاء بِنُور القَمَر, مُقْمِر (مضاء بضوء القمر)\nمثال: المنظر الطبيعي المقمر",
 "moor": "بِرْكَة, سَبْخَة (مُسْتَنْقَع الماء أو أو بُحِيْرَة صغيرة؛ حوض الماء المصنوع لتزيين الحدائق وريها)\nمثال: البركة عميقة جدا.",
 "moor berry": "عنب المستنقعات (شجيرة دائمة الخضرة بأوراق جلدية)",
 "moor-bird": "طيهوج أحمر (طيهوج بني محمر يعيش في المستنقعات المرتفعة في بريطانيا العظمى)",
 "moorage": "إرساء, ربط السفينة (فعل تأمين سفينة واصلة بالحبال) / مربط, مرسى (مكان يمكن فيه تثبيت القارب أو السفينة) / رسوم الرسو (رسم للإرساء)",
 "moorbird": "طيهوج أحمر (طيهوج بني محمر يعيش في المستنقعات المرتفعة في بريطانيا العظمى)",
 "moorcock": "ديك الماء (ذكر طائر الطيهوج الأحمر)",
 "moorfowl": "طيهوج أحمر (طيهوج بني محمر يعيش في المستنقعات المرتفعة في بريطانيا العظمى)",
 "moorgame": "طيهوج أحمر (طيهوج بني محمر يعيش في المستنقعات المرتفعة في بريطانيا العظمى)",
 "moorhen": "دجاجة الماء (أنثى طائر الطيهوج الأحمر) / دجاجة الماء (دجاجة ماء سوداء تسكن البرك والبحيرات)",
 "mooring": "حبل إرساء ((مصطلح بحري) حبل يثبت جسماً (خاصة القارب) في مكانه) / مربط, مرسى (مكان يمكن فيه تثبيت القارب أو السفينة)",
 "mooring anchor": "مرساة إرساء (مرساة تستخدم لتثبيت عوامة إرساء أو علامة قناة في مكانها)",
 "mooring line": "حبل إرساء ((مصطلح بحري) حبل يثبت جسماً (خاصة القارب) في مكانه)",
 "mooring mast": "برج إرساء, سارية إرساء (برج لربط المناطيد والسفن الهوائية)",
 "mooring tower": "برج إرساء, سارية إرساء (برج لربط المناطيد والسفن الهوائية)",
 "moorish": "مغاربي, موريسكي (متعلق بالمغاربة (المور) أو مميز لهم) / العمارة المغاربية, العمارة المورية (طراز معماري شاع في إسبانيا من القرن الثالث عشر إلى السادس عشر؛ يتميز بالأقواس على شكل حدوة حصان)\nمثال: فناء مغاربي",
 "moorish arch": "قوس حدوة الحصان, قوس مغاربي (قوس مستدير يتسع قبل أن يدور)",
 "moorish architecture": "العمارة المغاربية, العمارة المورية (طراز معماري شاع في إسبانيا من القرن الثالث عشر إلى السادس عشر؛ يتميز بالأقواس على شكل حدوة حصان)",
 "moorish idol": "شُوش",
 "moorland": "أرض البراح, أرض سبخية (أرض مفتوحة عادة ذات تربة خثية مغطاة بالخلنج والسراخس والطحالب)",
 "moorwort": "أندروميدا, إكليل الجبل المستنقعي (شجيرة دائمة الخضرة سلكية لها عناقيد متدلية من الزهور البيضاء أو الوردية؛ من المناطق الحمضية الرطبة في القطب الشمالي وكندا إلى شمال شرق الولايات…)",
 "moose": "مُوظ",
 "moose-wood": "خشب الجلد, خشب الموس (شجيرة نفضية من شرق أمريكا الشمالية ذات أغصان مرنة قوية ولحاء لين وأزهار صفراء صغيرة) / خشب الموظ, قيقب مخطط (قيقب من شرق أمريكا الشمالية بلحاء مخطط وأوراق كبيرة ثنائية الفصوص صفراء صافية في الخريف)",
 "moosewood": "خشب الجلد, خشب الموس (شجيرة نفضية من شرق أمريكا الشمالية ذات أغصان مرنة قوية ولحاء لين وأزهار صفراء صغيرة) / خشب الموظ, قيقب مخطط (قيقب من شرق أمريكا الشمالية بلحاء مخطط وأوراق كبيرة ثنائية الفصوص صفراء صافية في الخريف)",
 "moot": "خِلَافِيّ, قَابِلٌ لِلنِّقَاش (مَفْتُوحٌ لِلنِّقَاشِ أَوِ الجَدَل) / محكمة صورية (قضية افتراضية يتجادل فيها طلاب القانون كتمرين) / أَكَادِيمِيّ, مَحْسُومٌ (ليس له أهمية قانونية لكونه قد بُتَّ فيه سابقاً)\nمثال: نظم المحكمة الصورية الأسبوعية",
 "moot court": "محكمة افتراضية, محكمة تدريبية (محكمة صورية حيث يترافع طلاب القانون في قضايا افتراضية)",
 "mop": "مِمْسَحَة",
 "mop handle": "عصا الممسحة (مقبض الممسحة)",
 "mop up": "إتمام, إكمال (إجراء ختامي أو نهائي)",
 "mop-headed": "كَثِيفُ القِمَّة ((عَنِ الأَشْجَار) لَهُ قِمَّةٌ كَثِيفَةٌ بِلَا سَاقٍ رَئِيسِيَّة)",
 "mopboard": "إزار الحائط, وزرة (إطار يغطي المفصل المكون من الجدار والأرضية)",
 "mope": "متلكئ, مضيع الوقت (شخص يضيع الوقت)",
 "moped": "دراجة نارية بدواسات, موبيد (دراجة نارية يمكن تحريكها بالدواسات أو قيادتها بمحرك بنزين منخفض الطاقة)",
 "mopes": "ضيق صدر, نكد (تعبير غير رسمي عن حالة اكتئاب خفيف)\nمثال: في حالة نكد",
 "mopper": "ماسح الأرضيات (عامل يستخدم الممسحة لتنظيف سطح ما)",
 "moppet": "طفلة صغيرة (فتاة صغيرة (عادة ما تكون مولعاً بها))",
 "mopping": "شطف, مسح (التنظيف بالممسحة)\nمثال: قام بمسحها جيداً",
 "moquelumnan": "لغة ميووك (لغة بينوتية يتحدث بها شعب ميووك)",
 "moquelumnan language": "لغة ميووك (لغة بينوتية يتحدث بها شعب ميووك)",
 "moquette": "موكيت (قماش صناعي مخملي سميك يستخدم للسجاد والمفروشات الناعمة)",
 "moraceous": "توتي (مكون من أو يخص أو مميز لنباتات الفصيلة التوتية)",
 "moraine": "ركام جليدي, مورين (تربة وحجارة متراكمة ترسبها الأنهار الجليدية)",
 "moral": "أَخْلَاقِيّ / عِظَة",
 "moral certainty": "قَنَاعَة وِجْدَانِيَّة, يَقِين أَخْلَاقِيّ (اليقين المبني على قناعة داخلية)\nمثال: كان لدى المدعي العام يقين أخلاقي بأن السجين مذنب",
 "moral excellence": "تميز أخلاقي, فضيلة (صفة فعل ما هو صواب وتجنب ما هو خطأ)",
 "moral force": "دينامية, قوة دافعة (حافز فعال أو قوة محركة)\nمثال: كانوا يأملون أن تعمل كقوة روحية دافعة لجميع الكنائس",
 "moral hazard": "خطر أخلاقي ((في الاقتصاد) غياب الحافز للحماية من المخاطر عندما تكون محمياً منها (كما هو الحال في التأمين))\nمثال: تتعرض شركات التأمين لخطر أخلاقي إذا لم يكن الطرف المؤمن عليه نزيهاً",
 "moral nihilism": "عدمية أخلاقية (وجهة نظر ما وراء الأخلاق القائلة بأنه لا شيء أخلاقي أو غير أخلاقي جوهرياً)",
 "moral obligation": "التزام أخلاقي (التزام ينشأ عن اعتبارات الصواب والخطأ)",
 "moral philosophy": "أخلاق, فلسفة أخلاقية (الدراسة الفلسفية للقيم والقواعد الأخلاقية)",
 "moral police": "مُطَّوِّعِين",
 "moral principle": "أخلاق, مبدأ أخلاقي (مبادئ الصواب والخطأ التي يقبلها فرد أو مجموعة اجتماعية) / مَبْدَأ أَخْلَاقِيّ (المبدأ القائل بأن السلوك يجب أن يكون أخلاقياً)\nمثال: الأخلاق البيوريتانية",
 "moral sense": "حس أخلاقي, ضمير (دافع نابع منطقياً من مبادئ أخلاقية تحكم أفكار الشخص وتصرفاته)",
 "moral support": "دعم معنوي (• دَعَمَهُ، كمنَعهُ: مالَ فأقامَهُ)\nمثال: ياني هنا لدعم ريمة.",
 "morale": "رُوح مَعْنَوِيَّة (رَوَّحَ عليه بالمِرْوحَة: حَرَّكَها ليجلبَ إِليه نسيمَ الهواء؛ رَوَّحَ بالقوم: صلَّى بهم التراويح)\nمثال: كان سامي هو روح الحفلة.",
 "morale booster": "تعزيز المعنويات, رفع المعنويات (أي شيء يعمل على زيادة الروح المعنوية)\nمثال: كان مشهد الزهور كل صباح هو ما يرفع معنوياتي",
 "morale builder": "تعزيز المعنويات, رفع المعنويات (أي شيء يعمل على زيادة الروح المعنوية) / رافع للمعنويات (شيء أو شخص يؤثر عن طريق بناء أو تعزيز الروح المعنوية)\nمثال: كان مشهد الزهور كل صباح هو ما يرفع معنوياتي",
 "morale building": "تعزيز المعنويات, رفع المعنويات (أي شيء يعمل على زيادة الروح المعنوية)\nمثال: كان مشهد الزهور كل صباح هو ما يرفع معنوياتي",
 "moralisation": "أخلَقة, تهذيب أخلاقي (فعل جعل الشيء أخلاقياً (أو أكثر أخلاقية)) / تخليق, وعظ (الانغماس في التصريحات الأخلاقية؛ عرض (غالباً بشكل سطحي) لمدونة أخلاقية معينة)\nمثال: عملت لسنوات من أجل إضفاء الطابع الأخلاقي على الأدب الإنجليزي",
 "moralism": "حكم أخلاقي, وعظ أخلاقي (أحكام حول أخلاق شخص آخر) / عظة أخلاقية (حكمة أخلاقية)\nمثال: لم يستطع تحمل وعظها الأخلاقي المتسلط",
 "moralist": "صارم, متشدد (شخص يطلب الالتزام التام بالقواعد والشكليات) / أخلاقي (فيلسوف متخصص في الأخلاق والمشكلات الأخلاقية)",
 "moralistic": "مُتَزَمِّتٌ أَخْلَاقِيًّا, وَعْظِيّ (أَخْلَاقِيٌّ بِشَكْلٍ ضَيِّقٍ وَتَقْلِيدِيّ)",
 "morality": "أَخْلَاق, أَخْلَاقِيَّة",
 "morality play": "مسرحية أخلاقية (مسرحية رمزية شاعت في القرنين الخامس عشر والسادس عشر؛ حيث تجسد الشخصيات الفضائل والرذائل)",
 "moralization": "أخلَقة, تهذيب أخلاقي (فعل جعل الشيء أخلاقياً (أو أكثر أخلاقية)) / تخليق, وعظ (الانغماس في التصريحات الأخلاقية؛ عرض (غالباً بشكل سطحي) لمدونة أخلاقية معينة)\nمثال: عملت لسنوات من أجل إضفاء الطابع الأخلاقي على الأدب الإنجليزي",
 "moralizing": "تخليق, وعظ (الانغماس في التصريحات الأخلاقية؛ عرض (غالباً بشكل سطحي) لمدونة أخلاقية معينة)\nمثال: كان وعظه المستمر يقودني للجنون",
 "morally": "أخلاقياً (فيما يتعلق بالمبادئ الأخلاقية) / أخلاقياً, بفضيلة (بطريقة أخلاقية)\nمثال: غير مبرر أخلاقياً",
 "morals": "أخلاق, دافع أخلاقي (دافع يستند إلى مبادئ الصواب والخطأ)",
 "morangoska": "مورانغوسكا (نوع برتغالي من الكايبيرينيا يصنع باستخدام الفراولة بدلاً من الليمون الأخضر)",
 "morass": "مستنقع موحل, وحل (منطقة رطبة ناعمة من الأراضي المنخفضة تغوص تحت الأقدام)",
 "moratorium": "اِسْتِمْهَال",
 "moravia": "مُورَافِيَا",
 "moravian": "مورافي (من أو يتعلق بشعب أو ثقافة مورافيا)",
 "moray": "أنقليس موراي, موراي (فصيلة من الأنقليس النهم زاهي الألوان يعيش في المياه الساحلية الدافئة؛ عموماً غير عدواني للبشر لكن الأنواع الكبيرة خطيرة إذا استُفزت)",
 "moray eel": "أنقليس موراي, موراي (فصيلة من الأنقليس النهم زاهي الألوان يعيش في المياه الساحلية الدافئة؛ عموماً غير عدواني للبشر لكن الأنواع الكبيرة خطيرة إذا استُفزت)",
 "morbid": "مَرْضِيّ",
 "morbidity": "إِمْرَاض, فَسَاد (صفة كون الشيء غير صحي وضاراً بشكل عام) / سوداوية, كآبة مرضية (حالة ذهنية كئيبة أو غير صحية بشكل غير طبيعي) / مُعَدَّل المَرَض, نِسْبَة الِاعْتِلَال (معدل الحدوث النسبي لمرض معين)\nمثال: خوفه من البقاء وحيداً يقارب الحالة المرضية",
 "morbidly": "بشكل مرضي (بطريقة مرضية أو لدرجة مرضية)\nمثال: كان مفتوناً بشكل مرضي بالجثث",
 "morbidness": "إِمْرَاض, فَسَاد (صفة كون الشيء غير صحي وضاراً بشكل عام) / سوداوية, كآبة مرضية (حالة ذهنية كئيبة أو غير صحية بشكل غير طبيعي)\nمثال: خوفه من البقاء وحيداً يقارب الحالة المرضية",
 "morbific": "مُعْدٍ, مُمْرِض (يُسَبِّب العَدْوى أو المَرَض)",
 "morbilli": "حصبة (مرض فيروسي حاد وشديد العدوى يتميز ببقع حمراء مميزة يتبعها طفح جلدي)",
 "morbilliform": "حصبي الشكل (للطفح الجلدي الذي يشبه طفح الحصبة)",
 "morceau": "مقطوعة قصيرة, نبذة فنية (تكوين أدبي أو موسيقي قصير)",
 "morchella angusticeps": "غوشنة مخروطية, موريل أسود (موريل جسمه الخصب المحفور متصل بالساق مع تنورة حرة صغيرة حوله؛ الجسم الخصب رمادي عندما يكون صغيراً وأسود في الشيخوخة)",
 "morchella conica": "غوشنة مخروطية, موريل أسود (موريل جسمه الخصب المحفور متصل بالساق مع تنورة حرة صغيرة حوله؛ الجسم الخصب رمادي عندما يكون صغيراً وأسود في الشيخوخة)",
 "morchella crassipes": "موريل سميك القدم (موريل لذيذ بجزء خصب مخروطي به حفر عميقة وغير منتظمة)",
 "morchella esculenta": "غوشنة مألوفة, موريل شائع (موريل صالح للأكل وممتاز ذو رأس كروي إلى مستطيل بنمط غير منتظم من الحفر والنتوءات)",
 "morchella semilibera": "موريل نصف حر (موريل جزؤه الخصب ذو النتوءات والحفر متصل بالساق لنحو نصف طوله)",
 "mordacious": "عَضُوض, لَدُوغ (يعضّ أو مَيَّال إلى العضّ) / جَارِح, لَاذِع (قادر على إيلام المشاعر وجرحها)",
 "mordaciously": "بتهكم, بشكل لاذع (بطريقة لاذعة)\nمثال: سخرت منه بشكل لاذع",
 "mordacity": "عضاضية (ميل للعض)",
 "mordant": "أَكَّال, كَاوٍ ((عَنْ مَادَّةٍ، خَاصَّةً حَمْضٍ قَوِيٍّ) قَادِرٌ عَلَى إِتْلَافِ المَوَادِّ أَوْ تَآكُلِهَا) / سَوْدَاوِيّ, قَاتِم (ساخر بقسوة؛ ذو طابع مُشؤوم) / مادة لاذعة, مثبت لون (مادة تستخدم لمعالجة الجلود أو المواد الأخرى قبل الصباغة؛ تساعد في عملية الصباغة)",
 "mordecai": "مَرْدْخَاي, مَرْخَان",
 "mordva": "الموردفينية (اللغة الفينية التي يتحدث بها الموردفينيون) / موردفي, موردفيني (عضو من الشعب الزراعي الذي يعيش في مقاطعات الفولغا المركزية في روسيا الأوروبية)",
 "mordva language": "الموردفينية (اللغة الفينية التي يتحدث بها الموردفينيون)",
 "mordvin": "الموردفينية (اللغة الفينية التي يتحدث بها الموردفينيون) / موردفي, موردفيني (عضو من الشعب الزراعي الذي يعيش في مقاطعات الفولغا المركزية في روسيا الأوروبية)",
 "mordvin language": "الموردفينية (اللغة الفينية التي يتحدث بها الموردفينيون)",
 "mordvinian": "الموردفينية (اللغة الفينية التي يتحدث بها الموردفينيون) / موردفي, موردفيني (عضو من الشعب الزراعي الذي يعيش في مقاطعات الفولغا المركزية في روسيا الأوروبية)",
 "mordvinian language": "الموردفينية (اللغة الفينية التي يتحدث بها الموردفينيون)",
 "more": "أَكْثَر",
 "more and more": "أكثر فأكثر, بشكل متزايد (يتقدم في الكمية أو الكثافة)\nمثال: أصبحت مكتئبة بشكل متزايد",
 "more often than not": "بشكل عام, في الغالب (عادة؛ كقاعدة)\nمثال: بشكل عام لا تمطر كثيراً هنا",
 "more or less": "حَوَالِي",
 "more than": "أكثر, مزيد من ((صيغة المقارنة من 'كثير' للمعدود وغير المعدود) محدد كمية يعني أكبر في الحجم أو الكمية أو المدى أو الدرجة)\nمثال: مزيد من الأرض",
 "more-mover": "مَسْأَلَة مُتَعَدِّدَة النَّقَلَات (كش مات مباشر بشرط 'الأبيض يتحرك وينفذ كش مات للأسود في ما لا يزيد عن ن من النقلات ضد أي دفاع' حيث ن أكبر من 3)",
 "moreen": "مورين (قماش ثقيل من الصوف (أو الصوف والقطن) يستخدم غالباً في التنجيد أو للستائر)",
 "morel": "غَوْشَنَة",
 "morelia spilotes variegatus": "ثعبان السجاد (بايثون أسترالي بنمط متنوع الألوان على ظهره)",
 "morello": "كرز موريلو (كرز حامض مزروع ذو قشرة وعصير داكن اللون) / موريلو (أي من عدة أشجار كرز حامض مزروعة تحمل فاكهة بقشرة وعصير داكنين)",
 "moreover": "عِلَاوَة عَلَى ذٰلِكَ, أَضِف إِلَى ذٰلِك",
 "mores": "أعراف ((علم الاجتماع) التقاليد التي تجسد القيم الأساسية للمجموعة)",
 "moresque": "مغاربي, موريسكي (متعلق بالمغاربة (المور) أو مميز لهم)\nمثال: فناء مغاربي",
 "moreton bay chestnut": "كستناء أسترالية, كستناء خليج مورتون (شجرة أسترالية لها أوراق ريشية وزهور برتقالية صفراء تليها قرون خشبية كبيرة تحتوي على 3 أو 4 بذور تشبه الكستناء؛ تنتج خشباً قوياً داكناً)",
 "moreton bay pine": "صنوبر الطوق (صنوبر من أستراليا وغينيا الجديدة؛ ينتج خشباً قيماً خفيفاً متساوي الملمس)",
 "moreton bay tulipwood": "خشب التوليب موريتون باي (شجرة أسترالية تنتج خشب توليب مبرقش)",
 "morgan": "مَوْرْغَان",
 "morgan le fay": "مُورْغَان اَلجِنِّيَّة",
 "morganatic": "مُورْغَنَاتِيّ (زَواج بَيْنَ شَخْصَيْن مُخْتَلِفَيْ المَرْتَبَة لا يَرِث فيه الأَبْناء لَقَب الأَب)",
 "morganite": "مورغانيت (نوع من البيريل الوردي يستخدم كحجر كريم)",
 "morgen": "مورغن (وحدة قياس في جنوب إفريقيا تساوي حوالي 2 فدان (إيكر))",
 "morgue": "مَشْرَحَة",
 "moribund": "مُحْتَضِر, يُنَازِع (على وَشَك الموت؛ يلفظ أنفاسه الأخيرة) / رَاكِد, مُحْتَضِر (لا ينمو ولا يتغيّر؛ بلا قوّة أو حيوية)",
 "morioka": "مُورْيُوكَا",
 "morion": "خوذة موريون (خوذة معدنية كان يرتديها الجنود العاديون في القرن السادس عشر)",
 "morlett's crocodile": "تمساح مورليت (نوع من التماسيح)",
 "mormon": "مورمون",
 "mormon church": "كنيسة المورمون, كنيسة يسوع المسيح لقديسي الأيام الأخيرة (كنيسة أسسها جوزيف سميث عام 1830 ومقرها الرئيسي في سولت ليك سيتي، يوتا)",
 "mormon cricket": "صرصور المورمون (نطاط كبير داكن عديم الأجنحة يشبه الصرصور من المناطق القاحلة في غرب الولايات المتحدة)",
 "mormonism": "مورمونية",
 "mormons": "كنيسة المورمون, كنيسة يسوع المسيح لقديسي الأيام الأخيرة (كنيسة أسسها جوزيف سميث عام 1830 ومقرها الرئيسي في سولت ليك سيتي، يوتا)",
 "morn": "صباح, ضحى (الفترة الزمنية بين الفجر والظهر)\nمثال: قضيت الصباح في قضاء المصالح",
 "mornay sauce": "صلصة مورناي (صلصة جبن كريمية بنكهة البصل مع صفار البيض وجبن مبشور)",
 "mornight": "تحية الصباح والمساء (تعبير يجمع بين الصباح والمساء، يستخدم عند تحية شخص ما (غير شائع في العربية))",
 "morning": "صَبَاح / غُدْوة / صُبْح (أَشْرَقَ، أَضَاءَ) / صباح / صُبُح (أَشْرَقَ، أَضَاءَ)\nمثال: كان يريد أن بصبح حاخاما.",
 "morning coat": "بدلة ذيل, معطف ذيل السنونو (سترة رسمية للرجال بذيلين طويلين مدببين في الخلف)",
 "morning dress": "فستان منزلي صباحي (فستان نسائي غير رسمي للأعمال المنزلية) / زي صباحي رسمي (زي رسمي للرجال خلال النهار)",
 "morning glory": "أثمان, مجد الصباح (أي من الكروم الملتفة المتنوعة ذات أزهار قمعية الشكل تغلق في وقت متأخر من اليوم)",
 "morning prayer": "صلاة الباكر, صلاة الصبح (الساعة القانونية الأولى؛ عند الفجر)",
 "morning room": "غرفة صباحية (غرفة جلوس تُستخدم خلال ساعات النهار)",
 "morning sickness": "غَثَيَان الحَمْل (جاشت النفس واضطربت واستعدت للقَيء؛ الاِشْمِئْزَاز والقَرَف)\nمثال: كنت أشعر بالغثيان.",
 "morning star": "نَجْمَة الصَّبَاح",
 "morning time": "صباح, ضحى (الفترة الزمنية بين الفجر والظهر)\nمثال: قضيت الصباح في قضاء المصالح",
 "morning-after pill": "حبة الصباح التالي (جرعة كبيرة من الإستروجين تؤخذ عن طريق الفم في غضون 24 إلى 72 ساعة بعد الجماع؛ تمنع انغراس البويضة المخصبة وبالتالي تعمل كمانع للحمل؛ تستخدم عادة بعد…)",
 "moro": "مورو (عضو في الشعب الذي يغلب عليه الإسلام في جنوب الفلبين)",
 "moro reflex": "منعكس الإجفال, منعكس مورو (منعكس طبيعي للرضع الصغار؛ تسبب الضوضاء العالية المفاجئة قيام الطفل بمد ذراعيه وثني ساقيه)",
 "moroccan": "مَغْرِبِيّ, مَغْرِبِيَّة (كل ما ينتمي للمغرب، مكان غُرُوب الشَّمس؛ كل ما له علاقة بوقت غروب الشمس)\nمثال: أنا ريفية مغربية.",
 "moroccan dirham": "درهم, درهم مغربي (وحدة المال الأساسية في المغرب؛ تساوي 100 سنتيم)",
 "moroccan monetary unit": "وحدة نقدية مغربية (الوحدة النقدية في المغرب)",
 "morocco": "الْمَغْرِب ( رَسْمِيّاً الْمَمْلَكَة الْمَغْرِبِيَّة، هُوَ الْبَلَد الَّذِي يَقَع فِي أقْصَى شَمَال غَرْب القَارَّة الإِفْرِيقية؛  مَجْمُوعَةُ دُوَلٍ تقَع شَمَال غربَ إفْريقيا، وَتَضُمُّ اَلْمَغْرِب وَمُورِيتَانْيَا وَالْجَزَائِر وَتُونُس وَلِيبْيَا)\nمثال: يعيش في المغرب.",
 "moron": "أبله, متخلف عقلياً (شخص ذو ذكاء دون الطبيعي)",
 "morone americana": "فرخ أبيض (سمكة غذائية ورياضية فضية صغيرة في جداول شرق الولايات المتحدة)",
 "morone interrupta": "باس أصفر (باس مياه عذبة في أمريكا الشمالية يشبه الباس المخطط البحري الأكبر)",
 "moroni": "مُورُونِي",
 "moronic": "ضَعِيف الذِّهْن (ذو عمر عقلي يتراوح بين ثماني واثنتي عشرة سنة)",
 "moronity": "بله, قصور ذهني بسيط (تخلف عقلي بسيط)",
 "morosaglia": "موروزاليا",
 "morose": "عَبُوس, كَئِيب (يُظهر مزاجاً قاتماً ومكتئباً)",
 "morosely": "بتجهم, بنكد (بطريقة متجهمة)\nمثال: سقط بتجهم على السرير",
 "moroseness": "تجهم, عبوس (طبع عبوس ومتقلب المزاج ومستاء) / تجهم, عبوس (شعور كئيب وسيء المزاج)",
 "morosoph": "أحمق متعالم (أحمق متعلم)",
 "morphallaxis": "تجدد شكلي (تجدد على نطاق منخفض لجزء من الجسم؛ لوحظ خاصة في اللافقاريات مثل بعض أنواع الكركند)",
 "morphea": "مورفيا (تصلب الجلد الموضعي)",
 "morpheme": "مُورْفِيم, مَقْطَع صَرْفِيّ",
 "morphemic": "صرفي, مورفيمي (من أو يتعلق بالمورفيمات (الوحدات الصرفية الصغرى))",
 "morphia": "مورفيا, مورفين (دواء مخدر قلويدي يستخرج من الأفيون؛ مخدر قوي يسبب التعود يستخدم لتخفيف الألم)",
 "morphine": "مُورْفِين",
 "morphogenesis": "تشكل, تكون الشكل (تمايز ونمو هيكل كائن حي (أو جزء من كائن حي))",
 "morphologic": "بنيوي, مورفولوجي (يتعلق بمورفولوجيا (شكل وبنية) النباتات والحيوانات) / بنيوي, جيومورفولوجي (يتعلق بالبنية الجيولوجية) / صرفي, مورفولوجي (يتعلق بتكوين الكلمات المقبولة في لغة ما)\nمثال: اختلافات مورفولوجية",
 "morphological": "مُورْفُولُوجِي, صَرْفِيّ",
 "morphological rule": "قاعدة صرفية (قاعدة لغوية لتكوين الكلمات)",
 "morphologically": "شكلياً, مورفولوجياً (بطريقة مورفولوجية؛ فيما يتعلق بعلم الشكل)\nمثال: هذان النباتان مرتبطان مورفولوجياً",
 "morphology": "مُورْفُولُوجِيَا / صَرْف (بمعنى أبْعَدَ عن القَصْد أو الغَايَة أو محل الاهتمام؛ بمعنى اَنْفَقَ المَال وبمعنى الرَدّ والمَنْع) / تَصْرِيف\nمثال: أيمكنك صرف خمسين؟",
 "morphophoneme": "صوت صرفي, مورفوفونيم ((لغويات) الفونيمات (أو سلاسل الفونيمات) التي تشكل الألومورفات المختلفة لمورفيم ما)",
 "morphophonemic": "صرفي صوتي, مورفوفونيمي (من أو يتعلق بالمورفوفونيمات (التغيرات الصوتية الصرفية))",
 "morphophonemic system": "نظام الصرف الصوتي (الصرف الصوتي للغة معينة)",
 "morphophonemics": "علم الصرف الصوتي (دراسة التحقق الصوتي للمتغيرات الصرفية لمورفيمات اللغة)",
 "morphophysiology": "تشريح وظيفي (دراسة التشريح في علاقته بالوظيفة)",
 "morris chair": "كرسي موريس (كرسي بذراعين ذو ظهر قابل للتعديل)",
 "morris dance": "رقص موريس (أي من الرقصات الشعبية الإنجليزية المختلفة يؤديها راقصون بملابس تنكرية)",
 "morris dancer": "راقص موريس (شخص يمارس رقصة موريس)",
 "morris dancing": "رقص موريس (أي من الرقصات الشعبية الإنجليزية المختلفة يؤديها راقصون بملابس تنكرية)",
 "morrow": "الغد (اليوم التالي)\nمثال: متى وصل فإنها تغادر في الغد",
 "morrow's honeysuckle": "عسلة مورو (شجيرة عسلة متساقطة الأوراق رمادية بزهور بيضاء مزدوجة تتحول إلى صفراء؛ اليابان)",
 "morse": "شيفرة مورس (شيفرة تلغراف تُمثَّل فيها الحروف والأرقام بسلاسل من النقاط والشرطات (إشارات قصيرة وطويلة))",
 "morse code": "شِفْرَة مُورْس",
 "morsel": "قَطْمَة",
 "mortal": "إنسان, شخص (كائن بشري؛ فرد من البشر) / فَتَّاك, مُمِيت (يُسَبِّب أَوْ قَادِر عَلَى التَّسَبُّب فِي المَوْت) / فانٍ, مائت (عرضة للموت)\nمثال: كان هناك الكثير ليفعله شخص واحد",
 "mortal enemy": "عدو لدود (عدو يريد قتلك)",
 "mortal sin": "خطيئة مميتة, كبيرة من الكبائر (خطيئة لا تغتفر تستوجب فقدان النعمة الإلهية تماماً)\nمثال: يدرج اللاهوتيون سبع خطايا مميتة",
 "mortality": "فناء, موت (الجودة أو الحالة المتمثلة في كونه فانياً) / مُعَدَّل الوَفَيَات (نسبة الوفيات في منطقة ما إلى سكان تلك المنطقة؛ يُعبر عنها لكل 1000 في السنة)",
 "mortality rate": "مُعَدَّل الوَفَيَات (نسبة الوفيات في منطقة ما إلى سكان تلك المنطقة؛ يُعبر عنها لكل 1000 في السنة)",
 "mortality table": "جدول الوفيات (جدول إكتواري يبين متوسط العمر المتوقع واحتمالية الوفاة كدالة للعمر والجنس والمهنة وما إلى ذلك)",
 "mortally": "بشكل مميت, حتى الموت (بطريقة تؤدي إلى الموت (تستخدم أيضاً للإشارة إلى الكراهية الشديدة أو الغيرة أو الخوف، إلخ))\nمثال: كائن يقال إن هنود الغابات خائفون منه حتى الموت، بحافر على شكل كعب الزجاجة",
 "mortar": "مِلَاط / مِهْرَاس, هَاوُن / هَاوُن, مِدْفَعُ الهَاوُن / هَاوُن",
 "mortar fire": "نيران هاون (نيران مدفعية يتم إطلاقها بواسطة هاون)",
 "mortarboard": "قبعة التخرج (قبعة أكاديمية ذات مربع مسطح وشرابة في الأعلى) / لوح الملاط (لوح مربع بمقبض تحته؛ يستخدمه البناؤون لحمل أو نقل الملاط)",
 "mortgage": "رَهْن, رَهْن عَقَارِيّ ((رَهَنَ) الشيءُ يَرْهَنُ رهْنًا، ورُهُونا: ثَبَت ودامَ؛ يقال (رَهَنَ) بالمكان: أقامَ)\nمثال: رهن فاضل الحلي.",
 "mortgage application": "طَلَب رَهْن عَقَارِيّ (طلب للحصول على قرض عقاري)",
 "mortgage deed": "سند رهن عقاري (صك يتضمن رهناً عقارياً)",
 "mortgage holder": "حامل الرهن, دائن مرتهن (الشخص الذي يقبل الرهن العقاري)\nمثال: أصبح البنك هو الدائن المرتهن عندما قبل رهن منزلنا الجديد",
 "mortgage loan": "رهن عقاري, قرض عقاري (قرض عقاري عادة ما يكون مضموناً برهن)",
 "mortgage-backed security": "ورقة مالية مدعومة بالرهن العقاري (ورقة مالية تنشأ عند تجميع مجموعة من القروض العقارية وبيع السندات لمؤسسات أخرى أو للجمهور؛ يتلقى المستثمرون جزءاً من مدفوعات الفائدة على القروض…)",
 "mortgaged": "مَرْهُون (مُثقَل بالتزامات قانونية أو مالية)",
 "mortgagee": "حامل الرهن, دائن مرتهن (الشخص الذي يقبل الرهن العقاري)\nمثال: أصبح البنك هو الدائن المرتهن عندما قبل رهن منزلنا الجديد",
 "mortgager": "راهن (الشخص الذي يعطي رهناً عقارياً مقابل المال الذي سيتم سداده)\nمثال: أصبحنا راهنين عندما قبل البنك رهننا وأقرضنا المال لشراء منزلنا الجديد",
 "mortgagor": "راهن (الشخص الذي يعطي رهناً عقارياً مقابل المال الذي سيتم سداده)\nمثال: أصبحنا راهنين عندما قبل البنك رهننا وأقرضنا المال لشراء منزلنا الجديد",
 "mortice": "نقر (ثقب مربع مصنوع لاستقبال اللسان وتشكيل وصلة)",
 "mortician": "حفار قبور, متعهد دفن الموتى (شخص عمله إدارة الجنازات)",
 "mortification": "إماتة الشهوات, قهر الجسد (فعل إماتة شهوات الجسد عن طريق إنكار الذات والحرمان) / إذلال, إهانة (حالة يتم فيها التسبب لك بفقدان الهيبة أو احترام الذات) / إذلال, انكسار (مشاعر قوية من الإحراج) / تموت, غرغرينا (الموت الموضعي للخلايا الحية (بسبب العدوى أو انقطاع تدفق الدم))\nمثال: كان عليه أن يتحمل إهانة تلو الأخرى",
 "mortified": "ذَلِيل, مُحْرَج (شعر بالضيق بسبب الخجل أو جُرح كرامته) / غَنْغَرِينِيّ, مُتَآكِل (مُصاب بِمَوْت الأنْسِجَة (الغَنْغَرينا))",
 "mortifying": "مُذِلّ, مُهِين (يُثِير الشُّعُور بِالنَّقْص أَوِ القُصُور) / مُحْرِج, مُخْجِل (يسبب الشعور بالخجل أو الانزعاج أو الضيق)",
 "mortise": "نقر (ثقب مربع مصنوع لاستقبال اللسان وتشكيل وصلة)",
 "mortise joint": "تعشيق, وصلة نقر ولسان (وصلة تصنع عن طريق إدخال لسان في قطعة داخل ثقوب النقر في الأخرى) / كاحل, مفصل الكاحل (مفصل انزلاقي بين النهايات البعيدة للقصبة والشظية والنهاية القريبة للكاحل)",
 "mortise-and-tenon joint": "تعشيق, وصلة نقر ولسان (وصلة تصنع عن طريق إدخال لسان في قطعة داخل ثقوب النقر في الأخرى)",
 "mortmain": "اليد الميتة, سطوة الماضي (التأثير القمعي للأحداث أو القرارات الماضية) / الوقف المؤبد, اليد الميتة (الممتلكات العقارية المحتفظ بها بشكل غير قابل للتصرف (كما هو الحال من قبل مؤسسة كنسية))",
 "mortuary": "جنائزي (من أو يتعلق بالجنازة) / موتي (من أو يتعلق بالموت أو يميزه) / دار الجنائز, مشررحة (مبنى (أو غرفة) تُحفظ فيه الجثث قبل الدفن أو الحرق)",
 "morula": "توتية (كتلة صلبة من القسيمات الأريمية تتشكل عندما تنقسم اللاقحة؛ تتطور إلى الأريمة)",
 "morus alba": "توت أبيض (توت آسيوي بفاكهة بيضاء إلى حمراء شاحبة؛ تستخدم الأوراق لتغذية ديدان القز)",
 "morus nigra": "توت أسود (توت أوروبي له أوراق وثمار داكنة)",
 "morus rubra": "توت أحمر (توت من أمريكا الشمالية له فاكهة أرجوانية داكنة صالحة للأكل)",
 "mosaic": "فُسَيْفِسَاء (قطَِعٌ صَغِيرَةٌ مُلَوَّنَةٌ مِنَ الزَّلِّيجِ)",
 "mosaic culture": "ثقافة فسيفسائية, ثقافة متنوعة (ثقافة شديدة التنوع)\nمثال: تؤدي الثقافة الفسيفسائية للمدينة إلى تنوع كبير في الفنون",
 "mosaic gold": "ذهب فسيفسائي, كبريتيد القصديريك (خضاب أصفر يعلق أحياناً في الطلاء)",
 "mosaic law": "شريعة موسى (القوانين (بدءاً من الوصايا العشر) التي أعطاها الله لبني إسرائيل عن طريق موسى؛ وتتضمن العديد من قواعد الشعائر الدينية الواردة في الكتب الخمسة الأولى…)",
 "mosaicism": "فسيفسائية (الحالة التي يكون فيها للكائن الحي مجموعتان أو أكثر من الخلايا التي تختلف في التركيب الجيني)",
 "mosan": "لغات موسان (عائلة من لغات الهنود الحمر يتم التحدث بها في واشنطن وكولومبيا البريطانية)",
 "moschus moschiferus": "أيل المسك (أيل صغير ثقيل الأطراف يعيش في مرتفعات وسط آسيا؛ يفرز الذكر مسكاً ثميناً)",
 "moscow": "مُوسْكُو",
 "moselle": "موزيل (نبيذ أبيض ألماني من وادي موزيل أو نبيذ مماثل مصنوع في مكان آخر)",
 "moses": "مُوسَىٰ (اسم شخصي معطًى لدى الذكور من المسلمين؛ حَادَّة من الحَدِيد تُسْتَخدم لحِلَاقَة الرَأْس أو الذِقْن) / مُوسَى (اسم شخصي معطًى لدى الذكور من المسلمين؛ حَادَّة من الحَدِيد تُسْتَخدم لحِلَاقَة الرَأْس أو الذِقْن)\nمثال: نحن المسلمون نؤمن بعيسى وموسى.",
 "moshav": "موشاف (قرية أو مستوطنة إسرائيلية تعاونية تتكون من مزارع صغيرة)",
 "moslem": "إسلامي, مسلم (متعلق بالإسلام أو مؤيد له) / مسلم (مؤمن بالإسلام أو متبع له)\nمثال: فن إسلامي",
 "moslem calendar": "تقويم إسلامي, تقويم هجري (التقويم القمري الذي يستخدمه المسلمون؛ يؤرخ من عام 622 م (عام الهجرة)؛ وتتراجع بداية السنة الإسلامية خلال السنة الشمسية مكملة الدورة كل 32 عاماً)",
 "mosque": "مَسْجِد, جَامِع (هو مكان السُجُوْد، بناء كان أم لا، عاما كان أم خاصا؛ المُصَلَّى)\nمثال: دخل إلى المسجد.",
 "mosquito": "بَعُوضَة, نَامُوسَة",
 "mosquito bite": "لسعة بعوضة (لسعة تسببها بعوضة)",
 "mosquito boat": "قارب طوربيد للدوريات (قارب طوربيد صغير سريع غير مدرع ومسلح تسليحاً خفيفاً)",
 "mosquito craft": "قارب طوربيد للدوريات (قارب طوربيد صغير سريع غير مدرع ومسلح تسليحاً خفيفاً)",
 "mosquito fern": "أزولا كارولينية, سرخس البعوض (سرخس مائي صغير حر الطفو من شرق الولايات المتحدة إلى أمريكا الاستوائية؛ متوطن في غرب وجنوب أوروبا)",
 "mosquito hawk": "صقر الليل (سبد ليلي بشكل رئيسي من أمريكا الشمالية) / يعسوب (حشرة نحيلة الجسم غير لاسعة ذات أجنحة قزحية الألوان تكون مفرودة عند الراحة؛ تتغذى البالغات والحوريات على البعوض وما إلى ذلك)",
 "mosquito net": "نَامُوسِيَّة",
 "mosquitofish": "سمكة البعوض (سمكة فضية ذات صفوف من البقع السوداء تعيش في أمريكا الشمالية الاستوائية وجزر الهند الغربية؛ مهمة في مكافحة البعوض)",
 "moss": "أُشْنَة, طُحْلُب",
 "moss agate": "عقيق طحلبي (عقيق يشبه الطحالب بعلامات بنية أو سوداء أو خضراء)",
 "moss animal": "حيوان طحلبي, مرجانيات (حيوان مائي لاطئ يشكل مستعمرات طحلبية من سلائل صغيرة)",
 "moss campion": "سيلينة طحلبية, سيلينة لا ساقية (نبات معمر قزم يشكل خصلة أو حصيرة في المناطق القطبية في غرب ووسط أوروبا وأمريكا الشمالية)",
 "moss family": "فصيلة حزازيات (فصيلة من الحزازيات)",
 "moss genus": "جنس طحلبي (جنس من الطحالب)",
 "moss green": "أَخْضَر طُحْلُبِيّ (بلون أخضر مصفر معتدل باهت نوعاً ما)",
 "moss locust": "روبينيا شعراء, سنط وردي (شجيرة كبيرة أو شجرة صغيرة في شرق الولايات المتحدة لها سيقان خشنة وعناقيد كبيرة من الزهور الوردية)",
 "moss phlox": "قبس جبلي, قبس طحلبي (قبس معمر منخفض ذو خصلات بأوراق دائمة الخضرة تشبه الإبر وزهور وردية أو بيضاء؛ موطنه الولايات المتحدة ويزرع على نطاق واسع كغطاء أرضي)",
 "moss pink": "قبس جبلي, قبس طحلبي (قبس معمر منخفض ذو خصلات بأوراق دائمة الخضرة تشبه الإبر وزهور وردية أو بيضاء؛ موطنه الولايات المتحدة ويزرع على نطاق واسع كغطاء أرضي) / لينانثوس (عشب متفرع بساق سلكية منخفض من جنوب كاليفورنيا له زهور وردية مهدبة)",
 "moss-grown": "رَجْعِيّ, مُتَحَجِّر ((ازدرائيًّا) قَدِيم الطِّرَاز وَمُتَخَلِّف عَنِ العَصْر) / مُطَحْلَب (مُكتسٍ بالطحلب بشكل مفرط)",
 "moss-trooper": "قاطع طريق (لص ومغير (كان يعمل أصلاً في المستنقعات بين إنجلترا واسكتلندا))",
 "mossad": "الْمُوسَاد",
 "mossback": "رجعي متطرف (محافظ قديم الطراز للغاية)",
 "mosstone": "أَخْضَر طُحْلُبِيّ (بلون أخضر مصفر معتدل باهت نوعاً ما)",
 "mossy": "رَجْعِيّ, مُتَحَجِّر ((ازدرائيًّا) قَدِيم الطِّرَاز وَمُتَخَلِّف عَنِ العَصْر) / مُطَحْلَب (مُكتسٍ بالطحلب بشكل مفرط)",
 "mossy saxifrage": "ساكسفراجا هيبنويدس, كاسر الحجر الطحلبي (نبات معمر ذو خصلات أو يشكل حصيرة في جبال أوروبا؛ يزرع لزهوره البيضاء)",
 "mossy-cup oak": "سنديان كبير الثمار (سنديان نفضي متوسط إلى كبير الحجم موطنه وسط وشرق أمريكا الشمالية، له بلوط بيضوي مغمور بعمق في أقماع كبيرة مهدبة؛ ينتج خشباً قوياً ناعم الحبيبات)",
 "mossycup oak": "سنديان كبير الثمار (سنديان نفضي متوسط إلى كبير الحجم موطنه وسط وشرق أمريكا الشمالية، له بلوط بيضوي مغمور بعمق في أقماع كبيرة مهدبة؛ ينتج خشباً قوياً ناعم الحبيبات)",
 "most": "أَكْثَر, أَغْلَب / جِدًّا (كلمة \"جدا\" لها معانٍ متعددة؛ يرتبط المعنى بالعطاء والكرم، سواء بالمنح أو طلبه)\nمثال: إنها غالية جدا!",
 "most especially": "الأهم, قبل كل شيء (فوق كل اعتبار آخر)\nمثال: قبل كل شيء، يجب أن تكون مستقلاً",
 "most high": "اَلْأَعْلَى / سُورَة اَلْأَعْلَى",
 "most importantly": "الأهم, قبل كل شيء (فوق كل اعتبار آخر)\nمثال: قبل كل شيء، يجب أن تكون مستقلاً",
 "most valuable player": "أفضل لاعب, اللاعب الأكثر قيمة (اللاعب الذي يُحكم عليه بأنه الأكثر أهمية للرياضة أو الفريق)",
 "most-favored-nation": "الدولة الأولى بالرعاية (من أو يتعلق بمعاهدة تجارية حيث تتفق دولتان على منح كل منهما الأخرى نفس الشروط المواتية التي تُقدم في المعاهدات مع أي دولة أخرى)",
 "most-valuable": "الأَكْثَر قِيمَةً (يُعيَّن للاعب الذي يُحكَم بأنّه الأهمّ في الرياضة)",
 "mostaccioli": "موستاتشولي (مكرونة تشبه إلى حد ما الشوارب الصغيرة)",
 "mostly": "إلى حد كبير, بشكل رئيسي (في جزء كبير؛ بشكل رئيسي أو أساسي) / بشكل عام, في الغالب (عادة؛ كقاعدة)\nمثال: هذه الحسابات غير نشطة إلى حد كبير",
 "mosul": "الْمَوْصِل",
 "mot": "اختبار وزارة النقل, فحص دوري (اختبار سنوي إلزامي للمركبات القديمة للسلامة وعوادم السيارات) / طُرْفَة, كَلِمَة ذَكِيَّة (ملاحظة ذكية)",
 "mot juste": "الكلمة المناسبة (الكلمة أو التعبير المناسب)",
 "mot test": "اختبار وزارة النقل, فحص دوري (اختبار سنوي إلزامي للمركبات القديمة للسلامة وعوادم السيارات)",
 "mote": "ذرة, هباءة ((الاستخدام غير التقني) قطعة صغيرة جداً من أي شيء)",
 "motel": "مُوتِيل",
 "motel room": "غرفة موتيل (غرفة نوم في موتيل)",
 "motet": "موتيت (تأليف كورالي غير مصحوب بآلات مع كلمات مقدسة؛ يهدف لغنائه كجزء من خدمة الكنيسة؛ نشأ في القرن الثالث عشر)",
 "moth": "عُثَّة",
 "moth bean": "فاصولياء العث, لوبياء مقرنة (بقوليات من جزر الهند الشرقية لها أوراق مشعرة وزهور صفراء صغيرة تليها قرون أسطوانية؛ تستخدم خاصة في الهند للغذاء والعلف وكمحسن للتربة)",
 "moth miller": "عثة الطحين (أي من العث المتنوع الذي له أجنحة مسحوقية)",
 "moth mullein": "بوصير العث, بوصير صرصوري (بوصير أوروبي بأوراق ملساء وزهور صفراء أو أرجوانية كبيرة؛ تم توطينه كعشب ضار في أمريكا الشمالية)",
 "moth orchid": "أوركيد العثة, فالاينوبسيس (أي من بساتين الفاكهة المختلفة من جنس فالاينوبسيس ذات أوراق بيضاوية أو بيضاوية مقلوبة عريضة لامعة متدلية غالباً خضراء داكنة مشوبة بالأرجواني أو مرقطة…)",
 "moth plant": "أوركيد العثة, فالاينوبسيس (أي من بساتين الفاكهة المختلفة من جنس فالاينوبسيس ذات أوراق بيضاوية أو بيضاوية مقلوبة عريضة لامعة متدلية غالباً خضراء داكنة مشوبة بالأرجواني أو مرقطة…)",
 "moth-eaten": "بَالٍ, قَدِيم (يفتقر للأصالة أو العفوية؛ لم يعد جديداً) / مَأْكُولٌ بِالعُثِّ (بَالٍ أَوْ مَأْكُولٌ بِفِعْلِ العُثِّ أَوْ مَا يُشْبِهُهُ) / بَالٍ, رَثّ (تَظْهَرُ عَلَيْهِ عَلَامَاتُ البِلَى وَالتَّلَفِ)",
 "moth-resistant": "مُقَاوِم لِلْعُثّ (مقاوم لأضرار العُثّ)",
 "mothball": "كرة النفتالين (كرة صغيرة من الكافور أو النفتالين تستخدم لإبعاد العث عن الملابس المخزنة)",
 "mother": "أُمّ, وَالِدَة (الوَالِدَة أو الجَدَّة، وقد يطلق على والدة الزوج مجازا؛ أمّ بالرضاعة: المرأة التي أرضعت الطِفْل صغيرا فتصبح كوالدته)\nمثال: هل ستأتي أم لا؟",
 "mother board": "اللوحة الأم, لوحة المعالج (لوحة الدوائر الرئيسية للحاسوب)",
 "mother carey's chicken": "دجاجة الأم كاري (طائر نوء عاصفة متوسط الحجم)",
 "mother carey's hen": "دجاجة الأم كاري (طائر نوء عاصفة متوسط الحجم)",
 "mother cell": "خلية أم (خلية تتطور منها خلية أخرى للكائن الحي (عادة من نوع مختلف))\nمثال: تتطور الخلية المنوية من خلية أم منوية",
 "mother country": "أرض الوطن, البلد الأم (البلد الذي ولدت فيه)",
 "mother figure": "شخصية أمومية (امرأة تثير المشاعر التي عادة ما تكون مخصصة للأم)",
 "mother fucker": "حقير, سافل (عبارات مهينة تُطلق على الأشخاص الأغبياء أو المزعجين أو السخفاء)",
 "mother hen": "دجاجة أم (دجاجة مع فراخها) / شَدِيد الْعِنَايَة بِالْآخَرِين (شخص يهتم باحتياجات الآخرين (خاصة بطريقة مفرطة في الحماية أو التدخل))",
 "mother hubbard": "فستان واسع جداً (فستان نسائي فضفاض غير مربوط بحزام)",
 "mother lode": "العرق الأم, العرق الرئيسي (العرق الرئيسي للخام في الرواسب)",
 "mother of thyme": "ريحان بلسمي, زعتر الريحان (نعناع أوروبي عطري له عناقيد من الزهور البنفسجية والبيضاء الصغيرة؛ مستوطن خاصة في شرق أمريكا الشمالية)",
 "mother superior": "رئيسة الدير (الرئيسة لمجموعة من الراهبات)",
 "mother tongue": "لُغَة أُمّ, لُغَة قَوْمِيَّة (هِيَ مجموعة من الأصوات التي يصدرها الإنسان على شكل كلمات منظمة بقواعد، ليتواصل به الناس وينقلون به الافكار والمعاني، اللسان؛ يقصد بها أحيانا اللهجة)\nمثال: الأمازيغية لغة.",
 "mother wit": "بديهة, حس سليم (حكم عملي سليم)\nمثال: الحس السليم ليس شائعًا جدًا",
 "mother's boy": "ابن أمه (صبي متعلق بأمه بشكل مفرط؛ يفتقر إلى الاهتمامات الذكورية الطبيعية)",
 "mother's daughter": "ابنة أمها (ابنة مفضلة لدى أمها وتشبهها)",
 "mother's day": "عِيد اَلْأُمّ",
 "mother's milk": "حليب الأم (حليب تفرزه المرأة التي وضعت مولوداً حديثاً)",
 "mother's son": "ابن أمه, رجل\nمثال: كان كل رجل يستطيع المشي موجوداً هناك (الولد الذكر)\nمثال: هو له ابن صغير.",
 "mother-in-law": "حَمَاة",
 "mother-in-law plant": "ديفنباخيا, نبات الخرس (نبات دائم الخضرة بأوراق خضراء داكنة كبيرة ومبهرجة؛ يحتوي على سم يسبب تورم اللسان والحلق ومن هنا جاء الاسم)",
 "mother-in-law's tongue": "ديفنباخيا, نبات الخرس (نبات دائم الخضرة بأوراق خضراء داكنة كبيرة ومبهرجة؛ يحتوي على سم يسبب تورم اللسان والحلق ومن هنا جاء الاسم) / جلد النمر, لسان الحماة (نبات عديم الساق له أوراق صلبة ضيقة يزرع غالباً كنبات منزلي)",
 "mother-naked": "عَارٍ كَمَا وَلَدَتْهُ أُمُّهُ (عارٍ تماماً كما كان عند الولادة)",
 "mother-of-pearl": "عِرْق اللُّؤْلُؤ, زِلْف (وريد أو شريان، مجرى الدَّم في الجسَد؛ جِنْس؛ سُلَالَة من النّاس يُصنَّفون بناء على التَّاريخ أو الجنسيّة أو التّوزيع الجغرافيّ المشترك)\nمثال: هذا القميص مبلل بالعرق.",
 "mother-of-pearl cloud": "سحابة أم اللؤلؤ, سحابة صدفية (سحابة مضيئة قزحية الألوان على ارتفاع عالٍ يمكن رؤيتها عندما تكون الشمس بضع درجات تحت الأفق)",
 "mother-of-thousands": "غرنوقي الفراولة, كاسر الحجر المتدلي (كاسر حجر آسيوي شرقي بعناقيد من الزهور الحمراء والبيضاء الصغيرة؛ ينتشر عن طريق العديد من السيقان الزاحفة)",
 "motherboard": "اللَّوْحَةُ الأُمّ",
 "motherese": "محاكاة كلام الأطفال (تقليد شخص بالغ لكلام طفل صغير)",
 "motherfucker": "حقير, سافل (عبارات مهينة تُطلق على الأشخاص الأغبياء أو المزعجين أو السخفاء)",
 "motherhood": "أُمُومَة",
 "motherland": "وَطَن (أقام بالمكان وكان وَطَنا له)\nمثال: دعاها لحفلة العودة للوطن.",
 "motherless": "يَتِيمُ الأُمّ (لَيْسَ لَهُ أُمٌّ عَلَى قَيْدِ الحَيَاةِ أَوْ مَعْرُوفَة)",
 "motherlike": "شَبِيهٌ بِالأُمّ (يُوحِي بِسُلُوكِ الأُمِّ أَوْ يَتَصَرَّفُ كَالأُمّ)",
 "motherliness": "أُمُومَة, حَنَان (صفة امتلاك أو إظهار الحنان والدفء والعاطفة التي تليق بالأم)\nمثال: أمومة الفتاة جعلتها لا تقدر بثمن في رعاية الأطفال",
 "motherly": "أُمِّيّ, أُمُومِيّ",
 "motherwort": "ذنب الأسد القلبي, عشبة الأم (عشب مر من العالم القديم في الأسيجة وحواف الغابات له أوراق مسننة وأزهار بيضاء أو وردية باهتة)",
 "mothproof": "مُقَاوِم لِلْعُثّ (مقاوم لأضرار العُثّ)",
 "mothy": "مُوبُوء بِالعُثّ (منتشر فيه العثّ (حشرات الملابس)) / مَأْكُولٌ بِالعُثِّ (بَالٍ أَوْ مَأْكُولٌ بِفِعْلِ العُثِّ أَوْ مَا يُشْبِهُهُ)",
 "motif": "تيمة, فكرة زخرفية (تصميم أو شكل يتكون من أشكال أو ألوان متكررة، كما في العمارة أو الديكور) / ثيمة, موضوع (فكرة موحدة تعد عنصرًا متكررًا في العمل الأدبي أو الفني) / فكرة موسيقية, موتيف (موضوع يتم تكراره أو تفصيله في قطعة موسيقية)\nمثال: كان الموضوع المعتاد 'صبي يفوز بقلب فتاة'",
 "motile": "ذَاتِيُّ الحَرَكَة, مُتَحَرِّك ((لِلأَبْوَاغِ أَوِ الكَائِنَاتِ الدَّقِيقَة) قَادِرٌ عَلَى الحَرَكَةِ الذَّاتِيَّة) / حركي (شخص تتخذ صوره الذهنية الغالبة شكل مشاعر داخلية بالحركة)",
 "motilin": "موتيلين (هرمون معدي معوي يشارك في التحكم في تقلصات العضلات الملساء في المعدة والأمعاء الدقيقة)",
 "motility": "تحرك, حركة (تغير في الموضع لا يستلزم تغيراً في الموقع الجغرافي) / حَرَكِيَّة, قُدْرَة عَلَى الحَرَكَة الذَّاتِيَّة (القدرة على التحرك بشكل عفوي ومستقل)\nمثال: كشفت الحركة الانعكاسية لحواجبه عن مفاجأته",
 "motion": "حَرَكَة",
 "motion picture": "فيلم, فيلم سينمائي (شكل من أشكال الترفيه يجسد قصة بالصوت وتسلسل من الصور يعطي وهماً بالحركة المستمرة)\nمثال: ذهبوا لمشاهدة فيلم كل ليلة سبت",
 "motion sickness": "دُوَار اَلْبَحْر (في : هي الدَار الكبيرة الفاخرة أو دار العُمْدَة. الجمع دُوَّارَات)\nمثال: كان لديها دوار.",
 "motion study": "دراسة الوقت والحركة (تحليل لوظيفة معينة في محاولة لإيجاد الطريقة الأكثر كفاءة من حيث الوقت والجهد)",
 "motion with variable acceleration": "حركة متغيرة التسارع ((في الميكانيكا) أي حركة لا يكون تسارعها ثابتاً، نظراً لأن القوة المسببة لها ليست ثابتة)",
 "motion-picture camera": "كاميرا سينمائية (كاميرا تلتقط سلسلة من الصور الفوتوغرافية التي يمكن أن تعطي وهم الحركة عند عرضها بتتابع سريع)",
 "motion-picture fan": "مرتاد السينما (شخص يذهب لمشاهدة الأفلام)",
 "motion-picture film": "فيلم سينمائي (فيلم فوتوغرافي طوله عدة مئات من الأقدام وملفوف على بكرة؛ لاستخدامه في كاميرا سينمائية)",
 "motion-picture photography": "تصوير سينمائي (فعل صناعة فيلم)",
 "motion-picture show": "فيلم, فيلم سينمائي (شكل من أشكال الترفيه يجسد قصة بالصوت وتسلسل من الصور يعطي وهماً بالحركة المستمرة)\nمثال: ذهبوا لمشاهدة فيلم كل ليلة سبت",
 "motional": "حركي (من أو يتعلق بالحركة أو يتميز بها)",
 "motionless": "ثَابِت, جَامِد (ليس في حالة حركة جسدية)",
 "motionlessly": "بلا حراك (بدون حركة؛ بطريقة ساكنة)\nمثال: رأى الرجل ذا الشعر الأسود ينتظر بلا حراك خلف الجانب الآخر من المنصة",
 "motionlessness": "انعدام الحركة, جمود (حالة عدم وجود حركة)\nمثال: السكون التام لتمثال رخامي",
 "motivate": "حَثَّ (حثّ الشّخصَ:أعجله ، حثّه على الشّيء:حضّه عليه ، شجّعه؛ حثَّه علَيْه :حَضَّهُ عَلَيْهِ، ونَدَبَه لَهُ وإِليه)\nمثال: بحث عن المفتاح.",
 "motivated": "ذو دافع, متحمس (مزود بدافع أو حافز للعمل)\nمثال: يمكن للطفل المتحمس للغاية أن يتعلم أي شيء تقريباً",
 "motivating": "تحفيز, دافع (فعل التحفيز؛ توفير الحافز) / دَافِع, مُحَفِّز (يدفع إلى العمل والفعل)",
 "motivation": "دَافِع (دَافِع : حافِزٌ وسببٌ، أمرٌ مُوجِبٌ؛ ما يحمل على الفعل من غرائز وميول فهو وجدانيّ، ولا شعوريّ في حين أنّ الباعث عقليّ وشعوريّ) / دافِع (دَافِع : حافِزٌ وسببٌ، أمرٌ مُوجِبٌ؛ ما يحمل على الفعل من غرائز وميول فهو وجدانيّ، ولا شعوريّ في حين أنّ الباعث عقليّ وشعوريّ)\nمثال: دافع عن الضعفاء.",
 "motivational": "تحفيزي, دفعي (مكون من أو متعلق بالدافعية (التحفيز))",
 "motivator": "تشجيع, حافز (تأثير تحفيزي إيجابي)",
 "motive": "حَافِز",
 "motive power": "تَنَقُّل, قُوَّة مُحَرِّكَة (القوة أو القدرة على التحرك)",
 "motiveless": "بِلَا دَافِع, عَابِث (يحدث دون دافع أو استفزاز)",
 "motivity": "تَنَقُّل, قُوَّة مُحَرِّكَة (القوة أو القدرة على التحرك)",
 "motley": "أَبْلَق, مُتَعَدِّد الأَلْوَان (ذو أجزاء أو بقع ملوّنة بألوان مختلفة وزاهية عادةً) / مُتَنَوِّع, مُخْتَلِط (يتألَّف من تشكيلة عشوائيَّة من أنواع مختلفة) / قماش مرقع (قماش صوفي متعدد الألوان منسوج بخيوط مختلطة في إنجلترا في القرنين الرابع عشر والسابع عشر) / زي المهرج (رداء مصنوع من نسيج متعدد الألوان (خاصة زي مهرج البلاط))",
 "motley fool": "بهلول, مهرج البلاط (مهرج محترف كان يوظف لترفيه الملوك أو النبلاء في العصور الوسطى)",
 "motmot": "موت موت (طائر أمريكي استوائي يشبه القيق الأزرق وله ريش مخضر ومزرق)",
 "motoneuron": "عصبون حركي (عصبون ينقل النبضات من الدماغ أو الحبل الشوكي إلى الخارج)",
 "motor": "مُحَرِّك, مُوتُور (اسم فاعل من حَرَّكَ؛ اسم آلة)\nمثال: المحرك لا يعمل.",
 "motor aphasia": "حبسة بروكا, حبسة تعبيرية (حبسة يكون فيها التعبير عن طريق الكلام أو الكتابة معاقاً بشدة)",
 "motor area": "قشرة حركية, منطقة حركية (المنطقة القشرية التي تؤثر على الحركات الحركية)",
 "motor ataxia": "رنح, فقدان الانتظام الحركي (عدم القدرة على تنسيق الحركات العضلية الإرادية؛ حركات غير مستقرة ومشية مترنحة)",
 "motor control": "تحكم حركي (التحكم في العضلات)",
 "motor cortex": "قشرة حركية, منطقة حركية (المنطقة القشرية التي تؤثر على الحركات الحركية)",
 "motor end plate": "صفيحة نهائية, صفيحة نهائية حركية (النهاية المسطحة للعصبون الحركي التي تنقل النبضات العصبية إلى العضلة)",
 "motor fiber": "ليف حركي, ليف صادر (ليف عصبي يحمل النبضات نحو العضلات أو الغدد)",
 "motor home": "عربة تخييم, منزل متنقل (مركبة ترفيهية مجهزة للتخييم أثناء السفر)",
 "motor horn": "بوق السيارة, زمور (جهاز في السيارة لإصدار ضوضاء تحذيرية)",
 "motor hotel": "موتيل, نزل للسيارات (فندق لسائقي السيارات؛ يوفر وصولاً مباشراً من الغرف إلى منطقة وقوف السيارات)",
 "motor inn": "موتيل, نزل للسيارات (فندق لسائقي السيارات؛ يوفر وصولاً مباشراً من الغرف إلى منطقة وقوف السيارات)",
 "motor lodge": "موتيل, نزل للسيارات (فندق لسائقي السيارات؛ يوفر وصولاً مباشراً من الغرف إلى منطقة وقوف السيارات)",
 "motor memory": "ذاكرة حركية, ذاكرة عضلية (ذاكرتك للمهارات الحركية)",
 "motor mower": "جزازة آلية (جزازة عشب تعمل بمحرك بنزين)",
 "motor nerve": "عصب حركي, عصب صادر (عصب ينقل النبضات باتجاه أو إلى العضلات أو الغدد)",
 "motor nerve fiber": "عصبون حركي (عصبون ينقل النبضات من الدماغ أو الحبل الشوكي إلى الخارج)",
 "motor neuron": "عصبون حركي (عصبون ينقل النبضات من الدماغ أو الحبل الشوكي إلى الخارج)",
 "motor neuron disease": "مَرَضُ الْعَصْبُونِ الْحُرَكِي (أصابه مرضٌ أو علّة أو سَقَم)\nمثال: هذا المرض قلبي.",
 "motor oil": "زيت المحركات (زيت يُستخدم لتزييت الأجزاء المتحركة للمحرك)",
 "motor pool": "مجمع المركبات, مرآب عسكري (أسطول من المركبات العسكرية تسيطر عليه وكالة واحدة ومتاح للاستخدام عند الحاجة)",
 "motor region": "قشرة حركية, منطقة حركية (المنطقة القشرية التي تؤثر على الحركات الحركية)",
 "motor scooter": "سكوتر, سكوتر بمحرك (مركبة بعجلات صغيرة ومحرك بنزين منخفض الطاقة متصل بالعجلة الخلفية)",
 "motor torpedo boat": "قارب طوربيد للدوريات (قارب طوربيد صغير سريع غير مدرع ومسلح تسليحاً خفيفاً)",
 "motor vehicle": "سيارة, مركبة آلية (مركبة بعجلات ذاتية الدفع لا تسير على قضبان)",
 "motor-assisted": "بِمُسَاعَدَة مُحَرِّك (يعتمد على محرك للدفع إضافة إلى القوة العضلية)",
 "motorbike": "دراجة نارية صغيرة (دراجة نارية صغيرة بإطار منخفض وعجلات صغيرة ومقاود مرتفعة)",
 "motorboat": "زَوْرَق آلِيّ",
 "motorbus": "أوتوبيس, باص (مركبة تحمل العديد من الركاب؛ تستخدم للنقل العام)\nمثال: كان دائماً يركب الحافلة للعمل",
 "motorcade": "مَوْكِب سَيَّارَات (موكب من الناس يسافرون في السيارات)",
 "motorcar": "سيارة, مركبة (مركبة آلية بأربع عجلات؛ تدفع عادة بمحرك احتراق داخلي)\nمثال: إنه يحتاج إلى سيارة للذهاب إلى العمل",
 "motorcoach": "أوتوبيس, باص (مركبة تحمل العديد من الركاب؛ تستخدم للنقل العام)\nمثال: كان دائماً يركب الحافلة للعمل",
 "motorcycle": "مُوتُوسِيكِل, دَرَّاجَة نَارِيَّة",
 "motorcycle cop": "شُرْطِيّ المُرُور السَّرِيع, شُرْطِيّ دَرَّاجَة نارِيَّة (شرطي يركب دراجة نارية (ويراقب سرعة السائقين))",
 "motorcycle policeman": "شرطي دراجة نارية (شرطي ذكر يركب دراجة نارية (ويتحقق من سرعة سائقي السيارات))",
 "motorcycle policewoman": "شرطية دراجة نارية (شرطية أنثى تركب دراجة نارية (وتتحقق من سرعة سائقي السيارات))",
 "motorcycling": "ركوب الدراجات النارية (ركوب دراجة نارية)\nمثال: ركوب الدراجات النارية رياضة خطرة",
 "motorcyclist": "راكب الدراجة النارية (مسافر يركب دراجة نارية)",
 "motored": "آلي, مزود بمحرك (مجهز بمحرك أو محركات)\nمثال: كرسي متحرك آلي",
 "motorial": "حَرَكِيّ, صَادِر (للأعصاب والنبضات العصبية؛ تنقل المعلومات بعيداً عن الجهاز العصبي المركزي)\nمثال: أعصاب ونبضات صادرة",
 "motoring": "قيادة السيارات (فعل قيادة سيارة)",
 "motorisation": "تزويد بمحركات, ميكنة (فعل الميكنة (التجهيز بمحركات أو مركبات آلية))",
 "motorised": "آلي, مزود بمحرك (مجهز بمحرك أو محركات)\nمثال: كرسي متحرك آلي",
 "motorist": "سَائِق",
 "motorization": "تزويد بمحركات, ميكنة (فعل الميكنة (التجهيز بمحركات أو مركبات آلية))",
 "motorized": "مُحَرَّك, مُمَيْكَن (يَسْتَخْدِمُ المَرْكَبَاتِ فِي التَّنَقُّل) / آلي, مزود بمحرك (مجهز بمحرك أو محركات)\nمثال: كرسي متحرك آلي",
 "motorized wheelchair": "كرسي كهربائي, كرسي متحرك آلي (كرسي متحرك يعمل بمحرك)",
 "motorless": "بلا محرك, غير آلي (لا يحتوي على محرك)",
 "motorman": "سائق ترام, سائق قطار كهربائي (مشغل الترام (عربة الشارع))",
 "motormouth": "ثرثار, كثير الكلام (شخص يتحدث بلا انقطاع)\nمثال: أتمنى لو يسكت هذا الثرثار",
 "motortruck": "شاحنة (مركبة آلية مناسبة للنقل)",
 "motorway": "أُوتُوسْتْرَاد, طَرِيق سَرِيع",
 "motrin": "أدفيل, إيبوبروفين (دواء مضاد للالتهاب ومسكن غير ستيرويدي (الأسماء التجارية أدفيل وموترين وغيرها) يستخدم لتخفيف آلام التهاب المفاصل وكخافض للحرارة)\nمثال: الاستخدام اليومي للإيبوبروفين يمكن أن يهيج المعدة",
 "mottle": "تبقع, ترقيط (ترتيب غير منتظم لبقع من اللون)\nمثال: لم يكن رمادياً باهتاً كما أوحت المسافة، بل كان خليطاً مرقطاً من الكاكي والأسود والأخضر الزيتوني",
 "mottled": "مُبَرْقَع, مُرَقَّش (ذو بقع أو رقع من الألوان المتباينة)",
 "mottling": "ترقيط, توشيح (فعل التلوين بمساحات ذات ظلال مختلفة)",
 "motto": "شِعَار (العلامة: وذلك من شعار العقلاء (مادة حلم من مجمع بحار الأنوار))\nمثال: الشعار ☭ هو رمز الشيوعية.",
 "moue": "بوز, تجهم ازدراء (تجهم يعبر عن الازدراء)",
 "moufflon": "الكبش البري, موفلون (خروف جبلي بري في كورسيكا وسردينيا)",
 "mouflon": "أُرْوِيَّة",
 "moujik": "موجيك (فلاح روسي (خاصة قبل عام 1917))",
 "mould": "أصاب بالعفن, تعفن (أصبح متعفناً؛ فسد بسبب الرطوبة) / أثّر, حدّد (التشكيل أو التأثير؛ إعطاء التوجيه لـ) / يصب, يلائم (يناسب بإحكام، يتبع الخطوط العريضة لـ) / قالب (حاوية يُصب فيها السائل لتكوين شكل معين عندما يتصلب)\nمثال: تعفن الأثاث في المنزل القديم",
 "mouldboard": "قلابة المحراث, لوحة التشكيل (إسفين يتكون من الجزء المنحني لشفرة المحراث الفولاذية الذي يقلب الأخدود)",
 "mouldboard plough": "محراث قلاب (محراث يحتوي على لوحة تشكيل لقلب التربة)",
 "moulding": "تشكيل, نمذجة (نحت أولي من الشمع أو الطين يمكن نسخ العمل النهائي منه) / قولبة, نحت طيني (نحت يتم إنتاجه بالقولبة) / إفريز, قولبة (سطح زخرفي غائر أو بارز على الحافة) / إطار زخرفي, كرنيش (شريط زخرفي يستخدم للزينة أو التشطيب)",
 "mouldy": "مُتَعَفِّن, مُكَلَّف (مُغَطًّى بِالعَفَن أَوْ ذُو رَائِحَة عَفَن)",
 "moulin": "بئر جليدي, طاحونة جليدية (بئر عمودي في الجليد تتدفق عبره المياه السطحية إلى داخل النهر الجليدي، ويصل إما إلى صخر الأساس أو إلى عمق تشكل الشقوق الشائعة)\nمثال: انغمس النهر الجليدي الهادر في الأعماق الزرقاء للطاحونة الجليدية",
 "moult": "انسلاخ, طرح الريش (الانسلاخ الدوري للبشرة في المفصليات أو الجلد الخارجي في الزواحف)",
 "moulter": "حيوان طارح, حيوان مبدل للجلد (حيوان (خاصة الطيور والمفصليات والزواحف) يطرح طبقته الخارجية بشكل دوري (ريش أو قشرة أو جلد أو شعر))",
 "moulting": "انسلاخ, طرح الريش (الانسلاخ الدوري للبشرة في المفصليات أو الجلد الخارجي في الزواحف)",
 "mound": "بيشر, رامي (مركز في فريق البيسبول للاعب الذي يرمي الكرة للضارب ليحاول ضربها) / تل, رابية (هيكل يتكون من كومة صناعية أو ركام عادة من التراب أو الحجارة) / تل الرامي ((بيسبول) الارتفاع الطفيف الذي يقف عليه الرامي) / ركام, كدس (مجموعة من الأشياء مكدسة فوق بعضها البعض)\nمثال: لعب في كل مركز باستثناء الرامي",
 "mound bird": "شقبان (طيور كبيرة الأقدام قصيرة الأجنحة من أسترالاسيا؛ تبني أكواماً من النباتات المتحللة لاحتضان البيض)",
 "mound builder": "شقبان (طيور كبيرة الأقدام قصيرة الأجنحة من أسترالاسيا؛ تبني أكواماً من النباتات المتحللة لاحتضان البيض) / باني التلال (من الهنود الحمر في عصور ما قبل التاريخ الذين بنوا تلالاً للمذابح)",
 "mound-bird": "شقبان (طيور كبيرة الأقدام قصيرة الأجنحة من أسترالاسيا؛ تبني أكواماً من النباتات المتحللة لاحتضان البيض)",
 "mounded over": "مكوم فوقه (لديه كومة مشكلة فوقه)",
 "mount": "رَكِبَ (عَلَى أو أعْتَلَى شيئا؛ السَيَّارَة أو وسيلة نقل أخرى، استخدمها في تنقله بدلا من الدواب)\nمثال: ركب ياني سفينة.",
 "mount athos": "جَبَل آثُوس (كلمة \"جبل\" لها معانٍ متعددة؛ طبع أو خلق شيئًا أو شخصًا على طبيعة أو سلوك معين)\nمثال: منزلي في الجبل.",
 "mount cook lily": "زنبق الجبل, زنبق جبل كوك (نبات معمر مبهرج ذو أزهار بيضاء من نيوزيلندا)",
 "mount erebus": "جَبَل إِرِيبَاص (كلمة \"جبل\" لها معانٍ متعددة؛ طبع أو خلق شيئًا أو شخصًا على طبيعة أو سلوك معين)\nمثال: منزلي في الجبل.",
 "mount everest": "جَبَل إِفْرِسْت, إِفْرِسْت (كلمة \"جبل\" لها معانٍ متعددة؛ طبع أو خلق شيئًا أو شخصًا على طبيعة أو سلوك معين)\nمثال: منزلي في الجبل.",
 "mount fuji": "جَبَل فُوجِي, فُوجِي (كلمة \"جبل\" لها معانٍ متعددة؛ طبع أو خلق شيئًا أو شخصًا على طبيعة أو سلوك معين)\nمثال: منزلي في الجبل.",
 "mount mayon": "بركان مايون (فَتْحَةُ أَوْ فَوْهَةُ انْفجارٍ حَلَزونِيَّةُ الشَّكْلِ، تَكونُ في مَواقِعَ جَبَلِيَّةٍ تَقْذِفُ نيراناً مُلْتَهِبَةً)\nمثال: هذا من شأنه أن يضع العاصفة في مسار تصادم افتراضي مع بركان كيلويا ، في الجزء الجنوبي من الجزيرة.",
 "mount megiddo": "اَلْمَجِيدُو",
 "mount of olives": "جَبَل الزَّيْتُون (كلمة \"جبل\" لها معانٍ متعددة؛ طبع أو خلق شيئًا أو شخصًا على طبيعة أو سلوك معين)\nمثال: منزلي في الجبل.",
 "mountain": "جَبَل (كلمة \"جبل\" لها معانٍ متعددة؛ طبع أو خلق شيئًا أو شخصًا على طبيعة أو سلوك معين) / طُور\nمثال: منزلي في الجبل.",
 "mountain alder": "نغت أبيض, نغت جبلي (شجرة من غرب الولايات المتحدة) / قيقب الجبل (قيقب شجيري صغير من شرق أمريكا الشمالية؛ قرمزي في الخريف)",
 "mountain andromeda": "أندروميدا جبلية, شجيرة القيود الجبلية (شجيرة زينة دائمة الخضرة من جنوب شرق الولايات المتحدة ذات أزهار بيضاء صغيرة على شكل جرس)",
 "mountain anemone": "شقائق النعمان الألبية, شقائق النعمان الجبلية (عشبة ذات أوراق حريرية في جبال روكي بزهور بيضاء مزرقة)",
 "mountain ash": "مران تكساس (مران منخفض النمو من تكساس) / مران الجبل (شجرة لها خشب مشابه للمران الألبي؛ أطول شجرة في أستراليا وأطول شجرة خشب صلب في العالم) / شجرة الروان, غبيراء (أي من أشجار متنوعة من جنس الغبيراء)",
 "mountain avens": "أفنس الجبل, درياس ثماني البتلات (شجيرة زاحفة دائمة الخضرة بزهور بيضاء كبيرة؛ واسعة الانتشار في الأجزاء الشمالية من أوراسيا وأمريكا الشمالية)",
 "mountain azalea": "أزاليا ألبية, أزاليا جبلية (شجيرة دائمة الخضرة زاحفة تشكل حصيرة من المناطق الجبلية العالية في نصف الكرة الشمالي تزرع لأزهارها الوردية)",
 "mountain beaver": "قندس الجبل (قارض ليلي ضخم يحفر الجحور في مرتفعات ساحل المحيط الهادئ لأمريكا الشمالية؛ وهو أكثر القوارض الحية بدائية)",
 "mountain bike": "دَرَّاجَة لِلْجِبَال (مَرْكَبَة من عجلتين أو ثلاث، ولها مقعد واحد عادة، مثل الدراجة الهوائية والدراجة النارية؛ دراجة هوائية. (تخصيص))\nمثال: كين يريد دراجة.",
 "mountain birch": "بتولا المستنقعات, بتولا مائية (بتولا من غرب الولايات المتحدة تشبه البتولا الورقية ولكن لها لحاء بني)",
 "mountain blacksnake": "ثعبان أسود, ثعبان الجرذ الأسود (ثعبان أسود لامع كبير غير سام من أمريكا الشمالية)",
 "mountain bladder fern": "سرخس المثانة الجبلي (سرخس المناطق الجبلية الصخرية في نصف الكرة الأرضية)",
 "mountain blue berry": "عنب الجبل (توت أزرق قائم من غرب الولايات المتحدة له زهور منفردة وتوت حامض نوعاً ما)",
 "mountain blueberry": "عنب الجبل (توت أزرق قائم من غرب الولايات المتحدة له زهور منفردة وتوت حامض نوعاً ما)",
 "mountain box": "عنب الدب, قطلب عنب الدب (شجيرة دائمة الخضرة تشكل حصيرة من أمريكا الشمالية وشمال أوراسيا لها زهور بيضاء صغيرة وتوت أحمر؛ تتحول الأوراق إلى الأحمر في الخريف)",
 "mountain chain": "سلسلة جبال, سلسلة جبلية (سلسلة من التلال أو الجبال)\nمثال: كان الوادي يقع بين سلسلتين من التلال",
 "mountain chinchilla": "شنشيلة الجبل, فيسكاتشا الجبل (قارض موطنه جبال تشيلي وبيرو ويُربى الآن في الأسر)",
 "mountain clematis": "ياسمين بري أرجواني, ياسمين بري جبلي (نبات متسلق من شمال شرق أمريكا الشمالية ذو أزهار أرجوانية زرقاء شمعية)",
 "mountain climber": "متسلق جبال (شخص يقوم بتسلق الجبال)",
 "mountain climbing": "تسلق الجبال (نشاط تسلق الجبال)",
 "mountain clubmoss": "رجل الذئب التنوبي, رجل الذئب الجبلي (من شمال أوروبا وأمريكا؛ يشبه شجرة تنوب مصغرة)",
 "mountain cranberry": "عنب الثور (توت أحمر لاذع يشبه التوت البري الأمريكي ولكنه أصغر) / توت البقر, توت الجبل الأحمر (شجيرة منخفضة دائمة الخضرة من المناطق المعتدلة الشمالية العالية في أوروبا وآسيا وأمريكا تحمل توتاً أحمر صالحاً للأكل)",
 "mountain daisy": "رملية جبلية, نجمة الجبل (رملية شمالية أو ألبية)",
 "mountain devil": "سحلية شائكة, شيطان الجبل (سحلية صحراوية تتغذى على النمل) / زهرة العسل, شيطان الجبل (شجيرة كثيفة منتصبة من شرق أستراليا ذات عناقيد طرفية من الزهور الحمراء تنتج الكثير من الرحيق)",
 "mountain ebony": "خف الجمل, شجرة الأوركيد (شجرة صغيرة من شرق الهند لها زهور تشبه الأوركيد وخشب داكن صلب)",
 "mountain everlasting": "رجل القط الجبلية (صنف من نبات رجل القط)",
 "mountain fern": "سرخس الجبل (سرخس جبلي أوروبي شائع له سعف برائحة الليمون أو البلسم)",
 "mountain fetterbush": "أندروميدا جبلية, شجيرة القيود الجبلية (شجيرة زينة دائمة الخضرة من جنوب شرق الولايات المتحدة ذات أزهار بيضاء صغيرة على شكل جرس)",
 "mountain fever": "حمى جبال روكي المبقعة (تسببها بكتيريا ريكتسي وينقلها قراد الخشب)",
 "mountain four o'clock": "شب الليل الجبلي (زهرة برية ورقية بزهور لافندر وردية تفتح في المساء وتبقى خلال الجزء البارد من اليوم التالي؛ توجد في الغابات المفتوحة أو الشجيرات في جبال جنوب كولورادو…)",
 "mountain goat": "ماعز الجبل (ثديي ثابت القدم يعيش في المناطق الجبلية بشمال غرب أمريكا الشمالية)",
 "mountain gorilla": "غوريلا الجبل (غوريلا مرتفعات كيفو)",
 "mountain grape": "عنب أوريغون, ماهونيا (شجيرة زينة دائمة الخضرة من ساحل المحيط الهادئ لأمريكا الشمالية ذات أوراق خضراء داكنة ريشية وعناقيد من الزهور الصفراء تليها حبات توت زرقاء سوداء)",
 "mountain heath": "خلنج الجبل (شجيرة صغيرة بأوراق دائمة الخضرة وزهور وردية أو أرجوانية؛ القمم الألبية والأراضي المرتفعة في آسيا وأوروبا والولايات المتحدة)",
 "mountain hemlock": "تسوغا جبلية (شجرة دائمة الخضرة كبيرة من غرب الولايات المتحدة؛ خشبها أصلب بكثير من التسوغا الكندية)",
 "mountain hollyhock": "ختمية جبلية (نبات معمر من شمال غرب الولايات المتحدة وغرب كندا يشبه الختمية وله زهور بيضاء أو وردية)",
 "mountain lady's slipper": "خف السيدة الجبلي (نبات ورقي له بضعة سيقان في كتلة مع زهرة واحدة بيضاء وأرجوانية باهتة في كل إبط ورقة علوية؛ ألاسكا إلى شمال كاليفورنيا ووايومنغ)",
 "mountain laurel": "آس أوريغون, غار كاليفورنيا (شجرة ساحل المحيط الهادئ ذات أوراق عطرية وزهور خيمية صغيرة تليها ثمار تشبه الزيتون؛ تنتج خشباً صلباً متيناً) / غار الجبل, كلمية عريضة الأوراق (شجيرة دائمة الخضرة من أمريكا الشمالية لها أوراق لامعة وزهور بيضاء أو وردية اللون)",
 "mountain lily": "زنبق الجبل, زنبق جبل كوك (نبات معمر مبهرج ذو أزهار بيضاء من نيوزيلندا) / زنبق الجبل (زنبق ياباني بأشعة ذهبية)",
 "mountain lion": "أسد الجبال, بوما (سنوري أمريكي كبير يشبه الأسد)",
 "mountain male fern": "سرخس ذكر جبلي (سرخس من جنس درايوبتيريس)",
 "mountain man": "رجل الحدود (رجل يعيش على الحدود البرية)",
 "mountain maple": "قيقب الجبل (قيقب شجيري صغير من شرق أمريكا الشمالية؛ قرمزي في الخريف)",
 "mountain mint": "بيكنانتيموم, نعناع الجبل",
 "mountain nyala": "نيالا الجبل (ظبي أشعث يعيش في جبال إثيوبيا)",
 "mountain oak": "بلوط الجبل, مران ألبي (شجرة خشبية طويلة ذات خشب صلب ثقيل وردي أو بني فاتح)",
 "mountain paca": "باكا الجبل (قارض يعيش في جبال غرب أمريكا الجنوبية)",
 "mountain parsley fern": "سرخس البقدونس الأوروبي, سرخس البقدونس الجبلي (سرخس في أوروبا وآسيا الصغرى بجذمور نحيل قصير وسعف أخضر زاهي كثيف يشبه البقدونس)",
 "mountain partridge": "سمان الجبل (حجل كاليفورنيا؛ أكبر قليلاً من سمان كاليفورنيا)",
 "mountain pass": "ممر, ممر جبلي (موقع في سلسلة جبال لتكوين جيولوجي يكون أقل ارتفاعاً من القمم المحيطة)\nمثال: عبرنا الممر قبل أن يبدأ الثلج في التساقط",
 "mountain peak": "قمة جبل (ذروة الجبل)",
 "mountain phlox": "قبس جبلي, قبس طحلبي (قبس معمر منخفض ذو خصلات بأوراق دائمة الخضرة تشبه الإبر وزهور وردية أو بيضاء؛ موطنه الولايات المتحدة ويزرع على نطاق واسع كغطاء أرضي)",
 "mountain pine": "صنوبر جبلي سويسري, صنوبر موغو (صنوبر شجيري منخفض من وسط أوروبا بإبر خضراء زاهية قصيرة في حزم من اثنتين) / صنوبر أبيض غربي, صنوبر فضي (صنوبر طويل من غرب أمريكا الشمالية بإبر زرقاء خضراء قوية؛ اللحاء رمادي بني بصفائح مستطيلة عند النضج) / باهوتيا (شجرة دائمة الخضرة من نيوزيلندا تشبه الكاواكا)",
 "mountain pride": "بنستيمون نيوبري, فخر الجبل (نبات يشكل حصيرة بأزهار وردية عميقة على سيقان ورقية قصيرة منتصبة؛ الأماكن الصخرية في المرتفعات العالية من أوريغون إلى كاليفورنيا)",
 "mountain quail": "سمان الجبل (حجل كاليفورنيا؛ أكبر قليلاً من سمان كاليفورنيا)",
 "mountain range": "سلسلة جبال, سلسلة جبلية (سلسلة من التلال أو الجبال)\nمثال: كان الوادي يقع بين سلسلتين من التلال",
 "mountain rice": "أرز الجبل, عشب الحرير (عشب علفي قيم في المناطق المرتفعة الجافة وسهول غرب أمريكا الشمالية إلى شمال المكسيك)",
 "mountain rimu": "ريمو جبلي (شجيرة منخفضة النمو إلى مفترشة ذات أغصان نحيلة زاحفة؛ موطنها نيوزيلندا)",
 "mountain rose": "ورد الجبل (ورد ألبي أوروبي ذو زهور قرمزية)",
 "mountain sandwort": "رملية جبلية, نجمة الجبل (رملية شمالية أو ألبية)",
 "mountain sheep": "خروف الجبل (أي خروف بري يعيش في المناطق الجبلية)",
 "mountain sickness": "داء الجبال (غثيان وضيق في التنفس يعاني منه متسلقو الجبال فوق عشرة آلاف قدم)",
 "mountain skink": "سقنقور جبلي (يتردد على موائل البلوط والصنوبر في المناطق الجبلية الصخرية بجنوب غرب الولايات المتحدة والمكسيك)",
 "mountain spinach": "رغل بستاني, سبانخ الجبل (نبات آسيوي يشبه السبانخ غالباً ما يستخدم كبقلة؛ متوطن في أوروبا وأمريكا الشمالية)",
 "mountain spleenwort": "طحال الجبل (طحال في شرق أمريكا الشمالية)",
 "mountain standard time": "توقيت المنطقة الجبلية (التوقيت القياسي في المنطقة الزمنية السابعة غرب غرينتش، يحسب عند خط الطول 105 غرباً؛ يستخدم في الولايات الجبلية بالولايات المتحدة)",
 "mountain starwort": "رملية جبلية, نجمة الجبل (رملية شمالية أو ألبية)",
 "mountain sumac": "سماق قزم, سماق لامع (شجيرة شائعة غير سامة في شرق أمريكا الشمالية بأوراق مركبة وزهور خضراء عنقودية تليها ثمار حمراء)",
 "mountain swamp gum": "صمغ المستنقعات الجبلي (صمغ مستنقعات متوسط الحجم من نيو ساوث ويلز وفيكتوريا)",
 "mountain tea": "توت الشاي, عنب الأرض (شجيرة زاحفة من شرق أمريكا الشمالية لها زهور بيضاء جرسية الشكل تليها ثمار حمراء تشبه التوت حارة وأوراق عطرية لامعة تنتج زيت الوينترغرين)",
 "mountain tent": "خيمة جبلية (خيمة خفيفة الوزن بأرضية؛ تُغلق اللوحات بسحاب)",
 "mountain time": "توقيت المنطقة الجبلية (التوقيت القياسي في المنطقة الزمنية السابعة غرب غرينتش، يحسب عند خط الطول 105 غرباً؛ يستخدم في الولايات الجبلية بالولايات المتحدة)",
 "mountain trail": "درب جبلي (مسار عبر منطقة جبلية)",
 "mountain viscacha": "شنشيلة الجبل, فيسكاتشا الجبل (قارض موطنه جبال تشيلي وبيرو ويُربى الآن في الأسر)",
 "mountain watercress": "جرجير أمريكي, جرجير الجبل (نبات معمر يشكل حصيرة يوجد في الينابيع الباردة في شرق الولايات المتحدة)",
 "mountain zebra": "حمار الزرد الجبلي (حمار زرد ضيق الخطوط شبه منقرض يعيش في جنوب أفريقيا)",
 "mountaineer": "متسلق جبال (شخص يقوم بتسلق الجبال)",
 "mountaineering": "تَسَلُّق الْجِبَال",
 "mountainous": "جَبَلِيّ",
 "mountainside": "سفح الجبل (جانب أو منحدر الجبل)\nمثال: تغطي غابات الصنوبريات السفح الشرقي",
 "mountebank": "دَجّال, مُشَعْوِذ",
 "mounted": "مُمْطَتِيّ, مُمْطَتِيَّّة",
 "mounter": "متسلق (شخص يصعد سيراً على الأقدام) / مُثَبِّت, مُرَكِّب (عامل ماهر يقوم بتركيب أو تثبيت الصور أو الجواهر وما إلى ذلك)\nمثال: متسلق وحيد للدرج",
 "mountie": "شُرْطِيّ خَيَّالَة كَنَدِيّ, ماونتِي (مصطلح عامي لعضو في شرطة الخيالة الملكية الكندية)",
 "mounties": "شرطة الخيالة الكندية الملكية (قوة الشرطة الفيدرالية لكندا)",
 "mounting": "قاعدة تثبيت (هيكل يستخدم للدعم أو العرض) / تسلق, تصاعد (حدث ينطوي على الارتفاع إلى نقطة أعلى (كما في الارتفاع أو درجة الحرارة أو الشدة، وما إلى ذلك))",
 "mourn": "نَدَبَ",
 "mourner": "ثاكِل, حَزِين (شخص يشعر بالحزن (خاصة الحزن على شخص مات))",
 "mournful": "أَسِيف, حَزِين (مليء بالحزن أو يثيره) / حَزِين, شَجِيّ (يعبّر عن الحزن والأسى)",
 "mournful widow": "جرب الحلو, زهرة وسادة الدبابيس (نبات حولي من العالم القديم له رؤوس زهور عطرة أرجوانية إلى قرمزية عميقة؛ متوطن في الولايات المتحدة)",
 "mournfully": "بأسى, بلوعة (بطريقة حزينة)\nمثال: حدق الشاب في كأسه بأسى",
 "mournfulness": "حزن, كآبة (حالة من الأسى الكئيب)",
 "mourning": "حِدَاد / ثَوْبُ حِدَاد (ما يُلْبَسُ من اللِبَاس، أي جزء ويطلق للرجال والنساء؛ الجزء الرئيس من الملابس، غالبا ما يكون طويلا وواسعا وذو أكمام، تحته الملابس الداخلية وفوقه الخارجية. يستخدم للرجال والنساء)\nمثال: هو ذئب في ثوب حمل.",
 "mourning band": "شريط الحداد (شريط أسود يرتديه الرجل (على الذراع أو القبعة) كعلامة على الحداد)",
 "mourning cloak": "فراشة العباءة, فراشة كامبرويل (من المناطق المعتدلة؛ لها أجنحة أرجوانية داكنة بحواف صفراء)",
 "mourning cloak butterfly": "فراشة العباءة, فراشة كامبرويل (من المناطق المعتدلة؛ لها أجنحة أرجوانية داكنة بحواف صفراء)",
 "mourning dove": "حمامة الحداد (حمامة برية في الولايات المتحدة لها نداء حزين)",
 "mourning ring": "خاتم الحداد (خاتم يُلبس تخليداً لذكرى شخص ميت)",
 "mouse": "فَأْرَة, فَأْر",
 "mouse button": "زر الفأرة (زر ضغط على فأرة الحاسوب)",
 "mouse click": "نقر, نقر الفأرة (ضغط زر على فأرة الكمبيوتر)\nمثال: نقر على الزر الأيمن على سبيل المثال",
 "mouse deer": "أيل الفأر, طرغول (مجتر صغير جداً عديم القرون يشبه الأيل من آسيا الاستوائية وغرب أفريقيا)",
 "mouse ear": "أذن الفأر, حشيشة القزاز (أي من النباتات المتنوعة المرتبطة بحشيشة القزاز الشائعة) / أذن الفأر, لا تنسني (عشب معمر صغير له أزهار زرقاء زاهية أو بيضاء)",
 "mouse eared chickweed": "أذن الفأر, حشيشة القزاز (أي من النباتات المتنوعة المرتبطة بحشيشة القزاز الشائعة)",
 "mouse hare": "بيكا (ثديي حفار صغير قصير الأذن من المرتفعات الصخرية في آسيا وغرب أمريكا الشمالية)",
 "mouse mat": "وسادة الفأرة (لوحة صغيرة محمولة توفر احتكاكاً لكرة فأرة الكمبيوتر)",
 "mouse nest": "جُحْرُ فَأْر, عُشُّ فَأْر (حيث تلد الفئران وتربي صغارها)",
 "mouse's nest": "جُحْرُ فَأْر, عُشُّ فَأْر (حيث تلد الفئران وتربي صغارها)",
 "mouse-colored": "بُنِّيّ فَأْرِيّ (بلون بني شاحب باهت يشبه لون الفأر)",
 "mouse-ear chickweed": "أذن الفأر, حشيشة القزاز (أي من النباتات المتنوعة المرتبطة بحشيشة القزاز الشائعة)",
 "mouse-ear cress": "رشاد أذن الفأر (عشب ضار صغير غازٍ ذاتي التلقيح بزهور بيضاء صغيرة؛ يدرسه علماء وراثة النبات كثيراً؛ أول نبات راقٍ تم وصف تسلسل جينومه الكامل)",
 "mouse-ear hawkweed": "صقور أذن الفأر (صقور أوروبي ذو أوراق مشعرة ناعمة)",
 "mouse-eared": "فَأْرِيُّ الأُذُنَيْن (له أذنان تُشبهان أذنَي الفأر)",
 "mouse-eared bat": "خفاش فأري الأذن (خفاش لاحم بأذنين تشبه أذني الفأر)",
 "mouse-sized": "بِحَجْمِ الْفَأْرِ (بحجم فأر تقريبًا)",
 "mouse-tooth forceps": "ملقط سن الفأر (نوع من ملاقط التضميد يحتوي على نقطة حادة رفيعة أو أكثر على طرف كل شفرة تتشابك مع السن أو الأسنان الموجودة على الشفرة المقابلة)",
 "mouselike": "بُنِّيّ فَأْرِيّ (بلون بني شاحب باهت يشبه لون الفأر)",
 "mousepad": "وسادة الفأرة (لوحة صغيرة محمولة توفر احتكاكاً لكرة فأرة الكمبيوتر)",
 "mouser": "صائد الفئران (قط ماهر في صيد الفئران)",
 "mousetrap": "مصيدة ((كرة القدم الأمريكية) لعبة يُسمح فيها للاعب مدافع بعبور خط الاشتباك ثم يتم حجبه بينما يمر العداء عبر المكان الذي أخلاه لاعب الخط) / مصيدة فئران (فخ لصيد الفئران)",
 "mousey": "خَامِل, ضَعِيف الشَّخْصِيَّة (هادئ وخجول وغير فعّال) / بُنِّيّ فَأْرِيّ (بلون بني شاحب باهت يشبه لون الفأر) / موبوء بالفئران (موبوء بالفئران)",
 "moussaka": "مُسَقَّعَة, مُصَقَّعَة",
 "mousse": "رغوة تصفيف, موس للشعر (مستحضر تجميلي يتكون من رغوة مضغوطة تستخدم في تصفيف الشعر) / موس مالح (طبق كريمي خفيف مصنوع من السمك أو اللحم ومثبت بالجيلاتين) / موس (تحلية غنية ورغوية ودسمة مصنوعة من بياض البيض المخفوق والقشدة الثقيلة)",
 "mousseline de sole": "موسلين دي سوا (قماش يشبه الشاش مصنوع من الحرير أو الرايون)",
 "moustache": "شَارِب",
 "moustache cup": "كوب الشارب (كوب شرب به قضيب داخل الحافة لإبعاد شارب الرجل عن المشروب)",
 "moustachio": "شَارِب ضَخْم, شَنَب (شارب كثيف كبير (مع شعر ينمو أحياناً على جانبي الفم))",
 "mousy": "خَامِل, ضَعِيف الشَّخْصِيَّة (هادئ وخجول وغير فعّال) / بُنِّيّ فَأْرِيّ (بلون بني شاحب باهت يشبه لون الفأر) / موبوء بالفئران (موبوء بالفئران)",
 "mouth": "فَم, بق",
 "mouth bow": "القيثار الفكي, قيثارة اليهود (آلة موسيقية صغيرة على شكل قيثارة توضع بين الأسنان ويتم العزف عليها بنقر لسان سلكي مع تغيير شكل تجويف الفم)",
 "mouth harp": "هارمونيكا (آلة صغيرة مستطيلة ذات قصبات حرة تحتوي على صف من القصبات الحرة مثبتة في ثقوب هوائية وتُعزف بالنفخ في الثقب المطلوب)",
 "mouth hole": "فتحة الفم (ثقب (كما في قناع التزلج) للفم)",
 "mouth organ": "هارمونيكا (آلة صغيرة مستطيلة ذات قصبات حرة تحتوي على صف من القصبات الحرة مثبتة في ثقوب هوائية وتُعزف بالنفخ في الثقب المطلوب)",
