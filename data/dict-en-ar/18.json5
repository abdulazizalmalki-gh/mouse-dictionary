 "musketry": "مهارة استخدام السلاح (تقنية استخدام الأسلحة الصغيرة (خاصة في المعركة)) / فرقة حملة البنادق (حملة البنادق وبنادقهم بشكل جماعي)",
 "muskhogean": "اللغات المسكوكية (عائلة من لغات هنود أمريكا الشمالية يتم التحدث بها في جنوب شرق الولايات المتحدة) / مسكوكي (فرد من أي من الشعوب التي عاشت سابقاً في جنوب شرق الولايات المتحدة وتتحدث لغات مسكوكية)",
 "muskhogean language": "اللغات المسكوكية (عائلة من لغات هنود أمريكا الشمالية يتم التحدث بها في جنوب شرق الولايات المتحدة)",
 "muskiness": "مسكية (امتلاك الخصائص الشمية للمسك)",
 "muskmelon": "شَمَّام",
 "muskogean": "اللغات المسكوكية (عائلة من لغات هنود أمريكا الشمالية يتم التحدث بها في جنوب شرق الولايات المتحدة) / مسكوكي (فرد من أي من الشعوب التي عاشت سابقاً في جنوب شرق الولايات المتحدة وتتحدث لغات مسكوكية)",
 "muskogean language": "اللغات المسكوكية (عائلة من لغات هنود أمريكا الشمالية يتم التحدث بها في جنوب شرق الولايات المتحدة)",
 "muskogee": "لغة مسكوكي (اللغة المسكوكية التي يتحدث بها شعب مسكوكي) / مسكوكي (فرد من الشعب المسكوكي عاش سابقاً في جورجيا وشرق ألاباما وشكلوا جوهر اتحاد الكريك)",
 "muskogee language": "لغة مسكوكي (اللغة المسكوكية التي يتحدث بها شعب مسكوكي)",
 "muskrat": "فَأْرُ المِسْك",
 "muskrat fur": "فراء المسك, فرو الجرذ المسكي (الفراء البني لجرذ المسك)",
 "muskus grass": "رقمة مسكية, نفل المسك (عشب أوروبي حولي منخفض توطن في أمريكا؛ يشبه الرقمة الشوكرانية)",
 "muskwood": "خشب المسك (شجيرة أو شجرة برائحة المسك من جنوب وجنوب شرق أستراليا لها رؤوس زهور صفراء كريمية)",
 "musky": "مِسْكِيّ (يُشْبِهُ رَائِحَةَ المِسْكِ)",
 "musky-scented": "بِرَائِحَةِ المِسْك, مِسْكِيّ (ذُو رَائِحَة المِسْك)",
 "muslim": "مُسْلِم, مُسْلِمَة ((للأشخاص) متبع دين الإِسْلَام)\nمثال: سامي مسلم سابق.",
 "muslim calendar": "تقويم إسلامي, تقويم هجري (التقويم القمري الذي يستخدمه المسلمون؛ يؤرخ من عام 622 م (عام الهجرة)؛ وتتراجع بداية السنة الإسلامية خلال السنة الشمسية مكملة الدورة كل 32 عاماً)",
 "muslim ummah": "الأمة, الأمة الإسلامية (المجتمع أو الشعب المسلم، الذي يمتد من موريتانيا إلى باكستان)\nمثال: يحث المسلمون المعتدلون الأمة على رفض إرهاب المتطرفين",
 "muslimah": "مسلمة (امرأة مسلمة)",
 "muslimism": "إسلام (النظام الديني التوحيدي للمسلمين الذي تأسس في شبه الجزيرة العربية في القرن السابع ويقوم على تعاليم محمد كما وردت في القرآن) / الإسلام (حضارة المسلمين بشكل جماعي التي يحكمها الدين الإسلامي)\nمثال: الإسلام أسلوب حياة كامل، وليس دين يوم الأحد فقط",
 "muslin": "مَوْصِلِيّ",
 "musnud": "مسند (مقعد بوسادة يستخدم كعرش للأمراء الهنود)",
 "musophobia": "رهاب الفئران (خوف مرضي من الفئران)",
 "musquash": "فأر المسك, مسك (قارض مائي يشبه القندس من أمريكا الشمالية ذو فراء بني لامع داكن)",
 "muss": "فوضى, كركبة (حالة من الارتباك وعدم النظام)\nمثال: كان المنزل في حالة فوضى",
 "mussel": "بَلَحُ الْبَحْر (تَصَحَّرَ أو جَفَّ بعد أن كان رطبًا، أو تغيّر لونه؛ في : تحول شيء إلى حالة مختلفة من رطوبة إلى جفاف أو عكسه)",
 "mussel shrimp": "صدفيات (قشريات بحرية ومياه عذبة صغيرة بجسم يشبه الروبيان محاط بصدفة ذات مصراعين)",
 "mussiness": "فوضى, كركبة (حالة من الارتباك وعدم النظام)\nمثال: كان المنزل في حالة فوضى",
 "mussitation": "تمتمة, غمغمة (صوت منخفض مستمر غير واضح؛ غالباً ما يكون مصحوباً بحركة الشفاه دون إنتاج كلام واضح)",
 "mussolini": "مُوسُولِينِي",
 "mussy": "فَوْضَوِيّ, وَسِخ (قَذِرٌ وَغَيْرُ مُنَظَّم)",
 "must": "وَجَبَ, يَتَحَتَّم (لَزِمَ، تَعَيَّنَ. (مصدره وُجُوب)؛ لزم وصار أكيد حدوثه. (مصدره وجُوب)) / لَابُدَّ / عَصِير (سائلٌ سُكَّريٌّ يُستخرج من بعض الثّمار عند عَصْرها)\nمثال: وجب عليك إيقافه.",
 "must-see": "شيء لا يُفَوَّت, ما يجب رؤيته (شيء يُعَد الاطلاع عليه أو رؤيته أمراً ضرورياً)",
 "mustache": "شَارِب (نمو للشعر غير المحلوق على الشفة العليا)\nمثال: بدا أصغر سناً بعد أن حلق شاربه",
 "mustache cup": "كوب الشارب (كوب شرب به قضيب داخل الحافة لإبعاد شارب الرجل عن المشروب)",
 "mustached": "ذُو شَارِب (أحد الأسماء الستة، لا يأتي إلا مُضَافًا، بمعنى صاحب)\nمثال: كان رجل ذو قامة طويله.",
 "mustachio": "شَارِب ضَخْم, شَنَب (شارب كثيف كبير (مع شعر ينمو أحياناً على جانبي الفم))",
 "mustachioed": "ذُو شَارِب (أحد الأسماء الستة، لا يأتي إلا مُضَافًا، بمعنى صاحب)\nمثال: كان رجل ذو قامة طويله.",
 "mustafa": "مُصْطَفَى (اسم مفعول من الفعل \"اصْطَفَى\"؛ اسم شخصي معطًى للذكور من العرب)\nمثال: الثلج أضعف قدرة مصطفى عن سماع خطوات أي شخص.",
 "mustang": "موستانج (حصان مراعي قوي صغير في السهول الغربية ينحدر من الخيول التي جلبها الإسبان)",
 "mustang mint": "مونارديلا, نعناع موستانج (عشب حولي عطري في كاليفورنيا له أوراق رمحية وعناقيد من الزهور الوردية الأرجوانية)",
 "mustard": "خَرْدَل",
 "mustard agent": "عامل منفط, غاز الخردل (غاز حرب سام بمركبات تعتمد على الكبريتيد يسبب البثور ويهاجم العيون والرئتين؛ لا يوجد ترياق معروف له)",
 "mustard gas": "غاز الخردل",
 "mustard greens": "أوراق الخردل, خردل (أوراق تؤكل مطبوخة)",
 "mustard oil": "زيت الخردل (زيت يُستخرج من بذور الخردل ويُستخدم في صنع الصابون)",
 "mustard plaster": "لبخة الخردل (لبخة تحتوي على مسحوق الخردل الأسود؛ توضع على الجلد كمهيج مضاد أو محمر للجلد)",
 "mustard sauce": "صلصة الخردل (صلصة من الخردل المخفف بالخل والزيت النباتي مع السكر والتوابل)",
 "mustard seed": "بذور الخردل (بذور سوداء أو بيضاء تطحن لصنع معاجين أو مساحيق الخردل)",
 "mustard tree": "أراك, شجرة الخردل (شجيرة أو شجرة دائمة الخضرة ملساء أو زغبية من جنس سلفادورا؛ أغصانها ليفية وتُربط في حزم في بعض أنحاء العالم وتستخدم كفرشاة أسنان (سواك)؛ وتستخدم…) / تبغ شجري, شجرة الخردل (شجيرة دائمة الخضرة من أمريكا الجنوبية تم توطينها في الولايات المتحدة؛ مسؤولة أحياناً عن تسمم الماشية)",
 "mustela erminea": "ابن عرس قصير الذيل, قاقم (حيوان من فصيلة العرسيات في نصف الكرة الشمالي في معطفه الشتوي الأبيض)",
 "mustela frenata": "ابن عرس طويل الذيل (ابن عرس أمريكي شائع يتميز بحجم كبير وذيل أسود الطرف)",
 "mustela nigripes": "نمس أسود الأقدام (ثديي من العرسيات في مناطق البراري بالولايات المتحدة؛ مهدد بالانقراض تقريباً)",
 "mustela nivalis": "ابن عرس صغير (من أوروبا)",
 "mustela putorius": "ظربان أوروبي (حيوان عرسيات بني داكن من غابات أوراسيا يطلق رائحة كريهة عند التهديد)",
 "mustela rixosa": "ابن عرس صغير (من كندا وشمال شرق الولايات المتحدة)",
 "mustela vison": "منك أمريكي (عادة ما يكون لونه بني داكن غني)",
 "mustelid": "عرسيات, فصيلة العرسيات (ثدييات آكلة للحوم ذات فراء وأقدام مشقوقة)",
 "musteline": "عرسيات, فصيلة العرسيات (ثدييات آكلة للحوم ذات فراء وأقدام مشقوقة)",
 "musteline mammal": "عرسيات, فصيلة العرسيات (ثدييات آكلة للحوم ذات فراء وأقدام مشقوقة)",
 "mustelus canis": "كلب البحر الأملس الأمريكي (يوجد على طول ساحل المحيط الأطلسي للأمريكتين)",
 "mustelus mustelus": "كلب البحر الأملس (كلب بحر أملس يعيش في المياه الساحلية الأوروبية)",
 "mustelus norrisi": "كلب البحر الأملس الفلوريدي (يوجد من شمال خليج المكسيك إلى البرازيل)",
 "muster": "تجنيد إجباري, خدمة إلزامية (الخدمة العسكرية الإلزامية) / تجمع عسكري, طابور (تجمع للأفراد العسكريين للخدمة)\nمثال: أُلقي به في السجن لتغيبه عن التجمع",
 "muster call": "نداء التجمع (مناداة أسماء الأفراد في تجمع عسكري)",
 "muster roll": "سجل التمام (قائمة بأسماء الضباط والرجال في وحدة عسكرية أو سرية سفينة)",
 "musth": "مسث, هياج جنسي (مرحلة سنوية من الإثارة الجنسية المتزايدة لدى ذكور بعض الثدييات الكبيرة (خاصة الفيلة)؛ ترتبط بإفرازات من غدة بين العين والأذن)\nمثال: كان الفيل الهائج في حالة هياج جنسي",
 "mustiness": "عفونة, كمكمة (جودة الشم أو التذوق بطعم قديم أو بائت أو متعفن)",
 "musty": "رَاكِد, عَفِن (ذُو رَائِحَةٍ عَتِيقَةٍ وَغَيْرِ نَظِيفَةٍ) / مُتَعَفِّن, مُكَلَّف (مُغَطًّى بِالعَفَن أَوْ ذُو رَائِحَة عَفَن)",
 "mutability": "قَابِلِيَّة لِلتَّحَوُّل, قَابِلِيَّة لِلتَّغَيُّر (صفة القابلية للتحول أو الطفرة)",
 "mutable": "قَابِل لِلطَّفْرَة (يميل إلى الخضوع لطفرة جينيّة) / قَابِل لِلتَّحَوُّل, مُتَغَيِّر (قادر على أو يميل إلى التغيير في الشكل أو الجودة أو الطبيعة) / غَيْرُ ثَابِتٍ, مُتَحَوِّل (مَيَّالٌ إِلَى التَّغَيُّرِ المُتَكَرِّرِ؛ غَيْرُ ثَابِتٍ)\nمثال: مادة قابلة للتحول",
 "mutableness": "قَابِلِيَّة لِلتَّحَوُّل, قَابِلِيَّة لِلتَّغَيُّر (صفة القابلية للتحول أو الطفرة)",
 "mutafacient": "مطفر (قادر على إحداث طفرة (يستخدم بشكل رئيسي للعوامل داخل الخلايا))",
 "mutagen": "مُطَفِّر",
 "mutagenesis": "تطفر, تكون الطفرات (حدث قادر على التسبب في طفرة)",
 "mutagenic": "مسبب للطفرات, مطفر (قادر على إحداث طفرة (يستخدم بشكل رئيسي للعوامل الخارجية مثل الأشعة السينية أو التلوث الكيميائي))",
 "mutamycin": "موتاميسين, ميتوميسين (معقد من المواد المضادة الحيوية التي يتم الحصول عليها من بكتيريا ستريبتوميسيس؛ يظهر أحد أشكاله (الاسم التجاري موتاميسين) واعداً كدواء مضاد للسرطان)",
 "mutant": "حيوان متحول, طافر (حيوان خضع لطفرة جينية) / طافر, متحول (يميل للخضوع لطفرة أو ناتج عنها) / طافر, طفرة ((في علم الأحياء) كائن حي له خصائص ناتجة عن تغيير كروموسومي)\nمثال: جين طافر",
 "mutant gene": "جين طافر (جين تغير بحيث يتأثر الانتقال والتعبير الطبيعي عن سمة ما)",
 "mutasarrif": "مُتَصَرِّف",
 "mutation": "طَفْرَة (التطوّر أو الارتفاع المفاجئ، الانتقال السريع من حالة إلى أخرى)",
 "mutational": "طفري (من أو يتعلق بالطفرة أو ناتج عنها)",
 "mutatis mutandis": "مَعَ إِجْرَاء التَّغْيِيرَات اللَّازِمَة (مع إجراء التغييرات الضرورية)",
 "mutative": "تحولي, طفري (من أو يتعلق بالطفرة الجينية أو يتميز بها)\nمثال: العمليات التحولية للطبيعة",
 "mutawa": "مطوعين, هيئة الأمر بالمعروف والنهي عن المنكر (شرطة دينية في السعودية واجبها ضمان الالتزام الصارم بقواعد السلوك المعمول بها؛ قد يتم احتجاز المخالفين لفترة غير محددة؛ لا يُستثنى الأجانب)",
 "mutawa'een": "مطوعين, هيئة الأمر بالمعروف والنهي عن المنكر (شرطة دينية في السعودية واجبها ضمان الالتزام الصارم بقواعد السلوك المعمول بها؛ قد يتم احتجاز المخالفين لفترة غير محددة؛ لا يُستثنى الأجانب)",
 "mutchkin": "موتشكين (وحدة قياس سائلة اسكتلندية تساوي 0.9 باينت أمريكي)",
 "mute": "أَخْرَس, أَبْكَم ((أَخْرَسَت) الأَرْض: لم تصلح للزِّرَاعَة؛ (أَخْرَسَ) الله فلَانا: أَصَابَهُ بالخرس) / صَامِت",
 "mute swan": "تَمّ أَخْرَس",
 "muted": "مَكْتُوم, مُخَفَّف (أصبح أو جُعل أكثر نعومة أو أقل علواً أو وضوحاً) / خَفِيض, مَهْمُوس (بنبرة مُخفَّضة ولَيِّنة)",
 "mutely": "بدون كلام, بصمت (بدون التحدث)\nمثال: جلس بصمت بجوارها",
 "muteness": "خرس, صمت (رفض التحدث عند التوقع) / بكم, خرس (حالة عدم القدرة أو عدم الرغبة في التحدث)\nمثال: كان صمته عن مساهمتي مفاجئاً",
 "muthanna": "المُثَنَّى",
 "mutilate": "شَوِهَ, بَتَرَ",
 "mutilated": "مَبْتُور, مُشَوَّه (فَقَدَ جُزْءًا مِنْ جَسَدِهِ أَوْ أُصِيبَ بِعَجْزٍ فِيهِ)",
 "mutilation": "تشويه, طمس المعالم (عملية إتلاف مظهر أو سطح شيء ما) / بتر, تشويه (إصابة تسبب تشوهاً أو تحرمك من طرف أو جزء مهم آخر من الجسم)\nمثال: تشويه فسيفساء إيطالية أثناء الغزو التركي",
 "mutilator": "مُشَوِّه, مُنَكِّل (شخص يشوه أو يدمر أو يغير المعالم أو يسبب عجزاً)",
 "mutillidae": "فصيلة الموتيليات, نمل مخملي (فصيلة من الدبابير)",
 "mutineer": "عاصٍ, مُتَمَرِّد (شخص متمرد علناً ويرفض الانصياع للسلطات (خاصة البحارة أو الجنود))",
 "mutinous": "عَاصٍ, مُتَمَرِّد عَسْكَرِيًّا (يَتَّسِم بِالتَّمَرُّد أَوْ يُحَرِّض عَلَى العِصْيَان) / ثَائِر, مُتَمَرِّد (ميّال إلى التمرد أو في حالة تمرد وعصيان)",
 "mutinus caninus": "فطر القرن النتن للكلب (فطر نتن له ساق بدون قبعة؛ الغليبا اللزجة ملتصقة ببساطة على سطحه بالقرب من القمة حيث يمكن للحشرات المجنحة العثور عليها)",
 "mutiny": "عِصْيَان, تَمَرُّد",
 "mutisia": "موتيسيا (أي من النباتات المختلفة من جنس موتيسيا)",
 "mutism": "بكم, خرس (حالة عدم القدرة أو عدم الرغبة في التحدث)\nمثال: كان خرسه نتيجة لصممه",
 "muton": "طفرة, موتون (التطوّر أو الارتفاع المفاجئ، الانتقال السريع من حالة إلى أخرى)",
 "mutt": "كلب شوارع, كلب هجين (كلب رديء أو من سلالة مختلطة)",
 "mutter": "غَمْغَمَة, تَمْتَمة / تَمْتَمَ, هَمْهَمَ",
 "mutterer": "متمتم (شخص يتحدث بصوت خافت وغير واضح)",
 "muttering": "تذمر, تمتمة (شكوى يتم التلفظ بها بنبرة منخفضة وغير واضحة) / تمتمة, غمغمة (صوت منخفض مستمر غير واضح؛ غالباً ما يكون مصحوباً بحركة الشفاه دون إنتاج كلام واضح)",
