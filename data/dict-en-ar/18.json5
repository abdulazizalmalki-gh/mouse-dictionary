 "nastika": "ناستيكا (مصطلح تقني في الهندوسية يُستخدم لتصنيف المدارس والأشخاص الفلسفيين الذين لا يقبلون سلطة الفيدا ككتب مقدسة عليا موحى بها)",
 "nastily": "بخبت, بسوء خلق (بطريقة سيئة المزاج وخبيثة)\nمثال: أضاف بخبث: لا تتوقع مني مساعدتك",
 "nastiness": "خُبْث, سُوء (صفة كون الشيء غير سار للغاية) / خبث, لؤم (الخبث الناتج عن كون الشخص حقودًا أو سيئ الطبع) / قذارة, نجاسة (حالة تتميز بالقذارة والنفايات الكريهة)\nمثال: جفلت من قذارة جرحه",
 "nasturtium": "كَبُوسِين",
 "nasturtium amphibium": "رشاد أصفر كبير, روريپا برمائية (عشبة معمرة توجد على ضفاف الجداول والأنهار في جميع أنحاء أوروبا باستثناء أقصى الشمال والبحر الأبيض المتوسط؛ توضع أحياناً في جنس ناستورتيوم)",
 "nasturtium officinale": "جرجير الماء, قرة العين (رشاد أوراسي معمر ينمو بشكل رئيسي في الينابيع أو المياه الجارية ذو أوراق لاذعة لحمية تستخدم في السلطات أو كعشبة طهي أو زينة؛ أدخل إلى أمريكا الشمالية…)",
 "nasty": "قَذِر جِدًّا, مُقْرِف (بالغ القذارة بشكل مثير للاشمئزاز؛ ملطّخ بمواد كريهة) / بَذِيء, سَافِل (يتّسم بالفحش وخدش الحياء) / ضَيِّق, عَصِيب (صَعْب التَّعَامُل مَعَهُ أَوْ تَجَاوُزِهِ إِلَى حَدِّ الإِحْبَاط) / بغيض, فظيع (مسيء أو حتى (للأشخاص) خبيث)\nمثال: في مزاج سيء",
 "nasua narica": "قوطي (ثديي قارت من أمريكا الوسطى وأمريكا الجنوبية)",
 "natal": "ميلادي, ولادي (متعلق بـ أو مصاحب للولادة) / أليوي, ردفي (مكون من أو متعلق بالأرداف)\nمثال: إصابات ولادية",
 "natal day": "عيد ميلاد, يوم الميلاد (التاريخ الذي ولد فيه الشخص)",
 "natal orange": "إسطركن شوكي",
 "natal plum": "خوخ الكاريس, كاريس (فاكهة قرمزية صالحة للأكل تشبه الخوخ لنبات من جنوب أفريقيا) / شوك السياج, كاريس ثنائي الشوك (شجيرة من جنوب إفريقيا لها أشواك متشعبة وثمار تشبه البرقوق؛ تستخدم بكثرة كسياج) / خوخ ناتال, كاريس كبير الثمار (شجيرة كبيرة جداً كثيفة التفرع من جنوب إفريقيا لها أشواك خضراء زاهية متشعبة وأوراق لامعة)",
 "natalie": "نَاتَالِي",
 "natality": "خُصُوبَة, مُعَدَّل المَوَالِيد (نسبة المواليد الأحياء في منطقة ما إلى سكان تلك المنطقة؛ يُعبر عنها لكل 1000 نسمة في السنة)",
 "nataraja": "نَاتَارَاجَا",
 "natasha": "نَاتَاشَا",
 "natation": "طفو (فعل الشخص الذي يطفو على الماء)",
 "natator": "سباح (شخص يسافر عبر الماء بالسباحة)\nمثال: إنه ليس سباحًا جيدًا",
 "natatorium": "حمام سباحة, مسبح (حوض يوفر منشأة للسباحة)",
 "nates": "أرداف, ألية (الجزء اللحمي من جسم الإنسان الذي يجلس عليه)\nمثال: يستحق ركلة جيدة في مؤخرته",
 "nathanael": "ناثانيال, نثنائيل",
 "nation": "دَوْلَة, وَطَن (بَلَد يتميز بحُدُود معروفة وشَعْب وحُكُومَة ومُؤَسَسَات مُنَظَّمَة؛ مجموعة من الناس مستقلين متحدين معا لتكوين مجتمع لحماية حقوقهم و وضع قوانينهم الخاصة)\nمثال: لبنان دولة صغيرة.",
 "nation of islam": "أمة الإسلام (مجموعة من الأمريكيين السود المسلحين الذين يعتنقون معتقدات دينية إسلامية ويدعون لاستقلال الأمريكيين السود)",
 "nation-state": "دَوْلَة قَوْمِيَّة (بَلَد يتميز بحُدُود معروفة وشَعْب وحُكُومَة ومُؤَسَسَات مُنَظَّمَة؛ مجموعة من الناس مستقلين متحدين معا لتكوين مجتمع لحماية حقوقهم و وضع قوانينهم الخاصة)\nمثال: لبنان دولة صغيرة.",
 "national": "وَطَنِيّ, قَوْمِيّ",
 "national academy of sciences": "الأكاديمية الوطنية للعلوم (جمعية فخرية أمريكية للعلماء أنشأها الرئيس لينكولن خلال الحرب الأهلية الأمريكية)",
 "national aeronautics and space administration": "الإدارة الوطنية للملاحة الجوية والفضاء, ناسا (وكالة مستقلة تابعة لحكومة الولايات المتحدة مسؤولة عن الطيران ورحلات الفضاء)",
 "national anthem": "نَشِيد وَطَنِيّ",
 "national archives and records administration": "إدارة الأرشيف والوثائق الوطنية (الوكالة المستقلة التي تشرف على إدارة سجلات الحكومة الفيدرالية بما في ذلك المكتبات الرئاسية والمجموعات التاريخية)",
 "national assembly": "الْجَمْعِيَّةُ الْوَطَنِيَّة",
 "national assistance": "إعانة تكميلية, مساعدة اجتماعية (مزايا تُدفع لرفع الدخل إلى الحد الأدنى للمستويات التي يحددها القانون)",
 "national association of realtors": "الرابطة الوطنية للوسطاء العقاريين (رابطة أمريكية للوكلاء العقاريين تتبع مدونة أخلاقية صارمة)",
 "national bank": "بنك وطني (بنك تجاري مرخص من قبل الحكومة الفيدرالية)",
 "national capital": "عاصمة وطنية (العاصمة لبلد ما)",
 "national censorship": "رقابة وطنية (رقابة تحت سلطة مدنية على الاتصالات التي تدخل أو تغادر أو تعبر حدود الولايات المتحدة أو أقاليمها أو ممتلكاتها)",
 "national climatic data center": "المركز الوطني للبيانات المناخية (جزء من الإدارة الوطنية للمحيطات والغلاف الجوي الذي يحتفظ بأكبر أرشيف نشط لبيانات الطقس في العالم)",
 "national committee": "لجنة وطنية (الوكالة التنفيذية الرئيسية لحزب سياسي؛ تتكون عادة من أعضاء يختارهم المؤتمر الوطني لتمثيل المناطق الجغرافية أو العناصر المكونة للحزب ولديها سلطات…)",
 "national day": "يَوْم وَطَنِيّ (فترة من الزمان تبدأ عند غُرُوب الشمس وتنتهي عند غُرُوب شمس النهار التالي ويشمل اللَيْلَة ونَهَارا. طوله أربع وعشرين سَاعَة؛ النَهَار، يبدأ من طلوع الفَجْر إلى غُرُوب الشَمس، على المجاز)\nمثال: طقس اليوم جميل.",
 "national debt": "دَيْن سِيَادِيّ, دَيْن عَامّ (العِبَادَة والتَقْدِيْس؛ المَذْهَب)\nمثال: الإسلام دين حق.",
 "national debt ceiling": "سقف الدين الوطني (حد يضعه الكونغرس لا يمكن للدين الوطني تجاوزه؛ ويتم رفعه دورياً بواسطة الكونغرس)",
 "national emblem": "شِعَار وَطَنِيّ (العلامة: وذلك من شعار العقلاء (مادة حلم من مجمع بحار الأنوار))\nمثال: الشعار ☭ هو رمز الشيوعية.",
 "national flag": "علم وطني (شعار يُرفع كرمز للجنسية)",
 "national geospatial-intelligence agency": "الوكالة الوطنية للاستخبارات الجغرافية المكانية (وكالة دعم قتالي توفر استخبارات جغرافية لدعم الأمن القومي)",
 "national guard": "الحرس الوطني (قوات احتياط عسكرية أمريكية تجندها الولايات وتجهزها الحكومة الفيدرالية؛ تخضع للاستدعاء من قبل أي منهما)",
 "national guard bureau": "مكتب الحرس الوطني (الوكالة التي تدير الحرس الوطني للجيش والحرس الوطني الجوي؛ وتوفر الاتصال بين الجيش والقوات الجوية ووحدات الحرس الوطني المختلفة)",
 "national holiday": "عطلة رسمية, عطلة قانونية (عطلة مصرح بها قانوناً ويتم فيها تقليص العمل أو الأعمال الرسمية)",
 "national income": "دخل قومي (القيمة الإجمالية لجميع الدخل في أمة (الأجور والأرباح والفوائد والإيجارات ومدفوعات المعاشات التقاعدية) خلال فترة معينة (عادة سنة واحدة))",
 "national institute of justice": "المعهد الوطني للعدالة (وكالة إنفاذ القانون التي تعد فرع البحث والتطوير لوزارة العدل)",
 "national institute of standards and technology": "المعهد الوطني للمعايير والتكنولوجيا (وكالة في إدارة التكنولوجيا تقوم بإجراء القياسات ووضع المعايير حسب الحاجة من قبل الصناعة أو البرامج الحكومية)",
 "national institutes of health": "المعاهد الوطنية للصحة (وكالة في وزارة الصحة والخدمات الإنسانية مهمتها توظيف العلم في السعي وراء المعرفة لتحسين صحة الإنسان؛ وهي الوكالة الرئيسية للبحوث الطبية الحيوية…)",
 "national insurance": "تأمين وطني (برنامج تأمين اجتماعي في بريطانيا؛ يعتمد على مساهمات من أصحاب العمل والموظفين؛ يوفر مدفوعات للعاطلين والمرضى والمتقاعدين بالإضافة إلى الخدمات الطبية)",
 "national intelligence community": "مجتمع الاستخبارات (مجموعة من الوكالات والمنظمات الحكومية التي تقوم بأنشطة استخباراتية لحكومة الولايات المتحدة؛ يرأسها مدير الاستخبارات المركزية)",
 "national labor relations board": "المجلس الوطني لعلاقات العمل (وكالة مستقلة تابعة لحكومة الولايات المتحدة مكلفة بالتوسط في النزاعات بين الإدارة ونقابات العمال)",
 "national leader": "رجل دولة, قائد وطني (شخص يعد قائداً محترماً في الشؤون الوطنية أو الدولية)",
 "national monument": "معلم وطني, نصب وطني (نصب تذكاري يتكون من هيكل أو معلم طبيعي ذي أهمية تاريخية؛ تخصصه الحكومة الوطنية للحفظ والاستمتاع العام)",
 "national oceanic and atmospheric administration": "الإدارة الوطنية للمحيطات والغلاف الجوي (وكالة في وزارة التجارة تقوم برسم خرائط المحيطات والحفاظ على مواردها الحية؛ تتنبأ بالتغيرات في بيئة الأرض؛ تقدم تقارير الطقس وتتنبأ بالفيضانات…)",
 "national park": "حَدِيقَة وَطَنِيَّة (الحَديقَةُ، الرَّوْضَةُ ذاتُ الشجرِ؛ حديقة , العاطل عن العمل في اللهجة العراقية وأصل تولد المعنى أن بعض العاطلين يقضون أوقاتهم في العناية بحدائق بيوتهم, فإذا سألهم سائل عن عملهم, ما هو؟…)\nمثال: ليس لدينا حديقة.",
 "national park service": "إدارة المتنزهات الوطنية (وكالة تابعة لوزارة الداخلية مسؤولة عن المتنزهات الوطنية)",
 "national reconnaissance office": "مكتب الاستطلاع الوطني (وكالة استخبارات في وزارة الدفاع الأمريكية تصمم وتبني وتشغل أنظمة استطلاع فضائية للكشف عن مناطق التوتر في جميع أنحاء العالم ومراقبة اتفاقيات الحد من…)",
 "national rifle association": "الرابطة الوطنية للبنادق (جماعة ضغط قوية تدافع عن الحق في امتلاك وحمل السلاح وترفض أي تنظيم للأسلحة من قبل الحكومة)",
 "national science foundation": "المؤسسة الوطنية للعلوم (وكالة مستقلة تابعة للحكومة الفيدرالية مسؤولة عن تعزيز التقدم في العلوم والهندسة من خلال دعم البرامج في البحث والتعليم)",
 "national security": "أَمْن وَطَنِيّ (وَثِقَ به وأرْكَنَ إليه)\nمثال: اتصل زيري بالأمن.",
 "national security agency": "وكالة الأمن القومي (منظمة التشفير الأمريكية التي تنسق وتوجه الأنشطة عالية التخصص لحماية أنظمة المعلومات الأمريكية وإنتاج معلومات استخباراتية أجنبية)",
 "national security council": "مجلس الأمن القومي (لجنة في الفرع التنفيذي للحكومة تقدم المشورة للرئيس بشأن الشؤون الخارجية والعسكرية والأمن القومي؛ تشرف على وكالة الاستخبارات المركزية)",
 "national service": "خدمة إلزامية, خدمة وطنية (الخدمة الإجبارية في الجيش خلال وقت السلم)",
 "national socialism": "اِشْتِرَاكِيَّة وَطَنِيَّة",
 "national socialist": "اشتراكي قومي, نازي (يتعلق بشكل من أشكال الاشتراكية)\nمثال: وصل الحزب الاشتراكي القومي إلى السلطة في ألمانيا عام 1933",
 "national socialist german workers' party": "حِزْب الْعُمَّال الْقَوْمِيّ الاِشْتِرَاكِيّ الْأَلْمَانِيّ (حزّب القومَ:جعلهم أحزاباً ، قوّاهم ، جعلهم من حزبه؛ حَزَّبْتُ القُرْآنَ: جَعَلْتُه أَحْزَاباً)\nمثال: التحقت بذلك الحزب.",
 "national sports team": "مُنْتَخَب",
 "national technical information service": "الخدمة الوطنية للمعلومات الفنية (وكالة في إدارة التكنولوجيا تعد موردًا أساسيًا للمعلومات العلمية والفنية والهندسية والمتعلقة بالأعمال الممولة من الحكومة)",
 "national trading policy": "سياسة تجارية (سياسة الحكومة للتحكم في التجارة الخارجية)",
 "national trust": "الصندوق الوطني (منظمة معنية بالحفاظ على الآثار والمباني التاريخية والأماكن ذات الأهمية التاريخية أو الجمال الطبيعي؛ تأسست عام 1895 وتدعمها الأوقاف والاشتراكات الخاصة)",
 "national volunteers association": "راشتريا سوايامسيفاك سانغ (منظمة للذكور فقط بدأت عام 1925 لتعزيز القومية لدى الهندوس في الهند)",
 "national weather service": "الهيئة الوطنية للأرصاد الجوية (الوكالة الفيدرالية في الإدارة الوطنية للمحيطات والغلاف الجوي المسؤولة عن التنبؤ بالطقس وإعداد خرائط الطقس)",
 "nationalisation": "تَأْمِيم",
 "nationalism": "قَوْمِيَّة (ما يجمع أمة ذات تاريخ وأمانٍ مشتركة)\nمثال: اللغة اليابانية لغتي القومية.",
 "nationalist": "قَوْمِيّ, قَوْمِيَّة",
 "nationalist leader": "زعيم وطني (زعيم حركة قومية)",
 "nationalistic": "قَوْمِيّ, نَزْعَة قَوْمِيَّة (إخلاص لمصالح أو ثقافة أمة معينة بما في ذلك تعزيز مصالحها) / شُوفِينِيّ, مُتَعَصِّبٌ وَطَنِيًّا (مُتَعَصِّبٌ لِلْوَطَنِيَّةِ تَعَصُّبًا مُفْرِطًا)",
 "nationality": "جِنْسِيَّة (مؤنث الجنسي، المنتسبة إلى الجنس؛ حالة الجنس أو ماهيته)\nمثال: لديه الجنسية الأوكرانية.",
 "nationalization": "تأميم (تحويل شيء ما من الملكية الخاصة أو السيطرة الخاصة إلى ملكية الدولة) / تأميم (عملية إضفاء الطابع الوطني) / تَأْسِيس قَوْمِيّ, تَحَوُّل إِلَى أُمَّة (فعل تشكيل أو أن تصبح أمة)",
 "nationalize": "أَمَّمَ",
 "nationally": "قومياً, وطنياً (فيما يتعلق بالأمة ككل) / على مستوى البلاد, وطنياً (ممتد عبر أمة بأكملها)\nمثال: ثقافة موحدة وطنياً",
 "nationhood": "قومية, كيان وطني (حالة كونه أمة)",
 "nationwide": "على مستوى البلاد, وطنياً (ممتد عبر أمة بأكملها) / عَلَى مُسْتَوَى البِلَاد, قَوْمِيّ (يحدث أو يمتدّ في أنحاء البلاد أو الأمّة كلّها)\nمثال: معلن عنه وطنياً",
 "native": "أَصْلِيّ",
 "native alaskan": "مواطن ألاسكا الأصلي (عضو أو سليل لأي من الشعوب الأصلية في ألاسكا)",
 "native american": "أمريكي أصلي, هندي أحمر (متعلق بالأمريكيين الأصليين أو ثقافتهم أو لغاتهم) / أمريكي أصلي, هندي أمريكي (أي فرد من الشعوب التي عاشت في أمريكا الشمالية أو الجنوبية قبل وصول الأوروبيين)\nمثال: ديانات الأمريكيين الأصليين",
 "native australian": "أبوريجينال, أسترالي أصلي (فرد من الشعب الذي كان يعيش في أستراليا عند وصول الأوروبيين)",
 "native bear": "كوالا (جرابي شجري أسترالي بطيء الحركة عديم الذيل ذو آذان ومعطف رمادي مكسو بالفراء؛ يتغذى على أوراق الكافور ولحائه)",
 "native beech": "زان أسترالي, فليندرسية أسترالية (شجرة خشبية أسترالية طويلة تنتج خشباً صلباً متيناً يستخدم في صناعة البراميل وغيرها)",
 "native cat": "قط أصلي, قط دصيور (جرابيات لاحمة شجرية تشبه القطط من أستراليا وتسمانيا)",
 "native cranberry": "توت الأرض, توت بري أصلي (شجيرة صغيرة منبطحة أو صاعدة ذات أزهار قرمزية وثمار عصارية تشبه التوت البري)",
 "native fuchsia": "فوشية شجرية, كونيني (شجيرة أو شجرة متساقطة الأوراق قائمة يصل ارتفاعها إلى 10 أقدام بزهور كستنائية؛ نيوزيلندا)",
 "native hawaiian": "هاواي أصلي (عضو أو سليل الشعب البولينيزي الأصلي الذي عاش في جزر هاواي)",
 "native holly": "بازلاء مسطحة شائعة (شجيرة منخفضة الانتشار دائمة الخضرة في جنوب أستراليا ذات أوراق مثلثة إلى شبه قلبية وزهور برتقالية صفراء تليها قرون مسطحة مجنحة)",
 "native land": "أرض الوطن, البلد الأم (البلد الذي ولدت فيه)",
 "native language": "لغة أصلية, لغة أم (اللغة التي يتحدث بها الشخص منذ طفولته المبكرة)",
 "native orange": "برتقال أصلي, قبار ميتشلي (شجرة أسترالية صغيرة تحمل ثماراً أرجوانية داكنة صالحة للأكل)",
 "native peach": "دراق محلي أسترالي, كوندونغ (فاكهة أسترالية حمراء؛ تستخدم للحلوى أو في المربى)",
 "native pear": "كمثرى أصلية, كمثرى خشبية (شجرة تحمل ثماراً على شكل كمثرى ذات غلاف ثخين خشبي)",
 "native pomegranate": "رمان أصلي, قبار شجري (شجرة أسترالية صغيرة تحمل ثماراً صالحة للأكل تشبه الرمان)",
 "native speaker": "نَاطِق أَصْلِيّ",
 "native sulfur": "حجر الكبريت, كبريت طبيعي (اسم قديم للكبريت)",
 "native sulphur": "حجر الكبريت, كبريت طبيعي (اسم قديم للكبريت)",
 "native-born": "ابْنُ البَلَد, مَوْلُودٌ فِي البَلَد (يَنْتَمِي إِلَى مَكَانٍ بِحُكْمِ الوِلَادَةِ فِيهِ)",
 "nativeness": "أَصْلِيَّة, وَطَنِيَّة (صفة الانتماء أو الارتباط بمكان أو منطقة معينة بحكم المولد أو الأصل)",
 "nativism": "فطرية ((فلسفة) النظرية الفلسفية القائلة بأن بعض الأفكار فطرية) / محلية, نصرة السكان الأصليين (سياسة إدامة الثقافات الأصلية (في معارضة للتثاقف))",
 "nativist": "أصلي, فطري (من أو يتعلق بمذهب الفطرة أو يدافع عنه) / إحيائي, انحيازي للسكان الأصليين (يدافع عن استمرار المجتمعات الأصلية) / فطري (فيلسوف يؤيد مذهب الفطرية)\nمثال: نظريات فطرية",
 "nativistic": "أصلي, فطري (من أو يتعلق بمذهب الفطرة أو يدافع عنه) / إحيائي, انحيازي للسكان الأصليين (يدافع عن استمرار المجتمعات الأصلية)\nمثال: نظريات فطرية",
 "nativity": "ميلاد, ولادة عذرية (العقيدة اللاهوتية القائلة بأن يسوع المسيح لم يكن له أب بشري؛ يعتقد المسيحيون أن ولادة يسوع حققت نبوءات العهد القديم وحضرتها المعجزات؛ يُحتفل بالميلاد…) / مولد, ميلاد (حدث الولادة)\nمثال: احتفلوا بميلاد طفلهم الأول",
 "nato": "الناتُو, حِلْفُ شَمَالِ الأَطْلَسِيّ",
 "natore district": "ضِلْع نَاتُور",
 "natriuresis": "بيلة صوديومية (وجود كميات كبيرة بشكل غير طبيعي من الصوديوم في البول)",
 "natriuretic": "مدر للصوديوم (مكون من أو متعلق بإدرار الصوديوم في البول)",
 "natrix maura": "ثعبان العشب الأفعواني (ثعبان عشب صغير غير ضار)",
 "natrix natrix": "ثعبان العشب, ثعبان مطوق (ثعبان أوروبي غير ضار ذو طوق أصفر ساطع؛ شائع في إنجلترا)",
 "natrix sipedon": "ثعبان الماء الشائع, ثعبان الماء المخطط (يُوضع في بعض التصنيفات في جنس نيروديا؛ ثعبان من غرب الولايات المتحدة نادراً ما يبتعد عن الماء)",
 "natrolite": "ناتروليت (مجموعة معادن من عائلة الزيوليت تتكون من سيليكات مائية للصوديوم والألومنيوم)",
 "natterjack": "علجوم ناترجاك (علجوم شائع بني مصفر قصير الأرجل من غرب أوروبا؛ يركض بدلاً من القفز)",
 "nattily": "بأناقة, بهندام (بطريقة أنيقة ومرتبة)\nمثال: تم ترتيبه بعناية وبأناقة",
 "nattiness": "أَنَاقَة, هِنْدَام (الأناقة كما تظهر في المظهر الذكي والمرتب)",
 "natty": "أَنِيق, مُتَنَاغِم",
 "natural": "طَبِيعِيّ",
