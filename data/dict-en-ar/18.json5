 "negress": "زِنْجِيَّة, زَنْجِيَّة",
 "negritude": "حركة الزنوجة (موقف أيديولوجي يرى أن الثقافة السوداء مستقلة وصالحة بشروطها الخاصة؛ تأكيد للتراث الثقافي الأفريقي)",
 "negro": "زِنْجِيّ, زَنْجِيّ",
 "negro peach": "خوخ الزنجي, ساركوسيفالوس (شجيرة استوائية قوية منتشرة أو شبه متسلقة ذات ثمار كروية ثؤلولية بنية محمرة؛ إفريقيا)",
 "negro pepper": "فلفل الزنوج, فلفل غينيا (شجرة دائمة الخضرة استوائية في غرب أفريقيا تحمل بذوراً عطرية لاذعة تستخدم كوابل وفي الطب الشعبي)",
 "negro race": "العرق الأسود, زنوج (عرق ذو بشرة داكنة)",
 "negro spiritual": "أغنية روحية, سبيرتشوال (نوع من الأغاني الدينية نشأ عن السود في جنوب الولايات المتحدة)",
 "negro vine": "فينسيتوكسيكوم, كرمة سوداء (كرمة ملتفة ذات أوراق مشعرة وأزهار بنية أرجوانية داكنة)",
 "negroid": "أسود, زنجي (شخص من أصل أفريقي ذو بشرة داكنة (مصطلحات زنجي وزنجاني قديمة ومسيئة اليوم))",
 "negroid race": "العرق الأسود, زنوج (عرق ذو بشرة داكنة)",
 "negroni": "نِيجْرُونِي",
 "negrophobia": "رُهَاب الزُنُوج",
 "negus": "نَجَاشِيّ ((تاريخيًّا) حاكم الحبشة (إثيوبيا)، أو أحد مقاطعاتها؛ تحديدًا، أيُّ ملك لإثيوبيا قبل عام ١٩٧٤م)",
 "nehemiah": "نَحَمْيَا",
 "nehru": "نَهْرُو",
 "neigh": "صَهِيل / صَهَلَ (صَهَلَ: (فعل)صهَلَ يَصهَل ويَصهِل ، صَهيلاً وصُهالاً ، فهو صاهِل صَهَلَ الْفَرَسُ : صَوَّتَ؛ ل. (فعل: ثلاثي لازم). صَهَلَ، يَصْهَلُ، مصدر صُهَالٌ، صَهِيلٌ.صَهَلَ الْفَرَسُ :صَوَّتَ)",
 "neighbor": "جار, مجاور (جسم قريب من نفس النوع) / جَار (شخص يسكن (أو يقع) بالقرب من آخر)\nمثال: فورت وورث جارة لدالاس",
 "neighborhood": "جِوَار, قُرْب / حَيّ (ضد المَيِّت، على قيد الحَيَاة؛ جمع حَيَاء) / جِوَار\nمثال: ينبح كلب في الحي.",
 "neighboring": "مُجَاوِر",
 "neighborliness": "حسن الجوار (الميل لكون المرء ودوداً ومساعداً للجيران)",
 "neighborly": "حَسَن الجِوَار (يُظْهِرُ الصِّفَات المُتَوَقَّعَة فِي جَار وَدُود)",
 "neighbour": "جَار, جَارة (له استخدامات متعددة، تتراوح بين وصف المكان والعلاقة بين الناس، وبين وصف فعل الظلم أو الميل عن الطريق الصحيح؛ \"جار\" كلمةٌ مُشْعِبَةُ المعنى، تشيرُ إلى المكانِ، والعلاقة، والظلم)\nمثال: لدي جارة مسلمة.",
 "neighbourhood": "جوار, جيرة (أشخاص يعيشون بالقرب من بعضهم البعض) / جوار, منطقة مجاورة (منطقة محيطة أو قريبة)\nمثال: إنه حي ودود",
 "neighbouring": "مُتَاخِم, مُجَاوِر (لَهُ حُدُودٌ أَوْ حَوَافٌّ مُشْتَرَكَةٌ؛ مُلَاصِقٌ وَمُلَامِسٌ)",
 "neighbourliness": "حسن الجوار (الميل لكون المرء ودوداً ومساعداً للجيران)",
 "neighbourly": "حَسَن الجِوَار (يُظْهِرُ الصِّفَات المُتَوَقَّعَة فِي جَار وَدُود)",
 "neisseria gonorrhoeae": "مكورة بنية, نيسرية بنية (البكتيريا المنتجة للقيح التي تسبب السيلان)",
 "neith": "نيث",
 "neither": "أَحَد لَا (العدد وَاحِد؛ الوَاحِد من الشيء) / مثال: لم يساعدني أحد.",
 "neither fish nor fowl": "لا السمك ولا الطيور (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: لا أحب المدرسة.",
 "neither … nor": "لَا… وَلَا …",
 "nekton": "سوابح, نيكتون (مجموع الحيوانات السابحة بنشاط في جسم مائي تتراوح من الكائنات المجهرية إلى الحيتان)",
 "nelfinavir": "فيراسيبت, نلفينافير (مثبط للبروتياز (الاسم التجاري فيراسيبت) يستخدم في علاج فيروس نقص المناعة البشرية عادة بالاشتراك مع أدوية أخرى)",
 "nelson": "نيلسون (أي من مسكات المصارعة حيث يتم تمرير الذراع تحت ذراع الخصم من الخلف والضغط على الرقبة)",
 "nelumbo lutea": "لوتس أمريكي, نلومبو أصفر (زنبق ماء من شرق أمريكا الشمالية له أزهار صفراء شاحبة وبذور كروية تشبه الجوز صالحة للأكل)",
 "nelumbo nucifera": "لوتس, لوتس مقدس (موطنه شرق آسيا؛ يزرع على نطاق واسع لأزهاره الكبيرة الوردية أو البيضاء)",
 "nem con": "بالإجماع (برأي واحد؛ بدون معارضة)\nمثال: وافق مجلس الشيوخ بالإجماع على مشروع القانون",
 "nematode": "نِيمَاتُودَا, دودَة اِسْطِوَانِيَّة",
 "nematode worm": "دودة أسطوانية, نيماتودا (ديدان غير مقسمة ذات جسم مستدير ممدود مدبب من كلا الطرفين؛ معظمها حرة المعيشة ولكن بعضها طفيلي)",
 "nembutal": "بنتوباربيتال الصوديوم, نيمبوتال (باربيتورات (الاسم التجاري نيمبوتال) يستخدم كمهدئ ومنوم ومضاد للتشنج)",
 "nemean games": "الألعاب النيمية (الألعاب الهيلينية القديمة التي كانت تقام كل سنتين في نيميا في السنة الثانية والرابعة من كل دورة أولمبية)",
 "nemean lion": "أسد نيميا ((الأساطير اليونانية) أسد ضخم خنقه هرقل كأول أعماله الاثني عشر)",
 "nemertean": "دودة خرطومية, دودة شريطية (ديدان بحرية رخوة غير مقسمة لها خرطوم يشبه الخيط والقدرة على التمدد والتقلص)",
 "nemertine": "دودة خرطومية, دودة شريطية (ديدان بحرية رخوة غير مقسمة لها خرطوم يشبه الخيط والقدرة على التمدد والتقلص)",
 "nemesis": "بلاء, لعنة (شيء يسبب البؤس أو الموت)\nمثال: لعنة حياتي",
 "nemine contradicente": "بالإجماع (برأي واحد؛ بدون معارضة)\nمثال: وافق مجلس الشيوخ بالإجماع على مشروع القانون",
 "nemophila": "نيموفيلا",
 "nemophila aurita": "زهرة العيد, فوليستوما (عشب حولي كاليفورني متناثر بأزهار أرجوانية عميقة أو بنفسجية؛ يوضع أحياناً في جنس نيموفيلا)",
 "nemophila maculata": "ذات الخمس نقط, نيموفيلا (نبات حولي من كاليفورنيا له زهور بيضاء بقعة أرجوانية عميقة على كل بتلة)",
 "nemophila menziesii": "عيون الطفل الزرقاء, نيموفيلا منزيسية (نبات حولي كاليفورني رقيق له أزهار زرقاء معلمة ببقع داكنة)",
