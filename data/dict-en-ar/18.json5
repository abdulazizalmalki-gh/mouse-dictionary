 "mucocutaneous": "مخاطي جلدي (متعلق بالأغشية المخاطية والجلد)",
 "mucocutaneous leishmaniasis": "ليشمانيا جلدية مخاطية (شكل من أشكال داء الليشمانيات؛ تقتصر القروح على الجلد والأغشية المخاطية)",
 "mucocutaneous lymph node syndrome": "داء كاواساكي (مرض حاد يصيب الأطفال الصغار يتميز بطفح جلدي وتضخم الغدد الليمفاوية والحمى)",
 "mucoid": "شبيه بالمخاط, مخاطاني (متعلق بالمخاط أو يشبهه) / مخاطاني (أي من عدة بروتينات سكرية تشبه الموسين)\nمثال: مادة شبيهة بالمخاط",
 "mucoidal": "شبيه بالمخاط, مخاطاني (متعلق بالمخاط أو يشبهه)\nمثال: مادة شبيهة بالمخاط",
 "mucopolysaccharide": "عديد السكاريد المخاطي (سكريات متعددة معقدة تحتوي على مجموعة أمينية؛ توجد بشكل رئيسي كمكونات للنسيج الضام)",
 "mucopolysaccharidosis": "داء عديد السكاريد المخاطي (أي من مجموعة الاضطرابات الوراثية التي تنطوي على خلل في استقلاب عديد السكاريد المخاطي)",
 "mucopurulent": "مخاطي قيحي (يحتوي على مخاط وقيح (صديد) أو يتكون منهما)",
 "mucor": "عفن موكور (أي عفن من جنس موكور)",
 "mucosa": "غشاء مخاطي, مخاطية (غشاء يفرز المخاط يبطن جميع تجاويف الجسم أو الممرات التي تتصل بالخارج)",
 "mucosal": "مخاطي (متعلق بالأغشية المخاطية)",
 "mucose": "مخاطي (متعلق بالمخاط أو يفرزه أو مغطى به أو يشبهه)\nمثال: نسيج مخاطي",
 "mucous": "مخاطي (متعلق بالمخاط أو يفرزه أو مغطى به أو يشبهه)\nمثال: نسيج مخاطي",
 "mucous colitis": "القولون التشنجي, متلازمة القولون العصبي (ألم بطني متكرر وإسهال (غالباً ما يتناوب مع فترات من الإمساك)؛ يرتبط غالباً بالضغط النفسي)",
 "mucous membrane": "غشاء مخاطي, مخاطية (غشاء يفرز المخاط يبطن جميع تجاويف الجسم أو الممرات التي تتصل بالخارج)",
 "mucous secretion": "مخاط (إفراز وقائي للأغشية المخاطية؛ في الأمعاء يسهل مرور الطعام ويحمي الخلايا الظهارية؛ وفي الأنف والحلق والرئتين يمكن أن يجعل من الصعب على البكتيريا…)",
 "mucoviscidosis": "تليف كيسي (أكثر الأمراض الوراثية شيوعاً؛ تنسد رئتا الطفل وأمعاؤه وبنكرياسه بمخاط سميك؛ يسببه خلل في جين واحد؛ لا يوجد علاج معروف)",
 "mucuna": "ميقونة (أي من النباتات الخشبية المنتصبة أو المتسلقة المتعددة من جنس ميقونة؛ واسعة الانتشار في المناطق الاستوائية في نصفي الكرة الأرضية)",
 "mucuna aterrima": "فاصولياء مخملية, ميقونة (كرمة خشبية حولية من آسيا لها عناقيد طويلة من الزهور الأرجوانية وقرون مشعرة كثيفة؛ تزرع في جنوب الولايات المتحدة للسماد الأخضر والرعي)",
 "mucuna deeringiana": "فاصولياء مخملية, ميقونة (كرمة خشبية حولية من آسيا لها عناقيد طويلة من الزهور الأرجوانية وقرون مشعرة كثيفة؛ تزرع في جنوب الولايات المتحدة للسماد الأخضر والرعي)",
 "mucuna pruriens utilis": "فاصولياء مخملية, ميقونة (كرمة خشبية حولية من آسيا لها عناقيد طويلة من الزهور الأرجوانية وقرون مشعرة كثيفة؛ تزرع في جنوب الولايات المتحدة للسماد الأخضر والرعي)",
 "mucus": "مُخَاط, نُخَاعَة",
 "mud": "طِين, وَحْل",
 "mud bath": "حمام طين (حمام في الطين الدافئ (لعلاج الروماتيزم مثلاً))",
 "mud brick": "طوب طيني (طوب مصنوع من الطين المخبوز)",
 "mud dauber": "دبور الطين (دبور يبني خلايا طينية على قاعدة صلبة تضع فيها الإناث البيض في يرقات حشرات مشلولة)",
 "mud digger": "حافر الخنادق (عامل يحفر الخنادق)",
 "mud flat": "مسطح طيني (قطعة أرض منخفضة طينية بالقرب من مصب النهر؛ تغطيها المياه عند المد وتنكشف عند الجزر)",
 "mud hen": "غر أمريكي (غر يوجد في أمريكا الشمالية)",
 "mud midget": "قزم الطين (له سعف مغمورة ضيقة مسطحة منجلية الشكل؛ أمريكا الشمالية)",
 "mud pie": "فطيرة طين (كتلة من الطين شكلها طفل على شكل فطيرة)",
 "mud plantain": "عشب نجمة الماء, هيترانثيرا (نبات مائي في أمريكا الشمالية ذو أوراق عشبية وأزهار صفراء على شكل نجمة)",
 "mud puddle": "بركة طينية (بركة من الطين)\nمثال: الأطفال أحبوا البركة الطينية",
 "mud puppy": "أكسولوتل, عفريت الماء (يرقة سمندل من البحيرات الجبلية في المكسيك تعيش عادة دون أن تتحول) / سمندل الجحيم (سمندل كبير من أنهار وجداول أمريكا الشمالية) / جرو الطين (سمندل مائي من أمريكا الشمالية بخياشيم خارجية ريشية حمراء)",
 "mud stain": "بقعة طين (بقعة ناتجة عن الطين)",
 "mud turtle": "سلحفاة الطين (سلحفاة مياه عذبة تعيش في القاع في الأنهار الطينية لأمريكا الشمالية والوسطى)",
 "mud-beplastered": "مُلَطَّخ بِالطِّين (مغطى بالطين أو ما يشبهه)",
 "mud-brick": "طوبي لبني (من أو يدمج الطوب اللبن)",
 "mudanjiang": "مُودَانْجْيَانْغ",
 "mudcat": "سلور مسطح الرأس (سلور كبير في وسط الولايات المتحدة له رأس مسطح وفك بارز) / سمك السلور, قرموط (لحم سمكة طعام عديمة القشور من جنوب الولايات المتحدة؛ غالباً ما تربى في المزارع)",
 "mudder": "حصان الطين (حصان سباق يركض جيداً على مضمار موحل)",
 "muddied": "كَدِر, مُعَكَّر ((في اللون) تغيّر بسبب الشوائب؛ غير ساطع أو صافٍ)",
 "muddiness": "تَغَيُّم, كُدْرَة (صفة كون الشيء غائماً) / ارتباك, تشوش (حالة عقلية تتميز بنقص في وضوح الفكر والسلوك ونظامهما) / طين, وحل (بلل الأرض المغطاة أو المشبعة بالماء)\nمثال: تشوش في الانطباعات",
 "muddle": "ارتباك, تخبط (ارتبك الأمر:اختلط عليه ، وفي الوحْل :نَشَبَ فيه وعَلِق ،وفي الأمر:وقع فيه ولم يكد يتخلّص منه؛ ارتبك في كلامه:إذا تَتَعْتَعَ، وارتبك الصّيد في الْحِبَالَة:اِضْطَرَب)\nمثال: لا داعي لارتباك.",
 "muddled": "مُخْتَلِط, مُشَوَّش الذِّهْن (مرتبك وغامض التفكير؛ يُقال خاصّة عن طريقة التفكير)",
 "muddleheaded": "أَبْلَه, مُخَبَّل (غبيّ ومشوّش الذهن)",
 "muddy": "مُغَطًّى بِالطِّين, مُوحَل (متّسخ وفوضويّ؛ مغطّى بالوحل أو الطين) / عَكِر, مُتَكَدِّر (عكر بسبب الرواسب أو الترسّبات؛ يُقال عن السوائل) / كَدِر, مُعَكَّر ((في اللون) تغيّر بسبب الشوائب؛ غير ساطع أو صافٍ) / مُسْتَنْقَعِيّ, وَحِل ((عن التربة) ليّنة ومشبَعة بالماء)",
 "mudguard": "واقي الطين (قطعة منحنية فوق عجلة دراجة أو دراجة نارية لحماية الراكب من الماء أو الطين الذي تقذفه العجلات)",
 "mudhif": "مضيف (كوخ من القصب في أهوار العراق؛ أصبح نادراً منذ تجفيف الأهوار)",
 "mudir": "مُدِير (الشخص الذي أدار، جمعه مُدِيرُون ومُدِيرِين؛ مهنة يتولى صاحبها إدَارَة شؤون جهة ما. جمعه مُدَرَاء)\nمثال: زيري هو المدير.",
 "mudra": "مودرا (حركة يد طقسية في الدين أو الرقص الديني، خاصة في الهندوسية أو البوذية)",
 "mudskipper": "سمكة الطين, نطاط الطين (توجد في المناطق الساحلية الاستوائية في أفريقيا وآسيا؛ قادرة على التحرك على اليابسة باستخدام زعانف صدرية قوية)",
 "mudslide": "انهيار طيني (انهيار أرضي مكون من الطين)",
 "mudslinger": "مشوه للسمعة, نابش في الفضائح (من ينشر فضائح حقيقية أو مزعومة عن شخص آخر (عادة لمصلحة سياسية))",
 "mudspringer": "سمكة الطين, نطاط الطين (توجد في المناطق الساحلية الاستوائية في أفريقيا وآسيا؛ قادرة على التحرك على اليابسة باستخدام زعانف صدرية قوية)",
 "muenster": "مونستر (جبن أصفر شاحب شبه طري)",
 "muesli": "مْيُوسْلِي, مُويِسْلِي",
 "muezzin": "مُؤَذِّن",
 "muff": "إفلات الكرة ((رياضة) إسقاط الكرة) / جعبة تدفئة اليدين, مُف (غطاء أنبوبي دافئ لليدين)",
 "muffin": "مَافِن",
 "muffin case": "كوب المافن الورقي (ورقة مستديرة من الورق أو القصدير أو السيليكون ذات حواف مضغوطة بشكل صدفي، مما يعطي المافن شكل كوب مستدير)\nمثال: تتوفر مجموعة متنوعة من الأحجام لأكواب المافن",
 "muffin cup": "كوب المافن الورقي (ورقة مستديرة من الورق أو القصدير أو السيليكون ذات حواف مضغوطة بشكل صدفي، مما يعطي المافن شكل كوب مستدير)\nمثال: تتوفر مجموعة متنوعة من الأحجام لأكواب المافن",
 "muffin man": "بائع الكعك (سابقاً بائع متجول ذكر للكعك)",
 "muffle": "فرن غطائي, فرن مكتوم (فرن ذو حجرة داخلية لحرق الأشياء عند درجة حرارة منخفضة)",
 "muffled": "مَكْتُوم, مُخَفَّف (أصبح أو جُعل أكثر نعومة أو أقل علواً أو وضوحاً) / مُدَثَّر, مُلَفَّف (ملفوف خاصة للحماية أو السرية)",
 "muffler": "كاتم, مخمّد (جهاز يقلل من سعة التذبذبات الإلكترونية أو الميكانيكية أو الصوتية أو الديناميكية الهوائية) / كوفية, لفحة (وشاح يلبس حول الرقبة) / كاتم صوت (جهاز صوتي أنبوبي يدرج في نظام العادم مصمم لتقليل الضوضاء)",
 "mufti": "مُفْتٍ, مُفْتِي",
 "mug": "كُوب, قَعْب (إناء للشرب لا عروة له؛ كل إناء للشرب. (تعميم)(غير معياري))\nمثال: الكوب مليء بالحليب.",
 "mug book": "ملف صور المجرمين (ملف لصور وجوه المجرمين تحتفظ به الشرطة)",
 "mug file": "ملف صور المجرمين (ملف لصور وجوه المجرمين تحتفظ به الشرطة)",
 "mug shot": "صورة جنائية (صورة لوجه شخص ما (خاصة تلك التي تؤخذ لسجلات الشرطة))",
 "mug's game": "لعبة خاسرة, مسعى أحمق (مسعى عقيم أو غير مربح)",
 "mugful": "ملء قدح, ملء كوب كبير (الكمية التي يمكن حملها في قدح)",
 "muggee": "ضَحِيَّة السَّلْب (ضحية عملية سطو أو سلب في الشارع)\nمثال: يبدو أن القانون يمنح حماية للمهاجم أكثر من ضحية السلب",
 "mugger": "نشال عنيف (لص يأخذ الممتلكات بالتهديد أو ممارسة العنف على الشخص المسروق (عادة في الشارع))",
 "mugginess": "رطوبة خانقة (حالة من الرطوبة الدافئة)",
 "mugging": "سلب بالإكراه, نشل بالعنف (اعتداء بقصد السرقة)",
 "muggins": "أحمق, ساذج (شخص يفتقر إلى الحكم السليم)",
 "muggle": "مَغَل, مَجَل",
 "muggle quidditch": "كويديتش (نسخة واقعية من لعبة كويديتش من سلسلة هاري بوتر)",
 "muggy": "حَارّ وَرَطْب, خَانِق (حارّ أو دافئ ورطب بشكل مزعج)",
 "mughal empire": "سَلْطَنَة اَلْهِنْدِيَّة",
 "mugho pine": "صنوبر جبلي سويسري, صنوبر موغو (صنوبر شجيري منخفض من وسط أوروبا بإبر خضراء زاهية قصيرة في حزم من اثنتين)",
 "mugil cephalus": "بوري مخطط (أهم أنواع البوري التجارية في شرق الولايات المتحدة)",
 "mugil curema": "بوري أبيض (بوري فضي في سواحل المحيط الأطلسي والهادئ)",
 "mugil liza": "ليزا (تشبه البوري المخطط وتحل محله في منطقة البحر الكاريبي)",
 "mugo pine": "صنوبر جبلي سويسري, صنوبر موغو (صنوبر شجيري منخفض من وسط أوروبا بإبر خضراء زاهية قصيرة في حزم من اثنتين)",
 "mugshot": "صورة جنائية (صورة لوجه شخص ما (خاصة تلك التي تؤخذ لسجلات الشرطة))",
 "mugwort": "حبق الراعي, شيح (الحَبِق : ضراط المَعز ، تقول : حبَقت تحْبِق حَبْقاً وحَبِقاً ، وقد تستعمل في النّاس : حَبَقَ يحبِق حبْقاً وحَبِقاً وحُباقاً؛ الحَبْق : ضُراط المَعِز ، وقد تستعمل في النّاس)",
 "mugwump": "محايد, مستقل (شخص محايد أو غير ملتزم (خاصة في السياسة)) / منشق جمهوري (شخص انشق عن الحزب الجمهوري خلال الانتخابات الرئاسية الأمريكية عام 1884)",
 "muhafazah": "مُحَافَظَة (تقسيم إداري في أرض دولة؛ المؤنث من \"مُحَافَظ\")\nمثال: نشأت ليلى في بلدة محافظة.",
 "muhammad": "مُحَمَّد (مُفَعَّل من حَمَّدَ؛ الذي يُحْمَدُ كثيرا) / سورة محمد\nمثال: محمد رسول الله.",
 "muhammadan": "محمدي (من أو يتعلق بالنبي العربي محمد أو بالدين الذي أسسه) / مُحَمَّدِيّ (تابع لمحمد (مصطلح غربي قديم للإشارة للمسلمين))",
 "muhammadan calendar": "تقويم إسلامي, تقويم هجري (التقويم القمري الذي يستخدمه المسلمون؛ يؤرخ من عام 622 م (عام الهجرة)؛ وتتراجع بداية السنة الإسلامية خلال السنة الشمسية مكملة الدورة كل 32 عاماً)",
 "muhammadanism": "إسلام (النظام الديني التوحيدي للمسلمين الذي تأسس في شبه الجزيرة العربية في القرن السابع ويقوم على تعاليم محمد كما وردت في القرآن)\nمثال: الإسلام أسلوب حياة كامل، وليس دين يوم الأحد فقط",
 "muhammedan": "مُحَمَّدِيّ (تابع لمحمد (مصطلح غربي قديم للإشارة للمسلمين))",
 "muharram": "مُحَرَّم ((اسم) المُحَرَّمُ: الشهر الأول من السنة القمرية أو التقويم الهجري؛ (صفة) المحرٌَمُ: ما ثبت النهي فيه بلا عارض، وحكمه الثواب بالترك لله تعالى، والعقاب بالفعل والكفر بالاستحلال، في المتفق) / ذِكْرَى مُحَرَّم\nمثال: محرم أول شهور السنة الهجرية.",
 "muharrum": "المحرم (الشهر الأول من التقويم الهجري)",
 "muhlenbergia schreberi": "نيمبلويل (عشب أمريكي متفرع رفيع له بعض القيمة للرعي في وسط الولايات المتحدة)",
 "muhyi'd-din": "مُحْيِي الدِّين",
 "muishond": "ابن عرس أفريقي (ابن عرس من جنوب أفريقيا)",
 "mujahadeen": "مجاهدين (قوة عسكرية من المحاربين المسلمين المشاركين في الجهاد)\nمثال: يسمي البعض المجاهدين محاربين دوليين لكن آخرين يسمونهم إرهابيين",
 "mujahadein": "مجاهدين (قوة عسكرية من المحاربين المسلمين المشاركين في الجهاد)\nمثال: يسمي البعض المجاهدين محاربين دوليين لكن آخرين يسمونهم إرهابيين",
 "mujahadin": "مجاهدين (قوة عسكرية من المحاربين المسلمين المشاركين في الجهاد)\nمثال: يسمي البعض المجاهدين محاربين دوليين لكن آخرين يسمونهم إرهابيين",
 "mujahedeen": "مجاهدين (قوة عسكرية من المحاربين المسلمين المشاركين في الجهاد)\nمثال: يسمي البعض المجاهدين محاربين دوليين لكن آخرين يسمونهم إرهابيين",
 "mujahedeen khalq": "مجاهدي خلق (مقاتلون إيرانيون متمركزون في العراق)",
 "mujahedin": "مجاهدين (قوة عسكرية من المحاربين المسلمين المشاركين في الجهاد)\nمثال: يسمي البعض المجاهدين محاربين دوليين لكن آخرين يسمونهم إرهابيين",
 "mujahid": "مُجَاهِد",
 "mujahideen": "مجاهدين (قوة عسكرية من المحاربين المسلمين المشاركين في الجهاد)\nمثال: يسمي البعض المجاهدين محاربين دوليين لكن آخرين يسمونهم إرهابيين",
 "mujahidin": "مجاهدين (قوة عسكرية من المحاربين المسلمين المشاركين في الجهاد)\nمثال: يسمي البعض المجاهدين محاربين دوليين لكن آخرين يسمونهم إرهابيين",
 "mujik": "موجيك (فلاح روسي (خاصة قبل عام 1917))",
 "mujtihad": "مجتهد (عالم إسلامي يمارس الاجتهاد لاستنباط الأحكام الشرعية من النصوص المقدسة)",
 "mukataa": "المقاطعة (كلمة عربية تعني المقر الرئيسي أو المركز الإداري)\nمثال: كان عرفات محاصراً في المقاطعة في مجمعه بالضفة الغربية",
 "mulatto": "خِلَاسِيّ",
 "mulberry": "تُوت",
 "mulberry fig": "جميز (شجرة واسعة الانتشار سميكة الفروع من أفريقيا وجنوب غرب آسيا المجاور مدعمة غالباً بفروع ترتفع من قرب الأرض؛ تنتج عناقيد من التين الصالح للأكل ولكنه…)",
 "mulberry liqueur": "ليكير التوت (مشروب كحولي مصنوع عن طريق نقع التوت في كحول قوي)\nمثال: عمتي تصنع أفضل ليكير توت",
 "mulberry tree": "توت, شجرة التوت",
 "mulch": "غطاء عضوي, مهاد (غطاء واقٍ من مواد نباتية متحللة ينشر لتقليل التبخر وتآكل التربة)",
 "mulct": "غرامة (أموال تُنتزع كعقوبة)",
 "mule": "بَغَل",
 "mule deer": "أيل البغل (أيل طويل الأذنين يعيش في غرب أمريكا الشمالية وله قرون ذات شعبتين)",
 "mule driver": "بغّال (عامل يقود البغال)",
 "mule fat": "دهن البغل (شجيرة كاليفورنيا ذات براعم ورقية نحيلة تعتبر علفاً مهماً للغزال البغلي)",
 "mule skinner": "بغّال (عامل يقود البغال)",
 "mule's ears": "أذن البغل (عشب بلسمي راتنجي بكتل من الأوراق الرمحية وسيقان ورقية قوية تنتهي بأزهار صفراء عميقة كبيرة على سيقان طويلة؛ شمال غرب الولايات المتحدة)",
 "muleteer": "مُكَارٍ",
 "muliebrity": "أنوثة (سمة التصرف بطرق تعتبر نموذجية للنساء) / أنوثة (حالة كونها امرأة بالغة)",
 "mulish": "صَلْب الرَّأْس, عَنِيد كَالبَغْل (صارم بشكل غير معقول في مواجهة الحجة أو التوسل)",
 "mulishly": "بإصرار, بعناد (بطريقة عنيدة)\nمثال: بقيت بعناد في نفس الوضع",
 "mulishness": "تصلب, عناد (سمة صعوبة التعامل أو التغلب عليها)",
 "mull": "مول (مصطلح يستخدم في الأسماء الاسكتلندية للنتوءات)\nمثال: رأس مول أوف كينتاير",
 "mulla": "ملا (مسلم مدرب في عقيدة وشريعة الإسلام؛ رئيس مسجد)",
 "mullah": "مُلَّا, مَوْلًى",
 "mulled cider": "عصير تفاح مبهر (عصير تفاح حلو مسخن مع التوابل والحمضيات)",
 "mulled wine": "نبيذ ساخن متبل (نبيذ مسخن مع سكر وتوابل وغالباً فواكه حمضية)",
 "mullein": "بُوصِير",
 "mullein pink": "قرنفل البوصير, ليخنيس إكليلي (نبات حديقة قديم في جنوب شرق أوروبا يزرع على نطاق واسع لأوراقه الصوفية البيضاء الجذابة وزهوره القرمزية المبهرجة)",
 "muller": "وعاء تسخين النبيذ (وعاء يتم فيه تسخين النبيذ وتتبيله) / مِدقّة, يد الهاون (أداة ثقيلة من الحجر أو الحديد (عادة ذات قاعدة مسطحة ومقبض) تستخدم لطحن وخلط المواد (كالحبوب أو الأدوية) في الهاون) / متأمل, مستغرق في التفكير (مفكر تأملي يتسم بالتفكر الهادئ)",
 "mullet": "بُورِيّ",
 "mulligan": "برغو إيرلندي, يخنة موليجان (نسخة إيرلندية من البرغو)",
 "mulligan stew": "برغو إيرلندي, يخنة موليجان (نسخة إيرلندية من البرغو)",
 "mulligatawny": "مليجاتوني (حساء من شرق الهند منكه بالكاري؛ محضر بقاعدة من اللحم أو الدجاج)",
 "mullion": "قائم النافذة (شريط رأسي غير هيكلي بين مصاريع أو ألواح النافذة (أو ألواح الشاشة))",
 "mullioned": "ذُو قَوَائِمَ فَاصِلَة ((للنَّوَافِذ) مُقَسَّم بِأَعْمِدَةٍ رَأْسِيَّةٍ عَادَةً مِنَ الحَجَر)",
 "mulloidichthys martinicus": "سمكة الماعز الصفراء (سمكة ماعز تعيش في أسراب؛ رمادية اللون مع شريط أصفر)",
 "mulloway": "مولوواي (سمكة غذائية مهمة كبيرة في أستراليا؛ لا يمكن تمييزها تقريباً عن الميغر)",
 "mullus auratus": "بربوني أحمر, سمكة الماعز الحمراء (جسمها قرمزي ساطع مع شريطين أصفرين إلى محمرين على الجانب)",
 "mullus surmuletus": "بربوني, سلطان إبراهيم (أسماك استوائية زاهية الألوان ذات زوائد استشعارية في الذقن)",
 "multi-billionaire": "ملياردير متعدد المليارات (شخص غني جداً تقدر ثروته المادية بمليارات الدولارات)",
 "multi-color": "أَبْلَق, مُتَعَدِّد الأَلْوَان (ذو أجزاء أو بقع ملوّنة بألوان مختلفة وزاهية عادةً)",
 "multi-colored": "أَبْلَق, مُتَعَدِّد الأَلْوَان (ذو أجزاء أو بقع ملوّنة بألوان مختلفة وزاهية عادةً)",
 "multi-colour": "أَبْلَق, مُتَعَدِّد الأَلْوَان (ذو أجزاء أو بقع ملوّنة بألوان مختلفة وزاهية عادةً)",
 "multi-coloured": "أَبْلَق, مُتَعَدِّد الأَلْوَان (ذو أجزاء أو بقع ملوّنة بألوان مختلفة وزاهية عادةً)",
 "multi-ethnic": "مُتَعَدِّدُ الأَعْرَاق (يشمل عدّة مجموعات إثنيّة)",
 "multi-seeded": "مُتَعَدِّدُ البُذُور (ذو بذور كثيرة متعدّدة)",
 "multi-stemmed": "مُتَعَدِّد السُّوق (ذو سيقان عديدة)",
 "multi-valued": "مُتَعَدِّد القِيَم, مُتَعَدِّد المَعَانِي (له قيم أو معانٍ أو جاذبيات متعددة)",
 "multibank holding company": "شركة قابضة متعددة البنوك (شركة قابضة بنكية تمتلك عدة بنوك)",
 "multicellular": "مُتَعَدِّد الخَلَايَا (يتكوّن من خلايا عديدة)",
 "multichannel recorder": "مسجل متعدد القنوات (مسجل بقناتين أو أكثر؛ يقوم بعمل سجلات مستمرة لإشارتين أو أكثر في وقت واحد)",
 "multicollinearity": "تعددية خطية (حالة من الانحدار المتعدد ترتبط فيها المتغيرات المتنبئة ببعضها البعض ارتباطًا عاليًا)",
 "multicolor": "أَبْلَق, مُتَعَدِّد الأَلْوَان (ذو أجزاء أو بقع ملوّنة بألوان مختلفة وزاهية عادةً)",
 "multicolored": "أَبْلَق, مُتَعَدِّد الأَلْوَان (ذو أجزاء أو بقع ملوّنة بألوان مختلفة وزاهية عادةً)",
 "multicolour": "أَبْلَق, مُتَعَدِّد الأَلْوَان (ذو أجزاء أو بقع ملوّنة بألوان مختلفة وزاهية عادةً)",
 "multicoloured": "أَبْلَق, مُتَعَدِّد الأَلْوَان (ذو أجزاء أو بقع ملوّنة بألوان مختلفة وزاهية عادةً)",
 "multicultural": "متعدد الثقافات (متعلق بعدة ثقافات أو يشملها)\nمثال: حدث متعدد الثقافات",
 "multiculturalism": "اَلتَّعَدُّدِيَّةُ اَلثَّقَافِيَّة",
 "multidimensional": "متعدد الأبعاد, متعدد الجوانب (له أو ينطوي على أو يتميز بأبعاد أو جوانب عدة)\nمثال: مشاكل متعددة الأبعاد",
 "multidimensional language": "لغة متعددة الأبعاد (لغة برمجة يتم تجميع تعبيراتها في أكثر من بعد واحد)",
 "multidimensionality": "تَعَدُّد الأَبْعَاد (خاصية امتلاك جوانب أو أوجه متعددة)",
 "multiengine airplane": "طائرة متعددة المحركات (طائرة بمحركين أو أكثر)",
 "multiengine plane": "طائرة متعددة المحركات (طائرة بمحركين أو أكثر)",
 "multiethnic": "مُتَعَدِّدُ الأَعْرَاق (يشمل عدّة مجموعات إثنيّة)",
 "multifaceted": "مُتَشَعِّب, مُتَعَدِّدُ الجَوَانِب (ذُو جَوَانِبَ أَوْ صِفَاتٍ كَثِيرَة)",
 "multifactorial": "مُتَعَدِّد العَوَامِل (يَتَضَمَّن أَوْ يَعْتَمِد عَلَى عِدَّة عَوَامِل أَوْ أَسْبَاب)",
 "multifarious": "مُتَعَدِّد, مُتَنَوِّع",
 "multifariously": "بشكل متنوع, بشكل مختلف (بطرق متنوعة)\nمثال: البدائل التي يتم تمثيلها بشكل مختلف من قبل المشاركين",
 "multifariousness": "اخْتِلَاف, تَعَدُّدِيَّة (عدم تجانس ملحوظ)\nمثال: تنوع في الاحتمالات",
 "multiflora": "ورد متعدد الأزهار, ورد ياباني (ورد قوي النمو له عناقيد من الزهور الصغيرة العديدة؛ يستخدم للأسيجة وكأصل للتطعيم)",
 "multiflora rose": "ورد متعدد الأزهار, ورد ياباني (ورد قوي النمو له عناقيد من الزهور الصغيرة العديدة؛ يستخدم للأسيجة وكأصل للتطعيم)",
 "multifocal iol": "زرعة عدسة متعددة البؤر (نوع من زرعات العدسة يحتوي على عدة حلقات بمركز مشترك ويضبط للرؤية القريبة أو البعيدة)",
 "multifocal lens implant": "زرعة عدسة متعددة البؤر (نوع من زرعات العدسة يحتوي على عدة حلقات بمركز مشترك ويضبط للرؤية القريبة أو البعيدة)",
 "multiform": "متعدد الأشكال (يحدث في أو له أشكال أو هيئات أو مظاهر عديدة)\nمثال: الكون متعدد الأشكال للطبيعة والإنسان",
 "multifunctionality": "تَعَدُّدِيَّة الوَظَائِف (حالة امتلاك وظائف متعددة)",
 "multilane": "متعدد المسارات ((للطرق والطرق السريعة) بها حارتان أو أكثر لحركة المرور)",
 "multilateral": "مُتَعَدِّد الأَطْرَاف, مُتَعَدِّد الجَوَانِب (لديه أجزاء أو جوانب متعددة)",
 "multilaterally": "مُتَعَدِّد الأَطْرَاف (بطريقة متعددة الأطراف؛ بحيث تؤثر على العديد من الأطراف أو الحكومات)\nمثال: توصلوا إلى اتفاق متعدد الأطراف",
 "multilevel": "متعدد المستويات (مبنى له أكثر من مستوى)",
 "multilinear evolution": "التطور متعدد الخطوط (نظرية تطورية جديدة تتصور التطور الثقافي كعملية تتكون من عدد من المسارات الأمامية ذات الأنماط والأطوال المختلفة)",
 "multilingual": "مُتَعَدِّد اللُّغَات, أَلْسُنِيّ / أَلْسُنِيّ, لِسانجيّ",
 "multilingualism": "متعدد اللغات",
 "multimedia": "اَلْوَسَائِط اَلْمُتَعَدِّدَة",
 "multimedia system": "وسائط متعددة (إرسال يجمع بين وسائط الاتصال (النصوص والرسومات والصوت وغيرها))",
 "multimodal bill of lading": "بُولِيصَة شَحْن مُتَعَدِّدَة الْوَسَائِط (بوليصة شحن تصدر عندما تمر الشحنة عبر وسيلتي نقل مختلفتين على الأقل)\nمثال: يتحمل مصدر بوليصة الشحن متعددة الوسائط المسؤولية الكاملة عن الشحنة طوال مدة رحلتها",
 "multinational": "عَابِر لِلْأُمَم, مُتَعَدِّد الجِنْسِيَّات (يشمل أو يعمل في عدة دول أو جنسيات)",
 "multinomial": "متعدد الحدود (لديه طابع متعدد الحدود) / كَثِيرَة الحُدُود, مُتَعَدِّدَة الحُدُود (دالة رياضية هي مجموع عدد من الحدود)\nمثال: تعبير متعدد الحدود",
 "multinucleate": "متعدد النوى (يحتوي على نواتين أو أكثر)",
 "multiparous": "متعدد الولادة (ينتج أكثر من نسل واحد في كل مرة)",
 "multipartite": "مُتَعَدِّد الأَطْرَاف (يشمل أكثر من طرفين)",
 "multiphase": "متعدد الأطوار (نظام كهربائي يستخدم أو يولد جهدين مترددين أو أكثر بنفس التردد ولكن بزوايا طور مختلفة)",
 "multiple": "متعدد / مُضَاعَف",
 "multiple correlation": "ارتباط متعدد, انحدار متعدد (تقنية إحصائية تتنبأ بقيم متغير واحد على أساس متغيرين آخرين أو أكثر)",
 "multiple correlation coefficient": "معامل الارتباط المتعدد (تقدير للتأثير المشترك لمتغيرين أو أكثر على المتغير المرصود (التابع))",
 "multiple fruit": "ثمرة متجمعة (فاكهة تتكون من العديد من الفواكه الصغيرة الفردية أو النواة المشتقة من مبايض منفصلة داخل وعاء مشترك: مثل التوت الأسود والتوت الأحمر والأناناس)",
 "multiple mononeuropathy": "اعتلال الأعصاب الأحادي المتعدد (اعتلال يصيب عدة جذوع عصبية فردية)",
 "multiple myeloma": "ورم نقوي متعدد (ورم نقوي يتطور في عدة أماكن في نفس الوقت)",
 "multiple neuritis": "التهاب الأعصاب المتعدد (التهاب العديد أو كل الأعصاب المحيطية (كما في الجذام))",
 "multiple personality": "انفصام الشخصية, تعدد الشخصيات (اضطراب انشقاقي نادر نسبياً ينهار فيه التكامل المعتاد للشخصية وتظهر شخصيتان مستقلتان أو أكثر)",
 "multiple regression": "ارتباط متعدد, انحدار متعدد (تقنية إحصائية تتنبأ بقيم متغير واحد على أساس متغيرين آخرين أو أكثر)",
 "multiple rocket launcher": "رَاجِمَة صَوَارِيخ",
 "multiple sclerosis": "تَصَلُّب لُوَيْحِيّ",
 "multiple star": "نَجْم مُتَعَدِّد (نظام مكون من ثلاثة نجوم أو أكثر مرتبطة بالجاذبية)",
 "multiple voting": "تصويت متعدد (فعل التصويت في أكثر من مكان من قبل نفس الشخص في نفس الانتخابات (غير قانوني عادة))",
 "multiple-choice": "متعدد الخيارات (يقدم عدة إجابات بديلة يجب اختيار الإجابة الصحيحة منها)\nمثال: أسئلة متعددة الخيارات",
 "multiple-furrow plough": "محراث متعدد الأخاديد (محراث يحتوي على سكتين أو أكثر، وسكاكين، وألواح تشكيل مصممة للعمل في وقت واحد)\nمثال: تم استخدام محاريث متعددة الأخاديد تصل إلى أربعة عشر قاعاً",
 "multiple-furrow plow": "محراث متعدد الأخاديد (محراث يحتوي على سكتين أو أكثر، وسكاكين، وألواح تشكيل مصممة للعمل في وقت واحد)\nمثال: تم استخدام محاريث متعددة الأخاديد تصل إلى أربعة عشر قاعاً",
 "multiplex": "مُتَشَعِّب, مُتَعَدِّد (ذُو أَجْزَاء أَوْ جَوَانِب كَثِيرَة) / مُتَشَعِّب, مُتَنَوِّع (كثير ومتنوّع؛ ذو أشكال أو سمات عديدة) / متعدد الصالات, مجمع سينمائي (دار عرض سينمائي بها عدة قاعات مختلفة في نفس المبنى) / إرسال متعدد (توصيل إشارتين أو أكثر عبر قناة مشتركة)",
 "multiplex operation": "عملية متعددة الإرسال (عملية تتداخل فيها نشاطان أو أكثر)",
 "multiplexer": "مجمع إشارات, ملتيبلكسر (جهاز يمكنه تداخل نشاطين أو أكثر)",
 "multiplicand": "مَضْرُوب (العدد الذي يتم ضربه في المضروب فيه)",
 "multiplication": "ضَرْب (معروف، وهو اللطم أو الدق أو الصكّ و ما أشبه؛ النَوْع أو الصنف أو المثال)\nمثال: ضرب سامي زوجته.",
 "multiplication dot": "علامة الضرب, نقطة الضرب (علامة تشير إلى عملية الضرب)",
 "multiplication sign": "علامة الضرب, نقطة الضرب (علامة تشير إلى عملية الضرب)",
 "multiplication table": "جَدْوَل ضَرْب",
 "multiplicative": "تَضَاعُفِيّ, مُضَاعِف (يميل إلى المضاعفة أو لديه القدرة على زيادة العدد أو الكمّيّة أو الدرجة)",
 "multiplicative inverse": "مَقْلُوب, نَظِير ضَرْبِيّ ((الرياضيات) أحد زوجين من الأعداد ناتج ضربهما هو 1: مقلوب 2/3 هو 3/2)",
 "multiplicatively": "بشكل مضاعف (بطريقة مضاعفة)\nمثال: زادت الأخطاء بشكل مضاعف",
