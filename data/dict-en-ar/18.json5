 "nefertem": "نفرتوم",
 "nefertiti": "نفرتيتي",
 "negaprion brevirostris": "قرش ليموني (قرش شائع يعيش في أسراب في المياه الضحلة للمحيط الأطلسي من نورث كارولينا إلى البرازيل وقبالة غرب أفريقيا؛ خطير)",
 "negate": "رَفَضَ (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟",
 "negation": "نَفْي / إِنْكَار",
 "negative": "سَلْبِيّ / سَلْبِيّ, سَالِب / مَنْفِيّ / سَالِب / صُورَة سَالِبَة",
 "negative balance": "رَصِيد سَالِب, رَصِيد مَدِين (رصيد حساب تتجاوز فيه الديون (المدفوعات) الاعتمادات (الإيداعات)، ويكون العميل مديناً للبنك بالمال)",
 "negative charge": "شحنة سالبة (وجود فائض من الإلكترونات؛ وجود جهد كهربائي أقل)",
 "negative chemotaxis": "انتحاء كيميائي سلبي (حركة بعيدًا عن محفز كيميائي)",
 "negative clause": "جُمْلَة مَنْفِيَّة (مؤنث جُمْل، وهو الحبل الغليظ أو الجماعة من الناس؛ المَجْمُوع)\nمثال: يا لها من جملة!",
 "negative correlation": "ارتباط سالب, ارتباط عكسي (ارتباط ترتبط فيه القيم الكبيرة لمتغير واحد بقيم صغيرة للآخر)",
 "negative feedback": "تغذية راجعة سلبية (تغذية راجعة في طور معاكس للمدخلات (تعمل على تقليلها))",
 "negative feedback circuit": "دائرة تحكم, دائرة تغذية راجعة سلبية (دائرة تغذية راجعة تطرح من المدخلات)",
 "negative identification": "التعرف السلبي, نفي الهوية (دليل يثبت أنك لست الشخص الذي تدعي أنك لست هو؛ دليل يثبت أنك لست ضمن مجموعة من الأشخاص المعروفين بالفعل للنظام؛ التعرف من قبل النظام يؤدي إلى الرفض)\nمثال: نظام لنفي الهوية يمكن أن يمنع استخدام هويات متعددة من قبل شخص واحد",
 "negative magnetic pole": "قطب جنوبي, قطب سالب (قطب المغناطيس الذي يشير نحو الجنوب عند تعليق المغناطيس بحرية)",
 "negative muon": "مِيُون (جسيم أولي بشحنة سالبة وعمر نصف يبلغ 2 ميكروثانية؛ يتحلل إلى إلكترون ونيوترينو ونقيض نيوترينو)",
 "negative number": "عَدَد سَالِب (مِقْدَار مَا يُعَدّ)\nمثال: كم عدد سكان الجزائر؟",
 "negative pole": "قطب جنوبي, قطب سالب (قطب المغناطيس الذي يشير نحو الجنوب عند تعليق المغناطيس بحرية) / قطب سالب (طرف البطارية المتصل باللوح السالب)",
 "negative reinforcer": "مثير معزز سلبي, معزز سلبي (مثير معزز تعمل إزالته على تقليل احتمالية الاستجابة التي أنتجته)",
 "negative reinforcing stimulus": "مثير معزز سلبي, معزز سلبي (مثير معزز تعمل إزالته على تقليل احتمالية الاستجابة التي أنتجته)",
 "negative stimulation": "تثبيط, مُنَفِّر (شيء يسبب العداء أو فقدان الاهتمام)",
 "negative stimulus": "مثير سلبي (مثير له عواقب غير مرغوب فيها)",
 "negatively": "بشكل سلبي, سلبياً (بطريقة سلبية) / بشكل ضار, سلبياً (بطريقة ضارة أو مؤذية)\nمثال: كان يميل بشكل سلبي",
 "negatively charged": "سَالِب الشِّحْنَة, سَلْبِيّ (ذو شحنة كهربائيّة سالبة)",
 "negativeness": "سلبية (كمية أقل من الصفر) / سلبية (صفة تتميز بالشك المعتاد والميل لإنكار أو معارضة أو مقاومة الاقتراحات أو الأوامر) / سَلْبِيَّة (طبيعة القطب الكهربائي السالب)",
 "negativism": "سلبية (صفة تتميز بالشك المعتاد والميل لإنكار أو معارضة أو مقاومة الاقتراحات أو الأوامر)",
 "negativist": "انهزامي, سلبي (شخص يستسلم للهزيمة دون تقديم اقتراحات إيجابية) / سَلْبِيّ, مُعَانِد (شخص يرفض القيام بما يُطلب منه أو يفعل عكسه)",
 "negativity": "سلبية كهربائية ((كيمياء) ميل الذرة أو الجذر لجذب الإلكترونات في تكوين رابطة أيونية) / سلبية (كمية أقل من الصفر) / سلبية (صفة تتميز بالشك المعتاد والميل لإنكار أو معارضة أو مقاومة الاقتراحات أو الأوامر) / سَلْبِيَّة (طبيعة القطب الكهربائي السالب)",
 "negatron": "إِلِكْتْرُون (جسيم أولي ذو شحنة سالبة)",
 "negeri sembilan": "نِكِرِي سِمْبِيلَن",
 "negev": "النَّقَب",
 "neggram": "حمض الناليديكسيك, نيغرام (عامل مضاد للبكتيريا يستخدم بشكل خاص لعلاج التهابات الجهاز البولي التناسلي)",
 "neglect": "أَهْمَلَ / إِهْمَال",
 "neglect of duty": "إهمال الواجب ((قانون) الإخلال بالواجب)",
 "neglected": "مَتْرُوك, مُهْمَل (يَفْتَقِر إِلَى مَنْ يَعْتَنِي بِه) / مُتَجَاهَل, مُهْمَل (لم يُؤبَه له؛ أُهمِل عمداً)",
 "neglecter": "مُهْمِل (شخص مهمل ولا يعير اهتماماً أو احتراماً كبيراً للناس أو المسؤوليات)\nمثال: حاول عبثاً إقناع مهمليه",
 "neglectful": "مُقَصِّر, مُهْمِل (يُخِلّ بِمَا يَقْتَضِيه الوَاجِب) / غَافِل, لَاهٍ (لَا يُبْدِي العِنَايَة أَوِ الِانْتِبَاه اللَّازِمَيْن)",
 "neglectfully": "بإهمال (بطريقة مهملة)",
 "neglectfulness": "إهمال, تقصير (سمة إهمال المسؤوليات ونقص الاهتمام)",
 "neglige": "قميص نوم, نيجليجيه (روب نوم فضفاض للنساء)",
 "negligee": "قميص نوم, نيجليجيه (روب نوم فضفاض للنساء)",
 "negligence": "إهمال, تقصير (الفشل في التصرف بالحكمة التي يمارسها الشخص العاقل في نفس الظروف) / إهمال, تقصير (سمة إهمال المسؤوليات ونقص الاهتمام)",
 "negligent": "متهاون, مقصّر (يتميز بالإهمال وعدم الاكتراث غير المبرر)\nمثال: آباء مهملون",
 "negligently": "إِهْمَالًا",
 "negligible": "تَافِه, ضَئِيل (صغير جداً لدرجة أنه بلا معنى؛ لا يُذكر) / زَهِيد, ضَئِيل (لَا يَسْتَحِقُّ الاِعْتِبَار)",
 "negotiable": "قَابِل لِلتَّحْوِيل, قَابِل لِلتَّدَاوُل (يمكن نقل ملكيته قانونياً إلى شخص آخر) / قَابِلٌ لِلتَّفَاوُض, مَطْرُوحٌ لِلنِّقَاش (يُمْكِنُ التَّفَاوُضُ بِشَأْنِهِ أَوْ تَسْوِيَتُهُ بِالتَّوَافُقِ) / قَابِلٌ لِلاجْتِيَاز (يُمْكِنُ المُرُورُ عَبْرَهُ أَوْ تَخَطِّيه)",
