 "adult tooth": "سن دائمة (أي من الأسنان الـ 32 التي تحل محل الأسنان اللبنية في مرحلة الطفولة المبكرة ويمكن أن تستمر حتى الشيخوخة)",
 "adult toy": "لعبة جنسية (جسم أو جهاز يستخدم بشكل أساسي لتسهيل المتعة الجنسية البشرية)",
 "adult-onset diabetes": "السكري غير المعتمد على الأنسولين, السكري من النوع الثاني (شكل خفيف من داء السكري يتطور تدريجيًا لدى البالغين؛ يمكن أن يحدث بسبب السمنة أو الإجهاد الشديد أو انقطاع الطمث أو عوامل أخرى؛ يمكن السيطرة عليه عادة…)",
 "adult-onset diabetes mellitus": "السكري غير المعتمد على الأنسولين, السكري من النوع الثاني (شكل خفيف من داء السكري يتطور تدريجيًا لدى البالغين؛ يمكن أن يحدث بسبب السمنة أو الإجهاد الشديد أو انقطاع الطمث أو عوامل أخرى؛ يمكن السيطرة عليه عادة…)",
 "adulterant": "شائب, مغشوش (يجعل الشيء غير نقي أو فاسد بإضافة مواد غريبة) / شائبة, مادة غاشة (أي مادة تقلل من نقاء أو فعالية مادة أخرى)\nمثال: التأثير الملوث للمواد الغريبة",
 "adulterate": "مَغْشُوش, مُزَيَّف (مخلوط بشوائب أو مواد دخيلة)",
 "adulterated": "مَغْشُوش, مُزَيَّف (مخلوط بشوائب أو مواد دخيلة)",
 "adulterating": "شائب, مغشوش (يجعل الشيء غير نقي أو فاسد بإضافة مواد غريبة)\nمثال: التأثير الملوث للمواد الغريبة",
 "adulteration": "تزوير, غش (عملية الغش (خاصة الاستبدال غير المشروع لمادة بأخرى)) / تزييف, غش (الخلط بمادة غريبة؛ ناتج الغش)",
 "adulterator": "غاش, مفسد (مغير يقلل من نقاء أو فعالية مادة ما) / شائبة, مادة غاشة (أي مادة تقلل من نقاء أو فعالية مادة أخرى)\nمثال: من الضروري إزالة الشوائب قبل الاستخدام",
 "adulterer": "زَانٍ (زان - يزين، زينا؛ زانه: حلاه، حسنه) / الزَّانِي / زَانِيَة (اسم فاعلة من زَنَى، المرأة التي تمارس الجنس مع غير زوجها أو بدون زواج)",
 "adulteress": "زَانِيَة (اسم فاعلة من زَنَى، المرأة التي تمارس الجنس مع غير زوجها أو بدون زواج)",
 "adulterine": "سِفَاحِيّ (ناتِج عَن عَلاقَة زِنا أَوْ عَلاقَة غَيْر شَرْعِيَّة)",
 "adulterous": "خَائِن لِلشَّرِيك, زَانٍ (غَيْر مُخْلِص لِلزَّوْج أَوِ الحَبِيب) / خَارِج نِطَاق الزَّوَاج, زَانٍ (يتسم بالزنا أو العلاقات خارج إطار الزواج)",
 "adulterously": "بخيانة, بزيغ (بطريقة تتسم بالزنا أو الخيانة الزوجية)\nمثال: تصرف بخيانة",
 "adulterousness": "خيانة زوجية, زنا (صفة ارتكاب الزنا أو الخيانة الزوجية)",
 "adultery": "خِيانة زَوْجِيَّة, زِنَا المُحْصَنَيْن / زِنىً, زِنَاء (مَارَسَ الزِّنَى)",
 "adulthood": "بلوغ, سن الرشد (حالة (ومسؤوليات) الشخص الذي بلغ النضج) / رشد, سن البلوغ (الفترة الزمنية في حياتك بعد توقف نموك الجسدي واكتمال تطورك)",
 "adulting": "التصرف كبالغ, تحمل المسؤولية (التصرف كشخص بالغ)",
 "adumbration": "تخطيط أولي, تمثيل مبهم (تمثيل تخطيطي أو غير كامل أو باهت) / إرهاص, تلميح مسبق (فعل تقديم مؤشرات غامضة مسبقة؛ التمثيل مسبقاً)",
 "adumbrative": "تَمْهِيدِيّ, مُنْبِئ بِشَكْل غَامِض (نبوئيّ بشكل غامض وغير واضح)",
 "adust": "مَحْرُوق مِن الشَّمْس, مُسْمَرّ (مُسمَرّ بفعل الشمس إلى لون بني) / مُحْتَرِق, يَابِس مِنَ الحَرّ (جفّ بفعل الحرارة أو التعرّض المفرط لأشعّة الشمس)",
 "advance": "يقرب",
 "advance death benefit": "مخصص الوفاة المقدم (نسبة مئوية من مخصصات الوفاة تُدفع مباشرة لحاملي وثائق التأمين الذين لديهم متوسط عمر متوقع قصير (عادة 6 أشهر))",
 "advance payment": "دَفْع مُسْبَق (لزّه ونحاه وأبعده؛ صرفه قبل وروده، أي منعه وأبعده قبل مجيئه أو حدوثه، وعكسه أن يرفعه، اي أن يصرفه بعد حدوثه)\nمثال: دفع زيري الثمن.",
 "advanced": "مُتَقَدِّم",
 "advanced research and development activity": "نشاط البحث والتطوير المتقدم (وكالة تابعة لمجتمع الاستخبارات تجري أبحاثًا وتطويرًا متقدمًا يتعلق بتكنولوجيا المعلومات)",
 "advancement": "تطور, تقدم (تحسن تدريجي أو نمو أو تطور) / تقدم, زحف (فعل التحرك للأمام (نحو هدف)) / ترويج, تعزيز (تشجيع تقدم أو نمو أو قبول شيء ما)\nمثال: تقدم المعرفة",
 "advancer": "متقدم (شخص يتقدم)",
 "advancing": "مُتَحَرِّك إِلَى الأَمَام, مُتَقَدِّم (يتحرّك إلى الأمام ويتقدّم)",
 "advantage": "أَفْضَلِيَّة, فَائِدَة",
 "advantageous": "مُفِيد, مُوَاتٍ (يمنح ميزة) / مُنَاسِب, مُوَاتٍ (ملائم لتحقيق غاية معينة؛ يُلَمِّح إلى قلة الاكتراث بالعدالة)\nمثال: عقد مفيد لبلدنا",
 "advantageously": "بشكل جيد, بشكل مفيد (بطريقة توفر فائدة أو ميزة)\nمثال: تزوجت زيجة جيدة (مفيدة)",
 "advantageousness": "إِيجَابِيَّة, مُوَاتَاة (صفة كون الشيء مشجعاً أو مبشراً بنتيجة ناجحة)",
 "advection": "نقل أفقي ((في الأرصاد الجوية) النقل الأفقي للحرارة أو غيرها من الخصائص الجوية)",
 "advective": "تأفقي, حملي أفقي (من أو متعلق بالتأفق (النقل الأفقي للكتلة أو الحرارة في الغلاف الجوي))",
 "advent": "بزوغ, قدوم (وصول كان منتظراً (خاصة لشيء مهم)) / مجيء (الموسم الذي يتضمن أيام الأحد الأربعة التي تسبق عيد الميلاد)\nمثال: قدوم الحاسوب",
 "advent sunday": "أحد المجيء (أول أحد من أيام الأحد الأربعة خلال فترة المجيء)",
 "adventism": "أدفنتست, مجيئية (أي دين مسيحي يعتقد أن المجيء الثاني للمسيح وشيك)",
 "adventist": "أدفنتي, مجيئي (عضو في طائفة مسيحية تتوقع المجيء الوشيك للمسيح)",
 "adventitia": "غلالة (غشاء أو طبقة مغلفة من نسيج الجسم)",
 "adventitial": "براني, طبقي خارجي (من أو متعلق بالطبقة الخارجية للأوعية الدموية أو الأعضاء)",
 "adventitious": "عَرْضِيّ",
 "adventitious root": "جذر عرضي (جذر ينمو في موقع غير عادي مثل من الساق)",
 "adventive": "دَخِيلٌ غَيْرُ مُسْتَقِرّ, وَافِد (غَيْرُ أَصْلِيٍّ وَلَمْ يَسْتَقِرَّ بَعْدُ؛ مُتَأَقْلِمٌ مَحَلِّيًّا أَوْ مُؤَقَّتًا)",
 "adventure": "مُخَاطَرَة, مُغَامَرَة / مُغَامَرَة / مُجَازَفَة, مُغَامَرَة / مُجَازَفَة",
 "adventure story": "حكاية بطولية, قصة مغامرة (قصة تدور حول مغامرة)",
 "adventurer": "مُغَامِر, مُغَامِرَة",
 "adventuresome": "مُغَامِر, مِقْدَام (مستعد للقيام بمشاريع جديدة وجريئة أو السعي وراءها)\nمثال: رواد مغامرون",
 "adventuress": "مغامرة (امرأة تحب المغامرة)",
 "adventurism": "مغامرة سياسية (التهور في السياسة أو الشؤون الخارجية)",
 "adventuristic": "تهوري, مغامر (من أو متعلق بالمغامرة (بالمعنى السلوكي أو السياسي))",
 "adventurous": "مُغَامِر",
 "adventurousness": "حب المغامرة, روح المغامرة (سمة الميل للمغامرة)",
 "adverb": "ظَرْف (ظَرْف: اسم؛ ظَرْف الشيء وعاءه. الجمع ظُرُوف؛ ظَرْف: اسم؛ كيس من الورق توضع فيه الرسائل وغيرها. \"وضعت الرسالة في الظرف\")\nمثال: أغلقت ذلك الظرف.",
 "adverb of manner": "ظرف حال (ظرف يصف كيفية تنفيذ الفعل)\nمثال: ظروف الحال (مثل 'بيأس') يمكن أن تُعدِّل الأفعال مباشرة",
 "adverbial": "ظَرْف (ظَرْف: اسم؛ ظَرْف الشيء وعاءه. الجمع ظُرُوف؛ ظَرْف: اسم؛ كيس من الورق توضع فيه الرسائل وغيرها. \"وضعت الرسالة في الظرف\")\nمثال: أغلقت ذلك الظرف.",
 "adverbial of cause": "ظرف سببي, مفعول لأجله (عبارة ظرفية تشير إلى سبب القيام بالفعل المحدد)",
 "adverbial of condition": "ظرف شرطي (عبارة ظرفية تتحدث عن حالة محتملة أو مخالفة للواقع وعواقبها)\nمثال: في جملة 'سيدوم الأثاث القديم للأبد إذا قمت بتلميعه بانتظام'، العبارة التي تبدأ بـ 'إذا' هي ظرف شرطي",
 "adverbial of reason": "ظرف سببي, مفعول لأجله (عبارة ظرفية تشير إلى سبب القيام بالفعل المحدد)",
 "adverbially": "ظَرْفِيًّا, كَظَرْف\nمثال: عبارة الجر هنا تستخدم كظرف",
 "adversarial": "عدائي",
 "adversariness": "خُصُومَة",
 "adversary": "خَصْم, مُقَاوِم (الخَصْمُ :مُجَادِل، مُنَازِع، مُخَاصِم، عكسه حَلِيف أو صَدِيْق، وقد يستوي فيه المفرد والمثنى والجمع؛ والخَصْمُ (في ) : حَطِيطَة)",
 "adversative": "اسْتِدْرَاكِيّ, مُقَابِل (يُعَبِّرُ عَنِ التَّضَادِّ أَوِ المُعَارَضَةِ)",
 "adversative conjunction": "رَبْط اسْتِدْرَاكِيّ, عَطْف مُخَالِف (علاقة الربط بين الوحدات التي تعبر عن تعارض معانيها (مثل: لكن))",
 "adverse": "مُضَادّ, مُعَاكِس (فِي اتِّجَاه مُعَاكِس (عَنِ الرِّيَاح أَوِ التَّيَّارَات)) / سَيِّئ الطَّالِع, مُعَاكِس (مُنَافٍ لِمَصَالِحك أَوْ رَفَاهِيَتِك)",
 "adverse opinion": "رَأْي سَلْبِيّ, رَأْي مُعَارِض (رأي يتعلق بالبيانات المالية (عادة بناءً على تدقيق من قبل محاسب قانوني معتمد) بأن البيانات ككل لا تعرض النتائج بإنصاف أو لا تتوافق مع ممارسات المحاسبة…)",
 "adverse selection": "اختيار عكسي, انتقاء سلبي (حالة يمتلك فيها البائعون معلومات لا يمتلكها المشترون (أو العكس) حول جانب من جوانب جودة المنتج)",
 "adverse witness": "شاهد معاد (شاهد تكون علاقته بالطرف الخصم بحيث قد تكون شهادته متحيزة ضد الطرف الخصم)\nمثال: الشاهد المعادي يمكن توجيه أسئلة استدراجية له واستجوابه",
 "adversely": "بِشَكْل ضَارّ, سَلْبًا (بطريقة سلبية)\nمثال: تأثرت سلباً باللوائح الجديدة",
 "adversity": "بُؤْس, ضَنْك (الفُقْر والشِدَّة وضِيق الحال)\nمثال: عانى الكثيرون الظلم والبؤس ردحا من الزمن تحت حكم الإستعمار.",
 "advert": "إِعْلَان, دِعَايَة (ترويج عام لمنتج أو خدمة ما)",
 "advertence": "انتباه, تيقظ (عملية التزام الحيطة والانتباه)",
 "advertency": "انتباه, تيقظ (عملية التزام الحيطة والانتباه)",
 "advertent": "حَرِيص, مُنْتَبِه (يُولي انتباهًا واهتمامًا)",
 "advertently": "بانتباه, بحرص (بطريقة متعمدة وحذرة)",
 "advertised": "مُعْلَن عَنْهُ (لُفت انتباه الجمهور إليه)",
 "advertisement": "إِيذَان, إِعْلَان",
 "advertiser": "معلن (شخص عمله هو الإعلان)",
 "advertising": "إِعْلَان, إِشْهَار",
 "advertising agency": "وكالة إعلانات, وكالة دعاية وإعلان (وكالة تصمم إعلانات لجذب انتباه الجمهور لعملائها)",
 "advertising campaign": "حملة إعلانية (برنامج منظم للإعلانات)",
 "advertising department": "إدارة الدعاية والإعلان, قسم الإعلانات (قسم في مؤسسة تجارية مسؤول عن الإعلانات)",
 "advertising division": "إدارة الدعاية والإعلان, قسم الإعلانات (قسم في مؤسسة تجارية مسؤول عن الإعلانات)",
 "advertizement": "إِعْلَان, دِعَايَة (ترويج عام لمنتج أو خدمة ما)",
 "advertizer": "معلن (شخص عمله هو الإعلان)",
 "advertizing": "إِعْلَان, دِعَايَة (ترويج عام لمنتج أو خدمة ما)",
 "advertorial": "إِعْلَان تَحْرِيرِيّ, مَقَال إِعْلَانِيّ (إعلان مكتوب ومقدم بأسلوب تقرير تحريري أو صحفي)",
 "advice": "نَصِيحَة, مَشُورَة",
 "advice and consent": "مشورة وموافقة (تعبير قانوني في دستور الولايات المتحدة يسمح لمجلس الشيوخ بتقييد سلطات الرئيس في التعيين وعقد المعاهدات)",
 "advil": "أدفيل, إيبوبروفين (دواء مضاد للالتهاب ومسكن غير ستيرويدي (الأسماء التجارية أدفيل وموترين وغيرها) يستخدم لتخفيف آلام التهاب المفاصل وكخافض للحرارة)\nمثال: الاستخدام اليومي للإيبوبروفين يمكن أن يهيج المعدة",
 "advisability": "اسْتِحْسَان, سَدَاد (صفة كون الشيء منصوحاً به)\nمثال: شككوا في سداد سياستنا",
 "advisable": "مَنْصُوح بِه, مُسْتَحْسَن (جدير بالتوصية أو الاقتراح؛ حكيم أو عاقل)\nمثال: هذا الإجراء ليس ضرورياً ولا مستحسناً",
 "advise": "نَصَحَ (نصحه: أَرْشَدَه وأَشَارَ عليه) / بَلَّغَ, أَبْلَغَ\nمثال: نصح مناد بباية.",
 "advised": "حَكِيم, سَدِيد (يحظى بميزة التفكير المسبق المتأني أو المشورة) / عَلَى عِلْم, مُبَلَّغ (تلقى معلومات أو إخطارًا)\nمثال: تأخير مدروس في تنفيذ الخطة",
 "advisedly": "بتعمد, عمداً (بنية؛ بطريقة متعمدة)\nمثال: استخدم تلك الكلمة عمداً",
 "advisee": "طَالِب الْمَشُورَة, مُتَلَقِّي النَّصِيحَة (شخص يتلقى النصيحة)",
 "advisement": "تداول, روية (تفكير متأنٍ وحذر)\nمثال: القليل من الروية كان سيردعهم",
 "adviser": "مستشار, ناصح (خبير يقدم المشورة)\nمثال: ساعد مستشار الطلاب في اختيار دوراتهم",
 "advisor": "مُسْتَشَار, مُسْتَشَارَة (المُسْتشار : مَنْ تطلب مشورته || رتبة في القضاء : « مُسْتشار في محكمة الاستئناف »)",
 "advisory": "اسْتِشَارِيّ, نَاصِح (يقدم النصح والمشورة) / تحذير, نشرة تحذيرية (إعلان ينصح عادة أو يحذر الجمهور من تهديد ما)\nمثال: تحذير من الصقيع",
