 "ad valorem tax": "ضريبة قيمية (ضريبة تفرض على الفرق بين سعر السلعة قبل الضرائب وتكلفة إنتاجها)",
 "ad-lib": "اِرْتِجَالِيّ, عَفْوِيّ (بقليل من الإعداد أو التفكير المسبق أو بدونهما) / تِلْقَائِيّ, مُرْتَجَل (يُقال أو يُفعل دون تخطيط أو كتابة مسبقة) / ارتجال (ملاحظة يتم الإدلاء بها بشكل عفوي دون تحضير مسبق)\nمثال: تسببت ارتجالاته في مشاكل مع السياسيين",
 "ada": "أدينوسين ديميناز (إنزيم يوجد في الثدييات يمكنه تحفيز نزع الأمين من الأدينوزين وتحويله إلى إينوزين وأمونيا)\nمثال: يمكن أن يؤدي نقص نازعة أمين الأدينوزين إلى شكل من أشكال مرض نقص المناعة المشترك الشديد",
 "adactylia": "انعدام الأصابع (غياب خلقي لأصابع اليدين و / أو القدمين) (يفيد الشك؛ يفيد التقسيم)\nمثال: أكون أو لا أكون؟",
 "adactylism": "انعدام الأصابع (غياب خلقي لأصابع اليدين و / أو القدمين) (يفيد الشك؛ يفيد التقسيم)\nمثال: أكون أو لا أكون؟",
 "adactylous": "أبتع, عديم الأصابع (بلا أصابع يد أو قدم)",
 "adactyly": "انعدام الأصابع (غياب خلقي لأصابع اليدين و / أو القدمين) (يفيد الشك؛ يفيد التقسيم)\nمثال: أكون أو لا أكون؟",
 "adage": "حكمة, مثل (قول مكثف ولكنه لا ينسى يجسد حقيقة مهمة من التجربة يعتبرها الكثير من الناس صحيحة)",
 "adagio": "بِبُطْء / أداجيو (جزء بطيء من رقصة ثنائية (با دو دو) يتطلب مهارة وقوة كبيرة من الراقصين) / أَدَاجْيُو ((في الإيقاع الموسيقيّ) مُتَمَهِّل وَهَادِئ) / أداجيو, حركة بطيئة ((موسيقى) تكوين يُعزف بإيقاع أداجيو (ببطء ورشاقة))\nمثال: هنا يجب أن تعزف ببطء",
 "adalia bipunctata": "دعسوقة ذات نقطتين (دعسوقة حمراء مع بقعة سوداء على كل جناح)",
 "adam": "آدَم (أول إنسان خُلِق وفقًا للأديان الإبراهيمية، وأيضًا أول نبي في الإسلام، وفي بعض الطوائف المسيحية؛ إنسان، شخص، رجل)\nمثال: كل ابن آدم خطاء",
 "adam and eve": "آدَم وَحَوَّاء (أول إنسان خُلِق وفقًا للأديان الإبراهيمية، وأيضًا أول نبي في الإسلام، وفي بعض الطوائف المسيحية؛ إنسان، شخص، رجل)\nمثال: كل ابن آدم خطاء",
 "adam's apple": "تُفَّاحَة آدَم, حَرْقَدَة",
 "adam's needle": "إبرة آدم, يوكا خيطية (يوكا بأوراق صلبة طويلة لها زوائد تشبه الخيوط)",
 "adam's needle-and-thread": "إبرة آدم, يوكا خيطية (يوكا بأوراق صلبة طويلة لها زوائد تشبه الخيوط)",
 "adam-and-eve": "آدم وحواء, جذر المعجون (أوركيد أمريكي شمالي يحمل ورقة واحدة وزهوراً بنية مصفرة)",
 "adamance": "تعنت, صلابة (الحزم بحكم كونه غير مرن ولا يلين)",
 "adamant": "عَنِيد, لَا يَلِين (لَا يَتَأَثَّرُ بِالتَّوَسُّلَاتِ أَوِ الإِقْنَاعِ أَوِ المُنَاشَدَاتِ أَوِ المَنْطِقِ) / ألماس (كربون بلوري طبيعي صلب جداً يُثمن كحجر كريم)",
 "adamantine": "عَنِيد, لَا يَلِين (لَا يَتَأَثَّرُ بِالتَّوَسُّلَاتِ أَوِ الإِقْنَاعِ أَوِ المُنَاشَدَاتِ أَوِ المَنْطِقِ) / أَلْمَاسِيّ, شَديد الصَّلابَة (بِصَلابَة الأَلْماس) / صلد, ماسي (يتكون من أو له صلابة الماس أو مادة شديدة الصلابة)",
 "adamantly": "بعناد",
 "adamic": "اللُّغَة الْآدُمْيَة, لُغَة آدَم",
 "adams-stokes syndrome": "إحصار القلب, حصار أذيني بطيني (نوبات مفاجئة متكررة من فقدان الوعي ناجمة عن ضعف توصيل الإشارة التي تنظم ضربات القلب)",
 "adana": "أَضَنَة, أَذَنَة",
 "adansonia digitata": "باوباب, تبلدي (شجرة أفريقية لها جذع سميك للغاية وثمرة تشبه القرع ولها لب صالح للأكل يسمى خبز القرود)",
 "adansonia gregorii": "أدانسونية غريغورية, شجرة كريم الترتار (شجرة أسترالية لها ثمرة حمضية مقبولة تشبه القرع)",
 "adapin": "أدابين, دوكسيبين (مضاد اكتئاب ثلاثي الحلقات (الأسماء التجارية أدابين وسينيكوان) له آثار جانبية عديدة (جفاف الفم وتهدئة واضطرابات هضمية))",
 "adapt": "يتكيف مع",
 "adaptability": "تكيف, قابلية للتكيف (القدرة على التغيير (أو التغيّر) لتناسب الظروف المتغيرة)",
 "adaptable": "قابل للتكيف, متكيف (قادر على التكيف (أو أن يصبح مناسباً) لموقف أو استخدام معين)\nمثال: للنجاح يجب على المرء أن يكون قابلاً للتكيف",
 "adaptation": "تأقلم, تكيف ((فسيولوجيا) التعديل المستجيب لعضو حسي (كالعين) لظروف متغيرة (كالضوء)) / اقتباس, نسخة معدلة (عمل مكتوب (كرواية) تمت إعادة صياغته في شكل جديد) / تأقلم, تعديل (عملية التكيف مع شيء ما (مثل الظروف البيئية))\nمثال: المسرحية هي اقتباس لرواية قصيرة",
 "adaptational": "تَكَيُّفِيّ (يتعلّق بالتكيّف أو ينتمي إليه)",
 "adaptative": "تَكَيُّفِيّ (لديه القدرة على التكيف)\nمثال: التلوين التكيفي للحرباء",
 "adapted": "مُعَدَّل, مُكَيَّف (تَمَّ تَغْيِيرُهُ لِلتَّحْسِينِ أَوْ لِيُنَاسِبَ غَرَضًا مُعَيَّنًا)",
 "adapter": "مُوَائِم",
 "adaption": "تأقلم, تعديل (عملية التكيف مع شيء ما (مثل الظروف البيئية))",
 "adaptive": "تَكَيُّفِيّ (لديه القدرة على التكيف)\nمثال: التلوين التكيفي للحرباء",
 "adaptive radiation": "تشعب تكيفي (تطور أشكال مختلفة عديدة من مجموعة كائنات متجانسة أصلاً أثناء ملئها لمنافذ بيئية مختلفة)",
 "adaptor": "محوّل, مهايئ (جهاز يتيح استخدام شيء ما بطريقة مختلفة عن تلك التي صُمم من أجلها أو يجعل قطعاً مختلفة من الأجهزة متوافقة)",
 "adar": "أذار (الشهر السادس من السنة المدنية؛ الشهر الثاني عشر من السنة الدينية في التقويم اليهودي (في فبراير ومارس))",
 "adar sheni": "أذار الثاني (يدرج سبع مرات كل 19 سنة)",
 "adaxial": "بَطْنِيّ, مُتَّجِه نَحْو المِحْوَر (الأقرب إلى أو المتجه نحو محور عضو أو كائن حي)\nمثال: يُعرف الجانب العلوي للورقة بالسطح البطني",
 "adaxially": "بطنياً, نحو المحور (في الجانب المواجه للمحور)",
 "add": "جَمَعَ (ضَمَّ، لَمَّ، حَشَدَ؛ في : أَضَافَ أعدادا إلى غيرها) / أَضَافَ\nمثال: جمع خيل هو خيول.",
 "add fuel to the fire": "صَبَّ اَلزَّيْت عَلَى اَلنَّار, زَادَ اَلنَّار حَطَباً (سَكَبَ، الفرق بين صَبَّ وسَكَب أن الصَبّ يكون متعمدا والسكب قد يكون متعمدا أو خطأ؛ صَبَّ الطعام، أي سكبه في الإناء أو الصحون)\nمثال: صب الشاي لضيفك.",
 "add insult to injury": "زَادَ الطِّينَ بِلَّةً (زَادَ يَزِيدُ زَيْدًا، وزِيادَةً: نما وكَثُرَ؛ زَادَ الشيءَ: جعله يزيد)\nمثال: زاد السياح عددا.",
 "add-in": "بطاقة الدائرة, لوحة الدائرة (دائرة مطبوعة يمكن إدخالها في فتحات التوسعة في الكمبيوتر لزيادة قدراته)",
 "add-on": "إكسسوار, تكملة (مكون إضافي يحسن القدرة أو الأداء) / إضافة, تحسين (مكون يضاف إلى شيء لتحسينه) / إضافة برمجية, مكون إضافي (وحدة برمجية تعمل على توسيع أو تعزيز قدرات تطبيق موجود)\nمثال: كانت إضافة الحمام تحسيناً كبيراً",
 "addable": "قَابِل لِلإِضَافَة (يُمكِن إضافته أو أن يُضاف إليه)",
 "addax": "أداكس, مها (ظبي كبير ذو قرون لولبية خفيفة يعيش في المناطق الصحراوية بشمال أفريقيا)",
 "addax nasomaculatus": "أداكس, مها (ظبي كبير ذو قرون لولبية خفيفة يعيش في المناطق الصحراوية بشمال أفريقيا)",
 "addend": "مُضَاف (عدد يضاف إلى عدد آخر)",
 "addendum": "إضافة, ملحق (مادة نصية تضاف إلى منشور؛ عادة في النهاية)",
 "adder": "أفعى شائعة (أفعى أرضية صغيرة شائعة في شمال أوراسيا) / جامع (آلة تجمع الأرقام) / جامع الأعداد (شخص يقوم بجمع الأرقام)",
 "adder's fern": "بوليبودي شائع, سرخس الجدار (سرخس صخري أو أرضي يشكل حصيرة بجذامير زاحفة وسعف ريشي كبير يوجد في جميع أنحاء أمريكا الشمالية وأوروبا وأفريقيا وشرق آسيا)",
 "adder's tongue": "سرخس لسان الأفعى (سراخس بسنابل خصبة تشبه لسان الأفعى)",
 "adder's tongue fern": "سرخس لسان الأفعى (سراخس بسنابل خصبة تشبه لسان الأفعى)",
 "addible": "قَابِل لِلإِضَافَة (يُمكِن إضافته أو أن يُضاف إليه)",
 "addict": "مُدْمِن, مُدْمِنَة",
 "addicted": "مُدْمِن (معتمد بشكل قهري أو فسيولوجي على شيء يسبب التعود)\nمثال: هي مدمنة على الشوكولاتة",
 "addiction": "إِدْمَان",
 "addiction studies": "دراسات الإدمان (استكشاف رسمي للإدمان من مجموعة متنوعة من وجهات النظر الأكاديمية والعلمية: الاجتماعية، والثقافية، والنفسية، والأنثروبولوجية، والتحليل النفسي)",
 "addictive": "إِدْمَانِيّ",
 "adding machine": "آلة جمع (آلة حاسبة تؤدي وظائف حسابية بسيطة)",
 "addis ababa": "أَدِيس أَبَابَا",
 "addison's disease": "مَرَض أَدِيسُون (أصابه مرضٌ أو علّة أو سَقَم)\nمثال: هذا المرض قلبي.",
 "addison's syndrome": "قصور الكظر, مرض أديسون (اضطراب غدي ناتج عن فشل وظيفة قشرة الغدة الكظرية ويتميز بفقر الدم والإنهاك مع جلد بني اللون)",
 "addition": "إضَافَة / مُضَاف / جَمْع (ضَمَّ، لَمَّ، حَشَدَ؛ في : أَضَافَ أعدادا إلى غيرها)\nمثال: جمع خيل هو خيول.",
 "addition reaction": "تفاعل إضافة (تفاعل كيميائي يضاف فيه جزيء إلى آخر)",
 "additional": "إِضَافِيّ (إِضافيّ : ما يُضاف ، ما يُزاد؛ ما يُتْبَع شيئاً آخر ، ما يُلْحَق به ، ما يُزاد على الأصل)\nمثال: ستعطيني بطانية إضافية.",
 "additionally": "بالإضافة إلى ذلك, علاوة على ذلك (بالإضافة؛ علاوة على ذلك)\nمثال: يعمل بالإضافة إلى ذلك كمدير تنفيذي",
 "additive": "إِضَافِيّ, تَرَاكُمِيّ (يتميز أو ينتج عن طريق الإضافة) / خطي (يصف أو يتضمن معادلة تكون حدودها من الدرجة الأولى) / مادة مضافة (شيء يضاف لتعزيز الطعام أو البنزين أو الطلاء أو الدواء)\nمثال: عملية إضافية",
 "additive inverse": "نَظِير جَمْعِيّ ((الرياضيات) أحد زوجين من الأعداد مجموعهما صفر؛ النظير الجمعي لـ -5 هو +5)",
 "addle-head": "أبله, عقل العصفور (شخص ذو أفكار مشوشة؛ غير قادر على التفكير الجاد)",
 "addlebrained": "أَبْلَه, مُخَبَّل (غبيّ ومشوّش الذهن)",
 "addled": "مُخْتَلِط, مُشَوَّش الذِّهْن (مرتبك وغامض التفكير؛ يُقال خاصّة عن طريقة التفكير) / تَالِف, فَاسِد ((عَنِ البَيْض) لَمْ يَعُدْ صَالِحًا لِلْأَكْل)",
 "addlehead": "أبله, عقل العصفور (شخص ذو أفكار مشوشة؛ غير قادر على التفكير الجاد)",
 "addlepated": "أَبْلَه, مُخَبَّل (غبيّ ومشوّش الذهن)",
 "address": "خُطْبَة, نِدَاء / عُنْوَان, عِنْوَان (عُنْوَان) / عَنْوَنَ\nمثال: نسيت عنوان توم.",
 "addressable": "قَابِل لِلعَنْوَنَة (يمكن الوصول إليه عبر عنوان محدد)",
 "addressed": "مُعَنْوَن ((للبريد) موسوم بوجهة)\nمثال: أرمي كل البريد المعنون بـ 'ساكن'",
 "addressee": "مُسْتَلِم, مُسْتَلِمَة",
 "addressing machine": "آلة عنونة (طابعة تطبع العناوين تلقائياً على الرسائل البريدية)",
 "addressograph": "آلة عنونة (طابعة تطبع العناوين تلقائياً على الرسائل البريدية)",
 "adducent": "مُقَرِّب ((خاصة للعضلات) يجمع أو يسحب نحو خط الوسط للجسم أو نحو جزء مجاور)",
 "adducer": "مُسْتَشْهِد, مُورِد (لِلأَدِلَّة) (مناقش يقدم مثالاً أو سبباً أو دليلاً)",
 "adducing": "إيراد الدليل, الاستشهاد (الاقتباس كدليل أو برهان)",
 "adduct": "مركب إضافة, ناتج إضافة (مركب يتكون عن طريق تفاعل الإضافة)",
 "adducting": "مُقَرِّب ((خاصة للعضلات) يجمع أو يسحب نحو خط الوسط للجسم أو نحو جزء مجاور)",
 "adduction": "تقريب ((فسيولوجيا) تحريك جزء من الجسم نحو المحور المركزي للجسم)",
 "adductive": "مُقَرِّب ((خاصة للعضلات) يجمع أو يسحب نحو خط الوسط للجسم أو نحو جزء مجاور)",
 "adductor": "عضلة مقربة (عضلة تسحب جزءاً من الجسم باتجاه الخط الناصف)",
 "adductor muscle": "عضلة مقربة (عضلة تسحب جزءاً من الجسم باتجاه الخط الناصف)",
 "ade": "شراب الفاكهة (مشروب محلى من عصير الفاكهة المخفف)",
 "adelaide": "آديلايد / أديلايد, أديليد",
 "adelges abietis": "من عفص التنوب (نوع من الأرقة يعد آفة لتنوب النرويج وأنواع مختلفة من تنوب أمريكا الشمالية، وخاصة التنوب الأبيض والتنوب الأسود)",
 "adelges piceae": "أرقة التنوب, من الصوف البلسمي (نوع من الأرقة، وهي حشرات صغيرة عديمة الأجنحة تغزو وتقتل أشجار التنوب، وخاصة التنوب البلسمي وتنوب فريزر)",
 "adelgid": "أديلجيد (أي من الحشرات المتنوعة التي تتغذى وتشكل العفص على الصنوبريات)",
 "adelie": "بطريق آديلي (بطاريق متوسطة الحجم توجد في مستعمرات كبيرة على ساحل آديلي في القارة القطبية الجنوبية)",
 "adelie penguin": "بطريق آديلي (بطاريق متوسطة الحجم توجد في مستعمرات كبيرة على ساحل آديلي في القارة القطبية الجنوبية)",
 "aden": "عَدَن (الإقَامَة والتَوَطُّن بالمكان؛ جَنَّاتُ عَدْن: المكان الذي وعد الله المؤمنين، الجَنَّة)\nمثال: عدن إلى المصرف.",
 "adenanthera pavonina": "خشب المرجان, صندل أحمر (شجرة من شرق الهند ذات عناقيد من الزهور الصفراء البيضاء؛ تزرع للزينة)",
 "adenine": "أدينين",
 "adenitis": "التهاب الغدد (التهاب غدة أو عقدة ليمفاوية)",
 "adenium multiflorum": "أدينيوم, زنبق إمبالا (شجيرة من جنوب أفريقيا ذات ساق عصارية منتفخة وتحمل أزهاراً وردية وبيضاء مبهرجة بعد سقوط الأوراق؛ شائعة كنبات زينة في المناطق الاستوائية)",
 "adenium obesum": "أدينيوم, زنبق إمبالا (شجيرة من جنوب أفريقيا ذات ساق عصارية منتفخة وتحمل أزهاراً وردية وبيضاء مبهرجة بعد سقوط الأوراق؛ شائعة كنبات زينة في المناطق الاستوائية)",
 "adenocarcinoma": "سرطانة غدية (ورم خبيث ينشأ في الظهارة الغدية)",
 "adenocarcinomatous": "غدي سرطاني (من أو متعلق بالسرطان الغدي)",
 "adenohypophysis": "غدة نخامية أمامية, نخامية أمامية (الفص الأمامي للغدة النخامية؛ ذو طبيعة غدية في المقام الأول)",
 "adenoid": "شبه غدي, غداني (يتعلق بـ أو يشبه الغدد الليمفاوية أو الأنسجة اللمفاوية) / لحمية, لوزة بلعومية (تجمع من الأنسجة اللمفاوية في الحلق خلف اللهاة (على الجدار الخلفي وسقف البلعوم الأنفي))\nمثال: تضخم اللوزتين البلعوميتين يسمى اللحمية",
 "adenoidal": "أَنْفِيّ, خَيْشُومِيّ (يبدو كأنَّ الأنف مقروص؛ صوت غُنَّة) / لحمياتي (من أو متعلق باللحميات (الناميات الغدانية))",
 "adenoidectomy": "استئصال اللحمية (إزالة جراحية للحمية (الزائدة الأنفية)؛ تجرى عادة جنباً إلى جنب مع استئصال اللوزتين)",
 "adenoma": "ورم غدي (ورم ظهاري حميد من أصل غدي)",
 "adenomatous polyp": "سليلة ورمية غدية (سليلة تتكون من نسيج ورمي حميد مشتق من ظهارة غدية)",
 "adenomegaly": "تضخم الغدد (تضخم الغدة)",
 "adenomyosarcoma": "ورم كلوي جنيني, ورم ويلمز (ورم كلوي خبيث يصيب الأطفال الصغار ويتميز بارتفاع ضغط الدم ووجود دم في البول ووجود كتلة محسوسة)",
 "adenomyosis": "انتباذ بطاني رحمي, بطانة الرحم المهاجرة (وجود بطانة الرحم في مكان آخر غير بطانة الرحم؛ يسبب ألم ما قبل الحيض وعسر الطمث)",
 "adenopathy": "اعتلال غدي, تضخم الغدد (مرض غدي أو تضخم في الأنسجة الغدية (خاصة الغدد الليمفاوية))",
 "adenosine": "أدينوسين ((كيمياء حيوية) نيوكليوسيد يعد مكوناً هيكلياً للأحماض النووية)",
 "adenosine deaminase": "أدينوسين ديميناز (إنزيم يوجد في الثدييات يمكنه تحفيز نزع الأمين من الأدينوزين وتحويله إلى إينوزين وأمونيا)\nمثال: يمكن أن يؤدي نقص نازعة أمين الأدينوزين إلى شكل من أشكال مرض نقص المناعة المشترك الشديد",
 "adenosine diphosphate": "أدينوسين ثنائي الفوسفات",
 "adenosine monophosphate": "أدينوسين أحادي الفوسفات",
 "adenosine triphosphate": "أدينوسين ثلاثي الفوسفات (نيوكليوتيد مشتق من الأدينوسين يوجد في الأنسجة العضلية؛ المصدر الرئيسي للطاقة للتفاعلات الخلوية)",
 "adenosis": "اضطراب غدي, مرض غدي (اضطراب في غدد الجسم)",
 "adenota vardoni": "بوكو (ظبي أفريقي وثيق الصلة بظبي الماء)",
 "adenovirus": "أدينوفيروس, فيروس غدي (أي من مجموعة فيروسات تسبب التهابات الجهاز التنفسي العلوي أو التهاب الملتحمة المعدي لدى البشر)",
 "adenylic acid": "أدينوسين أحادي الفوسفات",
 "adept": "بَارِع, حَاذِق (يمتلك معرفة ومهارة وكفاءة ويُظهرها) / بارع, جهبذ (شخص يتمتع بمهارة مذهلة في أي مجال)",
