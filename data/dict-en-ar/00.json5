 "alkalescent": "قَلَوِيّ قَلِيلًا (يميل إلى القلويّة؛ قلويّ بدرجة طفيفة)",
 "alkali": "قَلَوِيّ",
 "alkali bee": "نحلة القلويات (نحلة منعزلة شائعة مهمة لتلقيح البرسيم في غرب الولايات المتحدة)",
 "alkali grass": "زيجادينوس, عشب القلي (نبات من غرب أمريكا الشمالية له أوراق تشبه العشب وزهور بيضاء مخضرة)",
 "alkali metal": "فلز قلوي (أي من الفلزات أحادية التكافؤ من المجموعة الأولى في الجدول الدوري (الليثيوم أو الصوديوم أو البوتاسيوم أو الروبيديوم أو السيزيوم أو الفرانسيوم))\nمثال: هيدروكسيدات الفلزات القلوية قلوية بقوة",
 "alkali poisoning": "تسمم قلوي (تسمم ناتج عن تناول مركب قلوي (مثل الغسول القلوي أو الأمونيا))",
 "alkalic": "قَاعِدِيّ, قَلَوِيّ (يتعلق بـ أو يحتوي على مادة قلوية؛ له أس هيدروجيني أكبر من 7)\nمثال: تربة قلوية مشتقة من الطباشير أو الحجر الجيري",
 "alkalimetry": "قياس القلوية (التحليل الحجمي باستخدام محاليل قياسية من القلويات لقياس كمية الحمض الموجود)",
 "alkaline": "قِلْوِيّ / قَاعِدَة",
 "alkaline earth": "فلز قلوي ترابي (أي من الفلزات ثنائية التكافؤ من المجموعة الثانية في الجدول الدوري (الكالسيوم أو السترونتيوم أو الباريوم أو المغنيسيوم أو البيريليوم))",
 "alkaline metal": "فلز قلوي (أي من الفلزات أحادية التكافؤ من المجموعة الأولى في الجدول الدوري (الليثيوم أو الصوديوم أو البوتاسيوم أو الروبيديوم أو السيزيوم أو الفرانسيوم))\nمثال: هيدروكسيدات الفلزات القلوية قلوية بقوة",
 "alkaline-earth metal": "فلز قلوي ترابي (أي من الفلزات ثنائية التكافؤ من المجموعة الثانية في الجدول الدوري (الكالسيوم أو السترونتيوم أو الباريوم أو المغنيسيوم أو البيريليوم))",
 "alkaline-loving": "مُحِبّ لِلْقَلَوِيَّة (ينمو بقوة في بيئة قلوية نسبياً؛ (خاصة النباتات التي تتطلب درجة حموضة أعلى من 7))",
 "alkalinity": "قلوية (قيم الرقم الهيدروجيني أعلى من 7)",
 "alkalinuria": "بيلة قلوية (حالة يكون فيها البول (الذي يكون عادة حمضياً قليلاً) قلوياً)",
 "alkaliser": "عامل قلوي, مضاد للحموضة (عامل يقاوم أو يعادل الحموضة (خاصة في المعدة))",
 "alkalizer": "عامل قلوي, مضاد للحموضة (عامل يقاوم أو يعادل الحموضة (خاصة في المعدة))",
 "alkaloid": "قَلْوَانِيّ",
 "alkaloidal": "قلواني (متعلق بـ أو يتكون من القلوانيات)",
 "alkalosis": "قلاء, قلوية الدم (قلوية عالية بشكل غير طبيعي (انخفاض تركيز أيون الهيدروجين) في الدم وأنسجة الجسم الأخرى)",
 "alkalotic": "قلائي, قلوي الدم (يتميز بالقلاء (زيادة القلوية في سوائل الجسم))",
 "alkaluria": "بيلة قلوية (حالة يكون فيها البول (الذي يكون عادة حمضياً قليلاً) قلوياً)",
 "alkane": "ألكان, برافين",
 "alkane series": "ألكان, برافين",
 "alkanet": "كحلاء مخزنية, لسان الثور (عشب معمر أو ثنائي الحول يزرع لزهوره الرقيقة الزرقاء عادة)",
 "alkapton": "ألكابتون, حمض الهوموجنتيسيك (حمض يتكون كمنتج وسيط في عملية التمثيل الغذائي للتيروزين والفينيل ألانين)",
 "alkaptonuria": "بيلة الكابتونية (شذوذ استقلابي متنحي نادر يتميز بالتمغر ووجود الكابتون في البول)",
 "alkene": "ألكين, أوليفين (أي هيدروكربون أليفاتي غير مشبع)",
 "alkeran": "ألكيران, ملفالان (دواء مضاد للأورام (الاسم التجاري ألكيران) يستخدم لعلاج المايلوما المتعددة وبعض الأورام الخبيثة الأخرى)",
 "alky": "كحولي, مدمن كحول (شخص يشرب الكحول بإفراط وبشكل اعتيادي)",
 "alkyd": "ألكيد, راتنج الألكيد (راتنج صناعي متين يُستخدم على نطاق واسع في المواد اللاصقة والدهانات)",
 "alkyd resin": "ألكيد, راتنج الألكيد (راتنج صناعي متين يُستخدم على نطاق واسع في المواد اللاصقة والدهانات)",
 "alkyl": "ألكيل, شق ألكيل",
 "alkyl group": "ألكيل, شق ألكيل",
 "alkyl halide": "هالو ألكان, هاليد الألكيل (مركب عضوي تم فيه استبدال ذرات الهيدروجين في الألكان بذرات هالوجين)",
 "alkyl radical": "ألكيل, شق ألكيل",
 "alkylating agent": "عامل مؤلكل (دواء مضاد للأورام يستخدم لعلاج بعض أشكال السرطان عن طريق ربط مجموعة ألكيل بالحمض النووي)",
 "alkylbenzene": "ألكيل بنزين (مركب عضوي يحتوي على مجموعة ألكيل مرتبطة بحلقة بنزين)",
 "alkylbenzenesulfonate": "سلفونات الألكيل بنزين (سلفونات ألكيل البنزين)",
 "alkylic": "ألكيلي (من أو متعلق بمجموعة الألكيل)",
 "alkyne": "ألكاين",
 "all": "كُلّ, جَمِيع",
 "all along": "طوال الوقت, منذ البداية (طوال الوقت أو خلال فترة من الزمن)\nمثال: كانت تعرف طوال الوقت",
 "all and sundry": "الكل و يزيد",
 "all arounder": "شخص شامل, متعدد المواهب (شخص متعدد الجوانب يتقن أشياء كثيرة)\nمثال: إنها أفضل شخص شامل رأوه منذ سنوات",
 "all at once": "بغتة, فجأة (بشكل مفاجئ) / في آن واحد, معاً (الجميع في نفس الوقت)\nمثال: فجأة، بدأ بالصراخ",
 "all clear": "إشارة الأمان, زوال الخطر (إذن بالمضي قدماً لأن العقبات قد أزيلت) / إشارة زوال الخطر (إشارة (عادة صفارة إنذار) تفيد بأن الخطر قد انتهى)",
 "all day": "طُول اَلْيَوْم, طُول اَلنَّهَار (قُدرة؛ غنى أو فضل)\nمثال: قاس طول السرير.",
 "all day long": "طِوَال اليَوْم, نَهَارًا (خلال اليوم بأكمله)\nمثال: الضوء يتدفق طوال اليوم في الغرفة",
 "all fools' day": "كذبة أبريل, يوم كذبة أبريل (اليوم الأول من أبريل الذي يتم الاحتفال به من خلال لعب النكات العملية)",
 "all fours": "أول فورز (ألعاب ورق يتم فيها كسب النقاط لأخذ الأوراق العالية أو المنخفضة أو الولد أو اللعبة)",
 "all get out": "بشكل جنوني, كمية هائلة (كمية كبيرة لا يمكن تصورها)",
 "all good things come to an end": "كُلّ الْأَشْيَاء الْجَيِّدَة تَنْتَهِي",
 "all in all": "بشكل عام, في الإجمال (مع أخذ كل شيء في الاعتبار)\nمثال: في الإجمال، أنا آسف لما حدث",
 "all of a sudden": "فَجْأَةً",
 "all over": "جَمِيع أَنْحَاء, كُلّ",
 "all right": "جَيِّد (بَيِّن الجَوْدَة) / حَسَنًا (تقال عند استحسان الفعل أو القول، هَذَا حَسَن) / مثال: إنها فكرة جيدة.",
 "all rights reserved": "جَمِيع اَلْحُقُوق مَحْفُوظَة, كَافَّة اَلْحُقُوق مَحْفُوظَة",
 "all roads lead to rome": "كُلُّ الطُّرُقِ تُؤَدِّي إِلَى رُومَا",
 "all saints' day": "عِيدُ جَمِيعِ اَلْقِدِّيسِين",
 "all souls' day": "2 نوفمبر, عيد جميع الموتى (يوم للتضرع من أجل جميع الأرواح في المطهر)",
 "all that glitters is not gold": "لَيْسَ كُلُّ مَا يَلْمَعُ ذَهَبًا",
 "all the best": "حَظًّا مُوَفَّقًاَ ((حَظَا) فلان حظوا: مشى رويدا)\nمثال: حظا سعيدا يا زيري.",
 "all the same": "رغم ذلك, لكن (على الرغم من أي شيء مخالف (تسبق عادة التنازل))\nمثال: على الرغم من أنني خائف قليلاً، إلا أنني أود تجربتها مع ذلك",
 "all the time": "على مدار الوقت (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال.",
 "all the way": "حتى النهاية, طوال الطريق (إلى الهدف) / إلى أبعد حد (كناية عن الوصول للعلاقة الجنسية الكاملة) / تَمَامًا, كُلِّيًّا\nمثال: تسلقت الجبل حتى النهاية",
 "all things being equal": "مَعَ ثَبَات الْعَوَامِل الْأُخْرَى, بِاِفْتِرَاض تَسَاوِي الْعَوَامِل الْأُخْرَى (يفيد الاجتماع والمصاحبة؛ مكان الاجتماع)\nمثال: جئت مع أصدقائي.",
 "all together": "كلهم معاً, معاً جميعاً (تستخدم لمجموعة تصرف أعضاؤها أو تم التصرف معهم بشكل جماعي) / في آن واحد, معاً (الجميع في نفس الوقت)\nمثال: تم تجميعهم كلهم معاً",
 "all told": "إجمالاً, في المجموع (مع تضمين أو عد كل شيء)\nمثال: إجمالاً يكسب ما يقرب من مليون دولار",
 "all too": "جِدًّا, لِلْغَايَة (بدرجة عالية)\nمثال: هي مستعدة للغاية لقبول الوظيفة",
 "all's fair in love and war": "كل شيء مباح في الحب والحرب",
 "all-day sucker": "مصاصة (حلوى صلبة على عود)",
 "all-embracing": "شَامِل, وَاسِعُ النِّطَاق (واسع في نطاقه أو محتواه؛ يغطّي مجالات عديدة)",
 "all-encompassing": "شَامِل, وَاسِعُ النِّطَاق (واسع في نطاقه أو محتواه؛ يغطّي مجالات عديدة)",
 "all-fired": "اللعين, جداً (للغاية (تستخدم للتوكيد، وأحياناً تكون عامية أو غير مهذبة)) / بَالِغ, مُتَطَرِّف (مُتَطَرِّفٌ وَتَامٌّ فِي شِدَّتِه)\nمثال: أنت محق تماماً",
 "all-firedly": "اللعين, جداً (للغاية (تستخدم للتوكيد، وأحياناً تكون عامية أو غير مهذبة))\nمثال: أنت محق تماماً",
 "all-inclusive": "شَامِل كُلّ شَيْء",
 "all-knowing": "عَلِيم بِكُلِّ شَيْء, كُلِّيّ الْعِلْم (ذو حكمة لا محدودة؛ يعلم كلّ شيء)",
 "all-metal": "مَعْدَنِيٌّ بِالكَامِل (مُكَوَّنٌ كُلِّيًّا مِنَ المَعْدَن)",
 "all-night": "طَوَالَ اللَّيْل (يَسْتَمِرّ أَوْ يَعْمَل طَوالَ اللَّيْل)",
 "all-or-none": "كُلٌّ أَوْ لَا شَيْء (يحدث بالكامل أو لا يحدث على الإطلاق)",
 "all-or-none law": "قانون الكل أو لا شيء ((في الفسيولوجيا العصبية) نبضة عصبية ناتجة عن محفز ضعيف تكون قوية تمامًا مثل نبضة عصبية ناتجة عن محفز قوي)",
 "all-or-nothing": "كُلٌّ أَوْ لَا شَيْء (يحدث بالكامل أو لا يحدث على الإطلاق)",
 "all-out": "شَامِل, كَامِلُ النِّطَاق (يستخدم جميع الموارد المتاحة)",
 "all-powerful": "قَدِير, كُلِّيّ القُدْرَة (يمتلك قدرة غير محدودة)",
 "all-purpose": "لِكُلّ الاسْتِخْدَامَات, مُتَعَدِّد الأَغْرَاض (غير مقيد في الاستخدام أو الوظيفة)",
 "all-rounder": "شخص شامل, متعدد المواهب (شخص متعدد الجوانب يتقن أشياء كثيرة)\nمثال: إنها أفضل شخص شامل رأوه منذ سنوات",
 "all-terrain bike": "دراجة جبلية (دراجة بإطار متين وإطارات عريضة؛ مصممة أصلاً للركوب في المناطق الجبلية)",
 "all-time": "تَارِيخِيّ, غَيْرُ مَسْبُوق (لم يُتجاوَز في جانب ما حتى الآن)",
 "all-victorious": "دَائِمُ الِانْتِصَارِ (لَمْ يَخْسَرْ قَطُّ)",
 "all-weather": "صَالِحٌ لِكُلِّ الأَجْوَاء (قابل للاستخدام أو العمل في جميع أنواع الطقس)",
 "alla breve": "ألابريف, زمن مقطوع (توقيع وقت موسيقي يشير إلى نوتتين نصفيين أو أربع نوتات نصفية في المقياس)",
 "allah": "اللّٰه ((في الديانات التوحيدية الربوبية) الإله المعبود بحق؛ اللَّٰه)\nمثال: الله وحده يعلم.",
 "allahabad": "اَللّٰه أَبَاد ((في الديانات التوحيدية الربوبية) الإله المعبود بحق؛ اللَّٰه)\nمثال: الله وحده يعلم.",
 "allahu akbar": "اللّٰهُ أَكْبَر ((في الديانات التوحيدية الربوبية) الإله المعبود بحق؛ اللَّٰه)\nمثال: الله وحده يعلم.",
 "allamanda": "ألمندة (نبات من جنس ألمندة له أزهار كبيرة مبهرجة قمعية الشكل في نورات محدودة طرفية)",
 "allamanda cathartica": "ألمندا شائعة, بوق ذهبي (نبات متسلق دائم الخضرة قوي من أمريكا الجنوبية ذو أوراق جلدية لامعة وأزهار صفراء ذهبية)",
 "allantoic": "سلوي, منباري (يتعلق بـ أو يتميز بوجود السقاء (غشاء جنيني))",
 "allantoid": "نَقَانِقِيُّ الشَّكْل (على شكل النقانق)",
 "allantois": "سِقَاء",
 "allargando": "أَلَّارْغَانْدُو ((في الموسيقى) يتباطأ تدريجيًّا في الإيقاع مع اتّساع في الأداء)",
 "allat": "اللَّات",
 "allayer": "مُخَفِّف, مُهَدِّئ (شخص يقلل من الحدة (مثلاً المخاوف) ويهدئ ويسكن)\nمثال: مخفف للقلق",
 "allegation": "اِدِّعَاء (زَعْم؛ الانتساب إلى غير النَّسب الحقيقي)\nمثال: الكثير من الفلسطينيين ممنوعين من العيش مع أزواجهم في إسرائيل لكن، و بطبيعة الحال، يواصل البعض في الادعاء أن إسرائيل ليس دولة تمارس سياسة الأبارتايد.",
 "alleged": "مَزْعُوم (مُصرَّح به لكنه غير مُثبَت)",
 "allegedly": "على ذمة القائل, كما يُزعم (وفقاً لما تم ادعاؤه)\nمثال: حوكم لقتله زوجته كما يُزعم",
 "allegement": "ادعاء, زعم (بيانات تؤكد أو تنفي مسائل واقعية معينة مع الاستعداد لإثباتها)",
 "alleghany plum": "برقوق أليغني (برقوق بري من شمال شرق الولايات المتحدة له ثمار أرجوانية داكنة بلحم أصفر)",
 "allegheny chinkapin": "شينكابين, كستناء قزمية (شجرة كستناء شجيرية من جنوب شرق الولايات المتحدة لها جوز صغير صالح للأكل)",
 "allegheny mountain spurge": "فربيون أليغني (عشب معمر منخفض شبه دائم الخضرة له سنابل صغيرة من الزهور البيضاء أو الوردية؛ موطنه جنوب الولايات المتحدة ولكنه يزرع في أماكن أخرى)",
 "allegheny plum": "برقوق أليغني (برقوق بري من شمال شرق الولايات المتحدة له ثمار أرجوانية داكنة بلحم أصفر)",
 "allegheny spurge": "فربيون أليغني (عشب معمر منخفض شبه دائم الخضرة له سنابل صغيرة من الزهور البيضاء أو الوردية؛ موطنه جنوب الولايات المتحدة ولكنه يزرع في أماكن أخرى)",
 "allegheny vine": "أدلوميا, شاهترج متسلق (نبات متسلق بأوراق ريشية وأزهار بيضاء أو وردية؛ يوضع أحياناً في جنس الشاهترج)",
 "allegiance": "اِنْتِمَاء",
 "allegiant": "مُبَايِع, مُوَالٍ (ثَابِت فِي الإِخْلَاص (خَاصَّةً لِلحَاكِم أَوِ الحُكُومَة الشَّرْعِيَّة))",
 "allegoresis": "تفسير رمزي (تفسير التعبير المكتوب أو الشفهي أو الفني كرمز)\nمثال: تم إهمال التفسير الرمزي للنصوص العلمانية إلى حد كبير منذ فولجنتيوس",
 "allegoric": "تَمْثِيلِيّ, رَمْزِيّ (يُستخدم في الرمز أو يتميز به أو يحتوي عليه)",
 "allegorical": "تَمْثِيلِيّ, رَمْزِيّ (يُستخدم في الرمز أو يتميز به أو يحتوي عليه)",
 "allegorically": "تمثيلياً, رمزياً (بطريقة رمزية تمثيلية)\nمثال: انتهت المسرحية رمزياً",
 "allegoricalness": "أليغورية, رمزية (حالة أو صفة كون الشيء رمزياً)\nمثال: دون قصد، كتب سلوكم رمزية عن وحدة الإنسان، ورمزية كتابه جعلت منه أحد السجلات الشخصية الكلاسيكية",
 "allegoriser": "مستخدم الرمزية (شخص يتواصل بالرموز والاستعارات)",
 "allegorizer": "مستخدم الرمزية (شخص يتواصل بالرموز والاستعارات)",
 "allegory": "تَمْثِيل",
 "allegretto": "بِسُرْعَة مُتَوَسِّطَة (بإيقاع سريع باعتدال) / أَلِيغْرِيتُو ((في الإيقاع الموسيقيّ) أَسْرَع مِنَ الأَلِيغْرُو) / أليغريتو (تأليف موسيقي أو مقطع يُؤدى بإيقاع أسرع نوعاً ما من الأندانتي ولكن ليس بسرعة الأليغرو) / أليغريتو (وتيرة أسرع من أندانتي ولكن ليست سريعة مثل أليغرو)\nمثال: العب هذا بسرعة متوسطة",
 "allegro": "بِسُرْعَة, بِنَشَاط (بإيقاع سريع وحيوي) / أَلِيغْرُو ((في الإيقاع الموسيقيّ) سَرِيع) / أليغرو, حركة سريعة (تأليف موسيقي أو مقطع موسيقي يُؤدى بسرعة وبأسلوب حيوي) / أليغرو (وتيرة سريعة وحيوية)\nمثال: العب هذا القسم بسرعة",
 "allegro con spirito": "أليغرو كون سبيريتو (سريع وحيوي بروح)",
 "allele": "بَدِيل وِرَاثِيّ",
