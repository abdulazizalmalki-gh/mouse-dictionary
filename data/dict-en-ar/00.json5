 "adjectival": "وَصْفِيّ, نَعْتِيّ",
 "adjectivally": "كنعت, وصفياً (بصفته صفة؛ بطريقة وصفية)",
 "adjective": "نَعْت, صِفَة / إِجْرَائِيّ",
 "adjective pronoun": "ضمير نعتي (ضمير يعمل عمل الصفة)",
 "adjectively": "كَصِفَة, وَصْفِيًّا\nمثال: الأسماء تستخدم بشكل متكرر كصفات",
 "adjoining room": "غرفة مجاورة (غرفة فندق تشترك في جدار مع غرفة فندق أخرى)",
 "adjournment": "رفع الجلسة, فض الاجتماع (إنهاء اجتماع) / تأجيل, رفع الجلسة (فعل التأجيل إلى وقت أو مكان آخر)",
 "adjudication": "فَصْل فِي دَعْوَى, حُكُم (التقطيع؛ تقسيم الشيء أجزاءً؛ جزء، باب في كِتَاب أو ماشابهه)\nمثال: اقرأ هذا الفصل.",
 "adjudicative": "تحكيمي, قضائي (معني بالفصل في القضايا أو التحكيم)",
 "adjudicator": "قاضٍ, محكّم (شخص يدرس ويفض النزاعات والخلافات)",
 "adjudicatory": "تحكيمي, قضائي (معني بالفصل في القضايا أو التحكيم)",
 "adjunct": "فَضْلَة",
