 "aesculapian": "طبي (من أو ينتمي إلى أسكليبيوس (إله الطب) أو فن العلاج)",
 "aesculus hippocastanum": "قسطل الحصان, كستناء الحصان (شجرة ذات أوراق راحية وعناقيد كبيرة من الزهور البيضاء إلى الحمراء تليها بذور بنية لامعة غير صالحة للأكل)",
 "aesir": "آيسر ((الأساطير الإسكندنافية) كبار الآلهة الذين يعيشون في أسغارد)",
 "aesop": "عَيْسُوب, إِيسُوب",
 "aesop's fables": "خرافات إيسوب (مجموعة من الحكايات الرمزية يُعتقد أن القاص اليوناني إيسوب قد كتبها)",
 "aesthesia": "حساسية, قابلية للإحساس (الاستجابة العقلية والوعي)",
 "aesthesis": "إحساس (وعي أولي غير مفصل بالتحفيز)\nمثال: إحساس باللمس",
 "aesthete": "مُتذوق للجمال (شخص يُظهر حساسية كبيرة لجمال الفن والطبيعة)",
 "aesthetic": "جَمَالِيّ, فَنِّيّ (يتعلق بـ أو يتميز بتقدير الجمال أو الذوق الرفيع) / جَمَالِيّ, فَنِّيّ (مُمْتِعٌ مِنَ النَّاحِيَةِ الجَمَالِيَّة) / استيطيقي, جمالي (يتعلق بموضوع علم الجمال (الاستيطيقا)) / جمالية ((فلسفة) نظرية فلسفية حول ماهية الجميل)\nمثال: الملكات الجمالية",
 "aesthetical": "جَمَالِيّ, فَنِّيّ (يتعلق بـ أو يتميز بتقدير الجمال أو الذوق الرفيع)\nمثال: الملكات الجمالية",
 "aesthetically": "جَمَالِيًّا (بطريقة ذات ذوق)\nمثال: هذا المبنى ممتع جمالياً للغاية",
 "aesthetician": "عالم جماليات (فيلسوف متخصص في طبيعة الجمال) / أخصائي تجميل, خبير تجميل (عامل ماهر في تقديم علاجات التجميل (مثل العناية بالأظافر والوجه وما إلى ذلك))",
 "aesthetics": "عِلْم الْجَمَال, فَلْسَفَةُ الْجَمَال (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "aestival": "صَيْفِيّ ((نادر) متعلّق بالصيف أو يحدث فيه)",
 "aestivation": "ترتيب الزهور ((علم النبات) ترتيب الكؤوس والبتلات في برعم الزهرة قبل تفتحه) / سبات صيفي ((علم الحيوان) توقف أو تباطؤ النشاط خلال فصل الصيف؛ وخاصة تباطؤ عملية التمثيل الغذائي في بعض الحيوانات خلال فترة حارة أو جافة)",
 "aether": "أثير (وسط كان يُفترض سابقاً أنه يملأ كل الفضاء ويدعم انتشار الموجات الكهرومغناطيسية) / أيثر (تجسيد للسماء أو الهواء العلوي الذي يتنفسه الأولمبيون؛ ابن إريبوس والليل أو الفوضى والظلام)",
 "aethusa cynapium": "بقدونس الأحمق, شوكران صغير (عشب أوروبي ضار استوطن أمريكا يشبه البقدونس ولكنه يسبب الغثيان والتسمم عند تناوله)",
 "aetiologic": "مرضي سببي, مسببي (يتعلق بأسباب المرض (الإتيولوجيا)) / تعليلي, سببي (من أو يتعلق بالدراسة الفلسفية للأسباب)\nمثال: عامل مسبب",
 "aetiological": "مرضي سببي, مسببي (يتعلق بأسباب المرض (الإتيولوجيا)) / تعليلي, سببي (من أو يتعلق بالدراسة الفلسفية للأسباب)\nمثال: عامل مسبب",
 "aetiologist": "أخصائي علم أسباب الأمراض (أخصائي في علم أسباب الأمراض)",
 "aetiology": "أيتولوجيا, علم الأسباب (الدراسة الفلسفية للسببية) / علم الأسباب, مسببات المرض (سبب المرض)",
 "aetobatus narinari": "لخمة النسر المرقطة (لخمة ظهرها مغطى ببقع بيضاء أو صفراء؛ واسعة الانتشار في البحار الدافئة)",
 "afar": "عَفَارِيَّة",
 "afebrile": "خال من الحمى, لاحمي (ليس لديه حمى)",
 "affability": "بشاشة, دماثة (الميل لكون المرء ودوداً ويسهل التعامل معه)",
 "affable": "بَشُوش, لَطِيف (يَنْشُرُ الدِّفْء وَالوُدّ مِنْ حَوْلِه)",
 "affableness": "بشاشة, دماثة (الميل لكون المرء ودوداً ويسهل التعامل معه)",
 "affably": "بلطف, بود (بطريقة ودودة)\nمثال: قال بود: 'تعال لزيارتي'",
 "affair": "شَأْن / عَلَاقَة غَرَامِيَّة",
 "affaire": "علاقة غير شرعية, نزوة (علاقة جنسية سرية أو غير مشروعة عادة)",
 "affaire d'honneur": "مُبَارَزَة (قتال مرتب مسبقاً بأسلحة مميتة بين شخصين (برفقة شهود) من أجل تسوية نزاع حول مسألة شرف)",
 "affairs": "شؤون, قضايا (معاملات ذات اهتمام مهني أو عام) / أمور شخصية, شأن خاص (مسائل ذات اهتمام شخصي)\nمثال: أخبار الشؤون الجارية",
 "affect": "أَثَّرَ (عَلَامَة؛ بَقِيَّة؛ رَسْم مُتَخَلَّف من شيء ما؛ تأثير؛ انطباع)\nمثال: اختفى فلم ير له أثر.",
 "affectation": "تَصَنُّع, تَكَلُّف",
 "affected": "مُتَأَثِّر (وقع عليه فعل أو تأثير) / مُتَصَنَّع, مُتَكَلَّف (يتحدث أو يتصرف بطريقة مصطنعة لترك انطباع) / متأثر, منفعل (في حالة انفعال أو استثارة للتعبير عن عاطفة)\nمثال: متأثر جداً لدرجة عدم القدرة على الكلام",
 "affected role": "المتأثر, المفعول به (الدور الدلالي لكيان ليس هو الفاعل ولكنه مشارك بشكل مباشر في الحدث الذي يدل عليه الفعل أو متأثر به)",
 "affectedly": "بتكلف (بطريقة متكلفة)",
 "affectedness": "تصنع, تكلف (تظاهر متعمد أو عرض مبالغ فيه) / تَصَنُّع, تَكَلُّف (صفة كون الشيء زائفاً أو مصطنعاً (بهدف إثارة إعجاب الآخرين))",
 "affecting": "مُؤَثِّر, مُبَكٍّ (يثير المشاعر والعواطف)",
 "affectingly": "بشكل مؤثر, بشكل يلامس المشاعر (بطريقة مؤثرة أو تلامس المشاعر)\nمثال: تحدثت بشكل مؤثر",
 "affection": "عاطفة, محبة (شعور إيجابي بالإعجاب)\nمثال: وجد صعوبة في التعبير عن المودة التي شعر بها",
 "affectional": "اِنْفِعَالِيّ, وِجْدَانِيّ (يتّسم بالعاطفة أو الانفعال)",
 "affectionate": "حَنُون, وَدُود (يتحلّى بالدفء العاطفي والمودة أو يُظهرهما)",
 "affectionately": "بحنان, بشدة\nمثال: أحبته بشدة",
 "affectionateness": "دفء عاطفي, محبة (صفة نابعة من مشاعر المودة أو الحب) / عاطفة, محبة (شعور إيجابي بالإعجاب)\nمثال: وجد صعوبة في التعبير عن المودة التي شعر بها",
 "affective": "اِنْفِعَالِيّ, وِجْدَانِيّ (يتّسم بالعاطفة أو الانفعال)",
 "affective disorder": "اضطراب عاطفي, اضطراب وجداني (أي اضطراب عقلي لا تسببه تشوهات عضوية قابلة للكشف في الدماغ ويكون فيه الاضطراب الرئيسي في العواطف سائداً)",
 "affenpinscher": "أفينبينشر (سلالة أوروبية من الكلاب الصغيرة تشبه التيريير ذات شعر سلكي داكن وخطم معنقد)",
 "afferent": "وَارِد (للأعصاب والنبضات العصبية؛ تنقل المعلومات الحسية من أعضاء الحس إلى الجهاز العصبي المركزي) / عصب حسي, عصب وارد (عصب ينقل النبضات من المستقبلات باتجاه أو إلى الجهاز العصبي المركزي)\nمثال: أعصاب واردة",
 "afferent fiber": "ليف حسي, ليف وارد (ليف عصبي يحمل النبضات نحو الجهاز العصبي المركزي)",
 "afferent nerve": "عصب حسي, عصب وارد (عصب ينقل النبضات من المستقبلات باتجاه أو إلى الجهاز العصبي المركزي)",
 "afferent neuron": "عصبون حسي (عصبون ينقل النبضات نحو الدماغ أو الحبل الشوكي)",
 "affiant": "شَاهِد بِقَسَم, مُقِرّ بِالْقَسَم (شخص يقدم إفادة خطية مشفوعة بيمين)",
 "affidavit": "إقرار مشفوع بيمين, شهادة خطية بقسم (إعلان مكتوب تحت القسم؛ بيان مكتوب يقسم على صحته أمام شخص مخول قانوناً بإدارة القسم)",
 "affiliate": "جهة منتسبة, فرع (منظمة فرعية أو ثانوية تابعة لمنظمة أخرى) / عُضْو مُنْتَسِب, مُنْتَسِب (زميل مرؤوس أو فرعي؛ شخص ينتسب لآخر أو لمنظمة)\nمثال: الجهات التابعة للشبكة",
 "affiliated": "تَابِعٌ, مُلْحَقٌ (مُنْضَمّ في ارتباط وثيق)",
 "affiliation": "تَبَعِيَّة, اِنْتِمَاء (التَّبَعيَّة : كَوْن الشخص أو الشيْ تابعاً لغيره؛ مصدر صناعيّ من تَبَعَ: جِنْسِيَّة ومُواطَنَة أو انتماء إلى دولة ما، يكون للمواطن فيها حقوق وامتيازات، وبالمقابل عليه واجبات)",
 "affinal": "مُصَاهِرٌ, نَسَبِيّ ((في الأنثروبولوجيا) مرتبط عن طريق المصاهرة)",
 "affine": "مُصَاهِرٌ, نَسَبِيّ ((في الأنثروبولوجيا) مرتبط عن طريق المصاهرة) / تآلفي ((رياضيات) من أو متعلق بهندسة التحويلات التآلفية) / قريب بالمصاهرة ((أنثروبولوجيا) قريب عن طريق الزواج)",
 "affine geometry": "هندسة أفينية, هندسة تآلفية (هندسة التحويلات التآلفية)",
 "affine transformation": "تَحْوِيل تَآلُفِيّ ((الرياضيات) تحويل هو مزيج من تحويلات فردية مثل النقل أو الدوران أو الانعكاس على محور)",
 "affined": "وَثِيقُ الصِّلَةِ (مُرْتَبِطٌ ارْتِبَاطًا وَثِيقًا)",
 "affinity": "أُلْفَة, انْجِذَاب (انجذاب طبيعي أو شعور بالقرابة) / أُلْفَة, تَجَانُس (تشابه متأصل بين الأشخاص أو الأشياء) / ألفة, انجذاب كيميائي (القوة التي تجذب الذرات لبعضها وتربطها معاً في جزيء) / ألفة ((في المناعة) الانجذاب بين مستضد وجسم مضاد)\nمثال: انجذاب للسياسة",
 "affirmable": "قَابِل لِلتَّأْكِيد, قَابِل لِلتَّقْرِير (يمكن تأكيده أو تقريره والإقرار به)",
 "affirmation": "تَأْكِيد, تَوْكِيد / إِيحَاء ذَاتِيّ",
 "affirmative": "إِيجَابِيّ, تَوْكِيدِيّ (يؤكد أو يعطي الموافقة) / اسْتِحْسَانِيّ, مُوَافِق (يُعَبِّر عَنِ المَدْح أَوِ الاسْتِحْسَان أَوْ يُظْهِرُهُمَا) / تَفَاؤُلِيّ, مُتَفَائِل (يتوقع الأفضل من الأمور) / إيجاب, رد بالإيجاب (رد يفيد التأكيد أو الموافقة)\nمثال: قرار إيجابي",
 "affirmative action": "تمييز إيجابي (سياسة مصممة لتصحيح التمييز السابق ضد النساء ومجموعات الأقليات من خلال تدابير لتحسين فرصهم الاقتصادية والتعليمية)\nمثال: كان التمييز الإيجابي مثيراً للجدل للغاية وتم الطعن فيه في عام 1978 في قرار باكي",
 "affirmative pleading": "دفع إيجابي, مرافعة إثباتية (أي مرافعة دفاعية تؤكد الوقائع بدلاً من مجرد إنكار الوقائع التي يزعمها المدعي)",
 "affirmative sentence": "جُمْلَةٌ مُثْبَتَةٌ (مؤنث جُمْل، وهو الحبل الغليظ أو الجماعة من الناس؛ المَجْمُوع)\nمثال: يا لها من جملة!",
 "affirmatively": "بالإيجاب (بطريقة إيجابية (للتأكيد))",
 "affirmativeness": "إيجابية (الصفة المقبولة للشخص الذي يوافق)",
 "affirmatory": "إِيجَابِيّ, تَوْكِيدِيّ (يؤكد أو يعطي الموافقة)\nمثال: قرار إيجابي",
 "affirmer": "جازم, مؤكِّد (شخص يدعي قول الحقيقة)\nمثال: مؤكد جريء",
 "affix": "أَفِكْس",
 "affixal": "إضافي, لواحقي (من أو متعلق باللواحق اللغوية (السوابق واللواحق))",
 "affixation": "إرفاق, إلحاق (عملية إرفاق أو إلحاق شيء ما) / إلصاق (تكوين كلمة بواسطة لاحقة أو سابقة) / إلصاق (نتيجة إضافة لاحقة أو بادئة إلى جذر الكلمة)",
 "affixed": "مُثَبَّت, مُلْصَق (مرفق بإحكام)\nمثال: الملصقات المثبتة",
 "affixial": "إضافي, لواحقي (من أو متعلق باللواحق اللغوية (السوابق واللواحق))",
 "afflatus": "وَحْي, إلْهَام (الإعلام في الخفاء، وهذا أصل الكلمة؛ الإلهام، سواء كان غريزيّ أو فطريّ أو فنيّ أو غيره وسواء كان من الله أو من غيره)\nمثال: يا رسول الله، كيف يأتيك الوحي ؟",
 "afflicted": "مُصَاب, مُعْتَلّ (غَيْرُ لَائِقٍ عَقْلِيًّا أَوْ جَسَدِيًّا) / مُبْتَلًى, مُصَاب (متضرّر بشدّة وخاصّة من مرض)",
 "affliction": "بلاء, مصاب (سبب للمعاناة والضيق الشديد) / بلاْء, علة (حالة من المعاناة أو الضيق بسبب اعتلال الصحة) / بلاء, محنة (حالة من المعاناة والضيق الشديد بسبب الشدائد)",
 "afflictive": "مُؤْلِم, مُوجِع (يسبب البؤس أو الألم أو الكرب)",
 "affluence": "ثَرْوَة",
 "affluent": "ثَرِيّ, مُوسِر (يمتلك وفرة من المال أو الممتلكات القيّمة) / رافد (فرع يصب في المجرى الرئيسي) / مرفه, ميسور (شخص ميسور الحال؛ شخص في وضع مالي جيد)\nمثال: ما يسمى بالأثرياء الناشئين",
 "affluenza": "أفلوينزا, وباء الثراء (عدم القدرة على فهم عواقب أفعال المرء بسبب الامتياز المالي)",
 "affogato": "أَفُّوغَاتُو, أَفُّوقَاتُو",
 "afford": "أَعْطَى (مَنَحَ، نَوَّلَ)\nمثال: أعطى بلده حياته.",
 "affordable": "فِي المُتَنَاوَل, مَيْسُور التَّكْلِفَة (يمكن تحمل تكلفته مالياً)",
 "afforest": "شَجَّرَ (الأمر المختلف بين الناس؛ مخرج الفَم أو مُؤَخَّره. ومنه الحروف الشَجْرِيَّة)\nمثال: توم يتسلق شجرة.",
 "afforestation": "تشجير (تحويل الأراضي الجرداء أو المزروعة إلى غابة (أصلاً لغرض الصيد))",
 "affray": "شِجَار عَلَنِيّ, عِرَاك (قتال صاخب) / شجار صاخب, مشادة (شجار صاخب)",
 "affricate": "صَامِت مَوْقُوف اِحْتِكَاكِيّ, صَامِت مَزْجِيّ",
 "affricate consonant": "صامت موقوف احتكاكي, صوت مركب (صوت كلامي مركب يتكون من صوت وقفي وصوت احتكاكي يُنطقان في نفس النقطة (مثل 'تش' في 'تشاد'))",
 "affrication": "تعطيش, مزج (تحويل صوت صامت بسيط (وقفي) إلى صوت ممزوج (موقوف احتكاكي))",
 "affricative": "صامت موقوف احتكاكي, صوت مركب (صوت كلامي مركب يتكون من صوت وقفي وصوت احتكاكي يُنطقان في نفس النقطة (مثل 'تش' في 'تشاد'))",
 "affright": "ذعر, رعب (شعور غامر بالخوف والقلق)",
 "affront": "إهانة, شتيمة (فعل مسيء عمداً أو شيء ينتج تأثير عدم الاحترام المتعمد)\nمثال: كان إدارة ظهره لي إهانة متعمدة",
 "affusion": "سكب الماء (فعل تعميد شخص بسكب الماء على رأسه)",
 "afghan": "أَفْغَانِيّ, أَفْغَانِيَّة",
 "afghan hound": "كَلْبُ الصَّيْدِ الأفْغَانِيِّ (بمعنى ضربهُ بالكُلاب أو جعل لها كَلْبًا؛ سَيْر أحمر يُجعَل بين طرفي الأديم إذا خُرِز)\nمثال: كان الكلب ميتا.",
 "afghan language": "الأفغانية, البشتو (لغة إيرانية يتم التحدث بها في أفغانستان وباكستان؛ اللغة الرسمية لأفغانستان)",
 "afghan monetary unit": "وحدة نقدية أفغانية (الوحدة النقدية في دولة أفغانستان الإسلامية)",
 "afghani": "أَفْغَانِيّ",
 "afghani language": "الأفغانية, البشتو (لغة إيرانية يتم التحدث بها في أفغانستان وباكستان؛ اللغة الرسمية لأفغانستان)",
 "afghanistan": "أَفْغَانِسْتَان (في جنوب آسيا قرب باكستان)\nمثال: أفغانستان في حرب.",
 "afghanistani": "أفغاني (من أو يتعلق بأفغانستان أو شعبها أو يميزهم) / أفغاني (مواطن أو ساكن في أفغانستان)",
 "afibrinogenemia": "فقد فبرينوجين الدم (غياب الفبرينوجين في البلازما مما يؤدي إلى نزيف طويل الأمد)",
 "aficionado": "شَغُوف, هاوٍ (نصير جاد لنوع معين من الموسيقى أو مؤدٍ موسيقي (أو أي هواية)) / مولع بمصارعة الثيران (مشجع لمصارعة الثيران)",
 "afield": "بَعِيدًا, خَارِج المَوْضُوع (بعيداً عن الموضوع؛ وراء النقطة المطروحة) / فِي المَيْدَان (في أو داخل ميدان (خاصة ميدان المعركة)) / فِي الخَارِج (بعيداً عن المنزل أو المحيط المعتاد)\nمثال: مثل هذه الاستطرادات يمكن أن تأخذنا بعيداً عن الموضوع",
 "afisr": "استخبارات ومراقبة واستطلاع القوات الجوية (وكالة تركز على ضمان حصول الجيش الأمريكي على التفوق المعلوماتي؛ تشغل مواقع أرضية عالمية ومجموعة من منصات الاستطلاع والمراقبة الجوية)",
 "afl": "الاتحاد الأمريكي للعمل (اتحاد لنقابات العمال في أمريكا الشمالية اندمج مع مؤتمر المنظمات الصناعية في عام 1955)",
 "afl-cio": "الاتحاد الأمريكي للعمل ومؤتمر المنظمات الصناعية (أكبر اتحاد لنقابات العمال في أمريكا الشمالية؛ تأسس عام 1955)",
 "aflame": "مُتَأَجِّج, مُتَّقِد (شَدِيدُ الحَمَاسِ أَوِ الإِثَارَة (خَاصَّةً جِنْسِيًّا))",
 "aflare": "مُتَمَوِّج, مُنْتَشِر (يتدفق أو يمتد كما لو كان في تيار هوائي)",
 "aflatoxin": "أفلاتوكسين (مسرطن قوي من فطر الرشاشيات؛ يمكن إنتاجه وتخزينه للاستخدام كسلاح بيولوجي)",
 "aflaxen": "أليف, أنابروكس (دواء مضاد للالتهاب غير ستيرويدي (العلامات التجارية أليف وأنابروكس وغيرها) يحارب الألم والالتهاب)",
 "aflutter": "مُتَلَهِّف, مُتَوَتِّر (مُنْفَعِل تَرَقُّباً وتوقعاً)",
 "afoot": "عَلَى قَدَم وَسَاق (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال.",
 "aforesaid": "مَذْكُور آنِفًا",
 "aforethought": "مُدَبَّر, مُبَيَّت",
 "afp": "ألفا فيتو بروتين, البروتين الجنيني ألفا (كمية كبيرة غير طبيعية من هذا البروتين الجنيني في الجنين يمكن أن تشير إلى خلل في الأنبوب العصبي (مثل السنسنة المشقوقة))",
 "afraid": "خَائِف, مَرْعُوب",
 "aframomum melegueta": "حبوب الجنة, فلفل غينيا (نبات من غرب أفريقيا يحمل بذوراً حريفة تشبه الفلفل)",
 "afrasian": "اللغات الأفرو آسيوية (عائلة كبيرة من اللغات ذات الصلة يتم التحدث بها في آسيا وأفريقيا)",
 "afrasian language": "اللغات الأفرو آسيوية (عائلة كبيرة من اللغات ذات الصلة يتم التحدث بها في آسيا وأفريقيا)",
 "afresh": "مجدداً, من جديد (مرة أخرى ولكن بطريقة جديدة أو مختلفة)\nمثال: ابدأ من جديد",
 "africa": "أَفْرِيقِيَا, إِفْرِيقِيَا",
 "african": "إِفْرِيقِيّ, أَفْرِيقِيّ (مِنْ أو متعلق بقارة إفريقيا)\nمثال: هي إفريقية أمريكية مسلمة.",
 "african american": "أفرو-أمريكي, أمريكي إفريقي (أمريكي من أصول ولدت في إفريقيا)",
 "african american english": "إيبونيكس, الإنجليزية الأمريكية الأفريقية (شكل غير قياسي من الإنجليزية الأمريكية يتحدث به بشكل مميز الأمريكيون من أصل أفريقي في الولايات المتحدة)",
 "african american vernacular english": "إيبونيكس, الإنجليزية الأمريكية الأفريقية (شكل غير قياسي من الإنجليزية الأمريكية يتحدث به بشكل مميز الأمريكيون من أصل أفريقي في الولايات المتحدة)",
 "african bowstring hemp": "قنب أفريقي, قنب الوتر الأفريقي (قنب الوتر من جنوب أفريقيا)",
 "african chameleon": "حرباء أفريقية (حرباء توجد في أفريقيا)",
 "african clawed frog": "ضفدع أفريقي ذو مخالب (ضفدع عديم اللسان موطنه أفريقيا؛ استقر في الولايات المتحدة نتيجة إطلاق حيوانات المختبرات وأحواض السمك)",
 "african coral snake": "ثعبان مرجاني أفريقي (ثعبان شجري صغير واسع الانتشار في جنوب أفريقيا مخطط بالأسود والبرتقالي)",
 "african country": "دولة أفريقية (أي دولة من الدول التي تشغل القارة الأفريقية)",
 "african crocodile": "تمساح النيل (تمساح خطير واسع الانتشار في أفريقيا)",
 "african daisy": "أركتوتس, أقحوان أفريقي (أي من عدة نباتات من جنس أركتوتس لها زهور تشبه الأقحوان) / أقحوان أفريقي (أعشاب أفريقية أو آسيوية ذات زهور تشبه الأقحوان) / أجيراتوم أصفر, أقحوان أفريقي (شجيرة من منطقة جنوب غرب البحر الأبيض المتوسط لها زهور صفراء تشبه الأقحوان)",
 "african elephant": "فيل أفريقي (فيل موطنه أفريقيا له آذان ضخمة ترفرف وأنياب عاجية)",
 "african golden wolf": "ذئب ذهبي أفريقي (حيوان من فصيلة الكلبيات يعيش في صحاري شمال أفريقيا ويرتبط بابن آوى الذهبي والذئب الرمادي)",
 "african gray": "ببغاء رمادي أفريقي (ببغاء رمادي مدجن شائع بذيل أحمر وأسود ووجه أبيض؛ موطنه أفريقيا الاستوائية)",
 "african green monkey": "سعدان أخضر (قرد سافانا شائع ذو ظهر رمادي مخضر وذيل أصفر)",
 "african grey": "ببغاء رمادي أفريقي (ببغاء رمادي مدجن شائع بذيل أحمر وأسود ووجه أبيض؛ موطنه أفريقيا الاستوائية)",
 "african hemp": "قنب أفريقي (شجيرة كبيرة من جنوب أفريقيا ذات فروع عديدة مشعرة بوضوح بأوراق مشعرة كبيرة وعناقيد من الزهور البيضاء البارزة) / قنب أفريقي, قنب الوتر الأفريقي (قنب الوتر من جنوب أفريقيا)",
 "african holly": "مغد عملاق, هولي أفريقي (شجيرة شجرية ثنائية الحول بساق صوفية من إفريقيا الاستوائية وجنوب آسيا لها فروع شائكة بيضاء فضية، وعناقيد من الزهور الزرقاء أو البيضاء، وتوت أحمر ساطع…)",
 "african hunting dog": "سِمْع, كَلْبٌ بَرِّيٌّ إِفْرِيقِيٌّ (أَدْرَكَ الصوت بأذنه؛ أَصْغَى، أَنْصَتَ. (يتعدى باللام وإلى))\nمثال: سمع سامي صريرا.",
 "african lily": "أغابانثوس, زنبق أفريقي (نبات أفريقي بأوراق خضراء زاهية دائمة الخضرة ومظلات من العديد من الزهور البنفسجية الزرقاء العميقة عادة)",
 "african love grass": "عشبة الحب الأفريقية, عشبة الحب الباكية (عشبة جنوب أفريقية معمرة ذات سيقان واهية متكتلة بكثافة؛ أدخلت إلى الولايات المتحدة خاصة لمكافحة التعرية)",
 "african mahogany": "ماهوجني أفريقي (شجرة أفريقية ذات خشب صلب وثقيل وعديم الرائحة)",
 "african marigold": "قطيفة أفريقية, قطيفة قائمة (نبات سنوي متفرع قوي برؤوس زهور صفراء إلى برتقالية كبيرة؛ المكسيك وأمريكا الوسطى)",
 "african millet": "دخن الإصبع, راجي (عشب حبوب من شرق الهند تنتج بذوره دقيقاً مراً نوعاً ما، وهو غذاء أساسي في الشرق)",
 "african monitor": "ورل نيلي (يدمر بيض التماسيح)",
 "african nation": "دولة أفريقية (أي دولة من الدول التي تشغل القارة الأفريقية)",
 "african oil palm": "نخيل الزيت الأفريقي (نخيل الزيت من أفريقيا)",
 "african sandalwood": "صندل أفريقي, كاموود (شجرة أفريقية شجيرية صغيرة ذات خشب صلب يستخدم كخشب صباغة ينتج صبغة حمراء)",
 "african scented mahogany": "سابيلي, ماهوجني أفريقي معطر (شجرة أفريقية ذات خشب خفيف الوزن برائحة الأرز يتراوح لونه من الوردي إلى البني المحمر)",
 "african sharptooth catfish": "قرموط",
 "african tea": "قات (أوراق شجيرة كاثا إدوليس التي تُمضغ مثل التبغ أو تستخدم لصنع الشاي؛ لها تأثير المنشط المبهج)\nمثال: في اليمن، يستخدم 85% من البالغين القات يومياً",
 "african tulip": "أغابانثوس, زنبق أفريقي (نبات أفريقي بأوراق خضراء زاهية دائمة الخضرة ومظلات من العديد من الزهور البنفسجية الزرقاء العميقة عادة)",
 "african union": "اَلاِتِّحَاد اَلْإِفْرِيقِيّ, اَلاِتِّحَاد اَلْأَفْرِيقِيّ",
 "african violet": "بنفسج أفريقي, سانت بوليا (نبات أفريقي استوائي يزرع كنبات منزلي لزهوره البنفسجية أو البيضاء أو الوردية)",
 "african walnut": "جوز أفريقي, لوفوا (شجرة خشب استوائية أفريقية بخشب يشبه الماهوجني)",
 "african wild ass": "حمار بري أفريقي (حمار بري يعيش في أفريقيا)",
 "african yellowwood": "خشب أصفر أفريقي, خشب أصفر الكاب (شجرة أو شجيرة جنوب أفريقية ذات تاج مستدير)",
 "african-american": "أمريكي إفريقي, أمريكية إفريقية",
 "african-american music": "الموسيقى السوداء, موسيقى الأمريكيين الأفارقة (موسيقى أنشأها موسيقيون أمريكيون من أصل أفريقي؛ كانت الأشكال المبكرة عبارة عن أغانٍ ذات خط لحني وإيقاع قوي مع لازمة متكررة)",
 "africander": "أفريكندر (ماشية طويلة ذات قرون كبيرة وسنام من جنوب أفريقيا؛ تستخدم للحم أو الجر)",
 "africanized bee": "نحل أفريقي, نحل قاتل (سلالة من النحل نشأت في البرازيل في الخمسينيات كتهجين بين نحل أفريقي عدواني ونحل عسل؛ تحتفظ بمعظم سمات النحل الأفريقي)",
 "africanized honey bee": "نحل أفريقي, نحل قاتل (سلالة من النحل نشأت في البرازيل في الخمسينيات كتهجين بين نحل أفريقي عدواني ونحل عسل؛ تحتفظ بمعظم سمات النحل الأفريقي)",
 "afrikaans": "لُغَة أَفْرِيكَانِيَّة (هِيَ مجموعة من الأصوات التي يصدرها الإنسان على شكل كلمات منظمة بقواعد، ليتواصل به الناس وينقلون به الافكار والمعاني، اللسان؛ يقصد بها أحيانا اللهجة)\nمثال: الأمازيغية لغة.",
 "afrikaans language": "الأفريكانية (لغة رسمية لجمهورية جنوب أفريقيا؛ ترتبط ارتباطًا وثيقًا بالهولندية والفلمنكية)",
 "afrikander": "أَفْرِيكانَر (مواطن أبيض من مقاطعة الكاب ينحدر من المستوطنين الهولنديين ويتحدث الأفريكانية)",
 "afrikaner": "أَفْرِيكَانِيّ, أَفْرِيكَانِيَّة",
 "afro": "تَسْرِيحَة أَفْرُو (تسريحة شعر مستديرة ومجعدة بكثافة)",
 "afro hairdo": "تَسْرِيحَة أَفْرُو (تسريحة شعر مستديرة ومجعدة بكثافة)",
 "afro-american": "أَمْرِيكِيّ مِن أَصْل أَفْرِيقِيّ (يتعلق بالأمريكيين من أصل أفريقي أو يتسم بخصائصهم) / أفرو-أمريكي, أمريكي إفريقي (أمريكي من أصول ولدت في إفريقيا)",
 "afro-asian": "أفرو-آسيوي (من أو يتعلق بدول أفريقيا وآسيا أو شعوبها)\nمثال: سكان أفرو-آسيويين",
 "afro-asiatic": "اللغات الأفرو آسيوية (عائلة كبيرة من اللغات ذات الصلة يتم التحدث بها في آسيا وأفريقيا)",
 "afro-wig": "باروكة أفرو (شعر مستعار يعطي مظهر تسريحة الشعر الأفريقي المجعد)",
 "afroasiatic": "اللغات الأفرو آسيوية (عائلة كبيرة من اللغات ذات الصلة يتم التحدث بها في آسيا وأفريقيا)",
 "afroasiatic language": "اللغات الأفرو آسيوية (عائلة كبيرة من اللغات ذات الصلة يتم التحدث بها في آسيا وأفريقيا)",
 "afrocarpus falcata": "أفروكاربوس منجلي, خشب أصفر شائع (شجرة متوسطة الحجم في جنوب أفريقيا)",
 "afropavo": "طاووس الكونغو (كلا الجنسين زاهي الألوان)",
 "afropavo congensis": "طاووس الكونغو (كلا الجنسين زاهي الألوان)",
 "afspc": "قيادة الفضاء للقوات الجوية (قيادة تابعة للقوات الجوية الأمريكية مسؤولة عن الدفاع عن الولايات المتحدة من خلال عملياتها الفضائية والصواريخ الباليستية العابرة للقارات)",
 "aft": "فِي المُؤَخِّرَة (عند أو بالقرب من أو باتجاه مؤخرة سفينة أو ذيل طائرة)\nمثال: خزن الأمتعة في المؤخرة",
 "after": "بعد (يدل على اللحاق في الزمان؛ يكون مضافا، وينصب أو يجر) / خَلْفَ, وَرَاء (بَدَلَ، أَعْقَبَ؛ أَتَى بعده أو جاء مكانه) / بَعْدَمَا\nمثال: و بعد قليل أتى.",
 "after a fashion": "بشكل ما, نوعاً ما (إلى حد ما؛ ليس بشكل جيد جداً)\nمثال: يتحدث الفرنسية نوعاً ما",
 "after all": "فِي النِّهَايَة (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "after hours": "بعد ساعات العمل (ليس أثناء الساعات المعتادة)\nمثال: عمل غالباً بعد ساعات العمل",
 "after part": "كوثل, مؤخرة السفينة (الجزء الخلفي للسفينة)",
 "after-hours": "بَعْدَ سَاعَاتِ العَمَل (بعد موعد الإغلاق خاصة الإغلاق المحدّد قانونياً)",
 "after-shave": "كولونيا ما بعد الحلاقة, لوشن ما بعد الحلاقة (غسول عطري لوجه الرجل بعد الحلاقة)",
 "after-shave lotion": "كولونيا ما بعد الحلاقة, لوشن ما بعد الحلاقة (غسول عطري لوجه الرجل بعد الحلاقة)",
 "afterbirth": "خَلَاص",
 "afterburner": "جهاز حرق لاحق, حارق لاحق (جهاز يحقن الوقود في العادم الساخن للحصول على قوة دفع إضافية)",
 "aftercare": "رعاية النقاهة, رعاية تالية (رعاية وعلاج المريض في فترة النقاهة)",
 "afterdamp": "غاز الخنق, غاز ما بعد الانفجار (خليط سام من الغازات (يشمل ثاني أكسيد الكربون وأول أكسيد الكربون والنيتروجين) بعد انفجار غاز المناجم)",
 "afterdeck": "سطح المؤخرة (سطح خلف وسط السفينة)",
 "aftereffect": "أثر لاحق (أي نتيجة تتبع سببها بعد فترة زمنية) / أثر تال, أثر لاحق (تأثير متأخر لدواء أو علاج)\nمثال: كان للدواء آثار تالية غير متوقعة",
 "afterglow": "أثر طيب, نشوة لاحقة (متعة تذكر حدث سار) / شفق, وهج لاحق (وهج يُرى أحياناً في السماء بعد غروب الشمس)\nمثال: استمتع بنشوة انتصاره",
 "afterimage": "أثر حسي, صورة تلوية (صورة (عادة ما تكون سلبية) تستمر بعد توقف التحفيز)",
 "afterlife": "آخِرَة",
 "aftermath": "أَعْقَاب",
 "aftermost": "فِي أَقْصَى المُؤَخِّرَة (يَقَعُ فِي أَقْرَبِ مَوْضِعٍ مِنْ مُؤَخِّرَةِ السَّفِينَةِ أَوِ الذَّيْلِ)",
 "afternoon": "بَعْد الظُّهْر, بَعْدَ الزَّوَال (يدل على اللحاق في الزمان؛ يكون مضافا، وينصب أو يجر)\nمثال: و بعد قليل أتى.",
 "afternoon tea": "شاي, شاي بعد الظهر (وجبة خفيفة بعد الظهر تتكون من الشاي والشطائر أو الكعك)",
 "afterpains": "آلام ما بعد الولادة (آلام تشعر بها المرأة بعد ولادة طفلها؛ مرتبطة بتقلصات الرحم)",
 "afterpiece": "عرض ختامي, مسرحية ختامية (قطعة درامية قصيرة (عادة ما تكون هزلية) تُعرض بعد مسرحية)",
 "afters": "تحلية, حلوى (طبق يُقدم كآخر مرحلة في الوجبة)",
 "aftersensation": "أثر حسي, صورة تلوية (صورة (عادة ما تكون سلبية) تستمر بعد توقف التحفيز)",
 "aftershaft": "سُوَيْقَة ثَانَوِيَّة (ريشة إضافية (صغيرة عادة) على الجانب السفلي من قاعدة ساق بعض الريش في بعض الطيور)",
 "aftershafted": "ذُو رِيشَة ثَانَوِيَّة (لَدَيْه رِيشَة ثَانَوِيَّة صَغِيرَة عِنْدَ قَاعِدَة بَعْض الرِّيش)",
 "aftershock": "هَزّةٌ اِرْتِدادِيَّةٌ, تَوابِعُ",
 "aftertaste": "طعم لاحق, مذاق متبق (صورة تلوية (أثر متبق) لمذاق ما)",
 "afterthought": "إضافة لاحقة, فكرة مستدركة (إضافة لم تكن مدرجة في الخطة الأصلية) / إعادة نظر, تفكير ثانٍ (التفكير مرة أخرى في خيار تم اتخاذه سابقاً)\nمثال: كان المرآب إضافة لاحقة",
 "afterward": "بعد ذلك, فيما بعد (يحدث في وقت لاحق لوقت مرجعي)\nمثال: اعتذر لاحقاً",
 "afterwards": "أَخِير, بَعْدَ ذٰلِك",
 "afterword": "خَاتِمَة",
 "afterworld": "العالم الآخر, دار البقاء (المكان الذي تذهب إليه بعد الموت)",
 "afyonkarahisar": "افيون قرهحصار",
 "ag": "فضة (عنصر معدني أبيض ناعم وثمين وأحادي التكافؤ له أعلى موصلية كهربائية وحرارية من أي معدن؛ يوجد في الأرجنتيت وفي شكل حر؛ يستخدم في العملات المعدنية…)",
 "aga": "آغا (لقب لقائد مدني أو عسكري (خاصة في تركيا))",
 "agada tantra": "أغادا تانترا (أحد الفروع الثمانية التي ينقسم إليها طب الأيورفيدا تقليدياً، ويعرف كقسم من علم السموم يتعامل مع التسمم الغذائي ولدغات الثعابين وعضات الكلاب ولدغات…)",
 "agadir": "أَكَادِير, أَغَادِير",
 "again": "مَرَّة أُخْرَى, ثَانِيَةً (مؤنث مُرّ، صفة ما كان بها مرارة)\nمثال: كم من مرة ذهبت؟",
 "again and again": "مِرَارًا وَتِكْرَارًا",
 "against": "ضد / ضِدّ",
 "against the clock": "ضِدَّ السَّاعَة",
 "against the wind": "عكس الريح (في الاتجاه المعاكس لاتجاه هبوب الريح)\nمثال: طاروا عكس الريح",
 "against time": "في سباق مع الزمن (بأسرع ما يمكن؛ قبل الموعد النهائي)\nمثال: كان سباقاً مع الزمن",
 "agal": "عقال (حبل (عادة من شعر الماعز) يلفه العرب (خاصة البدو) حول رؤوسهم لتثبيت الكوفية (الغترة))",
 "agalactia": "انقطاع اللبن, عوز اللبن (حالة عدم إفراز الحليب في ثدي الأم بعد الولادة)",
 "agalactosis": "انقطاع اللبن, عوز اللبن (حالة عدم إفراز الحليب في ثدي الأم بعد الولادة)",
 "agama": "عَضْرَفُوط, أُمّ حُبَيْن",
 "agamete": "مشيج لاجنسي (خلية تكاثرية لا جنسية)",
 "agamic": "تَوَالُدِيّ عَذْرِيّ, لَاجِنْسِيّ ((عن التكاثر) لا ينطوي على اندماج خلايا ذكرية وأنثوية)",
 "agamid": "حرذون (سحلية من فصيلة الحرذونيات)",
 "agamid lizard": "حرذون (سحلية من فصيلة الحرذونيات)",
 "agammaglobulinemia": "اللامناعية, فقد غاما غلوبولين الدم (اضطراب مناعي نادر يتميز بالغياب الفعلي لغاما غلوبولين في الدم وما يترتب عليه من القابلية للعدوى)",
 "agamogenesis": "تكاثر لاجنسي (التكاثر دون اندماج الأمشاج)",
 "agamogenetic": "تَوَالُدِيّ عَذْرِيّ, لَاجِنْسِيّ ((عن التكاثر) لا ينطوي على اندماج خلايا ذكرية وأنثوية)",
 "agamous": "تَوَالُدِيّ عَذْرِيّ, لَاجِنْسِيّ ((عن التكاثر) لا ينطوي على اندماج خلايا ذكرية وأنثوية)",
 "agapanthus": "عِشْقِيَّة",
 "agapanthus africanus": "أغابانثوس, زنبق أفريقي (نبات أفريقي بأوراق خضراء زاهية دائمة الخضرة ومظلات من العديد من الزهور البنفسجية الزرقاء العميقة عادة)",
 "agape": "أغابي, وليمة المحبة (وجبة دينية مشتركة كعلامة على الحب والزمالة) / حب غير مشروط, محبة روحية (حب غير أناني لشخص آخر دون دلالات جنسية (خاصة الحب ذو الطبيعة الروحية)) / محبة إلهية ((في اللاهوت المسيحي) محبة الله أو المسيح للبشرية)",
 "agape love": "حب غير مشروط, محبة روحية (حب غير أناني لشخص آخر دون دلالات جنسية (خاصة الحب ذو الطبيعة الروحية))",
 "agar": "أغار, أغار أغار (مستخلص غرواني من الطحالب؛ يستخدم خاصة في أوساط الاستنبات وكعامل تبلور في الأطعمة) / آغار, أجار مغذ (أي وسط استنبات يستخدم الآغار كعامل هلامي)",
 "agar-agar": "أغار, أغار أغار (مستخلص غرواني من الطحالب؛ يستخدم خاصة في أوساط الاستنبات وكعامل تبلور في الأطعمة)",
 "agaric": "غاريقون (فطر رمي من رتبة الغاريقونيات له قبعة تشبه المظلة مع خياشيم على الجانب السفلي) / غاريقون النار (فطر يستخدم في تحضير مادة لإشعال الصمامات)",
 "agaricus arvensis": "فطر الحصان (فطر خشن صالح للأكل بساق مجوفة وقبعة بيضاء عريضة)",
 "agaricus campestris": "فطر الحقل, فطر المروج (فطر شائع صالح للأكل يوجد طبيعياً في التربة المفتوحة الرطبة؛ الفطر المزروع تجارياً)",
 "agartha": "أَغَارَثَا",
 "agarwood": "عُود, رَنْد (قطعة من الخشب كالعصا جمعه عيدان؛ ما يُتَبَخَّر به)\nمثال: أشعلت عود ثقاب.",
 "agastache foeniculum": "أجاستاش, زوفا اليانسون (عشب أمريكي شمالي كثير التفرع برائحة تشبه الشمر)",
 "agastache mexicana": "زوفا مكسيكية (نبات معمر منتصب من المكسيك له زهور وردية إلى قرمزية)",
 "agastache nepetoides": "أجاستاش, زوفا عملاقة صفراء (نبات معمر منتصب بسيقان قوية وزهور صفراء مخضرة؛ جنوب كندا وجنوب شرق الولايات المتحدة)",
 "agate": "عقيق",
 "agate line": "خط, خط أغات (مساحة لسطر واحد من الطباعة (بعرض عمود واحد وعمق 1/14 بوصة) تُستخدم لقياس الإعلانات)",
 "agateware": "خزف عقيقي (فخار معرق ومبقع ليشبه العقيق)",
 "agathis alba": "صنوبر أمبوينا (موطنها جزر الملوك والفلبين؛ مصدر لراتنج الدامار)",
 "agathis australis": "كاوري (شجرة خشب طويلة من نيوزيلندا لها خشب أبيض مستقيم الحبيبات)",
 "agathis dammara": "صنوبر أمبوينا (موطنها جزر الملوك والفلبين؛ مصدر لراتنج الدامار)",
 "agathis lanceolata": "كاوري أحمر (شجرة نيوزيلندية بأوراق لامعة ولحاء بني محمر حرشفي)",
 "agathis robusta": "كاوري كوينزلاند (شجرة خشب أسترالية تشبه الكاوري ولكن خشبها أخف وزناً وأكثر ليونة بكثير)",
 "agave": "أغاف, ألوة أمريكية (نباتات أمريكية استوائية ذات وريدات قاعدية من أوراق ليفية تشبه السيف وأزهار في سنابل طويلة؛ يزرع بعضها للزينة أو للألياف)",
 "agave americana": "أغاف أمريكي, صبار أمريكي (نبات أمريكي أحادي الإثمار يزرع على نطاق واسع بأزهار بيضاء مخضرة على ساق طويل؛ يزهر فقط بعد عشر إلى عشرين سنة ثم يموت)",
 "agave atrovirens": "ماغوي (نبات مكسيكي يستخدم خاصة لصنع البولكي وهو مصدر لمشروب المسكال المكسيكي عديم اللون)",
 "agave cantala": "كانتالا, ماغوي (نبات فلبيني ينتج أليافاً صلبة تستخدم في صنع الخيوط الخشنة)",
 "agave sisalana": "سيزال (نبات مكسيكي أو من جزر الهند الغربية بأوراق لحمية كبيرة تنتج أليافاً صلبة تستخدم على سبيل المثال في الحبال)",
 "agave tequilana": "أغاف التكيلا (نبات مكسيكي يستخدم خاصة لصنع التكيلا)",
 "agaze": "شَاخِص, مُحَمْلِق ((يوصف به العينان) مفتوحتان وجامدتان كما في حالة خوف أو دهشة)",
 "age": "عُمْر ((في الإسلام) أبو حفص عمر بن الخطاب العدوي القرشي، ثاني الخلفاء الراشدين في المذهب السني) / سِنّ ((سَنَّ) السِّكِّينَ و نحْوَهُ يَسُنُّ سَنًّا: أَحَدَّهُ؛ فهو مسنون وسَنِين)\nمثال: جون في عمر أخي.",
 "age bracket": "شريحة عمرية, فئة عمرية (مجموعة من الناس لديهم نفس العمر تقريباً)",
 "age class": "فئة عمرية (أشخاص في نفس النطاق العمري)",
 "age group": "شريحة عمرية, فئة عمرية (مجموعة من الناس لديهم نفس العمر تقريباً)",
 "age limit": "حَدّ السِّنّ, شَرْط السِّنّ (لائحة تحدد الحد الأقصى (أو الأدنى) للسن للقيام بشيء ما أو شغل منصب ما)",
 "age norm": "المعيار العمري (متوسط العمر الذي يُتوقع فيه ظهور أداء معين)",
 "age of consent": "سن الرشد القانوني, سن الموافقة (الحد الأدنى للسن للزواج دون موافقة الوالدين أو الحد الأدنى للسن للعلاقات الجنسية بالتراضي)",
 "age of enlightenment": "عَصْر اَلتَّنْوِير (مصدر للفعل \"عَصَرَ\"؛ أي مدة زمنية، دهر من الوقت)\nمثال: صلى زيري العصر.",
 "age of majority": "سِنّ الرُّشْد ((سَنَّ) السِّكِّينَ و نحْوَهُ يَسُنُّ سَنًّا: أَحَدَّهُ؛ فهو مسنون وسَنِين)\nمثال: هم في نفس السن.",
 "age-old": "أَزَلِيّ, مُوغِل فِي القِدَم (ينتمي إلى أزمنة غابرة أو يمتدّ منها)",
 "age-related": "مُرْتَبِطٌ بِالْعُمْرِ (يتغير (زيادة أو نقصاناً) مع تقدم عمر الفرد)",
 "age-related macular degeneration": "تنكس بقعي مرتبط بالعمر (تنكس بقعي مرتبط بالتقدم في العمر)",
 "aged": "مُعَتَّق ((عَنِ التَّبْغ) مُعَتَّق كَعَمَلِيَّة حِفْظ) / مُعَتَّق, نَاضِج (بلغ الحالة المرغوبة أو النهائية (للنبيذ أو الفاكهة أو الجبن)) / طَاعِن فِي السِّنّ, مُسِنّ (متقدّم في العمر) / مُتَآكِل, هَرِم (فِي مَرْحَلَةٍ مُتَقَدِّمَةٍ مِنَ التَّعْرِيَةِ)",
 "agedness": "شيخوخة, هرم (الخاصية المميزة للشيخوخة)",
 "ageing": "آخِذ فِي الشَّيْخُوخَة, شَائِخ (في طور التقدّم في السنّ والشيخوخة) / تقدم في السن, شيخوخة (العملية العضوية للتقدم في العمر وظهور آثار زيادة السن) / تعتق, نضج (اكتساب صفات مرغوبة عن طريق ترك الشيء دون إزعاج لبعض الوقت)",
 "ageism": "تمييز عمري (التمييز على أساس عمر الشخص)",
 "agelaius phoeniceus": "شحرور أحمر الجناح (شحرور من أمريكا الشمالية ذو بقع قرمزية على الأجنحة)",
 "ageless": "أَبَدِيّ, أَزَلِيّ (مستمرّ إلى الأبد أو إلى أجل غير مُسمًّى)",
 "agelessness": "خُلُود, دَيْمُومَة الشَّبَاب (صفة كون الشيء خالداً وأبدياً)",
 "agelong": "أَبَدِيّ, سَرْمَدِيّ (يَدوم طَوالَ الزَّمَن كُلِّه)",
 "agency": "فَاعِلِيَّة / وِكَالَة / وَكَالَة / دَائِرَة (في : الشكل الهندسي الذي ليس له نقطة بداية ولا نهاية ويتكون من قَوْس مستمر؛ الهيئة أو الجهة التي تدير امرا ما)\nمثال: رجاء ضع دائرة حول الجواب الصحيح.",
 "agency security": "ورقة مالية حكومية (ورقة مالية تصدرها وكالات حكومة الولايات المتحدة أو نظام الائتمان الزراعي)",
 "agenda": "جَدْوَل, جَدْوَل أَعْمَال / جَدْوَل, جَدْوَلَ أَعْمَال / جَدْوَل, أَجَنْدَة",
 "agenda item": "بند جدول الأعمال (أحد البنود التي سيتم النظر فيها)",
 "agender": "لَاجَنْدَرِيّ",
 "agendum": "جدول أعمال (قائمة بالمسائل التي سيتم تناولها (كما في اجتماع))",
 "agene": "ثلاثي كلوريد النيتروجين (زيت متطاير أصفر نفاذ كان يستخدم سابقاً لتبييض الدقيق وتعتيقه)",
 "agenesia": "غياب التخلق, لاتكون (تطور غير كامل؛ عدم تطور جزء ما)",
 "agenesis": "غياب التخلق, لاتكون (تطور غير كامل؛ عدم تطور جزء ما)",
 "agent": "فَاعِل (الشيء :فعله)\nمثال: تظن الشرطة أن سامي يعلم من الفاعل.",
 "agent bank": "بنك وكيل (بنك يعمل كوكيل لبنك أجنبي) / بنك قائد, بنك مدير (بنك يتم تسميته من قبل نقابة إقراض تضم عدة بنوك لحماية مصالحهم)",
 "agent noun": "اسم الفاعل (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)\nمثال: ما اسم حصان توم؟",
 "agent orange": "العامل البرتقالي (مبيد أعشاب استخدم في حرب فيتنام لإزالة أوراق الغابات)",
 "agent provocateur": "مُبَلِّغ مُشَارِك",
 "agent-based model": "نموذج قائم على الوكيل (فئة من النماذج الحسابية لمحاكاة أفعال وتفاعلات الوكلاء المستقلين (أفراداً أو كيانات جماعية) لتقييم آثارهم على النظام ككل)\nمثال: استخدمت النماذج القائمة على الوكيل منذ منتصف التسعينيات لحل مجموعة متنوعة من المشكلات التجارية والتقنية",
 "agent-in-place": "عميل مزروع (عميل يعمل كاختراق داخل هدف استخباراتي)",
 "agential": "فاعلي, وكيلي (من أو متعلق بوكيل أو وكالة)",
 "agentive role": "الفاعل, الوكيل (الدور الدلالي للكيان الحي الذي يحرض أو يسبب الحدث الذي يدل عليه الفعل)",
 "agerasia": "مظهر الشباب في الكبر (المظهر الشاب لشخص مسن)",
 "ageratina altissima": "أغراتينا, جذر الثعبان الأبيض",
 "ageratum": "أجيراتوم, نبتة النجوم (أي نبات من جنس أجيراتوم له أوراق متقابلة ورؤوس صغيرة من الزهور الزرقاء أو البيضاء) / أجيراتوم, زهرة الضباب (نبات جذموري من وسط وجنوب شرق الولايات المتحدة وجزر الهند الغربية له رؤوس كبيرة مبهرجة من الزهور الزرقاء الصافية)",
 "ageratum houstonianum": "أجيراتوم شائع, نبات المعز (عشبة صغيرة رقيقة تزرع لزهورها الزرقاء إلى الخزامية الرقيقة التي تشبه الفرشاة)",
 "agglomerate": "مُتَجَمِّع, مُتَكَتِّل (متجمع معاً لكن دون تماسك) / ركام, كدس (مجموعة من الأشياء مكدسة فوق بعضها البعض) / تكتل بركاني (صخر بركاني يتكون من شظايا كبيرة منصهرة معاً)",
 "agglomerated": "مُتَجَمِّع, مُتَكَتِّل (متجمع معاً لكن دون تماسك)",
 "agglomeration": "تجميع كتلي, تكتل (فعل الجمع في كتلة) / تكتل, تكدس (مجموعة أو كتلة مختلطة بشكل عشوائي)",
 "agglomerative": "مُتَجَمِّع, مُتَكَتِّل (متجمع معاً لكن دون تماسك)",
 "agglomerator": "جهاز تكتيل, مُكتِّل (جهاز يتسبب في تجمع المواد وتكتلها في كرات مستديرة)\nمثال: مكتل صوتي",
 "agglutinate": "مُتَرَاصّ, مُلْتَحِم (ملتصق ببعضه كأنّه بالغراء)",
 "agglutinating activity": "تراص, تلازن (التحام الجزيئات الصغيرة العالقة في محلول؛ مما يؤدي عادة إلى ترسب هذه الكتل الأكبر)",
 "agglutination": "إلصاق (بناء الكلمات من المورفيمات المكونة التي تحتفظ بشكلها ومعناها في عملية الجمع) / تراص, تلازن (تكتل البكتيريا أو الخلايا الحمراء عند ربطها معًا بواسطة الأجسام المضادة (الراصات)) / تراص, تلازن (التحام الجزيئات الصغيرة العالقة في محلول؛ مما يؤدي عادة إلى ترسب هذه الكتل الأكبر)",
 "agglutination test": "اختبار تراص (فحص دم يستخدم لتحديد المستضدات غير المعروفة)",
 "agglutinative": "إِلْصَاقِيّ",
 "agglutinative language": "لغة إلصاقية (لغة تتكون فيها الكلمات من تسلسل خطي من المورفيمات المتميزة، ويمثل كل مكون من مكونات المعنى بمورفيم خاص به)\nمثال: تميل اللغات الإلصاقية إلى امتلاك معدل مرتفع من اللواحق/المورفيمات لكل كلمة، وتكون منتظمة جداً",
 "agglutinin": "راصة (جسم مضاد يسبب تراص مستضد معين)",
 "agglutinogen": "مستضد ملزن, مولد التلزن (أي مادة تعمل كمستضد لتسبب إنتاج الراصة (الأجسام المضادة الملزنة))",
 "aggrandisement": "ترقية, تعظيم (عملية زيادة ثروة أو هيبة أو قوة أو نطاق شيء ما)\nمثال: تعظيم الملك",
 "aggrandizement": "ترقية, تعظيم (عملية زيادة ثروة أو هيبة أو قوة أو نطاق شيء ما)\nمثال: تعظيم الملك",
 "aggravated": "مُسْتَثَار, مُسْتَفَزّ (أُثير غضبه عمدًا؛ مُحتَدّ بفعل استفزاز مقصود) / مُشَدَّد, مُفَاقَم (جُعِلَ أَشَدَّ أَوْ أَكْثَرَ حِدَّةً خَاصَّةً فِي القَانُون)",
 "aggravated assault": "اعتداء مشدد (هجوم متهور بقصد الإصابة الخطيرة (كما هو الحال بسلاح مميت))",
 "aggravating": "مُتَفَاقِم, مُفَاقِم (يجعل الأمر أسوأ؛ يزيد من حدته)",
 "aggravatingly": "بشكل مستفز, بشكل يثير الغضب (بطريقة مثيرة للاستياء)\nمثال: علق شعره بشكل مستفز في أغصان الشجرة",
 "aggravation": "استفحال, تفاقم (إجراء يجعل المشكلة أو المرض (أو أعراضه) أسوأ) / إغاظة, استفزاز (سلوك غير ودي يسبب الغضب أو الاستياء) / تفاقم, حنق (شعور ساخط بالانزعاج)\nمثال: نتج تفاقم حالتها عن نقص الرعاية",
 "aggravator": "شخص مزعج, مصدر إزعاج (شخص بغيض يسبب الضيق أو الغضب)",
 "aggregate": "إِجْمَالِيّ, مَجْمُوع / سْكَانْدَا",
 "aggregate demand": "طلب عالمي, طلب كلي (في الاقتصاد الكلي، إجمالي الطلب على السلع والخدمات النهائية في الاقتصاد في وقت ومستوى سعر معينين)",
 "aggregate fruit": "ثمرة متجمعة (فاكهة تتكون من العديد من الفواكه الصغيرة الفردية أو النواة المشتقة من مبايض منفصلة داخل وعاء مشترك: مثل التوت الأسود والتوت الأحمر والأناناس)",
 "aggregated": "إِجْمَالِيّ, تَجْمِيعِيّ (مكوّن من وحدات منفصلة جُمعت في كتلة أو كلّ واحد)",
 "aggregation": "تجميع, جمع (فعل جمع شيء ما معاً) / تجميع, تشكيلة (أشياء عديدة مجمعة معًا أو تعتبر ككل)",
 "aggregative": "إِجْمَالِيّ, تَجْمِيعِيّ (مكوّن من وحدات منفصلة جُمعت في كتلة أو كلّ واحد)",
 "aggregator": "جامع, مُجَمِّع (شخص يجمع الأشياء)",
