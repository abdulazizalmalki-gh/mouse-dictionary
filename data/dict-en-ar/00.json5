 "adesite": "أنديزيت (صخر بركاني رمادي داكن)",
 "adh": "الهرمون المضاد لإدرار البول, فازوبريسين (هرمون تفرزه الغدة النخامية الخلفية؛ يؤثر على ضغط الدم ويقلل تدفق البول)",
 "adhan": "أَذَان",
 "adhd": "اضطراب فرط الحركة ونقص الانتباه, اضطراب نقص الانتباه (حالة (تغلب عند الأولاد) تتميز باضطرابات سلوكية وصعوبات في التعلم)",
 "adherence": "التزام, تمسك (الدعم المخلص لقضية أو حزب سياسي أو دين) / التصاق, تلاصق (خاصية الالتصاق معاً (كالغراء والخشب) أو انضمام أسطح مختلفة التكوين)\nمثال: الالتزام بأجندة رسمية",
 "adherent": "لَاصِق, مُلْتَصِق (ملتصق بإحكام) / تابِع, تِلْمِيذ (شخص يؤمن بمذهب شخص آخر ويساعد في نشره)",
 "adhesion": "اِلْتِصَاق",
 "adhesion contract": "عقد إذعان (عقد يقيد بشدة أحد الطرفين بينما يترك الآخر حراً (مثل بعض العقود المطبوعة ذات النموذج القياسي)؛ ينطوي على عدم المساواة في القوة التفاوضية)",
 "adhesive": "لَاصِق, مُلْتَصِق (يميل إلى الالتصاق) / مادة لاصقة (مادة توحد أو تربط الأسطح ببعضها البعض)",
 "adhesive agent": "مادة لاصقة (مادة توحد أو تربط الأسطح ببعضها البعض)",
 "adhesive bandage": "ضمادة لاصقة (ضمادة تتكون من قطعة شاش ماص مثبتة بشريط بلاستيكي أو قماشي مطلي بمادة لاصقة)",
 "adhesive friction": "تماسك, ثبات (الاحتكاك بين جسم والسطح الذي يتحرك عليه (كما بين إطار السيارة والطريق))",
 "adhesive material": "مادة لاصقة (مادة توحد أو تربط الأسطح ببعضها البعض)",
 "adhesive plaster": "بلاستر, لاصق طبي (شريط لاصق يستخدم في تضميد الجروح)",
 "adhesive tape": "شَرِيط لَاصِق",
 "adhesiveness": "التصاق, تلاصق (خاصية الالتصاق معاً (كالغراء والخشب) أو انضمام أسطح مختلفة التكوين)\nمثال: الالتصاق المتبادل للخلايا",
 "adhocracy": "أدهوقراطية, تنظيم مرن (منظمة ذات هيكلية قليلة أو معدومة تعتمد على المرونة بدلاً من القواعد الصارمة)\nمثال: يمثل الاختيار بين البيروقراطية والأدهوقراطية معضلة شائعة",
 "adiabatic": "أديباتي, كظيم للحرارة (يحدث دون فقدان أو اكتساب للحرارة)\nمثال: تمدد أديباتي",
 "adiabatic index": "نِسْبَة السِّعَة الحَرَارِيَّة (نسبة السعة الحرارية عند ضغط ثابت إلى السعة الحرارية عند حجم ثابت)",
 "adiabatic process": "عملية أديباتية, عملية كظمية ((في الديناميكا الحرارية) أي عملية تحدث دون اكتساب أو فقدان للحرارة)",
 "adiabaticity": "عدم تبادل حراري, كظمية (حالة الحدوث دون كسب أو فقدان للحرارة (وبالتالي دون تغيير في الإنتروبيا، في التقريب شبه الثابت))\nمثال: الهدف من هذه المقالة هو دراسة كظمية عملية التدرج لثنائي قطب تيار متردد كدالة للمعاملات المختلفة المعنية",
 "adiantum bellum": "كزبرة البئر البرمودية (سرخس برمودي متوطن رقيق بجذمور زاحف)",
 "adiantum capillus-veneris": "شعر الزهرة, كزبرة البئر (سرخس كزبرة البئر الرقيق بسيقان أوراق سوداء لامعة رفيعة؛ عالمي الانتشار)",
 "adiantum pedatum": "كزبرة البئر الأمريكية, كزبرة البئر خماسية الأصابع (سرخس أمريكي شمالي قوي التحمل متفرع راحياً بفروع منحنية متباعدة محمولة على سويقات حمراء داكنة لامعة)",
 "adiantum tenerum": "كزبرة البئر الهشة (سرخس أمريكي استوائي بوريقات عريضة؛ يزرع على نطاق واسع)",
 "adiantum tenerum farleyense": "كزبرة البئر باربادوس, كزبرة البئر فارلي (سمي نسبة لمنزل ريفي في باربادوس حيث اكتشف)",
 "adiaphoron": "لا مبالى به ((الفلسفة الرواقية) أمر ليس له فضل أخلاقي ولا رذيلة) / أديافورون, أمر لا شرعي ولا ممنوع (طقس ديني يُعتبر مسألة ضمير فردي لأنه ليس محظوراً ولا مفروضاً في الكتب المقدسة)",
 "adience": "إقبال, نزوع للاقتراب ((علم النفس) رغبة ملحة في قبول أو الاقتراب من موقف أو شيء ما)",
