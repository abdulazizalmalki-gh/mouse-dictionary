 "acoustic delay line": "خط تأخير صوتي (خط تأخير يعتمد على وقت انتشار الموجات الصوتية)",
 "acoustic device": "جهاز صوتي (جهاز لتضخيم الصوت أو نقله)",
 "acoustic gramophone": "جرامافون, حاكي (مشغل أسطوانات قديم؛ يتم تضخيم صوت الإبرة المهتزة صوتياً)",
 "acoustic guitar": "غِيتَار صَوْتِيّ",
 "acoustic impedance": "مقاومة صوتية, ممانعة صوتية (ممانعة لتدفق الصوت عبر سطح؛ المقاومة الصوتية هي المكون الحقيقي للممانعة الصوتية والمفاعلة الصوتية هي المكون التخيلي)",
 "acoustic meatus": "صماخ سمعي, قناة الأذن (أي من الممرين في الأذن الخارجية من الصيوان إلى غشاء الطبل)",
 "acoustic modem": "مودم صوتي (مودم يحول الإشارات الكهربائية إلى نغمات هاتفية والعكس)",
 "acoustic nerve": "عصب دهليزي قوقعي, عصب سمعي (عصب حسي مركب يغذي الخلايا الشعرية للعضو الدهليزي والخلايا الشعرية للقوقعة)",
 "acoustic phenomenon": "ظاهرة صوتية (ظاهرة فيزيائية مرتبطة بإنتاج الصوت أو انتقاله)",
 "acoustic power": "قدرة صوتية, مستوى ضغط الصوت (الشدة الفيزيائية للصوت)",
 "acoustic projection": "إسقاط صوتي, إيصال الصوت (الظاهرة الصوتية التي تعطي الصوت جودة اختراقية)\nمثال: صُممت آلات القيثارة الخاصة بنا لتتمتع بصوت وإسقاط صوتي فائق",
 "acoustic radiation pressure": "ضغط الإشعاع الصوتي ((في الصوتيات) الضغط الممارس على سطح عمودي على اتجاه انتشار الموجة الصوتية)",
 "acoustic reactance": "مقاومة صوتية, ممانعة صوتية (ممانعة لتدفق الصوت عبر سطح؛ المقاومة الصوتية هي المكون الحقيقي للممانعة الصوتية والمفاعلة الصوتية هي المكون التخيلي)",
 "acoustic resistance": "مقاومة صوتية, ممانعة صوتية (ممانعة لتدفق الصوت عبر سطح؛ المقاومة الصوتية هي المكون الحقيقي للممانعة الصوتية والمفاعلة الصوتية هي المكون التخيلي)",
 "acoustic spectrum": "طيف صوتي (توزيع الطاقة كدالة للتردد لمصدر صوت معين)",
 "acoustic storage": "تخزين صوتي (جهاز تخزين يتكون من خطوط تأخير صوتية)",
 "acoustic wave": "موجة صوتية ((في الصوتيات) موجة تنقل الصوت)",
 "acoustic waveguide": "موجه موجي صوتي (هيكل مادي لتوجيه الموجات الصوتية)",
 "acoustical": "أكوستيكي, سمعي (متعلق بعلم الصوتيات)\nمثال: خصائص سمعية للقاعة",
 "acoustically": "سمعياً, صوتياً (فيما يتعلق بالصوتيات (فيزياء الصوت))\nمثال: استوديوهات مجهزة بشكل سيء صوتياً",
 "acoustician": "عالم صوتيات (فيزيائي يتخصص في الصوتيات)",
 "acousticophobia": "رهاب الأصوات (خوف مرضي من الأصوات بما في ذلك صوت الشخص نفسه)",
 "acoustics": "علم الصوتيات (دراسة الخصائص الفيزيائية للصوت)",
 "acqua alta": "أَكّْوَا أَلْتَا",
 "acquaintance": "مَعْرِفَة (مصدر من الفعل عَرَفَ؛ ضد الجهل؛ إدراك الشيء بحقيقته والوعي، ضد الجهل بالشيء)\nمثال: نريد معرفة السبب.",
 "acquaintanceship": "علاقة معرفة, معرفة (علاقة أقل حميمية من الصداقة)",
 "acquiesce": "يَرْكَن",
 "acquiescence": "إذعان, قبول (الموافقة على بيان أو اقتراح للقيام بشيء ما) / إذعان, رضوخ (القبول دون احتجاج)\nمثال: أبدى موافقته بحماس",
 "acquiescent": "طَيِّع, مُذْعِن (مستعدّ لتنفيذ أوامر أو رغبات الآخرين دون اعتراض)",
 "acquirable": "قَابِل لِلاقْتِنَاء (يمكن اقتناؤه والحصول عليه)",
 "acquire": "حَصَلَ (الشيء: حَصَلَ عليه؛ العلم: أخَذَه وحَازَه) / اِكْتَسَبَ, كَسَبَ\nمثال: متى حصل الحادث؟",
 "acquired": "مُكْتَسَب",
 "acquired characteristic": "صِفَة مُكْتَسَبَة (صُفَّة المَسْجِد هي موضع مُظَلَّل منه بين جدران ثلاثة؛ هي غُرْفَة ذات ثلاث جُدْرَان وسَقْف والإتجاه الرابع مَفْتُوح بلا بِنَاء. تستخدم غالبا للجلوس وتواجه صَحْن البَيْت)\nمثال: محاسبة النفس صفة حميدة.",
 "acquired hemochromatosis": "داء ترسب الأصبغة الدموية المكتسب (داء ترسب الأصبغة الدموية الناتج عن عمليات نقل الدم المتكررة أو الإفراط في تناول الأطعمة المحتوية على الحديد)",
 "acquired immune deficiency syndrome": "إيدز, متلازمة نقص المناعة المكتسب (مرض خطير (غالباً ما يكون قاتلاً) يصيب الجهاز المناعي وينتقل عن طريق منتجات الدم وخاصة عن طريق الاتصال الجنسي أو الإبر الملوثة)",
 "acquired immunity": "مناعة مكتسبة (مناعة ضد مرض معين ليست فطرية ولكن تم اكتسابها خلال الحياة)",
 "acquired immunodeficiency syndrome": "مُتَلَازِمَة نَقْص المَنَاعَة المُكْتَسَب",
 "acquired reflex": "منعكس شرطي, منعكس مكتسب (استجابة مكتسبة تخضع لسيطرة (مشروطة بحدوث) محفز)",
 "acquired taste": "ذوق مكتسب (تفضيل لا يتم اكتسابه إلا بعد تجربة كبيرة)\nمثال: المارتيني ذوق مكتسب",
 "acquirement": "إنجاز, اكتساب (قدرة تم اكتسابها عن طريق التدريب)",
 "acquirer": "بنك تجاري, بنك مكتسب (بنك يعالج بطاقات الائتمان؛ حيث يتلقى التجار ائتمانًا لإيصالات بطاقات الائتمان مخصومًا منها رسوم المعالجة) / بنك مكتسب, جهة مكتسبة (المؤسسة المالية التي تصرف النقود في أجهزة الصراف الآلي وتحصل رسوماً من البنك الذي أصدر بطاقة الائتمان) / شركة مستحوذة, مستحوذ (شركة تحصل على سيطرة مالية على شركة أخرى أو مؤسسة مالية من خلال الدفع نقداً أو تبادل الأسهم) / مقتنٍ, مكتسب (شخص يكتسب شيئاً (عادة بشكل دائم))",
 "acquiring": "اكتساب, حصول (فعل الحصول على شيء ما)\nمثال: حسدت موهبته في الاكتساب",
 "acquisition": "اِكْتِسَاب",
 "acquisition agreement": "اتفاقية استحواذ, اتفاقية اندماج (عقد يحكم اندماج شركتين أو أكثر)",
 "acquisitive": "كَسُوب, مُحِبّ لِلاِقْتِنَاء (حريص على اكتساب وامتلاك الأشياء خاصة الممتلكات المادية أو الأفكار)\nمثال: عقل محب للاكتساب",
 "acquisitiveness": "ح حب الاكتساب (رغبة قوية في الاكتساب والامتلاك)",
 "acquittal": "تَبْرِئَة",
 "acquittance": "إبراء ذمة, مخالصة (وثيقة قانونية تثبت إبراء الذمة من دين أو التزام)",
 "acquitted": "بَرِيءٌ بِحُكْمِ الْقَضَاء (صدر حكم ببراءته من تهمة محددة؛ غير مُدان قانونيًّا)",
 "acre": "آكِر",
 "acre inch": "بوصة فدان (واحد من اثني عشر من قدم الفدان)",
 "acre-foot": "قدم فدان (حجم الماء الذي يغطي فداناً واحداً بعمق قدم واحد)",
 "acreage": "رقعة أرض, مساحة أرض (مساحة من الأرض تستخدم لغرض معين (مثل البناء أو الزراعة))\nمثال: أراد بعض المساحة من الأرض للبناء عليها",
 "acres": "إقطاعية, ضيعة (ممتلكات واسعة من الأراضي (خاصة في الريف) يحتفظ بها المالك لاستخدامه الخاص)\nمثال: كانت العائلة تمتلك ضيعة كبيرة في لونغ آيلاند",
 "acrid": "حَارِق, لَاذِع (قاسٍ أو كاوٍ في اللهجة) / حِرِّيف, نَفَّاذ (قَوِيٌّ وَحَادُّ الطَّعْمِ أَوِ الرَّائِحَة)",
 "acridid": "جندب قصير القرون (جندب ذو قرون استشعار قصيرة)",
 "acridity": "حِدَّة, لَذْعَة (صفة كون اللغة أو النبرة كريهة بشكل حاد ولاذع) / حرافة, مرارة حارقة (مرارة شديدة) / حدة الرائحة, نفاذة (امتلاك رائحة لاذعة أو حادة)\nمثال: حرافة القلوي",
 "acridness": "حِدَّة, لَذْعَة (صفة كون اللغة أو النبرة كريهة بشكل حاد ولاذع) / حرافة, مرارة حارقة (مرارة شديدة)\nمثال: حرافة القلوي",
 "acridotheres tristis": "مينة متوجة (طائر متوج بني داكن من جنوب شرق آسيا)",
 "acrilan": "أكريلان, بولي بروبينونتريل (راتنج أكريليك يُستخدم لصنع نسيج قوي وناعم مقاوم للتجعد)",
 "acrimonious": "حَادّ, لَاذِع (يتّسم بالاستياء الشديد أو السخرية المريرة)",
 "acrimony": "حدة, ضغينة (أبوب خشن ومرير)",
 "acris crepitans": "ضفدع الصرصور الشمالي (ضفدع صرصور من شرق ووسط الولايات المتحدة)",
 "acris gryllus": "ضفدع الصرصور الشرقي (ضفدع صرصور من شرق الولايات المتحدة)",
 "acritical": "بِلَا أَزْمَة (بدون أزمة (كما في بعض الأمراض))",
 "acroanaesthesia": "تخدير الأطراف (فقدان الإحساس في الأطراف)",
 "acroanesthesia": "تخدير الأطراف (فقدان الإحساس في الأطراف)",
 "acrobat": "بَهْلَوَان",
 "acrobatic": "بَهْلَوَانِيّ, رِيَاضِيّ (نشيط بقوّة وحيويّة)",
 "acrobatic feat": "حركة بهلوانية (حيلة أو حركة يؤديها لاعب بهلوان)",
 "acrobatic stunt": "حركة بهلوانية (حيلة أو حركة يؤديها لاعب بهلوان)",
 "acrobatics": "بِهْلَوَانِيَّات",
 "acrocarp": "حزاز قمي الثمار (حزاز ينتهي محوره الرئيسي بالأرشيجونة (وبالتالي الكبسولة))",
 "acrocarpous": "قمي الثمار ((للحزازيات) وجود الأرشيجونة (عضو التأنيث) في قمة الساق)",
 "acrocarpous moss": "حزاز قمي الثمار (حزاز ينتهي محوره الرئيسي بالأرشيجونة (وبالتالي الكبسولة))",
 "acrocarpus fraxinifolius": "شجرة الألواح الخشبية (شجرة خشبية من شرق الهند ذات خشب متين صلب يستخدم خاصة لصناديق الشاي)",
 "acrocentric": "طرفي المركز (لديه سنترومير شبه طرفي)\nمثال: كروموسوم طرفي المركز",
 "acrocentric chromosome": "كْرُومُوسُوم طَرَفِيّ المَرْكَز (كروموسوم يكون السنترومير فيه قريباً من أحد الطرفين بحيث يكون أحد ذراعي الكروموسوم قصيراً والآخر طويلاً)",
 "acrocephalus schoenobaenus": "هزاز السعد (هازجة أوروبية صغيرة تتكاثر بين القصب والسعد وتشتي في أفريقيا)",
 "acrocephaly": "رأس سنامي, رأس مروّس (شذوذ خلقي في الجمجمة؛ يتخذ الجزء العلوي من الجمجمة شكلاً مخروطياً)",
 "acroclinium roseum": "أقحوان ورقي وردي (زهرة من جنوب غرب أستراليا لها زهور ورقية وردية زاهية تشبه الأقحوان؛ تزرع للتجفيف)",
 "acrocomia aculeata": "ماكامبا, نخيل غروغرو (نخيل ريشي استوائي أمريكي له جذع شائك منتفخ ومكسرات صالحة للأكل)",
 "acrocomia vinifera": "نخيل كويول (نخيل استوائي أمريكي له مكسرات صالحة للأكل وينتج أليافاً مفيدة)",
 "acrocyanosis": "زرقة الأطراف, علامة رينود (زرقة الأطراف؛ يمكن أن تحدث عندما يحدث تشنج في الأوعية الدموية بسبب التعرض للبرد أو انفعال قوي)",
 "acrodont": "قمي الأسنان (حيوان له أسنان ملتحمة بقمة الحافة السنخية بدون تجاويف)",
 "acrogen": "نبات طرفي النمو (أي نبات لا زهري مثل السرخس (التريديات) أو الحزاز (النباتات الطحلبية) يحدث نموه فقط عند طرف الساق الرئيسية)",
 "acrogenic": "قمي النمو (متعلق بالنباتات اللازهرية (مثل السرخسيات أو الطحالب) التي يحدث فيها النمو فقط عند قمة الساق الرئيسية)",
 "acrogenous": "قمي النمو (متعلق بالنباتات اللازهرية (مثل السرخسيات أو الطحالب) التي يحدث فيها النمو فقط عند قمة الساق الرئيسية)",
 "acrolein": "أكرولين, بروبينال (ألديهيد سائل غير مشبع لاذع عديم اللون يصنع من البروبين)",
 "acromegalia": "ضخامة النهايات (تضخم عظام اليدين والقدمين والوجه؛ غالباً ما يكون مصحوباً بصداع وآلام في العضلات واضطرابات عاطفية؛ ناتج عن الإفراط في إنتاج هرمون النمو من الفص…)",
 "acromegalic": "ضَخَامِيّ الأَطْرَاف (يتّسم بتضخّم أو فرط نموّ الأطراف)",
 "acromegaly": "ضخامة النهايات (تضخم عظام اليدين والقدمين والوجه؛ غالباً ما يكون مصحوباً بصداع وآلام في العضلات واضطرابات عاطفية؛ ناتج عن الإفراط في إنتاج هرمون النمو من الفص…)",
 "acromial process": "أخرم, نتوء أخرمي (النقطة الخارجية القصوى لشوكة لوح الكتف)",
 "acromicria": "صغر الأطراف (صغر الأطراف بشكل غير طبيعي (أصابع اليدين والقدمين غير مكتملة النمو))",
 "acromikria": "صغر الأطراف (صغر الأطراف بشكل غير طبيعي (أصابع اليدين والقدمين غير مكتملة النمو))",
 "acromion": "أخرم, نتوء أخرمي (النقطة الخارجية القصوى لشوكة لوح الكتف)",
 "acromphalus": "بروز السرة (بروز غير طبيعي للسرة؛ أحياناً يكون بداية لفتق سري)",
 "acromyotonia": "تأتر الأطراف (تأتر يقتصر على الأطراف؛ يسبب تشوهاً تشنجياً لليد أو القدم)",
 "acronym": "اِخْتِصَار",
 "acronymic": "اختصاري (يتميز باستخدام الاختصارات (الأوائلية))",
 "acronymous": "اختصاري (يتميز باستخدام الاختصارات (الأوائلية))",
 "acropetal": "قِمِّيّ النُّمُوّ (للأوراق أو الزهور؛ تتطور أو تتفتح بتتابع من القاعدة إلى القمة)",
 "acrophobia": "رهاب المرتفعات (خوف مرضي من المرتفعات الشاهقة)",
 "acrophobic": "رُهَابِيّ المُرْتَفَعَات (يعاني من رهاب المرتفعات؛ خائف بشكل غير طبيعي من الأماكن العالية)",
 "acrophony": "تسمية بالحرف الأول (تسمية حرف من الأبجدية باستخدام كلمة يكون صوتها الأولي هو الصوت الذي يمثله ذلك الحرف)",
 "acropolis": "أكروبوليس (القلعة في المدن اليونانية القديمة)",
 "acroscopic": "قِمِّيّ, مُتَّجِه نَحْو القِمَّة (مُواجه أو على الجانب المتجه نحو القمة)",
 "acrosome": "مُقَدِّمَة الْحَيَوَانِ الْمَنَوِيِّ",
 "across": "عَبْرَ (الشيء: اجتازه وقطعه من طرف إلى الطرف الآخر كاملا؛ الشخص: مات)\nمثال: عبر جرذ الطريق.",
 "across the board": "شامل, على الجميع (يشمل الكل)\nمثال: حصلنا على زيادة في الأجور شملت الجميع",
 "across the country": "على مستوى البلاد, وطنياً (ممتد عبر أمة بأكملها)\nمثال: معلن عنه وطنياً",
 "across the nation": "على مستوى البلاد, وطنياً (ممتد عبر أمة بأكملها)\nمثال: معلن عنه وطنياً",
 "across-the-board": "شَامِل, وَاسِعُ النِّطَاق (واسع في نطاقه أو محتواه؛ يغطّي مجالات عديدة)",
 "acrostic": "قصيدة استهلالية, قصيدة الحروف الأوائل (شعر تشكل فيه أحرف معينة، مثل الحرف الأول في كل سطر، كلمة أو رسالة) / مُرَبَّع الْكَلِمَات (لغز حيث تملأ شبكة مربعة بكلمات تقرأ نفس الشيء رأسياً وأفقياً)",
 "acrostichum aureum": "سرخس جلدي, سرخس ذهبي (سرخس مستنقعات استوائي قوي (خاصة أمريكا الاستوائية) له سعف كبير بأكياس أبواغ صفراء ذهبية تغطي الجوانب السفلية)",
 "acrylamide": "أكريلاميد (أميد بلوري أبيض لحمض البروبينويك يمكن أن يضر بالجهاز العصبي ومسرطن في حيوانات المختبر)",
 "acrylate": "أكريلات, بروبينوات (ملح أو إستر لحمض البروبينويك)",
 "acrylate resin": "أكريليك, راتنج أكريليك (بلاستيك حراري زجاجي؛ يمكن صبه وتشكيله أو استخدامه في الطلاء والمواد اللاصقة)",
 "acrylic": "أكريليك (نسيج صناعي مصنوع من بولي أكريلونيتريل) / أكريليك, طلاء أكريليك (يستخدمه الفنانون بشكل خاص) / أكريليك, راتنج أكريليك (بلاستيك حراري زجاجي؛ يمكن صبه وتشكيله أو استخدامه في الطلاء والمواد اللاصقة) / أكريليك, ألياف أكريليك (مبلمرة من الأكريلونيتريل)",
 "acrylic acid": "حمض الأكريليك, حمض البروبينويك (حمض كربوكسيلي سائل غير مشبع يستخدم في تصنيع راتنجات الأكريليك)",
 "acrylic fiber": "أكريليك, ألياف أكريليك (مبلمرة من الأكريلونيتريل)",
 "acrylic paint": "أكريليك, طلاء أكريليك (يستخدمه الفنانون بشكل خاص)",
 "acrylic resin": "أكريليك, راتنج أكريليك (بلاستيك حراري زجاجي؛ يمكن صبه وتشكيله أو استخدامه في الطلاء والمواد اللاصقة)",
 "acrylonitrile": "أكريلونتريل, سيانيد الفاينيل (نتريل غير مشبع سائل عديم اللون يصنع من البروبين)",
 "acrylonitrile-butadiene-styrene": "أكريلونتريل بوتادين ستايرين, بلاستيك إيه بي إس (فئة من البلاستيك المركب تستخدم لصنع هياكل السيارات وحافظات الحواسيب والأجهزة الأخرى)",
 "act": "عَمَل (فِعْل، صُنْع؛ وسيلة للكسب، مِهْنَة، حِرْفَة) / قَانُون (مقياس كل شيء وطريقه؛ أمر كليّ ينطبق على جميع جزئياته التي تعرف أحكامها منه) / مَثَّلَ (الشَبَه؛ النَظِير) / تَصَرَّفَ\nمثال: المهم هو العمل.",
 "act of god": "قضاء وقدر, قوة قاهرة (كارثة طبيعية لا مفر منها تقطع المسار المتوقع للأحداث)\nمثال: اكتشف أن منزله لم يكن مؤمناً ضد القضاء والقدر",
 "act of terrorism": "إرهاب, عمل إرهابي (الاستخدام المحسوب للعنف (أو التهديد بالعنف) ضد المدنيين من أجل تحقيق أهداف سياسية أو دينية أو أيديولوجية؛ يتم ذلك من خلال الترهيب أو الإكراه أو بث…)",
 "actable": "قابل للتمثيل (يمكن تمثيله؛ مناسب للمسرح)\nمثال: مشهد قابل للتمثيل",
 "actaea alba": "أكتيا بيضاء, توت سام أبيض (عشب من أمريكا الشمالية ذو ثمار لبية بيضاء سامة)",
 "actaea rubra": "أكتيا حمراء, توت سام أحمر (عشب معمر في أمريكا الشمالية بأوراق مركبة وعناقيد من الزهور البيضاء الصغيرة تليها ثمار لبية بيضاوية حمراء زاهية وسامة)",
 "acth": "هرمون موجه لقشر الكظر (هرمون تنتجه الغدة النخامية الأمامية يحفز قشرة الغدة الكظرية)",
 "actias luna": "عثة القمر, عثة لونا (عثة أمريكية كبيرة خضراء شاحبة بأجنحة خلفية طويلة الذيل وعلامة صفراء على شكل هلال على كل جناح أمامي)",
 "actifed": "أكتيفيد (اسم تجاري لدواء يحتوي على مضاد للهيستامين ومزيل للاحتقان؛ يستخدم لعلاج حالات الجهاز التنفسي العلوي والحساسية الخفيفة)",
 "actin": "أكتين (أحد البروتينات التي يمكن أن ينقسم إليها الأكتوميوسين؛ يمكن أن يوجد في شكل كروي أو ليفي)",
 "actinal": "فموي ((للكائنات الشعاعية) يقع على السطح أو الطرف الذي يوجد فيه الفم)",
 "acting": "تَمْثِيل",
 "acting out": "تمثيل انفعالي, تنفيس حركي ((طب نفسي) عرض المشاعر المكبوتة سابقاً (غالباً في أفعال بدلاً من كلمات)؛ يعتبر صحياً وعلاجياً) / تنفيس انفعالي (انفجار اندفاعي وغير قابل للسيطرة (عادة ما يكون مزعجاً) من قبل طفل مضطرب أو شخص بالغ عصابي)",
 "actinia": "أكتينيا (أي شقائق نعمان بحرية أو حيوان ذي صلة)",
 "actinian": "أكتينيا (أي شقائق نعمان بحرية أو حيوان ذي صلة)",
 "actiniarian": "أكتينيا (أي شقائق نعمان بحرية أو حيوان ذي صلة)",
 "actinic": "أكتيني, إشعاعي كيميائي (يتعلق بالنشاط الإشعاعي الكيميائي (الأكتينية) أو يظهره)",
 "actinic dermatitis": "التهاب الجلد السفعي (التهاب جلد ناتج عن التعرض لأشعة الشمس)",
 "actinic keratosis": "تقران سفعي/تقرن سفعي",
 "actinic radiation": "إشعاع أكتيني, إشعاع كيميائي ضوئي (إشعاع كهرومغناطيسي يمكن أن يحدث تفاعلات كيميائية ضوئية)",
 "actinic ray": "إشعاع أكتيني, إشعاع كيميائي ضوئي (إشعاع كهرومغناطيسي يمكن أن يحدث تفاعلات كيميائية ضوئية)",
 "actinide": "أكتينيد (أي من سلسلة العناصر المشعة ذات الأعداد الذرية من 89 إلى 103)",
 "actinide series": "سلسلة الأكتينيدات ((كيمياء) سلسلة من 15 عنصراً مشعاً ذات أعداد ذرية متزايدة من الأكتينيوم إلى اللورنسيوم)",
 "actinidia arguta": "أكتينيديا حادة, كيوي هاردي (كرمة آسيوية متسلقة لها أوراق طويلة مسننة بدقة وعناقيد من الزهور البيضاء تليها ثمار صفراء مخضرة صالحة للأكل)",
 "actinidia chinensis": "عنب الثعلب الصيني, كيوي (كرمة متسلقة موطنها الصين؛ تزرع في نيوزيلندا لفاكهتها الصالحة للأكل ذات القشرة الوبرية واللب الأخضر)",
 "actinidia deliciosa": "عنب الثعلب الصيني, كيوي (كرمة متسلقة موطنها الصين؛ تزرع في نيوزيلندا لفاكهتها الصالحة للأكل ذات القشرة الوبرية واللب الأخضر)",
 "actinidia polygama": "أكتينيديا مضلعة, كرمة فضية (كرمة زينة من شرق آسيا لها ثمار صفراء صالحة للأكل وأوراق ذات علامات بيضاء فضية)",
 "actinism": "أكتينية, نشاط كيميائي ضوئي (خاصية الإشعاع التي تمكنه من إحداث تأثيرات كيميائية ضوئية)",
 "actinium": "أَكْتِينِيُوم",
 "actinoid": "شُعَاعِيّ الشَّكْل (ذو شكل شعاعي) / أكتينيد (أي من سلسلة العناصر المشعة ذات الأعداد الذرية من 89 إلى 103)",
 "actinolite": "أكتينوليت (معدن أخضر من مجموعة الأمفيبول؛ سيليكات الكالسيوم والمغنيسيوم والحديد)",
 "actinomeris alternifolia": "فيربيسينا متبادلة الأوراق (عشب معمر بزهور صفراء ملفتة للنظر؛ شرق الولايات المتحدة)",
 "actinometer": "أكتينومتر, مقياس الإشعاع الكيميائي (أداة لقياس شدة الإشعاع الكهرومغناطيسي (عادة عن طريق التأثير الكيميائي الضوئي))",
 "actinometric": "إشعاعي القياس (من أو متعلق بقياس شدة الإشعاع (الأكتينومترية))",
 "actinometrical": "إشعاعي القياس (من أو متعلق بقياس شدة الإشعاع (الأكتينومترية))",
 "actinometry": "أكتينومترية, قياس الإشعاع (قياس شدة الإشعاع الكهرومغناطيسي (خاصة أشعة الشمس))",
 "actinomorphic": "شعاعي التناظر (قابل للانقسام إلى نصفين متماثلين بواسطة أي مستوى طولي يمر عبر المحور)",
 "actinomorphous": "شعاعي التناظر (قابل للانقسام إلى نصفين متماثلين بواسطة أي مستوى طولي يمر عبر المحور)",
 "actinomyces": "أكتينوميسيس, شعية (رميات تعيش في التربة وطفيليات نباتية وحيوانية مسببة للأمراض)",
 "actinomycetal": "شاعي (من أو ينتمي إلى الفطريات الشعاعية (الأكتينوميسيتات))",
 "actinomycete": "أكتينوميسيت, شعية (أي بكتيريا (بعضها ممرض للإنسان والحيوان) تنتمي إلى رتبة الشعيات)",
 "actinomycetous": "شاعي (من أو ينتمي إلى الفطريات الشعاعية (الأكتينوميسيتات))",
 "actinomycin": "أكتينومايسين (أي من المضادات الحيوية الحمراء المتنوعة المعزولة من بكتيريا التربة)",
 "actinomycosis": "داء الشعيات (مرض يصيب الماشية ويمكن أن ينتقل إلى البشر؛ ينتج عن العدوى بالشعيات؛ يتميز بتورمات صلبة تفرز القيح عبر جيوب طويلة)",
 "actinomycotic": "فطاري شعاعي (من أو متعلق بعدوى داء الفطريات الشعاعية)",
 "actinomyxidian": "أكتينوميكسيديان (يتعلق بطفيليات الديدان)",
 "actinon": "أكتينيد (أي من سلسلة العناصر المشعة ذات الأعداد الذرية من 89 إلى 103)",
 "actinopod": "شعاعيات الأقدام (أوالي لها أقدام كاذبة شعاعية صلبة تشبه القضبان)",
 "actinotherapy": "علاج إشعاعي ((طب) علاج المرض (خاصة السرطان) عن طريق التعرض لمادة مشعة)",
 "actinozoan": "زهريات شعاعية (جوفمعويات بحرية لاطئة تشمل السلائل المنفردة والاستعمارية؛ يتم قمع مرحلة الميدوزا تماماً)",
 "action": "عَمَل (فِعْل، صُنْع؛ وسيلة للكسب، مِهْنَة، حِرْفَة)\nمثال: المهم هو العمل.",
 "action at law": "إجراء قانوني, دعوى قانونية (إجراء قضائي يرفعه طرف ضد آخر؛ يقاضي طرف طرفاً آخر بسبب خطأ ارتكب أو لحماية حق أو لمنع خطأ)",
 "action mechanism": "آلية عمل, حركة (الجزء التشغيلي الذي ينقل الطاقة إلى آلية)\nمثال: كان للبيانو حركة صلبة جداً",
 "action movie": "فِيلْمُ أَكْشِنْ, فِيلْمُ حَرَكَةٍ",
 "action officer": "ضابط عمليات (ضابط الحالة المعين لأداء عمل أثناء عملية سرية (خاصة في منطقة معادية))",
 "action painting": "تعبيرية تجريدية, رسم حركي (مدرسة رسم في نيويورك تتميز بالتجريدات التي تم إنشاؤها بحرية؛ أول مدرسة مهمة للرسم الأمريكي تتطور بشكل مستقل عن الأساليب الأوروبية)",
 "action plant": "ست المستحية, ميموزا خجولة (شجيرة فرعية مفترشة أو شبه منتصبة من أمريكا الاستوائية وأستراليا؛ مسلحة بشدة بأشواك منحنية ولها وريقات خضراء رمادية ناعمة حساسة تطوى وتتدلى في الليل…)",
 "action potential": "جهد الفعل (تغير الجهد المحلي عبر جدار الخلية أثناء انتقال السيال العصبي)",
 "action replay": "إعادة, إعادة فورية (إعادة البث الفوري لحدث ما (خاصة الأحداث الرياضية) تم تسجيله على شريط فيديو)",
 "action spectrum": "طيف الفعالية (الكفاءة التي ينتج بها الإشعاع الكهرومغناطيسي تفاعلاً كيميائياً ضوئياً مرسومة كدالة لطول موجة الإشعاع)",
 "actionable": "قَابِل لِلتَّقَاضِي (يوفّر أسساً لإقامة دعوى قانونية)",
 "actions speak louder than words": "الْأَعْمَال أَعْلَى صَوْتًا مِن الْكَلِمَات",
 "actitis hypoleucos": "طيطوي شائع (نوع من الطيطوي)",
 "actitis macularia": "طيطوي منقط (طيطوي شائع في أمريكا الشمالية)",
 "activase": "أكتيفاز, منشط البلازمينوجين النسيجي (عامل حال للتخثر (الاسم التجاري أكتيفاز) يسبب انحلال الفيبرين في موقع الجلطة الدموية؛ يستخدم في علاج احتشاء عضلة القلب الحاد)",
 "activate": "فَعَّلَ (عَمِلَ وصَنَعَ، بعلم أو بدون علم، عن قصد أو دون قصد)\nمثال: ماذا فعل للحمي؟",
 "activated": "مُفَعَّل, مُنَشَّط ((عسكري) أُنشِئ وعُيِّن في مهمّة فعليّة) / مُنَشَّط (جُعِل نشطًا؛ مثلًا جُعِل مُشِعًّا أو مُتَوَهِّجًا أو حسّاسًا للضوء أو مُوصِلًا) / مُثَار, مُنَشَّط ((في الجزيئات مثلًا) جُعِل نشطًا أو أكثر تفاعلًا) / مُنَشَّطٌ ((لمياه الصرف) مُعَالَج بالتهوية والبكتيريا للمساعدة في التحلل)",
 "activated carbon": "فحم منشط, كربون نشط (مسحوق أو حبيبات الكربون تستخدم للتنقية عن طريق الامتزاز؛ يُعطى عن طريق الفم (كطين سائل) ليكون ترياقاً لبعض أنواع السموم)",
 "activated charcoal": "فحم منشط, كربون نشط (مسحوق أو حبيبات الكربون تستخدم للتنقية عن طريق الامتزاز؛ يُعطى عن طريق الفم (كطين سائل) ليكون ترياقاً لبعض أنواع السموم)",
 "activating": "تفعيل, تنشيط (نشاط التسبب في الحصول على طاقة ونشاط)",
 "activating agent": "عامل تنشيط ((استخراج المعادن) مادة كيميائية نشطة سطحياً تستخدم في عملية التعويم لزيادة الجذب لمعدن معين)",
 "activation": "تفعيل, تنشيط (الجعل نشطاً وفعالاً (مثل القنبلة)) / تفعيل, تنشيط (نشاط التسبب في الحصول على طاقة ونشاط) / تنشيط (تحفيز النشاط في كائن حي أو مادة كيميائية)",
 "activation energy": "طاقة التنشيط (الطاقة التي يجب أن يكتسبها نظام ذري قبل أن تحدث عملية (مثل الانبعاث أو التفاعل))\nمثال: يقال إن المحفزات تقلل من طاقة التنشيط أثناء المرحلة الانتقالية للتفاعل",
 "activator": "مُنْشِط",
 "active": "نَشِيط, عَامِل / نَشِيط / حَرِك (غَيَّرَ مَوْضِعَهُ أو مَكَانَهُ أو حَالَه؛ حَرُكَ الوَلَدُ : تَحَرَّكَ، أَوْ خَرَجَ عَنْ سُكُونِهِ) / فَارِه, حَرِك\nمثال: لقد أوقفنا حركة المرور.",
 "active agent": "عامل نشط, مادة فعالة (عامل كيميائي قادر على القيام بنشاط ما)",
 "active air defense": "دفاع جوي إيجابي (دفاع جوي باستخدام الطائرات أو الصواريخ أو المدفعية أو الإجراءات الإلكترونية المضادة)",
 "active application": "تطبيق نشط (تطبيق يعمل حالياً ويظهر في الواجهة الأمامية)",
 "active birth": "ولادة نشطة (الولادة التي يتم فيها تشجيع الأم على أن تكون مشاركاً نشطاً)",
 "active capital": "رأس مال نشط (المال أو الممتلكات التي يمكن تحويلها بسهولة إلى مال)",
 "active citizen": "مواطن فاعل (مواطن يتولى دوراً نشطاً في المجتمع (كما في منع الجريمة ومراقبة الحي))",
 "active electrolocation": "تحديد الموقع الكهربائي النشط (عندما يستشعر الحيوان بيئته المحيطة عن طريق توليد مجالات كهربائية واكتشاف التشوهات في هذه المجالات)",
 "active immunity": "مناعة نشطة (شكل من أشكال المناعة المكتسبة يقوم فيه الجسم بإنتاج أجسامه المضادة الخاصة ضد المستضدات المسببة للأمراض)",
 "active ingredient": "مَادَّة فَعَّالَة (مؤنث مَادّ، اسم فاعل من مَدَّ. الجمع مَادَّات؛ ما كان مَدَدًا لغيره)\nمثال: لا أحب مادة العلوم.",
 "active matrix screen": "شاشة المصفوفة النشطة (نوع من شاشات الكريستال السائل يُستخدم في بعض الحواسيب المحمولة؛ حيث توجد دائرة منفصلة لكل بكسل)",
 "active measures": "إجْرَاءَات نَشِطَة",
 "active participle": "اِسْم فَاعِل (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)\nمثال: ما اسم حصان توم؟",
 "active placebo": "دواء وهمي نشط (دواء وهمي يستخدم في الاختبارات التجريبية لدواء له آثار جانبية ملحوظة)\nمثال: الدواء الوهمي النشط يحاكي الآثار الجانبية للدواء التجريبي",
 "active power": "قدرة حقيقية, قدرة فعالة (جزء القدرة الذي يؤدي، عند حساب متوسطه على دورة كاملة لموجة التيار المتردد، إلى نقل صافي للطاقة في اتجاه واحد)",
 "active site": "موقع نشط (الجزء من الإنزيم أو الجسم المضاد حيث يحدث التفاعل الكيميائي)",
 "active subwoofer": "مضخم صوت نشط (مضخم صوت مزود بمكبر صوت مدمج)",
 "active transport": "نَقْل فَعَّال",
 "active trust": "ائتمان نشط (ائتمان يجب على الأمين فيه أداء واجبات معينة)",
 "active voice": "صِيغَة مَعْلُوم, مَبْنِيّ لِلْمَعْلُوم",
 "actively": "بِنَشَاطٍ",
