 "accommodation reflex": "منعكس التكيف (تغيرات انعكاسية في العين تمكن من تركيز جسم ما على الشبكية)",
 "accommodational": "تكييفي (من أو متعلق بتكيف عدسة العين)\nمثال: إجهاد تكييفي",
 "accommodative": "خَدُوم, مُتَعَاوِن (مفيد في تحقيق التكيف المتناغم) / تَصَالُحِيّ, تَوْفِيقِيّ (يميل إلى التوفيق أو التكييف؛ يُحقِّق الانسجام) / تَعَاوُنِيّ, تَوَافُقِيّ (مستعدّ للتكيّف مع الاختلافات من أجل الوصول إلى اتفاق)\nمثال: كان المأمور دائماً متعاوناً في السماح للزوار بالدخول",
 "accommodator": "خَدُوم, مقدم خدمات (شخص يؤدي خدمة أو يقدم معروفاً)",
 "accompanied": "مرافق, مصحوب (لديه رفقاء أو مرافقة) / مصحوب (بموسيقى) (عزف أو غناء بمصاحبة آلية أو صوتية)\nمثال: كان هناك سادة بمفردهم وسادة برفقة زوجاتهم",
 "accompaniment": "مُصَاحَبَة",
 "accompanist": "مصاحب موسيقي (شخص يقدم مصاحبة موسيقية (عادة على البيانو))",
 "accompany": "رَافَقَ / صَاحَبَ, رَافَقَ (اَلْمُرَافِق، الْمُلَازِمُ، وَلَا يُقَالُ عُرْفاً إِلَّا لِمَنْ كَثُرَتْ مُلَازَمَتُهُ؛ صَاحِبُ الشَّيْءِ: مَالِكُهُ)\nمثال: من صاحب هذه الأرض؟",
 "accompanying": "مُتَرَتِّب, مُصَاحِب (يحدث بالتزامن مع شيء آخر أو نتيجةً له)",
 "accompanying vein": "وريد مرافق (وريد يرافق بنية أخرى؛ قد يرافق الوريد شرياناً بطريقة تساعد فيها النبضات الشريانية على العودة الوريدية)",
 "accompanyist": "مصاحب موسيقي (شخص يقدم مصاحبة موسيقية (عادة على البيانو))",
 "accomplice": "شَرِيك فِي جَرِيمَة",
 "accomplish": "أَدَّى",
 "accomplishable": "قَابِل لِلتَّحْقِيق, قَابِل لِلْإِنْجَاز (يمكن تحقيقه أو إنجازه؛ في حيّز الإمكان)",
 "accomplished": "مُحَقَّق, مُنْجَز (تمّ إنجازه أو إتمامه بنجاح) / مُحَقَّق, مُنْجَز (مُستقرّ بشكل نهائيّ وغير مشروط) / مُتَمَرِّس, مُتْقِن (ذو مهارة عالية في مجاله)",
