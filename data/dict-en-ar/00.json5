 "alaska king crab": "سرطان الملك (سرطان كبير صالح للأكل من مياه شمال المحيط الهادئ وخاصة على طول سواحل ألاسكا واليابان) / سلطعون الملك الألاسكي (لحم سلطعون مياه باردة كبير؛ لحم الأرجل بشكل أساسي)",
 "alaska native": "مواطن ألاسكا الأصلي (عضو أو سليل لأي من الشعوب الأصلية في ألاسكا)",
 "alaska rein orchid": "سحلب لجام ألاسكا (يشبه سحلب اللجام الساحلي ولكن بزهور أصغر؛ ألاسكا إلى باجا كاليفورنيا وشرقاً إلى داكوتا وكولورادو)",
 "alaska standard time": "توقيت ألاسكا (التوقيت القياسي في المنطقة الزمنية التاسعة غرب غرينتش، يحسب عند خط الطول 135 غرباً؛ يستخدم في هاواي ومعظم ألاسكا)",
 "alaskan": "ألاسكي (يتعلق بـ أو من خصائص ولاية أو شعب ألاسكا) / ألاسكي (مواطن أو مقيم في ألاسكا)",
 "alaskan brown bear": "دب ألاسكا البني, دب كودياك (دب بني من ساحل ألاسكا وكولومبيا البريطانية)",
 "alaskan king crab": "سرطان الملك (سرطان كبير صالح للأكل من مياه شمال المحيط الهادئ وخاصة على طول سواحل ألاسكا واليابان) / سلطعون الملك الألاسكي (لحم سلطعون مياه باردة كبير؛ لحم الأرجل بشكل أساسي)",
 "alaskan malamute": "مالاموت, مالاموت ألاسكي (سلالة من كلاب الزلاجات تم تطويرها في ألاسكا)",
 "alaskan native": "مواطن ألاسكا الأصلي (عضو أو سليل لأي من الشعوب الأصلية في ألاسكا)",
 "alastrim": "جدري خفيف (شكل خفيف من الجدري يسببه فيروس أقل ضراوة)",
 "alate": "مُجَنَّح ((عن البذور أو الحشرات) له امتدادات تشبه الأجنحة)",
 "alated": "مُجَنَّح ((عن البذور أو الحشرات) له امتدادات تشبه الأجنحة)",
 "alauda arvensis": "قبرة السماء (قبرة أوروبية مرقطة بالبني تشتهر بالغناء أثناء التحليق على ارتفاع كبير)",
 "alawism": "علوية (فرع من الشيعة يمارس خاصة في شمال غرب سوريا وأجزاء مجاورة من تركيا ولبنان)\nمثال: بالإضافة إلى ذلك، كانت هناك حركة حديثة لتوحيد العلوية وفروع الإسلام الاثني عشري الأخرى من خلال برامج التبادل التعليمي في سوريا وقم",
 "alb": "قميص أبيض كنسي (رداء طقسي من الكتان الأبيض بأكمام؛ يرتديه الكهنة)",
 "albacete": "ﭐَلبَسِيط",
 "albacore": "باكور, تونة بيضاء (تونة كبيرة تعيش في عرض البحر وهي مصدر معظم التونة المعلبة؛ تصل إلى 93 رطلاً ولها زعانف صدرية طويلة؛ توجد في جميع أنحاء العالم في المياه الاستوائية…) / الباكور, تونة بيضاء (تونة صغيرة نسبياً ذات لحم أبيض فاخر؛ مصدر رئيسي للتونة المعلبة)",
 "albania": "أَلْبَانِيَا, البانيا (دولة أوروبية جنوبية بين إيطاليا ويوغسلافيا واليونان)\nمثال: أمضت عدة سنوات في ألبانيا.",
 "albanian": "أَلْبَانِيّ",
 "albanian language": "اللغة الألبانية (اللغة الهندية الأوروبية التي يتحدث بها شعب ألبانيا)",
 "albanian monetary unit": "وحدة نقدية ألبانية (الوحدة النقدية في ألبانيا)",
 "albatrellus dispansus": "ألباتريلوس ديسبانسوس (فطر نادر له جسم ثمري أصفر كبير (يصل عرضه إلى 14 بوصة) مع قبعات فردية متعددة وساق مركزي عريض ورائحة عطرة)",
 "albatrellus ovinus": "بوليبور الأغنام (فطر بقبعة دائرية غالباً بيضاء وسطح مسامي أبيض ومسام صغيرة وساق مركزي أبيض؛ يوجد تحت الصنوبريات؛ صالح للأكل لكنه غير شائع)",
 "albatross": "قَطْرَس (طائر بحري كبير)",
 "albedo": "عَاكِسِيَّة, وَضَاءَة",
 "albeit": "وَلَو",
 "albers-schonberg disease": "تصخر العظم, مرض العظم الرخامي (اضطراب وراثي يتميز بزيادة كثافة العظام)",
 "albert": "أَلْبِرْت",
 "alberta": "أَلْبِرْتَا",
 "albertism": "ألبيرتية (فلسفة ألبرتوس ماغنوس، الفيلسوف المدرسي الألماني (1193-1280))",
 "albescent": "مُبْيَضّ (يتحول إلى الأبيض أو يميل إليه تدريجياً)",
 "albi": "ألبي",
 "albigenses": "الألبيجان, الكاثار (طائفة دينية مسيحية في جنوب فرنسا في القرنين الثاني عشر والثالث عشر)",
 "albigensian": "ألبيجنسي (من أو متعلق بالألبيجنسيين (طائفة دينية) أو مذهبهم)",
 "albigensianism": "ألبيجنسية, كاثار (حركة مسيحية تعتبر سليلة للمانوية في العصور الوسطى في جنوب فرنسا في القرنين الثاني عشر والثالث عشر؛ تميزت بالثنوية (تؤكد تعايش مبدأين متعارضين، أحدهما…)",
 "albinal": "أبرصي, مهقي (من أو متعلق بـ أو مصاب بالمهق (البرص))",
 "albinic": "أبرصي, مهقي (من أو متعلق بـ أو مصاب بالمهق (البرص))",
 "albinism": "برص, مهق (غياب خلقي للتصبغ في العينين والجلد والشعر)",
 "albinistic": "أبرصي, مهقي (من أو متعلق بـ أو مصاب بالمهق (البرص))",
 "albino": "أَمْهَق",
 "albinotic": "أبرصي, مهقي (من أو متعلق بـ أو مصاب بالمهق (البرص))",
 "albite": "ألبيت, فلسبار أبيض (فلسبار واسع الانتشار يشكل الصخور)",
 "albitic": "ألبيتي (من أو متعلق بمعدن الألبيت الفلسباري)",
 "albizia": "ألبيزيا (أي من الأشجار العديدة من جنس الألبيزيا)",
 "albizia julibrissin": "ألبيزيا زهرة الحرير, شجرة الحرير (شجرة آسيوية جذابة مقببة أو مسطحة القمة لها أوراق ريشية مزدوجة وزهور بأسدية حريرية طويلة)",
 "albizia lebbeck": "ألبيزيا لبك, ذقن الباشا (شجرة كبيرة منتشرة من العالم القديم لها أوراق كبيرة وعناقيد كروية من الزهور الصفراء المخضرة وقرون بذور طويلة تقرقيع في الرياح)",
 "albizia saman": "سامان, شجرة المطر (شجرة أمريكية استوائية كبيرة للزينة بأوراق ريشية مزدوجة وعناقيد كروية من الزهور بأسدية قرمزية وقرون بذور تأكلها الماشية)",
 "albizzia": "ألبيزيا (أي من الأشجار العديدة من جنس الألبيزيا)",
 "albizzia julibrissin": "ألبيزيا زهرة الحرير, شجرة الحرير (شجرة آسيوية جذابة مقببة أو مسطحة القمة لها أوراق ريشية مزدوجة وزهور بأسدية حريرية طويلة)",
 "albizzia lebbeck": "ألبيزيا لبك, ذقن الباشا (شجرة كبيرة منتشرة من العالم القديم لها أوراق كبيرة وعناقيد كروية من الزهور الصفراء المخضرة وقرون بذور طويلة تقرقيع في الرياح)",
 "alborz": "ألبرز",
 "albright's disease": "خلل التنسج الليفي متعدد العظام, متلازمة أولبرايت (خلل التنسج الليفي للعظام الذي يؤثر على عظام متعددة)",
 "albuca": "ألبوكا (أي من النباتات المختلفة من جنس ألبوكا ذات عناقيد كبيرة من الزهور الصفراء الشاحبة؛ جنوب أفريقيا)",
 "albuginea": "غلالة بيضاء (غلالة بيضاء اللون)",
 "albula vulpes": "سمكة العظم (سمكة بحرية فضية نحيلة توجد في المسطحات الطينية الاستوائية وبحيرات المانغروف)",
 "album": "أَلْبُوم (كتاب صفحاته من الجيوب الشَّفافة لحفظ الصّور، والطوابع، والتوقيعات والنقود ونحوها؛ مجموعة من التسجيلات الصوتية التي أُصدرت كمجموعة على قرص مضغوط، أو قرص فونوغراف، أو شريط صوتي، أو أي وسيط آخر، كالتوزيع الرقمي)\nمثال: أحب هذا الألبوم.",
 "albumen": "بياض البيض, زلال (الجزء الأبيض من البيضة؛ المادة الهلامية المغذية والواقية المحيطة بالصفار وتتكون أساساً من الألبومين المذاب في الماء) / ألبومين, زلال (بروتين بسيط قابل للذوبان في الماء يوجد في العديد من الأنسجة والسوائل الحيوانية)",
 "albumin": "ألبومين, زلال (بروتين بسيط قابل للذوبان في الماء يوجد في العديد من الأنسجة والسوائل الحيوانية)",
 "albuminoid": "زُلَالَانِيّ",
 "albuminous": "زُلَالِيّ",
 "albuminuria": "بيلة ألبومينية, بيلة بروتينية (وجود بروتين مفرط (بشكل رئيسي الألبومين ولكن أيضاً الجلوبيولين) في البول؛ عادة ما يكون عرضاً لاضطراب كلوي)",
 "albuminuric": "زلالي البول (من أو متعلق بحالة وجود الزلال في البول)",
 "albuquerque": "أَلْبُوكِيرْكِي",
 "albuterol": "ألبوتيرول, بروفنتيل (موسع للقصبات (الأسماء التجارية فينتولين وبروفنتيل) يستخدم للربو وانتفاخ الرئة وحالات الرئة الأخرى؛ متوفر في أشكال فموية أو استنشاقية؛ الآثار الجانبية…)",
 "alca torda": "موسوي المنقار (طائر أوك أسود وأبيض من شمال الأطلسي ذو منقار مضغوط حاد الحواف)",
 "alcahest": "الكاهست, المذيب العام (مذيب عالمي افتراضي سعى إليه الخيميائيون قديماً)",
 "alcaic": "بحر الكاي, شعر الكاي (شعر بالنظم الذي استخدم في الشعر اليوناني واللاتيني، يتكون من مقطوعات ذات 4 أسطر؛ وينسب اختراعه للشاعر ألكايوس)",
 "alcaic verse": "بحر الكاي, شعر الكاي (شعر بالنظم الذي استخدم في الشعر اليوناني واللاتيني، يتكون من مقطوعات ذات 4 أسطر؛ وينسب اختراعه للشاعر ألكايوس)",
 "alcalde": "ألكالد, عمدة (عمدة أو رئيس القضاة في بلدة إسبانية)",
 "alcalescent": "قَلَوِيّ قَلِيلًا (يميل إلى القلويّة؛ قلويّ بدرجة طفيفة)",
 "alcalá de henares": "قَلْعَةُ هِنَارَة (المرة الواحدة من القَلْع؛ حِصْن منيع غالبا يبنى على تلّ أو جبل أو مكان عالٍ منيع)\nمثال: هو يعيش في قلعة.",
 "alcamo": "علقمة, القاموق",
 "alcapton": "ألكابتون, حمض الهوموجنتيسيك (حمض يتكون كمنتج وسيط في عملية التمثيل الغذائي للتيروزين والفينيل ألانين)",
 "alcaptonuria": "بيلة الكابتونية (شذوذ استقلابي متنحي نادر يتميز بالتمغر ووجود الكابتون في البول)",
 "alcarraza": "كُرَّاز",
 "alcazar": "قَصْر أَنْدَلُسِيّ (ضد الطول؛ غير تام، غير كامل)\nمثال: لقد قصر الخطاب.",
 "alcea rosea": "ختمية وردية, خطمي وردي (نبات ذو عناقيد طرفية من الزهور البيضاء إلى الوردية أو الأرجوانية المبهرجة؛ الختمية الإنجليزية لحدائق الأكواخ)",
 "alcedo atthis": "رفراف شائع (رفراف صغير ذو ريش أزرق مخضر وبرتقالي)",
 "alces alces": "إلكة, موس (أيل شمالي كبير يتميز الذكر منه بقرون ضخمة مسطحة؛ يسمى 'إلكة' في أوروبا و 'موس' في أمريكا الشمالية)",
 "alchemic": "خيميائي (متعلق بالخيمياء أو معني بها)",
 "alchemical": "خيميائي (متعلق بالخيمياء أو معني بها)",
 "alchemist": "خِيمِيَائِيّ",
 "alchemistic": "خيميائي (من أو متعلق بالخيميائيين)",
 "alchemistical": "خيميائي (من أو متعلق بالخيميائيين)",
 "alchemy": "اَلْخِيمِيَاء, خِيمِيَاء",
 "alcohol": "كُحُول, مَشْرُوب كُحُولِيّ (سَائِلٌ لاَ لَوْنَ لَهُ، لاَذِعُ الطَّعْمِ، يُسْتَخْرَجُ مِنْ تَخْمِيرِ بَعْضِ الْمَوَادِّ، يُمْزَجُ بِالْمَشْرُوبَاتِ الرُّوحِيَّةِ…)\nمثال: أكره ذوق الكحول.",
 "alcohol abuse": "إدمان الكحول, إساءة استعمال الكحول (الاستخدام المفرط للكحول والمشروبات الكحولية)",
 "alcohol addiction": "إدمان الكحول (تسمم اعتيادي؛ تناول مفرط ومطول للمشروبات الكحولية يؤدي إلى انهيار في الصحة وإدمان للكحول بحيث يؤدي الحرمان المفاجئ منه إلى أعراض انسحاب شديدة)",
 "alcohol amnestic disorder": "خرف كحولي, ذهان كورساكوف (خرف يلاحظ خلال المراحل الأخيرة من إدمان الكحول المزمن الشديد؛ ينطوي على فقدان الذاكرة للأحداث الأخيرة على الرغم من سلامة الذاكرة طويلة المدى)",
 "alcohol group": "شق كحولي, مجموعة كحولية ((شَقَّ) الفَرَسُ ونحوُهُ يَشِقَّ شَقَقًا: مال في جَرْيِهِ إِلى جانب؛ فهو أشَقُّ، وهي شَقَّاءُ)\nمثال: اكشف عن الشق العلوي من الجسم.",
 "alcohol radical": "شق كحولي, مجموعة كحولية ((شَقَّ) الفَرَسُ ونحوُهُ يَشِقَّ شَقَقًا: مال في جَرْيِهِ إِلى جانب؛ فهو أشَقُّ، وهي شَقَّاءُ)\nمثال: اكشف عن الشق العلوي من الجسم.",
 "alcohol thermometer": "مقياس حرارة كحولي (مقياس حرارة يتكون من أنبوب شعري زجاجي مدرج بدرجات مئوية أو فهرنهايت ويحتوي على كحول يرتفع أو ينخفض بتمدده أو انكماشه مع تغيرات درجة الحرارة)",
 "alcohol-dependent": "كُحُولِيّ, مُدْمِن خَمْر (مدمن على الكحول)",
 "alcohol-in-glass thermometer": "مقياس حرارة كحولي (مقياس حرارة يتكون من أنبوب شعري زجاجي مدرج بدرجات مئوية أو فهرنهايت ويحتوي على كحول يرتفع أو ينخفض بتمدده أو انكماشه مع تغيرات درجة الحرارة)",
 "alcohol-soluble": "ذَوَّابٌ فِي الكُحُول (قابل للذوبان في الكحول)",
 "alcoholic": "سِكِّير, سِكِّيرَة / سِكِّير, خِمِّير / رُوحِيّ, كُحُولِيّ",
 "alcoholic abuse": "إدمان الكحول, إساءة استعمال الكحول (الاستخدام المفرط للكحول والمشروبات الكحولية)",
 "alcoholic beverage": "كحول, مشروب كحولي (سائل أو شراب يحتوي على الكحول كعامل نشط)\nمثال: الكحول (أو الشراب) دمره",
 "alcoholic dementia": "خرف كحولي, ذهان كورساكوف (خرف يلاحظ خلال المراحل الأخيرة من إدمان الكحول المزمن الشديد؛ ينطوي على فقدان الذاكرة للأحداث الأخيرة على الرغم من سلامة الذاكرة طويلة المدى)",
 "alcoholic drink": "كحول, مشروب كحولي (سائل أو شراب يحتوي على الكحول كعامل نشط)\nمثال: الكحول (أو الشراب) دمره",
 "alcoholics anonymous": "مدمنو الكحول المجهولون (منظمة دولية توفر مجموعة دعم للأشخاص الذين يحاولون التغلب على إدمان الكحول)",
 "alcoholism": "كُحُولِيَّة",
 "alcoholism abuse": "إدمان الكحول, إساءة استعمال الكحول (الاستخدام المفرط للكحول والمشروبات الكحولية)",
 "alcove": "ركن, مقصورة (تجويف صغير يفتح على غرفة أكبر)",
 "aldactone": "ألداكتون, سبيرونولاكتون (كورتيكوستيرويد صناعي (الاسم التجاري ألداكتون) يستخدم لعلاج ارتفاع ضغط الدم)",
 "aldebaran": "اَلدَّبَرَان",
 "aldehyde": "ألديهيد (أي من فئة المركبات الكيميائية شديدة التفاعل؛ تستخدم في صنع الراتنجات والأصباغ والأحماض العضوية)",
 "aldehyde group": "شق ألدهيد, مجموعة ألدهيد ((شَقَّ) الفَرَسُ ونحوُهُ يَشِقَّ شَقَقًا: مال في جَرْيِهِ إِلى جانب؛ فهو أشَقُّ، وهي شَقَّاءُ)\nمثال: اكشف عن الشق العلوي من الجسم.",
 "aldehyde radical": "شق ألدهيد, مجموعة ألدهيد ((شَقَّ) الفَرَسُ ونحوُهُ يَشِقَّ شَقَقًا: مال في جَرْيِهِ إِلى جانب؛ فهو أشَقُّ، وهي شَقَّاءُ)\nمثال: اكشف عن الشق العلوي من الجسم.",
 "aldehyde-alcohol": "ألدول, ألديهيد كحولي",
 "aldehydic": "ألدهيدي (من أو متعلق بـ أو يحتوي على الألدهيدات)",
 "alder": "جَار الْمَاء, نَغْت (له استخدامات متعددة، تتراوح بين وصف المكان والعلاقة بين الناس، وبين وصف فعل الظلم أو الميل عن الطريق الصحيح؛ \"جار\" كلمةٌ مُشْعِبَةُ المعنى، تشيرُ إلى المكانِ، والعلاقة، والظلم)\nمثال: لدي جارة مسلمة.",
 "alder blight": "لفحة الألدر (مرض يصيب أشجار الألدر يسببه من الألدر الصوفي (قملة نبات))",
 "alder buckthorn": "نبق ألدر, نبق فرنجولا (شجرة صغيرة شائعة في أوروبا)",
 "alder dogwood": "نبق ألدر, نبق فرنجولا (شجرة صغيرة شائعة في أوروبا)",
 "alder fly": "ذبابة ألدر (حشرة داكنة اللون لها يرقات مائية مفترسة)",
 "alder tree": "جار الماء, نغت (شجيرات أو أشجار المناطق المعتدلة الشمالية ذات أوراق مسننة وثمار تشبه المخروط؛ يستخدم اللحاء في الدباغة والصباغة والخشب مقاوم للعفن)",
 "alder-leaved serviceberry": "جوجي بيري, خدمية ألنية الأوراق (شجيرة أو شجرة صغيرة من شمال غرب أمريكا الشمالية لها زهور بيضاء كريمية عطرة وثمار صغيرة شمعية أرجوانية حمراء)",
 "alderfly": "ذبابة ألدر (حشرة داكنة اللون لها يرقات مائية مفترسة)",
 "alderleaf juneberry": "جوجي بيري, خدمية ألنية الأوراق (شجيرة أو شجرة صغيرة من شمال غرب أمريكا الشمالية لها زهور بيضاء كريمية عطرة وثمار صغيرة شمعية أرجوانية حمراء)",
 "alderman": "عضو مجلس بلدي (عضو ذكر في هيئة تشريعية بلدية (مثل مجلس المدينة))",
