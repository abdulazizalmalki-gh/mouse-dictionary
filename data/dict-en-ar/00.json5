 "accusive": "اتِّهَامِيّ, مُتَّهِم (يتضمن أو يُعَبِّر عن اتهام)",
 "accustomed": "مَأْلُوف, مُعْتَاد (شائع الاستخدام أو الممارسة؛ اعتيادي)",
 "accustomed to": "مَأْلُوف لـ, مُعْتَاد عَلى (لديه عادة أو متكيف مع)\nمثال: معتادة على القيام بعملها الخاص",
 "ace": "آس (نوع نباتي من جنس الآس من الفَصِيلَة الآسيّة. وهو شجر دائم الخُضْرَة، بيضيّ الورق، أبيض الزَّهْر أو ورديُّه، يُزرع للتزيين ولرائحته العِطْريّة…؛ ورقة من أوراق اللعب ذات نقطة أو علامة واحدة) / واحد النرد, آس (في وَ: العدد واحد العدد الاول) / ذَرَّة / إرسال ساحق (الإرْسال : الإطلاق؛ النقل والبَعْث من مكان إلى آخر) / أفضل رامٍ في الفريق / آس, مُمْتاز (نوع نباتي من جنس الآس من الفَصِيلَة الآسيّة. وهو شجر دائم الخُضْرَة، بيضيّ الورق، أبيض الزَّهْر أو ورديُّه، يُزرع للتزيين ولرائحته العِطْريّة…؛ ورقة من أوراق اللعب ذات نقطة أو علامة واحدة)\nمثال: لدي الآس الكوبا.",
 "ace inhibitor": "مثبط الإنزيم المحول للأنجيوتنسين (دواء خافض لضغط الدم يمنع تكوين الأنجيوتنسين 2 في الكلى، مما يؤدي إلى استرخاء الشرايين؛ يعزز إخراج الملح والماء عن طريق تثبيط نشاط الإنزيم المحول…)",
 "ace of clubs": "آس السباتي, قص السباتي (الآس في نقش السباتي)",
 "ace of diamonds": "آس الديناري, قص الديناري (الآس في نقش الديناري)",
 "ace of hearts": "آس الكبة, قص الكبة (الآس في نقش الكبة (القلوب))",
 "ace of spades": "آس البستوني, قص البستوني (الآس في نقش البستوني؛ يؤخذ أحياناً كنذير بالموت)",
 "acebutolol": "أسيبوتولول, سيكترال (حاصر بيتا فموي (الاسم التجاري سيكترال) يستخدم في علاج ارتفاع ضغط الدم)",
 "acedia": "فتور, كسل (اللامبالاة والخمول في ممارسة الفضيلة (تُشخص كإحدى الخطايا السبع المميتة))",
 "acellular": "غَيْر خَلَوِيّ, لَا خَلَوِيّ (لا يتكون من أو ينقسم إلى خلايا)",
 "acellular slime mold": "عفن غروي حقيقي, ميكسوميسيت (عفن غروي من طائفة الميكسوميسيت)",
 "acentric": "عَدِيمُ المَرْكَزِ, لَامَرْكَزِيّ (لَيْسَ لَهُ مَرْكَزٌ أَوْ غَيْرُ مُتَمَرْكِزٍ) / لا مركزي (يفتقر إلى السنترومير (القسيم المركزي))\nمثال: جزء كروموسوم لا مركزي",
 "acentric chromosome": "كْرُومُوسُوم لَا مَرْكَزِيّ (كروموسوم يفتقر إلى القسيم المركزي (السنترومير))",
 "acephalia": "انعدام الرأس (غياب الرأس (كما في تطور بعض المسوخ))",
 "acephalism": "انعدام الرأس (غياب الرأس (كما في تطور بعض المسوخ))",
 "acephalous": "عَديم الرَّأْس (يَفْتَقِر إلى رَأْس مُحَدَّد أو واضِح)",
 "acephaly": "انعدام الرأس (غياب الرأس (كما في تطور بعض المسوخ))",
 "acer argutum": "قيقب مدبب الأوراق (نبات ياباني شجيري صغير بأوراق لها 5 إلى 7 فصوص مستدقة؛ أصفر في الخريف)",
 "acer campestre": "قيقب الحقل, قيقب السياج (قيقب أوراسي شجيري يستخدم غالباً كسياج)",
 "acer circinatum": "قيقب الكرمة (قيقب صغير من شمال غرب أمريكا الشمالية له سيقان منبطحة تتجذر بحرية وتشكل غابات كثيفة)",
 "acer glabrum": "قيقب جبال روكي, قيقب قزمي (قيقب صغير من شمال غرب أمريكا الشمالية)",
 "acer japonicum": "قيقب البدر, قيقب ياباني (أوراق محززة بعمق وحمراء زاهية في الخريف؛ اليابان)",
 "acer macrophyllum": "قيقب أوريغون, قيقب كبير الأوراق (قيقب من غرب أمريكا الشمالية له أوراق كبيرة خماسية الفصوص برتقالية في الخريف)",
 "acer negundo": "قيقب مانيتوبا, قيقب مراني الأوراق (شجرة ظل شائعة في شرق ووسط الولايات المتحدة)",
 "acer negundo californicum": "قيقب مانيتوبا الكاليفورني (قيقب من ساحل المحيط الهادئ للولايات المتحدة؛ الثمار بيضاء عند النضج)",
 "acer palmatum": "قيقب ياباني كفي (شجيرة زينة أو شجرة صغيرة من اليابان وكوريا بأوراق محززة بعمق؛ تزرع في العديد من الأصناف)",
 "acer pennsylvanicum": "خشب الموظ, قيقب مخطط (قيقب من شرق أمريكا الشمالية بلحاء مخطط وأوراق كبيرة ثنائية الفصوص صفراء صافية في الخريف)",
 "acer platanoides": "قيقب نرويجي (شجرة قيقب أوراسية كبيرة متوطنة في أمريكا الشمالية؛ أوراقها خماسية الفصوص صفراء في الخريف؛ تزرع في العديد من الأصناف)",
 "acer pseudoplatanus": "قيقب الجميز, قيقب كبير (شجرة قيقب أوراسية بلحاء رمادي شاحب يتقشر في رقائق مثل شجرة الجميز؛ أوراقها بخمسة فصوص بيضاوية صفراء في الخريف)",
 "acer rubrum": "قيقب أحمر, قيقب قرمزي (قيقب من شرق ووسط أمريكا؛ أوراقه خماسية الفصوص تتحول إلى القرمزي والأصفر في الخريف)",
 "acer saccharinum": "قيقب فضي (شجرة قيقب شائعة في أمريكا الشمالية؛ أوراقها خماسية الفصوص خضراء فاتحة من الأعلى وبيضاء فضية من الأسفل؛ مصدر لخشب بني فاتح صلب متقارب الحبيبات ولكنه هش)",
 "acer saccharum": "قيقب سكري, قيقب صخري (قيقب من شرق ووسط أمريكا الشمالية له أوراق ثلاثية إلى خماسية الفصوص وخشب صلب متقارب الحبيبات يستخدم كثيراً في أعمال الخزائن خاصة الشكل المجعد…)",
 "acer spicatum": "قيقب الجبل (قيقب شجيري صغير من شرق أمريكا الشمالية؛ قرمزي في الخريف)",
 "acerate": "إِبْرِيّ, إِبْرِيّ الشَّكْل (ضيّق وطويل ومُدبَّب؛ كأوراق الصَّنَوْبَر)",
 "acerate leaf": "ورقة إبرية (ورقة مخروطيات)",
 "acerb": "حَارِق, لَاذِع (قاسٍ أو كاوٍ في اللهجة) / قَابِض, لَاذِع (حامض أو مرّ المذاق)",
 "acerbic": "حَارِق, لَاذِع (قاسٍ أو كاوٍ في اللهجة) / قَابِض, لَاذِع (حامض أو مرّ المذاق)",
 "acerbity": "حدة, ضغينة (أبوب خشن ومرير) / حموضة حادة, عفوصة (طعم حامض حاد) / مرارة حادة (مرارة حادة)",
 "acerentomid": "أَسِيرِينْتُومِيدِيّ",
 "acerola": "كَرْز هِنْدِيّ",
 "acerose": "إِبْرِيّ, إِبْرِيّ الشَّكْل (ضيّق وطويل ومُدبَّب؛ كأوراق الصَّنَوْبَر)",
 "acervate": "متكدس, متكوم (متعلق بنمو الفطريات التي تشكل كتلة متكدسة)\nمثال: حوامل بوغية فطرية متكدسة",
 "acervulus": "كويمة (جسم ثمرى لاجنسي صغير يشبه الوسادة أو البثرة يتكون من حصيرة من الخيوط الفطرية تنتجها بعض الفطريات على مضيف)",
 "acetabular": "حُقِّيّ, كُأْسِيّ (متعلّق بالتجويف الحُقّيّ الذي يستقبل رأس عظم الفخذ)",
 "acetabulum": "تجويف حقي, حُق (التجويف الكأسي الشكل في عظم الورك الذي يستقبل رأس الفخذ لتشكيل مفصل كروي وحقي)",
 "acetal": "أسيتال (أي مركب عضوي يتكون من إضافة جزيئات الكحول إلى جزيئات الألديهيد)",
 "acetaldehyde": "أسيتالدهيد, إيثانال (ألديهيد سائل عديم اللون متطاير قابل للذوبان في الماء يستخدم بشكل رئيسي في تصنيع حمض الأسيتيك والعطور والأدوية)",
 "acetaldol": "أسيتالدول (ألدول غير مشبع)",
 "acetamide": "أَسِيتَامِيد",
 "acetaminophen": "أسيتامينوفين, باراسيتامول (مسكن للألم الخفيف ولكن ليس للالتهابات؛ يستخدم أيضاً كخافض للحرارة (تايلينول وبانادول وغيرها هي علامات تجارية لأقراص الأسيتامينوفين))",
 "acetanilid": "أسيتانيليد, فينيل أسيتاميد (مادة كيميائية صلبة عديمة الرائحة تشبه الأوراق أو الرقائق؛ تستخدم في مسرعات المطاط والأصباغ وتخليق الكافور؛ وتُستقلب إلى باراسيتامول (أسيتامينوفين))",
 "acetanilide": "أسيتانيليد, فينيل أسيتاميد (مادة كيميائية صلبة عديمة الرائحة تشبه الأوراق أو الرقائق؛ تستخدم في مسرعات المطاط والأصباغ وتخليق الكافور؛ وتُستقلب إلى باراسيتامول (أسيتامينوفين))",
 "acetate": "أسيتات, رايون أسيتات (قماش مصنوع من ألياف أسيتات السليلوز) / أسيتات, إيثانوات (ملح أو إستر لحمض الأسيتيك (الخليك))",
 "acetate disk": "قرص أسيتات, قرص تسجيل فونوغراف (قرص مطلي بأسيتات السليلوز)",
 "acetate rayon": "أسيتات, رايون أسيتات (قماش مصنوع من ألياف أسيتات السليلوز)",
 "acetic": "أسيتي, خلي (يتعلق بحمض الخليك أو يحتوى عليه)",
 "acetic acid": "حمض الأسيتيك, حمض الخليك (سائل لاذع عديم اللون يستخدم على نطاق واسع في تصنيع البلاستيك والمستحضرات الصيدلانية)",
 "acetic anhydride": "أنهيدريد الأسيتيك (مركب ضروري لتكرير الأفيون وتحويله إلى هيروين)",
 "acetin": "أسيتين (أي من ثلاث خلات سائلة تتكون عند تسخين حمض الأسيتيك والجلسرين معاً)",
 "acetoacetic acid": "حمض الأسيتوأسيتيك (حمض غير مستقر يوجد بكميات غير طبيعية في الدم والبول في بعض حالات ضعف التمثيل الغذائي (مثل السكري أو المجاعة))",
 "acetone": "أَسِيتُون",
 "acetone body": "جسم أسيتوني, جسم كيتوني (كيتون وهو منتج وسيط لتحلل الدهون في الجسم؛ أي من ثلاثة مركبات توجد بزيادة في دم وبول الأشخاص الذين يعانون من اضطرابات التمثيل الغذائي)",
 "acetonemia": "فرط كيتون الجسم, كيتونية الدم (زيادة غير طبيعية في الأجسام الكيتونية في الدم كما في داء السكري)",
 "acetonic": "أسيتوني, خلوني (من أو متعلق بالأسيتون)",
 "acetonuria": "بيلة كيتونية (كميات مفرطة من الأجسام الكيتونية في البول كما في داء السكري أو الجوع)",
 "acetophenetidin": "أسيتوفينيتيدين, فيناسيتين (مركب بلوري أبيض يستخدم كمسكن للألم وكذلك كخافض للحرارة)",
 "acetose": "خَلِّيّ (ذو طعم أو رائحة تشبه الخل)",
 "acetous": "خَلِّيّ (ذو طعم أو رائحة تشبه الخل)",
 "acetphenetidin": "أسيتوفينيتيدين, فيناسيتين (مركب بلوري أبيض يستخدم كمسكن للألم وكذلك كخافض للحرارة)",
 "acetum": "خل (سائل حامض الطعم ينتج عادة عن أكسدة الكحول في النبيذ أو عصير التفاح ويستخدم كتابل أو مادة حافظة للطعام) / خل دواي (محلول مخفف لحمض الأسيتيك يستخدم كمذيب (على سبيل المثال لدواء))",
 "acetyl": "أسيتيل, شق الأسيتيل",
 "acetyl chloride": "كلوريد الأسيتيل",
 "acetyl group": "أسيتيل, شق الأسيتيل",
 "acetyl radical": "أسيتيل, شق الأسيتيل",
 "acetylation": "أستلة (عملية إدخال مجموعة أستيل في مركب ما)\nمثال: أستلة إنزيم الأكسدة الحلقية-2 بواسطة الأسبرين",
 "acetylcholine": "أَسِيتِيل كُولِين",
 "acetylene": "أسيتيلين, إيثاين (غاز عديم اللون قابل للاشتعال يستخدم بشكل رئيسي في اللحام وفي التخليق العضوي)",
 "acetylenic": "أستيليني (من أو متعلق بالأستيلين)",
 "acetylic": "أسيتيلي, خلي (من أو متعلق بحمض الخليك (الأسيتيك))",
 "acetylsalicylic acid": "أسبرين, حمض الأسيتيل ساليسيليك (مشتق مؤستل لحمض الساليسيليك؛ يستخدم كدواء مسكن ومضاد للالتهابات (الأسماء التجارية باير وغيرها) يؤخذ عادة على شكل أقراص؛ يستخدم كخافض للحرارة ويبطئ…)",
 "achaean": "آخي, أخائي (من أو متعلق بآخايا أو شعبها اليوناني القديم) / الآخايون (السكان اليونانيون القدماء في آخايا) / آخي (عضو في أحد الأقسام اللغوية الأربعة لليونانيين في عصور ما قبل التاريخ، الذين تحدثوا في البر اليوناني وكريت وقبرص في القرنين السادس عشر والثاني عشر قبل…)",
 "achaemenes": "هَخَامَنِش, أخيمينيس",
 "achaemenid": "هَخَامَنِشِيّ",
 "achaian": "آخي (عضو في أحد الأقسام اللغوية الأربعة لليونانيين في عصور ما قبل التاريخ، الذين تحدثوا في البر اليوناني وكريت وقبرص في القرنين السادس عشر والثاني عشر قبل…)",
 "ache": "تَأَلَّمَ, وَجِعَ / أَلَم, وَجَع (الوَجَع)\nمثال: ألم أقل لك ذلك؟",
 "achene": "فقيرة (فاكهة جافة صغيرة غير متفتحة تكون البذرة فيها متميزة عن جدار الفاكهة)",
 "achenial": "فقيري (متعلق بالثمرة الفقيرة (ثمرة جافة وحيدة البذرة غير متفتحة))",
 "acheronian": "جَحِيمِيّ, سِتِيجِيّ (مُظْلِم وكَئِيب كَأَنْهَار آخِيرُون وسْتِيكْس فِي العَالَم السُّفْلِيّ)",
 "acherontia atropos": "عثة رأس الموت (عثة صقرية أوروبية بعلامات على الظهر تشبه جمجمة بشرية)",
 "acherontic": "جَحِيمِيّ, سِتِيجِيّ (مُظْلِم وكَئِيب كَأَنْهَار آخِيرُون وسْتِيكْس فِي العَالَم السُّفْلِيّ)",
 "acheson process": "عملية أتشيسون (عملية صناعية لصنع الجرافيت عن طريق تسخين خليط من فحم الكوك والطين)",
 "acheta assimilis": "صرصور الحقل (صرصور أسود أمريكي شائع؛ يهاجم المحاصيل ويدخل المساكن أيضاً)",
 "acheta domestica": "صرصور المنزل الأوروبي (يعيش في مساكن البشر؛ استوطن في أجزاء من أمريكا)",
 "achievability": "قابلية التحقيق, منالية (حالة كونه قابلاً للتحقيق)",
 "achievable": "قَابِل لِلتَّحْقِيق, قَابِل لِلْإِنْجَاز (يمكن تحقيقه أو إنجازه؛ في حيّز الإمكان)",
 "achieve": "حَقَّقَ (حَقَّقَ (الأمرَ): أثبتَه وصدَّقَه؛ ويقال: حَقَّقَ الظنَّ، وحَقَّقَ القولَ والقضيّةَ؛ حَقَّقَ (الشيءَ والأمرَ): أحكمه؛ ويقال: حَقَّقَ الثوبَ: أحكم نَسْجَه)\nمثال: و أخيرا حقق هدفه.",
 "achievement": "إِنْجَاز",
 "achiever": "مُنجز, ناجح (شخص لديه سجل من النجاحات)\nمثال: لن يكون ابنه أبداً المنجز الذي كان عليه والده",
 "achillea": "أخيلية, قيصوم",
 "achillea millefolium": "ألفية, حزنبل (عشبة أوراسية قوية الرائحة منتشرة تشكل حصيرة في الأراضي البور أو السياج أو المراعي ذات أوراق مسننة ضيقة وزهيرات صغيرة بيضاء عادة؛ متوطنة على نطاق واسع…)",
 "achillea ptarmica": "ألفية العطاس, عشبة العطاس (عشبة أوراسية ذات رؤوس فضفاضة من الزهور البيضاء التي تشبه الأزرار وأوراق خضراء رمادية طويلة تسبب العطس عند سحقها)",
 "achilles": "أَخِيل ((أَخْيَلَ) فُلَان للذئب: أَقَامَ خيالا ليفزع مِنْهُ فَلَا يقرب الدَّابَّة؛ (أَخْيَلَ)عنِ القَوْم: كَعَّ عَنْهُمْ)",
 "achilles heel": "عَقِب أَخِيل, كَعْب أَخِيل",
 "achilles tendon": "وَتَر أَخِيل, عُرْقُوب (خيط شديد أو سلك يربط بين طرفي القوس ليستخدم في إطلاق السهام. سمي كذلك لأنه واحد، مشتق من الوِتْر وهو الفرد؛ خيط شديد أو سلك يربط على الآلة الموسيقية لإطلاق الصوت. سمي كذلك تشبيها له بوَتَر القَوْس)",
 "achilles' heel": "كعب أخيل, نقطة ضعف قاتلة (نقطة ضعف تبدو صغيرة ولكنها قاتلة)",
 "achimenes": "أشيمينيس, نبات الماء الساخن (أي نبات من جنس أشيمينيس ذو زهور مبهرجة على شكل جرس تشبه الغلوكسينيا)",
 "aching": "مُؤْلِمٌ بِشَكْلٍ خَفِيف, مُوجِع (يُسَبِّبُ أَلَمًا خَفِيفًا وَمُسْتَمِرًّا) / ألم, وجع (ألم خفيف مستمر (عادة متوسط الشدة))",
 "achira": "أكيرا, كنا هندية (كنا تزرع خاصة لجذمورها الصالح للأكل الذي يتم الحصول منه على نشا الأروروت)",
 "achlamydeous": "عَدِيم الغِلَاف الزَّهْرِيّ (ليس لديه غلاف زهري أو محيط زهرة)",
 "achlorhydria": "اللاهيدروكلورية, فقد حمض المعدة (نقص غير طبيعي أو غياب لحمض الهيدروكلوريك الحر في العصارة المعدية؛ يرتبط غالباً بفقر الدم الشديد وسرطان المعدة)",
 "achlorhydric": "فاقد لحمض الهيدروكلوريك, لا حمضي المعدة (يفتقر إلى حمض الهيدروكلوريك)",
 "achoerodus gouldii": "سمكة الخنزير العملاقة (توجد حول الحاجز المرجاني العظيم)",
 "acholia": "انحباس الصفراء, ركود صفراوي (حالة يفرز فيها القليل من الصفراء أو لا تفرز على الإطلاق، أو ينسد تدفق الصفراء إلى الجهاز الهضمي)",
 "achomawi": "لغة أتشوماوي (لغة شاستا يتحدث بها شعب أتشوماوي) / أشوماوي (فرد من مجتمع أشوماوي في شمال شرق كاليفورنيا)",
 "achomawi language": "لغة أتشوماوي (لغة شاستا يتحدث بها شعب أتشوماوي)",
 "achondrite": "نَيْزَك لَا كُونْدْرِيتِيّ (نيزك حجري يفتقر إلى الكوندريت)",
