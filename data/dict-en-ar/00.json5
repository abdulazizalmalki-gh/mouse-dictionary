 "adjustable": "قَابِل لِلتَّعْدِيل, قَابِل لِلضَّبْط (يمكن تنظيمه أو ضبطه) / قَابِلٌ لِلتَّعْدِيل, قَابِلٌ لِلضَّبْط (يُمْكِنُ تَغْيِيرُهُ لِيُلَائِمَ أَوْ يُنَاسِبَ)",
 "adjustable spanner": "مفتاح إنجليزي, مفتاح ربط قابل للتعديل (يمكن تغييره لإعدادات مختلفة)",
 "adjustable wrench": "مفتاح إنجليزي, مفتاح ربط قابل للتعديل (يمكن تغييره لإعدادات مختلفة)",
 "adjusted": "مَضْبُوط, مُعَدَّل (تم تغييره ليتلاءم مع متطلبات معينة أو ليصبح في علاقة مناسبة) / سَوِيّ, مُتَكَيِّف (متكيف مع متطلبات الحياة اليومية؛ يظهر استقراراً عاطفياً) / مُعَدَّل المَقَاس ((خاصّة للملابس) تمّ ضبط مقاسه أو طرازه) / مُتَأَقْلِم, مُتَكَيِّف (حقق علاقة مريحة مع بيئته)\nمثال: مطالبة تأمين معدلة",
 "adjuster": "مُسوي مطالبات, وكيل مطالبات (شخص يحقق في مطالبات التأمين أو المطالبات عن الأضرار ويوصي بتسوية فعالة)",
 "adjusting entry": "قيد تسوية (قيد محاسبي يتم إجراؤه في نهاية فترة محاسبية لتخصيص البنود بين الفترات المحاسبية)",
 "adjustive": "مُسَاعِد عَلَى التَّكَيُّف (يُعين على التكيّف والتأقلم)",
 "adjustment": "ضَبْط",
 "adjustor": "مُسوي مطالبات, وكيل مطالبات (شخص يحقق في مطالبات التأمين أو المطالبات عن الأضرار ويوصي بتسوية فعالة)",
 "adjutant": "لقلق مساعد (لقلق هندي كبير ذو مشية عسكرية) / مرافق عسكري, مساعد (ضابط يعمل كمساعد عسكري لضابط أعلى رتبة)",
 "adjutant bird": "لقلق مساعد (لقلق هندي كبير ذو مشية عسكرية)",
 "adjutant general": "رئيس الشؤون الإدارية, ياور عام (ياور الجنرال؛ كبير الموظفين الإداريين)",
 "adjutant stork": "لقلق مساعد (لقلق هندي كبير ذو مشية عسكرية)",
 "adjuvant": "مُساعِد, مُعَزِّز (يُعَزِّز فِعْل العِلاج الطِّبِّيّ) / إِضَافِيّ, مُسَاعِد (يقدم دعمًا إضافيًا) / عامل مساعد, مادة مساعدة (مادة مضافة تعزز فعالية العلاج الطبي)",
 "adlerian psychology": "علم النفس الأدلىري (فرع من التحليل النفسي طوره ألفريد أدلر؛ يركز على الاندماج الاجتماعي والأمن الجسدي والرضا الجنسي)",
 "adlumia fungosa": "أدلوميا, شاهترج متسلق (نبات متسلق بأوراق ريشية وأزهار بيضاء أو وردية؛ يوضع أحياناً في جنس الشاهترج)",
 "adman": "معلن (شخص عمله هو الإعلان)",
 "admass": "الجماهير المستهلكة (شريحة الجمهور التي تتأثر بسهولة بوسائل الإعلام (مصطلح بريطاني))",
 "administered price": "سعر إداري, سعر مُدار (سعر تمليه أي هيئة غير قوى السوق)",
 "administrable": "قَابِلٌ لِلْإِدَارَة (يمكن إدارته أو تسييره)",
 "administration": "إِدَارَة, مُرَاقَبَة (هو عملية تولي تَصْرِيف شؤون العَمَل. لا جمع له؛ مجموع الناس الذين يقومون بإدارة شؤون الجهة، حكومية كانت أم خاصة) / إِدَارَة تَنْفِيذِيَّة (هو عملية تولي تَصْرِيف شؤون العَمَل. لا جمع له؛ مجموع الناس الذين يقومون بإدارة شؤون الجهة، حكومية كانت أم خاصة)\nمثال: والدتي تنتظرني في الإدارة.",
 "administrative": "إداري (متعلق بالإدارة أو مسؤول عنها)",
 "administrative body": "هيئة إدارية, وحدة إدارية (وحدة ذات مسؤوليات إدارية)",
 "administrative data processing": "معالجة البيانات الإدارية, معالجة بيانات الأعمال (معالجة البيانات في المحاسبة أو إدارة الأعمال)",
 "administrative district": "تقسيم إداري, قطاع إداري (منطقة محددة لأغراض إدارية)",
 "administrative division": "تقسيم إداري, قطاع إداري (منطقة محددة لأغراض إدارية)",
 "administrative hearing": "جلسة استماع إدارية (جلسة استماع تتم خارج العملية القضائية أمام فاحصي جلسات الاستماع الذين مُنحوا سلطة قضائية خصيصاً لغرض إجراء مثل هذه الجلسات)",
 "administrative law": "قانون إداري (مجموعة القواعد واللوائح والأوامر والقرارات التي تنشئها الوكالات الإدارية الحكومية)",
 "administrative official": "بيروقراطي, مسؤول إداري (مسؤول في بيروقراطية)",
 "administrative unit": "هيئة إدارية, وحدة إدارية (وحدة ذات مسؤوليات إدارية)",
 "administratively": "إِدَارِيًّا (بواسطة أو لأجل مسؤول إداري)\nمثال: تم اتخاذ هذا القرار إدارياً",
 "administrator": "مُدِير, مُدِيرَة (الشخص الذي أدار، جمعه مُدِيرُون ومُدِيرِين؛ مهنة يتولى صاحبها إدَارَة شؤون جهة ما. جمعه مُدَرَاء)\nمثال: زيري هو المدير.",
 "administrivia": "تفاصيل إدارية, شؤون إدارية (التفاصيل المملة ولكن الضرورية التي يجب العناية بها والمهام التي يجب القيام بها في إدارة منظمة)",
 "admirability": "إِثَارَة الإِعْجَاب, رَوْعَة (الامتياز المثير للإعجاب)",
 "admirable": "جَدِير بِالْإِعْجَاب",
 "admirableness": "إِثَارَة الإِعْجَاب, رَوْعَة (الامتياز المثير للإعجاب)",
 "admirably": "بشكل جدير بالثناء, بشكل مثير للإعجاب (بطريقة مثيرة للإعجاب)\nمثال: كانت استجابات الأطفال طبيعية بشكل مثير للإعجاب",
 "admiral": "أَمِيرُ البَحْر, أَدْمِيرَال",
 "admiralty": "رتبة أميرال, منصب أميرال (منصب أو مكتب الأميرال) / الأميرالية, وزارة البحرية (الإدارة المسؤولة عن البحرية (كما في بريطانيا العظمى))",
 "admiralty brass": "نحاس أدميرالي, نحاس بحري (نحاس أصفر ألفا-بيتا يحتوي على القصدير؛ مقاوم لمياه البحر)",
 "admiralty law": "قانون بحري (فرع القانون الدولي الذي يتعامل مع المياه الإقليمية والدولية أو الشحن أو صيد الأسماك في المحيطات وما إلى ذلك)",
 "admiralty metal": "نحاس أدميرالي, نحاس بحري (نحاس أصفر ألفا-بيتا يحتوي على القصدير؛ مقاوم لمياه البحر)",
 "admiralty mile": "ميل بحري (وحدة بريطانية سابقة للطول تعادل 6,080 قدماً)",
 "admiration": "إِعْجَاب",
 "admire": "عَجَبَ",
