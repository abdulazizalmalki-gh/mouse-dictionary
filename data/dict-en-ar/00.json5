 "agriculturalist": "خبير زراعي, مزارع (شخص يعنى بعلم أو فن أو تجارة زراعة الأرض)",
 "agriculture": "زِرَاعَة, فِلَاحَة",
 "agriculture department": "وزارة الزراعة, وزارة الزراعة الأمريكية (الإدارة الفيدرالية التي تدير البرامج التي تقدم الخدمات للمزارعين (بما في ذلك البحوث وحفظ التربة وجهود تثبيت الاقتصاد الزراعي)؛ أنشئت عام 1862)",
 "agriculture secretary": "وزير الزراعة (منصب رئيس وزارة الزراعة) / وزير الزراعة (الشخص الذي يشغل منصب وزير وزارة الزراعة)\nمثال: تأسس منصب وزير الزراعة عام 1889",
 "agriculturist": "خبير زراعي, مزارع (شخص يعنى بعلم أو فن أو تجارة زراعة الأرض)",
 "agrigento": "جِرْجَنْت, كِرْكَنْت",
 "agrimonia": "غافث",
 "agrimonia eupatoria": "أغريمونيا يوباتوريا, غافث شائع (عشب معمر منتصب من العالم القديم في الموائل العشبية الجافة)",
 "agrimonia procera": "أغريمونيا طويلة, غافث عطري (عشب معمر أوروبي عطري يوجد عند هوامش الغابات في التربة الرطبة)",
 "agrimony": "غَافِث",
 "agriocharis ocellata": "ديك رومي ذو عيينة (ديك رومي بري من أمريكا الوسطى وشمال أمريكا الجنوبية)",
 "agrobiologic": "بيولوجي زراعي (من أو متعلق بالبيولوجيا الزراعية)",
 "agrobiological": "بيولوجي زراعي (من أو متعلق بالبيولوجيا الزراعية)",
 "agrobiology": "بيولوجيا زراعية (دراسة تغذية النبات ونموه خاصة كوسيلة لزيادة غلة المحاصيل)",
 "agrochemistry": "كِيمِيَاء زِرَاعِيّة (الحيلة والحِذق، وكان يراد بها عند القدماء: تحويل بعض المعادن إلى بعض، ولا يسما إلى الذهب؛ علم من علوم الطبيعة يتناول خواص العناصر والمركبات والقوانين التي تحكم تفاعلاتها)\nمثال: هو يحب الكيمياء.",
 "agroecosystem": "نِظَام بِيئِيّ زِرَاعِيّ (مَنْهَج، طَرِيقَة؛ تَرْتِيب واتِّسَاق)\nمثال: ليس بنظام كامل.",
 "agrologic": "أجرولوجي (من أو متعلق بعلم التربة الزراعية)",
 "agrological": "أجرولوجي (من أو متعلق بعلم التربة الزراعية)",
 "agrology": "علم التربة الزراعية (علم التربة وعلاقتها بالمحاصيل)",
 "agromania": "أغرومانيا, هوس الخلاء (رغبة شديدة في الانفراد أو التواجد في الأماكن المفتوحة)",
 "agronomic": "زراعي, فلاحي (من أو متعلق بعلم المحاصيل وإدارة التربة)",
 "agronomical": "زراعي, فلاحي (من أو متعلق بعلم المحاصيل وإدارة التربة)",
 "agronomist": "خبير زراعي, مهندس زراعي (خبير في إدارة التربة وإنتاج المحاصيل الحقلية)",
 "agronomy": "عِلْم الزِرَاعَة (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "agropyron cristatum": "عشبة القمح العرفية (عشبة أوراسية تزرع في منطقة السهول الكبرى بالولايات المتحدة للعلف ومكافحة التعرية)",
 "agropyron intermedium": "عشبة القمح المتوسطة (عشبة آسيوية أدخلت إلى المراعي في الولايات المتحدة للرعي والعلف)",
 "agropyron pauciflorum": "عشبة القمح النحيلة (عشبة أمريكية شمالية تزرع في غرب الولايات المتحدة كمحصول علف ممتاز)",
 "agropyron repens": "عشبة الكلب, نجيل زاحف (عشبة أوروبية تنتشر بسرعة عن طريق الجذامير الزاحفة؛ متوطنة في أمريكا الشمالية كعشبة ضارة)",
 "agropyron smithii": "عشبة القمح الغربية (عشبة علف قيمة في غرب الولايات المتحدة)",
 "agropyron subsecundum": "عشبة القمح الملتحية (عشبة قمح ذات سفا طرفي مستقيم على القنابات المزهرة)",
 "agropyron trachycaulum": "عشبة القمح النحيلة (عشبة أمريكية شمالية تزرع في غرب الولايات المتحدة كمحصول علف ممتاز)",
 "agrostemma githago": "خرم الحنطة, زهرة الذرة (نبات حولي أوروبي له أزهار بوقية كبيرة حمراء أرجوانية وبذور سامة؛ عشب ضار شائع في حقول الحبوب وعلى جوانب الطرق؛ مستوطن في أمريكا)",
 "agrostis alba": "قبأ الغابات (عشبة أوروبية نحيلة في الأماكن الظليلة؛ تزرع أيضاً في شمال شرق أمريكا وآسيا المعتدلة)",
 "agrostis canina": "أغروستيس مخملي, عشبة منحنية مخملية (عشبة شائعة بسيقان نحيلة وأوراق ضيقة)",
 "agrostis nebulosa": "عشبة السحاب (عشبة إسبانية ذات عناقيد ريشية خفيفة تزرع للباقات المجففة)",
 "agrostis palustris": "أغروستيس زاحف, عشبة منحنية زاحفة (عشبة مراعي أو مروج شائعة تنتشر عن طريق سيقان جارية طويلة)",
 "aground": "جَانِحًا (مع استقرار القاع على الأرض)\nمثال: جعل السفينة تجنح",
 "agrypnia": "سهر العيد (وقفة صلاة قبل أعياد معينة (مثل عيد الفصح))",
 "agrypnotic": "أرقي (من أو متعلق بالأرق)",
 "agua": "علجوم أغوا, علجوم القصب (أكبر أنواع العلاجم المعروفة؛ موطنه أمريكا الوسطى؛ مدمر قيم للآفات الحشرية)",
 "agua toad": "علجوم أغوا, علجوم القصب (أكبر أنواع العلاجم المعروفة؛ موطنه أمريكا الوسطى؛ مدمر قيم للآفات الحشرية)",
 "aguacate": "أفوكادو (فاكهة استوائية كمثرية الشكل ذات قشرة خضراء أو سوداء ولب مصفر غني يحيط ببذرة كبيرة واحدة)",
 "ague": "رعشة حمى, نفضية (نوبة من الارتعاش أو القشعريرة) / بردية, حمى الملاريا (مراحل متعاقبة من القشعريرة والحمى وهي عرض للملاريا)",
 "ague grass": "أليتريس, عشبة المغص (نبات له غلاف زهري محبب وزهور بيضاء؛ جنوب شرق الولايات المتحدة)",
 "ague root": "أليتريس, عشبة المغص (نبات له غلاف زهري محبب وزهور بيضاء؛ جنوب شرق الولايات المتحدة)",
 "ague weed": "جنطيانا خماسية الأوراق (جنطيانا من شرق أمريكا الشمالية لها عناقيد من الزهور الزرقاء الشائكة)",
 "agueweed": "جابر العظام, غافث مثقوب (عشب معمر في جنوب شرق الولايات المتحدة له رؤوس زهرية بيضاء الشعاع؛ كان يستخدم سابقاً في الطب الشعبي) / جنطيانا خماسية الأوراق (جنطيانا من شرق أمريكا الشمالية لها عناقيد من الزهور الزرقاء الشائكة)",
 "aguish": "مُصَاب بِالْحُمَّى الْمُتَقَطِّعَة (مصاب بالحمّى المتقطّعة (الملاريا))",
 "ah": "آه (صوت يستخدم للدلالة على الشعور بالألم العاطفي أو الجسدي؛ ألم، إما عاطفي أم جسدي)\nمثال: آه ، هناك فراشة!",
