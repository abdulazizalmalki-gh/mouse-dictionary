 "acuminate leaf": "ورقة مستدقة (ورقة تضيق إلى نقطة نحيلة)",
 "acupressure": "شياتسو, ضغط بالإبر (علاج الأعراض عن طريق تطبيق الضغط بالأصابع على نقاط ضغط محددة في الجسم)",
 "acupuncture": "الوَخْز بِالْإِبْر",
 "acute": "حَادّ (مَالَ وَانْحَرَفَ عَنِ الطَّرِيقِ؛ تَجَنَّبَ شَيْئًا أَوِ الْاِلْتِزَامَ بِمَسَارٍ مَعَيَّنٍ) / شَدِيد\nمثال: عندك ذاكرة حادة.",
 "acute accent": "نَبْرَة حَادَّة",
 "acute angle": "زَاوِيَة حَادَّة",
 "acute anterior poliomyelitis": "شلل الأطفال (مرض فيروسي حاد يتميز بالتهاب الخلايا العصبية في جذع الدماغ والحبل الشوكي)",
 "acute brain disorder": "اضطراب دماغي حاد, متلازمة الدماغ العضوية الحادة (أي اضطراب (مثل الارتباك المفاجئ أو التوهان) في شخص طبيعي، ناجم عن ضعف (مؤقت) قابل للعلاج في أنسجة المخ (بسبب إصابات الرأس أو المخدرات أو العدوى))",
 "acute gastritis": "التهاب المعدة الحاد (التهاب المعدة الناتج عن تناول مادة مهيجة (مثل تناول الكثير من الأسبرين))",
 "acute glaucoma": "زرق حاد, زرق مغلق الزاوية (زرق (غلوكوما) تقوم فيه القزحية بسد تدفق الخلط المائي)\nمثال: يمكن للزرق مغلق الزاوية أن يسبب تراكمًا سريعًا لضغط العين المرتفع مما يؤدي إلى تلف بصري دائم في غضون يومين",
 "acute glossitis": "التهاب اللسان الحاد (التهاب اللسان الناتج عن إصابة أو عدوى ويتميز بالتورم والألم)",
 "acute hemorrhagic encephalitis": "التهاب الدماغ النزفي الحاد (التهاب الدماغ الذي يشبه السكتة الدماغية بسبب تسرب الدم)",
 "acute inclusion body encephalitis": "التهاب الدماغ الهربسي, التهاب الدماغ بالهربس البسيط (شكل شائع من التهاب الدماغ الحاد يسببه الهربس البسيط 1؛ عادة ما يؤثر على الفصين الصدغي والجبهي)",
 "acute kidney failure": "فشل كلوي حاد (فشل كلوي مرتبط بحروق أو صدمات أخرى أو عدوى حادة أو انسداد المسالك البولية)",
 "acute leukemia": "ابيضاض الدم الحاد, لوكيميا حادة (لوكيميا سريعة التطور)",
 "acute lymphoblastic leukemia": "ابيضاض الدم اللمفاوي الحاد, لوكيميا لمفاوية حادة (لوكيميا حادة تتميز بتكاثر الخلايا الشبيهة بالأرومات اللمفاوية غير الناضجة في نخاع العظم والعقد اللمفاوية والطحال والدم؛ أكثر شيوعًا عند الأطفال)",
 "acute lymphocytic leukemia": "ابيضاض الدم اللمفاوي الحاد, لوكيميا لمفاوية حادة (لوكيميا حادة تتميز بتكاثر الخلايا الشبيهة بالأرومات اللمفاوية غير الناضجة في نخاع العظم والعقد اللمفاوية والطحال والدم؛ أكثر شيوعًا عند الأطفال)",
 "acute myelocytic leukemia": "ابيضاض الدم النقوي الحاد, لوكيميا نقوية حادة (لوكيميا حادة تتميز بتكاثر الكريات البيض الحبيبية؛ أكثر شيوعًا عند المراهقين والشباب)",
 "acute myeloid leukemia": "ابيضاض الدم النقوي الحاد, لوكيميا نقوية حادة (لوكيميا حادة تتميز بتكاثر الكريات البيض الحبيبية؛ أكثر شيوعًا عند المراهقين والشباب)",
 "acute organic brain syndrome": "اضطراب دماغي حاد, متلازمة الدماغ العضوية الحادة (أي اضطراب (مثل الارتباك المفاجئ أو التوهان) في شخص طبيعي، ناجم عن ضعف (مؤقت) قابل للعلاج في أنسجة المخ (بسبب إصابات الرأس أو المخدرات أو العدوى))",
 "acute pyelonephritis": "التهاب الحويضة والكلية الحاد (التهاب الحويضة والكلية الناتج عن انتشار عدوى المثانة)",
 "acute renal failure": "فشل كلوي حاد (فشل كلوي مرتبط بحروق أو صدمات أخرى أو عدوى حادة أو انسداد المسالك البولية)",
 "acute schizophrenic episode": "فصام تفاعلي, نوبة فصامية حادة (فصام مفاجئ الظهور وقصير المدة نسبياً (بضعة أسابيع أو أشهر))",
 "acute triangle": "مُثَلَّث حَادّ الزَّوَايَا",
 "acute-angled": "حَادّ الزَّاوِيَة (مَالَ وَانْحَرَفَ عَنِ الطَّرِيقِ؛ تَجَنَّبَ شَيْئًا أَوِ الْاِلْتِزَامَ بِمَسَارٍ مَعَيَّنٍ)\nمثال: عندك ذاكرة حادة.",
 "acute-angled triangle": "مثلث حاد الزوايا (مثلث جميع زواياه الداخلية حادة)",
 "acutely": "بشكل حاد (ذو بداية سريعة ومفاجئة (طبياً)) / بِدَهَاء, بِفِطْنَة (بطريقة ذكية) / بحدة, بشدة (بطريقة حادة أو نافذة) / بحدة, بزاوية حادة (تغير مفاجئ في الاتجاه والدرجة)\nمثال: فيروس مضعف بشكل حاد",
 "acuteness": "حدة (صفة امتلاك حافة أو طرف حاد) / ثقابة ذهن, حدة (ذكاء سريع ونافذ) / حدة (حساسية شديدة ومتطورة للغاية)\nمثال: جادل بحدة كبيرة",
