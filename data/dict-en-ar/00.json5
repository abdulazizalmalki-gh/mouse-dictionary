 "alienable": "قَابِل لِلتَّصَرُّف فِيه, قَابِل لِلنَّقْل (قابل للتحويل إلى مالك آخر)",
 "alienage": "أَجْنَبِيَّة, غَرَابَة (صفة كون الشخص أجنبياً)",
 "alienated": "مُتَنَافِر, مُنْفَصِل (أصبح غير محبوب بسبب الجفاء والبعد) / مُغْتَرِب, مُنْعَزِل (مُشَوَّش اجتماعياً ومنفصل عن محيطه)",
 "alienating": "مُبْعِد, مُنَفِّر (يُسَبِّب العَدَاء أَوْ فِقْدَان الوُدّ)",
 "alienation": "تنفير (فعل التنفير؛ فعل التسبب في العداء) / نقل الملكية ((قانون) النقل الطوعي والمطلق لسند الملكية وحيازة الممتلكات العقارية من شخص لآخر) / اغتراب, جفاء (الشعور بالغربة عن الآخرين) / اغتراب, نفرة (الانفصال الناتج عن العداء)\nمثال: سلوكه نفر الطلاب الآخرين",
 "alienation of affection": "إفساد المودة الزوجية (ضرر مدني يقوم على التدخل المتعمد والخبيث في العلاقة الزوجية من قبل طرف ثالث دون مبرر أو عذر)",
 "alienator": "مبغض, منفر (شخص بغيض يتسبب في جعل الناس الودودين غير مبالين أو غير ودودين أو عدائيين)",
 "alienee": "الممنوح له, المنقول إليه (شخص يُنقل إليه سند ملكية العقار)",
 "alienism": "أَجْنَبِيَّة, غَرَابَة (صفة كون الشخص أجنبياً) / طب الأمراض العقلية, طب نفسي (مصطلح قديم) (مصطلح قديم لدراسة وعلاج الأمراض العقلية)",
 "alienist": "طبيب نفسي شرعي (طبيب نفسي متخصص في الجوانب القانونية للمرض العقلي)",
 "alienor": "نَاقِل الْمِلْكِيَّة (شخص يتم نقل سند الملكية منه)",
 "alif": "أَلِف, ا (العدد الذي يساوي عَشْر مِئَات. يُذَكَّر بإعتبار لفظه المذكر وإذا كان عن النُقُود يؤنث بإعتبار أن النقود مؤنثه)\nمثال: ألف شكر على لطفك.",
