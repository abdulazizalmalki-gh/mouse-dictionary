 "abscission": "استئصال, بتر (عملية قطع شيء ما) / انفصال, تساقط (تساقط الزهور والأوراق والفاكهة بعد تكوين نسيج ندبي في النبات)",
 "absconder": "متواري عن الأنظار (هارب يهرب ويختبئ لتجنب الاعتقال أو الملاحقة القضائية)",
 "abscondment": "فرار, هروب (فعل الهروب سراً (لتجنب الاعتقال مثلاً))",
 "absecon": "أَبْسِيكُون",
 "abseil": "هبوط بالحبال ((تسلق الجبال) هبوط جرف عمودي أو جدار باستخدام حبل مزدوج مثبت في نقطة أعلى وملفوف حول الجسم)",
 "abseiler": "هابط بالحبال (شخص ينزل عبر وجه عمودي تقريبًا باستخدام حبل مزدوج ملفوف حول الجسم ومثبت بنقطة عالية)",
 "absence": "غِيَاب",
 "absence seizure": "غيبة, نوبة غياب (حدوث فقدان مفاجئ وعابر أو ضعف في الوعي (لا يتم تذكره لاحقاً)، أحياناً مع ارتعاش خفيف أو رفرفة الجفون، وما إلى ذلك؛ شائع في الصرع الصغير)",
 "absence without leave": "تغيب عسكري, غياب غير مصرح به (غياب عسكري غير مصرح به)",
 "absent": "غَائِب / شارِد",
 "absentee": "غائب (شخص غائب أو غير مقيم)",
 "absentee ballot": "ورقة اقتراع غيابي ((في الانتخابات) ورقة اقتراع يتم الإدلاء بها أثناء الغياب (عادة ما ترسل بالبريد قبل يوم الانتخابات))",
 "absentee rate": "مُعَدَّل الغِيَاب (النسبة المئوية للعمال الذين لا يحضرون للعمل)",
 "absenteeism": "غِيَاب",
 "absently": "بذهول, بشرود (بطريقة شاردة الذهن أو مشغولة البال)\nمثال: قرأ الرسالة بشرود",
 "absentminded": "سَارِح, شَارِد الذِّهْن (غارق في التفكير؛ يبدو مشغول البال ومنصرفًا عمّا حوله)",
 "absentmindedly": "بذهول, بشرود (بطريقة شاردة الذهن أو مشغولة البال)\nمثال: قرأ الرسالة بشرود",
 "absentmindedness": "شرود الذهن (انشغال كبير لدرجة تجاهل متطلبات الانتباه العادية)",
 "absinth": "أبسنت (ليكير أخضر قوي منكه بالشيح واليانسون)",
 "absinthe": "أبسنت (ليكير أخضر قوي منكه بالشيح واليانسون) / أفسنتين, شيح ابن سينا (عشبة عطرية في أوراسيا المعتدلة وشمال أفريقيا ذات طعم مر تستخدم في صنع مشروب الأفسنتين)",
 "absinthe oil": "زيت الشيح (زيت مر داكن يتم الحصول عليه من أوراق الشيح؛ ينكه مشروبات الأفسنتين)",
 "absolute": "مُطْلَق (المُطْلَق ؛ ضد المُقَيَّد، من يتحرك بلا قَيْد أو مَانِع؛ صفة: تركت الشرطة البريء مُطْلَق السراح) / مثال: \"متزوج؟\" \"مطلق.\"",
 "absolute alcohol": "كحول مطلق (كحول إيثيلي نقي (يحتوي على ما لا يزيد عن 1% ماء))",
 "absolute ceiling": "سَقْف الطَّيَرَان المُطْلَق (الحد الأقصى للارتفاع الذي يمكن للطائرة فيه الحفاظ على الطيران الأفقي)",
 "absolute deviation": "انحراف مطلق (في الإحصاء، هو الفرق المطلق بين عنصر من مجموعة بيانات ونقطة معينة)\nمثال: يعطي متوسط الانحراف المطلق هذا متوسط مسافة أي عنصر بيانات عن المتوسط، وبالتالي فهو مقياس جيد للانتشار",
 "absolute encoder": "مشفر مطلق (مشفر دوار يحافظ على معلومات الموضع عند انقطاع الطاقة عن النظام)",
 "absolute frequency": "تَرَدُّد مُطْلَق, تَكْرَار (عدد الملاحظات في فئة إحصائية معينة)",
 "absolute magnitude": "قدر مطلق ((في علم الفلك) المقدار الذي سيكون للنجم إذا شوهد من مسافة 10 فراسخ فلكية (32.62 سنة ضوئية) من الأرض)",
 "absolute majority": "أغلبية, أغلبية مطلقة ((انتخابات) أكثر من نصف الأصوات)",
 "absolute monarchy": "مَلَكِيَّة مُطْلَقَة",
 "absolute music": "موسيقى مطلقة (موسيقى آلية، مثل الكونشرتو أو الرباعية الوترية، لا تستمد أي إلهام أو لا تشير إلى نص أو برنامج أو صورة بصرية أو عنوان، وتوجد فقط من حيث شكلها الموسيقي…)",
 "absolute pitch": "سمع مطلق, طبقة صوتية مطلقة (القدرة على تحديد طبقة النغمة)",
 "absolute scale": "المقياس المطلق, مقياس كلفن (مقياس درجة حرارة يحدد الصفر المطلق عند 0 درجة)",
 "absolute space": "فضاء مطلق (الفضاء المادي المستقل عما يشغله)",
 "absolute temperature": "درجة حرارة مطلقة (درجة الحرارة المقاسة على المقياس المطلق)",
 "absolute threshold": "عتبة مطلقة (أدنى مستوى من التحفيز يمكن للشخص اكتشافه)",
 "absolute value": "قِيمَة مُطْلَقَة",
 "absolute viscosity": "لُزُوجَة دِينَامِيكِيَّة, لُزُوجَة مُطْلَقَة (مقياس لمقاومة تدفق مائع تحت تأثير قوة مطبقة)",
 "absolute zero": "صِفْر مُطَلِّق, دَرَجَة الصُّغَر الْمُطْلَق (الخَالِي كأنه تَصْفِر فيه الرِيح. ويقال أيضا صَفْر وصُفْر؛ في : هي عَدَد قيمته لا شيء، أو خالية)\nمثال: بدأ سامي من نقطة الصفر.",
 "absolutely": "مطلقا, على الإطلاق",
 "absoluteness": "إِطْلَاق, قَطْعِيَّة (صفة كون الشيء مطلقاً) / حدة, صرامة (صفة كون الشيء كاملاً أو مطلقاً أو متطرفاً)\nمثال: لا يمكن الطعن في قطعية مرسوم البابا",
 "absolution": "إِبْرَاء, غُفْرَان / تَبْرِئَة",
 "absolutisation": "إضفاء الإطلاق, إطلاق (عملية جعل شيء ما مطلقاً أو تحويله إلى مطلق)",
 "absolutism": "مطلقية (عقيدة الكائن المطلق، وترتبط غالباً بالمثالية في الفلسفة) / حكم مطلق, شمولية (معتقد أيديولوجي في السلطة الكاملة وغير المقيدة للحكومة) / استبدادية, دكتاتورية (شكل من أشكال الحكم يكون فيه الحاكم دكتاتوراً مطلقاً (غير مقيد بدستور أو قوانين أو معارضة وما إلى ذلك)) / استبداد, حكم مطلق (الهيمنة من خلال التهديد بالعقاب والعنف)",
 "absolutist": "استبدادي, مطلق (متعلق بمبدأ الشمولية) / مُؤَيِّد لِلحُكْم المُطْلَق (من يدعو إلى الحكم المطلق (الاستبدادي))",
 "absolutistic": "استبدادي, مطلق (متعلق بمبدأ الشمولية)",
 "absolutization": "إضفاء الإطلاق, إطلاق (عملية جعل شيء ما مطلقاً أو تحويله إلى مطلق)",
 "absolve": "بَرَّأَ (بَرَأَ اللَّهُ الخَلْقَ، كَجَعَلَ، بَرْءًا، وبُرُوءًا: خَلَقَهُمْ؛ المَرِيضُ يَبْرَأُ ويَبْرُؤُ بُرْءًا، بالضمِّ، وبَرُوءًا)",
 "absolved": "مُبَرَّأ, مُعْفًى (أُعفي من أي شبهة ذنب)",
 "absolver": "مانح الغفران (شخص يمنح الغفران أو الحل من الخطايا)",
 "absolvitory": "عَافٍ, غَافِر (يمنح البراءة أو الصفح عن الذنب)",
 "absorb": "اِتَّسَعَ, اِحْتَوَى / اِمْتَصَ, تَشَرَّبَ / اِحْتَلَّ, شَغَلَ (الموضعَ: نزل به وكان لغيره قبله؛ الجيشُ البلدَ: فتحها ثم نزل بها غصبا عن أهلها وبلا رضاهم، استولى عليها) / اِسْتَنْفَدَ / اِسْتَوْعَبَ, وَعَى / دَفَعَ, تَحَمَّلَ (لزّه ونحاه وأبعده؛ صرفه قبل وروده، أي منعه وأبعده قبل مجيئه أو حدوثه، وعكسه أن يرفعه، اي أن يصرفه بعد حدوثه)\nمثال: دفع زيري الثمن.",
 "absorbable": "قَابِل لِلاِمْتِصَاص (قادر على أن يُمتص أو يؤخذ من خلال مسام سطح ما)",
 "absorbance": "امتصاصية, كثافة ضوئية ((فيزياء) مقياس لمدى نقل المادة للضوء أو الإشعاع الكهرومغناطيسي الآخر)",
 "absorbate": "مادة ممتصة (مادة تم امتصاصها أو يمكن امتصاصها)",
 "absorbed": "مُسْتَغْرِق, مُنْهَمِك (مُنغمس تمامًا في شيء ما ومنصرف إليه بكلّيّته) / مُمْتَصّ (مُحتجَز دون انعكاس)",
 "absorbefacient": "مُعَزِّز لِلاِمْتِصَاص (يُحفِّز أو يُعزِّز عمليّة الامتصاص)",
 "absorbency": "امتصاصية (خاصية القدرة على الامتصاص)",
 "absorbent": "مُمْتَصّ",
 "absorbent cotton": "قطن طبي, قطن ماص (قطن أصبح ماصاً عن طريق إزالة الشمع الطبيعي)",
 "absorbent material": "مادة ماصة, ماص (مادة لها القدرة أو الميل لامتصاص مادة أخرى)",
 "absorber": "مادة ماصة ((فيزياء) مادة في مفاعل نووي تمتص الإشعاع)",
 "absorbing": "آسِر, شَائِق (قادر على جذب الانتباه والاستحواذ عليه)",
 "absorptance": "اِمْتِصَاصِيَّة, مُعَامِل الِامْتِصَاص (مقياس لمعدل انخفاض شدة الإشعاع الكهرومغناطيسي (كالضوء) عند مروره خلال مادة معينة؛ نسبة الطاقة الإشعاعية الساقطة الممتصة لكل وحدة كتلة أو سمك من…)\nمثال: الامتصاصية تساوي 1 ناقص النفاذية",
 "absorption": "اِمْتِصَاص",
 "absorption band": "حِزَام مَاصّ (خيط أو قطعة من جلد تستخدم لحَزْم النَبَات أو العِيدَان أو غيرها لتكوين حُزْمَة؛ النِطَاق، قطعة من الجِلْد الطَوِيل يلف حول الخَصْر إما ليمسك المَلابِس أو ليظهر الخصر)\nمثال: هذا حزام من الجلد.",
 "absorption coefficient": "اِمْتِصَاصِيَّة, مُعَامِل الِامْتِصَاص (مقياس لمعدل انخفاض شدة الإشعاع الكهرومغناطيسي (كالضوء) عند مروره خلال مادة معينة؛ نسبة الطاقة الإشعاعية الساقطة الممتصة لكل وحدة كتلة أو سمك من…)\nمثال: الامتصاصية تساوي 1 ناقص النفاذية",
 "absorption factor": "امتصاصية, قدرة الامتصاص ((في الفيزياء) خاصية الجسم التي تحدد جزء الإشعاع الساقط أو تدفق الصوت الذي يمتصه الجسم أو القابل للامتصاص)",
 "absorption indicator": "كاشف امتزاز (مؤشر يستخدم في التفاعلات التي تنطوي على ترسيب)",
 "absorption spectrum": "طيف الامتصاص (طيف الإشعاع الكهرومغناطيسي الذي مر عبر وسط امتص إشعاعاً بأطوال موجية معينة)",
 "absorption unit": "وحدة امتصاص (وحدة لقياس الامتصاص)",
 "absorptive": "مَاصّ, مُتَشَرِّب (لديه القدرة أو السعة أو الميل لامتصاص أو تشرب شيء ما (سوائل أو طاقة وما إلى ذلك))\nمثال: ماص مثل الإسفنج",
 "absorptivity": "مَصَّاصِيَّة",
 "abstain": "اِمْتَنَعَ (مَنَعَ نفسه؛ كان مَنِيْعًا يصعب الوصول إليه)",
 "abstainer": "عَازِف عَنِ الْكُحُول, مُمْتَنِع (شخص يمتنع عن شرب المشروبات المسكرة) / زاهد, ناسك (شخص يمارس نكران الذات كتأديب روحي)",
 "abstemious": "زَهِيد, مُتَقَشِّف (مقتصد في الاستهلاك خاصة الطعام والشراب) / قَنُوع, مُعْتَدِل (يَتَّسِمُ بِالاعْتِدَالِ فِي الانْغِمَاسِ وَالتَّنَعُّم)\nمثال: ملذات المائدة لم تكن ذات أهمية تذكر لشخص متقشف بطبعه",
 "abstemiously": "بِاعْتِدَال, بِتَقَشُّف (بطريقة مقتصدة؛ بدون إفراط)\nمثال: أكل وشرب باعتدال",
 "abstemiousness": "اعتدال, تقشف (الاعتدال في الأكل والشرب) / تقشف, زهد (الاقتصار على الضروريات المجردة)",
 "abstention": "اِمْتِنَاع, إِمْسَاك",
 "abstentious": "مُتَعَفِّف, مُمْتَنِع (ضابط لنفسه؛ لا يُسرف في إشباع شهوته خاصّة في الطعام والشراب)",
 "abstinence": "امتناع, تعفف (فعل أو ممارسة الامتناع عن الانغماس في شهوة ما) / امتناع, عفة (سمة الامتناع (خاصة عن الكحول))",
 "abstinent": "مُتَعَفِّف, مُمْتَنِع (ضابط لنفسه؛ لا يُسرف في إشباع شهوته خاصّة في الطعام والشراب) / عَازِف عَنِ الْكُحُول, مُمْتَنِع (شخص يمتنع عن شرب المشروبات المسكرة)",
 "abstract": "مُلَخَّص, حاصِل / مَعْنَوِيّ, تَجْرِيدِيّ",
 "abstract art": "تجريدية, فن تجريدي (نوع تجريدي من الفن؛ يعتمد المحتوى الفني على الشكل الداخلي بدلاً من التمثيل التصويري)",
 "abstract artist": "تجريدي, فنان تجريدي (رسام للوحات التجريدية)",
 "abstract entity": "تَجْرِيد, كِيَان مُجَرَّد (مفهوم عامّ يُستخلَص بانتزاع السمات المشتركة من أمثلة محدّدة)",
 "abstract expressionism": "تعبيرية تجريدية, رسم حركي (مدرسة رسم في نيويورك تتميز بالتجريدات التي تم إنشاؤها بحرية؛ أول مدرسة مهمة للرسم الأمريكي تتطور بشكل مستقل عن الأساليب الأوروبية)",
 "abstract noun": "اِسْم مَعْنًى (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)\nمثال: ما اسم حصان توم؟",
 "abstract thought": "استدلال, تفكير منطقي (تفكير متماسك ومنطقي)",
 "abstracted": "سَارِح, شَارِد الذِّهْن (غارق في التفكير؛ يبدو مشغول البال ومنصرفًا عمّا حوله)",
 "abstractedly": "بذهول, بشرود (بطريقة شاردة الذهن أو مشغولة البال)\nمثال: قرأ الرسالة بشرود",
 "abstractedness": "انشغال بال, ذهول (الانشغال بشيء ما واستبعاد كل شيء آخر)",
 "abstracter": "مختزل, ملخص (الشخص الذي يقوم بعمل ملخصات أو يوجز المعلومات)",
 "abstraction": "تَجْرِيد, كِيَان مُجَرَّد (مفهوم عامّ يُستخلَص بانتزاع السمات المشتركة من أمثلة محدّدة) / انتزاع, سحب (عملية سحب أو إزالة شيء ما) / لوحة تجريدية (لوحة فنية تجريدية) / انشغال بال, ذهول (الانشغال بشيء ما واستبعاد كل شيء آخر)",
 "abstractionism": "تجريدية, فن تجريدي (نوع تجريدي من الفن؛ يعتمد المحتوى الفني على الشكل الداخلي بدلاً من التمثيل التصويري) / تجريدية, لا واقعية (تمثيل لا يشير إلى كائنات ملموسة أو أمثلة محددة)",
 "abstractionist": "تَجْرِيدِيّ, لَا تَشْخِيصِيّ (لا يمثل أو يحاكي الواقع الخارجي أو أشكال الطبيعة) / تجريدي, فنان تجريدي (رسام للوحات التجريدية)",
 "abstractive": "تَجْرِيدِيّ (ذو طبيعة تجريدية أو لديه القدرة على التجريد)",
 "abstractly": "بشكل مجرد (بمصطلحات مجردة)",
 "abstractness": "تَجْرِيد, مَعْنَوِيَّة (صفة النظر إلى الشيء بمعزل عن مثال أو كائن محدد)",
 "abstractor": "مختزل, ملخص (الشخص الذي يقوم بعمل ملخصات أو يوجز المعلومات)",
 "abstruse": "عَوِيص, غَامِضٌ عَمِيق (صعب الفهم؛ غير مفهوم لذوي المعرفة العادية)",
 "abstrusely": "بِغُمُوض (بطريقة يصعب فهمها)\nمثال: نظريات الأستاذ الغامضة ضاعت على طلابه",
 "abstruseness": "الْتِبَاس, خَفَاء (صفة كون الشيء غير واضح أو عويصاً وصعب الفهم) / عمق, عوص (الحكمة التي تتسم بالغموض والصعوبة والعمق)\nمثال: أعجب عالم الأنثروبولوجيا بعمق الأمثال المحلية",
 "abstrusity": "عمق, عوص (الحكمة التي تتسم بالغموض والصعوبة والعمق)\nمثال: أعجب عالم الأنثروبولوجيا بعمق الأمثال المحلية",
 "absurd": "عَبَثِيّ, سَخِيف",
 "absurdism": "عَبَثِيَّة",
 "absurdist humor": "فُكَاهَة سِرْيَالِيَّة, فُكَاهَة عَبَثِيَّة (شكل من أشكال الفكاهة يقوم على انتهاكات متعمدة للتفكير السببي، مما ينتج أحداثاً وسلوكيات غير منطقية بوضوح)",
 "absurdist humour": "فُكَاهَة سِرْيَالِيَّة, فُكَاهَة عَبَثِيَّة (شكل من أشكال الفكاهة يقوم على انتهاكات متعمدة للتفكير السببي، مما ينتج أحداثاً وسلوكيات غير منطقية بوضوح)",
 "absurdity": "سَخَافَة",
 "absurdly": "إِلَى حَدّ اللَّامَعْقُول, بِشَكْل سَخِيف (بطريقة سخيفة أو لدرجة سخيفة)\nمثال: شابة غنية بشكل سخيف",
 "absurdness": "سَخَافَة, عَبَث (رسالة يتعارض محتواها مع العقل)",
 "abu bakr": "أَبُو بَكْر",
 "abu dhabi": "أَبُو ظَبْي / إِمَارَة أَبُو ظَبْي (الإمَارَة : منصِب الأمير؛ الإمَارَة: دَوْلَة أو مَنْطِقَة أو جُزْء من الأَرْض يحكمه أَمِير)",
 "abu el matamir": "ابو المطامير",
 "abu suweir": "أبو صوير",
 "abudefduf saxatilis": "سمكة الرقيب, سمكة العريف (سمكة قعيسية كبيرة زرقاء رمادية مخططة بالأسود؛ توجد في جميع أنحاء العالم تقريباً)",
 "abugida": "أَبُوجِيدَا",
 "abuja": "أَبُوجَا",
 "abulia": "أبوليا, انعدام الإرادة (فقدان قوة الإرادة)",
 "abulic": "أَبُولِيّ, عَدِيم الإِرَادَة (يعاني من فقدان الإرادة؛ يظهر عجزًا مَرَضيًّا عن الفعل أو اتخاذ القرارات)",
 "abundance": "كَثْرَة, غَزَارَة",
 "abundant": "وافِر, وَفِير",
 "abundantly": "بغزارة, بوفرة (بطريقة وفيرة)\nمثال: تم تزويدهم بالطعام بوفرة",
 "abuse": "تَعَسُّف, طُغْيَان / مَسَبَّة, شَتِيمَة / إِيذَاء جَسَدِيّ / اِنْتِهَاك جَسَدِيّ / أَسَاءَ اِسْتِعْمَالَ / آذَى / أَهَانَ, سَبَّ (شخص يكون لئيم لآخر بالكلام) / اِغْتَصَبَ, اِنْتَهَكَ (غَصَبَ؛ زَنَى (بِفُلَانَةٍ) قَهْرًا/غَصْبًا) / خَدَعَ, غَشَّ (غَشَّ، مَكَرَ؛ خَادَعَ شخصًا: خدعه بشكل مستمر أو بطريقة خفية)\nمثال: أهان سامي ليلى بقص شعرها.",
 "abused": "مُسَاء مُعَامَلَتُه, مُضْطَهَد (خاضع لمعاملة قاسية) / مُفْرَطٌ فِي اسْتِخْدَامِه (اسْتُخْدِمَ بِشَكْلٍ غَيْرِ سَلِيمٍ أَوْ مُفْرِطٍ خَاصَّةً المُخَدِّرَات)\nمثال: زوجة معنفة",
 "abuser": "مسيء, منتهك (شخص يمارس الإساءة)",
 "abusive": "مُؤْذٍ, مُسِيء",
 "abusively": "بتعسف, بشكل مسيء (بطريقة مسيئة)\nمثال: تصرف بشكل مسيء تجاه أطفاله",
 "abutilon theophrasti": "أبو طيلون, خبازة هندية (عشب حولي طويل أو شجيرة صغيرة من آسيا الاستوائية بأوراق مخملية وزهور صفراء وينتج أليافاً قوية)",
 "abutment": "دعامة جسر (دعامة حجرية تلامس وتتلقى مباشرة دفع أو ضغط القوس أو الجسر) / دعامة, نقطة التماس (نقطة تلامس بين جسمين أو جزأين)",
 "abutment arch": "قوس الدعامة (قوس مدعوم بدعامة)",
 "abutter": "جار ملاصق (مالك العقار الملاصق)",
 "abuzz": "طَنَّان, مُزِنّ (صاخب كصوت طنين النحل)",
 "abvolt": "أبفولت (وحدة للجهد تساوي واحد من مائة مليون من الفولت)",
 "abwatt": "أبواط (وحدة قدرة تساوي القدرة المبددة عندما يتدفق 1 أبأمبير عبر فرق جهد مقداره 1 أبفولت)",
 "abydos": "أبيدوس",
 "abysm": "قرار سحيق, هاوية (خليج أو حفرة لا قرار لها؛ أي تجويف أو هوة أو فراغ لا يمكن سبر غوره (أو يبدو كذلك) يمتد للأسفل (غالباً ما تستخدم مجازياً))",
 "abysmal": "سَحِيق, لَا قَرَار لَهُ (يُشْبِهُ الهَاوِيَةَ فِي عُمْقِهِ؛ عَمِيقٌ جِدًّا لَا يُمْكِنُ قِيَاسُهُ) / سَحِيق, هَائِل (عظيم جداً؛ بلا حدود)",
 "abysmally": "بشكل سيء للغاية, بشكل فظيع (بطريقة فظيعة)\nمثال: تغني بشكل فظيع",
 "abyss": "هَاوِيَة (مؤنث هاوٍ، الساقطة أو الواقعة؛ مؤنث هَاوٍ، المحبّة) / هَاوِيَة, هُوَّة (مؤنث هاوٍ، الساقطة أو الواقعة؛ مؤنث هَاوٍ، المحبّة)\nمثال: وصل سامي إلى قاع الهاوية ماليا.",
 "abyssal": "سَحِيق, لَا قَرَار لَهُ (يُشْبِهُ الهَاوِيَةَ فِي عُمْقِهِ؛ عَمِيقٌ جِدًّا لَا يُمْكِنُ قِيَاسُهُ) / سحيق, غوري (يتعلق بأعماق المحيط من 2000 إلى 5000 متر)",
 "abyssal zone": "المنطقة السحيقة, نطاق الأعماق (أعماق البحر (2000 متر أو أكثر) حيث لا يوجد ضوء)",
 "abyssinia": "الْحَبَشَة",
 "abyssinian": "قط حبشي (سلالة صغيرة نحيلة قصيرة الشعر من أصل أفريقي ذات فراء بني مع طبقة تحتية حمراء)",
 "abyssinian banana": "إنست, موز حبشي (عشب شجري دائم الخضرة كبير له أوراق ضخمة تشبه المجداف ويحمل ثماراً تشبه الموز غير صالحة للأكل ولكن براعم أزهاره الصغيرة صالحة للأكل؛ يوضع أحياناً في…)",
 "abyssinian cat": "قط حبشي (سلالة صغيرة نحيلة قصيرة الشعر من أصل أفريقي ذات فراء بني مع طبقة تحتية حمراء)",
 "ac": "تيار متردد (تيار كهربائي يعكس اتجاهه بشكل جيبي) / أكتينيوم (عنصر مشع من سلسلة الأكتينيدات؛ يوجد في خامات اليورانيوم)\nمثال: في الولايات المتحدة، معظم التيار المنزلي هو تيار متردد بتردد 60 دورة في الثانية",
 "acacia": "أَقَاقِيَا, سَنْط",
 "acacia auriculiformis": "أكاسيا أذينية, سنط أسود (شجرة أسترالية تنتج مواد دباغة)",
 "acacia cambegei": "جيدجي, سنط كريه الرائحة (سنط أسترالي شجيري ذو أزهار كريهة الرائحة للغاية)",
 "acacia catechu": "سنط الكادي, كاث هندي (شجرة شائكة من جزر الهند الشرقية لها أوراق ريشية مزدوجة وزهور صفراء تليها قرون مسطحة؛ مصدر للكاث الأسود)",
 "acacia dealbata": "سنط فضي, ميموزا (شجرة أسترالية دائمة الخضرة ذات لحاء وأوراق صغيرة بيضاء أو فضية وزهور صفراء)",
 "acacia farnesiana": "أكاسيا حلوة, سنط عنبري (شجيرة شائكة أو شجرة صغيرة من أمريكا الاستوائية؛ تستخدم زهورها الصفراء العطرة في صناعة العطور)",
 "acacia melanoxylon": "خشب النور, سنط أسود الخشب (أكاسيا أسترالية طويلة تنتج أخشاباً سوداء ذات قيمة عالية)",
 "acacia pycnantha": "سنط ذهبي (شجرة أسترالية شجيرية ذات عناقيد من الزهور الصفراء الذهبية العطرة؛ تزرع على نطاق واسع كنبات زينة)",
 "acacia xanthophloea": "سنط أصفر اللحاء, شجرة الحمى (شجرة أفريقية يُعتقد أنها تشير إلى المناطق الصحية)",
 "academe": "الأوساط الأكاديمية, المجتمع الأكاديمي (العالم الأكاديمي)",
 "academia": "الأوساط الأكاديمية, المجتمع الأكاديمي (العالم الأكاديمي)",
 "academic": "أَكَادِيمِيّ / أستاذ, جامعي (الْمُعَلِّمُ العَالِمُ بِمَا يُعَلِّمُ وَيُدَرِّسُ العارِف لَهُ؛ لقب علميّ جامعيّ، وهو على درجات، أستاذ مساعد وأستاذ مشارك وأستاذ كرسيّ وأستاذ مُبَرِّز)\nمثال: الأستاذ على حق.",
 "academic administrator": "إداري أكاديمي (إداري في كلية أو جامعة)",
 "academic art": "أكاديمية, فن أكاديمي (أسلوب في الرسم والنحت أنتج تحت تأثير أكاديميات الفن الأوروبية)\nمثال: الإعداد ومعالجة الموضوع هنا نموذجيان لنهجه الفني، الذي يقع بين الأكاديمية المثالية لبوغيرو والواقعية الاجتماعية لدواميه",
 "academic costume": "زي أكاديمي (زي يُرتدى في المناسبات الرسمية من قبل أعضاء هيئة التدريس أو طلاب الجامعة)",
 "academic degree": "درجة أكاديمية, درجة علمية (جائزة تمنحها كلية أو جامعة للدلالة على أن المتلقي قد أتم بنجاح دورة دراسية)\nمثال: حصل على درجته العلمية من برينستون بامتياز مع مرتبة الشرف",
 "academic department": "قسم أكاديمي, قسم علمي (قسم في مدرسة أو جامعة مسؤول عن مادة دراسية معينة)",
 "academic freedom": "حرية أكاديمية (حرية المعلمين والطلاب في التعبير عن أفكارهم في المدرسة دون قيود دينية أو سياسية أو مؤسسية)",
 "academic gown": "روب أكاديمي, روب القضاة (رداء يرتديه الأكاديميون أو القضاة)",
 "academic program": "برنامج أكاديمي ((التعليم) برنامج تعليمي في الفنون الليبرالية والعلوم (عادة للتحضير للتعليم العالي))",
 "academic relation": "عَلَاقَة أَكَادِيمِيَّة (علاقة مهنية بين المعلمين والذين يقومون بتعليمهم)",
 "academic requirement": "متطلب أكاديمي (شرط للقبول في برنامج أكاديمي أو إتمامه)",
 "academic robe": "روب أكاديمي, روب القضاة (رداء يرتديه الأكاديميون أو القضاة)",
 "academic session": "فترة دراسية, فصل دراسي (الوقت الذي تعقد فيه المدرسة الفصول الدراسية)\nمثال: اضطروا لتقصير الفصل الدراسي",
 "academic term": "فترة دراسية, فصل دراسي (الوقت الذي تعقد فيه المدرسة الفصول الدراسية)\nمثال: اضطروا لتقصير الفصل الدراسي",
 "academic year": "سنة دراسية, عام أكاديمي (الفترة الزمنية من كل عام التي تكون فيها المدرسة مفتوحة والناس يدرسون)",
 "academically": "أكاديمياً, دراسياً (فيما يتعلق بالشؤون الأكاديمية أو الدراسية)\nمثال: أكاديمياً، هذه مدرسة جيدة",
 "academician": "أَكَادِيمِيّ, أَكَادِيمِيَّة",
 "academicianship": "عضوية أكاديمية (منصب عضو في أكاديمية فخرية)",
 "academicism": "سُكُولَائِيَّة, مَدْرَسِيَّة (أرثوذكسية من النوع المدرسي (السكولائي)) / أَكَادِيمِيَّة, نَظَرِيَّة بَحْتَة (الأفكار والمواقف التخمينية البحتة) / أكاديمية, فن أكاديمي (أسلوب في الرسم والنحت أنتج تحت تأثير أكاديميات الفن الأوروبية)\nمثال: الإعداد ومعالجة الموضوع هنا نموذجيان لنهجه الفني، الذي يقع بين الأكاديمية المثالية لبوغيرو والواقعية الاجتماعية لدواميه",
 "academism": "سُكُولَائِيَّة, مَدْرَسِيَّة (أرثوذكسية من النوع المدرسي (السكولائي)) / أكاديمية, فن أكاديمي (أسلوب في الرسم والنحت أنتج تحت تأثير أكاديميات الفن الأوروبية)\nمثال: الإعداد ومعالجة الموضوع هنا نموذجيان لنهجه الفني، الذي يقع بين الأكاديمية المثالية لبوغيرو والواقعية الاجتماعية لدواميه",
 "academy": "مَجْمَع, جَامِعَة (اسم مفعول من جَمَّعَ؛ كُلِّيَّة، جَامِعَة) / مَجْمَع, أَكَادِيمِيَّة (اسم مفعول من جَمَّعَ؛ كُلِّيَّة، جَامِعَة)\nمثال: كان سامي يعيش في مجمع مسور.",
 "academy award": "أوسكار, جائزة الأوسكار (جائزة سنوية تمنحها أكاديمية فنون وعلوم الصور المتحركة للإنجازات في إنتاج وأداء الأفلام)",
 "academy of motion picture arts and sciences": "أكاديمية فنون وعلوم الصور المتحركة (أكاديمية تمنح جوائز سنوية للإنجازات في إنتاج الصور المتحركة والأداء)",
 "academy of television arts and sciences": "أكاديمية فنون وعلوم التلفزيون (أكاديمية تمنح جوائز سنوية للإنجازات البارزة في التلفزيون)",
 "acadian": "أكادي (مستوطن فرنسي مبكر في المقاطعات البحرية الكندية)",
 "acalypha virginica": "أكاليفا فرجينيا (عشب ضار في شرق أمريكا الشمالية)",
 "acalyptrate": "أَكَالِيبْتْرَاتِيّ",
 "acantha": "شوكة, مهز (أي نتوء حاد الرأس)",
 "acanthion": "شوكة الأنف الأمامية (نقطة قياس القحف عند الطرف الأمامي للدرز بين الفكين)",
 "acanthisitta chloris": "طائر البندقية (طائر صغير أخضر وبرونزي)",
 "acanthocephalan": "شائكات الرؤوس (أي من الديدان المختلفة التي تعيش طفيلياً في أمعاء الفقاريات ولها خرطوم قابل للسحب مغطى بالعديد من الأشواك المعقوفة)",
 "acanthocereus pentagonus": "صبار بيتاهايا (صبار من جنوب غرب الولايات المتحدة وشمال المكسيك له ثمار عصارية صالحة للأكل)",
 "acanthocereus tetragonus": "صبار بيتاهايا (صبار من جنوب غرب الولايات المتحدة وشمال المكسيك له ثمار عصارية صالحة للأكل)",
 "acanthocybium solandri": "واهو (سمكة طعام وصيد كبيرة سريعة الحركة ومفترسة؛ توجد في جميع أنحاء العالم)",
 "acanthocyte": "خلية شائكة (خلية دم حمراء غير طبيعية لها نتوءات شائكة من البروتوبلازم)",
 "acanthocytosis": "كثرة الخلايا الشائكة (وجود خلايا شائكة في مجرى الدم)",
 "acanthoid": "شَائِك, شَوْكِيّ (على شكل شوكة أو عمود فقري)",
 "acantholysis": "انحلال الأشواك (انهيار طبقة خلوية في البشرة (كما في الفقاع))",
 "acanthoma": "ورم جلدي, ورم شائكي (ورم ينشأ في البشرة)",
 "acanthophis antarcticus": "أفعى الموت (ثعبان أسترالي سام يشبه الأفعى)",
 "acanthopterygian": "شائكات الزعانف (سمكة عظمية ذات زعانف مدعومة بأشعة حادة غير مرنة)",
 "acanthoscelides obtectus": "سوسة الفاصوليا (تعيش اليرقات وتتغذى في الفاصوليا النامية أو المخزنة)",
 "acanthosis": "شواك (سماكة غير طبيعية ولكنها حميدة لطبقة الخلايا الشائكة في الجلد)",
 "acanthosis nigricans": "شواك أسود (مرض جلدي يتميز ببقع داكنة تشبه الثآليل في ثنايا الجسم)",
 "acanthotic": "شواكي (من أو متعلق بمرض الشواك الجلدي)",
 "acanthous": "شَائِك, شَوْكِيّ (على شكل شوكة أو عمود فقري)",
 "acanthurus chirurgus": "السمكة الطبيبة, سمكة الجراح (سمكة جراح تعيش في جزر الهند الغربية)",
 "acanthus": "أكانثوس, قنطيكون",
 "acanthus mollis": "أقنثة, أقنثة ناعمة (أقنثة جنوب أوروبية تزرع على نطاق واسع بزهور بيضاء ذات عروق أرجوانية)",
 "acapnia": "نقص كربونات الدم (حالة يكون فيها مستوى ثاني أكسيد الكربون في الدم أقل من الطبيعي؛ يمكن أن تنتج عن التنفس العميق أو السريع)",
 "acapnial": "عديم الكربنة, ناقص ثاني أكسيد الكربون (يتعلق أو يظهر حالة نقص ثاني أكسيد الكربون في الدم)",
 "acapnic": "عديم الكربنة, ناقص ثاني أكسيد الكربون (يتعلق أو يظهر حالة نقص ثاني أكسيد الكربون في الدم)",
 "acapnotic": "عديم الكربنة, ناقص ثاني أكسيد الكربون (يتعلق أو يظهر حالة نقص ثاني أكسيد الكربون في الدم)",
 "acapulco gold": "أكابولكو غولد, المكسيكي الأخضر (نوع قوي بشكل خاص من الماريجوانا)",
 "acaracide": "مبيد العث, مبيد القراد (عامل كيميائي يستخدم لقتل العث والقراد)",
 "acardia": "انعدام القلب (غياب خلقي للقلب (كما في تطور بعض المسوخ))",
 "acariasis": "جرب, داء الحلم (الإصابة بحلم الحكة)",
 "acaricide": "مبيد العث, مبيد القراد (عامل كيميائي يستخدم لقتل العث والقراد)",
 "acarid": "سوس (عنكبوتيات صغيرة جداً حرة المعيشة تتطفل على الحيوانات أو النباتات؛ قريبة من القراد)",
 "acaridiasis": "جرب, داء الحلم (الإصابة بحلم الحكة)",
 "acarine": "قراديات (حلم أو قراد)",
 "acariosis": "جرب, داء الحلم (الإصابة بحلم الحكة)",
 "acaroid resin": "راتنج أكارويد (راتنج قابل للذوبان في الكحول من أشجار أسترالية؛ يستخدم في الورنيش وفي صناعة الورق)",
 "acarophobia": "رهاب الحشرات الصغيرة, رهاب العث (خوف مرضي من الحشرات الصغيرة والعث والديدان)",
 "acarpellous": "عَدِيم الكَرَابِل (ليس لديه كرابل)",
 "acarpelous": "عَدِيم الكَرَابِل (ليس لديه كرابل)",
 "acarpous": "عَقِيم, غَيْر مُثْمِر (لَا يُنْتِجُ ثِمَارًا)",
 "acarus": "سوس",
 "acaryote": "خلية عديمة النواة (خلية بدون نواة (مثل كريات الدم الحمراء))",
 "acatalectic": "تَامّ, غَيْر مَنْقُوص الوَزْن ((في الشعر) كامل الوزن؛ خاصة وجود العدد الكامل من المقاطع في التفعيلة الأخيرة) / بيت تام التفعيلات ((في العروض) بيت شعر يحتوي على العدد الكامل من المقاطع)",
 "acataphasia": "تعذر العبارة, عدم القدرة على صياغة الجمل (اضطراب تترك فيه آفة في الجهاز العصبي المركزي الشخص غير قادر على صياغة جملة أو التعبير عن نفسه بطريقة منظمة)",
 "acathexia": "سلس, عدم الاستمساك (عدم القدرة على احتباس إفرازات الجسم)",
 "acathexis": "انعدام الشحنة الانفعالية, برود عاطفي مرضي ((التحليل النفسي) نقص في الشحنة الانفعالية؛ حالة لا تثير فيها الأشياء أو الذكريات المهمة أي عاطفة)",
 "acaudal": "أَبْتَر, عَدِيم الذَّيْل (يفتقر إلى ذيل أو زائدة تشبه الذيل)",
 "acaudate": "أَبْتَر, عَدِيم الذَّيْل (يفتقر إلى ذيل أو زائدة تشبه الذيل)",
 "acaulescent": "عَدِيم السَّاق ((للنباتات) ليس لديها ساق ظاهرة فوق الأرض)",
 "acc": "قيادة القتال الجوي (قيادة تعد المزود الأساسي لأنظمة أسلحة القتال الجوي للقوات الجوية الأمريكية؛ تشغل الطائرات المقاتلة والقاذفة والاستطلاعية وإدارة المعارك والإنقاذ)",
 "accaroid resin": "راتنج أكارويد (راتنج قابل للذوبان في الكحول من أشجار أسترالية؛ يستخدم في الورنيش وفي صناعة الورق)",
 "accelerando": "بِتَسَارُع (بسرعة متزايدة) / أَتْشِيلِيرَانْدُو ((في الموسيقى) يتصاعد تدريجيًّا في سرعة الإيقاع) / تسارع (وتيرة متزايدة تدريجياً للموسيقى)\nمثال: هنا يجب أن تعزف بتسارع",
 "accelerate": "سَرَّعَ (سَرُعَ يَسْرُعُ سَراعَة، وسُراعَة، وَسِرْعًا: سَرِع؛ فهو سَريعٌ. والجمع: سِراعٌ، وسُرْعَانٌ) / اِسْتَعْجَلَ / أَسْرَعَ (أَسْرَعَ: ( فعل )؛ أَسْرَعُ)\nمثال: اركض بأقصى سرعة.",
 "accelerated": "مُسَرَّع, مُكَثَّف (تَمَّ تَسْرِيعُه، كَمَا فِي دَوْرَة أَكَادِيمِيَّة مُكَثَّفَة)",
 "acceleration": "تَسَارُع (عَجَلَة، تزايُد السرعة بالنسبة إلى الزمن في جسم من الأَجسام المتحرِّكة؛ إِسْرَاعٍ وَتَسَابُقٍ فِي الجَرْيِ)\nمثال: تسارع السائق بسيارته.",
 "acceleration unit": "وحدة تسارع (وحدة لقياس التسارع)",
 "accelerative": "تَسَارُعِيّ (يميل إلى زيادة السرعة)",
 "accelerator": "مُسَرِّع / مُعَجِّل / دَوَّاسَةُ الوَقُود",
 "accelerator factor": "برو أكسيليرين (عامل تخثر)",
 "accelerator pedal": "دواسة البنزين, دواسة الوقود (دواسة تتحكم في صمام الخانق)\nمثال: داس على دواسة الوقود",
 "acceleratory": "تَسَارُعِيّ (يميل إلى زيادة السرعة)",
 "accelerometer": "مقياس التسارع (أداة لقياس تسارع الطائرات أو الصواريخ)",
 "accent": "نَبْر, تَأْكِيد / شَكْل, شَكْلَة ((شَكَلَ) الأمْرُ يَشْكُلُ شُكُولاً: الْتَبَسَ؛ (شَكَلَ) المريضُ: تماثَلَ) / نَبْر\nمثال: اجلس بشكل مريح.",
 "accent mark": "علامة نبر, نبرة (علامة تشكيل تُستخدم للإشارة إلى التشديد أو توضع فوق حرف متحرك للإشارة إلى نطق خاص)",
 "accented": "مشدد, منبور (يحمل نبرة أو شدة) / منبور, نغمي ((للمقاطع) تحمل النبرة الرئيسية، وعادة ما تكون مصحوبة بتغيير في طبقة الصوت)\nمثال: التفعيلة تتكون من مقطع غير منبور يليه مقطع منبور",
 "accenting": "تأكيد, تشديد (فعل إعطاء أهمية خاصة أو دلالة لشيء ما)",
 "accentor": "لهجة (طَرَفُ ٱللِّسَانِ؛ جَرْسُ ٱلْكَلَامِ)\nمثال: الشاوية هي لهجة للأمازيغية.",
 "accentual": "نبري ((للشعر) له نظام متري يعتمد على النبر بدلاً من المقاطع أو الكمية) / نبري (من أو متعلق بالنبر أو التشديد)\nمثال: الشعر النبري يعتمد على عدد النبرات في السطر",
 "accentual system": "نظام النبر (نظام النبر المستخدم في لغة معينة)",
 "accentuation": "تأكيد, تشديد (فعل إعطاء أهمية خاصة أو دلالة لشيء ما) / تنبـير (استخدام أو تطبيق النبر؛ البروز النسبي للمقاطع في عبارة أو قول)",
 "accept": "قَبِلَ (وضع فمه على الشخص أو الشيء علامة الحب والاحترام. في العاميّة يُقال بَاسَ) / اِعْتَرَفَ\nمثال: كنت هنا من قبل.",
 "acceptability": "مَقْبُولِيَّة (الإرضاء بحكم المطابقة للمعايير المعتمدة)",
 "acceptable": "مَقْبُول, مُرْضٍ (جدير بالقبول أو مرضٍ) / مَقْبُول, وَافٍ بِالغَرَض (كَافٍ لِتَحْقِيقِ الغَرَضِ المَطْلُوبِ) / لَائِق, مَقْبُول (يفي بالمتطلبات والمعايير المطلوبة) / مَقْبُول, مُسْتَسَاغ (يُحكَم عليه بأنه متوافق مع الاستخدام اللغوي المعتمد)\nمثال: مستويات مقبولة من الإشعاع",
 "acceptableness": "مَقْبُولِيَّة (الإرضاء بحكم المطابقة للمعايير المعتمدة)",
 "acceptably": "بشكل محتمل, بشكل مقبول (بطريقة مقبولة (ولكن ليست متميزة))\nمثال: تلعب التنس بشكل مقبول",
 "acceptance": "قَبُول, قُبُول (القبول: الرِّضَا بالشيء وميل النفس إليه والحسن والشارة وريح الصبا؛ (المعجم الوسيط)؛ ريح شرقية)\nمثال: أميل إلى قبول العرض.",
 "acceptance sampling": "معاينة القبول (إجراء إحصائي لقبول أو رفض دفعة من البضائع)",
 "acceptant": "رَاضٍ, قَبُولِيّ (يقبل عن طيب خاطر)",
 "acceptation": "تبني, قبول (فعل القبول بموافقة؛ الاستقبال المفضل) / مَعْنَى الْكَلِمَة (المعنى المقبول للكلمة) / تصديق, قبول (القبول بالشيء باعتباره حقيقياً أو صالحاً)\nمثال: تبنيه من قبل المجتمع",
 "accepted": "مَقْبُول, مُعْتَرَف بِه (حائز على القبول العامّ أو يفرض الاعتراف)",
 "accepting": "مُتَقَبِّل",
 "acceptive": "قَبُولِيّ, مُتَقَبِّل (يميل إلى القبول بدلاً من الرفض) / رَاضٍ, قَبُولِيّ (يقبل عن طيب خاطر)\nمثال: نادراً ما كانت متقبلة لاقتراحاتي",
 "acceptor": "قَابِل (واجه، وقف مُقبلا نحو شخص والآخر مقبل نحوه؛ فلانٌ فلانًا: التقى به)\nمثال: قابل زيري ريمة.",
 "acceptor rna": "حمض نووي ريبوزي ناقل (أصبح حامضًا، تغير الطعم إلى الحموضة؛ ارتفعت نسبة الحموضة في شيء ما، كما في الطعام أو السوائل)\nمثال: رمى ياني الحمض على وجه سكورة.",
 "access": "معبر, منفذ (مكان العُبُور؛ مَعْبَر رَفَح: نقطة العبور الحدودية بين أراضي قطاع غَزَّة ومِصْر يقع عند مدينة رَفَح في غزة) / دخول, ولوج / حق ولوج (اسم من الأسماء الحسنى وهو من صفات الله. لا جمع له؛ ضد البَاطِل، العَدْل والحَقِيْقَة والوُجُوْد الثَابِت والصِدْق والذي لا جدال فيه. لا جمع له) / وَلَجَ, ذلف (دَخَلَ)\nمثال: الأستاذ على حق.",
 "access code": "رمز الدخول, كود الوصول (رمز (سلسلة من الأحرف أو الأرقام) يجب إدخاله بطريقة ما (كتابة أو اتصال أو نطق) للحصول على حق استخدام شيء ما (خط هاتف أو حاسوب أو شبكة محلية وغيرها))",
 "access road": "طريق فرعي, مدخل طريق (طريق قصير يتيح الوصول إلى طريق سريع)",
 "access time": "وقت الوصول ((في علم الحاسوب) الفترة بين طلب البيانات من قبل النظام ووقت توفير البيانات بواسطة محرك الأقراص)\nمثال: وقت الوصول هو مجموع وقت البحث وكمون الدوران ووقت معالجة الأوامر",
 "accessary": "شَرِيك فِي الجَرِيمَة, مُتَوَاطِئ (يُعين ويُحرِّض على ارتكاب جريمة) / شريك في الجريمة, متواطئ (شخص يساعد شخصاً آخر على ارتكاب جريمة)",
 "accessibility": "تيسر الوصول, سهولة المعشر (سمة كونه سهلاً للقاء أو التعامل معه) / إِتَاحَة, تَوَفُّر (صفة كون الشيء في المتناول عند الحاجة)",
 "accessible": "مُتَاح, يُمْكِن الوُصُول إِلَيْه (قابل للوصول إليه) / سَهْل التَّعَامُل, وَدُود (يسهل التعامل معه أو التحدّث إليه؛ ودود ومُؤانس) / سَهْل المَنَال (يمكن الحصول عليه بسهولة) / سَهْلُ القِرَاءَة, مَيْسُورُ الفَهْم (يمكن قراءته وفهمه بسهولة)\nمثال: بلدة يمكن الوصول إليها بالقطار",
 "accession": "اعتلاء, تولي (فعل الوصول أو الحصول على منصب جديد أو حق (خاصة العرش)) / حق الدخول, دخول (الحق في الدخول) / إذعان, انضمام (الموافقة على أو القبول بـ (غالبًا على مضض)) / إضافة, مُقتنى جديد (شيء يضاف إلى ما تمتلكه بالفعل)\nمثال: اعتلاء إليزابيث العرش في عام 1558",
 "accessional": "إضافي, انضمامي (من أو يشكل انضماماً أو إضافة)",
 "accessorial": "إِضَافِيّ, مُسَاعِد (غير أساسيّ لكنّه مفيد)",
 "accessory": "كَمَالِيّ / مُسَاعِد (مُعَاوِن، مُسَانِد، من يقوم بالمُسَاعَدَة؛ بمعنى مُفِيد، يقال هذا عامل مساعد وهذه مادة مساعدة) / أَكْسِسْوَار\nمثال: علي مساعدة ماري.",
 "accessory after the fact": "شريك بعد الواقعة (شخص يقدم المساعدة أو الراحة لشخص معروف بأنه مجرم أو معروف بأنه مطلوب فيما يتعلق بارتكاب جناية)",
 "accessory before the fact": "شريك قبل الواقعة (شخص يدبر أو ينصح أو يأمر بارتكاب جناية ولكنه لا يكون حاضراً عند ارتكابها)",
 "accessory cephalic vein": "وريد رأسي إضافي (وريد يمر على طول الحافة الكعبرية للساعد وينضم إلى الوريد الرأسي بالقرب من المرفق)",
 "accessory during the fact": "شريك أثناء الواقعة (شخص يشهد جريمة ولكنه لا يحاول منعها)",
 "accessory fruit": "ثمرة كاذبة, فاكهة ملحقة (فاكهة تحتوي على الكثير من الأنسجة اللحمية بجانب تلك الموجودة في المبيض الناضج؛ مثل التفاح أو الفراولة)",
 "accessory hemiazygos vein": "وريد نصف فرد إضافي (وريد يتكون من اتحاد الأوردة الوربية الخلفية الرابعة إلى السابعة؛ يصب في الوريد الفرد)",
 "accessory hemiazygous vein": "وريد نصف فرد إضافي (وريد يتكون من اتحاد الأوردة الوربية الخلفية الرابعة إلى السابعة؛ يصب في الوريد الفرد)",
 "accessory nerve": "عصب إضافي, عصب قحفي حادي عشر (ينشأ من مجموعتين من الجذور (قحفية وشوكية) تتحد لتشكل العصب)",
 "accessory vertebral vein": "وريد فقري إضافي (وريد يرافق الوريد الفقري ولكنه يمر عبر ثقبة النتوء المستعرض للفقرة العنقية السابعة ويصب في الوريد العضدي الرأسي)",
 "acciaccatura": "نوتة زينة (نوتة تجميلية تُكتب عادة بحجم أصغر)",
 "accidence": "صرف تصريفي (جزء القواعد الذي يتعامل مع تصريفات الكلمات)",
 "accident": "حَادِث / مُصَادَفَة, صُدْفَة / صُدْفَة, صِدْفَة (الصدفة. جمع: صُدُفات و صُدْفات و صُدَف٬ هي تزامن غير متوقع لحدوث فعلين بدون تخطيط مسبق، رآه صُدْفةً…)\nمثال: لا تدعها للصدفة.",
 "accident surgery": "جراحة الحوادث, طب الرضوح (فرع الطب الذي يتعامل مع الإصلاح الجراحي للإصابات والجروح الناجمة عن الحوادث)",
 "accident-prone": "كَثِير الحَوَادِث (يتعرّض لعدد من الحوادث يفوق المتوسّط)",
 "accidental": "عَرْضِيّ",
 "accidental injury": "إصابة, إصابة عرضية (حادث يؤدي إلى ضرر جسدي أو أذى)",
 "accidentally": "بالصدفة, عرضياً (بدون تخطيط مسبق) / بشكل غير مقصود, دون قصد (بدون نية؛ بطريقة غير مقصودة) / بالصدفة, بشكل عرضي (ذو طبيعة ثانوية أو فرعية)\nمثال: التقيا بالصدفة",
 "accipiter cooperii": "باز كوبر (صقر من أمريكا الشمالية لونه رمادي مزرق يتميز بطيران انقضاضي)",
 "accipiter gentilis": "باز (صقر كبير من أوراسيا وأمريكا الشمالية يستخدم في الصيد بالصقور)",
 "accipiter nisus": "باشق (صقر صغير من أوراسيا وشمال أفريقيا)",
 "accipitriformes": "جوارح (في بعض التصنيفات اسم بديل للصقريات)",
 "accipitrine": "بازي (من أو متعلق بـ أو ينتمي إلى جنس الباز (أو الصقور النموذجية))",
 "acclaim": "إشادة, استحسان (موافقة حماسية)\nمثال: لقي الكتاب استحساناً متواضعاً",
 "acclamation": "تَزْكِية",
 "acclimation": "أقلمة, تأقلم (التكيف مع مناخ جديد (درجة حرارة أو ارتفاع أو بيئة جديدة))",
 "acclimatisation": "أقلمة, تأقلم (التكيف مع مناخ جديد (درجة حرارة أو ارتفاع أو بيئة جديدة))",
 "acclimatization": "أقلمة, تأقلم (التكيف مع مناخ جديد (درجة حرارة أو ارتفاع أو بيئة جديدة))",
 "acclivitous": "طَالِع, مُنْحَدِرٌ صُعُودًا (مَائِلٌ نَحْوَ الأَعْلَى)",
 "acclivity": "صعود, مرتفع (منحدر أو درجة صاعدة (كما في الطريق))\nمثال: لم تستطع السيارة الصعود في المرتفع",
 "accolade": "تكريم, جائزة (رمز ملموس يدل على الاستحسان أو التميز)\nمثال: جائزة للشجاعة",
 "accommodating": "خَدُوم, مُتَعَاوِن (مفيد في تحقيق التكيف المتناغم) / مُتَعاوِن, مُتَقَبِّل (مُسْتَعِدّ لِتَقْديم المَعْروف والخِدْمَة لِلآخَرين)\nمثال: كان المأمور دائماً متعاوناً في السماح للزوار بالدخول",
 "accommodating iol": "زرعة عدسة متكيفة, عدسة متكيفة (زرعة عدسة تحتوي على مفصل يسمح بالرؤية القريبة والبعيدة (وبذلك تحاكي العدسة الطبيعية لشخص شاب))",
 "accommodating lens implant": "زرعة عدسة متكيفة, عدسة متكيفة (زرعة عدسة تحتوي على مفصل يسمح بالرؤية القريبة والبعيدة (وبذلك تحاكي العدسة الطبيعية لشخص شاب))",
 "accommodatingly": "بِلُطْف, بِمُجَامَلَة (بشكل متعاون أو ملائم)\nمثال: بلطف، خفض صوته",
 "accommodation": "إِقَامَة",
 "accommodation endorser": "كفيل مجاملة (شخص يظهر سند إذني دون تعويض أو منفعة ولكن ببساطة كخدمة للمقترض)",
