 "accused": "مُتَّهَم, مُتَّهَمَة",
 "accusee": "مُتَّهَم",
 "accuser": "مُتَّهِم",
 "accusing": "اتِّهَامِيّ, مُتَّهِم (يتضمن أو يُعَبِّر عن اتهام)",
