 "columnist": "عَمُود كَاتِب",
 "columnlike": "عَمُودِيّ الشَّكْل (على هيئة عمود أو بشكل يُشبهه)",
 "colutea arborescens": "سنا مثاني (شجيرة أوروبية صفراء الزهر تزرع لتتابع أزهارها الصفراء وقرونها المثانية المنتفخة جداً وكمصدر لغذاء الحياة البرية)",
 "colza": "سلجم, لفت زيتي (نبات أوراسي يزرع لبذوره وكمحصول علف)",
 "colza oil": "زيت السلجم, زيت الكولزا (زيت صالح للأكل أصفر فاتح إلى بني من بذور اللفت يُستخدم أيضاً كمواد تشحيم أو للإضاءة)",
 "coma": "غَيْبُوبَة",
 "comal": "ذُو خُصْلَة, مُهَدَّب ((لبعض البذور كالقطن) ذو خصلة أو خصلات من الشعر)",
 "comanche": "لغة كومانشي (لغة شوشونية يتحدث بها شعب كومانشي) / كومانشي (فرد من الشعب الشوشوني الذي عاش سابقاً بين وايومنغ والحدود المكسيكية ولكن الآن بشكل رئيسي في أوكلاهوما)",
 "comanche language": "لغة كومانشي (لغة شوشونية يتحدث بها شعب كومانشي)",
 "comandra pallida": "كتان العلجوم الكاذب (طفيلي خشبي زاحف في غرب أمريكا الشمالية له أوراق مسحوقية سميكة عديدة وعناقيد من الزهور البيضاء الباهتة الصغيرة)",
 "comate": "ذُو خُصْلَة, مُهَدَّب ((لبعض البذور كالقطن) ذو خصلة أو خصلات من الشعر) / ذُو هَامَة, مُكَلَّلٌ بِالأَوْرَاقِ (يحمل هامة؛ متوَّج بتجمُّع من الأغصان أو الأوراق أو القنابات)",
 "comatose": "فِي غَيْبُوبَةٍ, مَغْمُورٌ فِي سُبَاتٍ (فِي حَالَةِ فَقْدَانِ وَعْيٍ عَمِيقَةٍ وَمُطَوَّلَةٍ؛ غَيْرُ قَادِرٍ عَلَى الِاسْتِجَابَةِ) / سباتي, غيبوبي (متعلق بالغيبوبة أو مرتبط بها)\nمثال: تنفس سباتي",
 "comatoseness": "غيبوبة (حالة من فقدان الوعي العميق والمطول غالباً؛ عادة ما تكون نتيجة لمرض أو إصابة)",
 "comatulid": "نجم ريشي (كرينويد حر السباحة بدون ساق بعشرة أذرع ريشية؛ يوجد في قيعان البحر الطينية)",
 "comb": "مُشْط (سرح الشعر باستخدام مشط؛ نظف أو مرر شيئًا باستخدام مشط أو أداة مشابهة) / مِشْط (سرح الشعر باستخدام مشط؛ نظف أو مرر شيئًا باستخدام مشط أو أداة مشابهة) / مِمْشَط / مشط (سرح الشعر باستخدام مشط؛ نظف أو مرر شيئًا باستخدام مشط أو أداة مشابهة) / مُشط (سرح الشعر باستخدام مشط؛ نظف أو مرر شيئًا باستخدام مشط أو أداة مشابهة) / مشطة / مَشَطَ, مَشَّطَ (سرح الشعر باستخدام مشط؛ نظف أو مرر شيئًا باستخدام مشط أو أداة مشابهة)\nمثال: مشط شعرك قبل أن تخرج.",
 "comb jelly": "مشطيات, هلاميات مشطية (حيوانات بحرية خنثوية متناظرة ثنائياً تشبه قناديل البحر ولها ثمانية صفوف من الأهداب مرتبة مثل أسنان المشط للحركة)",
 "comb-footed spider": "عنكبوت مشطي القدم (عنكبوت له صف يشبه المشط من الشعيرات على كل قدم خلفية)",
 "comb-like": "مشطي (يشبه المشط؛ له نتوءات مثل أسنان المشط)",
 "comb-out": "تصفية, غربلة (فعل إزالة الأشياء أو الأشخاص غير المرغوب فيهم بعناية) / تسليك الشعر, فك التشابك (فعل إزالة التشابك من شعرك بمشط)\nمثال: حصل القسم على غربلة جيدة",
 "comb-plate": "مشط (عضو حركي يتكون من صف من الأهداب القوية التي تندمج قواعدها)",
 "combat": "قِتَال (من قَتَلَ: كثير القَتْل) / قَاتَلَ (اسم فاعل من الفعل قَتَلَ، الذي قَامَ بالقَتْل. الجمع قَاتِلُون؛ المُجْرِم الذي يقتل بلا حَقّ. الجمع قتلة)\nمثال: لن يحل القتال أي شيء.",
 "combat area": "ساحة المعركة, منطقة قتال (منطقة عسكرية حيث تعمل القوات المقاتلة)",
 "combat boot": "بسطار",
 "combat casualty": "أضرار المعركة (فقدان المعدات العسكرية في المعركة)",
 "combat ceiling": "سَقْف الخِدْمَة, سَقْف القِتَال (الارتفاع الذي لا تستطيع الطائرة فوقه الصعود أسرع من معدل معين)",
 "combat fatigue": "إرهاق المعركة, صدمة القصف (اضطراب عقلي ناتج عن إجهاد الحرب النشطة)",
