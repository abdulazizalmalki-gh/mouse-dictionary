 "collimation": "تسامت (الضبط الدقيق لخط رؤية التلسكوب)",
 "collimator": "مجمع أشعة, مسدد (جهاز بصري يتكون من أنبوب يحتوي على عدسة محدبة لونية في أحد طرفيه وشق في الطرف الآخر مع وجود الشق في بؤرة العدسة؛ تترك أشعة الضوء الشق كحزمة متوازية) / مسدد, ميزاء (تلسكوب صغير متصل بتلسكوب كبير لاستخدامه في ضبط خط رؤية التلسكوب الأكبر)",
 "collinear": "مُتَخَطِّي, وَاقِعٌ عَلَى خَطٍّ وَاحِدٍ (يقع على الخط نفسه)",
 "collins": "توم كولينز, كولينز (مشروب مثلج طويل من الكحول (عادة الجن) مع عصير الفاكهة)",
 "collinsia bicolor": "المنازل الصينية الأرجوانية, كولينسيا ثنائية اللون (أزهار بيضاء وخزامية إلى زرقاء شاحبة تنمو في حلقات مثالية من شرائط متباعدة على نطاق واسع حول السيقان تشكل نوعاً من الباغودا؛ كاليفورنيا)",
 "collinsia heterophylla": "المنازل الصينية الأرجوانية, كولينسيا ثنائية اللون (أزهار بيضاء وخزامية إلى زرقاء شاحبة تنمو في حلقات مثالية من شرائط متباعدة على نطاق واسع حول السيقان تشكل نوعاً من الباغودا؛ كاليفورنيا)",
 "collinsia parviflora": "كولينسيا صغيرة الأزهار, ماري زرقاء العيون الصغيرة (نبات غربي صغير واسع التفرع بأزهار زرقاء وبيضاء دقيقة؛ كولومبيا البريطانية إلى أونتاريو وجنوباً إلى كاليفورنيا وكولورادو)",
 "collinsia verna": "كولينسيا ربيعية, ماري زرقاء العيون (نبات في شرق الولايات المتحدة بدوامات من الزهور الزرقاء والبيضاء)",
 "collinsonia canadensis": "بلسم الحصان, جذر الحجر (عشب معمر قائم قوي الرائحة بأوراق مسننة مدببة وعثكول فضفاض من الزهور المصفرة؛ شرق الولايات المتحدة)",
 "collision": "تَصَادُّم, اِصْطِدَام",
 "collision course": "مسار تصادمي (مسار عمل يؤدي إلى صراع إذا استمر دون تغيير) / مسار تصادمي (مسار جسم متحرك سيؤدي إلى تصادم إذا استمر دون تغيير)",
 "collocalia inexpectata": "سمامة الكهوف (سمامة من شرق آسيا؛ تنتج عش الطائر الصالح للأكل)",
 "collocation": "مجاورة, مقارنة (فعل التموضع بالقرب (أو جنباً إلى جنب)) / متلازمة لفظية (تجميع للكلمات في الجملة)\nمثال: إنه نتيجة تجاور الألوان المتباينة",
 "collodion": "كولوديون (محلول شراب عديم اللون من البيروكسيلين في الأثير والكحول؛ يستخدم كطلاء للجروح أو الأفلام الفوتوغرافية)",
 "colloid": "غرواني, مادة غروية (خليط له خصائص بين المحلول والمعلق الدقيق)",
 "colloidal": "غرواني (متعلق بالغروانيات أو له خصائصها)",
 "colloidal gel": "جل, هلام (مادة غروية في شكل أكثر صلابة من الصل (المحلول الغروي))",
 "colloidal solution": "صل, محلول غرواني (مادة غروية ذات طور سائل مستمر يتم فيه تعليق مادة صلبة في سائل)",
 "colloidal suspension": "صل, محلول غرواني (مادة غروية ذات طور سائل مستمر يتم فيه تعليق مادة صلبة في سائل)",
 "colloidally": "بِشَكْل غَرَوِيّ, غَرَوِيًّا (بطريقة غروية)\nمثال: كانت الجسيمات مشتتة غروياً في الوسط",
 "colloquial": "عَامِّيّ, دَارِج",
 "colloquialism": "عَامِّيَّة, دَارِجَة",
 "colloquially": "بِالعَامِّيَّة, بِشَكْل غَيْر رَسْمِيّ (باستخدام تعابير عامية)\nمثال: يشار إلى هذا المبنى بالعامية باسم الحظيرة",
 "colloquium": "حلقة نقاش, ندوة (خطاب في اجتماع أكاديمي أو ندوة) / حَلَقَة نِقَاشِيَّة, مُؤْتَمَر عِلْمِيّ (اجتماع أكاديمي أو ندوة يقودها عادة محاضر مختلف وتتناول موضوعاً مختلفاً في كل اجتماع)",
 "colloquy": "مباحثة (محادثة رسمية) / مباحثة, ندوة (محادثة خاصة الرسمية منها)",
 "collotype": "طباعة النمط الغروي, كولوتيب (عملية طباعة ميكانيكية ضوئية تستخدم لوحاً زجاجياً بسطح جيلاتيني يحمل الصورة المراد استنساخها؛ يمكن استخدامها مع لون واحد أو أكثر)",
 "collotype printing": "طباعة النمط الغروي, كولوتيب (عملية طباعة ميكانيكية ضوئية تستخدم لوحاً زجاجياً بسطح جيلاتيني يحمل الصورة المراد استنساخها؛ يمكن استخدامها مع لون واحد أو أكثر)",
 "collusion": "تَوَاطُؤ",
 "collusive": "تَوَاطُئِيّ, مُتَآمِر (يَعْمَلُ مَعَ آخَرِينَ سِرًّا لِغَايَةٍ احْتِيَالِيَّةٍ أَوْ غَيْرِ مَشْرُوعَة)",
 "collyrium": "غسول العين, كحل سائل (غسول يتكون من محلول يستخدم كمنظف للعيون)",
 "collywobbles": "التهاب معدي معوي حاد, مغص معوي (التهاب معدي معوي شديد مجهول السبب؛ يتميز بمغص شديد وقيء وإسهال)",
 "colobus": "كولبس (قرد شجري من غرب ووسط أفريقيا ذو فرو حريري طويل وإبهام مختزل)",
 "colobus guereza": "كولوبس غويرزا (قرد كولوبس ذو معطف بني محمر وأهداب حريرية بيضاء أسفل جانبي الجسم)",
 "colobus monkey": "كولبس (قرد شجري من غرب ووسط أفريقيا ذو فرو حريري طويل وإبهام مختزل)",
 "colocasia esculenta": "تارو, قلقاس (عشبة من جزر المحيط الهادئ تزرع في جميع أنحاء المناطق الاستوائية لجذرها الصالح للأكل وفي المناطق المعتدلة كنبات زينة لأوراقها اللامعة الكبيرة)",
 "colocynth": "حَنْظَل, عَلْقَم",
 "cologne": "كولونْيَا / مَاء كُولُونِيَا, كُولُونِيَا (السائل الشفاف المعروف الذي تنشأ به الحياة، عديم اللون والرائحة والطعم عندما يكون نقيا؛ علميا فِي : جزيئة متكونة من ذرتي هيدروجين مرتبطين بذرة واحدة من الأوكسيجين)\nمثال: أنا أشرب الماء.",
 "cologne water": "كولونيا, ماء الكولونيا (سائل معطر مصنوع من الزيوت الأساسية والكحول)",
 "colombia": "كُولُومْبِيَا, كُلُمبِية",
 "colombian": "كولومبي (من أو يتعلق بكولومبيا أو شعبها أو يميزهم) / كولومبي (مواطن أو ساكن في كولومبيا)\nمثال: قهوة كولومبية",
 "colombian monetary unit": "وحدة نقدية كولومبية (الوحدة النقدية في كولومبيا)",
 "colombian peso": "بيزو, بيزو كولومبي (وحدة المال الأساسية في كولومبيا؛ تساوي 100 سنتافو)",
 "colombo": "كُولُومْبُو",
