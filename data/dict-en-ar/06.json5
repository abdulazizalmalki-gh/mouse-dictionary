 "contemptibly": "بشكل حقير, بشكل مثير للازدراء (بطريقة تستحق الازدراء)",
 "contemptuous": "مُزْدَرٍ, مُهِينٌ (يُعَبِّر عن احتقار شديد)",
 "contemptuously": "باحتقار, بازدراء (بدون احترام؛ بطريقة محتقرة)\nمثال: تحدثت عنه بازدراء",
 "contemptuousness": "احتقار, ازدراء (مظهر من مظاهر السخرية والاحتقار)\nمثال: شعر كل مرؤوس بازدرائه وكرهوه بالمقابل",
 "contender": "خصم, غريم (المتسابق الذي تأمل في هزيمته)\nمثال: كان يحترم خصومه",
 "content": "رَاضٍ, مُرْتَاح (رَاضَ (راضه)روضا ورياضا ورياضة: ذلله. يقال راض المهر وراض نفسه بالتقوى وراض القوافي الصعبة؛ (رَاضَ) الدر: ثقبه. فهو مروض وهي مروضة) / رَضَّى / مُحْتَوًى, مَضْمُون / كَمِّيَّة, نِسْبَة\nمثال: سامي غير راض بوظيفته.",
 "content creator": "صَانِع مُحْتَوًى (كل من يَصْنَعُ شيئا؛ من يَمْتَهِنُ الصِّنَاعَة)\nمثال: أحب أن أكون صانع محتوى.",
 "content management system": "نِظَام إِدَارَة اَلْمُحْتَوَى (مَنْهَج، طَرِيقَة؛ تَرْتِيب واتِّسَاق)\nمثال: ليس بنظام كامل.",
 "content word": "كَلِمَة الْمُحْتَوَى (الكلِمَةُ : اللفظةُ الدَّالةُ على معنًى مُفْرَد بالوضع، وتكون؛ الكلِمَةُ: الكلامُ المؤلَّفُ المطوَّل، قصيدةً، أَو خُطْبَةً، أَو مقالةً، أَو رسالة)\nمثال: كلمة السر طويلة.",
 "contented": "راضٍ, قانع (راضٍ أو يظهر الرضا عن الأمور كما هي)\nمثال: ابتسامة رضا",
 "contentedly": "بِرِضًا, بِقَنَاعَة (بهدوء ورضا)\nمثال: قالت برضا: 'لقد اشتريته'",
 "contentedness": "اكتفاء, رضا (حالة الرضا عن وضع المرء في الحياة)\nمثال: استرخى في قناعة ناعسة",
 "contention": "جِدَال (مراء يتعلق بإظهار المذاهب وتقريرها، ذكره ابن الكمال (التوقيف)؛ فنّ الجِدال: ( والتصوف) ضربٌ خادعٌ من المناقشة أساسه استعمال الحجج السُّفسطائيّة…)\nمثال: لا جدال في ذلك.",
 "contentious": "مُثِير لِلْجَدَل",
 "contentiousness": "ميل للمشاكسة, نزاغ (نزعة للمشاكسة والجدال)",
 "contentment": "رِضَا (مصدر الفعل \"رَضِيَ\")\nمثال: السكوت علامة الرضا.",
 "contents": "مُحْتَوَى, مَضْمُون",
 "conterminous": "مُتَسَاوِي المَدَى (متساوٍ في النطاق أو المدى أو المدة) / مُتَاخِم, مُجَاوِر (لَهُ حُدُودٌ أَوْ حَوَافٌّ مُشْتَرَكَةٌ؛ مُلَاصِقٌ وَمُلَامِسٌ) / مُتَلَاصِق, مُتَّصِل (مُتَّصِلٌ دُونَ انْقِطَاعٍ؛ ضِمْنَ حُدُودٍ مُشْتَرَكَةٍ)",
