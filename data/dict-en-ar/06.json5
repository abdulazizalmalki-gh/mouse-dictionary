 "corn muffin": "مافن الذرة (مافن مصنوع من دقيق الذرة)",
 "corn oil": "زيت الذرة (زيت مستخرج من أجنة حبوب الذرة)",
 "corn poppy": "خشخاش الحقول, خشخاش الذرة (خشخاش أوروبي سنوي شائع في حقول الحبوب ويزرع غالباً)",
 "corn pudding": "بودينغ الذرة (بودينغ مصنوع من الذرة والقشدة والبيض)",
 "corn salad": "خَسّ النَّعْجَة, خَسّ الضَأْن (خَسَّ الرجُلُ يَخِسُّ خِسَّةً، وخَسَاسَةً: حَقُرَ؛ يقال: خَسَّ فِعْلُهُ وقولُه ورأْيُه)\nمثال: بيع المنزل بثمن بخس.",
 "corn silk": "حرير الذرة, شواشي الذرة (كل من الأقلام الخيطية الطويلة التي تنمو كخصلة حريرية عند طرف كوز الذرة)",
 "corn smut": "تفحم الذرة (فطر تفحم يهاجم الذرة الهندية)",
 "corn snake": "ثعبان الجرذ الأحمر, ثعبان الذرة (ثعبان كبير غير سام من جنوب شرق الولايات المتحدة؛ غالباً ما يوجد في المزارع)",
 "corn snow": "ثلج حبيبي (ثلج حبيبي يتشكل عن طريق الذوبان والتجميد المتناوب)",
 "corn speedwell": "زهرة الحواشي الغيطية (نبات حولي أزرق الزهور منتصب أو منبطح يوجد في الأماكن المهملة في أوروبا وأمريكا)",
 "corn spurrey": "دحسية الحقول (عشب ضار أوروبي صغير بأوراق دائرية وأزهار بيضاء)",
 "corn spurry": "دحسية الحقول (عشب ضار أوروبي صغير بأوراق دائرية وأزهار بيضاء)",
 "corn stalk": "ساق الذرة (ساق نبات الذرة)",
 "corn sugar": "سكر الذرة (ديكستروز يستخدم كعامل تحلية) / سكر الذرة (ديكستروز مصنوع عن طريق التحلل المائي لنشا الذرة)",
 "corn syrup": "شراب الذرة (شراب محضر من الذرة)",
 "corn whiskey": "ويسكي الذرة (ويسكي مقطر من هريس يحتوي على ما لا يقل عن 80 في المائة ذرة)",
 "corn whisky": "ويسكي الذرة (ويسكي مقطر من هريس يحتوي على ما لا يقل عن 80 في المائة ذرة)",
 "corn-fed": "سَاذَج, قَوِيُّ البُنْيَة (قَوِيٌّ وَصَحِيحٌ لَكِنَّهُ يَفْتَقِرُ إِلَى الرُّقِيّ) / مُغَذًّى بِالذُّرَة (يُطعَم الذرة كعلف)",
 "cornbread": "خبز الذرة (خبز مصنوع أساساً من دقيق الذرة)",
 "corncob": "كُوز ذُرَة, كُوز الذُرَة (إناء شرب بعُرْوَة)",
 "corncrake": "مرعة الغيط (طائر مرعة أوراسي شائع يتردد على حقول الحبوب)",
 "corncrib": "مخزن ذرة (مخزن لتخزين وتجفيف أكواز الذرة)",
 "cornea": "قَرْنِيَّة",
 "corneal": "قرني (من أو متعلق بقرنية العين)",
 "corneal graft": "رأب القرنية, زراعة القرنية (إجراء جراحي يتم فيه استبدال جزء أو كل القرنية التالفة أو المريضة بأنسجة قرنية سليمة من متبرع)",
 "corneal transplant": "رأب القرنية, زراعة القرنية (إجراء جراحي يتم فيه استبدال جزء أو كل القرنية التالفة أو المريضة بأنسجة قرنية سليمة من متبرع)",
 "corned": "مَنْقُوع فِي المِلْح, مُمَلَّح ((خَاصَّةً عَنِ اللُّحُوم) مَحْفُوظ فِي مَحْلُول مِلْحِيّ)",
 "corned beef": "كورند بيف, لحم بقري مملح (لحم بقر محفوظ أو مخلل في محلول ملحي)",
 "corned beef hash": "هاش اللحم المملح (هاش مصنوع من اللحم البقري المملح)",
 "cornel": "قَرَانِيَا",
 "cornelian": "عقيق أحمر, كارنيليان (نوع أحمر أو برتقالي نصف شفاف من الكالسيدوني)",
 "cornelian cherry": "قرانيا ذكر, كرز القرانيا (شجيرة أو شجرة صغيرة نفضية أوروبية لها ثمار حمراء زاهية)",
 "corneous": "شَبِيه بِالقَرْن, قَرْنِيّ (يُشبِه القَرْن في صَلابَتِه وقِوامِه)",
 "corner": "زَاوِيَة, رُكْن",
 "corner cabinet": "خزانة ركنية, خزانة زاوية (خزانة مثلثة الشكل مصممة لتوضع في الزاوية)",
 "corner kick": "ركلة ركنية (ركلة حرة من الزاوية تُمنح للجانب الآخر عندما يرسل لاعب الكرة خلف خط مرماه)",
 "corner man": "رجل الطرف (رجل في أحد طرفي صف المؤدين في عرض المنستريل؛ يجري حواراً فكاهياً مع المحاور)",
 "corner pocket": "جيب الزاوية (جيب عند زاوية طاولة البلياردو)",
 "corner post": "ركن, عمود الزاوية (عمود مربع يدعم عضواً إنشائياً في زاوية مبنى)",
 "cornerback": "ظهير زاوية (لاعب دفاع في كرة القدم الأمريكية يتمركز خارج خط الدفاع)",
 "cornered": "فِي مَأْزِق, مُحَاصَر (مُجْبَر عَلَى مُوَاجَهَة المُهَاجِمِين دُونَ مَفَرّ)",
 "cornerstone": "حجر أساس (حَجَرَ عليه الأمرَ:مَنَعَه منه ، حجر الشّيء على نفسه:خَصَّها به وقصره عليها؛ الحجْرُ: المَنْعُ مِن التَّصَرُّفِ ، وحَجَرَ عَلَيْهِ القاضِي يَحْجُرُ حَجْراً، إِذا مَنَعَه مِن التَّصَرُّفِ فِي مالِه)\nمثال: عوقب زيري بالحجر.",
 "cornet": "بوق, كورنيت (آلة موسيقية نحاسية ذات نغمة رائعة؛ لها أنبوب ضيق وجرس متسع وتُعزف بواسطة الصمامات)",
 "cornetfish": "سمكة البوق (سمكة استوائية نحيلة ذات خطم أنبوبي طويل وصفائح عظمية بدلاً من القشور)",
 "cornetist": "عازف بوق, عازف كورنيت (موسيقي يعزف على البوق أو الكورنيت)",
 "corneum": "طبقة قرنية, طبقة متقرنة (الطبقة الخارجية من البشرة وتتكون من خلايا ميتة تتساقط)",
 "cornfield": "حقل ذرة (حقل مزروع بالذرة)",
 "cornflakes": "رَقَائِق ذُرَة",
 "cornflour": "نشا الذرة (نشا محضر من حبوب الذرة؛ يُستخدم في الطهي كمكثف)",
 "cornflower": "قنطريون عنبري, ورد الذرة (نبات أوراسي حولي يُزرع في أمريكا الشمالية له رؤوس مبهرجة من الزهور الزرقاء أو الأرجوانية أو الوردية أو البيضاء) / أوفولاريا كبيرة الأزهار, زهرة القش (نبات من جنوب وجنوب شرق الولايات المتحدة يزرع لزهوره الصفراء التي يمكن تجفيفها)",
 "cornflower aster": "أستر ستوكس (نبات معمر قائم من جنوب شرق الولايات المتحدة له رؤوس كبيرة من الزهور الزرقاء عادة)",
 "cornflower blue": "أزرق الذرة (درجة من الأزرق المتوسط إلى الفاتح تحتوي على القليل من الأخضر مقارنة بالأزرق)",
 "cornhusk": "قِشْرَةُ الذُّرَة (قشرة كوز الذرة)",
 "cornhusker": "نبراسكي (مواطن أو مقيم في نبراسكا) / مقشر الذرة (عامل يقشر الذرة)",
 "cornhusking": "تقشير الذرة (عملية إزالة القشور من أكواز الذرة) / تجمع تقشير الذرة (تجمع اجتماعي لغرض تقشير الذرة)",
 "cornice": "إفريز, كرنيش (الجزء البارز العلوي من السطح المعمد) / كورنيش (إطار زخرفي في الزاوية بين السقف وأعلى الجدار) / ستارة, كورنيش (هيكل زخرفي لإخفاء تركيبات الستائر في الجزء العلوي من غلاف النافذة)",
 "cornish": "دجاج كورنيش (سلالة إنجليزية من الدجاج المنزلي المدمج؛ تربى بشكل أساسي للتهجين لإنتاج دجاج الشواء) / كورني (من أو متعلق بكورنوال أو شعبها أو اللغة الكورنية) / القرنية, لغة كورنوال (لغة كلتية يتم التحدث بها في كورنوال)",
 "cornish fowl": "دجاج كورنيش (سلالة إنجليزية من الدجاج المنزلي المدمج؛ تربى بشكل أساسي للتهجين لإنتاج دجاج الشواء)",
 "cornish heath": "خلنج كورني (شجيرة كثيفة ذات زهور وردية إلى بيضاء؛ شائعة في مستنقعات كورنوال وجنوب غرب أوروبا؛ تزرع في أماكن أخرى)",
 "cornish language": "القرنية, لغة كورنوال (لغة كلتية يتم التحدث بها في كورنوال)",
 "cornish pasty": "فطيرة كورنش (فطيرة لحم بحشوة من اللحم والخضروات)",
 "cornishman": "كورني (رجل مواطن أو ساكن في كورنوال)",
 "cornishwoman": "كورنية (امرأة مواطنة أو مقيمة في كورنوال)",
 "cornmeal": "دقيق الذرة (ذرة مطحونة بشكل خشن)",
 "cornmeal mush": "عصيدة الذرة, ماش (دقيق الذرة المسلوق في الماء)",
 "cornpone": "كورن بون (خبز ذرة يصنع غالباً بدون حليب أو بيض ويخبز أو يقلى)",
 "cornsilk": "حرير الذرة, شواشي الذرة (كل من الأقلام الخيطية الطويلة التي تنمو كخصلة حريرية عند طرف كوز الذرة)",
 "cornsmut": "تفحم الذرة (فطر تفحم يهاجم الذرة الهندية)",
 "cornstalk": "ساق الذرة (ساق نبات الذرة)",
 "cornstarch": "نَشَاء ذُرَة",
 "cornu": "قَرْن ((في التشريح) أي بنية تشبه القرن في شكلها)",
 "cornu aspersum": "حلزون الحدائق (آفة حدائق خطيرة لها صدفة بنية مع علامات متعرجة شاحبة؛ عالمية الانتشار تقريباً)",
 "cornucopia": "قرن الوفرة (مصدر للفعل قَرَنَ؛ القوم يعيشون سوية فترة طويلة جذا من الزمن، أو هو الفترة الطويلة من الزمن بدون تحديد عدد السنين)\nمثال: هذه الشجرة عمرها أكثر من قرن.",
 "cornus amomum": "قرانيا أموموم, قرانيا حريرية (شجيرة من شرق أمريكا الشمالية لها سيقان أرجوانية وثمار زرقاء)",
 "cornus canadensis": "توت البودنغ, قرانيا قزمية (عشب معمر زاحف يتميز بتوت أحمر ودوامات أوراق عنقودية عند أطراف البراعم؛ غرينلاند إلى ألاسكا)",
 "cornus florida": "قرانيا بيضاء شائعة, قرانيا مزهرة شرقية (شجرة نفضية؛ تشتهر بقناباتها البيضاء أو الوردية الكبيرة ولونها الخريفي المذهل الذي يتبعه توت أحمر)",
 "cornus mas": "قرانيا ذكر, كرز القرانيا (شجيرة أو شجرة صغيرة نفضية أوروبية لها ثمار حمراء زاهية)",
 "cornus obliqua": "قرانيا حريرية",
 "cornus sanguinea": "قرانيا أوروبية شائعة, قرانيا دموية (شجيرة نفضية أوروبية تتحول للأحمر في الخريف ولها زهور بيضاء باهتة)",
 "cornus stolonifera": "قرانيا أمريكية, قرانيا حمراء (شجيرة شائعة في أمريكا الشمالية بغصينات أرجوانية محمرة وزهور بيضاء)",
 "corny": "ثَقِيل الظَِلّ, سَخِيف",
 "corolla": "تُوَيْج, تاج",
 "corollary": "لازمة, نتيجة مباشرة ((منطق) استدلال يتبع مباشرة من إثبات اقتراح آخر) / لازمة, نتيجة طبيعية (عاقبة عملية تتبع بشكل طبيعي)\nمثال: الغيرة العمياء لازمة متكررة للحب العاطفي",
 "corona": "كورونا (سيجار طويل بنهايات غير حادة) / إِكْلِيل ((في التشريح) أي بنية تشبه التاج في شكلها) / إكليل الشمس, هالة شمسية (المنطقة الخارجية لغلاف الشمس الجوي؛ مرئية كهالة بيضاء أثناء الكسوف الشمسي) / هالة (دائرة واحدة أو أكثر من الضوء تُرى حول جسم مضيء)",
 "corona borealis": "التَّاج السَّمَالِيّ",
 "corona discharge": "تفريغ هالي, نار سانت إلمو (تفريغ كهربائي مصحوب بتأين الغلاف الجوي المحيط)",
 "corona glandis": "إِكْلِيل الْحَشَفَة",
 "corona glandis penis": "إِكْلِيل حَشَفَة الْقَضِيب",
 "coronach": "جنائزية, رثاء (أغنية أو ترنيمة حداد تؤلف أو تؤدى كذكرى لشخص ميت)",
 "coronal": "إكليل (تنسيق زهور يتكون من شريط دائري من أوراق الشجر أو الزهور لأغراض الزينة)",
 "coronal consonant": "صامت تاجي ((صوتيات) يُنطق بالجزء الأمامي المرن من اللسان)",
 "coronal mass ejection": "لفظ كتليّ إِكْلِيلِيّ (نَطَقَ، تَكَلَّمَ؛ أَخْرَجَ، رَمَى)\nمثال: هذه الكلمة صعبة اللفظ.",
 "coronal suture": "درز إكليلي (الدرز بين العظمين الجداريين والعظم الجبهي للجمجمة)",
 "coronary": "تاجي (يحيط كالتاج (خاصة الأوعية الدموية المحيطة بالقلب)) / تخثر تاجي (انسداد تدفق الدم في الشريان التاجي بجلطة دموية (خثرة))\nمثال: شرايين تاجية",
 "coronary artery": "شريان تاجي (الشريان الذي يتفرع من الأبهر لتغذية القلب بالدم)",
 "coronary artery bypass graft": "تحويل مسار الشريان التاجي, مجازة تاجية (جراحة قلب مفتوح يتم فيها فتح القفص الصدري وتطعيم قسم من وعاء دموي من الشريان الأورطي إلى الشريان التاجي لتجاوز القسم المسدود من الشريان التاجي وتحسين…)",
 "coronary artery disease": "مَرَض الْقَلْب التَّاجِيّ, دَاء الشَّرْيَان التَّاجِيّ (أصابه مرضٌ أو علّة أو سَقَم)\nمثال: هذا المرض قلبي.",
 "coronary bypass": "تحويل مسار الشريان التاجي, مجازة تاجية (جراحة قلب مفتوح يتم فيها فتح القفص الصدري وتطعيم قسم من وعاء دموي من الشريان الأورطي إلى الشريان التاجي لتجاوز القسم المسدود من الشريان التاجي وتحسين…)",
 "coronary bypass surgery": "تحويل مسار الشريان التاجي, مجازة تاجية (جراحة قلب مفتوح يتم فيها فتح القفص الصدري وتطعيم قسم من وعاء دموي من الشريان الأورطي إلى الشريان التاجي لتجاوز القسم المسدود من الشريان التاجي وتحسين…)",
 "coronary care unit": "وحدة العناية التاجية, وحدة عناية القلب (وحدة مستشفى مزودة بموظفين ومعدات خاصة لعلاج المرضى الذين يعانون من مشاكل قلبية خطيرة)",
 "coronary failure": "فشل القلب, قصور القلب (عدم قدرة القلب على ضخ كمية كافية من الدم للحفاظ على وظائف الجسم الطبيعية)",
 "coronary heart disease": "مرض القلب التاجي (مرض قلبي ناجم عن خلل في الشرايين التي تمد القلب بالدم والأكسجين)",
 "coronary insufficiency": "قُصُور الشِّرْيَان التَّاجِيّ, قُصُور القَلْب (تدفق غير كافٍ للدم إلى عضلات القلب؛ يمكن أن يسبب ذبحة صدرية)",
 "coronary occlusion": "انسداد تاجي (انسداد شريان تاجي ناجم إما عن تصلب الشرايين التدريجي أو عن جلطة دموية)",
 "coronary sinus": "جيب تاجي (جيب قصير يستقبل معظم أوردة القلب؛ يصب في الأذين الأيمن)",
 "coronary thrombosis": "خُثَار تَاجِيّ",
 "coronary-artery disease": "تصلب الشرايين (تصلب جدران الشرايين)",
 "coronation": "تَتْوِيج",
 "coronavirus": "فَيْرُوس كُورُونَا / ڤَيْرُوس كُورُونَا",
 "coronavirus disease": "مرض فيروس كورونا (مرض حاد يسببه فيروس من عائلة فيروسات كورونا)",
 "coronavirus disease 2019": "كوفيد-19, مرض فيروس كورونا 2019 (مرض فيروسي يسببه فيروس سارس-كوف-2 تسبب في جائحة عالمية عام 2020)",
 "coroner": "طبيب شرعي, محقق في الوفيات (مسؤول عام يحقق في أي وفاة غير ناتجة عن أسباب طبيعية)",
 "coronet": "إكليل (الحافة الواقعة بين جلد الرسغ وقرن الحافر) / إكليل, تاج صغير (تاج صغير؛ يشير عادة إلى رتبة عالية ولكن أقل من رتبة السيادة)",
 "coroneted": "حَامِل لَقَب نَبِيل, رَفِيع النَّسَب (ينتمي إلى طبقة النبلاء ذوي الألقاب)",
 "coronilla": "إكليلية, كورونيلا (أي من النباتات المختلفة من جنس كورونيلا ذات أزهار أرجوانية أو وردية أو صفراء في رؤوس أو خيمات إبطية طويلة)",
 "coronilla varia": "إكليل البيقية, كورونيلا (عشب أوروبي يشبه البيقية؛ توطن في شرق الولايات المتحدة؛ له مظلات من الزهور الوردية والبيضاء وقرون حادة الزوايا)",
 "coronion": "إكليلية (نقطة قياس القحف عند طرف النتوء الإكليلي للفك السفلي)",
 "coronoid process": "نتوء منقاري (نتوء مثلثي حاد يبرز من عظم)",
 "coronoid process of the mandible": "نتوء منقاري للفك السفلي (النتوء المنقاري الذي يوفر مرتكزاً للعضلة الصدغية)",
 "corozo": "كوروزو, نخيل العاج (أي من عدة أشجار نخيل أمريكية استوائية تحمل جوز الكوروزو)",
 "corozo palm": "كوروزو, نخيل العاج (أي من عدة أشجار نخيل أمريكية استوائية تحمل جوز الكوروزو)",
 "corp": "شركة مساهمة, مؤسسة (شركة تجارية تمت الموافقة على مواد تأسيسها في ولاية ما)",
 "corpora arenacea": "رَمْل الدِّمَاغ (ذرات دقيقة من الصخور أو المعادن، تتكون طبيعياً بفعل الرياح أو الماء؛ تربة رخوة تتكوّن غالباً على الشاطئ أو في الصحارى)\nمثال: وصلت شاحنة الرمل.",
 "corporal": "ذُو كَيَان, مُتَجَسِّد (يَمْتَلِكُ أَوْ يُوجَدُ فِي شَكْلٍ جَسَدِيّ) / بَدَنِيّ, جَسَدِيّ (يؤثّر في الجسم أو يتّصف به بخلاف العقل أو الروح) / عريف (ضابط صف في الجيش أو القوات الجوية أو المارينز)",
 "corporal punishment": "عُقُوبَةٌ بَدَنِيَّة",
 "corporality": "جُسْمَانِيَّة, مَادِّيَّة (صفة كون الشيء مادياً؛ مكوناً من مادة)",
 "corporate": "ذُو كَيَان, مُتَجَسِّد (يَمْتَلِكُ أَوْ يُوجَدُ فِي شَكْلٍ جَسَدِيّ) / مُدْمَج قَانُونِيًّا, مُسَاهَمَاتِيّ (منظم ومُدار ككيان قانوني مؤسسي) / جَمَاعِيّ, مُؤَسَّسِيّ (يتمّ بواسطة أفراد يعملون معًا أو يتّسم بالعمل الجماعيّ) / شركتي, مؤسسي (من أو ينتمي إلى شركة أو مؤسسة)\nمثال: أسعار الشركات",
 "corporate bond": "سند شركات (سند تصدره شركة؛ لا يحمل أي مطالبة بالملكية ولا يدفع أرباحاً ولكن مدفوعات حملة السندات لها الأولوية على مدفوعات المساهمين)\nمثال: سندات الشركات استثمار أكثر أماناً من الأسهم العادية في نفس الشركة",
 "corporate executive": "تنفيذي شركات, مسؤول أعمال (مسؤول تنفيذي في شركة تجارية)",
 "corporate finance": "تمويل الشركات (الأنشطة المالية للشركة)",
 "corporate investor": "شركة مستثمرة, مستثمر مؤسسي (شركة تستثمر في (تستحوذ على السيطرة على) شركات أخرى)",
 "corporate trust": "اتحاد احتكاري, كارتل (ائتلاف من المنظمات المستقلة تم تشكيله للحد من المنافسة من خلال التحكم في إنتاج وتوزيع منتج أو خدمة)\nمثال: أقاموا الاتحاد الاحتكاري على أمل الحصول على احتكار",
 "corporation": "كرش (مصطلحات عامية للكرش أو البطن البارز) / شركة مساهمة, مؤسسة (شركة تجارية تمت الموافقة على مواد تأسيسها في ولاية ما)",
 "corporation law": "قانون الشركات (فرع الفقه الذي يدرس القوانين التي تحكم الشركات)",
 "corporatism": "سيطرة الشركات, كوربوراتية (سيطرة مجموعات المصالح الكبيرة على الدولة أو المنظمة)\nمثال: الفردية في خطر الغرق بواسطة نوع من سيطرة الشركات",
 "corporatist": "تعاوني, نقابوي (من أو يتعلق بالنقابوية (تنظيم المجتمع في مجموعات مهنية)) / مؤيد لنظام الشركات (مؤيد لنظام الشركات)",
 "corporeal": "جسدي, مادي (له شكل مادي أو جسدي أو مادة) / بَدَنِيّ, جَسَدِيّ (يؤثّر في الجسم أو يتّصف به بخلاف العقل أو الروح)\nمثال: ما هو مخلوق هو بالضرورة جسدي ومرئي وملموس",
 "corporeality": "تسجيم",
 "corposant": "تفريغ هالي, نار سانت إلمو (تفريغ كهربائي مصحوب بتأين الغلاف الجوي المحيط)",
 "corps": "فَيْلَق",
 "corps de ballet": "فرقة الباليه (جوقة فرقة الباليه)",
 "corps diplomatique": "الخدمة الدبلوماسية, سلك دبلوماسي (هيئة الموظفين الدبلوماسيين)",
 "corpse": "جُثَّة, جُثْمَان",
 "corpulence": "بدانة, وزن زائد (خاصية السمنة المفرطة)",
 "corpulency": "بدانة, سمنة مفرطة (سمنة أكثر من المتوسط)",
 "corpulent": "بَدِين جِدًّا, سَمِين مُفْرِطًا (مُفْرِط فِي السِّمْنَة والبَدَانَة)",
 "corpus": "مَتْن / مَكْنَز لُغَوِيّ",
 "corpus amygdaloideum": "لوزة دماغية (بنية عصبية لوزية الشكل في الجزء الأمامي من الفص الصدغي للمخ؛ مرتبطة ارتباطاً وثيقاً بالوطاء والحصين والتلفيف الحزامي؛ وتلعب دوراً مهماً في الدافع…)",
 "corpus callosum": "جسم ثفني (مسلك عصبي مستعرض عريض يربط نصفي الكرة المخية)",
 "corpus cavernosum": "جِسْم كَهْفِيّ (شيء مادي؛ جسد الإنسان أو الحيوان)\nمثال: الحليب مفيد للجسم.",
 "corpus christi": "عيد القربان (الخميس بعد أحد الثالوث؛ احتُفل به لأول مرة عام 1246)",
 "corpus delicti": "أدلة الجريمة, جسم الجريمة (مجموعة الأدلة التي تشكل الجريمة؛ الدليل الموضوعي على ارتكاب جريمة (يُعتقد خطأً أحياناً أنه يشير إلى جثة ضحية جريمة قتل))",
 "corpus geniculatum laterale": "جسم ركبي وحشي (بنية عصبية تعمل كمحطة معالجة في الطريق من الشبكية إلى الفص القذالي للقشرة المخية)",
 "corpus geniculatum mediale": "جسم ركبي إنسي (بنية عصبية تعمل كآخر سلسلة من مراكز المعالجة على طول المسار السمعي من القوقعة إلى الفص الصدغي للقشرة المخية)",
 "corpus luteum": "جسم أصفر (نسيج صم أصفر يتكون في جريب جراف الممزق بعد إطلاق البويضة؛ يضمر بعد بضعة أيام ما لم يبدأ الحمل)",
 "corpus mamillare": "جسم حلمي (واحد من بنيتين دائريتين صغيرتين على السطح السفلي للدماغ تشكلان نهايات الأقواس الأمامية للقبو)",
 "corpus sternum": "جسم القص (الجزء المركزي الكبير من عظم القص)",
 "corpus striatum": "جسم مخطط (كتلة مخططة من المادة البيضاء والرمادية تقع أمام المهاد في كل نصف كرة مخية؛ تتكون من النواة المذنبة والنواة العدسية)",
 "corpuscle": "خلية دم, كريّة دم (أي من نوعي الخلايا (خلايا الدم الحمراء والبيضاء) وأحياناً تشمل الصفائح الدموية) / ذرة, هباءة ((الاستخدام غير التقني) قطعة صغيرة جداً من أي شيء)",
 "corpuscular": "جسيمي, كريوي (من أو يتعلق بالجسيمات الدقيقة أو الكريات)",
 "corpuscular radiation": "إشعاع جسيمي (تيار من الجسيمات الذرية أو دون الذرية التي قد تكون مشحونة إيجابياً (مثل جسيمات ألفا) أو سلبياً (مثل جسيمات بيتا) أو غير مشحونة (مثل النيوترونات))",
 "corpuscular theory": "نظرية جسيمية ((فيزياء) النظرية القائلة بأن الضوء ينتقل كسيل من الجسيمات)",
 "corpuscular theory of light": "نظرية جسيمية ((فيزياء) النظرية القائلة بأن الضوء ينتقل كسيل من الجسيمات)",
 "corpuscular-radiation pressure": "ضغط الإشعاع (الضغط الدقيق الذي يمارس على سطح عمودي على اتجاه انتشار الموجة)",
 "corral": "حظيرة أبقار, زريبة بقر (حظيرة للأبقار)",
 "corrasion": "بري, تآكل بالاحتكاك (التعرية عن طريق الاحتكاك)",
 "correct": "صَحِيح, صَوَاب / صَحَّحَ (جعل الشيء صحيحًا أو خاليًا من الأخطاء؛ أظهر صحة معلومة أو حقيقة)\nمثال: صحح نطقي من فضلك.",
 "correctable": "قَابِلٌ لِلتَّصْوِيب, قَابِلٌ لِلتَّعْدِيل (يُمْكِنُ تَصْحِيحُهُ بِإِضَافَاتٍ أَوْ تَعْدِيلَات) / قَابِل لِلتَّصْحِيح (يمكن إعادته إلى حالته الأصليّة؛ ليس بالضرورة دائمًا)",
 "corrected": "مصحح (تم تحييد شيء غير مرغوب فيه به)\nمثال: مع النظارات كانت رؤيتها المصححة 20:20",
 "correction": "تَصْحِيح",
 "correction fluid": "مُصَحِّح",
 "correctional": "إِصْلَاحِيّ, تَقْوِيمِيّ (يتعلّق بالتصحيح أو يوفّر الإصلاح)",
 "correctional institution": "إصلاحية, مؤسسة إصلاحية (مؤسسة عقابية تديرها الحكومة)",
 "correctional rehabilitation": "إصلاح وتقويم, تأهيل إصلاحي (توفير الحجز الجنائي أو المراقبة أو الإفراج المشروط للمجرمين المدانين)",
 "corrections": "إصلاحيات (الضبط الاجتماعي للمجرمين من خلال نظام السجن وإعادة التأهيل والمراقبة والإفراج المشروط) / إدارة الإصلاحيات, مصلحة السجون (إدارة تابعة للحكومة المحلية مسؤولة عن إدارة معاملة المدانين)\nمثال: لمعرفة مهنة في مجال الإصلاحيات، انتقل إلى الموقع الإلكتروني لإدارة الإصلاحيات في نيوجيرسي",
 "correctitude": "أدب, صواب (السلوك الصحيح أو المناسب)",
 "corrective": "تَصْحِيحِيّ (يهدف إلى تصحيح أو مقاومة أو إعادة الحالة إلى وضعها الطبيعي) / تَأْدِيبِيّ, تَصْحِيحِيّ (مُصمَّم لتعزيز الانضباط) / أداة تصحيحية, وسيلة علاجية (جهاز لعلاج إصابة أو مرض)",
 "correctly": "بشكل صحيح (بطريقة دقيقة)\nمثال: رسمت الزهرة بشكل صحيح من قبل ابنه",
 "correctness": "صحة, صواب (المطابقة للواقع أو الحقيقة) / انضباط, صحة (جودة المطابقة للتوقعات الاجتماعية)",
 "correlate": "مُتَرَابِطٌ, مُتَلَازِمٌ (مرتبط ارتباطاً متبادلاً) / متغير مترابط (أي من متغيرين أو أكثر مرتبطين أو متكاملين)",
 "correlated": "مُتَرَابِطٌ, مُتَلَازِمٌ (مرتبط ارتباطاً متبادلاً)",
 "correlation": "اِرْتِبَاط",
 "correlation coefficient": "الارتباط, معامل الارتباط (إحصائية تمثل مدى التقارب في التباين بين متغيرين؛ يمكن أن تتراوح من -1 (ارتباط سلبي تام) مروراً بـ 0 (لا يوجد ارتباط) إلى +1 (ارتباط إيجابي تام))\nمثال: ما هو الارتباط بين هذين المتغيرين؟",
 "correlation matrix": "مصفوفة الارتباط (مصفوفة تعطي الارتباطات بين جميع أزواج مجموعات البيانات)",
 "correlation table": "جدول الارتباط (جدولة ثنائية الاتجاه للعلاقات بين المتغيرات المترابطة)",
 "correlational": "ارتباطي (يتعلق بـ أو يستخدم الارتباط (الإحصائي))",
 "correlational analysis": "تحليل الارتباط (استخدام الارتباط الإحصائي لتقييم قوة العلاقات بين المتغيرات)",
 "correlational statistics": "ارتباط (علاقة إحصائية بين متغيرين أو أكثر بحيث تكون التغييرات المنهجية في قيمة متغير واحد مصحوبة بتغييرات منهجية في الآخر)",
 "correlative": "تَرَابُطِيّ, تَلَازُمِيّ (يعبر عن علاقة تبادلية أو تكاملية) / مُتَرَابِطٌ, مُتَلَازِمٌ (مرتبط ارتباطاً متبادلاً) / متغير مترابط (أي من متغيرين أو أكثر مرتبطين أو متكاملين)",
 "correlativity": "ارْتِبَاط مُتَبَادَل, تَرَابُط (علاقة متبادلة بين شيئين أو أكثر)",
 "correspond": "مَاثَلَ / راسَلَ",
 "correspondence": "مُرَاسَلَة",
 "correspondence course": "دورة بالمراسلة (دورة تقدم (بالبريد) من قبل مدرسة مراسلة)",
 "correspondence school": "مدرسة بالمراسلة (مدرسة تعلم الطلاب غير المقيمين عن طريق البريد)",
 "correspondent": "مُرَاسِل, مُرَاسِلَة (الكاتب)\nمثال: لن أنس مراسلة أمي.",
 "corresponding": "مُقَابِلٌ, مُنَاظِرٌ (مُصَاحِب ومُلازم) / مُطَابِق, مُمَاثِل (مُتَوافِق من كلّ وجه) / مُنَاظِر, مُوَازٍ (متشابه خاصّة في الموقع أو الوظيفة)",
 "correspondingly": "بالمقابل, تبعاً لذلك (بطريقة مقابلة)\nمثال: تنخفض الحرارة تبعاً لذلك",
 "corrida": "مصارعة الثيران (استعراض إسباني أو برتغالي أو أمريكي لاتيني؛ يقوم فيه الماتادور بمناوشة (وعادة) قتل ثور في حلبة أمام العديد من المتفرجين)",
 "corridor": "رِوَاق, دِهْلِيز (مَمَرّ خارج المَبْنَى وملاصق له يمتد عليه السَقْف ويُصفّ على الجانب الآخر الأعمدة؛ في العصر الحديث يُطلق على الممر عامة) / مَمَرّ جَوِّيّ, مُـخـتَرَق جَوِّيّ (على مَمَرّ العصور: على طولها ومداها؛ على مَمَرّ الفصول: على تواليها وتعاقبها)\nمثال: ذهب إلى الرواق.",
 "corrie": "حلبة جليدية, سيرك جليدي (حوض نصف دائري شديد الانحدار في جبل؛ قد يحتوي على بحيرة)",
 "corrigenda": "قائمة التصويبات (قائمة بأخطاء الطباعة في كتاب مع تصحيحاتها)",
 "corrigendum": "استدراك, تصويب (خطأ مطبعي؛ يجب تصحيحه)",
 "corrigible": "قابل للإصلاح, قابل للتصحيح (يمكن تصحيحه أو إصلاحه)\nمثال: عيب قابل للتصحيح",
 "corroborant": "مُقَوٍّ (يُستخدم لوصف دواء مقوٍّ ومنشّط)",
 "corroborating evidence": "دليل داعم, دليل مؤيد (أدلة إضافية أو أدلة من نوع مختلف تدعم إثباتاً تم تقديمه بالفعل في إجراء ما)",
 "corroboration": "إثبات, تأييد (تأكيد صحة حقيقة أو بيان من خلال استخدام الأدلة الوثائقية)",
 "corroborative": "تَأْكِيدِيّ, مُؤَيِّد (يُستخدم لدعم أو تأييد أو تأكيد صحة شيء)",
 "corroboratory": "تَأْكِيدِيّ, مُؤَيِّد (يُستخدم لدعم أو تأييد أو تأكيد صحة شيء)",
 "corrode": "أكل, أصدأ (تَنَاوَلَ الطَّعَام، وَضَعَه في فمِه ثُم مَضَغَه ثُم بَلَعَه؛ أَفْنَى الشيء ولَم يبقِ منه) / تآكل, صدئ\nمثال: أحب أكل البطيخ.",
 "corroded": "مُتَآكِل (أكله الحمض أو التأكسد وأتلفه)",
 "corroding": "تآكل, حت (تآكل بفعل العمليات الكيميائية)",
 "corrosion": "تَأَكُّل",
 "corrosion-resistant": "مُقَاوِم لِلتَّآكُل (محصَّن ضدّ التآكل والصدأ)",
 "corrosive": "أَكَّال, كَاوٍ ((عَنْ مَادَّةٍ، خَاصَّةً حَمْضٍ قَوِيٍّ) قَادِرٌ عَلَى إِتْلَافِ المَوَادِّ أَوْ تَآكُلِهَا) / أَكَّال, حَارِق (ساخر بشكل حاقد ومُؤذٍ) / مادة أكالة, مادة كاوية (مادة لها القابلية للتسبب في التآكل (مثل الأحماض القوية أو القلويات))",
 "corrosive sublimate": "المتسامي الآكل, كلوريد الزئبق (مادة بلورية بيضاء سامة قابلة للذوبان (ناتجة عن تسامي الزئبق)؛ تستخدم كمبيد للآفات أو مطهر أو مادة حافظة للخشب)",
 "corrugated": "مُمَوَّج (ذو تموّجات وتعرّجات متوازية على السطح)",
 "corrugated board": "ورق مقوى متموج (ورق مقوى ذو تموجات (يمكن لصقه بورق مقوى مسطح من جانب واحد أو كلا الجانبين))",
 "corrugated cardboard": "ورق مقوى متموج (ورق مقوى ذو تموجات (يمكن لصقه بورق مقوى مسطح من جانب واحد أو كلا الجانبين))",
 "corrugated fastener": "مثبت مموج (شريط صغير من الفولاذ المموج ذو نقاط حادة على جانب واحد؛ يُطرق عبر وصلات الخشب في النجارة الخشنة)",
 "corrugated iron": "حديد مموج, صاج معرج (عادة ما يكون صفائح حديد أو صلب مجلفنة مشكلة في تلال وتجاويف متوازية مستقيمة)",
 "corrugation": "تجعيد, تمويج (عملية التشكيل في حواف وأخاديد متوازية) / تجعد, تموج (بروز أو حيد على سطح مموج)",
 "corrupt": "مُرْتَشٍ, فَاسِد / أَفْسَدَ",
 "corrupted": "مُتَدَنٍّ, مُنْحَطّ (تَدَنَّتْ أَخْلَاقُهُ أَوْ جَوْدَتُه) / مُحَرَّف, مُشَوَّه (يحتوي على أخطاء أو تحريفات)",
 "corruptedly": "بفساد (بطريقة فاسدة)",
 "corruptibility": "قابلية للإفساد, قابلية للفساد (القابلية للوقوع في الفساد)",
 "corruptible": "قَابِلٌ لِلإِفْسَاد, قَابِلٌ لِلرَّشْوَة (يُمْكِنُ إِفْسَادُهُ أَوْ رَشْوَتُه)",
 "corrupting": "مُفْسِد, مُلَوِّث (يُعْدي أو يُلَوِّث) / مُحِطّ, مُفْسِد (ضارّ بالعقل أو الأخلاق) / مُضِلّ, مُفْسِد (يُغري بممارسات فاسدة ويقود إلى الضلال)",
 "corruption": "فَسَاد",
 "corruptive": "مُضِلّ, مُفْسِد (يميل إلى الإفساد والانحراف)",
 "corruptly": "بفساد (بطريقة فاسدة)",
 "corruptness": "رشوة, فساد (انعدام النزاهة أو الصدق (خاصة القابلية للرشوة)؛ استخدام منصب الثقة للكسب غير المشروع) / فساد (حالة كونه فاسداً)",
 "corsage": "باقة ورد (ترتيب للزهور يُعطى عادة كهدية)",
 "corsair": "سفينة قرصنة (سفينة قرصنة سريعة (تعمل غالباً بموافقة رسمية)) / قرصان بربري (قرصان على طول الساحل البربري)",
 "corse-du-sud": "كُورْسِيكَا الْجَنُوبِيَّة",
 "corselet": "جُنة, درع الجذع (قطعة من درع الجسد للجذع؛ تتكون عادة من صفيحة صدرية وقطعة للظهر)",
 "corset": "كورسيه",
 "corsica": "كُورَسِيكَا, كورسيكا",
 "corsican": "الْكُورْسِيكِيَّة",
 "corslet": "جُنة, درع الجذع (قطعة من درع الجسد للجذع؛ تتكون عادة من صفيحة صدرية وقطعة للظهر)",
 "cortaderia richardii": "توتوي, عشب ريشي (عشب طويل من نيوزيلندا يُزرع لرؤوس أزهاره التي تشبه الريش)",
 "cortaderia selloana": "عشب البامباس (عشب معمر طويل من بامباس أمريكا الجنوبية له ريش فضي وينمو في كتل كثيفة كبيرة)",
 "cortef": "كورتيزول, هيدروكورتيزون (هرمون قشرة الكظر الذي ينشط في استقلاب الكربوهيدرات والبروتين)",
 "cortege": "مَوْكِب (مُوَكِّب؛ مُوَكَّب)",
 "cortex": "قشرة العدسة (النسيج الذي يحيط بنواة العدسة) / قشرة مخية (طبقة الخلايا العصبية غير الميالينية (المادة الرمادية) التي تشكل قشرة المخ) / قشرة (النسيج المكون للطبقة الخارجية لعضو أو هيكل في النبات أو الحيوان)",
 "cortical": "قشري",
 "cortical area": "منطقة قشرية (أي من المناطق المختلفة للقشرة المخية)",
 "cortical cataract": "إعتام عدسة العين القشري, ساد قشري (ساد يؤثر على قشرة عدسة العين)",
 "cortical epilepsy": "صرع بؤري, صرع قشري (صرع تبدأ نوباته باضطراب معزول في وظيفة الدماغ (مثل ارتعاش في طرف أو إحساس وهمي أو اضطراب عقلي))",
 "cortical potential": "جهد قشري, موجة دماغية ((في الفسيولوجيا العصبية) تقلبات سريعة في الجهد بين أجزاء من القشرة المخية يمكن اكتشافها بواسطة مخطط كهربية الدماغ)",
 "cortical region": "منطقة قشرية (أي من المناطق المختلفة للقشرة المخية)",
 "cortically": "قشرياً (فيما يتعلق بالقشرة (المخية))\nمثال: إثارة ناتجة قشرياً",
 "corticifugal": "صَادِر قِشْرِيّ (خاصّ بليف عصبيّ يمرّ خارجًا من القشرة الدماغيّة)",
 "corticipetal": "وَارِد قِشْرِيّ (خاصّ بليف عصبيّ أو نبضة تنشأ خارجيًّا وتتّجه نحو القشرة الدماغيّة)",
 "corticium salmonicolor": "فطر المرض الوردي (فطر يسبب المرض الوردي في الحمضيات والبن وأشجار المطاط وغيرها)",
 "corticium solani": "فطر عفن القاع (فطر يسبب عفن القاع في الخس)",
 "cortico-hypothalamic": "قشري وطائي (من أو يتعلق بالقشرة المخية والوطاء)",
 "corticoafferent": "وَارِد قِشْرِيّ (خاصّ بليف عصبيّ أو نبضة تنشأ خارجيًّا وتتّجه نحو القشرة الدماغيّة)",
 "corticoefferent": "صَادِر قِشْرِيّ (خاصّ بليف عصبيّ يمرّ خارجًا من القشرة الدماغيّة)",
 "corticofugal": "صَادِر قِشْرِيّ (خاصّ بليف عصبيّ يمرّ خارجًا من القشرة الدماغيّة)",
 "corticoid": "ستيرويد قشري, كورتيكوستيرويد (هرمون ستيرويدي تنتجه قشرة الغدة الكظرية أو يتم تصنيعه؛ عند تناوله كدواء يقلل التورم ويقلل الاستجابة المناعية للجسم)\nمثال: تستخدم الستيرويدات القشرية الكظرية لعلاج العديد من الحالات المختلفة",
 "corticospinal tract": "سبيل هرمي, مسلك هرمي (أي من الأعصاب الحركية المهمة على كل جانب من الجهاز العصبي المركزي التي تمتد من المناطق الحسية الحركية للقشرة عبر جذع الدماغ إلى العصبونات الحركية…)",
 "corticosteroid": "ستيرويد قشري, كورتيكوستيرويد (هرمون ستيرويدي تنتجه قشرة الغدة الكظرية أو يتم تصنيعه؛ عند تناوله كدواء يقلل التورم ويقلل الاستجابة المناعية للجسم)\nمثال: تستخدم الستيرويدات القشرية الكظرية لعلاج العديد من الحالات المختلفة",
 "corticosterone": "كورتيكوستيرون (يفرز من قشرة الغدة الكظرية؛ يشارك في تنظيم توازن الماء والإلكتروليتات في الجسم)",
 "corticotrophin": "هرمون موجه لقشر الكظر (هرمون تنتجه الغدة النخامية الأمامية يحفز قشرة الغدة الكظرية)",
 "corticotropin": "هرمون موجه لقشر الكظر (هرمون تنتجه الغدة النخامية الأمامية يحفز قشرة الغدة الكظرية)",
 "cortina": "ستارة فطرية (حجاب جزئي يشبه نسيج العنكبوت يتكون من ليفات حريرية)",
 "cortinarius armillatus": "كورتيناريوس أرميلاتوس (فطر بقبعات سمراء كبيرة وخياشيم قرفة شاحبة وشريط أحمر من الحجاب حول الساق؛ يوجد عادة بالقرب من أشجار البتولا)",
 "cortinarius atkinsonianus": "كورتيناريوس أتكينسونيانوس (فطر صالح للأكل بقبعة لزجة تكون صفراء في البداية لكنها تتحول إلى زيتونية ثم سمراء؛ اللحم لافندر)",
 "cortinarius corrugatus": "كورتيناريوس مجعد (فطر بقبعة سمراء مجعدة لزجة؛ الساق له بصلة قاعدية تتضاءل مع استطالة الساق؛ الخياشيم بنفسجية داكنة في البداية لكنها سرعان ما تتحول إلى بنية)",
 "cortinarius gentilis": "كورتيناريوس جنتيليس (فطر سام بقبعة بنية صفراء زاهية وساق بلون القرفة الطويل)",
 "cortinarius mutabilis": "كورتيناريوس متغير (فطر بقبعة أرجوانية محمرة ذات سطح أملس لزج؛ خياشيم بنفسجية متقاربة؛ تصبغ جميع الأجزاء باللون الأرجواني الداكن عند الكدمات)",
 "cortinarius semisanguineus": "كورتيناريوس شبه دموي (فطر بقبعة بنية جافة وخياشيم حمراء صدئة وساق مصفر)",
 "cortinarius subfoetidus": "كورتيناريوس شبه نتن (فطر بقبعة لافندر لزجة وساق مبيض من الأعلى ومغطى بغمد لافندر حريري)",
 "cortinarius violaceus": "كورتيناريوس بنفسجي (فطر بنفسجي بالكامل بقبعة حرشفية)",
 "cortisol": "كورتيزول, هيدروكورتيزون (هرمون قشرة الكظر الذي ينشط في استقلاب الكربوهيدرات والبروتين)",
 "cortisone": "كُورْتِيزُون",
 "cortland": "تفاح كورتلاند (تفاح كبير ذو قشرة حمراء)",
 "cortone acetate": "كورتيزون (هرمون كورتيكوستيرويد تنتجه قشرة الغدة الكظرية بشكل طبيعي؛ يتحول إلى هيدروكورتيزون)",
 "corundom": "كورندوم, ياقوت (معدن صلب جداً يستخدم كمادة كاشطة)",
 "corundum": "سَامُور",
 "coruscant": "بَرَّاق, مُتَلَأْلِئ (ذُو وَمَضَاتٍ قَصِيرَةٍ وبَرَّاقَة مِنَ الضَّوْء)",
 "coruscation": "تألق, ومضة عبقرية (عرض مفاجئ أو مذهل للبراعة والذكاء) / تألق, تلألؤ (حدوث وميض صغير أو شرارة)\nمثال: ومضات من الذكاء العظيم",
 "corvee": "سُخْرَة (خدمة إجباريّة بغير أجر معلوم؛ تكليف عمل بلا أجر) / سُخْرَة, كُوج (خدمة إجباريّة بغير أجر معلوم؛ تكليف عمل بلا أجر)",
 "corvette": "فرقيطَة",
 "corvine": "غرابي (متعلق بالغراب أو يشبهه)",
 "corvine bird": "طائر غرابي (طيور من فصيلة الغراب)",
 "corvus brachyrhyncos": "غراب أمريكي (الغراب الشائع في أمريكا الشمالية)",
 "corvus corax": "غراب, غراب أسحم (طائر أسود كبير بمنقار مستقيم وذيل طويل وتدي الشكل)",
 "corvus frugilegus": "غراب القيظ (طائر اجتماعي شائع من العالم القديم بحجم ولون الغراب الأمريكي تقريباً)",
 "corvus monedula": "زاغ, غراب الزيتون (طائر أوراسي شائع أسود ورمادي يشتهر بالسرقة)",
 "corydalis": "بظيظة, كوردالس",
 "corydalis claviculata": "كورداليس متسلق (نبات متسلق حولي بأوراق مركبة وعناقيد من الزهور الصفراء والوردية)",
 "corydalus cornutus": "ذبابة دوبسون (حشرة كبيرة ناعمة الجسم لها فكوك نحيلة طويلة في الذكر؛ تستخدم اليرقات المائية غالباً كطعم)",
 "corylus americana": "بندق أمريكي (شجيرة تحمل مكسرات من شرق أمريكا الشمالية)",
 "corylus avellana": "بندق أوروبي, بندق شائع (شجرة صغيرة تحمل مكسرات تزرع كثيراً في أوروبا)",
 "corylus avellana grandis": "بندق أوروبي, بندق شائع (شجرة صغيرة تحمل مكسرات تزرع كثيراً في أوروبا)",
 "corylus cornuta": "بندق منقاري (بندق من غرب الولايات المتحدة بقنابات تشبه المنقار واضحة على المكسرات)",
 "corymb": "عذق, نورة عذقية (نورة مسطحة القمة أو محدبة تنمو فيها سيقان الزهور الفردية للأعلى من نقاط مختلفة على الساق الرئيسية لتصل إلى نفس الارتفاع تقريبًا؛ الزهور الخارجية تفتح…)",
 "corymbose": "عذقي, مشطي (يشبه العذق (نورة مشطية))",
 "corynebacterium": "وَتَدِيَّة",
 "corynebacterium diphtheriae": "عصوية كليبس-لوفلر, وتدية خناقية (نوع من البكتيريا يسبب الخناق (الدفتيريا))",
 "corypha gebanga": "نخيل جيبانغ (نخيل كبير الأوراق من الملايو إلى الفلبين وشمال أستراليا؛ تستخدم الأوراق للتسقيف أو الضفر في حاويات)",
 "corypha umbraculifera": "نخيل تاليبوت (نخيل طويل من جنوب الهند وسريلانكا بأوراق عملاقة تستخدم كمظلات ومراوح أو تقطع إلى شرائط لورق الكتابة)",
 "corypha utan": "نخيل جيبانغ (نخيل كبير الأوراق من الملايو إلى الفلبين وشمال أستراليا؛ تستخدم الأوراق للتسقيف أو الضفر في حاويات)",
 "coryphaena equisetis": "بومبانو الدلفين (نوع من سمكة الدلفين)",
 "coryphaena hippurus": "ماهي ماهي (سمكة الدلفين الأكثر شيوعاً والتي تُقدر كطعام؛ طولها حوالي ستة أقدام)",
 "coryphantha": "كوريفانثا (صبار من جنس كوريفانثا)",
 "corythosaur": "كوريثوصور (ديناصور بطي المنقار له ممرات أنفية تتوسع لتشكل عرفاً يشبه الخوذة المجوفة)",
 "corythosaurus": "كوريثوصور (ديناصور بطي المنقار له ممرات أنفية تتوسع لتشكل عرفاً يشبه الخوذة المجوفة)",
 "coryza": "التهاب الأنف, زكام (التهاب الغشاء المخاطي المبطن للأنف (يرتبط عادة بإفرازات أنفية))",
 "cos": "خس روماني, خس طويل (خس ذو أوراق خضراء داكنة طويلة في رأس ممدود معبأ بشكل فضفاض) / جَتَا, جَيْب التَّمَام (نسبة الضلع المجاور إلى الوتر في مثلث قائم الزاوية)",
 "cos lettuce": "خس روماني, خس طويل (خس ذو أوراق خضراء داكنة طويلة في رأس ممدود معبأ بشكل فضفاض) / خس روماني (خس ذو أوراق طويلة خضراء داكنة على شكل ملعقة)",
 "cosa nostra": "كوزا نوسترا, مافيا (نقابة جريمة في الولايات المتحدة؛ منظمة في عائلات؛ يعتقد أن لها علاقات مهمة بالمافيا الصقلية)",
 "coscoroba": "كوسكوروبا (طائر أبيض كبير من أمريكا الجنوبية يتوسط في بعض النواحي بين البط والبجع)",
 "cosec": "قَاطِع التَّمَام, قَتَا (نسبة الوتر إلى الضلع المقابل في مثلث قائم الزاوية)",
 "cosecant": "قَاطِعُ تَمَام",
 "coseismal": "مُتَزَامِنُ الزَّلَازِل (واقع في نقطة تصل إليها موجات الزلزال في الوقت نفسه)",
 "coseismic": "مُتَزَامِنُ الزَّلَازِل (واقع في نقطة تصل إليها موجات الزلزال في الوقت نفسه)",
 "cosh": "عصا سوداء, هراوة قصيرة (قطعة من المعدن مغطاة بالجلد بمقبض مرن؛ تستخدم لضرب الناس)",
 "cosher": "حَلَال يَهُودِيًّا, كُوشَر (مُطابق لقوانين الطعام اليهوديّة)",
 "cosignatory": "مُوَقِّع بِالاشْتِرَاك (يوقّع مع آخرين بصورة مشتركة) / موقع مشترك (أحد موقعين أو أكثر على نفس الوثيقة (كمعاهدة أو إعلان))",
 "cosigner": "موقع مشترك (أحد موقعين أو أكثر على نفس الوثيقة (كمعاهدة أو إعلان)) / ضامن, كفيل (موقع بالإضافة إلى الموقع الرئيسي (للتحقق من صحة التوقيع الرئيسي أو لتقديم ضمان))",
 "cosily": "بألفة, بشكل مريح (بطريقة مريحة وحميمة)\nمثال: استقر بألفة بجوار النار",
 "cosine": "جَيْب تَمَام (جيَّب القميص:جَابَ، جعل له جيبًا)\nمثال: جيب سامي مثقوب.",
 "cosine curve": "منحنى جيب التمام",
 "cosiness": "حميمية, دفء وراحة (حالة من الراحة الدافئة)",
 "cosmea": "كوزموس (أي من أعشاب مكسيكية متنوعة من جنس كوزموس لها رؤوس شعاعية من زهور ملونة وأوراق ريشية)",
 "cosmetic": "تَجْمِيلِيّ",
 "cosmetic dentistry": "طب الأسنان التجميلي (فرع طب الأسنان الذي يتعامل مع مظهر الأسنان)",
 "cosmetic surgeon": "جراح تجميل (جراح يقوم بتجميل الجسم (خاصة الوجه))",
 "cosmetic surgery": "شد الوجه (جراحة تجميلية لإزالة التجاعيد وعلامات الشيخوخة الأخرى من الوجه؛ يتم عمل شق قرب خط الشعر وشد الجلد واستئصال الأنسجة الزائدة)\nمثال: بعض الممثلات يقمن بأكثر من عملية شد وجه",
 "cosmetically": "تجميلياً (لأغراض تجميلية لتحسين المظهر)\nمثال: يستخدم تجميلياً من قبل العديد من النساء",
 "cosmetician": "أخصائي تجميل, خبير تجميل (شخص يعمل في صالون تجميل) / بائع مستحضرات تجميل, خبير تجميل (شخص يبيع أو يضع مستحضرات التجميل)",
 "cosmetics": "مُسْتَحْضَرَاتُ التَّجْمِيل",
 "cosmetologist": "أخصائي تجميل (خبير في استخدام مستحضرات التجميل)",
 "cosmetology": "تجميل (ممارسة تجميل الوجه والشعر والجلد)",
 "cosmic": "كَوْنِيّ, فَضَائِيّ",
 "cosmic background radiation": "إشعاع الخلفية الكونية ((في علم الكونيات) البقايا المبردة للانفجار العظيم الحار التي تملأ الكون بأسره ويمكن رصدها اليوم بمتوسط درجة حرارة حوالي 2.725 كلفن)",
 "cosmic dust": "غبار كوني (سحب من الجسيمات أو الغازات توجد في جميع أنحاء الفضاء بين النجمي)",
 "cosmic microwave background": "إشعاع الخلفية الكونية ((في علم الكونيات) البقايا المبردة للانفجار العظيم الحار التي تملأ الكون بأسره ويمكن رصدها اليوم بمتوسط درجة حرارة حوالي 2.725 كلفن)",
 "cosmic microwave background radiation": "إشعاع الخلفية الكونية ((في علم الكونيات) البقايا المبردة للانفجار العظيم الحار التي تملأ الكون بأسره ويمكن رصدها اليوم بمتوسط درجة حرارة حوالي 2.725 كلفن)",
 "cosmic radiation": "إشعاع كوني (إشعاع قادم من خارج النظام الشمسي)",
 "cosmic ray": "أشعة كونية (إشعاع مؤين عالي الاختراق من أصل خارج الأرض؛ يتكون بشكل رئيسي من بروتونات وجسيمات ألفا؛ الاصطدام بجسيمات الغلاف الجوي ينتج عنه أشعة وجسيمات من أنواع…)",
 "cosmic string": "وَتَر, وَتَر كَوْنِيّ ((علم الكونيات) جسيم دون ذري افتراضي أحادي البعد ذو تركيز للطاقة وخصائص ديناميكية لحلقة مرنة)",
 "cosmic time": "زمن كوني (الزمن الذي يغطيه التكوين المادي وتطور الكون)",
 "cosmid": "كوزميد ((في علم الوراثة) ناقل كبير مصنوع من لاقمة بكتيرية ويستخدم لاستنساخ الجينات أو شظايا الجينات)",
 "cosmocampus profundus": "سمك أنبوبي للمياه العميقة (سمكة طولها 8 بوصات؛ توجد من شرق فلوريدا إلى غرب البحر الكاريبي)",
 "cosmodrome": "كُوسْمُودْرُوم",
 "cosmogenic": "كوزمولوجي, كوني (متعلق بفرع علم الفلك الذي يتعامل مع أصل وتاريخ وبنية وديناميكية الكون)\nمثال: علم كوني",
 "cosmogeny": "علم الكون, نشأة الكون (فرع الفيزياء الفلكية الذي يدرس أصل وتطور وبنية الكون)",
 "cosmogonic": "كوزمولوجي, كوني (متعلق بفرع علم الفلك الذي يتعامل مع أصل وتاريخ وبنية وديناميكية الكون)\nمثال: علم كوني",
 "cosmogonical": "كوزمولوجي, كوني (متعلق بفرع علم الفلك الذي يتعامل مع أصل وتاريخ وبنية وديناميكية الكون)\nمثال: علم كوني",
 "cosmogony": "علم الكون, نشأة الكون (فرع الفيزياء الفلكية الذي يدرس أصل وتطور وبنية الكون)",
 "cosmographer": "كوزموغرافي, واصف الكون (عالم على دراية بعلم وصف الكون (الكوزموغرافيا))",
 "cosmographist": "كوزموغرافي, واصف الكون (عالم على دراية بعلم وصف الكون (الكوزموغرافيا))",
 "cosmography": "كوزموغرافيا, وصف الكون (تمثيل للأرض أو السماوات) / كوزموغرافيا, وصف الكون (العلم الذي يرسم السمات العامة للكون؛ يصف كلاً من السماء والأرض)\nمثال: كوزموغرافيا بطليموس",
 "cosmolatry": "عبادة الكون (عبادة الكون)",
 "cosmologic": "كوزمولوجي, كوني (متعلق بفرع الفلسفة الذي يتعامل مع عناصر وقوانين وخصائص الكون مثل المكان والزمان والسببية) / كوزمولوجي, كوني (متعلق بفرع علم الفلك الذي يتعامل مع أصل وتاريخ وبنية وديناميكية الكون)\nمثال: فلسفة كونية",
 "cosmological": "كوزمولوجي, كوني (متعلق بفرع الفلسفة الذي يتعامل مع عناصر وقوانين وخصائص الكون مثل المكان والزمان والسببية) / كوزمولوجي, كوني (متعلق بفرع علم الفلك الذي يتعامل مع أصل وتاريخ وبنية وديناميكية الكون)\nمثال: فلسفة كونية",
 "cosmological constant": "الثَّابِت الكَوْنِيّ (ثابت اعتباطي في معادلات نظرية النسبية العامة)",
 "cosmologist": "عالم كونيات (فلكي يدرس التطور وعلاقات الزمكان للكون)",
 "cosmology": "عِلْم الكَوْن الفِيزِيَائِيّ (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "cosmonaut": "رَجُل فَضَاء, رَائِد فَضَاء (العُضْو في جسد الإنسان يتكون من القَدَم والسَاق والفُخْذ. الجمع أرجُل، وقد تقول العامّة رِجْلين ورجْلينات؛ القَدَم من باب اطلاق اسم الكل على الجزء)\nمثال: هذا الرجل تاجر.",
 "cosmonautics": "مِلَاحَة فَضَائِيَّة, مِلَاحَة الفَضَاء",
 "cosmopolitan": "عَالَمِيّ, كَوْنِيّ (ذو نطاق أو تطبيق عالميّ شامل) / عالمي, كوزموبوليتاني (مكون من أشخاص من أجزاء كثيرة من العالم أو يألفون العيش فيها؛ خاصة من ليس لديهم مواقف أو اهتمامات إقليمية ضيقة) / عالمي الانتشار, كوزموبوليتاني (ينمو أو يحدث في أجزاء كثيرة من العالم) / عالمي, كوزموبوليتاني (شخص متطور سافر في العديد من البلدان)\nمثال: امتد إحسانه العالمي بنزاهة إلى جميع الأعراق وجميع المعتقدات",
 "cosmopolitanism": "الْمُوَاطَنَة الْعَالَمِيَّة",
 "cosmopolitanity": "عالمية, كوزموبوليتانية (حالة أو جودة كون الشيء عالمياً أو كوزموبوليتانياً)\nمثال: يتم تأكيد هذا التعريف العملي للكوزموبوليتانية من خلال النقاش الأكاديمي للمصطلح الذي نشأ من خلفية من المناقشات الطويلة",
 "cosmopolite": "مُوَاطِن اَلْعَالَم (مَدَنِيّ؛ مُقِيم)\nمثال: أنا مواطن لبناني",
 "cosmos": "فَضَاء (فَضَاء) / كَوْن / الْكَوْن\nمثال: الفضاء مليئ بالغموض.",
 "cosmotron": "كوزموترون (سنكروترون بروتوني كبير؛ يستخدم تعديل التردد لمجال كهربائي لتسريع البروتونات)",
 "cosplay": "كُوسْبْلَاي",
 "cosplayer": "كُوسْبِلايَر, مُتَقَمِّص شَخْصِيَّات (شخص يرتدي زي شخصية من كتاب هزلي أو وسائل إعلام مماثلة)",
 "coss": "كوس ((في الهند) وحدة للطول لها قيم مختلفة في مناطق مختلفة)",
 "cossack": "قُوزَاق",
 "cost": "سَاوَى, كَلَّفَ / تَكْلِفَة, كُلْفَة",
 "cost accountant": "محاسب تكاليف (متخصص في التسجيل المنهجي وتحليل التكاليف المترتبة على الإنتاج)",
 "cost accounting": "محاسبة التكاليف (تتبع تكاليف العناصر في الإنتاج)",
 "cost analysis": "تحليل التكلفة (تفصيل تكاليف عملية ما والإبلاغ عن كل عامل بشكل منفصل)",
 "cost cutting": "خفْض التكاليف (عملية تقليل التكاليف)",
 "cost increase": "ارتفاع, زيادة (زيادة في التكلفة)\nمثال: طلبوا زيادة بنسبة 10% في الأسعار",
 "cost ledger": "دفتر التكاليف (دفتر يظهر التكاليف المتراكمة مصنفة بطرق مختلفة)",
 "cost of capital": "تكلفة رأس المال (تكلفة الفرصة البديلة للأموال المستخدمة نتيجة لقرار استثماري؛ معدل العائد الذي يمكن أن تكسبه الشركة إذا اختارت استثماراً آخر بمخاطر معادلة)",
 "cost of living": "تكاليف المعيشَة",
 "cost of quality": "تكلفة الجودة (وسيلة لتحديد التكلفة الإجمالية للجهود وأوجه القصور المتعلقة بالجودة)",
 "cost overrun": "تجاوز التكلفة (زيادة التكلفة عن الميزانية)\nمثال: تطلب تجاوز التكلفة تخصيص أموال إضافية في الميزانية",
 "cost structure analysis": "تحليل هيكل التكلفة (تحليل اقتصادي لتكلفة تصنيع منتج ما ومقدار الربح الذي سيتم تحقيقه من تصنيعه)",
 "cost-benefit analysis": "تحليل التكلفة والفائدة (تحليل لفعالية التكلفة لبدائل مختلفة لمعرفة ما إذا كانت الفوائد تفوق التكاليف)",
 "cost-effective": "فَعَّالٌ مِنْ حَيْثُ التَّكْلُفَة (مُنتج نسبة إلى التكلفة)",
 "cost-efficient": "فَعَّالٌ مِنْ حَيْثُ التَّكْلُفَة (مُنتج نسبة إلى التكلفة)",
 "cost-of-living allowance": "بدل غلاء معيشة (بدل للتغيرات في مؤشر أسعار المستهلك)",
 "cost-of-living benefit": "بدل غلاء معيشة (ميزة تذهب لأي شخص تزيد مقبوضاته المالية تلقائياً مع ارتفاع الأسعار)",
 "cost-of-living index": "مؤشر أسعار المستهلك (مؤشر لتكلفة جميع السلع والخدمات للمستهلك النموذجي)",
 "cost-plus": "بِالتَّكْلِفَةِ زَائِدَ الرِّبْح (يُحَدِّدُ الدَّفْعَ بِنَاءً عَلَى التَّكْلِفَةِ الفِعْلِيَّةِ لِلإِنْتَاجِ مَعَ رِبْحٍ مُتَّفَقٍ عَلَيْه)",
 "cost-plus contract": "عقد التكلفة زائد نسبة (عقد يدفع فيه للمقاول تكلفته الإجمالية بالإضافة إلى نسبة مئوية محددة من الربح)",
 "cost-pull inflation": "تضخم مدفوع بالتكلفة (تضخم ناتج عن زيادة في تكاليف الإنتاج)",
 "costa": "ضلع (أي من الأزواج الاثني عشر من الأقواس العظمية المنحنية التي تمتد من العمود الفقري إلى أو باتجاه القص في البشر (وعظام مماثلة في معظم الفقاريات)) / ضِلْع, عِرْق (جزء يشبه الضلع في نبات أو حيوان (مثل الضلع الأوسط للورقة أو العرق السميك لجناح الحشرة))",
 "costa rica": "كُوسْتَارِيكَا",
 "costa rican": "كوستاريكي (من أو متعلق بكوستاريكا أو شعبها) / كوستاريكي (مواطن أو ساكن في كوستاريكا)\nمثال: الغابات المطيرة الكوستاريكية",
 "costa rican colon": "كولون, كولون كوستاريكي (وحدة المال الأساسية في كوستاريكا؛ تساوي 100 سنتيمو)",
 "costa rican monetary unit": "وحدة نقدية كوستاريكية (الوحدة النقدية في كوستاريكا)",
 "costal": "ضِلْعِيّ",
 "costal cartilage": "غضروف ضلعي (الغضاريف التي تربط القص بنهايات الأضلاع؛ تسمح مرونتها للصدر بالتحرك أثناء التنفس)",
 "costal groove": "أخدود ضلعي, ثلم ضلعي (أخدود بين الأضلاع توجد فيه الأعصاب والأوعية الدموية)",
 "costalgia": "ألم الضلوع, ألم جنبي (ألم في الصدر ناتج عن التهاب العضلات بين الضلوع)",
 "costanoan": "لغة كوستنوان (لغة بينوتية يتحدث بها شعب كوستنوان) / كوستانوان (فرد من شعب هندي في أمريكا الشمالية يعيش في ساحل كاليفورنيا بين مونتيري وخليج سان فرانسيسكو)",
 "costanoan language": "لغة كوستنوان (لغة بينوتية يتحدث بها شعب كوستنوان)",
 "costate": "ذُو أَضْلَاع (يمتلك أضلاعاً أو حزوزاً بارزة) / مُضَلَّع (ذو أضلاع أو حزوز بارزة)",
 "costermonger": "بائع خضار متجول (بائع متجول للفواكه والخضروات باستخدام عربة يد)",
 "costia": "كوستيا (سوطي يسبب مرض الكوستيا الذي غالباً ما يكون قاتلاً للأسماك)",
 "costia necatrix": "كوستيا (سوطي يسبب مرض الكوستيا الذي غالباً ما يكون قاتلاً للأسماك)",
 "costiasis": "كوستيا (مرض قاتل لأسماك المياه العذبة تسببه بروتوزوا سوطية تغزو الجلد)",
 "costing": "تقدير التكاليف (محاسبة التكاليف)",
 "costive": "قابض, ممسك (يؤخر إخراج البراز؛ يسبب الإمساك)",
 "costless": "بِلَا ثَمَن, مَجَّانِيّ (لَا يُكَلِّفُ شَيْئًا)",
 "costliness": "تكلفة باهظة, نفاسة (الجودة التي يمتلكها شيء ذو سعر أو قيمة كبيرة)",
 "costly": "ثَمِين, غَالٍ (ذو سعر مرتفع) / بَاهِظ التَّكْلِفَة (ينطوي على خسارة أو تضحية كبيرة)",
 "costmary": "عشبة مريم, كوستماري (أوراق تستخدم باعتدال (بسبب المرارة) في الصلصات والحساء والحشوات) / بلسم الحدائق, حشيشة مريم (عشب معمر أوراسي برائحة حشيشة الدود له أزهار صفراء تشبه الأزرار؛ يستخدم كبقلة أو خضروات للسلطة وأحياناً في المعطرات المجففة أو الشاي أو النكهة؛ يوضع…)",
 "costoaxillary vein": "وريد ضلعي إبطي (واحد من عدة أوردة تربط الأوردة الوربية بالوريد الصدري الوحشي أو الوريد الصدري الشرسوفي)",
 "costochondritis": "التهاب الغضروف الضلعي (التهاب عند تقاطع الضلع وغضروفه)",
 "costs": "أتعاب التقاضي, تكاليف قانونية (تعويض مالي للطرف الرابح عن نفقات التقاضي)",
 "costume": "بَذْلَة, بَدْلَة",
 "costume designer": "مسؤول الملابس, مصمم أزياء مسرحية (شخص يصمم أو يورد الأزياء (خاصة للمسرحيات أو الحفلات التنكرية))",
 "costumed": "بِزِيّ, مُتَنَكِّر (يرتدي ملابس مميزة لفترة أو بلد أو طبقة معينة)",
 "costumer": "مسؤول الملابس, مصمم أزياء مسرحية (شخص يصمم أو يورد الأزياء (خاصة للمسرحيات أو الحفلات التنكرية))",
 "costumier": "مسؤول الملابس, مصمم أزياء مسرحية (شخص يصمم أو يورد الأزياء (خاصة للمسرحيات أو الحفلات التنكرية))",
 "costus": "قُسْط (عَدْل؛ حِصَّة عادلة)\nمثال: سامي بحاجة إلى قسط من الراحة.",
 "costus oil": "زيت القسط (زيت عطري متطاير أصفر يتم الحصول عليه من جذر القسط؛ يُستخدم في العطور)",
 "costusroot": "قسط, قسط هندي (عشب حولي في شرق جبال الهيمالايا (كشمير) له زهور قرصية أرجوانية وجذر عطري ينتج زيتاً طياراً يستخدم في العطور ولحفظ الفراء)",
 "cosy": "تَوَاطُؤِيّ, حَمِيمِيّ (يوحي بالتواطؤ أو التآمر) / دَافِئ, مُرِيح (يوفر دفئاً مريحاً ومأوى خاصة في مكان صغير) / أَلِيف, حَمِيمِيّ (يُوَفِّرُ جَوًّا دَافِئًا وَوُدِّيًّا وَغَيْر رَسْمِيّ) / غطاء إبريق الشاي (غطاء قماشي مبطن للحفاظ على دفء إبريق الشاي)",
 "cot": "سرير سفري, سرير قابل للطي (سرير صغير يمكن طيه للتخزين أو النقل) / سرير أطفال, مهد (سرير أطفال ذو جوانب عالية مصنوعة من شرائح خشبية أو قضبان) / غطاء الإصبع, كشتبان واقٍ (غلاف يلبس لحماية الإصبع)",
 "cot death": "متلازمة موت الرضيع المفاجئ (موت مفاجئ وغير متوقع لرضيع يبدو بصحة جيدة أثناء النوم)",
 "cotabato": "كوتاباتو",
 "cotan": "ظَتَا, ظِلّ التَّمَام (نسبة الضلع المجاور إلى الضلع المقابل في مثلث قائم الزاوية)",
 "cotangent": "ظِلّ اَلتَّمَام (الإستمرار في العمل. أصله للنهار ثم أصبح يشمل النهار والليل)\nمثال: ظل الولد ساكنا.",
 "cotangent curve": "منحنى ظل التمام",
 "cote": "حظيرة صغيرة, خم (مأوى صغير للحيوانات الأليفة (مثل الأغنام أو الحمام))",
 "cote d'ivoire franc": "فرنك ساحل العاج (وحدة المال الأساسية في ساحل العاج)",
 "cotenant": "شريك في الاستئجار (واحد من مستأجرين أو أكثر يحملون حقاً في نفس العقار)",
 "coterie": "بطانة, زمرة (دائرة حصرية من الناس ذات هدف مشترك)",
 "coterminous": "مُتَسَاوِي المَدَى (متساوٍ في النطاق أو المدى أو المدة)",
 "coterminously": "بشكل متزامن, بشكل مشترك الحدود (بطريقة مشتركة الحدود أو النهاية)",
 "cotes de provence": "كوت دو بروفانس (نبيذ من جنوب شرق فرنسا على ساحل البحر المتوسط)",
 "cothromboplastin": "بروكونفيرتين (عامل تخثر يتكون في الكلى تحت تأثير فيتامين ك)",
 "cotilion": "كوتيلون (رقصة حيوية نشأت في فرنسا في القرن الثامن عشر) / حفل تقديم الفتيات, كوتيليون (حفل راقص يتم فيه تقديم الشابات للمجتمع)",
 "cotillion": "كوتيلون (رقصة حيوية نشأت في فرنسا في القرن الثامن عشر) / حفل تقديم الفتيات, كوتيليون (حفل راقص يتم فيه تقديم الشابات للمجتمع)",
 "cotinga": "كوتينغا (طائر جاثم من المناطق الاستوائية في العالم الجديد)",
 "cotinus americanus": "شجرة الدخان الأمريكية (شجرة شجيرية في جنوب الولايات المتحدة ذات أعمدة كبيرة من الزهور الريشية تشبه نفثات الدخان)",
 "cotinus coggygria": "سماق البندقية, شجرة الدخان (شجيرة من العالم القديم ذات أعمدة كبيرة من الزهور الريشية الصفراء تشبه نفثات الدخان)",
 "cotinus obovatus": "شجرة الدخان الأمريكية (شجرة شجيرية في جنوب الولايات المتحدة ذات أعمدة كبيرة من الزهور الريشية تشبه نفثات الدخان)",
 "cotoneaster": "سَفَرْجَلِيَّة, كُوتُونَسْتِر",
 "cotoneaster dammeri": "كوتونيستر دامر (شجيرة دائمة الخضرة متسلقة بزهور بيضاء وتوت أحمر؛ تستخدم غالباً كغطاء أرضي)",
 "cotoneaster horizontalis": "كوتونيستر أفقي (شجيرة متساقطة الأوراق مسطحة النمو بنمط عظم السمكة المروحي ولها زهور حمراء وتوت برتقالي أحمر؛ تستخدم كغطاء أرضي)",
 "cotonou": "كُوتُونُو",
 "cotswold": "كوتسوولد (خروف ذو صوف طويل أصله من تلال كوتسوولد)",
 "cottage": "كُوخ, مُنَيْزِل",
 "cottage cheese": "جُبْن قَرِيش (جَبَنَ يَجْبُن وجَبُنَ جُبْنًا وجُبُنًا وجَبانةً)\nمثال: قل جبنة يا زيري.",
 "cottage dweller": "ساكن الكوخ (شخص يعيش في كوخ)",
 "cottage industry": "صناعة منزلية (صناعة صغيرة النطاق يمكن أن يمارسها أفراد الأسرة في المنزل باستخدام معداتهم الخاصة)",
 "cottage pie": "فطيرة الكوخ (طبق من اللحم المفروم مغطى بالبطاطس المهروسة)",
 "cottage pink": "قرنفل الكوخ, قرنفل ريشي (قرنفل أوروبي يزرع لزهوره الوردية أو الوردية العطرة جداً)",
 "cottage tent": "خيمة عائلية (خيمة توفر مأوى لعائلة)",
 "cottage tulip": "توليب الكوخ (أي من عدة توليب طويل الساق يزهر في مايو؛ له زهور بيضاوية الشكل متنوعة الألوان)",
 "cottager": "ساكن الكوخ (شخص يعيش في كوخ)",
 "cottar": "تيلة, خابور (مثبت يتكون من إسفين أو مسمار يتم إدخاله عبر فتحة لتثبيت قطعتين أخريين معاً) / فلاح إسكتلندي, كوتر (مزارع فلاح في المرتفعات الاسكتلندية)",
 "cotter": "تيلة, خابور (مثبت يتكون من إسفين أو مسمار يتم إدخاله عبر فتحة لتثبيت قطعتين أخريين معاً) / فلاح قن (قن إنجليزي من العصور الوسطى) / فلاح إسكتلندي, كوتر (مزارع فلاح في المرتفعات الاسكتلندية)",
 "cotter pin": "مسمار تيل (تيل يتكون من مسمار مشقوق يتم تثبيته (بعد مروره عبر ثقب) عن طريق فصل النهايات عن بعضها)",
 "cottier": "فلاح قن (قن إنجليزي من العصور الوسطى)",
 "cotton": "قُطْن, قُطُن / قُطْنِي, قطن",
 "cotton ball": "كرة قطنية (مرض فطري يصيب التوت البري)",
 "cotton bollworm": "دودة كوز الذرة (يرقة عثة ليلية؛ مدمرة للغاية خاصة لمحاصيل الذرة والقطن والطماطم)",
 "cotton cake": "كُسب القطن (المادة الصلبة المتبقية بعد عصر الزيت من بذور القطن)",
 "cotton candy": "غَزْل اَلْبَنَات (غَزَلَ بمعنى حاك أو نسج، سواء في الحياكة أو الكلام. ويمكن أن يكون مرتبطًا بـ الغرام أو الحديث الغزلي؛ مُغازَلَةُ النِّساءِ: مُحادَثَتُهُنَّ، والاسمُ: الغَزَلُ والمَغْزَلُ)",
 "cotton fiber": "قطن (ألياف حريرية ناعمة من نباتات القطن في حالتها الخام)",
 "cotton flannel": "فانيلا قطنية (قماش قطني متين ذو وبر على جانب واحد فقط)",
 "cotton gin": "محلج قطن (آلة تفصل البذور عن ألياف القطن الخام)",
 "cotton grass": "عشب القطن (أي سعد من جنس إريوفوروم؛ نباتات مستنقعات شمالية معتدلة بسنابل متكتلة)",
 "cotton mill": "محلج قطن, مصنع قطن (مصنع نسيج لصنع المنسوجات القطنية)",
 "cotton mouse": "فأر القطن (فأر داكن كبير من جنوب شرق الولايات المتحدة)",
 "cotton plant": "قطن, نبات القطن (نبات خبازي شجيري منتصب أو شجرة صغيرة تحمل لوزات تحتوي على بذور ذات ألياف شعرية طويلة عديدة)",
 "cotton rat": "جرذ القطن (جرذ مدمر طويل الشعر يحفر الجحور، يعيش في جنوب أمريكا الشمالية وأمريكا الوسطى)",
 "cotton rose": "عشبة القطن, فيلاغو (أي نبات من جنس فيلاغو له عناقيد رأسية من رؤوس زهور صوفية صغيرة) / ورد القطن, ورد كونفدرالي (شجيرة صينية أو شجرة صغيرة ذات زهور بيضاء أو وردية تصبح حمراء داكنة في الليل؛ تزرع على نطاق واسع؛ متوطنة في جنوب شرق الولايات المتحدة)",
 "cotton rush": "عشب القطن (أي سعد من جنس إريوفوروم؛ نباتات مستنقعات شمالية معتدلة بسنابل متكتلة)",
 "cotton stainer": "بق القطن (بق حقيقي: بق يتلف ويلطخ ألياف القطن النامي)",
 "cotton strain": "سلالة القطن (تتغذى بشكل أساسي على القطن)",
 "cotton swab": "عُود أُذُن (قطعة من الخشب كالعصا جمعه عيدان؛ ما يُتَبَخَّر به)\nمثال: أشعلت عود ثقاب.",
 "cotton thistle": "شوك اسكتلندي, شوك صوفي (شوك أوراسي ثنائي الحول أبيض مشعر ذو أزهار أرجوانية شاحبة؛ متوطن في أمريكا الشمالية)",
 "cotton wool": "قطن (ألياف حريرية ناعمة من نباتات القطن في حالتها الخام)",
 "cotton-seed tree": "باخاريس, شجيرة الشيخ (شجيرة من المستنقعات المالحة في شرق وجنوب وسط أمريكا الشمالية وجزر الهند الغربية؛ الثمرة محاطة بخصل شعرية بيضاء تشبه الريش)",
 "cottonmouth": "خف الماء, فم القطن (ثعبان سام شبه مائي يعيش في مستنقعات جنوب الولايات المتحدة)",
 "cottonmouth moccasin": "خف الماء, فم القطن (ثعبان سام شبه مائي يعيش في مستنقعات جنوب الولايات المتحدة)",
 "cottonseed": "حَبّ القُطْن (الزرع، كبيرا كان أم صغيرا؛ بَذْرُ الزرع)\nمثال: زيري بحب المال.",
 "cottonseed cake": "كُسب القطن (المادة الصلبة المتبقية بعد عصر الزيت من بذور القطن)",
 "cottonseed oil": "زيت بذر القطن (زيت صالح للأكل معصور من بذور القطن)",
 "cottontail": "أرنب قطني الذيل (أرنب صغير شائع في أمريكا الشمالية ذو فرو رمادي أو بني وذيل بجانب سفلي أبيض؛ مضيف لقراد داء لايم)",
 "cottontail rabbit": "أرنب قطني الذيل (أرنب صغير شائع في أمريكا الشمالية ذو فرو رمادي أو بني وذيل بجانب سفلي أبيض؛ مضيف لقراد داء لايم)",
 "cottonweed": "عشبة القطن / أناغاليس لؤلؤي (نبات خالد أمريكي له أوراق بشعيرات صوفية ناعمة ورؤوس عذقية بقنابات بيضاء لؤلؤية)",
 "cottonwick": "قطنية الفتيل (من مياه المحيط الأطلسي الدافئة)",
 "cottonwood": "زيزفون أبيض (زيزفون أمريكي من منطقة أليغني) / خشب القطن (هو ما غَلَظَ وصَلُبَ من أصول الشَجَر وفروعها مثل الجِذْع والأغْصَان؛ هو ما صنع من جذوع أو أغصان الشَجَر)\nمثال: نحن نقطع الخشب.",
 "cottony": "قُطْنِيّ (ناعِم كَالقُطْن في المَلْمَس)",
 "cottony-white": "أَبْيَض قُطْنِيّ (أبيض ناصع كبياض القطن)",
 "cottrell precipitator": "مرسب, مرسب كهروسكوني (يزيل جزيئات الغبار من الغازات عن طريق الترسيب الكهروسكوني)",
 "cotula coronopifolia": "أزرار نحاسية, كوتولا (عشب من جنوب أفريقيا ذو رؤوس زهور كروية صفراء ذهبية؛ توطن في المناطق الرطبة)",
 "coturnix communis": "سمان مهاجر (السمان النموذجي للعالم القديم)",
 "coturnix coturnix": "سمان مهاجر (السمان النموذجي للعالم القديم)",
 "cotyledon": "فلقة (ورقة جنينية في النباتات البذرية)",
 "cotyloid": "حُقِّيّ, كُأْسِيّ (متعلّق بالتجويف الحُقّيّ الذي يستقبل رأس عظم الفخذ)",
 "cotyloid cavity": "تجويف حقي, حُق (التجويف الكأسي الشكل في عظم الورك الذي يستقبل رأس الفخذ لتشكيل مفصل كروي وحقي)",
 "cotyloid joint": "مفصل كروي, مفصل كروي وحقي (مفصل حر الحركة تتناسب فيه كرة على رأس عظم مع تجويف دائري في العظم الآخر)",
 "cotyloidal": "حُقِّيّ, كُأْسِيّ (متعلّق بالتجويف الحُقّيّ الذي يستقبل رأس عظم الفخذ)",
 "coucal": "كوكال (واقواق أرضي من العالم القديم له مخلب خلفي طويل يشبه الخنجر)",
 "couch": "فِرَاش, أَرِيكَة",
 "couch grass": "عشبة الكلب, نجيل زاحف (عشبة أوروبية تنتشر بسرعة عن طريق الجذامير الزاحفة؛ متوطنة في أمريكا الشمالية كعشبة ضارة)",
 "couch potato": "خَامِل",
 "couchette": "كوشيت, مقصورة نوم (مقصورة في قطار ركاب أوروبي؛ تحتوي على 4 إلى 6 أسرّة للنوم) / سرير مقصورة, كوشيت (مضجع للنوم في مقصورة قطار مجهزة بأسرة (كوشيت))",
 "coude system": "تلسكوب كوديه, نظام كوديه (تلسكوب عاكس مصمم بحيث يتم توجيه الضوء إلى حامل اللوحة أو جهاز المطياف)",
 "coude telescope": "تلسكوب كوديه, نظام كوديه (تلسكوب عاكس مصمم بحيث يتم توجيه الضوء إلى حامل اللوحة أو جهاز المطياف)",
 "coue": "إميل كويه, كويه (معالج نفسي فرنسي ادعى أنه إذا تخيل المرء أنه يتحسن، فإنه سيتحسن (1857-1926))",
 "cougar": "أَسَد جِبَال, كَوْجَر (نوع من السباع مفترس من فصيلة السنوريات، يشتهر بفروة تحيط برقبته. أنثاه لبوة. يُعرَف بمَلِك الغابة؛  الرجل الشجاع القوي. مؤنثه أَسَدَة)\nمثال: الأسد حيوان بري.",
 "cough": "كَحَّ, سَعَلَ / سَعَلَ (سَعِلَ يَسْعَلَ سَعَلاً: نَشِطَ) / سُعْلَة, سُعَال\nمثال: سعل زيري مرة أخرى.",
 "cough drop": "حلوى الحلق, قرص السعال (قرص طبي يستخدم لتهدئة الحلق)",
 "cough syrup": "أَدْوِيَةُ السُعَال",
 "coughing": "سعال, كحة (طرد مفاجئ ومزعج للهواء من الرئتين يطهر ممرات الهواء؛ عرض شائع لعدوى الجهاز التنفسي العلوي أو التهاب الشعب الهوائية أو الالتهاب الرئوي أو السل)",
 "coughing up": "تنخع, سعال (فعل طرد (الطعام أو البلغم) عن طريق السعال)",
 "could i see the menu, please": "قَائِمَة اَلطَّعَام لَو سَمَحْت",
 "coulisse": "كوليس, مجرى انزلاق (عضو خشبي محفور (مخدد) لاستيعاب لوح منزلق) / كواليس (لوح مسطح يقع في أجنحة المسرح)",
 "coulomb": "كُولُون",
 "coulomb's law": "قانون كولوم (مبدأ أساسي في الكهرباء الساكنة؛ قوة التجاذب أو التنافر بين جسيمين مشحونين تتناسب طردياً مع حاصل ضرب شحنتيهما وعكسياً مع مربع المسافة بينهما)",
 "coulter": "سكين المحراث, قاطعة المحراث (إسفين فولاذي حاد يسبق المحراث ويقطع التربة عمودياً)",
 "coumadin": "كومادين, وارفارين (مضاد للتخثر (الاسم التجاري كومادين) يستخدم لمنع وعلاج الجلطة أو الانصمام)",
 "coumara nut": "فول التونكا (بذور عطرية سوداء تشبه الجوز لشجرة فول التونكا؛ تستخدم في العطور والأدوية وكبديل للفانيليا)",
 "coumarone": "بنزوفوران, كومارون (مركب زيتي عديم اللون يستخرج من قطران الفحم ويستخدم في صناعة الراتنجات الاصطناعية)",
 "coumarone resin": "راتنج الكومارون, راتنج الكومارون والإندين (راتنج بلاستيك حراري ينتج عن بلمرة الإندين والكومارون؛ يستخدم في الطلاء وبلاط الأسفلت)",
 "coumarone-indene resin": "راتنج الكومارون, راتنج الكومارون والإندين (راتنج بلاستيك حراري ينتج عن بلمرة الإندين والكومارون؛ يستخدم في الطلاء وبلاط الأسفلت)",
 "coumarouna odorata": "شجرة التونكا, فول التونكا (شجرة طويلة في أمريكا الجنوبية الاستوائية لها قرون لبية بيضاوية الشكل تحتوي على بذور سوداء عطرية تشبه اللوز تستخدم للنكهة)",
 "council": "مَجْلِس / مَجْمَع (اسم مفعول من جَمَّعَ؛ كُلِّيَّة، جَامِعَة)\nمثال: كان سامي يعيش في مجمع مسور.",
 "council board": "طاولة اجتماعات (الطاولة التي يجلس حولها المجتمعون أثناء عقد اجتماع)",
 "council chamber": "قاعة مجلس الإدارة (غرفة تجتمع فيها لجنة (مثل مجلس إدارة شركة))",
 "council member": "عُضْو مَجْلِس, مُسْتَشار (عضو في مجلس (بلدي أو إداري))",
 "council of basel-ferrara-florence": "مجمع بازل-فيرارا-فلورنسا (المجمع المنعقد في 1431-1439 الذي ركز على القضاء على الهرطقات والإصلاحات داخل الكنيسة الرومانية الكاثوليكية)",
 "council of chalcedon": "مجمع خلقيدونية (المجمع المسكوني الرابع عام 451 الذي حدد الطبيعتين (البشرية والإلهية) للمسيح)",
 "council of constance": "مجمع كونستانس (المجمع المنعقد في 1414-1418 الذي نجح في إنهاء الانشقاق العظيم في الكنيسة الرومانية الكاثوليكية)",
 "council of economic advisors": "مجلس المستشارين الاقتصاديين (وكالة تنفيذية مسؤولة عن تقديم المشورة الاقتصادية للرئيس)",
 "council of elders": "مَجْلِس الحُكَمَاء, مَجْلِس الشُّيُوخ (مجلس يتكون عادة من الأعضاء الأكبر سناً والأكثر خبرة في المجتمع)",
 "council of ephesus": "مجمع أفسس (المجمع المسكوني الثالث عام 431 الذي أعلن مريم والدة للإله وأدان بيلاجيوس)",
 "council of europe": "مَجْلِس أُورُوبَا",
 "council of trent": "مجمع ترنت (مجمع للكنيسة الرومانية الكاثوليكية عُقد في ترينتو في ثلاث دورات بين عامي 1545 و1563 لفحص وإدانة تعاليم مارتن لوثر وغيره من المصلحين البروتستانت؛ أعاد…)",
 "council of vienne": "مجمع فيين (المجمع المنعقد في 1311-1313 الذي تعامل مع الجرائم المزعومة لفرسان الهيكل، وخطط لحملة صليبية جديدة، وتولى إصلاح رجال الدين)",
 "council on environmental policy": "مجلس السياسات البيئية (الوكالة التنفيذية التي تقدم المشورة للرئيس بشأن حماية البيئة)",
 "council table": "طاولة اجتماعات (الطاولة التي يجلس حولها المجتمعون أثناء عقد اجتماع)",
 "council tax": "ضريبة المجلس البلدي (ضريبة تفرضها السلطات المحلية على الأسر المعيشية؛ وتعتمد على القيمة المقدرة للعقار وعدد الأشخاص المقيمين فيه)",
 "councillor": "عُضْو مَجْلِس, مُسْتَشار (عضو في مجلس (بلدي أو إداري))",
 "councillorship": "عضوية المجلس (منصب عضو المجلس)",
 "councilman": "عضو مجلس (رجل عضو في مجلس)",
 "councilorship": "عضوية المجلس (منصب عضو المجلس)",
 "councilwoman": "عضوة مجلس (امرأة عضوة في مجلس)",
 "counsel": "شُورَى / مَشُورَة / نَصَحَ (نصحه: أَرْشَدَه وأَشَارَ عليه)\nمثال: نصح مناد بباية.",
 "counsel to the crown": "محامي التاج (محامي مرافعة يتم اختياره ليكون مستشاراً للحاكم البريطاني)",
 "counseling": "إِرْشَاد, اسْتِشَارَة (شيء يوفر التوجيه أو المشورة بشأن قرار أو مسار عمل)",
 "counselling": "إِرْشَاد, اسْتِشَارَة (شيء يوفر التوجيه أو المشورة بشأن قرار أو مسار عمل)",
 "counsellor": "محامي دفاع, مستشار قانوني (محامٍ يترافع في القضايا أمام المحكمة) / مرشد, ناصح (شخص يقدم المشورة بشأن المشكلات) / مشرف مخيم (شخص لديه واجبات إشرافية في مخيم صيفي)",
 "counsellorship": "استشارة, منصب المستشار (منصب المستشار)",
 "counselor": "محامي دفاع, مستشار قانوني (محامٍ يترافع في القضايا أمام المحكمة) / مرشد, ناصح (شخص يقدم المشورة بشأن المشكلات) / مشرف مخيم (شخص لديه واجبات إشرافية في مخيم صيفي)",
 "counselor-at-law": "محامي دفاع, مستشار قانوني (محامٍ يترافع في القضايا أمام المحكمة)",
 "counselorship": "استشارة, منصب المستشار (منصب المستشار)",
 "count": "عَدَّ / كُونْت",
 "count noun": "اسم معدود (اسم يقبل الجمع)",
 "count palatine": "كونت بلاط (كونت مارس سلطة ملكية في منطقته الخاصة)",
 "count per minute": "عَدّ فِي الدَّقِيقَة (التردد في الدقيقة)",
 "countable": "مَعْدُود",
 "countdown": "عَدّ تَنَازُلِيّ",
 "countenance": "مَلَامِح",
 "counter": "عَدَّاد",
 "counter check": "شيك شباك (شيك فارغ يوفره البنك لراحة العملاء الذين يقومون بسحوبات)",
 "counter conditioning": "إشراط مضاد (إشراط يتم فيه تكييف استجابة ثانية غير متوافقة مع محفز مشروط بالفعل)\nمثال: يكمن الإشراط المضاد وراء العديد من الإجراءات المستخدمة في العلاج السلوكي",
 "counter reformation": "الإصلاح المضاد (رد فعل الكنيسة الرومانية الكاثوليكية على الإصلاح البروتستانتي بإعادة تأكيد تكريم القديسين وسلطة البابا)",
 "counter tube": "أنبوب عداد (أداة قياس لعد أحداث التأين الفردية)",
 "counter-attack": "هُجُوم مُضَادّ",
 "counter-evidence": "دليل مضاد ((فلسفة، قانون، علوم) دليل يميل إلى دحض ادعاء أو فرضية)\nمثال: يستمر الناس في تأكيد جميع أنواع الأشياء في مواجهة أدلة مضادة واضحة",
 "counter-offensive": "هُجُوم مُضَادّ",
 "counter-revolutionist": "معادي للثورة (ثوري يهدف إلى عكس التغييرات التي أحدثتها ثورة سابقة)",
 "counter-sabotage": "مكافحة التخريب المادي (مكافحة تجسس مصممة لكشف ومواجهة التخريب المادي)",
 "counteraction": "إبطال المفعول, تحييد (إجراء يهدف إلى إبطال آثار إجراء سابق)",
 "counteractive": "مُحَايِد, مُضَادّ (يُعارِض أو يُحايِد أو يُخفِّف من أثرٍ بفعل مضادّ)",
 "counteractively": "بِشَكْل مُضَادّ, بِشَكْل مُقَاوِم (بطريقة مضادة)",
 "counterargument": "حجة مضادة (حجة تُقدم في معارضة حجة أخرى)",
 "counterattack": "هجوم مضاد ((شطرنج) هجوم يهدف إلى مواجهة ميزة الخصم في جزء آخر من الرقعة) / هجوم مضاد (هجوم من قبل قوة مدافعة ضد قوة عدو مهاجمة لاستعادة أرض مفقودة أو قطع وحدات العدو المتقدمة)",
 "counterattraction": "جذب منافس (عامل جذب منافس)",
 "counterbalance": "ثِقْل مُوَازِن, سَقُوم (ثَقَلَ الشيءَ يَثْقُلُه بِيَدِهِ ثَقْلًا: رَازَ ثِقَلَه؛ ثَقَلَ الشَّيْء بِيَدِهِ ثقلا قدّر ثِقْلَه) / وَازَنَ\nمثال: ان ثقل ما تحمل، فضع بعضا منه.",
 "counterbalanced": "مُتَوَازِنٌ بِثِقَل مُقَابِل (أُحضِر إلى حالة توازن بواسطة وزن أو قوّة معاكسة)",
 "counterbattery fire": "نيران مضادة للبطاريات (نيران توجه لتحييد أو تدمير أنظمة أسلحة النيران غير المباشرة)",
 "counterblast": "رد عنيف, هجوم مضاد (رد قوي وغير مقيد)\nمثال: أثار خطبتها اللاذعة رداً عنيفاً من زوجها",
 "counterblow": "ضربة مضادة (ضربة رد؛ ضربة انتقامية)",
 "counterbombardment": "قصف مضاد (قصف يهدف إلى تدمير أو تحييد أسلحة العدو)",
 "counterbore": "ريشة التخويش, مخوش (ريشة لتوسيع الجزء العلوي من الثقب)",
 "countercharge": "هجوم مضاد (هجمة انتقامية) / تهمة مضادة (تهمة يوجهها المتهم ضد من اتهمه)",
 "countercheck": "تحقق إضافي, فحص مزدوج (شيء يتحقق من صحة فحص سابق) / كبح مضاد (كبح يقيد كبحاً آخر)",
 "counterclaim": "دعوى مضادة (مطالبة مقدمة لمعارضة مطالبة أخرى في إجراء قانوني)",
 "counterclockwise": "عَكْس عَقَارِب السَّاعَة (في اتجاه معاكس لاتجاه حركة عقارب الساعة) / عَكْس اتِّجَاه عَقَارِب السَّاعَة (في الاتجاه المعاكس لدوران عقارب الساعة)\nمثال: الرجاء التحرك عكس اتجاه عقارب الساعة في دائرة!",
 "counterclockwise rotation": "دوران عكس عقارب الساعة, دوران يساري (دوران إلى اليسار)",
 "countercoup": "اِنْقِلَاب مُضَادّ (إطاحة مفاجئة وحاسمة بحكومة وصلت إلى السلطة عن طريق انقلاب)",
 "counterculture": "ثقافة مضادة (بمعنى صار حَاذقا فطنا؛ المعرفة الواسعة والإطلاع على الكثير من المعلومات)\nمثال: توم لا يهتم بالثقافة.",
 "countercurrent": "تَيَّار مُعَاكِس (أفعال معاكسة لنشاط المجموعة الرئيسي) / تيار ساحب, تيار عنيف (امتداد من المياه المضطربة في نهر أو في البحر ناتج عن تدفق تيار في تيار آخر أو عبره)\nمثال: عطلت التيارات السياسية المعاكسة المؤتمر",
 "counterdemonstration": "مظاهرة مضادة (مظاهرة تقام معارضة لمظاهرة أخرى)\nمثال: نظم أنصار الرئيس مظاهرة مضادة لدعمه",
 "counterdemonstrator": "مُتَظاهِر مُضادّ (شخص يتظاهر معارضاً لمظاهرة أخرى)",
 "counterespionage": "مُكَافَحَة تَجَسُّس",
 "counterevidence": "دليل مضاد ((فلسفة، قانون، علوم) دليل يميل إلى دحض ادعاء أو فرضية)\nمثال: يستمر الناس في تأكيد جميع أنواع الأشياء في مواجهة أدلة مضادة واضحة",
 "counterexample": "مِثَال مُعَاكِس, مِثَال مُضَادّ",
 "counterfactual": "فَرَضِيّ, مُخَالِفٌ لِلوَاقِعِ (يُنَاقِضُ الوَقَائِعَ (عَادَةً كَفَرَضِيَّةٍ))",
 "counterfactuality": "افتراضية جدلية, مخالفة الواقع (صفة كون الشيء مخالفاً للحقائق الواقعة)",
 "counterfeit": "مزيف, مقلد (غير حقيقي؛ يقلد شيئاً متفوقاً) / تزوير, تزييف (نسخة يتم تقديمها على أنها الأصل)\nمثال: عاطفة مزيفة",
 "counterfeiter": "مُزَوِّر",
 "counterfire": "نيران مضادة (نيران تهدف إلى تحييد أو تدمير أسلحة العدو)",
 "counterfoil": "كَعْب",
 "counterglow": "توهج معاكس (بقعة خافتة من الضوء في سماء الليل تظهر مباشرة مقابل موقع الشمس؛ انعكاس لضوء الشمس بواسطة مادة نيزكية دقيقة في الفضاء)",
 "counterinsurgency": "تَهْدِئَة, مُكَافَحَة التَمَرُّد (إجراءات تتخذها الحكومة لهزيمة التمرد)",
 "counterinsurgent": "مكافح للتمرد (متعلق بالإجراءات التي تتخذها الحكومة لهزيمة التمرد أو مميز لها)",
 "counterintelligence": "مكافحة التجسس (أنشطة استخباراتية معنية بتحديد ومواجهة التهديد للأمن الذي تشكله منظمات الاستخبارات المعادية أو الأفراد المنخرطون في التجسس أو التخريب أو التخريب…)",
 "counterintuitive": "مُنَافٍ لِلبَدِيهَة (يتعارض مع ما يقتضيه الحسّ السليم أو البداهة)",
 "counterintuitively": "عَكْس البَدِيهَة (بطريقة مخالفة للبديهة)",
 "counterirritant": "مهيج مضاد (دواء يطبق موضعياً لإنتاج التهاب سطحي من أجل تقليل الالتهاب الأعمق)",
 "counterman": "عامل كاونتر (ذكر يخدم في كاونتر (كما في مطعم صغير))",
 "countermand": "أمر مضاد, إلغاء أمر (أمر معاكس يلغي أو يبطل أمرًا سابقًا)",
 "countermarch": "سير معاكس ((عسكرية) مسير في الاتجاه المعاكس أو العودة على نفس الطريق)",
 "countermeasure": "إجراء مضاد (إجراء يُتخذ لتعويض أو مواجهة إجراء آخر)",
 "countermine": "لغم مضاد, نفق مضاد ((عسكري) نفق يُحفر لإحباط أنشطة مماثلة من قبل العدو)",
 "countermortar fire": "نيران مضادة للهاون (نيران هاون تهدف إلى تدمير أو تحييد أسلحة العدو)",
 "countermove": "هجوم مضاد (هجوم من قبل قوة مدافعة ضد قوة عدو مهاجمة لاستعادة أرض مفقودة أو قطع وحدات العدو المتقدمة)",
 "counteroffensive": "هجوم مضاد شامل (هجوم واسع النطاق (أكثر من مجرد هجوم مضاد) تقوم به قوة مدافعة لانتزاع المبادرة من قوة مهاجمة)",
 "counteroffer": "عَرْض مُضَادّ, عَرْض مُقَابِل (عرض يقدمه شخص رفض عرضاً سابقاً)",
 "counterpane": "غطاء سرير, مفرش سرير (غطاء مزخرف للسرير)",
 "counterpart": "نَظِير",
 "counterperson": "عامل شباك الخدمة (شخص يخدم عند المنضدة (كما في المطاعم الصغيرة))",
 "counterplan": "خطة مضادة, مؤامرة مضادة (مؤامرة تهدف إلى تخريب مؤامرة أخرى)",
 "counterplay": "هجوم مضاد ((شطرنج) هجوم يهدف إلى مواجهة ميزة الخصم في جزء آخر من الرقعة)",
 "counterplea": "دفع مضاد (رد المدعي على دفع المدعى عليه)",
 "counterplot": "خطة مضادة, مؤامرة مضادة (مؤامرة تهدف إلى تخريب مؤامرة أخرى)",
 "counterpoint": "طباق, كونتربوينت (شكل موسيقي يتضمن الصوت المتزامن للحنين أو أكثر)",
 "counterpoise": "ثقل موازن (وزن يوازن وزناً آخر)",
 "counterpoised": "مُتَوَازِنٌ بِثِقَل مُقَابِل (أُحضِر إلى حالة توازن بواسطة وزن أو قوّة معاكسة)",
 "counterpoison": "ترياق, مضاد للسم (علاج يوقف أو يسيطر على آثار السم)",
 "counterpreparation fire": "نيران تحضير مضادة (نيران مكثفة مرتبة مسبقاً يتم إطلاقها عند اكتشاف وشك هجوم العدو)",
 "counterproductive": "نَتَائِج عَكْسِيَّة",
 "counterproject": "مشروع مضاد (مشروع أو مخطط أو اقتراح يتم تقديمه لمعارضة آخر، كما في التفاوض على معاهدة)",
 "counterproposal": "اقْتِرَاح مُضَادّ (اقتراح يقدم كبديل لاقتراح سابق)",
 "counterpunch": "صد, لكمة مضادة (لكمة رد (خاصة من قبل ملاكم))",
 "counterreformation": "إصلاح مضاد (إصلاح يهدف إلى مواجهة نتائج إصلاح سابق)",
 "counterrevolution": "ثَوْرَة مُضَادَّة (ثورة تهدف إلى عكس التغييرات التي أدخلتها ثورة سابقة)",
 "counterrevolutionary": "معاد للثورة (يتميز بالمعارضة أو العداء للثورة) / مضاد للثورة (متعلق بالثورة المضادة) / معادي للثورة (ثوري يهدف إلى عكس التغييرات التي أحدثتها ثورة سابقة)\nمثال: منبوذ لميوله المعادية للثورة",
 "counterrevolutionist": "معادي للثورة (ثوري يهدف إلى عكس التغييرات التي أحدثتها ثورة سابقة)",
 "countershot": "رمية مضادة (طلقة رد؛ طلقة انتقامية)",
 "countersign": "توقيع مصادقة (توقيع تأكيد ثانٍ يصادق على وثيقة موقعة بالفعل) / كلمة سر, كلمة مرور (كلمة أو عبارة سرية لا يعرفها إلا مجموعة محددة)\nمثال: نسي كلمة السر",
 "countersignature": "توقيع مصادقة (توقيع تأكيد ثانٍ يصادق على وثيقة موقعة بالفعل)",
 "countersink": "ريشة التخويش, مخوش (ريشة لتوسيع الجزء العلوي من الثقب) / ثقب غاطس (ثقب (عادة في الخشب) مع توسيع الجزء العلوي بحيث يتناسب معه المسمار أو البرغي ويستقر تحت السطح)",
 "countersink bit": "ريشة التخويش, مخوش (ريشة لتوسيع الجزء العلوي من الثقب)",
 "counterspy": "جاسوس مضاد, عميل مندس (جاسوس يعمل ضد تجسس العدو)",
 "counterstain": "صبغة مضادة (صبغة ذات لون مغاير تُستخدم عندما لا تُظهر الصبغة الأساسية الهيكل بوضوح)",
 "countersubversion": "مكافحة التخريب المعنوي (جانب من مكافحة التجسس مصمم لكشف ومنع الأنشطة التخريبية)",
 "countersuit": "دعوى مضادة (دعوى مرفوعة ضد شخص قام بمقاضاتك)",
 "countertenor": "كَاونْتِر تِينُور (أعلى صوت ذكوريّ؛ ذو مدى فوق طبقة التينور) / كونترتينور (أعلى صوت غنائي للذكور البالغين) / كونتر تينور (مغنٍ ذكر بصوت أعلى من التينور)",
 "counterterror": "مكافح للإرهاب (يهدف إلى منع الإرهاب)\nمثال: اتخذت الحكومة تدابير لمكافحة الإرهاب",
 "counterterrorism": "مكافحة الإرهاب (استراتيجية تهدف إلى منع الإرهاب أو مواجهته)",
 "counterterrorist": "مكافح للإرهاب (يهدف إلى منع الإرهاب) / مُكَافِح الْإِرْهَاب (شخص يحاول منع الإرهاب)\nمثال: اتخذت الحكومة تدابير لمكافحة الإرهاب",
 "counterterrorist center": "مركز مكافحة الإرهاب (وكالة تساعد مدير الاستخبارات المركزية في تنسيق جهود مكافحة الإرهاب من أجل استباق الأنشطة الإرهابية وتعطيلها وهزيمتها في أقرب مرحلة ممكنة)",
 "countertop": "سَطْح الْعَمَل (سَطحَهُ يَسْطَحَ سَطْحًا: بَسَطَهُ وسَوّاه؛ فهو مَسْطُوحٌ، وسَطِيحٌ)\nمثال: هناك ثقوب على السطح.",
 "countertransference": "تحويل مضاد, نقل مضاد (إزاحة المحلل النفسي لمشاعره تجاه المريض أو بشكل عام التورط العاطفي للمحلل النفسي في التفاعل العلاجي)",
 "countervailing duty": "رسوم تعويضية (رسوم تفرض لتعويض الدعم الذي تقدمه الحكومات الأجنبية)",
 "counterweight": "ثقل موازن (وزن يوازن وزناً آخر)",
 "counterwoman": "عاملة كاونتر (أنثى تخدم في كاونتر (كما في مطعم صغير))",
 "countess": "كونتيسة (المكافئ الأنثوي للكونت أو الإيرل)",
 "counting": "إحصاء, عد (فعل العد؛ تلاوة الأرقام بترتيب تصاعدي)\nمثال: استمر العد لعدة ساعات",
 "countinghouse": "مكتب حسابات (مكتب يستخدمه محاسبو شركة تجارية)",
 "countless": "لَا يُحْصَى, لَا يُعَدّ (أَكْثَر مِنْ أَنْ يُحْصَى أَوْ يُعَدّ)",
 "countlessness": "كثرة لا تحصى, ما لا يحصى (عدد يفوق الحصر)",
 "countrified": "رِيفِيُّ الطَّابِع (يتّسم بسمات الحياة الريفيّة)",
 "country": "دَوْلَة, بَلَد (بَلَد يتميز بحُدُود معروفة وشَعْب وحُكُومَة ومُؤَسَسَات مُنَظَّمَة؛ مجموعة من الناس مستقلين متحدين معا لتكوين مجتمع لحماية حقوقهم و وضع قوانينهم الخاصة) / رِيف, ريف (أرْض فيها زَرْع وخِصْب، بعكس الصَحْرَاء؛ أرْض يَزْرعها الناس، ضَيْعَة) / كونتري, كنتري / رِيفِيّ, نِسْبَة إِلَى الرِّيف\nمثال: لبنان دولة صغيرة.",
 "country and western": "موسيقى الريف الأمريكي, موسيقى الكانتري (نمط بسيط من الموسيقى الشعبية يسمع غالباً في جنوب الولايات المتحدة؛ يُعزف عادة على الآلات الوترية)",
 "country borage": "زهرة الغمد, كوليوس عطري",
 "country bumpkin": "شَخْص رِيفِيّ أَحْمَق (سواد الإنسان حين يرى من بعيد فلا يُعرَف؛ واحد الإنسان بصورة عامة بدون تحديد لسنه وجنسه وقومه وغير ذلك)\nمثال: هذا الشخص فنان.",
 "country club": "كانتري كلوب, نادي ريفي (نادي في الضواحي للترفيه والتواصل الاجتماعي)",
 "country dancing": "رقص ريفي, كونتردانس (نوع من الرقص الشعبي يترتب فيه الأزواج في مجموعات أو يواجهون بعضهم البعض في خط)",
 "country doctor": "طبيب ريفي (طبيب يمارس مهنته في الريف (بدلاً من المدينة) وعادة ما يكون بعيداً عن المستشفيات الحديثة)\nمثال: هل لا يزال أطباء الريف يقومون بزيارات منزلية؟",
 "country house": "منزل ريفي (منزل (عادة كبير ومثير للإعجاب) في عزبة في الريف)",
 "country music": "كانتري, موسيقى الكانتري",
 "country of origin": "أرض الوطن, البلد الأم (البلد الذي ولدت فيه)",
 "country people": "ريفيون, قرويون (الناس الذين نشأوا أو يعيشون في بيئة ريفية) / أبناء الوطن, مواطنون (الناس الذين يعيشون في نفس البلد)",
 "country store": "متجر ريفي, متجر عام (متجر بيع بالتجزئة يخدم منطقة ذات كثافة سكانية منخفضة؛ عادة ما يكون مخزناً بمجموعة واسعة من البضائع)",
 "country-bred": "خَشِن, رِيفِيُّ النَّشْأَةِ (فظّ وغير مهذّب؛ نشأ في الريف)",
 "country-dance": "رقص ريفي, كونتردانس (نوع من الرقص الشعبي يترتب فيه الأزواج في مجموعات أو يواجهون بعضهم البعض في خط)",
 "country-style": "عَلَى الطِّرَازِ الرِّيفِيّ (نموذجيّ لأسلوب الحياة الريفيّة)",
 "countryfied": "رِيفِيُّ الطَّابِع (يتّسم بسمات الحياة الريفيّة)",
 "countryfolk": "ريفيون, قرويون (الناس الذين نشأوا أو يعيشون في بيئة ريفية) / أبناء الوطن, مواطنون (الناس الذين يعيشون في نفس البلد)",
 "countryman": "مُوَاطِن (مَدَنِيّ؛ مُقِيم)\nمثال: أنا مواطن لبناني",
 "countryseat": "عزبة ريفية, مقر ريفي (ضيعة أو منزل كبير في الريف)",
 "countryside": "رِيف (أرْض فيها زَرْع وخِصْب، بعكس الصَحْرَاء؛ أرْض يَزْرعها الناس، ضَيْعَة)\nمثال: الريف بلد كبير.",
 "countrywide": "عَلَى مُسْتَوَى البِلَاد, قَوْمِيّ (يحدث أو يمتدّ في أنحاء البلاد أو الأمّة كلّها)"
}
