 "conifer": "شجرة مخروطية, صنوبريات (أي شجرة أو شجيرة عارية البذور تحمل مخاريط)",
 "coniferous": "صَنَوْبَرِيّ, مَخْرُوطِيّ (متعلق بالأشجار أو الشجيرات الحاملة للمخاريط وذات الأوراق الدائمة الخضرة)",
 "coniferous tree": "شجرة مخروطية, صنوبريات (أي شجرة أو شجيرة عارية البذور تحمل مخاريط)",
 "conima": "كونيما (راتنج صمغي من الشوكران السام)",
 "coniogramme japonica": "سرخس الخيزران (سرخس ياباني قوي وسريع النمو؛ يزرع لسعفه الريشي الأخضر الداكن العريض الجذاب)",
 "conium maculatum": "سيكران, شوكران (عشب كبير متفرع ثنائي الحول موطنه أوراسيا وأفريقيا ووافد إلى أمريكا الشمالية، له أوراق كبيرة تشبه السرخس وأزهار بيضاء؛ يوجد عادة في البيئات الرطبة؛…)",
 "conjectural": "فَرَضِيّ",
 "conjecturally": "بشكل تخميني, حدسياً (بطريقة تنطوي على أو تميل إلى التخمين والافتراض)",
 "conjecture": "فَرَضِيَّة, اِفْتِرَاض (مؤنث الفَرَضِيّ، وهو المنسوب إلى الفَرَض؛ الفَرَض، ما يُفْتَرَض من الأمور، خلاف الحَقِيقَة. كلمة حديثة) / تَخْمِين\nمثال: الحقائق تؤكد هذه الفرضية.",
 "conjoined": "مُتَلَازِم, مُتَّحِد (يتكوّن من كيانين مرتبطين أو أكثر)",
 "conjoined twin": "توأم سيامي, توأم ملتصق (أحد زوجي توأم متطابق يولد وجسماهما متصلان في نقطة ما)",
 "conjoint": "مُتَلَازِم, مُتَّحِد (يتكوّن من كيانين مرتبطين أو أكثر)",
 "conjointly": "بشكل مشترك, جماعياً (بالاشتراك مع؛ مجتمعين)\nمثال: رواتبنا مجتمعة لا تستطيع دفع ثمن الضرر",
 "conjugal": "زوجي (متعلق بالزواج أو بالعلاقة بين الزوج والزوجة)\nمثال: هناء زوجي",
 "conjugal family": "أسرة نووية (أسرة تتكون من الوالدين وأطفالهم وجدي أحد الزوجين)",
 "conjugal right": "حق زوجي (حق المتزوجين في التمتع بالارتباط والتعاطف والسعادة المنزلية والعيش معًا والاستفادة من حقوق الملكية المشتركة)",
 "conjugal visitation": "حق الزيارة الزوجية, خلوة شرعية (الحق القانوني في السجن للسجين وزوجه في الخلوة)",
 "conjugal visitation right": "حق الزيارة الزوجية, خلوة شرعية (الحق القانوني في السجن للسجين وزوجه في الخلوة)",
 "conjugally": "زوجياً (بطريقة زوجية)",
 "conjugate": "مَقْرُون, مُتَرَافِق ((فِي الكِيمِيَاء العُضْوِيَّة) يَحْتَوِي عَلَى رَابِطَتَيْن مُزْدَوِجَتَيْن أَوْ أَكْثَر يَفْصِلُ بَيْنَهُمَا رَابِطَة أُحَادِيَّة) / مُتَّحِد, مُقْتَرِن (مُتَكَوِّن مِنِ اتِّحَاد مُرَكَّبَيْن) / مُقْتَرِن ((عن الوريقة الريشيّة) ذو زوج واحد فقط من الوريقات) / مُزْدَوِج, مُقْتَرِن (مُتَّصل ببعضه خاصة في أزواج)",
 "conjugate solution": "محلول مقترن (أكثر ما يستخدم في حَلَّ بمعنى وصل إلى حَلّ في مشكلة ما أو مسألة رياضية أو سؤال ما وإن جاز استخدامه في غيره؛ ماء قد حُلَّ فيه شيء ما مثل الملح أو السكر أو غيره)\nمثال: اصبعي تحول الى بني بعد ان غمرته في محلول برمنغانات البوتاسيوم الكثيف جزئيا.",
 "conjugated": "مَقْرُون, مُتَرَافِق ((فِي الكِيمِيَاء العُضْوِيَّة) يَحْتَوِي عَلَى رَابِطَتَيْن مُزْدَوِجَتَيْن أَوْ أَكْثَر يَفْصِلُ بَيْنَهُمَا رَابِطَة أُحَادِيَّة) / مُتَّحِد, مُقْتَرِن (مُتَكَوِّن مِنِ اتِّحَاد مُرَكَّبَيْن) / مُزْدَوِج, مُقْتَرِن (مُتَّصل ببعضه خاصة في أزواج)",
 "conjugated protein": "بروتين مركب, بروتين مقترن (معقد بروتيني يجمع بين الأحماض الأمينية ومواد أخرى)",
 "conjugation": "تَصْرِيف, تَصْرِيف فِعْل / اِقْتِرَان, تَصْرِيف فِعْل",
 "conjunct": "متدرج, متصل ((في الموسيقى) يتقدم لحنياً بفترات مقدارها ثانية (درجة واحدة)) / تَعَاوُنِيّ, مُشْتَرَك (ينطوي على نشاط مشترك بين اثنين أو أكثر) / مُتَلَازِم, مُتَّصِل (مرتبط بشكل وثيق ومتصل)\nمثال: حركة متصلة لسلم تصاعدي",
 "conjunction": "حَرْف عَطْف (طَرَف وَجَانِب وَحَدّ؛ رَمْز مخطوط أو مطبوع يقوم مقام صوت أو كلمة أو عبارة أو معنى)\nمثال: ألف هو الحرف الأول للألف باء.",
 "conjunctiva": "ملتحمة (غشاء مخاطي شفاف مرطب يغطي مقلة العين والسطح السفلي للجفن)",
 "conjunctival": "ملتحمي (من أو متعلق بالملتحمة (غشاء العين))",
 "conjunctival layer of bulb": "ملتحمة بصلية (جزء الملتحمة الذي يغطي الوجه الأمامي للصلبة والظهارة السطحية للقرنية)",
 "conjunctival layer of eyelids": "ملتحمة جفنية (جزء الملتحمة الذي يبطن السطح الخلفي للجفون؛ يتصل بالملتحمة البصلية)",
 "conjunctival veins": "أوردة ملتحمية (أوردة تصرف الملتحمة)",
 "conjunctive": "اقتراني, رابط (يخدم أو يميل إلى الربط) / تَعَاوُنِيّ, مُشْتَرَك (ينطوي على نشاط مشترك بين اثنين أو أكثر) / أداة عطف, رابط (كلمة وظيفية غير متصرفة تعمل على ربط الكلمات أو العبارات أو الجمل)",
 "conjunctivitis": "التهاب الملتحمة, الرمد (التهاب ملتحمة العين)",
 "conjunctivitis arida": "جفاف العين, رمد جاف (جفاف غير طبيعي لملتحمة وقرنية العين؛ قد يكون بسبب نقص جهازي في فيتامين أ)",
 "conjuncture": "تزامن أحداث, ظرف حرج (مزيج حرج من الأحداث أو الظروف)",
 "conjuration": "ألعاب خفة, خدعة سحرية (عمل وهمي؛ يعتبره المراقبون السذج سحراً) / استحضار, تحضير الأرواح (عملية استدعاء روح أو شيطان) / استحضار, عزيمة (تلاوة طقسية لكلمات أو أصوات يُعتقد أن لها تأثيراً سحرياً)",
 "conjure man": "ساحر, مشعوذ (طبيب ساحر ذكر يمارس الشعوذة)",
 "conjure woman": "مشعوذة (طبيبة ساحرة أنثى تمارس الشعوذة)",
 "conjurer": "مشعوذ, مُحَضّر أرواح (طبيب ساحر يمارس استحضار الأرواح) / ساحر, لاعب خفة (شخص يقوم بألعاب سحرية لإمتاع الجمهور)",
 "conjuring": "استحضار, تحضير الأرواح (عملية استدعاء روح أو شيطان)",
 "conjuring trick": "ألعاب خفة, خدعة سحرية (عمل وهمي؛ يعتبره المراقبون السذج سحراً)",
 "conjuror": "مشعوذ, مُحَضّر أرواح (طبيب ساحر يمارس استحضار الأرواح) / ساحر, لاعب خفة (شخص يقوم بألعاب سحرية لإمتاع الجمهور)",
 "conjury": "استحضار, تحضير الأرواح (عملية استدعاء روح أو شيطان)",
 "conk": "أنف (مصطلح غير رسمي للأنف)",
 "conker": "كستناء الحصان (البذرة غير الصالحة للأكل التي تشبه الجوز لكستناء الحصان)",
 "conlanger": "مُصطنع",
 "conley": "كُونْلِي",
 "conman": "خَدَّاع",
 "conn's syndrome": "متلازمة كون (اضطرابات في توازن الماء والملح وأعراض ضعف وتشنجات عضلية ورعشة وتشنجات وأحياناً شلل؛ عادة ما تنتج عن ورم حميد في قشرة الغدة الكظرية يؤدي إلى إفراز…)",
 "connarus guianensis": "كوناروس غياني (شجرة من أمريكا الاستوائية وشرق إفريقيا ذات خشب صلب مميز العلامات يستخدم في صناعة الخزائن)",
 "connate": "مُتَقَارِبٌ فِي الطَّبِيعَةِ (مرتبط في الطبيعة والجوهر) / مُتصل, مُندمج (لأجزاء أو أعضاء متشابهة؛ مرتبطة أو متحدة ببعضها)\nمثال: زهرة طماطم مندمجة",
 "connatural": "فِطْرِيّ, وِلَادِيّ (مَوْجُودٌ بِشَكْلٍ طَبِيعِيٍّ مُنْذُ الوِلَادَةِ) / مُتَجَانِسُ الطَّبِيعَة (متشابه في الطبيعة الأصليّة)",
 "connect": "رَبَطَ (رَبَطَ الشيءَ يَرَبُطَ رَبْطًا: شَدَّهُ. فهو مربوط، ورَبيط؛ يقال: رَبَطَ نفسَه عن كذا: منعها)\nمثال: ربط يديه و قدميه.",
 "connected": "متصل, موصول (مربوط أو مرتبط معاً) / مُتَّصِل بِالحَاسُوب (مخزّن في حاسوب مركزيّ أو خاضع لسيطرته أو متّصل به مباشرةً) / مُتَّصِل, مُوَصَّل (موصول بمصدر للطاقة) / تَابِعٌ, مُلْحَقٌ (مُنْضَمّ في ارتباط وثيق)",
 "connectedness": "اتِّصَال, تَرَابُط (علاقة بين أشياء أو أحداث (كما في حالة تسبب أحدهما في الآخر أو مشاركته في ميزات)) / اتصال, ترابط (حالة الاتصال)\nمثال: كان هناك ترابط بين أكل ذلك المخلل ورؤية ذلك الكابوس",
 "connecter": "رابط, موصل (أداة تقوم بالربط أو التوصيل)\nمثال: قام بلحام الوصلة",
 "connecticut": "كُونِيتِيكَت",
 "connecticuter": "كونيتيكتي (مواطن أو مقيم في كونيتيكت)",
 "connecting flight": "رحلة ترانزيت, رحلة مواصلة (رحلة مع توقف وسيط وتغيير الطائرة (وربما تغيير شركة الطيران))",
 "connecting rod": "ذراع التوصيل (قضيب ينقل الحركة (خاصة الذي يربط عجلة دوارة بعمود ترددي))",
 "connecting room": "غرفة متصلة (غرفة فندق تشترك في جدار مع غرفة مجاورة وتتصل بباب خاص)",
 "connection": "صِلَة, صُلَة / عَلَاقَة, صِلَة",
 "connective": "رَابِط, وَاصِل (يَصِلُ أَوْ يَمِيلُ إِلَى الرَّبْطِ) / رابط, موصل (أداة تقوم بالربط أو التوصيل) / أداة عطف, رابط (كلمة وظيفية غير متصرفة تعمل على ربط الكلمات أو العبارات أو الجمل)\nمثال: قام بلحام الوصلة",
 "connective tissue": "نسيج ضام",
 "connectivity": "اتصال, ترابط (خاصية كون الشيء متصلاً أو الدرجة التي يمتلك بها الشيء اتصالات)",
 "connector": "رابط, موصل (أداة تقوم بالربط أو التوصيل)\nمثال: قام بلحام الوصلة",
 "connelly": "كُونِلِي",
 "connemara": "كُونِّيمَارَا",
 "connemara heath": "خلنج كونيمارا (شجيرة دائمة الخضرة منخفضة من غرب أوروبا ممثلة بعدة أصناف بزهور من الأبيض إلى الوردي الأرجواني)",
 "connexion": "اتصال, ضم (عملية جعل شيئين متلامسين (خاصة للتواصل)) / رحلة ربط, مواصلة (الانتقال من وسيلة نقل إلى أخرى) / رابط, موصل (أداة تقوم بالربط أو التوصيل) / اقتران, تداعي (عملية جمع الأفكار أو الأحداث معاً في الذاكرة أو الخيال)\nمثال: تشابك الأيدي حول الطاولة",
 "conning tower": "برج القيادة (جسر مرتفع على غواصة؛ غالباً ما يستخدم للدخول والخروج) / برج القيادة (غرفة قيادة مدرعة على سفينة حربية)",
 "conniption": "فورة, نوبة غضب (إظهار لسوء المزاج)\nمثال: أصيب بنوبة غضب",
 "connivance": "تواطؤ, غض الطرف ((قانون) موافقة ضمنية على مخالفات شخص ما) / تآمر, تواطؤ (الاتفاق على مؤامرة سرية)",
 "connive": "تَسَتَّرَ",
 "conniving": "داهِيَة, مُتَآمِر (حاذِق في التَّدْبير والتَّخْطيط بِمَكْر وحِيلَة) / تَوَاطُئِيّ, مُتَآمِر (يَعْمَلُ مَعَ آخَرِينَ سِرًّا لِغَايَةٍ احْتِيَالِيَّةٍ أَوْ غَيْرِ مَشْرُوعَة)",
 "connoisseur": "عَارِف, عَارِفَة",
 "connoisseurship": "خبرة فنية, ولع بالتحف (حب أو تذوق للأشياء الفنية الجميلة)",
 "connotation": "دَلَالَة (ما يستلزم العلم به العلم بشيء آخر)\nمثال: القدس مدينة ذات دلالة رمزية بالنسبة لكل من المسلمين و المسيحيين و اليهود.",
 "connotational": "تَضَمُّنِيّ, دَلَالِيّ (مُتَعَلِّقٌ بِالدَّلَالَةِ الضِّمْنِيَّةِ أَوِ الإِيحَائِيَّة)",
 "connotative": "إيحائي, تضمني (لديه القدرة على التلميح أو اقتراح شيء بالإضافة إلى ما هو صريح)",
 "connubial": "زوجي (متعلق بالزواج أو بالعلاقة بين الزوج والزوجة)\nمثال: هناء زوجي",
 "connubially": "زوجياً (بطريقة زوجية)",
 "conocarpus erectus": "شجرة الزر, مانغروف الزر (شجرة أو شجيرة دائمة الخضرة ذات ثمار تشبه الأزرار وتنتج خشباً ثقيلاً صلباً مضغوطاً)",
 "conoclinium coelestinum": "أجيراتوم, زهرة الضباب (نبات جذموري من وسط وجنوب شرق الولايات المتحدة وجزر الهند الغربية له رؤوس كبيرة مبهرجة من الزهور الزرقاء الصافية)",
 "conodont": "كونودونت (سمكة صغيرة (طولها 2 بوصة) منقرضة تشبه الثعبان بذيل ذي زعانف وحبل ظهري ولها أسنان مخروطية الشكل تحتوي على عظم خلوي؛ من أواخر العصر الكامبري إلى أواخر…) / سن مخروطي (السن المخروطي الصغير المتحجر لحيوان فقاري بدائي من رتبة مخروطيات الأسنان)",
 "conoid": "شكل مخروطي, مخروط (شكل قاعدته دائرة وتستدق جوانبه لتصل إلى نقطة)",
 "conopodium denudatum": "جوز الأرض, كونوبوديوم (نبات أوروبي شائع له درنات صالحة للأكل بنكهة الكستناء المحمصة)",
 "conoy": "كونوي (فرد من شعب ألغونكي عاش سابقاً في ماريلاند بين خليج تشيسابيك ونهر بوتوماك)",
 "conquer": "قَهَرَ, اِنْتَصَرَ (غَلَبَ وانْتَصَرَ ولم يقدر عليه أحد)",
 "conquerable": "قابل للقهر, يمكن التغلب عليه (خاضع لإمكانية قهره أو التغلب عليه) / قَابِل لِلتَّغَلُّب عَلَيْه (يمكن التغلب عليه أو تجاوزه)\nمثال: عرفت أن مخاوفها كانت في النهاية قابلة للتغلب عليها",
 "conquering": "إخضاع, غزو (فعل الغزو)",
 "conqueror": "غَازٍ",
 "conquest": "فَتْح, اِسْتِيلَاء (ضد أغْلَقَ وسَدَّ؛ تركه بلا شيء يسده؛ الطريق: جعلها سالكة للطارقين)\nمثال: فتح الباب آليا.",
 "conquistador": "غازٍ, كونكيستدور (مغامر (خاصة من قادوا الغزو الإسباني للمكسيك وبيرو في القرن السادس عشر))",
 "conradina glabra": "إكليل الجبل أبالاتشيكولا, كونرادينا جلابرا (شجيرة صغيرة في منطقة نهر أبالاتشيكولا في جنوب شرق الولايات المتحدة لها زهور وردية عطرية للغاية؛ نوع مهدد بالانقراض)",
 "consanguine": "ذُو رَحِمٍ, مِنْ نَفْسِ الدَّمِ (مرتبط بصلة الدم)",
 "consanguineal": "ذُو رَحِمٍ, مِنْ نَفْسِ الدَّمِ (مرتبط بصلة الدم)",
 "consanguineous": "ذُو رَحِمٍ, مِنْ نَفْسِ الدَّمِ (مرتبط بصلة الدم)",
 "consanguinity": "قَرَابَة عَصَب, قَرَابَة دَم",
 "conscience": "ضَمِير (بمعنى اسم الفاعل ضَامِر، يستخدم للمبالغة؛ العنب الذابل لأنه قد ضمر) / طَوِيَّة / وِجْدَان\nمثال: وكان الضحايا من الرجال والنساء والأطفال الأبرياء. ورغم ذلك اختارت القاعدة بلا ضمير قتل هؤلاء الأبرياء وتباهت بالهجوم وأكدت إلى الآن عزمها على ارتكاب القتل مجددا وبأعداد ضخمة",
 "conscience money": "مال الضمير (دفعة تُدفع طوعاً لتقليل الشعور بالذنب بسبب معاملات غير نزيهة)",
 "conscience-smitten": "مُعَذَّبُ الضَّمِير (يؤنّبه ضميره ويتأثر بشعور الذنب)",
 "conscienceless": "بِلَا وَازِع, عَدِيمُ الضَّمِير (يفتقر إلى الضمير والوازع الأخلاقيّ)",
 "conscientious": "مُجْتَهِد, وَرِع فِي عَمَلِه (يَتَّسِم بِعِنَايَة فَائِقَة وجُهْدٍ كَبِير) / حي الضمير, متفانٍ (يسترشد بالضمير أو بما يتوافق معه أو مع الشعور بالصواب والخطأ)\nمثال: قرار نابع من الضمير بالتحدث علناً عن الظلم",
 "conscientious objector": "مستنكف ضميرياً (من يرفض الخدمة في القوات المسلحة لأسباب تتعلق بالضمير)",
 "conscientiously": "بانتظام شديد, بدقة متناهية (بضمير حي شديد أو انتظام)\nمثال: كان يأتي بانتظام شديد كل صباح",
 "conscientiousness": "إتقان, ضمير حي (سمة كون المرء مجتهداً وحذراً) / تفان, يقظة الضمير (صفة التوافق مع إملاءات الضمير)",
 "conscionable": "مَقْبُول ضَمِيرِيًّا (مقبول لدى الضمير)",
 "conscious": "مدرك, واعٍ (عارف ومدرك؛ لديه وعي بما يحيط به وبالأحاسيس والأفكار) / مُتَعَمَّد, وَاعٍ (مُتصوَّر عن قصد ووعي)\nمثال: ظل واعياً أثناء العملية",
 "consciously": "بِوَعْي (مع الإدراك)\nمثال: تلاعبت بوعي بفكرة دعوتهم",
 "consciousness": "وَعْي (الفَهْم والتَدَبُّر واِحْتِوَاء كل معاني الشيء؛ في علم النفس: حالة وعي ويعني أيضا محتوى العقل، ويشمل المشاعر والوعي الذاتي وٱلصور وَالأفكار وَٱلقدرة على إدراك العلاقة بين المرء وٱلبيئة والشعور بما…) / شُعُور\nمثال: إنها فاقدة الوعي.",
 "consciousness-altering drug": "عقار مؤثر عقلياً, مادة ذات تأثير نفسي (عقار يمكن أن ينتج تغيرات في المزاج وتشوهات في الإدراك)",
 "conscript": "مُجَنَّد",
 "conscription": "تَجْنِيد إِجْبَارِيّ",
 "consecrate": "قَدَّسَ",
 "consecrated": "مقدس, مكرس (مخصص رسمياً أو مفصول لغرض سامٍ أو مقدس) / مُقَدَّس, مُكَرَّس (جُعِل أو أُعلِن أو اعتُقِد أنّه مقدّس؛ مكرّس لإله أو لطقس ديني)\nمثال: حياة مكرسة للعلم",
 "consecration": "تكريس (تقديس شيء ما عن طريق تخصيصه (عادة بطقوس دينية) لله) / تَكْرِيس (التزام رسمي بحياتك أو وقتك لغرض عزيز (لخدمة أو هدف))\nمثال: حضر الكاردينال تكريس الكنيسة",
 "consecutive": "مُتَتَالٍ, مُتَعَاقِب (واحد تلو الآخر دون انقطاع) / بِالتَّتَابُع, بِالتَّسَلْسُل (بطريقة تسلسلية) / مُتَتَالٍ, مُتَعَاقِب (مُتَتَابِعٌ دُونَ انْقِطَاع) / مُتَتَالٍ, مُتَسَلْسِل (في تتابع منتظم دون فجوات)\nمثال: رقمنا الأوراق بالتتابع",
 "consecutive operation": "عملية تتابعية, عملية تسلسلية (التنفيذ المتتابع للعمليات واحدة تلو الأخرى)",
 "consecutively": "بالتتابع, على التوالي (بطريقة متتالية)\nمثال: كان مريضاً، ثم بصحة جيدة، ثم مريضاً مرة أخرى على التوالي",
 "consensual": "توافقي",
 "consensus": "إِجْمَاع, تَوَافُق",
 "consent": "رَضِيَ, وَافَقَ (قَبِلَ؛ سلَّم واقتنع) / رِضًا (مصدر الفعل \"رَضِيَ\")\nمثال: السكوت علامة الرضا.",
 "consent decree": "حكم بالتراضي, مرسوم رضائي (اتفاق بين طرفين تقره المحكمة؛ على سبيل المثال، قد توافق شركة على وقف ممارسات معينة دون الاعتراف بالذنب)",
 "consentaneous": "إِجْمَاعِيّ, بِالإِجْمَاعِ (فِي اتِّفَاقٍ تَامٍّ وَكَامِلٍ)",
 "consentient": "إِجْمَاعِيّ, بِالإِجْمَاعِ (فِي اتِّفَاقٍ تَامٍّ وَكَامِلٍ)",
 "consenting": "رَاضٍ, مُوَافِق (قد أعطى موافقته وقَبِل)",
 "consequence": "عَاقِبَة / نَتِيجَة",
 "consequent": "مُتَرَتِّب, مُصَاحِب (يحدث بالتزامن مع شيء آخر أو نتيجةً له)",
 "consequential": "ذُو عَوَاقِب, مَصِيرِيّ (له قضايا أو نتائج مهمّة)",
 "consequentially": "بِالنَّتِيجَة, تَبَعًا لِذَلِك (بنتيجة أن)",
 "consequently": "بِٱلتَّالِي, وَعَلَيْهِ فَإِنَّ",
 "conservancy": "هيئة الحفاظ على البيئة (الحفظ الرسمي للأشجار والتربة والأنهار وغيرها) / لجنة الحفاظ على البيئة, هيئة الصيانة (لجنة لها ولاية قضائية على المصايد والملاحة في ميناء أو نهر)",
 "conservation": "حفاظ على البيئة, صيانة الموارد (الحفاظ على البيئة والموارد الطبيعية وإدارتها بعناية) / بقاء, حفظ ((فيزياء) بقاء كميات معينة دون تغيير أثناء التفاعلات الكيميائية أو التحولات الفيزيائية) / حفظ, صيانة (حدوث تحسن بفضل منع الخسارة أو الإصابة أو أي تغيير آخر)",
 "conservation of charge": "حفظ الشحنة, حفظ الكهرباء (المبدأ القائل بأن إجمالي الشحنة الكهربائية لنظام ما يظل ثابتًا على الرغم من التغييرات داخل النظام)",
 "conservation of electricity": "حفظ الشحنة, حفظ الكهرباء (المبدأ القائل بأن إجمالي الشحنة الكهربائية لنظام ما يظل ثابتًا على الرغم من التغييرات داخل النظام)",
 "conservation of energy": "حِفْظ الطَّاقَة (الحِفْظُ نَقِيضُ النِّسْيَان، وهو التَّعَاهُدُ وقِلَّةُ الغَفْلَةِ؛ قِلَّةُ الغَفْلَةِ)\nمثال: حفظ رقم هاتفها.",
 "conservation of mass": "حفظ الكتلة, قانون حفظ المادة (مبدأ أساسي في الفيزياء الكلاسيكية ينص على أن المادة لا تفنى ولا تستحدث في نظام معزول)",
 "conservation of matter": "حفظ الكتلة, قانون حفظ المادة (مبدأ أساسي في الفيزياء الكلاسيكية ينص على أن المادة لا تفنى ولا تستحدث في نظام معزول)",
 "conservation of momentum": "حفظ الزخم (المبدأ القائل بأن إجمالي الزخم الخطي في نظام مغلق ثابت ولا يتأثر بالعمليات التي تحدث داخل النظام)",
 "conservation of parity": "تكافؤ, حفظ التكافؤ ((فيزياء) التكافؤ محفوظ في كون تكون فيه قوانين الفيزياء هي نفسها في نظام إحداثيات يمني كما في نظام يساري)",
 "conservationist": "بِيئِيّ, مُدافِع عَن البِيئَة (شخص يعمل لحماية البيئة من الدمار أو التلوث)",
 "conservatism": "سِيَاسَة مُحَافِظَة, فِكْر مُحَافِظ (بمعنى رعى الغنم وقادها؛ بمعنى قاد الناس وحَكَمَهم باللين والحكمة لا بالغصب والقهر)\nمثال: عاد إلى السياسة.",
 "conservative": "مُحَافِظ",
 "conservative jew": "يهودي محافظ (يهودي يحافظ على بعض متطلبات الشريعة الموسوية ولكنه يكيف غيرها لتناسب الظروف الحديثة)",
 "conservative judaism": "يهودية محافظة (معتقدات وممارسات اليهود المحافظين) / اليهودية المحافظة (اليهود الذين يحافظون على بعض متطلبات الشريعة الموسوية لكنهم يسمحون بتكييف متطلبات أخرى (مثل بعض قوانين الطعام) لتلائم الظروف الحديثة)",
 "conservative party": "حزب المحافظين (حزب سياسي (خاصة في بريطانيا العظمى أو أستراليا) يؤمن بأهمية الاقتصاد الرأسمالي مع الملكية الخاصة بدلاً من سيطرة الدولة)",
 "conservatively": "بِتَحَفُّظ, بِشَكْل مُحَافِظ (بطريقة متحفظة)\nمثال: قدرنا عدد المتظاهرين بتحفظ عند 200,000",
 "conservativism": "محافظة (توجه سياسي أو ديني يدعو إلى الحفاظ على أفضل ما في المجتمع ومعارضة التغييرات الجذرية)",
 "conservativist": "محافظ (شخص يتردد في قبول التغييرات والأفكار الجديدة)",
 "conservatoire": "كونسرفتوار, معهد موسيقي (مدرسة ذات مرافق خاصة للفنون الجميلة)",
 "conservator": "قَيِّم, وصي (شخص تعينه المحكمة لتولي مسؤولية مصالح قاصر أو شخص فاقد للأهلية) / أَمِين المَتْحَف, أَمِين المَكْتَبَة (الوصي على مجموعة مقتنيات (كما في متحف أو مكتبة))",
 "conservator-ward relation": "عَلَاقَة الوَصِيّ بِالمَحْجُور عَلَيْهِ (مسؤولية الوصي في التصرف بما يخدم مصلحة الموصى عليه)",
 "conservatory": "حديقة داخلية, مشتل زجاجي (دفيئة يتم فيها ترتيب النباتات بطريقة مبهجة) / كونسرفتوار, معهد موسيقي (مدرسة ذات مرافق خاصة للفنون الجميلة) / كونسرفتوار, معهد موسيقي (هيئة التدريس والطلاب في مدرسة متخصصة في أحد الفنون الجميلة)",
 "conserve": "كونسروة, محفوظات (فاكهة محفوظة عن طريق الطبخ مع السكر)",
 "conserved": "مَصُون, مُحَافَظٌ عَلَيْه (مَحْمِيٌّ مِنَ الأَذَى أَوِ الفَقْد)",
 "conserves": "كونسروة, محفوظات (فاكهة محفوظة عن طريق الطبخ مع السكر)",
 "consider": "اِعْتَبَرَ, تَدَبَّرَ (الشيءَ: اختبره وامتحنه ونظر فيه؛ الشيءَ شيءًا: عَدُّه كذلك وتصرف على ذلك الأساس. بمفعولين) / عَدَّ\nمثال: اعتبر نفسك محظوظا",
 "considerable": "كبير, معتبر (كبير أو كبير نسبياً في العدد أو الكمية أو المدى أو الدرجة)\nمثال: كمية معتبرة",
 "considerably": "إلى حد كبير, بشكل جوهري (إلى مدى أو درجة كبيرة)\nمثال: أخشى أن الفيلم تجاوز الميزانية بكثير",
 "considerate": "مراعٍ, مهتم بالآخرين (يظهر اهتماماً بحقوق ومشاعر الآخرين)\nمثال: أصدقاء مراعون بما يكفي ليتركونا وحدنا",
 "considerately": "بكياسة, بمراعاة (بطريقة مراعية للآخرين)\nمثال: انسحبوا بكياسة",
 "considerateness": "اهتمام بالآخرين, مراعاة (احترام ومراعاة لطيفة للآخرين)\nمثال: لم يظهر أي مراعاة لمشاعرها",
 "consideration": "اهتمام, مراعاة (عمل ينم عن مراعاة وتفكير بالآخرين) / اهتمام بالآخرين, مراعاة (احترام ومراعاة لطيفة للآخرين) / اعتبار, نظر (عملية التفكير المتأني في شيء ما) / اعتبار, حالة (معلومات يجب وضعها في الاعتبار عند اتخاذ قرار)\nمثال: لم يظهر أي مراعاة لمشاعرها",
 "considered": "مَدْرُوس بِعِنَايَة (مُوَزَّن ومُتأمَّل فيه بعناية)",
 "consignee": "المرسل إليه (الشخص الذي تسلم إليه البضائع)",
 "consigner": "المرسل, مرسل البضاعة (الشخص الذي يسلم أو يرسل البضائع)",
 "consignment": "إرسالية, شحنة (تسليم البضائع للبيع أو التصرف فيها) / إيداع (الفعل الرسمي لإرسال شخص للحبس (كما في سجن أو مستشفى للأمراض العقلية)) / بضاعة منقولة, حمولة (بضائع تحملها مركبة كبيرة)",
 "consignor": "المرسل, مرسل البضاعة (الشخص الذي يسلم أو يرسل البضائع)",
 "consist": "تَكَوَّنَ / تَأَلَّفَ (فعل مطاوعة من ألَّفَ؛ من كذا: تكّون من هذه الأجزاء، يستخدم للأجزاء الغير منفصلة والتي يكون مجموعها هو الشيء المتألف)",
 "consistence": "اتِّسَاق, تَنَاسُق (انتظام متناغم أو توافق بين الأشياء أو الأجزاء) / تماسك, قوام (خاصية التماسك والحفاظ على الشكل)\nمثال: الصوف له قوام أكثر من الرايون",
 "consistency": "اِتِّسَاق",
 "consistent": "مُتَّسِق",
 "consistently": "بشكل منتظم, بشكل منهجي (بطريقة منهجية أو متسقة)\nمثال: استبعدوا النساء بشكل منهجي",
 "consistory": "كونسيستوار, مجلس كنسي (محكمة كنسية أو هيئة حاكمة)",
 "consociationalism": "تَوَافُقِيَّة",
 "consolable": "قابل للمواساة (يمكن تعزيته أو مواساته)",
 "consolation": "مُوَاسَاة",
 "consolatory": "مُعَزٍّ, مُوَاسٍ (يمنح الراحة والعزاء والسلوان)",
 "console": "وَاسَى, عَزَّى",
 "console table": "طاولة حائطية, كونسول (طاولة صغيرة تثبت على الحائط أو تصمم لتقف بمحاذاة الحائط)",
 "consolida ambigua": "عايق الحقل, عايق الصواريخ (عايق يزرع عادة في جنوب أوروبا له عناقيد غير متفرعة تشبه السنابل من الزهور الزرقاء أو الأرجوانية أو الوردية أحياناً؛ يوضع أحياناً في جنس دلفينيوم)",
 "consolidated": "مُتَصَلِّب, مُتَمَاسِك (يُشكّل كتلة صلبة متماسكة) / مُنْدَمِج, مُوَحَّد (اندمج في كلّ واحد متكامل)",
 "consolidation": "تكامل, توحيد (عملية الدمج في كلٍ متكامل) / تصلب, تماسك (التجمع في كتلة صلبة) / كُتْلَة مُتَصَلِّبَة (شيء تصلب ليصبح كتلة مدمجة)\nمثال: دمج شركتين",
 "consolidative": "تَكَامُلِيّ, تَوْحِيدِيّ (يميل إلى الدمج والتوحيد) / تَوْحِيدِيّ, دَمْجِيّ (يجمع في وحدة واحدة)",
 "consoling": "مُعَزٍّ, مُوَاسٍ (يمنح الراحة والعزاء والسلوان)",
 "consolingly": "بِشَكْل مُطَمْئِن, بِمُوَاسَاة (بطريقة مريحة أو مواسية)\nمثال: جزء واحد من عالم غريب يجب أن يعطى شكلاً مألوفاً ومريحاً",
 "consomme": "كونسوميه, مرق صافي (حساء صافي عادة من لحم البقر أو العجل أو الدجاج)",
 "consonance": "تآلف, توافق (خاصية التناغم الصوتي) / توافق ساكن, قافية الحروف الساكنة (تكرار الحروف الساكنة (أو أنماط الحروف الساكنة) خاصة في نهايات الكلمات)",
 "consonant": "صَامِت / حَرْف (طَرَف وَجَانِب وَحَدّ؛ رَمْز مخطوط أو مطبوع يقوم مقام صوت أو كلمة أو عبارة أو معنى)\nمثال: ألف هو الحرف الأول للألف باء.",
 "consonant cluster": "اِجْتِمَاع السَّاكِنِين, التَّقَاء السَّاكِنِين (جمعوا انفسهم؛ اسم يطلق على عملية جَمْع بعض الناس في مكان واحد ليتباحثوا أمرا)\nمثال: هذا اجتماع مهم.",
 "consonant mutation": "تغير الحروف الساكنة, طفرة ساكنة (تغير في حرف ساكن في كلمة وفقاً لبيئتها الصرفية أو النحوية)\nمثال: الويلزية لغة ذات نظام غني ومنتج من طفرة الحروف الساكنة الأولية",
 "consonant rhyme": "توافق ساكن, قافية الحروف الساكنة (تكرار الحروف الساكنة (أو أنماط الحروف الساكنة) خاصة في نهايات الكلمات)",
 "consonant system": "نظام الصوامت (نظام الحروف الساكنة المستخدم في لغة معينة)",
 "consonantal": "ساكن, صامت (كونه أو يتميز بـ أو يحتوي على أو يعمل كحرف ساكن) / سكوني, صامت (يتعلق بـ أو له طبيعة الحرف الصامت (الساكن))\nمثال: أصوات ساكنة",
 "consonantal system": "نظام الصوامت (نظام الحروف الساكنة المستخدم في لغة معينة)",
 "consort": "عشيق",
 "consortium": "اِتِّحَاد مَالِيّ, اِئْتِلَاف شَرِكَات (اِتِّحَاد؛ الاتِّحاد الأوربيّ : (السياسة) اتِّحاد أوربيّ إقليميّ أنشئ بمقتضى معاهدة ماستريخت في عام 1993 م…)\nمثال: عاش الاتحاد السوفيتي!",
 "conspecific": "موافق للنوع (كائن ينتمي إلى نفس نوع كائن آخر) / متحد النوع (ينتمي إلى نفس النوع)\nمثال: الكرنب المزروع والكرنب البري متحدان في النوع",
 "conspectus": "كشف عام, ملخص عام (ملخص عام وشامل)",
 "conspicuous": "بارز, جلي (واضح للعين أو العقل) / صَارِخ, فَاضِح (واضح تمامًا دون أيّ محاولة للإخفاء)\nمثال: برج بارز من مسافة بعيدة",
 "conspicuous consumption": "استهلاك تفاخري (شراء خدمات ومنتجات باهظة الثمن من أجل التباهي بالثروة)",
 "conspicuously": "بشكل بارز, بوضوح (بطريقة بارزة) / بشكل لافت, بوضوح تام (بطريقة تميل إلى جذب الانتباه)\nمثال: عُرضت السيارة الجديدة بشكل بارز في الممر",
 "conspicuousness": "بروز, وضوح (وضوح عالٍ) / لفت للأنظار, وضوح (حالة كونه لافتاً للنظر)",
 "conspiracy": "دَسِيسَة / مُؤَامِرَة, مُوَاطَأَة",
 "conspiracy of silence": "مؤامرة الصمت (مؤامرة لعدم التحدث عن وضع أو حدث ما)\nمثال: كانت هناك مؤامرة صمت حول وحشية الشرطة",
 "conspiracy theory": "نَظَرِيَّة مُؤَامَرَة (مؤنث نَظَرْيّ، أي يفحض بالنظر لا بالإختبار؛ قضية غير مثبتة ولا مبرهنة لتفسير أمر ما)\nمثال: إنها مجرد نظرية.",
 "conspirative": "تآمري (متعلق بالمؤامرة أو المتآمرين أو مميز لهم)\nمثال: همس تآمري",
 "conspirator": "متآمر (عضو في مؤامرة)",
 "conspiratorial": "تَآمُرِيّ",
 "conspire": "تَآمَرَ, اِئْتَمَرَ",
 "constable": "شُرْطِيّ, كُونْسَتابِل (رجل قانون يتمتع بسلطة واختصاص أقل من المأمور (الشريف)) / شُرْطِيّ, كُونْسَتابِل (ضابط شرطة من أدنى رتبة)",
 "constabulary": "شرطة, قوة الشرطة (قوة من رجال الشرطة والضباط)\nمثال: جاءت الشرطة تبحث عنه",
 "constance": "مجمع كونستانس (المجمع المنعقد في 1414-1418 الذي نجح في إنهاء الانشقاق العظيم في الكنيسة الرومانية الكاثوليكية)",
 "constancy": "اسْتِقْرَار, ثَبَات (صفة الديمومة والخلو من التغيير أو التباين) / ثَبَات عَلَى العَهْد, وَفَاء (الإخلاص والاعتمادية في العلاقات الشخصية (خاصة الإخلاص الزوجي)) / ثبات إدراكي ((علم النفس) الميل لإدراك الأشياء بطريقة متشابهة جداً على الرغم من التباينات الواسعة في ظروف الملاحظة)\nمثال: اعتمد البحارة الأوائل على ثبات الرياح التجارية",
 "constant": "ثَابِت (اسم فاعل من ثَبَتَ؛ المُسْتَقِرّ الذي لا يتحرك، ضد المُتَحَرِّك)\nمثال: الشاحنة غير ثابتة.",
 "constant acceleration": "تَسَارُع ثَابِت, تَسَارُع مُنْتَظِم (نوع من الحركة تتغير فيه سرعة الجسم بمقدار متساوٍ في كل فترة زمنية متساوية)",
 "constant of gravitation": "ثَابِت الْجَاذِبِيَّة, ثَابِت الْجَذْب الْعَامّ ((في الفيزياء) الثابت العام الذي يربط القوة بالكتلة والمسافة في قانون نيوتن للجاذبية)",
 "constant of proportionality": "ثَابِت التَّنَاسُب, عَامِل التَّنَاسُب (القيمة الثابتة لنسبة كميتين متناسبتين س وص؛ تكتب عادة ص = ك*س، حيث ك هو عامل التناسب)",
 "constant quantity": "ثابت, كمية ثابتة (كمية لا تتغير)",
 "constant-volume process": "عملية آيزوخوريك, عملية ثابتة الحجم (عملية ديناميكية حرارية يظل خلالها حجم النظام المغلق الذي يخضع لهذه العملية ثابتاً)",
 "constant-width font": "خط الآلة الكاتبة, خط ثابت العرض (نمط خط يتم فيه إعطاء كل حرف نفس العرض (كما في الآلة الكاتبة))",
 "constantan": "كونستانتان (سبيكة من النحاس والنيكل ذات مقاومة كهربائية عالية ومعامل درجة حرارة منخفض؛ تستخدم كسلك مقاومة)",
 "constantine": "قُسْطَنْطِين / قُسَنْطِينَة",
 "constantinople": "الْقُسْطَنْطِينِيَّة (الاسم السابق لمدينة إسطنبول ما بين عامي ٣٣٠ و١٩٣٠ للميلاد، وكان اسمها قبل ذلك بيزنطة)",
 "constantinopolitan": "قُسْطَنْطِينِيّ",
 "constantly": "باستمرار, بشكل متواصل (بشكل ثابت لا يتغير) / باستمرار, دائماً (بدون تنوع أو تغيير، في كل حالة)\nمثال: العالم يتغير باستمرار",
 "constanța": "كونستانتسا / قنسطنطة",
 "constatation": "افتراض أساسي, بديهية (افتراض أساسي لحجة ما)",
 "constellation": "كَوْكَبَة",
 "consternation": "ذعر, فزع (خوف ناتج عن الوعي بالخطر)",
 "constipated": "مصاب بالإمساك, ممسك (يعاني من صعوبة أو عدم اكتمال أو ندرة في تفريغ الأمعاء)",
 "constipation": "إِمْسَاك",
 "constituency": "دائرة انتخابية, ناخبون (هيئة الناخبين الذين ينتخبون ممثلاً لمنطقتهم)",
 "constituent": "مُكَوِّن",
 "constituted": "راسخ, قائم (تم إحداثه أو إنشاؤه أو قبوله؛ خاصة الراسخ منذ فترة طويلة)\nمثال: النظام الاجتماعي القائم",
 "constitution": "تَكْوِين / دُسْتُور, نِظَام (قَاعِدَة) / دُسْتُور (قَاعِدَة)\nمثال: العدالة مضمونة في الدستور.",
 "constitutional": "بُنْيَوِيّ / دُسْتُورِيّ",
 "constitutional convention": "المُؤْتَمَر الدُسْتُورِيّ (مؤتمر رجال الدولة الأمريكيين الذين صاغوا دستور الولايات المتحدة في عام 1787)",
 "constitutional economics": "اقتصاد دستوري (فرع من فروع الاقتصاد يركز على الظروف الموجودة والخيارات المقيدة بالإطار القانوني لدستور سياسي)",
 "constitutional monarchy": "مَلَكِيَّة دُسْتُورِيَّة",
 "constitutional psychology": "علم النفس البنيوي ((علم النفس) مدرسة فكرية تفترض أن شخصية الفرد تعتمد على نوع بنيته الجسدية)",
 "constitutional right": "حَقّ دُسْتُورِيّ (اسم من الأسماء الحسنى وهو من صفات الله. لا جمع له؛ ضد البَاطِل، العَدْل والحَقِيْقَة والوُجُوْد الثَابِت والصِدْق والذي لا جدال فيه. لا جمع له)\nمثال: الأستاذ على حق.",
 "constitutional union party": "حزب الاتحاد الدستوري (حزب سياسي سابق في الولايات المتحدة؛ تشكل عام 1859 من قبل اليمينيين السابقين الذين كانوا يأملون في الحفاظ على الاتحاد)",
 "constitutionalism": "دستورية (الدعوة لنظام حكم وفقاً لمبادئ دستورية) / دستورية (نظام حكم دستوري (عادة بوجود دستور مكتوب))",
 "constitutionalist": "دستوري (مدافع عن الحكومة الدستورية)",
 "constitutionality": "دُسْتُورِيَّة",
 "constitutionally": "دستورياً (وفقاً للدستور)\nمثال: تم استبعاد هذا دستورياً",
 "constrained": "قَسْرِيّ, مُتَكَلَّف (يفتقر إلى العفوية؛ غير طبيعي)",
 "constrainedly": "بتكلف, بقيد (بطريقة مقيدة)",
 "constraining": "حَاصِر, مُقَيِّد (يُقيِّد نطاق العمل أو حرية الحركة)",
 "constraint": "متطلب",
 "constricted": "متضيق, منقبض (مشدود معاً أو مضغوط جسدياً أو بالتبعية نفسياً) / مُضَيَّق (مَشْدُودٌ بِشَكْلٍ خَاصٍّ؛ لَا سِيَّمَا فِي بَعْضِ اللَّهَجَات)\nمثال: وعاء دموي منقبض",
 "constricting": "تَضْيِيقِيّ, مُقَيِّد ((عن الظروف) يميل إلى تضييق الحرّيّة)",
 "constriction": "انقباض, تضيق (فعل أو عملية الضغط) / انقباض, ضيق (شعور بالضيق في جزء من الجسم) / تضيق, تضييق (ضغط ضيق أو محكم) / تضييق, عنق زجاجة (تضييق يقلل التدفق عبر قناة)\nمثال: شعر بانقباض في صدرها",
 "constrictive": "حَاصِر, مُقَيِّد (يُقيِّد نطاق العمل أو حرية الحركة) / تَضْيِيقِيّ, مُقَيِّد ((عن الظروف) يميل إلى تضييق الحرّيّة)",
 "constrictor": "ثعبان عاصر (أي من الثعابين الكبيرة غير السامة المتنوعة التي تقتل فريستها عن طريق سحقها في لفائفها)",
 "constrictor constrictor": "أصلة عاصرة, بوا عاصرة (أصلة كبيرة جداً من أمريكا الاستوائية وجزر الهند الغربية)",
 "construal": "تأويل, فهم (تفسير لمعنى شيء ما؛ فعل التأويل)",
 "construct": "تصوّر, فكرة (فكرة مجردة أو عامة مستنتجة أو مشتقة من حالات محددة)",
 "construct state": "إِضَافَة",
 "constructed language": "لُغَة مُصْطَنَعَة (هِيَ مجموعة من الأصوات التي يصدرها الإنسان على شكل كلمات منظمة بقواعد، ليتواصل به الناس وينقلون به الافكار والمعاني، اللسان؛ يقصد بها أحيانا اللهجة)\nمثال: الأمازيغية لغة.",
 "constructed script": "خط مُختلق, نظام كتابة مصطنع (نظام كتابة جديد تم إنشاؤه خصيصاً من قبل فرد أو مجموعة، بدلاً من تطوره كجزء من لغة أو ثقافة مثل الخط الطبيعي)\nمثال: بالين-سيليل هو خط مصطنع اخترعه آيوش شاتورفيدي في نوفمبر 2014 لكتابة لغته المصطنعة التي تحمل الاسم نفسه",
 "construction": "بِنَاء, تَشْيِيد (ضد هَدْم. ؛ المَبْنَى أو البِنَاية)\nمثال: أنا وجدت البناء.",
