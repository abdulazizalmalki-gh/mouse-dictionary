 "commission on narcotic drugs": "لجنة المخدرات (لجنة المجلس الاقتصادي والاجتماعي للأمم المتحدة المعنية بتجارة المخدرات)",
 "commission on the status of women": "لجنة وضع المرأة (لجنة المجلس الاقتصادي والاجتماعي للأمم المتحدة المعنية بوضع المرأة في المجتمعات المختلفة)",
 "commission plan": "خطة اللجنة, نظام المفوضية (حكومة بلدية تجمع بين السلطتين التشريعية والتنفيذية في أعضاء لجنة)",
 "commissionaire": "بَوَّاب بِزِيّ رَسْمِيّ (بواب يرتدي زياً رسمياً (عادة في الفنادق أو المسارح))",
 "commissioned": "مُرَخَّص, مُعْتَمَد (حاصل على موافقة رسمية للعمل) / ضابط (ذو رتبة), مفوض ((عن الضباط العسكريين) حائز بموجب تفويض على رتبة ملازم ثان أو ما يعادلها أو أعلى)",
 "commissioned military officer": "ضابط عسكري مفوض (ضابط مفوض في الجيش أو القوات الجوية أو مشاة البحرية)",
 "commissioned naval officer": "ضابط بحري مفوض (ضابط مفوض في البحرية)",
 "commissioned officer": "ضابط مفوض, ضابط نظامي (ضابط عسكري يحمل تكليفاً رسمياً (مرسوماً))",
 "commissioner": "مُفَوَّض, مُفَوَّضَة",
 "commissioning": "تفويض, تكليف (فعل منح السلطة للقيام بوظائف معينة)",
 "commissure": "صوار (حزمة من الألياف العصبية تمر من جانب إلى آخر من الدماغ أو الحبل الشوكي)",
 "commit": "اِرْتَكَبَ",
 "commit adultery": "زَنَى (مَارَسَ الزِّنَى)",
 "commit suicide": "اِنْتَحَرَ",
 "commitment": "التزام",
 "committal": "ارتكاب, اقتراف (فعل ارتكاب جريمة) / إيداع (الفعل الرسمي لإرسال شخص للحبس (كما في سجن أو مستشفى للأمراض العقلية))",
 "committal service": "مراسم الدفن (خدمة إيداع الجثمان في القبر)\nمثال: ستقام مراسم الدفن يوم الاثنين القادم",
 "committal to memory": "استظهار, حفظ (التعلم بغرض التذكر الحرفي)\nمثال: حفظ الممثل لسطوره",
 "committal to writing": "تدوين, كتابة (نشاط وضع شيء ما في شكل مكتوب)\nمثال: هي قامت بالتفكير بينما قام هو بالكتابة",
 "committed": "مُرْتَبِط, مُلْتَزِم (مرتبط في علاقة جنسية حصرية) / ملتزم (مقيد أو ملزم، كما هو الحال بموجب تعهد لقضية أو عمل أو موقف معين)\nمثال: أعضاء كنيسة ملتزمون",
 "committedness": "التزام, تعهد (سمة الثبات الصادق والراسخ على الهدف)\nمثال: رجل ذو طاقة والتزام",
 "committee": "لَجْنَة",
 "committee for state security": "كي جي بي, لجنة أمن الدولة (منظمة الشرطة الأمنية السائدة سابقًا في روسيا السوفيتية)",
 "committee meeting": "اِجْتِمَاع لَجْنَة, اِجْتِمَاع مَجْلِس الإِدَارَة (اجتماع لأغراض إدارية)",
 "committee member": "عُضْو لَجْنَة (عضو في لجنة)",
 "committeeman": "عضو لجنة (رجل عضو في لجنة)",
 "committeewoman": "عضوة لجنة (امرأة عضوة في لجنة)",
 "commixture": "خلط, خليط (عملية خلط الأشياء معاً)\nمثال: عجينة مصنوعة من خليط الدقيق والماء",
 "commode": "خزانة أدراج طويلة, شوفنيرة (خزانة أدراج طويلة وأنيقة) / مرحاض (تجهيزات صحية للتغوط والتبول)",
 "commodious": "رَحْب, فَسِيح (كبير وواسع)\nمثال: مرفأ فسيح",
 "commodiousness": "اتساع, رحابة (الكبر والامتداد المكاني (خاصة داخل المبنى))\nمثال: أذهلت سعة حقيبة سانتا الطفل",
 "commodities exchange": "بورصة السلع (بورصة لبيع وشراء السلع للتسليم المستقبلي)",
 "commodities market": "بورصة السلع (بورصة لبيع وشراء السلع للتسليم المستقبلي)",
 "commodity": "بِضَاعَة, بَضَائِع",
 "commodity brokerage": "وساطة سلع (شركة وساطة تتعامل في السلع)",
 "commodity exchange": "بورصة السلع (بورصة لبيع وشراء السلع للتسليم المستقبلي)",
 "commodity fetishism": "تَقْدِيس السِّلْعَة",
 "commodore": "عميد بحري, كومودور (ضابط بحري مفوض رتبته أعلى من قبطان وأقل من لواء بحري؛ أدنى درجة من درجات الأدميرال)",
 "common": "شَائِع",
 "common ageratum": "أجيراتوم شائع, نبات المعز (عشبة صغيرة رقيقة تزرع لزهورها الزرقاء إلى الخزامية الرقيقة التي تشبه الفرشاة)",
 "common alder": "نغت أسود أوروبي, نغت دابق (شجرة متوسطة الحجم بلحاء بني أسود وعناقيد ثمرية خشبية؛ الأوراق مشعرة من الأسفل)",
 "common allamanda": "ألمندا شائعة, بوق ذهبي (نبات متسلق دائم الخضرة قوي من أمريكا الجنوبية ذو أوراق جلدية لامعة وأزهار صفراء ذهبية)",
 "common american shad": "شابل أمريكي (شابل من ساحل المحيط الأطلسي لأمريكا الشمالية؛ تم توطينه في ساحل المحيط الهادئ)",
 "common amsinckia": "أمسينكيا شائعة (نبات حولي في غرب الولايات المتحدة بسنابل ملفوفة من الزهور الصفراء البرتقالية)",
 "common apricot": "مشمش شائع (شجرة منطقة معتدلة تحمل ثماراً زغبية صفراء إلى وردية)",
 "common arrowhead": "سهمية شائعة, سهمية عريضة الأوراق",
 "common ax": "فأس عادية (فأس بمقبض طويل ورأس له حافة قاطعة واحدة وجانب غير حاد)",
 "common axe": "فأس عادية (فأس بمقبض طويل ورأس له حافة قاطعة واحدة وجانب غير حاد)",
 "common bamboo": "خيزران شائع (خيزران قوي للغاية له سيقان رقيقة الجدران مخططة بالأخضر والأصفر؛ يُزرع على نطاق واسع لدرجة أن موطنه الأصلي غير مؤكد)",
 "common barberry": "باربيريس شائع, زرشك (شجيرة أوروبية نفضية منتصبة تم توطينها على نطاق واسع في الولايات المتحدة لها عناقيد من التوت العصاري)",
 "common barley": "شعير شائع (عشب ينتج حبوباً تستخدم في طعام الإفطار وعلف الحيوانات وفي مشروبات الشعير)",
 "common basil": "حبق, ريحان (نبات حولي أو معمر من آسيا الاستوائية له سنابل من الزهور البيضاء الصغيرة وأوراق عطرية؛ أحد أهم أعشاب الطهي؛ يستخدم في السلطات والأطعمة والصلصات وبعض…)",
 "common bean": "فاصولياء شائعة (أي من أنواع الفاصولياء العديدة التي تؤكل طازجة أو مجففة) / فاصولياء شائعة (نبات الفاصولياء الحولي المتسلق أو الشجيري الشائع الذي يزرع لبذوره أو قرونه الصالحة للأكل)",
 "common bean plant": "فاصولياء شائعة (نبات الفاصولياء الحولي المتسلق أو الشجيري الشائع الذي يزرع لبذوره أو قرونه الصالحة للأكل)",
 "common bear's breech": "أَقَنْثَا نَاعِمَة",
 "common bearberry": "عنب الدب, قطلب عنب الدب (شجيرة دائمة الخضرة تشكل حصيرة من أمريكا الشمالية وشمال أوراسيا لها زهور بيضاء صغيرة وتوت أحمر؛ تتحول الأوراق إلى الأحمر في الخريف)",
 "common beech": "زان أوروبي, زان شائع (زان أوروبي كبير بأوراق مسننة بدقة؛ يُزرع على نطاق واسع للزينة في أمريكا الشمالية)",
 "common beet": "بنجر, سلق (نبات أوراسي ثنائي الحول له عادة جذر منتفخ صالح للأكل؛ يزرع على نطاق واسع كمحصول غذائي)",
 "common bile duct": "قناة صفراوية مشتركة (قناة تتكون من القناتين الكبدية والمرارية؛ تفتح في الاثني عشر)",
 "common birch": "بتولا بيضاء أوروبية, بتولا فضية (بتولا أوروبية بلحاء أبيض فضي مقشر وفروع متدلية بشكل ملحوظ)",
 "common bird cherry": "كرز الطيور الأوروبي, هاغبيري (شجرة كرز أوروبية صغيرة تشبه كثيراً الكرز المخنوق الأمريكي)",
 "common blackfish": "حوت طيار (حوت صغير داكن اللون يعيش في ساحل المحيط الأطلسي للولايات المتحدة؛ يعمل الذكر الأكبر كطيار أو قائد للسرب)",
 "common bog rosemary": "أندروميدا المستنقعات (شجيرة دائمة الخضرة قائمة أو منبطحة لها عناقيد متدلية من الزهور البيضاء أو الوردية؛ من مستنقعات الخث الطحلبية والمناطق الحمضية الرطبة الأخرى في شمال…)",
 "common booklouse": "قمل الكتب الشائع (نوع من قمل الكتب)",
 "common box": "بقس شائع, شمشاد دائم الخضرة (شجيرة كبيرة بطيئة النمو دائمة الخضرة أو شجرة صغيرة ذات سيقان متعددة؛ تستخدم على نطاق واسع للأسيجة أو الحدود والأشكال المقلمة)",
 "common brant goose": "إوز برانت الشائع (أشهر أنواع إوز برانت)",
 "common broom": "وزال اسكتلندي, وزال شائع (وزال متساقط الأوراق قائم منتشر موطنه غرب أوروبا؛ يزرع على نطاق واسع لزهوره الصفراء الغنية)",
 "common burdock": "أرقطيون شائع, أرقطيون صغير (نبات موجود في كل مكان ما عدا التربة شديدة الحموضة؛ يوجد في معظم أوروبا وشمال أفريقيا)",
 "common buttercup": "حوذان بصيلي, حوذان شائع (حوذان معمر من العالم القديم ذو أزهار ذهبية إلى صفراء كبريتية في أواخر الربيع إلى أوائل الصيف؛ متوطن في أمريكا الشمالية)",
 "common calamint": "كالامينت شائع, نعناع الجبل (نبات معمر برائحة النعناع من وسط وجنوب أوروبا)",
 "common camas": "كاماسيا, كاماسيا شائعة (نبات له بصلة كبيرة صالحة للأكل وأوراق قاعدية خطية وعناقيد من الزهور النجمية البنفسجية الزرقاء الفاتحة إلى العميقة على سيقان خضراء طويلة؛ غرب أمريكا…)",
 "common canary": "كناري (موطنه جزر الكناري والأزور؛ طائر قفص شائع عادة ما يكون أصفر اللون ويشتهر بغنائه)",
 "common caper": "قبار شائع, كبار (شجيرة شائكة مفترشة من منطقة البحر الأبيض المتوسط تزرع لبراعم زهورها المخضرة التي تخلل)",
 "common cardinal vein": "وريد رئيسي مشترك (قنوات العودة الرئيسية للقلب؛ تتكون من مفاغرة الأوردة الرئيسية الأمامية والخلفية)",
 "common carline thistle": "أداد شائع (شوك أوراسي ينمو في الكثبان الرملية والتربة الطباشيرية الجافة)",
 "common carotid": "شريان سباتي مشترك (يمتد صعوداً في الرقبة وينقسم إلى الشرايين السباتية الظاهرة والباطنة)",
 "common carotid artery": "شريان سباتي مشترك (يمتد صعوداً في الرقبة وينقسم إلى الشرايين السباتية الظاهرة والباطنة)",
 "common carrier": "شركة نقل, ناقل (شخص أو شركة تعمل في مجال نقل الأشخاص أو البضائع أو الرسائل)",
 "common chickweed": "حشيشة القزاز, عشبة الطيور الشائعة (عشبة ضارة حولية شائعة منخفضة النمو في الحدائق ذات أزهار بيضاء صغيرة؛ عالمية الانتشار؛ سميت كذلك لأن الدجاج يأكلها)",
 "common chord": "ثالوث, كورد ثلاثي (كورد ثلاثي النوتات كبير أو صغير؛ نوتة وثالثتها وخامستها)",
 "common cockscomb": "عرف الديك (نبات حولي للحدائق ذو سنابل تشبه الريش من الزهور الحمراء أو الصفراء)",
 "common cold": "زُكَام",
 "common comfrey": "سمفوطن, سنفيتون مخزني (عشب أوروبي له زهور صغيرة بيضاء أو وردية أو أرجوانية؛ تم توطينه كعشب ضار في أمريكا الشمالية)",
 "common coral tree": "سايبو, شجرة المرجان الشائعة (شجرة شائكة صغيرة من أمريكا الجنوبية بزهور قرمزية داكنة وقرمزية منفردة أو متجمعة)",
 "common corn salad": "خس النعجة, فاليريانلا (يزرع على نطاق واسع كمحصول سلطة وعشب وعائي؛ غالباً ما يكون عشباً ضاراً)",
 "common cotton grass": "عشبة القطن الشائعة (ذات قنابات قطنية بيضاء أو تشبه الزغب معنقدة بكثافة)",
 "common daisy": "أقحوان إنجليزي, أقحوان شائع (نبات أوراسي منخفض النمو بزهور قرصية مركزية صفراء وزهور شعاعية خارجية بيضاء وردية)",
 "common dandelion": "هندباء شائعة (نبات أوراسي متوطن على نطاق واسع كعشبة ضارة في أمريكا الشمالية؛ يستخدم كخضروات للسلطة ولصنع النبيذ)",
 "common denominator": "قاسم مشترك (سمة مشتركة بين جميع أعضاء فئة ما) / مَقَام مُشْتَرَك (عدد صحيح هو مضاعف مشترك لمقامات كسرين أو أكثر)",
 "common devil's claw": "بروبوسيديا, مخالب الشيطان (نبات حولي من جنوب الولايات المتحدة إلى المكسيك له أزهار كبيرة بيضاء أو صفراء مرقطة بالأرجواني ومنقار منحن طويل)",
 "common divisor": "عَامِل مُشْتَرَك, قَاسِم مُشْتَرَك (عدد صحيح يقسم عددين (أو أكثر) آخرين بالتساوي)",
 "common dogbane": "دفل شائع, قاتل الكلب الشائع (نبات معمر في أمريكا الشمالية له أزهار وردية في نورات محدودة سائبة؛ يستخدم في الطب الشعبي لعلاج الألم أو الالتهاب في المفاصل)",
 "common dolphin": "دلفين شائع (دلفين أسود وأبيض يقفز عالياً خارج الماء)",
 "common duckweed": "عدس الماء الشائع (من المناطق المعتدلة باستثناء شرق آسيا وأستراليا)",
 "common eel": "أنقليس المياه العذبة, أنقليس شائع (أنقليس يعيش في المياه العذبة كبالغ ولكنه يعود إلى البحر للتكاثر؛ يوجد في أوروبا وأمريكا؛ يُسوق طازجاً ومدخناً)",
 "common eland": "إيلاند شائع (إيلاند داكن اللون من جنوب وشرق أفريقيا)",
 "common elder": "بيلسان أسود, خمان أسود (شجيرة شائعة بفاكهة سوداء أو شجرة صغيرة من أوروبا وآسيا؛ تستخدم الفاكهة للنبيذ والمربيات)",
 "common era": "الحقبة العامة, العصر الحالي (في الفترة المتزامنة مع العصر المسيحي؛ يفضل استخدامها بعض الكتاب غير المسيحيين)\nمثال: في عام 200 من الحقبة العامة",
 "common european ash": "مران أوروبي, مران عالي (مران طويل من أوروبا إلى القوقاز له أوراق خضراء داكنة لامعة من الأعلى وشاحبة زغبية من الأسفل)",
 "common european dogwood": "قرانيا أوروبية شائعة, قرانيا دموية (شجيرة نفضية أوروبية تتحول للأحمر في الخريف ولها زهور بيضاء باهتة)",
 "common european earwig": "إبرة العجوز, حشرة أذن (مدمرة أحياناً للأبصال المزروعة)",
 "common european jay": "قيق أوروبي شائع (قيق لونه أسمر مصفر ذو عرف أسود وأبيض وأجنحة زرقاء وسوداء)",
 "common evening primrose": "زهرة الربيع المسائية الشائعة (نبات ثنائي الحول خشن من شرق أمريكا الشمالية بأزهار صفراء تتفتح في المساء؛ متوطن في أوروبا)",
 "common facial vein": "وريد وجهي مشترك (وريد يتكون من اتحاد الوريد الوجهي والوريد خلف الفك السفلي ويصب في الوريد الوداجي)",
 "common factor": "عَامِل مُشْتَرَك, قَاسِم مُشْتَرَك (عدد صحيح يقسم عددين (أو أكثر) آخرين بالتساوي)",
 "common fate": "المصير المشترك, قانون المصير المشترك (مبدأ تنظيم غيشتالتي ينص على أن جوانب المجال الإدراكي التي تتحرك أو تعمل بطريقة مماثلة سيتم إدراكها كوحدة واحدة)",
 "common fault": "صدع عادي (صدع مائل يبدو فيه أن الجدار المعلق قد انزلق لأسفل بالنسبة للجدار السفلي)",
 "common fennel": "شمر (أوراق تستخدم للتتبيل) / بسباس, شمر (نبات عطري بقوة برائحة اليانسون؛ تستخدم الأوراق والبذور للتتبيل)",
 "common fig": "تين, تين شائع (شجرة متوسطية تُزرع على نطاق واسع لثمارها الصالحة للأكل)",
 "common fig tree": "تين, تين شائع (شجرة متوسطية تُزرع على نطاق واسع لثمارها الصالحة للأكل)",
 "common flat pea": "بازلاء مسطحة شائعة (شجيرة منخفضة الانتشار دائمة الخضرة في جنوب أستراليا ذات أوراق مثلثة إلى شبه قلبية وزهور برتقالية صفراء تليها قرون مسطحة مجنحة)",
 "common four-o'clock": "أعجوبة بيرو, شب الليل (نبات حديقة شائع في أمريكا الشمالية ذو زهور عطرة حمراء أو أرجوانية أو صفراء أو بيضاء تفتح في وقت متأخر من بعد الظهر)",
 "common foxglove": "قفاز الثعلب, قمعية أرجوانية (نبات ثنائي الحول أو معمر أوروبي طويل ومورق له عناقيد مذهلة من الزهور الأنبوبية الوردية الأرجوانية الكبيرة؛ تنتج الأوراق دواء الديجيتال وهي سامة…)",
 "common fraction": "كَسْرٌ بَسِيطٌ",
 "common front": "جبهة مشتركة (حركة ينضم فيها عدة أفراد أو مجموعات ذات مصالح مختلفة معاً)\nمثال: قدمت النقابات جبهة مشتركة على طاولة المفاوضات",
 "common garden cress": "رشاد الحديقة, رشاد مزروع (عشب حولي يستخدم كخضار للسلطة وللزينة)",
 "common garter snake": "ثعبان الرباط الشائع (ثعبان رباط واسع الانتشار في أمريكا الشمالية)",
 "common ginger": "زنجبيل, زنجبيل شائع (نبات آسيوي استوائي يزرع على نطاق واسع لجذره اللاذع؛ مصدر لجذر الزنجبيل والزنجبيل المسحوق)",
 "common good": "صَالِح عَامّ, مَصْلَحَة عَامَّة (خير المجتمع ككل)",
 "common grape hyacinth": "مسكاري عنقودي شائع, ياقوتية عنبية (نوع غزير الإنتاج له زهور زرقاء داكنة جميلة بشكل خاص)",
 "common grape vine": "دالية, كرمة (عنب أوروبي شائع يزرع في العديد من الأصناف؛ المصدر الرئيسي لنبيذ العالم القديم وعنب المائدة)",
 "common ground": "أَرْضِيَّة مُشْتَرَكَة (أساس يتفق عليه جميع الأطراف للوصول إلى تفاهم متبادل)",
 "common gum cistus": "قيضة لادنية, لاذن (شجيرة لها زهور بيضاء وسيقان وأوراق لزجة تنتج راتنجاً زيتياً عطراً يستخدم في العطور خاصة كمثبت)",
 "common heath": "خلنج شائع (شجيرة منتصبة مغزلية في جنوب أستراليا وتاسمانيا ذات زهور بيضاء إلى وردية أو أرجوانية حمراء) / خلنج شائع, خلنج كليل الأوراق (شجيرة منتصبة صغيرة في أستراليا وتاسمانيا بزهور عاجية عطرة)",
 "common hop": "جنجل شائع, حشيشة الدينار (نبات متسلق أوروبي تستخدم أزهاره بشكل رئيسي لتنكيه المشروبات الكحولية (البيرة)؛ يزرع في أمريكا)",
 "common hops": "جنجل شائع, حشيشة الدينار (نبات متسلق أوروبي تستخدم أزهاره بشكل رئيسي لتنكيه المشروبات الكحولية (البيرة)؛ يزرع في أمريكا)",
 "common horehound": "فراسيون أبيض, فراسيون شائع (عشب عطري أوروبي بأوراق مشعرة والعديد من الزهور البيضاء في سيمات إبطية؛ تنتج الأوراق مستخلصاً مراً يستخدم طبياً وكنكهة)",
 "common horsetail": "ذيل الحصان الحقلي, ذيل الحصان الشائع (من أوراسيا وجرينلاند وأمريكا الشمالية)",
 "common hyacinth": "صفير, ياقوتية شائعة (تزرع على نطاق واسع لرائحتها وزهورها البيضاء أو الوردية أو الزرقاء أو الأرجوانية)",
 "common iguana": "إغوانة شائعة (سحالي شجرية أمريكية استوائية كبيرة آكلة للأعشاب ذات عرف شائك على طول الظهر؛ تُستخدم كطعام بشري في أمريكا الوسطى والجنوبية)",
 "common iliac artery": "شريان حرقفي مشترك (الفروع النهائية للأبهر البطني)",
 "common iliac vein": "وريد حرقفي مشترك (يتكون من الوريدين الحرقفيين الباطن والظاهر؛ يتحد مع نظيره من الجانب الآخر للجسم لتكوين الوريد الأجوف السفلي)",
 "common ivy": "حبل المساكين, لبلاب (كرمة من العالم القديم ذات أوراق مفصصة دائمة الخضرة وثمار سوداء تشبه التوت)",
 "common jasmine": "ياسمين حقيقي, ياسمين شائع (شجيرة متساقطة الأوراق متسلقة بزهور عطرة بيضاء أو صفراء أو حمراء تستخدم في العطور ولتنكيه الشاي)",
 "common juniper": "عرعر شائع (شجيرة كثيفة التفرع أو شجرة صغيرة لها توت أزرق لاذع يستخدم لنكهة الجن؛ واسعة الانتشار في نصف الكرة الشمالي؛ الصنوبرية الوحيدة على سواحل أيسلندا…)",
 "common kingsnake": "ثعبان الملك الشائع (واسع الانتشار في الولايات المتحدة باستثناء المناطق الشمالية؛ أسود أو بني مع أشرطة صفراء)",
 "common knowledge": "أمر معروف للجميع, معلومات عامة (أي شيء معروف عموماً للجميع)",
 "common laburnum": "سلسلة ذهبية, لابورنوم شائع (شجيرة زينة أو شجرة من جنس لابورنوم؛ تزرع غالباً لزينة عيد الفصح)",
 "common lady's-slipper": "خف السيدة الملكي (سحلب بري وردي شاحب من شمال شرق أمريكا له شفة منتفخة تشبه الجراب)",
 "common land": "أرض مشاع, مشاع (مرعى خاضع للاستخدام المشترك)",
 "common law": "سابقة قضائية, قانون السوابق القضائية ((القانون المدني) قانون تم إنشاؤه من خلال اتباع قرارات قضائية سابقة) / قانون عام, قانون عرفي (نظام فقهي يعتمد على السوابق القضائية بدلاً من القوانين التشريعية)\nمثال: نشأ القانون العام في القوانين غير المكتوبة في إنجلترا وتم تطبيقه لاحقاً في الولايات المتحدة",
 "common lettuce": "خس, خس الحدائق (نبات حديقة حولي أو معمر ذو أوراق عصارية تستخدم في السلطات؛ يزرع على نطاق واسع)",
 "common lilac": "ليلك شائع (ليلك أوروبي كبير توطن في أمريكا الشمالية له أوراق بيضاوية على شكل قلب وعناقيد كبيرة من الزهور الليلكية أو البيضاء شديدة العطرية)",
 "common limpet": "بطلينوس (بطلينوس بحري)",
 "common logarithm": "لوغاريتم عشري (لوغاريتم للأساس 10)",
 "common louse": "قملة شائعة (قملة الرأس أو الجسم)",
 "common lynx": "وشق أوراسي (يعيش في شمال أوراسيا)",
 "common mackerel": "ماكريل شائع (سمكة طعام مهمة في شمال المحيط الأطلسي والبحر الأبيض المتوسط؛ جسمها أزرق مخضر مع قضبان داكنة وحراشف صغيرة إن وجدت)",
 "common madia": "ماديا أنيقة, ماديا شائعة (نبات حولي كاليفورني له بقع بنية حمراء بالقرب من قاعدة أشعة زهوره الصفراء)",
 "common maidenhair": "شعر الزهرة, كزبرة البئر (سرخس كزبرة البئر الرقيق بسيقان أوراق سوداء لامعة رفيعة؛ عالمي الانتشار)",
 "common mallow": "خبازة شائعة (نبات حولي من العالم القديم بعناقيد من الزهور الوردية أو البيضاء؛ توطن في الولايات المتحدة)",
 "common man": "رجل عامي (شخص ذكر لا يحمل لقباً)",
 "common marigold": "آذريون, أقحوان الذهب (القطيفة السنوية الأوروبية الشائعة)",
 "common market": "الاتحاد الأوروبي, السوق الأوروبية المشتركة (منظمة دولية للدول الأوروبية تشكلت بعد الحرب العالمية الثانية لتقليل الحواجز التجارية وزيادة التعاون بين أعضائها)\nمثال: حاول إدخال بريطانيا في الاتحاد الأوروبي",
 "common matrimony vine": "عوسج شائع, لساس بربري (شجيرة منتصبة أو منتشرة متساقطة الأوراق ذات فروع شائكة وزهور بنفسجية أرجوانية تليها ثمار برتقالية حمراء؛ من جنوب شرق أوروبا إلى الصين)",
 "common measure": "وزن شائع (الوزن المعتاد (الإيامبي) للقصيدة القصصية (البالاد)) / عَامِل مُشْتَرَك, قَاسِم مُشْتَرَك (عدد صحيح يقسم عددين (أو أكثر) آخرين بالتساوي) / زمن شائع, وزن رباعي (توقيع زمني يشير إلى أربع دقات في المقياس)",
 "common meter": "وزن شائع (الوزن المعتاد (الإيامبي) للقصيدة القصصية (البالاد))",
 "common milkwort": "مستدرة شائعة (نبات معمر أوروبي صغير له فروع عديدة تحمل عناقيد من الزهور الزرقاء أو الوردية أو البيضاء؛ كان يشتهر سابقاً بتعزيز الرضاعة البشرية)",
 "common mood": "الأُسْلُوب الخَبَرِيّ, صِيغَة خَبَرِيَّة (صيغة تمثل الفعل أو الحالة كحقيقة موضوعية)",
 "common moonseed": "بذر القمر الشائع, بذر القمر الكندي (كرمة خشبية من شرق أمريكا الشمالية ذات أوراق بيضاوية كبيرة وأزهار بيضاء صغيرة وثمار أرجوانية إلى سوداء زرقاء)",
 "common moonwort": "بوتريشيوم قمري, عشبة القمر (من أمريكا وأوراسيا وأستراليا)",
 "common morel": "غوشنة مألوفة, موريل شائع (موريل صالح للأكل وممتاز ذو رأس كروي إلى مستطيل بنمط غير منتظم من الحفر والنتوءات)",
 "common morning glory": "أثمان أرجواني, مجد الصباح الشائع (عشب متسلق حولي استوائي شامل بزهور قمعية الشكل زرقاء أو أرجوانية أو وردية أو بيضاء) / أثمان ثلاثي الألوان, مجد الصباح الشائع (عشب متسلق حولي أو معمر من أمريكا الوسطى له زهور زرقاء سماوية؛ أكثر أنواع مجد الصباح زراعة)",
 "common mosquito": "بعوضة شائعة (بعوضة المنزل الشائعة)",
 "common mugwort": "حبق الراعي, شيح شائع (عشب عطري معمر أوروبي ذو خصلات له سيقان حمراء أو أرجوانية مشعرة وأوراق خضراء داكنة زغبية بيضاء من الأسفل وزهيرات بنية حمراء)",
 "common mullein": "آذان الدب, بوصير (بوصير طويل الساق صوفي جداً بزهور صفراء مكتظة بكثافة؛ كان الإغريق والرومان القدماء يغمسون السيقان في الشحم لاستخدامها كمشاعل جنائزية)",
 "common multiple": "مُضَاعَف مُشْتَرَك (عدد صحيح هو مضاعف لعددين صحيحين أو أكثر)",
 "common murre": "مور شائع (أكثر أنواع طائر المور شيوعاً)",
 "common myrtle": "آس شائع, ريحان (مغاربي) (شجيرة أوروبية ذات زهور بيضاء أو وردية يتبعها توت أسود)",
 "common nardoo": "ناردو, ناردو شائع (سرخس البرسيم الأسترالي)",
 "common newt": "سمندل الماء الشائع (سمندل صغير شبه مائي)",
 "common nightshade": "عنب الديب, مغد أسود (عشب أوراسي تم توطينه في أمريكا له زهور بيضاء وأوراق مشعرة سامة ويحمل توتاً أسود يكون ساماً أحياناً ولكنه صالح للأكل أحياناً أخرى)",
 "common noun": "اِسْم الجِنْس (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)\nمثال: ما اسم حصان توم؟",
 "common nuisance": "ضرر عام (إزعاج يتداخل بشكل غير معقول مع حق مشترك للجمهور العام)\nمثال: الضرر العام يسيء للجمهور ككل",
 "common nutcracker": "كسار البندق (كسار بندق من العالم القديم)",
 "common oak": "بلوط شائع, سنديان إنجليزي (سنديان أوروبي نفضي متوسط إلى كبير الحجم، له أوراق ناعمة ذات فصوص مستديرة؛ ينتج خشباً صلباً قوياً فاتح اللون)",
 "common opossum": "أبوسوم شائع (أبوسوم قارت من شرق الولايات المتحدة؛ يشتهر بالتظاهر بالموت عند الخطر؛ يُقدر كطعام في بعض المناطق)",
 "common osier": "صفصاف السلال, صفصاف القنب (صفصاف بغصينات مرنة طويلة تستخدم في صناعة السلال)",
 "common pea": "بازلاء الحديقة, بازلاء شائعة (نبات ينتج بازلاء تؤكل عادة طازجة بدلاً من مجففة)",
 "common people": "عامة الناس, قوم (الناس بشكل عام (وغالباً ما تستخدم بصيغة الجمع))\nمثال: إنهم مجرد ناس ريفيين",
 "common pepper": "فلفل, فلفل أسود (نبات متسلق يحمل توتاً أحمر داكناً (حبوب الفلفل) عند النضج الكامل؛ جنوب الهند وسريلانكا؛ تم توطينه في شمال بورما وآسام)",
 "common person": "شخص من العامة, عامّي (شخص لا يحمل أي لقب نبيل)",
 "common pillbug": "دَرْعَام",
 "common pitcher plant": "سراسينية أرجوانية, نبات الإبريق الشائع (عشبة مستنقعات معمرة ذات زهور حمراء داكنة وأباريق مجنحة عريضة تشكل وردية؛ من شمال شرق أمريكا الشمالية ومتوطنة في أوروبا وخاصة أيرلندا)",
 "common plantain": "لسان الحمل الكبير, لسان الحمل عريض الأوراق (نبات معمر أوروبي شائع تم توطينه في جميع أنحاء العالم؛ يعتبر عشباً ضاراً مزعجاً)",
 "common plum": "برقوق شائع (أي من أنواع البرقوق المختلفة واسعة الانتشار التي تزرع في المناطق المعتدلة الباردة)",
 "common pochard": "حمرواي",
 "common polypody": "بسفايج",
 "common pond-skater": "بق الماء الشائع (نوع من بق الماء)",
 "common privet": "تمرحنة شائعة (شجيرة متساقطة الأوراق شبه دائمة الخضرة تستخدم للتحوط)",
 "common purslane": "رِجْل, فَرْفَحِين (العُضْو في جسد الإنسان يتكون من القَدَم والسَاق والفُخْذ. الجمع أرجُل، وقد تقول العامّة رِجْلين ورجْلينات؛ القَدَم من باب اطلاق اسم الكل على الجزء)\nمثال: هذا الرجل تاجر.",
 "common raccoon": "راكون, راكون شائع (الراكون الموجود في أمريكا الشمالية)",
 "common racoon": "راكون, راكون شائع (الراكون الموجود في أمريكا الشمالية)",
 "common ragweed": "دمسيسة شائعة, عشبة الرجيد (عشبة ضارة حولية ذات أوراق مقسمة بدقة وسنابل من الزهور الخضراء؛ شائعة في أمريكا الشمالية؛ أدخلت في أماكن أخرى عن طريق الخطأ)",
 "common reed": "قصب الخنادق, قيصوب شائع (قصب طويل من أمريكا الشمالية له أوراق عريضة نسبياً وعناقيد كبيرة تشبه الريش؛ واسع الانتشار في المناطق الرطبة؛ يستخدم للحصير والستائر وأعمدة السهام)",
 "common room": "غرفة مشتركة (غرفة جلوس (عادة في مدرسة أو جامعة))",
 "common rorqual": "حوت الزعنفة, حوت زعنفي (حوت باليني كبير مسطح الرأس له أخاديد عميقة على طول الحلق؛ يعيش في المحيط الأطلسي والهادئ)",
 "common rose mallow": "ختمية المستنقعات, ختمية وردية (شجيرة مبهرجة في المستنقعات المالحة بشرق الولايات المتحدة ذات زهور وردية كبيرة)",
 "common roundworm": "إسكارس, دودة الصفر (طفيلي معوي يصيب البشر والخنازير)",
 "common rush": "أسل شائع, سمار ناعم (أسل طويل بسيقان ناعمة منتصبة أو مقوسة يوجد في أوراسيا وأستراليا ونيوزيلندا وشائع في أمريكا الشمالية)",
 "common sage": "قصعين طبي, ميرمية شائعة (نبات شجيري ذو أوراق رمادية خضراء عطرية تستخدم كعشب طبخ)",
 "common salt": "ملح, ملح الطعام (شكل بلوري أبيض لكلوريد الصوديوم خاصة يستخدم لتتبيل وحفظ الطعام) / كلوريد الصوديوم, ملح الطعام",
 "common scold": "كثير التذمر, لحوح (شخص (خاصة امرأة) يزعج الناس بكثرة البحث عن الأخطاء)",
 "common scoter": "بط أسود شائع (نوع من البط الأسود)",
 "common scurvy grass": "عشبة الأسقربوط, ملعقية (رشاد قطبي واسع التوزيع يشتهر بقيمته في علاج أو الوقاية من الإسقربوط؛ مصدر مركز لفيتامين سي)",
 "common seal": "فقمة الميناء, فقمة شائعة (فقمة مرقطة صغيرة تعيش في المياه الساحلية لنصف الكرة الشمالي)",
 "common sense": "اَلْحِسّ السَّلِيم",
 "common shares": "أسهم عادية (أسهم غير الأسهم الممتازة؛ تمنح المالك حصة من أرباح الشركة وحصة من قوة التصويت في انتخابات المساهمين)",
 "common shiner": "جوانب الفضة, شاينر الشائع (سمكة الشاينر الشائعة في أمريكا الشمالية)",
 "common shrew": "زباب شائع (زباب أمريكي شائع)",
 "common sickle pine": "صنوبر منجلي شائع (شجرة غابات مطيرة استوائية صغيرة في إندونيسيا وماليزيا)",
 "common snapping turtle": "سلحفاة نهاشة (سلحفاة كبيرة الرأس ذات فكوك معقوفة قوية توجد في الماء أو بالقرب منه؛ تميل للعض)",
 "common snowberry": "توت الثلج, سيمفوريكاربوس (شجيرة متساقطة الأوراق من غرب أمريكا الشمالية لها سنابل من الأزهار الوردية يليها توت أبيض مستدير)",
 "common soldier": "جندي (جندي مجند من أدنى رتبة في الجيش أو مشاة البحرية)\nمثال: كان سجيننا مجرد جندي ولم يكن يعرف شيئاً ذا قيمة",
 "common sorrel": "حماض, حميضة (أوراق كبيرة حامضة الطعم على شكل رأس سهم تستخدم في السلطات والصلصات)",
 "common speedwell": "زهرة الحواشي المخزنية, فيرونيكا شائعة (نبات أوروبي معمر زغبي شائع بزهور زرقاء شاحبة أو ليلكية في عناقيد إبطية)",
 "common spindle tree": "شجرة المغزل الشائعة, مغزلية أوروبية (شجيرة صغيرة منتصبة متساقطة الأوراق ذات خشب أبيض صلب ولحاء وثمار مسهلة)",
 "common spoonbill": "أبو ملعقة الشائع (أبو ملعقة أبيض نقي ذو عرف من جنوب أوراسيا وشمال شرق أفريقيا)",
 "common spotted orchid": "أوركيد مرقط شائع (أوركيد أوروبي ذو أوراق رمحية مرقطة بالأرجواني وزهور وردية إلى بيضاء أو بنفسجية مرقطة أو مخططة بالأحمر الداكن أو الأرجواني)",
 "common st john's wort": "عشبة القديس يوحنا الشائعة, هيوفاريقون (شجيرة أوراسية نفضية كثيفة ذات زهور صفراء ذهبية وثمار أرجوانية محمرة يصنع منها مرهم مهدئ في إسبانيا)",
 "common staghorn fern": "سرخس قرن الأيل, سرخس قرن الوعل الشائع (سرخس يزرع عادة في أستراليا وجنوب شرق آسيا وبولينيزيا)",
 "common starling": "زرزور شائع (طائر اجتماعي ذو ريش بلمعان معدني داكن؛ يبني أعشاشاً حول المساكن والهياكل الأخرى؛ متوطن في جميع أنحاء العالم)",
 "common stinkhorn": "فطر القرن النتن الشائع (فطر شائع كان يستخدم سابقاً في تحضير مرهم للروماتيزم)",
 "common stock": "أسهم عادية (أسهم غير الأسهم الممتازة؛ تمنح المالك حصة من أرباح الشركة وحصة من قوة التصويت في انتخابات المساهمين)",
 "common stock equivalent": "مكافئ الأسهم العادية (أسهم ممتازة أو سندات قابلة للتحويل أو مذكرات يمكن تحويلها إلى أسهم عادية)",
 "common sunflower": "دوار الشمس, عباد الشمس الشائع (عباد شمس سنوي يزرع للسيلاج ولبذوره التي تعد مصدراً للزيت؛ شائع في جميع أنحاء الولايات المتحدة ومعظم أمريكا الشمالية)",
 "common tarweed": "ماديا أنيقة, ماديا شائعة (نبات حولي كاليفورني له بقع بنية حمراء بالقرب من قاعدة أشعة زهوره الصفراء)",
 "common teasel": "ديبساق, مشط الراعي الشائع (نبات مشط الراعي بزهور ليلكية موطنه العالم القديم ولكن تم توطينه في أمريكا الشمالية؛ تستخدم رؤوس الزهور المجففة لرفع الوبر على القماش الصوفي)",
 "common thorn apple": "تفاح شوكي, داتورا صفراوية (عشبة استوائية سنوية طويلة خشنة وسامة للغاية ذات أوراق كريهة الرائحة وزهور بيضاء أو بنفسجية كبيرة على شكل بوق وثمار شائكة)",
 "common thyme": "زعتر, زعتر شائع (نبات معمر عطري شائع في الحدائق موطنه غرب البحر الأبيض المتوسط؛ يستخدم في التوابل وسابقاً كدواء)",
 "common time": "زمن شائع, وزن رباعي (توقيع زمني يشير إلى أربع دقات في المقياس)",
 "common tobacco": "تبغ شائع (عشب طويل منتصب من أمريكا الجنوبية بأوراق بيضاوية كبيرة وعناقيد طرفية من الزهور الأنبوبية البيضاء أو الوردية؛ يزرع لأوراقه)",
 "common topaz": "توباز, توباز زائف (كوارتز أصفر)",
 "common touch": "لمسة شعبية (خاصية جذب الناس عامة (عادةً بالظهور بمظهر من يشترك معهم في الصفات))",
 "common unicorn plant": "بروبوسيديا, مخالب الشيطان (نبات حولي من جنوب الولايات المتحدة إلى المكسيك له أزهار كبيرة بيضاء أو صفراء مرقطة بالأرجواني ومنقار منحن طويل)",
 "common valerian": "ناردين شائع, ناردين مخزني (نبات جذموري طويل له زهور عطرة جداً وجذامير تستخدم طبياً)",
 "common vetchling": "بازلاء المروج, بيقية شائعة (بازلاء برية أوراسية معمرة متسلقة لها زهور مصفرة وقرون بذور مضغوطة؛ تزرع للعلف)",
 "common viper": "أفعى شائعة (أفعى أرضية صغيرة شائعة في شمال أوراسيا)",
 "common wallaby": "ولب رشيق, ولب شائع (ولب صغير يبلغ ارتفاعه 30 بوصة)",
 "common wart": "ثؤلول شائع (نمو حميد (غالبًا بسطح خشن))",
 "common wasp": "دبور شائع (نوع من الدبابير)",
 "common water snake": "ثعبان الماء الشائع, ثعبان الماء المخطط (يُوضع في بعض التصنيفات في جنس نيروديا؛ ثعبان من غرب الولايات المتحدة نادراً ما يبتعد عن الماء)",
 "common watercress": "جرجير الماء, قرة العين (رشاد أوراسي معمر ينمو بشكل رئيسي في الينابيع أو المياه الجارية ذو أوراق لاذعة لحمية تستخدم في السلطات أو كعشبة طهي أو زينة؛ أدخل إلى أمريكا الشمالية…)",
 "common wheat": "قمح الخبز, قمح طري (يزرع على نطاق واسع في المناطق المعتدلة في العديد من الأصناف لحبوبه المهمة تجارياً)",
 "common white dogwood": "قرانيا بيضاء شائعة, قرانيا مزهرة شرقية (شجرة نفضية؛ تشتهر بقناباتها البيضاء أو الوردية الكبيرة ولونها الخريفي المذهل الذي يتبعه توت أحمر)",
 "common winterberry holly": "بهشية شائعة, توت الشتاء الشائع",
 "common wolffia": "ولفيا كولومبية (أصغر النباتات المزهرة المعروفة؛ من الأمريكتين)",
 "common woman": "امرأة من العامة (شخص أنثى لا تحمل أي لقب نبيل)",
 "common wood sorrel": "أقصليس, حميض الخشب الشائع (نبات أوراسي بأوراق ثلاثية على شكل قلب وزهور بيضاء ذات عروق أرجوانية)",
 "common wormwood": "أفسنتين, شيح ابن سينا (عشبة عطرية في أوراسيا المعتدلة وشمال أفريقيا ذات طعم مر تستخدم في صنع مشروب الأفسنتين)",
 "common yarrow": "حَزَنْبَل",
 "common year": "سنة بسيطة (سنة ليست كبيسة (365 يوماً))",
 "common yellowthroat": "عصفور أصفر الحلق الشائع (طائر مغرد أمريكي)",
 "common yellowwood": "أفروكاربوس منجلي, خشب أصفر شائع (شجرة متوسطة الحجم في جنوب أفريقيا)",
 "common zebra": "حمار الزرد الشائع (يعيش في سهول وسط وشرق أفريقيا)",
 "common-law marriage": "زواج عرفي, مساكنة (علاقة زواج تنشأ عن طريق الاتفاق والمساكنة بدلاً من المراسم)",
 "commonage": "مشاع, ملكية شائعة (ممتلكات محتفظ بها كملكية عامة أو مشتركة)",
 "commonality": "اشْتِرَاك, قَوَاسِم مُشْتَرَكَة (مشاركة سمات مشتركة) / الدهماء, العامة (طبقة تتكون من أشخاص يفتقرون إلى رتبة دينية أو نبيلة)",
 "commonalty": "الدهماء, العامة (طبقة تتكون من أشخاص يفتقرون إلى رتبة دينية أو نبيلة)",
 "commoner": "شخص من العامة, عامّي (شخص لا يحمل أي لقب نبيل)",
 "commonly": "غالبا, عَادَةً",
 "commonness": "اشْتِرَاك, قَوَاسِم مُشْتَرَكَة (مشاركة سمات مشتركة) / اعْتِيَادِيَّة, شُيُوع (العادية كنتيجة لكون الشيء متكرراً ومألوفاً) / ابْتِذَال, سُوقِيَّة (صفة الافتقار إلى الذوق والتهذيب) / اعتيادية, شيوع (حالة كون الشيء ملاحظاً بشكل شائع)",
 "commonplace": "رَتِيب, عَادِيّ (غير مُلهِم ولا يُشكِّل تحدياً؛ باهت وخالٍ من الإثارة) / عَادِيّ تَمَامًا, مُبْتَذَل (عادي تماماً ولا يستحق الملاحظة) / مُبْتَذَل, مُسْتَهْلَك (مُكرَّر أكثر من اللازم؛ مألوف بشكل مفرط بسبب كثرة الاستخدام) / عبارة مبتذلة, قول مأثور مبتذل (ملاحظة مبتذلة أو واضحة بشكل مفرط)",
 "commonplace book": "دفتر مقتطفات (دفتر ملاحظات تدون فيه التذكارات)",
 "commonplaceness": "اعْتِيَادِيَّة, شُيُوع (العادية كنتيجة لكون الشيء متكرراً ومألوفاً)",
 "commons": "الطبقة الثالثة, عامة الشعب (عامة الناس) / الدهماء, العامة (طبقة تتكون من أشخاص يفتقرون إلى رتبة دينية أو نبيلة) / أرض مشاع, مشاع (مرعى خاضع للاستخدام المشترك) / حديقة عامة, متنزه (قطعة أرض مفتوحة للاستخدام الترفيهي في منطقة حضرية)\nمثال: ذهبوا في نزهة في الحديقة",
 "commonsense": "ذُو حِسٍّ سَلِيم, سَلِيمُ الفِطْرَة (يُظهِر حكمًا فطريًّا سليمًا)",
 "commonsensible": "ذُو حِسٍّ سَلِيم, سَلِيمُ الفِطْرَة (يُظهِر حكمًا فطريًّا سليمًا)",
 "commonsensical": "ذُو حِسٍّ سَلِيم, سَلِيمُ الفِطْرَة (يُظهِر حكمًا فطريًّا سليمًا)",
 "commonweal": "صَالِح عَامّ, مَصْلَحَة عَامَّة (خير المجتمع ككل)",
 "commonwealth": "كُومُنْوِلْث",
 "commonwealth country": "دولة كومنولث (أي من الدول في الكومنولث البريطاني)",
 "commonwealth day": "24 مايو, يوم الكومنولث (بريطاني، ذكرى ميلاد الملكة فيكتوريا)",
 "commonwealth english orthography": "الإملاء البريطاني, التهجئة البريطانية (قواعد الإملاء الإنجليزية المستخدمة في المملكة المتحدة وأيرلندا ومعظم دول الكومنولث)",
 "commonwealth english spelling": "الإملاء البريطاني, التهجئة البريطانية (قواعد الإملاء الإنجليزية المستخدمة في المملكة المتحدة وأيرلندا ومعظم دول الكومنولث)",
 "commonwealth of australia": "كُومُنْوِلْث أُسْتُرَالِيَا",
 "commonwealth of independent states": "اِتِّحَاد اَلدُّوَل اَلْمُسْتَقِلَّة (اِتِّحَاد؛ الاتِّحاد الأوربيّ : (السياسة) اتِّحاد أوربيّ إقليميّ أنشئ بمقتضى معاهدة ماستريخت في عام 1993 م…)\nمثال: عاش الاتحاد السوفيتي!",
 "commonwealth of nations": "الكومنولث البريطاني, رابطة الشعوب البريطانية (رابطة دول تتكون من المملكة المتحدة والعديد من المستعمرات البريطانية السابقة التي أصبحت الآن دولاً ذات سيادة لكنها لا تزال تدين بالولاء للتاج البريطاني)",
 "commonwealth spelling": "الإملاء البريطاني, التهجئة البريطانية (قواعد الإملاء الإنجليزية المستخدمة في المملكة المتحدة وأيرلندا ومعظم دول الكومنولث)",
 "commotion": "جلبة, صخب (فعل إحداث اضطراب صاخب) / جلبة, دوامة (حركة مضطربة) / اضطراب, قلاقل (ثوران أو صخب غير منظم)\nمثال: كان عالقاً في دوامة من العمل",
 "communal": "جَمَاعِيّ, مُشْتَرَك (خاصّ بالجماعة وليس بالأفراد) / بلدي, محلي (يتعلق بمنطقة إدارية صغيرة أو مجتمع محلي)\nمثال: انتخابات بلدية في عدة دول أوروبية",
 "communalism": "طَائِفِيَّة, وَلَاء طَائِفِيّ (الولاء والالتزام بمصالح أقليتك أو مجموعتك العرقية بدلاً من المجتمع ككل) / مُشَاعِيَّة (ممارسة العيش المشترك والملكية المشتركة)",
 "communally": "بشكل مشاع, جماعياً (من قبل مجموعة من الناس بدلاً من فرد)\nمثال: كانت الطواحين مملوكة جماعياً",
 "commune": "مَشَاعِيَّة",
 "communicable": "قَابِلٌ لِلتَّوْصِيل, قَابِلٌ لِلنَّقْل (يسهل إيصاله ونقله إلى الآخرين) / سَارٍ, قَابِلٌ لِلِانْتِقَال ((في الأمراض) قابل للانتقال عن طريق العدوى)",
 "communicable disease": "مرض سار, مرض معد (مرض يمكن أن ينتقل من شخص لآخر)",
 "communicant": "متناول (شخص يحق له تناول القربان المقدس)",
 "communicate": "تَفَاهَمَ",
 "communicating": "اتصال, تواصل (نشاط التواصل؛ نشاط نقل المعلومات)\nمثال: لم يتمكنوا من التصرف دون اتصال رسمي من موسكو",
 "communicating artery": "شريان موصل (أي من ثلاثة شرايين في الدماغ تشكل دائرة ويليس)",
 "communication": "اِتِّصَالَات, اِتِّصَال / رِسَالَة, خَبَر",
 "communication channel": "خط اتصال, قناة اتصال ((غالباً الجمع) وسيلة للاتصال أو الوصول)\nمثال: يجب أن تمر عبر القنوات الرسمية",
 "communication equipment": "معدات اتصال, نظام اتصال (منشأة تتكون من المنشآت المادية والمعدات لنشر المعلومات)",
 "communication system": "معدات اتصال, نظام اتصال (منشأة تتكون من المنشآت المادية والمعدات لنشر المعلومات) / نظام اتصالات (نظام للتواصل)",
 "communication theory": "اتصالات, علوم الاتصال (التخصص الذي يدرس مبادئ نقل المعلومات وطرق إيصالها (مثل المطبوعات أو الراديو أو التلفزيون وما إلى ذلك))\nمثال: الاتصالات هي مجال دراسته الرئيسي",
 "communication trench": "خندق مواصلات (خندق يوفر ممراً محمياً بين الخطوط الخلفية والأمامية لموقع دفاعي)",
 "communicational": "اتِّصَالِيّ, تَوَاصُلِيّ (مُستخدَم في التواصل والاتصال)",
 "communications": "اتصالات, علوم الاتصال (التخصص الذي يدرس مبادئ نقل المعلومات وطرق إيصالها (مثل المطبوعات أو الراديو أو التلفزيون وما إلى ذلك))\nمثال: الاتصالات هي مجال دراسته الرئيسي",
 "communications intelligence": "استخبارات الاتصالات (معلومات تقنية واستخباراتية مستمدة من الاتصالات الأجنبية من قبل غير المستلمين المقصودين)",
 "communications protocol": "بْرُوتُوكُول, بْرُوتُوكُول اتِّصَالَات ((علم الحاسوب) قواعد تحدد تنسيق ونقل البيانات)",
 "communications satellite": "قمر صناعي للاتصالات (قمر صناعي ينقل الإشارات مرة أخرى إلى الأرض؛ يتحرك في مدار ثابت بالنسبة للأرض)",
 "communications security establishment": "مؤسسة أمن الاتصالات (وكالة كندية تجمع استخبارات الاتصالات وتساعد وكالات إنفاذ القانون والأمن)",
 "communications technology": "تكنولوجيا الاتصالات (نشاط تصميم وبناء وصيانة أنظمة الاتصالات)",
 "communicative": "تواصلي, صريح (قادر على التواصل أو يميل إليه) / تواصلي (من أو يتعلق بالتواصل)\nمثال: كانت شخصاً تواصلياً وسرعان ما أخبرت بكل ما تعرفه",
 "communicativeness": "انفتاح في الحديث, تواصل (سمة كون المرء متواصلاً)",
 "communicator": "مُبَلِّغ, مُتَوَاصِل (شخص يتواصل مع الآخرين)",
 "communicatory": "تواصلي, صريح (قادر على التواصل أو يميل إليه)\nمثال: كانت شخصاً تواصلياً وسرعان ما أخبرت بكل ما تعرفه",
 "communion": "تناول, قربان مقدس (فعل المشاركة في الاحتفال بالقربان المقدس (الإفخارستيا)) / تواصل روحي, مشاركة وجدانية (مشاركة الأفكار والمشاعر) / شركة دينية, طائفة ((المسيحية) مجموعة من المسيحيين لديهم إيمان ديني مشترك يمارسون نفس الطقوس)\nمثال: تناول الحاكم القربان المقدس مع بقية الرعية",
 "communion table": "مائدة القربان, مذبح (المائدة في الكنائس المسيحية حيث يتم تقديم القربان)",
 "communion wafer": "بُرْشام (برشم المسمار و نحوه؛ دق رأسه بعد نفاذه دقا شديدا ليتفلطح الرأس)",
 "communique": "برقية, بلاغ (تقرير رسمي (يرسل عادة على عجل))",
 "communiqué": "بَلَاغ",
 "communisation": "تأميم (تحويل شيء ما من الملكية الخاصة أو السيطرة الخاصة إلى ملكية الدولة) / تطبيق الشيوعية (تنظيم أمة على أساس الشيوعية) / إشاعة الملكية, تحويل للمشاع (تغيير من الملكية الخاصة إلى الملكية العامة المملوكة للمجتمع)",
 "communism": "شُيُوعِيَّة",
 "communist": "شُيُوعِيّ, شُيُوعِيَّة",
 "communist economy": "اقتصاد شيوعي (الاقتصاد الموجه لدولة شيوعية)",
 "communist party": "الحزب الشيوعي (حزب سياسي يدعو بنشاط إلى شكل شيوعي للحكومة؛ في الدول الشيوعية هو الحزب السياسي الوحيد للدولة)",
 "communistic": "شيوعي (متعلق بالشيوعية أو يتسم بها)\nمثال: الحزب الشيوعي",
 "community": "مُجْتَمَع, اِجْتِمَاع (قد يقصد به المكان الذي يجتمع فيه الناس؛ مجموعة من الناس من طبقة اجتماعية واحدة تختلط ببعضها ولها ما يميزها عن غيرها من المجموعات البشرية) / مِلَّة\nمثال: سامي خطر للمجتمع.",
 "community center": "مركز مجتمعي, مركز مدني (مركز يمكن لأعضاء المجتمع التجمع فيه لممارسة أنشطة اجتماعية أو ثقافية)",
 "community chest": "صندوق التبرعات المجتمعي (مؤسسة خيرية مدعومة باشتراكات فردية؛ تغطي نفقات مطالب المجتمع للرعاية الاجتماعية)",
 "community college": "كلية مجتمع (كلية متوسطة غير سكنية تقدم منهجاً يتناسب مع احتياجات المجتمع)",
 "community of interests": "مجتمع مصالح, وحدة مصالح (اتفاق بشأن الأهداف)\nمثال: وجد الوعاظ ومهربو الخمور أن لديهم وحدة مصالح",
 "community of scholars": "مجتمع العلماء (مجموعة الأفراد الحاصلين على درجات أكاديمية متقدمة)",
 "community property": "ملكية مشتركة (الممتلكات والدخل المملوك بشكل مشترك للزوجين)",
 "community service": "خدمة مجتمعية (خدمة غير مدفوعة الأجر لصالح الجمهور يؤديها مخالفو القانون كجزء من (أو كل) عقوبتهم) / خدمة عامة, خدمة مجتمعية (خدمة يتم أداؤها لصالح الجمهور أو مؤسساته)",
 "communization": "تأميم (تحويل شيء ما من الملكية الخاصة أو السيطرة الخاصة إلى ملكية الدولة) / تطبيق الشيوعية (تنظيم أمة على أساس الشيوعية) / إشاعة الملكية, تحويل للمشاع (تغيير من الملكية الخاصة إلى الملكية العامة المملوكة للمجتمع)",
 "commutability": "قَابِلِيَّة لِلتَّبْدِيل, قَابِلِيَّة لِلتَّحْوِيل (صفة القابلية للتبديل) / قَابِلِيَّة لِلاسْتِبْدَال (القابلية للتبادل بحكم كون الشيء قابلاً للاستبدال)",
 "commutable": "قَابِل لِلاِسْتِبْدَال, قَابِل لِلتَّخْفِيف (خاضع للتغيير أو الاستبدال) / قَابِل لِلإِبْدَال, قَابِل لِلاسْتِعَاضَة (يمكن مبادلته بآخر أو بشيء مكافئ له)\nمثال: كان حكم الإعدام قابلاً للتخفيف إلى السجن مدى الحياة",
 "commutation": "إحلال, استبدال (عملية وضع شيء أو شخص مكان آخر) / تنقل للعمل (سفر المتنقل للعمل) / تخفيف العقوبة ((قانون) تقليل شدة العقوبة التي يفرضها القانون) / أمر تخفيف العقوبة (مذكرة تستبدل عقوبة أخف بعقوبة أشد)",
 "commutation ticket": "تذكرة اشتراك, تذكرة موسمية (تذكرة صالحة لعدة رحلات أو لحضور موسم من الفعاليات الترفيهية؛ تباع بسعر مخفض)",
 "commutative": "تَبَادُلِيّ ((عَنْ عَمَلِيَّةٍ ثُنَائِيَّة) مُسْتَقِلٌّ عَنِ التَّرْتِيب)",
 "commutative group": "زمرة أبيلية, زمرة إبدالية (زمرة تحقق قانون التبادل)",
 "commutator": "مبدل كهربائي (مفتاح لعكس اتجاه التيار الكهربائي)",
 "commute": "تنقل يومي للعمل (رحلة منتظمة لمسافة ما من وإلى مكان عملك)\nمثال: يوجد مكان للوقوف فقط في رحلة التنقل عالية السرعة",
 "commuter": "قطار الركاب اليومي, قطار الضواحي (قطار ركاب يستخدمه في المقام الأول الركاب الذين يسافرون بانتظام (يومياً) من مكان إلى آخر) / مسافر يومي (شخص يسافر بانتظام من المنزل في الضاحية إلى العمل في المدينة)",
 "commuter traffic": "حركة الركاب اليومية (حركة المرور الناتجة عن الأشخاص الذاهبين إلى العمل أو العائدين منه)",
 "commuter train": "قطار الركاب اليومي, قطار الضواحي (قطار ركاب يستخدمه في المقام الأول الركاب الذين يسافرون بانتظام (يومياً) من مكان إلى آخر)",
 "commuting": "تنقل للعمل (سفر المتنقل للعمل)",
 "como": "كومو",
 "comoros": "جُزُر الْقُمُر (جَزَرَ الماءُ عن الأَرضِ يَجْزُرُ جَزْراً: نَضَبَ وحَسَرَ؛ ويقال: جَزَرَ البَحْرُ والنَّهْرُ: انْحسرَ ماؤُهُ)\nمثال: ضع الجزر في القدر.",
 "comose": "ذُو خُصْلَة, مُهَدَّب ((لبعض البذور كالقطن) ذو خصلة أو خصلات من الشعر) / ذُو هَامَة, مُكَلَّلٌ بِالأَوْرَاقِ (يحمل هامة؛ متوَّج بتجمُّع من الأغصان أو الأوراق أو القنابات)",
 "comp": "امتحان شامل (امتحان مكثف يختبر كفاءة الطالب في مجال معرفي خاص)\nمثال: أجرت امتحاناتها الشاملة في الأدب الإنجليزي",
 "compact": "كثيف, متراص (متحد بشكل وثيق وثابت أو معبأ معاً) / جَامِع, مُلَخَّص (يُقَدِّمُ خُلَاصَةَ الشَّيْءِ بِإِيجَازٍ) / مَتِين البُنْيَة, مُمْتَلِئ الجِسْم (ذو بنية قصيرة وصلبة) / علبة بودرة, مضغوطة تجميل (علبة مستحضرات تجميل صغيرة بمرآة؛ لتحمل في حقيبة المرأة)\nمثال: تربة متراصة",
 "compact car": "سيارة صغيرة, سيارة مدمجة (سيارة صغيرة واقتصادية)",
 "compact disc": "سِي دِي, قُرْص مَضْغُوط",
 "compact disc read-only memory": "سي دي روم, قرص مضغوط (قرص مضغوط يستخدم مع الحاسوب (بدلاً من النظام الصوتي)؛ يمكن تخزين كمية كبيرة من المعلومات الرقمية والوصول إليها ولكن لا يمكن للمستخدم تغييرها)",
 "compact disc recordable": "قرص مضغوط قابل للتسجيل (قرص مضغوط يمكنك الكتابة عليه مرة واحدة فقط وبعد ذلك يصبح ذاكرة للقراءة فقط)",
 "compact disc write-once": "قرص مضغوط قابل للتسجيل (قرص مضغوط يمكنك الكتابة عليه مرة واحدة فقط وبعد ذلك يصبح ذاكرة للقراءة فقط)",
 "compact disk": "قرص مضغوط (تسجيل مشفر رقمياً على قرص بصري أصغر من سجل الفونوغراف؛ يتم تشغيله بواسطة الليزر)",
 "compact fluorescent light": "مصباح فلوري مدمج, مصباح موفر للطاقة (مصباح ضوء فلوري يوفر الطاقة)",
 "compact mirror": "مرآة جيب, مرآة صغيرة (مرآة صغيرة محمولة باليد عادة ما تكون في علبة معدنية أو بلاستيكية مستديرة؛ تستخدم غالباً لتعديل المكياج خارج المنزل)",
 "compact powder": "بودرة مضغوطة (مسحوق تجميلي للوجه يتم تخزينه في علبة مضغوطة)",
 "compact-disk burner": "سي دي بيرنر, ناسخ أقراص مضغوطة (معدات تسجيل لعمل الأقراص المضغوطة)",
 "compaction": "جرش, سحق (فعل السحق) / تصلب, تكثيف (زيادة في كثافة شيء ما)",
 "compactly": "بِتَرَاصّ, بِشَكْل مَضْغُوط (بحيث لا يشغل مساحة أكبر من اللازم) / بِإِيجَاز بَلِيغ, بِاقْتِضَاب (بإيجاز دقيق ومحكم؛ في صلب الموضوع) / بِتَرَاصّ, بِشَكْل مُدْمَج (بطريقة أو حالة مضغوطة)\nمثال: طعام سائل مخزن بشكل مضغوط في خزان مضغوط",
 "compactness": "اِكْتِنَاز, اِلْتِزَاز",
 "compander": "ضاغط ممدد (نظام لتحسين نسبة الإشارة إلى الضوضاء لإشارة عند جهاز إرسال أو مسجل عن طريق ضغط نطاق حجم الإشارة أولاً ثم استعادته إلى مستوى السعة الأصلي عند جهاز…)",
 "companion": "صَاحِب, صَاحِبَة (اَلْمُرَافِق، الْمُلَازِمُ، وَلَا يُقَالُ عُرْفاً إِلَّا لِمَنْ كَثُرَتْ مُلَازَمَتُهُ؛ صَاحِبُ الشَّيْءِ: مَالِكُهُ)\nمثال: من صاحب هذه الأرض؟",
 "companionability": "حسن المعشر (الملاءمة ليكون المرء رفيقاً)",
 "companionable": "أَنِيس, مُؤْنِس (يوحي بالصُّحْبَة والمؤانسة)",
 "companionableness": "حسن المعشر (الملاءمة ليكون المرء رفيقاً)",
 "companionate": "رَفِيقِيّ (يُشْبِهُ الرَّفِيق فِي مُعَامَلَتِه)",
 "companionship": "رفقة, زمالة (حالة الوجود مع شخص ما)\nمثال: افتقد صحبتهم",
 "companionway": "سلم السفينة (سلم أو درج يؤدي من سطح إلى آخر على السفينة)",
 "company": "سَرِيَّة / شَرِكَة",
 "company man": "موظف مخلص للشركة (موظف ذكر ولاؤه الأول للشركة بدلاً من زملائه في العمل)",
 "company name": "اسم الشركة (الاسم الذي تُعرف به الشركة)",
 "company operator": "عامل شركة (مشغل يعمل لصالح شركة)",
 "company person": "موظف ولاؤه للشركة (موظف يكون ولاؤه الأول للشركة بدلاً من زملائه في العمل)",
 "company union": "نقابة تابعة للشركة (نقابة للعمال لشركة واحدة؛ نقابة غير تابعة لنقابة أكبر)",
 "company woman": "موظفة مخلصة للشركة (موظفة أنثى ولاؤها الأول للشركة بدلاً من زملائها في العمل)",
 "comparability": "قَابِلِيَّة لِلْمُقَارَنَة, مُضَاهَاة (السمات التي يمكن مقارنتها)\nمثال: لا توجد مقارنة بين الكتابين",
 "comparable": "قابل للمقارنة, مماثل (يمكن مقارنته أو يستحق المقارنة) / مُطَابِق, مُمَاثِل (مُتَوافِق من كلّ وجه)",
 "comparably": "بشكل مماثل, نسبياً (بطريقة مماثلة أو لدرجة مماثلة)\nمثال: سيتعين عليك العمل بجدية مماثلة",
 "comparative": "دَرَجَة نِسْبِيَّة",
 "comparative anatomist": "عالم تشريح مقارن (عالم تشريح يقارن بين تشريح الحيوانات المختلفة)",
 "comparative anatomy": "تشريح مقارن (دراسة السمات التشريحية للحيوانات من أنواع مختلفة)",
 "comparative degree": "صيغة المقارنة (صيغة المقارنة للصفة أو الظرف)\nمثال: 'أسرع' هي صيغة المقارنة للصفة 'سريع'",
 "comparative literature": "أدب مقارن (دراسة الأعمال الأدبية من ثقافات مختلفة (غالباً مترجمة))",
 "comparative negligence": "إهمال مشترك, إهمال نسبي ((قانون) إهمال موزع بين المدعي والمدعى عليه مع تخفيض مقابل في التعويضات المدفوعة للمدعي)",
 "comparative psychology": "علم النفس المقارن, علم نفس الحيوان (فرع علم النفس المعني بسلوك الحيوانات)",
 "comparatively": "نِسْبِيّاً",
 "compare": "قَارَنَ / شَبَّهَ",
 "comparing": "مقارنة (فعل فحص أوجه التشابه)\nمثال: أجروا مقارنة لمستويات الضوضاء",
 "comparison": "مُقَارَنَة / مُقَابَلَة / تَشْبِيه / مُقَايَسَة",
 "compartment": "مَقْصُورَة",
 "compartment pressure": "ضغط المقصورة (ضغط الهواء المحافظ عليه في مقصورة محكمة الإغلاق (كما في الطائرة))",
 "compartmental": "مُجَزَّأ, مُقَسَّم (مقسّم إلى حجيرات أو فئات)",
 "compartmentalisation": "تبويب, تصنيف (فعل توزيع الأشياء في فئات أو أصناف من نفس النوع) / تجزئة, تقسيم نفسي (حالة خفيفة من التفكك النفسي)",
 "compartmentalised": "مُجَزَّأ, مُقَسَّم (مقسّم إلى حجيرات أو فئات)",
 "compartmentalization": "تبويب, تصنيف (فعل توزيع الأشياء في فئات أو أصناف من نفس النوع) / تجزئة, تقسيم نفسي (حالة خفيفة من التفكك النفسي)",
 "compartmentalized": "مُجَزَّأ, مُقَسَّم (مقسّم إلى حجيرات أو فئات)",
 "compartmented": "مُقَسَّم إِلَى حُجَيْرَات (مقسم أو مفصول إلى حجيرات أو وحدات معزولة)\nمثال: صندوق مقسم",
 "compass": "بُوصُّلَة (البُوصَلَة أو البَوصَلَة : أَدَاة تسمَح بتحديد الاتجاهات)",
 "compass card": "قرص البوصلة, ورقة البوصلة (بوصلة على شكل بطاقة تدور بحيث تشير درجة الصفر أو الشمال إلى الشمال المغناطيسي)",
 "compass flower": "زهرة البوصلة, نبات البوصلة (أي من عدة نباتات تترتب أوراقها على المحور بحيث تشير إلى الاتجاهات الأصلية للبوصلة)",
 "compass north": "الشَّمَال, الشَّمَال المِغْنَاطِيسِيّ (الاتجاه الذي تشير إليه إبرة البوصلة)",
 "compass plane": "مِسْحَج دائري, مِسْحَج فرجاري (مسحج بوجه مرن يمكنه مسح الأسطح المقعرة أو المحدبة)",
 "compass plant": "زهرة البوصلة, نبات البوصلة (أي من عدة نباتات تترتب أوراقها على المحور بحيث تشير إلى الاتجاهات الأصلية للبوصلة) / لوتس البراري, نفل البراري (نبات حولي من أمريكا الشمالية بزهور حمراء أو وردية)",
 "compass point": "اِتِّجَاه البُوصِلَة, نُقْطَة البُوصِلَة (أي من الاتجاهات الأفقية الـ 32 المشار إليها على بطاقة البوصلة)\nمثال: فحص الاتجاه على بوصلته",
 "compass saw": "منشار منحنيات (منشار يدوي ذو نصل مثلث ضيق لقطع المنحنيات)",
 "compassion": "رَحْمَة / شَفَقَة (وشَفِقَ على؛ الرحمة والعَطْف والحَنَان والحُنُوّ)\nمثال: زيري مثير للشفقة.",
 "compassionate": "شَفَقَة (وشَفِقَ على؛ الرحمة والعَطْف والحَنَان والحُنُوّ)\nمثال: زيري مثير للشفقة.",
 "compassionate leave": "إجازة طارئة, إجازة مواساة ((عسكرية) إجازة تُمنح في حالات الطوارئ مثل مرض الأسرة أو الوفاة)",
 "compassionately": "بِإِشْفَاق (بطريقة متعاطفة)\nمثال: نظرت إليه الممرضة بإشفاق",
 "compassionateness": "رحمة, شفقة (وعي عميق بمعاناة الآخرين والتعاطف معهم)",
 "compatibility": "انسجام, توافق (القدرة على الوجود أو الأداء في مزيج متناغم) / توافق (شعور بالفهم المتعاطف)",
 "compatible": "متوافق, منسجم (قادر على الوجود والأداء في مزيج متناغم أو مقبول) / متوافق ((تقنياً) قابل للاستخدام مع أو الاتصال بأجهزة أو مكونات أخرى دون تعديل) / قَابِلٌ لِلمَزْج, مُتَجَانِس (قادر على تكوين خليط متجانس لا ينفصل ولا يتغيّر بالتفاعل الكيميائي)\nمثال: زوجان متوافقان",
 "compatible software": "برمجيات متوافقة (برمجيات يمكن تشغيلها على أجهزة حاسوب مختلفة دون تعديل) / برمجيات متوافقة (برامج تطبيقية تشترك في اصطلاحات مشتركة بحيث يمكن استخدامها معاً)",
 "compatibly": "بِانْسِجَام, بِتَوَافُق (مع التوافق)",
 "compatriot": "مُوَاطِن, مُوَاطِنَة (مَدَنِيّ؛ مُقِيم)\nمثال: أنا مواطن لبناني",
 "compeer": "قَرِين, كُفْؤ (شخص متساوٍ في المكانة مع آخر في مجموعة)",
 "compel": "أَكْرَهَ, أَجْبَرَ",
 "compelling": "قَاهِر, لَا يُقَاوَم (يميل إلى الإقناع بقوّة البرهان) / دَافِع, قَاهِر (يدفع أو يُرغم بقوة لا تُقاوم)",
 "compendious": "جَامِع, مُلَخَّص (يُقَدِّمُ خُلَاصَةَ الشَّيْءِ بِإِيجَازٍ)",
 "compendium": "مختصر شامل, موجز واف (ملخص موجز ولكنه شامل لعمل أكبر) / مجموعة (منشور يحتوي على مجموعة متنوعة من الأعمال)",
 "compensable": "مَأْجُور, مَدْفُوعُ الأَجْر (يُدْفَعُ مُقَابِلُهُ مَال)",
 "compensated": "بِرَاتِب, يَتَقَاضَى أَجْرًا (يَتَلَقَّى تَعْوِيضًا مَالِيًّا أَوْ مُؤَهَّلٌ لِذَلِك)",
 "compensating balance": "رَصِيد تَعْوِيضِيّ (حد أدنى من الرصيد الدائن قد يطلبه البنك من المقترض الاحتفاظ به كوديعة كشرط لمنح القرض)\nمثال: يزيد الرصيد التعويضي من سعر الفائدة الفعلي للبنك لأن المبلغ الصافي المقرض ينخفض ولكن الفائدة المدفوعة لا تتغير",
 "compensation": "تعويض (فعل التعويض عن خدمة أو خسارة أو إصابة) / تعويض (شيء (مثل المال) يُعطى أو يُستلم كدفعة أو تعويض (كما هو الحال عن خدمة أو خسارة أو إصابة)) / تعويض ((في الطب النفسي) آلية دفاع تخفي عيوبك غير المرغوب فيها عن طريق المبالغة في السلوكيات المرغوبة)",
 "compensation deal": "صفقة تعويض (تبادل يتلقى فيه المصدر بضائع من المستورد كجزء من الدفع)",
 "compensatory damages": "تعويضات تعويضية, تعويضات فعلية ((قانون) تعويض عن الخسائر التي يمكن إثبات حدوثها بسهولة والتي يحق للطرف المتضرر الحصول على تعويض عنها)",
 "compensatory spending": "إنفاق بالعجز (إنفاق الأموال التي تم جمعها عن طريق الاقتراض؛ تستخدمه الحكومات لتحفيز اقتصادها)",
 "compensatory time": "وقت تعويضي (إجازة تُمنح للعامل كتعويض عن العمل الإضافي)",
 "compere": "مقدم العروض (مصطلح بريطاني للشخص الذي يقدم الفقرات التلفزيونية أو عروض الملاهي وما إلى ذلك)",
 "compete": "تَنَافَسَ, تَبَارَى",
 "competence": "أهلية, جدارة (صفة التمتع بالمؤهلات البدنية والفكرية الكافية)",
 "competence hearing": "جلسة تحديد الأهلية (جلسة استماع لتحديد الأهلية القانونية (لتحديد ما إذا كان المدعى عليه يستطيع فهم التهم والتعاون مع محام في إعداد الدفاع))",
 "competency": "أهلية, جدارة (صفة التمتع بالمؤهلات البدنية والفكرية الكافية)",
 "competent": "كَفُوء, مُلَائِم (كافٍ لكنّه ليس متميّزًا أو استثنائيًّا) / كفء, مؤهل (مؤهل بشكل صحيح أو كافٍ أو قادر أو فعال) / ذو أهلية قانونية, مختص (مؤهل قانونياً أو كافٍ من الناحية القانونية)\nمثال: طابع كفء",
 "competently": "باقتدار, بكفاءة (مع كفاءة؛ بطريقة مقتدرة)\nمثال: عملوا بكفاءة",
 "competition": "مُنَافَسَة, مُبَارَاة / مُنَافَسَة, مُسَابَقَة",
 "competitive": "تَنَافُسِيّ",
 "competitive advantage": "اِمْتِيَازٌ تَنَافُسِيٌّ",
 "competitively": "تَنَافُسِيًّا (في إطار المنافسة)\nمثال: يجب أن تقدم الشركات عطاءات تنافسية",
 "competitiveness": "تنافسية (رغبة عدوانية في المنافسة)\nمثال: كان الفريق مليئاً بالتنافسية",
 "competitor": "مُنَافِس",
 "competitor analysis": "تحليل المنافسين (في التسويق والإدارة الاستراتيجية، تقييم لنقاط القوة والضعف لدى المنافسين الحاليين والمحتملين)\nمثال: إذا كنت تنظر إلى مجال اتصالات محدد، مثل موقع ويب، قم بإجراء تحليل للمنافسين لذلك بمزيد من التفصيل",
 "competitory": "تنافسي (ينطوي على منافسة أو روح تنافسية)\nمثال: ألعاب تنافسية",
 "compilation": "تأليف, تجميع (فعل التجميع (كما في كتاب واحد أو ملف أو قائمة)) / تجميع, مصنف (شيء تم تجميعه (كما في كتاب واحد أو ملف))\nمثال: استغرقت وظيفة تجميع المخزون عدة ساعات",
 "compile": "تجميع (مصدر جَمَّعَ)",
 "compiler": "مترجم, مترجم برمجي ((علم الحاسوب) برنامج يفك شيفرة التعليمات المكتوبة بلغة عالية المستوى وينتج برنامجاً بلغة التجميع) / جامع, مجمع (شخص يجمع المعلومات (لأغراض مرجعية مثلاً))",
 "compiling": "تأليف, تجميع (فعل التجميع (كما في كتاب واحد أو ملف أو قائمة))\nمثال: استغرقت وظيفة تجميع المخزون عدة ساعات",
 "compiling program": "مترجم, مترجم برمجي ((علم الحاسوب) برنامج يفك شيفرة التعليمات المكتوبة بلغة عالية المستوى وينتج برنامجاً بلغة التجميع)",
 "complacence": "رضا عن الذات, غرور (الشعور الذي ينتابك عندما تكون راضياً عن نفسك)\nمثال: كان رضاه عن نفسه مثيراً للاشمئزاز تماماً",
 "complacency": "رضا عن الذات, غرور (الشعور الذي ينتابك عندما تكون راضياً عن نفسك)\nمثال: كان رضاه عن نفسه مثيراً للاشمئزاز تماماً",
 "complacent": "رَاضٍ عَنْ نَفْسِهِ, مُتَرَاخٍ (رَاضٍ عَنْ ذَاتِهِ أَوْ أَفْعَالِهِ إِلَى حَدِّ الخَلَلِ)",
 "complacently": "بِاقْتِنَاع ذَاتِيّ, بِرِضًا عَن النَّفْس (بطريقة راضية عن النفس)\nمثال: عاش حياته برضا عن النفس كمعلم في مدرسة قروية",
 "complain": "تَذَمَّرَ, اِشْتَكَى / شَكَا, اِشْتَكَى (تَأَلَّمَ مِنْ مَرَضٍ أو هَمٍّ وَنَحْوِهِ؛ أَظْهَرَ)",
 "complainant": "شَاكٍ",
 "complainer": "شَاكٍ",
 "complainingly": "بِتَذَمُّر, بِشَكْوَى (مع الشكاوى)\nمثال: قامت بعملها، لكنها فعلت ذلك بتذمر",
 "complaint": "شِكَايَة, شَكْوَى",
 "complaintive": "شاكٍ, متذمر (يعبر عن الألم أو عدم الرضا أو الاستياء)\nمثال: رئيس كثير الشكوى",
 "complaisance": "إذعان, امتثال (استعداد أو ميل للخضوع لإرادة الآخرين)",
 "complaisant": "خَدُوم, مُجَامِل (يُبدي استعدادًا سَمْحًا لتقديم خدمات للآخرين)",
 "complement": "عُمْدَة",
 "complement fixation": "تثبيت المتممة (استجابة مناعية يقوم فيها مزيج مولد الضد والجسم المضاد بتثبيط المتممة (بحيث تكون غير متاحة للمشاركة في مزيج آخر من مولد الضد والجسم المضاد))",
 "complement fixation test": "اختبار تثبيت المتممة (فحص دم تتعرض فيه عينة من المصل لمستضد معين ومتممة لتحديد ما إذا كانت الأجسام المضادة لذلك المستضد موجودة أم لا)",
 "complemental": "تَكْمِيلِيّ, مُكَمِّل (يعمل كمُكمِّل لشيء يُتمِّم الكلّ)",
 "complementarity": "تَكَامُل (ترابط التبادلية حيث يكمل شيء شيئاً آخر أو يعتمد عليه) / تَكَامُل (علاقة بين حالتين أو مبدأين متعاكسين يستنفدان معاً الاحتمالات)\nمثال: تكامل الجنسين",
 "complementary": "تَكْمِيلِيّ, مُكَمِّل (يعمل كمُكمِّل لشيء يُتمِّم الكلّ) / تَكَامُلِيّ ((للكلمات أو القضايا) مترابطة بحيث كل منها نفي للآخر) / لون مكمل (أحد لونين لونيين يعطيان عند مزجهما معاً اللون الأبيض (في حالة الأضواء) أو الرمادي (في حالة الأصباغ))\nمثال: الأصفر والأزرق لونان مكملان",
 "complementary angles": "زَاوِيَتَانِ مُتَتَامَّتَانِ",
 "complementary close": "خَاتِمَة الرِّسَالَة, عِبَارَة الْخِتَام (الكلمات (مثل المخلص لكم) التي تأتي تقليدياً قبل التوقيع في الرسالة مباشرة وتعبر عن احترام المرسل للمستلم)\nمثال: على الرغم من أن خاتمة الرسالة ليست مطلوبة، إلا أنها شبه قياسية في رسائل البريد الإلكتروني المهنية",
 "complementary color": "لون مكمل (أحد لونين لونيين يعطيان عند مزجهما معاً اللون الأبيض (في حالة الأضواء) أو الرمادي (في حالة الأصباغ))\nمثال: الأصفر والأزرق لونان مكملان",
 "complementary distribution": "تَوْزِيع تَكَامُلِيّ ((اللغويات) توزيع أصوات أو أشكال الكلام ذات الصلة بطريقة تجعلها تظهر فقط في سياقات مختلفة)",
 "complementary dna": "حمض نووي مكمل (حمض نووي أحادي الشريط مكمل للحمض النووي الريبوزي الرسول أو حمض نووي تم تصنيعه من الحمض النووي الريبوزي الرسول بواسطة النسخ العكسي)",
 "complementary medicine": "طب تكميلي (ممارسة الطب التي تجمع بين الطب التقليدي والطب البديل)",
 "complementation": "تَوْزِيع تَكَامُلِيّ ((اللغويات) توزيع أصوات أو أشكال الكلام ذات الصلة بطريقة تجعلها تظهر فقط في سياقات مختلفة) / تَتْمِيم, تَكْمِلَة (العلاقة النحوية لكلمة أو عبارة بمسند)",
 "complete": "اِنْتَهَى, أَكْمَلَ (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات) / كَامِل / ذَرِيع\nمثال: انتهى أمر زيري.",
 "complete blood count": "تعداد الدم الكامل (عد عدد خلايا الدم البيضاء والحمراء والصفائح الدموية في 1 ملليمتر مكعب من الدم)",
 "complete fracture": "كسر كامل (كسر يشمل كامل عرض العظم)",
 "completed": "مُحَقَّق, مُنْجَز (تمّ إنجازه أو إتمامه بنجاح) / مُكْتَمِل, مُلْتَقَط (تمّ التقاطه بنجاح (في كرة القدم الأمريكية)) / مُكْتَمِلُ الدُّخُولِ ((عَنِ الزَّوَاجِ) اكْتَمَلَ بِأَوَّلِ عَلَاقَةٍ جِنْسِيَّةٍ بَعْدَ المَرَاسِمِ)",
 "completely": "تَمَامًا",
 "completeness": "اكْتِمَال, تَمَام ((منطق) سمة لنظام منطقي مكون بحيث ينشأ تناقض إذا تم إدخال أي قضية لا يمكن اشتقاقها من بديهيات النظام) / تمام, كمال (حالة كونه كاملاً وتاماً؛ امتلاك كل ما هو مطلوب)",
 "completing": "تَكْمِيلِيّ, مُكَمِّل (يعمل كمُكمِّل لشيء يُتمِّم الكلّ)",
 "completion": "إتمام, إكمال (إجراء ختامي أو نهائي) / تمريرة ناجحة ((كرة القدم الأمريكية) تمريرة أمامية ناجحة في كرة القدم)",
 "complex": "مَعْقِد / عُقْدَة",
 "complex absence": "غيبة معقدة (نوبة غياب مصحوبة بتشوهات أخرى (فقدان التوتر العضلي أو حركات آلية أو تغيرات وعائية حركية))",
 "complex body part": "بِنْيَة جِسْمِيَّة, تَرْكِيب تَشْرِيحِيّ (جزء تشريحيّ معقّد من كائن حيّ وطريقة بنائه وترتيبه)",
 "complex conjugate": "مُرَافِق, مُرَادِف",
 "complex fraction": "كَسْر مُرَكَّب (كسر يحتوي على كسور في بسطه أو مقامه)",
 "complex instruction set computer": "حاسوب بمجموعة تعليمات معقدة, سيسك ((علم الحاسوب) نوع من معمارية الحاسوب يحتوي على عدد كبير من التعليمات المرمزة في شريحة المعالج المركزي)",
 "complex instruction set computing": "حاسوب بمجموعة تعليمات معقدة, سيسك ((علم الحاسوب) نوع من معمارية الحاسوب يحتوي على عدد كبير من التعليمات المرمزة في شريحة المعالج المركزي)",
 "complex number": "عَدَد عَقَدِيّّ, عَدَد مُرَكِّب (مِقْدَار مَا يُعَدّ)\nمثال: كم عدد سكان الجزائر؟",
 "complex plane": "المستوى المركب (تمثيل هندسي للأعداد المركبة يتكون من المحور الحقيقي والمحور التخيلي المتعامد)",
 "complex preposition": "حرف جر مركب (حرف جر يتكون من مجموعة كلمات تعمل كوحدة واحدة)",
 "complex quantity": "عَدَد تَخَيُّلِيّ, عَدَد عُقَدِيّ (مِقْدَار مَا يُعَدّ)\nمثال: كم عدد سكان الجزائر؟",
 "complex sentence": "جملة مركبة, جملة معقدة (جملة تتكون من جملة رئيسية واحدة وجملة تابعة واحدة على الأقل)",
 "complexifier": "مُعَقِّد لِلْأُمُور (شخص يجعل الأمور معقدة)",
 "complexion": "بَشْرَة",
 "complexity": "تَعْقِيد",
 "complexly": "بشكل معقد (بطريقة معقدة)",
 "complexness": "تَعْقِيد (صفة كون الشيء معقداً ومركباً)\nمثال: استمتع بتعقيد أجهزة الكمبيوتر الحديثة",
 "compliance": "اِسْتِسْلَام, خُضُوع (فعل الخضوع؛ عادة تسليم السلطة لآخر) / اِمْتِثَال, تَوَافُق (التصرف وفقاً لمعايير معينة مقبولة) / إذعان, امتثال (استعداد أو ميل للخضوع لإرادة الآخرين)\nمثال: بياناتهم المالية متوافقة مع الممارسات المحاسبية المقبولة عموماً",
 "compliancy": "إذعان, امتثال (استعداد أو ميل للخضوع لإرادة الآخرين)",
 "compliant": "مذعن, مطاوع (يميل إلى الامتثال)\nمثال: أطفال ممتثلون لإرادة الوالدين",
 "complicate": "تَعَقَّدَ, عَقَّدَ",
 "complicated": "مُعَقَّد, مُرَكَّب",
 "complicatedness": "تَشَابُك, تَعْقِيد (تعقيد محير)",
 "complication": "تَعْقِيد / مُضَاعَفَة",
 "complicit": "مُتَوَاطِئ, مُشَارِك",
 "complicity": "تواطؤ (الذنب كشريك في جريمة أو مخالفة)",
 "compliment": "مَدْحَة / مَدَحَ",
 "complimentariness": "إطراء, مدح (الحالة أو الصفة التي تكون بطبيعتها تعبيراً عن الثناء أو التهنئة أو التشجيع أو الاحترام)\nمثال: السيد بورجيه يطري كثيراً على هؤلاء الكتاب؛ لكنه غامض ببراعة في إطرائه",
 "complimentary": "إِطْرَائِيّ",
 "compliments": "تَحِيَّات, تَمَنِّيَات (تعبير مهذب عن الرغبة في رفاهية شخص ما)\nمثال: أبلغه تحياتي الطيبة",
 "complin": "صلاة النوم (آخر الساعات القانونية السبع قبل النوم مباشرة)",
 "compline": "صلاة النوم (آخر الساعات القانونية السبع قبل النوم مباشرة)",
 "component": "مُكَوِّن, جُزْء",
 "component part": "جُزْء, عُنْصُر (شيء يُحدَّد بالنسبة إلى شيء أكبر يشتمل عليه)",
 "comportment": "سلوك, هيئة (أسلوب أو سلوك وقور)",
 "compos mentis": "عاقِل (من له عَقْل يعقل به، يطلق على الإنسان وغيره إن كان يعقل؛ ذو النُهَى والرَأي السديد. هذه من الألفاظ التي يستوي فيها الذكر والأنثى)\nمثال: لا عاقل يفعل ذلك.",
 "compose": "أَلَّفَ (العدد الذي يساوي عَشْر مِئَات. يُذَكَّر بإعتبار لفظه المذكر وإذا كان عن النُقُود يؤنث بإعتبار أن النقود مؤنثه)\nمثال: ألف شكر على لطفك.",
 "composed": "رابط الجأش, رزين (يتمتع بضبط النفس والهدوء وخلو من الاضطراب خاصة في أوقات التوتر)\nمثال: بدت المؤدية رابطة الجأش تماماً وهي تصعد إلى المسرح",
 "composedly": "بِتَمَالُك لِلنَّفْس, بِرَبَاطَة جَأْش (بطريقة تتسم برباطة الجأش والتمالك)\nمثال: أعلن وفاة والده برباطة جأش",
 "composedness": "رباطة جأش, رزانة (حالة إظهار الهدوء والاتزان)\nمثال: قد أضيف أيضًا كحاشية لهذه الحجة الحالية، هدوء ورباطة جأش روح الرجل الصالح في مواجهة جميع المضايقات الخارجية",
 "composer": "مُلَحِّن / مُؤَلِّف مُوسِيقِيّ",
 "composing": "تأليف موسيقي, تلحين (الإبداع الموسيقي) / تَأْلِيف, تَرْكِيب (الخاصية المكانية الناتجة عن ترتيب الأجزاء فيما يتعلق ببعضها البعض وبالكل)\nمثال: التكوين المتناغم ضروري في الأعمال الفنية الجادة",
 "composite": "مُؤَلَّف, مُرَكَّب (يَتَكَوَّن مِنْ أَجْزَاء مُنْفَصِلَة مُتَرَابِطَة) / مركب (من أو متعلق بـ أو ينتمي إلى الفصيلة النباتية المركبة) / مجمع, مركب (كل مفاهيمي مكون من أجزاء معقدة ومترابطة) / نبات مركب, نجميات (تعتبر النباتات ثنائية الفلقة الأكثر تطوراً، وتتميز بزهيرات مرتبة في رؤوس كثيفة تشبه الزهور المفردة)\nمثال: أنشأ مجمع مراكز التسوق والمنازل والطرق مدينة جديدة",
 "composite material": "مادة مركبة (مادة خفيفة الوزن وقوية تم تطويرها في المختبر؛ يتم فيها ربط ألياف من أكثر من نوع معاً كيميائياً)",
 "composite number": "عَدَد غَيْر أَوَّلِيّ (مِقْدَار مَا يُعَدّ)\nمثال: كم عدد سكان الجزائر؟",
