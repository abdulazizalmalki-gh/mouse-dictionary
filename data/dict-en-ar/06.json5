 "conferva": "كونفيرفا (أي من الطحالب المختلفة من جنس تريبونيما؛ طحالب ذات خيوط متفرعة تشكل زبداً في المياه العذبة الساكنة أو الراكدة)",
 "confervoid algae": "طحالب شبيهة بالكونفيرفا (طحالب تشبه الكونفيرفا خاصة في امتلاكها خيوط متفرعة)",
 "confess": "اِعْتَرَفَ, أَقَرَّ",
 "confessedly": "باعتراف الجميع, صحيح أن (كما هو معترف به)\nمثال: صحيح أنها الأذكى في فصلها",
 "confession": "إِقْرَار, اِعْتِرَاف / طَائِفَة (مؤنث طَائِف؛ التي تطوفُ؛ القطعة أو الجزء من الشيء أو الواحدة منه)",
 "confession of judgement": "إقرار بحكم, اعتراف بالدين (حكم يتم إدخاله بعد اعتراف كتابي من المدين دون تكلفة الإجراءات القانونية العادية)",
 "confession of judgment": "إقرار بحكم, اعتراف بالدين (حكم يتم إدخاله بعد اعتراف كتابي من المدين دون تكلفة الإجراءات القانونية العادية)",
 "confessional": "كرسي الاعتراف, كشك الاعتراف (كشك يجلس فيه الكاهن لسماع الاعترافات)",
 "confessor": "المُعَرِّف, كاهن الاعتراف (كاهن يستمع إلى الاعتراف ويمنح الغفران) / معترف (شخص يعترف (يكشف معلومات تضر بنفسه))",
 "confetti": "نِثَار",
 "confidant": "أمين سر, خليل (شخص يُؤتمن على الأمور الخاصة)",
 "confidante": "كاتمة أسرار (أنثى يُؤتمن على الأسرار)",
 "confide": "نَاجَى",
 "confidence": "ثِقَة",
 "confidence game": "احتيال, خديعة الثقة (عملية نصب تغش فيها في القمار أو تقنع شخصاً بشراء ممتلكات لا قيمة لها)",
 "confidence man": "محتال, مخادع (محتال ذكر يستغل ثقة ضحيته)",
 "confidence trick": "احتيال, خديعة الثقة (عملية نصب تغش فيها في القمار أو تقنع شخصاً بشراء ممتلكات لا قيمة لها)",
 "confidence woman": "محتالة, مخادعة (امرأة محتالة تستغل ثقة ضحيتها)",
 "confident": "وَاثِق / مُتَأَكِّد",
 "confidential": "سَرِّيّ, خُصُوصِيّ",
 "confidential adviser-advisee relation": "عَلَاقَة المُسْتَشَار بِالمُسْتَشِير (مسؤولية المستشار السري في التصرف بما يخدم مصلحة المستشير)",
 "confidential information": "تَلْمِيح, طَرَف خَيْط (إشارة إلى فرصة محتملة)\nمثال: حصل على نصيحة حول سوق الأسهم",
 "confidentiality": "سرية, كتمان (التكتم في حفظ المعلومات السرية) / خصوصية, سرية (حالة كونه سرياً)\nمثال: يجب عليك احترام سرية اتصالات عميلك",
 "confidentially": "بشكل سري, سراً (بطريقة سرية)\nمثال: تحدث إليه بشكل سري",
 "confidently": "بثقة\nمثال: علينا أن نفعل ما هو صواب بثقة",
 "confiding": "مُفْضٍ بِأَسْرَارِه (مستعد لائتمان الآخرين على أموره الشخصية)",
 "confidingly": "بِاطْمِئْنَان, بِثِقَة (مع الثقة؛ بطريقة واثقة)\nمثال: نظرت إلى والدها بثقة",
 "configuration": "تَهايُؤ",
 "configurational": "بنيوي, تشكيلي (من أو متعلق بـ أو يتميز بالتشكيل (الترتيب البنيوي))",
 "configurational isomer": "متصاوغ تكويني (متصاوغ فراغي لا يمكن تحويله إلا بكسر الروابط التساهمية في المركز المجسم)",
 "configurationism": "علم نفس الجشطالت, نظرية التكوين ((علم النفس) نظرية في علم النفس تؤكد على أهمية الخصائص التكوينية الكلية)",
 "configured": "ذُو تَكْوِين, مُهَيَّأ (منظم بحيث يُعطي شكلاً أو تكويناً محدداً)",
 "confined": "محبوس, مقيد (غير حر في التحرك) / أَسِير, سَجِين (فِي حَالَة أَسْر أَوِ احْتِجَاز) / غير غازٍ, محصور (لا يغزو الأنسجة السليمة)",
 "confinement": "حبس, حجز (فعل تقييد حرية شخص ما عن طريق حبسه) / تقييد, حصر (فعل إبقاء شيء ما ضمن حدود محددة) / احتجاز, حبس (حالة كونه محتجزاً) / طلق, مخاض (المرحلة الختامية للحمل؛ من بداية الانقباضات حتى ولادة الطفل)\nمثال: حصر العدوى في منطقة بؤرية",
 "confines": "حدود, نطاق محصور (نطاق محدود)\nمثال: بقي داخل حدود المدينة",
 "confining": "حَاصِر, ضَيِّق (مُكْتَظٌّ وَمَحْدُودُ المَسَاحَةِ) / حَاصِر, مُقَيِّد (يُقيِّد نطاق العمل أو حرية الحركة)",
 "confirm": "أَكَّدَ, أَثْبَتَ (أكَّد الخبرَ ونحوه :صرّح بصحَّته؛ أَكَدَّ : قَرَّرَ، أَثْبَتَ، وثَّقَ)\nمثال: أكد صمته شكوكها",
 "confirmable": "قَابِلٌ لِلتَّحَقُّق, قَابِلٌ لِلتَّكْذِيب (يمكن اختباره (التحقّق منه أو تكذيبه) بالتجربة أو الملاحظة)",
 "confirmation": "تَأْكِيد / سِرّ المَيْرُون (شَعَرَ بِالسُّرُورِ)\nمثال: السر سيبقى سرا.",
 "confirmation hearing": "جلسة إقرار التعيين, جلسة تثبيت (جلسة استماع يعقدها مجلس الشيوخ الأمريكي لجمع معلومات حول الموافقة أو رفض المرشحين للمناصب الفيدرالية العليا الذين يرشحهم الرئيس)",
 "confirmative": "تَأْكِيدِيّ, مُؤَيِّد (يُستخدم لدعم أو تأييد أو تأكيد صحة شيء)",
 "confirmatory": "تَأْكِيدِيّ, مُؤَيِّد (يُستخدم لدعم أو تأييد أو تأكيد صحة شيء)",
 "confirmed": "رَاسِخ, مُتَأَصِّل ((للأشخاص) غير قابل للتغيير في طبعه) / مؤكد, مثبت (تم إقراره أو جعله ثابتاً أو تلقى طقس التثبيت الكنسي)\nمثال: حجوزات مؤكدة",
 "confirming": "إيجابي (يشير إلى وجود حالة أو مسبب مرض مشتبه به) / تَأْكِيدِيّ, مُؤَيِّد (يُستخدم لدعم أو تأييد أو تأكيد صحة شيء)\nمثال: اختبار حمل إيجابي",
 "confiscate": "صَادَرَ",
 "confiscation": "مُصَادَرَة, اِسْتِيلَاء (دُفْعَة مالية منتزَعة عن طريق الحكومة في أوقات الحرب؛ عِقاب موضوعه اِسْتِصْفَاء مال المحكوم عليه واِسْتِيلَاء الدّولة عليه)",
 "confit": "كونفيه, لحم محفوظ في دهنه (قطعة من اللحم (وخاصة البط) مطهية ببطء في دهنها الخاص)",
 "confiture": "فاكهة محفوظة, مربى (فاكهة محفوظة أو مسكرة)",
 "conflagration": "حَرِيق (النَار المشتعلة في شيء كالدَار او الغَابَة)\nمثال: أين هو الحريق إذا؟",
 "conflict": "صِرَاع, نِزَاع",
 "conflict of interest": "تَضَارُب مَصَالِح",
 "conflicting": "مُتَضَارِب, مُتَنَاقِض (فِي حَالَةِ خِلَافٍ أَوْ تَعَارُضٍ) / مُتَضَارِب, مُتَنَاقِض (في علاقة سيئة أو خلافية)",
 "confluence": "احتشاد, تجمهر (تجمع الناس معاً) / التقاء, تلاق (التدفق معاً في مجرى واحد) / ملتقى النهرين, نقطة التقاء (مكان تندمج فيه الأشياء أو تتدفق معًا (خاصة الأنهار))\nمثال: تقع بيتسبرغ عند نقطة التقاء نهري أليغيني ومونونغاهيلا",
 "confluent": "مُلْتَقٍ, مُنْدَمِج (يَتَدَفَّقُ مَعًا فِي مَجْرًى وَاحِد) / رافد (فرع يصب في المجرى الرئيسي)",
 "conflux": "التقاء, تلاق (التدفق معاً في مجرى واحد)",
 "conformable": "مُتَوَافِق, مُنْسَجِم (مُتَّسِقٌ وَمُتَنَاسِقٌ) / قَابِلٌ لِلامْتِثَال, مُطَاوِع (مُسْتَعِدٌّ لِلامْتِثَالِ وَالتَّكَيُّف) / سَرِيع الاسْتِجَابَة, مُمْتَثِل (سريع الامتثال والانصياع)",
 "conformably": "بشكل متوافق, بشكل مطابق (بطريقة متوافقة أو مطابقة)",
 "conformal projection": "إسقاط متشاكل, إسقاط مطابق (إسقاط خرائطي يتم فيه رسم منطقة صغيرة بشكلها الحقيقي)",
 "conformance": "امتثال, توافق (التطابق في الشكل أو المظهر)",
 "conformation": "اِمْتِثَال, تَوَافُق (التصرف وفقاً لمعايير معينة مقبولة) / بنية, تكوين (أي سمات مكانية (خاصة كما يحددها المخطط الخارجي)) / بنية, تشكيل (ترتيب متماثل لأجزاء الشيء)\nمثال: بياناتهم المالية متوافقة مع الممارسات المحاسبية المقبولة عموماً",
 "conformational entropy": "إنتروبيا تشكيلية (الإنتروبيا المحسوبة من احتمالية الوصول إلى حالة عن طريق الصدفة وحدها)",
 "conforming": "مُلْتَزِم, مُمْتَثِل (يتمسك بالعادات أو المذاهب الراسخة خاصة في الدين)",
 "conformism": "امتثال, مسايرة (الالتزام بالمعايير التقليدية في الأفكار والمعتقدات)",
 "conformist": "اتباعي, مساير (يتميز بالعرف والامتثال للعادات أو القواعد أو الأنماط) / مُلْتَزِم, مُمْتَثِل (يتمسك بالعادات أو المذاهب الراسخة خاصة في الدين) / ملتزم, ممتثل (شخص يمتثل لمعايير السلوك الراسخة (خاصة في الأمور الدينية))\nمثال: تحت المظهر الراديكالي، المراهقون ممتثلون (للأعراف) بشكل مدهش",
 "conformity": "اِمْتِثَال, تَوَافُق (التصرف وفقاً لمعايير معينة مقبولة) / امتثال, توافق (التطابق في الشكل أو المظهر) / امْتِثَال, تَحَجُّر (تقليدية متصلبة) / امتثال, مسايرة (الالتزام بالمعايير التقليدية في الأفكار والمعتقدات)\nمثال: بياناتهم المالية متوافقة مع الممارسات المحاسبية المقبولة عموماً",
 "confound": "أَخْزَى (أَخْزَى: (فعل) أخزَى يُخزي ، أخْزِ ، إخزاءً ، فهو مُخْزٍ ، والمفعول مُخزًى)",
 "confounded": "تَائِه, مَذْهُول (في حيرة شديدة بسبب كثرة التناقضات؛ مرتبك ومشوّش الذهن)",
 "confoundedly": "بارتباك, بحيرة (بطريقة محتارة)\nمثال: نظر إلى أستاذه بحيرة",
 "confounding": "مُرْبِك, مُنَاقِض (يُسبب الحيرة أو يناقض أو يُشوش)",
 "confrere": "زَمِيل (شخص عضو في نفس مهنة أو طبقة الشخص الآخر)\nمثال: استشار الجراح زملاءه",
 "confront": "وَاجَهَ (تَقَابَلَ معه وَجها لوجه؛ الجندي العدو: استقبله مواجهة ليقاتله أو يناضل ضده)\nمثال: واجه سامي ليلى.",
 "confrontation": "مُوَاجَهَة, مُجَابَهَة",
 "confrontational": "صدامي, مواجهي (من أو متعلق بالمواجهة أو الصدام)",
 "confucian": "كونفوشيوسي (متعلق بالكونفوشيوسية أو مميز لها) / كونفوشيوسي (مؤمن بتعاليم كونفوشيوس)\nمثال: أخلاق كونفوشيوسية",
 "confucianism": "كُونْفُوشِيَّة, كُونْفُشْيُوسِيَة",
 "confucianist": "كونفوشيوسي (مؤمن بتعاليم كونفوشيوس)",
 "confucius": "كُونْفُوشِيُوس",
 "confusable": "قَابِلٌ لِلخَلْط, مُلْتَبِس (شديد الشبه بحيث يسهل الخلط بينه وبين شيء آخر)",
 "confuse": "أَرْبَكَ",
 "confused": "اِحْتَارَ / تَشَوَّش / اِرْتَبَكَ, تَشَوَّش",
 "confusedly": "بِارْتِبَاك, بِتَشَوُّش (بطريقة مرتبكة)\nمثال: كتبت له الملكة أوغوستا رسالة هستيرية تعاطفت معه فيها بارتباك",
 "confusedness": "ارتباك, تشوش (حالة عقلية تتميز بنقص في وضوح الفكر والسلوك ونظامهما)\nمثال: تشوش في الانطباعات",
 "confusing": "مُرْبِك",
 "confusingly": "بشكل محير, بشكل مربك (بطريقة محيرة ومربكة)\nمثال: كان وضعها غير واضح بشكل محير",
 "confusion": "اِلْتِبَاس / اِرْتِبَاك (ارتبك الأمر:اختلط عليه ، وفي الوحْل :نَشَبَ فيه وعَلِق ،وفي الأمر:وقع فيه ولم يكد يتخلّص منه؛ ارتبك في كلامه:إذا تَتَعْتَعَ، وارتبك الصّيد في الْحِبَالَة:اِضْطَرَب)\nمثال: لا داعي لارتباك.",
 "confutable": "قَابِلٌ لِلتَّفْنِيد, قَابِلٌ لِلدَّحْض (يُمْكِنُ دَحْضُهُ أَوْ تَفْنِيدُهُ)",
 "confutation": "إفحام, تفنيد (دليل يدحض بشكل قاطع) / إفحام, دحض قاطع (الفعل الكلامي للدحض بشكل قاطع)",
 "confutative": "قَابِلٌ لِلتَّفْنِيد, قَابِلٌ لِلدَّحْض (يُمْكِنُ دَحْضُهُ أَوْ تَفْنِيدُهُ)",
 "confuter": "مُدْحِض, مُفَنِّد (مناظر يدحض أو يفند من خلال تقديم أدلة أو حجج معاكسة)",
 "conga": "كونغا (رقصة من أمريكا اللاتينية تتكون من 3 خطوات وركلة يؤديها الناس في طابور واحد) / كونغا (موسيقى مؤلفة لرقص الكونغا)",
 "conga line": "خط الكونغا (خط من الناس في رتل واحد يؤدون رقصة الكونغا)",
 "conge": "إذن بالانصراف, طرد مفاجئ (فصل مفاجئ وبدون مراسم) / إذن انصراف (إذن رسمي بالمغادرة) / إطار مقعر ((العمارة) إطار زخرفي مقعر)",
 "congealed": "مُتَجَلِّن, مُتَجَمِّد (تجمّد على شكل هُلام؛ تصلّب بالتبريد)",
 "congealment": "تجمّد, تخثر (عملية التجمد؛ التصلب عن طريق (أو كما لو كان عن طريق) التجميد)",
 "congee": "إذن بالانصراف, طرد مفاجئ (فصل مفاجئ وبدون مراسم) / إذن انصراف (إذن رسمي بالمغادرة) / إطار مقعر ((العمارة) إطار زخرفي مقعر) / كونغي (عصيدة أرز صينية تؤكل في الإفطار)",
 "congelation": "تجمّد, تخثر (عملية التجمد؛ التصلب عن طريق (أو كما لو كان عن طريق) التجميد)",
 "congenator": "قريب, موافق للجنس (حيوان أو نبات يحمل علاقة بآخر (مرتبط بالنسب المشترك أو بالعضوية في نفس الجنس))",
 "congener": "مَثِيل, مُجَانِس (كيان كامل (شيء أو شخص) من نفس النوع أو الفئة التي ينتمي إليها آخر) / قريب, موافق للجنس (حيوان أو نبات يحمل علاقة بآخر (مرتبط بالنسب المشترك أو بالعضوية في نفس الجنس)) / متجانس كيميائي, مركب مرافق (مكون كيميائي ثانوي يعطي النبيذ أو الخمور طابعها المميز)\nمثال: استُخدم شحم الخنزير أيضاً، رغم أن نظيره، الزبدة، كان يُستخدم بشكل متكرر أكثر",
 "congeneric": "قريب, موافق للجنس (حيوان أو نبات يحمل علاقة بآخر (مرتبط بالنسب المشترك أو بالعضوية في نفس الجنس)) / متحد الجنس (ينتمي إلى نفس الجنس التصنيفي)",
 "congenerical": "متحد الجنس (ينتمي إلى نفس الجنس التصنيفي)",
 "congenerous": "متحد الجنس (ينتمي إلى نفس الجنس التصنيفي)",
 "congenial": "قَابِلٌ لِلتَّطْعِيم, مُلَائِم ((يُقال عن النباتات) قابل للتلقيح المتبادل أو التطعيم) / ملائم, مناسب (مناسب لاحتياجاتك أو ذوقك)\nمثال: جو ملائم للعمل فيه",
 "congeniality": "حَرَارَة (السخونة والحماوة؛ شدة العَطَش)\nمثال: حرارة الطقس تتزايد.",
