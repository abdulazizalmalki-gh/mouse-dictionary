 "coco palm": "جوز الهند, نارجيل (شجرة نخيل طويلة تحمل جوز الهند كثمار؛ تزرع على نطاق واسع في جميع أنحاء المناطق الاستوائية)",
 "coco plum": "إيكاكو, برقوق الكاكاو (فاكهة مبيضة إلى سوداء تقريباً تشبه البرقوق تستخدم للمحفوظات؛ استوائية أمريكية) / إيكاكو, برقوق الكاكاو (شجرة استوائية أمريكية صغيرة تحمل فاكهة تشبه البرقوق صالحة للأكل)",
 "coco plum tree": "إيكاكو, برقوق الكاكاو (شجرة استوائية أمريكية صغيرة تحمل فاكهة تشبه البرقوق صالحة للأكل)",
 "cocoa": "كاكاو / كَاكَاو",
 "cocoa bean": "حَبّ الْكَاكَاو (الزرع، كبيرا كان أم صغيرا؛ بَذْرُ الزرع)\nمثال: زيري بحب المال.",
 "cocoa butter": "زُبْدَة الْكَاكَاو (هي الزُبْد أو هي أخص من الزُبْد. أنظر الصورة؛ زُبْدَة الكلام: هو فحواه أو ما يراد به أو أهم ما فيه)\nمثال: اشترت رطلي زبدة.",
 "cocoa palm": "جوز الهند, نارجيل (شجرة نخيل طويلة تحمل جوز الهند كثمار؛ تزرع على نطاق واسع في جميع أنحاء المناطق الاستوائية)",
 "cocoa plum": "إيكاكو, برقوق الكاكاو (فاكهة مبيضة إلى سوداء تقريباً تشبه البرقوق تستخدم للمحفوظات؛ استوائية أمريكية) / إيكاكو, برقوق الكاكاو (شجرة استوائية أمريكية صغيرة تحمل فاكهة تشبه البرقوق صالحة للأكل)",
 "cocoa powder": "مسحوق الكاكاو (البقايا المسحوقة لسائل الشوكولاتة بعد إزالة زبدة الكاكاو؛ يستخدم في الخبز والوصفات قليلة الدسم والسعرات وكمنكه للآيس كريم)",
 "cocoanut": "جوز الهند (جوز بيضاوي كبير صلب القشرة ذو غلاف ليفي يحتوي على لب أبيض سميك يحيط بتجويف مركزي مملوء (عندما يكون طازجاً) بسائل أو حليب)",
 "cocobolo": "دالبرغية ريتوسا, كوكوبولو (شجرة خشبية قيمة موطنها المناطق الاستوائية في أمريكا الجنوبية)",
 "coconspirator": "متآمر (عضو في مؤامرة)",
 "coconut": "جَوْز الْهِنْد (جَوَّز لَهُمْ إِبِلَهم إِذا قَادَهَا بَعِيرًا بَعِيرًا حَتَّى تَجُوزَ) / نَارْجِيل\nمثال: نريد أن نأكل نبات جوز الهند.",
 "coconut cake": "كعكة جوز الهند (كعكة تحتوي على جوز الهند المبشور في العجين والتغطية)",
 "coconut cream": "حليب جوز الهند, كريمة جوز الهند (سائل أبيض يتم الحصول عليه بضغط لب جوز الهند الطازج)",
 "coconut macaroon": "ماكارون جوز الهند (ماكارون يحتوي على جوز الهند)",
 "coconut meat": "لب جوز الهند (اللحم الأبيض الصالح للأكل لجوز الهند؛ يبشر عادة للاستخدام في الكعك والكاري مثلاً)",
 "coconut milk": "حَلِيب النَارَجِيل, حَلِيب جَوْز الْهِنْد (هو اللَبَن المَحْلُوْب، أو ما لم يتغير طعمه. أصل التسمية؛ هو ما لم يَرُوْب واللَبَن هو ما رَابَ)\nمثال: كنت أشرب الحليب",
 "coconut oil": "دُهْن النَارَجِيل, دُهْن جَوْز الْهِنْد (طلى الشيء بالدهن أو الزيت أو الطيب؛ ضرب بالرفق)\nمثال: توم بدهن غرفته.",
 "coconut palm": "جوز الهند, نارجيل (شجرة نخيل طويلة تحمل جوز الهند كثمار؛ تزرع على نطاق واسع في جميع أنحاء المناطق الاستوائية)",
 "coconut tree": "جوز الهند, نارجيل (شجرة نخيل طويلة تحمل جوز الهند كثمار؛ تزرع على نطاق واسع في جميع أنحاء المناطق الاستوائية)",
 "coconut water": "مَاء النَارَجِيل, ماء جَوْز الْهِنْد (السائل الشفاف المعروف الذي تنشأ به الحياة، عديم اللون والرائحة والطعم عندما يكون نقيا؛ علميا فِي : جزيئة متكونة من ذرتي هيدروجين مرتبطين بذرة واحدة من الأوكسيجين)\nمثال: أنا أشرب الماء.",
 "cocoon": "شَرْنَقَة (غشاء واق من خيوط دقيقة تنسجه بعض الحشرات حولها كدودة القز، لتحتمي به في طَوْر من أطوار حياتها)",
 "cocooning": "اِنْعِزَال مَنْزِلِيّ, تَقَوْقُع (التراجع إلى عزلة منزلك (من أجل الخصوصية أو الهروب))",
 "cocopa": "لغة كوكوبا (اللغة اليومية التي يتحدث بها شعب كوكوبا) / كوكوبا (فرد من شعب هندي في أمريكا الشمالية يعيش حول مصب نهر كولورادو)",
 "cocopa language": "لغة كوكوبا (اللغة اليومية التي يتحدث بها شعب كوكوبا)",
 "cocopah": "لغة كوكوبا (اللغة اليومية التي يتحدث بها شعب كوكوبا) / كوكوبا (فرد من شعب هندي في أمريكا الشمالية يعيش حول مصب نهر كولورادو)",
 "cocopah language": "لغة كوكوبا (اللغة اليومية التي يتحدث بها شعب كوكوبا)",
 "cocos nucifera": "جوز الهند, نارجيل (شجرة نخيل طويلة تحمل جوز الهند كثمار؛ تزرع على نطاق واسع في جميع أنحاء المناطق الاستوائية)",
 "cocoswood": "خشب الغرانديلا, خشب الكوكوس (خشب شجرة الغرانديلا يستخدم لصنع الآلات الموسيقية وخاصة الكلارينيت)",
 "cocotte": "طاجن صغير, كوكت (طاجن صغير يمكن طهي وتقديم وجبات فردية فيه) / بائعة هوى, عاهرة (امرأة تمارس الجماع الجنسي مقابل المال)",
 "cocoyam": "قلقاس (جذر درني نشوي استوائي) / قلقاس (جذر درني نشوي صالح للأكل لنباتات القلقاس)",
 "cocozelle": "كوكوزيل (قرع يشبه الكوسا) / قرع إيطالي, كوكوزيل (نبات قرع ذو ثمار خضراء داكنة بقشرة مرقطة بالأخضر الفاتح أو الأصفر)",
 "cocuswood": "خشب الغرانديلا, خشب الكوكوس (خشب شجرة الغرانديلا يستخدم لصنع الآلات الموسيقية وخاصة الكلارينيت)",
 "cod": "غَادُس / قُدّ (يفيد التحقيق. (مع الماضي والمضارع)؛ يفيد التقريب. (مع الماضي)) / مُورَة / بَقَلَة\nمثال: قد أثلجت كثيرا.",
 "cod liver oil": "زيت كبد الحوت (زيت يتم الحصول عليه من أكباد سمك القد والأسماك المماثلة؛ يؤخذ عن طريق الفم كمصدر لفيتامينات أ ود)",
 "cod oil": "زيت القد (زيت كبد حوت منخفض الجودة يُستخدم في صناعة الجلود)",
 "cod-liver oil": "زيت كبد الحوت (زيت يتم الحصول عليه من أكباد سمك القد والأسماك المماثلة؛ يؤخذ عن طريق الفم كمصدر لفيتامينات أ ود)",
 "coda": "خَاتِمَة",
 "codariocalyx motorius": "نبات التلغراف, نبات الراقص (شجيرة آسيوية استوائية منتصبة تدور وريقاتها الجانبية الصغيرة على محاورها وتهتز صعوداً وهبوطاً تحت تأثير أشعة الشمس)",
 "coddled egg": "بيض برشت, بيض مسلوق نصف استواء (بيض مطبوخ لفترة وجيزة بقشره في ماء يغلي برفق)",
 "coddler": "مُدَلِّل (شخص يدلل أو يفسد بالتدليل المفرط)",
 "code": "دُسْتُور, دَسْتُور (قَاعِدَة) / اِصْطِلَاح / تَرْمِيز, شِفْرَة / كود, شِفْرَة\nمثال: العدالة مضمونة في الدستور.",
 "code flag": "علم الإشارة البحري, علم الشفرة (واحد من شفرة دولية لإشارات الأعلام تستخدم بين السفن)",
 "code of behavior": "قواعد السلوك (مجموعة من المبادئ والتوقعات التقليدية التي تعتبر ملزمة لأي شخص عضو في مجموعة معينة)",
 "code of conduct": "قواعد السلوك (مجموعة من المبادئ والتوقعات التقليدية التي تعتبر ملزمة لأي شخص عضو في مجموعة معينة)",
 "code-switching": "تَنَاوَب لُغَوِيّ",
 "codefendant": "متهم مشارك, مدعى عليه مشارك (مدعى عليه تم ضمه مع مدعى عليه واحد أو أكثر في دعوى واحدة)",
 "codeine": "كودين (مشتق من الأفيون؛ يستخدم كمضاد للسعال (لتخفيف السعال) ومسكن (لتخفيف الألم))",
 "coder": "مبرمج, مبرمج حاسوب (شخص يصمم ويكتب ويختبر برامج الحاسوب)",
 "codetalker": "متحدث بالشيفرة (عميل سري كان واحداً من هنود النافاهو الذين ابتكروا واستخدموا شيفرة تعتمد على لغتهم الأصلية؛ لم يكسر اليابانيون الشيفرة خلال الحرب العالمية الثانية)",
 "codex": "مَخْطُوطَة (مُؤَلَّف المكتوب باليد ، غير المطبوع؛ نُسْخة المؤلِّلف الأصليَّة المُعدَّة للطبع)",
 "codfish": "سمك القد, قد (سمكة غذائية رئيسية في مياه القطب الشمالي والمناطق المعتدلة الباردة) / سمك القد, قد (لحم أبيض قليل الدهن لسمكة طعام هامة في شمال الأطلسي؛ عادة يخبز أو يسلق)",
 "codfish ball": "كرة سمك القد (تُصنع عادة من سمك القد المملح المفتت والبطاطس المهروسة)",
 "codfish cake": "كرة سمك القد (تُصنع عادة من سمك القد المملح المفتت والبطاطس المهروسة)",
 "codger": "عجوز غريب الأطوار (يستخدم بمودة للإشارة إلى رجل عجوز غريب الأطوار ولكنه مسلٍ)",
 "codiaeum variegatum": "كروتون, كوديايوم (يزرع في العديد من الأصناف لأوراقه زاهية الألوان؛ يزرع على نطاق واسع كنبات منزلي)",
 "codicil": "ملحق وصية (ملحق لوصية؛ صك وصية يهدف إلى تغيير وصية تم تنفيذها بالفعل)",
 "codification": "تصنيف, تقنين (فعل التقنين؛ الترتيب في نظام منهجي) / دستور, مدونة (مجموعة من القواعد أو المبادئ أو القوانين (وخاصة المكتوبة منها))",
 "codified": "تَشْرِيعِيّ, مُقَنَّن (صادر عن هيئة تشريعيّة ومُدوَّن في قانون)",
 "coding": "تشفير, تعمية (فعل الكتابة برمز أو شفرة)",
 "coding dna": "إكسون (تسلسل من الحمض النووي للجين يُنسخ إلى تراكيب بروتينية)",
 "coding system": "نظام ترميز (نظام من الإشارات يُستخدم لتمثيل الحروف أو الأرقام في نقل الرسائل)",
 "codlin moth": "دودة ثمار التفاح, عثة التفاح (عثة رمادية صغيرة تعيش يرقاتها في التفاح والجوز الإنجليزي)",
 "codling": "قد صغير (سمك القد الصغير)",
 "codling moth": "دودة ثمار التفاح, عثة التفاح (عثة رمادية صغيرة تعيش يرقاتها في التفاح والجوز الإنجليزي)",
 "codlins-and-cream": "عشبة الصفصاف المشعرة (نبات من أوروبا وآسيا ذو أزهار حمراء أرجوانية وسيقان وأوراق مشعرة؛ أدخل إلى أمريكا الشمالية)",
 "codon": "شفرة وراثية ثلاثية, كودون",
 "codpiece": "جراب العورة ((القرن 15-16) لسان لمنطقة العورة في سراويل الرجال الضيقة)",
 "codswallop": "تُرَّهَات, كَلَام تَافِه (حديث أو كتابة لا معنى لها)",
 "coeducation": "تعليم مختلط (تعليم الرجال والنساء في نفس المؤسسات)",
 "coeducational": "لِلْجِنْسَيْن, مُخْتَلَط (يحضره أفراد من الجنسين معًا)",
 "coefficient": "مُعَامِل (في : هو قِيمَة تبيّن دَرَجَة وجود صِفَة أو علاقة في موقف معلوم؛ في : هو العَدَد الذي يسبق المُتَغَيِّر (الحَرْف) في ذات الحد)\nمثال: أساء توم معاملة ماري.",
 "coefficient of absorption": "اِمْتِصَاصِيَّة, مُعَامِل الِامْتِصَاص (مقياس لمعدل انخفاض شدة الإشعاع الكهرومغناطيسي (كالضوء) عند مروره خلال مادة معينة؛ نسبة الطاقة الإشعاعية الساقطة الممتصة لكل وحدة كتلة أو سمك من…)\nمثال: الامتصاصية تساوي 1 ناقص النفاذية",
 "coefficient of concordance": "معامل التوافق (معامل الاتفاق (التوافق) بين مجموعات مختلفة من ترتيبات الرتب لنفس مجموعة الأشياء)",
 "coefficient of correlation": "الارتباط, معامل الارتباط (إحصائية تمثل مدى التقارب في التباين بين متغيرين؛ يمكن أن تتراوح من -1 (ارتباط سلبي تام) مروراً بـ 0 (لا يوجد ارتباط) إلى +1 (ارتباط إيجابي تام))\nمثال: ما هو الارتباط بين هذين المتغيرين؟",
 "coefficient of drag": "مُعَامِل السَّحْب, مُعَامِل الكَبْح (نسبة قوة السحب على جسم يتحرك عبر الهواء إلى حاصل ضرب السرعة ومساحة سطح الجسم)",
 "coefficient of elasticity": "مُعَامِل الْمُرُونَة, مِعْيَار الْمُرُونَة ((في الفيزياء) نسبة الإجهاد المطبق إلى التغير في شكل جسم مرن)",
 "coefficient of expansion": "قَابِلِيَّة التَّمَدُّد, مُعَامِل التَّمَدُّد (التغير النسبي في الطول أو المساحة أو الحجم لكل وحدة تغير في درجة الحرارة عند ضغط ثابت معين)",
 "coefficient of friction": "معامل الاحتكاك (في : هو قِيمَة تبيّن دَرَجَة وجود صِفَة أو علاقة في موقف معلوم؛ في : هو العَدَد الذي يسبق المُتَغَيِّر (الحَرْف) في ذات الحد)\nمثال: أساء توم معاملة ماري.",
 "coefficient of mutual induction": "مَحَاثَّة مُتَبَادَلَة, مُعَامِل الحَثّ المُتَبَادَل (مقياس للحث بين دائرتين كهربائيتين؛ النسبة بين القوة الدافعة الكهربائية في دائرة والتغير المقابل في التيار في دائرة مجاورة؛ يقاس عادة بالهنري)",
 "coefficient of reflection": "اِنْعِكَاسِيَّة, مُعَامِل الِانْعِكَاس (جزء الطاقة الإشعاعية الذي ينعكس عن سطح ما)",
 "coefficient of self induction": "حَثّ ذَاتِيّ, مُعَامِل الحَثّ الذَّاتِيّ (النسبة بين القوة الدافعة الكهربائية الناتجة في دائرة عن طريق الحث الذاتي ومعدل تغير التيار الذي ينتجها، معبراً عنها بالهنري)",
 "coefficient of viscosity": "لُزُوجَة دِينَامِيكِيَّة, لُزُوجَة مُطْلَقَة (مقياس لمقاومة تدفق مائع تحت تأثير قوة مطبقة)",
 "coelacanth": "سمك السيلاكانث (سمكة كان يُعتقد أنها انقرضت منذ العصر الطباشيري ولكن عُثر عليها عام 1938 قبالة سواحل أفريقيا)",
 "coelenterate": "جوفمعوي, لاسع (حيوانات متناظرة شعاعياً لها أجسام تشبه الكيس بفتحة واحدة فقط ومجسات ذات هياكل لاسعة)",
 "coelenterate family": "فصيلة جوفمعويات (فصيلة من الجوفمعويات)",
 "coelenterate genus": "جنس جوفمعوي (جنس من الجوفمعويات)",
 "coelenteron": "جوف معوي (تجويف الجسم الشبيه بالكيس في الجوفمعويات)",
 "coeliac": "بطني, جوفي (من أو في أو ينتمي إلى تجويف البطن)",
 "coeliac plexus": "ضفيرة زلاقية, ضفيرة شمسية (ضفيرة كبيرة من الأعصاب الودية في البطن خلف المعدة)",
 "coelodonta antiquitatis": "وحيد القرن الصوفي (نوع منقرض كثيف الشعر من المناطق القطبية)",
 "coeloglossum bracteatum": "أوركيد الساتير, سيلوجلوسوم (أوركيد بأوراق بيضاوية عريضة وزهور خضراء طويلة القنابات غير منتظمة جداً)",
 "coeloglossum viride": "أوركيد الضفدع (أوركيد ذو زهور خضراء إلى خضراء مصفرة طويلة القنابات مقنعة مشوبة بالأرجواني)",
 "coelogyne": "سيلوجين (أي من بساتين الفاكهة المختلفة من جنس سيلوجين ذات: عناقيد من الزهور البيضاء الثلجية العطرة؛ زهور وحيدة وردية سلمونية؛ عناقيد تشبه السلسلة من زهور…)",
 "coelom": "جوف, سيلوم (تجويف في الأديم المتوسط للجنين يؤدي في البشر إلى التجويف الجنبي وتجويف التامور والتجويف البريتوني)",
 "coelophysis": "سيلوفايسز (واحد من أقدم الديناصورات المعروفة؛ من أواخر العصر الترياسي؛ آكل للحوم جنسه)",
 "coelostat": "سيلوستات, م定ة فلكية (جهاز بصري يستخدم لتتبع مسار جرم سماوي وعكس ضوئه إلى تلسكوب؛ يحتوي على مرآة متحركة وأخرى ثابتة)",
 "coenobite": "راهب جماعي (عضو في رهبنة دينية يعيش في جماعة)",
 "coenobitic": "رهباني جماعي (من أو متعلق بـ أو يليق بالرهبان الذين يعيشون في جماعة)",
 "coenobitical": "رهباني جماعي (من أو متعلق بـ أو يليق بالرهبان الذين يعيشون في جماعة)",
 "coenzyme": "إنزيم مساعد, مرافق إنزيم (جزيء صغير (ليس بروتيناً ولكن أحياناً فيتامين) ضروري لنشاط بعض الإنزيمات)",
 "coenzyme a": "مرافق الإنزيم أ (مرافق إنزيم موجود في جميع الخلايا الحية؛ ضروري لعمليات التمثيل الغذائي للكربوهيدرات والدهون وبعض الأحماض الأمينية)",
 "coenzyme q": "يوبيكينون (أي من الكينونات المتعددة الموجودة في الخلايا الحية والتي تعمل كإنزيمات مساعدة تنقل الإلكترونات من جزيء إلى آخر في التنفس الخلوي)",
 "coequal": "نِدّ, نَظِير",
 "coerce": "أَجْبَرَ, اِضْطَرَّ (فعل تعدّي من جَبَرَ؛ جعله يَجْبُر، ضد أَكْسَرَ؛ جعله يفعل شيئا رُغْما عنه؛ أَرْغَمَ)\nمثال: أجبر توم ماري على أكل ضفدع.",
 "coercion": "قَهْر, قَسْر (غَلَبَ وانْتَصَرَ ولم يقدر عليه أحد) / إِكْرَاه",
 "coercive": "إِكْرَاهِيّ, قَسْرِيّ (يعمل على الإكراه أو يهدف إليه)",
 "coetaneous": "مُعَاصِر, مِنْ نَفْسِ الحِقْبَة (من نفس الفترة الزمنية)",
 "coeur d'alene": "كور دالين (فرد من شعب هندي أمريكي يعيش في شمال أيداهو حول بحيرة كور دالين)",
 "coeval": "مُعَاصِر, مِنْ نَفْسِ الحِقْبَة (من نفس الفترة الزمنية) / قِرْن, لِدَة (شخص في نفس عمر شخص آخر تقريباً)",
 "coevals": "جيل, معاصرون (جميع الناس الذين يعيشون في نفس الوقت أو من نفس العمر تقريباً)",
 "coexist": "تَعَايَشَ",
 "coexistence": "تَعَايُش",
 "coexistent": "مُتَزَامِن الوُجُود, مُتَعَايِش (موجود في نفس الوقت)",
 "coexisting": "مُتَزَامِن الوُجُود, مُتَعَايِش (موجود في نفس الوقت)",
 "coextension": "تساوق, تساوي الامتداد (التساوي في الامتداد أو المدة)",
 "coextensive": "مُتَسَاوِي المَدَى (متساوٍ في النطاق أو المدى أو المدة)",
 "cofactor": "تميم, عامل مرافق (مادة (مثل الإنزيم المساعد) يجب أن تتحد مع مادة أخرى لإنتاج نتيجة معينة)",
 "coffea arabica": "بن عربي, قهوة عربية (شجرة شجيرية من شمال شرق أفريقيا الاستوائية تزرع على نطاق واسع في المناطق الاستوائية أو شبه الاستوائية لبذورها التي تشكل معظم القهوة التجارية)",
 "coffea canephora": "بن روبوستا, قهوة روبوستا (موطنها غرب أفريقيا ولكنها تزرع في جاوة وأماكن أخرى؛ مقاومة لصدأ القهوة)",
 "coffea liberica": "بن ليبيري, قهوة ليبيرية (شجرة صغيرة من غرب أفريقيا)",
 "coffea robusta": "بن روبوستا, قهوة روبوستا (موطنها غرب أفريقيا ولكنها تزرع في جاوة وأماكن أخرى؛ مقاومة لصدأ القهوة)",
 "coffee": "قَهْوَة, قهوة (مشروب يحضر بغلي مطحون البُنّ؛ المحل أو الدكان الذي تُقدَّم فيه القهوة وغيرها من المشروبات) / بُنّ\nمثال: لا أفضل القهوة.",
 "coffee bar": "مقهى (مطعم صغير تباع فيه المشروبات والوجبات الخفيفة)",
 "coffee bean": "بُنّ",
 "coffee berry": "بن, حبة بن (بذرة شجرة البن؛ تطحن لصنع القهوة)",
 "coffee blight": "لفحة البن (لفحة تصيب نبات البن)",
 "coffee break": "اِسْتِرَاحَة (مبنى خارج المدن يتوقف فيه المسافرون للراحة والتَزَوُّد يُجمع على اِسْتِرَاحَات)\nمثال: عليك أخذ استراحة.",
 "coffee cake": "كعكة القهوة (كعكة أو خبز حلو يقدم عادة مع القهوة)",
 "coffee can": "علبة قهوة (علبة لتخزين البن المطحون)",
 "coffee cappuccino": "كابتشينو (أجزاء متساوية من الإسبريسو والحليب الساخن مغطاة بالقرفة وجوزة الطيب وعادة الكريمة المخفوقة)",
 "coffee cream": "كريمة القهوة, كريمة خفيفة (كريمة تحتوي على 18% على الأقل من دهن الزبدة)",
 "coffee cup": "فنجان قهوة (كوب تشرب منه القهوة)",
 "coffee fern": "سرخس القهوة (سرخس دائم الخضرة في كاليفورنيا وباها كاليفورنيا)",
 "coffee filter": "مرشح قهوة (مرشح (عادة من الورق) يمرر القهوة ويحتجز تفل القهوة)",
 "coffee fungus": "فطر القهوة (فطر يسبب مرضاً في القهوة وبعض النباتات الاستوائية الأخرى)",
 "coffee grinder": "طَاحُونَة قَهْوَة (آلةٌ يدوية يُطحن فيها الدَقِيْق؛ آلة ميكانيكية كبيرة تحرك بالحيوان أو الهواء أو الماء أو الكهرباء تستخدم لطحن الدقيق)",
 "coffee grounds": "تَنْوَة",
 "coffee liqueur": "ليكير القهوة (ليكير بنكهة القهوة)",
 "coffee maker": "صانعة قهوة, ماكينة قهوة (جهاز مطبخ لتحضير القهوة آلياً)",
 "coffee mill": "طاحونة قهوة, مطحنة بن (طاحونة تطحن حبوب البن المحمصة)",
 "coffee mug": "كوب قهوة (كوب مخصص لتقديم القهوة)",
 "coffee pot": "إِبْرِيق قَهْوَة",
 "coffee ring": "حلقة القهوة (كعكة قهوة على شكل حلقة مع الفواكه أو المكسرات ومغطاة غالباً بالسكر)",
 "coffee roll": "لفافة حلوة, لفافة قهوة (أي من العديد من اللفائف الحلوة المخمرة بالخميرة مع أو بدون الزبيب أو المكسرات أو التوابل أو طبقة سكرية)",
 "coffee rose": "تفاحة آدم, زهرة الطاحونة (شجيرة استوائية ذات أوراق لامعة وأزهار ليلية عطرة ذات تيجان مجعدة أو متموجة؛ من شمال الهند إلى تايلاند)",
 "coffee royal": "كافيه رويال (قهوة سوداء مع الكونياك وقشر الليمون والسكر)",
 "coffee senna": "سنا القهوة, عشبة منتنة (شجيرة استوائية مورقة جداً كريهة الرائحة استخدمت بذورها كمغشوش للقهوة؛ تصنف أحياناً في جنس كاسيا)",
 "coffee shop": "مقهى (مطعم صغير تباع فيه المشروبات والوجبات الخفيفة)",
 "coffee stall": "كشك قهوة (كشك (عادة ما يكون متحركاً) لبيع القهوة الساخنة والطعام (خاصة في الليل))",
 "coffee substitute": "بديل القهوة (مشروب يشبه القهوة يُستخدم أحيانًا كبديل لها)",
 "coffee table": "طَاوِلَةُ قَهْوَة (قِطْعَة أَثَاث توضع عليها الأشياء، ولها رِجْل أو أكثر. ( أحادي)؛ لُعْبَة مشهورة في الشرق الأوسط عبارة عن لوح توضع عليه قطع من خشب بلونين ويستخدم النَّرْد للعب. (اسم علم)) / طَاوِلَةُ لِلْقَهْوَة (قِطْعَة أَثَاث توضع عليها الأشياء، ولها رِجْل أو أكثر. ( أحادي)؛ لُعْبَة مشهورة في الشرق الأوسط عبارة عن لوح توضع عليه قطع من خشب بلونين ويستخدم النَّرْد للعب. (اسم علم))\nمثال: هذه ليست طاولة.",
 "coffee table book": "كتب طاولة القهوة (خَطَّ الكلام؛ كتَبَ الله شيئا على فلان: أي قدَّره له أو عليه أو أوجبه على الناس)\nمثال: حملت ثلاثة كتب.",
 "coffee tree": "بن, شجرة البن (أي من الأشجار الصغيرة والشجيرات المتعددة الأصلية في المناطق الاستوائية في العالم القديم التي تنتج حبوب البن)",
 "coffee urn": "غلاية قهوة, وعاء قهوة كبير (وعاء كبير يتم فيه صنع القهوة وحفظها ساخنة)",
 "coffee-table book": "كتاب طاولة القهوة, كتاب للعرض (كتاب كبير الحجم متقن مناسب للعرض على طاولة القهوة)",
 "coffeeberry": "توت القهوة, نبق كاليفورنيا (شجيرة دائمة الخضرة في غرب الولايات المتحدة تحمل ثماراً حمراء أو سوداء صغيرة)",
 "coffeecake": "كعكة القهوة (كعكة أو خبز حلو يقدم عادة مع القهوة)",
 "coffeehouse": "مقهى (مطعم صغير تباع فيه المشروبات والوجبات الخفيفة)",
 "coffeemaker": "مَاكِينَةُ تَحْضِيرِ الْقَهْوَة, آلَةُ تَحْضِيرِ الْقَهْوَة",
 "coffeeman": "قَهْوَجِيّ",
 "coffeepot": "إبريق قهوة (وعاء طويل يتم فيه تخمير القهوة)",
 "coffer": "خَزْنَة حَدِيدِيَّة, خَزْنَة",
 "cofferdam": "صندوق غاطس, قيسون (حجرة كبيرة مانعة لتسرب الماء تستخدم للبناء تحت الماء)",
 "coffey still": "مقطر كوفي (جهاز تقطير يتكون من جهاز للتقطير التجزيئي للإيثانول من التخمير على نطاق صناعي)",
 "coffin": "تَابُوت (تَّابُوت: هو الصُّنْدُوق الذي توضع به الجثة؛ صندوق خشبيّ يكون مستطيل)",
 "coffin nail": "سيجارة (تبغ مطحون ناعماً ملفوف في ورق؛ للتدخين)",
 "coffin texts": "نُصُوص التَّوَابِيت",
 "cofounder": "مؤسس شريك (واحد من مجموعة من المؤسسين لكيان ما)",
 "cog": "سن الترس (سن على حافة عجلة مسننة) / ترس في آلة (مرؤوس يؤدي وظيفة مهمة ولكنها روتينية)\nمثال: كان ترساً صغيراً في آلة كبيرة",
 "cog railway": "سكة حديد مسننة (سكة حديد للجبال شديدة الانحدار؛ حيث تشتبك عجلة مسننة في القاطرة بأسنان على سكة مركزية لتوفير الجر)",
 "cogency": "سَدَاد, صِحَّة (صفة كون الشيء صحيحاً ودقيقاً) / قُوَّة الإِقْنَاع (صلة مقنعة)",
 "cogent": "دَامِغ, مُؤَثِّر (مقنع بقوّة ووجاهة الحجّة)",
 "cogent evidence": "برهان, حجة دامغة (أي دليل واقعي يساعد في إثبات حقيقة شيء ما)\nمثال: إذا كان لديك أي دليل على ما تقوله، فالآن هو الوقت المناسب لتقديمه",
 "cogged": "ذُو تُرُوس, مُسَنَّن (له تروس أو أسنان تشابكية)",
 "cogitable": "قَابِلٌ لِلتَّأَمُّل (يُمْكِنُ التَّفْكِيرُ فِيهِ وَتَأَمُّلُه)",
 "cogitation": "تدبر, تفكر (تفكير وتأمل منتبه) / تأمل, تدبّر (فكرة مدروسة بعناية حول شيء ما)\nمثال: بعد تدبر طويل رفض العرض",
 "cogitative": "تَفَكُّرِيّ (مَيَّالٌ إِلَى التَّفَكُّرِ وَالتَّدَبُّر) / تأملي, تفكيري (متعلق بامتلاك قدرات التفكير والتأمل)\nمثال: الملكة التفكيرية",
 "cognac": "كُونْيَاك",
 "cognate": "ذُو رَحِمٍ, مِنْ نَفْسِ الدَّمِ (مرتبط بصلة الدم) / ذُو أَصْلٍ لُغَوِيٍّ مُشْتَرَكٍ (ينتمي إلى نفس اللغة الأم) / مُتَقَارِبٌ فِي الطَّبِيعَةِ (مرتبط في الطبيعة والجوهر) / لفظ قريب, لفظ مشترك الأصل (تكون الكلمة قريبة لأخرى إذا كان كلاهما مشتقاً من نفس الكلمة في لغة الأسلاف)",
 "cognate accusative": "مفعول مطلق (كناية عن الذي فُعِلَ به فاحشة اللواط. المَلُوطُ به)\nمثال: جواز سفر ساري المفعول.",
 "cognate word": "لفظ قريب, لفظ مشترك الأصل (تكون الكلمة قريبة لأخرى إذا كان كلاهما مشتقاً من نفس الكلمة في لغة الأسلاف)",
 "cognation": "صِلَة الرَّحِم, قَرَابَة الدَّم ((الأنثروبولوجيا) حالة الارتباط بالدم) / نَسَب أُمُومِيّ (خط النسب المتتبع عبر جانب الأم من العائلة)",
 "cognisable": "قابل للمعرفة, مدرك (يمكن معرفته)",
 "cognisance": "إدراك, علم (امتلاك المعرفة بـ)\nمثال: لم يكن لديه وعي بأخطائه",
 "cognisant": "مُدْرِك, وَاعٍ ((أحياناً يتبعه 'بـ') لديه أو يظهر معرفة أو فهماً أو إدراكاً)\nمثال: كان مدركاً لعداء خصمه",
 "cognition": "إِدْرَاك, مَعْرِفَة (الناتج النفسيّ للإدراك الحسّيّ والتعلُّم والاستدلال)",
 "cognitive": "إِدْرَاكِيّ",
 "cognitive content": "مُحْتَوَى ذِهْنِيّ, مُحْتَوَى مَعْرِفِيّ (مجموع أو نطاق ما أُدرِك أو اكتُشِف أو تُعُلِّم)",
 "cognitive dissonance": "تَنَافُر مَعْرِفِيّ, اِنْفِصَام مَعْرِفِيّ",
 "cognitive factor": "عامل معرفي (شيء غير مادي (مثل ظرف أو تأثير) يساهم في إنتاج نتيجة)",
 "cognitive neuroscience": "علم الأعصاب المعرفي (فرع علم الأعصاب الذي يدرس الأسس البيولوجية للظواهر العقلية)",
 "cognitive neuroscientist": "عالم أعصاب إدراكي (عالم إدراكي يدرس الأسس الفسيولوجية العصبية للظواهر العقلية)",
 "cognitive operation": "عملية, عملية ذهنية ((علم النفس) أداء نشاط معرفي مركب؛ عملية تؤثر في المحتويات العقلية)\nمثال: عملية التفكير",
 "cognitive process": "عملية, عملية ذهنية ((علم النفس) أداء نشاط معرفي مركب؛ عملية تؤثر في المحتويات العقلية)\nمثال: عملية التفكير",
 "cognitive psychology": "علم النفس المعرفي (نهج في علم النفس يؤكد على العمليات العقلية الداخلية)",
 "cognitive science": "علم الإدراك, علوم إدراكية (ميدان العلم المعني بالإدراك؛ يشمل أجزاء من علم النفس المعرفي واللسانيات وعلوم الحاسوب وعلم الأعصاب المعرفي وفلسفة العقل)",
 "cognitive scientist": "عالم إدراكي (عالم يدرس العمليات الإدراكية)",
 "cognitive semantics": "علم الدلالة المعرفي (فرع علم الدلالة الذي يدرس الجوانب المعرفية للمعنى)",
 "cognitive state": "حالة إدراكية, حالة معرفية (حالة العمليات المعرفية للشخص)",
 "cognitively": "إدراكياً, معرفياً (فيما يتعلق بالإدراك والمعرفة)\nمثال: ماهر إدراكياً",
 "cognizable": "قابل للمعرفة, مدرك (يمكن معرفته)",
 "cognizance": "إدراك, علم (امتلاك المعرفة بـ) / إحاطة, دراية (نطاق أو مدى ما يتم إدراكه) / مدارك, نطاق المعرفة (نطاق ما يمكن للمرء معرفته أو فهمه)\nمثال: لم يكن لديه وعي بأخطائه",
 "cognizant": "مُدْرِك",
 "cognomen": "اسم العائلة, لقب (الاسم المستخدم لتعريف أفراد الأسرة (لتمييزه عن الاسم الأول لكل فرد)) / كنية, لقب تحبب (اسم مألوف لشخص (غالباً نسخة مختصرة من الاسم الأول للشخص))\nمثال: لم تستخدم والدة جو كنيته وكانت تناديه دائماً جوزيف",
 "cognoscente": "خبير تذوق, ذواقة (خبير قادر على تقدير مجال معين؛ خاصة في الفنون الجميلة)",
 "cognoscible": "قابل للمعرفة, مدرك (يمكن معرفته)",
 "cognovit judgement": "إقرار بحكم, اعتراف بالدين (حكم يتم إدخاله بعد اعتراف كتابي من المدين دون تكلفة الإجراءات القانونية العادية)",
 "cognovit judgment": "إقرار بحكم, اعتراف بالدين (حكم يتم إدخاله بعد اعتراف كتابي من المدين دون تكلفة الإجراءات القانونية العادية)",
 "cogwheel": "ترس, عجلة مسننة (عجلة مسننة تتعشق مع آلية مسننة أخرى لتغيير سرعة أو اتجاه الحركة المنقولة)",
 "cohabitation": "مُسَاكَنَة",
 "coherence": "اتِّسَاق, تَرَابُط (العلاقة المنطقية والمنظمة والمتسقة بين الأجزاء) / تلاحم, تماسك (حالة التماسك أو الالتصاق معاً)",
 "coherency": "اتِّسَاق, تَرَابُط (العلاقة المنطقية والمنظمة والمتسقة بين الأجزاء) / تلاحم, تماسك (حالة التماسك أو الالتصاق معاً)",
 "coherent": "مُلْتَحِم, مُتَرَابِط",
 "coherently": "بِتَرَابُط, بِتَمَاسُك (بطريقة متماسكة)\nمثال: لم تستطع التحدث بشكل مترابط بعد الحادث",
 "cohesion": "تماسك ((في الفيزياء) القوة بين الجزيئية التي تربط جزيئات مادة صلبة أو سائلة معاً) / التحام, تلاصق ((علم النبات) العملية في بعض النباتات حيث تنمو الأجزاء معًا والتي عادة ما تكون منفصلة (مثل البتلات)) / تلاحم, تماسك (حالة التماسك أو الالتصاق معاً) / تماسك نصي, سبك ((في اللغويات) الربط النحوي والمعجمي داخل نص أو جملة مما يربط النص ببعضه ويعطيه معنى)",
 "cohesive": "مُتَمَاسِك, مُتَنَاسِق",
 "cohesiveness": "تماسك, لزوجة (خاصية التماسك واللزوجة) / تلاحم, تماسك (حالة التماسك أو الالتصاق معاً)",
 "coho": "سلمون فضي, سلمون كوهو (سلمون صغير من سواحل شمال المحيط الهادئ والبحيرات العظمى) / سلمون فضي, سلمون كوهو (لحم وردي دهني لسلمون صغير يتم اصطيده في المحيط الهادئ والبحيرات العظمى)",
 "coho salmon": "سلمون فضي, سلمون كوهو (سلمون صغير من سواحل شمال المحيط الهادئ والبحيرات العظمى) / سلمون فضي, سلمون كوهو (لحم وردي دهني لسلمون صغير يتم اصطيده في المحيط الهادئ والبحيرات العظمى)",
 "cohoe": "سلمون فضي, سلمون كوهو (سلمون صغير من سواحل شمال المحيط الهادئ والبحيرات العظمى) / سلمون فضي, سلمون كوهو (لحم وردي دهني لسلمون صغير يتم اصطيده في المحيط الهادئ والبحيرات العظمى)",
 "cohort": "شريحة عمرية, فئة عمرية (مجموعة من الناس لديهم نفس العمر تقريباً) / كتيبة (فرقة من المحاربين (أصلاً وحدة من فيلق روماني)) / زمرة, فوج (مجموعة من الرفاق أو المؤيدين)",
 "cohort study": "دِرَاسَة الْأَتْرَاب, دِرَاسَة التَّعَرُّض (تحصيل المعرفة، التَّعَلُّم؛ بحث أكاديمي)\nمثال: تعبت من الدراسة.",
 "cohosh": "أكتيا, نبات الراهب (نبات من جنس الأكتيا يحمل ثماراً لبية سامة وحريفة الطعم)",
 "cohune": "نخيل كوهون (نخيل ريشي استوائي أمريكي تنتج مكسراته الكبيرة زيتاً قيماً ونوعاً من العاج النباتي)",
 "cohune fat": "زيت الكوهون (دهن شبه صلب من مكسرات نخيل الكوهون؛ يُستخدم في الطهي وصنع الصابون)",
 "cohune nut": "جوز الكوهون (جوز نخيل الكوهون ذو قشور بيضاء صلبة مثل تلك الموجودة في جوز العاج)",
 "cohune oil": "زيت الكوهون (دهن شبه صلب من مكسرات نخيل الكوهون؛ يُستخدم في الطهي وصنع الصابون)",
 "cohune palm": "نخيل كوهون (نخيل ريشي استوائي أمريكي تنتج مكسراته الكبيرة زيتاً قيماً ونوعاً من العاج النباتي)",
 "cohune-nut oil": "زيت الكوهون (دهن شبه صلب من مكسرات نخيل الكوهون؛ يُستخدم في الطهي وصنع الصابون)",
 "coif": "غطاء رأس, كواف (قلنسوة ترتديها الراهبات تحت الحجاب أو الجنود تحت غطاء من الزرد أو سابقاً من قبل الرقباء القانونيين البريطانيين) / تَسْرِيحَة شَعْر, تَصْفِيفَة شَعْر (ترتيب الشعر (خاصة شعر المرأة))",
 "coiffeur": "مصفف شعر (رجل يعمل في تصفيف الشعر)",
 "coiffeuse": "مصففة شعر (امرأة تعمل في تصفيف الشعر)",
 "coiffure": "تَسْرِيحَة شَعْر, تَصْفِيفَة شَعْر (ترتيب الشعر (خاصة شعر المرأة))",
 "coign": "حجر العقد (حجر مفتاح القوس) / إسفين الطباعة (إسفين معدني أو خشبي قابل للتمدد يستخدمه الطابعون لقفل القالب داخل الإطار)",
 "coigne": "حجر العقد (حجر مفتاح القوس) / إسفين الطباعة (إسفين معدني أو خشبي قابل للتمدد يستخدمه الطابعون لقفل القالب داخل الإطار)",
 "coigue": "زان كويغ (شجرة تشيلية دائمة الخضرة تستخدم أغصانها المورقة للتسقيف)",
 "coil": "مِلَفّ, وَشِيعَة / وَشِيعَة",
 "coil notebook": "دفتر سلك (دفتر ملاحظات بتجليد حلزوني)",
 "coil spring": "زنبرك حلزوني, نابض لولبي (نابض على شكل ملف)",
 "coiled": "حلزوني, ملتف (ملتف أو ملفوف (خاصة في حلقات متحدة المركز أو حلزونية))\nمثال: ثعبان ملتف مستعد للهجوم",
 "coiling": "حَلَزُونِيّ, لَوْلَبِيّ (على شكل لفائف حلزونية)",
 "coimbra": "قلمرية",
 "coin": "قِرْش, عُمْلَة",
 "coin bank": "حصالة (حاوية (عادة بفتحة في الأعلى) لحفظ النقود في المنزل)\nمثال: كانت حصالة النقود فارغة",
 "coin blank": "قرص العملة الخام (قرص معدني مسطح جاهز للختم كعملة معدنية)",
 "coin box": "صندوق العملات (جزء من آلة القمار يعمل كوعاء للعملات المعدنية)",
 "coin collecting": "جمع العملات, علم العملات (جمع ودراسة النقود (والعملات المعدنية بشكل خاص))",
 "coin collection": "جمع العملات, علم العملات (جمع ودراسة النقود (والعملات المعدنية بشكل خاص)) / مجموعة عملات (مجموعة من العملات المعدنية)",
 "coin collector": "جامع عملات, عالم عملات (جامع ودارس للنقود (والعملات المعدنية بشكل خاص))",
 "coin machine": "آلة بيع, آلة قمار (آلة يتم تشغيلها عن طريق إدخال عملة معدنية في فتحة)",
 "coin silver": "فضة العملات (فضة بدرجة نقاء محددة لصنع العملات الفضية القانونية)",
 "coin slot": "فتحة العملة (شق يمكن من خلاله إدخال العملات المعدنية في آلة البيع أو القمار)",
 "coin-operated": "مُشغّل بقطعة نقدية (للأجهزة التي لا تعمل إلا بعد إدخال قطعة نقدية أو أكثر)\nمثال: هاتف يعمل بقطعة نقدية",
 "coinage": "اشتقاق جديد, كلمة مستحدثة (فعل اختراع كلمة أو عبارة جديدة) / كلمة مستحدثة, لفظ مولد (كلمة أو عبارة مخترعة حديثاً) / مسكوكات, نقود معدنية (العملات المعدنية مجتمعة)",
 "coincide": "تَزَامَنَ",
 "coincidence": "صُدْفَة, مُصَادَفَة (الصدفة. جمع: صُدُفات و صُدْفات و صُدَف٬ هي تزامن غير متوقع لحدوث فعلين بدون تخطيط مسبق، رآه صُدْفةً…)\nمثال: لا تدعها للصدفة.",
 "coincident": "مُتَطَابِق, مُتَوَافِق (مُتَطَابِقٌ نُقْطَةً بِنُقْطَةٍ) / آنِيّ, مُتَزَامِن (يحدث أو يعمل في نفس الوقت)",
 "coincidental": "آنِيّ, مُتَزَامِن (يحدث أو يعمل في نفس الوقت)",
 "coincidentally": "بالصدفة, تزامناً (الحدوث في نفس الوقت)",
 "coincidently": "بالصدفة, تزامناً (الحدوث في نفس الوقت)",
 "coinciding": "آنِيّ, مُتَزَامِن (يحدث أو يعمل في نفس الوقت)",
 "coiner": "سكاك العملة (عامل ماهر يسك أو يختم النقود) / مبتكر الكلمات, ناحت المصطلحات (شخص يُعد مصدراً لكلمات جديدة أو تعبيرات جديدة) / مزيف عملة (صانع العملات المزيفة)",
 "coinsurance": "تأمين مشترك (تأمين يصدر بشكل مشترك من قبل اثنين أو أكثر من الضامنين)",
 "coir": "قُنْبَر, قُنْبَار",
 "coital": "جماعي (متعلق بالجماع أو الاتصال الجنسي)",
 "coition": "اتصال جنسي, جماع (نشاط جنسي بين الأفراد، خاصة إيلاج العضو الذكري في المهبل حتى حدوث النشوة والقذف)",
 "coitus": "جِمَاع, مُجَامَعَة (الموافقة والمساعدة في أي شيء كان؛ الشيء: جمعه)\nمثال: توم قائد جماعة أنونيموس.",
 "coitus interruptus": "الجماع المقطوع, العزل (طريقة لتحديد النسل يتم فيها بدء الجماع ولكن يتم سحب القضيب عمداً قبل القذف)",
 "coke": "كُولَا",
 "col": "فجوة جبلية, ممر (ممر بين قمم الجبال؛ مصطلح جيومورفولوجي لأدنى نقطة على حيد جبلي بين قمتين)",
 "cola": "كُولَا",
 "cola acuminata": "جوزة الكولا, كولا (شجرة تحمل مكسرات بنية كبيرة تحتوي على الكافيين مثلاً؛ مصدر مستخلص الكولا)",
 "cola extract": "مستخلص الكولا (منكه مستخرج من جوز الكولا)",
 "cola nut": "جوز الكولا (بذرة بنية مرة تحتوي على الكافيين؛ مصدر لمستخلص الكولا)",
 "colander": "مِصْفَاة",
 "colaptes auratus": "نقار الخشب أصفر العمود (نقار خشب كبير من شرق أمريكا الشمالية ذو رقبة حمراء وسطح سفلي أصفر للأجنحة والذيل)",
 "colaptes auratus cafer": "نقار الخشب أحمر العمود (طائر من غرب الولايات المتحدة ذو سطح سفلي أحمر للأجنحة والذيل)",
 "colaptes caper collaris": "نقار الخشب أحمر العمود (طائر من غرب الولايات المتحدة ذو سطح سفلي أحمر للأجنحة والذيل)",
 "colaptes chrysoides": "نقار الخشب المذهب (طائر من جنوب غرب الولايات المتحدة يشبه نقار الخشب أصفر العمود ولكنه يفتقر إلى الرقبة الحمراء)",
 "colbert": "كولبير (زبدة ممزوجة مع البقدونس والطرخون ومستخلص اللحم)",
 "colbert butter": "كولبير (زبدة ممزوجة مع البقدونس والطرخون ومستخلص اللحم)",
 "colchester": "كولشيستر",
 "colchicine": "كولشيسين (دواء مسكن مشتق من نبات الزعفران (اللحلاح) ويستخدم لعلاج النقرس)",
 "colchicum": "لَحْلَاح",
 "colchicum autumnale": "زعفران الخريف, سورنجان (عشب بصلي يزهر في الخريف بأزهار بيضاء أو أرجوانية أو خزامية وبيضاء؛ موطنه غرب ووسط أوروبا)",
 "cold": "بَارِد, برد (مُنْخَفِض الحَرارة أو حَرارتُه أقلّ من حَرارة جسْم الإنسان؛ غير حامٍ، أو متروك بلا حماوة، غير محميّ على النَّار) / بَرْدَان / بُرُودَة, بَرْد / زُكَام, رَشْح\nمثال: الماء بارد حقا.",
 "cold cash": "سيولة فورية, نقد جاهز (المال في شكل نقد متاح بسهولة)\nمثال: كانت زوجته دائماً مصدراً جيداً للنقد الجاهز",
 "cold cathode": "كاثود بارد (كاثود يعد مصدراً للإلكترونات دون تسخينه)",
 "cold cereal": "حبوب باردة, كورن فليكس (حبوب لا تسخن قبل التقديم)",
 "cold chisel": "أزميل قطع المعادن, إزميل بارد (إزميل ضيق مصنوع من الفولاذ؛ يستخدم لقطع الحجر أو الطوب (أو المعادن الباردة))",
 "cold comfort": "عزاء واهٍ (مواساة أو تعاطف محدود للغاية)\nمثال: أخبرني أن الوقت يشفي كل الجراح لكن ذلك كان عزاءً واهياً لي",
 "cold cream": "كريم بارد, كولد كريم (كريم يستخدم تجميلياً (غالباً من قبل النساء) لتنعيم وتنظيف البشرة)",
 "cold cuts": "لحوم باردة (لحوم باردة مشكلة ومقطعة شرائح)",
 "cold duck": "كولد داك (نبيذ فوار وردي أصله من ألمانيا)",
 "cold feet": "تراجع خوفاً, جبن مفاجئ (الخجل الذي يمنع استمرار مسار العمل)\nمثال: كنت سأخبره لكنني تراجعت خوفاً",
 "cold fish": "شخص بارد, متبلد المشاعر (شخص منطوٍ وغير عاطفي)",
 "cold frame": "إطار بارد, دفيئة باردة (غطاء واقٍ يتكون من إطار خشبي ذي سطح زجاجي تُحمى فيه النباتات الصغيرة من البرد)",
 "cold front": "جبهة باردة (مقدمة كتلة هوائية باردة تتقدم)",
 "cold fusion": "اِنْدِمَاج بَارِد",
 "cold gangrene": "غرغرينا جافة (غرغرينا تتطور في وجود انسداد شرياني وتتميز بجفاف الأنسجة الميتة ولونها البني الداكن)",
 "cold medicine": "دواء البرد (دواء يهدف إلى تخفيف أعراض نزلات البرد الشائعة)",
 "cold medium": "وسيط بارد (وسيط يوفر عادة، ولكن ليس دائماً، القليل من المشاركة مع تحفيز كبير؛ يشمل الكلام والتلفزيون والرسوم المتحركة)",
 "cold rubber": "مطاط بارد (مطاط يصنع في درجات حرارة منخفضة (5 درجات مئوية) وهو أقوى من المطاط التقليدي ويستخدم غالباً في إطارات السيارات)",
 "cold shoulder": "ازدراء, تجاهل (رفض التعرف على شخص تعرفه)\nمثال: كان التجاهل متعمداً بوضوح",
 "cold snap": "موجة برد (فترة من الطقس البارد)",
 "cold sober": "صَاحٍ تَمَامًا (فِي حَالَة صَحْوٍ كَامِل)",
 "cold sore": "قرحة البرد, هربس فموي",
 "cold spell": "موجة برد (فترة من الطقس البارد)",
 "cold storage": "تخزين بارد, تخزين بالتبريد (تخزين مبرد للحفظ) / تجميد, حفظ بارد (في حالة تعليق أو تأجيل)",
 "cold stuffed tomato": "طماطم محشوة باردة (حبات طماطم محشوة بخلطات سلطة متنوعة وتقدم باردة)",
 "cold sweat": "عرق بارد (الحالة الجسدية للتعرق المتزامن مع القشعريرة؛ مرتبطة بالخوف)",
 "cold turkey": "إقلاع مفاجئ, توقف فوري (انسحاب كامل ومفاجئ من جميع العقاقير المسببة للإدمان أو أي شيء آخر يعتمد عليه الشخص) / صراحة تامة (تعبير صريح ومباشر عن الآراء)\nمثال: توقف عن التدخين فجأة",
 "cold war": "الْحَرْب الْبَارِدَة / حَرْب بَارِدَة (حَرَبَ (حربه) بالحربة حربا: طعنه بها؛ حَرَبَ (ه) حربا: سلبه جميع ما يملك)\nمثال: بوتين مجرم حرب.",
 "cold water": "إِحْبَاط, تَثْبِيط (التقليل من شأن خطة أو أمل أو توقع)\nمثال: سكبت الماء البارد على فكرة الذهاب إلى أفريقيا بأكملها",
 "cold wave": "مَوْجَةُ اْلبَرْدِ",
 "cold weapon": "سِلَاح أَبْيَض",
 "cold weather": "طقس بارد (فترة من الطقس البارد بشكل غير عادي)",
 "cold-blooded": "بَارِد الدَّم, عَدِيم الرَّحْمَة (بلا وخز ضمير أو إحساس إنساني) / ذوات الدم البارد (لديه دم بارد (في الحيوانات التي لا يتم تنظيم درجة حرارة جسمها داخليًا))",
 "cold-bloodedly": "بدم بارد, بقسوة متعمدة (بلا عاطفة وبلا رحمة؛ بقسوة متعمدة أو تبلد شعور)\nمثال: خطط لقتل رئيسه بدم بارد",
 "cold-eyed": "مَوْضُوعِيّ, هَادِئُ الحُكْم (غَيْرُ مُتَأَثِّرٍ بِالعَاطِفَةِ القَوِيَّةِ أَوِ التَّحَيُّز)",
 "cold-temperate": "مُعْتَدِلٌ بَارِد (يَصِفُ الأَجْزَاءَ الأَبْرَدَ مِنَ المِيَاهِ المُعْتَدِلَة)",
 "cold-water flat": "شقة بدون ماء ساخن (شقة بدون وسائل الراحة الحديثة)",
 "coldcream": "كريم بارد, كولد كريم (كريم يستخدم تجميلياً (غالباً من قبل النساء) لتنعيم وتنظيف البشرة)",
