 "corn beef": "كورند بيف, لحم بقري مملح (لحم بقر محفوظ أو مخلل في محلول ملحي)",
 "corn borer": "حفار الذرة, عثة حفار الذرة الأوروبي (موطنها الأصلي أوروبا؛ في أمريكا تحفر اليرقات في ساق وتاج الذرة ونباتات أخرى) / حفار الذرة (يرقة عثة حفار الذرة الأوروبي؛ آفة خطيرة للذرة)",
 "corn borer moth": "حفار الذرة, عثة حفار الذرة الأوروبي (موطنها الأصلي أوروبا؛ في أمريكا تحفر اليرقات في ساق وتاج الذرة ونباتات أخرى)",
 "corn cake": "كعكة الذرة (مخبوزة في صينية أو على صاج (في الجنوب والوسط))",
 "corn campion": "خرم الحنطة, زهرة الذرة (نبات حولي أوروبي له أزهار بوقية كبيرة حمراء أرجوانية وبذور سامة؛ عشب ضار شائع في حقول الحبوب وعلى جوانب الطرق؛ مستوطن في أمريكا)",
 "corn chamomile": "أقحوان الحقول, بابونج الحقول (عشبة أوروبية بيضاء الزهور متوطنة في أمريكا الشمالية)",
 "corn chip": "رقائق الذرة (قطعة رقيقة من عجين دقيق الذرة مقلية)",
 "corn chowder": "تشاودر الذرة (تشاودر يحتوي على الذرة)",
 "corn cob": "كوالح الذرة (اللب الأسطواني الصلب الذي يحمل حبات كوز الذرة)",
 "corn cockle": "خرم الحنطة, زهرة الذرة (نبات حولي أوروبي له أزهار بوقية كبيرة حمراء أرجوانية وبذور سامة؛ عشب ضار شائع في حقول الحبوب وعلى جوانب الطرق؛ مستوطن في أمريكا)",
 "corn dab": "كعكة الذرة البيضاوية (كعكة صغيرة بيضاوية من خبز الذرة تخبز أو تقلى)",
 "corn dance": "رقصة الذرة (رقصة مطر للهنود الحمر)",
 "corn dodger": "كعكة الذرة البيضاوية (كعكة صغيرة بيضاوية من خبز الذرة تخبز أو تقلى)",
 "corn dog": "كُورْنْدُوغ",
 "corn earworm": "دودة كوز الذرة (يرقة عثة ليلية؛ مدمرة للغاية خاصة لمحاصيل الذرة والقطن والطماطم)",
 "corn exchange": "بورصة الحبوب (بورصة يتم فيها بيع وشراء الحبوب)",
 "corn field": "حقل ذرة (حقل مزروع بالذرة)",
 "corn flake": "رقائق الذرة, كورن فليكس (رقاقة مقرمشة مصنوعة من الذرة)",
 "corn fritter": "فطيرة الذرة المقلية (فطيرة مقلية تحتوي على الذرة أو حبات الذرة)",
 "corn gluten": "غلوتين الذرة (غلوتين محضر من الذرة)",
 "corn gluten feed": "علف غلوتين الذرة (علف يتكون أساساً من غلوتين الذرة)",
 "corn lily": "زنبق الذرة (أي من النباتات الجنوب أفريقية المتعددة من جنس إيكسيا ذات أوراق عشبية وعناقيد من الزهور التي تشبه الزنبق الملونة بشتى الألوان؛ تزرع على نطاق واسع)",
 "corn liquor": "خمر مهرب, مون شاين (ويسكي مقطر بشكل غير قانوني من هريس الذرة)",
 "corn marigold": "أقحوان الحقول, أقحوان الذرة (عشبة أوروبية بزهور صفراء زاهية؛ عشبة ضارة شائعة في حقول الحبوب)",
 "corn mayweed": "أقحوان الحقول, بابونج الحقول (عشبة أوروبية بيضاء الزهور متوطنة في أمريكا الشمالية) / اقحوان الحقول, بابونج غير معطر",
