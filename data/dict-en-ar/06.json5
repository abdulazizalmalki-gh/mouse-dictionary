 "conception": "حَبَل, حَمْل ((حَبَلَه): شَدّه بالحبْل؛ (حَبَلَه) الصَّيْدَ: نَصَب لَهُ الحِبَالةَ وصاده بهَا. وَيُقَال: حَبَلَت فُلَانَةُ فلَانًا: أوقعَتْه فِي شِباك حُبّها وسحَرته)\nمثال: حبل الكذب قصير.",
 "conceptional": "تَصَوُّرِيّ, مَفْهُومِيّ (من طبيعة المفهوم أو التصوّر الذهني)",
 "conceptive": "قَابِل لِلحَمْل, قَادِر عَلَى الإِنْجَاب (قَادِر عَلَى الحَمْل والإِخْصَاب)",
 "conceptual": "مَفَاهِيمِيّ (يتعلّق بالمفاهيم أو يتّسم بتكوينها)",
 "conceptual semantics": "علم الدلالة المعرفي (فرع علم الدلالة الذي يدرس الجوانب المعرفية للمعنى)",
 "conceptualisation": "تصوّر, صياغة مفاهيمية (ابتكار أو تدبير فكرة أو تفسير وصياغته ذهنيًا) / بلورة المفهوم, تصور مفاهيمي (مفهوم مفصّل أو مطوّر)",
 "conceptualism": "مفاهيمية (المذهب القائل بأن تطبيق مصطلح عام على أشياء مختلفة يشير إلى وجود كيان عقلي يتوسط التطبيق)",
 "conceptualistic": "مفاهيمي (ينطوي على أو من خصائص المذهب المفاهيمي)",
 "conceptuality": "بلورة المفهوم, تصور مفاهيمي (مفهوم مفصّل أو مطوّر)",
 "conceptualization": "تصوّر, صياغة مفاهيمية (ابتكار أو تدبير فكرة أو تفسير وصياغته ذهنيًا) / بلورة المفهوم, تصور مفاهيمي (مفهوم مفصّل أو مطوّر)",
 "conceptualize": "تَصَوَّرَ",
 "conceptually": "تَصَوُّرِيًّا, مَفَاهِيمِيًّا (بطريقة مفاهيمية)\nمثال: لم يعد قادراً على التفكير مفاهيمياً",
 "conceptus": "بيضة مخصبة, جنين (كائن حيواني في المراحل المبكرة من النمو والتمايز)",
 "concern": "خَصَّ (رمى شيئًا صغيرًا، مثل الحصى، بدقة وبسرعة؛ قذف شيئًا بعيدًا بحركة سريعة) / هَمَّ\nمثال: لخص التقرير في صفحة.",
 "concerned": "مُهْتَمّ / مُعْنِيّ",
 "concernedly": "بِاهْتِمَام, بِقَلَق (بطريقة تظهر الاهتمام)\nمثال: 'هل أنت بخير؟' سأل باهتمام",
 "concerning": "فِي مَا يَتَعَلَق بِـ (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "concert": "حَفْلَة / عَزْف, حَفْلَة مُوسِيقِيَّة (والمعزف :الملاهي واحدها معزف ومعزفة)\nمثال: عزف على البيانو.",
 "concert band": "فرقة عسكرية, فرقة موسيقية للحفلات (مجموعة من الموسيقيين يعزفون على الآلات النحاسية وآلات النفخ الخشبية والإيقاعية)",
 "concert dance": "باليه, رقص استعراضي (تمثيل مسرحي لقصة يتم أداؤه على أنغام الموسيقى بواسطة راقصين مدربين)",
 "concert grand": "بيانو الحفلات الكبير, بيانو كونسيرت (بيانو كبير مناسب للعروض الموسيقية والحفلات)",
 "concert hall": "قاعة حفلات موسيقية (قاعة تُقام فيها الحفلات الموسيقية)",
 "concert piano": "بيانو الحفلات الكبير, بيانو كونسيرت (بيانو كبير مناسب للعروض الموسيقية والحفلات)",
 "concert pitch": "دوزان الحفلات, طبقة الحفلات",
 "concert-goer": "محب للموسيقى, مرتاد الحفلات الموسيقية (شخص يحضر الحفلات الموسيقية)",
 "concerted": "تَعَاوُنِيّ, مُشْتَرَك (ينطوي على نشاط مشترك بين اثنين أو أكثر)",
 "concerted music": "بوليفونية, تعدد الأصوات (موسيقى مرتبة في أجزاء لعدة أصوات أو أدوات)",
 "concertina": "كونسرتينا (آلة ذات قصبات حرة تُعزف مثل الأكورديون عن طريق دفع طرفيها معاً لإجبار الهواء عبر القصبات) / سلك شائك ملفوف, كونسرتينا (سلك شائك ملفوف يستخدم كعائق)",
 "concertina fold": "طية الأكورديون, طية متعرجة (طي متوازي مستمر بطريقة تشبه الأكورديون)",
 "concertinist": "عازف كونسرتينا (شخص يعزف على الكونسرتينا)",
 "concerto": "كونشرتو (تأليف للأوركسترا وعازف منفرد)",
 "concerto grosso": "كونشرتو جروسو (تأليف باروكي للأوركسترا ومجموعة من الآلات المنفردة)",
 "concession": "امتياز (عقد يمنح الحق في تشغيل عمل فرعي) / إذعان, تنازل (فعل التنازل أو الإذعان) / تنازل (نقطة يتم التنازل عنها أو التسليم بها)\nمثال: حصل على امتياز البيرة في ملعب الكرة",
 "concessionaire": "صاحب امتياز (شخص يحمل أو يدير حق امتياز تجاري)",
 "concessioner": "صاحب امتياز (شخص يحمل أو يدير حق امتياز تجاري)",
 "concessive": "استدراكي, تنازلي (من أو متعلق بالتنازل أو الاستدراك)",
 "concessive adverbial": "ظرف استدراك, عبارة استدراكية (عبارة ظرفية تعبر عن فكرة توحي بعكس الجزء الرئيسي من الجملة)",
 "conch": "كونش, محار الملك",
 "concha": "مَحَارَة ((في التشريح) بنية تشبه الصدفة في شكلها)",
 "conchfish": "سمكة المحار (توجد في جزر الهند الغربية؛ تعيش في تجويف عباءة محار حي)",
 "conchoid": "منحنى محاري (عائلة من المنحنيات تُعرف بأنها المحل الهندسي لنقاط تحقق شروطاً معينة تتعلق بنقطة ثابتة ومنحنى معطى)",
 "conchoid of nicomedes": "محارية نيقوميدس (المنحنى المحاري لخط مستقيم بالنسبة لنقطة ليست على الخط)",
 "conchologist": "جامع القواقع, عالم المحاريات (جامع ودارس لأصداف الرخويات)",
 "conchology": "جمع الأصداف, علم الأصداف (جمع ودراسة أصداف الرخويات)",
 "concierge": "بَوَّاب, كُونسِيرج (موظف في مبنى سكني أو فندق يعيش في المبنى ويشرف على الدخول والخروج ويتعامل مع البريد)",
 "conciliable": "قَابِل لِلتَّهْدِئَة, قَابِل لِلْإِرْضَاء (يمكن تهدئته واسترضاؤه)",
 "conciliation": "ترضية, مصالحة (فعل الترضية والتغلب على عدم الثقة والعداء) / توفيق, مصالحة (أي من أشكال الوساطة المختلفة التي يمكن من خلالها تسوية النزاعات قبل الوصول للتحكيم) / توفيق, مصالحة (حالة إظهار النوايا الحسنة والتعاون بعد التصالح)\nمثال: كانت هناك فترة وجيزة من المصالحة لكن القتال سرعان ما استؤنف",
 "conciliative": "تصالحي, توحيقي (يهدف إلى الاسترضاء أو التهدئة)\nمثال: تحدث بنبرة تصالحية",
 "conciliator": "صانع سلام, موفِّق (شخص يحاول إحلال السلام)",
 "conciliatory": "تصالحي, توحيقي (يهدف إلى الاسترضاء أو التهدئة) / توفيقي, مرن (يقدم أو مستعد لتقديم تنازلات)\nمثال: تحدث بنبرة تصالحية",
 "concise": "وَجِيز, مُوجَز",
 "concisely": "بِإِيجَاز, بِاخْتِصَار (بطريقة موجزة؛ في بضع كلمات)\nمثال: التاريخ ملخص بإيجاز في هذا الكتاب",
 "conciseness": "إيجاز, بلاغة الإيجاز (الإيجاز والاقتصاد في الكتابة والتحدث من خلال التعبير عن الكثير في بضع كلمات فقط)",
 "concision": "إيجاز, بلاغة الإيجاز (الإيجاز والاقتصاد في الكتابة والتحدث من خلال التعبير عن الكثير في بضع كلمات فقط)",
 "conclave": "المجمع المغلق",
 "concluded": "تَامّ, مُنْتَهٍ (بَلَغَ خِتَامَهُ أَوْ وَصَلَ إِلَى نِهَايَتِهِ)",
 "concluding": "أَخِير, خِتَامِيّ (يَقَعُ فِي نِهَايَةِ شَيْءٍ أَوْ يُشَكِّلُ خَاتِمَتَهُ)",
 "conclusion": "نَتِيجَة",
 "conclusion of law": "استنتاج قانوني (استنتاج بشأن قابلية تطبيق قاعدة قانونية على وقائع معينة)",
 "conclusive": "نِهَائِيّ / قَطْعِيّ",
 "conclusively": "بشكل قاطع, بشكل نهائي (بطريقة حاسمة)\nمثال: سوينا المشكلة بشكل قاطع",
 "conclusiveness": "حَسْم, قَطْعِيَّة (صفة كون الشيء نهائياً أو محسوماً بشكل قاطع)\nمثال: نهائية الموت",
 "concoction": "تحضير, توليفة (فعل إيجاد شيء (دواء أو شراب أو حساء، إلخ) عن طريق تركيب أو خلط مجموعة متنوعة من المكونات) / اختلاق, تلفيق (اختراع مخطط أو قصة لتناسب غرضًا ما) / توليفة, خلطة (حدوث خليط غير عادي) / خليط, مزيج (أي مادة غذائية تصنع بجمع مكونات مختلفة)\nمثال: كانت شهادته محض اختلاق",
 "concomitance": "تلازم, مرافقة (حدوث أو وجود معاً أو باتصال مع بعضهما البعض)",
 "concomitant": "مُتَرَتِّب, مُصَاحِب (يحدث بالتزامن مع شيء آخر أو نتيجةً له) / تزامن, مرافقة (حدث أو موقف يحدث في نفس الوقت أو بالارتباط مع آخر)",
 "concord": "سِلْمِيّ",
 "concord grape": "عنب كونكورد (عنب سهل التقشير؛ عنب مائدة أرجواني من شمال شرق الولايات المتحدة)",
 "concordance": "كشاف (فهرس لجميع الكلمات الرئيسية في كتاب مع سياقاتها المباشرة) / انسجام, وئام (اتفاق الآراء) / انسجام, توافق (حالة متناغمة للأشياء بشكل عام وخصائصها (مثل الألوان والأصوات)؛ توافق الأجزاء مع بعضها البعض ومع الكل)",
 "concordant": "مُتَوَافِق, مُتَّفِقُ الرَّأْيِ (يَحْمِلُ الرَّأْيَ ذَاتَهُ) / مُتَوَافِق, مُنْسَجِم (مُتَّسِقٌ وَمُتَنَاسِقٌ)",
 "concordat": "اتفاقية, عهد (اتفاق مكتوب وموقع بين طرفين أو أكثر (دول) للقيام بعمل ما)",
 "concourse": "احتشاد, تجمهر (تجمع الناس معاً) / بهو, ساحة رئيسية (ردهة واسعة في مبنى حيث يمكن للناس المشي) / جمهور, حشد كبير (تجمع كبير للناس)",
 "concrete": "مَادِّيّ / خَرَسَانَة",
 "concrete jungle": "غابة أسمنتية (منطقة في مدينة ذات مبان حديثة كبيرة يُنظر إليها على أنها خطيرة وغير سارة)",
 "concrete mixer": "خلاطة خرسانة (آلة ذات أسطوانة دوارة كبيرة يتم فيها خلط الأسمنت مع مواد أخرى لصنع الخرسانة)",
 "concrete noun": "اِسْمُ ذَاتٍ (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)\nمثال: ما اسم حصان توم؟",
 "concrete poem": "شعر بصري, شعر ملموس (قصيدة يتم نقل معناها من خلال شكلها الرسومي أو نمطها على الصفحة المطبوعة)",
 "concrete representation": "تجسيد, تمثيل ملموس (تمثيل فكرة مجردة بمصطلحات ملموسة)",
 "concrete vibrator": "رجاج الباطون, هزاز الخرسانة (هزاز صناعي يعمل على دمج الخرسانة المصبوبة حديثاً بحيث يتم إخراج الهواء المحبوس والماء الزائد وتستقر الخرسانة بقوة في القوالب)",
 "concretely": "بشكل ملموس, عملياً (بمصطلحات ملموسة)\nمثال: عملياً، هذا يعني أنه كان مفلساً",
 "concreteness": "عِيَانِيَّة, مَلْمُوسِيَّة (صفة كون الشيء ملموساً (وليس مجرداً))",
 "concretion": "التحام, اندماج (اتحاد أشياء متنوعة في جسم أو شكل أو مجموعة واحدة؛ نمو الأجزاء معاً) / تصلب, تكثيف (زيادة في كثافة شيء ما) / تَكَلُّس, حَصَاة (كتلة صلبة ناتجة عن تكتل الأملاح المعدنية؛ توجد في الأعضاء المجوفة أو قنوات الجسم) / تحصي (تشكل أجسام تشبه الحجارة داخل عضو في الجسم (مثل الكلى))\nمثال: حصوات الكلى يمكن أن تكون مؤلمة جداً",
 "concretism": "تجسيد, تمثيل ملموس (تمثيل فكرة مجردة بمصطلحات ملموسة)",
 "concretistic": "تجسيدي (من أو متعلق بالتمثيل الملموس للمفاهيم المجردة)\nمثال: عبارة تبدو تجسيدية",
 "concubinage": "تسرّي, مساكنة غير شرعية (المساكنة دون زواج قانوني)",
 "concubine": "سُرِّيَة",
 "concupiscence": "رغبة جنسية, شهوة (رغبة في الحميمية الجنسية)",
 "concupiscent": "شَبِق, شَهْوَانِيّ (عَنِيفُ الشَّهْوَةِ وَالرَّغْبَة)",
 "concurrence": "تَزَامُن, تَوَافُق (العمل معاً، كوكلاء أو ظروف أو أحداث) / تزامن, تصادف (الخاصية الزمنية لحدوث شيئين في نفس الوقت) / تزامن, توافق (اتفاق النتائج أو الآراء) / تلاقى الأفكار, توافق (حالة من التعاون)\nمثال: الفاصل الزمني الذي يحدد بوابة التزامن قابل للتعديل",
 "concurrency": "تَزَامُن, تَوَافُق (العمل معاً، كوكلاء أو ظروف أو أحداث) / تزامن, توافق (اتفاق النتائج أو الآراء)",
 "concurrent": "آنِيّ, مُتَزَامِن (يحدث أو يعمل في نفس الوقت)",
 "concurrent execution": "برمجة متعددة, تنفيذ متزامن (تنفيذ برنامجين أو أكثر بواسطة كمبيوتر واحد)",
 "concurrent negligence": "إهمال متزامن ((قانون) إهمال شخصين أو أكثر يتصرفون بشكل مستقل؛ يمكن للمدعي مقاضاتهم معاً أو بشكل منفصل)",
 "concurrent operation": "عملية متزامنة (عمليتان أو أكثر يتم إجراؤهما في نفس الوقت (أو ضمن فترة زمنية معينة))",
 "concurrently": "بالتزامن, في نفس الوقت (متداخل في المدة)\nمثال: بالتزامن مع المؤتمر أقيم معرض للأشياء المرتبطة برذرفورد",
 "concurring opinion": "رأي موافق (رأي يتفق مع تصرف المحكمة في القضية ولكنه مكتوب للتعبير عن منطق قاضٍ معين)",
 "concussion": "اِرْتِجَاج (مصدر الفعل \"ارْتَجَّ\")",
 "condemnable": "مَذْمُوم, مُسْتَنْكَر (يستحقّ التوبيخ أو اللوم الشديد)",
 "condemnation": "إِدَانَة",
 "condemnatory": "إِدَانِيّ, شَاجِب (يتضمن أو يفرض الإدانة أو التوبيخ)",
 "condemned": "محكوم (خاضِع إِدَارَةحُكُوْمَة؛ الَّذي صَدَرَحُكْمٌ بحقِّه)",
 "condemning": "إِدَانِيّ, شَاجِب (يتضمن أو يفرض الإدانة أو التوبيخ)",
 "condensate": "تكثف, ندى (رطوبة جوية تكثفت بسبب البرودة) / مُتكاثف (ناتج عملية التكثيف)",
 "condensation": "تكثيف, تكميد (فعل زيادة كثافة شيء ما) / تكثيف ((التحليل النفسي) عملية لاواعية تتحد فيها فكرتان أو صورتان في رمز واحد؛ خاصة في الأحلام) / إيجاز, تهذيب (نسخة مختصرة من عمل مكتوب) / انضغاط, تقلص (عملية أو نتيجة أن يصبح الشيء أصغر أو مضغوطاً معاً)\nمثال: تقلص الغاز عند التبريد",
 "condensation pump": "مضخة انتشار, مضخة تكثيف (مضخة تفريغ تستخدم للحصول على فراغ عالي)",
 "condensation trail": "أثر التكثف, ذيل بخاري (سحابة اصطناعية تصنعها طائرة؛ ناتجة إما عن التكثف بسبب انخفاض ضغط الهواء فوق سطح الجناح أو عن بخار الماء في عادم المحرك)",
 "condensed milk": "حَلِيب مَكْثِف (هو اللَبَن المَحْلُوْب، أو ما لم يتغير طعمه. أصل التسمية؛ هو ما لم يَرُوْب واللَبَن هو ما رَابَ)\nمثال: كنت أشرب الحليب",
 "condenser": "مكثف (جهاز كهربائي يتميز بقدرته على تخزين شحنة كهربائية) / مكثف ضوئي (عدسة تستخدم لتركيز الضوء على جسم ما) / مكثف (ملف مجوف يقوم بالتكثيف عن طريق سحب الحرارة) / مكثف (جهاز يحول البخار إلى سائل)",
 "condenser microphone": "ميكروفون مكثف (ميكروفون يتكون من مكثف بلوح ثابت وآخر يشكل الحجاب الحاجز الذي تحركه الموجات الصوتية)",
 "condenser mike": "ميكروفون مكثف (ميكروفون يتكون من مكثف بلوح ثابت وآخر يشكل الحجاب الحاجز الذي تحركه الموجات الصوتية)",
 "condensing": "تكثيف, تكميد (فعل زيادة كثافة شيء ما)",
 "condensing turbine": "توربين تكثيف, عنفة تكثيف (توربين بخاري يفرغ البخار من المرجل بضغط أقل بكثير من الضغط الجوي إلى مكثف)",
 "condescending": "مُتَعَال, اِسْتِعْلَائِيّ",
 "condescendingly": "بِاسْتِعْلَاء, بِتَعَالٍ (مع التعالي؛ بطريقة فوقية)\nمثال: يعامل سكرتيرته بتعالٍ",
 "condescendingness": "تفضل, تواضع (اللطف مع من هم دونك وتجاهل مؤقت لفوارق المكانة أو الرتبة)\nمثال: كان تفضل الملكة يهدف إلى جعلنا نشعر بالراحة",
 "condescension": "تفضل, تواضع (اللطف مع من هم دونك وتجاهل مؤقت لفوارق المكانة أو الرتبة) / تعال, تكبر (سمة إظهار الغطرسة من خلال معاملة من يعتبرون أدنى منزلة بفوقية) / ازْدِرَاء, تَعَالٍ (تواصل يشير إلى عدم الاحترام من خلال معاملة المتلقي بفوقية)\nمثال: كان تفضل الملكة يهدف إلى جعلنا نشعر بالراحة",
 "condign": "مُسْتَحَقّ, وَافٍ (ملائم ومناسب ومستحقّ؛ يُستخدم خاصة مع العقوبة)",
 "condiment": "تَابِل",
 "condition": "شَرْط (شَرِطَ فلانٌ يَشْرِطِ شَرْطًا: وقع في أَمر عظيمٍ)\nمثال: صرخ ليون: \"شرطة!\"",
 "conditional": "شَرْطِيّ (أحد المنتسبين إلى الشُرْطَة)\nمثال: تبدو وكأنك شرطي.",
 "conditional contract": "عقد مشروط (عقد يعتمد أداؤه على حقيقة أو حدث يؤثر على العلاقات القانونية)",
 "conditional probability": "احتمال مشروط (احتمال وقوع حدث ما بالنظر إلى وقوع حدث أو أحداث أخرى)",
 "conditional reaction": "منعكس شرطي, منعكس مكتسب (استجابة مكتسبة تخضع لسيطرة (مشروطة بحدوث) محفز)",
 "conditional reflex": "منعكس شرطي, منعكس مكتسب (استجابة مكتسبة تخضع لسيطرة (مشروطة بحدوث) محفز)",
 "conditional relation": "اسْتِلْزَام, تَضَمُّن مَنْطِقِيّ (مصدر الفعل \"استلزم\"، ويعني: الحاجة إلى شيء أو شرط ضروري لحدوث أمر آخر؛ قد يشير إلى التورط في شيء ما أو وجود ارتباط ضروري بين شيئين)",
 "conditional response": "منعكس شرطي, منعكس مكتسب (استجابة مكتسبة تخضع لسيطرة (مشروطة بحدوث) محفز)",
 "conditional sale": "بيع مشروط (بيع يتلقى فيه المشتري سند الملكية فقط عند أداء شرط ما (عادة دفع سعر الشراء بالكامل)) / بيع مشروط (مصلحة ضمان يأخذها البائع مقابل الائتمان)",
 "conditional sentence": "جُمْلَة شَرْطِيَّة (مؤنث جُمْل، وهو الحبل الغليظ أو الجماعة من الناس؛ المَجْمُوع)\nمثال: يا لها من جملة!",
 "conditionality": "تقييد بشرط, شرطية (حالة كونه مشروطاً)",
 "conditionally": "بِشَكْل مَشْرُوط, بِشُرُوط (خاضع لشرط)\nمثال: قبل العرض بشروط",
 "conditioned": "بِلِيَاقَةٍ بَدَنِيَّة, مُتَمَرِّن (فِي حَالَةٍ بَدَنِيَّةٍ جَيِّدَةٍ) / شرطي, متعلم (تم تثبيته عن طريق الاشتراط أو التعلم)\nمثال: استجابة شرطية",
 "conditioned avoidance": "استجابة تجنب شرطية, تجنب شرطي (استجابة شرطية تتوقع حدوث محفز منفر)",
 "conditioned avoidance response": "استجابة تجنب شرطية, تجنب شرطي (استجابة شرطية تتوقع حدوث محفز منفر)",
 "conditioned emotion": "استجابة عاطفية مشروطة, انفعال شرطي (استجابة عاطفية تم اكتسابها عن طريق الإشراط)",
 "conditioned emotional response": "استجابة عاطفية مشروطة, انفعال شرطي (استجابة عاطفية تم اكتسابها عن طريق الإشراط)",
 "conditioned reaction": "منعكس شرطي, منعكس مكتسب (استجابة مكتسبة تخضع لسيطرة (مشروطة بحدوث) محفز)",
 "conditioned reflex": "منعكس شرطي, منعكس مكتسب (استجابة مكتسبة تخضع لسيطرة (مشروطة بحدوث) محفز)",
 "conditioned response": "منعكس شرطي, منعكس مكتسب (استجابة مكتسبة تخضع لسيطرة (مشروطة بحدوث) محفز)",
 "conditioned stimulus": "مثير شرطي (المثير الذي يكون مناسبة لاستجابة شرطية)",
 "conditioner": "تمرين مكيف (تمرين يكيف الجسم أو يحسن حالته) / ملطف, منعم (مادة تستخدم في الغسيل (الملابس أو الشعر) لجعل الأشياء أكثر نعومة) / مدرب لياقة (مدرب للرياضيين)\nمثال: يمكن أن يكون العمل في المزرعة تمريناً مكيفاً جيداً",
 "conditioning": "تَكْيِيف",
 "conditions": "أحوال جوية, طقس (الظروف الجوية التي تشكل حالة الغلاف الجوي من حيث درجة الحرارة والرياح والسحب والهطول) / أحوال, ظروف معيشية (مجموعة الظروف التي تؤثر على رفاهية شخص ما) / شروط, ظروف (السياق السائد الذي يؤثر على أداء أو نتيجة عملية ما)\nمثال: كانوا يأملون في طقس جيد",
 "condo": "شقة تمليك (واحدة من الوحدات السكنية في مجمع سكني تمليك)",
 "condolence": "تَأْسِيَة / تَعْزِيَة",
 "condolent": "مُعَزٍّ (يُعبر عن التعاطف مع شخص فقد عزيزًا)",
 "condom": "عَازِل ذَكَرِيّ / وَاقٍ ذَكَرِيّ / كُونْدُوم / كَانْدُوم / عَازِل طِبِّيّ",
 "condominium": "مجمع سكني تمليك (إسكان يتكون من مجمع من الوحدات السكنية (كمبنى سكني) تكون فيه كل وحدة مملوكة بشكل فردي) / شقة تمليك (واحدة من الوحدات السكنية في مجمع سكني تمليك)",
 "condonation": "تغاضي, صفح (عفو عن طريق معاملة المخالف وكأن المخالفة لم تحدث)",
 "condor": "كُنْدُور",
 "conducive": "مُسَاعِد, مُسَاهِم (يميل إلى الإحداث؛ مسؤول جزئيًّا عن حدوث شيء)",
 "conduct": "تصرف, سلوك (طريقة التصرف أو التحكم بالنفس) / تصرف, سلوك ((السمات السلوكية) الطريقة التي يتصرف بها الشخص تجاه الآخرين)",
 "conductance": "موصلية (قدرة المادة على توصيل الكهرباء؛ تقاس كمقلوب للمقاومة الكهربائية)",
 "conductance unit": "وحدة موصلية (مقياس لقدرة المادة على توصيل شحنة كهربائية)",
 "conducting": "قيادة موسيقية (توجيه فرقة موسيقية أو جوقة) / إدارة (طريقة إدارة الأعمال التجارية)",
 "conducting wire": "سلك, سلك موصل (موصل معدني يحمل الكهرباء لمسافة)",
 "conduction": "توصيل, موصلية (انتقال الحرارة أو الكهرباء أو الصوت)",
 "conduction anaesthesia": "تخدير توصيلي, حصر العصب (تخدير منطقة يغذيها عصب معين؛ يتم عن طريق تطبيق عامل مخدر على العصب)",
 "conduction anesthesia": "تخدير توصيلي, حصر العصب (تخدير منطقة يغذيها عصب معين؛ يتم عن طريق تطبيق عامل مخدر على العصب)",
 "conduction aphasia": "حبسة ترابطية, حبسة توصيلية (حبسة يُفترض أن الآفة فيها تقع في مسارات الترابط التي تصل بين مراكز اللغة المختلفة في الدماغ؛ يجد المريض صعوبة في تكرار جملة سمعها للتو)",
 "conduction deafness": "فقدان السمع التوصيلي (فقدان السمع بسبب مشاكل في عظام الأذن الوسطى)",
 "conductive": "موصل (لديه خاصية أو قدرة توصيل الحرارة أو الكهرباء أو الصوت؛ يظهر موصلية)",
 "conductive hearing loss": "فقدان السمع التوصيلي (فقدان السمع بسبب مشاكل في عظام الأذن الوسطى)",
 "conductivity": "توصيل, موصلية (انتقال الحرارة أو الكهرباء أو الصوت)",
 "conductor": "قَائِدُ فِرْقَاتٍ مُوسِيقِيَّةٍ / كُمْسَرِيّ, كُمْسَارِيّ / مُوَصِّل كَهْرَبَائِيّ, مُوَصِّل",
 "conductress": "قائدة, قاطعة تذاكر (امرأة تعمل كقائدة أو قاطعة تذاكر)",
 "conduit": "أنبوب, قناة (ممر (أنبوب أو نفق) يمكن أن تمر عبره المياه أو الأسلاك الكهربائية)\nمثال: تم توصيل الحواسيب من خلال نظام من القنوات",
 "condylar": "لقمي (من أو متعلق بـ أو يشبه اللقمة (نتوء عظمي))",
 "condylar process": "لقمة الفك السفلي, نتوء لقمي (لقمة فرع الفك السفلي التي تتمفصل مع الجمجمة)",
 "condyle": "لقمة (نتوء دائري على عظم حيث يشكل مفصلاً مع عظم آخر)",
 "condylion": "لقيمية (نقطة قياس القحف عند طرف لقمة الفك السفلي)",
 "condyloid process": "لقمة الفك السفلي, نتوء لقمي (لقمة فرع الفك السفلي التي تتمفصل مع الجمجمة)",
 "condyloma acuminatum": "ثؤلول تناسلي (ثؤلول حميد صغير على أو حول الأعضاء التناسلية والشرج)",
 "condylura cristata": "خلد نجمي الأنف (خلد برمائي من شرق أمريكا الشمالية له مجسات لحمية وردية حول الأنف)",
 "cone": "مَخْرُوط (اسم المفعول من خَرَطَ؛ (هندسة) مُجَسَّمٌ يبتدئُّ من سَطْحٍ دائريٍّ أَو مستدير ويرتفع مستدقا حتى ينتهي إلى نُقْطةٍ أَو سطحٍ أصْغرَ من قاعِدَته)",
 "cone cell": "خلية مخروطية, مخروط (خلية مستقبلة بصرية في الشبكية حساسة للضوء الساطع والألوان)",
 "cone clutch": "قابض مخروطي (قابض احتكاكي تكون فيه أسطح الاحتكاك مخروطية الشكل)",
 "cone friction clutch": "قابض مخروطي (قابض احتكاكي تكون فيه أسطح الاحتكاك مخروطية الشكل)",
 "cone pepper": "فلفل مخروطي (نبات يحمل ثماراً حمراء أو صفراء أو أرجوانية مخروطية منتصبة لاذعة؛ يزرع أحياناً للزينة)",
 "cone shape": "شكل مخروطي, مخروط (شكل قاعدته دائرة وتستدق جوانبه لتصل إلى نقطة)",
 "cone-bearing": "صَنَوْبَرِيّ, مَخْرُوطِيّ (متعلق بالأشجار أو الشجيرات الحاملة للمخاريط وذات الأوراق الدائمة الخضرة)",
 "cone-nosed bug": "بق مخروطي الأنف (بق كبير ماص للدماء)",
 "cone-shaped": "مخروطي (متعلق بالمخروط أو يشبهه)\nمثال: جبال مخروطية",
 "coneflower": "ردبكية, زهرة المخروط (أي من نباتات معمرة متنوعة في شرق الولايات المتحدة لها أوراق سميكة خشنة وزهور مبهرجة طويلة السيقان بأشعة متدلية ومركز يشبه المخروط) / راتيبيدا, زهرة المخروط / ردبكية, زهرة المخروط (أي من نباتات مختلفة من جنس الردبكية تُزرع لأقحوانها الكبير الذي يكون عادة أصفر مع مخاريط مركزية بارزة)",
 "conelike": "مخروطي (متعلق بالمخروط أو يشبهه)\nمثال: جبال مخروطية",
 "conenose": "بق مخروطي الأنف (بق كبير ماص للدماء)",
 "conenose bug": "بق مخروطي الأنف (بق كبير ماص للدماء)",
 "conepatus leuconotus": "ظربان خنزيري الأنف (ظربان كبير عاري الخطم ذو ظهر وذيل أبيض؛ من جنوب غرب أمريكا الشمالية والمكسيك)",
 "conessi": "شجرة العاج, كورشي (شجرة آسيوية استوائية ذات خشب أبيض صلب ولحاء كان يستخدم سابقاً كعلاج للدوسنتاريا والإسهال)",
 "conestoga": "عربة كونستوجا, عربة مغطاة (عربة كبيرة بعجلات عريضة وسقف قماشي مقوس؛ استخدمها الرواد الأمريكيون لعبور البراري في القرن التاسع عشر)",
 "conestoga wagon": "عربة كونستوجا, عربة مغطاة (عربة كبيرة بعجلات عريضة وسقف قماشي مقوس؛ استخدمها الرواد الأمريكيون لعبور البراري في القرن التاسع عشر)",
 "coney": "أرنب (أي من حيوانات حفر متنوعة من فصيلة الأرانب ذات آذان طويلة وذيول قصيرة؛ بعضها مستأنس ويُربى كحيوانات أليفة أو للطعام) / بيكا (ثديي حفار صغير قصير الأذن من المرتفعات الصخرية في آسيا وغرب أمريكا الشمالية) / وبر (أي من الثدييات الصغيرة ذات الحوافر في أفريقيا وآسيا ذات قواطع تشبه القوارض وأقدام ذات أصابع تشبه الحوافر) / كوني (سمكة مرقطة بالأسود عادة ما تكون داكنة اللون ذات زعانف مائلة للاحمرار)",
 "confab": "حديث ودي, دردشة (محادثة غير رسمية)",
 "confabulation": "اختلاق الذاكرة, تخريف ((في الطب النفسي) ذكرى معقولة ولكنها متخيلة تملأ الفجوات فيما يتم تذكره) / حديث ودي, دردشة (محادثة غير رسمية)",
 "confect": "حلوى, سكاكر (حلوى غنية مصنوعة من السكر المنكه وغالباً ما تخلط مع الفاكهة أو المكسرات)",
 "confection": "حَلْوَى",
 "confectionary": "متجر سكاكر, محل حلويات (متجر لصنع أو بيع الحلويات والسكاكر)",
 "confectioner": "حَلْوَانِيّ",
 "confectionery": "صناعة الحلويات, مهنة الحلواني (مهنة ومهارات صانع الحلويات) / متجر سكاكر, محل حلويات (متجر لصنع أو بيع الحلويات والسكاكر) / سكاكر, صناعة الحلويات (الحلوى والسكاكر الأخرى كصنف جماعي)\nمثال: قررت الشركة التركيز على السكاكر والمشروبات الغازية",
 "confederacy": "تحالف, مؤامرة (اتفاق سري بين شخصين أو أكثر للقيام بعمل غير قانوني) / تحالف تآمري, مؤامرة (مجموعة من المتآمرين متحدين معاً لتحقيق غرض ضار أو غير قانوني) / اتحاد, كونفدرالية (اتحاد لمنظمات سياسية)",
 "confederate": "كُونْفِدِرَالِيّ (متعلق بالكونفدرالية الجنوبية أثناء الحرب الأهلية الأمريكية) / كُونْفِدِرَالِيّ, مُتَحَالِف (متحد في تحالف أو رابطة) / شريك في الجريمة, متواطئ (شخص ينضم إلى آخر في تنفيذ خطة (خاصة خطة غير أخلاقية أو غير قانونية)) / متآمر, متواطئ (شخص يساعد في مؤامرة)",
 "confederate army": "الجيش الكونفدرالي (الجيش الجنوبي خلال الحرب الأهلية الأمريكية)",
 "confederate flag": "النجوم والقضبان, علم الكونفدرالية (أول علم للولايات الكونفدرالية الأمريكية)",
 "confederate jasmine": "ياسمين نجمي (متسلق خشبي صيني دائم الخضرة ذو أوراق خضراء داكنة لامعة وأزهار بيضاء شديدة العطرية)",
 "confederate rose": "ورد القطن, ورد كونفدرالي (شجيرة صينية أو شجرة صغيرة ذات زهور بيضاء أو وردية تصبح حمراء داكنة في الليل؛ تزرع على نطاق واسع؛ متوطنة في جنوب شرق الولايات المتحدة)",
 "confederate rose mallow": "ورد القطن, ورد كونفدرالي (شجيرة صينية أو شجرة صغيرة ذات زهور بيضاء أو وردية تصبح حمراء داكنة في الليل؛ تزرع على نطاق واسع؛ متوطنة في جنوب شرق الولايات المتحدة)",
 "confederate soldier": "جندي كونفدرالي (جندي في جيش الاتحاد الكونفدرالي خلال الحرب الأهلية الأمريكية)",
 "confederation": "كُونْفِدِرَالِيَّة",
 "confederative": "كُونْفِدِرَالِيّ, مُتَحَالِف (متحد في تحالف أو رابطة)",
 "confer": "أَفْضَلَ, مَنَحَ / تَآمَرَ",
 "conferee": "عضو مؤتمر (عضو في مؤتمر) / متلقي, ممنوح (شخص يُمنح شيئاً)",
 "conference": "مُؤْتَمَر",
 "conference call": "مكالمة جماعية, مكالمة مؤتمرية (مكالمة هاتفية يشارك فيها أكثر من شخصين)",
 "conference center": "مركز مؤتمرات (مركز يمكن فيه عقد المؤتمرات)",
 "conference house": "مركز مؤتمرات (مركز يمكن فيه عقد المؤتمرات)",
 "conference room": "غرفة اجتماعات (غرفة يمكن عقد مؤتمر فيها)",
 "conference table": "طاولة اجتماعات (الطاولة التي يجلس حولها المجتمعون أثناء عقد اجتماع)",
 "conferment": "إسباغ, تقليد (فعل منح شرف أو تقديم هدية)",
 "conferral": "إسباغ, تقليد (فعل منح شرف أو تقديم هدية)",
