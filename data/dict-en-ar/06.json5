 "contiguous": "مُبَاشِر, مُتَّصِل (قريب جداً أو متصل في المكان أو الزمان) / مُتَاخِم, مُجَاوِر (لَهُ حُدُودٌ أَوْ حَوَافٌّ مُشْتَرَكَةٌ؛ مُلَاصِقٌ وَمُلَامِسٌ) / مُتَلَاصِق, مُتَّصِل (مُتَّصِلٌ دُونَ انْقِطَاعٍ؛ ضِمْنَ حُدُودٍ مُشْتَرَكَةٍ)",
 "contiguousness": "تَجَاوُر, تَلَاصُق (صفة القرب الشديد لدرجة التلامس)",
 "continence": "تعفف, عفة (ممارسة ضبط النفس في الأمور الجنسية) / استمساك (التحكم الطوعي في الإخراج البولي والبرازي)",
 "continency": "تعفف, عفة (ممارسة ضبط النفس في الأمور الجنسية)",
 "continent": "قَارَّة",
 "continent-wide": "عَلَى مُسْتَوَى القَارَّة (يشمل القارة بأكملها)",
 "continental": "قَارِّيّ",
 "continental army": "الجيش القاري (الجيش الأمريكي خلال الثورة الأمريكية)",
 "continental breakfast": "إفطار كونتيننتال (إفطار يشمل عادة خبزاً وقهوة أو شاياً)",
 "continental congress": "الكُونْغَرِس القَارِّيّ (الجمعية التشريعية المكونة من مندوبين من المستعمرات المتمردة الذين اجتمعوا خلال وبعد الثورة الأمريكية؛ أصدروا إعلان الاستقلال وصاغوا مواد الكونفدرالية)",
 "continental divide": "خط تقسيم المياه القاري (مستجمع مائي لقارة (خاصة مستجمع أمريكا الشمالية الذي تشكله سلسلة من الجبال تمتد من ألاسكا إلى المكسيك))",
 "continental drift": "اِنْجِرَاف القَارِّيّ",
 "continental glacier": "نهر جليدي قاري (نهر جليدي ينتشر من كتلة جليدية مركزية)",
 "continental plan": "خطة أوروبية, خطة كونتيننتال (خطة فندقية توفر إفطاراً خفيفاً (كونتيننتال) يومياً)",
 "continental quilt": "دوفيت, لحاف ريشي (لحاف ناعم محشو عادة بريش البط)",
 "continental shelf": "رصيف قاري (قاع البحر الضحل نسبياً (حتى 200 متر) المحيط بالقارة)",
 "continental slope": "منحدر قاري (الانحدار الحاد لقاع البحر من الرصيف القاري إلى المنطقة السحيقة)",
 "contingence": "احتمالية, طارئ (حدث أو واقعة أو نتيجة محتملة)",
 "contingency": "احتمالية, طارئ (حدث أو واقعة أو نتيجة محتملة) / احتمال, طوارئ (حالة كون الشيء مشروطاً بشيء آخر)",
 "contingency fee": "أتعاب مشروطة (أتعاب تُدفع فقط إذا كانت النتيجة ناجحة (كما هو الحال بالنسبة لخدمات المحامي))",
 "contingency procedure": "إجراء طوارئ (بديل للإجراء العادي؛ يتم تفعيله إذا نشأ موقف غير عادي ولكنه متوقع)",
 "contingent": "مَشْرُوْط",
 "contingent liability": "التزام طارئ, خصوم محتملة (التزامات قد تتكبدها المنشأة اعتماداً على نتيجة حدث مستقبلي غير مؤكد مثل قضية قضائية)\nمثال: تشمل أمثلة الالتزامات الطارئة الدعاوى القضائية المعلقة وضمان المنتج والمطالبات ضد الشركة التي لم يتم الاعتراف بها كديون",
 "contingent probability": "احتمال مشروط (احتمال وقوع حدث ما بالنظر إلى وقوع حدث أو أحداث أخرى)",
 "continual": "متكرر, متواصل (يتكرر بانتظام أو بشكل متكرر في سلسلة طويلة ومتقاربة) / بِلَا انْقِطَاع, مُتَّصِل (لَا انْقِطَاعَ فِيهِ)\nمثال: القرع المتواصل للمصاريع",
 "continually": "مرارا, مرارا وتكرارا",
 "continuance": "استمرار, مواصلة (فعل الاستمرار في نشاط ما دون انقطاع) / استمرار, مدة (خاصية البقاء أو الاستمرار في الزمن) / استمرارية, فترة بقاء (الفترة الزمنية التي يستمر خلالها شيء ما)",
 "continuant": "احْتِكاكِيّ, صَفيرِيّ ((في الصَّوْتِيّات) صَوْت يُنْتَج باحْتِكاك الهَواء في مَمَرّ ضَيِّق) / صوت استمراري (صامت يُنطق عن طريق تضييق (ولكن ليس إغلاق) المجرى الصوتي)",
 "continuant consonant": "صوت استمراري (صامت يُنطق عن طريق تضييق (ولكن ليس إغلاق) المجرى الصوتي)",
 "continuation": "استمرار, مواصلة (فعل الاستمرار في نشاط ما دون انقطاع) / إطالة, تمديد (نتيجة إطالة المدة) / الاستمرارية الجيدة, قانون الاستمرارية (مبدأ تنظيم غيشتالتي ينص على وجود ميل فطري لإدراك الخط كاستمرار لاتجاهه المحدد) / تكملة, جزء تالٍ (جزء يضاف إلى كتاب أو مسرحية يكملها ويوسعها)",
 "continuative": "أداة عطف, رابط (كلمة وظيفية غير متصرفة تعمل على ربط الكلمات أو العبارات أو الجمل)",
 "continue": "تَابَعَ, اِسْتَمَرَّ",
 "continued": "متواصل, مستمر (بدون توقف أو انقطاع)\nمثال: لضمان النجاح المتواصل للحرب",
 "continued fraction": "كَسْر مُسْتَمِرّ (كسر بسطه عدد صحيح ومقامه عدد صحيح زائد كسر بسطه عدد صحيح ومقامه عدد صحيح زائد كسر وهكذا)",
 "continuing": "جَارٍ, قَائِم (يَبْقَى سَارِيَ المَفْعُولِ أَوْ يُسْتَمَرُّ فِيهِ دُونَ تَوَقُّف) / مُزْمِن, مُسْتَمِرّ (يَسْتَمِرّ لِفَتْرَة زَمَنِيَّة طَويلَة)",
 "continuing education": "تعليم مستمر (برنامج تعليمي مصمم بشكل أساسي للطلاب البالغين الذين يشاركون بدوام جزئي)",
 "continuing trespass": "تعد مستمر (تعدٍ ليس عابراً أو متقطعاً بل يستمر طالما بقي الكائن المسبب للمخالفة موجوداً)\nمثال: إلقاء قمامته في أرضي كان حالة تعدٍ مستمر",
 "continuity": "استمرار, ثبات (خاصية فترة زمنية مستمرة ومتصلة) / الكونتنيويتي, نص التتابع (نص مفصل يستخدم في صنع الأفلام لتجنب الانقطاع بين اللقطات) / استمرارية, تواصل (اتصال أو اتحاد غير منقطع)",
 "continuo": "باص مرقم, باص مستمر (جزء باص مكتوب بالكامل ومصحوب بأرقام للإشارة إلى الكوردات التي سيتم عزفها)",
 "continuous": "مُتَوَاصِل, مُتَّصِل",
 "continuous creation theory": "نظرية الحالة الثابتة, نظرية الخلق المستمر ((علم الكونيات) النظرية القائلة بأن الكون يحافظ على كثافة متوسطة ثابتة مع خلق مادة لملء الفراغ الذي تركته المجرات التي تبتعد عن بعضها البعض)\nمثال: تم التخلي عن نظرية الحالة الثابتة لصالح نظرية الانفجار العظيم",
 "continuous integration": "تَرْكِيبْ مُتَوَاصِل (اسم للشيء الذي يُرَّكبُ بالعادة)",
 "continuous receiver watch": "نوبة تنصت (مراقبة مخصصة لاستقبال الإشارات التي تهم الوحدة التي تقوم بالمراقبة)",
 "continuous tense": "مستمر (زمن للأفعال يُستخدم في وصف حدث مستمر)",
 "continuous variable": "مُتَغَيِّر مُتَّصِل",
 "continuously": "باستمرار",
 "continuousness": "استمرارية, تواصل (صفة الشيء الذي يستمر بلا نهاية أو انقطاع)",
 "continuum": "استمرارية, متصل (كل مستمر غير مكاني أو مدى أو تتابع لا يكون فيه أي جزء أو قسم متميزاً أو قابلاً للتمييز عن الأجزاء المجاورة)",
 "conto": "كونتو (1 كونتو يساوي 1000 إسكودو في البرتغال)",
 "contopus sordidulus": "بيوي الغياض الغربي (صائد ذباب صغير من غرب أمريكا الشمالية)",
 "contopus virens": "بيوي (صائد ذباب صغير زيتوني اللون يعيش في غابات شرق أمريكا الشمالية)",
 "contorted": "مُشَوَّه, مُلْتَوٍ (ملتوٍ بشدة (خاصة كما في الألم أو الصراع))",
 "contortion": "التواء, تشويه (عملية لي أو تشويه شكل شيء ما (مثل الجسم)) / التواء, تلوّي (شكل أو وضع ملتو ومتعرج)\nمثال: قام البهلوان بالتواءات لا تصدق",
 "contortionist": "لاعب التواء المفاصل, ملاوي (بهلوان قادر على لوي جسمه في وضعيات غير عادية)",
 "contour": "بنية, تكوين (أي سمات مكانية (خاصة كما يحددها المخطط الخارجي)) / ملامح عامة, هيئة (ميزة (أو ترتيب الميزات) لأي شيء له هيكل معقد) / خط الكنتور, خط المناسيب (خط مرسوم على خريطة يربط بين النقاط المتساوية الارتفاع)\nمثال: بالكاد استطاع تمييز أشكالهم",
 "contour feather": "رِيشَة مُحِيطِيَّة (ريش يغطي جسم الطائر البالغ ويحدد شكله)",
 "contour language": "لغة الكفاف, لغة نغمية متغيرة (لغة نغمية تستخدم تغيرات في طبقة الصوت)",
 "contour line": "خط الكنتور, خط المناسيب (خط مرسوم على خريطة يربط بين النقاط المتساوية الارتفاع)",
 "contour map": "خريطة تضاريس, خريطة كنتورية (خريطة تحتوي على خطوط كنتور تمر عبر نقاط متساوية الارتفاع)",
 "contour sheet": "شرشف بمطاط, ملاءة مثبتة (ملاءة (عادة ذات حواف مطاطية) مفصلة لتناسب مرتبة معينة)",
 "contra": "عَلَى اَلْعَكْس, عَلَى اَلنَّقِيض مِن (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال.",
 "contra danse": "رقص ريفي, كونتردانس (نوع من الرقص الشعبي يترتب فيه الأزواج في مجموعات أو يواجهون بعضهم البعض في خط)",
 "contraband": "تَهْرِيب",
 "contrabandist": "مهرب (شخص يستورد أو يصدر دون دفع الرسوم)",
 "contrabass": "كُونْتْرَابَاص (بنبرة أوكتاف واحد تحت المدى الطبيعيّ للباص الآليّ أو الصوتيّ) / كمان أجهر, كونترباس (أكبر وأخفض عضو في عائلة الكمان)",
 "contrabassoon": "باسون مضاعف, كونتر باسون (الباسون الذي يعد أكبر آلة في عائلة الأوبوا)",
 "contraception": "منع الحمل (تحديد النسل باستخدام أجهزة (مثل الواقي الذكري أو اللولب) أو الأدوية أو الجراحة)",
 "contraceptive": "مَانِع لِلْحَمْل (قادر على منع الحمل أو الإخصاب) / مانع حمل, وسيلة منع حمل (عامل أو جهاز يهدف إلى منع الحمل)",
 "contraceptive device": "مانع حمل, وسيلة منع حمل (عامل أو جهاز يهدف إلى منع الحمل)",
 "contraceptive diaphragm": "حاجز مهبلي, فرزجة (جهاز لمنع الحمل يتكون من كوب مرن على شكل قبة مصنوع من المطاط أو البلاستيك؛ يملأ بمبيد للنطاف ويوضع فوق عنق الرحم)",
 "contraceptive method": "منع الحمل (تحديد النسل باستخدام أجهزة (مثل الواقي الذكري أو اللولب) أو الأدوية أو الجراحة)",
 "contraceptive pill": "حبوب منع الحمل (مانع حمل على شكل حبة تحتوي على الإستروجين والبروجستين لمنع الإباضة وبالتالي منع الحمل)",
 "contraclockwise": "عَكْس اتِّجَاه عَقَارِب السَّاعَة (في الاتجاه المعاكس لدوران عقارب الساعة)",
 "contract": "عَقْد, مُعَاهَدَة (العَشْر من السَنَوَات؛ الاتِّفَاق والعَهْد بين طرفين) / أَغْدَمَ, اِدَّغَمَ\nمثال: أمضى زيري العقد.",
 "contract bridge": "كونتراكت بريدج (نوع من البريدج يتلقى فيه المزايد نقاطاً نحو الفوز باللعبة فقط لعدد الجولات التي زايد عليها)",
 "contract killing": "قتل مأجور (جريمة قتل تُنفذ بالاتفاق مع قاتل مأجور)",
 "contract law": "قانون العقود (فرع الفقه الذي يدرس حقوق والتزامات الأطراف الداخلة في عقود)",
 "contract of adhesion": "عقد إذعان (عقد يقيد بشدة أحد الطرفين بينما يترك الآخر حراً (مثل بعض العقود المطبوعة ذات النموذج القياسي)؛ ينطوي على عدم المساواة في القوة التفاوضية)",
 "contract of hazard": "بيع جزاف, بيع جملة (بيع قطعة أرض ككل دون ضمان للمساحة الدقيقة)",
 "contract offer": "عَرْض عَقْد (عرض من صاحب العمل للتعاقد لدفع أجر للموظف بمعدل معين)",
 "contract under seal": "عقد مختوم (عقد موقع ومرفق به ختم (شمعي) للموقع)",
 "contractable": "سَارٍ, قَابِلٌ لِلِانْتِقَال ((في الأمراض) قابل للانتقال عن طريق العدوى)",
 "contracted": "متقلص, مضيق (مخفض في الحجم أو مسحوب معاً)\nمثال: بؤبؤا عينيها المنقبضان",
 "contractile": "انْقِبَاضِيّ, قَابِلٌ لِلتَّقَلُّصِ (قَادِرٌ عَلَى الِانْقِبَاضِ أَوْ قَابِلٌ لَهُ)",
 "contractile organ": "عضو متقلص (عضو جسدي ينقبض)",
 "contractility": "انقباضية, قابلية الانقباض (القدرة أو الصفة على الانكماش أو الانقباض، خاصة الألياف العضلية)",
 "contracting": "إصابة, التقاط العدوى (أن تصبح مصاباً بالعدوى)\nمثال: التقاط نزلة البرد أمر لا مفر منه أحياناً",
 "contraction": "انكماش, تقلص (عملية إنقاص (شيء ما) في الحجم أو الكثافة أو الكمية أو النطاق) / انقباض, تقلص عضلي ((فسيولوجيا) تقصير أو توتر جزء أو عضو (خاصة العضلة أو الألياف العضلية)) / إدغام, اختصار لفظي (كلمة تتكون من كلمتين أو أكثر عن طريق حذف أو دمج بعض الأصوات) / انضغاط, تقلص (عملية أو نتيجة أن يصبح الشيء أصغر أو مضغوطاً معاً)\nمثال: تقلص الغاز عند التبريد",
 "contractor": "مُقَاوِل",
 "contractual": "تعاقدي (يتعلق بـ أو جزء من اتفاقية قانونية ملزمة)\nمثال: التزامات تعاقدية",
 "contractually": "تعاقدياً (بموجب عقد)\nمثال: كانوا مسؤولين تعاقدياً",
 "contracture": "تقلص (انقباض غير طبيعي ودائم عادة للعضلة)",
 "contradance": "رقص ريفي, كونتردانس (نوع من الرقص الشعبي يترتب فيه الأزواج في مجموعات أو يواجهون بعضهم البعض في خط)",
 "contradict": "نَاقَضَ",
 "contradiction": "تَنَاقُضٌ",
 "contradiction in terms": "تناقض, تناقض لفظي ((منطق) بيان كاذب بالضرورة)\nمثال: العبارة 'هو شجاع وهو ليس شجاعاً' هي تناقض",
 "contradictorily": "بشكل متناقض (بطريقة متناقضة)\nمثال: جادل بشكل متناقض",
 "contradictoriness": "تَنَاقُض (العلاقة التي توجد عندما لا يمكن للأضداد أن تتعايش)",
 "contradictory": "نَقِيض / تَنَاقُضِيّ",
 "contradistinction": "تغاير, تناقض (تمييز يتم رسمه على أساس التباين)\nمثال: النحت في مقابل الرسم",
 "contrafagotto": "باسون مضاعف, كونتر باسون (الباسون الذي يعد أكبر آلة في عائلة الأوبوا)",
 "contrail": "أثر التكثف, ذيل بخاري (سحابة اصطناعية تصنعها طائرة؛ ناتجة إما عن التكثف بسبب انخفاض ضغط الهواء فوق سطح الجناح أو عن بخار الماء في عادم المحرك)",
 "contraindication": "مُضَادّ اِسْتِطْبَاب",
 "contralateral": "في الجانب المقابل, مقابل الجانب (على أو يتعلق بالجانب المقابل (من الجسم))",
 "contralto": "أَلْتُو, كُونْتْرَالْتُو (أخفض صوت أنثويّ أو يتعلَّق به) / كونترالتو (أدنى صوت غنائي نسائي) / كونترالتو (مغنية ذات صوت كونترالتو (أدنى طبقة نسائية))",
 "contrapposto": "وضعية التعارض",
 "contraption": "آلة مبتكرة, أداة (جهاز أو أداة تحكم مفيدة جداً لأداء عمل معين)",
 "contrapuntal": "بوليفوني, طباقي (يحتوي على جزأين لحنيين مستقلين أو أكثر مترابطين توافقياً ويعزفان معاً) / طباقي (متعلق بالطباق (في الموسيقى) أو مميز له أو وفقاً لقواعده)\nمثال: قاعدة طباقية",
 "contrapuntist": "متخصص في الطباق (مؤلف موسيقي يتخصص في أسلوب الطباق (الكونتربونت))",
 "contrarian": "مستثمر معاكس (مستثمر يقرر عمداً مخالفة الحكمة السائدة للمستثمرين الآخرين)",
 "contrariety": "تَضَادّ (العلاقة بين المتضادات)",
 "contrarily": "على العكس (خلافاً للتوقعات) / عَكْسِيًّا, عِنَادًا (بطريقة معاكسة وعاصية)\nمثال: لم يبق في المنزل؛ على العكس، خرج مع أصدقائه",
 "contrariness": "تذمر, غراشة (طبع صعب الإرضاء وغريب الأطوار) / عناد, مخالفة (تمرد متعمد وعنيد ومقاومة للتوجيه أو الانضباط)",
 "contrarious": "مُعَارِض, مُنَاقِض (يتسم بالمعارضة الذاتية والممانعة المقصودة)",
 "contrariwise": "على العكس (خلافاً للتوقعات) / والعكس صحيح (مع عكس الترتيب) / عَكْسِيًّا, عِنَادًا (بطريقة معاكسة وعاصية)\nمثال: لم يبق في المنزل؛ على العكس، خرج مع أصدقائه",
 "contrary": "مُضَادّ, مُعَاكِس (فِي اتِّجَاه مُعَاكِس (عَنِ الرِّيَاح أَوِ التَّيَّارَات)) / شَارِد, عَنِيد (مقاوم للتوجيه أو الانضباط) / مُعَاكِس, مُنَاقِض (شديد التعارض في الطبيعة أو الطابع أو الغرض) / مُتَضَادّ ((للكلمات أو القضايا) مترابطة بحيث لا يمكن أن تكونا صادقتين معًا لكن يمكن أن تكونا كاذبتين معًا)",
 "contrary to fact": "فَرَضِيّ, مُخَالِفٌ لِلوَاقِعِ (يُنَاقِضُ الوَقَائِعَ (عَادَةً كَفَرَضِيَّةٍ))",
 "contrast": "تباين, مقابلة (فعل التمييز عن طريق مقارنة الاختلافات) / تباين (نطاق الكثافة البصرية واللون في صورة سلبية أو مطبوعة (أو المدى الذي تختلف فيه المناطق المتجاورة على شاشة التلفزيون في السطوع)) / تباين (التأثير الإدراكي الناتج عن تجاور ألوان مختلفة جداً) / حد فاصل, خط فاصل (فصل أو تمييز مفاهيمي)\nمثال: هناك خط رفيع بين العقل والجنون",
 "contrast material": "مادة تباين, وسط تباين (مادة معتمة للأشعة السينية؛ عند إعطائها تسمح لأخصائي الأشعة بفحص العضو أو الأنسجة التي تملؤها)",
 "contrast medium": "مادة تباين, وسط تباين (مادة معتمة للأشعة السينية؛ عند إعطائها تسمح لأخصائي الأشعة بفحص العضو أو الأنسجة التي تملؤها)",
 "contrasting": "تَبَايُنِيّ, مُتَبَايِن (مختلف بشكل لافت؛ يميل إلى المقارنة والتباين)",
 "contrastingly": "بِالتَّبَايُن, بِالمُقَابِل (بطريقة متباينة)\nمثال: على النقيض، أعطت كلتا الغرفتين المؤديتين إليها انطباعاً فورياً بالخزي",
 "contrastive": "تَبَايُنِيّ, تَقَابُلِيّ (يُنْشِئُ نَحْوِيًّا عَلَاقَةَ تَبَايُنٍ بَيْنَ الجُمَلِ أَوْ عَنَاصِرِهَا) / تَبَايُنِيّ, مُتَبَايِن (مختلف بشكل لافت؛ يميل إلى المقارنة والتباين) / تَبَايُنِيّ, مُتَعَارِض ((للكلمات) مترابطة بحيث تتباين إحداها مع الأخرى)",
 "contrasty": "عالي التباين, متباين (ذو فروق حادة بين الأسود والأبيض)",
 "contravallation": "تحصين الحصار (تحصين يبنيه المحاصرون حول هدف محاصر لمنع هجمات المدافعين)",
 "contravention": "خِلَاف, نِزَاع (الدخول في صراع مع)",
 "contredanse": "رقص ريفي, كونتردانس (نوع من الرقص الشعبي يترتب فيه الأزواج في مجموعات أو يواجهون بعضهم البعض في خط)",
 "contretemps": "حَادِث عَرَضِيّ, صِدَام مُحْرِج (صدام محرج)\nمثال: حاول تهدئة صدامه المحرج مع الشرطي",
 "contribute": "سَاهَمَ",
 "contribution": "مُسَاهَمَة (المُساهَمَة : المُشاركة والاشتراك في الشيء)\nمثال: ويستطيع الجميع المساهمة.",
 "contributive": "مُسَاعِد, مُسَاهِم (يميل إلى الإحداث؛ مسؤول جزئيًّا عن حدوث شيء)",
 "contributor": "كاتب مساهم, مساهم (كاتب يُنشر عمله في صحيفة أو مجلة أو كجزء من كتاب) / متبرع, مساهم (شخص يساهم (أو يعد بالمساهمة) بمبلغ من المال)",
 "contributory": "مُسَاعِد, مُسَاهِم (يميل إلى الإحداث؛ مسؤول جزئيًّا عن حدوث شيء)",
 "contributory negligence": "إهمال مساهم ((قانون) سلوك من قبل المدعي يساهم في الضرر الناتج عن إهمال المدعى عليه)\nمثال: في القانون العام، أي درجة من الإهمال المساهم تمنع المدعي من تحصيل التعويضات",
 "contrite": "تَائِب, نَادِم",
 "contritely": "بأسف, بندم (مع شعور بالندم)\nمثال: قال بأسف: 'ارتكبت خطأ كبيراً'",
 "contriteness": "توبة, ندامة (الأسى على الخطيئة الناشئ عن الخوف من العقاب)",
 "contrition": "توبة, ندامة (الأسى على الخطيئة الناشئ عن الخوف من العقاب)",
 "contrivance": "ابتكار, اختلاق (فعل تدبير أو ابتكار شيء ما) / آلة مبتكرة, أداة (جهاز أو أداة تحكم مفيدة جداً لأداء عمل معين) / تجهيز مؤقت, تلفيق (أي ترتيب مرتجل للاستخدام المؤقت) / ابتكار, براعة (ملكة الابتكار؛ مهارة ابتكارية)\nمثال: براعته الماهرة في إجابات كل مشكلة",
 "contrived": "مُتَصَلِّب, مُصْطَنَع (رسمي بشكل مصطنع ومتكلّف) / مُتَكَلَّف, مُصْطَنَع (يظهر عليه أثر التخطيط أو التلاعب)",
 "contriver": "مُخَطِّط, مُدَبِّر (شخص يضع الخطط)",
 "control": "سَيْطَرَ / تَحَكُّم, مُرَاقَبَة (\"تَحَكَّمَ فِي أُمُورِهِ الشَّخْصِيَّةِ\" : ضَبَطَهَا وَأَحْكَمَهَا؛ \"يَتَحَكَّمُ فِي أُمُورِ غَيْرِهِ\" : يَتَصَرَّفُ فِيهَا كَمَا يَشَاءُ وَيُرِيدُ)\nمثال: من أنت لتحكم علي؟",
 "control account": "حساب المراقبة (حساب يظهر مجاميع المبالغ المدخلة في دفتر أستاذ مساعد)",
 "control board": "لوحة أجهزة القياس, لوحة تحكم (جهاز كهربائي يتكون من سطح معزول مسطح يحتوي على مفاتيح وأقراص وعدادات للتحكم في الأجهزة الكهربائية الأخرى)\nمثال: فحص لوحة أجهزة القياس",
 "control center": "مركز تحكم (المركز التشغيلي لمجموعة من الأنشطة ذات الصلة)\nمثال: الجنرال القائد لم يغادر مركز التحكم أبداً",
 "control character": "شَخْص (سواد الإنسان حين يرى من بعيد فلا يُعرَف؛ واحد الإنسان بصورة عامة بدون تحديد لسنه وجنسه وقومه وغير ذلك)\nمثال: هذا الشخص فنان.",
 "control circuit": "دائرة تحكم, دائرة تغذية راجعة سلبية (دائرة تغذية راجعة تطرح من المدخلات)",
 "control condition": "شرط ضابط, عنصر تحكم (معيار يمكن مقارنة الظروف الأخرى به في تجربة علمية)\nمثال: كان الشرط الضابط غير مناسب للاستنتاجات التي أراد استخلاصها",
 "control engineering": "هَنْدَسَة التَّكَكُّمَ (الحدُّ والقياس؛ في الرياضيات: هي العلم الذي يبحث في الأشكال وعلاقاتها من حيث الخطوط والأبعاد والسطوح وغيرها)\nمثال: هو ضليع في علم الهندسة .",
 "control experiment": "تجربة ضابطة (تجربة مصممة للتحكم في المتغيرات التي تؤثر على نتائج تجربة أخرى)",
 "control freak": "مهووس بالسيطرة (شخص لديه رغبة قهرية في ممارسة السيطرة على المواقف والناس)",
 "control function": "عملية تحكم (عملية تتحكم في تسجيل أو معالجة أو إرسال أو تفسير البيانات)\nمثال: بدأت عملية تحكم بمعالجة البيانات",
 "control grid": "شبكة, شبكة تحكم (قطب كهربائي يوضع بين الكاثود والأنود في أنبوب مفرغ للتحكم في تدفق الإلكترونات عبر الأنبوب)",
 "control key": "مفتاح التحكم ((علوم الكمبيوتر) المفتاح الموجود على لوحة مفاتيح الكمبيوتر الذي يُستخدم (بالاشتراك مع مفتاح آخر) لكتابة أحرف التحكم)",
 "control operation": "عملية تحكم (عملية تتحكم في تسجيل أو معالجة أو إرسال أو تفسير البيانات)\nمثال: بدأت عملية تحكم بمعالجة البيانات",
 "control panel": "لَوْحَةُ التَّحَكُّم",
 "control rod": "قضيب تحكُّم (قضيب من الفولاذ أو الألومنيوم يمكن تحريكه لأعلى أو لأسفل للتحكم في معدل التفاعل النووي)",
 "control room": "غرفة التحكم (غرفة تضم معدات التحكم (كما في استوديو التسجيل))",
 "control stick": "جوي ستيك, عصا التحكم (رافعة يستخدمها الطيار للتحكم في الجنيحات والمصاعد في الطائرة)",
 "control stock": "أسهم السيطرة (أسهم مملوكة لمساهمين لديهم مصلحة مسيطرة)",
 "control surface": "جنيح, سطح انسيابي (جهاز يوفر قوة رد فعل عند حركته بالنسبة للهواء المحيط؛ يمكنه رفع أو توجيه طائرة أثناء الطيران)",
 "control system": "نظام تحكم (نظام للتحكم في تشغيل نظام آخر)",
 "control tower": "بُرْج مُرَاقَبَة (ظهر وارتفع)\nمثال: وصل كارل إلى برج آخر.",
 "controllable": "قَابِلٌ لِلسَّيْطَرَة (يمكن التحكم فيه)",
 "controlled": "مُسيطر عليه / مُنظبط / خاضع",
 "controlled substance": "مادة خاضعة للرقابة (عقار أو مادة كيميائية تخضع حيازتها واستخدامها لرقابة القانون)",
 "controller": "تحكم, وحدة تحكم (آلية تتحكم في تشغيل آلة) / محاسب, مراقب مالي (شخص يقوم بمسك وتدقيق الحسابات التجارية) / ضابط, متحكم (شخص يوجه ويضبط)\nمثال: وحدة التحكم في السرعة في مشغل الأسطوانات لم تكن تعمل بشكل صحيح",
 "controllership": "منصب المتحكم, منصب المراقب (منصب المتحكم أو المراقب الإداري)",
 "controlling": "مُتَحَكِّم (قَادِر عَلَى التَّحَكُّم فِي السِّيَاسَة أَوْ تَحْدِيدِهَا)",
 "controlling interest": "حصة مسيطرة, مصلحة مسيطرة (ملكية أكثر من 50٪ من الأسهم التي لها حق التصويت في شركة)",
 "contronym": "أَضْدَاد",
 "controversial": "مُثِيرٌ لِلْجَدَل, مَحَل جَدَل",
 "controversialist": "مُجادِل, مُخاصِم (شخص يجادل؛ شخص يجيد أو يستمتع بالجدل)",
 "controversially": "بِشَكْل مُثِير لِلجَدَل, جَدَلِيًّا (ينطوي على جدل)\nمثال: نقد مذكور بشكل جدلي للغاية",
 "controversy": "جَدَل (الجَدْل: شِدَّة الفَتْل؛ جَدَلَ الشيءَ يَجْدُلُهُ ويَجْدِلُهُ جَدْلًا أَحكم فَتْله)\nمثال: الحصانة البرلمانية قضية مثيرة للجدل.",
 "contumacious": "عَاصٍ بِعِنَاد (عنيد في عصيانه بشكل متعمد؛ يرفض الانصياع بإصرار)",
 "contumaciously": "بتحد, بتمرد (بطريقة متمردة)\nمثال: رفض كلماتها بتمرد",
 "contumacy": "تَمَرُّد عَنِيد, عِنَاد (التمرد العنيد وعدم الخضوع؛ مقاومة السلطة) / تَمَرُّد عَلَى المَحْكَمَة (الرفض المتعمد للمثول أمام المحكمة أو الامتثال لأمر المحكمة؛ يمكن أن يؤدي إلى حكم بازدراء المحكمة)",
 "contumelious": "مُتَعَجْرِف, مُتَغَطْرِس (وَقِحٌ بصورة مُتَعَجْرِفة)",
 "contumeliously": "باحتقار, بازدراء (بدون احترام؛ بطريقة محتقرة)\nمثال: تحدثت عنه بازدراء",
 "contumely": "إِهَانَة, سَبّ (تعبير وقح يهدف إلى الإساءة أو الأذى)\nمثال: عندما ارتكب الطالب خطأ غبياً لم يوفر له أي شتيمة",
 "contusion": "رَضّ (رَضَّ يَرُضُّ: رَضًّا؛ رَضَّ الشيء: دقه وطحنه طحنا خشنا)",
 "conundrum": "أُحْجِيَّة, لُغْز (مشكلة صعبة)",
 "conurbation": "تكتل حضري, تمدد حضري (تجمع أو شبكة متصلة من المجتمعات الحضرية)",
 "conuropsis carolinensis": "ببغاء كارولينا (ببغاء منقرض امتد نطاقه بعيداً داخل الولايات المتحدة)",
 "convalescence": "نَقَاهَة / نَقَاهَة, فَتْرَةُ نَقَاهَة",
 "convalescent": "فِي طَوْر التَّعَافِي, نَاقِه (في مرحلة التعافي والعودة إلى الصحّة بعد مرض أو وهن) / فِي دَوْر النَّقاهَة, ناقِه (شخص يتماثل للشفاء من مرض)",
 "convallaria majalis": "زنبق الوادي, كونفالاريا (نبات معمر منخفض النمو له عادة ورقتان كبيرتان مستطيلتان سنانيتان وعنقود من الزهور الصغيرة العطرة المتدلية على شكل جرس تليها توت قرمزي)",
 "convection": "حمل حراري (انتقال الحرارة عبر مائع (سائل أو غاز) ناتج عن حركة الجزيئات) / حمل حراري ((في الأرصاد الجوية) الحركة العمودية للحرارة أو غيرها من الخصائص عن طريق حركة الكتل داخل الغلاف الجوي)",
 "convector": "مسخن بالحمل (سخان مساحة ينقل الحرارة إلى الهواء المحيط عن طريق الحمل الحراري)",
 "convene": "اِجْتَمَعَ (ضد تَفَرَّقَ، كانوا جَمِيْع، أو كانوا مع بعض؛ الناس على كذا: ضدّ تَفَرَّقُوْا؛ كانوا على رأي واحد)\nمثال: اجتمع الناس في المتنزه.",
 "convener": "المسؤول عن الدعوة, منظم الاجتماعات (عضو في مجموعة واجبه الدعوة لعقد الاجتماعات)",
 "convenience": "مُلَاءَمَة, مُنَاسَبَة",
 "convenience food": "طعام جاهز, وجبة سريعة التحضير (أي طبق أو طعام معبأ يمكن تحضيره بسرعة وسهولة مثل الإذابة أو التسخين)",
 "convenience store": "بِقَالَة, مَتْجَر صَغِير",
 "conveniences": "مرافق الراحة, وسائل الراحة (الأشياء التي تجعلك مرتاحاً ومطمئناً)\nمثال: كل وسائل الراحة المنزلية",
 "convenient": "مُنَاسِب, مُلَائِم",
 "conveniently": "بسهولة, بشكل ملائم (بطريقة مريحة)\nمثال: كان المفتاح في موقع ملائم",
 "convening": "اِلْتِئَام, اِنْعِقَاد (فعل عقد الاجتماع)",
 "convent": "دير (بيت يسكنه الرُهْبَان أو الرَاهِبَات ممن كان على دين المسيحية) / رهبنة نسوي\nمثال: سيداتي و سادتي ، رجاء قفوا للنشيد الوطني للاتحاد الروسي باداء جوقة دير سرتينسكي .",
 "conventicle": "دار الاجتماع (مبنى للتجمع الديني (خاصة غير الممتثلين، مثل الكويكرز)) / اجتماع سري, عبادة سرية (اجتماع سري غير مصرح به للعبادة الدينية)",
 "convention": "مُؤْتَمَر / مُعَاهَدَة, تَوَافُق (مؤنث مُعَاهَد، وهو اسم مفعول من عَاهَدَ؛ اتِّفَاق مُقَرّر بين دَوْلَتَيْن أو أكثر على أمور معينة) / مُعَاهَدَة, مُقَاوَلَة (مؤنث مُعَاهَد، وهو اسم مفعول من عَاهَدَ؛ اتِّفَاق مُقَرّر بين دَوْلَتَيْن أو أكثر على أمور معينة) / عُرْف (عَلِمَ؛ سَكَنَ إلى الشيءِ، أَنَسَهُ وأَلِفَه)\nمثال: أمضيت المعاهدة يوم 18 نوفمبر 1903.",
 "conventional": "عُرْفِيّ",
 "conventionalisation": "اتباع التقاليد (فعل جعل الشيء تقليدياً؛ الامتثال لأسلوب تقليدي)",
 "conventionalised": "مُؤَسْلَب, مُنَمَّط (يستخدم أشكالًا وأعرافًا فنية لخلق تأثيرات؛ غير طبيعي أو تلقائي)",
 "conventionalism": "تَقْلِيدِيَّة, عُرْفِيَّة (الأرثوذكسية كنتيجة لكون الشخص تقليدياً)",
 "conventionality": "تَقْلِيدِيَّة, عُرْفِيَّة (الأرثوذكسية كنتيجة لكون الشخص تقليدياً) / تقليدية مفرطة (عدم الأصالة نتيجة لكون الشخص تقليدياً جداً) / تقليدية (الامتثال للفكر والسلوك التقليدي)",
 "conventionalization": "اتباع التقاليد (فعل جعل الشيء تقليدياً؛ الامتثال لأسلوب تقليدي)",
 "conventionalized": "مُؤَسْلَب, مُنَمَّط (يستخدم أشكالًا وأعرافًا فنية لخلق تأثيرات؛ غير طبيعي أو تلقائي)",
 "conventionally": "بشكل تقليدي, عرفياً (بطريقة تقليدية)\nمثال: عادة ما يتصرف بشكل تقليدي إلى حد ما",
 "conventioneer": "مُؤْتَمِر, مُشارِك فِي مُؤْتَمَر (شخص يحضر مؤتمراً)",
 "conventual": "دَيْرِيّ, رَهْبَانِيّ (مُتَعَلِّقٌ بِالحَيَاةِ الجَمَاعِيَّةِ المُنْعَزِلَةِ عَنِ العَالَمِ تَحْتَ نُذُورٍ دِينِيَّةٍ)",
 "convergence": "التقاء, تقارب (عملية التقارب (المجيء بشكل أقرب)) / التقاء, تداخل (تمثيل للأرضية المشتركة بين النظريات أو الظواهر) / تَقَارُب (اقتراب متسلسلة لا نهائية من حد محدود) / التقاء, تقارب (حدوث التقاء شيئين أو أكثر)\nمثال: لم يكن هناك تداخل بين مقترحاتهم",
 "convergency": "التقاء, تقارب (عملية التقارب (المجيء بشكل أقرب)) / تَقَارُب (اقتراب متسلسلة لا نهائية من حد محدود)",
 "convergent": "متقارب, متلاقٍ (يميل للالتقاء قادماً من اتجاهات مختلفة)",
 "convergent strabismus": "حول إنسي, حول داخلي (حول تتجه فيه إحدى العينين أو كلتيهما إلى الداخل نحو الأنف)",
 "convergent thinker": "حلال المشاكل, مفكر تقاربي (مفكر يركز على المشكلة كما طُرحت ويحاول تجميع المعلومات والمعرفة للوصول إلى حل)",
 "convergent thinking": "تفكير تقاربي (تفكير يجمع المعلومات مع التركيز على حل مشكلة (خاصة حل المشكلات التي لها حل صحيح واحد))",
 "converging": "التقاء, تقارب (عملية التقارب (المجيء بشكل أقرب))",
 "converging lens": "عدسة مجمعة, عدسة محدبة (عدسة تعمل على تجميع شعاع الضوء المار عبرها في نقطة أو بؤرة)",
 "conversance": "إلمام, اطلاع (معرفة شخصية أو معلومات حول شخص أو شيء ما)",
 "conversancy": "إلمام, اطلاع (معرفة شخصية أو معلومات حول شخص أو شيء ما)",
 "conversation": "مُحَادَثَة / مُكَالَمَة / حِوَار / مُذَاكَرَة / مُحَاوَرَة / تَكَلُّم (نُطْق؛ تَحَدُّث)\nمثال: أخذت تكلم الكلب.",
 "conversation piece": "مثار حديث (شيء مثير للاهتمام يحفز المحادثة)",
 "conversation stopper": "قاطع الحديث, مفحم (ملاحظة لا يوجد عليها رد مهذب في المحادثة)",
 "conversational": "عَامِّيّ, مَحْكِيّ (يُمَيِّزُ اللُّغَةَ المَحْكِيَّةَ غَيْرَ الرَّسْمِيَّةِ أَوِ المُحَادَثَةَ)",
 "conversational partner": "طرف في المحادثة, محاور (شخص يشارك في محادثة)",
 "conversationalist": "بارع في الحديث, محاور (شخص ماهر في المحادثة)",
 "conversationally": "بِالعَامِّيَّة, بِشَكْل غَيْر رَسْمِيّ (باستخدام تعابير عامية)\nمثال: يشار إلى هذا المبنى بالعامية باسم الحظيرة",
 "conversationist": "بارع في الحديث, محاور (شخص ماهر في المحادثة)",
 "converse": "تَحَدَّثَ, تَكَلَّمَ (كَلَّمَ، حَدَّثَ، تَكَلَّمَ)\nمثال: يمكنكما التحدث.",
 "conversely": "بالمقابل, عكسياً (مع عكس شروط العلاقة)\nمثال: بالمقابل، ليست كل النساء أمهات",
 "conversion": "اعتناق, هداية (استنارة روحية تدفع الشخص لعيش حياة جديدة) / تحويل, نقطة إضافية (رمية حرة ناجحة أو محاولة لكسب نقطة بعد التاتش داون) / تحويل (عملية التغيير من استخدام أو وظيفة أو غرض إلى آخر) / تحويل (فعل استبدال نوع من المال أو الأوراق المالية بآخر)",
 "conversion disorder": "اضطراب تحويلي, هيستيريا تحويلية (اضطراب عقلي يتميز بتحويل الصراع العقلي إلى أشكال جسدية (إلى شلل أو تخدير ليس له سبب ظاهر))",
 "conversion factor": "عَامِل التَّحْوِيل (العامل الذي تضرب به كمية معبر عنها بوحدة معينة لتحويلها إلى وحدة أخرى)",
 "conversion hysteria": "اضطراب تحويلي, هيستيريا تحويلية (اضطراب عقلي يتميز بتحويل الصراع العقلي إلى أشكال جسدية (إلى شلل أو تخدير ليس له سبب ظاهر))",
 "conversion reaction": "اضطراب تحويلي, هيستيريا تحويلية (اضطراب عقلي يتميز بتحويل الصراع العقلي إلى أشكال جسدية (إلى شلل أو تخدير ليس له سبب ظاهر))",
 "conversion therapy": "عِلَاج التَّحْوِيل",
 "converso": "كونفيرسو, مُتَنَصِّر قَسْرِي ((في إسبانيا والبرتغال في العصور الوسطى) يهودي أو مغاربي اعتنق المسيحية لتجنب الاضطهاد أو الطرد)",
 "convert": "حَوَّلَ (جَعَلَ الشيءَ غير ما كان؛ نقل الشيء من موضع إلى آخر)\nمثال: رقصنا حول النار.",
 "convertase": "كونفيرتاز (أي من عدة إنزيمات تحول مركباً إلى مركبات أصغر ونشطة بيولوجياً)",
 "converter": "محوّل (جهاز لتغيير مادة أو شكل أو حالة إلى أخرى)",
 "convertibility": "قَابِلِيَّة لِلتَّحْوِيل, قَابِلِيَّة لِلصَّرْف (صفة القابلية للاستبدال (خاصة القدرة على تحويل عملة إلى ذهب أو عملات أخرى دون قيود))",
 "convertible": "حَنْطُور",
 "convertible bond": "سند قابل للتحويل (سند يمكن تحويله إلى أوراق مالية أخرى في ظل ظروف معينة)",
 "convertible security": "ورقة مالية قابلة للتحويل (ورقة مالية للشركات (عادة سندات أو أسهم ممتازة) يمكن استبدالها بشكل آخر من الأوراق المالية (عادة أسهم عادية))",
 "convertor": "محوّل (جهاز لتغيير مادة أو شكل أو حالة إلى أخرى)",
 "convex": "مُحَدَّب",
 "convex lens": "عدسة مجمعة, عدسة محدبة (عدسة تعمل على تجميع شعاع الضوء المار عبرها في نقطة أو بؤرة)",
 "convex polygon": "مضلع محدب (مضلع بحيث إذا مُد أي ضلع لا يقطع أي ضلع أو رأس آخر)",
 "convex polyhedron": "متعدد سطوح محدب (متعدد سطوح يكون فيه أي مقطع مستوٍ مضلعاً محدباً)",
 "convex shape": "تحدب, شكل محدب (شكل ينحني أو يبرز إلى الخارج)",
 "convexity": "تحدب (الخاصية التي يمتلكها الشكل المحدب) / تحدب, شكل محدب (شكل ينحني أو يبرز إلى الخارج)",
 "convexly": "بتحدب (بطريقة محدبة)\nمثال: بارز بتحدب",
 "convexness": "تحدب (الخاصية التي يمتلكها الشكل المحدب)",
 "convexo-concave": "مُحَدَّبٌ مُقَعَّر (مُحَدَّب مِنْ جِهَةٍ وَمُقَعَّر مِنْ أُخْرَى مَعَ غَلَبَةِ التَّحَدُّبِ عَلَى التَّقَعُّرِ)",
 "convexo-convex": "عَدَسِيّ, مُحَدَّبُ الوَجْهَيْنِ (مُحَدَّب مِنْ كِلَا الجانِبَيْنِ؛ بِشَكْلِ العَدَسَة)",
 "convey": "أَبْلَغَ, نَقَلَ (أَكْثَرُ بَلَاغَة)\nمثال: أبلغ توم تحياتي.",
 "conveyable": "قَابِل لِلتَّحْوِيل, قَابِل لِلتَّدَاوُل (يمكن نقل ملكيته قانونياً إلى شخص آخر)",
 "conveyance": "وَسِيلَةُ النَّقْل",
 "conveyance of title": "نقل الملكية العقارية (فعل نقل سند ملكية العقار من شخص لآخر)",
 "conveyancer": "محامي عقارات (محامٍ متخصص في أعمال نقل الملكية العقارية)",
 "conveyancing": "نقل الملكية العقارية (فعل نقل سند ملكية العقار من شخص لآخر)",
 "conveyer": "حزام ناقل, سير ناقل (حزام متحرك ينقل الأشياء (كما في المصنع)) / ناقل (شخص ينقل (يحمل أو يوصل شيئاً))\nمثال: ناقل الأخبار السارة",
 "conveyer belt": "حزام ناقل, سير ناقل (حزام متحرك ينقل الأشياء (كما في المصنع))",
 "conveying": "نقل الملكية العقارية (فعل نقل سند ملكية العقار من شخص لآخر)",
 "conveyor": "حزام ناقل, سير ناقل (حزام متحرك ينقل الأشياء (كما في المصنع)) / ناقل (شخص ينقل (يحمل أو يوصل شيئاً))\nمثال: ناقل الأخبار السارة",
 "conveyor belt": "حِزَام نَاقِل (خيط أو قطعة من جلد تستخدم لحَزْم النَبَات أو العِيدَان أو غيرها لتكوين حُزْمَة؛ النِطَاق، قطعة من الجِلْد الطَوِيل يلف حول الخَصْر إما ليمسك المَلابِس أو ليظهر الخصر)\nمثال: هذا حزام من الجلد.",
 "convict": "أَدَانَ / سَجِين, مُدَان",
 "convict fish": "السمكة المدانة, جرينلينج ملونة (سمكة جرينلينج ذات جسم مائل للبياض ومخطط بشرائط سوداء)",
 "convictfish": "السمكة المدانة, جرينلينج ملونة (سمكة جرينلينج ذات جسم مائل للبياض ومخطط بشرائط سوداء)",
 "conviction": "اِعْتِقَاد, عَقِيدَة",
 "convince": "أَقْنَعَ",
 "convinced": "مُقْتَنِع (لديه اعتقاد قوي أو قناعة)\nمثال: داعية سلام مقتنع ومتعصب",
 "convincible": "قَابِل لِلْإِقْنَاع (سريع الاستجابة للإقناع)",
 "convincing": "مقنع (يسبب الاعتقاد بصحة شيء ما)\nمثال: قصة مقنعة",
 "convincingly": "بشكل مقنع (بطريقة مقنعة)\nمثال: جادل بشكل مقنع",
 "convincingness": "إقناع, حجية (قوة الحجة أو الدليل على غرس الاعتقاد)",
 "convivial": "مَرِح, مُعَاشِر (مشغول بمتع الصُّحْبَة الطيّبة أو مُولَع بها)",
 "conviviality": "ابتهاج, احتفال صاخب (احتفال صاخب؛ بهجة ومرح) / بشاشة, مرح (طبيعة مرحة)",
 "convivially": "بِأُلْفَة, بِانْشِرَاح (بطريقة مرحة واجتماعية)\nمثال: 'لنذهب ونحتسي مشروباً'، قالت بانشراح",
 "convocation": "اِسْتِدْعَاء, دَعْوَة لِلْاِجْتِمَاع (عملية دعوة الناس للتجمع) / اجتماع مدعو, دعوة للاجتماع (مجموعة مجتمعة استجابة لدعوة رسمية)",
 "convolute": "مُلْتَفّ طُولِيًّا (ملفوف على نفسه طوليًا)",
 "convoluted": "شَائِك, مُعَقَّد (بَالِغ التَّعْقِيد أَوِ التَّشَابُك وَأَحْيَانًا مُخَادِع) / مُلْتَفّ طُولِيًّا (ملفوف على نفسه طوليًا)",
 "convolution": "التفاف, تلافيف (عملية اللف أو اللي أو الالتفاف معاً) / تلفيف (طية محدبة أو ارتفاع في سطح الدماغ) / تلفيف, دوامة (شكل شيء يدور بسرعة)",
 "convolution of broca": "باحة بروكا, مركز بروكا (مركز الكلام الحركي في نصف الكرة الأيسر للدماغ في معظم الناس)",
 "convolvulus": "كونفولفولوس, لبلاب الحقول",
 "convolvulus arvensis": "لبلاب الحقول, مجعد (نبات متسلق معمر أوروبي ضعيف بزهور بيضاء أو وردية؛ تم توطينه في أمريكا الشمالية وهو عشب ضار غازٍ)",
 "convolvulus scammonia": "سقمونيا, محمودة (نبات متسلق في آسيا الصغرى له زهور كريمية إلى أرجوانية وجذور سميكة طويلة تنتج راتنجاً مسهلاً)",
 "convolvulus sepium": "لبلاب السياج",
 "convoy": "قَافِلَة (مؤنث القافل؛ الراجعة؛ جماعة من الناس تسير معًا مع أمتعتها وركوبها في سفر قافلين كانوا أو خارجين. سميّت كذلك تفائلا برجوعها)\nمثال: الكلاب تنبح، والقافلة تسير.",
 "convulsion": "اِخْتِلَاج (الخَلْجُ: الجَذْبُ،واختلج شيء في صدري:احتكأ مع شك؛ أصل الاختلاج: الحركة والاضطراب)",
 "convulsive": "تَشَنُّجِيّ, تَقَلُّصِيّ (يتأثر بتقلصات عضلية لاإرادية مفاجئة؛ يشبه التشنج) / اِخْتِلَاجِيّ, تَشَنُّجِيّ (يُشْبِهُ التَّشَنُّجَ فِي كَوْنِهِ مُفَاجِئًا وَعَنِيفًا)",
 "convulsively": "بشكل تشنجي\nمثال: ارتجفت ساقها بشكل تشنجي",
 "cony": "أرنب (أي من حيوانات حفر متنوعة من فصيلة الأرانب ذات آذان طويلة وذيول قصيرة؛ بعضها مستأنس ويُربى كحيوانات أليفة أو للطعام) / بيكا (ثديي حفار صغير قصير الأذن من المرتفعات الصخرية في آسيا وغرب أمريكا الشمالية) / وبر (أي من الثدييات الصغيرة ذات الحوافر في أفريقيا وآسيا ذات قواطع تشبه القوارض وأقدام ذات أصابع تشبه الحوافر)",
 "conyza canadensis": "أريغارون كندي, ذيل الحصان (عشب ضار شائع في أمريكا الشمالية بأوراق خطية ورؤوس قرصية صغيرة من الزهور الصفراء؛ مستوطن على نطاق واسع في جميع المناطق المعتدلة؛ يوضع أحياناً في جنس…)",
 "coo": "قَرْقَرَة, مُنَاغَاة / هَدَلَ",
 "cooccurring": "آنِيّ, مُتَزَامِن (يحدث أو يعمل في نفس الوقت)",
 "cook": "طَبَّاخ, طَبَّاخَة (من طَبَخَ، بمعنى اسم الفاعل الطَابِخ؛ من طَبَخَ، بمعنى الكثير الطَبْخ) / طَبَخَ, طيب (أَنْضَجَ الطعام بتسخينه) / طاب (حَسُنَ واصبح طَيِّب؛ نفسُه: ارتاحت ورضيت واطمأنت)\nمثال: زوجي طباخ ماهر.",
 "cook islands": "جُزُر كُوك (جَزَرَ الماءُ عن الأَرضِ يَجْزُرُ جَزْراً: نَضَبَ وحَسَرَ؛ ويقال: جَزَرَ البَحْرُ والنَّهْرُ: انْحسرَ ماؤُهُ)\nمثال: ضع الجزر في القدر.",
 "cookbook": "كِتَاب طَبْخ (موضع تعليم الكتابة. الاستخدام الأصلي؛ مدرسة شبه رسمية لتعليم الأطفال الكِتَابَة والقِرَاءَة ومباديء الحِسَاب وبعض القُرَآن…)\nمثال: هذا الكتاب جديد",
 "cooked": "مطبوخ, مطهو (تم إعداده للأكل بتطبيق الحرارة)",
 "cooker": "إناء طهي, طباخ (أداة للطهي)",
 "cookery": "إعداد الطعام, طبخ (فعل إعداد شيء (كالطعام) بتطبيق الحرارة)\nمثال: الطبخ يمكن أن يكون فناً رائعاً",
 "cookery book": "كتاب طبخ (كتاب وصفات وإرشادات الطبخ)",
 "cookfire": "موقد طهي, نار الطبخ (نار للطبخ)",
 "cookhouse": "مطبخ خارجي (مأوى منفصل أو خارجي للطبخ) / مطبخ السفينة (منطقة إعداد الطعام على متن سفينة)\nمثال: استخدم السيرك خيمة كمطبخ خارجي",
 "cookie": "كُعَيْكَة / كُوكِي / بَسْكَوِيت",
 "cookie cutter": "قطاعة البسكويت (أداة مطبخ تستخدم لقطع ورقة من عجين البسكويت إلى الأشكال المطلوبة قبل الخبز)",
 "cookie jar": "جرة الكعك, مرطبان البسكويت (جرة يُحفظ فيها الكعك (وأحياناً تُخفَى فيها النقود))",
 "cookie jar reserve": "احتياطي سري (احتياطي خفي يمكن استخدامه لتعديل تقارير الأرباح الفصلية)",
 "cookie sheet": "صينية بسكويت, صينية خبز (أداة طهي تتكون من صفيحة معدنية مستطيلة مسطحة تستخدم لخبز البسكويت أو الكعك)",
 "cookie-cutter": "مُتَشَابِه, نَمَطِيّ (ذو مظهر واحد كأنّه مُنتَج بشكل جماعيّ)",
 "cookie-sized": "بِحَجْمِ الْكَعْكَةِ (بحجم كعكة تقريبًا)",
 "cooking": "طَبْخ (أَنْضَجَ الطعام بتسخينه)\nمثال: سامي يحب الطبخ.",
 "cooking apple": "تفاح الطهي, تفاح طبخ (تفاح يستخدم بشكل أساسي في الطهي للفطائر وصلصة التفاح وما إلى ذلك)",
 "cooking chocolate": "شوكولاتة خام, شوكولاتة للخبز (شوكولاتة نقية غير محلاة تستخدم في الخبز والتغطيات السكرية والصلصات والحلوى)",
 "cooking oil": "زَيْت اَلْطَهِي (ما يعصر من الزَيْتُون؛ كل سائل لزج يستخرد من النبات يستخدم كما يستخدم السمن)\nمثال: خبأن ذلك الزيت.",
 "cooking pan": "طاسة, مقلاة (أداة طهي تتكون من وعاء معدني واسع)",
 "cooking pot": "قِدْر, طَنْجَرَة (قضاء الله وحكمه وما قَدَّرَه؛ مبلغ الشيء وكميتّه، بنفس معنى قَدْر)\nمثال: خذ قدر ما تريد.",
 "cooking stove": "بوتاجاز, طباخ (جهاز مطبخ يُستخدم لطهي الطعام)\nمثال: كان العشاء جاهزاً بالفعل على الموقد",
 "cooking utensil": "أواني الطهي (أداة مطبخ مصنوعة من مادة لا تذوب بسهولة؛ تستخدم للطهي)",
 "cookout": "شواء خارجي, طهي في الهواء الطلق (وجبة غير رسمية تُطهى وتؤكل في الهواء الطلق)",
 "cookstove": "موقد طهي (موقد للطهي (وخاصة موقد المطبخ الذي يعمل بالحطب أو الفحم))",
 "cookware": "أواني الطهي (أداة مطبخ مصنوعة من مادة لا تذوب بسهولة؛ تستخدم للطهي)",
 "cooky": "بسكويت, كعك محلى (أي من الكعك الصغير المسطح الحلو المتنوع) / طباخ المخيم (الطباخ في مزرعة أو في مخيم)",
 "cooky jar": "جرة الكعك, مرطبان البسكويت (جرة يُحفظ فيها الكعك (وأحياناً تُخفَى فيها النقود))",
 "cool": "بَارِد (مُنْخَفِض الحَرارة أو حَرارتُه أقلّ من حَرارة جسْم الإنسان؛ غير حامٍ، أو متروك بلا حماوة، غير محميّ على النَّار) / يُبَرِّد\nمثال: الماء بارد حقا.",
 "cool jazz": "جاز هادئ, كول جاز (جاز مقيد وسلس يتميز بهياكل توافقية معقدة غالباً ما تتأخر قليلاً عن الإيقاع)",
 "cool medium": "وسيط بارد (وسيط يوفر عادة، ولكن ليس دائماً، القليل من المشاركة مع تحفيز كبير؛ يشمل الكلام والتلفزيون والرسوم المتحركة)",
 "cool-white": "أَبْيَض مُزْرَقّ (أبيض مع مسحة زرقاء)",
 "coolant": "مُبَرِّد",
 "coolant system": "نظام تبريد (نظام تبريد يستخدم سائلاً لنقل الحرارة من مكان إلى آخر)",
 "cooler": "مُبَرِّد",
 "cooley's anaemia": "أنيميا كولي, ثالاسيميا كبرى (شكل قاتل من الثالاسيميا متماثلة الزيجوت (موروثة من كلا الوالدين) لا يوجد فيه هيموغلوبين؛ مع تشوهات هيكلية وتضخم القلب والطحال والكبد)",
 "cooley's anemia": "أنيميا كولي, ثالاسيميا كبرى (شكل قاتل من الثالاسيميا متماثلة الزيجوت (موروثة من كلا الوالدين) لا يوجد فيه هيموغلوبين؛ مع تشوهات هيكلية وتضخم القلب والطحال والكبد)",
 "coolheaded": "بَارِدُ الأَعْصَاب, رَابِطُ الجَأْش (يتسم بضبط النفس الهادئ خاصةً في الظروف الصعبة؛ غير انفعاليّ)",
 "coolie": "كولي ((إهانة عرقية) اسم مسيء لعامل آسيوي غير ماهر)",
 "cooling": "تبريد, نظام تبريد (آلية للحفاظ على برودة شيء ما) / تبريد, خفض درجة الحرارة (عملية التحول إلى البرودة؛ انخفاض درجة الحرارة)\nمثال: كان التبريد عبارة عن مراوح سقفية",
 "cooling center": "مَرْكَز تَبْرِيد (موضع الاِرْتِكَاز عامة؛ موضع الشخص ومحلّه الذي يبقى فيه عادة)\nمثال: أين أقرب مركز شرطة؟",
 "cooling system": "تبريد, نظام تبريد (آلية للحفاظ على برودة شيء ما) / نظام تبريد, نظام تبريد المحرك (معدات في مركبة بمحرك تقوم بتبريد المحرك)\nمثال: كان التبريد عبارة عن مراوح سقفية",
 "cooling tower": "برج تبريد (نظام تبريد يستخدم في الصناعة لتبريد الماء الساخن (عن طريق التبخر الجزئي) قبل إعادة استخدامه كمبرد)",
 "coolly": "بِبُرُود, بِرَبَاطَة جَأْش (بطريقة هادئة وغير مبالية)\nمثال: دون مزيد من اللغط، استعار باركر سكيناً من رائد لوائه وشحذها على حجر الكاربورندم ببرود كجزار",
 "coolness": "برود, جفاء (نقص في المودة أو الحماس) / برود الأعصاب, هدوء الأعصاب (تمالك النفس بجرأة في مواجهة الخطر) / برودة خفيفة, نسمة باردة (خاصية أن يكون الشيء بارداً بشكل معتدل) / برود, رباطة جأش (ثقة بالنفس هادئة وغير مضطربة)\nمثال: برود مؤلم في النبرة والأسلوب",
 "coolwart": "تياريلا قلبية الأوراق, زهرة الرغوة (نبات غابات رئدي أبيض الزهر يزهر في الربيع)",
 "cooly": "كولي ((إهانة عرقية) اسم مسيء لعامل آسيوي غير ماهر)",
 "coon": "راكون, راكون شائع (الراكون الموجود في أمريكا الشمالية) / ريفي غريب الأطوار (شخص ريفي غريب الأطوار أو يفتقر للوقار)\nمثال: سأكون في ورطة عندما تبدأ المعركة",
 "coon bear": "باندا عملاق, دب الباندا (ثديي عشبي كبير أبيض وأسود يعيش في غابات الخيزران في الصين والتبت؛ يُعتبر في بعض التصنيفات عضواً في فصيلة الدببة أو فصيلة منفصلة)",
 "coon cat": "بساريسك, قط حلقي الذيل (ثديي قارت شبيه بالراكون من المكسيك وجنوب غرب الولايات المتحدة له ذيل كثيف طويل بحلقات سوداء وبيضاء) / قوطي (ثديي قارت من أمريكا الوسطى وأمريكا الجنوبية)",
 "coondog": "كلب صيد الراكون (أي كلب مدرب على صيد الراكون)",
 "coonhound": "كلب صيد الراكون, كونهاوند (أي من سلالات كلاب الصيد المتعددة التي تم تطويرها لصيد حيوان الراكون)",
 "coonskin": "قبعة جلد الراكون (قبعة راكون يتدلى ذيلها أسفل الظهر)",
 "coonskin cap": "قبعة جلد الراكون (قبعة راكون يتدلى ذيلها أسفل الظهر)",
 "coontie": "زاميا قزمة, كونتي (زاميا خشبية صلبة صغيرة في فلوريدا وجزر الهند الغربية وكوبا؛ تنتج الجذور والسيقان نصف المدفونة نشا الأروروت)",
 "coop": "قُنّ, خُمّ (تتبع الأخبار؛ تفقَّد بالبصر)",
 "cooper": "براملي, صانع البراميل (حرفي يصنع أو يصلح البراميل أو الأحواض الخشبية)",
 "cooper's hawk": "باز كوبر (صقر من أمريكا الشمالية لونه رمادي مزرق يتميز بطيران انقضاضي)",
 "cooperate": "تَعَاوَنَ",
 "cooperation": "تَعَاوُن",
 "cooperative": "تَعَاوُنِيّ",
 "cooperatively": "بتعاون وثيق, يداً بيد (بتعاون وثيق)\nمثال: يعملون بتعاون وثيق",
 "cooperativeness": "استجابة, طواعية (سمة كون المرء متعاوناً)",
 "cooperator": "شَرِيك, مُتَعاوِن (شريك في نشاط أو مسعى أو مجال ذي اهتمام مشترك)\nمثال: كان الموسيقي وكاتب الليبريتو متعاونين",
 "coordinate": "تَنْسِيق, إِحْدَاثِيّ (ترتيب وتنظيم الأشياء أو العناصر بشكل متناسق ومتناسب؛ العمل على توحيد الجهود بين جهات متعددة لتحقيق هدف مشترك)",
 "coordinate axis": "محور إحداثي (أحد الخطوط المرجعية الثابتة لنظام الإحداثيات)",
 "coordinate bond": "رابطة تناسقية (رابطة تساهمية يتم فيها توفير كلا الإلكترونين من قبل إحدى الذرات)",
 "coordinate clause": "جملة معطوفة (جملة في جملة معقدة تعادل نحوياً الجملة الرئيسية وتؤدي نفس الوظيفة النحوية)",
 "coordinate geometry": "هندسة إحداثية, هندسة تحليلية (استخدام الجبر لدراسة الخصائص الهندسية)",
 "coordinate system": "نِظَامُ إِحْدَاثِيَّاتٍ (مَنْهَج، طَرِيقَة؛ تَرْتِيب واتِّسَاق)\nمثال: ليس بنظام كامل.",
 "coordinated": "مُنَسَّق الحَرَكَة (يتمتع بمهارة في استخدام أكثر من مجموعة حركات عضلية) / مُتَرَابِط, مُنَسَّق (يعمل كوحدة واحدة متناسقة) / مُتَوَافِق, مُنَسَّق (مُطابَق عن قصد)",
 "coordinated universal time": "التوقيت العالمي المنسق (توقيت غرينتش محدثاً بالثواني الكبيسة)",
 "coordinately": "بشكل منسق (بطريقة منسقة)",
 "coordinating conjunction": "حَرْف عَطْف (طَرَف وَجَانِب وَحَدّ؛ رَمْز مخطوط أو مطبوع يقوم مقام صوت أو كلمة أو عبارة أو معنى)\nمثال: ألف هو الحرف الأول للألف باء.",
 "coordination": "تنسيق (تنظيم عناصر متنوعة في عملية متكاملة ومتناغمة) / تنسيق, مساواة في الرتبة (كون الشيء ذو أهمية أو رتبة أو درجة مساوية أو منسقة) / تنسيق (التفاعل الماهر والفعال للحركات) / تَنْسِيق (العلاقة النحوية بين مكونين لهما نفس الشكل النحوي)",
 "coordination compound": "مركب تناسقي, معقد (مركب يوصف من حيث الذرة المركزية التي ترتبط بها أو تتناسق معها ذرات أخرى)",
 "coordinative": "تنسيقي, عاطف ((في النحو) يعمل على ربط عنصرين نحويين متماثلين في البناء (مثل حروف العطف))\nمثال: 'و' في 'جون وماري' أو في 'جون مشى وماري ركبت' هو رابط تنسيقي (حرف عطف)؛ وكذلك 'أو' في 'هل ستذهب أم تبقى؟'",
 "coordinator": "مُنَسِّق / مُنَظِّم",
