 "coraciiform bird": "شقراقيات (طيور شجرية غير جاثمة قصيرة الأرجل بشكل رئيسي تعشش في الثقوب)",
 "coracle": "قفة",
 "coragyps atratus": "نسر أسود أمريكي (نسر أمريكي أصغر من النسر الرومي)",
 "corakan": "دخن الإصبع, راجي (عشب حبوب من شرق الهند تنتج بذوره دقيقاً مراً نوعاً ما، وهو غذاء أساسي في الشرق)",
 "coral": "مَرْجَان",
 "coral bean": "صفيراء ثانوية الأزهار, فاصولياء المسكال (شجيرة أو شجرة صغيرة لها أوراق ريشية سامة للماشية وعناقيد كثيفة من الزهور الزرقاء شديدة العطر وفاصولياء حمراء)",
 "coral bean tree": "إريثرينا مرجانية, شجرة الفول المرجاني (شجيرة متساقطة الأوراق لها عناقيد من الزهور الحمراء العميقة وبذور حمراء منقطة بالأسود)",
 "coral bush": "تيمبلتونيا, شجيرة المرجان (شجيرة أسترالية لها أوراق بيضاوية مقلوبة بسيطة وزهور قرمزية لامعة)",
 "coral drops": "بيسيرا, قطرات المرجان (عشب مكسيكي نصف قوي يزرع لمظلاته الطرفية المتدلية من الزهور الحمراء والبيضاء المبهرجة)",
 "coral fungus": "فطر مرجاني (أي من الفطريات العديدة من فصيلة كلافيارياسيا غالباً ما تكون زاهية الألوان وتنمو في مجموعات متفرعة بشكل معقد تشبه المرجان)",
 "coral gem": "جوهرة المرجان, لوتس بارثلوت (نبات معمر منخفض النمو كثير التفرع من جزر الكناري له زهور برتقالية حمراء إلى قرمزية أو أرجوانية؛ توطن في الولايات المتحدة)",
 "coral honeysuckle": "عسلة البوق, عسلة مرجانية (كرمة عسلة أمريكية شمالية دائمة الخضرة لها زهور حمراء مرجانية أو برتقالية)",
 "coral necklace": "عقد المرجان (نبات حولي أملس ذو جذر وتدي نحيل وعناقيد من الزهور البيضاء؛ غرب أوروبا خاصة مناطق غرب البحر الأبيض المتوسط والسواحل الأطلسية)",
 "coral pea": "بازلاء مرجانية",
 "coral reef": "شعاب مرجانية (شعاب تتكون من المرجان المتصلب في الحجر الجيري)",
 "coral root": "جذر المرجان (زهرة برية من جنس كورالوريزا تنمو من كتلة صلبة من الجذامير المرتبطة بفطر يساعد في امتصاص العناصر الغذائية من أرضية الغابة)",
 "coral sea": "بَحْر كُورَال (شَقّ الأرض؛ التَحَيُّر والبَهْت من الفزع أو من شدة العَطَش فنظر لا يقصد شيئا)\nمثال: هبطت على البحر.",
 "coral snake": "ثعبان مرجاني (أي من عدة ثعابين سامة من العالم الجديد مخططة ببراعة بالأحمر والأسود وإما الأصفر أو الأبيض؛ واسعة الانتشار في أمريكا الجنوبية والوسطى) / ثعبان مرجاني (أي من ثعابين سامة متنوعة من فصيلة العربيد في آسيا وأفريقيا وأستراليا)",
 "coral tree": "حَمْرِيَّة, إِرِيتْرِينَة",
 "coral vine": "كرمة المرجان, كينيديا كوكينيا (كرمة خشبية زاحفة أو متسلقة ذات أوراق جلدية صغيرة وعناقيد خيمية من الزهور الحمراء؛ موطنها أستراليا وتاسمانيا)",
 "coral-red": "أَحْمَر مَرْجَانِيّ (أحمر مع مسحة مرجانية)",
 "coral-root bittercress": "حرف بصيلي, عشبة المرجان (رشاد مر أوروبي ذو جذمور أبيض معقد)",
 "coral-wood": "خشب المرجان, صندل أحمر (شجرة من شرق الهند ذات عناقيد من الزهور الصفراء البيضاء؛ تزرع للزينة)",
 "coralbells": "أجراس المرجان, هيوشيرا دموية (نبات معمر من غرب الولايات المتحدة له زهور حمراء زاهية في سنابل ريشية؛ يستخدم للزينة)",
 "coralberry": "توت التوابل, توت المرجان (شجيرة ذات توت أحمر مرجاني؛ اليابان إلى شمال الهند) / توت المرجان, كشمش هندي (شجيرة نفضية من أمريكا الشمالية تزرع لعناقيدها الغزيرة من الثمار الحمراء المرجانية الشبيهة بالتوت)",
 "corallorhiza maculata": "جذر المرجان المرقط (جذر مرجان شائع له سيقان عديمة الأوراق بنية مصفرة أو محمرة أو أرجوانية تحمل عناقيد فضفاضة من الزهور الملونة بالمثل بشفاه بيضاء مرقطة بالأرجواني؛…)",
 "corallorhiza striata": "جذر المرجان المخطط (زهرة برية عديمة الأوراق تقريباً بسيقان منتصبة أرجوانية محمرة تحمل عناقيد من الزهور الوردية الشاحبة والمخططة بالبني؛ غرب كندا إلى المكسيك)",
 "corallorhiza trifida": "جذر المرجان المبكر (نبات له كتل من السيقان الصفراء الشاحبة إلى المخضرة عديمة الأوراق تقريباً تحمل زهوراً ملونة بالمثل بشفاه سفلية بيضاء؛ شمال نيو مكسيكو شمالاً عبر…)",
 "coralroot": "حرف بصيلي, عشبة المرجان (رشاد مر أوروبي ذو جذمور أبيض معقد)",
 "coralwood": "خشب المرجان, صندل أحمر (شجرة من شرق الهند ذات عناقيد من الزهور الصفراء البيضاء؛ تزرع للزينة)",
 "coralwort": "حرف بصيلي, عشبة المرجان (رشاد مر أوروبي ذو جذمور أبيض معقد)",
 "corban": "قُرْبَان",
 "corbel": "طنف, كابول ((في العمارة) دعامة مثلثة من الطوب أو الحجر (عادة ما تكون ذات امتداد بسيط))",
 "corbel arch": "قوس كابولي ((عمارة) قوس مشيد من مداميك حجرية تبرز تدريجياً حتى تلتقي)",
 "corbel step": "درجة الطنف, درجة جملونية ((في العمارة) درجة على قمة جدار الجملون)",
 "corbelled": "ذي كوابيل, مقرنص (لديه كوربل (حجر ناتئ للدعم))",
 "corbie gable": "جملون مدرج ((في العمارة) جملون ذو درجات تشبه السلم على حوافه)",
 "corbie-step": "درجة الطنف, درجة جملونية ((في العمارة) درجة على قمة جدار الجملون)",
 "corbiestep": "درجة الطنف, درجة جملونية ((في العمارة) درجة على قمة جدار الجملون)",
 "corbina": "كوربينا (سمكة بياض زرقاء رمادية في ساحل كاليفورنيا)",
 "corchorus": "جوت, ملوخية (أي من نباتات مختلفة من جنس كوركوروس لها أوراق كبيرة وعناقيد من الزهور الصفراء؛ مصدر للجوت)",
 "corcyra": "كورسيرا",
 "cord": "خَيْط, حَبْل ((خَيَّطَ) الشَّيْبُ في رأسِهِ تَخْييطًا: بَدَا، أو صارَ كالخُيُوطِ فَتَخَيَّطَ رأسُهُ بالشَّيْبِ؛ (خَيَّطَ) الثَّوْب: خاطه)\nمثال: حل الصرة تلقى خيط.",
 "cord blood": "دم الحبل السري (دم يتم الحصول عليه من الحبل السري عند الولادة)",
 "cord grass": "سبارتينا, عشب الحبل (أي من عدة أعشاب معمرة من جنس سبارتينا؛ بعضها مهم كمثبتات للتربة الساحلية)",
 "cordage": "تجهيزات الحبال, حبال السفينة (الحبال الموجودة في تجهيزات السفينة) / قياس الخشب بالأكوام (كمية الخشب في منطقة ما مقاسة بالأكوام (الكورد))",
 "cordarone": "أميودارون, كوردارون (دواء مضاد لاضطراب النظم (الاسم التجاري كوردارون) له آثار جانبية خطيرة محتملة ويستخدم للسيطرة على مشاكل ضربات القلب الخطيرة فقط عندما تكون الأدوية…)",
 "cordate": "قَلْبِيّ الشَّكْل ((عن الورقة) على شكل قلب)",
 "cordate leaf": "ورقة قلبية (ورقة على شكل قلب)",
 "corded": "مَبْرُوم, مُحَزَّز (ذو أضلاع أو خيوط بارزة ملتوية)",
 "cordgrass": "سبارتينا, عشب الحبل (أي من عدة أعشاب معمرة من جنس سبارتينا؛ بعضها مهم كمثبتات للتربة الساحلية)",
 "cordia alliodora": "دردار إسباني, كورديا (شجرة أمريكية استوائية كبيرة من جنس كورديا تزرع لزهورها البيضاء الكريمية الوفيرة وخشبها القيم)",
 "cordia gerascanthus": "خشب الأمير, دردار إسباني (شجرة خشب أمريكية استوائية)",
 "cordial": "بَشُوش, لَطِيف (يَنْشُرُ الدِّفْء وَالوُدّ مِنْ حَوْلِه) / حَمِيم, وِدِّيّ (مَحْسُوس بِإِخْلَاص وَعُمْق) / لَطِيف, وَدِّيّ (دافئ وودّي بأدب ولباقة) / ليكير, مشروب كحولي حلو (مشروب قوي حلو ومنكه بشدة يُشرب عادة بعد الوجبة)",
 "cordial reception": "حَفَاوَة, حُسْن الِاسْتِقْبَال (اللطف في استقبال الضيوف أو الغرباء)",
 "cordiality": "مؤاكلة, وئام",
 "cordially": "بحرارة, بقلب خالص (بطريقة قلبية)\nمثال: رحبنا بها بحرارة",
 "cordierite": "كورديريت (معدن أزرق يتكون من المغنيسيوم والحديد والألمنيوم والسيليكون والأكسجين؛ يستخدم غالباً كحجر كريم)",
 "cordiform": "قَلْبِيّ الشَّكْل ((عن الورقة) على شكل قلب)",
 "cordite": "كوردايت (مسحوق متفجر (نتروجليسرين وقطن البارود وفازلين) مذاب في الأسيتون ومجفف ومبثوق في خيوط بنية)",
 "corditis": "التهاب الحبل المنوي (التهاب الحبل المنوي، يرافقه ألم في الخصية، وينتج عموماً عن عدوى مصدرها مجرى البول أو ورم أو قيلة مائية أو دوالي الخصية)",
 "cordless": "بدون سلك, لاسلكي (ليس له سلك)\nمثال: هاتف لاسلكي",
 "cordoba": "كوردوبا (وحدة المال الأساسية في نيكاراغوا؛ تساوي 100 سنتافو)",
 "cordon": "شريط زينة, وشاح (زينة تتكون من شريط أو حبل مزخرف) / شريط, وشاح (حبل أو شريط يلبس كشارة شرف أو رتبة) / طوق, كردون (سلسلة من الحراس أو المراكز العسكرية تحيط أو تحرس مكاناً أو شيئاً ما)",
 "cordon bleu": "شريط أزرق (شرف أو جائزة تُكتسب للتميز) / طاهٍ ماهر, كوردون بلو (طاهٍ مشهور بمهارته العالية)",
 "cordovan": "قرطبي",
 "cords": "بنطال مخمل مضلع, كودري (سراويل قطنية مصنوعة من قماش المخمل المضلع)",
 "corduroy": "قماش مضلع, كودري (قماش وبري مقصوص ذو أضلاع عمودية؛ عادة ما يكون مصنوعاً من القطن) / طريق جذوع الشجر (طريق مصنوع من جذوع الأشجار الموضوعة بشكل عرضي)",
 "corduroys": "بنطال مخمل مضلع, كودري (سراويل قطنية مصنوعة من قماش المخمل المضلع)",
 "cordwood": "حطب مكدس (حطب مقطع ومكدس في أكوام معيارية)",
 "cordyline australis": "شجرة العشب, شجرة الملفوف (شجرة أنيقة لها إما جذع واحد أو جذع متفرع كل منها بخصل طرفية من أوراق ضيقة طويلة وعناقيد كبيرة من الزهور العطرة البيضاء أو الصفراء أو الحمراء؛…)",
 "cordyline terminalis": "تي, كورديلين (شجيرة ذات خصل طرفية من الأوراق الممدودة تستخدم محلياً للقش والملابس؛ تستخدم الجذور الحلوة السميكة كغذاء؛ جنوب شرق آسيا الاستوائي وأستراليا وهاواي)",
 "core": "نِوَاة",
 "core belief": "اِعْتِقَاد أَسَاسِيّ",
 "core bit": "ريشة لُبِّية (ريشة حفر مجوفة تمثل الجزء القاطع من المثقاب اللبي؛ تسمح بأخذ عينات لبية)",
 "core blower": "نافخ القوالب الرملية (آلة تستخدم الهواء المضغوط لنفخ وتعبئة الرمل في صندوق القالب)",
 "core drill": "حفار العينات الجوفية, مثقاب لُبِّي (مثقاب يزيل عينة أسطوانية (لب) من ثقب الحفر)",
 "core dump": "تفريغ الذاكرة الأساسية, تفريغ النواة ((في علم الحاسوب) تفريغ محتويات السجلات الرئيسية في وحدة المعالجة المركزية؛ يستخدم عادة لتصحيح الأخطاء)",
 "core group": "جوهر, مجموعة أساسية (مجموعة صغيرة من الأشخاص أو الأشياء التي لا غنى عنها)\nمثال: خمس دوريات تشكل نواة برنامج النشر الخاص بهم",
 "core histone": "هيستون لبّي",
 "core memory": "ذاكرة القلب المغناطيسي (ذاكرة كمبيوتر تتكون من مصفوفة من القلوب المغناطيسية؛ تم استبدالها الآن بذواكر أشباه الموصلات)",
 "core shooter": "آلة قذف القوالب الرملية (آلة تستخدم في عملية قذف القوالب لإنتاج القوالب الرملية)",
 "core shooting machine": "آلة قذف القوالب الرملية (آلة تستخدم في عملية قذف القوالب لإنتاج القوالب الرملية)",
 "coreference": "إِحَالَة مُشْتَرَكَة (العلاقة النحوية بين كلمتين تشيران إلى نفس المرجع)",
 "coreferent": "مُتَطَابِقُ الْمَرْجِعِ (مرتبط بمشاركة رابط رمزي لكيان واحد)",
 "coreferential": "مشترك المرجع (يتعلق بالاشتراك في المرجع (الإحالة إلى نفس الشيء))",
 "coregonus artedi": "سيسكو (سمكة طعام مهمة في البحيرات العميقة الباردة في أمريكا الشمالية)",
 "coregonus clupeaformis": "سمك أبيض بحيري (يوجد في البحيرات العظمى وشمالاً حتى ألاسكا)",
 "coreid": "بق الأرجل الورقية, كوريد (بق حقيقي)",
 "coreid bug": "بق الأرجل الورقية, كوريد (بق حقيقي)",
 "coreligionist": "مشارك في المذهب (شخص يدين بنفس ديانة شخص آخر)",
 "coreopsis": "أشرفية, بذر القراد",
 "coreopsis gigantea": "بذرة القراد العملاقة, كوريوبسيس عملاق (شجيرة كبيرة تشبه الشجرة ذات أوراق ريشية وعناقيد من رؤوس الزهور الصفراء الكبيرة؛ ساحل جنوب كاليفورنيا)",
 "coreopsis maritima": "داليا البحر (عشبة قوية بأزهار واحدة لكل ساق؛ نبات زينة مطور من زهرة برية مكسيكية)",
 "coreopsis tinctoria": "بذرة القراد, كاليوبسيس (نبات حولي من أمريكا الشمالية يزرع على نطاق واسع لأزهاره الصفراء ذات المراكز الحمراء الأرجوانية إلى البنية؛ يصنف في بعض التصنيفات ضمن جنس فرعي…)",
 "corer": "أداة إزالة اللب, مقوّر (أداة لإزالة اللب من التفاح)",
 "corespondent": "شريك في الزنا (المتهم المشارك المتهم بالزنا مع الزوج المنفصل في إجراءات الطلاق)",
 "corfu": "كُورْفُو",
 "corgard": "كورجارد, نادولول (عامل حاصر لبيتا الأدرينالية (الاسم التجاري كورجارد) يستخدم لعلاج ارتفاع ضغط الدم والذبحة الصدرية)",
 "corgi": "كورجي, ويلش كورجي (أي من سلالتين ويلزيتين من الكلاب طويلة الجسم وقصيرة الأرجل ذات آذان منتصبة ورأس يشبه الثعلب)",
 "coriaceous": "جِلْدِيّ, مُتَجَلِّد (يشبه الجلد أو مصنوع ليشبهه؛ صلب لكنه مرن)",
 "coriander": "كُزْبَرَة, قُسْبَرَة",
 "coriander plant": "كزبرة (عشب من العالم القديم بأوراق عطرية وبذور تشبه البقدونس)",
 "coriander seed": "بذور الكزبرة, كزبرة (بذور الكزبرة المجففة تستخدم كاملة أو مطحونة)",
 "coriandrum sativum": "كزبرة (عشب من العالم القديم بأوراق عطرية وبذور تشبه البقدونس)",
 "coricidin": "كلور-تريميتون, كلورفينيرامين (مضاد للهيستامين (الأسماء التجارية كلور-تريميتون وكوريسيدين))",
 "corinth": "كُورِنْثْ",
 "corinthia": "قُورِنْثِيَا",
 "corinthian": "كورنثي (من أو متعلق بـ أو من خصائص كورنث أو سكانها) / كورنثي (متعلق بالطراز الكورنثي في العمارة) / كورنثي (مقيم في كورنثوس) / زير نساء, لعوب (رجل مكرس للسعي وراء المتعة)",
 "corinthian order": "نظام كورنثي (آخر نظام يوناني؛ مشابه للنظام الإيوني باستثناء أن التاج مزخرف بنقوش لأوراق الأقنثة)",
 "coriolis effect": "تأثير كوريوليس ((في الفيزياء) تأثير يختبر فيه جسم يتحرك في إطار مرجعي دوار قوة كوريوليس التي تعمل بشكل عمودي على اتجاه الحركة ومحور الدوران؛ على الأرض، يحرف تأثير…)",
 "coriolis force": "قوة كوريوليس ((في الفيزياء) قوة ناتجة عن دوران الأرض؛ تؤثر على جسم متحرك (طائرة أو مقذوف) في إطار مرجعي دوار؛ في الإطار المرجعي الدوار يمكن تطبيق قانون نيوتن…)",
 "corium": "كوريوم",
 "cork": "فِلِّينَة, فَدَام",
