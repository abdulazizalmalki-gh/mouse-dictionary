 "baulker": "عَنِيد, مُمَانِع (شخص يرفض الامتثال)",
 "bauxite": "بوكسيت (معدن شبيه بالطين؛ الخام الرئيسي للألمنيوم؛ يتكون من أكاسيد الألمنيوم وهيدروكسيدات الألمنيوم؛ يستخدم كمادة كاشطة ومحفز)",
 "bauxitic": "بوكسيتي (يشبه أو يحتوي على البوكسيت)",
 "bavaria": "بفاريا, بَافَارِيَّا",
 "bavarian": "البافارية",
 "bavarian blue": "جبن أزرق بافاري (جبن أزرق من بافاريا)",
 "bavarian cream": "كريمة بافارية (كاسترد غني مثبت بالجيلاتين)",
 "bawbee": "بوبي (عملة اسكتلندية قديمة ذات قيمة قليلة)",
 "bawd": "بائعة هوى, عاهرة (امرأة تمارس الجماع الجنسي مقابل المال)",
 "bawdily": "بِبَذَاءَة, بِمُجُون (بطريقة بذيئة)",
 "bawdiness": "بذاءة, فحش (سمة التصرف بطريقة فاحشة)",
 "bawdry": "فجور, كلام بذيء (كلام أو كتابة بذيئة أو فاحشة)\nمثال: نشروا مجموعة من الفجور الإليزابيثي",
 "bawdy": "خَلِيع, مَاجِن (فاحش بطريقة فكاهيّة ومرحة) / فجور, كلام بذيء (كلام أو كتابة بذيئة أو فاحشة)\nمثال: نشروا مجموعة من الفجور الإليزابيثي",
 "bawdyhouse": "بيت دعارة, ماخور (مبنى تتوفر فيه البغايا)",
 "bawler": "باكٍ بِصَوْت عالٍ, صارِخ (شخص يبكي بصوت مرتفع) / زاعق, صائح (شخص يتواصل صوتيًا بصوت عالٍ جدًا)\nمثال: طفلهم الجديد كثير الصراخ والبكاء",
 "bawling": "صراخ, عويل (صرخات عالية أثناء البكاء)",
 "bawling out": "تَقْرِيع شَدِيد, تَوْبِيخ لَاذِع (توبيخ شديد وقاسٍ)",
 "bay": "خَلِيج, شَرْم",
 "bay grass": "إراغروستيس, عشب الحب (أي من أعشاب مختلفة من جنس إراغروستيس؛ مفيدة بشكل خاص للعلف ومنع التعرية)",
 "bay laurel": "غَار",
 "bay leaf": "ورق الغار (ما ينمو على النبات من الأعلى والجوانب بشكل صفائح ذات لون أخضر أو مائل إلى الخضرة. انظر الصورة؛ جلود رقاق يُكتَبُ عليها)\nمثال: هات ورقة بيضاء.",
 "bay lynx": "بوبكات, وشق أحمر (وشق صغير يعيش في أمريكا الشمالية)",
 "bay myrtle": "آس الشمع, شجرة الشمع (شجرة شجيرية عطرية دائمة الخضرة في جنوب شرق الولايات المتحدة لها توت صلب صغير مغطى بكثافة بشمع أبيض يستخدم للشموع)",
 "bay of bengal": "خَلِيج الْبَنْغَال",
 "bay of biscay": "خَلِيج غَاشْكُونِيَا, خَلِيج بِسْكَاي",
 "bay rum": "باي رم, غسول الغار (سائل عطري كان يتم الحصول عليه في الأصل عن طريق تقطير أوراق شجرة التوت البري (الغار) مع الروم)",
 "bay scallop": "إسقلوب الخليج (إسقلوب صغير يسكن المياه الضحلة والمسطحات الطينية لساحل المحيط الأطلسي لأمريكا الشمالية) / إسقالوب الخليج (عضلة إسقالوب صغير ممتاز من المياه الضحلة)",
 "bay stater": "ماساتشوستي (مواطن أو مقيم في ماساتشوستس)",
 "bay tree": "شجرة الغار, غار (شجرة متوسطية صغيرة دائمة الخضرة ذات ثمار سوداء صغيرة وأوراق عطرية لامعة تستخدم للنكهة في الطهي؛ استخدمها الإغريق القدماء أيضاً لتتويج المنتصرين)",
 "bay willow": "صفصاف الغار, صفصاف خماسي الأسدية (شجرة صفصاف أوروبية بأوراق جلدية لامعة؛ متوطنة على نطاق واسع في شرق الولايات المتحدة)",
 "bay window": "نافذة بارزة (نافذة تبرز من الجدار الخارجي للمنزل) / كرش (مصطلحات عامية للكرش أو البطن البارز)",
 "bay wreath": "إكليل الغار ((في العصور القديمة) إكليل من أوراق الغار يُلبس على الرأس كشعار للنصر)",
 "bay-leaved caper": "شجرة القبار, قبار غاري الورق (شجيرة أو شجرة صغيرة من جنوب فلوريدا إلى أمريكا الوسطى والجنوبية)",
 "bay-rum tree": "شجرة الباي, شجرة رم الباي (شجرة من جزر الهند الغربية؛ مصدر لرم الباي)",
 "baya": "بايا (طائر نساج هندي شائع)",
 "bayat": "بيعة (يمين الولاء لأمير)",
 "bayberry": "توت الشمع, شمعية (شجيرة عطرية نفضية من شرق أمريكا الشمالية بتوت مغطى بالشمع الرمادي الأخضر) / شجرة الباي, شجرة رم الباي (شجرة من جزر الهند الغربية؛ مصدر لرم الباي)",
 "bayberry tallow": "شمع التوت (شمع أخضر عطري يُستخرج من شجيرات الشمع ويُستخدم في صنع الشموع)",
 "bayberry wax": "شمع التوت (شمع أخضر عطري يُستخرج من شجيرات الشمع ويُستخدم في صنع الشموع)",
 "baycol": "بايكول, سيريفاستاتين (دواء فموي (الاسم التجاري بايكول) لتقليل مستويات الكوليسترول في الدم)",
 "bayer": "أسبرين, حمض الأسيتيل ساليسيليك (مشتق مؤستل لحمض الساليسيليك؛ يستخدم كدواء مسكن ومضاد للالتهابات (الأسماء التجارية باير وغيرها) يؤخذ عادة على شكل أقراص؛ يستخدم كخافض للحرارة ويبطئ…)",
 "bayes' postulate": "مسلمة بايز ((إحصاء) صعوبة تطبيق مبرهنة بايز تكمن في أن احتمالات الأسباب المختلفة نادراً ما تكون معروفة، وفي هذه الحالة يمكن افتراض أنها جميعاً متساوية)",
 "bayes' theorem": "مبرهنة بايز ((إحصاء) مبرهنة تصف كيفية حساب الاحتمال الشرطي لمجموعة من الأسباب المحتملة لحدث ملاحظ معين من معرفة احتمال كل سبب والاحتمال الشرطي لنتيجة كل سبب)",
 "bayesian": "بايزي (من أو متعلق بالطرق الإحصائية القائمة على مبرهنة بايز)",
 "bayonet": "حَرْبَة, سُونْكِيّ (آلة للحَرْب تكون قصيرة مُحَدَّدة الرَأس تستخدم للطَعْن. غالبا ما تُرَكَّب على غيرها مثل الرُمْح أو البُنْدُقِيَّة. الجمع حِرَاب وحَرْبَات؛ رأس حَرْبَة: تعبير مجازيّ يقصد به شيء يستخدم لتهديد العَدُو)",
 "bayou": "بايو, جدول مستنقعي (ذراع مستنقعي أو مخرج بطيء الجريان لبحيرة (يستخدم المصطلح بشكل رئيسي في ميسيسيبي ولويزيانا))",
 "bazaar": "سُوق, بَازَار (مكان للبيع والشراء؛ جمع ساق، قال الله تعالى: 《رُدُّوهَا عَلَيَّ فَطَفِقَ مَسْحًا بِالسُّوقِ وَالْأَعْنَاقِ》)\nمثال: ذهبت إلى السوق.",
 "bazar": "بازار, متجر خردوات (متجر تُباع فيه مجموعة متنوعة من البضائع) / بازار, سوق شرقي (شارع يضم متاجر صغيرة (خاصة في الشرق))",
 "bazillion": "أعداد لا تحصى, ملايين (عدد كبير جداً غير محدد (عادة ما يستخدم للمبالغة))\nمثال: كان هناك الملايين من الذباب",
 "bazooka": "بَازُوكَة",
 "bb": "خردقة, طلقة بي بي (كرية صغيرة تُطلق من بندقية هوائية)",
 "bb gun": "بندقية بي بي, بندقية خردق (بندقية هوائية يتم فيها دفع الكريات بواسطة الهواء المضغوط)",
 "bb shot": "خردقة, طلقة بي بي (كرية صغيرة تُطلق من بندقية هوائية)",
 "bbc": "بِي بِي سِي",
 "bbl": "برميل (أي من وحدات السعة المختلفة)\nمثال: برميل البيرة هو 31 غالوناً وبرميل النفط هو 42 غالوناً",
 "bbs": "نظام لوحة الإعلانات الإلكترونية (حاسوب يشغل برنامجاً يسمح للمستخدمين بترك رسائل والوصول إلى معلومات ذات اهتمام عام)",
 "bc": "ق. م, قَبْلَ الْمِيلَاد",
 "bce": "قبل الحقبة العامة (في الفترة التي سبقت الحقبة العامة؛ يفضل استخدامها بعض الكتاب غير المسيحيين)\nمثال: في عام 200 قبل الحقبة العامة",
 "bd": "بكالوريوس في اللاهوت (درجة البكالوريوس في الدراسات الدينية)",
 "bdellium": "مقل (صمغ راتنجي عطري؛ يشبه المر)",
 "be": "كَانَ (اِتَّصَفَ. (فعل ناقص)؛ حَدَثَ) / كَانَ هُوَ, هِيَ (اِتَّصَفَ. (فعل ناقص)؛ حَدَثَ)\nمثال: كان الكلب ميتا.",
 "be able to": "اِسْتَطَاعَ, قَدَرَ (أَطَاقَ الشَّيءَ وقَدَرَ عليه، أَمْكَنَهُ الشَّيءُ)\nمثال: توم استطاع ان يهرب",
 "be all and end all": "الغاية والمنى, الكل في الكل (العامل الأساسي؛ العنصر الأهم؛ الغاية العليا)\nمثال: الربح هو الغاية والمنى في الأعمال التجارية",
 "be ashamed": "اِسْتَحَى",
 "be awake": "يَقِظَ, يَقُظَ",
 "be born": "وُلِدَ, تَوَلَّدَ (الرجلُ و المرأةُ ومثلهما الانسان: أنجب؛ الرجلُ و المرأةُ وَلَدًا: أنجبه)\nمثال: أعرف ذلك الولد.",
 "be called": "سُمِّيَ",
 "be careful what you wish for": "تَجْرِي الرِّيَاحُ بِمَا لَا تَشْتَهِي السُّفُنُ",
 "be late": "تَأَخَّرَ",
 "be oneself": "كَانَ نَفْسَكَ, كَانَ نَفْسَكِ (اِتَّصَفَ. (فعل ناقص)؛ حَدَثَ)\nمثال: كان الكلب ميتا.",
 "be right": "أَصَابَ, أَحَقَّ",
 "be right back": "سَأَعُودُ بَعْدَ قَلِيل",
 "be silent": "صَمَتَ, سَكَتَ",
 "be-all and end-all": "الغاية والمنى, الكل في الكل (العامل الأساسي؛ العنصر الأهم؛ الغاية العليا)\nمثال: الربح هو الغاية والمنى في الأعمال التجارية",
 "beach": "شَاطِئ (المنطقة اليابسة على طول حافة البحر والمحيط. شَطّ، سَاحِل، جَانِب؛ (غير شائعة) المنطقة اليابسة على طول حافة النهر. ضِفَّة، جَانِب، شَطّ) / سَاحِل\nمثال: عاد إلى الشاطئ.",
 "beach aster": "أقحوان شاطئي, نجمة الشاطئ (نبات معمر عصاري قليلاً بأوراق قاعدية وسيقان لزجة مشعرة كل منها يحمل رأس زهرة منفرداً بأشعة ضيقة وردية أو لافندر؛ المنحدرات الساحلية من أوريغون إلى…)",
 "beach ball": "كرة الشاطئ (كرة كبيرة وخفيفة؛ للعب على شاطئ البحر)",
 "beach buggy": "عربة الكثبان الرملية (مركبة ترفيهية بإطارات كبيرة تستخدم على الشواطئ أو الكثبان الرملية)",
 "beach chair": "كرسي الشاطئ, كرسي سطح السفينة (كرسي قابل للطي للاستخدام في الهواء الطلق؛ يدعم إطار خشبي قطعة من القماش)",
 "beach erosion": "تآكل الشواطئ (تآكل الشواطئ)",
 "beach flea": "برغوث الشاطئ (قشريات صغيرة من مزدوجات الأرجل تقفز مثل البراغيث؛ شائعة على شواطئ المحيط)",
 "beach goldenrod": "عصا الذهب الشاطئية (عصا ذهب مبهرجة قوية شائعة على طول الساحل الشرقي وساحل الخليج لأمريكا الشمالية)",
 "beach grass": "عشب الشاطئ (أعشاب قاسية ذات جذور قوية يمكن أن تنمو على الشواطئ الرملية المكشوفة)",
 "beach heather": "خلنج الشاطئ, عشب الفقر (نبات صغير يشبه الخلنج مغطى بزغب أبيض ينمو على الشواطئ في شمال شرق أمريكا الشمالية)",
 "beach house": "منزل شاطئي (منزل مبني على الشاطئ أو بالقرب منه)",
 "beach morning glory": "أثمان قدم الماعز, كرمة السكة الحديد (نبات معمر مفترش في الكثبان الرملية الساحلية من فلوريدا إلى تكساس)",
 "beach pancake": "فطيرة الشاطئ (نبات ذو رؤوس نصف كروية من الزهور الحمراء النبيذية؛ يوجد في الكثبان الساحلية من كاليفورنيا إلى المكسيك)",
 "beach pea": "بازلاء الشاطئ, جلبان بحري (بازلاء برية في شواطئ المنطقة المعتدلة الشمالية لها جذور قوية وزهور أرجوانية ومفيدة كمثبت للرمال)",
 "beach plum": "برقوق الشاطئ (فاكهة أرجوانية داكنة صغيرة تستخدم خاصة في المربيات والفطائر) / برقوق الشاطئ (شجيرة ساحلية من شمال شرق أمريكا الشمالية لها أزهار بيضاء ملفتة للنظر وفاكهة أرجوانية صالحة للأكل)",
 "beach plum bush": "برقوق الشاطئ (شجيرة ساحلية من شمال شرق أمريكا الشمالية لها أزهار بيضاء ملفتة للنظر وفاكهة أرجوانية صالحة للأكل)",
 "beach sand verbena": "لويسية رملية شاطئية, لويسية رملية وردية (عشبة مفترشة ذات رؤوس من الزهور الوردية الداكنة إلى البيضاء؛ توجد في الكثبان الساحلية من كولومبيا البريطانية إلى باجا كاليفورنيا)",
 "beach soccer": "كُرَة قَدَم شَاطِئِيَّة",
 "beach strawberry": "فراولة الشاطئ, فراولة تشيلية (فراولة برية من غرب الولايات المتحدة وأمريكا الجنوبية؛ مصدر للعديد من أصناف الفراولة المزروعة)",
 "beach towel": "منشفة شاطئ (منشفة كبيرة جداً لتجفيف النفس بعد السباحة)",
 "beach volleyball": "كُرَة طَائِرَة شَاطِئِيَّة",
 "beach waggon": "ستيشن واغن, سيارة عائلية (سيارة ذات جسم طويل وباب خلفي مع مساحة خلف المقعد الخلفي)",
 "beach wagon": "ستيشن واغن, سيارة عائلية (سيارة ذات جسم طويل وباب خلفي مع مساحة خلف المقعد الخلفي)",
 "beach wormwood": "شيح الشاطئ, طاحونة الغبار (عشبة بأوراق رمادية توجد على طول الساحل الشرقي لأمريكا الشمالية؛ تستخدم كنبات زينة)",
 "beachball": "كرة الشاطئ (كرة كبيرة وخفيفة؛ للعب على شاطئ البحر)",
 "beachcomber": "متشرد الشواطئ (متشرد يعيش على الشاطئ)",
 "beachfront": "واجهة شاطئية (شريط من الأرض يمتد على طول الشاطئ)",
 "beachhead": "ركيزة, موطئ قدم (إنجاز أولي يفتح الطريق لتطورات لاحقة) / رأس شاطئ (رأس جسر على ساحل العدو تم الاستيلاء عليه بواسطة عملية برمائية)\nمثال: أصبحت المدينة موطئ قدم في الحملة لحظر التدخين في الهواء الطلق",
 "beachwear": "ملابس بحر (ملابس مخصصة للارتداء على الشاطئ)",
 "beacon": "فَنَار / مَنَار",
 "beacon fire": "مشعل, منارة (نار (عادة على تل أو برج) يمكن رؤيتها من مسافة بعيدة)",
 "beacon light": "فنار, منارة (برج به ضوء يعطي تحذيراً للسفن العابرة من الأرصفة الصخرية أو المياه الضحلة)",
 "bead": "خرزة (كرة صغيرة بها ثقب في المنتصف) / حافة خرزية (إطار مزخرف بالخرز لحاشية أو تزيين الأثاث) / حبة, قطرة (شكل كروي وصغير)\nمثال: حبات العرق على جبهته",
 "bead and quirk": "خرز مجوف (حافة خرزية مشكلة مع أخدود ضيق يفصلها عن السطح الذي تزينه)",
 "bead fern": "أونوكليا, سرخس الخرز (سرخس منتشر جميل في شرق أمريكا الشمالية وشرق آسيا تم توطينه في أوروبا الغربية؛ يُظهر السعف المقسم ريشياً ميلاً طفيفاً للطي عند لمسه؛ تحيط الوريقات…)",
 "bead tree": "أَزَادَرْخَت",
 "beaded": "مُتَحَبِّب, مُتَرَشِّح (مغطى بحبيبات أو قطرات من السائل)",
 "beaded lizard": "سحلية خرزية (سحلية ذات حراشف تشبه الخرز الأسود والمصفر؛ من غرب المكسيك)",
 "beading": "حافة خرزية (إطار مزخرف بالخرز لحاشية أو تزيين الأثاث) / تطريز بالخرز (زخرفة باستخدام الخرز)",
 "beading plane": "مِسْحَج التحزيز, مِسْحَج الخرز (مسحج بشفرة مقعرة لعمل قوالب ذات خرز (زخارف دائرية))",
 "beadle": "شَمّاس",
 "beadlike": "لَامِع كَالخَرَز (صَغِير ومُسْتَدِير ولَامِع كَالخَرَزَة أَوِ الزِّرّ)",
 "beads": "خرز, عقد خرز (عدة خرزات منظومة معاً في خيط)",
 "beadsman": "مصلٍّ بالأجر (شخص ذكر يُدفع له للصلاة من أجل روح شخص آخر)",
 "beadswoman": "مصلية مأجورة (شخص أنثى يُدفع لها للصلاة من أجل روح شخص آخر)",
 "beadwork": "حافة خرزية (إطار مزخرف بالخرز لحاشية أو تزيين الأثاث) / تطريز بالخرز (زخرفة باستخدام الخرز)",
 "beady": "مُرَصَّع, مُزَيَّن بِالجَوَاهِر (مُغطّى بالخرز أو الجواهر أو الترتر) / لَامِع كَالخَرَز (صَغِير ومُسْتَدِير ولَامِع كَالخَرَزَة أَوِ الزِّرّ)",
 "beady-eyed": "لَمَّاع العَيْنَيْن خُبْثًا (ذو عينين تلمعان بالخبث)",
 "beagle": "بيجل (سلالة صغيرة قصيرة الأرجل ناعمة المعطف من كلاب الصيد)",
 "beagling": "صيد بكلاب البيغل (صيد الأرانب باستخدام كلاب البيغل)",
 "beak": "مِنْقَار",
 "beaked": "ذُو مِنْقَار, مِنْقَارِيّ (لديه أو يشبه المنقار)",
 "beaked hazelnut": "بندق منقاري (بندق من غرب الولايات المتحدة بقنابات تشبه المنقار واضحة على المكسرات)",
 "beaked parsley": "بقدونس إفرنجي, سرفيل (عشب حولي عطري من العالم القديم يزرع لأوراقه المقسمة بدقة والمجعدة غالباً للاستخدام خاصة في الحساء والسلطات)",
 "beaked salmon": "سلمون منقاري, سمكة الرمل (سمكة تعيش في المناطق الرملية في غرب المحيط الهادئ والمحيط الهندي، لها خطم زاوي للحفر في الرمال)",
 "beaked whale": "حوت منقاري (أي من الحيتان العديدة التي تعيش في جميع المحيطات ولها فكوك تشبه المنقار مع أسنان أثرية في الفك العلوي)",
 "beaker": "قدح, كأس (كوب (عادة بدون مقبض)) / كأس مختبر (جرة مسطحة القاع مصنوعة من الزجاج أو البلاستيك؛ تستخدم للكيمياء)",
 "beakless": "بِلَا مِنْقَار (ليس لديه منقار)",
 "beaklike": "مِنْقَارِيّ الشَّكْل (يشبه منقار الطائر في شكله)",
 "beam": "خَشَبَة / كَمَرَة, جَائِز / شُعَاع",
 "beam balance": "ميزان العارضة, ميزان ذو كفتين (ميزان يتكون من رافعة ذات ذراعين متساويين وكفة معلقة من كل ذراع)",
 "beam of light": "حزمة ضوئية, شعاع (عمود من الضوء (كما من منارة))",
 "beam scale": "ميزان القبان, ميزان ذو ذراعين (ميزان محمول يتكون من قضيب محوري بأذرع غير متساوية الطول)",
 "beam-ends": "نهايات العوارض ((ملاحي) عند نهايات عوارض السطح المستعرضة للسفينة)\nمثال: المصطلح يعني الميلان على الجانب بحيث يكون السطح رأسياً تقريباً",
 "beaming": "مُشِعّ, وَضَّاء (يَبُثّ الضَّوْء أَوْ كَأَنَّهُ يَبُثّ ضَوْءًا) / بَهِيج, مُشْرِق (مبتهج ومشرق) / مُبْتَهِج, مُشِعّ سَعَادَةً (مسرور وفخور)",
 "beamish": "بَسَّام, مُبْتَسِم (يبتسم بسعادة وتفاؤل)",
 "beamy": "مُشِعّ, وَضَّاء (يَبُثّ الضَّوْء أَوْ كَأَنَّهُ يَبُثّ ضَوْءًا) / عَرِيض الهَيْكَل (عريض في عرض السفينة أو الهيكل)",
 "bean": "فَاصُولِيَا, لُوبِيَا",
 "bean aphid": "من الفاصوليا (من مسود يغزو الفاصوليا وبنجر السكر مثلاً)",
 "bean beetle": "خنفساء الفاصوليا المكسيكية (أدخلت إلى الولايات المتحدة من المكسيك؛ تتغذى على أوراق نبات الفاصوليا)",
 "bean blight": "اللفحة الهالية, لفحة الفاصوليا (لفحة تصيب نباتات الفاصوليا)",
 "bean caper": "زيجوفيلوم, قبار الفول (شجيرة معمرة من منطقة شرق البحر الأبيض المتوسط وجنوب غرب آسيا لها زهور تستخدم براعمها كالقبار)",
 "bean counter": "محاسب متزمت, مدقق حسابات (محاسب أو بيروقراطي يُعتقد أنه يولي اهتماماً مفرطاً للتحكم في النفقات)",
 "bean curd": "توفو, خثرة الفول (طعام يشبه الجبن مصنوع من حليب فول الصويا المتخثر)",
 "bean dip": "تغميسة الفول (تغميسة مصنوعة من الفول المطبوخ)",
 "bean plant": "بقلة, فاصولياء (أي من النباتات البقولية المختلفة التي تزرع لبذورها وقرونها الصالحة للأكل)",
 "bean sprout": "برعم الفاصولياء, نبتة الفاصولياء (أي من حبوب الفاصولياء المستنبتة المختلفة: خاصة الماش أو العدس أو فول الصويا الصالح للأكل)",
 "bean tostada": "توستادا الفاصوليا (تورتيلا مسطحة مغطاة بالفاصوليا المقلية)",
 "bean tree": "شجرة الفول (أي من الأشجار المتعددة التي لها قرون بذور كفاكهة)",
 "bean trefoil": "خروب الخنزير, نفل الفول (شجيرة ذات أوراق ثلاثية وأزهار صفراء تليها قرون بذور منحنية للخلف؛ الأوراق كريهة الرائحة عند سحقها)",
 "bean weevil": "سوسة الفاصوليا (تعيش اليرقات وتتغذى في الفاصوليا النامية أو المخزنة)",
 "bean-shaped": "فَاصُولِيَائِيُّ الشَّكْلِ (ذو شكل يشبه حبّة الفاصولياء)",
 "beanbag": "كيس حبوب, كيس فول (كيس قماشي صغير مملوء بالحبوب المجففة؛ يُرمى في الألعاب)",
 "beanball": "رمية نحو الرأس (كرة بيسبول ترمى عمداً نحو رأس الضارب)",
 "beaner": "رمية نحو الرأس (كرة بيسبول ترمى عمداً نحو رأس الضارب)",
 "beanfeast": "وليمة الموظفين (حفل عشاء سنوي يقيمه صاحب العمل للموظفين)",
 "beanie": "طَاقِيَّة",
 "beano": "بينغو, لوتو (لعبة يتم فيها سحب كرات مرقمة عشوائياً ويغطي اللاعبون الأرقام المقابلة على بطاقاتهم)",
 "beanstalk": "ساق الفاصوليا (ساق نبات الفاصوليا)",
 "beany": "طاقية صغيرة (قلنسوة صغيرة؛ كان يرتديها سابقاً طلاب المدارس وطلاب السنة الأولى في الجامعات)",
 "bear": "دُبّ / دُبَّة / اِحْتَمَلَ",
 "bear cat": "باندا أحمر, باندا أصغر (حيوان لاحم شبيه بالراكون من العالم القديم لونه بني محمر؛ يُعتبر في بعض التصنيفات غير مرتبط بالباندا العملاقة)",
 "bear claw": "مخلب الدب (مخلب دب؛ يستخدم غالباً في المجوهرات) / مخلب الدب (تصميم محفور يشبه مخلب الدب؛ يستخدم في فخار الهنود الحمر) / مخلب الدب (معجنات مخمرة بالخميرة بنكهة اللوز مشكلة في نصف دائرة غير منتظمة تشبه مخلب الدب)",
 "bear cub": "دَيْسَم (ابن الدُبّ؛ قد يُطلع على جُرْو الثَعْلَب)",
 "bear false witness": "شَهِدَ زُورًا (شَهَدَ؛ شُهِدَ)\nمثال: شهد حصول الجريمة.",
 "bear grass": "عشبة الدب, عشبة الزيروفيليوم (نبات من غرب أمريكا الشمالية له جذمورات خشبية وخصل من الأوراق القاعدية الصلبة التي تشبه العشب وسنابل من الزهور البيضاء الكريمية) / عشبة الدب, نولينا (نبات عديم الساق بخصل من أوراق تشبه العشب وعنقود منتصب من الزهور البيضاء الكريمية الدقيقة؛ جنوب غرب الولايات المتحدة والمكسيك) / عشب الدب, يوكا زرقاء (يوكا من غرب وسط الولايات المتحدة لها كتلة من الأوراق القاعدية التي تشبه العشب وساق مركزي بعنقود طرفي من الزهور البيضاء الصغيرة) / عشب الدب (يوكا من جنوب الولايات المتحدة لها كتلة من الأوراق القاعدية التي تشبه العشب وساق مركزي بعنقود طرفي من الزهور البيضاء الصغيرة)",
 "bear hug": "عناق الدب (عرض استحواذ جذاب للغاية بحيث يجب على مديري الشركة المستهدفة الموافقة عليه أو المخاطرة باحتجاج المساهمين) / عناق الدب (مسكة مصارعة مع لف الذراعين بإحكام حول الخصم)",
 "bear in mind": "ذَكَرَ, حَفِظَ (ذَكَرَ الشيءَ: نطق به أو أشار إليه بالكلام؛ ذَكَرَ شخصًا: استحضره في الذاكرة)\nمثال: قتله ذكر زرافة.",
 "bear island": "جزيرة الدب",
 "bear market": "سوق هابطة (سوق يتميز بانخفاض أسعار الأوراق المالية)",
 "bear oak": "سنديان الدب (سنديان شجيري موطنه جنوب شرق الولايات المتحدة، يشكل عادةً غابات كثيفة)",
 "bear paw": "مخلب الدب (معجنات مخمرة بالخميرة بنكهة اللوز مشكلة في نصف دائرة غير منتظمة تشبه مخلب الدب)",
 "bear witness": "شَهِدَ (شَهَدَ؛ شُهِدَ)\nمثال: شهد حصول الجريمة.",
 "bear's breech": "أقنثة, أقنثة ناعمة (أقنثة جنوب أوروبية تزرع على نطاق واسع بزهور بيضاء ذات عروق أرجوانية)",
 "bear's breeches": "أقنثة, أقنثة ناعمة (أقنثة جنوب أوروبية تزرع على نطاق واسع بزهور بيضاء ذات عروق أرجوانية)",
 "bear's ear": "أذن الدب, زهرة الربيع الألبية (زهرة ربيع صفراء الزهر موطنها جبال الألب؛ تزرع بشكل شائع)",
 "bear's foot": "خربق كريه الرائحة, خربق منتن (خربق ذو أوراق كفية وله رائحة كريهة وخصائص مهيجة عند تناوله داخلياً)",
 "bear's grape": "عنب الدب, قطلب عنب الدب (شجيرة دائمة الخضرة تشكل حصيرة من أمريكا الشمالية وشمال أوراسيا لها زهور بيضاء صغيرة وتوت أحمر؛ تتحول الأوراق إلى الأحمر في الخريف)",
 "bear's-paw fern": "سرخس كف الدب (سرخس هوائي بسعف كبير؛ تايوان والفلبين)",
 "bear-sized": "بِحَجْم الدُّبّ (كبير كحجم الدبّ)",
 "bearable": "قَابِل لِلتَّحَمُّل, مُحْتَمَل (يمكن تحمله وإن كان مزعجًا)",
 "bearberry": "عنب الدب (شجيرات فرعية دائمة الخضرة بشكل أساسي في المناطق الشمالية إلى القطبية) / بهشية نفضية, توت الشتاء (شجيرة نفضية من جنوب شرق ووسط الولايات المتحدة) / نبق بورش, نبق كاسكارا (شجرة شجيرية في ساحل المحيط الهادئ للولايات المتحدة؛ تنتج الكاسكارا المقدسة)",
 "bearberry willow": "صفصاف عنب الدب (شجيرة قزمة مفترشة تشكل حصيرة في المناطق القطبية والألبية بأمريكا الشمالية وجرينلاند ذات أوراق بيضاوية خضراء داكنة تستدق نحو القاعدة)",
 "bearcat": "بنتورونغ, قط دب (زباد شجري من آسيا ذو ذيل طويل قابض وشعر أسود أشعث)",
 "beard": "لِحْيَة, ذَقْن (شعر الخدَّين والذَّقَن)\nمثال: لديه لحية صغيرة.",
 "beard lichen": "أشنة اللحية (أشنة متدلية رمادية مخضرة تنمو على الأشجار)",
 "beard moss": "أشنة اللحية (أشنة متدلية رمادية مخضرة تنمو على الأشجار)",
 "beard worm": "دودة لحوية (حيوان نحيل له مجسات وغطاء خارجي يشبه الأنبوب؛ يعيش في قاع المحيط العميق)",
 "bearded": "مُلْتَحٍ",
 "bearded darnel": "زوان سام, شيلم (عشبة سنوية ضارة توجد غالباً في حقول الحبوب والأراضي المزروعة الأخرى؛ تعتبر البذور سامة أحياناً)",
 "bearded iris": "سوسن ملتحي (أي من سوسن بري أو مزروع عديد له تراكيب تشبه الشعر على البتلات المتدلية (السيبالات))",
 "bearded seal": "فقمة ملتحية (فقمة متوسطة الحجم رمادية إلى صفراء ذات شعيرات على جانبي الخطم؛ تعيش في المحيط المتجمد الشمالي)",
 "bearded vulture": "كاسر العظام, نسر ملتحي (أكبر طائر جارح أوراسي؛ له ريش أسود يتدلى حول المنقار)",
 "bearded wheatgrass": "عشبة القمح الملتحية (عشبة قمح ذات سفا طرفي مستقيم على القنابات المزهرة)",
 "beardedness": "التحاء, وجود لحية (صفة امتلاك لحية)\nمثال: في هذا المشهد، رأس الشريك المفعول به ممدود بشكل غير مريح على الأرض - مما يضع مزيداً من التركيز على لحيته",
 "beardless": "أَمْرَد",
 "beardless iris": "سوسن أملس, سوسن غير ملتحي (أي من سوسن بري أو مزروع عديد ليس له شعر على البتلات المتدلية)",
 "bearer": "حامل, ناقل (شخص تتضمن وظيفته حمل شيء ما) / حامل (الشخص الذي بحوزته شيك أو كمبيالة أو سند أو وثيقة ملكية مظهرة له أو لمن يحملها) / حامل (رسول يحمل أو يقدم شيئاً) / حامِل النَّعْش (أحد المشيعين الذين يحملون النعش في الجنازة)\nمثال: نُقلت السندات بواسطة حامل",
 "bearer bond": "سند ذو قسيمة, سند لحامله (سند يصدر بقسائم قابلة للفصل يجب تقديمها للمصدر لمدفوعات الفائدة)",
 "bearer share": "سهم لحامله (سهم لا يحتوي على معلومات الملكية ويفترض أن حامله المادي هو المالك)\nمثال: الأسهم لحاملها محظورة في بعض البلدان بسبب احتمال إساءة استخدامها",
 "bearer stock": "سهم لحامله (سهم لا يحتوي على معلومات الملكية ويفترض أن حامله المادي هو المالك)\nمثال: الأسهم لحاملها محظورة في بعض البلدان بسبب احتمال إساءة استخدامها",
 "bearing": "رمان بلي, كرسي تحميل (دعامة دوارة توضع بين الأجزاء المتحركة للسماح لها بالحركة بسهولة) / رسم شعار النبالة, شحنة (شعار النبالة المتمثل في تصميم أو صورة مرسومة على درع) / سلوك, هيئة (أسلوب أو سلوك وقور) / قوام, هيئة (طريقة مميزة لحمل الجسم)\nمثال: وقف بوضعية جيدة",
 "bearing brass": "نحاس المحامل (جلبة نحاسية أو بطانة للمحمل)",
 "bearing false witness": "حنث باليمين, شهادة زور (الجريمة الجنائية المتمثلة في الإدلاء ببيانات كاذبة تحت القسم)",
 "bearing metal": "معدن أبيض, معدن المحامل (سبيكة (غالباً ما تكون أساسها الرصاص أو القصدير) تستخدم للمحامل)",
 "bearing rein": "عنان الكبح, لجام الرفع (لجام مصمم للحفاظ على رأس الحصان في الوضع المطلوب)",
 "bearing wall": "جدار حامل (أي جدار يدعم أرضية أو سقف مبنى)",
 "bearish": "هُبُوطِيّ (يتوقع انخفاضاً في الأسعار)",
 "bearleader": "جُعَيْدِيّ",
 "bearnaise": "بيرنيز (صلصة تشبه الهولنديز ولكن مصنوعة بالنبيذ الأبيض والطرخون والكراث بدلاً من عصير الليمون)",
 "bearskin": "شاكو, قبعة فرو الدب (قبعة طويلة؛ يرتديها بعض الجنود البريطانيين في المناسبات الاحتفالية) / فراء الدب (فرو الدب)",
 "bearwood": "نبق بورش, نبق كاسكارا (شجرة شجيرية في ساحل المحيط الهادئ للولايات المتحدة؛ تنتج الكاسكارا المقدسة)",
 "beast": "مُتَوَحِّش",
 "beast of burden": "بَهِيمَة, دَابَّة",
 "beast of prey": "سَبْع (اِسْمٌ وَصِفَةٌ لِلْأَسَد)\nمثال: عمره سبع سنوات.",
 "beastliness": "رَدَاءَة, سُوء شَدِيد (سوء أو قذارة منفرة؛ وتستخدم خاصة لوصف الطقس السيء) / خسة, دناءة (صفة التعمد في الدناءة وسوء المعاملة)",
 "beastly": "بِوَحْشِيَّة (بطريقة وحشية) / بَهِيمِيّ, حَيَوَانِيّ (يُشبه الوحش؛ يُظهر انعدام الحِسّ الإنساني) / بَشِع, فَظِيع ((غير رسمي) غير سارّ للغاية)\nمثال: تصرفت بوحشية تجاه حماتها",
 "beat": "نَبْض / ضَرَبَ, دَقَّ (معروف، وهو اللطم أو الدق أو الصكّ و ما أشبه؛ النَوْع أو الصنف أو المثال) / وَجَفَ / هَزَمَ, غَلَبَ / خَفَقَ (الجذر يعبر عن الحركة والاضطراب الخفيف الذي ينشأ عن الرياح أو القلوب أو الرايات، ويستخدم لوصف الطبيعة والأحاسيس والجوانب الحسية المختلفة؛ عبّر عن حركة سريعة، سواء كانت اضطراباً أو ضرباً خفيفاً أو صوتاً، بالإضافة إلى صفةٍ تُوصف بها الخيل)\nمثال: ضرب سامي زوجته.",
 "beat around the bush": "لَفَّ وَدَارَ",
 "beat generation": "البيتنيكس, جيل البيت (ثقافة فرعية شبابية أمريكية في الخمسينيات؛ رفضت الممتلكات أو العمل المنتظم أو الملابس التقليدية؛ كانت مع العيش المشترك والمخدرات المخدرة واللاسلطوية؛…)",
 "beat music": "بيت ميوزيك, موسيقى البيت (نوع من موسيقى البوب والروك تطور في المملكة المتحدة في أوائل الستينيات)",
 "beat-up": "مُحَطَّم, مُهَشَّم (متضرر من الضربات أو الاستعمال القاسي)",
 "beatable": "قَابِلٌ لِلهَزِيمَةِ, مَغْلُوب (عُرْضَةٌ لِلهَزِيمَةِ أَوِ الغَلَبَةِ)",
 "beaten": "مصفح, مطروق (مشكل أو مرقق بالطرق)\nمثال: ذهب مطروق",
 "beaten-up": "مُحَطَّم, مُهَشَّم (متضرر من الضربات أو الاستعمال القاسي)",
 "beater": "مِخْفَقة, مِضْرَب (أداة للخفق أو الضرب) / مطارد الصيد (عامل يثير الطرائد البرية من مخبئها للصياد)",
 "beatific": "قِدِّيسِيّ, مَلَائِكِيّ (يتسم بالطيبة المطلقة؛ يشبه أو يليق بملاك أو قديس) / سَمَاوِيّ الغِبْطَة, نَعِيمِيّ (يختبر أو يمنح بهجة سماوية عُلوية)",
 "beatification": "تطويب ((الكنيسة الكاثوليكية) فعل للبابا يعلن فيه أن شخصًا متوفى عاش حياة مقدسة ويستحق التبجيل العام؛ خطوة أولى نحو إعلان القداسة) / تطويب (فعل جعل الشخص مباركاً وسعيداً للغاية) / سعادة قصوى, طوبى (حالة من السعادة العارمة)",
 "beatified": "مُبَارَك, مُطَوَّب ((في الكاثوليكيّة) أُعلِن من المطوَّبين ومستحقًّا للتبجيل)",
 "beating": "ضَرْب (معروف، وهو اللطم أو الدق أو الصكّ و ما أشبه؛ النَوْع أو الصنف أو المثال)\nمثال: ضرب سامي زوجته.",
 "beating-reed instrument": "آلة ذات ريشة, آلة قصبية (آلة موسيقية تصدر صوتاً عن طريق قصبة مهتزة)",
 "beatitude": "تطويبة / سعادة قصوى, طوبى (حالة من السعادة العارمة)\nمثال: التطويبة المفضلة لديها هي 'طوبى للودعاء لأنهم يرثون الأرض'",
 "beatles": "بِيتْلْز, بِيتِيلْز",
 "beatnik": "بيتنك, خنفس (عضو في جيل البيت؛ شخص غير تقليدي في الملبس والسلوك)",
 "beatniks": "البيتنيكس, جيل البيت (ثقافة فرعية شبابية أمريكية في الخمسينيات؛ رفضت الممتلكات أو العمل المنتظم أو الملابس التقليدية؛ كانت مع العيش المشترك والمخدرات المخدرة واللاسلطوية؛…)",
 "beats": "البيتنيكس, جيل البيت (ثقافة فرعية شبابية أمريكية في الخمسينيات؛ رفضت الممتلكات أو العمل المنتظم أو الملابس التقليدية؛ كانت مع العيش المشترك والمخدرات المخدرة واللاسلطوية؛…)",
 "beats per minute": "نَبْضَة فِي الدَّقِيقَة (إيقاع الموسيقى مقاساً بعدد الضربات التي تحدث في 60 ثانية)",
 "beau": "حبيب, صديق حميم (رجل هو عشيق لرجل أو امرأة) / متأنق (رجل يهتم كثيراً بملابسه ومظهره)\nمثال: لو علمت أنه حبيبها لما سألت",
 "beau geste": "لفتة نبيلة (لفتة كريمة (ولكن عادة ما تكون بلا معنى حقيقي))",
 "beau ideal": "قدوة, كمال (حالة مثالية؛ تجسيد مثالي لمفهوم ما)",
 "beau monde": "الطبقة الراقية, المجتمع الراقي (النخبة العصرية الأنيقة)",
 "beaufort scale": "مقياس بوفورت",
 "beaugregory": "سمكة بيوغريغوري, نوع من الأسماك القعيسية (سمكة قعيسية زرقاء وصفراء اللون تعيش في برمودا وفلوريدا وجزر الهند الغربية)",
 "beaujolais": "بوجوليه (نبيذ أحمر خفيف وفاكهي جاف يُشرب في غضون بضعة أشهر بعد صنعه؛ من منطقة بوجوليه في جنوب شرق فرنسا)",
 "beaumontia grandiflora": "زهرة بوق نيبال, كرمة زنبق الفصح (نبات متسلق خشبي دائم الخضرة ذو أوراق لامعة كبيرة ونورات خيمية مبهرجة من الأزهار البيضاء العطرة البوقية الشكل)",
 "beaut": "روعة, شيء بديع (مثال رائع من نوعه)\nمثال: كانت وروده بديعة",
 "beauteous": "بَهِيّ, وَضِيء ((شعري) جميل، خاصة للنظر)",
 "beauteousness": "حسن, ملاحة (صفة كون الشخص حسن المظهر وجذاباً)",
 "beautician": "أخصائي تجميل, خبير تجميل (شخص يعمل في صالون تجميل)",
 "beautification": "تَجْمِيل",
 "beautiful": "جَمِيل (حَسَن) / مَلِيح\nمثال: طقس اليوم جميل.",
 "beautifully": "بِجَاذِبِيَّة, بِشَكْل جَمِيل (بطريقة جميلة)\nمثال: كان وجهها مزيناً بشكل جميل",
 "beautifulness": "جَمَال",
 "beautify": "جَمَّلَ (حَسُنَ)\nمثال: يا لها من جملة!",
 "beauty": "جَمَال, زَيْن / حَسْنَاء, جَمِيلَة",
 "beauty bush": "شجيرة الجمال, كولكويتزيا (شجيرة نفضية صينية ذات زهور وردية بقلب أصفر وثمار شائكة؛ تزرع غالباً للزينة)",
 "beauty consultant": "خبيرة تجميل, مستشارة تجميل (شخص يقدم نصائح حول المظهر الشخصي)",
