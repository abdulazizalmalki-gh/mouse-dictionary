 "association of orangemen": "جماعة الأورانج, نظام أورانج (منظمة سياسية بروتستانتية في أيرلندا الشمالية)",
 "association of southeast asian nations": "آسيان, رابطة دول جنوب شرق آسيا (رابطة دول مكرسة للتعاون الاقتصادي والسياسي في جنوب شرق آسيا وانضمت إلى الولايات المتحدة للقتال ضد الإرهاب العالمي)",
 "association theory": "ارتباطية ((علم النفس) نظرية تفيد بأن الارتباط هو المبدأ الأساسي للنشاط العقلي)",
 "associational": "ارتباطي, تداعي (من أو متعلق بالجمعيات أو المذهب الترابطي)",
 "associationism": "ارتباطية ((علم النفس) نظرية تفيد بأن الارتباط هو المبدأ الأساسي للنشاط العقلي)",
 "associative": "تَرَابُطِيّ (يتميز بـ أو يسبب أو ينتج عن عملية الجمع بين الأفكار أو الأحداث في الذاكرة أو الخيال)\nمثال: تعلم ترابطي",
 "associative aphasia": "حبسة ترابطية, حبسة توصيلية (حبسة يُفترض أن الآفة فيها تقع في مسارات الترابط التي تصل بين مراكز اللغة المختلفة في الدماغ؛ يجد المريض صعوبة في تكرار جملة سمعها للتو)",
 "associative array": "قَامُوس (اَلْبَحْر ٱلْعَظِيم، البحْرُ ٱلْكَبِير، ٱلْمُحِيط؛ قَعْر البَحْرِ أو أَعْمَق نقطَة فيه)\nمثال: أي قاموس تعنيه؟",
 "associatory": "تَرَابُطِيّ (يتميز بـ أو يسبب أو ينتج عن عملية الجمع بين الأفكار أو الأحداث في الذاكرة أو الخيال)\nمثال: تعلم ترابطي",
 "assonance": "سجع, قافية حروف العلة (تكرار حروف العلة المتشابهة في المقاطع المشددة للكلمات المتتالية)",
 "assonant": "مُتَوَافِقُ الصَّوَائِتِ (فيه صوت علة واحد يتكرر مع حروف ساكنة مختلفة في كلمات أو مقاطع متتالية) / مُتَجَانِسُ الصَّوْت (ذو أصوات متشابهة خاصّة في حروف العلّة تتكرّر في مقاطع متتالية)",
 "assortative mating": "تزاوج انتقائي, تزاوج متوافق (تزاوج أفراد لديهم صفات مشتركة أكثر مما هو محتمل في التزاوج العشوائي)",
 "assorted": "مُتَنَوِّع, مُخْتَلِط (يتألَّف من تشكيلة عشوائيَّة من أنواع مختلفة) / مُتَبَايِن, مُتَنَوِّع (من أنواع مختلفة عديدة مُرتَّبة عمدًا لكنّها تفتقر إلى التجانس)",
 "assortment": "تبويب, تصنيف (فعل توزيع الأشياء في فئات أو أصناف من نفس النوع) / تشكيلة, خليط (مجموعة تحتوي على تشكيلة متنوعة من أنواع الأشياء)\nمثال: كانت هناك تشكيلة كبيرة من السيارات معروضة",
 "assuagement": "ارتياح, فرج (الشعور الذي يأتي عند إزالة أو تخفيف شيء مرهق)\nمثال: عندما سمع الأخبار غمره فجأة شعور بالارتياح",
 "assuasive": "مُسَكِّن, مُهَدِّئ (يحرر من الخوف والقلق)",
 "assume": "اِفْتَرَضَ",
 "assumed": "زَائِف, مُتَظَاهَر بِه (مُتَّخَذ بغرض الخداع والتضليل)",
 "assumed name": "اسم تجاري مستعار ((قانون) اسم تمارس به شركة أعمالها وليس الاسم القانوني للشركة كما هو مبين في وثائق تأسيسها) / اسم مستعار (اسم تم انتحاله)",
 "assuming": "مُتَطَاوِل, مُفْتَرِض (مفرط في الجرأة والتطاول؛ يتجاوز حدوده)",
 "assumption": "افتراض, تولي (فعل حيازة أو تولي السلطة على شيء ما) / افتراض (فعل الافتراض أو التسليم بجدلية أمر ما) / افتئات, تطاول (سلوك جريء (حتى متعجرف) ليس من حقك) / افتراض (فرضية تؤخذ كأمر مسلم به)\nمثال: تزامنت توليه المنصب مع الاضطرابات في كوبا",
 "assumption of mary": "15 أغسطس, عيد الانتقال (احتفال في الكنيسة الكاثوليكية بانتقال السيدة العذراء مريم إلى السماء عند انتهاء حياتها الأرضية؛ يقابله عيد الرقاد في الكنيسة الأرثوذكسية الشرقية)",
 "assumptive": "افْتِرَاضِيّ, مُسَلَّم بِه (مقبول على أنّه حقيقيّ دون دليل) / مُتَطَاوِل, مُفْتَرِض (مفرط في الجرأة والتطاول؛ يتجاوز حدوده)",
 "assurance": "ثقة, ثقة بالنفس (الخلو من الشك؛ الإيمان بالنفس وبالقدرات) / تأكيد, طمأنة (بيان يهدف إلى إلهام الثقة) / تَعَهُّد, ضَمَان (التزام ملزم بالقيام بشيء أو إعطائه أو الامتناع عنه) / تأمين (بريطاني) (مصطلح بريطاني لبعض أنواع التأمين)\nمثال: ثقته بتفوقه لم تجعله محبوباً",
 "assure": "أَكَّدَ (أكَّد الخبرَ ونحوه :صرّح بصحَّته؛ أَكَدَّ : قَرَّرَ، أَثْبَتَ، وثَّقَ)\nمثال: أكد صمته شكوكها",
 "assured": "مُطْمَئِنّ, وَاثِق (يتّسم بالثقة ويُظهر اطمئنانًا) / مَضْمُون, مُؤَكَّد (يتسم باليقين أو الأمان)",
 "assuredly": "بِالتَّأْكِيد, بِلَا شَكّ\nمثال: المدارس النحوية لم تكن بالتأكيد مخصصة للطبقة الراقية وحدها",
 "assuredness": "ثبات, ثقة بالنفس (برود أعصاب وهدوء كبير تحت الضغط)\nمثال: حافظ على هدوئك",
 "assurgent": "نَامٍ لِلْأَعْلَى (يَنْمُو أَوْ يَمْتَدُّ نَحْوَ الأَعْلَى) / طَالِعٌ مِنَ البَحْر (يَرْتَفِعُ مِنَ البَحْر)",
 "assuring": "بَاعِث عَلَى الثِّقَة, مُؤَكِّد (يمنح الثقة والاطمئنان)",
 "assyria": "آشُّور",
 "assyrian": "آشُورِيّ",
 "assyrian akkadian": "الآشورية, الآشورية الأكدية (لغة منقرضة للآشوريين في بلاد ما بين النهرين القديمة)",
 "assyrian akkadian language": "الآشورية, الآشورية الأكدية (لغة منقرضة للآشوريين في بلاد ما بين النهرين القديمة)",
 "assyrian language": "الآشورية, الآشورية الأكدية (لغة منقرضة للآشوريين في بلاد ما بين النهرين القديمة)",
 "assyrian neo-aramaic": "الآشورية الحديثة (لغة العراق الحديث)",
 "assyrian neo-aramaic language": "الآشورية الحديثة (لغة العراق الحديث)",
 "assyriology": "علم الآشوريات (آثار الآشوريين القدماء)",
 "astaghfirullah": "أَسْتَغْفِرُ اللهَ",
 "astana": "أَسْتَانَا",
 "astarte": "عِشْتَار, عَشْتَارُوت",
 "astasia": "عدم القدرة على الوقوف (عدم القدرة على الوقوف بسبب عدم التناسق العضلي)",
 "astatic": "غَيْر مُسْتَقِرّ, لَا سُكُونِيّ (ليس ساكنًا أو مستقرًّا)",
 "astatic coils": "ملفات لا ساكنة (ترتيب لملفات يُستخدم في الأدوات الكهربائية الحساسة؛ تُرتب الملفات لتعطي محصلة صفرية للمجال المغناطيسي الخارجي عند مرور تيار خلالها ولتكون القوة…)",
 "astatic galvanometer": "جلفانومتر استاتيكي (يحتوي على مغناطيس متحرك وملفات استاتيكية مرتبة لإلغاء تأثير المجال المغناطيسي للأرض)",
 "astatine": "أَسْتَاتِين",
 "astaxanthin": "أَسْتَازَانْتِين, أَسْتَاكْسَانْثِين",
 "aster": "النَّجْم, قَسِيم نَجْمِيّ (بنية نجمية الشكل تتشكل في سيتوبلازم الخلية لها ألياف تشبه الأشعة تحيط بالجسيم المركزي أثناء الانقسام المتساوي) / أستر, نجمة (أي من أعشاب مختلفة تزهر غالباً في الخريف من جنس أستر ذات زهور مبهرجة تشبه الأقحوان)",
 "aster acuminatus": "أستر حلزوني, أستر مدبب (نبات معمر في أمريكا الشمالية بأوراق تبدو حلزونية وزهور بيضاء مبهرجة مشوبة بالأرجواني)",
 "aster arenosus": "أستر الخلنج (نبات معمر شائع في أمريكا الشمالية بأوراق تشبه الخلنج ورؤوس زهور بيضاء صغيرة)",
 "aster cordifolius": "أستر قلبي الأوراق (أستر غابات معمر من شرق أمريكا الشمالية)",
 "aster divaricatus": "أستر الغابة الأبيض (أستر غابات معمر جذموري من شرق أمريكا الشمالية بزهور بيضاء)",
 "aster dumosus": "أستر شجيري (نبات معمر صلب في شرق الولايات المتحدة ذو أوراق خطية صغيرة ورؤوس زهور بيضاء صغيرة عديدة)",
 "aster ericoides": "أستر الخلنج (نبات معمر شائع كثير التفرع في أمريكا الشمالية بأوراق تشبه الخلنج وزهور بيضاء صغيرة تشبه النجوم)",
 "aster falcatus": "أستر البراري الأبيض (نبات معمر في غرب أمريكا الشمالية ذو زهور بيضاء)",
 "aster linarifolius": "أستر صلب, أستر كتاني الأوراق (نبات معمر معنقد سلكي في شرق الولايات المتحدة بسيقان خشنة منتصبة صلبة وأوراق خطية وزهور بنفسجية كبيرة)",
 "aster linosyris": "أستر ذهبي, جولديلوكس (نبات معمر مبكر الإزهار في جنوب وجنوب شرق أوروبا برؤوس زهور تشبه تلك الموجودة في عصا الذهب)",
 "aster macrophyllus": "أستر كبير الأوراق (أستر غابات معمر ذو خصلات من أمريكا الشمالية؛ متوطن في أوروبا)",
 "aster novae-angliae": "أستر نيو إنجلاند (نبات معمر شائع في شرق أمريكا الشمالية ذو زهور أرجوانية مبهرجة؛ أحد أصول زهرة ميخائيل)",
 "aster novi-belgii": "أستر نيويورك, زهرة ميخائيل (عشبة معمرة في أمريكا الشمالية ذات زهور أرجوانية أو وردية أو بيضاء صغيرة تزهر في الخريف؛ متوطنة على نطاق واسع في أوروبا)",
 "aster ptarmicoides": "أستر المرتفعات الأبيض (نبات معمر صلب معنقد في أمريكا الشمالية بعناقيد فضفاضة من الزهور البيضاء)",
 "aster shortii": "أستر شورت (نبات معمر في جنوب شرق الولايات المتحدة ذو زهور زرقاء عادة)",
 "aster tripolium": "أستر البحر, نجمة البحر (أستر أوروبي شائع ينمو في المستنقعات المالحة)",
 "aster turbinellis": "أستر البراري (أستر معمر بنفسجي الزهور في وسط الولايات المتحدة ذو رؤوس وحيدة)",
 "astereognosis": "عدم تعرف باللمس, عمه لمسي (فقدان القدرة على التعرف على الأشياء عن طريق لمسها)",
 "asteriated": "نجمي ((لبعض البلورات وخاصة الأحجار الكريمة) تظهر تشكيلات نجمية)",
 "asterid dicot family": "فصيلة النجميات (فصيلة من الأعشاب ثنائية الفلقة المتطورة نوعاً ما وبعض الأشجار والشجيرات)",
 "asterid dicot genus": "جنس من النجميات (جنس من الأعشاب ثنائية الفلقة المتطورة إلى حد ما وبعض الأشجار والشجيرات)",
 "asterion": "نُجَيْمَى, كُوَيْكَبَة",
 "asterisk": "إِجَّامَة, نُجَيْمَة",
 "asterisked": "مُعَلَّمٌ بِنَجْمَة, مُنَجَّم (مُعلَّم بعلامة النجمة)",
 "asterism": "صُورَة نَجْمِيَّة, صُورَة سَمَاوِيَّة / نَجْمِيَّة",
 "asterismal": "كوكبي (يتعلق بالمجموعات النجمية أو الأبراج)",
 "astern": "خَلْفًا ((لسفينة أو طائرة) في الخلف) / فِي المُؤَخِّرَة (عند أو بالقرب من أو باتجاه مؤخرة سفينة أو ذيل طائرة) / إِلَى الخَلْف (المؤخرة أولاً أو للخلف)\nمثال: أسقطناها خلفنا على نهاية حبل مانيلا، واستلقت بشكل مريح على الجزر",
 "astern of": "خَلْف (بَدَلَ، أَعْقَبَ؛ أَتَى بعده أو جاء مكانه)\nمثال: دار زيري للخلف.",
 "asternal": "غَيْرُ مُتَّصِلٍ بِالقَصِّ (غَيْرُ مُرْتَبِطٍ بِعَظْمِ القَصِّ أَوِ الصَّدْرِ)",
 "asteroid": "كُوَيْكِب",
 "asteroid belt": "حِزَام كُوَيْكِبَات (خيط أو قطعة من جلد تستخدم لحَزْم النَبَات أو العِيدَان أو غيرها لتكوين حُزْمَة؛ النِطَاق، قطعة من الجِلْد الطَوِيل يلف حول الخَصْر إما ليمسك المَلابِس أو ليظهر الخصر)\nمثال: هذا حزام من الجلد.",
 "asteroidal": "كويكبي (من أو يتعلق بالكويكب أو يشبهه)",
 "asterope": "ستيروبي ((الأساطير اليونانية) واحدة من البلياديس السبعة)",
 "asthenia": "ضَعْف",
 "asthenic": "نَحِيل, وَهَنِيّ (ذو بنية جسمية نحيلة) / خَائِر القُوَى, مُنْهَك (يفتقر إلى الطاقة أو الحيوية)",
 "asthenic type": "بنية واهنة, نحافة البنية (نحيف وضعيف وخفيف الوزن)",
 "asthenopia": "إجهاد العين, وهن البصر (تعب في العين ناتج عن العمل القريب لفترات طويلة من قبل شخص يعاني من مشكلة بصرية غير مصححة)",
 "asthenosphere": "أثينوسفير, غلاف موري (الطبقة السفلى من القشرة الأرضية (أو الوشاح العلوي))",
 "astheny": "وهن (فقدان غير طبيعي للقوة)",
 "asthma": "رَبُو",
 "asthma attack": "ربو (اضطراب تنفسي يتميز بصفير؛ عادة من أصل تحسسي)",
 "asthmatic": "مُتَعَلِق بِدَاء اَلرَّبْو / مُصَاب بِدَاء اَلرَّبُو",
 "astigmatic": "لَابُؤَارِيّ, لَانُقَطِيّ",
 "astigmatism": "لَابُؤْرِيّة, اللَانُقَطِيَّة",
 "astigmia": "استجماتيزم, لابؤرية ((بصريات) عيب في نظام بصري تفشل فيه أشعة الضوء من نقطة واحدة في التجمع في نقطة بؤرية واحدة) / انحراف النظر, لابؤرية ((طب العيون) ضعف البصر الناتج عادة عن عدم انتظام شكل القرنية؛ شائع لدى الأشخاص الذين يعانون من قصر النظر)",
 "astilbe": "أستيلب",
 "astilbe biternata": "أستيلب كاذب (أستيلب من أمريكا الشمالية بعناقيد من الزهور البيضاء الكريمية)",
 "astilbe chinensis pumila": "أستيلب قزم (نبات آسيوي دائم الخضرة يشكل حصيرة بأوراق مقطوعة بدقة وزهور وردية صغيرة إلى بورجوندي؛ يزرع كغطاء أرضي)",
 "astilbe japonica": "أستيلب ياباني",
 "astomatal": "لا ثغري (يفتقر إلى الثغر أو الثغور)",
 "astomatous": "لا فموي (ليس له فم أو فتحة تشبه الفم)",
 "astonied": "مَذْهُول, مُنْدَهِش (مملوء بالتأثر العاطفي الناجم عن مفاجأة أو صدمة شديدة)",
 "astonish": "أَذْهَلَ (أَذْهَلَ (أذهله) عنه: جعله يذهل عنه)",
 "astonished": "مَذْهُول",
 "astonishing": "مُذْهِل",
 "astonishingly": "بشكل مذهل, للمفاجأة (بطريقة مذهلة؛ لمفاجأة الجميع)\nمثال: بشكل مذهل، أنهى كلية الطب في ثلاث سنوات",
 "astonishment": "ذُهُول, دَهْشَة",
 "astorga": "أَسْتُرْقَة",
 "astound": "ذُهِل (أصابه الذهول، أي اندهش وانشغل عقله عن إدراك ما حوله؛ غفل عن شيء بسبب انشغال ذهنه)",
 "astounded": "مَذْهُول",
 "astounding": "مُذْهِل",
 "astraddle": "مُنْفَرِج اَلسَّاقَيْن",
 "astragal": "حافة خرزية (إطار مزخرف بالخرز لحاشية أو تزيين الأثاث) / عظم الكاحل, قعب (العظم الموجود في الكاحل الذي يتمفصل مع عظام الساق لتكوين مفصل الكاحل)",
 "astragalar": "كاحلي (من أو متعلق بعظم الكاحل)",
 "astragalus": "عظم الكاحل, قعب (العظم الموجود في الكاحل الذي يتمفصل مع عظام الساق لتكوين مفصل الكاحل)",
 "astragalus alpinus": "قتاد ألبي (نبات معمر في المناطق الجبلية في أوراسيا وأمريكا الشمالية)",
 "astragalus danicus": "قتاد أرجواني (نبات معمر من جنوب وغرب أوروبا ذو عناقيد كثيفة من الزهور الأرجوانية أو البنفسجية)",
 "astragalus glycyphyllos": "عرقسوس بري (نبات أوروبي معمر)",
 "astrakhan": "زَرْدَخَان",
 "astral": "نَجْمِيّ, نَجْمِيَّة",
 "astrantia": "أسترانتيا, عشبة المعلم",
 "astrantia major": "أسترانتيا كبرى (عشب أوروبي بجذور عطرية وأوراق في خصلة قاعدية وخيمات مركبة بارزة من الزهور البيضاء إلى الوردية)",
 "astraphobia": "رهاب البرق والرعد, رهاب العواصف (خوف مرضي من الرعد والبرق)",
 "astray": "بِضَلَال, عَلَى ضَلَال",
 "astreus hygrometricus": "أستريوس هيجرومتريكوس (نوع شائع من نجمة الأرض واسع الانتشار في التربة الرملية؛ الغليبا سمراء شاحبة)",
 "astreus pteridis": "أستريوس تيريديس (أكبر نجمة أرض؛ يمكن أن يبلغ عرض الجسم الثمري 15 سم عندما تتوسع الأشعة)",
 "astride": "مُنْفَرِج اَلسَّاقَيْن",
 "astringence": "عفوصة, قابضية (طعم قابض حاد؛ تجربة التذوق عندما تسبب مادة ما انكماشاً في الفم)",
 "astringency": "تأثير قابض, قبض (القدرة على قبض أو تجميع أنسجة الجسم الرخوة لوقف تدفق الدم أو تقييد إفراز السوائل) / عفوصة, قابضية (طعم قابض حاد؛ تجربة التذوق عندما تسبب مادة ما انكماشاً في الفم)",
 "astringent": "مُقَلِص",
 "astringent drug": "دواء قابض, مادة قابضة (دواء يسبب انكماش أنسجة وقنوات الجسم)",
 "astrobiology": "بيولوجيا الفضاء, علم الأحياء الفلكي (فرع علم الأحياء المعني بتأثيرات الفضاء الخارجي على الكائنات الحية والبحث عن حياة خارج كوكب الأرض)",
 "astrocentric": "نَجْمِيّ الْمَرْكَز",
 "astrocyte": "خلية نجمية (خلية دبقية عصبية كبيرة نسبياً)",
 "astrocytic": "نجمي خلوي (من أو متعلق بـ أو يحتوي على خلايا كبيرة نجمية الشكل في الغراء العصبي)",
 "astrodome": "قبة فلكية, قبة ملاحية (قبة شفافة أعلى الطائرة حيث يمكن للملاح إجراء عمليات الرصد السماوية)",
 "astrodynamics": "ديناميكا فلكية (فرع علم الفلك الذي يدرس حركة الأجرام الطبيعية والاصطناعية في الفضاء)",
 "astrogator": "ملاح فضاء (ملاح مركبة فضائية)",
 "astroglia": "خلايا دبقية نجمية (نسيج يتكون من خلايا عصبية دبقية نجمية كبيرة)",
 "astrolabe": "أَسْطْرُلَاب (آلة يقيس بها الفلكيون ارتفاع الكواكب)",
 "astrolatry": "تنجيم, عبادة الكواكب (عبادة الكواكب أو النجوم)",
 "astrologer": "مُنَجِّم, مُنَجِّمَة",
 "astrological": "فَلَكِيّ",
 "astrologist": "منجم (شخص يتنبأ بالمستقبل من خلال مواقع الكواكب والشمس والقمر)",
 "astrology": "تَنْجِيم",
 "astroloma humifusum": "توت الأرض, توت بري أصلي (شجيرة صغيرة منبطحة أو صاعدة ذات أزهار قرمزية وثمار عصارية تشبه التوت البري)",
 "astrometry": "قِيَاسُ الْفَلَك, عِلْمُ الْقِيَاسَاتِ الْفَلَكِيَّة",
 "astronaut": "رَجُل فَضَاء (العُضْو في جسد الإنسان يتكون من القَدَم والسَاق والفُخْذ. الجمع أرجُل، وقد تقول العامّة رِجْلين ورجْلينات؛ القَدَم من باب اطلاق اسم الكل على الجزء) / رَائِد فَضَاء / مَلَّاح فَضَائِيّ\nمثال: هذا الرجل تاجر.",
 "astronautic": "ريادي فضائي, ملاحي فضائي (من أو ينتمي إلى رواد الفضاء أو علم الملاحة الفضائية)",
 "astronautical": "ريادي فضائي, ملاحي فضائي (من أو ينتمي إلى رواد الفضاء أو علم الملاحة الفضائية)",
 "astronautics": "مِلَاحَة فَضَائِيَّة / مِلَاحَة الْفَضَاء",
 "astronavigation": "ملاحة فلكية (الملاحة وفقًا لمواقع النجوم)",
 "astronium fraxinifolium": "أسترونيوم, جونكالو ألفيس (شجرة خشبية أمريكية استوائية طويلة وفيرة بشكل خاص في شرق البرازيل؛ تنتج خشب الحمار الوحشي الصلب القوي المتين ذو الحبيبات المستقيمة والشرائط الداكنة…)",
 "astronomer": "عَالِم فَلَك, فَلَكِي (الذي يعلم؛ متخصص في عِلْم ما وباحث فيه)\nمثال: هو عالم أحيائي.",
 "astronomic": "فَلَكِيّ, هَائِل (كبير بشكل لا يُتصوَّر) / فلكي (يتعلق أو ينتمي إلى علم الفلك)\nمثال: تلسكوب فلكي",
 "astronomical": "فَلَكِيّ",
 "astronomical telescope": "تلسكوب فلكي, مقرب فلكي (أي تلسكوب مصمم لجمع وتسجيل الإشعاع الكهرومغناطيسي من المصادر الكونية)",
 "astronomical unit": "وَحْدَة فَلَكِيَّة",
 "astronomical year": "سنة شمسية, سنة فلكية (الوقت اللازم للأرض لعمل دورة واحدة حول الشمس، مقاسة بين اعتدالين ربيعيين)",
 "astronomically": "فَلَكِيًّا",
 "astronomy": "فَلَك, عِلْم الْفَلَك (التَلّ المستدير من الرَمْل حوله فَضَاء؛ المَدَار يسبح فيه الجُرْم السماويّ)\nمثال: أصبح زيري عالم فلك.",
 "astronomy satellite": "قمر صناعي فلكي (قمر صناعي مجهز بتلسكوب لرصد الأشعة تحت الحمراء)",
 "astronomy unit": "وحدة فلكية (وحدة خطية تستخدم للمسافات الفلكية)",
 "astrophysical": "فيزيائي فلكي (متعلق بالفيزياء الفلكية)\nمثال: علوم الفيزياء الفلكية",
 "astrophysicist": "عَالِم فِيزِيَاء فَلَكِيَّة (الذي يعلم؛ متخصص في عِلْم ما وباحث فيه)\nمثال: هو عالم أحيائي.",
 "astrophysics": "فِزِيَاء الفَلَكِيَّة",
 "astrophyton muricatum": "نجم السلة العملاق (نوع من نجم السلة)",
 "astropogon stellatus": "سمكة المحار (توجد في جزر الهند الغربية؛ تعيش في تجويف عباءة محار حي)",
 "asturias": "أَشْتُورِيَة, أَشْتُورِيش",
 "astute": "دَاهٍ, الدَّاهِي (اِسْمٌ وَصِفَةٌ لِلْأَسَد)\nمثال: يقول والداه أنه لا يأكل لحم الخنزير.",
 "astutely": "بِدَهَاء",
 "astuteness": "دَهَاء (الدهاء: مصدر، الرأي والتبصر؛ الدهاء: مصدر، المكر والحيلة)",
 "astylar": "خَالٍ مِن الأَعْمِدَة (يفتقر إلى الأعمدة أو الدعائم)",
 "asunción": "أَسُونْسِيُون, أَسُنِسُون",
 "asunder": "إِرْباً",
 "asvina": "أشفين (الشهر السابع من التقويم الهندوسي)",
 "asvins": "أشفين ((حرفياً 'مالكو الخيول' بالسنسكريتية) في الهندوسية المحاربان التوأمان اللذان يقودان عربة سوريا)",
 "asylee": "لاجئ",
 "asylum": "مَلْجَأ, مَوْئِل / لُجُوء",
 "asylum seeker": "طَالِب لُجُوء, طَالِبَة لُجُوء",
 "asymmetric": "غير متماثل, غير متناظر (يتميز بعدم التماثل في الترتيب المكاني أو وضع الأجزاء أو المكونات)",
 "asymmetrical": "غَيْر مُتَمَاثِل, غَيْر مُتَمَاثِلَة (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "asymmetrically": "بشكل غير متناظر (بطريقة غير متناظرة)\nمثال: كانت مرتبة بشكل غير متناظر",
 "asymmetry": "عَدَم تَنَاسُق (الفقدان ونقيض الوجود؛ يجب عدم فعل كذا: أي يجب الامتناع عن الفعل)\nمثال: عليك عدم الخوف.",
 "asymptomatic": "بِدُون أَعْرَاض, بِلَا أَعْرَاض",
 "asymptote": "خط مقارب (خط مستقيم يقترب منه المنحنى بلا حدود دون أن يمسه)\nمثال: الخط المقارب للمنحنى",
 "asymptotic": "مُقَارِب",
 "asymptotically": "مُتَقَارِباً, مُقَارِبًا",
 "asynchronism": "عَدَم التَّزَامُن, لَا تَزَامُن (العلاقة التي توجد عندما تحدث الأشياء في أوقات غير مرتبطة)\nمثال: أنتج التحفيز عدم تزامن لموجات الدماغ",
 "asynchronous": "لَا مُتَزَامِن, لَا مُتَزَامِنَة (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: لا أحب المدرسة.",
 "asynchronous motor": "محرك تحريضي, محرك حثي (محرك كهربائي يعمل بالتيار المتردد يتم فيه الحصول على التيار الكهربائي في الجزء الدوار اللازم لإنتاج عزم الدوران عن طريق الحث الكهرومغناطيسي من المجال…)",
 "asynchronous nasalization": "غنة غير متزامنة (غنة تتكون من حرف علة فموي يتبعه شبه حرف علة أنفي)",
 "asynchronous operation": "عملية غير متزامنة (عمليات تحدث دون علاقة زمنية منتظمة أو متوقعة بأحداث أخرى)",
 "asynchronous transfer mode": "وضع النقل غير المتزامن (وسيلة للاتصالات الرقمية قادرة على سرعات عالية جداً؛ مناسبة لنقل الصور أو الصوت أو الفيديو وكذلك البيانات)\nمثال: يستخدم وضع النقل غير المتزامن لكل من الشبكات المحلية والشبكات الواسعة",
 "asynchrony": "عَدَم التَّزَامُن, لَا تَزَامُن (العلاقة التي توجد عندما تحدث الأشياء في أوقات غير مرتبطة)\nمثال: أنتج التحفيز عدم تزامن لموجات الدماغ",
 "asynclitism": "تلازم غير متزامن, ميلان رأس الجنين (ظهور رأس الجنين أثناء المخاض بزاوية غير طبيعية)",
 "asyndetic": "غير موصول, مفكك (يفتقر إلى أدوات العطف)",
 "asyndeton": "حذف حروف العطف (حذف حروف العطف حيث يتم استخدامها عادة)",
 "asynergia": "عدم التآزر, لاتآزر (غياب التنسيق بين الأعضاء أو أجزاء الجسم التي تعمل عادة معاً بانسجام)",
 "asynergic": "لا تآزري (من أو متعلق بحالة اللاتآزر؛ يفتقر إلى التآزر)",
 "asynergy": "عدم التآزر, لاتآزر (غياب التنسيق بين الأعضاء أو أجزاء الجسم التي تعمل عادة معاً بانسجام)",
 "asystole": "توقف الانقباض, توقف قلبي رئوي (غياب الانقباض القلبي؛ فشل بطينات القلب في الانقباض (عادة بسبب الرجفان البطيني) مما يؤدي إلى غياب ضربات القلب وبالتالي نقص الأكسجين والموت في النهاية)",
 "asyut": "أَسْيُوطْ",
 "at": "صَوْب, ناحية (أحد جانبي المدينة التي يقسمها نهر، ومن ذلك صوب الكرخ وصوب الرصافة في بغداد؛ نُزول المَطَر)\nمثال: صوب الرجل مسدسا نحو المحققين.",
 "at a loss": "بِخَسَارَة (أقل من التكلفة)\nمثال: باع السيارة بخسارة",
 "at a low price": "بتراب الفلوس, بثمن بخس (بمبلغ زهيد نسبياً من المال)\nمثال: اشترينا المنزل بثمن بخس",
 "at a lower place": "تحت, في الأسفل (في أو إلى مكان أقل انخفاضاً)",
 "at a time": "في آن واحد, في المرة الواحدة (بشكل متزامن)\nمثال: أخذ ثلاث كعكات في المرة الواحدة",
 "at all": "أبداً",
 "at all costs": "بِأَيِّ ثَمَنٍ",
 "at an equal rate": "بِنَفْس النِّسْبَة, عَلَى قَدَم المُسَاوَاة (تستخدم في اللغة القانونية)",
 "at any cost": "بأي ثمن, مهما كلف الأمر (بغض النظر عن التكلفة)\nمثال: أراد إنقاذ حياتها بأي ثمن",
 "at any expense": "بأي ثمن, مهما كلف الأمر (بغض النظر عن التكلفة)\nمثال: أراد إنقاذ حياتها بأي ثمن",
 "at any rate": "بأي حال, على أي حال (تستخدم للإشارة إلى أن بياناً يشرح أو يدعم بياناً سابقاً) / على أي حال, على الأقل (إن لم يكن أي شيء آخر)\nمثال: على أي حال، هو ميت الآن",
 "at arm's length": "عَلَى مَسَافَة (على بعد مسافة ما)\nمثال: إبقاء شخص ما على مسافة",
 "at best": "على أفضل تقدير (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال.",
 "at bottom": "في الأعماق, في الجوهر (في الواقع)\nمثال: هي طيبة جداً في جوهرها",
 "at close range": "بمدى قريب, عن قرب (قريب جداً)\nمثال: بدون نظارة القراءة لا أستطيع رؤية الأشياء عن قرب",
 "at fault": "مُخْطِئ, مُذْنِب (يستحق اللوم والمؤاخذة)",
 "at first": "أول الأمر, في البداية (في البدء)\nمثال: في البداية لم يلاحظ أي شيء غريب",
 "at first blush": "للوهلة الأولى, من أول نظرة (كانطباع أولي)\nمثال: للوهلة الأولى بدا العرض جذاباً",
 "at first glance": "لِلْوَهْلَة اَلْأُولَى",
 "at first hand": "مباشرة, من المصدر المباشر (من المصدر الأصلي؛ بشكل مباشر)\nمثال: سمعت هذه القصة من المصدر المباشر",
 "at first sight": "للوهلة الأولى, من النظرة الأولى (عند رؤية (شخص أو شيء) لأول مرة؛ فوراً) / للوهلة الأولى, من النظرة الأولى (بعد انطباع أولي، يثبت لاحقاً أنه غير صحيح)\nمثال: كان حباً من النظرة الأولى",
 "at gunpoint": "تَحْتَ التَّهْدِيد بِالسِّلاح (أَقَلَّ)\nمثال: أنا تحت الشجرة.",
 "at heart": "بِصَمِيم",
 "at home": "في المنزل (في أو إلى أو باتجاه المكان الذي تقيم فيه) / على أرضه (في ملعب الفريق المضيف) / استقبال منزلي (حفل استقبال يُقام في منزلك الخاص)\nمثال: عمل في المنزل",
 "at large": "بإسهاب, بشكل عام (بطريقة عامة)\nمثال: تحدث بإسهاب عن خططه",
 "at last": "أَخِيرًا",
 "at least": "عَلَى اَلْأَقَلّ (يفيد الاستعلاء؛ يفيد التعليل) / عَلَى الأَقَلِّ (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال.",
 "at leisure": "على مهل, في وقت الفراغ (بطريقة غير متسرعة أو في الوقت المناسب)\nمثال: اقرأ الدليل في وقت فراغك",
 "at length": "بِالتَّفْصِيل, بِإِسْهَاب",
 "at loggerheads": "مُتَخَاصِم, مُتَنَازِع (في حالة نزاع أو مواجهة)",
 "at long last": "أخيراً, في الختام (كنتيجة نهائية لتتابع أو عملية)\nمثال: في النهاية كان عليه الاستسلام",
 "at most": "فِي مُعْظَمِ, فِي الأَغْلَبِ (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "at night": "فِي اَللَّيْلَ (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "at once": "حَالاً (مباشرةً، فوراً، دون تأخير؛ في هذه الأثناء، في الوضع الحالي)\nمثال: سأكون معك حالا.",
 "at one time": "ذات مرة, سابقاً (في وقت سابق) / في آن واحد, في المرة الواحدة (بشكل متزامن)\nمثال: في وقت ما أحبها",
 "at present": "الآن, في الوقت الحاضر (في اللحظة الحالية)\nمثال: بضائع معروضة للبيع الآن",
 "at random": "عَشْوَائِيًّا",
 "at sea": "تَائِه, مَذْهُول (في حيرة شديدة بسبب كثرة التناقضات؛ مرتبك ومشوّش الذهن)",
 "at sign": "آت",
 "at stake": "عَلَى المِحَكّ (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال.",
 "at the best": "في أحسن الأحوال (في ظل أفضل الظروف)\nمثال: في أحسن الأحوال سنخسر المال فقط",
 "at the cost of": "عَلَى حِسَابِ (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال.",
 "at the end of one's tether": "بَلَغَ السَّيْلُ الزُّبَى",
 "at the end of the day": "فِي نِهايَةِ الْمَطاف (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "at the expense of": "عَلَى حِسَابِ, عَلَى نَفَقَةِ (يفيد الاستعلاء؛ يفيد التعليل) / عَلَى حِسَابِ (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال.",
 "at the hands of": "تَحْتَ تَصَرُف (أَقَلَّ)\nمثال: أنا تحت الشجرة.",
 "at the least": "على الأقل (ليس أقل من)\nمثال: ساعتين على الأقل دراسة الدليل",
 "at the mercy of": "تَحْتَ رَحْمَةِ (أَقَلَّ)\nمثال: أنا تحت الشجرة.",
 "at the moment": "حَالِيًّا, فِي هٰذِهِ اَللَّحْظَة",
 "at the most": "على الأكثر, كحد أقصى (ليس أكثر من)\nمثال: أنفق 20 دولاراً على الغداء كحد أقصى",
 "at the same time": "فِي نَفْس اَلْوَقْت (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "at the worst": "في أسوأ الأحوال (في ظل أسوأ الظروف)\nمثال: في أسوأ الأحوال سنذهب إلى السجن",
 "at times": "أَحْيَانًا",
 "at will": "حسب المشيئة, كما يشاء (كما يختار المرء أو يرضى)\nمثال: يمكنه التجول في الحي كما يشاء",
 "at worst": "في أسوأ الأحوال (في ظل أسوأ الظروف)\nمثال: في أسوأ الأحوال سنذهب إلى السجن",
 "at your service": "فِي خِدْمَتِكَ, فِي خِدْمَتِكِ (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "at-bat": "دور ضرب, دور على المضرب ((بيسبول) دور لمحاولة الحصول على ضربة)\nمثال: كان دوره في الضرب عندما حدث ذلك",
 "atabrine": "أتابرين, كويناكرين (دواء (الاسم التجاري أتابرين) يستخدم لعلاج بعض الإصابات بالديدان وكان يستخدم سابقاً لعلاج الملاريا)",
 "atactic": "رنحي (يفتقر إلى التنسيق الحركي؛ يتميز بـ أو ناتج عن الرنح)",
 "atactic abasia": "عدم القدرة على المشي الرنحي (عدم القدرة على المشي بسبب رنح الساقين)",
 "atakapa": "لغة أتاكابا (لغة كان يتحدث بها شعب أتاكابا في ساحل خليج لويزيانا وتكساس) / أتاكابا (فرد من شعب هندي كان يعيش سابقاً على طول ساحل الخليج في لويزيانا وتكساس)",
 "atakapa language": "لغة أتاكابا (لغة كان يتحدث بها شعب أتاكابا في ساحل خليج لويزيانا وتكساس)",
