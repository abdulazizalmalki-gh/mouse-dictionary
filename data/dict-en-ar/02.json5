 "bas relief": "نقش بارز منخفض (نحت بارز تبرز فيه الأشكال قليلاً فقط عن الخلفية؛ ولا يتم قطع أي أشكال من الأسفل)",
 "basal": "جَذْرِيّ, قَاعِدِيّ (خاصة للأوراق؛ تقع عند قاعدة نبات أو ساق؛ خاصة تنشأ مباشرة من الجذر أو الجذمور أو ساق تشبه الجذر) / تَحْتِيّ, قَاعِدِيّ (يعمل بوصفه قاعدة أو يُشكِّلها) / أَوَّلِيّ, جَوْهَرِيّ (من الجزء الأساسي أو الجوهري أو يكونه)\nمثال: مشيمة قاعدية",
 "basal body temperature": "درجة حرارة الجسم الأساسية (درجة حرارة الجسم في الصباح قبل النهوض أو التحرك أو تناول أي شيء)",
 "basal body temperature method": "طريقة درجة حرارة الجسم الأساسية (تنظيم الأسرة الطبيعي الذي يتم فيه استنتاج فترة الخصوبة في الدورة الشهرية للمرأة من خلال ملاحظة الارتفاع في درجة حرارة الجسم الأساسية الذي يحدث عادة…)",
 "basal body temperature method of family planning": "طريقة درجة حرارة الجسم الأساسية (تنظيم الأسرة الطبيعي الذي يتم فيه استنتاج فترة الخصوبة في الدورة الشهرية للمرأة من خلال ملاحظة الارتفاع في درجة حرارة الجسم الأساسية الذي يحدث عادة…)",
 "basal ganglion": "عقدة قاعدية (أي من عدة كتل من المادة الرمادية تحت القشرية عند قاعدة كل نصف كرة مخية والتي يبدو أنها تشارك في تنظيم الحركة الإرادية)",
 "basal metabolic rate": "مُعَدَّل الْأَيْض الْأَسَاسِيّ, مُعَدَّل الاِسْتِقْلَاب الْأَسَاسِيّ (هو الأمر الذي جرى عليه تَعْدِيل فهو أفضل من ما يناظره؛ السيارة المعدّلة تسير بسرعة أكبر من مثيلاتها)\nمثال: انخفض معدل الجريمة.",
 "basal metabolism": "استقلاب قاعدي, معدل الأيض الأساسي (كمية الطاقة المطلوبة للحفاظ على جسم الفرد في حالة الراحة)",
 "basal placentation": "وضع مشيمة قاعدي (حيث تتطور بويضة واحدة أو بضع بويضات في قاعدة مبيض بسيط أو مركب)",
 "basal temperature": "درجة حرارة الجسم الأساسية (درجة حرارة الجسم في الصباح قبل النهوض أو التحرك أو تناول أي شيء)",
 "basal vein": "وريد قاعدي (وريد كبير يمر على طول السطح الأنسي للفص الصدغي ويصب في الوريد المخي الكبير)",
 "basallote": "باساليوتي",
 "basalt": "بَازَلْت",
 "basaltic": "بازلتي (من أو متعلق بـ أو يحتوي على البازلت)\nمثال: الصهارة البازلتية سائلة",
 "bascule": "جسر قلاب, هيكل قلاب (هيكل أو جهاز يتم فيه موازنة أحد الطرفين بالآخر (على مبدأ الأرجوحة))",
 "base": "قَاعِدَة / قَاعِدَة, مَرْكَز / يُبْنَى عَلَى, يَسْتَنِدُ إِلَى / شائع / منخفض, فاسق / دنيء",
 "base hit": "ضربة آمنة, ضربة قاعدة ((في البيسبول) العمل الناجح لضرب الكرة بطريقة تمكن الضارب من الوصول إلى القاعدة بأمان)",
 "base metal": "معدن خسيس, معدن رخيص (معدن شائع ولا يعتبر ثميناً)\nمثال: الرصاص والحديد والنحاس والقصدير والزنك هي معادن خسيسة",
 "base of operations": "قاعدة, قاعدة عمليات (منشأة تبدأ منها القوة العسكرية عملياتها)\nمثال: قضى الهجوم على قواعدنا الأمامية",
 "base on balls": "مشي للقاعدة ((في البيسبول) تقدم الضارب للقاعدة الأولى بعد تلقي أربع رميات خارج منطقة الجزاء)\nمثال: تلاعب بالرامي للحصول على مشي للقاعدة",
 "base pair": "زوج قاعدي (زَوَّجَ الأَشياءَ تَزْويجًا، وزَواجًا: قرن بعضَها ببعض؛ زَوَّجَ فلانًا امرأةً، وبها: جعله يتزوَجَها)\nمثال: زوجة ماري طبيبة.",
 "base rate": "سعر الفائدة الأساسي (سعر الفائدة الذي يحدده بنك إنجلترا للإقراض للبنوك الأخرى)",
 "base runner": "عداء القواعد (لاعب بيسبول من الفريق الضارب يتواجد على القاعدة (أو يحاول الوصول إلى قاعدة))",
 "base-forming": "مُكَوِّن لِلْقَاعِدَة (يُنتِج قاعدة في محلول مائيّ)",
 "baseball": "بَيْسْبُول",
 "baseball bat": "مضرب بيسبول (أداة يستخدمها الضارب في البيسبول)",
 "baseball cap": "قبعة بيسبول, قبعة جوكي (قبعة ذات حاجب)",
 "baseball card": "بطاقة بيسبول (بطاقة تداول تحمل صورة لاعب بيسبول ومعلومات حول سجله في اللعب)",
 "baseball clinic": "عيادة البيسبول, ورشة تدريب البيسبول (اجتماع يتلقى فيه لاعبو البيسبول تقييماً وتعليماً خاصاً)\nمثال: عيادة بيسبول صيفية للاعبين الشباب الواعدين",
 "baseball club": "نادي بيسبول (فريق من لاعبي البيسبول المحترفين الذين يلعبون ويسافرون معًا)\nمثال: لعب كل نادٍ ست مباريات على أرضه مع فرق في قسمه الخاص",
 "baseball coach": "مدرب بيسبول (مدرب لاعبي البيسبول)",
 "baseball diamond": "ساحة البيسبول الداخلية (منطقة ملعب البيسبول المحاطة بالقواعد الثلاث واللوحة الرئيسية)",
 "baseball equipment": "معدات البيسبول (معدات تستخدم في لعب البيسبول)",
 "baseball field": "ملعب بيسبول (ملعب مخصص للعبة البيسبول)",
 "baseball game": "بيسبول, كرة القاعدة (لعبة كرة تُلعب بمضرب وكرة بين فريقين من تسعة لاعبين؛ تتناوب الفرق على الضرب في محاولة لتسجيل نقاط)\nمثال: لعب البيسبول في المدرسة الثانوية",
