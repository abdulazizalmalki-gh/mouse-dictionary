 "aureolaria virginica": "قفاز الثعلب الفرجيني (نبات معمر قليل التفرع في أمريكا الشمالية بعناقيد طرفية من الزهور الصفراء الزاهية تشبه أزهار قفاز الثعلب؛ يوضع أحياناً في جنس جيرارديا)",
 "aureole": "إكليل, نطاق (مؤشر لضوء مشع يُرسم حول رأس قديس) / إكليل الشمس, هالة شمسية (المنطقة الخارجية لغلاف الشمس الجوي؛ مرئية كهالة بيضاء أثناء الكسوف الشمسي)",
 "aureomycin": "أوريوميسين, كلورتيتراسايكلين (مضاد حيوي بلوري أصفر (الاسم التجاري أوريوميسين) يستخدم لعلاج بعض الأمراض البكتيرية والريكتسية)",
 "auric": "ذهبي, ذهبي أحادي التكافؤ (من أو متعلق بـ أو يحتوي على أو مشتق من الذهب)",
 "auricle": "صيوان الأذن (البنية الغضروفية المرئية خارجياً للأذن الخارجية) / أذينة (جيب مخروطي صغير يبرز من الجزء الأمامي العلوي لكل أذين من القلب)",
 "auricula": "أذينة, زائدة أذينية (جيب يبرز من الجزء العلوي الأمامي لكل أذين من القلب) / أذن الدب, زهرة الربيع الألبية (زهرة ربيع صفراء الزهر موطنها جبال الألب؛ تزرع بشكل شائع)",
 "auricula atrii": "أذينة (جيب مخروطي صغير يبرز من الجزء الأمامي العلوي لكل أذين من القلب)",
 "auricular": "أُذُنِيّ / خِنْصِر",
 "auricular appendage": "أذينة, زائدة أذينية (جيب يبرز من الجزء العلوي الأمامي لكل أذين من القلب)",
 "auricular appendix": "أذينة, زائدة أذينية (جيب يبرز من الجزء العلوي الأمامي لكل أذين من القلب)",
 "auricular artery": "شريان أذني (شريان يغذي الأذن بالدم)",
 "auricular point": "نقطة أذنية (نقطة قياس القحف عند مركز فتحة الصماخ السمعي الخارجي)",
 "auricular vein": "وريد أذني (واحد من وريدين يخدمان منطقة الأذن)",
 "auriculare": "نقطة أذنية (نقطة قياس القحف عند مركز فتحة الصماخ السمعي الخارجي)",
 "auricularia auricula": "أذن يهوذا, فطر الأذن (فطر صالح للأكل واسع الانتشار على شكل أذن بشرية وينمو على الخشب المتحلل)",
 "auriculate": "أُذَيْنِيّ, ذُو أُذَيْنَات (له أُذينات أو زوائد أذنية)",
 "auriculated": "أُذَيْنِيّ, ذُو أُذَيْنَات (له أُذينات أو زوائد أذنية)",
 "auriculoventricular": "أذيني بطيني (يتعلق بـ أو يؤثر على الأذينين والبطينين للقلب)\nمثال: مرض أذيني بطيني",
 "auriferous": "حَامِلٌ لِلذَّهَب, ذَهَبِيّ (يَحْتَوِي عَلَى الذَّهَب)",
 "auriform": "أُذُنِيُّ الشَّكْلِ, أُذُنِيّ (ذو شكل يشبه الأذن)",
 "auriparus flaviceps": "فيردين (قرقف صغير جداً أصفر الرأس من غرب أمريكا الشمالية)",
 "auriscope": "منظار الأذن (أداة طبية تتكون من عدسة مكبرة وضوء؛ تستخدم لفحص الأذن الخارجية (القناة السمعية وخاصة طبلة الأذن))",
 "aurochs": "أُرْخُص (أَرْخَصَ السِّعرَ: جعله رخيصًا؛ وأَرْخَصَ الشيءَ: وجده رخيصًا أو اشتراه رخيصًا)\nمثال: أظنني سأشتري الأرخص.",
 "aurora": "شَفَق قُطْبِيّ ((شَفِقَ) منه، وعليه يَشْفَقَ شَفَقًا: خاف وحَذِرَ، فهو شَفِقٌ؛ (شَفِقَ) عليه: رَقَّ له وعطف عليه؛ فهو شَفِيقٌ)\nمثال: أثارت تلك السلحفاة شفقة زيري.",
 "aurora australis": "شفق قطبي جنوبي (الشفق القطبي في نصف الكرة الجنوبي)",
 "aurora borealis": "شفق قطبي شمالي (الشفق القطبي في نصف الكرة الشمالي)",
 "auroral": "فجري (من خصائص الفجر) / شفقي (من أو متعلق بالظاهرة الجوية الشفق القطبي)\nمثال: توهج فجري خافت",
 "aurorean": "فجري (من خصائص الفجر)\nمثال: توهج فجري خافت",
 "auroscope": "منظار الأذن (أداة طبية تتكون من عدسة مكبرة وضوء؛ تستخدم لفحص الأذن الخارجية (القناة السمعية وخاصة طبلة الأذن))",
 "aurous": "ذهبي, ذهبي أحادي التكافؤ (من أو متعلق بـ أو يحتوي على أو مشتق من الذهب)",
 "aurès": "الأَوْرَاس",
 "auscultate": "تَسَمَّعَ (تَكَلَّفَ السمع)\nمثال: هل تسمع أي صوت؟",
 "auscultation": "تَسَمُّع (تَكَلَّفَ السمع)\nمثال: هل تسمع أي صوت؟",
 "auscultatory": "تسمعي (من أو متعلق بالتسمع (الفحص الطبي بالسمع))",
 "auspex": "كاهن, متوسم ((في روما القديمة) مسؤول ديني يفسر الطوالع لتوجيه السياسة العامة)",
 "auspice": "بشارة, فأل حسن (فأل إيجابي)",
 "auspices": "حماية, رعاية (تأييد وتوجيه كريم)\nمثال: أقيمت البطولة تحت رعاية مجلس المدينة",
 "auspicious": "مَيْمُون, مُبَشِّر (يبشر بظروف مواتية وحظ جيد)\nمثال: بداية مبشرة للحملة",
 "auspiciously": "بشكل مبشر, بفأل حسن (بطريقة مبشرة بالخير)\nمثال: بدأ عمله الجديد بفأل حسن في عيد ميلاده",
 "auspiciousness": "تَبْشِير بِالخَيْر, فَأْل حَسَن (الصفة الإيجابية التي تشير بقوة إلى نتيجة ناجحة)",
 "aussie": "أسترالي (مواطن أو ساكن في أستراليا)",
 "austenite": "أوستنيت (محلول جامد من كربيد الحديديك أو الكربون في الحديد؛ يبرد ليشكل البيرليت أو المارتنزيت)",
 "austenitic": "أوستنيتي (مكون من الأوستنيت)\nمثال: سبائك الصلب الأوستنيتي",
 "austenitic manganese steel": "فولاذ منغنيزي, فولاذ منغنيزي أوستنيتي (فولاذ ذو مكون كبير نسبياً (10-14%) من المنغنيز؛ مقاوم للغاية للتآكل والصدمات)",
 "austenitic steel": "فولاذ أوستنيتي (فولاذ يحتوي على ما يكفي من النيكل والكروم أو المنغنيز للاحتفاظ بالأوستنيت في درجات الحرارة الجوية)",
 "austere": "زَاهِد, مُتَقَشِّف (يُمارِس حرمانًا ذاتيًّا شديدًا) / صَارِم, قَاسِي المَلَامِح (ذو هيئة أو سلوك صارم وجادّ؛ مُنفّر في المظهر) / تَقَشُّفِيّ, صَارِم (بسيط بشكل صارم وخالٍ من أيّ زخرفة)",
 "austerely": "بِتَقَشُّف, بِصَرَامَة (بطريقة متقشفة)\nمثال: كانت الكنيسة بسيطة بتقشف",
 "austereness": "تجهم, صرامة (بساطة شديدة)",
 "austerity": "تَقَشُّف",
 "austerlitz": "أَوْسْتِرْلِيتْز",
 "austin": "أوستن",
 "austin friar": "راهب أوستن (أحد نساك القديس أوغسطين الروم الكاثوليك)",
 "austin friars": "رهبان أوغسطينوس (نظام رهباني أوغسطيني)",
 "austral": "أُسْتْرَالِيّ الاتِّجَاه, جَنُوبِيّ (ينتمي إلى الجنوب أو قادم منه) / أسترال (وحدة المال الأساسية في الأرجنتين؛ تساوي 100 سنتافو)",
 "australasia": "أسترالاسيا",
 "australasian": "أسترالاسي (يتعلق بـ أو موجود في أسترالاسيا)",
 "australia": "أُسْتُرَالِيَا, أستراليا (دولة في أوقيانوسيا؛ اسمها الرسمي كومنولث أستراليا؛ (في الجيولوجيا) قارة أستراليا-غينيا الجديدة؛ تُعتبر غينيا الجديدة أيضًا جزءًا من قارة أستراليا جيولوجيًّا بما أنها تقع على الصفيحة التكتونية…) / أُسْتُرَالِيَا, أُوسْتُرَالِيَا (دولة في أوقيانوسيا؛ اسمها الرسمي كومنولث أستراليا؛ (في الجيولوجيا) قارة أستراليا-غينيا الجديدة؛ تُعتبر غينيا الجديدة أيضًا جزءًا من قارة أستراليا جيولوجيًّا بما أنها تقع على الصفيحة التكتونية…)\nمثال: جين من أستراليا.",
 "australian": "أُسْتُرَالِيّ / أُسْتُرَالِيَّة / أُوسْتُرَالِيّ / أُوسْتُرَالِيَّة",
 "australian aborigine": "أبوريجينال, أسترالي أصلي (فرد من الشعب الذي كان يعيش في أستراليا عند وصول الأوروبيين)",
 "australian blacksnake": "ثعبان أسود أسترالي (ثعبان كبير شبه مائي من أستراليا؛ أسود من الأعلى ببطن أحمر)",
 "australian capital territory": "إِقْلِيم الْعَاصِمَة الْأُسْتُرَالِيَّة (مساحة مكانية معينة ومحددة تمثل الخطوط الحدودية لمنطقة جغرافية أو مناخية، أو كيان سياسي ما)",
 "australian chestnut": "كستناء أسترالية, كستناء خليج مورتون (شجرة أسترالية لها أوراق ريشية وزهور برتقالية صفراء تليها قرون خشبية كبيرة تحتوي على 3 أو 4 بذور تشبه الكستناء؛ تنتج خشباً قوياً داكناً)",
 "australian cockroach": "صُرْصُور أُسْتُرَالِيّ",
 "australian coral snake": "ثعبان مرجاني أسترالي (ثعبان صغير سام ولكنه غير ضار (للإنسان عادة) معلم بالأسود والأبيض على خلفية حمراء)",
 "australian crawl": "زحف, سباحة حرة (طريقة سباحة؛ يتم تحريك الذراعين بالتناوب فوق الرأس مصحوبة بركلات رفرفة)",
 "australian dollar": "دُولَار أُسْتْرَالِىّ",
 "australian english": "اَلْإِنْجِلِيزِيَّة الْأُسْتُرَالِيَّة",
 "australian english orthography": "الإملاء الأسترالي, التهجئة الأسترالية (قواعد الإملاء الإنجليزية المستخدمة في أستراليا (تميل للنمط البريطاني))",
 "australian english spelling": "الإملاء الأسترالي, التهجئة الأسترالية (قواعد الإملاء الإنجليزية المستخدمة في أستراليا (تميل للنمط البريطاني))",
 "australian grass tree": "شجرة العشب الأسترالية (شجيرة أسترالية قوية بأوراق ضيقة مزدحمة في نهايات الفروع وعناقيد طرفية من الزهور البيضاء أو الوردية) / شجرة العشب, شجرة العشب الأسترالية (أي من النباتات المعمرة الأسترالية دائمة الخضرة ذات سيقان خشبية سميكة قصيرة متوجة بخصلة من أوراق تشبه العشب وتنتج راتنجات أكاريد)",
 "australian hare's foot": "قدم الأرنب الأسترالي (سرخس قدم الأرنب من جنس دافاليا)",
 "australian heath": "خلنج أسترالي (أي نبات يشبه الخلنج من العائلة الإيباكريدية؛ معظمها من المنطقة الأسترالية)",
 "australian honeysuckle": "بانكسيا الساحل, عسلة أسترالية (شجرة شجيرية بأوراق حريرية وسنابل من الزهور الصفراء الرحيقية الأسطوانية)",
 "australian labor party": "حزب العمال الأسترالي (أقدم حزب سياسي في أستراليا، تأسس عام 1891؛ الحزب ليبرالي معتدل)",
 "australian language": "لغات السكان الأصليين الأسترالية (اللغات الأسترونيزية التي يتحدث بها سكان أستراليا الأصليون)",
 "australian magpie": "عقعق أسترالي (طيور مغردة سوداء وبيضاء تشبه العقعق)",
 "australian nettle": "شجرة القراص الأسترالية, قراص أسترالي (أي من الأشجار الأسترالية الطويلة المتعددة من جنس لابورتيا)",
 "australian nettle tree": "شجرة القراص الأسترالية, قراص أسترالي (أي من الأشجار الأسترالية الطويلة المتعددة من جنس لابورتيا)",
 "australian pea": "بازلاء أسترالية, ديبوغون (كرمة خشبية جزئياً دائمة الخضرة من جنوب أفريقيا تزرع لعناقيدها من الزهور الأرجوانية الوردية تليها قرون صالحة للأكل مثل الفاصوليا الخضراء؛ تزرع أيضاً…)",
 "australian pine": "صنوبر أسترالي (شجرة أسترالية شائعة تزرع على نطاق واسع كنبات زينة في المناطق الاستوائية؛ تنتج خشباً أحمر صلباً ثقيلاً)",
 "australian pitcher plant": "نبات الإبريق الأسترالي (عشب لاحم معمر له إبريق أخضر وغطاء مفصلي كلاهما بحواف حمراء؛ غرب أستراليا)",
 "australian reed grass": "عشبة القصب الأسترالية (عشبة أسترالية طويلة تشبه القصب تستخدم أحياناً للتبن)",
 "australian sea lion": "أسد البحر الأسترالي (نوع من أسود البحر يوجد في أستراليا)",
 "australian spelling": "الإملاء الأسترالي, التهجئة الأسترالية (قواعد الإملاء الإنجليزية المستخدمة في أستراليا (تميل للنمط البريطاني))",
 "australian state": "ولاية أسترالية (واحدة من الولايات العديدة التي تشكل أستراليا)",
 "australian stilt": "أبو المغازل الأسترالي (طائر خوض طويل الساقين ثلاثي الأصابع يعيش في المستنقعات قليلة الملوحة في أستراليا)",
 "australian sumac": "سماق أسترالي (شجرة دائمة الخضرة من أستراليا تنتج خشباً أصفر داكناً)",
 "australian sword lily": "زنبق السيف الأسترالي, مخلب الكنغر (عشب يشبه السعادى يزهر في الربيع له أزهار عنقودية مغطاة بشعيرات صوفية؛ أستراليا)",
 "australian terrier": "تيريير أسترالي (سلالة صغيرة رمادية سلكية الشعر من التيريير من أستراليا تشبه الكايرن)",
 "australian turtledove": "يمام أسترالي (حمامة أسترالية صغيرة)",
 "australian white ibis": "أبو منجل الأبيض الأسترالي",
 "australianness": "الطابع الأسترالي (حالة أو جودة كون الشيء أسترالياً)",
 "australopithecine": "أسترالوبيثكس, قردة الجنوب (أي من عدة رئيسيات منقرضة شبيهة بالإنسان تسير على قدمين ولها أدمغة صغيرة نسبياً من جنس أسترالوبيثكس؛ عاشت منذ 1 إلى 4 ملايين سنة) / أسترالوبيثكسي (من أو ينتمي إلى جنس أشباه البشر المسمى أسترالوبيثكس)",
 "australopithecus afarensis": "أسترالوبيثكس أفارينيسيس (حفريات عُثر عليها في إثيوبيا؛ من 3.5 إلى 4 ملايين سنة مضت)",
 "australopithecus africanus": "أسترالوبيثكس أفريكانوس (شبيه بشر رشيق من جنوب أفريقيا؛ من حوالي 3 ملايين سنة مضت)",
 "australopithecus boisei": "أسترالوبيثكس بويزي (شبيه بشر كبير الأسنان من شرق أفريقيا؛ من 1 إلى 2 مليون سنة مضت)",
 "australopithecus robustus": "أسترالوبيثكس روبوستوس (شبيه بشر كبير الأسنان من جنوب أفريقيا؛ من 1.5 إلى 2 مليون سنة مضت؛ سابقاً بارانثروبوس)",
 "austria": "النَّمْسَا, النِّمْسَا (دولة في أوروبا الوسطى؛ اسمها الرسمي جمهورية النمسا، وعاصمتها فيينا)\nمثال: النمسا بلد الكناغر.",
 "austria-hungary": "النَّمْسَا وَٱلْمَجَر (دولة في أوروبا الوسطى؛ اسمها الرسمي جمهورية النمسا، وعاصمتها فيينا)\nمثال: النمسا بلد الكناغر.",
 "austrian": "نَمْسَاوِيّ, نِمْسَاوِيّ",
 "austrian monetary unit": "وحدة نقدية نمساوية (الوحدة النقدية في النمسا)",
 "austrian schilling": "شلن, شلن نمساوي (سابقاً وحدة المال الأساسية في النمسا)",
 "austrian winter pea": "بازلاء الحقل (صنف من نبات البازلاء موطنه منطقة البحر الأبيض المتوسط وشمال أفريقيا ويزرع على نطاق واسع خاصة للعلف)",
 "austro-asiatic": "اللغات الأسترو آسيوية (عائلة من اللغات يتم التحدث بها في جنوب وجنوب شرق آسيا)",
 "austro-asiatic language": "اللغات الأسترو آسيوية (عائلة من اللغات يتم التحدث بها في جنوب وجنوب شرق آسيا)",
 "austrocedrus chilensis": "أرز تشيلي (شجرة صغيرة دائمة الخضرة من أمريكا الجنوبية لها لحاء نحاسي وأوراق جميلة)",
 "austronesia": "أُسْتْرُونِيزِيَا",
 "austronesian": "أسترونيزي (من أو يتعلق بأسترونيزيا أو شعبها أو ثقافتها أو يميزهم) / اللغات الأسترونيزية (عائلة اللغات التي يتم التحدث بها في أستراليا وفورموزا وماليزيا وبولينيزيا) / أسترونيزي (مواطن أو ساكن في أسترونيزيا)",
 "austronesian language": "اللغات الأسترونيزية (عائلة اللغات التي يتم التحدث بها في أستراليا وفورموزا وماليزيا وبولينيزيا)",
 "austrotaxus spicata": "طقسوس كاليدونيا الجديدة (طقسوس كبير موطنه كاليدونيا الجديدة؛ يزرع في شرق أستراليا ونيوزيلندا وهاواي)",
