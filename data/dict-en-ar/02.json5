 "asperger's syndrome": "متلازمة اسبرجر",
 "aspergill": "مرشّة, مِضَحَّة (جهاز ذو مقبض قصير وكرة تحتوي على إسفنجة؛ يستخدم لرش الماء المقدس)",
 "aspergillosis": "داء الرشاشيات (مرض يصيب العمال الزراعيين خاصة بسبب استنشاق أبواغ الرشاشيات) / داء الرشاشيات (عدوى انتهازية فطرية تتميز بالتهاب وآفات في الأذن وأعضاء أخرى) / التهاب رئوي بالحضنة (مرض تنفسي شديد للطيور يتخذ شكل التهاب رئوي حاد سريع الفتك في الدجاج الصغير والديوك الرومية)",
 "aspergillus fumigatus": "رشاشية دخناء (عفن يسبب داء الرشاشيات في الطيور والإنسان)",
 "asperity": "حِدَّة",
 "aspersion": "رش الماء (فعل رش الماء في المعمودية (نادر)) / افْتِرَاء, تَشْهِير (هجوم مسيء على شخصية شخص ما أو سمعته الطيبة) / تَشْهِير, طَعْن (ملاحظة مهينة أو مسيئة للسمعة)\nمثال: من الصعب على المرأة أن تفهم حساسية الرجل تجاه أي طعن في رجولته",
 "aspersorium": "مرشّة, مِضَحَّة (جهاز ذو مقبض قصير وكرة تحتوي على إسفنجة؛ يستخدم لرش الماء المقدس) / حوض الماء المقدس (الحوض أو الوعاء الذي يحمل الماء المقدس في الكنائس الكاثوليكية)",
 "asperula odorata": "جويسئة عطرة, نبات الخشبة",
 "asperula tinctoria": "خشب الصباغين (نبات أوروبي زاحف معمر له زهور حمراء أو بيضاء وردية وجذور حمراء تستخدم أحياناً كبديل للفوة في الصباغة)",
 "aspet": "اسباته",
 "asphalt": "أَسْفَلْت, زِفْت",
 "asphaltic": "إسفلتي (يحتوي على الإسفلت)\nمثال: بقايا إسفلتية",
 "aspheric": "لَاكُرَوِيّ (يختلف قليلاً عن الشكل الكروي التامّ)",
 "aspherical": "لَاكُرَوِيّ (يختلف قليلاً عن الشكل الكروي التامّ)",
 "asphodel": "أسفوديل, بروق (أي من النباتات المتوسطية المختلفة من أجناس أسفوديلين وأسفوديلوس ذات أوراق خطية وعناقيد من الزهور البيضاء أو الوردية أو الصفراء)",
 "asphodeline lutea": "بروق أصفر, رمح الملك (بروق بساق مورقة وزهور صفراء عطرة)",
 "asphyxia": "اختناق",
 "asphyxiated": "مختنق (في حالة اختناق)",
 "asphyxiating": "خَانِق, مُسَبِّب لِلاخْتِنَاق (يَمِيل إِلَى حِرْمَان الجِسْم مِنَ الأُكْسِجِين)",
 "asphyxiation": "اختناق, خنق (القتل عن طريق الحرمان من الأكسجين) / اختناق (حالة الحرمان من الأكسجين (كما في توقف التنفس))\nمثال: يستخدم الاختناق أحياناً كشكل من أشكال التعذيب",
 "asphyxiator": "طفاية حريق, مطفأة حريق (جهاز يعمل يدوياً لإطفاء الحرائق الصغيرة)",
 "aspic": "آسبك, هلام اللحم (هلام مالح يعتمد على مرق السمك أو اللحم يستخدم كقالب للحوم أو الخضروات)",
 "aspidelaps lubricus": "ثعبان مرجاني أفريقي (ثعبان شجري صغير واسع الانتشار في جنوب أفريقيا مخطط بالأسود والبرتقالي)",
 "aspidiotus perniciosus": "حشرة سان خوسيه القشرية (حشرة صغيرة من شرق آسيا تم توطينها في الولايات المتحدة وتتلف أشجار الفاكهة)",
 "aspidistra": "أسبيديسترا, دريقة (نبات معمر دائم الخضرة بأوراق قاعدية وسيمة كبيرة؛ يزرع بشكل أساسي كنبات منزلي ورقي)",
 "aspidistra elatio": "أسبيديسترا, دريقة (نبات معمر دائم الخضرة بأوراق قاعدية وسيمة كبيرة؛ يزرع بشكل أساسي كنبات منزلي ورقي)",
 "aspidistra elatior": "أسبيديسترا, دريقة (نبات معمر دائم الخضرة بأوراق قاعدية وسيمة كبيرة؛ يزرع بشكل أساسي كنبات منزلي ورقي)",
 "aspidophoroides monopterygius": "سمكة التمساح (صياد بحر صغير ومستطيل جداً)",
 "aspirant": "تَوَّاق, طَامِح (يرغب في الاعتراف والتقدم أو يسعى إليهما) / طامح, طامع (شاب طموح ومتطلع)\nمثال: طامح رفيع المستوى",
 "aspirate": "صوت مهموس, هاء (صامت يُنطق مع نَفَس مسموع) / تفخيم, صوت مصحوب بنفخ (صوت كلامي يرافقه نفخة مسموعة من النفس، مثل الصوامت الوقفية الأولية)",
 "aspiration": "أَمَل ((أَمَّلَه): أَمَلَهُ يُقَال: فلَان بَحر المؤمل) / رَشْف (رشف الماء أو نحوه: مصه بشفتيه؛ رشف الإناء: شرب ما فيه ولم يترك فيه شيئا) / زَفْر (زفَر الشَّخصُ : أخرج نفَسه من رئتيه بعد مدِّه إيّاه؛ أظهر تعبيرًا عن الحزن أو الألم من خلال تنهد أو صوت عميق)\nمثال: أشعر بخيبة أمل.",
 "aspiration pneumonia": "التهاب رئوي شفطي (التهاب الرئتين الناجم عن استنشاق أو الاختناق بالقيء؛ قد يحدث أثناء فقدان الوعي (التخدير أو السكر أو النوبة أو السكتة القلبية))",
 "aspirator": "شَفَّاطة, رُشَافَة",
 "aspirer": "طامح, طامع (شاب طموح ومتطلع)\nمثال: طامح رفيع المستوى",
 "aspirin": "أَسْبِرِين",
