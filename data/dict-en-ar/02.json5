 "back": "خَلْفِيّ / ظَهْر (مصدر للفعل ظَهَرَ؛ خلاف البَطْن، الجزء الظَاهِر من الشيئ وغير البَاطِن) / ضهر / ظَهَر (مصدر للفعل ظَهَرَ؛ خلاف البَطْن، الجزء الظَاهِر من الشيئ وغير البَاطِن)\nمثال: عنده حقيبة ظهر.",
 "back and forth": "ذَهَابًا وَإِيَابًا",
 "back brace": "دعامة ظهر (دعامة يتم ارتداؤها لدعم الظهر)",
 "back breaker": "أسيد, حمض (اسم دارج لثنائي إيثيل أميد حمض الليسرجيك)",
 "back burner": "أولوية متأخرة, تأجيل (أولوية منخفضة)\nمثال: تم وضع عشرات الحالات على الرف (تأجيلها)",
 "back channel": "قناة خلفية, قناة سرية (بديل لقنوات الاتصال العادية يستخدم عندما يجب عقد الاتفاقيات سراً (خاصة في الدبلوماسية أو الحكومة))\nمثال: تفاوضوا عبر قناة خلفية",
 "back circle": "دائرة خلفية (حركة يقوس فيها البهلوان ظهره من وضعية الانبطاح ويثني ركبتيه حتى تلمس أصابع القدم الرأس)",
 "back country": "أحراش, منطقة نائية (منطقة نائية وغير متطورة)",
 "back door": "بَاب خَلْفِيّ (ما يُسَدُّ به مَدْخَل المَبْنَى أو الغُرْفَة أو المَرْكَبَة؛ (تعميم) مَدْخَل أي شيء؛ فُتْحَة)\nمثال: ظل الباب مغلقا.",
 "back end": "خلفية, مؤخرة (جانب الجسم الذي يعاكس مقدمته)\nمثال: كانت غرفته باتجاه الجزء الخلفي من الفندق",
 "back entrance": "باب خلفي, مدخل خلفي (مدخل في الجزء الخلفي من المبنى)",
 "back exercise": "تمرين ظهر (تمرين مصمم لتقوية عضلات الظهر)",
 "back judge": "حكم خلفي (حكم كرة قدم يقف عميقاً خلف الدفاع الثانوي في وسط الملعب)",
 "back matter": "الملحقات الختامية, ذيل الكتاب (مادة مكتوبة تلي المتن الرئيسي لكتاب)",
 "back of beyond": "آخر الدنيا, مكان ناءٍ (مكان بعيد جداً ويصعب الوصول إليه)\nمثال: سيتعين عليك الذهاب إلى آخر الدنيا لتجد واحداً من هؤلاء",
 "back pack": "حقيبة ظهر, حقيبة محمولة على الظهر (حقيبة تُحمل بحزام على الظهر أو الكتف)",
 "back porch": "شرفة خلفية (شرفة للباب الخلفي)",
 "back room": "غرفة خلفية (غرفة تقع في الجزء الخلفي من منشأة؛ وعادة ما تكون متاحة فقط لمجموعات مميزة)",
 "back saw": "منشار مقوى الظهر (منشار يدوي مدعم بتقوية معدنية على طول الحافة العلوية)",
 "back seat": "مَقْعَد خَلْفِيّ (كل ما يُقْعَدُ ويُجْلَسُ عليه؛ مَكَان القُعُود)\nمثال: نام ياني على مقعد.",
 "back stance": "وقفة خلفية (وقفة أساسية تستخدم في الفنون القتالية، حيث تكون الساق الخلفية مثنية بقوة عند الركبة والساق الأمامية مستقيمة أو مثنية قليلاً)\nمثال: هناك واحد وعشرون حركة في هيان شودان، تبدأ بالصد لأسفل باليسار في الوقفة الأمامية وتنتهي بصد اليد السكين باليسار في الوقفة الخلفية",
 "back street": "حارة, زقاق (شارع ضيق بجدران على كلا الجانبين)",
 "back talk": "رد وقح, وقاحة (رد وقح أو غير مهذب)\nمثال: لا تترد علي بوقاحة",
 "back tooth": "سن خلفية (سن تقع في مؤخرة الفم)",
 "back vowel": "صائت خلفي ((صوتيات) أي صوت صائت يتم إنتاجه في مؤخرة الفم)",
 "back yer": "علامة التفخيم, ير خلفي (الحرف السيريلي Ъ/ъ، والذي يعمل في اللغات الحديثة للدلالة على صامت صلب (غير مرقق))",
 "back-blast": "عصف خلفي (ارتداد ناري من سلاح عديم الارتداد)",
 "back-channel": "سري, قناة خلفية (عبر قناة خلفية (غير رسمية أو سرية))\nمثال: فشل المفاوضات عبر القنوات الخلفية",
 "back-formation": "اشْتِقَاق عَكْسِيّ, مُشْتَقَّة عَكْسِيًّا",
 "back-geared": "ذُو تَعْشِيق خَلْفِيّ ((عن المخرطة) مُجهَّز بتروس لتقليل سرعة المِغزل عن سرعة البَكَرة المحركة)",
 "back-number": "شخص ولى زمانه (شخص لم يعد مشهوراً)",
 "back-to-back": "مُتَتَالٍ, مُتَعَاقِب (واحد تلو الآخر دون انقطاع)",
 "backache": "ألم الظهر (وجع موضعي في الظهر)",
 "backband": "حزام الظهر (حزام عريض يمر فوق ظهر الحصان ويدعم أعمدة المركبة)",
 "backbeat": "إيقاع خلفي (نقر قوي وثابت)",
 "backbench": "مقعد خلفي (أي من المقاعد التي يشغلها النواب الخلفيون في مجلس العموم)",
 "backbencher": "نائب خلفي (عضو في مجلس العموم ليس قائداً حزبياً)",
 "backbend": "انحناء خلفي (حركة بهلوانية يُثنى فيها الجذع للخلف من وضعية الوقوف حتى تلامس اليدان الأرض)",
 "backbite": "اِغْتَابَ, أَبَرَ",
 "backbiter": "قاذف, مشهر (من يهاجم سمعة شخص آخر بالتشهير أو القذف)",
 "backbiting": "غِيبَة",
 "backblast": "عصف خلفي (ارتداد ناري من سلاح عديم الارتداد)",
 "backboard": "لوح إسناد, لوح ظهر (لوح يستخدم لدعم ظهر شخص أو شيء ما) / لوحة السلة (لوحة رأسية مرتفعة مثبت بها سلة؛ تستخدم للعب كرة السلة)\nمثال: ارتدت الكرة من اللوحة",
 "backbone": "عَمُود فَقْرِيّ / دِعَامَة / شَجَاعَة",
 "backbreaking": "شَاقّ, مُضْنٍ (يتّسم بجهد يصل إلى حدّ الإنهاك؛ خاصة الجهد البدني)",
 "backchat": "مُدَاعَبَة, مُمَازَحَة (ردود خفيفة مازحة)",
 "backcloth": "خلفية المسرح, ستارة خلفية (مناظر معلقة في الجزء الخلفي من المسرح)",
 "backdoor": "باب خلفي, وسيلة سرية (وسيلة سرية أو ملتوية للوصول (إلى مكان أو منصب)) / باب خلفي, مدخل خلفي (مدخل في الجزء الخلفي من المبنى) / باب خلفي, مدخل خلفي (طريقة غير موثقة للوصول إلى نظام حاسوب أو البيانات التي يحتوي عليها)\nمثال: حصل على وظيفته من الباب الخلفي",
 "backdown": "انسحاب, تراجع (التراجع عن موقف تم تبنيه سابقاً)",
 "backdrop": "خلفية المسرح, ستارة خلفية (مناظر معلقة في الجزء الخلفي من المسرح)",
 "backed": "ذُو ظَهْر, مَدْعُوم (له ظهر أو دعم، عادة من نوع محدد) / مَطْلِيّ الظَّهْر ((للأفلام) مطلي على الجانب المقابل للمستحلب بمادة تمتص الضوء)",
 "backer": "داعم مالي, ممول (شخص يقدم الدعم المالي لمشروع ما)",
 "backfield": "الخط الخلفي (لاعبو الهجوم في كرة القدم الذين يصطفون خلف لاعبي الخط)",
 "backfire": "نتيجة عكسية (سوء تقدير يرتد على صاحبه) / حريق مضاد (حريق يتم إشعاله عمداً لإبطاء حريق غابة أو حشائش مقبل عن طريق إخلاء منطقة محترقة في مساره) / اشتعال خلفي, فرقعة عكسية (ضجيج عالٍ صادر عن انفجار الوقود في متشعب أو عادم محرك الاحتراق الداخلي) / ارتداد غازي, نفث خلفي (الهروب العكسي للغازات والبارود غير المحترق بعد إطلاق النار)",
 "backflow": "ارتجاع, تدفق عكسي (تدفق يعود نحو مصدره)",
 "backflowing": "ارتجاع, تدفق عكسي (تدفق يعود نحو مصدره)",
 "backgammon": "طَاوِلَة, نَرْد (قِطْعَة أَثَاث توضع عليها الأشياء، ولها رِجْل أو أكثر. ( أحادي)؛ لُعْبَة مشهورة في الشرق الأوسط عبارة عن لوح توضع عليه قطع من خشب بلونين ويستخدم النَّرْد للعب. (اسم علم))\nمثال: هذه ليست طاولة.",
 "backgammon board": "لوحة الطاولة (اللوحة التي تُلعب عليها لعبة الطاولة (النرد))",
 "background": "خلفية",
 "background knowledge": "خلفية, معلومات أساسية (معلومات ضرورية لفهم موقف أو مشكلة)\nمثال: أطلعته السفارة على خلفية الحادث",
 "background level": "مستوى الخلفية, مستوى الضجيج (مستوى سعة ضوضاء الخلفية غير المرغوب فيها)",
 "background noise": "ضوضاء خلفية (ضوضاء خارجية تلوث القياسات الصوتية ولا يمكن فصلها عن الإشارة المطلوبة)",
 "background processing": "معالجة في الخلفية (تنفيذ البرامج ذات الأولوية المنخفضة بينما لا تستخدم البرامج ذات الأولوية الأعلى نظام المعالجة)",
 "background radiation": "إشعاع الخلفية (إشعاع قادم من مصادر أخرى غير تلك التي يتم رصدها)",
 "background signal": "إشارة خلفية, خلفية (إشارات خارجية يمكن الخلط بينها وبين الظاهرة المراد مراقبتها أو قياسها)\nمثال: حصلوا على اتصال سيء وبالكاد استطاعوا سماع بعضهم البعض فوق الإشارات الخلفية",
 "backgrounder": "إحاطة إعلامية (مؤتمر صحفي أو مقابلة يشرح فيه مسؤول حكومي للمراسلين خلفية إجراء أو سياسة ما)\nمثال: أعطانا الوزير إحاطة عن قضايا الصحة العامة",
 "backgrounding": "معالجة في الخلفية (تنفيذ البرامج ذات الأولوية المنخفضة بينما لا تستخدم البرامج ذات الأولوية الأعلى نظام المعالجة)",
 "backhand": "ضربة خلفية (رد يتم بظهر اليد مواجهاً لاتجاه الضربة) / مَائِلٌ لِلْخَلْف ((في الخطّ اليدويّ) ذو حروف مائلة إلى الخلف)",
 "backhand drive": "ضربة خلفية مستقيمة (رد مستقيم قوي يتم على الجانب الخلفي)",
 "backhand shot": "ضربة خلفية (رد يتم بظهر اليد مواجهاً لاتجاه الضربة)",
 "backhand stroke": "ضربة خلفية (رد يتم بظهر اليد مواجهاً لاتجاه الضربة)",
 "backhanded": "مُبَطَّن, مُلْتَبِس (مُوَارِب أَوْ غَامِض) / خلفي, ضربة خلفية ((عن ضربات المضرب) مصنوعة عبر الجسم بحيث يواجه ظهر اليد اتجاه الضربة)",
 "backhander": "ضربة بظهر اليد (ضربة خلفية)",
 "backhoe": "عقرب",
 "backing": "دعم, مؤازرة (فعل تقديم الموافقة والدعم) / بطانة, دعامة خلفية (شيء يشكل ظهراً يضاف للتقوية) / تمويل, دعم مالي (الموارد المالية المقدمة لجعل مشروع ما ممكناً)\nمثال: دعمه القوي للمحافظين أوقعه في مشاكل مع التقدميين",
 "backlash": "رَدّ فِعْل عَنِيف (صَرَفَ، أَرْجَعَ؛ أَعَادَ، أَرْجَعَ. (يتعدى بإلى))\nمثال: اليوم هناك برد.",
 "backless": "بِلَا ظَهْر, مَكْشُوف الظَّهْر (يفتقر إلى ظهر)\nمثال: البراز (الكرسي) هو مقعد بلا ظهر وبلا ذراعين",
 "backlighting": "إضاءة خلفية (إضاءة من الخلف)",
 "backlog": "أعمال متراكمة, تراكم (تراكم للوظائف غير المنجزة أو المواد غير المعالجة التي لم يتم التعامل معها بعد (خاصة طلبات العملاء غير المنفذة للمنتجات أو الخدمات)) / احتياطي, مخزون استراتيجي (شيء يُحتفظ به أو يُدخر للاستخدام المستقبلي أو لغرض خاص) / جذع الموقد الخلفي (الجذع الكبير في الجزء الخلفي من نار الموقد)",
 "backmost": "الأَبْعَد خَلْفًا, الأَخِير (يقع في أبعد نقطة نحو الخلف)",
 "backpack": "حَقِيبَة ظَهْر",
 "backpack vacuum": "مكنسة محمولة على الظهر (مكنسة أسطوانية صغيرة تُربط على ظهر المستخدم، وتستخدم عادة في التنظيف التجاري)",
 "backpack vacuum cleaner": "مكنسة محمولة على الظهر (مكنسة أسطوانية صغيرة تُربط على ظهر المستخدم، وتستخدم عادة في التنظيف التجاري)",
 "backpacker": "رحالة بحقيبة ظهر (متجول يرتدي حقيبة ظهر)",
 "backpacking": "حمل حقيبة الظهر (حمل شيء ما في حقيبة على الظهر)\nمثال: حمل الأكسجين في حقائب الظهر ضروري لرواد الفضاء",
 "backpacking tent": "خيمة ظهر (خيمة يمكن حملها في حقيبة الظهر)",
 "backplate": "صفيحة الظهر (درع صفيحي يحمي الظهر؛ يُلبس كجزء من درع الجذع)",
 "backrest": "ظهر, مسند ظهر (دعامة يمكنك الاستناد إليها أثناء الجلوس)\nمثال: كان ظهر كرسي الأسنان قابلاً للتعديل",
 "backroom": "غرفة خلفية (مكان اجتماع مجموعة من القادة يتخذون قراراتهم عبر مفاوضات خاصة)",
 "backroom boy": "مستشار خفي (مستشار خبير ذكر يشارك في اتخاذ قرارات مهمة ولكنه يفتقر عادة إلى الصفة الرسمية)",
 "backroom girl": "مستشارة خفية (مستشارة خبيرة أنثى تشارك في اتخاذ قرارات مهمة ولكنها تفتقر عادة إلى الصفة الرسمية)",
 "backsaw": "منشار مقوى الظهر (منشار يدوي مدعم بتقوية معدنية على طول الحافة العلوية)",
 "backscratcher": "حكاكة ظهر (أداة حك ذات مقبض طويل لحك ظهرك) / متبادل المصالح, نفعي (شخص مستعد لتبادل الخدمات أو المعروف لتحقيق مصلحة متبادلة)",
 "backseat": "مقعد خلفي (مقعد في الجزء الخلفي من المركبة (خاصة المقعد الخلفي للسيارة)) / مرتبة ثانوية (موقف أو وضع ثانوي أو أدنى)\nمثال: كان على التنس أن يتراجع إلى مرتبة ثانوية بينما عمله متطلب للغاية",
 "backseat driver": "مقدم نصائح غير مرغوبة, موجه متطفل (متطفل يصر على تقديم نصائح غير مرغوب فيها)",
 "backsheesh": "إكرامية, بقشيش (مبلغ صغير نسبياً من المال يُعطى مقابل الخدمات المقدمة (كما من قبل نادل))",
 "backside": "أرداف, ألية (الجزء اللحمي من جسم الإنسان الذي يجلس عليه) / خلفية, مؤخرة (جانب الجسم الذي يعاكس مقدمته)\nمثال: يستحق ركلة جيدة في مؤخرته",
 "backslapper": "متملق, ودود بإفراط (شخص يظهر ودية مفرطة أو حماسية)",
 "backslash": "مَائِلَة مُعَاكِسَة",
 "backslider": "عائد للخطيئة, منتكص (شخص يعود إلى أنماط سلوك سابقة غير مرغوب فيها)",
 "backsliding": "انتكاس, تراجع (فشل في الحفاظ على حالة أعلى)",
 "backspace": "مفتاح التراجع, مفتاح مسافة الخلف (مفتاح الآلة الكاتبة المستخدم للرجوع للخلف)",
 "backspace character": "حرف مسافة للخلف (حرف تحكم يشير إلى تحريك مسافة لليسار)",
 "backspace key": "مفتاح التراجع, مفتاح مسافة الخلف (مفتاح الآلة الكاتبة المستخدم للرجوع للخلف)",
 "backspacer": "مفتاح التراجع, مفتاح مسافة الخلف (مفتاح الآلة الكاتبة المستخدم للرجوع للخلف)",
 "backspin": "دوران خلفي (دوران (عادة لكرة متحركة) يؤخر أو يعكس الحركة الأمامية)",
 "backstage": "كَوَالِيس",
 "backstair": "خُفْيَوِيّ, مُتَسَتِّر (سِرِّيٌّ وَمَاكِرٌ أَوْ وَضِيع)",
 "backstairs": "خُفْيَوِيّ, مُتَسَتِّر (سِرِّيٌّ وَمَاكِرٌ أَوْ وَضِيع) / درج خلفي (سلم ثاني في الجزء الخلفي من المبنى)",
 "backstay": "دعامة خلفية (دعامة تدعم الجزء الخلفي من شيء ما)",
 "backstitch": "غرزة خلفية (غرزة متداخلة مصنوعة ببدء الغرزة التالية في منتصف الغرزة السابقة)",
 "backstop": "خط دفاع خلفي, صمام أمان (احتياط في حالة الطوارئ) / سياج خلفي ((البيسبول) سياج أو شاشة (كما هو الحال خلف القاعدة الرئيسية) لمنع الكرة من الخروج من الملعب) / ماسك, ملتقط ((في البيسبول) الشخص الذي يلعب في مركز الماسك خلف الضارب)\nمثال: عمل كخط دفاع خلفي في حال ساءت الأمور",
 "backstory": "خلفية درامية",
