 "atlantic bonito": "سَرْدَة",
 "atlantic bottlenose dolphin": "دلفين قاروري الأنف الأطلسي (أكثر الدلافين شيوعاً في شمال المحيط الأطلسي والبحر الأبيض المتوسط؛ غالباً ما يُحتفظ به في الأسر ويُدرب لتقديم العروض)",
 "atlantic cod": "قد أطلسي (واحدة من أهم الأسماك التجارية في العالم)",
 "atlantic croaker": "كرواكر الأطلسي (سمكة كرواكر فضية الجسم ذات علامات داكنة وشعيرات صغيرة)",
 "atlantic halibut": "هلبوت الأطلسي (أكبر سمكة مفلطحة في الولايات المتحدة)",
 "atlantic herring": "رنجة أطلسية (سمكة طعام مهمة؛ توجد في أسراب ضخمة في شمال المحيط الأطلسي)",
 "atlantic horse mackerel": "قُدْقُود, إِسْقُمَرِيّ اَلْخَيْل الْأَطْلَسِيّ",
 "atlantic manta": "مانتا أطلسية (أكبر أنواع المانتا (يصل عرض جناحيها إلى 22 قدماً)؛ توجد في جميع أنحاء العالم ولكنها شائعة في خليج المكسيك وعلى طول السواحل الجنوبية للولايات المتحدة؛…)",
 "atlantic moonfish": "سمكة القمر (أي من عدة أسماك بحرية فضية ذات أجسام مسطحة جداً)",
 "atlantic ocean": "الْمُحِيط الْأَطْلَسِيّ, الْأَطْلَسِيّ",
 "atlantic puffin": "بفن أطلسي (بفن شائع في شمال المحيط الأطلسي)",
 "atlantic ridley": "لجأة أطلسية, لجأة كيمب (سلحفاة بحرية رمادية تعيش في سواحل المحيط الأطلسي والخليج في أمريكا الشمالية)",
 "atlantic sailfish": "سمكة الشراع الأطلسية (نوع من سمك الشراع)",
 "atlantic salmon": "سلمون أطلسي (يوجد في المياه الساحلية الشمالية للمحيط الأطلسي أو روافده؛ لا يموت البالغون بعد وضع البيض) / سلمون أطلسي (لحم وردي دهني لسمكة من الساحل الشمالي للأطلسي؛ يسوق عادة طازجاً)",
 "atlantic sea bream": "دنيس أطلسي (دنيس المياه الأطلسية الدافئة)",
 "atlantic spiny dogfish": "كلب البحر الشائك الأطلسي (كلب بحر مدمر يعيش في المياه الساحلية الأطلسية لأمريكا وأوروبا؛ يستخدم على نطاق واسع في دروس التشريح)",
 "atlantic standard time": "توقيت الأطلسي (التوقيت القياسي في المنطقة الزمنية الرابعة غرب غرينتش، يحسب عند خط الطول 60؛ يستخدم في بورتوريكو وجزر العذراء وبرمودا والمقاطعات البحرية الكندية)",
 "atlantic time": "توقيت الأطلسي (التوقيت القياسي في المنطقة الزمنية الرابعة غرب غرينتش، يحسب عند خط الطول 60؛ يستخدم في بورتوريكو وجزر العذراء وبرمودا والمقاطعات البحرية الكندية)",
 "atlantic tripletail": "ثلاثية الذيل الأطلسية (سمكة ثلاثية الذيل توجد من كيب كود إلى شمال أمريكا الجنوبية)",
 "atlantic walrus": "فظ أطلسي (فظ من شمال المحيط الأطلسي ومياه القطب الشمالي)",
 "atlantic white cedar": "أرز أبيض أطلسي, سرو أبيض (أرز متوسط الحجم بطيء النمو من الساحل الشرقي للولايات المتحدة؛ يشبه العفص الأمريكي)",
 "atlantides": "هسبيريديس ((الأساطير اليونانية) مجموعة من 3 إلى 7 حوريات حرسن التفاح الذهبي الذي أهدته غايا لحيرا كهدية زفاف)",
 "atlantis": "أَطْلَانْطِس",
