 "baseball league": "دوري البيسبول (دوري لفرق البيسبول)",
 "baseball manager": "مدرب بيسبول (مدرب لاعبي البيسبول)",
 "baseball mitt": "قفاز البيسبول (ما يرتديه لاعبو الدفاع في اليد عند لعب البيسبول)",
 "baseball play": "لعبة بيسبول ((بيسبول) لعبة ينفذها فريق بيسبول)",
 "baseball player": "لاعب بيسبول, لاعب كرة القاعدة (رياضي يلعب كرة القاعدة (البيسبول))",
 "baseball score": "نَتِيجَة البَيْسْبُول (النقاط المحرزة في مباراة البيسبول)",
 "baseball season": "موسم البيسبول (الموسم الذي تُلعب فيه كرة القاعدة)",
 "baseball swing": "أرجحة المضرب (في البيسبول؛ محاولة الضارب لضرب كرة مرمية)\nمثال: قام بأرجحة عنيفة للمضرب نحو الكرة",
 "baseball team": "فريق بيسبول (فريق يلعب البيسبول)",
 "baseboard": "إزار الحائط, وزرة (إطار يغطي المفصل المكون من الجدار والأرضية)",
 "baseborn": "دَنِيء النَّسَب, وَضِيع (مِن أَصْل غَيْر شَرْعِيّ أَوْ وَضيع) / مُتَوَاضِع الأَصْل, وَضِيع (من أصل متواضع أو مكانة دنيا)",
 "based": "ذُو قَاعِدَة, مُتَمَرْكِز (له قاعدة عمليات (يُستخدم غالبًا في التركيب)) / ذُو قَاعِدَة, مُرْتَكِز (له قاعدة يستند إليها)",
 "baseless": "لَا أَسَاس لَه, وَاهٍ (بدون أساس في العقل أو الواقع)",
 "baseline": "خط القاعدة (الخطوط التي يجب أن يتبعها لاعب البيسبول أثناء الجري بين القواعد) / الخط الخلفي, خط الإرسال (الخط الخلفي الذي يحد كل نهاية لملعب التنس أو كرة اليد؛ عند الإرسال يجب ألا يتجاوز المرسل هذا الخط) / خط أساس (خط وهمي أو معيار يتم من خلاله قياس الأشياء أو مقارنتها)\nمثال: أنشأوا خط أساس للميزانية",
 "basely": "بخسة, بنذالة (بطريقة حقيرة ودنيئة)\nمثال: هذا الزعيم الجديد يهدد بخسة أعمق قيم مجتمعنا",
 "basement": "قَبْوْ / سِرْدَاب / بَدْرُوم / بَدْرُون",
 "baseness": "حقارة, خسة (عدم الجدارة بسبب الافتقار إلى القيم العليا)",
 "basenji": "باسينجي (سلالة صغيرة ناعمة الشعر من أصل أفريقي لها ذيل مجعد بإحكام وعدم القدرة على النباح)",
 "bash": "خبطة, ضربة قوية (ضربة قوية) / حفلة صاخبة (حفلة صاخبة أو مليئة بالضجيج والمرح)\nمثال: الضربة المفاجئة طرحته أرضاً",
 "bashar": "بَشَّار",
 "bashful": "خَجُول",
 "bashfully": "بِاسْتِحْيَاء, بِخَجَل (بطريقة تتسم بالخجل أو التردد)\nمثال: ابتسم بخجل",
 "bashfulness": "خَجَل, حَيَاء (كلمة \"خَجِلَ\" تتراوح معانيها بين الحرج الشخصي والتأثر بالحمل أو البيئة، وتُستخدم في العديد من السياقات التي تعبر عن الاستحياء أو الحيرة؛ شعر بالخجل أو الحياء نتيجة لموقف محرج أو بسبب تصرف غير لائق)\nمثال: توم لص بلا خجل.",
 "bashi-bazouk": "باشبوزق",
 "bashir": "بَشِير",
 "bashkir": "اللغة البشكيرية",
 "bashkortostan": "بَاشْكُورْتُوسْتَان",
 "basic": "أَسَاسِيّ",
 "basic assumption": "افتراض أساسي, بديهية (افتراض أساسي لحجة ما)",
 "basic cognitive process": "عملية معرفية أساسية (العمليات المعرفية التي تنطوي على الحصول على المعرفة وتخزينها)",
 "basic color": "صبغة قاعدية (صبغة تعتبر قاعدة لأن الكروموفور (حامل اللون) هو جزء من أيون موجب)",
 "basic colour": "صبغة قاعدية (صبغة تعتبر قاعدة لأن الكروموفور (حامل اللون) هو جزء من أيون موجب)",
 "basic dye": "صبغة قاعدية (صبغة تعتبر قاعدة لأن الكروموفور (حامل اللون) هو جزء من أيون موجب)",
 "basic english": "الإنجليزية الأساسية, الإنجليزية المبسطة (شكل مبسط من اللغة الإنجليزية اقتُرح للاستخدام كلغة مساعدة للتواصل الدولي؛ وضعها سي كيه أوغدن وآي إيه ريتشاردز)",
 "basic form": "لِيمَّا ((في علم اللسانيات) الشكل المعجمي القانوني للكلمات التي تتشارك في المعنى عينه…)",
 "basic income": "راتب أساسي, دخل أساسي",
 "basic iron": "حديد قاعدي (حديد غفل يحتوي على نسبة عالية من الفوسفور؛ يستخدم في صنع الصلب بعملية تزيل الفوسفور)",
 "basic law": "النظام الأساسي",
 "basic point defense missile system": "نظام صواريخ الدفاع النقطي الأساسي (نظام صواريخ على متن السفن)",
 "basic price": "سعر أساسي (سعر سلعة أو خدمة، ناقصاً أي ضريبة مبيعات أو ضريبة قيمة مضافة يدفعها المشتري ومضافاً إليه أي دعم يتلقاه البائع)",
 "basic principle": "أساسيات, مبادئ أساسية (مبادئ يمكن استنتاج حقائق أخرى منها)\nمثال: أولاً يجب أن تتعلم الأساسيات",
 "basic slag": "خَبَث قاعدي (خبث ينتج في صناعة الصلب؛ منخفض السيليكا ولكنه يحتوي على كميات كبيرة من فوسفات الكالسيوم؛ مفيد كسماد)",
 "basic training": "تدريب أساسي (الفترة الأولية لتدريب الأفراد العسكريين الجدد؛ تتضمن نشاطاً بدنياً مكثفاً وانضباطاً سلوكياً)",
 "basically": "ببَسَاطَة",
 "basics": "أساسيات, مبادئ أساسية (مبادئ يمكن استنتاج حقائق أخرى منها) / أساسيات, مبادئ أولية (بيان بالحقائق أو المبادئ الأساسية)\nمثال: أولاً يجب أن تتعلم الأساسيات",
 "basidial": "دعامي (يتعلق بـ أو يتميز بالدعامات (في الفطريات))",
 "basidiocarp": "ثمرة دعامية (الجسم الثمري للفطريات الدعامية الذي يحمل أبواغه على خلايا خاصة)",
 "basidiolichen": "أشنة دعامية (أشنة يكون المكون الفطري فيها من الفطريات الدعامية)",
 "basidiomycete": "دِعَامِيّ",
 "basidiomycetous": "فطري دعامي (متعلق بـ أو من خصائص الفطريات من فئة الفطريات الدعامية)",
 "basidiomycetous fungi": "بازيديوميسيت, فطر دعامي (أي من الفطريات المختلفة من طويئفة الفطريات الدعامية)",
 "basidiospore": "بوغ دعامي (بوغ فطري منتج جنسيًا محمول على دعامة)",
 "basidiosporous": "بوغي دعامي (من أو متعلق بـ أو يتميز بالأبواغ التي تنتجها الدعامات)",
 "basidium": "دعامة (بنية صغيرة على شكل هراوة تحمل عادةً أربعة أبواغ دعامية في نهايات نتوءات دقيقة؛ تنفرد بها الفطريات الدعامية)",
 "basifixed": "قَاعِدِيّ التَّثْبِيت (مُثبَّت من قاعدته (كبعض المآبر على خيوطها أو سيقانها))",
 "basil": "رَيْحَان, حَبَق",
 "basil balm": "ريحان بلسمي, زعتر الريحان (نعناع أوروبي عطري له عناقيد من الزهور البنفسجية والبيضاء الصغيرة؛ مستوطن خاصة في شرق أمريكا الشمالية) / بلسم الريحان (عشب معمر من أمريكا الشمالية (من نيويورك إلى إلينوي وجبال ألاسكا) له أوراق عطرية وعناقيد من الكرات الوردية المصفرة)",
 "basil mint": "نعناع الريحان (عشب معمر من شرق الولايات المتحدة له زهور مخضرة غير بارزة وأوراق ضيقة عطرية جداً عند فركها)",
 "basil thyme": "ريحان بلسمي, زعتر الريحان (نعناع أوروبي عطري له عناقيد من الزهور البنفسجية والبيضاء الصغيرة؛ مستوطن خاصة في شرق أمريكا الشمالية)",
 "basilar": "قاعدي (من أو متعلق بـ أو يقع عند القاعدة)\nمثال: الغشاء القاعدي للقوقعة",
 "basilar artery": "شريان قاعدي (شريان غير مزدوج؛ يغذي الجسر والمخيخ والجزء الخلفي من المخ والأذن الداخلية)",
 "basilar membrane": "غشاء قاعدي (غشاء في القوقعة يدعم عضو كورتي)",
 "basilary": "قاعدي (من أو متعلق بـ أو يقع عند القاعدة)\nمثال: الغشاء القاعدي للقوقعة",
 "basileus": "باسيليوس (حاكم الإمبراطورية الرومانية الشرقية)",
 "basilic vein": "وريد باسلي (وريد يصرف ظهر اليد والساعد ويصب في الوريد الإبطي)",
 "basilica": "بازيليكا رومانية (مبنى روماني يستخدم للإدارة العامة) / بازيليكا (كنيسة مسيحية مبكرة مصممة مثل البازيليكا الرومانية؛ أو كنيسة رومانية كاثوليكية أو كاتدرائية مُنحت امتيازات معينة)\nمثال: تم رفع الكنيسة إلى رتبة بازيليكا",
 "basilican": "بازيليكي (من أو متعلق بـ أو يشبه البازيليكا)",
 "basilisk": "بَاسِلِيق, باسيليق / بَازِيلِيسْق",
 "basin": "طَشْت / حوض (حَوَّضَ: عمِل حوضًا؛ حَوَّضَ (الماءَ): حاضَه)\nمثال: ملأت الحوض ماءا.",
 "basin plug": "سدادة حوض (سدادة مخصصة لأحواض الغسيل وأحواض الاستحمام وحاويات المياه المماثلة)",
 "basinal": "حوضي (من أو متعلق بالحوض (الجيولوجي))\nمثال: رواسب حوضية",
 "basined": "مُحَوَّض (محاط داخل حوض)",
 "basinet": "خوذة باسنيت, خوذة فولاذية (خوذة فولاذية من العصور الوسطى)",
 "basinful": "ملء حوض, ملء طشت (الكمية التي يستوعبها حوض)\nمثال: ملء حوض من الماء",
 "basion": "قُوَيْعِدَة",
 "basipetal": "قَاعِدِيّ النُّمُوّ (للأوراق أو الزهور؛ تتطور أو تتفتح بتتابع من القمة إلى القاعدة)",
 "basis": "قَاعِدَة, أَسَاس",
 "basiscopic": "قَاعِدِيّ, مُتَّجِه نَحْو القَاعِدَة (مُواجه أو على الجانب المتجه نحو القاعدة)",
 "basivertebral vein": "وريد قاعدي فقري (واحد من عدة أوردة تصرف المادة الإسفنجية للفقرات وتصب في الضفيرة الوريدية الفقرية الداخلية الأمامية)",
 "basket": "سَلَّة",
 "basket ash": "مران أسود (شجرة أمريكية شمالية قوية الانتشار لها خشب ثقيل بني داكن؛ تتحول الأوراق إلى الذهب في الخريف)",
 "basket fern": "سرخس السلة (سرخس هوائي أو صخري عملاق؛ آسيا إلى بولينيزيا وأستراليا) / سرخس السلة, سرخس السيف المسنن (سرخس أمريكي استوائي يزرع لأوراقه الخضراء الرمادية المقسمة بدقة؛ جزر الهند الغربية وجنوب المكسيك إلى بيرو والبرازيل)",
 "basket fish": "نجم السلة (أي حيوان يشبه نجم البحر له أذرع نحيلة متفرعة بشكل معقد ومتشابكة تشع من قرص مركزي)",
 "basket flower": "زهرة السلة, قنطريون أمريكي (نبات سنوي في جنوب غرب الولايات المتحدة يزرع لرؤوس زهوره الأرجوانية وقناباته التي تشبه السلال الصغيرة)",
 "basket hilt": "مقبض السلة (مقبض سيف ذو واقٍ لليد على شكل سلة)",
 "basket maker": "صانع السلال (من الهنود الحمر الأوائل المرتبطين بشعب بويبلو؛ معروفون بمهارتهم في صنع السلال)",
 "basket oak": "سنديان البقر, سنديان السلال (شجرة نفضية متوسطة إلى كبيرة الحجم موطنها شرق الولايات المتحدة؛ يستخدم خشبها المتين كأخشاب بناء أو يُشطر ويُنسج في سلال أو مقاعد كراسي)",
 "basket rummy": "كاناستا (شكل من أشكال الرومي يستخدم رزمتين من الأوراق وأربعة جوكر؛ الجوكر والاثنين هما أوراق حرة؛ الهدف هو تشكيل مجموعات من نفس الرتبة)",
