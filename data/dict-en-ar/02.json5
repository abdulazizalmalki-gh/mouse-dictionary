 "ascii control character": "حرف تحكم (طَرَف وَجَانِب وَحَدّ؛ رَمْز مخطوط أو مطبوع يقوم مقام صوت أو كلمة أو عبارة أو معنى)\nمثال: ألف هو الحرف الأول للألف باء.",
 "ascites": "اِسْتِسْقَاء",
 "ascitic": "استسقائي (من أو متعلق بـ أو ناتج عن تراكم غير طبيعي للسوائل الغنية بالبروتين والكهارل في التجويف البريتوني)",
 "asclepia meadii": "صقلاب ميد (صقلاب من وسط أمريكا الشمالية؛ نوع مهدد بالانقراض)",
 "asclepiad": "عشبة اللبن, نبات الصقلاب",
 "asclepiadaceous": "صقلابي (من أو متعلق بنباتات الفصيلة الصقلابية)",
 "asclepias albicans": "صقلاب أبيض (عشب طويل بسيقان بيضاء شمعية بلا أوراق وزهور بيضاء تشبه النجوم؛ جنوب غرب الولايات المتحدة)",
 "asclepias curassavica": "زهرة الدم, صقلاب قرمزي (عشب استوائي له زهور برتقالية حمراء تليها قرون توحي بابتلاع بأجنحة مفرودة؛ عشب ضار في جميع أنحاء المناطق الاستوائية)",
 "asclepias exaltata": "صقلاب طويل (صقلاب من شرق الولايات المتحدة بأوراق تشبه أوراق الصبغة الأمريكية)",
 "asclepias incarnata": "صقلاب المستنقعات (نبات معمر كثيف التفرع من شرق الولايات المتحدة بزهور بيضاء إلى قرمزية أو أرجوانية)",
 "asclepias meadii": "صقلاب ميد (صقلاب من وسط أمريكا الشمالية؛ نوع مهدد بالانقراض)",
 "asclepias purpurascens": "صقلاب أرجواني, عشبة الحرير الأرجوانية (نبات معمر من شرق أمريكا الشمالية له زهور وردية أرجوانية)",
 "asclepias speciosa": "صقلاب استعراضي, صقلاب جميل (صقلاب من جنوب أمريكا الشمالية له زهور أرجوانية ووردية نجمية كبيرة)",
 "asclepias subverticillata": "صقلاب ذيل الحصان, صقلاب سام (صقلاب من جنوب غرب الولايات المتحدة والمكسيك؛ سام للماشية)",
 "asclepias tuberosa": "صقلاب درني, عشبة الفراشة (نبات معمر منتصب من شرق وجنوب الولايات المتحدة له زهور برتقالية بارزة)",
 "asclepias verticillata": "صقلاب دواري (صقلاب من شرق الولايات المتحدة بأوراق ضيقة في دوارات وزهور بيضاء مخضرة)",
 "asclepius": "أَسْقَلِيبِيُوس",
 "ascocarp": "ثمرة زقية (الجسم الثمري الناضج للفطريات الزقية)",
 "ascocarpous": "زقي الثمر (من أو متعلق بالثمار الزقية (في الفطريات))",
 "ascolichen": "أشنة زقية (أشنة يكون المكون الفطري فيها من الفطريات الزقية)",
 "ascoma": "أسكوما (ثمرة زقية تحتوي على طبقة الخلايا الحاملة للأبواغ (الهيمينيوم) على وعاء عريض يشبه القرص)",
 "ascomycete": "زِقِّيّ",
 "ascomycetous": "زقي (مرتبط بالفطريات الزقية أو يميزها)",
 "ascomycetous fungus": "فطر زقي (أي فطر من طائفة الفطريات الزقية (أو قسم الفطريات الزقية) تتكون فيه الأبواغ داخل زق)",
 "ascophyllum nodosum": "أسكوفيلوم عقدي (يشبه عشب الصخور الأسود ويوجد معه)",
 "ascorbic acid": "حمض الأسكوربيك, فيتامين ج (فيتامين يوجد في الفواكه الطازجة (خاصة الحمضيات) والخضروات؛ يمنع مرض الإسقربوط)",
 "ascospore": "بوغ زقي (بوغ فطري منتج جنسيًا يتكون داخل زق)",
 "ascosporic": "بوغي زقي (من أو متعلق بالأبواغ الزقية)",
 "ascosporous": "بوغي زقي (من أو متعلق بالأبواغ الزقية)",
 "ascot": "ربطة أسكوت (وشاح عنق بنهايات مربعة واسعة؛ يُثبت بدبوس زينة)",
 "ascribable": "رَاجِع إِلَى, قَابِل لِلنِّسْبَة (قابل للإسناد أو النسبة إلى شيء ما)",
 "ascribe": "نَسَبَ, عَزَا",
 "ascription": "إسناد, عزو (الإسناد إلى سبب أو مصدر) / إسباغ, إضفاء (تخصيص صفة أو طابع لشخص أو شيء)\nمثال: عزو البرق إلى تعبير عن غضب الرب",
