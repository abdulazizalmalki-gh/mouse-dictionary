 "basso relievo": "نقش بارز منخفض (نحت بارز تبرز فيه الأشكال قليلاً فقط عن الخلفية؛ ولا يتم قطع أي أشكال من الأسفل)",
 "basso rilievo": "نقش بارز منخفض (نحت بارز تبرز فيه الأشكال قليلاً فقط عن الخلفية؛ ولا يتم قطع أي أشكال من الأسفل)",
 "bassoon": "زمخر",
 "bassoonist": "عازف باسون (موسيقي يعزف على الباسون)",
 "basswood": "تليو, زيزفون (أي من الأشجار النفضية المختلفة من جنس الزيزفون ذات أوراق على شكل قلب وعناقيد سيمية متدلية من الزهور المصفرة غالباً ما تكون عطرة؛ ينتج العديد منها…) / خشب الزيزفون (خشب ناعم فاتح اللون لأي من أشجار الزيزفون المختلفة؛ يستخدم في صنع الصناديق وفي النحت وأعمال النجارة)",
 "bast": "لحاء ((علم النبات) نسيج يوصل المواد الغذائية المصنعة (مثل من الأوراق) إلى الأجزاء التي تحتاج إليها؛ يتكون أساسًا من الأنابيب الغربالية) / ألياف اللحاء, لحاء (ألياف خشبية قوية يتم الحصول عليها خاصة من اللحاء الداخلي لنباتات مختلفة)",
 "bast fiber": "ألياف اللحاء, لحاء (ألياف خشبية قوية يتم الحصول عليها خاصة من اللحاء الداخلي لنباتات مختلفة)",
 "bastard": "اِبْن زِنًى, بِنْت زِنًى (الولد الذكر)\nمثال: هو له ابن صغير.",
 "bastard feverfew": "أقحوان كاذب, بارثينيوم (عشب ضار حولي أمريكي استوائي برؤوس شعاعية صغيرة من الزهور البيضاء؛ وافد في جنوب الولايات المتحدة)",
 "bastard indigo": "نيلة كاذبة, نيلة كاليفورنية (شجيرة مشعرة قائمة إلى منتشرة من ساحل المحيط الهادئ للولايات المتحدة لها عناقيد من الزهور الحمراء إلى النيلية) / نيلة شجيرية, نيلة كاذبة (شجيرة كثيفة على ضفاف الأنهار الرطبة والسهول الفيضية في شرق الولايات المتحدة لها أوراق عطرة جذابة وعناقيد كثيفة من الزهور الأرجوانية الداكنة) / نيلة كاذبة (شجيرة من جزر الهند الشرقية)",
 "bastard lignum vitae": "جياك مقدس (شجرة صغيرة دائمة الخضرة في جنوب الولايات المتحدة وجزر الهند الغربية وهي مصدر لخشب الجياك)",
 "bastard pennyroyal": "نعناع كاذب (نبات عطري من شرق الولايات المتحدة)",
 "bastard pimpernel": "عشبة قشية (نبات عشبي له أوراق قصيرة جافة تشبه القش)",
 "bastard ridley": "لجأة أطلسية, لجأة كيمب (سلحفاة بحرية رمادية تعيش في سواحل المحيط الأطلسي والخليج في أمريكا الشمالية)",
 "bastard title": "العنوان الموجز (صفحة أولى في بعض الكتب تعرض فقط عنوان الكتاب)",
 "bastard toadflax": "كتان العلجوم الكاذب (طفيلي خشبي زاحف في غرب أمريكا الشمالية له أوراق مسحوقية سميكة عديدة وعناقيد من الزهور البيضاء الباهتة الصغيرة)",
 "bastard turtle": "لجأة أطلسية, لجأة كيمب (سلحفاة بحرية رمادية تعيش في سواحل المحيط الأطلسي والخليج في أمريكا الشمالية)",
 "bastard wing": "الجَنَاحُ الكَاذِب, جُنَيْح (خصلة من الريش الصغير الصلب على الإصبع الأول لجناح الطائر)",
 "bastard yellowwood": "أفروكاربوس منجلي, خشب أصفر شائع (شجرة متوسطة الحجم في جنوب أفريقيا)",
 "bastardisation": "إفساد, تشويه (فعل يحط من القدر أو يفسد)",
 "bastardised": "مُحَرَّف, مُهَجَّن (مُشْتَقّ من أكثر من مصدر أو أسلوب واحد)",
 "bastardization": "إفساد, تشويه (فعل يحط من القدر أو يفسد) / إعلان عدم الشرعية, نزع الشرعية (إعلان أو جعل (الطفل) غير شرعي)\nمثال: أدى إلغاء زواجهما إلى اعتبار أطفالهما غير شرعيين",
 "bastardized": "مُحَرَّف, مُهَجَّن (مُشْتَقّ من أكثر من مصدر أو أسلوب واحد)",
 "bastardly": "تَافِه, لَا قِيمَةَ لَه (عديم القيمة أو الأهمية) / لَقِيط, نَغْل (وُلِدَ خارِج إِطار الزَّواج الشَّرْعِيّ)",
