 "bedsit": "غرفة استديو, غرفة معيشة ونوم (غرفة جلوس مفروشة مع مرافق للنوم (وبعض السباكة))",
 "bedsitter": "غرفة استديو, غرفة معيشة ونوم (غرفة جلوس مفروشة مع مرافق للنوم (وبعض السباكة))",
 "bedsitting room": "غرفة استديو, غرفة معيشة ونوم (غرفة جلوس مفروشة مع مرافق للنوم (وبعض السباكة))",
 "bedsore": "قرحة الفراش (قرحة مزمنة في الجلد ناتجة عن الضغط المطول عليه)",
 "bedspread": "مِقْرَم",
 "bedspring": "زنبرك السرير ((عادة بصيغة الجمع) أحد الزنبركات التي تحمل مرتبة السرير)",
 "bedstead": "هَيْكَل سَرِير, مُلّة سَرِير",
 "bedstraw": "جويسئة, غاليوم",
 "bedtime": "وقت النوم (الوقت الذي تذهب فيه إلى الفراش)",
 "bedtime story": "قِصَّةٌ قَبْلَ النَوْمِ",
 "beduin": "بدوي (فرد من القبائل العربية الرحل)",
 "bedwetter": "بَوَّال فِي الْفِرَاش (شخص يعاني من سلس البول؛ شخص يتبول أثناء النوم في الفراش)",
 "bee": "نَحْلَة / نَحْل / نحل / نحلة / بِي",
 "bee balm": "ترنجان, عشبة الليمون (نعناع معمر كثيف من العالم القديم له أزهار بيضاء أو مصفرة صغيرة وأوراق عطرية بنكهة الليمون؛ هارب من الحدائق في شمال أوروبا وأمريكا الشمالية) / شاي أوسويغو, مونردة مزدوجة (عشب عطري معمر من شرق أمريكا الشمالية له زهور أنبوبية بألوان مختلفة في رؤوس بارزة كثيفة) / بلسم النحل, مونردة أنبوبية (عشب معمر من أمريكا الشمالية)",
 "bee beetle": "خنفساء النحل (خنفساء أوروبية؛ تغزو خلايا النحل)",
 "bee eater": "وروار (طائر ملون استوائي بشكل رئيسي من العالم القديم له طيران قوي رشيق؛ يتغذى خاصة على النحل)",
 "bee fly": "ذبابة النحل (ذبابة مشعرة آكلة للرحيق تشبه النحلة؛ يرقاتها طفيلية على يرقات النحل والحشرات ذات الصلة)",
 "bee house": "منحل (سقيفة تحتوي على عدد من خلايا النحل)",
 "bee killer": "ذبابة سارقة (ذبابة مفترسة سريعة لها جسم قوي يشبه النحلة مع خرطوم صلب لامتصاص عصارة الحشرات الأخرى التي يتم اصطيادها أثناء الطيران)",
 "bee moth": "عثة الشمع, عثة النحل (عثة تعيش يرقاتها وتتغذى في أقراص عسل النحل)",
 "bee orchid": "أوركيد النحل (أوركيد أوروبي تشبه زهوره النحل الطنان في الشكل واللون)",
 "bee sting": "لسعة النحل (لسعة تسببها نحلة)",
 "bee-eater": "وَرْوَار",
 "beebalm": "ترنجان, عشبة الليمون (نعناع معمر كثيف من العالم القديم له أزهار بيضاء أو مصفرة صغيرة وأوراق عطرية بنكهة الليمون؛ هارب من الحدائق في شمال أوروبا وأمريكا الشمالية) / شاي أوسويغو, مونردة مزدوجة (عشب عطري معمر من شرق أمريكا الشمالية له زهور أنبوبية بألوان مختلفة في رؤوس بارزة كثيفة) / بلسم النحل, مونردة أنبوبية (عشب معمر من أمريكا الشمالية)",
 "beebread": "خُبْز النَحْل (هو طعام يصنع من الدَقِيق الذي يعجن بالماء والخَمِيرَة ويُخْبَز في الفُرْن أو التَنُّور؛ خُبْز الغُراب: الفِطْر، ويسمى أيضا عُشّ الغُرَاب)\nمثال: هذا الخبز لذيذ.",
 "beech": "مُرَّان, زَان",
 "beech fern": "سرخس الزان (أي سرخس من جنس فيغوبتريس له سعف مثلث مقطع بعمق)",
 "beech marten": "دَلَق (صب وأراق؛ خرج سريعًا)",
 "beech tree": "زان, شجر الزان (أي من الأشجار النفضية الكبيرة المتعددة ذات تيجان مستديرة منتشرة ولحاء رمادي أملس ومكسرات مثلثة صغيرة حلوة صالحة للأكل محاطة بقشور؛ المناطق المعتدلة…)",
 "beechen": "زَانِيّ (مُكَوَّنٌ أَوْ مَصْنُوعٌ مِنْ خَشَبِ شَجَرَةِ الزَّانِ)",
 "beechnut": "جوز الزان (جوز مثلثي حلو صغير لأي من أشجار الزان المختلفة)",
 "beechwood": "خشب الزان (خشب أي من أشجار الزان المختلفة؛ يستخدم للأرضيات والحاويات والخشب الرقائقي ومقابض الأدوات)",
 "beef": "لَحْم بَقَر (ما يبقى من جسم الحيوان أو الإنسان بعد إزالة الجلد الأحشاء والعظم والشحم والدم والأعصاب. يتكون أساسا من العَضَلَات؛ ما يؤكل من لحم من الحيوان والطير والسمك عامة)\nمثال: أفضل لحم البقر.",
 "beef bourguignonne": "لحم بقر بورغينيون (لحم بقر وفطر وبصل مطهو ببطء في النبيذ الأحمر والتوابل)",
 "beef broth": "مرق اللحم البقري (مرق مصنوع من لحم البقر)",
 "beef burrito": "بوريتو اللحم (بوريتو بحشوة اللحم البقري)",
 "beef cattle": "أبقار اللحم, ماشية اللحم (الماشية التي تُربى من أجل لحومها)",
 "beef fondue": "فوندو اللحم البقري (مكعبات لحم بقر مطبوخة في زيت ساخن ثم تُغمس في صلصات لذيذة متنوعة)",
 "beef goulash": "جولاش اللحم البقري (يتم تحمير اللحم قبل طهيه كيخنة)",
 "beef jerky": "لحم بقر مجفف (شرائح من لحم البقر المجفف)",
 "beef loin": "خاصرة بقر, لوين بقري (قطعة لحم من خاصرة البقر)",
 "beef man": "مربي ماشية (رجل يربي (أو يرعى) الماشية)",
 "beef neck": "رقبة بقر (قطعة لحم بقر من رقبة الحيوان)",
 "beef patty": "شريحة برغر, شريحة لحم مفروم (قرص من اللحم البقري المفروم المطهو)",
 "beef plant": "إيريسين, نبات شريحة اللحم (نبات أمريكي جنوبي ذو فروع خضراء إلى أرجوانية أو حمراء بأوراق زينة خضراء إلى أرجوانية وسنابل من زهور صوفية غير مهمة بقنابات غشائية جافة)",
 "beef roast": "شواء بقري, لحم بقر للتحمير (قطعة من لحم البقر مناسبة للتحمير)",
 "beef stew": "يخنة لحم بقر (يخنة مصنوعة من لحم البقر)",
 "beef stock": "مرق اللحم البقري (مرق مصنوع من لحم البقر)",
 "beef stroganoff": "بيف ستروجانوف (شرائح لحم بقر مشوحة وفطر في صلصة القشدة الحامضة تقدم مع المعكرونة)",
 "beef tallow": "شحم البقر (شحم يتم الحصول عليه من حيوان بقري)",
 "beef tea": "شاي اللحم, مرق اللحم المركز (مستخلص اللحم البقري (يقدم للمرضى))",
 "beef tenderloin": "تندرلوين بقري (عضلة خاصرة البقر)",
 "beef tongue": "لسان بقر (لسان البقرة يؤكل كلحم)",
 "beef wellington": "بيف ولينغتون (فيليه لحم بقر مشوي قليلاً ومغطى بمعجون الفطر في عجينة بف باستري)",
 "beefalo": "بيفالو, كاتالو (سلالة قوية من الماشية ناتجة عن تهجين الماشية المستأنسة مع الجاموس الأمريكي؛ تنتج لحماً أقل دهناً من السلالات التقليدية)",
 "beefburger": "برغر, همبرغر (شطيرة تتكون من قرص مقلي من اللحم المفروم يُقدم في خبز كعك، وغالباً مع مكونات أخرى)",
 "beefcake": "صورة رجل مفتول العضلات (صورة لرجل مفتول العضلات بملابس قليلة)",
 "beefeater": "حارس ملكي (ضابط في الحرس الشخصي (المراسمي) للعاهل البريطاني)",
 "beefed-up": "مُعَزَّز, مُقَوًّى (جُعِل أكبر أو أقوى مما كان عليه)",
 "beefsteak": "بيف ستيك, شريحة لحم بقر (شريحة لحم بقر تطهى عادة بالشوي)",
 "beefsteak begonia": "بيغونيا الكلى, بيغونيا شريحة اللحم (بيغونيا جذمورية ذات أوراق لحمية مستديرة ملونة بالأحمر من الأسفل)",
 "beefsteak fungus": "فطر شريحة اللحم (فطر صالح للأكل شائع بقبعة بلون الكبد أو اللحم النيئ؛ وفير في جنوب شرق الولايات المتحدة)",
 "beefsteak geranium": "بيغونيا الملك, بيغونيا ريكس (أي من العديد من البيغونيا الهجينة الجذمورية عادةً المشتقة من نبات من جزر الهند الشرقية، لها أوراق خشنة الملمس منقوشة بالفضة والبرونز والأرجواني…)",
 "beefsteak morel": "فطر الدماغ, موريل شريحة اللحم (جيروميترا سام؛ سطح الجسم الخصب أملس في البداية ويصبح متموجاً ومجعداً تدريجياً (ولكن ليس محفوراً حقاً)؛ يتراوح اللون من الأصفر الباهت إلى البني)",
 "beefsteak plant": "إيريسين, نبات شريحة اللحم (نبات أمريكي جنوبي ذو فروع خضراء إلى أرجوانية أو حمراء بأوراق زينة خضراء إلى أرجوانية وسنابل من زهور صوفية غير مهمة بقنابات غشائية جافة) / بريلا, نبات شريحة اللحم (نبات يزرع لأوراقه الحمراء أو الأرجوانية الزخرفية)",
 "beefsteak tomato": "طماطم بيف ستيك (أي من عدة أنواع من الطماطم الكبيرة ذات اللب السميك)",
 "beefwood": "خشب اللحم (شجرة تنتج خشباً محمراً ثقيلاً صلباً) / خشب البقر المقشر (شجرة أو شجيرة طويلة ذات أوراق لامعة وخيمات من الزهور البيضاء الكريمية العطرة؛ تنتج خشباً محمراً ثقيلاً صلباً) / خشب البقر (أي من عدة أشجار أسترالية من جنس كزوارينا تنتج خشباً أحمر صلباً ثقيلاً يستخدم في النجارة) / خشب اللحم (أي من العديد من الأخشاب المحمرة الصلبة الثقيلة الاستوائية بشكل رئيسي؛ يستخدم بعضها للخزائن)",
 "beefy": "ضَخْمُ البِنْيَة, مَفْتُول (عضليّ وثقيل البنية)",
 "beehive": "خَلِيَّة, قَفِير",
 "beekeeper": "نَحَّال, عَسَّال",
 "beekeeping": "تربية النحل (تربية النحل على نطاق تجاري لإنتاج العسل)",
 "beeline": "خط مستقيم, طريق مباشر (الطريق الأكثر مباشرة)\nمثال: توجه مباشرة إلى الحمام",
 "beelzebub": "بَعْل زَبُوب, بَعْلْزَبُول (تزوجت المرأة، أو صار لها زوج؛ الرجل: شغف أو أحب زوجته كثيرًا)",
 "beep": "بيب, صفير (نغمة عالية قصيرة تصدر كإشارة أو تحذير)",
 "beeper": "بيجر, جهاز النداء (جهاز إلكتروني يولد سلسلة من الصفارات عندما يتم استدعاء الشخص الذي يحمله)",
 "beer": "بِيرَة, جِعَة",
 "beer barrel": "برميل بيرة (برميل يحمل البيرة)",
 "beer bottle": "زجاجة بيرة (زجاجة تحتوي على بيرة)",
 "beer can": "علبة بيرة (علبة تحتوي على بيرة)",
 "beer drinker": "شارب البيرة, شارب الجعة (شخص مشروبه المفضل هو الجعة (البيرة))",
 "beer garden": "حديقة البيرة (حانة بها منطقة خارجية (تشبه الحديقة عادة) حيث يتم تقديم البيرة والمشروبات الكحولية الأخرى)",
 "beer glass": "كأس بيرة (كأس كبير نسبياً لتقديم البيرة)",
 "beer hall": "قاعة البيرة (قاعة أو حانة تقدم البيرة و(عادة) الترفيه)",
 "beer keg": "برميل بيرة (برميل يحمل البيرة)",
 "beer maker": "خمّار, صانع البيرة (شخص يصنع البيرة من الشعير والجنجل والماء)",
 "beer mat": "قاعدة كوب البيرة (مفرش تقطير يوضع تحت كوب البيرة)",
 "beer mug": "كوب بيرة (كوب مخصص لتقديم البيرة)",
 "beer parlour": "صَالُون الْبِيرَة (مجلسٌ يجتمع فيه بعض أعيان المجتمع عند أحدهم يناقشون فيه أمور الأدب والفنّ؛ هو المَجْلِس في البيت الذي يستقبلون فيه الضيوف، يسمه البعض غرفة الضيوف أو غرفة الاستقبال أو غرفة الخطار. )\nمثال: لدى زيري صالون حلاقة.",
 "beersheba": "بئر السبع",
 "beery": "بِرَائِحَة البِيرَة (تَفُوح مِنْهُ رَائِحَة البِيرَة)",
 "beeswax": "شَمْع الْعَسَل ((شَمَعَ) يَشْمُعُ شَمْعًا، وشُمُوعًا: مَزَحَ وطَرِبَ)\nمثال: أشعل كين الشمع.",
 "beet": "شَمَنْدَر, بَنْجَر",
 "beet armyworm": "دودة حشد البنجر (يرقة عثة تأكل أوراق البنجر والخضروات الأخرى)",
 "beet blight": "لفحة البنجر (مرض يصيب نباتات البنجر)",
