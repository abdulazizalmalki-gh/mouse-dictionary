 "ataxy": "رنح, فقدان الانتظام الحركي (عدم القدرة على تنسيق الحركات العضلية الإرادية؛ حركات غير مستقرة ومشية مترنحة)",
 "atayalic": "لغة تاياليك (لغة يتحدث بها شعب ماليزي في فورموزا)",
 "atayalic language": "لغة تاياليك (لغة يتحدث بها شعب ماليزي في فورموزا)",
 "atelectasis": "انخماص الرئة (انهيار رئة متمددة (خاصة عند الرضع)؛ أو فشل الحويصلات الهوائية الرئوية في التوسع عند الولادة)",
 "ateleiosis": "تأخر النضج, قصر القامة (شكل من أشكال الطفالية يتميز بتخلف جسدي ولكن ذكاء طبيعي)",
 "ateleiotic": "متعلق بالقزامة المتناسقة (متعلق بالقزامة المتناسقة (عدم اكتمال النمو مع الحفاظ على التناسق))",
 "ateles geoffroyi": "سعدان عنكبوتي, قرد العنكبوت (قرد شجري يعيش في أمريكا الاستوائية، ذو أرجل طويلة نحيلة وذيل طويل قابض)",
 "atelier": "مَرْسَم",
 "ateliosis": "تأخر النضج, قصر القامة (شكل من أشكال الطفالية يتميز بتخلف جسدي ولكن ذكاء طبيعي)",
 "atenolol": "أتينولول, تينورمين (حاصر بيتا فموي (الاسم التجاري تينورمين) يستخدم في علاج ارتفاع ضغط الدم والذبحة الصدرية؛ له آثار جانبية ضارة (الاكتئاب وتفاقم فشل القلب الاحتقاني وما…)",
 "atf": "مكتب الكحول والتبغ والأسلحة النارية (وكالة إنفاذ القانون وتحصيل الضرائب التابعة لوزارة الخزانة التي تطبق القوانين الفيدرالية المتعلقة بمنتجات الكحول والتبغ والأسلحة النارية والمتفجرات…)",
 "athabascan": "أثاباسكان, اللغات الأثاباسكوية (مجموعة من لغات الهنود الحمر (صاغ الاسم عالم الأنثروبولوجيا الأمريكي إدوارد سابير)) / أثاباسكان (فرد من أي من مجموعات الهنود في أمريكا الشمالية الذين يتحدثون لغة أثاباسكانية ويعيشون في المناطق شبه القطبية من غرب كندا ووسط ألاسكا)",
 "athabaskan": "أثاباسكان, اللغات الأثاباسكوية (مجموعة من لغات الهنود الحمر (صاغ الاسم عالم الأنثروبولوجيا الأمريكي إدوارد سابير)) / أثاباسكان (فرد من أي من مجموعات الهنود في أمريكا الشمالية الذين يتحدثون لغة أثاباسكانية ويعيشون في المناطق شبه القطبية من غرب كندا ووسط ألاسكا)",
 "athanasian creed": "قانون الإيمان الأثناسيوسي (إعلان إيمان مسيحي)",
 "athanasianism": "أثناسيوسية (العقيدة اللاهوتية التي علمها أثناسيوس بأن المسيح الابن من نفس جوهر الله الآب)",
 "athanor": "أثانور, تنور الخيميائي (فرن يغذي نفسه ذاتياً للحفاظ على درجة حرارة ثابتة؛ كان يستخدمه الخيميائيون)",
 "athapascan": "أثاباسكان, اللغات الأثاباسكوية (مجموعة من لغات الهنود الحمر (صاغ الاسم عالم الأنثروبولوجيا الأمريكي إدوارد سابير)) / أثاباسكان (فرد من أي من مجموعات الهنود في أمريكا الشمالية الذين يتحدثون لغة أثاباسكانية ويعيشون في المناطق شبه القطبية من غرب كندا ووسط ألاسكا)",
 "athapaskan": "أثاباسكان, اللغات الأثاباسكوية (مجموعة من لغات الهنود الحمر (صاغ الاسم عالم الأنثروبولوجيا الأمريكي إدوارد سابير)) / أثاباسكان (فرد من أي من مجموعات الهنود في أمريكا الشمالية الذين يتحدثون لغة أثاباسكانية ويعيشون في المناطق شبه القطبية من غرب كندا ووسط ألاسكا)",
