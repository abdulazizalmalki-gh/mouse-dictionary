 "banded": "مَوْسُوم, مُحَلَّق (تم تعريفه بشريط خاصة حول الساق (للحيوانات)) / ذُو شَرِيط, مُخَطَّط (يتميز بشريط خاصة أبيض اللون حول الجسم) / مُخَطَّط بِأَشْرِطَة (مُعلَّم بأشرطة متباينة اللون أو الملمس)\nمثال: راقبوا عودة طيورهم الموسومة",
 "banded adder": "كرايت مخطط (كرايت بطيء الحركة مخطط بالأسود والأصفر)",
 "banded anteater": "آكل النمل المخطط, نمبات (جرابي أسترالي صغير ذو خطم طويل ومخالب قوية للتغذى على النمل الأبيض؛ مهدد بالانقراض)",
 "banded gecko": "وزغة مخططة (أي من عدة وزغات ذات أشرطة داكنة عبر الجسم وتختلف عن الوزغات النموذجية بامتلاكها جفوناً متحركة؛ من جنوب غرب الولايات المتحدة وساحل خليج فلوريدا)",
 "banded krait": "كرايت مخطط (كرايت بطيء الحركة مخطط بالأسود والأصفر)",
 "banded palm civet": "زباد النخيل المخطط (زباد من جزر الهند الشرقية)",
 "banded purple": "فراشة الأميرال الأبيض الأمريكية (فراشة من أمريكا الشمالية بأجنحة زرقاء سوداء يقطعها شريط أبيض عريض)",
 "banded rattlesnake": "أفعى جرسية خشبية (واسعة الانتشار في الأراضي الوعرة بشرق الولايات المتحدة)",
 "banded rudderfish": "سمكة الدفة (سمكة لها عادة تتبع السفن؛ توجد في المياه الساحلية لأمريكا الشمالية والجنوبية)",
 "banded sand snake": "ثعبان الرمل المخطط (ثعبان رمل من جنوب غرب الولايات المتحدة؛ يعيش في الرمل الناعم إلى الخشن أو التربة الطينية التي 'يسبح' فيها؛ يشبه تخطيطه الثعابين المرجانية)",
 "banded stilt": "أبو مغازل مطوق (أبو مغازل أسترالي مكفف القدمين ذو علامات صدرية بنية محمرة)",
 "banded water snake": "ثعبان الماء الشائع, ثعبان الماء المخطط (يُوضع في بعض التصنيفات في جنس نيروديا؛ ثعبان من غرب الولايات المتحدة نادراً ما يبتعد عن الماء)",
 "bandelet": "حلقة العمود (إطار زخرفي على شكل حلقة؛ في قمة العمود)",
 "bandelette": "حلقة العمود (إطار زخرفي على شكل حلقة؛ في قمة العمود)",
 "banderilla": "بانديريلا (سهم مزخرف يُغرز في عنق أو أكتاف الثور أثناء مصارعة الثيران)",
 "banderillero": "بانديريليرو, غارس السهام (مصارع الثيران الذي يغرس السهام المزخرفة (بانديريلاس) في رقبة أو كتفي الثور أثناء مصارعة الثيران)",
 "bandicoot": "بَنْدَقُوط",
 "bandicoot rat": "جرذ البندقوط (جرذ يحفر الجحور ذو ذيل حرشفي من الهند وسيلان)",
 "banding": "شريط, نطاق (زينة تتكون من شريط بلون أو مادة مغايرة) / تخطيط شريطي, تريط (شريط أو أشرطة ذات لون مغاير)\nمثال: تظهر الكروموسومات شرائط مميزة",
 "bandit": "قَاطِع طَرِيق",
 "banditry": "قطع الطريق, لصوصية (ممارسة النهب في عصابات)",
 "bandleader": "قائد فرقة راقصة (قائد فرقة موسيقى الرقص)",
 "bandlet": "حلقة العمود (إطار زخرفي على شكل حلقة؛ في قمة العمود)",
 "bandmaster": "قائد فرقة موسيقية (قائد فرقة موسيقية (وخاصة الفرق النحاسية أو العسكرية))",
 "bandoleer": "حزام ذخيرة, نطاق (حزام خراطيش عريض يرتديه الجنود فوق الكتف)",
 "bandolier": "حزام ذخيرة, نطاق (حزام خراطيش عريض يرتديه الجنود فوق الكتف)",
 "bandoneon": "باندونيون (نوع من الأكورديون (الكونسرتينا) شائع في أمريكا الجنوبية)",
 "bandsaw": "منشار شريطي (منشار لا نهائي يتكون من شريط معدني مسنن يُدار حول عجلتين)",
 "bandsman": "عازف فرقة (عازف ذكر في فرقة موسيقية (خاصة فرقة عسكرية))",
 "bandstand": "منصة الفرقة الموسيقية (منصة حيث يمكن لفرقة موسيقية (نحاسية) العزف في الهواء الطلق)",
 "bandswoman": "عازفة فرقة (عازفة أنثى في فرقة موسيقية (خاصة فرقة عسكرية))",
 "bandtail": "حمامة مطوقة الذيل (حمامة برية من غرب أمريكا الشمالية؛ غالباً ما يُخطأ بينها وبين الحمام المهاجر المنقرض الآن)",
 "bandung": "بَانْدُونْج",
 "bandura": "باندورا",
 "bandwagon": "عربة الفرقة الموسيقية (عربة كبيرة مزخرفة لحمل فرقة موسيقية) / تيار شعبي, ركوب الموجة (اتجاه شعبي يجذب دعماً متزايداً)\nمثال: قادت عربة الفرقة المبهرجة موكب السيرك",
 "bandwagon effect": "تأثير الانجراف, تأثير العربة (ظاهرة جذب اتجاه شائع لشعبية أكبر)\nمثال: في فترات نشاط الاندماج المرتفع، يحدث تأثير الانجراف مع سعي المزيد من الشركات للانخراط في نشاط الاستحواذ",
 "bandwidth": "عرض النطاق الترددي (معدل نقل البيانات؛ أقصى قدر من المعلومات (بايت/ثانية) يمكن نقلها عبر قناة)",
 "bandy": "أَفْحَج, مُقَوَّسُ السَّاقَيْن (ذُو سَاقَيْنِ تَنْحَنِيَانِ إِلَى الخَارِجِ عِنْدَ الرُّكْبَتَيْنِ)",
 "bandy leg": "ساق مقوسة, فحج (ساق منحنية للخارج عند الركبة (أو أسفل الركبة))",
 "bandy legs": "تقوس الساقين (انحناء الساقين للخارج)",
 "bandy-legged": "أَفْحَج, مُقَوَّسُ السَّاقَيْن (ذُو سَاقَيْنِ تَنْحَنِيَانِ إِلَى الخَارِجِ عِنْدَ الرُّكْبَتَيْنِ)",
 "bandyleg": "ساق مقوسة, فحج (ساق منحنية للخارج عند الركبة (أو أسفل الركبة))",
 "bane": "بلاء, لعنة (شيء يسبب البؤس أو الموت)\nمثال: لعنة حياتي",
 "baneberry": "أكتيا, نبات الراهب (نبات من جنس الأكتيا يحمل ثماراً لبية سامة وحريفة الطعم) / توت سام",
 "baneful": "مَشْؤُوم, وَبِيل (قاتل أو مُنْذِر بالشر) / فَتَّاك, مُهْلِك (بالغ الضرر إلى أقصى حدّ)",
 "banefully": "بِضَرَر بَالِغ, بِوَبَال (بطريقة ضارة ومؤذية)\nمثال: هذا المناخ المسموم بشكل ضار",
