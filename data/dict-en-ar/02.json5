 "ash-leaved maple": "قيقب مانيتوبا, قيقب مراني الأوراق (شجرة ظل شائعة في شرق ووسط الولايات المتحدة)",
 "ash-pan": "وعاء الرماد (وعاء يركب تحت المشبك يتجمع فيه الرماد ويتم إزالته)",
 "ashamed": "خَجْلَان, خَجُول",
 "ashamedly": "بِخَجَل (مع شعور بالخجل)",
 "ashanti pepper": "فلفل أشانتي, فلفل غينيا\nمثال: حتى في غرب أفريقيا، يعتبر فلفل أشانتي من التوابل باهظة الثمن ويستخدم باعتدال (حَبّ حريف يوضع في الطعام أو يطحن يستخدم كتابل. يكون منه أسود أو أبيض، حرارته متوسطة؛ فُلْفُل حَارّ: نبات ثمره حريف لونه أخضر وقد يحمرّ شديد الحرارة. يؤكل كما هو أو يجفف ويطحن ويستخدم كتابل)\nمثال: نحب الفلفل الحار.",
 "ashbin": "حاوية نفايات, سلة مهملات (حاوية تُحفظ فيها النفايات حتى يتم جمعها)",
 "ashcake": "كعكة الرماد (خبز ذرة ملفوف في أوراق الملفوف ويخبز في الرماد الساخن)",
 "ashcan": "حاوية نفايات, سلة مهملات (حاوية تُحفظ فيها النفايات حتى يتم جمعها)",
 "ashcan school": "مدرسة آشكان (رسم أمريكي في أوائل القرن العشرين؛ يصور مشاهد واقعية وبائسة لحياة المدينة) / مجموعة الثمانية, مدرسة آشكان (مجموعة من الرسامين الأمريكيين تأسست عام 1907 واشتهرت بتصويرها الواقعي للجوانب البائسة لحياة المدينة)",
 "ashdod": "أَسْدُود, إِسْدُود",
 "ashen": "شَاحِب, مُمْتَقَع (شاحب اللون كأنّه فاقد الدم؛ ذو مظهر مريض) / دَرْدَارِيّ (مَصْنُوعٌ مِنْ خَشَبِ شَجَرَةِ الدَّرْدَارِ)",
 "ashgabat": "عَشْق آبَاد (فرط الحب حتى لا يستطيع العاشق الابتعاد عن المعشوق)\nمثال: أغاني العشق تحرك مشاعري.",
 "ashkelon": "عَسْقَلَان",
 "ashkenazi": "أَشْكِنَازِيّ",
 "ashlar": "حجر منحوت, حجر مهذب (كتلة مستطيلة من الحجر المنحوت تستخدم لأغراض البناء)",
 "ashoka": "أَشُوكَا",
 "ashore": "إلى الشاطئ, براً (باتجاه الشاطئ قادماً من الماء)\nمثال: دعوناهم إلى الشاطئ",
 "ashram": "أشرم ((في الهند) مكان للخلوة الدينية للهندوس) / أشرم (مكان للخلوة الدينية مصمم على غرار الأشرم الهندي)",
 "ashtray": "مِنْفَضَة, طَفَّايَة",
 "ashura": "عَاشُورَاء",
 "ashwagandha": "اشواغاندا",
 "ashy": "رَمَادِيّ رَمَادِيّ, رَمَادِيّ فَاتِح (بلون رمادي فاتح كلون الرماد)",
 "asia": "آسِيَا, أسيا (إحدى القارات السبع؛ أكبرها مساحةً، وأكثرها سكانًا)\nمثال: على شعوب آسيا أن تتعاون.",
 "asia minor": "آسِيَا الصُّغْرَى (إحدى القارات السبع؛ أكبرها مساحةً، وأكثرها سكانًا)\nمثال: على شعوب آسيا أن تتعاون.",
 "asian": "آسِيَوِيّ / آسِيَوِيَّة",
 "asian american": "أمريكي آسيوي (أمريكي من أصل آسيوي)",
 "asian black grouse": "طيهوج أسود آسيوي (طيهوج أسود من غرب آسيا)",
 "asian coral snake": "ثعبان مرجاني آسيوي (من الهند)",
 "asian country": "دولة آسيوية (أي دولة من الدول التي تشغل القارة الآسيوية)",
 "asian crocodile": "تمساح آسيوي, تمساح المياه المالحة (تمساح مصبات الأنهار في شرق آسيا وجزر المحيط الهادئ)",
 "asian horseshoe crab": "سرطان حدوة الحصان الآسيوي (سرطان حدوة الحصان من ساحل شرق آسيا)",
 "asian influenza": "الإنفلونزا الآسيوية (إنفلونزا سببها الفيروس الآسيوي الذي تم عزله لأول مرة في عام 1957)",
 "asian longhorned beetle": "الخنفساء الآسيوية طويلة القرون (خنفساء من الصين وجدت في الولايات المتحدة وتشكل تهديداً للأشجار الصلبة؛ تعيش داخل الشجرة؛ ليس لها مفترسات طبيعية في الولايات المتحدة)",
 "asian nation": "دولة آسيوية (أي دولة من الدول التي تشغل القارة الآسيوية)",
 "asian shamanism": "شامانية, شامانية آسيوية (دين أرواحي في شمال آسيا يؤمن بأن الوساطة بين العالمين المرئي والروحي تتم بواسطة الشامان)",
 "asian tiger mosquito": "بعوضة النمر الآسيوية (موطنها اليابان ومخططة، تزدهر في جنوب غرب ووسط غرب الولايات المتحدة وتنتشر إلى منطقة البحر الكاريبي؛ ناقل محتمل لأمراض خطيرة)",
 "asian wild ox": "الثور البري الآسيوي (جنس من الثيران البرية الآسيوية)",
 "asiatic": "آسيوي (من أو يتعلق بآسيا أو شعوب آسيا أو لغاتهم أو ثقافتهم أو يميزهم) / آسيوي (مواطن أو ساكن في آسيا)\nمثال: دول آسيوية",
 "asiatic beetle": "خنفساء شرقية (أُدخلت إلى الولايات المتحدة من الشرق؛ تتغذى اليرقات على جذور قصب السكر وأعشاب أخرى)",
 "asiatic black bear": "دب أسود آسيوي (دب ذو معطف أسود يعيش في وسط وشرق آسيا)",
 "asiatic buffalo": "جاموس الماء (جاموس آسيوي غالباً ما يتم استئناسه لاستخدامه كحيوان جر)",
 "asiatic cholera": "كوليرا (عدوى معوية حادة ناجمة عن تناول مياه أو طعام ملوث)",
 "asiatic cockroach": "صرصور شرقي (صرصور بني داكن أصله من الشرق والآن عالمي الانتشار تقريباً)",
 "asiatic flu": "الإنفلونزا الآسيوية (إنفلونزا سببها الفيروس الآسيوي الذي تم عزله لأول مرة في عام 1957)",
 "asiatic flying squirrel": "سنجاب طائر آسيوي (قوارض ليلية من آسيا لها طيات فروية من الجلد بين الأرجل الأمامية والخلفية تمكنها من التحرك بقفزات انزلاقية)",
 "asiatic shrew mole": "خلد زبابي آسيوي (خلد زبابي من شرق آسيا)",
 "asiatic sweetleaf": "توت الياقوت, ورقة الحلوى الآسيوية (شجيرة متساقطة الأوراق من شرق آسيا تحمل ثماراً زرقاء زاهية للزينة)",
 "aside": "بصرف النظر, جانباً (غير مأخوذ في الاعتبار أو مستبعد) / ادِّخَارًا, جَانِبًا (في الاحتياط؛ ليس للاستخدام الفوري) / جَانِبًا (على أو إلى جانب واحد) / بَعِيدًا, جَانِبًا (بعيداً عن الطريق (خاصة بعيداً عن أفكار المرء))\nمثال: بصرف النظر عن هذه المشاكل، البلاد تبلي بلاءً حسناً",
 "asigmatic aorist": "أوريست لا سيجمي\nمثال: بمرور الوقت، أصبح الأوريست اللا سيجمي سمة لغوية قديمة وتم استبداله في النهاية بتشكيلتي الأوريست الأخريين",
 "asimina triloba": "باباو (شجرة صغيرة موطنها شرق الولايات المتحدة لها أوراق مستطيلة وفاكهة لحمية)",
 "asin": "أشفين (الشهر السابع من التقويم الهندوسي)",
 "asinine": "أَبْلَه, سَخِيف (أَحْمَق؛ غَبِيّ) / حِمَارِيّ\nمثال: لا تضحك على الأبله و المعوق.",
 "asininity": "غباوة (جودة الغباء المقترن بالعناد)",
 "asio otus": "بومة طويلة الأذن (بومة أوروبية نحيلة من الغابات الصنوبرية ذات خصلات أذن طويلة)",
 "ask": "سَأَلَ, سأل (اِسْتَعْلَمَ، اسْتَخْبَرَ؛ طَلَبَ، اِلْتَمَسَ)\nمثال: سأل توم عن هذا.",
 "ask for": "سَأَلَ, طَلَبَ (اِسْتَعْلَمَ، اسْتَخْبَرَ؛ طَلَبَ، اِلْتَمَسَ)\nمثال: سأل توم عن هذا.",
 "askance": "بِطَرْف العَيْن (بنظرة جانبية أو مائلة) / بِرِيبَة, بِشَكّ (مع الشك أو عدم الموافقة) / بِطَرْف العَيْن, مُنْحَرِف النَّظْرَة ((خَاصَّةً عَنِ النَّظَرَات) مُوَجَّه إِلَى جَانِبٍ بِشَكٍّ أَوِ ارْتِيَاب)\nمثال: لم تستدر تماماً للوراء لكنها نظرت إلي بطرف عينها بعينيها الداكنتين",
 "askant": "بِطَرْف العَيْن, مُنْحَرِف النَّظْرَة ((خَاصَّةً عَنِ النَّظَرَات) مُوَجَّه إِلَى جَانِبٍ بِشَكٍّ أَوِ ارْتِيَاب)",
 "asker": "سَائِل",
 "askew": "مَائِلًا, مُنْحَرِفًا (مقلوب أو ملتو إلى جانب واحد) / مَائِل, مُنْحَرِف (ملتوٍ أو مائل نحو جانب واحد)\nمثال: سجاد ملقى بشكل مائل",
 "asking": "سؤال, طلب (الفعل اللفظي للطلب)",
 "asking price": "سِعْر طَلَب (سَعِرَ يَسْعَرَ سَعَراً، وسُعْرَةً: ضرب لونه إِلى السواد فُوَيْقَ الأُدْمة؛ فهو أَسْعَرُ، وهي سَعْراءُ. والجمع: سُعْرٌ)\nمثال: إتفقوا على سعر.",
 "asl": "لغة الإشارة الأمريكية (لغة الإشارة المستخدمة في الولايات المتحدة)",
 "aslant": "بِانْحِرَاف, بِمَيْل (بزاوية مائلة) / بِمَيْل (فوق أو عبر في اتجاه مائل) / قُطْرِيّ, مَائِل (ذو اتِّجاه مائل أو منحرف عن الأفق)\nمثال: سطعت الشمس بميل على وجهه",
 "asleep": "نَائِم",
 "aslope": "قُطْرِيّ, مَائِل (ذو اتِّجاه مائل أو منحرف عن الأفق)",
 "asmara": "أَسْمَرَة",
 "asmr": "إيسمار, استجابة الزوال الحسية الذاتية (تجربة مبتهجة تتميز بإحساس بالوخز يشبه الكهرباء الساكنة على الجلد يبدأ عادةً في فروة الرأس وينتقل إلى أسفل الرقبة والعمود الفقري العلوي، مما يعجل…)",
 "asocial": "مُعَادٍ لِلْمُجْتَمَع (معادٍ للمعايير الاجتماعيّة السليمة أو مخلّ بها) / لَا اجْتِمَاعِيّ, نَفُور (يميل إلى تجنّب الاختلاط بالآخرين)",
 "asp": "صِل, كوبرا مصرية (كوبرا استخدمها الفراعنة كرمز لقوتهم على الحياة والموت) / أفعى أوروبية (من جنوب أوروبا؛ تشبه الأفعى الشائعة ولكنها أصغر)",
 "asp viper": "أفعى أوروبية (من جنوب أوروبا؛ تشبه الأفعى الشائعة ولكنها أصغر)",
 "aspalathus cedcarbergensis": "رويبوس, شاي أحمر (شجيرة من جنوب أفريقيا ذات أوراق مسطحة مدببة وأزهار صفراء؛ الأوراق عطرية عند التجفيف وتستخدم لصنع شاي عشبي)",
 "aspalathus linearis": "رويبوس, شاي أحمر (شجيرة من جنوب أفريقيا ذات أوراق مسطحة مدببة وأزهار صفراء؛ الأوراق عطرية عند التجفيف وتستخدم لصنع شاي عشبي)",
 "asparaginase": "أسباراجيناز, إلسبار (دواء مضاد للأورام (الاسم التجاري إلسبار) يستخدم أحياناً لعلاج سرطان الدم الليمفاوي)",
 "asparagine": "أسباراجين (حمض أميني بلوري يوجد في البروتينات وفي العديد من النباتات (مثل الهليون))",
 "asparagus": "هِلْيُون, هِلْيَوْن",
 "asparagus asparagoides": "فصة, هليون ناعم (نبات ملتف رقيق من جنوب أفريقيا ذو سيقان مسطحة خضراء زاهية وأوراق لامعة، شائع كزينة زهرية)",
 "asparagus bean": "فاصولياء الهليون, فاصولياء طويلة (فاصولياء من أمريكا الجنوبية لها قرون عصارية طويلة جداً)",
 "asparagus bed": "حوض الهليون (حوض ينمو فيه الهليون)",
 "asparagus fern": "سرخس الهليون, هليون ناعم (نبات يشبه السرخس موطنه جنوب أفريقيا)",
 "asparagus officinalis": "أسبرجس, هليون (نبات تُطهى براعمه الصغيرة الغضة وتؤكل كخضروات)",
 "asparagus pea": "بازلاء مجنحة, لوتس (نبات حولي أوروبي مترامي الأطراف له قرن صالح للأكل ذو 4 أجنحة)",
 "asparagus plumosus": "سرخس الهليون, هليون ناعم (نبات يشبه السرخس موطنه جنوب أفريقيا)",
 "asparagus setaceous": "سرخس الهليون, هليون ناعم (نبات يشبه السرخس موطنه جنوب أفريقيا)",
 "aspartame": "أسبارتام (مُحلي صناعي مصنوع من حمض الأسبارتيك؛ يستخدم كمُحلي خالي من السعرات الحرارية)",
 "aspartic acid": "حمض الأسبارتيك (حمض أميني بلوري يوجد في البروتينات ويوجد طبيعياً في بنجر السكر وقصب السكر)",
 "aspect": "تعبير, ملامح (المشاعر الظاهرة على وجه الشخص) / جانب, ناحية (خاصية أو جانب يجب أخذه بعين الاعتبار) / جانب, وجه (ميزة أو عنصر متميز في مشكلة ما) / إطلالة, مشهد (المُدرَك البصري لمنطقة ما)\nمثال: تعبير حزين",
 "aspect ratio": "نِسْبَة العَرْض إِلَى الِارْتِفَاع (نسبة العرض إلى الارتفاع لصورة التلفزيون)",
 "aspectual": "جهي, مظهري (متعلق أو منتمي إلى الجهة (كجهة الفعل))\nمثال: نظام الجهة في اللغة اليونانية",
