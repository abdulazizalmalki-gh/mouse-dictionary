 "atmospheric condition": "أحوال جوية, طقس (الظروف الجوية التي تشكل حالة الغلاف الجوي من حيث درجة الحرارة والرياح والسحب والهطول)\nمثال: كانوا يأملون في طقس جيد",
 "atmospheric electricity": "كهرباء جوية (تفريغ كهربائي في الغلاف الجوي)",
 "atmospheric phenomenon": "ظاهرة جوية (ظاهرة فيزيائية مرتبطة بالغلاف الجوي)",
 "atmospheric pressure": "ضغط جوي",
 "atmospheric state": "جو, حالة الغلاف الجوي (الطقس أو المناخ في مكان ما)\nمثال: كان الجو كثيفاً بالضباب",
 "atmospheric static": "تشويش جوي, ستاتيك (ضوضاء طقطقة أو هسهسة ناجمة عن تداخل كهربائي)",
 "atmospherical": "جوي, غلافي جوي (متعلق بالغلاف الجوي أو يقع فيه)\nمثال: اختبارات جوية",
 "atmospherics": "تشويش جوي, ستاتيك (ضوضاء طقطقة أو هسهسة ناجمة عن تداخل كهربائي)",
 "atole": "أتولي (يؤكل كعصيدة أو حساء رقيق)",
 "atoll": "جزيرة مرجانية (جزيرة تتكون من شعاب مرجانية دائرية تحيط ببحيرة شاطئية)",
 "atom": "ذَرَّة",
 "atom bomb": "قنبلة ذرية, قنبلة نووية (سلاح نووي يتم فيه إطلاق طاقة هائلة عن طريق الانشطار النووي (شطر نوى عنصر ثقيل مثل اليورانيوم 235 أو البلوتونيوم 239))",
 "atom smasher": "مسرع, مسرع جسيمات (أداة علمية تزيد من الطاقة الحركية للجسيمات المشحونة)",
 "atomic": "نَوَوِيّ / ذَرِّيّ",
 "atomic age": "عصر الذرة (مصدر للفعل \"عَصَرَ\"؛ أي مدة زمنية، دهر من الوقت)\nمثال: صلى زيري العصر.",
 "atomic bomb": "قُنْبُلَة ذَرِّيَّة",
 "atomic clock": "سَاعَة ذُرِّيَّة (ثُلْث ثُمْن اليَوْم بمعنى مجموع النَهَار واللَيْل، أي جزء من أربعة وعشرين جزءا من مجموع النهار والليل وتتكون من ستين دَقِيقَة؛ الوَقْت الحاضر، الآن)\nمثال: درست لمدة ساعة.",
 "atomic cocktail": "كوكتيل ذري (جرعة فموية من مادة مشعة تستخدم في علاج وتشخيص السرطان)",
 "atomic energy": "طاقة ذرية, طاقة نووية (الطاقة المنبعثة من تفاعل نووي)",
 "atomic energy commission": "لجنة الطاقة الذرية (وكالة تنفيذية سابقة (من 1946 إلى 1974) كانت مسؤولة عن الأبحاث في الطاقة الذرية واستخداماتها السلمية في الولايات المتحدة)",
 "atomic explosion": "انفجار ذري, انفجار نووي (انفجار قنبلة ذرية)",
 "atomic mass": "كتلة ذرية, وزن ذري ((في الكيمياء) كتلة ذرة عنصر كيميائي معبر عنها بوحدات الكتلة الذرية)",
 "atomic mass unit": "وحدة كتلة ذرية (وحدة كتلة للتعبير عن كتل الذرات أو الجزيئات)",
 "atomic nucleus": "نَوَاة الذَّرَّة",
 "atomic number": "عَدَد ذَرِّيّ (مِقْدَار مَا يُعَدّ)\nمثال: كم عدد سكان الجزائر؟",
 "atomic number 1": "هيدروجين (عنصر لافلزي أحادي التكافؤ يكون عادة غازاً ثنائي الذرة عديم اللون والرائحة وسريع الاشتعال؛ أبسط وأخف العناصر وأكثرها وفرة في الكون)",
 "atomic number 10": "نيون (عنصر غازي عديم اللون والرائحة يعطي توهجاً أحمر في أنبوب التفريغ؛ أحد الغازات الخاملة الستة)",
 "atomic number 100": "فيرميوم (عنصر فلزي مشع ما بعد اليورانيوم يتم إنتاجه بقصف البلوتونيوم بالنيوترونات)",
 "atomic number 101": "مندليفيوم (عنصر مشع ما بعد اليورانيوم يتم تصنيعه بقصف الأينشتاينيوم بجسيمات ألفا)",
 "atomic number 102": "نوبليوم (عنصر مشع ما بعد اليورانيوم يتم تصنيعه بقصف الكوريوم بأيونات الكربون؛ هناك 7 نظائر معروفة له)",
 "atomic number 103": "لورنسيوم (عنصر مشع ما بعد اليورانيوم يتم تصنيعه من الكاليفورنيوم)",
 "atomic number 104": "رذرفورديوم (عنصر مشع ما بعد اليورانيوم تم تصنيعه)",
 "atomic number 105": "دوبنيوم (عنصر ما بعد اليورانيوم عدده الذري 105)",
 "atomic number 106": "سيبورجيوم (عنصر ما بعد اليورانيوم عدده الذري 106)",
 "atomic number 107": "بوريوم (عنصر ما بعد اليورانيوم عدده الذري 107)",
 "atomic number 108": "هاسيوم (عنصر مشع ما بعد اليورانيوم، عدده الذري 108)",
 "atomic number 109": "مايتنريوم (عنصر مشع ما بعد اليورانيوم، عدده الذري 109)",
 "atomic number 11": "صوديوم (عنصر فلزي شمعي فضي ناعم من مجموعة الفلزات القلوية؛ يحترق بلهب أصفر ويتفاعل بعنف في الماء)",
 "atomic number 110": "دارمشتاتيوم (عنصر مشع ما بعد اليورانيوم، عدده الذري 110)",
 "atomic number 111": "رونتجينيوم (عنصر مشع ما بعد اليورانيوم، عدده الذري 111)",
 "atomic number 112": "أنون بيوم, كوبرنيسيوم (عنصر مشع ما بعد اليورانيوم، عدده الذري 112)",
 "atomic number 113": "أنون تريوم, نيهونيوم (عنصر مشع ما بعد اليورانيوم، عدده الذري 113)",
 "atomic number 114": "أنون كواديوم, فليروفيوم (عنصر مشع ما بعد اليورانيوم، عدده الذري 114)",
 "atomic number 115": "أنون بنتيوم, موسكوفيوم (عنصر مشع ما بعد اليورانيوم، عدده الذري 115)",
 "atomic number 116": "أنون هيكسيوم, ليفرموريوم (عنصر مشع ما بعد اليورانيوم، عدده الذري 116)",
 "atomic number 12": "مغنيسيوم (عنصر فلزي خفيف فضي أبيض قابل للسحب ثنائي التكافؤ)",
 "atomic number 13": "ألومنيوم (عنصر فلزي فضي قابل للسحب يوجد أساساً في البوكسيت)",
 "atomic number 14": "سيليكون (عنصر لا فلزي رباعي التكافؤ؛ بعد الأكسجين هو العنصر الأكثر وفرة في قشرة الأرض؛ يوجد في الطين والفلسبار والجرانيت والكوارتز والرمل؛ يستخدم كشبه موصل في…)",
 "atomic number 15": "فوسفور (عنصر لافلزي متعدد التكافؤ من عائلة النيتروجين يحدث عادة في صخور الفوسفات غير العضوية وكفوسفات عضوية في جميع الخلايا الحية)",
 "atomic number 16": "كبريت (عنصر لافلزي وفير عديم الطعم والرائحة متعدد التكافؤ؛ يشتهر ببلوراته الصفراء)",
 "atomic number 17": "كلور (عنصر لافلزي شائع ينتمي إلى الهالوجينات؛ يشتهر كغاز سام أصفر ثقيل مهيج)",
 "atomic number 18": "أرجون (غاز خامل عديم اللون والرائحة؛ أحد الغازات الخاملة الستة؛ يشكل حوالي 1٪ من الغلاف الجوي للأرض)",
 "atomic number 19": "بوتاسيوم (عنصر فلزي خفيف ناعم فضي-أبيض من مجموعة الفلزات القلوية؛ يتأكسد بسرعة في الهواء ويتفاعل بعنف مع الماء)",
 "atomic number 2": "هيليوم (عنصر خفيف جداً عديم اللون وهو أحد الغازات الخاملة الستة؛ أصعب الغازات تسييلاً)",
 "atomic number 20": "كالسيوم (عنصر فلزي أبيض يحترق بضوء ساطع؛ خامس أكثر العناصر وفرة في القشرة الأرضية)",
 "atomic number 21": "سكانديوم (عنصر فلزي أبيض ثلاثي التكافؤ؛ يصنف أحياناً في مجموعة الأتربة النادرة)",
 "atomic number 22": "تيتانيوم (عنصر فلزي رمادي لامع قوي خفيف الوزن ومقاوم للتآكل يستخدم في السبائك القوية خفيفة الوزن)",
 "atomic number 23": "فاناديوم (عنصر فلزي سام فضي أبيض ناعم يستخدم في سبائك الصلب)",
 "atomic number 24": "كروم, كروميوم (عنصر فلزي صلب هش متعدد التكافؤ؛ مقاوم للتآكل وفقدان البريق)",
 "atomic number 25": "منجنيز (عنصر فلزي رمادي صلب هش متعدد التكافؤ يشبه الحديد ولكنه ليس مغناطيسياً)",
 "atomic number 26": "حديد (عنصر فلزي مغناطيسي ثقيل قابل للسحب؛ فضي أبيض في شكله النقي ولكنه يصدأ بسهولة)",
 "atomic number 27": "كوبالت (عنصر فلزي صلب مغناطيسي فضي-أبيض ثنائي أو ثلاثي التكافؤ)",
 "atomic number 28": "نيكل (عنصر فلزي فضي صلب قابل للطرق والسحب مقاوم للتآكل)",
 "atomic number 29": "نحاس (عنصر معدني بني محمر قابل للسحب والطرق ومقاوم للتآكل ومغناطيسي معاكس؛ يوجد في معادن مختلفة ولكنه المعدن الوحيد الذي يوجد بكثرة في كتل كبيرة؛ يستخدم…)",
 "atomic number 3": "ليثيوم (عنصر فضي أبيض ناعم أحادي التكافؤ من مجموعة الفلزات القلوية؛ أخف معدن معروف)",
 "atomic number 30": "خارصين, زنك (عنصر فلزي لامع أبيض مزرق؛ هش في درجات الحرارة العادية ولكنه قابل للطرق عند تسخينه)",
 "atomic number 31": "غاليوم (عنصر فلزي فضي نادر (عادة ما يكون ثلاثي التكافؤ)؛ سائل فوق درجة حرارة الغرفة)",
 "atomic number 32": "جرمانيوم (عنصر بلوري رمادي هش وهو شبه فلز شبه موصل (يشبه السيليكون) يستخدم في الترانزستورات؛ يوجد في الجرمانيت والأرجيروديت)",
 "atomic number 33": "زرنيخ (عنصر فلزي سام جداً له ثلاثة أشكال تآصلية؛ يستخدم الزرنيخ ومركباته كمبيدات للأعشاب والحشرات)",
 "atomic number 34": "سيلينيوم (عنصر لافلزي سام مرتبط بالكبريت والتيلوريوم؛ يوجد في عدة أشكال تآصلية)",
 "atomic number 35": "بروم (عنصر سائل لافلزي ثقيل متطاير ذو لون بني داكن ينتمي للهالوجينات؛ يوجد في مياه البحر)",
 "atomic number 36": "كريبتون (عنصر عديم اللون وهو أحد الغازات الخاملة الستة؛ يوجد بكميات ضئيلة في الهواء)",
 "atomic number 37": "روبيديوم (عنصر فلزي فضي ناعم من مجموعة الفلزات القلوية؛ يحترق في الهواء ويتفاعل بعنف في الماء)",
 "atomic number 38": "سترونتيوم (عنصر فلزي ناعم فضي-أبيض أو مصفر من مجموعة الفلزات القلوية الترابية؛ يتحول لونه للأصفر في الهواء)",
 "atomic number 39": "إيتريوم (عنصر فلزي فضي شائع في معادن الأتربة النادرة؛ يستخدم في سبائك المغنيسيوم والألومنيوم)",
 "atomic number 4": "بيريليوم (عنصر فلزي ثنائي التكافؤ سام رمادي خفيف وقوي وهش)",
 "atomic number 40": "زركونيوم (عنصر فلزي قوي رمادي لامع يشبه التيتانيوم؛ يستخدم في المفاعلات النووية كممتص للنيوترونات)",
 "atomic number 41": "نيوبيوم (عنصر فلزي رمادي ناعم قابل للسحب يستخدم في السبائك؛ كان يسمى سابقاً كولومبيوم)",
 "atomic number 42": "موليبدنوم (عنصر فلزي متعدد التكافؤ يشبه الكروم والتنجستن في خصائصه)",
 "atomic number 43": "تكنيشيوم (عنصر فلزي بلوري لا يوجد في الطبيعة؛ يحدث كأحد نواتج انشطار اليورانيوم)",
 "atomic number 44": "روثينيوم (عنصر فلزي نادر متعدد التكافؤ من مجموعة البلاتين)",
 "atomic number 45": "روديوم (عنصر فلزي صلب أبيض من مجموعة البلاتين ويوجد في خامات البلاتين)",
 "atomic number 46": "بالاديوم (عنصر فلزي فضي-أبيض من مجموعة البلاتين يشبه البلاتين)",
 "atomic number 47": "فضة (عنصر معدني أبيض ناعم وثمين وأحادي التكافؤ له أعلى موصلية كهربائية وحرارية من أي معدن؛ يوجد في الأرجنتيت وفي شكل حر؛ يستخدم في العملات المعدنية…)",
 "atomic number 48": "كادميوم (عنصر فلزي ثنائي التكافؤ سام ناعم أبيض مزرق قابل للطرق والسحب)",
 "atomic number 49": "إنديوم (عنصر فلزي فضي ناعم نادر)",
 "atomic number 5": "بورون (عنصر شبه فلزي ثلاثي التكافؤ؛ يوجد في شكل بلوري أسود صلب وفي شكل مسحوق أصفر أو بني)",
 "atomic number 50": "قصدير (عنصر فلزي فضي قابل للطرق ومقاوم للتآكل؛ يستخدم في العديد من السبائك ولطلاء المعادن الأخرى لمنع التآكل)",
 "atomic number 51": "أنتيمون, إثمد (عنصر فلزي له أربعة أشكال تآصلية؛ يستخدم في مجموعة واسعة من السبائك)",
 "atomic number 52": "تيلوريوم (عنصر شبه فلزي هش فضي-أبيض مرتبط بالسيلينيوم والكبريت)",
 "atomic number 53": "يود (عنصر لافلزي ينتمي إلى الهالوجينات؛ يستخدم خاصة في الطب والتصوير الفوتوغرافي وفي الأصباغ)",
 "atomic number 54": "زينون (عنصر غازي خامل عديم اللون والرائحة يوجد في الغلاف الجوي للأرض بكميات ضئيلة)",
 "atomic number 55": "سيزيوم (عنصر فلزي ناعم فضي أبيض قابل للسحب (سائل في درجات الحرارة العادية))",
 "atomic number 56": "باريوم (عنصر فلزي فضي ناعم من مجموعة الأتربة القلوية)",
 "atomic number 57": "لانثانوم (عنصر فلزي ناعم أبيض يفقد بريقه بسهولة؛ عادة ما يصنف ضمن الأتربة النادرة)",
 "atomic number 58": "سيريوم (عنصر فلزي رمادي قابل للسحب من سلسلة اللنثانيدات)",
 "atomic number 59": "براسيوديميوم (عنصر فلزي ناعم أبيض مصفر ثلاثي التكافؤ من مجموعة الأتربة النادرة)",
 "atomic number 6": "كربون (عنصر لافلزي وفير رباعي التكافؤ يوجد في ثلاثة أشكال تآصلية: الكربون غير المتبلور والجرافيت والماس)",
 "atomic number 60": "نيوديميوم (عنصر فلزي أصفر ثلاثي التكافؤ من مجموعة الأتربة النادرة)",
 "atomic number 61": "بروميثيوم (عنصر فلزي فضي ناعم من مجموعة الأتربة النادرة ليس له نظير مستقر)",
 "atomic number 62": "ساماريوم (عنصر فلزي رمادي لامع من مجموعة الأتربة النادرة)",
 "atomic number 63": "يوروبيوم (عنصر فلزي ثنائي وثلاثي التكافؤ من مجموعة الأتربة النادرة)",
 "atomic number 64": "جادولينيوم (عنصر فلزي ثلاثي التكافؤ مغناطيسي قابل للسحب ولونه فضي أبيض من مجموعة الأتربة النادرة)",
 "atomic number 65": "تيربيوم (عنصر فلزي من مجموعة الأتربة النادرة؛ يستخدم في الليزر)",
 "atomic number 66": "ديسبروسيوم (عنصر فلزي ثلاثي التكافؤ من مجموعة الأتربة النادرة؛ يشكل مركبات مغناطيسية للغاية)",
 "atomic number 67": "هولميوم (عنصر فلزي ثلاثي التكافؤ من مجموعة الأتربة النادرة؛ يشكل مركبات مغناطيسية للغاية)",
 "atomic number 68": "إيربيوم (عنصر فلزي ثلاثي التكافؤ من مجموعة الأتربة النادرة)",
 "atomic number 69": "ثوليوم (عنصر فلزي فضي ناعم من مجموعة الأتربة النادرة)",
 "atomic number 7": "نيتروجين (عنصر لافلزي شائع يكون عادةً غازاً ثنائي الذرة عديم اللون والرائحة والطعم؛ يشكل 78 في المائة من الغلاف الجوي من حيث الحجم)",
 "atomic number 70": "إيتربيوم (عنصر فلزي فضي ناعم؛ من أتربة اللنثانيدات النادرة)",
 "atomic number 71": "لوتيشيوم (عنصر فلزي ثلاثي التكافؤ من مجموعة الأتربة النادرة)",
 "atomic number 72": "هافنيوم (عنصر فلزي رمادي رباعي التكافؤ يشبه الزركونيوم كيميائياً)",
 "atomic number 73": "تانتالوم (عنصر فلزي رمادي صلب لامع مقاوم للتآكل بشدة)",
 "atomic number 74": "تنجستن, ولفرام (عنصر فلزي ثقيل رمادي-أبيض؛ يستخدم الشكل النقي منه بشكل أساسي في التطبيقات الكهربائية)",
 "atomic number 75": "رينيوم (عنصر فلزي ثقيل نادر متعدد التكافؤ يشبه المنجنيز كيميائياً)",
 "atomic number 76": "أوزميوم (عنصر فلزي صلب هش أزرق-رمادي أو أزرق-أسود وهو أحد معادن البلاتين؛ أثقل معدن معروف)",
 "atomic number 77": "إيريديوم (عنصر فلزي ثقيل هش من مجموعة البلاتين)",
 "atomic number 78": "بلاتين, بلاتينوم (عنصر فلزي ثمين ثقيل؛ رمادي أبيض ومقاوم للتآكل)",
 "atomic number 79": "ذهب (عنصر فلزي ناعم أصفر قابل للطرق والسحب؛ لا يتفاعل مع معظم المواد الكيميائية)",
 "atomic number 8": "أكسجين (عنصر لافلزي ثنائي التكافؤ يكون عادةً غازاً ثنائي الذرة عديم اللون والرائحة والطعم وغير قابل للاشتعال؛ يشكل 21 في المائة من الغلاف الجوي)",
 "atomic number 80": "زئبق (عنصر فلزي ثقيل فضي سام أحادي وثنائي التكافؤ؛ المعدن الوحيد الذي يكون سائلاً في درجات الحرارة العادية)",
 "atomic number 81": "ثاليوم (عنصر فلزي ناعم رمادي قابل للطرق يشبه القصدير ولكنه يتغير لونه عند التعرض للهواء؛ وهو شديد السمية)",
 "atomic number 82": "رصاص (عنصر فلزي ناعم ثقيل سام وقابل للطرق؛ أبيض مزرق عند قطعه حديثًا ولكنه يفقد بريقه بسهولة ليصبح رمادياً باهتاً)\nمثال: كان الأطفال يلعبون بجنود من الرصاص",
 "atomic number 83": "بزموت (عنصر فلزي ثلاثي التكافؤ ثقيل هش ومضاد للمغناطيسية)",
 "atomic number 84": "بولونيوم (عنصر فلزي مشع يشبه التيلوريوم والبزموت)",
 "atomic number 85": "أستاتين (عنصر مشع غير مستقر للغاية (أثقل سلسلة الهالوجينات)؛ نتاج تحلل اليورانيوم والثوريوم)",
 "atomic number 86": "رادون (عنصر غازي مشع يتكون من تحلل الراديوم؛ أثقل الغازات الخاملة)",
 "atomic number 87": "فرانسيوم (عنصر مشع من مجموعة الفلزات القلوية اكتشف كمنتج تحلل للأكتينيوم)",
 "atomic number 88": "راديوم (عنصر فلزي مشع بشدة يوجد بكميات ضئيلة في خامات اليورانيوم)",
 "atomic number 89": "أكتينيوم (عنصر مشع من سلسلة الأكتينيدات؛ يوجد في خامات اليورانيوم)",
 "atomic number 9": "فلور (عنصر لافلزي أحادي التكافؤ ينتمي إلى الهالوجينات؛ عادة ما يكون غازاً ساماً أصفر مهيجاً وقابلاً للاشتعال)",
 "atomic number 90": "ثوريوم (عنصر فلزي مشع ناعم فضي-أبيض رباعي التكافؤ)",
 "atomic number 91": "بروتكتينيوم (عنصر فلزي مشع قصير العمر يتكون من اليورانيوم ويتحلل إلى أكتينيوم ثم إلى رصاص)",
 "atomic number 92": "يورانيوم (عنصر فلزي مشع ثقيل سام فضي-أبيض؛ يوجد في العديد من النظائر؛ يستخدم للوقود النووي والأسلحة النووية)",
 "atomic number 93": "نبتونيوم (عنصر فلزي مشع ما بعد اليورانيوم؛ يوجد بكميات ضئيلة في خامات اليورانيوم)",
 "atomic number 94": "بلوتونيوم (عنصر فلزي صلب رمادي فضي مشع ما بعد اليورانيوم يمكن شطر ذراته عند قصفها بالنيوترونات)",
 "atomic number 95": "أمريسيوم (عنصر فلزي مشع ما بعد اليورانيوم؛ اكتشف بقصف اليورانيوم بذرات الهيليوم)",
 "atomic number 96": "كوريوم (عنصر فلزي مشع ما بعد اليورانيوم؛ ينتج بقصف البلوتونيوم بنوى الهيليوم)",
 "atomic number 97": "بيركيليوم (عنصر مشع ما بعد اليورانيوم؛ اكتشف بقصف الأمريسيوم بالهيليوم)",
 "atomic number 98": "كاليفورنيوم (عنصر مشع ما بعد اليورانيوم؛ اكتشف بقصف الكوريوم بجسيمات ألفا)",
 "atomic number 99": "أينشتاينيوم (عنصر مشع ما بعد اليورانيوم يتم إنتاجه بقصف البلوتونيوم بالنيوترونات)",
 "atomic physics": "فيزياء ذرية, فيزياء نووية (فرع الفيزياء الذي يدرس البنية الداخلية للنواة الذرية)",
 "atomic pile": "كومة ذرية, مفاعل ذري (مفاعل نووي يستخدم الانشطار النووي المتحكم فيه لتوليد الطاقة)",
 "atomic power": "طاقة نووية, قدرة نووية (الطاقة النووية باعتبارها مصدراً للكهرباء لشبكة الطاقة (للاستخدام المدني))",
 "atomic reactor": "كومة ذرية, مفاعل ذري (مفاعل نووي يستخدم الانشطار النووي المتحكم فيه لتوليد الطاقة)",
 "atomic spectrum": "طيف ذري ((فيزياء) طيف إشعاع ناتج عن انتقالات الإلكترون داخل الذرة؛ سلسلة الخطوط الطيفية مميزة للعنصر)",
 "atomic theory": "ذرية, نظرية ذرية ((كيمياء) أي نظرية تتكون فيها كل المادة من جسيمات صغيرة منفصلة ومحددة وغير قابلة للتجزئة أو الفناء) / نظرية ذرية (نظرية لبنية الذرة)",
 "atomic warhead": "رأس حربي ذري, رأس نووي (الرأس الحربي لصاروخ مصمم لإيصال قنبلة ذرية)",
 "atomic weapon": "سلاح ذري, سلاح نووي (سلاح دمار شامل تستمد قوته التفجيرة من تفاعل نووي)",
 "atomic weight": "كتلة ذرية, وزن ذري ((في الكيمياء) كتلة ذرة عنصر كيميائي معبر عنها بوحدات الكتلة الذرية)",
 "atomisation": "تحويل إلى ذرات, تذرية (الإفناء عن طريق تحويل الشيء إلى ذرات) / تذرية, تفتيت (فصل شيء ما إلى جزيئات دقيقة)",
 "atomiser": "مرذاذ (موزع يحول السائل (مثل العطر) إلى رذاذ ناعم)",
 "atomism": "ذرية, نظرية ذرية ((كيمياء) أي نظرية تتكون فيها كل المادة من جسيمات صغيرة منفصلة ومحددة وغير قابلة للتجزئة أو الفناء) / ذرية ((علم النفس) نظرية تختزل جميع الظواهر العقلية إلى عناصر بسيطة (أحاسيس ومشاعر) تشكل أفكاراً معقدة عن طريق الارتباط)",
 "atomist theory": "ذرية, نظرية ذرية ((كيمياء) أي نظرية تتكون فيها كل المادة من جسيمات صغيرة منفصلة ومحددة وغير قابلة للتجزئة أو الفناء)",
 "atomistic": "تجزيئي, ذري (مقسم إلى عناصر منفصلة وغالباً متباينة)",
 "atomistic theory": "ذرية, نظرية ذرية ((كيمياء) أي نظرية تتكون فيها كل المادة من جسيمات صغيرة منفصلة ومحددة وغير قابلة للتجزئة أو الفناء)",
 "atomistical": "تجزيئي, ذري (مقسم إلى عناصر منفصلة وغالباً متباينة)",
 "atomization": "تحويل إلى ذرات, تذرية (الإفناء عن طريق تحويل الشيء إلى ذرات) / تذرية, تفتيت (فصل شيء ما إلى جزيئات دقيقة)",
 "atomizer": "مِرْذَاذ, رَذَّاذَة",
 "atonal": "لا نغمي (يتميز بتجنب النغمية الغربية التقليدية)",
 "atonalism": "لا نغمية (غياب السلم الموسيقي؛ بديل للنظام الدياتوني)",
 "atonalistic": "لا نغمي (من أو متعلق باللانغمية (في الموسيقى))",
 "atonality": "لا نغمية (غياب السلم الموسيقي؛ بديل للنظام الدياتوني)",
 "atonally": "بِلَا نَغَم (بدون نغمة محددة)\nمثال: يؤلف موسيقى لا نغمية",
 "atone": "كَفَّرَ عَنْ (مصدر للفعل \"كَفَرَ\")",
 "atonement": "كَفَّارَة",
 "atonia": "ارتخاء, فقدان التوتر العضلي (غياب التوتر العضلي الطبيعي)",
 "atonic": "غير منبور, لا نغمي ((للمقاطع) لا تحمل أي نبرة) / واهي (يتميز بنقص التوتر العضلي)\nمثال: المقطع اللانغمي لا يحمل أي نبرة",
 "atonicity": "ارتخاء, فقدان التوتر العضلي (غياب التوتر العضلي الطبيعي)",
 "atony": "ارتخاء, فقدان التوتر العضلي (غياب التوتر العضلي الطبيعي)",
 "atop": "فَوْق",
 "atopic allergy": "تأتب, حساسية فورية (رد فعل تحسسي يظهر بوضوح لدى الشخص المتحسس بعد دقائق فقط من الاتصال)",
 "atopic dermatitis": "إكزيما تاتبيه, التهاب الجلد التاتبي (شكل حاد من التهاب الجلد يتميز بالتأتب (الاستعداد الوراثي للحساسية))",
 "atopic eczema": "إكزيما تاتبيه, التهاب الجلد التاتبي (شكل حاد من التهاب الجلد يتميز بالتأتب (الاستعداد الوراثي للحساسية))",
 "atopognosia": "عمه المكاني, فقد حس المكان (غياب أو فقدان القدرة على تحديد موقع اللمس؛ عدم القدرة على تحديد نقطة اللمس بشكل صحيح)",
 "atopognosis": "عمه المكاني, فقد حس المكان (غياب أو فقدان القدرة على تحديد موقع اللمس؛ عدم القدرة على تحديد نقطة اللمس بشكل صحيح)",
 "atopy": "تأتب, حساسية فورية (رد فعل تحسسي يظهر بوضوح لدى الشخص المتحسس بعد دقائق فقط من الاتصال)",
 "atorvastatin": "أتورفاستاتين, ليبيتور",
 "atoxic": "غير سام (لا ينتج أو ينتج عن سم)",
 "atp": "أدينوسين ثلاثي الفوسفات (نيوكليوتيد مشتق من الأدينوسين يوجد في الأنسجة العضلية؛ المصدر الرئيسي للطاقة للتفاعلات الخلوية)",
 "atrabilious": "سَوْدَاوِيّ, مُتَعَكِّر المِزَاج (سريع الانفعال كأنه يعاني من عسر الهضم)",
 "atrazine": "أترازين (مركب صناعي مشتق من التريازين يستخدم على نطاق واسع كمبيد للأعشاب الزراعية)\nمثال: يُعتقد أن الأترازين يسبب السرطان وهو محظور في بعض الدول الأوروبية",
 "atresia": "انسداد خلقي, رتق (حالة غير طبيعية يكون فيها فتحة طبيعية أو أنبوب في الجسم (مثل مجرى البول) مغلقاً أو غائباً)",
 "atrial": "أذيني (من أو متعلق بتجويف أو غرفة في الجسم (خاصة إحدى الغرف العلوية للقلب))",
 "atrial artery": "شريان أذيني (فرع الشريان التاجي الذي يغذي عضلات الأذينين)",
 "atrial auricle": "أذينة (جيب مخروطي صغير يبرز من الجزء الأمامي العلوي لكل أذين من القلب)",
 "atrial fibrillation": "رَجَفَان أُذَيْنِيّ",
 "atrial septal defect": "عيب الحاجز الأذيني (فتحة غير طبيعية بين الأذينين الأيسر والأيمن للقلب)",
 "atrioventricular": "أذيني بطيني (يتعلق بـ أو يؤثر على الأذينين والبطينين للقلب)\nمثال: مرض أذيني بطيني",
 "atrioventricular block": "إحصار القلب, حصار أذيني بطيني (نوبات مفاجئة متكررة من فقدان الوعي ناجمة عن ضعف توصيل الإشارة التي تنظم ضربات القلب)",
 "atrioventricular bundle": "حزمة أذينية بطينية, حزمة هيس (حزمة من عضلة القلب المعدلة تنقل النبض القلبي من العقدة الأذينية البطينية إلى البطينين مسببة انقباضهما)",
 "atrioventricular nodal rhythm": "نَظْم أُذَيْنِيّ بُطَيْنِيّ, نَظْم عُقْدِيّ (إيقاع القلب الطبيعي عندما تتحكم فيه العقدة الأذينية البطينية)",
 "atrioventricular node": "عقدة أذينية بطينية (عقدة من عضلة القلب المتخصصة تقع في الجدار الحاجز للأذين الأيمن؛ تستقبل النبضات من العقدة الجيبية الأذينية وتنقلها إلى الحزمة الأذينية البطينية)",
 "atrioventricular trunk": "حزمة أذينية بطينية, حزمة هيس (حزمة من عضلة القلب المعدلة تنقل النبض القلبي من العقدة الأذينية البطينية إلى البطينين مسببة انقباضهما)",
 "atrioventricular valve": "صمام أذيني بطيني (أي من صمامي القلب اللذين يتدفق الدم من خلالهما من الأذينين إلى البطينين؛ يمنع عودة الدم إلى الأذين)",
 "atrip": "مَرْفُوع عَنِ القَاع ((عَنِ المِرْسَاة) مَرْفُوع لِلتَّوّ عَنِ القَاع)",
 "atriplex hortensis": "رغل بستاني, سبانخ الجبل (نبات آسيوي يشبه السبانخ غالباً ما يستخدم كبقلة؛ متوطن في أوروبا وأمريكا الشمالية)",
 "atriplex hymenelytra": "رغل غشائي, هولي الصحراء (شجيرة ملحية منخفضة وسيمة في المناطق القاحلة بجنوب غرب الولايات المتحدة والمكسيك لها أوراق زرقاء خضراء شائكة الحواف تستخدم غالباً لزينة عيد الميلاد)",
 "atriplex lentiformis": "رغل عدسي, شجيرة السمان (شجيرة شائكة بأوراق فضية قشرية في السهول القلوية بجنوب غرب الولايات المتحدة والمكسيك)",
 "atriplex mexicana": "إبرة الراعي الريشية, بلوط القدس (رجل الوزة الأوراسي العطري ذو الأوراق الشبيهة بالبلوط والعديد من الزهور الصفراء الخضراء؛ متوطن في أمريكا الشمالية)",
 "atrium": "أُذَيْن",
 "atrium cordis": "أذين القلب (الحجرة العلوية لكل نصف من القلب)",
 "atrium dextrum": "أذين أيمن (الحجرة العلوية اليمنى للقلب التي تتلقى الدم من الأوردة الجوفاء والجيب التاجي)",
 "atrium of the heart": "أذين القلب (الحجرة العلوية لكل نصف من القلب)",
 "atrium sinistrum": "أذين أيسر (الحجرة العلوية اليسرى للقلب التي تتلقى الدم من الأوردة الرئوية)",
 "atrocious": "فَظِيع, مُرَوِّع (يثير الرعب والهلع) / بَشِع, شَنِيع (سيء أو مُزعج بشكل استثنائي) / شَنِيع, فَظِيع (بالغ الوحشية أو القسوة بشكل صادم)",
 "atrociously": "بشكل سيء للغاية, بشكل فظيع (بطريقة فظيعة) / بشكل شائن, بشكل فظيع (لدرجة باهظة أو مفرطة)\nمثال: تغني بشكل فظيع",
 "atrociousness": "شَنَاعَة, فَظَاعَة (صفة كون الفعل قاسياً بشكل مروع وغير إنساني)",
 "atrocity": "بِشَاعَة, قَسْوَة",
 "atromid-s": "أتروميد-إس, كلوفيبرات (دواء (الاسم التجاري أتروميد-إس) يقلل من الدهون في مصل الدم؛ يستخدم لعلاج بعض أمراض القلب والأوعية الدموية)",
 "atropa belladonna": "باذنجان مميت, بلادونا (عشب معمر أوراسي بأزهار جرسية الشكل محمرة وتوت أسود لامع؛ يزرع بكثافة في الولايات المتحدة؛ الجذور والأوراق تنتج الأتروبين)",
 "atrophedema": "وذمة وعائية (مناطق محددة كبيرة متكررة من وذمة تحت الجلد؛ تبدأ فجأة وتختفي خلال 24 ساعة؛ تظهر بشكل رئيسي عند الشابات، غالباً كرد فعل تحسسي للطعام أو الأدوية)",
 "atrophic": "ضموري (يتعلق بالضمور أو يتميز به)\nمثال: التهاب مفاصل ضموري",
 "atrophic arthritis": "التهاب المفاصل الروماتويدي, روماتيزم (مرض مناعي ذاتي مزمن مع التهاب في المفاصل وتشوهات ملحوظة؛ شيء ما (ربما فيروس) يثير هجومًا على الغشاء الزليلي بواسطة الجهاز المناعي، الذي يطلق…)",
 "atrophied": "ضامر, مهزول ((عن عضو أو جزء من الجسم) متناقص في الحجم أو القوة نتيجة لمرض أو إصابة أو قلة الاستخدام)\nمثال: أدى الشلل الجزئي إلى ذراع يسرى ضامرة",
 "atrophy": "ضُمُور, تَلَاشٍ / ضَمُرَ, تَلَاشَى",
 "atropine": "أَتْرُوبِن",
 "atrovent": "أتروفنت, إبراتروبيوم بروميد (موسع للقصبات عن طريق الاستنشاق (الاسم التجاري أتروفنت))",
 "atsugewi": "لغة أتسوغيوي (لغة شاستا يتحدث بها شعب أتسوغيوي) / أتسوغيوي (فرد من شعب هندي في أمريكا الشمالية في شمال كاليفورنيا)",
 "atsugewi language": "لغة أتسوغيوي (لغة شاستا يتحدث بها شعب أتسوغيوي)",
 "attacapa": "لغة أتاكابا (لغة كان يتحدث بها شعب أتاكابا في ساحل خليج لويزيانا وتكساس)",
 "attacapa language": "لغة أتاكابا (لغة كان يتحدث بها شعب أتاكابا في ساحل خليج لويزيانا وتكساس)",
 "attacapan": "لغة أتاكابا (لغة كان يتحدث بها شعب أتاكابا في ساحل خليج لويزيانا وتكساس) / أتاكابا (فرد من شعب هندي كان يعيش سابقاً على طول ساحل الخليج في لويزيانا وتكساس)",
 "attacapan language": "لغة أتاكابا (لغة كان يتحدث بها شعب أتاكابا في ساحل خليج لويزيانا وتكساس)",
 "attach": "رَبَطَ (رَبَطَ الشيءَ يَرَبُطَ رَبْطًا: شَدَّهُ. فهو مربوط، ورَبيط؛ يقال: رَبَطَ نفسَه عن كذا: منعها)\nمثال: ربط يديه و قدميه.",
 "attachable": "قَابِل لِلتَّوْصِيل, قَابِل لِلرَّبْط (قادر على أن يتم تثبيته أو إضافته إلى شيء آخر)\nمثال: مقبض قابل للربط بمسمارين",
 "attache": "حقيبة مستندات (حقيبة أوراق مستطيلة وضحلة) / ملحق (متخصص معين ضمن طاقم بعثة دبلوماسية)",
 "attache case": "حقيبة مستندات (حقيبة أوراق مستطيلة وضحلة)",
 "attached": "مُرْتَبِط, مُلْتَزِم (مرتبط في علاقة جنسية حصرية) / مُتَّصِل, مُلَاصِق (يستخدم للمباني المتصلة بجدران جانبية مشتركة) / مُتَعَلِّق, مُرْتَبِط (محب ومُتودِّد بعمق) / تَابِعٌ, مُلْحَقٌ (مُنْضَمّ في ارتباط وثيق)\nمثال: مجموعة من المنازل المتصلة",
 "attachment": "مَوَدَّة / مُلْحَق / مُرْفَق (مَا يُتَّكَأُ عَلَيْهِ)\nمثال: يؤلمني ذراعي من الكتف إلى المرفق.",
