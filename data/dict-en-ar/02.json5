 "asplenia": "اِنْعِْدَام الطِحَال",
 "asplenium adiantum-nigrum": "أسبلينيوم أسود, طحال أسود (طحال في أوروبا وأفريقيا وآسيا ذو سعف ريشي وينتج مادة قابضة)",
 "asplenium billotii": "طحال رمحي (طحال من غرب أوروبا)",
 "asplenium bradleyi": "طحال برادلي (طحال من شرق إلى جنوب الولايات المتحدة)",
 "asplenium ceterach": "سرخس حرشفي (سرخس أوروبي صغير بسعف جلدي قشري)",
 "asplenium montanum": "طحال الجبل (طحال في شرق أمريكا الشمالية)",
 "asplenium nidus": "سرخس عش الطير (سرخس هوائي استوائي من العالم القديم أو أستراليا يشكل كثيراً خصلات في تشعبات الأشجار)",
 "asplenium nigripes": "شافنيريا (سرخس من جنس شافنيريا)",
 "asplenium pinnatifidum": "طحال مفصص (طحال من شرق وجنوب الولايات المتحدة)",
 "asplenium platyneuron": "طحال الأبنوس (سرخس أمريكي شمالي شائع بخطوط سوداء مصقولة)",
 "asplenium rhizophyllum": "سرخس ماشي, ورقة ماشية (سراخس ذات سعف رمحي يتجذر عند الطرف)",
 "asplenium ruta-muraria": "سذاب الجدار, طحال سذاب الجدار (طحال رقيق صغير يوجد على منحدر حاد (كجدار أو جرف) في أوراسيا وأمريكا الشمالية)",
 "asplenium scolopendrium": "سرخس لسان الأيل, لسان الأيل (سرخس أوراسي بسعف رمحي بسيط)",
 "asplenium trichomanes": "طحال كزبرة البئر (سرخس صخري صغير في المنطقة المعتدلة الشمالية وهاواي بسعف ريشي)",
 "asplenium viride": "طحال أخضر (سرخس صغير بسعف أخضر نحيل؛ واسع الانتشار في الأجزاء الباردة من نصف الكرة الشمالي)",
 "asquint": "بِطَرْف العَيْن, مُنْحَرِف النَّظْرَة ((خَاصَّةً عَنِ النَّظَرَات) مُوَجَّه إِلَى جَانِبٍ بِشَكٍّ أَوِ ارْتِيَاب)",
 "asr": "صَلَاة اَلْعَصْر, عَصْر",
 "ass": "حِمَار (حَيْوَان مُسْتَأْنَس من الجِنْس الذي ينتمي اليه الحِصَان (انظر الصورة). مؤنثه أَتَان؛ صفة تَحْقِيْر تطلق على الغَبِيّ أو الأَحْمَق. مؤنثه حِمَارَة) / حُمار (حَيْوَان مُسْتَأْنَس من الجِنْس الذي ينتمي اليه الحِصَان (انظر الصورة). مؤنثه أَتَان؛ صفة تَحْقِيْر تطلق على الغَبِيّ أو الأَحْمَق. مؤنثه حِمَارَة) / عَجِيزَة, مُؤَخَّرَة\nمثال: هن بحاجة لحمار.",
 "ass-kisser": "ذَيْل, ماسِح الجُوخ (شخص يحاول إرضاء شخص ما من أجل الحصول على ميزة شخصية)",
 "ass-licker": "مُتَمَلِّق",
