 "clxxv": "مِئَة وَخَمْسَة وَسَبْعُونَ (يَدُلُّ عَلَى العَدَد 175)",
 "clxxx": "مِئَة وَثَمَانُونَ (يَدُلُّ عَلَى العَدَد 180)",
 "clydesdale": "كلايدزديل (سلالة ثقيلة من خيول الجر ذات الأرجل المكسوة بالشعر أصلها من اسكتلندا)",
 "clydesdale terrier": "كلايدسديل تيريير (سكاي تيريير صغير تم تربيته بشكل انتقائي ذو آذان منتصبة وفراء حريري طويل)",
 "clypeus": "دِرْعَة, قُلَيْبَة (صفيحة تشبه الدرع على مقدمة رأس الحشرة)",
 "clyster": "حقنة شرجية (حقن سائل عبر فتحة الشرج لتحفيز الإخلاء؛ تستخدم أحياناً لأغراض التشخيص)",
 "clytocybe alba": "كليتوسيب روبوستا (غاريقون أبيض كبير؛ صالح للأكل لكنه ليس مستساغاً)",
 "cm": "سنتيمتر (وحدة مترية للطول تساوي واحداً من المائة من المتر) / كوريوم (عنصر فلزي مشع ما بعد اليورانيوم؛ ينتج بقصف البلوتونيوم بنوى الهيليوم)",
 "cmb": "إشعاع الخلفية الكونية ((في علم الكونيات) البقايا المبردة للانفجار العظيم الحار التي تملأ الكون بأسره ويمكن رصدها اليوم بمتوسط درجة حرارة حوالي 2.725 كلفن)",
 "cmbr": "إشعاع الخلفية الكونية ((في علم الكونيات) البقايا المبردة للانفجار العظيم الحار التي تملأ الكون بأسره ويمكن رصدها اليوم بمتوسط درجة حرارة حوالي 2.725 كلفن)",
 "cmv": "الفيروس المضخم للخلايا (أي من مجموعة فيروسات هربس تضخم الخلايا الظهارية ويمكن أن تسبب تشوهات خلقية؛ ويمكن أن تؤثر على البشر الذين يعانون من ضعف في جهاز المناعة)",
 "cn gas": "غاز سي إن, كلورواسيوفينون",
 "cnemidophorus exsanguis": "سحلية السوط المرقطة (تتميز بخطوط طولية مغطاة ببقع فاتحة؛ سحلية مرتفعات في جنوب غرب الولايات المتحدة والمكسيك)",
 "cnemidophorus sexlineatus": "عداءة (سحلية سريعة جداً تعيش في شرق ووسط الولايات المتحدة)",
 "cnemidophorus tesselatus": "سحلية السوط المربعة (علاماتها أغمق وأكثر وضوحاً من سحلية السوط الغربية؛ توجد من جنوب شرق كولورادو إلى شرق تشيواوا)",
 "cnemidophorus tigris": "سحلية السوط الغربية (سحلية نشطة تتميز بشبكة من العلامات الداكنة القاتمة؛ تعيش في المناطق شبه القاحلة من أوريغون وأيداهو إلى باجا كاليفورنيا)",
 "cnemidophorus velox": "سحلية السوط المخططة (تتميز بخطوط طولية مميزة: توجد في هضبة كولورادو من أريزونا إلى غرب كولورادو)",
 "cnicus benedictus": "شوك مبارك, قنطريون مبارك (نبات حولي من البحر الأبيض المتوسط إلى البرتغال ذو سيقان مشعرة وأوراق مسننة شائكة بدقة ورؤوس كبيرة من الزهور الصفراء)",
 "cnidarian": "جوفمعوي, لاسع (حيوانات متناظرة شعاعياً لها أجسام تشبه الكيس بفتحة واحدة فقط ومجسات ذات هياكل لاسعة)",
 "cnidoscolus urens": "عشبة لاسعة, قراص الدربيون (عشب لاسع في أمريكا الاستوائية)",
 "cns": "الجهاز العصبي المركزي (جزء الجهاز العصبي الفقاري المكون من الدماغ والحبل الشوكي)",
 "co": "مستنكف ضميرياً (من يرفض الخدمة في القوات المسلحة لأسباب تتعلق بالضمير) / كوبالت (عنصر فلزي صلب مغناطيسي فضي-أبيض ثنائي أو ثلاثي التكافؤ) / أول أكسيد الكربون (غاز عديم الرائحة سام جداً وهو نتاج للاحتراق غير الكامل للكربون)",
 "co-beneficiary": "مستفيد مشارك (واحد من مستفيدين أو أكثر من نفس المنفعة)",
 "co-brother-in-law": "عديل (العَدْل بمعنى المَثِيْل والنَظِيْر؛ هو زَوْج أُخْت الزَوْجَة)",
 "co-defendant": "متهم مشارك, مدعى عليه مشارك (مدعى عليه تم ضمه مع مدعى عليه واحد أو أكثر في دعوى واحدة)",
 "co-discoverer": "مكتشف مشارك (شخص يكون أول شخصين أو أكثر يكتشفون شيئاً)",
 "co-ed": "لِلْجِنْسَيْن, مُخْتَلَط (يحضره أفراد من الجنسين معًا) / طالبة جامعية (طالبة في كلية أو جامعة مختلطة)",
 "co-founder": "مؤسس شريك (واحد من مجموعة من المؤسسين لكيان ما)",
 "co-occurrence": "تزامن, تصادف (الخاصية الزمنية لحدوث شيئين في نفس الوقت) / تزامن, مرافقة (حدث أو موقف يحدث في نفس الوقت أو بالارتباط مع آخر)\nمثال: الفاصل الزمني الذي يحدد بوابة التزامن قابل للتعديل",
 "co-occurrent": "آنِيّ, مُتَزَامِن (يحدث أو يعمل في نفس الوقت)",
 "co-op": "تعاونية, جمعية تعاونية (مؤسسة تجارية مملوكة بشكل مشترك (ينظمها عادة المزارعون أو المستهلكون) تنتج وتوزع السلع والخدمات وتدار لصالح مالكيها)",
 "co-operative republic of guyana": "جمهورية التعاونية غيانا, جمهورية التعاونية غويانا",
 "co-optation": "تعيين إضافي, ضم (التعيين الفوري (بموافقة المعين أو بدونها)) / انتخاب داخلي, ضم عضوية (اختيار عضو جديد (عادةً عن طريق تصويت الأعضاء الحاليين))",
 "co-option": "تعيين إضافي, ضم (التعيين الفوري (بموافقة المعين أو بدونها)) / انتخاب داخلي, ضم عضوية (اختيار عضو جديد (عادةً عن طريق تصويت الأعضاء الحاليين))",
 "co-ordinate": "إِحْدَاثِيّ (رقم يحدد موقعاً بالنسبة لمحور معين)",
 "co-ordinated": "مُنَسَّق الحَرَكَة (يتمتع بمهارة في استخدام أكثر من مجموعة حركات عضلية) / مُتَرَابِط, مُنَسَّق (يعمل كوحدة واحدة متناسقة) / مُتَوَافِق, مُنَسَّق (مُطابَق عن قصد)",
 "co-ordinator": "منسق (شخص مهمته التأكد من سير العمل بانسجام)",
 "co-pilot": "مساعد طيار (طيار مساعد على متن طائرة)",
 "co-production": "إنتاج مشترك (إنتاج تعمل فيه شركتان أو أكثر من شركات الإنتاج المختلفة معاً، على سبيل المثال في إنتاج فيلم)",
 "co-referent": "مشترك المرجع (يتعلق بالاشتراك في المرجع (الإحالة إلى نفس الشيء))",
 "co-respondent": "شريك في الزنا (المتهم المشارك المتهم بالزنا مع الزوج المنفصل في إجراءات الطلاق)",
 "co-sister-in-law": "سِلْفَة",
 "co-star": "شريك في البطولة, نجم مشارك (أحد ممثلين اثنين يتمتعان بوضع متساوٍ كنجوم في مسرحية أو فيلم)",
 "co-wife": "ضَرَّة, جَارة",
 "co-worker": "زَمِيل عَمَل (زميل يعمل معه المرء في نفس المكان)",
 "co2": "ثاني أكسيد الكربون (غاز ثقيل عديم الرائحة واللون يتكون أثناء التنفس وعن طريق تحلل المواد العضوية؛ تمتصه النباتات من الهواء في عملية التمثيل الضوئي)",
 "coach": "عَرَبَة / مُدَرِّب, مُدَرِّبَة / حافلة السفر, حافلة النقل الخارجي (وسيلة نَقْل للركاب)\nمثال: لنذهب بالحافلة.",
 "coach dog": "كلب دلماسي (سلالة كبيرة لها معطف أبيض ناعم مع بقع سوداء أو بنية؛ نشأت في دالماتيا)",
 "coach driver": "حُوذِيّ",
 "coach horse": "حصان العربة (حصان جر قوي لجر العربات)",
 "coach house": "مبنى العربات (مبنى صغير لإيواء العربات والمركبات الأخرى)",
 "coach station": "محطة حافلات (محطة طرفية تخدم ركاب الحافلات)",
 "coach-and-four": "عربة جياد, كوتش (عربة تجرها أربعة خيول مع سائق واحد)"
