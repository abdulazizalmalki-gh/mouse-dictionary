 "chopping board": "لوح تقطيع (لوح خشبي يمكن تقطيع اللحوم أو الخضروات عليه)",
 "chopping knife": "ساطور, سكين تقطيع (سكين كبير يستخدم لتقطيع أو فرم اللحوم والخضروات، إلخ)",
 "choppy": "مُتَقَطِّع",
 "chopsteak": "شريحة برغر, شريحة لحم مفروم (قرص من اللحم البقري المفروم المطهو)",
 "chopstick": "أَعْوَاد الْأَكْل, هَاشِي",
 "choragic": "كورالي (متعلق بـ أو من خصائص قائد الجوقة (في المسرح اليوناني القديم))",
 "choragus": "قائد الجوقة ((في اليونان القديمة) قائد مجموعة أو مهرجان؛ قائد الجوقة)",
 "choral": "جوقي, كورالي (متعلق بالجوقة أو الكورال أو مكتوب له أو يؤدى بواسطته) / كورايل (لحن ترنيمة بروتستانتية مهيبة (خاصة اللوثرية))\nمثال: تأليف كورالي",
 "choral ode": "قصيدة كورس, نشيد جوقة (قصيدة تغنيها الجوقة في الدراما اليونانية الكلاسيكية)",
 "chorale": "كورايل (لحن ترنيمة بروتستانتية مهيبة (خاصة اللوثرية))",
 "chorale prelude": "مقدمة ترنيمة (تأليف للأرغن يستخدم ترنيمة كأساس للتنويعات)",
 "chorally": "جماعياً, كورالياً (بواسطة جوقة (كورال))\nمثال: بمصاحبة كورالية",
 "chorasmia": "خُوَارِزْم",
 "chord": "وَتَر, اِئْتِلَاف نَغَمَات (خيط شديد أو سلك يربط بين طرفي القوس ليستخدم في إطلاق السهام. سمي كذلك لأنه واحد، مشتق من الوِتْر وهو الفرد؛ خيط شديد أو سلك يربط على الآلة الموسيقية لإطلاق الصوت. سمي كذلك تشبيها له بوَتَر القَوْس)",
 "chordal": "وتري (يتعلق بـ أو يتكون من أو يركز على الأوتار الموسيقية)\nمثال: سجع وتري في الموسيقى الحديثة",
 "chordamesoderm": "أديم متوسط حبلي (منطقة الأديم المتوسط التي تشكل الحبل الظهري)",
 "chordate": "حَبْلِيّ",
 "chordate family": "فصيلة حبليات (أي فصيلة في شعبة الحبليات)",
 "chordate genus": "جنس حبليات (أي جنس في شعبة الحبليات)",
 "chorditis": "التهاب الحبال الصوتية (التهاب الحبال الصوتية) / التهاب الحبل (التهاب الحبل المنوي أو الحبال الصوتية أو الطيات الصوتية)",
 "chordomesoderm": "أديم متوسط حبلي (منطقة الأديم المتوسط التي تشكل الحبل الظهري)",
 "chordophone": "آلة وترية (آلة وترية من المجموعة التي تشمل القيثارات والعود واللير والزيثير)",
 "chore": "عَمَلٌ رُوتِينِيّ (فِعْل، صُنْع؛ وسيلة للكسب، مِهْنَة، حِرْفَة)\nمثال: المهم هو العمل.",
 "chorea": "داء الرقص, رقص (أي من الاضطرابات العصبية التنكسية المتعددة التي تتميز بحركات تشنجية للجسم والأطراف) / رقم الكلاب (رقم (حركات لا إرادية) في الكلاب)",
 "choreic abasia": "عدم القدرة على المشي الرقصي (عدم القدرة على المشي المرتبط بحركات غير طبيعية للساقين)",
 "choreographer": "مُصَمِّمُ رَقْصٍ, مُصَمِّمَةُ رَقْصٍ",
 "choreographic": "راقص, كوريغرافي (من أو معني بتصميم الرقصات)",
 "choreography": "تَصْمِم الرَّقْص",
 "chorepiscopus": "خُورْفِسْقُفُوس",
 "choric": "جوقي (متعلق بالجوقة اليونانية أو مكتوب لها أو على نمطها)\nمثال: مأساة يونانية جوقية",
 "chorine": "راقصة استعراضية (امرأة ترقص في صف الكورس)",
 "chorioallantoic membrane": "مشيماء سجقية (الغشاء الجنيني الوعائي جداً المكون من المشيمة المندمجة والجدار المجاور للسجق)",
 "chorioallantois": "مشيماء سجقية (الغشاء الجنيني الوعائي جداً المكون من المشيمة المندمجة والجدار المجاور للسجق)",
 "choriomeningitis": "التهاب المشيمية والسحايا (التهاب سحايا دماغي مع ارتشاح خلوي للسحايا)",
 "chorion": "كوريون, مشيمة (الكيس الغشائي الخارجي الذي يحيط بالجنين في الفقاريات العليا (الزواحف والطيور والثدييات))",
 "chorionic": "مشيمائي (متعلق بالمشيماء (غشاء الجنين الخارجي))\nمثال: الزغابة المشيمائية هي نتوء وعائي دقيق على مشيماء الجنين",
 "chorionic villus": "زغابة مشيمية (واحدة من الزغابات الدقيقة التي تبرز من المشيمة الجنينية وتتحد مع أنسجة رحم الأم لتكوين المشيمة)",
 "chorionic villus biopsy": "فحص الزغابات المشيمية (اختبار قبل الولادة للكشف عن العيوب الخلقية في مرحلة مبكرة من الحمل)",
 "chorionic villus sampling": "فحص الزغابات المشيمية (اختبار قبل الولادة للكشف عن العيوب الخلقية في مرحلة مبكرة من الحمل)",
 "chorioretinitis": "التهاب المشيمية والشبكية (التهاب طبقة المشيمية خلف الشبكية)",
