 "china": "الصِّين (دولة في شرق آسيا؛ اسمها الرسمي جُمْهُورِيَّة الصِّين الشَّعْبِيَّة، وعاصمتها بِكِّين) / صِينِيَّة (نوع من آنية المطبخ تستخدم لوضع الآواني عليها حين تنقل تكون مسطحة وواسعة؛ القُصْعَة؛ آنية واسعة يُصَّب فيها طعام يكفي عصبة من الناس)\nمثال: الصين بلد عظيم.",
 "china aster": "أستر صيني (نبات يُقدّر لزهوره الجميلة ذات الألوان الزاهية والنقية المتنوعة؛ يُزرع بشكل أساسي للقطف)",
 "china cabinet": "خزانة أواني, خزانة الصيني (خزانة (عادة بأبواب زجاجية) لتخزين وعرض الأواني الخزفية)",
 "china clay": "طين صيني, كاولين (طين ناعم عادة ما يكون أبيض ناتج عن تجوية المعادن الألومينية (مثل الفلسبار)؛ يستخدم في السيراميك وكمادة ماصة وكمادة مالئة (على سبيل المثال، في الورق))",
 "china closet": "خزانة أواني, خزانة الصيني (خزانة (عادة بأبواب زجاجية) لتخزين وعرض الأواني الخزفية)",
 "china fleece vine": "كرمة الدانتيل الفضي, كرمة الصوف الصيني (كرمة معمرة ملتفة لها عناقيد من الزهور المخضرة العطرية؛ غرب الصين إلى روسيا)",
 "china grass": "رامي, عشبة الصين (عشبة معمرة طويلة من آسيا الاستوائية ذات أوراق خضراء داكنة؛ تزرع للألياف من سيقانها الخشبية التي تشبه الكتان)",
 "china jute": "أبو طيلون, خبازة هندية (عشب حولي طويل أو شجيرة صغيرة من آسيا الاستوائية بأوراق مخملية وزهور صفراء وينتج أليافاً قوية)",
 "china pink": "قرنفل صيني, قرنفل قوس قزح (قرنفل صيني بزهور وردية ليلكية مسننة بعمق مع عين أرجوانية؛ يزرع عادة كنبات سنوي)",
 "china proper": "ٱلصِّينُ ٱلدَّاخِلِيَّةُ",
 "china rose": "كركديه صيني, ورد صيني (شجيرة آسيوية كبيرة مبهرجة أو شجرة صغيرة ذات زهور حمراء إلى حمراء داكنة كبيرة مفردة أو مزدوجة) / ورد بنغالي, ورد صيني (ورد صيني شجيري؛ سلف العديد من ورود الحدائق المزروعة)",
 "china stone": "طين صيني, كاولين (طين ناعم عادة ما يكون أبيض ناتج عن تجوية المعادن الألومينية (مثل الفلسبار)؛ يستخدم في السيراميك وكمادة ماصة وكمادة مالئة (على سبيل المثال، في الورق))",
 "china tree": "أزدرخت, زنزلخت (شجرة من شمال الهند والصين لها أزهار أرجوانية وثمار صفراء صغيرة غير صالحة للأكل؛ تم توطينها في جنوب الولايات المتحدة كشجرة ظل) / أزدرخت, زنزلخت (شجرة دائمة الخضرة في أمريكا الاستوائية ذات ثمار لبية تحتوي على الصابونين الذي كان يستخدم كصابون من قبل السكان الأصليين)",
 "chinaberry": "أزدرخت, زنزلخت (شجرة من شمال الهند والصين لها أزهار أرجوانية وثمار صفراء صغيرة غير صالحة للأكل؛ تم توطينها في جنوب الولايات المتحدة كشجرة ظل) / أزدرخت, زنزلخت (شجرة دائمة الخضرة في أمريكا الاستوائية ذات ثمار لبية تحتوي على الصابونين الذي كان يستخدم كصابون من قبل السكان الأصليين)",
 "chinaberry tree": "أزدرخت, زنزلخت (شجرة من شمال الهند والصين لها أزهار أرجوانية وثمار صفراء صغيرة غير صالحة للأكل؛ تم توطينها في جنوب الولايات المتحدة كشجرة ظل)",
 "chinaman": "رمية تشاينامان (كرة يرميها رامٍ أعسر لضارب أيمن تدور من الجانب البعيد إلى جانب الساق) / صيني (مصطلح مسيء) ((إهانة عرقية) مصطلح مسيء لرجل من أصل صيني)",
 "chinatown": "حَيّ صِينِي, تْشَايْنَاتَاوْن (ضد المَيِّت، على قيد الحَيَاة؛ جمع حَيَاء)\nمثال: ينبح كلب في الحي.",
 "chinaware": "خزف صيني, صيني (أواني أطباق مصنوعة من البورسلين عالي الجودة)",
 "chinawoman": "صينية (مصطلح مسيء) ((إهانة عرقية) مصطلح مسيء لامرأة من أصل صيني)",
 "chincapin": "كستناء قزمية (جوز صغير لأي من شجرتي كستناء صغيرتين في جنوب الولايات المتحدة؛ يشبه البندق)",
 "chinch": "بق الفراش (بق المناطق المعتدلة الذي يغزو الأسرة بشكل خاص ويتغذى على دم الإنسان)",
 "chinch bug": "بق الحبوب (حشرة صغيرة سوداء وبيضاء تتغذى على أعشاب الحبوب)",
 "chincherinchee": "زهرة العجب (نبات جنوب أفريقي معمر بسنابل طويلة الأمد من الزهور البيضاء يتم شحنها إلى أوروبا وأمريكا لاستخدامها كزهور قطف شتوية)",
 "chinchilla": "شنشيلة (قارض صغير ذو فراء رمادي لؤلؤي ناعم؛ موطنه الأصلي جبال الأنديز ولكن يُربى في الأسر من أجل الفراء) / قماش الشنشيلة (قماش مبرد سميك من الصوف والقطن) / فراء الشنشيلة (الفراء الرمادي الفضي الباهظ الثمن للشنشيلة)",
 "chinchilla laniger": "شنشيلة (قارض صغير ذو فراء رمادي لؤلؤي ناعم؛ موطنه الأصلي جبال الأنديز ولكن يُربى في الأسر من أجل الفراء)",
 "chinchilla rat": "جرذ الشنشيلة (قارض يشبه الجرذ ذو فراء ناعم وآذان كبيرة يعيش في جبال الأنديز)",
 "chinchillon": "فيسكاتشا (قارض اجتماعي يحفر الجحور أكبر من الشنشيلة)",
 "chinchona": "كنكينا (أي من الأشجار المتعددة من جنس كنكينا)",
 "chinchy": "بَخِيل بِشَكْل مُحْرِج, شَحِيح (بخيل بصورة مُخجلة ومُحرجة)",
 "chine": "سلسلة الظهر (العمود الفقري للحيوان) / لحم العمود الفقري (قطعة لحم أو سمك تتضمن جزءاً من العمود الفقري على الأقل)",
 "chinese": "صِينِيّ",
 "chinese alligator": "قَاطُور صِينِيّ",
 "chinese angelica": "أنجليكا صينية (تشبه شجرة الأنجليكا الأمريكية ولكنها أقل شوكاً؛ الصين)",
 "chinese angelica tree": "أنجليكا صينية (تشبه شجرة الأنجليكا الأمريكية ولكنها أقل شوكاً؛ الصين)",
 "chinese anise": "ينسون نجمي (فاكهة أو بذرة على شكل نجمة برائحة الينسون تستخدم في الطبخ الآسيوي والطب) / يانسون صيني, يانسون نجمي (شجرة صغيرة من الصين وفيتنام تحمل ثماراً على شكل نجمة برائحة اليانسون تستخدم في الطعام وطبياً كطارد للغازات)",
 "chinese black mushroom": "شيتاكي (فطر شرق آسيوي صالح للأكل له قبعة ذهبية أو بنية داكنة إلى سوداء وساق غير صالح للأكل)",
 "chinese brown sauce": "صلصة بنية صينية (صلصة تعتمد على صلصة الصويا)",
 "chinese cabbage": "ملفوف صيني (رأس ممدود من سيقان مقرمشة تشبه الكرفس وأوراق خضراء فاتحة) / كرنب صيني, ملفوف صيني (نبات ذو رأس ممدود من أوراق عريضة معنقة تشبه الكرفس؛ يستخدم كخضروات في شرق آسيا)",
 "chinese celery": "ملفوف صيني (رأس ممدود من سيقان مقرمشة تشبه الكرفس وأوراق خضراء فاتحة)",
 "chinese character": "حَرْف صِينِيّ, طَابِع صِينِيّ (طَرَف وَجَانِب وَحَدّ؛ رَمْز مخطوط أو مطبوع يقوم مقام صوت أو كلمة أو عبارة أو معنى)\nمثال: ألف هو الحرف الأول للألف باء.",
 "chinese checkers": "الداما الصينية (لعبة لوحية يحاول فيها كل لاعب تحريك مجموعة من الكرات عبر مجموعة من الثقوب من نقطة نجمة سداسية إلى النقطة المقابلة)",
 "chinese chequers": "الداما الصينية (لعبة لوحية يحاول فيها كل لاعب تحريك مجموعة من الكرات عبر مجموعة من الثقوب من نقطة نجمة سداسية إلى النقطة المقابلة)",
 "chinese chestnut": "كستناء صينية (شجرة صغيرة بجوز حلو صغير؛ برية أو موطنة في كوريا والصين)",
 "chinese chive": "ثوم معمر صيني, كراث صيني (نبات من شرق آسيا؛ أكبر من الثوم المعمر)",
 "chinese cinnamon": "سَلِيخَة, قِرْفَة صِينِيَّة (اللحاء العطري لشجرة السليخة؛ أقل جودة كنوع من التوابل مقارنة بقرفة سيلان)",
 "chinese cork oak": "بلوط الفلين الصيني (شجرة متساقطة الأوراق متوسطة إلى كبيرة من الصين واليابان وكوريا لها لحاء فليني سميك)",
 "chinese date": "عناب (فاكهة تشبه البرقوق حمراء داكنة لأشجار النبق في العالم القديم)",
 "chinese deity": "إله صيني (إله عبده الصينيون القدماء)",
 "chinese dogwood": "قَرَانِيَا صِينِيَّة",
 "chinese elm": "دردار صيني (شجرة صغيرة سريعة النمو موطنها آسيا؛ تزرع على نطاق واسع كمصدات رياح وتحوطات) / دردار سيبيري (شجرة آسيوية شجيرية سريعة النمو توطنت في الولايات المتحدة للمأوى أو الزينة)",
 "chinese evergreen": "أجلونيما, خضرة صينية (عشب قائم أو متسلق جزئياً ذو أوراق خضراء كبيرة أو مبرقشة)",
 "chinese forget-me-not": "لا تنسني الصينية, لسان الكلب المحبب (عشب شرق آسيوي ثنائي الحول يزرع لزهوره الزرقاء الزاهية عادة)",
 "chinese fried rice": "أرز صيني مقلي, أرز مقلي (أرز مسلوق مخلوط بالبصل الأخضر ولحم الخنزير المفروم أو الجمبري ومخفوق بسرعة مع البيض)",
 "chinese goose": "إوز صيني (إوز بري كبير جداً من شمال شرق آسيا؛ يتزاوج بحرية مع الإوز الرمادي)",
 "chinese gooseberry": "كيوي (فاكهة بيضاوية بنية زغبية ذات لحم أخضر لاذع قليلاً) / عنب الثعلب الصيني, كيوي (كرمة متسلقة موطنها الصين؛ تزرع في نيوزيلندا لفاكهتها الصالحة للأكل ذات القشرة الوبرية واللب الأخضر)",
 "chinese hibiscus": "كركديه صيني, ورد صيني (شجيرة آسيوية كبيرة مبهرجة أو شجرة صغيرة ذات زهور حمراء إلى حمراء داكنة كبيرة مفردة أو مزدوجة)",
 "chinese holly": "بهشية صينية, هولي صيني (شجيرة دائمة الخضرة كثيفة مستديرة من الصين لها أوراق شائكة؛ تزرع على نطاق واسع للزينة)",
 "chinese jujube": "عناب (فاكهة تشبه البرقوق حمراء داكنة لأشجار النبق في العالم القديم)",
 "chinese lacquer tree": "شجرة اللك, شجرة الورنيش (شجرة آسيوية صغيرة تفرز مادة سامة يتم الحصول منها على اللك (الورنيش))",
 "chinese lantern": "فانوس صيني (فانوس ورقي قابل للطي بألوان زاهية؛ يستخدم لأغراض الزينة)",
 "chinese lantern plant": "فانوس صيني, كرز الشتاء (نبات معمر من العالم القديم يزرع لكأسه الورقي البرتقالي المحمر المنفوخ الزخرفي)",
 "chinese magnolia": "ماغنوليا صحنية, ماغنوليا صينية (شجيرة كبيرة متساقطة الأوراق أو شجرة صغيرة ذات زهور وردية إلى أرجوانية مفتوحة كبيرة؛ موطنها آسيا؛ تقدر كنبات زينة في شرق أمريكا الشمالية)",
 "chinese monetary unit": "وحدة نقدية صينية (الوحدة النقدية في جمهورية الصين الشعبية)",
 "chinese mushroom": "فطر القش, فطر صيني (فطر صغير صالح للأكل استوائي وشبه استوائي له قبعة بيضاء وساق طويل؛ طعام شهي باهظ الثمن في الصين ودول آسيوية أخرى حيث يزرع تجارياً)",
 "chinese mustard": "خردل صيني (خردل محضر حار جداً) / خردل صيني, خردل هندي (خردل آسيوي يستخدم كعشب وعائي)",
 "chinese new year": "رَأْس السَّنَة الصِّينِيَّة, عِيد الرَّبِيع (عُضْو مِنَ ٱلْجَسَدِ يَحْوِي الدِّمَاغ والفَم والأَنْف والعَيْنَيْن والأُذُنَيْن؛ أَعْلَى ٱلشَّيْءِ)\nمثال: قطع سامي رأس كلب.",
 "chinese paddlefish": "سمكة المجداف الصينية (سمكة في الأنهار الكبيرة في الصين تشبه سمكة المجداف في المسيسيبي)",
 "chinese parasol": "شجرة المظلة الصينية, ورنيش ياباني (شجرة نفضية تزرع على نطاق واسع في جنوب الولايات المتحدة كزينة لأوراقها الجميلة التي تشبه القيقب وعناقيدها الطويلة من الزهور الصفراء الخضراء تليها قرون…)",
 "chinese parasol tree": "شجرة المظلة الصينية, ورنيش ياباني (شجرة نفضية تزرع على نطاق واسع في جنوب الولايات المتحدة كزينة لأوراقها الجميلة التي تشبه القيقب وعناقيدها الطويلة من الزهور الصفراء الخضراء تليها قرون…)",
 "chinese parsley": "كزبرة (عشبة تشبه البقدونس تستخدم كتابل أو للزينة) / كزبرة (عشب من العالم القديم بأوراق عطرية وبذور تشبه البقدونس)",
 "chinese pea tree": "شجرة البازلاء الصينية (شجيرة بأوراق لامعة خضراء داكنة وزهور صفراء شاحبة منفردة؛ شمال الصين)",
 "chinese primrose": "زهرة الربيع الصينية (زهرة ربيع آسيوية مزروعة)",
 "chinese privet": "تمرحنة صينية, شجرة الشمع الأبيض (شجيرة تشبه الشجرة قائمة دائمة الخضرة من الصين وكوريا واليابان لها أوراق مستدقة وزهور في عناقيد قائمة طويلة؛ تشبه التمرحنة اليابانية)",
 "chinese puzzle": "لغز صيني (لغز معقد أو بارع يتكون من صناديق داخل صناديق)",
 "chinese restaurant syndrome": "متلازمة المطعم الصيني (صداع وشعور بالوخز أو الحرق وتعرق ناتج عن تناول طعام يحتوي على غلوتامات أحادية الصوديوم)",
 "chinese rhubarb": "راوند صيني, راوند كفي (يستخدم منذ فترة طويلة لخصائصه الملينة)",
 "chinese scholar tree": "شجرة الباغودا اليابانية, صفيراء يابانية (شجرة نفضية جميلة مستديرة الرأس لها أوراق مركبة خضراء داكنة وعناقيد غزيرة من الزهور البيضاء الكريمية العطرة؛ موطنها الصين واليابان)",
 "chinese scholartree": "شجرة الباغودا اليابانية, صفيراء يابانية (شجرة نفضية جميلة مستديرة الرأس لها أوراق مركبة خضراء داكنة وعناقيد غزيرة من الزهور البيضاء الكريمية العطرة؛ موطنها الصين واليابان)",
 "chinese shan": "تاي نوا, شان الصينية (فرع من لغات تاي، يُتحدث به في جنوب غرب مقاطعة يونان الصينية)",
 "chinese silk plant": "رامي, عشبة الصين (عشبة معمرة طويلة من آسيا الاستوائية ذات أوراق خضراء داكنة؛ تزرع للألياف من سيقانها الخشبية التي تشبه الكتان)",
 "chinese taipei": "تَايْبِيه الصِّينِيَّة (عاصمة دولة تايوان)",
 "chinese water chestnut": "كستناء الماء, كستناء الماء الصينية (سعد صيني ينتج درنات صالحة للأكل على شكل بصيلة)",
 "chinese whispers": "هَاتِف عَرَبِيّ, هَاتِف لَاسِلْكِيّ (جهاز يستخدم للتحدث؛ الصوت يسمع دون أن يرى صاحبه)\nمثال: رن الهاتف تكرارا.",
 "chinese white": "أبيض الزنك, أبيض صيني (خضاب أبيض يستخدم في دهانات المنازل؛ يتكون من أكسيد الزنك)",
 "chinese white cabbage": "بوك تشوي, ملفوف صيني أبيض (نبات آسيوي يزرع لعنقوده من السيقان البيضاء الصالحة للأكل مع أوراق خضراء داكنة)",
 "chinese wistaria": "ستارية صينية, ويستيريا صينية (نبات له زهور أرجوانية داكنة)",
 "chinese wood oil": "زيت التونغ (زيت أصفر يتم الحصول عليه من بذور شجرة التونغ)",
 "chinese yam": "كرمة القرفة, يام صيني (كرمة صينية قوية التحمل متوطنة في الولايات المتحدة وتزرع كمتسلقة زينة لأوراقها اللامعة على شكل قلب برائحة القرفة وفي المناطق الاستوائية لدرناتها…)",
 "chinese-red": "زِنْجَفْرِيّ (بلون أحمر زاهٍ إلى برتقالي محمر)",
 "chingpo": "لغة جينغبو (إحدى لغات كاتشين)",
 "chingpo language": "لغة جينغبو (إحدى لغات كاتشين)",
 "chink": "رنين معدني, طقطقة (صوت معدني خفيف قصير) / شق ضيق (فتحة ضيقة كما بين الألواح في الجدار) / صيني (مصطلح مسيء) ((إهانة عرقية) مصطلح مسيء لشخص من أصل صيني)",
 "chinkapin": "كستناء قزمية (جوز صغير لأي من شجرتي كستناء صغيرتين في جنوب الولايات المتحدة؛ يشبه البندق)",
 "chinkapin oak": "سنديان أصفر, سنديان تشينكابين (شجرة نفضية متوسطة الحجم موطنها شرق الولايات المتحدة، تنتج خشباً قوياً ومتيناً)",
 "chinked": "مَحْشُوّ, مَسْدُود (ذو فتحات ضيقة مملوءة ومسدودة)",
 "chinless": "بِلَا ذَقَن بَارِز (ذو ذقن متراجع إلى الخلف)",
 "chinning bar": "عارضة العُقلة (قضيب أفقي يمكنك رفع نفسك عليه بتمارين العقلة)",
 "chino": "تشينو (قماش قطني مبرد خشن يستخدم بكثرة للزي الرسمي)",
 "chinoiserie": "زخرفة صينية, شينوازي (نمط فني يعكس التأثير الصيني؛ مزخرف بإتقان وذو أنماط معقدة)",
 "chinook": "سلمون شينوك, سلمون ملكي (سلمون كبير من المحيط الهادئ يُقدر كطعام؛ يموت البالغون بعد وضع البيض) / لغة شينوك (لغة بينوتية يتحدث بها شعب شينوك) / تشينوك, سلمون الملك (لحم وردي أو أبيض لسلمون المحيط الهادئ الكبير) / شينوك (فرد من شعب هندي مهم في أمريكا الشمالية سيطر على مصب نهر كولومبيا)",
 "chinook jargon": "رطانة الشينوك (لغة بدجنية تدمج كلمات من الشينوك والفرنسية والإنجليزية؛ كانت تستخدم سابقاً كلغة مشتركة في شمال غرب أمريكا الشمالية)",
 "chinook language": "لغة شينوك (لغة بينوتية يتحدث بها شعب شينوك)",
 "chinook salmon": "سلمون شينوك, سلمون ملكي (سلمون كبير من المحيط الهادئ يُقدر كطعام؛ يموت البالغون بعد وضع البيض) / تشينوك, سلمون الملك (لحم وردي أو أبيض لسلمون المحيط الهادئ الكبير)",
 "chinook wind": "آكلة الثلج, رياح الشينوك (رياح دافئة وجافة تهب أسفل المنحدرات الشرقية لجبال روكي)",
 "chinookan": "لغة شينوك (لغة بينوتية يتحدث بها شعب شينوك)",
 "chinookan language": "لغة شينوك (لغة بينوتية يتحدث بها شعب شينوك)",
 "chinos": "بنطال تشينو ((جمع) سراويل مصنوعة من قماش تشينو)",
 "chinquapin": "كستناء قزمية (جوز صغير لأي من شجرتي كستناء صغيرتين في جنوب الولايات المتحدة؛ يشبه البندق) / شينكابين, كستناء قزمية (شجرة كستناء شجيرية من جنوب شرق الولايات المتحدة لها جوز صغير صالح للأكل) / شينكابين أوزارك (شجرة شجيرية وثيقة الصلة بالكستناء القزمية ولكن بأوراق أكبر؛ جنوب وسط غرب الولايات المتحدة)",
 "chinquapin oak": "سنديان أصفر, سنديان تشينكابين (شجرة نفضية متوسطة الحجم موطنها شرق الولايات المتحدة، تنتج خشباً قوياً ومتيناً)",
 "chintz": "شِينْتْز",
 "chintzily": "ببخل, بتقتير (بطريقة بخيلة)\nمثال: عاملهم عمهم الغني ببخل",
 "chintzy": "بَخِيل بِشَكْل مُحْرِج, شَحِيح (بخيل بصورة مُخجلة ومُحرجة) / تَافِه, رَخِيص (رديء الجودة جدًا؛ هَشّ)",
 "chiocciole": "كيوتشيولي (نوع من المكرونة على شكل كوع)",
 "chiococca alba": "توت الثلج لغرب الهند, كيوكوكا ألبا (شجيرة متسلقة دائمة الخضرة من جنوب فلوريدا وجزر الهند الغربية تزرع لعناقيدها من الزهور البيضاء العطرة إلى الكريمية تليها ثمار توت عصارية بيضاء كروية)",
 "chionanthus virginicus": "شجرة الأهداب (شجرة كثيفة صغيرة من جنوب شرق الولايات المتحدة لها عناقيد غزيرة من الزهور البيضاء)",
 "chionochloa conspicua": "تويتوي (يستخدمه الماوري للتسقيف)",
 "chip": "تفتيت, شطف (عملية شطف جزء من شيء ما) / شيب, ضربة قصيرة منخفضة ((غولف) ضربة اقتراب منخفضة ومتدحرجة) / رقاقة, رقاقة دقيقة (معدات إلكترونية تتكون من بلورة صغيرة من شبه موصل السيليكون مصنعة لتنفيذ عدد من الوظائف الإلكترونية في دائرة متكاملة) / رقاقة بوكر, فيشة (عداد صغير على شكل قرص يستخدم لتمثيل المال عند المقامرة)",
 "chip shot": "شيب, ضربة قصيرة منخفضة ((غولف) ضربة اقتراب منخفضة ومتدحرجة)",
 "chipboard": "خشب حبيبي, لوح مضغوط (مادة صلبة رخيصة مصنوعة من رقائق الخشب المضغوطة معاً والمربوطة بالراتنج الصناعي)",
 "chipewyan": "لغة تشيبيويان (اللغة التي يتحدث بها شعب تشيبيويان) / تشيبيويان (فرد من شعب أثاباسكان يعيش في غرب كندا بين بحيرة العبيد الكبرى وخليج هدسون)",
 "chipewyan language": "لغة تشيبيويان (اللغة التي يتحدث بها شعب تشيبيويان)",
 "chipmunk": "صيدناني (سنجاب أرضي يحفر الجحور من غرب أمريكا وآسيا؛ له جيوب خدية وشريط فاتح وداكن يمتد أسفل الجسم)",
 "chipolata": "شيبولاتا (سجق صغير رفيع)",
 "chipotle": "شيبوتلي (هلابينو ناضج تم تجفيفه للاستخدام في الطبخ)",
 "chippendale": "تشيبنديل (من أو متعلق بنمط أثاث من القرن الثامن عشر صنعه توماس تشيبنديل؛ يتميز بخطوط رشيقة وزخارف يونانية ومنحوتات روكوكو ضخمة)",
 "chipper": "أَنِيق, رَشِيق (ذو طابع مرح وحيويّ وواثق من نفسه)",
 "chippewa": "تشيبوا, لغة الأوجيبوا (لغة ألغونكوية يتحدث بها شعب الأوجيبوا) / أوجيبوا, تشيبوا (فرد من شعب ألغونكي يمتد من أونتاريو الحالية في شرق كندا وصولاً إلى مونتانا، وحول بحيرة سوبيريور)",
 "chippewa language": "تشيبوا, لغة الأوجيبوا (لغة ألغونكوية يتحدث بها شعب الأوجيبوا)",
 "chippewaian": "لغة تشيبيويان (اللغة التي يتحدث بها شعب تشيبيويان)",
 "chippewaian language": "لغة تشيبيويان (اللغة التي يتحدث بها شعب تشيبيويان)",
 "chippewyan": "لغة تشيبيويان (اللغة التي يتحدث بها شعب تشيبيويان)",
 "chippewyan language": "لغة تشيبيويان (اللغة التي يتحدث بها شعب تشيبيويان)",
 "chipping": "تفتيت, شطف (عملية شطف جزء من شيء ما)",
 "chipping sparrow": "عصفور السقسقة (عصفور صغير من أمريكا الشمالية شائع في المناطق الحضرية)",
 "chips": "أصابع البطاطس المقلية, بطاطس مقلية (شرائح من البطاطس مقلية في زيت غزير)",
 "chiptune": "چيپ تيون",
 "chiralgia": "ألم اليد (ألم في اليد ليس ناتجاً عن إصابة)",
 "chiricahua apache": "لغة شيريكاهوا أباتشي (لغة أباتشية، يتم التحدث بها في نيو مكسيكو ومحمية ميسكاليرو، ومن قبل بعض الشيريكاهوا في فورت سيل، أوكلاهوما)",
 "chiricahua apache language": "لغة شيريكاهوا أباتشي (لغة أباتشية، يتم التحدث بها في نيو مكسيكو ومحمية ميسكاليرو، ومن قبل بعض الشيريكاهوا في فورت سيل، أوكلاهوما)",
 "chirography": "الخط, فن الخط (الكتابة اليدوية الجميلة)",
 "chirology": "قراءة الكف (قراءة البخت عن طريق الخطوط الموجودة على راحة اليد)",
 "chiromancer": "قاريء الكف (عراف يتنبأ بمستقبلك من خلال الخطوط الموجودة على راحة يدك)",
 "chiromancy": "قراءة الكف (قراءة البخت عن طريق الخطوط الموجودة على راحة اليد)",
 "chiromantic": "كفي (متعلق بقراءة الكف)",
 "chiron": "شِيرُون (كويكب اكتشف عام 1977؛ يتميز بمدار يقع بشكل رئيسي بين مداري زحل وأورانوس) / شيرون ((الأساطير اليونانية) القنطور الحكيم الذي علم أخيل وأسكليبيوس وهرقل وجاسون وغيرهم من الأبطال)",
 "chiropodist": "أخصائي أقدام, طبيب أقدام (أخصائي في العناية بالقدمين)",
 "chiropody": "طب الأقدام (فرع الطب المعني بالقدمين)",
 "chiropractic": "تقويم العمود الفقري, كايروبراكتيك (طريقة للعلاج تقوم بمعالجة هياكل الجسم (خاصة العمود الفقري) لتخفيف آلام أسفل الظهر أو حتى الصداع أو ارتفاع ضغط الدم)",
 "chiropractor": "مُقَوِّم اَلْعِظَام",
 "chiropteran": "خفاش, وطواط (ثديي ليلي يشبه الفأر تحورت أطرافه الأمامية لتشكل أجنحة غشائية ولديه تكيفات تشريحية لتحديد الموقع بالصدى الذي يتنقل بواسطته)",
 "chirp": "تَغْرِيدَة, تَغْرِيد / غَرَّدَ",
 "chirpily": "بِانْشِرَاح, بِتَفَاؤُل (بطريقة مبهجة ومتفائلة)\nمثال: قبلنا الفرصة بانشراح",
 "chirpiness": "مرح, نشاط (مبتهج وحيوي)",
 "chirpy": "حَيَوِيّ, نَشِيط (يتّسم بالحيويّة وخفّة الروح) / زقزاق, مغرد ((الطيور أو الحشرات) تتميز بـ أو تميل إلى الزقزقة)",
 "chirrup": "تغريد, زقزقة متواصلة (سلسلة من الزقزقات)",
 "chisel": "إِزْمِيل",
 "chisel steel": "فولاذ الأزاميل (فولاذ يستخدم في صنع الأزاميل)",
 "chisel-like": "شَبِيه بِالإِزْمِيل (يُشْبِه الإِزْمِيل فِي شَكْلِه)",
 "chiseled": "مَنْحُوت المَعَالِم, وَاضِح القَسَمَات (ذُو خُطُوط وَاضِحَة وَمُحَدَّدَة كَأَنَّهَا مَنْحُوتَة بِدِقَّة)",
 "chiseler": "محتال, نصاب (شخص يحتال عليك عن طريق الخداع أو الغش)",
 "chiseller": "محتال, نصاب (شخص يحتال عليك عن طريق الخداع أو الغش)",
 "chishona": "الشونا (لغة بانتو يتم التحدث بها في زيمبابوي)",
 "chishona language": "الشونا (لغة بانتو يتم التحدث بها في زيمبابوي)",
 "chishti": "جِشْتِيّ",
 "chislev": "كيسليف (الشهر الثالث من السنة المدنية؛ الشهر التاسع من السنة الدينية في التقويم اليهودي (في نوفمبر وديسمبر))",
 "chit": "شيك الحساب, فاتورة الحساب (الفاتورة في مطعم) / فتاة وقحة (مصطلح ازدرائي لفتاة غير ناضجة أو تفتقر إلى الاحترام)\nمثال: طلب من النادل الحساب",
 "chit chat": "أحاديث جانبية, ثرثرة خفيفة (محادثة غير رسمية خفيفة للمناسبات الاجتماعية)",
 "chit-chat": "أحاديث جانبية, ثرثرة خفيفة (محادثة غير رسمية خفيفة للمناسبات الاجتماعية)",
 "chita": "تْشِيتَا",
 "chitchat": "أحاديث جانبية, ثرثرة خفيفة (محادثة غير رسمية خفيفة للمناسبات الاجتماعية)",
 "chitin": "كيتين (مادة قرنية شبه شفافة قوية؛ المكون الرئيسي للهياكل الخارجية للمفصليات وجدران خلايا بعض الفطريات)",
 "chitinous": "كيتيني (من أو يشبه الكيتين)",
 "chitlings": "أمعاء الخنزير, شيتلينز (الأمعاء الدقيقة للخنازير محضرة كطعام)",
 "chitlins": "أمعاء الخنزير, شيتلينز (الأمعاء الدقيقة للخنازير محضرة كطعام)",
 "chiton": "خيتون, عديد الأصداف (رخوي بحري بدائي ممدود متناظر ثنائياً له عباءة مغطاة بثماني صفائح جيرية) / خيتون (سترة صوفية ارتداها الرجال والنساء في اليونان القديمة)",
 "chittagong": "جَاتْجَام, شَطّ الْغَانْج",
 "chittam bark": "قِشْرَة مُقَدَّسَة, كَسْكَارَة (اللحاء المجفف لنبق الكسكارة يستخدم كملين)",
 "chittamwood": "شجرة الدخان الأمريكية (شجرة شجيرية في جنوب الولايات المتحدة ذات أعمدة كبيرة من الزهور الريشية تشبه نفثات الدخان) / بوميلية صوفية, نبق كاذب (شجرة متساقطة الأوراق في جنوب شرق الولايات المتحدة والمكسيك) / نبق بورش, نبق كاسكارا (شجرة شجيرية في ساحل المحيط الهادئ للولايات المتحدة؛ تنتج الكاسكارا المقدسة)",
 "chittem bark": "قِشْرَة مُقَدَّسَة, كَسْكَارَة (اللحاء المجفف لنبق الكسكارة يستخدم كملين)",
 "chitterlings": "أمعاء الخنزير, شيتلينز (الأمعاء الدقيقة للخنازير محضرة كطعام)",
 "chittimwood": "بوميلية صوفية, نبق كاذب (شجرة متساقطة الأوراق في جنوب شرق الولايات المتحدة والمكسيك) / نبق بورش, نبق كاسكارا (شجرة شجيرية في ساحل المحيط الهادئ للولايات المتحدة؛ تنتج الكاسكارا المقدسة)",
 "chivalric": "فُرُوسِيّ, قُرُوسَطِيّ (مُمَيِّزٌ لِعَصْرِ الفُرُوسِيَّةِ وَالعُصُورِ الوُسْطَى)",
 "chivalrous": "فُرُوسِيّ, نَبِيل (يُبدي اهتماماً بالنساء كالفارس المثالي)",
 "chivalrously": "بِشَهَامَة, بِفُرُوسِيَّة (بطريقة شهمة)\nمثال: عرض بشهامة أن يوصلها للمنزل",
 "chivalry": "مُرُوءَة",
 "chivaree": "شيفاري, ضوضاء احتفالية (سيريناد ساخر صاخب (يُصنع بقرع القدور والغلايات) لزوجين حديثي الزواج)",
 "chive": "ثُوم مُعَمَّر",
 "chives": "ثوم معمر (أوراق أسطوانية تستخدم طازجة كتابل خفيف بنكهة البصل) / ثوم معمر (نبات معمر له أوراق أسطوانية مجوفة تستخدم للتتبيل)",
 "chiwere": "لغة تشيويري (لغة سيووية يتحدث بها شعوب آيوا وأوتو وميسوري)",
 "chiwere language": "لغة تشيويري (لغة سيووية يتحدث بها شعوب آيوا وأوتو وميسوري)",
 "chișinău": "كِيشِينَاو, كِيشِينِيف",
 "chlamydeous": "ذُو غِلَاف زَهْرِيّ, غِلَافِيّ (لديه غلاف زهري أو محيط زهرة يتكون من كأس و/أو تويج)",
 "chlamydera nuchalis": "طائر التعريشة الكبير (طائر تعريشة كبير من شمال أستراليا)",
 "chlamydia": "كلاميديا, متدثرة (ريكتسيا مكورة تصيب الطيور والثدييات؛ تسبب التهابات العيون والرئتين والجهاز البولي التناسلي) / كلاميديا (عدوى تنتقل عن طريق الاتصال الجنسي تسببها بكتيريا من جنس المتدثرة)",
 "chlamydia psittaci": "كلاميديا الطيور, متدثرة ببغائية (بكتيريا مسؤولة عن مرض الكلاميديا المنقول جنسياً)",
 "chlamydia trachomatis": "كلاميديا تراخوماتيس, متدثرة حثرية (بكتيريا مسؤولة عن الأمراض المنقولة جنسياً الكلاميديا والورم الحبيبي اللمفي المنقول جنسياً)",
 "chlamydial": "كلاميدي (من أو متعلق بعدوى الكلاميديا أو الطفيلي المسبب لها)",
 "chlamydosaurus kingi": "سحلية مكشكشة (سحلية أسترالية شجرية كبيرة آكلة للحشرات ذات طوق من الجلد حول الرقبة)",
 "chlamydospore": "بوغ غلافي, بوغ كلاميدي (بوغ ساكن لاجنسي سميك الجدار لبعض الفطريات والطحالب)",
 "chlamyphore": "مدرع الجني, مدرع قزم (مدرع أرجنتيني صغير جداً ذو شعر حريري شاحب وصفائح وردية على الرأس والرقبة)",
 "chlamyphorus truncatus": "مدرع الجني, مدرع قزم (مدرع أرجنتيني صغير جداً ذو شعر حريري شاحب وصفائح وردية على الرأس والرقبة)",
 "chlamys": "كلاميس (رداء قصير أو كيب يثبت عند الكتف؛ ارتداه الرجال في اليونان القديمة) / غلاف زهري (مصطلح جماعي للأجزاء الخارجية للزهرة المكونة من الكأس والتويج وتحيط بالأسدية والمدقات)",
 "chloasma": "قناع الحمل, كلف (تغير لون وجه المرأة إلى الأسمر ويرتبط بالحمل أو باستخدام حبوب منع الحمل)",
 "chloe": "كلوي",
 "chlor-trimeton": "كلور-تريميتون, كلورفينيرامين (مضاد للهيستامين (الأسماء التجارية كلور-تريميتون وكوريسيدين))",
 "chloral hydrate": "هيدرات الكلورال (دواء بلوري عديم اللون يستخدم كمهدئ؛ يهيج المعدة ويمكن أن يسبب الإدمان)",
 "chlorambucil": "كلورامبوسيل, لوكيرا (عامل مؤلكل (الاسم التجاري لوكيرا) يستخدم لعلاج بعض أنواع السرطان)",
 "chloramine": "كلورامين, كلورامين-تي (أي من عدة مركبات تحتوي على الكلور والنيتروجين؛ تستخدم كمطهر في الجروح)",
 "chloramine-t": "كلورامين, كلورامين-تي (أي من عدة مركبات تحتوي على الكلور والنيتروجين؛ تستخدم كمطهر في الجروح)",
 "chloramphenicol": "كلورامفينيكول, كلوروميسيتين (مضاد حيوي فموي (الاسم التجاري كلوروميسيتين) يستخدم لعلاج الالتهابات الخطيرة (خاصة حمى التيفوئيد))",
 "chlorate": "كلورات (أي ملح لحمض الكلوريك)",
 "chlordiazepoxide": "كلورديازيبوكسيد, ليبريوم (مهدئ (الأسماء التجارية ليبريوم وغيرها) يستخدم في علاج إدمان الكحول)",
 "chlorella": "كلوريلا (أي طحلب من جنس كلوريلا)",
 "chlorenchyma": "نسيج كلورنشيمي (نسيج برانشيمي تحتوي خلاياه على بلاستيدات خضراء)",
 "chlorhexidine": "كلورهيكسيدين (مطهر سائل طويل المفعول؛ يستخدمه الجراحون لغسل أيديهم قبل إجراء الجراحة)",
 "chloric acid": "حمض الكلوريك (أصبح حامضًا، تغير الطعم إلى الحموضة؛ ارتفعت نسبة الحموضة في شيء ما، كما في الطعام أو السوائل)\nمثال: رمى ياني الحمض على وجه سكورة.",
 "chloride": "كُلُورِيد",
 "chloride of lime": "جير مكلور, مسحوق تبييض (مسحوق أبيض يتكون من هيدروكسيد الكالسيوم والكلوريد وهيبوكلوريت ويستخدم للتبييض و/أو التطهير)",
 "chlorinate": "كلور",
 "chlorinated lime": "جير مكلور, مسحوق تبييض (مسحوق أبيض يتكون من هيدروكسيد الكالسيوم والكلوريد وهيبوكلوريت ويستخدم للتبييض و/أو التطهير)",
 "chlorination": "كلورة (تطهير المياه بإضافة كميات صغيرة من الكلور أو مركب الكلور) / كلورة (إضافة أو استبدال الكلور في المركبات العضوية)",
 "chlorine": "كُلُور",
 "chlorine dioxide": "ثاني أكسيد الكلور",
 "chlorine water": "ماء الكلور (محلول مائي للكلور يستخدم كعامل تبييض)",
 "chlorinity": "كُلُورِيَّة (مقياس لكمية الكلور أو الهاليدات الأخرى في الماء (خاصة مياه البحر))",
 "chloris gayana": "عشبة رودس (عشبة معمرة من جنوب أفريقيا أدخلت إلى الولايات المتحدة؛ تزرع كعشبة علف في المناطق الجافة)",
 "chloris truncata": "عشبة طاحونة الهواء (عشبة أسترالية معمرة ذات سنابل طويلة عديدة مرتبة مثل ريش طاحونة الهواء)",
 "chlorite": "كلوريت (معدن أخضر أو أسود بشكل عام؛ يوجد كمكون للعديد من الصخور عادة في شكل بلورة مسطحة)",
 "chloroacetophenone": "غاز سي إن, كلورواسيوفينون",
 "chlorobenzene": "كلوروبنزين (سائل متطاير عديم اللون قابل للاشتعال برائحة اللوز يصنع من الكلور والبنزين؛ يستخدم كمذيب وفي إنتاج الفينول والـ دي دي تي ومركبات عضوية أخرى)",
 "chlorobenzylidenemalononitrile": "غاز سي إس, كلوروبنزيليدين مالونونتريل",
 "chlorofluorocarbon": "كلوروفلوروكربون (فلوروكربون مع كلور؛ كان يستخدم سابقاً كمبرد وكمادة دافعة في علب الرش)\nمثال: الكلور الموجود في مركبات الكربون الكلورية فلورية يسبب استنفاذ الأوزون في الغلاف الجوي",
 "chloroform": "كْلُورُوفُورْم",
 "chlorofucin": "يخضور ج (اليخضور الموجود في الطحالب البنية والدياتومات والسوطيات)",
 "chlorohydric acid": "حمض الهيدروكلوريك (محلول مائي لكلوريد الهيدروجين؛ حمض قوي ومسبب للتآكل)",
 "chloromycetin": "كلورامفينيكول, كلوروميسيتين (مضاد حيوي فموي (الاسم التجاري كلوروميسيتين) يستخدم لعلاج الالتهابات الخطيرة (خاصة حمى التيفوئيد))",
 "chlorophoneus nigrifrons": "صرد الأدغال أسود الجبهة (نوع من صرد الأدغال)",
 "chlorophyl": "كلوروفيل, يخضور (أي مجموعة من الأصباغ الخضراء الموجودة في الكائنات التي تقوم بالتمثيل الضوئي)",
 "chlorophyll": "يَخْضُور, كْلُورُوفِيل (في هو مادّة خضراء توجد في بعض الخلايا النَّباتيَّة وبها تتمّ عمليَّة التَّمثيل الضَّوئيّ لتكوين الموادّ الكربوهيدراتيّة يساعد الكلوروفيل على التمثيل…)",
 "chlorophyll a": "يخضور أ (صبغة نباتية زرقاء مسودة لها محلول كحولي أزرق مخضر؛ توجد في جميع النباتات العليا)",
 "chlorophyll b": "يخضور ب (صبغة نباتية خضراء داكنة لها محلول كحولي أخضر لامع؛ مميزة للنباتات العليا بشكل عام)",
 "chlorophyll c": "يخضور ج (اليخضور الموجود في الطحالب البنية والدياتومات والسوطيات)",
 "chlorophyll d": "يخضور د (اليخضور الموجود (مع اليخضور أ) في الطحالب الحمراء)",
 "chlorophyllose": "يخضوري (يتعلق بـ أو يكون أو يحتوي على اليخضور (الكلوروفيل))",
 "chlorophyllous": "يخضوري (يتعلق بـ أو يكون أو يحتوي على اليخضور (الكلوروفيل))",
 "chlorophyllum molybdites": "كلوروفيلوم موليبديتس (غاريقون سام بقبعة ليفية وقشور بنية على أرضية بيضاء؛ يمكن أن يصل قطر القبعة إلى 30 سم؛ غالباً ما يشكل 'حلقات الجنيات')",
 "chlorophyta": "الطحالب الخضراء, قسم الطحالب الخضراء (قسم كبير من الطحالب حقيقية النواة التي تعيش بشكل رئيسي في المياه العذبة وتمتلك الكلوروفيل أ وب وتخزن الغذاء على شكل نشا ولها جدران خلوية سيليلوزية)",
 "chlorophyte": "طحالب خضراء (طحالب ذات لون أخضر صافٍ؛ تنمو غالباً على الصخور الرطبة أو الخشب الرطب أو سطح المياه الراكدة)",
 "chloropicrin": "كلوروبيكرين, نيتروكلوروفورم (مركب سائل ثقيل عديم اللون غير قابل للذوبان يسبب الدموع والقيء؛ يستخدم كمبيد للآفات وكغاز مسيل للدموع)",
 "chloroplast": "بلاستيدة خضراء, صانعة خضراء (بلاستيد يحتوي على اليخضور وأصباغ أخرى؛ في النباتات التي تقوم بعملية التمثيل الضوئي)",
 "chloroplatinate": "كلوروبلاتينات (أي ملح لحمض الكلوروبلاتينيك)",
 "chloroprene": "كلوروبيرن (مشتق من البوتادين يُستخدم في صنع النيوبرين عن طريق البلمرة)",
 "chloroquine": "ْكْلُورُوكِين",
 "chlorosis": "داء الاخضرار, يرقان شاحب (فقر الدم الناجم عن نقص الحديد لدى الشابات؛ يتميز بالضعف واضطرابات الدورة الشهرية ولون أخضر للجلد)",
 "chlorothiazide": "ديوريل, كلوروثيازيد (دواء مدر للبول (الاسم التجاري ديوريل) يستخدم في علاج الوذمة وارتفاع ضغط الدم)",
 "chlorotic": "شاحب, يخضوري (من أو متعلق بـ أو يعاني من اليخضور (فقر دم يسبب شحوب مخضر))",
 "chlorous acid": "حمض الكلوروز (أصبح حامضًا، تغير الطعم إلى الحموضة؛ ارتفعت نسبة الحموضة في شيء ما، كما في الطعام أو السوائل)\nمثال: رمى ياني الحمض على وجه سكورة.",
 "chloroxylon swietenia": "خشب الأطلس, شجرة الساتان (شجرة من جزر الهند الشرقية ذات خشب أصفر لامع صلب ذي قيمة)",
 "chlorpheniramine maleate": "كلور-تريميتون, كلورفينيرامين (مضاد للهيستامين (الأسماء التجارية كلور-تريميتون وكوريسيدين))",
 "chlorpromazine": "ثورازين, كلوربرومازين (دواء (الاسم التجاري ثورازين) مشتق من الفينوثيازين له تأثيرات مضادة للذهان ويستخدم كمهدئ ومهدئ للأعصاب)",
 "chlorpyrifos": "كلوربيريفوس (مبيد حشري فوسفاتي عضوي شائع)",
 "chlortetracycline": "أوريوميسين, كلورتيتراسايكلين (مضاد حيوي بلوري أصفر (الاسم التجاري أوريوميسين) يستخدم لعلاج بعض الأمراض البكتيرية والريكتسية)",
 "chlorthalidone": "كلورثاليدون (مدر للبول (الأسماء التجارية هيغروتون وثاليدون) يستخدم للسيطرة على ارتفاع ضغط الدم والحالات التي تسبب الوذمة؛ فعال في خفض ضغط الدم لمنع النوبات القلبية)",
 "chlorura chlorura": "طوهي أخضر الذيل (طائر طوهي من جبال روكي)",
 "choana": "منخر خلفي (أي من الفتحتين الخلفيتين في مؤخرة التجويف الأنفي المؤديتين إلى البلعوم الأنفي)",
 "choanocyte": "خلية قمعية, خلية مطوقة (أي من الخلايا السوطية في الإسفنجيات التي تمتلك طوقاً من السيتوبلازم حول السوط؛ تحافظ على تدفق الماء عبر الجسم)",
 "choc": "شوكولاتة (اختصار بريطاني عامي للشوكولاتة)\nمثال: علبة شوكولاتة",
 "choc-ice": "آيس كريم مغطى بالشوكولاتة (اختصار عامي بريطاني لآيس كريم الشوكولاتة (أو المغطى بها))",
 "chock": "تَمَامًا, حَتَّى الامْتِلَاء (بأقصى ما يمكن) / إسفين, سنادة (كتلة من الخشب تستخدم لمنع انزلاق أو تدحرج جسم ثقيل)\nمثال: كان ممتلئاً تماماً",
 "chock-a-block": "تَمَامًا, حَتَّى الامْتِلَاء (بأقصى ما يمكن)\nمثال: كان ممتلئاً تماماً",
 "chock-full": "مَحْشُوّ, مَكْدُوس (مَمْلُوء عَنْ آخِرِه حَتَّى السَّعَة القُصْوَى)",
 "chockful": "مَحْشُوّ, مَكْدُوس (مَمْلُوء عَنْ آخِرِه حَتَّى السَّعَة القُصْوَى)",
 "chocolate": "شُوكُولَاتَة, شُوكُولَا",
 "chocolate bar": "لوح شوكولاتة (لوح من حلوى الشوكولاتة)",
 "chocolate cake": "كَعْكَة الشُوكُولَاتَةِ, فَطِيرَة الشُوكُولَاتَةِ (واحدة الكَعْك؛ حَلْوَى تُصْنع من الدَقِيق والحَلِيب والسُكَّر والزَيت ويخبز طريًا وقد يوضع عليه القِشْطَة. يُسمى عند البعض كَيْك وعند البعض تُورْتَة)\nمثال: خبزت كعكة لتوم.",
 "chocolate candy": "حلوى الشوكولاتة (حلوى مصنوعة بالشوكولاتة)",
 "chocolate chip cookie": "كوكيز برقائق الشوكولاتة (بسكويت يحتوي على رقائق الشوكولاتة)",
 "chocolate eclair": "إكلير بالشوكولاتة (إكلير مغطى بالشوكولاتة)",
 "chocolate egg": "بيضة شوكولاتة (حلوى شوكولاتة على شكل بيضة)",
 "chocolate fondue": "فوندو الشوكولاتة (فوندو مصنوع من الشوكولاتة المذابة مع الحليب أو القشدة لتغميس الفواكه)",
 "chocolate fudge": "فادج الشوكولاتة (فادج مصنوع بالشوكولاتة أو الكاكاو)",
 "chocolate ice cream": "آيس كريم الشوكولاتة (آيس كريم بنكهة الشوكولاتة)",
 "chocolate kiss": "قُبَل الشوكولاتة (حلوى تتكون من قطعة شوكولاتة مخروطية صغيرة)",
 "chocolate liquor": "سائل الشوكولاتة (السائل أو المعجون الناتج عند تحميص وطحن حبوب الكاكاو؛ أساس كل الشوكولاتة)",
 "chocolate milk": "حليب بالشوكولاتة (حليب منكه بشراب الشوكولاتة)",
 "chocolate mousse": "موس الشوكولاتة (تحلية موس مصنوعة بالشوكولاتة)",
 "chocolate pudding": "بودينغ الشوكولاتة (بودينغ حلو بنكهة الشوكولاتة يشبه الكاسترد وعادة ما يكثف بالدقيق بدلاً من البيض)",
 "chocolate root": "أفينس أرجواني, أفينس مائي (نبات معمر منتصب من المنطقة المعتدلة الشمالية له أوراق ريشية وعدد قليل من الزهور المتدلية بكأس بني أرجواني وبتلات برتقالية ووردية)",
 "chocolate sauce": "صلصة الشوكولاتة (صلصة مصنوعة من الشوكولاتة غير المحلاة أو الكاكاو والسكر والماء)",
 "chocolate syrup": "صلصة الشوكولاتة (صلصة مصنوعة من الشوكولاتة غير المحلاة أو الكاكاو والسكر والماء)",
 "chocolate teacake": "رَأْس الْعَبْد, كْرِيمْبُو (عُضْو مِنَ ٱلْجَسَدِ يَحْوِي الدِّمَاغ والفَم والأَنْف والعَيْنَيْن والأُذُنَيْن؛ أَعْلَى ٱلشَّيْءِ)\nمثال: قطع سامي رأس كلب.",
 "chocolate tree": "شجرة الكاكاو, كاكاو (شجرة أمريكية استوائية تنتج حبوب الكاكاو)",
 "chocolate truffle": "ترفل, ترفل الشوكولاتة (حلوى شوكولاتة كريمية)",
 "chocolate-brown": "بُنِّيّ (بلون مشابه للخشب أو التراب)",
 "chocolate-colored": "شُوكُولَاتِيّ اللَّوْن (بلون الشوكولاتة الداكنة)",
 "chocolate-coloured": "شُوكُولَاتِيّ اللَّوْن (بلون الشوكولاتة الداكنة)",
 "choctaw": "لغة تشوكتاو (اللغة المسكوكية لشعب تشوكتاو) / تشوكتاو (فرد من الشعب المسكوكي الذي عاش سابقاً في ألاباما)",
 "choctaw language": "لغة تشوكتاو (اللغة المسكوكية لشعب تشوكتاو)",
 "choeronycteris mexicana": "خفاش خنزيري الأنف (خفاش مكسيكي صغير الأذن ذو أنف طويل نحيل)",
 "choice": "اِخْتِيَار, خِيَار",
 "choice morsel": "قطعة لذيذة, لقمة شهية (قطعة صغيرة ولذيذة من الطعام)",
 "choice of words": "ألفاظ, صياغة (الطريقة التي يتم بها التعبير عن شيء ما بالكلمات)",
 "choiceless awareness": "الوعي بلا اختيار",
 "choiceness": "جودة ممتازة, دقة (جودة كون الشيء جيداً جداً بالفعل)\nمثال: يتميز النزل بدقة مأكولاته",
 "choir": "خُورُس, جَوْقَة",
 "choir loft": "شرفة الجوقة (رواق في الكنيسة تشغله الجوقة)",
 "choir school": "مدرسة الجوقة (مدرسة تكون جزءاً من كاتدرائية أو دير حيث يمكن للأولاد الذين لديهم قدرة على الغناء الحصول على تعليم عام)",
 "choir stall": "مقعد الجوقة (مقعد خشبي منحوت ومزخرف بدقة حيث يجلس رجال الدين أو يقفون أو يركعون أثناء الخدمات)\nمثال: استخدام مقاعد الجوقة (بدلاً من المقاعد العادية) أكثر تقليدية في الأديرة والكنائس الجامعية",
 "choirboy": "منشد (صبي يغني في جوقة)",
 "choirgirl": "فتاة الكورس (فتاة تغني في جوقة)",
 "choirmaster": "قائد جوقة, مرتل (المدير الموسيقي لجوقة غنائية)",
 "choke": "اِخْتَنَقَ / خَنَقَ (خَنَقَ (خنقه) خنقا: عصر حلقه حتى مات؛ خَنَقَ الوقت: أخره وضيقه)\nمثال: خنق زيري وليد بعمامته.",
 "choke coil": "ملف خانق (ملف ذو مقاومة منخفضة ومحاثة عالية يستخدم في الدوائر الكهربائية لتمرير التيار المستمر وتخفيف التيار المتردد)",
 "choke hold": "خنق, مسكة خنق (إمساك مقيد؛ حيث يلف شخص ذراعه حول رقبة شخص آخر في قبضة محكمة)\nمثال: أمسك المرأة في وضعية خنق، وطالب بمالها ومجوهراتها، ثم لاذ بالفرار",
 "choke-full": "مَحْشُوّ, مَكْدُوس (مَمْلُوء عَنْ آخِرِه حَتَّى السَّعَة القُصْوَى)",
 "chokeberry": "أَرُونِيَة",
 "chokecherry": "كرز مخنوق (كرز بري شائع في شرق أمريكا الشمالية له توت أسود مر صغير تفضله الطيور) / كرز فرجينيا (ثمرة شجرة كرز فرجينيا)",
 "chokecherry tree": "كرز مخنوق (كرز بري شائع في شرق أمريكا الشمالية له توت أسود مر صغير تفضله الطيور)",
 "choked": "مَخْنُوق, مُنْسَدّ (مسدود ومتكدّس)",
 "chokedamp": "غاز خانق (الغلاف الجوي في منجم بعد انفجار؛ غني بثاني أكسيد الكربون وغير قادر على دعم الحياة)",
 "chokehold": "خنق, مسكة خنق (إمساك مقيد؛ حيث يلف شخص ذراعه حول رقبة شخص آخر في قبضة محكمة) / إحكام القبضة, خناق (السلطة الكاملة على شخص أو موقف)\nمثال: أمسك المرأة في وضعية خنق، وطالب بمالها ومجوهراتها، ثم لاذ بالفرار",
 "chokepoint": "نقطة اختناق (نقطة ازدحام أو انسداد) / تضييق, عنق زجاجة (تضييق يقلل التدفق عبر قناة)\nمثال: الجسر دائماً نقطة اختناق في ساعة الذروة",
 "choker": "طوق مكشكش, ياقة عالية (ياقة عالية وضيقة) / طوق, قلادة ضيقة (قلادة تلتف بإحكام حول عنق المرأة) / فاشِل تَحْت الضَّغْط, مُنْهار (شخص سيء الحظ غير قادر على الأداء بفعالية بسبب التوتر العصبي أو الاضطراب) / خانِق (شخص يقتل عن طريق الخنق)\nمثال: كان بإمكانه الفوز لو لم ينهار تحت الضغط",
 "chokey": "سجن (عامية بريطانية (قديمة) تعني السجن)",
 "choking": "خنق (فعل خنق (شخص ما) عن طريق الضغط على القصبة الهوائية) / خَنَّاق, كَاتِم لِلْأَنْفَاس (يُسَبِّب صُعُوبَة فِي التَّنَفُّس خَاصَّةً بِسَبَب نَقْص الهَوَاء النَّقِيّ) / اختناق, غصة (حالة ناتجة عن انسداد الممرات الهوائية المؤدية إلى الرئتين (كما هو الحال مع الطعام أو تورم الحنجرة))\nمثال: لا يوجد دليل على أن الخنق تم بواسطة المتهم",
 "choking coil": "ملف خانق (ملف ذو مقاومة منخفضة ومحاثة عالية يستخدم في الدوائر الكهربائية لتمرير التيار المستمر وتخفيف التيار المتردد)",
 "choky": "خَانِق (ضَيِّق جِدًّا لِدَرَجَة الخَنْق) / سجن (عامية بريطانية (قديمة) تعني السجن)",
 "cholangiography": "تصوير القنوات الصفراوية (فحص بالأشعة السينية للقنوات الصفراوية بعد حقن وسيط تباين)",
 "cholangitis": "التهاب الأقنية الصفراوية (التهاب القنوات الصفراوية)",
 "cholecalciferol": "فيتامين د, كالسيفيرول (فيتامين قابل للذوبان في الدهون يمنع الكساح)",
 "cholecystectomy": "استئصال المرارة (إزالة جراحية للمرارة (عادة لتخفيف ألم حصوات المرارة))",
 "cholecystitis": "التهاب المرارة (التهاب المرارة)",
 "cholecystokinin": "كوليستوكينين (هرمون معدي معوي يحفز إفراز إنزيمات البنكرياس وانقباض وتفريغ المرارة)",
 "cholelithiasis": "تحصي المرارة, حصى المرارة (وجود حصوات في المرارة)",
 "cholelithotomy": "استخراج حصاة المرارة (إزالة حصوة المرارة من خلال شق في المرارة)",
 "choler": "خلط أصفر, صفراء (خلط كان يعتقد سابقاً أنه يفرز عن طريق الكبد ويسبب التهيج والغضب) / حنق, غضب (عاطفة قوية؛ شعور موجه نحو ظلم حقيقي أو مفترض) / تهيج, سرعة الغضب (شعور بالتهيج والنزق)",
 "cholera": "كُولِيرَا, هَيْضَة",
 "cholera infantum": "كوليرا الأطفال (شكل مميت غالبًا من التهاب المعدة والأمعاء يصيب الأطفال؛ ليس كوليرا حقيقية ولكن له أعراض مماثلة)",
 "cholera morbus": "التهاب معدي معوي حاد, مغص معوي (التهاب معدي معوي شديد مجهول السبب؛ يتميز بمغص شديد وقيء وإسهال)",
 "choleraic": "كوليري (يتعلق بـ أو ناتج عن أو يشبه الكوليرا)",
 "choleric": "حَادّ المِزَاج, سَرِيع الغَضَب (يتّصف بسرعة الغضب والانفعال) / حَادّ المِزَاج, سَرِيع الغَضَب (يُستثار إلى الغضب بسرعة) / حَادُّ الطَّبْع, سَرِيعُ الغَضَب (سَهْلُ الاسْتِفْزَازِ لِلْغَضَب)",
 "cholestasis": "انحباس الصفراء, ركود صفراوي (حالة يفرز فيها القليل من الصفراء أو لا تفرز على الإطلاق، أو ينسد تدفق الصفراء إلى الجهاز الهضمي)",
 "cholesterin": "كوليسترول (ستيرول حيواني يتم تصنيعه عادة عن طريق الكبد؛ وهو الستيرويد الأكثر وفرة في الأنسجة الحيوانية)",
 "cholesterol": "كُولِسْتِرُول",
 "cholesterosis cutis": "داء الورم الأصفر, ورم أصفر متعدد (أورام صفراء منتشرة (خاصة على المرفقين والركبتين)؛ ترتبط غالبًا باضطراب في استقلاب الدهون)",
 "cholic acid": "حمض الكوليك (حمض بلوري غير قابل للذوبان يوجد في الصفراء)",
 "choline": "كولين (فيتامين من مجموعة ب المركبة وهو مكون من مكونات الليسيثين؛ ضروري في استقلاب الدهون)",
 "cholinergic": "كوليني (يطلق أو ينشط بواسطة الأسيتيل كولين أو مركب ذي صلة)",
 "cholinesterase": "كولين استراز (إنزيم يحلل الأسيتيل كولين مائياً (إلى كولين وحمض الأسيتيك))",
 "cholla": "تشولا (صباريات شجرية ذات قطع ساق أسطوانية شائكة جداً؛ جنوب غرب الولايات المتحدة والمكسيك)",
 "choloepus didactylus": "كسلان ثنائي الأصابع (كسلان صغير نسبياً وسريع الحركة يمتلك مخلبين طويلين في كل قدم أمامية)",
 "choloepus hoffmanni": "كسلان هوفمان (كسلان من أمريكا الوسطى يمتلك مخلبين طويلين في كل قدم أمامية وثلاثة مخالب طويلة في كل قدم خلفية)",
 "chomp": "عض, قضم (فعل الإمساك أو المضغ بالأسنان والفكين)",
 "chomping": "قضم بصوت عال (فعل المضغ بصوت عال)",
 "chon": "تشون (100 تشون تساوي 1 وون في كوريا الشمالية) / تشون (100 تشون تساوي 1 وون في كوريا الجنوبية)",
 "chondrichthian": "سمكة غضروفية (أسماك قد يكون هيكلها متكلسًا ولكنه غير متعظم)",
 "chondrin": "كوندرين (مادة تشبه الجيلاتين ويتم الحصول عليها بغلي الغضروف في الماء)",
 "chondriosome": "متقدرة, ميتوكوندريا (عضية تحتوي على إنزيمات مسؤولة عن إنتاج الطاقة)",
 "chondrite": "نَيْزَك كُونْدْرِيتِيّ (صخر من أصل نيزكي يحتوي على كوندريت)",
 "chondritic": "حُبَيْبِيّ, كُونْدِرِيتِيّ (لديه هيكل حبيبي مثل هيكل الكوندريت (النيازك الحجرية))",
 "chondrodystrophy": "الودانة, لاتصنع غضروفي (اضطراب هيكلي وراثي يبدأ قبل الولادة حيث يتحول الغضروف إلى عظم مما يؤدي إلى التقزم)",
 "chondroma": "ورم غضروفي (ورم حميد شائع يتكون من خلايا غضروفية)",
 "chondrosarcoma": "ساركومة غضروفية (ورم خبيث في خلايا الغضاريف)",
 "chondrule": "حبيبة نيزكية, كوندرول (حبيبة صغيرة (من الكريسوليت مثلاً) توجد في بعض الصخور النيزكية)",
 "chondrus crispus": "طحلب أيرلندي, كاراجين (عشب بحري أرجواني داكن صالح للأكل من سواحل المحيط الأطلسي لأوروبا وأمريكا الشمالية)",
 "chongqing": "تْشُونْغْتْشِينْغ",
 "choo-choo": "تُوت تُوت",
 "choose": "اِخْتَارَ",
 "chooser": "مُخْتَار, مُنْتَقٍ (شخص يختار أو ينتقي)",
 "choosey": "اِنْتِقَائِيّ, صَعْب الإِرْضَاء (يَصْعُب إِرْضَاؤُه فِي اخْتِيَارَاته)",
 "choosy": "اِنْتِقَائِيّ, صَعْب الإِرْضَاء (يَصْعُب إِرْضَاؤُه فِي اخْتِيَارَاته)",
 "chop": "كرة قافزة (كرة أرضية ترتد عالياً في الهواء) / ضربة قاطعة (رد تنس يتم بحركة هبوطية تضع دوراناً خلفياً على الكرة) / فك (الفك (مصطلح عامي)) / شريحة لحم بضلع, كستليتة (قطعة صغيرة من اللحم تشمل جزءاً من الضلع)\nمثال: سأضربه على فكه",
 "chop shop": "ورشة تفكيك سيارات (مكان يتم فيه تفكيك السيارات المسروقة للحصول على قطع غيارها)",
 "chop shot": "ضربة قاطعة (رد تنس يتم بحركة هبوطية تضع دوراناً خلفياً على الكرة)",
 "chop steak": "شريحة برغر, شريحة لحم مفروم (قرص من اللحم البقري المفروم المطهو)",
 "chop suey": "تْشُوب سُوِي",
 "chop-chop": "يالا بنا",
 "chop-suey greens": "خضراوات الشوب سوي (أوراق خضراء داكنة عصارية وعطرية تستخدم في الطبخ الصيني والفيتنامي والياباني) / أقحوان تاجي مأكول, خضروات تشوب سوي (يزرع لأوراقه اللحمية الصالحة للأكل المستخدمة في الطهي الآسيوي)",
 "chopfallen": "خَائِبُ الأَمَل, مُنْكَسِر (مُنْخَفِضُ الرُّوحِ المَعْنَوِيَّة؛ مَكْسُورُ الخَاطِر)",
 "chophouse": "ستيك هاوس, مطعم شرائح اللحم (مطعم متخصص في شرائح اللحم)",
 "chopin": "شُوبَان",
 "chopine": "حذاء بنعل سميك, حذاء منصة (حذاء نسائي بنعل سميك جداً)",
 "chopped": "مُقَطَّع",
 "chopped steak": "شريحة برغر, شريحة لحم مفروم (قرص من اللحم البقري المفروم المطهو)",
 "chopper": "كرة قافزة (كرة أرضية ترتد عالياً في الهواء) / ساطور (سكين جزار له شفرة مربعة كبيرة) / مروحية, هليكوبتر (طائرة بدون أجنحة تحصل على رفعها من دوران شفرات علوية) / سن (مصطلحات غير رسمية للسن البشري)",
 "chopper knife": "ساطور, سكين تقطيع (سكين كبير يستخدم لتقطيع أو فرم اللحوم والخضروات، إلخ)",
 "choppiness": "تلاطم, مياه هائجة (يُستخدم لوصف البحر أثناء الطقس القاسي أو العاصف)",
