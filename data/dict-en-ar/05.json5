 "ceroplastics": "فن الشمع, نمذجة شمعية (فن التشكيل أو النمذجة بالشمع)",
 "cerotic acid": "حمض السيروتيك (حمض دهني صلب أبيض يوجد في الشموع (مثل شمع العسل))",
 "cerous": "سيري ثلاثي, سيريوز (من أو متعلق بـ أو يحتوي على السيريوم بتكافؤ 3)",
 "ceroxylon alpinum": "نخيل الشمع (نخيل من جبال الأنديز ينتج شمعاً راتنجياً يخلط مع الشحم لصنع الشموع)",
 "ceroxylon andicola": "نخيل الشمع (نخيل من جبال الأنديز ينتج شمعاً راتنجياً يخلط مع الشحم لصنع الشموع)",
 "cert": "يَقِين مُطْلَق (يقين تام)",
 "certain": "أَكِيد / مُتَأَكِّد / بَعْض ((بَعَضَه) البعوض بَعْضًا: لسعه وآذاه؛ (بَعَضَ) الشَّيْء: جعله أقساما) / مُحَدَّد (من الفعل حَدَّدَ؛ (في الرياضيات) مصطلح يستعمل في الجبر الخطي، ويتم تحديد محدد مصفوفة باستعمال صيغة لايبنتس أو صيغة لابلاس)\nمثال: لديك بعض الكتب.",
 "certainly": "بِالتَّأْكِيد / بِالتَّأْكِيد, بِدُون شَكّ",
 "certainty": "يَقِين (والقيد الأول جنس يشتمل إلى الظن أيضاً؛ والثاني يخرج الظن)\nمثال: اليقين الإيمان كله.",
 "certhia americana": "دابة الشجر البنية (دابة شجر شائعة في أمريكا الشمالية بمنقار منحني لأسفل)",
 "certhia familiaris": "دابة الشجر الأوروبية (دابة شجر أوروبية شائعة بنية وصفراء بمنقار منحني لأسفل)",
 "certifiable": "قَابِل لِلاعْتِمَاد (يمكن ضمانه أو التصديق عليه) / مُسْتَوْجِبٌ لِلحَجْر (يستوجب الإيداع في مصحّة عقليّة والمعاملة وفقًا لذلك)",
 "certificate": "شَهَادَة",
 "certificate of conduct": "شَهَادَة بَرَاءَة",
 "certificate of deposit": "شَهَادَة إِيدَاع, شَهَادَة اِدِّخَار",
 "certificate of incorporation": "شهادة التأسيس (موافقة الدولة على النظام الأساسي لتأسيس شركة)",
 "certificate of indebtedness": "التزام, سند دين (وعد مكتوب بسداد دين)",
 "certificated": "حَائِز عَلَى شَهَادَة, مُجَاز (مزوّد بشهادة أو مخوّل بموجبها)",
 "certification": "توثيق, مصادقة (التحقق من صحة أو أصالة شيء أو شخص ما) / توثيق, منح امتياز (فعل التصديق أو منح حق الامتياز لـ) / اعتماد, شهادة (وثيقة تشهد بصحة وقائع معينة مذكورة) / إثبات, تأييد (تأكيد صحة حقيقة أو بيان من خلال استخدام الأدلة الوثائقية)",
 "certificatory": "تَصْدِيقِيّ, تَوْثِيقِيّ (يخدم غرض التصديق أو الإقرار بشكل رسمي)",
 "certified": "مُعْتَمَد, مُوَثَّق (مقر رسمياً بأنه استوفى متطلبات معينة) / مُؤَهَّلٌ, مُعْتَمَدٌ (يحمل الوثائق اللازمة ومُسجَّل رسمياً لأداء وظيفة محددة) / مُسْتَوْجِبٌ لِلحَجْر (يستوجب الإيداع في مصحّة عقليّة والمعاملة وفقًا لذلك)\nمثال: محاسب قانوني معتمد",
 "certified check": "شيك مصدق (شيك يحتوي على تصديق بأن الشخص الذي أصدر الشيك لديه أموال كافية في الوديعة لتغطية الدفع)",
 "certified cheque": "شيك مصدق (شيك يحتوي على تصديق بأن الشخص الذي أصدر الشيك لديه أموال كافية في الوديعة لتغطية الدفع)",
 "certified milk": "حليب معتمد (حليب من مصانع ألبان تخضع لرقابة لجنة طبية معتمدة للحليب)",
 "certified public accountant": "محاسب قانوني معتمد (محاسب اجتاز اختبارات معينة واستوفى جميع المتطلبات القانونية والترخيص في ولاية أمريكية ليكون معتمداً من تلك الولاية)\nمثال: بالإضافة إلى المحاسبة والتدقيق، يقوم المحاسبون القانونيون المعتمدون بإعداد الإقرارات الضريبية للأفراد والشركات",
 "certiorari": "أمر نقل الدعوى (أمر قانون عام صادر عن محكمة عليا إلى محكمة ذات اختصاص أدنى تطلب فيه سجل قضية معينة)",
 "certitude": "ثقة مفرطة, يقين مطلق (اليقين التام أو اليقين الأكبر مما تبرره الظروف)",
 "cerulean": "أَزْرَق سَمَاوِيّ, لَازَوَرْدِيّ (ذو لون أزرق عميق مائل إلى البنفسجيّ كسماء أكتوبر الصافية) / سماوي, لازوردي (درجة فاتحة من الأزرق)",
 "cerulean blue": "أزرق سماوي, أزرق سيروليان (خضاب أزرق مخضر فاتح يتكون أساساً من أكاسيد الكوبالت والقصدير)",
 "cerumen": "شمع الأذن, صمغ الأذن (شمع أصفر ناعم تفرزه الغدد في قناة الأذن)",
 "ceruminous": "صملاخي (يتعلق بـ أو يفرز الصملاخ (شمع الأذن))",
 "ceruse": "أبيض الرصاص (خضاب أبيض سام يحتوي على الرصاص)",
 "cerussite": "خام الرصاص الأبيض, سيروسيت (معدن يتكون من كربونات الرصاص وهو مصدر مهم للرصاص)",
 "cervical": "عنقي (يتعلق بـ أو مرتبط بالرقبة) / عنقي (متعلق بعنق الرحم)\nمثال: سرطان عنق الرحم",
 "cervical artery": "شريان رقبي, شريان عنقي (شريان يغذي عضلات الرقبة)",
 "cervical canal": "قناة عنق الرحم (قناة مغزلية الشكل تمتد من الرحم إلى المهبل)",
 "cervical cap": "غطاء عنق الرحم (جهاز لمنع الحمل يتكون من كوب صغير على شكل كشتبان يوضع فوق عنق الرحم لمنع دخول الحيوانات المنوية)",
 "cervical disc syndrome": "متلازمة الجذر العنقي, متلازمة القرص العنقي (حالة غير طبيعية ناتجة عن ضغط جذور الأعصاب الشوكية في منطقة الرقبة؛ تتضمن آلام الرقبة وضعف العضلات والمذل)",
 "cervical glands": "غدد عنق الرحم (غدد مفرزة للمخاط في الغشاء المخاطي لعنق الرحم)",
 "cervical glands of the uterus": "غدد عنق الرحم (غدد مفرزة للمخاط في الغشاء المخاطي لعنق الرحم)",
 "cervical nerve": "عصب عنقي (أي من ثمانية أزواج من الأعصاب الشوكية الخارجة من القسم العنقي للحبل الشوكي)",
 "cervical plexus": "ضفيرة عنقية (ضفيرة عصبية تقع تحت العضلة القصية الترقوية الخشائية)",
 "cervical root syndrome": "متلازمة الجذر العنقي, متلازمة القرص العنقي (حالة غير طبيعية ناتجة عن ضغط جذور الأعصاب الشوكية في منطقة الرقبة؛ تتضمن آلام الرقبة وضعف العضلات والمذل)",
 "cervical smear": "اِخْتِبَارُ بَاب, مَسْحَةُ عُنُقِ الرَّحِم (عينة من إفرازات وخلايا سطحية لعنق الرحم والرحم؛ تفحص بالمجهر للكشف عن أي خلايا غير طبيعية)",
 "cervical vein": "وريد رقبي, وريد رقبي عميق (وريد يرافق شرياناً بنفس الاسم)",
 "cervical vertebra": "فَقَرَة عُنُقِيَّة",
 "cervicitis": "التهاب عنق الرحم (التهاب عنق الرحم)",
 "cervicofacial actinomycosis": "الفك المتكتل, داء الشعيات الرقبي الوجهي (أكثر أشكال داء الشعيات شيوعًا وأقلها خطورة؛ يصيب مناطق الوجه والرقبة)",
 "cervid": "أيل, ظبي (يتميز عن البقريات بامتلاك الذكر لقرون صلبة متساقطة)",
 "cervine": "أيّلي (يتعلق بـ أو يشبه الغزلان)",
 "cervix": "عُنُق اَلرَّحِم",
 "cervix uteri": "عنق الرحم (فتحة تشبه العنق للرحم)",
 "cervus elaphus": "أيل أحمر (أيل شائع في المناطق المعتدلة من أوروبا وآسيا)",
 "cervus elaphus canadensis": "إلكة أمريكية, وابيتي (أيل كبير في أمريكا الشمالية يتميز الذكر منه بقرون كبيرة كثيرة التفرع)",
 "cervus nippon": "أيل سيكا, أيل ياباني (أيل صغير في اليابان ذو قرون متشعبة قليلاً)",
 "cervus sika": "أيل سيكا, أيل ياباني (أيل صغير في اليابان ذو قرون متشعبة قليلاً)",
