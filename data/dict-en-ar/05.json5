 "chigetai": "حمار منغوليا البري, دزيجيتاي (حمار بري منغولي)",
 "chigger": "بق الحصاد, سوس الحصاد (يرقة سوس تمتص دم الفقاريات بما في ذلك البشر مسببة تهيجاً شديداً) / برغوث الرمل, شيغوة (برغوث استوائي صغير؛ تحفر الأنثى المخصبة تحت جلد العائل بما في ذلك البشر)",
 "chigger flower": "صقلاب درني, عشبة الفراشة (نبات معمر منتصب من شرق وجنوب الولايات المتحدة له زهور برتقالية بارزة)",
 "chiggerflower": "صقلاب درني, عشبة الفراشة (نبات معمر منتصب من شرق وجنوب الولايات المتحدة له زهور برتقالية بارزة)",
 "chignon": "كَعْكَة الشَّعْر (لفة من الشعر توضع عند مؤخرة العنق)",
 "chigoe": "برغوث الرمل, شيغوة (برغوث استوائي صغير؛ تحفر الأنثى المخصبة تحت جلد العائل بما في ذلك البشر)",
 "chigoe flea": "برغوث الرمل, شيغوة (برغوث استوائي صغير؛ تحفر الأنثى المخصبة تحت جلد العائل بما في ذلك البشر)",
 "chihuahua": "شِيوَاوَا",
 "chihuahuan spotted whiptail": "سحلية السوط المرقطة (تتميز بخطوط طولية مغطاة ببقع فاتحة؛ سحلية مرتفعات في جنوب غرب الولايات المتحدة والمكسيك)",
 "chilblain": "شَرَث, تَوَرُّم أَصَابِيع",
 "chilblained": "مُصاب بِتَشَقُّقات البَرْد (يُعاني مِن تَوَرُّمات ناتِجَة عَن البَرْد الشَّديد)",
 "chilblains": "تورم بردي, شرى البرد (التهاب اليدين والقدمين الناتج عن التعرض للبرد والرطوبة)",
 "child": "وَلَد, اِبْن (الرجلُ و المرأةُ ومثلهما الانسان: أنجب؛ الرجلُ و المرأةُ وَلَدًا: أنجبه)\nمثال: أعرف ذلك الولد.",
 "child abuse": "إِسَاءَة مُعَامَلَة لِلْأَطْفَال, إِسَاءَة مُعَامَلَة الْأَطْفَال",
 "child bride": "عُرُوس طِفْلَة",
 "child care": "رعاية الأطفال (خدمة تتضمن العناية بأطفال الآخرين)",
 "child labour": "عمالة الأطفال (مؤنث عَمَّال بمعنى صيغة مبالغة في العَمَل؛ في : هم العُمَّال؛ جمع عَامِل، وقد يكون جمع عَمَّال)",
 "child molestation": "إِسَاءَة جِنْسِيَّة لِلْأَطْفَال",
 "child molester": "لوطي بمراهق (رجل يمارس الجنس مع صبي)",
 "child neglect": "إهمال الأطفال (فشل القائمين على الرعاية في توفير الرعاية العاطفية والجسدية الكافية للطفل)",
 "child pornography": "استغلال الأطفال إباحيا, مواد إباحية للأطفال (الاستخدام غير القانوني للأطفال في الصور أو الأفلام الإباحية)",
 "child prodigy": "طفل عبقري (الصَغِير السِنّ من الحَيْوَان أو الإنْسَان، وَلَد الإنسان أو الحيوان؛ الإنسان منذ أن تلده أمه حتى يَبْلُغ)\nمثال: هو طفل العائلة.",
 "child psychology": "علم النفس النمائي, علم نفس الطفل (فرع علم النفس الذي يدرس التطور الاجتماعي والعقلي للأطفال)",
 "child support": "نفقة الطفل (دعم تأمر به المحكمة يدفعه أحد الزوجين للآخر الذي لديه حضانة الأطفال بعد انفصال الوالدين)",
 "child welfare agency": "وكالة رعاية الطفل (وحدة إدارية مسؤولة عن العمل الاجتماعي المعني برفاهية وتدريب الأطفال المهني)",
 "child welfare service": "وكالة رعاية الطفل (وحدة إدارية مسؤولة عن العمل الاجتماعي المعني برفاهية وتدريب الأطفال المهني)",
 "child's body": "جَسَدُ الطِّفْل (جسد طفل بشري)",
 "child's game": "لعبة أطفال (لعبة يستمتع بها الأطفال)",
 "child's play": "لعب (نشاط للأطفال يسترشد بالخيال أكثر من القواعد الثابتة) / أمر سهل, لعب أطفال (أي مشروع يسهل القيام به)\nمثال: آمن فرويد بفائدة اللعب للطفل الصغير",
 "child's room": "غرفة طفل (غرفة نوم للطفل)",
 "child-centered": "مُتَمَحْوِر حَوْلَ الطِّفْل (مُصمَّم لتعزيز صفات الطفل الشخصيّة بدلًا من تقديم التدريب أو المعلومات)",
 "childbearing": "إنجابي (يتعلق بـ أو مناسب للولادة) / وضع, ولادة (عملية الولادة عند البشر؛ إنجاب طفل)\nمثال: في سن الإنجاب",
 "childbed": "طلق, مخاض (المرحلة الختامية للحمل؛ من بداية الانقباضات حتى ولادة الطفل)\nمثال: كانت في المخاض لمدة ست ساعات",
 "childbed fever": "حمى النفاس (شكل خطير من الإنتان تصاب به المرأة أثناء الولادة أو الإجهاض (يُعزى عادةً إلى ظروف غير صحية)؛ كان واسع الانتشار سابقًا ولكنه الآن غير شائع)",
 "childbirth": "مَخَاض, وَضْع",
 "childbirth-preparation class": "دورة تحضير للولادة (دورة تعلم النساء الحوامل استخدام تقنيات التنفس والتركيز والتمارين لاستخدامها أثناء المخاض)",
 "childcare": "رعاية الأطفال (خدمة تتضمن العناية بأطفال الآخرين)",
 "childhood": "طُفُولَة",
 "childish": "طُفُولِيّ",
 "childishly": "بصبيانية (بطريقة طفولية)\nمثال: تصرف بصبيانية شديدة",
 "childishness": "صبيانية, طفولية (خاصية مميزة للطفل)",
 "childless": "أَبْتَر ((أَبْتَرَه) بَتَرَه؛ (أَبْتَرَ) الله فلَاناً: أعقَمَه)",
 "childlessness": "اللاإنجابية, عدم الإنجاب (حالة عدم وجود ذرية)",
 "childlike": "طُفُولِيّ (يليق بالطفل الصغير أو من سماته) / سَاذَج, طِفْلِيُّ البَرَاءَة (يُظهر بساطة طفوليّة وسذاجة في التصديق)",
 "childly": "طُفُولِيّ (يليق بالطفل الصغير أو من سماته)",
 "children of israel": "بَنُو إِسْرَائِيلَ / سورة الإسراء, سورة بني إسرائيل",
 "chile": "تْشِيلِي, شِيلِي",
 "chile bonito": "بونيتو المحيط الهادئ, بونيتو تشيلي (بونيتو شائع في ساحل المحيط الهادئ للأمريكتين؛ لحمه الزيتي الداكن يُعلب جيداً)",
 "chile hazel": "بندق تشيلي, جوز تشيلي (شجيرة تشيلية تحمل ثماراً حمراء مرجانية ببذرة صالحة للأكل تشبه البندق)",
 "chile nut": "بندق تشيلي, جوز تشيلي (شجيرة تشيلية تحمل ثماراً حمراء مرجانية ببذرة صالحة للأكل تشبه البندق)",
 "chile pine": "أروكاريا أروكانية, لغز القرد (صنوبرية تشيلية كبيرة دائمة الخضرة لها فروع متشابكة وتحمل مكسرات صالحة للأكل)",
 "chile tarweed": "عشبة القطران التشيلية, ماديا (عشبة من أمريكا الجنوبية ذات أوراق غدية لزجة؛ مصدر لزيت الماديا)",
 "chilean": "تشيلي, تشيلية",
 "chilean bonito": "بونيتو المحيط الهادئ, بونيتو تشيلي (بونيتو شائع في ساحل المحيط الهادئ للأمريكتين؛ لحمه الزيتي الداكن يُعلب جيداً)",
 "chilean cedar": "أرز تشيلي (شجرة صغيرة دائمة الخضرة من أمريكا الجنوبية لها لحاء نحاسي وأوراق جميلة)",
 "chilean firebush": "زهرة اللهب التشيلية, شجيرة النار التشيلية (تزرع لعرضها المتميز من الزهور الحمراء القرمزية الرائعة عادة؛ جبال الأنديز)",
 "chilean flameflower": "زهرة اللهب التشيلية, شجيرة النار التشيلية (تزرع لعرضها المتميز من الزهور الحمراء القرمزية الرائعة عادة؛ جبال الأنديز)",
 "chilean hazelnut": "بندق تشيلي, جوز تشيلي (شجيرة تشيلية تحمل ثماراً حمراء مرجانية ببذرة صالحة للأكل تشبه البندق)",
 "chilean jasmine": "ياسمين تشيلي (كرمة خشبية من الأرجنتين تزرع للزينة لأوراقها اللامعة وعناقيدها من الزهور البيضاء الكريمية الكبيرة العطرة قمعية الشكل)",
 "chilean monetary unit": "وحدة نقدية تشيلية (الوحدة النقدية في تشيلي)",
 "chilean nut": "بندق تشيلي, جوز تشيلي (شجيرة تشيلية تحمل ثماراً حمراء مرجانية ببذرة صالحة للأكل تشبه البندق)",
 "chilean peso": "بيزو, بيزو تشيلي (وحدة المال الأساسية في تشيلي؛ تساوي 100 سنتيسيمو)",
 "chilean rimu": "ريمو تشيلي (من أكثر أنواع المعلاقية تحملاً؛ شجيرة مفترشة تشبه الريمو الجبلي؛ تتواجد في جبال جنوب تشيلي)",
 "chilean strawberry": "فراولة الشاطئ, فراولة تشيلية (فراولة برية من غرب الولايات المتحدة وأمريكا الجنوبية؛ مصدر للعديد من أصناف الفراولة المزروعة)",
 "chili": "فِلْفِل حَار (حَبّ حريف يوضع في الطعام أو يطحن يستخدم كتابل. يكون منه أسود أو أبيض، حرارته متوسطة؛ فُلْفُل حَارّ: نبات ثمره حريف لونه أخضر وقد يحمرّ شديد الحرارة. يؤكل كما هو أو يجفف ويطحن ويستخدم كتابل)\nمثال: نحب الفلفل الحار.",
 "chili con carne": "تشيلي, تشيلي كون كارني (لحم بقر مفروم وفلفل حار أو مسحوق تشيلي غالباً مع الطماطم والفاصوليا الحمراء)",
 "chili dog": "تشيلي دوج (هوت دوج مع صلصة التشيلي كون كارني عليه)",
 "chili pepper": "شَطَّة",
 "chili powder": "مسحوق الفلفل الحار (مسحوق مصنوع من الفلفل الحار المطحون الممزوج بالكمون والثوم والأوريغانو)",
 "chili sauce": "تشيلي صوص, صلصة الفلفل الحار (طماطم وبصل وفلفل (حلو أو حار) مطبوخة مع الخل والسكر وتوابل مختلفة)",
 "chili vinegar": "خل الفلفل الحار (خل حار منكه بالفلفل الحار)",
 "chiliad": "أَلْف (العدد الأصلي الذي هو حاصل ضرب 10 في 100)",
 "chiliasm": "ألفية (الإيمان بالعقيدة المسيحية للألفية المذكورة في سفر الرؤيا)",
 "chiliast": "أَلْفِيّ, مُؤْمِن بِالْأَلْفِيَّة (شخص يؤمن بمجيء الألفية (وقت يسوده السلام والازدهار العظيم))",
 "chiliastic": "ألفي, مشحاني (متعلق بالإيمان بالألفية السعيدة (ألفية السلام والسعادة) أو المؤمنين بها)",
 "chill": "برودة شديدة, صقيع (برودة ناتجة عن بيئة باردة) / رجفة, رعشة (إحساس بالخوف يكاد يكون ممتعاً) / انقباض, وجوم (رهبة مفاجئة تسبب الشلل) / رجفة, قشعريرة (إحساس بالبرد غالباً ما يشير إلى بداية عدوى وتطور حمى)\nمثال: سرت فيه رعشة مفاجئة",
 "chill out": "إِسْتَرْخَى",
 "chiller": "أمر مرعب, مثير للقشعريرة (إثارة تجعل شعرك يقف أو تجمد عظامك)\nمثال: كان الفيلم مرعباً من الطراز القديم",
 "chilli": "فلفل تشيلي, فلفل حار (فلفل حار جداً ودقيق الاستدقاق ذو طعم لاذع خاص)",
 "chilli pepper": "فلفل تشيلي, فلفل حريف (نبات يحمل فلفلاً طويلاً حاراً جداً ومستدقاً بدقة؛ عادة ما يكون أحمر)",
 "chilliness": "برود, جفاء (نقص في المودة أو الحماس) / برودة خفيفة, نسمة باردة (خاصية أن يكون الشيء بارداً بشكل معتدل)\nمثال: برود مؤلم في النبرة والأسلوب",
 "chilling": "مرعبه, مخيف",
 "chills and fever": "بردية, حمى الملاريا (مراحل متعاقبة من القشعريرة والحمى وهي عرض للملاريا)",
 "chilly": "بَارِد, فَاتِرُ المَشَاعِر (لا يتّسم بالعاطفة) / بَارِد, جَافّ المُعَامَلَة (يَفْتَقِرُ إِلَى دِفْء المَشَاعِر) / بَارِد نَوْعًا مَا (بارد بشكل ملحوظ أو مُزعج) / فلفل تشيلي, فلفل حار (فلفل حار جداً ودقيق الاستدقاق ذو طعم لاذع خاص)",
 "chilomeniscus cinctus": "ثعبان الرمل المخطط (ثعبان رمل من جنوب غرب الولايات المتحدة؛ يعيش في الرمل الناعم إلى الخشن أو التربة الطينية التي 'يسبح' فيها؛ يشبه تخطيطه الثعابين المرجانية)",
 "chilopsis linearis": "شيلوبسيس, صفصاف صحراوي (شجرة شجيرية دائمة الخضرة تشبه الصفصاف في المناطق الجافة في جنوب غرب أمريكا الشمالية، لها زهور أرجوانية بارزة وقرون بذور طويلة)",
 "chiluba": "لُوبا (عضو في شعب بانتو في جنوب شرق الكونغو)",
 "chilver": "رَخْل, رِخْل",
 "chimaera": "خرافيات, كيميرا (سمكة تعيش في أعماق البحار ذات جسم مستدق وجلد أملس وذيل طويل يشبه الخيط) / خيال جامح, وهم (نتاج غريب للخيال) / خيمر, كمير ((الأساطير اليونانية) وحش أنثى ينفث النار برأس أسد وجسم ماعز وذيل ثعبان؛ ابنة تايفون)",
 "chimaera monstrosa": "خرافيات, سمك الأرنب (سمكة خرافية أوروبية كبيرة)",
 "chimakum": "تشيماكوم (فرد من شعب ساليش يعيش في شمال غرب واشنطن)",
 "chimaphila corymbosa": "حب في الشتاء, صنوبر الأمير الغربي (عشبة أوراسية بأزهار بيضاء أو وردية في عذقة طرفية)",
 "chimaphila umbellata": "حب في الشتاء, صنوبر الأمير الغربي (عشبة أوراسية بأزهار بيضاء أو وردية في عذقة طرفية)",
 "chimariko": "لغة تشيماريكو (لغة هوكان يتحدث بها شعب تشيماريكو) / شيماريكو (فرد من شعب هندي منقرض في أمريكا الشمالية كان يعيش سابقاً في كاليفورنيا)",
 "chimariko language": "لغة تشيماريكو (لغة هوكان يتحدث بها شعب تشيماريكو)",
 "chime": "جرس موسيقي, رنين (آلة إيقاعية تتكون من مجموعة من الأجراس المضبوطة التي تُضرب بمطرقة؛ تستخدم كآلة أوركسترالية)",
 "chimer": "شامار (معطف مبطن بالفرو ومزين بجديلة، كان يُرتدى في القرن السادس عشر)",
 "chimera": "خيال جامح, وهم (نتاج غريب للخيال) / خيمر, كمير ((الأساطير اليونانية) وحش أنثى ينفث النار برأس أسد وجسم ماعز وذيل ثعبان؛ ابنة تايفون)",
 "chimeral": "خرافي, وهمي (كونه أو يتعلق بـ أو يشبه الوهم (الخيمر))\nمثال: مدينته الفاضلة ليست دولة وهمية بل تحسين عملي لما هو موجود بالفعل",
 "chimeric": "خرافي, وهمي (كونه أو يتعلق بـ أو يشبه الوهم (الخيمر))\nمثال: مدينته الفاضلة ليست دولة وهمية بل تحسين عملي لما هو موجود بالفعل",
 "chimerical": "خُرَافِيّ",
 "chimichanga": "تْشِيمِيتْشَانْجَا",
 "chimney": "مَدْخَنَة",
 "chimney bellflower": "جريس هرمي, نبات المدخنة (زهرة الجرس من جنوب شرق أوروبا)",
 "chimney breast": "بروز المدخنة (جدران تبرز من جدار الغرفة وتحيط بقاعدة المدخنة)",
 "chimney corner": "ركن الموقد, زاوية المدفأة (زاوية بجانب الموقد)",
 "chimney plant": "جريس هرمي, نبات المدخنة (زهرة الجرس من جنوب شرق أوروبا)",
 "chimney swallow": "سنونو الحظائر (سنونو شائع في أمريكا الشمالية وأوروبا يعشش في الحظائر وما شابه) / سمامة المداخن (سمامة أمريكية تعشش في المداخن غير المستخدمة)",
 "chimney swift": "سمامة المداخن (سمامة أمريكية تعشش في المداخن غير المستخدمة)",
 "chimneypiece": "رف الموقد (رف يبرز من الجدار فوق الموقد)",
 "chimneypot": "وعاء المدخنة (أنبوب فخاري قصير في أعلى المدخنة لزيادة تيار الهواء)",
 "chimneystack": "رأس المدخنة (الجزء من المدخنة الذي يقع فوق السقف؛ وعادة ما يحتوي على عدة مجاري للدخان)",
 "chimneysweep": "منظف المداخن (شخص ينظف السخام من المداخن)",
 "chimneysweeper": "منظف المداخن (شخص ينظف السخام من المداخن)",
 "chimonanthus praecox": "بهار ياباني, حلوى الشتاء (شجيرة يابانية نفضية تزرع لأزهارها الصفراء العطرة)",
 "chimp": "شمبانزي (قرد ذكي يعيش جزئياً على الأشجار في الغابات الاستوائية الأفريقية)",
 "chimpanzee": "شِمْبَانْزِي",
 "chimwini": "شيمويني (لغة بانتو يتم التحدث بها في جنوب الصومال)",
 "chimwini language": "شيمويني (لغة بانتو يتم التحدث بها في جنوب الصومال)",
 "chin": "ذَقْن, دقن (الجزء الناتىء البارز في أسفل الوجه تحت الفم، وهو منبت اللِحْيَة عند الرَجُل؛ كناية اللِحْيَة)",
 "chin language": "لغات كوكي-تشين (لغات كاماروبان يتم التحدث بها في غرب بورما وبنغلاديش وأقصى شرق الهند)",
 "chin music": "ثرثرة, كلام تافه (حديث عاطل أو أحمق وغير ذي صلة)",
 "chin rest": "مسند الذقن (مسند يضع عليه عازف الكمان ذقنه)",
 "chin strap": "حزام الذقن (شريط متصل بقبعة؛ يمر تحت الذقن ويثبت القبعة في مكانها)",
 "chin wag": "أحاديث جانبية, ثرثرة خفيفة (محادثة غير رسمية خفيفة للمناسبات الاجتماعية)",
