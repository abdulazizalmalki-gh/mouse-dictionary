 "chaotically": "بِفَوْضَوِيَّة (بطريقة توحي بالفوضى) / بِتَخَبُّط (بطريقة جامحة ومربكة)\nمثال: كانت الغرفة غير منظمة بشكل فوضوي",
 "chap": "شَاب, رَجُل",
 "chaparral": "أدغال, شجيرات قصيرة (نباتات كثيفة تتكون من أشجار متقزمة أو شجيرات)",
 "chaparral broom": "شجيرة القيوط, فرشاة القيوط (شجيرة دائمة الخضرة واسعة الانتشار في جنوب غرب الولايات المتحدة ذات رؤوس زهور في عنقود ورقي)",
 "chaparral cock": "جوال الطريق (طائر سريع يعيش بشكل كبير على الأرض يوجد من كاليفورنيا والمكسيك إلى تكساس)",
 "chaparral mallow": "خبازة الشابارال (شجيرة من السلاسل الساحلية لولاية كاليفورنيا وباجا كاليفورنيا لها فروع مشعرّة وسنابل من العديد من الزهور البنفسجية)",
 "chaparral pea": "بازلاء الشابارال (شجيرة دائمة الخضرة شائكة تتحمل الجفاف، لها زهور وردية وأرجوانية بارزة وتشكل غابات كثيفة؛ تنمو في المنحدرات الجبلية الصخرية الجافة في كاليفورنيا)",
 "chaparral sage": "ميرمية أرجوانية, ميرمية الشابارال (عشب كاليفورني ذو أوراق فضية وزهور أرجوانية)",
 "chapati": "تشباتي, شباتي (خبز مسطح يشبه الفطيرة يطهى على صاج)",
 "chapatti": "تشباتي, شباتي (خبز مسطح يشبه الفطيرة يطهى على صاج)",
 "chapeau": "قبعة (غطاء رأس يحمي الرأس من الطقس السيء؛ له تاج مشكّل وعادة حافة)",
 "chapel": "مُصَلًّى, كَنِيسَة (موضع الصلاة للشخص والجماعة؛ غرفة تخصص للصلاة في الأماكن العامّة، لا إمام فيها وهي دون المسجد)",
 "chapel service": "خدمة الكنيسة الصغيرة (خدمة تقام في مكان عبادة له مذبحه الخاص)\nمثال: تأخر عن الكنيسة الصغيرة",
 "chapelgoer": "غير ملتزم, منشق عن الكنيسة الرسمية (بروتستانتي في إنجلترا ليس عضواً في كنيسة إنجلترا)",
 "chaperon": "مُرافِق, مُشْرِف (شخص يرافق ويشرف على فتاة شابة أو تجمع للشباب لضمان السلوك القويم)",
 "chaperone": "مُرافِق, مُشْرِف (شخص يرافق ويشرف على فتاة شابة أو تجمع للشباب لضمان السلوك القويم)",
 "chapfallen": "خَائِبُ الأَمَل, مُنْكَسِر (مُنْخَفِضُ الرُّوحِ المَعْنَوِيَّة؛ مَكْسُورُ الخَاطِر)",
 "chapiter": "تاج العمود (الجزء العلوي من العمود الذي يدعم السطح المعمد)",
 "chaplain": "قِسِّيس, قَسّ (الذي يُقَسِّس الإبل أو الماشية أو الغنم، أي يحسن رعايتها، الراعي؛ عند المَسِيْحِيِّيْن هو لقب فوق الشَمَّاس ودون الأُسْقُف وهو القَسّ)",
 "chaplaincy": "إرشاد ديني, وظيفة القس (منصب القس أو المرشد الديني (خاصة في المؤسسات))",
 "chaplainship": "إرشاد ديني, وظيفة القس (منصب القس أو المرشد الديني (خاصة في المؤسسات))",
