 "cattle boat": "سفينة نقل المواشي (سفينة شحن لنقل الماشية)",
 "cattle breeding": "تربية الماشية (تربية الأبقار والمواشي)",
 "cattle brush": "فرشاة الأبقار (فرشاة ثابتة أو دوارة تتكون عادة من فرشاة أفقية وأخرى رأسية تستخدمها الأبقار للحك والتنظيف)",
 "cattle cake": "قرص علف, كسب (علف مركز للماشية؛ يعالج ويشكل في هيئة كتل أو أقراص)",
 "cattle car": "عربة ماشية (عربة شحن لنقل الماشية)",
 "cattle drive": "سوق الماشية (سوق قطيع من الأبقار (أبقار أو ثيران))",
 "cattle egret": "أبو قردان, بلشون القطعان (بلشون أبيض صغير واسع الانتشار في المناطق الدافئة غالباً ما يوجد حول حيوانات الرعي)",
 "cattle farm": "مزرعة مواشي (مزرعة تتكون من مساحة كبيرة من الأرض مع المرافق اللازمة لتربية الماشية (وخاصة الأبقار))",
 "cattle grid": "حاجز مواشي (جسر فوق خندق يتكون من قضبان معدنية متوازية تسمح للمشاة والمركبات بالمرور، ولكن ليس الماشية)",
 "cattle guard": "حاجز مواشي (جسر فوق خندق يتكون من قضبان معدنية متوازية تسمح للمشاة والمركبات بالمرور، ولكن ليس الماشية)",
 "cattle pen": "حظيرة أبقار, زريبة بقر (حظيرة للأبقار)",
 "cattle plague": "طاعون الماشية (مرض فيروسي معد حاد يصيب الماشية (غالباً ما يكون قاتلاً)؛ يتميز بالحمى والإسهال والتهاب الأغشية المخاطية)",
 "cattle ranch": "مزرعة مواشي (مزرعة تتكون من مساحة كبيرة من الأرض مع المرافق اللازمة لتربية الماشية (وخاصة الأبقار))",
 "cattle thief": "سارق المواشي (شخص يسرق المواشي (خاصة الأبقار))",
 "cattle trail": "مسار الماشية (درب كانت تُساق عبره الماشية إلى السوق)",
 "cattleman": "مربي ماشية (رجل يربي (أو يرعى) الماشية) / راعي بقر, راعي ماشية (عامل أجير ذكر يرعى الماشية ويؤدي واجبات أخرى على ظهر الخيل)",
 "cattleship": "سفينة نقل المواشي (سفينة شحن لنقل الماشية)",
 "cattlewoman": "مربية ماشية (امرأة تقوم بتربية (أو رعاية) الماشية)",
 "cattley guava": "جوافة الفراولة الأرجوانية, جوافة كاتلي (شجرة شجيرية استوائية صغيرة تحمل ثماراً بيضاوية حمراء داكنة)",
 "cattleya": "قَطَلَة, مَلاعِقِيَّة",
 "cattleya citrina": "أوركيد التوليب (أوركيد هوائي مكسيكي بأوراق خضراء رمادية مزرقة وزهور ليمونية إلى صفراء ذهبية تظهر مفتوحة جزئياً فقط؛ يوضع أحياناً في جنس كاتليا)",
 "catty": "لَئِيم, لَذَّاع (يتسم بالخبث أو ناتج عنه) / كاتي (أي من وحدات الوزن المختلفة المستخدمة في جنوب شرق آسيا (خاصة مقياس صيني يساوي 500 غرام))",
 "catty-corner": "مَائِلٌ قُطْرِيًّا عَبْرَ الزَّاوِيَة (مُنْحَرِفٌ عَبْرَ مُضَلَّعٍ عَلَى خَطٍّ قُطْرِيّ)",
 "catty-cornered": "مَائِلٌ قُطْرِيًّا عَبْرَ الزَّاوِيَة (مُنْحَرِفٌ عَبْرَ مُضَلَّعٍ عَلَى خَطٍّ قُطْرِيّ)",
 "catwalk": "جسر مشاة, ممشى ضيق (ممر ضيق مرتفع في الهواء (كما فوق خشبة مسرح أو بين أجزاء مبنى أو على طول جسر)) / ممشى العارضات (منصة ضيقة تمتد داخل قاعة)\nمثال: عرضت العارضات الملابس على ممشى العرض في عرض الأزياء",
 "caucasian": "قَوْقَازِيّ / يَافِثِيّ, أَحْمَرِيّ",
 "caucasian azerbaijan": "أَذَرْبَيْجَان الْقَوْقَازِيَّة",
 "caucasian language": "اللغات القوقازية (عدد من اللغات التي يتم التحدث بها في القوقاز ولا ترتبط باللغات التي يتم التحدث بها في أماكن أخرى)",
 "caucasian race": "العرق الأبيض, قوقازيون (عرق ذو بشرة فاتحة)",
 "caucasian walnut": "جوز قوقازي (شجرة قوقازية متوسطة الحجم كثيرة التفرع تتميز عن أشجار الجوز الأخرى بفاكهتها المجنحة)",
 "caucasic": "قوقازي (متعلق بمنطقة القوقاز الجغرافية)\nمثال: اللغات القوقازية",
 "caucasoid": "قَوْقَازِيّ (مُتعلق بالشعوب القوقازية أو منتمٍ إليها)",
 "caucasoid race": "العرق الأبيض, قوقازيون (عرق ذو بشرة فاتحة)",
 "caucasology": "دِرَاسَة الْقَوْقَاز (تحصيل المعرفة، التَّعَلُّم؛ بحث أكاديمي)\nمثال: تعبت من الدراسة.",
 "caucasus": "اَلْقَوْقَاز, القُفْقَاز / اَلْقَوْقَاز",
 "caucus": "اِجْتِمَاع حِزْبِيّ مُغْلَق, مُؤْتَمَر حِزْبِيّ (اجتماع سياسي مغلق)",
 "cauda": "ذَيْل (أي بنية تشبه الذيل)",
 "caudal": "ذَنَبِيّ, ذَيْلِيّ",
 "caudal anaesthesia": "تخدير ذيلي (تخدير ناحي ناتج عن حقن مخدر في النهاية الذيلية للقناة الشوكية؛ تم استبداله إلى حد كبير بالتخدير فوق الجافية)",
 "caudal anesthesia": "تخدير ذيلي (تخدير ناحي ناتج عن حقن مخدر في النهاية الذيلية للقناة الشوكية؛ تم استبداله إلى حد كبير بالتخدير فوق الجافية)",
 "caudal appendage": "زائدة ذيلية (ذيل خاصة للثدييات يقع خلف وفوق فتحة الشرج)",
 "caudal block": "تخدير ذيلي (تخدير ناحي ناتج عن حقن مخدر في النهاية الذيلية للقناة الشوكية؛ تم استبداله إلى حد كبير بالتخدير فوق الجافية)",
 "caudal fin": "زعنفة ذيلية (ذيل الأسماك وبعض الفقاريات المائية الأخرى)",
 "caudal vertebra": "فقرة عصعصية (واحدة من 4 فقرات في العصعص البشري)",
 "caudally": "ذيلياً (باتجاه النهاية الخلفية للجسم)",
 "caudate": "ذُو ذَيْل, مُذَنَّب (لديه ذيل أو زائدة تشبه الذيل) / ذوات الذيل (برمائيات تشبه السحالي) / مُذَنَّب ((عن شكل الورقة) يتدرَّج تدريجيًّا إلى طرف طويل يُشبه الذَّنَب) / نواة مذنبة (عقدة قاعدية على شكل ذيل تقع في بطين جانبي للدماغ)",
 "caudate nucleus": "نواة مذنبة (عقدة قاعدية على شكل ذيل تقع في بطين جانبي للدماغ)",
 "caudated": "ذُو ذَيْل, مُذَنَّب (لديه ذيل أو زائدة تشبه الذيل)",
 "caudex": "ساق (الساق الخشبية للنخيل وسراخس الأشجار) / أصل, جذع (ساق سميكة مستمرة لنبات معمر عشبي)",
 "caul": "برقع, غشاء جنيني (الغشاء الداخلي للأجنة في الفقاريات العليا (خاصة عندما يغطي الرأس عند الولادة)) / ثرب كبير (جزء من الصفاق متصل بالمعدة والقولون ويغطي الأمعاء)",
 "cauldron": "قِدْر (قضاء الله وحكمه وما قَدَّرَه؛ مبلغ الشيء وكميتّه، بنفس معنى قَدْر)\nمثال: خذ قدر ما تريد.",
 "caulerpa": "زُوحِيفَان",
 "caulescent": "ذُو سَاق, سَاقِيّ ((للنباتات) تنتج ساقاً متطورة فوق الأرض)",
 "cauliflower": "قَرْنَبِيط, قُنَّبِيط",
 "cauliflower ear": "أذن قرنبيطية (صيوان أذن مشوه بسبب إصابة؛ شائع بين الملاكمين)",
 "cauliflower soup": "شوربة القرنبيط (حساء مصنوع من القرنبيط)",
 "cauline": "سَاقِيّ (خاصة للأوراق؛ تنمو على ساق خاصة في الجزء العلوي من الساق) / ذُو سَاق, سَاقِيّ ((للنباتات) تنتج ساقاً متطورة فوق الأرض)\nمثال: أوراق ساقية",
 "caulk": "جلفطة, مادة سد الشقوق (حشو ومانع تسرب مقاوم للماء يستخدم في البناء والإصلاح لجعله غير منفذ للماء)",
 "caulked": "مسدود الشقوق, مُقلفط (تم سد شقوقه وفجواته بحشوة)",
 "caulking": "جلفطة, مادة سد الشقوق (حشو ومانع تسرب مقاوم للماء يستخدم في البناء والإصلاح لجعله غير منفذ للماء)",
 "caulophyllum thalictrioides": "جذر التوت الأزرق, كوهوش أزرق (عشبة طويلة من شرق أمريكا الشمالية وآسيا لها ثمار تشبه التوت الأزرق وجذمور سميك وعقدي كان يستخدم طبياً سابقاً)",
 "caulophyllum thalictroides": "جذر التوت الأزرق, كوهوش أزرق (عشبة طويلة من شرق أمريكا الشمالية وآسيا لها ثمار تشبه التوت الأزرق وجذمور سميك وعقدي كان يستخدم طبياً سابقاً)",
 "causa": "دعوى قضائية, قضية (مصطلح شامل لأي إجراء في محكمة قانونية حيث يسعى الفرد للحصول على انتصاف قانوني)",
 "causal": "سَبَبِيّ, عِلِّيّ (يتضمّن أو يشكّل سببًا؛ مُسبِّب)",
 "causal agency": "سَبَب, عَامِل مُسَبِّب (أيّ كيان يُحدِث أثرًا أو يكون مسؤولًا عن أحداث أو نتائج)",
 "causal agent": "سَبَب, عَامِل مُسَبِّب (أيّ كيان يُحدِث أثرًا أو يكون مسؤولًا عن أحداث أو نتائج)",
 "causal factor": "عامل حاسم, محدد (عنصر أو عامل محدد أو سببي)\nمثال: التعليم هو محدد مهم لنظرة المرء للحياة",
 "causalgia": "ألم حارق, حرق (ألم حارق في طرف على طول مسار العصب المحيطي؛ يرتبط عادة بتغيرات الجلد)",
 "causality": "سَبَبِيَّة, عليَة",
 "causally": "سببياً (بطريقة سببية)\nمثال: قوى فعالة سببياً",
 "causation": "إحداث, تسبيب (فعل التسبب في حدوث شيء ما)",
 "causative": "عِلِّيّ, مُسَبِّب (ينتج تأثيراً)\nمثال: الفقر كعامل مسبب للجريمة",
 "cause": "قَضِيَّة (الأمر أو الشيء المُعَقَّد؛ في : ما يقضي فيه القاضي) / سَبَّبَ ((سَبَّبَه): أَكثر سَبَّه؛ (سَبَّبَ) الأسبَاب: أوجدها)\nمثال: سأرفع عليك قضية.",
 "cause celebre": "حادثة شهيرة, قضية رأي عام (حادثة تجذب اهتماماً عاماً كبيراً)",
 "cause of action": "سبب الدعوى (مطالبة كافية لطلب الانتباه القضائي؛ الوقائع التي تؤدي إلى حق اتخاذ إجراء قانوني)",
 "cause of death": "سَبَب مَوْت, سَبَب وَفَاة ((سَبَّبَه): أَكثر سَبَّه؛ (سَبَّبَ) الأسبَاب: أوجدها)\nمثال: سامي كان السبب.",
 "causeless": "اتِّفَاقِيّ, بِلَا سَبَب (ليس له سبب أو سبب ظاهر) / بِلَا سَبَب, بِلَا مُبَرِّر (ليس له سبب أو مبرر يبرره)",
 "causerie": "أحاديث جانبية, ثرثرة خفيفة (محادثة غير رسمية خفيفة للمناسبات الاجتماعية)",
 "causeway": "جسر, طريق مرتفع (طريق مرفوع فوق الماء أو المستنقعات أو الرمال)",
 "causing": "إحداث, تسبيب (فعل التسبب في حدوث شيء ما)",
 "caustic": "أَكَّال, كَاوٍ ((عَنْ مَادَّةٍ، خَاصَّةً حَمْضٍ قَوِيٍّ) قَادِرٌ عَلَى إِتْلَافِ المَوَادِّ أَوْ تَآكُلِهَا) / حَارِق, لَاذِع (قاسٍ أو كاوٍ في اللهجة) / مادة كاوية (أي مادة كيميائية تحرق أو تدمر الأنسجة الحية) / محرقة, منحنى كاوٍ (غلاف أشعة الضوء المنعكسة أو المنكسرة بواسطة سطح منحني)",
 "caustic lime": "جير, هيدروكسيد الكالسيوم (مادة كاوية تنتج عن تسخين الحجر الجيري)",
 "caustic potash": "بوتاس, بوتاس كاوٍ (مركب للبوتاسيوم يستخدم غالباً في الزراعة والصناعة)",
 "caustic remark": "تَهَكُّم, سُخْرِيَة (لغة بارعة تستخدم لتوجيه الإهانات أو الازدراء)\nمثال: استخدم السخرية لإزعاج خصمه",
 "caustic soda": "الصودا الكاوية, هيدروكسيد الصوديوم (مادة كاوية قلوية قوية تستخدم في تصنيع الصابون والورق والألومنيوم ومركبات الصوديوم المختلفة)",
 "caustically": "بِحِدَّة, بِلَاذِعِيَّة (بطريقة لاذعة وحادة)\nمثال: خاطبها بحدة",
 "cauterant": "مادة كاوية, مكواة (أداة أو مادة تستخدم لتدمير الأنسجة لأسباب طبية (مثل إزالة الثؤلول) عن طريق حرقها بمكواة ساخنة أو تيار كهربائي أو مادة كاوية أو عن طريق تجميدها)",
 "cauterisation": "كي (فعل تخثير الدم وتدمير الأنسجة بحديد ساخن أو عامل كاوٍ أو بالتجميد)",
 "cauterization": "كي (فعل تخثير الدم وتدمير الأنسجة بحديد ساخن أو عامل كاوٍ أو بالتجميد)",
 "cautery": "كي (فعل تخثير الدم وتدمير الأنسجة بحديد ساخن أو عامل كاوٍ أو بالتجميد) / مادة كاوية, مكواة (أداة أو مادة تستخدم لتدمير الأنسجة لأسباب طبية (مثل إزالة الثؤلول) عن طريق حرقها بمكواة ساخنة أو تيار كهربائي أو مادة كاوية أو عن طريق تجميدها)",
 "caution": "حَذَر, حِيطَة (حذِر الشّخصُ: تيقّظ واستعدّ وتأهّب وتنبّه؛ حذِر الأمرَ: كَتَمَه وأخفاه) / حَذَر (حذِر الشّخصُ: تيقّظ واستعدّ وتأهّب وتنبّه؛ حذِر الأمرَ: كَتَمَه وأخفاه)\nمثال: قد بحذر من فضلك.",
 "caution - slippery when wet": "تحذير - الأرض زلقة عندما تكون رطبة",
 "cautionary": "إِنْذَارِيّ, تَحْذِيرِيّ (يُستخدَم للتحذير والتنبيه) / تَحْذِيرِيّ, وِقَائِيّ (يصدّ ويمنع الأخطار أو الأضرار)",
 "cautious": "وَرِع, حَذِر (تَحَرَّجَ من أن يأتي إِثْما وابتعد عن المعاصي)",
 "cautious statement": "بيان حذر (بيان يتم الإدلاء به مع تحفظات دقيقة)",
 "cautiously": "بِحَذَر, بِعِنَايَة (كما لو كان بقفازات ناعمة؛ بحذر أو حكمة أو لباقة) / بِتَحَفُّظ, بِشَكْل مُحَافِظ (بطريقة متحفظة)\nمثال: نزلت الدرج بحذر",
 "cautiousness": "حذر, حيطة (سمة كون المرء حذراً؛ الانتباه للخطر المحتمل)",
 "cavalaire": "كافالير",
 "cavalcade": "مَوْكِب خَيَّالَة (موكب من الناس يسافرون على ظهور الخيل)",
 "cavalier": "غَيْر مُكْتَرِث (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "cavalier hat": "قبعة الفرسان, قبعة مرنة (قبعة لباد ناعمة بحافة مرنة واسعة)",
 "cavalierly": "بِازْدِرَاء, بِتَعَالٍ (بطريقة فخورة ومتسلطة)\nمثال: عامل موظفيه بتعالٍ",
 "cavalla": "كافالا, ماكريل الملك (ماكريل كبير ذو خطم مدبب طويل؛ سمكة طعام وصيد مهمة في ساحل المحيط الأطلسي الشرقي جنوباً إلى البرازيل)",
 "cavalry": "فَارِس, سِلَاح الفُرْسَان (اسم فاعل لفَرَسَ؛ راكب الفَرَس أو الحِصَان)\nمثال: فارس الظلام فيلم جيد.",
 "cavalry horse": "حصان سلاح الفرسان (حصان مدرب للمعركة)",
 "cavalry soldier": "جندي خيال, فارس (جندي يمتطي صهوة جواد)\nمثال: الخيال يعتني دائماً بجواده جيداً",
 "cavalry sword": "سيف الفرسان, سيف مقوس (سيف قوي ذو نصل منحني وظهر سميك)",
 "cavalryman": "جندي سلاح الفرسان, خيال (جندي ذكر يمتطي حصاناً) / جندي مدرعات (جندي ذكر في وحدة جيش آلية)",
 "cavalrywoman": "جندية مدرعات (جندية أنثى في وحدة جيش آلية) / فارسة (جندية أنثى تمتطي حصاناً)",
 "cave": "كَهْف, غَار",
 "cave bat": "خفاش الكهف, خفاش شاحب (خفاش كبير الأذن مصفر باهت يعيش في الكهوف)",
 "cave dweller": "ساكن الكهوف (شخص يعيش في كهف)",
 "cave in": "انخساف, هبوط أرضي (الانهيار المفاجئ لشيء ما في تجويف تحته)",
 "cave man": "رجل الكهف (رجل يعيش في كهف)",
 "cave myotis": "خفاش الكهف (خفاش صغير من جنوب غرب الولايات المتحدة يعيش في الكهوف وما إلى ذلك)",
 "cave woman": "امرأة الكهف (امرأة تعيش في كهف)",
 "caveat": "اعتراض, تحذير قانوني ((قانون) إشعار رسمي يتم تقديمه إلى محكمة أو مسؤول لتعليق إجراء حتى يتم منح مقدم الطلب جلسة استماع) / تحذير, تنبيه (تحذير ضد أفعال معينة)\nمثال: اعتراض مقدم ضد التصديق على وصية",
 "caveat emptor": "عَلَى الْمُشْتَرِي أَن يَحْذَر, مَسْؤُولِيَّة الْمُشْتَرِي (مبدأ تجاري ينص على أنه بدون ضمان يتحمل المشتري نفسه مخاطر الجودة)",
 "caveman": "رَجُل كَهْف (العُضْو في جسد الإنسان يتكون من القَدَم والسَاق والفُخْذ. الجمع أرجُل، وقد تقول العامّة رِجْلين ورجْلينات؛ القَدَم من باب اطلاق اسم الكل على الجزء)\nمثال: هذا الرجل تاجر.",
 "cavern": "كهف كبير, مغارة (كهف كبير أو غرفة كبيرة داخل كهف) / كهف, مغارة (أي مساحة مغلقة مظلمة وكبيرة)\nمثال: كانت عيناه كهوفاً مظلمة",
 "cavernous": "كَهْفِيّ, نَاعِظ (مملوء بجيوب وعائية وقابل للانتصاب عند امتلائه بالدم) / كَهْفِيّ (يشبه الكهف أو يوحي به في اتّساعه وعمقه)",
 "cavernous sinus": "جيب كهفي (أي من زوج من الجيوب الوريدية الكبيرة في تجويف الجمجمة)",
 "cavetto": "تجويف ربع دائري (إطار مقعر على شكل ربع دائرة في المقطع العرضي)",
 "cavewoman": "امرأة الكهف (امرأة تعيش في كهف)",
 "cavia cobaya": "خنزير غينيا (كافياء مستأنسة ممتلئة الجسم تكاد تكون عديمة الذيل؛ غالباً ما تُربى كحيوان أليف وتستخدم على نطاق واسع في الأبحاث)",
 "cavia porcellus": "كافياء برية (كافياء من أمريكا الجنوبية؛ ربما تكون سلف خنزير غينيا المستأنس)",
 "caviar": "كَافْيَار / خِبْيَارِيّ",
 "caviare": "كافيار (بطارخ مملحة لسمك الحفش أو أسماك كبيرة أخرى؛ يقدم عادة كمقبلات)",
 "cavil": "جدل بيزنطي, مماحكة (التهرب من نقطة الجدال عن طريق إثارة تمييزات أو اعتراضات غير ذات صلة)",
 "caviler": "مُتَفَذْلِك, مُعْتَرِض على الصغائر (مجادل يركز على التفاهات؛ شخص يثير اعتراضات تافهة ومزعجة)",
 "caviller": "مُتَفَذْلِك, مُعْتَرِض على الصغائر (مجادل يركز على التفاهات؛ شخص يثير اعتراضات تافهة ومزعجة)",
 "cavitied": "سِنْخِيّ, مُجَوَّف (مليء بتجاويف تشبه الخلايا (كقرص العسل))",
 "cavity": "تَجْوِيف",
 "cavity resonator": "حجرة رنين, رنان (حجرة مجوفة تسمح أبعادها بالتذبذب الرنيني للموجات الكهرومغناطيسية أو الصوتية)",
 "cavity wall": "جدار مجوف (جدار مكون من طبقتين من البناء مع وجود مسافة بينهما)",
 "caviuna wood": "جاكاراندا, خشب الورد البرازيلي (شجرة أخشاب برازيلية مهمة تنتج خشباً ثقيلاً صلباً داكن اللون مخططاً بالأسود)",
 "cavum": "تجويف, تجويف جسدي ((في التشريح) فراغ طبيعي أو جيب داخل الجسم)",
 "cavy": "كافياء (قارض من أمريكا الجنوبية قصير الذيل وخشن الشعر)",
 "caw": "نَعْق, نَعِيق / نَعَقَ",
 "cay": "جزيرة مرجانية منخفضة, كي (شعاب مرجانية قبالة الساحل الجنوبي لفلوريدا)",
 "cayenne": "كَايِين",
 "cayenne jasmine": "عناقية, عين البزون (عشب خشبي من العالم القديم يزرع عادة وله أزهار كبيرة وردية إلى حمراء)",
 "cayenne pepper": "فلفل حريف, فلفل كايين (فلفل أحمر حار طويل وملتوي غالباً) / فلفل أحمر, فلفل حريف (قرون وبذور مطحونة للفلفل الأحمر اللاذع) / فلفل تشيلي, فلفل حريف (نبات يحمل فلفلاً طويلاً حاراً جداً ومستدقاً بدقة؛ عادة ما يكون أحمر)",
 "cayman": "كايمان (زاحف شبه مائي من أمريكا الوسطى والجنوبية يشبه القاطور ولكن له بطن مدرع بشكل أثقل)",
 "cayman islands": "جُزُر كَايْمَان (جَزَرَ الماءُ عن الأَرضِ يَجْزُرُ جَزْراً: نَضَبَ وحَسَرَ؛ ويقال: جَزَرَ البَحْرُ والنَّهْرُ: انْحسرَ ماؤُهُ)\nمثال: ضع الجزر في القدر.",
 "cayman islands dollar": "دولار جزر كايمان (وحدة المال الأساسية في جزر كايمان)",
 "cayuga": "لغة كايوجا (اللغة الإيروكوية التي يتحدث بها شعب كايوجا) / كايوغا (فرد من شعب إيروكواس كان يعيش سابقاً حول بحيرة كايوغا في ولاية نيويورك)",
 "cayuga language": "لغة كايوجا (اللغة الإيروكوية التي يتحدث بها شعب كايوجا)",
 "cayuse": "كايوس (حصان مراعي محلي صغير)",
 "cazique": "كاسيك (صفاريات سوداء وحمراء أو سوداء وصفراء من المناطق الاستوائية الأمريكية)",
 "cbc": "تعداد الدم الكامل (عد عدد خلايا الدم البيضاء والحمراء والصفائح الدموية في 1 ملليمتر مكعب من الدم)",
 "cbr": "إشعاع الخلفية الكونية ((في علم الكونيات) البقايا المبردة للانفجار العظيم الحار التي تملأ الكون بأسره ويمكن رصدها اليوم بمتوسط درجة حرارة حوالي 2.725 كلفن)",
 "cc": "مِئَتَان (يَدُلُّ عَلَى العَدَد 200) / سنتيمتر مكعب, مليلتر (وحدة مترية للحجم تساوي واحداً من الألف من اللتر)",
 "ccc": "ثَلَاثُمِئَة (يَدُلُّ عَلَى العَدَد 300)",
 "ccrc": "مركز أبحاث رعاية الإصابات (وكالة في وزارة الدفاع تعد مركزًا وطنيًا للأبحاث حول جميع جوانب السيطرة على الإصابات ورعاية المصابين)",
 "cd": "سِي دِي",
 "cd burner": "سي دي بيرنر, ناسخ أقراص مضغوطة (معدات تسجيل لعمل الأقراص المضغوطة)",
 "cd drive": "مشغل أقراص مضغوطة (محرك يقرأ قرصاً مضغوطاً ويكون متصلاً بنظام صوتي)",
 "cd player": "مَشْغَل سِي دِي, مَشْغَل",
 "cd-r": "قرص مضغوط قابل للتسجيل (قرص مضغوط يمكنك الكتابة عليه مرة واحدة فقط وبعد ذلك يصبح ذاكرة للقراءة فقط)",
 "cd-rom": "سي دي روم, قرص مضغوط (قرص مضغوط يستخدم مع الحاسوب (بدلاً من النظام الصوتي)؛ يمكن تخزين كمية كبيرة من المعلومات الرقمية والوصول إليها ولكن لا يمكن للمستخدم تغييرها)",
 "cd-rom drive": "محرك أقراص مدمجة (محرك متصل بحاسوب يمكن تشغيل الأقراص المدمجة عليه)",
 "cd-wo": "قرص مضغوط قابل للتسجيل (قرص مضغوط يمكنك الكتابة عليه مرة واحدة فقط وبعد ذلك يصبح ذاكرة للقراءة فقط)",
 "cd4": "سي دي 4 (بروتين سكري يوجد بشكل أساسي على سطح الخلايا التائية المساعدة)",
 "cd4 cell": "خلية تائية مساعدة, خلية مساعدة",
 "cd4 t cell": "خلية تائية مساعدة, خلية مساعدة",
 "cd8": "سي دي 8 (بروتين سكري غشائي يوجد بشكل أساسي على سطح الخلايا التائية السامة للخلايا)",
 "cd8 cell": "خلية تائية سامة للخلايا, خلية تائية قاتلة",
 "cd8 t cell": "خلية تائية سامة للخلايا, خلية تائية قاتلة",
 "cdc": "مراكز السيطرة على الأمراض والوقاية منها (وكالة فيدرالية في وزارة الصحة والخدمات الإنسانية؛ تقع في أتلانتا؛ تحقق وتشخص وتحاول السيطرة على الأمراض أو الوقاية منها (خاصة الأمراض الجديدة وغير…)",
 "cdna": "حمض نووي مكمل (حمض نووي أحادي الشريط مكمل للحمض النووي الريبوزي الرسول أو حمض نووي تم تصنيعه من الحمض النووي الريبوزي الرسول بواسطة النسخ العكسي)",
 "ce": "الحقبة العامة, العصر الحالي (في الفترة المتزامنة مع العصر المسيحي؛ يفضل استخدامها بعض الكتاب غير المسيحيين) / سيريوم (عنصر فلزي رمادي قابل للسحب من سلسلة اللنثانيدات)\nمثال: في عام 200 من الحقبة العامة",
 "ceará": "سِيَارَا",
 "cease": "زَالَ (زَالَ يَزُولُ زَوَالاً، وزَوَلاَنًا: تحوَّلَ وانتقل؛ يقال: زَالَ من مكانه وعنه)\nمثال: توم لا زال يبكي",
 "cease and desist order": "أمر قضائي زجري, أمر منع ((في القانون) تدبير قضائي يصدر لمنع طرف من القيام بنشاط معين أو الاستمرار فيه)\nمثال: كان يتم الحصول على الأوامر القضائية سابقاً بموجب مذكرة ولكن الآن بموجب أمر قضائي",
 "cease-fire": "هدنة, وقف إطلاق النار (حالة سلام يتفق عليها الخصوم حتى يتمكنوا من مناقشة شروط السلام)",
 "ceasefire": "هُدْنَة, وَقْفُ نَار",
 "ceaseless": "دَائِم, لَا يَنْقَطِع (غَيْرُ مُنْقَطِعٍ فِي الزَّمَنِ وَمُسْتَمِرٌّ إِلَى أَجَلٍ غَيْرِ مُسَمًّى)",
 "ceaselessly": "بِلَا انْقِطَاع, بِلَا تَوَقُّف (بعزيمة لا تكل)\nمثال: الرقص يلهمه بلا توقف للسعي أعلى وأعلى نحو قمة الكمال المشرقة",
 "ceaselessness": "استمرارية, تواصل (صفة الشيء الذي يستمر بلا نهاية أو انقطاع)",
 "cebion": "سيبيون (دواء يحتوي على حمض الأسكوربيك، متوفر في عدد من البلدان حول العالم)",
 "cebu maguey": "كانتالا, ماغي سيبو (ألياف صلبة تستخدم في صنع الخيوط الخشنة؛ من نباتات الأغاف الفلبينية)",
 "cebuan": "اللغة السيبوانية (لغة شعب سيبو في الفلبين؛ تساهم مفرداتها في اللغة الرسمية للفلبين) / سيبواني (ساكن جزيرة سيبو؛ عضو من شعب البيسايا في الفلبين)",
 "cebuan language": "اللغة السيبوانية (لغة شعب سيبو في الفلبين؛ تساهم مفرداتها في اللغة الرسمية للفلبين)",
 "cebuano": "اللغة السيبوانية (لغة شعب سيبو في الفلبين؛ تساهم مفرداتها في اللغة الرسمية للفلبين)",
 "cebuano language": "اللغة السيبوانية (لغة شعب سيبو في الفلبين؛ تساهم مفرداتها في اللغة الرسمية للفلبين)",
 "cebuella pygmaea": "مارموسيت قزم (أصغر قرد؛ يعيش في الغابات الاستوائية في الأمازون)",
 "cebus capucinus": "سعدان الكبوشي, كبوشي (قرد من أمريكا الوسطى والجنوبية يتميز بشعر كثيف على الرأس يشبه قلنسوة الراهب)",
 "cecal": "أعوري (من أو يشبه الأعور (الجزء الأول من الأمعاء الغليظة))",
 "cecal appendage": "زائدة, زائدة دودية (نتوء أثري يمتد من الطرف السفلي للمصران الأعور ويشبه جيباً صغيراً)",
 "cecity": "عمى, فقدان البصر (حالة انعدام البصر)",
 "cecropia": "عثة سيكروبيا (عثة دودة قز من أمريكا الشمالية؛ تتغذى اليرقات على أوراق أشجار الغابات)",
 "cecropia moth": "عثة سيكروبيا (عثة دودة قز من أمريكا الشمالية؛ تتغذى اليرقات على أوراق أشجار الغابات)",
 "cecropia peltata": "سيكروبيا, شجرة البوق (شجرة أمريكية استوائية بأوراق درعية كبيرة وسيقان مجوفة)",
 "cecum": "أعور (التجويف الذي تبدأ فيه الأمعاء الغليظة والذي يفتح فيه اللفائفي)\nمثال: الزائدة الدودية هي فرع من الأعور",
 "cedar": "أَرْز ((أَرَزَّت) الجرادةُ: رَزَّت)\nمثال: هكذا نطهي الأرز",
 "cedar chest": "صندوق خشب الأرز (صندوق مصنوع من خشب الأرز)",
 "cedar elm": "دردار الأرز (دردار من جنوب الولايات المتحدة والمكسيك له فروع فلينية متدلية منتشرة)",
 "cedar mahogany": "سابيلي, ماهوجني أفريقي معطر (شجرة أفريقية ذات خشب خفيف الوزن برائحة الأرز يتراوح لونه من الوردي إلى البني المحمر)",
 "cedar nut": "جوز الصنوبر السويسري (بذرة الصنوبر السويسري)",
 "cedar of goa": "سرو برتغالي, سرو مكسيكي (شجرة دائمة الخضرة طويلة منتشرة توجد في المكسيك ولها فروع متدلية؛ يعتقد أنها أدخلت إلى البرتغال من غوا)",
 "cedar of lebanon": "أرز لبنان, أرز لبناني (أرز من لبنان وشمال غرب سوريا يبلغ عمراً وارتفاعاً كبيرين)",
 "cedar tree": "أرز, شجرة الأرز ((أَرَزَّت) الجرادةُ: رَزَّت) / أرز, شجرة الأرز (أي من الأشجار العديدة من فصيلة السروية التي تشبه الأرز)\nمثال: هكذا نطهي الأرز",
 "cedar waxwing": "جناح الشمع (واسع الانتشار في المناطق المعتدلة من أمريكا الشمالية)",
 "cedar-apple rust": "صدأ الأرز والتفاح, صدأ التفاح (فطر صدأ يسبب بقع صدأ على التفاح والكمثرى وغيرها)",
 "cedar-scented": "بِرَائِحَةِ الأَرْز (ذُو رَائِحَة تُشْبِهُ رَائِحَة خَشَب الأَرْز)",
 "cedarbird": "جناح الشمع (واسع الانتشار في المناطق المعتدلة من أمريكا الشمالية)",
 "cedarn": "أَرْزِيّ (مُكَوَّنٌ أَوْ مَصْنُوعٌ مِنْ خَشَبِ الأَرْزِ)",
 "cedarwood": "خشب الأرز (خشب عطري متين لأي من العديد من أشجار الأرز؛ خاصة خشب الأرز الأحمر الذي غالباً ما يستخدم في صناديق الأرز)",
 "cedi": "سيدي (وحدة المال الأساسية في غانا)",
 "cedilla": "سِدِيلَا",
 "ceding": "تنازل (فعل التنازل عن ملكية أو حق)",
 "ceding back": "إرجاع الملكية, إعادة التنازل (فعل إعادة التنازل عن شيء للمالك السابق)",
 "cedrela calantas": "أرز فلبيني, ماهوجني فلبيني (شجرة خشبية فلبينية ذات خشب أحمر صلب وعطري)",
 "cedrela odorata": "أرز إسباني, سيدريلا عطرية (شجرة أمريكية استوائية تنتج خشباً عطرياً يستخدم بشكل خاص للصناديق)",
 "cedrus atlantica": "أرز أطلسي (شجرة دائمة الخضرة طويلة جزائرية من جبال الأطلس بأوراق زرقاء خضراء؛ تزرع على نطاق واسع للزينة)",
 "cedrus deodara": "أرز الهيمالايا, أرز ديودار (أرز طويل من شرق الهند له فروع منتشرة ذات أطراف متدلية؛ ذو قيمة عالية لمظهره وكذلك لخشبه)",
 "cedrus libani": "أرز لبنان, أرز لبناني (أرز من لبنان وشمال غرب سوريا يبلغ عمراً وارتفاعاً كبيرين)",
 "cee": "سِي",
 "cefadroxil": "ألتراسيف, سيفادروكسيل (مضاد حيوي من السيفالوسبورين (الاسم التجاري ألتراسيف))",
 "cefobid": "سيفوبيد, سيفوبيرازون (سيفالوسبورين يعطى بالحقن (الاسم التجاري سيفوبيد) يستخدم للعدوى الشديدة)",
 "cefoperazone": "سيفوبيد, سيفوبيرازون (سيفالوسبورين يعطى بالحقن (الاسم التجاري سيفوبيد) يستخدم للعدوى الشديدة)",
 "cefotaxime": "سيفوتاكسيم, كلافوران (سيفالوسبورين يعطى بالحقن (الاسم التجاري كلافوران) يستخدم للعدوى الشديدة في الرئتين أو الحلق أو الأذنين أو المسالك البولية)",
 "ceftazidime": "تازيسيف, سيفتازيديم (سيفالوسبورين يعطى بالحقن (الأسماء التجارية فورتاز وتازيسيف) يستخدم لعلاج الالتهابات المتوسطة)",
 "ceftin": "زيناسيف, سيفتين (سيفالوسبورين يمكن إعطاؤه بالحقن (الاسم التجاري زيناسيف) أو عن طريق الفم بأقراص (الاسم التجاري سيفتين)؛ يوصف لعدوى الرئتين أو الحلق أو الأذنين أو…)",
 "ceftriaxone": "روسيفين, سيفترياكسون (سيفالوسبورين يعطى بالحقن (الاسم التجاري روسيفين) يستخدم للعدوى الشديدة في الرئتين أو الحلق أو الأذنين أو المسالك البولية)",
 "cefuroxime": "زيناسيف, سيفتين (سيفالوسبورين يمكن إعطاؤه بالحقن (الاسم التجاري زيناسيف) أو عن طريق الفم بأقراص (الاسم التجاري سيفتين)؛ يوصف لعدوى الرئتين أو الحلق أو الأذنين أو…)",
 "ceiba pentandra": "شجرة القطن الحريري, قابوق (شجرة استوائية ضخمة ذات تلال عميقة على جذعها الضخم وتحمل قروناً كبيرة من البذور مغطاة بزغب حريري؛ مصدر لألياف القابوق الحريرية)",
 "ceiba tree": "شجرة القطن الحريري, قابوق (شجرة استوائية ضخمة ذات تلال عميقة على جذعها الضخم وتحمل قروناً كبيرة من البذور مغطاة بزغب حريري؛ مصدر لألياف القابوق الحريرية)",
 "ceibo": "سايبو, شجرة المرجان الشائعة (شجرة شائكة صغيرة من أمريكا الجنوبية بزهور قرمزية داكنة وقرمزية منفردة أو متجمعة)",
 "ceilidh": "سهرة غنائية راقصة, كليد (تجمع اجتماعي غير رسمي يتضمن موسيقى شعبية اسكتلندية أو أيرلندية ورقصاً وحكايات)",
 "ceiling": "سَقْف ((سَقَفَ) البيت ونحوه سقفا: عمل له سقفا)\nمثال: نظرت إلى السقف.",
 "ceiling dome": "قبة سقف مضيئة (وحدة إضاءة سقفية يكون فيها مصدر الضوء مخفياً خلف قبة شفافة مصنوعة عادة من الزجاج، مع مزيج من التظليل ونسيج السطح لنشر الضوء)",
 "ceilinged": "ذو سقف, مُسقَّف (مزود بسقف وخاصة السطح الداخلي العلوي)\nمثال: غرفة المعيشة الكبيرة ذات السقف الخشبي",
 "celandine": "بقلة الخطاطيف, عروق الصباغين (عشبة معمرة بجذع خشبي متفرع وزهور صفراء زاهية) / بلسم البرتقال, قرط السيدة (نبات حولي في أمريكا الشمالية بأزهار صفراء أو برتقالية عادة؛ ينمو بشكل رئيسي في التربة الرطبة والحمضية نوعاً ما)",
 "celandine poppy": "خشخاش الغابة, خشخاش عروق الصباغين (عشبة معمرة موطنها غابات شرق الولايات المتحدة ذات زهور صفراء)",
 "celastrus orbiculatus": "حلوة مرة يابانية, سيلاستروس ياباني (كرمة زينة آسيوية بثمار برتقالية صفراء مبهرجة مع غلاف قرمزي؛ مستوطنة في أمريكا الشمالية)",
 "celastrus scandens": "حلوة مرة أمريكية, سيلاستروس (شجيرة ملتفة في أمريكا الشمالية لها كبسولات صفراء تحيط ببذور قرمزية)",
 "celebrant": "المحتفل بالقداس (الكاهن الذي يقيم قداس القربان المقدس) / مُحْتَفِل (شخص يقوم بالاحتفال)",
 "celebrate": "اِحْتَفَلَ",
 "celebrated": "ذُو تَارِيخ عَرِيق, مَشْهُور (له ماضٍ مجيد وحافل بالأمجاد) / شَهِير, لَامِع (معروف على نطاق واسع ومُقدَّر)",
 "celebrater": "مُحْتَفِل (شخص يقوم بالاحتفال)",
 "celebration": "اِحْتِفَال (إقامة مراسم أو فعاليات تعبيرًا عن مناسبة معينة) / اِحْتِفَال, مِهْرَجَان (إقامة مراسم أو فعاليات تعبيرًا عن مناسبة معينة)\nمثال: لم يحضر الاحتفال.",
 "celebrator": "مُحْتَفِل (شخص يقوم بالاحتفال)",
 "celebratory": "احتفالي (يستخدم للاحتفال)",
 "celebrex": "سيليبريكس, سيليكوكسيب (مثبط كوكس-2 (الاسم التجاري سيليبريكس) يخفف الألم والالتهاب دون الإضرار بالجهاز الهضمي)",
 "celebrity": "نَجْم, نَجْمَة (طَلَعَ وظَهَرَ؛ نَجَمَ عن الأمر: أي ظهر نَتِيجَة عنه أو نَتَجَ عنه)\nمثال: سميت السفينة \"النجم الفضي\".",
 "celecoxib": "سيليبريكس, سيليكوكسيب (مثبط كوكس-2 (الاسم التجاري سيليبريكس) يخفف الألم والالتهاب دون الإضرار بالجهاز الهضمي)",
 "celeriac": "جذر الكرفس (جذر عطري صالح للأكل وسميك لنوع من نبات الكرفس) / كرفس جذري, كرفس لفتي (يزرع لجذره العطري السميك الصالح للأكل)",
 "celerity": "سرعة (معدل سريع)",
 "celery": "كَرَفْس",
 "celery blight": "لفحة الكرفس (مرض فطري يسبب تبقع الأوراق لنبات الكرفس)",
 "celery cabbage": "ملفوف صيني (رأس ممدود من سيقان مقرمشة تشبه الكرفس وأوراق خضراء فاتحة) / كرنب صيني, ملفوف صيني (نبات ذو رأس ممدود من أوراق عريضة معنقة تشبه الكرفس؛ يستخدم كخضروات في شرق آسيا)",
 "celery pine": "صنوبر الكرفس (صنوبرية أسترالية دائمة الخضرة ذات رأس رشيق من أوراق الشجر يشبه الكرفس يتكون من أشباه أوراق محمولة في محاور أوراق تشبه الحراشف)",
 "celery root": "جذر الكرفس (جذر عطري صالح للأكل وسميك لنوع من نبات الكرفس) / كرفس جذري, كرفس لفتي (يزرع لجذره العطري السميك الصالح للأكل)",
 "celery salt": "كَرَفْس مِلْح",
 "celery seed": "بذور الكرفس (بذور نبات الكرفس تستخدم للتتبيل)",
 "celery stick": "أعواد الكرفس (سيقان الكرفس مقطعة إلى أعواد صغيرة)",
 "celery top pine": "صنوبر الكرفس (صنوبر كرفس متوسط الطول من تسمانيا)",
 "celery-leaved buttercup": "حوذان سام, حوذان كرفسي الأوراق (عشب حولي ينمو في الأماكن السبخة)",
 "celery-topped pine": "صنوبر الكرفس (صنوبر كرفس متوسط الطول من تسمانيا)",
 "celesta": "سيليستا (آلة موسيقية تتكون من صفائح فولاذية مدرجة تُضرب بمطارق يتم تفعيلها بواسطة لوحة مفاتيح)",
 "celestial": "سَمَاوِيّ",
 "celestial body": "جِرْم سَمَاوِيّ, جِرْم فَلَكِيّ (جَرَم الشَّخْصُ: أَذْنَبَ وَاكتَسَبَ الإِثْمَ؛ جَرَم نفسَه / جَرَم قومَه / جَرَم على / جَرَم على قومه: جَنَى جَنَايَةً)\nمثال: الإهمال هو نوع من الضرر أو الجرم",
 "celestial city": "المدينة السماوية, المدينة المقدسة (عبارات تستخدم للإشارة إلى الجنة)\nمثال: كانت المدينة السماوية هدف كريستيان في رواية 'رحلة الحاج' لبونيان",
 "celestial equator": "الدائرة الاعتدالية, خط الاستواء السماوي (الدائرة العظمى على الكرة السماوية في منتصف المسافة بين القطبين السماويين)",
 "celestial globe": "كرة سماوية, مجسم الكرة السماوية (كرة تعد نموذجاً كروياً للسماوات)",
 "celestial guidance": "توجيه فلكي (طريقة للتحكم في طيران صاروخ أو مركبة فضائية بالرجوع إلى مواقع الأجرام السماوية)",
 "celestial hierarchy": "التسلسل الهرمي السماوي (مجموع الملائكة)",
 "celestial horizon": "أفق, أفق سماوي (الدائرة العظمى على الكرة السماوية التي يمر مستواها عبر الأفق الحسي ومركز الأرض)",
 "celestial latitude": "خط عرض سماوي, ميل ((علم الفلك) المسافة الزاوية لجرم سماوي شمال أو جنوب خط الاستواء السماوي؛ يعبر عنها بالدرجات؛ وتستخدم مع المطلع المستقيم لتحديد المواقع على الكرة…)",
 "celestial longitude": "خط طول سماوي, مطلع مستقيم ((علم الفلك) الإحداثي الاستوائي الذي يحدد الزاوية، مقاسة شرقاً على طول خط الاستواء السماوي، من الاعتدال الربيعي إلى تقاطع دائرة الساعة التي تمر عبر…)\nمثال: ساعة واحدة من المطلع المستقيم تساوي خمس عشرة درجة",
 "celestial mechanics": "ميكانيكا سماوية",
 "celestial navigation": "ملاحة فلكية (الملاحة وفقًا لمواقع النجوم)",
 "celestial orbit": "مدار, مدار سماوي (المسار (الإهليلجي عادة) الذي يصفه جرم سماوي في دورانه حول آخر)\nمثال: رسم مدار القمر",
 "celestial point": "نقطة سماوية (نقطة في السماء (على الكرة السماوية))",
 "celestial pole": "قطب, قطب سماوي (إحدى نقطتي تقاطع محور الأرض والكرة السماوية)",
 "celestial sphere": "قُبَّة سَمَاوِيَّةٍ",
 "celestite": "سلستيت (معدن يتكون من كبريتات السترونشيوم)",
 "celiac": "بطني, جوفي (من أو في أو ينتمي إلى تجويف البطن) / زلاقي (ينتمي إلى أو يوصف لمرض الزلاقي (حساسية القمح))\nمثال: حمية زلاقية",
 "celiac artery": "جذع زلاقي, شريان زلاقي (شريان ينشأ من الأبهر البطني أسفل الحجاب الحاجز مباشرة ويتفرع إلى الشريان المعدي الأيسر والشريان الكبدي المشترك والشريان الطحالي)",
 "celiac disease": "الداء البطني, حساسية القمح (اضطراب يصيب الأطفال والبالغين؛ عدم القدرة على تحمل بروتين القمح (الغلوتين)؛ تشمل الأعراض إسهالاً كريه الرائحة وهزالاً؛ غالباً ما يكون مصحوباً بعدم…)",
 "celiac trunk": "جذع زلاقي, شريان زلاقي (شريان ينشأ من الأبهر البطني أسفل الحجاب الحاجز مباشرة ويتفرع إلى الشريان المعدي الأيسر والشريان الكبدي المشترك والشريان الطحالي)",
 "celibacy": "عُنُوسَة",
 "celibate": "مُتَبَتِّل, مُمْتَنِع (يمتنع عن العلاقات الجنسيّة) / عزب, متبتل (شخص غير متزوج نذر نذراً دينياً بالعفة)",
 "celiocentesis": "بزل بطني (إزالة السوائل من البطن عن طريق البزل)",
 "celioma": "ورم بطني (ورم في البطن)",
 "celioscopy": "تنظير البطن (فحص بالمنظار للبطن من خلال جدار البطن)",
 "cell": "صَوْمَعَة, كِرْح / خَلِيَّة / خَلَوِيّ",
 "cell death": "تنكس حيوي, موت الخلية ((في علم وظائف الأعضاء) الانحلال الطبيعي وموت الخلايا الحية (كما في الخلايا الظهارية المختلفة))",
 "cell division": "انقسام الخلية, انقسام خلوي (العملية في التكاثر والنمو التي تنقسم بها الخلية لتكوين خلايا وليدة)",
 "cell doctrine": "نظرية الخلية ((أحياء) النظرية القائلة بأن الخلايا تشكل الوحدات الهيكلية والوظيفية الأساسية لجميع الكائنات الحية)",
 "cell membrane": "الغشاء البلازمي",
 "cell nucleus": "نواة, نواة الخلية",
 "cell organ": "عضية (جزء متخصص من الخلية؛ يماثل العضو)\nمثال: أول عضية تم تحديدها كانت النواة",
 "cell organelle": "عضية (جزء متخصص من الخلية؛ يماثل العضو)\nمثال: أول عضية تم تحديدها كانت النواة",
 "cell theory": "نظرية الخلية ((أحياء) النظرية القائلة بأن الخلايا تشكل الوحدات الهيكلية والوظيفية الأساسية لجميع الكائنات الحية)",
 "cell wall": "جدار الخلية (طبقة صلبة من السكريات المتعددة تحيط بغشاء الخلايا النباتية وبدائية النواة؛ تحافظ على شكل الخلية وتعمل كحاجز وقائي)",
 "cell-free": "خَالٍ مِنَ الخَلَايَا (يفتقر إلى الخلايا)",
 "cell-like": "شَبِيه بِالخَلِيَّة (يشبه الخليّة في شكله أو بنيته)",
 "cell-mediated immune response": "استجابة مناعية خلوية (استجابة مناعية (بشكل رئيسي ضد الغزوات الفيروسية أو الفطرية أو الأنسجة المزروعة) تتضمن الخلايا التائية)",
 "cellar": "قَبْو, سِرْدَاب",
 "cellarage": "مساحة تخزين القبو (منطقة تخزين في قبو) / رسوم التخزين (رسم لتخزين البضائع في قبو)",
 "cellaret": "ثلاجة صغيرة, خزانة مشروبات (خزانة جانبية ذات حجيرات لحفظ القوارير)",
 "cellblock": "عنبر سجن (قسم من السجن (يتكون عادة من عدة زنزانات))",
 "cellist": "عازف تشيلو (شخص يعزف على التشيلو)",
 "cellmate": "رَفِيق الزِّنْزَانَة",
 "cello": "تْشِيلُّو",
 "cellophane": "سِيلُوفَان",
 "cellphone": "جوال, هاتف خلوي (هاتف لاسلكي محمول باليد للاستخدام في منطقة مقسمة إلى أقسام صغيرة، لكل منها جهاز إرسال/استقبال قصير المدى خاص به)",
 "cellular": "خَلَوِيّ",
 "cellular concrete": "خرسانة خلوية, خرسانة رغوية (نوع من الخرسانة المهواة مع إضافة عامل تهوية (أو ركام خفيف الوزن مثل ركام الطين الممدد أو حبيبات الفلين والفيرميكوليت))\nمثال: لا تخلط بين الخرسانة الخلوية والخرسانة المهواة المعالجة بالأوتوكلاف، والتي يتم تصنيعها خارج الموقع باستخدام طريقة مختلفة تماماً",
 "cellular division": "انقسام الخلية, انقسام خلوي (العملية في التكاثر والنمو التي تنقسم بها الخلية لتكوين خلايا وليدة)",
 "cellular glass": "زجاج خلوي, زجاج رغوي (زجاج خفيف ومعتم يحتوي على خلايا هوائية، يُصنع بإضافة مسحوق الكربون إلى الزجاج المسحوق وحرق الخليط)\nمثال: يستخدم الزجاج الخلوي للعزل",
 "cellular inclusion": "جِسْم اِحْتِوَائِيّ (أي جسم صغير داخل الخلية يوجد داخل آخر (من خصائص بعض الأمراض))\nمثال: جسم احتوائي في سيتوبلازم الخلية",
 "cellular phone": "جوال, هاتف خلوي (هاتف لاسلكي محمول باليد للاستخدام في منطقة مقسمة إلى أقسام صغيرة، لكل منها جهاز إرسال/استقبال قصير المدى خاص به)",
 "cellular respiration": "تنفس خلوي, تنفس داخلي (العمليات الأيضية التي تحصل بها بعض الكائنات الحية على الطاقة من الجزيئات العضوية؛ العمليات التي تحدث في الخلايا والأنسجة والتي يتم خلالها إطلاق…)",
 "cellular slime mold": "عفن غروي خلوي (يختلف عن العفن الغروي الحقيقي في كونه خلوياً وذو نواة طوال دورة حياته)",
 "cellular telephone": "جوال, هاتف خلوي (هاتف لاسلكي محمول باليد للاستخدام في منطقة مقسمة إلى أقسام صغيرة، لكل منها جهاز إرسال/استقبال قصير المدى خاص به)",
 "cellularity": "خلوية (حالة احتواء على خلايا)",
 "cellulite": "تكتل دهني, سيلوليت (تكتلات من دهون الجسم تظهر خاصة على أفخاذ النساء وما إلى ذلك)",
 "cellulitis": "التهاب النسيج الخلوي, التهاب الهلل (التهاب أنسجة الجسم (خاصة تلك الموجودة تحت الجلد) يتميز بالحمى والتورم والاحمرار والألم)",
 "celluloid": "تَرْكِيبِيّ, سِيلِيلُويْدِيّ (اصطناعي كما لو كان مُصوَّرًا في فيلم سينمائي) / أفلام, سينما (وسيط ينشر الصور المتحركة) / سليولويد (مادة شديدة الاشتعال مصنوعة من نترات السليلوز والكافور؛ كانت تستخدم في الأفلام السينمائية)\nمثال: أعمال مسرحية نقلت إلى السينما",
 "cellulose": "سِلْيُولُوز",
 "cellulose acetate": "أسيتات السليلوز (إستر لحمض الأسيتيك؛ يُستخدم في الألياف والأقمشة والأفلام الفوتوغرافية والورنيش)",
 "cellulose ester": "إستر السليلوز (أي إستر للسليلوز مع حمض)",
 "cellulose nitrate": "نترات السليلوز, نيتروسليلوز (إستر لحمض النيتريك؛ يستخدم في الورنيش والمتفجرات)",
 "cellulose tape": "شريط سيلوفان, شريط شفاف (شريط لاصق شفاف أو شبه شفاف (الأسماء التجارية سكوتش تيب وسيلوتيب) يستخدم للختم أو التثبيت أو الإصلاح)",
 "cellulose triacetate": "ثلاثي أسيتات السليلوز (أسيتات السليلوز التي تكون بطيئة الاحتراق نسبياً؛ تُستخدم بدلاً من السيليلويد لأفلام السينما)",
 "cellulose xanthate": "زانثات السليلوز, فيسكوز (إستر سليلوز يتم الحصول عليه بمعالجة السليلوز بالصودا الكاوية)",
 "cellulosic": "سليلوزي (من أو يحتوي على أو مصنوع من السليلوز) / بلاستيك سليلوزي, لدائن سليلوزية (بلاستيك مصنوع من السليلوز (أو مشتق من السليلوز))\nمثال: ألياف سليلوزية",
 "celom": "جوف, سيلوم (تجويف في الأديم المتوسط للجنين يؤدي في البشر إلى التجويف الجنبي وتجويف التامور والتجويف البريتوني)",
 "celoma": "جوف, سيلوم (تجويف في الأديم المتوسط للجنين يؤدي في البشر إلى التجويف الجنبي وتجويف التامور والتجويف البريتوني)",
 "celosia": "سِيلُوسِيَا, قَطِيفَة",
 "celosia argentea": "الثعلب الأحمر, سيلوزيا فضية (نبات حولي عشبي ذو سنابل من الزهور البيضاء الفضية)",
 "celosia argentea cristata": "عرف الديك (نبات حولي للحدائق ذو سنابل تشبه الريش من الزهور الحمراء أو الصفراء)",
 "celosia cristata": "عرف الديك (نبات حولي للحدائق ذو سنابل تشبه الريش من الزهور الحمراء أو الصفراء)",
 "celsius": "سِيلْزْيُوس, سَلْسْيُوس",
 "celsius scale": "المقياس المئوي, مقياس سيلسيوس (مقياس درجة حرارة يحدد نقطة تجمد الماء عند 0 درجة ونقطة غليان الماء عند 100 درجة)",
 "celt": "قِلْطِيّ",
 "celtic": "قِلْطِيّ, قِلْطِيَّة / قِلْطِيَّة",
 "celtic cross": "صليب كلتي (صليب لاتيني مع حلقة تحيط بالتقاطع)",
 "celtic deity": "إله كلتي (إله عبده الكلت (الشعوب السلتية))",
 "celtic language": "السلتيّة, اللغات الكلتية (فرع من اللغات الهندية الأوروبية انتشر على نطاق واسع في أوروبا في عصر ما قبل المسيحية)",
 "celtic sea": "الْبَحْر الْكِلْتِيّ",
 "celtis australis": "ميس أوروبي, ميس جنوبي (شجرة ظل متساقطة الأوراق خضراء زاهية من جنوب أوروبا)",
 "celtis laevigata": "توت السكر, ميس ناعم (شجرة ظل متساقطة الأوراق بتوت أسود صغير؛ جنوب الولايات المتحدة؛ تنتج خشباً مصفراً ناعماً)",
 "celtis occidentalis": "ميس أمريكي (شجرة ظل متساقطة الأوراق كبيرة من جنوب الولايات المتحدة بتوت أرجواني عميق صغير)",
 "celtuce": "خس الكرفس, سلتوس (أوراق ذات سيقان تشبه الكرفس تؤكل نيئة أو مطبوخة) / خس الساق, خس الهليون (خس يقدر خاصة لسيقانه الصالحة للأكل)",
 "cembalo": "بيانو قديم, هابسيكورد (آلة مفاتيح ذات أوتار يتم نبرها بواسطة ريش مثبتة على محاور)",
 "cembra nut": "جوز الصنوبر السويسري (بذرة الصنوبر السويسري)",
 "cembra nut tree": "صنوبر حجري سويسري, صنوبر سويسري (صنوبر أوروبي كبير خماسي الإبر؛ ينتج مكسرات سيمبرا وإفرازات راتنجية)",
 "cement": "أَسْمَنْت / سَمْنَتَ",
 "cement mixer": "خِلَاط اَلْخَرَسَانَة",
 "cement works": "مَصْنَع أَسْمَنْت (مكان أو مبنى تمارس فيه الصناعة)\nمثال: عاد إلى المصنع.",
 "cementite": "سمنتيت, كربيد الحديد (مركب كيميائي يعتبر أحد مكونات الفولاذ والحديد الزهر؛ شديد الصلابة والهشاشة)",
 "cementitious": "إسمنتي (يشبه أو ذو صلة بـ أو يمتلك خصائص الإسمنت)\nمثال: التصاق المواد الإسمنتية",
 "cementum": "ملاط, ملاط الأسنان (مادة عظمية متخصصة تغطي جذر السن)",
 "cemetery": "جبانة, مدفن (قطعة أرض تستخدم للدفن)",
 "cenchrus ciliaris": "سينكروس هدبي, عشبة الجاموس (عشبة شائكة معمرة منتصبة تشكل خصلات تستخدم بشكل خاص في جنوب أفريقيا وأستراليا للمراعي والعلف)",
 "cenchrus tribuloides": "حسك رملي (عشب من شرق الولايات المتحدة وأمريكا الاستوائية له سنيبلات محاطة بأغلفة شائكة)",
 "cenobite": "راهب جماعي (عضو في رهبنة دينية يعيش في جماعة)",
 "cenobitic": "رهباني جماعي (من أو متعلق بـ أو يليق بالرهبان الذين يعيشون في جماعة)",
 "cenobitical": "رهباني جماعي (من أو متعلق بـ أو يليق بالرهبان الذين يعيشون في جماعة)",
 "cenogenesis": "تطور محدث, تكون مستحدث (إدخال صفات أو بنية أثناء التطور الجنيني لم تكن موجودة في التاريخ التطوري السابق للسلالة أو النوع (مثل إضافة المشيمة في تطور الثدييات))",
 "cenogenetic": "تكوني حديث",
 "cenotaph": "الْقُبْر الْأُجُوف",
 "cenote": "سِينُوتِي",
 "cenozoic": "حقبة الحياة الحديثة, سينوزوي (من أو متعلق بـ أو يشير إلى حقبة الحياة الحديثة (سينوزويك))",
 "censer": "مَبْخَرَة",
 "censitary suffrage": "اقتراع مقيد, تصويت حسب النصاب (نظام لا تكون فيه الأصوات التي يدلي بها الناخبون متساوية، بل يتم وزنها بشكل مختلف وفقًا لمرتبة الشخص (على سبيل المثال، يتمتع الأشخاص ذوو الدخل المرتفع…)",
 "censor": "رقيب (شخص مخول بقراءة المنشورات أو المراسلات أو مشاهدة العروض المسرحية ومنع أي شيء يعتبر فاحشاً أو غير مقبول سياسياً كلياً أو جزئياً) / لَوَّام, نَاقِد (شخص يلوم أو يدين)",
 "censored": "خَاضِع لِلرَّقَابَة, مُرَاقَب (مقموع أو خاضع للرقابة)\nمثال: الصحافة الخاضعة للرقابة في بعض البلدان",
 "censorial": "رقابي (ينتمي أو يتعلق بالرقيب أو وظائفه)",
 "censoring": "رقابة (حذف أجزاء من المنشورات أو المراسلات أو العروض المسرحية) / رقابة, مراجعة أمنية (مكافحة التجسس التي تتحقق عن طريق حظر أو حذف أي معلومات ذات قيمة للعدو)",
 "censorious": "صَارِمُ الانْتِقَادِ, لَوَّام (قاسٍ في النقد أو يُعبِّر عن الاستنكار)",
 "censorship": "رَقَابَة (الحِراسة والمُلاحظة بانتباه؛ إطِّلاع السُّلطات الرَّسُمِيَّة على ما يحظِّره القانون واتِّخاذ التدابير المناسبة بشأنه)",
 "censurable": "مُسْتَحِقٌّ لِلذَّمّ, مُسْتَوْجِبٌ لِلَّوْم (يستحق اللوم أو الذم لكونه خاطئًا أو مؤذيًا)",
 "censure": "لَامَ, اِسْتَنْكَرَ (لامَ يَلوم ، لُمْ ، لَوْمًا ، فهو لائم والجمع : لُوَّمٌ ، ولُيَّمٌ وهو أَيضاً لَوَّامٌ ، ولَوَّامةٌ ، ولْوَمةٌ وذاك مَلُومٌ ، ومَلِيمٌ…)\nمثال: لام سامي معلمه على فشله هو.",
 "census": "تَعْدَاد اَلسُّكَّان, إِحْصَاء اَلسُّكَّان",
 "census bureau": "مكتب الإحصاء (مكتب وزارة التجارة المسؤول عن إجراء التعداد السكاني؛ يوفر معلومات وتحليلات ديموغرافية حول سكان الولايات المتحدة)",
 "census suffrage": "اقتراع مقيد, تصويت حسب النصاب (نظام لا تكون فيه الأصوات التي يدلي بها الناخبون متساوية، بل يتم وزنها بشكل مختلف وفقًا لمرتبة الشخص (على سبيل المثال، يتمتع الأشخاص ذوو الدخل المرتفع…)",
 "census taker": "جامع بيانات التعداد, عداد (شخص يجمع بيانات التعداد من خلال زيارة المنازل الفردية)",
 "cent": "سِنْت / سَنْت",
 "cental": "قنطار أمريكي قصير (وحدة وزن أمريكية تعادل 100 رطل)",
 "centare": "متر مربع (وحدة قياس للمساحة، تُعرف بمساحة مربع أضلاعه متر واحد بالضبط)",
 "centas": "سنتاس (100 سنتاس تساوي 1 ليتاس في ليتوانيا)",
 "centaur": "قَنْطُور",
 "centaurea americana": "زهرة السلة, قنطريون أمريكي (نبات سنوي في جنوب غرب الولايات المتحدة يزرع لرؤوس زهوره الأرجوانية وقناباته التي تشبه السلال الصغيرة)",
 "centaurea calcitrapa": "شوك النجم, قنطريون شوكي (عشبة متوسطية سنوية أو ثنائية الحول ذات زهور وردية إلى أرجوانية محاطة بحراشف ذات أطراف شوكية؛ متوطنة في أمريكا)",
 "centaurea cineraria": "طاحونة الغبار, قنطريون رمادي (نبات ذو أوراق وسيقان مغطاة بزغب يشبه الغبار)",
 "centaurea cyanus": "قنطريون عنبري, ورد الذرة (نبات أوراسي حولي يُزرع في أمريكا الشمالية له رؤوس مبهرجة من الزهور الزرقاء أو الأرجوانية أو الوردية أو البيضاء)",
 "centaurea gymnocarpa": "طاحونة الغبار, قنطريون رمادي (نبات ذو أوراق وسيقان مغطاة بزغب يشبه الغبار)",
 "centaurea imperialis": "سلطان جميل, قنطريون إمبراطوري (نبات معمر في جبال إيران والعراق؛ يُزرع لزهوره الوردية العطرة)",
 "centaurea moschata": "سلطان جميل, عنبر كشميري (نبات آسيوي يُزرع على نطاق واسع لزهوره الوردية ذات الرائحة الحلوة؛ يوضع أحياناً في جنس القنطريون)",
 "centaurea nigra": "قنطريون أسود (نبات معمر عشبي بسيقان سلكية قوية وزهور أرجوانية؛ موطنه أوروبا ولكنه متوطن على نطاق واسع)",
 "centaurea scabiosa": "قنطريون كبير (نبات أوروبي معمر طويل له رؤوس زهور أرجوانية)",
 "centaurea solstitialis": "شوك النجم الأصفر, قنطريون صيفي (عشب ضار أوروبي له ساق مجنحة وأوراق مشعرة؛ وافد في شرق الولايات المتحدة)",
 "centauria calcitrapa": "شوك النجم, قنطريون شوكي (عشبة متوسطية سنوية أو ثنائية الحول ذات زهور وردية إلى أرجوانية محاطة بحراشف ذات أطراف شوكية؛ متوطنة في أمريكا)",
 "centaurium calycosum": "روزيتا, قنطريون كأسية (نبات منتصب ذو عناقيد صغيرة من الزهور الوردية بوقية الشكل، موطنه جنوب غرب الولايات المتحدة)",
 "centaurium minus": "قنطريون صغير (نبات قنطريون حولي أملس شائع في أوروبا ذو زهور في نوارات كثيفة)",
 "centaurium scilloides": "قنطريون عنصلي (نبات معمر ذو خصلات موطنه غرب أوروبا وجزر الآزور، له زهور وردية زاهية إلى بيضاء)",
 "centaurus": "الْقُنْطُور",
 "centaury": "قَنْطُورِيُون",
 "centavo": "سنتافو (وحدة نقدية كسرية للعديد من البلدان مثل البرازيل والأرجنتين والمكسيك وغيرها)",
 "centenarian": "مُعَمَّر (بلغ المئة عام من العمر على الأقلّ) / معمر (شخص يبلغ من العمر 100 عام على الأقل)",
 "centenary": "مئوي (من أو يتعلق بفترة 100 عام أو إكمالها) / ذكرى مئوية (الذكرى السنوية المئة)\nمثال: احتفال مئوي",
 "centennial": "مئوي (من أو يتعلق بفترة 100 عام أو إكمالها) / ذكرى مئوية (الذكرى السنوية المئة)\nمثال: احتفال مئوي",
 "centennially": "كُلّ مِائَة عَام (كل مائة عام؛ مرة في القرن)\nمثال: يتم الاحتفال بعيد ميلاد هذه المدينة كل مائة عام",
 "center": "مَرْكَز (موضع الاِرْتِكَاز عامة؛ موضع الشخص ومحلّه الذي يبقى فيه عادة)\nمثال: أين أقرب مركز شرطة؟",
 "center bit": "ريشة مركزية (ريشة ذات نقطة مركزية حادة للتوجيه وقاطعين جانبيين)",
 "center field": "الحقل الأوسط (مركز اللعب للاعب في فريق البيسبول المتوقع منه التقاط الكرات في الثلث الأوسط من الملعب الخارجي) / وسط الملعب (قطعة الأرض في المنطقة الخارجية مباشرة أمام الماسك)\nمثال: ضرب الكرة إلى عمق الوسط",
 "center fielder": "لاعب الوسط (الشخص الذي يلعب في وسط الملعب الخارجي)",
 "center for disease control and prevention": "مراكز السيطرة على الأمراض والوقاية منها (وكالة فيدرالية في وزارة الصحة والخدمات الإنسانية؛ تقع في أتلانتا؛ تحقق وتشخص وتحاول السيطرة على الأمراض أو الوقاية منها (خاصة الأمراض الجديدة وغير…)",
 "center line": "خط المركز, محور (خط ينصف شكلاً مستوياً)",
 "center of attention": "محور, مركز اهتمام (الشيء الذي يركز عليه الاهتمام والانتباه)\nمثال: قصصه جعلته محور الحفلة",
 "center of buoyancy": "مركز الانغمار, مركز الطفو ((في الفيزياء) مركز كتلة الجزء المغمور من السفينة أو أي جسم عائم آخر)",
 "center of curvature": "مركز الانحناء, مركز التكور (مركز دائرة الانحناء)",
 "center of flotation": "مركز الطفو (مركز ثقل الجسم العائم)",
 "center of gravity": "مَرْكَز الْجَاذِبِيَّة (موضع الاِرْتِكَاز عامة؛ موضع الشخص ومحلّه الذي يبقى فيه عادة)\nمثال: أين أقرب مركز شرطة؟",
 "center of immersion": "مركز الانغمار, مركز الطفو ((في الفيزياء) مركز كتلة الجزء المغمور من السفينة أو أي جسم عائم آخر)",
 "center of mass": "مركز الكتلة (نقطة تمثل متوسط موضع المادة في جسم ما)",
 "center punch": "سنبك, مسمار التحديد (أداة ذات رأس مخروطي تستخدم لعمل فجوات في المعدن (خاصة لتحديد نقاط للحفر))",
 "center spread": "الصفحتان الوسطيان (الصفحتان المتقابلتان في وسط المجلة)",
 "center stage": "وسط المسرح (المنطقة المركزية على خشبة المسرح) / بؤرة الاهتمام, صدارة (موقع البروز أو الأهمية)",
 "centerboard": "عارضة منزلقة, لوح مركزي (زعنفة عارضة قابلة للسحب تستخدم في المراكب الشراعية لمنع الانجراف نحو اتجاه الريح)",
 "centered": "فِي الوَسَط, مُتَمَرْكِز (يقع أو يُوضع في المركز)",
 "centerfield": "الحقل الأوسط (مركز اللعب للاعب في فريق البيسبول المتوقع منه التقاط الكرات في الثلث الأوسط من الملعب الخارجي) / وسط الملعب (قطعة الأرض في المنطقة الخارجية مباشرة أمام الماسك)\nمثال: ضرب الكرة إلى عمق الوسط",
 "centerfielder": "لاعب الوسط (الشخص الذي يلعب في وسط الملعب الخارجي)",
 "centerfold": "سنتر فولد, ملحق وسط المجلة (الصفحتان الوسطيان في مجلة؛ خاصة إذا كانت تطوى للخارج لصورة كبيرة أو خريطة أو ميزة أخرى)",
 "centering": "سحب الكرة, سناب ((كرة القدم الأمريكية) وضع الكرة في اللعب عن طريق تمريرها (بين الساقين) إلى الخلف) / بؤرة, تركيز (تركيز الانتباه أو الطاقة على شيء ما)\nمثال: أسقط لاعب الوسط الكرة عند السحب",
 "centerline": "خط المركز, محور (خط ينصف شكلاً مستوياً)",
 "centerpiece": "قطعة مركزية (شيء يوضع في وسط شيء آخر (كما على الطاولة)) / ركيزة, قطعة مركزية (الميزة المركزية أو الأكثر أهمية)\nمثال: كان التعليم الركيزة الأساسية للبرنامج السياسي للحزب الديمقراطي",
 "centesimal": "اَلْمِئَةُ, اَلْمِئَوِيّ (العدد الترتيبي لمئة في العدّ) / مئوي (يتعلق بـ أو مقسم إلى أجزاء من مئة)",
 "centesimo": "سنتيسيمو (وحدة نقدية كسرية لعدة بلدان: بنما وإيطاليا وأوروغواي وتشيلي)",
 "centesis": "بزل ((جراحة) فعل ثقب تجويف الجسم أو عضو بإبرة مجوفة لسحب السوائل)",
 "centigrade": "مِئَوِيّ",
 "centigrade scale": "المقياس المئوي, مقياس سيلسيوس (مقياس درجة حرارة يحدد نقطة تجمد الماء عند 0 درجة ونقطة غليان الماء عند 100 درجة)",
 "centigrade thermometer": "مقياس حرارة مئوي (مقياس حرارة مدرج بالدرجات المئوية)",
 "centile": "رتبة مئينية, مئين ((إحصاء) أي من النقاط الـ 99 المرقمة التي تقسم مجموعة مرتبة من الدرجات إلى 100 جزء يحتوي كل منها على واحد بالمائة من المجموع)",
 "centiliter": "سنتيلتر (وحدة مترية للحجم تساوي واحداً من المائة من اللتر)",
 "centilitre": "سنتيلتر (وحدة مترية للحجم تساوي واحداً من المائة من اللتر)",
 "centime": "بنس, سنت (عملة معدنية قيمتها واحد بالمائة من قيمة الوحدة الأساسية) / سنتيم (وحدة نقدية كسرية للعديد من البلدان مثل فرنسا والجزائر والمغرب وسويسرا وغيرها)",
 "centimeter": "سنتيمتر (وحدة مترية للطول تساوي واحداً من المائة من المتر)",
 "centimetre": "سِنْتِيمِتْر",
 "centimo": "سنتيمو (وحدة نقدية كسرية لفنزويلا وكوستاريكا وغينيا الاستوائية وباراغواي وإسبانيا)",
 "centipede": "أُمّ أَرْبَعَة وَأَرْبَعِين (الوَالِدَة أو الجَدَّة، وقد يطلق على والدة الزوج مجازا؛ أمّ بالرضاعة: المرأة التي أرضعت الطِفْل صغيرا فتصبح كوالدته)\nمثال: هل ستأتي أم لا؟",
 "centner": "قنطار أمريكي قصير (وحدة وزن أمريكية تعادل 100 رطل) / قنطار متري (في بعض الدول الأوروبية: وحدة وزن تعادل 50 كيلوغراماً) / قنطار متري, هندريدويت (وحدة وزن تساوي 100 كيلوغرام في النظام المتري)",
 "central": "مَرْكَزِيّ",
 "central african cfa franc": "فرنك سيفا الوسط أفريقي, فرنك وسط أفريقيا (عملة ست دول مستقلة في وسط أفريقيا: الكاميرون، وجمهورية أفريقيا الوسطى، وتشاد، وجمهورية الكونغو، وغينيا الاستوائية، والغابون)\nمثال: في العديد من دول غرب أفريقيا، يتم تداول فرنك غرب أفريقيا، الذي يساوي في القيمة فرنك وسط أفريقيا",
 "central african republic": "جُمْهُورِيَّة أَفْرِيقِيَا الْوُسْطَى",
 "central african republic franc": "فرنك أفريقيا الوسطى (وحدة المال الأساسية في جمهورية أفريقيا الوسطى)",
 "central america": "أمريكا الوسطى (دول أمريكا الوسطى مجتمعة)",
 "central american": "أمريكي وسطي (من أو يتعلق بدول أو ثقافات أو شعوب أمريكا الوسطى) / أمريكي وسطي (مواطن أو ساكن في أمريكا الوسطى)",
 "central american country": "دولة في أمريكا الوسطى (أي دولة من الدول التي تشغل أمريكا الوسطى)",
 "central american nation": "دولة في أمريكا الوسطى (أي دولة من الدول التي تشغل أمريكا الوسطى)",
 "central american strap fern": "سرخس الشريط الأمريكي الأوسط (سرخس بأوراق أقصر وأضيق من سرخس الشريط الفلوريدي؛ من فلوريدا إلى جزر الهند الغربية والمكسيك وجنوباً إلى الأرجنتين)",
 "central artery of the retina": "الشريان المركزي للشبكية (فرع من الشريان العيني؛ يدخل مقلة العين مع العصب البصري)",
 "central asia": "آسِيَا الْوُسْطَى (إحدى القارات السبع؛ أكبرها مساحةً، وأكثرها سكانًا)\nمثال: على شعوب آسيا أن تتعاون.",
 "central bank": "بَنْك مَرْكَزِيّ ((بَنَّكَ) الخدم: تحدَّثُوا بأسرار الْبيُوت)\nمثال: هي تعمل في بنك.",
 "central body": "جسيم مركزي (منطقة صغيرة من السيتوبلازم مجاورة للنواة؛ تحتوي على المريكزات وتعمل على تنظيم الأنابيب الدقيقة)",
 "central chimpanzee": "شمبانزي مركزي (شمبانزي أسود الوجه في وسط أفريقيا؛ يرتبط ارتباطاً وثيقاً بالشمبانزي الشرقي)",
 "central city": "مركز المدينة, وسط المدينة (الجزء المركزي من المدينة)",
 "central dravidian": "درافيدية وسطى (لغة درافيدية يتم التحدث بها بشكل أساسي في وسط الهند)",
 "central dravidian language": "درافيدية وسطى (لغة درافيدية يتم التحدث بها بشكل أساسي في وسط الهند)",
 "central europe": "أُورُوبَا الْوَسَطَى (الجزء من يوراسيا الذي يقع غرب جبال الأورال، والمعتبر تقليديًّا قارة بحد ذاته، كما يقع شمال قارة إفريقيا، وغرب قارة آسيا، وشرق المحيط الأطلسي؛ كيان سياسي؛ الاتحاد الأوروبي)\nمثال: ذهبت إلى أوروبا مرة.",
 "central gyrus": "تلفيف مركزي (أي من تلفيفين على جانبي التلم المركزي)",
 "central heating": "تَدْفِئَة مَرْكَزِيَّة",
 "central intelligence agency": "سي آي إيه, وكالة الاستخبارات المركزية (وكالة مستقلة تابعة لحكومة الولايات المتحدة مسؤولة عن جمع وتنسيق أنشطة الاستخبارات والاستخبارات المضادة في الخارج من أجل المصلحة الوطنية؛ يرأسها مدير…)",
 "central intelligence machinery": "آلية الاستخبارات المركزية (الوحدة المركزية في المملكة المتحدة لتكليف وتنسيق وتمويل وكالات الاستخبارات والأمن)",
 "central kurdish": "الكُرْدِيَّة المَرْكَزِيَّة",
 "central luzon": "وسط لوزون",
 "central moment": "العَزْم المَرْكَزِيّ",
 "central nervous system": "الجهاز العصبي المركزي (جزء الجهاز العصبي الفقاري المكون من الدماغ والحبل الشوكي)",
 "central office": "مركز قيادة, مقر رئيسي ((عادة بصيغة الجمع) المكتب الذي يعمل كمركز إداري لمؤسسة ما)\nمثال: لدى العديد من الشركات مقراتها الرئيسية في نيويورك",
 "central powers": "دول المركز (في الحرب العالمية الأولى، تحالف ألمانيا والنمسا-المجر ودول أخرى تحالفت معهم في معارضة الحلفاء)",
 "central processing unit": "وحدَة المعالجَة المَرْكَزِيَّة",
 "central processor": "المعالج, المعالج المركزي ((علوم الحاسوب) جزء من الحاسوب (شريحة المعالج الدقيق) يقوم بمعظم معالجة البيانات)\nمثال: تشكل وحدة المعالجة المركزية والذاكرة الجزء المركزي من الكمبيوتر الذي يتم توصيل الأجهزة الطرفية به",
 "central scotoma": "عتمة مركزية (عتمة تشمل نقطة التثبيت في العين)",
 "central standard time": "توقيت المنطقة الوسطى (التوقيت القياسي في المنطقة الزمنية السادسة غرب غرينتش، يحسب عند خط الطول 90؛ يستخدم في وسط الولايات المتحدة)",
 "central sulcus": "التلم المركزي, شق رولاندو (شق دماغي يمتد صعودًا على السطح الجانبي لكلا نصفي الكرة المخية؛ يفصل الفصين الجبهي والجداري)",
 "central tendency": "النَزْعَة المَرْكَزِيَّة",
 "central thai": "السيامية, اللغة التايلاندية (فرع من لغات تاي، يُتحدث به في وسط تايلاند، وتتركز في بانكوك)",
 "central time": "توقيت المنطقة الوسطى (التوقيت القياسي في المنطقة الزمنية السادسة غرب غرينتش، يحسب عند خط الطول 90؛ يستخدم في وسط الولايات المتحدة)",
 "central vein of retina": "وريد الشبكية المركزي (وريد يتكون من اتحاد أوردة الشبكية؛ يرافق الشرايين المركزية للشبكية في العصب البصري)",
 "central vein of suprarenal gland": "وريد الغدة الكظرية المركزي (وريد تصريف وحيد؛ على اليمين يصب في الوريد الأجوف السفلي؛ وعلى اليسار يصب في الوريد الكلوي الأيسر)",
 "central veins of liver": "أوردة مركزية للكبد (الفروع النهائية للأوردة الكبدية التي تقع في الفصيصات الكبدية وتتلقى الدم من الجيوب الكبدية)",
 "central vision": "رؤية مركزية (الرؤية باستخدام النقرة وما حولها؛ الجزء الأوسط من المجال البصري)",
 "central vowel": "صائت مركزي ((لغويات) أي صوت صائت يتمركز فيه اللسان في منتصف المسافة بين الصائت الأمامي والصائت الخلفي)",
 "centralisation": "تمركز, مركزية (التجميع في مركز) / مركزية (عملية توحيد السلطة تحت سيطرة مركزية)",
 "centralised": "مركزي (منجذب نحو مركز أو خاضع لسيطرة سلطة مركزية)\nمثال: سيطرة مركزية على جهود الإغاثة في حالات الطوارئ",
 "centralism": "مركزية (السياسة السياسية المتمثلة في تركيز السلطة في منظمة مركزية)",
 "centralist": "مركزي (مؤيد للمركزية)",
 "centralistic": "مركزي (مؤيد للمركزية)",
 "centrality": "تَمَرْكُز, مَرْكَزِيَّة (خاصية التواجد في المركز)",
 "centralization": "مَرْكَزِيَّة",
 "centralized": "مركزي (منجذب نحو مركز أو خاضع لسيطرة سلطة مركزية)\nمثال: سيطرة مركزية على جهود الإغاثة في حالات الطوارئ",
 "centrally": "مركزياً (في أو بالقرب أو نحو مركز أو وفقاً لدور أو وظيفة مركزية)\nمثال: المسرح يقع مركزياً",
 "centranthus ruber": "مخلب الشيطان, ناردين أحمر (عشبة أوروبية ذات زهور قرمزية أو بيضاء صغيرة عطرة ذات مهماز)",
 "centrarchid": "سمكة الشمس (أسماك فرخية صغيرة آكلة للحوم تعيش في المياه العذبة بأمريكا الشمالية، عادة ما يكون جسمها مضغوطاً جانبياً ولها بريق معدني)",
 "centre": "مُنْتَصَف, وَسَط (على مسافة متساوية من الأطراف) / سنتر, لاعب وسط (مركز في فريق كرة السلة للاعب الذي يشارك في قفزة البداية التي تبدأ المباراة) / سنتر, لاعب وسط ((كرة قدم أمريكية) مركز اللاعب على خط الاشتباك الذي يضع الكرة في اللعب) / سنتر, لاعب وسط (مركز في فريق الهوكي للاعب الذي يشارك في مواجهة البداية عند بداية المباراة)\nمثال: مسؤولية السنتر هي إيصال الكرة إلى الكوارترباك",
 "centre bit": "ريشة مركزية (ريشة ذات نقطة مركزية حادة للتوجيه وقاطعين جانبيين)",
 "centre for international crime prevention": "مركز منع الجريمة الدولي (مكتب الأمم المتحدة المسؤول عن منع الجريمة والعدالة الجنائية وإصلاح القانون)",
 "centre of attention": "محور, مركز اهتمام (الشيء الذي يركز عليه الاهتمام والانتباه)\nمثال: قصصه جعلته محور الحفلة",
 "centre of buoyancy": "مركز الانغمار, مركز الطفو ((في الفيزياء) مركز كتلة الجزء المغمور من السفينة أو أي جسم عائم آخر)",
 "centre of curvature": "مركز الانحناء, مركز التكور (مركز دائرة الانحناء)",
 "centre of flotation": "مركز الطفو (مركز ثقل الجسم العائم)",
 "centre of gravity": "مركز الثقل, مركز الجاذبية (النقطة داخل شيء ما التي يمكن اعتبار الجاذبية تعمل عندها؛ في الجاذبية المنتظمة يساوي مركز الكتلة)",
 "centre of immersion": "مركز الانغمار, مركز الطفو ((في الفيزياء) مركز كتلة الجزء المغمور من السفينة أو أي جسم عائم آخر)",
 "centre of mass": "مركز الكتلة (نقطة تمثل متوسط موضع المادة في جسم ما)",
 "centre spread": "الصفحتان الوسطيان (الصفحتان المتقابلتان في وسط المجلة)",
 "centre stage": "وسط المسرح (المنطقة المركزية على خشبة المسرح) / بؤرة الاهتمام, صدارة (موقع البروز أو الأهمية)",
 "centre-val de loire": "سانتر-وادي اللوار, وسط-وادي اللوار",
 "centreboard": "عارضة منزلقة, لوح مركزي (زعنفة عارضة قابلة للسحب تستخدم في المراكب الشراعية لمنع الانجراف نحو اتجاه الريح)",
 "centred": "فِي الوَسَط, مُتَمَرْكِز (يقع أو يُوضع في المركز)",
 "centrefold": "سنتر فولد, ملحق وسط المجلة (الصفحتان الوسطيان في مجلة؛ خاصة إذا كانت تطوى للخارج لصورة كبيرة أو خريطة أو ميزة أخرى)",
 "centrepiece": "قطعة مركزية (شيء يوضع في وسط شيء آخر (كما على الطاولة)) / ركيزة, قطعة مركزية (الميزة المركزية أو الأكثر أهمية)\nمثال: كان التعليم الركيزة الأساسية للبرنامج السياسي للحزب الديمقراطي",
 "centrex": "سنترال مركزي (نوع من مقسمات الهاتف المركزية)",
 "centric": "مَرْكَزِيّ, مُتَوَسِّط (يقع عند المركز أو بالقرب منه)",
 "centrical": "مَرْكَزِيّ, مُتَوَسِّط (يقع عند المركز أو بالقرب منه)",
 "centrifugal": "نَابِذ",
 "centrifugal force": "قوة الطرد المركزي (ضد الضُعْف، الشِدَّة والقُدْرَة الجِسْمَانِيَّة؛ ضد الضُعْف، المَقْدِرَة والحَوْل والتَمَكُّن، القدرة المعنوية)\nمثال: توم شعر بالقوة.",
 "centrifugal pump": "مضخة طرد مركزي (مضخة تستخدم قوة الطرد المركزي لتفريغ السائل في أنبوب)",
 "centrifugation": "طرد مركزي, نبذ مركزي (عملية فصل المواد ذات الكثافات المختلفة باستخدام جهاز الطرد المركزي)",
 "centrifuge": "طَرْد مَرْكَزِيّ",
 "centring": "سحب الكرة, سناب ((كرة القدم الأمريكية) وضع الكرة في اللعب عن طريق تمريرها (بين الساقين) إلى الخلف) / بؤرة, تركيز (تركيز الانتباه أو الطاقة على شيء ما)\nمثال: أسقط لاعب الوسط الكرة عند السحب",
 "centriole": "مريكز (إحدى زوج من عضيات خلوية أسطوانية صغيرة قرب النواة في الخلايا الحيوانية؛ تتكون من تسعة نبيبات دقيقة ثلاثية وتشكل الأشعة النجمية أثناء الانقسام الفتيلي)",
 "centripetal": "جَاذِب مَرْكَزِيّ (يميل إلى التحرك نحو المركز) / جَابِذ مَرْكَزِيّ, حِسِّيّ (خاصّ بليف عصبيّ أو نبضة تنشأ خارجيًّا وتتّجه نحو الجهاز العصبيّ المركزيّ) / تَوْحِيدِيّ, مُوَحِّد (يميل إلى التوحيد والتجميع)\nمثال: قوة الجذب المركزي",
 "centripetal acceleration": "تَسَارُع مَرْكَزِيّ (التسارع نحو المركز الذي يحافظ على القمر الصناعي في مدار بيضاوي)",
 "centripetal force": "قوة جذب مركزي (ضد الضُعْف، الشِدَّة والقُدْرَة الجِسْمَانِيَّة؛ ضد الضُعْف، المَقْدِرَة والحَوْل والتَمَكُّن، القدرة المعنوية)\nمثال: توم شعر بالقوة.",
 "centrism": "وَسَطِيَّة",
 "centrist": "مُعْتَدِل, وَسَطِيّ (يدعم أو ينتهج مساراً ليس ليبرالياً ولا محافظاً بشكل مفرط) / مُعْتَدِل, وَسَطِيّ (شخص يتخذ موقفاً في الوسط السياسي)",
 "centrocercus urophasianus": "طيهوج الميرمية (طيهوج كبير من مناطق الميرمية في أمريكا الشمالية)",
 "centroid": "مركز هندسي, نقطة مركزية (مركز كتلة جسم ذو كثافة منتظمة)",
 "centroidal": "مركزي, وسطي (من أو متعلق بـ (وخاصة المار عبر) المركز الهندسي (السنترويد))",
 "centrolobium robustum": "أراريبا, سنترولوبيوم (شجرة برازيلية ذات خشب مميز بشكل جميل)",
 "centromere": "سِنْترومِير, قَسِيم مَرْكَزِيّ\nمثال: من الصعب تحديد تسلسل القسيم المركزي",
 "centromeric": "سنتروميري, مركزي (متعلق بالجزء المتخصص الكثيف من الكروموسوم الذي يلتصق به المغزل أثناء الانقسام المتساوي)",
 "centropristis philadelphica": "قاروص الصخور (نوع من قاروص البحر)",
 "centropristis striata": "قاروص البحر الأسود (قاروص بحر مخطط باللون الأسود المزرق من ساحل المحيط الأطلسي للولايات المتحدة)",
 "centropus phasianinus": "كوكال تدرجي (طائر أسترالي ذو ذيل يشبه التدرج)",
 "centropus sinensis": "كوكال صيني (كوكال شائع في الهند والصين)",
 "centrosema virginianum": "بازلاء الفراشة, سينتروسيما (كرمة كبيرة الزهر ضعيفة الالتفاف أو منبسطة من نيو جيرسي إلى شرق أمريكا الشمالية الاستوائية، تزرع أحياناً لزهورها الأرجوانية والبيضاء)",
 "centrosome": "جسيم مركزي (منطقة صغيرة من السيتوبلازم مجاورة للنواة؛ تحتوي على المريكزات وتعمل على تنظيم الأنابيب الدقيقة)",
 "centrosomic": "جسيمي مركزي (من أو متعلق بالجسيم المركزي)",
 "centrosymmetric": "شُعَاعِيّ التَّنَاظُر (ذو ترتيب متناظر للأجزاء المشعة حول نقطة مركزية)",
 "centrum": "جسم الفقرة (الجسم الرئيسي للفقرة)",
 "centum language": "لغات كنتوم (لغة هندية أوروبية تُظهر حفظاً مميزاً للأصوات الشفوية الطبقية من الهندية الأوروبية البدائية وتطوراً تاريخياً للمفاصل الطبقية)",
 "centurion": "سينتوريون",
 "century": "قَرْن, عَصْر (مصدر للفعل قَرَنَ؛ القوم يعيشون سوية فترة طويلة جذا من الزمن، أو هو الفترة الطويلة من الزمن بدون تحديد عدد السنين)\nمثال: هذه الشجرة عمرها أكثر من قرن.",
 "century plant": "أغاف, ألوة أمريكية (نباتات أمريكية استوائية ذات وريدات قاعدية من أوراق ليفية تشبه السيف وأزهار في سنابل طويلة؛ يزرع بعضها للزينة أو للألياف)",
 "ceo": "رئيس تنفيذي (المسؤول التنفيذي للشركة المسؤول عن عمليات الشركة؛ يقدم تقاريره إلى مجلس الإدارة؛ قد يعين مديرين آخرين (بما في ذلك الرئيس))",
 "cephalalgia": "صداع, وجع رأس (ألم في الرأس ناتج عن توسع الشرايين الدماغية أو تقلصات العضلات أو رد فعل للأدوية)",
 "cephalanthera rubra": "سيفالانترا حمراء (سحلب من البحر الأبيض المتوسط وآسيا له سنبلة رخوة من الزهور الوردية الزاهية)",
 "cephalaspid": "عظميات الدرقة (سمكة منقرضة عديمة الفك من العصر الديفوني برأس مدرع)",
 "cephalexin": "سيفاليكسين, كيفليكس (مضاد حيوي من السيفالوسبورين (الأسماء التجارية كيفليكس وغيرها) يوصف عادة للعدوى الخفيفة إلى المتوسطة الشدة في الجلد أو الأذنين أو الحلق أو الرئتين أو…)",
 "cephalhematoma": "ورم دموي رأسي (تجمع للدم تحت فروة رأس المولود الجديد؛ ناتج عن الضغط أثناء الولادة)",
 "cephalic": "رَأْسِيّ",
 "cephalic index": "المُؤَشِّر الرَّأْسِيّ (نسبة (بالنسبة المئوية) أقصى عرض للجمجمة إلى أقصى طول لها)",
 "cephalic vein": "وريد رأسي (وريد كبير في الذراع يصب في الوريد الإبطي)",
 "cephalitis": "التهاب الدماغ (التهاب الدماغ عادة ما يسببه فيروس؛ تشمل الأعراض الصداع وألم الرقبة والنعاس والغثيان والحمى)",
 "cephalochordate": "حبلي الرأس, سهيم (حيوانات تشبه الأسماك لها حبل ظهري بدلاً من عمود فقري حقيقي)",
 "cephaloglycin": "سيفالوغليسين, كافوسين (مضاد حيوي مرتبط بالسيفالوسبورين ولكن لم يعد يستخدم بشكل شائع)",
 "cephalohematoma": "ورم دموي رأسي (تجمع للدم تحت فروة رأس المولود الجديد؛ ناتج عن الضغط أثناء الولادة)",
 "cephalometry": "قياس الرأس (قياس الرؤوس البشرية)",
 "cephalopod": "رَأْسِيّ الْقَدَم, رُأْسَقَدَمِيّ",
 "cephalopod mollusk": "رأسيات القدم (رخوي بحري يتميز برأس وعيون متطورة ومجسات تحمل ممصات)",
 "cephalopodan": "رأسي القدم (يتعلق أو ينتمي إلى فئة رأسيات الأرجل)",
 "cephalopterus ornatus": "طائر المظلة (طائر أمريكي استوائي أسود له عرف كبير متدلٍ ودلاية طويلة مغطاة بالريش)",
 "cephaloridine": "سيفالوريدين (مضاد حيوي واسع الطيف شبه صناعي ينتج عن تعديل السيفالوسبورين)",
 "cephalosporin": "سيفالوسبورين, ميفوكسين (واحد من عدة مواد مضادة حيوية واسعة الطيف يتم الحصول عليها من الفطريات وترتبط بالبنسلين (الأسماء التجارية ميفوكسين)؛ أدت إضافة سلاسل جانبية إلى إنتاج…)",
 "cephalothin": "سيفالوثين (نظير شبه صناعي للسيفالوسبورين)",
 "cephalotus follicularis": "نبات الإبريق الأسترالي (عشب لاحم معمر له إبريق أخضر وغطاء مفصلي كلاهما بحواف حمراء؛ غرب أستراليا)",
 "cepphus columba": "غلموت الحمام (غلموت شمال المحيط الهادئ)",
 "cepphus grylle": "غلموت أسود, مور أسود (غلموت شمال الأطلسي)",
 "cer": "استجابة عاطفية مشروطة, انفعال شرطي (استجابة عاطفية تم اكتسابها عن طريق الإشراط)",
 "ceramic": "خَزَفِيّ",
 "ceramic ware": "أواني خزفية, خزفيات (أواني مصنوعة من مادة السيراميك)",
 "ceramicist": "خزاف, صانع الفخار (حرفي يشكل الفخار على عجلة الفخار ويخبزها في فرن)",
 "ceramics": "خزف, فن الخزف (فن صنع وزخرفة الفخار)",
 "ceramist": "خزاف, صانع الفخار (حرفي يشكل الفخار على عجلة الفخار ويخبزها في فرن)",
 "cerapteryx graminis": "عثة قرن الوعل (عثة أوروبية بعلامات بيضاء تشبه قرن الوعل على الأجنحة الأمامية؛ تتلف اليرقات المراعي والأراضي العشبية)",
 "ceras": "قرن (أحد الهياكل الشبيهة بالقرن ذات الألوان الزاهية والمتفرعة غالباً على ظهر عاريات الخياشيم (وغيرها من الرخويات ذات الصلة) والتي تعمل كخياشيم)",
 "cerastes": "أفعى مقرنة (أفعى شديدة السمية من شمال أفريقيا وجنوب غرب آسيا لها شوكة قرنية فوق كل عين)",
 "cerastes cornutus": "أفعى مقرنة (أفعى شديدة السمية من شمال أفريقيا وجنوب غرب آسيا لها شوكة قرنية فوق كل عين)",
 "cerastium alpinum": "أذن الفأر الألبي, أذن الفأر القطبي (منتشرة في القطب الشمالي وعلى الجبال في أوروبا)",
 "cerastium arvense": "أذن الفأر الحقلي, عشبة الطيور الحقلية (عشبة الطيور المعمرة كثيفة التكتل في المنطقة المعتدلة الشمالية)",
 "cerastium tomentosum": "ثلج في الصيف (عشبة الطيور ذات أوراق رمادية فضية مشعرة وأزهار بيضاء كبيرة نوعاً ما)",
 "cerate": "سيرات, مرهم شمعي (عجينة طبية صلبة مصنوعة من شحم الخنزير أو الزيت الممزوج بالشمع أو الراتنج)",
 "ceratin": "كيراتين (بروتين ليفي صلب يوجد في الطبقة الخارجية للجلد وفي الأنسجة القرنية مثل الشعر والريش والأظافر والحوافر)",
 "ceratitis capitata": "ذبابة فاكهة البحر المتوسط (ذبابة صغيرة سوداء وبيضاء تتلف الحمضيات والفواكه الأخرى عن طريق زرع البيض الذي يفقس داخل الفاكهة)",
 "ceratodus": "سمكة رئوية منقرضة (سمكة رئوية منقرضة)",
 "ceratonia siliqua": "خروب, شجرة الخروب (شجرة متوسطية دائمة الخضرة بقرون صالحة للأكل؛ الخروب المذكور في الكتاب المقدس)",
 "ceratopetalum gummiferum": "سيراتوبيتالوم, شجيرة عيد الميلاد (شجرة أو شجيرة أسترالية بزهور حمراء؛ تستخدم غالباً في زينة عيد الميلاد)",
 "ceratopsian": "ديناصور مقرن (أي من عدة ديناصورات عشبية رباعية الأرجل ذات جماجم ضخمة بمنقار؛ من أواخر العصر الطباشيري في أمريكا الشمالية ومنغوليا)",
 "ceratopteris pteridioides": "سرخس عائم, عفريت الماء (سرخس مائي في أمريكا الاستوائية يستخدم غالباً في أحواض السمك)",
 "ceratopteris thalictroides": "سرخس عائم (سرخس مائي استوائي شامل)",
 "ceratosaur": "سيراتوصور (ثيروبود بدائي متوسط الحجم؛ ديناصور لاحم ثنائي الأرجل سريع الجري له أيدٍ قابضة بمخالب حادة وقرن قصير بين فتحتي الأنف؛ من العصر الجوراسي في أمريكا…)",
 "ceratosaurus": "سيراتوصور (ثيروبود بدائي متوسط الحجم؛ ديناصور لاحم ثنائي الأرجل سريع الجري له أيدٍ قابضة بمخالب حادة وقرن قصير بين فتحتي الأنف؛ من العصر الجوراسي في أمريكا…)",
 "ceratostomella ulmi": "فطر الدردار الهولندي (فطر يسبب مرض الدردار الهولندي)",
 "ceratotherium simum": "وحيد القرن الأبيض (وحيد قرن أفريقي كبير رمادي فاتح له قرنان؛ مهدد بالانقراض)",
 "ceratozamia": "سيراتوزاميا (سيكاد صغير من جنس سيراتوزاميا له جذع خشبي قشري قصير وأوراق تشبه السرخس ومخاريط خشبية؛ المكسيك)",
 "cerberus": "سِيرْبِيرُوس",
 "cercaria": "ذانبة, سركاريا (يرقة طفيلية تشبه الشرغوف للدودة المثقوبة؛ يختفي الذيل في مرحلة البلوغ)",
 "cercarial": "ذانبي (من أو متعلق بالذانبة (يرقة المثقوبات))",
 "cercidiphyllum japonicum": "سيرسيديفيلوم, كاتسورا (شجرة نفضية سريعة النمو في سفوح الجبال المنخفضة في الصين واليابان؛ تزرع للزينة لأوراقها الخضراء المزرقة الداكنة برائحة الحلوى التي تتحول إلى الأصفر…)",
 "cercidium floridum": "بالو فيردي (شجرة شائكة كثيفة التفرع من جنوب غرب الولايات المتحدة ذات أزهار صفراء مبهرجة ولحاء أزرق مخضر؛ تصنف أحياناً في جنس سيرسيديوم)",
 "cercis canadensis": "برعم أحمر, زمريق كندي (شجرة شجيرية صغيرة من شرق أمريكا الشمالية تشبه شجرة يهوذا ولها زهور وردية عادة؛ توجد في الغابات التحتية المحمية الرطبة)",
 "cercis occidentalis": "زمزريق غربي, زمزريق كاليفورنيا (شجيرة من غرب الولايات المتحدة ذات أزهار وردية أو قرمزية؛ غالباً ما تشكل غابات كثيفة)",
 "cercis siliquastrum": "زمريق, شجرة يهوذا (شجرة صغيرة من شرق البحر الأبيض المتوسط لها زهور حمراء أرجوانية وفيرة تنمو على الخشب القديم مباشرة من السيقان وتظهر قبل الأوراق: تزرع على نطاق واسع في…)",
 "cercopithecus aethiops": "جريفيت (قرد شرق أفريقي أبيض وأخضر زيتوني مع خصلات شعر بيضاء طويلة بجانب الوجه)",
 "cercopithecus aethiops pygerythrus": "سعدان الفرفت (قرد جنوب أفريقي ذو وجه وأيدٍ سوداء)",
 "cercopithecus aethiops sabaeus": "سعدان أخضر (قرد سافانا شائع ذو ظهر رمادي مخضر وذيل أصفر)",
 "cercopithecus talapoin": "تالبوين (أصغر قرد غينون؛ يعيش في غابات المستنقعات بوسط وغرب أفريقيا)",
 "cercospora kopkei": "فطر البقعة الصفراء (فطر يسبب البقعة الصفراء (مرض قصب السكر في أستراليا))",
 "cere": "قير (الغطاء اللحمي الشمعي عند قاعدة المنقار العلوي لبعض الطيور)",
 "cereal": "حُبُوب",
 "cereal bowl": "وعاء حبوب الإفطار (وعاء لحفظ حبوب الإفطار)",
 "cereal box": "علبة حبوب الإفطار (صندوق ورقي تباع فيه حبوب الإفطار)",
 "cereal grass": "حبوب, نجيليات حبوب (عشب تستخدم حبوبه النشوية كغذاء: القمح، الأرز، الجاودار، الشوفان، الذرة، الحنطة السوداء، الدخن)",
 "cereal oat": "شوفان, شوفان زراعي (يزرع على نطاق واسع في المناطق المعتدلة لحبوبه الصالحة للأكل)",
 "cerebellar": "مخيخي (يتعلق بـ أو مرتبط بالمخيخ)\nمثال: شريان مخيخي",
 "cerebellar artery": "شريان مخيخي (شريان يغذي المخيخ)",
 "cerebellar hemisphere": "نصف كرة مخيخية (أي من الفصين الجانبيين للمخيخ)",
 "cerebellar vein": "وريد مخيخي (الأوردة التي تصرف المخيخ)",
 "cerebellum": "مُخَيْخ",
 "cerebral": "مُخِّيّ",
 "cerebral aneurysm": "أم الدم الدماغية, تمدد الأوعية الدموية الدماغية (تمدد الأوعية الدموية في الشريان السباتي)",
 "cerebral aqueduct": "قناة سيلفيان, مسال مخي (قناة تربط البطينين الثالث والرابع)",
 "cerebral artery": "شريان مخي (أي من الشرايين التي تغذي القشرة المخية بالدم)",
 "cerebral cortex": "قشرة مخية",
 "cerebral death": "موت دماغي (الموت عند غياب التنفس وردود الفعل الأخرى؛ وذهاب الوعي؛ حيث يمكن إزالة الأعضاء لزرعها قبل توقف ضربات القلب)",
 "cerebral edema": "وذمة دماغية (تورم الدماغ بسبب امتصاص الماء في النسيج العصبي والمادة البيضاء)",
 "cerebral hemisphere": "نصف كرة مخية (أي من نصفي المخ)",
 "cerebral hemorrhage": "نزيف دماغي (نزيف من وعاء دموي ممزق في الدماغ)",
 "cerebral mantle": "قشرة مخية (طبقة الخلايا العصبية غير الميالينية (المادة الرمادية) التي تشكل قشرة المخ)",
 "cerebral palsy": "شلل دماغي",
 "cerebral peduncle": "سويقة, سويقة مخية (حزمة من العصبونات المغلفة بالمايلين تربط أجزاء مختلفة من الدماغ)",
 "cerebral thrombosis": "تخثر دماغي (جلطة دموية في شريان أو وريد دماغي)",
 "cerebral vein": "وريد مخي (أي من عدة أوردة تخدم نصفي الكرة المخية)",
 "cerebrally": "دماغياً, مخياً (في الدماغ) / ذهنياً, فكرياً (بطريقة عقلانية أو فكرية)\nمثال: ينزف دماغياً",
 "cerebration": "تفكير, فكر (عملية استخدام عقلك للنظر في شيء ما بعناية)\nمثال: التفكير دائماً ما يجعله يعبس",
 "cerebromeningitis": "التهاب السحايا والدماغ (التهاب الدماغ والحبل الشوكي وسحاياهما)",
 "cerebroside": "سيريبروزيد (أي من المركبات الدهنية العضوية المختلفة التي تحتوي على الجلوكوز أو الجالاكتوز؛ وتوجد في غمد المايلين للخلايا العصبية الدماغية الشوكية)\nمثال: السيريبروزيد هو غليكوليبيد",
 "cerebrospinal": "دماغي نخاعي (من أو متعلق بالدماغ والحبل الشوكي)\nمثال: سائل دماغي نخاعي",
 "cerebrospinal fever": "التهاب السحايا الدماغي الشوكي, حمى مخية شوكية (التهاب سحايا تسببه البكتيريا وغالبًا ما يكون مميتًا)",
 "cerebrospinal fluid": "سائل دماغي شوكي (سائل صاف ينتج في بطينات الدماغ؛ يملأ ويحمي التجاويف في الدماغ والحبل الشوكي)",
 "cerebrospinal meningitis": "التهاب السحايا الدماغي الشوكي, حمى مخية شوكية (التهاب سحايا تسببه البكتيريا وغالبًا ما يكون مميتًا)",
 "cerebrovascular": "دماغي وعائي (من أو متعلق بالدماغ والأوعية الدموية التي تغذيه)\nمثال: حادث وعائي دماغي",
 "cerebrovascular accident": "جلطة, سكتة دماغية (فقدان مفاجئ للوعي ناتج عن تمزق أو انسداد الأوعية الدموية مما يؤدي إلى نقص الأكسجين في الدماغ)",
 "cerebrum": "مخ (الجزء الأمامي من الدماغ يتكون من نصفي كرة؛ الجزء المهيمن من الدماغ في البشر)",
 "cerecloth": "قماش مشمع (قماش مشمع مقاوم للماء كان يستخدم سابقاً ككفن)",
 "cerement": "كفن (رداء الدفن الذي تُلف فيه الجثة)",
 "ceremonial": "اِحْتِفَالِيّ, مَرَاسِمِيّ (يَتَّسِمُ بِالأُبَّهَةِ أَوِ المَرَاسِمِ أَوِ الرَّسْمِيَّةِ) / احتفال رسمي, طقس (حدث رسمي يتم إجراؤه في مناسبة خاصة)\nمثال: مراسم تخليد ذكرى بيرل هاربور",
 "ceremonial dance": "رقص طقسي (رقصة تكون جزءاً من طقس ديني)",
 "ceremonial occasion": "احتفال رسمي, طقس (حدث رسمي يتم إجراؤه في مناسبة خاصة)\nمثال: مراسم تخليد ذكرى بيرل هاربور",
 "ceremonially": "بشكل طقوسي, في حفل رسمي (بطريقة احتفالية) / بشكل رسمي, بمراسم (بطريقة رسمية واحتفالية)\nمثال: أدى اليمين الدستورية كرئيس في حفل رسمي",
 "ceremonious": "تَقْلِيدِيّ, مُتَكَلِّف (رَسْمِيٌّ بِشَكْلٍ صَارِمٍ أَوْ مُقَيَّدٌ بِالأَعْرَافِ) / فخم, مهيب (يتميز بالأبهة والمراسم والعرض الفخم)",
 "ceremoniously": "بشكل رسمي, بمراسم (بطريقة رسمية واحتفالية)\nمثال: نصحت أمي أطفالها بشكل رسمي",
 "ceremoniousness": "تشريفات, مراسم (أسلوب مراسمي)",
 "ceremony": "مَرَاسِم, طُقُوس / حَفْل رَسْمِيّ (الحَفْل: اجْتِمَاعُ الْمَاءِ فِي مَحْفِلِه؛ حَفَلَ الماءُ يَحْفِلُ حَفْلًا وحُفُولًا وحَفِيلًا)\nمثال: حفل زفافهم غدا.",
 "ceres": "سِيرِيس",
 "ceresin": "سيريسين (شمع أبيض مستخرج من الأوزوكيريت)",
 "cereus": "شَمْعِيَّة, شَمَعِيَّة",
 "ceric": "سيري رباعي, سيريك (من أو متعلق بـ أو يحتوي على السيريوم خاصة بالتكافؤ 4)",
