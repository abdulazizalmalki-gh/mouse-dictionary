 "civil authority": "سلطة مدنية, مسؤول مدني (شخص يمارس السلطة على الشؤون المدنية)",
 "civil censorship": "رقابة مدنية (رقابة عسكرية على الاتصالات المدنية (المراسلات أو المواد المطبوعة أو الأفلام) التي تدخل أو تغادر أو تتداول داخل الأراضي التي تسيطر عليها القوات المسلحة)",
 "civil code": "قَانُون مَدَنِيّ (مقياس كل شيء وطريقه؛ أمر كليّ ينطبق على جميع جزئياته التي تعرف أحكامها منه)\nمثال: ذكرني بالقانون.",
 "civil contempt": "اِزْدِرَاء مَدَنِيّ (الفشل في اتباع أمر محكمة يفيد شخصاً آخر)",
 "civil day": "يوم تقويمي, يوم مدني (يوم يحسب من منتصف الليل إلى منتصف الليل)",
 "civil death": "إهدار الدم, تجريد من الحقوق المدنية (إلغاء الحقوق المدنية) / موت مدني (الوضع القانوني لشخص على قيد الحياة ولكنه حُرم من حقوق وامتيازات المواطن أو عضو المجتمع؛ الوضع القانوني لمن حُكم عليه بالسجن المؤبد)",
 "civil defense": "دِفَاع مَدَنِيّ, حِمَايَة مَدَنِيَّة",
 "civil disobedience": "عِصْيان مَدَنيّ",
 "civil engineer": "مهندس مدني (مهندس مدرب على تصميم وبناء وصيانة الأشغال العامة (الطرق أو الجسور أو الموانئ وما إلى ذلك))",
 "civil engineering": "الهندسة المدنية",
 "civil law": "قَانُون مَدَنِيّ (مقياس كل شيء وطريقه؛ أمر كليّ ينطبق على جميع جزئياته التي تعرف أحكامها منه)\nمثال: ذكرني بالقانون.",
 "civil leader": "زعيم مدني, قائد مجتمعي (قائد في الشؤون البلدية أو المدنية)",
 "civil libertarian": "مناصر للحريات المدنية (تحرري يهتم بنشاط بحماية الحريات المدنية)",
 "civil liberty": "حرية مدنية (حق فردي أساسي يحميه القانون ويُعبر عنه بالحصانة من التدخل الحكومي غير المبرر) / حرية سياسية, حرية مدنية (حرية الفرد في ممارسة حقوقه كما تضمنها قوانين البلاد)",
 "civil list": "القائمة المدنية (مبلغ من المال يصوت عليه البرلمان البريطاني كل عام لنفقات العائلة المالكة البريطانية)",
 "civil marriage": "زواج مدني (زواج يجريه مسؤول حكومي بدلاً من رجل دين)",
 "civil officer": "سلطة مدنية, مسؤول مدني (شخص يمارس السلطة على الشؤون المدنية)",
 "civil order": "نظام الحكم, نظام مدني (شكل حكومة منظمة اجتماعية)",
 "civil right": "حق مدني (حق أو حقوق تخص الشخص بحكم المواطنة، بما في ذلك الحريات والامتيازات الأساسية التي يكفلها القانون (مثل التعديلات 13 و 14 في الدستور الأمريكي)، بما في…)",
 "civil rights activist": "قائِد حُقُوق مَدَنِيَّة, ناشِط حُقُوقِيّ (قائد للحركة السياسية المكرسة لضمان تكافؤ الفرص لأعضاء الأقليات)",
 "civil rights leader": "قائِد حُقُوق مَدَنِيَّة, ناشِط حُقُوقِيّ (قائد للحركة السياسية المكرسة لضمان تكافؤ الفرص لأعضاء الأقليات)",
 "civil rights movement": "حركة الحقوق المدنية (حركة في الولايات المتحدة بدأت في الستينيات وقادها السود بشكل أساسي في محاولة لتأسيس الحقوق المدنية للمواطنين السود الأفراد)",
 "civil rights worker": "قائِد حُقُوق مَدَنِيَّة, ناشِط حُقُوقِيّ (قائد للحركة السياسية المكرسة لضمان تكافؤ الفرص لأعضاء الأقليات)",
 "civil script": "الخط المدني (شكل مبسط للأبجدية السيريلية، قدمه القيصر بطرس الأكبر لطباعة الأعمال العلمانية)\nمثال: أدى إدخال الخط المدني، الذي صمم في عهد بطرس الأكبر للأغراض العلمية والأكاديمية، إلى تغيير النظام بشكل حاسم",
 "civil servant": "مُوَظَّف, مُوَظَّفَة",
 "civil service": "خدمة مدنية, موظفو الخدمة المدنية (موظفون حكوميون؛ يتم تعيينهم عادة على أساس امتحانات تنافسية)",
 "civil society": "مُجْتَمَع مَدَنِيّ (قد يقصد به المكان الذي يجتمع فيه الناس؛ مجموعة من الناس من طبقة اجتماعية واحدة تختلط ببعضها ولها ما يميزها عن غيرها من المجموعات البشرية)\nمثال: سامي خطر للمجتمع.",
 "civil suit": "دعوى مدنية (دعوى قضائية تزعم انتهاكات للقانون المدني من قبل المدعى عليه)",
 "civil time": "توقيت محلي, توقيت مدني (الوقت الرسمي في منطقة محلية (معدل حسب الموقع حول الأرض)؛ يحدد بالقانون أو العرف)",
 "civil union": "اتحاد مدني (اتحاد طوعي مدى الحياة (أو حتى الطلاق) لأطراف بالغة من نفس الجنس)\nمثال: يتمتع أطراف الاتحاد المدني بجميع المزايا والحماية والمسؤوليات نفسها بموجب قانون فيرمونت مثل الأزواج في الزواج",
 "civil war": "حَرْب أَهْلِيَّة (حَرَبَ (حربه) بالحربة حربا: طعنه بها؛ حَرَبَ (ه) حربا: سلبه جميع ما يملك)\nمثال: بوتين مجرم حرب.",
 "civil wrong": "جنحة مدنية, ضرر مدني ((قانون) أي خطأ يمكن رفع دعوى بسببه للمطالبة بتعويضات)",
 "civil year": "سنة تقويمية, سنة ميلادية (السنة (التي تحسب من 1 يناير إلى 31 ديسمبر) وفقاً للتقويم الغريغوري)",
 "civil-libertarian": "لِيبْرَالِيُّ الحُقُوقِ المَدَنِيَّةِ (لَدَيْهِ اهْتِمَامٌ فَعَّالٌ بِحِمَايَةِ الحُرِّيَّاتِ المَدَنِيَّةِ المَكْفُولَةِ دُسْتُورِيًّا)",
 "civilian": "مَدَنِيّ / مَدَنِيَّة",
 "civilian clothing": "زي مدني, ملابس مدنية (الملابس العادية تمييزاً لها عن الزي الرسمي أو ملابس العمل أو الزي الديني)",
 "civilian dress": "زي مدني, ملابس مدنية (الملابس العادية تمييزاً لها عن الزي الرسمي أو ملابس العمل أو الزي الديني)",
 "civilian garb": "زي مدني, ملابس مدنية (الملابس العادية تمييزاً لها عن الزي الرسمي أو ملابس العمل أو الزي الديني)",
 "civilisation": "تَحَضُّر, تَهْذِيب (صفة التميز في الفكر والأخلاق والذوق) / حضارة (مجتمع في حالة متقدمة من التطور الاجتماعي (مثل وجود تنظيمات قانونية وسياسية ودينية معقدة)) / ثقافة, حضارة (مجتمع معين في وقت ومكان معينين) / تحضر, تخضر (العملية الاجتماعية التي تحقق بها المجتمعات مرحلة متقدمة من التطور والتنظيم)\nمثال: رجل ذو رقي فكري",
 "civilised": "مُتَحَضِّر, مُتَمَدِّن (لديه حالة عالية من الثقافة والتطور الاجتماعي والتكنولوجي) / رَاقٍ, مُتَحَضِّرٌ (يتميز بالرقي في الذوق والسلوك)\nمثال: أعمال إرهابية صدمت العالم المتحضر",
 "civility": "أَدَب (هو الظُرْف وحسن التَنَاوُل أو التَصَرُّف، أو هو مَلَكَة تعصم من كانت به عما يشينه؛ تطلق على المُسْتَظْرف من المعارف والعلوم)\nمثال: زيري يحب الأدب.",
 "civilization": "حَضَارَة, تَمَدُّن (حَضَارَة: مصدر؛ ضد البداوة، الإستقرار في الحضر. \"فلان من أهل الحضارة\" أي من أهل المدن أو القرى؛ حَضَارَة: مصدر؛ مَدَنِية. \"السرعة جزء من الحضارة الحديثة\"، أي جزء من الحياة في المدن في الوقت الحديث) / تَثْقِيف\nمثال: الحضارة الامازيغية عظيمة.",
 "civilized": "مُتَحَضِّر, مُتَمَدِّن (لديه حالة عالية من الثقافة والتطور الاجتماعي والتكنولوجي) / رَاقٍ, مُتَحَضِّرٌ (يتميز بالرقي في الذوق والسلوك)\nمثال: أعمال إرهابية صدمت العالم المتحضر",
 "civilly": "بأدب, بتحضر (بطريقة متحضرة ومهذبة)\nمثال: يعامل زوجته السابقة بكياسة",
 "civvies": "ملابس مدنية (الزي المدني في مقابل الزي العسكري)",
 "cjd": "مرض كروتزفيلد جاكوب (مرض دماغي نادر (قاتل عادة) (يحدث عادة في منتصف العمر) يسببه فيروس بطيء غير محدد؛ يتميز بخرف تدريجي وفقدان تدريجي للتحكم العضلي)",
 "cl": "مِئَة وَخَمْسُونَ (يَدُلُّ عَلَى العَدَد 150) / سنتيلتر (وحدة مترية للحجم تساوي واحداً من المائة من اللتر) / كلور (عنصر لافلزي شائع ينتمي إلى الهالوجينات؛ يشتهر كغاز سام أصفر ثقيل مهيج)",
 "clabber": "حليب رائب متخثر (حليب خام حمض وتكثف)",
 "clack": "صمام رداد, صمام عدم رجوع (صمام بسيط بمفصلة على جانب واحد؛ يسمح للسائل بالتدفق في اتجاه واحد فقط) / تصفيق, طقطقة (ضجيج حاد مفاجئ وكأن شيئين يضربان معاً؛ قد يتكرر)",
 "clack valve": "صمام رداد, صمام عدم رجوع (صمام بسيط بمفصلة على جانب واحد؛ يسمح للسائل بالتدفق في اتجاه واحد فقط)",
 "clad": "مَكْسُوّ, مُرْتَدٍ مَلَابِس (يرتدي أو مزود بملابس؛ تستخدم أحياناً في التركيب) / مُغَلَّف بِطَبَقَة, مُكَسَّى (له غطاء خارجيّ خاصّةً من المعدن الرقيق)\nمثال: مكسو وفي كامل قواه العقلية",
 "cladding": "تكسية خارجية, كسوة (غطاء واقٍ يحمي الجزء الخارجي من المبنى)",
 "clade": "زمرة, فَرْع حَيَوِي (مجموعة من الأصناف البيولوجية أو الأنواع التي تشترك في سمات موروثة من سلف مشترك)",
 "cladistic analysis": "تحليل تفرعي, تفرع حيوي (نظام تصنيفي لتصنيف الأنواع بناءً على أنماط التفرع)",
 "cladistics": "تحليل تفرعي, تفرع حيوي (نظام تصنيفي لتصنيف الأنواع بناءً على أنماط التفرع)",
 "cladode": "ساق ورقية (ساق مسطحة تشبه ورقة الشجر وتعمل عملها)",
 "cladogram": "كلادوجرام, مخطط التفرع (مخطط شجري يستخدم لتوضيح العلاقات التطورية)",
 "cladonia rangiferina": "طحلب الرنة (أشنة متفرعة رمادية منتصبة في القطب الشمالي وحتى بعض المناطق المعتدلة الشمالية تشكل الغذاء الرئيسي للرنة والكاريبو وأحياناً يأكلها البشر)",
 "cladophyll": "ساق ورقية (ساق مسطحة تشبه ورقة الشجر وتعمل عملها)",
 "cladorhyncus leucocephalum": "أبو مغازل مطوق (أبو مغازل أسترالي مكفف القدمين ذو علامات صدرية بنية محمرة)",
 "cladrastis kentukea": "خشب أصفر كنتاكي (شجرة نفضية صغيرة وسيمة مستديرة الرأس لها زهور بيضاء ملفتة للنظر في عناقيد طرفية وخشب صلب ثقيل ينتج صبغة صفراء)",
 "cladrastis lutea": "خشب أصفر كنتاكي (شجرة نفضية صغيرة وسيمة مستديرة الرأس لها زهور بيضاء ملفتة للنظر في عناقيد طرفية وخشب صلب ثقيل ينتج صبغة صفراء)",
 "claforan": "سيفوتاكسيم, كلافوران (سيفالوسبورين يعطى بالحقن (الاسم التجاري كلافوران) يستخدم للعدوى الشديدة في الرئتين أو الحلق أو الأذنين أو المسالك البولية)",
 "claim": "دَعْوَى, اِدِّعَاء (إدِّعَاء؛ دُعَاء) / مُطَالَبَة / ٱِدَّعَى, زَعَمَ\nمثال: رفضت الضحية إقامة دعوى قضائية.",
 "claim agent": "مُسوي مطالبات, وكيل مطالبات (شخص يحقق في مطالبات التأمين أو المطالبات عن الأضرار ويوصي بتسوية فعالة)",
 "claim form": "نموذج مطالبة (نموذج يستخدم عند رفع مطالبة)",
 "claim jumper": "مستولٍ على الملكية (من يحتل ممتلكات بشكل غير قانوني رغم وجود مطالب قانوني آخر بها)",
 "claimant": "مُدَّعٍ, مُدَّعِيَة",
 "claimer": "مُدَّعٍ, مُدَّعِيَة",
 "claiming race": "سباق المطالبة, سباق بيع الخيول (سباق خيول يعلن فيه كل مالك قبل السباق عن السعر الذي سيتم عرض حصانه للبيع به بعد السباق)",
 "claims adjuster": "مُسوي مطالبات, وكيل مطالبات (شخص يحقق في مطالبات التأمين أو المطالبات عن الأضرار ويوصي بتسوية فعالة)",
 "claims adjustor": "مُسوي مطالبات, وكيل مطالبات (شخص يحقق في مطالبات التأمين أو المطالبات عن الأضرار ويوصي بتسوية فعالة)",
 "clairvoyance": "إدراك خارج الحواس, استبصار (قوة ظاهرية لإدراك أشياء غير موجودة للحواس)",
 "clairvoyant": "اِسْتِبْصَارِيّ, بَصِير (يستشرف المستقبل ويتوقّعه) / بَصِير, ذُو رُؤْيَة خَارِقَة (يدرك أشياء تتجاوز نطاق الحواسّ الطبيعية) / عرّاف, مستبصر (شخص لديه قوة الاستبصار)",
 "clam": "بطلينوس, محار (رخوي بحري حفار يعيش على الرمل أو الطين؛ تغلق الصدفة بصلابة تشبه الملزمة) / بطلينوس, جندوفلي (لحم البطلينوس ذو القشرة الصلبة أو الناعمة) / دولار (قطعة نقود ورقية قيمتها دولار واحد)",
 "clam chowder": "تشاودر المحار (تشاودر يحتوي على المحار)",
 "clam dip": "تغميسة المحار (تغميسة مصنوعة من المحار والجبن الكريمي الطري)",
 "clamant": "مُتَطَلِّب, مُلِحّ (يَسْتَدْعِي الانْتِبَاهَ فَوْرًا) / صَاخِب, صَخَّاب (عالي الصوت بشكل لافت ومزعج؛ يميل إلى الصياح الشديد)",
 "clamatorial": "صائح",
 "clambake": "كلامبيك (طهي في الهواء الطلق على شاطئ البحر حيث يُطهى المحار والسمك وأطعمة أخرى — عادة على حجارة ساخنة مغطاة بالأعشاب البحرية)",
 "clamber": "تسلق بصعوبة (تسلق محرج أو صعب)\nمثال: كان الوصول إلى القمة تسلقاً صعباً",
 "clammily": "برطوبة لزجة (بطريقة لزجة ورطبة)",
 "clamminess": "رطوبة لزجة, عفونة (رطوبة غير سارة)",
 "clammy": "رَطْب كَرِيه, نَدِيّ بَارِد (بارد ورطب بشكل مزعج)",
 "clammy chickweed": "أذن الفأر, حشيشة القزاز (أي من النباتات المتنوعة المرتبطة بحشيشة القزاز الشائعة)",
 "clammy locust": "روبينيا لزجة, سنط لزج (سنط صغير خشن اللحاء من جنوب شرق الولايات المتحدة له عناقيد من الزهور الوردية وفروع وبذور لزجة)",
 "clammyweed": "بولانيسيا, عشبة لزجة (عشب قوي الرائحة شائع في جنوب الولايات المتحدة مغطى بخليط من الغدد والشعيرات)",
 "clamor": "جلبة, صخب (صيحات عالية ومستمرة من العديد من الناس) / جلبة, صخب (ضجيج عالٍ خشن أو حاد)\nمثال: تجاهل صخب الحشد",
 "clamoring": "جلبة, صخب (صيحات عالية ومستمرة من العديد من الناس)\nمثال: تجاهل صخب الحشد",
 "clamorous": "صَاخِب, صَخَّاب (عالي الصوت بشكل لافت ومزعج؛ يميل إلى الصياح الشديد)",
 "clamorously": "بصخب, بضجيج (بطريقة تجذب الانتباه)\nمثال: بصخب، طالب بالحصول على الخدمة",
 "clamour": "جلبة, صخب (صيحات عالية ومستمرة من العديد من الناس)\nمثال: تجاهل صخب الحشد",
 "clamouring": "جلبة, صخب (صيحات عالية ومستمرة من العديد من الناس)\nمثال: تجاهل صخب الحشد",
 "clamp": "مَشْبَك",
 "clampdown": "تضييق, حملة قمعية (تقييد مفاجئ لنشاط ما)",
 "clams": "فلوس, نقود (مصطلحات غير رسمية للمال)",
 "clamshell": "صَدَفَةُ البَطْلِينُوس (صدفة حيوان البطلينوس) / غارفة محارية (دلو جرف بمفاصل تشبه صدفة المحار)",
 "clan": "عَشِيرَة (مؤنث العَشِيْر؛ التي تعاشرها. الجمع عَشِيرَات؛ إحدى طبقات الأنساب دون الفخذ وفوق الفصيلة. الجمع عَشَائِر)",
 "clan member": "فَرْد مِن العَشِيرَة (عضو في عشيرة)",
 "clandestine": "سري",
 "clandestine operation": "عملية سرية (عملية استخباراتية مخطط لها ومنفذة لضمان الإخفاء)",
 "clang": "تحطم, رنين (ضجيج رنان عالٍ ومتكرر)\nمثال: كان بإمكانه سماع رنين الأجراس البعيدة",
 "clanger": "خطأ فادح, فضيحة (خطأ واضح تبدو آثاره مدوية)\nمثال: ارتكب خطأ فادحاً",
 "clanging": "رَنَّان, مُدَوٍّ (ذو صوت معدنيّ رنّان وعالٍ)",
 "clangor": "تحطم, رنين (ضجيج رنان عالٍ ومتكرر)\nمثال: كان بإمكانه سماع رنين الأجراس البعيدة",
 "clangoring": "تحطم, رنين (ضجيج رنان عالٍ ومتكرر)\nمثال: كان بإمكانه سماع رنين الأجراس البعيدة",
 "clangorous": "رَنَّان, مُدَوٍّ (ذو صوت معدنيّ رنّان وعالٍ)",
 "clangour": "تحطم, رنين (ضجيج رنان عالٍ ومتكرر)\nمثال: كان بإمكانه سماع رنين الأجراس البعيدة",
 "clangula hyemalis": "بط طويل الذيل (بط بحري طويل الذيل شائع في الأجزاء الشمالية من الولايات المتحدة)",
 "clank": "قَعْقَعَ",
 "clanker": "خشخيشة, شيء ذو رنين (شيء يصدر صوتاً معدنياً (رنيناً))",
 "clanking": "قَعْقَاع (ذو صوت معدنيّ صلب غير رنّان)",
 "clannish": "عَشَائِرِيّ, مُتَعَصِّب لِجَمَاعَتِه (يليق بمن يميلون إلى التمييز الاجتماعي ويصدّون من يعتبرونهم أدنى منهم) / عَشَائِرِيّ, قَبَلِيّ (من سمات العشيرة خاصّة في التلاحم والتضامن)",
 "clannishly": "بِانْعِزَالِيَّة, بِعَصَبِيَّة (بطريقة عشائرية)\nمثال: هؤلاء الأصدقاء الأربعة يتصرفون دائماً بانعزالية، ولا يدعوننا نشارك في أنشطتهم",
 "clannishness": "انعزالية, تحزب (الميل للاختلاط بمجموعة مختارة فقط)",
 "clansman": "ابن العشيرة, فرد من القبيلة (عضو ذكر في عشيرة أو قبيلة)",
 "clanswoman": "ابنة العشيرة (عضوة أنثى في عشيرة)",
 "clap": "تَصْفِيق / صَفَّق / صَفَّقَ",
 "clapboard": "ألواح تكسية متراكبة (لوح طويل رفيع تكون إحدى حوافه أكثر سمكاً من الأخرى؛ يستخدم ككساء عن طريق تداخل لوح فوق اللوح الموجود بالأسفل)",
 "clapp's favourite": "كمثرى كلاب المفضلة (كمثرى مفيدة مبكرة الموسم تنضج في منتصف أغسطس)\nمثال: شجرة كمثرى كلاب المفضلة لديك تقع في مجموعة الإزهار 4",
 "clapped out": "خَرِب, مُتَهَالِك (بَالٍ مِنَ التَّقَادُمِ أَوِ الاسْتِعْمَالِ الشَّدِيدِ وَلَمْ يَعُدْ صَالِحًا لِلْعَمَلِ)",
 "clapper": "للسان الجرس, مصفق (مطرقة معدنية تتدلى داخل الجرس وتصدر صوتاً بضرب الجانب) / لسان (كتلة متحركة من الأنسجة العضلية مغطاة بغشاء مخاطي وتقع في التجويف الفموي) / مصفق (شخص يصفق)",
 "clapper valve": "صمام رداد, صمام عدم رجوع (صمام بسيط بمفصلة على جانب واحد؛ يسمح للسائل بالتدفق في اتجاه واحد فقط)",
 "clapperboard": "كلاكيت, لوحة التصفيق (معدات تصوير فوتوغرافي تستخدم لمزامنة الصوت والصورة المتحركة؛ لوحات تضرب معاً أمام كاميرا الفيلم)",
 "clappers": "صنوج, كاستانيت ((تستخدم بصيغة الجمع) آلة إيقاعية تتكون من زوج من قطع الخشب أو العظم المجوفة (تُمسك عادة بين الإبهام والأصابع) تُطقطق معاً (كما يفعل الراقصون الإسبان)…)",
 "clapping": "تصفيق (إظهار الموافقة عن طريق ضرب اليدين ببعضهما البعض)",
 "claptrap": "كلام طنان, هراء (كلام أو كتابة متفاخرة أو مدعية)",
 "claque": "مصفقون مستأجرون (مجموعة من المتابعين تم توظيفهم للتصفيق في عرض ما)",
 "clarence": "عربة كلارنس (عربة مغلقة بأربع عجلات ومقاعد لأربعة ركاب)",
 "claret": "أحمر نبيذي (لون أحمر أرجواني داكن) / بوردو الأحمر, كلاريت (نبيذ بوردو أحمر جاف أو نبيذ شبيه بالبوردو)",
 "claret cup": "كأس كلاريت (بونش مصنوع من الكلاريت والبراندي مع عصير الليمون والسكر وأحياناً الشيري أو الكوراساو والفاكهة الطازجة)",
 "clarification": "تَوْضِيح",
 "clarified butter": "سمن (الدُهُون التي تؤكل، وتشمل الزُبْد والقِشْطَة وما يستخرج من الحَيْوَان والنبات. قيل السمن من الحيوان والدهن من النبات وقيل السمن ما يؤكل والدهن ما لا…)",
 "clarify": "اِسْتَجْلَى",
 "clarifying": "تَوْضِيحِيّ, شَارِح (يجعل الأمور واضحة وجلية)",
 "clarinet": "كْلَارِينِيت",
 "clarinet section": "قسم الكلارينيت (قسم الفرقة أو الأوركسترا الذي يعزف على الكلارينيت)",
 "clarinetist": "عازف كلارينيت (موسيقي يعزف على الكلارينيت)",
 "clarinettist": "عازف كلارينيت (موسيقي يعزف على الكلارينيت)",
 "clarion": "رَنَّان, صَدَّاح (عالٍ وواضح كصوت البوق) / بوق, كلاريون (آلة نحاسية من العصور الوسطى ذات نغمة حادة واضحة)",
 "clarity": "صَفَاء, نَقَاء (صفة الماء الصافي) / جَلَاء, صَفَاء (الخلو من الغموض وسهولة الفهم؛ قابلية التعبير الواضح للفهم)\nمثال: عندما استيقظت عاد الصفاء إلى عينيها",
 "clark cell": "خلية كلارك (شكل من أشكال الخلايا الفولتية كان يستخدم سابقاً كمعيار للقوة الدافعة الكهربائية)",
 "clark standard cell": "خلية كلارك (شكل من أشكال الخلايا الفولتية كان يستخدم سابقاً كمعيار للقوة الدافعة الكهربائية)",
 "clark's nutcracker": "كسار بندق كلارك (كسار بندق من غرب الولايات المتحدة)",
 "clarke value": "قِيمَة كِلَارك (متوسط تركيزات العناصر المختلفة في القشرة الأرضية)",
 "clarkia": "كْلَرْكِيَة",
 "claro": "كلارو (سيجار مصنوع من تبغ فاتح اللون)",
 "clary": "قصعين متصلب, ميرمية متصلبة (عشب عطري من جنوب أوروبا؛ يزرع في بريطانيا العظمى كعشب طبخ وعلى نطاق واسع كنبات زينة)",
 "clary sage": "ميرمية كلاري (أوراق طازجة تستخدم في العجة والفطائر ومع لحم الضأن) / قصعين متصلب, ميرمية متصلبة (ميرمية متوسطية قوية بزهور بيضاء أو وردية أو بنفسجية؛ تنتج زيتاً يستخدم كنكهة وفي العطور)",
 "clash": "تَصَادُم / يتصادم",
 "clashing": "مُتَصَادِم, مُتَنَافِر (متنافر بشكل حادّ وقاسٍ)",
 "clasp": "إمساك, قبضة (فعل الإمساك) / مشبك (أداة تثبيت (مثل إبزيم أو خطاف) تستخدم لربط شيئين معاً)\nمثال: أرخى قبضته عن ذراعي",
 "clasp knife": "سكين جيب كبير, مِطواة (سكين كبير بشفرة أو أكثر قابلة للطي)",
 "class": "صِنْف, صَنْف / طَبَقَة / فَصْل, صَفّ (التقطيع؛ تقسيم الشيء أجزاءً؛ جزء، باب في كِتَاب أو ماشابهه) / طَائِفَة (مؤنث طَائِف؛ التي تطوفُ؛ القطعة أو الجزء من الشيء أو الواحدة منه)\nمثال: اقرأ هذا الفصل.",
 "class act": "شخص راقٍ, شخص متميز (شخص يظهر تميزاً مثيراً للإعجاب وأنيقاً)",
 "class action": "دعوى جماعية (دعوى قضائية يرفعها عضو ممثل لمجموعة كبيرة من الناس نيابة عن جميع أعضاء المجموعة)",
 "class feeling": "حقد طبقي (مشاعر الحسد والاستياء من طبقة اجتماعية أو اقتصادية تجاه أخرى)",
 "class fellow": "زميل دراسة, زميل صف (معرفة تذهب معه إلى المدرسة)",
 "class list": "قائمة الشرف (قائمة يصدرها الممتحنون تصنف الطلاب وفقاً لدرجة الشرف التي حققوها في امتحانات درجاتهم العلمية)",
 "class merostomata": "فكيات الأرجل (تستخدم في بعض التصنيفات؛ تشمل رتب سيفيات الذيل وعقارب البحر)",
 "class period": "حِصَّة دِرَاسِيَّة, دَرْس (جلسة مجدولة بانتظام كجزء من دورة دراسية)",
 "class structure": "بنية طبقية (تنظيم الطبقات داخل المجتمع)",
 "class struggle": "صراع الطبقات",
 "class war": "صِرَاع طَبَقِيّ (صراع بين الطبقات الاجتماعية أو الاقتصادية (خاصة بين الطبقة الرأسمالية والطبقة العاملة))",
 "class warfare": "صِرَاع طَبَقِيّ (صراع بين الطبقات الاجتماعية أو الاقتصادية (خاصة بين الطبقة الرأسمالية والطبقة العاملة))",
 "class-action suit": "دعوى جماعية (دعوى قضائية يرفعها عضو ممثل لمجموعة كبيرة من الناس نيابة عن جميع أعضاء المجموعة)",
 "class-conscious": "طَبَقِيّ, مُتَرَاتِب ((للمجتمع) ذو تراتبيَّة اجتماعيَّة طبقيَّة)",
 "classic": "تَقْلِيدِيّ, كُلَاسِيكِيّ (يتعلق بالفترة المهمة الأولى لحضارة أو ثقافة أو مجال دراسة، إلخ) / عَرِيق, كْلَاسِيكِيّ (مَعْرُوفٌ وَمُسْتَقِرٌّ مُنْذُ زَمَنٍ طَوِيلٍ فِي الشَّكْلِ أَوِ الأُسْلُوب) / تُرَاثِيّ, كْلَاسِيكِيّ (يُعتبر من أعلى مستويات الجودة وذو أهمية وقيمة دائمتين) / كِلَاسِيكِيّ, نَمَطِيّ (من نوع معروف؛ نموذجي بشكل لافت)\nمثال: فخار صيني كلاسيكي",
 "classic hemochromatosis": "داء ترسب الأصبغة الدموية الكلاسيكي (الشكل الموروث من داء ترسب الأصبغة الدموية)",
 "classical": "تَقْلِيدِيّ, كْلَاسِيكِيّ",
 "classical antiquity": "اَلْعُصُورُ ٱلْكلَاسِيكِيَّةُ ٱلْقَدِيمَةُ",
 "classical arabic": "اَلْفُصْحَى, فُصْحَى اَلتُّرَاث",
 "classical architecture": "العمارة الكلاسيكية, العمارة اليونانية الرومانية (العمارة المتأثرة باليونان القديمة أو روما)",
 "classical ballet": "باليه كلاسيكي (أسلوب من الباليه يعتمد على خطوات تقليدية دقيقة تُؤدى بحركات رشيقة وانسيابية)",
 "classical conditioning": "إشراط كلاسيكي (إشراط يقرن محفزاً محايداً بمحفز يثير منعكساً؛ يُعطى المحفز المثير للمنعكس سواء حدثت الاستجابة الشرطية أم لا حتى يأتي المحفز المحايد في النهاية لإثارة…)",
 "classical greek": "الأفلاطونية, الأيونية (لهجة اليونانية القديمة التي كان يتم التحدث بها وكتابتها في أتيكا وأثينا وأيونيا)",
 "classical haemophilia": "الناعور أ, الهيموفيليا الكلاسيكية (هيموفيليا ناجمة عن نقص خلقي في العامل الثامن؛ تحدث حصريًا تقريبًا عند الرجال)",
 "classical hemophilia": "الناعور أ, الهيموفيليا الكلاسيكية (هيموفيليا ناجمة عن نقص خلقي في العامل الثامن؛ تحدث حصريًا تقريبًا عند الرجال)",
 "classical latin": "لَاتِينِيَّة كْلَاسِيكِيَّة (المنسوبة إلى المنطقة المحيطة بمدينة روما والتي كانت تسمى لَاتِيْن في عصر الروم وأصبحت الآن تسمى لَازِيُو؛ المنسوبة إلى اللَاتِيْن، وهم دول أمريكا الشمالية والوسطى الذين يتحدثون لغات من أصل لاتينيّ، خصوصا الإِسْبَانِيَّة والبُرْتُغَالِيَّة)\nمثال: أعرف اللاتينية.",
 "classical mechanics": "ميكانيكا كلاسيكية, ميكانيكا نيوتنية (فرع الميكانيكا القائم على قوانين نيوتن للحركة)",
 "classical music": "مُوسِيقَى كْلَاسِيكِيَّة (مُوسِيقى، فنُّ تأليف الألحان وتوزيعها وإيقاعها والغناء والتطريب بضروب المعازف؛ علم الموسيقى : علمٌ يُبحَثُ فيه عن أُصَول النغم من حيث تأَتلف أَو تتنافر، وأَحوال الأَزمنة المتخللة بينها، ليُعلَمَ كيف يؤلَّف اللَّحْن)\nمثال: أتعلم الموسيقى.",
 "classical mythology": "الأساطير الكلاسيكية (نظام الأساطير لليونانيين والرومان معاً؛ حيث تم اقتباس الكثير من الأساطير الرومانية (خاصة الآلهة) من اليونانيين)",
 "classical philology": "فقه اللغة الكلاسيكي (فقه اللغة للسنسكريتية الكلاسيكية واليونانية واللاتينية الكلاسيكية)",
 "classical scholar": "باحث كلاسيكي, كلاسيكي (طالب أو باحث في اللغتين اليونانية واللاتينية القديمة)",
 "classical style": "طراز كلاسيكي (الأسلوب الفني للفن اليوناني القديم بتركيزه على التناسب والانسجام)",
 "classicalism": "كلاسيكية (حركة في الأدب والفن خلال القرنين السابع عشر والثامن عشر في أوروبا فضلت العقلانية وضبط النفس والأشكال الصارمة)\nمثال: غالباً ما استمدت الكلاسيكية نماذجها من اليونان والرومان القدماء",
 "classically": "كِلَاسِيكِيًّا (على نمط الثقافة اليونانية والرومانية)\nمثال: هذا التمرين ينمي جسداً ذو شكل كلاسيكي",
 "classicism": "كلاسيكية (حركة في الأدب والفن خلال القرنين السابع عشر والثامن عشر في أوروبا فضلت العقلانية وضبط النفس والأشكال الصارمة)\nمثال: غالباً ما استمدت الكلاسيكية نماذجها من اليونان والرومان القدماء",
 "classicist": "فنان كلاسيكي, كلاسيكي (شخص فني يلتزم بالمذهب الكلاسيكي) / باحث كلاسيكي, كلاسيكي (طالب أو باحث في اللغتين اليونانية واللاتينية القديمة)",
 "classicistic": "كلاسيكي (متعلق بالكلاسيكية (كمذهب فني أو أدبي))\nمثال: التقليد الكلاسيكي",
 "classics": "كلاسيكيات (دراسة الأعمال الأدبية لليونان وروما القديمة)",
 "classifiable": "قَابِل لِلتَّصْنِيف (يمكن تصنيفه ضمن فئات)",
 "classification": "تَصْنِيف",
 "classification system": "نظام تصنيف (نظام لتصنيف الأشياء)",
 "classificatory": "تصنيفي (يتعلق بالتصنيف أو يتضمنه)\nمثال: معايير تصنيفية",
 "classified": "مُصَنَّف (مرتب في فئات) / سِرِّيّ, مَحْظُور (تصنيف رسمي للمعلومات أو الوثائق؛ محجوب عن التداول العام) / إِعْلَان مُبَوَّب (إعلان قصير في صحيفة أو مجلة (عادة بخط صغير) ويظهر مع إعلانات أخرى من نفس النوع)\nمثال: الآلاف من الوثائق السرية تم رفع السرية عنها الآن",
 "classified ad": "إِعْلَان مُبَوَّب (إعلان قصير في صحيفة أو مجلة (عادة بخط صغير) ويظهر مع إعلانات أخرى من نفس النوع)",
 "classified advertisement": "إِعْلَان مُبَوَّب (إعلان قصير في صحيفة أو مجلة (عادة بخط صغير) ويظهر مع إعلانات أخرى من نفس النوع)",
 "classified stock": "أسهم مصنفة",
 "classifier": "مُصَنِّف, مُصَنِّفَة",
 "classify": "صَنَّفَ, قَسَّمَ",
 "classifying adjective": "صفة تصنيفية, صفة نسبية (صفة تصنف اسمها (مثل 'مرض عصبي' أو 'آلة موسيقية'))",
 "classism": "طَبَقِيَّة, تَمَايُز طَبَقِيّ",
 "classless": "بِلَا طَبَقَات, مُسَاوَاتِيّ (يُؤَيِّدُ المُسَاوَاةَ الاجْتِمَاعِيَّة)",
 "classmate": "زَمِيل دِرَاسَة, رَفِيق صَفّ",
 "classroom": "صَفّ, غُرْفَة التَّدْرِيس (سَطْر مستقيم؛ مستوى تعليمي)\nمثال: صف كليتي وقلبي‎.",
 "classroom project": "مشروع مدرسي (مهمة مدرسية تتطلب جهداً كبيراً)",
 "classwork": "عمل صفي (جزء من عمل الطالب الذي يتم في الفصل الدراسي)",
 "classy": "أنيق, كشخه / ذو نوع راقي وعالي (أحد الأسماء الستة، لا يأتي إلا مُضَافًا، بمعنى صاحب)\nمثال: كان رجل ذو قامة طويله.",
 "clast": "حُتَاتَة, كُسَارة صخرية ((في الجيولوجيا) شظية مكونة لصخر فتاتي)",
 "clastic": "قَابِل لِلتَّفْكِيك (يمكن تفكيكه إلى أجزاء منفصلة) / فُتَاتِيّ, كَلَاسْتِيكِيّ (ينتمي إلى صخور مكوّنة من شظايا صخور أقدم)",
 "clastic rock": "صَخْر فُتَاتِيّ ((جيولوجيا) صخر يتكون من قطع مكسورة من صخور أقدم)",
 "clathrate": "شَبَكِيّ, مُشَبَّك (يتعلق بمركب يكون فيه أحد المكونات محاطاً فيزيائياً داخل البنية البلورية لمكون آخر) / مُخَرَّم, مُشَبَّك (ذو بنية شبكيّة مثقوبة بفتحات أو نوافذ)",
 "clatonia lanceolata": "جمال الربيع, كلايتونيا رمحية (نبات رفيع صغير له زوج واحد من الأوراق اللحمية في منتصف الساق وعنقود رخو من الزهور البيضاء أو الوردية أو الوردية على شكل وعاء وورم صالح للأكل)",
 "clatter": "قَعْقَعَ",
 "clattery": "خَشْخَاش, مُقَرْقِع (يُصْدِر صوت قرقعة كاصطدام أشياء صلبة ببعضها)",
 "claudication": "عرج (إعاقة في المشي بسبب عجز في الساقين أو القدمين)",
 "clausal": "جملي, عباري\nمثال: بنية الجملة",
 "clause": "جُمْلَة (مؤنث جُمْل، وهو الحبل الغليظ أو الجماعة من الناس؛ المَجْمُوع) / بَنْد\nمثال: يا لها من جملة!",
 "claustrophobe": "مُصاب بِرُهاب الأَماكِن المُغْلَقَة (شخص يعاني من الخوف من الأماكن المغلقة)",
 "claustrophobia": "رهاب الأماكن المغلقة (خوف مرضي من الاحتجاز في مكان ضيق)",
 "claustrophobic": "رُهَابِيّ الأَمَاكِن المُغْلَقَة (يعاني من رهاب الأماكن المغلقة) / خَانِقٌ لِلأَنْفَاسِ, ضَيِّق (مُغْلَقٌ أَوْ مَحْصُورٌ بِشَكْلٍ يُسَبِّبُ عَدَمَ الرَّاحَةِ)",
 "claustrum": "عائق (طبقة من المادة الرمادية في الدماغ مجاورة للنواة العدسية)",
 "claviceps purpurea": "إرغوت, دابرة (فطر يصيب نباتات الحبوب المختلفة مكوناً كتلاً سوداء مدمجة من خيوط متفرعة تحل محل العديد من حبوب النبات؛ مصدر لقلويدات مهمة طبياً ولحمض الليسرجيك)",
 "clavichord": "كلافيكورد (آلة وترية قديمة تشبه البيانو ولكن بصوت أكثر رقة)",
 "clavicipitaceae": "كلافيسيبتاسيا (أي من الفطريات المختلفة من طائفة الفطريات الزقية)",
 "clavicle": "تَرْقُوَة",
 "clavier": "كلافير (آلة وترية تحتوي على لوحة مفاتيح) / لوحة مفاتيح بيانو (مجموعة من المفاتيح على آلة موسيقية)",
 "clavus": "كلو, مسمار القدم (سماكة صلبة في الجلد (خاصة في الجزء العلوي أو جانبي أصابع القدم) ناتجة عن ضغط الأحذية غير المناسبة)",
 "claw": "مِخْلَب, بُرْثُن / كُلَّاب, كَلَّاب",
 "claw clip": "مشبك شعر مخلبي, ملقط شعر (نوع من مشابك الشعر بأسنان متشابكة متصلة بنبض (زنبرك))",
 "claw hammer": "مطرقة النجار, مطرقة بمخلب (مطرقة ذات شق في أحد طرفيها لسحب المسامير)",
 "claw hatchet": "بلطة ذات مخلب (فأس صغيرة لها شق لسحب المسامير)",
 "claw-shaped": "مِخْلَبِيّ الشَّكْل (على شكل مِخلب)",
 "clawback": "استرداد (ضريبي/مالي) (إيجاد طريقة لاستعادة الأموال من الناس التي تم إعطاؤها لهم بطريقة أخرى)\nمثال: ستجد الخزانة طريقة لاسترداد الفوائد الإضافية التي تلقاها الأعضاء",
 "clawed": "ذُو مَخَالِب ((عن الحيوانات المفترسة) مُزوَّد بمخالب أو براثن) / ذُو مَخَالِب (يَمْتَلِكُ أَوْ يُشْبِهُ المِخْلَبَ أَوِ المَخَالِب)",
 "clawfoot": "قدم مخلبية (تشوه في القدم يتميز بقوس مرتفع بشكل غير طبيعي وفرط تمدد أصابع القدم)",
 "clawhammer": "مطرقة النجار, مطرقة بمخلب (مطرقة ذات شق في أحد طرفيها لسحب المسامير)",
 "clawlike": "شَبِيهٌ بِالمِخْلَب (يُشْبِهُ المِخْلَبَ فِي شَكْلِه)",
 "claxon": "بوق, كلاكسون (نوع من الأبواق العالية كان يستخدم سابقاً في المركبات الآلية)",
 "clay": "طِين, صَلْصَال",
 "clay pigeon": "حمامة الطين, طبق الرماية (هدف يستخدم في رماية السكيت أو رماية الأطباق)",
 "clay pipe": "غليون فخاري (غليون مصنوع من الطين)",
 "clay sculpture": "قولبة, نحت طيني (نحت يتم إنتاجه بالقولبة)",
 "clay-colored robin": "سمنة طينية اللون (سمنة من المكسيك وأمريكا الوسطى)",
 "clayey": "صَلْصَالِيّ, طِينِيّ (يشبه أو يحتوي على الطين) / ثَقِيل, طِينِيّ ((يُقال عن التربة) متراصّ ودقيق الحبيبات)\nمثال: صخور طينية",
 "clayeyness": "طينية (جودة التكون من الطين) / شبه طيني (جودة التشبه بالطين، أي في الكثافة أو القوام)\nمثال: خلال فترات الرطوبة الزائدة، يجب تقييد الرعي في العديد من الأماكن بسبب طينية التربة السطحية",
 "clayiness": "طينية (جودة التكون من الطين) / شبه طيني (جودة التشبه بالطين، أي في الكثافة أو القوام)\nمثال: خلال فترات الرطوبة الزائدة، يجب تقييد الرعي في العديد من الأماكن بسبب طينية التربة السطحية",
 "clayishness": "طينية (جودة التكون من الطين) / شبه طيني (جودة التشبه بالطين، أي في الكثافة أو القوام)\nمثال: خلال فترات الرطوبة الزائدة، يجب تقييد الرعي في العديد من الأماكن بسبب طينية التربة السطحية",
 "claymore": "لغم كلايمور (لغم أرضي مضاد للأفراد يوجه انفجاره نحو العدو القادم) / كلايمور (سيف عريض كبير ذو حدين؛ كان يستخدمه سكان المرتفعات الاسكتلندية سابقاً)",
 "claymore mine": "لغم كلايمور (لغم أرضي مضاد للأفراد يوجه انفجاره نحو العدو القادم)",
 "claystone": "حجر طيني (صخر ناعم الحبيبات يتكون من جزيئات طينية مضغوطة)",
 "claytonia caroliniana": "جمال الربيع الكاروليني, كلايتونيا كارولينية (يشبه كلايتونيا فرجينيكا ولكن له زهور وردية عادة؛ شرق أمريكا الشمالية)",
 "claytonia virginica": "جمال الربيع الفرجيني, كلايتونيا فرجينية (نبات معمر ذو ورم صغير يزرع لوريدته المنخفضة من الأوراق اللحمية وعناقيد الزهور البيضاء المشوبة بالوردي؛ شرق أمريكا الشمالية)",
 "clayware": "خزف, فخار (أواني خزفية مصنوعة من الطين ومخبوزة في فرن)",
 "clean": "نَظِيف / نضيف / نَظَّفَ",
 "clean and jerk": "الخطف والنتر, كلين (رفعة أوزان يتم فيها رفع البار إلى ارتفاع الكتف ثم نتره فوق الرأس)",
 "clean bill of health": "شهادة خلو من الأمراض, شهادة سلامة (تأكيد بأن شخصاً ما بصحة جيدة أو أن شيئاً ما في حالة جيدة)\nمثال: أعطاه الطبيب شهادة خلو من الأمراض",
 "clean bomb": "قنبلة نظيفة (قنبلة ذرية تترك القليل من التلوث الإشعاعي أو لا تتركه)",
 "clean room": "غرفة معقمة, غرفة نظيفة (غرفة خالية تقريباً من الغبار أو البكتيريا؛ تستخدم في العمل المخبري وفي تجميع أو إصلاح المعدات الدقيقة)",
 "clean sheet": "شِباكٌ نَظِيفَةٌ",
 "clean slate": "بداية جديدة, صفحة بيضاء (فرصة للبدء من جديد دون أحكام مسبقة)",
 "clean-burning": "نَظِيف الاحْتِرَاق (يترك تلوثاً قليلاً أثناء استهلاك الوقود)",
 "clean-cut": "جَلِيّ, وَاضِح (وَاضِح وَمُتَمَيِّز لِلحَوَاسّ؛ سَهْل الإِدْرَاك) / أَنِيقُ المَظْهَر, مُهَذَّب (مُرَتَّبٌ وَأَنِيقٌ فِي المَظْهَر)",
 "clean-handed": "بريء, طاهر (خالٍ من الشر أو الذنب)\nمثال: طفل بريء",
 "clean-limbed": "مُتَنَاسِق الأَطْرَاف (ذو أطراف متناسبة وحسنة التكوين)",
 "clean-living": "طَاهِر, نَقِيّ (نَقِيٌّ أَخْلَاقِيًّا وَطَاهِرُ السِّيرَة)",
 "clean-shaven": "حَلِيق, نَاعِم الحِلَاقَة (محلوق حلاقة ناعمة حديثة)",
 "cleanable": "قَابِل لِلتَّنْظِيف (يمكن تنظيفه بسهولة)",
 "cleaner": "مُنَظِّف / مُنَظِّفَة",
 "cleaners": "محل تنظيف جاف, مصبغة (متجر يتم فيه التنظيف الجاف)",
 "cleaning": "تَنْظِيف",
 "cleaning cloth": "خرقة مسح, قماش تنظيف (قطعة قماش تستخدم في البيئة الصناعية لتنظيف الشحوم والزيوت وغيرها)",
 "cleaning device": "أداة تنظيف, معدات تنظيف (أي أداة من فئة كبيرة من الأدوات المستخدمة للتنظيف)",
 "cleaning equipment": "أداة تنظيف, معدات تنظيف (أي أداة من فئة كبيرة من الأدوات المستخدمة للتنظيف)",
 "cleaning implement": "أداة تنظيف, معدات تنظيف (أي أداة من فئة كبيرة من الأدوات المستخدمة للتنظيف)",
 "cleaning lady": "عاملة نظافة (أنثى بشرية موظفة للقيام بالأعمال المنزلية)\nمثال: ستنظف عاملة النظافة السجاد",
 "cleaning man": "عاملة نظافة, منظفة (أنثى بشرية تعمل في التنظيف المنزلي)",
 "cleaning pad": "إسفنجة تنظيف, وسادة تنظيف (وسادة تستخدم كأداة تنظيف)",
 "cleaning woman": "عاملة نظافة (أنثى بشرية موظفة للقيام بالأعمال المنزلية)\nمثال: ستنظف عاملة النظافة السجاد",
 "cleanliness": "نَظَافَة",
 "cleanly": "بِدِقَّة مُتَنَاهِيَة, بِلَا عَيْب (بسلاسة وبدون صعوبة؛ بدقة وبراعة) / بِنَظَافَة (بطريقة تقلل من الأوساخ والتلوث) / نَظِيف بِطَبْعِه (يتّسم بالنظافة عادةً وبشكل معتاد)\nمثال: هبط لاعب الجمباز بلا عيب",
 "cleanness": "نَظَافَة",
 "cleanser": "مادة تنظيف, منظف (مستحضر يستخدم في تنظيف شيء ما)",
 "cleansing": "تنظيف (فعل جعل الشيء نظيفاً) / مُطَهِّر, مُنَقٍّ (يعمل كمضادّ للعدوى؛ ذو أثر تطهيريّ) / تَطَهُّرِيّ, وُضُوئِيّ (يُنظّف الجسد بالغسل؛ خاصّة الغسل الطقوسيّ للأيدي)\nمثال: قام بتنظيف حذائه جيداً",
 "cleansing agent": "مادة تنظيف, منظف (مستحضر يستخدم في تنظيف شيء ما)",
 "cleansing milk": "حليب منظف (منظف للوجه يشبه في قوامه الحليب المكثف)",
 "cleanup": "تنظيف (فعل جعل الشيء نظيفاً) / الضارب الرابع ((بيسبول) المركز الرابع في ترتيب الضرب (يشغله عادة أفضل ضارب في الفريق)) / ربح طائل (ربح كبير جداً)\nمثال: قام بتنظيف حذائه جيداً",
 "cleanup position": "الضارب الرابع ((بيسبول) المركز الرابع في ترتيب الضرب (يشغله عادة أفضل ضارب في الفريق))",
 "cleanup spot": "الضارب الرابع ((بيسبول) المركز الرابع في ترتيب الضرب (يشغله عادة أفضل ضارب في الفريق))",
 "clear": "شَفَّاف / وَاضِح",
 "clear and present danger": "خطر واضح وحاضر (معيار للحكم متى يمكن تقييد حرية التعبير)\nمثال: لا يحق لأحد أن يصرخ 'حريق' في مسرح مزدحم عندما لا يكون هناك حريق لأن مثل هذا التصرف سيشكل خطراً واضحاً وحاضراً على السلامة العامة",
 "clear liquid diet": "حمية السوائل الصافية (نظام غذائي يتكون من سوائل ذات بقايا قليلة جداً (مثل المرق الخالي من الدهون أو عصائر الفاكهة المصفاة أو الجيلاتين)؛ لا يمكن استخدامه لأكثر من يوم واحد…)",
 "clear one's throat": "تَنَحْنَحَ",
 "clear sailing": "تقدم سهل, طريق ممهد (تقدم سهل غير معاق)\nمثال: بعد أن قمنا بحل تلك المشكلة، كان الباقي سهلاً وممهداً",
 "clear-air turbulence": "اضطراب الهواء الصافي, مطب هوائي (اضطراب قوي في منطقة خالية من السحب يعرض الطائرات لتيارات صاعدة أو هابطة عنيفة)",
 "clear-cut": "بَيِّن, حَاسِم (محدّد بوضوح وحدّة في الذهن) / جَلِيّ, وَاضِح (وَاضِح وَمُتَمَيِّز لِلحَوَاسّ؛ سَهْل الإِدْرَاك) / مَقْطُوع الأَشْجَار كُلِّيًّا (أُزيلت جميع أشجاره دفعة واحدة)",
 "clear-eyed": "بَصِير, حَادّ البَصِيرَة (ذُو فِطْنَة ذِهْنِيَّة حَادَّة أَوْ إِدْرَاك نَافِذ)",
 "clear-sighted": "بَصِير, حَادّ البَصِيرَة (ذُو فِطْنَة ذِهْنِيَّة حَادَّة أَوْ إِدْرَاك نَافِذ) / صَافِي البَصَر (ذو رؤية حادّة وواضحة)",
 "clear-thinking": "صَافِي الذِّهْن, وَاضِح التَّفْكِير (غير مشوش عقلياً؛ قادر على التفكير بوضوح والتصرف بذكاء)",
 "clearance": "إذن, تصريح (إذن بالمضي قدماً) / خُلُوص, مَسَافَة فَاصِلَة (المسافة التي يتجاوز بها شيء شيئاً آخر؛ الحيز بينهما) / اِرْتِفَاع خَالِص, مِسَاحَة عُلْوِيَّة (المساحة الرأسية المتاحة للسماح بالمرور السهل تحت شيء ما)\nمثال: أعطيت الطائرة تصريحاً بالهبوط",
 "clearance sale": "بيع تصفية, تصفية (بيع لتقليل المخزون)",
 "clearcutness": "دِقَّة, وُضُوح قَاطِع (الوضوح كنتيجة للدقة)",
 "cleared": "خالٍ, مُزال العوائق (تم تخليصه من الأشياء أو العوائق مثل الأشجار والشجيرات) / مُبَرَّأ, مُعْفًى (أُعفي من أي شبهة ذنب)\nمثال: أرض مُطهرة (من الأشجار)",
 "clearheaded": "صَافِي الذِّهْن, وَاضِح التَّفْكِير (غير مشوش عقلياً؛ قادر على التفكير بوضوح والتصرف بذكاء)",
 "clearing": "ترويق, تصفية (فعل إزالة الجزيئات الصلبة من سائل) / تبرئة (فعل التحرير من الشكوك) / فُرْجَة, فُسْحَة (قطعة أرض بها عدد قليل من الأشجار أو خالية منها تقع وسط منطقة حرجية)",
 "clearing house": "غرفة المقاصة (مكان مركزي للتجميع حيث تتبادل البنوك الشيكات أو الحوالات؛ ويحتفظ المشاركون بحساب يتم فيه تسجيل الدائن والمدين)",
 "clearly": "بوضوح (بدون شك أو تساؤل) / بشكل متميز, بوضوح (واضح للعقل؛ بتمييز عقلي واضح) / بشكل مفهوم, بوضوح (بطريقة يمكن فهمها) / بِوُضُوح (بطريقة يسهل إدراكها)\nمثال: كانوا تائهين بوضوح",
 "clearness": "صَفَاء, نَقَاء (صفة الماء الصافي) / جَلَاء, صَفَاء (الخلو من الغموض وسهولة الفهم؛ قابلية التعبير الواضح للفهم)\nمثال: عندما استيقظت عاد الصفاء إلى عينيها",
 "clearstory": "كوة علوية, نافذة علوية (جزء من جدار داخلي يرتفع فوق السقف المجاور بنوافذ تسمح بدخول الضوء)",
 "clearway": "طريق حر (طريق لا يُسمح لك بالتوقف فيه (إلا إذا تعطلت سيارتك))",
 "clearweed": "عشبة غنية, قراص ميت (نباتات من جنس بيليا ذات عناقيد زهرية خضراء متدلية وسيقان وأوراق شفافة ملساء)",
 "cleat": "شريحة تثبيت, مربط (شريط من الخشب أو المعدن يستخدم لتقوية السطح المتصل به) / مربط, وتد ربط (أداة تثبيت (عادةً بقرنين بارزين) يمكن تثبيت الحبل حولها) / مرابط, نتوء مانع للانزلاق (نتوء معدني أو جلدي (كما في نعل الحذاء) يمنع الانزلاق)",
 "cleats": "حذاء رياضي مُسَمَّر (أحذية ذات نتوءات جلدية أو معدنية في النعل)\nمثال: كان جميع لاعبي كرة القدم يرتدون أحذية مُسَمَّرة",
 "cleavable": "قَابِل لِلشَّقّ (يُمْكِن شَقُّه أَوْ فَلْقُه)",
 "cleavage": "شطر, فلق (عملية الفلق أو الشق) / شق الصدر, فلق الصدر (الخط المتشكل من أخدود بين جزأين (خاصة الفاصل بين ثديي المرأة)) / تفلج, تقطع ((علم الأجنة) الانقسام المتكرر للبويضة المخصبة) / انشطار, انقسام (كسر رابطة كيميائية في جزيء مما يؤدي إلى جزيئات أصغر)",
 "cleavage cavity": "تجويف الأريمة (التجويف المملوء بالسائل داخل الأريمة)",
 "cleave": "شَقَّ, فَسَخَ ((شَقَّ) الفَرَسُ ونحوُهُ يَشِقَّ شَقَقًا: مال في جَرْيِهِ إِلى جانب؛ فهو أشَقُّ، وهي شَقَّاءُ)\nمثال: اكشف عن الشق العلوي من الجسم.",
 "cleaver": "سَاطُور",
 "cleavers": "جويسئة خشنة, عشب الإوز (نبات حولي له ساق مغطى بأشواك منحنية؛ أمريكا الشمالية وأوروبا وآسيا)",
 "clef": "مِفْتَاح مُوسِيقِيّ (مفتاح)\nمثال: بحث عن المفتاح.",
 "cleft": "شَقّ, شَرْم ((شَقَّ) الفَرَسُ ونحوُهُ يَشِقَّ شَقَقًا: مال في جَرْيِهِ إِلى جانب؛ فهو أشَقُّ، وهي شَقَّاءُ)\nمثال: اكشف عن الشق العلوي من الجسم.",
 "cleft chin": "طَابَع اَلْحُسْن",
 "cleft foot": "قدم مشقوقة (تشوه يمتد فيه الفراغ بين إصبعي القدم الثالث والرابع إلى داخل القدم)",
 "cleft lip": "شفة أرنبية, شفة مشقوقة (شق خلقي في منتصف الشفة العليا)",
 "cleft palate": "حنك مشقوق (شق خلقي في الحنك الصلب)",
 "cleg": "ذباب الخيل (ذباب كبير سريع تمتص إناثه دماء حيوانات مختلفة)",
 "clegg": "ذباب الخيل (ذباب كبير سريع تمتص إناثه دماء حيوانات مختلفة)",
 "cleistes divaricata": "أوركيد برعم الورد قمعي العرف, بوجونيا منتشرة (أوركيد في شمال شرق الولايات المتحدة بزهور وردية أرجوانية ذات شفة قمعية الشكل؛ يوضع أحياناً في جنس بوجونيا)",
 "cleistes rosea": "أوركيد برعم الورد (أوركيد في وسط وشمال أمريكا الجنوبية ذو عناقيد من 1 إلى 3 زهرات وردية كبيرة مبهرجة؛ يوضع أحياناً في جنس بوجونيا)",
 "cleistocarp": "ثمرة مغلقة (بنية مغلقة حاملة للأبواغ لبعض الفطريات (خاصة الرشاشيات والبياض الدقيقي) التي تخرج منها الأبواغ فقط عن طريق التحلل أو التفكك)",
 "cleistogamic": "إخصابي مغلق, زواجي مغلق (يظهر أو يتعلق بالإخصاب المغلق (التلقيح الذاتي في زهرة لا تتفتح))",
 "cleistogamous": "إخصابي مغلق, زواجي مغلق (يظهر أو يتعلق بالإخصاب المغلق (التلقيح الذاتي في زهرة لا تتفتح))",
 "cleistogamy": "إخصاب مغلق, تلقيح مغلق (إنتاج زهور صغيرة غير متفتحة ذاتية التلقيح)",
 "cleistothecium": "ثمرة مغلقة (بنية مغلقة حاملة للأبواغ لبعض الفطريات (خاصة الرشاشيات والبياض الدقيقي) التي تخرج منها الأبواغ فقط عن طريق التحلل أو التفكك)",
 "clematis": "ظَيَّان",
 "clematis baldwinii": "صفير الصنوبر (ياسمين بري منتصب من فلوريدا ذو أزهار وردية إلى أرجوانية)",
 "clematis crispa": "ياسمين أزرق, ياسمين بري مجعد (نبات متسلق من جنوب الولايات المتحدة ذو أزهار أرجوانية مائلة للزرقة)",
 "clematis lasiantha": "ياسمين بري أنبوبي الساق (ياسمين بري من كاليفورنيا)",
 "clematis ochreleuca": "رؤوس مجعدة (ياسمين بري شجيري من شرق الولايات المتحدة ذو أوراق مجعدة)",
 "clematis tangutica": "ياسمين بري ذهبي (ياسمين بري صيني ذو أوراق مسننة وأزهار صفراء كبيرة)",
 "clematis texensis": "ياسمين بري قرمزي (كرمة خشبية من تكساس ذات أزهار قرمزية مفردة متدلية مبهرجة)",
 "clematis versicolor": "زهرة الجلود (كرمة خشبية من جنوب الولايات المتحدة ذات أزهار أرجوانية أو زرقاء بسبلات جلدية منحنية للخلف)",
 "clematis verticillaris": "ياسمين بري أرجواني, ياسمين بري جبلي (نبات متسلق من شمال شرق أمريكا الشمالية ذو أزهار أرجوانية زرقاء شمعية)",
 "clematis viorna": "زهرة الجلود, كرمة المزهرية (شجيرة متسلقة من جنوب شرق الولايات المتحدة ذات أزهار كبيرة حمراء أرجوانية على شكل جرس بسبلات جلدية منحنية للخلف)",
 "clematis virginiana": "لحية العجوز, ياسمين بري فرجيني (نبات متسلق شائع في شرق أمريكا الشمالية يمتد فوق النباتات الأخرى ويحمل عناقيد عديدة من الزهور البيضاء الكريمية الصغيرة)",
 "clematis vitalba": "فرحة المسافر, لحية العجوز (نبات متسلق نفضي قوي من أوروبا إلى أفغانستان ولبنان ذو عناقيد من الزهور البيضاء المخضرة العطرة في الصيف والخريف)",
 "clemency": "رأفة, رحمة (التساهل والرحمة التي يظهرها تجاه المخالفين شخص أو وكالة مكلفة بإقامة العدل) / اعتدال (طقس جيد مع درجات حرارة مريحة)",
 "clement": "إِكْلِمِنْدِس",
 "clementine": "كَلِيمُونْتِين",
 "clementine tree": "كليمنتين (صنف من برتقال المندرين يزرع حول البحر الأبيض المتوسط وفي جنوب أفريقيا)",
 "clench": "إمساك, قبضة (فعل الإمساك) / عقدة تثبيت (أنشوطة صغيرة مصنوعة بالربط)\nمثال: أرخى قبضته عن ذراعي",
 "clench one's fists": "شَدَّ قَبْضَتَيْهِ",
 "clenched": "مَضْمُوم, مُنْقَبِض (مُغْلَق أَوْ مَضْغوط بِإِحْكام)",
 "clenched fist": "قبضة (يد مضمومة الأصابع في راحة اليد (كما في حالة الضرب))",
 "cleome": "زهرة العنكبوت, كليومي (أي من النباتات المتنوعة غالباً قوية الرائحة من جنس الكليومي ذات أزهار مبهرجة تشبه العنكبوت)",
 "cleome hassleriana": "زهرة العنكبوت (موطنها أمريكا الجنوبية ولكنها متوطنة في الأجزاء الدافئة من الولايات المتحدة؛ تزرع لأزهارها طويلة الأمد التي تشبه العنكبوت بيضاء إلى وردية أرجوانية)",
 "cleome pinnata": "ريشة الأمير, ستانليا (نبات معمر من جنوب غرب الولايات المتحدة له أوراق ريشية جلدية زرقاء خضراء وسنابل سميكة تشبه الريش من الزهور الصفراء؛ يوضع أحياناً في جنس كليوم)",
 "cleome serrulata": "نبات النحل, نفل نتن (نبات من غرب أمريكا الشمالية ذو أوراق ثلاثية وأزهار بيضاء أو وردية تشبه العنكبوت؛ يستخدم أحياناً كنبات زينة)",
 "cleopatra": "كْلِيوْبَاتْرَا",
 "clepsydra": "ساعة مائية, كليبسيدرا (ساعة تقيس الوقت عن طريق تدفق الماء)",
 "clerestory": "كوة علوية, نافذة علوية (جزء من جدار داخلي يرتفع فوق السقف المجاور بنوافذ تسمح بدخول الضوء)",
 "clergy": "إكْلِيرُوس",
 "clergyman": "قِسِّيس, كَاهِن (الذي يُقَسِّس الإبل أو الماشية أو الغنم، أي يحسن رعايتها، الراعي؛ عند المَسِيْحِيِّيْن هو لقب فوق الشَمَّاس ودون الأُسْقُف وهو القَسّ)",
 "clergywoman": "امرأة دين (عضو أنثى في سلك الكهنوت وقائدة روحية للكنيسة المسيحية)",
 "cleric": "قِسِّيس, كَاهِن (الذي يُقَسِّس الإبل أو الماشية أو الغنم، أي يحسن رعايتها، الراعي؛ عند المَسِيْحِيِّيْن هو لقب فوق الشَمَّاس ودون الأُسْقُف وهو القَسّ)",
 "clerical": "إِدَارِيّ, مَكْتَبِيّ (مناسب للعمل المكتبيّ أو منخرط فيه) / إكليريكي, كهنوتي (من أو متعلق برجال الدين) / إداري, كتابي (من أو متعلق بالكتبة أو الموظفين الإداريين)\nمثال: طوق كهنوتي",
 "clerical collar": "ياقة القسيس, ياقة رومانية (ياقة بيضاء صلبة بدون فتحة في الأمام؛ رمز مميز لرجال الدين)",
 "clericalism": "إكليروسية, نفوذ رجال الدين (سياسة دعم نفوذ وسلطة رجال الدين في الشؤون العلمانية أو السياسية)",
 "clericalist": "إِكْلِيرُوسِيّ (من يدعو إلى الإكليروسية (تدخل رجال الدين في السياسة))",
 "clericalization": "تكليركية, هيمنة رجال الدين (عملية زيادة قوة أو نفوذ التسلسل الهرمي الديني)",
 "clerid": "خنفساء كليريد (مفترسة للحشرات الأخرى؛ عادة ما تكون زاهية الألوان أو معدنية)",
 "clerid beetle": "خنفساء كليريد (مفترسة للحشرات الأخرى؛ عادة ما تكون زاهية الألوان أو معدنية)",
 "clerihew": "كليريهو (شعر هجائي ذكي يحتوي على بيتين مقفيين ويذكر شخصاً مشهوراً)",
 "clerisy": "إنتلجنسيا, الطبقة المثقفة (نخبة متعلمة ومثقفة)",
 "clerk": "مُوَظَّف / مُوَظَّفَة",
 "clerking": "مسك الدفاتر (نشاط تسجيل المعاملات التجارية)",
 "clerkship": "عمل الكاتب, وظيفة كتابية (وظيفة الكاتب أو الموظف الكتابي)",
 "clethra": "لَثَاة, لِثَة",
 "clethra alnifolia": "ألدر أبيض, شجيرة الفلفل الحلوة (شجيرة من شرق وجنوب الولايات المتحدة الساحلية ذات عناقيد جميلة من الزهور البيضاء المعطرة برائحة التوابل)",
 "cleveland": "كليفلاند",
 "clever": "ذَكِيّ (ذَكِيَ: صار شديد الفطنة وسريع البديهة؛ ذكِيَ التلميذ في مهارات الحساب الدهني)\nمثال: إنه وسيم و ذكي.",
 "clever clogs": "متحذلق, مدع للمعرفة (مثقف يتباهى بمعرفته بشكل مزعج ومثير للضيق)",
 "clever dick": "متحذلق, مدع للمعرفة (مثقف يتباهى بمعرفته بشكل مزعج ومثير للضيق)",
 "cleverly": "ببراعة, بذكاء (بطريقة ذكية)\nمثال: كانت مرتبة بذكاء",
 "cleverness": "براعة, ذكاء (خاصية كون الشخص بارعاً) / ذكاء, شطارة (الذكاء الذي يظهر في سرعة البديهة والفطنة) / إبداع, عبقرية (قوة الخيال الإبداعي)\nمثال: حبكة ذات براعة كبيرة",
 "clevis": "قرط, مربط",
 "clew": "خيط دليل, قرينة (دليل يساعد على حل مشكلة) / كبة, كرة خيط (كرة من الغزل أو الحبل أو الخيط)",
 "clews": "حبال الأرجوحة الشبكية (الحبال المستخدمة لتعليق الأرجوحة الشبكية)",
 "cli": "واجهة سطر الأوامر (واجهة مستخدم تقوم فيها بكتابة الأوامر بدلاً من اختيارها من قائمة أو اختيار أيقونة)",
 "clianthus": "بازلاء المجد, كليانثوس (أي من الشجيرات أو الكروم المختلفة من جنس كليانثوس ذات أوراق مركبة وأزهار حمراء تشبه البازلاء في عناقيد متدلية)",
 "clianthus formosus": "بازلاء الصحراء, بازلاء ستورت (نبات معمر شجيري مترامي الأطراف يشتهر بزهوره القرمزية المعلمة بالأسود؛ واسع الانتشار في الأجزاء الجافة من أستراليا)",
 "clianthus puniceus": "كليانثوس, منقار الببغاء (شجيرة دائمة الخضرة بزهور قرمزية إلى بيضاء تشبه المخلب أو المنقار؛ نيوزيلندا)",
 "clianthus speciosus": "بازلاء الصحراء, بازلاء ستورت (نبات معمر شجيري مترامي الأطراف يشتهر بزهوره القرمزية المعلمة بالأسود؛ واسع الانتشار في الأجزاء الجافة من أستراليا)",
 "cliche": "عبارة مبتذلة, قول مأثور مبتذل (ملاحظة مبتذلة أو واضحة بشكل مفرط)",
 "cliched": "جَاهِز, نَمَطِيّ (يتكرر بانتظام دون تفكير أو أصالة)",
 "cliché": "عِبَارَةٌ مُتَدَاوَلَة, كْلِيشِيه (الجملة من الكلام تعبّر عن شيء ما أو تعبّر عمّا في النفس من معان؛ للكلام: المعنى عامة أو المساواة في الدلالة)\nمثال: ستترجم هذه العبارة.",
 "click": "نَقْرَة / نَقَرَ",
 "click beetle": "خنفساء مطقطقة (قادرة على تعديل وضعها عندما تكون على ظهرها عن طريق القفز في الهواء مع صوت طقطقة)",
 "click-clack": "طقطقة (سلسلة من النقرات)",
 "clickety-clack": "طقطقة إيقاعية (طقطقة سريعة وإيقاعية)\nمثال: طقطقة الآلات الكاتبة",
 "clickety-click": "طقطقة إيقاعية (طقطقة سريعة وإيقاعية)\nمثال: طقطقة الآلات الكاتبة",
 "client": "زَبُون, مُشْتَرٍ / عَمِيل (من تُعَامِله ويعاملك في التِجَارَة؛ وكيل التَاجِر في الجِهَات)\nمثال: سامي عميل فدرالي.",
 "client program": "برنامج عميل (أي برنامج يعمل على حاسوب محلي للمستخدم ويصل إلى البيانات المخزنة على حاسوب بعيد)\nمثال: متصفح الويب الخاص بك هو برنامج عميل طلب خدمة من خادم",
 "client-centered therapy": "علاج متمركز حول العميل (طريقة للعلاج النفسي طورها كارل روجرز يحدد فيها العميل تركيز ووتيرة كل جلسة)",
 "client-server": "عميل-خادم (متعلق بنظام حاسوبي يدعم فيه خادم مركزي عدداً من محطات العمل المتصلة بالشبكة)",
 "clientage": "تَبَعِيَّة, وَلَاء (علاقة العميل بالراعي أو المتبوع)",
 "clientele": "زبائن, عملاء (الزبائن بشكل جماعي)\nمثال: لديهم زبائن من الطبقة العليا",
 "cliff": "جُرْف (أخذ شيئًا وجرفه بعيدًا، أو سحب شيئًا بقوة؛ في : في بعض الحالات، قد تستخدم للإشارة إلى إزالة أو جرف شيء نحو مكان آخر)\nمثال: وقف على حافة الجرف.",
 "cliff brake": "سرخس الجرف, سرخس الصخر (أي من عدة سراخس صغيرة تعيش على الصخور في المناطق الاستوائية والمعتدلة الدافئة)",
 "cliff diving": "غطس من المرتفعات (الغطس في الماء من جرف شديد الانحدار)",
 "cliff dweller": "ساكن الكهوف, ساكن المنحدرات (فرد من شعب أناسازي يعيش في جنوب غرب الولايات المتحدة، بنى مساكن صخرية أو طينية على حواف في جوانب الكهوف)",
 "cliff dwelling": "مسكن منحدرات (مسكن من الصخور واللبن مبني على حواف محمية في جوانب الجرف)\nمثال: بنى شعب أناسازي مساكن المنحدرات في جنوب غرب الولايات المتحدة",
 "cliff penstemon": "بنستيمون صخري (واحدة من أجمل الأزهار البرية في الغرب؛ أزهار كبيرة زاهية وردية أو زهرية في العديد من العثاكيل فوق حصائر سميكة من السيقان والأوراق؛ الحواف والمنحدرات…)",
 "cliff rose": "قرنفل البحر, ورد الجرف (نبات معنقد في السواحل والجبال في المنطقة المعتدلة الشمالية؛ يزرع أحياناً كغطاء أرضي)",
 "cliff swallow": "سنونو الجرف (سنونو من أمريكا الشمالية يعيش في مستعمرات ويبني أعشاشاً طينية على شكل زجاجة على المنحدرات والجدران)",
 "cliff-brake": "سرخس الجرف, سرخس الصخر (أي من عدة سراخس صغيرة تعيش على الصخور في المناطق الاستوائية والمعتدلة الدافئة)",
 "cliff-hanging": "مُثِير, مُشَوِّق ((لِلمَوَاقِفِ) يَتَّسِمُ بِالتَّشْوِيقِ أَوْ يُسَبِّبُهُ)",
 "cliffhanger": "نِهَايَة مُشَوِّقَة, تَشْوِيق",
 "clifford trust": "ائتمان المانح, ائتمان كليفورد (ائتمان يتم إنشاؤه لتحويل الدخل إلى شخص يخضع لضريبة بمعدل أقل من المانح لمدة 10 سنوات أو أكثر)",
 "cliftonia monophylla": "تيتي, شجرة الحنطة السوداء (شجرة في المناطق الساحلية المنخفضة بجنوب شرق الولايات المتحدة ذات أوراق لامعة وعناقيد من الزهور البيضاء العطرة)",
 "climacteric": "انقطاع الطمث, سن اليأس (الوقت في حياة المرأة الذي تنتهي فيه الدورة الشهرية) / إياس, سن اليأس للرجال (فترة في حياة الرجل تقابل سن اليأس)",
 "climactic": "حاسم, ذروي (يتكون من أو يسبب ذروة (كليماكس))\nمثال: تطور حاسم",
 "climate": "مَنَاخ, مُنَاخ (الموضع الذي تُناخ فيه الإبل؛ مبرك الإبل)\nمثال: أشجار الكرز تحتاج لمناخ بارد.",
 "climate change": "تَغَيُّر مَنَاخِيّ (صَارَ غير ما كان) / تَغَيُّر المَنَاخ (صَارَ غير ما كان)\nمثال: هل تغير أي شيء؟",
 "climate denier": "نَاكِر التَّغَيُّر الْمَنَاخِيّ",
 "climate finance": "تمويل المناخ",
 "climatic": "مُنَاخِيّ",
 "climatic zone": "منطقة مناخية (أي من المناطق الجغرافية المقسمة بشكل فضفاض وفقاً للمناخ السائد وخط العرض)",
 "climatical": "مناخي (من أو متعلق بالمناخ)\nمثال: تغيرات مناخية",
 "climatically": "مُنَاخِيًّا (فيما يتعلق بالمناخ)\nمثال: اعتادوا على بيئة مختلفة مناخياً",
 "climatologist": "عالم مناخ (خبير في علم المناخ)",
 "climatology": "عِلْم اَلْمُنَاخ (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "climax": "ذروة جنسية, رعشة الجماع (لحظة أقصى متعة أثناء الاتصال الجنسي) / تتويج, ذروة (اللحظة الحاسمة في رواية أو مسرحية) / تصاعد, ذروة (ترتيب الجمل بترتيب تصاعدي من حيث القوة) / ذروة, قمة (أعلى نقطة لأي شيء يتصور أنه ينمو أو يتطور أو يتكشف)\nمثال: مشهد فراش الموت هو ذروة المسرحية",
 "climb": "تَسَلَّقَ / شَعْبَطَة",
 "climb-down": "انسحاب, تراجع (التراجع عن موقف تم تبنيه سابقاً)",
 "climbable": "قَابِلٌ لِلتَّسَلُّق (يمكن تسلّقه أو صعوده)",
 "climber": "كرامبون, نصل تسلق (مسمار حديدي يركب في الحذاء لمنع الانزلاق على الجليد عند المشي أو التسلق) / متسلق (شخص يمارس التسلق كرياضة؛ وخاصة متسلق الجبال) / متسلق (شخص يصعد سيراً على الأقدام) / متسلق اجتماعي (شخص يسعى للوجاهة الاجتماعية من خلال التملق)\nمثال: بدا المتسلق القائد قوياً ولكن شريكه كان يترنح غالباً في حباله",
 "climbing": "تسلق, تصاعد (حدث ينطوي على الارتفاع إلى نقطة أعلى (كما في الارتفاع أو درجة الحرارة أو الشدة، وما إلى ذلك))",
 "climbing belt": "حزام تسلق (حزام مصنوع من الحبال، وأحياناً بمقعد، يستخدم في تربية النحل البري لتسلق الأشجار والوصول إلى الأعشاش)",
 "climbing bird's nest fern": "سرخس عش الطير المتسلق (إفريقيا الاستوائية إلى أسترالاسيا وبولينيزيا)",
 "climbing bittersweet": "حلوة مرة أمريكية, سيلاستروس (شجيرة ملتفة في أمريكا الشمالية لها كبسولات صفراء تحيط ببذور قرمزية)",
 "climbing boneset": "قنب متسلق, ميكانيا متسلقة (عشب من أمريكا الاستوائية له أزهار برائحة الفانيليا؛ يتسلق الأشجار)",
 "climbing corydalis": "كورداليس متسلق (نبات متسلق حولي بأوراق مركبة وعناقيد من الزهور الصفراء والوردية)",
 "climbing equipment": "معدات التسلق, معدات تسلق الصخور (معدات رياضية تستخدم أثناء تسلق الصخور أو أي نوع آخر من التسلق)\nمثال: كيس السحب يشير إلى حقيبة كبيرة وقوية وغالباً ما تكون غير عملية يلقى فيها الإمدادات ومعدات التسلق",
 "climbing fern": "سرخس متسلق, ليغوديوم (أي من السراخس المتعددة من جنس ليغوديوم التي تتسلق بالالتفاف)",
 "climbing frame": "إطار التسلق (هيكل من القضبان أو جذوع الأشجار ليتسلق عليها الأطفال)",
 "climbing fumitory": "أدلوميا, شاهترج متسلق (نبات متسلق بأوراق ريشية وأزهار بيضاء أو وردية؛ يوضع أحياناً في جنس الشاهترج)",
 "climbing helmet": "خوذة تسلق (قطعة من معدات السلامة تحمي جمجمة المتسلق بشكل أساسي من الحطام المتساقط (مثل الصخور أو قطع الحماية الساقطة) وقوى الاصطدام أثناء السقوط)\nمثال: قد يقرر المتسلقون ارتداء خوذة تسلق بناءً على عدد من العوامل مثل نوع التسلق الذي يتم محاولته",
 "climbing hemp-vine": "قنب متسلق, ميكانيا متسلقة (عشب من أمريكا الاستوائية له أزهار برائحة الفانيليا؛ يتسلق الأشجار)",
 "climbing hempweed": "قنب متسلق, ميكانيا متسلقة (عشب من أمريكا الاستوائية له أزهار برائحة الفانيليا؛ يتسلق الأشجار)",
 "climbing hydrangea": "كوبية شاذة, هيدرانجيا متسلقة (نبات متسلق متساقط الأوراق بجذور هوائية وزهور بيضاء إلى كريمية في رؤوس مسطحة إلى حد ما) / كوبية معنقة, هيدرانجيا متسلقة (نبات متسلق متساقط الأوراق بجذور هوائية ورؤوس زهور مسطحة كبيرة) / شيزوفراجما, كوبية متسلقة (شجيرة متسلقة بجذور هوائية لاصقة لها أوراق متقابلة وزهور بيضاء صغيرة في سيمات طرفية؛ من الهيمالايا إلى تايوان واليابان)",
 "climbing iron": "كرامبون, نصل تسلق (مسمار حديدي يركب في الحذاء لمنع الانزلاق على الجليد عند المشي أو التسلق) / حديدة تسلق (إطار فولاذي مدبب يربط بالحذاء للمساعدة في تسلق الأشجار أو الأعمدة)",
 "climbing lily": "جوريوسا, زنبق المجد (أي نبات من جنس جوريوسا في أفريقيا الاستوائية وآسيا؛ عشب معمر يتسلق بواسطة محالق عند أطراف الأوراق وله أزهار مبهرجة صفراء إلى حمراء أو أرجوانية؛ جميع…)",
 "climbing maidenhair": "سرخس الثعبان, كزبرة البئر المتسلقة (سرخس استوائي واسع الانتشار في العالم القديم؛ متوطن في جامايكا وفلوريدا)",
 "climbing maidenhair fern": "سرخس الثعبان, كزبرة البئر المتسلقة (سرخس استوائي واسع الانتشار في العالم القديم؛ متوطن في جامايكا وفلوريدا)",
 "climbing nightshade": "عنب الديب, مغد حلو ومر (كرمة معمرة سامة من العالم القديم لها زهور بنفسجية وتوت أحمر مرجاني بيضاوي؛ عشب ضار واسع الانتشار في أمريكا الشمالية)",
 "climbing onion": "بصل متسلق (عشب ملتف عديم الأوراق كثير التفرع من جنوب أفريقيا يزرع للزينة لسيقانه الخضراء الزاهية التي تنمو من أبصال كبيرة فوق الأرض)",
 "climbing perch": "فرخ متسلق (فرخ صغير من الهند تحورت خياشيمه لتسمح له بتنفس الهواء؛ وله زعانف صدرية شوكية تمكنه من التنقل على الأرض)",
 "climbing salamander": "سمندل متسلق (أي من عدة سمندلات أمريكية شمالية متكيفة للتسلق بأطراف متطورة وأصابع طويلة مربعة الشكل نوعاً ما)",
 "clime": "مناخ (الطقس في موقع ما كمتوسط على مدى فترة طويلة من الزمن)\nمثال: المناخ الرطب في جنوب ويلز",
 "clinch": "التحام ((ملاكمة) فعل أحد الملاكمين بالإمساك بالآخر لتجنب التعرض للضرب وللراحة لحظياً) / حضن, عناق (عناق قوي أو عاطفي) / مشبك, ملزمة (جهاز (يستخدمه النجارون عادة) يثبت الأشياء معاً بإحكام) / برشمة, طرف المسمار المثني (الجزء المسطح من مسمار أو برغي أو برشام)\nمثال: تعال هنا وأعطني حضنًا كبيرًا",
 "clinched": "مَضْمُوم, مُنْقَبِض (مُغْلَق أَوْ مَضْغوط بِإِحْكام)",
 "clincher": "أداة برشمة, مُثبِّت (أداة تستخدم لثني (برشمة) المسامير أو البراغي أو المسامير البرشامية لتثبيتها) / عامل حاسم, قول فصل (نقطة أو حقيقة أو ملاحظة تحسم أمراً ما بشكل نهائي) / حجة حاسمة, عامل حاسم (حجة تكون قاطعة وفاصلة)",
 "clincher-built": "مُتَرَاكِب الأَلْوَاح (لديه ألواح هيكل متداخلة)",
 "cling": "تَمَسَّكَ",
 "cling film": "غلاف لاصق, نايلون تغليف (فيلم بلاستيكي رقيق مصنوع من ساران (الاسم التجاري ساران راب) يلتصق بنفسه؛ يستخدم لتغليف الطعام)",
 "clingfilm": "غلاف لاصق, نايلون تغليف (فيلم بلاستيكي رقيق مصنوع من ساران (الاسم التجاري ساران راب) يلتصق بنفسه؛ يستخدم لتغليف الطعام)",
 "clingfish": "سمكة لاصقة (سمكة بحرية مسطحة صغيرة جداً (تصل إلى 3 بوصات) مع قرص ماص على البطن للتشبث بالصخور وما إلى ذلك)",
 "clingstone": "ثمرة ملتصقة النواة (الفاكهة (وخاصة الخوخ) التي يلتصق لحمها بقوة بالنواة)",
 "clingy": "مُتَشَبِّث, مُتَعَلِّق (مُفْرِطٌ فِي التَّعَلُّقِ العَاطِفِيِّ)",
 "clinic": "عِيَادَة, مَصَحَّة",
 "clinical": "بَارِد الأَعْصَاب, سَرِيرِيّ (منفصل علمياً وخالٍ من العاطفة) / إكلينيكي, سريري (متعلق بالعيادة أو يتم كما لو كان في عيادة ويعتمد على المراقبة المباشرة للمرضى)\nمثال: مراقبة سريرية",
 "clinical anatomy": "تشريح سريري (التطبيق العملي للمعرفة التشريحية للتشخيص والعلاج)",
 "clinical death": "موت سريري (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي)\nمثال: لا اخاف الموت .",
 "clinical depression": "اضطراب اكتئابي, اكتئاب سريري (حالة من الاكتئاب وانعدام التلذذ شديدة لدرجة تتطلب تدخلاً سريرياً)",
 "clinical neurology": "طب الأعصاب السريري (فرع الطب الذي يتعامل مع الجهاز العصبي واضطراباته)",
 "clinical psychologist": "معالج نفسي (معالج يتعامل مع الاضطرابات العقلية والعاطفية)",
 "clinical psychology": "عِلْم نَفْس سَرِيرِيّ (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "clinical test": "تجربة سريرية (اختبار محكوم بصرامة لدواء جديد أو جهاز طبي جراحي جديد على البشر)",
 "clinical thermometer": "مقياس حرارة طبي, ميزان حرارة طبي (ميزان حرارة زئبقي مصمم لقياس درجة حرارة جسم الإنسان؛ مدرج لتغطية نطاق بضع درجات على جانبي درجة حرارة الجسم الطبيعية)",
 "clinical trial": "تجربة سريرية (اختبار محكوم بصرامة لدواء جديد أو جهاز طبي جراحي جديد على البشر)",
 "clinically": "إكلينيكياً, سريرياً (بطريقة سريرية)\nمثال: هي مؤهلة سريرياً",
 "clinician": "إكلينيكي, سريري (ممارس (للطب أو علم النفس) يقوم بعمل سريري بدلاً من التجارب المعملية)",
 "clinid": "سمكة كلينيد (معظمها أسماك بلينية صغيرة تعيش في الشعاب المرجانية وأحواض الأعشاب البحرية)",
 "clinid fish": "سمكة كلينيد (معظمها أسماك بلينية صغيرة تعيش في الشعاب المرجانية وأحواض الأعشاب البحرية)",
 "clink": "حبس, سجن (مؤسسة إصلاحية تستخدم لاحتجاز الأشخاص الموجودين في الحجز القانوني للحكومة (إما متهمين ينتظرون المحاكمة أو مدانين يقضون عقوبة)) / رنين معدني, طقطقة (صوت معدني خفيف قصير)",
 "clinker": "طوب محروق, كلينكر (طوب صلب يستخدم كحجر رصف) / خَبَث الفحم, رَمَاد خَشِن (بقايا غير قابلة للاحتراق تُترك بعد حريق الخشب أو الفحم أو الفحم النباتي)",
 "clinker block": "طوب خرساني (كتلة بناء خرسانية خفيفة مصنوعة من ركام الخبث)\nمثال: يطلق على الطوب الخرساني اسم \"قوالب النسيم\" في بريطانيا",
 "clinker brick": "طوب محروق, كلينكر (طوب صلب يستخدم كحجر رصف)",
 "clinker-built": "مُتَرَاكِب الأَلْوَاح (لديه ألواح هيكل متداخلة)",
 "clinking": "رَنَّان, مُطَقْطِق (يشبه صوت الرنين الخفيف الحاد للكؤوس حين تُطرَق)",
 "clinocephalism": "تقعر الرأس, رأس سريري (عيب خلقي يكون فيه الجزء العلوي من الرأس منخفضا (مقعراً بدلاً من محدب))",
 "clinocephaly": "تقعر الرأس, رأس سريري (عيب خلقي يكون فيه الجزء العلوي من الرأس منخفضا (مقعراً بدلاً من محدب))",
 "clinodactyly": "تقوس الأصابع (عيب خلقي تكون فيه واحد أو أكثر من أصابع القدم أو اليد في وضع غير طبيعي)",
 "clinometer": "كلينومتر, مقياس الميل (أداة يستخدمها المساحون لقياس زاوية الميل أو الارتفاع)",
 "clinopodium grandiflorum": "كالامينت كبير الأزهار (عشب عطري بزهور وردية كبيرة؛ موطنه جنوب وجنوب شرق أوروبا والأناضول وشمال إيران)",
 "clinopodium vulgare": "ريحان بري, كلينوبوديوم (عشب عطري له رؤوس من الزهور الصغيرة الوردية أو البيضاء؛ موزع على نطاق واسع في الولايات المتحدة وأوروبا وآسيا)",
 "clinoril": "سولينداك, كلينوريل (دواء مضاد للالتهاب غير ستيرويدي (الاسم التجاري كلينوريل))",
 "clinquant": "بَرَّاق, لَامِع بِالذَّهَب (متلألئ بالذهب أو الفضة)",
 "clinton administration": "إدارة كلينتون (السلطة التنفيذية في عهد الرئيس كلينتون)",
 "clinton's lily": "زنبق كلينتون, كلينتونيا (أي نبات زنبقي معتدل من جنس كلينتونيا ذو أوراق قاعدية عريضة وأزهار بيضاء أو صفراء أو أرجوانية تليها توت أزرق أو أسود)",
 "clintonia": "زنبق كلينتون, كلينتونيا (أي نبات زنبقي معتدل من جنس كلينتونيا ذو أوراق قاعدية عريضة وأزهار بيضاء أو صفراء أو أرجوانية تليها توت أزرق أو أسود)",
 "clintonia andrewsiana": "كلينتونيا حمراء (نبات بساق شبه خالية من الأوراق تعلوها عنقود من الزهور الحمراء أو الخزامية المحمرة؛ كاليفورنيا إلى أوريغون)",
 "clintonia borealis": "كلينتونيا شمالية, كلينتونيا صفراء (عشب غابات شائع في أمريكا الشمالية المعتدلة له زهور صفراء متدلية وثمار زرقاء مستديرة صغيرة)",
 "clintonia uniflora": "قلنسوة العروس, كأس الملكة (نبات بـ 1 أو 2 زهرة بيضاء تشبه النجوم على سيقان قصيرة بلا أوراق؛ ألاسكا إلى كاليفورنيا وشرقاً إلى أوريغون ومونتانا)",
 "clioquinol": "كليوكينول, يودوكلورهيدروكسيكين (دواء يستخدم لعلاج بعض الالتهابات الفطرية (مثل قدم الرياضي))",
 "clip": "مِشْبَك / كْلِيبْ",
 "clip art": "قصاصة فنية, كليب آرت (قطع جاهزة من الفنون الجرافيكية الحاسوبية التي يمكن استخدامها لتزيين مستند)",
 "clip artist": "محتال محترف (نصاب يبتز الضحية)",
 "clip joint": "مكان استغلالي (مكان ترفيهي يتقاضى أسعاراً مرتفعة مقابل ترفيه رديء)",
 "clip lead": "سلك بمشبك (قطعة قصيرة من السلك مع مشابك تمساح في كلا الطرفين)",
 "clip-clop": "حَبَطَقْطَقْ",
 "clip-on": "قَابِل لِلتَّعْلِيق بِمَشْبَك (يمكن تثبيته بواسطة مشبك) / أداة تُشبك, مشبك (جهاز (مثل قرط، نظارة شمسية، ميكروفون، إلخ) يتم تثبيته بواسطة مشابك)",
 "clipboard": "حَافِظَة",
 "clipped": "مُتَقَطِّع, مُقْتَضَب ((في الكلام) ذو أَصْوات سَريعَة وَقَصيرَة) / مَقْصُوص (تم قصه أو تشذيبه بالمقص)",
 "clipper": "قصاصة أظافر (مقص لقص الشعر أو أظافر الأصابع) / مقص العشب (مقص لقطع العشب أو الشجيرات) / كليبر (سفينة شراعية سريعة استخدمت في العصور السابقة) / قاص, محدد ((إلكترونيات) دائرة إلكترونية غير خطية يكون خرجها محدوداً في السعة؛ تستخدم للحد من السعة اللحظية لشكل الموجة (لقص قمم شكل الموجة))\nمثال: المحدد يسبب تشويهاً في السعة",
 "clipper ship": "كليبر (سفينة شراعية سريعة استخدمت في العصور السابقة)",
 "clipperton island": "جزيرة كليبرتون",
 "clippety-clop": "خبب, طقطقة الحوافر (صوت حوافر حصان تضرب على سطح صلب)",
 "clipping": "قُلَامَة",
 "clique": "طُغْمَة, عُصْبَة",
 "cliquish": "عَشَائِرِيّ, مُتَعَصِّب لِجَمَاعَتِه (يليق بمن يميلون إلى التمييز الاجتماعي ويصدّون من يعتبرونهم أدنى منهم)",
 "cliquishly": "بِانْعِزَالِيَّة, بِعَصَبِيَّة (بطريقة عشائرية)\nمثال: هؤلاء الأصدقاء الأربعة يتصرفون دائماً بانعزالية، ولا يدعوننا نشارك في أنشطتهم",
 "cliquishness": "انعزالية, تحزب (الميل للاختلاط بمجموعة مختارة فقط)",
 "clit": "بظر (عضو جنسي أنثوي متماثل مع القضيب)",
 "clitic": "لصيقة, لفظ متصل (كلمة تعامل في النطق كجزء من كلمة مجاورة وغالباً ما تكون غير منبورة أو مختصرة)",
 "clitocybe clavipes": "كليتوسيب كلافيبيس (غاريقون بقبعة مسطحة رمادية أو بنية مصفرة مع خياشيم شاحبة وساق ينتفخ نحو القاعدة)",
 "clitocybe dealbata": "كليتوسيب ديلباتا (غاريقون سام صغير؛ له قبعة بيضاء جافة مع خياشيم مزدحمة وساق قصير)",
 "clitocybe inornata": "كليتوسيب إنورناتا (فطر بقبعة تكون رمادية كريمية عندما تكون صغيرة وتتحول إلى بنية مع تقدم العمر وساق مبيض يصبغ باللون الأصفر عند لمسه)",
 "clitocybe irina": "كليتوسيب إيرينا (غاريقون صالح للأكل بقبعات بيضاء حريرية كبيرة وسيقان سميكة)",
 "clitocybe nuda": "بلوويت (غاريقون صالح للأكل لونه ليلكي شاحب عندما يكون صغيراً؛ له قبعة رطبة ملساء)",
 "clitocybe robusta": "كليتوسيب روبوستا (غاريقون أبيض كبير؛ صالح للأكل لكنه ليس مستساغاً)",
 "clitocybe subconnexa": "كليتوسيب تحت متصل (غاريقون أبيض صالح للأكل يثمر في مجموعات كثيفة؛ الخياشيم ضيقة ومزدحمة والساق لحمي وغير مصقول)",
 "clitoral": "بَظْرِيّ",
 "clitoral glans": "حَشَفَة الْبَظْر",
 "clitoral vein": "وريد بظري (أوردة تخدم البظر)",
 "clitoria mariana": "بازلاء الفراشة, كليتوريا ماريانا (كرمة برية ملتفة كبيرة الزهر في جنوب شرق ووسط الولايات المتحدة لها أزهار زرقاء شاحبة)",
 "clitoria ternatea": "بازلاء الفراشة, بازلاء زرقاء (كرمة من آسيا الاستوائية لها أوراق ريشية وأزهار زرقاء زاهية بمراكز صفراء)",
 "clitoric": "بظري (متعلق بالبظر)",
 "clitoridectomy": "استئصال البظر, ختان الإناث (استئصال البظر)",
 "clitoris": "بَظْر",
 "clivers": "جويسئة خشنة, عشب الإوز (نبات حولي له ساق مغطى بأشواك منحنية؛ أمريكا الشمالية وأوروبا وآسيا)",
 "cloaca": "بالوعة, مجرور (أنبوب نفايات ينقل مياه الصرف الصحي أو المياه السطحية) / مذرق ((في علم الحيوان) التجويف (في الطيور والزواحف والبرمائيات ومعظم الأسماك ووحيدات المسلك ولكن ليس في الثدييات الأخرى) في نهاية الجهاز الهضمي الذي تفتح…)",
 "cloak": "مِعْطَف فَضْفَاض",
 "cloak-and-dagger": "خَفِيّ, سِرِّيّ (يُجْرَى بِأَهْدَافٍ أَوْ أَسَالِيبَ خَفِيَّة)",
 "cloaked": "مُتَدَثِّر, مُلَفَّف (مغطى بثياب أو لفافة أو عباءة أو ما يشبهها) / مُتَنَكِّر, مُقَنَّع (مُخْفًى طَبِيعَتُهُ الحَقِيقِيَّةُ بِقَصْدِ التَّضْلِيل)",
 "cloakmaker": "صانع عباءات, فرّاء (شخص مهنته صنع أو إصلاح الملابس المصنوعة من الفراء)",
 "cloakroom": "غرفة المعاطف, غرفة الملابس (غرفة يمكن ترك المعاطف والأشياء الأخرى فيها مؤقتاً) / استراحة الأعضاء (صالة خاصة ملحقة بقاعة تشريعية)",
 "cloakroom ticket": "تذكرة الأمانات, وصل استلام المعاطف (تذكرة تُعطى لشخص يودع معطفاً أو غرضاً شخصياً آخر في غرفة الأمانات وتستخدم لاسترداد ذلك الغرض لاحقاً)",
 "clobber": "أشياء, أغراض (مصطلحات غير رسمية للممتلكات الشخصية)\nمثال: هل أخذت كل أغراضك؟",
 "clochard": "متشرد, هائم (متجول ليس لديه إقامة ثابتة أو وسيلة عيش ظاهرة)",
 "cloche": "قبعة جرسية, قبعة كلوش (قبعة نسائية محكمة القياس تشبه الخوذة) / غطاء نباتي, ناقوس زجاجي للنبات (غطاء شفاف منخفض يوضع فوق النباتات الصغيرة لحمايتها من البرد)",
 "clock": "سَاعَة, ساعة (ثُلْث ثُمْن اليَوْم بمعنى مجموع النَهَار واللَيْل، أي جزء من أربعة وعشرين جزءا من مجموع النهار والليل وتتكون من ستين دَقِيقَة؛ الوَقْت الحاضر، الآن)\nمثال: درست لمدة ساعة.",
 "clock dial": "وجه الساعة (وجه الساعة الذي يظهر ساعات ودقائق اليوم)",
 "clock face": "قُرْصُ السَّاعَةِ",
 "clock golf": "غولف الساعة (شكل من أشكال الغولف تقوم فيه بضرب الكرة من مواضع مرتبة على محيط دائرة حول الحفرة)",
 "clock pendulum": "بندول الساعة (بندول فيزيائي يستخدم لتنظيم آلية الساعة)",
 "clock radio": "راديو بساعة (راديو يتضمن ساعة يمكن ضبطها لتشغيله تلقائياً)",
 "clock time": "توقيت, زمن (قراءة لنقطة زمنية كما تظهر في الساعة)\nمثال: هل تعرف كم الوقت؟",
 "clock tower": "بُرْج سَاعَة (ظهر وارتفع)\nمثال: وصل كارل إلى برج آخر.",
 "clock watcher": "مراقب الساعة (عامل مشغول بانتظار وقت الانصراف)",
 "clock-watching": "مراقبة الساعة (إيلاء اهتمام مفرط للساعة (توقعاً للتوقف عن العمل))",
 "clocking": "تسجيل الوقت, توقيت (الوقت المستغرق لاجتياز مسار مُقاس)\nمثال: كان توقيتاً قياسياً عالمياً",
 "clockmaker": "سَاعَاتِيّ",
 "clocks": "رقمة شوكرانية, منقار اللقلق أحمر الساق (عشب ضار أوروبي توطن في جنوب غرب الولايات المتحدة والمكسيك له سيقان منبطحة محمرة بأوراق صغيرة تشبه السرخس وزهور صغيرة خزامية حمراء عميقة تليها ثمار…)",
 "clocksmith": "ساعاتي, صانع الساعات (شخص مهنته صنع أو إصلاح الساعات)",
 "clockwise": "بِإِتِّجَاه عَقَارِب السَّاعَة",
 "clockwise rotation": "دوران باتجاه عقارب الساعة, دوران يميني (دوران إلى اليمين)",
 "clockwork": "آلية الساعة (أي آلية من عجلات مسننة يتم تشغيلها بواسطة زنبرك ملفوف؛ تشبه أعمال الساعة الميكانيكية)",
 "clockwork universe": "الكون الميكانيكي (الرؤية القائلة بأن الكون يشبه ساعة بناها الله وتعمل وفقاً للميكانيكا النيوتونية)",
 "clod": "تكتل, كتلة (كتلة متماسكة) / أبله, أجلف (شخص أخرق وغبي)\nمثال: أصابته كرة من الطين في كتفه",
 "cloddish": "ثَقِيل, جِلْف (ثقيل الطبع وبليد وغبيّ)",
 "clodhopper": "حذاء عمل, حذاء غليظ (حذاء سميك وثقيل)",
 "clofibrate": "أتروميد-إس, كلوفيبرات (دواء (الاسم التجاري أتروميد-إس) يقلل من الدهون في مصل الدم؛ يستخدم لعلاج بعض أمراض القلب والأوعية الدموية)",
 "clog": "قُبْقَاب, قَبْقَاب (الجمل الهدّار ذو الصوت العالي؛ الكذاب الكثير الكلام والكذب والهذر)",
 "clog dance": "رقص القبقاب, رقص الكلوج (رقصة تُؤدى أثناء ارتداء أحذية بنعال خشبية؛ وتتميز بخطوات ذات وقع ثقيل)",
 "clog dancer": "راقص القبقاب (شخص يمارس رقص القبقاب)",
 "clog dancing": "رقص القبقاب, رقص الكلوج (رقصة تُؤدى أثناء ارتداء أحذية بنعال خشبية؛ وتتميز بخطوات ذات وقع ثقيل)",
 "clogged": "مَسْدُود, مُعَاق (محمّل بما يُعيق الحركة) / مَخْنُوق, مُنْسَدّ (مسدود ومتكدّس) / مُتَخَثِّر, مُتَكَتِّل (تَغَلَّظَ أَوْ تَجَمَّعَ فِي كُتَلٍ لَيِّنَةٍ سَمِيكَة)",
 "clogging": "مُعَرْقِل, مُعِيق (يمنع الحركة ويعوق التقدّم)",
 "cloggy": "ثَقِيل, طِينِيّ ((يُقال عن التربة) متراصّ ودقيق الحبيبات)",
 "cloisonne": "مُزَيَّن بِالمِينَاء, مِينَائِيّ ((للمعادن) ذو مساحات مفصولة بالمعدن ومملوءة بالمينا الملونة والمحروقة) / خزف مفرغ, مينا كلوازونيه (أواني مطلية بالمينا يتم فيها فصل المناطق الملونة بشرائط معدنية رقيقة)",
 "cloister": "رواق الدير, ممشى مسقوف (فناء ذو ممرات مسقوفة (كما في المؤسسات الدينية)) / دير, سكن ديني (سكن يكون مكاناً للعزلة الدينية (مثل الدير))",
 "cloistered": "مُنْتَبِذ, مُنْعَزِل (يُوفِّر الخصوصية أو العزلة) / دَيْرِيّ, رَهْبَانِيّ (مُتَعَلِّقٌ بِالحَيَاةِ الجَمَاعِيَّةِ المُنْعَزِلَةِ عَنِ العَالَمِ تَحْتَ نُذُورٍ دِينِيَّةٍ)",
 "cloistral": "دَيْرِيّ, رَهْبَانِيّ (مُتَعَلِّقٌ بِالحَيَاةِ الجَمَاعِيَّةِ المُنْعَزِلَةِ عَنِ العَالَمِ تَحْتَ نُذُورٍ دِينِيَّةٍ)",
 "clomid": "كلوميد, كلوميفين (دواء للخصوبة (الاسم التجاري كلوميد) يستخدم لتحفيز الإباضة وقد ارتبط بحالات الولادة المتعددة (التوائم))",
 "clomiphene": "كلوميد, كلوميفين (دواء للخصوبة (الاسم التجاري كلوميد) يستخدم لتحفيز الإباضة وقد ارتبط بحالات الولادة المتعددة (التوائم))",
 "clomiphene citrate": "كلوميد, كلوميفين (دواء للخصوبة (الاسم التجاري كلوميد) يستخدم لتحفيز الإباضة وقد ارتبط بحالات الولادة المتعددة (التوائم))",
 "clomipramine": "كلوميبرامين (دواء مضاد للاكتئاب ثلاثي الحلقات)",
 "clon": "مستنسخ, نسيلة (مجموعة من الخلايا أو الكائنات المتطابقة وراثياً المشتقة من خلية واحدة أو فرد واحد عن طريق نوع من التكاثر اللاجنسي)",
 "clonal": "مستنسخ, نسيلي (من أو متعلق بالنسيلة (الاستنساخ))",
 "clone": "كْلُون / مُسْتَنْسَخ",
 "clonic": "رمعي (متعلق بنشاط عصبي عضلي غير طبيعي يتميز بتناوب سريع بين انقباض العضلات واسترخائها)\nمثال: تشنج رمعي",
 "clonidine": "كاتابريس, كلونيدين (خافض لضغط الدم (الاسم التجاري كاتابريس) يمكن إعطاؤه عن طريق الفم أو عبر لصقات جلدية)",
 "cloning": "اِسْتِنْسَاخ",
 "clonus": "رمع (تشنج يتميز بتقلصات واسترخاءات متناوبة)",
 "clop": "خبب, طقطقة الحوافر (صوت حوافر حصان تضرب على سطح صلب)",
 "clopidogrel bisulfate": "بلافيكس, كلوبيدوغريل (مميع للدم (الاسم التجاري بلافيكس) معتمد لعلاج النوبات القلبية الخفيفة؛ يعمل عن طريق منع الصفائح الدموية من الالتصاق ببعضها البعض لتشكيل جلطات من…)",
 "clopping": "خبب, طقطقة الحوافر (صوت حوافر حصان تضرب على سطح صلب)",
 "clorox": "كلوروكس (عامل تبييض تجاري)",
 "close": "أَغْلَقَ, سَكَّر (ضد فَتَحَ؛ سَدَّ وسَكَّرَ؛ قد تستخدم بمعنى أَقْفَلَ؛ أغلقه بحيث لا يفتح إلا بمفتاح) / قَرِيب\nمثال: أغلق الباب بغضب",
 "close call": "فوز بشق الأنفس, نجاة بأعجوبة (شيء تم تحقيقه (أو الهروب منه) بفارق ضئيل)",
 "close corporation": "شركة مساهمة خاصة, شركة مغلقة (شركة مملوكة لعدد قليل من الأشخاص؛ ليس لأسهمها سوق عام)",
 "close order": "نظام متراص, نظام مغلق (تشكيل عسكري للتدريب أو المسير)",
 "close quarters": "تقارب شديد, مكان ضيق (حالة التواجد بشكل قريب جداً وغير مريح من شخص أو شيء ما)",
 "close ranks": "رَصّ الصُّفُوف (رَصَّ رَصَّ رَصَصًا: انْضَمَّ بعضُه إلى بعض وتقارَب؛ يقال: رَصَّتِ الأسنانُ: انتظَمَتْ واستَوَتْ)",
 "close shave": "فوز بشق الأنفس, نجاة بأعجوبة (شيء تم تحقيقه (أو الهروب منه) بفارق ضئيل)",
 "close support": "إسناد قريب, دعم قريب (إطلاق نار قريب من قبل وحدة ضد عدو تشتبك معه وحدة أخرى)",
 "close supporting fire": "نيران دعم قريب (نيران على قوات أو أسلحة أو مواقع العدو القريبة من الوحدة المدعومة والتي تشكل التهديد الأكثر فورية وخطورة لها)",
 "close to": "بِالْقُرْب مِن, بِجَانِب",
 "close to the wind": "عكس الريح (عكس اتجاه الريح تقريباً)\nمثال: الإبحار عكس الريح",
 "close up": "بمدى قريب, عن قرب (قريب جداً)\nمثال: بدون نظارة القراءة لا أستطيع رؤية الأشياء عن قرب",
 "close vowel": "صائت مرتفع, صائت مغلق (صوت صائت يُصنع واللسان بالقرب من سقف الحلق)",
 "close-fitting": "مُحْكَم, مُلائِم (ضَيِّق وَمُلائِم لِلجِسْم بِشَكْل مُريح)",
 "close-grained": "دَقِيقُ الْحُبَيْبَاتِ, مُتَرَاصّ (كثيف أو متراصّ البنية كخشب مؤلّف من خلايا صغيرة القطر)",
 "close-hauled": "مُقَلَّص الأَشْرِعَة (ذو أشرعة مضبوطة للإبحار بأقرب ما يمكن من اتجاه الريح)",
 "close-knit": "مُتَرَابِط, مُتَمَاسِك (مترابط كما لو بأواصر اجتماعية أو ثقافية)",
 "close-minded": "مُنْغَلِق الذِّهْن (غَيْر مُسْتَعِدّ لِتَقَبُّل الأَفْكَار الجَدِيدَة)",
 "close-order drill": "تدريب النظام المنضم ((عسكرية) تدريب عسكري للجنود على المسير القياسي (كتفاً بكتف))",
 "close-packed": "مُتَكَدِّس, مُتَلَاصِق (مرصوص بإحكام شديد)",
 "close-quarter fighting": "قِتَال عَن قُرْب, قِتَال مُتَلَاحِم (قتال بالأيدي في أماكن قريبة)",
 "close-up": "لقطة مقربة (صورة فوتوغرافية (أو غيرها) يظهر فيها الموضوع بمقياس كبير نسبياً، ويشغل معظم أو كل الإطار)",
 "closed": "مُغْلَق",
 "closed book": "سر, غموض (شيء يحير الفهم ولا يمكن تفسيره)\nمثال: كيف خرج هو لغز",
 "closed chain": "حلقة, سلسلة مغلقة ((كيمياء) سلسلة من الذرات في جزيء تشكل حلقة مغلقة)",
 "closed circuit": "دائرة مغلقة (دائرة كهربائية كاملة يتدفق حولها التيار أو تدور فيها إشارة)",
 "closed corporation": "شركة مساهمة خاصة, شركة مغلقة (شركة مملوكة لعدد قليل من الأشخاص؛ ليس لأسهمها سوق عام)",
 "closed couplet": "ثنائية مغلقة (ثنائية مقفاة تشكل وحدة نحوية كاملة)",
 "closed curve": "منحنى مغلق (منحنى (مثل الدائرة) ليس له نقاط نهاية)",
 "closed fracture": "كسر بسيط, كسر مغلق (كسر غير مضاعف لا تخترق فيه العظام المكسورة الجلد)",
 "closed gentian": "جنطيانا عمياء, جنطيانا مغلقة (جنطيانا من شرق أمريكا الشمالية لها زهور أنبوبية زرقاء أو بيضاء تفتح قليلاً أو لا تفتح على الإطلاق) / جنطيانا مغلقة",
 "closed interval": "فترة مغلقة (فترة تتضمن نقطتي نهايتها)",
 "closed loop": "حلقة مغلقة, نظام الحلقة المغلقة (نظام تحكم ذو حلقة تغذية مرتدة نشطة)",
 "closed primary": "اِنْتِخَابَات تَمْهِيدِيَّة مُغْلَقَة (انتخابات تمهيدية لا يمكن التصويت فيها إلا للأعضاء المسجلين في حزب سياسي معين)\nمثال: الانتخابات التمهيدية المغلقة تعزز وحدة الحزب",
 "closed session": "جلسة تنفيذية, جلسة مغلقة (جلسة (عادة لهيئة تشريعية) تكون مغلقة أمام الجمهور)",
 "closed shop": "مؤسسة مغلقة التوظيف (شركة توظف أعضاء النقابة فقط)",
 "closed syllable": "مقطع مغلق (مقطع صوتي ينتهي بصامت)",
 "closed universe": "كَوْن مُغْلَق ((علم الكونيات) كون مغلق مكانياً وفيه مادة كافية لوقف التوسع الذي بدأ بالانفجار العظيم)",
 "closed-angle glaucoma": "زرق حاد, زرق مغلق الزاوية (زرق (غلوكوما) تقوم فيه القزحية بسد تدفق الخلط المائي)\nمثال: يمكن للزرق مغلق الزاوية أن يسبب تراكمًا سريعًا لضغط العين المرتفع مما يؤدي إلى تلف بصري دائم في غضون يومين",
 "closed-captioned": "مترجم نصياً, مصحوب بترجمة نصية (يُبث مع تعليقات تظهر فقط على أجهزة الاستقبال التي تحتوي على معدات خاصة؛ يمكن توفيره للمشاهدين ضعاف السمع)",
 "closed-chain": "مُغْلَقُ السِّلْسِلَةِ (تترابط ذراته بروابط ممثلة بشكل دائري أو مثلثي)",
 "closed-circuit": "دائرة مغلقة (يتعلق بـ أو يتكون من دائرة مغلقة)\nمثال: تلفزيون الدائرة المغلقة",
 "closed-circuit television": "تلفزيون الدائرة المغلقة (نظام تلفزيوني لا يستخدم للبث العام ولكنه متصل بكابلات بشاشات مراقبة محددة (كما في المصانع أو المسارح))",
 "closed-class word": "أداة, كلمة وظيفية (كلمة غير متصرفة وتخدم وظيفة نحوية ولكن ليس لها معنى محدد بوضوح)",
 "closed-door": "خَلْفَ أَبْوَاب مُغْلَقَة (غير مفتوح للعامّة)",
 "closed-end fund": "شركة استثمار مغلقة, صندوق استثمار مغلق (شركة استثمار منظمة تصدر عدداً ثابتاً من الأسهم التي يتم إدراجها في سوق الأوراق المالية)",
 "closed-end investment company": "شركة استثمار مغلقة, صندوق استثمار مغلق (شركة استثمار منظمة تصدر عدداً ثابتاً من الأسهم التي يتم إدراجها في سوق الأوراق المالية)",
 "closed-heart surgery": "جراحة القلب المغلق (جراحة قلب يتم فيها عمل شق صغير (لا يتم فتح تجويف الصدر))",
 "closed-loop system": "حلقة مغلقة, نظام الحلقة المغلقة (نظام تحكم ذو حلقة تغذية مرتدة نشطة)",
 "closed-minded": "مُنْغَلِق الذِّهْن (غَيْر مُسْتَعِدّ لِتَقَبُّل الأَفْكَار الجَدِيدَة)",
 "closed-ring": "مُغْلَقُ السِّلْسِلَةِ (تترابط ذراته بروابط ممثلة بشكل دائري أو مثلثي)",
 "closed-source": "مُغْلَق الْمَصْدَر",
 "closedown": "إغلاق, إقفال (إنهاء العمليات)\nمثال: أسفوا لإغلاق مركز الرعاية النهارية",
 "closefisted": "قَابِض اليَد, مُمْسِك (غير راغب في التخلي عن المال)",
 "closelipped": "كَتُوم, مُتَحَفِّظ (يميل إلى السرّيّة والتكتّم عن إفشاء المعلومات)",
 "closely": "بتقارب, عن كثب (في علاقة أو موقع قريب في الزمان أو المكان) / بشكل وثيق, حميمياً (بطريقة وثيقة) / بدقة, عن كثب (بطريقة منتبهة)\nمثال: كانت البدايات متقاربة زمنياً",
 "closely held corporation": "شركة ذات ملكية مقيدة (يتم تداول الأسهم علناً ولكن معظمها مملوك لعدد قليل من المساهمين الذين ليس لديهم خطط للبيع)",
 "closely knit": "مُتَرَابِط, مُتَمَاسِك (مترابط كما لو بأواصر اجتماعية أو ثقافية)",
 "closely-held": "مَمْلُوك لِقِلَّة (مملوك لعدد قليل نسبيًّا من المساهمين)",
 "closemouthed": "كَتُوم, مُتَحَفِّظ (يميل إلى السرّيّة والتكتّم عن إفشاء المعلومات)",
 "closeness": "ألفة, حميمية (صداقة وثيقة أو دافئة) / انغلاق, تكتم (يتسم بقلة الانفتاح (خاصة حول أفعال المرء أو مقاصده)) / خسة, شح (بخل شديد) / تَقَارُب, قُرْب (الخاصية المكانية الناتجة عن مسافة صغيرة نسبياً)\nمثال: خلق غياب الأسوار حميمية غامضة لم يعرف فيها أحد الخصوصية",
 "closeout": "تصفية نهائية (بيع يهدف إلى التخلص من جميع المخزون المتبقي)",
 "closer": "أقرب ((صيغة المقارنة لـ قريب) ضمن مسافة أقصر) / الغالق, رامٍ منهي للمباراة ((في البيسبول) رامٍ بديل يمكنه حماية التقدم في الشوط الأخير أو الشوطين الأخيرين من المباراة) / مُغْلِق (شخص يغلق شيئاً ما)\nمثال: تعال أقرب يا عزيزي!",
 "closest": "الأقرب ((صيغة التفضيل لـ قريب) ضمن أقصر مسافة)\nمثال: كان ذلك الوقت الذي اقترب فيه الأقرب إلى الموت",
 "closet": "عَرِين, حُجْرَة (اِسْمٌ لِمَاْوَى الأَسَد) / خِزَانَة (مكان الخَزْن؛ قطعة أثاث للخَزْن)\nمثال: اقترب من الخزانة.",
 "closet auger": "سلك تسليك المراحيض (أداة مرنة تستخدم لفك انسداد المراحيض)",
 "closet drama": "دراما للقراءة (دراما أكثر ملاءمة للقراءة منها للأداء)",
 "closet queen": "مثلي متخف (مصطلح سلبي لرجل مثلي الجنس يختار عدم الكشف عن ميوله الجنسية)",
 "closeup": "لقطة قريبة (صورة فوتوغرافية ملتقطة من مسافة قريبة)",
 "closeup lens": "عدسة تقريب (عدسة تصوير ذات طول بؤري قصير تستخدم لالتقاط صور من مسافات قريبة)",
 "closing": "إتمام, إكمال (إجراء ختامي أو نهائي) / إغلاق, إقفال (إنهاء العمليات) / اقتراب, تضييق المسافة (الاقتراب من وجهة معينة؛ تضييق الفجوة) / إغلاق (عملية إغلاق شيء ما)\nمثال: أسفوا لإغلاق مركز الرعاية النهارية",
 "closing curtain": "خاتمة, مشهد ختامي (الجزء الختامي من أي أداء فني)",
 "closing off": "إِفْرَاد, عَزْل (فعل عزل شيء ما؛ وضع شيء بمعزل عن الآخرين)",
 "closing price": "سعر الإغلاق ((سوق الأسهم) سعر آخر معاملة تمت خلال جلسة تداول اليوم)",
 "closing time": "وقت الإغلاق (الوقت المعتاد من اليوم الذي تغلق فيه مؤسسة أبوابها أمام الجمهور)",
 "clostridia": "كلوستريديوم, مِطَثِّيَّة (خلية بكتيرية مغزلية الشكل خاصة تلك المنتفخة في المركز بواسطة بوغ داخلي)",
 "clostridial myonecrosis": "غرغرينا غازية (شكل مميت من الغرغرينا تسببه عادة بكتيريا المطثية التي تنتج سموماً تسبب موت الأنسجة)",
 "clostridium": "كلوستريديوم, مِطَثِّيَّة (خلية بكتيرية مغزلية الشكل خاصة تلك المنتفخة في المركز بواسطة بوغ داخلي)",
 "clostridium botulinum": "بكتيريا التسمم الوشيقي, مِطَثِّيَّة وشيقية (بكتيريا لاهوائية تنتج الوشيقان (البوتولين)، وهو السم الذي يسبب التسمم الوشيقي)",
 "clostridium perfringens": "كلوستريديوم بيرفرنجنز, مِطَثِّيَّة حاطمة (بكتيريا عصوية لاهوائية موجبة الجرام تنتج سم إبسيلون؛ يمكن استخدامها سلاحاً بيولوجياً)",
 "clostridium perfringens epsilon toxin": "ذيفان إبسيلون",
 "closure": "إغلاق, إقفال (إنهاء العمليات) / اقتراب, تضييق المسافة (الاقتراب من وجهة معينة؛ تضييق الفجوة) / انسداد, سد (فعل السد أو الغلق) / انسداد, سدادة (عائق في أنبوب أو مجرى)\nمثال: أسفوا لإغلاق مركز الرعاية النهارية",
 "closure by compartment": "تَحْدِيد وَقْت النِّقَاش, مِقْصَلَة تَشْرِيعِيَّة (إغلاق يُفرض على مناقشة أقسام محددة من مشروع قانون)",
 "clot": "جلطة, خثرة (كتلة من مادة تشكلت من محتوى سائل)",
 "clot buster": "حال للتخثر, مذيب للجلطات (نوع من المستحضرات الصيدلانية يمكنه تفتيت الجلطات التي تمنع تدفق الدم إلى عضلة القلب)",
 "clotbur": "أرقطيون, رأس الحمامة (أي من عدة أعشاب ثنائية الحول قائمة من أوراسيا المعتدلة، لها جذور وتدية قوية وتنتج ثماراً شائكة)",
 "cloth": "قُمَاش, أقمشة (النسيج الذي لم يُقَصّ أو يُخَاط) / مِمْسَحَة\nمثال: الورق و القماش يمتصان الماء.",
 "cloth cap": "قبعة قماشية, قبعة مسطحة (قبعة صوفية مسطحة بحافة صلبة)",
 "cloth covering": "غطاء قماشي (غطاء مصنوع من القماش)",
 "clothed": "مَكْسُوّ, مُرْتَدٍ مَلَابِس (يرتدي أو مزود بملابس؛ تستخدم أحياناً في التركيب) / مُتَدَثِّر, مُلَفَّف (مغطى بثياب أو لفافة أو عباءة أو ما يشبهها)\nمثال: مكسو وفي كامل قواه العقلية",
 "clothes": "مَلَابِس, ثِيَاب",
 "clothes basket": "سلة غسيل (سلة توضع فيها الملابس المتسخة لغسلها أو الملابس المبللة لتجفيفها)",
 "clothes closet": "خزانة ثياب (خزانة يتم فيها تخزين الملابس)",
 "clothes designer": "مصمم أزياء, مصمم ملابس (شخص متخصص في تصميم الملابس والموضة)",
 "clothes drier": "مجفف ملابس, نشافة (مجفف يقوم بتجفيف الملابس المبللة بعد الغسيل)",
 "clothes dryer": "مُجَفِّف مَلَابِس",
 "clothes hamper": "سلة غسيل (سلة توضع فيها الملابس المتسخة لغسلها أو الملابس المبللة لتجفيفها)",
 "clothes hanger": "شماعة, علاقة ملابس (علاقة مصممة على شكل أكتاف الشخص وتستخدم لتعليق الملابس عليها)",
 "clothes iron": "مِكْوَاة, مِكْوَاة كَهْرَبَائِيَّة",
 "clothes moth": "عثة الملابس (أي من عدة عثث صغيرة مصفرة أو برتقالية اللون تأكل يرقاتها المواد العضوية مثل الصوف)",
 "clothes peg": "مِشْبَك مَلَابِس",
 "clothes pin": "مشبك غسيل (مشبك من الخشب أو البلاستيك؛ لتثبيت الملابس على حبل الغسيل)",
 "clothes tree": "شماعة ملابس (عمود رأسي به أوتاد أو خطافات لتعليق الملابس عليها)",
 "clothesbrush": "فرشاة ملابس (فرشاة تستخدم لتنظيف الملابس)",
 "clotheshorse": "منشر غسيل (هيكل لتعليق الملابس (كما للتجفيف)) / متأنق (رجل يهتم كثيراً بملابسه ومظهره)",
 "clothesless": "بِلَا ثِيَاب (لا يملك أي ملابس)",
 "clothesline": "حبل الغسيل (حبل تُعلق عليه الملابس لتجف)",
 "clothespin": "مشبك غسيل (مشبك من الخشب أو البلاستيك؛ لتثبيت الملابس على حبل الغسيل)",
 "clothespress": "خزانة ثياب (خزانة يتم فيها تخزين الملابس)",
 "clothier": "بائع ملابس رجالية, تاجر ملابس (تاجر يبيع الملابس الرجالية)",
 "clothing": "مَلَابِس, ثِيَاب",
 "clothing store": "متجر ملابس رجالية (متجر تباع فيه ملابس الرجال)",
 "clotted": "مُتَخَثِّر, مُتَكَتِّل (تَغَلَّظَ أَوْ تَجَمَّعَ فِي كُتَلٍ لَيِّنَةٍ سَمِيكَة)",
 "clotted cream": "قِشْطَة, قِشْدَة (طَبَقَة من السَمْن تطفو على الحَلِيب عند غليه، تُقْشَطُ عنه وتؤكل بالخبز أو يصنع منها أنواع أخرى من الطعام لا سيما الحلويات)",
 "clotting": "تجلط, تخثر (عملية تشكيل كتل شبه صلبة في سائل)",
 "clotting factor": "عامل التخثر (أي من العوامل في الدم التي تعد أفعالها ضرورية لتخثر الدم)",
 "clotting time": "زمن التجلط, زمن التخثر (الوقت الذي تستغرقه عينة من الدم للتجلط؛ يستخدم لتشخيص بعض اضطرابات التخثر)",
 "cloture": "إِغْلَاق بَاب النِّقَاش, قَفْل بَاب الْمُرَافَعَات (قاعدة للحد من النقاش أو إنهائه في هيئة تداولية)",
 "cloud": "سَحَاب, غَيْم (الغيوم المتحركة؛ غُيُوم، دَيْم)\nمثال: القمر موجود خلف السحاب.",
 "cloud bank": "بنك السحاب, ركام سحابي (طبقة من السحب تُرى من مسافة بعيدة)",
 "cloud chamber": "غرفة سحابية, غرفة ويلسون السحابية (جهاز يكشف مسار الجسيمات عالية الطاقة التي تمر عبر بخار مفرط التشبع؛ حيث يؤين كل جسيم الجزيئات على طول مساره وتتكثف قطرات صغيرة عليها لتنتج مساراً…)",
 "cloud computing": "حَوْسَبَة سَحَابِيَّة",
 "cloud cover": "تغيم, غطاء سحابي (حالة السماء عندما تكون مغطاة بالسحب)",
 "cloud grass": "عشبة السحاب (عشبة إسبانية ذات عناقيد ريشية خفيفة تزرع للباقات المجففة)",
 "cloud nine": "قمَة السعادَة",
 "cloud seeder": "بَاذِر السُّحُب, مُسْتَمْطِر (شخص يقوم بعملية استمطار السحب)",
 "cloud seeding": "اِسْتِمْطَار",
 "cloud-covered": "مُكْفَهِرّ, مُلَبَّد بِالغُيُوم (ممتلئ أو مغطى بالغيوم)",
 "cloud-cuckoo-land": "أرض الأوهام (مكان خيالي يُقال إن الناس فيه عندما يبدون متفائلين ومنفصلين عن الواقع)",
 "cloudberry": "توت السحاب, توت الغيم (توت شوكي زاحف من المناطق المعتدلة الشمالية بتوت أصفر أو برتقالي)",
 "cloudburst": "طوفان, هطول غزير (مطر غزير)",
 "clouded": "غَائِم",
 "cloudiness": "تَغَيُّم, كُدْرَة (صفة كون الشيء غائماً) / تلبد الغيوم, غائم (شبه ظلام كئيب ناتج عن غطاء سحابي) / تغيم, غطاء سحابي (حالة السماء عندما تكون مغطاة بالسحب)",
 "clouding": "تغيم, تلبد بالغيوم (العملية التي تصبح فيها جزيئات الماء مرئية في السماء)",
 "clouding up": "تغيم, تلبد بالغيوم (العملية التي تصبح فيها جزيئات الماء مرئية في السماء)",
 "cloudless": "خَالٍ مِنَ الغُيُوم, صَافٍ (خالٍ من الغيوم)",
 "cloudlessness": "خلو من السحب, صفاء (سطوع يوم مشمس عندما لا توجد غيوم في السماء)",
 "cloudlike": "سَحَابِيّ, سَدِيمِيّ (يشبه السحابة أو السديم)",
 "cloudy": "غائم",
 "clout": "لكمة ((ملاكمة) ضربة بقبضة اليد) / مسمار عريض الرأس (مسمار قصير برأس مسطح؛ يستخدم لتثبيت الصفائح المعدنية بالخشب) / تَأْثِير قَوِيّ, سَطْوَة (أفضلية أو تأثير خاص) / هدف الرماية (هدف يُستخدم في الرماية بالقوس)\nمثال: وجهت له لكمة على أنفه",
