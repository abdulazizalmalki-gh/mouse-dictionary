 "chrome": "كروم (كلمة أخرى للكروم عند استخدامه في الأصباغ أو الخضاب)",
 "chrome alum": "شب الكروم (ملح بنفسجي اللون يستخدم في دباغة الجلود وكمثبت للون في الصباغة)",
 "chrome green": "أخضر الكروم (لون أخضر متألق) / أخضر الكروم (أي فئة من الأصباغ الخضراء تتكون من أصفر الكروم والأزرق الحديدي)",
 "chrome red": "أحمر الكروم (صبغة حمراء تستخدم في الدهانات؛ كرومات الرصاص القاعدية)",
 "chrome yellow": "أصفر الكروم (أي من الأصباغ الصفراء المتعددة التي تتكون من كرومات الرصاص العادية ومركبات الرصاص الأخرى)",
 "chrome-nickel steel": "إلينفار, فولاذ الكروم والنيكل (اسم تجاري لنوع من الفولاذ يستخدم لنوابض الساعات لأن مرونته ثابتة عبر نطاق واسع من درجات الحرارة)",
 "chrome-tungsten steel": "فولاذ الكروم والتنجستن (سبيكة فولاذية مصنوعة من الكروم والتنجستن)",
 "chromesthesia": "حس لوني (شكل من أشكال الحس المواكب يؤدي فيه التحفيز غير البصري إلى تجربة إحساسات لونية)",
 "chromic acid": "حمض الكروميك (حمض غير مستقر يعرف فقط في المحلول وكأملاح الكرومات)",
 "chromic-sulfuric acid": "حمض الكروميك الكبريتيك (خليط من حمض الكروميك وحمض الكبريتيك يستخدم كعامل تنظيف للأواني الزجاجية)",
 "chromite": "كروميت (معدن أسود مائل للبني؛ المصدر الرئيسي للكروم)",
 "chromium": "كُرُوم",
 "chromium steel": "ستانلس ستيل, فولاذ مقاوم للصدأ (فولاذ يحتوي على الكروم مما يجعله مقاوماً للتآكل)",
 "chromoblastomycosis": "فطار اصطباغي (عدوى فطرية تتميز بعقيدات ثؤلولية مثيرة للحكة على الجلد)",
 "chromogen": "كروموجين, مولد اللون (مركب يمكن تحويله إلى صبغة)",
 "chromolithograph": "طباعة حجرية ملونة, كروموليجرافيا (مطبوعة مصنوعة بالطباعة الحجرية الملونة)\nمثال: اعتماداً على عدد الألوان الموجودة، قد يستغرق إنتاج الطباعة الحجرية الملونة أشهراً بواسطة عمال مهرة للغاية",
 "chromolithography": "طباعة حجرية ملونة, كروموليصوغرافيا (طباعة حجرية أحادية أو متعددة الألوان)",
 "chromophore": "حامل اللون, كروموفور (المجموعة الكيميائية التي تمنح اللون للجزيء)",
 "chromoplast": "صانعة ملونة, كروموبلاست (بلاستيد يحتوي على أصباغ غير اليخضور عادة ما تكون كاروتينات صفراء أو برتقالية)",
 "chromosomal": "صبغي, كروموسومي (من أو يتعلق بالكروموسوم)\nمثال: خلل صبغي",
 "chromosomal aberration": "خلل كروموسومي, شذوذ صبغي (أي تغيير في البنية الطبيعية أو عدد الكروموسومات؛ غالباً ما يؤدي إلى تشوهات جسدية أو عقلية)",
 "chromosomal abnormality": "خلل كروموسومي, شذوذ صبغي (أي تغيير في البنية الطبيعية أو عدد الكروموسومات؛ غالباً ما يؤدي إلى تشوهات جسدية أو عقلية)",
 "chromosomal anomaly": "خلل كروموسومي, شذوذ صبغي (أي تغيير في البنية الطبيعية أو عدد الكروموسومات؛ غالباً ما يؤدي إلى تشوهات جسدية أو عقلية)",
 "chromosomal disorder": "خلل كروموسومي, شذوذ صبغي (أي تغيير في البنية الطبيعية أو عدد الكروموسومات؛ غالباً ما يؤدي إلى تشوهات جسدية أو عقلية)",
 "chromosomal mutation": "طفرة, طفرة جينية ((في علم الوراثة) أي حدث يغير البنية الجينية؛ أي تغيير في تسلسل الحمض النووي الموروث للنمط الجيني للكائن الحي)",
 "chromosome": "كْرُومُوسُوم, صِبْغِيّ",
 "chromosome mapping": "رسم الخرائط الجينية ((علم الوراثة) عملية تحديد مواقع الجينات على الكروموسوم)",
 "chromosphere": "غلاف لوني, كروموسفير (طبقة غازية من الغلاف الجوي للشمس (تمتد من الفوتوسفير إلى الإكليل) تكون مرئية أثناء الكسوف الكلي للشمس)",
 "chronic": "عَوِيص / مُزْمِن",
 "chronic bronchitis": "التهاب الشعب الهوائية المزمن (شكل من أشكال التهاب الشعب الهوائية يتميز بإنتاج مفرط للبلغم مما يؤدي إلى سعال مزمن وانسداد تدفق الهواء)",
 "chronic eczema": "إكزيما حزازية, إكزيما مزمنة (إكزيما تتميز بسماكة الجلد مع خطوط جلدية بارزة)",
 "chronic gastritis": "التهاب المعدة المزمن (التهاب المعدة المستمر يمكن أن يكون عرضاً لقرحة المعدة أو فقر الدم الخبيث أو سرطان المعدة أو اضطرابات أخرى)",
 "chronic glaucoma": "زرق مزمن, زرق مفتوح الزاوية (زرق ناجم عن انسداد قناة شليم؛ ينتج عنه فقدان تدريجي للرؤية المحيطية)\nمثال: الزرق مفتوح الزاوية هو أكثر أنواع الزرق شيوعًا",
 "chronic glossitis": "التهاب اللسان المزمن (التهاب اللسان مع ضمور في أنسجة اللسان؛ يصاحب أحياناً فقر الدم الخبيث)",
 "chronic kidney failure": "فشل كلوي مزمن (فشل كلوي يمكن أن ينتج عن مجموعة متنوعة من الاضطرابات الجهازية)",
 "chronic leukemia": "ابيضاض الدم المزمن, لوكيميا مزمنة (لوكيميا بطيئة التطور)",
 "chronic lymphocytic leukemia": "ابيضاض الدم اللمفاوي المزمن, لوكيميا لمفاوية مزمنة (لوكيميا مزمنة تتميز بخلايا شبيهة بالأرومات اللمفاوية؛ أكثر شيوعًا عند الرجال الأكبر سنًا)",
 "chronic myelocytic leukemia": "ابيضاض الدم النقوي المزمن, لوكيميا نقوية مزمنة (لوكيميا مزمنة تتميز بالكريات البيض الحبيبية؛ أكثر شيوعًا عند كبار السن)",
 "chronic obstructive pulmonary disease": "دَاء الاِنْسِدَاد الرِئَوِيّ المُزْمِن",
 "chronic pyelonephritis": "التهاب الحويضة والكلية المزمن (التهاب الحويضة والكلية الذي يتطور ببطء ويمكن أن يؤدي إلى الفشل الكلوي إذا لم يعالج؛ يرتبط غالبًا بحصوات الكلى أو تضييق الممرات البولية)",
 "chronic renal failure": "فشل كلوي مزمن (فشل كلوي يمكن أن ينتج عن مجموعة متنوعة من الاضطرابات الجهازية)",
 "chronic wasting disease": "مرض الهزال المزمن (مرض يصيب الحياة البرية (شبيه بمرض جنون البقر) ويؤثر على الغزلان والأيائل)",
 "chronically": "بشكل مزمن (بطريقة بطيئة التطور وطويلة الأمد) / بإدمان, بشكل متأصل (بطريقة اعتيادية وطويلة الأمد)\nمثال: أشخاص مرضى بشكل مزمن",
 "chronicle": "تَارِيخ (جملة الأَحوال والأحداث التي يمر بها كائن ما، ويَصْدق على الفرد والمجتمع، كما يَصْدق على الظواهر الطبيعية والإنسانية؛ هو تحديد الزمن باليَوْم والشَهْر والسَنَة أو ببعضهما. الأجَل أو الوَقْت)\nمثال: ما تاريخ اليوم؟",
 "chronicler": "مُؤَرِّخ, مُؤَرِّخَة",
 "chronoception": "إدراك الزمن",
 "chronograph": "كْرُونُوغْرَاف",
 "chronological": "مُرَتَّب زَمَنِيَّا (المَوْضوع في مَرْتبتِه؛ ما بدا عليه التَّرتيب)\nمثال: شعر توم ممشوط و مرتب.",
 "chronological age": "عمر زمني (العمر مقاساً بالوقت (السنوات والشهور) الذي وجد فيه شيء أو شخص ما)\nمثال: كان عمره الزمني 71 عاماً",
 "chronological record": "حوليات, سجل كرونولوجي (وصف زمني للأحداث في سنوات متتالية)",
 "chronological sequence": "تسلسل, تعاقب (تتابع شيء بعد آخر في الوقت)\nمثال: رأى الطبيب تسلسلاً من المرضى",
 "chronological succession": "تسلسل, تعاقب (تتابع شيء بعد آخر في الوقت)\nمثال: رأى الطبيب تسلسلاً من المرضى",
 "chronologically": "تسلسلياً, زمنياً (فيما يتعلق بالتسلسل الزمني)\nمثال: هو أكبر سناً زمنياً",
 "chronology": "تَارِيخ (جملة الأَحوال والأحداث التي يمر بها كائن ما، ويَصْدق على الفرد والمجتمع، كما يَصْدق على الظواهر الطبيعية والإنسانية؛ هو تحديد الزمن باليَوْم والشَهْر والسَنَة أو ببعضهما. الأجَل أو الوَقْت) / تَسَلْسُل زَمَنِيّ\nمثال: ما تاريخ اليوم؟",
 "chronometer": "كرونومتر, مقياس الزمن (ساعة دقيقة (تستخدم بشكل خاص في الملاحة))",
 "chronoperates paradoxus": "كرونوبيراتس (حيوان أولي بحجم الزباب من منطقة ألبرتا في كندا؛ من حوالي 55 مليون سنة مضت (أحدث بكثير من الزواحف الشبيهة بالثدييات الأخرى))",
 "chronoscope": "كرونوسكوب, مقياس الزمن الدقيق (أداة لقياس الفترات الزمنية الصغيرة بدقة)",
 "chronostratigraphic unit": "وحدة زمنية صخرية (جزء من الصخور تشكل خلال فترة زمنية جيولوجية معينة)\nمثال: الوحدات الزمنية الصخرية هي مواد جيولوجية، لذا من الصحيح القول بأن حفريات التيرانوصور ريكس وجدت في سلسلة العصر الطباشيري العلوي",
 "chrysalis": "خَادِرَة",
 "chrysanthemum": "أُقْحُوَان",
 "chrysanthemum balsamita": "بلسم الحدائق, حشيشة مريم (عشب معمر أوراسي برائحة حشيشة الدود له أزهار صفراء تشبه الأزرار؛ يستخدم كبقلة أو خضروات للسلطة وأحياناً في المعطرات المجففة أو الشاي أو النكهة؛ يوضع…)",
 "chrysanthemum cinerariifolium": "بيرثروم, عاقر قرحا (بيرثروم أبيض الزهر من منطقة البلقان أوراقه الريشية بيضاء ومشعرّة حريرياً من الأسفل؛ مصدر لمبيد حشري؛ يوضع أحياناً في جنس أقحوان)",
 "chrysanthemum coccineum": "أقحوان ملون, بيريثروم (نبات حديقة معمر يزهر في الربيع من أصل آسيوي له أوراق عطرية مقسمة بدقة وزهور بيضاء إلى وردية أرجوانية؛ مصدر لمبيد حشري)",
 "chrysanthemum coronarium": "أقحوان تاجي (نبات سنوي شجيري في منطقة البحر الأبيض المتوسط بزهور بيضاء مصفرة)",
 "chrysanthemum coronarium spatiosum": "أقحوان تاجي مأكول, خضروات تشوب سوي (يزرع لأوراقه اللحمية الصالحة للأكل المستخدمة في الطهي الآسيوي)",
 "chrysanthemum dog": "تيريير تبتي (سلالة من التيريير متوسط الحجم ربيت في التبت ككلاب حراسة، تشبه كلاب الراعي الإنجليزية القديمة ولها ذيول مجعدة منفوشة)",
 "chrysanthemum frutescens": "أقحوان المارغريت, أقحوان شجيري (شجيرة معمرة من جزر الكناري لها زهور تشبه الأقحوان صفراء شاحبة عادة؛ تُصنف غالباً ضمن جنس الأقحوان)",
 "chrysanthemum lacustre": "أقحوان البرانس (نبات معمر في البرتغال مشابه لأقحوان المروج)",
 "chrysanthemum leucanthemum": "أقحوان أبيض, أقحوان المروج (نبات أوراسي معمر طويل الساق ومورق بزهور بيضاء؛ متوطن على نطاق واسع)",
 "chrysanthemum maximum": "أقحوان المروج, أقحوان عين الثور (مشابه لأقحوان المروج)",
 "chrysanthemum maximum maximum": "أقحوان شاستا (زهرة حديقة هجينة مشتقة من الأقحوان الأقصى والأقحوان البحيري ذات رؤوس زهور بيضاء كبيرة تشبه أقحوان المروج؛ توضع غالباً في جنس الأقحوان)",
 "chrysanthemum morifolium": "أقحوان, أقحوان بائعي الزهور (من الصين)",
 "chrysanthemum parthenium": "اقحوان زهرة الذهب, زهرة اللبن (عشب معمر أوروبي عطري كثيف له عناقيد من رؤوس زهرية بيضاء الشعاع تشبه الأزرار؛ ذو قيمة تقليدية للاستخدامات الطبية؛ يوضع أحياناً في جنس أقحوان)",
 "chrysanthemum ptarmiciflorum": "دانتيل فضي, طاحونة الغبار (شجيرة معمرة في جزر الكناري ذات زهور وأوراق بيضاء وسيقان مشعرة مغطاة بزغب يشبه الغبار؛ توضع أحياناً في جنس الأقحوان)",
 "chrysanthemum segetum": "أقحوان الحقول, أقحوان الذرة (عشبة أوروبية بزهور صفراء زاهية؛ عشبة ضارة شائعة في حقول الحبوب)",
 "chrysanthemum throne": "عَرْش الأُقْحُوَان (هو كُرْسِيّ المَلِك تحديدا؛ العَرْش: هو عَرش الرَحْمَان فوق سِدْرَة المنتهى)\nمثال: ولي العهد هو من يرث العرش.",
 "chrysaora quinquecirrha": "قنديل البحر القراص (نوع من قناديل البحر)",
 "chrysarobin": "أراروبا, مسحوق جوا (مسحوق أصفر مر يستخدم لعلاج الأمراض الجلدية)",
 "chrysemys picta": "سلحفاة مزركشة (سلاحف مياه عذبة لها علامات صفراء وحمراء زاهية؛ شائعة في شرق الولايات المتحدة)",
 "chrysobalanus icaco": "إيكاكو, برقوق الكاكاو (شجرة استوائية أمريكية صغيرة تحمل فاكهة تشبه البرقوق صالحة للأكل)",
 "chrysoberyl": "كريسوبيريل (معدن نادر صلب أصفر مخضر يتكون من ألومينات البريليوم في شكل بلوري؛ يستخدم كحجر كريم)",
 "chrysolepis chrysophylla": "شنكابين ذهبي, شنكابين عملاق (شجرة زينة صغيرة دائمة الخضرة من ساحل المحيط الهادئ أوراقها الخضراء الصفراء اللامعة صفراء من الأسفل؛ تحمل مكسرات صالحة للأكل)",
 "chrysolepis sempervirens": "شنكابين ذهبي قزم (شجيرة دائمة الخضرة تشبه الشنكابين الذهبي؛ جبال كاليفورنيا)",
 "chrysolite": "زَبَرْجَد",
 "chrysolophus pictus": "تدرج ذهبي (تدرج متوج زاهي الألوان من جبال غرب ووسط آسيا)",
 "chrysomelid": "خنفساء الأوراق (خنفساء زاهية الألوان تتغذى على أوراق النباتات؛ وتغزو يرقاتها الجذور والسيقان)",
 "chrysophrys auratus": "نهاش (سمكة غذائية أسترالية ذات جسم وردي مع بقع زرقاء)",
 "chrysophrys australis": "دنيس أسود (سمكة غذائية ورياضية مهمة داكنة اللون في أستراليا)",
 "chrysophyllum cainito": "تفاح النجمة, كايميتو (شجرة دائمة الخضرة من جزر الهند الغربية وأمريكا الوسطى لها فاكهة أرجوانية صالحة للأكل على شكل نجمة في المقطع العرضي وأوراق خضراء داكنة بجوانب سفلية…)",
 "chrysophyllum oliviforme": "كريسوفيلوم, ورقة الساتان (شجرة خشبية أمريكية استوائية ذات خشب ثقيل صلب داكن وثمار أرجوانية صغيرة تشبه البرقوق)",
 "chrysophyta": "الطحالب الذهبية, قسم الطحالب الذهبية (طحالب حقيقية النواة تعيش غالباً في المياه العذبة ويحجب فيها صبغة بنية أو صفراء الكلوروفيل؛ تشمل الطحالب الصفراء الخضراء والذهبية البنية والدياتومات)",
 "chrysopid": "شبكية الأجنحة الخضراء (ذبابة شبكية الأجنحة خضراء شاحبة كريهة الرائحة لها يرقات آكلة للحوم)",
 "chrysoprase": "كريسوبراز (نوع أخضر من الكالسيدوني يُثمّن كحجر كريم)",
 "chrysopsis mariana": "نجمة ذهبية ماريلاند (نجمة ذهبية معمرة من جنوب شرق الولايات المتحدة)",
 "chrysopsis villosa": "أستر ذهبي مشعر, هيتروتيكا (نبات معمر مشعر ذو رؤوس زهرية صفراء في عناقيد متفرعة؛ يوجد في كل مكان تقريباً في الأماكن الجافة من كندا إلى غرب وسط وغرب الولايات المتحدة؛ يوضع…)",
 "chrysosplenium americanum": "سجاد الماء, كريسوسبلينيوم (عشب مائي بزهور مصفرة؛ وسط وغرب الولايات المتحدة)",
 "chrysostom": "الذَّهَبِيّ الْفَم",
 "chrysothamnus nauseosus": "شجيرة الأرانب (شجيرة عطرية لطيفة لها فروع رفيعة مرنة مشعرة ومجموعات كثيفة من الزهور الصفراء الصغيرة تغطي مساحات شاسعة من السهول القلوية الغربية وتوفر ملاذاً للأرانب…)",
 "chrysotherapy": "علاج بالذهب (استخدام مواد كيميائية تحتوي على الذهب لعلاج الأمراض (مثل التهاب المفاصل الروماتويدي))",
 "chrysotile": "كريزوتيل (معدن ليفي رمادي أو أخضر؛ مصدر تجاري مهم للأسبستوس)",
 "chthonian": "أَرْضِيّ, تَحْتَأَرْضِيّ (يسكن تحت سطح الأرض)",
 "chthonic": "أَرْضِيّ, تَحْتَأَرْضِيّ (يسكن تحت سطح الأرض)",
 "chub": "شوب (سمكة صيد أوروبية تعيش في المياه العذبة ذات جسم سميك مغزلي الشكل)",
 "chub mackerel": "ماكريل تشوب (ماكريل صغير يوجد في جميع أنحاء العالم تقريباً)",
 "chubbiness": "اكتناز, بدانة طفولية (خاصية امتلاك جسم ممتلئ ومستدير)",
 "chubby": "بَدِين بِلُطْف, مُمْتَلِئ (سَمِين بِمَا يَكْفِي لِيَكُون مُمْتَلِئًا بِشَكْلٍ مُحَبَّب)",
 "chubut": "تْشُوبُوت",
 "chuck": "ظرف (جهاز تثبيت يتكون من فكوك قابلة للتعديل تقوم بمركزة قطعة العمل في مخرطة أو مركزة أداة في مثقاب) / أكل, طعام (مصطلحات غير رسمية تعني وجبة أو طعام) / تشاك, لحم الرقبة والكتف (الجزء من الربع الأمامي الممتد من الرقبة إلى الضلوع ويشمل لوح الكتف)",
 "chuck short ribs": "ضلوع قصيرة من الكتف (تقع بين منطقة التشاك (الكتف) والبريسكت (الصدر))",
 "chuck wagon": "عربة المؤن (عربة مجهزة بموقد طهي ومؤن (لرعاة البقر))",
 "chuck-full": "مَحْشُوّ, مَكْدُوس (مَمْلُوء عَنْ آخِرِه حَتَّى السَّعَة القُصْوَى)",
 "chuck-will's-widow": "تشك ويلز ويدو (طائر كبير يشبه السبد الصياح من جنوب الولايات المتحدة)",
 "chucker-out": "حارِس أَمْن, طارِد المُشاغِبِين (شخص وظيفته إخراج مثيري الشغب من حانة أو اجتماع عام)",
 "chuckhole": "حفرة طريق, حفرة وعائية (حفرة أو ثقب ناتج عن التآكل أو العوامل الجوية (خاصة في سطح الطريق))",
 "chuckle": "إِهْلَاس",
 "chuckwalla": "تشاكوالا (سحلية آكلة للأعشاب تعيش بين الصخور في المناطق القاحلة من جنوب غرب الولايات المتحدة والمكسيك)",
 "chuddar": "شادور (قطعة قماش تستخدم كغطاء للرأس (وحجاب وشال) من قبل النساء المسلمات والهندوسيات)",
 "chufa": "حَبّ الْعَزِيز, حَبّ الزَلَم (الزرع، كبيرا كان أم صغيرا؛ بَذْرُ الزرع)\nمثال: زيري بحب المال.",
 "chuffed": "فَرِح جِدًّا, مُبْتَهِج (مسرور للغاية)",
 "chug": "طقطقة المحرك (الضجيج الانفجاري المكتوم الصادر عن محرك)",
 "chukar": "قَبَج, قَبْج (القَبْجُ: الحَجَلُ؛ القَبْجُ:(لسان العرب) الكَرَوانُ، معرَّب، وهو بالفارسية كبْجْ؛ معرّب لأَن القاف والجيم لا يجتمعان في كلمة واحدة من كلام العرب…)",
 "chukchi": "لغة تشوكشي (لغة أصلية ومعزولة مجهولة الأصل يتحدث بها شعب تشوكشي، وتختلف طريقة نطقها بين الرجال والنساء) / تشوكشي (عضو في شعب أصلي يعيش في شبه جزيرة تشوكشي)",
 "chukchi language": "لغة تشوكشي (لغة أصلية ومعزولة مجهولة الأصل يتحدث بها شعب تشوكشي، وتختلف طريقة نطقها بين الرجال والنساء)",
 "chukchi sea": "بَحْر تْشُوكُشِي (شَقّ الأرض؛ التَحَيُّر والبَهْت من الفزع أو من شدة العَطَش فنظر لا يقصد شيئا)\nمثال: هبطت على البحر.",
 "chukka": "حذاء تشوكا (حذاء يصل للكاحل ويربط من خلال زوجين أو ثلاثة من الثقوب؛ غالباً مصنوع من الجلد المقلوب) / شوط ((بولو) واحد من ستة أقسام تنقسم إليها مباراة البولو)",
 "chukka boot": "حذاء تشوكا (حذاء يصل للكاحل ويربط من خلال زوجين أو ثلاثة من الثقوب؛ غالباً مصنوع من الجلد المقلوب)",
 "chukker": "شوط ((بولو) واحد من ستة أقسام تنقسم إليها مباراة البولو)",
 "chukker-brown": "بُنِّيّ رَمَادِيّ مُصْفَرّ (بلون بني رمادي إلى بني مصفر كلون السَّعُوط)",
 "chukotka": "تْشُوكُوتْكَا",
 "chum": "سلمون الكيتا (سلمون كبير من المحيط الهادئ ذو بقع صغيرة على ظهره؛ سمكة طعام مهمة) / زفرة, طعم سمك (طعم يتكون من سمك مقطع وزيوت سمك يتم إلقاؤها في البحر لجذب الأسماك) / رفيق, زميل (صديق مقرب يرافق رفاقه في أنشطتهم)",
 "chum salmon": "سلمون الكيتا (سلمون كبير من المحيط الهادئ ذو بقع صغيرة على ظهره؛ سمكة طعام مهمة)",
 "chumminess": "ألفة, زمالة (صفة إتاحة الألفة والاجتماعية السهلة)",
 "chummy": "صَدِيق حَمِيم ((غير رسمي) مرتبط بعلاقة وثيقة) / حَمِيم, صَدِيق حَمِيم ((غَيْر رَسْمِيّ) لَهُ عَلَاقَة صَدَاقَة أَوْ رِفَاقَة)",
 "chump": "أبله, ساذج (شخص ساذج وسهل الاستغلال)",
 "chump change": "فكة, مبلغ زهيد (مبلغ تافه من المال)",
 "chunga": "تشونغا (كارياما أرجنتينية)",
 "chunga burmeisteri": "تشونغا (كارياما أرجنتينية)",
 "chunk": "تكتل, كتلة (كتلة متماسكة) / جزء كبير, قدر كبير (كمية كبيرة)\nمثال: أصابته كرة من الطين في كتفه",
 "chunking": "تجميع الوحدات, تقسيم ((علم النفس) تشكيل وحدات أصغر من المعلومات في وحدات منسقة كبيرة)",
 "chunky": "مُتَعَقِّد, مُتَكَتِّل (يشبه الكتل اللزجة الصغيرة أو يحتوي عليها) / قَصِير مُمْتَلِئ, مُكَتَّل (قصير وسمين؛ ذو ساقين قصيرتين وعضلات ثقيلة)",
 "chunky heel": "كعب ضخم, كعب عريض (نوع من الكعب العريض الذي يكون عادة مربعاً؛ ويأتي بارتفاعات مختلفة)\nمثال: ستمنحك الأحذية ذات الكعوب العريضة بضع بوصات إضافية مع الحفاظ على الراحة",
 "chupacabras": "تشوباكابرا",
 "church": "كَنِيسَة, كَنَائِس (محلّ العبادة عند المسيحيين؛ جماعة المؤمنين بدين المسيح)\nمثال: أين أقرب كنيسة ؟",
 "church bell": "جرس الكنيسة (جرس في برج الكنيسة (يُدق عادةً لدعوة الناس إلى الكنيسة))\nمثال: كانت أجراس الكنيسة تقرع في جميع أنحاء المدينة",
 "church bench": "مقعد الكنيسة (مقعد طويل ذو ظهر؛ يستخدم في الكنيسة من قبل المصلين)",
 "church building": "كنيسة, مبنى الكنيسة (مكان للعبادة العامة (وخاصة المسيحية))\nمثال: كانت الكنيسة فارغة",
 "church calendar": "تقويم كنسي (تقويم للسنة المسيحية يشير إلى تواريخ الصيام والأعياد)",
 "church council": "مَجْمَع (اسم مفعول من جَمَّعَ؛ كُلِّيَّة، جَامِعَة)\nمثال: كان سامي يعيش في مجمع مسور.",
 "church doctrine": "تعاليم الكنيسة, عقيدة دينية (مجموع التعاليم المكتوبة لمجموعة دينية والمقبولة عموماً من قبل تلك المجموعة)",
 "church father": "أب الكنيسة ((في المسيحية) أي من حوالي 70 لاهوتياً في الفترة من القرن الثاني إلى السابع أسست كتاباتهم العقيدة الرسمية للكنيسة وأكدتها)",
 "church festival": "احتفال كنسي, عيد ديني (مهرجان ذو أهمية دينية)",
 "church hat": "قبعة الكنيسة (قبعة خيالية من النوع الذي ترتديه النساء السود للعبادة يوم الأحد)",
 "church key": "فتاحة علب (مفتاح الكنيسة) (فتاحة علب ذات طرف مثلث مدبب يثقب أغطية العلب)",
 "church member": "مواظب على الكنيسة (شخص متدين يذهب إلى الكنيسة بانتظام)",
 "church mode": "مقام كنسي (أي من نظام المقامات المستخدمة في التراتيل الغريغورية حتى عام 1600؛ مشتق تاريخياً من المقام اليوناني)",
 "church music": "موسيقى دينية, موسيقى كنسية (نوع من الموسيقى المؤلفة للأداء كجزء من الاحتفالات الدينية)",
 "church of christ scientist": "العلم المسيحي, كنيسة المسيح العالم (طائفة بروتستانتية أسستها ماري بيكر إيدي عام 1866)",
 "church of england": "كَنِيسَة إِنْجِلْتِرَا (محلّ العبادة عند المسيحيين؛ جماعة المؤمنين بدين المسيح)\nمثال: أين أقرب كنيسة ؟",
 "church of ireland": "كنيسة أيرلندا (فرع مستقل من كنيسة إنجلترا في أيرلندا)",
 "church of jesus christ of latter-day saints": "كنيسة المورمون, كنيسة يسوع المسيح لقديسي الأيام الأخيرة (كنيسة أسسها جوزيف سميث عام 1830 ومقرها الرئيسي في سولت ليك سيتي، يوتا)",
 "church of rome": "الكاثوليكية الرومانية, الكنيسة الرومانية الكاثوليكية (الكنيسة المسيحية التي مقرها الفاتيكان ويرأسها البابا وتسلسل هرمي أسقفي)",
 "church of scientology": "السيانتولوجيا, كنيسة السيانتولوجيا (دين جديد أسسه ل. رون هوبارد في عام 1955 ويتميز بالإيمان بقدرة روح الشخص على تنقية نفسها من التجارب المؤلمة الماضية من خلال معرفة الذات والوفاء الروحي)",
 "church of scotland": "كَنِيسَة إِسْكُتْلَنْدَا (محلّ العبادة عند المسيحيين؛ جماعة المؤمنين بدين المسيح)\nمثال: أين أقرب كنيسة ؟",
 "church of the brethren": "كنيسة الإخوة (طائفة معمدانية أسسها أمريكيون من أصل ألماني عام 1708؛ عارضت الخدمة العسكرية وأداء القسم القانوني؛ مارست المعمودية الثلاثية بالتغطيس)",
 "church officer": "مسؤول كنسي (مسؤول في الكنيسة)",
 "church property": "ممتلكات كنسية (ممتلكات أو دخل تملكه الكنيسة)",
 "church roll": "سجل الرعية (قائمة بأعضاء الكنيسة)",
 "church school": "مدرسة أبرشية, مدرسة كنسية (مدرسة دينية خاصة تديرها كنيسة أو أبرشية)",
 "church service": "خدمة الكنيسة, صلاة الكنيسة (خدمة تقام في دار عبادة)\nمثال: لا تتأخر عن الكنيسة",
 "church slavic": "البلغارية القديمة, سلافونية الكنيسة القديمة (اللغة السلافية التي تُرجمت إليها الكتاب المقدس في القرن التاسع)",
 "church slavic language": "البلغارية القديمة, سلافونية الكنيسة القديمة (اللغة السلافية التي تُرجمت إليها الكتاب المقدس في القرن التاسع)",
 "church tower": "برج الكنيسة (البرج الخاص بالكنيسة)",
 "church year": "سنة كنسية, سنة مسيحية (السنة في التقويم الكنسي؛ خاصة أيام الأعياد والمواسم الخاصة)",
 "church-state": "دولة دينية (دولة تحكمها سلطة دينية)",
 "churchgoer": "مواظب على الكنيسة (شخص متدين يذهب إلى الكنيسة بانتظام)",
 "churchgoing": "مُلْتَزِم بِالكَنِيسَة, مُوَاظِب عَلَى العِبَادَة (يُمارِس الشعائر الدينيّة بانتظام)",
 "churchill": "تْشَرْشِل",
 "churchillian": "تشرشلي (من أو متعلق بـ أو يوحي بونستون تشرشل)",
 "churchly": "كَنَسِيّ (يُشبه الكنيسة أو يوحي بها أو يليق بها)",
 "churchman": "رجل دين (رجل دين ذكر أو شخص آخر في سلك الكهنوت)",
 "churchwarden": "وكيل كنيسة (ضابط في الكنيسة الأسقفية يساعد كاهن الأبرشية في الأمور العلمانية)",
 "churchwoman": "امرأة دين (امرأة دين أنثى أو شخص آخر في سلك الكهنوت)",
 "churchyard": "فناء الكنيسة (الساحة المرتبطة بالكنيسة)",
 "churidars": "تشوريدار (سراويل ضيقة يرتديها الناس من شبه القارة الهندية (عادة مع قميص هندي أو كورتا))",
 "churl": "سيء المزاج, عبوس (شخص سيء الطباع) / بخيل, شحيح (شخص أناني غير راغب في العطاء أو الإنفاق) / عديم التربية, فظ (شخص فظ غير مهذب يفتقر للثقافة أو الرقي)",
 "churlish": "جِلْف, غَلِيظ (سيء الخُلق وعابس؛ فظ الطبع) / جِلْف, فَظّ (وقح وعديم الذوق والتهذيب)",
 "churlishly": "بِفَظَاظَة (بطريقة فظة)\nمثال: عامل صاحب المتجر زبائنه بفظاظة",
 "churn": "مَخَاضَة",
 "churned-up": "مُتَخَضْخِض, مُخَضْخَض (يتحرك مع أو يُنتج أو ينتج عن تحريك عنيف)",
 "churning": "مُتَلَاطِم, مُضْطَرِب ((لسائل) مُحرَّك بعنف؛ في حالة اضطراب وتلاطم) / مُتَخَضْخِض, مُخَضْخَض (يتحرك مع أو يُنتج أو ينتج عن تحريك عنيف)",
 "churrigueresco": "بَارُوكِيّ (ذو زخرفة متناظرة ومتقنة على الطراز الباروكيّ)",
 "churrigueresque": "بَارُوكِيّ (ذو زخرفة متناظرة ومتقنة على الطراز الباروكيّ)",
 "chute": "مجرى مائل, مزلقة (قناة مائلة يمكن للأشياء أن تنحدر عبرها) / مظلة (معدات إنقاذ تتكون من جهاز يمتلئ بالهواء ويبطئ سقوطك)",
 "chute-the-chute": "أفعوانية (سكة حديدية مرتفعة في مدينة ملاهي (عادة بمنحنيات حادة ومنحدرات شديدة))",
 "chutney": "تْشَاتْنِي",
 "chutzpa": "جرأة وقحة ((اليديشية) وقاحة لا تصدق؛ صفاقة؛ جرأة)",
 "chutzpah": "جرأة وقحة ((اليديشية) وقاحة لا تصدق؛ صفاقة؛ جرأة)",
 "chutzpanik": "جَرِيء, وَقِح (شخص يتسم بالجرأة الزائدة أو الوقاحة)",
 "chuvash": "التشوفاش (اللغة التركية التي يتحدث بها التشوفاش) / تشوفاشي (عضو في شعب يتحدث التركية ويعيش في منطقة الفولغا في شرق روسيا)",
 "chuvash language": "التشوفاش (اللغة التركية التي يتحدث بها التشوفاش)",
 "chylaceous": "كيلوسي, لبي (يتكون من الكيلوس أو له خصائصه)",
 "chyle": "كيلوس (سائل حليبي يتكون من اللمف والدهون المستحلبة؛ يتكون في الأمعاء الدقيقة أثناء هضم الدهون المبتلعة)",
 "chylifactive": "مكون للكيلوس (ينتج الكيلوس أو يتحول إليه)",
 "chylifactory": "مكون للكيلوس (ينتج الكيلوس أو يتحول إليه)",
 "chyliferous": "ناقل للكيلوس (ينقل الكيلوس)\nمثال: أوعية ناقلة للكيلوس",
 "chylific": "مكون للكيلوس (ينتج الكيلوس أو يتحول إليه)",
 "chyloderma": "داء الفيل الصفني (تورم كيس الصفن الناتج عن انسداد لمفاوي مزمن)",
 "chylomicron": "دقائق الكيلوس, كيلومكرون (جسيم مجهري من الدهون الثلاثية ينتج في الأمعاء أثناء الهضم؛ في مجرى الدم يطلق أحماضه الدهنية في الدم)",
 "chylous": "كيلوسي, لبي (يتكون من الكيلوس أو له خصائصه)",
 "chyme": "كَيْمُوس",
 "chymosin": "رينين (إنزيم يحدث في العصارة المعدية؛ يسبب تخثر الحليب)",
 "châteauroux": "شَاتُورُو",
 "ci": "مِئَة وَوَاحِد (يَدُلُّ عَلَى العَدَد 101) / كوري (وحدة للنشاط الإشعاعي تساوي كمية النظير المشع الذي يتحلل بمعدل 37 مليار تفكك في الثانية)",
 "cia": "سِي أَي إِي",
 "cialis": "تادالافيل, سياليس (عقار للفحولة (الاسم التجاري سياليس) يستخدم لعلاج ضعف الانتصاب لدى الرجال)",
 "ciao": "تْشَاو",
 "cibotium barometz": "خروف سكيثيا, سيبوتيوم باروميتز (سرخس شجري آسيوي ذو شعر كثيف متشابك يستخدم أحياناً كمادة قابضة)",
 "cicada": "زِيز",
 "cicada killer": "قاتل الزيز (دبور كبير أسود أو بلون الصدأ يفترس الزيز)",
 "cicala": "زيز, صرار (حشرة قوية الجسم ذات أجنحة غشائية كبيرة؛ للذكر أعضاء تشبه الطبل لإصدار طنين عالي النبرة)",
 "cicatrice": "ندبة (علامة تترك (عادة على الجلد) بسبب شفاء الأنسجة المصابة)",
 "cicatrix": "ندبة (علامة تترك (عادة على الجلد) بسبب شفاء الأنسجة المصابة)",
 "cicer arietinum": "حمص, نبات الحمص (عشبة آسيوية تزرع لقرونها القصيرة التي تحتوي على بذرة أو بذرتين صالحتين للأكل)",
 "cicero": "شِيشِرُون",
 "cicerone": "دليل سياحي, شيشرون (مرشد يرافق السياح ويقدم لهم المعلومات)",
 "ciceronianism": "الأسلوب الشيشيروني, شيشيرونية (تقليد أو التشبه بالأسلوب الخطابي أو الأدبي لشيشرون)",
 "cichlid": "بلطي (أسماك مياه عذبة في أمريكا الاستوائية وأفريقيا وآسيا تشبه أسماك الشمس الأمريكية؛ بعضها أسماك غذائية؛ والعديد من الصغار منها شائعة في أحواض السمك)",
 "cichlid fish": "بلطي (أسماك مياه عذبة في أمريكا الاستوائية وأفريقيا وآسيا تشبه أسماك الشمس الأمريكية؛ بعضها أسماك غذائية؛ والعديد من الصغار منها شائعة في أحواض السمك)",
 "cichorium endivia": "إنديف, هندباء (عشب مزروع على نطاق واسع بأوراق ذات قيمة كخضروات للسلطة؛ إما أوراق مسننة مجعدة أو عريضة مسطحة يتم تبييضها عادة)",
 "cichorium intybus": "سريس, شيكوريا (عشب معمر من العالم القديم له رؤوس زهرية شعاعية ذات زهور زرقاء، يزرع لجذره ورؤوس أوراقه الهشة الصالحة للأكل المستخدمة في السلطات)",
 "ciconia ciconia": "لقلق أبيض (اللقلق الشائع في أوروبا؛ أبيض بريش أجنحة أسود ومنقار أحمر)",
 "ciconia nigra": "لقلق أسود (لقلق من العالم القديم أسود لامع من الأعلى وأبيض من الأسفل)",
 "cicuta virosa": "شوكران مائي (عشب معمر أوراسي طويل وقائم شديد السمية يتوافر بكثرة محلياً في المناطق المستنقعية)",
 "cid": "قيادة التحقيقات الجنائية للجيش الأمريكي (وكالة إنفاذ القانون الرئيسية للجيش الأمريكي المسؤولة عن إجراء التحقيقات الجنائية لجميع مستويات الجيش في أي مكان في العالم)",
 "cider": "سِيدَر",
 "cider gum": "صمغ السيدر (شجرة صغيرة إلى متوسطة الحجم من تسمانيا)",
 "cider mill": "معصرة تفاح (معصرة تستخرج العصير من التفاح لصنع عصير التفاح)",
 "cider vinegar": "خل التفاح (خل مصنوع من عصير التفاح)",
 "ciderpress": "معصرة التفاح (مكبس يستخدم لاستخراج العصير من التفاح)",
 "cigar": "سِيجَار, سِيكَار",
 "cigar band": "شريط السيجار (شريط ورقي ضيق حول السيجار)",
 "cigar box": "علبة سيجار (صندوق لحفظ السيجار)",
 "cigar butt": "عقب سيجار (جزء صغير من السيجار يتبقى بعد التدخين)",
 "cigar cutter": "قاطع السيجار (أداة لقطع طرف السيجار)",
 "cigar lighter": "قداحة, ولاعة سجائر (ولاعة للسيجار أو السجائر)",
 "cigar smoker": "مدخن سيجار (شخص يدخن السيجار)",
 "cigar-box cedar": "أرز صناديق السيجار (خشب عطري يستخدم كثيراً لصناديق السيجار)",
 "cigar-shaped": "سِيجَارِيّ الشَّكْل, مِغْزَلِيّ (مستدق من كلا الطرفين)",
 "cigaret": "سيجارة (تبغ مطحون ناعماً ملفوف في ورق؛ للتدخين)",
 "cigarette": "سِيجَارَة (منتج مصنوع من أوراق التبغ، تلف أو تحشى بداخل غلاف ورقي على شكل أسطوانة لغرض التدخين)\nمثال: دخن زيري سيجارة.",
 "cigarette burn": "حرق سيجارة (أثر حرق تركته سيجارة مشتعلة)\nمثال: حرق سيجارة على حافة الطاولة",
 "cigarette butt": "عقب سيجارة (جزء صغير من السيجارة يتبقى بعد التدخين)",
 "cigarette case": "عُلْبَةُ سَجَائِر",
 "cigarette holder": "حامل السجائر (أنبوب يحمل السيجارة أثناء تدخينها)",
 "cigarette lighter": "قداحة, ولاعة سجائر (ولاعة للسيجار أو السجائر)",
 "cigarette paper": "ورق لف السجائر (ورق رقيق قوي يحترق بالتساوي ويكون مسامياً بما يكفي للتحكم في احتراق التبغ في السيجارة)",
 "cigarette smoker": "مدخن سجائر (شخص يدخن السجائر)",
 "cigarfish": "سكاد مستدير, سمكة السيجار (سمكة مغزلية صغيرة في غرب المحيط الأطلسي)",
 "cigarillo": "سيجاريلو (سيجار صغير أو سيجارة ملفوفة بالتبغ بدلاً من الورق)",
 "cilantro": "كُزْبَرَة",
 "cilial": "هدبي (متعلق بالأهداب البارزة من سطح الخلية)",
 "ciliary": "هدبي (متعلق بالرموش البشرية) / هدبي (متعلق بالأهداب البارزة من سطح الخلية) / هدبي (متعلق بالجسم الهدبي والهياكل المرتبطة به في العين)",
 "ciliary artery": "شريان هدبي (واحد من عدة شرايين تغذي الغلاف المشيمي للعين)",
 "ciliary body": "جسم هدبي (جزء من غلالة العين يقع بين المشيمية والقزحية)\nمثال: ينتج الجسم الهدبي الخلط المائي",
 "ciliary veins": "أوردة هدبية (أوردة صغيرة قادمة من الجسم الهدبي)",
 "ciliate": "أوالي هدبية, هدبيات (أوالي له زوائد مجهرية تمتد من سطح الخلية) / ذُو أَهْدَاب, مُهَدَّب (ذو حافة أو هُدب من نتوءات شعريّة دقيقة) / هدبي (متعلق بالرموش البشرية) / هدبي (متعلق بالأهداب البارزة من سطح الخلية)",
 "ciliated": "ذُو أَهْدَاب, مُهَدَّب (ذو حافة أو هُدب من نتوءات شعريّة دقيقة)",
 "ciliated protozoan": "أوالي هدبية, هدبيات (أوالي له زوائد مجهرية تمتد من سطح الخلية)",
 "ciliophoran": "أوالي هدبية, هدبيات (أوالي له زوائد مجهرية تمتد من سطح الخلية)",
 "cilium": "هدب (نتوء يشبه الشعر من سطح الخلية؛ يوفر الحركة في الكائنات وحيدة الخلية حرة السباحة) / رِمْش, هُدْب (أي من الشعيرات القصيرة المنحنية التي تنمو من حواف الجفون)",
 "cim": "آلية الاستخبارات المركزية (الوحدة المركزية في المملكة المتحدة لتكليف وتنسيق وتمويل وكالات الاستخبارات والأمن)",
 "cimarron": "الضأن كبير القرون, كباش الجبال الصخرية (خروف بري في المناطق الجبلية بغرب أمريكا الشمالية له قرون ضخمة ملتوية)",
 "cimetidine": "تاغاميت, سيميتيدين (دواء (الاسم التجاري تاغاميت) يستخدم لعلاج القرحة الهضمية عن طريق تقليل إفراز حمض المعدة)",
 "cimex lectularius": "بق الفراش (بق المناطق المعتدلة الذي يغزو الأسرة بشكل خاص ويتغذى على دم الإنسان)",
 "cimicifuga americana": "بق توت أمريكي, كوهوش صيفي (نبات البق توت من شرق الولايات المتحدة ذو عناقيد منتصبة من الزهور البيضاء)",
 "cimicifuga foetida": "بق توت نتن (نبات البق توت من سيبيريا وشرق آسيا ذو أزهار خضراء بيضاء كريهة الرائحة)",
 "cimicifuga racemosa": "جذر الثعبان الأسود, كوهوش أسود (نبات البق توت من أمريكا الشمالية يوجد من ماين وأونتاريو إلى ويسكونسن وجنوباً إلى جورجيا)",
 "cimmerian": "دَائِم الظَّلَام, سِمِّيرِيّ (شَدِيد الظُّلْمَة والكَآبَة كَأَنَّ الظَّلَام أَبَدِيّ)",
 "cinch": "سينش (شكل من أشكال لعبة أول فورز يزايد فيه اللاعبون لامتياز تسمية الأوراق الرابحة) / أمر سهل, لعب أطفال (أي مشروع يسهل القيام به) / حزام البطن, حزام السرج (معدات اسطبل تتكون من حزام حول بطن الحصان يثبت السرج في مكانه)\nمثال: تسويق هذا المنتج لن يكون نزهة",
 "cinchona": "كنكينا (أي من الأشجار المتعددة من جنس كنكينا) / كِينَا, لِحَاء الكِينَا (لحاء طبي لأشجار الكينا؛ مصدر للكينين والكينيدين)",
 "cinchona bark": "كِينَا, لِحَاء الكِينَا (لحاء طبي لأشجار الكينا؛ مصدر للكينين والكينيدين)",
 "cinchona calisaya": "كاليسايا, كينا كاليسايا (شجيرة أو شجرة صغيرة من بيرو لها أوراق لامعة كبيرة وسيمات من الزهور الصفراء إلى الخضراء أو الحمراء العطرة؛ تزرع للحائها الطبي)",
 "cinchona cordifolia": "كينا قرطاجنة, لحاء قرطاجنة (شجرة كولومبية؛ مصدر للحاء قرطاجنة (نوع من لحاء الكينا))",
 "cinchona lancifolia": "كينا قرطاجنة, لحاء قرطاجنة (شجرة كولومبية؛ مصدر للحاء قرطاجنة (نوع من لحاء الكينا))",
 "cinchona ledgeriana": "كاليسايا, كينا كاليسايا (شجيرة أو شجرة صغيرة من بيرو لها أوراق لامعة كبيرة وسيمات من الزهور الصفراء إلى الخضراء أو الحمراء العطرة؛ تزرع للحائها الطبي)",
 "cinchona officinalis": "كاليسايا, كينا كاليسايا (شجيرة أو شجرة صغيرة من بيرو لها أوراق لامعة كبيرة وسيمات من الزهور الصفراء إلى الخضراء أو الحمراء العطرة؛ تزرع للحائها الطبي)",
 "cinchona pubescens": "شجرة الكينا (شجرة صغيرة من الإكوادور وبيرو لها أوراق لامعة كبيرة جداً وعناقيد كبيرة من الزهور الوردية العطرة؛ تزرع للحائها الطبي)",
 "cinchona tree": "شجرة الكينا (شجرة صغيرة من الإكوادور وبيرو لها أوراق لامعة كبيرة جداً وعناقيد كبيرة من الزهور الوردية العطرة؛ تزرع للحائها الطبي)",
 "cinchonine": "سينكونين (قلويد مشتق من لحاء أشجار الكينا يستخدم كدواء مضاد للملاريا)",
 "cincinnati": "سينسيناتي",
 "cinclus aquaticus": "دج الماء الأوروبي (دج ماء من أوروبا)",
 "cinclus mexicanus": "دج الماء الأمريكي (دج ماء من غرب أمريكا الشمالية)",
 "cinco de mayo": "سينكو دي مايو (الخامس من مايو الذي يحتفل به في المكسيك والمجتمعات المكسيكية الأمريكية في الولايات المتحدة لإحياء ذكرى النصر المكسيكي على الفرنسيين في معركة بويبلا…)",
 "cincture": "حزام, زنار (شريط من مادة حول الخصر يقوي التنورة أو البنطال)",
 "cinder": "جَمْرُ مُنْطَفِيّ ((جمر) الْفرس جمرا وثب فِي الْقَيْد وَفُلَانًا أعطَاهُ جمرا ونحاه؛ جَمَرَ: الجَمْر: النَّارُ الْمُتَّقِدَةُ، وَاحِدَتُهُ جَمْرَةٌ. فإِذا بَرَدَ فَهُوَ فَحْمٌ)\nمثال: أنا أنتظر قرارك على أحر من الجمر.",
 "cinder block": "طوب خرساني (كتلة بناء خرسانية خفيفة مصنوعة من ركام الخبث)\nمثال: يطلق على الطوب الخرساني اسم \"قوالب النسيم\" في بريطانيا",
 "cinder pig": "حديد غفل خبثي (حديد غفل يحتوي على نسبة كبيرة من الخبث)",
 "cinder track": "مضمار رماد (مضمار سباق مرصوف بالرماد الناعم)",
 "cinderella": "سِنْدِرِيلَا",
 "cine projector": "جهاز عرض أفلام, سينما بروجيكتور (يعرض إطارات متتالية من بكرة فيلم لإنشاء صور متحركة)",
 "cine-camera": "كاميرا سينمائية (كاميرا تلتقط سلسلة من الصور الفوتوغرافية التي يمكن أن تعطي وهم الحركة عند عرضها بتتابع سريع)",
 "cine-film": "فيلم سينمائي (فيلم فوتوغرافي طوله عدة مئات من الأقدام وملفوف على بكرة؛ لاستخدامه في كاميرا سينمائية)",
 "cinema": "سِينَمَا (مصطلح يشير إلى التصوير المتحرك الذي يعرض للجمهور و يعتبر التصوير السينمائي من توابعه التمثيل و الإخراج و الإنتاج و كل مايتعلق بذلك و يعتبر من الفنون…؛ فن إنتاج و إخراج الأفلام التي تعرض على الشاشة التلفاز أمام المشاهدين و يطلق عليه الفن السابع أو التصوير السينمائي)\nمثال: كان في السينما.",
 "cinema verite": "سينما الواقع (فيلم يظهر أشخاصاً عاديين في أنشطة حقيقية دون أن يتحكم بهم مخرج)",
 "cinematic": "سِينَمَائِيّ (ما يتعلق بالسَّينِمَا)\nمثال: أنشؤوا جمعية سينمائية.",
 "cinematographer": "مشغل كاميرا, مصور سينمائي (مصور يشغل كاميرا سينمائية)",
 "cinematographic": "سِينَمَائِيّ (ما يتعلق بالسَّينِمَا)\nمثال: أنشؤوا جمعية سينمائية.",
 "cinematography": "تَصْوِير سِينَمَائِيّ",
 "cineraria": "سينراريا (عشب من جزر الكناري يُزرع على نطاق واسع لزهوره الزرقاء أو الأرجوانية أو الحمراء أو المتنوعة التي تشبه الأقحوان)",
 "cineraria maritima": "سينراريا فضية, طاحونة مغبرة (نبات معمر صلب كثير التفرع من منطقة البحر الأبيض المتوسط ذو سيقان وأوراق صوفية بيضاء جداً)",
 "cinerarium": "كوة الجرة, مشكاة رماد الموتى (كوة لجرة جنائزية تحتوي على رماد الموتى المحروقين)",
 "cinerary": "رمادي (يحتوي على أو يستخدم لرماد الموتى المحروقين)\nمثال: جرة رماد الموتى",
 "cingulate gyrus": "تلفيف حزامي (بنية منحنية طويلة على السطح الإنسي لنصفي الكرة المخية؛ الجزء القشري من الجهاز الحوفي)",
 "cingulum": "حِزَام, طَوْق ((في التشريح) بنية مطوّقة (مثل الحافة حول قاعدة السن))",
 "cinnabar": "زِنْجَفْر",
 "cinnabar chanterelle": "شانتريل قرمزي (فطر بجسم ثمري مميز لونه وردي إلى قرمزي)",
 "cinnabar moth": "عثة الزنجفر (عثة أوروبية كبيرة حمراء وسوداء؛ تتغذى اليرقات على أوراق عشبة الشيخ؛ أُدخلت إلى الولايات المتحدة للسيطرة على عشبة الشيخ)",
 "cinnamene": "ستايرين, فينيل بنزين (سائل زيتي عديم اللون؛ هو المونومر للبوليسترين)",
 "cinnamomum camphora": "شجرة الكافور (شجرة كبيرة دائمة الخضرة في المناطق الدافئة ينتج خشبها العطري الكافور)",
 "cinnamomum cassia": "قرفة صينية, كاسيا (شجرة صينية ذات لحاء عطري؛ تنتج قرفة أقل جودة من القرفة السيلانية)",
 "cinnamomum loureirii": "قرفة سايغون (شجرة استوائية في جنوب شرق آسيا ذات لحاء عطري؛ تنتج لحاء يستخدم طبياً)",
 "cinnamomum zeylanicum": "قرفة, قرفة سيلانية (شجرة آسيوية استوائية ذات لحاء بني مصفر عطري؛ مصدر توابل القرفة)",
 "cinnamon": "قِرْفَة",
 "cinnamon bark": "قِرْفَة (لحاء عطري يستخدم كأحد التوابل) / قِرْفَة سَايْغُون (اللحاء العطري لقرفة سايغون يستخدم طبياً كطارد للغازات)",
 "cinnamon bear": "دب القرفة (مرحلة لونية بنية محمرة للدب الأسود الأمريكي)",
 "cinnamon bread": "خبز القرفة (خبز منكه بالقرفة ويحتوي غالباً على الزبيب)",
 "cinnamon bun": "سينابون, لفافة القرفة (عجين ملفوف مدهون بالقرفة والسكر (والزبيب) ثم يقطع شرائح قبل الخبز)",
 "cinnamon fern": "أسمندة قرفية, سرخس القرفة (سرخس من العالم الجديد ذو سعف صوفي بلون القرفة يحمل الأبواغ في أوائل الربيع محاطاً لاحقاً بسعف أخضر؛ السعف المبكر غير الملتف صالح للأكل)",
 "cinnamon roll": "سينابون, لفافة القرفة (عجين ملفوف مدهون بالقرفة والسكر (والزبيب) ثم يقطع شرائح قبل الخبز)",
 "cinnamon snail": "سينابون, لفافة القرفة (عجين ملفوف مدهون بالقرفة والسكر (والزبيب) ثم يقطع شرائح قبل الخبز)",
 "cinnamon stone": "حجر القرفة, هيسونيت (عقيق يتراوح لونه من الأصفر إلى البني)",
 "cinnamon toast": "توست القرفة (توست بالزبدة مع السكر والقرفة (وجوزة الطيب وقشر الليمون المبشور))",
 "cinnamon vine": "كرمة القرفة, يام صيني (كرمة صينية قوية التحمل متوطنة في الولايات المتحدة وتزرع كمتسلقة زينة لأوراقها اللامعة على شكل قلب برائحة القرفة وفي المناطق الاستوائية لدرناتها…)",
 "cinnamon-colored": "قِرْفِيّ اللَّوْن (بلون القرفة)",
 "cinnamon-coloured": "قِرْفِيّ اللَّوْن (بلون القرفة)",
 "cinnamon-red": "أَحْمَر قِرْفِيّ (أحمر مع مسحة قرفية)",
 "cinnamon-scented": "بِرَائِحَةِ القِرْفَة (ذُو رَائِحَة القِرْفَة)",
 "cinque": "خَمْسَة, خُمَاسِيّ (العدد الأصلي الذي هو مجموع أربعة وواحد)",
 "cinquefoil": "زخرفة خماسية الفصوص (نحت زخرفي يتكون من خمسة أقواس مرتبة في دائرة) / حشيشة الخمس ورقات, عشبة القوى (أي من النباتات العديدة التي تزرع لزهورها خماسية البتلات؛ وفيرة في المناطق المعتدلة؛ ويزعم أن لها خصائص طبية)",
 "cio": "مؤتمر المنظمات الصناعية (اتحاد للنقابات الصناعية في أمريكا الشمالية اندمج مع الاتحاد الأمريكي للعمل في عام 1955)",
 "cipher": "شِيفْرَة",
 "cipro": "سيبرو, سيبروفلوكساسين (مضاد حيوي فموي (الاسم التجاري سيبرو) يستخدم ضد الالتهابات البكتيرية الخطيرة في الجلد أو الجهاز التنفسي أو المسالك البولية أو العظام أو المفاصل)",
 "ciprofloxacin": "سيبرو, سيبروفلوكساسين (مضاد حيوي فموي (الاسم التجاري سيبرو) يستخدم ضد الالتهابات البكتيرية الخطيرة في الجلد أو الجهاز التنفسي أو المسالك البولية أو العظام أو المفاصل)",
 "circa": "حَوَالِي",
 "circadian": "يوماوي, يومي (من أو يتعلق بالعمليات البيولوجية التي تحدث في فترات زمنية مدتها 24 ساعة)\nمثال: إيقاعات يومية (الساعة البيولوجية)",
 "circadian rhythm": "إيقاع يومي, ساعة بيولوجية (دورة نشاط يومية تلاحظ في العديد من الكائنات الحية)",
 "circaea alpina": "عشبة الساحرة الألبية (صنف ألبي من عشبة الساحرة)",
 "circaea lutetiana": "عشبة الساحرة (زهرة الربيع المسائية الطويلة بزهور غير ملحوظة)",
 "circassian": "شَرْكَسِيّ",
 "circassian language": "الشركسية (لغة قوقازية شمالية يتحدث بها الشركس)",
 "circassian walnut": "جوز إنجليزي, جوز فارسي (جوز أوراسي يقدر لجوزه الكبير الصالح للأكل وخشبه الصلب الغني بالنقوش؛ يزرع على نطاق واسع)",
 "circe": "سيرسي ((الأساطير اليونانية) ساحرة احتجزت أوديسيوس في جزيرتها وحولت رجاله إلى خنازير)",
 "circinate": "حَلَقِيّ, دَائِرِيّ (ذو شكل يشبه الحلقة أو الخاتم)",
 "circis siliquastrum": "زمريق, شجرة يهوذا (شجرة صغيرة من شرق البحر الأبيض المتوسط لها زهور حمراء أرجوانية وفيرة تنمو على الخشب القديم مباشرة من السيقان وتظهر قبل الأوراق: تزرع على نطاق واسع في…)",
 "circle": "دَوَائِر تَحْتَ ٱلْعَيْنَيْن (بمعنى الشكل الذي لا بداية له ولا نهاية بشكل قوس مستمر؛ بمعنى الهيئة أو الجهة الحكومية التي تدير أمرا ما)",
 "circle of curvature": "الدائرة الملاصقة, دائرة التقبيل (الدائرة التي تمس منحنى (على الجانب المقعر) ويكون نصف قطرها هو نصف قطر الانحناء)",
 "circle of willis": "دائرة ويليس (حلقة من الشرايين عند قاعدة الدماغ)",
 "circlet": "إكليل, طوق الرأس (شريط معدني مزخرف يوضع حول الرأس) / حلقة, دائرة صغيرة (دائرة صغيرة)",
 "circuit": "دَارَة (لا جمع له)",
 "circuit board": "بطاقة الدائرة, لوحة الدائرة (دائرة مطبوعة يمكن إدخالها في فتحات التوسعة في الكمبيوتر لزيادة قدراته)",
 "circuit breaker": "قاطع الدائرة, قاطع كهربائي (جهاز يعمل مثل المفتاح ويفتح الدائرة عند التحميل الزائد)",
 "circuit card": "بطاقة الدائرة, لوحة الدائرة (دائرة مطبوعة يمكن إدخالها في فتحات التوسعة في الكمبيوتر لزيادة قدراته)",
 "circuit court of appeals": "محكمة الاستئناف الدائرية (واحدة من محاكم الاستئناف الفيدرالية الاثنتي عشرة في الولايات المتحدة التي تغطي مجموعة من الولايات تعرف بـ 'الدائرة')",
 "circuitous": "غَيْر مُبَاشِر, مُلْتَوٍ (يَنْحَرِف عَنِ المَسَار المُسْتَقِيم) / غَيْر مُبَاشِر, مُلْتَوٍ (يَتَّسِم بِالمُوَارَبَة أَوْ عَدَم المُبَاشَرَة فِي الكَلَام أَوِ السُّلُوك)",
 "circuitousness": "التفاف, دوران (حالة كون الأمر ملتويًا أو غير مباشر)\nمثال: هذا، كما يشير زميلي، يوضح التفاف حجج كرة القدم",
 "circuitry": "الدوائر الكهربائية (معدات إلكترونية تتكون من نظام من الدوائر)",
 "circular": "دَائِرِيّ (المنسوب إلى الدَائِرَة بمعنى الشكل الهندسي، ويقصد به ما كان شكله كالدائرة)\nمثال: التفاحة دائرية الشكل.",
 "circular file": "سلة أوراق, سلة مهملات (حاوية مفتوحة من الأعلى؛ للأوراق المرمية وغيرها من القمامة)",
 "circular function": "دَالَّة دَائِرِيَّة, دَالَّة مُثَلَّثِيَّة (دالة لزاوية معبر عنها كنسبة لطول أضلاع مثلث قائم الزاوية يحتوي على الزاوية)",
 "circular measure": "قياس دائري (قياس الزوايا بالراديان)",
 "circular plane": "مِسْحَج دائري, مِسْحَج فرجاري (مسحج بوجه مرن يمكنه مسح الأسطح المقعرة أو المحدبة)",
 "circular saw": "مِنْشَار دَائِرِيّ",
 "circular-knit": "مَحِيكٌ دَائِرِيًّا (محيك على شكل أنبوبيّ)",
 "circularisation": "توزيع منشورات (توزيع إشعارات مطبوعة كوسيلة للإعلان)",
 "circularity": "دائرية, شكل قرصي (استدارة شكل ثنائي الأبعاد)",
 "circularization": "توزيع منشورات (توزيع إشعارات مطبوعة كوسيلة للإعلان)",
 "circularly": "بِشَكْل دَائِرِيّ (بطريقة دائرية)",
 "circulating decimal": "عَدَد عَشْرِيّ دَوْرِيّ, كَسْر دَوْرِيّ (عدد عشري يتكرر فيه تسلسل الأرقام إلى ما لا نهاية)",
 "circulating library": "مكتبة إعارة (مكتبة توفر الكتب للاستخدام خارج المبنى)",
 "circulation": "انتشار, تداول (انتشار أو نقل شيء ما (كالأخبار أو المال) إلى مجموعة أو منطقة أوسع) / توزيع, نشر (توزيع نسخ من الدوريات (مثل الصحف أو المجلات)) / دوران, سريان (حركة حرة أو مرور (كما في السيتوبلازم داخل الخلية أو النسغ عبر النبات)) / دوران, دورة دموية (الحركة عبر دائرة؛ وخاصة حركة الدم عبر القلب والأوعية الدموية)\nمثال: دوران المحيط جزء مهم من المناخ العالمي",
 "circulative": "دوراني (من أو يتعلق بالدوران)",
 "circulatory": "دوراني, دوري (يتعلق بالجهاز الدوري أو بدورة الدم) / دوراني (من أو يتعلق بالدوران)",
 "circulatory failure": "فشل الدورة الدموية, قصور الدورة الدموية (فشل نظام القلب والأوعية الدموية في إمداد أنسجة الجسم بكميات كافية من الدم)",
 "circulatory system": "جِهَاز اَلدَّوَرَان",
 "circumambulate": "طَافَ",
 "circumboreal": "بُورِيَالِيّ, قُطْبِيّ شَمَالِيّ (يشمل المناطق الشمالية البعيدة أو ينتشر فيها)",
 "circumcise": "خَتَنَ ((خَتَنَ) ختونا وختونة: تزوج والصبي؛ (ختن) ختنا وختانا وختانة: قطع قلفته فهو مختون ويقال ختن الصبية وهو وهي ختين)\nمثال: ختن سامي في سن السادسة من عمره.",
 "circumcision": "خِتَان / طهور",
 "circumduction": "دوران محوري (حركة دائرية لطرف أو للعين)",
 "circumference": "مُحِيط (في : هو الخط المستدير الذي يُحيط بالشكل الهندسي؛ في : البَحْر المُحِيْط هو البحر الكبير الذي يحيط بالقارات. الاستخدام الحديث يحذف كلمة بَحْر؛ القَامُوْس)\nمثال: أسبح في المحيط.",
 "circumferent": "مُحِيط, مُحْدِق (يطوّق بشكل وثيق)",
 "circumferential": "مُحِيطِيّ (يقع حول الحواف أو خارج الأطراف مباشرة)",
 "circumflex": "سيركومفلكس, قبعة (علامة تشكيل (^) توضع فوق حرف متحرك في بعض اللغات للإشارة إلى جودة صوتية خاصة)",
 "circumflex artery": "شريان منعطف (أي من عدة شرايين منحنية مزدوجة)",
 "circumflex artery of the thigh": "شريان الفخذ المنعطف (شريان يغذي مفصل الورك وعضلات الفخذ)",
 "circumflex femoral vein": "وريد فخذي منعطف (أي من وريدين يرافقان شرايين بنفس الاسم تخدم الورك والفخذ)",
 "circumflex humeral artery": "شريان العضد المنعطف (شريان يغذي مفصل الكتف وعضلات الكتف)",
 "circumflex iliac artery": "شريان حرقفي منعطف (شريان يغذي جدران البطن السفلية والجلد وعضلة الخياط)",
 "circumflex iliac vein": "وريد حرقفي منعطف (يرافق الشريان الذي يحمل نفس الاسم)",
 "circumflex scapular artery": "شريان كتفي منعطف (شريان يخدم عضلات الكتف ومنطقة اللوح)",
 "circumflex vein": "وريد منعطف (أي من عدة أوردة متوازية منحنية ترافق شرايين بنفس الاسم)",
 "circumlocution": "إطْنَاب",
 "circumlocutious": "إِطْنَابِيّ, مُسْهِب (مُوَارِب وَمُطْنِب بِلَا دَاعٍ)",
 "circumlocutory": "إِطْنَابِيّ, مُسْهِب (مُوَارِب وَمُطْنِب بِلَا دَاعٍ)",
 "circumnavigation": "طواف حول العالم (السفر حول شيء ما (بالسفينة أو الطائرة))\nمثال: أثبت طواف ماجلان حول الأرض أنها كروية",
 "circumpolar": "مُحِيط بِالقُطْب (يوجد في جميع أنحاء المنطقة القطبية) / قُطْبِيٌّ دَائِم ((عن جِرْم سماوي) يَبْقَى مَرْئِيًّا فَوْقَ الأُفُقِ طَوَالَ دَوْرَانِ 360 دَرَجَة يَوْمِيًّا)",
 "circumscribed": "مَحْدُود, مُقَيَّد (خاضع لحدود أو أُخضِع لها)",
 "circumscription": "تحجيم, تحديد (فعل وضع حدود حول شيء ما)",
 "circumspect": "مُتَحَرِّز, مُتَحَفِّظ (ينتبه للعواقب المحتملة ويتوخّى الحذر)",
 "circumspection": "تبصر, حيطة (سمة كون المرء حذراً وحكيماً) / تحفظ, تكتم (معرفة كيفية تجنب الإحراج أو الضيق)\nمثال: أظهر الخدم لباقة وتكتمًا كبيرين",
 "circumspectly": "بِحَذَر, بِمَكْر (بطريقة حذرة وماكرة)\nمثال: 'لا أعرف بعد'، أجاب بحذر",
 "circumstance": "حَالَة, ظَرْف",
 "circumstances": "أحوال مالية, ظروف مادية (الوضع المالي للشخص (جيداً كان أو سيئاً)) / حظ, قدر (ظروفك العامة أو حالتك في الحياة (بما في ذلك كل ما يحدث لك))\nمثال: وجد نفسه في ظروف مالية صعبة",
 "circumstantial": "تَفْصِيلِيّ, مُفَصَّل (مفصل بالكامل ودقيق في الجزئيات)",
 "circumstantial evidence": "دليل ظرفي, قرينة (دليل يوفر فقط أساساً للاستنتاج حول الواقعة المتنازع عليها)",
 "circumstantially": "بالصدفة, عرضياً (بدون تخطيط مسبق) / بتفصيل دقيق, بدقة متناهية (بتفاصيل دقيقة) / ظرفياً, من حيث الظروف (بقدر ما تتعلق الظروف) / بقرائن ظرفية (وفقاً للظروف)\nمثال: التقيا بالصدفة",
 "circumvention": "التفاف, تحايل (فعل التهرب عن طريق الالتفاف حول الشيء)",
 "circumvolution": "التفاف, دوران (عملية الدوران أو اللف أو الطي حول محور مركزي)",
 "circus": "سِيرْك",
 "circus acrobat": "بهلوان السيرك (بهلوان يؤدي مآثر وألعاباً بهلوانية في السيرك)",
 "circus aeruginosus": "مرزة المستنقعات (مرزة من العالم القديم تتردد على مناطق المستنقعات)",
 "circus cyaneus": "مرزة الدجاج (مرزة شائعة في أمريكا الشمالية وأوروبا؛ تعشش في المستنقعات والأراضي المفتوحة)",
 "circus pygargus": "مرزة مونتاجو (مرزة أوروبية بنية اللون)",
 "circus tent": "خيمة السيرك (خيمة قماشية لإيواء الجمهور في عرض السيرك)\nمثال: كان خائفاً من حريق في خيمة السيرك",
 "cirio": "سيريو, شجرة بوجوم (خشب الشمع من المكسيك وجنوب غرب كاليفورنيا له سيقان عمودية طويلة ويحمل زهوراً صفراء كريمية برائحة العسل)",
 "cirque": "دَارَة (لا جمع له)",
 "cirrhosis": "تَشَمُّع, تَلَيُّف",
 "cirrhosis of the liver": "تليف الكبد (مرض مزمن يتداخل مع العمل الطبيعي للكبد)",
 "cirrhus": "حالق ملتف (عادة ما يكون ملتفاً)",
 "cirriped": "برنقيل (قشريات بحرية ذات زوائد ريشية لالتقاط الطعام؛ تسبح بحرية كيرقات؛ كبالغين تشكل صدفة صلبة وتعيش ملتصقة بالأسطح المغمورة)",
 "cirripede": "برنقيل (قشريات بحرية ذات زوائد ريشية لالتقاط الطعام؛ تسبح بحرية كيرقات؛ كبالغين تشكل صدفة صلبة وتعيش ملتصقة بالأسطح المغمورة)",
 "cirrocumulus": "ركام سمحاقي, سحاب قزعي (سحابة على ارتفاع عالٍ تتكون من سلسلة من السحب الصغيرة المرتبة بانتظام تشبه التموجات)",
 "cirrocumulus cloud": "ركام سمحاقي, سحاب قزعي (سحابة على ارتفاع عالٍ تتكون من سلسلة من السحب الصغيرة المرتبة بانتظام تشبه التموجات)",
 "cirrostratus": "سمحاق طبقي (طبقة رقيقة موحدة من السحب الضبابية على ارتفاع عالٍ)",
 "cirrostratus cloud": "سمحاق طبقي (طبقة رقيقة موحدة من السحب الضبابية على ارتفاع عالٍ)",
 "cirrus": "ذُؤَابَة / طَخَاء",
 "cirrus cloud": "سحاب رقيق, سمحاق (سحابة بيضاء رقيقة (عادة من بلورات جليدية دقيقة) على ارتفاع عالٍ (4 إلى 8 أميال))",
 "cirsium arvense": "شوك زاحف, شوك كندي (شوك أوروبي توطن في الولايات المتحدة وكندا حيث يعتبر عشباً ضاراً خبيثاً)",
 "cirsium discolor": "شوك الحقل (شوك قوي من أمريكا الشمالية ذو رؤوس زهور وردية أرجوانية)",
 "cirsium eriophorum": "شوك صوفي أوروبي (شوك صوفي في غرب ووسط أوروبا وشبه جزيرة البلقان)",
 "cirsium flodmanii": "شوك صوفي (شوك من غرب أمريكا الشمالية له أوراق بيضاء صوفية)",
 "cirsium helenioides": "شوك حزين (شوك معمر ذو رئد من شمال أوروبا بأوراق قاعدية سنانية ورؤوس زهور حمراء أرجوانية منفردة عادة)",
 "cirsium heterophylum": "شوك حزين (شوك معمر ذو رئد من شمال أوروبا بأوراق قاعدية سنانية ورؤوس زهور حمراء أرجوانية منفردة عادة)",
 "cirsium lanceolatum": "شوك رمحي, شوك شائك (شوك أوروبي ذو رؤوس كبيرة نوعاً ما وأوراق شائكة؛ توطن على نطاق واسع كعشب ضار في الولايات المتحدة)",
 "cirsium rivulare": "شوك الجداول (نبات من وسط وجنوب غرب أوروبا)",
 "cirsium vulgare": "شوك رمحي, شوك شائك (شوك أوروبي ذو رؤوس كبيرة نوعاً ما وأوراق شائكة؛ توطن على نطاق واسع كعشب ضار في الولايات المتحدة)",
 "cis": "رابطة الدول المستقلة (تحالف مكون من دول كانت جمهوريات سوفيتية اشتراكية في الاتحاد السوفيتي قبل تفككه في ديسمبر 1991)",
 "cisalpine": "جَنُوب جِبَال الأَلْب (واقع في الجانب الإيطاليّ أو الجنوبيّ من جبال الألب)",
 "cisc": "حاسوب بمجموعة تعليمات معقدة, سيسك ((علم الحاسوب) نوع من معمارية الحاسوب يحتوي على عدد كبير من التعليمات المرمزة في شريحة المعالج المركزي) / دائرة الاستخبارات الجنائية الكندية (وكالة تابعة للحكومة الكندية توحد وحدات الاستخبارات التابعة لوكالات إنفاذ القانون الكندية)",
 "cisco": "سيسكو (سمكة طعام مهمة في البحيرات العميقة الباردة في أمريكا الشمالية) / رنجة البحيرة (سمكة مياه باردة يتم اصطيدها في بحيرة سوبيريور وشمالاً)",
 "cisgender": "مُتَوَافِق الجِنْس",
 "cisjordan": "الضِّفَّة الْغَرْبِيَّة",
 "cislunar": "تحت قمري, دون القمر (يقع بين الأرض والقمر)",
 "cismontane": "دُون الجَبَل (على هذا الجانب من الجبال (بالنسبة للمتحدث))\nمثال: مسابقة في فرجينيا بين سكان ما دون الجبل وسكان ما وراء الجبل",
 "cissy": "مُتَأَنِّث, مُخَنَّث (يتحلى بصفات أنثوية غير لائقة بالرجل)",
