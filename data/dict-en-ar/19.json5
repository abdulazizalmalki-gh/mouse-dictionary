 "odd-pinnate": "فَرْدِيّ التَّرِيُّش ((عن شكل الورقة) ريشيّ بوريقة مُنفردة عند القمّة)",
 "odd-pinnate leaf": "ورقة ريشية فردية (ورقة ريشية مع وريقة واحدة عند القمة)",
 "odd-toed ungulate": "حيوان مفرد الأصابع, مفردات الأصابع (ثدييات مشيمية لها حوافر بعدد فردي من الأصابع في كل قدم)",
 "oddball": "غَرِيب الْأَطْوَار (شخص ذو شخصية غير عادية أو غريبة)",
 "oddish": "غَرِيب بَعْضَ الشَّيْء (غَرِيب إِلَى حَدٍّ مَا)",
 "oddity": "غَرَابَة",
 "oddly": "بشكل غريب, بشكل لا يمكن تفسيره (بطريقة تختلف عن المعتاد أو المتوقع) / بشكل عجيب, بغرابة (بطريقة غريبة)\nمثال: كان لديه صوت أجش بشكل مثير للفضول",
 "oddment": "تحفة, شيء نادر (شيء غير عادي - ربما يستحق الجمع) / بقايا قماش, فضلة قماش (قطعة قماش متبقية بعد استخدام الباقي أو بيعه)",
 "oddments": "أخلاط, أشياء متنوعة (تشكيلة مختلطة من الأشياء)",
 "oddness": "غَرَابَة",
 "odds": "أَرْجَحِيَّة, فُرْصَة (احتمالية حدوث شيء بدلاً من عدم حدوثه) / أَرْجَحِيَّة, اِحْتِمَالَات الفَوْز (النسبة التي يزيد بها رهان مقامر على آخر)\nمثال: عرض احتمالات اثنين إلى واحد",
 "odds and ends": "أخلاط, أشياء متنوعة (تشكيلة مختلطة من الأشياء)",
 "odds-maker": "واضع الاحتمالات (شخص يحدد احتمالات الرهان بناءً على حسابات نتيجة المسابقة (خاصة في سباق الخيل))",
 "odds-on": "أَوْفَرُ حَظًّا, مُرَجَّح (لديه فرصة نجاح أعلى من المتوسّط)",
 "ode": "أود, قصيدة غنائية (قصيدة غنائية ذات أشكال مقطعية معقدة)",
 "oder": "اَلْأُودَر",
 "odessa": "أُودِيسَا / أُدِسَّة",
 "odious": "بَشِع, مَقِيت (مكروه بشكل لا لبس فيه)",
 "odiously": "بِشَكْل بَغِيض, بِشَكْل مَقِيت (بطريقة مسيئة ومكروهة)\nمثال: لا أعرف أي شخص كان يمكن أن يتصرف بمثل هذه الشناعة",
 "odiousness": "إِسَاءَة, بَشَاعَة (صفة كون الشيء مسيئاً أو كريهاً)",
 "odisha": "أُورِيسَا",
 "odist": "ناظم القصائد الغنائية (شاعر يكتب القصائد الغنائية (الأود))",
 "odium": "اشمئزاز, بغض (كراهية مقترنة بالاشمئزاز) / خزي, كراهية عامة (حالة من العار ناتجة عن سلوك بغيض)",
 "odoacer": "أودواكر",
 "odobenus divergens": "فظ المحيط الهادئ (فظ من بحر بيرينغ وشمال المحيط الهادئ)",
 "odobenus rosmarus": "فظ أطلسي (فظ من شمال المحيط الأطلسي ومياه القطب الشمالي)",
 "odocoileus hemionus": "أيل البغل (أيل طويل الأذنين يعيش في غرب أمريكا الشمالية وله قرون ذات شعبتين)",
 "odocoileus hemionus columbianus": "أيل أسود الذيل (أيل البغل في جبال روكي الغربية)",
 "odocoileus virginianus": "أيل أبيض الذيل, أيل فرجينيا (أيل شائع في أمريكا الشمالية؛ ذيله له جانب سفلي أبيض)",
 "odometer": "عَدَّادُ المَسَافَات",
 "odonate": "يعسوبيات (حشرة مائية مفترسة بدائية كبيرة لها زوجان من الأجنحة الغشائية)",
 "odontalgia": "ألم الأسنان (وجع موضعي في السن أو حوله)",
 "odontaspis taurus": "قرش الرمل, قرش الرمل الببري (قرش المياه الضحلة ذو أسنان حادة مسننة يوجد على جانبي المحيط الأطلسي؛ خطير أحياناً على السباحين)",
 "odontiasis": "بزوغ الأسنان, تسنين (بزوغ أسنان الطفل عبر اللثة)",
 "odontoglossum": "أودونتوجلوسوم (أي من بساتين الفاكهة العديدة والمتنوعة من جنس أودونتوجلوسوم ذات عناقيد من زهور قليلة إلى كثيرة مبهرجة كبيرة عادة بألوان عديدة)",
 "odontoid process": "سن المحور, نتوء سني (نتوء يشبه السن في الجزء الخلفي من الفقرة الثانية للعنق)",
 "odontology": "طب الأسنان (فرع الطب المعني بتشريح وتطور وأمراض الأسنان)",
 "odor": "رَائِحَة, رَوَائِح (الخاصية التي تمتلكها بعض المركبات الكيميائية المتطايرة في الهواء على الأرجح بتركيز منخفض جدًا…)\nمثال: شم تلك الرائحة.",
 "odoriferous": "عَبِق, فَوَّاح (ذُو عُطْرٍ طَبِيعِيٍّ) / ذُو رَائِحَةٍ, فَائِح (يَنْبَعِثُ مِنْهُ رَائِحَة)",
 "odorless": "عديم الرائحة (ليس له رائحة)\nمثال: غاز عديم الرائحة",
 "odorous": "عَبِق, فَوَّاح (ذُو عُطْرٍ طَبِيعِيٍّ) / ذُو رَائِحَةٍ, فَائِح (يَنْبَعِثُ مِنْهُ رَائِحَة) / ذو رائحة, فواح (له رائحة أو رائحة مميزة)\nمثال: أزهار الياسمين الفواحة",
 "odour": "أريج, رائحة (أي خاصية تكتشف بواسطة الجهاز الشمي) / رائحة, شم (الإحساس الناتج عن تحفيز المستقبلات الشمية في الأنف بواسطة مواد كيميائية معينة في شكل غازي)\nمثال: أحبت رائحة الورود",
 "odourless": "عديم الرائحة (ليس له رائحة)\nمثال: غاز عديم الرائحة",
 "odynophagia": "ألم البلع (ألم شديد عند البلع بسبب اضطراب في المريء)",
 "odysseus": "أُودِيسْيُوس",
 "odyssey": "أوديسة",
 "oecanthus fultoni": "صرصور الشجر الثلجي (صرصور شجر مصفر شاحب واسع الانتشار في أمريكا الشمالية)",
 "oecumenic": "كَنَسِيّ جَامِع, مَسْكُونِيّ (مُهْتَمّ بتعزيز الوحدة بين الكنائس أو الأديان)",
 "oecumenical": "عَالَمِيّ, كَوْنِيّ (ذو نطاق أو تطبيق عالميّ شامل) / كَنَسِيّ جَامِع, مَسْكُونِيّ (مُهْتَمّ بتعزيز الوحدة بين الكنائس أو الأديان)",
 "oecumenism": "الحركة المسكونية (حركة تروج للاتحاد بين الأديان (وخاصة بين الكنائس المسيحية))",
 "oedema": "استسقاء, وذمة (تورم ناتج عن تراكم مفرط للسوائل المائية في الخلايا أو الأنسجة أو التجاويف المصلية)",
 "oedipal complex": "عقدة أوديب (عقدة لدى الذكور؛ الرغبة في امتلاك الأم جنسياً وإقصاء الأب؛ يقال إنها مصدر لاضطرابات الشخصية إذا لم يتم حلها)",
 "oedipus complex": "عقدة أوديب (عقدة لدى الذكور؛ الرغبة في امتلاك الأم جنسياً وإقصاء الأب؛ يقال إنها مصدر لاضطرابات الشخصية إذا لم يتم حلها)",
 "oedometer": "أودوميتر, مقياس الانضغاط (أداة لقياس معدل ومقدار تماسك عينة التربة تحت الضغط)",
 "oeil de boeuf": "نافذة عين الثور (نافذة دائرية أو بيضاوية؛ من العمارة الفرنسية في القرن السابع عشر أو الثامن عشر)",
 "oenanthe aquatica": "أينانت مائي, شمر مائي (عشب سام أوروبي ذو جذور ليفية)",
 "oenanthe crocata": "أينانت زعفراني, قطرة الماء (عشب سام أوروبي له جذور درنية، وعصارة صفراء تصبغ الجلد، وأزهار صفراء وأوراق تشبه الكرفس؛ جميع أجزائه شديدة السمية)",
 "oenologist": "أخصائي نبيذ (متخصص في صناعة النبيذ)",
 "oenology": "علم صناعة النبيذ (فن صناعة النبيذ)",
 "oenomel": "نبيذ العسل (نبيذ مخلوط بالعسل)",
 "oenophile": "مُتَذَوِّق لِلنَّبِيذ, مُحِبّ لِلْخَمْر (شخص يقدر النبيذ ويستمتع به)",
 "oenothera biennis": "زهرة الربيع المسائية الشائعة (نبات ثنائي الحول خشن من شرق أمريكا الشمالية بأزهار صفراء تتفتح في المساء؛ متوطن في أوروبا)",
 "oenothera fruticosa": "قطرات الشمس (نبات ثنائي الحول أو معمر يزهر نهاراً من جنس زهرة الربيع المسائية)",
 "oenothera macrocarpa": "زهرة الربيع الميسورية (زهرة ربيع مسائية تفتح مساءً من جنوب وسط الولايات المتحدة)",
 "oersted": "أورستد (شدة المجال المغناطيسي على بعد 1 سم من قطب مغناطيسي الوحدة)",
 "oesophageal reflux": "ارتجاع معدي مريئي (ارتجاع محتويات المعدة إلى المريء)",
 "oesophageal veins": "أوردة مريئية (أوردة صغيرة من المريء تصب في الوريد العضدي الرأسي أو الأوردة الفردية)",
 "oesophagitis": "التهاب المريء (التهاب المريء؛ غالباً ما يكون سببه الارتجاع المعدي المريئي)",
 "oesophagogastric junction": "الموصل المريئي المعدي (الوصلة بين المريء وظهارة المعدة)",
 "oesophagoscope": "منظار المريء (أداة بصرية لفحص الجزء الداخلي من المريء)",
 "oesophagus": "مَرِيء",
 "oestradiol": "إستراديول (أقوى هرمون أنثوي يحدث بشكل طبيعي؛ يتم تصنيعه واستخدامه لعلاج نقص هرمون الاستروجين وسرطان الثدي)",
 "oestriol": "إستريول (هرمون استروجيني يحدث بشكل طبيعي؛ يستخدم شكله الاصطناعي لعلاج نقص الاستروجين)",
 "oestrogen": "إستروجين, هرمون أنثوي (مصطلح عام للهرمونات الجنسية الستيرويدية الأنثوية التي يفرزها المبيض والمسؤولة عن الخصائص الجنسية الأنثوية النموذجية)",
 "oestrone": "إسترون (هرمون إستروجيني ضعيف يوجد طبيعياً ويفرزه مبيض الثدييات)",
 "oestrus": "دورة الشبق, شبق (ينطبق على الثدييات غير البشرية: حالة أو فترة من الإثارة الجنسية والنشاط المتزايد)",
 "oestrus ovis": "نبرة الغنم (اليرقات طفيلية على الأغنام)",
 "oeuvre": "أعمال كاملة, مؤلفات (إجمالي نتاج كاتب أو فنان (أو جزء كبير منه))\nمثال: درس أعمال فاغنر الكاملة",
 "of": "مِنْ (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ل (اللَّامُ هو الحرف الثالث والعشرون من حروف ٱلْهِجَاءِ، وهو مجهور متوسط…؛ يفيد التعليل الغرضي) / لدى / مْتاع\nمثال: يا لها من جملة!",
 "of a sudden": "بغتة, على حين غرة (بسرعة وبدون سابق إنذار)\nمثال: توقف فجأة",
 "of age": "راشِد (اسم فاعل للفعل \"رَشَدَ\"؛ المستقيم على طريق الحق مع تصلب فيه)\nمثال: زيري راشد أكثر من ذلك.",
 "of all time": "أبداً, على الإطلاق (في أي وقت)\nمثال: هل دخنت من قبل؟",
 "of course": "طَبْعًا",
 "of import": "ذو شأن, مهم (ذو أهمية أو قيمة كبيرة)\nمثال: أشخاص مهمون",
 "of late": "حديثاً, في الآونة الأخيرة (في الماضي القريب)\nمثال: كان في باريس مؤخراً",
 "of necessity": "بالضرورة, حتماً (بطريقة لا يمكن أن تكون خلاف ذلك)\nمثال: هو كذلك بالضرورة",
 "off": "مُعْفَى مِنَ الخِدْمَة (لا يؤدّي واجبات أو ليس في جدول المهام) / بعيداً, فصلاً (لم يعد متصلاً أو ملامساً) / بَعِيدًا (من شيء أو مكان أو منصب معين) / عَلَى بُعْد (على مسافة في المكان أو الزمان)\nمثال: نظف الأوساخ",
 "off and on": "أحياناً, بشكل متقطع (ليس بانتظام)\nمثال: يهاتفان بعضهما بشكل متقطع",
 "off fleek": "غَيْرُ أَنِيقٍ ((غير رسمي) لَيْسَ ذَا مَظْهَرٍ حَسَنٍ)",
 "off her guard": "عَلَى غِرَّة, غَافِل (غير مستعدّ أو غير متيقّظ)",
 "off his guard": "عَلَى غِرَّة, غَافِل (غير مستعدّ أو غير متيقّظ)",
 "off the beaten path": "بعيداً عن الطرق المطرقة, خارج المألوف (ليس على طول الطريق المعتاد)\nمثال: لتجربة شيء مختلف، تحتاج إلى الذهاب بعيداً عن الطرق المألوفة",
 "off the beaten track": "بعيداً عن الطرق المطرقة, خارج المألوف (ليس على طول الطريق المعتاد)\nمثال: لتجربة شيء مختلف، تحتاج إلى الذهاب بعيداً عن الطرق المألوفة",
 "off the cuff": "ارتجالياً, دون تحضير (بدون إعداد مسبق)\nمثال: أدلى المرشح بتصريح ارتجالي",
 "off the record": "بشكل غير رسمي, ليس للنشر (ليس للاقتباس)\nمثال: تحدث للصحفي ليس للنشر",
 "off year": "سنة ركود سياسي (سنة لا تُجرى فيها انتخابات سياسية كبرى) / سنة ركود (سنة تكون فيها الإنتاجية منخفضة أو رديئة)",
 "off your guard": "عَلَى غِرَّة, غَافِل (غير مستعدّ أو غير متيقّظ)",
 "off-axis reflector": "تلسكوب هرشل, عاكس خارج المحور (تلسكوب عاكس تكون مرآته مائلة قليلاً لإلقاء الصورة إلى الجانب حيث يمكن رؤيتها)",
 "off-base": "خَارِج القَاعِدَة (يقع خارج قاعدة عسكريّة)",
 "off-center": "بَعِيدٌ عَنِ المَرْكَزِ (وَاقِعٌ بَعِيدًا عَنِ المَرْكَزِ أَوِ المِحْوَرِ)",
 "off-centered": "بَعِيدٌ عَنِ المَرْكَزِ (وَاقِعٌ بَعِيدًا عَنِ المَرْكَزِ أَوِ المِحْوَرِ)",
 "off-color": "خَلِيع, مَاجِن (فاحش بطريقة فكاهيّة ومرحة) / خَادِشٌ لِلحَيَاء, سُوقِيّ (يَنْتَهِكُ الذَّوْقَ السَّلِيمَ وَيَقْتَرِبُ مِنَ الفُحْش)",
 "off-colour": "خَادِشٌ لِلحَيَاء, سُوقِيّ (يَنْتَهِكُ الذَّوْقَ السَّلِيمَ وَيَقْتَرِبُ مِنَ الفُحْش)",
 "off-day": "يوم سيء, يوم غير موفق (يوم تسير فيه الأمور بشكل سيء)\nمثال: أخمن أن هذا أحد أيامي السيئة",
 "off-grid": "خارج الشبكة (بدون وصول إلى شبكة كهربائية أو اتصالات)",
 "off-hand": "ارْتِجَالًا (بدون تفكير مسبق)\nمثال: لا أعرف الأرقام ارتجالاً",
 "off-key": "مُنْحَرِف النَّغْمَة, ناشِز (خارِج عَن الدَّرَجَة المُوسيقِيَّة الصَّحيحَة)",
 "off-licence": "محل بيع الخمور (متجر يبيع المشروبات الكحولية للاستهلاك في مكان آخر)",
 "off-limits": "مَحْظُور, مَمْنُوعُ الدُّخُول (محظور على مجموعة مُعيَّنة)",
 "off-line": "أوفلاين, دون اتصال (غير متصل بشبكة كمبيوتر) / خارج الخط, خارج المسار (ليس على مسار منتظم لنظام نقل)\nمثال: مارد غير متصلة",
 "off-line equipment": "معدات غير متصلة, معدات مساعدة (معدات إلكترونية ليست في اتصال مباشر (أو تحت سيطرة) وحدة المعالجة المركزية)",
 "off-line operation": "عملية دون اتصال, عملية مساعدة (عملية يتم إجراؤها بواسطة معدات غير متصلة بالإنترنت وليست تحت سيطرة وحدة المعالجة المركزية)",
 "off-putting": "طَارِد, مُنَفِّر (يميل إلى النفور والتنفير) / مُثَبِّط, مُنَفِّر (يسبب الانزعاج أو النفور)",
 "off-roader": "دراجة جبلية (دراجة بإطار متين وإطارات عريضة؛ مصممة أصلاً للركوب في المناطق الجبلية)",
 "off-season": "خارج الموسم, موسم الركود (الموسم الذي يكون فيه السفر أقل نشاطًا والأسعار أقل)",
 "off-site": "خارج الموقع (يحدث أو يقع بعيداً عن الموقع)\nمثال: عملية معالجة نفايات خارج الموقع",
 "off-speed pitch": "رمية متغيرة السرعة (كرة بيسبول ترمى بسرعة قليلة عندما يتوقع الضارب كرة سريعة)",
 "off-street": "بعيد عن الشارع (ليس في الشوارع العامة)\nمثال: موقف سيارات بعيد عن الشارع",
 "off-the-clock": "خَارِج أَوْقَات الدَّوَام (وقت إضافي دون تعويض إضافي)\nمثال: غالباً ما تضطر للعمل خارج أوقات الدوام",
 "off-the-cuff": "اِرْتِجَالِيّ, عَفْوِيّ (بقليل من الإعداد أو التفكير المسبق أو بدونهما)",
 "off-the-peg": "جَاهِزٌ لِلِارْتِدَاءِ ((خاصة عن الملابس) مصنوع بمقاسات معيارية ومتوفر من المخزون)",
 "off-the-rack": "جَاهِزٌ لِلِارْتِدَاءِ ((خاصة عن الملابس) مصنوع بمقاسات معيارية ومتوفر من المخزون)",
 "off-the-shelf": "جَاهِزٌ لِلِارْتِدَاءِ ((خاصة عن الملابس) مصنوع بمقاسات معيارية ومتوفر من المخزون)",
 "off-the-shoulder": "مَكْشُوف الكَتِفَيْن (لا يغطي الكتفين (خاصة في حالة البلوزة أو الفستان))",
 "off-the-wall": "شَاذّ, عَجِيب (غَيْرُ تَقْلِيدِيٍّ أَوْ غَيْرُ مَأْلُوفٍ بِشَكْلٍ لَافِتٍ لِلنَّظَر)",
 "off-topic": "خارج الـموضوع",
 "off-white": "أَبْيَض مَائِل, مُبْيَضّ (بلون يميل إلى البياض) / أبيض عظمي, أوف وايت (درجة من الأبيض بلون العظام المبيضة)",
 "offal": "سقط, فضلات الذبيحة (الأحشاء والأجزاء المتبقية من الحيوان المذبوح التي غالباً ما تعتبر غير صالحة للأكل للبشر)",
 "offbeat": "غَرِيب, مُثِيرٌ لِلدَّهْشَة ((غير رسمي) غَيْرُ تَقْلِيدِيٍّ بِشَكْلٍ لَافِت) / نبرة صاعدة, نقر ضعيف (نقر غير مشدد (خاصة النقر الأخير في المقياس))",
 "offence": "جنحة, مخالفة (تجاوز يشكل انتهاكاً لما يُحكم بأنه حق) / عملية هجومية, هجوم (عمل مهاجمة العدو) / إساءة, فظاظة (نقص في التهذيب؛ الفشل في إظهار الاحترام للآخرين؛ جرح مشاعر الآخرين) / إهانة, استياء (شعور بالغضب ناتج عن التعرض للإهانة)\nمثال: لقد شعر بالاستياء من سؤالي",
 "offenceless": "عَاجِز عَنِ الإِسَاءَة (غير قادر على الإساءة أو الاعتداء)",
 "offend": "أَهَانَ (شخص يكون لئيم لآخر بالكلام)\nمثال: أهان سامي ليلى بقص شعرها.",
 "offended": "مَجْرُوح, مُهَان (متألم عاطفياً أو منزعج أو متضايق)",
 "offender": "جَانٍ ((جَانَ) جونا وجونة: اسود)",
 "offending": "مخالف, منتهك (مخالف لقانون أو قاعدة)\nمثال: تم إلغاء العقود المخالفة للنظام الأساسي",
 "offense": "جنحة, مخالفة (تجاوز يشكل انتهاكاً لما يُحكم بأنه حق) / عملية هجومية, هجوم (عمل مهاجمة العدو) / إساءة, فظاظة (نقص في التهذيب؛ الفشل في إظهار الاحترام للآخرين؛ جرح مشاعر الآخرين) / إهانة, استياء (شعور بالغضب ناتج عن التعرض للإهانة)\nمثال: لقد شعر بالاستياء من سؤالي",
 "offenseless": "عَاجِز عَنِ الإِسَاءَة (غير قادر على الإساءة أو الاعتداء)",
 "offensive": "هُجُوم, حَمْلَة",
 "offensive activity": "إساءة, فظاظة (نقص في التهذيب؛ الفشل في إظهار الاحترام للآخرين؛ جرح مشاعر الآخرين)",
 "offensively": "بِشَكْل هُجُومِيّ, هُجُومِيًّا (بشكل عدواني) / بِشَكْل بَغِيض, بِشَكْل مُسِيء (بطريقة بغيضة) / بِشَكْل كَرِيه, بِنَتَانَة (بطريقة كريهة بشكل غير سار)\nمثال: 'في هذه الأزمة، يجب أن نتصرف بشكل هجومي'، قال الرئيس",
 "offensiveness": "إِسَاءَة, بَشَاعَة (صفة كون الشيء مسيئاً أو كريهاً)",
 "offer": "اِقْتِرَاح / اِقْتَرَحَ, قَدَّمَ (اِبْتَدَعَ ٱلشَّيْءَ مِنْ ذَاتِ نَفْسِهِ مِنْ غَيْرِ أَنْ يَسْمَعَهُ؛ اِخْتَارَ) / قَدَّمَ (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى الرُّسْغَ؛ أنّ لهم سابقةً وفضلاً له عند فلان قَدَمٌ : معروف)\nمثال: اقترح سامي المساعدة.",
 "offer price": "سعر العرض ((سوق الأسهم) السعر الذي يكون الوسيط مستعداً لبيع ورقة مالية معينة به)",
 "offerer": "عارض, مقدم العرض (شخص يقدم شيئاً لآخر للقبول أو الرفض)",
 "offering": "قُرْبَان",
 "offeror": "عارض, مقدم العرض (شخص يقدم شيئاً لآخر للقبول أو الرفض)",
 "offertory": "طقس التقدمة (جزء من القداس يتم فيه تقديم الخبز والنبيذ لله) / جمع التبرعات, عطاء المصلين (تقدمات المصلين في خدمة دينية)",
 "offhand": "دُونَ اكْتِرَاث (بطريقة عارضة غير مراعية) / ارْتِجَالِيًّا (بدون تفكير أو تحضير مسبق) / عَفَوِيّ, غَيْر مُبَالٍ (غَيْر مُكْتَرِث أَوْ غَيْر مُرَاعٍ بِشَكْلٍ عَفَوِيّ) / اِرْتِجَالِيّ, عَفْوِيّ (بقليل من الإعداد أو التفكير المسبق أو بدونهما)\nمثال: أجاب دون اكتراث، وعقله بعيد ملايين الأميال",
 "offhanded": "دُونَ اكْتِرَاث (بطريقة عارضة غير مراعية) / ارْتِجَالِيًّا (بدون تفكير أو تحضير مسبق) / عَفَوِيّ, غَيْر مُبَالٍ (غَيْر مُكْتَرِث أَوْ غَيْر مُرَاعٍ بِشَكْلٍ عَفَوِيّ) / اِرْتِجَالِيّ, عَفْوِيّ (بقليل من الإعداد أو التفكير المسبق أو بدونهما)\nمثال: أجاب دون اكتراث، وعقله بعيد ملايين الأميال",
 "offhandedly": "دُونَ اكْتِرَاث (بطريقة عارضة غير مراعية) / ارْتِجَالِيًّا (بدون تفكير أو تحضير مسبق)\nمثال: أجاب دون اكتراث، وعقله بعيد ملايين الأميال",
 "office": "مَهَمَّة",
 "office block": "مبنى إداري, مبنى مكاتب (مبنى يحتوي على مكاتب حيث يتم إنجاز العمل)",
 "office boy": "راش ((رَاشَ) الطَّائِرُ يَرِيشُ رَيْشًا: نبَتَ رِيشُهُ؛ (رَاشَ) فلانٌ: استَغْنَى)",
 "office building": "مبنى إداري, مبنى مكاتب (مبنى يحتوي على مكاتب حيث يتم إنجاز العمل)",
 "office furniture": "أثاث مكتبي (أثاث مخصص للاستخدام في المكتب)",
 "office of inspector general": "مكتب المفتش العام (ذراع التحقيق للجنة التجارة الفيدرالية)",
 "office of intelligence support": "مكتب دعم الاستخبارات (وكالة تشرف على العلاقات الاستخباراتية لمكاتب ومكاتب وزارة الخزانة وتوفر رابطًا بين مجتمع الاستخبارات والمسؤولين عن السياسة الاقتصادية الدولية)",
 "office of management and budget": "مكتب الإدارة والميزانية (الوكالة التنفيذية التي تقدم المشورة للرئيس بشأن الميزانية الفيدرالية)",
 "office of naval intelligence": "مكتب الاستخبارات البحرية (وكالة الاستخبارات العسكرية التي توفر متطلبات الاستخبارات والاستخبارات المضادة والتحقيق والأمن للبحرية الأمريكية)",
 "office of the dead": "صلاة الموتى (خدمة تقرأ أو تغنى قبل قداس الدفن في الكنيسة الكاثوليكية)",
 "office staff": "موظفو المكتب (العاملون المهنيون أو المكتبيون في مكتب)\nمثال: تأخر المكتب بأكمله في صباح العاصفة الثلجية",
 "office-bearer": "حامل المنصب (الشخص الذي يحمل منصباً)",
 "officeholder": "شاغل المنصب (المسؤول الذي يشغل منصباً حالياً) / شاغل منصب, ضابط (شخص معين أو منتخب لمنصب ويشغل موقع ثقة)\nمثال: انتخب النادي ضباطه (مسؤوليه) للعام القادم",
 "officer": "مَأْمُور / مَسْؤُول / ضَابِط",
 "officer's mess": "ميس الضباط, نادي الضباط (قاعة طعام للاستخدام الحصري للضباط)",
 "official": "مَسْؤُول / مَسْئُول (اسم مفعول من الفعل سَألَ بمعنى \"مايُسْأَل عنه\"؛ الشخص الذي يرعى شيئا فسوف يُسأل عنه)\nمثال: كلكم راع وكلكم مسئول عن رعيته.",
 "official document": "سند, صك قانوني ((في القانون) وثيقة تنص على علاقة تعاقدية أو تمنح حقاً ما)",
 "official emissary": "سفير بابوي, مبعوث رسمي (عضو في بعثة دبلوماسية)",
 "official immunity": "حصانة رسمية, حصانة وظيفية (حصانة شخصية تُمنح للموظف العام من المسؤولية تجاه أي شخص يتضرر جراء أفعال ناتجة عن ممارسة السلطة الرسمية)",
 "official language": "لُغَة رَسْمِيَّة (هِيَ مجموعة من الأصوات التي يصدرها الإنسان على شكل كلمات منظمة بقواعد، ليتواصل به الناس وينقلون به الافكار والمعاني، اللسان؛ يقصد بها أحيانا اللهجة)\nمثال: الأمازيغية لغة.",
 "officialdom": "مسؤولون حكوميون (أشخاص منتخبون أو معينون لإدارة حكومة)",
 "officialese": "لغة بيروقراطية, لغة رسمية (أسلوب الكتابة المميز لبعض المسؤولين الحكوميين: رسمي وغامض)",
 "officially": "رَسْمِيًّا",
 "officiant": "القائم بالطقوس, المحتفل (رجل دين يدير احتفالاً دينياً أو خدمة دينية)",
 "officiating": "تحكيم (فعل التحكيم (في الرياضة))\nمثال: كان التحكيم ممتازاً",
 "officiation": "إدارة مراسم, تولي منصب (أداء واجب ديني أو احتفالي أو عام) / تحكيم (فعل التحكيم (في الرياضة))\nمثال: كان التحكيم ممتازاً",
 "officious": "فُضُولِيّ, مُتَدَخِّل (يتدخل في شؤون الآخرين بطريقة مزعجة)",
 "officiously": "بتطفل, بفضول (بطريقة متطفلة ومحبة للتدخل)\nمثال: لا شيء قاتل مثل السعي بفضول مفرط لصفة مجردة مثل الجمال",
 "officiousness": "تطفل, فضول (عدوانية تتضح من خلال التطفل؛ من خلال تقديم نفسك أو أفكارك دون دعوة)",
 "offing": "عرض البحر (جزء البحر الذي يمكن رؤيته من الشاطئ ويقع بعد منطقة الرسو) / أفق, مستقبل منظور (المستقبل القريب أو المتوقع)\nمثال: كانت هناك سفينة في عرض البحر",
 "offish": "فَاتِر, مُتَبَاعِد (يفتقر إلى الودّ والمؤانسة؛ جافّ في التعامل)",
 "offline": "غَيْر مُتَّصِل, غَيْر مُتَوَاجِد (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "offprint": "طبعة منفصلة, مُستَلّة (مقال مطبوع بشكل منفصل ظهر أصلاً في منشور أكبر)",
 "offset": "تراجع معماري, ردة الجدار (هيكل يضيق فيه الجدار أو المبنى بشكل مفاجئ) / أوفست, طباعة أوفست (يقوم لوح بعمل طبعة محبرة على أسطوانة مغطاة بالمطاط، والتي بدورها تنقلها إلى الورق) / فرع, نتاج طبيعي (عاقبة طبيعية للتطور) / رئد, ساق جارية (فرع أفقي من قاعدة النبات ينتج نباتات جديدة من براعم في أطرافه)",
 "offset lithography": "أوفست ليثوغرافيا, طباعة حجرية أوفست (طباعة الأوفست بواسطة الليثوغرافيا)",
 "offset press": "مطبعة أوفست (مطبعة تستخدم للطباعة بالأوفست، حيث يتم نقل الصورة المحبرة (أو \"إزاحتها\") من لوحة إلى وسادة مطاطية، ثم إلى سطح الطباعة)\nمثال: تستخدم العديد من مطابع الأوفست الحديثة أنظمة الكمبيوتر إلى اللوحة بدلاً من تدفقات العمل القديمة من الكمبيوتر إلى الفيلم، مما يزيد من جودتها",
 "offset printing": "أوفست, طباعة أوفست (يقوم لوح بعمل طبعة محبرة على أسطوانة مغطاة بالمطاط، والتي بدورها تنقلها إلى الورق)",
 "offsetting balance": "رَصِيد تَعْوِيضِيّ (حد أدنى من الرصيد الدائن قد يطلبه البنك من المقترض الاحتفاظ به كوديعة كشرط لمنح القرض)\nمثال: يزيد الرصيد التعويضي من سعر الفائدة الفعلي للبنك لأن المبلغ الصافي المقرض ينخفض ولكن الفائدة المدفوعة لا تتغير",
 "offshoot": "فرع, نتاج طبيعي (عاقبة طبيعية للتطور)",
 "offshore": "بعيداً عن الشاطئ, في عرض البحر (بعيداً عن الشاطئ؛ بعيداً عن اليابسة) / بَحْرِيّ, نَحْو البَحْر ((للرياح) قادمة من اليابسة) / بَعِيد عَن الشَّاطِئ (على مسافة من الشاطئ)\nمثال: تبحر على بعد ثلاثة أميال في عرض البحر",
 "offshore rig": "حفار بحري, منصة حفر (جهاز حفر يتكون من منصة بحرية (عائمة أو مثبتة في قاع البحر) يمكن من خلالها حفر العديد من آبار النفط شعاعياً)",
 "offside": "تَسَلُّل",
 "offsides": "متسلل (تجاوز بشكل غير قانوني خطاً أو منطقة مقررة أو تقدم على الكرة)\nمثال: تم إلغاء الهدف لأن المهاجم الأيسر كان متسللاً",
 "offspring": "ذُرِّيَّة, وَلَد / نِتاج",
 "offstage": "بَعِيدًا عَن الأَنْظَار (ليس في العلن) / خَلْف الكَوَالِيس (خلف الكواليس؛ ليس على المسرح) / خلف الكواليس (يقع أو يحدث في منطقة المسرح غير المرئية للجمهور) / بَعِيد عَن الأَنْظَار, خَلْفَ الكَوَالِيس (مخفيّ عن النظر العامّ أو الاهتمام)\nمثال: تمت الصفقة بعيداً عن الأنظار",
 "ofo": "لغة أوفو (لغة سيووية يتحدث بها شعب أوفو) / أوفو (فرد من الشعب السيوي يعيش في وادي نهر يازو في ميسيسيبي)",
 "ofo language": "لغة أوفو (لغة سيووية يتحدث بها شعب أوفو)",
 "oft": "غالباً, كثيراً (مرات عديدة على فترات قصيرة)\nمثال: غالباً ما التقينا لتناول فنجان من القهوة",
 "often": "كَثِيرًا, غَالِبًا",
 "oftener": "أكثر تكراراً (في أحيان أكثر أو بشكل متكرر أكثر)",
 "oftenness": "تَرَدُّد, تَكْرَار (عدد مرات الحدوث ضمن فترة زمنية معينة)\nمثال: كان تردد التعديل 40 دورة في الثانية",
 "oftentimes": "كَثِيرَ المَرَاتِ (ما كان عدده كبيرا؛ متبوعًا بمِنْ: عدد كبير أو كمية كبيرة من الشيء)\nمثال: هذا أسهل بكثير.",
 "ofttimes": "غالباً, كثيراً (مرات عديدة على فترات قصيرة)\nمثال: غالباً ما التقينا لتناول فنجان من القهوة",
 "ogaden": "أوجادين",
 "ogalala": "لغة أوغلالا (لغة سيووية يتحدث بها شعب أوغلالا) / أوغلالا (فرد من الشعب السيوي شكل قسماً من تيتون سيوكس وعاش سابقاً في التلال السوداء في غرب داكوتا الجنوبية)",
 "ogalala language": "لغة أوغلالا (لغة سيووية يتحدث بها شعب أوغلالا)",
