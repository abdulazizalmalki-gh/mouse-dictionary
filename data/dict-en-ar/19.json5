 "oak": "بَلُّوط, سِنْدِيَان",
 "oak apple": "عفصة البلوط (عفصة البلوط التي تسببها يرقات دبور الآبرات)",
 "oak blight": "آفة البلوط (قملة نبات سوداء تعيش على أشجار البلوط والقرانيا)",
 "oak chestnut": "كستناء البلوط (شجرة من جنس كاستانوبسيس)",
 "oak fern": "سرخس البلوط (سرخس أزرق مخضر ساطع واسع الانتشار خاصة في الغابات الحمضية الرطبة في المنطقة المعتدلة الشمالية)",
 "oak gall": "عَفْص",
 "oak leaf cluster": "عنقود أوراق البلوط (وسام عسكري أمريكي يتكون من أوراق بلوط وجوز من البرونز أو الفضة يُمنح لمن فاز بميدالية معينة من قبل)",
 "oak tree": "بلوط, سنديان (شجرة نفضية من جنس السنديان؛ لها جوز (بلوط) وأوراق مفصصة)\nمثال: تنمو أشجار البلوط العظيمة من ثمار البلوط الصغيرة",
 "oak-leaved goosefoot": "رجل الوزة بلوطي الأوراق (نبات أوروبي حولي ذو سنابل من الزهور المخضرة وأوراق بيضاء ومشعرة على الجانب السفلي؛ شائع كعشبة ضارة في أمريكا الشمالية)",
 "oaken": "بَلُّوطِيّ, سِنْدِيَانِيّ (مُكَوَّنٌ أَوْ مَصْنُوعٌ مِنْ خَشَبِ البَلُّوطِ)",
 "oakland": "أُوكْلَانْد",
 "oakleaf goosefoot": "رجل الوزة بلوطي الأوراق (نبات أوروبي حولي ذو سنابل من الزهور المخضرة وأوراق بيضاء ومشعرة على الجانب السفلي؛ شائع كعشبة ضارة في أمريكا الشمالية)",
 "oakum": "مشاقة (ألياف قنب أو جوت فضفاضة يتم الحصول عليها عن طريق فك الحبال القديمة؛ عندما تُشبع بالقطران كانت تستخدم لسد الشقوق وحشو الوصلات في السفن الخشبية)",
 "oar": "مِجْذَاف, مِجْدَاف",
 "oarfish": "سمكة المجداف, ملك الرنجة (سمكة استوائية رفيعة تعيش في المياه العميقة يتراوح طولها بين 20 و 30 قدماً ولها زعنفة ظهرية حمراء)",
 "oarlock": "مسند المجداف, وتد المجداف (حامل مثبت على حافة القارب يثبت المجداف في مكانه ويعمل كنقطة ارتكاز للتجديف)",
 "oarsman": "مجدف (ذكر يجدف بقارب)",
 "oarsmanship": "مهارة التجديف (المهارة كمجدف)",
 "oarswoman": "مجدفة (أنثى تجدف قارباً)",
 "oas": "منظمة الدول الأمريكية (رابطة تضم معظم البلدان في نصف الكرة الغربي؛ أنشئت عام 1948 لتعزيز التعاون العسكري والاقتصادي والاجتماعي والثقافي)",
 "oasis": "وَاحَة, غُوطَة (بقعة خضراء في الصحراء أو في أرض قاحلة، وأصبحت كذلك بسبب وجود مصدر ماء بقربها)",
 "oast": "مجفف الجنجل (فرن لتجفيف نبات الجنجل (حشيشة الدينار))",
 "oast house": "بيت التجفيف (مبنى يحتوي على فرن لتجفيف الجنجل؛ عادة ما يكون له سقف مخروطي أو هرمي)",
 "oat": "شُوفَان, خَرْطَال",
 "oat cell carcinoma": "سرطانة الخلايا الصغيرة, سرطانة الخلية الشوفانية (سرطانة خبيثة للغاية تتكون من خلايا صغيرة مستديرة أو بيضاوية الشكل مع القليل من السيتوبلازم؛ غالبًا ما تكون سرطانات الرئة سرطانات خالية شوفانية)",
 "oatcake": "كعكة الشوفان (كعكة مسطحة رقيقة غير مخمرة من دقيق الشوفان المخبوز)",
 "oaten": "شوفاني (من أو متعلق أو مشتق من الشوفان)\nمثال: خبز شوفاني",
 "oath": "قَسَم, حَلْف (فَرَّقَ أو قَسَّمَ الشَّيءَ إلى أجزاء أو أجزاء مختلفة؛ أَحْلَفَ، أَي جَعَلَ يَحْلِفُ على أمرٍ ما)\nمثال: أنا أزين القسم.",
 "oatmeal": "دقيق الشوفان, شوفان (دقيق مصنوع من الشوفان الملفوف أو المطحون) / دقيق الشوفان, عصيدة الشوفان (عصيدة مصنوعة من رقائق الشوفان)",
 "oatmeal cookie": "بسكويت الشوفان (بسكويت يحتوي على رقائق الشوفان)",
 "oats": "شُوفَان",
 "ob": "أُوبِي",
 "obama": "أُوبَامَا",
 "obbligato": "أوبليغاتو, لحن إلزامي (جزء من المدونة الموسيقية يجب أداؤه دون تغيير أو حذف) / أوبليجاتو, لحن ملازم (موتيف مستمر ولكنه ثانوي)",
 "obduracy": "تعنت, صلابة (الحزم بحكم كونه غير مرن ولا يلين)",
 "obdurate": "عَنيد, غَليظ (شَديد القَسْوَة وعَديم الرَّحْمَة؛ لا يَرِقّ قَلْبُه) / عَنِيدٌ, مُصِرٌّ عَلَى الْخَطَأِ (مُصِرّ بعناد على ارتكاب الخطأ)",
 "obdurately": "بإصرار, بعناد (بطريقة عنيدة)\nمثال: بقيت بعناد في نفس الوضع",
 "obeah": "أوبيا, سحر أوبيا (معتقد ديني من أصل أفريقي يتضمن السحر والشعوذة؛ يمارس في أجزاء من جزر الهند الغربية والأمريكتين الاستوائيتين) / أوبيا ((جزر الهند الغربية) أتباع نظام ديني يتضمن السحر والشعوذة)",
 "obeche": "أوبتشي, سامبا (شجرة كبيرة من غرب أفريقيا ذات أوراق كبيرة مفصصة كفياً وعناقيد سيمية إبطية من الزهور البيضاء الصغيرة وبذور مجنحة واحدة؛ تنتج خشباً ناعماً أبيض إلى…) / خشب الأوبتشي (خشب شجرة الأوبتشي الأفريقية؛ يستخدم خاصة للقشرة)",
 "obechi": "أوبتشي, سامبا (شجرة كبيرة من غرب أفريقيا ذات أوراق كبيرة مفصصة كفياً وعناقيد سيمية إبطية من الزهور البيضاء الصغيرة وبذور مجنحة واحدة؛ تنتج خشباً ناعماً أبيض إلى…)",
 "obedience": "طَاعَة, إِطَاعَة",
 "obedience plant": "أروروت, أروروت أمريكي (نبات أبيض الزهر من جزر الهند الغربية ينتج جذره نشا الأروروت)",
 "obedient": "مُطِيع, مُذْعِن",
 "obedient plant": "رأس التنين الكاذب, فيزوستيغيا (نبات أمريكي شمالي له سنبلة من الزهور الوردية أو البيضاء ثنائية الشفة)",
 "obediently": "بِامْتِثَال, بِطَاعَة (بطريقة مطيعة)\nمثال: بطاعة خلعت حذاءها الأيمن وجوربها",
 "obeisance": "اِمْتِثَال, طَاعَة (فعل الطاعة؛ سلوك مطيع أو خاضع فيما يتعلق بشخص آخر) / انحناء (حني الرأس أو الجسم أو الركبة كعلامة على الاحترام أو الخضوع أو التحية)",
 "obelion": "أوبليون (نقطة قياس القحف على الدرز السهمي بالقرب من الدرز اللامي)",
 "obelisk": "مِسَلَّة",
 "oberon": "أوبيرون ((العصور الوسطى) ملك الجنيات وزوج تيتانيا في فلكلور العصور الوسطى)",
 "obese": "بَدِين جِدًّا, سَمِين مُفْرِطًا (مُفْرِط فِي السِّمْنَة والبَدَانَة)",
 "obesity": "سِمْنَة, بَدَانَة",
 "obesity diet": "حمية إنقاص الوزن, حمية التخسيس (نظام غذائي مصمم للمساعدة في فقدان الوزن (خاصة الدهون))",
 "obey": "أَطَاعَ",
 "obfuscate": "يُعَتّم",
 "obfuscation": "تَعْتِيم",
 "obi": "أوبيا, سحر أوبيا (معتقد ديني من أصل أفريقي يتضمن السحر والشعوذة؛ يمارس في أجزاء من جزر الهند الغربية والأمريكتين الاستوائيتين) / أوبيا ((جزر الهند الغربية) أتباع نظام ديني يتضمن السحر والشعوذة)",
 "obidoxime chloride": "كلوريد أوبيدوكسيم (كلوريد يستخدم كترياق لغازات الأعصاب مثل السارين أو في إكس)",
 "obiism": "سحر الأوبي (اعتقاد في نوع من السحر نشأ في أفريقيا ويُمارس في جزر الهند الغربية)",
 "obit": "نعي (إشعار بوفاة شخص ما؛ يتضمن عادة سيرة ذاتية قصيرة)",
 "obiter dictum": "رأي عارض, ملاحظة قضائية عارضة (رأي يبديه قاضٍ حول نقطة قانونية لا تؤثر بشكل مباشر على القضية المعنية وبالتالي ليست ملزمة) / رأي عارض, ملاحظة عابرة (ملاحظة عرضية)",
 "obituary": "نَعْي",
 "object": "عُرْضَة, شَيْء / هَدَف (جاء إلى الهَدَف؛ ارتفع عن الأرض) / مَفْعُول بِهِ, مَفْعُول (كناية عن الذي فُعِلَ به فاحشة اللواط. المَلُوطُ به) / كَائِن\nمثال: لقد أخطأ الهدف.",
 "object ball": "الكرة المستهدفة (كرة البلياردو التي يقصد أن تكون أول كرة تضربها الكرة البيضاء)",
 "object code": "الشيفرة الهدف, كود الهدف (مخرجات لغة الآلة من المترجم البرمجي الجاهزة للتنفيذ على حاسوب معين)",
 "object glass": "عدسة شيئية (العدسة أو نظام العدسات في التلسكوب أو المجهر الأقرب إلى الجسم الذي يتم عرضه)",
 "object language": "اللغة المترجم إليها, اللغة الهدف (اللغة التي يتم ترجمة نص مكتوب بلغة أخرى إليها) / لغة الكائن, لغة الهدف (لغة حاسوبية يتم ترجمة شيء مكتوب بلغة حاسوبية أخرى إليها)",
 "object lens": "عدسة شيئية (العدسة أو نظام العدسات في التلسكوب أو المجهر الأقرب إلى الجسم الذي يتم عرضه)",
 "object lesson": "عِبْرَة, مِثَال رَادِع (عقوبة يقصد بها أن تكون تحذيراً للآخرين)\nمثال: قرروا أن يجعلوه عبرة",
 "object of a preposition": "مجرور, مفعول حرف الجر (المفعول الذي يحكمه حرف الجر)",
 "object of the verb": "مفعول به مباشر (المفعول الذي يتلقى الفعل المباشر للفعل)",
 "object program": "برنامج الهدف (برنامج تم تجميعه أو تجميعه بالكامل وجاهز للتحميل في الحاسوب)",
 "object recognition": "تعرف على الأشياء (الإدراك البصري للأشياء المألوفة)",
 "object-oriented database": "قاعدة بيانات كائنية التوجه (قاعدة بيانات تعتبر فيها العمليات التي تتم على عناصر المعلومات (كائنات البيانات) جزءاً من تعريفها)",
 "object-oriented database management system": "نظام إدارة قواعد البيانات كائنية التوجه (نظام إدارة قواعد بيانات مصمم لإدارة قاعدة بيانات كائنية التوجه)",
 "object-oriented programing": "برمجة شيئية, برمجة كائنية التوجه (إنشاء برنامج يمكنه استخدام ودعم الكائنات البرمجية)",
 "object-oriented programing language": "لغة برمجة شيئية, لغة برمجة كائنية التوجه ((علوم الحاسوب) لغة برمجة تمكّن المبرمج من ربط مجموعة من الإجراءات بكل نوع من هياكل البيانات)",
 "object-oriented programming": "برمجة غرضية التوجه (فِي : هي عملية كتابة تعليمات وتوجيه أوامر لجهاز الحَاسُوبِ أو أي جهاز آخر مثل قارئات أقراص الدي في دي أو أجهزة استقبال الصوت والصورة في نظم الاتصالات…؛ اسم لفظي للفعل بَرْمَجَ)\nمثال: تسمح لغة البرمجة بكتابة البرامج الحاسوبية.",
 "object-oriented programming language": "لغة برمجة شيئية, لغة برمجة كائنية التوجه ((علوم الحاسوب) لغة برمجة تمكّن المبرمج من ربط مجموعة من الإجراءات بكل نوع من هياكل البيانات)",
 "objectification": "تجسيم, تشييء (فعل تمثيل فكرة مجردة كشيء مادي) / تجسيد, تشخيص (تمثيل ملموس لفكرة أو مبدأ مجرد)",
 "objection": "اِعْتَرَاض / اِعْتِرَاض",
 "objectionable": "مُسْتَهجَن, مُعْتَرَض عَلَيْه (قابل للاعتراض أو النقاش؛ يمكن الطعن فيه) / بَغِيض, مُسْتَهْجَن (يثير الاستنكار أو الاحتجاج)",
 "objectionableness": "بَغَاضَة, كَرَاهِيَة (صفة كون الشيء بغيضاً أو كريهاً)",
 "objectionably": "بِشَكْل بَغِيض, بِشَكْل مُسِيء (بطريقة بغيضة)\nمثال: قال ذلك في واحدة من جمله المتغطرسة فكرياً بشكل بغيض",
 "objective": "حَقَّانِيّ, عَقْلَانِيّ / مَوْضُوعِيّ / هَدَف, مَقْصَد (جاء إلى الهَدَف؛ ارتفع عن الأرض) / عَدَسَة\nمثال: لقد أخطأ الهدف.",
 "objective case": "حالة النصب (حالة الأسماء التي تعمل كمفعول به مباشر للفعل)",
 "objective lens": "عدسة شيئية (العدسة أو نظام العدسات في التلسكوب أو المجهر الأقرب إلى الجسم الذي يتم عرضه)",
 "objectively": "بموضوعية (بموضوعية وتجرد)\nمثال: يجب أن ننظر إلى الحقائق بموضوعية",
 "objectiveness": "موضوعية (الحكم القائم على الظواهر القابلة للملاحظة وغير المتأثر بالعواطف أو التحيزات الشخصية)",
 "objectivity": "موضوعية (الحكم القائم على الظواهر القابلة للملاحظة وغير المتأثر بالعواطف أو التحيزات الشخصية)",
 "objectivization": "إضفاء الموضوعية, موضوعية (فعل أو عملية جعل الشيء موضوعياً أو أن يصبح كذلك)",
 "objector": "محتج, معارض (شخص يعارض سياسة راسخة)",
 "objet d'art": "تحفة فنية, قطعة فنية (عمل فني ذو قيمة فنية ما)\nمثال: يبيع هذا المتجر التحف الفنية فقط",
 "objurgation": "تَعْنِيف, تَقْرِيع (توبيخ شخص ما بقسوة)",
 "oblanceolate": "مَقْلُوب الرُّمْحِيّ ((عن شكل الورقة) ذو قمّة عريضة مُستديرة وقاعدة مُتدرِّجة ضيّقة)",
 "oblanceolate leaf": "ورقة سنانية مقلوبة (ورقة لها قمة مستديرة وقاعدة مستدقة)",
 "oblast": "أُوبْلَاسْت",
 "oblate": "مفلطح (قطره الاستوائي أكبر من قطره القطبي؛ مسطح عند القطبين) / علماني مكرس, نذير (شخص علماني مكرس للعمل الديني أو الحياة الدينية)",
 "oblateness": "إهليلجية, تفلطح (الخاصية التي يمتلكها شكل دائري مفلطح عند القطبين)\nمثال: تفلطح الكوكب",
 "oblation": "تقدمة, قربان (فعل تقديم خبز ونبيذ القربان المقدس) / تقدمة, قربان (فعل المساهمة في أموال كنيسة أو جمعية خيرية)\nمثال: قرابين لمساعدة الفقراء",
 "obligate": "إجباري (مقتصر على ظرف معين من الحياة (بيولوجيا))\nمثال: الكائن اللاهوائي الإجباري يمكنه العيش فقط في غياب الأكسجين",
 "obligate anaerobe": "لاهوائي إجباري (كائن لا يمكنه النمو في وجود الأكسجين)",
 "obligation": "وَاجِب, فَرِيضَة (اسم لما يُوجَبُ فعله؛ اسم لما صار حدوثه أكيد)\nمثال: لا شكر على واجب.",
 "obligational": "إلزامي (متعلق بـ أو يشكل أو مؤهل لإنشاء التزام قانوني أو مالي)\nمثال: سلطة إلزامية",
 "obligato": "أوبليغاتو, لحن إلزامي (جزء من المدونة الموسيقية يجب أداؤه دون تغيير أو حذف) / أوبليجاتو, لحن ملازم (موتيف مستمر ولكنه ثانوي)",
 "obligatorily": "إِجْبَارِيًّا, إِلْزَامِيًّا (بطريقة لا يمكن التهرب منها) / إجبارياً, إلزامياً (بطريقة إلزامية)\nمثال: ترى الوزارة أن المساهمات في مثل هذا الصندوق يجب أن تُلبى من التبرعات الطوعية بدلاً من الرسوم المفروضة إجبارياً",
 "obligatory": "إجباري, إلزامي (مقيد أو ملزم أخلاقياً أو قانونياً) / إِجْبَارِيّ, إِلْزَامِيّ (مطلوب بحكم الالتزام أو الإلزام أو العرف)\nمثال: الحضور إلزامي",
 "obliger": "خَدُوم, مقدم خدمات (شخص يؤدي خدمة أو يقدم معروفاً)",
 "obliging": "خَدُوم, مُجَامِل (يُبدي استعدادًا سَمْحًا لتقديم خدمات للآخرين)",
 "obligingly": "بِلُطْف, بِمُجَامَلَة (بشكل متعاون أو ملائم)\nمثال: بلطف، خفض صوته",
 "obligingness": "إذعان, امتثال (استعداد أو ميل للخضوع لإرادة الآخرين)",
 "oblique": "مُخَاتِل, مُضَلِّل (غَيْر مُبَاشِر بِالِانْحِرَاف عَنِ الطَّرِيق المَقْبُول أَوِ الصَّحِيح؛ مُضَلِّل) / مائل, منحرف (مائل أو منحرف في الاتجاه أو المسار أو الموضع - ليس متوازياً ولا متعامداً ولا قائم الزاوية) / منحرفة خارجية (عضلة بطنية مرتبة بشكل قطري على جانبي الجذع) / حالة غير الرفع (أي حالة نحوية غير حالة الرفع)\nمثال: أشعة الشمس الشتوية المائلة",
 "oblique angle": "زاوية مائلة (زاوية ليست قائمة وليست من مضاعفات الزاوية القائمة)",
 "oblique bandage": "رباط مائل (ضمادة تتقدم فيها اللفات المتتالية بشكل مائل صعوداً أو نزولاً على الطرف)",
 "oblique case": "حالة غير الرفع (أي حالة نحوية غير حالة الرفع)",
 "oblique triangle": "مثلث منحرف (مثلث لا يحتوي على زاوية قائمة)",
 "oblique vein of the left atrium": "وريد الأذين الأيسر المائل (رافد للجيب التاجي؛ يقع على الجدار الخلفي للأذين الأيسر)",
 "oblique-angled": "مُنْفَرِجُ الزَّوَايَا (ذُو زَوَايَا مَائِلَة)",
 "obliquely": "بِانْحِرَاف, بِمَيْل (بزاوية مائلة) / بشكل جانبي, بطرف العين (إلى جانب واحد أو باتجاهه)\nمثال: سطعت الشمس بميل على وجهه",
 "obliqueness": "التواء, انحراف (صفة الميل وعدم الاستقامة في المسار) / انحراف, ميلان (خاصية عدم التوازي أو التعامد، بل التواجد بزاوية مائلة)",
 "obliquity": "تضليل, خداع (صفة كون الشيء أو الشخص مخادعًا) / تلازم غير متزامن, ميلان رأس الجنين (ظهور رأس الجنين أثناء المخاض بزاوية غير طبيعية)",
 "obliterable": "قَابِلٌ لِلطَّمْس (يمكن محوه أو إزالته بالكامل)",
 "obliterate": "عَفَا (عَفَا شَعَرُ البَعِيرِ: كَثُرَ، وطَالَ فَغَطَّى دُبُرَهُ؛ عَفَا أثَرُهُ عفاءً: هَلَكَ)",
 "obliterated": "مَمْحُوّ, مُزَال (أُعِيدَ إِلَى العَدَمِ تَمَامًا)",
 "obliteration": "إبادة, طمس (التدمير عن طريق إفناء الشيء تماماً) / استئصال, طمس (التدمير الكامل لكل أثر لشيء ما)",
 "obliterator": "طامس, ماحٍ (مزيل يقضي على كل الآثار)",
 "oblivion": "نِسْيَان",
 "oblivious": "غَافِل عَن, نَاسٍ (يُخفق في تذكّر الأشياء أو يغفل عنها)",
 "obliviousness": "ذهول, غفلة تامة (النسيان التام)\nمثال: سعى إلى ذهول النوم العظيم",
 "oblong": "مُسْتَطِيل (مُنْحَرِف عَن شَكْل المُرَبَّع أَوْ الدَّائِرَة بِاسْتِطالَتِه في اتِّجاه واحِد) / مُسْتَطِيل الوَرَقَة ((عن شكل الورقة) ذو شكل مُستطيل بعض الشيء بجوانب شبه متوازية) / شكل مستطيل, مستطيل (شكل مستوٍ ينحرف عن المربع أو الدائرة بسبب الاستطالة)",
 "oblong leaf": "ورقة مستطيلة (ورقة بسيطة مستديرة عند كل طرف بجوانب متوازية)",
 "oblong woodsia": "وودسيا صدئة, وودسيا عطرية (سرخس صخري شائع في المناطق المعتدلة الشمالية ذو سويقات بنية صدئة وسعف ريشي رمحي)",
 "oblongness": "استطالة, شكل مستطيل (خاصية التشكل على هيئة مستطيل)",
 "obloquy": "اغْتِيَال مَعْنَوِيّ, افْتِرَاء (اتهام كاذب بارتكاب جريمة أو تحريف خبيث لكلمات أو أفعال شخص ما) / تشهير, خزي (حالة من العار ناتجة عن الإساءة العامة)",
 "obnoxious": "بَغِيض, ذَمِيم",
 "obnoxiously": "بِشَكْل بَغِيض, بِشَكْل مُسِيء (بطريقة بغيضة)\nمثال: قال ذلك في واحدة من جمله المتغطرسة فكرياً بشكل بغيض",
 "obnoxiousness": "بَغَاضَة, كَرَاهِيَة (صفة كون الشيء بغيضاً أو كريهاً)",
 "oboe": "أُوبُوَا",
 "oboe d'amore": "أوبوا الحب (أوبوا مضبوطة بنغمة ثالثة صغيرة أقل من الأوبوا العادية؛ تستخدم لأداء موسيقى الباروك)",
 "oboe da caccia": "أوبوا الصيد (أوبوا ألتو؛ سلف البوق الإنجليزي)",
 "oboist": "عازف أوبوا (موسيقي يعزف على الأوبوا)",
 "obolus": "أوبولوس (وحدة وزن يونانية تساوي عُشر غرام)",
 "obon": "بُون",
 "obovate": "مَقْلُوب البَيْضَوِيّ ((عن شكل الورقة) بيضاويّ مع الطرف الأضيق عند القاعدة)",
 "obovate leaf": "ورقة بيضاوية مقلوبة (ورقة على شكل بيضة نهايتها الأضيق عند القاعدة)",
 "obscene": "فَاحِش, قَذِر",
 "obscenely": "ببذاءة, بفحش (بطريقة فاحشة وبذيئة) / بشكل فاحش (لدرجة فاحشة)\nمثال: لقد رأى كيف كان الرجال والنساء البيض يمسكون ببعضهم البعض بفحش في رقصاتهم",
 "obscenity": "بذاءة, فاحشة (فعل فاحش) / بذاءة, فحش (سمة التصرف بطريقة فاحشة) / بذاءة, فحش (كلمة أو عبارة مسيئة أو غير لائقة)",
 "obscurantism": "إبهام, تعتيم (عمل متعمد يهدف إلى جعل الشيء غامضاً) / ظلامية (سياسة معارضة التنوير أو نشر المعرفة)",
 "obscurantist": "مضلل, معتم (شخص غامض بشكل متعمد)",
 "obscure": "مُظْلِم",
 "obscurely": "بِغُمُوض (بطريقة غامضة)\nمثال: هذا العمل مكتوب بغموض",
 "obscureness": "الْتِبَاس, خَفَاء (صفة كون الشيء غير واضح أو عويصاً وصعب الفهم) / إبهام, غموض (حالة كون الشيء غير واضح أو غير محدد لعدم كفاية الإضاءة) / تواضع المكانة, خمول (حالة كونه متواضعاً وغير مهم)",
 "obscurity": "إِبْهَام, خَفاء (الإِصْبَعُ الغليظةُ الخامسةُ من أَصابع اليد والرِّجل، وهي ذات سُلامَيَيْن (مؤنثة وقد تذكَّر) والجمع: أباهيم، وإبهامات)",
 "obsequious": "ذَلُول, مُتَذَلِّل (مُنْتَبِه بِأُسْلُوب تَمَلُّقِيّ أَوْ عُبُودِيّ) / مُتَزَلِّف, مُتَمَلِّق (يُحَاوِل كَسْب وُدّ ذَوِي النُّفُوذ بِالتَّمَلُّق)",
 "obsequiously": "بتذلل, بملق (بطريقة متذللة)\nمثال: تتصرف بتذلل تجاه رئيسها",
 "obsequiousness": "تذلل, تملق (خضوع ذليل أو مهين)",
 "obsequy": "جنازة, مراسم الدفن (مراسم يتم فيها دفن الميت أو حرقه)\nمثال: حضر جنازته مئات الأشخاص",
 "observable": "بَيِّن, مَلْحُوظ (يمكن رؤيته أو ملاحظته)",
 "observably": "بشكل ملحوظ, بوضوح (بطريقة ملحوظة)\nمثال: لقد تغير بشكل ملحوظ على مر السنين",
 "observance": "رصد, مراقبة (فعل المراقبة؛ أخذ نظرة متأنية) / اِحْتِرَام, اِلْتِزَام (الامتثال للقانون أو العرف أو الممارسة وما إلى ذلك) / انتباه, ملاحظة (فعل الملاحظة أو الانتباه) / احتفال رسمي, طقس (حدث رسمي يتم إجراؤه في مناسبة خاصة)\nمثال: نجا من ملاحظة الشرطة",
 "observant": "دَقِيق المُلَاحَظَة (شديد الانتباه خاصّةً إلى التفاصيل) / مُطِيع, مُلْتَزِم بِالقَانُون ((للأفراد) يلتزم بدقّة بالقوانين والقواعد والأعراف) / دَقِيقُ المُلَاحَظَة, يَقِظ (سَرِيعُ المُلَاحَظَةِ؛ يُظْهِرُ إِدْرَاكًا حَادًّا وَسَرِيعًا)",
 "observantly": "بانتباه, بيقظة (بطريقة منتبهة)",
 "observation": "رَصْد, مُشَاهَدَة (الرَّصْد : المُراقبة؛ الرَّصد الجوّي: دراسة الأَحوال الجوّيَّة لمعرفة تقلُّبات الطقس)",
 "observation dome": "قبة مراقبة (مرصد يتكون من قبة للمراقبة)",
 "observation post": "مرصد, نقطة مراقبة (موقع مرتفع يتيح رؤية واسعة)",
 "observation station": "محطة مراقبة (محطة مُعدة لإجراء ملاحظات لشيء ما)",
 "observation tower": "برج مراقبة, مرصد (هيكل يطل على مشهد واسع لمحيطه)",
 "observational": "تَجْرِيبِيّ, رَصْدِيّ (يعتمد على الملاحظة أو التجربة)",
 "observatory": "مَرْصَد",
 "observe": "لَاحَظَ, رَاقَبَ",
 "observed": "مُتَحَقَّق مِنْه, مُكْتَشَف (اكتُشِف أو حُدِّد عن طريق الملاحظة العلمية)",
 "observed fire": "نيران مرصودة (نيران يمكن لمراقب رؤية نقطة تأثيرها (الانفجار)؛ يمكن تعديل النار بناءً على الملاحظات)",
 "observer": "متفرج",
 "observer's meridian": "خط زوال الراصد (خط زوال يمر عبر سمت الراصد)",
 "observing": "دَقِيقُ المُلَاحَظَة, يَقِظ (سَرِيعُ المُلَاحَظَةِ؛ يُظْهِرُ إِدْرَاكًا حَادًّا وَسَرِيعًا)",
 "observingly": "بانتباه, بيقظة (بطريقة منتبهة)",
 "obsessed": "مَهْوُوس, مُنْشَغِل (لَدَيْهِ انْشِغَالٌ مُفْرِطٌ أَوْ قَهْرِيٌّ بِشَيْءٍ مَا) / مَسْكُون, مَهْوُوس (مُتَأَثِّرٌ أَوْ مُسَيْطَرٌ عَلَيْهِ بِقُوَّةٍ جَبَّارَةٍ كَعَاطِفَةٍ قَوِيَّة)",
 "obsession": "هَوَس",
 "obsessional": "اسْتِحْوَاذِيّ, وَسْوَاسِيّ (يتسم بالوسوسة أو يشكّلها)",
 "obsessionally": "بِقَهْر, بِهَوَس (بطريقة قهرية)\nمثال: كان ينظف حذاءه بشكل قهري بعد كل مشي",
 "obsessive": "اسْتِحْوَاذِيّ, وَسْوَاسِيّ (يتسم بالوسوسة أو يشكّلها) / مُوَسْوِس (شخص لديه وساوس)",
 "obsessive-compulsive": "وَسْوَاسِيّ قَهْرِيّ (يتسم بالوساوس والأفعال القهرية معًا) / مُصاب بِالوَسْواس القَهْرِيّ (شخص لديه خصائص الوسواس القهري)",
 "obsessive-compulsive disorder": "اِضْطِرَاب الْوَسْوَاس الْقَهْرِيّ",
 "obsessive-compulsive personality": "شخصية وسواسية قهرية (شخصية تتميز بحاجة قوية لتكرار أفعال أو طقوس معينة)",
 "obsessively": "بِقَهْر, بِهَوَس (بطريقة قهرية)\nمثال: كان ينظف حذاءه بشكل قهري بعد كل مشي",
 "obsessiveness": "استحواذ, هوس (قهرية مفرطة)",
 "obsessivity": "استحواذ, هوس (قهرية مفرطة)",
 "obsidian": "سَبَج",
 "obsolescence": "بطلان, تقادم (عملية التحول إلى شيء عفا عليه الزمن؛ الوقوع في طي الإهمال أو التقادم)\nمثال: سياسة التقادم المخطط له",
 "obsolescent": "آيِلٌ لِلتَّقَادُمِ (في طريقه إلى أن يصبح متقادماً وعتيقاً)",
 "obsolete": "عفا عليها الزمن (عَفَا شَعَرُ البَعِيرِ: كَثُرَ، وطَالَ فَغَطَّى دُبُرَهُ؛ عَفَا أثَرُهُ عفاءً: هَلَكَ)",
 "obsoleteness": "بطلان, تقادم (خاصية كون الشيء عفا عليه الزمن ولم يعد جارياً)",
 "obstacle": "عَقَبَة, حَاجِز",
 "obstacle race": "سباق الحواجز, سباق العقبات (سباق يجب على المنافسين فيه تجاوز العقبات)",
 "obstetric": "توليدي (متعلق بطب التوليد أو مستخدم فيه أو يمارسه)\nمثال: مستشفى ولادة",
 "obstetrical": "توليدي (متعلق بطب التوليد أو مستخدم فيه أو يمارسه)\nمثال: مستشفى ولادة",
 "obstetrical delivery": "توليد, ولادة (فعل توليد الطفل)",
 "obstetrical toad": "علجوم قابلة (علجوم أوروبي يحمل ذكره البيض المخصب ملفوفاً حول أرجله الخلفية حتى يفقس)",
 "obstetrician": "طبيب توليد (طبيب متخصص في التوليد)",
 "obstetrics": "طب التوليد, قبالة (فرع الطب المعني بالولادة ورعاية الأم)",
 "obstinacy": "عِنَاد",
 "obstinance": "عناد (التمسك الحازم بأفكار أو رغبات المرء) / تصلب, عناد (سمة صعوبة التعامل أو التغلب عليها)",
 "obstinate": "مُتَعَنِّت, عَنِيد",
 "obstinately": "بإصرار, بعناد (بطريقة عنيدة)\nمثال: بقيت بعناد في نفس الوضع",
 "obstipation": "إمساك شديد, انسداد الأمعاء (إمساك شديد ناتج عن انسداد في الأمعاء)",
 "obstreperous": "صاخب / مُشَاكِس",
 "obstreperously": "بصخب, بضجيج (بطريقة تجذب الانتباه)\nمثال: بصخب، طالب بالحصول على الخدمة",
 "obstreperousness": "صخب, مشاغبة (تحد صاخب)",
 "obstructed": "مسدود, معاق (مغلق أمام المرور أو الرؤية أو ممنوع من العمل)\nمثال: ممر مسدود جزئياً",
 "obstructer": "عائق, مانع (أي هيكل يجعل التقدم صعباً) / مُعَرْقِل, مُعَوِّق (شخص يعيق بشكل منهجي إجراءً يريد الآخرون اتخاذه)",
 "obstruction": "إعاقة (الوقوف في طريق شخص ما) / اعتراض, سد (فعل الاعتراض أو العرقلة) / عائق, مانع (أي هيكل يجعل التقدم صعباً) / عائق, عقبة (شيء غير مادي يقف في الطريق ويجب تجاوزه أو التغلب عليه)\nمثال: عرقلة سير العدالة",
 "obstruction of justice": "إعاقة العدالة, عرقلة سير العدالة (إعاقة أولئك الذين يسعون لتحقيق العدالة في المحكمة (مثل محاولة التأثير على المحلفين أو الشهود))",
 "obstructionism": "تَعْطِيل, عَرْقَلَة (التدخل المتعمد للإعاقة)",
 "obstructionist": "مُعَرْقِل, مُعَوِّق (شخص يعيق بشكل منهجي إجراءً يريد الآخرون اتخاذه)",
 "obstructive": "مُعَرْقِل, مُعِيق (يمنع الحركة ويعوق التقدّم)",
 "obstructive shock": "صدمة انسدادية (صدمة ناتجة عن انسداد تدفق الدم)",
 "obstructively": "بشكل معيق (بطريقة تعيق وتعرقل)\nمثال: تصرف بشكل معيق للغاية عندما حاولنا تنفيذ مشروعنا",
 "obstructor": "عائق, مانع (أي هيكل يجعل التقدم صعباً) / مُعَرْقِل, مُعَوِّق (شخص يعيق بشكل منهجي إجراءً يريد الآخرون اتخاذه)",
 "obstruent": "صوت إعاقة (صامت يُنتج بانسداد جزئي أو كلي لتدفق الهواء من الرئتين عبر الأنف أو الفم)",
 "obtain": "حَصَلَ (الشيء: حَصَلَ عليه؛ العلم: أخَذَه وحَازَه)\nمثال: متى حصل الحادث؟",
 "obtainable": "يُمْكِن الحُصُول عَلَيْه (قابل للحصول عليه واقتنائه)",
 "obtainment": "تحصيل, حصول (فعل الحصول على)",
