 "nicker seed": "بندق هندي, جوز البندق (بذرة رمادية لامعة صلبة لشجرة البندق الهندي؛ تستخدم لصنع المجوهرات مثلاً)",
 "nicknack": "تحف صغيرة, حلي رخيصة (تحف متنوعة صغيرة)",
 "nickname": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الدَّلَع (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)\nمثال: في حقيقة الأمر، كان زيري يعرف لقب ريمة.",
 "nicol prism": "موشور نيكول (جهاز بصري ينتج ضوءاً مستقطباً مستوياً)",
 "nicole": "نيكول",
 "nicosia": "نِيقُوسِيَا / لِفْقُسِيَة",
 "nicotiana alata": "تبغ الياسمين, تبغ مزهر (نبات معمر للزينة من أمريكا الجنوبية له زهور بيضاء مخضرة عطرة ليلاً)",
 "nicotiana glauca": "تبغ شجري, شجرة الخردل (شجيرة دائمة الخضرة من أمريكا الجنوبية تم توطينها في الولايات المتحدة؛ مسؤولة أحياناً عن تسمم الماشية)",
 "nicotiana rustica": "تبغ بري, تبغ هندي (نبات تبغ من أمريكا الجنوبية والمكسيك)",
 "nicotiana tabacum": "تبغ شائع (عشب طويل منتصب من أمريكا الجنوبية بأوراق بيضاوية كبيرة وعناقيد طرفية من الزهور الأنبوبية البيضاء أو الوردية؛ يزرع لأوراقه)",
 "nicotinamide adenine dinucleotide": "ثنائي نوكليوتيد الأدنين والنيكوتيناميد (مرافق إنزيم موجود في معظم الخلايا الحية ومشتق من فيتامين ب (حمض النيكوتينيك)؛ يعمل كعامل اختزال في عمليات التمثيل الغذائي المختلفة)",
 "nicotinamide adenine dinucleotide phosphate": "فوسفات ثنائي نوكليوتيد الأدنين والنيكوتيناميد",
 "nicotine": "نِيكُوتِين",
 "nicotine addiction": "إدمان النيكوتين (إدمان على النيكوتين)",
 "nicotine poisoning": "تسمم بالنيكوتين (حالة تسمم ناتجة عن تناول أو استنشاق كميات كبيرة من النيكوتين)",
 "nicotinic acid": "حمض النيكوتينيك, نياسين (فيتامين ب ضروري للوظيفة الطبيعية للجهاز العصبي والجهاز الهضمي)",
 "nictation": "رفة عين, رمش (منعكس يغلق ويفتح العينين بسرعة)",
 "nictitating membrane": "جفن ثالث, غشاء راف (طية واقية من الجلد في عيون الزواحف والطيور وبعض الثدييات)",
 "nictitation": "رفة عين, رمش (منعكس يغلق ويفتح العينين بسرعة)",
 "nicu": "وحدة العناية المركزة لحديثي الولادة (وحدة عناية مركزة مصممة بمعدات خاصة لرعاية الأطفال حديثي الولادة المبتسرين أو المصابين بمرض خطير)",
 "nidation": "انغراس, تعشيش ((علم الأجنة) العملية العضوية التي تنغرس فيها البويضة المخصبة في بطانة الرحم لدى الثدييات المشيمية)",
 "niddm": "السكري غير المعتمد على الأنسولين, السكري من النوع الثاني (شكل خفيف من داء السكري يتطور تدريجيًا لدى البالغين؛ يمكن أن يحدث بسبب السمنة أو الإجهاد الشديد أو انقطاع الطمث أو عوامل أخرى؛ يمكن السيطرة عليه عادة…)",
 "nidicolous": "عشّي, ملازم للعش ((للطيور) البقاء في العش لفترة بعد الفقس)",
 "nidifugous": "مغادر للعش, نافر من العش ((للطيور) مغادرة العش بعد الفقس بفترة قصيرة)",
 "nidus": "عُشّ (عش تضع فيه العناكب أو الحشرات بيضها) / بؤرة, بؤرة الإصابة (نقطة مركزية أو موضع العدوى في كائن حي)\nمثال: بؤرة العدوى",
 "niece": "بِنْتُ أَخٍ, بِنْتُ أُخْتٍ",
 "niello": "فِضَّة مُحْرَقَة, مِينَا (فِي : فِلِزّ أَبْيَض قَابِلٌ لِلسَّحب والطَّرْق والصَّقْل، من أكثر المواد توصيلاً للحَرَارَة والكَهْرَبَاء…)\nمثال: يقدر القبايل الفضة أكثر من الذهب.",
 "niemann-pick disease": "داء نيمان-بيك (اضطراب في استقلاب الدهون يتم توريثه كسمة متنحية)",
 "nierembergia": "زهرة الكأس, نيرمبيرجيا",
 "nierembergia frutescens": "كأسية الزهرة الطويلة, نيرمبيرجيا (عشب شجيري تشيلي له زهور أنبوبية بيضاء مزرقة يستخدم للزينة)",
 "nierembergia repens": "كأس أبيض, نيرمبيرجيا زاحفة (عشب خشبي مفترش من أمريكا الجنوبية بزهور أنبوبية بيضاء غالباً مشوبة بالأزرق أو الوردي)",
 "nierembergia rivularis": "كأس أبيض, نيرمبيرجيا زاحفة (عشب خشبي مفترش من أمريكا الجنوبية بزهور أنبوبية بيضاء غالباً مشوبة بالأزرق أو الوردي)",
 "nietzsche": "نِتْشَه, نِتْشَة",
 "nietzschean": "نِتْشِيّ",
 "nietzscheanism": "نيتشوية (النظريات الفلسفية لنيتشه التي تدعو إلى التغلب على كل من العدمية المهددة وأخلاق العبيد (كما تمثلت له في المسيحية التاريخية) من خلال إعادة تقييم جميع…)",
 "nifedipine": "بروكارديا, نيفيديبين (حاصر للكالسيوم (الاسم التجاري بروكارديا)؛ يبدو أنه يزيد من خطر تكرار النوبات القلبية)",
 "niff": "رائحة كريهة, رائحة نفاذة (رائحة غير مستحبة)",
 "niffy": "كَرِيهُ الرَّائِحَة ((عَامِّيَّة بِرِيطَانِيَّة) ذُو رَائِحَةٍ كَرِيهَةٍ)",
 "nifty": "رَائِع, مُمْتَاز (ممتاز؛ بالغ الجودة)",
 "nigella": "شُونِيز",
 "nigella damascena": "حب في الضباب, حبة البركة الدمشقية (نبات حديقة أوروبي ذو أوراق مقطوعة بدقة وزهور بيضاء أو زرقاء شاحبة)",
 "nigella hispanica": "حبة البركة الإسبانية, زهرة الشمر (حبة بركة من إسبانيا وجنوب فرنسا)",
 "nigella sativa": "حبة البركة, حبة سوداء (عشبة من منطقة البحر الأبيض المتوسط ذات بذور لاذعة تستخدم مثل بذور الكراوية)",
 "niger": "النِّيجَر",
 "niger franc": "فرنك نيجري (وحدة المال الأساسية في النيجر)",
 "niger-congo": "النيجرية الكنغولية (عائلة لغوية أفريقية يتم التحدث بها في غرب أفريقيا)",
 "niger-kordofanian": "النيجرية الكردفانية (عائلة اللغات التي تشمل معظم اللغات التي يتم التحدث بها في أفريقيا جنوب الصحراء الكبرى)",
 "niger-kordofanian language": "النيجرية الكردفانية (عائلة اللغات التي تشمل معظم اللغات التي يتم التحدث بها في أفريقيا جنوب الصحراء الكبرى)",
 "nigeria": "نِيجِيرِيَا, نَايْجِيرِيَا",
 "nigerian": "نيجيري (من أو متعلق بشعب نيجيريا) / نيجيري (من أو متعلق بنيجيريا) / نَيْجِيرِيّ (مواطن أو ساكن في نيجيريا)\nمثال: روائي نيجيري فاز بجائزة نوبل للأدب هذا العام",
 "nigerian monetary unit": "وحدة نقدية نيجيرية (الوحدة النقدية في نيجيريا)",
 "nigerien": "نيجيري (من أو متعلق بشعب نيجيريا) / نَيْجَرِيّ (مواطن أو ساكن في النيجر)\nمثال: روائي نيجيري فاز بجائزة نوبل للأدب هذا العام",
 "nigga": "زنجي ((إهانة عرقية) اسم مهين للغاية لشخص أسود)\nمثال: فقط الأسود يمكنه تسمية أسود آخر بهذا الاسم",
 "niggard": "بخيل, شحيح (شخص أناني غير راغب في العطاء أو الإنفاق)",
 "niggardliness": "خسة, شح (بخل شديد)",
 "niggardly": "بَخِيل (الجمع : بُخَلاءُ ، المؤنث : بخيلة ، و الجمع للمؤنث : بخيلات و بُخَلاءُ؛ شَحِيْح، مُقْتِر)\nمثال: بئس الرجل البخيل.",
 "niggardness": "خسة, شح (بخل شديد)",
 "nigger": "زِنْجِيّ / زَنْجِيّ / أَسْوَد (هو لَوْن مُظلم غَامِق لا يُبان منه. سميّ كذلك لأنه يسود على غيره من الألوان لظلامه؛ هو انعدام اللَوْن) / عَبْد (خلاف الحُرّ، المَمْلُوْك، من له مالك يملكه. الجمع عبيد وأعبد وعِبدان وعُبدان؛ الإنسان حرا كان أم لا مؤمنا كان أن ملحدا من حيث أنه مملوك لله)\nمثال: لديه قميص أسود.",
 "niggler": "كثير الانتقاد, متصيد للأخطاء (شخص ينتقد باستمرار بطريقة تافهة)",
 "niggling": "تَافِه, زَهِيد ((غير رسمي) صغير ولا أهمّيّة له)",
 "nigh": "قَرِيب / بُالْقُرب مِن",
 "nigher": "أقرب ((صيغة المقارنة لـ قريب) ضمن مسافة أقصر)\nمثال: تعال أقرب يا عزيزي!",
 "nighest": "الأقرب ((صيغة التفضيل لـ قريب) ضمن أقصر مسافة)\nمثال: كان ذلك الوقت الذي اقترب فيه الأقرب إلى الموت",
 "night": "لَيْلَة, لَيْل (واحِدَة اللَيْل، وهو الزمن في اليوم من مَغْرِب الشمس حتى طلوع الفَجْر. قيل الليل والليلة واحد وقيل الليل ضد النهار والليلة ضد اليوم وقيل الليلة مفرد…؛ أحيانا تستخدم بمعنى اليَوْم كما يستخدم اليوم بمعنى النَهَار) / عشية, ليلة / مَغْرِب, مغْرب (مَكَان غُرُوب الشَمْس، ويقصد به الغَرْب مجَازًا؛ زَمَان غروب الشمس)\nمثال: كانت ليلة رائعة.",
 "night bell": "جرس ليلي (جرس باب يستخدم في الليل)",
 "night bird": "طائر ليلي (أي طائر مرتبط بالليل: بومة، عندليب، سبد، إلخ)",
 "night blindness": "عشى, عشى ليلي (عدم القدرة على الرؤية بوضوح في الضوء الخافت؛ بسبب نقص فيتامين أ أو اضطراب في الشبكية)",
 "night club": "ملهى ليلي, نادي ليلي (مكان يفتح في وقت متأخر من الليل ويوفر الترفيه (مثل المغنين أو الراقصين) بالإضافة إلى الرقص والطعام والشراب)\nمثال: لا تتوقع وجبة جيدة في ملهى ليلي",
 "night court": "محكمة ليلية (محكمة جنائية (في المدن الكبيرة) تعقد جلساتها في الليل)",
 "night game": "مباراة ليلية (مباراة تُلعب تحت إضاءة صناعية في الليل)",
 "night heron": "بلشون الليل (طيور بلشون ليلية أو تنشط عند الغسق)",
 "night jasmine": "ملكة الليل, ياسمين الليل (شجيرة دائمة الخضرة من جزر الهند الغربية لها عناقيد من الزهور البيضاء الصفراء القمعية الشكل التي تكون عطرة في الليل)",
 "night jessamine": "ملكة الليل, ياسمين الليل (شجيرة دائمة الخضرة من جزر الهند الغربية لها عناقيد من الزهور البيضاء الصفراء القمعية الشكل التي تكون عطرة في الليل)",
 "night latch": "مزلاج ليلي (قفل باب يعمل بمقبض من الداخل ومفتاح من الخارج)",
 "night letter": "برقية ليلية (شكل أرخص من البرقيات يرسل للتسليم في اليوم التالي)",
 "night life": "حياة الليل, سهر (نشاط الأشخاص الذين يبحثون عن الترفيه الليلي (كما في المسرح أو الملهى الليلي وما إلى ذلك)) / حياة ليلية, سهر (الترفيه المتاح للأشخاص الذين يبحثون عن التسلية ليلاً)\nمثال: في الصيف تنتقل الحياة الليلية إلى نوادي الرقص",
 "night lizard": "سحلية ليلية (سحلية ليلية صغيرة كتومة من جنوب غرب أمريكا الشمالية وكوبا؛ تلد صغاراً أحياء)",
 "night market": "اَلسُّوق اَللَّيْلِيّ",
 "night owl": "بومة الليل, ساهر (شخص يحب أن يكون نشطاً في وقت متأخر من الليل)",
 "night porter": "بَوَّاب لَيْلِيّ (بواب يعمل خلال فترة الليل)",
 "night raven": "غراب الليل (أي طائر يصيح في الليل) / بلشون الليل (طيور بلشون ليلية أو تنشط عند الغسق)",
 "night rider": "فارس الليل (عضو في عصابة سرية ممتطية في جنوب الولايات المتحدة بعد الحرب الأهلية الأمريكية؛ ارتكبوا أعمال ترهيب وانتقام)",
 "night school": "مدرسة ليلية (مدرسة تعقد فصولاً في المساء للطلاب الذين لا يستطيعون الحضور أثناء النهار)",
 "night shift": "وردية ليلية (عمال يعملون أثناء الليل (مثل من منتصف الليل إلى 8 صباحًا)) / وردية ليلية (نوبة العمل أثناء الليل (مثل منتصف الليل إلى 8 صباحاً))",
 "night snake": "ثعبان ليلي (ثعبان ليلي متجول من غرب الولايات المتحدة والمكسيك)",
 "night soil": "سماد بشري, فضلات بشرية (فضلات بشرية تستخدم كسماد)",
 "night sweats": "فَرْط التَّعَرُّق اللَّيْلِيّ",
 "night terror": "ذعر ليلي (نوبة عاطفية (عادة عند الأطفال الصغار) يستيقظ فيها الشخص مرعوباً مع شعور بالقلق والخوف دون تذكر الحادث المسبب)",
 "night vision": "رُؤْيَة لَيْلِيَّة",
 "night watch": "النوبة الليلية, نوبة آخر الليل (نوبة حراسة أثناء الليل (كما من منتصف الليل إلى 8 صباحاً))",
 "night watcher": "حارِس لَيْلِيّ (حارس يعمل خلال الليل)",
 "night watchman": "حارس ليلي, ناطور ليلي (حارس ذكر يعمل أثناء الليل)",
 "night watchwoman": "حارسة ليلية (حارسة أنثى تعمل أثناء الليل)",
 "night-blooming cereus": "شمعية ليلية الإزهار (أي من الصباريات المتعددة من جنس الشمعية) / شمعية ليلية الإزهار (أي من الصباريات المتعددة من جنس هيلوسيريوس) / شمعية ليلية الإزهار (أي من الصباريات الليلية الإزهار المتعددة من جنس سيلينيسيريوس)",
 "night-light": "سهارة, ضوء ليلي (ضوء (مثل شمعة أو مصباح صغير) يضيء في غرفة النوم ليلاً (كما للأطفال أو المرضى))",
 "night-line": "خيط صيد ليلي (خيط صيد مزود بخطافات مطعمة يُترك في الماء لصيد السمك طوال الليل)",
 "night-robe": "قميص نوم (لانجري يتكون من فستان فضفاض مصمم لترتديه النساء في السرير)",
 "night-sight": "رؤية في الظلام, رؤية ليلية (القدرة على الرؤية في إضاءة منخفضة (كما في ضوء القمر))",
 "night-stop": "توقف ليلي, مبيت (استراحة في رحلة لقضاء الليل)",
 "nightbird": "بومة الليل, ساهر (شخص يحب أن يكون نشطاً في وقت متأخر من الليل)",
 "nightcap": "المباراة الختامية (المباراة الأخيرة في سلسلة من مباراتين متتاليتين) / قبعة نوم (قبعة قماشية تلبس في السرير) / مشروب قبل النوم (مشروب كحولي يؤخذ عند وقت النوم)",
 "nightclothes": "ملابس نوم (ملابس مصممة للارتداء في السرير)",
 "nightclub": "نَادٍ لَيْلِيّ, النَادِي اللَيْلِيّ",
 "nightcrawler": "دودة الأرض (دودة برية تحفر في التربة وتساعد في تهويتها؛ تظهر غالباً عندما تكون الأرض باردة أو رطبة؛ تستخدم كطعم من قبل الصيادين)",
 "nightdress": "قميص نوم (لانجري يتكون من فستان فضفاض مصمم لترتديه النساء في السرير)",
 "nighted": "أَدْرَكَهُ اللَّيْل (فاجأه الليل أو أحاطت به الظلمة)",
 "nightfall": "هُبُوط, غَسَق",
 "nightgown": "قميص نوم (لانجري يتكون من فستان فضفاض مصمم لترتديه النساء في السرير)",
 "nighthawk": "صقر الليل (سبد ليلي بشكل رئيسي من أمريكا الشمالية) / بومة الليل, ساهر (شخص يحب أن يكون نشطاً في وقت متأخر من الليل)",
 "nightie": "قميص نوم (لانجري يتكون من فستان فضفاض مصمم لترتديه النساء في السرير)",
 "nightingale": "عَنْدَلِيب, بلبل",
 "nightjar": "سبد (طيور غير جاثمة شفقية أو ليلية بشكل رئيسي بريش بني رمادي مبقع وعيون كبيرة؛ تتغذى على الحشرات)",
 "nightlife": "حياة الليل, سهر (نشاط الأشخاص الذين يبحثون عن الترفيه الليلي (كما في المسرح أو الملهى الليلي وما إلى ذلك)) / حياة ليلية, سهر (الترفيه المتاح للأشخاص الذين يبحثون عن التسلية ليلاً)\nمثال: في الصيف تنتقل الحياة الليلية إلى نوادي الرقص",
