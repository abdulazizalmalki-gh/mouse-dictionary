 "one o'clock": "اَلسَّاعَة اَلْوَاحِدَة",
 "one of the boys": "واحد من الشباب (رجل تم قبوله اجتماعياً في مجموعة من الرجال الآخرين)\nمثال: سرعان ما أصبح واحداً من الشباب",
 "one percent": "جُزْء مِن مِائَة, وَاحِد بِالْمِائَة (جزء واحد من مائة جزء متساوي)",
 "one shot": "جولة, طلقة (شحنة ذخيرة لطلقة واحدة)",
 "one thousand": "أَلْف (يَدُلُّ عَلَى العَدَد 1000) / أَلْف (العدد الأصلي الذي هو حاصل ضرب 10 في 100)",
 "one thousand million": "بِلْيُون, مِلْيَار (العدد الذي يمثله واحد متبوعاً بـ 9 أصفار)",
 "one thousand thousand": "مِلْيُون (العدد الذي يمثله واحد متبوعاً بـ 6 أصفار)",
 "one time": "في إحدى المرات, مرة (في مناسبة واحدة)\nمثال: قابلتها مرة",
 "one way or another": "بِطَرِيقَةٍ أَو بِأُخرَى",
 "one-act play": "مسرحية الفصل الواحد (مسرحية قصيرة تتكون من فصل واحد)",
 "one-acter": "مسرحية الفصل الواحد (مسرحية قصيرة تتكون من فصل واحد)",
 "one-and-one": "واحد وواحد (رمية حرة يجب تسجيلها لكسب الحق في رمية حرة ثانية)",
 "one-armed": "أَحَادِيّ الذِّرَاع (ذو ذراع واحدة فقط)",
 "one-armed bandit": "آلة القمار, سلوت (آلة قمار تستخدم للمقامرة)\nمثال: يقضون ساعات وساعات في لعب آلات القمار",
 "one-billionth": "جُزْء مِن بِلْيُون, جُزْء مِن مِلْيَار (جزء واحد من مليار جزء متساوي)",
 "one-celled": "أُحَادِيّ الخَلِيَّة (ذو خليّة واحدة (وبالتالي غير منقسم إلى خلايا))",
 "one-dimensional": "أحادي البعد, خطي (من أو في أو على طول أو يتعلق بخط؛ ينطوي على أو له بعد واحد) / أحادي البعد, سطحي (يتعلق ببعد أو جانب واحد؛ ليس له عمق أو نطاق)\nمثال: قياس طولي",
 "one-dimensional language": "لغة أحادية البعد (لغة برمجة يتم تمثيل تعبيراتها بواسطة سلاسل من الأحرف)",
 "one-dimensionality": "أحادية البعد, خطية (خاصية امتلاك بعد واحد)",
 "one-eared": "ذُو أُذُن وَاحِدَة (لديه أذن واحدة)",
 "one-eighth": "ثُمْن (جزء واحد من ثمانية أجزاء متساوية)",
 "one-eyed": "أَعْوَر, عَوْرَاء",
 "one-fifth": "خُمْس (جزء واحد من خمسة أجزاء متساوية)",
 "one-flowered pyrola": "بيرولا وحيدة الزهرة (عشب قزم دائم الخضرة ورقيق في المناطق المعتدلة الشمالية له زهرة طرفية بيضاء وحيدة؛ يوضع أحياناً في جنس بيرولا)",
 "one-flowered wintergreen": "بيرولا وحيدة الزهرة (عشب قزم دائم الخضرة ورقيق في المناطق المعتدلة الشمالية له زهرة طرفية بيضاء وحيدة؛ يوضع أحياناً في جنس بيرولا)",
 "one-fourth": "رُبْع (واحد من أربعة أجزاء متساوية)",
 "one-half": "نِصْف (واحد من جزأين متساويين لكل قابل للقسمة)\nمثال: نصف رغيف",
 "one-handed": "أُحَادِيُّ اليَد (يستخدم يداً واحدة أو مُصمَّم لها)",
 "one-hitter": "مباراة بضربة واحدة (مباراة لا يسمح فيها الرامي للفريق المنافس سوى بضربة واحدة)",
 "one-horse": "تَافِه, نَائِي (صغير ونائي وعديم الأهمية)",
 "one-humped": "وحيد السنام (يمتلك سناماً واحداً)\nمثال: جمل وحيد السنام",
 "one-hundred-millionth": "جُزْء مِن مِائَة مِلْيُون (جزء واحد من مائة مليون جزء متساوي)",
 "one-hundred-thousandth": "جُزْء مِن مِائَة أَلْف (جزء واحد من مائة ألف جزء متساوي)",
 "one-hundredth": "جُزْء مِن مِائَة, وَاحِد بِالْمِائَة (جزء واحد من مائة جزء متساوي)",
 "one-liner": "نُكْتَة السَّطْر الْوَاحِد (نكتة مكونة من سطر واحد)",
 "one-man rule": "استبدادية, دكتاتورية (شكل من أشكال الحكم يكون فيه الحاكم دكتاتوراً مطلقاً (غير مقيد بدستور أو قوانين أو معارضة وما إلى ذلك))",
 "one-member": "أُحَادِيُّ التَّمْثِيل (قائم على نظام يكون فيه عضو واحد فقط عن كل دائرة)",
 "one-millionth": "جُزْء مِن مِلْيُون (جزء واحد من مليون جزء متساوي)",
 "one-night stand": "لِقَاء جِنْسِيّ لِلَيْلَة وَاحِدَة (وجود اثنين أو أكثر معًا، صدفةً أو تدبيرًا)\nمثال: اريد لقاء والدك",
 "one-ninth": "تُسْع (جزء واحد من تسعة أجزاء متساوية)",
 "one-off": "حدث لمرة واحدة (حدث يقع مرة واحدة فقط ولا يتكرر)",
 "one-on-one": "شخصاً لشخص, فرداً لفرد ((لشخصين) في لقاء مباشر) / رَجُلٌ لِرَجُل, فَرْدِيّ (نظام لعب يراقب فيه كل لاعب دفاعيّ لاعبًا هجوميًّا بعينه) / فَرْدِيّ, وَجْهًا لِوَجْه (بين شخصين مباشرةً)\nمثال: فضل تسوية الأمر فرداً لفرد",
 "one-party": "أُحَادِيّ الحِزْب (يُحدَّد من قبل حزب واحد)",
 "one-piece": "قطعة واحدة ((للملابس) يتكون من أو مصمم كقطعة واحدة كاملة)\nمثال: رداء من قطعة واحدة",
 "one-quadrillionth": "جُزْء مِن كُوَادرِيلْيُون (جزء واحد من كوادريليون جزء متساوي)",
 "one-quarter": "رُبْع (واحد من أربعة أجزاء متساوية)",
 "one-quintillionth": "جُزْء مِن كُوينتِيلْيُون (جزء واحد من كوينتيليون جزء متساوي)",
 "one-seed": "أُحَادِيُّ البَذْرَة (يحتوي على بذرة واحدة فقط)",
 "one-seeded": "أُحَادِيُّ البَذْرَة (يحتوي على بذرة واحدة فقط)",
 "one-seventh": "سُبْع (جزء واحد من سبعة أجزاء متساوية)",
 "one-sided": "أُحَادِيّ الجَانِب, مِن طَرَف وَاحِد (يشمل جزءاً أو جانباً واحداً فقط) / مُتَحَيِّز, مُنْحَاز (يُفَضِّلُ شَخْصًا أَوْ طَرَفًا عَلَى آخَر) / أحادي الوجه, غير قابل للقلب (غير قابل للعكس أو لاستخدام أي من الجانبين للخارج)\nمثال: شلل أحادي الجانب",
 "one-sidedly": "أُحَادِيًّا, مِن طَرَف وَاحِد (بطريقة أحادية الجانب؛ بواسطة جزء أو طرف واحد)\nمثال: توصلوا إلى اتفاق بشكل أحادي",
 "one-sixteenth": "جُزْء مِن سِتَّة عَشَر (جزء واحد من ستة عشر جزءاً متساوياً)",
 "one-sixth": "سُدْس (جزء واحد من ستة أجزاء متساوية)",
 "one-sixtieth": "جُزْء مِن سِتِّين (جزء واحد من ستين جزءاً متساوياً)",
 "one-sixty-fourth": "جُزْء مِن أَرْبَعَة وَسِتِّين (جزء واحد من أربعة وستين جزءاً متساوياً)",
 "one-spot": "واحد (حجر دومينو أو نرد يظهر وجهه العلوي نقطة واحدة)",
 "one-step": "خطوة واحدة, ون ستيب (رقصة صالونات مبكرة؛ سابقة لرقصة الفوكس تروت)",
 "one-ten-thousandth": "جُزْء مِن عَشَرَة آلَاف (جزء واحد من عشرة آلاف جزء متساوي)",
 "one-tenth": "عُشْر (جزء من عشرة؛ جزء واحد من عشرة أجزاء متساوية)",
 "one-third": "ثُلْث (واحد من ثلاثة أجزاء متساوية لكل قابل للقسمة)\nمثال: يحتوي على حوالي ثلث الحد الأدنى من الاحتياجات اليومية",
 "one-thirty-second": "جُزْء مِن اثْنَيْن وَثَلَاثِين (جزء واحد من اثنين وثلاثين جزءاً متساوياً)",
 "one-thousandth": "جُزْء مِن أَلْف, وَاحِد بِالأَلْف (جزء واحد من ألف جزء متساوي)",
 "one-to-one": "وَاحِدٌ لِوَاحِد (يصف علاقة يرتبط فيها كل عنصر من مجموعة بعنصر واحد من مجموعة ثانية)",
 "one-trillionth": "جُزْء مِن تِرِيلْيُون (جزء واحد من تريليون جزء متساوي)",
 "one-twelfth": "جُزْء مِن اثْنَيْ عَشَر (جزء واحد من اثني عشر جزءاً متساوياً)",
 "one-upmanship": "تفوق, حب الظهور (ممارسة البقاء متقدمًا بخطوة واحدة على صديق أو منافس)",
 "one-way": "ذُو اِتِّجَاه وَاحِد (يتحرك أو يسمح بالحركة في اتجاه واحد فقط)",
 "one-way light time": "زمن الضوء باتجاه واحد (الوقت المنقضي الذي يستغرقه الضوء (أو الإشارات الراديوية) للسفر بين الأرض وجرم سماوي)",
 "one-way street": "شارع ذو اتجاه واحد (شارع يُسمح فيه لحركة مرور المركبات بالتحرك في اتجاه واحد فقط) / طريق باتجاه واحد (تفاعل أحادي الجانب)\nمثال: لا يمكن أن يكون التعاون طريقاً باتجاه واحد",
 "one-winged": "وَحِيد الْجَنَاح (له جناح واحد فقط)",
 "one-year": "حولي, سنوي (يكمل دورة حياته في غضون عام)\nمثال: حدود من النباتات المزهرة الحولية",
 "one-year-old": "بِعُمُر سَنَة وَاحِدَة (في عامه الأوّل من العمر)",
 "onega": "بُحَيْرَة أُوْنِيغَا (مسطح مائي واسع كالبحر المغلق فيه ماء حلو أو شبه حلو صالح للشرب)\nمثال: سبحنا في البحيرة.",
 "oneida": "لغة أونيدا (اللغة الإيروكوية التي يتحدث بها شعب أونيدا) / أونيدا (فرد من شعب إيروكواس كان يعيش سابقاً شرق بحيرة أونتاريو)",
 "oneida language": "لغة أونيدا (اللغة الإيروكوية التي يتحدث بها شعب أونيدا)",
 "oneiric": "حلم (رأى في نومه)\nمثال: هذا الحلم سيتحقق.",
 "oneirism": "أحلام اليقظة, سرحان (الحلم بشرود ذهن أثناء اليقظة)",
 "oneiromancer": "مفسر أحلام (شخص يتنبأ من خلال تفسير الأحلام)",
 "oneiromancy": "تفسير الأحلام (التنجيم من خلال تفسير الأحلام)",
 "oneness": "وَحْدَانِيَّة, وحدَة",
 "onerous": "شاقّ, مُرْهِق (صَعْب التَّحَمُّل؛ يُسَبِّب إرْهاقًا وعَناءً)",
 "onerously": "بثقل, بشكل مرهق (بطريقة شاقة)",
 "onerousness": "ثقل, وطأة (صعوبة ثقيلة غير مرغوب فيها)",
 "oneself": "نَفْس (النَّفْسُ : الرُّوحُ؛ النَّفْسُ :الدَّمُ، فشاهده قول السموأَل: تَسِيلُ على حَدِّ الظُّبَّاتِ نُفُوسُنَا…)\nمثال: هم في نفس السن.",
 "ongoing": "دَائِر, مُسْتَمِرّ (يحدث الآن بشكل مستمر)",
 "ongoing evaluation": "تقييم مستمر (تقييم يتم إجراؤه أثناء مرحلة تنفيذ المشروع)",
 "oni": "مكتب الاستخبارات البحرية (وكالة الاستخبارات العسكرية التي توفر متطلبات الاستخبارات والاستخبارات المضادة والتحقيق والأمن للبحرية الأمريكية)",
 "onigiri": "أُونِيجِيرِي",
 "onion": "بَصَل / بصل / بصلة / بُصَل",
 "onion bagel": "بيغل بالبصل (بيغل منكه بالبصل)",
 "onion bread": "خبز البصل (خبز يحتوي على بصل مفروم ناعماً)",
 "onion butter": "زبدة البصل (زبدة ممزوجة بالبصل المفروم)",
 "onion dome": "قبة بصلية (قبة تشبه شكل البصلة؛ مميزة للعمارة الكنسية الروسية والبيزنطية)",
 "onion louse": "تربس البصل (ضار بنباتات البصل وأحياناً التبغ)",
 "onion mildew": "بياض البصل (فطر يسبب بياضاً زغبياً على البصل)",
 "onion plant": "بصل (نبات بصلي له أوراق مجوفة يزرع في جميع أنحاء العالم لبصلته المستديرة الصالحة للأكل)",
 "onion roll": "لفافة البصل (لفافة مخمرة بالخميرة منكهة بالبصل)",
 "onion salt": "ملح البصل (بصل مجفف مطحون وملح)",
 "onion seed": "قِزْح",
 "onion smut": "تفحم البصل (فطر تفحم يسبب بثوراً سوداء على قشور وأوراق البصل؛ مدمر بشكل خاص للشتلات)",
 "onion stem": "ساق البصل (غاريقون أبيض يميل إلى التجمع وله قاعدة صولجانية الشكل)",
 "onion thrips": "تربس البصل (ضار بنباتات البصل وأحياناً التبغ)",
 "onion yellow dwarf": "تقزم البصل الأصفر (مرض التقزم الأصفر لنباتات البصل)",
 "onion yellow-dwarf virus": "فيروس التقزم الأصفر للبصل (الفيروس الذي يسبب التقزم واصفرار أوراق نبات البصل)",
 "onionskin": "ورق قشر البصل (ورق رقيق قوي خفيف الوزن وشفاف يستخدم خاصة لعمل نسخ كربونية)",
 "onkos": "أونكوس (غطاء رأس مرتفع ومزخرف كان يرتديه ممثلو التراجيديا اليونانية)\nمثال: أضاف الأونكوس طولاً وهيبة لمرتديه",
 "online": "عَلَى الخَطِّ, مُتَّصِل (قيد التنفيذ الآن) / أونلاين, على الشبكة (متصل بشبكة كمبيوتر أو يمكن الوصول إليه عبر الكمبيوتر) / ضمن المسار, على الخط (على مسار منتظم لنظام سكة حديد أو حافلة أو طيران) / أونلاين, عبر الإنترنت (من خلال جهاز كمبيوتر أو شبكة كمبيوتر)\nمثال: قاعدة بيانات متصلة",
 "onlooker": "متفرج (شخص ينظر ويراقب)",
 "only": "وَحِيد / فَقَط (لا أكثر، لا غير) / مثال: فقط تنفس طبيعي.",
 "only too": "جِدًّا, لِلْغَايَة (بدرجة عالية)\nمثال: هي مستعدة للغاية لقبول الوظيفة",
 "onobrychis viciaefolia": "سانفوان, عنبريس (عشب معمر أوراسي له أزهار وردية شاحبة وقرون منحنية؛ مستوطن في بريطانيا ومراعي أمريكا الشمالية في التربة الجيرية؛ محصول علف مهم ومصدر للعسل في بريطانيا)",
 "onobrychis viciifolia": "سانفوان, عنبريس (عشب معمر أوراسي له أزهار وردية شاحبة وقرون منحنية؛ مستوطن في بريطانيا ومراعي أمريكا الشمالية في التربة الجيرية؛ محصول علف مهم ومصدر للعسل في بريطانيا)",
 "onoclea sensibilis": "أونوكليا, سرخس الخرز (سرخس منتشر جميل في شرق أمريكا الشمالية وشرق آسيا تم توطينه في أوروبا الغربية؛ يُظهر السعف المقسم ريشياً ميلاً طفيفاً للطي عند لمسه؛ تحيط الوريقات…)",
 "onoclea struthiopteris": "رأس الكمان, سرخس النعامة (سرخس طويل من المناطق المعتدلة الشمالية له سعف مقوس رشيق وأبواغ تشبه ريش النعام)",
 "onomancer": "عرّاف الأسماء (من يمارس العرافة بالأسماء)",
 "onomancy": "عرافة الأسماء (التنجيم بواسطة أحرف الاسم)",
 "onomastic": "أسمائي, متعلق بعلم الأسماء (مكون من أو متعلق بعلم دراسة الأسماء (أونوماستيك))\nمثال: نشر مجموعة من مقالاته المتعلقة بعلم الأسماء",
 "onomasticon": "معجم أسماء الأعلام (قائمة بأسماء العلم التي تسمي أشخاصاً أو أماكن)",
 "onomastics": "علم الأسماء (فرع علم المعجم الذي يدرس أشكال وأصول الأسماء العلم)",
 "onomatomania": "أونوماتومانيا, هوس الكلمات (هوس بكلمة معينة يستخدمها الشخص بشكل متكرر أو تقتحم وعيه)",
 "onomatopoeia": "مُحَاكَاة صَوْتِيَّة (تقليد أو محاولة إعادة عملية أو نظام موجود في الواقع بطريقة اصطناعية أو نموذجية)\nمثال: ويتم الآن طرح التساؤل التالي: هل يفهم الذكاء الصناعي اللغة الصينية حقيقة أم أنه يتم فقط محاكاة هذه المقدرة.",
 "onomatopoeic": "صوتي, محاكٍ للصوت ((للكلمات) مشكلة تقليداً لصوت طبيعي) / محاك للصوت (من أو متعلق بـ أو يتميز بالمحاكاة الصوتية)\nمثال: الكلمات المحاكية للأصوات تقلد الضوضاء",
 "onomatopoeical": "صوتي, محاكٍ للصوت ((للكلمات) مشكلة تقليداً لصوت طبيعي)\nمثال: الكلمات المحاكية للأصوات تقلد الضوضاء",
 "onomatopoetic": "صوتي, محاكٍ للصوت ((للكلمات) مشكلة تقليداً لصوت طبيعي) / محاك للصوت (من أو متعلق بـ أو يتميز بالمحاكاة الصوتية)\nمثال: الكلمات المحاكية للأصوات تقلد الضوضاء",
 "onondaga": "لغة أونونداغا (اللغة الإيروكوية التي يتحدث بها شعب أونونداغا) / أونونداغا (فرد من شعب إيروكواس كان يعيش سابقاً بين بحيرة شامبلين ونهر سانت لورانس)",
 "onondaga language": "لغة أونونداغا (اللغة الإيروكوية التي يتحدث بها شعب أونونداغا)",
 "ononis repens": "شبرق زاحف (نبات خشبي أوروبي له زهور وردية وأوراق أحادية الوريقة وجذور طويلة قوية؛ ينتشر عن طريق السيقان الجارية تحت الأرض)",
 "ononis spinosa": "شبرق شائك (نبات أوراسي له عناقيد فضفاضة من الزهور الوردية أو الأرجوانية وسيقان شائكة وجذور قوية)",
 "onopordon acanthium": "شوك اسكتلندي, شوك صوفي (شوك أوراسي ثنائي الحول أبيض مشعر ذو أزهار أرجوانية شاحبة؛ متوطن في أمريكا الشمالية)",
 "onopordum acanthium": "شوك اسكتلندي, شوك صوفي (شوك أوراسي ثنائي الحول أبيض مشعر ذو أزهار أرجوانية شاحبة؛ متوطن في أمريكا الشمالية)",
 "onosma": "مِصَّيْص, شِنْجَار",
 "onrush": "هجمة, هجوم ((عسكري) هجوم ضد عدو (باستخدام الأسلحة)) / اندفاع, هجوم (اندفاع قوي أو تدفق للأمام)\nمثال: بدأ الهجوم عند الفجر",
 "onsen": "أُون-سِن",
 "onset": "هجمة, هجوم ((عسكري) هجوم ضد عدو (باستخدام الأسلحة)) / بداية, مستهل (البداية أو المراحل المبكرة)\nمثال: بدأ الهجوم عند الفجر",
 "onshore": "سَاحِلِيّ, عَلَى الشَّاطِئ (يقع على حافّة اليابسة المحاذية للبحر) / على البر, على الشاطئ (على اليابسة أو باتجاهها) / صَوْب الشَّاطِئ, نَحْو السَّاحِل ((للرياح) قادمة من البحر نحو اليابسة)\nمثال: كانوا يعيشون على البر",
 "onside": "قانوني الموقع (ليس متسللاً؛ وجوده داخل منطقة اللعب المقررة)",
 "onslaught": "هجمة, هجوم ((عسكري) هجوم ضد عدو (باستخدام الأسلحة)) / تدفق, وابل (التدفق السريع والمستمر للتواصل اللغوي (المنطوق أو المكتوب)) / انقضاض, هجمة (بداية مفاجئة وشديدة للمتاعب)\nمثال: بدأ الهجوم عند الفجر",
 "onstage": "عَلَى المَسْرَح (على المسرح) / أمام الجمهور, على المسرح (يقع أو يحدث في منطقة المسرح المرئية للجمهور)\nمثال: حان الوقت لتذهب إلى المسرح",
 "ontario": "أُونْتَارْيُو",
 "onto": "عَلَى (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال.",
 "onto function": "تَطْبِيق فَوْقِيّ, دَالَّة شَامِلَة (دالة رياضية تغطي كامل المدى المقابل)",
 "ontogenesis": "تطور, نشوء ((علم الأحياء) عملية نمو الكائن الفردي عضويًا؛ تكشف بيولوجي بحت للأحداث المتضمنة في تغير الكائن الحي تدريجيًا من مستوى بسيط إلى مستوى أكثر تعقيدًا)\nمثال: اقترح مؤشرًا للتطور العظمي عند الأطفال",
 "ontogenetic": "تكويني فردي, نشوئي (من أو يتعلق بنشأة وتطور الكائنات الحية الفردية)\nمثال: تطور نشوئي",
 "ontogeny": "تطور, نشوء ((علم الأحياء) عملية نمو الكائن الفردي عضويًا؛ تكشف بيولوجي بحت للأحداث المتضمنة في تغير الكائن الحي تدريجيًا من مستوى بسيط إلى مستوى أكثر تعقيدًا)\nمثال: اقترح مؤشرًا للتطور العظمي عند الأطفال",
 "ontological": "أنطولوجي, وجودي (متعلق بالأنطولوجيا (علم الوجود))\nمثال: تأملات وجودية",
 "ontology": "أُنْطُولُوجِيَّا, عِلْم الْوُجُود",
 "onus": "ثقل, حمل (اهتمام شاق أو صعب)\nمثال: عبء المسؤولية",
 "onward": "إِلَى الْأَمَام (حرف جر يُفيد الغاية الزمنية؛ حرف جر يُفيد الغاية المكانية)\nمثال: تعال إلى منزلي.",
 "onward motion": "تقدم, زحف (فعل التحرك للأمام (نحو هدف))",
 "onwards": "إلى الأمام, قدماً (في اتجاه أمامي)\nمثال: امض قدماً",
 "onycha": "ظُفْر الطِيب (الجزء المتقرن الميت على طرف الأصبع من الإنْسَان وبعض الحَيْوَانَات)\nمثال: نبت ظفر أصبع رجلي الكبير.",
 "onycholysis": "انفكاك الظفر (انفصال الظفر عن ارتباطه الطبيعي بسرير الظفر)",
 "onychophoran": "حاملات المخالب, دودة مخملية (أي من الحيوانات آكلة اللحوم العديدة التي تشبه الديدان ذات الجلد المخملي الشائعة في الغابات الاستوائية ولها خصائص كل من المفصليات والديدان الحلقية)",
 "onychosis": "اعتلال الأظافر (أي مرض أو اضطراب في الأظافر)",
 "onymous": "مَعْرُوف الاِسْم, مُسَمَّى (يحمل اسماً)\nمثال: المقالات في المجلات عادة ما تكون بأسماء صريحة",
 "onyx": "جَزْع (قَطَعَ الشَّيءَ؛ قَطَعَ النَّهْرَ عَرْضًا)",
 "onyx marble": "ألباستر, مرمر (نوع صلب مدمج من الكالسيت)",
 "onyxis": "ظفر غائر, ظفر ناشب (ظفر قدم تكون طرفه الحر أو حوافه مغروسة في اللحم المحيط)",
 "oocyte": "خلية بيضية (خلية مشيجية أنثوية تتطور إلى بويضة بعد انقسامين اختزاليين)",
 "oodles": "أطنان, أكوام (عدد أو كمية كبيرة)\nمثال: كون الكثير من الصداقات الجديدة",
 "oogenesis": "تكون البويضات (تطور البويضات)",
 "oolith": "أوليث",
 "oology": "علم البيض (فرع علم الحيوان الذي يدرس البيض (خاصة بيض الطيور وحجمه وشكله ولونه وعدده))",
 "oolong": "أولونغ (أوراق شاي صينية تم تخميرها جزئياً قبل تجفيفها)",
 "oomph": "حيوية, ديناميكية (نشاط شخصية حيوية) / إثارة, جاذبية جنسية (الجاذبية للجنس الآخر)",
 "oophorectomy": "استئصال المبيض (إزالة جراحية لمبيض واحد أو كليهما)",
 "oophoritis": "التهاب المبيض (التهاب أحد المبيضين أو كليهما)",
 "oophorosalpingectomy": "استئصال المبيض وقناة فالوب (إزالة جراحية لمبيض واحد أو كليهما وقناتي فالوب المقابلتين)",
 "oops": "آهٍ (صوت يستخدم للدلالة على الشعور بالألم العاطفي أو الجسدي؛ ألم، إما عاطفي أم جسدي)\nمثال: آه ، هناك فراشة!",
 "oort cloud": "سَحَابَة أُورْط (واحدة السَحَاب)\nمثال: هذه السحابة على شكل سمكة.",
 "oosphere": "بيضة كروية (مشيج؛ يستخدم المصطلح خاصة في النباتات الدنيا)",
 "oospore": "بوغ بيضي (بوغ جنسي سميك الجدار يتطور من بيضة مخصبة في بعض الطحالب والفطريات)",
 "ootid": "أرومة بيضية, نويضة (بويضة ناضجة بعد اختراق الحيوان المنوي لها ولكن قبل تكوين اللاقحة)",
 "ooze": "رشح, نزيز (عملية التسرب ببطء) / حمأة, طين لزج (أي مادة سميكة ولزجة)",
 "ooze leather": "جلد العجل المدبوغ (جلد ناعم جداً مصنوع من جلود العجول وله تشطيب سويدي على جانب اللحم)",
 "oozing": "رَاشِح, نَازِّ (يتسرّب ببطء) / رشح, نزيز (عملية التسرب ببطء)",
 "oozy": "رَاشِح, نَازِّ (يتسرّب ببطء)",
 "op art": "خداع بصري, فن بصري (نمط من التجريدية شاع في الستينيات؛ ينتج تأثيرات بصرية درامية بألوان وتباينات يصعب على العين حلها)",
 "opacification": "إعتام (عملية التحول إلى غائم أو معتم)",
 "opacity": "إِعْتَام, قَتَامَة (صفة كون الشيء معتماً لدرجة ما؛ الدرجة التي يمنع بها الشيء مرور الضوء) / إِبْهَام, غُمُوض (عدم القدرة على الفهم الناتج عن غموض المعنى) / عتامة (ظاهرة عدم السماح بمرور الإشعاع الكهرومغناطيسي)",
 "opah": "أوبا, سمكة القمر (سمكة كبيرة بيضاوية الشكل زاهية الألوان تعيش في أعماق المحيط الأطلسي والهادئ والبحر الأبيض المتوسط)",
 "opal": "أُوبَال",
 "opal glass": "زجاج أوبال, زجاج حليبي (زجاج أبيض حليبي نصف شفاف أو معتم)",
 "opalescence": "تقزح, تلاعب لوني (الخاصية البصرية لشيء له سطوع حليبي وتلاعب بالألوان من السطح)",
 "opalescent": "قُزَحِيّ, مُتَلَوِّن (ذُو أَلْوَان قَوْس قُزَح مُتَلَأْلِئَة ولَامِعَة)",
 "opaline": "قُزَحِيّ, مُتَلَوِّن (ذُو أَلْوَان قَوْس قُزَح مُتَلَأْلِئَة ولَامِعَة)",
 "opaque": "أَكْمَد",
 "opaque gem": "حجر كريم معتم (حجر كريم غير شفاف)",
 "opaquely": "بشكل مبهم, بغموض (بطريقة غامضة)\nمثال: أشار بغموض إلى ماضيها القريب",
 "opaqueness": "إِعْتَام, قَتَامَة (صفة كون الشيء معتماً لدرجة ما؛ الدرجة التي يمنع بها الشيء مرور الضوء) / إِبْهَام, غُمُوض (عدم القدرة على الفهم الناتج عن غموض المعنى)",
 "opcw": "منظمة حظر الأسلحة الكيميائية (منظمة دولية لنزع السلاح الكيميائي؛ تدير اتفاقية الأسلحة الكيميائية)",
 "opec": "اُوبِك, اُوبِيك",
 "open": "مَفْتُوح / فَتَحَ (ضد أغْلَقَ وسَدَّ؛ تركه بلا شيء يسده؛ الطريق: جعلها سالكة للطارقين) / فتح (ضد أغْلَقَ وسَدَّ؛ تركه بلا شيء يسده؛ الطريق: جعلها سالكة للطارقين) / حل (للعقدة: ضد عَقْدها؛ للجامد في السائل: إذابته) / اِنْفَتَحَ (فعل مطاوعة لفَتَحَ، فَتَحْتُهُ فانْفَتَح؛ يستخدم عوضا عن المبنى للمجهول فُتِحَ. )\nمثال: فتح الباب آليا.",
 "open account": "حساب مفتوح (طلب ائتماني غير مدفوع) / حساب ائتماني, حساب جاري مدين (ائتمان تمنحه شركة لعميل)",
 "open air": "خلاء, عراء (حيث يكون الهواء غير محصور)\nمثال: أراد الخروج للهواء الطلق قليلاً",
 "open chain": "سلسلة مفتوحة (سلسلة من الذرات في جزيء لا تتصل أطرافها لتشكل حلقة)",
 "open circuit": "دائرة مفتوحة (دائرة كهربائية غير مكتملة لا يتدفق فيها تيار)",
 "open door": "باب مفتوح, حرية الوصول (حرية الوصول) / سياسة الباب المفتوح (سياسة منح فرص تجارية متساوية لجميع البلدان)\nمثال: حافظ على سياسة الباب المفتوح لجميع الموظفين",
 "open fireplace": "مدفأة, موقد (تجويف مفتوح في الجدار عند قاعدة المدخنة حيث يمكن إشعال النار)\nمثال: كان الموقد كبيراً جداً لدرجة أنه يمكنك المشي بداخله",
 "open fracture": "كسر مركب, كسر مفتوح (كسر عظمي مصحوب بتهتك في الأنسجة الرخوة أو جرح مفتوح)",
 "open frame": "إطار مفتوح (أي إطار (جولة) يفشل فيه لاعب البولينج في تحقيق ضربة كاملة (سترايك) أو مكملة (سبير))\nمثال: الكسر في الإطار الثامن كلفه المباراة",
 "open house": "استقبال عام, بيت مفتوح (حفلة غير رسمية تتيح الضيافة لجميع القادمين)",
 "open interval": "فترة مفتوحة (فترة لا تتضمن نقطتي نهايتها)",
 "open letter": "رسالة مفتوحة (رسالة احتجاج؛ موجهة إلى شخص واحد ولكنها مخصصة للجمهور العام)",
 "open marriage": "زواج مفتوح (زواج يكون فيه كل شريك حراً في الدخول في علاقات جنسية خارجية دون شعور بالذنب أو الغيرة من الآخر)",
 "open order": "نظام مفتوح (تشكيل عسكري يترك مساحة كافية بين الرتب للسماح للضابط المفتش بالمرور)",
 "open primary": "اِنْتِخَابَات تَمْهِيدِيَّة مَفْتُوحَة (انتخابات تمهيدية يمكن فيها لأي ناخب مسجل التصويت (ولكن يجب التصويت لمرشحي حزب واحد فقط))",
 "open sandwich": "شطيرة مفتوحة (شطيرة بدون شريحة خبز تغطيها)",
 "open secret": "سر مكشوف (شيء من المفترض أن يكون سرياً ولكنه معروف بشكل عام)\nمثال: كانت علاقة حبهما سراً مكشوفاً",
 "open sesame": "اِفْتَح يَا سِمْسِم",
 "open shop": "مؤسسة مفتوحة التوظيف (شركة يتم توظيف عمالها دون النظر إلى عضويتهم في نقابة عمالية)",
 "open sight": "مهداف مفتوح (مهداف خلفي للسلاح يحتوي على شق مفتوح بدلاً من ثقب أو تلسكوب)",
 "open society": "مجتمع مفتوح (مجتمع يسمح لأعضائه بحرية كبيرة (كما في الديمقراطية))\nمثال: جعل المجتمع المفتوح في أمريكا منها هدفاً سهلاً للإرهابيين",
 "open syllable": "مقطع مفتوح (مقطع صوتي ينتهي بصائت أو حرف لين)",
 "open university": "الجامعة المفتوحة (جامعة بريطانية مفتوحة للأشخاص الذين ليس لديهم مؤهلات أكاديمية رسمية ويكون التدريس فيها بالمراسلة أو البث أو المدرسة الصيفية)",
 "open vowel": "صائت مفتوح, صائت منخفض (صائت تنطقه ولسانك في قاع فمك)",
 "open weave": "نسيج مفتوح (نسيج لا تلتقي فيه خيوط السدى أبداً، تاركة فجوات في القماش)",
 "open world": "عالم مفتوح (الذي يعلم؛ متخصص في عِلْم ما وباحث فيه)\nمثال: هو عالم أحيائي.",
 "open-air market": "سوق شعبي, سوق مفتوح (سوق عام حيث يباع الطعام والبضائع في الهواء الطلق)",
 "open-air marketplace": "سوق شعبي, سوق مفتوح (سوق عام حيث يباع الطعام والبضائع في الهواء الطلق)",
 "open-and-shut": "لَا جِدَال فِيه, مَحْسُوم (بالغ الوضوح بحيث يسهل حلّه أو البتّ فيه)",
 "open-angle glaucoma": "زرق مزمن, زرق مفتوح الزاوية (زرق ناجم عن انسداد قناة شليم؛ ينتج عنه فقدان تدريجي للرؤية المحيطية)\nمثال: الزرق مفتوح الزاوية هو أكثر أنواع الزرق شيوعًا",
 "open-chain": "لاحلقي, مفتوح السلسلة (له هيكل سلسلة مفتوحة)",
 "open-class word": "كلمة محتوى, كلمة معنوية (كلمة يمكن إسناد معنى مستقل لها)",
 "open-collared": "مَفْتُوح اليَاقَة ((عَنِ القَمِيص) غَيْر مُزَرَّر عِنْد الرَّقَبَة)",
 "open-door policy": "سياسة الباب المفتوح (سياسة منح فرص تجارية متساوية لجميع البلدان)",
 "open-end credit": "ائتمان متجدد, ائتمان مفتوح (خط ائتمان استهلاكي يمكن استخدامه حتى حد معين أو سداده في أي وقت)",
 "open-end fund": "صندوق استثمار مشترك, صندوق استثمار مفتوح (شركة استثمار منظمة تمتلك مجموعة من الأصول وتقوم ببيع واسترداد أسهمها بانتظام)",
 "open-end investment company": "صندوق استثمار مشترك, صندوق استثمار مفتوح (شركة استثمار منظمة تمتلك مجموعة من الأصول وتقوم ببيع واسترداد أسهمها بانتظام)",
 "open-end wrench": "مفتاح مفتوح الطرف (مفتاح ربط بفكوك متوازية بتباعد ثابت (غالباً في كلا طرفي المقبض))",
