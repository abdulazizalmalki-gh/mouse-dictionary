 "nutella": "نُوتِيلَا",
 "nutgrass": "سعد الحمار, سعد مستدير (سعد معمر واسع الانتشار له درنات صغيرة صالحة للأكل تشبه الجوز)",
 "nuthatch": "خازن البندق (أي من الطيور المغردة الصغيرة المتنوعة قصيرة الذيل ذات أقدام قوية ومنقار حاد تتغذى على المكسرات الصغيرة والحشرات)",
 "nuthouse": "مارستان, مستشفى المجانين (مصطلحات تحقيرية لمصحة المجانين)",
 "nutlet": "جويزة (جوز صغير)",
 "nutlike": "شَبِيهٌ بِالجَوْزَة (يشبه الجوزة في شكلها وحجمها) / بِنَكْهَةِ المُكَسَّرَات, جَوْزِيّ (ذُو نَكْهَةٍ تُشْبِهُ المُكَسَّرَات)",
 "nutmeg": "جِسْرٌ صَغِير (شَجُعَ، جرُؤ؛ أقدم على الخطر واجترأ)\nمثال: اذهب إلى الجسر.",
 "nutmeg flower": "حبة البركة, حبة سوداء (عشبة من منطقة البحر الأبيض المتوسط ذات بذور لاذعة تستخدم مثل بذور الكراوية)",
 "nutmeg geranium": "غرنوقي التفاح, لقلقي شديد الرائحة (غرنوقي بأوراق مستديرة عطرة وزهور بيضاء صغيرة)",
 "nutmeg hickory": "جوزة الطيب الهيكوري (جوز من جنوب الولايات المتحدة والمكسيك له مكسرات صلبة على شكل جوزة الطيب)",
 "nutmeg melon": "شمام شبكي (ثمرة صنف من كرمة الشمام؛ شمام بعلامات تشبه الشبكة ولحم أخضر عميق) / شمام جوزة الطيب, شمام شبكي (كرمة شمام ذات ثمار بقشرة شبكية رقيقة ولحم أخضر حلو)",
 "nutmeg tree": "جوزة الطيب, شجرة جوزة الطيب (شجرة من شرق الهند تزرع على نطاق واسع في المناطق الاستوائية لبذورها العطرية؛ مصدر لنوعين من التوابل: جوزة الطيب والصولجان)",
 "nutmeg-shaped": "جَوْزِيّ الشَّكْل (على شكل جوزة الطِّيب)",
 "nutmeg-yew": "جوزة الطيب الكاليفورنية (شجرة دائمة الخضرة من كاليفورنيا لها فاكهة تشبه جوزة الطيب ولكن بنكهة تربنتين قوية)",
 "nutria": "كيب, نوتريا (قارض مائي من أمريكا الجنوبية يشبه قندساً صغيراً؛ يُربى من أجل فرائه)",
 "nutrient": "مُغَذٍّ, المُغَذِّي",
 "nutrient agar": "آغار, أجار مغذ (أي وسط استنبات يستخدم الآغار كعامل هلامي)",
