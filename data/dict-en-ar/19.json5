 "nyctophobia": "رهاب الظلام (خوف مرضي من الليل أو الظلام)",
 "nycturia": "بوال ليلي (التبول المفرط في الليل؛ شائع بشكل خاص عند الرجال الأكبر سناً)",
 "nydrazid": "آيزونيازيد, نيدرازين (دواء مضاد للبكتيريا (الاسم التجاري نيدرازين) يستخدم لعلاج السل)",
 "nylghai": "ثور أزرق, نيلجاي (ظبي هندي كبير؛ الذكر أزرق رمادي بعلامات بيضاء؛ الأنثى بنية وبلا قرون)",
 "nylghau": "ثور أزرق, نيلجاي (ظبي هندي كبير؛ الذكر أزرق رمادي بعلامات بيضاء؛ الأنثى بنية وبلا قرون)",
 "nylon": "نَايْلُون",
 "nylon stocking": "جوارب حريرية, جوارب نايلون (جوارب نسائية مصنوعة من مادة شفافة (نايلون أو رايون أو حرير))",
 "nylons": "جوارب حريرية, جوارب نايلون (جوارب نسائية مصنوعة من مادة شفافة (نايلون أو رايون أو حرير))",
 "nymph": "حورية (يرقة حشرة ذات تحول غير كامل (مثل اليعسوب أو ذبابة مايو)) / حورية ((الأساطير الكلاسيكية) إلهة طبيعة صغيرة تُصور عادة كعذراء جميلة) / حورية (شابة جميلة وممتلئة الجسم)\nمثال: اعتقد الإغريق القدماء أن الحوريات يسكن الغابات والمسطحات المائية",
 "nymphaea alba": "زنبق أبيض أوروبي, نيلوفر أبيض (زنبق ماء ذو أزهار بيضاء)",
 "nymphaea caerulea": "لوتس أزرق, نيلوفر أزرق (اللوتس المصري الأزرق: كان مقدساً عند المصريين القدماء)",
 "nymphaea lotus": "زنبق الماء المصري, لوتس (اللوتس المصري الأبيض: زنبق الماء في مصر إلى جنوب شرق أفريقيا؛ كان مقدساً عند المصريين القدماء)",
 "nymphaea odorata": "حورية الماء, زنبق الماء العطر (زنبق ماء ذو أوراق كبيرة وأزهار عطرية مبهرجة تطفو على الماء؛ من المناطق المعتدلة والاستوائية)",
 "nymphaea stellata": "لوتس أزرق, نيلوفر نجمي (لوتس أزرق موطنه الهند وجنوب شرق آسيا)",
 "nymphalid": "حورية (فراشات متوسطة إلى كبيرة توجد في جميع أنحاء العالم تتميز عادة بأجنحة زاهية الألوان وأرجل أمامية غير وظيفية مختزلة جداً مطوية على الصدر)",
 "nymphalid butterfly": "حورية (فراشات متوسطة إلى كبيرة توجد في جميع أنحاء العالم تتميز عادة بأجنحة زاهية الألوان وأرجل أمامية غير وظيفية مختزلة جداً مطوية على الصدر)",
 "nymphalis antiopa": "فراشة العباءة, فراشة كامبرويل (من المناطق المعتدلة؛ لها أجنحة أرجوانية داكنة بحواف صفراء)",
 "nymphet": "فتاة مغرية (شابة جذابة جنسياً)",
 "nymphicus hollandicus": "كوكاتيل (ببغاء أسترالي رمادي صغير برأس أصفر ذي عرف)",
 "nympho": "شبقة (امرأة لديها رغبات جنسية غير طبيعية)",
 "nympholepsy": "نيمفوليبسيا, هوس وجداني (نوبة جنون عاطفية؛ كما في شيء بعيد المنال)",
 "nympholept": "مَسْحُور, مَهْوُوس (شخص مأخوذ بنشوة أو هوس عاطفي (أصل الكلمة يشير إلى من سحرته الحوريات))",
 "nymphomania": "سعار جنسي, نيمفومانيا (رغبة جنسية شديدة بشكل غير طبيعي لدى النساء)",
 "nymphomaniac": "مُصَابَة بِالشَّبَق (مصابة برغبة جنسية مفرطة (توصف بها النساء)) / شبقة (امرأة لديها رغبات جنسية غير طبيعية)",
 "nymphomaniacal": "مُصَابَة بِالشَّبَق (مصابة برغبة جنسية مفرطة (توصف بها النساء))",
 "nynorsk": "النرويجية الجديدة, نينوشك (إحدى اللغتين الرسميتين للنرويج؛ تعتمد على اللهجات الريفية)",
 "nyquist frequency": "تَرَدُّد نَايْكُوِيست ((الاتصالات) ضعف الحد الأقصى للتردد الحاصل في الإشارة المرسلة)",
 "nyquist rate": "مُعَدَّل نَايْكُوِيست ((الاتصالات) أدنى معدل لأخذ العينات يسمح بإعادة بناء دقيقة للإشارة التناظرية المأخوذ منها العينات)",
 "nyssa aquatica": "صمغ مائي (شجرة مستنقعات عمودية من جنوب شرق إلى وسط غرب أمريكا الشمالية تنتج خشباً شاحباً ناعماً سهل التشغيل)",
 "nyssa sylvatica": "صمغ أسود, صمغ حامض (شجرة عمودية من شرق أمريكا الشمالية لها أطراف أفقية وأوراق صغيرة تظهر متأخرة في الربيع وتكتسب لوناً رائعاً في أوائل الخريف)",
 "nystagmus": "رَأْرَأَة",
 "nystan": "ميكوستاتين, نيستاتين (مضاد للفطريات ومضاد حيوي (الأسماء التجارية ميكوستاتين ونيستان) اكتشف في ولاية نيويورك؛ مشتق من فطريات التربة الشعيات)",
 "nystatin": "ميكوستاتين, نيستاتين (مضاد للفطريات ومضاد حيوي (الأسماء التجارية ميكوستاتين ونيستان) اكتشف في ولاية نيويورك؛ مشتق من فطريات التربة الشعيات)",
 "o": "أُوه ((أَوَّهَ): آه)\nمثال: أوه؛ أين هو مكتب البريد؟",
 "o level": "الشهادة العامة للتعليم الثانوي, المستوى العادي (المستوى الأساسي لمادة دراسية تؤخذ في المدرسة)",
 "o ring": "أورينج, حلقة دائرية (حشية تتكون من حلقة مسطحة من المطاط أو البلاستيك؛ تستخدم لختم وصلة ضد الضغط العالي)",
 "o'clock": "السَّاعَة الْوَاحِدَة",
 "o'er": "أَثْنَاءَ, خِلَالَ (طوال فترة زمنية محددة)\nمثال: ابقَ خلال عطلة نهاية الأسبوع",
 "o'malley": "أومالي",
 "o.k.": "بشكل حسن, على ما يرام (بطريقة مرضية أو كافية) / حَسَن, عَلَى مَا يُرَام (مُرْضٍ أو في حالة مُرْضِية) / إشارة القبول, موافقة (تأييد أو موافقة)\nمثال: ستبلي حسناً بمفردها",
 "oaf": "أبله, أجلف (شخص أخرق وغبي)",
