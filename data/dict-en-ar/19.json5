 "nirvana": "اَلنِّرْفَانَا",
 "nisan": "نَيْسَان (الشهر الرابع في السنة الشمسية قبله آذَار وبعده أَيَّار وعدّته 30 يوما)\nمثال: كنت أمتلك سيارة نيسان قبل أن أمتلك هذه.",
 "nisba": "نِسْبَة (مصدر للفعل \"نَسَبَ\"؛ (في النحو) صفة أُضيفت إليها يَاءُ النَّسَبِ، غرضها نسب المنسوب إلى المنسوب إليه)\nمثال: بالنسبة لي، إنه مهم.",
 "nisei": "نيسي (شخص ولد في الولايات المتحدة لأبوين هاجرا من اليابان)",
 "nishapur": "نَيْسَابُور",
 "nisi": "غَيْرُ مُطْلَقٍ, مَشْرُوط (لَيْسَ نِهَائِيًّا أَوْ مُطْلَقًا؛ قَابِلٌ لِلتَّعْدِيلِ)",
 "nissan": "نيسان (الشهر السابع من السنة المدنية؛ الشهر الأول من السنة الدينية (في مارس وأبريل))",
 "nissen hut": "كوخ كونسيت, كوخ نيسن (كوخ جاهز من الحديد المموج له مقطع عرضي نصف دائري)",
 "nist": "المعهد الوطني للمعايير والتكنولوجيا (وكالة في إدارة التكنولوجيا تقوم بإجراء القياسات ووضع المعايير حسب الحاجة من قبل الصناعة أو البرامج الحكومية)",
 "nisus": "سعي, كفاح (محاولة جاهدة لتحقيق هدف)",
 "nit": "صُغْبَة",
 "niter": "ملح البارود, نترات البوتاسيوم",
 "nitid": "بَرَّاق, مُتَأَلِّق (يَلْمَع بِبَرِيقٍ ثَابِتٍ وَلَكِنْ هَادِئ)",
 "nitpicker": "مُتَصَيِّد الإِخْطَاء",
 "nitpicking": "تَمَحُّلُ النَّقْد",
 "nitramine": "تيتريل, نيترامين (مادة صلبة متفجرة بلورية صفراء تستخدم في الصواعق)",
 "nitrate": "نترات (أي مركب يحتوي على مجموعة النترات (مثل ملح أو إستر حمض النيتريك))",
 "nitrate bacterium": "بكتيريا النترات (أي من بكتيريا النيتروجين التي تؤكسد النتريت إلى نترات)",
 "nitrazepam": "نيترازيبام (دواء منوم ومهدئ من نوع البنزوديازيبين)",
 "nitre": "ملح البارود, نترات البوتاسيوم",
 "nitric": "آزوتي, نيتريكي (من أو يحتوي على النيتروجين)\nمثال: حمض النيتريك",
 "nitric acid": "حمض النتريك (أصبح حامضًا، تغير الطعم إلى الحموضة؛ ارتفعت نسبة الحموضة في شيء ما، كما في الطعام أو السوائل)\nمثال: رمى ياني الحمض على وجه سكورة.",
 "nitric bacteria": "بكتيريا النترتة, نتروبكتيريا (بكتيريا التربة التي تحول النتريت إلى نترات)",
 "nitric bacterium": "بكتيريا النترات (أي من بكتيريا النيتروجين التي تؤكسد النتريت إلى نترات)",
 "nitric oxide": "أكسيد النيتريك",
 "nitride": "نيتريد (مركب يحتوي على النيتروجين وعنصر أكثر إيجابية كهربائية (مثل الفوسفور أو فلز))",
 "nitrification": "نترجة (أكسدة مركبات الأمونيوم في المواد العضوية الميتة إلى نترات ونيتريت بواسطة بكتيريا التربة (مما يجعل النيتروجين متاحاً للنباتات)) / نترتة (العملية الكيميائية التي تضاف فيها مجموعة نيترو إلى مركب عضوي (أو تحل محل مجموعة أخرى في مركب عضوي))",
 "nitrile": "نتريل",
 "nitrite": "نيتريت",
 "nitrite bacterium": "بكتيريا النتريت (أي من بكتيريا النيتروجين التي تؤكسد الأمونيا إلى نتريت)",
 "nitro group": "مجموعة نيترو (مؤنث مَجْمُوع وهو اسم مفعول من جَمَعَ؛ الطَائِفَة أو الجَمَاعَة من الناس)\nمثال: شكرا لإضافتي للمجموعة.",
 "nitro-chalk": "سماد نترات الكالسيوم والأمونيوم, نيترو-تشوك (سماد كيميائي يحتوي على كربونات الكالسيوم ونترات الأمونيوم)\nمثال: يُقدر سماد نيترو-تشوك لتعدد استخداماته",
 "nitrobacteria": "بكتيريا النترتة, نتروبكتيريا (بكتيريا التربة التي تحول النتريت إلى نترات)",
 "nitrobacterium": "بكتيريا النيتروجين (أي من البكتيريا الموجودة في التربة التي تشارك في دورة النيتروجين؛ فهي تؤكسد مركبات الأمونيوم إلى نتريت أو تؤكسد النتريت إلى نترات)",
 "nitrobenzene": "نيتروبنزين (سائل زيتي سام قابل للذوبان في الماء يستخدم كمذيب وفي صناعة الأنيلين)",
 "nitrocalcite": "نيتروكالسيت (الشكل المعدني لنترات الكالسيوم)",
 "nitrocellulose": "نترات السليلوز, نيتروسليلوز (إستر لحمض النيتريك؛ يستخدم في الورنيش والمتفجرات)",
 "nitrochloroform": "كلوروبيكرين, نيتروكلوروفورم (مركب سائل ثقيل عديم اللون غير قابل للذوبان يسبب الدموع والقيء؛ يستخدم كمبيد للآفات وكغاز مسيل للدموع)",
 "nitrochloromethane": "نيتروكلوروميثان (شكل غازي من الكلوروبيكرين يستخدم كغاز مسيل للدموع)",
 "nitrocotton": "نترات السليلوز, نيتروسليلوز (إستر لحمض النيتريك؛ يستخدم في الورنيش والمتفجرات)",
 "nitrofen": "نتروفين",
 "nitrofuran": "نيتروفوران (مشتق من الفوران يستخدم لتثبيط النمو البكتيري)",
 "nitrofurantoin": "ماكرودانتين, نيتروفورانتوين (مشتق من النيتروفوران يستخدم كدواء مضاد للبكتيريا (الاسم التجاري ماكرودانتين) فعال ضد مجموعة واسعة من البكتيريا إيجابية الجرام وسلبية الجرام؛ يستخدم…)",
 "nitrogen balance": "توازن النيتروجين (التوازن بين كمية النيتروجين المأخوذة (في التربة أو الجسم) والكمية المفرزة أو المفقودة)",
 "nitrogen cycle": "دورة النيتروجين (دورة النيتروجين؛ تمتص النباتات النترات من التربة، وتأكلها الحيوانات التي تموت وتتحلل لتعيد النيتروجين إلى التربة)",
 "nitrogen dioxide": "ثاني أكسيد النيتروجين",
 "nitrogen fixation": "تثبيت النيتروجين (استيعاب بكتيريا التربة للنيتروجين الجوي وإطلاقه لاستخدام النبات عند موت البكتيريا)",
 "nitrogen mustard": "خردل النيتروجين (مركب سام يشبه غاز الخردل في التركيب؛ مهم في علاج السرطان)",
 "nitrogen narcosis": "تخدير النيتروجين, سكر الأعماق (حالة تشوش أو ذهول تسببها مستويات عالية من النيتروجين المذاب في الدم)\nمثال: يمكن للغواصين في المياه العميقة أن يعانوا من تخدير النيتروجين جراء تنفس الهواء تحت ضغط عالٍ",
 "nitrogen oxide": "أكسيد النيتروجين (أي من أكاسيد النيتروجين المتعددة التي تتكون بفعل حمض النيتريك على المواد القابلة للأكسدة؛ موجودة في عوادم السيارات)",
 "nitrogen trichloride": "ثلاثي كلوريد النيتروجين (زيت متطاير أصفر نفاذ كان يستخدم سابقاً لتبييض الدقيق وتعتيقه)",
 "nitrogen-bearing": "نيتروجيني (من أو متعلق بـ أو يحتوي على النيتروجين)",
 "nitrogen-fixing": "مثبت للنيتروجين (يساهم في عملية تثبيت النيتروجين)",
 "nitrogenase": "نتروجيناز (إنزيم للكائنات الحية الدقيقة المثبتة للنيتروجين يحفز تحويل النيتروجين إلى أمونيا)",
 "nitrogenous": "نَتْرُوجِينِيّ",
 "nitroglycerin": "ثلاثي نيتروجليسرين, نيتروجليسرين (سائل زيتي ثقيل أصفر سام متفجر يتم الحصول عليه عن طريق نيترة الجلسرين؛ يستخدم في صنع المتفجرات وطبياً كموسع للأوعية الدموية)",
 "nitroglycerine": "ثلاثي نيتروجليسرين, نيتروجليسرين (سائل زيتي ثقيل أصفر سام متفجر يتم الحصول عليه عن طريق نيترة الجلسرين؛ يستخدم في صنع المتفجرات وطبياً كموسع للأوعية الدموية)",
 "nitrohydrochloric acid": "الماء الملكي, حمض النيتروهيدروكلوريك (خليط أصفر مدخن ومسبب للتآكل من حمض النيتريك وحمض الهيدروكلوريك يذيب المعادن (بما في ذلك الذهب))",
 "nitrosobacteria": "بكتيريا النتروز, نيتروزوبكتيريا (بكتيريا التربة التي تؤكسد الأمونيا إلى نتريت)",
 "nitrospan": "نيتروسبان, نيتروستات (أسماء تجارية للنيتروجليسرين المستخدم كموسع للأوعية التاجية في علاج الذبحة الصدرية) / ثلاثي نيتروجليسرين, نيتروجليسرين (سائل زيتي ثقيل أصفر سام متفجر يتم الحصول عليه عن طريق نيترة الجلسرين؛ يستخدم في صنع المتفجرات وطبياً كموسع للأوعية الدموية)",
 "nitrostat": "نيتروسبان, نيتروستات (أسماء تجارية للنيتروجليسرين المستخدم كموسع للأوعية التاجية في علاج الذبحة الصدرية) / ثلاثي نيتروجليسرين, نيتروجليسرين (سائل زيتي ثقيل أصفر سام متفجر يتم الحصول عليه عن طريق نيترة الجلسرين؛ يستخدم في صنع المتفجرات وطبياً كموسع للأوعية الدموية)",
 "nitrous": "آزوتي, نيتريكي (من أو يحتوي على النيتروجين)\nمثال: حمض النيتريك",
 "nitrous acid": "حمض النيتروز (حمض غير عضوي غير مستقر يُعرف فقط في المحلول وكأملاح النتريت)",
 "nitrous bacteria": "بكتيريا النتروز, نيتروزوبكتيريا (بكتيريا التربة التي تؤكسد الأمونيا إلى نتريت)",
 "nitrous bacterium": "بكتيريا النتريت (أي من بكتيريا النيتروجين التي تؤكسد الأمونيا إلى نتريت)",
 "nitrous oxide": "أكسيد النيتروز, غاز الضحك (مخدر استنشاقي يستخدم كمخدر في طب الأسنان والجراحة)",
 "nitrous oxide injection system": "نظام حقن أكسيد النيتروز (نظام ميكانيكي يستخدم لحقن أكسيد النيتروز في المحرك لإنتاج المزيد من الطاقة)",
 "nitrox": "نيتروكس",
 "nitta tree": "باركيا, شجرة نيتا (أي من الأشجار الاستوائية المختلفة في العالم القديم من جنس الباركيا ذات رؤوس من الزهور الحمراء أو الصفراء تليها قرون تحتوي عادة على بذور ولب صالح للأكل)",
 "nitty-gritty": "جوهر, خلاصة (الجزء المختار أو الأكثر أهمية أو حيوية في فكرة أو تجربة ما)\nمثال: جوهر حجة المدعي العام",
 "nitweed": "عشبة البرتقال, عشبة الصنوبر (عشبة حولية سلكية الساق من أمريكا الشمالية ذات أوراق دقيقة تشبه الحراشف وزهور صفراء صغيرة)",
 "nitwit": "أحمق, غبي (شخص غبي وغير كفء)",
 "nitwitted": "فَاقِد الرَّشَاد, مَعْتُوه (يفتقر إلى الإدراك والحكمة والحسّ السليم)",
 "niue": "نِييُوِي",
 "nivose": "نيفوز (الشهر الرابع من التقويم الثوري (ديسمبر ويناير)؛ الشهر الثلجي)",
 "nivôse": "نِيفُوز",
 "nix": "صفر, عدم (كمية لا أهمية لها؛ شيء ليس له وجود)\nمثال: بدا وكأنه لا شيء رأيته من قبل",
 "nixon": "نِيكْسُون",
 "nizamiyya": "نِظَامِيَّة",
 "nizhny novgorod": "نِيجْنِي نُوفْغُورُود",
 "nlp": "معالجة اللغات الطبيعية (فرع علم المعلومات الذي يتعامل مع معلومات اللغة الطبيعية)",
 "nlrb": "المجلس الوطني لعلاقات العمل (وكالة مستقلة تابعة لحكومة الولايات المتحدة مكلفة بالتوسط في النزاعات بين الإدارة ونقابات العمال)",
 "nm": "نانومتر (وحدة مترية للطول تساوي واحداً من المليار من المتر)",
 "nmr": "رنين مغناطيسي نووي (رنين البروتونات للإشعاع في مجال مغناطيسي)",
 "nne": "الشَّمَال الشَّمَالِيّ الشَّرْقِيّ, شَمَال شَمَال شَرْق (نقطة البوصلة التي تقع في منتصف المسافة بين الشمال والشمال الشرقي)",
 "nnrti": "مثبط المنتسخة العكسية غير النوكليوزيدي (دواء مضاد للفيروسات يستخدم ضد فيروس نقص المناعة البشرية؛ يرتبط مباشرة بالمنتسخة العكسية ويمنع تحويل الحمض النووي الريبي إلى حمض نووي ريبوزي منقوص…)",
 "nnw": "الشَّمَال الشَّمَالِيّ الغَرْبِيّ, شَمَال شَمَال غَرْب (نقطة البوصلة التي تقع في منتصف المسافة بين الشمال والشمال الغربي)",
 "no": "لَا (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها) / نَعَم (الإبِل والبَقَر والغَنَم. وتسمى نَعَم فقط إذا كان فيها إبل، فالإبل لوحدها نَعَم…) / لَا, لَاءَان (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: لا أحب المدرسة.",
 "no ball": "كرة باطلة (كرة تم رميها بشكل غير قانوني في الكريكت)\nمثال: أعلن الحكم أنها كرة باطلة",
 "no comment": "لا تعليق (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: لا أحب المدرسة.",
 "no doubt": "لَا شَكَّ, لَا جَرَمَ (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: لا أحب المدرسة.",
 "no end": "بلا توقف, كثيراً (باستمرار لفترة طويلة)\nمثال: بكى الطفل بلا توقف",
 "no entry": "مَمْنُوع الدُّخُولُ",
 "no fault automobile insurance": "تأمين السيارات الشامل, تأمين بلا خطأ (نظام لتأمين السيارات حيث يسترد الطرف المصاب في حادث سيارة تعويضات تصل إلى مبلغ محدد من شركة التأمين الخاصة به بغض النظر عن المسؤول عن الحادث)",
 "no fault insurance": "تأمين السيارات الشامل, تأمين بلا خطأ (نظام لتأمين السيارات حيث يسترد الطرف المصاب في حادث سيارة تعويضات تصل إلى مبلغ محدد من شركة التأمين الخاصة به بغض النظر عن المسؤول عن الحادث)",
 "no idea": "لَا فِكْرَة (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: لا أحب المدرسة.",
 "no longer": "لم يعد (ليس الآن)\nمثال: لم تعد موجودة",
 "no man's land": "مِنْطَقَة رَمَادِيَّة, مِنْطَقَة غَامِضَة (المنطقة الغامضة بين فئتين أو حالتين أو شرطين (تحتوي عادة على سمات من كليهما)) / أرض حرام, منطقة محايدة (منطقة غير مأهولة بين الخطوط الأمامية للجيوش المتحاربة) / أرض حرام, أرض لا يملكها أحد (أرض غير مملوكة وغير مأهولة (وعادة ما تكون غير مرغوب فيها))\nمثال: في المنطقة الرمادية بين الفكاهة والابتذال",
 "no matter": "بصرف النظر, بغض النظر (على الرغم من كل شيء؛ دون اعتبار للعوائق)\nمثال: واصل العمل بغض النظر عن الصعوبات",
 "no matter what": "مَهْمَا",
 "no matter what happens": "مهما حدث, مهما كانت الظروف (رغم كل العقبات)\nمثال: سنذهب إلى التبت مهما حدث",
 "no more": "لم يعد (ليس الآن) / ليس, ليس أكثر (إشارة إلى الدرجة التي توجد بها صفة معينة)\nمثال: لم تعد موجودة",
 "no offense": "بِدُون مُؤَاخَذَة, لَا مُؤَاخْذَة",
 "no one": "أَحَد لَا (العدد وَاحِد؛ الوَاحِد من الشيء)\nمثال: لم يساعدني أحد.",
 "no pain, no gain": "مَنْ جَدَّ وَجَدَ وَمَنْ زَرَعَ حَصَدَ (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "no parking": "مَمْنُوع اَلمَوْقِف",
 "no problem": "عَفْوًا",
 "no smoke without fire": "لاَ دُخَانَ بِلاَ نَارٍ (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: لا أحب المدرسة.",
 "no smoking": "التَّدْخِين مَمْنُوعَ, مَمْنُوع التَّدْخِين",
 "no-account": "عَدِيمُ الجَدْوَى, لَا خَيْرَ فِيه (بِلَا اسْتِحْقَاق؛ ذُو قِيمَةٍ أَوْ فَائِدَةٍ ضَئِيلَةٍ أَوْ مُنْعَدِمَة) / شخص عديم الفائدة, عاطل (شخص خامل لا قيمة له)",
 "no-brainer": "أمر بديهي (أي شيء يتطلب القليل من التفكير)",
 "no-count": "عَدِيمُ الجَدْوَى, لَا خَيْرَ فِيه (بِلَا اسْتِحْقَاق؛ ذُو قِيمَةٍ أَوْ فَائِدَةٍ ضَئِيلَةٍ أَوْ مُنْعَدِمَة)",
 "no-fly zone": "مِنْطَقَةُ حَظْرِ الطَّيَرَان (المِنْطَقةُ: المَنْطِقَةُ؛ مِنْطَقَةُ: مُقَاطَعَةٌ)\nمثال: غزة منطقة مكشوفة.",
 "no-go": "غير جاهز (لا يعمل بشكل صحيح أو ليس في حالة مناسبة للمتابعة)\nمثال: كان إطلاق الفضاء غير جاهز",
 "no-go area": "منطقة محظورة (منطقة خطرة أو يستحيل دخولها أو يُحظر الدخول إليها)",
 "no-goal": "لا هدف (هدف غير موجود)\nمثال: عاش دون سبب متجهاً نحو لا هدف",
 "no-good": "بِلَا رَصِيد, مَرْفُوض ((عن الشيكات) مُعاد لعدم كفاية الرصيد) / عَدِيمُ الجَدْوَى, لَا خَيْرَ فِيه (بِلَا اسْتِحْقَاق؛ ذُو قِيمَةٍ أَوْ فَائِدَةٍ ضَئِيلَةٍ أَوْ مُنْعَدِمَة)",
 "no-hit": "بِلَا ضَرَبَات ((في البيسبول) لا يسمح فيه الرامي للخصم بأي ضربة ناجحة)",
 "no-hit game": "مباراة بلا ضربات (مباراة لا يسمح فيها الرامي للفريق المنافس بأي ضربات ناجحة)",
 "no-hitter": "مباراة بلا ضربات (مباراة لا يسمح فيها الرامي للفريق المنافس بأي ضربات ناجحة)",
 "no-nonsense": "جِدِّيّ, لَا يَقْبَل الهُرَاء (لَا يَتَسَامَح مَعَ مَا لَا صِلَة لَهُ بِالمَوْضُوع)",
 "no-par stock": "أسهم بدون قيمة اسمية (أسهم ليس لها قيمة اسمية محددة في ميثاق الشركة أو على شهادة الأسهم)",
 "no-par-value stock": "أسهم بدون قيمة اسمية (أسهم ليس لها قيمة اسمية محددة في ميثاق الشركة أو على شهادة الأسهم)",
 "no-parking zone": "منطقة ممنوع الوقوف (مساحة لا يُسمح للسيارات بالوقوف فيها)",
 "no-see-um": "هاموش (حشرة دقيقة ذات جناحين تمتص دماء الثدييات والطيور والحشرات الأخرى)",
 "no-show": "متغيب, متهرب (شخص يتهرب من الواجب) / متخلف عن الحضور (ضيف يفشل في إبلاغ الفندق أو المطعم عند إلغاء الحجز)",
 "no-trump": "نو ترمب (نسخة من كونتراكت بريدج لا يتم فيها تعيين أي بدلة كورقة رابحة لمدة اليد)",
 "no-win": "بِلَا أَمَل, خَاسِر حَتْمًا (مؤكد أنه سينتهي بالفشل وخيبة الأمل)",
 "no-win situation": "طريق مسدود, وضع خاسر (وضع تكون فيه النتيجة المواتية مستحيلة؛ ستخسر مهما فعلت)",
 "no.": "عدد ترتيبي (الرقم الذي يعين المكان في تسلسل مرتب)",
 "noaa": "الإدارة الوطنية للمحيطات والغلاف الجوي (وكالة في وزارة التجارة تقوم برسم خرائط المحيطات والحفاظ على مواردها الحية؛ تتنبأ بالتغيرات في بيئة الأرض؛ تقدم تقارير الطقس وتتنبأ بالفيضانات…)",
 "noachian": "نوحي (مكون من أو متعلق بنوح أو زمانه)\nمثال: طوفان نوح",
 "noachian deluge": "الطوفان, طوفان نوح ((في الكتاب المقدس) الطوفان العظيم الذي يُقال في سفر التكوين أنه حدث في زمن نوح؛ وقد أنزله الله على الأرض بسبب شر البشر)",
 "noah": "نُوح (نبي ورد ذكره في الكتب المقدسة لأتباع الديانات الإبراهيمية، يؤمَن بأنه صنع سفينة لينجو مع المؤمنين بالله من عذاب الطوفان، وهو أحد أولي العزم الخمسة؛ سُورَة نُوح: السورة الواحدة والسبعون في القرآن)",
 "noah and the flood": "الطوفان, طوفان نوح ((في الكتاب المقدس) الطوفان العظيم الذي يُقال في سفر التكوين أنه حدث في زمن نوح؛ وقد أنزله الله على الأرض بسبب شر البشر)",
 "noah's ark": "سَفِينَةُ نُوح, فُلْكُ نُوح (مَرْكَبٌ بَحْرِيٌّ لِنَقْلِ الْمُسَافِرِينَ وَالبَضَائِعِ)\nمثال: غادروا السفينة.",
 "noah's flood": "الطوفان, طوفان نوح ((في الكتاب المقدس) الطوفان العظيم الذي يُقال في سفر التكوين أنه حدث في زمن نوح؛ وقد أنزله الله على الأرض بسبب شر البشر)",
 "noakhailla": "نُوَاخَالْوِيّ",
 "noakhali": "نُوَاخَالِي",
 "noakhali district": "ضِلْع نُوَاخَالِي",
 "nob": "ثري أنيق (مصطلح غير رسمي لشخص من الطبقة العليا أو ثري)",
 "nobel laureate": "حائز جائزة نوبل (فائز بجائزة نوبل)",
 "nobel prize": "جَائِزَةْ نُوبِل",
 "nobelist": "حائز جائزة نوبل (فائز بجائزة نوبل)",
 "nobelit": "نوبليت (مادة متفجرة مستحلبة وعامل نسف)",
 "nobelium": "نُوبِلْيُوم",
 "nobility": "نُبْل, نَبَالَة / فَخَامَة, شَهَامَة",
 "noble": "نَبِيل, شريف (اَلذَّكِيُّ؛ اَلنَّجِيبُ) / كَرِيم, شَرِيف (نبيل النفس عزيزها ذو الخلق العالي والخير الكثير والعطاء السخي. الكَرَم يشمل مجموعة من الأخلاق أهمها العطاء؛ الجَوَاد السخيّ تحديدا)\nمثال: إنها امرأة نبيلة.",
 "noble cane": "قصب نبيل (قصب سكر يمثل أعلى تطور للنوع؛ يتميز بسيقان كبيرة عصيرية ذات قشور ناعمة ومحتوى سكري عالٍ)",
 "noble gas": "غَازٌ خَامِل",
 "noble metal": "معدن نبيل (أي معدن مقاوم للتآكل أو الأكسدة)",
 "noble-minded": "رَفِيع, سَامٍ (ذو قيمة أخلاقية أو فكرية عالية؛ سامٍ في طبيعته أو أسلوبه)",
 "noble-mindedness": "ترفّع, سمو النفس (المبادئ أو السلوك السامي؛ صفة الاعتقاد بضرورة السعي وراء المثل العليا)",
 "nobleman": "نَبِيل (اَلذَّكِيُّ؛ اَلنَّجِيبُ)\nمثال: إنها امرأة نبيلة.",
 "nobleness": "سمو, شهامة (صفة سمو العقل ورفعة الشخصية أو المبادئ أو السلوك)",
 "noblesse": "النبلاء (أعضاء طبقة النبلاء (خاصة النبلاء الفرنسيين)) / شرف المحتد, نبالة (حالة كون الشخص من أصل نبيل)",
 "noblesse oblige": "نبل الأخلاق, واجب الطبقة الراقية (التزام ذوي الرتب العالية بأن يكونوا شرفاء وكرماء)",
 "noblewoman": "سيدة نبيلة, ليدي (امرأة من طبقة النبلاء في بريطانيا)",
 "nobly": "بنبل (بطريقة نبيلة)\nمثال: تصرفت بنبل",
 "nobody": "شخص غير مهم, لا أحد (شخص ليس له تأثير أو نفوذ)",
 "noc": "عميل غير رسمي الغطاء (عميل سري لا يُمنح غطاءً رسميًا)",
 "nocent": "ضارّ, مُؤْذٍ (قادِر عَلى إلحاق الأذى أو الضَّرَر)",
 "nociceptive": "مُسْتَقْبِل لِلأَلَم (ناتج عن الألم أو استجابةً له)",
 "noctambulation": "سير أثناء النوم, مشي نائم (المشي من قبل شخص نائم)",
 "noctambulism": "سير أثناء النوم, مشي نائم (المشي من قبل شخص نائم)",
 "noctambulist": "سائر في النوم (شخص يمشي أثناء نومه)",
 "noctiluca": "ليليكة, نوكتيلوكا (أوالي بحري كبير مضيء حيوياً)",
 "noctiluca miliaris": "ليليكة, نوكتيلوكا (أوالي بحري كبير مضيء حيوياً)",
 "noctilucent": "مُتَأَلِّق لَيْلًا (يَلْمَع أَوْ يَتَوَهَّج فِي اللَّيْل)",
 "noctuid": "عثة ليلية (عثة ليلية متوسطة الحجم باهتة اللون عادة؛ اليرقات عادة ما تكون ملساء الجسم وهي آفات زراعية مدمرة)",
 "noctuid moth": "عثة ليلية (عثة ليلية متوسطة الحجم باهتة اللون عادة؛ اليرقات عادة ما تكون ملساء الجسم وهي آفات زراعية مدمرة)",
 "noctuoid": "فَرَاشَة لَيْلِيَّة (حشرة صغيرة رقيقة ذات أجنحة كبيرة قد تكون ملونة أو غير ملونة)\nمثال: آه ، هناك فراشة!",
 "nocturia": "بوال ليلي (التبول المفرط في الليل؛ شائع بشكل خاص عند الرجال الأكبر سناً)",
 "nocturnal": "لَيْلِيّ",
 "nocturnal emission": "اِحْتِلَام",
 "nocturnally": "ليلياً (في الليل)\nمثال: طائر نشط ليلياً",
 "nocturne": "مقطوعة ليلية, نوكتورن (قطعة موسيقية غنائية تأملية (خاصة للبيانو))",
 "nod": "أَوْمَأَ, أَوْمَأَ بِرَأْسِهِ (أومأ إليه/أومأ له٬ أشار إليه بيده أو بعينه أو بحاجبه أو برأسه أو غيرها، كدلالة على الموافقة أو المعرفة) / إِيمَاءَة, هَزَّة\nمثال: أومأ زيري بنعم.",
 "nod off": "نَامَ عَلَى نَفْسِهِ (الإنسان أو الحيوان: رَقَدَ وغَفَا؛ الإنسان أو الحيوان: رَقَدَ وإن لم يغفو)\nمثال: نام في الحافلة.",
 "nodal rhythm": "نَظْم أُذَيْنِيّ بُطَيْنِيّ, نَظْم عُقْدِيّ (إيقاع القلب الطبيعي عندما تتحكم فيه العقدة الأذينية البطينية)",
 "nodding": "مُتَدَلٍّ, مُنْحَنٍ لِلأَسْفَل (ذو فروع أو رؤوس أزهار تنحني إلى الأسفل)",
 "nodding groundsel": "شيخة بيغلو, شيخة مائلة (نبات ذو سيقان ورقية منتصبة تحمل عناقيد من رؤوس زهور صفراء عديمة الشعاع على سيقان فردية منحنية؛ المناطق الرطبة في جنوب غرب الولايات المتحدة)",
 "nodding onion": "بصل مائل, كراث السيدة (بصل بري واسع الانتشار في أمريكا الشمالية ذو زهور بيضاء إلى وردية)",
 "nodding thistle": "شوك المسك, شوك منحني (نبات أوراسي معمر متوطن في شرق أمريكا الشمالية ذو أوراق قطنية بيضاء شائكة جداً ورؤوس زهور قرمزية مسكية منحنية؛ مصدر قيم للرحيق)",
 "nodding wild onion": "بصل مائل, كراث السيدة (بصل بري واسع الانتشار في أمريكا الشمالية ذو زهور بيضاء إلى وردية)",
 "noddle": "رأس (تعبير عامي للرأس أو العقل)\nمثال: استخدم عقلك (رأسك)",
 "node": "عُقْدَة",
 "nodes of ranvier": "عقد رانفييه (فجوات صغيرة في غمد المايلين للمحاور العصبية النخاعية)",
 "nodular": "عُقَيْدِيّ (يحتوي على عُقَيْدات أو يتّخذ شكل العُقَيْدات) / عقدي (متعلق بـ أو يتميز بـ أو لديه عقد)\nمثال: التهاب المهبل العقدي",
 "nodulated": "عُقَيْدِيّ (يحتوي على عُقَيْدات أو يتّخذ شكل العُقَيْدات)",
 "nodule": "عُقَيدَة (عقدة صغيرة) / عُقَيـْدَة ((في علم المعادن) كتلة معدنية صغيرة مستديرة (عادة ما تكون أصلب من الصخور أو الرواسب المحيطة)) / درينة, عقيدة (نتوء صغير مستدير يشبه الثالول على النبات)",
 "noduled": "عُقَيْدِيّ (يحتوي على عُقَيْدات أو يتّخذ شكل العُقَيْدات)",
 "nodulose": "عُقَيْدِيّ (ذو عُقَيْدات دقيقة صغيرة)",
 "noel": "الكريسماس, عيد الميلاد (الفترة الممتدة من 24 ديسمبر إلى 6 يناير)",
 "noesis": "إِدْرَاك, مَعْرِفَة (الناتج النفسيّ للإدراك الحسّيّ والتعلُّم والاستدلال)",
 "noetic": "عَقْلَانِيّ, فِكْرِيّ (مرتبط بالعقل أو يتطلّب استخدامه)",
 "nog": "وتد خشبي (كتلة خشبية مبنية في جدار بناء بحيث يمكن تثبيت هيكل النجارة عليها) / وتد (دبوس خشبي يُدفع أو يُدق في سطح)",
 "noggin": "رأس, هامة (مصطلحات غير رسمية للرأس البشري)",
 "nogging": "حشوة البناء, مدماك الحشو (بناء طوبي خشن يستخدم لملء الفجوات في إطار خشبي)",
 "nohow": "بأي حال, بتاتاً (بأي طريقة؛ بأي حال (مع النفي))\nمثال: لم نتمكن بأي حال من فهم خط يده",
 "noise": "ضَوْضَاء, ضَجِيج",
 "noise cancellation": "إِلْغَاء الضَّوْضَاء",
 "noise conditions": "ضجيج (حالة وجود ضجيج (كما في قناة اتصال))",
 "noise level": "مستوى الخلفية, مستوى الضجيج (مستوى سعة ضوضاء الخلفية غير المرغوب فيها)",
 "noise pollution": "تَلَوُّث ضَوْضَائِيّ (تَلَطُّخ، تَكَدُّر، قذارة ودنس يصيبان الجو أو الماء أو البيئة ويؤديان إلى تسمم أو أمراض؛ تَشَوُّه)\nمثال: التلوث يضر كوكبنا.",
 "noiseless": "بِلَا ضَجِيج, صَامِت (لا يُصْدِر أيّ صوت)",
 "noiselessly": "بصمت, بلا ضجيج (بدون صوت)\nمثال: وقف بصمت ودون كلام وانزلق عبر الردهة ومن خلال الباب",
 "noiselessness": "انعدام الضجيج, صمت مطبق (خاصية عدم إصدار أي ضجيج)",
 "noisemaker": "أداة إحداث ضجيج, صانع ضجيج (جهاز (مثل المصفق أو الجرس أو البوق) يستخدم لإحداث ضوضاء عالية في الاحتفالات)",
 "noisily": "بِصَخَب, بِضَجِيج (مع الكثير من الضجيج أو الصوت العالي والمزعج)\nمثال: نظف أنفه بصخب",
 "noisiness": "جلبة, صخب (التأثير السمعي الذي يتميز بضوضاء عالية ومستمرة)",
 "noisome": "زَنِخ, مُنْتِن (ذُو رَائِحَةٍ كَرِيهَةٍ بِشَكْلٍ مُؤْذٍ) / مُثِير لِلْغَثَيَان, مُقَزِّز (يسبّب الغثيان أو قادر على التسبّب به)",
 "noisomeness": "أَذِيَّة, ضَرَر (صفة كون الشيء ضاراً)",
 "noisy": "صَارِخ, صاخِب",
 "nol pros": "حفظ الدعوى, عدم الملاحقة القضائية (قيد في سجل المحكمة يفيد بأن المدعي أو المدعي العام لن يواصل الدعوى)",
 "noli-me-tangere": "قرحة أكالة (قرحة سرطانية في الأنسجة الرخوة والعظام)",
 "nolina microcarpa": "عشبة الدب, نولينا (نبات عديم الساق بخصل من أوراق تشبه العشب وعنقود منتصب من الزهور البيضاء الكريمية الدقيقة؛ جنوب غرب الولايات المتحدة والمكسيك)",
 "nolle prosequi": "حفظ الدعوى, عدم الملاحقة القضائية (قيد في سجل المحكمة يفيد بأن المدعي أو المدعي العام لن يواصل الدعوى)",
 "nolo contendere": "امتناع عن الرد, عدم المخاصمة ((قانون) إجابة تعني 'لا نزاع' من قبل المدعى عليه الذي لا يعترف بالذنب ولكنه يُخضع نفسه للإدانة)",
 "nom de guerre": "اسم مستعار (اسم خيالي يستخدم عندما يؤدي الشخص دوراً اجتماعياً معيناً)",
 "nom de plume": "اسم أدبي, اسم شهرة (الاسم المستعار لمؤلف)",
 "noma": "أكلة الفم, نوما (تقرح حاد في الأغشية المخاطية للفم أو الأعضاء التناسلية)",
 "nomad": "بَدَوِيّ (إلى البادية؛ الذي يعيش في البَادِيَة؛ الأعرابيّ)",
 "nomadic": "بَدَوِيّ (إلى البادية؛ الذي يعيش في البَادِيَة؛ الأعرابيّ) / جَوَّال, رَحَّال (صيغة مبالغة على وزن فَعَّال من الفعل جَالَ؛ كثير التجوّل، دائم التنقُّل من مكان لآخر)\nمثال: اشتريت جوال مستعمل.",
 "nomadism": "بداوة, ترحال (طريقة حياة الناس الذين ليس لديهم منزل ثابت، ويتنقلون موسمياً بحثاً عن الطعام والماء والرعي إلخ)\nمثال: الرعي البدوي هو شكل من أشكال كسب العيش يتكيف بيئياً عند مستوى معين لاستغلال الموارد الهامشية",
 "nombril": "نقطة السرة (النقطة المركزية على الترس أو الدرع)",
 "nomen vicis": "اسم مرَّة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)\nمثال: ما اسم حصان توم؟",
 "nomenclature": "تَسْمِيَة",
 "nomenklatura": "النخبة الحزبية, نومنكلاتورا (نظام المحسوبية في الدول الشيوعية؛ تسيطر عليه لجان في الحزب الشيوعي)",
 "nomia melanderi": "نحلة القلويات (نحلة منعزلة شائعة مهمة لتلقيح البرسيم في غرب الولايات المتحدة)",
 "nominal": "اِسْمِيّ, شَرَفِيّ (لَا يُوجَدُ إِلَّا بِالِاسْمِ فَقَطْ) / اسْمِيّ, بِاسْم شَخْص مُعَيَّن (مُسَمًّى؛ يحمل اسم شخص محدد) / رَمْزِيّ, شَكْلِيّ (صغير بشكل لا يُذكر؛ مجرد إجراء شكلي ('شَكْلِيّ' غير رسمي)) / اسمي (متعلق بـ أو من سمات مبلغ لم يتم تعديله للتضخم)\nمثال: الناتج المحلي الإجمالي الاسمي",
 "nominal aphasia": "حبسة تسمية, عجز عن التسمية (عدم القدرة على تسمية الأشياء أو التعرف على الأسماء المكتوبة أو المنطوقة للأشياء)",
 "nominal damages": "تعويضات رمزية ((قانون) مبلغ تافه (عادة دولار واحد) يُمنح كاعتراف بوقوع ضرر قانوني (كما هو الحال بالنسبة للانتهاكات الفنية للعقد))",
 "nominal head": "واجهة (شخص يستخدم كغطاء لنشاط مشكوك فيه)",
 "nominal phrase": "عبارة اسمية (عبارة يمكن أن تعمل كفاعل أو مفعول به لفعل)",
 "nominal price": "سعر اسمي (سعر تقديري قد يشبه أو لا يشبه سعر السوق للأصل)",
 "nominal value": "قيمة اسمية (قيمة الورقة المالية التي تحددها الشركة المصدرة لها؛ ولا علاقة لها بالقيمة السوقية)",
 "nominalism": "اسمية ((فلسفة) المذهب القائل بأن الأشياء المختلفة التي تحمل نفس المصطلح ليس بينها قاسم مشترك سوى الاسم)",
 "nominalist": "اسمي (فيلسوف تبنى مذهب الاسمية)",
 "nominalistic": "اسمي (مكون من أو متعلق بالمذهب الاسمي (في الفلسفة))",
 "nominally": "اسمياً, صورياً (بالاسم فقط)\nمثال: هو الرئيس صورياً",
 "nominate": "رَشَّحَ, عَيَّنَ (اقتَرَح شخصًا أو جهةً ليكون مرشَّحًا لمنصب أو مهمة؛ جعَل شيئًا يرشُح أو يُصفّى)",
 "nominated": "مُرَشَّح, مُعَيَّنٌ بِالتَّرْشِيح (معيّن عن طريق الترشيح)",
 "nominating address": "خطاب ترشيح (خطاب (عادة في مؤتمر سياسي) يقترح اسم مرشح لخوض الانتخابات)\nمثال: كان الترشيح موجزاً وفي صلب الموضوع",
 "nominating speech": "خطاب ترشيح (خطاب (عادة في مؤتمر سياسي) يقترح اسم مرشح لخوض الانتخابات)\nمثال: كان الترشيح موجزاً وفي صلب الموضوع",
 "nomination": "تَعْيِين, تَرْشِيح",
 "nominative": "مَرْفُوع",
 "nominative case": "حَالَةْ اَلرَّفْع, مَرْفُوع",
 "nominator": "مُرَشِّح, مُرَشِّحَة",
 "nominee": "مرشح (سياسي يترشح لمنصب عام)",
 "nomogram": "رسم بياني حسابي, نوغرام (تمثيل بياني للعلاقات العددية)",
 "nomograph": "رسم بياني حسابي, نوغرام (تمثيل بياني للعلاقات العددية)",
 "nomothetic": "تعميمي, قانوني (يتعلق بـ أو ينطوي على البحث عن مبادئ عالمية مجردة)",
 "non": "غير, لا (نفي كلمة أو مجموعة من الكلمات)\nمثال: هو لا يتحدث الفرنسية",
 "non pros": "حكم لعدم المتابعة (حكم يصدر لصالح المدعى عليه عندما لا يتابع المدعي دعواه (على سبيل المثال، لم يمثل أمام المحكمة))",
 "non prosequitur": "حكم لعدم المتابعة (حكم يصدر لصالح المدعى عليه عندما لا يتابع المدعي دعواه (على سبيل المثال، لم يمثل أمام المحكمة))",
 "non sequitur": "مغالطة لا يتبع ((منطق) استنتاج لا يتبع من المقدمات) / استنتاج غير منطقي, كلام غير مترابط (رد ليس له صلة بما سبقه)",
 "non vult": "امتناع عن الرد, عدم المخاصمة ((قانون) إجابة تعني 'لا نزاع' من قبل المدعى عليه الذي لا يعترف بالذنب ولكنه يُخضع نفسه للإدانة)",
 "non-aromatic": "غَيْر عِطْرِيّ (لَيْسَ لَهُ رَائِحَة عِطْرِيَّة)",
 "non-automatic": "غَيْر آلِيّ, يَدَوِيّ التَّشْغِيل (يعمل باليد وبتشغيل يدوي)",
 "non-avian": "غير طيري (لا يخص أو لا يميز الطيور)\nمثال: ثيروبودات غير طيرية",
 "non-avian dinosaur": "ديناصور غير طائر (ديناصور ليس طائراً)",
 "non-binary": "لَاثُنَائِيّ",
 "non-buoyant": "غَيْر طافٍ (يَميل إلى الغَرَق في السَّائِل أو السُّقوط في الهَواء)",
 "non-canonicity": "عَدَم مِعْيَارِيَّة, لَا قَانُونِيَّة (الصفة أو الحالة التي لا تكون قانونية (كنسياً)، أو لا تتوافق مع قاعدة عامة أو إجراء شائع)",
 "non-cash expense": "مصروف غير نقدي (مصروف (مثل الإهلاك) لا يتم دفعه نقداً)",
 "non-catholic": "غير كاثوليكي (شخص متدين ليس كاثوليكياً)",
 "non-christian priest": "كاهن (شخص يؤدي واجبات ومراسم دينية في ديانة غير مسيحية)",
 "non-commercialism": "لا تجارية (خاصية عدم الارتباط أو الانخراط في المشاريع التجارية)\nمثال: على الرغم من لا تجاريتها الفخورة، قد يكون لدى المطبعة الصغيرة الموجودة في الحرم الجامعي أكثر الكتب مبيعاً في منشوراتها الأخيرة",
 "non-commissioned officer": "ضابط صفّ",
 "non-conducting": "عازل, غير موصل (غير قادر على توصيل الحرارة أو الكهرباء أو الصوت)",
 "non-dedicated file server": "خادم ملفات غير مخصص ((علم الحاسوب) خادم ملفات يمكن استخدامه في نفس الوقت كمحطة عمل)",
 "non-disclosure agreement": "اِتِّفَاقِيَّة عَدَم الإِفْصَاح, اِتِّفَاقِيَّة عَدَم الْإِفْشَاء",
 "non-discrimination": "عدم التمييز (الإنصاف في معاملة الناس دون تحيز)",
 "non-elective": "غَيْرُ انْتِخَابِيّ (يُشغَل بالتعيين لا بالانتخاب)",
 "non-engagement": "عَدَم الاِنْخِرَاط, عَدَم المُشَارَكَة (الانسحاب من أنشطة المجموعة)",
 "non-euclidean geometry": "هندسة لاإقليدية ((رياضيات) هندسة قائمة على بديهيات تختلف عن بديهيات إقليدس)",
 "non-finite": "غير متصرف, غير محدد ((عن الأفعال) ليس له زمن أو شخص أو عدد (مثل اسم الفاعل أو المصدر أو صيغة المصدر))\nمثال: صيغة فعل غير محددة",
 "non-flowering plant": "نبات لا زهري (نبات لا يحمل أزهاراً)",
 "non-governmental organization": "مُنَظَّمَة غَيْر حُكُومِيَّة",
 "non-insulin-dependent diabetes": "السكري غير المعتمد على الأنسولين, السكري من النوع الثاني (شكل خفيف من داء السكري يتطور تدريجيًا لدى البالغين؛ يمكن أن يحدث بسبب السمنة أو الإجهاد الشديد أو انقطاع الطمث أو عوامل أخرى؛ يمكن السيطرة عليه عادة…)",
 "non-insulin-dependent diabetes mellitus": "السكري غير المعتمد على الأنسولين, السكري من النوع الثاني (شكل خفيف من داء السكري يتطور تدريجيًا لدى البالغين؛ يمكن أن يحدث بسبب السمنة أو الإجهاد الشديد أو انقطاع الطمث أو عوامل أخرى؛ يمكن السيطرة عليه عادة…)",
 "non-invertible": "غير قابل للعكس (لا يقبل معكوسًا جمعيًا أو ضربيًا)",
 "non-involvement": "عَدَم الاِنْخِرَاط, عَدَم المُشَارَكَة (الانسحاب من أنشطة المجموعة)",
 "non-ionic detergent": "منظف أنيوني, منظف لا أيوني (فئة من المنظفات الاصطناعية التي لا تتأين جزيئاتها في المحاليل المائية)",
 "non-issue": "حبر على ورق, قانون مهمل (حالة شيء فقد أهميته أو فعاليته)",
 "non-jew": "غير اليهودي, من الأغيار (مسيحي أو غير يهودي بالمقابلة مع اليهودي)",
 "non-living": "جَمَاد, غَيْر حَيّ (غير موهوب بالحياة)\nمثال: العالم غير العضوي جماد",
 "non-market economy": "اقتصاد غير سوقي (اقتصاد لا يكون اقتصاد سوق)",
 "non-metric": "غير متري (غير قائم على المتر كمعيار للقياس)",
 "non-miscible": "غير قابل للامتزاج, غير مزوج ((في الكيمياء والفيزياء) غير قابل للخلط)",
 "non-negotiable": "غَيْر قَابِل لِلتَّدَاوُل (لا يمكن شراؤه أو بيعه)",
 "non-nucleoside reverse transcriptase inhibitor": "مثبط المنتسخة العكسية غير النوكليوزيدي (دواء مضاد للفيروسات يستخدم ضد فيروس نقص المناعة البشرية؛ يرتبط مباشرة بالمنتسخة العكسية ويمنع تحويل الحمض النووي الريبي إلى حمض نووي ريبوزي منقوص…)",
 "non-paying": "بِلَا دَفْع, غَيْرُ دَافِع (لَا يَدْفَعُ شَيْئًا)",
 "non-poisonous": "غَيْرُ سَامّ (آمن للأكل) / غَيْرُ سَامّ (لا ينتج سمًّا ولا يحتوي عليه)",
 "non-profit-making": "غَيْر رِبْحِيّ (غير مدفوع بدوافع تجارية)",
 "non-proliferation": "عدم انتشار, منع الانتشار (منع شيء من التزايد أو الانتشار (خاصة منع زيادة عدد الدول التي تمتلك أسلحة نووية))\nمثال: نزع السلاح النووي ومنع الانتشار هدفان مترابطان",
 "non-refoulement": "عدم الإعادة القسرية (الفقدان ونقيض الوجود؛ يجب عدم فعل كذا: أي يجب الامتناع عن الفعل)\nمثال: عليك عدم الخوف.",
 "non-resinous": "غَيْر رَاتِنْجِيّ (لا يحتوي على راتنج)",
 "non-resiny": "غَيْر رَاتِنْجِيّ (لا يحتوي على راتنج)",
 "non-resistant": "مُقاوِم سِلْمِيّ (مصلح يؤمن بالمقاومة السلبية (اللاعنف))",
 "non-slave": "خَالٍ مِنَ العُبُودِيَّة (حَيْثُ كَانَتِ العُبُودِيَّة مَحْظُورَة)",
 "non-standard speech": "كلام غير قياسي (كلام يختلف عن الكلام المعتاد المقبول والسهل التعرف عليه للأعضاء البالغين الناطقين الأصليين في مجتمع لغوي)",
 "non-u": "غَيْر أَرِسْتُقْرَاطِيّ (ليس من سمات الطبقة العليا خاصة في استخدام اللغة)",
 "non-ugric": "اللغات الفينية (أحد فرعين للغات الفنلندية الأوغرية؛ عائلة لغوية تشمل الفنلندية والإستونية (ولكن ليس المجرية))",
 "non-verbally": "بدون كلام, غير لفظي (بدون استخدام الكلمات)\nمثال: تواصلوا غير لفظياً",
 "non-volatile storage": "تخزين غير متطاير (تخزين حاسوبي لا يُفقد عند إيقاف تشغيل الطاقة)",
 "non-water-soluble": "غَيْرُ ذَوَّابٍ فِي المَاء (لا يذوب في الماء)",
 "non-zero": "غَيْرُ صِفْرِيّ (لَا يَتَضَمَّنُ الصِّفْرَ)",
 "nonabsorbency": "عدم الامتصاص (خاصية عدم القدرة على الامتصاص)",
 "nonabsorbent": "غَيْر مَاصّ (غير قادر على الامتصاص أو التشرب (للسوائل))",
 "nonabsorptive": "غَيْر مَاصّ (غير قادر على الامتصاص أو التشرب (للسوائل))",
 "nonacceptance": "رفض, عدم قبول (فعل رفض عرض ما)\nمثال: كان الرفض مؤدباً ولكن حازماً جداً",
 "nonaccomplishment": "إخفاق, عدم إنجاز (فعل لا يحقق هدفه المنشود)",
 "nonachievement": "إخفاق, عدم إنجاز (فعل لا يحقق هدفه المنشود)",
 "nonachiever": "طالب متعثر (طالب لا يؤدي بشكل جيد كما هو متوقع أو كما يشير معدل ذكائه)",
 "nonadaptive": "سَيِّئ التَّكَيُّف, مُخْتَلّ وَظِيفِيًّا ((عن سمة أو حالة) يفشل في خدمة غرض التكيّف)",
 "nonaddictive": "غَيْر مُسَبِّب لِلْإِدْمَان (لا يسبب أو يتميز بالإدمان)\nمثال: لسنوات زعمت شركات التبغ أن التبغ لا يسبب الإدمان",
 "nonadhesive": "غَيْر لَاصِق (لا يميل إلى الالتصاق)",
 "nonadjacent": "غَيْر مُتَجَاوِر (غير مجاور؛ غير متلاصق)",
 "nonadsorbent": "غَيْر مُمْتَزّ (يفتقر إلى القدرة على الامتزاز أو التسبب في التراكم على السطح)",
 "nonadsorptive": "غَيْر مُمْتَزّ (يفتقر إلى القدرة على الامتزاز أو التسبب في التراكم على السطح)",
 "nonage": "صغر, قصر (أي سن قبل السن القانوني)",
 "nonaged": "قاصر (لم يبلغ السن القانونية)\nمثال: أطفال قصر",
 "nonagenarian": "تِسْعِينِيّ (يتراوح عمره بين التسعين والتاسعة والتسعين) / تسعيني (شخص عمره في التسعينات)",
 "nonaggression": "عدم الاعتداء (سياسة عدم البدء بالأعمال العدائية)\nمثال: وقعوا ميثاق عدم اعتداء",
 "nonaggressive": "غَيْر عُدْوَانِيّ, مُسَالِم (ليس عدوانياً؛ لا يميل إلى القتال أو تأكيد الذات)",
 "nonagon": "تساعي الأضلاع, متسع (مضلع له تسعة أضلاع)",
 "nonalcoholic": "خالٍ من الكحول, غير كحولي (يتميز بغياب الكحول)\nمثال: مشروبات غير كحولية",
 "nonaligned": "غير منحاز (غير منتسب لأي فصيل أو حزب أو قضية)",
 "nonalignment": "عدم الانحياز (شعب (أو دول) غير متحالفين مع آخرين في حلف أو معاهدة)",
 "nonalinement": "عدم الانحياز (شعب (أو دول) غير متحالفين مع آخرين في حلف أو معاهدة)",
 "nonallele": "جين غير أليلي (جينات ليست منافسة في نفس الموقع)",
 "nonappearance": "تَخَلُّف عَن الحُضُور (الفشل في المثول (خاصة كما في المحكمة))",
 "nonappointive": "غَيْرُ تَعْيِينِيّ (يُشغَل بالانتخاب الشعبي لا بالتعيين)",
 "nonarbitrable": "غَيْر قَابِل لِلتَّحْكِيم (غير مناسب أو غير خاضع للتحكيم)",
 "nonarbitrary": "غير تعسفي, موضوعي (غير خاضع للتقدير الفردي البحت)",
 "nonarboreal": "غَيْر شَجَرِيّ (لا يعيش في أو يرتاد الأشجار)",
 "nonassertive": "غَيْر تَوْكِيدِيّ, مُتَحَفِّظ (لا يتّسم بالحزم في التأكيد على الذات وإن لم يفتقر بالضرورة إلى الثقة)",
 "nonassociative": "غَيْر تَرَابُطِيّ (غير ترابطي)",
 "nonastringent": "غَيْر قَابِض (ليس قابضاً)",
 "nonattendance": "عَدَم حُضُور, غِيَاب (الفشل في الحضور)",
 "nonattender": "متغيب, متهرب (شخص يتهرب من الواجب)",
 "nonautonomous": "تَابِع, غَيْر مُسْتَقِلّ ((عَنِ الشُّعُوب وَالكِيَانَات السِّيَاسِيَّة) خَاضِع لِسَيْطَرَة قُوًى خَارِجِيَّة)",
 "nonbearing": "غَيْر حَامِل ((لعضو هيكلي) لا يدعم أي وزن رأسي غير وزنه)\nمثال: أزالوا جداراً غير حامل",
 "nonbeing": "عدم, لا وجود (حالة عدم الكينونة)",
 "nonbeliever": "غير مؤمن, كافر (شخص يرفض الإيمان (كما في الألوهية))",
 "nonbelligerent": "غَيْرُ مُحَارِب (لَيْسَ فِي حَالَةِ حَرْبٍ مُبَاشَرَة)",
 "nonbiodegradable pollution": "تلوث غير قابل للتحلل (تلوث يتراكم في البيئة وقد يظهر في السلسلة الغذائية)",
 "noncallable bond": "سند غير قابل للاستدعاء (سند يحتوي على شرط يمنع حامله من استرداد الورقة المالية قبل تاريخ محدد (عادة عند الاستحقاق))",
 "noncaloric": "لا سعري (طعام لا يحتوي على سعرات حرارية (أو يحتوي على القليل منها))\nمثال: مشروب لا سعري",
 "noncandidate": "غير مرشح (شخص أعلن أنه ليس مرشحاً؛ خاصة سياسي أعلن أنه ليس مرشحاً لمنصب سياسي ما)",
 "noncarbonated": "غَيْرُ مُكَرْبَن (لا يحتوي على كربنة أو غاز ثاني أكسيد الكربون)",
 "noncausal": "غَيْر مُسَبِّب, لَا عِلِّيّ (ليس مسبباً)",
 "noncausative": "غَيْر مُسَبِّب, لَا عِلِّيّ (ليس مسبباً)",
 "nonce": "وقت راهن (المناسبة الحالية)\nمثال: للوقت الراهن",
 "nonce word": "لَفْظُ مُنَاسَبَة (نَطَقَ، تَكَلَّمَ؛ أَخْرَجَ، رَمَى)\nمثال: هذه الكلمة صعبة اللفظ.",
 "noncellular": "غَيْر خَلَوِيّ, لَا خَلَوِيّ (لا يتكون من أو ينقسم إلى خلايا)",
 "nonchalance": "برود, لا مبالاة (سمة البقاء هادئاً وعدم الاكتراث؛ نقص عرضي في الاهتمام)",
 "nonchalant": "غَيْر مُكْتَرِث, لَامُبَالٍ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "nonchalantly": "بِعَفَوِيَّة, بِلَا مُبَالَاة (بطريقة غير مبالية) / بِبُرُود, بِرَبَاطَة جَأْش (بطريقة هادئة وغير مبالية)\nمثال: ألقى نظرة غير مبالية على العناوين",
 "nonchristian": "غَيْر مَسِيحِيّ (لا ينتمي إلى المسيحيّة أو يتّسم بعدم الإيمان بها)",
 "nonchurchgoing": "تَارِك لِلْعِبَادَة, مُرْتَدّ (لم يعد يُمارِس الشعائر الدينيّة)",
 "noncitizen": "أجنبي, غريب (شخص قادم من بلد أجنبي؛ شخص لا يدين بالولاء لبلدك)",
 "noncivilised": "غَيْر مُتَحَضِّر, هَمَجِيّ (ليس لديه حالة عالية من الثقافة والتطور الاجتماعي)",
 "noncivilized": "غَيْر مُتَحَضِّر, هَمَجِيّ (ليس لديه حالة عالية من الثقافة والتطور الاجتماعي)",
 "nonclassical": "غَيْر كُلَاسِيكِيّ (غير كلاسيكي)",
 "noncoding dna": "إنترون (تسلسل من الحمض النووي لجين حقيقي النواة لا يترجم إلى بروتين)",
 "noncollapsable": "غَيْر قَابِل لِلطَّيّ (غير قادر على الانهيار أو الطي)",
 "noncollapsible": "غَيْر قَابِل لِلطَّيّ (غير قادر على الانهيار أو الطي)",
 "noncolumned": "بِلَا أَعْمِدَة, غَيْر مُعَمَّد (ليس لديه أعمدة)",
 "noncom": "صف ضابط, ضابط صف (ضابط عسكري يتم تعيينه من المجندين)",
 "noncombatant": "غَيْرُ مُقَاتِل (فَرْدٌ فِي القُوَّاتِ المُسَلَّحَةِ لَا تَشْمَلُ مَهَامُّهُ القِتَال) / غَيْرُ مُحَارِب (يُسْتَخْدَمُ لِوَصْفِ المَدَنِيِّينَ فِي زَمَنِ الحَرْب) / غير مقاتل (عضو في القوات المسلحة لا يشارك في القتال (مثل القسيس أو الجراح))",
 "noncombinative": "غَيْر تَوْفِيقِيّ (لا ينطوي على الجمع)",
 "noncombining": "غَيْر قَابِل لِلدَّمْج (غير قادر على الاندماج أو التركيب)",
 "noncombustible": "غَيْر قَابِل لِلاِحْتِرَاق (غير قادر على الاشتعال والاحتراق)",
 "noncommercial": "غير تجاري (غير مرتبط بالمشاريع التجارية أو غير منخرط فيها)",
 "noncommissioned": "ضابط صف, غير مفوض ((عن الضباط العسكريين) معين من بين الأفراد المجندين (وليس بتفويض ملكي أو رئاسي))",
 "noncommissioned officer": "صف ضابط, ضابط صف (ضابط عسكري يتم تعيينه من المجندين)",
 "noncommittal": "غَيْرُ مُلْتَزِم, مُتَحَفِّظ (يَرْفُضُ الالْتِزَامَ بِمَوْقِفٍ أَوْ مَسَارِ عَمَلٍ مُعَيَّن)",
 "noncommunicable": "غَيْرُ سَارٍ, غَيْرُ مُعْدٍ ((في الأمراض) غير قابل للانتقال من شخص إلى آخر)",
 "noncompetitive": "غير تنافسي (لا ينطوي على منافسة أو روح تنافسية)\nمثال: وظائف غير تنافسية",
 "noncompetitively": "دُونَ تَنَافُس (بطريقة غير تنافسية)\nمثال: ستمنح المنح الدراسية دون منافسة",
 "noncompliance": "عَدَم اِمْتِثَال, عِصْيَان (الفشل في الطاعة)",
 "noncompliant": "عاصٍ, متحدٍ (مقاوم بجرأة للسلطة أو لقوة معارضة) / عَنِيد, مُمَانِع (شخص يرفض الامتثال)\nمثال: تربى ليكون عدوانياً ومتحدياً",
 "noncomprehensive": "غير شامل (ليس شاملاً)",
 "noncomprehensively": "بِشَكْل غَيْر شَامِل, بِمَحْدُودِيَّة (بطريقة محدودة)",
 "nonconcentric": "لامتراكز, منحرف المركز (ليس له مركز مشترك؛ غير متحد المركز)\nمثال: دوائر لامتراكزة",
 "nonconducting": "عازل, غير موصل (غير قادر على توصيل الحرارة أو الكهرباء أو الصوت)",
 "nonconductive": "عازل, غير موصل (غير قادر على توصيل الحرارة أو الكهرباء أو الصوت)",
 "nonconductor": "عازل, مادة عازلة (مادة مثل الزجاج أو الخزف ذات موصلية كهربائية أو حرارية مهملة)",
 "nonconformance": "عدم امتثال, عدم مطابقة (فشل في الامتثال لمعايير السلوك المقبولة) / خروج عن المألوف, لا امتثال (الافتقار إلى الالتزام بالمعايير التقليدية في الأفكار أو المعتقدات)",
 "nonconforming": "غَيْر مُمْتَثِل, مُخَالِف (لا يمتثل للعادات أو المذاهب الراسخة خاصة في الدين)",
 "nonconformism": "خروج عن المألوف, عدم الامتثال (ممارسة عدم المطابقة أو عدم الامتثال للمعايير) / خروج عن المألوف, لا امتثال (الافتقار إلى الالتزام بالمعايير التقليدية في الأفكار أو المعتقدات)",
 "nonconformist": "خارج عن العرف, غير ممتثل (لا يمتثل لبعض المعايير أو الأنماط السلوكية أو الفكرية المقبولة اجتماعياً) / غَيْر مُمْتَثِل, مُخَالِف (لا يمتثل للعادات أو المذاهب الراسخة خاصة في الدين) / خارج عن المألوف, غير ممتثل (شخص يرفض الامتثال لمعايير السلوك الراسخة) / غير ملتزم, منشق عن الكنيسة الرسمية (بروتستانتي في إنجلترا ليس عضواً في كنيسة إنجلترا)\nمثال: سلوكهم غير الممتثل بشدة جعلهم أسطوريين",
 "nonconformity": "عدم امتثال, عدم مطابقة (فشل في الامتثال لمعايير السلوك المقبولة) / عَدَم امْتِثَال, مُخَالَفَة (الخروج عن المألوف كنتيجة لعدم الامتثال للمعايير أو القيم المتوقعة) / خروج عن المألوف, لا امتثال (الافتقار إلى الالتزام بالمعايير التقليدية في الأفكار أو المعتقدات) / عدم تطابق, عدم توافق (نقص في الانسجام أو التوافق)",
 "nonconscious": "غَيْر وَاعٍ, لَاوَاعٍ (مُتعلّق بانعدام الوعي في الأشياء غير الحيّة) / غَيْرُ شُعُورِيّ, لَاوَاعٍ (يَتَعَلَّقُ بِوَظَائِفَ ذِهْنِيَّةٍ غَيْرِ مُمَثَّلَةٍ فِي الوَعْيِ)",
 "noncontagious": "غَيْرُ سَارٍ, غَيْرُ مُعْدٍ ((في الأمراض) غير قابل للانتقال من شخص إلى آخر)",
 "noncontentious": "غَيْرُ خَصِم, وَدُود (لَا يَمِيلُ إِلَى الخِصَامِ أَوِ الجَدَل)",
 "noncontinuous": "غير مستمر, متقطع (لا يستمر دون انقطاع في الزمان أو المكان)\nمثال: تصفيق متقطع",
 "noncontroversial": "غير مثير للجدل (من غير المرجح أن يثير الجدل)",
 "nonconvergent": "غَيْرُ مُتَقَاطِع, مُتَوَازٍ ((لِلْخُطُوطِ وَالسُّطُوحِ وَالمُسْتَوَيَات) لَا يَلْتَقِي أَوْ يَتَقَاطَعُ أَبَدًا)",
 "noncritical": "غير ممحص, غير نقدي (يتميز بتجاهل المعايير أو الإجراءات النقدية) / غير حاسم, غير حرج (ليس في حالة أزمة أو طوارئ) / غير حرج (غير حرج؛ ليس عند نقطة تغيير مفاجئ)\nمثال: عكست مصادر الأخبار تقديرات غير ممحصة لعدد المدمنين الأحداث",
 "noncrucial": "غير حاسم, غير حرج (ليس في حالة أزمة أو طوارئ) / غير حاسم, غير مصيري (ذو أهمية قليلة؛ غير قاطع)",
 "noncrystalline": "غَيْر بَلُّورِيّ (ليس بلورياً)",
 "noncurrent": "غير جارٍ, غير حالي (غير حالي أو لا ينتمي إلى الوقت الحاضر)",
 "noncyclic": "غير دوري, لادوري (ليس دورياً) / غَيْرُ دَوْرِيّ (لا يتميز بدورات متكررة)",
 "noncyclical": "غير دوري, لادوري (ليس دورياً)",
 "nondeductible": "غير قابل للخصم (غير مسموح به كخصم)",
 "nondenominational": "مَسِيحِيَّةٌ لَا طَائِفِيَّةٌ (مؤنث المَسِيْحِيّ؛ المنسوبة إلى المَسِيْح؛ هي الدِيْن الذي يدين به المَسِيْحِيُّوْن؛ النَصْرَانِيَّة)\nمثال: اعتنق المسيحية.",
 "nondepository financial institution": "مؤسسة مالية غير إيداعية (مؤسسة مالية تمول أنشطتها الاستثمارية من بيع الأوراق المالية أو التأمين)",
 "nondescript": "بَاهِت, عَدِيم المَلَامِح (يفتقر لخصائص مميزة أو فردية؛ مُمِلّ وغير مثير للاهتمام) / شَخْص غَيْر مُمَيَّز (شخص لا يمكن تصنيفه بسهولة وليس مثيراً للاهتمام)",
 "nondevelopment": "عدم التطور (فشل حدوث التطور الطبيعي)",
 "nondigestible": "غَيْر قابِل لِلهَضْم (لا يُمكِن لِلجِهاز الهَضْمِيّ تَفْكيكُه)",
 "nondirectional antenna": "هوائي متعدد الاتجاهات (هوائي يرسل أو يستقبل الإشارات بالتساوي في جميع الاتجاهات)",
 "nondiscretionary trust": "صندوق ائتماني غير تقديري, صندوق استثمار ثابت (صندوق استثمار يمكنه شراء الأوراق المالية المدرجة فقط عند تنظيم الصندوق)",
 "nondisjunction": "عدم الانفصال (انقسام منصف تفشل فيه الكروموسومات المتماثلة المزدوجة في الانفصال؛ ينتج عنه عدد غير طبيعي من الكروموسومات في الخلايا الوليدة)",
 "nondisposable": "غير معد للرمي, متعدد الاستخدامات (غير مصمم ليتم رميه بعد الاستخدام) / غير قابل للتصرف فيه, غير متاح ((عن الأصول) غير متاح للاستخدام)",
 "nondrinker": "عَازِف عَنِ الْكُحُول, مُمْتَنِع (شخص يمتنع عن شرب المشروبات المسكرة)",
 "nondriver": "غير سائق (شخص ليس سائقاً)",
 "none": "لَا أَحَد (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: لا أحب المدرسة.",
 "none of someone's business": "لَيْسَ مِن شَأْنِكَ, لَيْسَ مِن شَأْنِكِ",
 "nonechoic": "غير محاكٍ للصوت (ليس صدوياً أو محاكياً للصوت)",
 "noneffervescent": "غير فوار (ليس فواراً) / راكد, غير فوار (ليس فواراً)\nمثال: نبيذ راكد",
 "nonelected": "غَيْرُ انْتِخَابِيّ (يُشغَل بالتعيين لا بالانتخاب)",
 "nonelective": "غَيْرُ انْتِخَابِيّ (يُشغَل بالتعيين لا بالانتخاب)",
 "nonenterprising": "غير مقدام, مفتقر للمبادرة (يفتقر إلى روح المبادرة؛ ليس جريئاً أو مغامراً)",
 "nonentity": "شخص غير مهم, لا أحد (شخص ليس له تأثير أو نفوذ) / عدم, لا وجود (حالة عدم الوجود)",
 "nonenzymatic": "لا إنزيمي (لا يتعلق بالإنزيمات أو ينتج عنها)\nمثال: أنظمة لا إنزيمية",
 "nonequivalence": "عَدَم تَكَافُؤ (غير قابل للتبادل)",
 "nonequivalent": "غَيْرُ مُعَادِل (ليس متساوياً أو قابلاً للتبادل في القيمة أو الكمّية أو الأهمية)",
 "nones": "صلاة الساعة التاسعة (الخامسة من الساعات القانونية السبع؛ حوالي الساعة 3 مساءً)",
 "nonessential": "عَرَضِيّ, هَامِشِيّ (ليس ذا أهمية مركزية أو أوّلية) / شيء ثانوي, غير ضروري (أي شيء ليس أساسياً)\nمثال: تخلصوا من جميع الأشياء غير الضرورية",
 "nonesuch": "مثال للكمال, نموذج مثالي (نموذج للتميز أو الكمال من نوعه؛ شخص لا مثيل له)",
 "nonesuch clover": "فصة ذئبية, فصة سوداء (عشب أوروبي مفترش ذو زهور صفراء صغيرة وقرون سوداء منحنية؛ تم توطينه في أمريكا الشمالية)",
 "nonetheless": "رغم ذلك, لكن (على الرغم من أي شيء مخالف (تسبق عادة التنازل))\nمثال: على الرغم من أنني خائف قليلاً، إلا أنني أود تجربتها مع ذلك",
 "nonevent": "حدث مخيب للآمال, لا حدث (حدث منتظر يتبين أنه أقل أهمية بكثير مما كان متوقعاً)",
 "nonexempt": "غير معفى ((للأشخاص) غير معفى من التزام أو مسؤولية) / خاضع للضريبة ((للسلع أو الأموال) يخضع للضريبة)\nمثال: دخل خاضع للضريبة",
 "nonexistence": "عَدَم (الفقدان ونقيض الوجود؛ يجب عدم فعل كذا: أي يجب الامتناع عن الفعل)\nمثال: عليك عدم الخوف.",
 "nonexistent": "مَعْدُوم",
 "nonexplorative": "غير استكشافي (ليس استكشافياً)",
 "nonexploratory": "غير استكشافي (ليس استكشافياً)",
 "nonexplosive": "غَيْر مُتَفَجِّر (غير متفجر)\nمثال: غازات غير متفجرة",
 "nonextant": "مُتَلَاشٍ, مُنْدَثِر (لم يعد موجوداً أو لا يمكن الوصول إليه بسبب الضياع أو التدمير) / بائد, منقرض (لم يعد موجوداً؛ ضائع أو خاصة انقرض دون ترك أي ممثلين أحياء)\nمثال: نوع منقرض من الأسماك",
 "nonextensile": "غير قابل للامتداد (غير قابل للامتداد)",
 "nonfat": "خالٍ من الدسم, منزوع الدسم (بدون دهون أو مواد صلبة دهنية)\nمثال: حليب خالٍ من الدسم",
 "nonfat dry milk": "حليب مجفف خالي الدسم (حليب منزوع الدسم ومجفف)",
 "nonfatal": "غير قاتل, غير مميت (لا يجلب الموت)\nمثال: نوبة قلبية غير مميتة",
 "nonfeasance": "إحجام, امتناع عن فعل (الفشل في التصرف عند وجود التزام بذلك؛ رفض (بدون عذر كاف) القيام بما هو واجب قانوني)",
 "nonfiction": "أدب واقعي, نثر غير خيالي (كتابة نثرية ليست خيالية)",
 "nonfictional": "غير خيالي, واقعي (ليس خيالياً)",
 "nonfictional prose": "أدب واقعي, نثر غير خيالي (كتابة نثرية ليست خيالية)",
 "nonfigurative": "تَجْرِيدِيّ, لَا تَشْخِيصِيّ (لا يمثل أو يحاكي الواقع الخارجي أو أشكال الطبيعة)",
 "nonfinancial": "غير مالي (لا ينطوي على أمور مالية)",
 "nonfinite": "غير متصرف, غير محدد ((عن الأفعال) ليس له زمن أو شخص أو عدد (مثل اسم الفاعل أو المصدر أو صيغة المصدر))\nمثال: صيغة فعل غير محددة",
 "nonfissile": "غير قابل للانشطار, غير قابل للفلق (غير قابل للتشقق أو الانفلاق)",
 "nonfissionable": "غير انشطاري (غير قابل للخضوع للانشطار النووي)",
 "nonflammable": "غَيْر قَابِل لِلاِشْتِعَال (يستحيل إشعاله)",
 "nonflavored": "غَيْرُ مُنَكَّه (بِدُونِ إِضَافَةِ مُنَكِّهَات)",
 "nonflavoured": "غَيْرُ مُنَكَّه (بِدُونِ إِضَافَةِ مُنَكِّهَات)",
 "nonflowering": "غير مزهر, لا زهري (بدون زهرة أو برعم ولا ينتج بذورًا)\nمثال: نبات لا زهري",
 "nonflowering plant": "نبات تريدي, نبات وعائي لا زهري (نباتات تحتوي على أنسجة وعائية وتتكاثر عن طريق الأبواغ)",
 "nonfluent aphasia": "حبسة بروكا, حبسة تعبيرية (حبسة يكون فيها التعبير عن طريق الكلام أو الكتابة معاقاً بشدة)",
 "nonfunctional": "لا وظيفي (لا يملك أو يؤدي وظيفة) / متعطل, مختل وظيفياً (لا يؤدي أو غير قادر على أداء وظيفته العادية)\nمثال: صمام متعطل",
 "nonglutinous": "غَيْر لَزِج (لا يُشبِه الغراء في ملمسه)",
 "nongonococcal urethritis": "التهاب إحليل غير سيلاني (التهاب الإحليل المنقول جنسياً (الذي تسببه عادة الكلاميديا))",
 "nongovernmental organization": "منظمة غير حكومية (منظمة ليست جزءاً من الحكومة المحلية أو الولائية أو الفيدرالية)",
 "nongranular": "غَيْرُ حُبَيْبِيّ (خالٍ من الحبيبات)",
 "nongregarious": "انْفِرَادِيّ, غَيْرُ قَطِيعِيّ ((في النباتات والحيوانات) لا ينمو أو يعيش في مجموعات أو مستعمرات)",
 "nonhairy": "غَيْر مُشْعِر (بدون شعر؛ خالٍ من الشعر)",
 "nonharmonic": "غير توافقي (ليس توافقياً)\nمثال: نغمة غير توافقية",
 "nonhereditary": "غَيْرُ وِرَاثِيّ (لا يُكتَسَب عن طريق الوراثة)",
 "nonheritable": "غير قابل للتوريث, غير وراثي (غير قابل لأن يورَّث)",
 "nonhierarchic": "غير هرمي (غير مصنف هرمياً)",
 "nonhierarchical": "غير هرمي (غير مصنف هرمياً)",
 "nonhuman": "غير بشري (ليس بشرياً؛ لا ينتمي إلى أو ينتج عن أو يناسب البشر)\nمثال: الرئيسيات غير البشرية مثل الشمبانزي",
 "nonidentity": "اخْتِلَاف الهُوِيَّة, عَدَم تَطَابُق (الاختلاف، التميز؛ فشل في أن يكون مطابقاً)",
 "nonimitative": "غير تقليدي, غير محاكٍ (لا يتميز بـأو يميل إلى التقليد)",
 "nonimmune": "عُرْضَة لِلْإِصَابَة, غَيْر مَنِيع ((يتبعه غالبًا 'لـ') من المرجح أن يتأثر بـ)",
 "nonindulgence": "تقشف (سمة إنكار الذات العظيم (خاصة الامتناع عن الملذات الدنيوية))",
 "nonindulgent": "حازم, صارم (يتميز بالصرامة أو الشدة أو الانضباط)",
 "nonindustrial": "غير صناعي (ليس لديه مشاريع تصنيعية متطورة للغاية)\nمثال: مجتمع غير صناعي",
 "noninfectious": "غَيْرُ مُعْدٍ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "noninflammatory": "غَيْرُ تَحْرِيضِيّ (لا يُثِير الفتنة أو الاستفزاز)",
 "noninheritable": "غير قابل للتوريث, غير وراثي (غير قابل لأن يورَّث)",
 "noninstitutional": "غير مؤسسي (ليس مؤسسياً)",
 "noninstitutionalised": "غير مُودع في مؤسسة (غير ملتزم بمؤسسة)",
 "noninstitutionalized": "غير مُودع في مؤسسة (غير ملتزم بمؤسسة)",
 "nonintegrated": "غير متكامل, غير مدمج (غير متكامل؛ لم يتم ضمه أو جعله جزءاً من الكل)",
 "nonintellectual": "غير ذهني, غير فكري (ليس فكرياً)",
 "noninterchangeable": "غَيْر قَابِل لِلتَّبَادُل (بحيث لا يمكن تبديل حدود التعبير دون تغيير المعنى)",
 "noninterference": "عدم التدخل (سياسة خارجية للبقاء خارج نزاعات الدول الأخرى)",
 "nonintersecting": "غَيْرُ مُتَقَاطِع, مُتَوَازٍ ((لِلْخُطُوطِ وَالسُّطُوحِ وَالمُسْتَوَيَات) لَا يَلْتَقِي أَوْ يَتَقَاطَعُ أَبَدًا)",
 "nonintervention": "عدم التدخل (سياسة خارجية للبقاء خارج نزاعات الدول الأخرى)",
 "noninvasive": "غير تدخلي, غير توغلي (يتعلق بتقنية لا تتضمن ثقب الجلد أو دخول تجويف الجسم)",
 "noninvasiveness": "عدم التدخل الجراحي, لا بضعية (صفة عدم كون الإجراء الطبي تدخليًا أو جراحيًا)\nمثال: اعتبر المتقبلون أن عدم التدخل الجراحي للإجراء أكثر أهمية من فعاليته المنخفضة نسبيًا",
 "nonionic": "غَيْر مُتَأَيِّن (غير محول إلى أيونات) / غير قطبي, لا أيوني (ليس أيونياً)\nمثال: مادة لا أيونية",
 "nonionised": "غَيْر مُتَأَيِّن (غير محول إلى أيونات)",
 "nonionized": "غَيْر مُتَأَيِّن (غير محول إلى أيونات)",
 "nonjudgmental": "غير حكمي, غير متحيز (يمتنع عن إصدار الأحكام خاصة تلك القائمة على آراء أو معايير شخصية)\nمثال: متعاطف وغير حكمي",
 "nonkilling": "لَا قَتْل (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: لا أحب المدرسة.",
 "nonkosher": "حَرَام يَهُودِيًّا, غَيْر كُوشَر (غير مطابق لقوانين الطعام الدينيّة)",
 "nonleaded": "خَالٍ مِن الرَّصَاص ((للبنزين) لا يحتوي على رابع إيثيل الرصاص)",
 "nonlegal": "خَارِج القَانُون (لَيْسَ ضِمْن الإِطار القانونِيّ؛ غَيْر مُنَظَّم بِقانون)",
 "nonlethal": "غَيْر قَاتِل (غَيْر قَادِر عَلَى التَّسَبُّب فِي المَوْت)",
 "nonlexical": "غير معجمي (لا يتعلق بالكلمات)\nمثال: مورفيمات غير معجمية",
 "nonlexically": "دون كلمات, غير معجمي (بدون استخدام الكلمات)\nمثال: معبر عنه غير معجمياً",
 "nonlinear": "غير خطي (يصف أو يتضمن معادلة تكون حدودها ليست من الدرجة الأولى)",
 "nonlinear correlation": "ارتباط غير خطي (أي ارتباط لا تكون فيه معدلات تغير المتغيرات ثابتة)",
 "nonlinear distortion": "تشويه السعة, تشويه غير خطي (تشويه يحدث عندما لا تكون إشارة الخرج ذات علاقة خطية بإشارة الدخل)",
 "nonlinear system": "نظام غير خطي (نظام لا يمكن وصف أدائه بمعادلات من الدرجة الأولى)",
 "nonlinguistic": "غير لغوي (لا يتكون من اللغة ولا يتعلق بها)\nمثال: اعتمد على مهاراته غير اللغوية",
 "nonliteral": "غير حرفي, مجازي ((تستخدم لمعاني الكلمات أو النصوص) غير حرفي؛ يستخدم صوراً بلاغية)\nمثال: لغة مجازية",
 "nonliterary": "بَسِيط, غَيْرُ أَدَبِيّ (يَتَّسِمُ بِخُلُوِّهِ مِنَ التَّكَلُّفِ أَوِ التَّحَذْلُقِ)",
 "nonliterate": "أُمِّيّ, قَبْل الكِتَابَة (ينتمي إلى مرحلة ما قبل معرفة الكتابة والقراءة)",
 "nonliving": "جَمَاد, غَيْر حَيّ (غير موهوب بالحياة)\nمثال: العالم غير العضوي جماد",
 "nonmagnetic": "غير مغناطيسي (غير قادر على أن يتم مغنطته)",
 "nonmalignant neoplasm": "ورم حميد (ورم غير سرطاني)",
 "nonmalignant tumor": "ورم حميد (ورم غير سرطاني)",
 "nonmalignant tumour": "ورم حميد (ورم غير سرطاني)",
 "nonmandatory": "غَيْرُ إِلْزَامِيّ (غير مطلوب بموجب قاعدة أو قانون)",
 "nonmaterial": "روحي, غير مادي (لا يتكون من مادة)\nمثال: أطياف غير مادية",
 "nonmeaningful": "بلا معنى, عبثي (ليس له معنى أو اتجاه أو غرض)\nمثال: مسعى بلا معنى",
 "nonmechanical": "غَيْر مِيكَانِيكِيّ ((للشخص) يفتقر إلى المهارات الميكانيكية) / غير ميكانيكي (ليس ميكانيكياً)",
 "nonmechanistic": "غَيْرُ آلِيّ (لَيْسَ ذا طَبِيعَةٍ مِيكَانِيكِيَّةٍ فِي التَّفْسِيرِ أَوِ المَنْهَج)",
 "nonmedicinal": "غَيْر دَوائِيّ, غَيْر طِبِّيّ (لَيْس لَه خَصائِص عِلاجِيَّة أو دَوائِيَّة)",
 "nonmember": "غَيْر عُضْو (شخص ليس عضواً)",
 "nonmetal": "لا فلزي, لا معدني (لا يحتوي على معدن ولا يشبهه ولا يتسم بخصائصه) / لا فلز (عنصر كيميائي يفتقر إلى الخصائص الفلزية النموذجية)\nمثال: عناصر لا فلزية",
 "nonmetallic": "لا فلزي, لا معدني (لا يحتوي على معدن ولا يشبهه ولا يتسم بخصائصه)\nمثال: عناصر لا فلزية",
 "nonmetamorphic": "غير متحول (ليس متحولاً)",
 "nonmigratory": "غير مهاجر, مستوطن (يُستخدم للحيوانات التي لا تهاجر)",
 "nonmilitary": "غَيْر عَسْكَرِيّ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "nonmodern": "غير حديث, قديم (ليس حديثاً؛ من زمن سابق أو يتسم بخصائصه)",
 "nonmonotonic": "غير رتيب, غير مطرد (ليس رتيباً أو مطرداً)",
 "nonmotile": "عَدِيمُ الحَرَكَة ((لِلأَبْوَاغِ أَوِ الكَائِنَاتِ الدَّقِيقَة) غَيْرُ قَادِرٍ عَلَى الحَرَكَة)",
 "nonmoving": "ساكن, غير متحرك (ليس في حالة حركة)",
 "nonmusical": "غير موسيقي (غير موسيقي بطبيعته) / عديم الموهبة الموسيقية (يفتقر إلى الاهتمام بالموسيقى أو الموهبة فيها)\nمثال: صرخة طائر القيق الأزرق غير الموسيقية",
 "nonnative": "دَخِيل, غَيْرُ مَحَلِّيّ ((عَنِ النَّبَاتَاتِ أَوِ الحَيَوَانَاتِ) نَشَأَ فِي مَنْطِقَةٍ غَيْرِ الَّتِي يَنْمُو فِيهَا) / مَوْلُودٌ فِي الخَارِج ((عَنِ الأَشْخَاصِ) وُلِدَ فِي مَنْطِقَةٍ أَوْ بَلَدٍ غَيْرِ الَّذِي يَعِيشُ فِيهِ) / دخيل, غير أصلي (لا يتكون من السكان الأصليين)\nمثال: السكان غير الأصليين في جنوب أفريقيا",
 "nonnatural": "مَا وَرَائِيّ, مُتَعَالٍ (يوجد خارج نطاق الطبيعة أو لا يتوافق معها)",
 "nonnegative": "غَيْر سَالِب (إما موجب أو يساوي صفراً)",
 "nonnomadic": "غَيْر بَدَوِيّ, مُسْتَقِرّ (ليس رحّالًا أو متنقّلًا)",
 "nonnormative": "غَيْر مِعْيَارِيّ, لَا قِيَاسِيّ (لا يستند إلى قاعدة أو معيار)",
 "nonobjective": "تَجْرِيدِيّ, لَا تَشْخِيصِيّ (لا يمثل أو يحاكي الواقع الخارجي أو أشكال الطبيعة)",
 "nonobligatory": "غَيْرُ إِلْزَامِيّ (غير مطلوب بموجب قاعدة أو قانون)",
 "nonobservance": "عدم التزام, مخالفة (عدم الامتثال لقانون أو عرف أو ممارسة)",
 "nonobservant": "غَيْر مُلْتَزِم دِينِيًّا (يُهمِل الالتزام بالشعائر والتقاليد الدينيّة أو يرفضها)",
 "nonoccurrence": "عدم حدوث (الغياب بحكم عدم الحدوث)",
 "nonopening": "غَيْر قَابِل لِلْفَتْح (لا يُفتَح؛ مغلق بشكل دائم)",
 "nonoperational": "خامل, غير عملياتي ((عسكري) غير مشارك في العمليات العسكرية)",
 "nonoptimality": "عدم المثالية, لا مثالية (حالة عدم كون الشيء الأفضل أو الأكثر ملاءمة أو المرغوب فيه)\nمثال: يتم تعريف مستوى عدم المثالية على أنه نسبة أداء التصفية للمقدرات المبسطة والمثالية",
 "nonoscillatory": "غَيْرُ تَذَبْذُبِيّ (ليس له اهتزازات دورية)",
 "nonparallel": "غَيْرُ مُتَوَازٍ, مُتَقَارِب ((لِلْخُطُوطِ وَالمَسَارَات) غَيْرُ مُتَوَازٍ؛ مُتَقَارِب) / تَتَابُعِيّ, تَسَلْسُلِيّ (يتعلق بالتنفيذ المتتابع لعمليات متعددة)",
 "nonparametric": "لا بارامتري, لا وسيطي (لا ينطوي على تقدير لوسائط (بارامترات) إحصائية)",
 "nonparametric statistic": "إحصائية حرة التوزيع, إحصائية لامعلمية (إحصائية تُحسب دون معرفة شكل أو معلمات التوزيع الذي سُحبت منه الملاحظات)",
 "nonparametric statistics": "إحصاء لا معلمي (فرع الإحصاء الذي يتعامل مع المتغيرات دون وضع افتراضات حول شكل أو معلمات توزيعها)",
 "nonparasitic": "حُرُّ المَعِيشَة, غَيْرُ طُفَيْلِيّ (لَا يَتَطَفَّلُ عَلَى كَائِنٍ آخَر)",
 "nonpareil": "لَا مَثِيلَ لَهُ, لَا نَظِيرَ لَهُ (بارز يفوق أيّ مقارنة؛ فريد لا يُضاهى) / أقراص شوكولاتة مزينة (قرص مسطح من الشوكولاتة مغطى بحبيبات السكر الملونة) / حبيبات السكر الملونة, فارماسيل (حبيبات ملونة من السكر تستخدم كطبقة علوية على الحلويات والكعك) / مثال للكمال, نموذج مثالي (نموذج للتميز أو الكمال من نوعه؛ شخص لا مثيل له)",
 "nonpareille": "نومبارييل (نوع طباعة بحجم 6 نقاط)",
 "nonparticipant": "غَيْر مُشَارِك (شخص لا يشارك)",
 "nonparticipation": "عَدَم الاِنْخِرَاط, عَدَم المُشَارَكَة (الانسحاب من أنشطة المجموعة)",
 "nonparticulate": "لا جسيمي (غير مكون من جسيمات متميزة)",
 "nonparticulate radiation": "إشعاع كهرومغناطيسي, موجة كهرومغناطيسية (إشعاع يتكون من موجات من الطاقة مرتبطة بمجالات كهربائية ومغناطيسية ناتجة عن تسارع شحنة كهربائية)",
 "nonpartisan": "غير حزبي, محايد (خالٍ من الانتماء الحزبي أو التحيز) / غَيْر مُتَحَزِّب (شخص غير متحزب)",
 "nonpartisanship": "تجرد, حياد (الميل لوزن وجهتي النظر أو الآراء بالتساوي)",
 "nonpartizan": "غير حزبي, محايد (خالٍ من الانتماء الحزبي أو التحيز) / غَيْر مُتَحَزِّب (شخص غير متحزب)",
 "nonpasserine": "غير عصفوري (متعلق بـ أو مميز للطيور التي ليست من الطيور الجاثمة)",
 "nonpasserine bird": "طائر غير جاثم (طيور شجرية بشكل رئيسي خاصة من رتبة الشقراقيات)",
 "nonpayment": "تهرب, عدم الدفع (الفعل المتعمد لعدم دفع المال) / تخلف عن الدفع, عدم السداد (خسارة ناتجة عن عدم سداد دين) / تخلف عن السداد, تعثر (فعل الفشل في الوفاء بالتزام مالي)\nمثال: تهربه من جميع دائنيه",
 "nonperformance": "إهمال, تقصير (الفشل في التصرف بالحكمة التي يمارسها الشخص العاقل في نفس الظروف)",
 "nonperiodic": "لا دوري (لا يتكرر على فترات منتظمة)",
 "nonperson": "شَخْص مَلْغِيّ الوُجُود, لَا شَخْص (شخص يُعتبر غير موجود ولا يتمتع بأي حقوق؛ شخص يتم تجاهل وجوده بشكل منهجي (خاصة لأسباب أيديولوجية أو سياسية))\nمثال: يُعامل السيناتور السابق كشخص غير موجود من قبل هذه الإدارة",
 "nonpersonal": "غَيْر شَخْصِيّ, لَا شَخْصَانِيّ (يفتقر إلى الطابع الشخصيّ)",
 "nonphotosynthetic": "غير تمثيلي ضوئي (لا يقوم بالتمثيل الضوئي)",
 "nonphysical": "غَيْرُ مَلْمُوس, لَا مَادِّيّ (يَفْتَقِرُ إِلَى الجَوْهَرِ أَوِ الوَاقِعِيَّة؛ لَا يُمْكِنُ لَمْسُهُ أَوْ رُؤْيَتُه)",
 "nonplused": "حَائِر, مُتَحَيِّر (مليء بالحيرة والارتباك)",
 "nonplussed": "حَائِر, مُتَحَيِّر (مليء بالحيرة والارتباك)",
 "nonpoisonous": "غَيْرُ سَامّ (آمن للأكل) / غَيْرُ سَامّ (لا ينتج سمًّا ولا يحتوي عليه)",
 "nonpolar": "غير قطبي, لا أيوني (ليس أيونياً)\nمثال: مادة لا أيونية",
 "nonpolitical": "غير سياسي (ليس سياسياً)",
 "nonporous": "أَصَمّ, غَيْر مَسَامِيّ (غير مسامي؛ خاصة لا يحتوي على أوعية تظهر كمسام)\nمثال: خشب غير مسامي",
 "nonpregnant": "غَيْر حَامِل (ليست حاملاً)",
 "nonprehensile": "غَيْر قَابِض (ليس قابضاً)",
 "nonproductive": "غَيْر مُنْتِج مُبَاشَرَةً (لا يُنتِج بشكل مباشر)",
 "nonprofessional": "غير محترف, غير مهني (لا يعمل في مهنة أو لا يتعلق بها)\nمثال: زوجات زملائه الذكور غير العاملات",
 "nonprofit": "غَيْرُ رِبْحِيّ, غَيْرُ هَادِفٍ لِلرِّبْحِ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "nonprofit organization": "منظمة غير ربحية (منظمة مرخصة لأنشطة غير ربحية)",
 "nonprognosticative": "غَيْر اِسْتِشْرَافِيّ (لا يقدّم تنبّؤات أو توقّعات)",
 "nonprogressive": "جَامِد, عَتِيقُ الطِّرَازِ (قَدِيمُ الطَّرِيقَةِ وَمُتَخَلِّفٌ عَنِ العَصْرِ)",
 "nonproliferation": "عدم انتشار, منع الانتشار (منع شيء من التزايد أو الانتشار (خاصة منع زيادة عدد الدول التي تمتلك أسلحة نووية))\nمثال: نزع السلاح النووي ومنع الانتشار هدفان مترابطان",
 "nonproliferation center": "مركز منع الانتشار (وكالة تعمل كنقطة محورية لجميع أنشطة مجتمع الاستخبارات المتعلقة بمنع انتشار أسلحة الدمار الشامل وأنظمة إطلاق الصواريخ الخاصة بها)",
 "nonproprietary": "غير مملوك, مشاع (غير محمي بعلامة تجارية أو براءة اختراع أو حقوق نشر)\nمثال: المنتجات غير المملوكة تكون في المجال العام ويمكن لأي شخص إنتاجها أو توزيعها",
 "nonprotractile": "غير قابل للامتداد (غير قابل للامتداد)",
 "nonpsychoactive": "غير مؤثر عقلياً (لا يؤثر على العقل أو العمليات العقلية)\nمثال: مسكن ألم غير مؤثر عقلياً",
 "nonpublic": "غَيْر حُكُومِيّ, غَيْر عَامّ (غير مرتبط بمنصب بارز أو مكانة عامّة)",
 "nonpurulent": "غَيْر قَيْحِيّ (لا يحتوي على قيح أو صديد)",
 "nonracial": "غير عرقي (ليس عرقياً؛ لا علاقة له بالعرق أو الأجناس)\nمثال: كانت ملاحظاته تهدف إلى أن تكون غير عرقية تماماً",
 "nonracist": "خَالٍ مِنَ التَّحَيُّز العِرْقِيّ, غَيْر عُنْصُرِيّ (غَيْر مُتَحَيِّز بِشَأْن العِرْق)",
 "nonradioactive": "غَيْر مُشِعّ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "nonrandom": "غير عشوائي (ليس عشوائياً)",
 "nonrapid eye movement": "نوم حركة العين غير السريعة, نوم غير حالم (حالة نوم متكررة لا تحدث خلالها حركات العين السريعة ولا تحدث الأحلام؛ تمثل حوالي 75% من وقت النوم الطبيعي)",
 "nonrapid eye movement sleep": "نوم حركة العين غير السريعة, نوم غير حالم (حالة نوم متكررة لا تحدث خلالها حركات العين السريعة ولا تحدث الأحلام؛ تمثل حوالي 75% من وقت النوم الطبيعي)",
 "nonrational": "حَدْسِيّ, غَرِيزِيّ (مُكْتَسَب بِالحَدْس لا بِالتَّفْكير أَوْ المُلاحَظَة) / لَاعَقْلَانِيّ (غير مبنيّ على العقل أو المنطق)",
 "nonreader": "أُمِّي, غير قارئ (شخص غير قادر على القراءة) / بطيء القراءة (طالب بطيء جداً في تعلم القراءة)",
 "nonreciprocal": "غير متبادل (ليس متبادلاً)",
 "nonreciprocating": "غَيْرُ تَرَدُّدِيّ (لا يتحرك بالتناوب إلى الأمام والخلف)",
 "nonrecreational": "غَيْر تَرْفِيهِيّ, مَأْجُور (ينطوي على عمل مأجور فيما يُمارَس غالبًا كهواية)",
 "nonreflecting": "غير عاكس (غير قادر على الانعكاس الفيزيائي)",
 "nonreflective": "غير عاكس (غير قادر على الانعكاس الفيزيائي)",
 "nonreligious person": "شخص غير متدين (شخص لا يظهر التبجيل لإله)",
 "nonremittal": "تخلف عن الدفع, عدم السداد (خسارة ناتجة عن عدم سداد دين) / تخلف عن السداد, تعثر (فعل الفشل في الوفاء بالتزام مالي)",
 "nonrenewable": "غير قابل للتجديد (لا يمكن تجديده)\nمثال: الكتب على ذلك الرف غير قابلة للتجديد",
 "nonrepetitive": "غير تكراري (يتميز بغياب التكرار)\nمثال: تسلسل حمض نووي غير تكراري",
 "nonrepresentational": "تجريدي, غير تمثيلي (يتعلق بنمط فني لا تشبه فيه الأشياء تلك المعروفة في الطبيعة المادية)",
 "nonrepresentative": "غير رمزي, غير ممثل (لا ينوب عن شيء آخر)",
 "nonresident": "غير مقيم (لا يعيش في مكان معين أو مملوك لمقيمين دائمين) / غَيْر مُقِيم (شخص لا يعيش في مكان معين)\nمثال: طلاب غير مقيمين يتنقلون إلى الفصول",
 "nonresidential": "غير سكني (غير مخصص للسكن)\nمثال: المناطق التجارية أو غير السكنية في المدينة",
 "nonresilient": "غَيْرُ مُرْتَدّ (ليس مرناً ولا يرتدّ)",
 "nonresinous": "غَيْر رَاتِنْجِيّ (لا يحتوي على راتنج)",
 "nonresiny": "غَيْر رَاتِنْجِيّ (لا يحتوي على راتنج)",
 "nonresistance": "عَدَم المُقَاوَمَة (رفض جماعي للجوء إلى العنف حتى في الدفاع ضد العنف)",
 "nonresistant": "غَيْرُ مُقَاوِم, مُسْتَسْلِم (لَا يُبْدِي أَيَّ مُقَاوَمَة؛ مُذْعِن) / عُرْضَة لِلْإِصَابَة, غَيْر مَنِيع ((يتبعه غالبًا 'لـ') من المرجح أن يتأثر بـ)",
 "nonresonant": "غير رنان, غير مدو (غير مرجع للصدى؛ يفتقر للميل لإحداث صدى)",
 "nonrestrictive": "غَيْرُ تَحْدِيدِيّ (لا يُقيِّد مرجع الكلمة أو العبارة المُعدَّلة)",
 "nonrestrictive clause": "جملة غير تقييدية, جملة وصفية (جملة تابعة لا تحد أو تقيد معنى العبارة الاسمية التي تعدلها)",
 "nonreticulate": "غير شبكي (لا يشبه أو يشكل شبكة)",
 "nonretractable": "غير قابل للسحب (غير قابل للانكماش)",
 "nonretractile": "غير قابل للسحب (غير قابل للانكماش)",
 "nonreturnable": "غير قابل للإرجاع (لا يمكن إعادته)\nمثال: الزجاجات غير القابلة للإرجاع لا يمكن استبدالها ببدل رهن",
 "nonreversible": "أحادي الوجه, غير قابل للقلب (غير قابل للعكس أو لاستخدام أي من الجانبين للخارج)",
 "nonrhythmic": "غَيْرُ إِيقَاعِيّ (خالٍ من الإيقاع عن قصد)",
 "nonrigid": "غير صلب الهيكل, مرن الهيكل (يصف منطاداً يحافظ على شكله فقط عن طريق ضغط الغاز الداخلي ودون هيكل داعم)",
 "nonruminant": "غير مجتر (ليس مجتراً)",
 "nonsectarian": "غير طائفي, لا طائفي (لا يقتصر على طائفة أو مدرسة أو حزب واحد)\nمثال: تدريب ديني في جو غير طائفي",
 "nonsegmental": "غَيْرُ مُجَزَّأ (له جسم غير مقسم إلى أجزاء أو فقرات)",
 "nonsegregated": "غَيْرُ مَفْصُول, مُنْهِي لِلْفَصْل (أُزيل منه الفصل العنصري؛ انتهى فيه التمييز)",
 "nonsense": "هُرَاء, لَغْو",
 "nonsense verse": "كِتَابَة بِلَا مَعْنًى, هُرَاء شِعْرِيّ (كتابة لا معنى لها (عادة شعر))",
 "nonsensical": "لَا مَعْقُول, هُرَائِيّ (لا يحمل أي معنى مفهوم) / سَخِيف, مُثِير لِلسُّخْرِيَة (بالغ اللامعقوليّة بحيث يستدعي الاستهزاء والسخرية)",
 "nonsensicality": "كَلَام فَارِغ, لَغْو (رسالة يبدو أنها لا تحمل أي معنى)",
 "nonsensitive": "غَيْر حَسَّاس, غَيْر مُقَيَّد (لا يخضع لتصنيف سرّيّ ومتاح للتداول)",
 "nonsexual": "لا جنسي (ليس لديه أو لا ينطوي على الجنس)\nمثال: بوغ لا جنسي",
 "nonsignificant": "عرضي, غير ذي دلالة (يُعزى إلى الصدفة)",
 "nonsingular matrix": "مصفوفة غير منفردة (مصفوفة مربعة لا يساوي محددها صفراً)",
 "nonskid": "مَانِعٌ لِلِانْزِلَاقِ (مصمَّم للحدّ من الانزلاق أو منعه)",
 "nonslip": "مُضَادٌّ لِلِانْزِلَاقِ (مصمَّم لتقليل الانزلاق أو منعه)",
 "nonslippery": "غير زلق (ليس زلقًا؛ ليس من المحتمل أن ينزلق)",
 "nonsmoker": "عربة لغير المدخنين (عربة ركاب للمسافرين الذين يرغبون في تجنب دخان التبغ) / غَيْر مُدَخِّن (شخص لا يدخن التبغ)",
 "nonsmoking car": "عربة لغير المدخنين (عربة ركاب للمسافرين الذين يرغبون في تجنب دخان التبغ)",
 "nonsocial": "انْفِرَادِيّ, غَيْرُ قَطِيعِيّ ((في النباتات والحيوانات) لا ينمو أو يعيش في مجموعات أو مستعمرات)",
 "nonsocial infection": "عدوى المستشفيات, عدوى متقاطعة (عدوى يتم اكتسابها في مستشفى أو منشأة رعاية صحية أخرى)",
 "nonsolid color": "لون غير مصمت, لون منقط (لون ينتج عن نمط من نقاط ملونة مختلفة تحاكي معاً اللون المطلوب)",
 "nonsolid colour": "لون غير مصمت, لون منقط (لون ينتج عن نمط من نقاط ملونة مختلفة تحاكي معاً اللون المطلوب)",
 "nonsovereign": "تَابِع, غَيْر مُسْتَقِلّ ((عَنِ الشُّعُوب وَالكِيَانَات السِّيَاسِيَّة) خَاضِع لِسَيْطَرَة قُوًى خَارِجِيَّة)",
 "nonspatial": "لا مكاني (غير مكاني)\nمثال: متصل لا مكاني",
 "nonspeaking": "صَامِت, غَيْر نَاطِق (غير قادر على أو لا ينطوي بشكل خاص على الكلام أو السطور المنطوقة)\nمثال: كان له دور صامت في المسرحية",
 "nonspecific": "غير محدد, لا نوعي (غير ناتج عن عامل محدد؛ يستخدم أيضاً للتلوين في إعداد الشرائح المجهرية)\nمثال: التهاب الأمعاء اللا نوعي",
 "nonspecific urethritis": "التهاب إحليل غير نوعي (التهاب الإحليل مجهول السبب)",
 "nonspecifically": "بشكل غير محدد (بدون تحديد)\nمثال: مواد تلطخ بشكل غير محدد",
 "nonspherical": "غير كروي (ليس كروياً)",
 "nonstandard": "شَاذّ",
 "nonstandardness": "لَا مِعْيَارِيَّة, مُخَالَفَة القِيَاس (حالة أو شرط عدم كون الشيء قياسياً أو معيارياً)",
 "nonstarter": "غير مشارك (حصان يفشل في الركض في سباق تم تسجيله فيه) / خاسِر, فاشِل (شخص لديه سجل من الفشل؛ شخص يخسر باستمرار)",
 "nonsteroid": "غير ستيرويدي (مركب عضوي لا يحتوي على ستيرويد)",
 "nonsteroidal": "غير ستيرويدي (ليس ستيرويدياً أو ليس له تأثيرات الهرمونات الستيرويدية) / غير ستيرويدي (مركب عضوي لا يحتوي على ستيرويد)",
 "nonsteroidal anti-inflammatory": "مضاد التهاب غير ستيرويدي (دواء مضاد للالتهاب لا يحتوي على الستيرويدات)\nمثال: مضادات الالتهاب غير الستيرويدية تثبط نشاط كل من إنزيمات كوكس-1 وكوكس-2",
 "nonsteroidal anti-inflammatory drug": "مضاد التهاب غير ستيرويدي (دواء مضاد للالتهاب لا يحتوي على الستيرويدات)\nمثال: مضادات الالتهاب غير الستيرويدية تثبط نشاط كل من إنزيمات كوكس-1 وكوكس-2",
 "nonstick": "غَيْرُ لَاصِق ((للأسطح وخاصّة أواني الطهي) يسمح بإزالة الطعام الملتصق بسهولة)",
 "nonstop": "رحلة بدون توقف (رحلة تتم دون توقفات وسيطة بين المصدر والوجهة) / بلا توقف (بدون توقف) / دُونَ تَوَقُّف, عَلَى مَدَارِ السَّاعَة (فِي جَمِيعِ الأَوْقَات؛ دُونَ انْقِطَاع) / بِدُون تَوَقُّف ((عَنِ الرِّحْلَات خَاصَّةً الجَوِّيَّة) تَتِمّ بِدُون تَوَقُّفَات)\nمثال: كم عدد الرحلات بدون توقف إلى دالاس؟",
 "nonstop flight": "رحلة بدون توقف (رحلة تتم دون توقفات وسيطة بين المصدر والوجهة)\nمثال: كم عدد الرحلات بدون توقف إلى دالاس؟",
 "nonstructural": "غَيْر إِنْشَائِيّ (لَيْسَ ذَا طَبِيعَة إِنْشَائِيَّة أَوْ بِنْيَوِيَّة)",
 "nonsubjective": "غير متحيز, موضوعي (غير مشوه بالعاطفة أو التحيز الشخصي؛ قائم على ظواهر قابلة للملاحظة)\nمثال: تقييم موضوعي",
 "nonsubmergible": "غير غاطس (غير قابل للغمر أو الغطس)",
 "nonsubmersible": "غير غاطس (غير قابل للغمر أو الغطس)",
 "nonsuch": "مثال للكمال, نموذج مثالي (نموذج للتميز أو الكمال من نوعه؛ شخص لا مثيل له)",
 "nonsuppurative": "غير قيحي (ليس قيحياً)",
 "nonsurgical": "غير جراحي (لا ينطوي على جراحة)\nمثال: تقنيات غير جراحية",
 "nonsweet": "خال من السكر (لا يحتوي على السكر)",
 "nonsyllabic": "غير مقطعي ((لأصوات الكلام) لا تشكل أو غير قادرة على تشكيل نواة مقطع لفظي) / غير مقطعي (لا يشكل مقطعًا أو نواة مقطع؛ يتكون من صوت ساكن مصحوب في نفس المقطع بصوت متحرك أو يتكون من صوت متحرك يهيمن عليه أصوات متحركة أخرى في مقطع)",
 "nonsymbiotic": "حُرُّ المَعِيشَة, غَيْرُ طُفَيْلِيّ (لَا يَتَطَفَّلُ عَلَى كَائِنٍ آخَر)",
 "nonsynchronous": "غَيْر مُتَزَامِن (لا يحدث في وقت واحد)",
 "nonsynthetic": "طَبِيعِيّ, غَيْر تَرْكِيبِيّ (مشتق من كائنات حية؛ خالٍ من المعالجات أو الإضافات الكيميائية)",
 "nontaxable": "غير خاضع للضريبة, معفى ((للسلع أو الأموال) لا يخضع للضريبة)\nمثال: أموال المنظمات غير الربحية غير خاضعة للضريبة",
 "nontechnical": "غير تقني, غير فني (ليس من سمات أو لا يتطلب مهارة في الفنون والعلوم التطبيقية)\nمثال: جوانب غير فنية للوظيفة",
 "nontelescopic": "غَيْر تِلِسْكُوبِيّ (غير قابل للتداخل أو الانزلاق)",
 "nontelescoping": "غَيْر تِلِسْكُوبِيّ (غير قابل للتداخل أو الانزلاق)",
 "nonterritorial": "غير إقليمي (لا يظهر نزعة إقليمية)\nمثال: نوع غير إقليمي",
 "nontextual matter": "رسومات, عمل فني (صور فوتوغرافية أو تمثيلات مرئية أخرى في منشور مطبوع)\nمثال: كان الناشر مسؤولاً عن جميع الأعمال الفنية في الكتاب",
 "nonthermal": "لا حراري (لا ينطوي على حرارة)\nمثال: تلألؤ لا حراري",
 "nonthrombocytopenic purpura": "فرفرية غير قليلة الصفيحات (فرفرية ناتجة عن خلل في الشعيرات الدموية تسببه البكتيريا أو الأدوية)",
 "nontoxic": "غَيْرُ سَامّ (آمن للأكل) / غير سام (لا ينتج أو ينتج عن سم)",
 "nontoxicity": "عدم السمية, لا سمية (حالة عدم كون المادة سامة)\nمثال: تمت الإشارة أيضًا إلى عدم سمية كبريتات الألمنيوم من خلال تجارب زراعة التربة",
 "nontraditional": "غير تقليدي (لا يتوافق مع أو لا ينسجم مع التقاليد)\nمثال: تصاميم غير تقليدية",
 "nontransferable": "غَيْر قَابِل لِلتَّحْوِيل (لا يمكن نقله أو تحويله إلى شخص آخر)",
 "nontranslational": "غير انتقالي (من أو متعلق بحركة ليست موحدة أو ليست بدون دوران)",
 "nontransmissible": "غَيْرُ سَارٍ, غَيْرُ مُعْدٍ ((في الأمراض) غير قابل للانتقال من شخص إلى آخر) / غَيْرُ وِرَاثِيّ (لا يُكتَسَب عن طريق الوراثة)",
 "nontricyclic": "مضاد اكتئاب غير ثلاثي الحلقات",
 "nontricyclic antidepressant": "مضاد اكتئاب غير ثلاثي الحلقات",
