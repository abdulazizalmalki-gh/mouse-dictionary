 "ophthalmia neonatorum": "رمد وليدي (رمد لدى الأطفال حديثي الولادة؛ يتم التقاطه أثناء المرور عبر قناة الولادة؛ عادة ما يتم الوقاية منه بقطرات نترات الفضة)",
 "ophthalmic": "رمدي, عيني (متعلق بالعين أو يشبهها) / رمدي, عيوني (متعلق بطب العيون)\nمثال: عضلات عينيه",
 "ophthalmic artery": "شريان عيني (فرع من الشريان السباتي الباطن يغذي العين والتراكيب المجاورة)",
 "ophthalmic vein": "وريد عيني (أي من وريدين يخدمان العين؛ يصب في الجيب الكهفي)",
 "ophthalmitis": "رَمَد ((رَمَدَ) يَرْمِدُ رَمْدًا، ورَمادَةً: هَلَك وَصَار كالرَّمادِ؛ (رَمَدَ) الشيءَ رَمْدًا: أهْلَكَهُ وأَتَى عليه)",
 "ophthalmologist": "طَبِيب عُيُون (العالم بالطب)\nمثال: سوف تصبح طبيبة.",
 "ophthalmology": "طِبّ اَلْعُيُون (العِلْم؛ دراسة أسباب وتَشْخِيْص ومُعَاْلَجَة الأمراض)\nمثال: اختص في طب القلب.",
 "ophthalmoplegia": "شلل العين (شلل الأعصاب الحركية للعين)",
 "ophthalmoscope": "منظار العين (أداة طبية لفحص شبكية العين)",
 "ophthalmoscopy": "تنظير العين (فحص الجزء الداخلي من العين باستخدام منظار العين)",
 "opiate": "أَفْيُونِيّ",
 "opine": "رَأَى, ظَنَّ (أدرك أو لاحظ شيئًا أو شخصًا بالعينين؛ اعْتَقَدَ، تَأَمَّلَ)\nمثال: رأى ياني منزلا.",
 "opinion": "رَأْي, نَظَر",
 "opinion poll": "استطلاع رأي, استفتاء (استقصاء للرأي العام يتم عن طريق مقابلة عينة عشوائية من الناس)",
 "opinionated": "مُتَعَنِّت",
 "opinionative": "عَنِيد الرَّأْي, مُتَشَبِّث بِرَأْيِه (مُتَعَنِّت فِي آرَائِه ولَا يَقْبَل النِّقَاش)",
 "opisthion": "أُخَيْرَى",
 "opisthocomus hoazin": "هواتزين (طائر جنوب أمريكي ذو عرف كريه الرائحة لصغاره مخالب في الإصبعين الأول والثاني من الأجنحة)",
 "opisthocranion": "ذُمَيْرَى",
 "opisthognathous": "متراجع الفك (لديه فكوك متراجعة)",
 "opisthorchiasis": "داء متفرعات الخصية (الإصابة بالديدان المثقوبة الناتجة عن تناول الأسماك النيئة؛ شائعة في شرق آسيا)",
 "opisthotonos": "تشنج ظهري, تكزز ظهري (تشنج شديد يتقوس فيه الظهر ويميل الرأس للخلف وتتجه الكعبان نحو الظهر)",
 "opium": "أَفْيُون",
 "opium addict": "مدمن أفيون (شخص مدمن على الأفيون)",
 "opium den": "وكر أفيون (مبنى يتم فيه بيع الأفيون واستخدامه)",
 "opium poppy": "خَشْخَاش الْأَفْيُون",
 "opium taker": "مدمن أفيون (شخص مدمن على الأفيون)",
 "opopanax": "جَاوَشِير",
 "opossum": "أُوبُسُوم",
 "opossum rat": "جرذ الأبوسوم (جرابيات أرضية من جنوب أمريكا الجنوبية تشبه الزباب)",
 "opossum shrimp": "روبيان الأبوسوم (قشريات تشبه الروبيان تحمل إناثها البيض والصغار في كيس بين الأرجل)",
 "opossum wood": "شجرة الجرس الفضي, شجرة قطرة الثلج (شجرة متوسطة الحجم من فرجينيا الغربية إلى فلوريدا وتكساس)",
 "oppa": "أوبا (ذكر أكبر سناً من المتحدث، يستخدم خاصة من قبل الإناث الكوريات)",
 "oppenheimer": "أوبنهايمر",
 "opponent": "خَصْم (الخَصْمُ :مُجَادِل، مُنَازِع، مُخَاصِم، عكسه حَلِيف أو صَدِيْق، وقد يستوي فيه المفرد والمثنى والجمع؛ والخَصْمُ (في ) : حَطِيطَة)",
 "opportune": "ملائم, مناسب (مناسب أو في وقت مناسب أو مفيد خاصة لغرض معين)\nمثال: مكان مناسب للتخييم",
 "opportunely": "بشكل ملائم, في الوقت المناسب (بشكل مناسب ومريح)\nمثال: وصل في الوقت المناسب تماماً عندما كنا بحاجة إلى خادم جديد",
 "opportuneness": "تَوْقِيت مُنَاسِب, مُوَاتَاة (الملاءمة الزمنية)",
 "opportunism": "انتهازية (استغلال الفرص دون النظر للعواقب على الآخرين)",
 "opportunist": "انْتِهَازِيّ, وُصُولِيّ (ينتهز الفرصة فوراً وبشكل غير أخلاقي في كثير من الأحيان) / انتهازي, وصولي (شخص يفضل المصلحة الشخصية والوسائل النفعية على المبادئ)",
 "opportunistic": "انْتِهَازِيّ, وُصُولِيّ (ينتهز الفرصة فوراً وبشكل غير أخلاقي في كثير من الأحيان)",
 "opportunistic infection": "عدوى انتهازية (أي عدوى تسببها كائنات دقيقة لا تسبب مرضاً عادةً لدى البشر؛ تحدث لدى الأشخاص الذين يعانون من ضعف في جهاز المناعة (مثل مرضى الإيدز))",
 "opportunity": "فُرْصَة",
 "opportunity cost": "تكلفة الفرصة البديلة (التكلفة من حيث التخلي عن البدائل)",
 "opposable": "قابل للمقابلة (قادر على أن يوضع في مقابلة شيء آخر (مثل الإبهام))\nمثال: الإبهام قابل للمقابلة مع السبابة",
 "oppose": "عَارَض (فلانٌ: أخذ في ناحية من الطريق؛ فلانا: باراه وأتى بمثل ما أتى به) / اِعْتَرَضَ (سار عارضا بدون هدف وتخطيط كما تكون الخشبة الطافية في الماء؛ الشيءَ أو الشخصَ: حَالَ بينه وبين ما يريد، أو وقف في طريقه)\nمثال: جميع من حضر عارض تلك الخطة.",
 "opposed": "مضاد, معارض (في حالة معارضة أو لديه خصم)\nمثال: مدرستان فكريتان متعارضتان بمرارة",
 "opposer": "خَصْم, غريم (شخص يبدي المعارضة)",
 "opposing": "مُعَارِض, مُنَاوِئ (يتَّسم بعداء فعليّ ونشط)",
 "opposite": "ضِدّ / آخَر (ضد الأوَّل؛ وهو من يكون ترتيبه بعد الجميع؛ الشيء: مؤخرّه، الجزء الآخير منه) / عَلَى العَكْس (يفيد الاستعلاء؛ يفيد التعليل) / فِي مُوَاجَهَة, أَمَام (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة) / أَمَام\nمثال: أرني مثالا آخر.",
 "opposite number": "نَظِير, نَظِيرَة",
 "opposite sex": "الْجِنْس الْآخَر",
 "opposite word": "ضد, كلمة مضادة (كلمة تعبر عن معنى معاكس لمعنى كلمة أخرى)\nمثال: بالنسبة له، كان عكس كلمة 'سعيد' هو 'مكتئب'",
 "oppositely": "بشكل معاكس, في المقابل (في وضع معاكس)",
 "oppositeness": "تَضَادّ, تَعَارُض (العلاقة بين الكيانات المتعارضة)",
 "opposition": "مقابلة / مُعَارَضَة, مُقَاوَمَة (الرفض وعدم القبول؛ أخذ الطريق بالعرض) / تَنَاقُضْ\nمثال: أغلبية اللجنة كانت معارضة للخطة.",
 "oppositionality": "مُعَارَضَة (صفة المعارضة أو التواجد في صراع)",
 "oppositive": "اسْتِدْرَاكِيّ, مُقَابِل (يُعَبِّرُ عَنِ التَّضَادِّ أَوِ المُعَارَضَةِ)",
 "oppress": "اِسْتَضْعَفَ, قَهَرَ",
 "oppressed": "مَظْلُوم",
 "oppression": "ظُلْم (الثَلَاثُ الظُلَم: الليلة التاسعة عشر، والعشرون، والحادية والعشرون من كل شهر قمري، وسميت بذلك لظلمتها. يسبقها الثلاث الدُرَع ويليها الثلاث الحنادس)\nمثال: نحن نرفض الظلم.",
 "oppressive": "طُغْيَانِيّ, قَمْعِيّ (يَتَّسِم بِقَسْوَة ظَالِمَة أَوْ سُلُوك تَعَسُّفِيّ) / خانِق, كابِت (يُثْقِل كاهِل النَّفْس والحَواسّ بِشِدَّة)",
 "oppressively": "باضطهاد, بشكل خانق (بطريقة ثقيلة ومضطهدة)\nمثال: كان الجو حاراً بشكل خانق في المكتب",
 "oppressiveness": "ثقل, وطأة (صعوبة ثقيلة غير مرغوب فيها) / انقباض, ضيق صدر (شعور بالاضطهاد أو الضيق)",
 "oppressor": "ظَالِم",
 "opprobrious": "فَاضِح, مُخْزٍ ((للسلوك أو الشخصيَّة) يستحقّ العار أو يجلبه) / بَذِيء, سَبَّاب (يعبّر عن توبيخ مسيء ومُهين)",
 "opprobrium": "خزي, عار (حالة من عدم الشرف الشديد) / تشهير, خزي (حالة من العار ناتجة عن الإساءة العامة)\nمثال: تاريخ سيعيش في الخزي",
 "opsanus tau": "سمكة العلجوم (سمكة تعيش في القاع ذات جلد لزج عديم القشور ورأس عريض سميك وفم واسع)",
 "opsin": "أوبسين (بروتين شبكي يتكون بفعل الضوء على الرودوبسين)",
 "opsonin": "أوبسونين (جسم مضاد في مصل الدم يرتبط بالكائنات الحية الدقيقة الغازية والمستضدات الأخرى لجعلها أكثر عرضة لعمل الخلايا البلعمية)",
 "opsonisation": "تهيئة للبلعمة, طهاية (العملية التي تجعل بها الطاهيات (الأوبسونينات) الكائنات الحية الدقيقة الغازية أكثر عرضة للبلعمة)",
 "opsonization": "تهيئة للبلعمة, طهاية (العملية التي تجعل بها الطاهيات (الأوبسونينات) الكائنات الحية الدقيقة الغازية أكثر عرضة للبلعمة)",
 "optative": "تمني, تمنّي (متعلق بصيغة للأفعال في بعض اللغات تدل على التمني) / تمني (يشير إلى خيار أو أمنية) / صِيغَة التَّمَنِّي (صيغة تعبر عن رغبة أو أمل)\nمثال: نهايات الفعل الدالة على التمني",
 "optative mood": "صِيغَة التَّمَنِّي (صيغة تعبر عن رغبة أو أمل)",
 "optez": "أوبتيز (لغة مصطنعة تم إنشاؤها لغرض محدد)",
 "optic": "بصري, مرئي (متعلق بالبصر أو يستخدمه) / رمدي, عيني (متعلق بالعين أو يشبهها) / عين (عضو الإبصار)\nمثال: فحص بصري",
 "optic axis": "محور بصري, محور رئيسي (خط يمر عبر مركز انحناء العدسة بحيث لا ينعكس الضوء ولا ينكسر) / محور بصري (في البلورة مزدوجة الانكسار، الخط الذي لا يحدث في اتجاهه انكسار مزدوج)\nمثال: في العين الطبيعية، المحور البصري هو الاتجاه الذي تُرى فيه الأشياء بوضوح أكبر",
 "optic chiasm": "تَصَالُب بَصَري (تقاطع العصبين البصريين القادمين من العينين عند قاعدة الدماغ)",
 "optic chiasma": "تَصَالُب بَصَري (تقاطع العصبين البصريين القادمين من العينين عند قاعدة الدماغ)",
 "optic cup": "كأس بصرية ((علم الأجنة) انخفاض يشبه الكوب بجدارين يتطور إلى الطبقات الصباغية والحسية للشبكية)",
 "optic disc": "قرص بصري, نقطة عمياء (النقطة التي يدخل منها العصب البصري إلى الشبكية؛ وهي غير حساسة للضوء)",
 "optic disk": "قرص بصري, نقطة عمياء (النقطة التي يدخل منها العصب البصري إلى الشبكية؛ وهي غير حساسة للضوء)",
 "optic nerve": "عصب بصري, عصب قحفي ثاني (العصب القحفي الذي يخدم الشبكية)",
 "optic radiation": "تشعع بصري (مسار عصبي من الجسم الركبي الجانبي إلى القشرة البصرية)",
 "optic tract": "عصب بصري, عصب قحفي ثاني (العصب القحفي الذي يخدم الشبكية)",
 "optical": "بصري (متعلق بالضوء أو البصريات أو ينطوي عليهما) / بصري, مرئي (متعلق بالبصر أو يستخدمه) / رمدي, عيني (متعلق بالعين أو يشبهها)\nمثال: مستلزمات بصرية",
 "optical aberration": "تشوه, زيغ (ظاهرة بصرية ناتجة عن فشل عدسة أو مرآة في إنتاج صورة جيدة)",
 "optical bench": "منضدة بصرية (جهاز لمراقبة وقياس الظواهر البصرية)",
 "optical condenser": "مكثف ضوئي (عدسة تستخدم لتركيز الضوء على جسم ما)",
 "optical crown": "زجاج التاج البصري, زجاج كراون بصري (زجاج بصري ذو تشتت منخفض ومعامل انكسار منخفض)",
 "optical crown glass": "زجاج التاج البصري, زجاج كراون بصري (زجاج بصري ذو تشتت منخفض ومعامل انكسار منخفض)",
 "optical density": "امتصاصية, كثافة ضوئية ((فيزياء) مقياس لمدى نقل المادة للضوء أو الإشعاع الكهرومغناطيسي الآخر)",
 "optical device": "جهاز بصري (جهاز لإنتاج الضوء أو التحكم فيه)",
 "optical disc": "قرص ضوئي (قرص مطلي بالبلاستيك يمكنه تخزين البيانات الرقمية كحفر صغيرة محفورة في السطح؛ يقرأ بواسطة ليزر يمسح السطح)",
 "optical disk": "قرص ضوئي (قرص مطلي بالبلاستيك يمكنه تخزين البيانات الرقمية كحفر صغيرة محفورة في السطح؛ يقرأ بواسطة ليزر يمسح السطح)",
 "optical fiber": "ألياف بصرية, ألياف زجاجية (ألياف رقيقة جداً مصنوعة من الزجاج تعمل كدليل موجي للضوء؛ تستخدم في حزم لنقل الصور)",
 "optical fibre": "ألياف بصرية, ألياف زجاجية (ألياف رقيقة جداً مصنوعة من الزجاج تعمل كدليل موجي للضوء؛ تستخدم في حزم لنقل الصور)",
 "optical flint": "زجاج الصوان البصري, زجاج فلنت بصري (زجاج بصري ذو تشتت عالٍ ومعامل انكسار عالٍ)",
 "optical fusion": "دمج بصري (الجمع بين الصور من العينين لتشكيل مدرك بصري واحد)",
 "optical glass": "زجاج بصري (زجاج متجانس نقي ذو معامل انكسار معروف؛ يستخدم لصنع العدسات)",
 "optical illusion": "خداع بصري",
 "optical instrument": "أداة بصرية (أداة مصممة للمساعدة في الرؤية)",
 "optical isomer": "متصاوغ ضوئي (أحد متصاوغين فراغيين يمثلان صوراً مرآتية لبعضهما البعض وغير متطابقين)",
 "optical lens": "عدسة الكاميرا (عدسة تركز الصورة في الكاميرا)",
 "optical maser": "ليزر (جهاز بصري ينتج شعاعاً مكثفاً أحادي اللون من الضوء المترابط)",
 "optical opacity": "عتامة بصرية (عتامة للضوء)",
 "optical phenomenon": "ظاهرة بصرية (ظاهرة فيزيائية تتعلق أو تنطوي على الضوء)",
 "optical prism": "منشور بصري, موشور (جهاز بصري له شكل مثلث ومصنوع من الزجاج أو الكوارتز؛ يستخدم لحرف شعاع أو قلب صورة)",
 "optical pyrometer": "بيرومتر ضوئي, مقياس حرارة بصري (بيرومتر يستخدم لون الضوء المنبعث من جسم ساخن)",
 "optical scanner": "ماسح ضوئي (جهاز طرفي للحاسوب يتيح مسح المواد المطبوعة، بما في ذلك الأحرف والرسوم البيانية، وتحويلها إلى شكل يمكن تخزينه في الحاسوب)",
 "optical telegraph": "تلغراف بصري (أي تلغراف يستخدم إشارات بصرية لنقل رسالة، بما في ذلك إشارات الدخان أو المنارات أو الضوء المنعكس)",
 "optical telescope": "تلسكوب بصري (تلسكوب فلكي مصمم لجمع وتسجيل الضوء من المصادر الكونية)",
 "optically": "بصرياً, ضوئياً (بطريقة بصرية أو تتعلق بالبصريات)\nمثال: مشوه بصرياً",
 "optician": "صانع عدسات, فني بصريات (عامل يصنع النظارات لعلاج عيوب الإبصار)",
 "optics": "بَصَرِيَّات (علم البصريات: هو العلم الذي يبحث في سُلُوك الطَيْف البصري المرئي والظَوَاهِر المتعلقة به)",
 "optimal": "أَمْثَل, مِثَالِيّ (الأكثر استحساناً ضمن قيد معين صريح أو ضمني)",
 "optimally": "بشكل أمثل (بأفضل طريقة ممكنة وأكثرها رغبة)",
 "optimisation": "أمثلية, تحسين (فعل جعل الشيء مثالياً)\nمثال: التحسين المتزامن للنمو والربحية",
 "optimism": "تَفَاؤُل",
 "optimist": "مُتَفَائِل",
 "optimistic": "مُتَفَائِل",
 "optimistically": "بتفاؤل (مع التفاؤل؛ بطريقة متفائلة)\nمثال: هتف بتفاؤل: لدينا فرصة جيدة للفوز",
 "optimization": "اِسْتِمْثَال, مُلَاءَمَة",
 "optimum": "أَمْثَل, مِثَالِيّ (الأكثر استحساناً ضمن قيد معين صريح أو ضمني) / أَفْضَل حَال, أَمْثَل (الظروف الأكثر ملاءمة أو أقصى درجة أو كمية ممكنة في ظل ظروف معينة)",
 "optional": "اِخْتِيَارِيّ",
 "optionality": "اختيارية (الجودة أو الحالة التي يُسمح فيها بالاختيار أو التصرف)\nمثال: تستلزم الاختيارية المعتادة لهذه المهام خطر عدم قيام الطلاب بإنجازها بطريقة فعالة",
 "optionally": "اختيارياً (بطريقة اختيارية)\nمثال: تطبق هذه القاعدة اختيارياً",
