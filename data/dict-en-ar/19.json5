 "octans": "الثُّمْن, الثُّمُن",
 "octant": "ثُمْن, ثُمُن (ثمَّنَ السِّلْعَةَ: قدّر ثَمنَها؛ ثمَّنَ الشيءَ: جعل له ثمانية أركان)\nمثال: دفع زيري الثمن.",
 "octatonic scale": "سلم ثماني (سلم مكون من ثماني نغمات يتكون من أشباه نغمات ونغمات كاملة بالتناوب)",
 "octave": "مقطع ثماني (مجموعة إيقاعية من ثمانية أبيات شعرية) / أوكتاف, جواب (فاصل موسيقي مكون من ثماني نغمات) / أوكتاف (يوم العيد والأيام السبعة التي تليه)",
 "octavo": "قطع ثُماني (حجم كتاب تُصنع صفحاته بطي ورقة ثلاث مرات لتكوين ثماني ورقات)",
 "octet": "أوكتيت, ثماني (تأليف موسيقي لثمانية مؤديين) / ثماني, مجموعة ثمانية (ثمانية أشخاص يُنظر إليهم كوحدة واحدة) / ثماني (مجموعة من ثمانية أشياء متشابهة تُعتبر كوحدة واحدة) / ثماني (ثمانية مؤدين أو مغنين يؤدون معاً)",
 "octette": "أوكتيت, ثماني (تأليف موسيقي لثمانية مؤديين) / ثماني, مجموعة ثمانية (ثمانية أشخاص يُنظر إليهم كوحدة واحدة) / ثماني (مجموعة من ثمانية أشياء متشابهة تُعتبر كوحدة واحدة) / ثماني (ثمانية مؤدين أو مغنين يؤدون معاً)",
 "octillion": "أُوكْتِيلْيُون (العدد الذي يمثله واحد متبوعاً بـ 27 صفراً)",
 "october": "أَكْتُوبَر, تِشْرِين الْأَوَّل (الشهر العاشر في السنة الميلادية الروميّة)\nمثال: أراك في شهر أكتوبر.",
 "october 12": "12 أكتوبر, يوم كولومبوس (عطلة قانونية لإحياء ذكرى اكتشاف أمريكا بواسطة كريستوفر كولومبوس)",
 "october 24": "24 أكتوبر, يوم الأمم المتحدة (يوم للاحتفال بتأسيس الأمم المتحدة)",
 "octoberfest": "بيرة أكتوبرفست (بيرة لاغر قوية صنعت أصلاً في ألمانيا لاحتفال أكتوبرفست؛ حلوة وذات لون نحاسي)",
 "octogenarian": "ثَمَانِينِيّ (يتراوح عمره بين الثمانين والتاسعة والثمانين) / ثمانيني (شخص عمره في الثمانينات)",
 "octonary": "ثَمَانِيَة, ثُمَانِيّ (العدد الأصلي الذي هو مجموع سبعة وواحد)",
 "octopod": "أخطبوطيات (رأسيات الأرجل بثمانية أذرع ولكن تفتقر إلى صدفة داخلية)",
 "octopus": "أُخْطُبُوط, أَخْطَبُوط (الأُخْطُبُوْط حَيَوَانٌ بَحْرِيٌّ مِنْ فَصِيلَةِ الرِّخْوِيَّاتِ، لَهُ ثَمَانِي أرجُلِ فِي رَأْسِهِ، فِيهَا مَحَاكِم يَلْتَصِقُ بِهَا…؛ الأُخْطُبوط : حيوان بَحْريّ من الرِّخْويَّات له ثماني أرجلٍ رأْسية، يضرب به المثل في شُدة التشبُّث بما يمسكه)",
 "octoroon": "ثمن خلاس (نسل لشخص ربع خلاس وشخص أبيض؛ شخص ثمنه أسود)",
 "octosyllabic": "ثُمَانِيُّ المَقَاطِع (يتألّف من ثمانية مقاطع صوتيّة أو يتّسم بها)",
 "octosyllable": "ثماني المقاطع (بيت شعر يحتوي على ثمانية مقاطع أو قصيدة من أبيات ثمانية المقاطع)",
 "octroi": "ضريبة الدخول, مكوس المدينة (ضريبة على البضائع المختلفة التي يتم إدخالها إلى مدينة ما)",
 "octuple": "ثُمَانِيّ (ذو ثماني وحدات أو مكوّنات)",
 "ocular": "عَيْنِيّ",
 "ocular helmet": "خوذة العيون, خوذة بصرية (خوذة جلدية أو فولاذية تشبه خوذة الأنف ولكن مع شريط أمامي يشكل فتحات للعينين، شاعت في الدول الاسكندنافية في العصور الوسطى)",
 "ocular muscle": "عضلة العين (واحدة من العضلات الصغيرة للعين التي تعمل على تدوير مقلة العين)",
 "oculism": "صناعة النظارات, طب العيون (حرفة أخصائي العيون)",
 "oculist": "أخصائي عيون, طبيب عيون (طبيب متخصص في تشخيص وعلاج أمراض العين) / أخصائي بصريات, فاحص نظر (شخص ماهر في اختبار عيوب الإبصار لوصف النظارات التصحيحية)",
 "oculomotor": "عصب قحفي ثالث, عصب محرك للعين (يغذي العضلات الخارجية للعين)",
 "oculomotor nerve": "عصب قحفي ثالث, عصب محرك للعين (يغذي العضلات الخارجية للعين)",
 "oculopharyngeal muscular dystrophy": "حثل عضلي عيني بلعومي (شكل من أشكال الحثل العضلي يبدأ عادة بين سن البلوغ المبكر ومنتصف العمر ويؤثر أولاً على عضلات الجفن والحلق؛ يتقدم ببطء مع مشاكل شائعة في البلع مع تقدم…)",
 "oculus": "عين (عضو الإبصار)",
 "oculus dexter": "عين يمنى (العين اليمنى)",
 "oculus sinister": "عين يسرى (العين اليسرى)",
 "ocyurus chrysurus": "نهاش أصفر الذيل (سمكة طعام ممتازة من المحيط الأطلسي الاستوائي والبحر الكاريبي ذات شريط أصفر عريض على الجانبين وعلى الذيل)",
 "od": "عين يمنى (العين اليمنى) / دكتوراه في البصريات (درجة الدكتوراه في البصريات)",
 "odalisque": "جَارِيَّة (مؤنث جَارِي؛ السفينة لأنها تجري في البحر)\nمثال: التحضيرات جارية على قدم وساق.",
 "odd": "فَرْدِيّ",
 "odd fellow": "غَرِيب الْأَطْوَار (شخص يعتبر غريب الأطوار أو مجنوناً ويبرز عن المجموعة)",
 "odd fish": "غَرِيب الْأَطْوَار (شخص يعتبر غريب الأطوار أو مجنوناً ويبرز عن المجموعة)",
 "odd man out": "غَرِيب الْأَطْوَار (شخص يعتبر غريب الأطوار أو مجنوناً ويبرز عن المجموعة)",
 "odd number": "عَدَد فَرْدِيّ (مِقْدَار مَا يُعَدّ)\nمثال: كم عدد سكان الجزائر؟",
 "odd-even check": "فحص التكافؤ (نظام للتحقق من الأخطاء في عمل الكمبيوتر)",
 "odd-job man": "بارع في كل الصنعات, عامل صيانة (رجل ماهر في وظائف متنوعة ومهام صغيرة أخرى)",
 "odd-job woman": "عاملة مهام متفرقة, عاملة يدوية (امرأة ماهرة في مختلف الوظائف الفردية والمهام الصغيرة الأخرى)",
