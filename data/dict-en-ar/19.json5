 "nuisance value": "إرباك, حرج (صفة الموقف المحرج)\nمثال: استشعر الحرج في اقتراحه",
 "nuke": "رأس حربي ذري, رأس نووي (الرأس الحربي لصاروخ مصمم لإيصال قنبلة ذرية)",
 "nuku'alofa": "نُوكُو أَلُوفَا",
 "null": "بَاطِل, لَاغٍ (يَفْتَقِرُ إِلَى أَيِّ قُوَّةٍ قَانُونِيَّةٍ أَوْ إِلْزَامِيَّة) / صفر, عدم (كمية لا أهمية لها؛ شيء ليس له وجود)\nمثال: بدا وكأنه لا شيء رأيته من قبل",
 "null and void": "لَاغٍ وَبَاطِل",
 "null set": "مجموعة خالية, مجموعة فارغة (مجموعة فارغة؛ مجموعة ليس لها أعضاء)",
 "null space": "فضاء صفري, فضاء فارغ (فضاء لا يحتوي على نقاط؛ وفضاء فارغ)",
 "nullah": "قناة, مجرى (وادٍ ضيق أو أخدود في جنوب آسيا)",
 "nullification": "إبطال, إلغاء المفعول (فعل الإبطال؛ جعل الشيء لاغياً وباطلاً؛ أو تجاوز تأثير أو قوة شيء ما) / إبطال (مذهب حقوق الولايات القائل بأن الولاية يمكنها رفض الاعتراف بقانون فيدرالي صادر عن الكونغرس الأمريكي أو رفض تنفيذه)",
 "nullified": "مُبْطَل, مُلْغًى (جُرِّدَ مِنَ القُوَّةِ القَانُونِيَّة)",
 "nullifier": "لاغٍ, مبطل (مسؤول يمكنه إبطال أو إلغاء شيء ما) / مبطل القوانين (مدافع عن الإبطال؛ شخص يعتقد أن الولاية يمكنها مقاومة القوانين الفيدرالية)",
 "nullipara": "امرأة لم تنجب ((طب التوليد) امرأة لم تلد طفلاً قط)",
 "nullity": "بطلان, حكم بالبطلان (شيء باطل (خاصة تشريع ليس له شرعية قانونية)) / عدم, لاشيء (حالة عدم الوجود)",
 "numb": "خَدِر (استتر؛ خدر بالمكان: أقام) / خَدَّرَ (استتر؛ خدر بالمكان: أقام) / خَفَّفَ (قلل شيئًا أو نقص من حدته؛ هون أو لطف من شدة أمر)\nمثال: خفف زيري السرعة.",
 "numbat": "آكل النمل المخطط, نمبات (جرابي أسترالي صغير ذو خطم طويل ومخالب قوية للتغذى على النمل الأبيض؛ مهدد بالانقراض)",
 "number": "عَدَد, نمرة (مِقْدَار مَا يُعَدّ) / عَدَد, رَقْم (مِقْدَار مَا يُعَدّ) / عَدَد (مِقْدَار مَا يُعَدّ) / رَقْم (وضع أرقامًا على شيء ما للتنظيم أو التمييز) / رَقَّمَ (وضع أرقامًا على شيء ما للتنظيم أو التمييز)\nمثال: كم عدد سكان الجزائر؟",
 "number 1": "الأول, رقم واحد (العنصر الأول في سلسلة قابلة للعد)\nمثال: الأول من الشهر",
 "number agreement": "مُطَابَقَة العَدَد (المطابقة في العدد بين الكلمات في نفس التركيب النحوي (مثل بين الصفات والأسماء التي تصفها))",
 "number cruncher": "حاسوب فائق السرعة, طاحنة الأرقام (حاسوب قادر على إجراء عدد كبير من العمليات الرياضية في الثانية) / خبير أرقام, محلل كمي (شخص قادر على إجراء حسابات معقدة وطويلة)",
 "number crunching": "معالجة أرقام (إجراء عمليات حسابية رقمية معقدة وطويلة)",
 "number of the beast": "عَدَد الْوَحْش (مِقْدَار مَا يُعَدّ)\nمثال: كم عدد سكان الجزائر؟",
 "number one": "الذات, النفس (إشارة إلى النفس أو الذات؛ عبارة 'الاهتمام برقم واحد' تعني وضع مصالح المرء الشخصية أولاً) / الأول, رقم واحد (العنصر الأول في سلسلة قابلة للعد) / الأول, رقم واحد (الأول أو الأعلى في ترتيب أو سلسلة)\nمثال: الأول من الشهر",
 "number one wood": "السائق, خشب واحد (مضرب غولف (خشبي) بوجه عمودي تقريباً يستخدم لضرب التسديدات الطويلة من نقطة الانطلاق)",
 "number representation system": "نظام أعداد, نظام عد (أي تدوين لتمثيل الأعداد)",
 "number system": "نظام أعداد, نظام عد (أي تدوين لتمثيل الأعداد)",
