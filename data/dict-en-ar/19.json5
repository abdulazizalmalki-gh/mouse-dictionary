 "opulently": "بترف, بفخامة (بطريقة باذخة ومترفة)\nمثال: هذا المبنى الحكومي مجهز بفخامة",
 "opuntia cholla": "تشولا (صباريات شجرية ذات قطع ساق أسطوانية شائكة جداً؛ جنوب غرب الولايات المتحدة والمكسيك)",
 "opuntia lindheimeri": "صبير, نوبال (صبار له زهور صفراء وثمار أرجوانية)",
 "opuntia tuna": "تونا, تين شوكي (تين شوكي أمريكي استوائي من جامايكا)",
 "opus": "تأليف موسيقي, عمل موسيقي (عمل موسيقي تم إبداعه)\nمثال: التأليف مكتوب في أربع حركات",
 "opv": "لقاح سابين, لقاح شلل الأطفال الفموي (لقاح فموي (يحتوي على فيروس شلل أطفال حي ولكن ضعيف) يعطى لتوفير المناعة ضد شلل الأطفال)",
 "or": "أَو, أَم (يفيد الشك؛ يفيد التقسيم)\nمثال: أكون أو لا أكون؟",
 "or circuit": "بوابة أو (دائرة بوابة في الكمبيوتر تعمل عندما يعمل أي من مدخلاتها)",
 "or else": "بِطَرِيقَة أُخْرَى, وَإِلَّا",
 "or gate": "بوابة أو (دائرة بوابة في الكمبيوتر تعمل عندما يعمل أي من مدخلاتها)",
 "or so": "تقريباً, حوالي ((للكميات) غير دقيق ولكنه قريب جداً من الصواب)\nمثال: استمر حوالي ساعة",
 "or words to that effect": "أَوْ كَمَا قَالَ (يفيد الشك؛ يفيد التقسيم)\nمثال: أكون أو لا أكون؟",
 "orach": "رغل, سرمق ((رغَلَ) أُمُّهُ رَغْلاً، ورَغْلَةً: اختلس منها رَضعَةً)",
 "orache": "رغل, سرمق ((رغَلَ) أُمُّهُ رَغْلاً، ورَغْلَةً: اختلس منها رَضعَةً)",
 "oracle": "كَاهِن, عَرَّاف / إِلْهَام",
 "oracular": "غَامِض, لُغْزِيّ (يشبه الألغاز في غموض الفكر والمعنى) / غَامِض النُّبُوءَة, كَهَانِيّ (نبوئيّ بشكل غامض ومبهم) / عرافي, وحيي (من أو يتعلق بالعراف أو الوحي)\nمثال: قادر عن طريق وسائل عرافية على كشف الساحرة",
 "orad": "نحو الفم (باتجاه الفم أو المنطقة الفموية)",
 "oradexon": "ديكادرون, ديكساميثازون (دواء كورتيكوستيرويد (الأسماء التجارية ديكادرون وغيرها) يستخدم لعلاج الحساسية أو الالتهاب)",
 "oral": "فَمَوِيّ / شَفَهِيّ / شَفَوِيّ / مَنْطُوق",
 "oral cancer": "سرطان الفم (ورم خبيث في الشفاه أو الفم؛ أكثر شيوعًا لدى الرجال فوق سن الستين)",
 "oral candidiasis": "داء المبيضات الفموي",
 "oral cavity": "تجويف فموي, فم (الفتحة التي يتم من خلالها تناول الطعام وخروج الأصوات)\nمثال: حشا فمه بالحلوى",
 "oral communication": "حديث, كلام ((لغة) التواصل عن طريق الكلام الشفهي)\nمثال: كان كلامه مشوشاً",
 "oral consonant": "صامت فموي (صوت صامت في الكلام يصدر عن طريق السماح للهواء بالخروج من الفم، على عكس الأنف)",
 "oral contraception": "موانع الحمل الفموية (منع الحمل الذي يتحقق عن طريق تناول حبوب منع الحمل)",
 "oral contraceptive": "حبوب منع الحمل (مانع حمل على شكل حبة تحتوي على الإستروجين والبروجستين لمنع الإباضة وبالتالي منع الحمل)",
 "oral contraceptive pill": "حبوب منع الحمل (مانع حمل على شكل حبة تحتوي على الإستروجين والبروجستين لمنع الإباضة وبالتالي منع الحمل)",
 "oral contract": "عقد شفهي (اتفاق غير مكتوب وغير موقع من قبل الأطراف ولكنه عقد حقيقي قائم يفتقر فقط إلى المطلب الرسمي لمذكرة لجعله قابلاً للتنفيذ في التقاضي)",
 "oral exam": "امتحان شفهي (امتحان يجرى عن طريق التواصل المنطوق)",
 "oral examination": "امتحان شفهي (امتحان يجرى عن طريق التواصل المنطوق)",
 "oral fissure": "تجويف فموي, فم (الفتحة التي يتم من خلالها تناول الطعام وخروج الأصوات)\nمثال: حشا فمه بالحلوى",
 "oral herpes": "قرحة البرد, هربس فموي",
 "oral hygiene": "صِحَّة الفَمّ (سَلَامَة؛ سَلَامَة الْجِسْم)\nمثال: أشك في صحة ذلك.",
 "oral personality": "شخصية فموية ((التحليل النفسي) شخصية تتميز إما بالتفاؤل السخي أو الأنانية العدوانية والطموحة؛ تتشكل في الطفولة المبكرة عن طريق التثبيت خلال المرحلة الفموية من…)",
 "oral phase": "المرحلة الفموية ((التحليل النفسي) المرحلة الجنسية والاجتماعية الأولى لنمو الرضيع؛ الفم هو بؤرة الليبيدو ويأتي الرضا من الرضاعة والمضغ والعض)",
 "oral poliovirus vaccine": "لقاح سابين, لقاح شلل الأطفال الفموي (لقاح فموي (يحتوي على فيروس شلل أطفال حي ولكن ضعيف) يعطى لتوفير المناعة ضد شلل الأطفال)",
 "oral presentation": "إلقاء, تحدث علني (إلقاء خطاب لجمهور عام)\nمثال: جاء الناس لرؤية المرشحين وسماع الخطب",
 "oral sex": "جِنْس فَمَوِيّ (الجَمَاعَة أو المَجْمُوعَة الواحدة التي لها صفات تجعلها تنتمي إلى بعض تسمى جِنْسا وهو أعمُّ من النَوْع. ليس للجنس أو النوع ما يحددهما فالبشر كلهم جنس…؛ أحيانا يقصد به ذكر أم أنثى تحديدا)\nمثال: أنا مثلي الجنس.",
 "oral smear": "مَسْحَةُ الفَم (مسحة القناة الهضمية من مادة تم الحصول عليها من الفم)",
 "oral stage": "المرحلة الفموية ((التحليل النفسي) المرحلة الجنسية والاجتماعية الأولى لنمو الرضيع؛ الفم هو بؤرة الليبيدو ويأتي الرضا من الرضاعة والمضغ والعض)",
 "oral vowel": "صائت فموي ((لغويات) صائت عادي يتم إنتاجه دون غنة)",
 "orally": "فَمَوِيًّا / شِفَاهِيًا, شِفَاهًا",
 "oran": "وَهْرَان",
 "orang": "أورانغوتان, إنسان الغاب (قرد كبير طويل الذراعين يعيش في بورنيو وسومطرة وله عادات شجرية)",
 "orange": "شَجَرَةْ اَلْبُرْتُقَال (نبات قائم على سَاق صلبة؛ مخطط له تفرعات) / بُرْتُقَالَة / نَارَنْج / ٌبُرْتُقَال (شجر صغير مثمر من جنس الموالح، من فصيلة الحمضيات، أزهاره بيض عطرة الرائحة، وثمره حامض سكري حلو الطعم) / بُرْتُقَالَةٌ / برتقان (شكل آخر لـ\"بُرْتُقَال\") / بُرْتُقَالِيّ (لون بين الأحمر والأصفر في الطيف المرئي عند طول موجة بين 585 – 620 نانومتر. ويعتبر البرتقالي من الألوان الحارة؛ ما ينسب إلى فاكهة البرتقال)\nمثال: أنا تحت الشجرة.",
 "orange balsam": "بلسم البرتقال, قرط السيدة (نبات حولي في أمريكا الشمالية بأزهار صفراء أو برتقالية عادة؛ ينمو بشكل رئيسي في التربة الرطبة والحمضية نوعاً ما)",
 "orange bat": "خفاش برتقالي, خفاش حدوة الحصان البرتقالي (خفاش شائع في شمال غرب أستراليا ذو فرو برتقالي أو أصفر)",
 "orange blossom": "زَهْرَة الْبُرْتُقَال",
 "orange daisy": "أقحوان برتقالي, يرغوث برتقالي (عشبة تشكل حصيرة من تركستان ذات أزهار برتقالية صفراء مزدوجة تقريباً)",
 "orange fleabane": "أقحوان برتقالي, يرغوث برتقالي (عشبة تشكل حصيرة من تركستان ذات أزهار برتقالية صفراء مزدوجة تقريباً)",
 "orange grass": "عشبة البرتقال, عشبة الصنوبر (عشبة حولية سلكية الساق من أمريكا الشمالية ذات أوراق دقيقة تشبه الحراشف وزهور صفراء صغيرة)",
 "orange grove": "بستان برتقال, بيارة برتقال (بستان من أشجار البرتقال)",
 "orange hawkweed": "حشيشة الغراب البرتقالية (حشيشة غراب أوروبية لها رؤوس زهرية بأشعة حمراء برتقالية زاهية؛ عشب ضار مزعج خاصة في شمال شرق أمريكا الشمالية؛ توضع أحياناً في جنس هيراسيوم)",
 "orange horseshoe bat": "خفاش برتقالي, خفاش حدوة الحصان البرتقالي (خفاش شائع في شمال غرب أستراليا ذو فرو برتقالي أو أصفر)",
 "orange juice": "عَصِير بُرْتُقَال (سائلٌ سُكَّريٌّ يُستخرج من بعض الثّمار عند عَصْرها)\nمثال: هل تريد عصير فاكهة؟",
 "orange liqueur": "ليكير البرتقال (ليكير منكه بالبرتقال)",
 "orange marmalade": "مربى البرتقال (مارملاد مصنوع من البرتقال)",
 "orange milkweed": "صقلاب درني, عشبة الفراشة (نبات معمر منتصب من شرق وجنوب الولايات المتحدة له زهور برتقالية بارزة)",
 "orange milkwort": "مستدرة برتقالية, مستدرة صفراء (نبات مستنقعات في غابات الصنوبر بجنوب شرق الولايات المتحدة له سنابل من الزهور الصفراء البرتقالية غير المنتظمة)",
 "orange mushroom pimple": "بثرة الفطر البرتقالية",
 "orange order": "جماعة الأورانج, نظام أورانج (منظمة سياسية بروتستانتية في أيرلندا الشمالية)",
 "orange peel": "قشر البرتقال (شرائح من قشر البرتقال مطبوخة في السكر ومغلفة بالسكر) / قشرة برتقال (قشرة البرتقال)",
 "orange peel fungus": "فطر قشر البرتقال (فطر قرصي بأجسام ثمرية برتقالية زاهية على شكل كأس أو صحن وخارج برتقالي شاحب)",
 "orange pekoe": "بيكو, بيكو برتقالي (درجة ممتازة من الشاي الأسود؛ يزرع في الهند وسريلانكا وجاوة)",
 "orange red": "أحمر زاهٍ, قرمزي فاتح (لون متغير يكون أحمر زاهياً ولكن أحياناً مع مسحة برتقالية)",
 "orange rind": "قشرة برتقال (قشرة البرتقال)",
 "orange sneezeweed": "عشبة العطاس البرتقالية (عشبة معمرة قوية من غرب الولايات المتحدة ذات رؤوس زهور بأشعة صفراء برتقالية متدلية؛ تسبب مرض القيء في الأغنام)",
 "orange soda": "صودا البرتقال (مشروب غازي بنكهة البرتقال)",
 "orange toast": "توست البرتقال (توست بالزبدة مع السكر وقشر البرتقال المبشور وقليل من عصير البرتقال)",
 "orange tortrix": "عثة البرتقال (عثة من كاليفورنيا تعيش يرقاتها في البرتقال بشكل خاص)",
 "orange tree": "برتقال, شجرة البرتقال (أي شجرة حمضيات تحمل البرتقال)",
 "orange yellow": "أصفر برتقالي, زعفراني (درجة من الأصفر مشوبة بالبرتقالي)",
 "orange zest": "بشر البرتقال (قطع صغيرة جداً من قشر البرتقال)",
 "orange-blossom orchid": "أوركيد زهر البرتقال (أوركيد أسترالي صغير بعناقيد رخوة من الزهور البيضاء العطرة بعلامات أرجوانية وبرتقالية على الشفة)",
 "orange-brown": "بُنِّيّ بُرْتُقَالِيّ (بني مع مسحة برتقالية)",
 "orange-colored": "بُرْتُقَالِيّ اللَّوْن (ذو لون برتقاليّ)",
 "orange-coloured": "بُرْتُقَالِيّ اللَّوْن (ذو لون برتقاليّ)",
 "orange-flowered": "بُرْتُقَالِيّ الأَزْهَار (ذو أزهار برتقاليّة اللون)",
 "orange-hued": "بُرْتُقَالِيّ اللَّوْن (ذو لون برتقاليّ)",
 "orange-juice concentrate": "عصير برتقال مجمد, مركز عصير البرتقال (عصير برتقال تم تركيزه وتجميده)",
 "orange-red": "أَحْمَر بُرْتُقَالِيّ (أحمر مع مسحة برتقالية)",
 "orange-sized": "بِحَجْمِ الْبُرْتُقَالَةِ (بحجم برتقالة تقريبًا)",
 "orangeade": "شَرٰب اَلْبُرْتُقَال (جَرَعَ)\nمثال: جلس وشرب قهوته.",
 "orangeman": "عضو في جمعية الأورانج (عضو في جمعية تأسست في أيرلندا عام 1795 لدعم البروتستانتية والسيادة البريطانية)",
 "orangeness": "برتقالي (اللون البرتقالي أو الصبغة؛ أي من مجموعة ألوان بين الأحمر والأصفر)",
 "orangery": "أورانجري, مشتل البرتقال (مكان تُزرع فيه البرتقال؛ مزرعة لأشجار البرتقال في المناخات الدافئة أو دفيئة في المناطق الأكثر برودة)",
 "orangewood": "خشب البرتقال (خشب دقيق الحبيبات لشجرة البرتقال؛ يستخدم في الأعمال الخشبية الدقيقة)",
 "orangish": "بُرْتُقَالِيّ (بلون بين الأحمر والأصفر؛ مشابه للون البرتقال الناضج)",
 "orangish-red": "أَحْمَر بُرْتُقَالِيّ (أحمر مع مسحة برتقالية)",
 "orangutan": "إِنْسَان اَلْغَاب, إِنْسَان الْغَابَة (كَائِن بَشَرِيّ؛ سَوَاد العَيْن)\nمثال: أنا إنسان صادق.",
 "orangutang": "أورانغوتان, إنسان الغاب (قرد كبير طويل الذراعين يعيش في بورنيو وسومطرة وله عادات شجرية)",
 "oranjestad": "أورنجستاد",
 "orasone": "بريدنيزون, دلتاسون (نظير منزوع الهيدروجين للكورتيزول (الأسماء التجارية دلتاسون وغيرها)؛ يستخدم كدواء مضاد للالتهابات في علاج التهاب المفاصل وكمثبط للمناعة)",
 "oration": "خُطْبَة",
 "orator": "خَطِيب, خَطِيبَة",
 "oratorical": "خَطَابِيّ (من خصائص الخطيب أو فنّ الخطابة)",
 "oratorio": "أوراتوريو, كانتاتا (تأليف موسيقي للأصوات والأوركسترا مبني على نص ديني)",
 "oratory": "مُصَلًّى (موضع الصلاة للشخص والجماعة؛ غرفة تخصص للصلاة في الأماكن العامّة، لا إمام فيها وهي دون المسجد) / خِطَابَة",
 "orb": "مقلة العين (المحفظة الكروية التي تحتوي على عين الفقاريات) / جرم, كرة (جسم ذو شكل كروي)\nمثال: كرة من النار",
 "orb web": "شبكة دائرية (شبكة عنكبوت دائرية)",
 "orb-weaving": "ناسج للشبكات الدائرية ((عن العناكب) التي تنسج شبكات دائرية)",
 "orb-weaving spider": "عنكبوت نساج (عنكبوت يغزل شبكة دائرية (أو شبه دائرية))",
 "orbicular": "كُرَوِيّ (ذو شكل الكرة أو المجال) / دَائِرِيّ, مُسْتَدِير (دائريّ أو شبه دائريّ)",
 "orbiculate": "دَائِرِيّ, مُسْتَدِير (دائريّ أو شبه دائريّ)",
 "orbiculate leaf": "ورقة دائرية (ورقة دائرية أو شبه دائرية)",
 "orbignya cohune": "نخيل كوهون (نخيل ريشي استوائي أمريكي تنتج مكسراته الكبيرة زيتاً قيماً ونوعاً من العاج النباتي)",
 "orbignya martiana": "باباسو, نخيل الباباسو (نخيل ريشي طويل من شمال البرازيل بمكسرات صلبة القشرة تنتج زيتاً قيماً ونوعاً من العاج النباتي)",
 "orbignya phalerata": "باباسو, نخيل الباباسو (نخيل ريشي طويل من شمال البرازيل بمكسرات صلبة القشرة تنتج زيتاً قيماً ونوعاً من العاج النباتي)",
 "orbignya spesiosa": "باباسو, نخيل الباباسو (نخيل ريشي طويل من شمال البرازيل بمكسرات صلبة القشرة تنتج زيتاً قيماً ونوعاً من العاج النباتي)",
 "orbit": "مَدَار (اسم مَفْعُول من أدَارَ، الشيء أو الشخص الذي أُدِير) / فَلَك (التَلّ المستدير من الرَمْل حوله فَضَاء؛ المَدَار يسبح فيه الجُرْم السماويّ)\nمثال: انتشرت الشائعة على مدار الدولة.",
 "orbit period": "فترة المدار (الوقت المستغرق لإكمال مدار كامل حول جرم سماوي)\nمثال: تعتمد فترة المدار على ارتفاع القمر الصناعي",
 "orbital": "دَائِرِيّ, دَوَّارِيّ (يرسم دائرة أو يتحرك في مسار دائري) / حجاجي (متعلق بمحجر العين (الحجاج)) / مداري (من أو يتعلق بالمدار)\nمثال: قشرة حجاجية",
 "orbital cavity": "حجاج, محجر العين (التجويف العظمي في الجمجمة الذي يحتوي على مقلة العين)",
 "orbital motion": "حركة مدارية, دوران مداري (حركة جسم في مدار حول نقطة ثابتة)\nمثال: أقمار صناعية في دوران مداري",
 "orbital plane": "المستوى المداري ((فلك) المستوى الذي يدور فيه جرم سماوي)",
 "orbital point": "حجاجية (نقطة قياس القحف عند أدنى نقطة على الحافة السفلية للمحجر)",
 "orbital rotation": "حركة مدارية, دوران مداري (حركة جسم في مدار حول نقطة ثابتة)\nمثال: أقمار صناعية في دوران مداري",
 "orbitale": "حجاجية (نقطة قياس القحف عند أدنى نقطة على الحافة السفلية للمحجر)",
 "orbiter": "تابع, قمر اصطناعي (معدات من صنع الإنسان تدور حول الأرض أو القمر)",
 "orc": "أُورْك",
 "orca": "حُوت قَاتِل (سمكة صَغيرة كانت أو كبيرة؛ حوت كبير: صاحب مال وسَطْوَة ونفوذ)\nمثال: هل الحوت من الثدييات؟",
 "orchard": "بُسْتَان, بَيَارَة (أَرْض يحيطها سُوْر وفيها نخيل متفرقة وأعناب وأشجار، تستخدم في الأساس للحصول على منتوجها من الفَاكِهَة والثَمَر. الجَنَّة)\nمثال: أحب سقي البستان.",
 "orchard apple tree": "تفاح, شجرة التفاح (شجرة أوراسية أصلية تزرع على نطاق واسع في العديد من الأصناف لثمارها المستديرة الصلبة الصالحة للأكل)",
 "orchard grass": "إصبعية متكتلة, عشب البساتين (عشب قش ومرعى قوي من العالم القديم يُزرع على نطاق واسع)",
 "orchard oriole": "صفارية البساتين (الذكر لونه كستنائي وأسود)",
 "orchestra": "أُورْكِسْتْرَا",
 "orchestra pit": "حفرة الأوركسترا (منطقة منخفضة أمام المسرح حيث ترافق الأوركسترا المؤدين)",
 "orchestral": "أوركسترالي (يتعلق بالأوركسترا أو مؤلف لها)\nمثال: نوتة أوركسترالية",
 "orchestral bells": "أجراس أوركسترالية, جلوكنشبيل (آلة إيقاعية تتكون من مجموعة من القضبان المعدنية المدرجة المثبتة على إطار وتُعزف بمطارق صغيرة)",
 "orchestrated": "موزع أوركستراليا (مرتب للأداء بواسطة أوركسترا)",
 "orchestration": "توزيع أوركسترالي (فعل ترتيب قطعة موسيقية للأوركسترا وتعيين أجزاء للآلات الموسيقية المختلفة) / تنسيق, تنظيم دقيق (ترتيب للأحداث يحاول تحقيق أقصى قدر من التأثير) / أوركَستْرَة, توزيع للأوركسترا (توزيع لقطعة موسيقية للأداء بواسطة أوركسترا أو فرقة)\nمثال: التنسيق الماهر لحملته السياسية",
 "orchestrator": "موزع أوركسترالي (موزع موسيقي يكتب للأوركسترا)",
 "orchid": "أُورْكِيد, سَحْلَب",
 "orchid cactus": "إبيفيلم, صبار الأوركيد (أي صبار من جنس إبيفيلم له سيقان مسطحة مفصلية متفرعة بشكل غير منتظم وأزهار أنبوبية مبهرجة)",
 "orchid tree": "خف الجمل, شجرة الأوركيد (شجرة صغيرة من شرق الهند لها زهور تشبه الأوركيد وخشب داكن صلب)",
 "orchidaceous plant": "أوركيد, سحلبية (أي من العديد من نباتات فصيلة السحلبيات التي تتميز عادة بزهور ذات أشكال غير عادية وألوان جميلة)",
 "orchidalgia": "ألم الخصية (ألم في الخصيتين)",
 "orchidectomy": "استئصال الخصية (إزالة جراحية لخصية واحدة أو كلتيهما)",
 "orchiectomy": "استئصال الخصية (إزالة جراحية لخصية واحدة أو كلتيهما)",
 "orchil": "أرشيل (أي من أنواع الليكانورا المختلفة التي تنتج صبغة الأرشيل) / أوركيل, صبغة الأوركيل (صبغة أرجوانية يتم الحصول عليها من أشنات الأوركيل)",
 "orchiopexy": "تثبيت الخصية (عملية لجلب الخصية المعلقة إلى كيس الصفن)",
 "orchis": "خصية (إحدى الغدتين التناسليتين الذكريتين اللتين تنتجان الحيوانات المنوية وتفرزان الأندروجينات) / أوركيس, سحلب (أي من بساتين الفاكهة الأرضية المتساقطة الأوراق المختلفة ذات درنات لحمية وزهور في عناقيد طرفية منتصبة)\nمثال: ركلته في خصيتيه وهربت",
 "orchis mascula": "سحلب ذكر (سحلب أوراسي بزهور وردية أو أرجوانية ملفتة للنظر في سنبلة فضفاضة)",
 "orchis papilionaceae": "سحلب الفراشة (سحلب متوسطي له زهور أرجوانية عادة بشفة حمراء وردية مرقطة أو مخططة على شكل مروحة)",
 "orchis spectabilis": "سحلب استعراضي (سحلب من أمريكا الشمالية له سنبلة من الزهور البنفسجية الأرجوانية الممزوجة بالأبيض؛ السبلات والبتلات تشكل غطاء)",
 "orchitis": "التهاب الخصية (التهاب إحدى الخصيتين أو كلتيهما؛ يتميز بالألم والتورم)",
 "orchotomy": "بضع الخصية (شق جراحي في الخصية للحصول على مادة للتحليل (كما في حالات انخفاض عدد الحيوانات المنوية بشكل غير طبيعي))",
 "orcinus orca": "أوركا, حوت قاتل (حوت مسنن مفترس أسود وأبيض ذو زعنفة ظهرية كبيرة؛ شائع في البحار الباردة)",
 "ord kangaroo rat": "جرذ كانغرو أورد (أكثر أنواع جرذان الكنغر انتشاراً: يعيش في السهول والمناطق الجبلية بوسط وغرب الولايات المتحدة)",
 "ordained": "مُرَسَّم, مُكَرَّس (مُخَوَّلٌ بِوَظَائِفَ كَهَنُوتِيَّةٍ أَوْ دِينِيَّةٍ) / مَفْرُوض, مُقَرَّر (ثابت أو مقرّر خاصّة بأمر أو قرار رسميّ)",
 "ordainer": "راسم الكهنة, مُسَيِّم (رجل دين يقوم برسامة الآخرين؛ رجل دين يُدخل شخصاً في الرتب الكهنوتية المقدسة)",
 "ordeal": "اِمْتِحَان, تَجْرُبَة (اِمْتِحَان) / مِحْنَة\nمثال: لدي امتحان غدا.",
 "ordeal bean": "فول كالابار (بذرة بنية داكنة شديدة السمية لكرمة فول كالابار؛ مصدر للفيزوستيغمين وتستخدم في السحر المحلي)",
 "ordeal tree": "سم البوشمن, شجرة المحنة (شجيرة أو شجرة دائمة الخضرة من جنوب أفريقيا)",
 "order": "تَرْتِيب, نِظَام (تنظيم الأشياء أو الأحداث في تسلسل معين أو وضعها في نظام؛ إعداد أو تجهيز شيء لتحقيق غاية معينة) / أَمْر, حُكْم (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة) / طَلَب (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى)) / جَمَاعَة (العَدَد الكثير من النَاس أو الحَيْوَان أو النَبَات أو غيره. المَجْمُوعَة؛ طَائِفَة من الناس التي يجمعها مكان و بيئة واحدة أو تتشارك اهداف و غايات واحدة) / وِسَام / رُتْبَة (رُتْبَة، بضم الراء؛ رَتْبَة، بفتح الراء) / أَمَرَ (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة) / طَلَبَ, حَجَزَ (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى))\nمثال: أعاد زيري ترتيب المطبخ كلية.",
 "order accipitriformes": "جوارح (في بعض التصنيفات اسم بديل للصقريات)",
 "order arms": "وضع السلاح بجانب القدم (وضع في دليل استخدام الأسلحة؛ تُمسك البندقية عمودياً على الجانب الأيمن مع وضع العقب على الأرض؛ يستخدم غالباً كأمر عسكري)",
 "order book": "دفتر طلبيات (كتاب يتم فيه إدخال طلبيات الزبائن؛ عادة ما يصنع نسخاً متعددة من الطلب) / ورقة جدول الأعمال (نسخة مطبوعة من جدول الأعمال اليومي)",
 "order code": "رمز العملية, كود العملية (الجزء من مجموعة أوصاف العمليات الذي يحدد العملية التي سيتم تنفيذها؛ مجموعة العمليات في الحاسوب)",
 "order form": "نموذج طلب (نموذج يستخدم عند تقديم طلب شراء)",
 "order of business": "جدول أعمال (قائمة بالمسائل التي سيتم تناولها (كما في اجتماع))",
 "order of magnitude": "رتبة حجمية, رتبة مقدار (درجة في سلسلة متصلة من الحجم أو الكمية) / أُسّ عَشْرِيّ, رُتْبَة مِقْدَارِيَّة (رقم مخصص لنسبة كميتين؛ تكون كميتان من نفس الرتبة المقدارية إذا كانت إحداهما أقل من 10 أضعاف الأخرى)\nمثال: كان في حدود ميل واحد",
 "order of our lady of mount carmel": "الرهبنة الكرملية, رهبنة سيدة جبل الكرمل (نظام رهباني متسول كاثوليكي روماني تأسس في القرن الثاني عشر)",
 "order of payment": "حوالة مالية, سفتجة (وثيقة تأمر بدفع المال؛ يسحبها شخص أو بنك على آخر)",
 "order of saint benedict": "الرهبنة البندكتية, نظام القديس بنديكت (نظام رهباني كاثوليكي روماني تأسس في القرن السادس؛ يشتهر بالعبادة الليتورجية والأنشطة العلمية)",
 "order of the day": "جدول الأعمال اليومي (ترتيب الأعمال لجمعية في يوم معين)",
 "order of the purple heart": "وسام القلب الأرجواني (وسام عسكري أمريكي يمنح لأي عضو في القوات المسلحة يُجرح في المعركة)",
 "order ostariophysi": "أوستاريوفيسي (تُعتبر في بعض التصنيفات رتبة عليا تضم الشبوطيات والسلوريات)",
 "order paper": "ورقة جدول الأعمال (نسخة مطبوعة من جدول الأعمال اليومي)",
 "ordered": "مَنْطِقِيّ, مُتَمَاسِك (يتميز بعلاقة أجزاء منظمة ومنطقية ومتسقة جمالياً) / مرتب, منظم (لديه ترتيب منهجي؛ خاصة وجود عناصر تتوالى بترتيب وفقاً لقاعدة) / مرتب, منسق (موضع أو مرتب بنوع معين من النظام)\nمثال: حجة متماسكة",
 "ordered series": "سلم قياس, مقياس (معيار مرجعي مرتب)\nمثال: الحكم على مقياس من 1 إلى 10",
 "orderer": "منظم, منهجي (منظم يضع الأشياء في ترتيب) / طالب بضاعة, مقدم الطلب (شخص يقدم طلباً للشراء)\nمثال: كان أرسطو منظماً عظيماً للأفكار",
 "ordering": "ترتيب, نظم (فعل وضع الأشياء في ترتيب تسلسلي) / ترتيب, نظام (ترتيب منطقي أو مفهوم لعناصر منفصلة)\nمثال: كانت هناك أخطاء في ترتيب العناصر في القائمة",
 "orderliness": "تَرْتِيب, مَنْهَجِيَّة (صفة تقدير المنهج والنظام) / ترتيب, نظام (حالة من الترتيب المنتظم أو الصحيح)\nمثال: رتب مكتبه",
 "orderly": "منضبط, منظم (خالٍ من العنف أو الاضطراب) / مُنَظَّم, نَظِيف (نَظِيفٌ أَوْ مُنَظَّمٌ بِشَكْلٍ جَيِّد) / تمرجي, ساعي المستشفى (مرافق مستشفى ذكر لديه واجبات عامة لا تشمل العلاج الطبي للمرضى) / جندي مراسلة, مراسل (جندي يعمل كمساعد لضابط أعلى رتبة)\nمثال: حشد منظم واجه الرئيس",
 "orderly sergeant": "رقيب المراسلة (الرقيب الأول للسرية؛ كانت واجباته تشمل سابقاً نقل الأوامر)",
 "ordinal": "ترتيبي (كونه أو دالاً على ترتيب عددي في سلسلة) / ترتيبي, رتبي (من أو يتعلق برتبة تصنيفية) / عدد ترتيبي (الرقم الذي يعين المكان في تسلسل مرتب)\nمثال: أرقام ترتيبية (الأول، الثاني؛)",
 "ordinal number": "عدد ترتيبي (الرقم الذي يعين المكان في تسلسل مرتب)",
 "ordinance": "أَمْر (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة)\nمثال: إنه أمر مختلف .",
 "ordinand": "المرشح للكهنوت, طالب السيامة (شخص يجري ترسيمه كاهناً)",
 "ordinarily": "بشكل طبيعي, عادة (في ظل الظروف العادية)\nمثال: عادة كانت تتأخر",
 "ordinariness": "اعْتِيَادِيَّة, عَادِيَّة (صفة كون الشيء مألوفاً وعادياً)",
 "ordinary": "عَادِيّ, مَأْلُوف",
 "ordinary annuity": "دفعات سنوية عادية (دخل سنوي يُدفع في سلسلة من المدفوعات المتساوية تقريباً في نهاية فترات متباعدة بالتساوي)",
 "ordinary bicycle": "دراجة ذات عجلة كبيرة (دراجة قديمة بعجلة أمامية كبيرة جداً وعجلة خلفية صغيرة)",
 "ordinary care": "عناية واجبة (العناية التي يمارسها الرجل العاقل في ظل الظروف؛ المعيار لتحديد الواجب القانوني)",
 "ordinary life insurance": "تأمين مدى الحياة (تأمين على حياة المؤمن عليه بمبلغ ثابت بقسط محدد يُدفع كل عام بنفس المبلغ طوال عمر المؤمن عليه)",
 "ordinary shares": "أسهم عادية (أسهم غير الأسهم الممتازة؛ تمنح المالك حصة من أرباح الشركة وحصة من قوة التصويت في انتخابات المساهمين)",
 "ordinate": "إِحْدَاثِيّ صَادِيّ, الإحداثي الرأسي (قيمة الإحداثي على المحور الرأسي)",
 "ordination": "رِسامة",
 "ordnance": "سلاح ثقيل, مدفعية (تسليح كبير ولكن قابل للنقل) / ذخائر, عتاد عسكري (الإمدادات العسكرية)",
 "ordnance store": "ذخائر, عتاد عسكري (الإمدادات العسكرية)",
 "ordnance survey": "أوردنانس سيرفي, هيئة المساحة (وكالة رسم الخرائط الرسمية للحكومة البريطانية)",
 "ordure": "براز, غائط (منتج إخراجي صلب يفرغ من الأمعاء)",
 "ore": "رِكَاز, خَامَة",
 "ore bed": "طبقة خام (طبقة من المعدن الخام)",
 "ore dressing": "استخلاص المعادن, معالجة الخامات (سحق الخامات وفصلها إلى مواد قيمة أو نفايات باستخدام أي من التقنيات المتنوعة)",
 "ore processing": "استخلاص المعادن, معالجة الخامات (سحق الخامات وفصلها إلى مواد قيمة أو نفايات باستخدام أي من التقنيات المتنوعة)",
 "oread": "أورياد ((الأساطير اليونانية) واحدة من حوريات الجبال)",
 "oreamnos americanus": "ماعز الجبل (ثديي ثابت القدم يعيش في المناطق الجبلية بشمال غرب أمريكا الشمالية)",
 "orectolobus barbatus": "قرش السجاد (قرش من غرب المحيط الهادئ ذو جسم مفلطح وجلد مرقش)",
 "oregano": "مَرْدَقُوش, مَرْدَقُوش بَرِّيّ",
 "oregon": "أُورِيغُون",
 "oregon alder": "نغت أحمر (شجرة كبيرة من ساحل المحيط الهادئ لأمريكا الشمالية لها خشب أحمر صلب يستخدم كثيراً للأثاث)",
 "oregon ash": "مران أوريغون (شجرة أخشاب من غرب أمريكا الشمالية تنتج خشباً خفيفاً صلباً؛ وثيقة الصلة بالمران الأحمر)",
 "oregon cedar": "أرز أوريغون, سرو لوسون (شجرة خشب كبيرة من غرب أمريكا الشمالية بقطر جذع يصل إلى 12 قدماً وارتفاع يصل إلى 200 قدم)",
 "oregon crab apple": "تفاح أوريغون البري (شجرة صغيرة أو شجيرة من غرب الولايات المتحدة لها أزهار بيضاء وفاكهة صفراء أو حمراء صغيرة جداً)",
 "oregon fir": "تنوب دوغلاس الأخضر, صنوبر أوريغون (تنوب دوغلاس شاهق من شمال غرب أمريكا الشمالية له إبر قصيرة ومخاريط بيضاوية الشكل)",
 "oregon grape": "عنب أوريغون, ماهونيا (شجيرة زينة دائمة الخضرة من ساحل المحيط الهادئ لأمريكا الشمالية ذات أوراق خضراء داكنة ريشية وعناقيد من الزهور الصفراء تليها حبات توت زرقاء سوداء) / عنب أوريغون, ماهونيا عصبية (شجيرة صغيرة ذات أوراق خضراء رمادية وأزهار صفراء تليها حبات توت زرقاء شاحبة)",
 "oregon holly grape": "عنب أوريغون, ماهونيا (شجيرة زينة دائمة الخضرة من ساحل المحيط الهادئ لأمريكا الشمالية ذات أوراق خضراء داكنة ريشية وعناقيد من الزهور الصفراء تليها حبات توت زرقاء سوداء)",
 "oregon jargon": "رطانة الشينوك (لغة بدجنية تدمج كلمات من الشينوك والفرنسية والإنجليزية؛ كانت تستخدم سابقاً كلغة مشتركة في شمال غرب أمريكا الشمالية)",
 "oregon larch": "أرزية غربية (أرزية طويلة من غرب أمريكا الشمالية لها أوراق خضراء شاحبة حادة الرؤوس ومخاريط مستطيلة؛ شجرة خشب مهمة)",
 "oregon lily": "زنبق أوريغون, زنبق كولومبيا النمري (زنبق من غرب أمريكا الشمالية بزهور برتقالية حمراء منقطة بالأرجواني مبهرجة)",
 "oregon maple": "قيقب أوريغون, قيقب كبير الأوراق (قيقب من غرب أمريكا الشمالية له أوراق كبيرة خماسية الفصوص برتقالية في الخريف)",
 "oregon myrtle": "آس أوريغون, غار كاليفورنيا (شجرة ساحل المحيط الهادئ ذات أوراق عطرية وزهور خيمية صغيرة تليها ثمار تشبه الزيتون؛ تنتج خشباً صلباً متيناً)",
 "oregon oak": "سنديان أوريغون الأبيض, سنديان غاري (شجرة نفضية صغيرة موطنها غرب أمريكا الشمالية ذات فروع ملتوية ولحاء رمادي شاحب)",
 "oregon pine": "تنوب دوغلاس الأخضر, صنوبر أوريغون (تنوب دوغلاس شاهق من شمال غرب أمريكا الشمالية له إبر قصيرة ومخاريط بيضاوية الشكل)",
 "oregon white oak": "سنديان أوريغون الأبيض, سنديان غاري (شجرة نفضية صغيرة موطنها غرب أمريكا الشمالية ذات فروع ملتوية ولحاء رمادي شاحب)",
 "oregonian": "أوريغوني (مواطن أو مقيم في أوريغون)",
 "oreide": "أورويد (سبيكة من النحاس والقصدير والزنك؛ تستخدم في صناعة المجوهرات المقلدة للذهب)",
 "orenburg": "أُورِينْبُورْغ",
 "oreo": "أوريو",
 "oreo cookie": "أوريو (بسكويت شوكولاتة بحشوة كريمة بيضاء)",
 "oreopteris limbosperma": "سرخس الجبل (سرخس جبلي أوروبي شائع له سعف برائحة الليمون أو البلسم)",
 "oreortyx picta palmeri": "سمان الجبل (حجل كاليفورنيا؛ أكبر قليلاً من سمان كاليفورنيا)",
 "organ": "عُضْو, عِضْو (جُزْء من الجَسَد؛ مُشْتَرِك فِي جَمْعِيَّة أو شَرِكَة أو حِزْب أو نَادٍ) / جِهَاز, جَهَاز / أُرْغُن ((أَرْغَنَ): أطاع؛ (أَرْغَنَ) إليه: رغن)\nمثال: اذكر كل عضو باسمه.",
 "organ donor": "متبرع بالأعضاء (شخص يؤخذ منه عضو لزرعه)",
 "organ loft": "شرفة الأرغن (رواق يشغله أرغن الكنيسة)",
 "organ of corti": "عضو كورتي (عضو السمع في الأذن الداخلية؛ يحتوي على مستقبلات تستجيب للموجات الصوتية)",
 "organ of hearing": "عضو السمع (جزء الأذن المسؤول عن الإحساس بالصوت)",
 "organ of speech": "عضو نطق (أي من الأعضاء المشاركة في إنتاج الكلام)",
 "organ pipe": "أنبوب الأرغن (المداخن والسدادات في الأرغن الأنبوبي)",
 "organ stop": "موقف الأرغن (مجموعة مدرجة من أنابيب الأرغن ذات جودة نغمة متشابهة)",
 "organ transplant": "زِرَاعَة اَلْأَعْضَاء",
 "organ-grinder": "عازف الأرغن اليدوي (موسيقي متجول يعزف على الأرغن اليدوي)",
 "organdie": "أورغاندي (موسلين صلب شفاف)",
 "organdy": "أورغاندي (موسلين صلب شفاف)",
 "organelle": "عضية (جزء متخصص من الخلية؛ يماثل العضو)\nمثال: أول عضية تم تحديدها كانت النواة",
 "organic": "عُضْوِيّ",
 "organic brain syndrome": "متلازمة الدماغ العضوية (شذوذ عقلي ناتج عن اضطراب في بنية أو وظيفة الدماغ)",
 "organic chemistry": "كيمياء عضوية (كيمياء المركبات التي تحتوي على الكربون)",
 "organic compound": "مركب عضوي (أي مركب يتكون من الكربون وعنصر آخر أو شق كيميائي)",
 "organic disorder": "اضطراب عضوي (اضطراب ناتج عن تغير فسيولوجي أو هيكلي قابل للكشف في عضو ما)",
 "organic evolution": "تطور, تطور عضوي ((علم الأحياء) تسلسل الأحداث المتضمنة في التطور التطوري لنوع أو مجموعة تصنيفية من الكائنات الحية)",
 "organic fertiliser": "سماد عضوي (سماد مشتق من مواد حيوانية أو نباتية)",
 "organic fertilizer": "سماد عضوي (سماد مشتق من مواد حيوانية أو نباتية)",
 "organic law": "دستور, قانون أساسي (قانون يحدد المبادئ السياسية الأساسية للحكومة)",
 "organic light-emitting diode": "صمام ثنائي عضوي باعث للضوء (صمام ثنائي ذاتي الإضاءة (يتوهج عند تطبيق مجال كهربائي على الأقطاب) لا يتطلب إضاءة خلفية أو ناشرات)",
 "organic phenomenon": "ظاهرة حيوية, ظاهرة عضوية ((في علم الأحياء) ظاهرة طبيعية تشمل النباتات والحيوانات الحية)",
 "organic process": "عملية بيولوجية, عملية حيوية (عملية تحدث في الكائنات الحية)",
 "organic structure": "جَسَد, هَيْكَل عُضْوِيّ (الهيكل المادي الكامل للكائن الحي (حيوان أو نبات أو إنسان))\nمثال: شعر وكأن جسده كله يشتعل",
 "organically": "عضوياً (ينطوي على مركبات الكربون) / عضوياً (كمكون مهم) / عضوياً (بطريقة عضوية)\nمثال: يود مرتبط عضوياً",
 "organicism": "عضوية, مذهب العضوية (نظرية تفيد بأن التنظيم الكلي للكائن الحي بدلاً من عمل الأعضاء الفردية هو المحدد للعمليات الحيوية)",
 "organicistic": "عضواني (يتعلق بالعضوانية (نظرية ترابط الأجزاء) أو يميل إليها)",
 "organification": "تكون الأعضاء (عملية تكوين الأعضاء)",
 "organisation": "إنشاء, تأسيس (فعل تشكيل أو تأسيس شيء ما) / تنظيم (نشاط أو نتيجة توزيع أو ترتيب الأشخاص أو الأشياء بشكل صحيح أو منهجي) / تنظيم (فعل تنظيم عمل تجاري أو نشاط متعلق بعمل تجاري) / تَنْظِيم, نِظَام (أسلوب منظم؛ الانتظام بفضل كون الشيء منهجياً ومنظماً جيداً)\nمثال: تأسيس مجموعة الآباء والمعلمين العام الماضي",
 "organisational": "تنظيمي, مؤسسي (متعلق بمنظمة أو مؤسسة)\nمثال: هيكل تنظيمي",
 "organised": "مُنَقَّب, مُنْتَسِب لِلنِّقَابَة (عضو في نقابة عمالية أو مُشكَّل ضمنها)",
 "organiser": "مساعد رقمي شخصي (جهاز إلكتروني استهلاكي خفيف الوزن يشبه الحاسوب المحمول باليد ولكنه يؤدي مهام محددة؛ يمكن أن يعمل كمفكرة أو قاعدة بيانات شخصية أو هاتف أو ساعة منبه…) / مرتب, منظم (شخص يحقق النظام والتنظيم في مؤسسة ما) / منظم عمالي (شخص يجند العمال للانضمام إلى نقابة)\nمثال: كانت هي منظمة الاجتماع",
 "organism": "كَائِن حَيّ",
 "organismal": "عضوي, كائني (من أو يتعلق بكائن حي أو ينتمي إليه (معتبراً ككل))\nمثال: النظرية العضوية للدولة",
 "organismic": "عضوي, كائني (من أو يتعلق بكائن حي أو ينتمي إليه (معتبراً ككل))\nمثال: النظرية العضوية للدولة",
 "organist": "عازف أرغن (شخص يعزف على الأرغن)",
 "organization": "تَرْتِيب, تَنْظِيم (تنظيم الأشياء أو الأحداث في تسلسل معين أو وضعها في نظام؛ إعداد أو تجهيز شيء لتحقيق غاية معينة) / مُنَظَّمَة, مُؤَسَّسَة / مُنَظَّمَة\nمثال: أعاد زيري ترتيب المطبخ كلية.",
 "organization chart": "هيكل تنظيمي (مخطط يوضح خطوط المسؤولية بين أقسام مؤسسة كبيرة)",
 "organization expense": "مصاريف التأسيس (تكلفة تأسيس شركة جديدة أو شراكة (على مدى خمس سنوات))",
 "organization for the prohibition of chemical weapons": "منظمة حظر الأسلحة الكيميائية (منظمة دولية لنزع السلاح الكيميائي؛ تدير اتفاقية الأسلحة الكيميائية)",
 "organization man": "رجل المؤسسة (موظف ذكر يضحي بفرديته من أجل مصلحة المؤسسة)",
 "organization of american states": "منظمة الدول الأمريكية (رابطة تضم معظم البلدان في نصف الكرة الغربي؛ أنشئت عام 1948 لتعزيز التعاون العسكري والاقتصادي والاجتماعي والثقافي)",
 "organization of petroleum-exporting countries": "أوبك, منظمة الدول المصدرة للنفط (منظمة دول تشكلت عام 1961 للاتفاق على سياسة مشتركة لإنتاج وبيع البترول)",
 "organizational": "تنظيمي, مؤسسي (متعلق بمنظمة أو مؤسسة)\nمثال: هيكل تنظيمي",
 "organizationally": "تنظيمياً (فيما يتعلق بالتنظيم)\nمثال: تنظيمياً، كان المؤتمر كارثة!",
 "organize": "نَظَّمَ (نَظَّمَه تَنْظِيمًا:أَلَّفَه وجَمَعَه فِي سِلْكٍ فانْتَظَمَ وتَنَظَّمَ ، وَمِنْه:نَظَمْتُ الشِّعْرَ ونَظَّمْتُه؛ نَظّم الأشياء :نظمها ،رتّبها،وضمّ بعضها إلى بعض في صورة منسّقة)\nمثال: نظم سامي كل شيء.",
 "organized": "منظم (منهجي وفعال في الترتيب أو الوظيفة) / مؤسسي, منظم (مشكل في كل منظم أو متماسك، خاصة على نطاق واسع) / مُنَقَّب, مُنْتَسِب لِلنِّقَابَة (عضو في نقابة عمالية أو مُشكَّل ضمنها)\nمثال: كم هي منظمة بشكل جيد",
 "organized crime": "جَرِيمة مُنَظَّمة",
 "organized labor": "العمالة المنظمة, النقابات العمالية (الموظفون الذين تمثلهم نقابة عمالية)",
 "organized religion": "ديانة, دين (مؤسسة للتعبير عن الإيمان بقوة إلهية)\nمثال: نشأ على الدين المعمداني",
 "organizer": "مُنَظِّم",
 "organometallic compound": "مركب عضوي فلزي (مركب يحتوي على شق ألكيل أو أريل مرتبط بفلز)\nمثال: رباعي كربونيل النيكل والفيروسين هي أمثلة على المركبات العضوية الفلزية",
 "organon": "آلة منطقية, أورغانون (نظام من المبادئ للتحقيقات الفلسفية أو العلمية؛ أداة لاكتساب المعرفة)",
 "organophosphate": "فوسفات عضوي, مبيد فوسفاتي عضوي (مبيد حشري يتداخل مع الجهاز العصبي للحشرة)",
 "organophosphate nerve agent": "عامل أعصاب فوسفوري عضوي (أي من سلسلة عوامل الأعصاب التي تحتوي على مركبات الفوسفات العضوية التي ركبها الكيميائيون الألمان لأول مرة في عام 1936؛ اختبرها الألمان في معسكرات…)",
 "organs": "أحشاء, أعضاء الحيوان (الأحشاء الصالحة للأكل من الحيوان المذبوح)",
 "organza": "أورجانزا (قماش مصنوع من الحرير أو قماش شبيه بالحرير يشبه الأورغاندي)",
 "orgasm": "نَشْوَة, هِزَّة اَلْجِمَاع",
 "orgiastic": "خَمْرِيّ, عَرْبَدِيّ (يُوصَف بِهِ العَرْبَدَة وَالسُّكْر الصَّاخِب) / عَرْبَدِيّ (يُستخدم لوصف نشاط جنسيّ محموم وجماعيّ)",
 "orgosolo": "أرغوسولو",
 "orgy": "باخاناليا, حفلة مجون (تجمع جامح ينطوي على الإفراط في الشرب والانحلال الجنسي) / طقوس العربدة (طقس سري في عبادات الآلهة اليونانية أو الرومانية القديمة ينطوي على الغناء والرقص والشرب والنشاط الجنسي) / عربدة, نوبة إفراط (أي فعل من أفعال الانغماس غير المعتدل)\nمثال: نوبة إفراط في التسوق",
 "oriel": "نافذة أورييل (نافذة بارزة معلقة أو مثبتة ناتئة من الجدار)",
 "oriel window": "نافذة أورييل (نافذة بارزة معلقة أو مثبتة ناتئة من الجدار)",
 "orient": "المشرق, نصف الكرة الشرقي (نصف الكرة الذي يشمل أوراسيا وأفريقيا وأستراليا)",
 "oriental": "شَرْقِيّ",
 "oriental alabaster": "ألباستر, مرمر (نوع صلب مدمج من الكالسيت)",
 "oriental arborvitae": "عفص شرقي (شجيرة أو شجرة صغيرة آسيوية تزرع على نطاق واسع في الولايات المتحدة وأوروبا؛ في بعض التصنيفات تخصص لجنسها الخاص)",
 "oriental beetle": "خُنْفُسَاء شَرْقِيَّة",
 "oriental bittersweet": "حلوة مرة يابانية, سيلاستروس ياباني (كرمة زينة آسيوية بثمار برتقالية صفراء مبهرجة مع غلاف قرمزي؛ مستوطنة في أمريكا الشمالية)",
 "oriental black mushroom": "شيتاكي (فطر شرق آسيوي صالح للأكل له قبعة ذهبية أو بنية داكنة إلى سوداء وساق غير صالح للأكل)",
 "oriental bush cherry": "كرز الشجيرة الشرقي, لوز مزهر (نبات شرقي خشبي بفاكهة حمراء ملساء غير مجعدة يزرع خاصة لأزهاره البيضاء أو الوردية الشاحبة)",
 "oriental cherry": "كرز شرقي, كرز ياباني (شجرة زينة بفاكهة غير صالحة للأكل تزرع على نطاق واسع في العديد من الأصناف لأزهارها البيضاء)",
 "oriental cockroach": "صرصور شرقي (صرصور بني داكن أصله من الشرق والآن عالمي الانتشار تقريباً)",
 "oriental dance": "رَقْص شَرْقِيّ (حركة الجسم بتنسيق موسيقي أو لحن، حيث يتحرك الشخص بشكل إيقاعي أو متناسق مع الموسيقى أو أنغام معينة؛ نشاط جسدي يتم على عادة أو تقليد، حيث يشارك الأفراد في الاحتفالات أو الفعاليات الاجتماعية)\nمثال: كنت تجيد الرقص.",
 "oriental garlic": "ثوم معمر صيني, كراث صيني (نبات من شرق آسيا؛ أكبر من الثوم المعمر)",
 "oriental mindoro": "أورينتال ميندورو",
 "oriental person": "شخص شرقي (عضو في عرق شرقي؛ يعتبر المصطلح مسيئاً من قبل الآسيويين (خاصة الآسيويين الأمريكيين))",
 "oriental plane": "دُلْب",
 "oriental poppy": "خشخاش مشرقي (خشخاش آسيوي معمر يزرع عادة ذو أوراق صلبة كثيفة الشعر وزهور قرمزية زاهية أو وردية إلى برتقالية)",
 "oriental republic of uruguay": "جمهورية الأوروغواي الشرقية"
}
