 "nonturbulent": "صَفْوِيّ, غَيْر مُضْطَرِب ((لسائل) غير متلاطم ولا مضطرب)",
 "nonuniform": "غَيْر مُتَجَانِس, غَيْر مُنْتَظِم (ليس متجانساً؛ غير موحَّد في التركيب)",
 "nonuniformity": "تَبَايُن, عَدَم انْتِظَام (صفة التنوع وإثارة الاهتمام)",
 "nonunion": "غير نقابي (لا ينتمي إلى أو لا يسمح بالانتساب لنقابة عمالية)\nمثال: نجارون غير نقابيين",
 "nonunionised": "غَيْرُ مُنَظَّم نِقَابِيًّا (غير منتسب إلى نقابة عمالية)",
 "nonunionized": "غَيْرُ مُنَظَّم نِقَابِيًّا (غير منتسب إلى نقابة عمالية)",
 "nonuple": "تُسَاعِيّ (ذو تسع وحدات أو مكوّنات)",
 "nonvascular organism": "كائن لا وعائي (كائنات بدون نسيج وعائي: مثل الطحالب والأشنات والفطريات والحزازيات)",
 "nonvascular plant": "نبات طحلبي, نبات لا وعائي (أي من النباتات العديدة من قسم النباتات الطحلبيه)",
 "nonvenomous": "غَيْرُ مُفْرِز لِلسُّمّ (لا يفرز سمًّا أو يُنتجه)",
 "nonverbal": "إِيمَائِيّ, غَيْرُ لَفْظِيّ (مُتعلّق بالتواصل غير اللفظيّ كالإشارات والإيماءات) / غَيْرُ لَفْظِيّ (لا يعتمد كثيرًا على استخدام اللغة المنطوقة) / ضَعِيفُ المَلَكَةِ اللُّغَوِيَّة (يفتقر إلى المهارة اللغوية اللفظية)",
 "nonverbal intelligence": "ذكاء غير لفظي (الذكاء الذي يظهر في أداء المهام التي تتطلب استخدامًا قليلًا أو معدومًا للغة)",
 "nonverbally": "بدون كلام, غير لفظي (بدون استخدام الكلمات)\nمثال: تواصلوا غير لفظياً",
