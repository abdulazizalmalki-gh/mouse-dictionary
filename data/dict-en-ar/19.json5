 "old world flycatcher": "صائد الذباب (العالم القديم) (أي من مجموعة كبيرة من الطيور المغردة الصغيرة التي تتغذى على الحشرات التي يتم اصطيادها أثناء الطيران)",
 "old world hop hornbeam": "ممران شجرة الجنجل (ممران شجرة الجنجل متوسط الحجم من جنوب أوروبا وآسيا الصغرى)",
 "old world jay": "قيق العالم القديم (قيق أوروبي)",
 "old world least weasel": "ابن عرس صغير (من أوروبا)",
 "old world leishmaniasis": "حبة حلب, ليشمانيا جلدية (ليشمانيا تصيب الجلد؛ تتميز بآفات جلدية تقرحية)",
 "old world mistletoe": "دبق أبيض, هدال (شجيرة طفيلية من العالم القديم لها سيقان مخضرة متفرعة بأوراق جلدية وتوت أبيض شمعي لزج؛ الهدال التقليدي لعيد الميلاد)",
 "old world monkey": "قرد العالم القديم (من أفريقيا أو الجزيرة العربية أو آسيا؛ له ذيول غير قابضة وفتحتا أنف متقاربتان)",
 "old world oriole": "صفارية (طائر مغرد استوائي غالباً؛ الذكر عادة ما يكون برتقالياً زاهياً وأسود)",
 "old world porcupine": "شيهم العالم القديم (شيهم أرضي)",
 "old world quail": "سمان العالم القديم (طائر صيد صغير ذو جسم مستدير وذيل صغير)",
 "old world rabbit": "أرنب أوروبي, أرنب العالم القديم (حيوان حفار بني رمادي شائع موطنه جنوب أوروبا وشمال أفريقيا ولكن تم إدخاله في أماكن أخرى؛ مستأنس على نطاق واسع ومطور بألوان مختلفة ولاحتياجات مختلفة؛…)",
 "old world robin": "أبو الحناء (طائر مغرد صغير من العالم القديم ذو صدر محمر)",
 "old world scops owl": "بومة سكوبس الأوروبية (بومة سكوبس أوروبية)",
 "old world vulture": "نسر (العالم القديم) (أي من النسور الكبيرة المتعددة في أفريقيا وأوراسيا)",
 "old world warbler": "هازجة العالم القديم (طيور صغيرة نشطة بنية أو رمادية من العالم القديم)",
 "old world white pelican": "بجع أبيض كبير (يشبه البجع الأبيض الأمريكي)",
 "old world yew": "طقسوس إنجليزي, طقسوس توتي (الطقسوس السائد في أوروبا؛ طويل العمر بشكل استثنائي وبطيء النمو؛ أحد أقدم الأنواع في العالم)",
 "old-age insurance": "تأمين الشيخوخة (تأمين يُدفع لكبار السن)",
 "old-age pension": "صندوق التقاعد, معاش التقاعد (دفعة شهرية تُقدم لشخص تقاعد عن العمل)",
 "old-age pensioner": "صاحب معاش الشيخوخة (شخص مسن يتلقى معاش الشيخوخة)",
 "old-fashioned": "عَفَا عَلَيْه الزَّمَن, قَدِيم الطِّرَاز (خَارِج المُوضَة وَلَمْ يَعُدْ رَائِجًا)",
 "old-fashionedness": "طراز قديم (خاصية كون الشيء لم يعد على الموضة)",
 "old-field toadflax": "كتانية زرقاء (نبات من أمريكا الشمالية له عناقيد من الزهور الزرقاء البنفسجية)",
 "old-hat": "مُبْتَذَل, مُسْتَهْلَك (مُكرَّر أكثر من اللازم؛ مألوف بشكل مفرط بسبب كثرة الاستخدام)",
 "old-line": "ذُو تَارِيخ طَوِيل, عَرِيق (قائم ومؤسّس منذ زمن طويل) / تَقْلِيدِيّ (يتمسّك بمبادئ محافظة أو رجعية)",
 "old-maid's bonnet": "ترمس بري, ترمس معمر (نبات معمر قوي من شرق ووسط أمريكا الشمالية له أوراق كفية وزهور زرقاء عنقودية مبهرجة)",
 "old-maidish": "مُتَزَمِّت, وَسْوَاسِيّ (شَدِيد التَّدْقِيق بِشَكْلٍ مُتَزَمِّت)",
 "old-man-of-the-woods": "رجل الغابة العجوز (فطر صالح للأكل معتدل الطعم يوجد في الغابات الصنوبرية في شرق أمريكا الشمالية)",
 "old-time": "تُرَاثِيّ السَّحْر, عَتِيق الطِّرَاز (قَدِيم الطِّرَاز بِشَكْلٍ جَذَّاب (لَكِنْ لَيْسَ بِالضَّرُورَة أَصِيل))",
 "old-timer": "عجوز, مخضرم / محارب قديم, مخضرم (شخص ذو خبرة مر بالعديد من المعارك؛ أو شخص قدم خدمة طويلة)",
 "old-womanish": "مُتَزَمِّت, وَسْوَاسِيّ (شَدِيد التَّدْقِيق بِشَكْلٍ مُتَزَمِّت)",
 "old-world": "عَتِيقُ الطِّرَاز (يَتَّسِمُ بِخَصَائِصِ العُصُورِ المَاضِيَةِ خَاصَّةً فِي أُورُوبَّا)",
 "olde worlde": "تُرَاثِيّ السَّحْر, عَتِيق الطِّرَاز (قَدِيم الطِّرَاز بِشَكْلٍ جَذَّاب (لَكِنْ لَيْسَ بِالضَّرُورَة أَصِيل))",
 "olden": "غَابِر, قَدِيم (يَتَعَلَّقُ بِزَمَنٍ بَعِيدٍ مَضَى)",
 "older": "قَدِيم, مُخَضْرَم (ماهر من خلال خبرة طويلة) / طَاعِن فِي السِّنّ, مُسِنّ (متقدّم في العمر) / الأَبّ, الأَكْبَر (يُستخدم للأكبر سنًّا من شخصين يحملان الاسم ذاته؛ خاصة لتمييز الأب عن ابنه)",
 "older brother": "اَلْأَخ اَلْأَكْبَر",
 "older sister": "الْأُخْت الْكُبْرَى, الشَّقِيقَة الْكُبْرَى",
 "oldie": "أغنية قديمة (أغنية كانت مشهورة سابقاً)",
 "oldish": "كَبِير نَوْعًا مَا (مسنّ إلى حدّ ما)",
 "oldline": "ذُو تَارِيخ طَوِيل, عَرِيق (قائم ومؤسّس منذ زمن طويل) / تَقْلِيدِيّ (يتمسّك بمبادئ محافظة أو رجعية)",
 "oldness": "شيخوخة, قدم (جودة كون الشيء قديماً؛ عكس الجدة) / شيخوخة, كبر (عكس الصغر)",
 "oldster": "عجوز, كبير السن (شخص متقدم في السن)",
 "oldtimer": "عجوز, مخضرم / محارب قديم, مخضرم (شخص ذو خبرة مر بالعديد من المعارك؛ أو شخص قدم خدمة طويلة)",
 "oldwench": "سمكة الزناد الملكة (سمكة أطلسية استوائية)",
 "oldwife": "بط طويل الذيل (بط بحري طويل الذيل شائع في الأجزاء الشمالية من الولايات المتحدة) / سمكة الزناد الملكة (سمكة أطلسية استوائية)",
 "olea cunninghamii": "مايري أسود (شجرة من شمال نيوزيلندا لها خشب بني فاتح صلب كثيف)",
 "olea europaea": "زيتون, شجرة الزيتون الأوروبية (شجرة دائمة الخضرة تزرع في منطقة البحر الأبيض المتوسط منذ العصور القديمة والآن في أماكن أخرى؛ لها ثمار سوداء لامعة صالحة للأكل)",
 "olea lanceolata": "مايري أبيض (شجرة نيوزيلندية صغيرة لها فاكهة لبية حمراء ذات بذرة واحدة)",
 "oleaceous": "زيتوني (مكون من أو يخص أو مميز لأشجار أو شجيرات الفصيلة الزيتونية)",
 "oleaginous": "دَهِن, زَيْتِيّ (يَحْتَوِي عَلَى كَمِّيَّة غَيْر عَادِيَّة مِنَ الشَّحْم أَوِ الزَّيْت) / لَزِج, مُتَمَلِّق بِكَرَاهَة (مُبَالِغ فِي اللُّطْف بِشَكْل مُنَفِّر وَبَغِيض)",
 "oleaginousness": "تملق, مداهنة (الجدية المفتعلة المليئة بالرضا عن الذات والتملق لخدمة المصالح الشخصية) / دهنية, زيتية (يتكون من الزيت أو مغطى به)",
 "oleander": "دِفْلَى",
 "oleander fern": "سرخس الدفلى (سرخس استوائي له سعف جلدي يشبه الدفلى؛ يوجد من آسيا إلى بولينيزيا)",
 "oleandra mollis": "سرخس الدفلى (سرخس استوائي له سعف جلدي يشبه الدفلى؛ يوجد من آسيا إلى بولينيزيا)",
 "oleandra neriiformis": "سرخس الدفلى (سرخس استوائي له سعف جلدي يشبه الدفلى؛ يوجد من آسيا إلى بولينيزيا)",
 "olearia argophylla": "خشب المسك (شجيرة أو شجرة برائحة المسك من جنوب وجنوب شرق أستراليا لها رؤوس زهور صفراء كريمية)",
 "olearia haastii": "شجيرة الأقحوان النيوزيلندية (شجيرة نيوزيلندية كثيفة تُزرع لرؤوس أزهارها البيضاء العطرة)",
 "oleaster": "زَيْزَفُون / خِلَاف",
 "olecranon": "نَاتِئ مِرْفَقِيّ, طَرَف الْمِرْفَق",
 "olecranon process": "زج, نتوء مرفقي (نتوء الزند الذي يشكل الحدبة الخارجية للمرفق ويتناسب مع حفرة عظم العضد عند تمديد الذراع)",
 "oled": "صمام ثنائي عضوي باعث للضوء (صمام ثنائي ذاتي الإضاءة (يتوهج عند تطبيق مجال كهربائي على الأقطاب) لا يتطلب إضاءة خلفية أو ناشرات)",
 "olefin": "ألكين, أوليفين (أي هيدروكربون أليفاتي غير مشبع)",
 "olefine": "ألكين, أوليفين (أي هيدروكربون أليفاتي غير مشبع)",
 "oleic acid": "حمض الأوليك (سائل زيتي عديم اللون يحدث كغليسريد؛ هو الحمض الدهني الرئيسي في زيت الزيتون وزيت الكانولا؛ يُستخدم في صنع الصابون ومستحضرات التجميل والمراهم وزيوت…)",
 "olein": "أولين, تريولين (غليسريد يحدث طبيعياً لحمض الأوليك ويوجد في الدهون والزيوت)",
 "oleo": "زبدة نباتية, مارجرين (دهن مصنوع أساساً من الزيوت النباتية ويستخدم كبديل للزبدة)",
 "oleo oil": "زيت الأوليو (يتم الحصول عليه من دهن البقر؛ يُستخدم في صنع المارجرين والصابون وفي التشحيم)",
 "oleography": "أوليوجرافيا (فن أو عملية إنتاج مطبوعات حجرية ملونة على القماش لتقليد الرسم الزيتي)\nمثال: كانت الأوليوجرافيا تقنية تستخدم للطباعة الملونة عالية الجودة على نطاق واسع",
 "oleomargarine": "زبدة نباتية, مارجرين (دهن مصنوع أساساً من الزيوت النباتية ويستخدم كبديل للزبدة)",
 "oleophilic": "أليف للزيت, أوليوفيلي (لديه ألفة قوية للزيوت بدلاً من الماء)",
 "oleophobic": "أوليوفوبي, كاره للزيت (يفتقر إلى الألفة مع الزيوت)",
 "oleoresin": "راتنج زيتي (خليط طبيعي من الراتنج والزيت العطري؛ يُستخرج من بعض النباتات)",
 "oleoresin capsicum": "راتنج الفلفل (راتنج زيتي مستخرج من نبات الفلفل)",
 "olfaction": "شَمّ ((شَمَّ) البناءُ أو الجبلُ يَشُمُّ شَمَمًا: ارتفَعَ أعلاهُ؛ (شَمَّ) الأنفُ: ارتفعت قَصَبَتُهُ قليلاً في استواء)\nمثال: شم باقة الزهور.",
 "olfactive": "شمي (مكون من أو متعلق بحاسة الشم)",
 "olfactology": "علم الشم (الدراسة العلمية للروائح أو لحاسة الشم)",
 "olfactory": "شمي (مكون من أو متعلق بحاسة الشم)",
 "olfactory brain": "دماغ شمي (مركز في نصفي الكرة المخية يحكم حاسة الشم في الحيوانات الدنيا؛ وفي البشر يبدو أنه يتوسط السلوك العاطفي المعقد)",
 "olfactory bulb": "بصلة شمية (أحد تضخمين عند نهاية العصب الشمي عند قاعدة الدماغ فوق تجاويف الأنف مباشرة)",
 "olfactory impairment": "خلل الشم, عسر الشم (اضطراب في حاسة الشم)",
 "olfactory modality": "حاسة الشم, شم (الملكة التي تمكننا من تمييز الروائح)",
 "olfactory nerve": "عصب شمي, عصب قحفي أول (مصطلح جماعي للعديد من الخيوط الشمية في الغشاء المخاطي للأنف)",
 "olfactory organ": "أنف (عضو الشم ومدخل الجهاز التنفسي؛ الجزء البارز من وجه الإنسان أو الثدييات الأخرى)\nمثال: لديه زكام في الأنف",
 "olfactory perception": "رائحة, شم (الإحساس الناتج عن تحفيز المستقبلات الشمية في الأنف بواسطة مواد كيميائية معينة في شكل غازي)\nمثال: أحبت رائحة الورود",
 "olfactory property": "أريج, رائحة (أي خاصية تكتشف بواسطة الجهاز الشمي)",
 "olfactory sensation": "رائحة, شم (الإحساس الناتج عن تحفيز المستقبلات الشمية في الأنف بواسطة مواد كيميائية معينة في شكل غازي)\nمثال: أحبت رائحة الورود",
 "olfersia cervina": "أولفيرسيا, لسان الأيل (سرخس أرضي أمريكي استوائي بسعف رمحي جلدي؛ يوضع أحياناً في جنس بوليبوتريا)",
 "olibanum": "بخور, لبان (راتنج صمغي عطري يتم الحصول عليه من أشجار عربية أو شرق أفريقية مختلفة؛ كان يُقدر سابقاً للعبادة وللتحنيط والتبخير)",
 "oligarch": "أوليغارشي, حاكم أقلية (أحد الحكام في نظام حكم الأقلية)",
 "oligarchic": "أوليغارشي, حكم القلة (مكون من أو متعلق بـ أو داعم أو مميز لحكم القلة (الأوليغارشية))",
 "oligarchical": "أوليغارشي, حكم القلة (مكون من أو متعلق بـ أو داعم أو مميز لحكم القلة (الأوليغارشية))",
 "oligarchy": "أُولِيغَارْكِي",
 "oligo": "قليل النيوكليوتيد (عديد نيوكليوتيد تحتوي جزيئاته على عدد قليل نسبياً من النيوكليوتيدات)",
 "oligochaete": "قليلات الأشواك (ديدان حلقية خنثوية برية ومائية لها شعيرات محمولة بشكل فردي على طول الجسم)",
 "oligochaete worm": "قليلات الأشواك (ديدان حلقية خنثوية برية ومائية لها شعيرات محمولة بشكل فردي على طول الجسم)",
 "oligoclase": "أوليغوكلاز, بلاجيوكلاز (أي من سلسلة الفلسبارات ثلاثية الميل التي تشكل الصخور)",
 "oligodactyly": "نقص الأصابع (حالة خلقية تكون فيها بعض أصابع اليدين أو القدمين مفقودة)",
 "oligodendria": "خلايا دبقية قليلة التغصن (نسيج يتكون من خلايا دبقية ذات عمليات تشبه الأوراق تشكل غمد المايلين للألياف العصبية)",
 "oligodendrocyte": "خلية دبقية قليلة التغصن (خلية من خلايا الدبق العصبي قليلة التغصن)",
 "oligodendroglia": "خلايا دبقية قليلة التغصن (نسيج يتكون من خلايا دبقية ذات عمليات تشبه الأوراق تشكل غمد المايلين للألياف العصبية)",
 "oligodontia": "نقص الأسنان (حالة خلقية تكون فيها بعض الأسنان مفقودة)",
 "oligolecty": "قِلَّة الجَمْع",
 "oligomenorrhea": "قلة الطمث (حيض خفيف أو غير متكرر بشكل غير طبيعي)",
 "oligonucleotide": "قليل النيوكليوتيد (عديد نيوكليوتيد تحتوي جزيئاته على عدد قليل نسبياً من النيوكليوتيدات)",
 "oligopoly": "احتكار القلة",
 "oligoporus leucospongia": "أوليجوبوروس ليوكوسبونجيا (فطر مسامي بقبعة قطنية ناعمة بيضاء يوجد على جذوع الصنوبريات في الغابات على ارتفاعات عالية في غرب الولايات المتحدة وكندا المجاورة)",
 "oligosaccharide": "سكريات قليلة التعدد, قليل السكاريد (أي من الكربوهيدرات التي تنتج عددًا قليلًا فقط من جزيئات السكر الأحادي عند التحلل المائي الكامل)",
 "oligospermia": "قلة الحيوانات المنوية, قلة النطاف (عدم كفاية الحيوانات المنوية في السائل المنوي)",
 "oliguria": "قلة البول (إنتاج كمية صغيرة بشكل غير طبيعي من البول) / شح البول, قلة البول (انتاج كمية صغيرة بشكل غير طبيعي من البول؛ يمكن أن يكون عرضاً لمرض الكلى أو انسداد المسالك البولية أو الوذمة أو عدم توازن السوائل والإلكتروليتات في…)",
 "olive": "زَيْتُون (نوع من الشَجَر له ثمر حبّ صغير أسود أو أخضر يُعصر منه الزَيْت؛ ثمر شجر الزيتون، الحب الصغير أسود كان أو أخصر) / زَيْتُونِيّ, زَيْتِيّ\nمثال: هي تشرب زيت الزيتون.",
 "olive branch": "غُصْن الزَيْتُون / غُصْن الزَّيْتُون",
 "olive brown": "بني زيتوني (درجة من البني مشوبة بالأخضر)",
 "olive drab": "قماش زيتوني (قماش ذو لون بني زيتوني يستخدم للزي العسكري) / زي أخضر زيتوني (زي عسكري للجيش الأمريكي؛ مصنوع من قماش بلون زيتوني باهت) / زيتوني باهت (بني زيتوني باهت رمادي أو مصفر)",
 "olive green": "أخضر زيتوني (لون أفتح وأكثر خضرة من الزيتوني)",
 "olive oil": "زَيْت زَيْتُون (ما يعصر من الزَيْتُون؛ كل سائل لزج يستخرد من النبات يستخدم كما يستخدم السمن)\nمثال: خبأن ذلك الزيت.",
 "olive ridley": "لجأة المحيط الهادئ, لجأة زيتونية (سلحفاة بحرية زيتونية اللون تعيش في المحيط الهادئ الاستوائي والمحيط الهندي وجنوب المحيط الأطلسي)",
 "olive tree": "زَيْتُون, زَيْتُونَة (نوع من الشَجَر له ثمر حبّ صغير أسود أو أخضر يُعصر منه الزَيْت؛ ثمر شجر الزيتون، الحب الصغير أسود كان أو أخصر)\nمثال: هي تشرب زيت الزيتون.",
 "olive-brown": "بُنِّيّ زَيْتُونِيّ (بني مع مسحة خضراء زيتونية)",
 "olive-colored": "زَيْتُونِيّ اللَّوْن (ذو لون الزيتون الأخضر)",
 "olive-coloured": "زَيْتُونِيّ اللَّوْن (ذو لون الزيتون الأخضر)",
 "olive-drab": "أَخْضَر زَيْتُونِيّ بَاهِت (بلون أخضر بني فاتح)",
 "olive-drab uniform": "زي أخضر زيتوني (زي عسكري للجيش الأمريكي؛ مصنوع من قماش بلون زيتوني باهت)",
 "olive-gray": "رَمَادِيّ زَيْتُونِيّ (رمادي مع مسحة زيتونية)",
 "olive-green": "أخضر زيتوني (لون أفتح وأكثر خضرة من الزيتوني)",
 "olive-grey": "رَمَادِيّ زَيْتُونِيّ (رمادي مع مسحة زيتونية)",
 "olive-like": "زَيْتُونِيُّ الشَّكْلِ (يشبه حبّة الزيتون في شكله)",
 "olive-sized": "بِحَجْم الزَّيْتُونَة (تقريباً بحجم حبّة الزيتون)",
 "olive-tree agaric": "غاريقون شجرة الزيتون (فطر أحمر مضيء في أوروبا)",
 "olivelike": "زَيْتُونِيُّ الشَّكْلِ (يشبه حبّة الزيتون في شكله)",
 "olivenite": "أوليفينيت (معدن نادر أخضر إلى أسود يتكون من زرنيخات النحاس المائية يوجد في رواسب النحاس)",
 "oliver": "أَوْلِيفَر, أَوْلِيڤَر",
 "olivine": "أوليفين, زبرجد زيتوني (معدن يتكون من سيليكات المغنيسيوم والحديد؛ مصدر للمغنيسيوم)",
 "olla": "أولا (ورقة أو شريط من ورقة نخيل التاليبوت تستخدم في الهند كورق للكتابة)",
 "olla podrida": "أويا بودريدا, برغو إسباني (نسخة إسبانية من يخنة البرغو)",
 "ollari": "أولاري (لغة درافيدية يتم التحدث بها في جنوب وسط الهند، ولا سيما في أوديشا)",
 "ollari language": "أولاري (لغة درافيدية يتم التحدث بها في جنوب وسط الهند، ولا سيما في أوديشا)",
 "olm": "أولم, سمندل الكهوف (سمندل مائي أوروبي بخياشيم خارجية دائمة يعيش في الكهوف)",
 "olmec": "أولمك (فرد من حضارة أمريكا الوسطى المبكرة التي تمركزت حول فيراكروز وازدهرت بين 1300 و 400 قبل الميلاد)",
 "ology": "علم, مبحث (كلمة غير رسمية (مستخلصة من الكلمات التي تنتهي بهذه اللاحقة) لأي فرع غير محدد من المعرفة)",
 "olsztyn": "أولشتين",
 "olympiad": "أُولِمْبْيَاد / أُولِمْبِيَّة",
 "olympian": "فَائِق, هَائِل (يتجاوز بكثير ما هو معتاد في الحجم أو الدرجة) / جَلِيل, مَهِيب (مهيب في الأسلوب أو الهيئة؛ يسمو فوق الأمور الدنيوية) / أوليمبي (من أو متعلق بكبار آلهة اليونان القديمة الذين كان مسكنهم جبل أوليمبوس) / أولمبي (من منطقة أولمبيا في اليونان أو سكانها)\nمثال: آلهة أوليمبية",
 "olympian games": "الألعاب الأولمبية القديمة, الأولمبياد (الاحتفال الهيليني القديم في أولمبيا تكريماً لزيوس؛ كان يقام كل 4 سنوات بدءاً من 776 قبل الميلاد)",
 "olympian zeus": "زيوس الأولمبي (تمثال جالس لكبير آلهة الأساطير اليونانية القديمة صُنع لمعبد أولمبيا؛ كان ارتفاع التمثال 40 قدماً واستقر على قاعدة بارتفاع 12 قدماً)",
 "olympic": "أُولِمْبِيّ",
 "olympic games": "أَلْعَاب أُولِمْبِيَّة, أُولِمْبِيَّة",
 "olympic salamander": "سمندل أولمبي (سمندل شبه مائي صغير واسع العينين من شمال غرب الولايات المتحدة)",
 "olympics": "أُولِمْبِيَّة",
 "olympism": "الأولمبية (روح أو مُثل الألعاب الأولمبية)\nمثال: وفقاً لمبادئ الأولمبية، فإن ممارسة الرياضة هي حق من حقوق الإنسان",
 "olympus": "أُولِيمْبُوس",
 "oléron": "أُولِيرُون",
 "om ali": "أُمّ عَلِيّ (الوَالِدَة أو الجَدَّة، وقد يطلق على والدة الزوج مجازا؛ أمّ بالرضاعة: المرأة التي أرضعت الطِفْل صغيرا فتصبح كوالدته)\nمثال: هل ستأتي أم لا؟",
 "omaha": "لغة أوماها (لهجة دهيجيا التي يتحدث بها شعب أوماها) / أوماها (فرد من الشعب السيوي الذي عاش سابقاً في وادي نهر ميسوري في شمال شرق نبراسكا)",
 "oman": "عُمَان (دولة في جنوب غرب آسيا؛ اسمها الرسمي سلطنة عمان، وعاصمتها مَسْقَط)\nمثال: تعيش لينة في عمان.",
 "omani": "عُمَانِيّ, عُمَانِيَّة",
 "omani monetary unit": "وحدة نقدية عمانية (الوحدة النقدية في عمان)",
 "omani rial": "ريال, ريال عماني (وحدة المال الأساسية في عمان)",
 "omar": "عُمَر ((في الإسلام) أبو حفص عمر بن الخطاب العدوي القرشي، ثاني الخلفاء الراشدين في المذهب السني)\nمثال: جون في عمر أخي.",
 "omasum": "أُمّ التَلَافِيف (الوَالِدَة أو الجَدَّة، وقد يطلق على والدة الزوج مجازا؛ أمّ بالرضاعة: المرأة التي أرضعت الطِفْل صغيرا فتصبح كوالدته)\nمثال: هل ستأتي أم لا؟",
 "omayyad": "أمويون, الدولة الأموية (السلالة الأولى من الخلفاء العرب وكانت عاصمتهم دمشق)",
 "omb": "مكتب الإدارة والميزانية (الوكالة التنفيذية التي تقدم المشورة للرئيس بشأن الميزانية الفيدرالية)",
 "ombu": "أومبو (شجرة عشبية سريعة النمو دائمة الخضرة من أمريكا الجنوبية ذات جذع عريض بمحتوى مائي عالٍ وأوراق بيضاوية خضراء داكنة)",
 "ombudsman": "أَمِين اَلْمَظَالِم (من يتولى رقابة شيء أو المحافظة عليه؛ مُطْمَئِنّ)\nمثال: هو غبي وغير أمين.",
 "ombudsperson": "أمين المظالم (معين حكومي يحقق في شكاوى الأفراد ضد الحكومة)",
 "ombudswoman": "أمينة مظالم (مسؤولة حكومية أنثى تحقق في شكاوى الأفراد ضد الحكومة)",
 "omega": "أُومِيغَا, أُومِيجَا",
 "omega-3": "أحماض أوميغا 3 الدهنية (حمض دهني متعدد غير مشبع تحتوي سلسلة الكربون الخاصة به على رابطة تكافؤ مزدوجة أولى عند ذرة الكربون الثالثة من البداية)",
 "omega-3 fatty acid": "أحماض أوميغا 3 الدهنية (حمض دهني متعدد غير مشبع تحتوي سلسلة الكربون الخاصة به على رابطة تكافؤ مزدوجة أولى عند ذرة الكربون الثالثة من البداية)",
 "omega-6": "أحماض أوميغا 6 الدهنية (حمض دهني متعدد غير مشبع تحتوي سلسلة الكربون الخاصة به على رابطة تكافؤ مزدوجة أولى عند ذرة الكربون السادسة من البداية)",
 "omega-6 fatty acid": "أحماض أوميغا 6 الدهنية (حمض دهني متعدد غير مشبع تحتوي سلسلة الكربون الخاصة به على رابطة تكافؤ مزدوجة أولى عند ذرة الكربون السادسة من البداية)",
 "omelet": "أومليت, عجة (بيض مخفوق أو خليط بيض مطبوخ حتى يتماسك؛ قد يُطوى حول لحم مقدد أو جبن أو جيلي)",
 "omelet pan": "مقلاة أومليت (مقلاة لطهي الأومليت)",
 "omelette": "عُجَّة, عِجَّة",
 "omelette pan": "مقلاة أومليت (مقلاة لطهي الأومليت)",
 "omen": "فَأل, نَذِيْر",
 "omental bursa": "تجويف بريتوني أصغر, جراب ثربي (جزء معزول من التجويف البريتوني يقع ظهرياً بالنسبة للمعدة)",
 "omentum": "ثرب (طية من الصفاق تدعم الأحشاء)",
 "omeprazole": "أوميبرازول, بريلوسيك",
 "omerta": "أوميرتا, قانون الصمت (قانون الصمت الذي تمارسه المافيا؛ رفض تقديم أدلة للشرطة حول الأنشطة الإجرامية)",
 "omertà": "أُومِيرْتَا",
 "omicron": "أُومِيكْرُون",
 "ominous": "مَشْؤُوم, نَذِير شُؤْم (ينذر بسوء الحظ والطالع) / مُتَوَعِّد, مُنْذِر بِالشَّرّ (يهدد أو ينذر بتطورات شريرة أو مأساوية)",
 "ominously": "بِشُؤْم, بِنُذُر الشَّرّ (بطريقة تنذر بالسوء)\nمثال: أظلمت الشمس بنذر الشؤم",
 "ominousness": "شؤم, نذير شر (جودة إعطاء مؤشر على شر قادم؛ كون الشيء نذير شؤم أو مهدداً)",
 "omissible": "قَابِل لِلْحَذْف, يُمْكِن إِغْفَالُه (يمكن الاستغناء عنه أو حذفه)",
 "omission": "إِغْفَال",
 "omissive": "إغفالي, تقصيري (يتميز بالحذف أو الإغفال)\nمثال: جرائم الامتناع (التقصيرية)",
 "ommastrephes": "حبار طائر (حبار أسطواني نشط للغاية بأذرع قصيرة قوية وزعانف طرفية كبيرة معينية الشكل)",
 "ommatidium": "عوينة (أي من العيون الصغيرة المخروطية الشكل التي تشكل العيون المركبة لبعض المفصليات)",
 "ommiad": "أمويون, الدولة الأموية (السلالة الأولى من الخلفاء العرب وكانت عاصمتهم دمشق)",
 "omnibus": "أوتوبيس, باص (مركبة تحمل العديد من الركاب؛ تستخدم للنقل العام) / مجلد جامع (أنثولوجيا لمقالات حول موضوع ذي صلة أو أنثولوجيا لأعمال مؤلف واحد)\nمثال: كان دائماً يركب الحافلة للعمل",
 "omnidirectional": "شامل الاتجاهات, متعدد الاتجاهات (ليس اتجاهياً (يغطي كل الاتجاهات))\nمثال: هوائي شامل الاتجاهات",
 "omnidirectional antenna": "هوائي متعدد الاتجاهات (هوائي يرسل أو يستقبل الإشارات بالتساوي في جميع الاتجاهات)",
 "omnidirectional radio range": "المدى متعدد الاتجاهات (نظام ملاحي يتكون من شبكة من المنارات اللاسلكية التي تزود الطائرات بمعلومات حول الموقع الدقيق والاتجاه)",
 "omnidirectional range": "المدى متعدد الاتجاهات (نظام ملاحي يتكون من شبكة من المنارات اللاسلكية التي تزود الطائرات بمعلومات حول الموقع الدقيق والاتجاه)",
 "omnifarious": "شَامِل, مِنْ كُلِّ صِنْف (مِنْ جَمِيعِ الأَنْوَاعِ أَوِ الأَشْكَالِ أَوِ الأَصْنَاف)",
 "omnipotence": "قدرة مطلقة (حالة القدرة على كل شيء؛ امتلاك قوة غير محدودة)",
 "omnipotent": "عَلَى كُلِّ شَيْءٍ قَدِيرٌ (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال.",
 "omnipresence": "وجود في كل مكان, وجود كلي (حالة الوجود في كل مكان في آن واحد (أو ما يبدو كذلك))",
 "omnipresent": "كُلِّيّ الوُجُود, مَوْجُود فِي كُلّ مَكَان (حاضر في كل مكان في آنٍ واحد)",
 "omnirange": "المدى متعدد الاتجاهات (نظام ملاحي يتكون من شبكة من المنارات اللاسلكية التي تزود الطائرات بمعلومات حول الموقع الدقيق والاتجاه)",
 "omniscience": "إحاطة بكل شيء, علم مطلق (حالة العلم بكل شيء؛ امتلاك معرفة لا نهائية)",
 "omniscient": "بِكُلِّ شَيْءٍ عَلِيمٌ (بَكَلَه: خَلَطَه؛ بَكَلَ عَلَيْنَا حَديثَه وأَمْرَه: خَلَطَهُ وجاءَ بِهِ عَلَى غَيْرِ وَجْهِهِ)\nمثال: غادرنا بكل بساطة.",
 "omnium-gatherum": "أخلاط, أشياء متنوعة (تشكيلة مختلطة من الأشياء)",
 "omnivore": "حَيَوَان قَارِت, حَيَوَان كَالِش (بمعنى أصبح له حياة؛ الحَيَاة. والحَيَوَان أبلغ من الحَيَاة؛ جنس الحَيّ الذي يأكل وينمو ويتحرك بالإرادة وبه حِسّ بخلاف ما به حياة فقط دون الحس مثل النَبَات. بعض العامة تقول حَيْوَان وهو غلط)\nمثال: هذا حيوان أليف.",
 "omnivorous": "قَارِت, كَالِش",
 "omnivorousness": "تغذية شاملة, قارتية (حالة أكل كل من المواد الحيوانية والنباتية)\nمثال: إنها ليست المخلوقات الوحيدة التي ستلجأ إلى هذا، ولكن بالتأكيد قارتيتها هي التي تجعلها دورية قمامة مذهلة",
 "omophagia": "أكل اللحم النيئ (تناول الطعام النيئ)",
 "omotic": "الأوموتية (مجموعة من اللغات ذات الصلة يتم التحدث بها في وادي جنوب إثيوبيا؛ وثيقة الصلة باللغات الكوشية)",
 "omphalocele": "فتق سري (بروز الأمعاء والثروب عبر فتق في جدار البطن بالقرب من السرة)",
 "omphalos": "سُرة, سُرة البطن (ندبة حيث كان الحبل السري متصلاً)\nمثال: لم يكن من المفترض أن تظهر سرتك على التلفزيون",
 "omphaloskepsis": "تأمل الذات المفرط (حرفياً، تأمل السرة، وهو مصطلح يعني عادة الاستغراق في الذات برضا)",
 "omphalotus illudens": "فطر المصباح, فطر جاك أو لانترن (غاريقون سام كبير بقبعات برتقالية وسيقان ضيقة متجمعة؛ الخياشيم مضيئة)",
 "omphalus": "سُرة, سُرة البطن (ندبة حيث كان الحبل السري متصلاً)\nمثال: لم يكن من المفترض أن تظهر سرتك على التلفزيون",
 "omsk": "أُومْسْك",
 "on": "عَلَى (يفيد الاستعلاء؛ يفيد التعليل) / فِي (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة) / عَلَى حِسَابِهِ (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال.",
 "on a higher floor": "أعلى الدرج, في الطابق العلوي (في طابق أعلى)\nمثال: عاشوا في الطابق العلوي",
 "on a lower floor": "أسفل الدرج, في الطابق السفلي (في طابق أدنى)\nمثال: المستأجرون يعيشون في الطابق السفلي",
 "on a regular basis": "بانتظام, بصفة منتظمة (بأسلوب منتظم ومتكرر)\nمثال: كانت الرسائل تصل بانتظام من أطفاله",
 "on account of": "بِسَبَب, لِأَن",
 "on air": "عَلَى الْمُبَاشِرِ (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال.",
 "on all fours": "حبواً, على أطرافه الأربعة (على اليدين والركبتين)\nمثال: نزل على أطرافه الأربعة",
 "on an empty stomach": "عَلَى ٱلرِّيقِ (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال.",
 "on an individual basis": "بشكل فردي, على حدة (بمعزل عن الآخرين)\nمثال: إذا أخذناها بشكل فردي، الغرف كانت مربعة",
 "on an irregular basis": "بشكل غير منتظم, بشكل متقطع (بطريقة غير ثابتة، ليس وفق معدل أو جدول ثابت)\nمثال: كانت رسائلها تصل بشكل متقطع",
 "on and off": "أحياناً, بشكل متقطع (ليس بانتظام)\nمثال: يهاتفان بعضهما بشكل متقطع",
 "on approval": "تحت الاختبار, للتجربة (للفحص (مع خيار الشراء))\nمثال: أخذوا الجهاز للتجربة",
 "on average": "بالمعدل, في المتوسط (بشكل نموذجي)\nمثال: يشاهد في المتوسط ثلاثة أفلام أسبوعياً",
 "on behalf of": "بِاسْم, بِالنِّيَابَة عَن",
 "on board": "عَلَى مَتْن (على سفينة أو قطار أو طائرة أو مركبة أخرى)",
 "on camera": "أثناء التصوير, أمام الكاميرا (ضمن نطاق كاميرا فيلم أو تلفزيون)\nمثال: لم يدرك السيناتور أنه كان يتحدث أمام الكاميرا",
 "on earth": "بحق السماء, في الدنيا (تستخدم مع كلمات الاستفهام للتعبير عن الدهشة)\nمثال: ما الذي تفعله بحق السماء؟",
 "on faith": "بالثقة, ثقةً (بثقة واطمئنان)\nمثال: قبلناه ثقةً",
 "on fleek": "حَسَن المَظْهَر, وَسِيم (ممتع المظهر خاصة بسبب التناسق مع مُثُل الشكل والتناسب)",
 "on foot": "مَاشِيًا",
 "on guard": "عَلَى حَذَر, مُتَيَقِّظ (في حالة انتباه ويقظة واحتراس)",
 "on it": "على ذلك, عليه\nمثال: النص والتعليق عليه (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال.",
 "on occasion": "أحياناً, بين الحين والآخر (بشكل متقطع وغير متكرر)\nمثال: كان متغطرساً وقاسياً أحياناً",
 "on offer": "مُتَوَفِّر",
 "on one hand": "من جهة, من ناحية (من وجهة نظر واحدة)\nمثال: من ناحية، هي كيميائية موهوبة",
 "on one's coattails": "على أعقاب, مستفيداً من (يتبع مباشرة أو يستفيد بشكل غير مستحق من)\nمثال: استقال المدير التنفيذي على أعقاب الفضيحة",
 "on one's own": "بِمُفْرَدِي",
 "on paper": "على الورق, نظرياً (في النظرية؛ وفقاً للحقائق المفترضة) / عَلَى الوَرَق, نَظَرِيًّا (كما هو مكتوب أو مطبوع)\nمثال: على الورق يبدو المرشح واعداً",
 "on purpose": "عَمْدًا",
 "on request": "رهن الطلب, عند الطلب (بمناسبة الطلب)\nمثال: كانت النصيحة مجانية عند الطلب",
 "on that": "على ذلك, عليه\nمثال: النص والتعليق عليه (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال.",
 "on the average": "بالمعدل, في المتوسط (بشكل نموذجي)\nمثال: يشاهد في المتوسط ثلاثة أفلام أسبوعياً",
 "on the button": "بالضبط, تماماً (تماماً كما ينبغي أن يكون) / فِي الصَّمِيم, مُطَابِق تَمَامًا (دقيق تماماً وفقاً لمعيار محدد أو مقرر)\nمثال: قال: بالضبط يا سيدي",
 "on the coattails": "على أعقاب, مستفيداً من (يتبع مباشرة أو يستفيد بشكل غير مستحق من)\nمثال: استقال المدير التنفيذي على أعقاب الفضيحة",
 "on the contrary": "عَلَى الْعَكْس, بِالْعَكْس (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال.",
 "on the dot": "تَماماً",
 "on the face of it": "عَلَى مَا يَبْدُوْ, لِأَوَّلِ وَهْلَةٍ (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال.",
 "on the fly": "أثناء الركض, على عجل (أثناء الركض أو في عجلة من أمره) / أثناء الطيران, في الهواء (أثناء الحركة)\nمثال: كتبت تلك الرسائل على عجل",
 "on the nose": "بالضبط, تماماً (تماماً كما ينبغي أن يكون) / فِي الصَّمِيم, مُطَابِق تَمَامًا (دقيق تماماً وفقاً لمعيار محدد أو مقرر)\nمثال: قال: بالضبط يا سيدي",
 "on the one hand": "من جهة, من ناحية (من وجهة نظر واحدة)\nمثال: من ناحية، هي كيميائية موهوبة",
 "on the other hand": "من ناحية أخرى, من جهة أخرى (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "on the point of": "عَلَى وَشٰك (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال.",
 "on the q.t.": "سراً, في الخفاء (بسرية؛ ليس علناً)\nمثال: التقوا سراً",
 "on the qt": "سراً, في الخفاء (بسرية؛ ليس علناً)\nمثال: التقوا سراً",
 "on the qui vive": "تأهب, تنبه (انتباه حيوي)",
 "on the road": "على الطريق, في جولة (التجوال في الأرجاء)\nمثال: أخذوا العرض في جولة",
 "on the side": "بِشَكْل غَيْر رَسْمِيّ (بدون موافقة رسمية)\nمثال: كسب بعض المال بشكل جانبي",
 "on the sly": "خلسة, سراً (بطريقة خفية)\nمثال: كان الجنود يزحفون خلسة عبر الليل",
 "on the spot": "فوراً, في الحال (دون تأخير أو حالاً) / في الموقع, في عين المكان (في المكان المعني؛ هناك) / في مأزق, في موقف محرج (في موقف صعب)\nمثال: وظفناها في الحال",
 "on the spur of the moment": "بغتة, على حين غرة (بسرعة وبدون سابق إنذار)\nمثال: توقف فجأة",
 "on the table": "قَابِلٌ لِلتَّفَاوُض, مَطْرُوحٌ لِلنِّقَاش (يُمْكِنُ التَّفَاوُضُ بِشَأْنِهِ أَوْ تَسْوِيَتُهُ بِالتَّوَافُقِ)",
 "on the way": "فِي الطَّرِيق (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "on the whole": "بشكل عام, في الإجمال (مع أخذ كل شيء في الاعتبار)\nمثال: في الإجمال، أنا آسف لما حدث",
 "on the wing": "أثناء الطيران, محلقاً (يطير في الهواء)\nمثال: رأينا البط أثناء الطيران",
 "on time": "عَلَى الْمَوْعَدِ (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال.",
 "on top of": "عِلَاوَةً عَلَى",
 "on tour": "على الطريق, في جولة (التجوال في الأرجاء)\nمثال: أخذوا العرض في جولة",
 "on trial": "تَحْتَ التَّجْرِبَة, قَيْدَ الاِخْتِبَار (في طَوْر الاختبار أو التجريب)",
 "on your guard": "عَلَى حَذَر, مُتَيَقِّظ (في حالة انتباه ويقظة واحتراس)",
 "on your mark, get set, go": "اِسْتَعِد، جَاهِز، اِنْطَلِق! (اِسْتَعَدَّ للامْتِحانِ بِجِدٍّ: حَضَّرَ لَه؛ يَسْتَعِدُّ لِلْمُبَارَاةِ: يَتَهَيَّأُ لَهَا)\nمثال: استعد سامي للرحيل.",
 "on-going": "دَائِر, مُسْتَمِرّ (يحدث الآن بشكل مستمر)",
 "on-key": "صَحيح, مَضْبوط النَّغْمَة (مُوافِق لِلدَّرَجَة المُوسيقِيَّة الصَّحيحَة)",
 "on-license": "رخصة استهلاك في المكان (رخصة لبيع الخمور للاستهلاك في المبنى)",
 "on-line": "أونلاين, على الشبكة (متصل بشبكة كمبيوتر أو يمكن الوصول إليه عبر الكمبيوتر) / ضمن المسار, على الخط (على مسار منتظم لنظام سكة حديد أو حافلة أو طيران)\nمثال: قاعدة بيانات متصلة",
 "on-line database": "قاعدة بيانات إلكترونية, قاعدة بيانات حاسوبية ((علوم الكمبيوتر) قاعدة بيانات يمكن الوصول إليها بواسطة أجهزة الكمبيوتر)",
 "on-off switch": "مفتاح تبديل, مفتاح قلاب (مفتاح مفصلي يمكن أن يتخذ أحد وضعين)",
 "on-site": "في الموقع, ميداني (يحدث أو يقع في الموقع نفسه)\nمثال: تفتيش ميداني",
 "on-street": "جانبي, في الشارع (على جوانب الشوارع)\nمثال: ممنوع وقوف السيارات في الشارع في ساعة الذروة",
 "on-the-job": "أثناء العمل, وظيفي (متعلق بـ أو مرتبط بوظيفة أو توظيف)\nمثال: تدريب أثناء العمل",
 "on/off switch": "مفتاح تبديل, مفتاح قلاب (مفتاح مفصلي يمكن أن يتخذ أحد وضعين)",
 "onager": "أَخْدَر, عَيْر (أَخْدَرَ (العُضوَ) إخدارًا: جعله خَدِرًا؛ أَخْدَرَ (بالمكان): أقام به)",
 "onanism": "الجماع المقطوع, العزل (طريقة لتحديد النسل يتم فيها بدء الجماع ولكن يتم سحب القضيب عمداً قبل القذف) / استمناء, عادة سرية (التحفيز اليدوي للأعضاء التناسلية (للنفس أو لآخر) للمتعة الجنسية)",
 "onanist": "مُسْتَمْنٍ (شخص يمارس الاستمناء (العادة السرية))",
 "once": "مَرَّةً, مَرَّةً وَاحِدَةً (مؤنث مُرّ، صفة ما كان بها مرارة) / بِمُجَرَّد أَنّ\nمثال: كم من مرة ذهبت؟",
 "once again": "مَرَّة أُخْرَى (مؤنث مُرّ، صفة ما كان بها مرارة)\nمثال: كم من مرة ذهبت؟",
 "once and for all": "إِلَى الأَبَد (حرف جر يُفيد الغاية الزمنية؛ حرف جر يُفيد الغاية المكانية)\nمثال: تعال إلى منزلي.",
 "once in a while": "أحياناً, بين الحين والآخر (بشكل متقطع وغير متكرر)\nمثال: كان متغطرساً وقاسياً أحياناً",
 "once more": "ثانية, مجدداً\nمثال: حاولت مرة أخرى (وحدة زمنية تعادل جزءًا من ستين جزءًا من الدقيقة)\nمثال: لن أفعلها ثانية.",
 "once upon a time": "كَان يَامَا كَان (اِتَّصَفَ. (فعل ناقص)؛ حَدَثَ)\nمثال: كان الكلب ميتا.",
 "once-over": "فحص سريع, نظرة سريعة (فحص أو تفتيش سريع وعابر)\nمثال: ألقيت عليه نظرة سريعة",
 "onchocerciasis": "داء كلابية الذنب, عمى نهري (الإصابة بديدان خيطية رفيعة (فيلاريا) تودع تحت الجلد عن طريق لدغة الذباب الأسود؛ عندما تصاب العين، يمكن أن يؤدي ذلك إلى العمى؛ شائع في أفريقيا وأمريكا…)",
 "oncidium": "أوركيد السيدة الراقصة, أونسيديوم (أي أوركيد من جنس أونسيديوم: يتميز برشاشات متفرعة نحيلة من زهور صفراء وبنية صغيرة؛ تزرع غالباً كنباتات منزلية)",
 "oncidium papilio": "أونسيديوم بابيليو, سحلب الفراشة",
 "oncidium papilio kramerianum": "سيكوبسيس كراميريانا",
 "oncogene": "جين ورمي, مسرطن (جين يهيئ الخلايا الطبيعية للتحول إلى خلايا ورمية سرطانية)",
 "oncologic": "ورمي (متعلق بعلم الأورام أو ممارسته)\nمثال: ممرضة أورام",
 "oncological": "ورمي (متعلق بعلم الأورام أو ممارسته)\nمثال: ممرضة أورام",
 "oncologist": "أخصائي أورام (أخصائي في علم الأورام)",
 "oncology": "عِلْم اَلْأَوْرَام (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "oncoming": "قَادِم, مُقْبِل (يتحرك باتجاه المرء؛ قادم نحوه) / بداية, مستهل (البداية أو المراحل المبكرة)\nمثال: بداية الالتهاب الرئوي",
 "oncorhynchus keta": "سلمون الكيتا (سلمون كبير من المحيط الهادئ ذو بقع صغيرة على ظهره؛ سمكة طعام مهمة)",
 "oncorhynchus kisutch": "سلمون فضي, سلمون كوهو (سلمون صغير من سواحل شمال المحيط الهادئ والبحيرات العظمى)",
 "oncorhynchus nerka": "سلمون أحمر, سلمون سوكي (سلمون صغير ذو لحم أحمر؛ يوجد في الأنهار وروافد شمال المحيط الهادئ ويُقدر كطعام؛ يموت البالغون بعد وضع البيض)",
 "oncorhynchus tshawytscha": "سلمون شينوك, سلمون ملكي (سلمون كبير من المحيط الهادئ يُقدر كطعام؛ يموت البالغون بعد وضع البيض)",
 "oncotic": "جِرْمِيّ",
 "oncovin": "أونكوفين, فينكريستين (مشتق نبات العناقية يستخدم كدواء مضاد للأورام (الاسم التجاري أونكوفين)؛ يستخدم لعلاج سرطان الجهاز الليمفاوي)",
 "ondatra zibethica": "فأر المسك, مسك (قارض مائي يشبه القندس من أمريكا الشمالية ذو فراء بني لامع داكن)",
 "one": "وَاحِد, وَاحِدَة (في وَ: العدد واحد العدد الاول) / اَلْمَرْء\nمثال: رأيت واحدة مرة.",
