 "occupational": "وَظِيفِيّ, مِهَنِيّ",
 "occupational disease": "مرض مهني (مرض أو إعاقة ناتجة عن ظروف العمل)",
 "occupational group": "مجموعة مهنية, مهنة (مجموعة من الناس يقومون بنفس نوع العمل)",
 "occupational hazard": "مخاطر مهنية (أي حالة في الوظيفة يمكن أن تؤدي إلى مرض أو إصابة)",
 "occupational safety and health act": "قانون السلامة والصحة المهنية (قانون أقره الكونغرس الأمريكي أنشأ إدارة السلامة والصحة المهنية لمنع الموظفين من الإصابة أو التعرض للأمراض أثناء عملهم)",
 "occupational safety and health administration": "إدارة السلامة والصحة المهنية (وكالة حكومية في وزارة العمل للحفاظ على بيئة عمل آمنة وصحية)",
 "occupational therapy": "علاج بالعمل, علاج وظيفي (علاج يعتمد على المشاركة في أنشطة ذات مغزى من الحياة اليومية، لتمكين المشاركة في مثل هذه الأنشطة على الرغم من القصور أو القيود في الوظائف الجسدية أو…)",
 "occupied": "مَحْجُوز / مَشْغُول / مُحْتَلّ",
 "occupier": "مُحْتَلّ",
 "occupy": "اِحْتَلَّ (الموضعَ: نزل به وكان لغيره قبله؛ الجيشُ البلدَ: فتحها ثم نزل بها غصبا عن أهلها وبلا رضاهم، استولى عليها)",
 "occur": "حَدَثَ, وَقَعَ (وَقَعَ الأمر؛ نقيض قَدُمَ، كان حَدِيثا)\nمثال: لا أصدق ما حدث.",
 "occurrence": "حُدُوث",
 "occurrent": "حَاصِل, وَاقِع (يحدث حالياً (سواء سببياً أو عرضياً)) / حَدَث طَبِيعِيّ, حُدُوث (حدث يقع بشكل طبيعيّ)",
 "ocean": "مُحِيط, قَامُوس (في : هو الخط المستدير الذي يُحيط بالشكل الهندسي؛ في : البَحْر المُحِيْط هو البحر الكبير الذي يحيط بالقارات. الاستخدام الحديث يحذف كلمة بَحْر؛ القَامُوْس)\nمثال: أسبح في المحيط.",
 "ocean bottom": "قاع البحر, قاع المحيط (الجزء السفلي من بحر أو محيط)",
 "ocean current": "تيار محيطي (التدفق المستمر لمياه المحيط السطحية في اتجاه سائد)",
 "ocean floor": "قاع البحر, قاع المحيط (الجزء السفلي من بحر أو محيط)",
 "ocean liner": "باخرة ركاب, سفينة رحلات (سفينة تجارية كبيرة (خاصة تلك التي تنقل الركاب وفق جدول منتظم))",
 "ocean perch": "سمكة الورد, فرخ المحيط (سمكة كبيرة في سواحل شمال المحيط الأطلسي لأمريكا وأوروبا) / سمك أحمر, سمك الصخر (سمك الصخر من شمال الأطلسي)",
 "ocean pout": "إيل بوت المحيط (شائعة على طول الساحل الشمالي الشرقي لأمريكا الشمالية)",
 "ocean sunfish": "سمكة شمس المحيط, مولا (من بين أكبر الأسماك العظمية؛ سمكة تعيش في عرض البحر ذات جسم بيضاوي مضغوط وزعانف ظهرية وشرجية عالية وزعنفة ذيلية مختزلة إلى فص يشبه الدفة؛ توجد…)",
 "ocean trip": "رحلة بحرية (فعل السفر عن طريق الماء)",
 "oceanaut": "غواص أعماق, ملاح مائي (عامل ماهر يمكنه العيش في منشآت تحت الماء والمشاركة في البحث العلمي)",
 "oceanfront": "واجهة المحيط (الأرض المتاخمة للمحيط)",
 "oceangoing": "بَحْرِيّ, عَابِر المُحِيطَات (يُستخدم في أعالي البحار)",
 "oceania": "أُوقِيَانُوسِيَا",
 "oceanic": "مُحِيطِيّ",
 "oceanic abyss": "أخدود محيطي, خندق محيطي (منخفض طويل شديد الانحدار في قاع المحيط)",
 "oceanic bird": "طائر محيطي (طائر البحار المفتوحة)",
 "oceanic bonito": "بونيتو, بونيتو المحيط (سمكة يُجفف لحمها ويُقطع لرقائق للطبخ الياباني؛ قد تكون نفس نوع التونة الوثابة)",
 "oceanic whitetip shark": "قرش أبيض الطرف, قرش محيطي أبيض الطرف (قرش كبير يعيش في المياه العميقة ذو زعنفة ظهرية بيضاء الطرف؛ واسع الانتشار عالمياً؛ يعتبر أخطر أنواع القرش)",
 "oceanid": "أوقيانيد ((الأساطير اليونانية) حورية بحر كانت ابنة لأوقيانوس وتيثيس)",
 "oceanites oceanicus": "دجاجة الأم كاري (طائر نوء عاصفة متوسط الحجم)",
 "oceanographer": "عالم محيطات (عالم يدرس الجوانب الفيزيائية والبيولوجية للبحار)",
 "oceanography": "علم المحيطات (فرع العلم الذي يتعامل مع الجوانب الفيزيائية والبيولوجية للمحيطات)",
 "oceanology": "علم المحيطات (فرع العلم الذي يتعامل مع الجوانب الفيزيائية والبيولوجية للمحيطات)",
 "ocellated": "عيني الشكل, متبقع (يحتوي على بقع تشبه العيون (عيينات))",
 "ocellated turkey": "ديك رومي ذو عيينة (ديك رومي بري من أمريكا الوسطى وشمال أمريكا الجنوبية)",
 "ocellus": "بقعة عينية (علامة تشبه العين (كما في أجنحة بعض الفراشات)؛ عادة ما تكون بقعة ملونة داخل حلقة بلون آخر) / عين بسيطة, عيينة (عين لها عدسة واحدة)",
 "ocelot": "أصلوت (قط بري ليلي يعيش في أمريكا الوسطى والجنوبية ذو معطف بني مصفر مرقط بالداكن)",
 "ocher": "مَغْرِيّ اللَّوْن (بلون برتقالي مصفر معتدل كلون المغرة) / أصفر ترابي, مغرة (لون أصفر برتقالي متوسط إلى برتقالي) / مغرة (أي من الأتربة المختلفة المحتوية على السيليكا والألومينا وأكسيد الحديديك؛ تستخدم كصبغة)",
 "ochlocracy": "حكم الغوغاء (نظام سياسي تكون فيه الغوغاء مصدر السيطرة؛ حكم الجماهير)",
 "ochna serrulata": "أوشنا, شجيرة عين الطائر (شجيرة ذات أوراق دائمة الخضرة بيضاوية ضيقة لامعة وأزهار صفراء بسبلات جلدية تشبه البتلات)",
 "ochotona collaris": "بيكا مطوقة (تشبه البيكا الأمريكية وقد تكون من نفس النوع)",
 "ochotona princeps": "بيكا أمريكية (بيكا من أمريكا الشمالية)",
 "ochre": "مَغْرِيّ اللَّوْن (بلون برتقالي مصفر معتدل كلون المغرة) / أصفر ترابي, مغرة (لون أصفر برتقالي متوسط إلى برتقالي) / مغرة (أي من الأتربة المختلفة المحتوية على السيليكا والألومينا وأكسيد الحديديك؛ تستخدم كصبغة)",
 "ochroma lagopus": "أخروما, بلسا (شجرة غابات في الأراضي المنخفضة بأمريكا الوسطى لها خشب قوي وخفيف جداً؛ يستخدم لصنع العوامات والطوافات وفي الحرف اليدوية)",
 "ochronosis": "تمغر (تراكم صبغة داكنة في الغضاريف والأنسجة الضامة الأخرى؛ عادة ما يكون عرضاً للبيلة الكابتونية أو التسمم بالفينول)",
 "ocimum basilicum": "حبق, ريحان (نبات حولي أو معمر من آسيا الاستوائية له سنابل من الزهور البيضاء الصغيرة وأوراق عطرية؛ أحد أهم أعشاب الطهي؛ يستخدم في السلطات والأطعمة والصلصات وبعض…)",
 "ockham's razor": "مبدأ الإيجاز, نصل أوكام (المبدأ القائل بأنه لا ينبغي مضاعفة الكيانات دون داع؛ يجب تفضيل أبسط النظريتين المتنافستين)",
 "oconee bells": "أجراس أوكوني (نبات في جنوب شرق الولايات المتحدة ذو زهور بيضاء وحيدة على شكل قمع مشوبة بالوردي وأوراق خضراء لامعة كبيرة تتحول إلى البرونزي الأحمر في الخريف)",
 "ocotillo": "أوكوتيلو, سوط المدرب (شجيرة صحراوية من جنوب غرب الولايات المتحدة والمكسيك لها فروع شائكة عارية رفيعة تخرج أوراقاً وعناقيد من الزهور الحمراء بعد موسم الأمطار)",
 "oct": "أكتوبر, تشرين الأول (الشهر الذي يلي سبتمبر ويسبق نوفمبر)",
 "octad": "ثَمَانِيَة, ثُمَانِيّ (العدد الأصلي الذي هو مجموع سبعة وواحد)",
 "octadecanoic acid": "حمض الستياريك (حمض دهني شمعي مشبع؛ يحدث على نطاق واسع كغليسريد في الدهون الحيوانية والنباتية)",
 "octagon": "مثمن",
 "octagonal": "ثماني الزوايا, مثمن (متعلق بالمثمن أو يشبهه)",
