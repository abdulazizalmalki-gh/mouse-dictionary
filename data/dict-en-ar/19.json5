 "normotensive": "طبيعي ضغط الدم (لديه ضغط دم طبيعي)",
 "normothermia": "اعتدال الحرارة, حرارة طبيعية (درجة حرارة الجسم الطبيعية)",
 "norn": "نورن ((الأساطير الإسكندنافية) أي من إلهات القدر الثلاث؛ تتماهى مع ويرد الأنجلوساكسونية؛ تشبه المويراي اليونانية والباركاي الرومانية)",
 "norse": "نرويجي (من أو يتعلق بالنرويج أو شعبها أو ثقافتها أو لغتها) / إسكندنافي, نورسي (من أو يتعلق بإسكندنافيا أو شعوبها أو ثقافاتها) / الجرمانية الشمالية, اللغات الإسكندنافية (العائلة الشمالية من اللغات الجرمانية التي يتم التحدث بها في الدول الإسكندنافية وأيسلندا) / نرويجي (مواطن أو ساكن في النرويج)\nمثال: الرنجة النرويجية",
 "norse deity": "إله إسكندنافي (إله عبده الإسكندنافيون القدماء)",
 "norse mythology": "الأساطير الإسكندنافية (أساطير الدول الإسكندنافية (التي تشترك فيها جزئيًا بريطانيا وألمانيا) حتى تغلغل المسيحية)",
 "norseman": "نرويجي (مواطن أو ساكن ذكر في النرويج)",
 "norsewoman": "نرويجية (مواتنة أو ساكنة أنثى في النرويج)",
 "north": "شَمَال (الْجِهَةُ الْمُقَابِلَةُ لِلجَنُوب؛ رَأْسُ الْبَوْصَلَةِ الْمُقَابِلُ لِلجَنُوب) / شمال (الْجِهَةُ الْمُقَابِلَةُ لِلجَنُوب؛ رَأْسُ الْبَوْصَلَةِ الْمُقَابِلُ لِلجَنُوب)\nمثال: أعيش في شمال السويد.",
 "north africa": "شَمَال إِفْرِيقِيَا, شَمَال أَفْرِيقِيَا (الْجِهَةُ الْمُقَابِلَةُ لِلجَنُوب؛ رَأْسُ الْبَوْصَلَةِ الْمُقَابِلُ لِلجَنُوب)\nمثال: أعيش في شمال السويد.",
 "north african": "شمال أفريقي (من أو يتعلق بشمال أفريقيا)",
 "north america": "أَمْرِيكَا الشَّمَالِيَّة",
 "north american": "أمريكي شمالي (متعلق بقارة أمريكا الشمالية أو دولها أو شعوبها أو مميز لها) / أمريكي شمالي (مواطن أو ساكن في أمريكا الشمالية)",
 "north american country": "دولة أمريكية شمالية (أي دولة في قارة أمريكا الشمالية)",
 "north american free trade agreement": "اتفاقية التجارة الحرة لأمريكا الشمالية, نافتا (اتفاقية للتجارة الحرة بين الولايات المتحدة وكندا والمكسيك؛ أصبحت سارية المفعول في عام 1994 لمدة عشر سنوات)",
 "north american nation": "دولة أمريكية شمالية (أي دولة في قارة أمريكا الشمالية)",
 "north atlantic council": "مجلس شمال الأطلسي (مجلس يتكون من ممثلين دائمين لجميع الدول الأعضاء في الناتو؛ يتمتع بسلطة سياسية وصلاحيات اتخاذ القرار)",
 "north atlantic treaty organization": "مُنَظَّمَة حِلْف شَمَال اَلْأَطْلَسِيّ, اَلْحِلْف اَلْأَطْلَسِيّ",
 "north azerbaijan": "أَذَرْبَيْجَان الشَّمَالِيَّة",
 "north bay": "نورث بي",
 "north by east": "الشَّمَال المَائِل لِلشَّرْق, شَمَال لِشَرْق (نقطة البوصلة التي تقع شرق الشمال بنقطة واحدة)",
 "north by west": "الشَّمَال المَائِل لِلغَرْب, شَمَال لِغَرْب (نقطة البوصلة التي تقع غرب الشمال بنقطة واحدة)",
 "north carolina": "كَارُولَايْنَا اَلشَّمَالِيَّة",
 "north carolinian": "شمال كاروليني (مواطن أو مقيم في كارولينا الشمالية)",
 "north caucasus": "شَمَال اَلْقَوْقَاز (الْجِهَةُ الْمُقَابِلَةُ لِلجَنُوب؛ رَأْسُ الْبَوْصَلَةِ الْمُقَابِلُ لِلجَنُوب)\nمثال: أعيش في شمال السويد.",
 "north dakota": "دَاكُوتَا اَلشَّمَالِيَّة",
 "north dakotan": "شمال داكوتي (مواطن أو مقيم في داكوتا الشمالية)",
 "north dravidian": "درافيدية شمالية (لغة درافيدية يتم التحدث بها بشكل أساسي في شرق الهند)",
 "north dravidian language": "درافيدية شمالية (لغة درافيدية يتم التحدث بها بشكل أساسي في شرق الهند)",
 "north equatorial current": "التيار الاستوائي الشمالي (تيار استوائي يتدفق غرباً عبر المحيط الهادئ شمال خط الاستواء مباشرة)",
 "north germanic": "الجرمانية الشمالية, اللغات الإسكندنافية (العائلة الشمالية من اللغات الجرمانية التي يتم التحدث بها في الدول الإسكندنافية وأيسلندا)",
 "north germanic language": "الجرمانية الشمالية, اللغات الإسكندنافية (العائلة الشمالية من اللغات الجرمانية التي يتم التحدث بها في الدول الإسكندنافية وأيسلندا)",
 "north holland": "شمال هولندا, هولندا الشمالية (الْجِهَةُ الْمُقَابِلَةُ لِلجَنُوب؛ رَأْسُ الْبَوْصَلَةِ الْمُقَابِلُ لِلجَنُوب)\nمثال: أعيش في شمال السويد.",
 "north island": "الْجَزِيرَة الشَّمَالِيَّة",
 "north island edelweiss": "إديلويس الجزيرة الشمالية (عشب معمر يشبه إلى حد كبير الإديلويس الأوروبي؛ نيوزيلندا)",
 "north korea": "كُورِيَا الشَّمَالِيَّة (بلاد في جنوب شرق آسيا، يطلق عليها جغرافيا شِبْهُ الجَزِيْرَةِ الكُوْرِيَّة؛ دولتان تقعان في جنوب شرق آسيا تسميان كُوْرِيَا الشَمَالِيَّة وكُوْرِيَا الجَنُوْبِيَّة)\nمثال: أريد أن أزور كوريا.",
 "north korean": "كوري شمالي (من أو يتعلق بكوريا الشمالية أو شعبها أو ثقافتها أو يميزهم) / كوري شمالي (كوري من كوريا الشمالية)",
 "north korean monetary unit": "وحدة نقدية لكوريا الشمالية (الوحدة النقدية في كوريا الشمالية)",
 "north korean won": "وون, وون كوريا الشمالية (وحدة المال الأساسية في كوريا الشمالية)",
 "north levantine arabic": "اَللَّهْجَة الشَّمَالِيَّة",
 "north macedonia": "مَقِدُونِيَا الشَّمَالِيَّة",
 "north mesopotamian arabic": "لهجة موصلية (طَرَفُ ٱللِّسَانِ؛ جَرْسُ ٱلْكَلَامِ)\nمثال: الشاوية هي لهجة للأمازيغية.",
 "north northeast": "الشَّمَال الشَّمَالِيّ الشَّرْقِيّ, شَمَال شَمَال شَرْق (نقطة البوصلة التي تقع في منتصف المسافة بين الشمال والشمال الشرقي)",
 "north northwest": "الشَّمَال الشَّمَالِيّ الغَرْبِيّ, شَمَال شَمَال غَرْب (نقطة البوصلة التي تقع في منتصف المسافة بين الشمال والشمال الغربي)",
 "north pole": "اَلْقُطْب اَلشَّمَالِيّ",
 "north rhine-westphalia": "شَمَال اَلرَّايْن وِسْتْفَالِيَّا (الْجِهَةُ الْمُقَابِلَةُ لِلجَنُوب؛ رَأْسُ الْبَوْصَلَةِ الْمُقَابِلُ لِلجَنُوب)\nمثال: أعيش في شمال السويد.",
 "north sea": "بَحَر اَلشَّمَال (شَقّ الأرض؛ التَحَيُّر والبَهْت من الفزع أو من شدة العَطَش فنظر لا يقصد شيئا)\nمثال: هبطت على البحر.",
 "north side": "الجانب الشمالي (الجانب الذي يقع في الشمال)",
 "north vietnam": "فِيِتْنَام الشَّمَالِيَّة, فْيِتْنَام الشَّمَالِيَّة",
 "north vietnamese": "فيتنامي شمالي (مكون من أو متعلق بفيتنام الشمالية أو شعبها أو ثقافتها)",
 "north wind": "رياح شمالية (رياح تهب من الشمال)",
 "north yemen": "اليمن الشمالي (دولة عربية تقع في قارة آسيا؛ عاصمتها صَنْعَاء، واسمها الرسمي الجُمْهُورِيَّة الْيَمَنية)\nمثال: تعيش ليلى في اليمن.",
 "north yorkshire": "شمال يوركشاير (الْجِهَةُ الْمُقَابِلَةُ لِلجَنُوب؛ رَأْسُ الْبَوْصَلَةِ الْمُقَابِلُ لِلجَنُوب)\nمثال: أعيش في شمال السويد.",
 "north-central": "شَمَال أَوْسَط (يقع في الجزء الشمالي من منطقة وسطى جغرافيًّا) / شَمَال وَسَط أَمْرِيكِيّ (ينتمي إلى منطقة الشمال الأوسط من الولايات المتحدة)",
 "north-east": "باتجاه الشمال الشرقي (إلى أو باتجاه أو في الشمال الشرقي)",
 "north-northeast": "باتجاه الشمال الشمالي الشرقي (إلى أو باتجاه أو في الشمال الشمالي الشرقي)",
 "north-northwest": "باتجاه الشمال الشمالي الغربي (إلى أو باتجاه أو في الشمال الشمالي الغربي)",
 "north-polar": "أَرْكْتِيكِيّ, قُطْبِيّ شَمَالِيّ (من أو متعلق بالقطب الشمالي)",
 "north-seeking pole": "قطب شمالي, قطب مغناطيسي موجب (قطب المغناطيس الذي يشير نحو الشمال عند تعليق المغناطيس بحرية)",
 "north-south direction": "اتجاه شمال-جنوب (في اتجاه موازٍ لخطوط الطول)",
 "north-west": "باتجاه الشمال الغربي (إلى أو باتجاه أو في الشمال الغربي)",
 "northbound": "مُتَّجِه شَمَالًا (يتحرك باتجاه الشمال)",
 "northeast": "باتجاه الشمال الشرقي (إلى أو باتجاه أو في الشمال الشرقي) / شَمَال شَرْقِيّ (يقع في الشمال الشرقي أو موجَّه نحوه) / قَادِم مِنَ الشَّمَال الشَّرْقِيّ (قادم من اتجاه الشمال الشرقي) / شمال شرق (موقع في الجزء الشمالي الشرقي من بلد أو منطقة أو مدينة)",
 "northeast by east": "الشَّمَال الشَّرْقِيّ المَائِل لِلشَّرْق, شَمَال شَرْقِيّ لِشَرْق (نقطة البوصلة التي تقع شرق الشمال الشرقي بنقطة واحدة)",
 "northeast by north": "الشَّمَال الشَّرْقِيّ المَائِل لِلشَّمَال, شَمَال شَرْقِيّ لِشَمَال (نقطة البوصلة التي تقع شمال الشمال الشرقي بنقطة واحدة)",
 "northeaster": "عاصفة شمالية شرقية (عاصفة تهب من الشمال الشرقي)",
 "northeasterly": "شَمَال شَرْقِيّ (يقع في الشمال الشرقي أو موجَّه نحوه) / قَادِم مِنَ الشَّمَال الشَّرْقِيّ (قادم من اتجاه الشمال الشرقي)",
 "northeastern": "شَمَالِيٌّ شَرْقِيّ (من منطقة في الولايات المتحدة تشمل عموماً ولايات نيو إنجلاند ونيويورك) / شَمَال شَرْقِيّ (يقع في الشمال الشرقي أو موجَّه نحوه)",
 "northeastward": "باتجاه الشمال الشرقي (في اتجاه الشمال الشرقي) / بِاتِّجَاه الشَّمَال الشَّرْقِيّ (نحو الشمال الشرقي) / الشَّمَال الشَّرْقِيّ (نقطة البوصلة في منتصف المسافة بين الشمال والشرق؛ عند 45 درجة)\nمثال: يتدفق النهر باتجاه الشمال الشرقي نحو الخليج",
 "northeastwardly": "باتجاه الشمال الشرقي (في اتجاه الشمال الشرقي)\nمثال: يتدفق النهر باتجاه الشمال الشرقي نحو الخليج",
 "norther": "رياح شمالية (رياح تهب من الشمال)",
 "northerly": "شَمَالًا (في اتجاه الشمال) / شَمَالِيّ المَصْدَر (قادم من الشمال؛ يوصف به خاصة الرياح) / شَمَالِيّ الاتِّجَاه (موجَّه نحو الشمال) / رياح شمالية (رياح تهب من الشمال)\nمثال: يكسبون أكثر في الشمال",
 "northern": "شَمَالِيّ",
 "northern alliance": "التحالف الشمالي, الجبهة المتحدة (تحالف متعدد الأعراق في أفغانستان يمارسون شكلاً معتدلاً من الإسلام ومتحدون في معارضتهم لطالبان)",
 "northern baptist": "معمداني شمالي (عضو في الاتفاقية المعمدانية الأمريكية)",
 "northern baptist convention": "المؤتمر المعمداني الأمريكي, المؤتمر المعمداني الشمالي (رابطة المعمدانيين الشماليين)",
 "northern bedstraw": "جويسئة شمالية (نبات معمر ذو رئد من أمريكا الشمالية له زهور بيضاء؛ يستخدم أحياناً للزينة)",
 "northern beech fern": "سرخس الزان الشمالي, سرخس الزان الطويل (سرخس زان في أمريكا الشمالية وأوراسيا)",
 "northern bobwhite": "سمان بوبوايت الشمالي (طائر صيد مفضل في شرق ووسط الولايات المتحدة)",
 "northern bog lemming": "لاموس المستنقعات الشمالي (من المروج الألبية وشبه الألبية الرطبة في كندا وألاسكا)",
 "northern casque-headed frog": "ضفدع الشجر الحفار (ضفدع ليلي حفار أرضي من التضاريس العشبية وغابات الشجيرات له سطح علوي صلب جداً للرأس؛ من جنوب غرب الولايات المتحدة)",
 "northern cricket frog": "ضفدع الصرصور الشمالي (ضفدع صرصور من شرق ووسط الولايات المتحدة)",
 "northern cyprus": "قُبْرُص الشَّمَالِيَّة (دولة تحكمها جمهورية قبرص، وهي عضو من الاتحاد الأوروبي منذ 2004، ولكنها لا تسيطر على قبرص الشمالية منذ 1974…)\nمثال: كانت قبرص محمية بريطانية.",
 "northern dewberry": "ديوبيري شمالي",
 "northern dune tansy": "حشيشة الدود الشمالية (نبات معمر جذموري مشعر قليلاً له أوراق ريشية عطرية وسيقان تحمل عناقيد مفتوحة من الزهور الصفراء الصغيرة التي تشبه الأزرار؛ الكثبان الرملية لساحل المحيط…)",
 "northern europe": "أُورُوبَا الشَّمَالِيَّة (الجزء من يوراسيا الذي يقع غرب جبال الأورال، والمعتبر تقليديًّا قارة بحد ذاته، كما يقع شمال قارة إفريقيا، وغرب قارة آسيا، وشرق المحيط الأطلسي؛ كيان سياسي؛ الاتحاد الأوروبي)\nمثال: ذهبت إلى أوروبا مرة.",
 "northern flying squirrel": "سنجاب طائر شمالي (سنجاب طائر كبير؛ بشكل رئيسي من كندا)",
 "northern goshawk": "باز شمالي",
 "northern harrier": "مرزة الدجاج (مرزة شائعة في أمريكا الشمالية وأوروبا؛ تعشش في المستنقعات والأراضي المفتوحة)",
 "northern hemisphere": "نِصْف اَلْكُرَة الْأَرْضِيَّة الشَّمَالِيّ",
 "northern holly fern": "سرخس البهشية الشمالي (سرخس أوروبي دائم الخضرة يزرع على نطاق واسع)",
 "northern ireland": "أِيرْلَنْدَا الشَّمَالِيَّة (جزيرة تقع في شمال المحيط الأطلسي، تحدها جزيرة بريطانيا العظمى من الشرق؛ دولة في شمال غرب قارة أوروبا؛ اسمها الرسمي جمهورية أيرلندا، وعاصمتها دبلن)",
 "northern jacob's ladder": "سلم يعقوب الشمالي (عشب معمر منتصب بزهور بيضاء؛ حول القطب الشمالي)",
 "northern lights": "شفق قطبي ((شَفِقَ) منه، وعليه يَشْفَقَ شَفَقًا: خاف وحَذِرَ، فهو شَفِقٌ؛ (شَفِقَ) عليه: رَقَّ له وعطف عليه؛ فهو شَفِيقٌ)\nمثال: أثارت تلك السلحفاة شفقة زيري.",
 "northern lobster": "كركند أمريكي (كركند ساحل المحيط الأطلسي لأمريكا) / كركند أمريكي (لحم كركند المياه الباردة ذو المخالب الكبيرة الطرية؛ يصاد من ماين إلى كارولينا)",
 "northern mammoth": "ماموث شمالي, ماموث صوفي (ماموث كثيف الشعر كان شائعاً في المناطق الباردة من نصف الكرة الشمالي)",
 "northern mariana islands": "جزر ماريانا الشمالية (جَزَرَ الماءُ عن الأَرضِ يَجْزُرُ جَزْراً: نَضَبَ وحَسَرَ؛ ويقال: جَزَرَ البَحْرُ والنَّهْرُ: انْحسرَ ماؤُهُ)\nمثال: ضع الجزر في القدر.",
 "northern oak fern": "سرخس البلوط الشمالي, سرخس الحجر الجيري (سرخس أصفر مخضر في المناطق الصخرية في نصف الكرة الشمالي)",
 "northern oriole": "صفارية شمالية (نوع من صفاريات العالم الجديد)",
 "northern parula": "هازجة بارولا (هازجة غابات صغيرة رمادية زرقاء ذات حلق وصدر أصفر؛ من شرق أمريكا الشمالية)",
 "northern phalarope": "فلروب شمالي (يتكاثر في المناطق القطبية للعالم القديم والجديد؛ غالباً ما تُرى أسراب كبيرة بعيداً في البحر)",
 "northern pike": "كراكي شمالي (كراكي نهم آكل للأسماك يعيش في مياه نصف الكرة الشمالي)",
 "northern pin oak": "بلوط جاك, بلوط دبوسي شمالي (بلوط متساقط الأوراق صغير إلى متوسط من شرق وسط أمريكا الشمالية؛ الأوراق لها فصوص مدببة بحدة)",
 "northern pintail": "بلبول شمالي",
 "northern pitch pine": "صنوبر القار, صنوبر القار الشمالي (صنوبر كبير ثلاثي الإبر من شرق الولايات المتحدة وجنوب شرق كندا؛ وثيق الصلة بصنوبر البرك)",
 "northern pocket gopher": "غوفر جيبي شمالي (غوفر رمادي إلى بني يعيش في غرب ووسط الولايات المتحدة)",
 "northern porgy": "سكوب, مرجان شمالي (توجد في المياه الساحلية الأطلسية لأمريكا الشمالية من كارولينا الجنوبية إلى ماين؛ تُقدر كسمكة مقلاة)",
 "northern red oak": "بلوط أحمر, سنديان أحمر شمالي (شجرة نفضية كبيرة متناظرة ذات تاج مستدير تنتشر على نطاق واسع في شرق أمريكا الشمالية؛ لها أوراق كبيرة ذات فصوص مثلثة مدببة الأطراف وخشب خشن الحبيبات…)",
 "northern scup": "سكوب, مرجان شمالي (توجد في المياه الساحلية الأطلسية لأمريكا الشمالية من كارولينا الجنوبية إلى ماين؛ تُقدر كسمكة مقلاة)",
 "northern sea robin": "روبن البحر الشمالي (روبن بحر كبير؛ يوجد من نوفا سكوشا إلى فلوريدا)",
 "northern shrike": "صرد شمالي (طائر صرد من شمال أمريكا الشمالية)",
 "northern snakehead": "رأس الأفعى الشمالية (سمكة مياه عذبة شرهة موطنها شمال شرق الصين؛ يمكنها استخدام الزعانف للمشي ويمكنها البقاء على قيد الحياة خارج الماء لمدة ثلاثة أيام؛ تشكل تهديداً…)",
 "northern snow bedstraw": "جويسئة شمالية (نبات معمر ذو رئد من أمريكا الشمالية له زهور بيضاء؛ يستخدم أحياناً للزينة)",
 "northern spy": "تفاح نورثرن سباي (تفاح كبير متأخر النضج ذو قشرة مخططة بالأصفر والأحمر)",
 "northern storm petrel": "نوء العاصفة (طائر نوء أسود فحمي مع علامات بيضاء؛ يعيش في شمال المحيط الأطلسي والبحر الأبيض المتوسط)",
 "northern territory": "مُقَاطَعَة شَمَالِيَّة",
 "northern white cedar": "أرز أبيض شمالي, عفص غربي (شجرة دائمة الخضرة صغيرة من شرق أمريكا الشمالية لها أوراق صغيرة تشبه الحراشف على غصينات مسطحة)",
 "northern whiting": "بياض شمالي (سمكة بياض في الساحل الشرقي للولايات المتحدة؛ تشبه إلى حد كبير بياض الملك)",
 "northern woodsia": "وودسيا ألبية, وودسيا شمالية (سرخس نحيل في شمال أمريكا الشمالية بسويقات بلون الكستناء اللامع وسعف ثنائي الريش مع بثرات بوغية هامشية مميزة عادة)",
 "northerner": "شمالي (أحد سكان الشمال) / شمالي, يانكي (أمريكي يعيش في الشمال (خاصة خلال الحرب الأهلية الأمريكية))",
 "northernmost": "أَقْصَى الشَّمَال (يقع في أبعد نقطة شمالًا)",
 "northernness": "شَمَالِيَّة (خاصية الوجود باتجاه الشمال)",
 "northland": "الأراضي الشمالية, الشمال (أي منطقة تقع في الشمال أو باتجاهه)",
 "northman": "إسكندنافي, شمالي (ساكن ذكر في الدول الإسكندنافية)",
 "northmost": "أَقْصَى الشَّمَال (يقع في أبعد نقطة شمالًا)",
 "northward": "شَمَالًا (في اتجاه الشمال) / مُتَّجِه شَمَالًا (يتحرك باتجاه الشمال) / الشَّمَال (نقطة البوصلة الأصلية التي تكون عند 0 أو 360 درجة)\nمثال: يكسبون أكثر في الشمال",
 "northwards": "شَمَالًا (في اتجاه الشمال)\nمثال: يكسبون أكثر في الشمال",
 "northwest": "باتجاه الشمال الغربي (إلى أو باتجاه أو في الشمال الغربي) / شَمَال غَرْبِيّ (يقع في الشمال الغربي أو موجَّه نحوه) / قَادِم مِنَ الشَّمَال الغَرْبِيّ (قادم من اتجاه الشمال الغربي) / شمال غرب (موقع في الجزء الشمالي الغربي من بلد أو منطقة أو مدينة)",
 "northwest by north": "الشَّمَال الغَرْبِيّ المَائِل لِلشَّمَال, شَمَال غَرْبِيّ لِشَمَال (نقطة البوصلة التي تقع شمال الشمال الغربي بنقطة واحدة)",
 "northwest by west": "الشَّمَال الغَرْبِيّ المَائِل لِلغَرْب, شَمَال غَرْبِيّ لِغَرْب (نقطة البوصلة التي تقع غرب الشمال الغربي بنقطة واحدة)",
 "northwest wind": "رياح شمالية غربية (رياح تهب من الشمال الغربي)",
 "northwester": "رياح شمالية غربية (رياح تهب من الشمال الغربي)",
 "northwesterly": "شَمَال غَرْبِيّ (يقع في الشمال الغربي أو موجَّه نحوه) / قَادِم مِنَ الشَّمَال الغَرْبِيّ (قادم من اتجاه الشمال الغربي)",
 "northwestern": "شَمَالِيٌّ غَرْبِيّ (من منطقة في الولايات المتحدة تشمل عموماً واشنطن وأوريغون وآيداهو) / شَمَال غَرْبِيّ (يقع في الشمال الغربي أو موجَّه نحوه)",
 "northwestward": "باتجاه الشمال الغربي (في اتجاه الشمال الغربي) / بِاتِّجَاه الشَّمَال الغَرْبِيّ (نحو الشمال الغربي) / الشَّمَال الغَرْبِيّ (نقطة البوصلة في منتصف المسافة بين الشمال والغرب؛ عند 315 درجة)",
 "northwestwardly": "باتجاه الشمال الغربي (في اتجاه الشمال الغربي)",
 "northwoman": "إسكندنافية, شمالية (ساكنة أنثى في الدول الإسكندنافية)",
 "nortriptyline": "باميلور, نورتريبتيلين (دواء مضاد للاكتئاب ثلاثي الحلقات (الاسم التجاري باميلور) يستخدم مع العلاج النفسي لعلاج الاكتئاب الجزئي؛ قد يتفاعل بشكل خطير إذا تم تناوله مع أدوية…)",
 "noruz": "نوروز ((الفارسية) عطلة رأس السنة الجديدة في إيران وأذربيجان وأفغانستان وباكستان وأجزاء من الهند وبين الأكراد؛ تأتي في الاعتدال الربيعي)",
 "norvasc": "أملوديبين, نورفاسك (موسع للأوعية الدموية (الاسم التجاري نورفاسك) يؤخذ على شكل أقراص؛ يوصف لارتفاع ضغط الدم والذبحة الصدرية)",
 "norvir": "ريتونافير, نورفير (مثبط للبروتياز (الاسم التجاري نورفير) يستخدم في علاج فيروس نقص المناعة البشرية)",
 "norway": "النُّرْوِيج (دولة تغطي مساحتُها الشطرين الشمالي والغربي من شبه الجزيرة الإسكندنافية التي تقع في شمال قارة أوروبا؛ اسمها الرسمي مملكة النرويج، وعاصمتها أوسلو)\nمثال: أنا من النرويج.",
 "norway lobster": "كركند نرويجي (كركند أوروبي صالح للأكل يشبه الكركند الأمريكي ولكنه أكثر نحافة)",
 "norway maple": "قَيْقَب دُلْبِيّ",
 "norway rat": "جرذ بني, جرذ نرويجي (جرذ منزلي شائع؛ آفة خطيرة في جميع أنحاء العالم)",
 "norway spruce": "تنوب نرويجي (تنوب هرمي طويل موطنه شمال أوروبا له أوراق خضراء داكنة على فروع منتشرة بغصينات متدلية ومخاريط طويلة متدلية)",
 "norwegian": "نُرْوِيجِيَّة (مواطنة من بلد النرويج؛ لغة بلد النرويج. )\nمثال: أنا أحب النرويجية.",
 "norwegian elkhound": "كلب الأيل النرويجي (سلالة من الكلاب المدمجة متوسطة الحجم ذات فراء رمادي كثيف طورت في النرويج لصيد الأيائل)",
 "norwegian krone": "كرونة, كرونة نرويجية (وحدة المال الأساسية في النرويج)",
 "norwegian language": "اللغة النرويجية (لغة إسكندنافية يتم التحدث بها في النرويج)",
 "norwegian lobster": "لانغوستين (يصاد في المياه الأوروبية؛ أنحف من الكركند الأمريكي)",
 "norwegian monetary unit": "وحدة نقدية نرويجية (الوحدة النقدية في النرويج)",
 "norwegian sea": "بَحْر اَلنُّرْوِيج (شَقّ الأرض؛ التَحَيُّر والبَهْت من الفزع أو من شدة العَطَش فنظر لا يقصد شيئا)\nمثال: هبطت على البحر.",
 "norwich terrier": "نورويتش تيريير (سلالة إنجليزية من التيريير الصغير قصير الأرجل ذو فراء سلكي مستقيم أحمر أو رمادي أو أسود وأسمر وآذان منتصبة)",
 "nose": "أَنْف, خَشَم (أنف:اشْتَكَى أَنفه فَهُوَ مأنوف؛ أنف الشَّيْء: حدد طرفه)\nمثال: أنت لديك أنف كبير.",
 "nose candy": "بودرة, كوك (أسماء دارجة للكوكايين)",
 "nose cone": "مخروط الأنف (مقدمة تتكون من الرأس المخروطي لصاروخ يحمي الحمولة من الحرارة أثناء مرورها عبر الغلاف الجوي)",
 "nose count": "إحصاء السكان, تعداد سكاني (عد دوري للسكان)",
 "nose dive": "غوص, هبوط حاد (هبوط حاد بمقدمة الطائرة للأسفل)",
 "nose drops": "إتش, سم (أسماء دارجة للهيروين)",
 "nose flute": "ناي الأنف (ناي يتم العزف عليه بالنفخ من خلال فتحات الأنف)",
 "nose job": "تجميل الأنف (جراحة تجميلية لتحسين مظهر الأنف)",
 "nose ring": "بُرَة",
 "nosebag": "مِخْلَاة",
 "noseband": "رَسَن",
 "nosebleed": "رُعَاف",
 "nosecount": "إحصاء السكان, تعداد سكاني (عد دوري للسكان)",
 "nosed": "ذو أنف, مأنوف (له أنف (سواء بالمعنى الحرفي أو المجازي) خاصة من نوع محدد)",
 "nosedive": "غوص, هبوط حاد (هبوط حاد بمقدمة الطائرة للأسفل) / سقوط مدو, هبوط حاد (انخفاض حاد ومفاجئ أو تدهور سريع)\nمثال: شهد السهم هبوطاً حاداً",
 "nosegay": "باقة ورد (ترتيب للزهور يُعطى عادة كهدية)",
 "noseless": "أجذع, بلا أنف (ليس له أنف)",
 "nosepiece": "جسر النظارة (الرابط بين عدستين؛ يستقر على الأنف) / حزام الأنف (حزام يمثل جزءاً من اللجام يمر فوق أنف الحيوان) / واقي الأنف (درع صفيحي يحمي الأنف)",
 "nosewheel": "عجلة مقدمة الطائرة (عجلة تقع تحت مقدمة الطائرة وتعتبر جزءاً من معدات الهبوط)",
 "nosey": "مُتَطَفِّل, مُتَلَصِّص (فضولي بطريقة مُسِيئة ومتطفلة)",
 "nosey-parker": "حشري, فضولي (شخص يتدخل في شؤون الآخرين)",
 "nosh": "نوش ((اليديشية) وجبة خفيفة)",
 "nosh-up": "وجبة دسمة (وجبة كبيرة ومشبعة)",
 "nosher": "آكل الوجبات الخفيفة (شخص يأكل طعاماً خفيفاً أو وجبات خفيفة بين الوجبات الرئيسية)",
 "nosiness": "تطفل, حشرية (فضول مزعج وتدخل فيما لا يعنيك)",
 "nosocomial": "مستشفياتي, مشفوي (يحدث أو ينشأ في المستشفى)\nمثال: عدوى مكتسبة في المستشفى",
 "nosohusial": "منزلي صحي (يحدث فيما يتعلق أو يتم اكتسابه في ظل الرعاية الصحية المنزلية)\nمثال: عدوى منزلية صحية",
 "nosology": "علم التشخيص, علم تصنيف الأمراض (فرع العلوم الطبية المعني بتصنيف الأمراض)",
 "nostalgia": "حَنِين, اِشْتِيَاق",
 "nostalgic": "حَنِين, نُوسْتَالْجِيّ (حزين لبُعده عن الأماكن المألوفة ويشتاق إليها)",
 "nostalgically": "بحنين (بطريقة تحن للماضي)\nمثال: قضيا ساعة معاً، يتحدثان بحنين وهما يتجولان ببطء على الطريق الساحلي",
 "nostoc": "نوستوك (يوجد في الأماكن الرطبة كمستعمرات هلامية مستديرة)",
 "nostradamus": "نُوسْتْرَادَامُوس",
 "nostril": "مَنْخَر",
 "nostrum": "دواء مشكوك فيه (دواء مسجل براءة اختراع فعاليته موضع شك) / ترياق عام, دواء لكل داء (علاج افتراضي لجميع العلل أو الأمراض؛ كان يسعى إليه الخيميائيون)",
 "nosy": "فُضُولِيّ",
 "nosy-parker": "حشري, فضولي (شخص يتدخل في شؤون الآخرين)",
 "not": "لَا, مَا (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها) / مثال: لا أحب المدرسة.",
 "not at all": "عَفْوًا, عَلَى الرُحْب وَالسَّعَة",
 "not by a blame sight": "إطلاقاً, بأي حال من الأحوال (بالتأكيد لا)\nمثال: الجائزة ليست مؤكدة بأي حال من الأحوال",
 "not by a long sight": "إطلاقاً, بأي حال من الأحوال (بالتأكيد لا)\nمثال: الجائزة ليست مؤكدة بأي حال من الأحوال",
 "not guilty": "بَرِيءٌ بِحُكْمِ الْقَضَاء (صدر حكم ببراءته من تهمة محددة؛ غير مُدان قانونيًّا)",
 "not intrusive": "غير تطفلي, غير فضولي (لا يتدخل أو يتطفل)",
 "not so fast": "لَيْسَ بِهٰذِهِ السُّرْعَة",
 "not surprised": "غير متفاجئ, غير مندهش (ليس مندهشًا أو لا يبدي اندهاشًا)\nمثال: تلك النظرة العنيدة غير المتفاجئة على وجهه",
 "not to mention": "نَاهِيكَ عَن, هٰذَا عَدَا عَنْ",
 "not yet": "لَمْ ؛ حَتَّى الْآنَ, لَمْ ؛ بَعْدُ (جَمَعَ، ضَمَّ)\nمثال: لم يساعدني أحد.",
 "not-for-profit": "منظمة غير ربحية (منظمة مرخصة لأنشطة غير ربحية)",
 "nota bene": "تنبيه, ملاحظة هامة",
 "notability": "عَلَم, نجم لامع (مشهور يمثل إلهاماً للآخرين)\nمثال: استضاف تجمعاً كبيراً من النجوم اللامعة",
 "notable": "مَرْمُوق, بَارِز",
 "notably": "بشكل غير عادي, بشكل لافت (لدرجة أو مدى ملحوظ) / بشكل ملحوظ, خاصة (خاصة؛ على وجه التحديد)\nمثال: كانت طويلة بشكل غير عادي",
 "notary": "كَاتِب الْعَدْل (كَتَبَ رِسَالَة أو مَكْتُوْب لأحد وهذا الآخر يكتب له؛ راسل؛ كَتَبَ عقدا مع أحد؛ عاقد)\nمثال: لست بذاك الكاتب.",
 "notary public": "كاتب عدل, موثق (شخص مخول قانونياً ليشهد على التوقيعات ويصدق على صحة الوثائق ويأخذ الإفادات)",
 "notation": "تدوين, ترميل (نشاط تمثيل شيء ما بنظام خاص من العلامات أو الأحرف) / حاشية, ملاحظة (تعليق أو تعليمات (تضاف عادة)) / تدوين, نظام تدوين (نظام تقني من الرموز يُستخدم لتمثيل أشياء خاصة)\nمثال: أضيفت ملاحظاته في نهاية المقال",
 "notational system": "تدوين, نظام تدوين (نظام تقني من الرموز يُستخدم لتمثيل أشياء خاصة)",
 "notch": "ثلم, حز (قطع صغير) / ثلم, حز (ثلَم الإناءَ: كسر حرفَه؛ ثلَم الحائطَ: أحدث خلل أو شقّ في الحائط) / ممر, ممر جبلي (موقع في سلسلة جبال لتكوين جيولوجي يكون أقل ارتفاعاً من القمم المحيطة) / ثلمة, حز\nمثال: كان هناك أربعة حزوز في مقبض مسدسه",
 "notched": "مُتَآكِل, مُحَزَّز (ذو حافة محزّزة أو مسنّنة بشكل غير منتظم كأنّها مقضومة) / مُسَنَّنٌ تَسْنِينًا مِنْشَارِيًّا, مِنْشَارِيّ (محزّز كالمنشار بأسنان تتّجه نحو القمّة)",
 "note": "مُلَاحَظَة, مَلْحُوظَة / مُذَكَّرَة / دَرَجَة",
 "note of hand": "سند إذني, كمبيالة (وعد بدفع مبلغ محدد عند الطلب أو في وقت معين)\nمثال: كان علي توقيع سنده في البنك ككفيل",
 "note payable": "أوراق دفع, سندات دفع (سند يعد بدفع مبلغ معين من المال في وقت معين)",
 "note receivable": "أوراق قبض, سندات قبض (حقك في سند إذني يعد فيه المحرر بدفع مبلغ معين من المال في وقت معين)",
