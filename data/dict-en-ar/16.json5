 "lycee": "مدرسة ثانوية, مدرسة متوسطة (مدرسة للطلاب بين المدرسة الابتدائية والكلية؛ عادة الصفوف من 9 إلى 12)",
 "lyceum": "ليسيوم, معهد محاضرات (قاعة عامة للمحاضرات والحفلات الموسيقية) / مدرسة ثانوية, مدرسة متوسطة (مدرسة للطلاب بين المدرسة الابتدائية والكلية؛ عادة الصفوف من 9 إلى 12)",
 "lychee": "ليتشي (فاكهة صينية ذات قشرة هشة رقيقة تحيط بلب هلامي حلو وبذرة واحدة)",
 "lychgate": "بوابة مسقوفة (بوابة مسقوفة لمقبرة الكنيسة، كانت تستخدم سابقاً كمأوى مؤقت للنعش أثناء الجنازات)",
 "lychnis": "صائدة الذباب, ليخنيس (أعشاب معمرة في الغالب بسيقان لزجة تمسك بالحشرات؛ واسعة الانتشار في المنطقة المعتدلة الشمالية)",
 "lychnis alba": "سيلينة بيضاء, ليخنيس أبيض (عشبة خضراء مزرقة ذات سيقان لزجة وعناقيد من الزهور البيضاء الكبيرة التي تفتح مساءً بكأس منتفخ جداً؛ توضع أحياناً في جنس ليخنيس)",
 "lychnis chalcedonica": "صليب مالطي, ليخنيس قرمزي (نبات حديقة أوراسي معمر ذو زهور قرمزية في رؤوس طرفية كثيفة)",
 "lychnis coronaria": "قرنفل البوصير, ليخنيس إكليلي (نبات حديقة قديم في جنوب شرق أوروبا يزرع على نطاق واسع لأوراقه الصوفية البيضاء الجذابة وزهوره القرمزية المبهرجة)",
 "lychnis dioica": "سيلينة حمراء, ليخنيس أحمر (نبات أوروبي ثنائي الحول ذو زهور حمراء أو وردية؛ يوضع أحياناً في جنس ليخنيس)",
 "lychnis flos-cuculi": "زهرة الوقواق, ليخنيس زهرة الوقواق (نبات معمر شائع موطنه أوروبا وغرب آسيا ذو زهور وردية عادة ببتلات خشنة)",
 "lychnis floscuculi": "زهرة الوقواق, ليخنيس زهرة الوقواق (نبات معمر شائع موطنه أوروبا وغرب آسيا ذو زهور وردية عادة ببتلات خشنة)",
 "lycian": "الليسية (لغة أناضولية كان يتحدث بها الليسيون القدماء)",
 "lycian language": "الليسية (لغة أناضولية كان يتحدث بها الليسيون القدماء)",
 "lycium barbarum": "عوسج شائع, لساس بربري (شجيرة منتصبة أو منتشرة متساقطة الأوراق ذات فروع شائكة وزهور بنفسجية أرجوانية تليها ثمار برتقالية حمراء؛ من جنوب شرق أوروبا إلى الصين)",
 "lycium carolinianum": "توت عيد الميلاد, عوسج كاروليني (شجيرة دائمة الخضرة شائكة في جنوب شرق الولايات المتحدة لها فروع منتشرة وزهور زرقاء أو بنفسجية عادة وتوت أحمر)",
 "lycium halimifolium": "عوسج شائع, لساس بربري (شجيرة منتصبة أو منتشرة متساقطة الأوراق ذات فروع شائكة وزهور بنفسجية أرجوانية تليها ثمار برتقالية حمراء؛ من جنوب شرق أوروبا إلى الصين)",
 "lycopene": "ليكوبين (كاروتينويد يجعل الطماطم حمراء؛ قد يقلل من خطر الإصابة ببعض أنواع السرطان)",
 "lycopersicon esculentum": "بندورة, طماطم (موطنها أمريكا الجنوبية؛ تزرع على نطاق واسع في العديد من الأصناف)",
 "lycopersicon esculentum cerasiforme": "طماطم كرزية (نبات يحمل ثماراً حمراء إلى صفراء صغيرة)",
 "lycopod": "حزازيات ذئبية, رجل الذئب (نبات بدائي دائم الخضرة يشبه الطحالب بأبواغ في مخاريط تشبه الهراوة)",
 "lycopodium alopecuroides": "عشبة ذيل الثعلب (صنوبر أرضي مغطى بكثافة بأوراق شائكة؛ موزع على نطاق واسع في المناطق الساحلية الرملية القاحلة أو الخثية الرطبة في شرق وجنوب شرق الولايات المتحدة)",
 "lycopodium alpinum": "رجل الذئب الألبي (نوع من طحالب النادي يوجد في جميع أنحاء خطوط العرض الشمالية في نصف الكرة الشمالي)",
 "lycopodium clavatum": "رجل الذئب, صنوبر زاحف (صنف من طحلب النادي، يعرف أيضاً باسم طحلب النادي قدم الذئب، وطحلب النادي قرن الأيل والصنوبر الأرضي)",
 "lycopodium complanatum": "أرز أرضي, طحلب قرن الأيل (صنف من طحلب النادي، بأسماء شائعة مثل جيني الزاحفة أو الصنوبر الجاري الشمالي)",
 "lycopodium lucidulum": "رجل الذئب اللامع (نوع من طحالب النادي، يعرف أيضاً باسم طحلب التنوب اللامع)",
 "lycopodium obscurum": "تنوب أرضي, صنوبر الأميرة (صنف من طحلب النادي، يسمى عادة الصنوبر الأرضي، أو صنوبر الأمير، أو صنوبر الأميرة)",
 "lycopodium selago": "رجل الذئب التنوبي, رجل الذئب الجبلي (من شمال أوروبا وأمريكا؛ يشبه شجرة تنوب مصغرة)",
 "lycopus americanus": "فراسيون مائي, ليكوبس أمريكي (عشب عطري معمر في الولايات المتحدة)",
 "lycopus europaeus": "عشبة الغجر, ليكوبس أوروبي (عشب أوراسي مشعر بأزهار بيضاء ذات شفتين)",
 "lycopus virginicus": "عشبة البوق, ليكوبس (عشب عطري مخدر قليلاً وقابض له أزهار بيضاء صغيرة؛ شرق الولايات المتحدة)",
 "lycosa tarentula": "رتيلاء, عنكبوت الذئب الأوروبي (عنكبوت كبير من جنوب أوروبا كان يعتقد سابقاً أنه سبب الهوس الرقصي (حركة جسدية لا يمكن السيطرة عليها))",
 "lycée": "لِيسِيه, مَدْرَسَةٌ ثَانَوِيَّة",
 "lydia": "لِيدِيَا",
 "lydian": "الليدية (لغة أناضولية كان يتم التحدث بها في منطقة ليديا)",
 "lydian language": "الليدية (لغة أناضولية كان يتم التحدث بها في منطقة ليديا)",
 "lye": "غسول, محلول قلوي (محلول قوي من هيدروكسيد الصوديوم أو البوتاسيوم)",
 "lye hominy": "هوميني الغسول (ذرة مجروشة محضرة بالتبييض في الغسول)",
 "lygaeid": "بق الحبوب, ليجيد (بق حقيقي: عادة ما يكون زاهي الألوان؛ آفة للمحاصيل المزروعة وبعض أشجار الفاكهة)",
 "lygaeid bug": "بق الحبوب, ليجيد (بق حقيقي: عادة ما يكون زاهي الألوان؛ آفة للمحاصيل المزروعة وبعض أشجار الفاكهة)",
 "lygodium microphyllum": "سرخس الثعبان, كزبرة البئر المتسلقة (سرخس استوائي واسع الانتشار في العالم القديم؛ متوطن في جامايكا وفلوريدا)",
 "lygodium palmatum": "سرخس زاحف, سرخس هارتفورد (سرخس رقيق في شرق الولايات المتحدة ذو ساق ملتفة وسعف عقيم مفصص راحياً وسعف خصب متشعب)",
 "lygus bug": "بق ليغوس (ناقل للأمراض الفيروسية النباتية)",
 "lygus lineolaris": "بق النبات الملطخ (آفة نباتية وفاكهة واسعة الانتشار)",
 "lying": "كَذِب (مصدر للفعل كَذَبَ؛ نقيض الصِدْق، قَوْل ما يخالف ما يعلم القَائِل أنه حَقِيقَة)\nمثال: اتهمتني بالكذب.",
 "lying in wait": "كمين (فعل إخفاء نفسك والتربص للهجوم على حين غرة)",
 "lying under oath": "حنث باليمين, شهادة زور (الجريمة الجنائية المتمثلة في الإدلاء ببيانات كاذبة تحت القسم)",
 "lying-in": "طلق, مخاض (المرحلة الختامية للحمل؛ من بداية الانقباضات حتى ولادة الطفل)\nمثال: كانت في المخاض لمدة ست ساعات",
 "lymantria": "عُثَّة مُتْلِفَة, لِيمَانْتْرِيَة",
 "lymantria dispar": "عثة الغجر (عثة أوروبية أُدخلت إلى أمريكا الشمالية؛ آفة خطيرة لأشجار الظل)",
 "lymantriid": "عثة ذات خصلات (عثة باهتة اللون ليرقاتها خصلات من الشعر على الجسم وتتغذى على أوراق العديد من الأشجار النفضية)",
 "lyme arthritis": "التهاب المفاصل لايم, داء لايم (مرض التهابي حاد يتميز بطفح جلدي مع تورم المفاصل وحمى؛ تسببه بكتيريا تنقلها لدغة قراد الغزلان)",
 "lyme disease": "التهاب المفاصل لايم, داء لايم (مرض التهابي حاد يتميز بطفح جلدي مع تورم المفاصل وحمى؛ تسببه بكتيريا تنقلها لدغة قراد الغزلان)",
 "lyme grass": "إليموس, عشب اللايم (عشب من جنس إليموس)",
 "lymph": "لِمْف",
 "lymph cell": "خلية لمفاوية, كريّة لمفاوية (خلية دم بيضاء غير محببة تشكل عادة ربع عدد خلايا الدم البيضاء ولكن يزداد عددها في وجود عدوى)",
 "lymph gland": "عقدة لمفاوية, غدة لمفاوية (مصدر اللمف والخلايا اللمفاوية)",
 "lymph node": "عُقْدَة لِمْفَاوِيَّة",
 "lymph vessel": "وعاء ليمفاوي (قناة وعائية تحمل الليمف الذي يضاف في النهاية إلى الدورة الدموية الوريدية)",
 "lymphadenitis": "التهاب العقد اللمفية (التهاب الغدد الليمفاوية)",
 "lymphadenoma": "ورم عقدي لمفي (عقدة لمفاوية متضخمة بشكل غير طبيعي)",
 "lymphadenopathy": "اعتلال العقد اللمفية, تضخم الغدد الليمفاوية (تضخم غير طبيعي مزمن في العقد الليمفاوية (يرتبط عادة بالمرض))",
 "lymphangiectasia": "توسع الأوعية اللمفاوية (توسع وعاء لمفاوي)",
 "lymphangiectasis": "توسع الأوعية اللمفاوية (توسع وعاء لمفاوي)",
 "lymphangiogram": "صورة الأوعية اللمفاوية (صورة وعائية للعقد الليمفاوية والأوعية الليمفاوية مصنوعة بعد حقن مادة ظليلة للأشعة)",
 "lymphangiography": "تصوير الأوعية الليمفاوية (فحص بالأشعة السينية للعقد الليمفاوية والأوعية الليمفاوية بعد حقن وسيط تباين)",
 "lymphangioma": "ورم وعائي لمفي (ورم وعائي حميد يتكون من كتلة من الأوعية اللمفاوية)",
 "lymphangitis": "التهاب الأوعية اللمفية (التهاب وعاء لمفي)",
 "lymphatic": "لِمْفَاوِيّ",
 "lymphatic system": "جِهَاز لِمْفَاوِيّ",
 "lymphatic tissue": "نسيج لمفاوي (النسيج الذي يشكل الجهاز اللمفاوي)",
 "lymphatic vessel": "وعاء ليمفاوي (قناة وعائية تحمل الليمف الذي يضاف في النهاية إلى الدورة الدموية الوريدية)",
 "lymphedema": "وذمة لمفية (تورم (عادة في الساقين) ناتج عن تراكم اللمف في الأنسجة في المناطق المصابة)",
 "lymphoblast": "أرومة لمفاوية (خلية لمفاوية غير ناضجة)",
 "lymphoblast-like": "شَبِيه بِالأَرُومَة اللِّمْفَاوِيَّة (يشبه الأرومة اللمفاويّة)",
 "lymphoblastic leukemia": "ابيضاض الدم الأرومي اللمفاوي (شكل من أشكال اللوكيميا اللمفاوية تكون فيه الخلايا غير الطبيعية في الدم المتداول عبارة عن أرومات لمفاوية بشكل كلي تقريبًا)",
 "lymphocyte": "خلية لمفاوية, كريّة لمفاوية (خلية دم بيضاء غير محببة تشكل عادة ربع عدد خلايا الدم البيضاء ولكن يزداد عددها في وجود عدوى)",
 "lymphocytic": "لمفاوي (متعلق بالخلايا اللمفاوية)\nمثال: ابيضاض الدم اللمفاوي",
 "lymphocytic choriomeningitis": "التهاب المشيمية والسحايا اللمفاوي (شكل من أشكال التهاب السحايا الفيروسي يسببه فيروس يحمله فأر المنزل الشائع)",
 "lymphocytic choriomeningitis virus": "فيروس التهاب المشيمية والسحايا اللمفاوي (فيروس رنا يسبب التهاب المشيمية والسحايا اللمفاوي؛ يصيب الفئران والقرود والكلاب وخنازير غينيا والبشر)",
 "lymphocytic leukemia": "ابيضاض الدم اللمفاوي, لوكيميا لمفاوية (لوكيميا تتميز بتضخم الأنسجة اللمفاوية والخلايا اللمفاوية في الدم المتداول)",
 "lymphocytopenia": "قلة اللمفاويات (عدد قليل بشكل غير طبيعي من الخلايا الليمفاوية في الدم المتداول)",
 "lymphocytosis": "كثرة اللمفاويات (زيادة غير طبيعية في عدد الخلايا الليمفاوية في الدم المتداول)",
 "lymphogranuloma": "ورم حبيبي لمفي (تورم العقدة الليمفاوية)",
 "lymphogranuloma venereum": "ورم حبيبي لمفي منقول جنسيا (مرض معد تسببه فصيلة من بكتيريا الكلاميديا؛ ينتقل عن طريق الاتصال الجنسي؛ يتميز بآفات تناسلية وتورم الغدد اللمفاوية في الفخذ)",
 "lymphography": "تصوير الأوعية الليمفاوية (فحص بالأشعة السينية للعقد الليمفاوية والأوعية الليمفاوية بعد حقن وسيط تباين)",
 "lymphoid": "شبيه باللمف, لمفاوي (يشبه اللمف أو الأنسجة اللمفاوية)",
 "lymphoid tissue": "نسيج لمفاوي (النسيج الذي يشكل الجهاز اللمفاوي)",
 "lymphokine": "لمفوكين (سيتوكين تفرزه الخلايا التائية المساعدة استجابة للتحفيز بواسطة المستضدات ويعمل على خلايا أخرى من الجهاز المناعي (مثل تنشيط البلاعم))",
 "lymphoma": "ليمفوما, ورم لمفي (ورم في الأنسجة اللمفاوية عادة ما يكون خبيثًا؛ أحد الأنواع الأربعة الرئيسية للسرطان)",
 "lymphopathia venereum": "ورم حبيبي لمفي منقول جنسيا (مرض معد تسببه فصيلة من بكتيريا الكلاميديا؛ ينتقل عن طريق الاتصال الجنسي؛ يتميز بآفات تناسلية وتورم الغدد اللمفاوية في الفخذ)",
 "lymphopenia": "قلة اللمفاويات (عدد قليل بشكل غير طبيعي من الخلايا الليمفاوية في الدم المتداول)",
 "lymphopoiesis": "تكون اللمفاويات (تكوين الخلايا الليمفاوية في نخاع العظم والعقد الليمفاوية والغدة الصعترية والطحال)",
 "lymphuria": "بيلة لمفية (وجود اللمف في البول)",
 "lynch law": "إعدام دون محاكمة, قانون الغاب (ممارسة معاقبة الناس بالشنق دون إجراءات قانونية)",
 "lynch mob": "غوغاء الإعدام الميداني (غوغاء تقتل شخصاً لارتكابه جريمة مفترضة دون سلطة قانونية)",
 "lynching": "إعدام دون محاكمة, سحل (إعدام شخص بواسطة حشد غوغائي دون اتباع الإجراءات القانونية الواجبة)",
 "lynchpin": "مسمار المحور (مسمار يتم إدخاله عبر محور العجلة لتثبيت العجلة) / دعامة أساسية, ركيزة (مصدر دعم واستقرار مركزي ومتماسك)\nمثال: الإيمان هو ركيزته",
 "lynx": "وَشَق",
 "lynx canadensis": "وشق كندي (يعيش في شمال أمريكا الشمالية)",
 "lynx caracal": "عناق الأرض, وشق الصحراء (يعيش في صحاري شمال أفريقيا وجنوب آسيا)",
 "lynx lynx": "وشق أوراسي (يعيش في شمال أوراسيا)",
 "lynx pardina": "وشق أيبيري (يعيش في جنوب أوروبا)",
 "lynx rufus": "بوبكات, وشق أحمر (وشق صغير يعيش في أمريكا الشمالية)",
 "lynx-eyed": "ثَاقِب البَصَر, حَدِيد النَّظَر (ذو بصر حادّ جدًّا)",
 "lyon": "لِيُون",
 "lyonia ligustrina": "توت الذكر (شجيرة نفضية كثيرة التفرع ذات عناقيد زغبية كثيفة من الزهور البيضاء الصغيرة على شكل جرس)",
 "lyonia lucida": "شجيرة القيود, ليونيا لامعة (شجيرة دائمة الخضرة مبهرجة من جنوب شرق الولايات المتحدة ذات أوراق لامعة وفروع ذات زوايا ومجموعات من الزهور الوردية إلى المحمرة التي تشبه الخيمة)",
 "lyonia mariana": "شجيرة الترنح (شجيرة نفضية في السهل الساحلي لشرق الولايات المتحدة ذات أزهار بيضاء وردية متدلية؛ سامة للماشية)",
 "lyonnaise": "مَطْبُوخٌ عَلَى طَرِيقَةِ لِيُون (مَطْهُوٌّ مَعَ البَصَل)",
 "lyonnaise sauce": "صلصة البصل البنية, ليونيز (صلصة بنية مع بصل مفروم مقلي وبقدونس ونبيذ أبيض جاف أو خل)",
 "lyons": "مجمع ليون الأول (مجمع الكنيسة الغربية عام 1245 الذي حرم الإمبراطور الروماني المقدس فريدريك الثاني وخطط لحملة صليبية جديدة ضد الأرض المقدسة) / مجمع ليون الثاني (المجمع المنعقد عام 1274 الذي حقق اتحاداً مؤقتاً بين الأرثوذكس اليونانيين والكنيسة الرومانية الكاثوليكية)",
 "lyophilisation": "تجفيد, تجفيف بالتجميد (طريقة لتجفيف الطعام أو بلازما الدم أو الأدوية أو الأنسجة دون تدمير بنيتها المادية؛ حيث يتم تجميد المادة ثم تدفئتها في فراغ ليتسامى الجليد)",
 "lyophilised": "مُجَفَّف تَجْمِيدِيًّا ((عَنِ الأَنْسِجَة أَوِ الدَّم أَوِ الأَمْصَال) مُجَفَّف بِالتَّجْمِيد فِي فَرَاغ عَالٍ)",
 "lyophilization": "تجفيد, تجفيف بالتجميد (طريقة لتجفيف الطعام أو بلازما الدم أو الأدوية أو الأنسجة دون تدمير بنيتها المادية؛ حيث يتم تجميد المادة ثم تدفئتها في فراغ ليتسامى الجليد)",
 "lyophilized": "مُجَفَّف تَجْمِيدِيًّا ((عَنِ الأَنْسِجَة أَوِ الدَّم أَوِ الأَمْصَال) مُجَفَّف بِالتَّجْمِيد فِي فَرَاغ عَالٍ)",
 "lypressin": "ليبريسين (مضاد لإدرار البول ومضيق للأوعية يستخدم لعلاج مرض السكري الكاذب)",
 "lyrate": "قِيثَارِيّ الوَرَقَة ((عن شكل الورقة) ذو انحناء يُوحي بشكل القيثارة)",
 "lyrate leaf": "ورقة قيثارية (ورقة بسيطة لها انحناء يوحي بالقيثارة)",
 "lyre": "كِنَّارَة",
 "lyre snake": "ثعبان القيثارة (ثعبان سام بشكل خفيف بعلامة على شكل قيثارة على الرأس؛ يوجد في المناطق الصخرية من جنوب غرب الولايات المتحدة إلى أمريكا الوسطى)",
 "lyre-flower": "القلب النازف, ديسنترا رائعة (نبات حدائق له أزهار متدلية على شكل قلب وردية داكنة)",
 "lyre-shaped": "قِيثَارِيّ الشَّكْل (على شكل القيثارة القديمة)",
 "lyrebird": "طائر القيثارة (طائر أسترالي يشبه الدراج؛ يعرض الذكر المغازل ريش ذيل طويل على شكل قيثارة)",
 "lyreflower": "القلب النازف, ديسنترا رائعة (نبات حدائق له أزهار متدلية على شكل قلب وردية داكنة)",
 "lyric": "غِنَائِيّ, وِجْدَانِيّ (يعبّر عن عاطفة عميقة) / غنائي (تستخدم لمغنٍ أو صوت غنائي خفيف الحجم ومتواضع النطاق) / غنائي, وجداني (متعلق بفئة من الشعر تعبر عن العاطفة (غالباً بطريقة شبيهة بالأغنية)) / أوبرالي, غنائي (متعلق بالدراما الموسيقية)\nمثال: سوبرانو غنائي",
 "lyric mezzo-soprano": "ميزو سوبرانو غنائي (نوع فرعي من الميزو سوبرانو)",
 "lyric poem": "شعر غنائي, قصيدة غنائية (قصيدة قصيرة ذات طابع غنائي)",
 "lyrical": "غِنَائِيّ, وِجْدَانِيّ (يعبّر عن عاطفة عميقة) / غِنَائِيّ, وِجْدَانِيّ (مُنَاسِبٌ لِلْغِنَاءِ أَوْ يُوحِي بِه)",
 "lyricality": "شاعرية, غنائية (خاصية الملاءمة للغناء)",
 "lyrically": "بشاعرية (بطريقة غنائية وشاعرية)\nمثال: رقصت دور البجعة السوداء بشاعرية كبيرة",
 "lyricism": "شاعريّة, عاطفة جياشة (حماس مفرط وغير مقيد) / شاعرية, غنائية (خاصية الملاءمة للغناء)",
 "lyricist": "كاتب كلمات الأغاني, مؤلف الأغاني (شخص يكتب كلمات الأغاني)",
 "lyrics": "مَنْشُود, كَلِمَات",
 "lyrist": "كاتب كلمات الأغاني, مؤلف الأغاني (شخص يكتب كلمات الأغاني)",
 "lyrurus mlokosiewiczi": "طيهوج أسود آسيوي (طيهوج أسود من غرب آسيا)",
 "lyrurus tetrix": "طيهوج أسود أوروبي (طيهوج كبير من شمال أوروبا أسود اللون وذيله على شكل قيثارة)",
 "lysergic acid": "حمض الليسرجيك (حمض بلوري يستخدم غالباً في الأبحاث الطبية؛ يتم الحصول عليه من قلويدات الإرغوت)",
 "lysergic acid diethylamide": "إل إس دي, ثنائي إيثيل أميد حمض الليسرجيك (عقار مهلوس قوي مصنع من حمض الليسرجيك)",
 "lysichiton americanum": "ملفوف الظربان الغربي",
 "lysiloma bahamensis": "تمرهندي بري (شجرة من جزر الهند الغربية وفلوريدا والمكسيك؛ تشبه التمرهندي ولها قرون مسطحة طويلة)",
 "lysiloma latisiliqua": "تمرهندي بري (شجرة من جزر الهند الغربية وفلوريدا والمكسيك؛ تشبه التمرهندي ولها قرون مسطحة طويلة)",
 "lysiloma sabicu": "سابيكو (شجرة من جزر الهند الغربية تنتج نوعاً صلباً من الخشب البني الداكن يشبه الماهوجني في الملمس والقيمة)",
 "lysimachia ciliatum": "ليسيماكيا مهدبة (من أمريكا الشمالية)",
 "lysimachia clethroides duby": "ليسيماكيا عنق الإوزة (صنف من عشبة الليسيماكيا)",
 "lysimachia nemorum": "ليسيماكيا صفراء (نبات أوروبي زاحف دائم الخضرة ذو أزهار صفراء)",
 "lysimachia nummularia": "جيني الزاحفة, عشبة المال (كرمة ليسيماكيا)",
 "lysimachia quadrifolia": "ليسيماكيا دوارية (نبات شائع أصفر الزهر في أمريكا الشمالية)",
 "lysimachia terrestris": "شموع المستنقع (نبات من أمريكا الشمالية ذو سنابل من الزهور الصفراء، يوجد في الأماكن الرطبة)",
 "lysimachia vulgaris": "ليسيماكيا الحدائق, ليسيماكيا صفراء (تعتبر في كثير من الأحيان عشبة ضارة؛ أوروبا وآسيا)",
 "lysin": "حالّ, ليسين (أي مادة (مثل الأجسام المضادة) أو عامل يمكن أن يسبب التحلل)",
 "lysine": "لايسين (حمض أميني أساسي يوجد في البروتينات؛ ويوجد خاصة في الجيلاتين والكازين)",
 "lysine intolerance": "عدم تحمل الليسين (اضطراب يجعل فيه نقص إنزيمات معينة من المستحيل هضم الحمض الأميني ليسين)",
 "lysinemia": "فرط لايسين الدم, لايسينيميا (خطأ استقلابي خلقي يؤدي فيه نقص إنزيمات معينة إلى عدم القدرة على استقلاب الحمض الأميني لايسين؛ يتميز بضعف العضلات والتخلف العقلي)",
 "lysis": "اِنْحِلَال",
 "lysoform": "ليسوفورم (خليط من صابون سائل مع فورمالدهيد، يُستخدم كمطهر)",
 "lysogenic": "حال للخلية, ليسوجيني (قادر على إنتاج أو الخضوع للتحلل (انحلال الخلية)) / ليسوجيني (متعلق بظاهرة الليسوجينية (الدورة الكامنة للفيروس))",
 "lysogenicity": "استذابة, ليسوجينية (حالة بكتيريا مضيفة قامت بدمج عاثية (فيروس) في مادتها الوراثية الخاصة)\nمثال: عندما تصيب العاثية بكتيريا، يمكنها إما تدمير مضيفها أو الاندماج في جينوم المضيف في حالة من الاستذابة",
 "lysogenisation": "استذابة, تكون الليسوجين (العملية التي تكتسب بها البكتيريا عاثية تصبح مدمجة في جينومها)",
 "lysogenization": "استذابة, تكون الليسوجين (العملية التي تكتسب بها البكتيريا عاثية تصبح مدمجة في جينومها)",
 "lysogeny": "استذابة, ليسوجينية (حالة بكتيريا مضيفة قامت بدمج عاثية (فيروس) في مادتها الوراثية الخاصة)\nمثال: عندما تصيب العاثية بكتيريا، يمكنها إما تدمير مضيفها أو الاندماج في جينوم المضيف في حالة من الاستذابة",
 "lysol": "ليسول (محلول بني زيتي شفاف من الكريسول في الصابون؛ يُستخدم كمطهر ومعقم)",
 "lysosome": "جسيم حال, ليسوسوم (عضية توجد في سيتوبلازم معظم الخلايا (خاصة في الكريات البيضاء وخلايا الكبد والكلية))",
 "lysozyme": "ليزوزيم (إنزيم يوجد في اللعاب والعرق والدموع يدمر جدران خلايا بعض البكتيريا)",
 "lyssa": "السعار, داء الكلب (مرض فيروسي حاد يصيب الجهاز العصبي للحيوانات ذوات الدم الحار (ينتقل عادة عن طريق عضة حيوان مسعور)؛ داء الكلب قاتل إذا وصل الفيروس إلى الدماغ)",
 "lyssavirus": "فيروس داء الكلب, ليسا فيروس (فيروس غير منقول بالمفصليات موجه للعصب من فصيلة الفيروسات الربدية يسبب داء الكلب)",
 "lythrum hyssopifolia": "ليثروم زوفي الأوراق (نبات حولي ذو زهور وردية صغيرة منفردة؛ أصله من أوروبا ولكنه متوطن على نطاق واسع في المناطق الرطبة)",
