 "mackintosh": "معطف ماكنتوش (معطف واق من المطر مصنوع من قماش معالج بالمطاط) / ماكينتوش (قماش خفيف الوزن مقاوم للماء (عادة ما يكون معالجاً بالمطاط))",
 "mackle": "طبعة مشوشة (طبعة مطبوعة غير واضحة أو مزدوجة)",
 "macleaya cordata": "بوكونيا, خشخاش الريش (عشبة من الصين واليابان تزرع على نطاق واسع لعناقيدها الريشية من الزهور البيضاء الكريمية)",
 "maclura pomifera": "برتقال أوساج, خشب القوس (شجرة صفراء الخشب شجيرية صغيرة نفضية من جنوب وسط الولايات المتحدة، لها أشواك وأوراق خضراء داكنة لامعة وفاكهة غير صالحة للأكل تشبه البرتقال؛ خشبها…)",
 "macon": "ماكون, ماكونيه (نبيذ بورغوندي فاخر عادة ما يكون أبيض وجافاً)",
 "maconnais": "ماكون, ماكونيه (نبيذ بورغوندي فاخر عادة ما يكون أبيض وجافاً)",
 "macoun": "تفاح ماكون (يشبه تفاح ماكنتوش؛ كثير العصارة ومتأخر النضج)",
 "macowanites americanus": "ماكوانيتس أمريكانوس (فطر صغير بقبعة هشة تتشقق لتكشف عن السياق الأبيض وساق أبيض محاط عملياً بالقبعة)",
 "macrame": "مكرمية (دانتيل خشن نسبياً؛ مصنوع بنسج وعقد الحبال)",
 "macrencephalic": "ضخم الدماغ (يمتلك علبة دماغ كبيرة)",
 "macrencephalous": "ضخم الدماغ (يمتلك علبة دماغ كبيرة)",
 "macrencephaly": "ضخامة الدماغ (جمجمة كبيرة بشكل غير طبيعي)",
 "macro": "كُلِّيّ, وَاسِع (كبير جداً في النطاق أو المدى أو القدرة) / تعليمة ماكرو, ماكرو (تعليمة حاسوبية واحدة تؤدي إلى سلسلة من التعليمات بلغة الآلة)",
 "macro instruction": "تعليمة ماكرو, ماكرو (تعليمة حاسوبية واحدة تؤدي إلى سلسلة من التعليمات بلغة الآلة)",
 "macrobiotic": "ماكروبيوتيك (من أو يتعلق بنظرية أو ممارسة الماكروبيوتيك)\nمثال: حمية الماكروبيوتيك",
 "macrobiotic diet": "حمية الماكروبيوتيك, ماكروبيوتيك (نظام غذائي يتكون بشكل رئيسي من الفاصوليا والحبوب الكاملة)",
 "macrobiotics": "ماكروبايوتيك (نظرية تعزيز الصحة وطول العمر عن طريق النظام الغذائي (خاصة الحبوب الكاملة والبقوليات))",
 "macrocephalic": "ضخم الرأس (له رأس ودماغ كبيران بشكل استثنائي)",
 "macrocephalon maleo": "طائر الماليو (طائر ميغابود من سيليبس يضع البيض في حفر في الشواطئ الرملية)",
 "macrocephalous": "ضخم الرأس (له رأس ودماغ كبيران بشكل استثنائي)",
 "macrocephaly": "ضخامة الرأس (رأس كبير بشكل غير طبيعي؛ يختلف عن استسقاء الدماغ لأنه لا يوجد ضغط زائد داخل الجمجمة ويكون فرط النمو متماثلاً)",
 "macrocheira kaempferi": "سلطعون العنكبوت الياباني, سلطعون عملاق (سلطعون ياباني كبير جداً يعيش في المياه العميقة)",
 "macroclemys temmincki": "سلحفاة القاطور النهاشة (نوع كبير له ثلاثة تلال على ظهره؛ يوجد في جنوب شرق الولايات المتحدة)",
 "macrocosm": "العَالَم, الكَوْن (كل شيء موجود في أي مكان)\nمثال: يدرسون تطور الكون",
 "macrocosmic": "كوني, ماكروكوزمي (متعلق بالكون الأكبر أو يشكله)",
 "macrocyte": "خلية دم حمراء ضخمة (خلية دم حمراء كبيرة بشكل غير طبيعي (مرتبطة بفقر الدم الخبيث))",
 "macrocytic anaemia": "فقر الدم كبير الكريات (فقر دم يكون فيه متوسط حجم كريات الدم الحمراء أكبر من المعتاد)",
 "macrocytic anemia": "فقر الدم كبير الكريات (فقر دم يكون فيه متوسط حجم كريات الدم الحمراء أكبر من المعتاد)",
 "macrocytosis": "تضخم الكريات, كبر الكريات (الزِّيادة المُفرِطة في الحجم؛ الزِّيادة المُفرِطة في الوسائل والأَشخاص)\nمثال: الجزائر تعاني من التضخم.",
 "macrodactylus subspinosus": "خنفساء الورد (خنفساء شائعة في أمريكا الشمالية: تتغذى اليرقات على الجذور والبالغون على الأوراق والزهور مثل شجيرات الورد أو أشجار التفاح أو كروم العنب)",
 "macrodantin": "ماكرودانتين, نيتروفورانتوين (مشتق من النيتروفوران يستخدم كدواء مضاد للبكتيريا (الاسم التجاري ماكرودانتين) فعال ضد مجموعة واسعة من البكتيريا إيجابية الجرام وسلبية الجرام؛ يستخدم…)",
 "macroeconomic": "اقتصادي كلي (مكون من أو متعلق بالاقتصاد الكلي)",
 "macroeconomic expert": "خبير اقتصاد كلي (اقتصادي متخصص في الاقتصاد الكلي)",
 "macroeconomics": "اقتصاد كلي (فرع الاقتصاد الذي يدرس العمل الكلي للاقتصاد الوطني)",
 "macroeconomist": "خبير اقتصاد كلي (اقتصادي متخصص في الاقتصاد الكلي)",
 "macroelement": "عنصر كبير, معدن رئيسي (عنصر كيميائي مطلوب بكميات كبيرة نسبياً للعمليات الفسيولوجية الطبيعية في الجسم)\nمثال: المعادن مرتبة حسب الوفرة في جسم الإنسان تشمل المعادن السبعة الرئيسية: الكالسيوم والفوسفور والبوتاسيوم والكبريت والصوديوم والكلور والمغنيسيوم",
 "macroevolution": "اَلتَّطَوُّر اَلْكَبِير",
 "macroglia": "خلايا دبقية نجمية (نسيج يتكون من خلايا عصبية دبقية نجمية كبيرة)",
 "macroglossia": "تضخم اللسان (اضطراب خلقي يتميز بلسان كبير بشكل غير طبيعي؛ غالباً ما يُرى في حالات متلازمة داون)",
 "macromolecular": "جزيئي ضخم, كبير الجزيئات (متعلق بالجزيئات الضخمة (الماكرو) أو يتكون منها)\nمثال: مركبات جزيئية ضخمة",
 "macromolecule": "جزيء ضخم, جزيء كبير (أي جزيء معقد كبير جداً؛ يوجد فقط في النباتات والحيوانات)",
 "macron": "عَلَامَة اَلْمَدّ (سِمَةٌ أو أمارة أو شِعَار تُعرف به الأشياء؛ رَمْز)\nمثال: تحصلت على علامة أ.",
 "macronectes giganteus": "نوء عملاق (طائر نوء بني كبير يوجد بشكل رئيسي في بحار القطب الجنوبي)",
 "macrophage": "بَالِعَة, مَاكْرُوفَاج",
 "macropus agilis": "ولب رشيق, ولب شائع (ولب صغير يبلغ ارتفاعه 30 بوصة)",
 "macropus giganteus": "كنغر رمادي شرقي, كنغر عملاق (كنغر أسترالي بني رمادي كبير جداً كان وفيراً سابقاً في المناطق المشجرة المفتوحة)",
 "macroscopic": "مَاكْرُوسْكُوبِيّ, مَرْئِيّ بِالعَيْن (كبير بما يكفي لرؤيته بالعين المجردة) / عِيَانِيّ, مَرْئِيٌّ بِالعَيْنِ المُجَرَّدَة (يُرَى بِالعَيْنِ المُجَرَّدَة؛ بِاسْتِخْدَامِ العَيْنِ المُجَرَّدَة)",
 "macroscopic anatomy": "تشريح عياني (دراسة بنية الجسم وأجزائه دون استخدام المجهر)",
 "macroscopical": "مَاكْرُوسْكُوبِيّ, مَرْئِيّ بِالعَيْن (كبير بما يكفي لرؤيته بالعين المجردة) / عِيَانِيّ, مَرْئِيٌّ بِالعَيْنِ المُجَرَّدَة (يُرَى بِالعَيْنِ المُجَرَّدَة؛ بِاسْتِخْدَامِ العَيْنِ المُجَرَّدَة)",
 "macroscopically": "بالعين المجردة, عيانياً (بدون استخدام مجهر)\nمثال: تم فحص الأنابيب بالعين المجردة",
 "macrosporangium": "محفظة بوغية كبيرة (بنية نباتية تنتج أبواغاً كبيرة)",
 "macrospore": "بوغ كبير (أكبر نوعي الأبواغ المنتجة في النباتات متباينة الأبواغ؛ يتطور في البويضة إلى نبات مشيجي أنثوي)",
 "macrotis lagotis": "بندقوط أرنبي, بيلبي (بندقوط ذو آذان جلدية مثل الأرنب)",
 "macrotus": "خفاش كبير الأذن (خفاش رمادي كبير الأذن من جنوب كاليفورنيا وشمال غرب المكسيك)",
 "macrotus californicus": "خفاش كبير الأذن (خفاش رمادي كبير الأذن من جنوب كاليفورنيا وشمال غرب المكسيك)",
 "macrotyloma uniflorum": "حمص الحصان, ماكروتيولما (حَمَصَ الجُرْحُ: سَكَنَ وَرَمُه؛ حَمَصَ القَذَاةَ: أَخْرَجَها مِنْ عَيْنِه بِرِفْقٍ)\nمثال: الحمص مكون أساسي في طبق الفلافل.",
 "macrozamia": "ماكروزاميا (أي سيكاد يشبه الشجرة من جنس ماكروزاميا له جذوع منتصبة وأوراق ريشية ومخاريط كبيرة بمكسرات صالحة للأكل أحياناً؛ أستراليا)",
 "macrozamia communis": "بوراوانغ, ماكروزاميا شائعة (سيكاد جذاب كبير يشبه النخيل دائم الخضرة من نيو ساوث ويلز)",
 "macrozamia spiralis": "بوراوانغ, ماكروزاميا شائعة (سيكاد جذاب كبير يشبه النخيل دائم الخضرة من نيو ساوث ويلز)",
 "macrozoarces americanus": "إيل بوت المحيط (شائعة على طول الساحل الشمالي الشرقي لأمريكا الشمالية)",
 "macula": "لطخة جلدية (رقعة من الجلد متغيرة اللون ولكنها غير مرتفعة عادة؛ تسببها أمراض مختلفة) / بقعة صفراء, لطخة (منطقة مركزية صفراء صغيرة في الشبكية غنية بالمخاريط وتتوسط الرؤية التفصيلية الواضحة) / بقعة شمسية, كلف الشمس (بقعة داكنة أكثر برودة تظهر بشكل دوري على الغلاف الضوئي للشمس؛ مرتبطة بمجال مغناطيسي قوي)",
 "macula lutea": "بقعة صفراء, لطخة (منطقة مركزية صفراء صغيرة في الشبكية غنية بالمخاريط وتتوسط الرؤية التفصيلية الواضحة)",
 "macular area": "بقعة صفراء, لطخة (منطقة مركزية صفراء صغيرة في الشبكية غنية بالمخاريط وتتوسط الرؤية التفصيلية الواضحة)",
 "macular degeneration": "تنكس بقعي (مرض في العين ناتج عن تنكس خلايا البقعة الصفراء ويؤدي إلى عدم وضوح الرؤية؛ ويمكن أن يسبب العمى)",
 "macular edema": "وذمة بقعية",
 "maculate": "مُبَقَّع, مُلَطَّخ (ذو بقع أو لطخات ظاهرة) / مُدَنَّس, مُلَوَّث (مُشَوَّه أخلاقيًّا؛ ملطّخ أو فاسد)",
 "maculation": "تبقيع, تلطيخ (فعل تبقيع أو تلطيخ شيء ما) / بقعة, لطخة (جزء صغير مغاير في شيء ما)\nمثال: بقعة صلعاء",
 "macule": "لطخة جلدية (رقعة من الجلد متغيرة اللون ولكنها غير مرتفعة عادة؛ تسببها أمراض مختلفة)",
 "macumba": "ماكومبا (طائفة دينية برازيلية من أصل أفريقي؛ تجمع بين عناصر الفودو والغناء والترتيل والرقص) / ماكومبا (موسيقى رقص شعبية برازيلية؛ مستمدة من ممارسات طائفة ماكومبا الدينية) / ماكومبا ((البرازيل) أتباع طائفة دينية من أصل أفريقي)",
 "macushla": "حبيب القلب ((مصطلح تودد أيرلندي) حبيب)",
 "mad": "مَجْنُون",
 "mad apple": "باذنجان (خضار بيضاوي الشكل ذو جلد لامع عادة ما يكون أرجوانياً داكناً ولكن أحياناً أبيض أو أصفر) / باذنجان (عشب مشعر قائم موطنه جنوب شرق آسيا ولكنه يزرع على نطاق واسع لفاكهته اللحمية اللامعة الكبيرة المستخدمة عادة كخضروات)",
 "mad cow disease": "جُنُون البَقَر",
 "mad dog": "سَگِ دِيوانَہ",
 "mad-dog skullcap": "درقة الكلب المسعور, درقة زرقاء (نعناع أمريكي ينتج إفرازاً راتنجياً يستخدم خاصة في الماضي كمضاد للتشنج)",
 "mad-dog weed": "درقة الكلب المسعور, درقة زرقاء (نعناع أمريكي ينتج إفرازاً راتنجياً يستخدم خاصة في الماضي كمضاد للتشنج)",
 "madagascan": "مدغشقري (من أو متعلق بمدغشقر أو شعبها) / مَدْغَشْقَرِيّ, مَلْجاشِيّ (مواطن أو ساكن في مدغشقر)\nمثال: فلفل مدغشقري",
 "madagascar": "مَدَغَشْقَر (دولة وجزيرة قبالة ساحل إِفْرِيقِيَا الشرقي؛ اسمها الرسمي: جُمْهُورِيَّة مَدَغَشْقَر، وعاصمتها: أَنْتَانَانَارِيفُو)",
 "madagascar cat": "ليمور حلقي الذيل (ليمور صغير ذيله مخطط باللون الأسود)",
 "madagascar franc": "فرنك مدغشقري (وحدة المال الأساسية في مدغشقر)",
 "madagascar jasmine": "زهرة الشمع, ياسمين مدغشقر (كرمة خشبية ملتفة في مدغشقر ذات أوراق دائمة الخضرة شمعية داكنة سميكة وعناقيد من الزهور البيضاء الشمعية العطرة الكبيرة على طول السيقان؛ تزرع على نطاق…)",
 "madagascar pepper": "فلفل, فلفل أسود (نبات متسلق يحمل توتاً أحمر داكناً (حبوب الفلفل) عند النضج الكامل؛ جنوب الهند وسريلانكا؛ تم توطينه في شمال بورما وآسام)",
 "madagascar periwinkle": "عناقية, عين البزون (عشب خشبي من العالم القديم يزرع عادة وله أزهار كبيرة وردية إلى حمراء)",
 "madagascar plum": "برقوق الحاكم, برقوق مدغشقر (شجرة شجيرية صغيرة من مدغشقر تزرع في المناطق الاستوائية كنبات سياج ولثمارها الحمراء الداكنة الحمضية التي تشبه البرقوق الصغير)",
 "madake": "خيزران الخشب العملاق, ماداكي (خيزران كبير له سيقان سميكة الجدران؛ موطنه الصين وربما اليابان؛ يُزرع على نطاق واسع في أماكن أخرى)",
 "madam": "سَيِّدَة, سَيِّدَتِي",
 "madame": "سيدة, مدام (لقب يستخدم للمرأة الفرنسية المتزوجة)",
 "madcap": "طَائِش, مُتَهَوِّر (يتّسم بالتسرّع المفرط وعدم التفكير أو التروّي) / طائش, متهور (شخص متهور مندفع غير مسؤول)",
 "maddah": "مَدَّة",
 "maddened": "ثَائِر, مُسْتَشِيط (يتّسم بغضب شديد بالغ الحدّة)",
 "maddening": "مُثِير لِلْجُنُون, مُسْتَفِزّ (مزعج أو مثير للاستياء بشكل شديد)",
 "madder": "فُوَّة صَبْغِيَّة / فُوَّة",
 "madderwort": "فصيلة فوية, نبات فوي (أي من الأشجار أو الشجيرات أو الكروم العديدة من الفصيلة الفوية)",
 "made": "مُصَنَّع (مُنتَج عبر عملية تصنيع) / مرتب ((للسرير) تم ترتيب ملاءاته وبطانياته) / مَضْمُون النَّجَاح (ناجح أو مضمون النجاح في المستقبل)\nمثال: سرير مرتب بعناية",
 "made in china": "صُنِعَ فِي الصِّينِ (عَمِلَ شيئًا يعلم ويُجِيد كيفية عَمَلِه؛ فَعَلَ)\nمثال: صنع لي أبي رفا.",
 "made-to-order": "مُفَصَّلٌ حَسَبَ الطَّلَبِ ((عن الملابس) مصنوع حسب المقاس والطلب) / مَبْنِيٌّ حَسَبَ الطَّلَبِ (مُشيَّد خصيصاً لفرد معيَّن)",
 "made-up": "مُخْتَلَق",
 "madeira": "ماديرا",
 "madeira cake": "كعكة ماديرا (كعكة إسفنجية غنية ذات قوام متماسك)",
 "madeira sponge": "كعكة ماديرا (كعكة إسفنجية غنية ذات قوام متماسك)",
 "madeira winter cherry": "كرز الشتاء, كرز القدس (شجيرة صغيرة من أمريكا الجنوبية تزرع كنبات منزلي لثمارها الحمراء أو الصفراء الزخرفية الوفيرة ولكن السامة بحجم الكرز)",
 "mademoiselle": "فرخ فضي (سمكة طبل فضية صغيرة غالباً ما يُخطأ بينها وبين الفرخ الأبيض؛ توجد على طول سواحل الولايات المتحدة من نيويورك إلى المكسيك)",
 "madhhab": "مَذْهَب (المَذْهَب : بمعنى الذَهْاب، السَيْر، المَسْلَك، الإزَالَة؛ المَذْهَب: المُعْتَقَد الديني الذي يُذهب إليه)\nمثال: الوجودية مذهب إنساني.",
 "madhouse": "مارستان, مستشفى المجانين (مصطلحات تحقيرية لمصحة المجانين)",
 "madhya pradesh": "مَادِيَا بْرَادِيش",
 "madia elegans": "ماديا أنيقة, ماديا شائعة (نبات حولي كاليفورني له بقع بنية حمراء بالقرب من قاعدة أشعة زهوره الصفراء)",
