 "londonian": "لندني",
 "lone": "مُنَعْزِل",
 "lone hand": "منعزل, وحيد (شخص يتجنب رفقة أو مساعدة الآخرين)",
 "lone wolf": "منعزل, وحيد (شخص يتجنب رفقة أو مساعدة الآخرين)",
 "loneliness": "اِنْفِرَاد / عُزْلَة / وَحْدَة",
 "lonely": "وَحِيد, مُوحِش",
 "loner": "منعزل, وحيد (شخص يتجنب رفقة أو مساعدة الآخرين)",
 "lonesome": "مُسْتَوْحِش, وَحِيد (يَتَّسِمُ بِالحُزْنِ النَّاجِمِ عَنِ الوَحْدَة)",
 "lonesomeness": "انطواء, عزلة (ميل نحو البقاء وحيداً)",
 "long": "طَوِيل",
 "long ago": "قَدِيماً",
 "long ass": "طَوِيلٌ جِدًّا ((غير رسمي) طَوِيلٌ جِدًّا بِالمَعْنَى المَكَانِيِّ) / طَوِيلٌ جِدًّا زَمَنِيًّا ((غير رسمي) طَوِيلٌ جِدًّا بِالمَعْنَى الزَّمَنِيِّ)",
 "long beech fern": "سرخس الزان الشمالي, سرخس الزان الطويل (سرخس زان في أمريكا الشمالية وأوراسيا)",
 "long bone": "عظم طويل (في أطراف الفقاريات: عظم أسطواني طويل يحتوي على نخاع)",
 "long castle": "تبييت طويل (التبييت على جانب الوزير)",
 "long castling": "تبييت طويل (التبييت على جانب الوزير)",
 "long chain": "جزيء طويل السلسلة, سلسلة طويلة ((كيمياء) سلسلة طويلة نسبياً من الذرات في جزيء)",
 "long distance": "مكالمة بعيدة المدى, مكالمة دولية (مكالمة هاتفية تتم خارج منطقة الاتصال المحلية)\nمثال: تحدثت معها عبر مكالمة بعيدة المدى",
 "long division": "قسمة مطولة (عملية القسمة التي يتم فيها الإشارة إلى تسلسل الخطوات بالتفصيل)",
 "long dozen": "ثَلَاثَة عَشَر (العدد الأصلي الذي هو مجموع اثنا عشر وواحد)",
 "long fly": "طيران طويل (تمرين جمباز يتضمن قفزة طويلة من حصان القفز)",
 "long for": "اِشْتَاقَ",
 "long haul": "رحلة طويلة (رحلة لمسافة طويلة) / أمد بعيد, مدى طويل (فترة زمنية كافية لكي تظهر العوامل نتائجها)\nمثال: إنها رحلة طويلة من نيويورك إلى لوس أنجلوس",
 "long horse": "حصان القفز, حصان طويل (حصان جمباز بدون مقابض وبطرف ممدود؛ يستخدم طولياً للقفز)",
 "long hundred": "مِائَة طَوِيلَة (العدد الأصلي الذي هو حاصل ضرب عشرة في اثنا عشر)",
 "long hundredweight": "قنطار إنجليزي طويل (وحدة وزن بريطانية تعادل 112 رطلاً)",
 "long iron": "مضرب حديدي طويل (مضرب حديدي بعمود طويل ووجه حاد؛ لضرب التسديدات الطويلة المنخفضة)",
 "long johns": "ملابس داخلية طويلة (ملابس داخلية دافئة بأرجل طويلة)",
 "long jump": "قفز طويل, وثب طويل (فعل القفز لأبعد مسافة ممكنة من انطلاقة ركض) / القفز الطويل, الوثب الطويل (مسابقة تتضمن القفز لأبعد مسافة ممكنة انطلاقاً من الجري)",
 "long live": "يَحْيَا, تَحيا",
 "long measure": "مقياس طولي (مقياس للطول)",
 "long moss": "طحلب إسباني, لحية العجوز (أكاليل كثيفة من خيوط مرنة تشبه الشعر بلون رمادي مخضر مثبتة بجذوع الأشجار وفروعها بواسطة جذور سلكية متفرقة؛ جنوب شرق الولايات المتحدة وجزر الهند…)",
 "long pants": "بنطال طويل (سراويل تصل إلى القدم)",
 "long pepper": "دَارْفِلْفِل, دَار فِلْفِل",
 "long pillow": "مسند أسطواني (وسادة توضع غالباً عبر السرير أسفل الوسائد العادية)",
 "long plane": "رابوخ, مِسْحَج طويل (مسحج نجار طويل يستخدم لتشكيل حواف الألواح لتتناسب مع بعضها البعض)",
 "long run": "أمد بعيد, مدى طويل (فترة زمنية كافية لكي تظهر العوامل نتائجها)\nمثال: سننتصر على المدى الطويل",
 "long saphenous vein": "وريد صافن طويل, وريد صافن كبير (أطول وريد في الجسم؛ يمتد من القدم إلى المغبن حيث ينضم إلى الوريد الفخذي)",
 "long seax": "ساكس طويل, سيف الساكس الطويل (سيف ساكس يتميز بمقبض طويل ونصل ملحوم بنمط معين يبلغ طوله 50 سم أو أكثر، غالباً مع عدة أخاديد وحزوز)\nمثال: حافة الساكس الطويل تكون مستقيمة بشكل عام، أو منحنية قليلاً نحو الطرف",
 "long shot": "قَلِيْلُ ٱلاِحْتِمالِ (ما كان عدده صغيرا؛ متبوعًا بمِنْ: عدد صغير أو كمية صغيرة من الشيء)\nمثال: و بعد قليل أتى.",
 "long since": "قديماً, منذ زمن بعيد (من الماضي البعيد أو البعيد نسبياً)\nمثال: التقينا مرة منذ زمن بعيد",
 "long sleeve": "كم طويل (كم يمتد من الكتف إلى المعصم)",
 "long story short": "القصة بإختصار",
 "long suit": "تَخَصُّص, مَوْطِن قُوَّة (ميزة ذات قيمة أو فائدة خاصة) / بدلة طويلة, نقشة طويلة (في يد اللعب، النقشة (أو اللون) التي تحتوي على أكبر عدد من البطاقات)\nمثال: الطبخ هو نقطة قوته",
 "long time": "دهر, سنوات (فترة زمنية طويلة)\nمثال: نحن نعرف بعضنا منذ دهر",
 "long time no see": "لَم أَرَكَ مُنْذُ وَقْت طَوِيل, لَم أَرَكِ مُنْذُ وَقْت طَوِيل (جَمَعَ، ضَمَّ)\nمثال: لم يساعدني أحد.",
 "long tom": "المدفع الطويل (مدفع طويل دوار كان تستخدمه البحرية سابقاً)",
 "long ton": "طن إنجليزي, طن طويل (وحدة وزن بريطانية تعادل 2240 رطلاً)",
 "long trousers": "بنطال طويل (سراويل تصل إلى القدم)",
 "long underwear": "ملابس داخلية طويلة, يونيو سوت (رداء داخلي يتكون من قميص وسروال في قطعة واحدة)",
 "long vowel": "حركة طويلة, صائت طويل (صائت يتم نطقه عادة لفترة أطول نوعاً ما من الصوائت الأخرى (عادة حوالي 1.5 إلى ضعف الطول))",
 "long wave": "موجة طويلة (موجة راديوية بطول موجي أطول من كيلومتر واحد (تردد أقل من 300 كيلو هرتز))",
 "long whist": "ويست (لعبة ورق لأربعة لاعبين يشكلون شراكتين؛ يتم توزيع حزمة من 52 ورقة ويسجل كل جانب نقطة واحدة لكل جولة يأخذها تزيد عن ستة)",
 "long-acting": "طَوِيل المَفْعُول (فَعَّال عَلى مَدى فَتْرَة زَمَنِيَّة طَويلَة)",
 "long-ago": "مِنْ زَمَن بَعِيد (ينتمي إلى زمن غابر ومضى)",
 "long-armed": "طَوِيل الذِّرَاعَيْن (ذو ذراعين طويلتين نسبيًّا)",
 "long-beard": "إبريق ملتحي, بيلارمين (إبريق شرب خزفي ذو عنق طويل؛ مزين برسم كاريكاتوري للكاردينال بيلارمين)",
 "long-billed marsh wren": "نمنمة المستنقعات طويلة المنقار (نمنمة أمريكية تعيش في أحواض القصب الطويلة)",
 "long-bodied": "طَوِيلُ الجَسَد (لَهُ جَسَدٌ طَوِيلٌ نِسْبِيًّا)",
 "long-branched": "طَوِيلُ الأَغْصَان (لَهُ أَغْصَانٌ طَوِيلَة)",
 "long-chain": "طويل السلسلة (للجزيئات التي تحتوي على سلاسل طويلة نسبياً من الذرات)",
 "long-chain molecule": "جزيء طويل السلسلة, سلسلة طويلة ((كيمياء) سلسلة طويلة نسبياً من الذرات في جزيء)",
 "long-clawed prawn": "قريدس طويل المخالب (قريدس مياه عذبة كبير (قدم أو أكثر) صالح للأكل شائع في الأنهار الأسترالية)",
 "long-dated": "طَوِيل الأَجَل (لَهُ أَكْثَر مِن خَمْسَ عَشْرَة سَنَة قَبْلَ تاريخ الاِسْتِحْقاق)",
 "long-distance": "بَعِيد المَدَى (يغطي مسافة طويلة) / بعيد المسافة, طويل المدى (مكون من أو متعلق بـ أو كونه مكالمة هاتفية بعيدة المسافة)\nمثال: مكالمة بعيدة المسافة",
 "long-distance call": "مكالمة بعيدة المدى, مكالمة دولية (مكالمة هاتفية تتم خارج منطقة الاتصال المحلية)\nمثال: تحدثت معها عبر مكالمة بعيدة المدى",
 "long-distance runner": "عداء ماراثون, عداء مسافات طويلة (شخص يشارك في سباقات المسافات الطويلة (خاصة في الماراثون))",
 "long-eared bat": "خفاش طويل الأذن (أي من الخفافيش المتنوعة في العالم القديم أو الجديد ذات آذان طويلة جداً)",
 "long-eared owl": "بومة أذناء",
 "long-faced": "طَوِيل الوَجْه (ذو وجه أطول من المعتاد)",
 "long-familiar": "مَأْلُوف مُنْذُ زَمَن, مَعْرُوف جِدًّا (يُصَادَف كَثِيرًا؛ مَعْرُوف عَنْ قُرْب أَوْ بِشَكْلٍ حَمِيم)",
 "long-fin tunny": "باكور, تونة بيضاء (تونة كبيرة تعيش في عرض البحر وهي مصدر معظم التونة المعلبة؛ تصل إلى 93 رطلاً ولها زعانف صدرية طويلة؛ توجد في جميع أنحاء العالم في المياه الاستوائية…)",
 "long-haired": "طَوِيل الشَّعْر (ذو شعر طويل)",
 "long-handled": "ذُو مِقْبَض طَوِيل (لَهُ مِقْبَض أَوْ يَد طَويلَة)",
 "long-handled spade": "مجرفة الخنادق (مجرفة ذات مقبض طويل لحفر الخنادق الضيقة)",
 "long-head coneflower": "زهرة الصنوبرية طويلة الرأس, زهرة صنوبرية البراري (نبات يشبه زهرة القبعة المكسيكية؛ من كولومبيا البريطانية إلى نيو مكسيكو)",
 "long-headed": "مُسْتَطِيل الرَّأْس (ذُو رَأْسٍ طَوِيلٍ ضَيِّقٍ (طَوِيل الرَّأْس))",
 "long-horned beetle": "خنفساء طويلة القرون (خنفساء طويلة الجسم لها قرون استشعار طويلة جداً)",
 "long-horned grasshopper": "جندب طويل القرون (جنادب ذات قرون استشعار طويلة تشبه الخيوط وأعضاء صرير متطورة على الأجنحة الأمامية للذكر)",
 "long-jawed": "طَوِيلُ الفَكِّ (لَهُ فَكٌّ طَوِيلٌ نِسْبِيًّا)",
 "long-lasting": "دَائِم طَوِيْلًا",
 "long-legged": "طَوِيل السَّاقَيْن (ذو ساقين طويلتين)",
 "long-legs": "أبو المغازل (طائر خوض طويل الساقين ثلاثي الأصابع أسود وأبيض يعيش في البرك الداخلية والمستنقعات أو البحيرات قليلة الملوحة)",
 "long-life": "طَوِيل الصَّلَاحِيَة ((في السلع القابلة للتلف) مُعالَج لِيَبْقى طازَجًا لِفَتْرَة أَطْوَل)",
 "long-lived": "دَائِم, طَوِيل الأَمَد (مَوْجود مُنْذُ فَتْرَة طَويلَة وَيَسْتَمِرّ)",
 "long-neck clam": "محار ناعم الصدفة (محار صالح للأكل بصدفة رقيقة بيضاوية الشكل يوجد في المناطق الساحلية للولايات المتحدة وأوروبا) / بطلينوس ناعم القشرة (بطلينوس يطهى عادة بالبخار في قشرته)",
 "long-necked": "أَتْلَع ((أَتْلَعَ) الْحَيَوَانُ وَالْإِنْسَانُ: تَلَعَ؛ (أَتْلَعَ) الرجلُ: مد عُنُقه)",
 "long-play": "طَوِيل المُدَّة ((عَنِ الأَسْطُوَانَات) تُعْزَف بِسُرْعَة أَبْطَأ وَلِفَتْرَة أَطْوَل)",
 "long-playing": "طَوِيل المُدَّة ((عَنِ الأَسْطُوَانَات) تُعْزَف بِسُرْعَة أَبْطَأ وَلِفَتْرَة أَطْوَل)",
 "long-range": "بَعِيد المَدَى (مُناسِب لِلوُصول إلى مَسافات بَعيدَة) / بَعِيد المَدَى (يَشْمَل فَتْرَة زَمَنِيَّة مُمْتَدَّة)",
 "long-run": "شِبْه دَائِم, طَوِيل الأَمَد (مُتَعَلِّق بِفَتْرَة زَمَنِيَّة طَويلَة نِسْبِيًّا أَوْ مُمْتَدّ عَلَيْها)",
 "long-shanked": "طَوِيل السَّاقَيْن (ذو ساقين طويلتين)",
 "long-snouted": "طَوِيل الخَطْم (ذو خَطْم أَطْوَل مِنَ المُعْتاد)",
 "long-spurred": "طويل المهماز (للزهور التي لها امتداد طويل عند قاعدة التويج)",
 "long-spurred violet": "بنفسج طويل المهماز (بنفسج من شرق أمريكا الشمالية له زهور أرجوانية ليلكية بمهماز رفيع طويل)",
 "long-stalked": "طَوِيل السَّاق, طَوِيل العُنُق ((للنباتات) ذو سيقان طويلة نسبيًا)",
 "long-standing": "عَرِيق, قَدِيم العَهْد (مَوْجود مُنْذُ فَتْرَة طَويلَة)",
 "long-staple": "طَوِيل الأَلْيَاف (ذو أَلْياف طَويلَة نِسْبِيًّا)",
 "long-staple cotton": "قطن طويل التيلة (قطن ذو ألياف طويلة نسبياً)",
 "long-sufferance": "صبر طويل, طول أناة (تحمل صبور للألم أو التعاسة)",
 "long-suffering": "صَبُور, طَوِيلُ البَال (يَتَحَمَّلُ بِصَبْرٍ الظُّلْمَ أَوِ المَتَاعِبَ المُسْتَمِرَّة) / صبر طويل, طول أناة (تحمل صبور للألم أو التعاسة)",
 "long-tailed porcupine": "شيهم طويل الذيل (شيهم من بورنيو وسومطرة ذو أشواك قصيرة وذيل طويل)",
 "long-tailed tit": "قُرْقُف طَوِيل الذِّيل",
 "long-tailed weasel": "ابن عرس طويل الذيل (ابن عرس أمريكي شائع يتميز بحجم كبير وذيل أسود الطرف)",
 "long-term": "شِبْه دَائِم, طَوِيل الأَمَد (مُتَعَلِّق بِفَتْرَة زَمَنِيَّة طَويلَة نِسْبِيًّا أَوْ مُمْتَدّ عَلَيْها)",
 "long-term investment": "استثمار طويل الأجل (ممارسة شراء وحفظ ورقة مالية أو محفظة أو استراتيجية استثمار لمدة تزيد عن عام واحد)",
 "long-term memory": "ذاكرة طويلة المدى (مخزونك العام من المعلومات المتذكرة)",
 "long-tongued bat": "مَضَّاص",
 "long-wearing": "مَتِين, مُقَاوِم لِلتَّآكُل (قادر على تحمّل البِلى والتآكل والتلف)",
 "long-winded": "إِطْنَابِيّ, ثَرْثَار (يَسْتَخْدِمُ أَوْ يَحْتَوِي عَلَى كَلِمَاتٍ أَكْثَرَ مِمَّا يَنْبَغِي)",
 "long-windedly": "بإسهاب, بإطناب (بطريقة مسهبة وكثيرة الكلام)\nمثال: شرحت أفكارها بإسهاب",
 "long-windedness": "تطويل ممل, ثرثرة (إطناب ممل)",
 "long-wool": "طَوِيل الصُّوف ((في الأغنام) ذو صوف طَويل نِسْبِيًّا)",
 "long-wooled": "طَوِيل الصُّوف ((في الأغنام) ذو صوف طَويل نِسْبِيًّا)",
 "longan": "لونجان, لونغان (شجرة من جنوب شرق آسيا إلى أستراليا تزرع أساساً لفاكهتها الحلوة الصالحة للأكل التي تشبه مكسرات الليتشي)",
 "longanberry": "عين التنين, لونجان (فاكهة آسيوية تشبه الليتشي) / لونجان, لونغان (شجرة من جنوب شرق آسيا إلى أستراليا تزرع أساساً لفاكهتها الحلوة الصالحة للأكل التي تشبه مكسرات الليتشي)",
 "longanimity": "أناة, حلم (تحمل طيب لتأخير أو عدم كفاءة)",
 "longanimous": "أَنَاةٌ, حَلِيم (يُظْهِرُ ضَبْطَ النَّفْسِ وَالتَّحَمُّلَ فِي الشَّدَائِدِ؛ بَطِيءٌ فِي الانْتِقَام)",
 "longar palm": "دوم, نخلة تدمر (نخيل مروحي طويل من أفريقيا والهند وماليزيا ينتج خشباً صلباً وعصارة حلوة تعد مصدراً لنبيذ النخيل والسكر؛ وتستخدم الأوراق للتسقيف والنسيج)",
 "longbeard": "إبريق ملتحي, بيلارمين (إبريق شرب خزفي ذو عنق طويل؛ مزين برسم كاريكاتوري للكاردينال بيلارمين)",
 "longboat": "قارب طويل (أكبر قارب تحمله سفينة شراعية تجارية)",
 "longbow": "قوس طويل (قوس خشبي قوي يُسحب باليد؛ يبلغ طوله عادة 5-6 أقدام؛ استخدم في إنجلترا في العصور الوسطى)",
 "longbowman": "رامي القوس الطويل (رامي سهام إنجليزي في العصور الوسطى استخدم القوس الطويل)",
 "longcase clock": "ساعة الجد, ساعة بندولية طويلة (ساعة بندولية مغلفة في صندوق طويل ضيق)",
 "longed-for": "مُتَوَقّ إِلَيْه, مُشْتَاق إِلَيْه (مرغوب فيه بشدّة وشوق عظيم)",
 "longer": "لفترة أطول (لمزيد من الوقت) / تَوَّاق, مُتَلَهِّف (شخص لديه رغبة قوية في شيء ما)\nمثال: هل يمكنني البقاء لفترة أطول قليلاً؟",
 "longest": "لأطول فترة (لأكثر وقت)\nمثال: بقيت لأطول فترة",
 "longevity": "أقدمية, طول العمر (خاصية العيش طويلاً) / تعمير, طول الخدمة (مدة الخدمة أو البقاء)\nمثال: طول بقائها كنجمة",
 "longfin mako": "ماكو طويل الزعنفة (يشبه الماكو قصير الزعنفة ولكنه أزرق داكن أكثر)",
 "longhand": "مَكْتُوبٌ بِالتَّفْصِيل (مكتوب بالكلمات كاملة بخطّ اليد دون اختصار) / خط متصل, كتابة متصلة (كتابة يدوية سريعة تُكتب فيها الحروف كاملة وتتصل ببعضها بشكل انسيابي داخل الكلمات دون رفع أداة الكتابة عن الورقة)",
 "longheaded thimbleweed": "شقيقة النعمان النهرية (شقيقة نعمان من شمال أمريكا الشمالية)",
 "longhorn": "تكساس لونغ هورن, لونغ هورن (ماشية لحم طويلة القرون كانت شائعة سابقاً في جنوب غرب الولايات المتحدة)",
 "longhorn beetle": "قَرَنْبَى",
 "longicorn": "خنفساء طويلة القرون (خنفساء طويلة الجسم لها قرون استشعار طويلة جداً)",
 "longicorn beetle": "خنفساء طويلة القرون (خنفساء طويلة الجسم لها قرون استشعار طويلة جداً)",
 "longing": "شَوْق (نزوعُ النَّفْس إِلى الشيء، أو تَعَلُّقها به؛ مصدر الفعل شَاقَ)\nمثال: سأشعر بالشوق إليك.",
 "longingly": "بشوق, بلهفة (بطريقة مشتاقة)\nمثال: قضى بقية الفصل يحدق بشوق فوق كتفي الأيمن إلى كلمة (خروج) المضاءة",
 "longish": "طَوِيل نَوْعًا مَا (أَطْوَل بِقَليل مِنَ المُعْتاد)",
 "longitude": "خَطّ طُول (كِتَابَة؛ ما يَصِل نقطتين أو أكثر)\nمثال: إرسم خط مستقيم.",
 "longitudinal": "طُولِيّ, مُمْتَدّ زَمَنِيًّا (يَمْتَدّ عَلى فَتْرَة زَمَنِيَّة طَويلَة) / طُولَانِيّ, طُولِيّ (يَمْتَدّ في اتِّجاه الطُّول) / طولي (متعلق بخطوط الطول)\nمثال: حساب طولي بواسطة الملاح",
 "longitudinally": "طولياً (فيما يتعلق بالطول أو خط الطول) / طولياً (في اتجاه الطول) / تتبعياً, طولياً (عبر الزمن (دراسة))\nمثال: مُقاس طولياً",
 "longleaf pine": "صنوبر أصفر جنوبي, صنوبر طويل الأوراق (صنوبر كبير ثلاثي الإبر من جنوب شرق الولايات المتحدة له إبر طويلة جداً وأطراف ملتوية معقدة؛ اللحاء بني محمر مخدد بعمق؛ شجرة خشب مهمة)",
 "longlegs": "أبو المغازل (طائر خوض طويل الساقين ثلاثي الأصابع أسود وأبيض يعيش في البرك الداخلية والمستنقعات أو البحيرات قليلة الملوحة)",
 "longness": "طول المدة (المدة كامتداد) / طُول (خاصية الامتداد المكاني الطويل)\nمثال: جين واحد يسبب القصر والآخر يسبب الطول",
 "longroot": "رملية صنوبرية, طويلة الجذر (نبات معمر عميق الجذور في جنوب شرق الولايات المتحدة)",
 "longship": "سفينة فايكنغ طويلة (نوع من السفن اخترعه واستخدمه الفايكنج للتجارة والاستكشاف والحرب خلال عصر الفايكنج)\nمثال: كان للسفن الطويلة وسيلتان للدفع: المجاديف والشراع",
 "longshoreman": "عامل ميناء (عامل ذكر يقوم بتحميل وتفريغ السفن في الميناء)",
 "longshorewoman": "عاملة ميناء (عاملة أنثى تقوم بتحميل وتفريغ السفن في الميناء)",
 "longshot": "لقطة بعيدة (صورة فوتوغرافية ملتقطة من مسافة بعيدة)",
 "longsighted": "بَعِيدُ النَّظَر, مُتَبَصِّر (يُخَطِّط بحكمة للمستقبل) / بَعِيد النَّظَر, حَادّ البَصَر (قادر على رؤية الأشياء البعيدة بوضوح)",
 "longsightedness": "طول النظر, مد البصر (حالة غير طبيعية تكون فيها الرؤية للأشياء البعيدة أفضل من الأشياء القريبة)",
 "longstanding": "عَرِيق, قَدِيم العَهْد (مَوْجود مُنْذُ فَتْرَة طَويلَة)",
 "longtail weasel": "ابن عرس طويل الذيل (ابن عرس أمريكي شائع يتميز بحجم كبير وذيل أسود الطرف)",
 "longueur": "فترة ملل (فترة من الرتابة أو الملل (خاصة في عمل أدبي أو فني))",
 "longways": "طولياً (في اتجاه الطول) / رقص الصفوف الطويلة (رقص ريفي يؤدى بأزواج في خطين طويلين يواجهان بعضهما البعض)\nمثال: قطع الورقة طولياً",
 "longways dance": "رقص الصفوف الطويلة (رقص ريفي يؤدى بأزواج في خطين طويلين يواجهان بعضهما البعض)",
 "longwise": "طولياً (في اتجاه الطول)\nمثال: قطع الورقة طولياً",
 "longwool": "طويل الصوف (خروف مستأنس طويل الصوف)",
 "longyi": "إزار, لونغي (قطعة طويلة من القماش زاهي الألوان (قطن أو حرير) تستخدم كملابس (تنورة أو مئزر أو وشاح إلخ) في الهند وباكستان وبورما)",
 "lonicera albiflora": "صريمة الجدي البيضاء, عسلة بيضاء (عسلة كثيفة بفروع ملتفة وزهور بيضاء أو بيضاء مصفرة؛ جنوب الولايات المتحدة)",
 "lonicera canadensis": "صريمة الجدي الأمريكية, عسلة أمريكية (شجيرة أمريكية شمالية متساقطة الأوراق قائمة بزهور بيضاء مصفرة)",
 "lonicera caprifolium": "صريمة الجدي الإيطالية, عسلة إيطالية (شجيرة متسلقة متساقطة الأوراق بزهور بيضاء مصفرة عطرة في دوامات إبطية)",
 "lonicera dioica": "صريمة الجدي الصفراء, عسلة صفراء (شجيرة متساقطة الأوراق ملتفة بعناقيد من الزهور الخضراء المصفرة المشوبة بالأرجواني؛ شمال شرق أمريكا)",
 "lonicera flava": "عسلة صفراء (شجيرة متساقطة الأوراق متسلقة بزهور صفراء عطرة (تصبح برتقالية لاحقاً) في دوامات طرفية؛ جنوب شرق الولايات المتحدة)",
 "lonicera hirsuta": "عسلة مشعرة (شجيرة متساقطة الأوراق ملتفة بأوراق مشعرة وسنابل من الزهور الصفراء البرتقالية؛ شمال شرق أمريكا)",
 "lonicera involucrata": "توت التوأم, عسلة غلافية (عسلة شجيرية بزهور أرجوانية؛ غرب أمريكا الشمالية)",
 "lonicera japonica": "صريمة الجدي اليابانية, عسلة يابانية (عسلة آسيوية دائمة الخضرة زاحفة بأوراق نصف دائمة الخضرة وزهور بيضاء عطرة تتحول إلى صفراء مع تقدم العمر؛ أصبحت عشباً ضاراً في بعض المناطق)",
 "lonicera japonica halliana": "عسلة هول (صنف من العسلة اليابانية ينمو ككرمة؛ استقرت كهارب عدواني في جنوب شرق الولايات المتحدة)",
 "lonicera morrowii": "عسلة مورو (شجيرة عسلة متساقطة الأوراق رمادية بزهور بيضاء مزدوجة تتحول إلى صفراء؛ اليابان)",
 "lonicera periclymenum": "خشب العنب, عسلة متسلقة (عسلة أوروبية ملتفة بزهور حمراء وصفراء بيضاء عطرة)",
 "lonicera sempervirens": "عسلة البوق, عسلة مرجانية (كرمة عسلة أمريكية شمالية دائمة الخضرة لها زهور حمراء مرجانية أو برتقالية)",
 "lonicera tatarica": "عسلة تترية, عسلة شجيرية (شجيرة عسلة من جنوب روسيا إلى وسط آسيا)",
 "lonicera xylosteum": "عسلة أوروبية (شجيرة أوراسية مزروعة بزهور بيضاء مصفرة مزدوجة وثمار قرمزية)",
 "loniten": "روجين, مينوكسيديل (موسع للأوعية الدموية (الاسم التجاري لونيتين) يستخدم لعلاج ارتفاع ضغط الدم الشديد؛ أحد آثاره الجانبية هو الشعرانية لذلك يباع أيضاً (الاسم التجاري…)",
 "lontar": "دوم, نخلة تدمر (نخيل مروحي طويل من أفريقيا والهند وماليزيا ينتج خشباً صلباً وعصارة حلوة تعد مصدراً لنبيذ النخيل والسكر؛ وتستخدم الأوراق للتسقيف والنسيج)",
 "loo": "بيت الراحة, مرحاض (مرحاض (مصطلح بريطاني))",
 "loofa": "لوف (الجزء الليفي المجفف من ثمرة نبات من جنس اللوف؛ يستخدم كإسفنجة للغسيل أو مصفاة)",
 "loofah": "لِيف, لُوف",
 "look": "بَدَا (ظَهَرَ) / نَظْرَة, شوفة / مَرْأىً, مَرْآة\nمثال: بدا سامي مريضا.",
 "look after": "اِهْتَمَّ, اِعْتَنَى",
 "look around": "تَلَفَّتَ",
 "look at": "نَظَرَ (اِسْتَعْمَلَ عينه ليَرَى الشيءَ، ليُدْرِكَه ويُبْصِرَه. (مَصْدَرُهُ نَظَر)؛ (يتعدى تعدية عامة بإلى))\nمثال: نظر إلى السماء.",
 "look away": "غضّ النظر, غضّ الطرف",
 "look back": "اِلْتَفَتَ, اِسْتَدَارَ",
 "look down on": "تَرَفَّعَ",
 "look for": "بَحَثَ, فَتَّشَ (طَلَب الشيء في التُرَاب؛ طلب الشيء في أي مكان والتَفْتِيش والتَقَصِّي عنه)\nمثال: بدأ زيري البحث.",
 "look like": "شَبِهَ, بَدَا",
 "look out": "حا َسـِب",
 "look up": "بَحَثَ (طَلَب الشيء في التُرَاب؛ طلب الشيء في أي مكان والتَفْتِيش والتَقَصِّي عنه)\nمثال: بدأ زيري البحث.",
 "look-alike": "مُتَشَابِه المَظْهَر (يُشْبِه شَيْئًا آخَر في الشَّكْل الخارِجِيّ) / شَبِيه, نُسْخَة طِبْق الْأَصْل (شخص يشبه إلى حد كبير شخصية مشهورة (خاصة ممثل))\nمثال: يمكن أن يكون شبيه غينغريتش",
 "look-over": "فحص سريع, نظرة سريعة (فحص أو تفتيش سريع وعابر)\nمثال: ألقيت عليه نظرة سريعة",
 "lookalike": "شَبِيه",
 "lookdown": "سمكة لوك داون (تشبه سمكة القمر ولكن عيونها مرتفعة على الجبهة المقطوعة)",
 "lookdown fish": "سمكة لوك داون (تشبه سمكة القمر ولكن عيونها مرتفعة على الجبهة المقطوعة)",
 "looker": "حسناء, فاتنة (امرأة جذابة جداً أو مغرية المظهر) / شاهد, متفرج (مراقب عن كثب؛ شخص ينظر إلى شيء ما (مثل عرض من نوع ما))\nمثال: صفق المتفرجون للأداء",
 "looker-on": "متفرج (شخص ينظر ويراقب)",
 "looking": "مشاهدة, نظر (فعل توجيه العينين نحو شيء ما وإدراكه بصرياً) / بحث بصري, نظر (فعل البحث بصرياً) / ذُو صَوْت, ذُو مَظْهَر (يبدو كما يُوصَف؛ يُستخدَم عادةً في التراكيب المركّبة)\nمثال: خرج ليلقي نظرة",
 "looking at": "مشاهدة, نظر (فعل توجيه العينين نحو شيء ما وإدراكه بصرياً)\nمثال: خرج ليلقي نظرة",
 "looking for": "بحث بصري, نظر (فعل البحث بصرياً)",
 "looking glass": "مرآة (مرآة؛ عادة مرآة تزيين للسيدات)",
 "looking glass tree": "شجرة المرآة, هريتييرا كبيرة الأوراق (شجرة دائمة الخضرة كبيرة من الهند وبورما أوراقها فضية من الأسفل)",
 "looking-glass plant": "نبات المرآة, هريتييرا ساحلية (شجرة صغيرة في المناطق الساحلية من المناطق الاستوائية في العالم القديم أوراقها فضية من الأسفل)",
 "lookout": "نَاطُور",
 "lookout man": "مراقب (شخص ذكر موظف للمراقبة تحسباً لحدث متوقع)",
 "lookout station": "برج مراقبة, مرصد (هيكل يطل على مشهد واسع لمحيطه)",
 "lookout woman": "مراقبة (شخص أنثى موظفة للمراقبة تحسباً لحدث متوقع)",
 "lookup": "بحث (عملية تحدد ما إذا كان عنصر واحد أو أكثر من مجموعة عناصر يمتلك خاصية محددة)\nمثال: كتبوا برنامجاً للبحث في الجدول",
 "loom": "مِنْسَج",
 "loon": "غواص (طائر غواص كبير بدائي نوعاً ما آكل للأسماك من نصف الكرة الشمالي ذو أقدام مكففة موضوعة بعيداً في الخلف؛ قريب من الغطاس) / أحمق كسول (زميل كسول لا قيمة له) / أبله, عقل العصفور (شخص ذو أفكار مشوشة؛ غير قادر على التفكير الجاد)",
 "looney": "مَجْنُون, مَخْبُول (شخص مضطرب عقلياً وربما خطير)",
 "loonie": "دولار كندي (وحدة المال الأساسية في كندا)\nمثال: يحتوي الدولار الكندي على صورة طائر الغواص على جانب واحد من العملة المعدنية",
 "loony": "مَخْبُول, مَعْتُوه ((غير رسمي) مصطلحات عامّيّة تصف الاضطراب العقليّ) / مَجْنُون, مَخْبُول (شخص مضطرب عقلياً وربما خطير)",
 "loony bin": "مارستان, مستشفى المجانين (مصطلحات تحقيرية لمصحة المجانين)",
 "loony toons": "أسيد, حمض (اسم دارج لثنائي إيثيل أميد حمض الليسرجيك)",
 "loop": "عُرْوَة, عُقْدَة",
 "loop gain": "كسب الحلقة ((في الاتصالات) كسب مضخم أو نظام التغذية المرتدة كدالة لمقدار المخرجات التي يتم إرجاعها إلى المدخلات)\nمثال: إذا كان كسب الحلقة كبيراً جداً فقد يدخل النظام في حالة تذبذب",
 "loop knot": "عقدة حلقية (أي من العقد المختلفة المستخدمة لعمل حلقة ثابتة في حبل)",
 "loop topology": "طوبولوجيا الحلقة (طوبولوجيا شبكة تكون مكوناتها متصلة بالتسلسل بحيث يتصل المكون الأخير بالمكون الأول)",
 "loop-line": "خط حلقي (خط فرعي للسكة الحديدية يتفرع من الخط الرئيسي ثم ينضم إليه لاحقاً)",
 "loop-the-loop": "حلقة, دوران حلقي (مناورة طيران؛ حيث تطير الطائرة في دائرة كاملة في المستوى الرأسي)",
 "looper": "دودة شبرية, دودة قياسة (يسروع صغير أملس له أرجل فقط في قطاعاته الأمامية والخلفية؛ معظمها يرقات لعث من عائلة الأرفية)",
 "loophole": "فتحة الرمي, مزغل (ثقب صغير في جدار محصن؛ للمراقبة أو إطلاق الأسلحة) / ثغرة (غموض (خاصة في نص قانون أو عقد) يجعل من الممكن التهرب من صعوبة أو التزام)",
 "looping": "تكرار, حلقة تكرارية ((في علم الحاسوب) تنفيذ نفس مجموعة التعليمات لعدد معين من المرات أو حتى الحصول على نتيجة محددة)\nمثال: يتم الحصول على الحل عن طريق التكرار",
 "loopy": "مَخْبُول, مَعْتُوه ((غير رسمي) مصطلحات عامّيّة تصف الاضطراب العقليّ) / حلقي, عروي (مكون من أو مغطى بـ أو لديه حلقات (عراوي))",
 "loose": "فَضْفَاض, واسِع",
 "loose cannon": "شَخْص مُنْفَلِت, مَصْدَر خَطَر غَيْر مَضْبُوط (شخص يُتوقع منه أداء مهمة معينة لكنه يخرج عن السيطرة ويصبح خطيراً)",
 "loose end": "عمل غير منجز, مسائل عالقة (عمل تُرِك غير مكتمل)",
 "loose man": "رجل لعوب, زانٍ (زانٍ ذكر)",
 "loose sentence": "جملة مفككة (جملة معقدة تأتي فيها الجملة الرئيسية أولاً وتتبعها الجملة التابعة)",
 "loose smut": "تفحم سائب (فطر تفحم من جنس أوستيلاجو يسبب مرض التفحم في الحبوب حيث تتحول السنبلة بأكملها إلى كتلة غبارية من الأبواغ) / تفحم سائب (مرض يصيب الحبوب؛ حيث يتحول الرأس بالكامل إلى كتلة مغبرة من الأبواغ)",
 "loose woman": "زانية, فاجرة (امرأة ترتكب الزنا)",
 "loose-fitting": "فَضْفَاض, وَاسِع (غَيْر مُحْكَم؛ يَتَدَلَّى بِشَكْل فَضْفاض)",
 "loose-jointed": "مُفَكَّكُ المَفَاصِل (مُتَرَاخِي التَّرْكِيبِ أَوِ البِنَاء)",
 "loose-jowled": "مُتَرَهِّل الفَكّ, مُزْدَوَج الذَّقْن (لَدَيْه طَيَّات لَحْمِيَّة مُتَدَلِّيَة تَحْتَ الذَّقْن أَوِ الفَكّ السُّفْلِيّ)",
 "loose-leaf lettuce": "خس مفكك الأوراق, خس ورقي (خس ذو أوراق مجعدة بشكل فضفاض لا تشكل رأساً مضغوطاً)",
 "looseleaf": "ذُو أَوْرَاق سَائِبَة (ذو أوراق يمكن إزالتها أو إعادة ترتيبها بسهولة)",
 "loosely": "بارتخاء, بشكل فضفاض (مفتوح هيكلياً وغير مدمج أو مغلق) / برخاوة (بطريقة مرتخية؛ ليست صلبة) / بشكل واسع, بمعنى واسع (دون النظر إلى تفاصيل محددة أو استثناءات) / بشكل غير وثيق, بشكل فضفاض (بطريقة غير محكمة)\nمثال: نسيج منسوج برخاوة",
 "loosely knit": "فَضْفَاض الرَّوَابِط (ذو روابط اجتماعية أو قانونية بعيدة فحسب)",
 "loosen": "أَرْخَى, حَلَّ",
 "loosened": "مَفْكُوك, مُنْحَلّ (تم فك تشابكه واستقامته)",
 "looseness": "انحلال, فجور (انغماس منحل في الملذات الحسية) / تَخَلْخُل, حَرَكَة حُرَّة (حركة أو مساحة للحركة (خاصة في الأجزاء الميكانيكية)) / انْفِلَات, تَحَرُّر (صفة قابلية الحركة بحكم التحرر من الارتباط أو القيود الأخرى) / تَرَاخٍ, تَسَيُّب (نقص الدقة الصارمة؛ التساهل في الممارسة)\nمثال: كان هناك الكثير من التخلخل في عجلة القيادة",
 "looseness of the bowels": "إسهال (حركات أمعاء متكررة ومائية؛ يمكن أن تكون عرضاً لعدوى أو تسمم غذائي أو التهاب القولون أو ورم في الجهاز الهضمي)",
 "loosening": "إرخاء, توسيع (عملية جعل الشيء أقل ضيقاً) / استرخاء, تراخي (حدوث ضعف في السيطرة أو القوة)\nمثال: تخفيف المتطلبات",
 "loosestrife": "حل الوكاء, ليسمكية (للعقدة: ضد عَقْدها؛ للجامد في السائل: إذابته) / عشبة الصفصاف (أي من العديد من الأعشاب والشجيرات الصغيرة من جنس ليثروم)\nمثال: حل زيري المشكل.",
 "loot": "نَهَبَ",
 "looted": "مَسْلُوب, مَنْهُوب (فُرِّغَ ظُلْمًا مِنْ كُلّ مَا لَهُ قِيمَة)",
 "looter": "سالب, ناهب (شخص يأخذ الغنائم أو الأسلاب (كما في الحرب))",
 "looting": "تعفيش, نهب (النهب أثناء أعمال الشغب أو في زمن الحرب)",
 "lop": "قَلَّمَ (قَطَعَ جزءا من شيء لتزيينه وتحسينه)\nمثال: ارسم بقلم رصاص.",
 "lop-eared": "مُتَدَلِّي الأُذُنَيْن (له أذنان مُنحنيتان أو متدلّيتان)",
 "lope": "ركض خفيف (مشية سلسة ثلاثية الضربات؛ بين الخبب والعدو) / هرولة (وتيرة جري بطيئة)",
 "lophius americanus": "سمكة الصنارة, سمكة الصياد (أسماك لها أفواه كبيرة مع خيط يشبه الدودة متصل بها لجذب الفريسة)",
 "lophodytes cucullatus": "بلقشة مقنعة (بط صغير في أمريكا الشمالية يتميز بعرف دائري مرتفع على رأس الذكر)",
 "lopholatilus chamaeleonticeps": "تايلفيش (سمكة غذائية بنفسجية مرقطة بالأصفر تعيش في المياه العميقة الدافئة)",
 "lophophora williamsii": "بيوت, مسكال (صبار صغير عديم الأشواك كروي الشكل؛ مصدر لأزرار المسكال)",
 "lopid": "جيمفيبروزيل, لوبيد (دواء (الاسم التجاري لوبيد) يستخدم لخفض مستويات الدهون الثلاثية في الدم)",
 "lopper": "مقص تقليم, مِنجل تقليم (منشار تقليم طويل المقبض بشفرة منحنية في النهاية وأحياناً مقص؛ يستخدم لتقليم الأشجار الصغيرة)",
 "lopressor": "لوبريسور, ميتوبرولول (حاصر بيتا (الاسم التجاري لوبريسور) يستخدم في علاج ارتفاع ضغط الدم والذبحة الصدرية وعدم انتظام ضربات القلب واحتشاء عضلة القلب الحاد؛ له آثار جانبية…)",
 "lopsided": "مَائِل, مُنْحَرِف (ملتوٍ أو مائل نحو جانب واحد) / غَيْر مُتَوَازِن, مَائِل (أحد جانبيه أخفض أو أصغر أو أخف من الآخر)",
 "lopsidedly": "بِشَكْل غَيْر مُتَوَازِن, بِمَيْل (بطريقة ملتوية أو غير متوازنة)\nمثال: ابتسم بشكل مائل",
 "lopsidedness": "عدم توازن, ميلان (لا تناظر مائل أو منحرف)",
 "loquacious": "ثَرْثَار, كَثِير الكَلَام (مليء بالأحاديث التافهة)",
 "loquaciously": "بإسهاب, بثرثرة (بطريقة ثرثارة)\nمثال: تابعت بثرثرة: عندما كنت شابة، اعتدت أن أفعل كل أنواع الأشياء المشاغبة",
 "loquaciousness": "ثرثرة (صفة الإطناب وكثرة الكلام)",
 "loquacity": "ثرثرة (صفة الإطناب وكثرة الكلام)",
 "loquat": "بَشْمَلَة, أَسْكِيدُنْيَا",
 "loquat tree": "أسكدنيا, أكي دنيا (شجرة دائمة الخضرة في المناطق الدافئة لها فاكهة صفراء زغبية بحجم الزيتون مع نواة كبيرة حرة؛ موطنها الصين واليابان)",
 "loranthus europaeus": "دبق, هدال (شجيرة في وسط وجنوب شرق أوروبا؛ تتطفل جزئياً على الزان والكستناء والبلوط)",
 "lorazepam": "أتيفان, لورازيبام (مهدئ (الاسم التجاري أتيفان) يستخدم لعلاج القلق والتوتر والأرق)",
 "lorchel": "لورشيل (فطر كبير من فصيلة هيلفيلاسيا)",
 "lord": "رَبّ (رَبَّ الولدَ يَرُبُّ رَبًّا: ولِيَه وتعهده بما يغذيه وينميه ويؤدّبه؛ الفاعل: رَابٌّ، والمفعول: مَرْبوبٌ، وربيبٌ)\nمثال: اعتني بي يا رب.",
 "lord chancellor": "السيد المستشار, اللورد المستشار (أعلى ضابط للتاج يرأس القضاء ويترأس مجلس اللوردات)",
 "lord high chancellor": "السيد المستشار, اللورد المستشار (أعلى ضابط للتاج يرأس القضاء ويترأس مجلس اللوردات)",
 "lord of lords": "رَبُّ الْأَرْبَابِ (رَبَّ الولدَ يَرُبُّ رَبًّا: ولِيَه وتعهده بما يغذيه وينميه ويؤدّبه؛ الفاعل: رَابٌّ، والمفعول: مَرْبوبٌ، وربيبٌ)\nمثال: اعتني بي يا رب.",
 "lord of misrule": "أمير المرح, سيد الفوضى (شخص يُعين كمسؤول عن الاحتفالات في احتفالات عيد الميلاد (تقليد قديم))",
 "lord privy seal": "اللورد أمين الختم (كبير وزراء الحكومة في مجلس الوزراء البريطاني الذي ليس لديه واجبات رسمية)",
 "lord's day": "الأحد, يوم الأحد (أول أيام الأسبوع (في بعض التقاويم)؛ يوم راحة وعبادة لمعظم المسيحيين)",
 "lord's prayer": "اَلصَّلَاة اَلرَّبِّيَّة",
 "lord's supper": "العشاء الأخير (عشاء الفصح التقليدي ليسوع مع تلاميذه عشية صلبه) / الإفخارستيا, القربان المقدس (سر مسيحي يحيي ذكرى العشاء الأخير بتكريس الخبز والنبيذ)",
 "lord's table": "مائدة القربان, مذبح (المائدة في الكنائس المسيحية حيث يتم تقديم القربان)",
 "lordless": "بِلَا رَقِيب, بِلَا سَيِّد (لَيْسَ لَهُ سَيِّدٌ أَوْ مَوْلًى)",
 "lordliness": "تكبر, عنجهية (فخر متغطرس يظهر من خلال التصرف بفوقية تجاه من هم أقل شأناً) / هيبة, وقار (الرسمية في الهيئة والمظهر)\nمثال: تصرف بوقار عظيم",
 "lordly": "جَلِيل, مَهِيب (يليق بسيد عظيم أو ينتمي إلى مقام رفيع) / مُتَعَجْرِف, مُتَكَبِّر (لديه أو يُظهِر تفوّقًا متعجرفًا واحتقارًا لمن يعتبرهم أدنى منه)",
 "lordolatry": "تقديس الأسياد (عبادة سيد بسبب رتبته أو لقبه)",
 "lordosis": "قَعَس",
 "lordotic": "أَهْدَل الظَّهْر, مُتَقَعِّرُ الظَّهْر (يُعَانِي مِنْ تَقَعُّرٍ غَيْرِ طَبِيعِيٍّ فِي العَمُودِ الفِقَرِيِّ (خَاصَّةً فِي الخَيْلِ))",
 "lords spiritual": "الطبقة الأولى, رجال الدين (رجال الدين في فرنسا ورؤساء الكنيسة في بريطانيا)",
 "lords temporal": "الطبقة الثانية, النبلاء (النبلاء في فرنسا وطبقة النبلاء في بريطانيا)",
 "lords-and-ladies": "قلقاس هندي, لوف مبقع (لوف أوروبي شائع ذو قنابة سنانية الشكل وطلع أرجواني قصير؛ يظهر في أوائل الربيع؛ مصدر لنشا يسمى اللوف)",
 "lordship": "رُبُوبِيَّة, سِيَادَة",
 "lore": "مأثورات, معرفة تقليدية (المعرفة المكتسبة من خلال التقليد أو الحكايات المتوارثة)\nمثال: نقلت الشعوب المبكرة مأثورات النبات والحيوان من خلال الأساطير",
 "lorentz force": "قوة لورنتز (القوة التي يختبرها شحنة نقطية تتحرك على طول سلك موجود في مجال مغناطيسي؛ تكون القوة متعامدة مع كل من التيار والمجال المغناطيسي)\nمثال: يمكن استخدام قوة لورنتز لتعليق جسم يحمل تياراً بين مغناطيسين",
 "lorenzo dressing": "تتبيلة لورينزو (فينيغريت مع صلصة الفلفل الحار والجرجير المفروم)",
 "lorfan": "ليفالورفان (دواء (الاسم التجاري لورفان) مرتبط بالمورفين ولكنه يعاكس تثبيط التنفس الناتج عن التسمم بالمورفين ولكن دون التأثير على تأثيراته المسكنة)",
 "lorgnette": "نظارة بمقبض (نظارات تُمسك بالعينين بمقبض طويل)",
 "lorica": "غِلاف وَاقٍ, لُورِيكَا (غمد واقٍ صلب (تفرزه بعض الطلائعيات مثلاً))",
 "lorikeet": "لوريكيت (أي من الببغاوات الصغيرة المتنوعة)",
 "loris gracilis": "لوريس نحيل (ليمور نحيل الجسم من جنوب الهند وسريلانكا)",
 "lorraine": "لُورْيِّن",
 "lorraine cross": "صليب لورين (صليب بعارضتين، واحدة فوق وأخرى تحت نقطة منتصف العمودي، والسفلى أطول من العليا)",
 "lorry": "شاحنة نقل كبيرة (شاحنة كبيرة مصممة لحمل الأحمال الثقيلة؛ عادة بدون جوانب) / عربة نقل (عربة خيول كبيرة منخفضة بدون جوانب)",
 "lory": "لوري (ببغاوات أسترالاسية صغيرة زاهية الألوان لها لسان ذو طرف يشبه الفرشاة للتغذية على الرحيق والفواكه اللينة)",
 "los angeles": "لُوس أَنْجِلِس",
 "lose": "فَقَدَ / خَسِرَ (كلمة \"خسر\" تعني فقدان شيء ما، سواء كان مالا أو شيئا آخر. وتشمل معانيها: فقد المال، الهلاك، الضياع…؛ فعل متعدٍّ ومُتعدٍّ لِمَعْنَى، ومعناها الأساسي فقدان شيء ما. وتتعدد معانيه لتشمل)\nمثال: خسر توم وظيفته.",
 "lose heart": "يَئِسَ, أُحْبِطَ",
 "lose weight": "فَقَدَ وَزْن",
 "loser": "خَاسِر / فَاشِل",
 "losing streak": "سلسلة خسائر (فترة متصلة من الخسائر)",
 "losings": "خسائر, خسائر المقامرة (شيء مفقود (خاصة المال المفقود في المقامرة))",
 "loss": "خَسَارَة, فِقْدَان / ضَرَر / خَسَارَة",
 "loss leader": "سلعة استدراج, منتج خاسر للاستدراج (سلعة مميزة تباع بخسارة لجذب الزبائن)",
 "loss of consciousness": "فقدان الوعي (حدوث فقدان للقدرة على الإدراك والاستجابة)",
 "loss ratio": "نِسْبَة الخَسَارَة (نسبة المطالبات السنوية المدفوعة من قبل شركة التأمين إلى الأقساط المستلمة)",
 "losses": "خسائر, خسائر المقامرة (شيء مفقود (خاصة المال المفقود في المقامرة))",
 "lossless": "عديم الفقد, غير مبدد للطاقة (يتميز بـأو لا يسبب تبدد الطاقة)",
 "lossy": "فَقُود, مبدد للطاقة (يتميز بـأو يسبب تبدد الطاقة)",
 "lost": "ضَائِع / مَفْقود",
 "lost cause": "قضية خاسرة (قضية مهزومة أو قضية تكون الهزيمة فيها حتمية)",
 "lost tribes": "الأسباط المفقودة (أسباط إسرائيل العشرة التي تم ترحيلها إلى الأسر في آشور حوالي 720 قبل الميلاد (تاركة فقط سبطي يهوذا وبنيامين))",
 "lost-and-found": "مكتب المفقودات (مستودع في مبنى عام حيث يمكن حفظ الأشياء المفقودة حتى يستعيدها أصحابها)",
 "lot": "لُوط",
 "lota": "لوتا (زجاجة ماء كروية تستخدم في آسيا)",
 "lota lota": "بربوط (قد مياه عذبة ممدود في شمال أوروبا وآسيا وأمريكا الشمالية له زوائد حول فمه)",
 "loth": "كَارِه, مُمَانِع (يأبى فعل شيء يخالف عادته أو طبعه)",
 "lotharingia": "لُوثَارِينْجِيَا",
 "lothario": "زير نساء (زير نساء ناجح؛ رجل يتصرف بأنانية في علاقاته الجنسية مع النساء)",
 "loti": "لوتي (وحدة المال الأساسية في ليسوتو)",
 "lotic": "جَارِي (يتعلق بـ أو يعيش في مياه تتحرك بنشاط)",
 "lotion": "غَاسُول, غَسُول",
 "lots": "الكثير, قدراً كبيراً (إلى درجة أو مدى كبير جداً) / أطنان, أكوام (عدد أو كمية كبيرة)\nمثال: أشعر بتحسن كبير",
 "lotte": "سمكة الصنارة, سمكة الصياد (أسماك لها أفواه كبيرة مع خيط يشبه الدودة متصل بها لجذب الفريسة)",
 "lottery": "يَانَصِيب",
 "lottery winner": "رابح اليانصيب, فائز بالجائزة (الفائز في اليانصيب)",
 "lotto": "يَانَصِيب",
 "lotus": "نَيْلُوفَر",
 "lotus americanus": "لوتس البراري, نفل البراري (نبات حولي من أمريكا الشمالية بزهور حمراء أو وردية)",
 "lotus berthelotii": "جوهرة المرجان, لوتس بارثلوت (نبات معمر منخفض النمو كثير التفرع من جزر الكناري له زهور برتقالية حمراء إلى قرمزية أو أرجوانية؛ توطن في الولايات المتحدة)",
 "lotus corniculatus": "قرن الغزال, لوتس قرني (نبات علف أوروبي له قرون مخلبية الشكل أدخل إلى أمريكا)",
 "lotus land": "أرض الأحلام, عالم الخيال (عالم مثالي من الرضا والانغماس في الذات)",
 "lotus position": "وضع اللوتس, وضعية زهرة اللوتس (وضع جلوس مع تقاطع الساقين؛ يستخدم في اليوغا)",
 "lotus tetragonolobus": "بازلاء مجنحة, لوتس (نبات حولي أوروبي مترامي الأطراف له قرن صالح للأكل ذو 4 أجنحة)",
 "lotus tree": "سدر اللوتس, شجرة اللوتس (شجرة نفضية شجيرية من منطقة البحر الأبيض المتوسط)",
 "lotus-eater": "آكل اللوتس, حالم (شخص غير مبالٍ بالعالم المشغول)",
 "lotusland": "أرض الأحلام, عالم الخيال (عالم مثالي من الرضا والانغماس في الذات)",
 "lou gehrig's disease": "التصلب الجانبي الضموري (سماكة الأنسجة في المسالك الحركية للحبل الشوكي؛ يؤدي إلى ضمور عضلي تدريجي)",
 "louche": "مَشْبُوهٌ, مُرِيبٌ (سيئ السمعة ومنحل بشكل يبدو جذاباً نوعاً ما)",
 "loud": "عَالٍ, اَلْعَالِي (افتقر واحتاج إلى مساعدة غيره المادية؛ عاله الشيء: اعوزه واحتاجه)\nمثال: بدأ يبكي بصوت عال",
 "loud hailer": "بوق النداء, مكبر صوت يدوي (مكبر صوت محمول مزود بميكروفون ومضخم صوت مدمجين)",
 "loud pedal": "دواسة الاستدامة (دواسة في البيانو ترفع المخمدات عن الأوتار وتسمح لها بمواصلة الاهتزاز)",
 "loud-hailer": "بوق النداء, مكبر صوت يدوي (مكبر صوت محمول مزود بميكروفون ومضخم صوت مدمجين)",
 "loud-mouthed": "سَلِيط, فَاحِشُ الكَلَام (يميل إلى الكلام الصاخب المسيء)",
 "loud-voiced": "جَهِيرُ الصَّوْت (ذو صوت عالٍ على نحو غير معتاد)",
 "loudly": "بِصَوْت عَالٍ",
 "loudmouth": "ثرثار, سليط اللسان (شخص يسبب المشاكل من خلال التحدث دون تحفظ أو حكمة)",
 "loudness": "بَهْرَجَة, زَخْرَفَة صَارِخَة (الاستعراض المبتذل عديم الذوق) / جهارة, حجم الصوت (مقدار الصوت (عادة في اتجاه محدد))\nمثال: شغل الأطفال موسيقاهم بأعلى صوت",
 "loudspeaker": "مُحَوِّل طَاقَة / مِجْهَار / سَمَاعَة",
 "loudspeaker system": "مكبر صوت (محول كهروصوتي يحول الإشارات الكهربائية إلى أصوات عالية بما يكفي لسماعها من مسافة بعيدة)",
 "loufah sponge": "لوف (الجزء الليفي المجفف من ثمرة نبات من جنس اللوف؛ يستخدم كإسفنجة للغسيل أو مصفاة)",
 "lough": "بحيرة (الكلمة الأيرلندية للبحيرة) / بحيرة, لوخ (خليج ضيق طويل (شبه محاط باليابسة) في أيرلندا)",
 "louis d'or": "لُوِيس ذَهَبِي",
 "louis harold gray": "لويس هارولد غراي (عالم أحياء إشعاعية إنجليزي سميت وحدة غراي (وحدة الطاقة للجرعة الممتصة من الإشعاع) تكريماً له (1905-1965))",
 "louisiana": "لُوِيزِيَانَا",
 "louisianan": "لويزياني (مواطن أو مقيم في لويزيانا)",
 "louisianian": "لويزياني (مواطن أو مقيم في لويزيانا)",
 "loujain": "لجين (فِضَّة؛ اسم شخصي معطًى للإناث من العرب)",
 "lounge": "صَالَة, قَاعَة (مكان فسيح في وسط المسكن يُوصِلُ إلى سائر الحجرات، الرُدْهَة؛ غُرْفَةُ المَعِيْشَة سواء كانت توصل إلى سائر الحجرات أم لا وسواء كانت فسيحة أم لا)\nمثال: حجزت الصالة يوم الخميس.",
 "lounge car": "عربة الصالة, عربة النادي (عربة سكة حديد تحتوي على بار وطاولات وكراسي استراحة)",
 "lounge chair": "كرسي استرخاء, كرسي مريح (كرسي بذراعين منجد ومريح)",
 "lounge lizard": "متسكع الحانات (رجل يتسكع في صالات الفنادق والحانات بحثاً عن نساء ينفقن عليه)",
 "lounge suit": "بدلة من قطعتين (بدلة عمل تتكون من سترة وتنورة أو بنطال متطابقين)",
 "lounger": "رداء مريح (قطعة ملابس مصممة للراحة والارتداء في وقت الفراغ) / كرسي استلقاء, كرسي قابل للإمالة (كرسي بذراعين يمكن خفض ظهره ورفع مسند القدمين للسماح للجالس بالاستلقاء فيه) / متلكئ, مضيع الوقت (شخص يضيع الوقت)",
 "loungewear": "ملابس استرخاء (ملابس مناسبة للاسترخاء)",
 "lounging jacket": "سترة تدخين (سترة ناعمة للرجل عادة بحزام ربط؛ تلبس في المنزل)",
 "lounging pajama": "بيجامة استرخاء (بيجامة تلبس أثناء الاسترخاء)",
 "lounging pyjama": "بيجامة استرخاء (بيجامة تلبس أثناء الاسترخاء)",
 "lounging robe": "رداء استرخاء, روب منزلي (رداء يُرتدى قبل ارتداء الملابس أو أثناء الاسترخاء)",
 "loup-garou": "الرجل الذئب, مستذئب (وحش قادر على تغيير مظهره من إنسان إلى ذئب والعكس)",
 "loupe": "عدسة الجواهرجي, لوب (عدسة مكبرة صغيرة (توضع عادة في عدسة عينية) يستخدمها صاغة المجوهرات والساعاتيون)",
 "louping ill": "القفز المريض (مرض فيروسي حاد يصيب الجهاز العصبي في الأغنام)",
 "louse": "قَمْلَة, قَمْل / قِمْلَة",
 "louse fly": "ذبابة القمل (ذبابة ثنائية الأجنحة ماصة للدماء تتطفل على الطيور والثدييات)",
 "lousiness": "بَشَاعَة, خِسَّة (صفة كون الشيء مقرفاً للحواس أو المشاعر) / تقمل, قمل (الإصابة بالقمل (قمل الإنسان) مما يؤدي إلى حكة شديدة)\nمثال: فاجأتنا بشاعة لغته",
 "lousy": "مَقْمُول, مَلِيء بِالقَمْل (موبوء بالقمل) / تَافِه, رَدِيء جِدًّا ((غير رسمي) سيء جداً ومُقزِّز) / حَقِير, وَضِيع (خسيس ومحتقر؛ دنيء)",
 "lout": "أبله, أجلف (شخص أخرق وغبي)",
 "loutish": "غَلِيظٌ, فَظٌّ (سيئ السلوك وخشن ومحتقر في التصرف أو المظهر)",
 "loutishness": "بلطجة, سوقية (حالة أو صفة التصرف مثل مثير للمشاكل، غالباً ما يكون عنيفاً؛ مثل شخص وقح وعنيف)\nمثال: صحيح، هذا بالكاد الشراب الذي يلهم سوقية 'فتيات جمحن'",
 "louvar": "لوفار (سمكة فضية كبيرة توجد في جميع أنحاء العالم في البحار الدافئة ولكنها ليست شائعة في أي مكان؛ تشبه الحوت وتتغذى على العوالق)",
 "louver": "شريحة تهوية (واحدة من مجموعة من الشرائح المتوازية في باب أو نافذة للسماح بدخول الهواء ومنع المطر)",
 "louvered": "ذُو شَرَائِحَ تَهْوِيَة (مُزَوَّدٌ بِشَرَائِحَ لِلتَّهْوِيَة)",
 "louvered window": "نافذة شيش (نافذة ذات ريش زجاجية)",
 "louvre": "اَللُّوفْر",
 "lovable": "محبوب (يمتلك خصائص تجذب الحب أو العاطفة)\nمثال: طفل شقي ولكن محبوب",
 "lovage": "زَوْفَرَا, كَاشِم",
 "lovastatin": "لوفاستاتين, ميفاكور (دواء فموي (الاسم التجاري ميفاكور) لتقليل مستويات الكوليسترول في الدم؛ يستخدم عندما تثبت التغييرات الغذائية عدم كفايتها)",
 "love": "حَبِيب, حَبِيبَة / أَحَبَّ, حب (مَالَ إلى الشيء أو الشخص، وَدَّه؛ للزَّرع: بَدا حَبُّه) / أَحَبَّ (مَالَ إلى الشيء أو الشخص، وَدَّه؛ للزَّرع: بَدا حَبُّه)\nمثال: لا أحب المدرسة.",
 "love affair": "عَلَاقَة غَرَامِيَّة",
 "love apple": "بندورة, طماطم (موطنها أمريكا الجنوبية؛ تزرع على نطاق واسع في العديد من الأصناف)",
 "love at first sight": "اَلْحُبّ مِن اَلنَّظْرَة اَلْأُولَى",
 "love bite": "علامة قبلة, لدغة حب (علامة حمراء مؤقتة على جلد الشخص ناتجة عن التقبيل أو المص من قبل الحبيب)",
 "love child": "ابن غير شرعي, نغل (النسل غير الشرعي لأبوين غير متزوجين)",
 "love feast": "أغابي, وليمة المحبة (وجبة دينية مشتركة كعلامة على الحب والزمالة) / وليمة المحبة (تجمع اجتماعي يهدف إلى خلق النوايا الحسنة بين المشاركين)",
 "love grass": "إراغروستيس, عشب الحب (أي من أعشاب مختلفة من جنس إراغروستيس؛ مفيدة بشكل خاص للعلف ومنع التعرية)",
 "love handle": "دهون الخصر, طوق دهني (الدهون الزائدة حول الخصر)",
 "love knot": "عقدة الحب (عقدة منمقة أو زخرفية تستخدم كشعار للحب)",
 "love letter": "رِسَالَةُ حُبٍّ",
 "love life": "حياة عاطفية, غرام (الأنشطة الجنسية (التي تشمل غالباً الجماع) بين شخصين)\nمثال: طريقته في ممارسة الحب أثارت اشمئزازها",
 "love line": "خط الحب, خط القلب (تجعد في راحة اليد؛ يقال في قراءة الكف أنه يشير إلى الطبيعة العاطفية)",
 "love lyric": "غزل, كلمات أغنية عاطفية (كلمات أغنية حب)",
 "love match": "زواج حب (زواج من أجل الحب؛ وليس زواجًا مدبرًا)",
 "love seat": "أريكة لشخصين, مقعد المحبين (أريكة صغيرة تتسع لشخصين)",
 "love song": "أغنية حب, أغنية عاطفية (أغنية عن الحب أو تعبر عن الحب لشخص آخر)",
 "love story": "قصة حب, قصة غرامية (قصة تتناول موضوع الحب)",
 "love tree": "زمريق, شجرة يهوذا (شجرة صغيرة من شرق البحر الأبيض المتوسط لها زهور حمراء أرجوانية وفيرة تنمو على الخشب القديم مباشرة من السيقان وتظهر قبل الأوراق: تزرع على نطاق واسع في…)",
 "love triangle": "مُثَلَّث حُبّ, ثُلَاثِيَّة حُبّ",
 "love vine": "حامول, كرمة الحب (كرمة طفيلية بلا أوراق ذات عناقيد كثيفة من الزهور البيضاء الصغيرة على شكل جرس على سيقان برتقالية صفراء تلتف حول البرسيم أو الكتان)",
 "love-in-a-mist": "حب في الضباب, حبة البركة الدمشقية (نبات حديقة أوروبي ذو أوراق مقطوعة بدقة وزهور بيضاء أو زرقاء شاحبة) / ثلج في الصيف (عشبة الطيور ذات أوراق رمادية فضية مشعرة وأزهار بيضاء كبيرة نوعاً ما) / حب في الضباب, ليمون الماء البري (زهرة العاطفة الاستوائية الأمريكية ذات قنابات مقسمة بدقة؛ السيقان كريهة الرائحة عند سحقها)",
 "love-in-idleness": "بانسي بري, زهرة الثالوث البرية (عشبة أوروبية شائعة ومزروعة منذ فترة طويلة تشتق منها معظم زهور البانسي الشائعة في الحدائق)",
 "love-in-winter": "حب في الشتاء, صنوبر الأمير الغربي (عشبة أوراسية بأزهار بيضاء أو وردية في عذقة طرفية)",
 "love-lies-bleeding": "حب الحب, زهرة القطيفة (تستخدم الأوراق الصغيرة على نطاق واسع كخضروات ورقية؛ تستخدم البذور كحبوب)",
 "love-philter": "ترياق الحب, شراب الحب (شراب يُعتقد أن له قوة سحرية؛ يمكن أن يجعل من يتناوله يقع في حب من أعطاه إياه)",
 "love-philtre": "ترياق الحب, شراب الحب (شراب يُعتقد أن له قوة سحرية؛ يمكن أن يجعل من يتناوله يقع في حب من أعطاه إياه)",
 "love-potion": "ترياق الحب, شراب الحب (شراب يُعتقد أن له قوة سحرية؛ يمكن أن يجعل من يتناوله يقع في حب من أعطاه إياه)",
 "love-song": "أغنية حب, أغنية عاطفية (أغنية عن الحب أو تعبر عن الحب لشخص آخر)",
 "love-token": "عربون محبة (تذكار يعطى كرمز للحب)",
 "loveable": "محبوب (يمتلك خصائص تجذب الحب أو العاطفة)\nمثال: طفل شقي ولكن محبوب",
 "lovebird": "طائر الحب (ببغاء أفريقي صغير يشتهر بإظهار المودة لرفيقه) / بادجي, ببغاء الدرة (ببغاء أسترالي صغير عادة ما يكون لونه أخضر فاتح مع علامات سوداء وصفراء في البرية ولكن يتم تربيته بألوان عديدة)",
 "loved": "مَحْبُوب",
 "loved one": "حَبِيب, عَزِيز (شخص تحبه، عادة ما يكون فرداً من عائلتك)",
 "loveless": "مَحْرُومٌ مِنَ الحُبّ (لا يتلقى أي حب) / خَالٍ مِنَ الحُبّ (بمعنى ظَنَّ، استخدام نادر والأغلب استخدام خَيْل أو مَخَالَة؛ أخو الأم. جمعه أخوال للمذكر وخالات للمؤنث)\nمثال: عندي ابنا خالة.",
 "loveliness": "حسن, ملاحة (صفة كون الشخص حسن المظهر وجذاباً)",
 "lovelorn": "مَحْرُومُ الحُبّ, وَالِه (تعيس في الحب؛ يعاني من حب بلا مقابل)",
 "lovely": "جَمِيل, مَحْبُوب (يخاطب العواطف والعين معاً) / جَذَّاب, فَاتِن (محبوب خاصة بطريقة طفولية أو ساذجة) / فتاة الغلاف (فتاة جميلة جداً تعمل كعارضة للمصورين)",
 "lovemaking": "حياة عاطفية, غرام (الأنشطة الجنسية (التي تشمل غالباً الجماع) بين شخصين)\nمثال: طريقته في ممارسة الحب أثارت اشمئزازها",
 "lover": "عَاشِق, عَاشِقَة / مُغْرَم",
 "lover's knot": "عقدة الحب (عقدة منمقة أو زخرفية تستخدم كشعار للحب)",
 "loverlike": "عَاشِقِيّ (على نحو يشبه سلوك العاشق أو بأسلوبه)",
 "loverly": "عَاشِقِيّ (على نحو يشبه سلوك العاشق أو بأسلوبه)",
 "lovers' knot": "عقدة الحب (عقدة منمقة أو زخرفية تستخدم كشعار للحب)",
 "loveseat": "أريكة لشخصين, مقعد المحبين (أريكة صغيرة تتسع لشخصين)",
 "lovesick": "مريض العشق (من به مَرَض، أي السَقِيْم المَعْلُوْل. يقال لما يصاب به الجَسَد والنَفَس والرُوْح أو أحدهم)\nمثال: أظن أنها مريضة.",
 "lovesickness": "داء العشق, لوعة الحب (حنين وشوق لحبيب)",
 "lovesome": "حَنُون, وَدُود (يتحلّى بالدفء العاطفي والمودة أو يُظهرهما)",
 "loving": "مُحِبّ, وَدُود",
 "loving cup": "كأس, كأس المحبة (وعاء معدني كبير بمقبضين يُمنح كجائزة للفائز في مسابقة) / كأس المودة (وعاء شرب كبير (عادة بمقبضين) يشرب منه الناس بالتناوب في مأدبة)\nمثال: احتفظت المدرسة بالكؤوس في خزانة زجاجية خاصة",
 "loving-kindness": "حنان, رأفة (لطف رقيق مدفوع بشعور من المودة)",
 "lovingly": "بِحَنَان, بِحُبّ (بمودة وحب)\nمثال: تحدثت إلى أطفالها بحنان",
 "lovingness": "دفء عاطفي, محبة (صفة نابعة من مشاعر المودة أو الحب) / اهتمام, مودة (شعور محب)",
 "lovoa klaineana": "جوز أفريقي, لوفوا (شجرة خشب استوائية أفريقية بخشب يشبه الماهوجني)",
 "low": "حَزين / خافِت, مُنْخَفِض",
 "low beam": "ضوء منخفض (شعاع المصابيح الأمامية للسيارة الذي يوفر إضاءة لمسافة قصيرة)",
 "low beam headlamp": "ضوء التلاقي, ضوء منخفض (مصباح أمامي منخفض الشعاع (يُسمى أيضاً ضوء المرور أو التلاقي) يوفر توزيعاً للضوء لإعطاء إضاءة أمامية وجانبية كافية دون إبهار مستخدمي الطريق الآخرين…)",
 "low blow": "إِهَانَة دَنِيئَة, ضَرْبَة تَحْت الْحِزَام (إساءة عديمة الضمير)",
 "low blueberry": "توت أزرق منخفض (شجيرة متساقطة الأوراق منخفضة النمو من شمال شرق أمريكا الشمالية لها زهور في عناقيد مدمجة وتحمل توتاً أزرق داكناً حلواً)",
 "low brass": "نحاس أصفر منخفض الزنك (نحاس أصفر يحتوي على 30% (أو أقل) من الزنك)",
 "low comedy": "كوميديا هابطة (كوميديا تتميز بالتهريج والمحاكاة الساخرة)",
 "low density": "رقة, ندرة (جودة التخلخل (قلة الكثافة))\nمثال: رقة الغلاف الجوي العلوي",
 "low explosive": "متفجرات بطيئة الاشتعال, متفجرات ضعيفة (مادة متفجرة ذات معدل احتراق منخفض)",
 "low frequency": "تردد منخفض, طبقة منخفضة (طبقة صوتية تُدرك على أنها أدنى من غيرها) / تَرَدُّد مُنْخَفِض (30 إلى 300 كيلوهرتز)",
 "low gallberry holly": "بهشية منخفضة (شجيرة دائمة الخضرة موطنها على طول الساحل الجنوبي للولايات المتحدة إلى جنوب فلوريدا ولويزيانا)",
 "low gear": "الترس الأول, السرعة الأولى (أدنى نسبة تروس أمامية في صندوق تروس المركبة؛ تستخدم لبدء تحرك السيارة)",
 "low german": "الألمانية السفلى, بلات دويتش (لهجة ألمانية يتم التحدث بها في شمال ألمانيا)",
 "low latin": "اللاتينية السفلى (أي لهجة من اللاتينية غير اللاتينية الكلاسيكية)",
 "low level flight": "طيران منخفض (الطيران على ارتفاعات منخفضة جداً)",
 "low mass": "قداس بسيط (قداس يتلى بدون موسيقى)",
 "low pitch": "تردد منخفض, طبقة منخفضة (طبقة صوتية تُدرك على أنها أدنى من غيرها)",
 "low profile": "توارٍ عن الأنظار, ظهور منخفض (حالة من قلة الظهور يتم فيها تجنب لفت انتباه الجمهور)\nمثال: لم يكن أبداً ممن يفضلون التواري عن الأنظار",
 "low quality": "جودة منخفضة, دونية (جودة متدنية)",
 "low relief": "نقش بارز منخفض (نحت بارز تبرز فيه الأشكال قليلاً فقط عن الخلفية؛ ولا يتم قطع أي أشكال من الأسفل)",
 "low spirits": "اعتلال المزاج, انقباض (حالة من الاكتئاب الخفيف)",
 "low st andrew's cross": "صليب القديس أندرو المنخفض (نبات شجيري منخفض له زهور صفراء بأربع بتلات مرتبة على شكل صليب؛ برمودا وجنوب شرق الولايات المتحدة إلى جزر الهند الغربية وشرق المكسيك)",
 "low status": "ضعة, مكانة متدنية (موقف ذو مكانة أدنى؛ منخفض في المقام أو الرتبة أو الثروة أو التقدير)",
 "low sunday": "الأحد الجديد (الأحد الذي يلي عيد الفصح)",
 "low temperature": "انخفاض درجة الحرارة, برد (غياب الحرارة)\nمثال: جعلت البرودة أنفاسنا مرئية",
 "low tide": "انحسار الماء, جزر (أدنى (أبعد) انحسار للمد)",
 "low vowel": "صائت مفتوح, صائت منخفض (صائت تنطقه ولسانك في قاع فمك)",
 "low water": "انحسار الماء, جزر (أدنى (أبعد) انحسار للمد)",
 "low-altitude": "مُنْخَفِض الارْتِفَاع (يحدث على ارتفاع منخفض نسبيّاً)",
 "low-backed": "ذُو ظَهْر مُنْخَفِض (ذو مسند ظهر منخفض)",
 "low-birth-weight baby": "طفل منخفض الوزن عند الولادة (رضيع يولد بوزن أقل من 5.5 رطل (2500 جرام) بغض النظر عن عمر الحمل)\nمثال: الرضيع منخفض الوزن عند الولادة معرض لخطر نقص الأكسجين أثناء المخاض",
 "low-birth-weight infant": "طفل منخفض الوزن عند الولادة (رضيع يولد بوزن أقل من 5.5 رطل (2500 جرام) بغض النظر عن عمر الحمل)\nمثال: الرضيع منخفض الوزن عند الولادة معرض لخطر نقص الأكسجين أثناء المخاض",
 "low-budget": "مَحْدُود المِيزَانِيَّة (مصنوع أو مناسب لميزانية محدودة)",
 "low-bush blueberry": "توت أزرق منخفض (شجيرة متساقطة الأوراق منخفضة النمو من شمال شرق أمريكا الشمالية لها زهور في عناقيد مدمجة وتحمل توتاً أزرق داكناً حلواً)",
 "low-cal": "خَفِيف السُّعْرَات, قَلِيل السُّعْرَات (يَحْتَوِي عَلَى سُعْرَات حَرَارِيَّة قَلِيلَة نِسْبِيًّا)",
 "low-calorie diet": "حمية قليلة السعرات الحرارية, حمية منخفضة السعرات (نظام غذائي منخفض السعرات الحرارية)",
 "low-carbon steel": "صلب طري, فولاذ لين (فولاذ يحتوي على أقل من 0.15% كربون)",
 "low-ceilinged": "مُنْخَفِض السَّقْف (ذو سقف أدنى من المعتاد)",
 "low-class": "مِن الطَّبَقَة الدُّنْيَا (يحتل أدنى مكانة اجتماعية واقتصادية في المجتمع)",
 "low-cost": "فِي المُتَنَاوَل, مَيْسُور التَّكْلِفَة (يمكن تحمل تكلفته مالياً)",
 "low-cut": "مُنْخَفِض القَصَّة (ذو قصة منخفضة تكشف الظهر) / مَفْتُوح الصَّدْر, مُنْخَفِض القَصَّة ((للملابس) ذو فتحة عنق منخفضة)",
 "low-density lipoprotein": "بروتين دهني منخفض الكثافة (بروتين دهني ينقل الكوليسترول في الدم؛ يتكون من كمية معتدلة من البروتين وكمية كبيرة من الكوليسترول؛ يُعتقد أن المستويات العالية منه ترتبط بزيادة خطر…)",
 "low-down": "بِلُوزِيّ, رُوحَانِيّ ((في الجاز) ذو إحساس روحاني يشبه البلوز القديم) / خَسِيس, وَضِيع (من أحقر الأنواع وأدناها) / أسرار, خفايا (مصطلحات عامية للمعلومات الداخلية)\nمثال: هل هذه هي الحقيقة المجردة؟",
 "low-fat diet": "حمية قليلة الدسم, حمية قليلة الدهون (نظام غذائي يحتوي على كميات محدودة من الدهون ويركز على الأطعمة الغنية بالكربوهيدرات؛ يستخدم في علاج بعض حالات المرارة)",
 "low-fat milk": "حليب قليل الدسم (حليب تم تقليل محتواه من الدهون)",
 "low-grade": "مُنْخَفِض الدَّرَجَة",
 "low-growing": "زَاحِف, مُنْبَطِح النُّمُوّ (من النباتات التي تنمو قريبة من سطح الأرض نسبيّاً)",
 "low-interest": "منخفض الفائدة ((تستخدم للقروض) تفرض نسبة صغيرة نسبياً من المبلغ المقترض)",
 "low-key": "خَافِت, هَادِئ (مُعتدِل في الأسلوب أو الجودة)",
 "low-keyed": "خَافِت, هَادِئ (مُعتدِل في الأسلوب أو الجودة)",
 "low-level": "تابع, مرؤوس (أدنى في الرتبة أو الأهمية) / مُنْخَفِض الارْتِفَاع (يحدث على ارتفاع منخفض نسبيّاً) / مُنْخَفِض الشِّدَّة (غير شديد؛ ضعيف المستوى) / مُنْخَفِض المُسْتَوَى (في مستوى منخفض من الرتبة أو الأهمية)",
 "low-level formatting": "تهيئة منخفضة المستوى ((علوم الكمبيوتر) تنسيق القطاعات على سطح محرك الأقراص الثابتة حتى يتمكن نظام التشغيل من الوصول إليها وتحديد موضع البداية)",
 "low-level radioactive waste": "نفايات مشعة منخفضة المستوى ((طب) نفايات مشعة تتكون من أشياء تعرضت للإشعاع لفترة وجيزة (كما في بعض الفحوصات الطبية))",
 "low-lying": "مُنْخَفِض الوَضْع (ذو ارتفاع صغير فوق سطح الأرض أو الأفق أو مستوى البحر) / عَلَى مُسْتَوَى سَطْح البَحْر, مُنْخَفِض (يقع تحت المستوى الطبيعيّ)",
 "low-necked": "مَفْتُوح الصَّدْر, مُنْخَفِض القَصَّة ((للملابس) ذو فتحة عنق منخفضة)",
 "low-pass filter": "مرشح الترددات المنخفضة (مرشح يمرر الترددات الأقل من قيمة معينة ويخفف الترددات الأعلى من تلك القيمة)",
 "low-pitched": "غليظ, منخفض النبرة (تستخدم للأصوات والأصوات البشرية؛ منخفضة في النغمة أو التردد) / خَفِيف المَيْل (مضبوط بزاوية منخفضة)",
 "low-powered": "مُنْخَفِض القُدْرَة (ذو طاقة قليلة على أداء العمل)",
 "low-pressure": "غَيْر ضَاغِط, هَادِئ (ليس قسرياً أو ضاغطاً)",
 "low-priced": "فِي المُتَنَاوَل, مَيْسُور التَّكْلِفَة (يمكن تحمل تكلفته مالياً)",
 "low-resolution": "منخفض الدقة (لأجهزة إخراج الكمبيوتر؛ إنتاج صور غير محددة بدقة)",
 "low-rise": "منخفض الارتفاع (تستخدم للمباني المكونة من طابق واحد أو بضعة طوابق وعادة لا يوجد مصعد؛ منخفض)\nمثال: يطل على أسطح مبانٍ سكنية منخفضة الارتفاع",
 "low-salt diet": "حمية خالية من الملح, حمية قليلة الصوديوم (نظام غذائي يحد من تناول الملح (كلوريد الصوديوم)؛ يستخدم غالباً في علاج ارتفاع ضغط الدم أو الوذمة أو اضطرابات أخرى)",
 "low-set": "مُنْخَفِض الموضع, وَاطِئ (أدنى من المتوسِّط في الارتفاع) / قَصِير مُمْتَلِئ, مُكَتَّل (قصير وسمين؛ ذو ساقين قصيرتين وعضلات ثقيلة)",
 "low-sodium diet": "حمية خالية من الملح, حمية قليلة الصوديوم (نظام غذائي يحد من تناول الملح (كلوريد الصوديوم)؛ يستخدم غالباً في علاج ارتفاع ضغط الدم أو الوذمة أو اضطرابات أخرى)",
 "low-spirited": "كَئِيب, مُكْتَئِب (مَمْلُوءٌ بِالكَآبَةِ وَالقُنُوط)",
 "low-spiritedness": "تثبيط, هبوط المعنويات (شعور بانخفاض المعنويات)\nمثال: شعر بالمسؤولية عن انخفاض معنوياتها",
 "low-sudsing": "قليل الرغوة ((تستخدم للمنظفات) تنتج رغوة قليلة)",
 "low-tech": "بسيط تقنياً, منخفض التقنية (لا ينطوي على تكنولوجيا عالية)",
 "low-tension": "توتر منخفض, ضغط منخفض (خاضع لـ أو قادر على العمل تحت جهد كهربائي منخفض نسبياً)",
 "low-toned": "خَفِيض, مُنْخَفِض (منخفض جداً في الحجم الصوتي)",
 "low-voltage": "توتر منخفض, ضغط منخفض (خاضع لـ أو قادر على العمل تحت جهد كهربائي منخفض نسبياً)",
 "low-warp-loom": "نول أفقي (نول يدوي يتم فيه حمل السداة أفقياً؛ لنسج المفروشات)",
 "low-water mark": "علامة الجزر, علامة المد المنخفض (خط يحدد أدنى مستوى تم الوصول إليه) / أسوأ حالات, حضيض (حالة قصوى من الشدائد؛ أدنى نقطة لأي شيء)",
 "lowan": "طائر المالي (طائر التلال الأسترالي؛ يحضن البيض بشكل طبيعي في تلال رملية)",
 "lowborn": "من أصل متواضع, وضيع النسب (من مولد أو أصول متواضعة)\nمثال: مجتمع مقلوب رأساً على عقب من الأغنياء وضيعي النسب والفقراء ذوي الدماء الزرقاء",
 "lowboy": "خزانة أدراج منخفضة (صندوق منخفض أو طاولة ذات أدراج وتستند على أربع أرجل)",
 "lowbred": "سَيِّئُ التَّرْبِيَةِ, قَلِيلُ الْأَدَبِ ((عن الأشخاص) يفتقر إلى الرقة أو اللباقة)",
 "lowbrow": "سَطْحِيّ, غَيْرُ مُثَقَّف (يتصف بعدم التهذيب الثقافي أو افتقار الذوق الفكري) / جاهل بالفنون, شخص مادي (شخص غير مهتم بالمساعي الفكرية أو الثقافية)",
 "lowbrowed": "سَطْحِيّ, غَيْرُ مُثَقَّف (يتصف بعدم التهذيب الثقافي أو افتقار الذوق الفكري)",
 "lowbush cranberry": "عنب الثور (توت أحمر لاذع يشبه التوت البري الأمريكي ولكنه أصغر)",
 "lowbush penstemon": "بنستيمون شجيري (نبات كثيف منخفض بأزهار كبيرة مبهرجة خزامية باهتة أو زرقاء بنفسجية في عناقيد ضيقة عند نهايات السيقان)",
 "lower": "أَدْنَى, دُنْيَا (أَدْنَى؛ أَدْنَى: (فعل)) / أَنْزَلَ (فعل تعدّ من نَزَلَ؛ ضد أَصْعَدَ، جَعَله يَنْزِل أو وضعه في مكان سَفْل؛ الشخصَ في مكان: جعله يَنْزِل به، أي يُقِيم)\nمثال: سامي من طبقة أدنى.",
 "lower assam": "آسَام اَلسُّفْلَى",
 "lower back": "مُسْتَدَقّ الظَّهْر",
 "lower berth": "سرير سفلي, مضجع سفلي (السرير السفلي من بين سريرين (أحدهما فوق الآخر))",
 "lower bound": "حد أدنى ((رياضيات) عدد يساوي أو أقل من أي عدد آخر في مجموعة معطاة)",
 "lower cannon": "واقي الساعد (جزء أسطواني من الدرع الصفيحي يحمي الساعد)",
 "lower case": "حَرْف صَغِير, أَحْرُف صَغِيرَة (طَرَف وَجَانِب وَحَدّ؛ رَمْز مخطوط أو مطبوع يقوم مقام صوت أو كلمة أو عبارة أو معنى)\nمثال: ألف هو الحرف الأول للألف باء.",
 "lower class": "الطَّبَقَاتُ الدُّنْيَا",
 "lower court": "محكمة أدنى, محكمة ابتدائية (أي محكمة يمكن استئناف قراراتها أمام محكمة أعلى)",
 "lower criticism": "النقد الأدنى (دراسة المخطوطات الموجودة للكتب المقدسة من أجل تحديد النص الأصلي)",
 "lower deck": "السطح السفلي (السطح الموجود أسفل السطح الرئيسي)",
 "lower egypt": "اَلدِّلْتَا اَلْوَجْهُ ٱلْبَحْرِيُّ",
 "lower house": "مَجْلِس أَدْنَى",
 "lower jaw": "فك سفلي (الفك في الفقاريات الذي يتمفصل ليفتح الفم)",
 "lower jawbone": "فك سفلي (الفك في الفقاريات الذي يتمفصل ليفتح الفم)",
 "lower limit": "حد جنوبي, حد سفلي (الحد الموجود على الجانب السفلي (أو الجنوبي) لشيء ما) / حد أدنى (أصغر كمية ممكنة)",
 "lower mantle": "الوشاح السفلي (الجزء الأعمق من الوشاح الأرضي)",
 "lower rank": "دونية, مكانة أدنى (حالة كونه أدنى)",
 "lower respiratory infection": "عدوى الجهاز التنفسي السفلي (عدوى تصيب الجهاز التنفسي السفلي)",
 "lower respiratory tract": "المسلك التنفسي السفلي (الشعب الهوائية والرئتين)",
