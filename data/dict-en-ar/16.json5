 "life style": "أسلوب حياة, نمط حياة (طريقة للعيش تعكس قيم الشخص ومواقفه)",
 "life support": "نظام دعم الحياة (معدات طبية تساعد أو تحل محل وظائف جسدية مهمة وبالتالي تمكن المريض من العيش والذي لولاها قد لا ينجو) / نظام دعم الحياة (معدات تجعل الحياة ممكنة في ظروف بيئية مميتة لولا ذلك)\nمثال: المريض على أجهزة دعم الحياة",
 "life tenant": "مستأجر مدى الحياة (مستأجر يستمر حقه القانوني في حيازة المباني أو الأراضي طالما هو (أو شخص آخر) على قيد الحياة)",
 "life vest": "سترة نجاة (وسيلة نجاة تتكون من سترة بلا أكمام بتصميم طاف أو قابل للنفخ)",
 "life-and-death": "حَيَاتِيّ, مَصِيرِيّ (بالغ الأهمية على نحو حيوي)",
 "life-giving": "بَاعِث لِلْحَيَاة, مُحْيٍ (يمنح أو يملك القدرة على بثّ الحياة والروح)",
 "life-of-man": "أراليا عنقودية, سنبل هندي أمريكي (نبات معمر جذموري خشبي غير مسلح يتميز عن الفشاغ البري بجذور أكثر عطرية وخيمات عنقودية؛ جنوب شرق أمريكا الشمالية إلى المكسيك)",
 "life-or-death": "حَيَاتِيّ, مَصِيرِيّ (بالغ الأهمية على نحو حيوي)",
 "life-size": "بِالحَجْم الطَّبِيعِيّ (بنفس حجم الأصل)",
 "life-sized": "بِالحَجْم الطَّبِيعِيّ (بنفس حجم الأصل)",
 "life-style": "أسلوب حياة, نمط حياة (طريقة للعيش تعكس قيم الشخص ومواقفه)",
 "life-support": "داعم للحياة (مكون من أو متعلق بالمعدات أو الأساليب المستخدمة للحفاظ على الحياة)",
 "life-support system": "نظام دعم الحياة (معدات طبية تساعد أو تحل محل وظائف جسدية مهمة وبالتالي تمكن المريض من العيش والذي لولاها قد لا ينجو) / نظام دعم الحياة (معدات تجعل الحياة ممكنة في ظروف بيئية مميتة لولا ذلك)\nمثال: المريض على أجهزة دعم الحياة",
 "life-sustaining": "حَيَوِيّ, مُقَوِّمٌ لِلْحَيَاة (يؤدّي وظيفة أساسية في الجسم الحيّ)",
 "life-threatening": "جَسِيم, خَطِير (يُثير الخوف أو القلق بتهديده بأذى عظيم)",
 "life-time": "حياة, عمر (الفترة التي يكون فيها شيء ما وظيفياً أو حياً (ما بين الولادة والموت))\nمثال: عاش حياة طويلة وسعيدة",
 "lifeblood": "شريان الحياة, عصب الحياة (قوة أساسية أو مانحة للحياة) / دم الحياة, شريان الحياة (الدم باعتباره قوام الحياة والحيوية)\nمثال: الماء هو شريان الحياة في الهند",
 "lifeboat": "قَارِب نَجَاةَ (الزَّورق؛ سفينة صغيرة)\nمثال: كان لسامي قارب صغير",
 "lifeguard": "مُنْقِذ",
 "lifeless": "جُثَّة هَامِدَة, فَاقِد الحَيَاة (حُرم من الحياة؛ لم يعد على قيد الحياة) / خَالٍ مِنَ الحَيَاة (لا يمتلك القدرة على دعم الحياة) / مَيِّت, هَامِد (فاقد للحيويّة والنشاط والإثارة) / خَاوٍ مِنَ الحَيَاة (خَالٍ مِنَ الحَيَاة أَوْ فُرِّغَ مِنَ الكَائِنَات الحَيَّة)",
 "lifelessly": "بِلَا حَيَاة, كَالمَيِّت (كما لو كان ميتاً) / بلا حراك, كالميت (بطريقة خالية من الحياة) / برتابة, بلا حيوية (بدون حيوية أو نشاط)\nمثال: رقدت الفتاة بين ذراعيها بلا حراك",
 "lifelessness": "انعدام الحياة, جماد (عدم امتلاك حياة) / انعدام الحركة, جمود (حالة عدم وجود حركة)\nمثال: السكون التام لتمثال رخامي",
 "lifelike": "طَبِيعِيّ, وَاقِعِيّ (خالٍ من التصنع والتكلّف) / حَيّ, نَابِض (يستحضر صورًا حيّة ونابضة في الذهن)",
 "lifeline": "حبل النجاة (حبل يُلقى من سفينة ليتمسك به الناس لإنقاذ أنفسهم من الغرق) / حبل الغواص (حبل يرفع أو ينزل غواص أعماق البحار) / شريان حياة, طوق نجاة (دعم يمكن الناس من البقاء أو الاستمرار في فعل شيء ما (غالباً من خلال توفير اتصال أساسي)) / خط الحياة (تجعد في راحة اليد؛ يقال في قراءة الكف أنه يشير إلى طول العمر)\nمثال: وفر الجسر الجوي شريان حياة لبرلين",
 "lifelong": "مَدَى الحَيَاة, مِنَ المَهْدِ إِلَى اللَّحْد (يَسْتَمِرّ طَوالَ الحَياة)",
 "lifer": "سَجِين مُؤَبَّد (سجين يقضي عقوبة السجن مدى الحياة)",
 "lifesaver": "طوق نجاة (وسيلة نجاة على شكل حلقة من مادة طافية) / منقذ سباحة (مرافق يعمل في الشاطئ أو المسبح لحماية السباحين من الحوادث)",
 "lifesaving": "إنقاذ الغرقى (إنقاذ حياة الغرقى)\nمثال: أخذ دورة في إنقاذ الغرقى",
 "lifesize": "بِالحَجْم الطَّبِيعِيّ (بنفس حجم الأصل)",
 "lifespan": "عُمْر ((في الإسلام) أبو حفص عمر بن الخطاب العدوي القرشي، ثاني الخلفاء الراشدين في المذهب السني)\nمثال: جون في عمر أخي.",
 "lifestyle": "نَمَط الحَيَاة",
 "lifetime": "حياة, عمر (الفترة التي يكون فيها شيء ما وظيفياً أو حياً (ما بين الولادة والموت))\nمثال: عاش حياة طويلة وسعيدة",
 "lifework": "إنجاز العمر, عمل العمر (العمل الرئيسي في مسارك المهني)",
 "lifo": "ما يرد أخيراً يصرف أولاً (محاسبة المخزون التي يُفترض فيها أن العناصر الأحدث (التي تم شراؤها مؤخراً) هي التي تباع أولاً)",
 "lift": "رَفَعَ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ) / رفع (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ) / شال (قطعة مربعة كبيرة من القماش الصوفي يستخدمه الرجال كغطاء للرأس يكون عادة غير منقوش ولا مطرز؛ قطعة مستطيلة أو ممثلثة من القماش سواء كان خفيفا أم سميكا من الصوف أو القطن أو الحرير يكون عادة مطرز أو مشغول تضعه النساء على أكتافها) / مِصْعَد, أَصَنْصِير\nمثال: رفع سامي نظارته.",
 "lift bridge": "جسر قلاب, جسر متحرك (جسر يمكن رفعه لقطع الطريق أو للسماح للقوارب أو السفن بالمرور تحته)",
 "lift capacity": "قدرة الرفع (أقصى حمل موصى به يمكن للرافعة رفعه)\nمثال: رافعة المناطق الوعرة هذه لديها قدرة رفع تبلغ 60 طناً",
 "lift pump": "مضخة رفع (مضخة تستخدم لرفع السائل بدلاً من دفعه لأعلى)",
 "lift up": "رَفَعَ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ)\nمثال: رفع سامي نظارته.",
 "lifted": "مَرْفُوع لِلأَعْلَى (ممسوك أو مرفوع في الهواء)",
 "lifter": "سارق متاجر (لص يسرق البضائع الموجودة في متجر) / رافع أثقال (رياضي يرفع الأثقال)",
 "liftgate": "باب خلفي, هاتشباك (باب سيارة خلفي مائل يُرفع لفتحه)",
 "lifting device": "جهاز رفع, رافعة (جهاز لرفع الأحمال الثقيلة)",
 "liftman": "رجل المصعد, عامل مصعد (رجل موظف لتشغيل المصعد)",
 "liftoff": "إقلاع (الصعود الأولي للصاروخ من منصة الإطلاق)",
 "ligament": "رِبَاط",
 "ligamentum teres uteri": "رباط مدور للرحم (رباط متصل بالرحم على الجانبين أمام وأسفل فتحة قناة فالوب ويمر عبر القناة الأربية إلى الشفرين الكبيرين)",
 "ligan": "بضائع غارقة موسومة (بضائع (أو حطام) في قاع البحر مربوطة بعوامة لتسهيل استعادتها)",
 "ligand": "ربيطة",
 "ligation": "ربط جراحي ((جراحة) ربط قناة أو وعاء دموي برباط (لمنع النزيف أثناء الجراحة مثلاً))",
 "ligature": "ربط, عقد (عملية ربط أو توثيق الأشياء ببعضها البعض) / رابط, موثق (شيء يستخدم للربط أو التوثيق) / خيط ربط, رباط جراحي (خيط يستخدمه الجراحون لربط وعاء دموي (لتضييق تدفق الدم)) / رباط (شريط معدني يستخدم لربط الريشة بقطعة الفم في الكلارينيت أو الساكسفون)",
 "liger": "أَسَد بَبْرِيّ (نوع من السباع مفترس من فصيلة السنوريات، يشتهر بفروة تحيط برقبته. أنثاه لبوة. يُعرَف بمَلِك الغابة؛  الرجل الشجاع القوي. مؤنثه أَسَدَة)\nمثال: الأسد حيوان بري.",
 "light": "إِشَارَة مُرُور, إِشَارَة ضَوْئِيَّة / نُور, ضَوْء (ضد الظَلام؛ ما يشع فيمكن الرؤية بسببه؛ ضد الضوء:ما يشع من أصله وليس ما يعكس الشعاع من غيره) / أَشْعَلَ, أَوْقَدَ ((أَشْعَلَ) النارَ: شَعَلها؛ يقال أَشْعَلَ فلانًا: هيَّج غَضبَه) / أَضَاءَ / مُنِير / فَاتِح (الرجلُ المرأةَ: جامعها؛ عمرٌ زيدًا: قاضاه وحاكمه) / خَفِيف / خفيف\nمثال: نسي أن يطفئ النور.",
 "light adaptation": "تأقلم مع الضوء (عملية تكيف العينين مع مستويات عالية نسبياً من الإضاءة؛ تتقلص الحدقة وينشط نظام المخاريط)",
 "light air": "هواء خفيف (رياح تتحرك بسرعة 1-3 عقد؛ 1 على مقياس بوفورت)",
 "light arm": "سلاح خفيف (بندقية أو مسدس)",
 "light ballast": "كابح, موازن ضوء (جهاز كهربائي لبدء وتنظيم مصابيح الفلورسنت والتفريغ)",
 "light beam": "حزمة ضوئية, شعاع (عمود من الضوء (كما من منارة))",
 "light beer": "بيرة خفيفة, لاغر خفيفة (بيرة لاغر ذات محتوى كحولي منخفض)",
 "light blue": "سَمَاوِيّ, لَبَنِيّ",
 "light bread": "خبز أبيض (خبز مصنوع من دقيق القمح المطحون ناعماً والمبيض عادة)",
 "light breeze": "نسيم خفيف (رياح تتحرك بسرعة 4-7 عقد؛ 2 على مقياس بوفورت)",
 "light brown": "بني فاتح (بني فاتح ولكنه غير مشبع)",
 "light bulb": "لَمْبَة, مِصْبَاح",
 "light circuit": "دائرة إضاءة (تمديدات توفر الطاقة للمصابيح الكهربائية)",
 "light colonel": "مقدم (ضابط مفوض في الجيش أو القوات الجوية أو المارينز، رتبته أعلى من رائد وأقل من عقيد)",
 "light company": "شركة طاقة, شركة كهرباء (مرفق عام يوفر الكهرباء)",
 "light cream": "كريمة القهوة, كريمة خفيفة (كريمة تحتوي على 18% على الأقل من دهن الزبدة)",
 "light cruiser": "طراد خفيف (نوع من السفن الحربية الصغيرة أو المتوسطة الحجم التي تحمل درعاً بنفس طريقة الطراد المدرع: حزام واقٍ وسطح)\nمثال: بعد عام 1930، ركزت معظم القوى البحرية على بناء الطرادات الخفيفة لأنها كانت قد وصلت بالفعل إلى الحد الأقصى المسموح به بموجب معاهدة واشنطن",
 "light diet": "حمية خفيفة, نظام غذائي للنقاهة (حمية توصف للملازمين للفراش أو في فترة النقاهة؛ لا تشمل الأطعمة المقلية أو كثيرة التوابل)",
 "light filter": "شاشة نشر, مرشح ضوئي (مرشح شفاف يقلل الضوء (أو بعض الأطوال الموجية للضوء) المار عبره)",
 "light fitting": "تركيبات إضاءة, وحدة إضاءة (جهاز كهربائي يستخدم لإنشاء ضوء صناعي باستخدام مصباح كهربائي؛ تحتوي جميع وحدات الإضاءة على جسم وحدة ومقبس مصباح لحمل المصباح والسماح باستبداله)",
 "light fixture": "تركيبات إضاءة, وحدة إضاءة (جهاز كهربائي يستخدم لإنشاء ضوء صناعي باستخدام مصباح كهربائي؛ تحتوي جميع وحدات الإضاءة على جسم وحدة ومقبس مصباح لحمل المصباح والسماح باستبداله)",
 "light flyweight": "وزن الذبابة الخفيف (ملاكم هاوٍ لا يزيد وزنه عن 106 أرطال (حوالي 48 كجم))",
 "light heavyweight": "وزن الكروزر, وزن خفيف الثقيل (ملاكم محترف يتراوح وزنه بين 169 و 175 رطلاً) / وزن خفيف الثقيل (مصارع يزن 192-214 رطلاً) / وزن خفيف الثقيل (ملاكم هاوٍ لا يزيد وزنه عن 179 رطلاً (حوالي 81 كجم)) / وزن خفيف ثقيل (فئة وزن في الرياضات القتالية، للمقاتلين الأثقل من فئة الوزن المتوسط وأخف من فئة الوزن الثقيل)",
 "light hour": "ساعة ضوئية (المسافة التي يقطعها الضوء في الفراغ خلال ساعة واحدة؛ حوالي مليار كيلومتر)",
 "light intensity": "شدة الإضاءة, قوة الشمعة (شدة الإضاءة مقاسة بالشمعات)",
 "light machine gun": "رشاش خفيف (رشاش لا يتجاوز عياره 0.30 (حوالي 7.62 مم))",
 "light meter": "مقياس الضوء (معدات تصوير فوتوغرافي تقيس شدة الضوء)",
 "light microscope": "مجهر ضوئي (مجهر يتكون من أداة بصرية تكبر صورة الجسم)",
 "light middleweight": "وزن خفيف المتوسط (ملاكم هاوٍ لا يزيد وزنه عن 156 رطلاً (حوالي 71 كجم)) / وزن خفيف متوسط (فئة وزن في الرياضات القتالية، للمقاتلين الأثقل من فئة وزن الوسط وأخف من فئة الوزن المتوسط)",
 "light minute": "دقيقة ضوئية (المسافة التي يقطعها الضوء في الفراغ خلال دقيقة واحدة؛ حوالي 18 مليون كيلومتر)",
 "light opera": "أوبرا خفيفة, أوبريت (أوبرا قصيرة مسلية)",
 "light pen": "قلم ضوئي ((في علم الحاسوب) مؤشر يستشعر عند توجيهه إلى شاشة الحاسوب ما إذا كانت النقطة مضاءة أم لا)",
 "light reaction": "تفاعل ضوئي (فلان وفلان: أثّر كلّ منهما في الآخر؛ مع الشيء: تأثّر به)",
 "light reflex": "تقبض الحدقة, منعكس الضوء (انكماش انعكاسي للعضلة العاصرة للقزحية استجابة لضوء ساطع (أو أدوية معينة) مما يسبب صغر حجم الحدقة)",
 "light second": "ثانية ضوئية (المسافة التي يقطعها الضوء في الفراغ خلال ثانية واحدة؛ حوالي 300,000 كيلومتر)",
 "light show": "عرض ضوئي (عرض لأضواء ملونة تتحرك في أنماط متغيرة)",
 "light sleep": "سنة, غفوة (النوم لفترة قصيرة (عادة ليس في السرير))",
 "light source": "ضوء, مصدر ضوء (أي جهاز يعمل كمصدر للإضاءة)\nمثال: أوقف السيارة وأطفأ الأضواء",
 "light speed": "سُرْعَة الضَّوْء (السرعة التي ينتقل بها الضوء في الفراغ؛ الثبات والعالمية لسرعة الضوء معترف بهما بتعريفها لتكون بالضبط 299,792,458 متراً في الثانية)",
 "light switch": "قَاطِعَة",
 "light syllable": "مقطع خفيف (مقطع صوتي نواته صائت قصير ولا ذيل له)",
 "light time": "مسافة ضوئية زمنية (المسافة المقاسة بدلالة سرعة الضوء (أو موجات الراديو))\nمثال: المسافة الضوئية الزمنية من المشتري إلى الشمس هي 43 دقيقة تقريباً",
 "light touch": "احتكاك خفيف, لمسة عابرة (تلامس لحظي)",
 "light unit": "وحدة ضوئية (مقياس للإشعاع الكهرومغناطيسي المرئي)",
 "light welterweight": "وزن خفيف الوسط (ملاكم هاوٍ لا يزيد وزنه عن 140 رطلاً (حوالي 63.5 كجم)) / وزن خفيف الوسط (فئة وزن في الرياضات القتالية، للمقاتلين الأثقل من فئة الوزن الخفيف وأخف من فئة وزن الوسط)",
 "light whipping cream": "كريمة الخفق (كريمة تحتوي على ما يكفي من دهن الزبدة (30% إلى 36%) ليتم خفقها)",
 "light within": "النور الداخلي (حضور إلهي يؤمن به الكويكرز (جمعية الأصدقاء) بأنه ينير الروح ويهديها)",
 "light year": "سَنَة ضَوْئِيَّة (مقدارُ قطع الشمس البروجَ الاثني عشر ، وهي السنة الشمسيَّة، و السَّنَةُ تمامُ اثنتَيْ عشرةَ دَورةً للقمر ، وهي السنة القمرية…)\nمثال: في عمره 24 سنة.",
 "light-armed": "خَفِيف التَّسْلِيح (مسلَّح بمعدّات وأسلحة خفيفة) / خَفيف التَّسْليح (مُسَلَّح بِأسْلِحَة خَفيفَة)",
 "light-blue": "أَزْرَق فَاتِح (بدرجة فاتحة من الأزرق)",
 "light-boned": "خَفِيفُ العِظَام (ذو هيكل عظمي خفيف نسبة إلى حجم الجسم)",
 "light-colored": "فَاتِح, فَاتِح اللَّوْن ((يستخدم للون) لديه كمية صغيرة نسبياً من عامل التلوين)\nمثال: أزرق فاتح",
 "light-duty": "للمهام الخفيفة (غير مصمم للعمل الشاق)\nمثال: منظف للمهام الخفيفة",
 "light-emitting diode": "صمام ثنائي باعث للضوء, ليد (الصِّمَامُ : السِّدَادُ؛ الصِّمام : جهاز لضبط السوائل والغازات في أَوعيتها وتنظيم انسيابها في اتِّجاه دون آخر)\nمثال: فتح سامر صمام المياه.",
 "light-fingered": "خَفِيف الأَصَابِع, نَشَّال (ذو أصابع رشيقة حقيقةً أو مجازاً؛ خاصة في السرقة أو النشل)",
 "light-footed": "خفيف الخطى, رشيق الحركة ((للحركة) ذو خطوة خفيفة ومرنة)\nمثال: فتاة خفيفة الخطى",
 "light-green": "أَخْضَر (بلون بين الأزرق والأصفر في الطيف اللوني؛ مشابه للون العشب الطازج)",
 "light-haired": "أَشْقَر (كونه أو لديه بشرة وشعر فاتح اللون وعادة عيون زرقاء أو رمادية)\nمثال: اسكندنافيون شقر",
 "light-handed": "خَفِيفُ اللَّمْسَة, رَشِيق (ذُو لَمْسَةٍ رَقِيقَةٍ مَجَازِيًّا)",
 "light-handedly": "بخفة يد, بلطف (بطريقة خفيفة اليد)",
 "light-headed": "دَائِخ",
 "light-headedly": "بدوار, بدوخة (بطريقة دوارة أو خفيفة الرأس)\nمثال: مشى حوله بدوار",
 "light-hearted": "خَفِيف الرُّوح, فَرِح (بلا هموم؛ سعيد وخفيف القلب)",
 "light-heartedly": "باستهتار مرح, ببساطة (بطريقة مرحة وخالية من الهموم)\nمثال: إنه يتجاهل باستهتار بعض حقائق الحياة الأساسية",
 "light-minded": "خَفِيف العَقْل, مُسْتَخِفّ (يُظهر خفّة غير لائقة في موضع يستدعي الجدّية)",
 "light-mindedness": "استخفاف, سلاطة (خفة غير لائقة)\nمثال: ردت أنيكا على استخفاف توم بنظرة باردة",
 "light-o'-love": "امرأة لعوب (امرأة متقلبة في الحب)",
 "light-of-love": "امرأة لعوب (امرأة متقلبة في الحب)",
 "light-sensitive": "حَسَّاس لِلضَّوْء, ضَوْئِيّ الحَسَاسِيَّة (حسّاس للضوء المرئي)",
 "light-tight": "حَاجِب لِلضَّوْء, مَانِع لِلضَّوْء (لا ينفذ منه الضوء مطلقاً)",
 "light-year": "سنة ضوئية (المسافة التي يقطعها الضوء في الفراغ خلال سنة واحدة؛ حوالي 9.46 تريليون كيلومتر)",
 "lightbulb": "لمبة, مصباح كهربائي (مصباح كهربائي يتكون من غلاف زجاجي شفاف أو نصف شفاف يحتوي على فتيل سلكي (عادة من التنجستن) يبعث الضوء عند تسخينه بالكهرباء)",
 "lighted": "مُضَاء, مُنَار (مُزَوَّد بِإِضَاءَة صِنَاعِيَّة) / مُشْتَعِل, مُضَاء (مضرم فيه النار أو محترق)\nمثال: الشموع المضاءة",
 "lighten": "بَرَقَ, أَبْرَقَ (بَرَقَ الرجلُ: تَهَدّدَ وتَوَعَّدَ، كأَبْرَقَ؛ بَرَقَ الشيءُ بَرْقاً وبَريقاً وبَرَقاناً: لَمَعَ)\nمثال: البرق يسبق الرعد",
 "lightener": "مادة تفتيح, مفتح (أي نوع من عوامل التفتيح التي يمكن استخدامها لتفتيح مظهر الشعر والجلد والخشب والأسطح الأخرى)\nمثال: صودا الخبز الممزوجة بعصير الليمون تشكل مفتحاً طبيعياً ورخيصاً للبشرة",
 "lightening": "تبييض, تفتيح (التغيير إلى لون أفتح) / تخفف, تدلي الجنين (نزول الرحم في تجويف الحوض الذي يحدث في أواخر الحمل؛ ويقال أن الجنين قد نزل)",
 "lighter": "قَدَّاحَة, وَلَّاعَة",
 "lighter-than-air": "أَخَفّ مِن الهَواء (أخَفّ مِن الهَواء الَّذي يُزيحُه (عَن المَناطيد))",
 "lighter-than-air craft": "مركبة أخف من الهواء, منطاد (طائرة مدعومة بطفوها الذاتي)",
 "lighterage": "نقل بالصنادل (نقل البضائع على صندل (قارب مسطح)) / أجرة الصندل (الرسم المفروض لنقل البضائع في صنادل (قوارب مسطحة))",
 "lighterman": "صاحب صندل, ملاح (رجل يقوم بتشغيل صندل (قارب مسطح))",
 "lighterwoman": "ملاحّة (امرأة تشغل صندلاً (قارب مسطح))",
 "lightheaded": "تَافِه, طَائِش (يفتقر إلى الجدّية؛ ميّال إلى التفاهة والاستخفاف) / مُغْمًى عَلَيْه تَقْرِيبًا, يَكَاد يُغْشَى عَلَيْه (ضعيف ومعرَّض لفقدان الوعي)",
 "lightheadedness": "خفة عقل, دوار (نقص طائش في التعقل) / دوار, دوخة (إحساس بالدوران؛ شعور بأنك على وشك السقوط)",
 "lighthearted": "خَفِيف الرُّوح, فَرِح (بلا هموم؛ سعيد وخفيف القلب)",
 "lightheartedness": "انطلاق, خلو البال (الشعور المبهج الذي ينتابك عندما لا يزعجك شيء)",
 "lighthouse": "مَنَارَة, مَنَار (أسم، محجَّة الطريق وما يُوضَع بين الشيئَين من الحدود؛ اسم، البرج عند البحر يوضع فيه نور لتهتدي به السفن)",
 "lighthouse keeper": "حارِس الفَنار, حارِس المَنارَة (الشخص المسؤول عن المنارة)",
 "lighting": "إِضَاءَة",
 "lighting circuit": "دائرة إضاءة (تمديدات توفر الطاقة للمصابيح الكهربائية)",
 "lighting fixture": "مصباح, وحدة إضاءة (وحدة توفر ضوءاً اصطناعياً)",
 "lighting industry": "صناعة الإضاءة (صناعة مكرسة لتصنيع وبيع وتركيب الإضاءة)",
 "lightless": "بِلَا إِضَاءَة, غَيْر مُنَار (بِدُون إِنَارَة أَوْ إِضَاءَة) / لَا يُصْدِرُ ضَوْءًا, مُعْتِم (لَا يُعْطِي ضَوْءًا)",
 "lightlessness": "حلكة, سواد (الغياب التام للضوء)\nمثال: تحسسوا طريقهم في ظلام دامس",
 "lightly": "باستخفاف, ببساطة (بلا مبالاة أو بدون اكتئاب) / باعتدال, بخفة (الانغماس باعتدال) / بشكل طفيف, خفيفاً (إلى درجة طفيفة) / بخفة, برفق (بقليل من الوزن أو القوة)\nمثال: أخذ الأمر باستخفاف",
 "lightly armored": "خَفِيف التَّدْرِيع (مجهَّز بدروع كافية للوقاية من نيران الأسلحة الخفيفة)",
 "lightly armoured": "خَفِيف التَّدْرِيع (مجهَّز بدروع كافية للوقاية من نيران الأسلحة الخفيفة)",
 "lightly-armed": "خَفيف التَّسْليح (مُسَلَّح بِأسْلِحَة خَفيفَة)",
 "lightness": "خِفَّة",
 "lightning": "بَرْق (بَرَقَ الرجلُ: تَهَدّدَ وتَوَعَّدَ، كأَبْرَقَ؛ بَرَقَ الشيءُ بَرْقاً وبَريقاً وبَرَقاناً: لَمَعَ) / بَرَقَ, أَبْرَقَ (بَرَقَ الرجلُ: تَهَدّدَ وتَوَعَّدَ، كأَبْرَقَ؛ بَرَقَ الشيءُ بَرْقاً وبَريقاً وبَرَقاناً: لَمَعَ)\nمثال: البرق يسبق الرعد",
 "lightning arrester": "مانع اندفاع التيار, واقي من الارتفاع المفاجئ (جهاز كهربائي يدرج في خط الطاقة لحماية المعدات من التقلبات المفاجئة في التيار)",
 "lightning bug": "حشرة سراج الليل, يراعة (خنفساء ليلية شائعة في المناطق الدافئة لها أعضاء بطنية مضيئة)",
 "lightning conductor": "مانعة صواعق (موصل معدني مثبت في نقطة عالية ويؤدي إلى الأرض؛ يحمي المبنى من الدمار بواسطة البرق)",
 "lightning rod": "مَانِعَة صَوَاعِق",
 "lightning strike": "صَاعِقَة",
 "lightproof": "حَاجِب لِلضَّوْء, مَانِع لِلضَّوْء (لا ينفذ منه الضوء مطلقاً)",
 "lights, camera, action": "الْأَضْوَاء، الْكَامِيرَا، اِبْدَأ, الْأَضْوَاء، الْكَامِيرَا، اِبْدَئِي",
 "lights-out": "نداء إطفاء الأنوار ((عسكري) إشارة لإطفاء الأنوار) / وقت إطفاء الأنوار (وقت محدد للنوم)",
 "lightsaber": "سَيْف الضَّوْءِ (مصدر للفعل سَافَ؛ سِلاح ذو حَدّ واحد طويل يعتبر من الأسْلِحَة البيضاء لأنها مصنوعة من حَدِيد أبيض حاد. كان أهم أنواع الأسلحة قبل اخْتِرَاع الأسلحة النَارِيَّة)\nمثال: القلم أقوى من السيف.",
 "lightship": "سفينة منارة (سفينة مجهزة كمنارة وراسية في مكان يكون فيه بناء منارة دائمة غير عملي)",
 "lightsome": "خَفِيف الرُّوح, فَرِح (بلا هموم؛ سعيد وخفيف القلب) / خَفيف الحَرَكَة, رَشيق (يَتَحَرَّك بِسُهولَة وسُرْعَة وخِفَّة)",
 "lightsomely": "باستهتار مرح, ببساطة (بطريقة مرحة وخالية من الهموم) / بخفة, برشاقة (يتحرك بخطوات خفيفة وسريعة)\nمثال: إنه يتجاهل باستهتار بعض حقائق الحياة الأساسية",
 "lightsomeness": "استهتار, مرح (سمة كون المرء مرحاً وعابثاً) / خفة الحركة, مرونة (رشاقة شخص أو حيوان سريع وخفيف الحركة) / انطلاق, خلو البال (الشعور المبهج الذي ينتابك عندما لا يزعجك شيء)",
 "lightspeed": "سُرْعَةْ اَلضَّوْء",
 "lightstick": "عصا مضيئة (أنبوب بلاستيكي صغير يحتوي على مواد كيميائية تنتج ضوءاً عند كسرها)",
 "lightweight": "خَفيف الوَزْن (قَليل الوَزْن نِسْبِيًّا مُقارَنَةً بِمَثيلِه) / خَفِيف الوَزْن, هَامِشِيّ (ليس له أهمّيّة أو تأثير) / وزن خفيف (ملاكم محترف يتراوح وزنه بين 131 و 135 رطلاً) / وزن خفيف (مصارع يزن 139-154 رطلاً)",
 "lightweight aerated concrete": "خرسانة خلوية, خرسانة رغوية (نوع من الخرسانة المهواة مع إضافة عامل تهوية (أو ركام خفيف الوزن مثل ركام الطين الممدد أو حبيبات الفلين والفيرميكوليت))\nمثال: لا تخلط بين الخرسانة الخلوية والخرسانة المهواة المعالجة بالأوتوكلاف، والتي يتم تصنيعها خارج الموقع باستخدام طريقة مختلفة تماماً",
 "lightweight concrete": "خرسانة خلوية, خرسانة رغوية (نوع من الخرسانة المهواة مع إضافة عامل تهوية (أو ركام خفيف الوزن مثل ركام الطين الممدد أو حبيبات الفلين والفيرميكوليت))\nمثال: لا تخلط بين الخرسانة الخلوية والخرسانة المهواة المعالجة بالأوتوكلاف، والتي يتم تصنيعها خارج الموقع باستخدام طريقة مختلفة تماماً",
 "lightwood": "خشب النور, سنط أسود الخشب (أكاسيا أسترالية طويلة تنتج أخشاباً سوداء ذات قيمة عالية)",
 "ligne": "لين (وحدة خطية (1/40 بوصة) تستخدم لقياس قطر الأزرار)",
 "ligneous": "خَشَبِيُّ البِنْيَةِ, لِيغْنِينِيّ (مُكَوَّنٌ مِنَ اللِّيغْنِينِ أَوِ الخَشَبِينِ أَوْ يَحْتَوِي عَلَيْهِمَا)",
 "ligneous plant": "نبات خشبي (نبات له أنسجة خشبية صلبة، خاصة السيقان)",
 "lignin": "خشبين, ليجنين (بوليمر معقد؛ المكون الرئيسي للخشب بخلاف الكربوهيدرات؛ يرتبط بألياف السليلوز لتقوية وتصلب جدران الخلايا النباتية)",
 "lignite": "فحم بني",
 "lignosae": "نباتات خشبية (فئة في بعض التصنيفات المبكرة)",
 "lignum": "نسيج خشبي (نسيج خشبي)",
 "lignum vitae": "جياك طبي, خشب الأنبياء (شجرة صغيرة دائمة الخضرة في منطقة البحر الكاريبي وجنوب أمريكا الوسطى إلى شمال أمريكا الجنوبية؛ مصدر لخشب الجياك، وهو أصلب الأخشاب التجارية، وراتنج طبي) / خشب الأنبياء, ليغنوم فايتي (خشب بني مخضر صلب لشجرة خشب الأنبياء وأشجار أخرى من جنس الغاياكوم)",
 "ligol": "تفاح ليغول (مجموعة متنوعة من التفاح يتم تربيتها في بولندا؛ يتم حصادها في أكتوبر)\nمثال: لحم تفاح ليغول متماسك وصلب وقاس",
 "ligress": "لَبُؤَة بَبْرِيَّة, لَبْوَة بَبْرِيَّة",
 "ligule": "لُسَيْن ((في علم النبات) أي زائدة في النبات تكون على شكل شريط)",
 "liguria": "لِيغُورْيَا",
 "ligustrum amurense": "تمرحنة آمور (شجيرة شرق آسيوية تُزرع خاصة لأوراقها المستمرة)",
 "ligustrum ibolium": "تمرحنة إيبوليوم (هجين سريع النمو ومتفرع بإحكام من التمرحنة بيضاوية الأوراق والتمرحنة منفرجة الأوراق)",
 "ligustrum japonicum": "تمرحنة يابانية (شجيرة دائمة الخضرة من اليابان وكوريا لها أوراق داكنة صغيرة وزهور في عناقيد فضفاضة؛ مرتبطة بالتمرحنة الصينية ولكنها أصغر)",
 "ligustrum lucidum": "تمرحنة صينية, شجرة الشمع الأبيض (شجيرة تشبه الشجرة قائمة دائمة الخضرة من الصين وكوريا واليابان لها أوراق مستدقة وزهور في عناقيد قائمة طويلة؛ تشبه التمرحنة اليابانية)",
 "ligustrum obtusifolium": "تمرحنة منفرجة الأوراق (شجيرة صغيرة متساقطة الأوراق لها فروع مقوسة رشيقة وأوراق وفيرة)",
 "ligustrum ovalifolium": "تمرحنة كاليفورنية (شجيرة يابانية شبه دائمة الخضرة لها زهور كريهة الرائحة؛ تستخدم بكثرة للتحوط لأنها تبقى خضراء أكثر من التمرحنة الشائعة)",
 "ligustrum vulgare": "تمرحنة شائعة (شجيرة متساقطة الأوراق شبه دائمة الخضرة تستخدم للتحوط)",
 "lii": "اِثْنَان وَخَمْسُونَ (يَدُلُّ عَلَى العَدَد 52)",
 "liii": "ثَلَاثَة وَخَمْسُونَ (يَدُلُّ عَلَى العَدَد 53)",
 "lijiang": "لِيجْيَانْغ",
 "likable": "لَطِيف, مُسْتَحَبّ (سهل أن يُحَبّ؛ مقبول ومُستحسَن) / جذاب, محبوب ((للشخصيات في الأدب أو الدراما) تثير مشاعر التعاطف أو الإعجاب)\nمثال: الشخصيات المحبوبة في المسرحية",
 "like": "حَبَّ (الزرع، كبيرا كان أم صغيرا؛ بَذْرُ الزرع) / أَحَبَّ (مَالَ إلى الشيء أو الشخص، وَدَّه؛ للزَّرع: بَدا حَبُّه) / اِسْتَمْطَعَ / أَعْجَبَ (سُرَّ بالشيءِ) / مِثْل (الشَبَه؛ النَظِير) / مِثْل, شِبْه (الشَبَه؛ النَظِير) / مِثْل, كَـ (الشَبَه؛ النَظِير)\nمثال: زيري بحب المال.",
 "like a shot": "الآن, حالاً (بدون تأخير أو تردد؛ بدون وقت فاصل)\nمثال: أجاب فوراً",
 "like an expert": "بخبرة, بمهارة (بطريقة خبيرة)\nمثال: أصلح التلفاز بمهارة",
 "like blue murder": "بأقصى سرعة (بسرعة قصوى)\nمثال: ركض بأقصى سرعة للحاق بالحافلة",
 "like clockwork": "بانتظام ودقة, مثل الساعة (بانتظام ودقة)\nمثال: انطلق الصاروخ بدقة متناهية (مثل الساعة)",
 "like crazy": "بجنون, بشدة ((عامية) بسرعة أو جهد أو شدة كبيرة؛ للمبالغة)\nمثال: قاد بجنون",
 "like father, like son": "الْوَلَدُ سُرّ أَبِيهِ",
 "like fun": "في أحلامه, مستحيل (تستخدم بسخرية للإشارة إلى عكس ما قيل)\nمثال: يقول إنه سيساعدني؟ في أحلامه!",
 "like hell": "بجنون, بشدة ((عامية) بسرعة أو جهد أو شدة كبيرة؛ للمبالغة) / في أحلامه, مستحيل (تستخدم بسخرية للإشارة إلى عكس ما قيل)\nمثال: قاد بجنون",
 "like it or not": "شَاءَ أَمْ أَبَى, شِئْنَا أَمْ أَبَيْنَا (أَرَادَ)\nمثال: إن شاء الله ؛",
 "like kings": "ملكياً (بطريقة ملكية)\nمثال: عوملوا معاملة ملكية",
 "like mad": "بجنون, بشدة ((عامية) بسرعة أو جهد أو شدة كبيرة؛ للمبالغة)\nمثال: قاد بجنون",
 "like royalty": "ملكياً (بطريقة ملكية)\nمثال: عوملوا معاملة ملكية",
 "like sin": "بجنون, بشدة ((عامية) بسرعة أو جهد أو شدة كبيرة؛ للمبالغة)\nمثال: قاد بجنون",
 "like that": "هَٰكَذَا, كَذَا",
 "like the devil": "بجنون, بشدة ((عامية) بسرعة أو جهد أو شدة كبيرة؛ للمبالغة)\nمثال: قاد بجنون",
 "like thunder": "بجنون, بشدة ((عامية) بسرعة أو جهد أو شدة كبيرة؛ للمبالغة)\nمثال: قاد بجنون",
 "like-minded": "مُتَوَافِق الرَّأْي (يَتَشابَه في الآراء وَالأَفْكار مَعَ الآخَرين)",
 "likeable": "لَطِيف, مُسْتَحَبّ (سهل أن يُحَبّ؛ مقبول ومُستحسَن) / جذاب, محبوب ((للشخصيات في الأدب أو الدراما) تثير مشاعر التعاطف أو الإعجاب)\nمثال: الشخصيات المحبوبة في المسرحية",
 "liked": "محبوب (يعتبر ممتعاً أو جذاباً؛ غالباً ما تستخدم كصيغة مركبة)\nمثال: معلم محبوب جداً",
 "likelihood": "إِمْكَانِيَّة, احْتِمَال (احتمالية نتيجة محددة)",
 "likeliness": "إِمْكَانِيَّة, احْتِمَال (احتمالية نتيجة محددة)",
 "likely": "عَلَى الأَغْلَبِ (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال.",
 "liken": "شَبَّهَ",
 "likeness": "شبه, صورة مماثلة (صورة تتكون من تمثيل رسومي لشخص أو شيء) / شَبَه, مُمَاثَلَة (التشابه في المظهر أو الشخصية أو الطبيعة بين الأشخاص أو الأشياء)\nمثال: خلق الإنسان على صورته",
 "likening": "تشبيه (فعل مقارنة أوجه التشابه)",
 "likewise": "كَذٰلِك, أَيْضًا / بِالمِثْل",
 "liking": "إعجاب, ميل (شعور بالمتعة والاستمتاع)\nمثال: كان لدي دائماً ميل للقراءة",
 "likuta": "ليكوتا (100 ليكوتا تساوي 1 زائير في زائير)",
 "lilac": "لَيْلَك / لَيْلَكِيّ",
 "lilac-blue": "أَزْرَق بَنَفْسَجِيّ, أَزْرَق لَيْلَكِيّ (أزرق مع مسحة خزامية)",
 "lilac-colored": "خُزَامِيّ, لَيْلَكِيّ (بلون أرجواني فاتح)",
 "lilac-pink": "وَرْدِيّ بَنَفْسَجِيّ, وَرْدِيّ لَيْلَكِيّ (وردي مع مسحة خزامية)",
 "lilac-purple": "أُرْجُوَانِيّ لَيْلَكِيّ (أرجواني مع مسحة ليلكية)",
 "lilangeni": "ليلانجيني (وحدة المال الأساسية في سوازيلاند؛ تساوي 100 سنت)",
 "liliaceous": "زنبقي (مكون من أو يخص أو مميز لنباتات الفصيلة الزنبقية)",
 "liliaceous plant": "نبات زنبقي (نبات ينمو من بصلة أو كورمة أو جذمور أو درنة)",
 "lilian": "لِيلْيَان",
 "liliid monocot family": "فصيلة زنبقية أحادية الفلقة (فصيلة من النباتات أحادية الفلقة من طائفة الزنبقيات؛ معظمها أعشاب عادةً بسبلات وبتلات تويجية ومدقات مركبة)",
 "liliid monocot genus": "جنس زنبقي (جنس من نباتات أحادية الفلقة يضم في الغالب أعشاباً لها بتلات وسبلات شبيهة بالبتلات)",
 "liliopsid": "أحادي الفلقة, نبات ذو فلقة واحدة (نبات زهري أحادي الفلقة؛ ينمو الساق عن طريق تراكمات في داخله)",
 "liliopsid family": "فصيلة أحاديات الفلقة (فصيلة من النباتات المزهرة لها فلقة واحدة (ورقة جنينية) في البذرة)",
 "liliopsid genus": "جنس أحادي الفلقة (جنس من النباتات المزهرة ذات فلقة واحدة (ورقة جنينية) في البذرة)",
 "lilith": "لِيلِيث",
 "lilium auratum": "زنبق الجبل (زنبق ياباني بأشعة ذهبية)",
 "lilium canadense": "زنبق أصفر بري, زنبق كندا (زنبق شائع في شرق الولايات المتحدة له زهور صفراء أو محمرة متدلية منقطة بالبني)",
 "lilium candidum": "زنبق أبيض, زنبق مادونا (زنبق شرق البحر الأبيض المتوسط والبلقان بزهور بيضاء عريضة قمعية الشكل)",
 "lilium catesbaei": "زنبق الصنوبر, زنبق النمر (زنبق من جنوب شرق الولايات المتحدة له زهور كأسية الشكل ببتلات منحنية صفراء عميقة إلى قرمزية)",
 "lilium columbianum": "زنبق أوريغون, زنبق كولومبيا النمري (زنبق من غرب أمريكا الشمالية بزهور برتقالية حمراء منقطة بالأرجواني مبهرجة)",
 "lilium lancifolium": "زنبق النمر (نبات معمر شرق آسيوي له زهور برتقالية محمرة كبيرة منقطة بالأسود ببتلات منحنية للخلف)",
 "lilium longiflorum": "زنبق الفصح, زنبق برمودا (زنبق طويل له زهور بيضاء كبيرة بوقية الشكل تتفتح في الربيع)",
 "lilium maritinum": "زنبق الساحل (زنبق برتقالي الزهور من ساحل المحيط الهادئ للولايات المتحدة)",
 "lilium martagon": "زنبق العمامة, مارتاغون (زنبق بزهور أرجوانية باهتة صغيرة من شمال غرب أوروبا وشمال غرب آسيا)",
 "lilium michiganense": "زنبق ميشيغان (زنبق من وسط أمريكا الشمالية له زهور برتقالية حمراء منحنية ببقع قرمزية عميقة)",
 "lilium pardalinum": "زنبق النمر (زنبق من غرب الولايات المتحدة له زهور برتقالية حمراء إلى قرمزية منقطة بالمارون)",
 "lilium philadelphicum": "زنبق الخشب (زنبق من شرق أمريكا الشمالية له زهور برتقالية إلى برتقالية حمراء منقطة بالأرجواني)",
 "lilium superbum": "زنبق العمامة, زنبق رائع (زنبق من شرق الولايات المتحدة بزهور برتقالية إلى حمراء منقطة بالمارون)",
 "lille": "لِيل (من مغرب الشمس إلى طلوعها)\nمثال: بكت طوال الليل.",
 "lilliput": "ليليبوت (أرض تخيلها جوناثان سويفت يسكنها أناس صغار جدًا)",
 "lilliputian": "قَزَم",
 "lilo": "مرتبة هوائية عائمة (نوع من المراتب الهوائية القابلة للنفخ)",
 "lilongwe": "لِيلُونْغْوِي / لِيلُونْجْوِي",
 "lilt": "أرجحة, إيقاع مرح (إيقاع مبتهج في الموسيقى)",
 "lilting": "خَفِيفُ الإِيقَاع, مَرِح (يتميّز بإيقاع مرح ومتمايل)",
 "lily": "زَنْبَق, سَوْسَن",
 "lily of the incas": "زنبق الإنكا, زنبق بيروفي (عشب من الأنديز له مظلات من زهور وردية أرجوانية مبهرجة تشبه الزنبق)",
 "lily of the nile": "أغابانثوس, زنبق النيل (أي من النباتات المختلفة من جنس أغابانثوس ذات خيمات من الزهور الزرقاء إلى الأرجوانية المبهرجة)",
 "lily of the valley": "زنبق الوادي, كونفالاريا (نبات معمر منخفض النمو له عادة ورقتان كبيرتان مستطيلتان سنانيتان وعنقود من الزهور الصغيرة العطرة المتدلية على شكل جرس تليها توت قرمزي)",
 "lily pad": "ورقة زنبق الماء (أوراق عائمة لزنبق الماء)",
 "lily turf": "عشب الزنبق, ليلي تيرف (عشبة آسيوية معمرة متكتلة ذات أوراق دائمة الخضرة تشبه العشب وعناقيد من الزهور الأرجوانية الداكنة تشبه العنب؛ تزرع كغطاء أرضي)",
 "lily-livered": "رَعْدِيد, هَيَّاب (سَرِيع الخَوْف وسَهْل الإِفْزَاع)",
 "lily-of-the-valley tree": "أندروميدا يابانية, شجرة زنبق الوادي (شجيرة آسيوية دائمة الخضرة عريضة الأوراق ذات أوراق لامعة وعناقيد متدلية من الزهور البيضاء)",
 "lily-white": "أَبْيَض نَاصِع (بلون أبيض نقي صافٍ) / حَصْرِيٌّ لِلْبِيض (مقتصر على البيض فقط)",
 "lilyturf": "عشب الزنبق, ليلي تيرف (عشبة آسيوية معمرة متكتلة ذات أوراق دائمة الخضرة تشبه العشب وعناقيد من الزهور الأرجوانية الداكنة تشبه العنب؛ تزرع كغطاء أرضي)",
 "lima": "لِيمَا ((في علم اللسانيات) الشكل المعجمي القانوني للكلمات التي تتشارك في المعنى عينه…)",
 "lima bean": "فاصولياء ليما, فاصولياء هلالية (فاصولياء مسطحة وعريضة تطهى برفق؛ لا تؤكل نيئة أبداً) / فاصولياء ليمية (نبات فاصولياء شجيري أو طويل النمو له بذور مسطحة كبيرة صالحة للأكل) / فاصولياء الزبدة, فاصولياء سيفا (نبات فاصولياء شجيري يزرع خاصة في جنوب الولايات المتحدة له بذور مسطحة صغيرة صالحة للأكل)",
 "lima bean plant": "فاصولياء ليمية (نبات فاصولياء شجيري أو طويل النمو له بذور مسطحة كبيرة صالحة للأكل)",
 "limacine": "بزاقي (مكون من أو يشبه البزاق (الحلزون العريان))",
 "limacoid": "بزاقي (مكون من أو يشبه البزاق (الحلزون العريان))",
 "liman": "ليمان, مصب شاطئي (بحيرة شاطئية ضيقة طويلة بالقرب من مصب نهر)",
 "limanda ferruginea": "فلو ندر أصفر الذيل (سمكة مفلطحة أمريكية لها ذيل مائل للاصفرار)",
 "limb": "طَرَف, عُضْو",
 "limb-girdle muscular dystrophy": "حثل عضلي حزامي (شكل وراثي متنحي من الحثل العضلي يظهر في أي مكان من الطفولة المتأخرة إلى منتصف العمر؛ يتميز بضعف عضلي تدريجي يبدأ إما في حزام الكتف أو الحوض؛ يتقدم…)",
 "limbed": "ذو أطراف (لديه أو يبدو وكأن لديه أطرافاً، خاصة أطراف من نوع معين (تستخدم عادة في التركيبات))\nمثال: قوي الأطراف",
 "limber": "رَشِيق, لَدْن ((عَنْ أَجْسَادِ الأَشْخَاصِ) قَادِرٌ عَلَى الحَرَكَةِ أَوِ الِانْثِنَاءِ بِحُرِّيَّةٍ) / سَهْلُ الثَّنْي, لَيِّن ((عَنِ المَصْنُوعَاتِ) يُثْنَى بِسُهُولَةٍ) / سَلِس, طَيِّع ((عَنْ سِمَاتِ الشَّخْصِيَّةِ) سَرِيعُ التَّكَيُّفِ) / مقدمة العربة (مركبة بعجلتين تجرها الخيول تستخدم لسحب مدفع ميداني أو عربة ذخيرة)",
 "limber pine": "صنوبر مرن (صنوبر من غرب أمريكا الشمالية بإبر طويلة وأطراف مرنة جداً ولحاء رمادي داكن مخدد)",
 "limbers": "قناة تصريف السفينة, مجرى القاع (قناة أو ميزاب على جانبي رافدة السفينة لنقل مياه القاع إلى بئر المضخة)",
 "limbic": "حوفي, طرفي",
 "limbic brain": "جهاز حوفي (نظام من الهياكل العصبية المرتبطة وظيفياً في الدماغ والتي تشارك في السلوك العاطفي)",
 "limbic system": "جهاز حوفي (نظام من الهياكل العصبية المرتبطة وظيفياً في الدماغ والتي تشارك في السلوك العاطفي)",
 "limbless": "بلا أطراف (ليس لديه أطراف)\nمثال: الثعبان من الزواحف عديمة الأطراف",
 "limbo": "الليمبو ((اللاهوت) في الكاثوليكية الرومانية، مكان الأرواح غير المعمدة ولكن البريئة أو الصالحة (مثل الرضع والأفراد الفاضلين)) / إهمال, نسيان (مكان خيالي للأشياء المفقودة أو المهملة) / طي الكتمان, نسيان (حالة كونه مهملاً أو منسياً)",
 "limburger": "ليمبرغر (جبن أبيض طري ذو رائحة وطعم لاذع قوي جداً)",
 "limbus": "حَوْف (حد أو حافة لأجزاء مختلفة من الجسم تتميز باللون أو البنية)",
 "lime": "جِير (طلاه بالجير؛ جيَّر الحوض: قعَّره) / لَيْم, بَنْزَهِير\nمثال: طليت الحاىءط بالجير.",
 "lime disease spirochete": "بوريليا برغدورفيرية, ملتوية داء لايم (مسبب داء لايم؛ ينتقل بشكل أساسي عن طريق القراد من جنس اللبود)",
 "lime hydrate": "جير, هيدروكسيد الكالسيوم (مادة كاوية تنتج عن تسخين الحجر الجيري)",
 "lime juice": "عصير الليم الحامض (عصير ليم (ليمون أخضر) معصور طازجاً عادة)",
 "lime tree": "تليو, زيزفون (أي من الأشجار النفضية المختلفة من جنس الزيزفون ذات أوراق على شكل قلب وعناقيد سيمية متدلية من الزهور المصفرة غالباً ما تكون عطرة؛ ينتج العديد منها…) / ليم, ليمون حامض (أي من الأشجار المختلفة ذات الصلة التي تحمل الليم)",
 "limeade": "عصير الليمون الحامض, ليميد (مشروب محلى من عصير الليمون الحامض (اللايم) والماء)",
 "limekiln": "أتون الجير, قمينة الجير (قمينة تستخدم لاختزال الأشكال الطبيعية من كربونات الكالسيوم إلى جير)",
 "limelight": "ضوء الكلس (مصباح يتكون من لهب موجه إلى أسطوانة من الجير مع عدسة لتركيز الضوء؛ كان يستخدم سابقاً لإضاءة المسرح) / أضواء الشهرة, محط الأنظار (بؤرة اهتمام الجمهور)\nمثال: استمتع بكونه تحت الأضواء",
 "limen": "حد, عتبة (أصغر إحساس يمكن كشفه)",
 "limenitis archippus": "فراشة نائب الملك (فراشة أمريكية مبهرجة تشبه فراشة الملك ولكنها أصغر)",
 "limenitis arthemis": "فراشة الأميرال الأبيض الأمريكية (فراشة من أمريكا الشمالية بأجنحة زرقاء سوداء يقطعها شريط أبيض عريض)",
 "limenitis astyanax": "فراشة أرجوانية حمراء البقع (تشبه فراشة الأميرال الأبيض الأمريكية ولكن مع بقع حمراء على أسطح الأجنحة السفلية)",
 "limenitis camilla": "فراشة الأميرال الأبيض (فراشة أوراسية بأجنحة بنية وعلامات بيضاء)",
 "limerick": "لِيمِرِيك",
 "limestone": "حَجَر جِيرِيّ, حَجَر كِلْسِيّ (حَجَرَ عليه الأمرَ:مَنَعَه منه ، حجر الشّيء على نفسه:خَصَّها به وقصره عليها؛ الحجْرُ: المَنْعُ مِن التَّصَرُّفِ ، وحَجَرَ عَلَيْهِ القاضِي يَحْجُرُ حَجْراً، إِذا مَنَعَه مِن التَّصَرُّفِ فِي مالِه)\nمثال: عوقب زيري بالحجر.",
 "limestone fern": "سرخس البلوط الشمالي, سرخس الحجر الجيري (سرخس أصفر مخضر في المناطق الصخرية في نصف الكرة الشمالي)",
 "limestone salamander": "سمندل الحجر الجيري (يشبه سمندل شاستا؛ يعيش في شقوق المنحدرات والركام الصخري)",
 "limewater": "ماء الجير (محلول هيدروكسيد الكالسيوم في الماء يستخدم كمضاد للحموضة)",
 "limey": "إنجليزي (عامية) (رجل من أصل إنجليزي)",
 "limicoline bird": "طائر شاطئي (أي من طيور الخوض العديدة التي تتردد غالباً على شواطئ البحر ومصبات الأنهار)",
 "limit": "حَدّ (مُنْتَهى الشيءِ؛ الْفَصْلُ بَيْنَ الشَّيْئَيْنِ لِئَلَّا يَخْتَلِطَ أَحدهما بِالْآخَرِ أَو لِئَلَّا يَتَعَدَّى أَحدهما عَلَى الْآخَرِ) / نِهَايَة / حَدَّ, حَدَّدَ (مُنْتَهى الشيءِ؛ الْفَصْلُ بَيْنَ الشَّيْئَيْنِ لِئَلَّا يَخْتَلِطَ أَحدهما بِالْآخَرِ أَو لِئَلَّا يَتَعَدَّى أَحدهما عَلَى الْآخَرِ)\nمثال: أعرفها إلى حد ما.",
 "limit of liability": "حد المسؤولية (أقصى مبلغ يمكن أن تكون شركة التأمين مسؤولة عنه بموجب بوليصة التأمين)",
 "limit point": "حد رياضي, نهاية (القيمة الرياضية التي تتجه إليها الدالة عندما يقترب المتغير المستقل من اللانهاية)",
 "limitation": "تحديد, تقييد (فعل الحد أو التقييد (كما هو الحال عن طريق التنظيم)) / قصور, محدودية (صفة كون الشيء محدودًا أو مقيدًا) / تحديد, حصر (مبدأ يحد من مدى شيء ما) / حد, قيد (أكبر قدر ممكن أو مسموح به من شيء ما)\nمثال: إنها خطة جيدة لكن لها محدوديات خطيرة",
 "limited": "مَحْدُود",
 "limited audit": "تدقيق محدود (تدقيق محدود النطاق (محدود في الفترة الزمنية أو مقتصر على حسابات معينة، إلخ.))",
 "limited company": "شَرِكَة مَحْدُودَة",
 "limited edition": "طبعة محدودة (طبعة تقتصر على عدد محدد من النسخ)",
 "limited liability": "مسؤولية محدودة (مسؤولية أصحاب الشركة بما لا يتجاوز رأس المال الذي استثمروه فيها)",
 "limited liability company": "شَرِكَة ذَات مَسْؤُولِيَّة مَحْدُودَة",
 "limited review": "مراجعة, مراجعة محدودة ((محاسبة) خدمة (أقل شمولاً من التدقيق) توفر بعض التأكيد للأطراف المعنية حول موثوقية البيانات المالية)",
 "limited war": "حرب محدودة (حرب هدفها أقل من الهزيمة غير المشروطة للعدو)",
 "limitedly": "بشكل محدود, محدوداً (بطريقة محدودة)",
 "limitedness": "مَحْدُودِيَّة",
 "limiter": "قاص, محدد ((إلكترونيات) دائرة إلكترونية غير خطية يكون خرجها محدوداً في السعة؛ تستخدم للحد من السعة اللحظية لشكل الموجة (لقص قمم شكل الموجة))\nمثال: المحدد يسبب تشويهاً في السعة",
 "limiting": "حَاصِر, مُقَيِّد (يُقيِّد نطاق العمل أو حرية الحركة) / تَحْدِيدِيّ (يُقيِّد بدقّة مرجع الكلمة أو العبارة المُعدَّلة) / تَعْدِيل, تَقْيِيد (العلاقة النحوية التي توجد عندما تقوم كلمة بتقييد أو وصف معنى العبارة)",
 "limitless": "بِلَا حُدُود, لَامَحْدُود (يَبْدُو بِلَا حُدُودٍ فِي الكَمِّيَّةِ أَوِ العَدَدِ أَوِ الدَّرَجَةِ أَوِ المَدَى) / بلا حدود, غير محدود (ليس له حدود في المدى أو النطاق) / لَا حَدَّ لَه, لَا مَحْدُود (بلا حدود في المدى أو الحجم أو الكمية)\nمثال: البدء بنظرية الحرية غير المحدودة هو الانتهاء باستبداد غير محدود",
 "limitlessness": "لا محدودية, لا نهائية (صفة كون الشيء لا نهائياً؛ بلا حدود أو قيود)",
 "limner": "رسام بورتريه, مصور وجوه (رسام أو راسم للصور الشخصية (البورتريه))",
 "limnimeter": "مقياس منسوب البحيرة (مقياس مد وجزر يستخدم لقياس تغيرات مستوى البحيرة)",
 "limning": "تخطيط, رسم خطي (رسم لخطوط خارجية لأشكال أو أشياء)",
 "limnocryptes minima": "شنقب صغير (شنقب صغير قصير المنقار من العالم القديم)",
 "limnodium spongia": "لكمة الضفدع الأمريكية, ليمنوبيوم (نبات أمريكي بأوراق دائرية على شكل قلب أو كلية؛ يتجذر عادة في القيعان الطينية للبرك والخنادق)",
 "limnodromus griseus": "رمادية الظهر (طائر دويتشر ذو ظهر رمادي)",
 "limnodromus scolopaceus": "شنقب أحمر الصدر (طائر دويتشر ذو صدر أحمر)",
 "limnological": "ليمنولوجي, متعلق بعلم المياه العذبة (مكون من أو متعلق بعلم المسطحات المائية الداخلية (الليمنولوجيا))",
 "limnologically": "فيما يتعلق بعلم المياه العذبة (فيما يتعلق أو يختص بعلم البحيرات والمياه العذبة)",
 "limnologist": "عالم مياه عذبة (متخصص في دراسة البرك والبحيرات العذبة)",
 "limnology": "علم المسطحات المائية الداخلية (الدراسة العلمية للمسطحات المائية العذبة لخصائصها البيولوجية والفيزيائية والجيولوجية)",
 "limo": "سيارة فارهة, ليموزين (سيارة فاخرة كبيرة؛ عادة ما يقودها سائق خاص)",
 "limonene": "ليمونين (تيربين سائل ذو رائحة ليمون؛ يوجد في الليمون والبرتقال والزيوت العطرية الأخرى)",
 "limonite": "ليمونيت (خام أكسيد الحديد واسع الانتشار؛ خليط من الغوثيت والهيماتيت والليبدوكروشيت)",
 "limosa haemastica": "بقويقة هدسونية (بقويقة من العالم الجديد)",
 "limousin": "ليموزان",
 "limousine": "لِيمُوزِين",
 "limp": "عَرَجَ",
 "limpa": "ليمبا (خبز جاودار مصنوع مع الدبس أو السكر البني)",
 "limper": "أعرج (شخص يعرج ويمشي مشية متعثرة)",
 "limpet": "بطلينوس (أي من بطنيات القدم البحرية المختلفة عادة بأصداف مخروطية منخفضة؛ توجد ملتصقة بالصخور في المناطق الساحلية) / بطلينوس صدفي, ليمبيت (رخويات ذات صدفة مخروطية منخفضة)",
 "limpid": "قَرَاح",
 "limpidity": "شَفَّافِيَّة تَامَّة, صَفَاء (مرور الضوء دون تشتت أو تشويه) / جَلَاء, صَفَاء (الخلو من الغموض وسهولة الفهم؛ قابلية التعبير الواضح للفهم)",
 "limpidly": "بجلاء, بوضوح (بطريقة واضحة وجلية)\nمثال: هذا كتاب مكتوب بوضوح",
 "limping": "عرج (إعاقة في المشي بسبب عجز في الساقين أو القدمين)",
 "limping iamb": "إيامب أعرج (بيت إيامبي تكون فيه التفعيلة الأخيرة سبوندي أو تروكي بدلاً من إيامبوس)",
 "limpkin": "ليمبكين (طائر خوض من فلوريدا وكوبا وجامايكا له منقار متدلي ونداء عويل مميز)",
 "limply": "بترهل, برخاوة (بدون صلابة)\nمثال: كانت الجثة تتدلى برخاوة من الشجرة",
 "limpness": "ترهل, رخاوة (ليونة مترهلة)",
 "limulus polyphemus": "سرطان حدوة الحصان, سلطعون حدوة الحصان (مفصلي بحري كبير من ساحل المحيط الأطلسي لأمريكا الشمالية له درقة مقببة تشبه حدوة الحصان وذيل مدبب صلب)",
 "linac": "معجل خطي (يتم تسريع الأيونات على طول مسار خطي بواسطة فروق الجهد على الأقطاب الكهربائية على طول المسار)",
 "linage": "أجرة الكتابة, سعر السطر (معدل الدفع للمواد المكتوبة التي تقاس وفقاً لعدد الأسطر المقدمة) / عَدَد الأَسْطُر (عدد الأسطر في مادة مطبوعة)",
 "linalool": "لينالول (سائل عطري عديم اللون يوجد في العديد من الزيوت العطرية)",
 "linanthus dianthiflorus": "لينانثوس (عشب متفرع بساق سلكية منخفض من جنوب كاليفورنيا له زهور وردية مهدبة)",
 "linanthus dichotomus": "ثلج المساء (نبات حولي صغير في كاليفورنيا بزهور بيضاء)",
 "linaria canadensis": "كتانية زرقاء (نبات من أمريكا الشمالية له عناقيد من الزهور الزرقاء البنفسجية)",
 "linaria vulgaris": "كتان العلجوم, كتانية شائعة (نبات معمر أوروبي شائع ذو زهور صفراء وبرتقالية مبهرجة؛ عشبة ضارة متوطنة في أمريكا الشمالية)",
 "linchpin": "مسمار المحور (مسمار يتم إدخاله عبر محور العجلة لتثبيت العجلة) / دعامة أساسية, ركيزة (مصدر دعم واستقرار مركزي ومتماسك)\nمثال: الإيمان هو ركيزته",
 "lincocin": "لينكوسين, لينكوميسين (مضاد حيوي (الاسم التجاري لينكوسين) يتم الحصول عليه من بكتيريا ستريبتوميسيس ويستخدم في علاج بعض الالتهابات المقاومة للبنسلين)",
 "lincoln": "لِنْكِن",
 "lincoln's birthday": "12 فبراير, عيد ميلاد لينكولن (اليوم الذي يتم فيه تذكر الرئيس أبراهام لينكولن)",
 "lincolnesque": "لنكولني (من أو يتعلق بأبراهام لنكولن أو على طريقته)",
 "lincolnian": "لنكولني (من أو يتعلق بأبراهام لنكولن أو على طريقته)",
 "lincomycin": "لينكوسين, لينكوميسين (مضاد حيوي (الاسم التجاري لينكوسين) يتم الحصول عليه من بكتيريا ستريبتوميسيس ويستخدم في علاج بعض الالتهابات المقاومة للبنسلين)",
 "lindane": "ليندان (مسحوق بلوري أبيض يستخدم كمبيد حشري زراعي)",
 "linden": "زَيْزَفُون",
 "linden tree": "تليو, زيزفون (أي من الأشجار النفضية المختلفة من جنس الزيزفون ذات أوراق على شكل قلب وعناقيد سيمية متدلية من الزهور المصفرة غالباً ما تكون عطرة؛ ينتج العديد منها…)",
 "lindera benzoin": "شجيرة البنزوين, شجيرة التوابل (شجيرة نفضية في شرق الولايات المتحدة ذات أوراق ولحاء عطري للغاية وأزهار صفراء تليها توت قرمزي أو أصفر)",
 "lindheimera texana": "نجمة تكساس (نبات حولي من تكساس بأوراق ريشية خشنة؛ يُزرع لرؤوس أزهاره الصفراء الشعاعية المبهرجة)",
 "lindy": "ليندي, ليندي هوب (رقصة أمريكية نشيطة كانت شائعة في الثلاثينيات (سميت ربما تيمناً بالطيار تشارلز ليندبرغ))",
 "lindy hop": "ليندي, ليندي هوب (رقصة أمريكية نشيطة كانت شائعة في الثلاثينيات (سميت ربما تيمناً بالطيار تشارلز ليندبرغ))",
 "line": "خَطّ (كِتَابَة؛ ما يَصِل نقطتين أو أكثر)\nمثال: إرسم خط مستقيم.",
 "line backer": "ظهير خطي, لاين باكر ((كرة قدم أمريكية) مركز لاعب كرة قدم دفاعي يلعب قريباً خلف خط الاشتباك) / ظهير خط الدفاع (لاعب دفاع في كرة القدم الأمريكية يتخذ موقعاً قريباً خلف لاعبي الخط)",
 "line block": "قالب خطي (نقش يتكون من كتلة تم حفرها أو نقشها)",
 "line coach": "مدرب الخط (مساعد مدرب كرة قدم مسؤول عن لاعبي الخط)",
 "line double": "ضربة ثنائية مستقيمة (ضربة ثنائية ناتجة عن تسديدة قوية ومستقيمة)",
 "line drawing": "تخطيط, رسم خطي (رسم لخطوط خارجية لأشكال أو أشياء)",
 "line drive": "ضربة خطية, لاين درايف ((بيسبول) ضربة تطير بشكل مستقيم من الضارب)\nمثال: ضرب الضارب كرة خطية إلى الشورت ستوب",
 "line engraving": "قالب خطي (نقش يتكون من كتلة تم حفرها أو نقشها) / حفر خطي (مطبوعة تم الحصول عليها من رسم خطي)",
 "line feed": "تغذية السطر (العملية التي تمهد لطباعة أو عرض الحرف التالي في السطر التالي)",
 "line item": "بند الميزانية (بند في مشروع قانون الاعتمادات المالية)",
 "line judge": "حكم الخط (حكم كرة قدم يساعد الحكم الرئيسي من خلال تتبع الوقت الرسمي خلال المباراة)",
 "line management": "إدارة الخط الأول, إدارة تنفيذية (إدارة الأنشطة التي تساهم مباشرة في ناتج المنظمة)",
 "line of battle": "خط القتال (خط تشكله القوات أو السفن المستعدة لشن هجوم أو تلقيه)",
 "line of business": "مجال, ميدان عمل (نوع معين من المؤسسات التجارية) / تشكيلة منتجات, خط إنتاج (نوع معين من المنتجات أو البضائع)\nمثال: هم متميزون في مجالهم",
 "line of contact": "خَطّ اِتِّصَال, خَطّ الْاِتِّصَال (كِتَابَة؛ ما يَصِل نقطتين أو أكثر)\nمثال: إرسم خط مستقيم.",
 "line of credit": "حد ائتماني, خط ائتمان (الحد الأقصى للائتمان المسموح به للعميل)",
 "line of defence": "خط دفاع (هيكل دفاعي يتكون من حاجز يمكن استخدامه للدفاع ضد الهجوم) / خط دفاع (أي منظمة تكون مسؤوليتها الدفاع ضد شيء ما)\nمثال: الشرطة هي خط الدفاع الرئيسي ضد الجريمة",
 "line of defense": "خط دفاع (هيكل دفاعي يتكون من حاجز يمكن استخدامه للدفاع ضد الهجوم) / خط دفاع (أي منظمة تكون مسؤوليتها الدفاع ضد شيء ما)\nمثال: الشرطة هي خط الدفاع الرئيسي ضد الجريمة",
 "line of descent": "أصل, سلالة (الاشتقاق الوراثي للفرد) / سُلَالَة, نَسَب (علاقة القرابة بين الفرد وأسلافه)\nمثال: كل سلالته كانت محاربين",
 "line of destiny": "خط القدر, خط المصير (تجعد في راحة اليد؛ يقال في قراءة الكف أنه يشير إلى مدى النجاح)",
 "line of duty": "نطاق الواجب (كل ما هو مطلوب عادة في مجال ما من المسؤولية)",
 "line of fate": "خط القدر, خط المصير (تجعد في راحة اليد؛ يقال في قراءة الكف أنه يشير إلى مدى النجاح)",
 "line of fire": "خط النار (مسار قذيفة تطلق من سلاح ناري)",
 "line of flight": "خط الطيران (المسار الذي يسلكه جسم يتحرك بحرية عبر الهواء)",
 "line of force": "خط القوة, خط المجال (خط وهمي في مجال القوة؛ اتجاه الخط في أي نقطة هو اتجاه القوة عند تلك النقطة)",
 "line of gab": "حديث منمق, كلام معسول (كلام سلس ومقنع (مفيد خاصة للبائع))",
 "line of heart": "خط الحب, خط القلب (تجعد في راحة اليد؛ يقال في قراءة الكف أنه يشير إلى الطبيعة العاطفية)",
 "line of inquiry": "خط استجواب, مسار تحقيق (ترتيب للأسئلة لتطوير حجة معينة)",
 "line of latitude": "خط عرض, دائرة العرض (خط وهمي حول الأرض موازٍ لخط الاستواء)",
 "line of least resistance": "المسار الأسهل, خط المقاومة الأقل (الطريقة الأسهل)\nمثال: بزواجها منه، اختارت ببساطة مسار المقاومة الأقل",
 "line of life": "خط الحياة (تجعد في راحة اليد؛ يقال في قراءة الكف أنه يشير إلى طول العمر)",
 "line of longitude": "خط الزوال, خط الطول (دائرة عظمى وهمية على سطح الأرض تمر عبر القطبين الشمالي والجنوبي بزوايا قائمة مع خط الاستواء)\nمثال: جميع النقاط على نفس خط الزوال لها نفس خط الطول",
 "line of march": "خط السير (ترتيب الناس في خط للمسير) / خط المسير (الطريق الذي يتقدم عليه طابور عسكري)",
 "line of merchandise": "تشكيلة منتجات, خط إنتاج (نوع معين من المنتجات أو البضائع)\nمثال: تشكيلة جميلة من الأحذية",
 "line of poetry": "بيت شعر, شطر (سطر واحد من الكلمات في قصيدة)",
 "line of products": "تشكيلة منتجات, خط إنتاج (نوع معين من المنتجات أو البضائع)\nمثال: تشكيلة جميلة من الأحذية",
 "line of questioning": "خط استجواب, مسار تحقيق (ترتيب للأسئلة لتطوير حجة معينة)",
 "line of reasoning": "حجة منطقية, مجادلة (مسار من الاستدلال يهدف إلى إثبات حقيقة أو زيف؛ العملية المنهجية للتفكير المنطقي)\nمثال: لا أستطيع متابعة مسار استدلالك",
 "line of saturn": "خط القدر, خط المصير (تجعد في راحة اليد؛ يقال في قراءة الكف أنه يشير إلى مدى النجاح)",
 "line of scrimmage": "خط الاشتباك (خط مواز لخطوط المرمى حيث يصطف لاعبو كرة القدم الأمريكية في بداية كل لعبة)\nمثال: تمت عرقلة العداء عند خط الاشتباك",
 "line of sight": "خط البصر, خط الرؤية (خط مستقيم وهمي ينظر عبره المراقب)",
 "line of succession": "خط الخلافة (الترتيب الذي يتوقع أن يخلف فيه الأفراد بعضهم البعض في منصب رسمي)",
 "line of thought": "خط فكري, نمط تفكير (طريقة معينة للتفكير تميز فرداً أو مجموعة)",
 "line of verse": "بيت شعر, شطر (سطر واحد من الكلمات في قصيدة)",
 "line of vision": "خط البصر, خط الرؤية (خط مستقيم وهمي ينظر عبره المراقب)",
 "line of work": "حرفة, عمل (النشاط الرئيسي في حياتك الذي تقوم به لكسب المال)\nمثال: هو لا يعمل في مجال عملي",
 "line officer": "ضابط خط (ضابط مفوض مع وحدات قتالية (وليس ضابط أركان أو ضابط إمداد))",
 "line organisation": "تنظيم تنفيذي, تنظيم خطي (الهيكل التنظيمي للأنشطة التي تساهم بشكل مباشر في مخرجات المنظمة)",
 "line organization": "تنظيم تنفيذي, تنظيم خطي (الهيكل التنظيمي للأنشطة التي تساهم بشكل مباشر في مخرجات المنظمة)",
 "line personnel": "موظفو الخطوط الأمامية, موظفون تنفيذيون (الموظفون الذين لديهم مسؤوليات مباشرة عن أداء العمل)",
 "line printer": "طابعة سطرية (طابعة تعمل كجهاز إخراج على الحاسوب؛ تطبع سطراً كاملاً من الأحرف في وقت واحد)",
 "line roulette": "روليت, منحنى التدحرج (خط يتولد عن نقطة على شكل يتدحرج حول شكل ثانٍ)",
 "line score": "جدول النتائج, سجل النقاط (ملخص لتسجيل النقاط في لعبة ما (عادة في شكل جدول))",
 "line single": "ضربة أحادية مستقيمة (ضربة أحادية ناتجة عن تسديدة قوية ومستقيمة)",
 "line spectrum": "طيف خطي (طيف تتركز فيه الطاقة عند أطوال موجية معينة؛ ينتج عن الذرات والأيونات المثارة عند عودتها إلى مستوى طاقة أقل)",
 "line squall": "خط العواصف (عاصفة تتقدم على طول جبهة تشكل خطاً محدداً)",
 "line storm": "عاصفة الاعتدال (عاصفة مطرية عنيفة قرب وقت الاعتدال (الربيعي أو الخريفي))",
 "line surveyor": "مساح خطي (مساح يحدد المواقع باستخدام عمود القياس)",
 "line triple": "ضربة ثلاثية مستقيمة (ضربة ثلاثية ناتجة عن تسديدة قوية ومستقيمة)",
 "line worker": "عامل خط إنتاج (موظف يعمل في خط تجميع)",
 "line-at-a-time printer": "طابعة سطرية (طابعة تعمل كجهاز إخراج على الحاسوب؛ تطبع سطراً كاملاً من الأحرف في وقت واحد)",
 "line-drive double": "ضربة ثنائية مستقيمة (ضربة ثنائية ناتجة عن تسديدة قوية ومستقيمة)",
 "line-drive single": "ضربة أحادية مستقيمة (ضربة أحادية ناتجة عن تسديدة قوية ومستقيمة)",
 "line-drive triple": "ضربة ثلاثية مستقيمة (ضربة ثلاثية ناتجة عن تسديدة قوية ومستقيمة)",
 "line-shooter": "متباهٍ, متفاخر (شخص كثير التفاخر والحديث عن نفسه)",
 "line-shooting": "تبجح, تفاخر (حالة من الحديث المتباهي)\nمثال: تبجحه أسوأ من قتاله",
 "lineage": "أصل, سلالة (الخصائص الموروثة المشتركة مع الآخرين من نفس سلالة الدم) / أصل, سلالة (الاشتقاق الوراثي للفرد) / أجرة الكتابة, سعر السطر (معدل الدفع للمواد المكتوبة التي تقاس وفقاً لعدد الأسطر المقدمة) / عَدَد الأَسْطُر (عدد الأسطر في مادة مطبوعة)\nمثال: كل سلالته كانت محاربين",
 "lineal": "خَطِّيّ, مُصْطَفّ (مُرتَّب في خط واحد) / خطي, صلبي (في خط نسب مباشر غير منقطع من الوالد إلى الطفل)\nمثال: أسلاف مباشرون",
 "lineally": "تسلسلياً, عبر النسب المباشر (بخط نسب غير منقطع)\nمثال: إنها ترتبط تسلسلياً بالعائلة المالكة",
 "lineament": "تقاسيم الوجه, ملامح (الأجزاء المميزة لوجه الشخص: العيون والأنف والفم والذقن) / صفة, طابع (خاصية مميزة تحدد الطبيعة الفردية الظاهرة لشيء ما)\nمثال: ظهر تعبير عن السرور على ملامحه",
 "linear": "تَنَاظُرِيّ, خَطِّيّ (لدائرة أو جهاز له مخرج يتناسب مع المدخل) / أحادي البعد, خطي (من أو في أو على طول أو يتعلق بخط؛ ينطوي على أو له بعد واحد) / خطي (يصف أو يتضمن معادلة تكون حدودها من الدرجة الأولى) / خَطِّيّ, طُولِيّ (يُقاس في اتِّجاه الطُّول)\nمثال: جهاز تناظري",
 "linear accelerator": "معجل خطي (يتم تسريع الأيونات على طول مسار خطي بواسطة فروق الجهد على الأقطاب الكهربائية على طول المسار)",
 "linear algebra": "جبر خطي (جزء الجبر الذي يتعامل مع نظرية المعادلات الخطية والتحويل الخطي)",
 "linear equation": "معادلة خطية (معادلة متعددة الحدود من الدرجة الأولى)",
 "linear function": "دَالَّة خَطِّيَّة (دالة رياضية يكون رسمها البياني (في الإحداثيات الديكارتية بمقاييس موحدة) خطاً مستوياً)",
 "linear leaf": "ورقة خطية (ورقة نحيلة طويلة)",
 "linear measure": "مقياس طولي, وحدة خطية (وحدة لقياس الطول)",
 "linear meter": "متر طولي (متر يكون فيه انحراف المؤشر متناسباً مع الكمية المقاسة)\nمثال: نحتاج إلى 15 متراً طولياً من هذا السياج",
 "linear metre": "متر طولي (متر يكون فيه انحراف المؤشر متناسباً مع الكمية المقاسة)\nمثال: نحتاج إلى 15 متراً طولياً من هذا السياج",
 "linear operator": "مُؤَثِّر خَطِّيّ (مؤثر يطيع قانون التوزيع)",
 "linear perspective": "منظور, منظور خطي (مظهر الأشياء بالنسبة لبعضها البعض كما يحدده بعدها عن المشاهد)",
 "linear programming": "برمجة خطية (تقنية رياضية تستخدم في الاقتصاد؛ تجد الحد الأقصى أو الأدنى للدوال الخطية في العديد من المتغيرات الخاضعة لقيود)",
 "linear regression": "انحدار خطي (العلاقة بين المتغيرات عندما تكون معادلة الانحدار خطية)",
 "linear unit": "مقياس طولي, وحدة خطية (وحدة لقياس الطول)",
 "linear-quadratic-gaussian controller": "وحدة تحكم خطية تربيعية غاوسية (وحدة تحكم تمثل مزيجاً من مرشح كالمان (مقدر خطي تربيعي) مع منظم خطي تربيعي)\nمثال: وحدة التحكم الخطية التربيعية الغاوسية نفسها هي نظام ديناميكي مثل النظام الذي تتحكم فيه",
 "linearity": "أحادية البعد, خطية (خاصية امتلاك بعد واحد)",
 "linearly": "خطياً (بطريقة خطية)\nمثال: إشعاع مستقطب خطياً",
 "lineation": "تخطيط (فعل التحديد أو التخطيط بخطوط) / محيط, مخطط خارجي (الخط الذي يبدو أنه يحد جسمًا ما)",
 "linebacker": "ظهير خطي, لاين باكر ((كرة قدم أمريكية) مركز لاعب كرة قدم دفاعي يلعب قريباً خلف خط الاشتباك) / ظهير خط الدفاع (لاعب دفاع في كرة القدم الأمريكية يتخذ موقعاً قريباً خلف لاعبي الخط)",
 "linebacker blitzing": "بليتز, هجوم خاطف ((كرة القدم الأمريكية) محاولة اللاعبين المدافعين اختراق الخط الهجومي)",
 "linecut": "قالب خطي (نقش يتكون من كتلة تم حفرها أو نقشها) / حفر خطي (مطبوعة تم الحصول عليها من رسم خطي)",
 "lined": "مُحَاط بِصَفّ (محدود بصف من الأشياء على جانبيه) / مبطن (يحتوي على بطانة؛ غالباً ما تستخدم في التركيبات) / مُجَعَّد, مُخَطَّط (ذو خطوط أو تجاعيد على السطح)\nمثال: تنورة مبطنة",
 "lined snake": "ثعبان مخطط (ثعبان كتوم يعيش في مكبات المدن والحدائق وكذلك البراري والغابات المفتوحة؛ يتغذى على ديدان الأرض؛ من وسط الولايات المتحدة)",
 "linelike": "شَبِيهٌ بِالخَطِّ (يشبه الخط في شكله)",
 "lineman": "لاعب خط, لاين مان ((كرة قدم أمريكية) مركز لاعب في فريق كرة القدم يتمركز على خط الاشتباك) / لاعب خط (أحد اللاعبين على خط الاشتباك) / عامل خطوط (شخص ذكر يقوم بتركيب أو إصلاح الخطوط الكهربائية أو الهاتفية) / عامل خطوط, مساح (مساح ذكر يحدد المواقع بعمود المدى)",
 "linemen": "لاعبو الخط (لاعبو كرة القدم الذين يصطفون على خط المشاجرة)",
 "linen": "كَتَّان",
 "linen paper": "ورق كتاني (ورق عالي الجودة مصنوع من ألياف الكتان أو بلمسة نهائية كتانية)",
 "linendraper": "تاجر بياضات (تاجر تجزئة في المنسوجات والأقمشة)",
 "liner": "ضربة خطية, لاين درايف ((بيسبول) ضربة تطير بشكل مستقيم من الضارب) / باخرة ركاب, سفينة رحلات (سفينة تجارية كبيرة (خاصة تلك التي تنقل الركاب وفق جدول منتظم)) / بطانة (قطعة قماش تستخدم كسطح داخلي للثوب) / بطانة (غطاء واقٍ يحمي سطحاً داخلياً)\nمثال: ضرب الضارب كرة خطية إلى الشورت ستوب",
 "liner train": "قطار شحن سريع (قطار شحن سريع للمسافات الطويلة بين المراكز الصناعية والموانئ البحرية مجهز بمرافق للتحميل والتفريغ السريع للبضائع)",
 "lines umpire": "حكم مساعد, مراقب الخط (حكم (في التنس، كرة القدم، إلخ) يساعد الحكم الرئيسي بطريقة ما (خاصة بمراقبة خروج الكرة أو التسلل))",
 "linesman": "حَكَمٌ مُسَاعِد, حَكَمُ رَايَة (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ)\nمثال: حكم علي بالموت.",
 "lineswoman": "عاملة خطوط (شخص أنثى تقوم بتركيب أو إصلاح الخطوط الكهربائية أو الهاتفية) / مراقبة الخط (مسؤولة أنثى (في التنس، كرة القدم، إلخ) تساعد الحكم بطريقة ما (خاصة بمراقبة خروج الكرة أو التسلل))",
 "lineup": "تَشْكِيلَة",
 "linewoman": "عاملة خطوط (شخص أنثى تقوم بتركيب أو إصلاح الخطوط الكهربائية أو الهاتفية) / عاملة خطوط, مساحة (مساحة أنثى تحدد المواقع بعمود المدى)",
 "ling": "بربوط (قد مياه عذبة ممدود في شمال أوروبا وآسيا وأمريكا الشمالية له زوائد حول فمه) / لينغ (نازلي أمريكي) / لينغ (سمكة غذائية بحرية ممدودة تعيش في جرينلاند وشمال أوروبا؛ غالباً ما تُملح وتجفف) / خلنج, كالونا (خلنج العالم القديم الشائع ممثل بالعديد من الأصناف؛ دائم الخضرة منخفض ينمو على نطاق واسع في نصف الكرة الشمالي)",
 "ling ko": "لينغ, لينغ كو (كستناء ماء ثمرتها الشائكة لها شوكتان بدلاً من 4)",
 "lingam": "لينغام (الرمز القضيبي الهندوسي للإله شيفا)",
 "lingberry": "توت البقر, توت الجبل الأحمر (شجيرة منخفضة دائمة الخضرة من المناطق المعتدلة الشمالية العالية في أوروبا وآسيا وأمريكا تحمل توتاً أحمر صالحاً للأكل)",
 "lingcod": "لينغ كود (سمكة غذائية في شمال المحيط الهادئ مرتبطة بأسماك الجرينلينغ) / لينج كود (اللحم قليل الدهن لسمكة يتم اصطيدها قبالة ساحل المحيط الهادئ للولايات المتحدة)",
 "lingenberry": "توت البقر, توت الجبل الأحمر (شجيرة منخفضة دائمة الخضرة من المناطق المعتدلة الشمالية العالية في أوروبا وآسيا وأمريكا تحمل توتاً أحمر صالحاً للأكل)",
 "lingerer": "متسكع (شخص يبقى بلا هدف في مكان ما أو حوله)",
 "lingerie": "مَلَابِس اَلنِّسَاء اَلتَّحْتِيَّة",
 "lingering": "تريث, تلكؤ (فعل التريث أو البقاء لفترة أطول)",
 "lingeringly": "بتباطؤ, بتريث (بطريقة بطيئة أو متمهلة أو مطولة)\nمثال: كان صوتها سريعاً، ومع ذلك سقطت الكلمات الأخيرة بتباطؤ",
 "lingo": "رطانة, عامية خاصة (لغة مميزة لمجموعة معينة (كما بين اللصوص))\nمثال: هم لا يتحدثون لغتنا",
 "lingonberry": "عنب الثور (توت أحمر لاذع يشبه التوت البري الأمريكي ولكنه أصغر) / توت البقر, توت الجبل الأحمر (شجيرة منخفضة دائمة الخضرة من المناطق المعتدلة الشمالية العالية في أوروبا وآسيا وأمريكا تحمل توتاً أحمر صالحاً للأكل)",
 "lingua": "لسان (كتلة متحركة من الأنسجة العضلية مغطاة بغشاء مخاطي وتقع في التجويف الفموي)",
 "lingua franca": "لُغَة تَوَاصُل مُشْتَرَك (هِيَ مجموعة من الأصوات التي يصدرها الإنسان على شكل كلمات منظمة بقواعد، ليتواصل به الناس وينقلون به الافكار والمعاني، اللسان؛ يقصد بها أحيانا اللهجة)\nمثال: الأمازيغية لغة.",
 "lingua franca nova": "لينجوا فرانكا نوفا",
 "lingual": "لِسَانِيّ",
 "lingual artery": "شريان لساني (شريان ينشأ من الشريان السباتي الظاهر ويغذي الجانب السفلي من اللسان)",
 "lingual vein": "وريد لساني (وريد يتلقى الدم من اللسان وقاع الفم ويصب في الوريد الوداجي الباطن أو الوريد الوجهي)",
 "lingually": "لغوياً (فيما يتعلق باللغة)\nمثال: أطفال يعانون من ضعف لغوي",
 "lingualumina": "لينغوالومينا (لغة مصطنعة، تُعرف أيضاً باسم لغة الضوء)",
 "linguica": "لينجويكا (سجق خنزير برتغالي متبل بشدة بنكهة الثوم والبصل)",
 "linguicism": "تمييز لغوي",
 "linguine": "لِنْقْوِينِي",
 "linguini": "لينغويني (مكرونة في شرائح مسطحة رفيعة طويلة)",
 "linguist": "لُغَوِيّ / عَالِم لُغَوِيّ (الذي يعلم؛ متخصص في عِلْم ما وباحث فيه) / لِسَانِيّ\nمثال: هو عالم أحيائي.",
 "linguistic": "لُغَوِيّ, لِسَانِيّ",
 "linguistic atlas": "أطلس لغوي (أطلس يوضح توزيع الميزات اللغوية المميزة)",
 "linguistic communication": "تَوَاصُل لُغَوِيّ, لُغَة (نظام منهجيّ للتواصل باستخدام الأصوات أو الرموز الاصطلاحيّة)",
 "linguistic competence": "كفاءة لغوية ((في اللغويات) المعرفة الضمنية للقواعد اللغوية لدى المتحدث)",
 "linguistic context": "سياق, سياق لغوي (الخطاب الذي يحيط بوحدة لغوية ويساعد في تحديد تفسيرها)",
 "linguistic geography": "جغرافيا اللهجات, جغرافيا لغوية (دراسة التوزيع الجغرافي للسمات اللغوية)",
 "linguistic performance": "أداء لغوي ((لغويات) الاستخدام الفعلي للغة من قبل المتحدث في مواقف حقيقية)",
 "linguistic process": "عملية لغوية, لغة (العمليات المعرفية المتضمنة في إنتاج وفهم التواصل اللغوي) / عملية لغوية (عملية تشارك في اللغة البشرية)\nمثال: لم يكن يمتلك اللغة للتعبير عن مشاعره",
 "linguistic profiling": "تنميط لغوي (استخدام خصائص الكلام أو اللهجة لتحديد عرق المتحدث أو دينه أو طبقته الاجتماعية)",
 "linguistic relation": "عَلَاقَة لُغَوِيَّة (علاقة بين الأشكال اللغوية أو المكونات)",
 "linguistic rule": "قاعدة, قاعدة لغوية ((في اللسانيات) قاعدة تصف (أو تحدد) ممارسة لغوية)",
 "linguistic scientist": "عالم لغويات, لغوي (متخصص في اللغويات)",
 "linguistic string": "سلسلة كلمات, سلسلة لغوية (تسلسل خطي للكلمات كما هي منطوقة أو مكتوبة)",
 "linguistic unit": "وحدة لغوية (واحدة من الوحدات الطبيعية التي يمكن تحليل الرسائل اللغوية إليها)",
 "linguistic universal": "سمة لغوية عالمية, كلي لغوي ((في اللسانيات) قاعدة نحوية (أو سمة لغوية أخرى) موجودة في جميع اللغات)",
 "linguistically": "لغوياً (فيما يتعلق باللغة) / لسانياً, لغوياً (فيما يتعلق بعلم اللسانيات)\nمثال: أطفال يعانون من ضعف لغوي",
 "linguistics": "لِسَانِيَّات, عِلْم اللُّغَة",
 "linguistics department": "قسم الألسن, قسم اللغويات (القسم الأكاديمي المسؤول عن التدريس والبحث في اللغويات)",
 "lingulate": "لِسَانِيُّ الشَّكْلِ (ذو شكل يشبه اللسان)",
 "lingvo kosmopolita": "لينغفو كوزموبوليتا (لغة مصطنعة أنشأها رينيه دي سوسور)",
 "liniment": "دَلُوك",
