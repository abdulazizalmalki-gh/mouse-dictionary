 "lochia": "سائل النفاس, هُلاب (مادة تفرز من المهبل (حطام خلوي ومخاط ودم) وتتناقص تدريجياً في الكمية خلال الأسابيع التالية للولادة)",
 "lock": "قُفْل (أَغْلَقَ أو سَدَّ البابَ أو الشَّيْءَ؛ في بعض السياقات: عادَ أو رجَعَ إلى مكانه أو بدايته) / هَوِّيس / أَقْفَلَ / ذُؤَابَة\nمثال: يحاول توم كسر القفل.",
 "lock chamber": "غرفة الهويس, هويس (حوض مغلق يتكون من جزء من قناة يمكن إغلاقه للتحكم في مستوى المياه؛ يستخدم لرفع أو خفض السفن التي تمر عبره)",
 "lock ring": "حلقة القفل, وردة زنبركية (وردة تمنع الصمولة من الارتخاء)",
 "lock washer": "حلقة القفل, وردة زنبركية (وردة تمنع الصمولة من الارتخاء)",
 "lock-gate": "بوابة هويس (بوابة يمكن قفلها)",
 "lock-up option": "خيار الإغلاق, خيار الحجز (خيار لشراء الأصول القيمة المعروضة على منقذ (فارس أبيض) من أجل إحباط عملية استحواذ عدائية)",
 "lockage": "مرور عبر الهويس (المرور عبر هويس في قناة أو ممر مائي) / نظام الأهوسة (نظام من الأهوسة في قناة أو مجرى مائي) / رسوم الهويس (رسم يُفرض للمرور عبر هويس في قناة أو ممر مائي)",
 "lockbox": "صندوق ودائع آمن (صندوق معدني مقاوم للحريق (عادة في البنك) لتخزين الأشياء الثمينة)",
 "lockdown": "إغْلَاق",
 "locked": "مُقْفَل",
 "locker": "خزانة, دولاب (مقصورة تخزين للملابس والأشياء الثمينة؛ عادة ما يكون لها قفل) / صندوق الجندي, صندوق قدم السرير (صندوق لتخزين الممتلكات الشخصية؛ يوضع عادة عند قدم السرير (كما في الثكنات)) / قفل (أداة تثبيت تقفل أو تغلق)",
 "locker room": "غرفة الخزائن, غرفة تبديل الملابس (غرفة (كما في منشأة رياضية أو مكان عمل) يمكنك فيها تغيير الملابس وتحتوي على خزائن للتخزين المؤقت لملابسك وممتلكاتك الشخصية)",
 "locker-room": "خاص بغرفة تغيير الملابس (متعلق بـ أو مناسب لغرفة تغيير الملابس (تستخدم غالباً لوصف أحاديث الرجال))\nمثال: دعابة غرف تغيير الملابس",
 "locket": "دلاية, ميدالية (علبة زينة صغيرة؛ تحتوي عادة على صورة أو خصلة شعر وتلبس في قلادة)",
 "locking": "إقفال, إيصاد (فعل قفل شيء ما لحمايته)",
 "locking pliers": "زرادية قفل, كلابة قفل (زرادية يمكن قفلها في مكانها)",
 "lockjaw": "تيتانوس, كزاز (عدوى بكتيرية حادة وخطيرة تصيب الجهاز العصبي المركزي وتدخل عبر الجروح المفتوحة؛ قد تحدث تشنجات في الفك وعضلات الحنجرة في المراحل المتأخرة)",
 "lockkeeper": "حارس الهويس (عامل مسؤول عن الهويس (على قناة مائية))",
 "lockman": "عامل هويس (عامل ذكر مسؤول عن هويس (في قناة مائية))",
 "lockmaster": "حارس الهويس (عامل مسؤول عن الهويس (على قناة مائية))",
 "locknut": "صامولة تأمين, صامولة زنق (صامولة إضافية يتم تثبيتها فوق صامولة أساسية لمنعها من الارتخاء)",
 "lockout": "إغلاق (إجراء إداري لمقاومة مطالب الموظفين؛ بمنعهم من دخول مكان العمل حتى يوافقوا على الشروط)",
 "lockring": "حلقة القفل, وردة زنبركية (وردة تمنع الصمولة من الارتخاء)",
 "locksmith": "قَفَّال, قَفَّالَة",
 "lockstep": "خطوات متزامنة, سير متلاصق (طريقة للسير في طابور تتحرك فيها ساق كل شخص مع الساق المقابلة للشخص الذي أمامه وخلفها) / جمود, روتين جامد (إجراء قياسي يتم اتباعه دون تفكير)\nمثال: كانت كواحل السجين مقيدة بسلاسل لدرجة أنهم لم يتمكنوا إلا من السير بخطوات متلاصقة",
 "lockstitch": "غرزة القفل, غرزة المكوك (غرزة ماكينة يتشابك فيها الخيط العلوي مع خيط المكوك)",
 "lockstitch machine": "ماكينة الغرزة المتشابكة, ماكينة غرزة القفل (آلة خياطة تربط القماش معاً باستخدام خيطين، علوي وسفلي، وتشابكهما معاً في ثقب القماش الذي يمران من خلاله)",
 "lockup": "إقفال, إيصاد (فعل قفل شيء ما لحمايته) / توقيف, حجز (سجن في مركز شرطة محلي)",
 "loco": "مَخْبُول, مَعْتُوه ((غير رسمي) مصطلحات عامّيّة تصف الاضطراب العقليّ)",
 "loco disease": "مرض اللوكو (مرض يصيب الماشية ناتج عن التسمم بنبات اللوكو)",
 "locoism": "مرض اللوكو (مرض يصيب الماشية ناتج عن التسمم بنبات اللوكو)",
 "locomotion": "تنقل, حركة (حركة ذاتية الدفع) / تَنَقُّل, قُوَّة مُحَرِّكَة (القوة أو القدرة على التحرك)",
 "locomotive": "قَاطِرَة",
 "locomotive engine": "جرار قطار, قاطرة (مركبة بعجلات تتكون من محرك ذاتي الدفع يستخدم لسحب القطارات على طول خطوط السكك الحديدية)",
 "locomotive engineer": "سائق قطار, مهندس قطار (مشغل قاطرة السكك الحديدية)",
 "locomotor": "تنقلي, حركي (من أو يتعلق بالحركة والتنقل)",
 "locomotor ataxia": "تابس ظهري, رنح حركي (زهري يصيب الحبل الشوكي يتميز بتنكس الخلايا العصبية الحسية وآلام طاعنة في الجذع والساقين ومشية غير مستقرة وسلس وبول وعجز جنسي)",
 "locoweed": "بانجو, عشب (أسماء دارجة للماريجوانا) / عشبة الجنون, لوكويد (أي من النباتات البقولية المتعددة في غرب أمريكا الشمالية التي تسبب التسمم (اللوكو) للماشية)",
 "locule": "حجيرة, مسكن (تجويف صغير أو فراغ داخل عضو أو في نبات أو حيوان)",
 "loculus": "حجيرة, مسكن (تجويف صغير أو فراغ داخل عضو أو في نبات أو حيوان)",
 "locum": "بَدِيل مُؤَقَّت (شخص (طبيب أو رجل دين) ينوب مؤقتاً عن عضو آخر في نفس المهنة)",
 "locum tenens": "بَدِيل مُؤَقَّت (شخص (طبيب أو رجل دين) ينوب مؤقتاً عن عضو آخر في نفس المهنة)",
 "locus": "محل هندسي (مجموعة كل النقاط أو الخطوط التي تحقق شروطاً محددة أو تتحدد بها) / موقع جيني (الموقع المحدد لجين معين على الكروموسوم الخاص به) / محل, مكان الانعقاد (مسرح أي حدث أو إجراء (خاصة مكان الاجتماع))\nمثال: المحل الهندسي للنقاط المتساوية البعد عن نقطة معينة هو دائرة",
 "locus classicus": "المرجع الأساسي, الموضع الكلاسيكي (مقطع موثوق ومقتبس كثيراً)",
 "locus niger": "مادة سوداء (طبقة من المادة الرمادية ذات الصبغة العميقة في الدماغ المتوسط؛ مرتبطة بالجسم المخطط؛ وتشارك في الاضطرابات الأيضية المرتبطة بمرض باركنسون ومرض هنتنغتون)",
 "locus of infection": "بؤرة العدوى (الموقع المحدد في الجسم الذي تنشأ فيه العدوى)",
 "locust": "جَرَادَة",
 "locust bean": "خروب (قرن طويل يحتوي على فاصوليا صغيرة ولب حلو صالح للأكل؛ يستخدم كعلف حيواني ومصدر لبديل الشوكولاتة)",
 "locust pod": "خروب (قرن طويل يحتوي على فاصوليا صغيرة ولب حلو صالح للأكل؛ يستخدم كعلف حيواني ومصدر لبديل الشوكولاتة)",
