 "lulu": "حسناء, فاتنة (امرأة جذابة جداً أو مغرية المظهر)",
 "lulz": "متعة السخرية (هدف يستحق التحقيق فقط من أجل المتعة الذاتية المصاحبة له)",
 "lumbago": "أَلَمْ قَطَنِيّ, أَلَمْ اَلْقَطَنْ (الوَجَع)\nمثال: ألم أقل لك ذلك؟",
 "lumbar": "قَطَنِيّ",
 "lumbar artery": "شريان قطني (واحد من أربعة أو خمسة أزواج من الشرايين تنشأ في الأبهر البطني وتغذي الفقرات القطنية وعضلات الظهر وجدار البطن)",
 "lumbar nerve": "عصب قطني (أي من خمسة أزواج من الأعصاب الشوكية الخارجة من القسم القطني للحبل الشوكي)",
 "lumbar pain": "ألم أسفل الظهر, قطان (ألم ظهر يصيب المنطقة القطنية أو أسفل الظهر؛ يمكن أن يحدث بسبب إجهاد العضلات أو التهاب المفاصل أو القصور الوعائي أو تمزق القرص بين الفقرات)",
 "lumbar plexus": "ضفيرة قطنية (ضفيرة من الأعصاب تتكون من الفروع البطنية للأعصاب القطنية الأربعة الأولى) / ضفيرة قطنية (ضفيرة ليمفاوية تقع على طول الجزء السفلي من الأبهر والأوعية الحرقفية)",
 "lumbar puncture": "بَزْل قَطَنِيّ",
 "lumbar vein": "وريد قطني (أوردة تصرف جدار الجسم الخلفي والضفائر الوريدية الفقرية القطنية)",
 "lumbar vertebra": "فَقَرَة قَطَنِيَّة",
 "lumber": "خَشَب (هو ما غَلَظَ وصَلُبَ من أصول الشَجَر وفروعها مثل الجِذْع والأغْصَان؛ هو ما صنع من جذوع أو أغصان الشَجَر)\nمثال: نحن نقطع الخشب.",
 "lumber jacket": "سترة الحطابين (سترة خارجية قصيرة ودافئة)",
 "lumber room": "غرفة الخردة (مخزن في منزل حيث يمكن تخزين الأشياء المتنوعة (خاصة الأثاث))",
 "lumbering": "تجارة الأخشاب, قطع الأخشاب (تجارة قطع أو تجهيز أو بيع الأخشاب) / بَطيء, ثَقيل الحَرَكَة (بَطيء ومُتَثاقِل بِسَبَب الوَزْن)",
 "lumberjack": "حَطَّاب",
 "lumberman": "حطاب, قاطع أخشاب (شخص ذكر يقطع الأشجار)",
 "lumberman's saw": "منشار لشخصين (منشار بمقابض في كلا الطرفين؛ مخصص للاستخدام من قبل شخصين)",
 "lumbermill": "منشرة خشب (طاحونة لتجهيز جذوع الأشجار والأخشاب)",
 "lumberwoman": "حطابة (شخص أنثى تقطع الأشجار)",
 "lumberyard": "ساحة أخشاب, مستودع أخشاب (مكان عمل يتم فيه تخزين الأخشاب للبيع)",
 "lumbosacral": "قطني عجزي (من أو يتعلق بمنطقة أسفل الظهر والجزء الخلفي من الحوض)",
 "lumbosacral plexus": "ضفيرة قطنية عجزية (ضفيرة عصبية تتكون من الانقسامات البطنية للأعصاب العصعصية والعجزية والقطنية؛ تغذي الأطراف السفلية والعجان ومنطقة العصعص)",
 "lumbus": "خاصرة, قطن (أي من جانبي العمود الفقري بين عظم الورك والأضلاع في البشر وكذلك ذوات الأربع)",
 "lumen": "لُومِن",
 "luminaire": "تركيبات إضاءة, وحدة إضاءة (جهاز كهربائي يستخدم لإنشاء ضوء صناعي باستخدام مصباح كهربائي؛ تحتوي جميع وحدات الإضاءة على جسم وحدة ومقبس مصباح لحمل المصباح والسماح باستبداله)",
 "luminal": "ثيوبنتال الصوديوم, فينوباربيتال (باربيتورات طويل المفعول يستخدم كمهدئ)",
 "luminance": "سطوع, ضياء (صفة كون الشيء مضيئاً؛ انبعاث أو انعكاس الضوء)\nمثال: يتم قياس لمعانه نسبة إلى لمعان شمسنا",
 "luminance unit": "وحدة نصوع (مقياس للنصوع)",
 "luminary": "عَلَم, نجم لامع (مشهور يمثل إلهاماً للآخرين)\nمثال: استضاف تجمعاً كبيراً من النجوم اللامعة",
 "luminescence": "ضِيَائِيَّة, تَأَلُّق",
 "luminescent": "مُتَلَأْلِئ, وَامِض (يَبْعَث ضَوْءًا غَيْرَ نَاتِجٍ عَنِ الحَرَارَة)",
 "luminescent screen": "شاشة متألقة, شاشة مضيئة (الشاشة في أنبوب أشعة الكاثود، والتي تصبح مضيئة عند قصفها بشعاع إلكتروني)",
 "luminism": "الضوئية (حركة فنية في الولايات المتحدة اشتقت من مدرسة نهر هدسون؛ نشطت من 1850 إلى 1870؛ رسمت مناظر طبيعية واقعية بأسلوب يصور الضوء الجوي واستخدام المنظور الجوي)",
 "luminol": "لومينول (مركب يبعث ضوءاً عندما يتلامس مع الدم)\nمثال: التفاعل الذي يخلقه اللومينول وبيروكسيد الهيدروجين لا يدوم طويلاً",
 "luminosity": "سطوع, ضياء (صفة كون الشيء مضيئاً؛ انبعاث أو انعكاس الضوء)\nمثال: يتم قياس لمعانه نسبة إلى لمعان شمسنا",
 "luminous": "مُشِعّ بِرِقَّة, وَهَّاج (سَاطِع أَوْ مُشِعّ بِنُعُومَةٍ وَلُطْف)",
 "luminous energy": "طاقة ضوئية (الطاقة المرتبطة بالضوء المرئي)",
 "luminous flux": "تَدَفُّق ضَوْئِيّ, فَيْض ضَوْئِيّ (معدل تدفق الطاقة الضوئية)",
 "luminous flux unit": "وحدة تدفق ضوئي (مقياس للتدفق الضوئي لكل وحدة مساحة)",
 "luminous intensity unit": "وحدة شدة الإضاءة (مقياس لشدة الإضاءة)",
 "luminousness": "سطوع, ضياء (صفة كون الشيء مضيئاً؛ انبعاث أو انعكاس الضوء)\nمثال: يتم قياس لمعانه نسبة إلى لمعان شمسنا",
 "lumma": "لوما (100 لوما تساوي 1 درام في أرمينيا)",
 "lummox": "أبله, أجلف (شخص أخرق وغبي)",
 "lump": "كُتْلَة (القطعة المجتمعة من الشيء؛ القطعة الواحدة من اللحم)\nمثال: السحابة هي كتلة بخار في السماء.",
 "lump sugar": "مكعب السكر (سكر مكرر مصبوب في أشكال مستطيلة ملائمة كحصص فردية)",
 "lump sum": "دفعة واحدة",
 "lumpectomy": "استئصال الورم (إزالة جراحية لورم دون إزالة الكثير من الأنسجة المحيطة أو العقد الليمفاوية؛ يتم إجراؤها في بعض حالات سرطان الثدي)",
 "lumpen": "خَامِل الذِّهْن (بطيء التفكير وخامل عقليّاً)",
 "lumpenproletariat": "البروليتاريا الرثة ((في الماركسية) المستويات الدنيا غير المنظمة من البروليتاريا غير المهتمين بالتقدم الثوري)",
 "lumpenus lumpretaeformis": "بليني الثعبان (توجد في مياه القطب الشمالي وشمال المحيط الأطلسي)",
 "lumper": "مُكتِّل (عالم تصنيف يصنف الكائنات الحية في مجموعات كبيرة بناءً على الخصائص الرئيسية) / عامل الميناء, عامل شحن وتفريغ (عامل يقوم بتحميل وتفريغ السفن في الميناء)",
 "lumpfish": "سمكة الكتل (سمكة خرقاء ناعمة سميكة الجسم في شمال المحيط الأطلسي مع زعانف حوضية ملتحمة في ممص؛ يستخدم بطرخها الصالح للأكل للكافيار)",
 "lumpiness": "تكتل, خشونة (خاصية الامتلاء بالكتل، وعدم النعومة)\nمثال: يتميز السطح بتكتله، وخطوطه العشوائية، وملمسه غير المستوي بشكل عام",
 "lumpish": "خَامِل الذِّهْن (بطيء التفكير وخامل عقليّاً)",
 "lumpsucker": "لامب سكر, مصاصة الحجر (أي من عدة أسماك صغيرة جداً من نوع الأسماك المكتلة)",
 "lumpy": "مُتَكَتِّل",
 "lumpy jaw": "الفك المتكتل, داء الشعيات الرقبي الوجهي (أكثر أشكال داء الشعيات شيوعًا وأقلها خطورة؛ يصيب مناطق الوجه والرقبة)",
 "luna moth": "فَرَاشَة لُونَا (حشرة صغيرة رقيقة ذات أجنحة كبيرة قد تكون ملونة أو غير ملونة)\nمثال: آه ، هناك فراشة!",
 "lunacy": "حماقة, طيش (سلوك أحمق أو لا معنى له) / لوثة, هوس (مصطلحات قديمة للجنون القانوني)",
 "lunar": "قَمَرِيّ",
 "lunar calendar": "تقويم قمري",
 "lunar caustic": "كاوٍ قمري (نترات الفضة المصهورة في عيدان وكانت تستخدم سابقاً كمادة كاوية)",
 "lunar crater": "فوهة قمرية (فوهة على سطح قمر الأرض)",
 "lunar day": "يوم قمري (الفترة الزمنية التي يستغرقها القمر للقيام بدورة كاملة حول محوره (حوالي 27.3 يوماً فلكياً))",
 "lunar eclipse": "خُسُوف اَلْقَمَر",
 "lunar excursion module": "مركبة الهبوط على القمر, وحدة قمرية (مركبة فضائية تحمل رواد الفضاء من وحدة القيادة إلى سطح القمر والعودة)",
 "lunar latitude": "خط عرض قمري (خط وهمي حول القمر موازٍ لخط استوائه)",
 "lunar module": "مركبة الهبوط على القمر, وحدة قمرية (مركبة فضائية تحمل رواد الفضاء من وحدة القيادة إلى سطح القمر والعودة)",
 "lunar month": "شهر قمري (الفترة بين قمرين جديدين متتاليين (29.531 يوماً))",
 "lunar new year": "رَأْس السَّنَة الصِّينِيَّة, عِيد الرَّبِيع (عُضْو مِنَ ٱلْجَسَدِ يَحْوِي الدِّمَاغ والفَم والأَنْف والعَيْنَيْن والأُذُنَيْن؛ أَعْلَى ٱلشَّيْءِ)\nمثال: قطع سامي رأس كلب.",
 "lunar time period": "مد وجزر (هناك عادة مدان وجزران كل يوم)",
 "lunar year": "سنة قمرية (فترة من 12 شهراً قمرياً)",
 "lunaria annua": "زهرة الدراهم, لوناريا (نبات من جنوب شرق أوروبا يُزرع لأزهاره الأرجوانية العطرة وقرون بذوره الورقية الفضية البيضاء المستديرة المسطحة التي تستخدم للزينة الداخلية)",
 "lunarian": "قَمَرِيّ, قَمَرِيَّة",
 "lunate": "هِلَالِيُّ الشَّكْلِ, هِلَالِيّ (ذو شكل يشبه الهلال)",
 "lunate bone": "عظم هلالي (أحد عظام الرسغ الصغيرة الثمانية)",
 "lunatic": "مَسْلُوبُ العَقْل, مَمْسُوسٌ بِالقَمَر (مجنون ويُعتَقد أنّ جنونه مرتبط بأطوار القمر) / طائش, متهور (شخص متهور مندفع غير مسؤول) / مَجْنُون, مُخْتَلّ عَقْلِيّاً (شخص فاقد للعقل)",
 "lunatic fringe": "الأقلية المتطرفة (وحدة سياسية ذات وجهات نظر متطرفة ومتعصبة)",
 "lunation": "شهر قمري (الفترة بين قمرين جديدين متتاليين (29.531 يوماً))",
 "lunch": "غَدَاء (هو طَعَام الغُدْوَة، وهو الوقت بين الفَجْر وطلوع الشَمْس. استخدام قديم؛ طعام الظُهْر. استخدام حديث)\nمثال: إنه وقت الغداء.",
 "lunch meat": "لانشون, لحم غداء (أي نوع من أنواع النقانق أو قوالب اللحم المقطعة شرائح وتقدم باردة)",
 "lunch meeting": "اجتماع غداء, غداء عمل (اجتماع على الغداء؛ عادة لإجراء الأعمال أثناء تناول الطعام)",
 "lunch period": "فترة الغداء, وقت الغداء (الساعة المعتادة أو العرفية لتناول وجبة الغداء)\nمثال: حافظ على وقت غداء منتظم",
 "lunchbox": "صندوق الغداء (وعاء كبيرة من الخشب غالبا وقد يكون حديدًا يستخدم لوضع الاشياء داخله، ويكون لها عادة جهة قابلة للفتح سواء بمفاصل او بالازالة الكاملة؛ صُنْدُوْقُ السَيَّارَة قمرة تشبه الصندوق في الجزء الخلفي من السيارة يستخدم كالصندوق)\nمثال: أين صندوق البريد؟",
 "lunchbreak": "اِسْتِرَاحَةُ الْغَدَاء (مبنى خارج المدن يتوقف فيه المسافرون للراحة والتَزَوُّد يُجمع على اِسْتِرَاحَات)\nمثال: عليك أخذ استراحة.",
 "luncheon": "غداء (وجبة منتصف النهار)",
 "luncheon meat": "لانشون, لحم غداء (أي نوع من أنواع النقانق أو قوالب اللحم المقطعة شرائح وتقدم باردة)",
 "luncheon meeting": "اجتماع غداء, غداء عمل (اجتماع على الغداء؛ عادة لإجراء الأعمال أثناء تناول الطعام)",
 "luncheon voucher": "تذكرة طعام, قسيمة وجبة (قسيمة قابلة للاسترداد في مطعم وتخول حاملها الحصول على وجبة)",
 "luncher": "متغدٍ (شخص يتناول طعام الغداء)",
 "lunching": "تناول الغداء (فعل تناول الغداء)",
 "lunchroom": "غرفة الغداء (مطعم (في منشأة) حيث يمكن شراء الغداء)",
 "lunchtime": "وَقْتُ الْغَدَاء (\"بَقِيَ وَقْتاً عِنْدَهُ \" : أَيْ مِقْدَاراً مِنَ الزَّمَنِ؛ \"جَاءَ فِي الوَقْتِ الْمُنَاسِبِ \" : فِي اللَّحْظَةِ الْمُنَاسِبَةِ)\nمثال: حان وقت الذهاب.",
 "lunda cirrhata": "بفن ذو عرف (بفن شمال المحيط الهادئ ذو ريشة صفراء كبيرة فوق كل عين)",
 "lunette": "قمرية, نافذة هلالية (فتحة بيضاوية أو دائرية؛ للسماح بدخول الضوء إلى قبة أو قبو) / تحصين هلالي (تحصين مؤقت يشبه الحصن المنفصل)",
 "lung": "رِئَة, سَحَر",
 "lung cancer": "سَرَطَان اَلرِّئَة",
 "lung-like": "رئوي الشكل (يؤدي وظائف مماثلة لتلك التي تؤديها الرئتان)",
 "lung-power": "جهراوة الصوت, قوة الصوت (القدرة على التحدث بصوت عال)",
 "lunge": "اندفاع (فعل التحرك للأمام فجأة) / اندفاعة ((مبارزة) طعنة هجومية تتم بقدم واحدة للأمام والساق الخلفية مستقيمة وذراع السيف ممدودة للأمام)",
 "lungen": "لونجان, لونغان (شجرة من جنوب شرق آسيا إلى أستراليا تزرع أساساً لفاكهتها الحلوة الصالحة للأكل التي تشبه مكسرات الليتشي)",
 "lunger": "مَرِيض بِالسُّلّ, مَسْلُول (شخص مصاب بالسل الرئوي) / مُندفع (شخص يتحرك للأمام فجأة (كما في المبارزة))",
 "lungfish": "سمكة رئوية (سمكة تتنفس الهواء ولها جسم ممدود وزعانف مزدوجة لحمية؛ تبني بعض الأنواع أغطية طينية مبطنة بالمخاط للنجاة من الجفاف)",
 "lungi": "إزار, لونغي (قطعة طويلة من القماش زاهي الألوان (قطن أو حرير) تستخدم كملابس (تنورة أو مئزر أو وشاح إلخ) في الهند وباكستان وبورما)",
 "lungless salamander": "سمندل عديم الرئة (سمندل بري في الغالب يتنفس من خلال جلده الرطب الرقيق؛ يضع البيض في أماكن رطبة على الأرض؛ نادراً ما يدخل الماء)",
 "lungyi": "إزار, لونغي (قطعة طويلة من القماش زاهي الألوان (قطن أو حرير) تستخدم كملابس (تنورة أو مئزر أو وشاح إلخ) في الهند وباكستان وبورما)",
 "lunisolar": "قمري شمسي (متعلق بـ أو منسوب إلى القمر والشمس أو علاقاتهما المتبادلة)",
 "lunisolar calendar": "تقويم قمري شمسي (تقويم يعتمد على كل من الدورات القمرية والشمسية)",
 "lunitidal interval": "الفاصل القمري المدّي (الفاصل الزمني بين عبور القمر لخط طول معين والمد العالي التالي عند ذلك الخط)",
 "lunkhead": "أحمق, بليد (شخص غبي؛ تستخدم هذه الكلمات للتعبير عن رأي متدنٍ في ذكاء شخص ما)",
 "lunula": "حلية هلالية (حلية معدنية على شكل هلال من العصر البرونزي) / ظفرة, هلالية الظفر (المنطقة الهلالية الشكل عند قاعدة ظفر الإنسان)",
 "lunule": "ظفرة, هلالية الظفر (المنطقة الهلالية الشكل عند قاعدة ظفر الإنسان)",
 "luo": "لوو (لغة نيلية يتم التحدث بها في منطقة أداماوا في الكاميرون)",
 "luo language": "لوو (لغة نيلية يتم التحدث بها في منطقة أداماوا في الكاميرون)",
 "luoyang": "لُويَانْغ",
 "lupin": "ترمس",
 "lupine": "ذِئْبِيّ",
 "lupinus albus": "ترمس أبيض, ترمس مصري (عشب أوراسي ذو زهور بيضاء يزرع على نطاق واسع للعلف ومكافحة التعرية)",
 "lupinus arboreus": "ترمس شجري (شجيرة دائمة الخضرة من ساحل المحيط الهادئ للولايات المتحدة لها زهور صفراء أو زرقاء بارزة؛ تم توطينها في أستراليا)",
 "lupinus luteus": "ترمس أصفر (ترمس أوروبي ذو زهور صفراء يزرع للعلف)",
 "lupinus perennis": "ترمس بري, ترمس معمر (نبات معمر قوي من شرق ووسط أمريكا الشمالية له أوراق كفية وزهور زرقاء عنقودية مبهرجة)",
 "lupinus subcarnosus": "بلوبونيت, ترمس تكساس (عشب حولي منخفض النمو في جنوب غرب الولايات المتحدة (تكساس) ذو أوراق حريرية وزهور زرقاء؛ وهو سبب رئيسي لتسمم الماشية في جنوب غرب الولايات المتحدة)",
 "lupinus texensis": "ترمس تكساس",
 "lupulin": "لوبولين (اللوبولين مسحوق يتم فصله عن أكواز نبات الجنجل (حشيشة الدينار) الشائع)\nمثال: اللوبولين، أو صبغته، له العديد من الاستخدامات الطبية",
 "lupus": "ذِئْبَة",
 "lupus erythematosus": "ذئبة حمامية (مرض كولاجين التهابي مزمن يصيب الأنسجة الضامة)",
 "lupus vulgaris": "ذئبة شائعة (سل الجلد؛ يظهر أولاً على الوجه ويشفى ببطء تاركًا ندوبًا عميقة)",
 "luqman": "لُقْمَان / سُورَةُ لُقْمَان",
 "lurch": "ترنح, تعثر (مشية غير متوازنة وغير ثابتة) / اندفاع (فعل التحرك للأمام فجأة) / تأرجح رأسي, ترنح (حركة صعود وهبوط مفاجئة (كما تسببها سفينة أو وسيلة نقل أخرى)) / هزيمة ساحقة (هزيمة حاسمة في لعبة (خاصة في الكريبج))\nمثال: كان التأرجح والتقلب مثيراً للغاية",
 "lurcher": "مُتَرَبِّص, مُخْتَبِئ (شخص ينتظر في الخفاء)",
 "lure": "شرك, طُعم (شيء يستخدم لجذب الأسماك أو الحيوانات الأخرى إلى الخطر ليتم اصطيادها أو قتلها) / إِغْرَاء, اسْتِدْرَاج (صفات تجذب من خلال ما يبدو أنه يعد بنوع من المكافأة) / إغراء, طعم (أي شيء يعمل كوسيلة للإغواء)",
 "lurid": "مُتَوَهِّج بِحُمْرَة (يَلْمَع بِتَوَهُّجٍ أَحْمَرَ غَيْرِ طَبِيعِيّ كَالنَّار خِلَال الدُّخَان) / كَامِد, مُصْفَرّ (ذو لون شاحب مريض ومُنفِّر) / صَادِم, فَظِيع (صارخ الوضوح والتصوير؛ يتسم بالإثارة المبالغ فيها) / فَظِيع, مُرَوِّع (مُرْعِبٌ فِي ضَرَاوَتِهِ أَوْ وَحْشِيَّتِه)",
 "luridly": "بشكل صارخ, بشكل مروع (بطريقة مروعة أو صارخة)\nمثال: وُصف بشكل مروع في الكتاب بأنه المكان الذي يلجأ إليه المتصوفة",
 "luridness": "بَشَاعَة, شَنَاعَة (صفة كون الشيء مروعاً أو بشعاً) / امتقاع, شحوب (نقص غير طبيعي في لون الجلد (بسبب كدمات أو مرض أو ضائقة عاطفية)) / إثارة, تهويل (الاستخدام الصحفي لموضوع يروق للأذواق المبتذلة)",
 "lurker": "مُتَرَبِّص, مُخْتَبِئ (شخص ينتظر في الخفاء)",
 "lurking place": "مكمن (مكان مناسب للترصد)",
 "lusail": "لُوسَيْل, مَدِينَة لُوسَيْل",
 "lusaka": "لُوسَاكَا",
 "lusatian": "اللغة الصوربية (لغة سلافونية يتم التحدث بها في المنطقة الريفية بجنوب شرق ألمانيا)",
 "lusatian language": "اللغة الصوربية (لغة سلافونية يتم التحدث بها في المنطقة الريفية بجنوب شرق ألمانيا)",
 "luschka's tonsil": "لحمية, لوزة بلعومية (تجمع من الأنسجة اللمفاوية في الحلق خلف اللهاة (على الجدار الخلفي وسقف البلعوم الأنفي))\nمثال: تضخم اللوزتين البلعوميتين يسمى اللحمية",
 "luscinia luscinia": "عندليب السمنة (عندليب كبير من شرق أوروبا)",
 "luscinia megarhynchos": "عندليب (طائر مغرد أوروبي يشتهر بتغريده الليلي الشجي)",
 "luscious": "فَاتِن, مُغْرٍ جِنْسِيًّا (ذو جاذبية جنسية قوية) / شَهِيٌّ لِلغَايَة, لَذِيذٌ جِدًّا (بَالِغُ اللَّذَّةِ لِحَاسَّةِ التَّذَوُّق)",
 "lusciously": "بشكل شهي, بلذة (بطريقة تنتج طعماً لذيذاً)\nمثال: اشتريت المزيد من هذا الخوخ الحلو بشكل شهي",
 "lusciousness": "شهية, لذة شديدة (جاذبية شديدة للشهية)",
 "lush": "زَاخِر, فَيَّاض (يُنتَج أو ينمو بوَفْرة بالغة) / عَصِير, غَضّ (طريّ وممتلئ بالعصارة) / فَاخِر, فَخْم (غنيّ بشكل استعراضي ومتفوّق في الجودة) / فَاتِن, مُغْرٍ جِنْسِيًّا (ذو جاذبية جنسية قوية)",
 "lushness": "ترف, رغد (خاصية كون الشيء غزيراً ووفيراً وممتعاً للحواس)",
 "lusitanian": "لوسيتاني (من أو يتعلق بمنطقة لوسيتانيا أو شعبها أو لغتها أو يميزها) / برتغالي (من أو يتعلق بالبرتغال أو شعب البرتغال أو لغتهم أو يميزهم)\nمثال: نبيذ برتغالي",
 "lust": "شَهْوَة",
 "lust for learning": "رغبة في المعرفة, نهم للعلم (فضول يحفز البحث والدراسة)",
 "luster": "جاذِبيّة / إشْراق, تَهْذِيب",
 "lusterless": "فَاقِد البَرِيق, كَامِد (يَفْتَقِر إِلَى اللَّمَعَان أَوِ البَرِيق) / بَاهِت, فَاتِرٌ (يفتقر إلى التألّق أو الحيوية)",
 "lusterlessness": "انطفاء, عدم اللمعان (خاصية وجود تباين ضئيل أو معدوم؛ الافتقار إلى الإبرازات الضوئية أو اللمعان)",
 "lusterware": "خزف بريق معدني (فخار بلمعان معدني ناتج عن إضافة أكاسيد معدنية إلى الطلاء الزجاجي)",
 "lustful": "شَهْوَانِيّ",
 "lustfully": "بشهوة (بطريقة شهوانية)\nمثال: نظر إلى الشابة بشهوة",
 "lustfulness": "شَهْوَانِيَّة",
 "lustily": "بِحَيْوِيَّة, بِقُوَّة (بطريقة صحية)\nمثال: نمت النباتات الصغيرة بحيوية",
 "lustiness": "عافية, متانة (خاصية كون الشخص قوياً وصحياً في البنية)",
 "lustre": "بريق, لمعان (طلاء سطحي للسيراميك أو البورسلين) / بريق, رونق (الخاصية البصرية لشيء يلمع بضوء منعكس) / بهاء, تألق (جودة تتفوق في لمعانها على المعتاد)",
 "lustreless": "فَاقِد البَرِيق, كَامِد (يَفْتَقِر إِلَى اللَّمَعَان أَوِ البَرِيق) / بَاهِت, فَاتِرٌ (يفتقر إلى التألّق أو الحيوية)",
 "lustrelessness": "انطفاء, عدم اللمعان (خاصية وجود تباين ضئيل أو معدوم؛ الافتقار إلى الإبرازات الضوئية أو اللمعان)",
 "lustrous": "بَرَّاق, لَمَّاع (يَعْكِس الضَّوْء) / بَهِيّ, نَيِّر (متألق ولامع؛ باهر في تميزه) / بَرَّاق, لَمَّاع (جُعل ناعماً ولامعاً كما لو بالحكّ؛ يعكس بريقاً أو توهجاً)",
 "lustrum": "تطهير خماسي (تطهير احتفالي للسكان الرومان كل خمس سنوات بعد التعداد) / فترة خمس سنوات (فترة تدوم خمس سنوات)",
 "lusty": "فَتِيّ, مِلْؤُه الحَيَوِيَّة (مَليء بِالقُوَّة والنَّشاط والحَيَوِيَّة الدَّمَوِيَّة) / شَبِق, شَهْوَانِيّ (عَنِيفُ الشَّهْوَةِ وَالرَّغْبَة)",
 "lusus naturae": "شخص مشوه, مسخ (شخص أو حيوان غير عادي أو مشوه بشكل ملحوظ)",
 "lutanist": "عازف عود, عازف لوت (موسيقي يعزف على اللوت)",
 "lute": "عُود (قطعة من الخشب كالعصا جمعه عيدان؛ ما يُتَبَخَّر به)\nمثال: أشعلت عود ثقاب.",
 "luteal": "أصفري (مكون من أو متعلق بالجسم الأصفر)",
 "luteal phase": "المرحلة الأصفرية, المرحلة الإفرازية (النصف الثاني من الدورة الشهرية بعد الإباضة؛ يفرز الجسم الأصفر البروجسترون الذي يجهز بطانة الرحم لزرع الجنين؛ إذا لم يحدث الإخصاب، يبدأ تدفق الحيض)",
 "lutecium": "لوتيشيوم (عنصر فلزي ثلاثي التكافؤ من مجموعة الأتربة النادرة)",
 "lutefisk": "لوتفسك (سمك القد المجفف المنقوع في محلول قلوي قبل الغلي لإعطائه قواماً هلامياً)",
 "lutein": "زانثوفيل, لوتين (أصباغ كاروتينويد صفراء في النباتات والدهون الحيوانية وصفار البيض)",
 "luteinizing hormone": "الهرمون الملوتن (هرمون موجه للغدد التناسلية تفرزه الغدة النخامية الأمامية؛ يحفز التبويض في إناث الثدييات ويحفز إطلاق الأندروجين في ذكور الثدييات)",
 "lutenist": "عازف عود, عازف لوت (موسيقي يعزف على اللوت)",
 "luteotropin": "برولاكتين, هرمون الحليب (هرمون موجه للغدد التناسلية تفرزه الغدة النخامية الأمامية؛ يحفز نمو الغدد الثديية والرضاعة عند الإناث بعد الولادة)",
 "lutetium": "لُوتِيتِيُوم",
 "lutfisk": "لوتفسك (سمك القد المجفف المنقوع في محلول قلوي قبل الغلي لإعطائه قواماً هلامياً)",
 "lutheran": "لُوْثَريّ",
 "lutheran church": "الكنيسة اللوثرية (الطائفة البروتستانتية الملتزمة بآراء مارتن لوثر)",
 "lutheranism": "لوثرية (تعاليم مارتن لوثر التي تؤكد على العقيدة الأساسية للتبرير بالإيمان وحده)",
 "luthier": "صانع الآلات الوترية (حرفي يصنع الآلات الوترية (مثل العود أو القيثارات أو الكمان))",
 "luting": "لوت, ملاط سد (مادة لحشو وصلة أو طلاء سطح مسامي لجعله غير منفذ للغاز أو السائل)",
 "lutist": "عازف عود, عازف لوت (موسيقي يعزف على اللوت)",
 "lutite": "ليتيت",
 "lutjanus analis": "نهاش الضأن (يشبه وغالباً ما يُسوق على أنه 'نهاش أحمر')",
 "lutjanus apodus": "نهاش مدرسي (سمكة طعام من مياه البحر الكاريبي والمحيط الأطلسي الدافئة)",
 "lutjanus blackfordi": "نهاش أحمر (سمكة طعام محترمة ذات رأس وجسم أحمر وردي؛ شائعة في المياه الساحلية الأطلسية لأمريكا الشمالية وخليج المكسيك)",
 "lutjanus griseus": "نهاش رمادي (يوجد في المياه الضحلة قبالة ساحل فلوريدا)",
 "lutra canadensis": "قضاعة نهرية (حيوان مائي اجتماعي واسع الانتشار على طول الجداول وحدود البحيرات في أمريكا الشمالية)",
 "lutra lutra": "قضاعة أوراسية (قضاعة توجد في أوروبا وآسيا)",
