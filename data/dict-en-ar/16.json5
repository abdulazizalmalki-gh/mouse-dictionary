 "lobsterwoman": "صائدة جراد البحر (شخص أنثى مهنتها صيد جراد البحر (الاستاكوزا))",
 "lobular": "فصيصي (من أو يتعلق بالفصيص أو يشبهه)",
 "lobularia maritima": "أليسم حلو, خرم الإبرة (نبات أوروبي معمر له عناقيد من الزهور البيضاء الصغيرة العطرة عادة؛ يزرع على نطاق واسع في الحدائق)",
 "lobularity": "تفصص (خاصية امتلاك فصيصات)",
 "lobule": "فصيص (فص صغير أو قسم فرعي لفص)",
 "lobworm": "دودة الرمل (ديدان بحرية لها صف من الخياشيم المعنقدة على طول كل جانب من الظهر؛ تستخدم غالباً كطعم للصيد)",
 "local": "مَحَلِّيّ",
 "local anaesthesia": "تخدير موضعي (فقدان الإحساس في منطقة صغيرة من الجسم (كما هو الحال عند حقن مخدر موضعي لقلع الأسنان))",
 "local anaesthetic": "مخدر موضعي (مخدر يخدر منطقة معينة من الجسم)",
 "local anesthesia": "تخدير موضعي (فقدان الإحساس في منطقة صغيرة من الجسم (كما هو الحال عند حقن مخدر موضعي لقلع الأسنان))",
 "local anesthetic": "مخدر موضعي (مخدر يخدر منطقة معينة من الجسم)",
 "local area network": "شبكة محلية, لان (شبكة كمبيوتر محلية للاتصال بين أجهزة الكمبيوتر؛ خاصة الشبكة التي تربط أجهزة الكمبيوتر ومعالجات النصوص وغيرها من المعدات المكتبية الإلكترونية لإنشاء…)",
 "local authority": "سلطة محلية (وحدة إدارية للحكومة المحلية)",
 "local call": "مكالمة محلية (مكالمة هاتفية تتم داخل منطقة الاتصال المحلية)",
 "local department": "إدارة محلية (إدارة دائمة تُنشأ لأداء مهام الحكومة المحلية)",
 "local government": "إدارة محلية, حكومة محلية (حكومة منطقة محلية)",
 "local memory": "ذاكرة محلية (الذاكرة التي تستخدمها وحدة معالجة مركزية واحدة أو المخصصة لبرنامج أو وظيفة واحدة)\nمثال: يمكن للمعالج الوصول إلى ذاكرته المحلية بشكل أسرع من الذاكرة غير المحلية (الذاكرة المحلية لمعالج آخر أو المشتركة بين المعالجات)",
 "local option": "خيار محلي (حرية الحكومة المحلية في تحديد إمكانية تطبيق قانون مثير للجدل في ولايتها القضائية عن طريق التصويت الشعبي)",
 "local oscillator": "مذبذب محلي (مذبذب يتداخل خرجه مع إشارة الراديو الواردة لإنتاج نغمات المجموع والفرق)",
 "local post office": "فرع بريد محلي, مكتب بريد (فرع محلي تتوفر فيه الخدمات البريدية)",
 "local road": "شارع محلي, طريق محلي (شارع يستخدم في المقام الأول للوصول إلى الممتلكات المجاورة له)",
 "local street": "شارع محلي, طريق محلي (شارع يستخدم في المقام الأول للوصول إلى الممتلكات المجاورة له)",
 "local time": "توقيت محلي, توقيت مدني (الوقت الرسمي في منطقة محلية (معدل حسب الموقع حول الأرض)؛ يحدد بالقانون أو العرف)",
 "locale": "محل, مكان الانعقاد (مسرح أي حدث أو إجراء (خاصة مكان الاجتماع))",
 "localisation": "تحديد الموقع, تموضُع (تحديد المكان الذي يوجد فيه الشيء) / توطين الوظيفة, مبدأ التوطين ((فسيولوجيا) المبدأ القائل بأن وظائف محددة لها مواقع محددة نسبيًا في جزء أو عضو معين من الجسم)",
 "localisation of function": "توطين الوظيفة, مبدأ التوطين ((فسيولوجيا) المبدأ القائل بأن وظائف محددة لها مواقع محددة نسبيًا في جزء أو عضو معين من الجسم)",
 "localisation principle": "توطين الوظيفة, مبدأ التوطين ((فسيولوجيا) المبدأ القائل بأن وظائف محددة لها مواقع محددة نسبيًا في جزء أو عضو معين من الجسم)",
 "localised": "مَحَلِّيّ, مُوَجَّه مَحَلِّيًّا (جُعِل محلياً أو وُجِّه نحو النطاق المحلي) / مَحَلِّيّ, مَوْضِعِيّ (مَحْصور أَوْ مُقْتَصِر عَلى مَوْضِع مُعَيَّن)",
