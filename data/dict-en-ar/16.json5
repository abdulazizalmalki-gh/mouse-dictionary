 "magnetic core memory": "ذاكرة القلب المغناطيسي (ذاكرة كمبيوتر تتكون من مصفوفة من القلوب المغناطيسية؛ تم استبدالها الآن بذواكر أشباه الموصلات)",
 "magnetic declination": "اختلاف مغناطيسي, انحراف مغناطيسي (الزاوية (في موقع معين) بين الشمال المغناطيسي والشمال الحقيقي)",
 "magnetic dip": "زاوية الميل, ميل مغناطيسي ((في الفيزياء) الزاوية التي تصنعها الإبرة المغناطيسية مع مستوى الأفق)",
 "magnetic dipole": "ثنائي قطب مغناطيسي (ثنائي قطب بأقطاب مغناطيسية متضادة)",
 "magnetic dipole moment": "عزم ثنائي القطب المغناطيسي ((في الفيزياء) حلقة تيار تنشأ عنها مجال مغناطيسي مميز لثنائي قطب مغناطيسي)\nمثال: الإلكترون الذي يدور في ذرة سيكون له عزم ثنائي قطب مغناطيسي",
 "magnetic disc": "قرص مغناطيسي ((علم الحاسوب) جهاز ذاكرة يتكون من قرص مسطح مغطى بطبقة مغناطيسية يتم تخزين المعلومات عليها)",
 "magnetic disk": "قرص مغناطيسي ((علم الحاسوب) جهاز ذاكرة يتكون من قرص مسطح مغطى بطبقة مغناطيسية يتم تخزين المعلومات عليها)",
 "magnetic drum": "أسطوانة مغناطيسية (أسطوانة مطلية بمادة مغناطيسية، لتخزين بيانات وبرامج الحاسوب)",
 "magnetic energy": "طاقة مغناطيسية ((في الفيزياء) الطاقة الكامنة لمجال مغناطيسي)",
 "magnetic equator": "خط الاستواء المغناطيسي (خط وهمي يوازي خط الاستواء حيث لا يكون للإبرة المغناطيسية ميل)",
 "magnetic field": "حقل مغناطيسي (ذهب أو حدث بسرعة أو دون توقف؛ في بعض اللهجات: تعني تحرك سريعاً أو اهتزّ)\nمثال: يعمل الفلاحون في الحقل.",
 "magnetic field strength": "شدة المجال المغناطيسي, كثافة التدفق المغناطيسي (كمية التدفق المغناطيسي في وحدة مساحة عمودية على اتجاه التدفق المغناطيسي)",
 "magnetic flux": "فيض مغناطيسي, مجال مغناطيسي (خطوط القوة المحيطة بمغناطيس دائم أو جسيم مشحون متحرك) / تدفق مغناطيسي (مقياس لقوة المجال المغناطيسي عبر مساحة معينة)",
 "magnetic flux density": "شدة المجال المغناطيسي, كثافة التدفق المغناطيسي (كمية التدفق المغناطيسي في وحدة مساحة عمودية على اتجاه التدفق المغناطيسي)",
 "magnetic flux unit": "وحدة التدفق (مقياس لقوة المجال المغناطيسي لكل وحدة مساحة)",
 "magnetic force": "جذب مغناطيسي, مغناطيسية (الانجذاب للحديد؛ يرتبط بالتيارات الكهربائية وكذلك المغناطيسات؛ ويتميز بمجالات القوة)",
 "magnetic head": "رأس مغناطيسي (مغناطيس كهربائي (كما في مسجل الشريط) يحول التغيرات الكهربائية إلى تغيرات مغناطيسية يمكن تخزينها على سطح واسترجاعها لاحقاً)",
 "magnetic inclination": "زاوية الميل, ميل مغناطيسي ((في الفيزياء) الزاوية التي تصنعها الإبرة المغناطيسية مع مستوى الأفق)",
 "magnetic induction": "شدة المجال المغناطيسي, كثافة التدفق المغناطيسي (كمية التدفق المغناطيسي في وحدة مساحة عمودية على اتجاه التدفق المغناطيسي) / تمغنط, مغنطة (العملية التي تجعل المادة مغناطيسية (مؤقتاً أو بشكل دائم))",
 "magnetic ink": "حبر مغناطيسي (حبر يحتوي على جزيئات من مادة مغناطيسية يمكن الكشف عن وجودها بواسطة أجهزة استشعار مغناطيسية)",
 "magnetic intensity": "شدة المجال المغناطيسي, كثافة التدفق المغناطيسي (كمية التدفق المغناطيسي في وحدة مساحة عمودية على اتجاه التدفق المغناطيسي)",
 "magnetic iron-ore": "ماغنيتيت, مغناطيس طبيعي (أكسيد حديد ينجذب بقوة للمغناطيس)",
 "magnetic levitation": "رفع مغناطيسي, ماجليف (تكنولوجيا سكك حديدية عالية السرعة؛ حيث يُعلق القطار على وسادة مغناطيسية فوق مسار ممغنط ويسافر دون احتكاك)",
 "magnetic line of force": "خط القوة المغناطيسية (خط قوة في مجال مغناطيسي)",
 "magnetic medium": "تخزين مغناطيسي, وسيط تخزين مغناطيسي (أي وسيط تخزين تُستخدم فيه أنماط مختلفة من المغنطة لتمثيل البتات أو البايتات المخزنة من المعلومات)\nمثال: القرص الصلب في جهاز الكمبيوتر الخاص بك هو تخزين مغناطيسي",
 "magnetic meridian": "خط الزوال المغناطيسي (خط وهمي يمر عبر كلا القطبين المغناطيسيين للأرض)",
 "magnetic mine": "لغم مغناطيسي ((بحري) لغم بحري يتم تفجيره بواسطة آلية تستجيب للمواد المغناطيسية (مثل الهيكل الفولاذي للسفينة))",
 "magnetic moment": "عَزْم مَغْنَاطِيسِيّ",
 "magnetic monopole": "أُحَادِيّ القُطْب المِغْنَاطِيسِيّ (جسيم افتراضي له قطب مغناطيسي واحد بدلاً من القطبين المعتادين)",
 "magnetic needle": "إبرة مغناطيسية (مغناطيس رفيع معلق في بوصلة مغناطيسية على حامل باحتكاك قليل؛ يستخدم للإشارة إلى اتجاه القطب المغناطيسي للأرض)",
 "magnetic north": "الشَّمَال, الشَّمَال المِغْنَاطِيسِيّ (الاتجاه الذي تشير إليه إبرة البوصلة)",
 "magnetic pole": "قطب, قطب مغناطيسي (أحد طرفي المغناطيس حيث تبدو المغناطيسية مركزة) / قطب مغناطيسي (أي من النقطتين حيث تكون خطوط القوة للمجال المغناطيسي للأرض عمودية)",
 "magnetic pyrites": "بايريت مغناطيسي, بيروتيت",
 "magnetic recorder": "مسجل مغناطيسي (مسجل يتكون من معدات لعمل تسجيلات على وسائط مغناطيسية)",
 "magnetic resonance": "رنين مغناطيسي (رنين الإلكترونات أو الذرات أو الجزيئات أو الأنوية لترددات الإشعاع نتيجة لتكميم الفضاء في مجال مغناطيسي)",
 "magnetic resonance imaging": "تصوير بالرنين المغناطيسي (استخدام الرنين المغناطيسي النووي للبروتونات لإنتاج صور كثافة البروتون)",
 "magnetic storage": "تخزين مغناطيسي, وسيط تخزين مغناطيسي (أي وسيط تخزين تُستخدم فيه أنماط مختلفة من المغنطة لتمثيل البتات أو البايتات المخزنة من المعلومات)\nمثال: القرص الصلب في جهاز الكمبيوتر الخاص بك هو تخزين مغناطيسي",
 "magnetic storage medium": "تخزين مغناطيسي, وسيط تخزين مغناطيسي (أي وسيط تخزين تُستخدم فيه أنماط مختلفة من المغنطة لتمثيل البتات أو البايتات المخزنة من المعلومات)\nمثال: القرص الصلب في جهاز الكمبيوتر الخاص بك هو تخزين مغناطيسي",
 "magnetic storm": "عاصفة مغناطيسية (اضطراب مفاجئ في المجال المغناطيسي للأرض؛ ناتج عن انبعاث جسيمات من الشمس)",
 "magnetic stripe": "شريط مغناطيسي (شريط قصير من الشريط المغناطيسي ملحق ببطاقة ائتمان أو بطاقة خصم؛ يحتوي على بيانات تخبر جهاز القراءة بهويتك ورقم حسابك، إلخ)",
 "magnetic tape": "شريط مغناطيسي (جهاز ذاكرة يتكون من شريط بلاستيكي رفيع طويل مطلي بأكسيد الحديد؛ يستخدم لتسجيل الإشارات الصوتية أو الفيديو أو لتخزين معلومات الحاسوب)\nمثال: أخذ معه دزينة من الأشرطة لتسجيل المقابلة",
 "magnetic variation": "اختلاف مغناطيسي, انحراف مغناطيسي (الزاوية (في موقع معين) بين الشمال المغناطيسي والشمال الحقيقي)",
 "magnetically": "مغناطيسياً (كما لو كان بالمغناطيسية) / مغناطيسياً (باستخدام المغناطيسية)\nمثال: انجذب إليها مغناطيسياً",
 "magnetics": "علم المغناطيسية, مغناطيسية (فرع العلوم الذي يدرس المغناطيسية)",
 "magnetisation": "تمغنط, مغنطة (الخاصية الفيزيائية لكون الشيء مغناطيسياً) / تمغنط, مغنطة (العملية التي تجعل المادة مغناطيسية (مؤقتاً أو بشكل دائم)) / تمغنط, مغنطة (المدى أو الدرجة التي يتم بها مغنطة شيء ما)",
 "magnetised": "مغناطيسي, مُمغنط (لديه خصائص المغناطيس؛ أي جذب الحديد أو الصلب)\nمثال: القرص الصلب مغطى بطبقة رقيقة من مادة مغناطيسية",
 "magnetism": "مِغْنَاطِيسِيَّة, مَغْنَاطِيسِيَّة",
 "magnetite": "ماغنيتيت, مغناطيس طبيعي (أكسيد حديد ينجذب بقوة للمغناطيس)",
 "magnetization": "مَغْنَطَة",
 "magnetized": "مغناطيسي, مُمغنط (لديه خصائص المغناطيس؛ أي جذب الحديد أو الصلب)\nمثال: القرص الصلب مغطى بطبقة رقيقة من مادة مغناطيسية",
 "magneto": "مغنيط, مولد مغناطيسي (دينامو صغير بملف ثانوي ينتج جهداً عالياً يتيح للشرارة القفز بين أقطاب شمعة الاحتراق في محرك البنزين)",
 "magneto-dynamic microphone": "ميكروفون حركي, ميكروفون ديناميكي (ميكروفون يعمل عن طريق الحث الكهرومغناطيسي)",
 "magneto-optical disc": "قرص مغناطيسي ضوئي (قرص ضوئي قابل لإعادة الكتابة يستخدم في تكنولوجيا مغناطيسية مركبة)\nمثال: استخدام القرص المغناطيسي الضوئي يشبه استخدام محرك الأقراص المرنة أكثر من محرك الأقراص المدمجة القابلة لإعادة الكتابة",
 "magnetoelectric machine": "مغنيط, مولد مغناطيسي (دينامو صغير بملف ثانوي ينتج جهداً عالياً يتيح للشرارة القفز بين أقطاب شمعة الاحتراق في محرك البنزين)",
 "magnetograph": "مخطط المغناطيسية (أداة علمية تسجل التغيرات المغناطيسية (خاصة تغيرات المجال المغناطيسي للأرض))",
 "magnetohydrodynamics": "ديناميكا الموائع المغناطيسية (دراسة تفاعل المجالات المغناطيسية والموائع الموصلة للكهرباء (مثل البلازما أو المعدن المنصهر))",
 "magnetometer": "مقياس المغناطيسية (مقياس لمقارنة قوة المجالات المغناطيسية)",
 "magnetomotive force": "قوة دافعة مغناطيسية (القوة التي تنتج الفيض المغناطيسي)",
 "magnetomotive force unit": "وحدة القوة الدافعة المغناطيسية (وحدة لقياس القوة الدافعة المغناطيسية)",
 "magneton": "ماغنيتون (وحدة للعزم المغناطيسي لجسيم جزيئي أو ذري أو دون ذري)",
 "magnetosphere": "غلاف مغناطيسي (المجال المغناطيسي لكوكب؛ الحجم حول الكوكب الذي تخضع فيه الجسيمات المشحونة للمجال المغناطيسي للكوكب أكثر من المجال المغناطيسي الشمسي)",
 "magnetostrictive speaker": "مكبر صوت بتقبض مغناطيسي (مكبر صوت تظل فيه مجموعة المغناطيس والملف ثابتة؛ نشأ في تكنولوجيا السونار)",
 "magnetron": "ماجنترون, مغناطيسون (أنبوب مفرغ ثنائي الصمام يتم فيه التحكم في تدفق الإلكترونات من كاثود مركزي إلى أنود أسطواني بواسطة مجالات مغناطيسية وكهربائية متقاطعة؛ يستخدم بشكل…)",
 "magnification": "تكبير (عملية توسيع شيء ما في الحجم الظاهري) / تكبير, صورة مكبرة (مطبوعة فوتوغرافية تم تكبيرها) / تهويل, مبالغة (جعل الشيء يبدو أكثر أهمية مما هو عليه في الواقع) / تَكْبِير (نسبة حجم الصورة إلى حجم الشيء)",
 "magnificence": "عَظَمَة, فَخَامَة (الروعة أو الهيبة في الحجم أو المظهر) / أُبَّهَة, رَوْعَة (صفة كون الشيء رائعاً أو فاخراً أو عظيماً)\nمثال: عظمة العمارة",
 "magnificent": "عَظِيم, رَائِع (خلاف الصَغِيْر، الكَبِيْر؛ نقيض الحَقِير)\nمثال: الصين بلد عظيم.",
 "magnificently": "بشكل رائع, بشكل ممتاز (بشكل رائع) / بأبهة, بروعة (بطريقة جميلة ومثيرة للإعجاب)\nمثال: أبلى بلاءً حسناً بشكل ممتاز في الامتحان",
 "magnifico": "شخصية مرموقة (شخص ذو رتبة أو مظهر متميز)",
 "magnified": "مُضَخَّم, مُكَبَّر (مُكبَّر إلى درجة غير طبيعية)",
 "magnifier": "عدسة مكبرة, مكبر (أداة علمية تكبر الصورة)",
 "magnifying glass": "عَدَسَةٌ مُكَبِّرَة",
 "magniloquence": "تفخيم, تنميق (أسلوب عالي النبرة؛ استخدام مفرط للزخرفة اللفظية)",
 "magniloquent": "جَزْل, فَخْمُ الأُسْلُوب (سامٍ ومتعالٍ في الأسلوب)",
 "magniloquently": "بتفاصح, بقعقعة (بطريقة بلاغية مفخمة)\nمثال: تحدث الخطيب بتفاصح",
 "magnitogorsk": "مَاغْنِيتُوغُورْسْك",
 "magnitude": "حجم, عِظَم (خاصية الحجم النسبي أو المدى (سواء كان كبيراً أو صغيراً)) / أهمية, جسامة (الأهمية النسبية) / أُسّ عَشْرِيّ, رُتْبَة مِقْدَارِيَّة (رقم مخصص لنسبة كميتين؛ تكون كميتان من نفس الرتبة المقدارية إذا كانت إحداهما أقل من 10 أضعاف الأخرى)\nمثال: حاولوا التنبؤ بمقدار الانفجار",
 "magnitude relation": "عَلَاقَة كَمِّيَّة, عَلَاقَة مِقْدَارِيَّة (علاقة بين المقادير)",
 "magnolia": "مَغْنُولِيَة",
 "magnolia acuminata": "شجرة الخيار, ماغنوليا مستدقة (ماغنوليا أمريكية متساقطة الأوراق ذات أوراق كبيرة وثمار تشبه خياراً صغيراً)",
 "magnolia fraseri": "شجرة المظلة أذينية الأوراق, ماغنوليا فريزر (شجرة صغيرة منتصبة متساقطة الأوراق بأوراق كبيرة في تشكيلات ملفوفة عند أطراف الفروع)",
 "magnolia grandiflora": "ماغنوليا جنوبية, ماغنوليا كبيرة الأزهار (شجرة دائمة الخضرة في جنوب الولايات المتحدة ذات أوراق لامعة صلبة كبيرة وزهور بيضاء ضخمة حلوة الرائحة)",
 "magnolia macrophylla": "ماغنوليا كبيرة الأوراق (شجيرة كبيرة متساقطة الأوراق أو شجرة في جنوب شرق الولايات المتحدة ذات أوراق ضخمة في دوامات كاذبة كثيفة وزهور كريمية كبيرة مشوبة بالأرجواني نحو القاعدة)",
 "magnolia soulangiana": "ماغنوليا صحنية, ماغنوليا صينية (شجيرة كبيرة متساقطة الأوراق أو شجرة صغيرة ذات زهور وردية إلى أرجوانية مفتوحة كبيرة؛ موطنها آسيا؛ تقدر كنبات زينة في شرق أمريكا الشمالية)",
 "magnolia stellata": "ماغنوليا نجمية (ماغنوليا شجيرية متساقطة الأوراق من اليابان ذات زهور بيضاء عطرية تشبه النجوم تتفتح قبل أن تنبسط الأوراق؛ تزرع كنبات زينة في الولايات المتحدة)",
 "magnolia tripetala": "شجرة المظلة, ماغنوليا ثلاثية البتلات (شجرة صغيرة متساقطة الأوراق في شرق أمريكا الشمالية ذات زهور بيضاء كريمية وأوراق كبيرة في تشكيلات تشبه المظلات عند أطراف الفروع)",
 "magnolia virginiana": "غار حلو, ماغنوليا فرجينيا (شجيرة أو شجرة صغيرة ذات زهور بيضاء عطرية صغيرة نوعاً ما؛ وفيرة في جنوب شرق الولايات المتحدة)",
 "magnoliid dicot family": "فصيلة الماغنوليات, فصيلة ثنائيات الفلقة الماغنولية (فصيلة من النباتات المزهرة ثنائية الفلقة تُعتبر من بين أكثر كاسيات البذور بدائية الموجودة حالياً)",
 "magnoliid dicot genus": "جنس من ذوات الفلقتين المغنولية (جنس من النباتات المزهرة ثنائية الفلقة، تُعتبر من أكثر كاسيات البذور الحية بدائية)",
 "magnoliopsid": "ثنائي الفلقة, نبات ذو فلقتين (نبات زهري له فلقتان؛ ينمو الساق عن طريق التراكم على سطحه الخارجي)",
 "magnoliopsid family": "فصيلة ثنائيات الفلقة, فصيلة ذوات الفلقتين (فصيلة من النباتات المزهرة تمتلك فلقتين (أوراق جنينية) في البذرة تظهر عادة عند الإنبات)",
 "magnoliopsid genus": "جنس من ذوات الفلقتين (جنس من النباتات المزهرة التي تحتوي بذورها على فلقتين (أوراق جنينية) تظهر عادة عند الإنبات)",
 "magnum": "ماغنوم (زجاجة نبيذ كبيرة للمشروبات الكحولية)",
 "magnum opus": "التحفة الكبرى, العمل العظيم (عمل فني أو أدبي عظيم)",
 "magnus hitch": "عقدة ماغنوس (عقدة انزلاقية تشبه العقدة الوتدية)",
 "magpie": "عَقْعَق",
 "maguey": "كانتالا, ماغوي (نبات فلبيني ينتج أليافاً صلبة تستخدم في صنع الخيوط الخشنة) / ماغوي (نبات مكسيكي يستخدم خاصة لصنع البولكي وهو مصدر لمشروب المسكال المكسيكي عديم اللون)",
 "magus": "مُوغِيّ, مَجُوس",
 "magyar": "مَجَرِيٌّ, مَاغْيَار",
 "mah-jongg": "ماجونغ (لعبة صينية يلعبها 4 أشخاص بـ 144 بلاطة)",
 "maha": "أوماها (فرد من الشعب السيوي الذي عاش سابقاً في وادي نهر ميسوري في شمال شرق نبراسكا)",
 "maha-yuga": "ماها يوغا (ماها يوغا هي وحدة زمنية هندوسية)\nمثال: دورة كاملة واحدة من أربع يوغا هي ماها يوغا واحدة (4.32 مليون سنة شمسية)",
 "mahabharata": "هاستينابورا (إحدى الملحمتين الهندوسيتين الكلاسيكيتين؛ مجموعة ضخمة من الشعر تدور حول سرد بطولي مركزي)",
 "mahagua": "لحاء كوبي, ماهو أزرق (شجرة غابات منتصبة في كوبا وجامايكا ذات أوراق مشعرة بشكل متباين وزهور برتقالية صفراء أو برتقالية حمراء؛ تنتج خشباً متوسط الكثافة لأعمال الخزائن…) / ماجاجوا, ماهو (شجرة شجيرية واسعة الانتشار على طول الشواطئ الاستوائية؛ تنتج خشباً خفيفاً متيناً يستخدم لركائز الزوارق وأليافاً تستخدم للحبال والسد؛ تزرع غالباً للزينة)",
 "maharaja": "مَاهَارَاجَا",
 "maharajah": "مهراجا (راجا عظيم؛ أمير أو ملك هندوسي في الهند برتبة أعلى من راجا)",
 "maharanee": "مهاراني (راني عظيمة؛ أميرة في الهند أو زوجة مهراجا)",
 "maharani": "مهاراني (راني عظيمة؛ أميرة في الهند أو زوجة مهراجا)",
 "maharashtra": "مَاهَارَاشْتْرَا",
 "mahatma": "مهاتما ((في الهندوسية) مصطلح احترام لحكيم من البراهمة)",
 "mahayana": "بوذية الماهايانا, ماهايانا (واحدة من مدرستين عظيمتين للعقيدة البوذية تؤكدان على البحث المشترك عن الخلاص العالمي خاصة من خلال الإيمان وحده؛ الدين السائد في الصين والتبت واليابان) / ماهايانا (مدرسة رئيسية في البوذية تُعَلِّم الاهتمام الاجتماعي والخلاص الشامل؛ تمارس في الصين واليابان والتبت ونيبال وكوريا ومنغوليا)",
 "mahayana buddhism": "بوذية الماهايانا, ماهايانا (واحدة من مدرستين عظيمتين للعقيدة البوذية تؤكدان على البحث المشترك عن الخلاص العالمي خاصة من خلال الإيمان وحده؛ الدين السائد في الصين والتبت واليابان)",
 "mahayanism": "ماهايانا (العقيدة الدينية لبوذية الماهايانا (المركبة الكبرى))",
 "mahayanist": "بُوذِيّ (ماهايانا) (معتنق لبوذية الماهايانا)",
 "mahayuga": "ماها يوغا (ماها يوغا هي وحدة زمنية هندوسية)\nمثال: دورة كاملة واحدة من أربع يوغا هي ماها يوغا واحدة (4.32 مليون سنة شمسية)",
 "mahdi": "اَلْمَهْدِيُّ",
 "mahdism": "مهدوية (الإيمان بظهور المهدي؛ التفاني للمهدي)",
 "mahdist": "مَهْدِيّ (معتنق للمهدية (خاصة في السودان))",
 "mahernia verticillata": "جرس العسل, هيرمانيا (شجيرة أفريقية ذات سيقان منبطحة وأزهار صفراء نحيلة برائحة العسل إما مفردة أو في أزواج)",
 "mahican": "لغة الموهيكان, ماهيكان (لغة ألغونكوية يتحدث بها شعب الموهيكان) / موهيكان (فرد من شعب ألغونكي عاش سابقاً في وادي هدسون وشرقاً حتى نهر هوساتونيك)",
 "mahican language": "لغة الموهيكان, ماهيكان (لغة ألغونكوية يتحدث بها شعب الموهيكان)",
 "mahimahi": "سمكة الدلفين, ماهي ماهي (سمكة غذائية ورياضية نحيلة كبيرة واسعة الانتشار في البحار الدافئة (خاصة حول هاواي)) / سمك الدلفين, ماهي ماهي (اللحم قليل الدهن لسمكة مياه مالحة توجد في المياه الدافئة (خاصة في هاواي))",
 "mahjong": "مَا جُونْغ (انظر مَا)\nمثال: هلا! ما الجديد؟",
 "mahleb": "مَحْلَب",
 "mahlstick": "عصا الرسام, مِسند اليد (عصا طويلة يستخدمها الرسام لدعم اليد التي تمسك الفرشاة)",
 "mahmud": "مَحْمُود",
 "mahoe": "لحاء كوبي, ماهو أزرق (شجرة غابات منتصبة في كوبا وجامايكا ذات أوراق مشعرة بشكل متباين وزهور برتقالية صفراء أو برتقالية حمراء؛ تنتج خشباً متوسط الكثافة لأعمال الخزائن…) / ماجاجوا, ماهو (شجرة شجيرية واسعة الانتشار على طول الشواطئ الاستوائية؛ تنتج خشباً خفيفاً متيناً يستخدم لركائز الزوارق وأليافاً تستخدم للحبال والسد؛ تزرع غالباً للزينة)",
 "mahogany": "مَاهُوجَنِي",
 "mahogany tree": "شجرة الماهوجني, ماهوجني (أي من أشجار الخشب الاستوائية المتنوعة من الفصيلة الأزدرختية وخاصة جنس سويدانية، ذات قيمة لخشبها الصلب المصفر إلى البني المحمر الذي يسهل تشكيله ويأخذ…)",
 "mahogany-red": "بُنِّيّ مُحْمَرّ (بني مع مسحة حمراء)",
 "mahonia aquifolium": "عنب أوريغون, ماهونيا (شجيرة زينة دائمة الخضرة من ساحل المحيط الهادئ لأمريكا الشمالية ذات أوراق خضراء داكنة ريشية وعناقيد من الزهور الصفراء تليها حبات توت زرقاء سوداء)",
 "mahonia nervosa": "عنب أوريغون, ماهونيا عصبية (شجيرة صغيرة ذات أوراق خضراء رمادية وأزهار صفراء تليها حبات توت زرقاء شاحبة)",
 "mahoran": "مايوتي",
 "mahout": "سَائِسُ فِيل",
 "mahr": "مَهْر, صَدَاق",
 "mahratta": "ماراثي (عضو في شعب في الهند يعيش في ماهاراشترا)",
 "mahratti": "المراثية (لغة هندية؛ لغة ولاية ماهاراشترا في غرب وسط الهند؛ مكتوبة بخط الديوناكري)",
 "mahratti language": "المراثية (لغة هندية؛ لغة ولاية ماهاراشترا في غرب وسط الهند؛ مكتوبة بخط الديوناكري)",
 "mahua": "مَهْوَا",
 "mahuang": "إيفيدرا صينية, ماهوانغ (إيفيدرا صينية تنتج الإيفيدرين)",
 "maia": "مَايَا",
 "maianthemum bifolium": "زنبق الوادي الكاذب (نبات صغير أبيض الزهر من غرب أوروبا إلى اليابان)",
 "maianthemum canadense": "زنبق الوادي الكاذب الكندي (عشبة صغيرة ذات ورقتين من شمال الولايات المتحدة وأجزاء من كندا ذات عناقيد من الزهور البيضاء العطرة الصغيرة)",
 "maid": "خَادِمَة, خَدامَة",
 "maid of honor": "وصيفة العروس (امرأة غير متزوجة ترافق العروس في حفل الزفاف)",
 "maidan": "مَيْدَان",
 "maiden": "جَارِيَة, فَتَاة (مؤنث جَارِي؛ السفينة لأنها تجري في البحر)\nمثال: التحضيرات جارية على قدم وساق.",
 "maiden aunt": "خالة عزباء, عمة عزباء (عمة أو خالة غير متزوجة)",
 "maiden blue-eyed mary": "كولينسيا صغيرة الأزهار, ماري زرقاء العيون الصغيرة (نبات غربي صغير واسع التفرع بأزهار زرقاء وبيضاء دقيقة؛ كولومبيا البريطانية إلى أونتاريو وجنوباً إلى كاليفورنيا وكولورادو)",
 "maiden flight": "رحلة أولى, طلعة جوية أولى (أول رحلة من نوعها)\nمثال: قامت قاذفة الشبح برحلتها الأولى في عام 1989"
}
