 "lip rouge": "أحمر الشفاه (مكياج يستخدم لتلوين الشفاه)",
 "lip service": "مجاملة كاذبة, نفاق (تعبير عن الموافقة غير مدعوم بقناعة حقيقية)",
 "lip sync": "تزامن الشفاه, مواءمة الشفاه (الجمع بين التسجيل الصوتي والمرئي بحيث يتزامن الصوت تمامًا مع الفعل الذي أنتجه؛ خاصة مزامنة حركات شفتي المتحدث مع صوت كلامه)",
 "lip synch": "تزامن الشفاه, مواءمة الشفاه (الجمع بين التسجيل الصوتي والمرئي بحيث يتزامن الصوت تمامًا مع الفعل الذي أنتجه؛ خاصة مزامنة حركات شفتي المتحدث مع صوت كلامه)",
 "lip synchronisation": "تزامن الشفاه, مواءمة الشفاه (الجمع بين التسجيل الصوتي والمرئي بحيث يتزامن الصوت تمامًا مع الفعل الذي أنتجه؛ خاصة مزامنة حركات شفتي المتحدث مع صوت كلامه)",
 "lip synchronization": "تزامن الشفاه, مواءمة الشفاه (الجمع بين التسجيل الصوتي والمرئي بحيث يتزامن الصوت تمامًا مع الفعل الذي أنتجه؛ خاصة مزامنة حركات شفتي المتحدث مع صوت كلامه)",
 "lip-gloss": "ملمع الشفاه (مكياج يجعل الشفاه لامعة)",
 "lip-shaped": "شَفَوِيّ الشَّكْل (على شكل شَفة)",
 "lipaemia": "شحمية الدم, فرط شحميات الدم (وجود الدهون الزائدة في الدم)",
 "liparis": "ليباريس (أوركيد من جنس ليباريس ذو أوراق قليلة وزهور خضراء مصفرة أو أرجوانية باهتة صغيرة نوعاً ما عادة في عناقيد طرفية)",
 "liparis liparis": "سمكة الحلزون (أسماك صغيرة تشبه الشرغوف تعيش في المياه الباردة مع زعانف حوضية تشكل ممصاً؛ مرتبطة بسمكة الكتل)",
 "liparis loeselii": "أوركيد المستنقعات (أوركيد أرضي صغير في شرق أمريكا الشمالية وأوروبا له ورقتان قاعديتان تقريباً وزهور عنقودية خضراء مصفرة باهتة)",
 "lipase": "ليباز (إنزيم يفرز في الجهاز الهضمي يحفز تكسير الدهون إلى أحماض دهنية فردية يمكن امتصاصها في مجرى الدم)",
 "lipectomy": "استئصال الشحم (جراحة تجميلية تتضمن تفتيت وإزالة الأنسجة الدهنية)",
 "lipemia": "شحمية الدم, فرط شحميات الدم (وجود الدهون الزائدة في الدم)",
 "lipetsk": "لِيبِيتْسْك",
 "lipfern": "سرخس الشفة (أي من السراخس الأرضية المتنوعة من جنس كيلانثس؛ عالمي الانتشار في المناطق القاحلة وشبه القاحلة المعتدلة أو الاستوائية)",
 "lipid": "لِيبِيد, دُهْنِيَّة",
 "lipid granulomatosis": "داء الورم الأصفر, ورم أصفر متعدد (أورام صفراء منتشرة (خاصة على المرفقين والركبتين)؛ ترتبط غالبًا باضطراب في استقلاب الدهون)",
 "lipid-lowering medication": "دواء خافض للدهون, ستاتين",
 "lipid-lowering medicine": "دواء خافض للدهون, ستاتين",
 "lipidaemia": "شحمية الدم, فرط شحميات الدم (وجود الدهون الزائدة في الدم)",
 "lipide": "دهون, ليبيد (مركب عضوي زيتي غير قابل للذوبان في الماء ولكنه قابل للذوبان في المذيبات العضوية؛ مكون هيكلي أساسي للخلايا الحية (إلى جانب البروتينات والكربوهيدرات))",
 "lipidemia": "شحمية الدم, فرط شحميات الدم (وجود الدهون الزائدة في الدم)",
 "lipidosis": "داء اختزان الدهون, شحامة (اضطراب في استقلاب الدهون؛ تتراكم مستويات غير طبيعية من دهون معينة في الجسم)",
 "lipitor": "أتورفاستاتين, ليبيتور",
 "lipizzan": "ليبيزان (حصان ركوب مدمج وقوي يتم تربيته وتدريبه في فيينا؛ ذكي ومطيع وممتاز للترويض)\nمثال: يولد الليبيزان أسود أو بنياً ولكنه يتحول إلى الأبيض بحلول سن الخامسة",
 "lipless": "بلا شفة (بدون شفة أو شفاه)",
 "liplike": "شَبِيهٌ بِالشَّفَة, شَفَوِيّ (لَهُ شِفَاهٌ أَوْ أَجْزَاءٌ تُشْبِهُ الشِّفَاه)",
 "lipo-hepin": "هيبارين (عديد السكاريد ينتج في الخلايا القاعدية (خاصة في الرئة والكبد) ويثبط نشاط الثرومبين في تخثر الدم؛ يستخدم (الأسماء التجارية ليبو-هيبين وغيرها) كمضاد…)",
 "lipo-lutin": "بروجسترون (هرمون ستيرويدي ينتج في المبيض؛ يجهز ويحافظ على الرحم للحمل)",
 "lipochondrodystrophy": "متلازمة هيرلر (مرض وراثي (متنحي) يتمثل في خطأ في استقلاب عديدات السكاريد المخاطية؛ يتميز بتشوهات شديدة في تطور الغضروف الهيكلي والعظام والتخلف العقلي)",
 "lipogram": "حذف (حَذَفَ الشّيء:قطعه وأَسْقَطَه. حَذَفَ الْمُرَاجِعُ عِبَارَةً منَ الْخِطَابِ؛ حَذَفَهُ بِالعَصَا: ضَرَبَهُ ، ورَمَاهُ بِها)\nمثال: حذف ياني حسابه.",
