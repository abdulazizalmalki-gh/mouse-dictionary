 "lenten": "صومي, متعلق بالصوم الكبير (من أو متعلق أو مناسب للصوم الكبير)\nمثال: طعام صومي",
 "lenten rose": "خربق مشرقي, وردة الصوم (نبات معمر مشعر قليلاً له أوراق جلدية خضراء داكنة وأزهار تصبح في النهاية خضراء أرجوانية)",
 "lententide": "الصوم الكبير (فترة من 40 يومًا (باستثناء أيام الآحاد) من أربعاء الرماد إلى سبت النور)",
 "lentic": "رَاكِد (يتعلق بـ أو يعيش في المياه الساكنة (مثل البحيرات أو البرك))",
 "lenticel": "عديسة (واحدة من العديد من المسام البارزة على سيقان النباتات الخشبية التي تسمح بتبادل الغازات بين الغلاف الجوي والأنسجة الداخلية)",
 "lenticular": "عَدَسِيّ, مُحَدَّبُ الوَجْهَيْنِ (مُحَدَّب مِنْ كِلَا الجانِبَيْنِ؛ بِشَكْلِ العَدَسَة)",
 "lenticular nucleus": "نواة عدسية (عقدة قاعدية على شكل عدسة تشمل البطامة الخارجية المحمرة والشاحبة الداخلية الصفراء الشاحبة)",
 "lentiform": "عَدَسِيّ, مُحَدَّبُ الوَجْهَيْنِ (مُحَدَّب مِنْ كِلَا الجانِبَيْنِ؛ بِشَكْلِ العَدَسَة)",
 "lentiform nucleus": "نواة عدسية (عقدة قاعدية على شكل عدسة تشمل البطامة الخارجية المحمرة والشاحبة الداخلية الصفراء الشاحبة)",
 "lentiginose": "مُنَمَّش (مغطّى بالنمش أو يُشبهه)",
 "lentiginous": "مُنَمَّش (مغطّى بالنمش أو يُشبهه)",
 "lentigo": "نمش (بقعة بنية صغيرة (من صبغة الميلانين) على الجلد)",
 "lentil": "عَدَس (عَدَس)\nمثال: أعدت سلطة العدس.",
 "lentil plant": "عدس, نبات العدس (عشب حولي أوراسي يزرع على نطاق واسع لبذوره المسطحة الصالحة للأكل التي تطهى مثل البازلاء أو تطحن لتصبح دقيقاً، ولسيقانه الورقية التي تستخدم كعلف)",
 "lentil soup": "شوربة العدس (مصنوع من المرق والعدس مع البصل والجزر والكرفس)",
 "lentinus edodes": "شيتاكي (فطر شرق آسيوي صالح للأكل له قبعة ذهبية أو بنية داكنة إلى سوداء وساق غير صالح للأكل)",
 "lentinus lepideus": "لينتينوس حرشفي (فطر بقبعة حرشفية ولحم أبيض وحلقة على الساق (مع قشور أسفل الحلقة)؛ رائحة تذكرنا بعرق السوس)",
 "lentisk": "شجرة المصطكى, ضرو (شجيرة دائمة الخضرة من منطقة البحر الأبيض المتوسط تزرع لراتنجها)",
 "lentissimo": "لِينْتِيسِيمُو ((في الإيقاع الموسيقيّ) بَطِيء جِدًّا)",
 "lento": "ببطء (في الموسيقى (لينتو)) / لِينْتُو ((في الإيقاع الموسيقيّ) بَطِيء)\nمثال: اعزف هذا ببطء من فضلك",
 "leo": "بُرْج الْأَسَد, الْأَسَد (ظهر وارتفع)\nمثال: وصل كارل إلى برج آخر.",
 "leon": "لِيُون / لِيُونَة",
 "leonardesque": "ليوناردي (على طريقة ليوناردو دافنشي)",
 "leonberg": "ليونبرغر (كلب كبير (عادة بمعطف ذهبي) ناتج عن تهجين سانت برنارد ونيوفاوندلاند)",
 "leoncita": "طمارين, قرد الأسد (مارموسيت صغير من أمريكا الجنوبية ذو فراء حريري وذيل طويل غير قابض)",
 "leone": "ليون (وحدة المال الأساسية في سيراليون؛ تساوي 100 سنت)",
 "leonine": "أسدي (مكون من أو مميز لـ أو يشبه الأسد)",
 "leonotis leonurus": "داغا, ذيل الأسد (عشب جنوب أفريقي غير سام نسبياً يدخن مثل التبغ)",
 "leonotis nepetaefolia": "أذن الأسد (عشب استوائي عالمي له دوامات من الزهور ذات الشفاه المميزة؛ مستوطن في الولايات المتحدة)",
 "leonotis nepetifolia": "أذن الأسد (عشب استوائي عالمي له دوامات من الزهور ذات الشفاه المميزة؛ مستوطن في الولايات المتحدة)",
 "leontocebus oedipus": "طمارين ذو العرف (طمارين من أمريكا الجنوبية ذو رأس متوج)",
 "leontocebus rosalia": "طمارين حريري (قرد ذهبي من أمريكا الجنوبية ذو شعر طويل ناعم يشكل عرفاً)",
 "leontodon autumnalis": "هندباء الخريف (عشبة أوروبية تزهر في الخريف بزهرة صفراء؛ متوطنة في الولايات المتحدة)",
 "leontopodium alpinum": "إديلويس, رجل الأسد الألبية (نبات معمر ألبي موطنه أوروبا له أوراق مغطاة بزغب مبيض ورؤوس زهرية صغيرة مثبتة في نجوم من القنابات البيضاء اللامعة)",
 "leonurus cardiaca": "ذنب الأسد القلبي, عشبة الأم (عشب مر من العالم القديم في الأسيجة وحواف الغابات له أوراق مسننة وأزهار بيضاء أو وردية باهتة)",
 "leopard": "نِمْر (النّمر: حيوان مرقّط يُشبه الأَسَد؛ النّمر: لونه أنمر، وفيه نُمر حمراء أو بيضاء وسوداء) / نَمِر (النّمر: حيوان مرقّط يُشبه الأَسَد؛ النّمر: لونه أنمر، وفيه نُمر حمراء أو بيضاء وسوداء) / فَهْد\nمثال: دخل نمر مخيمنا.",
 "leopard cat": "قط نمر (قط بري صغير مرقط يعيش في جنوب آسيا وماليزيا)",
 "leopard frog": "ضفدع النمر (ضفدع أخضر أو بني شائع في أمريكا الشمالية له بقع بيضاوية داكنة ذات حواف بيضاء)",
 "leopard lily": "زنبق التوت, زنبق النمر (نبات حديقة تكشف كبسولته عند النضج عن كتلة من البذور تشبه التوت الأسود) / زنبق الصنوبر, زنبق النمر (زنبق من جنوب شرق الولايات المتحدة له زهور كأسية الشكل ببتلات منحنية صفراء عميقة إلى قرمزية) / زنبق النمر (زنبق من غرب الولايات المتحدة له زهور برتقالية حمراء إلى قرمزية منقطة بالمارون)",
 "leopard lizard": "سحلية نمرية (أي من عدة سحالي كبيرة ذات بقع داكنة عديدة؛ من غرب الولايات المتحدة وشمال المكسيك)",
 "leopard plant": "ليغولاريا, نبات النمر (أي من النباتات المتنوعة في أوراسيا المعتدلة؛ تزرع لزهورها الصفراء وأوراقها الجميلة)",
 "leopard's-bane": "خانق النمر, دورونيكم",
 "leopardbane": "خانق النمر, دورونيكم",
 "leopardess": "أنثى النمر (أنثى النمر)",
 "leopardsbane": "دَرَوْنَج",
 "leopardus pardalis": "أصلوت (قط بري ليلي يعيش في أمريكا الوسطى والجنوبية ذو معطف بني مصفر مرقط بالداكن)",
 "leotard": "بدلة رقص, جمبسوت ضيق (رداء ضيق من مادة مطاطية يغطي الجسم من الكتفين إلى الفخذين (أو الكاحلين)؛ يرتديه راقصو الباليه ولاعبو الأكروبات)",
 "leotards": "جوارب طويلة ضيقة, كولون (جوارب محبوكة ضيقة تغطي الجسم من الخصر إلى القدمين)",
 "leotia lubrica": "ليوتيا لوبريكا (فطر قرصي ينمو في مجموعات من الأجسام الثمرية الجيلاتينية المطاطية الزلقة ذات لون أصفر قذر إلى أسمر)",
 "lepas fascicularis": "برنقيل الإوز (برنقيل ذو ساق يلتصق بقيعان السفن أو الأخشاب العائمة)",
 "lepechinia calycina": "ليبيشينيا, ميرمية الجرة (نبات من كاليفورنيا بسيقان وأوراق صوفية وزهور بيضاء كبيرة)",
 "lepenism": "لُوبَانِيَّة",
 "leper": "أَبْرَص, أَجْذَم ((أَبْرَصَ) الرجل: ولد ولدا أبرص؛ (أَبْرَصَ) الله فلانا: أصابه بالبرص)",
 "leper lily": "رأس الثعبان, زهرة دجاج غينيا (زنبق متقلب أوراسي بأزهار متدلية عادة ما تكون معرقة ومتقلبة بالأرجواني أو الماروني على خلفية شاحبة وعلى شكل الأجراس التي كان يحملها مرضى الجذام في…)",
 "lepidium alpina": "بريتزيلاغو, رشاد الشامواه",
 "lepidium sativum": "رشاد الحديقة, رشاد مزروع (عشب حولي يستخدم كخضار للسلطة وللزينة)",
 "lepidobotrys": "ليبيدوبوتريس (شجرة أفريقية تصنف غالباً في فصائل أخرى؛ تشبه كاراكوليتو الكوستاريكية في بنية الخشب وكذلك في الثمار والزهور والأوراق والبذور)",
 "lepidochelys kempii": "لجأة أطلسية, لجأة كيمب (سلحفاة بحرية رمادية تعيش في سواحل المحيط الأطلسي والخليج في أمريكا الشمالية)",
 "lepidochelys olivacea": "لجأة المحيط الهادئ, لجأة زيتونية (سلحفاة بحرية زيتونية اللون تعيش في المحيط الهادئ الاستوائي والمحيط الهندي وجنوب المحيط الأطلسي)",
 "lepidocrocite": "ليبيدوكروشيت (معدن أحمر إلى بني محمر يتكون من هيدروكسيد أكسيد الحديد؛ يوجد غالباً في خامات الحديد مع الغوثيت)",
 "lepidocybium flavobrunneum": "إسكولار (ماكريل ثعباني كبير له حلقات تشبه النظارات حول عينيه)",
 "lepidolite": "ليبيدوليت (معدن من مجموعة الميكا؛ مصدر مهم لليثيوم)",
 "lepidomelane": "ليبيدوميلان (ميكا من نوع البيوتيت تحتوي على الحديد)",
 "lepidophobia": "رهاب الثعابين (خوف مرضي من الثعابين)",
 "lepidopteran": "حرشفيات الأجنحة (حشرة لها في حالة البلوغ أربعة أجنحة مغطاة بدرجة ما بحراشف صغيرة)",
 "lepidopterist": "عالم حرشفيات الأجنحة (عالم حشرات متخصص في جمع ودراسة الفراشات والعث)",
 "lepidopterologist": "عالم حرشفيات الأجنحة (عالم حشرات متخصص في جمع ودراسة الفراشات والعث)",
 "lepidopterology": "علم حرشفيات الأجنحة (فرع علم الحشرات الذي يتعامل مع رتبة حرشفيات الأجنحة (الفراشات والعث))",
 "lepidopteron": "حرشفيات الأجنحة (حشرة لها في حالة البلوغ أربعة أجنحة مغطاة بدرجة ما بحراشف صغيرة)",
 "lepidopterous insect": "حرشفيات الأجنحة (حشرة لها في حالة البلوغ أربعة أجنحة مغطاة بدرجة ما بحراشف صغيرة)",
 "lepidoptery": "علم حرشفيات الأجنحة (فرع علم الحشرات الذي يتعامل مع رتبة حرشفيات الأجنحة (الفراشات والعث))",
 "lepidote": "قِشْرِيّ, مُتَقَشِّر (مغطّى بقشور أو حراشف دقيقة)",
 "lepidothamnus fonkii": "ريمو تشيلي (من أكثر أنواع المعلاقية تحملاً؛ شجيرة مفترشة تشبه الريمو الجبلي؛ تتواجد في جبال جنوب تشيلي)",
 "lepidothamnus laxifolius": "ريمو جبلي (شجيرة منخفضة النمو إلى مفترشة ذات أغصان نحيلة زاحفة؛ موطنها نيوزيلندا)",
 "lepiota": "ليبيوتا (أي فطر من جنس ليبيوتا)",
 "lepiota americana": "مظلة أمريكية (غاريقون بقبعة شاحبة وساق متضخم بالقرب من القاعدة)",
 "lepiota cepaestipes": "ساق البصل (غاريقون أبيض يميل إلى التجمع وله قاعدة صولجانية الشكل)",
 "lepiota clypeolaria": "ليبيوتا درعية (غاريقون بساق خشن وقبعة صوفية ناعمة)",
 "lepiota morgani": "مظلة سامة (غاريقون يعتبر ساماً)",
 "lepiota naucina": "ليبيوتا نوسينا (غاريقون بجسم ثمري أبيض رمادي وخياشيم تتغير من الوردي إلى الأحمر القذر)",
 "lepiota procera": "فطر المظلة (فطر صالح للأكل طويل الساق بلحم أبيض وخياشيم وأبواغ؛ يوجد في الغابات المفتوحة في الخريف)",
 "lepiota rhacodes": "ليبيوتا راكودس (غاريقون بقبعة كبيرة ذات قشور بنية وساق سميك)",
 "lepiota rubrotincta": "ليبيوتا حمراء الصبغة (غاريقون بقبعة صغيرة نسبياً وردية إلى حمراء وخياشيم وساق بيضاء)",
 "lepisma saccharina": "سمكة الفضة (حشرة فضية رمادية غير مجنحة توجد في المنازل وتتغذى على أغلفة الكتب والملابس المنشاة)",
 "lepisosteus osseus": "خرم, سمكة الرمح (سمكة بدائية مفترسة في أمريكا الشمالية مغطاة بقشور صلبة ولها فكوك طويلة بأسنان تشبه الإبر)",
 "lepista irina": "كليتوسيب إيرينا (غاريقون صالح للأكل بقبعات بيضاء حريرية كبيرة وسيقان سميكة)",
 "lepomis gibbosus": "سمكة بذور اليقطين (سمكة شمس صغيرة زاهية الألوان في أمريكا الشمالية)",
 "lepomis macrochirus": "بلوجيل, خيشوم أزرق (سمكة شمس صالحة للأكل ومهمة في شرق ووسط الولايات المتحدة)",
 "lepomis punctatus": "سمكة الشمس المرقطة (تعيش في الجداول من كارولينا الجنوبية إلى فلوريدا؛ سمكة مقلاة محبوبة)",
 "leporid": "أرنبيات (الأرانب والأرانب البرية)",
 "leporid mammal": "أرنبيات (الأرانب والأرانب البرية)",
 "leporide": "أرنب بلجيكي (سلالة حمراء من الأرانب المستأنسة؛ هجين بين أرنب العالم القديم والأرنب البري)",
 "leporine": "أَرْنَبِيّ",
 "leppy": "عجل يتيم (عجل بلا أم في قطيع ماشية في المرعى)",
 "leprechaun": "لِيبْرِيكَان",
 "lepromatous leprosy": "جذام ورمي (شكل خطير جدًا من الجذام يتميز بآفات تنتشر على جزء كبير من الجسم وتؤثر على العديد من أجهزة الجسم)",
 "leprose": "قِشْرِيّ, مُتَقَشِّر (مغطّى بقشور أو حراشف دقيقة)",
 "leprosy": "جُذَام",
 "leprosy bacillus": "عصوية الجذام, متفطرة جذامية (مسبب مرض الجذام)",
 "leprous": "مَجْذُوم, أَبْرَص / جُذَامِيّ",
 "leptarrhena pyrolifolia": "كاسر الحجر جلدي الأوراق (نبات بأوراق بيضاوية جلدية قاعدية وسيقان زهرية منتصبة خالية من الأوراق تحمل كل منها عنقوداً دائرياً كثيفاً من الزهور البيضاء الصغيرة؛ الأماكن الرطبة…)",
 "leptinotarsa decemlineata": "خنفساء البطاطس كولورادو (خنفساء سوداء وصفراء تتغذى في مراحل البلوغ واليرقات على أوراق البطاطس؛ أصلها من جبال روكي الشرقية؛ الآن عالمية الانتشار)",
 "leptocephalus": "يرقة نحيفة الرأس (يرقة شفافة نحيلة لثعابين البحر وبعض الأسماك)",
 "leptodactylid": "ضفدع رقيق الأصابع (ضفادع مسننة: برية أو مائية أو شجرية)",
 "leptodactylid frog": "ضفدع رقيق الأصابع (ضفادع مسننة: برية أو مائية أو شجرية)",
 "leptodactylus pentadactylus": "ضفدع الثور الجنوب أمريكي (ضفدع مسنن كبير من أمريكا الجنوبية وأمريكا الوسطى يشبه ضفدع الثور)",
 "leptomeninges": "سحايا لينة (الطبقتان الداخليتان من السحايا؛ يدور السائل الدماغي الشوكي بين هاتين الطبقتين الداخليتين)",
 "leptomeningitis": "التهاب السحايا الرقيقة (التهاب السحايا الرقيقة (العنكبوتية والحنون))",
 "lepton": "لَبْتُون (جسيم أولي يشارك في التفاعلات الضعيفة؛ له عدد باريوني 0) / ليبتون (100 ليبتا تساوي 1 دراخما في اليونان)",
 "leptopteris superba": "ريشة أمير ويلز, سرخس الكريب (سرخس نيوزيلندي بسعف ريشي وسيقان صوفية كثيفة؛ يدرج أحياناً في جنس توديا)",
 "leptoptilus crumeniferus": "مارابو (لقلق أفريقي كبير أسود وأبيض آكل للجيف؛ يُستخدم ريش جناحه السفلي الزغبي لتزيين الملابس)",
 "leptoptilus dubius": "لقلق مساعد (لقلق هندي كبير ذو مشية عسكرية)",
 "leptorhine": "دقيق الأنف (ذو أنف ضيق طويل)",
 "leptorrhine": "دقيق الأنف (ذو أنف ضيق طويل)",
 "leptorrhinian": "دقيق الأنف (ذو أنف ضيق طويل)",
 "leptorrhinic": "دقيق الأنف (ذو أنف ضيق طويل)",
 "leptospira": "بريمية, ليبتوسبيرا (مسببات أمراض مهمة تسبب داء ويل أو حمى كانيكولا)",
 "leptospirosis": "داء البريميات",
 "leptosporangiate": "رقيق المباغ ((للسرخسيات) التي تتشكل فيها كل حافظة بوغية من خلية بشرة واحدة)\nمثال: سراخس رقيقة المباغ",
 "leptosporangium": "محفظة بوغية رقيقة (محفظة بوغية تتكون من خلية بشرة واحدة؛ مميزة للسرخسيات الرقيقة أو لجميع السراخس الحديثة تقريبًا)",
 "leptotene": "طور قلادي, لبتوتين (المرحلة الأولى من الطور التمهيدي للانقسام المنصف)",
 "leptotyphlops humilis": "ثعبان أعمى غربي (يحفر بين جذور الشجيرات وتحت الصخور في المناطق الصحراوية والتلال الصخرية ورمال الشواطئ في غرب الولايات المتحدة)",
 "lepus americanus": "أرنب حذاء الثلج (أرنب بري كبير ذو أقدام كبيرة من أمريكا الشمالية؛ أبيض في الشتاء)",
 "lepus arcticus": "أرنب قطبي (أرنب بري كبير من شمال أمريكا الشمالية؛ يكون أبيض بالكامل تقريباً في الشتاء)",
 "lepus californicus": "أرنب بري أسود الذيل (الأرنب البري الشائع في الأراضي العشبية والمناطق المفتوحة في غرب الولايات المتحدة؛ له آذان كبيرة سوداء الأطراف وشريط أسود على الذيل)",
 "lepus europaeus": "أرنب بري أوروبي (أرنب بري كبير أُدخل في أمريكا الشمالية؛ لا يتحول إلى الأبيض في الشتاء)",
 "lepus townsendi": "أرنب بري أبيض الذيل (أكبر أرنب بري في السهول الشمالية والجبال الغربية للولايات المتحدة؛ لونه بني رمادي في الصيف ورمادي شاحب في الشتاء؛ ذيله أبيض بالكامل تقريباً دائماً)",
 "ler": "لير (تجسيد للبحر؛ والد مانانان؛ يقابل لير الويلزي)",
 "leresis": "ثرثرة الشيخوخة (ثرثرة غير مترابطة (خاصة عند كبار السن))",
 "lernaean hydra": "هيدرا, هيدرا ليرنايان ((الأساطير اليونانية) وحش بتسعة رؤوس؛ كلما قطع رأس نبت مكانه اثنان جديدان)\nمثال: قتلت هيدرا على يد هرقل",
 "lerot": "زغبة الحدائق (زغبة من جنوب أوروبا وشمال أفريقيا)",
 "lesbian": "مِثْلِيّة, مِثْلِيّات / سِحَاقِيّ / سِحَاقِيَّة, لِيزْبِيَان",
 "lesbianism": "سِحَاق",
 "lesbos": "لسبوس, لزبوس",
 "lescol": "فلوفاستاتين, ليسكول (دواء ستاتين الأقل تكلفة (الاسم التجاري ليسكول)؛ يؤخذ عادة عن طريق الفم في وقت النوم)",
 "lese majesty": "خيانة الوطن, خيانة عظمى (جريمة تقوض حكومة الجاني)",
 "lesion": "آفة, إصابة (أي تغير هيكلي غير طبيعي موضعي في جزء من الجسم) / آفة, إصابة (إصابة في الأنسجة الحية (خاصة إصابة تنطوي على قطع أو كسر في الجلد))",
 "lesotho": "لِيسُوتُو",
 "lesotho monetary unit": "وحدة نقدية لليسوتو (الوحدة النقدية في ليسوتو)",
 "lespedeza": "برسيم الشجيرة, ليسبيديزا (نباتات شجيرية أو عشبية تستخدم على نطاق واسع للعلف وتحسين التربة وخاصة التبن في جنوب الولايات المتحدة)",
 "lespedeza bicolor": "ليسبيديزا ثنائية اللون (شجيرة آسيوية لها زهور عنقودية بارزة بلون وردي أرجواني، تستخدم على نطاق واسع كنبات زينة وفي مكافحة التعرية وكمصدر غذاء للطيور البرية)",
 "lespedeza cuneata": "ليسبيديزا حريرية (نبات معمر يزرع على نطاق واسع للعلف وكمحصول قش خاصة في الأراضي الفقيرة)",
 "lespedeza sericea": "ليسبيديزا حريرية (نبات معمر يزرع على نطاق واسع للعلف وكمحصول قش خاصة في الأراضي الفقيرة)",
 "lespedeza stipulacea": "ليسبيديزا كورية (نبات حولي موطنه كوريا ولكن يزرع على نطاق واسع للعلف والقش في المناطق الحارة والجافة)",
 "lespedeza striata": "برسيم ياباني, ليسبيديزا مخططة (نبات حولي من آسيا الاستوائية تم توطينه في الولايات المتحدة)",
 "less": "أَقَلّ / نَاقِص",
 "less than": "أَصْغَر مِن, صُغْرَى مِن",
 "less-traveled": "قَلِيل الارْتِيَاد (لا يزوره كثير من المسافرين)",
 "lessee": "مستأجر (مستأجر يحمل عقد إيجار)",
 "lessened": "مُتَضَاءِل, مُنْتَقَص (أُضعف بالتناقص أو التقليل) / مُخَفَّفُ الحِدَّة, مُقَلَّص (نَقَصَتْ شِدَّتُهُ؛ جُعِلَ أَقَلَّ قَسَاوَة)",
 "lessening": "انخفاض, تراجع (تغير نحو الأسفل)\nمثال: كان هناك انخفاض في درجة حرارته مع هدوء الحمى",
 "lesser": "أَصْغَر",
 "lesser anteater": "آكل نمل طوقي, تمندوة (آكل نمل صغير عديم الأسنان ذو ذيل قابض وأطراف أمامية ذات أربعة مخالب؛ من أمريكا الجنوبية الاستوائية وأمريكا الوسطى)",
 "lesser ape": "قرد أصغر (الجبون والسيامانج)",
 "lesser black-backed gull": "النَّوْرَس أَسْوَد الظَّهْر الصَغِير",
 "lesser bullrush": "بوط ضيق الأوراق (بوط من أمريكا، أوروبا، شمال أفريقيا، آسيا)",
 "lesser burdock": "أرقطيون شائع, أرقطيون صغير (نبات موجود في كل مكان ما عدا التربة شديدة الحموضة؛ يوجد في معظم أوروبا وشمال أفريقيا)",
 "lesser butterfly orchid": "أوركيد الفراشة الصغير (أوركيد جنوب أوروبي ذو زهور بيضاء مخضرة عطرة؛ يوضع أحياناً في جنس هابيناريا)",
 "lesser calamint": "بلسم الحقل, كالامينت صغير (عشب معمر عطري بقوة منخفض النمو من جنوب أوروبا إلى بريطانيا العظمى؛ تم توطينه في الولايات المتحدة)",
 "lesser celandine": "بقلة الخطاطيف الصغرى, حوذان التين (عشب معمر موطنه أوروبا ولكن تم توطينه في أماكن أخرى له أوراق على شكل قلب وزهور صفراء تشبه الحوذان؛ استخدمت جذوره الدرنية كلبخة لتخفيف البواسير)",
 "lesser centaury": "قنطريون صغير (نبات قنطريون حولي أملس شائع في أوروبا ذو زهور في نوارات كثيفة)",
 "lesser duckweed": "عدس الماء الشائع (من المناطق المعتدلة باستثناء شرق آسيا وأستراليا)",
 "lesser galangal": "خولنجان صغير (نبات صيني معمر ذو عناقيد هرمية من الزهور البيضاء وجذور عطرية لاذعة تستخدم طبياً وكنكهة)",
 "lesser hemlock": "بقدونس الأحمق, شوكران صغير (عشب أوروبي ضار استوطن أمريكا يشبه البقدونس ولكنه يسبب الغثيان والتسمم عند تناوله)",
 "lesser knapweed": "قنطريون أسود (نبات معمر عشبي بسيقان سلكية قوية وزهور أرجوانية؛ موطنه أوروبا ولكنه متوطن على نطاق واسع)",
 "lesser kudu": "كودو أصغر (نوع أصغر من الكودو)",
 "lesser of two evils": "أَهْوَنُ الشَّرَّيْنِ",
 "lesser omentum": "ثرب صغير (جزء من الصفاق متصل بالمعدة والكبد ويدعم الأوعية الكبدية)",
 "lesser panda": "باندا أحمر, باندا أصغر (حيوان لاحم شبيه بالراكون من العالم القديم لونه بني محمر؛ يُعتبر في بعض التصنيفات غير مرتبط بالباندا العملاقة)",
 "lesser peritoneal cavity": "تجويف بريتوني أصغر, جراب ثربي (جزء معزول من التجويف البريتوني يقع ظهرياً بالنسبة للمعدة)",
 "lesser prairie chicken": "دجاجة البراري الصغرى (دجاجة براري أصغر حجماً من غرب تكساس)",
 "lesser rhomboid muscle": "معينية صغرى (عضلة معينية تسحب لوح الكتف باتجاه العمود الفقري وإلى الأعلى قليلاً)",
 "lesser rorqual": "حوت المنك, حوت المنك الشمالي (حوت زعنفي صغير يعيش في المياه الساحلية للمحيط الأطلسي والهادئ)",
 "lesser scaup": "زرقاي صغير (بط غواص شائع في أمريكا الشمالية؛ الذكور لها رؤوس أرجوانية)",
 "lesser scaup duck": "زرقاي صغير (بط غواص شائع في أمريكا الشمالية؛ الذكور لها رؤوس أرجوانية)",
 "lesser spearwort": "حوذان لهيبي, سنانية صغرى (حوذان أوراسي معمر شبه مائي ذو أوراق تشبه الرماح؛ متوطن في نيوزيلندا)",
 "lesser twayblade": "توايبليد صغير (أوركيد له ورقتان مثلثتان وعنقود قصير رخو من الزهور الخضراء إلى بلون الصدأ مع شفة مشوبة باللون البنفسجي؛ أوروبا وآسيا وأمريكا الشمالية وجرينلاند)",
 "lesser whitethroat": "هازجة بيضاء الزور الصغرى (هازجة من العالم القديم تشبه الهازجة بيضاء الزور الكبرى ولكنها أصغر)",
 "lesser wintergreen": "وينترغرين صغير (الوينترغرين الشائع ذو عناقيد كثيرة الزهور من الزهور البيضاء المشوبة بالوردي؛ أوروبا وأمريكا الشمالية)",
 "lesser yellow trefoil": "نفل صغير, نفل مشكوك (نفل موطنه أيرلندا ذو أزهار مصفرة؛ غالباً ما يعتبر النفل الحقيقي أو الأصلي)",
 "lesser yellowlegs": "صفراء الساق الصغرى (نوع من طيور صفراء الساق، طائر شاطئي صغير في أمريكا الشمالية)",
 "lesson": "دَرْس, حِصَّة ((متعدٍّ بنفسه) عَلَّمَ، لَقَّنَ؛ اِمْتَهَنَ التَّعْلِيم) / دَرْس ((متعدٍّ بنفسه) عَلَّمَ، لَقَّنَ؛ اِمْتَهَنَ التَّعْلِيم) / عِبْرَة (الدَمْعَة قبل أن تفيض؛ المَشَاعِر العميقة الحزينة)\nمثال: أراك بعد الدرس.",
 "lessor": "مؤجّر (شخص يمنح عقد إيجار)",
 "lest": "خِيفَةَ أَنَّ, مَخَافَةَ أَن",
 "let": "سَمَحَ (يَسَّرَ وسَهَّلَ وهَيَّأَ لَهُ الأَمْرَ، جَعَلَه مُمْكِنًا. (يتعدى بالباء)؛ سَهُلَ) / دَعَّ (دَعَّ: دَعَّه يَدُعُّه دَعًّا: دَفَعَه فِي جَفْوة، وَدَعَّه دَفَعَه دَفْعاً عنِيفاً. وَفِي التَّنْزِيلِ: \"فَذلِكَ الَّذِي يَدُعُّ الْيَتِيمَ\"…)\nمثال: سمح لسكورة بالسباحة.",
 "let alone": "نَاهِيك",
 "let down": "أَنْزَلَ (فعل تعدّ من نَزَلَ؛ ضد أَصْعَدَ، جَعَله يَنْزِل أو وضعه في مكان سَفْل؛ الشخصَ في مكان: جعله يَنْزِل به، أي يُقِيم)\nمثال: أنزل سامي نافذته.",
 "let there be light": "لِيَكُنْ نُورٌ",
 "let's": "لِـ, هَيَّا (اللَّامُ هو الحرف الثالث والعشرون من حروف ٱلْهِجَاءِ، وهو مجهور متوسط…؛ يفيد التعليل الغرضي)",
 "let's go": "لِنَذْهَب, دَعْنَا نَذْهَب / هَيَّا (يستعمل لنداء البعيد) / يَااللّٰه\nمثال: هيا نصنع تجارة.",
 "letch": "شهواني, فاسق (رجل لديه رغبات جنسية قوية)",
 "letdown": "خذلان, خيبة أمل (شعور بعدم الرضا ينتج عندما لا تتحقق توقعاتك)\nمثال: كانت آماله عالية جداً لدرجة أنه كان محكوماً عليه بخيبة الأمل",
 "lethal": "مُمِيت",
 "lethal agent": "عامل قاتل, عامل مميت (عامل قادر على التسبب في الموت)",
 "lethal dose": "جرعة مميتة (حجم الجرعة التي تسبب الموت)",
 "lethal gene": "جين مميت (أي جين له تأثير يسبب موت الكائن الحي في أي مرحلة من مراحل الحياة)",
 "lethality": "إِمَاتَة, فَتْك (صفة كون الشيء مميتاً)",
 "lethargic": "خامل, فاتر (يفتقر إلى اليقظة أو النشاط)\nمثال: أصبحت الضفادع خاملة مع أول ليالي البرد",
 "lethargic encephalitis": "التهاب الدماغ السباتي, مرض النوم (التهاب دماغ كان وبائياً بين عامي 1915 و1926؛ تشمل الأعراض شلل عضلة العين الخارجية وضعف عضلي شديد)",
 "lethargically": "بخمول, بلا طاقة (بدون طاقة؛ بطريقة خاملة)\nمثال: تسكع في المنزل بخمول",
 "lethargy": "خُمُول",
 "leto": "ليتو",
 "letter": "حَرْف, حرف (طَرَف وَجَانِب وَحَدّ؛ رَمْز مخطوط أو مطبوع يقوم مقام صوت أو كلمة أو عبارة أو معنى) / رِسَالَة, مَكْتُوب\nمثال: ألف هو الحرف الأول للألف باء.",
 "letter bomb": "رسالة مفخخة, طرد مفخخ (جهاز متفجر رقيق داخل ظرف أو طرد وينفجر عند فتحه)",
 "letter bond": "سند مقيد (سند لم يتم تسجيله لدى لجنة الأوراق المالية والبورصات ولا يمكن بيعه للجمهور العام)",
 "letter box": "صندوق بريد (صندوق خاص لاستلام البريد) / صندوق بريد (صندوق عام لإيداع البريد) / صندوق بريد (حجرة مرقمة في مكتب بريد حيث يتم وضع البريد لاستلامه)",
 "letter carrier": "ساعي البريد (شخص يقوم بتوصيل البريد)",
 "letter case": "حافظة رسائل (حافظة لحمل الرسائل)",
 "letter of credit": "خطاب اعتماد (وثيقة يصدرها بنك تضمن دفع حوالة العميل؛ تستبدل ائتمان البنك بائتمان العميل)",
 "letter of intent": "خطاب نوايا (أي رسالة تعبر عن نية اتخاذ (أو التخلي عن) إجراء ما)",
 "letter of jeremiah": "رِسَالَة إِرْمِيَا",
 "letter of mark and reprisal": "خطاب تفويض (ترخيص لمواطن عادي للاستيلاء على سفن دولة أخرى وممتلكاتها)",
 "letter of marque": "خطاب تفويض (ترخيص لمواطن عادي للاستيلاء على سفن دولة أخرى وممتلكاتها)",
 "letter of the alphabet": "حرف, حرف أبجدي (الأحرف التقليدية للأبجدية المستخدمة لتمثيل الكلام)\nمثال: علمته جدته الحروف",
 "letter opener": "سكين ورق, فتاحة رسائل (سكين غير حاد يستخدم لفتح الأظرف التي تُرسل فيها الرسائل أو لشق صفحات الكتب غير المقطوعة)",
 "letter paper": "قرطاسية, ورق مراسلات (ورق مقصوص بحجم مناسب لكتابة الرسائل؛ عادة مع مظاريف مطابقة) / ورق رسائل (ورق كتابة للاستخدام في كتابة المراسلات)",
 "letter security": "ورقة مالية مقيدة (سهم أو سند غير مسجل لدى لجنة الأوراق المالية والبورصات ولا يمكن بيعه في السوق العامة)",
 "letter stock": "سهم مقيد (سهم لم يتم تسجيله لدى لجنة الأوراق المالية والبورصات ولا يمكن بيعه للجمهور العام)",
 "letter telegram": "برقية مؤجلة (شكل أرخص من البرقيات يرسل إلى الخارج للتسليم في اليوم التالي)",
 "letter writer": "كاتب رسائل, مراسل (شخص يتواصل عن طريق الرسائل)",
 "letter-perfect": "حَرْفِيّ, مُطَابِقٌ لِلنَّصّ (صَحِيحٌ حَتَّى آخِرِ تَفْصِيل؛ يَتْبَعُ الكَلِمَاتِ الأَصْلِيَّةَ بِدِقَّة)",
 "letterbox": "صُنْدُوق بَرِيد, صَنْدُوق بَرِيد (وعاء كبيرة من الخشب غالبا وقد يكون حديدًا يستخدم لوضع الاشياء داخله، ويكون لها عادة جهة قابلة للفتح سواء بمفاصل او بالازالة الكاملة؛ صُنْدُوْقُ السَيَّارَة قمرة تشبه الصندوق في الجزء الخلفي من السيارة يستخدم كالصندوق)\nمثال: أين صندوق البريد؟",
 "lettercard": "رسالة مطوية (بطاقة بريدية تُطوى بحيث تكون الرسالة في الداخل)",
 "lettered": "مُطَّلِع, وَاسِعُ الثَّقَافَة (على درجة عالية من التعليم؛ ذو معلومات أو فهم واسع)",
 "letterer": "خطاط, رسام حروف (رسام الحروف)",
 "letterhead": "ورق مروس (ورقة مراسلات مطبوع عليها اسم وعنوان المؤسسة في الأعلى)",
 "lettering": "كتابة, نقش (حروف منقوشة (خاصة الكلمات المحفورة أو المنحوتة) على شيء ما)",
 "letterman": "رياضي مدرسي متميز",
 "letterpress": "طباعة بارزة, لتربرس (الطباعة من لوح ذي أحرف بارزة)",
 "letters": "آداب, أدب (الثقافة الأدبية) / أدب, ثقافة أدبية (التحصيل العلمي والأدبي)\nمثال: يُظهر هذا الكتاب الأدب الأمريكي في أفضل حالاته",
 "letters of administration": "سند إدارة التركة (وثيقة قانونية تسمي شخصاً لإدارة تركة عندما لم يتم تسمية منفذ للوصية)",
 "letters of marque": "خطاب تفويض (ترخيص لمواطن عادي للاستيلاء على سفن دولة أخرى وممتلكاتها)",
 "letters patent": "براءة تمليك",
 "letters testamentary": "سند تنفيذ الوصية (وثيقة قانونية من محكمة الوصايا تبلغك بتعيينك منفذاً لوصية وتخولك بالقيام بتلك المسؤوليات)",
 "letterset printing": "ليترست (يتم نقل الصورة من لوح طباعة بارز إلى أسطوانة)",
 "letting": "عين مؤجرة, مأجور (الممتلكات التي يتم تأجيرها أو إكراؤها)",
 "letting down": "إنزال, خفْض (عملية التسبب في تحرك شيء ما إلى مستوى أدنى)",
 "lettish": "اللغة اللاتفية (اللغة الرسمية للاتفيا؛ تنتمي للفرع البلطيقي من الهندية الأوروبية)",
 "lettre de cachet": "خطاب مختوم (مذكرة كانت تصدر سابقاً عن ملك فرنسي تأمر بالسجن أو الموت في رسالة موقعة تحت ختمه)",
 "lettuce": "خَسّ (خَسَّ الرجُلُ يَخِسُّ خِسَّةً، وخَسَاسَةً: حَقُرَ؛ يقال: خَسَّ فِعْلُهُ وقولُه ورأْيُه)\nمثال: بيع المنزل بثمن بخس.",
 "letup": "فترة هدوء, هوداة (توقف تكون فيه الأمور هادئة أو الأنشطة متناقصة)\nمثال: لم يكن هناك أي هوداة في الضوضاء",
 "leu": "ليو (وحدة المال الأساسية في رومانيا) / ليو (وحدة المال الأساسية في مولدوفا)",
 "leucadendron argenteum": "شجرة الفضة (شجرة صغيرة من جنوب أفريقيا ذات أوراق حريرية فضية طويلة)",
 "leucaemia": "ابيضاض الدم, سرطان الدم (ورم خبيث في الأنسجة المكونة للدم؛ يتميز بتكاثر غير طبيعي للكريات البيض؛ أحد الأنواع الأربعة الرئيسية للسرطان)",
 "leucaena glauca": "شجرة الرصاص, ليوسينا (شجرة منخفضة شجيرية من المناطق الاستوائية وشبه الاستوائية في أمريكا الشمالية ذات أزهار بيضاء مشوبة بالأصفر تشبه الميموزا وقرون مسطحة طويلة)",
 "leucaena leucocephala": "شجرة الرصاص, ليوسينا (شجرة منخفضة شجيرية من المناطق الاستوائية وشبه الاستوائية في أمريكا الشمالية ذات أزهار بيضاء مشوبة بالأصفر تشبه الميموزا وقرون مسطحة طويلة)",
 "leucanthemum lacustre": "أقحوان البرانس (نبات معمر في البرتغال مشابه لأقحوان المروج)",
 "leucanthemum maximum": "أقحوان المروج, أقحوان عين الثور (مشابه لأقحوان المروج)",
 "leucanthemum superbum": "أقحوان شاستا (زهرة حديقة هجينة مشتقة من الأقحوان الأقصى والأقحوان البحيري ذات رؤوس زهور بيضاء كبيرة تشبه أقحوان المروج؛ توضع غالباً في جنس الأقحوان)",
 "leucanthemum vulgare": "أقحوان أبيض, أقحوان المروج (نبات أوراسي معمر طويل الساق ومورق بزهور بيضاء؛ متوطن على نطاق واسع)",
 "leucine": "ليوسين (حمض أميني بلوري أبيض يوجد في البروتينات وهو ضروري للتغذية؛ ويتم الحصول عليه عن طريق التحلل المائي لمعظم البروتينات الغذائية)",
 "leuciscus cephalus": "شوب (سمكة صيد أوروبية تعيش في المياه العذبة ذات جسم سميك مغزلي الشكل)",
 "leuciscus leuciscus": "ديس (سمكة مياه عذبة أوروبية صغيرة ذات جسم نحيل أزرق مخضر)",
 "leucocyte": "خلية دم بيضاء, كريّة دم بيضاء (خلايا دم تبتلع وتهضم البكتيريا والفطريات؛ جزء مهم من نظام دفاع الجسم)",
 "leucocytosis": "كثرة الكريات البيض (زيادة غير طبيعية في عدد خلايا الدم البيضاء في الدم نتيجة للعدوى)",
 "leucocytozoan": "ليوكوسيتوزون (طفيلية في الطيور)",
 "leucocytozoon": "ليوكوسيتوزون (طفيلية في الطيور)",
 "leucogenes leontopodium": "إديلويس الجزيرة الشمالية (عشب معمر يشبه إلى حد كبير الإديلويس الأوروبي؛ نيوزيلندا)",
 "leucoma": "بياض القرنية, سحابة القرنية (مرض عيني يتمثل في بقعة بيضاء معتمة على القرنية)",
 "leucopenia": "نقص الكريات البيض (انخفاض غير طبيعي في عدد خلايا الدم البيضاء)",
 "leucorrhea": "ثر أبيض, سيلان مهبلي أبيض (إفرازات مخاطية بيضاء من المهبل؛ غالباً ما تكون مؤشراً على وجود عدوى)",
 "leucothoe": "ليكوثي (أي نبات من جنس ليكوثي؛ تزرع لأزهارها البيضاء الجميلة؛ تحتوي الأوراق اللامعة على مادة سامة تشبه تلك الموجودة في جنس كالميا)",
 "leucothoe editorum": "غار الكلب (شجيرة دائمة الخضرة سريعة النمو من جنوب شرق الولايات المتحدة ذات فروع متشابكة مقوسة وعناقيد من الزهور البيضاء)",
 "leucothoe fontanesiana": "غار الكلب (شجيرة دائمة الخضرة سريعة النمو من جنوب شرق الولايات المتحدة ذات فروع متشابكة مقوسة وعناقيد من الزهور البيضاء)",
 "leucothoe racemosa": "أجراس حلوة (شجيرة نفضية كثيفة من شرق الولايات المتحدة مع عناقيد طويلة من الزهور الوردية)",
 "leucotomy": "بضع الفص, عملية الفص الجبهي (قطع جراحي للمسالك العصبية من وإلى الفص الجبهي للدماغ؛ غالباً ما يؤدي إلى تغيرات ملحوظة في الإدراك والشخصية)",
 "leukaemia": "ابيضاض الدم, سرطان الدم (ورم خبيث في الأنسجة المكونة للدم؛ يتميز بتكاثر غير طبيعي للكريات البيض؛ أحد الأنواع الأربعة الرئيسية للسرطان)",
 "leukemia": "سَرَطَان دَم",
 "leukeran": "كلورامبوسيل, لوكيرا (عامل مؤلكل (الاسم التجاري لوكيرا) يستخدم لعلاج بعض أنواع السرطان)",
 "leukocyte": "خلية دم بيضاء, كريّة دم بيضاء (خلايا دم تبتلع وتهضم البكتيريا والفطريات؛ جزء مهم من نظام دفاع الجسم)",
 "leukocytosis": "كثرة الكريات البيض (زيادة غير طبيعية في عدد خلايا الدم البيضاء في الدم نتيجة للعدوى)",
 "leukoderma": "بهق (حالة جلدية خلقية تتميز ببقع أو شرائط من الجلد غير المصبوغ)",
 "leukoencephalitis": "التهاب بيضاء الدماغ (التهاب المادة البيضاء في الدماغ)",
 "leukoma": "بياض القرنية, سحابة القرنية (مرض عيني يتمثل في بقعة بيضاء معتمة على القرنية)",
 "leukopenia": "نقص الكريات البيض (انخفاض غير طبيعي في عدد خلايا الدم البيضاء)",
 "leukorrhea": "ثر أبيض, سيلان مهبلي أبيض (إفرازات مخاطية بيضاء من المهبل؛ غالباً ما تكون مؤشراً على وجود عدوى)",
 "leukotomy": "بضع الفص, عملية الفص الجبهي (قطع جراحي للمسالك العصبية من وإلى الفص الجبهي للدماغ؛ غالباً ما يؤدي إلى تغيرات ملحوظة في الإدراك والشخصية)",
 "leuven": "لوفان",
 "lev": "لِيف",
 "levallorphan": "ليفالورفان (دواء (الاسم التجاري لورفان) مرتبط بالمورفين ولكنه يعاكس تثبيط التنفس الناتج عن التسمم بالمورفين ولكن دون التأثير على تأثيراته المسكنة)",
 "levant": "مَشْرِق, اَلْمَشْرِق اَلْعَرَبِيّ",
 "levant cotton": "قطن عشبي, قطن ليفانت (نبات حولي من العالم القديم بأوراق على شكل قلب وبذور كبيرة ذات وبر رمادي قصير يُزال بصعوبة؛ يعتبر سلفاً للأقطان الحديثة قصيرة التيلة)",
 "levant garlic": "ثوم المشرق, كراث بري (نبات معمر خشن من العالم القديم له بصلة كبيرة وساق طويل من زهور مخضرة مشوبة بالأرجواني؛ متوطن على نطاق واسع)",
 "levant morocco": "جلد المشرق, ليفانت (جلد مغربي ثقيل يستخدم غالباً في تجليد الكتب)",
 "levanter": "رياح المشرق (رياح شرقية في منطقة غرب البحر الأبيض المتوسط)",
 "levantine": "شَامِيّ",
 "levantine arabic": "لَهْجَات شَامِيَّة, شَامِيّ",
 "levantine sea": "بَحْر الشام, البَحْر الشامِي (شَقّ الأرض؛ التَحَيُّر والبَهْت من الفزع أو من شدة العَطَش فنظر لا يقصد شيئا)\nمثال: هبطت على البحر.",
 "levator": "عضلة رافعة (عضلة تعمل على رفع جزء من الجسم (مثل الجفن أو الشفة))",
 "levee": "رصيف نهري, سد مائي (ساتر ترابي يُبنى لمنع النهر من الفيضان) / رصيف نهري (رصيف يوفر مكاناً للرسو على نهر) / حفل استقبال ملكي, مجلس استقبال (استقبال رسمي للزوار أو الضيوف (كما في البلاط الملكي))",
 "level": "مُسْتَوًى / مَرْحَلَة",
 "level best": "أقصى, غاية (أقصى درجة ممكنة)\nمثال: بذل قصارى جهده",
 "level crossing": "تقاطع سكة حديد, مزلقان (تقاطع سكة حديد وطريق على نفس المستوى؛ تغلق الحواجز الطريق عند مرور القطارات)",
 "level to the ground": "سوّاه بالارض",
 "level-headed": "رَشِيد, سَدِيدُ الرَّأْي (يمارس الحكم السليم أو يُظهِره)",
 "leveler": "مساواتي (راديكالي يدعو إلى إلغاء التمايز الاجتماعي)",
 "levelheaded": "رَشِيد, سَدِيدُ الرَّأْي (يمارس الحكم السليم أو يُظهِره)",
 "levelheadedness": "اتزان, رجاحة العقل (خاصية امتلاك أو إظهار حكم سليم)\nمثال: إنه تقدير لرجاحة عقلها وقوتها أنها على الرغم من الحياة الغريبة التي لا يمكن تصورها بعد طفولتها، ظلت متماسكة ومخلصة لنفسها",
 "leveling": "تسوية, مساواة (فعل جعل الأشياء متساوية أو موحدة) / تسوية بالأرض, دك (التدمير الكامل لمبنى) / تسوية الأرض, تمهيد (تغيير مستوى الأرض إلى سطح أفقي أملس أو منحدر بلطف)",
 "leveller": "مساواتي (راديكالي يدعو إلى إلغاء التمايز الاجتماعي)",
 "levelness": "استواء (خاصية التواجد بنفس الارتفاع في جميع الأماكن؛ موازٍ لأرض مسطحة)\nمثال: فحص المفتش استواء الأرضية قبل الموافقة على العمل",
 "lever": "مُخْل / مُحْل (الهدي: الوقت الذي ينحر فيه؛ الدين: أجله والوقت الذي يوفى فيه) / عَتَلَة / رَافِعَة\nمثال: أغلق دان المحل.",
 "lever hang": "تعلق الرافعة (تعلق يُؤدى على الحلقات والجسم ثابت في وضع أفقي)",
 "lever lock": "قفل الرافعة (قفل تكون ريشه عبارة عن روافع يجب رفعها إلى موضع معين حتى يتمكن الترباس من التحرك)",
 "lever scale": "ميزان القبان, ميزان ذو ذراعين (ميزان محمول يتكون من قضيب محوري بأذرع غير متساوية الطول)",
 "lever tumbler": "رافعة القفل (ريشة قفل معدنية مسطحة في قفل الرافعة)",
 "leverage": "استدانة, روافع مالية (الاستثمار بأموال مقترضة كوسيلة لتضخيم المكاسب المحتملة (مع خطر حدوث خسائر أكبر)) / قُوَّة تَأْثِير, نُفُوذ (أفضلية استراتيجية؛ القدرة على التصرف بفاعلية) / قوة الرافعة, ميزة ميكانيكية (الميزة الميكانيكية المكتسبة من خلال التواجد في وضع يسمح باستخدام رافعة)\nمثال: يمكن للمجموعات الصغيرة نسبياً أن تمارس أحياناً نفوذاً سياسياً هائلاً",
 "leveraged buyout": "استحواذ بالدين (استحواذ باستخدام أموال مقترضة؛ عادة ما تكون أصول الشركة المستهدفة ضماناً للقرض)",
 "leveraging": "استدانة, روافع مالية (الاستثمار بأموال مقترضة كوسيلة لتضخيم المكاسب المحتملة (مع خطر حدوث خسائر أكبر))",
 "leveret": "خرنق (أرنب بري صغير خاصة في عامه الأول)",
 "levi": "لَاوِي / لاوي",
 "levi's": "ليفايز (علامة تجارية مشهورة للجينز)",
 "levi-lorrain dwarf": "قزم نخامي (قزم حالته ناتجة عن نقص هرمونات النمو، وليس عن عوامل وراثية (كما في حالة القزم الودروي))",
 "leviathan": "لَوِيَاثَان",
 "levirate": "زواج الأخ من أرملة أخيه (المؤسسة التوراتية حيث يجب على الرجل الزواج من أرملة أخيه الذي ليس له أطفال من أجل الحفاظ على نسل الأخ)",
 "levis": "ليفايز (علامة تجارية مشهورة للجينز)",
 "levisticum officinale": "كاشم, لوفاج (عشب موطنه جنوب أوروبا؛ يزرع لسيقانه وأوراقه وبذوره الصالحة للأكل)",
 "levitation": "ارتفاع بالروح, تحليق (فعل رفع (جسم) عن الأرض بوسائل روحانية مفترضة) / تحليق, طفو (حركة نحو الأعلى بحكم الخفة) / تحليق, طفو (ظاهرة ارتفاع شخص أو شيء في الهواء بوسائل تبدو خارقة للطبيعة)",
 "levite": "لاوي (عضو في قبيلة لاوي العبرية (وخاصة الفرع الذي قدم مساعدين ذكور لكهنة المعبد))",
