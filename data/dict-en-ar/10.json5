 "faceted": "ذو أوجه, مضلع\nمثال: ماسة ذات أوجه (أحد الأسماء الستة، لا يأتي إلا مُضَافًا، بمعنى صاحب)\nمثال: كان رجل ذو قامة طويله.",
 "facetious": "سَاخِر / طَرِيف",
 "facetiously": "على سبيل المزاح, مازحاً (ليس بجدية)\nمثال: قصدت ذلك مازحاً",
 "facetiousness": "دعابة, مزاح (فكاهة مرحة)",
 "facia": "لفافة (صفيحة أو شريط من النسيج الضام الليفي يفصل أو يربط العضلات والأعضاء معاً)",
 "facial": "تنظيف بشرة, علاج الوجه (عناية بالوجه تتضمن عادةً التنظيف والتدليك ووضع الكريمات التجميلية) / سطحي, وجهي (مكون من أو يخص السطح الخارجي لشيء ما) / وجهي (متعلق بالوجه) / عصب قحفي سابع, عصب وجهي (عصب قحفي يغذي عضلات الوجه)\nمثال: تدليك وجهي",
 "facial artery": "شريان فكي ظاهر, شريان وجهي (شريان ينشأ في السباتي الظاهر ويعطي فروعاً تغذي الرقبة والوجه)",
 "facial expression": "تعبير, ملامح (المشاعر الظاهرة على وجه الشخص) / تعبير وجهي (إيماءة تنفذ بواسطة عضلات الوجه)\nمثال: تعبير حزين",
 "facial gesture": "تعبير وجهي (إيماءة تنفذ بواسطة عضلات الوجه)",
 "facial hair": "شَعْرُ الوَجْه (الشعر الموجود على الوجه (خاصة وجه الرجل))",
 "facial index": "مُؤَشِّر الوَجْه (النسبة (بالنسبة المئوية) لأقصى عرض للوجه إلى أقصى ارتفاع له)",
 "facial muscle": "عضلة وجهية (أي من العضلات الهيكلية للوجه)",
 "facial nerve": "عصب قحفي سابع, عصب وجهي (عصب قحفي يغذي عضلات الوجه)",
 "facial profiling": "التحليل الوجهي, التنميط الوجهي (تحديد هوية المجرمين والإرهابيين عن طريق أشرطة الفيديو لوجوههم)\nمثال: التنميط الوجهي شكل جديد من أشكال أمن المطارات",
 "facial recognition": "التعرف على الوجه, التمييز الوجهي (تحديد هوية بيومتري عن طريق مسح وجه الشخص ومطابقته مع مكتبة من الوجوه المعروفة)\nمثال: استخدموا التعرف على الوجه لرصد الإرهابيين المعروفين",
 "facial tissue": "مناديل الوجه (ورق مناديل مناسب للاستخدام على الوجه)",
 "facial vein": "وريد وجهي (أي من عدة أوردة تصرف الوجه)",
 "facially": "في الوجه, وجهياً (فيما يتعلق بالوجه)",
 "facile": "بَلِيغ, طَلِيق اللِّسَان (يُعبِّر عن نفسه بسهولة ووضوح وفعاليّة) / سَلِس, يَسِير (يُؤدّي بمهارة ودون جهد) / أَنِيق ظَاهِرِيًّا, بَرَّاق (يبدو مؤثّرًا من السطح لكنّه يفتقر إلى العمق والدقّة)",
 "facilitate": "سَهَّلَ (ضد الصَعْب، اليَسِير. لا جمع له؛ الشيء المُمَهَّد اللَيِّن. لا جمع له)\nمثال: هذا الشعور سهل.",
 "facilitation": "تسهيل, تيسير (فعل المساعدة أو جعل تقدم شيء ما أو تحسينه أسهل) / تسهيل, تسهيل عصبي ((في الفسيولوجيا العصبية) ظاهرة تحدث عندما تتحد نبضتان عصبيتان أو أكثر لا تكفي إحداهما وحدها لإثارة استجابة في عصبون، لتؤدي معاً إلى إثارة جهد الفعل) / تسهيل, تيسير (حالة جعل الشيء سهلاً (أو أسهل))\nمثال: التيسير الاجتماعي هو حالة تكيفية",
 "facilitative": "تَسْهيلِيّ, مُيَسِّر (يُزيل العَقَبات ويُسَهِّل الأُمور)",
 "facilitator": "ميسّر (شخص يجعل التقدم أسهل)",
 "facilitatory": "تَنْشيطِيّ, مُحَفِّز (يُحَفِّز النَّشاط العَصَبِيّ ويُسَهِّلُه)",
 "facility": "مَرَافِق, مُنْشَأَة / سُهُولَة",
 "facing": "تبطين, تغليف (تزويد شيء بسطح من مادة مختلفة) / تكسية خارجية, كسوة (غطاء واقٍ يحمي الجزء الخارجي من المبنى) / بطانة الحافة, سجاف (بطانة تطبق على حافة الملابس للزينة أو التقوية) / تكسية, قشرة خارجية (طلاء زخرفي لمبنى)",
 "facing pages": "صفحتان متقابلتان (صفحتان متواجهتان في كتاب أو منشور آخر)",
 "facsimile": "جهاز فاكس, فاكس (ناسخة ترسل النسخة عن طريق السلك أو الراديو) / صورة طبق الأصل, فاكسيميلي (نسخة طبق الأصل أو استنساخ)",
 "facsimile machine": "جهاز فاكس, فاكس (ناسخة ترسل النسخة عن طريق السلك أو الراديو)",
 "fact": "مَعْلُومَة, حَقِيقَة",
 "fact mood": "الأُسْلُوب الخَبَرِيّ, صِيغَة خَبَرِيَّة (صيغة تمثل الفعل أو الحالة كحقيقة موضوعية)",
 "fact-finding": "تقصي الحقائق",
 "facticity": "وَاقِعِيَّة (مؤنث وَاقِعيّ، المنسوبة إلى الوَاقِع، حَقِيقِيَّة؛ اسم لحالة الموصوف بأنه وَاقِعيّ)\nمثال: يجب أن نكون أكثر واقعية؛",
 "faction": "فَرِيق, زَمْرَة (الطَائِفَة من الشيء المتفرق؛ الطَائِفَة من الناس، وهي أكثر من الفِرْقَة)\nمثال: لدينا فريق جيد.",
 "factious": "انْشِقَاقِيّ, مُثِيرٌ لِلفُرْقَةِ (مُعَارِضٌ (خَاصَّةً لِرَأْيِ الأَغْلَبِيَّةِ)؛ يُحْدِثُ الِانْقِسَامَ)",
 "factitious": "مُفْتَعَل (غير ناتج عن قوى طبيعية؛ مصنوع افتعالًا)",
 "factoid": "خبر صغير, معلومة تافهة (خبر موجز (عادة جملة واحدة وعادة ما يكون تافهاً)) / شبه حقيقة, معلومة مشكوك فيها (شيء يشبه الحقيقة؛ معلومات غير مؤكدة (غالباً ما تكون مختلقة) تُعطى مصداقية لأنها ظهرت في الطباعة)",
 "factor": "عَامِل (الذي يَعْمَل أو الذي عَمِلَ؛ هو الذي وَلاه السُلْطَان على أمر من أمور الدولة. الجمع عمَال)\nمثال: توم عامل نفايات.",
 "factor analysis": "تحليل عاملي (أي من عدة طرق لاختزال بيانات الارتباط إلى عدد أصغر من الأبعاد أو العوامل)",
 "factor analytic": "تحليلي عاملي (مكون من أو متعلق بـ أو ناتج عن التحليل العاملي (إحصاء))",
 "factor analytical": "تحليلي عاملي (مكون من أو متعلق بـ أو ناتج عن التحليل العاملي (إحصاء))",
 "factor i": "فيبرينوجين (بروتين موجود في بلازما الدم؛ يتحول إلى فيبرين عندما يتجلط الدم)",
