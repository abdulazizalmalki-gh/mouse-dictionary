 "fire marshal": "رَئِيس الإِطْفاء, مَأْمُور الإِطْفاء (رئيس إدارة الإطفاء) / رئيس الإطفاء, مأمور إطفاء (مسؤول عن الوقاية من الحرائق والتحقيق فيها)",
 "fire opal": "أوبال ناري (أوبال ذو ألوان برتقالية وصفراء وحمراء ملتهبة)",
 "fire pink": "سيلينة فرجينيا, قرنفل النار (عشبة معمرة في شرق أمريكا الشمالية، ذات زهور حمراء ببتلات ضيقة مسننة)",
 "fire pit": "حفرة نار (حفرة أرضيتها من الحمم المتوهجة)\nمثال: حفرة النار في الفوهة",
 "fire salamander": "سمندل منقط (سمندل أوروبي ذو جلد داكن مع بقع صفراء عادة)",
 "fire sale": "بيع بضائع متضررة, تصفية حريق (بيع البضائع التي يُفترض أنها تضررت بسبب الحريق) / بيع اضطراري, بيع بخس (بيع الأصول بأسعار منخفضة جداً عادةً عندما يواجه البائع الإفلاس)",
 "fire screen": "حاجز الموقد, واقي النار (شاشة معدنية توضع أمام النار المفتوحة للحماية (خاصة من الشرر المتطاير))",
 "fire ship": "سفينة حارقة (سلاح يتكون من سفينة تحمل متفجرات تُترك لتنجرف لتدمير سفن العدو)",
 "fire station": "مَرْكَز إطْفَاء (موضع الاِرْتِكَاز عامة؛ موضع الشخص ومحلّه الذي يبقى فيه عادة)\nمثال: أين أقرب مركز شرطة؟",
 "fire thorn": "بيراكانثا, شوكة النار (أي من الشجيرات الشائكة المتنوعة من جنس بيراكانثا تحمل زهوراً بيضاء صغيرة تليها توت أحمر صلب أو برتقالي محمر)",
 "fire tongs": "ملقط فحم, ملقط نار (ملقط للإمساك بالفحم المشتعل)",
 "fire tower": "برج مراقبة الحرائق (برج مراقبة حيث يتمركز حارس لمراقبة نشوب الحرائق)",
 "fire tree": "شجرة اللهب, شجرة النار (شجيرة أرضية دائمة الخضرة أو شجرة صغيرة في غرب أستراليا لها أزهار صفراء برتقالية رائعة؛ تتطفل على جذور الأعشاب)",
 "fire trench": "خندق نيران (خندق مبني خصيصاً لإطلاق نيران الأسلحة الصغيرة)",
 "fire truck": "سيارة مطافئ (مؤنث سَيَّار، صفة للكثير السَيْر؛ القَافِلَة أوالقَوْم الذين يسيرون)\nمثال: إنه يملك سيارة.",
 "fire walker": "الماشي على النار (شخص يمشي حافي القدمين على الجمر المشتعل)",
 "fire walking": "المشي على النار (طقس المشي حافي القدمين فوق حجارة ساخنة أو جمر)",
 "fire warden": "حارس الغابات, مكافح حرائق الغابات (مسؤول عن إدارة وحماية منطقة من الغابات)",
 "fire watcher": "مُراقِب الحَرائِق ((تاريخياً في بريطانيا أثناء الحرب العالمية الثانية) شخص مهمته مراقبة الحرائق الناجمة عن القصف الجوي)",
 "fire watching": "مراقبة الحرائق ((خلال الحرب العالمية الثانية في بريطانيا) مراقبة الحرائق التي تسببها القنابل التي تسقط من السماء)",
 "fire wheel": "زهرة البطانية, عجلة النار (نبات حولي من وسط الولايات المتحدة له رؤوس زهور صفراء مبهرجة طويلة الساق معلمة باللون القرمزي أو الأرجواني في المركز)",
 "fire-bellied toad": "علجوم ناري البطن (علجوم من وسط وشرق أوروبا له بقع حمراء أو برتقالية مختلطة بالأسود على جانبه السفلي)",
 "fire-bush": "سرو صيفي, شجيرة النار (نبات أوراسي كثيف التفرع؛ تتحول أوراقه إلى اللون الأحمر الأرجواني في الخريف) / شجيرة المربى, شجيرة النار (شجيرة دائمة الخضرة من أمريكا الجنوبية لها زهور برتقالية بارزة بوقية الشكل؛ تزرع كنبات زينة أو نبات منزلي)",
 "fire-eater": "آكِل اَلنَّار (أكل معه؛ آكَلَه الشيءَ: أَطعمه إِياه)\nمثال: لا آكل الفواكه.",
 "fire-on-the-mountain": "فربيون كأسي, نار على الجبل (بنت القنصل في الولايات المتحدة وشرق المكسيك؛ غالباً ما يتم الخلط بينها وبين الفربيون متباين الأوراق)",
 "fire-raising": "إحراق الممتلكات, حريق متعمد (الحرق العمد لتدمير الممتلكات)",
 "fire-resistant": "مُثَبِّط لِلْحَرِيق, مُقَاوِم لِلنَّار (صعب الاحتراق)",
 "fire-resisting": "مُثَبِّط لِلْحَرِيق, مُقَاوِم لِلنَّار (صعب الاحتراق)",
 "fire-resistive": "مُثَبِّط لِلْحَرِيق, مُقَاوِم لِلنَّار (صعب الاحتراق)",
 "fire-retardant": "مُثَبِّط لِلْحَرِيق, مُقَاوِم لِلنَّار (صعب الاحتراق)",
 "fire-swallower": "آكل النار (فنان استعراضي يتظاهر بابتلاع النار)",
 "fire-wheel": "زهرة البطانية, عجلة النار (نبات حولي من وسط الولايات المتحدة له رؤوس زهور صفراء مبهرجة طويلة الساق معلمة باللون القرمزي أو الأرجواني في المركز)",
 "fire-worship": "عبادة النار, مجوسية (عبادة النار)",
 "firearm": "سِلَاح نَارِيّ",
 "fireball": "كُرَة نَارِيَّة",
 "firebase": "قاعدة نيران (قاعدة مدفعية لدعم القوات المتقدمة)",
 "firebird": "صائد الذباب القرمزي (صائد ذباب أمريكي استوائي يوجد شمالاً حتى جنوب تكساس وأريزونا؛ الذكر البالغ له ريش قرمزي ساطع وأسود) / صفارية بالتيمور (نويع شرقي من الصفارية الشمالية) / تناجر قرمزي (الذكر أحمر ساطع بأجنحة وذيل أسود)",
 "fireboat": "قارب إطفاء (قارب مجهز لمكافحة الحرائق على السفن أو على طول الواجهة البحرية)",
 "firebomb": "قنبلة حارقة (قنبلة مصممة لإشعال الحرائق؛ وهي أكثر فعالية ضد الأهداف القابلة للاشتعال (مثل الوقود))",
 "firebox": "حجرة الاحتراق, صندوق النار (فرن (كما في القاطرة البخارية) يُحرق فيه الوقود)",
 "firebrand": "شُعْلَة",
 "firebrat": "سمكة النار (تعيش في المناطق الرطبة الدافئة مثل حول الأفران)",
 "firebreak": "خط النار, مانع النار (حقل ضيق تم تنظيفه للحد من انتشار حرائق البراري أو الغابات)",
 "firebrick": "طوب حراري (طوب مصنوع من الطين الناري؛ يستخدم لتبطين الأفران والمداخن)",
 "firebug": "بق النار (بق حقيقي: بق زاهي الألوان يمكن أن يفرز صبغة) / مفتعل حرائق (مجرم يشعل النار في الممتلكات بشكل غير قانوني)",
 "fireclay": "طين حراري (طين مقاوم للحرارة)",
 "firecracker": "مفرقعة, مفرقعة نارية (لعبة نارية تتكون من شحنة متفجرة صغيرة وفتيل داخل غلاف ورقي سميك)",
 "fired": "مَفْصُول, مُسَرَّح (فقد وظيفته أو تمّ الاستغناء عنه)",
 "firedamp": "غاز المناجم, فايردامب (خليط من الغازات (معظمها الميثان) يتشكل في مناجم الفحم ويصبح متفجراً عند اختلاطه بالهواء)",
 "firedog": "مسند حطب (دعامات معدنية للحطب في الموقد)\nمثال: كانت مساند الحطب ساخنة جداً لدرجة لا يمكن لمسها",
 "firedrake": "تنين, تنين أوروبي (مخلوق من الأساطير التيوتونية؛ يصور عادة وهو ينفث النار وله جسم زاحف وأحيانًا أجنحة)",
 "firefighter": "إِطْفَائِيّ",
 "firefly": "يَرَاعَة, حُبَاحِب",
 "firefox": "فَيَرْفُكْس",
 "fireguard": "حاجز الموقد, واقي النار (شاشة معدنية توضع أمام النار المفتوحة للحماية (خاصة من الشرر المتطاير)) / خط النار, مانع النار (حقل ضيق تم تنظيفه للحد من انتشار حرائق البراري أو الغابات)",
 "firehouse": "محطة إطفاء (محطة تؤوي معدات الإطفاء ورجال الإطفاء)",
 "firelight": "ضوء النار (ضوء النار (خاصة في الموقد))",
 "firelighter": "مكعب إشعال, ولاعة فحم (قطعة من مادة تحترق بسهولة ويمكن استخدامها لبدء إشعال الفحم أو الكوك)",
 "firelock": "بندقية القادح, بندقية صوانية (بندقية تلقيم من الفوهة كانت تستخدم قفل الصوان)",
 "fireman": "لعبة الإطفائي (لعب يتظاهر فيه الأطفال بإخماد حريق) / رجل إطفاء (عضو ذكر في قسم الإطفاء يحاول إخماد الحرائق) / رامٍ بديل (رامٍ ذكر (في البيسبول) لا يبدأ المباراة (يتم استدعاؤه لإنقاذ الموقف)) / وقاد (عامل ذكر يقوم بتغذية النيران (كما في القطارات التي تعمل بالفحم أو السفن البخارية))",
 "fireman's ax": "فأس رجل الإطفاء (فأس بمقبض طويل ورأس له حافة قاطعة واحدة ونقطة (شوكة) على الجانب الآخر)",
 "fireman's axe": "فأس رجل الإطفاء (فأس بمقبض طويل ورأس له حافة قاطعة واحدة ونقطة (شوكة) على الجانب الآخر)",
 "fireman's carry": "حمل رجل الإطفاء (عملية حمل شخص على كتفك)",
 "fireplace": "مِدْفَأَة, مَوْقِد",
 "fireplug": "صنبور حريق, محبس حريق (صنبور قائم لسحب المياه لاستخدامها في إطفاء الحريق)",
 "firepower": "قوة نيرانية ((عسكرياً) القدرة النسبية على إطلاق النار على هدف ما)",
 "fireproof": "مُقَاوِم لِلْحَرِيق (لا تؤثر فيه النار)",
 "fireroom": "عنبر الوقود, غرفة الإيقاد (حجرة أو مقصورة في السفينة يتم فيها إيقاد الأفران)",
 "fireside": "منزل, موقد (المنزل يرمز له كجزء من الموقد) / جوار الموقد, موقد (منطقة بالقرب من الموقد (عادة ما تكون مرصوفة وتمتد داخل الغرفة))\nمثال: طردوا من ديارهم ومنازلهم",
 "firestone": "حجر ناري (حجر رملي يتحمل الحرارة الشديدة؛ يستخدم لتبطين المواقد والأفران والقمائن) / حجر الزناد, حجر القداحة (قطعة من الصوان تُضرب لإشعال النار)",
 "firestorm": "عاصفة من الجدل (تفجر للجدل بشكل كبير) / عاصفة نارية (عاصفة تنجذب فيها الرياح العنيفة إلى عمود من الهواء الساخن المتصاعد فوق منطقة تعرضت لقصف شديد)\nمثال: تسبب الحادث في عاصفة سياسية",
 "firestriker": "مِقْدَح",
 "firethorn": "بيراكانثا, شوكة النار (أي من الشجيرات الشائكة المتنوعة من جنس بيراكانثا تحمل زهوراً بيضاء صغيرة تليها توت أحمر صلب أو برتقالي محمر)",
 "firetrap": "مبنى خطر, مصيدة نار (مبنى يصعب الهروب منه إذا اشتعلت فيه النيران)",
 "firewall": "جِدَار ناريّ, فَايْرْوُول",
 "firewater": "ماء النار (أي مشروبات روحية قوية (مثل الويسكي القوي أو الرم))",
 "fireweed": "إريكتيتس, عشب النار (نبات عشبي أمريكي ضار ذو أزهار بيضاء أو مخضرة صغيرة) / عشبة الصفصاف العملاقة, عشبة النار (نبات معمر طويل من أمريكا الشمالية ذو جذور زاحفة وأوراق ضيقة وسنابل من الزهور الوردية الأرجوانية توجد بكثرة كبيرة في المناطق المحترقة أو المناطق التي…)",
 "firewheel tree": "شجرة العجلة, شجرة عجلة النار (شجرة من شرق أستراليا تزرع على نطاق واسع كشجرة ظل ولأوراقها اللامعة وعناقيدها الدائرية من الزهور الحمراء إلى البرتقالية القرمزية المبهرجة)",
 "firewire": "فَايْرْوَايْر",
 "firewoman": "وقادة (عاملة أنثى تقوم بتغذية النيران (كما في القطارات التي تعمل بالفحم أو السفن البخارية)) / رامية بديلة (رامية أنثى (في البيسبول) لا تبدأ المباراة) / إطفائية (عضو أنثى في قسم الإطفاء تحاول إخماد الحرائق)",
 "firewood": "حَطَب (حَطَبَ فُلَانًا حَطَباً يَحْطِبُه واحْتَطَبَ لَهُ: جَمَعَه لَهُ وأَتاهُ بِهِ؛ حَطَبُوه: قَطَعُوه)\nمثال: بحث زيري عن الحطب.",
 "firework": "أَلْعَاب نَارِيَّة, مُفَرْقِعَات",
 "fireworks": "مُفَرْقِعَات, أَلْعَاب نَارِيَّة",
 "firing": "إطلاق نار (فعل إطلاق النار من بندقية) / إقالة, تسريح (إنهاء توظيف شخص ما (وتركه حراً للمغادرة)) / إشعال, إضرام (عملية إضرام النار في شيء ما) / إطلاق نار, رمي (فعل إطلاق الأسلحة أو المدفعية على عدو)\nمثال: تراجعوا في مواجهة نيران العدو الشديدة",
 "firing chamber": "بيت النار, حجرة الإطلاق (الحجرة التي تشكل جزءاً من البندقية وتستقبل الحشوة)",
 "firing line": "الطليعة, خط المواجهة (المجموعة الأكثر تقدماً ومسؤولية في نشاط ما) / خط النار (الخط الذي يطلق منه الجنود النار)\nمثال: خط المواجهة هو مكان الحدث",
 "firing mechanism": "آلية الإطلاق, زناد (الآلية التي تشعل الشحنة في سلاح ناري)",
 "firing off": "إطلاق نار (فعل إطلاق النار من بندقية)",
 "firing party": "فرقة إعدام (حظيرة تُشكل لإطلاق النار في جنازة عسكرية أو لتنفيذ إعدام عسكري)",
 "firing pin": "إبرة الإطلاق (مطرقة تشعل الشحنة بضرب الكبسولة)",
 "firing range": "ميدان رماية (ميدان للتدرب على إصابة الأهداف)",
 "firing squad": "فرقة إعدام (حظيرة تُشكل لإطلاق النار في جنازة عسكرية أو لتنفيذ إعدام عسكري)",
 "firkin": "برميل خشبي صغير (برميل خشبي صغير) / فيركين (وحدة سعة بريطانية تساوي 9 غالونات إمبراطورية)",
 "firm": "بإصرار, بثبات (بتصميم حازم) / رَاسِخ, مَتِين (قويّ وأكيد) / رَاسِخ, مُخْلِص (ثَابِت لَا يَتَزَعْزَع فِي الإِخْلَاص لِصَدِيق أَوْ عَهْد أَوْ قَضِيَّة) / جَامِد, رَاسِخ (مُثَبَّت بِإِحْكَام فِي مَكَانِه)\nمثال: صدقنا ذلك بحزم",
 "firm omelet": "عجة متماسكة (بيض مخفوق مع الحليب أو القشدة ومطبوخ حتى يتماسك)",
 "firmament": "رَقِيع, سماء",
 "firmamental": "جلدي, سماوي (متعلق بالجلد (السماء) أو المناطق العليا)",
 "firmer chisel": "إزميل نجارة (إزميل بشفرة رقيقة لأعمال النجارة)",
 "firmiana simplex": "شجرة المظلة الصينية, ورنيش ياباني (شجرة نفضية تزرع على نطاق واسع في جنوب الولايات المتحدة كزينة لأوراقها الجميلة التي تشبه القيقب وعناقيدها الطويلة من الزهور الصفراء الخضراء تليها قرون…)",
 "firmly": "بإصرار, بثبات (بتصميم حازم) / بإحكام, بقوة / بِأَمَان, بِإِحْكَام (بطريقة آمنة؛ بطريقة خالية من الخطر)\nمثال: صدقنا ذلك بحزم",
 "firmness": "ثَبَات",
 "firmness of purpose": "حزم, عزم (سمة كون المرء حازماً)\nمثال: حمله عزمه خلال المعركة",
 "firmware": "بَرْنَامِج ثَابِت (عَرْضٌ (تلْفَزِيٌّ،…)؛ مُفَكَّرَةٌ يَوْمِيَّةٌ)\nمثال: نشط البرنامج الآن.",
 "firn": "ثَلْج حُبَيْبَي (ثلَجتنا السماء: مطَرَتنا، ألقت علينا الثلج؛ ثلَجت نفسي: اشتَفَت به، واطمأنت إليه)\nمثال: سامي يحب الثلج.",
 "first": "أَوَّل, أُولَى (الذي يكون ترتيبه وَاحِد، الذي كان قبل الآخرين؛ الأوَّل اسم من الأسماء الحسنى) / أَوَّلاً / مثال: لم تكن أول مرة.",
 "first aid": "إِسْعَافَات أَوَّلِيَّة, إِسْعَاف أَوَّلِيّ",
 "first and foremost": "بَادِئَ ذِي بَدْءٍ",
 "first and last": "أولاً وأخيراً, قبل كل شيء (بأخذ كل شيء معاً)\nمثال: كانت عالمة أولاً وأخيراً",
 "first appearance": "إطلاق, تدشين (فعل البدء بشيء جديد)\nمثال: تطلعوا إلى الظهور الأول لخط إنتاجهم الجديد",
 "first balcony": "الشرفة الأولى, ميزانين المسرح (الشرفة الأولى أو الأدنى في المسرح)",
 "first base": "قاعدة أولى, مرحلة أولى (المرحلة الأولية في إنجاز شيء ما) / القاعدة الأولى (مركز اللعب للاعب في فريق البيسبول المتمركز عند القاعدة الأولى في الملعب الداخلي) / القاعدة الأولى (القاعدة التي يجب أن يلمسها عداء القاعدة أولاً في البيسبول)\nمثال: لم نصل إلى المرحلة الأولى بهذا النهج",
 "first baseman": "لاعب القاعدة الأولى ((بيسبول) رجل يلعب في القاعدة الأولى)",
 "first basewoman": "لاعبة القاعدة الأولى ((في البيسبول) امرأة تلعب في القاعدة الأولى)",
 "first blush": "نظرة أولى, وهلة أولى (عند اللمحة أو الانطباع الأول)\nمثال: للوهلة الأولى تبدو الفكرة ذات جاذبية بديهية كبيرة ولكن عند الفحص الدقيق تفشل",
 "first cause": "السبب الأول, المحرك الأول (عامل هو سبب كل الأشياء ولكن ليس له سبب في حد ذاته)\nمثال: الله هو السبب الأول",
 "first class": "بالدرجة الأولى (بواسطة وسائل نقل من الدرجة الأولى؛ مع إقامة من الدرجة الأولى) / درجة أولى (أغلى أماكن الإقامة على متن سفينة أو قطار أو طائرة) / درجة أولى (أعلى رتبة في التصنيف) / بريد الدرجة الأولى (بريد يشمل الرسائل والبطاقات البريدية والطرود المختومة ضد التفتيش)\nمثال: نسافر دائماً بالدرجة الأولى",
 "first council of constantinople": "مجمع القسطنطينية, مجمع القسطنطينية الأول (المجمع المسكوني الثاني عام 381 الذي أضاف صياغة حول الروح القدس إلى قانون الإيمان النيقاوي)",
 "first council of lyons": "مجمع ليون الأول (مجمع الكنيسة الغربية عام 1245 الذي حرم الإمبراطور الروماني المقدس فريدريك الثاني وخطط لحملة صليبية جديدة ضد الأرض المقدسة)",
 "first council of nicaea": "مجمع نيقية, مجمع نيقية الأول (المجمع المسكوني الأول عام 325 الذي وضع صياغة قانون الإيمان النيقاوي وأدان بدعة الآريوسية)",
 "first cousin": "ابن الخال, ابن العم (ابن عمك أو عمتك أو خالك أو خالتك)",
 "first cranial nerve": "عصب شمي, عصب قحفي أول (مصطلح جماعي للعديد من الخيوط الشمية في الغشاء المخاطي للأنف)",
 "first degree": "درجة أولى (درجة واحد)\nمثال: جميع الحدود في المعادلة الخطية هي من الدرجة الأولى",
 "first derivative": "دالة مشتقة, مشتقة (نتيجة التفاضل الرياضي؛ التغيير اللحظي لكمية بالنسبة لأخرى)",
 "first estate": "الطبقة الأولى, رجال الدين (رجال الدين في فرنسا ورؤساء الكنيسة في بريطانيا)",
 "first floor": "الدور الأرضي, الطابق الأرضي (طابق المبنى الذي يكون عند مستوى الأرض المحيطة بالمبنى أو الأقرب إليه)",
 "first gear": "الترس الأول, السرعة الأولى (أدنى نسبة تروس أمامية في صندوق تروس المركبة؛ تستخدم لبدء تحرك السيارة)",
 "first gentleman": "السيد الأول (زوج الرئيسة التنفيذية (أو رئيسة الدولة))",
 "first half": "شوط أول (الأول من شوطين للعب)",
 "first harmonic": "تردد أساسي, نغمة أساسية (أدنى نغمة في سلسلة توافقية)",
 "first in first out": "ما يرد أولاً يصرف أولاً (محاسبة المخزون التي يُفترض فيها أن العناصر الأقدم (التي تم شراؤها أولاً) هي التي تباع أولاً)",
 "first lady": "السيدة الأولى (زوجة الرئيس التنفيذي) / سيدة أولى (المرأة الرائدة في فن أو مهنة)",
 "first language": "اللغة الأصلية, اللغة الأم (اللغة الأصلية للفرد؛ اللغة التي يتعلمها الأطفال وتنتقل من جيل إلى جيل)",
 "first lateran council": "مجمع لاتران الأول (المجمع الأول للكنيسة الغربية الذي عقد في قصر لاتران عام 1123؛ ركز على انضباط الكنيسة ووضع خططاً لاستعادة الأراضي المقدسة)",
 "first law of motion": "القانون الأول للحركة, قانون نيوتن الأول (يبقى الجسم في حالة سكون أو حركة بسرعة ثابتة ما لم تؤثر عليه قوة خارجية)",
 "first law of thermodynamics": "حفظ الطاقة, قانون حفظ الطاقة (المبدأ الأساسي في الفيزياء القائل بأن الطاقة الكلية لنظام معزول ثابتة على الرغم من التغيرات الداخلية)",
 "first lieutenant": "ملازم أوّل (مَن يُلازم الشيء أو المكان فيدوم فيه ولا يفارقه؛ في : المُلازِم رتبة في الجيش هي أدنى رتبة للظُبَّاط ودونه ما يعرفون بنُوَّاب الظباط أو ظُباط الصَفّ)",
 "first light": "بزوغ الفجر, شروق (ضوء النهار الأول)\nمثال: استيقظنا قبل الفجر",
 "first lord of the treasury": "اللورد الأول للخزانة (الوزير البريطاني المسؤول عن الاستراتيجية الاقتصادية)",
 "first love": "اَلْحُبّ اَلْأَوَّل",
 "first mate": "مساعد القبطان (الضابط الذي يلي القبطان في الرتبة على سفينة تجارية)",
 "first moment": "توقع رياضي, قيمة متوقعة (مجموع قيم متغير عشوائي مقسوماً على عدد القيم)",
 "first mortgage": "رهن عقاري أول (رهن عقاري له أولوية على جميع الرهون العقارية والامتيازات باستثناء تلك التي يفرضها القانون)",
 "first name": "اسم أول, اسم شخصي (الاسم الذي يسبق اللقب)",
 "first of all": "أَوَّلًا, قَبْلَ كُلِّ شَيْءٍ",
 "first of may": "أول مايو, عيد العمال (يُحتفل به في العديد من البلدان للاحتفال بقدوم الصيف؛ يُحتفل به في روسيا والدول ذات الصلة تكريماً للعمال)",
 "first off": "أولاً, في المقام الأول (قبل أي شيء آخر)\nمثال: أولاً يجب أن نعتبر ثعبان الرباط",
 "first offender": "مذنب لأول مرة (شخص أدين للمرة الأولى)",
 "first period": "شوط أول, فترة أولى (القسم الأول الذي ينقسم إليه لعب المباراة)",
 "first person": "مُتَكَلِّم",
 "first principles": "ألفباء, مبادئ أولية (المراحل الأولية لأي موضوع)\nمثال: أتقن فقط مبادئ الهندسة الأولية",
 "first quarter": "التربيع الأوّل, التربيع المتزايد",
 "first reading": "قراءة أولى (العرض الأول لمشروع قانون في الهيئة التشريعية)",
 "first responder": "مُسْتَجِيب أَوَّل",
 "first sacker": "لاعب القاعدة الأولى ((في البيسبول) الشخص الذي يلعب في القاعدة الأولى)",
 "first sergeant": "رقيب أول (رقيب في الجيش أعلى من رقيب أركان وأقل من مساعد)",
 "first step": "حركة افتتاحية, خطوة أولى (الأولى في سلسلة من الإجراءات)",
 "first stomach": "المعدة الأولى, كرش (القسم الأول من معدة الحيوان المجتر؛ حيث يتم جمع الطعام وإعادته إلى الفم كجِرّة للمضغ)",
 "first strike": "ضربة أولى (الاستخدام الأولي للأسلحة النووية لمهاجمة بلد يمتلك أيضاً أسلحة نووية)\nمثال: وعد الرئيس الباكستاني بعدم توجيه ضربة أولى ضد الهند",
 "first team": "فريق الجامعة الرسمي (فريق يمثل كلية أو جامعة)",
 "first trimester": "الثلث الأول من الحمل (فترة زمنية تمتد من اليوم الأول لآخر دورة شهرية وحتى الأسبوع 12 من الحمل)",
 "first vatican council": "مجمع الفاتيكان الأول (اسم مفعول من جَمَّعَ؛ كُلِّيَّة، جَامِعَة)\nمثال: كان سامي يعيش في مجمع مسور.",
 "first visual area": "القشرة المخططة, المنطقة البصرية الأولية (جزء القشرة القذالية الذي يستقبل ألياف الإشعاع البصري من الجسم الركبي الجانبي وهو منطقة الاستقبال الأولية للرؤية)",
 "first water": "درجة أولى, ماء أول (أحجار كريمة من أعلى جودة)",
 "first world": "الْعَالَم الْأَوَّل",
 "first-aid kit": "حقيبة إسعافات أولية (مجموعة تتكون من ضمادات وأدوية لتقديم الإسعافات الأولية)",
 "first-aid station": "محطة إسعافات أولية (محطة تقدم الرعاية الطارئة أو العلاج قبل التمكن من الحصول على المساعدة الطبية المنتظمة)",
 "first-class": "رَفِيع, مُتَأَلِّق (جيد جدًا؛ من أرقى مستويات الجودة)",
 "first-class honours degree": "مرتبة الشرف الأولى (درجة شرف من الفئة الأولى)",
 "first-class mail": "بريد الدرجة الأولى (بريد يشمل الرسائل والبطاقات البريدية والطرود المختومة ضد التفتيش)",
 "first-degree burn": "حرق من الدرجة الأولى (حرق يسبب احمرار سطح الجلد)",
 "first-nighter": "حاضر العرض الأول (شخص يعتاد حضور افتتاحيات العروض المسرحية)",
 "first-order correlation": "ارتباط من الدرجة الأولى (ارتباط جزئي تتم فيه إزالة تأثيرات متغير واحد فقط (يتم تثبيته))",
 "first-order logic": "منطق الرتبَة الأولى (عِلْمُ المَنْطِق: هو عِلْم من العلوم البحتة هدفه البَحْث عن قواعد التفكير السَوِية البعيدة عن الخَطَأ. يسمى أيضا بالمِيزان؛ العقل والتفكير السويّ الحكيم)\nمثال: غزة منطقة مكشوفة.",
 "first-place finish": "المركز الأول (إنهاء السباق في المركز الأول)",
 "first-rate": "بشكل ممتاز, على ما يرام (بشكل جيد جداً) / فَائِق, مُمْتَاز (من أعلى مستويات الجودة)\nمثال: إنها لا تشعر أنها على ما يرام اليوم",
 "first-rateness": "امْتِيَاز, جَوْدَة عَالِيَة (خاصية كون الشيء ذا جودة استثنائية)",
 "first-rater": "شَخْص مِنَ الطِّرَاز الْأَوَّل (شخص من الدرجة الأولى أو ممتاز)",
 "first-string": "أَسَاسِيّ فِي الفَرِيق (عضو دائم وأساسيّ في الفريق) / أَسَاسِيّ, مِنَ الصَّفِّ الْأَوَّلِ (من أعضاء الفريق الأساسيين؛ ليس بديلاً)",
 "first-year": "فِي السَّنَةِ الأُولَى, مُسْتَجِدّ (يُوصَفُ بِهِ الشَّخْصُ فِي سَنَتِهِ الأُولَى مِنْ تَجْرِبَةٍ (خَاصَّةً فِي المَدْرَسَةِ أَوِ الجَامِعَةِ))",
 "firstborn": "بِكْر (في : يُطلق على الحليب الذي يُحلب من أول مرة بعد الولادة)\nمثال: لا أفهم سبب ولعه بكرة القدم.",
 "firsthand": "مباشرة, من المصدر المباشر (من المصدر الأصلي؛ بشكل مباشر) / مِن المَصْدَر مُبَاشَرَةً (مُتَلَقًّى مباشرةً من المصدر)\nمثال: سمعت هذه القصة من المصدر المباشر",
 "firstly": "أَوَّلًا",
 "firth": "خور, لسان بحري (مصب ضيق وطويل (خاصة في اسكتلندا))",
 "fisa": "قانون مراقبة الاستخبارات الأجنبية (قانون أقره الكونغرس عام 1978 لوضع إجراءات لطلب إذن قضائي للمراقبة الاستخباراتية الأجنبية)",
 "fisc": "خزانة الدولة (خزانة الدولة أو خزانة ملكية؛ في الأصل الخزانة العامة لروما أو الخزانة الخاصة للإمبراطور)",
 "fiscal": "مَالِيّ (مَالِي هي دولة تقع في وسط إفريقيا؛ مالي:نقودي، أموالي)\nمثال: زيري من المالي.",
 "fiscal policy": "سياسة مالية (سياسة حكومية للتعامل مع الميزانية (خاصة الضرائب والاقتراض))",
 "fiscal year": "سَنَة مَالِيَّة (مقدارُ قطع الشمس البروجَ الاثني عشر ، وهي السنة الشمسيَّة، و السَّنَةُ تمامُ اثنتَيْ عشرةَ دَورةً للقمر ، وهي السنة القمرية…)\nمثال: في عمره 24 سنة.",
 "fiscally": "ضريبياً, مالياً (في الشؤون المالية)\nمثال: غير مسؤول مالياً",
 "fischer's slime mushroom": "فطر فيشر اللزج (نوع من الفطر اللزج)",
 "fish": "سَمَكَة, سَمَك (مصطلح شمولي لأي حيوان فقاري مائي خيشومي التنفس) / سَمَك, سمك (سَمَك جمع سَمَكَة، كما تجمع سمكة أسماك) / صَادَ\nمثال: سمكة ميناد ماتت",
 "fish and chips": "سَمَك وَبَطَاطِس مَقْلِيَّة (سَمَك جمع سَمَكَة، كما تجمع سمكة أسماك)\nمثال: سمكة ميناد ماتت",
 "fish ball": "كرة السمك, كعكة السمك (كرة مقلية أو قرص من السمك المفتت والبطاطس المهروسة) / غيفيلت فيش, كرة السمك اليهودية (كرات متبلة جيداً من السمك المفروم والبيض والفتات المطحون مطهية ببطء في مرق السمك)",
 "fish bowl": "حوض سمك كروي (وعاء شفاف تحفظ فيه الأسماك الصغيرة) / انعدام الخصوصية, تحت المجهر (حالة من انعدام الخصوصية)\nمثال: يعيش الرئيس في وضع تنعدم فيه الخصوصية (تحت المجهر)",
 "fish cake": "كرة السمك, كعكة السمك (كرة مقلية أو قرص من السمك المفتت والبطاطس المهروسة)",
 "fish chowder": "تشاودر السمك (تشاودر يحتوي على السمك)",
 "fish doctor": "طبيب السمك (إيل بوت قطبي زاهي الألوان وبلا حراشف)",
 "fish duck": "بلقشة (بط غواص كبير آكل للأسماك ذو عرف ومنقار نحيل معقوف بحواف مسننة)",
 "fish eagle": "عقاب نسارية (صقر كبير غير ضار يوجد في جميع أنحاء العالم يتغذى على الأسماك ويبني عشاً ضخماً غالباً ما يتم شغله لسنوات)",
 "fish family": "فصيلة سمكية (أي من فصائل الأسماك المتنوعة)",
 "fish farm": "مزرعة سمكية (مكان عمل (عادة بركة) حيث يتم تربية الأسماك للطعام)",
 "fish filet": "شريحة سمك مخلاة, فيليه (شريحة طولية أو جانب من السمك منزوع العظم)",
 "fish fillet": "شريحة سمك مخلاة, فيليه (شريحة طولية أو جانب من السمك منزوع العظم)",
 "fish finger": "أصابع السمك (شريحة طويلة من السمك مغطاة بالبقسماط ومقلية)",
 "fish fly": "ذبابة السمك (تشبه ذبابة دوبسون ولكنها أصغر؛ تستخدم اليرقات كطعم للصيد)",
 "fish fry": "قلي السمك (طهي في الهواء الطلق حيث يكون السمك المقلي هو الطبق الرئيسي)",
 "fish fuddle": "بيسيديا, قرانيا جامايكا (شجرة صغيرة في جزر الهند الغربية وفلوريدا لها أوراق ريشية فردية كبيرة وعناقيد من الزهور المخططة بالأحمر والأرجواني والأبيض تليها قرون بذور مجنحة…)",
 "fish genus": "جنس سمكي (أي جنس من الأجناس المختلفة للأسماك)",
 "fish geranium": "غرنوقي الحدائق, لقلقي منطق (غرنوقي منتصب له أوراق صدفيّة ذات منطقة ملونة عريضة داخل الحافة وزهور بيضاء أو وردية أو حمراء)",
 "fish glue": "غراء السمك (مادة جيلاتينية يتم الحصول عليها بغلي جلود وزعانف وعظام الأسماك)",
 "fish hawk": "عقاب نسارية (صقر كبير غير ضار يوجد في جميع أنحاء العالم يتغذى على الأسماك ويبني عشاً ضخماً غالباً ما يتم شغله لسنوات)",
 "fish house punch": "بونش فيش هاوس (بونش مصنوع من الرم والبراندي والماء أو الشاي المحلى بشراب السكر)",
 "fish in troubled waters": "اصطاد بالماء العكر, صاد في الماء العكر",
 "fish joint": "وصلة سمكية (وصلة تناكبية تتشكل عن طريق تثبيت ألواح وصل بمسامير على جانبي قضيبين أو عارضتين)",
 "fish knife": "سكين سمك (سكين مائدة صغير بشفرة مسطحة يستخدم لأكل السمك)",
 "fish ladder": "سلم الأسماك (سلسلة من الأحواض الصاعدة توفر ممرًا لسمك السلمون للسباحة عكس التيار متجاوزًا سدًا)",
 "fish loaf": "رغيف السمك (سمك مفتت يخبز في رغيف مع فتات الخبز وتوابل مختلفة)",
 "fish louse": "قمل السمك (نوع من مجدافية الأرجل)",
 "fish lure": "طعم صيد ((صيد الأسماك) أي طعم صناعي لامع يتكون من البلاستيك أو المعدن مثبت بخطافات ومزين بالريش)",
 "fish meal": "مسحوق السمك (سمك مجفف مطحون يستخدم كسماد وعلف للماشية المنزلية)",
 "fish mousse": "موس السمك (موس مصنوع من السمك)",
 "fish oil": "زَيْت السَّمَك (ما يعصر من الزَيْتُون؛ كل سائل لزج يستخرد من النبات يستخدم كما يستخدم السمن)\nمثال: خبأن ذلك الزيت.",
 "fish sauce": "صلصة السمك, صوص السمك",
 "fish scale": "فِلْس, قِشْرَة سَمَك (حرشفة من النوع الذي يغطي أجسام الأسماك)",
 "fish slice": "ملعقة سمك (ملعقة تقليب طعام ذات شفرة عريضة تستخدم لقلب أو تقديم السمك أو غيره من الأطعمة المطهية في مقلاة)",
 "fish species": "نوع سمكي (نوع من الأسماك)",
