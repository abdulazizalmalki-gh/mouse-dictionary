 "flaxseed oil": "زيت بذر الكتان (زيت جاف يُستخرج من بذور الكتان ويُستخدم في صنع أشياء مثل الدهانات الزيتية)",
 "flay": "سَلَخَ (قشر الجلد عن اللحم؛ نزع الشيء عن الشيء بقوة)\nمثال: سلخ زيري ذلك الغزال.",
 "flea": "بُرْغُوث",
 "flea beetle": "خنفساء برغوثية (أي خنفساء أوراق صغيرة لها أرجل خلفية متضخمة وقادرة على القفز)",
 "flea bite": "إزعاج بسيط (إزعاج طفيف جداً) / قرصة برغوث (لسعة يسببها برغوث)",
 "flea market": "سوق البراغيث, سوق السلع المستعملة (سوق شوارع مفتوح للسلع الرخيصة أو المستعملة)",
 "flea-bitten": "مُتَدَاعٍ, مُتَهَالِك (بَالٍ وَمُتَحَطِّمٌ بِسَبَبِ الاسْتِعْمَالِ الشَّدِيدِ)",
 "fleabag": "فندق رخيص, فندق قذر (فندق متهالك)",
 "fleabane": "أريغارون كندي, ذيل الحصان (عشب ضار شائع في أمريكا الشمالية بأوراق خطية ورؤوس قرصية صغيرة من الزهور الصفراء؛ مستوطن على نطاق واسع في جميع المناطق المعتدلة؛ يوضع أحياناً في جنس…) / أريغارون, شيح الجبل / برغوثية, بوليكاريا (عشب أوراسي معمر مشعر ذو أزهار صفراء تشبه الأقحوان يشتهر بقدرته على القضاء على البراغيث أو طردها)",
 "fleabane mullet": "برغوثية, بوليكاريا (عشب أوراسي معمر مشعر ذو أزهار صفراء تشبه الأقحوان يشتهر بقدرته على القضاء على البراغيث أو طردها)",
 "fleapit": "سينما رخيصة (دار عرض سينمائي قديمة ومتهالكة)",
 "fleawort": "قطونة, لسان الحمل الأسيوي (نبات لسان الحمل في مناطق البحر الأبيض المتوسط تنتفخ بذوره وتصبح هلامية عند ترطيبها وتستخدم كملين خفيف)",
 "flecainide": "تامبوكور, فليكاينيد (دواء فموي مضاد لاضطراب النظم (الاسم التجاري تامبوكور) يستخدم كحل أخير في علاج عدم الانتظام؛ يزيد من خطر الموت المفاجئ لدى مرضى النوبات القلبية)",
 "fleck": "بقعة, لطخة (جزء صغير مغاير في شيء ما) / رُقَاقة, شَظِيَّة صغيرة (شظية صغيرة من شيء انفصلت عن الكل)\nمثال: بقعة صلعاء",
 "flecked": "مُرَشَّش, مُنَقَّط (ذو نقش من النقاط)",
 "flection": "انثناء, انعطاف (انحراف عن مسار مستقيم أو طبيعي) / انثناء, ثني (حالة الانثناء (كما في المفصل))",
 "fledged": "مُرَيَّش ((عَنِ السَّهْم) مُزَوَّد بِالرِّيش) / مكسو بالريش, ناضج ((عن الطيور) طورت ريشاً أو ريشاً كاملاً؛ غالباً ما تستخدم في التركيبات)",
 "fledgeless": "بِلَا رِيش ((عَنِ السَّهْم) غَيْر مُزَوَّد بِالرِّيش)",
 "fledgeling": "فرخ طائر (طائر صغير اكتسى بالريش للتو أو أصبح قادراً على الطيران) / قادم جديد, مستجد (أي مشارك جديد في نشاط ما)",
 "fledgling": "غِرّ, نَاشِئ (صغير السن وعديم الخبرة) / فرخ طائر (طائر صغير اكتسى بالريش للتو أو أصبح قادراً على الطيران) / قادم جديد, مستجد (أي مشارك جديد في نشاط ما)",
 "flee": "هَرَبَ, فَرَّ (الفِرارُ)\nمثال: هرب كأرنب خائف.",
 "fleece": "صُوف (الغطاء الخارجي وخاصة للأغنام والياك) / صوف, فليس (قماش ناعم ضخم ذو وبر عميق؛ يستخدم بشكل رئيسي للملابس) / جلد الغنم, صوف الغنم (جلد خروف مدبوغ مع بقاء الصوف عليه؛ يستخدم للملابس) / جزة صوف (صوف الخروف أو حيوان مشابه)",
 "fleeceable": "سَهْلُ الانْخِدَاع, غِرّ (ساذج يسهل خداعه واستغلاله)",
 "fleecy": "مُخْمَلِيّ, وَبَرِيّ (ذو سَطْح مَمْشوط أو وَبَرِيّ ناعِم)",
 "fleer": "اسْتِهْزَاء (ازدراء يتم التعبير عنه بالسخرية في النظرات أو الكلمات) / فَاّر, هَارِب (شخص يهرب من وضع غير ملائم)\nمثال: هاربون من المعامل المستغلة",
 "fleet": "أُسْطُول (الأسطول مجموعة من السفن تعد للحرب أو للنقل؛ جمع اساطيل ويقال مجموعة الطائرات: اسطول جوي)",
 "fleet admiral": "أدميرال الأسطول, أدميرال خمس نجوم (أدميرال من أعلى رتبة)",
 "fleet ballistic missile submarine": "غواصة صواريخ باليستية (غواصة تحمل صواريخ باليستية)",
 "fleet street": "الصحافة البريطانية, شارع فليت (الصحافة البريطانية (نسبة إلى شارع فليت في لندن))",
 "fleeting": "خَاطِف, عَابِر (يَدوم لِفَتْرَة قَصيرَة جِدًّا)",
 "fleetingness": "زوال سريع, قصر الأمد (خاصية الاستمرار لفترة قصيرة جداً)",
 "fleetly": "بخفة, بسرعة (بطريقة سريعة)\nمثال: تحركت بسرعة",
 "fleetness": "خفة الحركة, سرعة الحركة (سرعة الحركة)\nمثال: خفة القدمين",
 "fleming": "فلمنكي (مواطن من فلاندرز أو بلجيكي يتحدث الفلمنكية)",
 "flemish": "فلمنكي (من أو متعلق بفلاندرز أو شعبها أو لغتها أو ثقافتها) / الفلمنكية (إحدى اللغتين الرسميتين في بلجيكا؛ ترتبط ارتباطًا وثيقًا بالهولندية) / فلمنكيون (مجموعة عرقية تتحدث الفلمنكية وتعيش في شمال وغرب بلجيكا)\nمثال: السكان الفلمنكيون في بلجيكا",
 "flemish dialect": "الفلمنكية (إحدى اللغتين الرسميتين في بلجيكا؛ ترتبط ارتباطًا وثيقًا بالهولندية)",
 "flemish language": "الفلمنكية (إحدى اللغتين الرسميتين في بلجيكا؛ ترتبط ارتباطًا وثيقًا بالهولندية)",
 "flemish-speaking": "نَاطِقٌ بِالفْلَمَنْكِيَّة (قادر على التواصل باللغة الفلمنكية)",
 "flerovium": "فليروفيوم (عنصر مشع ما بعد اليورانيوم)",
 "flesh": "لَحْمٌ (ما يبقى من جسم الحيوان أو الإنسان بعد إزالة الجلد الأحشاء والعظم والشحم والدم والأعصاب. يتكون أساسا من العَضَلَات؛ ما يؤكل من لحم من الحيوان والطير والسمك عامة)\nمثال: أفضل لحم البقر.",
 "flesh fly": "ذبابة اللحم (ذبابة تتغذى يرقاتها على الجيف أو لحم الحيوانات الحية)",
 "flesh wound": "جرح سطحي (جرح لا يضر بالأعضاء الداخلية المهمة أو يكسر أي عظام)",
 "flesh-colored": "بِلَوْن الجِلْد البَشَرِيّ (بلون أحمر فاتح أو وردي كلون البشرة)",
 "flesh-coloured": "بِلَوْن الجِلْد البَشَرِيّ (بلون أحمر فاتح أو وردي كلون البشرة)",
 "fleshed out": "مُفَصَّل, مُكْتَمِلُ المَعَالِم (أُعطِي مادّة وتفاصيل كافية؛ اكتمل بنيانه)",
 "fleshiness": "بدانة, سمنة مفرطة (سمنة أكثر من المتوسط)",
 "fleshly": "حَيَوَانِيّ, شَهْوَانِيّ (يتّسم بشهوات الجسد وغرائزه)",
 "fleshy": "زَائِد الوَزْن, ضَخْم البِنْيَة (يَصِف عَادَةً شَخْصًا كَبِيرًا بَدِينًا لَكِنْ لَه هَيْكَل كَبِير يَحْمِل وَزْنَه) / لحمي (مكون من أو متعلق بـ أو يشبه اللحم)",
 "fletc": "مركز تدريب إنفاذ القانون الفيدرالي (مركز في وزارة الأمن الداخلي يقوم بتدريب المتخصصين في إنفاذ القانون لأكثر من سبعين وكالة فيدرالية)",
 "fletching": "قذة",
 "fleur-de-lis": "زهرة الزنبق ((شعارات النبالة) شحنة تتكون من تمثيل تقليدي لزهرة السوسن) / زنبق السيف, سوسن (نباتات ذات أوراق تشبه السيف وسيقان منتصبة تحمل أزهاراً زاهية الألوان تتكون من ثلاث بتلات وثلاث سبلات متدلية)",
 "fleur-de-lys": "زهرة الزنبق ((شعارات النبالة) شحنة تتكون من تمثيل تقليدي لزهرة السوسن)",
 "flevopolder": "فليفوبولدر",
 "flews": "شفاه متدلية (الشفة العليا اللحمية المتدلية لكلب الصيد أو كلب مشابه)",
 "flex": "ثني, شد (عملية شد العضلات)\nمثال: قام بشد عضلات ذراعه لإبهار السيدات",
 "flex harrow": "عزاقة ذات أسنان مرنة, مشط مرن (مشط يتكون من أسنان زنبركية دقيقة مثبتة على إطار مرن يتكيف مع التضاريس، يستخدم لإزالة الأعشاب الضارة من المحاصيل)",
 "flexeril": "سيكلوبنزابرين, فليكسيريل (مرخي عضلات (الاسم التجاري فليكسيريل) يستخدم لتشنجات العضلات أو الإصابة الحادة)",
 "flexibility": "مُرُونة",
 "flexible": "مَرِن",
 "flexible harrow": "عزاقة ذات أسنان مرنة, مشط مرن (مشط يتكون من أسنان زنبركية دقيقة مثبتة على إطار مرن يتكيف مع التضاريس، يستخدم لإزالة الأعشاب الضارة من المحاصيل)",
 "flexible joint": "مفصلة (مفصل يثبت جزأين معاً بحيث يمكن لأحدهما التأرجح بالنسبة للآخر)",
 "flexible sigmoidoscope": "منظار السيني, منظار القولون السيني المرن (منظار (مسبار ليفي بصري مرن) لفحص القولون السيني)",
 "flexible sigmoidoscopy": "تنظير السينى (فحص بصري (بمنظار السينى) للثلث السفلي من القولون بحثاً عن الزوائد اللحمية)",
 "flexibleness": "مرونة (صفة القابلية للتكيف أو التغير) / ليونة, مرونة (خاصية كون الشيء مرناً؛ سهل الثني أو التشكيل)\nمثال: استمتع بمرونة ترتيبات عمله",
 "flexibly": "بمرونة (مع وجود مرونة)\nمثال: قال بمرونة: تعال وقتما تكون متفرغاً",
 "flexile": "لدن, مرن (قابل للثني؛ يمكن ثنيه بسهولة)\nمثال: أشجار بتولا نحيلة ومرنة",
 "flexion": "انثناء, ثني (فعل ثني مفصل؛ خاصة المفصل بين عظام طرف بحيث تقل الزاوية بينهما) / انثناء, انعطاف (انحراف عن مسار مستقيم أو طبيعي) / انثناء, ثني (حالة الانثناء (كما في المفصل))",
 "flexitarianism": "شبه نباتية, نباتية مرنة (ممارسة تناول الطعام النباتي بشكل أساسي، مع استثناءات عرضية لتناول اللحوم لأسباب اجتماعية أو عملية أو ثقافية أو غذائية)\nمثال: ستكون النباتية المرنة التوجه الكبير التالي",
 "flexor": "عضلة قابضة (عضلة هيكلية يثني انقباضها مفصلاً)",
 "flexor muscle": "عضلة قابضة (عضلة هيكلية يثني انقباضها مفصلاً)",
 "flexuous": "مُتَعَرِّج, مُلْتَوٍ (فيه انعطافات وتعرجات)",
 "flexure": "انثناء, ثني (فعل ثني مفصل؛ خاصة المفصل بين عظام طرف بحيث تقل الزاوية بينهما) / انثناء, ثنية (شكل زاوي أو مستدير ناتج عن الطي) / انثناء, ثني (حالة الانثناء (كما في المفصل))\nمثال: طية في المنديل",
 "flibbertigibbet": "ثرثارة, حمقاء (أنثى حمقاء)",
 "flick": "فيلم, فيلم سينمائي (شكل من أشكال الترفيه يجسد قصة بالصوت وتسلسل من الصور يعطي وهماً بالحركة المستمرة) / شطبة سريعة, نقر (خط قصير وسريع) / ضربة خفيفة, نقرة (تلامس خفيف وحاد (عادة بشيء مرن))\nمثال: ذهبوا لمشاهدة فيلم كل ليلة سبت",
 "flick knife": "سكين كبس, مِطواة زنبركية (سكين جيب بشفرة تفتح بالزنبرك عند الضغط على زر)",
 "flick-knife": "سكين كبس, مِطواة زنبركية (سكين جيب بشفرة تفتح بالزنبرك عند الضغط على زر)",
 "flicker": "وَمِيض, وَمْضَة / طَرْفَة, وَمْضَة / رَفْرَفَ, خفَقَ",
 "flickering": "خَافِت, مُتَرَجْرِج (يلمع بشكل غير ثابت ومتذبذب)",
 "flickertail": "سنجاب ريتشاردسون الأرضي (من مناطق الميرمية والمراعي في غرب الولايات المتحدة وكندا)",
 "flier": "مَنْشُور, نَشْرَة إِعْلَانِيَّة (إعلان (عادة ما يطبع على صفحة أو في نشرة) معد للتوزيع على نطاق واسع) / طيار (شخص يشغل طائرة) / مسافر جواً (شخص يسافر بالطائرة)\nمثال: أرسل المنشور بالبريد إلى جميع المشتركين",
 "flies": "الفضاء العلوي, علوية المسرح ((مسرح) المساحة فوق خشبة المسرح (بعيداً عن رؤية الجمهور) المستخدمة لتخزين المناظر (الستائر المنسدلة))",
 "flight": "طَيَرَان (التَحْليِق والسِبَاحَة في الجَوّ؛ للطَيَّار: قيادة الطَائِرَة) / تَحْلِيق / فِرَار, هُرُوب\nمثال: الطيران أسرع وسيلة سفر.",
 "flight attendant": "مُضِيف, مُضِيفَة (مِنْ أَضَافَ؛ الذي يدعو الضيوف ويقريهم)\nمثال: الجزائر العاصمة مدينة مضيفة جدا.",
 "flight control": "تحكم بالطيران, مراقبة جوية (التحكم من المحطات الأرضية في الطائرات أثناء طيرانها)",
 "flight deck": "سطح الطيران (السطح العلوي لحاملة طائرات؛ يستخدم كمدرج)",
 "flight engineer": "مهندس طيران (فرد طاقم الطائرة المسؤول عن التشغيل الميكانيكي أثناء الطيران)",
 "flight feather": "رِيشَةُ الطَّيَرَان, قَلَمُ الرِّيشَة (أي من ريش الجناح أو الذيل الأكبر للطائر)",
 "flight indicator": "أفق اصطناعي, مؤشر الطيران (أداة ملاحية تعتمد على الجيروسكوب؛ توفر أفقاً محاكياً للطيار بشكل اصطناعي)",
 "flight line": "خط الطيران, ساحة الطائرات (المكان الذي تتوقف فيه الطائرات وحظائر الصيانة (ولكن ليس المدارج أو ممرات التدحرج))",
 "flight maneuver": "مناورة جوية (مناورة تنفذها طائرة)",
 "flight number": "رَقْمَ الرِحْلةِ (وضع أرقامًا على شيء ما للتنظيم أو التمييز)\nمثال: سجلت رقم هاتفه.",
 "flight of stairs": "شوط سلم, قلبة سلم (درج (مجموعة من الدرجات) بين طابق وآخر أو بين بسطة والأخرى)",
 "flight of steps": "شوط سلم, قلبة سلم (درج (مجموعة من الدرجات) بين طابق وآخر أو بين بسطة والأخرى)",
 "flight path": "مسار طيران, ممر جوي (طريق محدد تتبعه الطائرات في الطيران من مطار إلى آخر) / مسار الطيران (مسار صاروخ أو مقذوف أو طائرة عبر الهواء)",
 "flight simulator": "محاكي الطيران (جهاز محاكاة يتكون من آلة على الأرض تحاكي ظروف الطيران بالطائرة)",
 "flight strip": "مدرج, مهبط طائرات بسيط (مهبط طائرات بدون مرافق المطار العادية)",
 "flight surgeon": "جراح طيران (ضابط طبي متخصص في طب الطيران)",
 "flightiness": "تقلب, نزوة (سمة التصرف بشكل غير متوقع وبدافع نزوة أكثر منه بدافع العقل أو الحكم)\nمثال: أيأس من تقلب ونزوة ذاكرتي",
 "flightless": "عَاجِز عَنِ الطَّيَرَان (غير قادر على الطيران)",
 "flightless bird": "طيور مسطحة الصدر, نعاميات (طيور لا تطير لها عظام صدر مسطحة تفتقر إلى الجؤجؤ لربط عضلات الطيران: النعام، الشبنم، الإيمو، الموا، الريا، الكيوي، طيور الفيل)",
 "flightlessness": "عَجْز عَن الطَّيَرَان (حالة عدم القدرة على الطيران، وتستخدم عادة مع الطيور مثل البطريق والنعامة والإيمو)",
 "flighty": "جَمُوح, نَزِق (سريع الاستثارة بشكل غير متوقع (خاصة عن الخيول)) / شَارِد الذِّهْن, مُتَقَلِّب (ينقاد للأهواء والنزوات دون تفكير ثابت)",
 "flimflam": "احتيال, خديعة الثقة (عملية نصب تغش فيها في القمار أو تقنع شخصاً بشراء ممتلكات لا قيمة لها)",
 "flimsily": "بشكل واهٍ, بهشاشة (بطريقة ضعيفة وهشة)\nمثال: هذه السيارة مبنية بشكل واهٍ للغاية!",
 "flimsiness": "ركاكة, هشاشة (خاصية الضعف بحكم البناء المهمل)",
 "flimsy": "غير مقنع, واهٍ (ليس مقنعاً) / ضَعِيف, هَشّ (يفتقر إلى الجوهر أو الأهمّيّة) / رَقِيق, هَشّ (يفتقر إلى الصلابة أو المتانة) / ورق قشر البصل (ورق رقيق قوي خفيف الوزن وشفاف يستخدم خاصة لعمل نسخ كربونية)\nمثال: حجة واهية",
 "flinch": "جَفَل (يُشير الفعل \"جفل\" إلى معنيين رئيسيين حسب استخدامه؛ الفعل \"جفل\"، فهو يدل على: الجرف والنقل (الطين، السمك)، الطرد والحركة (السحاب، الظليم)، الشعثة (الشعر)، الصراع (فلاناً)، الروث (الفيل)…)",
 "flinders": "حطام, شظايا (قطع صغيرة وشظايا وكسرات)\nمثال: كان سيتحطم إلى شظايا قبل وقت طويل من إحداث ذلك الضرر",
 "flindersia australis": "زان أسترالي, فليندرسية أسترالية (شجرة خشبية أسترالية طويلة تنتج خشباً صلباً متيناً يستخدم في صناعة البراميل وغيرها)",
 "flindersia schottiana": "بونجي بونجي, فليندرسية شوتية (شجرة خشبية أسترالية ينتج لحاؤها سماً)",
 "flindosa": "زان أسترالي, فليندرسية أسترالية (شجرة خشبية أسترالية طويلة تنتج خشباً صلباً متيناً يستخدم في صناعة البراميل وغيرها)",
 "flindosy": "زان أسترالي, فليندرسية أسترالية (شجرة خشبية أسترالية طويلة تنتج خشباً صلباً متيناً يستخدم في صناعة البراميل وغيرها)",
 "fling": "عَلَاقَة سَرِيعَة, علاقة طيارى / صَبَّ, رَمَّى (سَكَبَ، الفرق بين صَبَّ وسَكَب أن الصَبّ يكون متعمدا والسكب قد يكون متعمدا أو خطأ؛ صَبَّ الطعام، أي سكبه في الإناء أو الصحون)\nمثال: صب الشاي لضيفك.",
 "flint": "صَوَّان, ظُرَر / صَوَّانَة, ظِرّ",
 "flint corn": "ذرة صوانية, ذرة يانكي (ذرة تحتوي حبوبها على طبقة خارجية صلبة تحيط بالسويداء الناعمة)",
 "flint glass": "زجاج الصوان البصري, زجاج فلنت بصري (زجاج بصري ذو تشتت عالٍ ومعامل انكسار عالٍ)",
 "flint maize": "ذرة صوانية, ذرة يانكي (ذرة تحتوي حبوبها على طبقة خارجية صلبة تحيط بالسويداء الناعمة)",
 "flinthead": "لقلق الخشب (لقلق أمريكي يشبه طيور أبو منجل الحقيقية في امتلاكه منقاراً منحنياً لأسفل؛ يعيش في المستنقعات المشجرة في المناطق الاستوائية للعالم الجديد)",
 "flintlime brick": "طوب رملي جيري, طوب سيليكات الكالسيوم (طوب مصنوع من الرمل والجير المطفأ بدلاً من الطين؛ عادة ما يكون لونه رمادياً فاتحاً أو أبيض مائلاً للصفرة)",
 "flintlock": "قفل الصوان (قفل بندقية قديم يحتوي على صوان مدمج في المطرقة؛ يصدر الصوان شرارة تشعل الشحنة) / بندقية القادح, بندقية صوانية (بندقية تلقيم من الفوهة كانت تستخدم قفل الصوان)",
 "flintstone": "حصى الصوان (حصى من الصوان يُستخدم في أعمال البناء)",
 "flinty": "عَنيد, غَليظ (شَديد القَسْوَة وعَديم الرَّحْمَة؛ لا يَرِقّ قَلْبُه) / صواني (يحتوي على الصوان)",
 "flip": "قَلَبَ",
 "flip chart": "لوحة قلابة (لوحة بها عدة أوراق مثبتة في الأعلى؛ يمكن قلب الأوراق لعرض المعلومات بشكل متتابع)",
 "flip side": "الوَجْه الآخَر (جانب مختلف لشيء ما (وخاصة الجانب المعاكس))\nمثال: الوجه الآخر لصفاتك الإيجابية هو أنها تخرج أحياناً عن السيطرة",
 "flip-flap": "بصوت الخفقان, خفقاً (مع ضربات متكررة وضوضاء)\nمثال: شيء ما يتحرك خفقاً في الليل",
 "flip-flop": "شقلبة خلفية (شقلبة هوائية للخلف) / دائرة قلابة, قلاب (دائرة إلكترونية يمكن أن تتخذ إحدى حالتين مستقرتين) / شبشب بإصبع (صندل بدون ظهر يثبت في القدم بواسطة شريط بين إصبع القدم الكبير والإصبع الثاني) / انقلاب, تراجع (قرار بعكس قرار سابق)",
 "flipagram": "فليبغرام, فيديو صور (تسلسل من الصور المجمعة في فيديو)",
 "flippancy": "استخفاف, سلاطة (خفة غير لائقة)\nمثال: ردت أنيكا على استخفاف توم بنظرة باردة",
 "flippant": "خَفِيف العَقْل, مُسْتَخِفّ (يُظهر خفّة غير لائقة في موضع يستدعي الجدّية)",
 "flippantly": "باستخفاف, بلامبالاة (بأسلوب ينم عن الاستخفاف وعدم الجدية)\nمثال: أجاب على أسئلة الصحفيين باستخفاف",
 "flipper": "زعنفة (الطرف العريض المسطح للحيوانات المائية المخصص للسباحة) / زعانف السباحة, زعنفة (حذاء للسباحة؛ مقدمته الشبيهة بالمجداف تساعد في السباحة (خاصة تحت الماء))",
 "flipper-like": "شَبِيه بِالزَّعْنَفَة (يُشْبِه الزَّعْنَفَة في شَكْلِه)",
 "flirt": "غزل, ملاطفة (سلوك مرح يهدف إلى إثارة الاهتمام الجنسي) / غانية, لعوب (امرأة مغرية تستخدم جاذبيتها لاستغلال الرجال)",
 "flirtation": "غزل, ملاطفة (سلوك مرح يهدف إلى إثارة الاهتمام الجنسي)",
 "flirtatious": "مُتَدَلِّل, مُغَازِل (يتصرّف بدلال ومغازلة)",
 "flirtatiously": "بِدَلَال, بِغُنْج (بطريقة مغازلة)\nمثال: ابتسمت بغنج",
 "flirting": "غزل, ملاطفة (سلوك مرح يهدف إلى إثارة الاهتمام الجنسي)",
 "flit": "انتقال خفي, هروب سري (انتقال سري (لتجنب دفع الديون)) / انطلاق سريع, حركة خاطفة (حركة سريعة مفاجئة)\nمثال: قاموا بهروب سري ليلي",
 "flitch": "جانب مقدد, فليتش (جدار البطن المملح والمحفوظ من جانب الخنزير) / شريحة سمك مفلطح (شريحة سمك تقطع عادة من الهلبوت)",
 "flittering scotoma": "عتمة وميضية (منطقة موضعية من الرؤية الضعيفة محاطة بأضواء ملونة متلألئة؛ تشير عند العديد من الناس إلى بداية الصداع النصفي)",
 "float": "طَفَا, عَامَ / طَفَا",
 "float-type rain gage": "مقياس مطر عائم (مقياس مطر يقيس فيه عوام يطفو على سطح الماء مستوى مياه الأمطار المجمعة)",
 "float-type rain gauge": "مقياس مطر عائم (مقياس مطر يقيس فيه عوام يطفو على سطح الماء مستوى مياه الأمطار المجمعة)",
 "floatation": "تعويم, طرح أسهم (تمويل مؤسسة تجارية عن طريق السندات أو حصص الأسهم) / طفو (ظاهرة الطفو (البقاء على سطح السائل دون الغرق))",
 "floater": "وثيقة تأمين عائمة (بوليصة تأمين تغطي فقدان الممتلكات المنقولة (مثل المجوهرات) بغض النظر عن موقعها) / جسم طافٍ, عائم (جسم يطفو أو قادر على الطفو) / طافٍ (سباح يطفو في الماء) / ناخب مزور (ناخب يصوت بشكل غير قانوني في أماكن اقتراع مختلفة في نفس الانتخابات)",
 "floating": "طَافٍ, مُعَلَّق فِي سَائِل (محمول أو معلق في سائل) / طفو (فعل الشخص الذي يطفو على الماء) / عَائِم, مُتَنَقِّل (يَمِيلُ إِلَى التَّنَقُّلِ مِنْ مَكَانٍ لِآخَر) / تَائِه, مُتَشَرِّد (يتنقّل باستمرار خاصّة من مسكن أو عمل لآخر)",
 "floating bridge": "جسر عائم (جسر مؤقت يُبنى فوق سلسلة من الطوافات)",
 "floating dock": "حوض جاف عائم, حوض عائم (حوض جاف يمكن غمره تحت السفينة ثم رفعه)",
 "floating dry dock": "حوض جاف عائم, حوض عائم (حوض جاف يمكن غمره تحت السفينة ثم رفعه)",
 "floating exchange rate": "سعر صرف عائم, سعر صرف متقلب (سعر الصرف الذي تحدد فيه قيمة العملة من قبل السوق الحرة)",
 "floating fern": "أزولا كارولينية, سرخس البعوض (سرخس مائي صغير حر الطفو من شرق الولايات المتحدة إلى أمريكا الاستوائية؛ متوطن في غرب وجنوب أوروبا) / سرخس عائم, عفريت الماء (سرخس مائي في أمريكا الاستوائية يستخدم غالباً في أحواض السمك) / سرخس عائم (سرخس مائي استوائي شامل)",
 "floating mine": "لغم بحري, لغم عائم (لغم متفجر مصمم لتدمير السفن التي تصطدم به)",
 "floating policy": "وثيقة تأمين عائمة (بوليصة تأمين تغطي فقدان الممتلكات المنقولة (مثل المجوهرات) بغض النظر عن موقعها)",
 "floating voter": "ناخب متأرجح (ناخب ليس لديه ولاء لأي حزب سياسي ويمكن لقراراته غير المتوقعة أن ترجح كفة الانتخابات)",
 "floating-moss": "سالفينيا, طحلب عائم (سراخس مائية حرة الطفو)",
 "floating-point notation": "تدوين النقطة العائمة (نظام عد جذري يُشار فيه إلى موقع الفاصلة العشرية بواسطة أُس للجذر؛ في نظام تمثيل النقطة العائمة، يُمثَّل 0.0012 كـ 0.12-2 حيث -2 هو الأُس)",
 "floating-point number": "عَدَد بِفَاصِلَة عَيْمَة, عَدَد حَقِيقِيّ عائِم (عدد ممثل بتدوين الفاصلة العائمة)",
 "floating-point operation": "عملية النقطة العائمة, فلوب (عملية حسابية تجرى على أعداد الفاصلة العائمة)\nمثال: يمكن لهذا الكمبيوتر إجراء مليون عملية فاصلة عائمة في الثانية",
 "floating-point representation system": "تدوين النقطة العائمة (نظام عد جذري يُشار فيه إلى موقع الفاصلة العشرية بواسطة أُس للجذر؛ في نظام تمثيل النقطة العائمة، يُمثَّل 0.0012 كـ 0.12-2 حيث -2 هو الأُس)",
 "floatplane": "طائرة طافية, طائرة عائمة (طائرة مائية مجهزة بعوامات للهبوط أو الإقلاع من الماء)",
 "floaty": "طافٍ, عائِم (يَميل إلى الطُّفُوّ عَلى السَّائِل أو الارْتِفاع في الهَواء)",
 "floc": "ندفة (كتلة صغيرة متجمعة بشكل فضفاض من مادة نديفة معلقة في سائل أو مترسبة منه)",
 "floccose": "ذُو خُصَل صُوفِيَّة, نَدَفِيّ ((للنباتات) ذو خصل من الشعيرات الصوفية الناعمة)",
 "floccose chanterelle": "شانتريل صوفي (فطر سام بشكل خفيف بجسم ثمري على شكل بوق مجوف)",
 "flocculate": "تَلَبَّدَ",
 "flocculation": "تلبد (عملية التلبد؛ تشكيل تجمعات صوفية تشبه السحب)",
 "flocculator": "جهاز تنديف, مندف (جهاز يستخدم في عملية التنديف)",
 "floccule": "ندفة (كتلة صغيرة متجمعة بشكل فضفاض من مادة نديفة معلقة في سائل أو مترسبة منه)",
 "flocculent": "صُوفِيّ, نَدِفِيّ (شَبيه بالصُّوف في مَلْمَسِه ونُعومَتِه)",
 "flock": "قَطِيع / تَهَافَتَ, تَقَاطَرَ / مِزْقَة",
 "floe": "طوف جليدي (كتلة مسطحة من الجليد (أصغر من الحقل الجليدي) تطفو في البحر)",
 "flog": "جَلَدَ (ضَرَبَ بشدّة بعصا أو سوط أو نحوهما؛ تَحَمَّلَ المصاعب بصبر وشدّة)\nمثال: هذا حزام من الجلد.",
 "flogger": "جلاد, سياط (معذب يقوم بجلد أو ضرب الضحايا بالسوط (خاصة كمسؤول رسمي))",
 "flogging": "جَلْد (ضَرَبَ بشدّة بعصا أو سوط أو نحوهما؛ تَحَمَّلَ المصاعب بصبر وشدّة)\nمثال: هذا حزام من الجلد.",
 "flood": "طُوفَان, فَيَضَان (عاصفة)",
 "flood control": "السيطرة على الفيضانات ((هندسة) فن أو تقنية محاولة السيطرة على الأنهار بالسدود وغيرها لتقليل حدوث الفيضانات)",
 "flood lamp": "كشاف ضوئي, مصباح غامر (ضوء يعد مصدراً للإضاءة الاصطناعية ذات شعاع عريض؛ يستخدم في التصوير الفوتوغرافي)",
 "flood plain": "سهل فيضي (سهل منخفض مجاور لنهر يتكون بشكل رئيسي من رواسب النهر وعرضة للفيضانات)",
 "flood tide": "فيضان, مد صاعد (حدوث تدفق المياه للداخل (بين الجزر والمد العالي التالي)) / ذروة, قمة (أعلى نقطة لأي شيء يتصور أنه ينمو أو يتطور أو يتكشف)\nمثال: مد في شؤون البشر، إذا أُخذ في ذروته، يقود إلى الثروة",
 "flooded": "غَارِق, مَغْمُور (مُغَطًّى بِالمَاء)",
 "flooded gum": "صمغ الفيضانات (أي من عدة أشجار صمغ أسترالية تنمو في التربة الرطبة أو الطميية)",
 "floodgate": "بوابة ايقاف الفيضان",
 "floodhead": "رأس الفيضان, مقدمة الطوفان (جدار من الماء يندفع في مقدمة الفيضان)\nمثال: كنا محظوظين لكوننا في أمان عندما ضربت مقدمة الطوفان",
 "flooding": "علاج بالغمر, علاج بالفيضان (تقنية تستخدم في العلاج السلوكي؛ يتم إغراق العميل بتجارب من نوع معين حتى يصبح كارهاً لها أو مخدراً تجاهها)",
 "floodlight": "كشاف ضوئي, مصباح غامر (ضوء يعد مصدراً للإضاءة الاصطناعية ذات شعاع عريض؛ يستخدم في التصوير الفوتوغرافي)",
 "floodlighted": "مُضَاء بِالكَشَّافَات (مُنَار بِوَاسِطَة كَشَّافَات ضَوْئِيَّة)",
 "floodlit": "مُضَاء بِالكَشَّافَات (مُنَار بِوَاسِطَة كَشَّافَات ضَوْئِيَّة)",
 "floodplain": "سهل فيضي (سهل منخفض مجاور لنهر يتكون بشكل رئيسي من رواسب النهر وعرضة للفيضانات)",
 "floor": "أَرْضِيَّة, أَرْض (ما يقابل السَقْف من الغرفة؛ قاع الشيء) / طَابِق\nمثال: انهارت الأرضية.",
 "floor board": "لوح أرضية (لوح في الأرضية)",
 "floor cover": "غطاء أرضية, فرش أرضية (غطاء للأرضية)",
 "floor covering": "غطاء أرضية, فرش أرضية (غطاء للأرضية)",
 "floor joist": "رافدة الأرضية (عارضة تدعم الأرضية)",
 "floor lamp": "مصباح أرضي (مصباح يقف على الأرض)",
 "floor leader": "زعيم الكتلة البرلمانية (المشرع الذي ينظم استراتيجية حزبه)",
 "floor plan": "مُخَطَّط أَرْضِيَّة الدَّوْر",
 "floor show": "عرض ليلي, كباريه (سلسلة من الفقرات في ملهى ليلي)",
 "floor wax": "شمع الأرضيات (مستحضر يحتوي على الشمع ويُستخدم لتلميع وحفظ تشطيب الأرضيات)",
 "floorboard": "لوح أرضية (لوح في الأرضية) / أرضية السيارة (أرضية السيارة)",
 "floored": "ذو أرضية, مُبلَّط (مزود بأرضية)",
 "flooring": "أَرْضِيَّة (ما يقابل السَقْف من الغرفة؛ قاع الشيء)\nمثال: انهارت الأرضية.",
 "floorshow": "عرض ليلي, كباريه (سلسلة من الفقرات في ملهى ليلي)",
 "floorwalker": "مراقب صالة, مشرف طابق (موظف في متجر بيع بالتجزئة يشرف على موظفي المبيعات ويساعد في حل مشاكل العملاء)",
 "floozie": "عاهرة شوارع (عاهرة تجذب الزبائن بالمشي في الشوارع)",
 "floozy": "عاهرة شوارع (عاهرة تجذب الزبائن بالمشي في الشوارع)",
 "flop": "تماماً, مباشرة (بشكل كامل) / انهيار, سقوط (فعل رمي نفسك للأسفل؛ الانهيار؛ الغوص) / بصوت ارتطام, سقوطاً (مع صوت ارتطام) / إخفاق تام, فشل ذريع (فشل كامل)\nمثال: سقط مباشرة على وجهه",
 "flophouse": "نزل رخيص (نزل إقامة رخيص)",
 "floppy": "مُتَدَلٍّ, مُرَفْرِف (يَتَدَلَّى بِرُخْوَة) / ديسك, قرص مرن (قرص مغناطيسي بلاستيكي صغير مغلف في غلاف صلب بفتحة شعاعية؛ يستخدم لتخزين البيانات أو البرامج للحاسوب الصغير)\nمثال: تشتهر الأقراص المرنة بسرعتها البطيئة نسبياً وسعتها الصغيرة وسعرها المنخفض",
 "floppy disk": "قُرْص مَرِن",
 "flora": "حياة نباتية, فلورا ((علم النبات) كائن حي يفتقر إلى القدرة على الانتقال الحركي) / غطاء نباتي, فلورا (جميع الحياة النباتية في منطقة أو فترة معينة)\nمثال: نباتات العصر البليستوسيني",
 "floral": "زَهْرِيّ",
 "floral arrangement": "تنسيق الزهور (ترتيب زخرفي للزهور)",
 "floral cup": "أنبوب الكأس, مجن (الهيكل الذي يشبه الكوب أو الحلقة أو الأنبوب للزهرة والذي يحمل السبلات والأسدية والكأس (كما في الوردية))",
 "floral envelope": "غلاف زهري (مصطلح جماعي للأجزاء الخارجية للزهرة المكونة من الكأس والتويج وتحيط بالأسدية والمدقات)",
 "floral leaf": "ورقة زهرية (ورقة معدلة تكون جزءاً من الزهرة)",
 "floreal": "فلوريال (الشهر الثامن من التقويم الثوري (أبريل ومايو)؛ شهر الزهور)",
 "florence": "فْلُورَنْسَا, فْلُورَنْسَة",
 "florence fennel": "بسباس, شمر (قاعدة ساق بصلية عطرية تؤكل مطبوخة أو نيئة في السلطات) / شمر حلو, شمر فلورنسا (يزرع خاصة لقاعدة ساقه البصلية العطرية الصالحة للأكل)",
 "florentine": "فْلُورَنْسِيّ",
 "florentine iris": "سوسن فلورنسي (سوسن جرماني له زهور بيضاء كبيرة مع بتلات مشوبة بالخزامى وجذمور عطري)",
 "florescence": "إزهار, تفتح الزهور (وقت وعملية تبرعم وتفتح الزهور)",
 "floret": "زهيرة (زهرة صغيرة (خاصة تلك التي تكون جزءًا من زهرة مركبة))",
 "floricultural": "زراعي زهري (مكون من أو متعلق بـ أو يتضمن زراعة الزهور)",
 "floriculture": "زراعة الزهور (زراعة النباتات المزهرة)",
 "florid": "أَحْمَر الوَجْه, مُحْمَرّ (ذو بَشَرَة حَمْراء مُشْرِقَة تَدُلّ عَلى صِحَّة جَيِّدَة) / مُبَالَغ فِي زَخْرَفَتِهِ, مُتَنَمِّق (مزخرف بإفراط وتكلّف)",
 "florida": "فْلُورِيدَا",
 "florida arrowroot": "زاميا قزمة, كونتي (زاميا خشبية صلبة صغيرة في فلوريدا وجزر الهند الغربية وكوبا؛ تنتج الجذور والسيقان نصف المدفونة نشا الأروروت)",
 "florida bean": "فاصولياء مخملية, ميقونة (كرمة خشبية حولية من آسيا لها عناقيد طويلة من الزهور الأرجوانية وقرون مشعرة كثيفة؛ تزرع في جنوب الولايات المتحدة للسماد الأخضر والرعي)",
 "florida gallinule": "دجاجة الماء (فلوريدا) (دجاجة ماء رمادية مزرقة داكنة من أمريكا الشمالية)",
 "florida key": "جزيرة مرجانية منخفضة, كي (شعاب مرجانية قبالة الساحل الجنوبي لفلوريدا)",
 "florida pompano": "بومبانو فلوريدا (توجد في المياه الساحلية من نيو إنجلاند إلى البرازيل باستثناء المياه الصافية لجزر الهند الغربية)",
 "florida selaginella": "سيلاجينيلا فلوريدا (يوجد على نطاق واسع في فلوريدا)",
 "florida smoothhound": "كلب البحر الأملس الفلوريدي (يوجد من شمال خليج المكسيك إلى البرازيل)",
 "florida strangler fig": "تين خانق, تين ذهبي (شجرة خانقة موطنها جنوب فلوريدا وجزر الهند الغربية؛ تبدأ كنبات هوائي وتطور في النهاية العديد من الجذور الهوائية السميكة وتغطي مساحات هائلة)",
 "florida strap fern": "سرخس الشريط الفلوريدي, سرخس لسان البقر (سرخس هوائي أو أرضي أحياناً شائع ذو أوراق شريطية خضراء مصفرة شاحبة؛ من فلوريدا إلى جزر الهند الغربية والمكسيك وجنوباً إلى أوروغواي)",
 "florida water rat": "جرذ ماء فلوريدا, فأر المسك مستدير الذيل (من الأراضي الرطبة في فلوريدا)",
 "florida yew": "طقسوس فلوريدا (طقسوس شجيري صغير من شمال فلوريدا له فروع منتشرة وأوراق ضيقة جداً)",
 "floridian": "فلوريدي (مواطن أو مقيم في فلوريدا)",
 "floridity": "بهرجة, تأنق مفرط (إتقان مفرط وتكلف)\nمثال: كتب بأسلوب منمق للغاية",
 "floridly": "بتنميق, بزخرفة (بطريقة منمقة)\nمثال: نثر رمزي منمق",
 "floridness": "بهرجة, تأنق مفرط (إتقان مفرط وتكلف)\nمثال: كتب بأسلوب منمق للغاية",
 "florilegium": "مقتطفات أدبية (أنثولوجيا من القطع الأدبية القصيرة والقصائد والبالاد وما إلى ذلك)",
 "florin": "غيلدر, فلورن (سابقاً وحدة المال الأساسية في هولندا؛ تساوي 100 سنت) / غيلدر, فلورن (وحدة المال الأساسية في سورينام؛ تساوي 100 سنت)",
 "florist": "متجر بيع الورد, محل زهور (متجر تباع فيه الزهور والنباتات للزينة) / بائع زهور, منسق زهور (شخص يزرع الزهور ويتاجر بها)\nمثال: صنع بائع الزهور باقة جذابة",
 "florist shop": "متجر بيع الورد, محل زهور (متجر تباع فيه الزهور والنباتات للزينة)",
 "florist's chrysanthemum": "أقحوان, أقحوان بائعي الزهور (من الصين)",
 "florist's cineraria": "سينراريا هجينة (عشب مشتق من السينراريا ويُزرع على نطاق واسع بأشكال مزهرة بغزارة بألوان من الأبيض إلى الوردي إلى الأحمر أو الأرجواني أو البنفسجي أو الأزرق)",
 "florist's gloxinia": "سينينجيا, غلوكسينيا بائعي الزهور (عشب من أمريكا الجنوبية يزرع في العديد من الأصناف كنبات منزلي لأوراقه الكبيرة الوسيمة وأزهاره الكبيرة الجرسية الشكل متنوعة الألوان)",
 "florist's willow": "صفصاف الماعز (صفصاف كثير التفرع من العالم القديم له نورات هرية كبيرة وأوراق عريضة كبيرة نسبياً)",
 "florists' chrysanthemum": "أقحوان, أقحوان بائعي الزهور (من الصين)",
 "floréal": "فْلُورِيَال",
 "floss": "خيط الأسنان (خيط ناعم لتنظيف المسافات بين الأسنان) / خيط حرير ناعم (خيط ناعم مجدول برخاوة يستخدم في التطريز)",
 "flossy": "رَقِيق كَالزَّغَب, زَغَبِيّ (ناعِم وخَفيف كالرِّيش أو الزَّغَب)",
 "flotation": "تعويم, طرح أسهم (تمويل مؤسسة تجارية عن طريق السندات أو حصص الأسهم) / طفو (ظاهرة الطفو (البقاء على سطح السائل دون الغرق))",
 "flotation device": "وسيلة نجاة (معدات إنقاذ تتكون من حزام أو سترة طافية لمنع الشخص من الغرق)",
 "flotilla": "أسطول صغير (أسطول من القوارب الصغيرة) / فصيلة بحرية (أسطول تابع للبحرية الأمريكية يتكون من سربين أو أكثر من السفن الحربية الصغيرة)",
 "flotsam": "حطام عائم (حطام سفينة يطفو على الماء)",
 "flounce": "مشي بانتفاض (فعل المشي بحركات متشنجة مبالغ فيها) / كشكشة, هدب (شريط من القماش المثني يُستخدم كزينة أو حاشية)",
 "flounder": "فلاوندر (أي من الأسماك المفلطحة البحرية الأوروبية وغير الأوروبية المختلفة) / سمك الهلبوت (لحم أي من الأسماك المفلطحة الأمريكية والأوروبية المختلفة)",
 "flour": "طَحِين, دَقِيق",
 "flour beetle": "خنفساء الدقيق (حشرة تغزو الدقيق والحبوب المخزنة)",
 "flour bin": "صندوق دقيق (صندوق لحفظ الدقيق)",
 "flour corn": "ذرة الدقيق, ذرة ناعمة (ذرة تتكون حبوبها بالكامل تقريباً من النشا الناعم)",
 "flour mill": "طاحونة دقيق (طاحونة لطحن الحبوب وتحويلها إلى دقيق)",
 "flour weevil": "خنفساء الدقيق (حشرة تغزو الدقيق والحبوب المخزنة)",
 "flour-monger": "دَقَّاق",
 "flouriness": "قوام طحيني, نعومة دقيقية (حالة أو شرط التشبه بالدقيق، بكونه مسحوقاً ناعماً طرياً)\nمثال: من هذا يترسب الألومينا ثم يحمص؛ وخلال هذه المراحل اللاحقة تتحدد رملية أو دقيقية الألومينا",
 "flourish": "جذل, فانفار ((موسيقى) لحن حيوي قصير يُعزف على الآلات النحاسية) / إشهار, تلويح (فعل التلويح) / زخرفة لفظية (عرض للكلام أو اللغة المنمقة) / حركة استعراضية (إيماءة مبهرجة)\nمثال: دخل على وقع نغمة احتفالية من الأبواق",
 "flourishing": "رَائِج, مُزْدَهِر (حيوي ومربح للغاية؛ في حالة ازدهار ونمو)",
 "floury": "دَقِيقِيّ (يشبه الدقيق في قوامه المسحوقيّ الناعم)",
 "flouter": "ساخر, شامت (شخص يسخر أو يتهكم أو يعامل شيئاً باحتقار)",
 "flow": "تَدَفُّق / تَدَفَّقَ, سَالَ",
 "flow chart": "مخطط انسيابي, مخطط تدفق (رسم تخطيطي لتسلسل العمليات في برنامج كمبيوتر أو نظام محاسبي)",
 "flow diagram": "مخطط انسيابي, مخطط تدفق (رسم تخطيطي لتسلسل العمليات في برنامج كمبيوتر أو نظام محاسبي)",
 "flow meter": "مقياس التدفق (جهاز يستخدم لقياس معدل تدفق الكتلة أو الحجم لسائل أو غاز)",
 "flow of air": "تدفق الهواء, تيار هوائي (سريان الهواء)\nمثال: عدلت المروحة بحيث يوجه تدفق الهواء نحوها مباشرة",
 "flow rate": "تَدَفُّق, مُعَدَّل التَّدَفُّق (كمية السائل التي تتدفق في وقت معين)",
 "flow sheet": "مخطط انسيابي, مخطط تدفق (رسم تخطيطي لتسلسل العمليات في برنامج كمبيوتر أو نظام محاسبي)",
 "flowage": "غمر, فيضان (عملية الإغراق؛ الملء حتى الفيضان) / مسطح مائي فيضي (مسطح مائي تم إنشاؤه عن طريق غمر منطقة ما عمداً) / انسياب (حركة داخلية تدريجية أو تشوه لجسم صلب (بفعل الحرارة مثلاً))\nمثال: كانت العديد من المخيمات تقع بالقرب من المسطح المائي الفيضي",
 "flowchart": "مخطط انسيابي, مخطط تدفق (رسم تخطيطي لتسلسل العمليات في برنامج كمبيوتر أو نظام محاسبي)",
 "flower": "زَهْرَة, زُهُور / أَزْهَرَ, إِزْدَهَرَ (أزْهَرَ النَّبَات أو الشجرُ: طلَع زهرهُ؛ أزْهَرَ النارَ وغيرَها: أضاءَها)\nمثال: إنني أدرك بحكم دارستي للتاريخ أن الحضارة مدينة للإسلام الذي حمل معه في أماكن مثل جامعة الأزهر نور العلم عبر قرون عدة الأمر الذي مهد الطريق أمام النهضة الأوروبية وعصر التنوير",
 "flower arrangement": "تنسيق الزهور (ترتيب زخرفي للزهور)",
 "flower bed": "حوض زهور (حوض تنمو فيه الزهور)",
 "flower boy": "حامل الزهور (صبي صغير يحمل الزهور في موكب (الزفاف))",
 "flower bud": "برعم زهري (برعم تتطور منه زهرة أو زهور فقط)",
 "flower chain": "سلسلة زهور (زهور مربوطة ببعضها في سلسلة)",
 "flower child": "هِبِّي (شخص يرفض الثقافة السائدة ويدعو إلى الليبرالية المتطرفة في السياسة ونمط الحياة)",
 "flower cluster": "عنقود زهري (نورة تتكون من مجموعة من الزهور)",
 "flower garden": "حَدِيقَة أَزْهَار (الحَديقَةُ، الرَّوْضَةُ ذاتُ الشجرِ؛ حديقة , العاطل عن العمل في اللهجة العراقية وأصل تولد المعنى أن بعض العاطلين يقضون أوقاتهم في العناية بحدائق بيوتهم, فإذا سألهم سائل عن عملهم, ما هو؟…)\nمثال: ليس لدينا حديقة.",
 "flower gardening": "زراعة الزهور (زراعة النباتات المزهرة)",
 "flower girl": "فتاة الزهور (فتاة صغيرة تحمل الزهور في موكب (الزفاف)) / بائعة الزهور (امرأة تبيع الزهور في الشارع)",
 "flower head": "رأس زهري (عنقود مضغوط قصير من الزهور مرتب بحيث يعطي الكل تأثير زهرة واحدة كما في البرسيم أو أفراد الفصيلة المركبة)",
 "flower people": "أطفال الزهور, الهيبيز (ثقافة فرعية شبابية (معظمهم من الطبقة المتوسطة) نشأت في سان فرانسيسكو في الستينيات؛ دعت إلى الحب العالمي والسلام والحياة الجماعية والشعر الطويل…)",
 "flower petal": "بتلة (جزء من الغلاف الزهري يكون عادة زاهي الألوان)",
 "flower power": "قوة الزهور (ثقافة مضادة للشباب في الولايات المتحدة خلال الستينيات والسبعينيات (رمز للسلام والحب))",
 "flower stalk": "شمراخ (ساق زهرة منتصبة بلا أوراق تنمو مباشرة من الأرض كما في الزنبق)",
 "flower store": "متجر بيع الورد, محل زهور (متجر تباع فيه الزهور والنباتات للزينة)",
 "flower-cup fern": "وودسيا ألبية, وودسيا شمالية (سرخس نحيل في شمال أمريكا الشمالية بسويقات بلون الكستناء اللامع وسعف ثنائي الريش مع بثرات بوغية هامشية مميزة عادة)",
 "flower-of-an-hour": "زهرة الساعة, كتمد (عشبة سنوية ضارة بزهور صفراء سريعة الزوال بعين أرجوانية؛ المناطق الاستوائية في العالم القديم؛ متوطنة كعشبة ضارة في أمريكا الشمالية)",
 "flowerbed": "حوض زهور (حوض تنمو فيه الزهور)",
 "flowered": "مُزَهَّر, وَرْدِيّ النَّقْش (يُشبه الأزهار أو مصنوع منها أو يوحي بها)",
 "floweret": "زهيرة (زهرة صغيرة (خاصة تلك التي تكون جزءًا من زهرة مركبة))",
 "flowering": "مُزهر (عندما يكون النبات في حالة امتلاك زهرة واحدة أو متعددة و/أو براعم) / إزهار, تفتح الزهور (وقت وعملية تبرعم وتفتح الزهور) / ازدهار, تفتح (عملية تنموية)\nمثال: نبات مزهر",
 "flowering almond": "كرز الشجيرة الشرقي, لوز مزهر (نبات شرقي خشبي بفاكهة حمراء ملساء غير مجعدة يزرع خاصة لأزهاره البيضاء أو الوردية الشاحبة) / لوز مزهر (شجيرة أو شجرة صغيرة صينية نفضية بأوراق غالباً ما تكون ثلاثية الفصوص تزرع لزهورها الوردية البيضاء)",
 "flowering ash": "مران مزهر (مران شجيري من جنوب غرب الولايات المتحدة له زهور بيضاء عطرة) / مران مزهر (مران شجيري من كاليفورنيا بزهور بيضاء مائلة للصفرة مبهرجة) / مران المن (مران جنوب متوسطي له زهور بيضاء عطرة في عناقيد كثيفة وينتج المن)",
 "flowering cherry": "كرز مزهر",
 "flowering crab": "تفاح بري جنوبي (شجرة صغيرة أو شجيرة من جنوب شرق الولايات المتحدة؛ تزرع للزينة لأزهارها الوردية اللون) / تفاح بيكتل البري (مشتق من تفاح آيوا البري ويزرع لأزهاره الوردية المزدوجة الكبيرة)",
 "flowering fern": "أوسمندا, سرخس مزهر (أي سرخس من جنس أوسمندا: سراخس كبيرة بجذور زاحفة؛ توجد أكياس الأبواغ العارية على سعف معدلة تشبه عناقيد الزهور) / سرخس مزهر (سرخس أسترالاسي بعناقيد من أكياس الأبواغ على سيقان السعف الخصبة)",
 "flowering glume": "عُصَيْفَة (السفلى والأغلظ من بين العصابتين اللتين تحيطان مباشرة بالزهيرة في معظم النجيليات)",
 "flowering hazel": "بندق الشتاء, بندق مزهر (أي من الشجيرات النفضية الآسيوية المتعددة المزروعة لعناقيدها المتدلية من الزهور الصفراء التي تظهر قبل الأوراق)",
 "flowering maple": "أبو طيلون, قيقب مزهر",
 "flowering onion": "ثوم مزهر, ثوم نابولي (بصل أوروبي بزهور بيضاء)",
 "flowering plant": "كاسيات البذور, نباتات مزهرة (نباتات توجد بذورها داخل مبيض مغلق)",
 "flowering quince": "سفرجل مزهر, سفرجل ياباني (شجيرة زينة آسيوية ذات فروع شائكة وأزهار وردية أو حمراء)",
 "flowering raspberry": "توت العليق المزهر (توت شوكي شجيري من شرق أمريكا الشمالية له زهور وردية إلى أرجوانية ملفتة للنظر وفاكهة حمراء أو برتقالية على شكل كشتبان)",
 "flowering shrub": "شجيرة مزهرة (شجيرة تشتهر بزهورها بشكل أساسي)",
 "flowering spurge": "فربيون بري, فربيون مزهر (فربيون معمر شائع في الولايات المتحدة ذو قنابات بيضاء مبهرجة تشبه البتلات)",
 "flowering stone": "الحصى الحية, ليثوبس",
 "flowering tobacco": "تبغ الياسمين, تبغ مزهر (نبات معمر للزينة من أمريكا الجنوبية له زهور بيضاء مخضرة عطرة ليلاً)",
 "flowering tree": "شجرة كاسية البذور, شجرة مزهرة (أي شجرة تحتوي على بذور وبويضات داخل المبيض)",
 "flowering wintergreen": "مستدرة مهدبة, وينترغرين مزهر (مستدرة معمرة زاحفة شائعة في شرق أمريكا الشمالية لها أوراق تشبه الوينترغرين وزهور وردية أرجوانية عادة بسبلات مجنحة)",
 "flowerless": "غير مزهر, لا زهري (بدون زهرة أو برعم ولا ينتج بذورًا)\nمثال: نبات لا زهري",
 "flowerpot": "أَصِيص الزُّهُور, أَصِيص",
 "flowers of zinc": "أكسيد الخارصين, أكسيد الزنك (أكسيد الزنك؛ مسحوق أبيض يستخدم كصبغة أو في مستحضرات التجميل أو الزجاج أو الأحبار وفي مرهم الزنك)",
 "flowers-of-an-hour": "زهرة الساعة, كتمد (عشبة سنوية ضارة بزهور صفراء سريعة الزوال بعين أرجوانية؛ المناطق الاستوائية في العالم القديم؛ متوطنة كعشبة ضارة في أمريكا الشمالية)",
 "flowery": "مُزَخْرَف, مُنَمَّق (يتّسم ببلاغة مُتكلَّفة وتفاصيل زخرفية) / زهري, مورد (مكون من أو متعلق بـ أو موحٍ بالزهور)\nمثال: قبعة زهرية",
 "flowing": "اِنْسِيَابِيّ, دِينَامِيكِيٌّ هَوَائِيًّا (مصمَّم ليقدّم أقلّ مقاومة لتدفّق الهواء أو السوائل) / تدفق, جريان (الحركة المميزة للموائع (السوائل أو الغازات))",
 "floxuridine": "فلوكسوريدين (دواء مضاد للأورام يستخدم لعلاج بعض أنواع السرطان؛ يمكن أن يسبب تساقط الشعر)",
 "flu": "إِنْفْلُوِنْزَا",
 "flub": "خطأ فادح, زلة (خطأ محرج)",
 "fluctuating": "مُتَذَبْذِب, مُتَقَلِّب (يشهد صعودًا وهبوطًا غير قابلَيْن للتنبؤ)",
 "fluctuating exchange rate": "سعر صرف عائم, سعر صرف متقلب (سعر الصرف الذي تحدد فيه قيمة العملة من قبل السوق الحرة)",
 "fluctuation": "تَذَبذُب, تَقَلُّب",
 "flue": "مجرى الدخان, مدخنة (قناة لتصريف الدخان) / أنبوب المداخن, أنبوب شفوي (أنبوب أرغن تنتج نغمته عن طريق مرور الهواء عبر الحافة الحادة لشق أو شفة) / سن المرساة, مخلب المرساة (نتوء مسطح يشبه النصل على ذراع المرساة)",
 "flue pipe": "أنبوب المداخن, أنبوب شفوي (أنبوب أرغن تنتج نغمته عن طريق مرور الهواء عبر الحافة الحادة لشق أو شفة)",
 "flue stop": "موقف الأنابيب الهوائية (في الأرغن) (موقف أرغن بنغمة تشبه أنبوب المزمار)",
 "fluegelhorn": "فلوجل هورن (آلة نحاسية تشبه الكورنيت ولكن بتجويف أوسع)",
 "fluency": "طلاقة, فصاحة (جودة السهولة في الكلام والكتابة) / طلاقة (المهارة في التحدث أو الكتابة) / بيان, طلاقة (لغة قوية وفعالة)\nمثال: جذبت فصاحته حشداً كبيراً",
 "fluent": "طَلِق, فَصِيح (فعل؛ تحرر من القَيْد ونحوه بمعنى حَرْفيّ؛ فعل؛ تحرك بحرية بدون قيد معنى مَجَازيّ)\nمثال: طلق زيري زوجته.",
 "fluent aphasia": "حبسة استقبالية, حبسة حسية (حبسة تتميز بكلام طلق ولكنه لا معنى له وضعف شديد في القدرة على فهم الكلمات المنطوقة أو المكتوبة)",
 "fluently": "بِطَلَاقَة, لِبْلِب",
 "fluff": "نسيان النص, هفوة (خطأ (خاصة نسيان الممثل للسطور)) / زينة رخيصة, شيء تافه (شيء قليل القيمة أو الأهمية) / زغب, وبر (أي مادة ريشية خفيفة)",
 "fluffiness": "زغب, هشاشة (نعومة خفيفة)",
 "fluffy": "رَقِيق كَالزَّغَب, زَغَبِيّ (ناعِم وخَفيف كالرِّيش أو الزَّغَب)",
 "fluffy omelet": "عجة هشة (عجة تشبه السوفليه تُصنع بخفق وإضافة البياض بشكل منفصل)",
 "flugelhorn": "فلوجل هورن (آلة نحاسية تشبه الكورنيت ولكن بتجويف أوسع)",
 "fluid": "سَائِل, مَائِع",
 "fluid drachm": "درهم سائل (وحدة للسعة أو الحجم في نظام الصيدلة تساوي ثُمن الأونصة السائلة) / درهم سائل (مقياس سعة إمبراطوري بريطاني (سائل أو جاف) يساوي 60 مينيماً)",
 "fluid dram": "درهم سائل (وحدة للسعة أو الحجم في نظام الصيدلة تساوي ثُمن الأونصة السائلة) / درهم سائل (مقياس سعة إمبراطوري بريطاني (سائل أو جاف) يساوي 60 مينيماً)",
 "fluid drive": "محرك مائع (قارنة طاقة للسيارات)",
 "fluid flywheel": "حدافة سائلة, قارنة هيدروليكية (نوع من الاقتران السائل تكون فيه الحدافة هي الجزء الدوار الدافع)",
 "fluid mechanics": "ميكانيكا الموائع, هيدروليكا (دراسة ميكانيكا السوائل)",
 "fluid ounce": "أونصة سائلة (وحدة أمريكية للسعة أو الحجم تساوي 1.804 بوصة مكعبة) / أونصة سائلة (وحدة إمبراطورية بريطانية للسعة أو الحجم (سائلة أو جافة) تساوي 8 دراهم سائلة)",
 "fluidity": "انْسِيَابِيَّة, سُيُولَة (صفة متغيرة) / سيولة (خاصية التدفق بسهولة)\nمثال: انسيابية شرقية ساحرة في الأسلوب",
 "fluidized bed boiler": "غلاية القاعدة المميعة (غلاية يتم فيها حرق الوقود في قاعدة مميعة)",
 "fluidness": "انْسِيَابِيَّة, سُيُولَة (صفة متغيرة) / سيولة (خاصية التدفق بسهولة)\nمثال: انسيابية شرقية ساحرة في الأسلوب",
 "fluidounce": "أونصة سائلة (وحدة أمريكية للسعة أو الحجم تساوي 1.804 بوصة مكعبة) / أونصة سائلة (وحدة إمبراطورية بريطانية للسعة أو الحجم (سائلة أو جافة) تساوي 8 دراهم سائلة)",
 "fluidram": "درهم سائل (وحدة للسعة أو الحجم في نظام الصيدلة تساوي ثُمن الأونصة السائلة) / درهم سائل (مقياس سعة إمبراطوري بريطاني (سائل أو جاف) يساوي 60 مينيماً)",
 "fluke": "تريماتودا, مثقوبات (ديدان مفلطحة طفيلية لها ممصات خارجية للالتصاق بالمضيف) / فلق (أي من فصي ذيل الحيتان) / سن المرساة, مخلب المرساة (نتوء مسطح يشبه النصل على ذراع المرساة) / سن الخطاف (شوكة في حربة أو سهم)",
 "flukey": "عُرْضَة لِلْمُصَادَفَة, مُتَقَلِّب (خاضع للحوادث أو المصادفة أو التقلّب)",
 "fluky": "عُرْضَة لِلْمُصَادَفَة, مُتَقَلِّب (خاضع للحوادث أو المصادفة أو التقلّب)",
 "flume": "ساقية, قناة خشبية (مجرى مائي يتكون من منحدر صناعي مفتوح مملوء بالماء لتوليد الطاقة أو لنقل الأخشاب) / شعب, مسيل (مضيق ضيق يمر خلاله جدول مائي)",
 "flummery": "تَمْلِق, طُقُوس فَارِغَة (مراسم وتملق بلا معنى) / فلومري (كاسترد أو بودينغ خفيف خاصة المصنوع من دقيق الشوفان)",
 "flunitrazepam": "روهيبنول, فلونيترازيبام (مهدئ ومثبط (الاسم التجاري روهيبنول) يستخدم غالباً في ارتكاب الاعتداء الجنسي؛ متاح قانونياً في أوروبا والمكسيك وكولومبيا)",
 "flunk": "رسوب, سقوط (الفشل في الوصول إلى الحد الأدنى من الأداء المطلوب)\nمثال: أدى رسوبه في المادة إلى استبعاده",
 "flunkey": "إِمَّعَة, تابِع ذَلِيل (شخص يطيع دون تساؤل) / تابع, خادم ذكر (خادم ذكر (خاصة تابع))",
 "flunky": "إِمَّعَة, تابِع ذَلِيل (شخص يطيع دون تساؤل) / تابع, خادم ذكر (خادم ذكر (خاصة تابع))",
 "fluor": "فلسبار, فلوريت (معدن ناعم (فلوريد الكالسيوم) مشع في الضوء فوق البنفسجي؛ المصدر الرئيسي للفلور)",
 "fluorapatite": "فلورأباتيت (شكل من أشكال الأباتيت يغلب فيه الفلور على الكلور)",
 "fluorescein": "صبغة الفلوريسين, فلوريسين (صبغة صفراء تظهر بوضوح حتى عند تخفيفها بشدة؛ تستخدم كمؤشر امتزاز)",
 "fluorescein isocyanate": "إيزوثيوسيانات الفلوريسين (فلوروكروم يقترن عادة بالأجسام المضادة للاستخدام في التألق المناعي غير المباشر)",
 "fluorescein isothiocyanate": "إيزوثيوسيانات الفلوريسين (فلوروكروم يقترن عادة بالأجسام المضادة للاستخدام في التألق المناعي غير المباشر)",
 "fluoresceine": "صبغة الفلوريسين, فلوريسين (صبغة صفراء تظهر بوضوح حتى عند تخفيفها بشدة؛ تستخدم كمؤشر امتزاز)",
 "fluorescence": "تالق, فلورة (ضوء ينبعث أثناء امتصاص إشعاع ذي طول موجي آخر (غير مرئي))",
 "fluorescence microscopy": "مجهرية تألقية, مجهرية فلورية (المجهر الضوئي الذي يتم فيه تشعيع العينة بأطوال موجية تثير الفلوروكروم)",
 "fluorescent": "فَلْوَرِيّ, مُتَفَلْوِر (يَبْعَث الضَّوْء أَثْنَاء التَّعَرُّض لِإِشْعَاعٍ مِنْ مَصْدَرٍ خَارِجِيّ) / فَلْوَرِيّ, مُتَفَلْوِر (ذو لون ساطع كأنّه يُصدر ضوءاً متفلوراً) / مصباح فلورسنت (وحدة إضاءة تستخدم مصباح فلورسنت)",
 "fluorescent dye": "صبغة الفلوريسين, فلوريسين (صبغة صفراء تظهر بوضوح حتى عند تخفيفها بشدة؛ تستخدم كمؤشر امتزاز)",
 "fluorescent fixture": "مصباح فلورسنت (وحدة إضاءة تستخدم مصباح فلورسنت)",
 "fluorescent lamp": "مصباح فلوري, مصباح نيون (مصباح يتكون من أنبوب مطلي من الداخل بمادة فلورية؛ يبعث بخار الزئبق في الأنبوب أشعة فوق بنفسجية تتحول إلى إشعاع مرئي بواسطة المادة الفلورية)",
 "fluorescent screen": "شاشة فلورية (شاشة شفافة مطلية من جانب واحد بمادة فسفورية تتفلور عند تعرضها للأشعة السينية أو أشعة الكاثود)",
 "fluoridation": "فلورة (إضافة الفلورايد إلى إمدادات المياه (لمنع تسوس الأسنان))",
 "fluoride": "فلوريد (ملح لحمض الهيدروفلوريك)",
 "fluoridisation": "فلورة (إضافة الفلورايد إلى إمدادات المياه (لمنع تسوس الأسنان))",
 "fluoridization": "فلورة (إضافة الفلورايد إلى إمدادات المياه (لمنع تسوس الأسنان))",
 "fluorine": "فُلُور",
 "fluorite": "فلسبار, فلوريت (معدن ناعم (فلوريد الكالسيوم) مشع في الضوء فوق البنفسجي؛ المصدر الرئيسي للفلور)",
 "fluoroboric acid": "حمض الفلوروبوريك (حمض من الفلور والبورون)",
 "fluoroboride": "فلوروبوريد (ملح لحمض الفلوروبوريك)",
 "fluorocarbon": "فلوروكربون (هالوكربون تم فيه استبدال بعض ذرات الهيدروجين بالفلور؛ يستخدم في الثلاجات والبخاخات)",
 "fluorocarbon plastic": "بلاستيك الفلوروكربون (بلاستيك مصنوع باستخدام الفلوروكربون)",
 "fluorochrome": "صبغة مفلورة, فلوروكروم (أي من المواد الفلورية المختلفة المستخدمة في الفحص المجهري الفلوري لصبغ العينات)",
 "fluoroform": "فلوروفورم",
 "fluoroscope": "جهاز كشف بالأشعة, منظار تألقي (آلة أشعة سينية تجمع بين مصدر للأشعة السينية وشاشة فلورية لتمكين المراقبة المباشرة)",
 "fluoroscopy": "تنظير تألقي (فحص هياكل الجسم باستخدام منظار التألق)",
 "fluorosis": "تسمم بالفلور, تفلور (حالة مرضية ناتجة عن التناول المفرط للفلور (عادة من مياه الشرب))",
 "fluorouracil": "فلورويوراسيل (مضاد للمستقلب يستخدم لعلاج بعض أنواع السرطان)",
 "fluorspar": "فلسبار, فلوريت (معدن ناعم (فلوريد الكالسيوم) مشع في الضوء فوق البنفسجي؛ المصدر الرئيسي للفلور)",
 "fluosilicate": "فلوروسيليكات (ملح لحمض الفلوروسيليسيك)",
 "fluosilicic acid": "حمض الفلوروسيليسيك (حمض سام غير مستقر ومسبب للتآكل يعرف أساساً في شكل أملاحه)",
 "fluoxetine": "بروزاك, سارافيم (مثبط استرداد السيروتونين الانتقائي يوصف عادة كمضاد للاكتئاب (الأسماء التجارية بروزاك وسارافيم)؛ يعتقد أنه يعمل عن طريق زيادة نشاط السيروتونين في…)",
 "fluoxetine hydrocholoride": "بروزاك, سارافيم (مثبط استرداد السيروتونين الانتقائي يوصف عادة كمضاد للاكتئاب (الأسماء التجارية بروزاك وسارافيم)؛ يعتقد أنه يعمل عن طريق زيادة نشاط السيروتونين في…)",
 "fluphenazine": "فلوفينازين (مهدئ يستخدم لعلاج الاضطرابات الذهانية)",
 "flurazepam": "دالمان, فلورازيبام (مهدئ (الاسم التجاري دالمان) يستخدم لعلاج الأرق)",
 "flurazepam hydrochloride": "دالمان, فلورازيبام (مهدئ (الاسم التجاري دالمان) يستخدم لعلاج الأرق)",
 "flurbiprofen": "أنسيد, فلوربيبروفين (دواء مضاد للالتهاب غير ستيرويدي (الاسم التجاري أنسيد) يعطى عن طريق الفم فقط)",
 "flurry": "صخب, ضجة (اضطراب نشط وسريع) / هبة ثلجية (تساقط ثلوج خفيف وقصير وهبة رياح (أو ما يشبه ذلك))\nمثال: اضطر لإغلاق النافذة ضد الهبات الثلجية",
 "flush": "شطف (غسل أو نظف الشيء بالماء، غالبًا بمعنى التنظيف العميق؛ في بعض الاستخدامات، يمكن أن تعني إزالة ما علق بالشيء من أوساخ أو شوائب)",
 "flush toilet": "مرحاض دافق (مرحاض يتم تنظيفه من الفضلات عن طريق تدفق المياه عبره)",
 "flush-seamed": "مُتَسَاوِي الدُّرُوز (موضوع حافّة بجانب حافّة (بدون تداخل))",
 "flushed": "مُتَوَرِّد, مُحْمَرّ ((خاصة للوجه) محمر أو مشبع بالدم من الانفعال أو المجهود) / مُتَوَرِّد, وَرْدِيّ الخَدَّيْن (ذو بَشَرَة مُتَوَرِّدَة تَدُلّ عَلى الصِّحَّة)",
 "flushless toilet": "مرحاض بدون دفق (مرحاض يعتمد على البكتيريا لتحليل الفضلات (بدلاً من استخدام الماء))",
 "fluster": "ارتباك, اضطراب (طبع مشوش أو عصبي ومنزعج)",
 "flustered": "مُتَوَتِّر, مُرْتَبِك (أُلقِي في حالة من الاضطراب والارتباك المتهيّج)",
 "flute": "نَاي / أُخْدُود (أخْدُودُ)",
 "flute glass": "كأس شامبانيا طويل, كأس مزماري (كأس نبيذ طويل وضيق)",
 "flute player": "عازف فلوت (شخص يعزف على الفلوت)",
 "fluting": "تحزيز, تخديد (أخدود أو شق في قماش وغيره (وخاصة أخدود مقعر ضحل في بدن العمود))",
 "flutist": "عازف فلوت (شخص يعزف على الفلوت)",
 "flutter": "تمايل, رفرفة (فعل التحرك ذهاباً وإياباً) / خفقان, رفرفة (حركة الرفرفة صعوداً وهبوطاً) / اضطراب, قلاقل (ثوران أو صخب غير منظم) / رفرفة (خفقان سريع غير طبيعي للأذينين في القلب (خاصة بنظم منتظم)؛ يمكن أن يؤدي إلى حصار القلب)\nمثال: لقد ذهلوا من الاضطراب العنيف الذي سببوه",
 "flutter kick": "ركلة رفرفة (ركلة سباحة؛ يتم تحريك الساقين بسرعة صعوداً وهبوطاً دون ثني الركبتين)",
 "fluttering": "خفقان, رفرفة (حركة الرفرفة صعوداً وهبوطاً)",
 "fluvastatin": "فلوفاستاتين, ليسكول (دواء ستاتين الأقل تكلفة (الاسم التجاري ليسكول)؛ يؤخذ عادة عن طريق الفم في وقت النوم)",
 "fluvial": "نَهْرِيّ",
 "flux": "تغير مستمر, تقلب (في تغيير مستمر) / كثافة التدفق ((فيزياء) عدد التغيرات في تدفق الطاقة عبر سطح معين لكل وحدة مساحة) / تدفق, سيلان (جريان أو تصريف) / فيض مغناطيسي, مجال مغناطيسي (خطوط القوة المحيطة بمغناطيس دائم أو جسيم مشحون متحرك)\nمثال: آراؤه في تقلب مستمر",
 "flux applicator": "أداة وضع الصهور (أداة لوضع مادة الصهور (كما في اللحام))",
 "flux density": "كثافة التدفق ((فيزياء) عدد التغيرات في تدفق الطاقة عبر سطح معين لكل وحدة مساحة)",
 "flux density unit": "وحدة كثافة التدفق (مقياس لمقدار التدفق لكل وحدة مساحة مقطعية)",
 "flux unit": "وحدة التدفق (مقياس لقوة المجال المغناطيسي لكل وحدة مساحة)",
 "fluxing lime": "أكسيد الكالسيوم, الجير الحي (أكسيد بلوري أبيض يستخدم في إنتاج هيدروكسيد الكالسيوم)",
 "fluxion": "تدفق, سيلان (جريان أو تصريف)",
 "fluxmeter": "مقياس التدفق المغناطيسي (مقياس يقيس التدفق المغناطيسي عن طريق التيار الذي يولده في ملف)",
 "fly": "ذُبَابَة, دبان (حشرة صغيرة سوداء اللون معروفة) / طَارَ / طار\nمثال: أمسك بتلك الذبابة.",
 "fly agaric": "أمانيت مسكاري, فطر الذباب (فطر غابات سام (ولكن نادراً ما يكون قاتلاً) له قبعة قرمزية مع ثآليل بيضاء وخياشيم بيضاء)",
 "fly ash": "رماد متطاير",
 "fly ball": "فلاي بول, كرة طائرة ((بيسبول) ضربة تطير عالياً في الهواء)",
 "fly bridge": "جسر علوي (أعلى جسر ملاحي على سفينة؛ سطح صغير (غالباً مفتوح) فوق غرفة القيادة)",
 "fly casting": "رمي الذباب الصناعي (رمي ذبابة صناعية كطعم)",
 "fly floor": "ممشى المسرح (منصة ضيقة مرتفعة على جانب المسرح؛ يمكن لعمال المسرح تشغيل الحبال التي تتحكم في المعدات المعلقة)",
 "fly frame": "آلة البرم, إطار السرعة (آلة نسيج تحول الشريط المسحوب إلى خيط مبروم (فتيل))\nمثال: تعطي آلات البرم الشريط المرقق قدراً صغيراً من الالتواء لضمان القوة المطلوبة للفتيل",
 "fly front": "سحاب, فتحة البنطال (فتحة في الملابس يتم إغلاقها بسحاب أو أزرار مخفية تحت طية من القماش)",
 "fly gallery": "ممشى المسرح (منصة ضيقة مرتفعة على جانب المسرح؛ يمكن لعمال المسرح تشغيل الحبال التي تتحكم في المعدات المعلقة)",
 "fly honeysuckle": "صريمة الجدي الأمريكية, عسلة أمريكية (شجيرة أمريكية شمالية متساقطة الأوراق قائمة بزهور بيضاء مصفرة)",
 "fly in the ointment": "شائبة, منغص (إزعاج ينتقص من فائدة شيء ما)",
 "fly orchid": "أوركيد الذباب (أوركيد أوروبي تشبه زهوره الذباب) / أوركيد الذباب (أي من عدة بساتين فاكهة زاحفة قزمة بزهور مشعرة صغيرة غريبة تشبه الحشرات على سيقان نحيلة)",
 "fly poison": "سم الذباب (جميع أجزاء النبات شديدة السمية؛ البصلة تسحق وتستخدم كسم للذباب)",
 "fly press": "مكبس الحدافة, مكبس يدوي لولبي (نوع من المكابس اللولبية يتم فيه تحريك عمود اللولب بواسطة حدافة أو زوج من الأثقال في نهايات قضيب)\nمثال: يمكن تدوير عجلة مكبس الحدافة إما يدوياً أو بواسطة محرك باستخدام اقتران احتكاكي",
 "fly rod": "قصبة صيد الذباب (قصبة صيد طويلة مرنة تستخدم في صيد الأسماك بالذباب الصناعي)",
 "fly sheet": "باب الخيمة, غطاء الخيمة (لسان مكون من قطعة قماش يمكن سحبها للخلف لتوفير مدخل للخيمة)",
 "fly tent": "خيمة بواجهة (خيمة ذات واجهة إضافية)",
 "fly-by": "تحليق استعراضي منخفض (طيران على ارتفاع منخفض (عادة لطائرات عسكرية) فوق المتفرجين على الأرض)",
 "fly-by-night": "عَابِر, قَصِير العُمُر (زائل وقصير الأمد) / غَيْرُ مَوْثُوق, مَشْبُوه تِجَارِيًّا ((يوصف به الشركات وأصحابها) غير جدير بالثقة أو الاعتماد) / مدين هارب, نصاب (مدين يهرب لتجنب الدفع)",
 "fly-fishing": "صيد بالذباب الصناعي (الصيد بالصنارة باستخدام ذبابة صناعية كطعم)",
 "flyaway": "طَائِر, مُنْسَدِل ((في الشعر أو الملابس) يُلْبَس أَوْ يُتْرَك مُنْسَدِلًا) / شَارِد الذِّهْن, مُتَقَلِّب (ينقاد للأهواء والنزوات دون تفكير ثابت)",
 "flyblown": "مَشُوب, مُلَوَّث (مشوَّه خاصة في السُّمعة) / بَائِس, مُزْرٍ (قذر ومتهالك ومنفّر) / مُدَوِّد, مُسَوِّس (فَاسِد وَمُغَطًّى بِبَيْض وَيَرَقَات الذُّبَاب)",
 "flybridge": "جسر علوي (أعلى جسر ملاحي على سفينة؛ سطح صغير (غالباً مفتوح) فوق غرفة القيادة)",
 "flycatcher": "صائد الذباب (طيور أمريكية كبيرة تصطاد الحشرات عادة أثناء الطيران) / صائد الذباب (العالم القديم) (أي من مجموعة كبيرة من الطيور المغردة الصغيرة التي تتغذى على الحشرات التي يتم اصطيادها أثناء الطيران)",
 "flycatching warbler": "هازجة صائدة الذباب (أي من العديد من هازجات الغابات الأمريكية التي تتغذى على الحشرات التي تصطادها أثناء الطيران)",
 "flyer": "طَيَّار (اسم فاعل للمبالغة على وزن فَعَّال؛ الذي يقود الطَائِرَة سواء كانت مهنته أم لا) / نَشْرَة, نَشْرَة إعْلَانِيَّة\nمثال: لم توجه أبدا تهمة القيادة غير المسؤولة للطيار.",
 "flying": "طيران (حالة السفر جواً) / خَاطِف, عَابِر (سريع وقصير؛ على عجل) / سَرِيع الحَرَكَة, طَائِر (يتحرك بسرعة كبيرة)\nمثال: كان الطيران لا يزال مغامرة مثيرة بالنسبة له",
 "flying bird": "طيور جؤجؤية, طيور طائرة (طيور لها عظام صدر جؤجؤية لربط عضلات الطيران)",
 "flying boat": "قارب طائر (طائرة مائية كبيرة تطفو ببدنها في الماء بدلاً من استخدام عوامات)",
 "flying bomb": "القنبلة الطائرة, صاروخ في-1 (صاروخ مجنح صغير يعمل بالدفع النفاث ويحمل قنبلة)",
 "flying bridge": "جسر علوي (أعلى جسر ملاحي على سفينة؛ سطح صغير (غالباً مفتوح) فوق غرفة القيادة)",
 "flying buttress": "دعامة طائرة (دعامة تقف بمعزل عن الهيكل الرئيسي وتتصل به بواسطة قوس)",
 "flying carpet": "بساط الريح ((في الحكايات الشعبية الآسيوية) بساط خيالي يطير بالناس إلى أي مكان يرغبون في الذهاب إليه)",
 "flying cat": "سنجاب طائر عملاق (سنجاب طائر من جزر الهند الشرقية) / ليمور طائر (ثديي شجري ليلي من جنوب شرق آسيا والفلبين يشبه الليمور وله طية من الجلد على كل جانب من الرقبة إلى الذيل تستخدم للقفزات الانزلاقية الطويلة)",
 "flying colors": "تفوق ملحوظ, نجاح باهر (النجاح الكامل)\nمثال: اجتازوا التفتيش بنجاح باهر",
 "flying colours": "تفوق ملحوظ, نجاح باهر (النجاح الكامل)\nمثال: اجتازوا التفتيش بنجاح باهر",
 "flying dragon": "تنين طائر (أي من عدة سحالي آسيوية استوائية صغيرة قادرة على الانزلاق عن طريق نشر أغشية تشبه الأجنحة على جانبي الجسم)",
 "flying drainpipe": "رام جيت, محرك نفاث تضاغطي (نوع بسيط من المحركات النفاثة؛ يجب إطلاقه بسرعة عالية)",
 "flying dutchman": "الْهُولَنْدِي الطَّائِر",
 "flying field": "مطار, مهبط طائرات (مكان تقلع منه الطائرات وتهبط فيه)",
 "flying fish": "سمك طائر (أسماك بحرية استوائية لها زعانف مكبرة تشبه الأجنحة تُستخدم للطيران الانزلاقي القصير)",
 "flying fortress": "القلعة الطائرة",
 "flying fox": "ثعلب طائر (خفاش كبير برأس يشبه رأس الثعلب)",
 "flying gecko": "وزغة طائرة (وزغة لها تمددات غشائية على جانبي جسمها وأطرافها وذيلها تمكنها من الانزلاق لمسافات قصيرة)",
 "flying gurnard": "غرنار طائر (سمكة استوائية ذات زعانف صدرية ضخمة تشبه المروحة للانزلاق تحت الماء؛ لا ترتبط بأسماك الروبن البحرية)",
 "flying jib": "جيب طائر, شراع أمامي طائر (الأبعد للخارج من بين شراعين أو أكثر من أشرعة الجيب)",
 "flying lemur": "ليمور طائر (ثديي شجري ليلي من جنوب شرق آسيا والفلبين يشبه الليمور وله طية من الجلد على كل جانب من الرقبة إلى الذيل تستخدم للقفزات الانزلاقية الطويلة)",
 "flying lizard": "تنين طائر (أي من عدة سحالي آسيوية استوائية صغيرة قادرة على الانزلاق عن طريق نشر أغشية تشبه الأجنحة على جانبي الجسم)",
 "flying mare": "رمية الفرس الطائر (مناورة في المصارعة)",
 "flying marmot": "سنجاب طائر عملاق (سنجاب طائر من جزر الهند الشرقية)",
 "flying mouse": "فأر طائر (كسكس طائر صغير جداً)",
 "flying opossum": "بوسوم طائر, سنجاب طائر (بوسوم ليلي يتحرك بقفزات انزلاقية باستخدام طيات جلدية تشبه المظلة على طول جانبي الجسم)",
 "flying phalanger": "بوسوم طائر, سنجاب طائر (بوسوم ليلي يتحرك بقفزات انزلاقية باستخدام طيات جلدية تشبه المظلة على طول جانبي الجسم)",
 "flying reptile": "تيروصور, زاحف مجنح (زاحف منقرض من العصر الجوراسي والطباشيري له منقار يشبه الطيور وأجنحة غشائية مدعومة بالإصبع الرابع الطويل جداً لكل طرف أمامي)"
}
