 "extraneous": "خَارِجِيّ (من بلاد الخارج؛ من الخوارج)\nمثال: بحث سامي عن مساعدة خارجية.",
 "extraneous duty allowance": "بدل مهام خاصة, بدل واجبات إضافية (بدل يُدفع للموظفين الذين يُكلفون بمهام خاصة أو يؤدون واجبات إضافية)",
 "extraneousness": "خُرُوج عَن المَوْضُوع, غَرَابَة (عدم الارتباط بحكم الوقوع خارج الموضوع المطروح) / دخالة, عدم صلة (حالة عدم تشكيل جزء أساسي أو حيوي)",
 "extraordinarily": "بشكل استثنائي, بشكل مفرط (لدرجة مفاجئة)\nمثال: كانت ذكية بشكل مفرط",
 "extraordinariness": "اسْتِثْنَائِيَّة, غَرَابَة (صفة كون الشيء استثنائياً وغير مألوف)",
 "extraordinary": "اِسْتِثْنَائِيّ, غَيْرُ عَادِيّ",
 "extrapolation": "استقراء خارجي, تنبؤ استقرائي (استدلال حول المستقبل (أو حول موقف افتراضي) بناءً على حقائق وملاحظات معروفة) / إقحام خارجي, استقراء ((رياضيات) حساب قيمة دالة خارج نطاق القيم المعروفة)",
 "extrasensory": "خارق للحواس, خارق للطبيعة (يبدو وكأنه خارج قنوات الحس الطبيعية)",
 "extrasensory perception": "إدراك خارج الحواس, استبصار (قوة ظاهرية لإدراك أشياء غير موجودة للحواس)",
 "extrasystole": "انقباضة خارجية, خوارج الانقباض (انقباض سابق لأوانه يؤدي إلى عدم انتظام ضربات القلب لحظياً)",
 "extrasystolic": "انقباضي إضافي, خارج الانقباض (من أو متعلق بـ أو يحدث أثناء الانقباض الإضافي (خوارج الانقباض))",
 "extraterrestrial": "قَائِم خَارِجَ الْأَرْض / فَضَائِيّ, فَضَائِيَّة",
 "extraterrestrial being": "كائن فضائي, مخلوق فضائي (شكل من أشكال الحياة يُفترض وجوده خارج الأرض أو غلافها الجوي)",
 "extraterrestrial body": "جِسْم خَارِجَ الأَرْض, جِسْم فَضَائِيّ (جسم طبيعي موجود خارج الأرض وخارج الغلاف الجوي للأرض)",
 "extraterrestrial object": "جِسْم خَارِجَ الأَرْض, جِسْم فَضَائِيّ (جسم طبيعي موجود خارج الأرض وخارج الغلاف الجوي للأرض)",
 "extraterritorial": "خارج الإقليم (خارج الحدود الإقليمية أو الولاية القضائية)\nمثال: الصيد في المياه خارج الإقليمية",
 "extrauterine gestation": "حمل خارج الرحم, حمل منتبذ (حمل ناتج عن نمو الجنين في مكان آخر غير الرحم)",
 "extrauterine pregnancy": "حمل خارج الرحم, حمل منتبذ (حمل ناتج عن نمو الجنين في مكان آخر غير الرحم)",
 "extravagance": "إِسْرَاف, تَبْذِير (إسراف؛ أَسْرَفَ: ( فعل ))\nمثال: ورأى أنه — إذا استمر على ذلك الإسراف — أضاع ما بقي من ثروته.",
 "extravagancy": "إسراف, مغالاة (جودة تجاوز الحدود المناسبة للياقة أو الاحتمال أو الحقيقة)\nمثال: فوجئنا بمغالاة وصفه",
 "extravagant": "مُسْرِف",
 "extravagantly": "ببذخ, بسخاء (بطريقة غنية ومسرفة) / بغزارة, بوفرة (بطريقة وفيرة) / بإسراف, ببذخ (بطريقة مبذرة)\nمثال: مزينة ببذخ",
 "extravaganza": "استعراض ضخم, عرض باهر (أي ترفيه فخم أو مذهل)",
 "extravasation": "انصباب, تسرب (عملية نضح أو خروج من وعاء إلى الأنسجة المحيطة؛ يقال عن الدم أو الليمف أو البول) / تدفق, ثوران ((للبراكين) صب الأبخرة أو الحمم (أو الرواسب المتكونة)) / ارتشاح, نضحة (سائل مرتشح (دم أو ليمف أو بول)؛ ناتج عملية الارتشاح خارج الأوعية)",
 "extraversion": "انبساط ((علم النفس) طبع منبسط؛ الاهتمام بما هو خارج الذات)",
 "extraversive": "انبساطي, انفتاحي (موجه للخارج؛ يتميز بالاهتمام بالآخرين أو الواقع الخارجي)",
 "extravert": "اِنْبِسَاطِيّ, مُنْفَتِح (مهتم بالبيئة الاجتماعية والمادية المحيطة) / انْبِسَاطِيّ, شَخْص مُنْفَتِح ((في علم النفس) شخص يهتم بالحقائق العملية أكثر من الأفكار والمشاعر الداخلية)",
 "extraverted": "اِنْبِسَاطِيّ, مُنْفَتِح (مهتم بالبيئة الاجتماعية والمادية المحيطة)",
 "extravertive": "اِنْبِسَاطِيّ, مُنْفَتِح (مهتم بالبيئة الاجتماعية والمادية المحيطة)",
 "extreme": "الْأُقْصَى, الْأَبْعَد / شَدِيد / غَيْر اِعْتِيَادِيّ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به) / خَطِير / مُتَطَرِّف / أَخِير\nمثال: أنا غير متفاجئ.",
 "extreme point": "حد أقصى, نقطة قصوى (النقطة الأبعد عن منتصف شيء ما)",
 "extreme right-winger": "رجعي, يميني متطرف (محافظ متطرف؛ معارض للتقدم أو الليبرالية)",
 "extreme unction": "المسحة الأخيرة, مسحة المرضى (سر كاثوليكي؛ يمسح الكاهن شخصًا يحتضر بالزيت ويصلي من أجل الخلاص)",
 "extremely": "بشدة, جداً (لدرجة قصوى) / بشكل كبير, جداً (إلى درجة أو مدى عال؛ بشكل إيجابي أو باحترام كبير)\nمثال: بارد جداً",
 "extremely high frequency": "تَرَدُّد شَدِيد العُلُوّ (30 إلى 300 جيجاهرتز)",
 "extremely low frequency": "تَرَدُّد مُنْخَفِض جِدّاً (أقل من 3 كيلوهرتز)",
 "extremeness": "تطرف, شدة مفرطة (صفة كون الشيء متطرفاً أو شديداً للغاية)",
 "extremism": "تَطَرُّف, غُلُوّ",
 "extremist": "مُتَطَرِّف, مُتَطَرِّفَة / تَطَرُّفِيّ",
 "extremity": "زائدة, طرف (جزء خارجي من الجسم يبرز منه) / طرف قاصي (ذلك الجزء من الطرف الأبعد عن الجذع) / حد أقصى, طرف (المنطقة أو النقطة الخارجية أو الأبعد) / أقصى درجات, غاية (أعظم أو أقصى درجة)\nمثال: من المهم الحفاظ على دفء الأطراف",
 "extremum": "حد أقصى, نقطة قصوى (النقطة الأبعد عن منتصف شيء ما) / ذروة, قيمة قصوى (المقدار أو القيمة الأكثر تطرفاً (الأقصى))\nمثال: ذروة الجهد",
 "extricable": "قابل للتخليص, يمكن إنقاذه (قادر على أن يتم تخليصه أو إنقاذه)",
 "extrication": "تخليص, فك التشابك (عملية التحرير من حالة تشابك أو تعقيد)",
 "extrinsic": "خارجي, عرضي (لا يشكل جزءاً أساسياً من شيء أو ينشأ أو يأتي من الخارج)\nمثال: أدلة خارجية",
 "extrinsic fraud": "غش خارجي (الاحتيال الذي يمنع طرفاً من معرفة حقوقه أو من الحصول على فرصة عادلة لتقديمها في المحاكمة)",
 "extropic": "إكستروبي, امتدادي (مكون من أو متعلق بالإكستروبيا (عكس الإنتروبيا))",
 "extropy": "إكستروبي (التنبؤ بأن الذكاء البشري والتكنولوجيا سيمكنان الحياة من التوسع بطريقة منظمة في جميع أنحاء الكون)",
 "extrospection": "استبطان خارجي (فحص أو ملاحظة ما هو خارج النفس، على عكس الاستبطان)",
 "extrospective": "انبساطي, خارجي التوجه (ليس استبطانياً؛ يفحص ما هو خارج الذات)",
 "extroversion": "انبساط ((علم النفس) طبع منبسط؛ الاهتمام بما هو خارج الذات)",
 "extroversive": "انبساطي, انفتاحي (موجه للخارج؛ يتميز بالاهتمام بالآخرين أو الواقع الخارجي)",
 "extrovert": "اِنْبِسَاطِيّ, مُنْفَتِح (مهتم بالبيئة الاجتماعية والمادية المحيطة) / انْبِسَاطِيّ, شَخْص مُنْفَتِح ((في علم النفس) شخص يهتم بالحقائق العملية أكثر من الأفكار والمشاعر الداخلية)",
 "extroverted": "منبسط, اِنْبِسَاطِيّ (نَبَاتٌ مُنْبَسِطٌ : مُنْتَشِرٌ؛ مُنْبَسِطٌ عَلَى بَطْنِهِ: مُمْتَدٌّ)",
 "extrovertish": "مَيَّالٌ لِلِانْفِتَاح (يميل إلى الانبساطية والانفتاح بعض الشيء)",
 "extrovertive": "اِنْبِسَاطِيّ, مُنْفَتِح (مهتم بالبيئة الاجتماعية والمادية المحيطة)",
 "extrusion": "بثق, طرد (الإخراج عن طريق تطبيق الضغط) / انتفاخ, بروز (شيء ينتفخ للخارج أو يبرز عن محيطه)\nمثال: خروج غير متوقع لمعجون الأسنان من قاع الأنبوب",
 "extrusive": "انبثاقي, سطحي (من المواد الصخرية؛ تندفع للخارج وهي منصهرة عبر الشقوق في سطح الأرض)",
 "exuberance": "حماس, غزارة (فائض بالمتعة أو الاستحسان الشديد) / حيوية, فيض (حماس مبهج)",
 "exuberant": "زَاخِر, فَيَّاض (يُنتَج أو ينمو بوَفْرة بالغة) / مُبَالَغٌ فِيه, مُفْرِط (بلا قيود، خاصة فيما يتعلق بالمشاعر) / فَيَّاض, مُتَدَفِّق (طافح بالفرح والحيويّة بلا قيود)",
 "exuberantly": "بِجَيَّاشِيَّة, بِحَمَاسَة (بطريقة مفعمة بالحيوية) / بحيوية فائقة, بصخب (بطريقة مفعمة بالحيوية والنشاط المفرط)\nمثال: وعد خروتشوف بحماسة بتوفير صواريخ لحماية كوبا من العدوان الأمريكي",
 "exudate": "إفراز نباتي, نضحة (مادة تنضح من مسام النبات)",
 "exudation": "ارتشاح, نضح (عملية النضح؛ خروج بطيء للسوائل من الأوعية الدموية عبر المسام أو الفجوات في أغشية الخلايا) / إفراز نباتي, نضحة (مادة تنضح من مسام النبات)",
 "exult": "مرح",
 "exultant": "ظَافِر, مُبْتَهِج (فَرِحٌ وَفَخُورٌ خَاصَّةً بِسَبَبِ نَصْرٍ أَوْ نَجَاح)",
 "exultantly": "بِابْتِهَاج, بِزَهْو (بطريقة مليئة بالفرح والانتصار)\nمثال: كان الأمر سهلاً بشكل مبهج",
 "exultation": "ابتهاج, تهلل (تلفظ بأصوات تعبر عن الفرح العظيم) / تهلل, حبور (شعور بالفرح الشديد)",
 "exulting": "ظَافِر, مُبْتَهِج (فَرِحٌ وَفَخُورٌ خَاصَّةً بِسَبَبِ نَصْرٍ أَوْ نَجَاح)",
 "exultingly": "بِابْتِهَاج, بِزَهْو (بطريقة مليئة بالفرح والانتصار)\nمثال: كان الأمر سهلاً بشكل مبهج",
 "exurbia": "ما بعد الضواحي, مناطق شبه ريفية (منطقة سكنية خارج المدينة وأبعد من الضواحي التقليدية)",
 "exuviae": "سَلْخ, مُنْسَلَخَات (الجلود أو الأغطية الملقاة للكائنات الحية المختلفة أثناء الانسلاخ)",
 "exuvial": "انسلاخي (من أو يتعلق بالجلود المنسلخة أو القشور للحيوانات المختلفة)",
 "eyalet": "إِيَالَة",
 "eyas": "فرخ الصقر (صقر صغير لم يكتسِ بالريش بعد أو لا يزال في العش)",
 "eye": "عَيْن, عين (المُعَايَنَة والمشاهدة؛ العين : حاسة البصر والرؤية - مؤنث - تكون للإنسان وغيره من الحيوان . قال ابن السكيت : العين التي يبصر بها الناظر…) / سُمّ, خُرْبَة (في : حرف جواب بمعنى مُرْ يأتي بعد النداء فقط)\nمثال: كان عين ليلى مسودة.",
 "eye bank": "بنك العيون (مكان لتخزين وحفظ القرنيات التي يتم الحصول عليها من الجثث البشرية مباشرة بعد الوفاة؛ تستخدم لزرع القرنية للمرضى الذين يعانون من عيوب القرنية)",
 "eye blink": "رفة عين, رمش (منعكس يغلق ويفتح العينين بسرعة)",
 "eye candy": "بهجة بصرية, متعة للعين (صور بصرية مبهجة للنظر ولكنها غير متطلبة فكرياً)\nمثال: أراد وضع بعض الصور الجذابة بصرياً في موقعهم الإلكتروني",
 "eye chart": "لوحة فحص النظر (لوحة تقرأ من مسافة ثابتة؛ تستخدم كاختبار للرؤية)",
 "eye clinic": "عيادة عيون (عيادة يقدم فيها الأخصائيون الرعاية لعيون المرضى)",
 "eye color": "لون العين (تصبغ قزحية العين)\nمثال: لا تزال وراثة لون العين، مثل لون الشعر، قيد البحث، ومن الواضح أن عدة جينات يمكن أن تعدل النتيجة النهائية",
 "eye colour": "لون العين (تصبغ قزحية العين)\nمثال: لا تزال وراثة لون العين، مثل لون الشعر، قيد البحث، ومن الواضح أن عدة جينات يمكن أن تعدل النتيجة النهائية",
