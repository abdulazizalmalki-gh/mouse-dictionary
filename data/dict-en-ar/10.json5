 "faster": "أسرع (بسرعة أكبر)",
 "fastest": "الأسرع (بأقصى سرعة)",
 "fastidious": "صعب الإرضاء, مدقق (يولي اهتماماً دقيقاً للتفاصيل؛ صعب الإرضاء؛ مهتم بشكل مفرط بالنظافة) / عسير الإرضاء, متطلب (غذائياً) (لديه متطلبات غذائية معقدة؛ خاصة ما ينمو فقط في مزارع اصطناعية خاصة)\nمثال: فكر مدقق وحاد",
 "fastidiously": "بحرص شديد, بدقة متناهية (بطريقة شديدة الاهتمام بالتفاصيل والدقة) / بدأب, بعناية فائقة (بطريقة دقيقة ومجتهدة)\nمثال: يكتب موسيقى موسيقية للغاية، حيث يتم حساب الصوت بدقة متناهية ومع ذلك يبدو عفوياً ومبدعاً بشكل مقبول",
 "fastidiousness": "تنطع, دقة مفرطة (سمة التدقيق المفرط في أمور الذوق أو الأسلوب)\nمثال: أناقة وتدقيق في الملابس",
 "fastigiate": "مُتَراصّ الفُرُوع (ذو عناقيد من الفروع المنتصبة التي تبدو كأنَّها عمود واحد)",
 "fasting": "صَوْم, صِيَام",
 "fastnacht": "فاست ناخت (دونات تؤكل تقليدياً في يوم الثلاثاء البدين)",
 "fastness": "حصن, معقل (هيكل دفاعي محصن بقوة) / ثَبَات, رُسُوخ (صفة التثبيت في المكان كما لو كان بملحق قوي) / سرعة (معدل (عادة سريع) يحدث به شيء ما)\nمثال: تقدم المشروع بسرعة مرضية",
 "fat": "سَمِين, بَدِين / دُهْن (طلى الشيء بالدهن أو الزيت أو الطيب؛ ضرب بالرفق) / شَحْم\nمثال: توم بدهن غرفته.",
 "fat cat": "قط سمين, هامور (شخص ثري ومتميز وذو نفوذ)",
 "fat cell": "خلية دهنية, خلية شحمية (خلايا مكونة من الدهون)",
 "fat chance": "أمل ضعيف, فرصة ضئيلة (فرصة ضئيلة أو معدومة للنجاح)",
 "fat embolism": "انصمام دهني (حالة خطيرة تسد فيها الدهون شرياناً؛ يمكن أن تدخل الدهون مجرى الدم بعد كسر عظم طويل أو في حالة إصابة الأنسجة الدهنية أو نتيجة للكبد الدهني)",
 "fat farm": "منتجع للتخسيس (منتجع صحي يتخصص في مساعدة الناس على إنقاص الوزن)",
 "fat hen": "سبانخ بري, هنري الطيب (نبات أوروبي متوطن في أمريكا الشمالية؛ غالباً ما يجمع من البرية كبقلة)",
 "fat metabolism": "أبض الدهون, استقلاب الشحوم (عملية استقلابية تكسر الدهون المبتلعة إلى أحماض دهنية وغليسرول ثم إلى مركبات أبسط يمكن استخدامها بواسطة خلايا الجسم)",
 "fat person": "بدين, سمين (شخص مستدير الجسم)",
 "fat tail": "أَلْيَة (العَجِيزة أو ما ركبها من شحم ولحم، وتطلق على البشر وعلى الحيوان. يسميها البعض في العاميّة لِيَّة؛ ألية الشاة: قطعة من شحم مغطى بالصوف تحت الذيل أو مكانه تغطي فتحة المخرج)",
 "fat tuesday": "الثلاثاء البدين, ماردي غرا (كرنفال يقام في بعض البلدان في 'ثلاثاء المرفع' (اليوم الأخير قبل الصوم الكبير) وخاصة في نيو أورليانز) / الثلاثاء البدين, ماردي غرا (اليوم الأخير قبل الصوم الكبير)",
 "fat-free": "خالٍ من الدسم, منزوع الدسم (بدون دهون أو مواد صلبة دهنية)\nمثال: حليب خالٍ من الدسم",
 "fat-soluble": "ذَوَّابٌ فِي الدُّهُون (قابل للذوبان في الدهون)",
 "fat-soluble vitamin": "فيتامين قابل للذوبان في الدهون (أي فيتامين قابل للذوبان في الدهون)",
 "fata morgana": "فَاتَا مُورْغَانَا",
 "fatah": "فَتْح, حَرَكَة فَتْح (ضد أغْلَقَ وسَدَّ؛ تركه بلا شيء يسده؛ الطريق: جعلها سالكة للطارقين)\nمثال: فتح الباب آليا.",
 "fatal": "مُمِيت, قَاتِل",
 "fatal accident": "إصابة مميتة, حادث مميت (حادث يتسبب في موت شخص ما)",
 "fatalism": "جبرية (مذهب فلسفي يرى أن جميع الأحداث محددة مسبقاً لكل الأوقات وأن البشر عاجزون عن تغييرها) / إيمان بالقضاء والقدر, قدرية (موقف ذهني خاضع ناتج عن قبول عقيدة أن كل ما يحدث مقدر سلفاً وحتمي)",
 "fatalist": "جبري, قدري (من أو متعلق بالقدرية (الإيمان بالقضاء والقدر المحتوم)) / حتمي, قدري (أي شخص يسلم بالاعتقاد بأنه عاجز عن تغيير قدره)\nمثال: شخص قدري",
 "fatalistic": "جبري, قدري (من أو متعلق بالقدرية (الإيمان بالقضاء والقدر المحتوم))\nمثال: شخص قدري",
 "fatality": "فَتْك, قَضَاء (القدرة على التسبب في الموت أو الكوارث المميتة) / ضحية, وفاة (وفاة ناتجة عن حادث أو كارثة)\nمثال: انخفاض في عدد وفيات السيارات",
 "fatality rate": "مُعَدَّل الوَفَيَات (نسبة الوفيات في منطقة ما إلى سكان تلك المنطقة؛ يُعبر عنها لكل 1000 في السنة)",
 "fatally": "بشكل قاتل, بشكل مميت (بنتائج أو آثار قاتلة)\nمثال: كان مجهزاً بشكل سيء للغاية (قاتل) للتسلق",
 "fatback": "دهن الظهر (لحم مملح من ظهر ذبيحة الخنزير)",
 "fate": "قِسْمَة, مَصِير (في : هو أن أحد العمليات الحسابية الرئيسية، ضد الضَرْب)\nمثال: الزواج قسمة و نصيب.",
 "fated": "مَحْكُوم عَلَيْه, مَقْدُور ((يُتبع عادة بـ 'أن') حدّده القدر المأساويّ)",
 "fateful": "حَاسِم, مَصِيرِيّ",
 "fatefully": "بشكل حاسم, بشكل مصيري (بطريقة مصيرية تنبئ بوقوع أمر جلل)\nمثال: همست الممرضة بشكل مصيري لاستدعاء الكاهن",
 "fatehpur sikri": "فَتْحْبُور سِيكْرِي",
 "fatha": "فَتْحَة (فِي اللُّغَةِ الْعَرَبِيَّةِ (إعراب) : الفَتْحَة أو الفَتْح هي إحدى الحركات التشكيلية في اللغة العربية…؛ الثُّقْب و الْمَنْفَذ)\nمثال: انظر من الفتحة.",
 "fathead": "أحمق, غبي (رجل غبي وغير كفء)",
 "fatheaded": "بَلِيد, غَلِيظ الفَهْم ((غير رسمي) غبيّ وبطيء الفهم)",
 "father": "أَب, وَالِد (الوَالِد و/أو المُرَبِّي، ويُطلق أيضًا على الجَدّ والعَمّ وإن علوا؛ أبو الشّيء هو من كان سببا في إيجاده أو ظهوره) / بَابَا\nمثال: الأب في الغرفة.",
 "father figure": "شخصية أبوية (رجل يتولى جميع وظائف الأب الحقيقي)",
 "father of the church": "أب الكنيسة ((في المسيحية) أي من حوالي 70 لاهوتياً في الفترة من القرن الثاني إلى السابع أسست كتاباتهم العقيدة الرسمية للكنيسة وأكدتها)",
 "father surrogate": "شخصية أبوية (رجل يتولى جميع وظائف الأب الحقيقي)",
 "father's day": "عِيدُ الْأَب",
 "father-figure": "رمز أبوي (رجل (غالباً ما يكون قوياً أو مؤثراً) يثير مشاعر عادة ما يشعر بها المرء تجاه والده الحقيقي ويتماهى معه نفسياً)",
 "father-in-law": "حَم (التنور أو الفرن أو الماء: سجر وسخن وأصبح حارّا؛ الأمر: قُضِيَ وتقدر من الله)\nمثال: أفضل لحم البقر.",
 "fatherhood": "أُبُوَّة (يَأْبُو؛ الأُبُوَّة : صِـفة الأَب ، كون الشّخص أبًا، عَلَاقَة القَرَابَة من الأب، رباطٌ يربط الأب بذريَّته، وتقابلها الأُمُومة)",
 "fatherland": "وطن (أقام بالمكان وكان وَطَنا له)\nمثال: دعاها لحفلة العودة للوطن.",
 "fatherless": "مَجْهُول الأَب (لا يُعْرَف أَبوه أَوْ لَيْسَ لَه أَب شَرْعِيّ) / يَتِيمُ الأَب (لَيْسَ لَهُ أَبٌ عَلَى قَيْدِ الحَيَاة)",
 "fatherlike": "أَبَوِيّ (يَلِيقُ بِالأَبِ أَوِ الأُبُوَّةِ؛ طَيِّبٌ وَحَنُون)",
 "fatherliness": "أُبُوَّة (اللطف والحماية التي تليق بالأب)\nمثال: لطف وأبوة الرجل العجوز الغريب خففت من مخاوفها",
 "fatherly": "أَبَوِيّ",
 "fathom": "قامة",
 "fathomable": "قَابِلٌ لِلسَّبْر, مُمْكِنُ الإِدْرَاك ((يُقال عن المعنى) يمكن النفاذ إليه وفهمه) / قابل لقياس العمق, قابل للسبر ((عن العمق) قادر على أن يسبر أو يقاس عمقه)",
 "fathometer": "مسبار الصدى, مقياس العمق الصوتي (مكتشف العمق لتحديد عمق المياه أو جسم مغمور عن طريق الموجات فوق الصوتية)",
 "fatigability": "قابلية التعب (الاستعداد للتعب؛ الميل للشعور بالتعب أو فقدان القوة)",
 "fatigue": "إِرْهَاق, تَعَب / تَعِبَ (تعِب:ضدّ استراح؛ التَّعَبُ: شدَّةُ العَنَاءِ ضدُّ الراحَة، تَعب يَتْعَبُ تَعَباً: أَعْيَا)\nمثال: شعر توم بالتعب.",
 "fatigue crack": "شق الكلال (شق في المعدن ناتج عن إجهاد المعدن)",
 "fatigue duty": "أعمال السخرة العسكرية (عمل من نوع غير عسكري يقوم به الجنود (تنظيف أو حفر أو صرف وما إلى ذلك))\nمثال: وُضع الجنود في أعمال السخرة لتعليمهم درساً",
 "fatigue fracture": "كسر إجهادي (كسر ناتج عن نشاط مفرط بدلاً من إصابة محددة)",
 "fatigue party": "فريق العمل الشاق (مجموعة من الجنود في مهمة عمل شاق)",
 "fatigued": "مُسْتَنْفَد, مُنْهَكُ القُوَى (نُزِفَتْ طَاقَتُهُ أَوْ فَاعِلِيَّتُهُ؛ مُتْعَبٌ تَمَامًا)",
 "fatigues": "بدلة تمويه, زي ميداني (زي عسكري يرتديه الأفراد العسكريون عند القيام بأعمال شاقة)",
 "fatima": "فَاطِمَة (مؤنث من الفعل فَطَمَ، بمعنى قاطَعَ الطفلَ عن الرَضَاع؛ (في الإسلام) فَاطِمَة بِنْت مُحَمَّد، وهي ابنة النبي محمد من زوجته خديجة، وزوجة الخليفة علي)\nمثال: فاطمة أكبر طالبة في فصلنا.",
 "fatimid": "فَاطِمِيّ",
 "fatism": "تمييز ضد السمنة (التمييز ضد الأشخاص الذين يعانون من زيادة الوزن)",
 "fatless": "خالٍ من الدسم, منزوع الدسم (بدون دهون أو مواد صلبة دهنية)\nمثال: حليب خالٍ من الدسم",
 "fatness": "سمنة, شحم (وزن جسدي زائد)\nمثال: كانت تكره السمنة في نفسها وكذلك في الآخرين",
 "fatso": "بدين, سمين (شخص مستدير الجسم)",
 "fatten": "سَمَّنَ, أَسْمَنَ (الدُهُون التي تؤكل، وتشمل الزُبْد والقِشْطَة وما يستخرج من الحَيْوَان والنبات. قيل السمن من الحيوان والدهن من النبات وقيل السمن ما يؤكل والدهن ما لا…) / سَمِنَ (الدُهُون التي تؤكل، وتشمل الزُبْد والقِشْطَة وما يستخرج من الحَيْوَان والنبات. قيل السمن من الحيوان والدهن من النبات وقيل السمن ما يؤكل والدهن ما لا…)",
 "fattened": "مُسَمَّن, مُعَدّ لِلسُّوق ((عَنْ حَيَوَانَاتِ السُّوقِ) جَاهِزٌ لِلتَّسْوِيقِ)",
 "fattening": "فِي طَوْرِ التَّسْمِين (خَاضِعٌ لِعَمَلِيَّةِ التَّسْمِينِ اسْتِعْدَادًا لِلذَّبْحِ)",
 "fattiness": "تراكم الدهون, شحوم (امتلاك خاصية احتواء الدهون)\nمثال: أوصى بالتمارين لتقليل تراكم الدهون لدي",
 "fattish": "سَمِين نَوْعًا مَا (بَدِين إِلَى حَدٍّ مَا)",
 "fattism": "تمييز ضد السمنة (التمييز ضد الأشخاص الذين يعانون من زيادة الوزن)",
 "fattouch": "فَتُّوش",
 "fatty": "دسم, دهني (يحتوي على أو يتكون من الدهون) / بدين, سمين (شخص مستدير الجسم)\nمثال: طعام دسم",
 "fatty acid": "حمض دهني (أي من فئة الأحماض الكربوكسيلية الأليفاتية الأحادية التي تشكل جزءاً من جزيء الدهون ويمكن اشتقاقها من الدهون عن طريق التحلل المائي)",
 "fatty liver": "كَبِد دُهْنِيّ",
 "fatty oil": "زيت ثابت (زيت حيواني أو نباتي غير متطاير)",
 "fatty tissue": "دهن, شحم (نوع من أنسجة الجسم يحتوي على دهون مخزنة تعمل كمصدر للطاقة؛ كما أنه يوفر توسيداً وعزلاً للأعضاء الحيوية)\nمثال: حماهم النسيج الدهني من البرد القارس",
 "fatuity": "اَلْبَلَاهَة",
 "fatuous": "تَافِه, سَخِيف (بالغ السخافة والحماقة)",
 "fatuously": "ببلاهة, بسخافة (ببلاهة أو رضا عن الذات وحماقة غير واعية)",
 "fatuousness": "سخافة, عبث (حماقة مثيرة للسخرية)\nمثال: ضحك الحشد على سخافة سلوك المهرج",
 "fatwa": "فَتْوَى",
 "fatwah": "فتوى ((في الإسلام) رأي قانوني أو حكم صادر عن عالم إسلامي)\nمثال: أصدر بن لادن ثلاث فتاوى تدعو المسلمين لحمل السلاح ضد الولايات المتحدة",
 "faubourg": "ضاحية, فوبورغ (حي في نيو أورليانز يقع خارج حدود المدينة الأصلية؛ يُستخدم مع أسماء أحياء مختلفة في المدينة)\nمثال: في فوبورغ سانت ماري",
 "faucal": "حلقي (من أو يتعلق بالحلق)",
 "fauces": "برزخ الحلق (الممر بين الجزء الخلفي من الفم والبلعوم)",
 "faucet": "حَنَفِيَّة, صُنْبُور",
 "faucial tonsil": "لوزة, لوزة حنكية (إحدى كتلتين من النسيج اللمفاوي تقعان على جانبي البلعوم الفموي)",
 "fauld": "تنورة درعية, واقي البطن (قطعة من الدرع الصفيحي أسفل الصفيحة الصدرية)",
 "fault": "خَطَأ (تعني ضدّ الصواب. يشمل ذلك الفعل، القول، والرأي. يُستخدم الفعل \"أخطأ\" للدلالة على عدم الإصابة…؛ قام بعمل بعيد عن الصواب أو مخالف للحق سواء كان ذلك في السلوك أو القول أو الكتابة) / صَدْع, فَالِق ((صَدَعَ) النباتُ الأرضَ يَصْدَعَ صَدْعًا: شَقَّها وظَهَرَ منها؛ (صَدَعَ) الزجاجَ ونحوه: كسره)\nمثال: كان خطأ حاسوبي.",
 "fault line": "خط الصدع (كِتَابَة؛ ما يَصِل نقطتين أو أكثر)\nمثال: إرسم خط مستقيم.",
 "fault tolerance": "تَحْمِلُ الْأَخْطَاءُ",
 "faultfinder": "عياب, متشائم (شخص دائم الانتقاد لنوايا الآخرين)",
 "faultfinding": "عَيَّاب, مُتَصَيِّدٌ لِلْأَخْطَاءِ (يميل إلى إيجاد العيوب ولفت الانتباه إليها) / تَذَمُّر, تَصَيُّد الْأَخْطَاء (نقد تافه وغير مبرر ومستمر)",
 "faultily": "بشكل خاطئ, بشكل معيب (بطريقة تنطوي على خطأ)\nمثال: نُسبت هذه التصريحات إليّ بشكل خاطئ",
 "faultiness": "خلل, عيب (حالة كونه معيباً)",
 "faulting": "صدع, فالق ((جيولوجيا) شق في القشرة الأرضية ناتج عن إزاحة جانب واحد بالنسبة للآخر)\nمثال: بنوها فوق صدع جيولوجي مباشرة",
 "faultless": "بِلَا عَيْب, لَا تَشُوبُهُ شَائِبَة (خَالٍ مِنَ العَيْبِ أَوِ الخَطَأ)",
 "faultlessly": "بدون أخطاء, بشكل لا تشوبه شائبة (بدون أي خطأ؛ بطريقة مثالية)\nمثال: حل جميع المسائل بشكل لا تشوبه شائبة",
 "faultlessness": "خلو من العيب, عصمة (جودة كون الشيء بلا خطأ أو عيب)",
 "faulty": "خَاطِئ, غَلَط (يتّسم بالأخطاء؛ لا يتّفق مع النموذج أو القواعد المُقرَّرة) / بِهِ خَلَل, مَعْطُوب (فيه عطب أو خلل)",
 "faun": "فون (إله إيطالي قديم في شكل بشري، بقرون وأذنين مدببتين وذيل ماعز؛ يعادل الساتير اليوناني)",
