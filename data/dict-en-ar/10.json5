 "five hundred": "خُمْسُمِئَة, خَمْسُمِا۟ئَة",
 "five iron": "حديد خمسة, ماشي (مضرب حديدي للمسافات المتوسطة)",
 "five nations": "الأمم الخمس, رابطة الإيروكوا (رابطة لقبائل الإيروكوا تضم في الأصل الموهوك وأونيدا وأونونداغا وكايوغا وسينيكا (الأمم الخمس)؛ بعد عام 1722 انضم إليهم توسكارورا (الأمم الست))",
 "five o'clock": "اَلسَّاعَة اَلْخَامِسَة",
 "five senses": "ٱَلْحَوَاسُّ ٱلْخَمْسُ",
 "five spice powder": "مسحوق الخمس بهارات (توابل صينية مصنوعة بطحن الينسون النجمي والشمر والفلفل والقرنفل والقرفة)",
 "five thousand": "خَمْسَة آلَاف (قيمة عددية تساوي \"٥\"؛ الرقم ما بعد \"أَرْبَعَة\" وقبل \"سِتَّة\")\nمثال: رأيت خمسة رجال.",
 "five-finger": "حشيشة الخمس ورقات, عشبة القوى (أي من النباتات العديدة التي تزرع لزهورها خماسية البتلات؛ وفيرة في المناطق المعتدلة؛ ويزعم أن لها خصائص طبية)",
 "five-fingered maidenhair fern": "كزبرة البئر الأمريكية, كزبرة البئر خماسية الأصابع (سرخس أمريكي شمالي قوي التحمل متفرع راحياً بفروع منحنية متباعدة محمولة على سويقات حمراء داكنة لامعة)",
 "five-flowered gentian": "جنطيانا خماسية الأوراق (جنطيانا من شرق أمريكا الشمالية لها عناقيد من الزهور الزرقاء الشائكة)",
 "five-fold": "خُمَاسِيّ (ذو خمس وحدات أو مكوّنات)",
 "five-hitter": "مباراة بخمس ضربات (مباراة لا يسمح فيها الرامي للفريق المنافس سوى ب5 ضربات)",
 "five-hundredth": "اَلْخَمْسُمِئَةِ (العدد الترتيبي لخمسمئة في العدّ)",
 "five-lobed": "خُمَاسِيّ الفُصُوص (ذو خمسة فصوص)",
 "five-membered": "خُمَاسِيُّ الأَعْضَاء (مُرَكَّبٌ كِيمِيَائِيٌّ لَهُ حَلْقَةٌ مِنْ خَمْسَةِ أَعْضَاء)",
 "five-needled": "ذُو خَمْس إِبَر ((عن الصَّنَوْبَريّات) ذو خمس إبر)",
 "five-petaled": "خُمَاسِيّ البَتَلَات ((في الأزهار) ذو خمس بتلات)",
 "five-petalled": "خُمَاسِيّ البَتَلَات ((في الأزهار) ذو خمس بتلات)",
 "five-point bishop's cap": "ميتيلا خماسية الأسدية (نبات صغير بأوراق في عنقود قاعدي وزهور خضراء صغيرة في عناقيد رفيعة؛ شمال غرب أمريكا الشمالية إلى كاليفورنيا وكولورادو)",
 "five-pointed": "خُمَاسِيّ الرُّؤُوس (ذو خمسة رؤوس مدببة)",
 "five-sided": "خُمَاسِيّ الأَضْلَاع (ذو خمسة أضلاع)",
 "five-spot": "خمسة (ورقة لعب أو حجر دومينو أو نرد يظهر وجهه العلوي خمس نقاط) / ذات الخمس نقط, نيموفيلا (نبات حولي من كاليفورنيا له زهور بيضاء بقعة أرجوانية عميقة على كل بتلة) / ورقة خمسة دولارات (ورقة نقدية أمريكية بقيمة 5 دولارات)",
 "five-star admiral": "أدميرال الأسطول, أدميرال خمس نجوم (أدميرال من أعلى رتبة)",
 "five-year-old": "بِعُمُر خَمْس سَنَوَات (في عامه الخامس من العمر)",
 "fivefold": "خُمَاسِيّ",
 "fivepence": "خمسة بنسات (عملة بقيمة خمسة سنتات)",
 "fiver": "ورقة خمسة دولارات (ورقة نقدية أمريكية بقيمة 5 دولارات)",
 "fives": "فايفز (لعبة تشبه كرة اليد الجدارية؛ تُلعب في ملعب بجدار أمامي وجدارين جانبيين)",
 "fivesome": "خماسي, مجموعة خماسية (خمسة أشخاص يُنظر إليهم كوحدة واحدة) / خَمْسَة, خُمَاسِيّ (العدد الأصلي الذي هو مجموع أربعة وواحد)",
 "fix": "صَلَّحَ / أَصْلَحَ",
 "fix-it shop": "ورشة إصلاح (محل متخصص في الإصلاح والصيانة)",
 "fixation": "تثبيت ((علم الأنسجة) حفظ عينة الأنسجة وتصلبها للاحتفاظ بنفس العلاقات التي كانت لها في الجسم الحي قدر الإمكان) / تثبيت (نشاط تثبيت شيء ما بإحكام في موضعه) / تثبيت, هوس (انشغال قهري وغير صحي بشيء أو شخص ما) / تثبيت, توقف النمو (حالة غير طبيعية يتوقف فيها النمو قبل الأوان)",
 "fixative": "مثبت (ورنيش مذاب في الكحول ويرش على الصور لمنع التلطخ) / مثبت (مركب (مثل الإيثانول أو الفورمالديهايد) يثبت الأنسجة والخلايا للدراسة المجهرية)",
 "fixed": "ثَابِت, مُجَمَّد (لا يمكن تغييره أو تحريكه أو التراجع عنه) / ثَابِت ((عَنْ عَدَدٍ) لَهُ قِيمَةٌ ثَابِتَةٌ وَغَيْرُ مُتَغَيِّرَة) / ثابت, مثبت (موضوع أو مثبت بإحكام في مكانه) / ثَابِت, جَامِد (مثبّت في مكانه ولا يتحرك)\nمثال: قطعة خشب مثبتة",
 "fixed charge": "تكلفة ثابتة, رسم ثابت (رسم دوري لا يتغير مع حجم الأعمال (مثل التأمين أو الإيجار أو مدفوعات الرهن العقاري وغيرها))",
 "fixed cost": "تكلفة ثابتة, رسم ثابت (رسم دوري لا يتغير مع حجم الأعمال (مثل التأمين أو الإيجار أو مدفوعات الرهن العقاري وغيرها))",
 "fixed costs": "تكلفة ثابتة, رسم ثابت (رسم دوري لا يتغير مع حجم الأعمال (مثل التأمين أو الإيجار أو مدفوعات الرهن العقاري وغيرها))",
 "fixed disk": "قرص صلب (قرص مغناطيسي صلب مثبت بشكل دائم في وحدة محرك أقراص)",
 "fixed exchange rate": "سعر صرف ثابت (سعر صرف لعملة حيث قررت الحكومة ربط القيمة بسلعة ثمينة مثل الذهب؛ سعر الصرف الثابت لا يتغير وفقاً لظروف السوق)",
 "fixed intonation": "تنغيم ثابت (تنغيم الآلات ذات لوحة المفاتيح حيث تكون طبقة كل نغمة ثابتة ولا يمكن تغييرها من قبل العازف)",
 "fixed investment trust": "صندوق ائتماني غير تقديري, صندوق استثمار ثابت (صندوق استثمار يمكنه شراء الأوراق المالية المدرجة فقط عند تنظيم الصندوق)",
 "fixed oil": "زيت ثابت (زيت حيواني أو نباتي غير متطاير)",
 "fixed phagocyte": "بلعمية ثابتة (خلية بلعمية لا تدور في الدم ولكنها ثابتة في الكبد أو الطحال أو نخاع العظم وما إلى ذلك)",
 "fixed star": "نَجْم ثَابِت (أي نجم في نظرية بطليموس لحركة الكواكب)",
 "fixed storage": "ذاكرة القراءة فقط, روم ((في علم الحاسوب) ذاكرة يمكن الوصول إلى محتوياتها وقراءتها ولكن لا يمكن تغييرها)",
 "fixed-combination drug": "دواء مركب ثابت (دواء يحتوي على كميات ثابتة من مكونين أو أكثر)",
 "fixed-cycle operation": "عملية ثابتة الدورة (عملية تكتمل في عدد محدد من دورات التنفيذ المنتظمة زمنياً)",
 "fixed-gear drivetrain": "نظام نقل حركة ثابت الترس (نظام نقل حركة بدون آلية العجلة الحرة؛ يستخدم في الدراجات ذات التروس الثابتة)\nمثال: يحتوي نظام نقل الحركة ثابت الترس على ترس القيادة مثبتاً مباشرة بصرة العجلة الخلفية، بحيث لا يستطيع الراكب التوقف عن التبديل",
 "fixed-point notation": "تدوين النقطة الثابتة (نظام عد جذري يُحدد فيه موقع الفاصلة العشرية بالاتفاق)",
 "fixed-point number": "عَدَد بِفَاصِلَة ثَابِتَة (عدد ممثل بتدوين الفاصلة الثابتة)",
 "fixed-point part": "جُزْء عُشْرِيّ, مَانْتِيسَا (الجزء الكسري الموجب من تمثيل اللوغاريتم)",
 "fixed-point representation system": "تدوين النقطة الثابتة (نظام عد جذري يُحدد فيه موقع الفاصلة العشرية بالاتفاق)",
 "fixed-width font": "خط الآلة الكاتبة, خط ثابت العرض (نمط خط يتم فيه إعطاء كل حرف نفس العرض (كما في الآلة الكاتبة))",
 "fixedly": "بتركيز, بثبات (بطريقة ثابتة ومركزة)\nمثال: حدق بي بثبات",
 "fixedness": "ثَبَات, جُمُود (صفة كون الشيء ثابتاً وغير قابل للتغيير) / ثَبَات, رُسُوخ (صفة التثبيت في المكان كما لو كان بملحق قوي) / استقرار, ثبات (البقاء في المكان)\nمثال: أزعجها ثبات نظراته",
 "fixer": "ميثادون (عقار مخدر صناعي مشابه للمورفين ولكنه أقل تسبباً في التعود؛ يستخدم في إزالة السموم من المخدرات والحفاظ على علاج إدمان الهيروين) / وسيط نفوذ (شخص يتدخل لدى السلطات لصالح شخص في ورطة (عادة باستخدام أساليب ملتوية أو غير قانونية مقابل رسوم)) / مرمّم, مصلّح (عامل ماهر يصلح أو يرمم الأشياء) / عامل تثبيت, مثبت (مركب كيميائي يقوم بتثبيت شيء ما (مثل الصبغة أو الصورة الفوتوغرافية))",
 "fixer-upper": "منزل بحاجة لإصلاح (منزل أو مسكن آخر بحاجة إلى إصلاح (عادة ما يُعرض للبيع بسعر منخفض))",
 "fixing": "إصلاح, ترميم (فعل إعادة الشيء إلى حالة العمل) / تثبيت ((علم الأنسجة) حفظ عينة الأنسجة وتصلبها للاحتفاظ بنفس العلاقات التي كانت لها في الجسم الحي قدر الإمكان) / إخصاء, تعقيم الحيوانات (تعقيم الحيوان) / أداة تثبيت, مثبت (قيد يربط بشيء ما أو يثبت شيئاً في مكانه)\nمثال: أخذوه إلى الطبيب البيطري للإخصاء",
 "fixing agent": "عامل تثبيت, مثبت (مركب كيميائي يقوم بتثبيت شيء ما (مثل الصبغة أو الصورة الفوتوغرافية))",
 "fixings": "زينة, لوازم (الملحقات التي تصاحب عادةً (شيئاً ما أو نشاطاً ما)) / مقوم, مكون (طعام يشكل جزءاً من خليط في الطبخ)\nمثال: عشاء رسمي فاخر مع كامل لوازمه",
 "fixity": "ثَبَات, عَدَم قَابِلِيَّة لِلتَّغْيِير (صفة العجز عن التحول) / ثَبَات, رُسُوخ (صفة التثبيت في المكان كما لو كان بملحق قوي)\nمثال: تحدى داروين ثبات الأنواع",
 "fixture": "إصلاح, ترميم (فعل إعادة الشيء إلى حالة العمل) / تجهيزات, تركيبات (جسم مثبت بإحكام في مكانه (خاصة في المنزل)) / ثَبَات, رُسُوخ (صفة التثبيت في المكان كما لو كان بملحق قوي) / زبون معتاد, مرتاد دائم (راعٍ منتظم لمكان ما)\nمثال: مرتاد دائم لمضمار السباق",
 "fizgig": "مفرقعة أزيزة (لعبة نارية تصدر أزيزًا أثناء حركتها) / حربة صيد, رمح الصيد (أداة ذات عمود ورأس شائك تستخدم لصيد الأسماك)",
 "fizz": "مشروب فوار (مشروب فوار (كحولي عادة))",
 "fizzing": "فَوَّار (يصدر فحيحًا وفقاعات بنشاط)",
 "fizzle": "إخفاق تام, فشل ذريع (فشل كامل) / فحيح, هسهسة (صوت احتكاكي (خاصة كتعبير عن عدم الموافقة))\nمثال: كانت المسرحية فشلاً ذريعاً",
 "fizzy": "فَوَّار",
 "fjord": "خَلَل, وَادٍ خِلَالِيّ (أدخل شيئًا بين آخر؛ جعل شيئًا يتخلل شيئًا آخر)",
 "fl": "فليروفيوم (عنصر مشع ما بعد اليورانيوم)",
 "flab": "دهن مترهل, شحم مرتخ (دهون الجسم المترهلة أو الرخوة)",
 "flabbergasted": "مَبْهُوت, مَصْعُوق (كأنه أُصيب بالخرس من شدة الذهول والمفاجأة)",
 "flabbily": "بترهل, برخاوة (بطريقة مترهلة)\nمثال: كانت عضلات الرجل العجوز تتدلى بترهل",
 "flabbiness": "ترهل, رخاوة (ليونة مترهلة)",
 "flabby": "مُتَرَهِّل",
 "flaccid": "رَخْو, مُتَرَهِّل (فَاقِدُ اللِّيَاقَةِ؛ غَيْرُ قَوِيٍّ وَلَا قَادِرٍ عَلَى الجَهْدِ أَوِ التَّحَمُّلِ) / رَخْو, مُتَرَهِّل (لَيِّن ومُتَرَهِّل؛ فاقِد لِلتَّماسُك)",
 "flaccid bladder": "المثانة المرتخية (اضطراب في المثانة البولية ناتج عن انقطاع القوس الانعكاسي المرتبط عادةً بإفراغ البول؛ يتميز بغياب الإحساس بالمثانة وامتلائها الزائد وعدم القدرة على…)",
 "flaccid paralysis": "شلل رخو (ضعف أو فقدان توتر العضلات الناتج عن إصابة أو مرض في الأعصاب التي تغذي العضلات)",
 "flaccidity": "ترهل, رخاوة (ليونة مترهلة)",
 "flack": "مدفع مضاد للطائرات (مدفعية مصممة لإطلاق النار لأعلى باتجاه الطائرات) / انْتِقَاد شَدِيد, هُجُوم (نقد سلبي مكثف) / مروج إعلامي, مسؤول علاقات عامة (متحدث بارع يمكنه تحويل أي انتقاد لصالح صاحب العمل)\nمثال: وجه كلينتون هجومه إلى الحزب الجمهوري",
 "flack catcher": "مروج إعلامي, مسؤول علاقات عامة (متحدث بارع يمكنه تحويل أي انتقاد لصالح صاحب العمل)",
 "flacourtia indica": "برقوق الحاكم, برقوق مدغشقر (شجرة شجيرية صغيرة من مدغشقر تزرع في المناطق الاستوائية كنبات سياج ولثمارها الحمراء الداكنة الحمضية التي تشبه البرقوق الصغير)",
 "flag": "عَلَم, رَايَة (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "flag captain": "قبطان العلم (قبطان سفينة القيادة)",
 "flag carrier": "حَامِلُ رَايَة (اسم فاعل من حَمَلَ، أي الذي يحمل شيئا؛ امرأة حَامِل: حُبْلَى، في بطنها جَنْيِن، وإذا أريد اسم الفاعل يقال للمرأة حَامِلَة)\nمثال: يبدو أنني حامل.",
 "flag day": "14 يونيو, يوم العلم (إحياء لذكرى اعتماد علم الولايات المتحدة عام 1777)",
 "flag of truce": "راية الهدنة, علم أبيض (علم يتكون من قطعة قماش بيضاء تُرفع للإشارة إلى الاستسلام أو لطلب الهدنة)",
 "flag officer": "ضابط علم (ضابط بحري كبير رتبته أعلى من قبطان)",
 "flag rank": "رتبة العلم (رتبة ضابط علم (لواء أو أدميرال))",
 "flag signal": "إشارة العلم, الإشارة بالأعلام (أي من الطرق المتنوعة لاستخدام الأعلام أو الرايات لإرسال الإشارات)\nمثال: سمحت إشارات العلم بالاتصال عن بعد قبل اختراع الراديو وما زالت تستخدم خاصة فيما يتعلق بالسفن",
 "flag smut": "تفحم ورقي (تفحم يصيب أوراق وسيقان الحبوب والأعشاب الأخرى)",
 "flag smut fungus": "فطر تفحم العلم (فطر تفحم يسبب تفحماً في الحبوب والأعشاب الأخرى يؤثر بشكل رئيسي على الأوراق والسيقان ويتميز بسلاسل من البثرات داخل نسيج النبات تتمزق لاحقاً مطلقة كتل…)",
 "flag stop": "محطة توقف صغيرة (محطة سكة حديد صغيرة بين المحطات الرئيسية أو محطة يتوقف فيها القطار فقط عند الإشارة)",
 "flag waving": "تعصب قومي, وطنية استعراضية (نداء يهدف إلى إثارة المشاعر الوطنية)",
 "flag-waver": "شوفيني, متعصب قومي (قومي متطرف ومولع بالحرب)",
 "flagellant": "جلاد الذات (شخص يجلد نفسه كتكفير ديني) / جلاد الذات (شخص يُجلد أو يجلد نفسه للإشباع الجنسي)",
 "flagellate": "أوالي سوطية, سوطيات (أوالي حر المعيشة عادة لا يقوم بالتمثيل الضوئي وله زوائد تشبه السوط؛ بعضها ممرض للبشر والحيوانات الأخرى) / سوطي (له سوط أو يشبهه)",
 "flagellate protozoan": "أوالي سوطية, سوطيات (أوالي حر المعيشة عادة لا يقوم بالتمثيل الضوئي وله زوائد تشبه السوط؛ بعضها ممرض للبشر والحيوانات الأخرى)",
 "flagellated": "سوطي (له سوط أو يشبهه)",
 "flagellated cell": "خلية سوطية (أي خلية أو كائن وحيد الخلية مزود بسوط)",
 "flagellated protozoan": "أوالي سوطية, سوطيات (أوالي حر المعيشة عادة لا يقوم بالتمثيل الضوئي وله زوائد تشبه السوط؛ بعضها ممرض للبشر والحيوانات الأخرى)",
 "flagellation": "جلد, سوط (الضرب بسوط أو حزام أو حبل كشكل من أشكال العقاب) / جلد (الضرب كمصدر للإثارة الجنسية أو الدينية)",
 "flagellum": "سَوْط",
 "flageolet": "فلاجوليت (مزمار) (مزمار صغير بفتحات للأصابع وإبهامين) / فاصولياء فلاجوليه (نوع من الفاصولياء الفرنسية ذات بذور فاتحة اللون؛ عادة ما تكون مجففة)",
 "flagfish": "سمكة العلم, سمكة العلم الأمريكية (سمكة ذات ظهر أزرق داكن وجوانب بيضاء مع خطوط حمراء؛ توجد في مستنقعات وجداول فلوريدا)",
 "flagging": "خَائِرُ القُوَى (ضَعِيفٌ مِنْ شِدَّةِ الإِنْهَاك) / تبليط, رصيف حجري (ممشى من بلاط الحجر) / أحجار التبليط, بلاط حجري (أحجار التبليط (البلاطات) مجتمعة)\nمثال: كان الرصيف الحجري في الحديقة خيالياً جداً",
 "flagitious": "شَنِيع, فَظِيع (بالغ الوحشية أو القسوة بشكل صادم) / شَنِيع, فَاحِش (بَالِغُ الشَّرِّ؛ إِجْرَامِيٌّ فِي أَعْمَاقِه)",
 "flagon": "إبريق بغطاء, قنينة كبيرة (وعاء كبير من المعدن أو الفخار بمقبض وصنبور؛ يستخدم لحمل المشروبات الكحولية (عادة النبيذ))",
 "flagpole": "سَارِيَةْ العَلَم (اسم فاعل مؤنث للفعل \"سَرَى\"؛ العمود الذي يُنصب عليه العلم أو الشراع)",
 "flagrant": "صَارِخ, فَاضِح (سَيِّئٌ وَمُسْتَنْكَرٌ بِشَكْلٍ صَارِخٍ وَفَاضِحٍ)",
 "flagrantly": "بشكل صارخ, بشكل فاضح (بطريقة واضحة وفاضحة)\nمثال: إنه يتجاهل القانون بشكل صارخ",
 "flagroot": "عود الوج, قصب الذريرة (نبات مستنقعات معمر ذو أوراق تشبه السيف وجذور عطرية)",
 "flagship": "سَفِينَةُ الْقَائِد, سَفِينَةُ الْقِيَادَة (مَرْكَبٌ بَحْرِيٌّ لِنَقْلِ الْمُسَافِرِينَ وَالبَضَائِعِ)\nمثال: غادروا السفينة.",
 "flagstaff": "سارية العلم (عمود طويل أو سارية يرفع عليها العلم)",
 "flagstone": "بَلَاط",
 "flagyl": "فلاجيل, ميترونيدازول (دواء مضاد للأوالي (الاسم التجاري فلاجيل) يستخدم لعلاج داء المشعرات وداء الجيارديا)",
 "flail": "مِدرس, مِدرَسة (أداة تتكون من مقبض وعصا حرة التأرجح في نهايته؛ تستخدم في درس الحبوب يدوياً)",
 "flair": "أُسْلُوب مُمَيَّز, تَأَلُّق (أناقة مميزة وعصرية) / ذوق فطري, موهبة فطرية (موهبة طبيعية) / اتساع, انفراج (شكل يتسع للخارج)\nمثال: لديه موهبة في الرياضيات",
 "flak": "مدفع مضاد للطائرات (مدفعية مصممة لإطلاق النار لأعلى باتجاه الطائرات) / انْتِقَاد شَدِيد, هُجُوم (نقد سلبي مكثف) / مروج إعلامي, مسؤول علاقات عامة (متحدث بارع يمكنه تحويل أي انتقاد لصالح صاحب العمل)\nمثال: وجه كلينتون هجومه إلى الحزب الجمهوري",
 "flak catcher": "مروج إعلامي, مسؤول علاقات عامة (متحدث بارع يمكنه تحويل أي انتقاد لصالح صاحب العمل)",
 "flake": "رُقَاقة, شَظِيَّة صغيرة (شظية صغيرة من شيء انفصلت عن الكل) / غَرِيب الْأَطْوَار (شخص ذو شخصية غير عادية أو غريبة) / ندفة الثلج (بلورة من الثلج)\nمثال: أصابت عينه شظية صخرية صغيرة",
 "flakey": "شَاذّ, عَجِيب (غَيْرُ تَقْلِيدِيٍّ أَوْ غَيْرُ مَأْلُوفٍ بِشَكْلٍ لَافِتٍ لِلنَّظَر) / رُقَاقِيّ, مُتَقَشِّر (مصنوع من رقائق أو يتقشر بسهولة) / رقائقي, قشري (مصنوع من أو يشبه الرقائق)\nمثال: صابون رقائقي",
 "flakiness": "تقشر (امتلاك قشور رقيقة هشة أو التكسر إليها) / جنون, خبال (مصطلحات غير رسمية للجنون)",
 "flaky": "شَاذّ, عَجِيب (غَيْرُ تَقْلِيدِيٍّ أَوْ غَيْرُ مَأْلُوفٍ بِشَكْلٍ لَافِتٍ لِلنَّظَر) / رُقَاقِيّ, مُتَقَشِّر (مصنوع من رقائق أو يتقشر بسهولة) / رقائقي, قشري (مصنوع من أو يشبه الرقائق)\nمثال: صابون رقائقي",
 "flambeau": "مشعل (شعلة ملتهبة (مثل تلك المستخدمة في المواكب ليلاً))",
 "flamboyance": "بهرجة, تأنق مفرط (إتقان مفرط وتكلف)\nمثال: كتب بأسلوب منمق للغاية",
 "flamboyant": "مُبَالَغ فِي زَخْرَفَتِهِ, مُتَنَمِّق (مزخرف بإفراط وتكلّف) / بَرَّاق, صَارِخ (يتّسم بالتباهي لكنّه غالبًا عديم الذوق) / بوانسيانا ملكية, زهرة الطاووس (شجرة استوائية مبهرجة أو شجيرة موطنها مدغشقر؛ تزرع على نطاق واسع في المناطق الاستوائية لعناقيدها الضخمة من الزهور القرمزية والبرتقالية؛ تصنف أحياناً…)",
 "flamboyant tree": "زهرة الجنة, زهرة الطاووس (شجيرة استوائية أو شجرة صغيرة لها زهور صفراء إلى برتقالية حمراء مبهرجة؛ تصنف أحياناً في جنس بوانسيانا)",
 "flamboyantly": "ببهرجة, بشكل استعراضي (بطريقة ملونة ومبهرجة)\nمثال: إنه يرتدي ملابس مبهرجة إلى حد ما",
 "flame": "لَهَب, شُعْلَة",
 "flame bush": "تيمبلتونيا, شجيرة المرجان (شجيرة أسترالية لها أوراق بيضاوية مقلوبة بسيطة وزهور قرمزية لامعة)",
 "flame cell": "خلية لهبية (عضو الإخراج في الديدان المسطحة)",
 "flame durrajong": "شجرة اللهب (شجرة جنوب أسترالية لها عناقيد من الزهور القرمزية المتألقة)",
 "flame fish": "سمكة اللهب (سمكة كاردينال توجد في المياه الساحلية الأطلسية الاستوائية)",
 "flame flower": "تالينوم برتقالي, زهرة اللهب (نبات ذو جذور لحمية وسيقان منتصبة بأوراق عصارية ضيقة وزهرة واحدة برتقالية محمرة في كل إبط ورقة علوية؛ جنوب غرب الولايات المتحدة؛ كان الهنود يطبخون…) / تريتوما, زهرة الشعلة",
 "flame nettle": "سجاد, كوليوس",
 "flame pea": "بازلاء اللهب (أي من الشجيرات الصغيرة المتعددة أو الكروم المتعرشة ذات أوراق كاملة أو مفصصة وعناقيد من الزهور الصفراء إلى البرتقالية الحمراء؛ أستراليا)",
 "flame stitch": "غرزة اللهب, غرزة بارجيلو (غرزة تطريز إيتامين تنتج خطوطاً متعرجة)",
 "flame tokay": "توكاي اللهب (عنب مائدة أحمر أرجواني)",
 "flame tree": "أكاسيا حلوة, سنط عنبري (شجيرة شائكة أو شجرة صغيرة من أمريكا الاستوائية؛ تستخدم زهورها الصفراء العطرة في صناعة العطور) / شجرة اللهب (شجرة جنوب أسترالية لها عناقيد من الزهور القرمزية المتألقة) / شجرة الزجاجة عريضة الأوراق, شجرة اللهب (شجرة شمال أسترالية لها زهور بيضاء وأوراق عريضة) / بوانسيانا ملكية, زهرة الطاووس (شجرة استوائية مبهرجة أو شجيرة موطنها مدغشقر؛ تزرع على نطاق واسع في المناطق الاستوائية لعناقيدها الضخمة من الزهور القرمزية والبرتقالية؛ تصنف أحياناً…)",
 "flame-colored": "لَهَبِيّ اللَّوْن (بلون اللهب البرتقالي المحمر الزاهي)",
 "flame-coloured": "لَهَبِيّ اللَّوْن (بلون اللهب البرتقالي المحمر الزاهي)",
 "flame-flower": "تالينوم برتقالي, زهرة اللهب (نبات ذو جذور لحمية وسيقان منتصبة بأوراق عصارية ضيقة وزهرة واحدة برتقالية محمرة في كل إبط ورقة علوية؛ جنوب غرب الولايات المتحدة؛ كان الهنود يطبخون…) / تريتوما, زهرة الشعلة",
 "flame-orange": "بُرْتُقَالِيّ مُحْمَرّ (برتقالي مع مسحة حمراء)",
 "flame-out": "انهيار تام, فشل ذريع (فشل كامل أو لافت للنظر) / انطفاء المحرك, خمود اللهب (فشل المحرك النفاث الناجم عن انقطاع إمدادات الوقود أو الاحتراق الخاطئ)\nمثال: كلف الانهيار المذهل لأسهم الشركة الكثير من الناس مدخرات حياتهم",
 "flame-retardant": "مُقَاوِم لِلَّهَب (مقاوم لالتقاط النار)",
 "flamefish": "سمكة اللهب (سمكة كاردينال توجد في المياه الساحلية الأطلسية الاستوائية)",
 "flameflower": "تالينوم برتقالي, زهرة اللهب (نبات ذو جذور لحمية وسيقان منتصبة بأوراق عصارية ضيقة وزهرة واحدة برتقالية محمرة في كل إبط ورقة علوية؛ جنوب غرب الولايات المتحدة؛ كان الهنود يطبخون…) / تريتوما, زهرة الشعلة",
 "flamen": "فلامن (كاهن كان يخدم إلهاً معيناً في روما القديمة)",
 "flamenco": "فَلَامِنْكُو",
 "flameproof": "مُقَاوِم لِلَّهَب (مقاوم لالتقاط النار)",
 "flamethrower": "قَاذِفَة لَهَب",
 "flaming": "مُتَّقِد, مُلْتَهِب (عاطفيّ أو سريع الغضب) / اشتعال, حريق (عملية احتراق المواد القابلة للاشتعال منتجة حرارة وضوءاً ودخاناً (غالباً))\nمثال: كانت النار واحدة من أولى اكتشافات أسلافنا",
 "flaming poppy": "خشخاش الرياح, خشخاش ملتهب (خشخاش بري في كاليفورنيا بزهور حمراء زاهية)",
 "flamingo": "بَشْرُوش, نُحَام",
 "flamingo flower": "أنتوريوم, زهرة الفلامنغو (نوع من الأنتوريوم يُزرع عادة وله قنابة وطلع قرمزي ساطع)",
 "flamingo plant": "أنتوريوم, زهرة الفلامنغو (نوع من الأنتوريوم يُزرع عادة وله قنابة وطلع قرمزي ساطع)",
 "flammability": "سرعة الاشتعال, قابلية الاشتعال السريع (صفة سهولة الاشتعال والاحتراق بسرعة)",
 "flammable": "سَرِيع الاِشْتِعَال (سهل الاشتعال)",
 "flammulina velutipes": "فطر الشتاء (غاريقون صالح للأكل يتوفر في أوائل الربيع أو أواخر الخريف عندما يقل الفطر الآخر؛ له قبعة برتقالية إلى بنية ملساء لزجة وساق مخملي يتحول إلى الأسود عند…)",
 "flan": "تارت الفواكه, فلان (عجينة فطيرة مفتوحة محشوة بالفاكهة أو الكاسترد)",
 "flanders": "فْلَانْدِر",
 "flanders poppy": "خشخاش الحقول, خشخاش الذرة (خشخاش أوروبي سنوي شائع في حقول الحبوب ويزرع غالباً)",
 "flange": "حافة بارزة, شفة (نتوء يستخدم للتقوية أو للتثبيت بجسم آخر)",
 "flank": "خَاصِرَة, كَشْح / جِنَاح / جَانِب",
 "flank steak": "شريحة الخاصرة (قطعة لحم بقر من خاصرة الحيوان)",
 "flanker": "حامي الجناح (جندي عضو في مفرزة مخصصة لحراسة أجنحة التشكيل العسكري) / ظهير جناح, فلانكر (ظهير يتمركز بعيداً عن خط الاشتباك؛ يُستخدم كمستقبل للتمريرات)",
 "flanker back": "ظهير جناح, فلانكر (ظهير يتمركز بعيداً عن خط الاشتباك؛ يُستخدم كمستقبل للتمريرات)",
 "flannel": "فانيلا (قماش صوفي ناعم وخفيف؛ يستخدم للملابس) / بنطال جبردين, بنطال فلانيل ((عادة بصيغة الجمع) سراويل مصنوعة من الفلانيل أو الجبردين أو التويد أو قماش أبيض) / فوطة وجه, ليفة (بياضات حمام تتكون من قطعة قماش تستخدم لغسل الوجه والجسم)",
 "flannel bush": "شجيرة الفانيلا (أي من الشجيرات دائمة الخضرة الجميلة في كاليفورنيا وشمال المكسيك ذات أوراق مفصصة زغبية وأزهار صفراء مبهرجة)",
 "flannel cake": "بان كيك, فطيرة المقلاة (كعكة مسطحة من عجين رقيق تقلى على كلا الجانبين على صاج)",
 "flannel leaf": "آذان الدب, بوصير",
 "flannel mullein": "آذان الدب, بوصير (بوصير طويل الساق صوفي جداً بزهور صفراء مكتظة بكثافة؛ كان الإغريق والرومان القدماء يغمسون السيقان في الشحم لاستخدامها كمشاعل جنائزية)",
 "flannel-cake": "بان كيك, فطيرة المقلاة (كعكة مسطحة من عجين رقيق تقلى على كلا الجانبين على صاج)",
 "flannelbush": "شجيرة الفانيلا (أي من الشجيرات دائمة الخضرة الجميلة في كاليفورنيا وشمال المكسيك ذات أوراق مفصصة زغبية وأزهار صفراء مبهرجة)",
 "flannelette": "فانيلا قطنية (قماش قطني يقلد الفانيلا)",
 "flap": "رَفْرَف",
 "flapcake": "بان كيك, فطيرة المقلاة (كعكة مسطحة من عجين رقيق تقلى على كلا الجانبين على صاج)",
 "flapjack": "بان كيك, فطيرة المقلاة (كعكة مسطحة من عجين رقيق تقلى على كلا الجانبين على صاج)",
 "flapper": "فتاة متحررة (شابة في العشرينيات من القرن الماضي كانت تتباهى بسلوكها وملابسها غير التقليدية)",
 "flapping": "خفقان, رفرفة (حركة الرفرفة صعوداً وهبوطاً)",
 "flappy": "مرفرف (لديه ميل للرفرفة)",
 "flaps": "قلاب (سطح انسيابي متحرك يعد جزءاً من جناح الطائرة؛ يستخدم لزيادة الرفع أو السحب)",
 "flare": "كرة طائرة قصيرة ((بيسبول) كرة طائرة تضرب لمسافة قصيرة في الملعب الخارجي) / تمريرة جانبية (تمريرة أمامية قصيرة لظهير يركض نحو الخطوط الجانبية) / شعلة ضوئية, مشعل (جهاز ينتج ضوءاً ساطعاً للتحذير أو الإضاءة أو تحديد الهوية) / توهج, وميض (انفجار ضوئي يستخدم للتواصل أو الإضاءة)",
 "flare pass": "تمريرة جانبية (تمريرة أمامية قصيرة لظهير يركض نحو الخطوط الجانبية)",
 "flare path": "مدرج مضاء (مخطط مهبط طائرات بأضواء لتوجيه طيار الطائرة عند الهبوط)",
 "flare star": "نَجْم مُتَوَهِّج (نجم قزم أحمر يمكن أن تتغير درجة لمعانه بمقدار عدة درجات في بضع دقائق)",
 "flare up": "اِنْدَلَعَ",
 "flare-up": "ثَوَرَان",
 "flaring": "مُتَمَوِّج, مُنْتَشِر (يتدفق أو يمتد كما لو كان في تيار هوائي)",
 "flash": "البَرْق",
 "flash bulb": "فلاش, مصباح وميضي (مصباح لتوفير ضوء لحظي لالتقاط صورة فوتوغرافية)",
 "flash butt welding": "لحام تناكبي ومضي, لحام ومضي (لحام تناكبي عن طريق إنشاء قوس كهربائي بين القطعتين مما يصهرهما ويضمهما؛ يستخدم لربط أجزاء الأنابيب المعدنية)",
 "flash camera": "كاميرا بفلاش (كاميرا ملحق بها فلاش ضوئي)",
 "flash card": "بطاقة تعليمية, بطاقة عرض (بطاقة عليها كلمات أو أرقام أو صور يعرضها المعلم للفصل)",
 "flash drive": "فِلَاشَة",
 "flash flood": "سيول مفاجئة, فيضان خاطف (فيضان محلي مفاجئ بحجم كبير ومدة قصيرة)",
 "flash in the pan": "فَقَّاعَة صابُون, نَجاح عابِر (شخص يحقق نجاحاً مؤقتاً سريعاً ثم يفشل)",
 "flash lamp": "فلاش, مصباح وميضي (مصباح لتوفير ضوء لحظي لالتقاط صورة فوتوغرافية)",
 "flash memory": "ذاكرة فلاش (تخزين غير متطاير يمكن مسحه كهربائياً وبرمجته من جديد)",
 "flash mob": "تَجَمُّع مُفَاجِئ, فْلَاش موب (صيغة مطاوعة من جَمَّعَ، جَمَّعته فتجمّع؛ جُمِّعَ لوحده بدون أن يُجَمِّعه أحد)\nمثال: هي تجمع الحواسيب.",
 "flash point": "نقطة الوميض (أدنى درجة حرارة يمكن عندها إشعال بخار سائل قابل للاشتعال في الهواء) / نقطة الانفجار, نقطة الوميض (النقطة التي يكون عندها الشيء جاهزاً للانفجار)",
 "flash welding": "لحام تناكبي ومضي, لحام ومضي (لحام تناكبي عن طريق إنشاء قوس كهربائي بين القطعتين مما يصهرهما ويضمهما؛ يستخدم لربط أجزاء الأنابيب المعدنية)",
 "flash-forward": "استباق للأحداث (انتقال (في الأعمال الأدبية أو المسرحية أو الأفلام) إلى حدث أو مشهد لاحق يقطع التطور الزمني الطبيعي للقصة)",
 "flash-frozen": "مُجَمَّد, مُجَمَّد سَرِيعًا ((عَنِ الأَطْعِمَة) مَحْفُوظ بِالتَّجْمِيد السَّرِيع لِلْحِفَاظ عَلَى النَّكْهَة وَالقِيمَة الغِذَائِيَّة)",
 "flashback": "استرجاع فني, فلاش باك (انتقال (في الأعمال الأدبية أو المسرحية أو الأفلام) إلى حدث أو مشهد سابق يقطع التطور الزمني الطبيعي للقصة) / استرجاع, ومضة استرجاعية (تكرار غير متوقع وحي لتجربة سابقة (خاصة تكرار تأثيرات دواء مهلوس تم تناوله سابقاً))",
 "flashboard": "ألوح تعلية السد, حاجز ومضي (مكان مخصص للألواح على طول قمة السد لزيادة ارتفاعه)",
 "flashboarding": "ألوح تعلية السد, حاجز ومضي (مكان مخصص للألواح على طول قمة السد لزيادة ارتفاعه)",
 "flashbulb": "فلاش, مصباح وميضي (مصباح لتوفير ضوء لحظي لالتقاط صورة فوتوغرافية)",
 "flashcard": "بِطَاقَة إِسْتَذْكَار, بِطَاقَة تَعْلِيمِيَّة",
 "flasher": "غمّاز, وماض (ضوء يضيء وينطفئ؛ يستخدم كإشارة أو لإرسال رسائل) / وماض (جهاز كهربائي يقوم بتشغيل وإيقاف المصباح تلقائياً (كما في شاشات الإعلانات)) / استعراضي (شخص لديه رغبة قهرية في كشف أعضائه التناسلية)",
 "flashflood": "سيول مفاجئة, فيضان خاطف (فيضان محلي مفاجئ بحجم كبير ومدة قصيرة)",
 "flashgun": "فلاش, مصباح وميضي (مصباح لتوفير ضوء لحظي لالتقاط صورة فوتوغرافية)",
 "flashily": "ببهرجة, بشكل استعراضي (بطريقة ملونة ومبهرجة) / بابتذال, ببهرجة كاذبة (بطريقة مبهرجة ومبتذلة)\nمثال: إنه يرتدي ملابس مبهرجة إلى حد ما",
 "flashiness": "بَهْرَجَة, زَخْرَفَة صَارِخَة (الاستعراض المبتذل عديم الذوق)",
 "flashing": "تزرير, صفيحة عزل (صفيحة معدنية مشكلة ومثبتة على سطح لتقويته وحمايته من العوامل الجوية) / بريق, ومضة (تجربة حية قصيرة)\nمثال: اجتاحته ومضة من المشاعر",
 "flashlight": "مَشْعَل",
 "flashlight battery": "بطارية المصباح اليدوي (بطارية جافة صغيرة تحتوي على خلايا جافة؛ تستخدم لتشغيل المصابيح اليدوية)",
 "flashlight fish": "سمك المصباح (سمكة لها عضو مضيء تحت العين؛ من المياه الدافئة لغرب المحيط الهادئ وبورتوريكو) / سمك المصباح (سمكة من المياه العميقة المظلمة لها عضو ضوئي تحت كل عين)",
 "flashover": "انهيار عزل ومضي, وميض كهربائي (تفريغ كهربائي غير مقصود (كما فوق أو حول عازل))",
 "flashpoint": "نقطة الوميض (أدنى درجة حرارة يمكن عندها إشعال بخار سائل قابل للاشتعال في الهواء) / بؤرة توتر, نقطة ساخنة (مكان للاضطرابات السياسية والعنف المحتمل) / نقطة الانفجار, نقطة الوميض (النقطة التي يكون عندها الشيء جاهزاً للانفجار)\nمثال: لا تستطيع الولايات المتحدة مراقبة جميع النقاط الساخنة في العالم",
 "flashy": "صَارِخ, مُبَهْرَج (ذو ألوان صارخة وبرّاقة تجذب الانتباه بشكل مفرط) / صَارِخ, مُبَهْرَج (بَرَّاقٌ وَلَافِتٌ بِطَرِيقَةٍ تَفْتَقِرُ إِلَى الذَّوْق)",
 "flask": "دَوْرَق, زَمْزَمِيَّة",
 "flaskful": "ملء قارورة (الكمية التي تستوعبها قارورة)",
 "flat": "مُسَطَّح",
 "flat arch": "قوس مستقيم, قوس مسطح (قوس ذو أحجار عقد داعمة متبادلة له ظهر وبطن أفقي مستقيم)",
