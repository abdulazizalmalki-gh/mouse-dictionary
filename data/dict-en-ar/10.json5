 "eye surgery": "جراحة العيون (أي إجراء جراحي يتعلق بالعيون)",
 "eye tooth": "ناب (واحدة من الأسنان المخروطية الأربعة المدببة (اثنتان في كل فك) تقع بين القواطع والضواحك)",
 "eye-beaming": "نظرة متألقة (نظرة مشرقة من العين)",
 "eye-catcher": "جاذب للبصر, ملفت للنظر (شخص أو شيء لافت يجذب الانتباه)",
 "eye-catching": "جَاذِبٌ لِلنَّظَرِ, لَافِتٌ لِلِانْتِبَاهِ (يَسْتَحْوِذُ عَلَى الِانْتِبَاهِ)",
 "eye-deceiving": "خَادِعٌ لِلعَيْن (يخلق وَهْم رؤية الواقع عبر الخداع البصري)",
 "eye-drop": "قطرة عين (طريقة لغسل العين يستخدمها أطباء العيون) / قطرة عين (قطرة من قطارة العين)",
 "eye-lotion": "غسول العين, كحل سائل (غسول يتكون من محلول يستخدم كمنظف للعيون)",
