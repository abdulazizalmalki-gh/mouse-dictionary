 "exotic belly dancer": "راقصة شرقية (امرأة تؤدي الرقص الشرقي المنفرد)",
 "exotic dancer": "راقصة شرقية (امرأة تؤدي الرقص الشرقي المنفرد) / راقصة تعري, متعرية (فنانة تقدم ترفيهاً مثيراً بخلع الملابس على أنغام الموسيقى)",
 "exoticism": "غَرَائِبِيَّة (صفة كون الشيء غريباً ومثيراً)\nمثال: أحب غرائبية مصر",
 "exoticness": "غَرَائِبِيَّة (صفة كون الشيء غريباً ومثيراً)\nمثال: أحب غرائبية مصر",
 "exotism": "غَرَائِبِيَّة (صفة كون الشيء غريباً ومثيراً)\nمثال: أحب غرائبية مصر",
 "exotoxin": "ذيفان خارجي (ذيفان تفرزه الكائنات الدقيقة في الوسط المحيط)",
 "exotropia": "حول خارجي, حول وحشي (حول تتجه فيه إحدى العينين أو كلتيهما إلى الخارج)",
 "expand": "تَوَسَّعَ",
 "expandability": "قابلية التمدد (خاصية فيزيائية للغازات، تشير إلى أنها تتمدد لملء حاوياتها)\nمثال: كان يأمل في إثبات وجود أثير عالمي من خلال دراسات مفصلة لقابلية انضغاط وتمدد الغازات",
 "expandable": "قَابِلٌ لِلتَّمَدُّد ((عن الغازات) قابل للتمدّد والتوسّع) / قَابِل لِلتَّمَدُّد, قَابِل لِلتَّوْسِيع (يمكن توسيعه أو تمديده)",
 "expanded": "ممتد, موسع (زايد في المدى أو الحجم أو الضخامة أو النطاق)",
 "expanded glass": "زجاج خلوي, زجاج رغوي (زجاج خفيف ومعتم يحتوي على خلايا هوائية، يُصنع بإضافة مسحوق الكربون إلى الزجاج المسحوق وحرق الخليط)\nمثال: يستخدم الزجاج الخلوي للعزل",
 "expander": "ممدد (جهاز إلكتروني يزيد النطاق الديناميكي للإشارة الصوتية)",
 "expandible": "قَابِلٌ لِلتَّمَدُّد ((عن الغازات) قابل للتمدّد والتوسّع) / قَابِل لِلتَّمَدُّد, قَابِل لِلتَّوْسِيع (يمكن توسيعه أو تمديده)",
 "expanding upon": "إسهاب, توسع (إضافة معلومات أو تفاصيل)",
 "expanse": "امتداد, رقعة واسعة (نطاق واسع) / مساحة, منطقة (امتداد سطح ثنائي الأبعاد محصور داخل حدود) / امتداد, فسحة (مساحة واسعة ومفتوحة أو منطقة مثل السطح أو الأرض أو السماء)\nمثال: امتداد السهول",
 "expansible": "قَابِلٌ لِلتَّمَدُّد ((عن الغازات) قابل للتمدّد والتوسّع) / قَابِل لِلتَّمَدُّد, قَابِل لِلتَّوْسِيع (يمكن توسيعه أو تمديده)",
 "expansile": "قَابِلٌ لِلتَّمَدُّد ((عن الغازات) قابل للتمدّد والتوسّع)",
 "expansion": "تَمَدُّد / تَوَسُّع",
 "expansion bit": "ريشة حفر متمددة, ريشة قابلة للتوسيع (ريشة بشفرة قطع يمكن ضبطها لأحجام مختلفة)",
 "expansion bolt": "مسمار تمدد (فيشر) (مسمار له ملحق يتمدد عند دفع المسمار داخل سطح ما)",
 "expansion slot": "شق, فتحة ((حاسوب) مقبس في الحاسوب المصغر يقبل لوحة دوائر إضافية)\nمثال: يحتوي الحاسوب على ثلاث فتحات لذاكرة إضافية",
 "expansionism": "تَوَسُّعِيَّة",
 "expansionist": "توسعي (من أو يتضمن أو يسترشد بسياسة التوسع)",
 "expansive": "بَشُوش, مُنْطَلِقٌ فِي الحَدِيث (ودود ومنفتح ومستعدّ للحديث) / تَوَسُّعِيّ, مُتَعَاظِم (يَتَّسِم بمشاعر مُبَالَغ فيها من النَّشوة وأوهام العظمة) / تمددي, توسعي (قادر أو يميل للتمدد أو يتميز بالتوسع) / طَمُوح, وَاسِع النِّطَاق (من السلوك المُثير للإعجاب والطموح في الحجم أو النطاق)\nمثال: مواد تمددية",
 "expansive bit": "ريشة حفر متمددة, ريشة قابلة للتوسيع (ريشة بشفرة قطع يمكن ضبطها لأحجام مختلفة)",
 "expansively": "بِجَيَّاشِيَّة, بِحَمَاسَة (بطريقة مفعمة بالحيوية) / ببحبوحة, بسعة (بطريقة واسعة ومرفهة بشكل لافت)\nمثال: وعد خروتشوف بحماسة بتوفير صواريخ لحماية كوبا من العدوان الأمريكي",
 "expansiveness": "اندفاع في الكلام, فيض عاطفي (سمة ودية منفتحة لشخص ثرثار) / اتِّسَاع, بَذَخ (صفة تتميز بضخامة المقياس أو الميل للتوسع)\nمثال: بذخ أسلوب حياتهم المسرف تم تقليصه قريباً",
 "expansivity": "اندفاع في الكلام, فيض عاطفي (سمة ودية منفتحة لشخص ثرثار) / اتِّسَاع, بَذَخ (صفة تتميز بضخامة المقياس أو الميل للتوسع) / قَابِلِيَّة التَّمَدُّد, مُعَامِل التَّمَدُّد (التغير النسبي في الطول أو المساحة أو الحجم لكل وحدة تغير في درجة الحرارة عند ضغط ثابت معين)\nمثال: بذخ أسلوب حياتهم المسرف تم تقليصه قريباً",
 "expat": "مغترب, منفي (شخص غائب طواعية عن وطنه أو بلده)\nمثال: المغتربون الأمريكيون",
 "expatiation": "إسهاب, استفاضة (مناقشة (منطوقة أو مكتوبة) تتوسع في موضوع أو فكرة بإسهاب أو بالتفصيل)",
 "expatriate": "مُغْتَرِب",
 "expatriation": "نزوح, هجرة خارجية (الهجرة من مكان (خاصة الهجرة من بلدك الأصلي للاستقرار في بلد آخر)) / تغريب, نفي (فعل طرد شخص من وطنه)\nمثال: الرجال في المنفى يحلمون بالأمل",
 "expect": "تَوَقَّعَ",
 "expectable": "مُتَوَقَّع, مُحْتَمَل (مما يُتَوَقَّع حدوثه)",
 "expectancy": "ترقب, توقع (شيء متوقع حدوثه (بناءً على معيار معين)) / ترقب, توقع (توقع حدوث شيء)\nمثال: كان لكل منهم توقعاته الخاصة",
 "expectant": "حُبْلَى فِي شَهْرِهَا الأَخِير, عَلَى وَشْك الوِلَادَة (في مرحلة متقدمة من الحمل) / مُتَرَقِّب, مُتَلَهِّف (يتَّسم بترقُّب شديد وتلهُّف)",
 "expectantly": "بِتَرَقُّب (بطريقة متوقعة)\nمثال: نظرت إليه بترقب",
 "expectation": "أفق, استشراف (اعتقاد بشأن المستقبل (أو تصور ذهني له)) / توقع رياضي, قيمة متوقعة (مجموع قيم متغير عشوائي مقسوماً على عدد القيم) / توقع (الشعور بأن شيئاً ما على وشك الحدوث) / ترقب, توقع (الترقب مع الثقة بالتحقق)",
 "expected": "متوقع, منتظر (يعتبر محتملاً أو مرجح الحدوث أو الوصول)\nمثال: استعد للهجوم المتوقع",
 "expected value": "قِيمَة مُتَوَقَّعَة",
 "expectedness": "تَوَقُّع (العادية كنتيجة لكون الشيء متوقعاً وغير مفاجئ) / اعتيادية, شيوع (حالة كون الشيء ملاحظاً بشكل شائع)",
 "expectorant": "طارد للبلغم, مقشع (دواء يعزز طرد البلغم)",
 "expectoration": "بصق (فعل البصق (طرد اللعاب بقوة)) / بصق, تقشع (عملية السعال والبصق)",
 "expectorator": "طارد للبلغم, مقشع (دواء يعزز طرد البلغم) / بَاصِق (شخص يبصق (يخرج اللعاب أو البلغم من الفم))",
 "expedience": "انتهازية (استغلال الفرص دون النظر للعواقب على الآخرين) / مَصْلَحَة ظَرْفِيَّة, مُلَائَمَة (صفة كون الشيء مناسباً للغابة المنشودة)",
 "expediency": "مَصْلَحَة ظَرْفِيَّة, مُلَائَمَة (صفة كون الشيء مناسباً للغابة المنشودة)",
 "expedient": "مُنَاسِب, مُلَائِم",
 "expediently": "بشكل انتهازي, نفعياً (بطريقة تخدم المصلحة أو الغرض الآني بغض النظر عن المبادئ)",
 "expedition": "بعثة, حملة (رحلة منظمة لغرض معين) / رحلة ترفيهية, نزهة (رحلة تُتخذ للمتعة) / بعثة, حملة عسكرية (حملة عسكرية مصممة لتحقيق هدف محدد في بلد أجنبي) / سرعة الإنجاز, كفاءة (خاصية كونه سريعاً وفعالاً)\nمثال: العديد من النزهات الصيفية إلى الشاطئ",
 "expeditionary": "اسْتِكْشَافِيّ, حَمْلِيّ ((لِلْقُوَّاتِ العَسْكَرِيَّة) مُصَمَّمٌ لِلْعَمَلِيَّاتِ العَسْكَرِيَّةِ فِي الخَارِج)",
 "expeditious": "سَرِيعٌ وَفَعَّال (يتميّز بالسرعة والكفاءة)",
 "expeditiously": "بِفَعَّالِيَّة, بِكَفَاءَة (مع الكفاءة؛ بطريقة فعالة)\nمثال: يعمل بكفاءة",
 "expeditiousness": "سرعة الإنجاز, كفاءة (خاصية كونه سريعاً وفعالاً)\nمثال: تم إنجازه بسرعة وكفاءة",
 "expel": "طَرَدَ, نَفَى",
 "expelling": "إفراز, انبعاث (أي من العمليات الجسدية العديدة التي تخرج بموجبها المواد من الجسم)\nمثال: خروج الصديد",
 "expendable": "قَابِل لِلإِنْفَاق ((عَنِ الأَمْوَال) المُتَبَقِّيَة بَعْدَ الضَّرَائِب) / قابل للاستهلاك, يمكن التضحية به (مناسب للاستهلاك أو التضحية به)",
 "expender": "صَارِف, مُنفِق (شخص ينفق المال لشراء السلع أو الخدمات)",
 "expending": "إنفاق, نفقات (عملية إنفاق المال على السلع أو الخدمات)",
 "expenditure": "صَرْف (بمعنى أبْعَدَ عن القَصْد أو الغَايَة أو محل الاهتمام؛ بمعنى اَنْفَقَ المَال وبمعنى الرَدّ والمَنْع) / مَصَارِيف, تَكَالِيف\nمثال: أيمكنك صرف خمسين؟",
 "expense": "صَرْف, مَصْرُوف (بمعنى أبْعَدَ عن القَصْد أو الغَايَة أو محل الاهتمام؛ بمعنى اَنْفَقَ المَال وبمعنى الرَدّ والمَنْع)\nمثال: أيمكنك صرف خمسين؟",
 "expense account": "حساب المصروفات, حساب النفقات (حساب يمكن لمندوبي المبيعات أو المديرين التنفيذيين تحميل نفقات السفر والترفيه عليه)",
 "expense record": "سجل النفقات (سجل مكتوب للأموال التي تم إنفاقها)",
 "expensive": "غَالٍ, الْغَالِي",
 "expensively": "بشكل باهظ, بشكل مكلف (بطريقة ذات تكلفة عالية)\nمثال: رجل صغير يرتدي ملابس باهظة الثمن انحرف عند الزاوية واقترب منها",
 "expensiveness": "ارتفاع الثمن, غلاء (صفة كونه باهظ الثمن)",
 "experience": "خِبْرَة, تَجْرِبَة (مصدر للفعل خَبَرَ؛ القاعُ يُنبت السِّدْر والأراك) / اِخْتِبَار (اختبر الشّيء:خبره) / خِبْرَة (مصدر للفعل خَبَرَ؛ القاعُ يُنبت السِّدْر والأراك)\nمثال: زيري عنده خبرة.",
 "experienced": "خبير, ذو خبرة (لديه خبرة؛ لديه معرفة أو مهارة من الملاحظة أو المشاركة)",
 "experient": "خبير, ذو خبرة (لديه خبرة؛ لديه معرفة أو مهارة من الملاحظة أو المشاركة)",
 "experiential": "خِبْرَاتِيّ, وُجُودِيّ (مُستمَدّ من الخبرة أو تجربة الوجود) / تجريبي, خبراتي (يتعلق بالخبرة أو ناتج عنها)\nمثال: واقع شخصي وتجريبي",
 "experiment": "تَجْرِبَة, اِخْتِبَار / جَرَّبَ (أَصابَهُ الجَرَب؛ السَّيْفُ: صَدِئَ)\nمثال: جرب هذا الكسكس.",
 "experimental": "تَجْرِيبِيّ, رَصْدِيّ (يعتمد على الملاحظة أو التجربة) / اِخْتِبَارِيّ, تَجْرِيبِيّ (ذو طبيعة تجريبية أو يخضع لتجربة) / تجريبي (يتعلق بالتجربة أو يعتمد عليها)\nمثال: فيزياء تجريبية",
 "experimental condition": "حالة تجريبية, شرط تجريبي (الإجراء الذي يتم تنويعه من أجل تقدير تأثير متغير ما بالمقارنة مع حالة التحكم)",
 "experimental extinction": "انطفاء, انطفاء تجريبي (عملية إشراط يتم فيها إزالة المعزز وتصبح الاستجابة الشرطية مستقلة عن المحفز الشرطي)",
 "experimental method": "المنهج التجريبي (استخدام الملاحظات والقياسات المضبوطة لاختبار الفرضيات)",
 "experimental procedure": "إجراء تجريبي (التقنيات المحددة المستخدمة في إجراء تجربة معينة)",
 "experimental psychology": "علم النفس التجريبي (فرع علم النفس الذي يستخدم الأساليب التجريبية لدراسة القضايا النفسية)",
 "experimental variable": "متغير تجريبي, متغير مستقل ((إحصاء) متغير تكون قيمه مستقلة عن التغيرات في قيم المتغيرات الأخرى)",
 "experimentalism": "تجريبية (مذهب تجريبي يدعو إلى مبادئ تجريبية) / تجريبية (توجه يفضل التجريب والابتكار)\nمثال: غالباً ما ينشأ أطفال علماء النفس في جو من التجريبية",
 "experimentally": "تجريبياً (بأسلوب تجريبي)\nمثال: يمكن تحديد هذا تجريبياً",
 "experimentation": "اختبار تجريبي, تجربة (فعل إجراء اختبار أو تحقيق تحت ظروف محكومة) / تجربة, تجريب (اختبار فكرة ما)\nمثال: كانت تجربة في الحياة",
 "experimenter": "مُجرِّب (باحث يجري تجارب) / مُجَرِّب (شخص يستمتع باختبار أفكار مبتكرة)\nمثال: كانت مجربة لأشكال جديدة من الشعر",
 "experimenter bias": "انحياز المجرب ((علم النفس) انحياز يُدخله المجرب الذي قد تنقل توقعاته حول نتائج التجربة بمهارة إلى المشاركين في التجربة)",
 "expert": "خَبِير, مَاهِر (الخَابِر الذي يعرف خَبَر الشيء؛ المُخْتَصّ بالشيء ويعرف كل شيء عنه) / مُتَخَصِّص, مُتَخَصِّصَة\nمثال: درب على يد خبير.",
 "expert witness": "شاهد خبير (شاهد لديه معرفة لا يمتلكها عادة الشخص العادي فيما يتعلق بالموضوع الذي سيشهد حوله)",
 "expertise": "تخصص, خبرة (المهارة بفضل امتلاك معرفة خاصة)",
 "expertly": "بخبرة, بمهارة (بطريقة خبيرة)\nمثال: أصلح التلفاز بمهارة",
 "expertness": "تخصص, خبرة (المهارة بفضل امتلاك معرفة خاصة)",
 "expiable": "قَابِلٌ لِلتَّكْفِير (يُمْكِنُ التَّكْفِيرُ عَنْه)",
 "expiation": "كَفَّارَة",
 "expiative": "استرضائي, كفاري (له قوة التكفير عن الذنب أو يُقدم ككفارة أو استرضاء)\nمثال: تضحية تكفيرية (أو استرضائية)",
 "expiatory": "استرضائي, كفاري (له قوة التكفير عن الذنب أو يُقدم ككفارة أو استرضاء)\nمثال: تضحية تكفيرية (أو استرضائية)",
 "expiration": "إخراج النفس, زفير (فعل إخراج الهواء من الرئتين) / رحيل, فقدان (تعبيرات ملطفة للموت) / انتهاء, انقضاء (وصول فترة العقد إلى نهايتها)\nمثال: نعى الآلاف رحيله",
 "expiratory": "زفيري (من أو متعلق بمرحلة إخراج الهواء في التنفس)",
 "expired": "منتهي الصلاحية, منقضٍ (وصل إلى نهاية أو أصبح باطلاً بعد مرور فترة زمنية)\nمثال: جواز سفر منتهي الصلاحية",
 "expiry": "منية, موت (حدث الوفاة أو الرحيل عن الحياة) / انتهاء, انقضاء (وصول فترة العقد إلى نهايتها)\nمثال: جاء موتها كصدمة مروعة",
 "expiry date": "تاريخ انهاء الصلاحية (جملة الأَحوال والأحداث التي يمر بها كائن ما، ويَصْدق على الفرد والمجتمع، كما يَصْدق على الظواهر الطبيعية والإنسانية؛ هو تحديد الزمن باليَوْم والشَهْر والسَنَة أو ببعضهما. الأجَل أو الوَقْت)\nمثال: ما تاريخ اليوم؟",
