 "fibril": "خيط دقيق, لييفة (ليفة طبيعية أو اصطناعية رفيعة جداً)",
 "fibrillation": "تليف (عملية أو إجراء تشكيل ليفيات) / رجفان (ارتعاش عضلي يشمل ألياف عضلية فردية تعمل دون تنسيق)",
 "fibrillose": "لييفي (مغطى بلييفات موزعة بانتظام تقريباً)",
 "fibrin": "فيبرين (بروتين ليفي أبيض غير قابل للذوبان يتكون بفعل الثرومبين على الفيبرينوجين عند تخثر الدم)",
 "fibrinase": "فيبريناز (في تخثر الدم يحفز الثرومبين العامل الثالث عشر إلى شكله النشط (فيبريناز) مما يسبب تكوين الفيبرين لجلطة مستقرة)",
 "fibrinogen": "فيبرينوجين (بروتين موجود في بلازما الدم؛ يتحول إلى فيبرين عندما يتجلط الدم)",
 "fibrinolysin": "بلازمين (إنزيم يذيب الفيبرين في جلطات الدم)",
 "fibrinolysis": "انحلال الفبرين (عملية طبيعية مستمرة تذيب الفبرين وتؤدي إلى إزالة جلطات الدم الصغيرة)\nمثال: تم استخدام الأدوية المسببة لانحلال الفبرين علاجياً",
 "fibrinopeptide": "ببتيد الفبرين (ببتيد يطلق من الطرف الأميني للفيبرينوجين بفعل الثرومبين لتكوين الفيبرين أثناء تخثر الدم)",
 "fibrinous": "ليفيني (يتميز بوجود الفبرين (الليفيت))",
 "fibroadenoma": "ورم غدي ليفي (ورم حميد ومتحرك وصلب وغير مؤلم في الثدي؛ شائع لدى الشابات ويسببه ارتفاع مستويات هرمون الاستروجين)",
 "fibroblast": "أرومة ليفية (خلية يتطور منها النسيج الضام)",
 "fibrocalcific": "ليفي تكلسي (يتضمن أو ينتج عن تكلس الأنسجة الليفية)",
 "fibrocartilage": "غضروف ليفي (غضروف يتكون بشكل كبير من ألياف تشبه تلك الموجودة في النسيج الضام العادي)",
 "fibrocartilaginous": "ليفي غضروفي (مكون من أو متعلق بالغضروف الليفي)",
 "fibrocystic breast disease": "داء الثدي الليفي الكيسي (وجود كيس واحد أو أكثر في الثدي)",
 "fibrocystic disease of the breast": "داء الثدي الليفي الكيسي (وجود كيس واحد أو أكثر في الثدي)",
 "fibrocystic disease of the pancreas": "تليف كيسي (أكثر الأمراض الوراثية شيوعاً؛ تنسد رئتا الطفل وأمعاؤه وبنكرياسه بمخاط سميك؛ يسببه خلل في جين واحد؛ لا يوجد علاج معروف)",
 "fibrodysplasia ossificans progressiva": "خلل التنسج الليفي المعظم المترقي (أدخل شيئًا بين آخر؛ جعل شيئًا يتخلل شيئًا آخر)",
 "fibroid": "ورم ليفي (ورم حميد يحتوي على أنسجة ليفية (خاصة في الرحم))",
 "fibroid tumor": "ورم ليفي (ورم حميد يحتوي على أنسجة ليفية (خاصة في الرحم))",
 "fibroma": "ورم ليفي (ورم غير خبيث من النسيج الضام)",
 "fibromyositis": "التهاب العضلات الليفي (التهاب موضعي للعضلات والنسيج الضام)",
 "fibrosis": "تليف (تطور النسيج الضام الليفي الزائد في عضو ما)",
 "fibrositis": "التهاب ليفي (التهاب الأنسجة الليفية البيضاء (خاصة أغلفة العضلات))",
 "fibrosity": "تليف, ليفة (صفة كون الشيء ليفياً)",
 "fibrous": "عَصَبِيّ, لِيفِيّ ((يوصف به اللحم) مليء بالأوتار؛ خاصة يستحيل مضغه) / قِنَّبِيّ, لِيفِيّ (ذو ألياف أو يشبه الألياف خاصة تلك المستخدمة في صناعة الحبال)",
 "fibrous astrocyte": "خلية نجمية ليفية (خلايا نجمية الشكل ذات نتوءات طويلة؛ توجد في المادة البيضاء للدماغ والحبل الشوكي)",
 "fibrous dysplasia of bone": "خلل التنسج الليفي للعظام (اضطراب يتم فيه استبدال العظام التي تخضع للتحلل بانتشار غير طبيعي للأنسجة الليفية مما يؤدي إلى آفات عظمية أو آفات جلدية)",
 "fibrous joint": "درز (مفصل غير متحرك (خاصة بين عظام الجمجمة))",
 "fibrous tissue": "نسيج ليفي (نسيج يتكون من أو يحتوي على ألياف في كل من الحيوانات والنباتات)",
 "fibrous-rooted begonia": "بيغونيا ليفية الجذور (أي من العديد من البيغونيا التي لها جذور ليفية بدلاً من الجذور الدرنية أو الجذمورية)",
 "fibrousness": "تليف, ليفة (صفة كون الشيء ليفياً)",
 "fibrovascular bundle": "حزمة وعائية, ضفيرة وعائية (خيط وحدة من النظام الوعائي في سيقان وأوراق النباتات العليا يتكون أساسًا من الخشب واللحاء)",
 "fibula": "شظية, عظم الشظية (العظم الخارجي والأرق من بين عظمتي الساق البشرية بين الركبة والكاحل)",
 "fibular vein": "وريد شظوي (ترافق الشرايين الشظوية؛ تنشأ في الكعب وتمتد صعوداً خلف الساق لتنضم إلى الأوردة الظنبوبية الخلفية للوريد المأبضي)",
 "fica": "ضريبة الضمان الاجتماعي, فيكا (ضريبة على الموظفين وأصحاب العمل تستخدم لتمويل نظام الضمان الاجتماعي)",
 "fice": "كلب فايست (كلب هجين صغير عصبي وعدواني)",
 "fichu": "شَال (قطعة مربعة كبيرة من القماش الصوفي يستخدمه الرجال كغطاء للرأس يكون عادة غير منقوش ولا مطرز؛ قطعة مستطيلة أو ممثلثة من القماش سواء كان خفيفا أم سميكا من الصوف أو القطن أو الحرير يكون عادة مطرز أو مشغول تضعه النساء على أكتافها)",
 "fickle": "مُتَقَلِّب, نَزَوِيّ (عرضة لتغيّرات مفاجئة وغير متوقّعة) / غَيْرُ مُسْتَقِرّ, مُتَقَلِّب (يَتَّسِمُ بِتَقَلُّبَاتٍ عَشْوَائِيَّةٍ فِي المَشَاعِرِ أَوِ الِارْتِبَاطَاتِ)",
 "fickleness": "تَقَلُّب, غَدْر (عدم الوفاء بحكم عدم الموثوقية أو الغدر)",
 "fictile": "قَابِلٌ لِلتَّشْكِيل, لَدْن (قابل للقولبة أو التشكيل (خاصة التراب أو الطين أو مادّة ليّنة أخرى)) / سَهْل الانْقِيَاد, طَيِّع (قابل للقيادة أو التوجيه بسهولة) / خزفي, فخاري (مكون من أو متعلق بحرفة الفخار)\nمثال: الفن الخزفي",
 "fiction": "خَيَال, رِوَايَة (الخَيَّالُ : صَاحبُ الخيول؛ الخَيَّالُ : فارس الخيول)\nمثال: يحب الخيال العلمي.",
 "fictional": "خَيَالِيّ, مُتَخَيَّل",
 "fictional animal": "حيوان خيالي (حيوانات موجودة فقط في الخيال (عادة في قصص الأطفال))",
 "fictional character": "شخصية, شخصية خيالية (شخص وهمي يتم تمثيله في عمل خيالي (مسرحية أو فيلم أو قصة))\nمثال: هي الشخصية الرئيسية في الرواية",
 "fictionalisation": "اختلاق, كتابة خيالية (الكتابة في شكل خيالي (قصصي)) / إضفاء الطابع الخيالي, صياغة قصصية (عمل أدبي يستند جزئياً أو كلياً إلى الواقع ولكنه مكتوب كما لو كان خيالاً)",
 "fictionalization": "اختلاق, كتابة خيالية (الكتابة في شكل خيالي (قصصي)) / إضفاء الطابع الخيالي, صياغة قصصية (عمل أدبي يستند جزئياً أو كلياً إلى الواقع ولكنه مكتوب كما لو كان خيالاً)",
 "fictitious": "مُخْتَلَق",
 "fictitious character": "شخصية, شخصية خيالية (شخص وهمي يتم تمثيله في عمل خيالي (مسرحية أو فيلم أو قصة))\nمثال: هي الشخصية الرئيسية في الرواية",
 "fictitious name": "اسم تجاري مستعار ((قانون) اسم تمارس به شركة أعمالها وليس الاسم القانوني للشركة كما هو مبين في وثائق تأسيسها)",
 "fictitious place": "مكان أسطوري, مكان خيالي (مكان موجود فقط في الخيال؛ أو مكان يقال إنه موجود في الكتابات الخيالية أو الدينية)",
 "fictitiously": "افتراضياً, بشكل خيالي (بطريقة خيالية (مبتكرة من الخيال)) / بشكل زائف, بشكل وهمي (بطريقة زائفة تهدف إلى التضليل)",
 "fictive": "تَخَيُّلِيّ (قادر على الإبداع التخيُّلي) / زَائِف, مُتَظَاهَر بِه (مُتَّخَذ بغرض الخداع والتضليل)",
 "ficus aurea": "تين خانق, تين ذهبي (شجرة خانقة موطنها جنوب فلوريدا وجزر الهند الغربية؛ تبدأ كنبات هوائي وتطور في النهاية العديد من الجذور الهوائية السميكة وتغطي مساحات هائلة)",
 "ficus bengalensis": "بانيان, تين هندي (شجرة من شرق الهند تخرج جذوراً هوائية تنمو لأسفل في التربة مشكلة جذوعاً إضافية)",
 "ficus carica": "تين, تين شائع (شجرة متوسطية تُزرع على نطاق واسع لثمارها الصالحة للأكل)",
 "ficus carica sylvestris": "تين بري (صنف بري من التين الشائع يستخدم لتسهيل تلقيح أنواع معينة من التين)",
 "ficus deltoidea": "تين الهدال (شجيرة أو شجرة صغيرة تزرع غالباً كنبات منزلي لها أوراق تشبه الهدال)",
 "ficus diversifolia": "تين الهدال (شجيرة أو شجرة صغيرة تزرع غالباً كنبات منزلي لها أوراق تشبه الهدال)",
 "ficus elastica": "شجرة المطاط, فيكس (شجرة آسيوية استوائية كبيرة تقزم غالباً كنبات منزلي؛ مصدر لمطاط آسام)",
 "ficus religiosa": "بيبال, تين مقدس (شجرة تين من الهند تشتهر بحجمها الكبير وطول عمرها؛ تفتقر إلى الجذور الداعمة للبانيان؛ تعتبر مقدسة لدى البوذيين)",
 "ficus rubiginosa": "تين بورت جاكسون (شجرة أسترالية تشبه البانيان تزرع غالباً للزينة؛ أدخلت إلى جنوب أفريقيا للأخشاب الصغيرة)",
 "ficus sycomorus": "جميز (شجرة واسعة الانتشار سميكة الفروع من أفريقيا وجنوب غرب آسيا المجاور مدعمة غالباً بفروع ترتفع من قرب الأرض؛ تنتج عناقيد من التين الصالح للأكل ولكنه…)",
 "fiddle": "كمان (آلة وترية ذات قوس تعد أعلى أعضاء عائلة الكمان طبقة؛ لها أربعة أوتار وجسم مجوف)",
 "fiddle-faddle": "ثَرْثَرَة فَارِغَة, سَخَافَة (هراء تافه)",
 "fiddle-shaped": "كَمَانِيّ الشَّكْل ((عن شكل الورقة) ذو أطراف مُستديرة ووسط مُنقبض)",
 "fiddlehead": "أسمندة قرفية, سرخس القرفة (سرخس من العالم الجديد ذو سعف صوفي بلون القرفة يحمل الأبواغ في أوائل الربيع محاطاً لاحقاً بسعف أخضر؛ السعف المبكر غير الملتف صالح للأكل) / رأس الكمان, سرخس النعامة (سرخس طويل من المناطق المعتدلة الشمالية له سعف مقوس رشيق وأبواغ تشبه ريش النعام)",
 "fiddlehead fern": "أسمندة قرفية, سرخس القرفة (سرخس من العالم الجديد ذو سعف صوفي بلون القرفة يحمل الأبواغ في أوائل الربيع محاطاً لاحقاً بسعف أخضر؛ السعف المبكر غير الملتف صالح للأكل)",
 "fiddleneck": "عنق الكمان (نبات حولي زغبي من كاليفورنيا إلى المكسيك بنوارات مزدحمة من الزهور الصغيرة الزرقاء إلى الليلكية أو البنفسجية الفاتحة)",
 "fiddler": "مُصلّح هاوٍ (شخص غير ماهر يحاول الإصلاح أو الترميم) / عَابِث (شخص يعبث بشيء ما بطريقة عصبية أو غير واعية) / عازف كمان (موسيقي يعزف على الكمان)",
 "fiddler crab": "سرطان عازف (سرطان حفار في المناطق الساحلية الأمريكية يتميز بوجود مخلب واحد متضخم جداً لدى الذكر)",
 "fiddlestick": "قوس الكمان (قوس يستخدم في العزف على الكمان)",
 "fiddling": "تَافِه, زَهِيد ((غير رسمي) صغير ولا أهمّيّة له)",
 "fidelity": "إِخْلَاص (وقيل: الإخلاص تصفية الأعمال من الكدورات؛ وقيل: الإخلاص: ستر بين العبد وبين الله تعالى لا يعلمه ملك فيكتبه، ولا شيطان فيفسده، ولا هوًى فيميله. والفرق بين الإخلاص والصدق: أن الصدق أصل…) / وَلَاء",
 "fidget": "تَمَلْمَلَ",
 "fidgetiness": "تململ (شعور بالاضطراب يتم التعبير عنه بالحركة المستمرة)\nمثال: لديه تململ",
 "fidgety": "قَلِق, مُتَمَلْمِل (عَصَبِيٌّ وَغَيْرُ قَادِرٍ عَلَى الاسْتِرْخَاء)",
 "fiducial": "اسْتِئْمَانِيّ (مبني على الثقة والائتمان) / إسنادي, مرجعي (يستخدم كمعيار ثابت للمرجعية للمقارنة أو القياس) / ائتماني (متعلق بطبيعة الأمانة القانونية (أي الاحتفاظ بشيء كأمانة لشخص آخر))\nمثال: نقطة إسنادية",
 "fiduciary": "ائتماني (متعلق بطبيعة الأمانة القانونية (أي الاحتفاظ بشيء كأمانة لشخص آخر)) / مؤتمن, وصي (شخص يحمل أصولاً كأمانة لصالح مستفيد)\nمثال: عقد ائتماني",
 "fiduciary duty": "واجب ائتماني (الواجب القانوني للوكيل الائتماني بالتصرف لمصلحة المستفيد)",
 "fiduciary relation": "عَلَاقَة اِئْتِمَانِيَّة (العلاقة القانونية التي توجد عندما يعتمد شخص بشكل مبرر على شخص آخر يُطلب منه العون أو الحماية في أمر ما)",
 "fief": "إقْطَاعَة",
 "fiefdom": "إقطاعية, منطقة نفوذ (منظمة يسيطر عليها شخص أو مجموعة مهيمنة بشكل مطلق) / إقطاعية (المجال الذي يسيطر عليه لورد إقطاعي)",
 "field": "حَقْل (ذهب أو حدث بسرعة أو دون توقف؛ في بعض اللهجات: تعني تحرك سريعاً أو اهتزّ) / سَاحَة, سَاحَة الْمَعْرَكَة / مَجَال\nمثال: يعمل الفلاحون في الحقل.",
 "field artillery": "مدفعية ميدانية (مدفعية متحركة (غير المضادة للطائرات) تستخدمها الجيوش في الميدان (خاصة للدعم المباشر لقوات الخطوط الأمامية))",
 "field balm": "بلسم الحقل, كالامينت صغير (عشب معمر عطري بقوة منخفض النمو من جنوب أوروبا إلى بريطانيا العظمى؛ تم توطينه في الولايات المتحدة) / جيليكوما, روبن الهارب",
 "field bean": "فول, فول عريض (نبات منتصب من العالم القديم يزرع خاصة لبذوره المسطحة الكبيرة الصالحة للأكل وأيضاً كعلف)",
 "field bindweed": "لبلاب الحقول, مجعد (نبات متسلق معمر أوروبي ضعيف بزهور بيضاء أو وردية؛ تم توطينه في أمريكا الشمالية وهو عشب ضار غازٍ)",
 "field brome": "برومس الحقول (عشبة سنوية من أوروبا وآسيا المعتدلة)",
 "field capacity": "السعة الحقلية (الكمية القصوى من الماء التي يمكن لتربة معينة الاحتفاظ بها)",
 "field chamomile": "أقحوان الحقول, بابونج الحقول (عشبة أوروبية بيضاء الزهور متوطنة في أمريكا الشمالية)",
 "field chickweed": "أذن الفأر الحقلي, عشبة الطيور الحقلية (عشبة الطيور المعمرة كثيفة التكتل في المنطقة المعتدلة الشمالية)",
 "field coil": "ملف المجال (الملف الكهربائي حول مغناطيس المجال الذي ينتج القوة الدافعة المغناطيسية لإنشاء التدفق في آلة كهربائية)",
 "field corn": "ذرة حقلية (ذرة تُزرع أساساً كعلف للحيوانات أو كحبوب للسوق)",
 "field cricket": "صرصور الحقل (صرصور أسود أمريكي شائع؛ يهاجم المحاصيل ويدخل المساكن أيضاً)",
 "field crop": "محصول حقلي (محصول (بخلاف الفواكه أو الخضروات) يُزرع لأغراض زراعية)\nمثال: القطن والتبن والحبوب هي محاصيل حقلية",
 "field day": "رحلة خلوية, نزهة خلوية (يوم مخصص لتجمع اجتماعي في الهواء الطلق) / يوم حافل, يوم ممتع (وقت من المتعة والنجاح غير المعتاد) / يوم رياضي (يوم للمنافسات الرياضية الخارجية) / يوم مناورات ((عسكرية) يوم للتدريبات والعروض العسكرية)",
 "field emission": "انبعاث مجالي (انبعاث الإلكترونات التي تنتزع من الذرات الأم بواسطة مجال كهربائي عالٍ)",
 "field event": "ألعاب الميدان, فعالية ميدان (مسابقة تجري في الميدان بدلاً من مضمار الجري)",
 "field game": "لعبة ميدانية (لعبة خارجية تُلعب في ملعب بأبعاد محددة)",
 "field garlic": "ثوم الكرمة, ثوم بري (بصل بري لاذع من العالم القديم)",
 "field general": "ظهير ربعي, كوارترباك ((كرة قدم أمريكية) مركز لاعب كرة القدم في الخلفية الذي يوجه اللعب الهجومي لفريقه) / ظهير ربعي, كوارترباك ((في كرة القدم الأمريكية) الشخص الذي يلعب في مركز الظهير الربعى ويقود الهجوم)\nمثال: الكوارترباك هو أهم مركز في الفريق",
 "field glass": "تلسكوب صغير, منظار (تلسكوب كاسر (انكساري) صغير الحجم)",
 "field glasses": "دربيل, منظار ((جمع) أداة بصرية مصممة للاستخدام المتزامن بكلتا العينين)",
 "field goal": "هدف ميداني (تسجيل في كرة القدم الأمريكية؛ يتم بركل الكرة بين عمودي مرمى الخصم) / سلة, هدف (تسجيل في كرة السلة يتم برمي الكرة عبر الطوق)",
 "field guide": "دليل ميداني (دليل يصف الأشياء الطبيعية من نوع معين التي قد تصادف في الميدان)\nمثال: دليل ميداني للفطر",
 "field gun": "مدفعية ميدانية (مدفعية متحركة (غير المضادة للطائرات) تستخدمها الجيوش في الميدان (خاصة للدعم المباشر لقوات الخطوط الأمامية))",
 "field hand": "عامل زراعي (عامل مستأجر في مزرعة)",
 "field hockey": "هوكي الحقل",
 "field hockey ball": "كرة هوكي الحقل (كرة تستخدم في لعب هوكي الحقل)",
 "field horsetail": "ذيل الحصان الحقلي, ذيل الحصان الشائع (من أوراسيا وجرينلاند وأمريكا الشمالية)",
 "field hospital": "مستشفى ميداني (اسم مفعول من الفعل \"اسْتَشْفَى\")\nمثال: أعمل في مستشفى.",
 "field house": "صالة رياضية ميدانية (منشأة رياضية يستعد فيها الرياضيون للرياضة) / ساحة رياضية, صالة رياضية مغلقة (مبنى للرياضات الداخلية)",
 "field hut": "كوخ عسكري (مأوى عسكري مؤقت)",
 "field intensity": "شدة المجال (المجموع المتجه لجميع القوى المؤثرة بواسطة مجال كهربائي أو مغناطيسي عند نقطة معينة)",
 "field judge": "حكم ميداني (حكم كرة قدم يعمل في الملعب خلف الدفاع الثانوي)",
 "field lens": "عدسة المجال (العدسة الأبعد عن العين في جهاز بصري يحتوي على أكثر من عدسة)",
 "field line": "خط القوة, خط المجال (خط وهمي في مجال القوة؛ اتجاه الخط في أي نقطة هو اتجاه القوة عند تلك النقطة)",
 "field lupine": "ترمس أبيض, ترمس مصري (عشب أوراسي ذو زهور بيضاء يزرع على نطاق واسع للعلف ومكافحة التعرية)",
 "field magnet": "مغناطيس المجال (مغناطيس يوفر مجالاً مغناطيسياً في دينامو أو محرك كهربائي)",
 "field maple": "قيقب الحقل, قيقب السياج (قيقب أوراسي شجيري يستخدم غالباً كسياج)",
 "field marigold": "أقحوان الحقول, أقحوان الذرة (عشبة أوروبية بزهور صفراء زاهية؛ عشبة ضارة شائعة في حقول الحبوب)",
 "field marshal": "مُشِير",
 "field mint": "نعناع الحقل (نعناع أوروبي تم توطينه في الولايات المتحدة)",
 "field mouse": "فأر الحقل (أي فأر ليلي من العالم القديم من جنس أبوديموس يعيش في الغابات والحقول والحدائق) / فأر الحقل, فول (أي من قوارض صغيرة تشبه الفأر من فصيلة القداديات (خاصة من جنس ميكروتوس) ذات جسم ممتلئ قصير الذيل وآذان غير بارزة وتعيش في الحقول أو المروج)",
 "field mouse-ear": "أذن الفأر الحقلي, عشبة الطيور الحقلية (عشبة الطيور المعمرة كثيفة التكتل في المنطقة المعتدلة الشمالية)",
 "field mushroom": "فطر الحقل, فطر المروج (فطر شائع صالح للأكل يوجد طبيعياً في التربة المفتوحة الرطبة؛ الفطر المزروع تجارياً)",
 "field mustard": "خردل الحقل, خردل بري (نبات أوراسي ضار غالباً ما يكون آفة في حقول الحبوب)",
 "field of battle": "أرض المعركة, ساحة المعركة (منطقة تجري (أو جرت) فيها معركة)\nمثال: قاموا بجولة في ساحات معارك الحرب الأهلية",
 "field of fire": "مجال الرمي, ميدان الرمي (المنطقة التي يمكن لسلاح أو مجموعة أسلحة تغطيتها بفعالية بنيران البنادق من موقع معين)",
 "field of force": "حقل, حقل القوة (الحيز حول جسم مشع والذي يمكن لتذبذباته الكهرومغناطيسية أن تمارس قوة على جسم مشابه آخر غير ملامس له)",
 "field of honor": "أرض المعركة, ساحة المعركة (منطقة تجري (أو جرت) فيها معركة) / ميدان الشرف (مسرح المبارزة)\nمثال: قاموا بجولة في ساحات معارك الحرب الأهلية",
 "field of operation": "مجال, ميدان عمل (نوع معين من المؤسسات التجارية)\nمثال: هم متميزون في مجالهم",
 "field of operations": "مسرح العمليات, ميدان (منطقة تجري فيها عمليات عسكرية نشطة)\nمثال: كان الجيش في الميدان بانتظار العمليات",
 "field of regard": "حقل الرؤية, مجال بصري (جميع نقاط البيئة المادية التي يمكن إدراكها بواسطة عين ثابتة في لحظة معينة)",
 "field of study": "تخصص, حقل معرفي (فرع من فروع المعرفة)\nمثال: في أي تخصص حصل على الدكتوراه؟",
 "field of view": "مجال بصر",
 "field of vision": "ساحة بصرية",
 "field officer": "ضابط ميداني (ضابط يحمل رتبة رائد أو مقدم أو عقيد)",
 "field pansy": "بانسي الحقل (فيولا شائعة في العالم القديم ذات أزهار كريمية غالباً ما تكون مشوبة باللون البنفسجي)",
 "field pea": "بازلاء الحقل (بازلاء صغيرة البذور خشنة تستخدم غالباً كغذاء عندما تكون صغيرة وطرية) / بازلاء الحقل (صنف من نبات البازلاء موطنه منطقة البحر الأبيض المتوسط وشمال أفريقيا ويزرع على نطاق واسع خاصة للعلف) / بازلاء الحقل (بذرة نبات بازلاء الحقل)",
 "field pennycress": "ثلاسبي حقلي, خردل الميثريبات (عشبة أوراسية كريهة الرائحة ذات قرون مسطحة مستديرة؛ متوطنة في جميع أنحاء أمريكا الشمالية)",
 "field poppy": "خشخاش الحقول, خشخاش الذرة (خشخاش أوروبي سنوي شائع في حقول الحبوب ويزرع غالباً)",
 "field press censorship": "رقابة صحفية ميدانية (مراجعة أمنية للأخبار (بما في ذلك جميع المعلومات أو المواد المعدة للنشر للجمهور) الخاضعة لولاية القوات المسلحة)",
 "field pussytoes": "رجل القط الحقلية (صنف من نبات رجل القط)",
 "field ration": "جراية ميدانية, حصة ميدانية (حصص غذائية تصرف للقوات العسكرية في الميدان)",
 "field sandbur": "حسك رملي (عشب من شرق الولايات المتحدة وأمريكا الاستوائية له سنيبلات محاطة بأغلفة شائكة)",
 "field scabious": "جرب الحقل (نبات معمر له زهور زرقاء ليلكية؛ أدخل إلى شرق الولايات المتحدة)",
 "field soybean": "صويا علفية (بذور تستخدم كعلف للماشية)",
 "field spaniel": "فيلد سبانييل (سبانييل صيد واسترداد كبير أسود عادة ذو فراء كثيف مسطح أو مموج قليلاً؛ هجين بين الكوكر وساسكس سبانييل)",
 "field sparrow": "عصفور الحقل (عصفور شائع في أمريكا الشمالية يعيش في المراعي ذات الشجيرات)",
 "field speedwell": "زهرة الحواشي الحقلية (نبات أوروبي بزهور زرقاء إبطية دقيقة على سيقان طويلة؛ متوطن على نطاق واسع في أمريكا)",
 "field sport": "رياضة خارجية, رياضة في الهواء الطلق (رياضة تُلعب في الهواء الطلق)",
 "field strength": "شدة المجال (المجموع المتجه لجميع القوى المؤثرة بواسطة مجال كهربائي أو مغناطيسي عند نقطة معينة)",
 "field strength unit": "وحدة شدة المجال (وحدة كهرومغناطيسية للشدة المغناطيسية)",
 "field tent": "خيمة ميدانية (خيمة قماشية للاستخدام في الميدان)",
 "field test": "تجربة ميدانية (اختبار لأداء منتج جديد في ظل الظروف التي سيستخدم فيها)",
 "field theory": "نظرية المجال ((فيزياء) نظرية تشرح ظاهرة فيزيائية من حيث مجال وطريقة تفاعله مع المادة أو مع مجالات أخرى)",
 "field thistle": "شوك الحقل (شوك قوي من أمريكا الشمالية ذو رؤوس زهور وردية أرجوانية)",
 "field trial": "تجربة ميدانية (اختبار لكلاب الصيد الصغيرة لتحديد مهارتها) / تجربة ميدانية (اختبار لأداء منتج جديد في ظل الظروف التي سيستخدم فيها) / اختبار ميداني (مسابقة بين كلاب الصيد لتحديد كفاءتها في التوجيه والاسترجاع)",
 "field trip": "رحلة ميدانية (رحلة جماعية (إلى متحف أو غابة أو مكان تاريخي) للفحص المباشر)",
 "field winding": "ملف المجال (الملف الكهربائي حول مغناطيس المجال الذي ينتج القوة الدافعة المغناطيسية لإنشاء التدفق في آلة كهربائية)",
 "field work": "عمل ميداني (تحقيق يتم إجراؤه في الميدان بدلاً من المختبر أو المقر الرئيسي)",
 "field wormwood": "شيح الحقول (شيح أوروبي مشابه للشيح الشائع في خصائصه)",
 "field-crop": "حقلي (مكون من أو متعلق بالمحاصيل الحقلية)\nمثال: إدارة المحاصيل الحقلية",
 "field-effect transistor": "ترانزستور تأثير المجال, فيت (ترانزستور يتدفق فيه معظم التيار في قناة يمكن التحكم في مقاومتها الفعالة بواسطة مجال كهربائي مستعرض)",
 "field-emission microscope": "مجهر الانبعاث المجالي (مجهر إلكتروني يستخدم لمراقبة البنية السطحية للمواد الصلبة)",
 "field-grade officer": "ضابط ميداني (ضابط يحمل رتبة رائد أو مقدم أو عقيد)",
 "field-pea plant": "بازلاء الحقل (صنف من نبات البازلاء موطنه منطقة البحر الأبيض المتوسط وشمال أفريقيا ويزرع على نطاق واسع خاصة للعلف)",
 "field-sequential color television": "تلفزيون ملون متتابع الحقول (شكل مبكر من التلفزيون الملون يتم فيه مسح الحقول المتتالية بالألوان الأساسية الثلاثة)",
 "field-sequential color television system": "تلفزيون ملون متتابع الحقول (شكل مبكر من التلفزيون الملون يتم فيه مسح الحقول المتتالية بالألوان الأساسية الثلاثة)",
 "field-sequential color tv": "تلفزيون ملون متتابع الحقول (شكل مبكر من التلفزيون الملون يتم فيه مسح الحقول المتتالية بالألوان الأساسية الثلاثة)",
 "field-sequential color tv system": "تلفزيون ملون متتابع الحقول (شكل مبكر من التلفزيون الملون يتم فيه مسح الحقول المتتالية بالألوان الأساسية الثلاثة)",
 "fielder": "لاعب ميداني, مدافع (عضو في فريق الكريكيت يقوم بالدفاع (الالتقاط) بدلاً من الضرب) / لاعب ميداني, مدافع (عضو في فريق البيسبول يتواجد في الملعب للدفاع بدلاً من الضرب)",
 "fielder's choice": "خيار المدافع (لعبة تتم على كرة أرضية يختار فيها المدافع إخراج عداء متقدم بدلاً من الضارب)",
 "fieldfare": "سمنة الحقول (سمنة أوراسية متوسطة الحجم تُرى بشكل رئيسي في الشتاء)",
 "fieldhand": "عامل زراعي (عامل مستأجر في مزرعة)",
 "fielding": "دفاع, لعب ميداني ((بيسبول) التعامل مع الكرة أثناء اللعب في الملعب)",
 "fielding average": "مُعَدَّل الدِّفَاع, مُعَدَّل اللَّعِب فِي المَيْدَان ((البيسبول) مقياس لأداء المدافع؛ عدد المساعدات والإخراجات مقسوماً على عدد الفرص)",
 "fieldmouse": "فأر الحقل (أي فأر ليلي من العالم القديم من جنس أبوديموس يعيش في الغابات والحقول والحدائق)",
 "fieldsman": "لاعب ميدان (عضو ذكر في فريق الكريكيت يلعب في الميدان بدلاً من الضرب)",
