 "feebly": "بضعف, بوهن (بطريقة مترددة وضعيفة) / بشكل خافت, بضعف (بطريقة باهتة وضعيفة)\nمثال: الإصلاح، في الواقع، يحقق الفوز وإن كان بضعف",
 "feed": "أَطْعَمَ, غَذَّى",
 "feed bunk": "معلف طويل (حوض طويل لتغذية الماشية)",
 "feed grain": "حبوب العلف (حبوب تزرع لتغذية الماشية)",
 "feed steamer": "جهاز تبخير العلف (مبخرة للمعالجة الحرارية للأعلاف قبل إطعامها لحيوانات المزرعة، لم تعد تستخدم)",
 "feedback": "تَلْقِيم اِسْتِرْجَاعِيّ, تَقْيِيم",
 "feedback circuit": "حلقة التغذية الراجعة, دائرة التغذية الراجعة (دائرة تعيد جزءاً من المخرجات إلى مدخلات النظام)",
 "feedback loop": "حلقة التغذية الراجعة, دائرة التغذية الراجعة (دائرة تعيد جزءاً من المخرجات إلى مدخلات النظام)",
 "feedbag": "كيس علف, مخلاة (كيس قماشي يستخدم لإطعام حيوان (مثل الحصان)؛ يغطي الخطم ويربط في أعلى الرأس)",
 "feeder": "حيوان تسمين (حيوان يتم تسمينه أو مناسب للتسمين) / آكل, حيوان مقتات (حيوان يتغذى على مصدر معين للغذاء) / مِعْلف طيور, وحدة إطعام الطيور (جهاز خارجي يوفر الطعام للطيور البرية) / ملقم ذاتي (آلة توفر تلقائياً إمداداً من مادة ما)\nمثال: آكل اللحاء",
 "feeder line": "خط فرعي, خط مغذي (مسار متفرع من خط نقل رئيسي (خاصة خط جوي))",
 "feeding": "إِطْعَام",
 "feeding bottle": "زجاجة رضاعة (وعاء مزود بحلمة مرنة ومملوء بالحليب؛ يستخدم كبديل للرضاعة الطبيعية)",
 "feeding chair": "كرسي إطعام الطفل, كرسي مرتفع (كرسي لإطعام طفل صغير جداً؛ له أربعة أرجل طويلة ومسند للقدمين وصينية قابلة للفصل)",
 "feedlot": "مبنى تسمين (مبنى حيث يتم تسمين الماشية للسوق)",
 "feedstock": "لقيم, مادة أولية (المادة الخام المطلوبة لعملية صناعية ما)",
 "feel": "تحسس / شَعَرَ (العِلْم؛ في : هو كلام مُقَفَّى ومُوَازَن على أوزان معروفة يُقصد به إظهار الكلام بصيغة فنية) / شَعَرَ بِ (العِلْم؛ في : هو كلام مُقَفَّى ومُوَازَن على أوزان معروفة يُقصد به إظهار الكلام بصيغة فنية)\nمثال: شعر ماريا طويل.",
 "feeler": "قرن استشعار, ملمس (واحدة من زوج من الزوائد المتحركة على رأس الحشرات والقشريات؛ حساسة عادة للمس والتذوق) / بربيس, زائدة استشعارية (نتوء لمسي رفيع على فكي السمكة) / استشعار, حدس (حساسية تشبه حساسية عضو الاستقبال الحسي) / جَسّ نَبْض, مُبَادَرَة (اقتراح مبدئي مصمم لاستنباط ردود فعل الآخرين)\nمثال: كان لديه استشعار خاص للعلاقات العامة",
 "feeling": "شُعُور, إِحْسَاس / عَاطِفَة, إِحْسَاس",
 "feeling of movement": "إحساس حركي, شعور بالحركة (إدراك وضعية الجسم وحركته وتوترات العضلات وما إلى ذلك)",
 "feelingly": "بتأثر, بشعور (بمشاعر قوية)\nمثال: تحدثت بتأثر عن طفولتها المبكرة",
 "feelings": "مشاعر (الحساسية العاطفية أو الأخلاقية (خاصة فيما يتعلق بالمبادئ الشخصية أو الكرامة))\nمثال: جرحت الملاحظة مشاعره",
 "feetfirst": "القَدَمَان أَوَّلًا (مع تقديم القدمين)\nمثال: قفز في المسبح بقدميه أولاً",
 "fehling's solution": "محلول فهلنغ (محلول سائل من كبريتات النحاس وطرطرات البوتاسيوم وهيدروكسيد الصوديوم يستخدم للكشف عن السكر في البول؛ يتحول المحلول إلى اللون المحمر عند وجود السكر)",
 "feign": "تَظَاهَرَ, اِخْتَلَقَ (فعل مطاوعة لظَاهَرَ، ظاهرته فتظاهر، يكون بمعنى تعاون فكان كل طرف كظهر الآخر؛ القوم: ولّى كل منهم ظهره للآخر) / يَزْعُم, تَخَيَّل\nمثال: تظاهر بأنه طبيب.",
 "feigned": "مُتَصَنَّع, مُصْطَنَع (غَيْر حَقِيقِيّ؛ مُفْتَعَل)",
 "feigning": "ادعاء, تصنع (فعل إعطاء مظهر زائف) / ادعاء, تصنع (التظاهر بنية الخداع)\nمثال: كان امتثاله مجرد تظاهر",
 "feijoa": "فيجوا (فاكهة استوائية خضراء داكنة بحجم الكيوي ذات لحم أبيض) / فيجوا (شجيرة من أمريكا الجنوبية ذات ثمار خضراء صالحة للأكل تشبه البرقوق)",
 "feijoa bush": "فيجوا (شجيرة من أمريكا الجنوبية ذات ثمار خضراء صالحة للأكل تشبه البرقوق)",
 "feint": "تمويه, مخادعة (أي مناورة مشتتة أو خادعة (كهجوم وهمي))",
 "feist": "كلب فايست (كلب هجين صغير عصبي وعدواني)",
 "feistiness": "حيوية قتالية, مشاكسة (صفة أو حالة تتسم بالإصرار والحيوية والجسارة)\nمثال: كانت سارابي الأصغر في المجموعة لكنها عوضت صغر حجمها بمشاكستها!",
 "feisty": "حَسَّاس, سَرِيع الغَضَب (سريع التأثّر والانزعاج من أيّ إساءة) / جَسُور, شُجَاع (يُظهر شجاعة وإقدامًا وروحًا قتاليّة)",
 "felafel": "فلافل (كرات صغيرة مقلية من الحمص المهروس أو الفول المتبل ببذور السمسم)",
 "feldene": "بيروكسيكام, فيلدين (دواء مضاد للالتهاب غير ستيرويدي (الاسم التجاري فيلدين) يستخدم لعلاج التهاب المفاصل والحالات الالتهابية الأخرى)",
 "feldspar": "فلسبار",
 "felicia amelloides": "أقحوان أزرق, مارغريت زرقاء (شجيرة مشعرة من جنوب أفريقيا أو أستراليا لها زهور تشبه الأقحوان بأشعة زرقاء)",
 "felicia bergeriana": "أقحوان الرفراف (عشب مشعر ناعم من جنوب أفريقيا له زهور بأشعة زرقاء ساطعة)",
 "felicitation": "تبريك, تهنئة (فعل الإقرار بأن شخصًا ما لديه مناسبة للاحتفال) / تبريكات, تهنئة ((عادة الجمع) تعبير عن السرور بنجاح أو حسن حظ شخص آخر)\nمثال: أرسلت لهم تهانئي الخالصة بمناسبة زواجهم",
 "felicitous": "بليغ, لبق (يظهر أسلوباً أو طريقة مناسبة ومقبولة) / سَعِيد, مُوَفَّق (يَتَّسِمُ بِالحَظِّ الجَيِّدِ)\nمثال: متحدث لبق",
 "felicitously": "بشكل ملائم, بشكل موفق (بطريقة موفقة ومناسبة تماماً)\nمثال: كلمة لم يتم اختيارها بشكل موفق",
 "felicitousness": "بَلَاغَة, تَوْفِيق (أسلوب أو طريقة مبهجة ومناسبة (خاصة في التعبير))",
 "felicity": "بَلَاغَة, تَوْفِيق (أسلوب أو طريقة مبهجة ومناسبة (خاصة في التعبير)) / سعادة, غبطة (حالة من الرفاهية تتميز بمشاعر تتراوح من الرضا إلى الفرح الشديد)",
 "felid": "سنوريات (أي من الثدييات مشقوقة الأقدام المتنوعة رشيقة الجسم مستديرة الرأس، والعديد منها له مخالب قابلة للسحب)",
 "feline": "سِنَّوْرِيّ",
 "felis bengalensis": "قط نمر (قط بري صغير مرقط يعيش في جنوب آسيا وماليزيا)",
 "felis catus": "قط, قط أليف (حَيْوَان مستأنس من عائلة السَنُّورِيّات، له في اللغة أسماء عديدة تذكر وتؤنث)\nمثال: أعطنا هذا القط.",
 "felis chaus": "قط الأدغال (قط بري آسيوي صغير)",
 "felis concolor": "أسد الجبال, بوما (سنوري أمريكي كبير يشبه الأسد)",
 "felis domesticus": "قط, قط أليف (حَيْوَان مستأنس من عائلة السَنُّورِيّات، له في اللغة أسماء عديدة تذكر وتؤنث)\nمثال: أعطنا هذا القط.",
 "felis manul": "قط بالاس, مانول (قط بري صغير يعيش في جبال سيبيريا والتبت ومنغوليا)",
 "felis ocreata": "قط الكافير (قط بري واسع الانتشار في أفريقيا وآسيا الصغرى)",
 "felis onca": "نمر أمريكي, يغور (سنوري مرقط كبير من أمريكا الاستوائية يشبه النمر؛ يُعتبر في بعض التصنيفات عضواً في جنس فيليس)",
 "felis pardalis": "أصلوت (قط بري ليلي يعيش في أمريكا الوسطى والجنوبية ذو معطف بني مصفر مرقط بالداكن)",
 "felis serval": "بج, قط السرفال (قط بري أفريقي نحيل طويل الساقين ذو أذنين كبيرتين غير معقودتين ومعطف أسمر مرقط بالأسود)",
 "felis silvestris": "قط بري أوروبي (قط بري كثيف الذيل يعيش في أوروبا يشبه القط المنزلي ويعتبر سلف القط المنزلي)",
 "felis tigrina": "قط ببري (قط بري متوسط الحجم يعيش في أمريكا الوسطى والجنوبية ذو معطف مخطط داكن)",
 "felis wiedi": "مارج (قط بري صغير مرقط يوجد من تكساس إلى البرازيل)",
 "felis yagouaroundi": "جاغوارندي (قط بري استوائي أمريكي طويل الجسم وطويل الذيل)",
 "felix": "فيليكس",
 "fell": "إسقاط, صرع (فعل إسقاط شيء ما (كشجرة)) / قَاسٍ, هَمَجِيّ ((عن الأشخاص أو أفعالهم) قادر على إلحاق الألم أو المعاناة أو مُيّال لذلك) / ثنية, درزة مسطحة (درزة تُصنع عن طريق ثني المواد الموصولة تحت بعضها أو طيها معاً وخياطتها لتجنب الحواف الخشنة) / إهاب, جلد مدبوغ (جلد الحيوان (وخاصة الحيوانات الكبيرة) بعد معالجته)",
 "fella": "رجل, رفيق (صبي أو رجل)\nمثال: ذلك الرجل هو مضيفك",
 "fellah": "فلاح (عامل زراعي في الدول العربية)",
 "fellata": "فُولا, فُولانِيّ (عضو في شعب رعوي بدوي في غرب أفريقيا؛ وهم تقليدياً رعاة ماشية مسلمون)",
 "fellate": "مَصّ (مَصَّ الرَّضِيعُ ثَدْيَ أُمِّهِ: رَضَعَ؛ مَصَّ العَصِيرَ: رَشَفَهُ رَشْفًا رَقِيقًا، جَذَبَهُ بِنَفَسِهِ)",
 "fellatio": "مَصّ قَضِيب, لَعْق قَضِيب (مَصَّ الرَّضِيعُ ثَدْيَ أُمِّهِ: رَضَعَ؛ مَصَّ العَصِيرَ: رَشَفَهُ رَشْفًا رَقِيقًا، جَذَبَهُ بِنَفَسِهِ)",
 "fellation": "مص القضيب (التحفيز الفموي للقضيب)",
 "fellator": "لَاعِقُ القَضِيب",
 "fellatrix": "لَاعِقَة القَضِيب",
 "felled seam": "ثنية, درزة مسطحة (درزة تُصنع عن طريق ثني المواد الموصولة تحت بعضها أو طيها معاً وخياطتها لتجنب الحواف الخشنة)",
 "feller": "رجل, رفيق (صبي أو رجل) / حطّاب (شخص يقطع الأشجار)\nمثال: ذلك الرجل هو مضيفك",
 "felloe": "حافة العجلة (الحافة (أو جزء منها) التي يتم إدخال أسلاك العجلة فيها)",
 "fellow": "حبيب, صديق حميم (رجل هو عشيق لرجل أو امرأة) / رجل, رفيق (صبي أو رجل) / زَمِيل (شخص عضو في نفس مهنة أو طبقة الشخص الآخر) / رفيق, زميل (صديق يتواجد كثيراً بصحبة آخر)\nمثال: لو علمت أنه حبيبها لما سألت",
 "fellow citizen": "مُوَاطِن, مُوَاطِنَة (مَدَنِيّ؛ مُقِيم)\nمثال: أنا مواطن لبناني",
 "fellow feeling": "تعاطف, مواساة (مشاركة مشاعر الآخرين (خاصة مشاعر الحزن أو الكرب))",
 "fellow member": "عُضْو (أحد الأشخاص الذين يشكلون مجموعة اجتماعية (خاصة الأفراد الذين انضموا ويشاركون في منظمة جماعية))\nمثال: سيتم قبول الأعضاء فقط",
 "fellow traveler": "رفيق, رفيق السفر (مسافر يرافقك) / رفيق الدرب (متعاطف مع الشيوعية (ولكن ليس عضوًا في الحزب الشيوعي))",
 "fellow traveller": "رفيق, رفيق السفر (مسافر يرافقك) / رفيق الدرب (متعاطف مع الشيوعية (ولكن ليس عضوًا في الحزب الشيوعي))",
 "fellow worker": "زَمِيل عَمَل (زميل يعمل معه المرء في نفس المكان)",
 "fellowship": "أسرة, زمالة (رابطة لأشخاص يشتركون في معتقدات أو أنشطة مشتركة) / زمالة, منحة بحثية (أموال تُمنح (من قبل جامعة أو مؤسسة أو وكالة أخرى) للدراسات المتقدمة أو الأبحاث) / رفقة, زمالة (حالة الوجود مع شخص ما)\nمثال: الرسالة لم تكن موجهة للموظفين فحسب بل لكل عضو في أسرة الشركة",
 "felly": "حافة العجلة (الحافة (أو جزء منها) التي يتم إدخال أسلاك العجلة فيها)",
 "felo-de-se": "انتحار جنائي, قتل النفس العمد (فعل التدمير الذاتي المتعمد (مصطلح قانوني)) / مُنتحِر (شخص يقتل نفسه عمداً)",
 "felon": "جانٍ, مجرم (شخص ارتكب جريمة أو تمت إدانته قانونياً بجريمة) / داحس, ماحس (عدوى قيحية في طرف إصبع اليد أو القدم في المنطقة المحيطة بالظفر)",
 "felonious": "إِجْرَامِيّ, جِنَائِيّ (مُتَعَلِّق بِجَريمَة أَوْ يُشَكِّل فِعْلًا إِجرامِيًّا)",
 "feloniousness": "جسامة, طبيعة جنائية (خاصية الارتباط بجريمة جنائية خطيرة أو امتلاك طبيعتها)\nمثال: بيج جون قد يصفعك، لكن ذلك يتطلب ظرفاً استثنائياً، جسامة من نوع يفوق جوي ولينوود",
 "felony": "جِنَايَة",
 "felspar": "فلسبار (أي من مجموعة معادن بلورية صلبة تتكون من سيليكات الألمنيوم والبوتاسيوم أو الصوديوم أو الكالسيوم أو الباريوم)",
 "felt": "لباد (قماش مصنوع من ألياف حيوانية مضغوطة ومتشابكة)",
 "felt fern": "سرخس اللباد, سرخس اللسان (سرخس شرق آسيوي له سعف يشبه الألسنة؛ يوضع أحياناً في جنس سيكلوفوروس)",
 "felt fungus": "فطر اللباد (فطر يحيط غالباً بأغصان وفروع أشجار مختلفة خاصة أشجار الحمضيات في جنوب الولايات المتحدة)",
 "felt hat": "فيدورا, قبعة لباد (قبعة مصنوعة من اللباد ذات تاج مجعد)",
 "felt tip": "قلم فلوماستر, قلم لبدي (قلم ذو سن للكتابة مصنوع من اللباد)",
 "felt-tip pen": "قَلَم لَبَدِيّ, قَلَم تَحْدِيد (قَطَعَ جزءا من شيء لتزيينه وتحسينه)\nمثال: ارسم بقلم رصاص.",
 "felt-tipped pen": "قلم فلوماستر, قلم لبدي (قلم ذو سن للكتابة مصنوع من اللباد)",
 "felted": "لُبَّادِيّ, مَلْبُود (مَصْنُوعٌ بِدَمْجِ الأَلْيَافِ بِمَادَّةٍ رَابِطَةٍ بِاسْتِخْدَامِ الحَرَارَةِ وَالضَّغْطِ)",
 "felucca": "فلوكة (سفينة شراعية ضيقة وسريعة في البحر الأبيض المتوسط)",
 "felwort": "جنطيانا مرة (جنطيانا من أوروبا والصين لها زهور بيضاء كريمية ذات تيجان مهدبة)",
 "fema": "الوكالة الفيدرالية لإدارة الطوارئ (وكالة مستقلة تابعة لحكومة الولايات المتحدة توفر نقطة واحدة للمساءلة عن جميع أنشطة التأهب والتخفيف والاستجابة للطوارئ الفيدرالية)",
 "female": "أُنْثَى (شخض أو حيوان ينتمي إلى الجنس المؤنث، وهو الجنس الذي غالبًا ما يُنتج البويضة في عملية التكاثر الجنسي، ويملك اثنين من الصبغي إكس) / مثال: الفرس هي أنثى الحصان",
 "female aristocrat": "أرستقراطية (امرأة من الطبقة الأرستقراطية)",
 "female body": "جَسَدُ الأُنْثَى (جسد أنثى بشرية)",
 "female bonding": "تَرَابُط نِسَائِيّ (تكوين علاقة شخصية وثيقة بين النساء)",
 "female chest": "صدر المرأة (صدر المرأة)",
