 "excise": "ضريبة الإنتاج, ضريبة الاستهلاك (ضريبة تقاس بحجم الأعمال المنجزة (وليس على الممتلكات أو الدخل العقاري))",
 "excise tax": "ضريبة الإنتاج, ضريبة الاستهلاك (ضريبة تقاس بحجم الأعمال المنجزة (وليس على الممتلكات أو الدخل العقاري))",
 "exciseman": "جابي الضرائب, مأمور ضرائب (رجل يجمع الضرائب للحكومة)",
 "excisewoman": "جابية ضرائب (امرأة تجمع الضرائب للحكومة)",
 "excision": "اِسْتِئْصَال",
 "excitability": "استثارية, سرعة التأثر (سهولة الإثارة) / تهيج, قابلية للاستثارة (حساسية مفرطة لعضو أو جزء من الجسم)",
 "excitable": "سريع الانفعال, قابل للإثارة (يسهل إثارته) / سَرِيع الاسْتِثَارَة, قَابِل لِلتَّهَيُّج (قادر على الاستجابة للمحفّزات)",
 "excitable area": "قشرة حركية, منطقة حركية (المنطقة القشرية التي تؤثر على الحركات الحركية)",
 "excitableness": "استثارية, سرعة التأثر (سهولة الإثارة)",
 "excitant": "اسْتِثَارِيّ, مُهَيِّج ((للأدوية ونحوها) قادر على الإثارة أو التحفيز) / منبه, منشط (عقار يسرع مؤقتاً بعض العمليات الحيوية)",
 "excitation": "إثارة, تهيج (شيء يسبب الاضطراب والإثارة) / استثارة, تهيج (الاستثارة العصبية أو الكهربائية لعضو أو عضلة أو غدة) / إثارة, انفعال (حالة الاستثارة العاطفية والانفعال)\nمثال: تطلع إلى إثارة اليوم",
 "excitative": "اسْتِثَارِيّ, مُهَيِّج ((للأدوية ونحوها) قادر على الإثارة أو التحفيز)",
 "excitatory": "اسْتِثَارِيّ, مُهَيِّج ((للأدوية ونحوها) قادر على الإثارة أو التحفيز)",
 "excited": "مُتَحَمِّس / مُتَهَيِّج",
 "excitedly": "بإثارة, بانفعال (مع إثارة؛ بطريقة منفعلة)\nمثال: صافحته بانفعال",
 "excitement": "اضطراب, هياج (اضطراب عادة ما يكون احتجاجاً) / إثارة, تهيج (شيء يسبب الاضطراب والإثارة) / إثارة, انتعاش (الشعور بفرح حيوي ومبهج) / إثارة, انفعال (حالة الاستثارة العاطفية والانفعال)\nمثال: تطلع إلى إثارة اليوم",
 "exciting": "مُثِير",
 "excitingly": "بحماس, بشكل مثير (بطريقة تبعث على الإثارة)\nمثال: في وقت ظهوره، لا بد أن الفيلم بدا جديداً بشكل مثير، بل ثورياً",
 "excitotoxin": "ذيفان استثاري (أي من مجموعة المركبات النشطة عصبياً، مثل الغلوتامات والأسبارتام، التي لها تأثيرات استثارية ضارة على الجهاز العصبي المركزي عند تناولها بتركيزات عالية)",
 "exclaim": "صَاحَ, صَرَخَ (صاتَ بأقصى طاقته وأعلى صوته، يستخدم للحيّ ولا يقال صاح للجماد؛ عليه: ناداه)\nمثال: سأساعدك يا صاح.",
 "exclaiming": "تعجب, هتاف (تلفظ مفاجئ منفعل)\nمثال: أطلقت هتافاً من البهجة",
 "exclamation": "صِيَاح, صُرَاخ (مصدر الفعل صَاحَ؛ صوت الكائن الحي القوي)\nمثال: بدأنا في الصياح.",
 "exclamation mark": "عَلَامَةْ تَعَجُّب, عَلَامَةْ هُتَاف (سِمَةٌ أو أمارة أو شِعَار تُعرف به الأشياء؛ رَمْز)\nمثال: تحصلت على علامة أ.",
 "exclamation point": "علامة تعجب (علامة ترقيم ('!') تستخدم بعد التعجب)",
 "exclamatory": "حَاسِم, قَاطِع (مُفاجئ وقويّ)",
 "excluding": "بِاسْتِثْنَاء",
 "exclusion": "إقْصَاء, اِسْتِثْنَاء",
 "exclusion principle": "مبدأ استبعاد باولي (لا يمكن لأي إلكترونين أو بروتونين أو نيوترونين في نظام معين أن يكونا في حالات تتميز بنفس مجموعة الأعداد الكمية)",
 "exclusionary rule": "قَاعِدَة الِاسْتِبْعَاد (قاعدة تنص على أن الأدلة المقبولة لولا ذلك لا يمكن استخدامها في محاكمة جنائية إذا كانت نتيجة سلوك غير قانوني للشرطة)",
 "exclusive": "حَصْرِيّ",
 "exclusive right": "امتياز, حق حصري (حق محفوظ حصريًا لشخص أو مجموعة معينة (خاصة حق وراثي أو رسمي))\nمثال: كان التصويت امتيازًا للذكور البالغين البيض",
 "exclusively": "حصرياً, فقط (دون تضمين أو إشراك أي آخرين)\nمثال: كان الملوم وحده",
 "exclusiveness": "انعزالية, تحزب (الميل للاختلاط بمجموعة مختارة فقط)",
 "exclusivity": "حَصْرِيَّة",
 "excogitation": "ابتكار, اختراع (خلق شيء ما في العقل) / إمعان فكر, تدبير (التفكير في شيء ما بعناية لتحقيق فهم كامل له)",
 "excogitative": "اسْتِنْبَاطِيّ (مَعْنِيٌّ بِالاسْتِنْبَاطِ أَوْ يَمْتَلِكُ القُدْرَةَ عَلَيْه)",
 "excogitator": "متأمل, مدقق (مفكر يدرس الأمور بعناية وشمولية)",
 "excommunicate": "حَرَمَ (مَنَعَ ولم يعطِ)\nمثال: حرم الإسلام الترويع",
 "excommunication": "حِرْمَان كَنَسِيّ",
 "excoriation": "تقريع, توبيخ شديد (لوم شديد) / خدش, سحجة (منطقة مسحوجة حيث يتمزق الجلد أو يُكشط)",
 "excrement": "غَائِط, بِرَاز",
 "excrescence": "نامية, نتوء غير طبيعي ((في علم الأمراض) نتوء أو تضخم غير طبيعي لجزء ما من الجسم) / انتفاخ, بروز (شيء ينتفخ للخارج أو يبرز عن محيطه)\nمثال: أحدث المسدس في جيبه انتفاخاً واضحاً",
 "excrescent": "زائد, ناتئ (يشكل نتوءًا (عادة ما يكون نتوءًا مفرطًا))",
 "excreta": "إفرازات, فضلات الجسم (نفايات (مثل البول أو العرق ولكن خاصة البراز) يتم تصريفها من الجسم)",
 "excrete": "أَفْرَزَ",
 "excreting": "إبراز, إخراج (العملية الجسدية لتصريف الفضلات)",
 "excretion": "إبراز, إخراج (العملية الجسدية لتصريف الفضلات) / إفرازات, فضلات الجسم (نفايات (مثل البول أو العرق ولكن خاصة البراز) يتم تصريفها من الجسم)",
 "excretory": "إخراجي, إفراغي (مكون من أو متعلق بعملية الإخراج (في الجسم))",
 "excretory organ": "عضو إخراجي (عضو يفصل مواد النفايات عن الدم ويطرحها)",
 "excretory product": "إفرازات, فضلات الجسم (نفايات (مثل البول أو العرق ولكن خاصة البراز) يتم تصريفها من الجسم)",
 "excruciating": "مُبَرِّح, مُمِضّ (شَدِيدُ الإِيلَامِ إِلَى أَقْصَى حَدّ)",
 "excruciatingly": "بِأَلَم شَدِيد, بِعَذَاب (بطريقة مؤلمة جداً)\nمثال: كان التقدم بطيئاً بشكل مؤلم",
 "excruciation": "تعذيب مبرح, صلب (إلحاق عقوبة أو معاناة مؤلمة للغاية) / عذاب, معاناة (حالة من الألم الحاد)",
 "exculpated": "مُبَرَّأ, مُعْفًى (أُعفي من أي شبهة ذنب)",
 "exculpation": "تبرئة (فعل التحرير من الذنب أو اللوم) / تبرير, حجة (دفاع عن سلوك مسيء أو فشل في الوفاء بوعد وما إلى ذلك)\nمثال: استمر في إيجاد الأعذار للبقاء",
 "exculpatory": "مبرئ, نافٍ للتهمة (يبرئ من الذنب أو اللوم)",
 "excursion": "جَوْلَة, نُزْهَة",
 "excursion rate": "سعر الرحلات (سعر مخفض لتذكرة ذهاب وعودة)",
 "excursionist": "متجول سياحي, متنزه (سائح يزور المعالم السياحية)",
 "excursive": "اِسْتِطْرَادِيّ, مُتَشَعِّب ((عَنِ الكَلَام وَالكِتَابَة) يَمِيل إِلَى الخُرُوج عَنِ المَوْضُوع الرَّئِيسِيّ)",
 "excursus": "اسْتِطْرَاد, جُمْلَة مُعْتَرِضَة (رسالة تخرج عن الموضوع الرئيسي)",
 "excusable": "مَغْفُور, يَسِيرُ العَفْو (سَهْلُ المَغْفِرَةِ أَوِ العُذْر) / قابل للتجاوز, معذور (يمكن التغاضي عنه)",
 "excusably": "بشكل مقبول, بشكل يُعذر عليه (بطريقة قابلة للعذر أو إلى درجة يمكن التجاوز عنها)\nمثال: تأخر بشكل يمكن عذره",
 "excusatory": "اعتذاري, معتذر (يقدم أو يعبر عن اعتذار)\nمثال: مذكرة اعتذار",
 "excuse": "عَذَرَ (تبرير، إعذار؛ اعتذر عن فعل أو تصرف غير لائق) / اِعْتَذَرَ / عُذْر (تبرير، إعذار؛ اعتذر عن فعل أو تصرف غير لائق)\nمثال: لن أقبل أي عذر.",
 "excuse me": "عَفْوًا!, مَاذَا قُلْتَ؟",
 "excused": "مُعْذَر, مُعْفًى (مُنح إعفاءً أو استثناءً)",
 "excuser": "غَافِر, مُسَامِح (شخص يعفو أو يغفر أو يسامح عن خطأ أو جريمة)",
 "exec": "البيت الأبيض (الإدارة التنفيذية الرئيسية لحكومة الولايات المتحدة)",
 "execrable": "بَغِيض, مَمْقُوت (يستحق اللعن والمقت الشديد) / بَشِع, مَقِيت (مكروه بشكل لا لبس فيه) / بَائِس, مُزْرٍ (رديء الجودة أو الحالة جدًا)",
 "execration": "رجس, ملعون (موضوع للعن أو المقت؛ الشيء الذي يتم استنكاره بشدة) / دعاء بالشر, لعنة (استدعاء قوة خارقة لإلحاق الشر بشخص أو مجموعة) / اشمئزاز, بغض (كراهية مقترنة بالاشمئزاز)",
 "executability": "قابلية التنفيذ (القدرة على التنفيذ)\nمثال: هذه التوصية تواجه مشاكل في قابلية التنفيذ",
 "executable": "عَمَلِيّ, مُمْكِن التَّنْفِيذ (يمكن تنفيذه بالوسائل المتاحة وفي الظروف القائمة)",
 "executant": "عازف منفذ, مؤدٍ موسيقي (مؤدٍ (عادة للأعمال الموسيقية))",
 "execute": "أَعْدَمَ / نَفَّذَ (نَفَذَ: من النّفَاذ وهو جَوَازُ الشيء من الشيء، والخُلُوصُ منه)\nمثال: نفذ منا شيء ما.",
 "executed": "مُعْدَم (نُفِّذ فيه حكم الإعدام)",
 "executing": "إعدام, عقوبة الإعدام (قتل شخص محكوم عليه بالموت)",
 "execution": "تَنْفِيذ / إِعْدَام (في القانون: هي عقوبة يحددها القضاء على جريمة كبرى اقترفها المتهم وتؤدي إلى قتل المتهم غالبا بالشنق)\nمثال: محكم عليه بالإعدام.",
 "execution of instrument": "إبرام, تنفيذ ((قانون) إكمال أداة قانونية (مثل عقد أو سند) بتوقيعها لتصبح ملزمة قانوناً)",
 "execution sale": "بيع جبري, بيع قضائي (بيع الممتلكات من قبل الشريف بموجب أمر تنفيذ من المحكمة للوفاء بالتزام غير مدفوع)",
 "execution speed": "سرعة التنفيذ ((علوم الكمبيوتر) السرعة التي يمكن لجهاز حسابي تنفيذ التعليمات بها؛ تقاس بالميبس (مليون تعليمة في الثانية))",
 "executioner": "جَلَّاد",
 "executive": "إِجْرَائِيّ",
 "executive action": "توجيه رئاسي (توجيه صادر عن رئيس الولايات المتحدة؛ يوجه عادة إلى جميع رؤساء الإدارات والوكالات)",
 "executive agency": "وكالة تنفيذية (وكالة تابعة للسلطة التنفيذية للحكومة)",
 "executive branch": "السلطة التنفيذية, المكتب التنفيذي للرئيس (فرع حكومة الولايات المتحدة المسؤول عن تنفيذ القوانين)",
 "executive clemency": "عفو تنفيذي (سلطة (عادة لرئيس أو حاكم) للعفو أو تخفيف عقوبة شخص مدان في تلك الولاية القضائية)",
 "executive council": "مجلس تنفيذي (مجلس يتقاسم السلطة التنفيذية العليا)",
 "executive department": "إدارة تنفيذية, وزارة تنفيذية (إدارة فيدرالية في الفرع التنفيذي لحكومة الولايات المتحدة)",
 "executive director": "مدير تنفيذي, مسؤول تنفيذي (شخص مسؤول عن إدارة عمل تجاري)",
 "executive function": "وَظِيفَة تَنْفِيذِيَّة (ما يُقَدَّر من الشيء في زمن مُعَيَّن؛ مَنْصِب)\nمثال: ما وظيفة زوجتك؟",
 "executive office of the president": "السلطة التنفيذية, المكتب التنفيذي للرئيس (فرع حكومة الولايات المتحدة المسؤول عن تنفيذ القوانين)",
 "executive officer": "ضابط تنفيذي, نائب القائد (الضابط الثاني في القيادة)",
 "executive order": "أَمْرٌ تَنْفِيذِيٌّ (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة)\nمثال: إنه أمر مختلف .",
 "executive program": "برنامج إشرافي, برنامج تنفيذي (برنامج يتحكم في تنفيذ البرامج الأخرى)",
 "executive routine": "روتين إشرافي, روتين تنفيذي (روتين ينسق تشغيل الروتينات الفرعية)",
 "executive secretary": "سكرتير تنفيذي (سكرتير لديه واجبات ومسؤوليات إدارية)",
 "executive session": "جلسة تنفيذية, جلسة مغلقة (جلسة (عادة لهيئة تشريعية) تكون مغلقة أمام الجمهور)",
 "executive vice president": "نائب رئيس تنفيذي (نائب رئيس يتمتع بسلطة تنفيذية)",
 "executor": "مُنْجِز, مُنَفِّذ / وَصِيّ, وَلِيّ (في : في حال وفاة أحد الوالدين، يتم تعيين الوصي بالإتفاق أو بموجب القانون ليكون مسؤولا عن قاصر أو عن إنسان عاجز غير كفء…؛ في : المؤسسة أو الشخص الذي تَثِقُ فيه وَتُأَمِّنُهُ على أموالك وممتلكاتك، وهو الذي يدير أموال الوصية بعد الوفاة)\nمثال: مات من دون أن يترك وصية.",
 "executor-heir relation": "عَلَاقَة المُنَفِّذ بِالوَارِث (مسؤولية منفذ (أو مدير) التركة في التصرف بما يخدم مصلحة الوارث)",
 "executrix": "مُنَفِّذَة, مُنْجِزَة",
 "exegesis": "تَفْسِير",
 "exegete": "مُفَسِّر / فَسَّرَ",
 "exegetic": "تأويلي, تفسيري (متعلق بالتفسير (خاصة للنصوص الدينية))",
 "exegetical": "تأويلي, تفسيري (متعلق بالتفسير (خاصة للنصوص الدينية))",
 "exemplar": "أُسْوَة (أُسْوَةٌ)",
 "exemplariness": "مِثَالِيَّة, نَمُوذَجِيَّة (حالة أو شرط كون الشيء مثالياً، أو بمثابة مثال ساطع)",
 "exemplary": "نَمُوذَجِيّ / نَمُوذَجِيّ, مِثَالِيّ",
 "exemplary damages": "تعويضات رادعة, تعويضات عقابية ((قانون) تعويض يزيد عن الأضرار الفعلية (شكل من أشكال العقاب الممنوح في حالات سوء السلوك المتعمد أو الخبيث))",
 "exemplification": "تجسيد, تمثيل نمطي (شكل أو نموذج تمثيلي أو نمطي) / تمثيل, توضيح بالمثال (الإظهار عن طريق المثال)",
 "exemplifying": "تَمْثِيلِيّ, تَوْضِيحِيّ (يوضح عن طريق استخدام الأمثلة)",
 "exempt": "مُعْفًى",
 "exemption": "إعفاء, حصانة (فعل استثناء شخص ما أو منحه الحصانة) / إعفاء (خصم مسموح به لدافع الضرائب بسبب وضعه (وجود معالين معينين أو كونه كفيفاً أو تجاوز سن 65 إلخ)) / إعفاء, تحرر (الحصانة من التزام أو واجب)\nمثال: مُنح حصانة من الملاحقة القضائية",
 "exenteration": "استئصال الأحشاء (إزالة جراحية للأعضاء داخل تجويف الجسم (مثل أعضاء الحوض))",
 "exercise": "تَمْرِين, تَدْرِيب / تَمَرَّنَ",
 "exercise bicycle": "دَرَّاجَة ثَابِتَة (مَرْكَبَة من عجلتين أو ثلاث، ولها مقعد واحد عادة، مثل الدراجة الهوائية والدراجة النارية؛ دراجة هوائية. (تخصيص))\nمثال: كين يريد دراجة.",
 "exercise bike": "دراجة تمارين (جهاز تمارين يشبه الدراجة الثابتة)",
 "exercise book": "دَفْتَر, كُرَّاس",
 "exercise device": "جهاز تمارين, جهاز رياضي (جهاز مصمم لتوفير التمارين الرياضية للمستخدم)",
