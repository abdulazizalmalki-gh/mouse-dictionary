 "fagot": "حزمة حطب (حزمة من العصي والأغصان مربوطة معاً) / شاذ (مصطلح مهين لرجل مثلي الجنس)",
 "fagot stitch": "غرزة التجميع (الغرزة التي تربط مجموعة من الخيوط المتوازية معاً في التجميع)",
 "fagoting": "تجميع الخيوط (تطريز يتم فيه ربط مجموعات من الخيوط المتوازية معاً بغرز تجميع)",
 "fagus americana": "زان أمريكي (شجرة غابات أمريكية شمالية بأوراق خضراء فاتحة وجوز صالح للأكل)",
 "fagus grandifolia": "زان أمريكي (شجرة غابات أمريكية شمالية بأوراق خضراء فاتحة وجوز صالح للأكل)",
 "fagus pendula": "زان باكي, زان متهدل (صنف من الزان الأوروبي بأغصان متدلية)",
 "fagus purpurea": "زان أرجواني, زان نحاسي (صنف من الزان الأوروبي بأوراق أرجوانية لامعة أو نحاسية اللون)",
 "fagus sylvatica": "زان أوروبي, زان شائع (زان أوروبي كبير بأوراق مسننة بدقة؛ يُزرع على نطاق واسع للزينة في أمريكا الشمالية)",
 "fagus sylvatica atropunicea": "زان أرجواني, زان نحاسي (صنف من الزان الأوروبي بأوراق أرجوانية لامعة أو نحاسية اللون)",
 "fagus sylvatica pendula": "زان باكي, زان متهدل (صنف من الزان الأوروبي بأغصان متدلية)",
 "fagus sylvatica purpurea": "زان أرجواني, زان نحاسي (صنف من الزان الأوروبي بأوراق أرجوانية لامعة أو نحاسية اللون)",
 "fahrenheit scale": "مقياس فهرنهايت (مقياس درجة حرارة يحدد نقطة تجمد الماء عند 32 درجة ونقطة غليان الماء عند 212 درجة)",
 "fahrenheit thermometer": "مقياس حرارة فهرنهايت (مقياس حرارة مدرج بدرجات فهرنهايت)",
 "faience": "خزف مزجج, قيشاني (خزف مصقول مزين بألوان غير شفافة)",
 "fail": "أَخْفَقَ, فَشِلَ ((أَخْفَقَ): اضطرب وتحرك؛ (أَخْفَقَ)الطائر: ضرب بجناحيه.بجناحيه) / رَسَبَ (جعل مادة ما تترسب أو تنفصل عن سائل، خاصة في العمليات الكيميائية؛ أعلن فشل شخص في اختبار أو تقييم أكاديمي)\nمثال: برشاقة القط، قفز نحو الرف لكنه أخفق و سقط إلى الأرض.",
 "fail-deadly": "فَشَل قَاتِل (فَشَلَ الطالبُ في الامتحان: لم ينجح في الاختبار ولم يحقق النتيجة المطلوبة؛ فَشَلَ الشيءُ: انهار أو انكسر أو توقف عن العمل)\nمثال: فشل ياني مجددا.",
 "fail-safe": "ذَاتِيُّ الأَمَان (يزيل الخطر بالتعويض التلقائيّ عن أيّ عطل أو خلل) / مَأْمُون الفَشَل, مَضْمُون النَّتِيجَة (مضمون عدم فشله؛ آمن من الإخفاق) / آلية أمان ضد الفشل (آلية قادرة على العودة إلى حالة آمنة في حالة حدوث فشل أو عطل)",
 "failing": "فِي حَال عَدَم حُدُوث (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "faille": "فايل (قماش منسوج مضلع من الحرير أو الرايون أو القطن)",
 "failure": "فَشَل, قُصُور (فَشَلَ الطالبُ في الامتحان: لم ينجح في الاختبار ولم يحقق النتيجة المطلوبة؛ فَشَلَ الشيءُ: انهار أو انكسر أو توقف عن العمل) / فَشَل (فَشَلَ الطالبُ في الامتحان: لم ينجح في الاختبار ولم يحقق النتيجة المطلوبة؛ فَشَلَ الشيءُ: انهار أو انكسر أو توقف عن العمل) / عُطْل (أوقف أو جعل شيء غير فعال لفترة معينة؛ إيقاف شيء عن العمل أو تركه بدون استخدام أو اهتمام)\nمثال: فشل ياني مجددا.",
 "failure cost": "تكلفة الفشل (التكاليف التي تنشأ عن عدم مطابقة المنتجات/الخدمات للمتطلبات)",
 "fain": "برحابة صدر, بكل سرور (بسرور ورضا) / مُسْتَعِدّ, مُهَيَّأ (قد أعدّ نفسه واستعدّ للفعل)\nمثال: تمت الموافقة على هذا بكل سرور",
 "faineance": "بطالة, تراخ (سمة كون المرء عاطلاً بسبب العزوف عن العمل)",
 "faineant": "كَسُول, مُتَقَاعِس (غَيْر رَاغِب فِي العَمَل أَوِ الجُهْد)",
 "faint": "إِغْمَاء / أُغْمِيَ, غُشِيَ",
 "faint-hearted": "خَجُول, مُتَرَدِّد (يَفْتَقِر إِلَى القَنَاعَة أَوِ الجُرْأَة أَوِ الشَّجَاعَة)",
 "fainthearted": "خَجُول, مُتَرَدِّد (يَفْتَقِر إِلَى القَنَاعَة أَوِ الجُرْأَة أَوِ الشَّجَاعَة)",
 "faintheartedness": "ضعف القلب, وهن العزيمة (سمة الافتقار للجرأة والشجاعة)\nمثال: ضعف القلب ووهن العزيمة",
 "faintly": "بشكل خافت, بضعف (بدرجة خافتة أو مدركة بضعف)\nمثال: بينه وبين الضوء الخافت تم تحديد شكل بشكل خافت",
 "faintness": "خُفُوت, عَتْمَة (صفة كون الشيء خافتاً أو يفتقر إلى التباين) / ضعف القلب, وهن العزيمة (سمة الافتقار للجرأة والشجاعة) / خفوت, همس (مسموع بالكاد) / إعياء, خفوت (خاصية كون الشيء بلا قوة)\nمثال: ضعف القلب ووهن العزيمة",
 "fair": "أَشْقَر (هو لون الشُقْرَة، وأصله اللون الأحمر المائل إلى الصُفرة ثم أصبح يطلق على ما كان لونه أصفر أيضا؛ صفة ما كان لونه الشُقرة) / حَقَّانِيّ, عادِل / مَأْذُون, مُبَاح\nمثال: أنا لديها شعر بني كستنائي, ولكن ماجدالينا لديها شعر أشقر.",
 "fair ball": "كرة صحيحة, كرة عادلة ((بيسبول) كرة تضرب بالمضرب بحيث تبقى بين الخطوط (خطوط الفاول) التي تحدد عرض ملعب اللعب)",
 "fair catch": "التقاط حر ((كرة القدم الأمريكية) التقاط ركلة تشتيت في الهواء من قبل لاعب دفاعي أشار بأنه لن يركض وبالتالي لا ينبغي عرقلته)",
 "fair chance": "احتمال معقول, فرصة عادلة (احتمال معقول للنجاح)",
 "fair copy": "مبيضة, نسخة منقحة (نسخة نظيفة من مسودة مصححة)",
 "fair deal": "معاملة عادلة (معاملة منصفة)",
 "fair game": "ضَحِيَّة, فَرِيسَة (شخص يكون هدفاً لهجوم (خاصة السخرية أو الاستغلال) من قبل شخص أو تأثير معاد)\nمثال: وقع فريسة لقطاع الطرق",
 "fair ground": "دَاخِل الحُدُود, فِي المَنْطَقَة الصَّحِيحَة ((في البيسبول) بَيْنَ خَطَّيِ القَاعِدَةِ الأُولَى وَالثَّالِثَة)",
 "fair hearing": "جلسة استماع عادلة (جلسة استماع تُمنح في حالات استثنائية حيث تكون العملية القضائية العادية غير كافية لتأمين الإجراءات القانونية الواجبة لأن الشخص سيتضرر أو يُحرم من…)",
 "fair play": "لَعْب عَادِل (فعل شيئا للتسلية والترفيه، شَارَكَ في لعبة)\nمثال: لعب زيري التنس.",
 "fair sex": "الجنس اللطيف, النساء (النساء كطبقة)\nمثال: إنها إهانة للنساء الأمريكيات",
 "fair territory": "دَاخِل الحُدُود, فِي المَنْطَقَة الصَّحِيحَة ((في البيسبول) بَيْنَ خَطَّيِ القَاعِدَةِ الأُولَى وَالثَّالِثَة)",
 "fair to middling": "لَا بَأْسَ بِهِ, مَقْبُول (متوسّط المستوى تقريبًا؛ يمكن القبول به)",
 "fair trade": "تجارة مشروعة (التجارة التي تتم بشكل قانوني) / تجارة عادلة (تجارة تستوفي معايير معينة في سلسلة توريد السلع المعنية، تشمل عادة دفعاً عادلاً للمنتجين؛ وغالباً مع اعتبارات اجتماعية وبيئية أخرى)",
 "fair use": "استخدام عادل (الشروط التي يمكنك بموجبها استخدام مواد محمية بحقوق الطبع والنشر لشخص آخر دون دفع رسوم)",
 "fair weather": "إشراق, طقس صحو (طقس معتدل؛ مناسب للأنشطة الخارجية)",
 "fair-and-square": "عَادِل تَمَامًا, نَزِيه تَمَامًا (عَادِل وَصَادِق بِالكَامِل)",
 "fair-maids-of-france": "ساكسفراجا جرانيولاتا, كاسر الحجر المروجي (نبات معمر يشكل وريدات وله عناقيد مدمجة من الزهور البيضاء؛ أوروبا)",
 "fair-minded": "غَيْر مُتَحَيِّز, مُنْصِف (عَنِ الشَّخْص؛ عَادِل وَمُحَايِد؛ لَا يَحْمِل أَحْكَامًا مُسْبَقَة)",
 "fair-mindedness": "إنصاف, عدالة (القدرة على إصدار أحكام خالية من التمييز أو عدم الأمانة)",
 "fair-trade act": "قانون التجارة العادلة (قانون ولاية كان يحمي المصنعين سابقاً من خفض الأسعار بالسماح لهم بتحديد الحد الأدنى لأسعار التجزئة لبضائعهم)",
 "fair-trade agreement": "اتفاقية التجارة العادلة (اتفاقية (غير قانونية في الولايات المتحدة) بين الشركة المصنعة لعنصر تجاري وموزعي التجزئة لبيع العنصر بسعر محدد من قبل الشركة المصنعة أو أعلى منه)",
 "fairbanks": "فِيرْبَانْكْس",
 "fairground": "أرض المعارض (منطقة مفتوحة لإقامة المعارض أو السيرك)",
 "fairish": "أَشْقَر, فَاتِح ((يوصف به الشعر أو البشرة) فاتح اللون أو شاحب) / مَعْقُول, مُنْصِف (لَيْسَ مُفْرِطًا وَلَا مُتَطَرِّفًا)",
 "fairlead": "بكرة توجيه (للحبال) (بكرة تستخدم لتوجيه حبل يشكل جزءاً من تجهيزات السفينة لتجنب الاحتكاك)",
 "fairly": "مِن اَلْعَدْل, بِالْعَدْل (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "fairness": "إِنْصَاف (أخْذُ نِصْف الشيء أو وصول النصف؛ العَدْل والتَقْسِيم بالتساوي بدون أن يظلم أي من الطرفين)",
 "fairness commission": "لجنة الإنصاف (لجنة مفوضة لضمان الفرص للتعبير عن وجهات النظر المعارضة)",
 "fairway": "الممر (المنطقة بين نقطة الانطلاق والمنطقة الخضراء حيث يتم قص العشب قصيراً (في الجولف)) / ممر سالك (قطعة أرض خالية من العوائق للحركة) / ممر ملاحي (المسار المعتاد الذي تسلكه السفن عبر الميناء أو المياه الساحلية)",
 "fairway crested wheat grass": "عشبة القمح العرفية (عشبة أوراسية تزرع في منطقة السهول الكبرى بالولايات المتحدة للعلف ومكافحة التعرية)",
 "fairy": "جِنِّيَّة, سَاحِرَة",
 "fairy armadillo": "مدرع الجني, مدرع قزم (مدرع أرجنتيني صغير جداً ذو شعر حريري شاحب وصفائح وردية على الرأس والرقبة)",
 "fairy bell": "قفاز الثعلب, قمعية أرجوانية (نبات ثنائي الحول أو معمر أوروبي طويل ومورق له عناقيد مذهلة من الزهور الأنبوبية الوردية الأرجوانية الكبيرة؛ تنتج الأوراق دواء الديجيتال وهي سامة…)",
 "fairy bluebird": "طائر أزرق خرافى (طائر مغرد آكل للفاكهة ذو لون أزرق لامع غالباً من جزر الهند الشرقية)",
 "fairy circle": "حلقة الجنيات (حلقة من الفطريات تحدد محيط النمو الجوفي المعمر للميسيليوم)",
 "fairy cup": "ميتيلا ثنائية الورق (نبات من شمال شرق أمريكا الشمالية عادة بورقتين متقابلتين على سيقان مزهرة منتصبة تنتهي بعناقيد منتصبة من الزهور البيضاء) / كأس الجنية, كأس الدم (فطر أوروبي قرمزي بجسم ثمري كأسي الشكل)",
 "fairy godmother": "العرابة الجنية (شخصية أنثوية في بعض القصص الخيالية لها قوى سحرية ويمكنها جلب حظ سعيد غير متوقع للبطل أو البطلة) / عرابة جنية (أنثى محسنة كريمة)",
 "fairy lantern": "زنبق الكرة, فانوس الجنية (أي من النباتات العديدة من جنس كالوشورتوس ذات أزهار على شكل بيضة)",
 "fairy light": "ضوء الزينة (ضوء ملون صغير يستخدم للزينة (خاصة في عيد الميلاد))",
 "fairy ring": "حلقة الجنيات (حلقة من الفطريات تحدد محيط النمو الجوفي المعمر للميسيليوم)",
 "fairy shrimp": "روبيان الجنيات (غلصميات أرجل مياه عذبة صغيرة لها جسم شفاف بالعديد من الزوائد؛ تسبح على ظهرها)",
 "fairy story": "قصة خيالية, قصة ملفقة (قصة مثيرة للاهتمام ولكنها غير قابلة للتصديق إلى حد كبير؛ تُروى غالباً كعذر) / حِكَايَة خُرَافِيَّة, قِصَّة خَيَالِيَّة (قصة عن الجنيات؛ تُحكى لتسلية الأطفال)",
 "fairy swallow": "حمامة السنونو الخرافية (حمامة منزلية فاخرة ذات ريش أزرق وأبيض وأقدام مغطاة بالريش بكثافة)",
 "fairy tale": "قِصَّة خُرَافِيَّة, خُرَافَة",
 "fairy-ring mushroom": "فطر حلقة الجنيات (فطر ينمو في حلقة الجنيات)",
 "fairy-slipper": "خف الجنية, كاليبسو (أوركيد مستنقعات نادر في المنطقة المعتدلة الشمالية يحمل زهرة بيضاء إلى وردية وحيدة معلمة بالأرجواني عند طرف ساق محمر منتصب فوق ورقة قاعدية واحدة)",
 "fairyland": "أرض الجنيات, عالم الخيال (عالم الجنيات المسحور) / أرض الخيال, عالم خيالي (شيء موجود فقط في الخيال (ولكن غالبًا ما يُخطئ في اعتباره واقعًا))",
 "fairytale": "قصة خيالية, قصة ملفقة (قصة مثيرة للاهتمام ولكنها غير قابلة للتصديق إلى حد كبير؛ تُروى غالباً كعذر) / حِكَايَة خُرَافِيَّة, قِصَّة خَيَالِيَّة (قصة عن الجنيات؛ تُحكى لتسلية الأطفال)",
 "fait accompli": "أَمْر وَاقِع (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة)\nمثال: إنه أمر مختلف .",
 "faith": "إِيمَان, مُعْتَقَد / إِيمَان, دِين",
 "faith cure": "شفاء بالإيمان (الرعاية المقدمة من خلال الصلاة والإيمان بالله)",
 "faith healing": "شفاء بالإيمان (الرعاية المقدمة من خلال الصلاة والإيمان بالله)",
 "faithful": "وَفِيّ, مُخْلِص / أَمِين (من يتولى رقابة شيء أو المحافظة عليه؛ مُطْمَئِنّ)\nمثال: هو غبي وغير أمين.",
 "faithfully": "بِأَمَانَة, بِإِخْلَاص (بطريقة تتسم بالوفاء والموثوقية)\nمثال: كان يعمل دائماً، بإخلاص، مثل المذياع",
 "faithfulness": "الإِيمَان",
 "faithless": "خَائِن, غَدَّار (ذُو طَبِيعَة خِيَانِيَّة أَوْ مِنْ سِمَات الخَوَنَة)",
 "faithlessly": "بشكل خائن, خيانةً (بطريقة غير مخلصة وعديمة الوفاء)\nمثال: لقد تصرف بغدر",
 "faithlessness": "تَقَلُّب, غَدْر (عدم الوفاء بحكم عدم الموثوقية أو الغدر)",
 "fajr": "صَلَاة اَلْفَجْر, فَجْر",
 "fake": "مُزَيَّف",
 "fake book": "كتاب زائف (تزييف على شكل كتاب مقلد؛ يستخدم لملء مكتبات الأشخاص الذين يرغبون في الظهور بمظهر العلماء)",
 "fakeer": "فقير (راهب متسول مسلم أو هندوسي يُعتبر رجلاً مقدساً)",
 "faker": "دجال, محتال (شخص يقدم ادعاءات خادعة)",
 "fakery": "اصطناع, تزييف (فعل التزييف (أو نتاج التزييف))",
 "fakir": "فَقِير",
 "fal la": "مَقَاطِع بِلَا مَعْنًى (مقاطع لا معنى لها في لازمة أغنية)",
 "falafel": "فَلَافِل طَعْمِيَّة / فَلَافِل",
 "falanga": "ضرب باطن القدمين, فلقة (شكل من أشكال التعذيب تضرب فيه باطن القدمين بالسياط أو الهراوات)",
 "falange": "الكتائب (الحزب النازي الإسباني تحت حكم فرانكو)",
 "falangist": "كتائبي (عضو إسباني في حزب الجنرال فرانكو السياسي)",
 "falcate": "مِنْجَلِيّ, هِلَالِيّ الشَّكْل (منحنٍ كالمنجل)",
 "falcatifolium falciforme": "صنوبر منجلي شائع (شجرة غابات مطيرة استوائية صغيرة في إندونيسيا وماليزيا)",
 "falcatifolium taxoides": "صنوبر منجلي أصفر الأوراق (شجرة أو شجيرة غابات مطيرة في كاليدونيا الجديدة ذات تاج مخروطي وأوراق منجلية خضراء شاحبة؛ نوع مضيف لطفيل الطقسوس النادر)",
 "falchion": "سيف معقوف (سيف قصير عريض محدب قليلاً من العصور الوسطى بنقطة حادة)",
 "falciform": "مِنْجَلِيّ, هِلَالِيّ الشَّكْل (منحنٍ كالمنجل)",
 "falciform ligament": "رباط منجلي (رباط يربط جزءاً من الكبد بالحجاب الحاجز وجدار البطن)",
 "falco columbarius": "يؤيؤ (صقر صغير من أوروبا وأمريكا ذو ريش داكن وذيل مخطط بالأسود؛ يستخدم في الصيد بالصقور)",
 "falco peregrinus": "شاهين (صقر واسع الانتشار كان يستخدم سابقاً في الصيد بالصقور)",
 "falco rusticolus": "سنقر (صقر قطبي كبير ونادر له أطوار لونية بيضاء وداكنة)",
 "falco sparverius": "عوسق أمريكي (صقر صغير من أمريكا الشمالية)",
 "falco subbuteo": "شويهين (صقر صغير من العالم القديم كان يدرب ويطلق لصيد الطيور الصغيرة)",
 "falco tinnunculus": "عوسق (صقر صغير من العالم القديم يحوم في الهواء ضد الريح)",
 "falcon": "صَقْر, شَاهِين",
 "falcon-gentil": "أنثى الشاهين (أنثى الصقر وخاصة أنثى صقر الشاهين)",
 "falcon-gentle": "أنثى الشاهين (أنثى الصقر وخاصة أنثى صقر الشاهين)",
 "falconer": "بازيار, صقار (شخص يربي ويدرب الصقور ويمارس رياضة الصيد بالصقور)",
 "falconine": "صقري (يتعلق بالصقر أو يشبهه)",
 "falconry": "صَقَارَة",
 "falderol": "حلي تافهة, خردوات (أشياء زخرفية ليس لها قيمة كبيرة)",
 "falkland islands": "جُزُر فُوكْلَانْد, جُزُر فُوكْلَنْد (جَزَرَ الماءُ عن الأَرضِ يَجْزُرُ جَزْراً: نَضَبَ وحَسَرَ؛ ويقال: جَزَرَ البَحْرُ والنَّهْرُ: انْحسرَ ماؤُهُ)\nمثال: ضع الجزر في القدر.",
 "falkland islands monetary unit": "وحدة نقدية لجزر فوكلاند (الوحدة النقدية في جزر فوكلاند)",
 "fall": "وَقَعَ, سَقَطَ (الشيء: سَقَطَ، انحدر من مكان عال؛ الأمر: حَدَثَ، وأكثر ما يقال للأمر العظيم) / سَقَطَ (تَحَرَّكَ من أعلى إلى أسفل بتأثير الجاذبية، وَقَعَ؛ في كلامه: أخْطَأَ، أو قال قولا لا ينبغي أو لا يريد قوله) / سُقُوط, هُوِيّ (يحمل كافة معاني الفعل بصيغة المصدر)\nمثال: توم وقع و أصيب.",
 "fall armyworm": "دودة الحشد الخريفية (يرقة عثة ليلية أمريكية مهاجرة؛ تدمر الأعشاب والحبوب الصغيرة)",
 "fall asleep": "غَلَّبَ النُعَاس, نَامَ (قَهَرَ واِعْتَزَّ عليه واِمْتَنَع)",
 "fall behind": "تَأَخَّرَ",
 "fall cankerworm": "دودة الخريف القاطعة",
 "fall dandelion": "هندباء الخريف (عشبة أوروبية تزهر في الخريف بزهرة صفراء؛ متوطنة في الولايات المتحدة)",
 "fall equinox": "اعتدال خريفي (22 سبتمبر)",
 "fall for": "اِنْخَدَعَ بِـ / تَهَافَتَ عَلَى",
 "fall girl": "كبش فداء, مغفلة (شخص أنثى ساذجة ويسهل استغلالها)",
 "fall guy": "كبش فداء, مغفل (شخص ذكر ساذج ويسهل استغلاله)",
 "fall ill": "مَرِضَ, أُصِيبَ بِالْمَرَض (أصابه مرضٌ أو علّة أو سَقَم)\nمثال: هذا المرض قلبي.",
 "fall in love": "وَقَعَ فِي حُبّ (الشيء: سَقَطَ، انحدر من مكان عال؛ الأمر: حَدَثَ، وأكثر ما يقال للأمر العظيم)\nمثال: توم وقع و أصيب.",
 "fall of man": "السقوط, الهبوط ((الميثولوجيا اليهودية المسيحية) عندما أكل آدم وحواء من ثمر شجرة معرفة الخير والشر، فعاقبهما الله بإخراجهما من جنة عدن إلى العالم حيث يخضعان للمرض…)",
 "fall pregnant": "حَمَلَ (رَفَعَ، أَقَلَّ)\nمثال: حمل سامي سلاحه.",
 "fall victim": "وَقَعَ ضَحِيَّة, سَقَطَ ضَحِيَّة (الشيء: سَقَطَ، انحدر من مكان عال؛ الأمر: حَدَثَ، وأكثر ما يقال للأمر العظيم)\nمثال: توم وقع و أصيب.",
 "fall webworm": "دودة الويب الخريفية",
 "fall-blooming": "مُزْهِر فِي الخَرِيف (من النباتات التي تُزهر خلال فصل الخريف)",
 "fall-blooming hydrangea": "كوبية عثكولية, هيدرانجيا خريفية (شجيرة متساقطة الأوراق أو شجرة صغيرة بعناقيد زهور هرمية)",
 "fall-board": "غطاء لوحة المفاتيح (الغطاء الواقي المفصلي الذي يحمي لوحة مفاتيح البيانو عند عدم العزف عليه)",
 "fall-flowering": "مُزْهِر فِي الخَرِيف (من النباتات التي تُزهر خلال فصل الخريف)",
 "fallacious": "مُضَلِّل, مُغَالِط (مَبْنِيٌّ عَلَى فِكْرَةٍ خَاطِئَةٍ أَوْ مَعْلُومَةٍ مُضَلِّلَة) / احْتِيَالِيّ, زَائِف (ينطوي على خداع أو غشّ) / مُغَالِط, وَاهٍ (يَحْتَوِي عَلَى مُغَالَطَةٍ أَوْ مَبْنِيٌّ عَلَيْهَا)",
 "fallaciousness": "فَسَاد اسْتِدْلَال, مُغَالَطَة (نتيجة مغالطة أو خطأ في الاستدلال)",
 "fallacy": "مُغَالَطَة (أما من حيث الصورة فكقولنا لصورة الفرس المنقوش على الجدار: إنها فرس، وكل فرس صهال، ينتج أن تلك الصورة صهالة؛ وأما من حيث المعنى فلعدم رعاية وجود الموضوع في الموجبة)",
 "fallal": "حلي رخيصة, حلية مبهرجة (مجوهرات رخيصة ومبهرجة أو زينة على الملابس)",
 "fallback": "انسحاب, فك الاشتباك (وقف عمل عسكري مع عدو)",
 "fallboard": "غطاء لوحة المفاتيح (الغطاء الواقي المفصلي الذي يحمي لوحة مفاتيح البيانو عند عدم العزف عليه)",
 "fallen": "شَهِيد, صَرِيع (قُتل في المعركة) / سَاقِط, فَاقِد العِفَّة (فقد عفّته وطهارته) / سَاقِط, مُنْهَار (سَقَطَ أَوِ انْهَارَ) / مُتَسَاقِط, وَاقِع (سَقَطَ بِفِعْلِ قُوَّةِ الجَاذِبِيَّة)",
 "fallen angel": "مَلَاك سَاقِط",
 "fallen arch": "قدم مسطحة, قوس هابطة (قوس قدم مسطحة بحيث يرتكز النعل بالكامل على الأرض)",
 "faller": "سَاقِط, وَاقِع (شخص يسقط) / حطّاب (شخص يقطع الأشجار)",
 "fallibility": "قابلية الخطأ (احتمالية ارتكاب الأخطاء)",
 "fallible": "خطاء, عرضة للخطأ (من المحتمل أن يفشل أو يرتكب أخطاء) / ضَعِيف, قَابِل لِلْخَطَأ (يفتقر إلى القوّة الأخلاقيّة أو الشجاعة؛ له صفات بشريّة مقابل الكائنات الإلهيّة)\nمثال: الجميع معرضون للخطأ بدرجة ما",
 "falling": "سَاقِط, مُتَسَاقِط (يَنْزِلُ بِحُرِّيَّةٍ تَحْتَ تَأْثِيرِ الجَاذِبِيَّة) / منخفض, هابط (يصبح أقل أو أصغر في الدرجة أو القيمة) / مُتَرَاجِع, هَابِط (يتناقص في الكمّيّة أو الدرجة)\nمثال: سوق هابطة",
 "falling off": "تراجع, ركود (تدهور ملحوظ في الأداء أو الجودة)\nمثال: دخل الفريق في حالة ركود",
 "falling out": "انشقاق, صدع (انفصال شخصي أو اجتماعي (كما بين الفصائل المتعارضة))\nمثال: كانوا يأملون في تجنب قطيعة في العلاقات",
 "falloff": "تراجع, ركود (تدهور ملحوظ في الأداء أو الجودة)\nمثال: دخل الفريق في حالة ركود",
 "fallopian tube": "قَنَاةُ الرَّحِمِ",
 "fallot's syndrome": "رباعية فالو (عيب خلقي في القلب يسبب الزرقة؛ يتميز بأربعة أعراض: تضيق رئوي وعيب الحاجز البطيني وتراكب الأبهر فوق كلا البطينين وتضخم البطين الأيمن)",
 "fallot's tetralogy": "رباعية فالو (عيب خلقي في القلب يسبب الزرقة؛ يتميز بأربعة أعراض: تضيق رئوي وعيب الحاجز البطيني وتراكب الأبهر فوق كلا البطينين وتضخم البطين الأيمن)",
 "fallout": "أثر جانبي, تداعيات (أي تأثير ثانوي ضار وغير مرغوب فيه) / سقط نووي, غبار ذري (الجسيمات المشعة التي تستقر على الأرض بعد انفجار نووي)\nمثال: استراتيجية لاحتواء تداعيات فضيحة المحاسبة",
 "fallout shelter": "ملجأ نووي (ملجأ لحماية شاغليه من الغبار النووي الناتج عن قنبلة ذرية)",
 "fallow": "بُور, خَامِد (غير مُسْتَغَلّ لكنه مفيد محتملاً) / بُور (تُرك بلا حرث ولا بذر خلال موسم الزراعة) / أرض بور, أرض مُراحة (أرض زراعية لا يتم بذرها لموسم نمو واحد أو أكثر)",
 "fallow deer": "أيل أسمر (أيل أوراسي صغير)",
 "falls": "شلال (انحدار حاد لمياه النهر) / بتلات هابطة (البتلات أو السبلات في الزهرة التي تنحني لأسفل (خاصة الغلاف الزهري الخارجي للسوسن))",
 "fallujah": "فَلُّوجَة",
 "falmouth": "فالماوث",
 "false": "زَائِف, بَاطِل / كَاذِب",
 "false advertising": "إِعْلَان كَاذِب",
 "false alarm": "إنذار كاذب (تحذير يُعطى بشأن شيء يفشل في الحدوث)",
 "false alumroot": "أكواب مهدبة, تيليما (نبات ينمو في كتل بأوراق قاعدية غالباً وأزهار مهدبة قشدية اللون أو وردية باهتة في عدة عناقيد طويلة؛ ألاسكا إلى ساحل وسط كاليفورنيا وشرقاً إلى أيداهو)",
 "false analogy": "قِيَاس مَعَ الْفَارِق",
 "false asphodel": "أسفوديل كاذب (نبات من جنس توفيلديا ذو أوراق خطية قاعدية بشكل رئيسي وأزهار سنبلية صغيرة)",
 "false azalea": "أزاليا كاذبة, توت الأحمق (شجيرة متناثرة من شمال غرب أمريكا الشمالية ذات أوراق بمسحة مزرقة وخيمات من الزهور الصغيرة على شكل جرس)",
 "false baby's breath": "جويسئة بيضاء, فوة برية (عشب أوراسي ذو عناقيد واسعة من الزهور البيضاء الصغيرة؛ تم توطينه في أمريكا الشمالية)",
 "false beachdrops": "شبيه الغليون الهندي, عصارة الصنوبر",
 "false belief": "معتقد خاطئ, مغالطة (مفهوم خاطئ ناتج عن تفكير غير صحيح)",
 "false bittersweet": "حلوة مرة أمريكية, سيلاستروس (شجيرة ملتفة في أمريكا الشمالية لها كبسولات صفراء تحيط ببذور قرمزية)",
 "false bottom": "قاع زائف (هيكل أفقي يقسم سفينة أو صندوقاً (خاصةً ذلك المبني بالقرب من القاع الفعلي))",
 "false bracken": "براكن كاذب",
 "false buckthorn": "بوميلية صوفية, نبق كاذب (شجرة متساقطة الأوراق في جنوب شرق الولايات المتحدة والمكسيك)",
 "false bugbane": "طارد البق الكاذب (نبات معمر طويل في شرق الولايات المتحدة له أوراق قاعدية كبيرة وأزهار صيفية بيضاء)",
 "false calyx": "كَأْس كَاذِب, كُؤَيْس (مجموعة من القنابات تحاكي الكأس كما في القرنفل أو الخطمي)",
 "false chamomile": "بابونج كاذب (أي من النباتات المعمرة المتنوعة المزهرة في الخريف ذات أزهار بيضاء أو وردية إلى أرجوانية تشبه زهور الأستر؛ برية في التربة الرطبة من نيو جيرسي إلى…)",
 "false consciousness": "وَعْي زَائِف (الفَهْم والتَدَبُّر واِحْتِوَاء كل معاني الشيء؛ في علم النفس: حالة وعي ويعني أيضا محتوى العقل، ويشمل المشاعر والوعي الذاتي وٱلصور وَالأفكار وَٱلقدرة على إدراك العلاقة بين المرء وٱلبيئة والشعور بما…)\nمثال: إنها فاقدة الوعي.",
 "false daisy": "مُنْكَسِفَة مُفْتَرَشَة",
 "false deathcap": "قبعة الموت الكاذبة (غاريقون غالباً ما يتم الخلط بينه وبين كأس الموت)",
 "false dichotomy": "مأزق مفتعل",
 "false dogwood": "أزدرخت, زنزلخت (شجرة دائمة الخضرة في أمريكا الاستوائية ذات ثمار لبية تحتوي على الصابونين الذي كان يستخدم كصابون من قبل السكان الأصليين)",
 "false dragon head": "رأس التنين الكاذب, فيزوستيغيا (نبات أمريكي شمالي له سنبلة من الزهور الوردية أو البيضاء ثنائية الشفة)",
 "false dragonhead": "رأس التنين الكاذب, فيزوستيغيا (نبات أمريكي شمالي له سنبلة من الزهور الوردية أو البيضاء ثنائية الشفة)",
 "false face": "قناع تنكري, وجه مستعار (قناع يُرتدى كجزء من زي تنكري)",
 "false foxglove": "أوريولاريا, قفاز الثعلب الكاذب (نبات حولي متعدد السيقان في أمريكا الشمالية له أزهار إبطية وحيدة صفراء ذهبية داكنة تشبه أزهار قفاز الثعلب؛ يوضع أحياناً في جنس جيرارديا) / قفاز الثعلب الفرجيني (نبات معمر قليل التفرع في أمريكا الشمالية بعناقيد طرفية من الزهور الصفراء الزاهية تشبه أزهار قفاز الثعلب؛ يوضع أحياناً في جنس جيرارديا)",
 "false friend": "شِبْه نَظِير",
 "false fruit": "ثمرة تفاحية (فاكهة لحمية (تفاح أو كمثرى أو فواكه ذات صلة) تحتوي على غرف بذور وجزء خارجي لحمي)",
 "false garlic": "ثوم الكرمة, ثوم بري (بصل بري لاذع من العالم القديم)",
 "false gavial": "جافيال كاذب (تمساح من جنوب شرق آسيا يشبه الجافيال ولكنه أصغر منه)",
 "false glottis": "شق الدهليز, مزمار كاذب (الفتحة بين الطيات الصوتية الكاذبة)",
 "false goatsbeard": "أستيلب كاذب (أستيلب من أمريكا الشمالية بعناقيد من الزهور البيضاء الكريمية)",
 "false gromwell": "نبات الأحجار الكاذب (أي من عدة أعشاب معمرة في أمريكا الشمالية بأوراق مشعرة وأزهار صغيرة مصفرة أو مخضرة)",
 "false hair": "شعر مستعار, وصلة شعر (غطاء أو خصلة من شعر بشري أو صناعي تستخدم للتنكر أو الزينة)",
 "false heather": "خلنج ذهبي, خلنج كاذب (نبات أمريكي شمالي دائم الخضرة منبطح يشبه الخلنج بزهور صفراء)",
 "false hellebore": "خربق, خربق كاذب (أعشاب معمرة من العائلة الزنبقية لها جذمورات سميكة وسامة)",
 "false imprisonment": "احتجاز غير قانوني, حبس زائف ((قانون) الحبس بدون سلطة قانونية)",
 "false indigo": "نيلة كاذبة, نيلة كاليفورنية (شجيرة مشعرة قائمة إلى منتشرة من ساحل المحيط الهادئ للولايات المتحدة لها عناقيد من الزهور الحمراء إلى النيلية) / نيلة شجيرية, نيلة كاذبة (شجيرة كثيفة على ضفاف الأنهار الرطبة والسهول الفيضية في شرق الولايات المتحدة لها أوراق عطرة جذابة وعناقيد كثيفة من الزهور الأرجوانية الداكنة) / نيلة برية, نيلة كاذبة",
 "false labor": "انقباض براكستون هيكس, مخاض كاذب (انقباضات غير مؤلمة لعضلات الرحم تستمر طوال فترة الحمل بتواتر متزايد)",
 "false lily of the valley": "زنبق الوادي الكاذب الكندي (عشبة صغيرة ذات ورقتين من شمال الولايات المتحدة وأجزاء من كندا ذات عناقيد من الزهور البيضاء العطرة الصغيرة) / زنبق الوادي الكاذب (نبات صغير أبيض الزهر من غرب أوروبا إلى اليابان)",
 "false lupine": "بازلاء ذهبية, ترمس كاذب (عشب كثيف في غرب الولايات المتحدة له زهور صفراء تشبه البازلاء)",
 "false mallow": "خبازة كاذبة (نبات أمريكي من جنس مالفاستروم) / خبازة كروية (جنس من الأعشاب الخشنة والشجيرات الصغيرة في أمريكا الشمالية والجنوبية القاحلة لها زهور وردية أو قرمزية وثمار كروية)",
 "false mildew": "بياض زغبي, بياض كاذب (أي من الفطريات المختلفة من فصيلة بيرونوسبوراسيا تتطفل على العنب والبطاطس والبطيخ وغيرها)",
 "false mistletoe": "هدال, هدال كاذب (نباتات أمريكية تشبه إلى حد كبير هدال العالم القديم)",
 "false miterwort": "تياريلا قلبية الأوراق, زهرة الرغوة (نبات غابات رئدي أبيض الزهر يزهر في الربيع) / تياريلا وحيدة الورقة, ميتيلا كاذبة (نبات بأزهار بيضاء صغيرة تتدلى في عناقيد فضفاضة على سيقان ورقية؛ الغابات الرطبة من ألاسكا إلى وسط كاليفورنيا وشرقاً إلى مونتانا)",
 "false mitrewort": "تياريلا قلبية الأوراق, زهرة الرغوة (نبات غابات رئدي أبيض الزهر يزهر في الربيع) / تياريلا وحيدة الورقة, ميتيلا كاذبة (نبات بأزهار بيضاء صغيرة تتدلى في عناقيد فضفاضة على سيقان ورقية؛ الغابات الرطبة من ألاسكا إلى وسط كاليفورنيا وشرقاً إلى مونتانا)",
 "false morel": "موريل كاذب (فطر من فصيلة هيلفيلاسيا)",
 "false name": "اسم مستعار (اسم تم انتحاله)",
 "false nettle": "بوميريا, قراص كاذب (أي من عدة أعشاب ضارة مزهرة من جنس بوميريا تفتقر إلى الشعيرات اللاسعة)",
 "false oat": "شوفان طويل, شوفان كاذب (عشب أوراسي معمر خشن يشبه الشوفان؛ يوجد على حواف الطرق والأراضي العشبية الوعرة وفي مروج القش؛ أدخل إلى أمريكا الشمالية كعلف)",
 "false pimpernel": "عشبة قشية (نبات عشبي له أوراق قصيرة جافة تشبه القش)",
 "false pregnancy": "حمل كاذب (حالة فسيولوجية تظهر فيها المرأة أعراض الحمل ولكنها ليست حاملاً)",
 "false pretence": "ادعاء كاذب, انتحال صفة ((قانون) جريمة تنطوي على نية الاحتيال والتمثيل الكاذب والحصول على ممتلكات نتيجة لهذا التمثيل الكاذب)",
 "false pretense": "ادعاء كاذب, انتحال صفة ((قانون) جريمة تنطوي على نية الاحتيال والتمثيل الكاذب والحصول على ممتلكات نتيجة لهذا التمثيل الكاذب)",
 "false ragweed": "بلسان المستنقعات الشائك (بلسان مستنقعات حولي طويل شائع في التربة الغنية الرطبة في وسط أمريكا الشمالية يمكن أن يسبب التهاب الجلد التماسي؛ ينتج الكثير من حبوب اللقاح التي تعد…)",
 "false return": "إقرار كاذب (إقرار ضريبة دخل غير صحيح)",
 "false rue": "سداب كاذب, شقائق النعمان الكاذبة (نبات معمر نحيل وقائم في شرق أمريكا الشمالية له جذور درنية وأزهار بيضاء مشوبة بالوردي؛ يشبه سداب المروج)",
 "false rue anemone": "سداب كاذب, شقائق النعمان الكاذبة (نبات معمر نحيل وقائم في شرق أمريكا الشمالية له جذور درنية وأزهار بيضاء مشوبة بالوردي؛ يشبه سداب المروج)",
 "false saber-toothed tiger": "نمر سيفي الأسنان الزائف (قط من أمريكا الشمالية عاش في العصر الميوسيني والبليوسيني؛ أقدم بكثير وأقل تخصصاً من أعضاء جنس سميلودون)",
 "false saffron": "عصفر, قرطم (نبات أوراسي يشبه الشوك يُزرع على نطاق واسع لرؤوس زهوره الحمراء أو البرتقالية وبذوره التي تنتج زيتاً قيماً)",
 "false sago": "ساغو كاذب, سيكاس ملتف (سيكاد هندي جنوبي شرقي بأوراق تشبه النخيل)",
 "false sarsaparilla": "أراليا عارية الساق, سارساباريلا كاذبة (عشب معمر شائع له جذور عطرية تستخدم كبديل للسارساباريلا؛ وسط وشرق أمريكا الشمالية)",
 "false scorpion": "عقرب زائف (عنكبوتي صغير غير سام يشبه العقرب عديم الذيل)",
 "false smut": "تفحم أخضر, تفحم كاذب (مرض يصيب الأرز؛ حيث تُغطى الحبوب بمسحوق أخضر يتكون من كونيديا)",
 "false tamarisk": "أثل ألماني, أثل كاذب (شجيرة أوراسية تشبه الأثل)",
 "false teeth": "أسنان اصطناعية, طقم أسنان (طقم أسنان قابل للإزالة)",
 "false topaz": "توباز, توباز زائف (كوارتز أصفر)",
 "false truffle": "كرة الأرض, كمأة كاذبة (أي من الفطريات المختلفة من جنس سكليروديرما لها أجسام ثمرية تحت أرضية صلبة الجلد تشبه الكمأة) / كمأة كاذبة (أي من الفطريات المختلفة من فصيلة ريزوبوجوناسيا لها أجسام ثمرية تحت أرضية تشبه الكمأة)",
 "false vampire": "خفاش مصاص دماء كاذب (أي خفاش لاحم من العالم الجديد أو القديم يُعتقد خطأً أنه يمتص الدم ولكنه في الواقع يتغذى على الحشرات)",
 "false vampire bat": "خفاش مصاص دماء كاذب (أي خفاش لاحم من العالم الجديد أو القديم يُعتقد خطأً أنه يمتص الدم ولكنه في الواقع يتغذى على الحشرات)",
 "false verdict": "حكم كاذب (حكم غير عادل بشكل واضح؛ غير صادق للأدلة)",
 "false vocal cord": "حبل صوتي كاذب (أي من الحبلين الصوتيين العلويين غير المشاركين في التصويت)",
 "false vocal fold": "حبل صوتي كاذب (أي من الحبلين الصوتيين العلويين غير المشاركين في التصويت)",
 "false wintergreen": "وينترغرين كاذب (دائم الخضرة من شرق أمريكا الشمالية بأوراق جلدية والعديد من الزهور البيضاء)",
 "false witness": "حانث باليمين, شاهد زور (شخص يدلي بشهادة كاذبة عمداً)",
 "falsehood": "بَاطِل, أَبَاطِيل (نقيض الحَقّ)\nمثال: ومن كلام الباطل فابعد.",
 "falsely": "بشكل خاطئ, خطأً (بطريقة غير صحيحة) / زيفاً, نفاقاً (بطريقة كاذبة وغير صادقة)\nمثال: إن نسب الفضل إلى ليستر في أول صياغة للمبدأ الأساسي لعلم الطبقات الأرضية سيكون منحاً للفضل بشكل خاطئ",
 "falseness": "رياء, زيف (صفة عدم الصراحة أو الصدق؛ الخداع أو النفاق) / تَقَلُّب, غَدْر (عدم الوفاء بحكم عدم الموثوقية أو الغدر) / بطلان, زيف (حالة كون الشيء زائفاً أو غير صحيح)\nمثال: الجدل لم يستطع تحديد صدقه أو زيفه",
 "falsetto": "فَالْسِيتُّو (عالي النبرة اصطناعيّاً؛ فوق المدى الصوتيّ الطبيعيّ) / صوت مستعار, فالسيتو (صوت غنائي ذكوري بنغمات عالية مصطنعة في سجل علوي)",
 "falsie": "حشوة الصدرية (حشوة تُرتدى داخل حمالة الصدر) / رِمْش اِصْطِنَاعِيّ (رموش صناعية)",
 "falsifiable": "قَابِلٌ لِلتَّحَقُّق, قَابِلٌ لِلتَّكْذِيب (يمكن اختباره (التحقّق منه أو تكذيبه) بالتجربة أو الملاحظة)",
