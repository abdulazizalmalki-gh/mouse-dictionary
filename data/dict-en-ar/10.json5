 "fistulate": "أُنْبُوبِيٌّ أَجْوَف, نَاسُورِيّ (أجوف وأنبوبيّ الشكل كالقصبة)",
 "fistulina hepatica": "فطر شريحة اللحم (فطر صالح للأكل شائع بقبعة بلون الكبد أو اللحم النيئ؛ وفير في جنوب شرق الولايات المتحدة)",
 "fistulous": "أُنْبُوبِيٌّ أَجْوَف, نَاسُورِيّ (أجوف وأنبوبيّ الشكل كالقصبة) / ناسوري (مكون من أو يخص أو يشبه الناسور)",
 "fistulous withers": "ناسور الحارك (التهاب مزمن في حارك الحصان)",
 "fit": "لَاقَ (مَنْ يَلْقَى غَيْرَهُ) / نَاسَبَ, لَاقَ / نَاسَبَ",
 "fitch": "ظربان أوروبي (حيوان عرسيات بني داكن من غابات أوراسيا يطلق رائحة كريهة عند التهديد)",
 "fitful": "مُتَذَبْذِب, مُتَقَلِّب (يَتَوَقَّف ويَبْدَأ بِشَكْلٍ مُتَقَطِّع) / تَشَنُّجِيّ, نَوْبِيّ (يَحْدُثُ عَلَى شَكْلِ نَوْبَاتٍ وَغَالِبًا بِشَكْلٍ مُفَاجِئ)",
 "fitfully": "باضطراب, بشكل متقطع (بطريقة متقطعة وغير مستقرة)\nمثال: نام بشكل متقطع",
 "fitfulness": "تَذَبْذُب, تَقَطُّع (صفة كون الشيء متشنجاً وغير منتظم)",
 "fitly": "بشكل لائق, بشكل مناسب (بما يتوافق مع ما هو مناسب أو ملائم للظروف)\nمثال: كان يرتدي ملابس مناسبة",
 "fitment": "تجهيزات ثابتة, تركيبات (أي من العناصر التي تؤثث أو تجهز غرفة (خاصة الأثاث المدمج))\nمثال: أعجبتها تجهيزات المطبخ",
