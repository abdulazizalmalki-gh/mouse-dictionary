 "cyathea medullaris": "سرخس شجري أسود, سرخس شجري فضي (سرخس شجري مبهرج في نيوزيلندا وأستراليا له تاج من السعف الريشي بجوانب سفلية بيضاء)",
 "cyber monday": "الِاثْنَيْن الْإِلِكْتْرُونِيّ",
 "cyber-terrorism": "إرهاب إلكتروني, حرب إلكترونية (هجوم على شبكات الاتصالات الإلكترونية)",
 "cyber-terrorist": "إرهابي إلكتروني (مبرمج يخترق أنظمة الكمبيوتر لسرقة أو تغيير أو تدمير المعلومات كشكل من أشكال الإرهاب الإلكتروني)",
 "cyberart": "فن رقمي, فن سيبراني (فن يتم إنتاجه بمساعدة أجهزة وبرامج الكمبيوتر)",
 "cybercafe": "مقهى إنترنت (مقهى يجلس عملاؤه أمام محطات الكمبيوتر ويسجلون الدخول إلى الإنترنت أثناء تناول الطعام والشراب)",
 "cybercrime": "جريمة إلكترونية (جريمة ترتكب باستخدام الحاسوب والإنترنت لسرقة هوية شخص أو بيع المهربات أو مطاردة الضحايا أو تعطيل العمليات ببرامج خبيثة)",
 "cyberculture": "ثقافة الإنترنت, ثقافة رقمية (الثقافة التي تنشأ من استخدام الحواسيب للاتصال والترفيه والأعمال)",
 "cybernation": "حوسبة (التحكم في العمليات بواسطة الحاسوب)",
 "cybernaut": "رائد فضاء إلكتروني, متصفح إنترنت (مستخدم حاسوب يستخدم الإنترنت؛ شخص يستكشف الفضاء الإلكتروني)",
 "cybernetic": "سيبراني, سيبرنيطيقي (من أو متعلق بمبادئ علم السيبرنيطيقا (التحكم والاتصال))\nمثال: بحث سيبراني",
 "cybernetics": "سَبْرَانِيَّة",
 "cyberphobia": "رهاب التكنولوجيا, رهاب الحاسوب (خوف غير عقلاني من الحواسيب أو التكنولوجيا)",
 "cyberpunk": "سايبربانك (نوع من الخيال العلمي سريع الإيقاع يتضمن مجتمعات مستقبلية محوسبة وقمعية) / كاتب سايبربانك (كاتب خيال علمي تدور أحداث قصصه في ثقافة فرعية خارجة عن القانون لمجتمع قمعي تسيطر عليه تكنولوجيا الكمبيوتر) / إرهابي إلكتروني (مبرمج يخترق أنظمة الكمبيوتر لسرقة أو تغيير أو تدمير المعلومات كشكل من أشكال الإرهاب الإلكتروني)",
 "cybersex": "جنس إلكتروني (استثارة جنسية تنطوي على التواصل عبر الإنترنت)",
 "cyberspace": "إنترنت, شبكة المعلومات الدولية (شبكة المعلومات العالمية)\nمثال: كان ياني على الإنترنت.",
 "cyberwar": "حَرْب إِلِكْتُرُونِيَّة, حَرْب سِيبْرَانِيَّة (حَرَبَ (حربه) بالحربة حربا: طعنه بها؛ حَرَبَ (ه) حربا: سلبه جميع ما يملك)\nمثال: بوتين مجرم حرب.",
 "cyborg": "سَايْبُورْغ",
 "cycad": "سيكاد, نخلة السايكس (أي نبات عاري البذور استوائي من رتبة السيكاديات؛ له سيقان غير متفرعة مع تاج من أوراق تشبه السرخس)",
 "cycas": "سِيكَاس",
 "cycas circinalis": "ساغو كاذب, سيكاس ملتف (سيكاد هندي جنوبي شرقي بأوراق تشبه النخيل)",
 "cycas revoluta": "سيكاس, نخيل الساغو (سيكاد قزم يشبه النخيل من اليابان ينتج الساغو)",
 "cyclades": "الحضارة السيكلادية (حضارة العصر البرونزي في جزر سيكلاديز في جنوب بحر إيجة التي ازدهرت 3000-1100 قبل الميلاد)",
 "cycladic civilisation": "الحضارة السيكلادية (حضارة العصر البرونزي في جزر سيكلاديز في جنوب بحر إيجة التي ازدهرت 3000-1100 قبل الميلاد)",
 "cycladic civilization": "الحضارة السيكلادية (حضارة العصر البرونزي في جزر سيكلاديز في جنوب بحر إيجة التي ازدهرت 3000-1100 قبل الميلاد)",
 "cycladic culture": "الحضارة السيكلادية (حضارة العصر البرونزي في جزر سيكلاديز في جنوب بحر إيجة التي ازدهرت 3000-1100 قبل الميلاد)",
 "cyclamate": "سيكلامات (أي ملح أو إستر لحمض السيكلاميك)",
 "cyclamen": ":بخور مريم",
 "cyclamen hederifolium": "خبز الخنزير, سيكلامين لبلابي الأوراق (سيكلامين أوروبي بري شائع بزهور وردية)",
 "cyclamen neopolitanum": "خبز الخنزير, سيكلامين لبلابي الأوراق (سيكلامين أوروبي بري شائع بزهور وردية)",
 "cyclamen purpurascens": "بخو, سيكلامين (نبات متوسطي يُزرع على نطاق واسع كنبات منزلي لأوراقه الخضراء الداكنة المبهرجة الملطخة بالفضة وزهوره البيضاء أو الوردية إلى المحمرة المتدلية بتلات…)",
 "cycle": "دَوْر, دَوْرَة (جَعَله يَدُور؛ جَعَلَه مُدَوَّر) / دَوْرَة (في غرب العراق على نهر الفرات قرب الحدود السورية؛ حَيّ في جنوب بغداد تقع فيه محطة تكرير للنفط تسمّى بإسمه)\nمثال: في أي دور تسكن؟",
 "cycle of rebirth": "دورة الولادة الجديدة ((في الهندوسية) الولادة الجديدة المتكررة في أشكال جديدة)",
 "cycle per second": "دَوْرَة فِي الثَّانِيَة, هَرْتز (وحدة التردد؛ الهرتز الواحد له فترة دورية تبلغ ثانية واحدة (سميت تيمناً بـ هاينريش رودولف هرتز))",
 "cycle rickshaw": "ريكشو دراجة, عربة نقل بدواسات (دراجة ثلاثية العجلات (تدفع عادة بالتدويس)؛ تستخدم في الشرق لنقل الركاب بالأجرة)\nمثال: الأولاد الذين كانوا يسحبون الريكشو سابقاً يركبون الآن دراجات الريكشو",
 "cycles/second": "دَوْرَة فِي الثَّانِيَة, هَرْتز (وحدة التردد؛ الهرتز الواحد له فترة دورية تبلغ ثانية واحدة (سميت تيمناً بـ هاينريش رودولف هرتز))",
 "cyclic": "حلقي, دوري (يتكرر في دورات) / حلقي (عن مركب يحتوي على ذرات مرتبة في هيكل حلقي) / حلقي, سواري (يشكل دوارة أو تكون أجزاؤه مرتبة في دوارة) / دَوْرِيّ (يتميز بدورات متكررة)\nمثال: بتلات سوارية",
 "cyclic disorder": "اضطراب المزاج الدوري, دوروية المزاج (اضطراب ثنائي القطب خفيف يستمر لفترة طويلة)",
 "cyclic neutropenia": "قلة العدلات الدورية (قلة عدلات تحدث بشكل دوري)",
 "cyclic redundancy check": "فحص التكرار الدوري (رمز لتصحيح الخطأ يُسجل في كل قطاع من القرص المغناطيسي ويُستخدم لاكتشاف الأخطاء في البيانات)",
 "cyclical": "حلقي, دوري (يتكرر في دورات)",
 "cyclical deficit": "عجز دوري (عجز مرتبط بدورة الأعمال أو الدورة الاقتصادية)\nمثال: عادة ما يحدث العجز الدوري في أدنى نقطة من دورة الأعمال عندما تكون هناك مستويات منخفضة من النشاط التجاري ومستويات عالية من البطالة",
 "cyclicity": "دَوْرِيَّة (صفة التكرار على فترات منتظمة)",
 "cycling": "رُكُوب الدَّرَاجَات",
 "cyclist": "دَرَّاج",
 "cycloalkene": "ألكين حلقي (هيدروكربون ألكيني يحتوي على حلقة مغلقة من ذرات الكربون، ولكن ليس له طابع عطري)",
 "cyclobenzaprine": "سيكلوبنزابرين, فليكسيريل (مرخي عضلات (الاسم التجاري فليكسيريل) يستخدم لتشنجات العضلات أو الإصابة الحادة)",
 "cyclodestructive surgery": "جراحة الجسم الهدبي (عملية عيون تعالج الجلوكوما بتدمير الجسم الهدبي بالليزر)",
 "cyclohexanol": "سيكلوهكسانول (كحول زيتي عديم اللون تفوح منه رائحة الكافور)",
 "cyclohexanol phthalate": "فثالات الهكسانول الحلقي (إستر الهكسانول الحلقي لحمض الفثاليك)",
 "cycloid": "دَائِرِيّ, دَوَرَانِيّ (يشبه الدائرة في شكله) / دويري (خط يتولد عن نقطة على دائرة تتدحرج على طول خط مستقيم)",
 "cycloidal": "دَائِرِيّ, دَوَرَانِيّ (يشبه الدائرة في شكله)",
 "cycloloma atriplicifolium": "عشبة الخنازير المجنحة, عشبة دحروجة (عشبة حولية كثيفة في وسط أمريكا الشمالية ذات أزهار مخضرة وبذور مجنحة)",
 "cyclonal": "إعصاري (من أو متعلق أو مميز لعاصفة استوائية عنيفة) / إعصاري (من أو متعلق أو مميز للغلاف الجوي حول مركز ضغط منخفض)\nمثال: دمار إعصاري",
 "cyclone": "إِعْصَار (الرِيَاح التي تهب من الأرض وتثير الغبار فترتفع كالعمود إلى نحو السماء. زَوْبَعَة؛ دوّامات هوائيّة شديدة السرعة تدور حول مراكزٍ من الهواء عالي الضغط، سواء كانت فوق الأرض أو فوق الماء. [])\nمثال: السطح دمر من قبل الإعصار.",
 "cyclone cellar": "قبو العواصف, ملجأ الأعاصير (ملجأ تحت الأرض يمكنك الذهاب إليه حتى تمر العاصفة)",
 "cyclonic": "إعصاري (من أو متعلق أو مميز لعاصفة استوائية عنيفة) / إعصاري (من أو متعلق أو مميز للغلاف الجوي حول مركز ضغط منخفض)\nمثال: دمار إعصاري",
 "cyclonic cleaner": "مكنسة إعصارية, مكنسة بدون كيس (مكنسة كهربائية يُفصل فيها الغبار في وعاء تجميع أسطواني قابل للفصل)\nمثال: المكانس الإعصارية لا تستخدم أكياس الترشيح",
 "cyclonic vacuum": "مكنسة إعصارية, مكنسة بدون كيس (مكنسة كهربائية يُفصل فيها الغبار في وعاء تجميع أسطواني قابل للفصل)\nمثال: المكانس الإعصارية لا تستخدم أكياس الترشيح",
 "cyclonic vacuum cleaner": "مكنسة إعصارية, مكنسة بدون كيس (مكنسة كهربائية يُفصل فيها الغبار في وعاء تجميع أسطواني قابل للفصل)\nمثال: المكانس الإعصارية لا تستخدم أكياس الترشيح",
 "cyclonical": "إعصاري (من أو متعلق أو مميز لعاصفة استوائية عنيفة) / إعصاري (من أو متعلق أو مميز للغلاف الجوي حول مركز ضغط منخفض)\nمثال: دمار إعصاري",
 "cycloolefin": "ألكين حلقي (هيدروكربون ألكيني يحتوي على حلقة مغلقة من ذرات الكربون، ولكن ليس له طابع عطري)",
 "cyclooxygenase": "سيكلوأكسيجيناز (أحد إنزيمين مرتبطين يتحكمان في إنتاج البروستاغلاندين ويتم حظرهما بواسطة الأسبرين)",
 "cyclooxygenase-1": "سيكلوأكسيجيناز-1 (إنزيم ينظم البروستاغلاندينات المهمة لصحة بطانة المعدة والكلى)",
 "cyclooxygenase-2": "سيكلوأكسيجيناز-2 (إنزيم يصنع البروستاغلاندينات التي تسبب الالتهاب والألم والحمى)",
 "cyclopaedia": "دائرة معارف, موسوعة (عمل مرجعي (غالباً في عدة مجلدات) يحتوي على مقالات حول مواضيع مختلفة (مرتبة غالباً بترتيب أبجدي) تتناول كامل نطاق المعرفة البشرية أو تخصصاً معيناً)",
 "cyclopean": "سيكلوبي, عملاق (من أو متعلق أو يشبه السيكلوب (عملاق بعين واحدة في الأساطير))\nمثال: عين سيكلوبية",
 "cyclopean masonry": "بناء جلمودي, بناء سيكلوبي (نمط بدائي من البناء يتميز باستخدام حجارة ضخمة غير منتظمة الشكل والحجم)",
 "cyclopedia": "دائرة معارف, موسوعة (عمل مرجعي (غالباً في عدة مجلدات) يحتوي على مقالات حول مواضيع مختلفة (مرتبة غالباً بترتيب أبجدي) تتناول كامل نطاق المعرفة البشرية أو تخصصاً معيناً)",
 "cyclopes didactylus": "آكل النمل الحريري (آكل نمل من أمريكا الجنوبية بحجم السنجاب وعديم الأسنان ذو فرو ذهبي حريري طويل)",
 "cyclophorus lingua": "سرخس اللباد, سرخس اللسان (سرخس شرق آسيوي له سعف يشبه الألسنة؛ يوضع أحياناً في جنس سيكلوفوروس)",
 "cyclopia": "أحادية العين, تصقلب (شذوذ في النمو يوجد فيه عين واحدة فقط)",
 "cyclopropane": "بروبان حلقي, سيكلوبروبان (غاز عديم اللون قابل للاشتعال يستخدم أحياناً كمخدر استنشاقي)",
 "cyclops": "سَايْكْلُوب",
 "cyclopterus lumpus": "سمكة الكتل (سمكة خرقاء ناعمة سميكة الجسم في شمال المحيط الأطلسي مع زعانف حوضية ملتحمة في ممص؛ يستخدم بطرخها الصالح للأكل للكافيار)",
 "cyclorama": "بانوراما, مشهد شامل (صورة (أو سلسلة صور) تمثل مشهداً مستمراً)",
 "cycloserine": "سيكلوسيرين (مضاد حيوي فعال بشكل خاص ضد عصية السل)",
 "cyclosis": "انسياب سيتوبلازمي, حركة دائرية سيتوبلازمية (دوران السيتوبلازم داخل الخلية)",
 "cyclostome": "دائريات الفم (فقاري مائي بدائي)",
 "cyclostyle": "سايكلوستايل, قلم ناسخ (أداة كتابة ذات عجلة مسننة صغيرة تقطع ثقوباً صغيرة في ورق الاستنسل)",
 "cyclothymia": "اضطراب المزاج الدوري, دوروية المزاج (اضطراب ثنائي القطب خفيف يستمر لفترة طويلة)",
 "cyclothymic": "دوري المزاج (من أو متعلق أو يظهر تقلب المزاج الدوري (اضطراب المزاج))",
 "cyclothymic disorder": "اضطراب المزاج الدوري, دوروية المزاج (اضطراب ثنائي القطب خفيف يستمر لفترة طويلة)",
 "cyclotron": "سيكلوترون (معجل يمنح طاقات تبلغ عدة ملايين من الإلكترون فولت للجسيمات سريعة الحركة)",
 "cyder": "عصير التفاح, نبيذ التفاح (مشروب مصنوع من العصير المستخرج من التفاح)",
 "cydonia oblonga": "سفرجل (شجرة آسيوية صغيرة ذات زهور وردية وفاكهة كمثرية الشكل؛ تزرع على نطاق واسع)",
 "cygnet": "فرخ البجع (بجعة صغيرة)",
 "cygnus": "الدَّجَاجَة",
 "cygnus atratus": "تم أسود (بجعة أسترالية كبيرة ذات ريش أسود ومنقار أحمر)",
 "cygnus buccinator": "تم بواق (بجعة برية بيضاء نقية كبيرة من غرب أمريكا الشمالية لها صرخة رنانة)",
 "cygnus columbianus": "تم التندرا (بجعة تعشش في مناطق التندرا في العالم الجديد والقديم)",
 "cygnus columbianus bewickii": "تم بيويك (نويع أوراسي من تم التندرا؛ أصغر من التم الناعق)",
 "cygnus columbianus columbianus": "تم صفار (نويع من تم التندرا في أمريكا الشمالية له نغمة صفير ناعمة)",
 "cygnus cygnus": "تم ناعق (بجعة شائعة في العالم القديم تشتهر بندائها الناعق)",
 "cygnus olor": "تم صامت (بجعة أوراسية صامتة؛ يتم تدجينها عادة)",
 "cylinder": "أُسْطُوَانَة",
 "cylinder block": "كتلة المحرك (مصبوب معدني يحتوي على الأسطوانات وقنوات التبريد للمحرك)\nمثال: كان لا بد من استبدال المحرك لأن الكتلة كانت متشققة",
 "cylinder head": "رأس الأسطوانة (لوحة قابلة للفصل تغطي الطرف المغلق لغرفة الأسطوانة في محرك ترددي أو مضخة)",
 "cylinder lock": "قفل أسطواني (قفل تدور فيه أسطوانة لتحريك الترباس؛ الريش عبارة عن دبابيس؛ يؤدي إدخال المفتاح إلى رفع ومحاذاة الدبابيس لتحرير الأسطوانة للدوران)",
 "cylinder press": "مكبس أسطواني, مكبس مسطح (مكبس طباعة حيث يتم حمل الحروف على سرير مسطح تحت أسطوانة تحمل الورق وتتدحرج فوق الحروف)",
 "cylinder separator": "فاصل أسطواني مسنن (آلة لفصل الحبوب حسب طول الحبة)",
 "cylindric": "أُسْطُوَانِيّ (ذو شكل الأسطوانة)",
 "cylindrical": "أُسْطُوَانِيّ (ذو شكل الأسطوانة)",
 "cylindrical lining": "بطانة أسطوانية, جلبة (بطانة معدنية أسطوانية تستخدم لتقليل الاحتكاك)",
 "cylindrical-stemmed": "أُسْطُوَانِيّ السَّاق (ذو ساق أسطوانيّة الشكل)",
 "cylindricality": "أسطوانية (استدارة أسطوانة ثلاثية الأبعاد)",
 "cylindricalness": "أسطوانية (استدارة أسطوانة ثلاثية الأبعاد)",
 "cylix": "كأس إغريقية, كيليكس (كأس شرب ضحلة ذات مقبضين؛ استخدمت في اليونان القديمة)",
 "cyma": "سيما (إطار متموج)",
 "cyma recta": "سيما ريكتا (إطار سيما يكون فيه القسم العلوي مقعراً والسفلي محدباً)",
 "cyma reversa": "أوجي, سيما معكوسة",
 "cymatium": "سيما (إطار متموج)",
 "cymbal": "صَنْج",
 "cymbalist": "عازف الصنج (مؤدٍ يعزف على الصنج)",
 "cymbid": "سيمبيديوم (أي من النباتات المختلفة من جنس سيمبيديوم ذات أوراق ضيقة وعنقود متدل طويل من الزهور العديدة المبهرجة ومتنوعة الألوان على شكل قارب؛ مهجنة ومزروعة على…)",
 "cymbidium": "سيمبيديوم (أي من النباتات المختلفة من جنس سيمبيديوم ذات أوراق ضيقة وعنقود متدل طويل من الزهور العديدة المبهرجة ومتنوعة الألوان على شكل قارب؛ مهجنة ومزروعة على…)",
 "cyme": "سيمة, نورة محدودة (عنقود زهري مسطح القمة تقريبًا تفتح فيه الزهرة المركزية أو الطرفية أولاً)",
 "cymene": "سيمين (أي من ثلاثة نظائر لهيدروكربون سائل عطري عديم اللون يوجد في الزيت المتطاير للكمون والزعتر ويستخدم في تصنيع الراتنجات الاصطناعية)",
 "cymling": "قرع باتيبان, قرع صدفي (نبات قرع له ثمار مستديرة مفلطحة بحافة صدفية؛ عادة ما تكون بيضاء مخضرة)",
 "cymograph": "راسم التموج, كيموجراف (أداة علمية تتكون من أسطوانة دوارة تحمل ورقاً يتتبع عليه قلم تسجيلاً مستمراً (مثل التنفس أو ضغط الدم))",
 "cymose": "سِيمِيّ (لَهُ عُنْقُودٌ زَهْرِيٌّ مُسَطَّحٌ يَنْتَهِي كُلُّ سَاقٍ فِيهِ بِزَهْرَةٍ تَتَفَتَّحُ قَبْلَ مَا تَحْتَهَا)",
 "cymric": "الويلزية (لغة كلتية في ويلز)",
 "cymric language": "الويلزية (لغة كلتية في ويلز)",
 "cymry": "ويلزي (مواطن أو مقيم في ويلز)",
 "cymule": "سيمة صغيرة (سيمة صغيرة، وعادة ما تكون قليلة الزهور)",
 "cynanchum": "سينانكوم (أي من الليانا الاستوائية العملاقة المتنوعة غالباً في إفريقيا ومدغشقر لها زهور مخضرة أو أرجوانية وقرون ملساء طويلة؛ كانت الجذور تستخدم سابقاً كمقيء)",
 "cynancum": "سينانكوم (أي من الليانا الاستوائية العملاقة المتنوعة غالباً في إفريقيا ومدغشقر لها زهور مخضرة أو أرجوانية وقرون ملساء طويلة؛ كانت الجذور تستخدم سابقاً كمقيء)",
 "cynara cardunculus": "خرشوف بري, خرشوف ناتش (نبات من جنوب أوروبا ذو أوراق شائكة وأزهار أرجوانية يزرع لسيقان أوراقه وجذوره الصالحة للأكل)",
 "cynara scolymus": "أرضي شوكي, خرشوف (نبات متوسطي يشبه الشوك يزرع على نطاق واسع لرأسه الزهري الكبير الصالح للأكل)",
 "cynic": "كَلْبِيّ",
 "cynical": "سَاخِر",
 "cynically": "بِتَهَكُّم, بِسُخْرِيَة مَرِيرَة (مع السخرية؛ بطريقة متهكمة)\nمثال: تقوست شفاه لارسن السوداء من الصقيع بتهكم",
 "cynicism": "سخرية مريرة, كلبية (شعور ساخر بعدم الثقة)",
 "cynipid gall wasp": "دبور العفص (دبور منعزل صغير ينتج العفص على البلوط والنباتات الأخرى)",
 "cynipid wasp": "دبور العفص (دبور منعزل صغير ينتج العفص على البلوط والنباتات الأخرى)",
 "cynocephalus variegatus": "ليمور طائر (نوع من الليمور الطائر)",
 "cynodon dactylon": "ثيّل, عشب برمودا (عشب زاحف موطنه أوروبا وعالمي الانتشار الآن في المناطق الدافئة؛ يستخدم للمروج والمراعي خاصة في جنوب الولايات المتحدة والهند)",
 "cynodon plectostachyum": "عشب النجمة العملاق (عشب معمر يبلغ ارتفاع سيقانه 3 إلى 4 أقدام؛ يستخدم خاصة في أفريقيا والهند للمراعي والقش)",
 "cynodont": "سينودونت (زواحف صغيرة آكلة للحوم)",
 "cynodontia": "قسم كلبيات الأسنان, كلبيات الأسنان (قسم من رتبة الثيرابسيدا من العصر الترياسي يضم زواحف رباعية الأرجل آكلة للحوم صغيرة الحجم غالباً ما تكون لها أسنان تشبه أسنان الثدييات)",
 "cynoglossum amabile": "لا تنسني الصينية, لسان الكلب المحبب (عشب شرق آسيوي ثنائي الحول يزرع لزهوره الزرقاء الزاهية عادة)",
 "cynoglossum officinale": "لسان الكلب المخزني (شجيرة ثنائية الحول في أوروبا وغرب آسيا لها أوراق خشنة على شكل لسان وأزهار حمراء أرجوانية داكنة)",
 "cynoglossum virginaticum": "لسان الكلب الفرجيني (شجيرة معمرة في أمريكا الشمالية لها أوراق خشنة على شكل لسان وأزهار زرقاء شاحبة إلى أرجوانية)",
 "cynoglossum virginianum": "لسان الكلب الفرجيني (شجيرة معمرة في أمريكا الشمالية لها أوراق خشنة على شكل لسان وأزهار زرقاء شاحبة إلى أرجوانية)",
 "cynomys gunnisoni": "كلب البراري أبيض الذيل (ذيله أبيض الطرف)",
 "cynomys ludovicianus": "كلب البراري أسود الذيل (ذيله أسود الطرف)",
 "cynophobia": "رهاب الكلاب (خوف مرضي من الكلاب)",
 "cynopterus sphinx": "خفاش الفاكهة قصير الأنف (نوع من الخفافيش آكلة الفاكهة)",
 "cynoscion nebulosus": "السمكة الضعيفة المرقطة, تراوت البحر المرقط (سمكة ضعيفة في جنوب المحيط الأطلسي وسواحل الخليج في الولايات المتحدة)",
 "cynoscion regalis": "السمكة الضعيفة (سمكة طعام وصيد في المياه الساحلية لأمريكا الشمالية ذات فم تتمزق منه الخطافات بسهولة)",
 "cynosure": "قبلة الأنظار, محط الأنظار (شيء يجذب الانتباه والإعجاب بقوة) / مُرْشِد, مُوَجِّه (شيء يوفر التوجيه (كما يوجه النجم القطبي البحارة))\nمثال: إذا كان هو محط أنظار الجميع، فلم يلاحظ ذلك",
 "cynthia": "سِينْثِيَا",
 "cynthia moth": "عثة سينثيا (عثة آسيوية كبيرة أُدخلت إلى الولايات المتحدة؛ تتغذى اليرقات على شجرة السماء)",
 "cyperus": "سُعْد (سَعَدَ : بمعنى نفع يقال سعد يومنا أي نفع يومنا)",
 "cyperus alternifolius": "سعد المظلة, نبات المظلة (سعد أفريقي يُزرع على نطاق واسع كنبات مائي للزينة لعناقيده الطرفية التي تشبه المظلة من أوراق رفيعة تشبه العشب)",
 "cyperus esculentus": "حب العزيز, سعد لذيذ (سعد أوروبي له درنات صغيرة صالحة للأكل تشبه الجوز)",
 "cyperus longus": "خولنجان, سعد طويل (سعد أوروبي له أوراق خشنة الحواف وسنيبلات من زهور حمراء وجذور عطرية)",
 "cyperus papyrus": "بردي, ورق البردي (سعد طويل من وادي النيل ينتج أليافاً خدمت أغراضاً عديدة في العصور التاريخية)",
 "cyperus rotundus": "سعد الحمار, سعد مستدير (سعد معمر واسع الانتشار له درنات صغيرة صالحة للأكل تشبه الجوز)",
 "cypher": "رسالة مشفرة, شفرة (رسالة مكتوبة برمز سري) / تشفير, كتابة مشفرة (طريقة سرية للكتابة) / شخص غير مهم, لا أحد (شخص ليس له تأثير أو نفوذ) / صفر, عدم (كمية لا أهمية لها؛ شيء ليس له وجود)\nمثال: بدا وكأنه لا شيء رأيته من قبل",
 "cypraea moneta": "ودعة النقود (ودعة تستخدم صدفتها كنقود في أجزاء من جنوب المحيط الهادئ وأجزاء من أفريقيا)",
 "cypraea tigris": "ودعة النمر (ودعة تستخدم صدفتها للزينة)",
 "cypre": "دردار إسباني, كورديا (شجرة أمريكية استوائية كبيرة من جنس كورديا تزرع لزهورها البيضاء الكريمية الوفيرة وخشبها القيم)",
 "cypress": "سَرْوَة, سَرْو",
 "cypress pine": "صنوبر السرو (أي من عدة أشجار أو شجيرات دائمة الخضرة من أستراليا وشمال كاليدونيا الجديدة) / صنوبر السرو (خشب أي من عدة أشجار أو شجيرات دائمة الخضرة في أستراليا وشمال كاليدونيا الجديدة)",
 "cypress sedge": "سعد السرو (سعد متكتل من المناطق المعتدلة؛ عالمي الانتشار تقريباً)",
 "cypress spurge": "فربيون سروي (نبات معمر من العالم القديم ذو أوراق تشبه السرو؛ متوطن كعشبة ضارة في الولايات المتحدة)",
 "cypress tree": "سرو, شجرة السرو",
 "cypress vine": "أثمان ريشي, كرمة السرو (متسلق حولي أمريكي استوائي له زهور حمراء (وأحياناً بيضاء) وأوراق مقطعة بدقة؛ تم توطينه في الولايات المتحدة وأماكن أخرى)",
 "cyprian": "قُبْرُصِيّ الطَّابَع (يشبه العبادة القبرصيّة القديمة لأفروديت بطقوسها) / قبرصي (من أو متعلق بقبرص أو شعبها أو ثقافتها) / قبرصي (مواطن أو ساكن في قبرص) / بائعة هوى, عاهرة (امرأة تمارس الجماع الجنسي مقابل المال)\nمثال: مغتربون قبارصة",
 "cyprinid": "سمك شبوطي, شبوطيات (أسماك ناعمة الزعانف تعيش أساساً في المياه العذبة، تتميز عادة بفكوك عديمة الأسنان وقشور دائرية) / شبوطي (متعلق بأعضاء فصيلة الشبوطيات (من الأسماك))",
 "cyprinid fish": "سمك شبوطي, شبوطيات (أسماك ناعمة الزعانف تعيش أساساً في المياه العذبة، تتميز عادة بفكوك عديمة الأسنان وقشور دائرية)",
 "cypriniform fish": "سمك شبوطي (سمكة ناعمة الزعانف من رتبة الشبوطيات)",
 "cyprinodont": "بطحيشيات",
 "cyprinoid": "شبوطي (متعلق بأعضاء فصيلة الشبوطيات (من الأسماك))",
 "cyprinus carpio": "شبوط, مبروكة (سمكة مياه عذبة كبيرة من العالم القديم تتغذى في القاع، أُدخلت إلى أوروبا من آسيا؛ تعيش في البرك والجداول البطيئة وغالباً ما تُربى للطعام؛ أُدخلت إلى…)",
 "cypriot": "قبرصي (من أو متعلق بقبرص أو شعبها أو ثقافتها) / قبرصي (مواطن أو ساكن في قبرص)\nمثال: مغتربون قبارصة",
 "cypriot monetary unit": "وحدة نقدية قبرصية (الوحدة النقدية في قبرص)",
 "cypriot pound": "جنيه, جنيه قبرصي (وحدة المال الأساسية في قبرص؛ تساوي 100 سنت)",
 "cypriote": "قبرصي (من أو متعلق بقبرص أو شعبها أو ثقافتها) / قبرصي (مواطن أو ساكن في قبرص)\nمثال: مغتربون قبارصة",
 "cypripedia": "سيبريبيديوم (نبات أو زهرة من جنس سيبريبيديوم)",
 "cypripedium acaule": "خف السيدة الوردي, زهرة الخف (سحلب غابات وردي كان شائعاً في السابق في شرق أمريكا الشمالية)",
 "cypripedium album": "خف السيدة الملكي (سحلب بري وردي شاحب من شمال شرق أمريكا له شفة منتفخة تشبه الجراب)",
 "cypripedium arietinum": "رأس الكبش (سحلب من شمال أمريكا الشمالية له زهرة خضراء بنية وشفة حمراء وبيضاء توحي برأس كبش)",
 "cypripedium calceolus": "خف السيدة الأصفر (سحلب كستنائي إلى بني أرجواني بشفة صفراء؛ أوروبا وأمريكا الشمالية واليابان)",
 "cypripedium calceolus pubescens": "خف السيدة الأصفر الكبير (نبات من شرق ووسط أمريكا الشمالية له زهور صفراء مخضرة معلمة بالأرجواني عطرة قليلاً)",
 "cypripedium californicum": "خف السيدة الكاليفورني (غالباً ما يكون له العديد من السحلب الأصفر المخضر بجيوب بيضاء ينمو على طول الجداول والينابيع في جنوب غرب أوريغون وشمال كاليفورنيا)",
 "cypripedium fasciculatum": "خف السيدة العنقودي (عناقيد من عدة سيقان قصيرة لكل منها ورقتان عريضتان و 2-4 زهور متدلية بنية إلى مخضرة بجيوب مرقطة بالأرجواني؛ كولومبيا البريطانية إلى وسط كاليفورنيا…)",
 "cypripedium montanum": "خف السيدة الجبلي (نبات ورقي له بضعة سيقان في كتلة مع زهرة واحدة بيضاء وأرجوانية باهتة في كل إبط ورقة علوية؛ ألاسكا إلى شمال كاليفورنيا ووايومنغ)",
 "cypripedium parviflorum": "خف السيدة الأصفر (سحلب كستنائي إلى بني أرجواني بشفة صفراء؛ أوروبا وأمريكا الشمالية واليابان)",
 "cypripedium reginae": "خف السيدة الملكي (سحلب بري وردي شاحب من شمال شرق أمريكا له شفة منتفخة تشبه الجراب)",
 "cyproheptadine": "بيرياكتين, سيبروهيبتادين (مضاد للهيستامين (الاسم التجاري بيرياكتين) يستخدم لعلاج بعض تفاعلات الحساسية)",
 "cyprus": "قُبْرُص (دولة تحكمها جمهورية قبرص، وهي عضو من الاتحاد الأوروبي منذ 2004، ولكنها لا تسيطر على قبرص الشمالية منذ 1974…)\nمثال: كانت قبرص محمية بريطانية.",
 "cyrenaica": "بَرْقَة",
 "cyrenaicism": "قورينائية ((فلسفة) مذهب القورينائيين القائل بأن الناس يجب أن يهدفوا في النهاية إلى متعة اللحظة الحالية، متجاهلين الألم المستقبلي الذي قد ينتج عنها)",
 "cyril": "كِيرُلُس, كِيرِيل",
 "cyrilla": "خشب الجلد, سيريلا (شجيرة أو شجرة صغيرة من جنوب شرق الولايات المتحدة إلى جزر الهند الغربية والبرازيل؛ تزرع لعناقيدها الرفيعة من الزهور البيضاء وأوراقها البرتقالية…)",
 "cyrilla family": "سيريلية, فصيلة سيريلية (شجيرات وأشجار ذات أوراق جلدية وزهور بيضاء صغيرة في عناقيد: تشمل جنسي سيريلية وكليفتونيا)",
 "cyrilla racemiflora": "خشب الجلد, سيريلا (شجيرة أو شجرة صغيرة من جنوب شرق الولايات المتحدة إلى جزر الهند الغربية والبرازيل؛ تزرع لعناقيدها الرفيعة من الزهور البيضاء وأوراقها البرتقالية…)",
 "cyrilliaceae": "سيريلية, فصيلة سيريلية (شجيرات وأشجار ذات أوراق جلدية وزهور بيضاء صغيرة في عناقيد: تشمل جنسي سيريلية وكليفتونيا)",
 "cyrillic": "سِرِيلِيّ",
 "cyrillic alphabet": "الأبجدية السيريلية, السيريلية (أبجدية مشتقة من الأبجدية اليونانية وتُستخدم لكتابة اللغات السلافية (الروسية، البلغارية، الصربية، الأوكرانية، وبعض اللغات السلافية الأخرى))",
 "cyrtomium aculeatum": "سرخس مسنن, سرخس هولي (سرخس استوائي من العالم القديم له سعف لامع يوحي بالهولي؛ يوضع أحياناً في جنس بوليستيشوم)",
 "cyrus": "قُورَش",
 "cyst": "كِيسَة, كِيس",
 "cysteine": "سيستين",
 "cystic": "مَثَانِيّ",
 "cystic artery": "شريان كيسي, شريان مراري (فرع من الشريان الكبدي؛ يغذي المرارة وسطح الكبد)",
 "cystic breast disease": "داء الثدي الليفي الكيسي (وجود كيس واحد أو أكثر في الثدي)",
 "cystic fibrosis": "الْتَلَيُّفُ الْكِيسِيُّ",
 "cystic fibrosis transport regulator": "منظم موصلية التليف الكيسي (الجين الذي يحدث له طفرة في التليف الكيسي)",
 "cystic mastitis": "داء الثدي الليفي الكيسي (وجود كيس واحد أو أكثر في الثدي)",
 "cystic vein": "وريد مراري (وريد يصرف المرارة)",
 "cystine": "سيستين (حمض أميني بلوري يوجد في البروتينات (خاصة الكيراتين)؛ اكتشف في حصى المثانة)",
 "cystitis": "التهاب المثانة (التهاب المثانة البولية والحالبين)",
 "cystocele": "قيلة مثانية (فتق تبرز فيه المثانة البولية عبر جدار المهبل؛ يحدث أحيانًا بعد الولادة)",
 "cystoid macular edema": "وذمة بقعية كيسية (نمط محدد من التورم في الشبكية المركزية)",
 "cystolith": "حَصَاةُ المَثَانَة (حصاة تتكون في المثانة)",
 "cystoparalysis": "شلل المثانة (شلل المثانة البولية)",
 "cystophora cristata": "فقمة مقنعة (فقمة متوسطة الحجم سوداء رمادية ذات كيس كبير قابل للنفخ على الرأس؛ تعيش في مياه القطب الشمالي وشمال المحيط الأطلسي)",
 "cystoplegia": "شلل المثانة (شلل المثانة البولية)",
 "cystopteris bulbifera": "سرخس المثانة البصيلي, سرخس بصيلي (سرخس أمريكي شمالي يحمل غالباً بصيلات على الوريقات)",
 "cystopteris fragilis": "سرخس المثانة الهش, سرخس هش (سرخس رقيق واسع الانتشار في أمريكا الشمالية وأوروبا ذو سعف ريشي رقيق بسيقان هشة)",
 "cystopteris montana": "سرخس المثانة الجبلي (سرخس المناطق الجبلية الصخرية في نصف الكرة الأرضية)",
 "cytesis proliferus": "تاجاساستي, سيتيسوس (شجيرة من جزر الكناري ذات أوراق سنانية مقلوبة ذات أطراف شائكة؛ تستخدم كعلف للماشية)",
 "cytisus albus": "وزال أبيض, وزال إسباني أبيض (وزال أوروبي منخفض له أوراق ثلاثية وزهور بيضاء مصفرة)",
 "cytisus multiflorus": "وزال أبيض, وزال إسباني أبيض (وزال أوروبي منخفض له أوراق ثلاثية وزهور بيضاء مصفرة)",
 "cytisus ramentaceus": "لابورنوم دلماسي (شجيرة منتصبة ذات أوراق ثلاثية كبيرة وعناقيد كثيفة من الزهور الصفراء تليها بذور سامة؛ يوغوسلافيا؛ تصنف أحياناً في جنس السيتيسوس)",
 "cytisus scoparius": "وزال اسكتلندي, وزال شائع (وزال متساقط الأوراق قائم منتشر موطنه غرب أوروبا؛ يزرع على نطاق واسع لزهوره الصفراء الغنية)",
