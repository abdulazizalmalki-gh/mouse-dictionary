 "creative person": "فنان, مبدع (شخص يظهر عمله الإبداعي حساسية وخيالاً)",
 "creative thinker": "مفكر (مثقف هام)\nمثال: عقول القرن السابع عشر العظيمة",
 "creative thinking": "إبداع, ابتكار (القدرة على الخلق والابتكار)",
 "creatively": "بإبداع (بطريقة إبداعية)\nمثال: حلت المشكلة بإبداع",
 "creativeness": "إبداع, ابتكار (القدرة على الخلق والابتكار)",
 "creativity": "إِبْدَاع (ابْتِكَار؛ إيجاد الشيء من لا شيء)\nمثال: يحتاج اكتساب اللغة إلى الإبداع.",
 "creator": "خَالِق (الخالق : اسم من أسماء الله الحسنى ، ومعناه : الذي يُخرج من العدم إلى الوجود ، ويصنِّف المُبدَعات…؛ خَالِقُ الْكَوْنِ : مُنْشِؤُهُ ، مُكَوِّنُهُ ، اللهُ سُبْحَانَهُ) / مُبْدِع\nمثال: القرآن منزل من الخالق.",
 "creature": "مَخْلُوق, كَائِن",
 "creature comforts": "مرافق الراحة, وسائل الراحة (الأشياء التي تجعلك مرتاحاً ومطمئناً)\nمثال: كل وسائل الراحة المنزلية",
 "creche": "مأوى اللقطاء, مستشفى اللقطاء (مستشفى يتم فيه استقبال اللقطاء (الأطفال الرضع مجهولي الوالدين) ورعايتهم) / مغارة الميلاد (تمثيل لميلاد المسيح في الإسطبل في بيت لحم)",
 "cred": "شَعْبِيَّة, مِصْدَاقِيَّة الشَّارِع (المصداقية بين الشباب الحضريين العصريين)",
 "credal": "عقائدي (من أو متعلق بعقيدة)",
 "credence": "خزانة جانبية, كريدنزة (نوع من البوفيه أو الخزانة الجانبية) / تَصديق, قبول (الموقف الذهني بأن شيئاً ما قابل للتصديق ويجب قبوله كحقيقة)\nمثال: أعطى مصداقية للشائعات",
 "credendum": "بند إيمان ((المسيحية) أي من الأقسام التي ينقسم إليها قانون الإيمان أو أي بيان عقائدي آخر)",
 "credential": "اعتماد, شهادة (وثيقة تشهد بصحة وقائع معينة مذكورة)",
 "credentialled": "مُعْتَمَد مِهَنِيًّا (معتمد كمحترف بناءً على أدلّة أو شهادات)",
 "credentials": "اعتماد, شهادة (وثيقة تشهد بصحة وقائع معينة مذكورة)",
 "credenza": "خزانة جانبية, كريدنزة (نوع من البوفيه أو الخزانة الجانبية)",
 "credibility": "مِصْدَاقِيّة",
 "credible": "ذُو مِصْدَاقِيَّة, مَوْثُوق (يَبْدُو جَدِيرًا بِالتَّصْدِيقِ أَوِ القَبُول) / مصدق, معقول (يمكن تصديقه) / سَاذَج ((استخدام شائع لكنه غير دقيق حيث المقصود 'سريع التصديق') سريع التصديق)\nمثال: شهادة موثوقة تماماً",
 "credibleness": "قَابِلِيَّة التَّصْدِيق, مِصْدَاقِيَّة (صفة كون الشيء قابلاً للتصديق أو جديراً بالثقة)",
 "credibly": "بِشَكْل مَعْقُول, بِشَكْل مُقْنِع (سهل التصديق على أساس الأدلة المتاحة)\nمثال: تحدث بشكل معقول أمام اللجنة",
 "credit": "اِئْتِمَان",
 "credit account": "حساب ائتماني, حساب جاري مدين (ائتمان تمنحه شركة لعميل)",
 "credit analyst": "محلل ائتمان (محلل يدرس البيانات المالية والتاريخ المالي للمتقدمين للحصول على الائتمان لتقييم جدارتهم الائتمانية)",
 "credit application": "طَلَب ائْتِمَان (طلب للحصول على تسهيلات ائتمانية)",
 "credit balance": "رَصِيد دَائِن, رَصِيد مُوجَب (رصيد حساب تتجاوز فيه الاعتمادات (الإيداعات) الديون (المدفوعات)، ويكون البنك مديناً للعميل بالمال)",
 "credit bureau": "مكتب ائتمان (شركة خاصة تحتفظ بملفات بيانات الائتمان الاستهلاكي وتوفر معلومات ائتمانية للمستخدمين المصرح لهم مقابل رسوم)",
 "credit card": "بِطَاقَةُ اِئْتِمَان, بِطَاقَةُ تَسْلِيف",
 "credit crunch": "أزمة ائتمان, أزمة سيولة (حالة يوجد فيها نقص في النقد لإقراض الشركات والمستهلكين وتكون أسعار الفائدة مرتفعة)",
 "credit entry": "قيد دائن (قيد محاسبي يعترف بالدخل أو بنود رأس المال)",
 "credit exposure": "انكشاف ائتماني (مبلغ المال الذي أقرضه البنك وقد يخسره إذا لم يتم سداده)",
 "credit hour": "ساعة فصلية, ساعة معتمدة (وحدة للرصيد الأكاديمي؛ ساعة واحدة في الأسبوع لفصل دراسي أكاديمي)",
 "credit line": "سطر الكاتب (سطر يعطي اسم كاتب قصة أو مقال) / حد ائتماني, خط ائتمان (الحد الأقصى للائتمان المسموح به للعميل)",
 "credit order": "طلب آجل الدفع, طلب ائتماني (طلب يتم استلامه دون دفع فوري؛ يتطلب إرسال الفاتورة في وقت لاحق)",
 "credit point": "رصيد دراسي, نقطة معتمدة (نقاط تعبر عن حجم عبء العمل، تُمنح للطلاب لإكمال دورة أو ندوة أو وحدة دراسية)",
 "credit rating": "تصنيف ائتماني, جدارة ائتمانية (تقدير، بناءً على تعاملات سابقة، لقدرة شخص أو منظمة على الوفاء بالتزاماتهم المالية)",
 "credit risk": "مَخَاطِر الاِئْتِمَان",
 "credit side": "الجانب الدائن (حساب المدفوعات المستلمة؛ عادة الجانب الأيمن من البيان المالي)",
 "credit system": "نظام ائتمان (نظام يسمح للناس بشراء الأشياء بالائتمان)",
 "credit union": "اتحاد ائتماني, جمعية تعاونية للتسليف (مؤسسة مالية إيداعية تعاونية يمكن لأعضائها الحصول على قروض من مدخراتهم المشتركة)",
 "creditable": "مَقْبُول, مُشَرِّف (يَسْتَحِقُّ ثَنَاءً مَحْدُودًا فِي الغَالِبِ)",
 "creditably": "بشكل جيد, بشكل مقبول (إلى حد يستحق التقدير أو القبول)\nمثال: أبلى بلاءً حسناً بشكل مقبول بالنسبة لعمره",
 "creditor": "دَائِن",
 "credits": "تترات, قائمة العاملين (قائمة شكر لأولئك الذين ساهموا في إنشاء فيلم (تعرض عادة في نهاية الفيلم))",
 "creditworthiness": "جدارة ائتمانية, ملاءة مالية (الجدارة بالثقة المالية بناءً على التاريخ الائتماني للشخص؛ مؤهل عام للاقتراض)",
 "creditworthy": "ذُو جَدَارَة ائْتِمَانِيَّة, مَسْؤُول (له تصنيف ائتماني مقبول ومعتبر)",
 "credo": "دستور إيمان, عقيدة (أي نظام من المبادئ أو المعتقدات)",
 "credulity": "سذاجة, سرعة التصديق (الميل للتصديق بسهولة)",
 "credulous": "ساذج, سريع التصديق (يميل إلى التصديق بناءً على أدلة قليلة) / سَرِيعُ التَّصْدِيق (يُظهر نقصًا في الحُكم أو الخبرة ويُصدِّق بسهولة)\nمثال: الحيلة لن تقنع أحداً سوى الأكثر سذاجة",
 "credulously": "بِتَصْدِيق سَرِيع, بِسَذَاجَة (بطريقة ساذجة سريعة التصديق)\nمثال: تبع الأطفال المعلم بسذاجة",
 "credulousness": "انْخِدَاع, سَذَاجَة (الميل للتصديق بسهولة بالغة وبالتالي الانخداع بسهولة)",
 "cree": "كْرِي, كِرِي",
 "cree language": "لغة الكري (لغة ألغونكوية يتحدث بها شعب الكري)",
 "creed": "عَقِيدَة (المُعَاقِدَة، بمعنى اسم الفاعل؛ المعقودة، بمعنى اسم المفعول)",
 "creedal": "عقائدي (من أو متعلق بعقيدة)",
 "creek": "جدول, ساقية (مجرى مائي طبيعي أصغر من النهر (وغالباً ما يكون رافداً لنهر)) / كريك (أي فرد من اتحاد كريك (وخاصة مسكوكي) الذين عاشوا سابقاً في جورجيا وألاباما ولكن الآن بشكل رئيسي في أوكلاهوما)\nمثال: جف الجدول كل صيف",
 "creek bed": "قاع الجدول (قناة يشغلها (أو كان يشغلها) جدول مائي)",
 "creek confederacy": "كونفدرالية كريك (كونفدرالية هندية في أمريكا الشمالية نظمتها قبيلة مسكوجي وسيطرت على الجزء الجنوبي الشرقي من الولايات المتحدة قبل نقلها إلى أوكلاهوما)",
 "creel": "سلة صيد السمك (سلة خوص يستخدمها الصيادون لحفظ السمك)",
 "creep": "زحف (طريقة تنقل بطيئة على اليدين والركبتين أو بجر الجسم) / حظيرة صغار الحيوانات (حظيرة مسيجة بحيث يمكن لصغار الحيوانات دخولها ولكن لا يمكن للكبار ذلك) / زحف (حركة طولية بطيئة أو تشوه بطيء) / شخص منفر, غريب الأطوار (شخص غريب بشكل مزعج أو شاذ)\nمثال: كان الزحف هو كل ما استطاع الرجل المصاب القيام به",
 "creep feed": "علف تدريجي, علف للصغار (علف يُعطى للحيوانات الصغيرة المعزولة في منطقة خاصة)",
 "creeper": "دابة الشجر, متسلق (أي من الطيور الصغيرة المتنوعة آكلة الحشرات في نصف الكرة الشمالي التي تتسلق جذوع الأشجار مستندة على ريش ذيل صلب وأقدامها) / زَاحِف (شخص يزحف أو يدب على الأرض) / مدادة, نبات زاحف (أي نبات (مثل اللبلاب أو العناقية) ينمو عن طريق الزحف)",
 "creepiness": "إحساس دبيب, قشعريرة (إحساس غير مريح يشبه دبيب الحشرات على الجلد)",
 "creeping": "زحف (طريقة تنقل بطيئة على اليدين والركبتين أو بجر الجسم)\nمثال: كان الزحف هو كل ما استطاع الرجل المصاب القيام به",
 "creeping bellflower": "جريس زاحف (عشبة أوروبية منتصبة ذات جذور زاحفة وسنابل متدلية من الزهور الزرقاء إلى البنفسجية)",
 "creeping bent": "أغروستيس زاحف, عشبة منحنية زاحفة (عشبة مراعي أو مروج شائعة تنتشر عن طريق سيقان جارية طويلة)",
 "creeping bentgrass": "أغروستيس زاحف, عشبة منحنية زاحفة (عشبة مراعي أو مروج شائعة تنتشر عن طريق سيقان جارية طويلة)",
 "creeping bugle": "عجوقة زاحفة (نبات سجاد أوروبي منخفض جذموري له سنابل من الزهور الزرقاء؛ تم توطينه في أجزاء من الولايات المتحدة)",
 "creeping buttercup": "حوذان زاحف (عشب أوروبي معمر ذو سيقان زاحفة طويلة)",
 "creeping charlie": "جيني الزاحفة, عشبة المال (كرمة ليسيماكيا)",
 "creeping crowfoot": "حوذان زاحف (عشب أوروبي معمر ذو سيقان زاحفة طويلة)",
 "creeping fern": "سرخس زاحف, سرخس هارتفورد (سرخس رقيق في شرق الولايات المتحدة ذو ساق ملتفة وسعف عقيم مفصص راحياً وسعف خصب متشعب)",
 "creeping jenny": "جيني الزاحفة, عشبة المال (كرمة ليسيماكيا)",
 "creeping juniper": "عرعر أفقي (شجيرة منخفضة إلى منبسطة في كندا وشمال الولايات المتحدة؛ أرجوانية برونزية في الشتاء)",
 "creeping lily": "جوريوسا, زنبق المجد (أي نبات من جنس جوريوسا في أفريقيا الاستوائية وآسيا؛ عشب معمر يتسلق بواسطة محالق عند أطراف الأوراق وله أزهار مبهرجة صفراء إلى حمراء أو أرجوانية؛ جميع…)",
 "creeping oxalis": "أقصليس زاحف, حميض زاحف (عشب زاحف كثير التفرع يشكل حصيرة؛ عالمي الانتشار)",
 "creeping snowberry": "توت الثلج الزاحف (شجيرة صغيرة دائمة الخضرة بطيئة النمو منبطحة من شمال أمريكا الشمالية واليابان لها زهور بيضاء والعديد من البذور البيضاء اللحمية الخشنة والمشعرّة)",
 "creeping soft grass": "عشب ناعم زاحف (عشب أوروبي معمر بأوراق مخملية ناعمة)",
 "creeping spike rush": "أسل زاحف (سعد ذو ساق أسطوانية)",
 "creeping st john's wort": "عشبة القديس يوحنا الزاحفة (شجيرة زاحفة دائمة الخضرة ذات زهور صيفية صفراء زاهية على شكل نجمة؛ مفيدة كغطاء أرضي)",
 "creeping thistle": "شوك زاحف, شوك كندي (شوك أوروبي توطن في الولايات المتحدة وكندا حيث يعتبر عشباً ضاراً خبيثاً)",
 "creeping thyme": "زعتر بري, زعتر زاحف (شجيرة عطرية قزمة شائعة على الضفاف وسفوح التلال في أوروبا؛ تم توطينها في الولايات المتحدة)",
 "creeping willow": "صفصاف زاحف (شجيرة زاحفة صغيرة في أوروبا وآسيا ذات فروع متناثرة وأوراق خضراء حريرية، وتزرع منها عدة أصناف)",
 "creeping windmill grass": "عشبة طاحونة الهواء (عشبة أسترالية معمرة ذات سنابل طويلة عديدة مرتبة مثل ريش طاحونة الهواء)",
 "creeping wintergreen": "توت الشاي, عنب الأرض (شجيرة زاحفة من شرق أمريكا الشمالية لها زهور بيضاء جرسية الشكل تليها ثمار حمراء تشبه التوت حارة وأوراق عطرية لامعة تنتج زيت الوينترغرين)",
 "creeping wood sorrel": "أقصليس زاحف, حميض زاحف (عشب زاحف كثير التفرع يشكل حصيرة؛ عالمي الانتشار)",
 "creeping zinnia": "زينيا زاحفة, سانفيتاليا (نبات حولي ورقي منخفض التفرع له رؤوس زهرية تشبه الزينيا؛ يوجد في جنوب غرب الولايات المتحدة ومن المكسيك إلى غواتيمالا)",
 "creeps": "اشمئزاز, قشعريرة خوف (شعور بالخوف والاشمئزاز) / زحف (مرض يصيب الماشية والأغنام يُعزى إلى نقص غذائي؛ يتميز بفقر الدم ولين العظام ومشية بطيئة متيبسة)\nمثال: إنه يسبب لي القشعريرة",
 "creepy": "مخيف",
 "creepy-crawlies": "تقزز, قشعريرة (مشاعر النفور والقلق)\nمثال: أعطاني الكهف شعوراً بالتقزز",
 "creepy-crawly": "مُخِيف, مُوحِش (يسبب إحساساً بالزحف على الجلد والوحشة) / حشرة مقززة, دابة زاحفة (حيوان يزحف أو يدب (مثل الديدان أو العناكب أو الحشرات))",
 "creepypasta": "كَرِيبِيبَاسْتَا",
 "creese": "خنجر الكريس (خنجر ماليزي ذو نصل متموج)",
 "cremains": "رَمَادُ الجُثَّة (بقايا الجسد الميت بعد حرقه)",
 "cremation": "حرق الجثث (ترميد جثة الميت)",
 "cremation chamber": "محرقة الجثث (فرن حيث يمكن حرق الجثة وتحويلها إلى رماد)",
 "crematorium": "مَحْرَقَة",
 "crematory": "محرقة الجثث (فرن حيث يمكن حرق الجثة وتحويلها إلى رماد) / محرقة الجثث (مبنى جنائزي حيث يتم حرق الجثث)",
 "creme anglais": "كريم أنجليه (صلصة كاسترد بنكهة الفانيليا أو مشروب كحولي)",
 "creme brulee": "كريم بروليه (كاسترد مرشوش بالسكر ومحمر من الأعلى)",
 "creme caramel": "كريم كراميل (كاسترد مخبوز مغطى بالكراميل)",
 "creme cleanser": "منظف كريمي (منظف للبشرة يأتي في شكل سائل سميك، يشبه في قوامه المستحضر (اللوشن))\nمثال: يوصى بالمنظف الكريمي للبشرة الجافة",
 "creme de cacao": "كريمة الكاكاو (ليكير حلو منكه بالفانيليا وحبوب الكاكاو)",
 "creme de fraise": "كريمة الفراولة (ليكير بنكهة الفراولة)",
 "creme de menthe": "كريمة النعناع (ليكير حلو أخضر أو أبيض بنكهة النعناع)",
 "crenate": "مُسَنَّنٌ تَسْنِينًا دَائِرِيًّا (ذو حافة بأسنان مستديرة صَدَفِيَّة الشكل)",
 "crenate leaf": "ورقة مسننة (ورقة ذات حافة صدفيّة)",
 "crenated": "مُسَنَّنٌ تَسْنِينًا دَائِرِيًّا (ذو حافة بأسنان مستديرة صَدَفِيَّة الشكل)",
 "crenation": "حافة مسننة, كشكش (واحدة من سلسلة من النتوءات المستديرة التي تشكلها منحنيات على طول حافة)",
 "crenature": "حافة مسننة, كشكش (واحدة من سلسلة من النتوءات المستديرة التي تشكلها منحنيات على طول حافة)",
 "crenel": "شرفة الحصن, فتحة الرمي (ثلم أو مساحة مفتوحة بين شرفتين في سور بقلعة) / حافة مسننة, كشكش (واحدة من سلسلة من النتوءات المستديرة التي تشكلها منحنيات على طول حافة)",
 "crenelated": "مُسَنَّن, مُشَرَّف (له أو يشبه حزوزاً مربعة متكررة كتلك الموجودة في شرفات القلاع)",
 "crenelation": "تحصين, تشييد الشرفات (عملية بناء أسوار بفتحات لإطلاق النار أو الأسهم) / ساتر ذو فتحات, شرفة القلعة (متراس مبني حول قمة قلعة به فجوات منتظمة لإطلاق السهام أو النيران)",
 "crenellation": "تحصين, تشييد الشرفات (عملية بناء أسوار بفتحات لإطلاق النار أو الأسهم) / ساتر ذو فتحات, شرفة القلعة (متراس مبني حول قمة قلعة به فجوات منتظمة لإطلاق السهام أو النيران)",
 "crenelle": "شرفة الحصن, فتحة الرمي (ثلم أو مساحة مفتوحة بين شرفتين في سور بقلعة) / حافة مسننة, كشكش (واحدة من سلسلة من النتوءات المستديرة التي تشكلها منحنيات على طول حافة)",
 "crenulate": "دَقِيقُ التَّسَنُّن (ذو حافة بأسنان صغيرة مستديرة)",
 "crenulated": "دَقِيقُ التَّسَنُّن (ذو حافة بأسنان صغيرة مستديرة)",
 "creole": "كريولي (من أو متعلق أو مميز للأشخاص المولودين محلياً من أصل فرنسي في لويزيانا) / كريولي (من أو متعلق بلغة تنشأ من الاتصال بين لغتين أخريين ولها ميزات كليهما) / كريول, لغة مولدة (لغة أم تنشأ عن الاتصال بين لغتين) / كريول (شخص ينحدر من أجداد فرنسيين في جنوب الولايات المتحدة (وخاصة لويزيانا))\nمثال: الطبخ الكريولي",
 "creole-fish": "سمكة الكريول (سمكة أعماق في المحيط الأطلسي الاستوائي)",
 "creosol": "كريوزول (سائل عطري عديم اللون إلى أصفر وهو أحد مكونات الكريوسوت)",
 "creosote": "الكريوسوت, زيت القطران (سائل زيتي داكن يتم الحصول عليه عن طريق تقطير قطران الفحم؛ يستخدم كمادة حافظة للخشب) / الكريوسوت (سائل زيتي عديم اللون أو مصفر يتم الحصول عليه عن طريق تقطير قطران الخشب؛ يستخدم كمطهر)",
 "creosote bush": "حشيشة الشحم",
 "crepe": "كريب (قماش خفيف ناعم ورقيق ذو سطح مجعد) / فطيرة فرنسية رقيقة, كريب (فطيرة صغيرة رقيقة جداً) / ورق كريب, ورق مكشكش (ورق ذو ملمس مجعد؛ عادة ما يكون ملوناً ويستخدم للزينة)",
 "crepe de chine": "كريب صيني (كريب رقيق جداً من الحرير أو قماش يشبه الحرير)",
 "crepe fern": "توديا, سرخس الملك (سرخس الغابات المطيرة في أستراليا الاستوائية ونيوزيلندا وجنوب إفريقيا)",
 "crepe flower": "تمرحنة, وردية الكريب (شجيرة زينة من شرق الهند تزرع بكثرة في جنوب الولايات المتحدة)",
 "crepe gardenia": "تفاحة آدم, زهرة الطاحونة (شجيرة استوائية ذات أوراق لامعة وأزهار ليلية عطرة ذات تيجان مجعدة أو متموجة؛ من شمال الهند إلى تايلاند)",
 "crepe jasmine": "تفاحة آدم, زهرة الطاحونة (شجيرة استوائية ذات أوراق لامعة وأزهار ليلية عطرة ذات تيجان مجعدة أو متموجة؛ من شمال الهند إلى تايلاند)",
 "crepe marocain": "كريب مغربي (كريب فساتين؛ يشبه كريب كانتون)",
 "crepe myrtle": "تمرحنة, وردية الكريب (شجيرة زينة من شرق الهند تزرع بكثرة في جنوب الولايات المتحدة)",
 "crepe paper": "ورق كريب, ورق مكشكش (ورق ذو ملمس مجعد؛ عادة ما يكون ملوناً ويستخدم للزينة)",
 "crepe rubber": "مطاط كريب (مطاط طبيعي خام؛ يستخدم بشكل رئيسي لنعال الأحذية)",
 "crepe suzette": "كريب سوزيت (كريب مشتعل في صلصة لكيور بنكهة البرتقال والليمون الحلوة)",
 "crepitation": "طقطقة, فرقعة (الصوت الحاد لأصوات الانكسار)",
 "crepitation rale": "خرخرة (صوت الطقطقة المسموع عند التسمع عندما يستنشق مرضى الجهاز التنفسي؛ يرتبط بالسل والالتهاب الرئوي وفشل القلب الاحتقاني)",
 "crepuscle": "أصيل, شفق (الوقت من اليوم الذي يلي غروب الشمس مباشرة)\nمثال: كان يحب الشفق",
 "crepuscular": "شَفَقِيّ, غَسَقِيّ (كَالشَّفَق؛ خَافِت الإِضَاءَة)",
 "crepuscule": "أصيل, شفق (الوقت من اليوم الذي يلي غروب الشمس مباشرة)\nمثال: كان يحب الشفق",
 "crescendo": "كْرِيشِنْدُو ((في الموسيقى) يتصاعد تدريجيًّا في شدّة الصوت) / تصعيد, كريشيندو ((موسيقى) زيادة تدريجية في الجهارة)",
 "crescent": "هِلَال",
 "crescent moon": "هِلَال",
 "crescent roll": "كرواسون, لفافة هلالية (لفافة غنية جداً ومورقة على شكل هلال)",
 "crescent wrench": "مفتاح فرنسي, مفتاح هلالي (مفتاح ربط قابل للتعديل مصمم ليتناسب مع الصواميل السداسية مع مسمار التعديل المدمج في رأس المفتاح)",
 "crescent-cell anaemia": "الأنيميا المنجلية, فقر الدم المنجلي (شكل خلقي من فقر الدم يحدث غالبًا لدى ذوي البشرة السمراء؛ ويتميز بخلايا دم غير طبيعية ذات شكل هلالي)",
 "crescent-cell anemia": "الأنيميا المنجلية, فقر الدم المنجلي (شكل خلقي من فقر الدم يحدث غالبًا لدى ذوي البشرة السمراء؛ ويتميز بخلايا دم غير طبيعية ذات شكل هلالي)",
 "crescent-shaped": "هِلَالِيُّ الشَّكْلِ, هِلَالِيّ (ذو شكل يشبه الهلال)",
 "crescentia cujete": "شجرة القرع, كاليلاش (شجرة أمريكية استوائية دائمة الخضرة تنتج قرعاً مستديراً كبيراً)",
 "cresol": "كريسول (أي من ثلاثة فينولات متصاوغة سامة عديمة اللون؛ مشتقة من الفحم أو قطران الخشب؛ تستخدم كمطهر)",
 "cress": "حُرْف, رَشَاد (طَرَف وَجَانِب وَحَدّ؛ رَمْز مخطوط أو مطبوع يقوم مقام صوت أو كلمة أو عبارة أو معنى)\nمثال: ألف هو الحرف الأول للألف باء.",
 "cress green": "أَخْضَر جِرْجِيرِيّ (بلون أخضر مصفر معتدل أغمق من أخضر الطحلب وأدكن من أخضر البازلاء)",
 "cress plant": "رشاد, نبات الرشاد (أي من النباتات المختلفة من العائلة الصليبية ذات أوراق صالحة للأكل لها طعم لاذع)",
 "cresson": "أَخْضَر جِرْجِيرِيّ (بلون أخضر مصفر معتدل أغمق من أخضر الطحلب وأدكن من أخضر البازلاء)",
 "crest": "عرف (نمو لافت للنظر من الريش أو الجلد على رأس طائر أو حيوان آخر) / عرف الخوذة ((شعارات النبالة) في العصور الوسطى، شعار يستخدم لتزيين الخوذة) / تحدب الطريق, ظهر الطريق (منتصف طريق محدب) / ذروة, قمة (الخط العلوي لتل أو جبل أو موجة)",
 "crested": "ذُو عُرْف, مُزَيَّن بِرِيشَة ((لخوذة الفارس) ذو ريشة زخرفية) / ذُو قُنْزُعَة, مُتَوَّج ((لطائر أو حيوان) له خصلة أو نتوء زخرفي على الرأس) / ذُو شِعَار (يحمل رمزاً أو شعاراً من شعارات النبالة)",
 "crested cariama": "كارياما متوجة",
 "crested coral root": "جذر المرجان المتوج (أوركيد بزهور بنية مصفرة بعروق داكنة؛ جنوب شرق أريزونا إلى شرق الولايات المتحدة)",
 "crested myna": "مينة متوجة (طائر متوج بني داكن من جنوب شرق آسيا)",
 "crested penguin": "بطريق متوج, بطريق نطاط الصخور (بطريق صغير من جزر فوكلاند ونيوزيلندا)",
 "crested screamer": "صياح ذو عرف (يتميز عن الصياح المقرن بوجود عرف ريشي على مؤخرة الرأس)",
 "crested swift": "سمامة الشجر (طيور من جنوب شرق آسيا وجزر الهند الشرقية تختلف عن السمامات الحقيقية في وجود أعراف منتصبة والتعشيش في الأشجار)",
 "crested wheat grass": "عشبة القمح العرفية (عشبة أوراسية تزرع في منطقة السهول الكبرى بالولايات المتحدة للعلف ومكافحة التعرية)",
 "crested wheatgrass": "عشبة القمح العرفية (عشبة أوراسية تزرع في منطقة السهول الكبرى بالولايات المتحدة للعلف ومكافحة التعرية)",
 "crestfallen": "خَائِبُ الأَمَل, مُنْكَسِر (مُنْخَفِضُ الرُّوحِ المَعْنَوِيَّة؛ مَكْسُورُ الخَاطِر)",
