 "defilade": "ساتر دفاعي (ترتيب التحصينات الدفاعية للحماية من نيران العدو)",
 "defile": "مضيق, ممر ضيق (ممر ضيق (خاصة بين الجبال))",
 "defiled": "مُدَنَّس, مُلَوَّث (مُشَوَّه أخلاقيًّا؛ ملطّخ أو فاسد)",
 "defilement": "تلوث, تنجيس (حالة كونه ملوثاً)",
 "defiler": "ملوث (شخص أو منظمة تتسبب في تلوث البيئة)",
 "definability": "قَابِلِيَّة التَّعْرِيف (صفة أو حالة القدرة على التحديد أو الحصر أو التفسير)",
 "definable": "قَابِلٌ لِلتَّعْرِيف (يُمْكِنُ تَعْرِيفُهُ أَوْ تَحْدِيدُهُ أَوْ شَرْحُه)",
 "defined": "محدد, معرف (يتميز أو محدد بوضوح) / مُحَدَّد المَعَالِم (يُظْهِر بِوُضُوح الخُطُوط الخَارِجِيَّة أَوِ الحُدُود)\nمثال: ضائع في متاهة من الكلمات المعرفة وغير المعرفة",
 "defining": "تحديد, تشكيل (أي عملية تخدم تحديد شكل شيء ما)",
 "definite": "مَعْرِفَة (مصدر من الفعل عَرَفَ؛ ضد الجهل؛ إدراك الشيء بحقيقته والوعي، ضد الجهل بالشيء)\nمثال: نريد معرفة السبب.",
 "definite article": "أَدَاةُ تَعْرِيف, أَدَاةُ مَعْرِفَة",
 "definite integral": "تكامل محدود (تكامل دالة على فترة محددة)",
 "definite quantity": "كَمِّيَّة مُحَدَّدَة (مقدار معيَّن ومحدَّد من شيء)",
 "definitely": "بالتأكيد, بشكل قاطع (بدون شك وخارج نطاق الشك)\nمثال: كان باهظ الثمن بلا شك",
 "definiteness": "تَحْدِيد, قَطْعِيَّة (صفة القابلية للتنبؤ بثقة كبيرة)",
 "definition": "تَعْرِيف (الإعلام؛ الشيء أو الكلمة: التوضيح بالمعنى بصورة مختصرة ليعرف الناس ما هي)\nمثال: هل لديه بطاقة شخصية (هوية شخصية - بطاقة تعريف)",
 "definitive": "حَاسِم, نِهَائِيّ (يُقَدِّمُ تَسْوِيَةً نِهَائِيَّةً أَوْ قَاطِعَةً) / قَاطِع, لَا لَبْس فِيه (مُحَدَّد أو مُصَاغ بوضوح تام) / حُجَّة, مَوْثُوق (ذو سلطة أو تميّز معترف بهما)",
 "definitive host": "عائل نهائي (العائل الذي يحدث فيه التكاثر الجنسي للطفيلي)",
 "definitors": "مجلس استشاري رهباني, مستشارون (مجلس في نظام ديني يقدم المشورة والمساعدة للرؤساء العامين والإقليميين في نظامهم)",
 "deflagration": "اشتعال سريع, تفرقع (احتراق ينتشر عبر غاز أو على سطح مادة متفجرة بمعدل سريع مدفوعاً بنقل الحرارة)",
 "deflate": "انْكَمَش",
 "deflated": "خَائِبُ الأَمَل, مُنْكَسِر (مُنْخَفِضُ الرُّوحِ المَعْنَوِيَّة؛ مَكْسُورُ الخَاطِر)",
 "deflation": "انْكِماش (ثَوْبٌ سَرِيعُ الانْكِمَاشِ : سَرِيعُ الالْتِوَاءِ؛ اِنْكِمَاشُ مَخَالِبِ الأسَدِ : دُخولُها)",
 "deflationary": "انكماشي (مرتبط بـ أو يميل إلى التسبب في انخفاض في أسعار المستهلك أو زيادة في القوة الشرائية للنقود)\nمثال: تدابير انكماشية",
 "deflationary spiral": "دوامة انكماشية (فترة من الانكماش تنخفض فيها الأسعار والأجور بمعدل متزايد وتكتسب العملة قيمة)",
 "deflator": "مُخَفِّض, مُعَامِل خَفْض (عامل إحصائي مصمم لإزالة أثر التضخم؛ المتغيرات المعدلة حسب التضخم تكون بالدولار الثابت)",
 "deflection": "انحراف, تحويل (التحول جانباً (عن مسارك أو انتباهك أو اهتمامك)) / انحراف, انحناء (خاصية الانحناء أو الانحراف) / انحراف (حركة مؤشر أو قلم أداة قياس من موضع الصفر الخاص به) / انحراف, انكسار (المقدار الذي تنحني به موجة منتشرة)\nمثال: تحويل عن الطريق السريع الرئيسي",
 "deflective": "حَارِف, كَاسِر (قادر على تغيير اتجاه الموجة الضوئية أو الصوتية)",
 "deflector": "حارف, عاكس (جهاز يهدف إلى تحويل مسار تدفق شيء ما (مثل الماء أو الهواء أو الدخان))",
 "deflexion": "انحراف, تحويل (التحول جانباً (عن مسارك أو انتباهك أو اهتمامك)) / انحراف, انحناء (خاصية الانحناء أو الانحراف) / انحراف (حركة مؤشر أو قلم أداة قياس من موضع الصفر الخاص به) / انحراف, انكسار (المقدار الذي تنحني به موجة منتشرة)\nمثال: تحويل عن الطريق السريع الرئيسي",
 "defloration": "تَصَرُّف",
 "deflower": "اِفْتَضَّ, تَصَرُّف",
 "defoliant": "مزيل الأوراق, مسقط الأوراق (مادة كيميائية تُرش على النباتات وتتسبب في تساقط أوراقها)",
 "defoliate": "مُجَرَّد مِنَ الأَوْرَاق (أُزيلت أوراقه أو جُرِّد منها)",
 "defoliated": "مُجَرَّد مِنَ الأَوْرَاق (أُزيلت أوراقه أو جُرِّد منها)",
 "defoliation": "إسقاط الورق, تعرية الأشجار (التسبب في تساقط أوراق الأشجار والنباتات الأخرى (عن طريق استخدام مواد كيميائية مثلاً)) / إزالة الأوراق, تساقط الأوراق (فقدان أوراق الشجر)",
 "defoliator": "آكل الأوراق (حشرة تجرد النباتات من أوراقها)",
 "deforestation": "إزالة الأشجار, إزالة الغابات (إزالة الأشجار) / إزالة الغابات (حالة خلو المكان من الأشجار)",
 "deformation": "التواء, تشويه (عملية لي أو تشويه شكل شيء ما (مثل الجسم)) / تشوه, تغير الشكل (تغير في شكل أو أبعاد جسم نتيجة تطبيق الإجهاد عليه) / تحريف, تشويه (تغيير للأسوأ)",
 "deformational": "تشويهي (يتعلق بتغيير الشكل أو الحجم لجسم مادي أو شكل هندسي أو يسببه)",
 "deformed": "مَعِيب الشَّكْل, مُشَوَّه (سيّئ التكوين إلى حدّ القبح)",
 "deformity": "تَشَوُّه شَكْلِيّ",
 "defrauder": "محتال, نصاب (شخص يحتال عليك عن طريق الخداع أو الغش)",
 "defrayal": "دفع, سداد (عملية دفع المال)",
 "defrayment": "دفع, سداد (عملية دفع المال)",
 "defroster": "مذيب الجليد, مزيل الصقيع (سخان يزيل الجليد أو الصقيع (كما هو الحال من الزجاج الأمامي أو الثلاجة أو أجنحة الطائرة))",
 "deft": "خَفِيف اليَد, رَشِيق (ماهر في الحركات الجسدية وخاصة حركات اليدين)",
 "deftly": "بِبَرَاعَة, بِخِفَّة يَد (بطريقة بارعة) / بِبَرَاعَة, بِحِذْق (ببراعة؛ بطريقة بارعة)\nمثال: أزالت لويس وشاحها ببراعة",
 "deftness": "براعة, حذق (أداء ماهر أو قدرة دون صعوبة)\nمثال: براعته السريعة كانت نتاج تصميم جيد",
 "defunct": "بَائِد, مُنْقَرِض (توقف عن الوجود أو الحياة) / بَائِد, مُنْقَرِض (لم يعد سارياً أو مستخدَماً؛ غير نشط)",
 "defunctness": "انقراض, زوال (لم يعد موجوداً)\nمثال: انقراض نوع حيواني",
 "defusal": "إبطال مفعول / تهدئة, خفض التصعيد",
 "defusing": "إبطال مفعول, تعطيل (فعل التعطيل أو جعل الشيء غير فعال (مثل القنبلة))",
 "degage": "غَيْرُ مُنْخَرِطٍ, مُنْفَصِلٌ عَاطِفِيًّا (يُظْهِرُ عَدَمَ انْخِرَاطٍ عَاطِفِيٍّ) / طَلِيق, مُنْبَسِط (حُرٌّ وَمُسْتَرْخٍ فِي السُّلُوك)",
 "degaussing": "إبطال المغناطيسية (عملية جعل هيكل السفينة (الفولاذي) غير مغناطيسي من خلال إنتاج مجال مغناطيسي معاكس)",
 "degeneracy": "انحطاط أخلاقي, انحلال (انحراف أخلاقي؛ إفساد للفضيلة والمبادئ الأخلاقية) / انحلال, تدهور (حالة كونه منحطاً في الصفات العقلية أو الأخلاقية)\nمثال: الرفاهية والفساد بين الطبقات العليا",
 "degenerate": "فَاسِق, مُسْتَهْتِر (مُتَحَرِّرٌ مِنَ القُيُودِ الأَخْلَاقِيَّةِ وَالأَعْرَاف) / منحرف (شخص ينحرف سلوكه عما هو مقبول خاصة في السلوك الجنسي)",
 "degeneration": "انتكاس, تدهور (الانتقال من شكل بيولوجي أكثر تعقيداً إلى شكل أبسط) / انحطاط, تدهور (عملية التراجع من مستوى أعلى إلى مستوى أدنى من القوة الفعالة أو الحيوية أو الجودة الأساسية) / انحلال, تدهور (حالة كونه منحطاً في الصفات العقلية أو الأخلاقية)",
 "degenerative": "تَنَكُّسِيّ ((عن المرض) يتّسم بتدهور تدريجيّ في الأعضاء والخلايا مع فقدان الوظيفة)",
 "degenerative arthritis": "التهاب المفاصل التنكسي, التهاب المفاصل العظمي (انهيار مزمن للغضروف في المفاصل؛ الشكل الأكثر شيوعًا لالتهاب المفاصل الذي يحدث عادة بعد منتصف العمر)",
 "degenerative disorder": "اضطراب تنكسي, مرض انحلالي (حالة تؤدي إلى فقدان تدريجي للوظيفة)",
 "degenerative joint disease": "التهاب المفاصل التنكسي, التهاب المفاصل العظمي (انهيار مزمن للغضروف في المفاصل؛ الشكل الأكثر شيوعًا لالتهاب المفاصل الذي يحدث عادة بعد منتصف العمر)",
 "deglutition": "بلع, شرب (فعل البلع)\nمثال: كانت بلعة واحدة من السائل كافية",
 "degradation": "انحطاط, تحقير (التغيير إلى حالة أدنى (حالة أقل احتراماً)) / اتضاع, انحطاط (حالة متدنية أو منكسرة)\nمثال: كل اعتراف جلبها إلى حالة من الانحطاط",
 "degrade": "تَرَدَّى",
 "degraded": "مُتَدَنٍّ, مُنْخَفِض القِيمَة (تراجعت قيمته؛ انخفض سعره أو مكانته) / فَاسِق, مُسْتَهْتِر (مُتَحَرِّرٌ مِنَ القُيُودِ الأَخْلَاقِيَّةِ وَالأَعْرَاف)",
 "degrader": "حَاطّ مِنْ الْقَدْر, مُخْفِض لِلْقِيمَة (شخص يخفض من الجودة أو الطابع أو القيمة (مثل إضافة معدن أرخص للعملات))",
 "degrading": "مُذِلّ, مُهِين (يتَّسم بالإهانة وانعدام الشرف في السلوك) / مُحِطّ, مُفْسِد (ضارّ بالعقل أو الأخلاق)",
 "degras": "دجراس (مستحلب شبه صلب ينتج عن معالجة بعض الجلود بزيت السمك المؤكسد، مما يستخلص الألبومينويدات القابلة للذوبان)",
