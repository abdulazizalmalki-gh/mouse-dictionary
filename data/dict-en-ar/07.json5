 "deliberateness": "تداول, تريث (سمة التفكير المتأني في العمل أو القرار) / بطء, تأنٍ (معدل يظهر غياب العجلة أو التسرع)\nمثال: كان رجلاً ذا تداول قضائي",
 "deliberation": "تداول, تريث (سمة التفكير المتأني في العمل أو القرار) / بطء, تأنٍ (معدل يظهر غياب العجلة أو التسرع) / تداول, روية (تفكير متأنٍ وحذر) / تعمد, حساب (تخطيط شيء ما بعناية وعن قصد)\nمثال: كان رجلاً ذا تداول قضائي",
 "deliberative": "تَدَاوُلِيّ (يَتَضَمَّنُ أَوْ يَتَّسِمُ بِالمُدَاوَلَةِ وَالنِّقَاشِ وَالفَحْص)",
 "deliberative assembly": "جمعية تداولية (تجمع من الناس لغرض النظر والمناقشة المتأنية)",
 "delible": "قَابِلٌ لِلْحَذْف, قَابِلٌ لِلْمَحْو (يمكن حذفه أو محوه)",
 "delicacy": "خفة, رشاقة (خفة في الحركة أو الأسلوب) / دَمَاثَة, رِقَّة (صفة الجمال والرقة في المظهر) / حذاقة, دبلوماسية (التعامل بمهارة ودقة مع المواقف) / رقة, هشاشة (نقص القوة البدنية)\nمثال: رقة لمستها",
 "delicate": "دقيق, رقيق (ناعم ولطيف وممتع بشكل رائع؛ عرضة للتلف) / رَقِيق, سَهْلُ الكَسْر (يَسْهُلُ كَسْرُهُ أَوْ إِتْلَافُهُ أَوْ تَدْمِيرُهُ) / حَسَّاس, دَقِيق (صَعْب المُعَالَجَة؛ يَسْتَلْزِم لَبَاقَةً كَبِيرَة) / دَقِيقٌ, رَقِيقٌ (بالغ الدقة والرهافة في التطوير)\nمثال: مقطع كمان رقيق",
 "delicately": "بدقة, برقة (بطريقة دقيقة)\nمثال: ملامح مشكلة بدقة",
 "delicatessen": "ديلي, مطعم مأكولات جاهزة (متجر يبيع منتجات غذائية جاهزة للأكل) / أطعمة معلبة جاهزة, ديليكاتيسن (منتجات غذائية جاهزة للأكل)",
 "delicatessen food": "أطعمة معلبة جاهزة, ديليكاتيسن (منتجات غذائية جاهزة للأكل)",
 "delichon urbica": "سنونو المنازل (سنونو أوروبي صغير شائع يبني أعشاشاً تحت أفاريز المنازل)",
 "delicious": "لَذِيذ / شَهِيّ",
 "deliciously": "بِشَكْل مُبْهِج, بِلَذَّة (بطريقة ممتعة للغاية) / بشكل شهي, بلذة (بطريقة تنتج طعماً لذيذاً)\nمثال: كانا يمشيان على الشاطئ ببطء ومتعة",
 "deliciousness": "لَذَّة",
 "delight": "فُرْجَة",
 "delighted": "مَسْرُور (كلُّ من يشعر بالسُّرُور)\nمثال: أما مسرور برؤيتك.",
 "delightedly": "بِابْتِهَاج, بِسُرُور (مع السرور)\nمثال: قبلت الدعوة بسرور",
 "delightful": "بَهِيج",
 "delightfully": "بِشَكْل رَائِع, بِشَكْل مُبْهِج (بطريقة مبهجة)\nمثال: المزرعة، وإن كانت صغيرة في حد ذاتها، تقع بشكل مبهج",
 "delilah": "فاتنة, مغوية (امرأة تعتبر مغرية بشكل خطير)",
 "delimber": "آلة إزالة الفروع (آلة لإزالة الفروع من الأشجار بمنشار أو سلاسل ضاربة)",
 "delimitation": "حد فاصل, خط الحدود (خط يشير إلى الحدود)",
 "delimited": "مَحْدُود, مُحَدَّد المَعَالِم (تَمَّ تَعْيِينُ حُدُودِهِ أَوْ مَعَالِمِهِ)",
 "delineate": "محدد, ممثل (تم تمثيله بدقة أو تحديده)",
 "delineated": "محدد, ممثل (تم تمثيله بدقة أو تحديده)",
 "delineation": "تصوير, رسم (التمثيل عن طريق الرسم أو التلوين وما إلى ذلك) / تخطيط, رسم خطي (رسم لخطوط خارجية لأشكال أو أشياء) / تشخيص, تصوير (وصف لفظي بياني أو حيوي)\nمثال: في كثير من الأحيان كانت الرواية تُقاطع بصور لفظية طويلة",
 "delineative": "تَصْوِيرِيّ, تَوْضِيحِيّ (مُصَوَّر بطريقة يمكن التعرف عليها)",
 "delinquency": "انحراف الأحداث, جنوح (سلوك معاد للمجتمع ينتهك القانون يرتكبه قاصر) / إهمال, جنوح (الميل للإهمال وعدم الاكتراث) / تأخر في السداد, جنحة مالية (عدم سداد دين عند استحقاقه)\nمثال: ورث جنوحه عن أبيه",
 "delinquent": "مُتَأَخِّر, مُنْقَضِي الأَجَل (تجاوز موعد استحقاقه ولم يُسدَّد في الوقت المحدّد) / مُقَصِّر, مُهْمِل (يُخِلّ بِمَا يَقْتَضِيه الوَاجِب) / جَانِح, مُخَالِف (مذنب بارتكاب مخالفة أو جُنحة) / جانح, حدث جانح (مذنب شاب)",
 "deliquescent": "ذَائِب, مُسْتَرْطِب ((خاصةً بعض الأملاح) يتحول إلى سائل بامتصاص الرطوبة من الهواء)",
 "deliquium": "إغماء, غشيان (فقدان تلقائي للوعي ناجم عن عدم كفاية الدم في الدماغ)",
 "delirious": "مَجْنُون, مَحْمُوم (يَتَّسِمُ بِالإِثَارَةِ أَوِ الانْفِعَالِ غَيْرِ المُسَيْطَرِ عَلَيْه) / مُهَلْوِس, هَاذٍ (يعاني من الهذيان والهلوسة)",
 "deliriously": "بِحُمَّى, بِهَذَيَان (كما لو كان في هذيان) / بِشَكْل جُنُونِيّ, بِغَامِر (بطريقة هاذية)\nمثال: كان يتحدث بهذيان",
 "delirium": "هَذَيَان",
 "delirium tremens": "هذيان ارتعاشي (هذيان حاد ناجم عن التسمم الكحولي)",
 "deliver": "نَقَلَ",
 "deliverable": "جاهز للتسليم, قابل للتسليم (مناسب أو جاهز للتسليم) / تسليمات, مُخرَج (شيء يمكن تقديمه كمنتج لعملية التطوير)\nمثال: بموجب هذا العقد تشمل التسليمات كلاً من البرامج والأجهزة",
 "deliverance": "إنقاذ, تخليص (الاستعادة أو الحفظ من الضياع أو الخطر)\nمثال: وظيفة الجراح هي إنقاذ الأرواح",
 "deliverer": "مُسَلِّم, مُوَصِّل (شخص يسلم أو ينقل أموالاً أو بضائع) / عامل توصيل, موصل طلبات (شخص يعمل لتوصيل الطلبات) / مُخَلِّص, مُنقِذ (شخص ينقذك من الأذى أو الخطر)",
 "delivery": "تَوْصِيل, تَسْلِيم / مَخَاض, وَضْع / إِلْقَاء (إِلْقَاءُ الشَّبَكَةِ فِي البَحْرِ : رَمْيُها؛ إِلْقاءُ مُحَاضَرَةٍ : إعْطَاؤُهُا، أَي الحَدِيثُ فِي مَوْضُوعٍ أَمَامَ جَمْهُورٍ)\nمثال: مروا بسرعة و بدون إلقاء نظرة.",
 "delivery boy": "عامل توصيل, موصل طلبات (شخص يعمل لتوصيل الطلبات)",
 "delivery truck": "شاحنة توصيل (شاحنة مغلقة مناسبة لتسليم البضائع أو الخدمات للعملاء)",
 "delivery van": "شاحنة توصيل (شاحنة مغلقة مناسبة لتسليم البضائع أو الخدمات للعملاء)",
 "deliveryman": "عامل توصيل (رجل موظف للقيام بالتوصيل)",
 "deliverywoman": "عاملة توصيل (امرأة موظفة للقيام بالتوصيل)",
 "dell": "وادٍ صغير مشجر, وهدة (منخفض صغير مشجر)",
 "delmonico steak": "شريحة دلمونيكو, كلوب ستيك (شريحة لحم صغيرة من مقدمة الخاصرة القصيرة للبقر)",
 "delonix regia": "بوانسيانا ملكية, زهرة الطاووس (شجرة استوائية مبهرجة أو شجيرة موطنها مدغشقر؛ تزرع على نطاق واسع في المناطق الاستوائية لعناقيدها الضخمة من الزهور القرمزية والبرتقالية؛ تصنف أحياناً…)",
 "delphian": "دلفي (من أو متعلق بدلفي أو بكهنة أبولو في دلفي)\nمثال: عرافة دلفي",
 "delphic": "غَامِض النُّبُوءَة, كَهَانِيّ (نبوئيّ بشكل غامض ومبهم) / دلفي (من أو متعلق بدلفي أو بكهنة أبولو في دلفي)\nمثال: عرافة دلفي",
 "delphinapterus leucas": "بيلوغا, حوت أبيض (حوت شمالي صغير يكون لونه أبيض عند البلوغ)",
 "delphinium": "دلفينيوم, عايق (أي نبات من جنس دلفينيوم له أوراق مقسمة كفياً وسنابل بارزة من الزهور ذات مهماز بألوان مختلفة؛ يحتوي بعضها على مواد سامة للغاية)",
 "delphinium ajacis": "عايق الحقل, عايق الصواريخ (عايق يزرع عادة في جنوب أوروبا له عناقيد غير متفرعة تشبه السنابل من الزهور الزرقاء أو الأرجوانية أو الوردية أحياناً؛ يوضع أحياناً في جنس دلفينيوم)",
 "delphinus delphis": "دلفين شائع (دلفين أسود وأبيض يقفز عالياً خارج الماء)",
 "delta": "دِلْتَا (مثلث كحرف الدال اليوناني)",
 "delta hepatitis": "التهاب الكبد دال (شكل حاد من التهاب الكبد)",
 "delta iron": "حديد دلتا (تآصل للحديد مستقر بين 1403 درجة مئوية ونقطة الانصهار)",
 "delta ray": "شُعَاع دِلْتَا (إلكترون مقذوف من المادة بواسطة الإشعاع المؤين)",
 "delta rhythm": "إيقاع دلتا, موجة دلتا (الموجة الدماغية الطبيعية في مخطط الدماغ لشخص في نوم عميق خالٍ من الأحلام؛ تحدث بجهد مرتفع وتردد منخفض (1 إلى 4 هرتز))",
 "delta wave": "إيقاع دلتا, موجة دلتا (الموجة الدماغية الطبيعية في مخطط الدماغ لشخص في نوم عميق خالٍ من الأحلام؛ تحدث بجهد مرتفع وتردد منخفض (1 إلى 4 هرتز))",
 "delta wing": "جناح دلتا, طائرة بجناح دلتا (طائرة ذات أجنحة تمنحها مظهر مثلث متساوي الساقين)",
 "deltasone": "بريدنيزون, دلتاسون (نظير منزوع الهيدروجين للكورتيزول (الأسماء التجارية دلتاسون وغيرها)؛ يستخدم كدواء مضاد للالتهابات في علاج التهاب المفاصل وكمثبط للمناعة)",
 "deltoid": "دَالِيّ الشَّكْل, مُثَلَّثِيّ (مُثلَّث أو يُوحي بشكل مُثلَّث مع نقطة في القمّة) / عضلة دالية (عضلة مثلثة كبيرة تغطي مفصل الكتف وتعمل على إبعاد وثني ومد وتدوير الذراع)",
 "deltoid eminence": "أحدوبة دالية (نتوء على الجزء الخارجي من عظم العضد حيث تتصل العضلة الدالية)",
 "deltoid leaf": "ورقة مثلثية (ورقة بسيطة على شكل دلتا)",
 "deltoid muscle": "عضلة دالية (عضلة مثلثة كبيرة تغطي مفصل الكتف وتعمل على إبعاد وثني ومد وتدوير الذراع)",
 "deltoid tuberosity": "أحدوبة دالية (نتوء على الجزء الخارجي من عظم العضد حيث تتصل العضلة الدالية)",
 "deluge": "طُوفَان (عاصفة)",
 "delusion": "خِدَاع, ضَلَالَة / غَرُور",
 "delusion of grandeur": "جُنُون العَظْمَة",
 "delusional": "تَوَهُّمِيّ, ضَلَالِيّ (يعاني من الأوهام أو يتسم بها)",
 "delusional disorder": "اضطراب وهامي (أي اضطراب عقلي تلعب فيه الأوهام دوراً مهماً)",
 "delusions of grandeur": "أوهام العظمة, جنون العظمة (وهم (شائع في البارانويا) بأنك أعظم وأقوى وأكثر نفوذاً مما أنت عليه في الواقع)",
 "delusions of persecution": "أوهام الاضطهاد, عقدة الاضطهاد (وهم (شائع في البارانويا) بأن الآخرين يسعون للنيل منك وإحباطك وإحراجك أو إلحاق المعاناة بك؛ وغالباً ما يتم تخيل مؤامرة معقدة)",
 "delusive": "زَائِف, مُخَادِع (لا يناسب الواقع أو الحقائق؛ مُضَلِّل)",
 "delusively": "بِشَكْل خَادِع, بِوَهْم (بطريقة خادعة وغير واقعية)\nمثال: بدت القرية قريبة بشكل خادع",
 "delusory": "خَدَّاع, مُضَلِّل (يجعل المرء يصدّق ما ليس صحيحًا أو ينكر ما هو صحيح)",
 "deluxe": "فَاخِر, فَخْم (أنيق وفخم) / فَاخِر, فَخْم (غنيّ بشكل استعراضي ومتفوّق في الجودة)",
 "demagnetisation": "إزالة المغناطيسية, زوال المغناطيسية (عملية إزالة التمغنط)",
 "demagnetization": "إزالة المغناطيسية, زوال المغناطيسية (عملية إزالة التمغنط)",
 "demagog": "ديماغوجي, مهيج الجماهير (زعيم سياسي يسعى للحصول على الدعم من خلال مناشدة المشاعر الشعبية والأحكام المسبقة)",
 "demagogic": "ديماغوجي, غوغائي (مميز للديماغوجي (المحرض السياسي) أو يشبهه)\nمثال: خطابات ديماغوجية",
 "demagogical": "ديماغوجي, غوغائي (مميز للديماغوجي (المحرض السياسي) أو يشبهه)\nمثال: خطابات ديماغوجية",
 "demagogue": "زَعِيم الدهماء, دَهْمَاوِيّ",
 "demagoguery": "ديماغوجية, غوغائية (نداءات حماسية تخاطب تحيزات وعواطف الجماهير)",
 "demagogy": "دَهْمَاوِيَّة, دِيمَاغُوجِيَّة",
 "demand": "طَلَب (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى)) / مُطَّلِب / طَلَبَ (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى))\nمثال: طلب زيري ورودا.",
 "demand curve": "منحنى الطلب (في الاقتصاد، الرسم البياني الذي يصور العلاقة بين سعر سلعة معينة والكمية التي يرغب المستهلكون ويقدرون على شرائها بذلك السعر)",
 "demand deposit": "وديعة تحت الطلب (وديعة بنكية يمكن السحب منها دون إشعار مسبق)",
 "demand feeding": "تغذية عند الطلب (إطعام الطفل أو الحيوان كلما أظهر حاجة لذلك)",
 "demand for explanation": "تشكيك, طلب تفسير (تحد للدفاع عما قاله شخص ما)",
 "demand for identification": "طلب الهوية (كما يفعل الحارس)",
 "demand loan": "قرض تحت الطلب (قرض واجب السداد عند الطلب)",
 "demand note": "سند تحت الطلب (سند مستحق الدفع عند الطلب)",
 "demand-pull inflation": "تضخم مدفوع بالطلب (تضخم ناتج عن زيادة في الطلب أو في عرض النقود)",
 "demander": "مُطَالِب (شخص يقدم مطالب)",
 "demanding": "شاق, متطلب (يتطلب أكثر مما هو متوقع عادة أو يُعتقد أنه مستحق؛ خاصة صبراً وجهداً ومهارة كبيرة)\nمثال: وجد الوظيفة شاقة جداً",
 "demandingly": "بإلحاح, بتطلب (بطريقة متطلبة)\nمثال: أصبح مهيمناً بتطلب على مر السنين",
 "demantoid": "ديمانتويد (أندراديت أخضر يستخدم كحجر كريم)",
 "demarcation": "حد فاصل, خط فاصل (فصل أو تمييز مفاهيمي) / تخم, حد (حدود منطقة معينة)\nمثال: هناك خط رفيع بين العقل والجنون",
 "demarcation line": "خَطُّ تَرْسِيم, خَطُّ التَّرْسِيم (كِتَابَة؛ ما يَصِل نقطتين أو أكثر)\nمثال: إرسم خط مستقيم.",
 "demarche": "ديمارش, مسعى دبلوماسي (خطوة أو مناورة في الشؤون السياسية أو الدبلوماسية)",
 "dematting comb": "مشط فك التشابك (مشط بأسنان حادة كالشفرة يستخدم لإزالة التشابك والعقد من فراء الحيوانات الأليفة)",
 "demeaning": "مُذِلّ, مُهِين (يُثِير الشُّعُور بِالنَّقْص أَوِ القُصُور)",
 "demeaningly": "بشكل مهين (بطريقة مهينة)\nمثال: أعيد إنتاج اللوحة بحجم صغير بشكل مهين",
 "demeanor": "تصرف, سلوك ((السمات السلوكية) الطريقة التي يتصرف بها الشخص تجاه الآخرين)",
 "demeanour": "تصرف, سلوك ((السمات السلوكية) الطريقة التي يتصرف بها الشخص تجاه الآخرين)",
 "demeclocycline hydrochloride": "ديكلوميسين, ديميكلوسيكلين (مضاد بكتيري من التتراسيكلين (الاسم التجاري ديكلوميسين) فعال في علاج بعض الالتهابات البكتيرية والريكتسية وغيرها)",
 "demented": "مَخْبُول, مَجْنُون",
 "dementedly": "بجنون (بطريقة مجنونة)\nمثال: تصرفت بجنون",
