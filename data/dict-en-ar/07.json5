 "dentin": "عاج (عظم (نسيج متكلس) يحيط بتجويف لب السن) / دنتين, عاج الأسنان (مادة كلسية أصلب وأكثر كثافة من العظم تشكل الجزء الأكبر من السن)",
 "dentine": "عاج (عظم (نسيج متكلس) يحيط بتجويف لب السن) / دنتين, عاج الأسنان (مادة كلسية أصلب وأكثر كثافة من العظم تشكل الجزء الأكبر من السن)",
 "dentist": "طَبِيب أَسْنَان, طَبِيبَة أَسْنَان (العالم بالطب)\nمثال: سوف تصبح طبيبة.",
 "dentist's drill": "مثقاب طبيب الأسنان (مثقاب عالي السرعة يستخدمه أطباء الأسنان للحفر في الأسنان)",
 "dentistry": "طب الأسنان (فرع الطب المعني بتشريح وتطور وأمراض الأسنان)",
 "dentition": "أسنان, نظام الأسنان (نوع وعدد وترتيب الأسنان (مجتمعة) في شخص أو حيوان) / بزوغ الأسنان, تسنين (بزوغ أسنان الطفل عبر اللثة)",
 "denture": "بدلة سنية, طقم أسنان (جهاز سني يستبدل الأسنان المفقودة بشكل صناعي)",
 "denture adhesive": "لاصق طقم أسنان (منتج يستخدم لتثبيت أطقم الأسنان في تجويف الفم)\nمثال: يأتي لاصق طقم الأسنان على شكل معجون أو مسحوق أو وسادات لاصقة",
 "denturist": "فني أسنان (شخص يصنع أجهزة طب الأسنان (الجسور وأطقم الأسنان))",
 "denudate": "أَصْلَع, مُجَرَّد مِنَ الغِطَاء (بدون الغطاء الطبيعي أو المعتاد)",
 "denudation": "تعرية, كشف (إزالة الغطاء)",
 "denuded": "أَصْلَع, مُجَرَّد مِنَ الغِطَاء (بدون الغطاء الطبيعي أو المعتاد)",
 "denumerable": "قَابِل لِلْإِحْصَاء, قَابِل لِلْعَدّ (يُمْكِن عَدُّه وإِحْصَاؤُه)",
 "denunciation": "استنكار, تنديد (فعل علني للتنديد)",
 "denunciative": "تَنْدِيدِيّ, تَهْدِيدِيّ (يتضمن تحذيراً بالعقاب)",
 "denunciatory": "تَنْدِيدِيّ, تَهْدِيدِيّ (يتضمن تحذيراً بالعقاب)",
 "deny": "نَفَى",
 "deodar": "أرز الهيمالايا, أرز ديودار (أرز طويل من شرق الهند له فروع منتشرة ذات أطراف متدلية؛ ذو قيمة عالية لمظهره وكذلك لخشبه)",
 "deodar cedar": "أرز الهيمالايا, أرز ديودار (أرز طويل من شرق الهند له فروع منتشرة ذات أطراف متدلية؛ ذو قيمة عالية لمظهره وكذلك لخشبه)",
 "deodorant": "مُزِيل اَلْعَرَق, مُزِيل اَلرَّائِحَة",
 "deodourant": "مزيل العرق (مستحضر تجميلي يوضع على الجلد لإخفاء الروائح الكريهة)",
 "deontic logic": "المنطق الأخلاقي, منطق الواجب (منطق الموجهات المتعلق بالالتزام والجواز)",
 "deossification": "إزالة التعظم (فقدان المحتوى المعدني لأنسجة العظام)",
 "deoxyadenosine": "ديوكسي أدينوزين",
 "deoxyadenosine monophosphate": "ديوكسي أدينوسين أحادي الفوسفات",
 "deoxyadenylate": "ديوكسي أدينوسين أحادي الفوسفات",
 "deoxyadenylic acid": "ديوكسي أدينوسين أحادي الفوسفات",
 "deoxycytidine": "ديوكسي سيتيدين, سيتيدين",
 "deoxycytidine monophosphate": "ديوكسي سيتيدين أحادي الفوسفات",
 "deoxycytidylate": "ديوكسي سيتيدين أحادي الفوسفات",
 "deoxycytidylic acid": "ديوكسي سيتيدين أحادي الفوسفات",
 "deoxyephedrine": "كريستال ميث, ميث (مشتق للأمفيتامين (الاسم التجاري ميثيدرين) يستخدم في شكل هيدروكلوريد بلوري؛ يستخدم كمنشط للجهاز العصبي ومثبط للشهية)",
 "deoxyguanosine": "ديوكسي غوانوزين",
 "deoxyguanosine monophosphate": "ديوكسي غوانوسين أحادي الفوسفات",
 "deoxyguanylate": "ديوكسي غوانوسين أحادي الفوسفات",
 "deoxyguanylic acid": "ديوكسي غوانوسين أحادي الفوسفات",
 "deoxynucleotide": "ديوكسي نيوكليوتيد (أي نيوكليوتيد يحتوي على سكر منقوص الأكسجين)",
 "deoxyribonucleic acid": "حِمْض نَوَوِيّ رِيبِيّ مَنْقُوص الأُكْسِجِين (أصبح حامضًا، تغير الطعم إلى الحموضة؛ ارتفعت نسبة الحموضة في شيء ما، كما في الطعام أو السوائل)\nمثال: رمى ياني الحمض على وجه سكورة.",
 "deoxyribose": "ديوكسي ريبوز, ريبوز منقوص الأكسجين (سكر يُعد أحد مكونات الأحماض النووية)",
 "deoxythymidine": "ثيميدين, ديوكسي ثيميدين",
 "deoxythymidine monophosphate": "ديوكسي ثيميدين أحادي الفوسفات",
 "deoxythymidylic acid": "ديوكسي ثيميدين أحادي الفوسفات",
 "deparia acrostichoides": "ديباريا, طحال فضي (سرخس بنموات فضية ممدودة تحيط بالأبواغ النامية)",
 "depart": "غَادَرَ, رَحَلَ (تَرَكَ)\nمثال: غادر سامي للتو.",
 "departed": "رَاحِل, مُتَوَفًّى (ميّت؛ انتقل إلى رحمة الله) / سَالِف, غَابِر (فِي المَاضِي البَعِيدِ؛ سَابِق) / راحل, فقيد (شخص فارق الحياة ولم يعد حياً)\nمثال: أتساءل عما كان سيفعله الميت",
 "departer": "راحل, مغادر (شخص يغادر)",
 "departing": "مُتَّجِه إِلَى الخَارِج, مُغَادِر (ذاهب أو مُتّجه إلى الخارج أو مُغادر)",
 "department": "قِسْم (فَرَّقَ أو قَسَّمَ الشَّيءَ إلى أجزاء أو أجزاء مختلفة؛ أَحْلَفَ، أَي جَعَلَ يَحْلِفُ على أمرٍ ما)\nمثال: أنا أزين القسم.",
 "department head": "رئيس قسم (رئيس قسم)",
 "department of agriculture": "وزارة الزراعة, وزارة الزراعة الأمريكية (الإدارة الفيدرالية التي تدير البرامج التي تقدم الخدمات للمزارعين (بما في ذلك البحوث وحفظ التربة وجهود تثبيت الاقتصاد الزراعي)؛ أنشئت عام 1862)",
 "department of anthropology": "قسم الأنثروبولوجيا, قسم علم الإنسان (القسم الأكاديمي المسؤول عن التدريس والبحث في علم الإنسان (الأنثروبولوجيا))",
 "department of biology": "قسم الأحياء, قسم البيولوجيا (القسم الأكاديمي المسؤول عن التدريس والبحث في علم الأحياء)",
 "department of chemistry": "قسم الكيمياء (القسم الأكاديمي المسؤول عن التدريس والبحث في الكيمياء)",
 "department of commerce": "وزارة التجارة (الإدارة الفيدرالية الأمريكية التي تعزز وتدير التجارة المحلية والخارجية (بما في ذلك إدارة التعداد ومكتب براءات الاختراع)؛ أنشئت عام 1913)",
 "department of commerce and labor": "وزارة التجارة والعمل (إدارة تنفيذية سابقة لحكومة الولايات المتحدة؛ أنشئت عام 1903 وانقسمت إلى إدارتين عام 1913)",
 "department of computer science": "قسم علوم الحاسوب (القسم الأكاديمي المسؤول عن التدريس والبحث في علوم الحاسوب)",
 "department of corrections": "إدارة الإصلاحيات, مصلحة السجون (إدارة تابعة للحكومة المحلية مسؤولة عن إدارة معاملة المدانين)\nمثال: لمعرفة مهنة في مجال الإصلاحيات، انتقل إلى الموقع الإلكتروني لإدارة الإصلاحيات في نيوجيرسي",
 "department of defense": "البنتاغون, وزارة الدفاع (الإدارة الفيدرالية المسؤولة عن حماية الأمن القومي للولايات المتحدة؛ أنشئت عام 1947)",
 "department of defense laboratory system": "نظام مختبرات وزارة الدفاع (مختبر دفاعي يقدم خدمات أساسية في العلوم الأساسية للأمن القومي وحماية البيئة ويوفر تقنيات تساهم في التنافسية الصناعية)",
 "department of economics": "قسم الاقتصاد (القسم الأكاديمي المسؤول عن التدريس والبحث في الاقتصاد)",
 "department of education": "وزارة التعليم (الإدارة الفيدرالية الأمريكية التي تدير جميع البرامج الفيدرالية المتعلقة بالتعليم (بما في ذلك المساعدات الفيدرالية للمؤسسات التعليمية والطلاب)؛ أنشئت…)",
 "department of energy": "وزارة الطاقة (الإدارة الفيدرالية المسؤولة عن الحفاظ على سياسة الطاقة الوطنية للولايات المتحدة؛ أنشئت عام 1977)",
 "department of energy intelligence": "استخبارات وزارة الطاقة (وكالة تجمع المعلومات السياسية والاقتصادية والفنية حول مسائل الطاقة وتجعل الخبرة الفنية والتحليلية لوزارة الطاقة متاحة لأعضاء مجتمع الاستخبارات الآخرين)",
 "department of english": "قسم اللغة الإنجليزية (القسم الأكاديمي المسؤول عن تدريس الأدب الإنجليزي والأمريكي)",
 "department of health and human services": "وزارة الصحة والخدمات الإنسانية (الإدارة الفيدرالية الأمريكية التي تدير جميع البرامج الفيدرالية التي تتعامل مع الصحة والرفاهية؛ أنشئت عام 1979)",
 "department of health education and welfare": "وزارة الصحة والتعليم والرفاهية (إدارة تنفيذية سابقة لحكومة الولايات المتحدة؛ أنشئت عام 1953 وقُسمت عام 1979)",
 "department of history": "قسم التاريخ (القسم الأكاديمي المسؤول عن تدريس التاريخ)",
 "department of homeland security": "وزارة الأمن الداخلي (الإدارة الفيدرالية التي تدير جميع المسائل المتعلقة بالأمن الداخلي)",
 "department of housing and urban development": "وزارة الإسكان والتنمية الحضرية (الإدارة الفيدرالية الأمريكية التي تدير البرامج الفيدرالية التي تتعامل مع تحسين الإسكان والتجديد الحضري؛ أنشئت عام 1965)",
 "department of justice": "وزارة العدل (الإدارة الفيدرالية الأمريكية المسؤولة عن إنفاذ القوانين الفيدرالية (بما في ذلك إنفاذ جميع تشريعات الحقوق المدنية)؛ أنشئت عام 1870)",
 "department of justice canada": "وزارة العدل الكندية (وكالة تابعة للحكومة الكندية تقدم المشورة القانونية والتقاضي والآراء للحكومة)",
 "department of labor": "وزارة العمل (الإدارة الفيدرالية المسؤولة عن تعزيز ظروف عمل أصحاب الأجور في الولايات المتحدة؛ أنشئت عام 1913)",
 "department of linguistics": "قسم الألسن, قسم اللغويات (القسم الأكاديمي المسؤول عن التدريس والبحث في اللغويات)",
 "department of local government": "إدارة محلية (إدارة دائمة تُنشأ لأداء مهام الحكومة المحلية)",
 "department of mathematics": "قسم الرياضيات (القسم الأكاديمي المسؤول عن التدريس والبحث في الرياضيات)"
}
