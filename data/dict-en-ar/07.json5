 "deanery": "عمادة (منصب أو مكتب العميد (في الكلية أو الكنيسة)) / سكن العميد (المقر الرسمي لعميد الكلية أو الكاتدرائية)",
 "deanship": "عمادة (منصب أو مكتب العميد (في الكلية أو الكنيسة))",
 "dear": "عَزِيز, عَزِيْزَة (القوي المنيع، ضد الذليل؛ القليل النادر العالي القيمة) / غَالِي, غَالِيَّة\nمثال: هذه رسالة من شخص عزيز.",
 "dearest": "حبيب, عزيز (شخص محبوب؛ تستخدم ككلمات تودد)",
 "dearie": "حبيب, عزيز (شخص محبوب؛ تستخدم ككلمات تودد) / حبيب, مفضل (شخص محبوب مميز)",
 "dearly": "بثمن باهظ, غالياً (بتكلفة كبيرة) / بحنان, بشدة / بصدق, من صميم القلب (بطريقة صادقة ومن القلب)\nمثال: دفع ثمناً باهظاً للطعام",
 "dearly-won": "بَاهِظ التَّكْلِفَة (ينطوي على خسارة أو تضحية كبيرة)",
 "dearness": "غَلَاة",
 "dearth": "خصاصة, قلة (كمية أو عدد غير كافٍ) / شح, مجاعة",
 "deary": "حبيب, عزيز (شخص محبوب؛ تستخدم ككلمات تودد) / حبيب, مفضل (شخص محبوب مميز)",
 "death": "مَوْت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي) / وَفَاة / هَلَاك / مَنِيَّة / حِمَام (قضاء الموت وقدره؛ جمع حُمَّة وهو قدر الفراق) / موت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي)\nمثال: لا اخاف الموت .",
 "death adder": "أفعى الموت (ثعبان أسترالي سام يشبه الأفعى)",
 "death angel": "أمانيت فالوسي, قبعة الموت (فطر سام للغاية عادة ما يكون أبيض اللون بقاعدة بارزة تشبه الكأس؛ يختلف عن الغاريقون الصالح للأكل فقط في خياشيمه البيضاء)",
 "death bell": "جرس الموت, نعي (جرس يُدق للإعلان عن وفاة)",
 "death benefit": "تعويض الوفاة, مخصص الوفاة (أموال تأمين أو معاش تقاعدي تدفع لمستفيد من المتوفى)",
 "death camas": "زيجادين, كاماس الموت (أي من النباتات المختلفة من جنس زيجادينوس ذات أوراق زرقاء مخضرة وعناقيد طرفية من الزهور البيضاء في الغالب؛ جميعها سامة)",
 "death camp": "مُعَسْكَر إِبَادَة, مُعَسْكَر مَوْت",
 "death cap": "أمانيت فالوسي, قبعة الموت (فطر سام للغاية عادة ما يكون أبيض اللون بقاعدة بارزة تشبه الكأس؛ يختلف عن الغاريقون الصالح للأكل فقط في خياشيمه البيضاء)",
 "death chair": "كرسي كهربائي (أداة إعدام بالصعق الكهربائي؛ تشبه مقعداً عادياً لشخص واحد)\nمثال: حُكم على القاتل بالموت على الكرسي الكهربائي",
 "death chamber": "غرفة الغاز (أداة إعدام تتكون من غرفة محكمة الغلق يتم إدخال الغاز السام إليها؛ تستخدم لقتل الناس أو الحيوانات)",
 "death cup": "أمانيت فالوسي, قبعة الموت (فطر سام للغاية عادة ما يكون أبيض اللون بقاعدة بارزة تشبه الكأس؛ يختلف عن الغاريقون الصالح للأكل فقط في خياشيمه البيضاء)",
 "death duty": "ضريبة التركات, ضريبة الميراث (ضريبة على تركة الشخص المتوفى)",
 "death house": "عنبر الإعدام (قسم الزنازين في السجن حيث ينتظر المحكوم عليهم بالإعدام تنفيذ الحكم)",
 "death instinct": "ثاناتوس, غريزة الموت ((التحليل النفسي) رغبة لاواعية في الموت)",
 "death knell": "صُور",
 "death mask": "قناع الموت (غطاء يوضع على الوجه للحماية أو التنكر؛ طبق يوضع فيه الطعام. )\nمثال: نزع زيري القناع.",
 "death metal": "ديث ميتال ((دَيَّثَ) فلان: كان ديوثاً. و - الطريق: وطَّأََهُ وذَلَّلَهُ. و - الشيء: لينه وسهله. يقال: دَيَّثَتِ المطرقَةُ الحديد. ويقال: دَيَّثَ الجِِلْدَ في…)",
 "death penalty": "إِعْدَام, عُقُوبَة الْإِعْدَام (في القانون: هي عقوبة يحددها القضاء على جريمة كبرى اقترفها المتهم وتؤدي إلى قتل المتهم غالبا بالشنق)\nمثال: محكم عليه بالإعدام.",
 "death rate": "مُعَدَّل الوَفَيَات (نسبة الوفيات في منطقة ما إلى سكان تلك المنطقة؛ يُعبر عنها لكل 1000 في السنة)",
 "death row": "عنبر الإعدام (قسم الزنازين في السجن حيث ينتظر المحكوم عليهم بالإعدام تنفيذ الحكم)",
 "death seat": "مقعد الموت (مقعد السيارة بجانب السائق؛ يُعتقد أنه أخطر مكان للجلوس في السيارة في حالة وقوع حادث)",
 "death squad": "فرقة الموت (فريق عسكري أو شبه عسكري سري يقوم بقتل المعارضين السياسيين أو المجرمين الصغار (عادة بموافقة ضمنية من الحكومة))",
 "death tax": "ضريبة التركات, ضريبة الميراث (ضريبة على تركة الشخص المتوفى)",
 "death threat": "تَهْدِيد بِالْقَتْل",
 "death toll": "حصيلة القتلى (عدد الوفيات الناتجة عن سبب معين مثل حادث أو معركة أو كارثة طبيعية)",
 "death warrant": "عقوبَة الإعدام",
 "death wish": "تَمَنِي اَلْمَوْت",
 "death's head": "جمجمة الموت (جمجمة بشرية (أو تمثيل لها) تستخدم كرمز للموت)",
 "death's-head moth": "عثة رأس الموت (عثة صقرية أوروبية بعلامات على الظهر تشبه جمجمة بشرية)",
 "death-roll": "قائمة القتلى (قائمة بالأشخاص الذين قتلوا في حرب أو كارثة أخرى)",
 "deathbed": "سرير الاحتضار, فراش الموت (السرير الذي يموت عليه الشخص) / فراش الموت (الساعات الأخيرة قبل الوفاة)",
 "deathblow": "ضربة الرحمة, ضربة قاضية (الضربة التي تقتل (عادة بدافع الرحمة))",
 "deathless": "خَالِد أَبَدًا, لَا يَمُوت (لا يموت أبدًا؛ باقٍ إلى الأبد)",
 "deathlike": "شَبِيه بِالمَوْت (له مظهر جسدي يشبه الموت)",
 "deathly": "بشدة, جداً (لدرجة قصوى) / شَبِيه بِالمَوْت (له مظهر جسدي يشبه الموت) / كَالمَوْت (بدرجة تشبه الموت) / فَتَّاك, مُمِيت (يُسَبِّب أَوْ قَادِر عَلَى التَّسَبُّب فِي المَوْت)\nمثال: بارد جداً",
 "deathrate": "مُعَدَّل الوَفَيَات (نسبة الوفيات في منطقة ما إلى سكان تلك المنطقة؛ يُعبر عنها لكل 1000 في السنة)",
 "deathtrap": "فخ الموت, مكان شديد الخطورة (أي هيكل غير آمن للغاية؛ حيث من المحتمل أن يُقتل الناس فيه)",
 "deathwatch": "خنفساء ساعة الموت (تحفر في الخشب وتصدر صوتاً يشبه دقات الساعة يعتقد شعبياً أنه ينذر بالموت) / قمل الكتب (حشرات دقيقة غير مجنحة من رتبة سوكوبترا ضارة بالكتب والأوراق)",
 "deathwatch beetle": "خنفساء ساعة الموت (تحفر في الخشب وتصدر صوتاً يشبه دقات الساعة يعتقد شعبياً أنه ينذر بالموت)",
 "deb": "فتاة المجتمع (شابة تظهر للمجتمع لأول مرة)",
 "debacle": "فَشَل ذَرِيْع, كارِثة (فَشَلَ الطالبُ في الامتحان: لم ينجح في الاختبار ولم يحقق النتيجة المطلوبة؛ فَشَلَ الشيءُ: انهار أو انكسر أو توقف عن العمل)\nمثال: فشل ياني مجددا.",
 "debaltseve": "ديبالتسيفي",
 "debarkation": "نزول (عملية نزول الركاب والطاقم من سفينة أو طائرة)",
 "debarment": "حرمان, منع قانوني (فعل المنع بالوسائل القانونية) / حرمان, منع (حالة الحرمان (الاستبعاد من التمتع بممتلكات أو حقوق أو ممارسات معينة))\nمثال: حققوا منعه من تولي المناصب العامة",
