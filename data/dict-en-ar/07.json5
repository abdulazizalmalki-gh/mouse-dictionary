 "crayfish": "جَرَاد الْبَحْر",
 "crayon": "قلم تلوين شمعي, قلم شمع (أداة كتابة تتكون من عصا ملونة من الشمع المركب تستخدم للكتابة والرسم)",
 "craze": "تشقق دقيق (شق دقيق في الطلاء أو أي سطح آخر) / بدعة, صرعة (اهتمام يُتبع بحماس مبالغ فيه) / نوبة جنون, هياج (حالة من الهياج العقلي العنيف)\nمثال: يتبع دائماً أحدث الصرعات",
 "crazed": "مُجَنَّن, مُختَلُّ العَقْل (دُفِع إلى الجنون؛ فَقَدَ عقله)",
 "crazily": "بجنون (بطريقة مجنونة)\nمثال: تصرفت بجنون",
 "craziness": "حماقة, طيش (سلوك أحمق أو لا معنى له) / جنون, حماقة (صفة التهور والحماقة) / جنون, خبال (مصطلحات غير رسمية للجنون)\nمثال: محاولة القيادة خلال عاصفة ثلجية هي قمة الحماقة",
 "crazy": "مَجْنُون, مَخْبُول",
 "crazy bone": "العظم المجنون, عصب الكوع (نقطة على الكوع حيث يمر العصب الزندي بالقرب من السطح؛ ينتج إحساس بالوخز الحاد عند ارتطام العصب بالعظم)",
 "crazy glue": "غراء كريزي (علامة تجارية لغراء الإيبوكسي)",
 "crazy house": "مارستان, مستشفى المجانين (مصطلحات تحقيرية لمصحة المجانين)",
 "crazy quilt": "لحاف عشوائي الترقيع (لحاف مرقع بدون تصميم منتظم)",
 "crazy weed": "عشبة الجنون, لوكويد (أي من النباتات البقولية المتعددة في غرب أمريكا الشمالية التي تسبب التسمم (اللوكو) للماشية)",
 "crazyweed": "عشبة الجنون, لوكويد (أي من النباتات البقولية المتعددة في غرب أمريكا الشمالية التي تسبب التسمم (اللوكو) للماشية)",
 "creak": "زَيَّقَ, صَرَّ ((زيق) القميص ونحوه: جعل له زيقا)",
 "creakily": "بِأَزِيز, بِصَرِير (بطريقة تصدر صريراً)\nمثال: كان القارب القديم يتحرك بصرير",
 "creaking": "صرير (صوت صرير)\nمثال: صرير ألواح الأرضية كشف أمره",
 "creakingly": "بِأَزِيز, بِصَرِير (بطريقة تصدر صريراً)\nمثال: كان القارب القديم يتحرك بصرير",
 "creaky": "رُوماتِيزْمِيّ, مَفْصِلِيّ (مُتَعَلِّق بِالتِهاب المَفاصِل أو الرُّوماتِيزْم) / خَشِن الصَّوْت, صَرِير (ذو صوت خشن صارّ كالاحتكاك) / مُتَدَاعٍ, مُتَهَالِك (بَالٍ وَمُتَحَطِّمٌ بِسَبَبِ الاسْتِعْمَالِ الشَّدِيدِ)",
 "cream": "كْرِيم, كِرِيم (نبيل النفس عزيزها ذو الخلق العالي والخير الكثير والعطاء السخي. الكَرَم يشمل مجموعة من الأخلاق أهمها العطاء؛ الجَوَاد السخيّ تحديدا)\nمثال: يا لك من رجل كريم!",
 "cream cheese": "جبن كريمي (جبن طري غير معتق مصنوع من الحليب الحلو والقشطة)",
 "cream cleanser": "منظف كريمي (منظف للبشرة يأتي في شكل سائل سميك، يشبه في قوامه المستحضر (اللوشن))\nمثال: يوصى بالمنظف الكريمي للبشرة الجافة",
 "cream of mushroom soup": "شوربة كريمة الفطر (نوع بسيط من الحساء حيث يُخفف الرو الأساسي بالقشدة أو الحليب ثم يضاف الفطر و/أو مرق الفطر)",
 "cream of tartar": "طرطرات البوتاسيوم الهيدروجينية, كريم التارتار (ملح يستخدم بشكل خاص في مسحوق الخبز (البيكنج بودر))",
 "cream pitcher": "إبريق قشدة, وعاء كريمة (إبريق صغير لتقديم القشدة)",
 "cream puff": "شو, فطيرة القشطة (فطيرة منتفخة محشوة بالكريمة أو الكسترد)",
 "cream sauce": "صلصة الكريمة (صلصة بيضاء مصنوعة بالكريمة)",
 "cream soda": "صودا الكريمة (مشروب غازي حلو بنكهة الفانيليا)",
 "cream violet": "بنفسج شاحب (بنفسج مورق الساق من شرق أمريكا الشمالية له زهور بيضاء كبيرة أو كريمية معلمة بشكل خافت بالأرجواني)",
 "cream-colored": "أَبْيَض قِشْدِيّ, كِرِيمِيّ اللَّوْن (بلون القشدة الطازجة)",
 "cream-colored courser": "جليل, كروان عسلي (طائر جليل من المناطق الصحراوية وشبه الصحراوية في العالم القديم)",
 "cream-of-tartar tree": "أدانسونية غريغورية, شجرة كريم الترتار (شجرة أسترالية لها ثمرة حمضية مقبولة تشبه القرع)",
 "creamcups": "أكواب القشطة, بلاتيستيمون (نبات كاليفورني بزهور صفراء شاحبة صغيرة)",
 "creamer": "إبريق قشدة, وعاء كريمة (إبريق صغير لتقديم القشدة)",
 "creamery": "متجر ألبان, معمل ألبان (مكان عمل يتم فيه إنتاج أو بيع منتجات الألبان (الزبدة والجبن وما إلى ذلك))",
 "creaminess": "دسامة, قوام كريمي (خاصية امتلاك كثافة القشدة الثقيلة)",
 "creampie": "قذف داخلي (القذف داخل المهبل أو الشرج)",
 "creamy": "قشدي, كريمي",
 "creamy-colored": "أَبْيَض قِشْدِيّ, كِرِيمِيّ اللَّوْن (بلون القشدة الطازجة)",
 "creamy-white": "أَبْيَض قِشْدِيّ, كِرِيمِيّ اللَّوْن (بلون القشدة الطازجة)",
 "creamy-yellow": "أَصْفَر كِرِيمِيّ (أصفر مع مسحة قشدية)",
 "crease": "خنجر الكريس (خنجر ماليزي ذو نصل متموج) / تجعد, ثنية (انخفاض أو طية طفيفة في نعومة السطح) / انثناء, ثنية (شكل زاوي أو مستدير ناتج عن الطي)\nمثال: يحتوي وجهه على العديد من الخطوط",
 "crease-resistant": "ضد الكرمشة, مقاوم للتجعد (من القماش الذي لا يتجعد بسهولة)",
 "creaseless": "خَالٍ مِنَ التَّجَاعِيدِ ((يُستخدم خاصّة للأقمشة) بلا تجاعيد أو ثنايا)",
 "creaseproof": "ضد الكرمشة, مقاوم للتجعد (من القماش الذي لا يتجعد بسهولة)",
 "creashak": "عنب الدب, قطلب عنب الدب (شجيرة دائمة الخضرة تشكل حصيرة من أمريكا الشمالية وشمال أوراسيا لها زهور بيضاء صغيرة وتوت أحمر؛ تتحول الأوراق إلى الأحمر في الخريف)",
 "creasing machine": "آلة تحزيز, آلة طي (آلة يدوية أو كهربائية تستخدم لطي أو تحزيز المستندات الورقية والأغلفة الصلبة وأنواع أخرى من الأغلفة)",
 "create": "خَلَقَ (أَنْشَأَ، أَوْجَدَ)\nمثال: زيري سيء الخلق.",
 "creatin": "كرياتين (حمض أميني لا يوجد في البروتينات ولكنه يوجد في الأنسجة العضلية للفقاريات في شكل حر وكفوسفوكرياتين؛ يمد الطاقة لتقلص العضلات)",
 "creatine": "كرياتين (حمض أميني لا يوجد في البروتينات ولكنه يوجد في الأنسجة العضلية للفقاريات في شكل حر وكفوسفوكرياتين؛ يمد الطاقة لتقلص العضلات)",
 "creatine phosphate": "فوسفوكرياتين (مركب عضوي من الكرياتين وحمض الفوسفوريك؛ يوجد في عضلات الفقاريات حيث يطلق تحلله المائي الطاقة لتقلص العضلات)",
 "creatine phosphoric acid": "فوسفوكرياتين (مركب عضوي من الكرياتين وحمض الفوسفوريك؛ يوجد في عضلات الفقاريات حيث يطلق تحلله المائي الطاقة لتقلص العضلات)",
 "creating by mental acts": "إبداع ذهني, خلق عقلي (فعل خلق شيء ما عن طريق التفكير)",
 "creating by removal": "تشكيل بالنزع, خلق بالحذف (فعل الخلق عن طريق إزالة شيء ما)",
 "creating from raw materials": "إنشاء من مواد خام, تصنيع (فعل إنشاء شيء يختلف عن المواد التي دخلت في تكوينه)",
 "creatio ex nihilo": "الخلق من عدم ((اللاهوت اليهودي-المسيحي)، الاعتقاد بأن الله خلق هذا العالم من لا شيء)",
 "creation": "خِلْقَة, خَلْق / اِبْتِكَار, خَلْق / خَلْق (أَنْشَأَ، أَوْجَدَ)\nمثال: زيري سيء الخلق.",
