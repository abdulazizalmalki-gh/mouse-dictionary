 "cripple": "مُقْعَد (كل ما يُقْعَدُ ويُجْلَسُ عليه؛ مَكَان القُعُود)\nمثال: نام ياني على مقعد.",
 "crippled": "أَعْرَج, مُقْعَد (مُصَابٌ بِعَجْزٍ فِي القَدَمَيْنِ أَوِ السَّاقَيْنِ)",
 "crippling": "مُعَطِّل, مُقْعِد (يُسَبِّب عَجْزًا أو إعاقَة جَسَدِيَّة)",
 "crisis": "أَزْمَة, بُحْرَان / أَزْمَة",
 "crisis intervention": "تدخل في الأزمات (علاج نفسي يركز على المواقف الحرجة الحادة (نوبات الاكتئاب أو محاولات الانتحار أو الجرعات الزائدة من المخدرات) بهدف إعادة الشخص إلى مستوى الأداء قبل…)",
 "crisp": "حَادّ, مُقْتَضَب (قَصِيرٌ وَمُبَاشِرٌ؛ مُخْتَصَرٌ بِفَاعِلِيَّةٍ) / حَادّ, قَاطِع ((عَمَّا يُرَى أَوْ يُسْمَع) مُحَدَّد بِوُضُوح) / شَدِيدُ التَّجْعِيد, مُكَرَّش ((عَنِ الشَّعْرِ) ذُو تَجْعِيدَاتٍ صَغِيرَةٍ وَمُحْكَمَةٍ) / مُقَرْمَش, هَشّ (صَلْب وَطَازَج بِشَكْل مُسْتَحَبّ)",
 "crispate": "مُجَعَّد, مُلْتَوٍ (متموّج أو مُحَزَّز وملتفّ بشكل غير منتظم)",
 "crisphead lettuce": "خس آيسبرغ, خس الرؤوس (خس ذو أوراق خضراء فاتحة مقرمشة ومعبأة بإحكام في رأس صلب)\nمثال: خس الآيسبرغ لا يزال هو الخس الأكثر شعبية",
 "crispiness": "قرمشة, هشاشة (صلب ولكن ينكسر بسهولة)",
 "crisply": "بشكل حاد, بوضوح (بطريقة محددة بوضوح)\nمثال: كان النمط الجديد للفخار المينوي محدداً بوضوح",
 "crispness": "خشخشة, هشاشة (صلابة ونضارة ممتعة) / قرمشة, هشاشة (صلب ولكن ينكسر بسهولة) / حسم, مباشرة (أسلوب تعبيري مباشر وفي صلب الموضوع)\nمثال: خشخشة أوراق الدولار الجديدة",
 "crispy": "مُقَرْمَش, مُقَرْمَشَة",
 "crisscross": "بِشَكْل مُتَقَاطِع, تَقَاطُعِيًّا (يتقاطع مع بعضه البعض في اتجاهات متعاكسة) / مُتَقَاطِع (مُعلَّم بخطوط متقاطعة) / صليب, علامة متقاطعة (علامة تتكون من خطوط تتقاطع مع بعضها البعض)",
 "crisscrossed": "مُتَقَاطِع (مُعلَّم بخطوط متقاطعة)",
 "cristal": "إكس, حبوب السعادة (أسماء دارجة لـ إم دي إم إيه)",
 "cristobalite": "كريستوباليت (معدن أبيض يتكون من السيليكا؛ يوجد في الصخور البركانية)",
 "crit": "سباق المعيار, كريتريوم (سباق دراجات يُقام على مسار قصير (عادة أقل من 5 كم أو 3 أميال))",
 "criterial": "تَقْيِيمِيّ, مِعْيَارِيّ (يُستخدَم كأساس للتقييم)",
 "criterion": "مِعْيَار (العِيَار الذي يُقَاس به غيره، اسم آلة؛ قد يقصد به العِيَار)",
 "criterional": "تَقْيِيمِيّ, مِعْيَارِيّ (يُستخدَم كأساس للتقييم)",
 "criterium": "سباق المعيار, كريتريوم (سباق دراجات يُقام على مسار قصير (عادة أقل من 5 كم أو 3 أميال))",
 "crith": "كريث (وزن لتر واحد من الهيدروجين (عند 0 درجة مئوية وضغط 760 ملم))",
 "critic": "نَقَّاد, نَاقِد / ناقد",
 "critical": "النقد",
 "critical analysis": "تحليل نقدي, تقييم نقدي (تقييم قائم على الفحص التحليلي الدقيق)",
 "critical angle": "زَاوِيَة حَرِجَة",
 "critical apparatus": "جهاز نقدي, هوامش نقدية (القراءات المتنوعة والحواشي السفلية وغيرها الموجودة في عمل علمي أو طبعة نقدية لنص)",
 "critical appraisal": "تحليل نقدي, تقييم نقدي (تقييم قائم على الفحص التحليلي الدقيق)",
 "critical mass": "كتلة حرجة (الحد الأدنى من كتلة المواد القابلة للانشطار التي يمكن أن تحافظ على التفاعل المتسلسل) / كتلة حرجة (الحد الأدنى من الكمية (لشيء ما) المطلوب لبدء مشروع أو الحفاظ عليه)\nمثال: وصلت المعركة من أجل سوق الكمبيوتر الآن إلى الكتلة الحرجة",
 "critical point": "مفترق طرق, منعطف حرج (حالة أزمة أو نقطة زمنية يجب فيها اتخاذ قرار حاسم)\nمثال: في ذلك المنعطف لم يكن لديه أدنى فكرة عما يجب فعله",
 "critical review": "مراجعة, مقالة نقدية (مقالة تعطي تقييماً نقدياً (لكتاب أو مسرحية))",
 "critical thinking": "تَفْكِير نَقْدِيّ (عملية عقلية يتم من خلالها تحليل الأفكار أو المعلومات للوصول إلى فهم أو قرار؛ إعمال العقل في تأمل أو تخطيط لأمر معين)\nمثال: ابدأ في التفكير.",
 "criticality": "حراجة (حالة حرجة؛ خاصة النقطة التي يصبح فيها التفاعل النووي مستداماً ذاتياً) / حرج, خطورة (حالة من الإلحاح الحرج)",
 "critically": "اِنْتِقَاد",
 "criticalness": "حرج, خطورة (حالة من الإلحاح الحرج)",
 "criticism": "نَقْد, اِنْتِقَاد",
 "criticize": "اِنْتَقَدَ / نَقَدَ",
 "critique": "انتقاد, نقد (فحص وحكم جاد على شيء ما) / مراجعة, مقالة نقدية (مقالة تعطي تقييماً نقدياً (لكتاب أو مسرحية))\nمثال: النقد البناء دائماً محل تقدير",
 "critter": "دابة, مخلوق (مصطلح إقليمي يعني 'مخلوق' (خاصة للحيوانات الأليفة))",
 "critter sitter": "جَلِيس الحَيَوانات الأَلِيفَة (شخص يتولى رعاية الحيوانات الأليفة أثناء غياب أصحابها عن المنزل)",
 "crixivan": "إندينافير, كريكسيفان (مثبط للبروتياز (الاسم التجاري كريكسيفان) يستخدم لعلاج فيروس نقص المناعة البشرية)",
 "cro": "أوسيلوسكوب, راسم إشارة (معدات إلكترونية توفر صوراً مرئية للكميات الكهربائية المتغيرة)",
 "cro-magnon": "كرومانيون (إنسان منقرض من العصر الحجري القديم العلوي في أوروبا)",
 "croak": "نَقِيق / نَقَّ",
 "croaker": "نعيق (أي من عدة أسماك تصدر صوت نعيق) / سمك البهري, سمك الطبل (اللحم قليل الدهن لسمكة مياه مالحة تصاد على طول ساحل المحيط الأطلسي لجنوب الولايات المتحدة)",
 "croaking": "نقيق (تلفظ أجش خشن (كما للضفدع))",
 "croaky": "أَجَشّ, حَلْقِيّ (يُشْبِه أَصْوَات الضَّفَادِع والغِرْبَان)",
 "croat": "كرواتي (فرد من الشعب السلافي الذي يعيش في كرواتيا)",
 "croatia": "كُرُوَاتِيَا",
 "croatian": "كُرُوَاتِيّ",
 "croatian monetary unit": "وحدة نقدية كرواتية (الوحدة النقدية المستخدمة في كرواتيا)",
 "crocanthemum canadense": "عشبة الصقيع (نبات معمر من شرق الولايات المتحدة له زهور صفراء منفردة مبكرة تليها زهور متأخرة بدون بتلات؛ سمي كذلك لأن بلورات الجليد تتشكل عليه خلال الصقيع الأول)",
 "crocethia alba": "مدروان (طيطوي صغير يتكاثر في القطب الشمالي ويهاجر جنوباً على طول السواحل الرملية في معظم أنحاء العالم)",
 "crochet": "كُرُوشِيه",
 "crochet hook": "إبرة كروشيه, سنارة كروشيه (إبرة ذات خطاف في نهايتها؛ تستخدم في حياكة الكروشيه)",
 "crochet needle": "إبرة كروشيه, سنارة كروشيه (إبرة ذات خطاف في نهايتها؛ تستخدم في حياكة الكروشيه)",
 "crochet stitch": "غرزة الكروشيه (أي واحدة من عدد من الغرز المصنوعة بسحب حلقة من الغزل عبر حلقة أخرى بإبرة كروشيه)",
 "crocheting": "حياكة بالسنارة, كروشيه (صنع الملابس بالإبرة المعقوفة (الكروشيه)) / حياكة بالسنارة, كروشيه (أشغال إبرة تتم عن طريق تشبيك غرز حلقية بإبرة معقوفة)",
 "crock": "إناء خزفي, جرة فخارية (جرة ترابية (مصنوعة من الطين المخبوز)) / كَذِب, هُرَاء (هراء؛ حديث أحمق) / أسود الكربون, سخام (مادة غروانية سوداء تتكون كلياً أو أساساً من الكربون غير المتبلور وتستخدم لصنع الأصباغ والحبر)\nمثال: هذا هراء",
 "crock pot": "طباخ بطيء, قدر الفخار (طباخ كهربائي يحافظ على درجة حرارة منخفضة نسبياً)",
 "crocked": "ثَمِل تَمَامًا, سَكْرَان طَافِح (فِي حَالَة سُكْرٍ شَدِيد)",
 "crockery": "أطباق, أواني فخارية (أواني المائدة (أطباق الأكل والتقديم) بشكل جماعي)",
 "crocket": "كرية زخرفية (زخرفة معمارية من أوراق منحنية تستخدم عند حافة البرج أو الجملون)",
 "crocketed": "مُزَيَّن بِالزَّخَارِف الوَرَقِيَّة ((لقمة جملون أو برج) مزود بزخرفة على شكل أوراق نباتية منحنية)",
 "crocodile": "تِمْسَاح (حَيَوَان زَاحِف كبير يعيش في المياه العذبة مثل الأنهار والبحيرات، وأحياناً في السواحل. يتميز بفكٍّ قوي مليء بالأسنان الحادة، وجسم مغطى بجلد خشن وسميك…؛ (عَامِّيَّة مِصْرِيَّة) أحد موديلات 1976–84 من سيارات مرسيدس بنز)\nمثال: هناك تمساح في البحر.",
 "crocodile bird": "زقزاق مصري, طائر التمساح (طائر جليل أفريقي يتغذى على الطفيليات الحشرية على التماسيح)",
 "crocodile tear": "دُمُوع اَلتَّمَاسِيح",
 "crocodile tears": "دموع التماسيح (إظهار نفاق للحزن؛ بكاء كاذب أو غير صادق)\nمثال: ذرفت السكرتيرات دموع التماسيح على معضلة المدير",
 "crocodilian": "تمساحيات (زاحف أركوصوري حي)",
 "crocodilian reptile": "تمساحيات (زاحف أركوصوري حي)",
 "crocodylus niloticus": "تمساح النيل (تمساح خطير واسع الانتشار في أفريقيا)",
 "crocodylus porosus": "تمساح آسيوي, تمساح المياه المالحة (تمساح مصبات الأنهار في شرق آسيا وجزر المحيط الهادئ)",
 "crocoite": "كروكوليت (معدن كرومات الرصاص النادر الذي يشكل بلورات برتقالية زاهية)",
 "crocus": "زعفران, كروكوس (أي من النباتات المنخفضة النمو المتعددة من جنس الزعفران ذات أوراق عشبية نحيلة وأزهار بيضاء أو صفراء أو أرجوانية؛ موطنها الرئيسي منطقة البحر الأبيض…)",
 "crocus sativus": "زعفران (زعفران من العالم القديم له زهور أرجوانية أو بيضاء مع مياسم برتقالية عطرية نفاذة تستخدم في تنكيه الطعام)",
 "crocuta crocuta": "ضبع ضاحك, ضبع مرقط (ضبع أفريقي يشتهر بعوائه المميز)",
 "croesus": "كرويسوس, قَارُون",
 "croft": "حقل مؤجر, مزرعة صغيرة (مزرعة صغيرة يعمل بها مزارع مستأجر (خاصة في اسكتلندا))",
 "crofter": "مزارع حيازات صغيرة (مالك أو مستأجر لمزرعة صغيرة في بريطانيا العظمى)",
 "crohn's disease": "التهاب الأمعاء الناحي, داء كرون (التهاب مزمن وخطير ومتفاقم في اللفائفي يسبب نوبات متكررة من الإسهال مع آلام البطن والغثيان والحمى وفقدان الوزن)",
 "croissant": "كْرُوَاسَّان, كْرُوَاسُّون",
 "croix de guerre": "صليب الحرب (وسام عسكري فرنسي للشجاعة)",
 "cromlech": "دولمن, منضدة صخرية (مقبرة صخرية ضخمة من عصور ما قبل التاريخ تتكون عادة من حجرين عموديين كبيرين وحجر غطاء)",
 "cromorne": "كروماهورن (آلة نفخ خشبية من عصر النهضة بقصبة مزدوجة وأنبوب منحني)",
 "cromulent": "مشروع, مقبول (شرعي أو صالح (تستخدم غالباً بشكل ساخر))",
 "cromwellian": "كرومويلي (من أو يتعلق بأوليفر كرومويل أو على طريقته)",
 "cronartium ribicola": "صدأ نفطي (فطر يسبب صدأ الصنوبر الأبيض النفطي وله دورة حياة معقدة تتطلب نباتاً من جنس ريبس كعائل بديل)",
 "crone": "عجوز شمطاء (امرأة عجوز قبيحة وشريرة المظهر)",
 "crony": "رفيق, زميل (صديق مقرب يرافق رفاقه في أنشطتهم)",
 "cronyism": "وَاسِطَة",
 "croo monkey": "مكاك آكل السرطان, مكاك طويل الذيل (قرد يعيش في جنوب شرق آسيا وبورنيو والفلبين)",
 "crook": "عصا الراعي, محجن (عصا طويلة ذات طرف على شكل خطاف) / جانٍ, مجرم (شخص ارتكب جريمة أو تمت إدانته قانونياً بجريمة) / التواء, انعطاف (جزء دائري من منحنى)\nمثال: منعطف في الطريق",
 "crookback": "أَحْدَب, مُقَوَّسُ الظَّهْر (يُعَانِي مِنْ تَقَوُّسٍ غَيْرِ طَبِيعِيٍّ فِي العَمُودِ الفِقَرِيّ (حُدَاب)) / أحدب (شخص ظهره مقوس بسبب انحناء غير طبيعي في العمود الفقري العلوي)",
 "crookbacked": "أَحْدَب, مُقَوَّسُ الظَّهْر (يُعَانِي مِنْ تَقَوُّسٍ غَيْرِ طَبِيعِيٍّ فِي العَمُودِ الفِقَرِيّ (حُدَاب))",
 "crooked": "مُحْدَوْدِب, مُنْحَنِي الظَّهْر (ذو ظهر وكتفَين مُنحنيَين؛ غير منتصب) / أَعْوَجُ, غَيْرُ مُتَنَاظِرٍ (غير منتظم في الشكل أو الخطوط الخارجية) / أعوج, متعرج (به انحناءات أو زوايا؛ غير مستقيم أو محاذاة) / غير نزيه, فاسد (غير مستقيم؛ غير شريف أو غير أخلاقي أو مراوغ)\nمثال: طرق ريفية متعرجة",
 "crooked-stemmed aster": "أستر معوج الساق",
 "crookedly": "بِشَكْل غَيْر مُتَوَازِن, بِمَيْل (بطريقة ملتوية أو غير متوازنة)\nمثال: ابتسم بشكل مائل",
 "crookedness": "زَوَر, عِوَج (زَوَّرَ الطائرُ: أَكَلَ حتى امتلأَت حوصَلتُه وارتفعت؛ زَوَّرَ الشىءَ: أَصلَحَه وقوَّمَه وأَتقنه)",
 "crookes radiometer": "طاحونة ضوئية, مقياس إشعاع كروكس (مقياس إشعاع كهرومغناطيسي يتكون من عجلة صغيرة تدور عند وضعها في ضوء النهار)",
 "crookes tube": "أنبوب كروكس (أنبوب أشعة الكاثود الأصلي ذو التفريغ الغازي)",
 "crookneck": "قرع معقوف (قرع أصفر ذو عنق منحني رفيع وقشرة ثؤلولية إلى حد ما)",
 "crookneck squash": "قرع معقوف (قرع أصفر ذو عنق منحني رفيع وقشرة ثؤلولية إلى حد ما)",
 "crooner": "مغني بالاد (مغنٍ للأغاني العاطفية الشعبية الهادئة)",
 "crooning": "دندنة عاطفية, غناء هامس (فعل غناء الأغاني الشعبية بطريقة عاطفية) / دندنة, همهمة (الغناء بنبرة منخفضة ناعمة)\nمثال: دندنتها سرعان ما جعلت الطفل ينام",
 "crop": "مَحْصُول / حَوْصَلة",
 "crop failure": "فشل المحصول (فشل المحاصيل في إنتاج فائض قابل للتسويق)",
 "crop rotation": "دَوْرَة زِرَاعِيَّة (في غرب العراق على نهر الفرات قرب الحدود السورية؛ حَيّ في جنوب بغداد تقع فيه محطة تكرير للنفط تسمّى بإسمه)\nمثال: خضع زيد لدورة مكثفة",
 "crop-dusting": "رش المحاصيل (نثر مبيدات الفطريات أو الحشرات أو الأسمدة على المحاصيل النامية (غالباً من طائرة تحلق على ارتفاع منخفض))",
 "cropped": "مَزْرُوع بِالمَحَاصِيل ((عن الأرض) مستخدم لزراعة المحاصيل)",
 "cropper": "مزارع بالمحاصصة (صغار المزارعين والمستأجرين)",
 "croquet": "كروكيت (لعبة يضرب فيها اللاعبون كرة خشبية عبر سلسلة من الأطواق؛ والفائز هو أول من يجتاز جميع الأطواق ويضرب وتداً)",
 "croquet ball": "كرة الكروكيت (كرة خشبية تستخدم في لعب الكروكيت)",
 "croquet equipment": "معدات الكروكيت (معدات رياضية تستخدم في لعب الكروكيت)",
 "croquet mallet": "مطرقة الكروكيت (مطرقة تستخدم لضرب الكرة في لعبة الكروكيت)",
 "croquette": "كروكيت (لحوم مطبوخة مفرومة (أو خضروات) في صلصة بيضاء كثيفة؛ تغطى بالبقسماط وتقلى في زيت غزير)",
 "crore": "عَشَرَة مَلَايِين, كُرُور (العدد الذي يمثله واحد متبوعاً بـ 7 أصفار)",
 "crosier": "عَصًا (ما يتخذ من خَشَب للتوكؤ أو الضرب؛ تطلق مجازا على عَظْم السَاق وعلى اللِسَان)\nمثال: لا تمسك العصا من الوسط.",
 "cross": "صَلِيب / عَبْر, خِلَال (الشيء: اجتازه وقطعه من طرف إلى الطرف الآخر كاملا؛ الشخص: مات) / عَبَرَ (الشيء: اجتازه وقطعه من طرف إلى الطرف الآخر كاملا؛ الشخص: مات)\nمثال: عبر جرذ الطريق.",
 "cross bit": "ريشة صليبية (مثقاب صخري له حواف قطع صليبية الشكل؛ يستخدم في التعدين)",
 "cross bun": "كعكة الصليب الساخنة (لفافة مخمرة حلوة باعتدال تحتوي على توابل وزبيب وأترج ومزينة بطبقة سكرية على شكل صليب)",
 "cross country": "اختراق الضاحية (سباق طويل يجري عبر الأراضي المفتوحة)",
 "cross dressing": "تخنث, لبيسة الجنس الآخر (ممارسة اعتماد ملابس أو أسلوب أو الدور الجنسي للجنس الآخر)",
 "cross hair": "خطوط متقاطعة, شعيرات التصويب (أي من خطين رفيعين متعامدين يتقاطعان في مستوى بؤرة أداة بصرية ويستخدمان للتصويب أو المعايرة)\nمثال: كان الهدف في مرمى شعيرات التصويب الخاصة به",
 "cross infection": "عدوى المستشفيات, عدوى متقاطعة (عدوى يتم اكتسابها في مستشفى أو منشأة رعاية صحية أخرى)",
 "cross of calvary": "صليب الجلجثة (صليب لاتيني موضوع على ثلاث درجات)",
 "cross of lorraine": "صليب لورين (صليب بعارضتين، واحدة فوق وأخرى تحت نقطة منتصف العمودي، والسفلى أطول من العليا)",
 "cross oneself": "صَلَّبَ (قوي وصلب الملمس، لا ينحني بسهولة؛ متماسك وثابت، غير قابل للتغيير أو الانكسار)\nمثال: هذا التخت جدا صلب.",
 "cross out": "شَطَبَ ((شَطَبَ) عنه يَشْطُبُ شَطْبًا: عَدَلَ؛ شَطَبَ الأدِيمَ ونحْوَهُ: شقَّهُ)",
 "cross product": "جداء اتجاهي, ضرب اتجاهي (متجه هو نتاج متجهين آخرين)",
 "cross section": "المقطع العرضي ((فيزياء) احتمال حدوث تفاعل معين (مثل الأسر أو التأين) بين الجسيمات؛ يقاس بالبارن) / عينة تمثيلية, قطاع عرضي (عينة يقصد بها أن تكون ممثلة لمجتمع بأكمله) / مقطع عرضي (مقطع ناتج عن قطع مستوى لجسم صلب عمودياً على محوره الأطول)",
 "cross street": "شارع متقاطع (شارع يتقاطع مع شارع رئيسي (عادة بزوايا قائمة) ويستمر على كلا الجانبين منه)",
 "cross thwart": "عارضة القارب, مقعد القارب (قطعة عرضية تفصل بين جوانب القارب؛ تستخدم كمقعد في قارب التجديف)",
 "cross vine": "زهرة البوق, كرمة الصليب (كرمة خشبية مزهرة في جنوب الولايات المتحدة؛ تظهر السيقان صليباً في المقطع العرضي)",
 "cross wire": "خطوط متقاطعة, شعيرات التصويب (أي من خطين رفيعين متعامدين يتقاطعان في مستوى بؤرة أداة بصرية ويستخدمان للتصويب أو المعايرة)\nمثال: كان الهدف في مرمى شعيرات التصويب الخاصة به",
 "cross-banded": "مُتَقَاطِع الأَشْرِطَة ((في الأفاعي) ذو أشرطة متقاطعة على الظهر)",
 "cross-classification": "تصنيف متقاطع (التصنيف وفقاً لأكثر من سمة في نفس الوقت)\nمثال: تم التصنيف المتقاطع للحالات حسب العمر والجنس",
 "cross-country": "عَبْر البِلَاد, عَبْر الرِّيف (عبر الريف) / اخْتِرَاقًا لِلضَّاحِيَة, عَبْر الحُقُول (عدم اتباع المسارات أو الطرق)\nمثال: النهر يجري عبر البلاد",
 "cross-country jumping": "اختراق الضاحية (ركوب الخيل عبر الريف فوق الحواجز لإظهار مهارات الفروسية)",
 "cross-country riding": "اختراق الضاحية (ركوب الخيل عبر الريف فوق الحواجز لإظهار مهارات الفروسية)",
 "cross-country skiing": "تزلج اختراق الضاحية, تزلج ريفي (رياضة التزلج عبر الريف (بدلاً من المنحدرات))",
 "cross-cultural": "عبر الثقافات (يتعامل مع ثقافتين أو أكثر أو يقارن بينهما)\nمثال: مسح عبر الثقافات",
 "cross-division": "تصنيف متقاطع (التصنيف وفقاً لأكثر من سمة في نفس الوقت)\nمثال: تم التصنيف المتقاطع للحالات حسب العمر والجنس",
 "cross-dresser": "لابس لملابس الجنس الآخر (شخص يتبنى لباس أو أسلوب أو الدور الجنسي للجنس الآخر)",
 "cross-examination": "استجواب مضاد ((قانون) استجواب دقيق لشاهد معادٍ في محكمة قانونية لتشويه سمعته أو إلقاء ضوء جديد على الشهادة المقدمة بالفعل في الاستجواب المباشر)",
 "cross-examiner": "مستجوب (شخص يستجوب الشاهد بعناية (خاصة حول شهادة أُدلي بها سابقًا))",
 "cross-eye": "حول إنسي, حول داخلي (حول تتجه فيه إحدى العينين أو كلتيهما إلى الداخل نحو الأنف)",
 "cross-eyed": "أَحْوَل (أَحْوَلَ: مضى عليه حَوْلٌ؛ ويقال: أَحْوَلَ الصبيُّ: أتمَّ حولًا؛ أَحْوَلَ (الدارُ): تغيَّرت، وأتى عليها أحوالٌ (سنون))",
 "cross-fertilisation": "إثراء متبادل, تلاقح فكري (التبادل بين ثقافات مختلفة أو طرق تفكير مختلفة بشكل مثمر ومفيد للطرفين) / إخصاب خلطي (إخصاب عن طريق اتحاد الأمشاج الذكرية والأنثوية من فردين مختلفين من نفس النوع)\nمثال: الإثراء المتبادل بين العلم والفنون الإبداعية",
 "cross-fertilization": "إثراء متبادل, تلاقح فكري (التبادل بين ثقافات مختلفة أو طرق تفكير مختلفة بشكل مثمر ومفيد للطرفين) / إخصاب خلطي (إخصاب عن طريق اتحاد الأمشاج الذكرية والأنثوية من فردين مختلفين من نفس النوع)\nمثال: الإثراء المتبادل بين العلم والفنون الإبداعية",
 "cross-grained": "مُتَعَرِّج الأَلْيَاف (عن الخشب؛ ذو ألياف تجري بشكل غير منتظم بدلاً من التوازي) / مُعَارِض, مُنَاقِض (يتسم بالمعارضة الذاتية والممانعة المقصودة)",
 "cross-index": "إحالة مرجعية (إشارة في مكان واحد في عمل ما إلى معلومات في مكان آخر في نفس العمل)",
 "cross-leaved heath": "خلنج متصالب الأوراق (شجيرة أوروبية قزمة بزهور وردية اللون)",
 "cross-legged": "بِسَاقَيْن مُتَصَالِبَتَيْن, مُتَرَبِّعًا (مع تقاطع الساقين)\nمثال: جلس على الأرض متربعاً وتأمل",
 "cross-linguistic": "عبر لغوي, مشترك بين اللغات (متعلق بلغات مختلفة)\nمثال: أدلة عبر لغوية",
 "cross-linguistically": "بمقارنة اللغات, عبر اللغات (عن طريق مقارنة اللغات)\nمثال: درست الظاهرة عبر اللغات",
 "cross-link": "تشابك, رابطة مستعرضة (رابطة جانبية تربط سلسلتين متجاورتين من الذرات في جزيء معقد)",
 "cross-linkage": "تشابك, رابطة مستعرضة (رابطة جانبية تربط سلسلتين متجاورتين من الذرات في جزيء معقد)",
 "cross-modal": "عابر للوسائط (يتعلق بوسائط حسية مختلفة)",
 "cross-ply": "متعامد الطبقات (من أو متعلق بنوع قديم من إطارات السيارات له مداس مرن وجوانب صلبة نسبياً)",
 "cross-pollinating": "مُلقِح خلطياً (من أو متعلق بـ أو من خصائص التلقيح الخلطي)",
 "cross-pollination": "تبادل التأثير, تلاقح الأفكار (تأثير محفز بين عناصر متنوعة) / تلقيح خلطي (إخصاب عن طريق نقل حبوب اللقاح من مئبر زهرة إلى ميسم زهرة أخرى)\nمثال: تلاقح الفنون",
 "cross-purpose": "تضارب الأهداف, غرض متعارض (هدف معاكس أو متضارب)\nمثال: أهداف متضاربة",
 "cross-question": "استجواب مضاد (سؤال يُطرح في الاستجواب المضاد)",
 "cross-questioner": "مستجوب (شخص يستجوب الشاهد بعناية (خاصة حول شهادة أُدلي بها سابقًا))",
 "cross-reference": "إحالة مرجعية (إشارة في مكان واحد في عمل ما إلى معلومات في مكان آخر في نفس العمل)",
 "cross-sectional": "مَقْطَعِيّ (يُمَثِّل مُسْتَوًى ناتِجًا عَن القَطْع عَرْضِيًّا بِزاوِيَة قائِمَة) / عرضي, مقطعي (من أو يتعلق بمقطع عرضي)\nمثال: شريحة مقطعية",
 "cross-sentential": "عبر الجمل (من أو يتعلق بالعلاقات بين الجمل)",
 "cross-shaped": "صَلِيبِيّ الشَّكْل (على شكل صليب)",
 "cross-stitch": "تطريز متقاطع, غرزة إكس (تطريز يتم بأزواج من الغرز تتقاطع مع بعضها البعض) / غرزة إكس, غرزة متقاطعة",
 "cross-town": "عَابِرٌ لِلْمَدِينَةِ (يمتد أو يعبر مدينة أو بلدة)",
 "crossbar": "عَارِضَة",
 "crossbeam": "جائز مستعرض, عارضة مستعرضة (عارضة أفقية تمتد عبر شيء ما)",
 "crossbench": "مقعد محايد (أي من المقاعد في مجلس العموم التي يستخدمها الأعضاء الذين لا يصوتون بانتظام مع الحكومة أو المعارضة)",
 "crossbencher": "نائب مستقل (عضو في مجلس العموم لا يصوت بانتظام مع الحكومة أو المعارضة)",
 "crossbill": "قرزبيل, مصلب المنقار (عصفور ذو منقار تتقاطع أطرافه عند إغلاقه)",
 "crossbones": "عظمتان متقاطعتان (عظمتان متقاطعتان (أو تمثيل لهما) تستخدم كرمز للخطر أو الموت)",
 "crossbow": "قَوْس إفْرَنْجِيَّة",
 "crossbred": "مهجن, هجين (نتاج تزاوج من أبوين من أصناف أو أنواع مختلفة)",
 "crossbreed": "هجين ((في علم الوراثة) كائن حي هو نسل أبوين أو سلالة غير متماثلة وراثياً؛ خاصة النسل الناتج عن تزاوج نباتات أو حيوانات من أصناف أو سلالات أو أنواع مختلفة)\nمثال: البغل هو هجين بين حصان وحمار",
 "crossbreeding": "تزاوج بين الأعراق (التكاثر بين أبوين من أعراق مختلفة) / تزاوج خلطي, تهجين ((في الوراثة) فعل خلط أنواع أو أصناف مختلفة من الحيوانات أو النباتات لإنتاج هجائن)",
 "crosscheck": "إعاقة بالعصا (إعاقة غير قانونية (الضرب على ذراعي أو عصا الخصم)) / تحقق متبادل, فحص تقاطعي (حالة من تأكيد شيء ما من خلال النظر في المعلومات من عدة مصادر)",
 "crosscurrent": "تَيَّار مُعَاكِس (أفعال معاكسة لنشاط المجموعة الرئيسي) / تيار ساحب, تيار عنيف (امتداد من المياه المضطربة في نهر أو في البحر ناتج عن تدفق تيار في تيار آخر أو عبره)\nمثال: عطلت التيارات السياسية المعاكسة المؤتمر",
 "crosscut": "اختصار, طريق مختصر (طريق أقصر من الطريق المعتاد) / طريق مختصر, قطع عرضي (مسار قطري)",
 "crosscut handsaw": "منشار قطع عرضي (منشار يدوي يقطع بزاوية قائمة مع اتجاه الألياف (أو المحور الرئيسي))",
 "crosscut saw": "منشار قطع عرضي (منشار يدوي يقطع بزاوية قائمة مع اتجاه الألياف (أو المحور الرئيسي))",
 "crosse": "مضرب اللاكروس (مضرب طويل بإطار مثلث؛ يستخدم في لعب اللاكروس)",
 "crossed": "متقاطع, معقود (موضوع بشكل متقاطع) / مسطر ((عن الشيك) معلم للإيداع فقط من خلال رسم خطين عبره)\nمثال: تحدث بوجه جاد ولكن بأصابع معقودة (إشارة للكذب)",
 "crossed eye": "حول إنسي, حول داخلي (حول تتجه فيه إحدى العينين أو كلتيهما إلى الداخل نحو الأنف)",
 "crossfire": "نيران متقاطعة (نيران من نقطتين أو أكثر بحيث تتقاطع خطوط النار) / تبادل سريع, تراشق (تبادل حيوي أو ساخن للأفكار والآراء)",
 "crosshairs": "دائرة الاستهداف, مرمى النظر (مركز للاهتمام)\nمثال: الحرب على الإرهاب وضعت صدام حسين في دائرة الاستهداف",
 "crosshatch": "تهشير (تظليل يتكون من خطوط متقاطعة متعددة)",
 "crosshatched": "مُظَلَّل بِالتَّهْشِير (مُظَلَّل بِوَاسِطَة خُطُوط مُتَوَازِيَة أَوْ مُتَقَاطِعَة دَقِيقَة)",
 "crosshead": "رأس الصليب (كتلة معدنية تتصل بمكبس؛ تنزلق على أدلة متوازية وتحرك قضيب التوصيل ذهاباً وإياباً) / عنوان داخلي, عنوان فرعي (عنوان لقسم فرعي مطبوع داخل جسم النص)",
 "crossheading": "عنوان داخلي, عنوان فرعي (عنوان لقسم فرعي مطبوع داخل جسم النص)",
 "crossing": "مَعْبَر (مكان العُبُور؛ مَعْبَر رَفَح: نقطة العبور الحدودية بين أراضي قطاع غَزَّة ومِصْر يقع عند مدينة رَفَح في غزة)",
 "crossing guard": "حارِس عُبُور (شخص يساعد الناس (خاصة الأطفال) عند معبر المرور)",
 "crossing over": "تصالب, عبور (تبادل الأجزاء بين الكروموسومات المتماثلة المقترنة أثناء الطور الأول من الانقسام المنصف)",
 "crossjack": "الشراع السفلي للصارية الخلفية (أدنى شراع على الصارية الخلفية)",
 "crossly": "بِتَجَهُّم, بِحِدَّة (بطريقة سيئة المزاج)\nمثال: نظرت إلى زوجها بحدة",
 "crossness": "تجهم, حدة الطبع (الميل لأن يكون المرء سيء المزاج) / تهيج, سرعة الغضب (شعور بالتهيج والنزق)",
 "crossopterygian": "أسماك عظمية, مفصصات الزعانف (أي سمكة من رتبة مفصصات الزعانف؛ معظمها معروف فقط في شكل أحفوري)",
 "crossover": "معبر, ممر عبور (مسار (غالباً ما يكون محدداً) حيث يمكن عبور شيء ما (مثل شارع أو سكة حديد) للوصول من جانب إلى آخر) / أسلوب كروس أوفر, دمج الأنواع (تبني أسلوب جديد (خاصة في الموسيقى الشعبية) من خلال الجمع بين عناصر من أنواع مختلفة لجذب جمهور أوسع) / ناخب متجاوز للحزب (ناخب مسجل كعضو في حزب سياسي ولكنه يصوت في الانتخابات التمهيدية لحزب آخر) / تصالب, عبور (تبادل الأجزاء بين الكروموسومات المتماثلة المقترنة أثناء الطور الأول من الانقسام المنصف)\nمثال: ألبوم يجمع بين الجاز والموسيقى الكلاسيكية",
 "crossover voter": "ناخب متجاوز للحزب (ناخب مسجل كعضو في حزب سياسي ولكنه يصوت في الانتخابات التمهيدية لحزب آخر)",
 "crosspatch": "سيء المزاج, عبوس (شخص سيء الطباع)",
 "crosspiece": "عارضة, قطعة عرضية (دعامة مستعرضة) / جائز مستعرض, عارضة مستعرضة (عارضة أفقية تمتد عبر شيء ما)",
 "crossroad": "تقاطع (نقطة التقاء حيث يعبر شارع أو طريق شارعاً آخر)",
 "crossroads": "مُفْتَرَق, تَقَاطُع",
 "crosstalk": "تداخل الإشارات (وجود إشارة غير مرغوب فيها عبر اقتران عرضي)",
 "crosstie": "عارضة السكة الحديدية, فلنكة (واحدة من الدعامات العرضية التي تدعم القضبان على مسار السكك الحديدية)",
 "crosstown": "عَبْر المَدِينَة (عبر بلدة أو مدينة) / عَابِرٌ لِلْمَدِينَةِ (يمتد أو يعبر مدينة أو بلدة)\nمثال: سافر عبر المدينة",
 "crosswalk": "معبر, ممر عبور (مسار (غالباً ما يكون محدداً) حيث يمكن عبور شيء ما (مثل شارع أو سكة حديد) للوصول من جانب إلى آخر)",
 "crossway": "تقاطع (نقطة التقاء حيث يعبر شارع أو طريق شارعاً آخر)",
 "crossways": "عَرْضِيًّا, مُسْتَعْرِضًا (بشكل مستعرض)\nمثال: تم قطع ألواح الرخام بشكل عرضي",
 "crosswind": "رياح جانبية (رياح تهب عبر مسار سفينة أو طائرة)",
 "crosswise": "عَرْضِيًّا, مُسْتَعْرِضًا (بشكل مستعرض) / بِشَكْل مُعَاكِس, عَلَى نَحْو مُخَالِف (ليس بالطريقة المقصودة) / صَلِيبِيّ, مُتَقَاطِع (على شكل صليب أو قطعة أفقيَّة منه) / عرضي (يقع أو يمتد عبر طول الشيء أو في اتجاه متقاطع)\nمثال: تم قطع ألواح الرخام بشكل عرضي",
 "crossword": "كَلِمَات مُتَقَاطِعَة",
 "crossword puzzle": "كلمات متقاطعة (لغز يتم فيه إيجاد كلمات تتوافق مع تلميحات مرقمة وكتابتها في مربعات اللغز)",
 "crotal": "كروتل (أي من عدة أشنات من جنس بارميليا تصنع منها أصباغ بنية محمرة أو أرجوانية)",
 "crotalaria": "جلاجلاء, كروتالاريا",
 "crotalaria sagitallis": "صندوق الخشخشة الأمريكي (عشبة حولية استوائية أمريكية ذات قرن منتفخ تخشخش فيه البذور الناضجة)",
 "crotalaria spectabilis": "صندوق الخشخشة الهندي (شجيرة فرعية منتصبة ذات أزهار مشوبة بالأرجواني وقرن منتفخ تخشخش فيه البذور الناضجة؛ الهند)",
 "crotalus adamanteus": "أفعى جرسية ماسية الظهر (أفعى جرسية كبيرة قاتلة ذات علامات ماسية الشكل)",
 "crotalus atrox": "أفعى جرسية ماسية الظهر الغربية (أكبر وأخطر ثعبان في أمريكا الشمالية؛ يعيش في جنوب غرب الولايات المتحدة والمكسيك)",
 "crotalus cerastes": "أفعى جانبية الحركة, أفعى مقرنة",
 "crotalus horridus atricaudatus": "أفعى جرسية خشبية جنوبية (صنف جنوبي من الأفعى الجرسية الخشبية)",
 "crotalus horridus horridus": "أفعى جرسية خشبية (واسعة الانتشار في الأراضي الوعرة بشرق الولايات المتحدة)",
 "crotalus lepidus": "أفعى جرسية صخرية (تعيش في صخور الجبال في المكسيك ومعظم الأجزاء الجنوبية من جنوب غرب الولايات المتحدة)",
 "crotalus mitchellii": "أفعى جرسية مرقطة (تختلف علاماتها ولكنها عادة ما تنسجم مع الخلفية؛ تعيش في جنوب غرب أريزونا وباجا كاليفورنيا)",
 "crotalus scutulatus": "أفعى موهافي الجرسية (خطيرة للغاية؛ أكثر شيوعاً في مناطق النمو الشجيري المتناثر؛ من صحراء موهافي إلى غرب تكساس وإلى المكسيك)",
 "crotalus tigris": "أفعى جرسية ببرية (ظهرها مخطط بشكل غير منتظم؛ تعيش في التلال القاحلة والأخاديد في جنوب أريزونا والمكسيك)",
 "crotalus viridis": "أفعى جرسية البراري (واسعة الانتشار بين المسيسيبي وجبال روكي)",
 "crotaphion": "صدغية (طرف الجناح الكبير للعظم الوتدي)",
 "crotch": "أعضاء تناسلية, أعضاء جنسية (عضو جنسي خارجي) / مفرق الساقين, منشعب (الزاوية التي تشكلها الجوانب الداخلية للساقين حيث تلتقي بجذع الإنسان) / شعبة, مفترق (منطقة الزاوية المتكونة من تقاطع فرعين)\nمثال: أخذوا المفترق الجنوبي",
 "crotch hair": "شَعْرُ العَانَة (شعر ينمو في منطقة العانة)",
 "crotchet": "خُطَّاف صغير, شص (أداة صغيرة أو أداة تشبه الخطاف) / شُذُوذ, غَرَابَة (موقف أو عادة غريبة) / سوداء, نوتة ربعية (نوتة موسيقية لها قيمة زمنية تعادل ربع نوتة كاملة) / خطاف, شكل خطافي (منحنى حاد؛ شكل يشبه الخطاف)",
 "crotchetiness": "تذمر, غراشة (طبع صعب الإرضاء وغريب الأطوار)",
 "crotchety": "عَنِيد, مُشَاكِس (صعب المعاملة وذو طبع مُعانِد)",
 "croton": "حب الملوك, كروتون (شجيرة آسيوية استوائية؛ مصدر زيت الكروتون) / كروتون, كوديايوم (يزرع في العديد من الأصناف لأوراقه زاهية الألوان؛ يزرع على نطاق واسع كنبات منزلي)",
 "croton bug": "صرصور ألماني (صرصور صغير بني فاتح جلب إلى الولايات المتحدة من أوروبا؛ آفة منزلية شائعة)",
 "croton eluteria": "كاسكاريلا, كروتون (شجيرة في جزر الهند الغربية ذات لحاء عطري)",
 "croton oil": "زيت كروتون (زيت لزج أصفر مائل للبني من بذور كروتون تيغليوم له تأثير مسهل عنيف)",
 "croton tiglium": "حب الملوك, كروتون (شجيرة آسيوية استوائية؛ مصدر زيت الكروتون)",
 "crotonbug": "صرصور ألماني (صرصور صغير بني فاتح جلب إلى الولايات المتحدة من أوروبا؛ آفة منزلية شائعة)",
 "crottal": "كروتل (أي من عدة أشنات من جنس بارميليا تصنع منها أصباغ بنية محمرة أو أرجوانية)",
 "crottle": "كروتل (أي من عدة أشنات من جنس بارميليا تصنع منها أصباغ بنية محمرة أو أرجوانية)",
 "crouch": "انحناء, جثوم (عملية الانحناء المنخفض مع ضم الأطراف للجسم)",
 "crouch start": "انطلاق من وضع القرفصاء (وضع انطلاق منخفض في الجري التنافسي، يستخدم عموماً في سباقات السرعة للمسافات القصيرة)",
 "croup": "ردف, كفل (جزء الحيوان الذي يقابل الأرداف البشرية) / التهاب الحنجرة التشنجي, الخانوق (مرض يصيب الرضع والأطفال الصغار؛ سعال حاد وبحة في الصوت وحمى وصعوبة في التنفس)",
 "croupe": "ردف, كفل (جزء الحيوان الذي يقابل الأرداف البشرية)",
 "croupier": "كروبيير, مدير مائدة القمار (شخص يجمع ويدفع الرهانات على طاولة القمار)",
 "croupier's rake": "مجرفة الموزع (مجرفة صغيرة يستخدمها الموزع (الكروبيير) لتحريك الرقائق على الطاولة)",
 "croupy": "خانوقي (يشبه أو ينشأ عن أو يشير إلى الخانوق (مرض تنفسي))",
 "crouton": "خبز محمص, كروتون (قطعة صغيرة من الخبز المحمص أو المقلي؛ تقدم في الحساء أو السلطات)",
 "crow": "غُرَاب, زَاغ / صَاحَ (صاتَ بأقصى طاقته وأعلى صوته، يستخدم للحيّ ولا يقال صاح للجماد؛ عليه: ناداه)\nمثال: سأساعدك يا صاح.",
 "crow blackbird": "سوادية (شحرور أمريكي طويل الذيل ذو ريش أسود قزحي الألوان)",
 "crow corn": "جذر المغص, عشبة النجمة (أي من النباتات المعمرة العديدة من جنس ألتريس ذات أوراق تشبه العشب وجذور مرة تشتهر بعلاج المغص)",
 "crow garlic": "ثوم الكرمة, ثوم بري (بصل بري لاذع من العالم القديم)",
 "crow language": "لغة كرو (لغة سيووية يتحدث بها شعب كرو)",
 "crow nation": "كرو (فرد من الشعب السيوي الذي عاش سابقاً في شرق مونتانا)",
 "crow pheasant": "كوكال صيني (كوكال شائع في الهند والصين)",
 "crow step": "درجة الطنف, درجة جملونية ((في العمارة) درجة على قمة جدار الجملون)",
 "crow's feet": "تجاعيد الضحك, قدم الغراب (تجعد في الجلد عند الزاوية الخارجية للعينين)",
 "crow's foot": "زان أحمر, هريتييرا ثلاثية الأوراق (شجرة كبيرة من أسترالاسيا) / تجاعيد الضحك, قدم الغراب (تجعد في الجلد عند الزاوية الخارجية للعينين)",
 "crow's nest": "عش الغراب (منصة للمراقبة عند أو بالقرب من قمة الصاري)",
 "crow-bait": "طعم الغربان (حصان هزيل من المحتمل أن يصبح جيفة قريباً وبالتالي يجذب الغربان)",
 "crow-sized": "بِحَجْمِ الْغُرَابِ (بحجم غراب تقريبًا)",
 "crowbait": "طعم الغربان (حصان هزيل من المحتمل أن يصبح جيفة قريباً وبالتالي يجذب الغربان)",
 "crowbar": "عَتَلَة",
 "crowberry": "إمبتروم, توت الغراب (شجيرة دائمة الخضرة منخفضة بزهور أرجوانية صغيرة وثمار سوداء تشبه التوت)",
 "crowd": "كَوْم",
 "crowd control": "السيطرة على الحشود (نشاط السيطرة على حشد من الناس)",
 "crowded": "مُزْدَحِم",
 "crowdedness": "زِحَام, اِزْدِحَام",
 "crowdfunding": "تَمْوِيل الْجَمَاعِيّ",
 "crowding": "ازدحام, اكتظاظ (موقف يتجمع فيه الناس أو الأشياء معاً بازدحام)\nمثال: لم يعجبه الازدحام على الشاطئ",
 "crowdsourcing": "الاستعانة بالجماهير, تعهيد جماعي (عمل تقوم به مجموعة كبيرة من المستخدمين المجهولين)",
 "crowfoot": "حوذان, زهرة الزبدة",
 "crowfoot grass": "عشبة قدم الغراب, عشبة مصرية (عشبة زاحفة بسنابل تشبه الأصابع)",
 "crowing": "مُتَبَاهٍ, مُتَفَاخِر (يُظهِر أهمية ذاتية ويتباهى بنفسه) / تبجح, تفاخر (حالة من الحديث المتباهي)\nمثال: تبجحه أسوأ من قتاله",
 "crown": "تَاج, إِكْلِيل",
 "crown beard": "فيربيسينا, لحية التاج (أي نبات من جنس فيربيسينا ذو رؤوس زهور بيضاء أو صفراء عنقودية)",
 "crown colony": "مستعمرة التاج (مستعمرة بريطانية يسيطر عليها التاج البريطاني، يمثلها حاكم)",
 "crown daisy": "أقحوان تاجي (نبات سنوي شجيري في منطقة البحر الأبيض المتوسط بزهور بيضاء مصفرة)",
 "crown fire": "حريق التيجان (حريق غابات يتقدم بسرعة كبيرة قافزاً من قمة شجرة إلى أخرى متجاوزاً الحريق الأرضي)",
 "crown flower": "عُشَر (الثَلَاثُ العُشَر: الليلة العاشرة والحادية عشر والثانية عشر من كل شهر قمري…)\nمثال: لدي عشرة أقلام.",
 "crown gall": "تدرن التاج (مرض بكتيري يصيب النباتات (خاصة الفواكه ذات النواة والتفاحيات والعنب والورود) يشكل نتوءات على الساق بالقرب من الأرض)",
 "crown glass": "زجاج التاج البصري, زجاج كراون بصري (زجاج بصري ذو تشتت منخفض ومعامل انكسار منخفض) / زجاج الكراون, زجاج تاجي (زجاج يُنفخ على شكل كرة ثم يُسطح ويُدار لتشكيل قرص)",
 "crown imperial": "بوقية إمبراطورية, تاج الإمبراطور (عشبة أوراسية بكتلة من الأوراق وأزهار برتقالية حمراء على شكل جرس في أعلى الساق)",
 "crown jewel": "جوهرة التاج (حجر كريم يمثل جزءاً قيماً من شارات الملكية) / أصول ثمينة, درة التاج (الأصول الأكثر جاذبية للشركة)\nمثال: برزت أصولهم الثمينة (درة التاج) بشكل بارز في محاولة الاستحواذ",
 "crown jewels": "مجوهرات التاج (المجوهرات والشعارات الملكية التي يرتديها الملك في المناسبات الرسمية)",
 "crown land": "أرض التاج (الأرض التي يملكها التاج (الملكية))",
 "crown lens": "عدسة التاج (عدسة مصنوعة من زجاج التاج البصري)",
 "crown monkey": "مكاك القلنسوة (مكاك هندي ذو خصلة شعر تشبه القلنسوة)",
 "crown of thorns": "إكليل الشوك (تاج ساخر مصنوع من فروع الشوك وضعه الجنود الرومان على يسوع قبل الصلب) / إكليل الشوك, شوك المسيح (فربيون شجيري متسلق نوعاً ما في مدغشقر ذو سيقان شائكة خشبية طويلة مع القليل من الأوراق وزهور بقنابات قرمزية) / صليب (مجازي), عبء (أي بلاء يسبب معاناة كبيرة)\nمثال: هذا هو صليبه (عبؤه) الذي يجب أن يحمله",
 "crown prince": "وَلِيّ عَهْد (مَلَكَ الأمر وقَامَ به وسيطر عليه وولي عليه ولايةَ)\nمثال: ولي العهد هو من يرث العرش.",
 "crown princess": "ولية العهد (وريثة أنثى ظاهرة للعرش) / زوجة ولي العهد (زوجة ولي العهد)",
 "crown roast": "ريش ضأن, قفص صدري للضأن (شواء من منطقة الضلوع للضأن)",
 "crown saw": "منشار تاجي (منشار له أسنان حول حافة أسطوانة مجوفة)",
 "crown vetch": "إكليل البيقية, كورونيلا (عشب أوروبي يشبه البيقية؛ توطن في شرق الولايات المتحدة؛ له مظلات من الزهور الوردية والبيضاء وقرون حادة الزوايا)",
 "crown wart": "ثؤلول التاج (مرض فطري يصيب البرسيم يشكل نتوءات بيضاء عند قاعدة الساق)",
 "crown-beard": "فيربيسينا, لحية التاج (أي نبات من جنس فيربيسينا ذو رؤوس زهور بيضاء أو صفراء عنقودية)",
 "crown-of-the-field": "خرم الحنطة, زهرة الذرة (نبات حولي أوروبي له أزهار بوقية كبيرة حمراء أرجوانية وبذور سامة؛ عشب ضار شائع في حقول الحبوب وعلى جوانب الطرق؛ مستوطن في أمريكا)",
 "crown-of-thorns starfish": "نجم البحر المكلل بالشوك (طَلَعَ وظَهَرَ؛ نَجَمَ عن الأمر: أي ظهر نَتِيجَة عنه أو نَتَجَ عنه)\nمثال: سميت السفينة \"النجم الفضي\".",
 "crownbeard": "فيربيسينا, لحية التاج (أي نبات من جنس فيربيسينا ذو رؤوس زهور بيضاء أو صفراء عنقودية)",
 "crowned": "متوج, مكلل (مزود بتاج أو ما يشبه التاج أو تاج من نوع محدد؛ غالباً ما يستخدم في التركيبات اللفظية) / متوج, مكلل (لديه تاج (اصطناعي) على السن) / متوج بالغار, مكلل (متوج بالغار أو كما لو كان به كرمز للنصر)\nمثال: قبعة عالية القمة (التاج)",
 "crowned head": "عاهل, ملك (حاكم الأمة أو رئيس الدولة وعادة ما يكون بالحق الوراثي)",
 "crowning": "مُتَوِّج (يُشكِّل تاجًا أو قمة أو يوفرها)",
 "crownless": "بلا تاج, غير متوج (غير مزود (خاصة ليس بعد) بتاج)\nمثال: الملك غير المتوج",
 "crownwork": "تاج, تلبيسة ((طب الأسنان) جهاز سني يتكون من تاج صناعي لسن مكسور أو مسوس) / تحصين تاجي (نوع من التحصين، يشبه التحصين القرني، لكنه يتكون من حصن كامل مع جدران على كلا الجانبين تنتهي بأنصاف حصون تمتد منها جدران جانبية أطول تعود نحو القلعة…)\nمثال: غداً سيقوم طبيب الأسنان بتركيب تاج لي",
 "crozier": "عصا الأسقف (عصا يعلوها خطاف أو صليب يحملها الأساقفة كرمز للوظيفة الرعوية)",
 "crp": "بروتين سي التفاعلي (منتج ثانوي للالتهاب؛ غلوبولين يوجد في الدم في بعض حالات الالتهاب الحاد)",
 "crt": "أنبوب أشعة الكاثود (أنبوب مفرغ يبعث فيه كاثود ساخن شعاعاً من الإلكترونات يمر عبر أنود عالي الجهد ويتم تركيزه أو انحرافه قبل أن يضرب شاشة فسفورية)",
 "crt screen": "شاشة, شاشة أنبوب أشعة الكاثود (العرض الذي يتم إنشاؤه إلكترونياً على سطح الطرف الكبير لأنبوب أشعة الكاثود)",
 "crucial": "حَاسِم",
 "cruciality": "حرج, خطورة (حالة من الإلحاح الحرج)",
 "crucially": "بِشَكْل جَوْهَرِيّ, بِشَكْل حَاسِم (بدرجة حاسمة)\nمثال: مهم بشكل حاسم",
 "crucian carp": "شبوط كروشي (شبوط أوروبي يشبه إلى حد كبير السمكة الذهبية البرية)",
 "cruciate": "صَلِيبِيّ الشَّكْل (على شكل صليب)",
 "crucible": "بُوتَقة / مِحْنَة, اِخْتِبَار قَاسٍ",
 "crucible furnace": "فرن البوتقة (فرن لتسخين شحنة المعدن الموجودة في بوتقات حرارية)",
 "crucible steel": "فولاذ البوتقة (فولاذ يُصنع بخلط الحديد المطاوع المنصهر والفحم ومواد أخرى في بوتقة)",
 "crucifer": "صليبيات, نبات صليبي (أي من النباتات المتنوعة من الفصيلة الصليبية (الكرنبية))",
 "cruciferous": "صليبي (من أو يتعلق بالفصيلة الصليبية من النباتات)",
 "cruciferous plant": "صليبيات, نبات صليبي (أي من النباتات المتنوعة من الفصيلة الصليبية (الكرنبية))",
 "cruciferous vegetable": "خضراوات صليبية (خضار من عائلة الخردل: خاصة أوراق الخردل، والملفوف بأنواعه، والبروكلي، والقرنبيط، وكرنب بروكسل)",
 "crucified": "مَصْلُوب",
 "crucifix": "وضعية الصليب (تمرين جمباز يُؤدى على الحلقات عندما يدعم لاعب الجمباز نفسه بذراعين ممدودتين أفقياً) / الصليب المصلوب, الصليب المقدس (تمثيل للصليب الذي مات عليه يسوع)",
 "crucifix fish": "سمكة الصليب (سلور بحري في منطقة البحر الكاريبي)",
 "crucifixion": "صَلْب (قوي وصلب الملمس، لا ينحني بسهولة؛ متماسك وثابت، غير قابل للتغيير أو الانكسار)\nمثال: هذا التخت جدا صلب.",
 "cruciform": "صَلِيبِيّ",
 "crucify": "صَلَبَ, صَلَّبَ (قوي وصلب الملمس، لا ينحني بسهولة؛ متماسك وثابت، غير قابل للتغيير أو الانكسار)\nمثال: هذا التخت جدا صلب.",
 "crud": "وعكة (علة جسدية غير محددة) / قذارة, وسخ (أي مادة تعتبر كريهة أو غير سارة بشكل مقزز) / ثلج رطب ثقيل (ثلج رطب ثقيل غير مناسب للتزلج)",
 "cruddy": "بَذِيء, سَافِل (يتّسم بالفحش وخدش الحياء)",
 "crude": "خَامّ (وَخُمَ أو وَبِئَ؛ أقام في المكان أو استقر فيه)\nمثال: تنقل السفن المواد الخام من أندونيسيا.",
 "crude oil": "نَفْطٌ خَامٌ (سَائِل أسود قابل للاحتراق يوجد في باطن الأرض تستخدم مشتقاته كوقود وفي الصناعة. يعتبر حاليا أهم مصادر الطاقة في العالم)\nمثال: أعمل لدى شركة نفط.",
 "crudely": "بخشونة, بشكل فج (بطريقة فجة أو غير مهذبة) / بِفَجَاجَة, دُونَ مَهَارَة (بطريقة فجة وغير ماهرة)\nمثال: كان جريئاً بشكل فج",
 "crudeness": "بَدَائِيَّة, خُشُونَة (صفة غير مصقولة وغير مهذبة) / فجاجة, فظاظة (أسلوب غير مهذب مبتذل ويفتقر إلى اللباقة أو التهذيب) / بدائية, خشونة (حالة برية أو غير مهذبة)\nمثال: خشونة المساكن الحدودية أصابتها بالاكتئاب",
 "crudites": "خضروات نيئة, كرديتيه (خضروات نيئة مقطعة إلى شرائح صغيرة وتُقدم مع صلصة للتغميس)",
 "crudity": "فجاجة, فظاظة (أسلوب غير مهذب مبتذل ويفتقر إلى اللباقة أو التهذيب) / بدائية, خشونة (حالة برية أو غير مهذبة)\nمثال: اشتهرت المدينة بأكملها بفجاجتها",
 "cruel": "قَاسٍ, الْقَاسِي (شديد وصلب، غير لين؛ جافٍ أو يابس في الملمس أو التعامل)\nمثال: قاس طول السرير.",
 "cruel and unusual punishment": "عقوبة قاسية وغير عادية (عقوبة محظورة بموجب التعديل الثامن لدستور الولايات المتحدة؛ تشمل التعذيب أو الإهانة أو العقوبة الشديدة جداً مقارنة بالجريمة المرتكبة)",
 "cruel plant": "أروجا, نبات قاسي (شجيرة ملتفة قوية لها عناقيد من الزهور البيضاء أو الوردية العطرة ببتلات طرفية مسطحة منتشرة تحبس الفراشات الليلية وتمسك بها حتى الفجر)",
 "cruelly": "بِشِدَّة, بِقَسْوَة بَالِغَة (بشكل مفرط) / بِقَسْوَة, بِوَحْشِيَّة (مع القسوة)\nمثال: شتاء قارس بقسوة",
 "cruelness": "غلظة, قسوة (صفة القسوة والتسبب في التوتر أو الانزعاج)",
 "cruelty": "قَسْوَة, وَحْشِيَّة",
 "cruet": "قنينة مائدة (زجاجة تحفظ النبيذ أو الزيت أو الخل للمائدة)",
 "cruet-stand": "حامل قوارير التوابل (حامل للقوارير التي تحتوي على توابل مختلفة)",
 "cruise": "رِحْلَة بَحْرِيَّة",
 "cruise control": "مثبت السرعة (آلية تحكم للحفاظ على سرعة السيارة عند سرعة محددة)",
 "cruise liner": "سفينة سياحية (سفينة ركاب تستخدم تجارياً للرحلات الترفيهية)",
 "cruise missile": "صَارُوخ جَوَّال (سهم له ساق من قصب و في أحد طرفيه أنبوبة صغيرة من المقوى تحشى بارودا و لها فتيل من فتحتها السفلى فإذا أُشعل الفتيل و احتُرق ما في مُؤخرتها من بارود…؛ سلاح حربي، و رُبما استُخدم في أمور غير حربية، وهو كناية على اسطوانة ضخمة مخروطية الشكل، ذات جناحين صغيرين يثبتانها في خط مجراها…)\nمثال: هبط الصاروخ بدون مشاكل.",
 "cruise ship": "سَفِينَةٌ سِيَاحِيَّة (مَرْكَبٌ بَحْرِيٌّ لِنَقْلِ الْمُسَافِرِينَ وَالبَضَائِعِ)\nمثال: غادروا السفينة.",
 "cruiser": "طَرَّاد",
 "cruiserweight": "وزن الكروزر, وزن خفيف الثقيل (ملاكم محترف يتراوح وزنه بين 169 و 175 رطلاً) / وزن الكروزر, وزن ثقيل خفيف (فئة وزن في الرياضات القتالية، للمقاتلين الأثقل من فئة الوزن المتوسط وأخف من فئة الوزن الثقيل الفائق)",
 "cruller": "دونات ملتوية, كرولر (كعكة مقلية صغيرة تشكل في شرائط ملتوية وتقلى؛ أغنى من الدونات)",
 "crumb": "لُبّ",
 "crumb cake": "كعكة الفتات (كعكة أو كعكة قهوة مغطاة بخليط من السكر والزبدة والدقيق)",
 "crumbliness": "تفتت, قابلية التفتت (قابلية الكسر المفرطة)",
 "crumbly": "رِخْو, مُتَفَتِّت (يَسْهُلُ تَفَتُّتُهُ إِلَى قِطَعٍ صَغِيرَةٍ أَوْ تَحَوُّلُهُ إِلَى مَسْحُوق)",
 "crumhorn": "كروماهورن (آلة نفخ خشبية من عصر النهضة بقصبة مزدوجة وأنبوب منحني)",
 "crummy": "تَافِه, رَخِيص (رديء الجودة جدًا؛ هَشّ)",
 "crumpet": "كرامبيت (كعكة ناعمة سميكة ذات ملمس مسامي؛ تطهى على الصاج)",
 "crumpled": "مُجَعَّد, مُنْبَعِج (عن المعدن مثلاً؛ مُحنٍ أو مُنبعِج)",
 "crunch": "جَرَشَ (جَرَشَ الحَبَّ فِي المِهْرَازِ: طَحَنَهُ فُتَاتًا، طَحْنًا غَيْرَ نَاعِمٍ؛ جَرَشَ رَأْسَهُ بِالْمُشْطِ: حَكَّهُ حَكًّا شَدِيدًا حَتَّى أَثَارَ قِشْرَتَهُ، وَسَخَهُ) / قَرْمَشَة",
 "crupper": "ثَفَر, قُوش ((ثَفَّرَ) الدَّابَّة: سَاقهَا من خلفهَا)",
 "crural": "ساقي (من أو متعلق بالساق من الركبة إلى القدم)",
 "crus": "ساق (الجزء من الرجل بين الركبة والقدم)",
 "crusade": "حَمْلَة صَلِيبِيَّة / حَرْب صَلِيبِيَّة (حَرَبَ (حربه) بالحربة حربا: طعنه بها؛ حَرَبَ (ه) حربا: سلبه جميع ما يملك)\nمثال: بوتين مجرم حرب.",
 "crusader": "صليبي",
 "cruse": "جرة صغيرة, قنينة فخارية (جرة صغيرة؛ تحفظ السوائل (الزيت أو الماء))",
 "crush": "هَرَسَ (سَحَقَ أو دَكَّ شيئًا بقوة حتى يتفتت؛ طَحَنَ أو فَتَّتَ شيئًا)",
 "crush out": "أَطْفَأَ (أطفأ بالسحق أو الضغط)\nمثال: أطفئ سيجارتك الآن",
 "crushed": "مَكْسُور, مُذَلَّل (خاضع أو مُنزَل إلى حالة أو مكانة متدنّية) / مَهْرُوس, مُجَعَّد (مضغوط أو مجعّد السطح)",
 "crushed leather": "جلد مجعد (جلد تم إبراز نمط حبيباته)",
 "crushed rock": "حصى, صخر مكسر (شظايا صخرية وحصى)",
 "crusher": "ساحقة, كسارة (جهاز يقوم بسحق شيء ما)",
 "crushing": "سَاحِق, مُدَمِّر (مُدَمِّرٌ مَادِّيًّا أَوْ مَعْنَوِيًّا؛ يُسْتَخْدَمُ غَالِبًا فِي التَّرْكِيبَاتِ) / إخماد, قمع (منع بالقوة؛ القضاء على الشيء بالسلطة أو القوة)\nمثال: قمع الهرطقة",
 "crushingly": "بِسَحْق, بِشَكْل سَاحِق (بطريقة ساحقة)\nمثال: هُزم الفريق بشكل ساحق",
 "crust": "قِشْرَة",
 "crustacean": "قشريات (أي مفصلي مائي بشكل رئيسي له عادة جسم مقسم وهيكل خارجي كيتيني) / قشري (من أو ينتمي إلى طائفة القشريات)",
 "crustaceous": "قشري (كونه أو لديه أو يشبه قشرة صلبة أو صدفة) / قشري (من أو ينتمي إلى طائفة القشريات)",
 "crustal": "قشري (من أو متعلق بـ أو من خصائص قشرة الأرض أو القمر)",
 "crustal movement": "حركة تكتونية, حركة قشرية (حركة ناتجة عن تشوه القشرة الأرضية أو مسببة له)",
 "crustal plate": "صفيحة, صفيحة قشرية (طبقة صلبة من القشرة الأرضية يُعتقد أنها تنجرف ببطء)",
 "crusted": "ذُو قِشْرَة صُلْبَة, مُتَقَشِّر (ذو قشرة صلبة كغطاء)",
 "crustlike": "ذُو قِشْرَة صُلْبَة, مُتَقَشِّر (ذو قشرة صلبة كغطاء)",
 "crustose": "قشري ((للأشنيات) لها ثالوس قشري رقيق يلتصق بشدة بالسطح الذي ينمو عليه)\nمثال: أشنات قشرية",
 "crustose thallus": "مشرة قشرية (مشرة أشنة قشرية رقيقة؛ تلتصق بشكل وثيق بالسطح الذي تنمو عليه أو تكون مدمجة فيه)",
 "crusty": "جَافّ المُعَامَلَة, خَشِن (فظ وعابس ومُنفِّر في التعامل) / ذُو قِشْرَة صُلْبَة, مُتَقَشِّر (ذو قشرة صلبة كغطاء)",
 "crutch": "عُكَّاز, عُكَّازَة",
 "crux": "مَرْبِط الْفَرَس",
 "crux of the matter": "جَوْهَر الْمَوْضُوع, عُقْدَة الْمَسْأَلَة (النقطة الأكثر أهمية)",
 "cry": "بَكَى, عَيَّط (دَمَعَتْ عَيناهُ حزنا؛ بكى الْمَيِّت: رثاه) / صَاحَ (صاتَ بأقصى طاقته وأعلى صوته، يستخدم للحيّ ولا يقال صاح للجماد؛ عليه: ناداه) / بكاء\nمثال: بكى زيري كثيرا.",
 "cry over spilt milk": "لَا تَبْكِ عَلَى اَلْحَلِيب اَلْمَسْكُوب (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: لا أحب المدرسة.",
 "cry-baby tree": "سايبو, شجرة المرجان الشائعة (شجرة شائكة صغيرة من أمريكا الجنوبية بزهور قرمزية داكنة وقرمزية منفردة أو متجمعة)",
 "cryaesthesia": "حساسية للبرد, فرط حس البرودة (فرط الحساسية للبرد)",
 "crybaby": "بكاء, كثير الشكوى (شخص يميل إلى الشكوى المفرطة والبكاء والأنين) / جبان, ضعيف الشخصية (شخص يفتقر إلى الثقة، متردد وضعيف الإرادة)",
 "crybaby tree": "سايبو, شجرة المرجان الشائعة (شجرة شائكة صغيرة من أمريكا الجنوبية بزهور قرمزية داكنة وقرمزية منفردة أو متجمعة)",
 "cryesthesia": "حساسية للبرد, فرط حس البرودة (فرط الحساسية للبرد)",
 "crying": "بَاكٍ / بُكَاء",
 "cryoanaesthesia": "تخدير بالتبريد (فقدان الإحساس الناتج عن البرد)",
 "cryoanesthesia": "تخدير بالتبريد (فقدان الإحساس الناتج عن البرد)",
 "cryobiology": "علم الأحياء البردي (فرع علم الأحياء الذي يدرس تأثيرات درجات الحرارة المنخفضة على الأنسجة الحية أو الأعضاء أو الكائنات الحية)",
 "cryocautery": "كي بالتبريد (تطبيق مادة تدمر الأنسجة عن طريق تجميدها) / كاوي بالتبريد (أداة لتدمير الأنسجة عن طريق تجميدها)",
 "cryogen": "كرايوجين, مادة مبردة (سائل يغلي عند درجة حرارة أقل من -160 درجة مئوية ويستخدم كمبرد)",
 "cryogenic": "تجميدي, قري (من أو متعلق بدرجات الحرارة المنخفضة جداً)",
 "cryogenics": "علم فيزياء درجات الحرارة المتدنية, كرايوجينيك (فرع الفيزياء الذي يدرس الظواهر التي تحدث عند درجات حرارة منخفضة جداً)",
 "cryogeny": "علم فيزياء درجات الحرارة المتدنية, كرايوجينيك (فرع الفيزياء الذي يدرس الظواهر التي تحدث عند درجات حرارة منخفضة جداً)",
 "cryolite": "كريوليت (معدن أبيض يتكون من فلوريدات الألمنيوم والصوديوم؛ مصدر للفلور)",
 "cryometer": "مقياس البرودة (مقياس حرارة مصمم لقياس درجات الحرارة المنخفضة)",
 "cryonic": "تجميدي حيوي",
 "cryonics": "تجميد البشر, كريونيكس (تجميد شخص مريض بشكل خطير أو متوفى حديثاً لوقف تحلل الأنسجة؛ يتم الحفاظ على الجسم حتى يتم تطوير علاجات طبية جديدة قد تعيد الشخص إلى الحياة)\nمثال: تجميد البشر هو خيال علمي أكثر منه علم جاد",
 "cryopathy": "تثليج, قضمة الصقيع (تدمير الأنسجة عن طريق التجميد ويتميز بالوخز والتقرح وربما الغرغرينا)",
 "cryophobia": "رهاب البرد, رهاب التجمد (خوف مرضي من التجمد)",
 "cryoscope": "مقياس التجمد (أداة قياس لقياس نقاط التجمد والانصهار)",
 "cryostat": "كرايوستات, ناظم البرودة (منظم حرارة يعمل عند درجات حرارة منخفضة جداً)",
 "cryosurgery": "جراحة بالتبريد (استخدام البرودة الشديدة (عادة النيتروجين السائل) لتدمير الأنسجة غير المرغوب فيها (الثآليل أو إعتام عدسة العين أو سرطانات الجلد))",
 "cryotherapy": "عِلَاج بِالتَّبْرِيد",
 "crypt": "سرداب, قبو الدفن (قبو أو مدفن تحت الأرض (خاصة تحت الكنيسة))",
 "cryptacanthodes maculatus": "رايموث, سمكة الشبح (سمكة قاع أطلسية تشبه الثعبان ولها فم كبير عمودي تقريباً)",
 "cryptanalysis": "تحليل الشفرات, تشفير (علم تحليل وفك الشفرات والرموز والرسائل المشفرة)",
 "cryptanalyst": "خبير تعمية, محلل شفرات (مفكك رموز ماهر في تحليل الرموز والكتابات المشفرة)",
 "cryptanalytic": "تحليلي للشفرات, تشفيري (من أو متعلق بتحليل الشفرات)",
 "cryptanalytics": "تحليل الشفرات, تشفير (علم تحليل وفك الشفرات والرموز والرسائل المشفرة)",
 "cryptic": "مُبْهَم",
 "cryptic coloration": "تلوين تخفي (تلوين يخفي أو يطمس شكل الحيوان)",
 "cryptic crossword": "كلمات متقاطعة غامضة (ألغاز كلمات متقاطعة يكون فيها كل تلميح لغزاً لفظياً بحد ذاته)\nمثال: تحمل العديد من الصحف الكندية الكلمات المتقاطعة الغامضة",
 "cryptical": "رَمْزِيّ, قَبَّالِيّ (له معنى سرّي أو خفيّ) / سِرِّيّ, غَامِض (ذو طبيعة مُلتبِسة وعسيرة الفهم)",
 "cryptically": "بِإِبْهَام, بِشَكْل مُلْغِز (بطريقة غامضة)\nمثال: 'سنلتقي مرة أخرى'، قال بغموض",
 "crypto-jew": "يَهُودِيّ مُتَخَفّ (صفة المنسوب إلى اليَهُود، سواء كان شخصا أو شيئا أو فكرة أو غيره؛ معتنق الديانة اليهودية)\nمثال: أنا يهودي أمريكي.",
 "cryptobiosis": "حياة خفية, كمون حياتي (حالة تتوقف فيها الأنشطة الأيضية للحيوان بشكل قابل للعكس)",
 "cryptobiotic": "كموني حيوي (من أو متعلق بحالة الكمون الحيوي (الحياة الخفية))",
 "cryptobranchus alleganiensis": "سمندل الجحيم (سمندل كبير من أنهار وجداول أمريكا الشمالية)",
 "cryptococcosis": "داء المستخفيات (عدوى فطرية تتميز بآفات عقدية - أولاً في الرئتين وتنتشر إلى الجهاز العصبي)",
 "cryptocoryne": "بوق الماء, خفي الكربلة (فَسَد؛ باق الرجل: كَذَب)\nمثال: كان سامي ينبه بالبوق.",
 "cryptocurrency": "عُمْلَة مُعَمَّاة, مُشَفَّرَة (أُجْرَة العَمَل؛ النُقُود عامة لأنها تعطى أجرة للعمل)\nمثال: دعونا نقلب العملة.",
 "cryptogam": "نبات لا بذري, نبات مخفي التكاثر (مجموعة تصنيفية كانت معتمدة سابقاً تشمل جميع النباتات اللازهرية واللابذرية التي تتكاثر عن طريق الأبواغ: السراخس، الحزازيات، الطحالب، الفطريات)",
 "cryptogamic": "لازهري (من أو متعلق بالنباتات اللازهرية)",
 "cryptogamous": "لازهري (من أو متعلق بالنباتات اللازهرية)",
 "cryptogram": "رسالة سرية, كتابة مشفرة (قطعة من الكتابة برمز أو شفرة)",
 "cryptogramma acrostichoides": "سرخس البقدونس الأمريكي (سرخس صخري في شمال أمريكا الشمالية ينمو في كتل ضخمة وله سعف يشبه البقدونس)",
 "cryptogramma crispa": "سرخس البقدونس الأوروبي, سرخس البقدونس الجبلي (سرخس في أوروبا وآسيا الصغرى بجذمور نحيل قصير وسعف أخضر زاهي كثيف يشبه البقدونس)",
 "cryptograph": "آلة تشفير, جهاز تشفير (جهاز لفك الرموز والشفرات) / رسالة سرية, كتابة مشفرة (قطعة من الكتابة برمز أو شفرة) / تشفير, كتابة مشفرة (طريقة سرية للكتابة)",
 "cryptographer": "خبير تعمية, محلل شفرات (مفكك رموز ماهر في تحليل الرموز والكتابات المشفرة)",
 "cryptographic": "تحليلي للشفرات, تشفيري (من أو متعلق بتحليل الشفرات)",
 "cryptographical": "تحليلي للشفرات, تشفيري (من أو متعلق بتحليل الشفرات)",
 "cryptographically": "بِالتَّشْفِير, تَشْفِيرِيًّا (بطريقة تشفيرية)",
 "cryptography": "تشفير, تعمية (فعل الكتابة برمز أو شفرة) / تحليل الشفرات, تشفير (علم تحليل وفك الشفرات والرموز والرسائل المشفرة)",
 "cryptologic": "تحليلي للشفرات, تشفيري (من أو متعلق بتحليل الشفرات)",
 "cryptological": "تحليلي للشفرات, تشفيري (من أو متعلق بتحليل الشفرات)",
 "cryptologist": "خبير تعمية, محلل شفرات (مفكك رموز ماهر في تحليل الرموز والكتابات المشفرة)",
 "cryptology": "تحليل الشفرات, تشفير (علم تحليل وفك الشفرات والرموز والرسائل المشفرة)",
 "cryptomeria japonica": "أرز ياباني, سوجي (شجرة دائمة الخضرة طويلة من اليابان والصين تنتج خشباً ناعماً قيماً)",
 "cryptomnesia": "استرجاع إبداعي",
 "cryptomonad": "خفية, كريبتوموناد (شائعة في المياه العذبة والمالحة تظهر على طول الشاطئ كازدهار طحلبي)",
 "cryptophyte": "خفية, كريبتوموناد (شائعة في المياه العذبة والمالحة تظهر على طول الشاطئ كازدهار طحلبي)",
 "cryptoprocta": "كريبتوبروكتا (لواحم بدائية كبيرة تشبه القطط تعيش في غابات مدغشقر)",
 "cryptoprocta ferox": "فوسا (أكبر آكل للحوم في مدغشقر؛ متوسط في بعض النواحي بين القطط والزباد)",
 "cryptorchidism": "اختفاء الخصية, الخصية الهاجرة (فشل إحدى الخصيتين أو كلتيهما في التحرك إلى كيس الصفن أثناء نمو الجنين الذكر)",
 "cryptorchidy": "اختفاء الخصية, الخصية الهاجرة (فشل إحدى الخصيتين أو كلتيهما في التحرك إلى كيس الصفن أثناء نمو الجنين الذكر)",
 "cryptorchism": "اختفاء الخصية, الخصية الهاجرة (فشل إحدى الخصيتين أو كلتيهما في التحرك إلى كيس الصفن أثناء نمو الجنين الذكر)",
 "cryptotermes brevis": "نمل أبيض مسحوقي (نمل أبيض مدمر للغاية للخشب الجاف في المناطق الدافئة)",
 "cryptotis parva": "زباب أصغر (زباب بني صغير من المناطق العشبية في شرق الولايات المتحدة)",
 "crystal": "قَرِيس, قَرِيت",
 "crystal ball": "كُرَة بِلَّوْرِيَّة",
 "crystal clear": "رَائِق, سَلِس (واضح وشفّاف في اللغة؛ سهل الفهم) / بِلَّوْرِيّ, رَائِق (ينقل الضوء ويمكن الرؤية من خلاله بوضوح)",
 "crystal counter": "عداد بلوري (أنبوب عداد يزيد فيه حدث التأين من الموصلية)",
 "crystal detector": "كاشف بلوري (كاشف يتكون من سلك رفيع يلامس بلورة جالينا؛ يعمل كمقوم)",
 "crystal gazing": "قراءة الكرة البلورية (التحديق في كرة بلورية لإثارة رؤى لأحداث مستقبلية أو بعيدة)",
 "crystal lattice": "شبكة بلورية, شبكة فراغية (ترتيب هندسي ثلاثي الأبعاد للذرات أو الجزيئات أو الأيونات المكونة للبلورة)",
 "crystal microphone": "ميكروفون بلوري (ميكروفون تقوم فيه الموجات الصوتية بذبذبة بلورة كهروضغطية تولد جهداً متغيراً)",
 "crystal mike": "ميكروفون بلوري (ميكروفون تقوم فيه الموجات الصوتية بذبذبة بلورة كهروضغطية تولد جهداً متغيراً)",
 "crystal oscillator": "مذبذب بلوري, مذبذب كوارتز (مذبذب ينتج ذبذبات كهربائية بتردد تحدده الخصائص الفيزيائية لبلورة كوارتز كهرضغطية)",
 "crystal pickup": "لاقط بلوري (خرطوشة يتم فيها إنتاج جهد الخرج عن طريق اهتزاز بلورة كهروضغطية)",
 "crystal rectifier": "دايود, صمام ثنائي",
 "crystal set": "راديو بلوري (جهاز استقبال راديو مبكر يستخدم كاشفاً بلورياً)",
 "crystal tea": "شاي الكريستال, شاي لابرادور (شجيرة دائمة الخضرة من شرق أمريكا الشمالية ذات أزهار بيضاء أو كريمية على شكل جرس وأوراق مشعرة خضراء داكنة تستخدم للشاي خلال الثورة الأمريكية)",
 "crystal violet": "البنفسج البلوري, بنفسج الجنطيانا (بلورة خضراء (بنفسجية في الماء) تستخدم كصبغة أو ملون أو مبيد للجراثيم أو مبيد للفطريات أو طارد للديدان أو علاج للحروق)",
 "crystalised": "مُتَبَلْوِر (لَهُ بِنْيَة دَاخِلِيَّة وشَكْل خَارِجِيّ بَلُّورِيّ) / مُبَلْوَر, مُسَكَّر ((خَاصَّةً عَنِ الفَوَاكِه) مَحْفُوظ بِتَغْلِيفِه بِالسُّكَّر أَوْ تَشَرُّبِه إِيَّاه)",
 "crystalized": "مُبَلْوَر, مُسَكَّر ((خَاصَّةً عَنِ الفَوَاكِه) مَحْفُوظ بِتَغْلِيفِه بِالسُّكَّر أَوْ تَشَرُّبِه إِيَّاه)",
 "crystalline": "بَلُّورِيّ (يتكون من أو يحتوي على أو من طبيعة البلورات) / بِلَّوْرِيّ, رَائِق (ينقل الضوء ويمكن الرؤية من خلاله بوضوح) / بِلَّوْرِيّ الوُضُوح (وَاضِح المَعَالِم بِشَكْلٍ حَادّ)\nمثال: الجرانيت بلوري",
 "crystalline lens": "عدسة, عدسة العين (جسم شفاف محدب الوجهين يقع خلف القزحية في العين؛ دورها (جنباً إلى جنب مع القرنية) هو تركيز الضوء على الشبكية)",
 "crystallinity": "تبلور, درجة التبلور ((في الكيمياء) درجة الترتيب الهيكلي في مادة صلبة)",
 "crystallisation": "بلورة, تبلور (تشكل البلورات)",
 "crystallised": "متبلور (أصبح ثابتاً ومحدداً في الشكل)\nمثال: التمييز بين الرأي المتبلور وغير المتبلور",
 "crystallite": "بِلَّوْرَة دَقِيقَة (أي من الأجسام البلورية البدائية الدقيقة مجهولة التركيب الموجودة في الصخور النارية الزجاجية)",
 "crystallization": "تبلور (تركيب ذهني يصبح ثابتاً أو ملموساً بعملية تشبه تكوين البلورات) / بِلَّوْرَة, كْرِيسْتَال (صخر يتكون من تصلب مادة ما؛ له هيكل داخلي متكرر بانتظام؛ وأوجه مستوية خارجية) / بلورة, تبلور (تشكل البلورات)",
 "crystallized": "مُتَبَلْوِر (لَهُ بِنْيَة دَاخِلِيَّة وشَكْل خَارِجِيّ بَلُّورِيّ) / متبلور (أصبح ثابتاً ومحدداً في الشكل)\nمثال: التمييز بين الرأي المتبلور وغير المتبلور",
 "crystallized fruit": "فاكهة مبلورة, فاكهة مسكرة (فاكهة مطبوخة في شراب السكر ومغلفة ببلورات السكر)",
 "crystallized ginger": "زنجبيل مبلور (شرائح من جذر الزنجبيل مطبوخة في شراب السكر ومغلفة بالسكر)",
 "crystallized honey": "عسل متبلور (عسل تبلور فيه بعض محتوى الجلوكوز تلقائياً من المحلول)",
 "crystallizing": "بلورة, تبلور (تشكل البلورات)",
 "crystallogen": "عنصر المجموعة 14, عنصر مجموعة الكربون (أي عنصر كيميائي ينتمي إلى مجموعة الكربون)\nمثال: الكربون، أخف عناصر مجموعة الكربون، يتسامى عند 3825 درجة مئوية",
 "crystallographer": "أخصائي علم البلورات (متخصص في علم البلورات)",
 "crystallography": "علم البلورات (فرع العلم الذي يدرس تكوين وبنية البلورات)",
 "crème brûlée": "كريم بروليه (نبيل النفس عزيزها ذو الخلق العالي والخير الكثير والعطاء السخي. الكَرَم يشمل مجموعة من الأخلاق أهمها العطاء؛ الجَوَاد السخيّ تحديدا)\nمثال: يا لك من رجل كريم!",
 "cs": "سيزيوم (عنصر فلزي ناعم فضي أبيض قابل للسحب (سائل في درجات الحرارة العادية))",
 "cs gas": "غاز سي إس, كلوروبنزيليدين مالونونتريل",
 "csardas": "تشاردس (قطعة موسيقية مؤلفة لرقصة التشاردس المجرية) / تشاردس (قطعة موسيقية بإيقاع رقصة التشاردس المجرية)",
 "cse": "مؤسسة أمن الاتصالات (وكالة كندية تجمع استخبارات الاتصالات وتساعد وكالات إنفاذ القانون والأمن)",
 "csis": "جهاز الاستخبارات الأمنية الكندي (وكالة الاستخبارات الخارجية الرئيسية في كندا التي تجمع وتحلل المعلومات لتوفير استخبارات أمنية للحكومة الكندية)",
 "cst": "توقيت المنطقة الوسطى (التوقيت القياسي في المنطقة الزمنية السادسة غرب غرينتش، يحسب عند خط الطول 90؛ يستخدم في وسط الولايات المتحدة)",
 "ct": "أشعة مقطعية, تصوير مقطعي محوسب (طريقة لفحص أعضاء الجسم عن طريق مسحها بالأشعة السينية واستخدام الكمبيوتر لبناء سلسلة من المسحات المقطعية على طول محور واحد)",
 "ctc": "مركز مكافحة الإرهاب (وكالة تساعد مدير الاستخبارات المركزية في تنسيق جهود مكافحة الإرهاب من أجل استباق الأنشطة الإرهابية وتعطيلها وهزيمتها في أقرب مرحلة ممكنة)",
 "ctene": "مشط (عضو حركي يتكون من صف من الأهداب القوية التي تندمج قواعدها)",
 "ctenidium": "خيشوم مشطي (هيكل تنفسي يشبه المشط يعمل كخيشوم لبعض الرخويات)",
 "ctenocephalides canis": "برغوث الكلب (برغوث يهاجم الكلاب والقطط)",
 "ctenocephalides felis": "برغوث القط (برغوث يتكاثر بشكل رئيسي على القطط والكلاب والجرذان)",
 "ctenoid": "مشطي (يشبه المشط؛ له نتوءات مثل أسنان المشط)",
 "ctenophore": "مشطيات, هلاميات مشطية (حيوانات بحرية خنثوية متناظرة ثنائياً تشبه قناديل البحر ولها ثمانية صفوف من الأهداب مرتبة مثل أسنان المشط للحركة)",
 "ctenophore family": "فصيلة مشطيات (فصيلة من الهلاميات المشطية)",
 "ctenophore genus": "جنس ممشطيات (جنس من الممشطيات)",
 "ctesiphon": "المَدَائِن, قُطَيْسَفُون",
 "cu": "نحاس (عنصر معدني بني محمر قابل للسحب والطرق ومقاوم للتآكل ومغناطيسي معاكس؛ يوجد في معادن مختلفة ولكنه المعدن الوحيد الذي يوجد بكثرة في كتل كبيرة؛ يستخدم…)",
 "cu ft": "قدم مكعب (الحجم المساوي لمكعب طول ضلعه قدم واحد)",
 "cu in": "بوصة مكعبة (الحجم المساوي لمكعب طول ضلعه بوصة واحدة)",
 "cub": "هِجْرِس, جَرْو (الثَعْلَب أو القِرْد أو ولده؛ كل ما يعسعس بالليل من الحيوان مما هو بين الثعلب واليربوع)",
 "cub scout": "شبل الكشافة (كشاف صغير)",
 "cub shark": "قرش الثور (أكثر أنواع القرش شيوعاً في المياه الساحلية المعتدلة والاستوائية حول العالم؛ ضخم الجسم وخطير)",
 "cuba": "كُوبَا (دولة في منطقة البحر الكاريبي؛ اسمها الرسمي جمهورية كوبا، وعاصمتها هافانا)\nمثال: لدي الآس الكوبا.",
 "cubage unit": "وحدة حجم, وحدة سعة (وحدة لقياس الحجم أو السعة)",
 "cuban": "كوبي (من أو يتعلق بكوبا أو شعب كوبا أو يميزهم) / كوبي (مواطن أو ساكن في كوبا)\nمثال: روم كوبي",
 "cuban bast": "لحاء كوبي, ماهو أزرق (شجرة غابات منتصبة في كوبا وجامايكا ذات أوراق مشعرة بشكل متباين وزهور برتقالية صفراء أو برتقالية حمراء؛ تنتج خشباً متوسط الكثافة لأعمال الخزائن…)",
 "cuban heel": "كعب كوبي (كعب عريض متوسط الارتفاع في أحذية النساء)",
 "cuban itch": "جدري خفيف (شكل خفيف من الجدري يسببه فيروس أقل ضراوة)",
 "cuban mahogany": "ماهوجني حقيقي, ماهوجني كوبي (شجرة الماهوجني في جزر الهند الغربية)",
 "cuban monetary unit": "وحدة نقدية كوبية (الوحدة النقدية في كوبا)",
 "cuban peso": "بيزو, بيزو كوبي (وحدة المال الأساسية في كوبا؛ تساوي 100 سنتافو)",
 "cuban sandwich": "سابمارين, سندويتش غواصة (شطيرة كبيرة مصنوعة من لفافة خبز طويلة مقسومة طولياً ومحشوة باللحوم والجبن (والطماطم والبصل والخس والتوابل))",
 "cuban spinach": "خس عامل المنجم, رجلة الشتاء (عشبة عصارية تزرع أحياناً كسلطة أو بقلة؛ تنمو في الكثبان والأراضي البور بساحل المحيط الهادئ لأمريكا الشمالية)",
 "cubature unit": "وحدة حجم, وحدة سعة (وحدة لقياس الحجم أو السعة)",
 "cubby": "غرفة صغيرة مريحة, مخدع (غرفة صغيرة منعزلة)",
 "cubbyhole": "غرفة صغيرة مريحة, مخدع (غرفة صغيرة منعزلة) / حجيرة, رف رسائل (حجرة صغيرة)",
 "cube": "كَعْبَة, مُكَعَّب (بيت مربع الجوانب؛ (حديثًا) مُتَّجَه) / كَعْبَة (بيت مربع الجوانب؛ (حديثًا) مُتَّجَه)\nمثال: الكعبة بيت الله.",
 "cube root": "الجذر التكعيبي",
 "cube-shaped": "مُكَعَّب, مُكَعَّبِيّ (على شكل مكعب)",
 "cubeb": "كَبَابَة, حَبّ الْعَرُوس",
 "cubeb cigarette": "سيجارة الكبابة (سيجارة تحتوي على الكبابة (فلفل جاوة))",
 "cubeb vine": "فلفل جاوة, كبابة (كرمة شجيرية استوائية من جنوب شرق آسيا تحمل ثماراً تشبه التوت حارة)",
 "cubelike": "مُكَعَّب, مُكَعَّبِيّ (على شكل مكعب)",
 "cubic": "مُكَعَّب",
 "cubic boron nitride": "نيتريد البورون المكعب (مركب كيميائي يستخدم على نطاق واسع كمادة كاشطة)",
 "cubic centimeter": "سنتيمتر مكعب, مليلتر (وحدة مترية للحجم تساوي واحداً من الألف من اللتر)",
 "cubic centimetre": "سنتيمتر مكعب, مليلتر (وحدة مترية للحجم تساوي واحداً من الألف من اللتر)",
 "cubic content unit": "وحدة حجم, وحدة سعة (وحدة لقياس الحجم أو السعة)",
 "cubic decimeter": "لتر (وحدة مترية للسعة، تساوي 1,000 سنتيمتر مكعب)",
 "cubic decimetre": "لتر (وحدة مترية للسعة، تساوي 1,000 سنتيمتر مكعب)",
 "cubic foot": "قدم مكعب (الحجم المساوي لمكعب طول ضلعه قدم واحد)",
 "cubic inch": "بوصة مكعبة (الحجم المساوي لمكعب طول ضلعه بوصة واحدة)",
 "cubic kilometer": "كيلومتر مكعب (وحدة سعة تساوي حجم مكعب طول ضلعه كيلومتر واحد)",
 "cubic kilometre": "كيلومتر مكعب (وحدة سعة تساوي حجم مكعب طول ضلعه كيلومتر واحد)",
 "cubic measure": "وحدة حجم, وحدة سعة (وحدة لقياس الحجم أو السعة)",
 "cubic meter": "كيلولتر, متر مكعب (وحدة مترية للحجم أو السعة تساوي 1000 لتر)",
 "cubic metre": "مِتْرٌ مُكَعَّبٌ (فِي : مُسْتَعْمَلٌ لِتَحْدِيدِ طُولِ مُخْتَلِفِ الأَشْيَاءِ، قَدْرُهُ ذِرَاعٌ وَنِصْفٌ تَقْرِيباً…؛ فِي : هوَ النَادل أو موَظف خدْمة الزَّبائن في المطْعم، يقَال أيْضاً \"مِيتْر\")\nمثال: أنا أقل بقليل من 150 سنتي متر.",
 "cubic millimeter": "مليمتر مكعب (مقياس متري للحجم أو السعة يساوي مكعباً طول ضلعه 1 مليمتر)",
 "cubic millimetre": "مليمتر مكعب (مقياس متري للحجم أو السعة يساوي مكعباً طول ضلعه 1 مليمتر)",
 "cubic yard": "ياردة مكعبة (وحدة حجم (كما للرمل أو الحصى))",
 "cubical": "مُكَعَّب, مُكَعَّبِيّ (على شكل مكعب)",
 "cubicity": "تكعيبية, شكل مكعب (خاصية مشابهة للمكعب)",
 "cubicle": "كشك, مقصورة (منطقة صغيرة مفصولة بجدران لاستخدام خاص) / كابينة دراسة, مقصورة دراسة (منطقة دراسة فردية صغيرة في مكتبة) / صومعة, قلاية (غرفة صغيرة يعيش فيها راهب أو راهبة)",
 "cubiform": "مُكَعَّب, مُكَعَّبِيّ (على شكل مكعب)",
 "cubism": "تَكْعِيبِيَّة",
 "cubist": "تكعيبي (يتعلق بالتكعيبية أو يميزها) / تكعيبي, فنان تكعيبي (فنان يلتزم بمبادئ التكعيبية)\nمثال: فن تكعيبي",
 "cubistic": "تكعيبي (يتعلق بالتكعيبية أو يميزها)\nمثال: فن تكعيبي",
 "cubit": "ذِرَاع",
 "cubital": "مرفقي (من أو متعلق بالمرفق)",
 "cubital joint": "مرفق, مفصل المرفق (مفصل رزي بين الساعد والعضد والمفصل المقابل في الطرف الأمامي لذوات الأربع)",
 "cubital nerve": "عصب زندي (عصب يمتد على طول الجانب الداخلي للذراع ويمر بالقرب من الكوع؛ يغذي العضلات الداخلية لليد والجلد على الجانب الإنسي لليد)",
 "cubitiere": "واقي الكوع (درع جسدي يحمي الكوع)",
 "cubitus": "زند, ساعد (الذراع من المرفق إلى أطراف الأصابع) / مرفق, مفصل المرفق (مفصل رزي بين الساعد والعضد والمفصل المقابل في الطرف الأمامي لذوات الأربع)",
 "cubo-futurism": "تكعيبية مستقبلية (المدرسة الرئيسية في الرسم والنحت التي مارسها المستقبليون الروس)\nمثال: أعقبت البدائية الجديدة التكعيبية المستقبلية ثم الشعاعية",
 "cuboid": "مُكَعَّب, مُكَعَّبِيّ (على شكل مكعب) / شكل مكعباني, متوازي مستطيلات (متوازي سطوح مستطيل)",
 "cuboid bone": "عظم مكعبي, عظم نردي (العظم المكعب الشكل على الجانب الخارجي من الرصغ)",
 "cuboidal": "مُكَعَّب, مُكَعَّبِيّ (على شكل مكعب)",
 "cuboidal cell": "خلية طلائية مكعبة, خلية مكعبة (خلية طلائية شكلها يشبه المكعب)",
 "cuboidal epithelial cell": "خلية طلائية مكعبة, خلية مكعبة (خلية طلائية شكلها يشبه المكعب)",
 "cucking stool": "كرسي التغطييس (أداة عقاب تتكون من كرسي يُغمس فيه المخالفون في الماء)",
 "cuckold": "دَيُّوث",
 "cuckolding": "دياثة (فعل جنسي يمارس فيه شخص متزوج الجنس مع شخص آخر بينما يشاهد الزوج ذلك)",
 "cuckoldom": "دياثة (حالة الزوج الذي ارتكبت زوجته الزنا)",
 "cuckoldry": "خيانة زوجية, ديوثية (ممارسة إقامة علاقات جنسية مع نساء متزوجات)",
 "cuckoo": "وَقْوَاق, وَقْوَاقِيَّة",
 "cuckoo bread": "أقصليس, حميض الخشب الشائع (نبات أوراسي بأوراق ثلاثية على شكل قلب وزهور بيضاء ذات عروق أرجوانية)",
 "cuckoo clock": "ساعة الوقواق (ساعة تعلن عن الساعات بصوت يشبه نداء طائر الوقواق)",
 "cuckoo flower": "زهرة الوقواق, ليخنيس زهرة الوقواق (نبات معمر شائع موطنه أوروبا وغرب آسيا ذو زهور وردية عادة ببتلات خشنة) / حرف مرجي, زهرة الوقواق (رشاد مر من أوروبا وأمريكا)",
 "cuckoo's nest": "مارستان, مستشفى المجانين (مصطلحات تحقيرية لمصحة المجانين)",
 "cuckoo-bumblebee": "نحلة الوقواق الطنانة (نحلة تتطفل في أعشاش النحل الطنان)",
 "cuckooflower": "حرف مرجي, زهرة الوقواق (رشاد مر من أوروبا وأمريكا)",
 "cuckoopint": "قلقاس هندي, لوف مبقع (لوف أوروبي شائع ذو قنابة سنانية الشكل وطلع أرجواني قصير؛ يظهر في أوائل الربيع؛ مصدر لنشا يسمى اللوف)",
 "cuculiform bird": "واقواقيات (طيور لها أقدام متقابلة الأصابع (باستثناء التوراكو))",
 "cuculus canorus": "واقواق شائع (واقواق شائع في أوروبا له نداء مميز من نغمتين؛ يضع البيض في أعشاش الطيور الأخرى)",
 "cucumber": "خِيَار (الإسم من الإختيار ، وهو إنتقاء شيء فيكون خير من غيره؛ صيغة جمع لخير ، بمعنى أفضل)\nمثال: لم يكن لدي خيار.",
 "cucumber tree": "شجرة الخيار, ماغنوليا مستدقة (ماغنوليا أمريكية متساقطة الأوراق ذات أوراق كبيرة وثمار تشبه خياراً صغيراً)",
 "cucumber vine": "خيار (كرمة شمام من جنس كوكوميس؛ تُزرع منذ أقدم العصور لثمارها الخضراء الأسطوانية)",
 "cucumber-shaped": "خِيَارِيُّ الشَّكْلِ (ذو شكل يشبه الخيار)",
 "cucumis melo": "بطيخ أصفر, شمام (أي من عدة أصناف من الكروم ثمارها ذات قشرة شبكية ولب صالح للأكل ورائحة مسكية)",
 "cucumis melo cantalupensis": "شمام, كانتالوب (صنف من كرمة الشمام ذو ثمار بقشرة سمراء ولحم برتقالي)",
 "cucumis melo inodorus": "بطيخ شتوي, شمام عسلي (أي من أصناف كرمة الشمام ذات ثمار بقشرة بيضاء ملساء ولحم أبيض أو مخضر ليس له رائحة مسكية)",
 "cucumis melo reticulatus": "شمام جوزة الطيب, شمام شبكي (كرمة شمام ذات ثمار بقشرة شبكية رقيقة ولحم أخضر حلو)",
 "cucumis sativus": "خيار (كرمة شمام من جنس كوكوميس؛ تُزرع منذ أقدم العصور لثمارها الخضراء الأسطوانية)",
 "cucurbit": "قرعيات (أي نبات من الفصيلة القرعية)",
 "cucurbita argyrosperma": "كوشو (نبات يحمل قرعاً بثمور كروية إلى بيضاوية بقشور ثؤلولية مخططة بالرمادي والأخضر والأبيض)",
 "cucurbita foetidissima": "قرع البراري, قرع الجاموس (كرمة معمرة في المناطق الجافة بوسط وجنوب غرب الولايات المتحدة والمكسيك ذات ثمار خضراء مرقطة صغيرة صلبة غير صالحة للأكل)",
 "cucurbita maxima": "قرع شتوي, قرع هوبارد (أي من عدة نباتات قرع شتوي تنتج ثماراً كبيرة رمادية مخضرة على شكل كرة قدم بقشرة ثؤلولية خشنة) / قرع الجوز, قرع عسلي (نبات يحمل قرعاً برتقالي اللون له ثمار تشبه الزجاجة نوعاً ما بلب ناعم الملمس وقشرة رقيقة ناعمة)",
 "cucurbita maxima turbaniformis": "قرع العمامة (نباتات قرع تحمل ثماراً صلبة القشرة تشبه العمامة نوعاً ما مع جزء مركزي مستدير يبرز من النهاية المقابلة للساق)",
 "cucurbita mixta": "كوشو (نبات يحمل قرعاً بثمور كروية إلى بيضاوية بقشور ثؤلولية مخططة بالرمادي والأخضر والأبيض)",
 "cucurbita moschata": "قرع شتوي معقوف الرقبة (أي من نباتات مختلفة تحمل قرعاً بقشور صلبة وأعناق ممدودة منحنية)",
 "cucurbita pepo": "قرع, يقطين (ضرب بشدة على شيء يَصْدُرُ منه صوت قوي؛ في سياق مجازي: أوقع الضربة أو وقع الصوت المفاجئ أو الحاد)\nمثال: توقف ذلك القرع.",
 "cucurbita pepo melopepo": "قرع صيفي, كوسا (أي من النباتات المختلفة التي عادة ما تكون شجيرية وتنتج ثماراً تؤكل وهي غير ناضجة وقبل أن تتصلب القشرة أو البذور)",
 "cucurbitaceous": "قرعي (من أو متعلق بنباتات الفصيلة القرعية)",
 "cud": "جِرَّة (اسم للمَرَّة الواحدة من الجَرّ؛ إناء من خَزَف أو صُلْصَال له بطن كبير وعروتان وفمّ واسع)\nمثال: من ترك الجرة مفتوحة؟",
 "cudbear": "أوركيل, صبغة الأوركيل (صبغة أرجوانية يتم الحصول عليها من أشنات الأوركيل)",
 "cuddle": "معانقة حميمة (عناق وثيق وحنون (وغالبا ما يطول))",
 "cuddlesome": "دَمِث, يَدْعُو لِلْعِنَاق (يدعو إلى الاحتضان والمعانقة)",
 "cuddling": "تقبيل, عناق (اللعب العاطفي (أو المداعبة دون ملامسة الأعضاء التناسلية))",
 "cuddly": "دَمِث, يَدْعُو لِلْعِنَاق (يدعو إلى الاحتضان والمعانقة)",
 "cuddy": "مطبخ صغير (مطبخ أو مخزن سفينة صغيرة)",
 "cudgel": "هراوة (عصا غليظة تستخدم كسلاح)",
 "cudweed": "شيح لويزيانا, مريمية بيضاء (عشب معمر أبيض قطني من جنوب غرب الولايات المتحدة) / عشبة القطن, فيلاغو (أي نبات من جنس فيلاغو له عناقيد رأسية من رؤوس زهور صوفية صغيرة) / عشبة القد, غنافاليوم",
 "cue": "كُو",
 "cue ball": "الكرة البيضاء (الكرة التي يضربها لاعب البلياردو بعصاه)",
 "cue stick": "عصا البلياردو (أداة رياضية تتكون من قضيب مستدق الطرف يستخدم لضرب كرة البلياردو)",
 "cuff": "ثنية الكم, كُفّة (طية تتكون من حاشية مقلوبة للخلف تطوق نهاية الكم أو الساق) / أصفاد, كلبشات (قيد يتكون من حلقة معدنية يمكن قفلها حول المعصم؛ تستخدم عادة في أزواج)",
 "cufflink": "كَبَكْ, وِثَاق اَلْكُفَّة",
 "cuirass": "درع الصدر والظهر, كِراس (درع جسدي من العصور الوسطى يغطي الصدر والظهر)",
 "cuirassier": "فارس مدرع, كيرلاسي (جندي خيال مجهز بدرع للصدر (كيرلاس))",
 "cuisine": "طَبْخ, طَبِيخ (أَنْضَجَ الطعام بتسخينه)\nمثال: سامي يحب الطبخ.",
 "cuisse": "واقي الفخذ (درع صفيحي يحمي الفخذ)",
 "cuke": "خيار (فاكهة خضراء أسطوانية ذات قشرة خضراء رقيقة ولب أبيض تؤكل كخضار؛ ترتبط بالبطيخ)",
 "cul": "زقاق مغلق, طريق مسدود (ممر له مدخل من طرف واحد فقط)",
 "cul de sac": "طريق مسدود (شارع له مدخل أو مخرج واحد فقط) / زقاق مغلق, طريق مسدود (ممر له مدخل من طرف واحد فقط)",
 "culcita dubia": "براكن كاذب",
 "culdoscope": "منظار الردب (منظار متخصص لفحص أعضاء الحوض لدى المرأة بصرياً)",
 "culdoscopy": "تنظير الردبة (فحص بالمنظار لأعضاء الحوض عند المرأة عن طريق إدخال منظار عبر المهبل)",
 "culex fatigans": "بعوضة كوليكس (بعوضة استوائية واسعة الانتشار تنقل ديدان الفيلاريا)",
 "culex pipiens": "بعوضة شائعة (بعوضة المنزل الشائعة)",
 "culex quinquefasciatus": "بعوضة كوليكس (بعوضة استوائية واسعة الانتشار تنقل ديدان الفيلاريا)",
 "culinary": "مَطْبَخِيّ",
 "culinary art": "طِبَاخَة (مؤنث طَبَّاخ، من طَبَخَ)\nمثال: هل زوجتك طباخة ماهرة؟",
 "cull": "مرفوض, منبوذ (الشخص أو الشيء الذي يتم رفضه أو تنحيته جانباً لكونه أقل جودة)",
 "cullender": "مصفاة (مصفاة على شكل وعاء؛ تستخدم لغسل أو تصفية الأطعمة)",
 "cullis": "ميزاب (قناة تصريف في السقف)",
 "culm": "قصبة (ساق نباتات الفصيلة النجيلية)",
 "culmination": "إتمام, إكمال (إجراء ختامي أو نهائي) / تتويج, ذروة (اللحظة الحاسمة في رواية أو مسرحية) / بلوغ القمة, عبور الزوال ((في الفلك) أعلى نقطة سماوية لجرم سماوي فوق أفق المراقب) / أوج, ذروة (مرحلة الذروة النهائية)\nمثال: مشهد فراش الموت هو ذروة المسرحية",
 "culotte": "تنورة بنطال, كيلوت (تنورة مقسمة)",
 "culpability": "مَلُومِيَّة, تَأْثِيم",
 "culpable": "مُذْنِب, مُخْطِئ",
 "culpable negligence": "إهمال جسيم, إهمال جنائي ((قانون) التصرف بتهور دون حذر معقول وتعريض شخص آخر لخطر الإصابة أو الموت (أو الفشل في القيام بشيء له نفس العواقب))",
 "culpableness": "جدارة باللوم, مسؤولية عن الخطأ (حالة من الذنب)",
 "culpably": "بِشَكْل مَذْمُوم, بِشَكْل يُلَام عَلَيْه (بطريقة أو لدرجة تستحق اللوم أو التوبيخ)",
 "culprit": "مُجْرِم, جَانِي / مُتَّهَم",
 "cult": "طائِفَة, فِرْقَة (مؤنث طَائِف؛ التي تطوفُ؛ القطعة أو الجزء من الشيء أو الواحدة منه)",
 "cult of personality": "عِبَادَة شَخْصِيَّة",
 "culteranismo": "التكلفية, غونغوريسمو (أسلوب مقصور على فئة معينة من الكتابة حاول رفع اللغة الشعرية والمواضيع من خلال إعادة صياغتها باللاتينية، واستخدام التلميحات الكلاسيكية، والمفردات،…)\nمثال: إن مقارناته للأسلوب المنحط الحديث مع التكلفية في حقبة سابقة، التي أدت تجاوزاتها إلى ردود فعل ساخرة وأسلوب أكثر رصانة، كاشفة للغاية",
 "cultism": "تبجيل, تفاني (حماس ديني؛ الاستعداد لخدمة الله) / تَقْدِيس, غُلُوّ (التفاني لعقيدة أو طائفة أو لممارسات طائفة)",
 "cultist": "عُضْو طائِفَة (عضو في طائفة دينية) / عُضْو طائِفَة (عضو في طائفة غير تقليدية تعيش عموماً خارج المجتمع التقليدي تحت توجيه قائد كاريزمي)",
 "cultivable": "صالح للزراعَة ((في الإسلام) نبي ورد ذكره في القرآن، أُرسل إلى قوم ثمود؛ اسم شخصي معطًى للذكور من العرب)\nمثال: قم بما هو صالح.",
 "cultivar": "مُسْتَنْبَت",
 "cultivatable": "صَالِح لِلزِّرَاعَة, قَابِل لِلْحَرْث ((عن الأراضي الزراعية) قابل للزراعة المنتجة)",
 "cultivated": "مستزرع, مفلوح ((للأرض أو الحقول) معدة لزراعة المحاصيل عن طريق الحراثة أو التسميد) / رَاقٍ, مُتَحَضِّرٌ (يتميز بالرقي في الذوق والسلوك) / مُزْدَرَع, مُسْتَنْبَت (لَمْ يَعُدْ فِي حَالَتِهِ الطَّبِيعِيَّةِ؛ طُوِّرَ بِالعِنَايَةِ البَشَرِيَّةِ لِلاسْتِخْدَامِ الآدَمِيّ)\nمثال: أرض مستزرعة",
 "cultivated cabbage": "كرنب, ملفوف (أي من الأصناف المختلفة لجنس الكرنب الزيتي التي تزرع لأوراقها أو أزهارها الصالحة للأكل)",
 "cultivated carrot": "جزر (نبات معمر يزرع على نطاق واسع كنبات حولي في العديد من الأصناف لجذوره الصالحة للأكل البرتقالية المخروطية الطويلة؛ المناطق المعتدلة والاستوائية)",
 "cultivated celery": "كرفس (عشب يزرع على نطاق واسع بسيقان أوراق عطرية تؤكل نيئة أو مطبوخة)",
 "cultivated crab apple": "تفاح بري مزروع (أي من الأصناف العديدة من التفاح البري تزرع لفاكهتها الصغيرة الحمضية (عادة حمراء زاهية) المستخدمة للمربيات أو للزينة لزهورها)",
 "cultivated land": "أرض زراعية, أرض محروثة (أرض صالحة للزراعة يتم حرثها وزرعها وإنتاج المحاصيل منها)",
 "cultivated parsnip": "بارسنيب, جزر أبيض مزروع (نبات ثنائي الحول أوروبي له جذر مغزلي طويل أصبح مستساغاً من خلال الزراعة)",
 "cultivated plant": "نبات مزروع (النباتات التي تُزرع من أجل منتجاتها)",
 "cultivated rice": "أرز مزروع (ينتج الغذاء الأساسي لـ 50 في المائة من سكان العالم)",
 "cultivated strawberry": "شليك, فراولة الحديقة (تزرع على نطاق واسع)",
 "cultivation": "تَهْذِيب",
 "cultivator": "عزاقة, محراث (أداة زراعية تستخدم لتفتيت سطح التربة (للتهوية ومكافحة الأعشاب الضارة والحفاظ على الرطوبة)) / خبير زراعي, مزارع (شخص يعنى بعلم أو فن أو تجارة زراعة الأرض)",
 "cultural": "ثَقَافِيّ, مَدَنِيّ",
 "cultural anthropologist": "عالم أنثروبولوجيا اجتماعية, عالم أنثروبولوجيا ثقافية (عالم أنثروبولوجيا يدرس الظواهر الثقافية مثل أنظمة القرابة)",
 "cultural anthropology": "أنثروبولوجيا اجتماعية, أنثروبولوجيا ثقافية (فرع الأنثروبولوجيا الذي يتعامل مع الثقافة والمجتمع البشري)",
 "cultural appropriation": "استيلاء ثقافي",
 "cultural attache": "ملحق ثقافي (ملحق متخصص في الشؤون الثقافية)",
 "cultural diffusion": "انتشار ثقافي (انتشار العناصر الثقافية - مثل الأفكار والأنماط والأديان والتقنيات واللغات وما إلى ذلك - بين الأفراد، سواء داخل ثقافة واحدة أو من ثقافة إلى أخرى)",
 "cultural marxism": "اَلْمَارْكْسِيَّة ثَقَافِيَّة",
 "cultural model": "نموذج ثقافي (إطار عقلي قائم على الأفكار والمواقف المشتركة وأنماط السلوك التي تمتد عبر مجتمع ما)\nمثال: ينشأ النموذج الثقافي للصمم من الصم أنفسهم، ولكن لا يقتصر عليهم",
 "cultural movement": "حركة ثقافية (مجموعة من الأشخاص يعملون معاً لتعزيز أهداف ثقافية معينة)",
 "cultural revolution": "ثَوْرَة ثَقَافِيَّة",
 "cultural studies": "دِرَاسَات ثَقَافِيَة",
 "culturally": "ثقافياً (فيما يتعلق بالثقافة)\nمثال: مدمج ثقافياً",
 "culturati": "المثقفون (الأشخاص المهتمون بالثقافة والأنشطة الثقافية)",
 "culture": "ثَقَافَة (بمعنى صار حَاذقا فطنا؛ المعرفة الواسعة والإطلاع على الكثير من المعلومات)\nمثال: توم لا يهتم بالثقافة.",
 "culture medium": "وسط استنبات, وسط زرع ((علم الجراثيم) مادة مغذية (صلبة أو سائلة) تستخدم لزراعة الكائنات الحية الدقيقة)",
 "culture shock": "صَدْمَة ثَقَافِيَّة",
 "cultured": "مُثَقَّف",
 "cultus": "شعائر دينية, طائفة (نظام من المعتقدات والطقوس الدينية)\nمثال: مكرس لعبادة العذراء المباركة",
 "culverin": "كولفرين (بندقية مسكيت من العصور الوسطى) / كولفرين (مدفع ثقيل بسبطانة طويلة استخدم في القرنين السادس عشر والسابع عشر)",
 "culvert": "عبّارة, قنطرة (مصرف عرضي مغلق بالكامل تحت طريق أو سكة حديد)",
 "cum": "قَذْف الْمَنْي (بمعنى رَمَى؛ قذَف بالحقّ: أمر به وأبانه)",
 "cum laude": "بِامْتِيَاز, بِمَرْتَبَة الشَّرَف (مع التميز) / مَعَ مَرْتَبَةِ الشَّرَفِ (بِشَرَفٍ؛ بِتَمَيُّزٍ أَكَادِيمِيٍّ)\nمثال: تخرج بمرتبة الشرف",
 "cuman": "كُومَان",
 "cumarone": "بنزوفوران, كومارون (مركب زيتي عديم اللون يستخرج من قطران الفحم ويستخدم في صناعة الراتنجات الاصطناعية)",
 "cumbersome": "ثَقِيل الأُسْلُوب, رَكِيك (يَفْتَقِر إِلَى الأَنَاقَة أَوِ الرَّشَاقَة فِي التَّعْبِير) / ثَقِيل, مُرْهِق (صعب المناولة أو الاستخدام خاصّةً بسبب حجمه أو وزنه)",
 "cumbersomeness": "ثقل, صعوبة التعامل (مشكلة في الحمل أو الإدارة بسبب الحجم أو الشكل)\nمثال: لعن الحمالون ثقل البيانو الكبير",
 "cumbrous": "ثَقِيل, مُرْهِق (صعب المناولة أو الاستخدام خاصّةً بسبب حجمه أو وزنه)",
 "cumfrey": "سنفيتون, كومفري (أعشاب معمرة في أوروبا وإيران؛ تشكل غطاءً أرضياً سريع النمو للمناطق المظللة)",
 "cumin": "كَمُّون",
 "cumin seed": "كمون (بذور عطرية لعشبة الكمون من الفصيلة الجزرية)",
 "cuminum cyminum": "كمون (نبات حولي متوسطي قزم يزرع منذ فترة طويلة لبذوره العطرية)",
 "cummerbund": "حِزَام, حِزَام عَرِيض (خيط أو قطعة من جلد تستخدم لحَزْم النَبَات أو العِيدَان أو غيرها لتكوين حُزْمَة؛ النِطَاق، قطعة من الجِلْد الطَوِيل يلف حول الخَصْر إما ليمسك المَلابِس أو ليظهر الخصر)\nمثال: هذا حزام من الجلد.",
 "cumquat": "برتقال ذهبي, كمكوات (شجر صغير مثمر من جنس الموالح، من فصيلة الحمضيات، أزهاره بيض عطرة الرائحة، وثمره حامض سكري حلو الطعم)\nمثال: هل تحب البرتقال ؟",
 "cumulation": "ركام, كدس (مجموعة من الأشياء مكدسة فوق بعضها البعض)",
 "cumulative": "تَرَاكُمِيّ, تَصَاعُدِيّ (يزداد بالإضافة المتتالية)",
 "cumulative preferred": "أسهم ممتازة مجمعة للأرباح (أسهم ممتازة تتراكم أرباحها إذا تم حذفها حتى يتم دفعها)",
 "cumulative preferred stock": "أسهم ممتازة مجمعة للأرباح (أسهم ممتازة تتراكم أرباحها إذا تم حذفها حتى يتم دفعها)",
 "cumulative vote": "تصويت تراكمي (انتخاب يمتلك فيه كل شخص عددًا من الأصوات يساوي عدد المناصب التي سيتم شغلها، ويمكنه إعطاؤها جميعًا لمرشح واحد أو توزيعها)",
 "cumulatively": "بِشَكْل تَرَاكُمِيّ, تَرَاكُمِيًّا (بطريقة تراكمية)\nمثال: أصبح العقل يتكاثر ذاتياً من خلال قدرة الإنسان على نقل الخبرة ومنتجاتها بشكل تراكمي",
 "cumuliform": "رُكَامِيُّ الشَّكْل (على شكل سحابة ركامية)",
 "cumulonimbus": "ركام مزني, سحابة رعدية (سحابة داكنة ذات امتداد عمودي كبير مشحونة بالكهرباء؛ ترتبط بالعواصف الرعدية)",
 "cumulonimbus cloud": "ركام مزني, سحابة رعدية (سحابة داكنة ذات امتداد عمودي كبير مشحونة بالكهرباء؛ ترتبط بالعواصف الرعدية)",
 "cumulous": "مُكَدَّس, مُكَوَّم (مَطْرُوحٌ بَعْضُهُ فَوْقَ بَعْضٍ فِي كَوْمَةٍ) / ركامي (من أو متعلق بالسحب الركامية)",
 "cumulus": "ركام, كدس (مجموعة من الأشياء مكدسة فوق بعضها البعض) / ركام, سحاب ركامي (سحابة كروية الشكل) / ركامي (من أو متعلق بالسحب الركامية)",
 "cumulus cloud": "ركام, سحاب ركامي (سحابة كروية الشكل)",
 "cunctation": "تسويف, مماطلة (فعل المماطلة؛ تأجيل أو إرجاء عمل ما إلى وقت لاحق)",
 "cunctator": "مُسَوِّف, مُمَاطِل (شخص يؤجل العمل (خاصة بسبب الكسل أو الإهمال المعتاد))",
 "cuneal": "إسفيني, مسماري (على شكل وتد)",
 "cuneate": "إِسْفِينِيّ الشَّكْل ((عن شكل الورقة) مُثلَّث ضيّق أعرض عند القمّة ويضيق نحو القاعدة)",
 "cuneate leaf": "ورقة إسفينية (ورقة على شكل وتد لها زاوية حادة عند القاعدة)",
 "cuneiform": "مِسْمَارِيَّة",
 "cuneiform bone": "عظم مثلثي (عظم رسغي يتمفصل مع العظام الحمصية والكلابية والهلالية)",
 "cuneo": "كُونِيُو",
 "cuneus": "إسفين, وتد (أي شكل مقطعه العرضي مثلث)",
 "cuniculus paca": "باكا (قارض كبير يحفر الجحور في أمريكا الجنوبية والوسطى؛ يحظى بتقدير كبير كطعام)",
 "cunner": "بيرغال, كونر (شائعة في المياه الساحلية لشمال المحيط الأطلسي في الولايات المتحدة)",
 "cunnilinctus": "لحس المهبل (التحفيز الفموي للفرج أو البظر)",
 "cunnilingus": "لَحْس بَظْر, لَعْق بَظْر (مرّر اللسان على الشيء لأخذ طعمه أو لتنظيفه؛ أزال الشيء بلعقه باللسان)",
 "cunning": "مَاكِر",
 "cunningly": "بِاحْتِيَال, بِخُبْث (بطريقة خفية وماكرة) / بِجَاذِبِيَّة, بِفِتْنَة (بطريقة جذابة)\nمثال: رتب بمكر ليكون هناك عندما أعلن القرار",
 "cunt": "كِس, كُس (الشيءَ: دقّه دقَّا شديدا أو ضغطه أو دعكه)",
 "cuon alpinus": "كلب بري آسيوي (كلب بري شرس من غابات وسط وجنوب شرق آسيا يصطاد في قطعان)",
 "cup": "كَأْس, كُوب (إناء الشرب إذا كان فيه شراب؛ الشراب الذي في الإناء) / فِنْجَان (إناء صغير لشرب أو احتساء شراب ساخن عادة، مثل القهوة والشاي)\nمثال: هل لي بكأس ماء؟",
 "cup and saucer": "جريس متوسط, كأس وصحن (نبات أوروبي ثنائي الحول يزرع على نطاق واسع لأزهاره الزرقاء أو البنفسجية أو البيضاء)",
 "cup final": "نهائي الكأس (المباراة النهائية لأي مسابقة كأس)",
 "cup fungus": "فطر قرصي, فطر كأسي (أي فطر عضو في طويئفة الفطريات القرصية)",
 "cup hook": "خُطَّاف أكواب, علاقة أكواب (خُطَّاف (عادة على الجانب السفلي من الرف) لتعليق الأكواب)",
 "cup morel": "موريل الكأس (موريل صالح للأكل بجسم ثمري يشبه الكأس أو الصحن يمكن أن يصل عرضه إلى 20 سم؛ السطح الخصب داخل الكأس به تجاعيد تشع من المركز؛ يمكن الخلط بينه وبين الفطر…)",
 "cup of tea": "اهتمام, تخصص (نشاط تحبه أو تتفوق فيه)\nمثال: الكيمياء ليست من اهتماماتي",
 "cup tie": "مباراة إقصائية, مباراة الكأس (مباراة إقصائية بين الفرق في مسابقة الكأس)",
 "cupal": "كوبال (طلاء من النحاس والألومنيوم)",
 "cupbearer": "سَاقٍ, سَاقِيَة",
 "cupboard": "خِزَانَة (مكان الخَزْن؛ قطعة أثاث للخَزْن)\nمثال: اقترب من الخزانة.",
 "cupboard love": "حب مصلحة (إظهار المودة بدافع الأنانية)",
 "cupcake": "كب كيك, كعكة كوبية (كعكة صغيرة تخبز في قالب المافن)",
 "cupel": "بوتقة التمحيع (وعاء مسامي صغير مصنوع من رماد العظام يستخدم في فحص المعادن لفصل المعادن الثمينة عن الرصاص)",
 "cupflower": "زهرة الكأس, نيرمبيرجيا / زهرة البوق, سولاندرا (نبات متسلق دائم الخضرة مكسيكي له زهور صفراء عطرة كبيرة قمعية الشكل مفردة مع حواف بنية أرجوانية في الحلق)",
 "cupful": "كوب, ملء كوب (الكمية التي يستوعبها كوب)\nمثال: شرب كوباً من القهوة",
 "cupid": "كْيُوبِيد",
 "cupid's bow": "قوس كيوبيد (قوس منحني بنهايات منحنية عكسية) / قوس كيوبيد (المنحنى المزدوج للشفة العليا عندما يشبه قوس كيوبيد)",
 "cupid's dart": "سهم كيوبيد, هندباء زرقاء (نبات جنوب أوروبي ذو زهور داكنة العين بأشعة زرقاء مسطحة)",
 "cupid's disease": "مرض تناسلي, مرض منقول جنسياً (عدوى سارية تنتقل عن طريق الاتصال الجنسي)",
 "cupid's itch": "مرض تناسلي, مرض منقول جنسياً (عدوى سارية تنتقل عن طريق الاتصال الجنسي)",
 "cupidity": "بخل, جشع (جشع شديد للثروة المادية)",
 "cuplike": "كَأْسِيُّ الشَّكْل (يشبه شكل الكأس في تقعّره)",
 "cupola": "قُبَّة",
 "cuppa": "كوب شاي (كوب من الشاي)",
 "cupper": "كوب شاي (كوب من الشاي)",
 "cupping": "حِجَامَة, حَجَامَة",
 "cupping glass": "مِحْجَم",
 "cupressus abramsiana": "سرو سانتا كروز (سرو نادر في كاليفورنيا أطول من سرو غوين ولكنه وثيق الصلة به ويعتبر أحياناً نفس النوع)",
 "cupressus arizonica": "سرو أريزونا (شجرة خشب من أريزونا بأوراق فضية مزرقة)",
 "cupressus goveniana": "سرو غوين (شجرة صغيرة شجيرية أحياناً موطنها كاليفورنيا؛ تستخدم غالباً للزينة؛ في بعض أنظمة التصنيف تشمل السرو القزم وسرو سانتا كروز)",
 "cupressus goveniana abramsiana": "سرو سانتا كروز (سرو نادر في كاليفورنيا أطول من سرو غوين ولكنه وثيق الصلة به ويعتبر أحياناً نفس النوع)",
 "cupressus goveniana pigmaea": "سرو قزم (سرو صغير نادر موطنه شمال كاليفورنيا؛ يعتبر أحياناً نفس نوع سرو غوين)",
 "cupressus guadalupensis": "سرو غوادالوبي (شجرة منخفضة نسبياً واسعة الانتشار متوطنة في جزيرة غوادالوبي؛ تزرع لأوراقها المزرقة)",
 "cupressus lusitanica": "سرو برتغالي, سرو مكسيكي (شجرة دائمة الخضرة طويلة منتشرة توجد في المكسيك ولها فروع متدلية؛ يعتقد أنها أدخلت إلى البرتغال من غوا)",
 "cupressus macrocarpa": "سرو مونتيري (سرو كاليفورنيا طويل متوطن في خليج مونتيري؛ يستخدم على نطاق واسع للزينة وكذلك لإعادة التحريج وزراعة أحزمة الوقاية)",
 "cupressus pigmaea": "سرو قزم (سرو صغير نادر موطنه شمال كاليفورنيا؛ يعتبر أحياناً نفس نوع سرو غوين)",
 "cupressus sempervirens": "سرو إيطالي, سرو المتوسط (سرو أوراسي طويل بلحاء رمادي رقيق وفروع صاعدة)",
 "cupric": "نحاسوزي, نحاسي (مكون من أو محتوٍ على نحاس ثنائي التكافؤ)",
 "cupric acetate": "زنجار (مسحوق أزرق أو أخضر يستخدم كخضاب للطلاء)",
 "cupric sulfate": "كبريتات النحاس (ملح نحاس يصنع بفعل حمض الكبريتيك على أكسيد النحاس)",
 "cupric sulphate": "كبريتات النحاس (ملح نحاس يصنع بفعل حمض الكبريتيك على أكسيد النحاس)",
 "cuprimine": "بنسيلامين, كوبريمين (دواء (الاسم التجاري كوبريمين) يستخدم لعلاج التسمم بالمعادن الثقيلة ومرض ويلسون والتهاب المفاصل الشديد)",
 "cuprite": "كوبريت (معدن يتكون من أكسيد النحاسوز وهو مصدر للنحاس)",
 "cupronickel": "سبيكة النحاس والنيكل, كوبرونيكل (سبيكة بنسبة 60/40 من النحاس والنيكل)",
 "cuprous": "نحاسوزي, نحاسي (مكون من أو محتوٍ على نحاس ثنائي التكافؤ)",
 "cupular": "قُبَيْعِيّ, كُؤَيْسِيّ (على شكل قُبيعة أو كُؤيس أو يحملها)",
 "cupulate": "قُبَيْعِيّ, كُؤَيْسِيّ (على شكل قُبيعة أو كُؤيس أو يحملها)",
 "cupule": "كويب (ممص على أقدام بعض الذباب) / قبيبة, كأس البلوط (هيكل على شكل كوب من القنابات المتصلبة عند قاعدة البلوط)",
