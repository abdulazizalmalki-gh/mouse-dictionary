 "coverage": "تَغْطِيَة (وضع شيء فوق آخر لإخفائه أو حمايته؛ معالجة ونقل أخبار حدث أو موضوع معين ونشره لجمهور أو ما يصطلح عليه بالتغطية الإعلامية)\nمثال: تمت تغطية زيري.",
 "coverall": "أوفرهول, رداء شامل (ملابس واقية فضفاضة تلبس فوق ملابس أخرى)",
 "covered": "مُغَطًّى",
 "covered bridge": "جسر مسقوف (جسر يكون ممره محمياً بسقف وجوانب مغلقة)",
 "covered couch": "محفّة مغطاة (محفّة ذات غطاء لتوفير الخصوصية)",
 "covered option": "خيار مغطى (خيار بيع أو شراء مدعوم بالأسهم التي يقوم عليها الخيار)",
 "covered smut": "تفحم مغطى (فطر تفحم يسبب مرض التفحم في الحبوب حيث تكون كتل الأبواغ مغطاة أو متماسكة بواسطة أغشية الحبوب)",
 "covered stadium": "قبة رياضية, ملعب مغطى (ملعب له سقف)",
 "covered stand": "مُدَرَّج مُغَطَّى, مِنَصَّة رَئِيسِيَّة (موقف في مضمار سباق أو ملعب يتكون من طبقات بها صفوف من المقاعد الفردية تحت سقف واقٍ)",
 "covered wagon": "عربة كونستوجا, عربة مغطاة (عربة كبيرة بعجلات عريضة وسقف قماشي مقوس؛ استخدمها الرواد الأمريكيون لعبور البراري في القرن التاسع عشر)",
 "covering": "تطبيق, طلاء (عمل وضع شيء (على سطح)) / تغطية (فعل حماية شيء ما بتغطيته) / تغطية, حجب (فعل إخفاء وجود شيء ما عن طريق حجب رؤيته) / غِطَاء (مصنوعة تُغطّي شيئًا آخر عادةً لحمايته أو إيوائه أو إخفائه)\nمثال: وصف الطبيب وضعاً موضعياً لليود",
 "covering fire": "تغطية نارية, نيران التغطية (نيران تجعل من الصعب على العدو إطلاق النار على أفرادك أو تشكيلاتك)\nمثال: وفرت المدفعية نيران تغطية للانسحاب",
 "covering letter": "خطاب تغطية (رسالة ترسل مع وثائق أخرى لتقديم معلومات إضافية)",
 "covering material": "مادة تغطية, مادة كساء (مادة يستخدمها البناؤون لتغطية الأسطح)",
 "coverlet": "غطاء سرير مبطن, لحاف مزخرف (مفرش سرير مزخرف (عادة ما يكون مبطناً))",
 "covert": "خفي, سري (سري أو مخفي؛ لا يُمارس أو يُشارك فيه أو يُظهر علانية) / فِي كَنَف الزَّوْج ((عن الزوجة) تحت حماية زوجها) / ستار, غطاء (غطاء يعمل على إخفاء أو حماية شيء ما) / سرب غُرّ (سرب من طيور الغُرّ)\nمثال: عمليات سرية للمخابرات المركزية",
 "covert operation": "عملية سرية, عملية مغطاة (عملية استخباراتية مخطط لها بحيث تسمح بإنكار معقول من قبل الراعي)",
 "covertly": "خفية, سراً (بطريقة سرية)\nمثال: فعل ذلك سراً",
 "covertness": "استتار, خفاء (حالة كونه خفياً ومستتراً)",
 "covet": "طَمُعَ, طَمِعَ",
 "coveted": "مَرْغُوب, مَطْلُوب (مَطْلُوبٌ كَثِيرًا)",
 "covetous": "طَمَّاع, حَسُود",
 "covetously": "بِجَشَع, بِطَمَع (بطريقة جشعة) / بِحَسَد, بِغَيْرَة (مع الغيرة؛ بطريقة حاسدة)\nمثال: نظر إلى سيارة صديقه الجديدة بحسد",
 "covetousness": "بخل, جشع (رغبة مذمومة في التملك؛ رغبة لا تشبع في الثروة (تُشخص كإحدى الخطايا السبع المميتة)) / بخل, جشع (جشع شديد للثروة المادية) / اشتهاء, طمع (رغبة حسودة في الامتلاك)",
 "covey": "رُفْقَة, سرب صغير (سرب صغير من طيور القطا أو الحجل) / جماعة صغيرة, زمرة (مجموعة صغيرة من الناس)",
 "covid-19": "كوفيد-19, كوڤيد-19",
 "coville": "شجيرة الكريوسوت, لاريا (شجيرة صحراوية في جنوب غرب الولايات المتحدة ونيو مكسيكو لها أوراق عطرية راتنجية دائمة وزهور صفراء صغيرة)",
 "cow": "بَقَرَة, بقرة (اسم؛ حيوان أليف ذو أربع قوائِم مشقوق الظلف ذلول يستخدمه الناس للحرث وبعض الأعمال الأخرى…؛ اسم؛ حيوان من فصيلة البقريات، قد يكون البَقَرَة الأهلية أو غيرها مثل الجاموس. يطلق على الذكر والأنثى) / بَقَرَة, بَقَر (اسم؛ حيوان أليف ذو أربع قوائِم مشقوق الظلف ذلول يستخدمه الناس للحرث وبعض الأعمال الأخرى…؛ اسم؛ حيوان من فصيلة البقريات، قد يكون البَقَرَة الأهلية أو غيرها مثل الجاموس. يطلق على الذكر والأنثى)\nمثال: زيري لديه بقرة.",
 "cow barn": "حظيرة أبقار (حظيرة للأبقار)",
 "cow brush": "فرشاة الأبقار (فرشاة ثابتة أو دوارة تتكون عادة من فرشاة أفقية وأخرى رأسية تستخدمها الأبقار للحك والتنظيف)",
 "cow chip": "جلة, روث البقر (قطعة من روث البقر المجفف)",
 "cow cockle": "فاكاريا, فوقس (نبات حولي أوروبي بزهور وردية باهتة؛ زهرة مزروعة أو عشب ذاتي البذر في حقول الحبوب؛ أدخل إلى أمريكا الشمالية؛ يصنف أحياناً كصابونية)",
 "cow dung": "جلة, روث البقر (قطعة من روث البقر المجفف)",
 "cow lily": "زنبق البرك الأصفر, زنبق البقر (زنبق ماء شائع في شرق ووسط أمريكا الشمالية، ذو أوراق عريضة وأزهار صفراء كروية الشكل؛ يعيش في المياه العذبة الراكدة أو قليلة الملوحة)",
 "cow man": "مربي ماشية (رجل يربي (أو يرعى) الماشية)",
 "cow manure": "روث البقر, سماد البقر (فضلات الأبقار المستخدمة كسماد)",
 "cow moose": "أَمْوَاظ",
 "cow oak": "سنديان البقر, سنديان السلال (شجرة نفضية متوسطة إلى كبيرة الحجم موطنها شرق الولايات المتحدة؛ يستخدم خشبها المتين كأخشاب بناء أو يُشطر ويُنسج في سلال أو مقاعد كراسي)",
 "cow parsley": "بقدونس البقر, سرفيل بري (عشب ثنائي الحول خشن قائم من العالم القديم أدخل كعشب ضار في شرق أمريكا الشمالية)",
 "cow parsnip": "جزر البقر, هرقلية (نبات خشن طويل له سيقان سميكة وعنقود من الزهور البيضاء إلى الأرجوانية)",
 "cow pasture": "مرعى أبقار (مرعى للأبقار)",
 "cow pen": "حظيرة أبقار, زريبة بقر (حظيرة للأبقار)",
 "cow pie": "روث البقر (المادة البرازية للبقرة)",
 "cow pony": "مهر البقر (حصان ركوب خفيف مدرب لرعي الماشية)",
 "cow shark": "قرش البقر, قرش سداسي الخياشيم (قرش بدائي كبير موزع على نطاق واسع في البحار الدافئة)",
 "cow town": "بلدة المواشي (بلدة صغيرة في منطقة تربية الماشية في غرب أمريكا الشمالية)",
 "cow's head": "موريل نصف حر (موريل جزؤه الخصب ذو النتوءات والحفر متصل بالساق لنحو نصف طوله)",
 "cow-nosed ray": "لخمة أنف البقرة (لخمة كبيرة توجد على طول الساحل الشرقي لأمريكا الشمالية)",
 "cow-tongue fern": "سرخس الشريط الفلوريدي, سرخس لسان البقر (سرخس هوائي أو أرضي أحياناً شائع ذو أوراق شريطية خضراء مصفرة شاحبة؛ من فلوريدا إلى جزر الهند الغربية والمكسيك وجنوباً إلى أوروغواي)",
 "cowage": "فاصولياء مخملية, ميقونة (كرمة خشبية حولية من آسيا لها عناقيد طويلة من الزهور الأرجوانية وقرون مشعرة كثيفة؛ تزرع في جنوب الولايات المتحدة للسماد الأخضر والرعي) / قرن المخمل (قرون نبات المخمل أو الشعيرات اللاسعة التي تغطيها؛ تستخدم كطارد للديدان عند مزجها بالعسل)",
 "coward": "جَبَان (شديد الخوف ممتنع عن الإقدام؛ ضد الشجاع)\nمثال: إيدير مجرد جبان.",
 "cowardice": "جَبَانَة",
 "cowardliness": "جبن, خوار (سمة الافتقار للشجاعة)",
 "cowardly": "جَبَان (شديد الخوف ممتنع عن الإقدام؛ ضد الشجاع)\nمثال: إيدير مجرد جبان.",
 "cowbarn": "حظيرة أبقار (حظيرة للأبقار)",
 "cowbell": "جرس البقر (جرس يعلق حول رقبة البقرة بحيث يمكن تحديد مكانها بسهولة)",
 "cowberry": "عنب الثور (توت أحمر لاذع يشبه التوت البري الأمريكي ولكنه أصغر) / توت البقر, توت الجبل الأحمر (شجيرة منخفضة دائمة الخضرة من المناطق المعتدلة الشمالية العالية في أوروبا وآسيا وأمريكا تحمل توتاً أحمر صالحاً للأكل)",
 "cowbird": "طائر البقر (شحرور من أمريكا الشمالية يتبع الماشية ويضع بيضه في أعشاش الطيور الأخرى)",
 "cowboy": "رَاعِي بَقَر, رَعَوِيّ الْبَقَر",
 "cowboy boot": "حذاء رعاة البقر (حذاء ذو قوس مرتفع وخياطة مزخرفة؛ يرتديه رعاة البقر الأمريكيون)",
 "cowboy hat": "قبعة رعاة البقر (قبعة بحافة واسعة وتاج ناعم؛ يرتديها عمال المزارع الأمريكية)",
 "cowcatcher": "كانسة عقبات",
 "cowfish": "سمكة البقرة (سمكة صندوقية لها أشواك تشبه القرون فوق العينين)",
 "cowgirl": "راعية بقر (امرأة تعمل في رعي البقر) / راعية بقر, مؤدية روديو (مؤدية أنثى تقدم عروضاً للركوب واستخدام الحبال ومصارعة الثيران)",
 "cowhand": "راعي بقر (عامل مستأجر يرعى الماشية ويؤدي واجبات أخرى على ظهور الخيل)",
 "cowherb": "فاكاريا, فوقس (نبات حولي أوروبي بزهور وردية باهتة؛ زهرة مزروعة أو عشب ذاتي البذر في حقول الحبوب؛ أدخل إلى أمريكا الشمالية؛ يصنف أحياناً كصابونية)",
 "cowherd": "راعي بقر (عامل مستأجر يرعى الماشية ويؤدي واجبات أخرى على ظهور الخيل)",
 "cowhide": "سوط من جلد البقر (سوط مرن ثقيل مضفر من الجلد المصنوع من جلد البقر) / جلد البقر (إهاب البقرة) / جلد بقري (جلد مصنوع من إهاب البقرة)",
 "cowhouse": "حظيرة أبقار (حظيرة للأبقار)",
 "cowl": "قلنسوة الراهب (غطاء رأس فضفاض أو رداء بغطاء رأس (كما يرتديه الراهب)) / غطاء المحرك (غطاء واقٍ يتكون من جزء معدني يغطي المحرك)\nمثال: توجد محركات قوية تحت أغطية السيارات الجديدة",
 "cowl muscle": "عضلة شبه منحرفة (إحدى عضلتين مثلثتين مسطحتين للكتف وأعلى الظهر تشاركان في تحريك الكتفين والذراعين)",
 "cowl-shaped": "قَلَنْسَوِيّ الشَّكْل (على شكل قَلَنْسُوَة)",
 "cowled": "مُقَلْنَس (مغطى الرأس بقلنسوة)",
 "cowlick": "خُصْلَة مُتَمَرِّدَة, لَحْسَةُ بَقَرَة (خصلة شعر تنمو في اتجاه مختلف عن بقية الشعر وعادة لا تستقر بشكل مسطح)",
 "cowling": "غطاء المحرك (غطاء واقٍ يتكون من جزء معدني يغطي المحرك)\nمثال: توجد محركات قوية تحت أغطية السيارات الجديدة",
 "cowman": "راعي بقر, راعي ماشية (عامل أجير ذكر يرعى الماشية ويؤدي واجبات أخرى على ظهر الخيل)",
 "cownose ray": "لخمة أنف البقرة (لخمة كبيرة توجد على طول الساحل الشرقي لأمريكا الشمالية)",
 "coworker": "زَمِيل, زَمِيلَة",
 "cowpea": "لوبياء, لوبياء سوداء العين (تؤكل طازجة كفاصولياء مقشرة أو مجففة) / بازلاء سوداء العين, لوبياء (نبات حولي متمدد من العالم القديم يزرع خاصة في جنوب الولايات المتحدة للغذاء والعلف وكسماد أخضر) / لوبياء (فاكهة أو بذرة نبات اللوبياء)",
 "cowpea plant": "بازلاء سوداء العين, لوبياء (نبات حولي متمدد من العالم القديم يزرع خاصة في جنوب الولايات المتحدة للغذاء والعلف وكسماد أخضر)",
 "cowpen daisy": "أقحوان الزبدة (عشب حولي خشن رمادي مخضر أصفر الزهور؛ جنوب غرب الولايات المتحدة إلى المكسيك)",
 "cowper's gland": "غُدَّة كَوْبَر",
 "cowpie": "روث البقر (المادة البرازية للبقرة)",
 "cowpoke": "راعي بقر (عامل مستأجر يرعى الماشية ويؤدي واجبات أخرى على ظهور الخيل)",
 "cowpox": "جدري البقر (مرض فيروسي يصيب الماشية يسبب مرضاً جلدياً خفيفاً يؤثر على الضرع؛ كان يستخدم سابقًا لتلقيح البشر ضد الجدري)",
 "cowpuncher": "راعي بقر (عامل مستأجر يرعى الماشية ويؤدي واجبات أخرى على ظهور الخيل)",
 "cowrie": "ودع",
 "cowry": "ودعة",
 "cows": "أبقار, ماشية (الحيوانات البقرية المستأنسة كمجموعة بغض النظر عن الجنس أو العمر)\nمثال: عدد كبير من رؤوس الماشية",
 "cows' milk": "حليب البقر (الحليب الذي يتم الحصول عليه من الأبقار الحلوب)",
 "cowshed": "حظيرة أبقار (حظيرة للأبقار)",
 "cowskin": "جلد بقري (جلد مصنوع من إهاب البقرة)",
 "cowslip": "آذريون المستنقع, قطيفة المستنقع (نبات مستنقعات من أوروبا وأمريكا الشمالية ذو أزهار صفراء زاهية تشبه الحوذان) / زهرة الربيع, كعب الثلج (زهرة ربيعية مبكرة شائعة في الجزر البريطانية ذات أزهار عطرة صفراء أو أرجوانية أحياناً)",
 "cowtown": "بلدة المواشي (بلدة صغيرة في منطقة تربية الماشية في غرب أمريكا الشمالية)",
 "cox": "ربان القارب, كوكس (موجه قارب السفينة أو طاقم السباق) / سيكلوأكسيجيناز (أحد إنزيمين مرتبطين يتحكمان في إنتاج البروستاغلاندين ويتم حظرهما بواسطة الأسبرين)",
 "cox's bazar": "كُوكْس بَازَار, فَالَنْكِي",
 "cox's bazar district": "ضِلْع كُوكْس بَازَار",
 "cox's orange pippin": "تفاح كوكس البرتقالي (تفاح بيبين أصفر ذو نكهة مميزة)",
 "cox-1": "سيكلوأكسيجيناز-1 (إنزيم ينظم البروستاغلاندينات المهمة لصحة بطانة المعدة والكلى)",
 "cox-2": "سيكلوأكسيجيناز-2 (إنزيم يصنع البروستاغلاندينات التي تسبب الالتهاب والألم والحمى)",
 "cox-2 inhibitor": "مثبط كوكس-2 (دواء مضاد للالتهابات يحارب الألم ويمنع نشاط كوكس-2 دون إعاقة نشاط كوكس-1؛ يزيد من خطر النوبات القلبية)\nمثال: مثبطات كوكس-2 تقلل من أعراض التهاب المفاصل دون تعريض المعدة والكلى للخطر",
 "coxa": "مفصل الورك, ورك (المفصل الكروي بين رأس عظم الفخذ والحق)",
 "coxcomb": "عرف (العرف اللحمي الأحمر على رأس الدجاج الداجن وغيره من الطيور الداجنة) / قبعة المهرج (قبعة يرتديها مهرجو البلاط؛ مزينة بشريط أحمر) / متأنق مغرور (متأنق مغرور معجب جداً بإنجازاته الخاصة)",
 "coxsackie virus": "فيروس كوكساكي (فيروس معوي يسبب مرضاً يشبه شلل الأطفال ولكن بدون شلل)",
 "coxsackievirus": "فيروس كوكساكي (فيروس معوي يسبب مرضاً يشبه شلل الأطفال ولكن بدون شلل)",
 "coxswain": "ربان القارب, كوكس (موجه قارب السفينة أو طاقم السباق)",
 "coy": "مُتَحَفِّظ, مُتَمَنِّع (يرفض المقاربات أو العروض بتحفظ أو حذر) / مُتَمَنِّع, مُرَاوِغ (يُظْهِرُ تَهَرُّبًا مَلْحُوظًا وَمُمَازَحًا مِنْ إِصْدَارِ تَصْرِيحٍ قَاطِع) / خَجُولٌ تَصَنُّعًا, مُتَدَلِّل (يَتَصَنَّعُ الحَيَاءَ أَوِ الخَجَلَ بِشَكْلٍ مُغَازِلٍ أَوْ مُثِير)",
 "coydog": "كويدوغ (نسل ناتج عن تزاوج ذئب القيوط والكلب)",
 "coyly": "بِتَمَنُّع, بِدَلَال (بطريقة دلال)\nمثال: تأففت ونظرت إليه بدلال",
 "coyness": "تَمَنُّع, دَلَال (التظاهر بالخجل أو الاحتشام بطريقة مثيرة)",
 "coyol": "نخيل كويول (نخيل استوائي أمريكي له مكسرات صالحة للأكل وينتج أليافاً مفيدة)",
 "coyol palm": "نخيل كويول (نخيل استوائي أمريكي له مكسرات صالحة للأكل وينتج أليافاً مفيدة)",
 "coyote": "قَيُّوط",
 "coyote brush": "شجيرة القيوط, فرشاة القيوط (شجيرة دائمة الخضرة واسعة الانتشار في جنوب غرب الولايات المتحدة ذات رؤوس زهور في عنقود ورقي)",
 "coyote bush": "شجيرة القيوط, فرشاة القيوط (شجيرة دائمة الخضرة واسعة الانتشار في جنوب غرب الولايات المتحدة ذات رؤوس زهور في عنقود ورقي)",
 "coypu": "كيب, نوتريا (قارض مائي من أمريكا الجنوبية يشبه قندساً صغيراً؛ يُربى من أجل فرائه)",
 "cozenage": "خدعة, مخطط احتيالي (مخطط تجاري احتيالي)",
 "cozily": "بألفة, بشكل مريح (بطريقة مريحة وحميمة)\nمثال: استقر بألفة بجوار النار",
 "coziness": "حميمية, دفء وراحة (حالة من الراحة الدافئة)",
 "cozy": "تَوَاطُؤِيّ, حَمِيمِيّ (يوحي بالتواطؤ أو التآمر) / دَافِئ, مُرِيح (يوفر دفئاً مريحاً ومأوى خاصة في مكان صغير) / أَلِيف, حَمِيمِيّ (يُوَفِّرُ جَوًّا دَافِئًا وَوُدِّيًّا وَغَيْر رَسْمِيّ) / غطاء إبريق الشاي (غطاء قماشي مبطن للحفاظ على دفء إبريق الشاي)",
 "cpa": "محاسب قانوني معتمد (محاسب اجتاز اختبارات معينة واستوفى جميع المتطلبات القانونية والترخيص في ولاية أمريكية ليكون معتمداً من تلك الولاية)\nمثال: بالإضافة إلى المحاسبة والتدقيق، يقوم المحاسبون القانونيون المعتمدون بإعداد الإقرارات الضريبية للأفراد والشركات",
 "cpi": "استبيان كاليفورنيا للشخصية / مؤشر أسعار المستهلك (مؤشر لتكلفة جميع السلع والخدمات للمستهلك النموذجي)",
 "cpr": "إنعاش قلبي رئوي (إجراء طوارئ يتكون من تدليك القلب الخارجي والتنفس الاصطناعي)",
 "cps": "دَوْرَة فِي الثَّانِيَة, هَرْتز (وحدة التردد؛ الهرتز الواحد له فترة دورية تبلغ ثانية واحدة (سميت تيمناً بـ هاينريش رودولف هرتز))",
 "cpu": "المعالج, المعالج المركزي ((علوم الحاسوب) جزء من الحاسوب (شريحة المعالج الدقيق) يقوم بمعظم معالجة البيانات)\nمثال: تشكل وحدة المعالجة المركزية والذاكرة الجزء المركزي من الكمبيوتر الذي يتم توصيل الأجهزة الطرفية به",
 "cpu board": "اللوحة الأم, لوحة المعالج (لوحة الدوائر الرئيسية للحاسوب)",
 "cr": "كروم, كروميوم (عنصر فلزي صلب هش متعدد التكافؤ؛ مقاوم للتآكل وفقدان البريق)",
 "crab": "سَرَطَان, سَلْطَعون",
 "crab apple": "تفاح بري (تفاح حامض صغير؛ مناسب للحفظ) / تفاح بري (أي من أشجار التفاح البري العديدة عادة بفاكهة حمضية صغيرة) / تفاح بري مزروع (أي من الأصناف العديدة من التفاح البري تزرع لفاكهتها الصغيرة الحمضية (عادة حمراء زاهية) المستخدمة للمربيات أو للزينة لزهورها)\nمثال: يصنع التفاح البري هلامًا منعشًا",
 "crab cactus": "صبار السلطعون, صبار عيد الشكر (صبار مفصلي من أمريكا الجنوبية ذو أزهار حمراء عادة؛ غالباً ما يزرع كنبات منزلي)",
 "crab cocktail": "كوكتيل السلطعون (كوكتيل من لحم السلطعون المطبوخ البارد وصلصة)",
 "crab grass": "عشب الإصبع, عشب السلطعون (أعشاب ذات سيقان زاحفة تتجذر بحرية؛ تعتبر آفة في المروج)",
 "crab legs": "أرجل السلطعون (أرجل سلطعون الملك الألاسكي خاصة)",
 "crab louis": "كراب لويس (خس ولحم سلطعون متبل بصلصة لويس)",
 "crab louse": "قملة العانة (قملة تغزو منطقة العانة في جسم الإنسان)",
 "crab-eating dog": "ثعلب آكل السرطان, كلب آكل السرطان (كلب بري من شمال أمريكا الجنوبية)",
 "crab-eating fox": "ثعلب آكل السرطان, كلب آكل السرطان (كلب بري من شمال أمريكا الجنوبية)",
 "crab-eating macaque": "مكاك آكل السرطان, مكاك طويل الذيل (قرد يعيش في جنوب شرق آسيا وبورنيو والفلبين)",
 "crab-eating opossum": "أبوسوم آكل السرطان (أبوسوم من أمريكا الجنوبية)",
 "crab-eating raccoon": "راكون آكل السرطان (نوع من الراكون يعيش في أمريكا الجنوبية)",
 "crab-eating seal": "فقمة آكلة السرطان (فقمة قطبية جنوبية رمادية فضية تعيش على القشريات)",
 "crabapple": "تفاح بري (تفاح حامض صغير؛ مناسب للحفظ) / تفاح بري (أي من أشجار التفاح البري العديدة عادة بفاكهة حمضية صغيرة) / تفاح بري مزروع (أي من الأصناف العديدة من التفاح البري تزرع لفاكهتها الصغيرة الحمضية (عادة حمراء زاهية) المستخدمة للمربيات أو للزينة لزهورها)\nمثال: يصنع التفاح البري هلامًا منعشًا",
 "crabapple jelly": "هلام التفاح البري (هلام تفاح لاذع مصنوع من التفاح البري)",
 "crabbed": "عَبُوس, مُتَذَمِّر (مُنزعج وسريع الانفعال)",
 "crabbedness": "تجهم, حدة الطبع (الميل لأن يكون المرء سيء المزاج)",
 "crabbiness": "تجهم, حدة الطبع (الميل لأن يكون المرء سيء المزاج)",
 "crabby": "عَبُوس, مُتَذَمِّر (مُنزعج وسريع الانفعال)",
 "crabby person": "مشاكس, نكد (شخص نكد محب للشجار)",
 "crabeater seal": "فقمة آكلة السرطان (فقمة قطبية جنوبية رمادية فضية تعيش على القشريات)",
 "crabgrass": "عشب الإصبع, عشب السلطعون (أعشاب ذات سيقان زاحفة تتجذر بحرية؛ تعتبر آفة في المروج)",
 "crabmeat": "سلطعون, كابوريا (اللحم الصالح للأكل لأي من السرطانات المختلفة)",
 "crabs": "قمل العانة (إصابة شعر العانة بقمل العانة)",
 "crabwise": "جَانِبِيّ, مُنْحَرِفُ الحَرَكَة ((لِلْحَرَكَة) بِزَاوِيَة)",
 "crack": "صَدْع ((صَدَعَ) النباتُ الأرضَ يَصْدَعَ صَدْعًا: شَقَّها وظَهَرَ منها؛ (صَدَعَ) الزجاجَ ونحوه: كسره)",
 "crack addict": "مدمن كراك (شخص مدمن على كراك الكوكايين)",
 "crack cocaine": "كراك, كوكايين صخري (شكل نقي وقوي من الكوكايين يتم تدخينه بدلاً من استنشاقه؛ يسبب الإدمان بشدة)",
 "crack of doom": "يوم الحساب, يوم الدين (اليوم في نهاية الزمان الذي سيقضي فيه الله بمصير جميع البشر وفقاً لأعمالهم)",
 "crack shot": "رامي ماهر, قناص (شخص ماهر في الرماية)",
 "crack willow": "صفصاف هش (شجرة صفصاف كبيرة ذات فروع صلبة تنكسر بسهولة)",
 "crack-up": "انهيار (انهيار عقلي أو جسدي)",
 "crackbrained": "أَبْلَه, أَحْمَق (غير مسؤول إلى حدّ الجنون)",
 "crackdown": "قَمْع",
 "cracked": "مَخْبُول, مَعْتُوه ((غير رسمي) مصطلحات عامّيّة تصف الاضطراب العقليّ) / مُتَشَقِّق ((للطلاء أو الورنيش) ذو مظهر متشقّق يشبه جلد التمساح) / خَشِن, مُتَشَقِّق (متشقّق وخشن السطح بفعل الجفاف أو البرد)",
 "cracked wheat": "قمح مجروش (حبوب القمح التي تم تكسيرها إلى قطع صغيرة)",
 "cracked-wheat bread": "خبز القمح المجروش (خبز مصنوع من القمح المجروش الذي تم طحنه ناعماً)",
 "cracker": "مفرقعة حفلات (هدية حفلات تتكون من لفافة ورقية (تحتوي عادة على حلوى أو هدية صغيرة) تنفجر عند سحبها من كلا الطرفين) / مفرقعة, مفرقعة نارية (لعبة نارية تتكون من شحنة متفجرة صغيرة وفتيل داخل غلاف ورقي سميك) / بسكويت مملح, رقاقة مقرمشة (رقاقة رقيقة مقرمشة مصنوعة من الدقيق والماء مع أو بدون تخمير ودهن؛ غير محلاة أو شبه محلاة) / كراكر, مخترق خبيث (مبرمج يخترق الحواسيب (وصول غير مصرح به)، عادة للقيام بأمور خبيثة)\nمثال: غالباً ما يطلق على الكراكرز اسم هاكرز عن طريق الخطأ",
 "cracker bonbon": "مفرقعة حفلات (هدية حفلات تتكون من لفافة ورقية (تحتوي عادة على حلوى أو هدية صغيرة) تنفجر عند سحبها من كلا الطرفين)",
 "cracker crumbs": "فتات البسكويت المملح (فتات البسكويت يستخدم خاصة للتغطية أو التثخين)",
 "cracker-barrel": "بَسِيط, شَعْبِيّ (يتّسم بطابع الحياة الريفيّة البسيطة والعفويّة)",
 "crackerberry": "توت البودنغ, قرانيا قزمية (عشب معمر زاحف يتميز بتوت أحمر ودوامات أوراق عنقودية عند أطراف البراعم؛ غرينلاند إلى ألاسكا)",
 "crackerjack": "تحفة, شيء رائع (شيء ممتاز من نوعه) / بارع, شخص ممتاز (شخص ممتاز من نوعه)\nمثال: كانت الدراجة تحفة فنية",
 "crackers": "مَخْبُول, مَعْتُوه ((غير رسمي) مصطلحات عامّيّة تصف الاضطراب العقليّ)",
 "cracking": "تصدع, شرخ (عملية إحداث شقوق في شيء ما) / رَائِع, مُمْتَاز (ممتاز؛ بالغ الجودة) / تصدع, طرقعة (ضجيج حاد مفاجئ) / تكسير (العملية التي يتم فيها تكسير جزيئات النفتا أو البترول الثقيلة إلى هيدروكربونات ذات وزن جزيئي أقل (خاصة في عملية تكرير النفط))\nمثال: طرقعة سوط",
 "crackle": "مُتَشَقِّق الطِّلَاء (سطحه مُزيَّن بشبكة من الشقوق الدقيقة كما في الخزف المتشقّق) / خزف مشقق (خزف مصقول بشبكة من الشقوق الدقيقة على السطح) / طقطقة, فرقعة (الصوت الحاد لأصوات الانكسار)",
 "crackle china": "خزف مشقق (خزف مصقول بشبكة من الشقوق الدقيقة على السطح)",
 "crackleware": "خزف مشقق (خزف مصقول بشبكة من الشقوق الدقيقة على السطح)",
 "crackling": "طقطقة, فرقعة (الصوت الحاد لأصوات الانكسار) / بقايا الشحم (البقايا التي تتبقى بعد إذابة الدهون الحيوانية)",
 "cracklings": "قشور الدهن المقلية (البقايا المقرمشة المتبقية بعد إذابة الشحم)",
 "crackpot": "مَخْبُول, مَعْتُوه (شخص غريب الأطوار بشكل هزلي أو مجنون)",
 "cracksman": "كسار الخزائن, لص الخزائن (لص ذكر يكسر الخزائن لسرقة محتوياتها الثمينة)",
 "crackswoman": "كسارة خزائن (لصة أنثى تكسر الخزائن لسرقة محتوياتها الثمينة)",
 "cradle": "مَهْد",
 "cradle cap": "قبعة المهد (التهاب جلد فروة الرأس الشائع عند الرضع)",
 "cradlesong": "تهويدة (فعل غناء أغنية هادئة لتنويم الطفل) / تهويدة (أغنية هادئة تهدف إلى تنويم الطفل)",
 "craft": "حِرْفَة, صَنْعَة",
 "craft fair": "معرض حرف يدوية (معرض تُعرض فيه الأشياء التي صنعها الحرفيون للبيع)",
 "craft union": "نقابة حرفية (نقابة عمالية تقتصر عضويتها على العمال في حرفة معينة)",
 "crafter": "حِرَفِيّ, صانع ماهر (مبدع ذو مهارة عالية في الفنون اليدوية)\nمثال: صُنعت المجوهرات بواسطة حرفيين مشهورين عالمياً",
 "craftily": "بِاحْتِيَال, بِخُبْث (بطريقة خفية وماكرة)\nمثال: رتب بمكر ليكون هناك عندما أعلن القرار",
 "craftiness": "خديعة, دهاء (صفة الدهاء والمكر) / خبث, خديعة (الدهاء الذي يظهر من خلال المهارة في الخداع)",
 "craftsman": "صَانِع (كل من يَصْنَعُ شيئا؛ من يَمْتَهِنُ الصِّنَاعَة) / حِرَفِيّ / حِرْفِيّ\nمثال: أحب أن أكون صانع محتوى.",
 "craftsmanship": "إتقان, حرفة (المهارة في مهنة أو تجارة)",
 "craftsperson": "حرفي بارع, صنايعي (مهني عمله ذو جودة عالية باستمرار)\nمثال: كممثل، كان حرفياً بارعاً",
 "craftswoman": "حِرْفِيَّة",
 "crafty": "خَبِيث, مُحْتَال (يتّسم بالمهارة في الخداع والمكر)",
 "crag": "جُرْفٌ (أخذ شيئًا وجرفه بعيدًا، أو سحب شيئًا بقوة؛ في : في بعض الحالات، قد تستخدم للإشارة إلى إزالة أو جرف شيء نحو مكان آخر)\nمثال: وقف على حافة الجرف.",
 "cragfast": "عَالِق عَلَى صَخْرَة (محتجَز على نتوء صخريّ أو ما يشبهه ولا يستطيع التحرّك)",
 "cragged": "جَبَلِيّ, صَخْرِيّ (ذو صخور بارزة وتضاريس وعرة)",
 "craggy": "جَبَلِيّ, صَخْرِيّ (ذو صخور بارزة وتضاريس وعرة)",
 "cragsman": "متسلق صخور (متسلق ذكر للواجهات الصخرية العمودية)",
 "cragswoman": "متسلقة صخور (متسلقة أنثى للواجهات الصخرية العمودية)",
 "crake": "مرعة (أي من عدة طيور مرعة قصيرة المنقار من العالم القديم)",
 "cram full": "مَحْشُوّ, مَكْدُوس (مَمْلُوء عَنْ آخِرِه حَتَّى السَّعَة القُصْوَى)",
 "crambe maritima": "كرامبي, كرنب بحري (نبات معمر في الرمال الساحلية والحصى لشمال أوروبا وبحر البلطيق والبحر الأسود له عناقيد من الزهور البيضاء الصغيرة وأوراق زرقاء خضراء لحمية كبيرة تستخدم…)",
 "crammer": "كتاب مراجعة مكثفة (كتاب مدرسي مصمم للحفظ السريع (قبل الامتحانات)) / مدرسة تقوية, مركز دروس خصوصية (مدرسة خاصة حيث يتم حشو الطلاب بالمعلومات (للامتحانات)) / معلم خصوصي (معلم يتقاضى أجراً لتحضير الطلاب للامتحانات بشكل مكثف) / طالب مستذكر بضغط (طالب يذاكر بكثافة في وقت قصير قبل الامتحان)",
 "cramp": "تَشَنُّج, شَدٌّ عَضَلِيّ",
 "cramp iron": "كلاب, مشبك حديدي (شريط من المعدن ذو نهايات منحنية بزوايا قائمة؛ يستخدم لتثبيت البناء معاً)",
 "crampbark": "رباطية أوبولس, ورد غيلدر (شجيرة نفضية من العالم القديم تشكل غابات صغيرة، لها عناقيد من الزهور البيضاء وتوت أحمر لامع صغير)",
 "cramped": "ضَيِّق, مُكْتَظّ (محدود المساحة؛ ضيق بشكل مزعج)",
 "crampfish": "رعاد, سمك الرعاد (أي سمكة راي بطيئة الحركة تعيش في القاع من رتبة الطوربيدينيات ولها جسم مستدير وأعضاء كهربائية على كل جانب من الرأس قادرة على إصدار شحنات كهربائية قوية)",
 "crampon": "كرامبون, نصل تسلق (مسمار حديدي يركب في الحذاء لمنع الانزلاق على الجليد عند المشي أو التسلق) / كُلَّاب رفع (زوج مفصلي من القضبان الحديدية المنحنية؛ يستخدم لرفع الأشياء الثقيلة)",
 "crampoon": "كرامبون, نصل تسلق (مسمار حديدي يركب في الحذاء لمنع الانزلاق على الجليد عند المشي أو التسلق) / كُلَّاب رفع (زوج مفصلي من القضبان الحديدية المنحنية؛ يستخدم لرفع الأشياء الثقيلة)",
 "cramps": "تَشَنُّجٌ",
 "cran": "كران (وحدة سعة تستخدم لقياس سمك الرنجة الطازج)",
 "cranberry": "عَنْبِيَّة حَادَة الخَبَاء",
 "cranberry bush": "رباطية ثلاثية الفصوص, شجيرة التوت البري الأمريكية (شجيرة نفضية أو شجرة صغيرة من أمريكا الشمالية لها أوراق ثلاثية الفصوص وتوت أحمر)",
 "cranberry culture": "زراعة التوت البري (زراعة التوت البري)",
 "cranberry heath": "توت الأرض, توت بري أصلي (شجيرة صغيرة منبطحة أو صاعدة ذات أزهار قرمزية وثمار عصارية تشبه التوت البري)",
 "cranberry juice": "عصير التوت البري (عصير مستخرج من التوت البري (دائماً ما يكون مخففاً ومحلى))",
 "cranberry liqueur": "ليكير التوت البري (مشروب كحولي مصنوع من التوت البري)\nمثال: قبل فترة، أخبرتني زميلة كينج-مان، ماري، أنها غالباً ما تصنع ليكير التوت البري الخاص بها في هذا الوقت من السنة",
 "cranberry sauce": "صلصة التوت البري (صلصة مصنوعة من التوت البري والسكر)",
 "cranberry tree": "رباطية ثلاثية الفصوص, شجيرة التوت البري الأمريكية (شجيرة نفضية أو شجرة صغيرة من أمريكا الشمالية لها أوراق ثلاثية الفصوص وتوت أحمر) / رباطية أوبولس, ورد غيلدر (شجيرة نفضية من العالم القديم تشكل غابات صغيرة، لها عناقيد من الزهور البيضاء وتوت أحمر لامع صغير)",
 "crane": "كُرْكِيّ, غُرْنُوق / رَافِعَة / رَفَعَ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ)\nمثال: رفع سامي نظارته.",
 "crane fly": "ذبابة الكركي, طيثارة (ذباب نحيل طويل الأرجل يشبه البعوض الكبير ولكنه لا يلدغ)",
 "crane's bill": "إبرة الراعي, غرنوقي",
 "cranefly": "طَيْثَار",
 "cranesbill": "إبرة الراعي, غرنوقي",
 "cranial": "جُمْجُمِيّ",
 "cranial cavity": "تجويف قحفي (التجويف المحاط بالجمجمة)",
 "cranial index": "المُؤَشِّر الرَّأْسِيّ (نسبة (بالنسبة المئوية) أقصى عرض للجمجمة إلى أقصى طول لها)",
 "cranial nerve": "عصب قحفي (أي من الأعصاب المزدوجة الـ 12 التي تنشأ في جذع الدماغ)",
