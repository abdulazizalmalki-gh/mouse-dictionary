 "dadaism": "الدادائية, دادا (حركة فنية عدمية (خاصة في الرسم) ازدهرت في أوروبا في أوائل القرن العشرين؛ استندت إلى اللاعقلانية ونفي قوانين الجمال المقبولة)",
 "daddy": "بَابَا",
 "daddy longlegs": "أوبليون, حاصد (عنكبوتي يشبه العنكبوت بجسم مستدير صغير وأرجل رفيعة طويلة جداً) / ذبابة الكركي, طيثارة (ذباب نحيل طويل الأرجل يشبه البعوض الكبير ولكنه لا يلدغ)",
 "dado": "حز عرضي, نقر (أخدود مستطيل محفور في لوح خشبي لتركيب قطعة أخرى فيه) / إزار الجدار, حِضن العمود (القسم من قاعدة العمود بين القاعدة والإفريز السفلي) / إزار جداري, دادو (لوحة تشكل الجزء السفلي من الجدار الداخلي عندما يتم تشطيبها بشكل مختلف عن بقية الجدار)",
 "dado plane": "مِسْحَج الحفر العرضي",
 "daedal": "بَارِع, مُتْقَن (مُعَقَّد وَبَارِع فِي التَّصْمِيم أَوِ الوَظِيفَة)",
 "daegu": "دَايْغُو",
 "daejeon": "دَايْجْيُون",
 "daemon": "دايمون, نصف إله (شخص نصفه بشر ونصفه إله) / شيطان, عفريت (كائن خارق للطبيعة شرير)",
 "daesh": "دَاعِش",
 "daffo": "رون (لغة تشادية يتم التحدث بها في شمال نيجيريا، وخاصة في ولاية بلاتيو)",
 "daffo language": "رون (لغة تشادية يتم التحدث بها في شمال نيجيريا، وخاصة في ولاية بلاتيو)",
 "daffodil": "نَرْجُس بَرِّيّ",
 "daffodil garlic": "ثوم مزهر, ثوم نابولي (بصل أوروبي بزهور بيضاء)",
 "dafla": "لغة ميري (لغات كاماروبان غير معروفة كثيراً)",
 "dafla language": "لغة ميري (لغات كاماروبان غير معروفة كثيراً)",
 "daft": "مَخْبُول, مَعْتُوه ((غير رسمي) مصطلحات عامّيّة تصف الاضطراب العقليّ)",
 "daftly": "بِجُنُون, بِحُمْق (بطريقة جنونية خفيفة)\nمثال: السيدة العجوز بدأت تتصرف بخبل",
 "daftness": "جنون, خبال (مصطلحات غير رسمية للجنون)",
 "dag": "شراشيب, هدبة (لسان على طول حافة الثوب؛ استخدم في ملابس العصور الوسطى) / ديكاغرام (10 غرامات)",
 "dagame": "خشب الليمون, كاليكوفيلوم (مصدر لخشب مرن وقوي)",
 "dagestan": "دَاغِسْتَان",
 "dagestani": "دَاغِسْتَانِيّ",
 "dagga": "داغا, ذيل الأسد (عشب جنوب أفريقي غير سام نسبياً يدخن مثل التبغ)",
 "dagger": "خَنْجَر (السِكِّين الكبيرة لا تستخدم للطعام بل للحَرْب، وقيل هي السكين ذات الحدين)",
 "dagger fern": "سرخس الخنجر, سرخس عيد الميلاد (سرخس دائم الخضرة من أمريكا الشمالية له أوراق ريشية وعناقيد كثيفة من السعف رمحي الشكل)",
 "dagger moth": "فَرَاشَة خَنْجَرِيَّة (حشرة صغيرة رقيقة ذات أجنحة كبيرة قد تكون ملونة أو غير ملونة)\nمثال: آه ، هناك فراشة!",
 "dagger-like": "خَنْجَرِيّ, شَبِيهٌ بِالخَنْجَر (يُشبِه الخنجر في شكله أو حدّته)",
 "daggerboard": "لوح خنجري (لوح مركزي قابل للإزالة على مركب شراعي صغير يمكن خفضه في الماء ليعمل كعارضة)",
 "dago": "إيطالي (مهين) (مصطلح عدائي أو مهين لشخص من أصل إيطالي)",
 "dagon": "دَجون",
 "daguerreotype": "صورة داجيرية (صورة مصنوعة بعملية فوتوغرافية مبكرة؛ حيث أنتجت الصورة على لوح فضي حساس لليود وتم تظهيرها في بخار الزئبق)",
 "dah": "شرطة (أطول الإشارتين التلغرافيتين المستخدمتين في شفرة مورس)",
 "dahab": "ذَهَب (في : التِبْر، مَعْدِن ثَمِين أصْفَر اللَّوْنِ، هُوَ أَسَاسُ التَعَامُلِ المَالِيّ وَيُسْتَخْدَمُ أَيْضاً فِي صِنَاعَةِ الْحُلِيّ وَالْمُجَوْهَرَات؛ هَذَا رَجُل ذَهَبا: أَيْ رَجُلٌ يُسَاوِي ذَهَباً فِي قِيمَتِهِ وَقدره)\nمثال: ذهب إلى الدكان.",
 "dahl": "بازلاء الحمام, بسلة هندية (بذور صغيرة ذات قيمة غذائية عالية لنبات بازلاء الحمام الاستوائي) / بازلاء الحمام, لوبيا العدس (عشبة خشبية استوائية ذات أزهار صفراء مبهرجة وقرون مسطحة؛ تزرع بكثرة في المناطق الاستوائية)",
 "dahlia": "دَالِيَّا",
 "dahlia pinnata": "أضاليا, داليا (أي من عدة نباتات من نوع داليا بيناتا أو مطورة منه، لها جذور درنية ورؤوس زهور مبهرجة متعددة الألوان)",
 "dahomey": "دَاهُومَيّ",
 "daikon": "فِجْل (فَجَّلَ الشيءَ تعني عرَّضَهُ، أي جعله مكشوفًا أو ظاهرًا. يمكن استخدام الفعل للإشارة إلى تعريض شيء ما للآخرين أو جعله واضحًا؛ فجل - يفجل، فجلا، الكلمة مرتبطة بتغيير شكل الشيء ليصبح أوسع أو أكثر استرخاءً وغلظة) / دَايْكُون",
 "dail": "الدويل, دويل (المجلس الأدنى في برلمان الجمهورية الأيرلندية)",
 "dail eireann": "الدويل, دويل (المجلس الأدنى في برلمان الجمهورية الأيرلندية)",
 "daily": "يَوْمِيّ / يَوْمِيًّا, كُلَّ يَوْمٍ",
 "daily bread": "رِزْق (رَزَقَهُ يَرْزُقُهُ رَزْقاً: أَوْصَلَ إِليه رزْقاً، أَو أَعطاه إِيَّاهُ؛ يقال: رَزَقَ الطائرُ فَرْخَهُ، رَزْقاً: كَسَبَ له ما يَغْذُوهُ)",
 "daily dew": "نبات الندية, ندية (مصدر للفعل نَبَتَ؛ اسم جنس شامل لكل ما تنبته الأرض من شجر أو بقل أو عشب أو غيره)\nمثال: هذا النبات مهدد بالانقراض.",
 "daily double": "رهان مزدوج يومي (رهان واحد على سباقين للخيول في نفس اليوم)",
 "daily order": "أمر يومي ((عادة بصيغة الجمع) أمر أو مجموعة أوامر تغطي يومًا كاملاً تصدرها منظمة عسكرية أو قائد عسكري للقوات والبحارة وغيرهم)\nمثال: أداروا كل شيء وأصدروا الأوامر اليومية من المقر المحتل",
 "daily round": "جولة, روتين يومي (الأنشطة المعتادة في يومك)\nمثال: أجرى الطبيب جولاته",
 "daily variation": "تغير يومي (تقلبات تحدث بين يوم وآخر)",
 "daimon": "شيطان, عفريت (كائن خارق للطبيعة شرير)",
 "daintily": "بِتَأَنُّق, بِرِقَّة (بطريقة رقيقة ودقيقة) / بِأَنَاقَة, بِرِقَّة جَمَالِيَّة (بطريقة توحي بالجمال الرقيق أو الرشاقة)\nمثال: قضمت كعكتها برقة",
 "daintiness": "دَمَاثَة, رِقَّة (صفة الجمال والرقة في المظهر)\nمثال: رقة لمستها",
 "dainty": "أَنِيق, بَدِيع (ذُو جَمَالٍ رَقِيقٍ وَدَقِيق) / مُتَقَزِّز, مُتَنَطِّع (مُفْرِط فِي التَّدْقِيق وَسَرِيع الاشْمِئْزَاز) / شَهِيّ, لَطِيفُ المَذَاق (مُمْتِعٌ لِلذَّوْقِ بِشَكْلٍ خَاصّ) / أطايب, طعام شهي (شيء يُعتبر فاخراً أو لذيذاً للأكل)",
 "daiquiri": "ديكيري, كوكتيل رم (كوكتيل مصنوع من الرم وعصير الليمون الأخضر أو الأصفر)",
 "dairy": "مشتقات الحليب / مَلْبَنَة / حَلِيبِيّ / لَبَنِيّ",
 "dairy cattle": "أبقار حلوب, ماشية الحليب (الماشية التي تُربى من أجل حليبها)",
 "dairy cow": "أبقار حلوب, ماشية الحليب (الماشية التي تُربى من أجل حليبها)",
 "dairy farm": "مزرعة ألبان (مزرعة يتم فيها إنتاج منتجات الألبان)",
 "dairy farmer": "بائع الحليب, مزارع الألبان (مالك أو مدير لمزرعة ألبان أو منشأة لمنتجات الألبان)",
 "dairy farming": "إنتاج الألبان, مزارع الألبان (عمل إنتاج الألبان)",
 "dairy product": "منتجات الألبان (الحليب والزبدة والجبن)",
 "dairying": "إنتاج الألبان, مزارع الألبان (عمل إنتاج الألبان)",
 "dairymaid": "حلابة, عاملة ألبان (امرأة تعمل في معمل ألبان)",
 "dairyman": "بائع ألبان, حلاب (رجل يعمل في معمل ألبان) / بائع الحليب, مزارع الألبان (مالك أو مدير لمزرعة ألبان أو منشأة لمنتجات الألبان)",
 "dairywoman": "حلابة, عاملة ألبان (امرأة تعمل في معمل ألبان)",
 "dais": "منبر, منصة الخطابة (منصة مرتفعة عن المستوى المحيط لإبراز الشخص الموجود عليها)",
 "daishiki": "داشيكي (قميص أفريقي فضفاض وزاهي الألوان)",
 "daisy": "أُقْحُوَان",
 "daisy bush": "شجيرة الأقحوان (أي من الشجيرات المتنوعة الجذابة الشكل غالباً من أستراليا من جنس أولاريا تزرع لأوراقها الجميلة وأحياناً العطرة الدائمة الخضرة وغزارة أزهار الأقحوان…)",
 "daisy chain": "سلسلة الإقحوان (سلسلة زهور تتكون من خيط من زهور الإقحوان مرتبطة بسيقانها؛ يرتديها الطلاب في يوم التخرج في بعض المدارس) / سلسلة متصلة ((مجازياً) سلسلة من الأشياء أو الأشخاص أو التجارب المرتبطة)",
 "daisy cutter": "ضربة أرضية زاحفة (كرة مضروبة أو مرسلة تنزلق قريباً من الأرض) / قنبلة شظية, قنبلة مضادة للأفراد (قنبلة تحتوي على 10 إلى 20 في المائة فقط من المواد المتفجرة والباقي يتكون من أغلفة مصممة لتتفتت إلى العديد من الشظايا الصغيرة عالية السرعة؛ وهي الأكثر…)",
 "daisy fleabane": "شيخ الربيع الحولي, يرغوث حولي (عشبة من أمريكا الشمالية ذات أزهار بيضاء متوطنة على نطاق واسع)",
 "daisy print wheel": "عجلة ديزي, عجلة طباعة زهرة الأقحوان (عجلة توجد حولها مجموعة من أحرف الطباعة التي تحدث أثراً كتابياً على الورق)",
 "daisy wheel": "عجلة ديزي, عجلة طباعة زهرة الأقحوان (عجلة توجد حولها مجموعة من أحرف الطباعة التي تحدث أثراً كتابياً على الورق)",
 "daisy-bush": "شجيرة الأقحوان (أي من الشجيرات المتنوعة الجذابة الشكل غالباً من أستراليا من جنس أولاريا تزرع لأوراقها الجميلة وأحياناً العطرة الدائمة الخضرة وغزارة أزهار الأقحوان…)",
 "daisy-leaved grape fern": "سرخس العنب ديزي الأوراق (من أمريكا الشمالية وأوراسيا)",
 "daisybush": "شجيرة الأقحوان (أي من الشجيرات المتنوعة الجذابة الشكل غالباً من أستراليا من جنس أولاريا تزرع لأوراقها الجميلة وأحياناً العطرة الدائمة الخضرة وغزارة أزهار الأقحوان…)",
 "daisyleaf grape fern": "سرخس العنب ديزي الأوراق (من أمريكا الشمالية وأوراسيا)",
 "daisylike": "أقحواني (يشبه زهرة الأقحوان)",
 "daisywheel printer": "طابعة عجلة الأقحوان (طابعة تستخدم عجلة طباعة على شكل زهرة الأقحوان)",
 "dak": "بلاش, شجرة اللهب (شجرة من شرق الهند تحمل غزارة من الزهور القرمزية المخملية الكثيفة وتنتج صبغة صفراء)",
 "dakar": "دَكَار",
 "dakoit": "قاطع طريق (عضو في عصابة مسلحة من اللصوص)",
 "dakoity": "سطو عصابات (سرقة تقوم بها عصابة من المسلحين)",
 "dakota": "لغة داكوتا (اللغة السيووية التي يتحدث بها شعب داكوتا) / داكوتا (فرد من الشعب السيوي في وادي المسيسيبي الشمالي؛ يُسمون عادة السيوكس)",
 "dakota language": "لغة داكوتا (اللغة السيووية التي يتحدث بها شعب داكوتا)",
 "daktylos": "داكتيلوس (وحدة طول يونانية تساوي سنتيمتراً واحداً)\nمثال: في اليونان القديمة، كان الداكتيلوس يساوي تقريباً طول إصبع",
 "dal": "ديكالتر (وحدة مترية للحجم أو السعة تساوي 10 لترات)",
 "dalai lama": "دَالَاي لَامَا",
 "dalasi": "دالاسي (وحدة المال الأساسية في غامبيا)",
 "dalbergia cearensis": "خشب الملك, شجرة خشب الملك (شجرة برازيلية تنتج خشب خزائن جميلاً)",
 "dalbergia latifolia": "خشب أسود هندي, خشب الورد الهندي (شجرة من شرق الهند لها خشب أرجواني داكن مفيد)",
 "dalbergia nigra": "جاكاراندا, خشب الورد البرازيلي (شجرة أخشاب برازيلية مهمة تنتج خشباً ثقيلاً صلباً داكن اللون مخططاً بالأسود)",
 "dalbergia retusa": "دالبرغية ريتوسا, كوكوبولو (شجرة خشبية قيمة موطنها المناطق الاستوائية في أمريكا الجنوبية)",
 "dalbergia sissoo": "سرسوع, سيسو (شجرة من شرق الهند تستخدم أوراقها كعلف؛ تنتج خشباً متيناً بني داكن مضغوط يستخدم في بناء السفن وصنع روابط السكك الحديدية)",
 "dalbergia stevensonii": "خشب الورد الهندوراسي (شجرة من أمريكا الوسطى تنتج خشب ورد مخطط داكن قيم)",
 "dale": "ثَنِيَّة",
 "dalea spinosa": "داليا شوكية, شجرة الدخان (شجيرة رمادية مخضرة في المناطق الصحراوية بجنوب غرب الولايات المتحدة والمكسيك، لها أوراق متناثرة وسنابل طرفية من الزهور البنفسجية المزرقة؛ وتعد مصدراً…)",
 "dalesman": "ساكن الوديان (شخص يعيش في وديان شمال إنجلترا)",
 "dalet": "دال, د (دَالَ الدَّهْرُ بَعْدَ عِزٍّ: دَارَ، اِنْقَلَبَ، اِنْتَقَلَ مِنْ حَالٍ إِلَى حَالٍ؛ دَالَتْ دَوْلَةُ الاسْتِبْدَادِ: اِنْقَضَى زَمَنُهَا، زَالَتْ)\nمثال: زيري من شركة دال.",
 "daleth": "داليت (الحرف الرابع من الأبجدية العبرية)",
 "dalgona coffee": "قَهْوَة دَالغُونَا (مشروب يحضر بغلي مطحون البُنّ؛ المحل أو الدكان الذي تُقدَّم فيه القهوة وغيرها من المشروبات)\nمثال: لا أفضل القهوة.",
 "dalian": "دَالْيَان",
 "dall sheep": "خروف دال (خروف بري أبيض كبير يعيش في شمال غرب كندا وألاسكا)",
 "dall's sheep": "خروف دال (خروف بري أبيض كبير يعيش في شمال غرب كندا وألاسكا)",
 "dallas": "دَالَاس",
 "dalliance": "غزل, ملاطفة (سلوك مرح يهدف إلى إثارة الاهتمام الجنسي) / تضييع الوقت, عبث (الفعل المتعمد للتأخير واللعب بدلاً من العمل)",
 "dallier": "متلكئ, مضيع الوقت (شخص يضيع الوقت)",
 "dallis grass": "باسبالوم, عشب داليس (عشب أمريكي استوائي معمر متكتل طويل توطن كعشب مرعى وعلف في جنوب الولايات المتحدة)",
 "dallisgrass": "باسبالوم, عشب داليس (عشب أمريكي استوائي معمر متكتل طويل توطن كعشب مرعى وعلف في جنوب الولايات المتحدة)",
 "dally": "تضييع الوقت",
 "dalmane": "دالمان, فلورازيبام (مهدئ (الاسم التجاري دالمان) يستخدم لعلاج الأرق)",
 "dalmatia pyrethrum": "بيرثروم, عاقر قرحا (بيرثروم أبيض الزهر من منطقة البلقان أوراقه الريشية بيضاء ومشعرّة حريرياً من الأسفل؛ مصدر لمبيد حشري؛ يوضع أحياناً في جنس أقحوان)",
 "dalmatian": "كلب دلماسي (سلالة كبيرة لها معطف أبيض ناعم مع بقع سوداء أو بنية؛ نشأت في دالماتيا) / دلماتي, دلماسي (من أو متعلق بدلماتيا أو سكانها) / دلماتسي (مواطن أو ساكن في دالماسيا)",
 "dalmatian iris": "سوسن دلماسي (سوسن أوروبي له زهور زرقاء ليلكية ناعمة)",
 "dalmatian laburnum": "لابورنوم دلماسي (شجيرة منتصبة ذات أوراق ثلاثية كبيرة وعناقيد كثيفة من الزهور الصفراء تليها بذور سامة؛ يوغوسلافيا؛ تصنف أحياناً في جنس السيتيسوس)",
 "dalmatian pyrethrum": "بيرثروم, عاقر قرحا (بيرثروم أبيض الزهر من منطقة البلقان أوراقه الريشية بيضاء ومشعرّة حريرياً من الأسفل؛ مصدر لمبيد حشري؛ يوضع أحياناً في جنس أقحوان)",
 "dalo": "تارو, قلقاس (عشبة من جزر المحيط الهادئ تزرع في جميع أنحاء المناطق الاستوائية لجذرها الصالح للأكل وفي المناطق المعتدلة كنبات زينة لأوراقها اللامعة الكبيرة)",
 "dalton's law": "قانون الضغوط الجزئية, قانون دالتون ((كيمياء وفيزياء) قانون ينص على أن الضغط الذي يمارسه خليط من الغازات يساوي مجموع الضغوط الجزئية للغازات في الخليط) / قانون النسب المتضاعفة ((كيمياء) قانون ينص على أنه عندما يمكن لعنصرين أن يتحدوا لتكوين أكثر من مركب واحد، فإن كميات أحدهما التي تتحد مع كمية ثابتة من الآخر ستظهر علاقة…)",
 "dalton's law of partial pressures": "قانون الضغوط الجزئية, قانون دالتون ((كيمياء وفيزياء) قانون ينص على أن الضغط الذي يمارسه خليط من الغازات يساوي مجموع الضغوط الجزئية للغازات في الخليط)",
 "daltonism": "عمى الأخضر (عمى ألوان ثنائي يتميز بانخفاض الحساسية للضوء الأخضر مما يؤدي إلى عدم القدرة على التمييز بين الأخضر والأحمر الأرجواني)",
 "dam": "سَدّ, سد (أغلق الخلل ورَدَمَ الثلم فلائم الردمُ الثلم؛ الطريق: أغلقه وأعاق السير فيه)",
 "dam failure": "فَشَل السَّدّ (فَشَلَ الطالبُ في الامتحان: لم ينجح في الاختبار ولم يحقق النتيجة المطلوبة؛ فَشَلَ الشيءُ: انهار أو انكسر أو توقف عن العمل)\nمثال: فشل ياني مجددا.",
 "dama dama": "أيل أسمر (أيل أوراسي صغير)",
 "damage": "عُطْل, ضَرَر (أوقف أو جعل شيء غير فعال لفترة معينة؛ إيقاف شيء عن العمل أو تركه بدون استخدام أو اهتمام)\nمثال: ذهب سامي في عطلة.",
 "damage control": "احتواء الأضرار, الحد من الأضرار (جهد لتقليل أو تقليص الضرر أو الخسارة)",
 "damaged": "تالف, متضرر (تعرض للأذى أو الإصابة أو التلف) / فَاقِدُ الْمِصْدَاقِيَّةِ, مُتَضَرِّرُ السُّمْعَةِ (فقد سمعته أو مصداقيته ظلماً)\nمثال: لن أشتري بضائع تالفة",
 "damages": "تعويضات, غرامة تعويضية (مبلغ من المال يُدفع كتعويض عن خسارة أو إصابة)",
 "damaging": "سَلْبِيّ, ضَارّ (مُصَمَّمٌ لِلتَّشْوِيهِ أَوْ يَمِيلُ إِلَيْهِ؛ دُونَ اقْتِرَاحَاتٍ إِيجَابِيَّةٍ) / ضارّ, مُجْحِف (يُسَبِّب ضَرَرًا أو يُلحِق أذًى بِالمَصالِح)",
 "damaliscus lunatus": "توبي, ساسابي (ظبي جنوب أفريقي كبير؛ يعتبر أسرع الثدييات ذات الحوافر)",
 "damar": "دَمَر, صمغ الدَمَر (أي من الراتنجات الصلبة المختلفة المستخرجة من أشجار عائلة مجنحية الثمر وجنس أغاتيس)",
 "damaraland mole rat": "فأر الخلد دامارالاند (فأر خلد استعماري من غرب أفريقيا؛ يشبه فأر الخلد العاري)",
 "damascene": "دِمَشْقِيّ",
 "damascus": "دِمَشْق / جَيْرُون / الشَّام ((حديثًا) دِمَشْق (المدينة العاصمة في سوريا))",
 "damascus steel": "فِرِنْد",
 "damask": "فِرِنْد",
 "damask rose": "وَرْد جُورِيّ, وَرْدَة جُورِيَّة (اِسْمٌ وَصِفَةٌ لِلْأَسَد)\nمثال: سألته ورد بنعم.",
 "damask steel": "الفولاذ الدمشقي (فولاذ صلب مرن مزخرف غالباً ويستخدم لنصال السيوف)",
 "damask violet": "منثور دمشقي, هيسبيرس (عشب مزروع منذ فترة طويلة له زهور تكون رائحتها أكثر وضوحاً في المساء؛ تم توطينه في جميع أنحاء أوروبا إلى سيبيريا وإلى أمريكا الشمالية)",
 "dame": "امرأة, فتاة (مصطلحات غير رسمية لامرأة (شابة)) / سيدة (امرأة راقية)\nمثال: فتح السائق باب الليموزين للسيدة الكبيرة",
 "dame's violet": "منثور دمشقي, هيسبيرس (عشب مزروع منذ فترة طويلة له زهور تكون رائحتها أكثر وضوحاً في المساء؛ تم توطينه في جميع أنحاء أوروبا إلى سيبيريا وإلى أمريكا الشمالية)",
 "damietta": "دُمْيَاط",
 "daminozide": "آلار, دامينوزيد (مادة كيميائية ترش على أشجار الفاكهة لتنظيم نموها بحيث يمكن حصاد المحصول بأكمله في وقت واحد)",
 "damma": "ضَمَّة",
 "dammam": "الدَّمَّام",
 "dammar": "دَمَر, صمغ الدَمَر (أي من الراتنجات الصلبة المختلفة المستخرجة من أشجار عائلة مجنحية الثمر وجنس أغاتيس)",
 "dammar pine": "صنوبر الدامار, صنوبر كاوري (أي من الأشجار المختلفة من جنس أغاتيس؛ تنتج راتنج الدامار)",
 "dammar resin": "دَمَر, صمغ الدَمَر (أي من الراتنجات الصلبة المختلفة المستخرجة من أشجار عائلة مجنحية الثمر وجنس أغاتيس)",
 "dammit": "اللُّعْنَة",
 "damn": "لَعَنَ ((في الدين) طَرَدَهُ اللَّٰهُ مِنْ رَحْمَتِهِ؛ سَبَّ، شَتَمَ) / اللَّعْنَة",
 "damnable": "بَغِيض, مَمْقُوت (يستحق اللعن والمقت الشديد)",
 "damnably": "بِشَكْل بَغِيض, بِشَكْل لَعِين (بطريقة بغيضة)\nمثال: آرثر اللطيف - مثابر بشكل لعين، وبأدب، وبلا نهاية!",
 "damnation": "إدانة, لعن (فعل اللعن) / لعنة, هلاك أبدي (حالة الحكم بالعقاب الأبدي في الجحيم)",
 "damnatory": "تَلْعِينِيّ, لَعْنِيّ (يُهَدِّد باللعنة أو العذاب)",
 "damned": "بِشَكْل بَغِيض, بِشَكْل لَعِين (بطريقة بغيضة) / لَعِين, مَلْعُون ((غير رسمي) شتائم تُستخدَم للتوكيد والتأثير) / مَحْكُومٌ عَلَيْه, مَلْعُون (مُعرَّض لعذاب جهنم الأبدي) / ملعونون, هالكون (الناس المحكوم عليهم بالعقاب الأبدي)\nمثال: آرثر اللطيف - مثابر بشكل لعين، وبأدب، وبلا نهاية!",
 "damning": "تَلْعِينِيّ, لَعْنِيّ (يُهَدِّد باللعنة أو العذاب)",
 "damoiselle": "آنسة, عذراء (امرأة شابة غير متزوجة)",
 "damosel": "آنسة, عذراء (امرأة شابة غير متزوجة)",
 "damourite": "داموريت (نوع من المسكوفيت)",
 "damozel": "آنسة, عذراء (امرأة شابة غير متزوجة)",
 "damp": "رُطُوبة",
 "damp course": "طبقة عازلة للرطوبة (طبقة من مادة غير منفذة توضع في جدران الأساس للمبنى بالقرب من الأرض لمنع الرطوبة من الصعود إلى المبنى)",
 "damp-proof course": "طبقة عازلة للرطوبة (طبقة من مادة غير منفذة توضع في جدران الأساس للمبنى بالقرب من الأرض لمنع الرطوبة من الصعود إلى المبنى)",
 "dampener": "مبلل, مرطّب (جهاز يقوم بترطيب أو تبيليل شيء ما)\nمثال: استخدم مرطباً لتبليل القمصان قبل كيها",
 "dampening": "ترطيب, تندية (فعل جعل الشيء رطباً قليلاً)",
 "damper": "كابح, مثبط (قيد يسبب الإحباط أو التثبيط) / كاتم, مخمّد (جهاز يقلل من سعة التذبذبات الإلكترونية أو الميكانيكية أو الصوتية أو الديناميكية الهوائية) / مخمد (لوحة حديدية متحركة تنظم تيار الهواء في موقد أو مدخنة أو فرن)\nمثال: وضع المطر كابحًا لخطط نزهتنا",
 "damper block": "كتلة إخماد, مخمّد بيانو (مخمّد يتكون من كتلة صغيرة مبطنة باللباد تسقط على وتر البيانو لإيقاف اهتزازه)",
 "damping off": "ذبول البادرات (مرض نباتي يسببه فطر؛ حالة مرضية للشتلات في الرطوبة المفرطة)",
 "damping off fungus": "فطر الذبول (فطر يسبب مرض ذبول الشتلات)",
 "dampish": "رَطْب, نَدِيّ (مبلَّل قليلًا؛ فيه رطوبة خفيفة)",
 "damply": "بِتَبَلُّل, بِرُطُوبَة (بطريقة رطبة)\nمثال: كان هناك وشاح مربوط حول رأسها لكن الخصلة المتمردة هربت وتدلت برطوبة فوق عينها اليسرى",
 "dampness": "رطوبة, نداوة (بلل خفيف)",
 "damsel": "آنسة, عذراء (امرأة شابة غير متزوجة)",
 "damsel in distress": "فَتَاة فِي مِحْنَة (شابَّة في رَيْعان الصِّبا؛ جارية حدثة)\nمثال: أنا أري الفتاة.",
 "damselfish": "دامجال, ديموزيل (أسماك بحرية استوائية صغيرة زاهية الألوان تعيش في الشعاب المرجانية)",
 "damselfly": "مقترنة الأجنحة, يعسوب صغير (حشرة نحيلة غير لاسعة تشبه اليعسوب ولكنها أصغر منه ولها أجنحة مطوية عند الراحة)",
 "damson": "برقوق دمشقي (برقوق أرجواني داكن لشجرة البرقوق الدمشقي)",
 "damson plum": "برقوق دمشقي (برقوق أرجواني داكن لشجرة البرقوق الدمشقي) / برقوق دمشقي (شجرة برقوق تزرع منذ فترة طويلة لفاكهتها الصالحة للأكل) / كريسوفيلوم, ورقة الساتان (شجرة خشبية أمريكية استوائية ذات خشب ثقيل صلب داكن وثمار أرجوانية صغيرة تشبه البرقوق)",
 "damson plum tree": "برقوق دمشقي (شجرة برقوق تزرع منذ فترة طويلة لفاكهتها الصالحة للأكل)",
 "danaid": "فراشة دانايد (فراشة استوائية كبيرة ذات أرجل أمامية ضامرة وطعم كريه)",
 "danaid butterfly": "فراشة دانايد (فراشة استوائية كبيرة ذات أرجل أمامية ضامرة وطعم كريه)",
 "danaus plexippus": "فراشة الصقلاب, فراشة الملك (فراشة أمريكية مهاجرة كبيرة لها أجنحة برتقالية عميقة بعلامات سوداء وبيضاء؛ تتغذى اليرقات على الصقلاب)",
 "dance": "رَقْص (حركة الجسم بتنسيق موسيقي أو لحن، حيث يتحرك الشخص بشكل إيقاعي أو متناسق مع الموسيقى أو أنغام معينة؛ نشاط جسدي يتم على عادة أو تقليد، حيث يشارك الأفراد في الاحتفالات أو الفعاليات الاجتماعية) / رقص (حركة الجسم بتنسيق موسيقي أو لحن، حيث يتحرك الشخص بشكل إيقاعي أو متناسق مع الموسيقى أو أنغام معينة؛ نشاط جسدي يتم على عادة أو تقليد، حيث يشارك الأفراد في الاحتفالات أو الفعاليات الاجتماعية) / شطيح / رَقَصَ, رقص (حركة الجسم بتنسيق موسيقي أو لحن، حيث يتحرك الشخص بشكل إيقاعي أو متناسق مع الموسيقى أو أنغام معينة؛ نشاط جسدي يتم على عادة أو تقليد، حيث يشارك الأفراد في الاحتفالات أو الفعاليات الاجتماعية)\nمثال: كنت تجيد الرقص.",
 "dance band": "فرقة رقص (مجموعة من الموسيقيين يعزفون موسيقى شعبية للرقص)",
 "dance floor": "صَالَةُ رَقْص (مكان فسيح في وسط المسكن يُوصِلُ إلى سائر الحجرات، الرُدْهَة؛ غُرْفَةُ المَعِيْشَة سواء كانت توصل إلى سائر الحجرات أم لا وسواء كانت فسيحة أم لا)\nمثال: حجزت الصالة يوم الخميس.",
 "dance hall": "قاعة رقص (غرفة كبيرة تستخدم بشكل رئيسي للرقص)",
 "dance lesson": "درس رقص (درس في الرقص)",
 "dance master": "معلم رقص (معلم محترف للرقص)",
 "dance music": "موسيقى الرقص (موسيقى للرقص عليها) / موسيقى الرقص, موسيقى قاعة الرقص (نوع من الموسيقى الشعبية المؤلفة لرقص القاعات)",
 "dance of death": "رقصة الموت (رقصة من العصور الوسطى يقود فيها هيكل عظمي يمثل الموت موكباً من الآخرين إلى القبر)",
 "dance orchestra": "فرقة رقص (مجموعة من الموسيقيين يعزفون موسيقى شعبية للرقص)",
 "dance palace": "قاعة رقص (غرفة كبيرة تستخدم بشكل رئيسي للرقص)",
 "dance school": "مدرسة رقص (مدرسة يتم فيها تعليم الطلاب الرقص)",
 "dance step": "خطوة رقص (سلسلة من حركات القدمين تشكل رقصة معينة)\nمثال: علمهم خطوة الفالس",
 "danceable": "قَابِلٌ لِلرَّقْص (مناسب للرقص)",
 "dancehall": "قَاعَةُ رَقْص",
 "dancer": "رَاقِص, رَاقِصَة",
 "danceroom music": "موسيقى الرقص, موسيقى قاعة الرقص (نوع من الموسيقى الشعبية المؤلفة لرقص القاعات)",
 "dancing": "رقص (القيام بسلسلة من الخطوات (والحركات) الإيقاعية المتناغمة مع الموسيقى)",
 "dancing lady orchid": "أوركيد السيدة الراقصة, أونسيديوم (أي أوركيد من جنس أونسيديوم: يتميز برشاشات متفرعة نحيلة من زهور صفراء وبنية صغيرة؛ تزرع غالباً كنباتات منزلية)",
 "dancing partner": "شَرِيك رَقْص (أحد شخصين يرقصان معاً)",
 "dancing school": "مدرسة رقص (مدرسة يتعلم فيها الطلاب الرقص)",
 "dancing-master": "معلم رقص (معلم محترف للرقص)",
 "dandelion": "هِنْدِبَاء, طَرْخَشْقُون",
 "dandelion green": "أوراق الهندباء البرية (أوراق صالحة للأكل من الهندباء الشائعة تجمع من البرية؛ تستخدم في السلطات وفي صنع النبيذ) / أوراق الهندباء (أوراق نبات الهندباء)",
 "dander": "ثائرة, غضب (شعور بالغضب والعداء) / قشور جلد الحيوان, وَبَر (قشور صغيرة من جلود الحيوانات أو شعرها أو ريش الطيور يمكن أن تسبب تفاعلات تحسسية لدى بعض الناس)\nمثال: ثارت ثائرته",
 "dandie dinmont": "داندي دينمونت (سلالة من التيريير الصغير ذو فراء سلكي طويل وآذان متدلية)",
 "dandie dinmont terrier": "داندي دينمونت (سلالة من التيريير الصغير ذو فراء سلكي طويل وآذان متدلية)",
 "dandified": "أَنِيقٌ بِتَكَلُّف, مُتَأَنِّق (يتظاهر بأناقة مفرطة في اللباس والسلوك)",
 "dandily": "بتأنق, بغندرة (بطريقة أنيقة ومتأنقة)\nمثال: أظهرت مواهبها بأسلوب متأنق",
 "dandle board": "أرجوحة التوازن, سيسو (لعبة تتكون من لوح متوازن على نقطة ارتكاز؛ يركبه الأطفال صعوداً وهبوطاً عند كلا الطرفين)",
 "dandruff": "قِشْرَة الرَّأْس",
 "dandy": "رَائِع, مُمْتَاز (ممتاز؛ بالغ الجودة) / يول (سفينة شراعية بصاريتين؛ صارية خلفية صغيرة تقع خلف عمود الدفة) / متأنق (رجل يهتم كثيراً بملابسه ومظهره)",
 "dandy fever": "حمى الضنك (مرض معد في المناطق الاستوائية ينتقل عن طريق البعوض ويتميز بطفح جلدي وآلام في الرأس والمفاصل)",
 "dandyish": "أَنِيقٌ بِتَكَلُّف, مُتَأَنِّق (يتظاهر بأناقة مفرطة في اللباس والسلوك)",
 "dandyism": "تأنق مفرط (أسلوب وملابس المتأنق أو المغرور)",
 "dane": "دَانِمَارْكِيّ, دَانِمَرْكِيَّة",
 "danewort": "بيلسان قزم (بيلسان عشبي قزم من أوروبا له زهور وردية ورائحة كريهة)",
