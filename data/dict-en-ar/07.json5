 "cytokine": "سيتوكين (أي من جزيئات البروتين المختلفة التي تفرزها خلايا الجهاز المناعي وتعمل على تنظيم الجهاز المناعي)",
 "cytokinesis": "انقسام السيتوبلازم, حركية خلوية (عملية عضوية تتكون من انقسام سيتوبلازم الخلية بعد انقسام النواة مما يؤدي إلى الانفصال لخليتين وليدتين)",
 "cytokinetic": "حركي خلوي (متعلق بانقسام سيتوبلازم الخلية الذي يلي انقسام النواة)",
 "cytokinin": "سيتوكينين, كينين (أي من فئة الهرمونات النباتية التي تعزز انقسام الخلايا وتؤخر شيخوخة الأوراق)",
 "cytol": "سيتوبلازم, هيولى (بروتوبلازم الخلية باستثناء النواة؛ مليء بالبروتينات التي تتحكم في استقلاب الخلية)",
 "cytologic": "خلوي, سيتولوجي (مكون من أو متعلق بعلم الخلايا)",
 "cytologic smear": "لَطَاخَة, مَسْحَة (عينة رقيقة من الأنسجة أو الدم تُفرد على شريحة زجاجية وتُصبغ للفحص الخلوي والتشخيص تحت المجهر)",
 "cytologic specimen": "عَيِّنَة خَلَوِيَّة (عينة تستخدم للفحص الخلوي والتشخيص)",
 "cytological": "خلوي, سيتولوجي (مكون من أو متعلق بعلم الخلايا)",
 "cytologist": "عالم خلايا (عالم أحياء يدرس بنية ووظيفة الخلايا)",
