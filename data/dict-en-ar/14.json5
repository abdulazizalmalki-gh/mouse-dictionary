 "iron cage": "قفص حديدي (قفص لا مفر منه)",
 "iron carbide": "سمنتيت, كربيد الحديد (مركب كيميائي يعتبر أحد مكونات الفولاذ والحديد الزهر؛ شديد الصلابة والهشاشة)",
 "iron collar": "طوق حديدي, مخنق (أداة إعدام للإعدام عن طريق الخنق)",
 "iron curtain": "سِتَار حَدِيدِيّ, السِتَار الحَدِيدِي / السِتَار الحَدِيدِي, سِتَار حَدِيدِيّ",
 "iron deficiency anaemia": "فقر الدم بعوز الحديد (شكل من أشكال فقر الدم ناتج عن نقص الحديد في النظام الغذائي أو فقدان الحديد نتيجة لنزيف مزمن)",
 "iron deficiency anemia": "فقر الدم بعوز الحديد (شكل من أشكال فقر الدم ناتج عن نقص الحديد في النظام الغذائي أو فقدان الحديد نتيجة لنزيف مزمن)",
 "iron disulfide": "ثنائي كبريتيد الحديد (مركب يحتوي على ذرتين من الكبريت متحدتين مع الحديد)",
 "iron filing": "بُرَادة حديد (فتات من الحديد ناتج عن استخدام المِبرد)",
 "iron fist": "قُبْضَة حَدِيدِيَّة",
 "iron foundry": "مسبك حديد (مسبك يتم فيه إنتاج الحديد الزهر)",
 "iron group element": "عنصر مجموعة الحديد (أي عنصر كيميائي مرتبط بالحديد)",
 "iron heel": "حذاء التعذيب (أداة تعذيب تستخدم لتسخين أو سحق القدم والساق)",
 "iron horse": "الحصان الحديدي ((حوالي 1840) مصطلح مبكر للقاطرة)",
 "iron lung": "رئة حديدية (جهاز تنفس ينتج تناوبات في ضغط الهواء في غرفة تحيط بصدر المريض لإجبار الهواء على الدخول والخروج من الرئتين وبالتالي توفير التنفس الاصطناعي)",
 "iron maiden": "العذراء الحديدية (أداة تعذيب تتكون من إطار حديدي مجوف على شكل جسم الإنسان ومبطن بمسامير لخزق الضحية)",
 "iron man": "رجل حديدي (رجل قوي ذو قدرة تحمل بدنية استثنائية)",
 "iron manganese tungsten": "ولفراميت (معدن يتكون من تنغستات الحديد والمنغنيز في شكل بلوري؛ الخام الرئيسي للتنجستن؛ يوجد في عروق الكوارتز المصاحبة لصخور الجرانيت)",
 "iron mold": "بقعة صدأ (بقعة ناتجة عن التلطيخ بالصدأ أو الحبر)",
 "iron mould": "بقعة صدأ (بقعة ناتجة عن التلطيخ بالصدأ أو الحبر)",
 "iron oak": "سنديان الأخاديد, سنديان الوادي الحي (شجرة دائمة الخضرة متوسطة الحجم موطنها جنوب غرب الولايات المتحدة وشمال غرب المكسيك، ذات أوراق مستطيلة جلدية غالباً ما تكون حوافها شوكية) / بلوط عمودي (شجرة متساقطة الأوراق صغيرة من شرق ووسط الولايات المتحدة لها أوراق ريشية قيثارية خضراء داكنة وخشب قوي مقاوم للرطوبة يستخدم خاصة لأعمدة السياج)",
 "iron ore": "خَام اَلْحَدِيد (وَخُمَ أو وَبِئَ؛ أقام في المكان أو استقر فيه)\nمثال: تنقل السفن المواد الخام من أندونيسيا.",
 "iron overload": "داء ترسب الأصبغة الدموية, زيادة حمل الحديد (حالة مرضية يتراكم فيها الحديد في الأنسجة؛ تتميز بجلد برونزي وتضخم الكبد والسكري وتشوهات في البنكرياس والمفاصل)",
 "iron perchloride": "بيركلوريد الحديد (مادة كيميائية شديدة السمية تستخدم في نقش الألواح المعدنية والدوائر الإلكترونية)",
 "iron putty": "معجون حديدي (أسمنت يشبه المعجون؛ يصنع بخلط أكسيد الحديديك وزيت بذر الكتان المغلي؛ مقاوم للأحماض)",
 "iron pyrite": "بايرايت الحديد, بايريت (معدن شائع (ثنائي كبريتيد الحديد) لونه أصفر شاحب)",
 "iron trap": "فخ حديدي (فخ لا مفر منه)",
 "iron tree": "شجرة الحديد (شجرة صغيرة بطيئة النمو متساقطة الأوراق من شمال إيران لها شكل قبة منخفضة)",
