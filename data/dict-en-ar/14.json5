 "insidious": "خَبيث, فَتّاك (يُلحِق ضَرَرًا تَدْريجِيًّا خَفِيًّا ولكِنَّه بالِغ) / خَبِيث, غَادِر (يهدف إلى الإيقاع والتضليل) / خَبِيث, مَاكِر (جذّاب في ظاهره لكنه ضارّ)",
 "insidiously": "بشكل خبيث, بمكر (بطريقة ماكرة وضارة بشكل خفي)\nمثال: تعمل هذه الأدوية بشكل خبيث",
 "insidiousness": "كَيْدِيَّة, مَكْر (صفة كون الشيء مصمماً للإيقاع في الفخ) / فَتْك خَفِيّ, مَكْر (الضرر الخفي والتراكمي (خاصة للمرض))",
 "insight": "نظرة ثاقبة",
 "insightful": "بَصِير, عَمِيقُ الإِدْرَاك (يُظْهِرُ بَصِيرَةً وَإِدْرَاكًا عَمِيقًا وَوَاضِحًا)",
 "insightfulness": "بصيرة ثاقبة, حذق (الدهاء الذي يظهر من خلال البصيرة الثاقبة)",
 "insignia": "شارة رسمية, وسام (شارة تلبس لإظهار المنصب الرسمي)",
 "insignia of rank": "شارة رتبة (شارة تلبس على الزي العسكري)",
 "insignificance": "تفاهة, ضآلة الشأن (صفة وجود القليل من الأهمية أو انعدامها)",
 "insignificant": "تَافِه, حَقِير (صغير ولا يلفت الانتباه) / تَافِه, ضَئِيلُ الشَّأْن (ذو أهمية أو نفوذ أو سلطة قليلة؛ ذو مكانة ثانوية) / عَدِيمُ الدَّلَالَة (لا يدل على شيء) / تافه, ضئيل الشأن (خالٍ من الأهمية أو المعنى أو القوة)",
 "insignificantly": "بدرجة غير هامة, بشكل ضئيل (ليس بدرجة أو كمية هامة) / بشكل تافه, بشكل ضئيل (بطريقة غير مهمة)\nمثال: ستتأثر ميزانيتنا بشكل ضئيل فقط بهذه التخفيضات الجديدة",
 "insincere": "زائف, غير مخلص (يفتقر إلى الإخلاص)\nمثال: امرأة ساحرة ولكنها غير مخلصة تماماً",
 "insincerely": "بدون صدق, بنفاق (بدون إخلاص)\nمثال: هنأته بنفاق نوعاً ما",
 "insincerity": "رياء, زيف (صفة عدم الصراحة أو الصدق؛ الخداع أو النفاق)",
 "insinuate": "لَمَّحَ, أَلْمَحَ (لمح اليه؛يلمح لمحا واللمح:اختلس النظر وقال بعضهم:لمح نظر ولمحه) / تسحّب, تسلل / اِنْدَسّ\nمثال: لمح سامي منزلا.",
 "insinuating": "مُتَمَلِّق, مُتَوَدِّد (مَحْسُوب لإرضاء الآخرين أو كسب ودّهم)",
 "insinuatingly": "بإيحاء, تلميحاً (بطريقة تلميحية)\nمثال: الكتاب الفني لديه فن للبيع، تلميحاً، ولغرض ما",
 "insinuation": "تزلّف, تودد (فعل كسب القبول أو المودة عن طريق التملق المقنع والدقيق) / تعريض, تلميح (توريط أو إشارة غير مباشرة (وغالباً ما تكون خبيثة))\nمثال: رفضت استخدام التزلف لكسب الحظوة",
 "insipid": "تَافِه, سَخِيف (يفتقر إلى الأهمية أو التأثير) / تَافِه, عَدِيمُ الطَّعْم (يَفْتَقِرُ إِلَى الطَّعْمِ أَوِ النَّكْهَة)",
 "insipidity": "تفاهة, رتابة طعم (الافتقار إلى أي خاصية تذوق مميزة أو مثيرة للاهتمام) / رَتَابَة, سَآمَة (الملل الشديد؛ الافتقار إلى الروح أو الاهتمام)",
 "insipidly": "بابتذال, بسخافة (بطريقة سخيفة أو مملة)\nمثال: أفكار معبر عنها بسخافة",
 "insipidness": "تفاهة, رتابة طعم (الافتقار إلى أي خاصية تذوق مميزة أو مثيرة للاهتمام) / رَتَابَة, سَآمَة (الملل الشديد؛ الافتقار إلى الروح أو الاهتمام)",
 "insist": "أَصَرَّ (لواه وشدّه وربطه؛ أَصَرَ الشيءَ: كَسَرَهُ وعَطَفه) / أَلَحَّ\nمثال: أصر على الأفضل.",
 "insistence": "إصرار, إلحاح (فعل الإصرار على شيء ما) / إِصْرَار, إِلْحَاح (مطالب مستمرة ومتواصلة) / إلحاح, ضغط (حالة المطالبة بالملاحظة أو الانتباه)\nمثال: الإصرار على الصحة النحوية هو موقف محافظ",
 "insistency": "إصرار, إلحاح (فعل الإصرار على شيء ما) / إلحاح, ضغط (حالة المطالبة بالملاحظة أو الانتباه)\nمثال: الإصرار على الصحة النحوية هو موقف محافظ",
 "insistent": "مُتَكَرِّر, مُلِحّ (يَتَكَرَّرُ بِإِلْحَاحٍ وَمُثَابَرَة) / مُتَطَلِّب, مُلِحّ (يَسْتَدْعِي الانْتِبَاهَ فَوْرًا)",
 "insistently": "بإلحاح (بطريقة ملحة)",
 "insisting": "إِصْرَار, إِلْحَاح (مطالب مستمرة ومتواصلة)",
 "insobriety": "تسمم كحولي, ثمالة (حالة مؤقتة ناتجة عن الاستهلاك المفرط للكحول)",
 "insofar": "طَالَمَا",
 "insofar as": "عَلَى قَدْرِ مَا, بِقَدْرِ مَا (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال.",
 "insolation": "علاج شمسي (التعرض العلاجي لأشعة الشمس) / إشعاع شمسي ساقط, تشميس (الإشعاع الشمسي الساقط) / ضربة شمس (انهيار مفاجئ بسبب التعرض للشمس أو الحرارة المفرطة)",
 "insole": "نعل داخلي (النعل الداخلي للحذاء حيث تستقر القدم)",
 "insolence": "وقاحة (فعل وقح يفتقر للاحترام ومسيء) / صفاقة, وقاحة (سمة كون المرء وقحاً وسليطاً؛ يميل لأخذ حريات غير مستحقة)",
 "insolent": "صَفِيق, وَقِح (لا يتقيّد بالأعراف أو اللياقة؛ جريء بشكل فظّ) / صَفِيق, وَقِح (يتسم بعدم الاحترام العَرَضيّ)",
 "insolently": "بصفاقة, بوقاحة (بطريقة وقحة)\nمثال: أجاب بوقاحة على رؤسائه",
 "insolubility": "عدم القابلية للذوبان (خاصية عدم القابلية للذوبان وصعوبة الانحلال في السائل) / استحالة الحل, عدم قابلية الحل (الخاصية (لمشكلة أو صعوبة) التي تجعل من المستحيل حلها)",
 "insoluble": "مُسْتَعْصٍ (بلا أمل في إيجاد حلّ) / غير قابل للذوبان ((للمادة) غير قادر على الذوبان) / غير قابل للحل, مستعصٍ (لا يقبل الحل أو التفسير)\nمثال: شك غير قابل للحل",
 "insolvable": "عَصِيٌّ عَلَى الحَلّ, مُسْتَعْصٍ (ليس سهل الحلّ؛ يصعب التوصّل إلى حلّه)",
 "insolvency": "إِعْسَار, إِعْسَار مَالِيّ",
 "insolvent": "معسر, مفلس (غير قادر على الوفاء بالالتزامات المالية أو سدادها) / مُعْسِر, مُفْلِس (شخص ليس لديه أصول كافية لتغطية ديونه)\nمثال: شخص معسر",
 "insomnia": "أَرَق, سُهْد ((أَرِقَ) أرقا: امتنع عليه النوم ليلا فهو أرق وآرق)",
 "insomniac": "أَرِق, آرِق ((أَرِقَ) أرقا: امتنع عليه النوم ليلا فهو أرق وآرق)",
 "insomuch": "بقدر ما, لدرجة أن (إلى حد أو درجة؛ هكذا)",
 "insouciance": "انطلاق, خلو البال (الشعور المبهج الذي ينتابك عندما لا يزعجك شيء)",
 "insouciant": "عَابِث, لَامُبَالٍ (يَتَّسِمُ بِعَدَمِ الِاكْتِرَاثِ وَالِاسْتِهْتَارِ)",
 "inspect": "فَحَصَ (مصدر للفعل فَحَصَ بمعنى حفر الأرض أو كشف الشيء أو الاستقصاء عن الشيء؛ في : استقصاء ما بالمريض من علة أو مرض) / تَفَقَّدَ\nمثال: فحص الطبيب بطني.",
 "inspection": "تَفَقُّد",
 "inspection and repair": "عمرة, فحص وإصلاح شامل (صيانة دورية لسيارة أو آلة)\nمثال: حان وقت عمل عمرة للجرار",
 "inspector": "مُفَتِّش, مُفَتِّشَة",
 "inspector general": "مفتش عام (ضابط عسكري مسؤول عن التحقيقات)",
 "inspectorate": "هيئة تفتيش (هيئة من المفتشين)",
 "inspectorship": "مفتشية, منصب المفتش (منصب المفتش)",
 "inspiration": "إِلْهَام, وَحْي",
 "inspirational": "إِلْهَامِيّ, رُوحَانِيّ (يبثّ تأثيرًا إلهيًّا في العقل والروح)",
 "inspirationally": "بإلهام (بوجود إلهام؛ بطريقة ملهمة)\nمثال: تحدث بإلهام",
 "inspiratory": "شهيقي (متعلق بمرحلة سحب الهواء في التنفس)",
 "inspired": "إِلَهِيّ, مُلْهَم (بالغ التميز لدرجة توحي بإلهام سماوي)",
 "inspirer": "مُحفز, مُلهم (قائد يحفز الناس ويثيرهم للعمل)",
 "inspiring": "ملهم (محفز أو منشط للروح)",
 "inspiriting": "بَاعِثٌ لِلأَمَل, مُبَشِّر (يُشجِّع بطريقة تبعث البهجة والأمل)",
 "inspissation": "تثخين, تغليظ (فعل التغليظ أو التثخين) / تغليظ, تكثيف (عملية زيادة السماكة عن طريق التجفيف)",
 "inst": "مِنَ الشَّهْرِ الحَالِيّ (فِي الشَّهْرِ الجَارِي)",
 "instability": "تَقَلُّب, عَدَم اسْتِقْرَار (الصفة أو الخاصية المتمثلة في كون الشيء غير مستقر ومتردد) / عدم استقرار (عدم موثوقية ناتجة عن كون الشيء غير مستقر) / عدم استقرار (نظام غير مستقر) / اختلال, عدم استقرار (نقص التوازن أو حالة اختلال التوازن)\nمثال: اختلال هرموني",
 "instagay": "إنستاغاي (صورة على موقع إنستغرام تتعلق بالمثلية الجنسية)",
 "instagood": "جَذَّابٌ لِلْإِنْسْتَغْرَام ((غير رسمي) مِنَ المُرَجَّحِ أَنْ يَحْصُلَ عَلَى إِعْجَابَاتٍ كَثِيرَةٍ عَلَى إِنْسْتَغْرَام)",
 "instagram": "إِنْسْتَقْرَام, إِنْسْتَغْرَام",
 "instalike": "مثير للإعجاب الفوري, يستحق الإعجاب (شيء جيد جداً لدرجة أنه يستحق التصويت عليه بالإعجاب فوراً على وسائل التواصل الاجتماعي)",
 "install": "رَكَّبَ (عَلَى أو أعْتَلَى شيئا؛ السَيَّارَة أو وسيلة نقل أخرى، استخدمها في تنقله بدلا من الدواب)\nمثال: ركب ياني سفينة.",
 "installation": "تثبيت, تركيب (فعل تثبيت شيء ما (مثل المعدات)) / مرفق, منشأة (مبنى أو مكان يوفر خدمة معينة أو يستخدم لصناعة معينة) / انضمام, تعيين (الدخول الرسمي في منظمة أو منصب أو وظيفة)\nمثال: استغرق تركيب الهاتف بضع دقائق فقط",
 "installation charge": "رسوم التركيب (الرسم لتركيب شيء ما)",
 "installing": "تثبيت, تركيب (فعل تثبيت شيء ما (مثل المعدات))\nمثال: استغرق تركيب الهاتف بضع دقائق فقط",
 "installment": "قِسْط (عَدْل؛ حِصَّة عادلة)\nمثال: سامي بحاجة إلى قسط من الراحة.",
 "installment buying": "خطة تقسيط, شراء بالتقسيط (نظام لدفع ثمن البضائع على أقساط)",
 "installment credit": "ائتمان بالتقسيط, قرض تقسيط (قرض يُسدد بفائدة في دفعات دورية متساوية)",
 "installment debt": "دين بالتقسيط, دين مقسط (دين يجب سداده على أقساط)",
 "installment loan": "ائتمان بالتقسيط, قرض تقسيط (قرض يُسدد بفائدة في دفعات دورية متساوية)",
 "installment plan": "خطة تقسيط, شراء بالتقسيط (نظام لدفع ثمن البضائع على أقساط)",
 "installment rate": "معدل الدفع, معدل السداد (مبلغ المال المدفوع لكل وحدة زمنية)",
 "instalment": "تثبيت, تركيب (فعل تثبيت شيء ما (مثل المعدات)) / جزء, حلقة (جزء من مسلسل منشور) / حلقة (جزء من مسلسل مذاع)\nمثال: استغرق تركيب الهاتف بضع دقائق فقط",
 "instance": "عينة, مثال (عنصر من المعلومات يعتبر نموذجياً لفئة أو مجموعة) / حالة, مثال (حدوث لشيء ما)\nمثال: يقدم هذا المريض مثالاً نموذجياً للمتلازمة",
 "instancy": "آنية, فورية (سرعة الفعل أو الحدوث) / إلحاح, إلزام (صفة الإصرار)\nمثال: فورية استجابتهم",
 "instant": "لَحْظَة",
 "instant coffee": "قَهْوَة فَوْرِيَّة (مشروب يحضر بغلي مطحون البُنّ؛ المحل أو الدكان الذي تُقدَّم فيه القهوة وغيرها من المشروبات)\nمثال: لا أفضل القهوة.",
 "instant replay": "إعادة, إعادة فورية (إعادة البث الفوري لحدث ما (خاصة الأحداث الرياضية) تم تسجيله على شريط فيديو)",
 "instantaneous": "آنِيّ, لَحْظِيّ (يَحْدُث بِدُون أَيّ تَأْخِير)",
 "instantaneous sound pressure": "ضغط الصوت (الفرق بين الضغط اللحظي عند نقطة في مجال صوتي والضغط المتوسط عند تلك النقطة)",
 "instantaneously": "آنِيًا",
 "instantaneousness": "آنية, فورية (سرعة الفعل أو الحدوث)\nمثال: فورية استجابتهم",
 "instantiation": "تجسيد, تمثيل فعلي (تمثيل لفكرة ما في شكل نموذج أو حالة فعلية منها)\nمثال: كم عدد التجسيدات التي تم العثور عليها؟",
 "instantly": "حالاً, على الفور (بدون أي تأخير) / الآن, حالاً (بدون تأخير أو تردد؛ بدون وقت فاصل)\nمثال: قُتل على الفور",
 "instar": "انسلاخ, طور يرقِي (حشرة أو مفصلي آخر بين فترات الانسلاخ)",
 "instauration": "إنشاء, ابتداء (فعل بدء شيء ما لأول مرة؛ تقديم شيء جديد)\nمثال: تطلعت إلى بدايتها كشخص بالغ",
 "instead": "بَدَلاً مِن",
 "instead of": "بَدَلًا مِن",
 "instep": "مشط القدم (جزء الحذاء أو الجورب الذي يغطي قوس القدم) / قوس القدم, مشط القدم (قوس القدم)",
 "instigant": "مثير للفتنة, محرض (شخص يثير المشاكل والقلاقل عمداً)\nمثال: كانت هي المحرضة على شجارهم",
 "instigate": "حَرَّضَ, دَفَعَ (حرّضه على الأمر: حضّه ، شدّد الرّغبة فيه؛ حَرَّضَهُ تَحْرِيضاً: حَثَّه على القِتَالِ وأَحْمَاهُ عَلَيْه)\nمثال: هو حرض على الشغب.",
 "instigation": "إثارة, تحريض (الإشعال المتعمد والمقصود (للمشاكل أو الفتنة)) / تحريض, حث (الفعل اللفظي للحث)",
 "instigative": "تَحْرِيضِيّ, فِتْنَوِيّ (يُحَرِّض على الفعل أو التمرّد)",
 "instigator": "مُحَرِّض, مُحَرِّضَة",
 "instillation": "قُطُورَة",
 "instillator": "جهاز تقطير, مقطرة (جهاز طبي يضع سائلاً في تجويف قطرة بقطرة)",
 "instilling": "ترسيخ, غرس (التعليم أو الطبع في الذهن عن طريق التلقين المتكرر)",
 "instillment": "تقطير (إدخال سائل (عن طريق السكب أو الحقن) قطرة قطرة)",
 "instilment": "تقطير (إدخال سائل (عن طريق السكب أو الحقن) قطرة قطرة)",
 "instinct": "غَرِيزَة, سَلِيقَة",
 "instinctive": "غَرِيزِيّ, فِطْرِيّ (نابع من الغريزة أو كأنّه منها؛ بلا تفكير واعٍ)",
 "instinctive reflex": "رد فعل منعكس, منعكس (رد فعل تلقائي غريزي غير متعلم لمحفز)",
 "instinctively": "غريزيًا",
 "institute": "مَعْهَد (محضر ا لناس ومشهدهم؛ المَوْضِع أو الدَار المعهود بهِ الشيءُ والذي لا يزال القوم إذا انتأَوا عنهُ رجعوا إليه. الجمع مَعَاهِد. استخدام قديم) / أنشأ (أَوْجَدَ، خَلَقَ؛ بَدَأَ)\nمثال: ويعد هذا المعهد من أفضل المعاهد دوليا",
 "institution": "مُؤَسَّسَة",
 "institutional": "مؤسسي (منظم على هيئة مؤسسة أو يشكل مؤسسة) / مُمِلّ المُؤَسَّسَاتِيَّة (يتَّسم بطابع المؤسَّسة خاصَّة في الرتابة والجمود) / مؤسسي (متعلق بـ أو يشكل أو يتضمن مؤسسة)\nمثال: دين مؤسسي",
 "institutionalised": "مُودع في مؤسسة (موضوع رسمياً في أو ملتزم بمؤسسة متخصصة) / مُأَسَّس, مُؤَسَّسِيّ (اكتسب طابع المؤسَّسة أو أُدرِج في نظام منظَّم ورسميّ)\nمثال: كانت لديه آمال في إعادة تأهيل الأحداث الجانحين المودعين في مؤسسات إصلاحية",
 "institutionalized": "مُودع في مؤسسة (موضوع رسمياً في أو ملتزم بمؤسسة متخصصة) / مُأَسَّس, مُؤَسَّسِيّ (اكتسب طابع المؤسَّسة أو أُدرِج في نظام منظَّم ورسميّ)\nمثال: كانت لديه آمال في إعادة تأهيل الأحداث الجانحين المودعين في مؤسسات إصلاحية",
 "institutionally": "مؤسسياً (من قبل مؤسسة)\nمثال: مراقب مؤسسياً",
 "instroke": "شوط داخلي (شوط مكبس المحرك يتحرك بعيداً عن العمود المرفقي)",
 "instruct": "لقَّن",
 "instruction": "تَعْلِيم (الأوامر والنواهي التي يحددها دِين ما أو مَذْهَب ما. يُجمع جَمْع تَكْسِير على تَعَالِيم؛ ما دون الأمْر المُلْزِم والمستدعي للعقوبة وفوق الطَلَب الإختياري. أكثر ما يستخدم بصيغة الجمع تَعْلِيمَات) / أَمْر (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة)\nمثال: هو بارع في التعليم.",
 "instruction book": "دليل تعليمات (كتاب إرشادات لاستخدام أو تشغيل قطعة من المعدات)",
 "instruction execution": "إجراء, تنفيذ ((في علم الحاسوب) عملية تنفيذ تعليمة بواسطة الكمبيوتر)",
 "instruction manual": "دليل التعليمات, كتيب التعليمات (دليل يرافق عادة جهازاً تقنياً ويشرح كيفية تثبيته أو تشغيله)",
 "instructional": "إرشادي, تعليمي (من أو يتعلق بالتعليم أو يستخدم فيه)\nمثال: وسائل تعليمية مساعدة",
 "instructions": "دليل التعليمات, كتيب التعليمات (دليل يرافق عادة جهازاً تقنياً ويشرح كيفية تثبيته أو تشغيله)",
 "instructive": "إرشادي, تثقيفي (يخدم غرض التعليم أو التنوير أو الإعلام)",
 "instructively": "بشكل تثقيفي, بشكل مفيد (بطريقة غنية بالمعلومات)",
 "instructor": "مُعَلِّم, مُعَلِّمَة (من يمتهن التعليم، مُدَرِّس)\nمثال: هي أصبحت معلمة.",
 "instructorship": "منصب المعلم, وظيفة المدرب (منصب المعلم أو المدرب)",
 "instructress": "مدربة, معلمة (امرأة تقوم بالتعليم)",
 "instrument": "الة موسيقية / آلَة (الفارسية: ماشين؛ الأوردية: مشين) / أَدَاة\nمثال: نسى زيري الآلة.",
 "instrument flying": "طيران آلي (الملاحة بالطائرة اعتمادًا كليًا على الأجهزة)",
 "instrument landing": "هبوط آلي, هبوط بالأجهزة (هبوط طائرة يتم بالكامل بواسطة الأجهزة)",
 "instrument of execution": "أداة إعدام (أداة مصممة ومستخدمة لإنهاء حياة شخص محكوم عليه بالإعدام)",
 "instrument of punishment": "أداة عقاب (أداة مصممة ومستخدمة لمعاقبة شخص محكوم عليه)",
 "instrument of torture": "أداة تعذيب (أداة عقاب مصممة ومستخدمة لإلحاق التعذيب بالشخص المحكوم عليه)",
 "instrument panel": "لوحة أجهزة القياس, لوحة تحكم (جهاز كهربائي يتكون من سطح معزول مسطح يحتوي على مفاتيح وأقراص وعدادات للتحكم في الأجهزة الكهربائية الأخرى)\nمثال: فحص لوحة أجهزة القياس",
 "instrumental": "أداتِيّ, وَسيلِيّ (يَعْمَل كَوَسيلَة أو أداة لِتَحْقيق غايَة) / آلي (متعلق بالآلات الموسيقية أو مصمم لها أو يعزف عليها)\nمثال: مؤلفات آلية",
 "instrumental conditioning": "إشراط وسيلي (إشراط إجرائي يقرن استجابة بتعزيز في تجارب منفصلة؛ يحدث التعزيز فقط بعد إعطاء الاستجابة)",
 "instrumental music": "موسيقى آلية (موسيقى تُنتج عن طريق العزف على آلة موسيقية) / موسيقى آلية (موسيقى مخصصة للأداء بآلة موسيقية أو مجموعة من الآلات)",
 "instrumental role": "الأداة (الدور الدلالي للكيان (عادة غير حي) الذي يستخدمه الفاعل للقيام بعمل أو بدء عملية)",
 "instrumentalism": "أداتية (نظام فلسفي براغماتي يعتبر الفكرة أدوات يجب أن توجه أفعالنا وتقاس قيمتها بنجاحها)",
 "instrumentalist": "عازف, موسيقي (شخص يعزف الموسيقى كمهنة)",
 "instrumentality": "أَدَاة, وَسِيلَة (مصنوعة تُستخدَم وسيلة لإنجاز غاية ما) / ذَرِيعَة, وَسِيلَة (صفة كون الشيء وسيلة لغرض ما) / أداة حكومية (جهاز فرعي للحكومة تم إنشاؤه لغرض خاص)\nمثال: هل الأدوات القضائية للحكومات المحلية كافية؟",
 "instrumentation": "تجهيز بالأدوات, توفير الأدوات (فعل توفير أو استخدام الأدوات اللازمة لتنفيذ ما) / توزيع أوركسترالي (فعل ترتيب قطعة موسيقية للأوركسترا وتعيين أجزاء للآلات الموسيقية المختلفة) / أَدَاة, وَسِيلَة (مصنوعة تُستخدَم وسيلة لإنجاز غاية ما) / تشكيلة الآلات, توزيع الآلات (الآلات المطلوبة في مدونة موسيقية أو توزيع لفرقة أو أوركسترا)",
 "insubordinate": "عَاصٍ, مُقَاوِم (مَيَّالٌ إِلَى تَحَدِّي السُّلْطَةِ القَائِمَةِ أَوْ مُنْخَرِطٌ فِيه) / عاصٍ, متمرد (غير خاضع للسلطة)\nمثال: تاريخ من السلوك المتمرد",
 "insubordination": "تَمَرُّد, عَدَم خُضُوع (فعل يتسم بالتمرد وعدم الخضوع) / تمرد, عدم انصياع (تحدي السلطة)",
 "insubstantial": "غير جوهري, غير مادي (يفتقر إلى الشكل المادي أو المادة؛ غير حقيقي) / رَقِيق, هَشّ (يفتقر إلى الصلابة أو المتانة) / فَقِير غِذَائِيًّا (يفتقر إلى القيمة الغذائيّة)\nمثال: غير جوهري مثل حلم",
 "insubstantiality": "لَا جَوْهَرِيَّة, وَهْن (الافتقار إلى الجوهر أو الواقع) / انعدام الجوهر, وهمية (نقص الجوهر الصلب والقوة)",
 "insubstantially": "بشكل غير جوهري, بوهن (ليس بشكل جوهري؛ يفتقر إلى التعبير الجوهري أو الامتلاء)",
 "insufferable": "فَوْقَ الطَّاقَة, لَا يُحْتَمَل (بالغ الشدة إلى حد لا يُطاق) / بَالِغ الغَطْرَسَة, مُتَكَبِّر لَا يُطَاق (متغطرس أو مغرور إلى حد لا يُحتمل)",
 "insufferably": "بغطرسة لا تطاق (بطريقة متعجرفة أو مغرورة للغاية) / بشكل لا يطاق (إلى درجة لا تحتمل)\nمثال: كان الجو حاراً بشكل لا يطاق في الغرفة",
 "insufficiency": "عدم كفاية, قصور (الافتقار إلى كمية أو عدد كافٍ) / قُصُور ((في علم الأمراض) عجز جزء من الجسم أو عضو عن العمل بشكل طبيعي) / عدم كفاءة, قصور (نقص الكفاءة)\nمثال: عدم كفاية إعانات البطالة",
 "insufficient": "غير كافٍ, قاصر (كمية غير قادرة على تلبية حاجة أو متطلب)\nمثال: أموال غير كافية",
 "insufficiently": "بشكل غير كاف (إلى درجة غير كافية)\nمثال: كان مستعداً بشكل غير كاف",
 "insufflation": "نفخ (فعل النفخ أو التنفس على أو داخل شيء ما) / نفخ المسحوق ((في الطب) نفخ الهواء أو مسحوق طبي في الرئتين (أو في تجويف جسمي آخر))",
 "insulant": "عازل, مادة عازلة (مادة عازلة تقلل أو تمنع انتقال الحرارة أو الصوت أو الكهرباء)",
 "insular": "جَزَرِيّ",
 "insularism": "انعزال, تقوقع (حالة العزلة أو الانفصال)\nمثال: حافظت القناة الإنجليزية على انعزال إنجلترا",
 "insularity": "انعزال, تقوقع (حالة العزلة أو الانفصال)\nمثال: حافظت القناة الإنجليزية على انعزال إنجلترا",
 "insulating tape": "شريط عازل (شريط لاصق مقاوم للماء يستخدم لعزل الموصلات الكهربائية المكشوفة)",
 "insulation": "عزل (فعل حماية شيء ما عن طريق إحاطته بمادة تقلل أو تمنع انتقال الصوت أو الحرارة أو الكهرباء) / انعزال, تقوقع (حالة العزلة أو الانفصال) / عازل, مادة عازلة (مادة عازلة تقلل أو تمنع انتقال الحرارة أو الصوت أو الكهرباء)\nمثال: حافظت القناة الإنجليزية على انعزال إنجلترا",
 "insulator": "عازل, مادة عازلة (مادة مثل الزجاج أو الخزف ذات موصلية كهربائية أو حرارية مهملة)",
 "insulin": "إِنْسُولِين",
 "insulin reaction": "صدمة الأنسولين (نقص السكر في الدم الناتج عن زيادة الأنسولين في النظام مما يسبب الغيبوبة)",
 "insulin resistance": "مُقَاوَمَة الإنْسُولِين",
 "insulin shock": "صدمة الأنسولين, علاج بصدمة الأنسولين (إعطاء كمية كافية من الأنسولين للحث على التشنجات والغيبوبة) / صدمة الأنسولين (نقص السكر في الدم الناتج عن زيادة الأنسولين في النظام مما يسبب الغيبوبة)",
 "insulin shock therapy": "صدمة الأنسولين, علاج بصدمة الأنسولين (إعطاء كمية كافية من الأنسولين للحث على التشنجات والغيبوبة)",
 "insulin shock treatment": "صدمة الأنسولين, علاج بصدمة الأنسولين (إعطاء كمية كافية من الأنسولين للحث على التشنجات والغيبوبة)",
 "insulin-dependent diabetes mellitus": "السكري المعتمد على الأنسولين, السكري من النوع الأول (داء سكري شديد يظهر مبكرًا؛ يتميز بكثرة التبول والعطش الشديد وزيادة الشهية وفقدان الوزن والحماض الكيتوني العرضي؛ يتطلب النظام الغذائي وحقن الأنسولين…)",
 "insult": "سَبَّ, شَتَمَ (تفاحة) / إهانة\nمثال: كتب سامي رواية تحتوى على أكثر من سب مئة صفحة.",
 "insulting": "مُزْدَرٍ, مُهِينٌ (يُعَبِّر عن احتقار شديد)",
 "insultingly": "بشكل مهين, بفظاظة (بطريقة غير عادلة ومهينة) / بإهانة, بوقاحة (بطريقة غير محترمة ومهينة)\nمثال: هذا الكاتب المعروف دولياً تمت إدانته بشكل مهين من قبل الأصوليين",
 "insuperable": "لَا يُذَلَّل, مُسْتَعْصٍ (لَا يُمْكِنُ تَجَاوُزُهُ أَوِ التَّغَلُّبُ عَلَيْهِ) / عَصِيّ, لَا يُقْهَر (لا يمكن التغلب عليه أو تجاوزه)",
 "insuperably": "بشكل لا يذلل, لدرجة تعجيزية (لدرجة لا يمكن التغلب عليها)\nمثال: بدت هذه المسارات المتنوعة صعبة بشكل تعجيزي للطالب",
 "insupportable": "غَيْرُ مُبَرَّر, لَا يُسَوَّغ (غَيْرُ قَابِلٍ لِلتَّبْرِيرِ أَوِ التَّفْسِير)",
 "insurability": "قَابِلِيَّة التَّأْمِين (صفة كون الشيء قابلاً للتأمين عليه)",
 "insurable": "قَابِل لِلتَّأْمِين (يمكن التأمين عليه أو مؤهّل للتأمين)",
 "insurable interest": "مصلحة تأمينية (مصلحة في شخص أو شيء تدعم إصدار بوليصة تأمين؛ مصلحة في بقاء المؤمن عليه أو في الحفاظ على الشيء المؤمن عليه)",
 "insurance": "تَأْمِين",
 "insurance agent": "مكتتب تأمين, وسيط تأمين (وكيل يقوم ببيع وثائق التأمين)",
 "insurance broker": "مكتتب تأمين, وسيط تأمين (وكيل يقوم ببيع وثائق التأمين)",
 "insurance claim": "مطالبة تأمين (المطالبة بالدفع وفقاً لبوليصة التأمين)",
 "insurance company": "شركة تأمين, مؤمّن (مؤسسة مالية تبيع بوليصات التأمين)",
 "insurance coverage": "تغطية تأمينية (المبلغ الإجمالي ونوع التأمين الذي يتم حمله)",
 "insurance firm": "شركة تأمين, مؤمّن (مؤسسة مالية تبيع بوليصات التأمين)",
 "insurance policy": "بوليصة تأمين, وثيقة تأمين (عقد مكتوب أو شهادة تأمين)\nمثال: كان عليك قراءة التفاصيل الدقيقة في بوليصتك",
 "insurance premium": "قسط التأمين (الدفع مقابل التأمين)",
 "insurance underwriter": "شركة تأمين, مؤمّن (مؤسسة مالية تبيع بوليصات التأمين)",
 "insured": "مؤمن عليه (مغطى بالتأمين) / مُؤمَّن عليه (شخص تحميه بوليصة تأمين؛ شخص يتعاقد على بوليصة تأمين تعوضه عن خسارة الممتلكات أو الحياة أو الصحة، إلخ)\nمثال: خطر مؤمن عليه",
 "insured person": "مُؤمَّن عليه (شخص تحميه بوليصة تأمين؛ شخص يتعاقد على بوليصة تأمين تعوضه عن خسارة الممتلكات أو الحياة أو الصحة، إلخ)",
 "insurer": "شركة تأمين, مؤمّن (مؤسسة مالية تبيع بوليصات التأمين)",
 "insurgence": "تَمَرُّد مُسَلَّح, عِصْيَان (تمرد منظم يهدف إلى الإطاحة بحكومة قائمة من خلال التخريب والنزاع المسلح)",
 "insurgency": "تَمَرُّد, عِصْيَان",
 "insurgent": "مُتَمَرِّد, ثَائِر",
 "insurmountable": "لَا يُذَلَّل, مُسْتَعْصٍ (لَا يُمْكِنُ تَجَاوُزُهُ أَوِ التَّغَلُّبُ عَلَيْهِ) / غير قابل للتجاوز, مستعصٍ (غير قابل للتغلب عليه أو تجاوزه)\nمثال: عيوب لا يمكن التغلب عليها",
 "insurrection": "انتفاضة",
 "insurrectional": "تمردي, عصياني (متعلق بالتمرد أو يميل إليه)",
 "insurrectionary": "تمردي, عصياني (متعلق بالتمرد أو يميل إليه)",
 "insurrectionism": "تمردية, مبدأ التمرد (مبدأ الثورة ضد السلطة القائمة)",
 "insurrectionist": "ثائِر, مُتَمَرِّد (شخص يشارك في تمرد مسلح ضد السلطة القائمة (خاصة على أمل تحسين الظروف))",
 "insusceptible": "غير سريع التأثر, غير قابل (غير سريع التأثر بـ)",
 "intact": "سَالِم, سَلِيم (يشكّل الكلّ غير المنقوص؛ لا ينقصه شيء جوهريّ وخاصةً غير متضرّر) / سَالِم, سَلِيم (غير متضرر بأي شكل من الأشكال) / سَلِيمَة, عَذْرَاء ((عن المرأة) لا يزال غشاء بكارتها سليمًا) / سَلِيم, غَيْر مَخْصِيّ ((عن الحيوانات الأليفة) كامل القدرة التناسلية)",
 "intactness": "سلامة, عدم المساس (حالة كونه غير متضرر أو سليم)",
 "intaglio": "إنتاليو, نقش غائر (فن نحت يتكون من نقش أو نحت غائر أو منخفض على حجر أو جوهرة (عكس الكاميو)) / طباعة غائرة, غرافور (عملية طباعة تستخدم لوحاً محفوراً أو منقوشاً؛ يُلطخ اللوح بالحبر ويُمسح لينظف، ثم يصنع الحبر المتبقي في التجاويف الطبعة)",
 "intaglio printing": "طباعة غائرة, غرافور (عملية طباعة تستخدم لوحاً محفوراً أو منقوشاً؛ يُلطخ اللوح بالحبر ويُمسح لينظف، ثم يصنع الحبر المتبقي في التجاويف الطبعة)",
 "intake": "استنشاق, شهيق (فعل الشهيق؛ سحب الهواء (أو غازات أخرى) للداخل كما في التنفس) / ابتلاع, استهلاك (عملية إدخال الطعام إلى الجسم عن طريق الفم (مثل الأكل)) / مأخذ, مدخل (فتحة يتم من خلالها إدخال السائل إلى أنبوب أو حاوية)",
 "intake manifold": "مشعب السحب (مشعب يتكون من أنبوب لنقل الوقود إلى كل أسطوانة في محرك الاحتراق الداخلي)",
 "intake valve": "صمام السحب (صمام يتحكم في تدفق السائل عبر مدخل)",
 "intangibility": "تَعَذُّر اللَّمْس, لَا مَلْمُوسِيَّة (صفة كون الشيء غير ملموس ولا يدرك باللمس)",
 "intangible": "غَيْر مَلْمُوس, مَعْنَوِيّ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "intangible asset": "أصل غير ملموس, أصول معنوية (أصول قابلة للبيع وإن لم كانت مادية أو فيزيائية)",
 "intangible cultural heritage": "تراث ثقافي غير مادي",
 "intangibleness": "تَعَذُّر اللَّمْس, لَا مَلْمُوسِيَّة (صفة كون الشيء غير ملموس ولا يدرك باللمس)",
 "integer": "عَدَد صَحِيح (مِقْدَار مَا يُعَدّ)\nمثال: كم عدد سكان الجزائر؟",
 "integral": "صَحِيح / تَكَامُلِيّ",
 "integral calculus": "حساب التكامل (جزء التفاضل والتكامل الذي يتعامل مع التكامل وتطبيقه في حل المعادلات التفاضلية وتحديد المساحات أو الأحجام)",
 "integrality": "تمام, كليّة (حالة كونه كلياً وكاملاً)\nمثال: قرأ المقال برمته",
 "integrally": "بشكل جوهري, تكاملية (بطريقة تكاملية)",
 "integrated": "غير مفصول عنصرياً, مدمج (غير مفصول؛ مخصص ليكون متاحاً لجميع الأعراق أو الفئات) / متكامل, موحد (متشكل في كل واحد أو مُدخل في كيان آخر) / مُتَكَامِل, مُهَيْكَل (يُشبه الكائن الحي في التنظيم أو التطور) / مُتَكَامِل, مُدْمَج (تشكّل أو اتحد في كلّ واحد متكامل)\nمثال: مدارس مشتركة (مدمجة)",
 "integrated circuit": "دارة متكاملة (لا جمع له)",
 "integrated data processing": "معالجة متكاملة للبيانات (معالجة آلية للبيانات يتم فيها دمج الحصول على البيانات ومراحل المعالجة الأخرى في نظام متماسك)",
 "integrated logistic support": "دعم لوجستي متكامل (تجميع موارد محددة من الدول المشتركة لدعم عملية مشتركة)",
 "integrating": "إِدْمَاج, دَمْج (فعل دمج مجموعة عرقية أو دينية في مجتمع ما)",
 "integration": "مُكَامَلَة",
 "integrative": "تَكَامُلِيّ, تَوْحِيدِيّ (يميل إلى الدمج والتوحيد) / تكاملي, توحيدي (يجمع وينسق عناصر متنوعة في كل واحد)",
 "integrator": "مقياس المساحة, مكامل (أداة قياس لقياس مساحة شكل مستوٍ غير منتظم)",
 "integrity": "أَمَانَة, نَزَاهَة / سَلَامَة",
 "integument": "غِطَاء, لِحَاف (غطاء واقٍ خارجي مثل جلد الحيوان أو قشرة أو غلاف بذرة أو قشر أو صدفة)",
 "integumental": "جلدي, لحافي (من أو متعلق باللحاف (الغطاء الخارجي للجسم))",
 "integumentary": "جلدي, لحافي (من أو متعلق باللحاف (الغطاء الخارجي للجسم))",
 "integumentary system": "الجهاز اللحافي (الجلد وملحقاته)",
 "intel": "إِنْتَل",
 "intellect": "عَقْل, فِطْنَة (أمسك بأطرافه وربطه، أصلها للشاة والإبل حيث تربط قوائمها كي تبقى باركة فلا تقوم؛ بلغ العَقْل، أصبح عاقلا فاهما راشدا)\nمثال: هي فتاة تسحر العقل.",
 "intellection": "تفكير, فكر (عملية استخدام عقلك للنظر في شيء ما بعناية)\nمثال: التفكير دائماً ما يجعله يعبس",
 "intellectual": "ذهني, عقلي (يخاطب أو يستخدم الفكر والعقل) / عَقْلَانِيّ, فِكْرِيّ (مرتبط بالعقل أو يتطلّب استخدامه) / ذهني, فكري (يشمل الذكاء بدلاً من العواطف أو الغريزة) / مثقف, مفكر (شخص يستخدم عقله بشكل إبداعي)\nمثال: السخرية سلاح فكري",
 "intellectual nourishment": "غذاء للفكر, مادة للتفكير (أي شيء يوفر حافزاً عقلياً للتفكير)",
 "intellectual property": "مِلْكِيَّة فِكْرِيَّة",
 "intellectualisation": "عقلنة ((في الطب النفسي) آلية دفاع تستخدم المنطق لحجب الضغوط والصراعات العاطفية)",
 "intellectualism": "فكرانية",
 "intellectualization": "عقلنة ((في الطب النفسي) آلية دفاع تستخدم المنطق لحجب الضغوط والصراعات العاطفية)",
 "intellectually": "عقلياً, فكرياً (فيما يتعلق بالفكر)\nمثال: أطفال موهوبون فكرياً",
 "intelligence": "جِهَاز الْمُخَابَرَات, مُخَابَرَات",
 "intelligence activity": "استخبارات (عملية جمع المعلومات عن عدو)",
 "intelligence agency": "وَكَالَةْ اِسْتِخْبَار",
 "intelligence agent": "ضابط استخبارات, عميل سري (شخص يعمل سراً في التجسس لصالح حكومة)",
 "intelligence analyst": "محلل استخبارات (محلل حكومي للمعلومات المتعلقة بعدو أو عدو محتمل)",
 "intelligence cell": "خلية استخبارات (خلية إرهابية يتم تدريب أعضائها على أداء الاستطلاع والمراقبة)",
 "intelligence community": "مجتمع الاستخبارات (مجموعة من الوكالات والمنظمات الحكومية التي تقوم بأنشطة استخباراتية لحكومة الولايات المتحدة؛ يرأسها مدير الاستخبارات المركزية)",
 "intelligence information": "استخبارات, معلومات استخباراتية (معلومات سرية حول عدو (أو عدو محتمل))\nمثال: أرسلنا طائرات لجمع معلومات استخباراتية حول تغطية رادارهم",
 "intelligence officer": "ضَابِطُ اِسْتِخْبَارَات",
 "intelligence operation": "استخبارات (عملية جمع المعلومات عن عدو)",
 "intelligence quotient": "مُعَدَّل ذَكَاء (هو الأمر الذي جرى عليه تَعْدِيل فهو أفضل من ما يناظره؛ السيارة المعدّلة تسير بسرعة أكبر من مثيلاتها)\nمثال: انخفض معدل الجريمة.",
 "intelligence service": "استخبارات, جهاز استخبارات (وحدة مسؤولة عن جمع وتفسير المعلومات عن العدو)",
 "intelligence test": "اختبار ذكاء (اختبار نفسي لقياس الذكاء)\nمثال: اعتادوا الاعتقاد بأن الذكاء هو ما يختبره اختبار الذكاء",
 "intelligent": "ذَكِيّ (ذَكِيَ: صار شديد الفطنة وسريع البديهة؛ ذكِيَ التلميذ في مهارات الحساب الدهني)\nمثال: إنه وسيم و ذكي.",
 "intelligent design": "التَصْمِيم الذَكِيّ",
 "intelligently": "بذكاء (بطريقة ذكية)\nمثال: تصرفت بذكاء في هذا الموقف الصعب",
 "intelligentsia": "أَنْتِلِيجِنْسْيَا, أَهْل اَلْفَكْر",
 "intelligibility": "مَفْهُومِيَّة, وُضُوح المَعْنَى (صفة اللغة التي تكون مفهومة)",
 "intelligible": "بائِن, بَيّن",
 "intelligibly": "بشكل مفهوم, بوضوح (بطريقة يمكن فهمها)\nمثال: تحدث الأجنبي إلينا بشكل مفهوم تماماً",
 "intelnet": "إنتلنت (شبكة كمبيوتر تشبه الإنترنت ولكنها منفصلة عنها؛ مخصصة لنشر المعلومات من وإلى مجتمع الاستخبارات)",
 "intemperance": "إفراط, شره (الإفراط في العمل والانغماس غير المعتدل في الشهوات الجسدية، خاصة في العاطفة أو التساهل) / إفراط, عدم اعتدال (استهلاك المشروبات الكحولية) / إفراط, عدم اعتدال (جودة عدم الاعتدال)\nمثال: تطرف لغتهم",
 "intemperate": "مُدْمِن, مُسْرِف (مُنغمس بإفراط في شهوات الجسد خاصّة المشروبات المُسكرة) / جامح, غير معتدل (مفرط في السلوك) / غير معتدل, قاس ((للطقس أو المناخ) ليس معتدلاً؛ عرضة للتطرف)\nمثال: غضب جامح",
 "intemperately": "بإفراط, بشراهة (الانغماس بإفراط)\nمثال: شرب بإفراط",
 "intemperateness": "إفراط, شره (الإفراط في العمل والانغماس غير المعتدل في الشهوات الجسدية، خاصة في العاطفة أو التساهل) / إفراط, عدم اعتدال (استهلاك المشروبات الكحولية)\nمثال: تطرف لغتهم",
 "intend": "تَعَمَّدَ, نَوَى",
 "intended": "خَطِيب, مَنْوِيّ الزَّوَاج (مُقبِل على الزواج؛ مخطوب) / متعمد, مخطط له (ناتج عن نوايا الشخص)\nمثال: رحلتك المقررة إلى الخارج",
 "intense": "شَدِيد",
 "intensely": "بشدة, بعمق (إلى عمق كبير نفسياً أو عاطفياً) / بشدة, مكثفاً (إلى درجة عالية؛ بتركيز عال)\nمثال: شعروا بالخسارة بعمق",
 "intensification": "تشديد, تكثيف (إجراء يجعل الشيء أقوى أو أكثر حدة) / تكثيف (عملية زيادة تباين (الفيلم الفوتوغرافي))",
 "intensified": "مُعَزَّز, مُكَثَّف (جُعِلَ أَكْثَرَ شِدَّةً وَحِدَّة)",
 "intensifier": "أداة توكيد, مُقَوّي للمعنى (معدِّل ليس له معنى كبير سوى تقوية المعنى الذي يعدله)\nمثال: كلمة 'حقاً' في جملة 'أنا لا أعرف حقاً' هي أداة توكيد",
 "intensifying": "متصاعد, مكثف (متزايد في القوة أو الشدة)",
 "intension": "تَضَمُّن, دَلَالَة (ما يجب معرفته لتحديد مرجع تعبير ما)",
 "intensional": "مَفْهُومِيّ (يُسْتَخْدَمُ لِمَجْمُوعَةِ الصِّفَاتِ الَّتِي تُمَيِّزُ مَرْجِعِيَّاتِ كَلِمَةٍ مُعَيَّنَة)",
 "intensity": "شِدَّة",
 "intensity level": "شدة, قوة (مقدار الطاقة المنقولة (عن طريق الإشعاع الصوتي أو الكهرومغناطيسي))\nمثال: قام بضبط شدة الصوت",
 "intensive": "مُكَثَّف, مُكَثَّفَة",
 "intensive care": "عِنَايَة مُرَكَّزَة",
 "intensive care unit": "وَحَدة العِنَايَة المُرَكَّزة",
 "intensively": "بشكل مكثف (بطريقة مكثفة)\nمثال: درس الثعبان بشكل مكثف",
 "intensiveness": "شدة, كثافة (مستوى أو درجة عالية؛ خاصية كون الشيء شديداً)",
 "intent": "نِيَّة",
 "intention": "قَصْد, إِرَادَة",
 "intentional": "عَمْدِيّ, إرَادِيّ",
 "intentionality": "عمد, قصدية (معبر عن النوايا)",
 "intentionally": "عَمْدًا",
 "intently": "بإمعان, بتركيز (بانتباه متوتر أو متلهف)\nمثال: استمع بإمعان",
 "intentness": "انكباب, انهماك (جودة كون المرء منتبهاً ومركزاً)\nمثال: شدة انتباه نظرته",
 "inter": "يَقْبِر",
 "inter alia": "مِن بَيْنَ أُمُور أُخْرَى (من بين أشياء أخرى)\nمثال: أوصت اللجنة، من بين أمور أخرى، بترقيته",
 "inter vivos trust": "ائتمان بين الأحياء, ائتمان حي (ائتمان ينشأ ويعمل خلال حياة المانح)",
 "inter-group communication": "اتصال, رابط (قناة للتواصل بين المجموعات)\nمثال: وفر اتصالاً مع المتمردين",
 "inter-service support": "دعم بين الخدمات (إجراء من قبل خدمة عسكرية لتقديم الدعم اللوجستي (أو الإداري) لخدمة عسكرية أخرى)",
 "inter-services intelligence": "المخابرات الباكستانية, وكالة الاستخبارات الباكستانية (وكالة الاستخبارات الباكستانية؛ قوة سياسية وعسكرية قوية وشبه مستقلة)",
 "interaction": "تَآثُر, تَفَاعُل / مُخَالَطَة, تَفَاعُل",
 "interactional": "تَفَاعُلِيّ (قادر على التأثير المتبادل)",
 "interactive": "تآزري, تفاعلي (يستخدم بشكل خاص للأدوية أو العضلات التي تعمل معاً بحيث يكون التأثير الكلي أكبر من مجموع الاثنين (أو أكثر)) / تَفَاعُلِيّ (قادر على التأثير المتبادل)",
 "interactive multimedia": "وسائط فائقة, وسائط متعددة تفاعلية (نظام وسائط متعددة يتم فيه ربط عناصر المعلومات ذات الصلة ويمكن تقديمها معاً)",
 "interactive multimedia system": "وسائط فائقة, وسائط متعددة تفاعلية (نظام وسائط متعددة يتم فيه ربط عناصر المعلومات ذات الصلة ويمكن تقديمها معاً)",
 "interagency support": "دعم بين الإدارات (توفير الدعم اللوجستي (أو الإداري) من قبل واحدة أو أكثر من الخدمات العسكرية لإدارة أو وكالة تابعة للحكومة)",
 "interbank loan": "قرض بين المصارف, قرض ما بين البنوك (قرض من مصرف لآخر)",
 "interbrain": "دماغ بيني (القسم الخلفي من الدماغ الأمامي؛ يربط نصفي الكرة المخية بالدماغ المتوسط)",
 "interbred": "مُتَزَاوِج دَاخِلِيًّا (ناتج عن تزاوج أبوَيْن قريبَيِ القرابة)",
 "interbreeding": "تزاوج بين الأعراق (التكاثر بين أبوين من أعراق مختلفة) / تزاوج خلطي, تهجين ((في الوراثة) فعل خلط أنواع أو أصناف مختلفة من الحيوانات أو النباتات لإنتاج هجائن)",
 "intercalary": "كَبِيس",
 "intercalary year": "سنة كبيسة (سنة تقويمية يضاف فيها يوم إضافي في شهر فبراير)",
 "intercalation": "إقحام, كبس (إدراج في التقويم (مثل يوم كبيس))",
 "intercapitular vein": "وريد بين الرؤوس (أوردة تربط الأوردة الظهرية والراحية لليد أو الأوردة الظهرية والأخمصية للقدم)",
 "intercellular": "بين خلوي (يقع بين الخلايا)",
 "intercellular substance": "مادة خلالية, مصفوفة (مادة الجسم التي تنغمس فيها خلايا الأنسجة)",
 "intercept": "اِعْتَرَضَ (سار عارضا بدون هدف وتخطيط كما تكون الخشبة الطافية في الماء؛ الشيءَ أو الشخصَ: حَالَ بينه وبين ما يريد، أو وقف في طريقه)\nمثال: اعترض ديما: \"لكن هذا سخيف! الكوبيكات لم تعد تستخدم منذ عصور! و0.99 ليس رقما طبيعيا حتى!\"",
 "interception": "اعتراض الكرة ((كرة القدم الأمريكية) فعل التقاط كرة القدم من قبل لاعب في الفريق المنافس) / اعتراض (فعل الاعتراض؛ منع شيء ما من المضي قدماً أو الوصول)\nمثال: لجأ إلى اعتراض رسائل ابنته",
 "interceptor": "طائرة اعتراضية, معترضة (طائرة مقاتلة سريعة وقادرة على المناورة مصممة لاعتراض طائرات العدو)",
 "intercessio": "حق النقض (حق النقض (الفيتو) الذي يمتلكه القضاة الرومان)",
 "intercession": "وَسَاطَة / شَفَاعَة",
 "intercessor": "حلقة وصل, وسيط (مفاوض يعمل كحلقة وصل بين الأطراف)",
 "interchange": "أخذ وعطاء, تبادل (تفاعل متبادل؛ نشاط المبادلة (خاصة المعلومات)) / تبادل عملات, صرافة (تحويل متبادل لمبالغ مالية متكافئة (خاصة عملات الدول المختلفة)) / تَبَادُل (فعل تغيير شيء بشيء آخر) / تقاطع طرق, محول طرق (تقاطع طرق سريعة على مستويات مختلفة يسمح بحركة المرور من طريق إلى آخر دون عبور مسارات المرور)\nمثال: يكسب عيشه من تبادل العملات",
 "interchangeability": "تَبَادُلِيَّة, قَابِلِيَّة لِلتَّبَادُل (صفة القابلية للاستبدال أو التبادل)",
 "interchangeable": "قَابِلٌ لِلتَّبَادُلِ, مُعَيَّرٌ (يمكن أن يحل محل شيء آخر أو يتبادل معه دون فقدان الوظيفة) / قَابِل لِلتَّبَادُل ((في الرياضيات والمنطق) بحيث يمكن تبادل الحُجج أو الأدوار)",
 "interchangeableness": "تَبَادُلِيَّة, قَابِلِيَّة لِلتَّبَادُل (صفة القابلية للاستبدال أو التبادل)",
 "interchangeably": "بالتبادل, بشكل مترادف (بطريقة قابلة للتبادل)\nمثال: يمكن استخدام هذه المصطلحات بالتبادل",
 "interchurch": "بَيْنَ كَنَسِيّ, مُشْتَرَك بَيْنَ المَذَاهِب (يحدث بين الكنائس أو الطوائف المختلفة أو مشترك بينها)",
 "intercollegiate": "بَيْنَ جَامِعِيّ (يُستخدم في التنافس بين الكليات أو الجامعات)",
 "intercom": "إنتركم, اتصال داخلي (نظام اتصالات يربط بين غرف مختلفة داخل مبنى أو سفينة وما إلى ذلك)",
 "intercom speaker": "مكبر صوت الاتصال الداخلي (مكبر الصوت في نظام الاتصال الداخلي أو نظام الإذاعة العامة)",
 "intercommunication": "تواصل متبادل (تواصل متبادل؛ تواصل مع بعضهم البعض)\nمثال: اعترضوا التواصل المتبادل بين سفن العدو",
 "intercommunication system": "إنتركم, اتصال داخلي (نظام اتصالات يربط بين غرف مختلفة داخل مبنى أو سفينة وما إلى ذلك)",
 "intercommunion": "تناول مشترك (المشاركة في القربان المقدس من قبل أعضاء أكثر من كنيسة واحدة (مثل الكاثوليكية والأرثوذكسية))",
 "interconnected": "مُتَرَابِط, مُنَسَّق (يعمل كوحدة واحدة متناسقة) / مُتَدَاخِل, مُتَرَابِط (متصل بشكل متبادل)",
 "interconnectedness": "ترابط متبادل (حالة من الاتصال المتبادل)\nمثال: ترابط متبادل بين المبنيين",
 "interconnection": "ترابط, توصيل بيني ((علم الحاسوب) عملية التوصيل البيني (للأسلاك أو أجهزة الكمبيوتر أو النظريات وما إلى ذلك)) / ترابط متبادل (حالة من الاتصال المتبادل)\nمثال: ترابط متبادل بين المبنيين",
 "intercontinental": "عابر للقارات (يمتد أو يحدث بين القارات)\nمثال: استكشاف عابر للقارات",
 "intercontinental ballistic missile": "صاروخ باليستي عابر للقارات (صاروخ باليستي قادر على السفر من قارة إلى أخرى)",
 "intercostal": "وَرْبِيَّة, وَرْبِيّ",
 "intercostal artery": "شريان بين الضلوع, شريان ورابي (عدة شرايين تغذي المسافات الوربية (بين الأضلاع) في القفص الصدري)",
 "intercostal muscle": "عضلة بين الضلوع, عضلة ورقية (عضلات بين الأضلاع؛ تنقبض أثناء الشهيق)",
 "intercostal vein": "وريد بين الضلوع, وريد ورابي (عدة أوردة تصرف المسافات الوربية للقفص الصدري)",
 "intercourse": "حِوَار / جِمَاع (الموافقة والمساعدة في أي شيء كان؛ الشيء: جمعه)\nمثال: توم قائد جماعة أنونيموس.",
 "intercrossed": "مُخْتَلَط, هَجِين (ناتج عن التهجين والتزاوج بين أصناف مختلفة)",
 "interdenominational": "بَيْنَ كَنَسِيّ, مُشْتَرَك بَيْنَ المَذَاهِب (يحدث بين الكنائس أو الطوائف المختلفة أو مشترك بينها)",
 "interdental": "أَسَلِيّ",
 "interdepartmental": "بين الإدارات (بين الأقسام أو الإدارات المختلفة) / بين الإدارات, مشترك بين الأقسام (بين أو عبر الأقسام)\nمثال: تم تعميم هذه المذكرة بين الإدارات",
 "interdepartmental support": "دعم بين الإدارات (توفير الدعم اللوجستي (أو الإداري) من قبل واحدة أو أكثر من الخدمات العسكرية لإدارة أو وكالة تابعة للحكومة)",
 "interdependence": "اعْتِمَاد مُتَبَادَل, تَبَادُل (علاقة متبادلة بين كيانات مترابطة (أشياء أو أفراد أو مجموعات))",
 "interdependency": "اعْتِمَاد مُتَبَادَل, تَبَادُل (علاقة متبادلة بين كيانات مترابطة (أشياء أو أفراد أو مجموعات))",
 "interdependent": "تَكَافُلِيّ, مُتَبَادِلُ الاعْتِمَاد (يَعْتَمِدُ كُلٌّ مِنْهُمَا عَلَى الآخَر)",
 "interdict": "أمر حجر, قرار حظر (أمر محكمة يمنع طرفاً من القيام بنشاط معين) / تَحْرِيم, حِرْمَان كَنَسِيّ (لوم كنسي من قبل الكنيسة الكاثوليكية يسحب أسراراً معينة والدفن المسيحي من شخص أو جميع الأشخاص في منطقة معينة)",
 "interdiction": "أمر حجر, قرار حظر (أمر محكمة يمنع طرفاً من القيام بنشاط معين) / تحريم, حظر رسمي (حظر سلطوي)",
 "interdiction fire": "نيران اعتراضية (نيران توجه لمنطقة لمنع العدو من استخدام تلك المنطقة)",
 "interdisciplinary": "متعدد التخصصات, مشترك التخصصات (يستمد من أو يتميز بمشاركة مجالين دراسيين أو أكثر)\nمثال: دراسات متعددة التخصصات",
 "interest": "فَائِدَة",
 "interest expense": "مصاريف الفوائد (الفوائد المدفوعة على القروض)",
 "interest group": "أصحاب المصالح, مجموعة مصالح ((عادة بصيغة الجمع) مجموعة اجتماعية يسيطر أعضاؤها على مجال نشاط معين ولهم أهداف مشتركة)\nمثال: كثف أصحاب مصالح الحديد الإنتاج",
 "interest rate": "سِعْر الْفَائِدَة (سَعِرَ يَسْعَرَ سَعَراً، وسُعْرَةً: ضرب لونه إِلى السواد فُوَيْقَ الأُدْمة؛ فهو أَسْعَرُ، وهي سَعْراءُ. والجمع: سُعْرٌ)\nمثال: إتفقوا على سعر.",
 "interest-bearing": "مدر للفائدة (للالتزامات المالية التي يُدفع عليها فائدة)",
 "interested": "مُهْتَمّ",
 "interestedness": "اهتمام (حالة الاهتمام بشيء ما)",
 "interesting": "مُشَوِّق, ممتع",
 "interestingly": "بشكل مثير للاهتمام (بطريقة مثيرة للاهتمام)",
 "interestingness": "إثارة للاهتمام, تشويق (قوة جذب الانتباه أو الاحتفاظ به (لأنه غير عادي أو مثير وما إلى ذلك))\nمثال: لم يقولوا شيئًا ذا أهمية كبيرة",
 "interface": "واجِهَة",
 "interfacial": "بيني, واجهي (متعلق بسطح بيني (فاصل) أو يقع عنده)\nمثال: طبقة بينية",
 "interfacial surface tension": "توتر بين سطحي (توتر سطحي عند السطح الفاصل بين سائلين غير قابلين للامتزاج)",
 "interfacial tension": "توتر بين سطحي (توتر سطحي عند السطح الفاصل بين سائلين غير قابلين للامتزاج)",
 "interfaith": "بَيْن أَدْيَانِيّ (يشمل أشخاصًا من أديان مختلفة)",
 "interference": "تَدَاخُل",
 "interference fringe": "هدب, هدب التداخل (أحد النطاقات المضيئة أو المظلمة الناتجة عن تداخل وحيود الضوء)",
 "interfering": "فُضُولِيّ, مُتَدَخِّل (يتدخل في شؤون الآخرين بطريقة مزعجة)",
 "interferometer": "مقياس التداخل (أي أداة قياس تستخدم أنماط التداخل لإجراء قياسات دقيقة للموجات)",
 "interferon": "إنترفيرون (بروتين مضاد للفيروسات تنتجه الخلايا التي غزاها الفيروس؛ يثبط تكاثر الفيروس)",
 "interfixation": "إضافة بينية, إقحام بيني (اشتقاق كلمة جديدة بإدخال لاحقة بينية بين مقطعين صرفيين)",
 "intergalactic": "بين المجرات (يقع بين المجرات)\nمثال: فضاء بين المجرات",
 "intergalactic space": "فضاء بين المجرات (الفضاء الموجود بين المجرات)\nمثال: درب التبانة تسافر عبر الفضاء بين المجرات",
 "interim": "انْتِقَالِيّ, مَرْحَلِيّ (يخدم خلال فترة زمنيّة وسيطة) / أثناء ذلك, فترة مؤقتة (الوقت بين حدث أو عملية أو فترة وأخرى)\nمثال: في غضون ذلك، يدير الاشتراكيون الحكومة",
 "interim overhaul": "عمرة مؤقتة (إصلاح شامل بين الأوقات المنتظمة للإصلاح الشامل)",
 "interior": "جَوْفِيّ, دَاخِلِيّ (من وسط المنطقة أو البلاد أو قادم منه) / جَوَّانِيّ, دَاخِلِيّ (في الداخل وباتجاه المركز) / بَاطِنِيّ, دَاخِلِيّ (يقع في الداخل ويتعلق بالعالم النفسي والعقلي) / داخلي (يقع في أو مناسب لداخل مبنى)\nمثال: مشهد داخلي",
 "interior angle": "زاوية داخلية (الزاوية داخل ضلعين متجاورين لمضلع)",
 "interior decorating": "تصميم داخلي, ديكور داخلي (مهنة أو عمل تزيين الجزء الداخلي للمبنى أو الغرفة، خاصة فيما يتعلق بتركيب الألوان والطلاء والأقمشة والسجاد، إلخ)",
 "interior decoration": "تصميم داخلي, ديكور داخلي (مهنة أو عمل تزيين الجزء الداخلي للمبنى أو الغرفة، خاصة فيما يتعلق بتركيب الألوان والطلاء والأقمشة والسجاد، إلخ) / ديكور داخلي (زينة تتكون من تخطيط وأثاث مكان صالح للسكن)",
 "interior decorator": "مزخرف داخلي, مهندس ديكور (شخص يتخصص في الديكور الداخلي)",
 "interior department": "وزارة الداخلية (الإدارة الفيدرالية الأمريكية المكلفة بالحفاظ على الموارد الطبيعية وتنميتها؛ أنشئت عام 1849)",
 "interior design": "هَنْدَسَةُ دِيكُور (الحدُّ والقياس؛ في الرياضيات: هي العلم الذي يبحث في الأشكال وعلاقاتها من حيث الخطوط والأبعاد والسطوح وغيرها)\nمثال: هو ضليع في علم الهندسة .",
 "interior designer": "مصمم داخلي (شخص يتخصص في التصميم الداخلي)",
 "interior door": "باب داخلي (باب يغلق الغرف داخل المبنى)",
 "interior live oak": "سنديان داخلي حي (شجرة شجيرية صغيرة دائمة الخضرة موطنها غرب أمريكا الشمالية تشبه سنديان الساحل الحي ولكنها توجد بشكل رئيسي في سفوح السلاسل الجبلية البعيدة عن الساحل؛…)",
 "interior monologue": "مونولوج داخلي (نوع أدبي يقدم تسلسل أفكار شخصية خيالية في شكل مونولوج)",
 "interior secretary": "وزير الداخلية (منصب رئيس وزارة الداخلية) / وزير الداخلية (الشخص الذي يشغل منصب وزير وزارة الداخلية)\nمثال: تم إنشاء منصب وزير الداخلية عام 1849",
 "interjection": "حَرْف نِدَاء (طَرَف وَجَانِب وَحَدّ؛ رَمْز مخطوط أو مطبوع يقوم مقام صوت أو كلمة أو عبارة أو معنى)\nمثال: ألف هو الحرف الأول للألف باء.",
 "interlaced": "مُتَشَابِك, مُشَبَّك (ذو نمط زخرفيّ شبكيّ أو مُخرَّم)",
 "interlacing": "مُتَدَاخِل, مُتَشَابِك (مُرْتَبِط أَوْ مُتَشَابِك بِإِحْكَام)",
 "interlanguage": "لغة تفاهم مشترك, لغة مشتركة (لغة مشتركة يستخدمها متحدثو لغات مختلفة)\nمثال: كانت لغة الكوينيه لهجة من اليونانية القديمة التي كانت اللغة المشتركة لإمبراطورية الإسكندر الأكبر",
 "interlayer": "طبقة بينية (طبقة توضع بين طبقات أخرى)",
 "interleaf": "ورقة بينية (ورقة فارغة تدرج بين أوراق الكتاب)",
 "interleukin": "إنترلوكين (أي من عدة لمفوكينات تعزز الخلايا البلعمية والخلايا التائية القاتلة والخلايا البائية ومكونات أخرى من الجهاز المناعي)",
 "interlineal": "بين السطور (مكتوب بين سطور النص)",
 "interlinear": "بين السطور (مكتوب بين سطور النص)",
 "interlingua": "إِنْتَرْلِنْغْوَا",
 "interlingual rendition": "ترجمة, نقل لغوي (تواصل مكتوب بلغة ثانية يحمل نفس معنى التواصل المكتوب بلغة أولى)",
 "interlinking": "مُتَدَاخِل, مُتَشَابِك (مُرْتَبِط أَوْ مُتَشَابِك بِإِحْكَام)",
 "interlobular": "بين الفصيصات (بين الفصوص أو الفصيصات)",
 "interlock": "تداخل, تشابك (فعل التشابك أو التداخل) / جهاز منع التشغيل, قفل تعشيق (جهاز يمنع محرك السيارة من البدء)\nمثال: تشابك أذرع الشرطة أبقى الحشد تحت السيطرة",
 "interlocking": "تداخل, تشابك (فعل التشابك أو التداخل) / مُتَدَاخِل, مُتَشَابِك (مُرْتَبِط أَوْ مُتَشَابِك بِإِحْكَام) / اشتباك, تداخل (تلامس عن طريق التداخل أو التركيب معاً)\nمثال: تشابك أذرع الشرطة أبقى الحشد تحت السيطرة",
 "interlocutor": "مُحَاوِر, مُتَحَاوِر",
 "interlocutory": "حواري (يتكون من حوار)",
 "interlocutory injunction": "أمر قضائي مؤقت, أمر وقتي (أمر قضائي يصدر أثناء المحاكمة للحفاظ على الوضع الراهن أو الحفاظ على موضوع الدعوى حتى انتهاء المحاكمة)",
 "interloper": "دخيل, متطفل (شخص يقتحم خصوصية أو ممتلكات آخر دون إذن)",
 "interlude": "فاصل, فقرة بينية (عرض قصير (موسيقى أو رقص وما إلى ذلك) يُدرج بين أقسام عرض أطول) / فاصل, فترة بينية (فترة أو حلقة فاصلة)",
 "intermarriage": "زواج الأقارب, زواج داخلي (الزواج داخل قبيلة أو مجموعة المرء كما يقتضي العرف أو القانون) / زواج خارجي, زواج مختلط (الزواج من شخص ينتمي إلى قبيلة أو مجموعة أخرى غير مجموعتك كما يقتضي العرف أو القانون)",
 "intermaxillary suture": "درز بين الفكين (الدرز بين عظمي الفك العلوي)",
 "intermediary": "حلقة وصل, وسيط (مفاوض يعمل كحلقة وصل بين الأطراف)",
 "intermediate": "بيني, متوسط (الواقع بين نقيضين أو طرفين في الزمان أو المكان أو الحالة) / مُتَوَسِّط, وَسَط (فِي حُدُودِ الوَسَطِ عَلَى مِقْيَاسِ التَّقْيِيم) / مركب وسيط, وسيط كيميائي (مادة تتشكل أثناء عملية كيميائية قبل الحصول على المنتج المطلوب)\nمثال: الانتقال من الجلوس إلى الوقوف دون دفعات وسيطة باليدين",
 "intermediate host": "عائل وسيط (عائل يستخدمه الطفيلي في سياق دورة حياته)",
 "intermediate shroud": "حبال التدعيم المتوسطة (حبال تدعيم مثبتة على منصات ذات موزعات متعددة)",
 "intermediate temporal artery": "شريان صدغي متوسط (شريان صدغي يذهب إلى الجزء الأوسط من القشرة المخية للفص الصدغي)",
 "intermediate vector boson": "بُوزُون مُتَوَسِّط (بوزون معياري يتوسط التفاعلات الضعيفة بين الجسيمات)",
 "intermediate wheatgrass": "عشبة القمح المتوسطة (عشبة آسيوية أدخلت إلى المراعي في الولايات المتحدة للرعي والعلف)",
 "intermediately": "بشكل متوسط (لدرجة متوسطة)\nمثال: حار بشكل متوسط",
 "intermediation": "وِسَاطَة (فعل التدخل بغرض التوصل إلى تسوية)",
 "intermediator": "حلقة وصل, وسيط (مفاوض يعمل كحلقة وصل بين الأطراف)",
 "interment": "دَفْن (دَفَنَهُ يَدْفِنُهُ: سَتَرَهُ، وواراه)\nمثال: دفن القط فضلاته.",
 "intermeshed": "مُتَشَابِك كَالشَّبَكَة (عالق كما في شبكة) / مُتَشَابِك, مُعَشَّق ((عن الأجزاء المسننة أو التروس) متشابك ومتفاعل)",
 "intermezzo": "فاصل, فقرة بينية (عرض قصير (موسيقى أو رقص وما إلى ذلك) يُدرج بين أقسام عرض أطول) / إنترميزو, فاصل موسيقي (قطعة قصيرة من الموسيقى الآلية مؤلفة للأداء بين فصول الدراما أو الأوبرا) / إنترميزو (حركة قصيرة تأتي بين الأقسام الرئيسية للسيمفونية)",
 "interminable": "لَا نِهَائِيّ, لَا يَنْتَهِي (طَويل بِشَكْل مُمِلّ؛ يَبْدو بِلا نِهايَة)",
 "interminably": "إِلَى مَا لَا نِهَايَة (طوال الوقت؛ يبدو بلا توقف)\nمثال: طالب لاهوت جادلت معه بلا نهاية",
 "intermission": "فاصِل",
 "intermittence": "تَقَطُّع (صفة كون الشيء متقطعاً؛ خاضعاً للانقطاع أو التوقف الدوري)",
 "intermittency": "تَقَطُّع (صفة كون الشيء متقطعاً؛ خاضعاً للانقطاع أو التوقف الدوري)",
 "intermittent": "مُتَقَطِّع / مَوْسِمِيّ",
 "intermittent claudication": "عرج متقطع (عرج ناتج عن ألم في عضلات الساق بسبب عدم كفاية إمدادات الدم؛ يهدأ الألم مع الراحة)",
 "intermittent cramp": "تكزز (متلازمة عصبية سريرية تتميز بوخز وتشنجات عضلية ونوبات (عندما تكون شديدة)؛ ترتبط بنقص الكالسيوم (قصور جارات الدرق) أو نقص فيتامين د أو القلاء)",
 "intermittent tetanus": "تكزز (متلازمة عصبية سريرية تتميز بوخز وتشنجات عضلية ونوبات (عندما تكون شديدة)؛ ترتبط بنقص الكالسيوم (قصور جارات الدرق) أو نقص فيتامين د أو القلاء)",
 "intermittently": "بشكل متقطع, على فترات (بطريقة متقطعة)\nمثال: استجوبنا البارومتر بشكل متقطع",
 "intermixture": "خلط, خليط (عملية خلط الأشياء معاً) / خليط مضاف, مزيج (عنصر إضافي يضاف عن طريق الخلط مع القاعدة) / خليط, مزيج (أي مادة غذائية تصنع بجمع مكونات مختلفة)\nمثال: عجينة مصنوعة من خليط الدقيق والماء",
 "intermolecular": "بين الجزيئات, بين جزيئي (موجود أو يعمل بين الجزيئات)\nمثال: قوى بين الجزيئية",
 "intermural": "بَيْنَ مُؤَسَّسِيّ (يجري بين مؤسستين أو أكثر)",
 "intern": "مُتَدَرِّب",
 "internal": "داخلي (يحدث أو ينشأ أو يقع ضمن بعض الحدود أو خاصة السطح) / بَاطِنِيّ, دَاخِلِيّ (يقع في الداخل ويتعلق بالعالم النفسي والعقلي) / دَاخِلِيّ, وَطَنِيّ (دَاخِلَ حُدُودِ البَلَدِ) / دَاخِلِيّ (يحدث داخل مؤسسة أو مجتمع واحد)\nمثال: أعضاء داخلية",
 "internal analysis": "تحليل داخلي (مراجعة لنقاط القوة والضعف في المنظمة والتي تركز على تلك العوامل داخل نطاقها)\nمثال: يجب أن يتضمن التحليل الداخلي لمنظمتك ثقافتها وخبرتها ومواردها",
 "internal angle": "زاوية داخلية (الزاوية داخل ضلعين متجاورين لمضلع)",
 "internal auditor": "مدقق داخلي (مدقق يعمل موظفاً في الشركة التي يتم تدقيق سجلاتها ويقدم المعلومات للإدارة ومجلس الإدارة)",
 "internal auditory artery": "شريان الأذن الداخلية, شريان تيهي (شريان هو فرع من الشريان القاعدي يغذي التيه (الأذن الداخلية))",
 "internal auditory vein": "وريد تيهي (أوردة تصرف الأذن الداخلية)",
 "internal carotid artery": "شريان سباتي باطن (فرع الشريان السباتي الذي يغذي الدماغ والعينين والأجزاء الداخلية من الرأس بالدم)",
 "internal cerebral vein": "وريد مخي باطن (وريدان مزدوجان يمران ذيلياً بالقرب من الخط الناصف ويتحدان لتشكيل الوريد المخي الكبير)",
 "internal combustion": "احتراق داخلي (احتراق الوقود داخل أسطوانة (كما في محرك الاحتراق الداخلي))",
 "internal combustion engine": "مُحَرِّك اِحْتِرَاق دَاخِلِيّ (اسم فاعل من حَرَّكَ؛ اسم آلة)\nمثال: المحرك لا يعمل.",
 "internal control": "رقابة داخلية (إجراء أو نظام محاسبي مصمم لتعزيز الكفاءة أو ضمان تنفيذ سياسة أو حماية الأصول)",
 "internal drive": "محرك أقراص داخلي (محرك مثبت داخل الحاسوب)",
 "internal ear": "أذن داخلية, تيه (نظام معقد من التجاويف المترابطة؛ معني بالسمع والتوازن)",
 "internal failure cost": "تكلفة الفشل الداخلي (التكاليف التي تنشأ عن العيوب التي يتم اكتشافها داخلياً والتعامل معها عن طريق التخلص من العناصر المعيبة أو إصلاحها)",
 "internal iliac artery": "شريان حرقفي باطن, شريان خثلي (الفرع الداخلي للشريان الحرقفي المشترك على جانبي الجسم؛ ينقسم إلى عدة فروع تغذي مناطق الحوض والأرداف بالدم)",
 "internal iliac vein": "وريد حرقفي باطن (وريد يتحد مع الوريد الحرقفي الظاهر لتكوين الوريد الحرقفي المشترك)",
 "internal jugular vein": "وريد وداجي باطن (استمرار للجيب السيني للأم الجافية؛ ينضم إلى الوريد تحت الترقوة لتكوين الوريد العضدي الرأسي)",
 "internal maxillary artery": "شريان فكي باطن (الشريان الفكي الذي يغذي التراكيب العميقة للوجه وبعض السحايا)",
 "internal medicine": "طب باطني, طب عام (فرع الطب الذي يتعامل مع تشخيص وعلاج (غير جراحي) لأمراض الأعضاء الداخلية (خاصة عند البالغين))",
 "internal nostril": "منخر خلفي (أي من الفتحتين الخلفيتين في مؤخرة التجويف الأنفي المؤديتين إلى البلعوم الأنفي)",
 "internal organ": "حشا, عضو داخلي (عضو رئيسي يقع داخل الجسم)",
 "internal representation": "تصور داخلي, تمثيل (عرض للأمور في العقل على شكل فكرة أو صورة)",
 "internal respiration": "تنفس خلوي, تنفس داخلي (العمليات الأيضية التي تحصل بها بعض الكائنات الحية على الطاقة من الجزيئات العضوية؛ العمليات التي تحدث في الخلايا والأنسجة والتي يتم خلالها إطلاق…)",
 "internal revenue": "إيرادات داخلية (الإيرادات الحكومية من المصادر المحلية (باستثناء الجمارك))",
 "internal revenue agent": "جابي الضرائب, محصل ضرائب (شخص يجمع الضرائب للحكومة)",
 "internal revenue service": "مصلحة الضرائب (مكتب تابع لوزارة الخزانة مسؤول عن تحصيل الضرائب)",
 "internal rhyme": "قافية داخلية (قافية بين الكلمات في نفس السطر)",
 "internal secretion": "هرمون (إفراز غدة صماء ينتقل عن طريق الدم إلى الأنسجة التي يكون له عليها تأثير محدد)",
 "internal spermatic artery": "شريان خصوي (فرع من الأبهر يغذي الخصيتين)",
 "internal-combustion engine": "محرك احتراق داخلي (محرك حراري يحدث فيه الاحتراق داخل المحرك بدلاً من فرن منفصل؛ الحرارة تمدد الغاز الذي يحرك مكبساً أو يدير توربيناً غازياً)",
 "internalisation": "استدماج, تذويت (التعلم (للقيم أو المواقف وما إلى ذلك) الذي يتم دمجها داخل الذات)",
 "internality": "باطنية, تعمق داخلي (الانشغال بما يهم الطبيعة الداخلية للإنسان (خاصة القيم الأخلاقية أو الأيديولوجية))\nمثال: باطنية سقراط ونزاهته وفضوله",
 "internalization": "استدماج, تذويت (التعلم (للقيم أو المواقف وما إلى ذلك) الذي يتم دمجها داخل الذات)",
 "internally": "دَاخِلِيًّا (في أو من الداخل)\nمثال: بيئة محكومة داخلياً",
 "internasal suture": "درز بين الأنفيين (الدرز بين عظمي الأنف)",
 "international": "دُوَلِيّ / الدولية",
 "international affairs": "شؤون دولية, شؤون عالمية (الشؤون بين الأمم)\nمثال: لا يمكنك حقاً مواكبة الشؤون العالمية من خلال مشاهدة التلفزيون",
 "international airport": "مَطَار دُوَلِيّ (المَطارُ : اسمُ مكانٍ من طَارَ؛ المَطارُ :وهو مكان مُعَدُّ بالوسائل الفنِّيَّة لصعود الطائرات وهبوطها أي مركز طيران جوي، أو ميناء جوي)\nمثال: وصلت إلى المطار.",
 "international ampere": "أمبير دولي (وحدة سابقة للتيار الكهربائي (أصغر قليلاً من الأمبير في النظام الدولي))",
 "international association of lions clubs": "نادي الليونز (نادي مكرس لتعزيز المواطنة المسؤولة والحكم الرشيد والرفاهية المجتمعية والوطنية والدولية)",
 "international atomic energy agency": "الوكالة الدولية للطاقة الذرية (وكالة الأمم المتحدة المعنية بالطاقة الذرية)",
 "international auxiliary language": "لغة مساعدة دولية (هِيَ مجموعة من الأصوات التي يصدرها الإنسان على شكل كلمات منظمة بقواعد، ليتواصل به الناس وينقلون به الافكار والمعاني، اللسان؛ يقصد بها أحيانا اللهجة)\nمثال: الأمازيغية لغة.",
 "international bank for reconstruction and development": "البنك الدولي, البنك الدولي للإنشاء والتعمير (وكالة تابعة للأمم المتحدة أنشئت لمساعدة الدول النامية بقروض تضمنها الحكومات الأعضاء)",
 "international candle": "شمعة دولية (وحدة دولية سابقة لشدة الإضاءة؛ استبدلت الآن بالكانديلا)",
 "international civil aviation organization": "إيكاو, منظمة الطيران المدني الدولي (وكالة الأمم المتحدة المعنية بالطيران المدني)",
 "international community": "المُجْتَمَع الدُّوَلِيّ",
 "international court of justice": "مَحْكَمَة الْعَدْلَ الدُّوَلِيَّةِ (مقام الحاكم. وغلبت على مقام الحاكم الشرعي أي القاضي)\nمثال: عاد إلى المحكمة.",
 "international criminal court": "محكمة الجنائية الدولية (مقام الحاكم. وغلبت على مقام الحاكم الشرعي أي القاضي)\nمثال: عاد إلى المحكمة.",
 "international development association": "المؤسسة الدولية للتنمية (وكالة تابعة للأمم المتحدة تابعة للبنك الدولي)",
 "international finance corporation": "مؤسسة التمويل الدولية (وكالة تابعة للأمم المتحدة تستثمر مباشرة في الشركات وتضمن القروض للمستثمرين من القطاع الخاص؛ تابعة للبنك الدولي)",
 "international flight": "رحلة دولية (رحلة تقلع من بلد وتهبط في آخر)",
 "international grandmaster": "أستاذ دولي كبير (لاعب شطرنج حصل على أعلى لقب من منظمة شطرنج دولية)",
 "international intelligence agency": "وكالة استخبارات أجنبية (وكالة استخبارات خارج الولايات المتحدة)",
 "international labor organization": "منظمة العمل الدولية (وكالة الأمم المتحدة المعنية بمصالح العمل والعمال)",
 "international labour organization": "منظمة العمل الدولية (وكالة الأمم المتحدة المعنية بمصالح العمل والعمال)",
 "international law": "قَانُون دُوَلِيّ (مقياس كل شيء وطريقه؛ أمر كليّ ينطبق على جميع جزئياته التي تعرف أحكامها منه)\nمثال: ذكرني بالقانون.",
 "international law enforcement agency": "وكالة إنفاذ قانون دولية (وحدة إدارية دولية مسؤولة عن إنفاذ القانون)",
 "international logistic support": "دعم لوجستي دولي, عون متبادل (ترتيبات بين الدول لمساعدة بعضها البعض)",
 "international maritime organization": "المنظمة البحرية الدولية (وكالة الأمم المتحدة المعنية بالأنشطة البحرية الدولية)",
 "international mile": "ميل (وحدة للطول تساوي 1,760 ياردة أو 5,280 قدماً؛ تساوي بالضبط 1609.344 متراً)",
 "international monetary fund": "صُنْدُوق اَلنَّقْد اَلدُّوَلِيّ (وعاء كبيرة من الخشب غالبا وقد يكون حديدًا يستخدم لوضع الاشياء داخله، ويكون لها عادة جهة قابلة للفتح سواء بمفاصل او بالازالة الكاملة؛ صُنْدُوْقُ السَيَّارَة قمرة تشبه الصندوق في الجزء الخلفي من السيارة يستخدم كالصندوق)\nمثال: أين صندوق البريد؟",
 "international morse code": "شيفرة مورس (شيفرة تلغراف تُمثَّل فيها الحروف والأرقام بسلاسل من النقاط والشرطات (إشارات قصيرة وطويلة))",
 "international nautical mile": "ميل بحري (وحدة للطول تستخدم في الملاحة؛ تساوي بالضبط 1,852 متراً)",
 "international olympic committee": "اللجنة الأولمبية الدولية (المنظمة المسؤولة عن تنظيم الألعاب الأولمبية الحديثة)",
