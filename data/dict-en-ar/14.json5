 "imitation": "تَقْلِيد",
 "imitation leather": "جلد صناعي (قماش مصنوع ليبدو مثل الجلد)",
 "imitative": "مزيف, مقلد (غير حقيقي؛ يقلد شيئاً متفوقاً) / تقليدي, محاكٍ (يتميز بـأو يميل إلى التقليد) / صوتي, محاكٍ للصوت ((للكلمات) مشكلة تقليداً لصوت طبيعي)\nمثال: عاطفة مزيفة",
 "imitative electronic deception": "خداع إلكتروني تقليدي (إدخال طاقة كهرومغناطيسية في أنظمة العدو تحاكي انبعاثات العدو)",
 "imitativeness": "تَقْلِيد, مُحَاكَاة (حالة التقليد أو النسخ أو عدم الأصالة)",
 "imitator": "مُحَاكٍ, مُقَلِّد (شخص ينسخ كلمات أو سلوك شخص آخر) / منتحل شخصية (شخص ينتحل (عن طريق الاحتيال) مظهر شخص آخر)",
 "immaculacy": "خلو من العيب, طهارة (سمة عدم وجود وصمة أو شائبة؛ كونه نظيفاً، غير مدنس، صافياً، نقياً)\nمثال: للأسف لم يحافظ على نقائه بل استسلم لشهواته",
 "immaculate": "مُنَزَّه",
 "immaculate conception": "الحَمْل بِلَا دَنَس",
 "immaculate conception of the virgin mary": "الحبل بلا دنس ((المسيحية) العقيدة الكاثوليكية الرومانية بأن الله حفظ العذراء مريم من أي وصمة للخطيئة الأصلية منذ لحظة حملها)",
 "immaculately": "بأناقة مثالية, بشكل لا تشوبه شائبة (بطريقة نظيفة ومرتبة للغاية)\nمثال: ذهب الكندي ذو الملابس غير الرسمية الذي اعتقدت أنه قروي - كان هذا الرجل يرتدي ملابس مفصلة بأناقة مثالية",
 "immaculateness": "طهارة, نظافة تامة (حالة النظافة التامة (بلا بقع))",
 "immanence": "كمون, محايثة (حالة الوجود داخل نطاق معين أو عدم تجاوزه)",
 "immanency": "كمون, محايثة (حالة الوجود داخل نطاق معين أو عدم تجاوزه)",
 "immanent": "كَامِن, مُتَأَصِّل (يصف صفات منتشرة في شيء ما بأكمله) / ذاتي, كامِن (لفعل عقلي يتم تنفيذه بالكامل داخل العقل)\nمثال: الإدراك هو فعل كامن للعقل",
 "immanuel": "عَمَّانُوئِيل",
 "immaterial": "روحي, غير مادي (لا يتكون من مادة) / روحي, غير جسدي (بدون شكل مادي أو مادة) / سِيَّان, لَا يَهُمّ ((غالبًا متبوع بـ 'لـ') لا أهمّيّة له؛ لا فرق بين خياراته) / غير جوهري (لا أهمية أو صلة له خاصة بقضية قانونية)\nمثال: أطياف غير مادية",
 "immateriality": "رُوحَانِيَّة, لَا مَادِّيَّة (صفة عدم كون الشيء مادياً؛ عدم التكون من مادة) / تَفَاهَة, لَا مَادِّيَّة (عدم الصلة التام الذي لا يتطلب مزيدًا من النظر)",
 "immature": "غير مكسو بالريش, غير ناضج ((عن الطيور) لم تطور ريشاً بعد) / غير ناضج (لم ينضج بعد) / طفولي, غير ناضج (من سمات الافتقار إلى النضج) / غير ناضج, فج (غير مكتمل النمو أو النضج؛ غير يانع)\nمثال: عصفور صغير غير مكسو بالريش على حافة النافذة",
 "immaturely": "بصبيانية, بعدم نضج (بطريقة غير ناضجة)\nمثال: لا يزال ابنه المراهق يتصرف بصبيانية شديدة",
 "immatureness": "عدم نضج (عدم الوصول إلى النضج)",
 "immaturity": "عدم نضج (عدم الوصول إلى النضج)",
 "immeasurability": "تعذر القياس, لا قياسية (صفة كون الشيء غير قابل للقياس)\nمثال: تدهشنا لا محدودية قدرات الدماغ",
 "immeasurable": "لَا يُقَاسُ (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: لا أحب المدرسة.",
 "immeasurably": "بِشَكْل لَا نِهَائِيّ, بِشَكْل لَا يُقَاس (بدون قيود أو حدود) / إلى حد بعيد, بشكل لا يقاس (لدرجة لا يمكن قياسها؛ بما يتجاوز القياس)\nمثال: إنه ثري بلا حدود",
 "immediacy": "فورية, مباشرة (عدم وجود وسيط أو وكالة متداخلة) / آنية, فورية (سرعة الفعل أو الحدوث) / إدراك فوري, بداهة (وعي حدسي فوري)\nمثال: فورية التغطية التلفزيونية",
 "immediate": "فَوْرِيّ",
 "immediate allergy": "تأتب, حساسية فورية (رد فعل تحسسي يظهر بوضوح لدى الشخص المتحسس بعد دقائق فقط من الاتصال)",
 "immediate apprehension": "إدراك فوري, بداهة (وعي حدسي فوري)",
 "immediate constituent": "مكون مباشر (مكون للجملة في الخطوة الأولى من التحليل: على سبيل المثال، الفاعل والمسند)",
 "immediate memory": "ذاكرة فورية, ذاكرة قصيرة المدى (ما يمكنك تكراره فوراً بعد إدراكه)",
 "immediate payment": "دفع فوري, دفع نقدي (دفع فوري للسلع أو الخدمات بالعملة أو بشيك)",
 "immediately": "فَوْرًا, حَالًا",
 "immediateness": "فورية, مباشرة (عدم وجود وسيط أو وكالة متداخلة) / آنية, فورية (سرعة الفعل أو الحدوث)\nمثال: فورية التغطية التلفزيونية",
 "immense": "عِمْلاق",
 "immensely": "إلى حد كبير, بشكل هائل (إلى مدى أو درجة كبيرة جداً)\nمثال: لقد بالغ في تقدير موارده بشكل هائل",
 "immenseness": "شساعة, ضخامة (كبر غير عادي في الحجم أو المدى أو العدد)",
 "immensity": "شساعة, ضخامة (كبر غير عادي في الحجم أو المدى أو العدد)",
 "immensurable": "لا يحصى, لا يُقاس (يستحيل قياسه)\nمثال: أبعاد لا تُقاس للفضاء الخارجي",
 "immersion": "تغطيس, غمر (فعل تبليل شيء بغمره) / تغطيس (شكل من أشكال المعمودية يغمر فيه جزء أو كل جسم الشخص) / استغراق, انهماك (انتباه كامل؛ جهد عقلي مكثف) / احتجاب, دخول ((في علم الفلك) اختفاء جرم سماوي قبل الكسوف)",
 "immersion foot": "قدم الخندق (حالة تشبه قضمة الصقيع ولكن دون تجمد؛ ناتجة عن التعرض للبرد والرطوبة)",
 "immersion heater": "سخان غاطس (عنصر تسخين يغمر في السائل المراد تسخينه (كما في خزان الماء الساخن))",
 "immigrant": "مُهَاجِر, مُهَاجِرَة",
 "immigrant class": "طبقة المهاجرين (المهاجرون الجدد الذين يتم تجميعهم كطبقة بسبب وضعهم الاجتماعي والاقتصادي المنخفض على الرغم من خلفياتهم الثقافية المختلفة)",
 "immigrate": "هَاجَرَ",
 "immigration": "هِجْرَة, مُهَاجَرَة (ترك الأرض والخروج منها إلى أخرى؛ في الشرع: ترك الوطن الذي بين الكفار والانتقال إلى دار الإسلام قربة لله)\nمثال: الهجرة النبوية.",
 "immigration and naturalization service": "دائرة الهجرة والتجنيس (وكالة سابقة في وزارة العدل تطبق القوانين واللوائح الخاصة بقبول الأشخاص المولودين في الخارج في الولايات المتحدة)",
 "imminence": "دنو, وشوك (حالة كونه وشيكاً وعرضة للحدوث قريباً)",
 "imminency": "دنو, وشوك (حالة كونه وشيكاً وعرضة للحدوث قريباً)",
 "imminent": "وَشِيك",
 "imminent abortion": "إجهاض منذر, تهديد بالإجهاض (ظهور أعراض تشير إلى فقدان وشيك لنتاج الحمل)",
 "imminently": "عما قريب, وشيكاً (بطريقة وشيكة)",
 "imminentness": "دنو, وشوك (حالة كونه وشيكاً وعرضة للحدوث قريباً)",
 "immiscible": "غير قابل للامتزاج, غير مزوج ((في الكيمياء والفيزياء) غير قابل للخلط)",
 "immobile": "جَامِد, رَاسِخ (مُثَبَّت بِإِحْكَام فِي مَكَانِه) / ثابت, ساكن (غير قادر على الحركة أو غير قابل للنقل)",
 "immobilisation": "تعطيل, شل الحركة (فعل الحد من الحركة أو جعل الشيء غير قادر على الحركة) / تثبيت, شل حركة (تثبيت جزء من الجسم (كما هو الحال بجبيرة الجبس) لتعزيز الشفاء السليم)\nمثال: تسببت العاصفة في شلل تام لفريق الإنقاذ",
 "immobility": "جُمُود, سُكُون (صفة عدم التحرك) / استقرار, ثبات (البقاء في المكان)",
 "immobilization": "تعطيل, شل الحركة (فعل الحد من الحركة أو جعل الشيء غير قادر على الحركة) / تثبيت, شل حركة (تثبيت جزء من الجسم (كما هو الحال بجبيرة الجبس) لتعزيز الشفاء السليم)\nمثال: تسببت العاصفة في شلل تام لفريق الإنقاذ",
 "immobilizing": "تعطيل, شل الحركة (فعل الحد من الحركة أو جعل الشيء غير قادر على الحركة)\nمثال: تسببت العاصفة في شلل تام لفريق الإنقاذ",
 "immoderate": "غير معتدل, فاحش (يتجاوز الحدود المعقولة)\nمثال: ضحك مفرط",
 "immoderately": "بشكل غير معقول, بشكل مفرط (لدرجة تتجاوز حدود العقل أو الاعتدال) / بإفراط, بلا اعتدال (بدون اعتدال)\nمثال: أسعاره مرتفعة بشكل غير معقول",
 "immoderateness": "إفراط, عدم اعتدال (جودة كون الشيء مفرطاً ومفتقراً للاعتدال)",
 "immoderation": "إفراط, عدم اعتدال (جودة كون الشيء مفرطاً ومفتقراً للاعتدال)",
 "immodest": "سافر, غير محتشم (يفتقر إلى اللياقة أو الحشمة) / متغطرس, مغرور (لديه أو يظهر رأياً مبالغاً فيه عن أهميته أو قدراته)\nمثال: تفاخر وقح ومغرور",
 "immodestly": "بِتَبَجُّح, دُونَ تَوَاضُع (بدون تواضع؛ بطريقة غير متواضعة)\nمثال: كان عنوان الكتاب بتبجح 'كل شيء عن الحكمة'",
 "immodesty": "استعراضية (الفعل المنحرف المتمثل في كشف الأعضاء التناسلية وجذب الانتباه إليها) / تبجح, وقاحة (سمة كون المرء مغروراً ومتعجرفاً)",
 "immolate": "ذَبَحَ (قتل بآلة حادة كالسيف أو السكين بقطع الوريد أو الشريان في الرقبة؛ عن القتل بدون مقاومة المقتول)\nمثال: وعندما يتم ذبح الأبرياء في دارفور والبوسنة يسبب ذلك وصمة في ضميرنا المشترك.",
 "immolation": "إحراق كقربان, تقديم كقربان (القتل أو التقديم كأضحية)",
 "immoral": "فاسد, لا أخلاقي (ينتهك عمداً المبادئ المقبولة للصواب والخطأ) / فَاسِد, لَا أَخْلَاقِيّ (لا يلتزم بالمبادئ الأخلاقية أو القِيَمية)",
 "immorality": "شر, فجور (سلوك مرفوض أخلاقياً) / انحلال أخلاقي, فجور (صفة عدم التوافق مع معايير السلوك القويم أو الجيد)\nمثال: لا أخلاقية تأسيس دفاع الغرب على التهديد بالدمار المتبادل المؤكد",
 "immorally": "بشكل غير أخلاقي, بفجور (دون مراعاة للأخلاق)\nمثال: تصرف بشكل غير أخلاقي عندما كانت مصالحه الخاصة على المحك",
 "immortal": "خَالِد (الخلود)\nمثال: خالد هو مواطن كويتي.",
 "immortality": "خُلُود",
 "immortelle": "زهرة الخلود, زيرنثيموم (أكثر أنواع الزهور الخالدة زراعة على نطاق واسع ولها زهور أرجوانية عادة؛ جنوب أوروبا إلى إيران؛ متوطنة في أماكن أخرى)",
 "immotile": "عَدِيمُ الحَرَكَة ((لِلأَبْوَاغِ أَوِ الكَائِنَاتِ الدَّقِيقَة) غَيْرُ قَادِرٍ عَلَى الحَرَكَة)",
 "immotility": "انْعِدَام الحَرَكَة الذَّاتِيَّة (الافتقار إلى القدرة على التحرك)",
 "immovability": "ثَبَات, رُسُوخ (عدم القابلية للتحريك أو إعادة الترتيب)",
 "immovable": "رَاسِخ, غَيْرُ قَابِلٍ لِلتَّحْرِيك (لَا يُمْكِنُ تَحْرِيكُهُ أَوْ لَا يُقْصَدُ بِهِ أَنْ يُنْقَل) / أملاك عقارية, عقار (ممتلكات تتكون من منازل وأراضٍ)",
 "immovable bandage": "ضمادة صلبة (ضمادة من القماش المشبع بمادة (كالجبس) تتصلب بعد وقت قصير من وضعها)",
 "immovableness": "ثَبَات, رُسُوخ (عدم القابلية للتحريك أو إعادة الترتيب)",
 "immovably": "بثبات, دون حراك (بحيث لا يمكن التحرك)\nمثال: جثمت الجبال بثبات فوق النهر",
 "immoveable": "رَاسِخ, غَيْرُ قَابِلٍ لِلتَّحْرِيك (لَا يُمْكِنُ تَحْرِيكُهُ أَوْ لَا يُقْصَدُ بِهِ أَنْ يُنْقَل)",
 "immune": "مَنِيع",
 "immune carrier": "حامل المرض, ناقل العدوى ((طب) شخص (أو حيوان) يحمل مسببات مرضية لديه مناعة ضدها ولكنه يمكن أن ينقلها للآخرين)",
 "immune gamma globulin": "غلوبولين مناعي (فئة من البروتينات تُنتج في الأنسجة الليمفاوية في الفقاريات وتعمل كأجسام مضادة في الاستجابة المناعية)",
 "immune globulin": "غلوبولين مناعي (فئة من البروتينات تُنتج في الأنسجة الليمفاوية في الفقاريات وتعمل كأجسام مضادة في الاستجابة المناعية)",
 "immune reaction": "استجابة مناعية, رد فعل مناعي (رد فعل دفاعي جسدي يتعرف على مادة غازية (مولد ضد: مثل فيروس أو فطر أو بكتيريا أو عضو مزروع) وينتج أجسامًا مضادة محددة ضد ذلك المولد)",
 "immune response": "استجابة مناعية, رد فعل مناعي (رد فعل دفاعي جسدي يتعرف على مادة غازية (مولد ضد: مثل فيروس أو فطر أو بكتيريا أو عضو مزروع) وينتج أجسامًا مضادة محددة ضد ذلك المولد)",
 "immune serum globulin": "غلوبولين مناعي (فئة من البروتينات تُنتج في الأنسجة الليمفاوية في الفقاريات وتعمل كأجسام مضادة في الاستجابة المناعية)",
 "immune suppressant drug": "دواء مثبط للمناعة, مثبط للمناعة (دواء يقلل من الاستجابة المناعية الطبيعية للجسم)",
 "immune system": "جِهَاز المَنَاعَة, الْجِهَاز المَنَاعِيّ",
 "immunisation": "تحصين, تمنيع (فعل منح المناعة (خاصة عن طريق التلقيح))",
 "immunised": "مُحَصَّن, مُلَقَّح (جُعل غير قابل للإصابة بمرض عن طريق التطعيم)",
 "immunity": "حَصَانَة, مَنَاعَة",
 "immunization": "تمنيع",
 "immunized": "مُحَصَّن, مُلَقَّح (جُعل غير قابل للإصابة بمرض عن طريق التطعيم)",
 "immunizing agent": "عامل تحصين, مولد المناعة (أي مادة أو كائن حي يثير استجابة مناعية (ينتج مناعة) عند إدخاله في الجسم)",
 "immunoassay": "مقايسة مناعية (تحديد مادة (خاصة بروتين) عن طريق عملها كمستضد)",
 "immunochemical": "كيميائي مناعي (مكون من أو متعلق بالكيمياء المناعية)",
 "immunochemical assay": "مقايسة مناعية (تحديد مادة (خاصة بروتين) عن طريق عملها كمستضد)",
 "immunochemistry": "كيمياء مناعية (مجال الكيمياء المعني بالعمليات الكيميائية في علم المناعة (مثل الدراسات الكيميائية للمستضدات والأجسام المضادة))",
 "immunocompetence": "كفاءة مناعية (القدرة على تطوير استجابة مناعية بعد التعرض لمستضد)",
 "immunocompetent": "كفؤ مناعياً, مؤهل مناعياً (قادر على تطوير استجابة مناعية بعد التعرض لمستضد)\nمثال: خلايا مؤهلة مناعياً",
 "immunocompromised": "منقوص المناعة (غير قادر على تطوير استجابة مناعية طبيعية عادة بسبب سوء التغذية أو نقص المناعة أو العلاج المثبط للمناعة)",
 "immunodeficiency": "عوز مناعي, نقص المناعة (اضطراب مناعي يكون فيه جزء من الجهاز المناعي للجسم غير كافٍ وتنخفض المقاومة للأمراض المعدية)",
 "immunodeficient": "ناقص المناعة (غير قادر على تطوير استجابة مناعية بعد التعرض لمستضد)\nمثال: قوارض ناقصة المناعة",
 "immunoelectrophoresis": "رحلان كهربائي مناعي (رحلان كهربائي لفصل المستضدات والأجسام المضادة)",
 "immunofluorescence": "تألق مناعي ((علم المناعة) تقنية تستخدم أجسامًا مضادة مرتبطة بصبغة فلورية لدراسة المستضدات في عينة من الأنسجة)",
 "immunogen": "عامل تحصين, مولد المناعة (أي مادة أو كائن حي يثير استجابة مناعية (ينتج مناعة) عند إدخاله في الجسم)",
 "immunogenic": "مُوَلِّد لِلْمَنَاعَة (يمتلك القدرة على إثارة استجابة مناعية)",
 "immunogenicity": "استمناع, مولدية للمناعة (خاصية إثارة استجابة مناعية)",
 "immunoglobulin": "غلوبولين مناعي (فئة من البروتينات تُنتج في الأنسجة الليمفاوية في الفقاريات وتعمل كأجسام مضادة في الاستجابة المناعية)",
 "immunoglobulin a": "الغلوبولين المناعي أ (واحدة من أكثر الفئات الخمس الرئيسية للغلوبولين المناعي شيوعاً؛ الجسم المضاد الرئيسي في أغشية الجهاز الهضمي والجهاز التنفسي)",
 "immunoglobulin d": "الغلوبولين المناعي د (واحدة من الفئات الخمس الرئيسية للغلوبولين المناعي؛ توجد في مصل الدم بكميات صغيرة)",
 "immunoglobulin e": "الغلوبولين المناعي هـ (واحدة من الفئات الخمس الرئيسية للغلوبولين المناعي؛ توجد بشكل أساسي في الجلد والأغشية المخاطية)",
 "immunoglobulin g": "الغلوبولين المناعي ج (واحدة من الفئات الخمس الرئيسية للغلوبولين المناعي؛ الدفاع الرئيسي بالأجسام المضادة ضد البكتيريا)",
 "immunoglobulin m": "الغلوبولين المناعي م (واحدة من الفئات الخمس الرئيسية للغلوبولين المناعي؛ تشارك في محاربة التهابات الدم وفي تحفيز إنتاج الغلوبولين المناعي ج)",
 "immunohistochemistry": "كيمياء نسيجية مناعية (مقايسة تظهر مستضدات محددة في الأنسجة باستخدام علامات تكون إما أصباغ فلورية أو إنزيمات)",
 "immunologic": "علم مناعي, مناعي (مكون من أو متعلق بعلم المناعة)",
 "immunologic response": "استجابة مناعية, رد فعل مناعي (رد فعل دفاعي جسدي يتعرف على مادة غازية (مولد ضد: مثل فيروس أو فطر أو بكتيريا أو عضو مزروع) وينتج أجسامًا مضادة محددة ضد ذلك المولد)",
 "immunological": "علم مناعي, مناعي (مكون من أو متعلق بعلم المناعة)",
 "immunological disorder": "اضطراب مناعي (اضطراب في الجهاز المناعي)",
 "immunologically": "مناعياً (من وجهة نظر علم المناعة)",
 "immunologist": "عالم مناعة (عالم طبي يتخصص في علم المناعة)",
