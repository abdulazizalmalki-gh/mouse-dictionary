 "international organization": "منظمة دولية",
 "international phonetic alphabet": "اَلْأَبْجَدِيَّة الصَّوْتِيَّة الدُّوَلِيَّة, الْأَلِفْبَائِيَّة الصَّوْتِيَّة الدُّوَلِيَّة",
 "international pitch": "دوزان الحفلات, طبقة الحفلات",
 "international relations": "عَلَاقَات دَوْلِيَّة",
 "international relations and security network": "شبكة العلاقات الدولية والأمن (شبكة المعلومات السويسرية للدراسات الأمنية والدفاعية وأبحاث السلام والصراع والعلاقات الدولية)",
 "international scale": "المقياس المئوي, مقياس سيلسيوس (مقياس درجة حرارة يحدد نقطة تجمد الماء عند 0 درجة ونقطة غليان الماء عند 100 درجة)",
 "international sea and swell scale": "مقياس دوغلاس (مقياس يستخدم لقياس ارتفاع الأمواج)",
 "international society for krishna consciousness": "الجمعية الدولية لوعي كريشنا, هاري كريشنا (طائفة دينية تأسست في الولايات المتحدة عام 1966؛ تستند إلى الكتب الفيدية؛ تنخرط المجموعات في ترديد بهيج لـ \"هاري كريشنا\" ومانترا أخرى تستند إلى اسم…)",
 "international space station": "مَحَطَّةُ الفَضَاءِ الدُّوَلِيَّة",
 "international system": "النظام الدولي للوحدات (نظام متري كامل لوحدات القياس للعلماء؛ الكميات الأساسية هي الطول (متر) والكتلة (كيلوجرام) والوقت (ثانية) والتيار الكهربائي (أمبير) ودرجة الحرارة…)\nمثال: اليوم الولايات المتحدة هي الدولة الوحيدة في العالم غير الملتزمة كلياً بالنظام الدولي للوحدات",
 "international system of units": "النظام الدولي للوحدات (نظام متري كامل لوحدات القياس للعلماء؛ الكميات الأساسية هي الطول (متر) والكتلة (كيلوجرام) والوقت (ثانية) والتيار الكهربائي (أمبير) ودرجة الحرارة…)\nمثال: اليوم الولايات المتحدة هي الدولة الوحيدة في العالم غير الملتزمة كلياً بالنظام الدولي للوحدات",
 "international terrorism": "إرهاب دولي (إرهاب يمارس في بلد أجنبي من قبل إرهابيين ليسوا من مواطني ذلك البلد)",
 "international wanted notice": "نشرة حمراء, نشرة دولية للمطلوبين (نشرة من الإنتربول تصف شخصاً مطلوباً وتطلب اعتقاله بهدف تسليمه؛ إشعار مطلوبين يصدره الإنتربول بناءً على طلب دولة عضو ويوزع على جميع الدول الأعضاء)\nمثال: تعد النشرة الحمراء للإنتربول أقرب أداة لأمر اعتقال دولي مستخدم اليوم",
 "international waters": "أعالي البحار, مياه دولية (البحار المفتوحة في العالم خارج المياه الإقليمية لأي دولة)",
 "internationale": "نَشِيد الْأُمَمِيَّة",
 "internationalisation": "تَدْوِيل (فعل وضع شيء ما تحت السيطرة الدولية)",
 "internationalism": "أُمَمِيَّة",
 "internationalist": "أُمَمِيّ (متأثر بالأممية أو يدعو إليها) / أممي (عضو في أممية اشتراكية أو شيوعية) / دولي (مدافع عن التدويل (التعاون الدولي))",
 "internationalistic": "أُمَمِيّ (متأثر بالأممية أو يدعو إليها)",
 "internationality": "دولية, عالمية (صفة كون الشيء دولياً في نطاقه)\nمثال: أشاد بعالمية المصطلحات العلمية",
 "internationalization": "تَدْوِيل",
 "internationalize": "دَوَّلَ ((دَوَّلَ) دالًا: كتبها. و(تدويلُ المدينة): جعل الأمر فيها لدول مختلفة)\nمثال: لبنان دولة صغيرة.",
 "internationally": "دَوْلِيًّا, دُوَلِيًّا",
 "interne": "طبيب امتياز (طالب متقدم أو خريج طب يكتسب خبرة عملية تحت الإشراف)",
 "internecine": "تَنَاحُرِيّ (يتسم بسفك الدماء والخسائر لكلا الطرفين) / دَاخِلِيّ تَدْمِيرِيّ ((عن الصراع) داخل مجموعة أو منظمة واحدة)",
 "internee": "مُحْتَجَز, مُعْتَقَل (شخص يتم احتجازه (غالباً لأسباب سياسية أو عسكرية))\nمثال: كان المحتجزون أجانب أعداء وإرهابيين مشتبه بهم",
 "internet": "إِنْتَرْنَت, شُبَّاكَة (شبكة المعلومات العالمية)\nمثال: كان ياني على الإنترنت.",
 "internet cafe": "مَقْهَى إِنْتَرْنِت (مكان عام تُقدَّم فيه المشروبات كالقهوة والشاي، وأحياناً الأطعمة الخفيفة؛ مكانٌ عامٌّ تقدم فيه القهوةُ ونحُوها من الأَشربة)\nمثال: هذا المقهى مريح.",
 "internet of things": "إِنْتَرْنَت الْأَشْيَاء (شبكة المعلومات العالمية)\nمثال: كان ياني على الإنترنت.",
 "internet protocol": "بْرُوتُوكُول اَلْإِنْتِرْنِت",
 "internet site": "موقع إلكتروني, موقع ويب (حاسوب متصل بالإنترنت يحتفظ بسلسلة من صفحات الويب على الشبكة العنكبوتية العالمية)\nمثال: تضرر الموقع الإلكتروني الإسرائيلي من قبل قراصنة معادين",
