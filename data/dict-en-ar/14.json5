 "ill-judged": "طَائِش, غَيْرُ مَدْرُوس (لم يُعْطَ تفكيرًا كافيًا أو دراسة متأنّية)",
 "ill-mannered": "سَيِّئُ الأَدَبِ, وَقِح (غير صحيح السلوك اجتماعياً)",
 "ill-natured": "سيء الطباع, فظ (ذو طبع سريع الغضب وغير سار)",
 "ill-omened": "سَيِّئُ الطَّالِع, مَنْحُوس (يَتَّسِمُ بِسُوءِ الحَظِّ أَوْ يُنْذِرُ بِهِ)",
 "ill-proportioned": "غَيْر مُتَنَاسِب (يفتقر إلى نسب مُرضية وجميلة)",
 "ill-scented": "زَنِخ, مُنْتِن (ذُو رَائِحَةٍ كَرِيهَةٍ بِشَكْلٍ مُؤْذٍ)",
 "ill-shapen": "مَعِيب الشَّكْل, مُشَوَّه (سيّئ التكوين إلى حدّ القبح)",
 "ill-smelling": "كريه الرائحة, نتن (ذو رائحة غير محببة)",
 "ill-sorted": "غَيْرُ مُتَوَافِق, مُتَنَافِر (ليس من السهل الجمع بينها بانسجام)",
 "ill-starred": "سَيِّئُ الطَّالِع, مَنْحُوس (يَتَّسِمُ بِسُوءِ الحَظِّ أَوْ يُنْذِرُ بِهِ)",
 "ill-tempered": "عَبُوس, مُتَذَمِّر (مُنزعج وسريع الانفعال)",
 "ill-timed": "سَيِّئ التَّوْقِيت, فِي غَيْر أَوَانِه (ذو توقيت سيئ أو غير ملائم)",
 "ill-treated": "مُسَاء مُعَامَلَتُه, مُضْطَهَد (خاضع لمعاملة قاسية)\nمثال: زوجة معنفة",
 "ill-treatment": "إساءة, سوء المعاملة (معاملة قاسية أو غير إنسانية)\nمثال: أظهر الطفل علامات الإساءة الجسدية",
 "ill-usage": "إساءة, سوء المعاملة (معاملة قاسية أو غير إنسانية)\nمثال: أظهر الطفل علامات الإساءة الجسدية",
 "ill-used": "مَظْلُوم, مُسْتَغَلّ ((عن الأشخاص) تَمَّ اسْتِغْلَالُهُ)",
 "illation": "استدلال (التفكير المتضمن في استخلاص نتيجة أو إصدار حكم منطقي بناءً على أدلة ظرفية واستنتاجات سابقة بدلاً من الملاحظة المباشرة)",
 "illative": "اسْتِدْلَالِيّ (يُعبّر عن استنتاج أو يسبقه) / اسْتِنْتَاجِيّ (يُشبه الاستنتاج أو يعتمد عليه أو يُتوصّل إليه بالاستدلال) / استدلالي, استنتاجي (متعلق بـ أو له طبيعة الاستدلال أو الاستنتاج)\nمثال: الملكة الاستدلالية للعقل",
 "illative conjunction": "رَبْط اسْتِنْتَاجِيّ (رابط يعبر عن شيء مستنتج من عبارة أو حقيقة أخرى)",
 "illecebrum verticillatum": "عقد المرجان (نبات حولي أملس ذو جذر وتدي نحيل وعناقيد من الزهور البيضاء؛ غرب أوروبا خاصة مناطق غرب البحر الأبيض المتوسط والسواحل الأطلسية)",
 "illegal": "غَيْر قَانُونِيٍّ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "illegal possession": "حيازة غير قانونية (حيازة مواد خاضعة للرقابة)",
 "illegality": "لَا قَانُونِيَّة, مُخَالَفَة القَانُون (عدم المشروعية بحكم انتهاك قانون تشريعي ما)",
 "illegally": "بشكل غير قانوني, خلسة (بطريقة غير قانونية)\nمثال: تخلصوا من النفايات بشكل غير قانوني",
 "illegibility": "عَدَم مَقْرُوئِيَّة, عُسْر القِرَاءَة (صفة الكتابة (المطبوعة أو اليدوية) التي لا يمكن فك رموزها)",
 "illegible": "غير مقروء ((لخط اليد، الطباعة، إلخ) لا يمكن قراءته)\nمثال: خط يد غير مقروء",
 "illegibly": "بخط غير مقروء, بشكل مبهم (بطريقة غير مقروءة)\nمثال: هذا الطالب يكتب بخط غير مقروء",
 "illegitimacy": "عَدَم شَرْعِيَّة (عدم المشروعية بحكم عدم التفويض أو عدم التوافق مع القانون) / بنوة غير شرعية (حالة الولادة لأبوين غير متزوجين)",
 "illegitimate": "غَيْر مَشْرُوع, مُحَرَّم (مُخالِف لِلقانون؛ لا يُجيزُهُ القانون) / غير شرعي (للزواج والنسل؛ غير معترف به كقانوني) / ابن غير شرعي, نغل (النسل غير الشرعي لأبوين غير متزوجين)",
 "illegitimate child": "ابن غير شرعي, نغل (النسل غير الشرعي لأبوين غير متزوجين)",
 "illegitimate enterprise": "مخطط احتيالي, مشروع غير شرعي (مشروع غير قانوني (مثل الابتزاز أو الاحتيال أو تجارة المخدرات أو الدعارة) يتم تنفيذه من أجل الربح)",
 "illegitimately": "بشكل غير شرعي, سفاحاً (من أبوين بيولوجيين غير متزوجين من بعضهما البعض) / بشكل غير مشروع, بغير حق (بطريقة مستهجنة أو غير مسموح بها عرفاً)\nمثال: ولد هذا الطفل بشكل غير شرعي",
 "illiberal": "غَيْر مُتَسَامِح, مُتَعَصِّب (ضَيِّق التَّفْكِير بِشَأْن آرَائِه الرَّاسِخَة)",
 "illiberality": "بخل, تزمت (الميل لعدم الكرم (السخاء) بالمال)",
 "illiberally": "بتعصب, بضيق أفق (بطريقة ليست منفتحة التفكير)\nمثال: طريقة تفكيره المنحازة بضيق أفق",
 "illicit": "غَيْر مَشْرُوع, مُحَرَّم (مُخالِف لِلقانون؛ لا يُجيزُهُ القانون) / غير مشروع, محرم (مخالف للأخلاق المقبولة (خاصة الأخلاق الجنسية) أو العرف)\nمثال: علاقة غير مشروعة مع سكرتيرته",
 "illicitly": "بشكل غير قانوني, خلسة (بطريقة غير قانونية) / بشكل غير مشروع, بغير حق (بطريقة مستهجنة أو غير مسموح بها عرفاً)\nمثال: تخلصوا من النفايات بشكل غير قانوني",
 "illicitness": "تَحْرِيم, حَظْر (صفة عدم الامتثال الصارم للقانون)",
 "illicium anisatum": "أنيسون نجمي, يانسون نجمي ياباني (شجرة شجيرية صغيرة من اليابان وتايوان؛ أزهارها غير عطرة)",
 "illicium floridanum": "يانسون أرجواني (شجرة شجيرية صغيرة بزهور أرجوانية؛ توجد في التربة الرطبة في جنوب شرق الولايات المتحدة)",
 "illicium verum": "يانسون صيني, يانسون نجمي (شجرة صغيرة من الصين وفيتنام تحمل ثماراً على شكل نجمة برائحة اليانسون تستخدم في الطعام وطبياً كطارد للغازات)",
 "illimitable": "لَا حَدَّ لَه, لَا مَحْدُود (بلا حدود في المدى أو الحجم أو الكمية)",
 "illinois": "لغة إلينوي (لغة ألغونكوية خاصة بشعبي إلينوي وميامي) / إلينوي (فرد من شعب ألغونكي كان يعيش سابقاً في إلينوي والمناطق الغربية منها)",
