 "in the beginning": "أصلاً, في المقام الأول (قبل الآن) / أصلاً, في البداية (فيما يتعلق بالأصل أو البداية)\nمثال: لماذا لم تخبرني في المقام الأول؟",
 "in the blink of an eye": "أسرع من الطرف (أَسْرَعَ: ( فعل )؛ أَسْرَعُ)\nمثال: أسرع و إلا تأخرت.",
 "in the buff": "عَارٍ تَمَاماً ((غير رسمي) عارٍ تماماً بلا أي ملابس)",
 "in the end": "أخيراً, في الختام (كنتيجة نهائية لتتابع أو عملية) / في النهاية (في نهاية المطاف أو بعد فترة طويلة)\nمثال: في النهاية كان عليه الاستسلام",
 "in the first place": "أساساً, في المقام الأول (ذو أهمية أولية) / أصلاً, في المقام الأول (قبل الآن)\nمثال: هذه مسألة اقتصادية في المقام الأول",
 "in the future": "فِي ٱلْمُسْتَقْبَل (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "in the know": "عَلَى عِلْم (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال.",
 "in the lead": "في الصدارة, متقدماً (يتقدم أو يسبق في منافسة) / فِي المُقَدِّمَة, مُتَصَدِّر (يَحْتَلُّ المَرْكَزَ الأَوَّلَ أَوْ لَدَيْهِ النَّتِيجَةُ الأَعْلَى فِي مُنَافَسَة)\nمثال: كان الحصان متقدماً بثلاثة أطوال",
 "in the least": "أبداً, بتاتاً (بأدنى درجة أو بأي حال من الأحوال) / على الإطلاق, ولو قليلاً (إلى أي مدى كان)\nمثال: هل أنت مهتم على الإطلاق؟ لا، على الإطلاق",
 "in the long run": "مَعَ التَّمَادِي, عَلَى المَدَى الطَّوِيل (يفيد الاجتماع والمصاحبة؛ مكان الاجتماع)\nمثال: جئت مع أصدقائي.",
 "in the lurch": "في مأزق, في ورطة (في وضع صعب أو ضعيف)\nمثال: استقال وتركني في مأزق",
 "in the main": "بشكل عام, عموماً (دون تمييز واحد عن الآخرين) / أساساً, بشكل رئيسي (في الغالب)\nمثال: هو مهتم بالثعابين بشكل عام",
 "in the meantime": "في غضون ذلك, في هذه الأثناء (خلال الوقت الفاصل)\nمثال: في غضون ذلك لن أفكر في المشكلة",
 "in the midst": "فِي المُنْتَصَف تَمَامًا (الجزء أو النقطة الوسطى أو المركزية)\nمثال: في وسط الغابة",
 "in the midst of": "بَيْن (ظرف مكان بمعنى وَسْط)\nمثال: مصيري بين يديك.",
 "in the name of": "بِٱسْمِ",
 "in the nick of time": "فِي آخِرِ لَحْظَةٍ, في اللحظة الأخيرة (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "in the past": "فِي ٱلْمَاضِي (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "in the raw": "عَارٍ تَمَاماً ((غير رسمي) عارٍ تماماً بلا أي ملابس)",
 "in the same breath": "في نفس النفس, في نفس الوقت (في وقت واحد تقريباً)\nمثال: مدحته وانتقدته في نفس الوقت",
 "in the short term": "عَلَى الْمَدَى الْقَرِيب, عَلَى الْمَدَى الْقَصِير (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال.",
 "in the south": "جَنُوبًا (في اتجاه الجنوب)\nمثال: انتقلنا جنوباً",
 "in the teeth of": "عَلَى اَلرُّغْم مِن (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال.",
 "in the wake of": "فِي أَعْقَاب, عَلَى أَثَرِ (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة) / عَلَى إِثْرِ (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: جون في عمر أخي.",
 "in the way": "عائقاً, في الطريق (يشكل عائقاً أو مانعاً أو انسداداً)\nمثال: ربما كانت ستنجح في طموحها، لولا أن الظروف وقفت في طريقها",
 "in the wind": "في مهبّ الريح (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "in the wrong": "عَلَى بَاطِلٍ (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال.",
 "in theory": "من حيث المبدأ (فيما يتعلق بالأساسيات وإن لم يكن فيما يتعلق بالتفاصيل)\nمثال: نحن متفقون من حيث المبدأ",
 "in this": "فِي ذَلِك, فِي ذَلِك المَكَان ((رسمي) في أو داخل ذلك الشيء أو المكان)\nمثال: يمكنهم أن يقرؤوا في ذلك ما هي خططنا",
 "in time": "مَعَ الْوَقْت (يفيد الاجتماع والمصاحبة؛ مكان الاجتماع)\nمثال: جئت مع أصدقائي.",
 "in toto": "بالكامل, برمته\nمثال: اشتروا العمل بالكامل",
 "in truth": "بصدق, حقاً (في الواقع (تستخدم للتوكيد أو تعديل الجملة))\nمثال: في الحقيقة، عجل الانحلال الأخلاقي بسقوط الإمبراطورية الرومانية",
 "in turn": "بدوره",
 "in two ways": "بشكل مزدوج, بطريقتين (بطريقة مزدوجة)\nمثال: كان مخطئاً بشكل مزدوج",
 "in use": "قَيْدَ الاِسْتِخْدَام (يُسْتَخْدَمُ حَالِيًّا)",
 "in utero": "في الرحم (داخل الرحم)\nمثال: أصيب الطفل بالعدوى في الرحم من الأم",
 "in vacuo": "في الفراغ (في وسط مفرغ) / بمعزل, في عزلة (في عزلة ودون الرجوع إلى أي شيء آخر)",
 "in vain": "عَبَثًا, سُدًى",
 "in view": "عَلَى مَرْأَى, فِي مَرْمَى البَصَر (عَلَى مَسَافَةٍ مَعْقُولَةٍ لِلرُّؤْيَة)",
 "in view of": "فِي ضَوْء, بِالنَّظَر إِلَى (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "in vitro": "في أنبوب اختبار, في المختبر (في بيئة اصطناعية خارج الكائن الحي) / خارج الجسم الحي, في المختبر (لعملية بيولوجية تحدث في بيئة اصطناعية خارج الكائن الحي)\nمثال: بويضة مخصبة في المختبر",
 "in vivo": "في الجسم الحي (في الكائن الحي) / داخل الكائن الحي, في الجسم الحي (لعملية بيولوجية تحدث داخل كائن حي)\nمثال: دراسات أجريت في الجسم الحي",
 "in wine, there is truth": "الْحَقِيقَة فِي النَّبِيذ",
 "in writing": "عَلَى الوَرَق, نَظَرِيًّا (كما هو مكتوب أو مطبوع)\nمثال: هذا بالضبط ما وضعه الملحن على الورق",
 "in your birthday suit": "عَارٍ كَمَا وَلَدَتْهُ أُمُّهُ (عارٍ تماماً كما كان عند الولادة)",
 "in-basket": "سلة الوارد (وعاء خشبي أو معدني يوضع على المكتب لحفظ المواد الواردة)",
 "in-between": "بَيْنَ بَيْنَ (ظرف مكان بمعنى وَسْط)\nمثال: مصيري بين يديك.",
 "in-bounds": "دَاخِل الحُدُود, فِي المَنْطَقَة الصَّحِيحَة ((في البيسبول) بَيْنَ خَطَّيِ القَاعِدَةِ الأُولَى وَالثَّالِثَة)",
 "in-joke": "نُكْتَة خَاصَّة, نُكْتَة دَاخِلِيَّة (نكتة لا يقدرها سوى أفراد مجموعة معينة من الناس)",
 "in-kind": "عَيْنِيّ",
 "in-law": "صهر, نسيب (قريب عن طريق الزواج)",
 "in-line skate": "حذاء تزلج خطي, زلاجة خطية (حذاء بصف من العجلات المثبتة في النعل)",
 "in-migration": "استيطان, هجرة وافدة (الهجرة إلى مكان (خاصة الهجرة إلى بلد لست من مواطنيه الأصليين للاستقرار فيه))",
 "in-person": "بِالحُضُور الشَّخْصِيّ, حُضُورِيّ (يتمّ بحضور الشخص جسديًّا في المكان)",
 "in-situ": "فِي مَوْضِعِه الأَصْلِيّ (في موقعه الأصليّ؛ لم يُنقَل من مكانه)",
 "in-tray": "سلة الوارد (وعاء خشبي أو معدني يوضع على المكتب لحفظ المواد الواردة)",
 "in-your-face": "سَافِر العُدْوَانِيَّة, وَقِح (عدواني بشكل سافر وصريح)",
 "inability": "عَجْز, عَدَم قُدْرَة (افتقاد القدرة على الأداء) / عجز, عدم قدرة (نقص القدرة (خاصة القدرة العقلية) لفعل شيء ما)",
 "inaccessibility": "تَعَذُّر الوُصُول, مَنَعَة (صفة كون الشيء غير قابل للوصول إليه)",
 "inaccessible": "صَعْب المَنَال, يَتَعَذَّر الوُصُول إِلَيْه (لا يمكن الوصول إليه إلا بصعوبة كبيرة أو لا يمكن الوصول إليه إطلاقاً) / بَعِيد المَنَال, مُتَعَذَّر الحُصُول عَلَيْه (لا يمكن الحصول عليه أو الوصول إليه)",
 "inaccessibly": "بشكل يتعذر الوصول إليه (بطريقة لا يمكن الوصول إليها)\nمثال: يقع في مكان يتعذر الوصول إليه على قمة جبل",
 "inaccuracy": "عَدَم دِقَّة (صفة كون الشيء غير دقيق ويحتوي على أخطاء)",
 "inaccurate": "خَاطِئ, غَيْر دَقِيق (يحتوي على أخطاء)\nمثال: ترجمة غير دقيقة",
 "inaccurately": "بشكل غير دقيق (بطريقة غير دقيقة)\nمثال: هذا الطالب يعمل بشكل غير دقيق",
 "inachis io": "فراشة الطاووس (فراشة أوروبية لها أجنحة بنية محمرة كل منها معلم ببقعة عينية أرجوانية)",
 "inaction": "جمود, خمول (حالة عدم النشاط)",
 "inactivation": "تعطيل, حل الوحدة (تفكيك وحدة عسكرية (عن طريق النقل أو التسريح)) / إبطال الفعالية, تثبيط (عملية جعل الشيء غير نشط)\nمثال: نظام تعطيل الجينات",
 "inactive": "خَامِد",
 "inactiveness": "خمول, عطالة (الميل للبقاء غير نشط أو خامل) / جمود, خمول (حالة عدم النشاط)\nمثال: كان عليه التغلب على عطالته والعودة للعمل",
 "inactivity": "خمول, ركود (حالة عدم النشاط أو قلة النشاط) / خمول, عطالة (الميل للبقاء غير نشط أو خامل) / جمود, خمول (حالة عدم النشاط)\nمثال: كان عليه التغلب على عطالته والعودة للعمل",
 "inadequacy": "عَدَم كِفَايَة, نَقْص (عدم الإرضاء بسبب عدم الكفاية) / عدم كفاية, قصور (الافتقار إلى كمية أو عدد كافٍ) / عدم كفاءة, قصور (نقص الكفاءة)\nمثال: عدم كفاية إعانات البطالة",
 "inadequate": "غَيْر كَافٍ, غَيْر مُلَائِم (لفتقار إلى الصفات أو الموارد اللازمة لتلبية مهمة ما) / شَحِيح, غَيْر كَافٍ (أقل من الكمية اللازمة لتلبية الحاجة)\nمثال: تدريب غير كافٍ",
 "inadequately": "بشكل غير كافٍ (بطريقة غير كافية أو لدرجة غير كافية)\nمثال: المخيمات المؤقتة كانت مجهزة بشكل غير كافٍ",
 "inadequateness": "عَدَم كِفَايَة, نَقْص (عدم الإرضاء بسبب عدم الكفاية)",
 "inadmissibility": "عَدَم جَوَاز, عَدَم قَبُول (عدم القبول كنتيجة لكون الشيء غير مقبول قانوناً أو عرفاً)",
 "inadmissible": "غير جائز, غير مقبول (لا يستحق القبول)\nمثال: أدلة غير مقبولة",
 "inadvertence": "سهو, غفلة (سمة نسيان أو تجاهل مسؤولياتك) / سهو, غفلة غير مقصودة (إغفال غير مقصود ناتج عن الفشل في ملاحظة شيء ما)",
 "inadvertency": "سهو, غفلة (سمة نسيان أو تجاهل مسؤولياتك)",
 "inadvertent": "سَهْوِيّ, عَرَضِيّ (يحدث مصادفة أو بشكل غير متوقع أو غير مقصود)",
 "inadvertently": "عَنْ غَيْرِ قَصْدٍ, بِدُونِ قَصْدٍ (يُفِيدُ المُجَاوَزَة؛ يُفِيدُ الاستعلاء، عَلَى)\nمثال: سألتني عن عمري.",
 "inadvisability": "حماقة, سوء تقدير (صفة كون الأمر غير حكيم أو غير منصوح به)",
 "inadvisable": "غَيْر مَنْصُوح بِه, غَيْر مُسْتَحْسَن (ليس حكيماً أو عاقلاً؛ غير موصى به) / غَيْر حَكِيم, غَيْر مُسْتَحْسَن (ليس من المستحسن القيام به)\nمثال: الجري على الجليد غير مستحسن",
 "inadvisably": "بشكل انتهازي, نفعياً (بطريقة تخدم المصلحة أو الغرض الآني بغض النظر عن المبادئ)",
 "inaesthetic": "غَيْر جَمَالِيّ, قَبِيح (ينتهك القوانين أو المتطلبات الجمالية؛ يفتقر إلى الذوق أو الجمال)\nمثال: غير جمالي وغير فكري تماماً",
 "inalienability": "عدم القابلية للتصرف (حالة عدم القدرة على التنازل أو الاستسلام أو النقل للآخرين)",
 "inalienable": "غَيْر قَابِل لِلتَّصَرُّف فِيه, غَيْر قَابِل لِلنَّقْل (غير قابل للتنصل منه أو نقله إلى شخص آخر) / غَيْرُ قَابِلٍ لِلْمُصَادَرَة, لَا يُسْلَب (لَا يَخْضَعُ لِلْمُصَادَرَةِ أَوِ الانْتِزَاع)\nمثال: وهبهم خالقهم حقوقاً معينة غير قابلة للتصرف",
 "inalienably": "بشكل غير قابل للتصرف (بطريقة لا يمكن نزعها أو تحويلها)\nمثال: هذه الملكية محتفظ بها بشكل غير قابل للتصرف",
 "inalterable": "غَيْر قَابِل لِلتَّغْيِير, لَا يَتَبَدَّل (غير قادر على أن يتغير أو يعدل)\nمثال: عزم لا يلين",
 "inamorata": "عشيقة, محبوبة (امرأة تحبها أو لديك علاقة حميمة معها)",
 "inamorato": "عشيق, محبوب (رجل تحبه أو لديك علاقة حميمة معه)",
 "inane": "تَافِه, سَخِيف (بالغ السخافة والحماقة)",
 "inanely": "ببلاهة, بسخافة (ببلاهة أو رضا عن الذات وحماقة غير واعية)",
 "inanimacy": "جماد, عدم الحياة ((لغويات) خاصية الاسم، في بعض اللغات، التي تعتمد على طبيعته غير الحية أو غير العاقلة)\nمثال: بمعنى آخر، يبدو أن جماد الاسم الرئيسي مثل 'دليل' لم يؤثر على التحليل النحوي للفعل 'فحص'",
 "inanimate": "جَامِد",
 "inanimateness": "انعدام الحياة, جماد (عدم امتلاك حياة)",
 "inanition": "إنهاك الجوع, خوي (الإرهاق الناتج عن نقص الطعام) / خمول, فتور (ضعف يتميز بنقص الحيوية أو الطاقة)",
 "inanity": "حماقة, سخف (الافتقار التام للمعنى أو الأفكار)",
 "inapplicability": "عَدَم قَابِلِيَّة التَّطْبِيق (عدم الصلة بحكم كون الشيء غير قابل للتطبيق على الموضوع المطروح)",
 "inapplicable": "غَيْرُ قَابِلٍ لِلتَّطْبِيقِ (لا يمكن تطبيقه)",
 "inapposite": "غَيْر مُلَائِم, فِي غَيْر مَوْضِعِه (ذو طبيعة غير ملائمة أو موضوع في غير مكانه)",
 "inappositeness": "رَكَاكَة, عَدَم لِيَاقَة (عدم الملاءمة)\nمثال: من الصعب تخيل ركاكة أكبر في التعبير",
 "inappreciable": "ضَئِيل, لَا يُذْكَر (أصغر من أن يُحدث فرقًا ذا شأن)",
 "inappropriate": "غَيْر مُلَائِم, غَيْر مُنَاسِب (غير مناسب لمناسبة معينة إلخ) / غَيْرُ لَائِقٍ, غَيْرُ مُنَاسِبٍ (لَا يَتَّسِقُ مَعَ مَا هُوَ صَحِيحٌ أَوْ لَائِقٌ)\nمثال: تبدو الضوضاء غير مناسبة في وقت الحزن",
 "inappropriately": "بشكل غير لائق, بشكل غير مناسب (بطريقة غير مناسبة)\nمثال: كان يرتدي ملابس غير لائقة",
 "inappropriateness": "عَدَم جَدَارَة, عَدَم مُلَاءَمَة (صفة كون الشيء غير مناسب أو غير لائق بشكل خاص) / خطأ, عدم ملاءمة (سلوك غير مناسب)\nمثال: لم يتراجع عن أي شيء قاله بخصوص عدم ملاءمة",
 "inapt": "ثَقِيل الأُسْلُوب, رَكِيك (يَفْتَقِر إِلَى الأَنَاقَة أَوِ الرَّشَاقَة فِي التَّعْبِير)",
 "inaptitude": "عدم أهلية, عدم كفاءة (افتقار للكفاءة أو الاستعداد)",
 "inaptness": "رَكَاكَة, عَدَم لِيَاقَة (عدم الملاءمة)\nمثال: من الصعب تخيل ركاكة أكبر في التعبير",
 "inarguable": "غَيْرُ قَابِلٍ لِلنِّقَاش, لَا يُمْكِنُ دَحْضُهُ (لَا يُمْكِنُ تَقْدِيمُ حُجَّةٍ ضِدَّهُ)",
 "inarguably": "بشكل قاطع, بلا جدال (بطريقة لا تقبل الجدل أو النزاع)\nمثال: أنت تكتب كما لو أن هذه الحقيقة، وإن كانت تدينني بلا جدال بالانضمام إلى صفوف البوهيمية، إلا أنها أكسبتني حق الدخول إلى أي رفقة",
 "inarticulate": "أَعْجَم, عَاجِز عَن التَّعْبِير (بدون أو محروم من استخدام الكلام أو الكلمات)\nمثال: بهائم عجماء",
 "inarticulately": "بِتَلَعْثُم, دُونَ إِبَانَة (بطريقة غير واضحة) / بِغَيْر إِبَانَة, بِغَيْر فَصَاحَة (بدون فصاحة؛ بطريقة غير واضحة)\nمثال: تحدث بتلعثم عن الحادث الذي أودى بحياة زوجته للتو",
 "inartistic": "عَدِيم الذَّوْق الفَنِّيّ (يفتقر إلى الحس الجمالي)",
 "inasmuch as": "بِقَدْر مَا",
 "inattention": "شرود, عدم انتباه (قلة الانتباه أو عدم التركيز)",
 "inattentive": "سَاهٍ",
 "inattentively": "بذهول, بشرود (بطريقة شاردة الذهن أو مشغولة البال)\nمثال: قرأ الرسالة بشرود",
 "inattentiveness": "شرود, عدم انتباه (سمة عدم مراعاة الآخرين أو التفكير فيهم) / سهو, عدم اكتراث (نقص في الانتباه أو اليقظة (تجاه الأطفال أو العاجزين مثلاً))",
 "inaudibility": "عدم المسموعية (صفة عدم إمكانية الإدراك بالأذن)",
 "inaudible": "غَيْر مَسْمُوع (مستحيل السماع؛ غير مدرك بالأذن)\nمثال: محادثة غير مسموعة",
 "inaudibleness": "عدم المسموعية (صفة عدم إمكانية الإدراك بالأذن)",
 "inaudibly": "بِصَوْت غَيْر مَسْمُوع (بطريقة غير مسموعة)\nمثال: تحدثت بصوت منخفض غير مسموع",
 "inaugural": "تدشين, تنصيب (التنصيب الاحتفالي في منصب ما) / اسْتِهْلَالِيّ, تَدْشِينِيّ (يَهْدِفُ إِلَى تَحْرِيكِ الأُمُورِ أَوْ إِطْلَاقِهَا) / افتتاحي, تدشيني (يحدث عند أو يميز تنصيباً رسمياً أو تقليد منصب) / خطاب التنصيب (خطاب يلقى في مراسم التنصيب (خاصة من قبل رئيس الولايات المتحدة))\nمثال: استمتع الرئيس الجديد بوضوح بحفل تنصيبه",
 "inaugural address": "خطاب التنصيب (خطاب يلقى في مراسم التنصيب (خاصة من قبل رئيس الولايات المتحدة))",
 "inaugurally": "افتتاحاً, تدشيناً (لغرض التدشين أو الافتتاح)\nمثال: غرس العمدة المجرفة في الأرض تدشيناً",
 "inaugurate": "اِفْتَتَحَ (الشيء: فَتَحَه لأول مرة، وأكثر ما تطلق على المحال التجارية والدكاكين والأعمال وكذلك في المعارض والمسرحيات وغيرها من الفعاليات المؤقتة؛ الشيءَ بكذا: بمعنى اسْتَفْتَحَ)\nمثال: افتتح الحدث ب اداء موسيقي حماسي للنشيد الوطني.",
 "inauguration": "تَنْصِيب",
 "inauguration day": "20 يناير, يوم التنصيب (اليوم المخصص لتنصيب رئيس الولايات المتحدة)",
 "inauspicious": "غَيْر مُبَشِّر, مَشْؤُوم (غير مبشر؛ ينذر بالسوء) / مَشْؤُوم, نَذِير شُؤْم (ينذر بسوء الحظ والطالع) / سَيِّئ الطَّالِع, مُعَاكِس (مُنَافٍ لِمَصَالِحك أَوْ رَفَاهِيَتِك)",
 "inauspiciously": "بشكل مشؤوم (بطريقة غير مبشرة)\nمثال: بدأ عمله الجديد بشكل مشؤوم في الجمعة الثالث عشر",
 "inauspiciousness": "شؤم, نذير سوء (صفة الإيحاء بنتيجة غير ناجحة)",
 "inauthentic": "زَائِف, مَنْحُول (كاذب أو مُقلَّد؛ ليس كما يبدو عليه)",
 "inboard": "داخلي (يقع داخل الهيكل أو الأقرب لخط الوسط لسفينة أو طائرة)\nمثال: القلابات الداخلية على الجناح",
 "inborn": "فِطْرِيّ, وِلَادِيّ (مَوْجُودٌ بِشَكْلٍ طَبِيعِيٍّ مُنْذُ الوِلَادَةِ) / خِلْقِيّ, وِلَادِيّ (موجود منذ الولادة لكن ليس بالضرورة وراثيًّا؛ مكتسب أثناء النمو الجنيني)",
 "inborn error of metabolism": "خطأ استقلابي خلقي (أي من العديد من الأمراض التي يؤدي فيها عيب وراثي إلى خلل في الاستقلاب)",
 "inborn reflex": "رد فعل منعكس, منعكس (رد فعل تلقائي غريزي غير متعلم لمحفز)",
 "inbound": "دَاخِل, مُتَّجِه إِلَى الدَّاخِل (مُوجّه أو مُتحرّك نحو الداخل أو نحو المركز)",
 "inbox": "صُنْدُوق الوَارِد (وعاء كبيرة من الخشب غالبا وقد يكون حديدًا يستخدم لوضع الاشياء داخله، ويكون لها عادة جهة قابلة للفتح سواء بمفاصل او بالازالة الكاملة؛ صُنْدُوْقُ السَيَّارَة قمرة تشبه الصندوق في الجزء الخلفي من السيارة يستخدم كالصندوق) / صُنْدُوق الوَارِد, عُلْبَة الوَارِد (وعاء كبيرة من الخشب غالبا وقد يكون حديدًا يستخدم لوضع الاشياء داخله، ويكون لها عادة جهة قابلة للفتح سواء بمفاصل او بالازالة الكاملة؛ صُنْدُوْقُ السَيَّارَة قمرة تشبه الصندوق في الجزء الخلفي من السيارة يستخدم كالصندوق)\nمثال: أين صندوق البريد؟",
 "inbred": "فِطْرِيّ, وِلَادِيّ (مَوْجُودٌ بِشَكْلٍ طَبِيعِيٍّ مُنْذُ الوِلَادَةِ) / فطري, متوالد داخلياً (ينتج عن التزاوج الداخلي)",
 "inbreeding": "تزاوج الأقارب (فعل تزاوج الأفراد ذوي القرابة الوثيقة)",
 "inbuilt": "جَوْهَرِيّ, مُتَأَصِّل (موجود كعنصر أساسي أو سمة جوهرية)",
 "inbus key": "مفتاح ألن, مفتاح سداسي (مفتاح ربط للبراغي السداسية (ألن))",
 "inbus wrench": "مفتاح ألن, مفتاح سداسي (مفتاح ربط للبراغي السداسية (ألن))",
 "inc": "المؤتمر الوطني العراقي (مجموعة غير متجانسة من الجماعات المتحدة في معارضتها لحكومة صدام حسين في العراق؛ تشكلت عام 1992 وتتكون من العرب السنة والشيعة والأكراد الذين يأملون في…)",
 "inca": "إنكا (فرد من شعب الكيشوا يعيش في وادي كوزكو في بيرو) / إنكا, حاكم الإنكا (حاكم الإنكا (أو عضو من عائلتهم))",
 "incalculable": "غَيْر قَابِل لِلْحِسَاب, لَا يُحْصَى (غير قادر على أن يُحسب أو يُعد) / لَا يُحْصَى, لَا يُقَدَّر (أكثر من أن يُقاس أو يُحصى)",
 "incalescence": "تدفئة, تسخين (خاصية التسبب بالدفء)",
 "incan": "إنكي (مكون من أو متعلق بالإنكا أو ثقافتهم أو إمبراطوريتهم) / إنكا (فرد من شعب الكيشوا يعيش في وادي كوزكو في بيرو)",
 "incandescence": "تَوَهُّج",
 "incandescent": "مُتَأَجِّج, مُتَوَهِّج (يَبْعَث الضَّوْء نَتِيجَة التَّسْخِين) / مُتَّقِد, وَهَّاج (يتسم بالعاطفة المتقدة أو الحماسة الشديدة أو التألق)",
 "incandescent lamp": "لمبة, مصباح كهربائي (مصباح كهربائي يتكون من غلاف زجاجي شفاف أو نصف شفاف يحتوي على فتيل سلكي (عادة من التنجستن) يبعث الضوء عند تسخينه بالكهرباء)",
 "incantation": "استحضار, عزيمة (تلاوة طقسية لكلمات أو أصوات يُعتقد أن لها تأثيراً سحرياً)",
 "incapability": "عَجْز, عَدَم قُدْرَة (صفة عدم القدرة - جسدياً أو فكرياً أو قانونياً) / عجز, عدم قابلية (الافتقار لإمكانية التطور)",
 "incapable": "عَاجِز",
 "incapableness": "عَجْز, عَدَم قُدْرَة (صفة عدم القدرة - جسدياً أو فكرياً أو قانونياً) / عجز, عدم قابلية (الافتقار لإمكانية التطور)",
 "incapacitated": "عَاجِز, مَسْلُوب القُدْرَة (يفتقر إلى القوة أو حُرم منها)",
 "incapacitating": "مُعَطِّل, مُقْعِد (يُسَبِّب عَجْزًا أو إعاقَة جَسَدِيَّة)",
 "incapacity": "عَدَم أَهْلِيَّة, قُصُور (نقص في المؤهلات الجسدية أو الطبيعية) / عجز, قصور (نقص القوة الفكرية)",
 "incarceration": "أسر, اعتقال (حالة كونه مسجوناً)\nمثال: احتجز في الأسر حتى مات",
 "incarnate": "جَسَّدَ (جسد - يجسد ، جسدا؛ جسد الدم: يبس)\nمثال: يتكون الإنسان من نفس و جسد.",
 "incarnation": "الحُلُول / التَّجَسُّد, التَّأَنُّس",
 "incased": "مُحَاط بِغِلَاف, مُغَلَّف (مُغطّى أو محميّ بغلاف أو ما يُشبهه)",
 "incasement": "تغليف (عملية إحاطة شيء ما في غلاف أو علبة)",
 "incaution": "تهور, عدم احتراز (سمة نسيان أو تجاهل الخطر المحتمل)",
 "incautious": "غَيْر حَذِر, مُتَسَرِّع (يُخْفِق فِي تَوَخِّي الحَذَر اللَّازِم بِإِهْمَال) / غَيْر حَذِر, مُتَهَوِّر (يفتقر إلى الحذر)\nمثال: ملاحظة غير حذرة",
 "incautiously": "بِتَهَوُّر, دُونَ حَذَر (بدون حذر أو حكمة)\nمثال: يرى المرء للأسف ميزات تاريخية تضيع بتهور عندما تقع العقارات في أيدي غير متعاطفة",
 "incautiousness": "تهور, عدم احتراز (سمة نسيان أو تجاهل الخطر المحتمل)",
 "incendiarism": "إحراق الممتلكات, حريق متعمد (الحرق العمد لتدمير الممتلكات)",
 "incendiary": "تَحْرِيضِيّ",
 "incendiary bomb": "قنبلة حارقة (قنبلة مصممة لإشعال الحرائق؛ وهي أكثر فعالية ضد الأهداف القابلة للاشتعال (مثل الوقود))",
 "incense": "بَخُور (البَخُور : ما يتبخَّر به من عُودٍ ونحوه؛ الدخان أو الرائحة الناتجة من احتراق مادة عطرية) / بُخُور (البَخُور : ما يتبخَّر به من عُودٍ ونحوه؛ الدخان أو الرائحة الناتجة من احتراق مادة عطرية)",
 "incense cedar": "أرز البخور (شجرة طويلة من ساحل المحيط الهادئ لأمريكا الشمالية لها أوراق تشبه السرو ولحاء أحمر قرفي) / أرز البخور (أي من عدة أشجار جذابة من جنوب غرب أمريكا الجنوبية ونيوزيلندا وكاليدونيا الجديدة لها أوراق دائمة الخضرة لامعة وخشب معطر)",
 "incense tree": "شجرة البخور (أي من الأشجار الاستوائية المتنوعة من الفصيلة البخورية التي تنتج صموغاً أو راتنجات عطرة تحرق كبخور)",
 "incense wood": "خشب البخور (خشب عطري لشجرتين من أشجار البخور)",
 "incensed": "مُتَسَخِّط, مُسْتَنْكِر (غاضب بسبب ظلم أو خطأ؛ ساخط لأمر غير عادل)",
 "incentive": "تشجيع, حافز (تأثير تحفيزي إيجابي) / حافز, مكافأة (دفعة إضافية (أو مكافأة أخرى) للموظفين كوسيلة لزيادة الإنتاج)",
 "incentive option": "خيار تحفيزي (خيار يُمنح للمديرين التنفيذيين للشركات إذا حققت الشركة أهدافاً مالية معينة)",
 "incentive program": "برنامج حوافز (مخطط رسمي لتحفيز شخص ما (مثل الموظفين) للقيام بشيء ما)",
 "incentive scheme": "برنامج حوافز (مخطط رسمي لتحفيز شخص ما (مثل الموظفين) للقيام بشيء ما)",
 "incentive stock option": "خيار تحفيزي (خيار يُمنح للمديرين التنفيذيين للشركات إذا حققت الشركة أهدافاً مالية معينة)",
 "inception": "اِسْتِهْلَال",
 "inceptive": "أَوَّلِيّ, بِدَائِيّ (في مرحلة أولية)",
 "incertain": "غَيْر وَاثِق, مُتَرَدِّد (يفتقر إلى أو يشير إلى نقص الثقة أو الاطمئنان)\nمثال: غير واثق من قناعاته",
 "incertitude": "ارتياب, شك (حالة عدم التأكد من شيء ما)",
 "incessancy": "استمرارية, تواصل (صفة الشيء الذي يستمر بلا نهاية أو انقطاع)",
 "incessant": "مُسْتَمِرّ, مُتَوَاصِل",
 "incessantly": "باستمرار, بشكل متواصل (بشكل ثابت لا يتغير) / بِلَا انْقِطَاع, بِلَا تَوَقُّف (بعزيمة لا تكل)\nمثال: العالم يتغير باستمرار",
 "incessantness": "استمرارية, تواصل (صفة الشيء الذي يستمر بلا نهاية أو انقطاع)",
 "incest": "زِنَا مَحَارِم, سِفَاح الْقُرْبَى",
 "incestuous": "زنا المحارم, سفاحي (متعلق بـ أو يتضمن سفاح القربى (زنا المحارم)) / سفاحي (يشبه سفاح القربى كما في الحميمية المفرطة)",
 "incestuously": "بزنا المحارم (عن طريق زنا المحارم)\nمثال: حمل به سفاحاً",
 "inch": "بُوصَة, شِبْر",
 "incheon": "إِنْشْيُون",
 "inchoate": "اِبْتِدَائِيّ",
 "inchoative": "أَوَّلِيّ, بِدَائِيّ (في مرحلة أولية) / هَيْئَة الشُّرُوع (جهة الفعل التي تتعلق ببداية الحدث)",
 "inchoative aspect": "هَيْئَة الشُّرُوع (جهة الفعل التي تتعلق ببداية الحدث)",
 "inchworm": "دودة شبرية, دودة قياسة (يسروع صغير أملس له أرجل فقط في قطاعاته الأمامية والخلفية؛ معظمها يرقات لعث من عائلة الأرفية)",
 "incidence": "سقوط, ورود (اصطدام شعاع ضوئي بسطح ما) / مُعَدَّل الحُدُوث, نِسْبَة الوُقُوع (التكرار النسبي لحدوث شيء ما)\nمثال: قاس زاوية سقوط الضوء المنعكس",
 "incidence angle": "زاوية السقوط, زاوية الورود (الزاوية التي يصنعها خط مع خط عمودي على السطح عند نقطة السقوط)",
 "incident": "حَادِث, حَادِثَة",
 "incidental": "مُتَرَتِّب, مُصَاحِب (يحدث بالتزامن مع شيء آخر أو نتيجةً له) / عَرَضِيّ, هَامِشِيّ (ليس ذا أهمية مركزية أو أوّلية) / جانبي, طارئ ((يتبعه أحياناً 'لـ') ثانوي أو عابر أو تابع في الأهمية أو الطبيعة أو يحدث كمرافق أو نتيجة بالصدفة) / بند عرضي, نفقات نثرية (بند أو عنصر ثانوي أو عرضي)\nمثال: نفقات عرضية",
 "incidental expense": "مصروفات عرضية, نفقات نثرية ((غالباً بصيغة الجمع) مصروف لم يتم وضعه في الميزانية أو لم يتم تحديده)\nمثال: طلب تعويضاً قدره 7 دولارات عن نفقات نثرية",
 "incidental music": "موسيقى تصويرية, موسيقى عرضية (موسيقى مؤلفة لمصاحبة أحداث دراما أو لملء الفواصل بين المشاهد)",
 "incidentally": "عَلَى فِكْرَة (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال.",
 "incienso": "إنسيليا دقيقية, شجيرة هشة (شجيرة مستديرة عطرية في جنوب غرب الولايات المتحدة والمكسيك المجاورة لها سيقان هشة وأوراق صغيرة مزدحمة زرقاء مخضرة وأزهار صفراء؛ تنتج راتنجاً يستخدم في…)",
 "incineration": "تحريق, ترميد (عملية حرق شيء ما بالكامل؛ تحويله إلى رماد)",
 "incinerator": "محرقة, مرمدة (فرن للحرق (خاصة للتخلص من النفايات))",
 "incipience": "بدايات, نشأة (بداية الوجود أو الظهور)\nمثال: وضع نشأة الإيمان الديمقراطي في حوالي عام 1850",
 "incipiency": "بدايات, نشأة (بداية الوجود أو الظهور)\nمثال: وضع نشأة الإيمان الديمقراطي في حوالي عام 1850",
 "incipient": "غَيْرُ مُكْتَمِل, نَاشِئ (موجود جزئياً فقط؛ غير مكتمل التكوّن)",
 "incised": "مَحْفُور عَلَى السَّطْح, مَنْقُوش (مقطوع أو مطبوع على سطحٍ ما) / مَحْزُوز, مَشْقُوق (مقطوع بأداة حادة) / مُفَرَّض بِعُمْق (ذو حوافّ مُفرَّضة بحدّة وعمق)",
 "incision": "شَقّ ((شَقَّ) الفَرَسُ ونحوُهُ يَشِقَّ شَقَقًا: مال في جَرْيِهِ إِلى جانب؛ فهو أشَقُّ، وهي شَقَّاءُ)\nمثال: اكشف عن الشق العلوي من الجسم.",
 "incisive": "حَادّ, قَاطِع (مناسب للقطع أو الثقب) / ثَاقِب, حَادّ (لَدَيْهِ القُدْرَةُ عَلَى التَّمْيِيزِ الدَّقِيقِ وَالإِدْرَاكِ العَمِيق)",
 "incisively": "بإحكام, بدقة (بطريقة دقيقة) / بحدة, بشكل قاطع (بطريقة حاسمة وقاطعة)\nمثال: كانت تعبر عن نفسها دائماً بدقة",
 "incisiveness": "حدة الذهن, قاطعية (حدة وقوة الفكر أو التعبير)",
 "incisor": "قَاطِعَة",
 "incisura": "ثلمة, حز ((تشريح) ثلمة أو تجويف صغير)",
 "incisure": "ثلمة, حز ((تشريح) ثلمة أو تجويف صغير)",
 "incitation": "تحريض, حث (فعل الحث أو الدفع أو استنهاض العمل أو التحريض) / إثارة, استفزاز (شيء يحرض أو يستفز؛ وسيلة لإثارة العمل أو الحركة)\nمثال: التحريض على التمرد",
 "incite": "حَرَّضَ, حَضَّ (حرّضه على الأمر: حضّه ، شدّد الرّغبة فيه؛ حَرَّضَهُ تَحْرِيضاً: حَثَّه على القِتَالِ وأَحْمَاهُ عَلَيْه)\nمثال: هو حرض على الشغب.",
 "incitement": "تَحْرِيض",
 "inciter": "مثير للفتنة, محرض (شخص يثير المشاكل والقلاقل عمداً)\nمثال: كانت هي المحرضة على شجارهم",
 "incitive": "تَحْرِيضِيّ, فِتْنَوِيّ (يُحَرِّض على الفعل أو التمرّد)",
 "incivility": "خشونة, قلة ذوق (قلة أدب متعمدة)",
 "inclemency": "شدة, صرامة (صرامة مفرطة) / طقس سيء, قسوة الطقس (طقس غير مناسب للأنشطة الخارجية)\nمثال: صرامة الشخصية",
 "inclement": "عَدِيم الرَّحْمَة, قَاسٍ (يستخدم للأشخاص أو السلوك؛ لا يظهر أي رأفة أو رحمة) / رَدِيء, قَاسٍ ((للطقس أو المناخ) شديد)\nمثال: الحكم القاسي لقاضٍ عديم الرحمة",
 "inclementness": "طقس سيء, قسوة الطقس (طقس غير مناسب للأنشطة الخارجية)",
 "inclination": "انحناء, ميل (فعل الانحناء؛ الميل إلى الأمام) / ميل, نزعة (احتمالية مميزة أو استعداد طبيعي تجاه حالة أو طابع أو تأثير معين) / اِنْحِنَاء, مَيَلَان (الخاصية التي يمتلكها خط أو سطح ينحرف عن الوضع العمودي) / استعداد, ميل (موقف ذهني يميل لتفضيل بديل على آخر)\nمثال: أشار انحناء رأسه إلى موافقته",
 "inclination of an orbit": "ميل, ميل المدار ((علم الفلك) الزاوية بين مستوى المدار ومستوى مسار الشمس مقاسة بالدرجات)",
 "incline": "منحدر (سطح مائل يربط بين مستويين) / منحدر, ميل (تكوين جيولوجي مرتفع ومائل)\nمثال: تسلق المنحدر الشديد",
 "incline bench press": "ضغط صدر مائل (تمرين ضغط الصدر يُؤدى على مقعد مائل)",
 "inclined": "مَائِل",
 "inclined fault": "صدع مائل (صدع جيولوجي يكون فيه أحد الجانبين أعلى من الآخر)",
 "inclined plane": "المُسْتَوِي المائِل",
 "inclining": "انحناء, ميل (فعل الانحناء؛ الميل إلى الأمام)\nمثال: أشار انحناء رأسه إلى موافقته",
 "inclinometer": "كلينومتر, مقياس الميل (أداة يستخدمها المساحون لقياس زاوية الميل أو الارتفاع) / مقياس الميل المغناطيسي (أداة قياس لقياس زاوية الميل المغناطيسي (كما هو الحال من طائرة)) / مقياس الميل (أداة تظهر الزاوية التي تصنعها الطائرة مع الأفق)",
 "inclosure": "إحاطة, تغليف (عملية إحاطة شيء داخل شيء آخر) / طية, مرفق (شيء ما (عادة وثيقة داعمة) يتم إرفاقه في ظرف مع رسالة تغطية)",
 "include": "تضمن",
 "included": "مُرْفَق, مُضَمَّن (مرفق في نفس المظروف أو الحزمة)",
 "including": "شَامِل",
 "inclusion": "إدراج, تضمين (عملية التضمين) / جِسْم اِحْتِوَائِيّ (أي جسم صغير داخل الخلية يوجد داخل آخر (من خصائص بعض الأمراض)) / اشْتِمَال, تَضَمُّن (علاقة تضمين شيء ما) / إدراج, اشتمال (حالة كونه مشمولاً أو مدرجاً)\nمثال: جسم احتوائي في سيتوبلازم الخلية",
 "inclusion body": "جِسْم اِحْتِوَائِيّ (أي جسم صغير داخل الخلية يوجد داخل آخر (من خصائص بعض الأمراض))\nمثال: جسم احتوائي في سيتوبلازم الخلية",
 "inclusion body encephalitis": "التهاب الدماغ المصلب تحت الحاد (التهاب دماغ مزمن نادر ومترقٍ يسببه فيروس الحصبة ويحدث بشكل أساسي عند الأطفال والشباب؛ تحدث الوفاة عادة في غضون ثلاث سنوات)",
 "inclusion body myositis": "التهاب العضلات المشتمل (التهاب عضلات يتميز بضعف عضلات الأطراف (خاصة الفخذين والمعصمين والأصابع)؛ يشمل أحياناً عضلات البلع؛ يبدأ بعد سن الخمسين ويتقدم ببطء)",
 "inclusive": "جامع, شامل (يشمل الكثير أو كل شيء؛ ويشمل بشكل خاص الحدود المذكورة)\nمثال: شكل فني شامل",
 "incognito": "مَجْهُول",
 "incognizable": "غَيْرُ قَابِلٍ لِلْمَعْرِفَة (يَسْتَحِيلُ إِدْرَاكُهُ أَوْ مَعْرِفَتُه)",
 "incognizance": "جهل, عدم إدراك (نقص في المعرفة أو التعرف)",
 "incognizant": "غَافِل, غَيْر مُدْرِك ((غالباً يتبعه 'بـ') غير مدرك)\nمثال: بدا غافلاً عن التدقيق",
 "incognoscible": "غَيْرُ قَابِلٍ لِلْمَعْرِفَة (يَسْتَحِيلُ إِدْرَاكُهُ أَوْ مَعْرِفَتُه)",
 "incoherence": "تَهَافُت",
 "incoherency": "تَفَكُّك, عَدَم تَرَابُط (هراء غير متماسك وغير مفهوم ببساطة) / تفكك, عدم ترابط (نقص التماسك أو الوضوح أو التنظيم)",
 "incoherent": "عَاجِز عَن التَّعْبِير, مُتَلَعْثِم (غير قادر على التعبير عن نفسه بوضوح أو طلاقة) / غَيْر مُتَرَابِط ((في الفيزياء) لموجات ليس لها علاقة طور مستقرة أو محددة) / غَيْر مُتَرَابِط, مُفَكَّك (بدون اتصال منطقي أو ذي معنى)\nمثال: عرض منتفخ ومفكك",
 "incoherently": "بِتَفَكُّك, بِشَكْل غَيْر مُتَرَابِط (بطريقة غير متماسكة)\nمثال: تحدث بشكل غير مترابط عندما شرب كثيراً",
 "incombustible": "غَيْر قَابِل لِلاِحْتِرَاق (غير قادر على الاشتعال والاحتراق)",
 "income": "دَخْل, إِيرَاد (وَلَجَ؛ أَدْخَلَ. (تعدية خاصة بالباء))\nمثال: دخل توم المبنى.",
 "income bracket": "شريحة الدخل, شريحة ضريبية (فئة من دافعي الضرائب بناءً على مقدار دخلهم)",
 "income statement": "بيان الدخل, تقرير الأرباح (بيان مالي يعطي نتائج التشغيل لفترة محددة)",
 "income tax": "ضَرِيبَة اَلدَّخْل",
 "income tax bracket": "شريحة الدخل, شريحة ضريبية (فئة من دافعي الضرائب بناءً على مقدار دخلهم)",
 "income tax return": "إقرار ضريبة الدخل, إقرار ضريبي (وثيقة تعطي محصل الضرائب معلومات حول الالتزام الضريبي لدافع الضرائب)\nمثال: كان إجمالي دخله كافياً لدرجة أنه اضطر لتقديم إقرار ضريبي",
 "incoming": "دخول (فعل الدخول) / جديد, قادم (يتولى منصباً تركه شخص آخر) / قادم, وارد (يصل إلى مكان أو موقع)\nمثال: قامت بدخول مهيب",
 "incommensurable": "غَيْر قَابِل لِلْقِيَاس المُشْتَرَك (ليس له عامل مشترك للقياس) / غَيْرُ قَابِلٍ لِلقِيَاس (يستحيل قياسه أو مقارنته من حيث القيمة أو الحجم أو التفوّق)",
 "incommensurate": "غير متكافئ, غير متناسب (غير متوافق في الحجم أو الدرجة أو المدى)\nمثال: مكافأة غير متناسبة مع جهده",
 "incommodious": "ضَيِّق, غَيْر مُرِيح (صغير بشكل غير مريح أو غير ملائم)\nمثال: أماكن إقامة ضيقة في الفندق",
 "incommodiousness": "إزعاج, عدم ملاءمة (انزعاج غير مريح)",
 "incommunicado": "مَعْزُول, مُنْقَطِعُ الاتِّصَال (بدون وسيلة أو حقّ في التواصل مع الآخرين)",
 "incommunicative": "انطوائي, غير تواصلي (لا يميل إلى التحدث أو إعطاء المعلومات أو التعبير عن الآراء)",
 "incommutability": "عَدَم قَابِلِيَّة لِلْمُبَادَلَة (صفة عدم القابلية للاستبدال)",
 "incommutable": "غَيْر قَابِل لِلاِسْتِبْدَال (لا يخضع للتغيير أو الاستبدال) / غَيْر قَابِل لِلإِبْدَال (لا يمكن تبادله أو إحلال أحدهما محل الآخر)",
 "incomparability": "عَدَم قَابِلِيَّة المُقَارَنَة (حالة عدم القدرة على المقارنة) / تَفَرُّد, عَدَم قَابِلِيَّة المُقَارَنَة (صفة كون الشيء أفضل بكثير من غيره لدرجة تجعل المقارنة غير ممكنة)",
 "incomparable": "غير قابل للمقارنة, لا يضاهى (بحيث تكون المقارنة مستحيلة؛ غير مناسب للمقارنة أو يفتقر للميزات التي يمكن مقارنتها)\nمثال: أسبوع لا يضاهى من الراحة والمتعة",
 "incomparably": "بشكل لا يضاهى, بشكل منقطع النظير (بطريقة لا يمكن مقارنتها أو لدرجة لا تضاهى)\nمثال: إنها موهوبة بشكل لا يضاهى",
 "incompatibility": "تعارض, تنافر (صفة عدم القدرة على الوجود أو العمل معًا بانسجام) / تَعَارُض, تَنَافُر (العلاقة بين القضايا التي لا يمكن أن تكون صحيحة في نفس الوقت) / عدم توافق ((علم المناعة) الدرجة التي سيحاول بها الجهاز المناعي للجسم رفض المواد الغريبة (كالدم المنقول أو الأنسجة المزروعة))",
 "incompatible": "غير متوافق, غير منسجم (غير متوافق) / غير متوافق ((تقنياً) غير قابل للاستخدام مع أو الاتصال بأجهزة أو مكونات أخرى دون تعديل) / غَيْرُ مُتَجَانِس ((خاصةً المواد الصلبة أو المحاليل) غير قابل للامتزاج في خليط متجانس ومستقرّ) / غير متوافق, غير ملائم (غير مناسب لأذواقك أو احتياجاتك)\nمثال: شخصيات غير متوافقة",
 "incompatibly": "بِتَنَافُر, دُونَ تَوَافُق (بدون توافق)",
 "incompetence": "عَجْز, عَدَم كَفَاءَة (نقص في القدرة الجسدية أو الفكرية أو المؤهلات) / عجز, قصور (عدم قدرة جزء أو عضو على العمل بشكل صحيح)",
 "incompetency": "عَجْز, عَدَم كَفَاءَة (نقص في القدرة الجسدية أو الفكرية أو المؤهلات)",
 "incompetent": "عَاجِز, غَيْر مُؤَهَّل (لا يستوفي المتطلّبات اللازمة) / عاجز, غير كفء (غير مؤهل أو غير مناسب لغرض ما) / غير مؤهل, غير مختص قانونياً (غير مؤهل أو غير كافٍ قانونياً) / عَدِيم المَهَارَة, غَيْر كُفْء (لا يؤدي العمل بشكل جيد؛ يفتقر إلى الكفاءة)\nمثال: جهاز مخابرات غير كفء",
 "incompetent cervix": "قصور عنق الرحم ((طب التوليد) عنق رحم يتوسع قبل الأوان وبدون مخاض مما يؤدي غالباً إلى الإجهاض أو الولادة المبكرة)",
 "incompetent person": "عاجز, غير كفء (شخص ليس لديه الكفاءة لاتخاذ إجراءات فعالة)",
 "incompetently": "بشكل غير كفء (بطريقة تفتقر للكفاءة)\nمثال: أنجز العمل بشكل غير كفء إلى حد ما",
 "incomplete": "غير مكتمل, ناقص (غير كامل أو غير كلي؛ لم يتم إنجازه) / غَيْرُ مُكْتَمِل, نَاقِص (لَمْ يَكْتَمِلْ بَعْدُ)\nمثال: سرد غير مكتمل لحياته",
 "incomplete abortion": "إجهاض غير كامل (إنهاء الحمل دون طرد جميع نواتج الحمل)",
 "incomplete fracture": "كسر غير كامل (كسر لا يمتد عبر كامل عرض العظم)",
 "incompletely": "بشكل غير كامل, ناقصاً (ليس لدرجة كاملة أو تامة)\nمثال: كلمات مفهومة بشكل غير كامل",
 "incompleteness": "عدم اكتمال, نقصان (حالة كونه خاماً وغير كامل وغير تام)\nمثال: انتُقدت الدراسة لعدم اكتمال البيانات لكنها حفزت المزيد من البحث",
 "incomprehensibility": "إِبْهَام, اسْتِغْلَاق (صفة كون الشيء غير مفهوم)",
 "incomprehensible": "غامض, غير مفهوم (صعب الفهم) / عصي على الفهم, لا يمكن تفسيره (غير قادر على أن يفسر أو يعلل)\nمثال: الشيء الأكثر غموضاً (عدم قابلية للفهم) في الكون هو أنه قابل للفهم",
 "incomprehension": "عدم فهم, قصور الفهم (عدم القدرة على الفهم)\nمثال: عدم فهمه للعواقب",
 "incomprehensive": "غير شامل (ليس شاملاً)",
 "incompressibility": "عدم قابلية الانضغاط (خاصية كون الشيء غير قابل للانضغاط)",
 "incompressible": "غير قابل للانضغاط (غير قابل للضغط؛ يقاوم الانضغاط)\nمثال: أكوام من القمامة غير القابلة للانضغاط",
 "incomputable": "لَا يُقَاس, لَا يُقَدَّر (يَتَجَاوَز الحِسَاب أَوِ القِيَاس)",
 "inconceivability": "استحالة التصور, لا معقولية (حالة كون الشيء مستحيلاً للتصور)",
 "inconceivable": "غَيْرُ وَارِد, مُسْتَحِيل (مُسْتَبْعَدٌ تَمَامًا؛ لَا يُمْكِنُ تَصَوُّرُه)",
 "inconceivableness": "استحالة التصور, لا معقولية (حالة كون الشيء مستحيلاً للتصور)",
 "inconceivably": "بشكل لا يصدق (لدرجة لا يمكن تصورها)\nمثال: صغير بشكل لا يصدق",
 "inconclusive": "غير حاسم, غير قاطع (غير نهائي؛ لا يضع حداً للشك أو السؤال)\nمثال: رد غير حاسم",
 "inconclusively": "بشكل غير حاسم (ليس بشكل قاطع)\nمثال: انتهى الاجتماع بشكل غير حاسم",
 "inconclusiveness": "عَدَم حَسْم, عَدَم قَطْعِيَّة (صفة كون الشيء غير حاسم)",
 "inconel": "إنكونيل (سبيكة أساسها النيكل مع الكروم والحديد؛ تستخدم في شفرات توربينات الغاز)",
 "incongruent": "غير متطابق (غير متطابق (في الهندسة))",
 "incongruity": "تناقض, عدم ملاءمة (صفة عدم الاتفاق أو عدم الملاءمة)",
 "incongruous": "شاذ, غير متوافق (يفتقر إلى الانسجام أو التوافق أو الملاءمة)\nمثال: خطة غير متوافقة مع العقل",
 "incongruously": "بشكل غير متناسق, بشكل متنافر (بطريقة غير متناغمة)\nمثال: برزت أطراف قميصه من بنطال البدلة الرسمية بشكل متنافر نوعاً ما",
 "incongruousness": "تناقض, عدم ملاءمة (صفة عدم الاتفاق أو عدم الملاءمة)",
 "inconsequence": "لَا مَنْطِقِيَّة (استدلال غير صالح أو غير صحيح) / انعدام الأهمية, عدم التأثير (عدم وجود تأثيرات أو نفوذ مهم)",
 "inconsequent": "عَدِيم الأَهَمِّيَّة, لَا قِيمَة لَهُ (يفتقر إلى القيمة أو الأهمّيّة)",
 "inconsequential": "عَدِيم الأَهَمِّيَّة, لَا قِيمَة لَهُ (يفتقر إلى القيمة أو الأهمّيّة) / غَيْر مُتَّسِق (لا يَتْبَع كَنَتيجَة مَنْطِقِيَّة)",
 "inconsequentially": "بِشَكْل غَيْر ذِي صِلَة, دُونَ تَرَابُط (الافتقار إلى النتيجة المترابطة)\nمثال: 'أنت ترتدين ملابس جميلة جداً'، قالت وأضافت دون ترابط تماماً، 'هل يمكنك البقاء الليلة؟'",
 "inconsequently": "بِشَكْل غَيْر ذِي صِلَة, دُونَ تَرَابُط (الافتقار إلى النتيجة المترابطة)\nمثال: 'أنت ترتدين ملابس جميلة جداً'، قالت وأضافت دون ترابط تماماً، 'هل يمكنك البقاء الليلة؟'",
 "inconsiderable": "تافه, ضئيل (صغير جداً أو غير مهم لدرجة لا تستحق الاهتمام)\nمثال: قضى حياته في قرية غير ذات شأن",
 "inconsiderate": "غير مراعٍ, مستهتر (يفتقر إلى الاهتمام بحقوق أو مشاعر الآخرين) / غَيْرُ مُتَرَوٍّ, مُتَسَرِّع (بِدُونِ تَفْكِيرٍ أَوْ تَأَمُّلٍ كَافٍ)\nمثال: سلوك مستهتر بشكل صادم",
 "inconsiderately": "بدون مراعاة (دون مراعاة للآخرين)\nمثال: بدون مراعاة، طلب أن يُدعى للعشاء",
 "inconsiderateness": "اسْتِهْتَار, طَيْش (صفة الفشل في مراعاة شعور الآخرين)",
 "inconsideration": "اسْتِهْتَار, طَيْش (صفة الفشل في مراعاة شعور الآخرين)",
 "inconsistency": "تَنَاقُض, عَدَم اتِّسَاق (صفة عدم الاتساق وافتقار الانسجام بين الأشياء أو الأجزاء) / تَعَارُض, تَنَافُر (العلاقة بين القضايا التي لا يمكن أن تكون صحيحة في نفس الوقت)",
 "inconsistent": "مُتَعَارِض, مُتَنَاقِض (غَيْرُ مُتَّسِقٍ أَوْ مُتَوَافِقٍ) / غير متسق, متناقض (يظهر نقصاً في الاتساق) / غَيْرُ مُتَّسِقٍ, مُتَنَاقِضٌ (لا يمكن جعله متسقاً أو منسجماً)\nمثال: التصريحات المتناقضة لا يمكن أن تكون صحيحة في نفس الوقت",
 "inconsistently": "بشكل غير متسق (دون إظهار الاتساق)\nمثال: تصرف بشكل غير متسق عندما اشترى هذه الأسهم",
 "inconsolable": "بائس, غير قابل للمواساة (حزين لدرجة لا يمكن معها المواساة؛ غير قادر على تلقي العزاء)\nمثال: مفجوعة عند وفاة ابنها",
 "inconspicuous": "غَيْرُ ظَاهِر (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "inconspicuously": "خلسة, دون لفت للانتباه (بطريقة تهدف إلى تجنب جذب الانتباه)\nمثال: دخل الغرفة دون لفت للانتباه",
 "inconspicuousness": "خفاء, عدم الوضوح (صفة عدم سهولة الرؤية)",
 "inconstancy": "تَقَلُّب, عَدَم ثَبَات (صفة التغير والتباين) / تَقَلُّب, غَدْر (عدم الوفاء بحكم عدم الموثوقية أو الغدر)",
 "inconstant": "غير ثابت, متقلب (من المحتمل أن يتغير بشكل متكرر غالباً دون سبب واضح أو مقنع؛ متغير)\nمثال: عواطف متقلبة",
 "incontestable": "قطعي, لا يرقى إليه الشك (غير قابل للاعتراض أو الجدال فيه) / لَا جِدَال فِيه, لَا يُنَازَع (لَا يَقْبَلُ الطَّعْنَ أَوِ الشَّكّ؛ صَحِيحٌ بِوُضُوح)",
 "incontestible": "قطعي, لا يرقى إليه الشك (غير قابل للاعتراض أو الجدال فيه)",
 "incontinence": "سَلَس ((سَلُسَ) يَسْلُسُ سَلاسَةً: لانَ وسَهُلَ وانقادَ، فهو سَلِيسٌ)",
 "incontinency": "سلس, عدم استمساك (تبول أو تبرز لا إرادي)",
 "incontinent": "غير متحكم, مصاب بسلس (ليس لديه سيطرة على التبول والتغوط)",
 "incontrovertibility": "عَدَم قَابِلِيَّة الدَّحْض, قَطْعِيَّة (صفة كون الشيء غير قابل للإنكار ولا يستحق الجدال حوله)",
 "incontrovertible": "بَيِّن, لَا جِدَالَ فِيه (صَحِيحٌ بِالضَّرُورَةِ أَوْ بِشَكْلٍ يُمْكِنُ إِثْبَاتُهُ) / دَامِغ, لَا يُدْحَض (مُسْتَحِيلُ النَّفْيِ أَوِ الدَّحْض)",
 "incontrovertibleness": "عَدَم قَابِلِيَّة الدَّحْض, قَطْعِيَّة (صفة كون الشيء غير قابل للإنكار ولا يستحق الجدال حوله)",
 "incontrovertibly": "بِلَا نِزَاع, لَا يَقْبَل اَلْجَدَل",
 "inconvenience": "إزعاج, إقلاق (صعوبة تسبب القلق) / إِزْعَاج, عَدَم رَاحَة (صفة كون الشيء غير مفيد أو غير مريح) / إزعاج, عدم ملاءمة (انزعاج غير مريح)",
 "inconvenient": "غير ملائم, مزدحم (غير مناسب لراحتك أو غرضك أو احتياجاتك) / غَيْر مُرِيح, غَيْر مُلَائِم (ذو توقيت غير مريح أو مناسب)\nمثال: من غير الملائم عدم وجود هاتف في المطبخ",
 "inconveniently": "بشكل غير ملائم (بطريقة غير مريحة)\nمثال: وصل في ساعة متأخرة بشكل غير ملائم",
 "inconvertibility": "عَدَم قَابِلِيَّة لِلتَّحْوِيل (صفة عدم القابلية للاستبدال)\nمثال: عدم قابلية عملتهم للتحويل جعلت التجارة الدولية مستحيلة",
 "inconvertible": "غَيْر قَابِل لِلتَّحْوِيل (لا يمكن تحويله إلى شيء آخر) / غير قابل للاستبدال, غير قابل للتحويل (يستخدم خاصة للعملات؛ غير قادر على أن يتم استبداله أو مقايضته بعملة أخرى ذات قيمة مساوية)",
 "incoordination": "عدم تناسق (نقص في تنسيق الحركات)",
 "incorporate": "دَمَجَ (دمج الأشياء: جمعها وخلطها معًا؛ دمجهُ:جعله جزءًا من شيء أكبر منه)\nمثال: دمج فكرتين في فكرة.",
 "incorporated": "مُدْمَج, مُنْدَمِج (أُدخِل كجزء من الكل) / مُدْمَج قَانُونِيًّا, مُسَاهَمَاتِيّ (منظم ومُدار ككيان قانوني مؤسسي) / مُتَكَامِل, مُدْمَج (تشكّل أو اتحد في كلّ واحد متكامل)",
 "incorporation": "إدماج, دمج (التضمين عن طريق الدمج) / تأسيس, دمج (دمج شيئين أو أكثر؛ الاتحاد في (أو ضمن) هيئة واحدة) / استدماج, تذويت (التعلم (للقيم أو المواقف وما إلى ذلك) الذي يتم دمجها داخل الذات)",
 "incorporative": "تَوَسُّعِيّ ضَمِّيّ (ينمو بالاستيلاء على الأقاليم المجاورة وضمّها)",
 "incorporeal": "روحي, غير جسدي (بدون شكل مادي أو مادة)\nمثال: روح غير جسدية",
 "incorporeality": "رُوحَانِيَّة, لَا مَادِّيَّة (صفة عدم كون الشيء مادياً؛ عدم التكون من مادة)",
 "incorrect": "خَاطِئ, غَلَط (يتّسم بالأخطاء؛ لا يتّفق مع النموذج أو القواعد المُقرَّرة) / خاطئ, غير صحيح (غير صحيح؛ لا يتوافق مع الواقع أو الحقيقة) / غَيْر صَحِيح نَحْوِيًّا ((عن كلمة أو تعبير) لا يتوافق مع القواعد النحوية) / خَاطِئ, غَيْر صَحِيح (لا يتوافق مع الاستعمال أو الإجراء المعتمد)\nمثال: حساب غير صحيح",
 "incorrectly": "بشكل غير صحيح, خطأً (بطريقة غير صحيحة) / بشكل خاطئ, خطأً (بطريقة غير صحيحة)\nمثال: خمنت خطأ",
 "incorrectness": "خَطَأ, عَدَم صِحَّة (صفة عدم المطابقة للواقع أو الحقيقة) / عدم صحة (عدم الامتثال للتوقعات الاجتماعية)",
 "incorrigible": "عَنِيد",
 "incorrigibly": "بشكل لا يرجى إصلاحه (بطريقة مستعصية على الإصلاح)",
 "incorrupt": "شريف, غير فاسد (خالٍ من الفساد أو اللاأخلاقية) / سَلِيم, غَيْر مُتَحَلِّل (لَمْ يَتَحَلَّل أَوْ يَتَعَفَّن)\nمثال: شرطي كان نزيهاً وغير قابل للإفساد",
 "incorrupted": "بِلَا عَيْب, لَا تَشُوبُهُ شَائِبَة (خَالٍ مِنَ العَيْبِ أَوِ الخَطَأ)",
 "incorruptibility": "تنزه عن الفساد, عصمة (عدم القابلية للإفساد)",
 "incorruptible": "غَيْرُ قَابِلٍ لِلإِفْسَاد (لَا يُمْكِنُ إِفْسَادُهُ أَخْلَاقِيًّا)",
 "incorruption": "عدم القابلية للفساد, نزاهة (الاتصاف بالنزاهة أو الاستقامة)",
 "incorruptness": "عدم القابلية للفساد, نزاهة (الاتصاف بالنزاهة أو الاستقامة)",
 "increase": "زَاد (زَادَ يَزِيدُ زَيْدًا، وزِيادَةً: نما وكَثُرَ؛ زَادَ الشيءَ: جعله يزيد) / زِيَادَة / اِرْتِفَاع, اِزْدِيَاد\nمثال: زاد السياح عددا.",
 "increased": "زائد, متزايد (أصبح أكبر في الحجم أو الكمية أو الدرجة)",
 "increasing": "متزايد, متنامٍ (يصبح أكبر أو أضخم) / متصاعد (موسيقى) ((موسيقى) يتزايد في السرعة و/أو الحجم)\nمثال: أسعار متزايدة",
 "increasing monotonic": "مُتَزَايِدٌ رَتِيبًا (يَتَزَايَدُ بِشَكْلٍ مُطَّرِدٍ وَمُسْتَمِرّ)",
 "increasingly": "أكثر فأكثر, بشكل متزايد (يتقدم في الكمية أو الكثافة)\nمثال: أصبحت مكتئبة بشكل متزايد",
 "incredibility": "عجب, لا معقولية (صفة كون الشيء غير قابل للتصديق أو مذهلاً حد العجب)",
 "incredible": "غير معقول, لا يصدق (يتجاوز التصديق أو الفهم)\nمثال: بسرعة لا تصدق",
 "incredibleness": "عجب, لا معقولية (صفة كون الشيء غير قابل للتصديق أو مذهلاً حد العجب)",
 "incredibly": "بشكل خرافي, بشكل لا يصدق (بشكل مفرط؛ للغاية) / بِإِعْجَاز, بِشَكْل لَا يُصَدَّق (ليس من السهل تصديقه)\nمثال: تعزف بشكل جيد خرافي",
 "incredulity": "ارتياب, شك (الشك في حقيقة شيء ما)",
 "incredulous": "غير مصدق, متشكك (غير مستعد أو غير راغب في التصديق)",
 "incredulously": "بِاسْتِنْكَار, بِتَشَكُّك (بطريقة شاكة وغير مصدقة)\nمثال: نظرت المرأة إليها بعدم تصديق",
 "increment": "زيادة, علاوة (المقدار الذي يزداد به الشيء) / تصاعد, زيادة (عملية التحول إلى أكبر أو أطول أو أكثر عدداً أو أهمية)\nمثال: اقترحوا زيادة بنسبة 15 في المائة في الأجرة",
 "incremental": "تَدْرِيجِيّ, تَزَايُدِيّ (يزداد تدريجيًّا بمقادير منتظمة أو إضافات متتالية)",
 "incremental cost": "تكلفة تزايدية, تكلفة حدية (الزيادة أو النقصان في التكاليف نتيجة لوحدة إنتاج واحدة أكثر أو أقل)",
 "incrementation": "تزايد, زيادة (عملية إضافة واحد إلى المعامل)",
 "incriminating": "تَجْرِيمِيّ, مُدِين (يُوَجِّه تهمة أو يُوحِي بالذنب أو اللوم)",
 "incriminatingly": "بشكل يجرم, بشكل يدين (بطريقة تدين أو تثبت التهمة)",
 "incrimination": "إدانة, تجريم (اتهام بأنك مسؤول عن هفوة أو سوء تصرف)\nمثال: كان تجريمه مبنياً على شهادتي",
 "incriminatory": "تَجْرِيمِيّ, مُدِين (يُوَجِّه تهمة أو يُوحِي بالذنب أو اللوم)",
 "incrustation": "تغطية قشرية (طلاء زخرفي من مادة مغايرة يوضع على سطح كتطعيم أو طبقة خارجية) / طَبَقَة صُلْبَة, قِشْرَة (طبقة خارجية صلبة تغطي شيئاً ما) / تقشر, تكون قشرة (تكون قشرة)",
 "incubation": "حِضَانَة, تَفْرِيخ",
 "incubation period": "فترة الحضانة (الفترة ما بين الإصابة بالعدوى وظهور أعراض المرض)",
 "incubator": "حَاضِنَة",
 "incubus": "جَاثُوم, كَابُوس / كابوس, حلم / باروك",
 "inculcation": "ترسيخ, غرس (التعليم أو الطبع في الذهن عن طريق التلقين المتكرر)",
 "inculpability": "براءة, خلو من اللوم (حالة من البراءة)",
 "inculpable": "بَرِيء, لَا تَشُوبُهُ شَائِبَة (خالٍ من الذنب؛ لا يستحق اللوم)",
 "inculpableness": "براءة, خلو من اللوم (حالة من البراءة)",
 "inculpation": "إدانة, تجريم (اتهام بأنك مسؤول عن هفوة أو سوء تصرف)\nمثال: كان تجريمه مبنياً على شهادتي",
 "inculpative": "متهم, مجرم (يسبب إسناد اللوم إلى)",
 "inculpatory": "متهم, مجرم (يسبب إسناد اللوم إلى)",
 "incumbency": "شغل المنصب, فترة تولي المنصب (وظيفة أو منصب شاغل الوظيفة الحالي) / عبء الوظيفة, مسؤولية (واجب يقع على عاتقك) / فترة منصب, فترة ولاية (الفترة التي يتم خلالها شغل منصب ما)",
 "incumbent": "شَاغِل",
 "incumbrance": "عائق, مانع (أي عائق يعرقل أو يكون مرهقاً) / ثقل, حمل (اهتمام شاق أو صعب) / رهن, عبء (حق للغير على الممتلكات (مثل حق الحجز أو الرهن العقاري))\nمثال: عبء المسؤولية",
 "incur": "كَبَّدَ",
 "incurability": "اسْتِعْصَاء (عدم القدرة على التغيير في الطباع أو العادات) / استعصاء على العلاج, عدم قابلية الشفاء (عدم إمكانية الشفاء أو العلاج)\nمثال: استعصاء تفاؤله على التغيير",
 "incurable": "لَا رَجَاء مِن شِفَائِه (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: لا أحب المدرسة.",
 "incurableness": "استعصاء على العلاج, عدم قابلية الشفاء (عدم إمكانية الشفاء أو العلاج)",
 "incurably": "بشكل لا شفاء منه, بشكل مستعصٍ (بطريقة يستحيل علاجها) / بشكل لا يبرأ, بشكل ميؤوس منه (لدرجة لا يمكن علاجها)\nمثال: إنه مريض بشكل لا شفاء منه",
 "incurious": "غير فضولي, غير مكترث (يظهر غياب حب الاستطلاع الفكري أو الفضول الطبيعي)\nمثال: غير فضولي بشكل غريب حول سبب الاضطراب السياسي المحيط بهم",
 "incurrence": "تَحَمُّل, تَكَبُّد (فعل التكبد (جعل نفسك عرضة لشيء غير مرغوب فيه))",
 "incurring": "تحمل, تكبد (اكتساب أو الوقوع في شيء (عادة غير مرغوب فيه))\nمثال: تحمل الديون أسهل من سدادها",
 "incursion": "توغل",
 "incursive": "اجْتِيَاحِيّ, غَزْوِيّ (ينطوي على غزو أو هجوم عدوانيّ)",
 "incurvate": "مُقَعَّر, مُنْحَنٍ لِلدَّاخِل (مثنيّ أو منحنٍ نحو الداخل)",
 "incurvation": "انحناء, تقوس (عملية إنشاء شكل منحني) / انبعاج, تقعر (شكل ينحني أو يتقوس إلى الداخل)",
 "incurvature": "انبعاج, تقعر (شكل ينحني أو يتقوس إلى الداخل)",
 "incurved": "مُقَعَّر, مُنْحَنٍ لِلدَّاخِل (مثنيّ أو منحنٍ نحو الداخل)",
 "incus": "سندان (عظم صغير في الأذن الوسطى يقع بين المطرقة والركاب)",
 "indaba": "إِنْدَابَا (مجلس تلتقي فيه الشعوب الأصلية في جنوب إفريقيا لمناقشة مسألة مهمة)",
 "indapamide": "إنداباميد (مدر للبول (الاسم التجاري لوزال) يستخدم في علاج ارتفاع ضغط الدم)",
 "indebtedness": "الْتِزَام, دَيْن (علاقة شخصية يكون فيها المرء مدينًا بخدمة أو معروف) / التزام مالي, دين (التزام بدفع المال لطرف آخر)",
 "indecency": "خدش للحياء, فعل غير لائق (فعل غير لائق أو خادش للحياء) / خدش للحياء, فحش (جودة كون الشيء غير محتشم)",
 "indecent": "بذيء, غير لائق (مسيء للذوق العام خاصة في المسائل الجنسية) / فَاحِش, مُخِلٌّ بِالحَيَاء (يُسِيءُ إِلَى الآدَابِ الأَخْلَاقِيَّةِ فِي السُّلُوكِ أَوِ المَظْهَر) / غَيْر لَائِق, مُنَافٍ لِلآدَاب (لا يتوافق مع المعايير المقبولة للسلوك اللائق في المجتمع المهذّب)\nمثال: قصة واقعية لكنها ليست فاحشة",
 "indecent exposure": "تعري علني, فعل فاضح علني (العري المبتذل والمسيء في مكان عام)",
 "indecently": "بِشَكْل غَيْر لَائِق, بِفُحْش (بطريقة غير لائقة)\nمثال: كانت ترتدي ملابس غير لائقة",
 "indecipherable": "غَيْرُ قَابِلٍ لِلتَّفْسِير, مُسْتَعْصٍ عَلَى الفَكّ (يستحيل تحديد معناه أو تفسيره) / غَيْر مَقْرُوء, مُسْتَغْلَق (يَتَعَذَّر قِراءَتُه أَوْ فَكّ رُموزِه)",
 "indecision": "تَرَدُّد (الذهاب إلى المكان مرة أخرى إلى نفس المكان بصورة متكررة؛ عدم الاستقرار على رأي معين)\nمثال: قبل ماثيو بتردد.",
 "indecisive": "غَيْر حَاسِم, مُتَرَدِّد (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "indecisively": "بِشَكْل غَيْر قَاطِع, دُونَ حَسْم (بدون نهائية؛ بشكل غير حاسم) / بِتَرَدُّد, دُونَ حَزْم (الافتقار إلى الحزم أو التصميم)\nمثال: انتهت المعركة دون حسم: لم يفز أي من الجانبين بوضوح لكن لم يعترف أي منهما بالهزيمة",
 "indecisiveness": "تذبذب, عجز عن الحسم (سمة التردد؛ نقص في صلابة الشخصية أو الغرض) / تردد, عدم حزم (شك يتعلق ببديلين أو أكثر من البدائل أو مسارات العمل الممكنة)\nمثال: تسبب تردد الملك غير القابل للشفاء في اضطراب في بلاطه",
 "indeclinable": "مَبْنِيٌّ, غَيْرُ مُتَمَكِّنٍ",
 "indecorous": "غير لائق, مخل باللياقة (يفتقر إلى اللياقة والذوق السليم في الأخلاق والسلوك) / غَيْر لَائِق, مُنَافٍ لِلآدَاب (لا يتوافق مع المعايير المقبولة للسلوك اللائق في المجتمع المهذّب)\nمثال: سلوك غير لائق",
 "indecorously": "بِشَكْل غَيْر لَائِق, دُونَ لِيَاقَة (بدون لياقة)",
 "indecorousness": "إخلال بالذوق (نقص الوقار)",
 "indecorum": "تبسط غير لائق, تطاول (فعل ينطوي على حميمية غير لائقة) / إخلال بالذوق (نقص الوقار)",
 "indeed": "بالفعل, حقاً ((تستخدم كصيغة تعجب) تعبير عن الدهشة أو الشك أو السخرية وما إلى ذلك) / بالفعل, جداً (في الحقيقة (غالباً ما تميل إلى التوكيد))\nمثال: يريد الزواج من رئيس الخدم؟ حقاً!",
 "indefatigability": "عدم كلل (تصميم لا يكل)",
 "indefatigable": "لَا يَتْعَبُ (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: لا أحب المدرسة.",
 "indefatigableness": "عدم كلل (تصميم لا يكل)",
 "indefatigably": "بشكل دؤوب, بلا كلل (بطاقة لا تكل)\nمثال: شاهدت العرض بلا كلل",
 "indefeasible": "غير قابل للإبطال, لا يسقط (غير قابل للإلغاء أو الإبطال أو النقض)\nمثال: حق غير قابل للإبطال في الحرية",
 "indefensible": "غَيْرُ مُبَرَّر, لَا يُسَوَّغ (غَيْرُ قَابِلٍ لِلتَّبْرِيرِ أَوِ التَّفْسِير) / لَا يُحْتَجُّ بِهِ, لَا يُمْكِنُ الدِّفَاعُ عَنْهُ ((عن النظريات وغيرها) لا يمكن الدفاع عنه أو تبريره) / لَا يُمْكِنُ الدِّفَاعُ عَنْه (غَيْرُ قَابِلٍ لِلْحِمَايَةِ مِنَ الهُجُوم)",
 "indefinability": "اسْتِعْصَاء عَلَى التَّعْرِيف (صفة عدم القدرة على التحديد الدقيق أو الوصف بالكلمات)",
 "indefinable": "عَصِيٌّ عَلَى الوَصْف, غَيْرُ قَابِلٍ لِلتَّعْرِيف (لَا يُمْكِنُ وَصْفُهُ أَوْ تَحْدِيدُهُ بِدِقَّة؛ يَصْعُبُ التَّعْبِيرُ عَنْهُ بِالكَلِمَات) / لَا يُوصَف, يَفُوق الوَصْف (يتحدى التعبير اللغوي أو الوصف؛ لا تسعه الكلمات)",
 "indefinite": "نَكِرَة",
 "indefinite article": "أَدَاةُ تَنْكِير, أَدَاةُ نَكِرَة",
 "indefinite integral": "تَكَامُل غَيْر مُحَدَّد",
 "indefinite numeral": "عدد مبهم (لفظ عددي لا يحدد رقماً دقيقاً)\nمثال: 'معظم' هي صفة عددية غير محددة تدل على جزء من الكل",
 "indefinite pronoun": "ضمير مبهم ((نحو) ضمير ليس له مرجع محدد، مثل 'شخص ما' أو 'أي أحد')",
 "indefinite quantity": "كمية غير محددة, مقدار تقديري (كمية تقديرية)",
 "indefinitely": "إلى أجل غير مسمى (إلى حد غير محدد؛ لفترة غير محددة)\nمثال: يمكن أن يستمر هذا إلى أجل غير مسمى",
 "indefiniteness": "إِبْهَام, عَدَم تَحْدِيد (صفة كون الشيء غامضاً وغير محدد بشكل جيد)",
 "indefinity": "إِبْهَام, عَدَم تَحْدِيد (صفة كون الشيء غامضاً وغير محدد بشكل جيد)",
 "indehiscent": "غير متفتح ((عن الفواكه) لا ينفتح تلقائياً عند النضج لإطلاق البذور)",
 "indelibility": "رسوخ, عدم القابلية للمحو (جودة كون الشيء صعب الحذف أو الإزالة أو الغسل أو الطمس أو المحو)\nمثال: موضوعه الرئيسي هو الطبيعة العابرة والمهملة للثقافة المعاصرة، والتي تتناقض بشكل صارخ مع ديمومة ورسوخ الطلاء الزيتي على القماش",
 "indelible": "رَاسِخ, لَا يُمْحَى (لا يمكن إزالته أو محوه)",
 "indelible ink": "حبر لا يمحى (حبر لا يمكن مسحه أو غسله)",
 "indelibly": "بشكل لا يمحى (بطريقة لا يمكن إزالتها)\nمثال: تركت هذه التقاليد بصماتها بشكل لا يمحى على النسيج الاجتماعي والسياسي والتعليمي والصناعي لهذا البلد",
 "indelicacy": "بذاءة, غلظة (فعل أو تعبير غير مهذب) / عدم ذوق, فجاجة (سمة كون المرء فجاً ومهيناً)",
 "indelicate": "غَيْرُ رَقِيق, قَرِيبٌ مِنَ البَذَاءَةِ (يقترب من الفحش وعدم اللياقة) / غير لائق, مخل باللياقة (يفتقر إلى اللياقة والذوق السليم في الأخلاق والسلوك) / خَادِشٌ لِلحَيَاء, سُوقِيّ (يَنْتَهِكُ الذَّوْقَ السَّلِيمَ وَيَقْتَرِبُ مِنَ الفُحْش)\nمثال: سلوك غير لائق",
 "indemnification": "تعويض الضرر (فعل التعويض عن خسارة فعلية أو ضرر أو عن المشاكل والإزعاج) / تعويضات, غرامة تعويضية (مبلغ من المال يُدفع كتعويض عن خسارة أو إصابة)",
 "indemnity": "تعويضات, غرامة تعويضية (مبلغ من المال يُدفع كتعويض عن خسارة أو إصابة) / تعويض, ضمانة (إعفاء قانوني من المسؤولية عن الأضرار) / تأمين, ضمان (حماية ضد الخسارة المستقبلية)",
 "indene": "إيندين (هيدروكربون سائل عديم اللون يستخرج من البترول أو قطران الفحم ويستخدم في صنع الراتنجات الاصطناعية)",
 "indent": "مسافة بادئة (المسافة المتروكة بين الهامش وبداية سطر تمت إزاحته) / طلبية بضائع (طلب لبضائع ليتم تصديرها أو استيرادها)",
 "indentation": "تحزيز, تسنين (عملية القطع في حافة بشقوق تشبه الأسنان أو شقوق زاوية) / مسافة بادئة (المسافة المتروكة بين الهامش وبداية سطر تمت إزاحته) / تخشّن, تنقر (تشكل نقر صغيرة في سطح ما نتيجة للتآكل) / انبعاج, ثلمة (قطع مقعر في سطح أو حافة (كما في الخط الساحلي))",
 "indented cylinder": "فاصل أسطواني مسنن (آلة لفصل الحبوب حسب طول الحبة)",
 "indented cylinder separator": "فاصل أسطواني مسنن (آلة لفصل الحبوب حسب طول الحبة)",
 "indention": "مسافة بادئة (المسافة المتروكة بين الهامش وبداية سطر تمت إزاحته)",
 "indenture": "مسافة بادئة (المسافة المتروكة بين الهامش وبداية سطر تمت إزاحته) / عقد خدمة ملزم (عقد يلزم طرفاً بخدمة طرف آخر لفترة محددة) / عقد إصدار السندات (اتفاق رسمي بين مُصدر السندات وحاملي السندات فيما يتعلق بشروط الدين) / انبعاج, ثلمة (قطع مقعر في سطح أو حافة (كما في الخط الساحلي))",
 "indentured": "مُتَعَاقِد, مُلْزَم بِعَقْد (مُقَيَّد بِمُوجَب عَقْد)",
 "independence": "اِسْتِقْلَال (التحرر من السيطرة أو الاعتماد على الغير، سواء كان ذلك فرديًا أو جماعيًا؛ التمتع بالاكتفاء الذاتي والقدرة على اتخاذ القرارات دون تدخل خارجي)\nمثال: الصحراويون يريدون الاستقلال.",
 "independence day": "يَوْم الاِسْتِقْلَال, عِيد الاِسْتِقْلَال (فترة من الزمان تبدأ عند غُرُوب الشمس وتنتهي عند غُرُوب شمس النهار التالي ويشمل اللَيْلَة ونَهَارا. طوله أربع وعشرين سَاعَة؛ النَهَار، يبدأ من طلوع الفَجْر إلى غُرُوب الشَمس، على المجاز)\nمثال: طقس اليوم جميل.",
 "independency": "استقلال (التحرر من سيطرة أو نفوذ شخص أو جهة أخرى)",
 "independent": "مُسْتَقِل, حُرّ (اسم فاعل مِن اِسْتَقَلَّ؛ من لا يعتمد على غيره)\nمثال: الجزائر مستقلة الآن.",
 "independent agency": "وكالة مستقلة (وكالة تابعة لحكومة الولايات المتحدة يتم إنشاؤها بموجب قانون من الكونغرس وتكون مستقلة عن الإدارات التنفيذية)",
 "independent clause": "جملة رئيسية, جملة مستقلة (جملة في جملة معقدة يمكن أن تقف وحدها كجملة كاملة)",
 "independent variable": "متغير تجريبي, متغير مستقل ((إحصاء) متغير تكون قيمه مستقلة عن التغيرات في قيم المتغيرات الأخرى)",
 "independently": "بشكل مستقل (بمفردك؛ دون مساعدة خارجية) / بشكل مستقل, فرادى (بشكل فردي أو منفصل)\nمثال: عمل الأطفال على المشروع بشكل مستقل",
 "inderal": "إندرال, بروبرانولول (أول حاصر لبيتا (الاسم التجاري إندرال) يستخدم في علاج ارتفاع ضغط الدم والذبحة الصدرية والرعاش الأساسي)",
 "indescribability": "تَعَذُّر الوَصْف (الصفة أو الحالة التي يكون فيها الوصف مستحيلاً أو صعباً للغاية)",
 "indescribable": "لَا يُوصَف, يَفُوق الوَصْف (يتحدى التعبير اللغوي أو الوصف؛ لا تسعه الكلمات)",
 "indescribableness": "تَعَذُّر الوَصْف (الصفة أو الحالة التي يكون فيها الوصف مستحيلاً أو صعباً للغاية)",
 "indescribably": "بشكل لا يوصف, بشكل يعجز عنه الوصف (لدرجة لا يمكن التعبير عنها)\nمثال: بدت صغيرة جداً الليلة، وكعادتها، جميلة بشكل لا يوصف، في فستان بسيط مكشوف الكتفين من القطن الحريري الأخضر والأبيض",
 "indestructibility": "عدم قابلية التدمير (القوة لمقاومة الدمار)",
 "indestructible": "غير قابل للتدمير (ليس من السهل تدميره) / بَاقٍ, عَصِيّ عَلَى الفَنَاء (يدوم مدّة طويلة جدًّا)",
 "indeterminable": "غَيْر قَابِل لِلتَّحْدِيد (لَا يُمْكِن التَّثَبُّت مِنْه أَوْ حِسَابُه بِشَكْلٍ قَاطِع) / غير قابل للتحديد (غير قادر على أن يتم تقريره أو التأكد منه بشكل قاطع)",
 "indeterminably": "بشكل غير محدد, بشكل مبهم (بطريقة غير قابلة للتحديد)\nمثال: كانت علاقتهما ذات طبيعة غامضة بشكل غير محدد",
 "indeterminacy": "إِبْهَام, عَدَم تَحْدِيد (صفة كون الشيء غامضاً وغير محدد بشكل جيد)",
 "indeterminacy principle": "مبدأ الريبة, مبدأ عدم اليقين ((نظرية الكم) النظرية القائلة بأنه من المستحيل قياس كل من الطاقة والوقت (أو الموقع والزخم) بدقة كاملة في نفس الوقت)",
 "indeterminate": "غَيْرُ مُحَدَّدٍ, مُبْهَم (لَا يُفْضِي إِلَى نِهَايَةٍ أَوْ نَتِيجَةٍ حَاسِمَةٍ) / غَيْرُ مُحَدَّد ((عَنْ كَمِّيَّةٍ) لَيْسَ لَهَا قِيمَةٌ مُحَدَّدَة؛ كَمُعَادَلَةٍ لَا يُمْكِنُ حَلُّهَا) / غير محدد, غير مقرر (غير محدد أو مقرر بدقة؛ غير ثابت أو معروف مسبقاً) / غير محدود النمو ((في النبات) لديه قدرة على الاستمرار في النمو عند القمة)\nمثال: من عمر غير محدد",
 "indeterminateness": "إِبْهَام, عَدَم تَحْدِيد (صفة كون الشيء غامضاً وغير محدد بشكل جيد)",
 "indetermination": "إِبْهَام, عَدَم تَحْدِيد (صفة كون الشيء غامضاً وغير محدد بشكل جيد)",
 "index": "دَلِيل, فِهْرِس / فِهْرِس (كِتَاب تجمع فيه أسماء الكتب بترتيب يسهل منه إجاد العنوان المراد البحث عنه؛ فَصْل أو بَاب في أول أو آخر الكتاب ترتب فيه الأبواب والفصول ومواضعها ليسهل منه إيجاد المطلوب)",
 "index case": "الحالَة الدَّالَّة, الحالَة المُؤَشِّرَة (أول حالة موثقة لمرض يتم إدراجها في دراسة وبائية)",
 "index finger": "سبابة (الإصبع المجاور للإبهام)",
 "index fossil": "أحفورة مرشدة (أحفورة معروفة بأنها عاشت في عصر جيولوجي معين ويمكن استخدامها لتأريخ طبقة الصخور التي توجد فيها)",
 "index fund": "صندوق مؤشرات (صندوق استثمار مشترك يستثمر في الأسهم التي تشكل أساس مؤشر أسهم أو سندات معروف) / صندوق مؤشر (صندوق استثمار مشترك أصوله عبارة عن أسهم مدرجة في قائمة معينة)",
 "index number": "مؤشر (رقم أو نسبة (قيمة على مقياس القياس) مشتقة من سلسلة من الحقائق المرصودة؛ يمكن أن تكشف عن التغيرات النسبية كدالة للوقت)",
 "index of refraction": "مُؤَشِّر الِانْكِسَار, مُعَامِل الِانْكِسَار (نسبة سرعة الضوء في الفراغ إلى سرعته في وسط ما)",
 "index register": "سجل الفهرس ((في علم الحاسوب) سجل يستخدم لتحديد عنوان المعامل)",
 "indexation": "ربط بمؤشر, مقايسة (نظام للتنظيم الاقتصادي: يتم ربط الأجور والفائدة بمؤشر تكلفة المعيشة لتقليل آثار التضخم)",
 "indexer": "مُفَهْرِس, واضع الفهارس (شخص يقوم بإعداد وتوفير الفهارس)",
 "indexical": "إشاري, مؤشري (من أو يتعلق بالمؤشر أو يعمل كفهرس)",
 "indexing": "فهرسة (فعل تصنيف وتوفير فهرس لجعل العناصر أسهل في الاسترجاع)",
 "indexless": "غير مفهرس (يفتقر إلى فهرس أو مؤشر)",
 "india": "الْهِنْد, الهند (في جنوب قارة آسيا؛ اسمها الرسمي جمهورية الهند، وعاصمتها نيودلهي)\nمثال: يبدو أنك من الهند.",
 "india ink": "حبر صيني, حبر هندي (حبر سائل أسود يستخدم للطباعة أو الكتابة أو الرسم)",
 "india paper": "ورق هندي (ورق رقيق قوي غير شفاف يستخدم في الكتب الفاخرة)",
 "india rubber": "مطاط, مطاط طبيعي (مادة مرنة يتم الحصول عليها من عصارة اللاتكس للأشجار (خاصة أشجار جنس الهيفيا والفيكس) والتي يمكن معالجتها بالكبريت وتشطيبها في مجموعة متنوعة من…)",
 "india-rubber fig": "شجرة المطاط, فيكس (شجرة آسيوية استوائية كبيرة تقزم غالباً كنبات منزلي؛ مصدر لمطاط آسام)",
 "india-rubber plant": "شجرة المطاط, فيكس (شجرة آسيوية استوائية كبيرة تقزم غالباً كنبات منزلي؛ مصدر لمطاط آسام)",
 "india-rubber tree": "شجرة المطاط, فيكس (شجرة آسيوية استوائية كبيرة تقزم غالباً كنبات منزلي؛ مصدر لمطاط آسام)",
 "indiaman": "سفينة الهند الشرقية (سفينة شراعية كبيرة كانت تعمل في التجارة البريطانية مع الهند)",
 "indian": "هِنْدِيّ (المنسوب إلى الهِنْد)",
 "indian agent": "وكيل الشؤون الهندية (ممثل للحكومة الفيدرالية لدى قبائل الهنود الحمر (خاصة في المحميات))",
 "indian arrowroot": "أروروت هندي, تاكا (عشب معمر من جزر الهند الشرقية إلى بولينيزيا وأستراليا؛ يزرع لجذره الكبير الصالح للأكل الذي ينتج نشا أروروت تاهيتي)",
 "indian banyan": "بانيان, تين هندي (شجرة من شرق الهند تخرج جذوراً هوائية تنمو لأسفل في التربة مشكلة جذوعاً إضافية)",
 "indian bean": "فاصوليا هندية, فول مصري (كرمة معمرة ملتفة من المناطق الاستوائية في العالم القديم لها أوراق ثلاثية وعناقيد من زهور تشبه البازلاء الأرجوانية العطرة تليها قرون عنابية من بذور…) / فول هندي, كتلبة (شجرة من جنس كتلبة ذات أوراق كبيرة وزهور بيضاء تليها قرون رفيعة طويلة)",
 "indian beech": "بونجاميا, زان هندي (شجرة آسيوية دائمة الخضرة لها أوراق ريشية لامعة وزهور عنقودية بيضاء كريمية عطرة؛ تستخدم كشجرة ظل)",
 "indian beet": "ترمس بري, ترمس معمر (نبات معمر قوي من شرق ووسط أمريكا الشمالية له أوراق كفية وزهور زرقاء عنقودية مبهرجة)",
 "indian blackwood": "خشب أسود هندي, خشب الورد الهندي (شجرة من شرق الهند لها خشب أرجواني داكن مفيد)",
 "indian blanket": "زهرة البطانية, عجلة النار (نبات حولي من وسط الولايات المتحدة له رؤوس زهور صفراء مبهرجة طويلة الساق معلمة باللون القرمزي أو الأرجواني في المركز)",
 "indian breadroot": "جذر الخبز, سوراليا (نبات معمر كثيف الشعر في وسط أمريكا الشمالية له جذور درنية صالحة للأكل)",
 "indian buffalo": "الجاموس الهندي (جاموس المرتفعات في شرق آسيا حيث لا يزدهر الجاموس المائي الحقيقي؛ يستخدم للجر والحليب)",
 "indian button fern": "سرخس الزر الهندي (سرخس من آسيا الاستوائية له بصيلات مستديرة تشبه الأزرار)",
 "indian cherry": "كرز هندي, نبق كارولينا (شجيرة متساقطة الأوراق في شرق ووسط الولايات المتحدة ذات ثمار سوداء تشبه التوت؛ ذهبية صفراء في الخريف)",
 "indian chickweed": "عشبة البساط (عشب ضار حولي منبسط يشكل حصيرة له أوراق دائرية وأزهار بيضاء مخضرة صغيرة؛ واسع الانتشار في جميع أنحاء أمريكا الشمالية)",
 "indian chief": "زعيم الهنود الحمر (قائد مجموعة من الهنود الحمر)",
 "indian chieftain": "زعيم الهنود الحمر (قائد مجموعة من الهنود الحمر)",
 "indian chocolate": "أفينس أرجواني, أفينس مائي (نبات معمر منتصب من المنطقة المعتدلة الشمالية له أوراق ريشية وعدد قليل من الزهور المتدلية بكأس بني أرجواني وبتلات برتقالية ووردية)",
 "indian cholera": "كوليرا (عدوى معوية حادة ناجمة عن تناول مياه أو طعام ملوث)",
 "indian club": "صولجان تمرين (هراوة على شكل زجاجة تستخدم في التمارين الرياضية)",
 "indian cobra": "كوبرا هندية (كوبرا من أفريقيا الاستوائية وآسيا)",
 "indian coral tree": "شجرة المرجان الهندية (شجرة شائكة صغيرة إلى متوسطة الحجم من آسيا الاستوائية وشمال أستراليا لها عناقيد كثيفة من الزهور القرمزية أو القرمزية الداكنة وبذور سوداء)",
 "indian corn": "ذرة, ذرة شامية (عشبة حبوب سنوية طويلة تحمل حبات على أكواز كبيرة: تزرع على نطاق واسع في أمريكا في العديد من الأصناف؛ الحبوب الرئيسية في المكسيك وأمريكا الوسطى…)",
 "indian cress": "كبوسين كبير, لادن (نبات متسلق حولي قوي النمو له زهور كبيرة بجميع ظلال البرتقالي من الأحمر البرتقالي إلى البرتقالي المصفر وبذور تخلل وتستخدم مثل الكبر)",
 "indian crocus": "زعفران هندي (أي من عدة بساتين فاكهة قزمة من جنس بليون تحمل زهرة أو زهرتين وحيدتين بيضاء أو وردية إلى أرجوانية أو صفراء أحياناً بسيقان نحيلة)",
 "indian currant": "توت المرجان, كشمش هندي (شجيرة نفضية من أمريكا الشمالية تزرع لعناقيدها الغزيرة من الثمار الحمراء المرجانية الشبيهة بالتوت)",
 "indian elephant": "فيل آسيوي, فيل هندي (فيل آسيوي له آذان أصغر وأنياب توجد أساساً لدى الذكور)",
 "indian file": "رتل, طابور فردي (خط من الأشخاص أو الأشياء مرتبة واحداً خلف الآخر)",
 "indian giver": "من يسترد هديته (مصطلح مسيء لشخص يطلب استعادة هدية كان قد قدمها)",
 "indian grackle": "مينة التل (زرزور آسيوي أسود لامع غالباً ما يُعلم تقليد الكلام)",
 "indian hemp": "دفل كندي, قنب هندي (دفل كندي ينتج أليافاً قوية يستخدمها الأمريكيون الأصليون كحبال؛ يستخدم في الطب الشعبي لألم المفاصل أو الالتهابات) / تيل, كيناف (نبات ليفي قيم من جزر الهند الشرقية واسع الانتشار الآن في الزراعة) / قنب هندي (مصدر للبانج والحشيش وكذلك الألياف)",
 "indian language": "اللغة الأمرندية, لغة السكان الأصليين للأمريكيتين (أي من اللغات التي يتحدث بها السكان الأصليون للأمريكيتين (الهنود الحمر))",
 "indian lettuce": "خس هندي, مونتيا (نبات من جنس مونتيا له أوراق صالحة للأكل ذات مذاق لطيف)",
 "indian lodge": "كوخ هندي (أي من مساكن الهنود الحمر المتنوعة)",
 "indian lotus": "لوتس, لوتس مقدس (موطنه شرق آسيا؛ يزرع على نطاق واسع لأزهاره الكبيرة الوردية أو البيضاء)",
 "indian madder": "فوة هندية, منجيت (عشب زاحف أو متسلق معمر من شرق الهند يستخدم للصباغة في الشرق)",
 "indian mallow": "أبو طيلون, خبازة هندية (عشب حولي طويل أو شجيرة صغيرة من آسيا الاستوائية بأوراق مخملية وزهور صفراء وينتج أليافاً قوية) / خبازة هندية, سيدا شائكة (عشب ضار أمريكي استوائي له زهور صفراء شاحبة أو برتقالية توطن في جنوب الولايات المتحدة)",
 "indian meal": "دقيق الذرة (ذرة مطحونة بشكل خشن)",
 "indian millet": "أرز الجبل, عشب الحرير (عشب علفي قيم في المناطق المرتفعة الجافة وسهول غرب أمريكا الشمالية إلى شمال المكسيك) / درة, ذرة بيضاء (سورغم المناطق الجافة في آسيا وشمال أفريقيا)",
 "indian monetary unit": "وحدة نقدية هندية (الوحدة النقدية في الهند)",
 "indian mongoose": "نمس هندي (حيوان زبادي حاد البصر من جنوب آسيا بحجم النمس تقريباً؛ غالباً ما يُستأنس)",
 "indian mustard": "أوراق الخردل, خردل (أوراق تؤكل مطبوخة) / خردل صيني, خردل هندي (خردل آسيوي يستخدم كعشب وعائي)",
 "indian myna": "مينَة شائعَة",
 "indian ocean": "الْمُحِيط الْهِنْدِيّ",
 "indian paint": "رجل الوزة رأسي, فراولة السرمق (حولي أوروبي ذو عناقيد من الزهور المخضرة تليها ثمار حمراء لبية تشبه التوت؛ متوطن في أمريكا الشمالية) / بوكون أشيب, ليثوسبيرموم أشيب (نبات معمر في أمريكا الشمالية بأوراق مشعرة رمادية تنتج صبغة حمراء أو صفراء)",
 "indian paintbrush": "فرشاة الرسم الهندية, كاستيخا / صقلاب درني, عشبة الفراشة (نبات معمر منتصب من شرق وجنوب الولايات المتحدة له زهور برتقالية بارزة)",
 "indian pea": "بيقية هندية, جلبان (نبات حولي أوروبي يزرع للعلف؛ تستخدم بذوره كغذاء في الهند وعلف للماشية في أماكن أخرى)",
 "indian pink": "زهرة الكاردينال, لوبيليا حمراء (لوبيليا من أمريكا الشمالية ذات أزهار حمراء رائعة) / أثمان ريشي, كرمة السرو (متسلق حولي أمريكي استوائي له زهور حمراء (وأحياناً بيضاء) وأوراق مقطعة بدقة؛ تم توطينه في الولايات المتحدة وأماكن أخرى)",
 "indian pipe": "زهرة الشمع, غليون هندي (نبات غابات رمي صغير شمعي أبيض أو وردي مبيض له أوراق تشبه القشور وزهرة متدلية؛ يتحول إلى الأسود مع التقدم في العمر)",
 "indian plantain": "كاكاليا, لسان الحمل الهندي",
 "indian poke": "صبغة هندية (نبات الصبغة من جنوب شرق آسيا والصين) / خربق أبيض, خربق أمريكي (نبات من أمريكا الشمالية له أوراق كبيرة وزهور خضراء مصفرة تنمو في عناقيد؛ ينتج قلويداً ساماً يستخدم طبياً)",
 "indian pony": "كايوس (حصان مراعي محلي صغير)",
 "indian potato": "بطاطس هندية, عباد شمس عملاق (نبات معمر أمريكي طويل جداً في وسط وشرق الولايات المتحدة إلى كندا ذو جذور درنية صالحة للأكل) / أبيوس, بطاطس هندية (كرمة من أمريكا الشمالية ذات أزهار عطرة ودرنات صالحة للأكل؛ محصول غذائي مهم للأمريكيين الأصليين)",
 "indian python": "بايثون هندي (بايثون كبير جداً يعيش في جنوب شرق آسيا)",
 "indian rat snake": "ثعبان الجرذ الهندي (يدخل المباني سعياً وراء الفريسة)",
 "indian rattlebox": "صندوق الخشخشة الهندي (شجيرة فرعية منتصبة ذات أزهار مشوبة بالأرجواني وقرن منتفخ تخشخش فيه البذور الناضجة؛ الهند)",
 "indian red": "أحمر هندي (لون بني محمر يشبه التربة الحمراء) / تربة حمراء هندية (تربة حمراء تحتوي على أكسيد الحديديك؛ تستخدم غالباً كخضاب) / أحمر هندي (خضاب أحمر يتكون جزئياً من أكسيد الحديديك ويستخدم غالباً في الدهانات ومستحضرات التجميل)",
 "indian relish": "تشاتني (تابل حار مصنوع من الفواكه أو الخضروات المفرومة المطبوخة في الخل والسكر مع الزنجبيل والتوابل)",
 "indian reservation": "محمية هندية (محمية مخصصة لاستخدام الهنود الحمر (السكان الأصليين))",
 "indian rhinoceros": "وحيد القرن الهندي (له قرن واحد)",
 "indian rhododendron": "رودودندرون هندي (شجيرة منتشرة دائمة الخضرة من الهند وجنوب شرق آسيا ذات أزهار أرجوانية كبيرة)",
 "indian rhubarb": "راوند الهيمالايا, راوند هندي (عشب آسيوي (من الهيمالايا)) / راوند هندي, نبات المظلة (عشب معمر جذموري بأوراق درعية درامية كبيرة وأزهار بيضاء إلى وردية زاهية في رؤوس مستديرة على سيقان خالية من الأوراق؛ يستعمر ضفاف الأنهار في سييرا…)",
 "indian rice": "أرز بري (حبوب عشب مائي من أمريكا الشمالية)",
 "indian rosewood": "خشب أسود هندي, خشب الورد الهندي (شجرة من شرق الهند لها خشب أرجواني داكن مفيد)",
 "indian rupee": "روبية, روبية هندية (وحدة المال الأساسية في الهند؛ تساوي 100 بيزة)",
 "indian salad": "هايدروفيلوم, ورقة الماء الفرجينية (عشب معمر بارز بزهور بيضاء؛ تستخدم أوراقه أحياناً كخضروات صالحة للأكل في جنوب شرق الولايات المتحدة)",
 "indian senna": "سنا إسكندراني, سنا مكي (شجيرة قائمة لها عناقيد من الزهور الصفراء السمراء؛ تستخدم الأوراق المجففة طبياً كمسهل؛ تصنف أحياناً في جنس كاسيا)",
 "indian shot": "أكيرا, كنا هندية (كنا تزرع خاصة لجذمورها الصالح للأكل الذي يتم الحصول منه على نشا الأروروت)",
 "indian summer": "صَيْف هِنْدِيّ (فصل من فصول السنة الأربعة، يلي الرَّبِيع ويأتي بعده الخَرِيف، يتميز بشدة الحَرّ)\nمثال: نأتي هنا كل صيف.",
 "indian tapir": "تابير ملايوي, تابير هندي (تابير يوجد في الملايو وسومطرة)",
 "indian tick fever": "حمى بوتونية, حمى مرسيليا (مرض تسببه الريكيتسيا وينتقل للبشر عن طريق القراد)",
 "indian tobacco": "تبغ هندي, لوبيليا منتفخة (لوبيليا برية من أمريكا الشمالية ذات أزهار زرقاء صغيرة وكبسولات منتفخة كانت تستخدم سابقاً كمضاد للتشنج) / تبغ بري, تبغ هندي (نبات تبغ من أمريكا الجنوبية والمكسيك)",
 "indian trail": "درب الهنود (مسار عبر البرية شكله الهنود الحمر)",
 "indian turnip": "أريسيما, لفت هندي (عشبة غابات أمريكية شائعة تزهر في الربيع ذات أوراق غمدية وطلع منتصب يشبه الهراوة مع قنابة خضراء وأرجوانية متقوسة تنتج توتاً قرمزياً)",
 "indiana": "إنديانا",
 "indianan": "إندياني (مواطن أو مقيم في إنديانا)",
 "indianapolis": "إِنْدِيَانَابُولِيس",
 "indic": "اللغات الهندية الآرية (فرع من عائلة اللغات الهندية الإيرانية)",
 "indicant": "مؤشر (رقم أو نسبة (قيمة على مقياس القياس) مشتقة من سلسلة من الحقائق المرصودة؛ يمكن أن تكشف عن التغيرات النسبية كدالة للوقت) / دلالة, علامة (شيء يخدم للدلالة أو الإيحاء)\nمثال: مؤشر على اللعب غير النظيف",
 "indicate": "دَلَّ عَلَى, رَمَزَ إِلَى (مَعِدَة، بَطْن؛ قَلْب)\nمثال: بدل سامي ملابسه.",
 "indication": "قراءة, قراءة العداد (بيان حول حالة فيزيائية معينة يتم تقديمه للمستخدم بواسطة عداد أو أداة مماثلة) / دَلَالَة, مُؤَشِّر (شيء (كمسار عمل) يشار إليه على أنه مناسب أو ضروري) / دلالة, علامة (شيء يخدم للدلالة أو الإيحاء) / استطباب, دعي الاستعمال ((طب) سبب لوصف دواء أو إجراء عملية)\nمثال: لم يصدق قراءة العداد",
 "indicative": "دَالّ, كَاشِف (يشير بوضوح أو يكشف؛ يُستخدَم عادة مع 'على') / تقريري, خبري (متعلق بصيغة الأفعال المستخدمة ببساطة في العبارات التقريرية) / الأُسْلُوب الخَبَرِيّ, صِيغَة خَبَرِيَّة (صيغة تمثل الفعل أو الحالة كحقيقة موضوعية)\nمثال: الصيغة الخبرية",
 "indicative mood": "مَرْفُوع",
 "indicator": "مُؤَشِّر",
 "indicator electrode": "قطب مؤشر (قطب كهربائي يستجيب لإشارة الإثارة دون التأثير على تكوين المحلول الذي يتم قياسه)\nمثال: يشكل القطب المؤشر نصف خلية كهروكيميائية مع الأيونات المعنية في محلول الاختبار",
 "indicator lamp": "مصباح بيان (مؤشر يتكون من ضوء للإشارة إلى ما إذا كانت الطاقة قيد التشغيل أو المحرك قيد التشغيل)",
 "indicatory": "دَالّ, كَاشِف (يشير بوضوح أو يكشف؛ يُستخدَم عادة مع 'على')",
 "indictability": "قابلية الاتهام, قابلية العزل (حالة الخضوع للمساءلة أو العزل)",
 "indictable": "خَاضِعٌ لِلْمُلَاحَقَة, قَابِلٌ لِلِاتِّهَام (يمكن توجيه الاتهام إليه أو ملاحقته قضائيًّا)",
 "indiction": "الإندكتيون, دورة الخمس عشرة سنة (دورة مدتها 15 سنة استخدمت كوحدة زمنية في روما القديمة واعتمدت في بعض الممالك في العصور الوسطى)",
 "indictment": "قرار اتهام, لائحة اتهام (وثيقة رسمية يكتبها مدع عام يتهم فيها شخصاً بجريمة ما) / اتهام, لائحة اتهام (اتهام بارتكاب مخالفات)\nمثال: الكتاب هو لائحة اتهام للفلسفة الحديثة",
 "indie": "مُسْتَقِلّ ((عَنِ الفِرَقِ المُوسِيقِيَّةِ) غَيْرُ مُنْتَسِبٍ لِشَرِكَةِ تَسْجِيلٍ كُبْرَى) / شركة إنتاج مستقلة (شركة أفلام مستقلة غير مرتبطة باستوديو كبير) / فرقة مستقلة (فرقة بوب غير تابعة لشركة تسجيلات كبرى)",
 "indie pop": "إِينْدِي بُوب",
 "indie rock": "إيندي روك, إندي روك",
 "indifference": "لَامُبَالَاة",
 "indifference curve": "منحنى السواء (في نظرية الاقتصاد الجزئي، رسم بياني يوضح مجموعات مختلفة من السلع التي يكون المستهلك غير مبالٍ بينها)",
 "indifferent": "غَيْرُ آبِهٍ, لَامُبَالٍ (لَا يُظْهِرُ أَيَّ اهْتِمَامٍ أَوْ عِنَايَةٍ فِي مَوْقِفِهِ أَوْ تَصَرُّفِهِ) / سِيَّان, لَا يَهُمّ ((غالبًا متبوع بـ 'لـ') لا أهمّيّة له؛ لا فرق بين خياراته) / فَاتِر, لَامُبَالٍ (يتّسم بانعدام الاهتمام) / وَسَطِيّ (لَيْسَ مُفْرِطًا وَلَا قَلِيلًا جِدًّا)",
 "indifferently": "بلامبالاة (مع اللامبالاة؛ بطريقة غير مبالية)\nمثال: هزت كتفيها بلامبالاة",
 "indigen": "ابن البلد, من السكان الأصليين (شخص من السكان الأصليين ولد في مكان معين)\nمثال: فن السكان الأصليين للساحل الشمالي الغربي",
 "indigence": "حاجة, ضيق ذات اليد (حالة من الفقر المدقع أو العدم)\nمثال: روعه عوزهم",
 "indigene": "ابن البلد, من السكان الأصليين (شخص من السكان الأصليين ولد في مكان معين)\nمثال: فن السكان الأصليين للساحل الشمالي الغربي",
 "indigenous": "أَصْلِيّ",
 "indigenous language": "لغة أصلية, لغة محلية (لغة نشأت في مكان محدد ولم يتم جلبها إلى ذلك المكان من مكان آخر)",
 "indigenously": "بشكل أصلي (بطريقة أصلية (بالمعنى السكاني))",
 "indigenousness": "أَصَالَة, تَوَطُّن (الأصلية بحكم النشأة أو الحدوث الطبيعي (كما في مكان معين))",
 "indigent": "مُعْدَم, مُعْوِز (فقير لدرجة الحاجة إلى مساعدة الآخرين)",
 "indigestibility": "عدم قابلية الهضم, عسر الهضم (خاصية صعوبة الهضم)",
 "indigestible": "عسير الهضم, غير قابل للهضم (يتم هضمه بصعوبة)",
 "indigestibleness": "عدم قابلية الهضم, عسر الهضم (خاصية صعوبة الهضم)",
 "indigestion": "عُسْر الهَضَم, تُخْمَة (جعَل شيئًا صعبًا أو أكثر تعقيدًا؛ وضع عوائق أو صعوبات أمام أمرٍ ما)\nمثال: إن مع العسر يسرا.",
 "indignant": "ساخط, ساخطة",
 "indignantly": "باستنكار, بسخط (بطريقة ساخطة)\nمثال: احتجت الآنسة بورني بسخط، وتحول أنفها الطويل الرفيع إلى اللون الوردي من الإذلال بسبب هذا التقليد غير المحترم",
 "indignation": "استنكار, سخط (شعور بالغضب المحق)",
 "indignity": "إذلال, مهانة (إهانة لكرامة المرء أو احترام الذات)",
 "indigo": "نِيلِيّ",
 "indigo bird": "درسة نيلية (طائر درسة صغير أزرق داكن من أمريكا الشمالية)",
 "indigo broom": "عشبة ذبابة الخيل, نيلة برية (عشبة منتصبة كثيرة التفرع ذات أزهار صفراء زاهية؛ موزعة من ماساتشوستس إلى فلوريدا)",
 "indigo bunting": "درسة نيلية (طائر درسة صغير أزرق داكن من أمريكا الشمالية)",
 "indigo finch": "درسة نيلية (طائر درسة صغير أزرق داكن من أمريكا الشمالية)",
 "indigo plant": "نبات النيلة, نيل (شجيرة نفضية فرعية من جنوب شرق آسيا لها أوراق ريشية وعناقيد من الزهور الحمراء أو الأرجوانية؛ مصدر لصبغة النيلة)",
 "indigo snake": "ثعبان نيلي (ثعبان كبير أزرق داكن غير سام يغزو الجحور؛ يوجد في جنوب أمريكا الشمالية والمكسيك)",
 "indigo squill": "كاماسيا شرقية, ياقوتية برية (كاماسيا شرقية؛ شرق ووسط أمريكا الشمالية)",
 "indigofera anil": "إنديجوفيرا, نيلة (شجيرة من جزر الهند الغربية وأمريكا الجنوبية تعد مصدراً لصبغة النيلة)",
 "indigofera suffruticosa": "إنديجوفيرا, نيلة (شجيرة من جزر الهند الغربية وأمريكا الجنوبية تعد مصدراً لصبغة النيلة)",
 "indigofera tinctoria": "نبات النيلة, نيل (شجيرة نفضية فرعية من جنوب شرق آسيا لها أوراق ريشية وعناقيد من الزهور الحمراء أو الأرجوانية؛ مصدر لصبغة النيلة)",
 "indigotin": "نيلة, نيلي (صبغة زرقاء يتم الحصول عليها من النباتات أو صنعها صناعياً)",
 "indinavir": "إندينافير, كريكسيفان (مثبط للبروتياز (الاسم التجاري كريكسيفان) يستخدم لعلاج فيروس نقص المناعة البشرية)",
 "indirect": "غير مباشر, ملتوٍ (غير مباشر في البعد المكاني؛ لا يؤدي بخط مستقيم أو مسار مباشر إلى وجهة) / ضمني, غير مباشر ((بالمعنى الموسع) غير مباشر في الأسلوب أو اللغة أو السلوك أو العمل) / غَيْر مُبَاشِر (لَهُ عَوَامِل أَوْ أَشْخَاص أَوْ تَأْثِيرَات وَسِيطَة) / جانبي, غير مباشر (منحدر من جد مشترك ولكن عبر خطوط مختلفة)\nمثال: أحياناً يوفر اتخاذ مسار غير مباشر الوقت",
 "indirect antonym": "ضد غير مباشر (الأضداد التي يكون التعارض بينها عبر وسيط (مثل التضاد بين 'رطب' و 'مُقفر' عبر تشابه 'مقفر' مع 'جاف'))",
 "indirect correlation": "ارتباط سالب, ارتباط عكسي (ارتباط ترتبط فيه القيم الكبيرة لمتغير واحد بقيم صغيرة للآخر)",
 "indirect discourse": "خطاب غير مباشر (تقرير عن حديث يتم فيه تعديل المصطلحات الإشارية بشكل مناسب (مثلاً: 'قال: أنا أحمق' تصبح 'قال إنه أحمق'))",
 "indirect evidence": "دليل ظرفي, قرينة (دليل يوفر فقط أساساً للاستنتاج حول الواقعة المتنازع عليها)",
 "indirect expression": "إطناب, تعبير غير مباشر (طريقة غير مباشرة للتعبير عن شيء ما)",
 "indirect fire": "نيران غير مباشرة (نيران توجه لهدف لا يستخدم هو نفسه كنقطة تصويب للأسلحة)",
 "indirect immunofluorescence": "تألق مناعي غير مباشر (طريقة لاستخدام الفحص المجهري التألقي للكشف عن وجود مستضد بشكل غير مباشر)",
 "indirect lighting": "إضاءة غير مباشرة (وحدة إضاءة مخفية)",
 "indirect object": "مفعول به غير مباشر (المفعول الذي هو المتلقي أو المستفيد من فعل الفعل)",
 "indirect request": "تمني, رغبة (تعبير عن رغبة أو ميل ما)\nمثال: استطعت أن أدرك أنها كانت رغبته في أن يغادر الضيوف",
 "indirect tax": "ضريبة غير مباشرة (ضريبة تفرض على السلع أو الخدمات بدلاً من الأشخاص أو المؤسسات)",
 "indirect transmission": "انْتِقَال غَيْرُ مُبَاشِر (آلية انتقال ينتقل فيها العامل المعدي إلى الشخص بواسطة أداة ملوثة أو ناقل)",
 "indirection": "التواء, مراوغة (عمل مخادع غير مباشر) / إجراء غير مباشر, التفاف (إجراء أو عمل غير مباشر)\nمثال: استطاع رؤية ما وراء مراوغات الدبلوماسيين",
 "indirectly": "بشكل غير مباشر (ليس بطريقة صريحة)\nمثال: أجاب بشكل غير مباشر للغاية",
 "indirectness": "التفاف, عدم مباشرة (خاصية الافتقار إلى المسار المباشر نحو الهدف)",
 "indiscernibility": "خَفَاء, عَدَم القَابِلِيَّة لِلتَّمْيِيز (حالة أو خاصية عدم القابلية للتمييز؛ عدم القدرة على الملاحظة)",
 "indiscernible": "غير مدرك, لا يمكن تمييزه (صعب أو مستحيل الإدراك أو التمييز) / خَفِيّ, غَيْرُ مَحْسُوس (بِالكَادِ يُمْكِنُ إِدْرَاكُه)\nمثال: زيادة غير محسوسة في درجة الحرارة",
 "indiscipline": "تسيب, عدم انضباط (سمة الافتقار للانضباط)",
 "indiscreet": "ثرثار (فاضح للأسرار), غير حكيم (يفتقر إلى الحكمة والتحفظ؛ طائش)\nمثال: كان سلوكها غير حكيم في أحسن الأحوال",
 "indiscreetly": "بتهور, دون تحفظ (بدون تقدير أو حكمة أو ضبط للنفس)\nمثال: استفسرت دون تحفظ عن حالته الصحية",
 "indiscreetness": "رعونة, سوء تقدير (الافتقار إلى الحكم الجيد)",
 "indiscrete": "غَيْر مُجَزَّأ, مُتَّصِل (غَيْر مُقَسَّم أَوْ مُجَزَّأ إِلَى أَجْزَاء)",
 "indiscretion": "زلة, هفوة (إساءة بسيطة) / رعونة, طيش (سمة الافتقار للحصافة)",
 "indiscriminate": "اعتباطي, عشوائي (لا يتميز بتمييزات دقيقة (يخلط الحابل بالنابل)) / عَشْوَائِيّ, غَيْر مُمَيِّز (يُخْفِق فِي التَّمْيِيز بَيْنَ الأَشْيَاء)\nمثال: عادات قراءة عشوائية",
 "indiscriminately": "بشكل عشوائي, دون تمييز (بطريقة عشوائية) / بشكل عشوائي, دون تمييز (بطريقة غير مميزة)\nمثال: كانت المنازل مبعثرة عشوائياً",
 "indiscriminating": "غير ذواق, غير مميز (غير قادر على التمييز أو الانتقاء)",
 "indispensability": "حيوية, ضرورة لا غنى عنها (الخاصية التي يمتلكها شيء لا يمكنك الاستغناء عنه بأي حال)",
 "indispensable": "حَتْمِيّ, لَا مَفَرَّ مِنْه (لا يمكن تجنّبه أو الاستغناء عنه) / ضروري, لا غنى عنه (لا يمكن الاستغناء عنه؛ أساسي) / جَوْهَرِيّ, لَا غِنَى عَنْه (ضروري حتمًا؛ لازم لزومًا حيويًّا)\nمثال: أطعمة لا غنى عنها للتغذية الجيدة",
 "indispensableness": "حيوية, ضرورة لا غنى عنها (الخاصية التي يمتلكها شيء لا يمكنك الاستغناء عنه بأي حال)",
 "indisposed": "عَلِيل, مُتَوَعِّك (يعاني من وعكة صحّيّة خفيفة أو معرَّض للمرض)",
 "indisposition": "تثاقل, تردد (درجة معينة من عدم الرغبة) / توعك (مرض خفيف)\nمثال: ممانعة في إلزام نفسه",
 "indisputability": "عَدَم قَابِلِيَّة الجَدَل, قَطْعِيَّة (صفة كون الشيء فوق الشك أو الجدال أو النزاع)",
 "indisputable": "أَكِيد, لَا جِدَال فِيه (يستحيل الشكّ فيه أو الاعتراض عليه) / لَا جِدَال فِيه, لَا يُنَازَع (لَا يَقْبَلُ الطَّعْنَ أَوِ الشَّكّ؛ صَحِيحٌ بِوُضُوح)",
 "indissoluble": "غَيْر قَابِل لِلْحَلّ, لَا يَنْفَكّ (يُستخدَم في وصف القرارات والعقود التي لا يمكن فسخها) / غير قابل للذوبان ((للمادة) غير قادر على الذوبان)",
 "indistinct": "غير مميز, غير واضح (غير محدد بوضوح أو ليس من السهل إدراكه أو فهمه)\nمثال: أشكال غير واضحة في الظلام",
 "indistinctly": "بشكل خافت, بشكل غامض (بطريقة خافتة غير واضحة)\nمثال: أدركنا التغيير بشكل غامض فقط",
 "indistinctness": "ضَبَابِيَّة, طَمْس (صفة كون الشيء غير واضح وبدون حدود حادة)",
 "indistinguishability": "تَطَابُق, تَمَاثُل تَامّ (التماثل التام)\nمثال: تشاطروا تطابقاً في المصالح",
 "indistinguishable": "غير متمايز, لا يمكن تمييزه (غير قادر على أن يتم تمييزه أو التفريق بينه وبين غيره) / لَا يُمَيَّز, مُتَطَابِق (متماثل تمامًا؛ لا يمكن إدراك أيّ فرق بينهما)\nمثال: العينتان في الواقع مختلفتان عن بعضهما البعض لكن الاختلافات تكاد لا يمكن تمييزها",
 "indium": "إِنْدِيُوم",
 "individual": "فَرْد, شَخْص",
 "individual retirement account": "حساب تقاعد فردي (خطة تقاعد تسمح لك بالمساهمة بمبلغ سنوي محدود للتقاعد؛ ويتم تأجيل الضرائب على الفوائد المكتسبة في الحساب)",
 "individualisation": "تفريد, تمييز الفرد (تمييز الفرد عن المجموعة العامة أو النوع)",
 "individualised": "مُخَصَّص, مُفَصَّل حَسَب الطَّلَب (مُعدّ أو مُوجَّه أو مُكيَّف لشخص بعينه)",
 "individualism": "فردانية",
 "individualist": "ذُو طَابَعٍ فَرْدِيّ, فَرْدَانِيّ (يتسم بالفردانية أو يعبّر عنها) / فرداني, مستقل (شخص يتبع فكراً أو عملاً مستقلاً)",
 "individualist anarchism": "لاسلطوية فردية (أي من التيارات الفكرية المتعددة داخل الحركة اللاسلطوية التي تؤكد على الفرد وإرادته فوق المحددات الخارجية مثل المجموعات والمجتمع والتقاليد)\nمثال: تقليدياً، اعتبرت اللاسلطوية الفردية نفسها جزءاً من اللاسلطوية اليسارية",
 "individualistic": "فَرْدَانِيّ, لِيبْرَالِيّ اقْتِصَادِيًّا (بِأَقَلّ قَدْر مِنَ القُيُود عَلَى حُرِّيَّة التِّجَارَة) / ذُو طَابَعٍ فَرْدِيّ, فَرْدَانِيّ (يتسم بالفردانية أو يعبّر عنها)",
 "individualistically": "بشكل فردي (بطريقة فردية)",
 "individuality": "هوية, هوية شخصية (الشخصية المتميزة للفرد باعتبارها كياناً مستمراً) / تفرد, فردية (صفة كون المرء فرداً)\nمثال: يمكن أن تفقد هويتك عند الانضمام للجيش",
 "individualization": "تفريد, تمييز الفرد (تمييز الفرد عن المجموعة العامة أو النوع)",
 "individualized": "مُخَصَّص, مُفَصَّل حَسَب الطَّلَب (مُعدّ أو مُوجَّه أو مُكيَّف لشخص بعينه)",
 "individually": "بشكل فردي, على حدة (بمعزل عن الآخرين)\nمثال: إذا أخذناها بشكل فردي، الغرف كانت مربعة",
 "individuation": "تفرد, فردية (صفة كون المرء فرداً) / تفريد, تمييز الفرد (تمييز الفرد عن المجموعة العامة أو النوع)\nمثال: منغمسة جداً في الحركة لدرجة أنها فقدت كل شعور بالفردية",
 "indivisibility": "عدم القابلية للقسمة ((في الحساب) حالة استحالة القسمة على عدد صحيح محدد دون ترك باقي)\nمثال: تعتمد أولية العدد على عدم قابلية كمية معينة للقسمة على ذلك العدد",
 "indivisible": "غير قابل للتجزئة, غير قابل للقسمة (من المستحيل أن يخضع للتقسيم)\nمثال: اتحاد ولايات غير قابل للانقسام",
 "indo-aryan": "هِنْدِيّ-آرِيّ",
 "indo-european": "هِنْدُوأُورُوبِّيَّة",
 "indo-european language": "اللغات الهندية الأوروبية (عائلة اللغات التي كان يتم التحدث بها بحلول عام 1000 قبل الميلاد في جميع أنحاء أوروبا وفي أجزاء من جنوب غرب وجنوب آسيا)",
 "indo-germanic": "هندو-أوروبي, هندو-جرماني (من أو متعلق بعائلة اللغات الهندو-أوروبية)",
 "indo-hittite": "اللغات الهندية الأوروبية (عائلة اللغات التي كان يتم التحدث بها بحلول عام 1000 قبل الميلاد في جميع أنحاء أوروبا وفي أجزاء من جنوب غرب وجنوب آسيا)",
 "indo-iranian": "اللغات الهندية الإيرانية (فرع من عائلة اللغات الهندية الأوروبية بما في ذلك مجموعات اللغات الهندية والإيرانية)",
 "indo-iranian language": "اللغات الهندية الإيرانية (فرع من عائلة اللغات الهندية الأوروبية بما في ذلك مجموعات اللغات الهندية والإيرانية)",
 "indochina": "اَلْهِنْد اَلصِّينِيَّة (في جنوب قارة آسيا؛ اسمها الرسمي جمهورية الهند، وعاصمتها نيودلهي)\nمثال: يبدو أنك من الهند.",
 "indocile": "جَامِح, مُتَمَرِّد (لا يمكن السيطرة عليه أو إخضاعه)",
 "indocin": "إندوسين, إندوميثاسين (دواء مضاد للالتهاب غير ستيرويدي (الاسم التجاري إندوسين))",
 "indoctrination": "أدلجة, تلقين عقائدي (تعليم شخص ما قبول العقائد دون نقد)",
 "indole": "إندول",
 "indoleacetic acid": "حمض إندول الأسيتيك (هرمون نباتي يعزز استطالة السيقان والجذور)",
 "indolebutyric acid": "حمض إندول الزبدة (هرمون نباتي اصطناعي يعزز استطالة السيقان والجذور)",
 "indolence": "بُطْء",
 "indolent": "بَطِيء النُّمُوّ ((عن الأورام مثلًا) بطيء في الشفاء أو التطوّر وعادةً غير مؤلم) / كَسُول, مُتَقَاعِس (غَيْر رَاغِب فِي العَمَل أَوِ الجُهْد)",
 "indolently": "بخمول, بكسل (بطريقة خاملة)\nمثال: يعيش بكسل مع أقاربه",
 "indomethacin": "إندوسين, إندوميثاسين (دواء مضاد للالتهاب غير ستيرويدي (الاسم التجاري إندوسين))",
 "indomitability": "قهر, منعة (خاصية كونه صعباً أو مستحيلاً هزيمته)",
 "indomitable": "عَصِيّ, لَا يُرْوَض (مُسْتَحِيلُ الإِخْضَاعِ أَوِ التَّطْوِيعِ)",
 "indonesia": "إِنْدُونِيسِيَا",
 "indonesian": "إِنْدُونِيسِيّ",
 "indonesian monetary unit": "وحدة نقدية إندونيسية (الوحدة النقدية في إندونيسيا)",
 "indoor": "دَاخِلِيّ (داخل الأبواب؛ في باطن المبنى)",
 "indoor garden": "حديقة داخلية, مشتل زجاجي (دفيئة يتم فيها ترتيب النباتات بطريقة مبهجة)",
 "indoors": "بالداخل, في الداخل (داخل مبنى)\nمثال: في الشتاء نلعب في الداخل",
 "indorsement": "إقرار, تزكية (فعل المصادقة أو التزكية) / تظهير, مصادقة (توقيع يثبت صحة شيء ما) / إقرار, تأييد (موافقة رسمية وصريحة) / تأييد, تثنية (حديث لتأييد أو تثنية اقتراح ما)\nمثال: يمكن للرياضي النجم أن يجني الكثير من المال من عقود التزكية",
 "indorser": "مُجَيِّر, مُظَهِّر (شخص ينقل ملكيته لشيء ما عن طريق التوقيع على شيك أو ورقة مالية قابلة للتداول) / مؤيد, مصادق (شخص يعبر عن موافقة قوية)",
 "indrawn": "مُنْطَوٍ, مُنْعَزِلٌ (يميل إلى الانطواء والتأمل الداخلي)",
 "indre": "أَنْدَر",
 "indri": "إندري شائع",
 "indri brevicaudatus": "إندري (ليمور كبير قصير الذيل من مدغشقر ذو فرو حريري كثيف باللونين الأسود والأبيض واللون الأسمر)",
 "indri indri": "إندري (ليمور كبير قصير الذيل من مدغشقر ذو فرو حريري كثيف باللونين الأسود والأبيض واللون الأسمر)",
 "indris": "إندري (ليمور كبير قصير الذيل من مدغشقر ذو فرو حريري كثيف باللونين الأسود والأبيض واللون الأسمر)",
 "indubitability": "عَدَم قَابِلِيَّة الجَدَل, قَطْعِيَّة (صفة كون الشيء فوق الشك أو الجدال أو النزاع)",
 "indubitable": "لَا رَيْبَ فِيه, لَا شَكَّ فِيه (واضح جدًّا بحيث لا يمكن الشكّ فيه)",
 "indubitably": "بلا شك, مما لا شك فيه (بطريقة أو درجة لا يمكن الشك فيها)\nمثال: كان من الظاهر فوراً ومما لا شك فيه أنني قاطعت مشهداً لعاشقين",
 "induced": "محدث, مستحث (تم إحداثه أو التسبب فيه؛ غير تلقائي)\nمثال: حالة ضعف ناجمة عن الستيرويد",
 "induced abortion": "إجهاض متعمد (إنهاء متعمد للحمل)",
 "inducement": "استحثاث, تحفيز (فعل تحقيق نتيجة مرغوبة) / تشجيع, حافز (تأثير تحفيزي إيجابي)\nمثال: استحثاث النوم",
 "inducer": "مُحَفِّز, حَاث",
 "inducing": "استحثاث, تحفيز (فعل تحقيق نتيجة مرغوبة)\nمثال: استحثاث النوم",
 "inducive": "اسْتِقْرَائِيّ, تَحْرِيضِيّ (يحثّ أو يؤثّر؛ يقود إلى فعلٍ ما)",
 "inductance": "محث (جهاز كهربائي (عادة ملف موصل) يدخل الحث في الدائرة) / تحريض, حث",
 "inductance unit": "وحدة محاثة (مقياس لخاصية الدائرة الكهربائية التي يتم بموجبها حث قوة دافعة كهربائية فيها)",
 "inductee": "مجند إلزامي, مكلف (شخص يتم تجنيده في الخدمة العسكرية (غالباً بشكل إلزامي)) / عُضْو جَدِيد, مُجَنَّد (شخص تم ضمه إلى منظمة أو مجموعة اجتماعية)\nمثال: كان تاي كوب وبيب روث من المجندين عام 1936 في قاعة مشاهير البيسبول الوطنية",
 "induction": "إطلاق, استحثاث (فعل يحرك سلسلة من الأحداث) / استحثاث, تحريض (فعل التسبب في حدوث شيء ما (خاصة في وقت مبكر)) / استدلال استقرائي, استقراء (الاستدلال من الحقائق التفصيلية إلى المبادئ العامة) / استثارة, استحثاث (تحفيز يستدعي (يستخرج) فئة معينة من السلوكيات)\nمثال: استحثاث حالة التخدير",
 "induction accelerator": "بيتاترون, معجل الحث (يسرع شعاعاً مستمراً من الإلكترونات إلى سرعات عالية عن طريق المجال الكهربائي الناتج عن تغير التدفق المغناطيسي)",
 "induction coil": "ملف حث (ملف لإنتاج جهد عالٍ من مصدر جهد منخفض)",
 "induction heating": "تسخين بالحث (تسخين مادة موصلة ناتج عن تيار كهربائي مستحث فيها)",
 "induction motor": "محرك تحريضي, محرك حثي (محرك كهربائي يعمل بالتيار المتردد يتم فيه الحصول على التيار الكهربائي في الجزء الدوار اللازم لإنتاج عزم الدوران عن طريق الحث الكهرومغناطيسي من المجال…)",
 "induction of labor": "تحريض الولادة, طلق صناعي ((طب التوليد) تحفيز عملية الولادة بشكل مصطنع عن طريق إعطاء الأوكسيتوسين أو بتمزيق الكيس الأمنيوسي)",
 "inductionism": "استقرائية (الفلسفة العلمية حيث يتم 'استقراء' القوانين من مجموعات البيانات)",
 "inductive": "اسْتِقْرَائِيّ, تَحْرِيضِيّ (يحثّ أو يؤثّر؛ يقود إلى فعلٍ ما) / استقرائي (للاستدلال؛ الانتقال من حقائق جزئية إلى استنتاج عام) / حثي (ناشئ عن الحث (الكهربائي))\nمثال: تفكير استقرائي",
 "inductive reasoning": "استدلال استقرائي, استقراء (الاستدلال من الحقائق التفصيلية إلى المبادئ العامة)",
 "inductor": "محث (جهاز كهربائي (عادة ملف موصل) يدخل الحث في الدائرة)",
 "indulgence": "صَكّ غُفْرَان",
 "indulgent": "مُتَسَامِح, مُتَسَاهِل (مَيَّال إِلَى التَّسَاهُل والقَبُول) / متسامح, متساهل (يتميز بـأو يميل إلى الاستجابة لرغبات شخص ما) / لَيِّن, مُتَسَامِح (متسامح ورحيم في المعاملة)\nمثال: أجداد متساهلون",
 "indulgently": "بتسامح, بتساهل (بطريقة متساهلة)\nمثال: نُصحت بتساهل بأن أعطي الأطفال ما يريدون ما لم أرغب في أن يتم نبذ ابني اجتماعياً",
 "indulging": "انغماس, تدليل (فعل الانغماس أو إشباع رغبة)",
 "indument": "زَغَب, كِسَاء (غطاء من الشعيرات الدقيقة (أو الحراشف أحياناً) كما في الأوراق أو الحشرات)",
 "indumentum": "زَغَب, كِسَاء (غطاء من الشعيرات الدقيقة (أو الحراشف أحياناً) كما في الأوراق أو الحشرات)",
 "indurate": "قَاسٍ, مُتَحَجِّر المَشَاعِر (متصلّب عاطفيًّا؛ فاقد للرقّة الإنسانية)",
 "indurated clay": "طين متصلب",
 "induration": "تصلب, قساوة (أي تصلب مرضي أو سماكة في الأنسجة)",
 "induration of the arteries": "تصلب الشرايين (تصلب جدران الشرايين)",
 "indus": "نَهْر الْسِنْد (صَارَ عَصَبِيًّا وغَضِبَ؛ أَصَابَ الشَّيْءَ أو الكَائِنَ بِغَضَبٍ أو صَارَ يَأْمُرُهُ)\nمثال: عبر جوناس النهر.",
 "indus civilization": "حضارة السند, حضارة وادي السند (ثقافة العصر البرونزي لوادي السند التي ازدهرت من حوالي 2600-1750 قبل الميلاد)",
 "indusial": "غطائي, قناعي (مكون من أو متعلق بـ أو كونه غطاءً (نباتي أو حيواني))",
 "indusium": "غِشاءُ البَوْغ, غِطَاء (غشاء يحيط بالأبواغ النامية ويحميها، خاصة ذلك الذي يغطي البثرات البوغية في السرخس)",
 "industrial": "صِنَاعِيّ",
 "industrial air pollution": "تلوث الهواء الصناعي (تلوث ناتج عن مصنع يطلق الملوثات في الغلاف الجوي)",
 "industrial arts": "فنون صناعية (دورة في طرق استخدام الأدوات والآلات كما تُدرس في المدارس الثانوية والمدارس الفنية)",
 "industrial bank": "بنك صناعي, شركة قروض صناعية (شركة تمويل تقدم قروضاً صغيرة للعمال الصناعيين)",
 "industrial disease": "مرض مهني (مرض أو إعاقة ناتجة عن ظروف العمل)",
 "industrial engineering": "إدارة صناعية, هندسة صناعية (فرع الهندسة الذي يتعامل مع إنشاء وإدارة الأنظمة التي تدمج الناس والمواد والطاقة بطرق منتجة)",
 "industrial enterprise": "تصنيع, تنمية صناعية (تطوير الصناعة على نطاق واسع)",
 "industrial espionage": "تَجَسُّس صِنَاعِيّ",
 "industrial loan company": "بنك صناعي, شركة قروض صناعية (شركة تمويل تقدم قروضاً صغيرة للعمال الصناعيين)",
 "industrial management": "إدارة صناعية, هندسة صناعية (فرع الهندسة الذي يتعامل مع إنشاء وإدارة الأنظمة التي تدمج الناس والمواد والطاقة بطرق منتجة)",
 "industrial music": "إندستريال ميوزيك, موسيقى صناعية (نوع موسيقي تجريبي صاخب ذو مواضيع متجاوزة للحدود نشأ في السبعينيات)",
 "industrial park": "مجمع صناعي, منطقة صناعية (قطعة أرض بعيدة عن مركز المدينة مصممة لتضم مجموعة من الشركات والمصانع)",
 "industrial plant": "مصنع, منشأة صناعية (مباني لممارسة العمل الصناعي)\nمثال: بنوا مصنعاً كبيراً لتصنيع السيارات",
 "industrial process": "عملية صناعية (سلسلة منهجية من العمليات الميكانيكية أو الكيميائية لإنتاج أو تصنيع شيء ما)",
 "industrial psychology": "علم النفس التطبيقي, علم النفس الصناعي (أي من عدة فروع لعلم النفس التي تسعى لتطبيق المبادئ النفسية على المشاكل العملية في التعليم أو الصناعة أو التسويق وغيرها)",
 "industrial revolution": "الثورة الصناعية",
 "industrial union": "نقابة صناعية (نقابة عمالية تقبل جميع العمال في صناعة معينة بغض النظر عن حرفتهم)",
 "industrial watercourse": "مجرى مائي صناعي (قناة تديرها صناعة واحدة أو أكثر)",
 "industrial workers of the world": "عمال الصناعة في العالم (نقابة عمالية دولية سابقة وحركة عمالية راديكالية في الولايات المتحدة؛ تأسست في شيكاغو عام 1905 وكرست للإطاحة بالرأسمالية؛ انخفضت عضويتها بعد الحرب…)",
 "industrial-strength": "صِنَاعِيّ الشِّدَّة, فَائِق القُوَّة (بالغ القوة أو التركيز أو المتانة)",
 "industrialisation": "تصنيع, تنمية صناعية (تطوير الصناعة على نطاق واسع)",
 "industrialised": "مُصَنَّع (جُعل صناعيًّا؛ تحوّل إلى التصنيع)",
 "industrialism": "تصنيع, نظام صناعي (نظام اقتصادي مبني على الصناعات الكبيرة بدلاً من الزراعة أو الحرف اليدوية)",
 "industrialist": "رجل صناعة, صناعي (شخص يدير أو يمتلك مصلحة مالية كبيرة في مؤسسة صناعية)",
 "industrialization": "تَصْنِيع, تَحَوُّل صِنَاعِيّ",
 "industrialized": "مُصَنَّع (جُعل صناعيًّا؛ تحوّل إلى التصنيع)",
 "industrially": "صناعياً (بوسائل صناعية)\nمثال: مُنتج صناعياً",
 "industrious": "مُجْتَهِد (مشتق من إجتهد)\nمثال: لعل المجتهد ينجح.",
 "industriously": "بإجتهاد, بجد (بطريقة مجتهدة)\nمثال: عزقوا الأعشاب الضارة بجد طوال الصباح",
 "industriousness": "جد, مثابرة (تصميم دؤوب لأداء مهمة)\nمثال: أكسبه جده ترقيات سريعة",
 "industry": "صِنَاعَة (إيجاد الشيء وخَلْقُه؛ (استخدام حديث) قطاع اقتصادي)\nمثال: هذا البلد مدعوم بالصناعة.",
 "industry analysis": "تحليل الصناعة (أداة لتقييم السوق مصممة لتزويد الشركة بفكرة عن تعقيد صناعة معينة)\nمثال: قبل شراء مزرعة الخنازير، أجرت الشركة تحليلاً متعمقاً للصناعة حول هوامش الربح",
 "industry analyst": "محلل صناعي (محلل للظروف التي تؤثر على صناعة معينة)",
 "indweller": "ساكن, قاطن (شخص يسكن في مكان معين) / حلول, سكنى داخلية (التنشيط بواسطة روح داخلية أو قوة أو مبدأ)\nمثال: الروح القدس هو الساكن في الكنيسة وأعضائها",
 "indwelling": "حَالّ, سَاكِن فِي الدَّاخِل (موجود أو مقيم كقوة أو روح داخلية مُحَرِّكة)",
 "inebriant": "كحول, مشروب كحولي (سائل أو شراب يحتوي على الكحول كعامل نشط)\nمثال: الكحول (أو الشراب) دمره",
 "inebriate": "سكير, مدمن خمر (شخص يشرب الخمر بشكل مزمن)",
 "inebriated": "ثمل, سكران (مذهول أو متهيج بواسطة مادة كيميائية (خاصة الكحول))\nمثال: حشد صاخب من البحارة المخمورين",
 "inebriation": "تسمم كحولي, ثمالة (حالة مؤقتة ناتجة عن الاستهلاك المفرط للكحول) / إدمان الكحول (تسمم اعتيادي؛ تناول مفرط ومطول للمشروبات الكحولية يؤدي إلى انهيار في الصحة وإدمان للكحول بحيث يؤدي الحرمان المفاجئ منه إلى أعراض انسحاب شديدة)",
 "inebriety": "تسمم كحولي, ثمالة (حالة مؤقتة ناتجة عن الاستهلاك المفرط للكحول)",
 "inedible": "غير صالح للأكل (غير مناسب كطعام)",
 "ineffable": "لَا يُوصَف, يَفُوق الوَصْف (يتحدى التعبير اللغوي أو الوصف؛ لا تسعه الكلمات) / جَلَّ عَنِ الوَصْفِ, لَا يُنْطَق (أقدس من أن يُنطَق به أو يُذكَر)",
 "ineffably": "بشكل لا يوصف, بشكل يعجز عنه الوصف (لدرجة لا يمكن التعبير عنها)\nمثال: بدت صغيرة جداً الليلة، وكعادتها، جميلة بشكل لا يوصف، في فستان بسيط مكشوف الكتفين من القطن الحريري الأخضر والأبيض",
 "ineffaceability": "رسوخ, عدم القابلية للمحو (جودة كون الشيء صعب الحذف أو الإزالة أو الغسل أو الطمس أو المحو)\nمثال: موضوعه الرئيسي هو الطبيعة العابرة والمهملة للثقافة المعاصرة، والتي تتناقض بشكل صارخ مع ديمومة ورسوخ الطلاء الزيتي على القماش",
 "ineffective": "غَيْرُ فَعَّال, غَيْرُ كَفُوء (يفتقر إلى القدرة أو المهارة اللازمة للأداء الفعّال؛ غير كافٍ) / غير فعال, غير مؤثر (لا ينتج تأثيراً مقصوداً) / عَدِيم الأَثَر, غَيْر فَعَّال (يفتقر إلى القوة أو التأثير الفعلي)\nمثال: معلم غير فعال",
 "ineffectively": "بِشَكْل غَيْر فَعَّال, دُونَ تَأْثِير (بطريقة غير فعالة)\nمثال: تعامل مع المشكلة بشكل غير فعال إلى حد ما",
 "ineffectiveness": "عَدَم فَعَّالِيَّة, عُقْم (الافتقار إلى القدرة على أن يكون فعالاً)",
 "ineffectual": "غير فعال, غير مؤثر (لا ينتج تأثيراً مقصوداً) / عَدِيم الأَثَر, غَيْر فَعَّال (يفتقر إلى القوة أو التأثير الفعلي) / عَبَثِيّ, عَقِيم (لَا يُنْتِجُ أَيَّ نَتِيجَةٍ أَوْ أَثَر)\nمثال: معلم غير فعال",
 "ineffectuality": "عَدَم فَعَّالِيَّة, عُقْم (الافتقار إلى القدرة على أن يكون فعالاً)",
 "ineffectually": "بِلَا طَائِل, دُونَ جَدْوَى (بطريقة غير فعالة)\nمثال: حاولت دون جدوى إشعال الموقد، وجاء توماس لمساعدتها",
 "ineffectualness": "عَدَم فَعَّالِيَّة, عُقْم (الافتقار إلى القدرة على أن يكون فعالاً)",
 "inefficacious": "غير فعال, غير ناجع (يفتقر إلى القدرة على إنتاج تأثير مرغوب)\nمثال: القوانين غير الناجعة في وقف الجريمة",
 "inefficaciously": "بِشَكْل غَيْر فَعَّال, دُونَ تَأْثِير (بطريقة غير فعالة)\nمثال: تعامل مع المشكلة بشكل غير فعال إلى حد ما",
 "inefficaciousness": "عَدَم نَجَاعَة, قُصُور (نقص في النجاعة أو الفعالية)",
 "inefficacy": "عَدَم نَجَاعَة, قُصُور (نقص في النجاعة أو الفعالية)",
 "inefficiency": "عدم كفاءة (نقص المهارة الناتج عن نقص الكفاءة)",
 "inefficient": "غَيْرُ فَعَّال, غَيْرُ كَفُوء (يفتقر إلى القدرة أو المهارة اللازمة للأداء الفعّال؛ غير كافٍ) / غير كفء, مبذر (لا ينتج النتائج المرجوة؛ مسرف)\nمثال: حملة غير كفؤة ضد المخدرات",
 "inefficiently": "دُونَ كَفَاءَة (بطريقة غير فعالة)\nمثال: تعامل مع الأزمة بغير كفاءة",
 "inelaborate": "غَيْر مُتَقَن, غَيْر مُعَقَّد (يفتقر إلى التفاصيل الغنيّة أو المعقّدة)",
 "inelastic": "غير مرن (ليس مرناً)\nمثال: يتحدث الاقتصاديون عن هيكل أسعار غير مرن",
 "inelastic supply": "عرض غير مرن (حالة لا يساوي فيها أي تغيير في سعر سلعة معينة تغييراً مطابقاً في عرضها)",
 "inelasticity": "عدم المرونة, لا مرونة (الافتقار إلى المرونة)",
 "inelegance": "رَكَاكَة, عَدَم أَنَاقَة (صفة الافتقار إلى التهذيب والذوق الرفيع)",
 "inelegant": "غير أنيق, مفتقر للذوق (يفتقر إلى التهذيب أو اللباقة أو الذوق السليم)",
 "inelegantly": "بِدُونَ أَنَاقَة, بِشَكْل غَيْر لَائِق (بدون أناقة)",
 "ineligibility": "عَدَم أَهْلِيَّة (صفة أو حالة عدم الأهلية)",
 "ineligible": "غير مؤهل (ليس مؤهلاً) / غَيْر مُؤَهَّل (لا يَسْتَوفي الشُّروط القانونِيَّة لِلأَهْلِيَّة)\nمثال: غير مؤهل للتصويت",
 "ineloquently": "بِغَيْر إِبَانَة, بِغَيْر فَصَاحَة (بدون فصاحة؛ بطريقة غير واضحة)\nمثال: الطالب الجديد يعبر عن أفكاره بغير إبانة",
 "ineluctability": "حَتْمِيَّة, عَدَم قَابِلِيَّة التَّجَنُّب (صفة استحالة تجنب الشيء أو التهرب منه)",
 "ineluctable": "لَا مَنَاص مِنْه, لَا مَهْرَب مِنْه (يستحيل تجنّبه أو التهرّب منه)",
 "ineluctably": "بشكل حتمي, لا محالة (بحكم الضرورة؛ بشكل لا مفر منه)\nمثال: انزلق الوضع لا محالة نحو الكارثة",
 "inept": "أَحْمَق, عَدِيم اللَّبَاقَة (يكشف عن قلة الفطنة أو الحُكم أو الكياسة) / أَخْرَق, عَدِيمُ الكَفَاءَة (عاجز وغير فعّال بشكل عامّ) / ثَقِيل الأُسْلُوب, رَكِيك (يَفْتَقِر إِلَى الأَنَاقَة أَوِ الرَّشَاقَة فِي التَّعْبِير)",
 "ineptitude": "انْعِدَام القِيمَة, لَا جَدْوَى (عدم امتلاك أي صفات تجعل الشيء قيماً أو مفيداً) / خرق, عدم براعة (عدم المهارة الناتج عن نقص التدريب)\nمثال: كان هدف رقيب التدريب إقناع المجندين بانعدام قيمتهم",
 "ineptly": "بِحَمَاقَة, بِدُون كَفَاءَة (بطريقة تفتقر إلى المهارة أو الكفاءة) / بِخُرْق, بِرَعُونَة (بطريقة خرقاء تفتقر إلى البراعة)\nمثال: أدى وظائفه بغير كفاءة",
 "ineptness": "عَدَم مُلَاءَمَة, عَدَم مُنَاسَبَة (صفة امتلاك خصائص خاطئة لغرض معين) / خرق, عدم براعة (عدم المهارة الناتج عن نقص التدريب)",
 "inequality": "عَدَم مُسَاوَاة (الفقدان ونقيض الوجود؛ يجب عدم فعل كذا: أي يجب الامتناع عن الفعل) / مُتَبَايِنَة\nمثال: عليك عدم الخوف.",
 "inequitable": "جائر, غير منصف (غير منصف أو عادل)\nمثال: التقسيم غير المنصف للثروة",
 "inequitably": "بِإِجْحَاف, بِغَيْر إِنْصَاف (بطريقة غير منصفة)\nمثال: ممتلكات والدهم قُسمت بإجحاف بين الأبناء",
 "inequity": "إجحاف, عدم إنصاف (الظلم بحكم عدم الامتثال للقواعد أو المعايير)",
 "ineradicable": "غير قابل للاستئصال, متأصل (لا يمكن تدميره أو اجتثاثه)\nمثال: خرافات متأصلة",
 "inerrable": "لَا يُخْطِئ, مُصِيب دَائِمًا (غَيْر قَابِل لِلخَطَأ؛ دَقِيق دَائِمًا)",
 "inerrancy": "تنزيه عن الخطأ ((المسيحية) الإعفاء من الخطأ)\nمثال: عصمة الكتاب المقدس",
 "inerrant": "لَا يُخْطِئ, مُصِيب دَائِمًا (غَيْر قَابِل لِلخَطَأ؛ دَقِيق دَائِمًا)",
 "inert": "خَامِل",
 "inert gas": "غاز خامل, غاز نبيل (أي من العناصر الغازية الخاملة كيميائياً في مجموعة الهيليوم في الجدول الدوري)",
 "inertia": "عَطَالَة",
 "inertial": "عطالي, قصوري (مكون من أو متعلق بالقصور الذاتي)",
 "inertial frame": "إطار مرجعي قصوري (نظام إحداثيات يكون فيه قانون نيوتن الأول للحركة سارياً)",
 "inertial guidance": "توجيه بالقصور الذاتي (طريقة للتحكم في طيران صاروخ بواسطة أجهزة تستجيب لقوى القصور الذاتي)",
 "inertial guidance system": "ملاحة بالقصور الذاتي, نظام توجيه بالقصور الذاتي (نظام للتحكم في طائرة أو مركبة فضائية؛ يستخدم قوى القصور الذاتي)",
 "inertial mass": "كتلة القصور الذاتي ((في الفيزياء) كتلة الجسم كما يحددها قانون الحركة الثاني من تسارع الجسم عندما يتعرض لقوة غير ناتجة عن الجاذبية)",
 "inertial navigation": "توجيه بالقصور الذاتي (طريقة للتحكم في طيران صاروخ بواسطة أجهزة تستجيب لقوى القصور الذاتي)",
 "inertial navigation system": "ملاحة بالقصور الذاتي, نظام توجيه بالقصور الذاتي (نظام للتحكم في طائرة أو مركبة فضائية؛ يستخدم قوى القصور الذاتي)",
 "inertial reference frame": "إطار مرجعي قصوري (نظام إحداثيات يكون فيه قانون نيوتن الأول للحركة سارياً)",
 "inertness": "خُمُول, عَطَالَة (الجمود بحكم الخمول)",
 "inescapable": "لَا مَنَاص مِنْه, لَا مَهْرَب مِنْه (يستحيل تجنّبه أو التهرّب منه)",
 "inescapably": "بشكل حتمي, لا محالة (بحكم الضرورة؛ بشكل لا مفر منه)\nمثال: انزلق الوضع لا محالة نحو الكارثة",
 "inessential": "ثانوي, غير أساسي (ليس أساسياً أو جوهرياً) / غَيْر جَوْهَرِيّ (ليس ضروريًّا بشكل مطلق) / شيء ثانوي, غير ضروري (أي شيء ليس أساسياً)\nمثال: تخلصوا من جميع الأشياء غير الضرورية",
 "inessentiality": "ثانوية, عدم ضرورة (ليس ذا أهمية أساسية)",
 "inestimable": "لَا يُقَاس, لَا يُقَدَّر (يَتَجَاوَز الحِسَاب أَوِ القِيَاس)",
 "inevitability": "حَتْمِيَّة, وُجُوب (صفة كون الشيء غير قابل للتجنب)",
 "inevitable": "حَتْمِيّ",
 "inevitable accident": "قضاء وقدر, قوة قاهرة (كارثة طبيعية لا مفر منها تقطع المسار المتوقع للأحداث)\nمثال: اكتشف أن منزله لم يكن مؤمناً ضد القضاء والقدر",
 "inevitableness": "حَتْمِيَّة, وُجُوب (صفة كون الشيء غير قابل للتجنب)",
 "inevitably": "بالضرورة, حتماً (بطريقة لا يمكن أن تكون خلاف ذلك) / بشكل حتمي, لا محالة (بحكم الضرورة؛ بشكل لا مفر منه)\nمثال: هو كذلك بالضرورة",
 "inexact": "غير دقيق (غير دقيق)",
 "inexactitude": "تَقْرِيب, عَدَم انْضِبَاط (صفة كون الشيء غير مضبوط تماماً)",
 "inexactly": "بشكل غير دقيق (بطريقة غير دقيقة)\nمثال: عبر عن نفسه بشكل غير دقيق",
 "inexactness": "تَقْرِيب, عَدَم انْضِبَاط (صفة كون الشيء غير مضبوط تماماً)",
 "inexcusable": "لَا يُعْذَر, لَا يُغْتَفَر (لَا يُمْكِنُ التَّمَاسُ العُذْرِ لَه) / غير معذور, لا مبرر له (بدون عذر أو مبرر)",
 "inexcusably": "بِلَا مُبَرِّر (بدون أي عذر) / بشكل غير مقبول, بشكل لا يغتفر (بطريقة لا يمكن الصفح عنها أو إلى درجة لا تغتفر)\nمثال: هو قاسٍ عليها بلا مبرر",
 "inexhaustibility": "ديمومة, عدم القابلية للنفاذ (حالة أو شرط استحالة الاستنفاد أو النفاذ؛ كون الشيء غير محدود)\nمثال: يجب على الاقتصاديين التصالح مع عدم قابلية المعرفة للنفاذ، وحقيقة أن استخدام المعرفة لا يستنزفها",
 "inexhaustible": "لا ينضب, لا ينفد (غير قادر على أن يستهلك بالكامل أو ينفد) / لَا يَنْضَب, لَا يُسْتَنْفَد (لَا يُمْكِنُ اسْتِهْلَاكُهُ أَوِ اسْتِنْفَادُهُ بِالكَامِلِ)\nمثال: إمدادات لا تنضب من الفحم",
 "inexhaustibly": "بشكل دؤوب, بلا كلل (بطاقة لا تكل)\nمثال: شاهدت العرض بلا كلل",
 "inexorability": "صَرَامَة, قَسْوَة لَا تَلِين (قسوة تتميز بعدم الرغبة في التراجع أو التخفيف)\nمثال: صرامة مطاردتهم",
 "inexorable": "عَنِيد, لَا يَلِين (لَا يَتَأَثَّرُ بِالتَّوَسُّلَاتِ أَوِ الإِقْنَاعِ أَوِ المُنَاشَدَاتِ أَوِ المَنْطِقِ) / صَارِم, لَا يَرْحَم (لا يمكن استرضاؤه أو ثَنيه بالتوسّل)",
 "inexorableness": "صَرَامَة, قَسْوَة لَا تَلِين (قسوة تتميز بعدم الرغبة في التراجع أو التخفيف)\nمثال: صرامة مطاردتهم",
 "inexorably": "بشكل لا يرحم, بلا هوادة (بطريقة لا هوادة فيها)\nمثال: الوقت يمضي بلا هوادة",
 "inexpedience": "عدم جدوى, عدم ملاءمة (صفة عدم الملاءمة للهدف المنشود)",
 "inexpediency": "عدم جدوى, عدم ملاءمة (صفة عدم الملاءمة للهدف المنشود)",
 "inexpedient": "غير مفيد, غير ملائم (غير مناسب أو غير مستحسن) / غَيْر حَكِيم, غَيْر مُنَاسِب (لا يلائم الغرض المطلوب)\nمثال: تكتيك غير مفيد",
 "inexpediently": "بشكل غير مجدٍ, بشكل غير ملائم (بطريقة غير نفعية أو غير ملائمة للغرض)",
 "inexpensive": "رخيص, منخفض التكلفة (منخفض السعر نسبياً أو يفرض أسعاراً منخفضة)\nمثال: كان سيكون رخيصاً بضعف السعر",
 "inexpensively": "بِثَمَن بَخْس, بِرُخْص (مع القليل من إنفاق المال) / بتكلفة زهيدة, بشكل رخيص (بطريقة رخيصة أو مبتذلة)\nمثال: اشتريت هذه السيارة بثمن بخس جداً",
 "inexpensiveness": "رخص (صفة كونه ميسور التكلفة)",
 "inexperience": "انعدام التجربة, قلة خبرة (الافتقار إلى الخبرة والمعرفة والفهم المستمد من التجربة)\nمثال: خلقت قلة الخبرة الإجرائية صعوبات",
 "inexperienced": "عديم الخبرة, غشيم (يفتقر إلى الخبرة العملية أو التدريب)",
 "inexperienced person": "بريء, قليل الخبرة (شخص يفتقر إلى معرفة الشر)",
 "inexperient": "عديم الخبرة, غشيم (يفتقر إلى الخبرة العملية أو التدريب)",
 "inexpert": "غَيْر مَاهِر, هَاوٍ (يفتقر إلى المهارة أو الخبرة المهنية)",
 "inexpertly": "بِفَجَاجَة, دُونَ مَهَارَة (بطريقة فجة وغير ماهرة)\nمثال: مظلة مبنية بغير مهارة",
 "inexpiable": "لَا يُكَفَّرُ عَنْه (يَسْتَحِيلُ التَّكْفِيرُ عَنْه)",
 "inexplicable": "عصي على الفهم, لا يمكن تفسيره (غير قادر على أن يفسر أو يعلل)\nمثال: أخطاء لا يمكن تفسيرها",
 "inexplicably": "بشكل غريب, بشكل لا يمكن تفسيره (بطريقة تختلف عن المعتاد أو المتوقع)\nمثال: كان لديه صوت أجش بشكل مثير للفضول",
 "inexplicit": "ضمني, مفهوم ضمناً (مفهوم ضمناً وإن لم يتم التعبير عنه مباشرة؛ متأصل في طبيعة الشيء)\nمثال: اتفاق ضمني بعدم إثارة الموضوع",
 "inexplicitness": "ضِمْنِيَّة, عَدَم صَرَاحَة (عدم الوضوح بحكم عدم كون الشيء صريحاً)",
 "inexpressible": "لا يمكن التعبير عنه, لا يوصف (يتحدى التعبير)",
 "inexpressibly": "بشكل لا يوصف, بشكل يعجز عنه الوصف (لدرجة لا يمكن التعبير عنها)\nمثال: بدت صغيرة جداً الليلة، وكعادتها، جميلة بشكل لا يوصف، في فستان بسيط مكشوف الكتفين من القطن الحريري الأخضر والأبيض",
 "inexpressive": "بَلِيد, غَيْرُ مُعَبِّر (لا يُظهر تعبيرًا أو انفعالًا)",
 "inexpressively": "بجمود, دون تعبير (بدون إظهار أي تعبير؛ بطريقة خالية من المشاعر)\nمثال: نظرت إليه دون تعبير",
 "inexpugnable": "مَنِيع",
 "inexpungeable": "لَا يُمْكِنُ شَطْبُه (غير قابل للحذف أو الإلغاء)",
 "inexpungible": "لَا يُمْكِنُ شَطْبُه (غير قابل للحذف أو الإلغاء)",
 "inextensible": "غير قابل للامتداد (غير قابل للامتداد)",
 "inexterminable": "عَصِيٌّ عَلَى الإِبَادَة (لا يمكن إبادته أو استئصاله)",
 "inextinguishable": "لا يخمد, لا ينطفئ (صعب أو مستحيل إخماده)\nمثال: شعلة لا تنطفئ",
 "inextirpable": "عَصِيٌّ عَلَى الإِبَادَة (لا يمكن إبادته أو استئصاله)",
 "inextricable": "شائك, لا يمكن حله (لا يسمح بالتخليص؛ غير قادر على فك التشابك أو الحل)\nمثال: عقدة مستعصية",
 "inextricably": "بترابط وثيق, بشكل لا انفكاك منه (بطريقة لا يمكن فصلها)\nمثال: كانت الدوافع المستوحاة من المال غالباً ما تمتزج بشكل لا انفكاك منه بأمور تتعلق بالقيصر وبالله",
 "infallibility": "عِصْمَة",
 "infallible": "معصوم, منزه عن الخطأ (غير قادر على الفشل أو الخطأ)\nمثال: ترياق لا يخطئ (فعال دائماً)",
 "infamous": "سَيِّئُ الصِّيتِ, مَشْهُورٌ بِالسُّوءِ (معروف على نطاق واسع وعادة بشكل سلبي)",
 "infamy": "خزي, سوء صيت (شهرة شريرة أو سمعة عامة سيئة) / خزي, عار (حالة من عدم الشرف الشديد)\nمثال: تاريخ سيعيش في الخزي",
 "infancy": "رضاعة, طفولة مبكرة (أبكر مراحل عدم النضج) / طفولة مبكرة, مهد (المرحلة المبكرة من النمو أو التطور)",
 "infant": "رَضِيع",
 "infant death": "متلازمة موت الرضيع المفاجئ (موت مفاجئ وغير متوقع لرضيع يبدو بصحة جيدة أثناء النوم)",
 "infant deathrate": "مُعَدَّل وَفَيَات الرُّضَّع (معدل الوفيات خلال السنة الأولى من الحياة)",
 "infant feeding": "تغذية الرضع (إطعام الرضيع)",
 "infant mortality": "مُعَدَّل وَفَيَات الرُّضَّع (معدل الوفيات خلال السنة الأولى من الحياة)",
 "infant mortality rate": "مُعَدَّل وَفَيَات الرُّضَّع (معدل الوفيات خلال السنة الأولى من الحياة)",
 "infant school": "مدرسة صغار (مدرسة بريطانية للأطفال الذين تتراوح أعمارهم بين 5-7 سنوات)",
 "infant's-breath": "جويسئة بيضاء, فوة برية (عشب أوراسي ذو عناقيد واسعة من الزهور البيضاء الصغيرة؛ تم توطينه في أمريكا الشمالية)",
 "infanticide": "قتل الرضيع, وأد (قتل طفل رضيع) / قاتل الرضيع (شخص يقتل رضيعاً)",
 "infantile": "طُفُولِيّ, طِفْلِيّ (يدل على افتقار إلى النضج) / رَضِيعِيّ, طِفْلِيّ (يليق بالرضيع أو من صفاته وخصائصه) / رضيعي, طفولي (مكون من أو متعلق بالرضع أو الطفولة)\nمثال: شلل الأطفال",
 "infantile amaurotic idiocy": "داء تاي ساكس, مرض تاي ساكس (اضطراب وراثي في استقلاب الدهون يحدث بشكل متكرر لدى الأفراد من أصل يهودي في أوروبا الشرقية؛ يؤدي تراكم الدهون في الأنسجة العصبية إلى الوفاة في مرحلة…)",
 "infantile autism": "توحد طفولي (متلازمة نادرة ولكنها خطيرة في الطفولة تتميز بالانسحاب ونقص الاستجابة الاجتماعية أو الاهتمام بالآخرين وعجز لغوي خطير)\nمثال: هناك خلاف كبير بين المتخصصين بشأن التوحد الطفولي",
 "infantile fixation": "تثبيت, توقف النمو (حالة غير طبيعية يتوقف فيها النمو قبل الأوان)",
 "infantile paralysis": "شلل الأطفال (مرض فيروسي حاد يتميز بالتهاب الخلايا العصبية في جذع الدماغ والحبل الشوكي)",
 "infantilism": "سلوك طفولي, طفولية (سلوك طفولي يصدر من أشخاص بالغين) / طفالية (حالة غير طبيعية يحتفظ فيها طفل أكبر سناً أو شخص بالغ بخصائص طفولية)",
 "infantry": "مُشَاة, بِيَادَة",
 "infantry fighting vehicle": "مَرْكَبَةُ مُشَاةِ قِتَالِيَّة",
 "infantryman": "بِيَادِيّ",
 "infantrywoman": "جندية مشاة (امرأة تقاتل سيراً على الأقدام بأسلحة صغيرة)",
 "infarct": "احتشاء (نخر موضعي ناتج عن انسداد في تدفق الدم)",
 "infarction": "احتشاء (نخر موضعي ناتج عن انسداد في تدفق الدم)",
 "infatuated": "مُتَيَّم, مُغْرَم (يتسم بولع أحمق أو غير عقلاني)",
 "infatuation": "معشوق, مفتون به (موضوع لشغف مفرط وقصير الأمد) / افتتان, ولع (شغف أو حب أو إعجاب أحمق وعادة ما يكون مفرطاً) / إعجاب عابر, حب المراهقة (حب مؤقت لمراهق)",
 "infeasibility": "اسْتِحَالَة, عَدَم جَدْوَى (صفة كون الشيء غير قابل للقيام به)",
 "infeasible": "غَيْر عَمَلِيّ, غَيْر قَابِل لِلتَّطْبِيق (لا يمكن تنفيذه أو وضعه موضع التطبيق)",
 "infect": "أَعْدَى",
 "infected": "إنتاني, متقيح (يحتوي على كائنات مسببة للأمراض أو ناتج عنها)\nمثال: التهاب حلق إنتاني",
 "infection": "عَدْوَى",
 "infectious": "مُعْدٍ",
 "infectious agent": "عامل خَمَجِي, عامل مُعْدٍ (عامل قادر على إحداث العدوى)",
 "infectious disease": "مَرَض مُعْدٍ (أصابه مرضٌ أو علّة أو سَقَم)\nمثال: هذا المرض قلبي.",
 "infectious hepatitis": "التهاب الكبد أ, التهاب الكبد المعدي",
 "infectious mononucleosis": "داء التقبيل, كثرة الوحيدات العدوائية (مرض حاد يتميز بالحمى وتضخم الغدد الليمفاوية وزيادة غير طبيعية في كريات الدم البيضاء وحيدة النواة في مجرى الدم؛ ليس شديد العدوى؛ يعتقد البعض أنه يمكن…)",
 "infectious polyneuritis": "متلازمة غيلان باريه (شكل من أشكال التهاب الأعصاب المتعدد المحيطي يتميز بالألم والضعف وأحياناً شلل الأطراف؛ السبب غير معروف)",
 "infectiously": "بِشَكْل مُعْدٍ, بِعَدْوَى (بطريقة معدية)\nمثال: كانت مفعمة بالحيوية بشكل معد",
 "infective": "مُعْدٍ, مُمْرِض (يُسَبِّب العَدْوى أو المَرَض) / عَدْوَائِيّ, مُعْدٍ (ناتج عن العدوى أو قادر على التسبّب فيها)",
 "infective agent": "عامل خَمَجِي, عامل مُعْدٍ (عامل قادر على إحداث العدوى)",
 "infelicitous": "غير لائق, غير موفق (غير مناسب في التطبيق؛ معيب) / تَعِيس, مُحْزِن (يَتَّسِمُ بِالتَّعَاسَةِ أَوْ يُسَبِّبُهَا)\nمثال: ملاحظة غير موفقة",
 "infelicitously": "بشكل غير ملائم, بشكل غير موفق (بطريقة غير موفقة)\nمثال: اختار كلماته بشكل غير موفق إلى حد ما",
 "infelicity": "رَكَاكَة, عَدَم تَوْفِيق (أسلوب أو طريقة غير مناسبة وغير سارة (خاصة في التعبير))",
 "inference": "استدلال (التفكير المتضمن في استخلاص نتيجة أو إصدار حكم منطقي بناءً على أدلة ظرفية واستنتاجات سابقة بدلاً من الملاحظة المباشرة)",
 "inferential": "اسْتِدْلَالِيّ, اسْتِنْتَاجِيّ (قَائِمٌ عَلَى التَّأْوِيلِ؛ غَيْرُ مُعَبَّرٍ عَنْهُ مُبَاشَرَةً) / اسْتِدْلَالِيّ, اسْتِنْتَاجِيّ (مُشْتَقٌّ أَوْ قَابِلٌ لِلاشْتِقَاقِ عَنْ طَرِيقِ الاسْتِدْلَال) / اسْتِنْتَاجِيّ (يُشبه الاستنتاج أو يعتمد عليه أو يُتوصّل إليه بالاستدلال) / قِيَاسِيّ (من الاستدلال؛ ينتقل من مُقدّمات عامّة إلى نتيجة ضروريّة ومُحدّدة)",
 "inferential statistics": "إِحْصَاء اِسْتِدْلَالِيّ (عد وجمع وطرح؛ عِلْمُ الإِحْصَاء: هو العلم الذي يعنى بجمع البيانات وتحليلها رياضيا)",
 "inferior": "دُون المُسْتَوَى, نَاقِص (لا يرقى إلى المعيار المحدد؛ أقل من المستوى المطلوب) / أدنى, مرؤوس (من رتبة أو أهمية منخفضة أو يتسم بها) / دوني, رديء (ذو جودة منخفضة أو رديئة) / داخلي (كوكب) (له مدار بين الشمس ومدار الأرض)\nمثال: عطارد والزهرة كواكب داخلية",
 "inferior alveolar artery": "الشريان السنخي السفلي (الشريان السنخي الذي يمر عبر قناة الفك السفلي لتغذية الأسنان السفلية)",
 "inferior cerebellar artery": "شريان مخيخي سفلي (الفرع السفلي للشريان المخيخي)",
 "inferior cerebral vein": "وريد مخي سفلي (أوردة تصرف السطح السفلي لنصفي الكرة المخية وتصب في الجيوب الكهفية والمستعرضة)",
 "inferior colliculus": "أكيمة سفلية (مركز سمعي أساسي في الدماغ المتوسط)",
 "inferior conjunction": "اقتران سفلي ((في علم الفلك) محاذاة الأرض وكوكب على نفس الجانب من الشمس)",
 "inferior court": "محكمة أدنى, محكمة ابتدائية (أي محكمة يمكن استئناف قراراتها أمام محكمة أعلى)",
 "inferior epigastric vein": "وريد شرسوفي سفلي (يصب في الوريد الحرقفي الظاهر)",
 "inferior labial artery": "شريان شفوي سفلي (شريان هو فرع من الشريان الوجهي يغذي الشفة السفلى)",
 "inferior labial vein": "وريد شفوي سفلي (رافد للوريد الوجهي يصرف الشفة السفلى)",
 "inferior mesenteric artery": "شريان مساريقي سفلي (ينشأ بالقرب من النهاية السفلية للأبهر ويغذي الأمعاء الغليظة)",
 "inferior ophthalmic vein": "وريد عيني سفلي (وريد يصرف شبكة وريدية في قاع والجدار الإنسي لمحجر العين)",
 "inferior planet": "كَوْكَب دَاخِلِيّ (أي من الكواكب التي يقع مدارها داخل مدار الأرض)",
 "inferior pulmonary vein": "وريد رئوي سفلي (أي من وريدين رئويين (أيسر وأيمن) يعيدان الدم من الفصوص السفلية للرئتين)",
 "inferior rectus": "مستقيمة سفلية (عضلة العين التي يدير انقباضها مقلة العين لأسفل وللداخل)",
 "inferior rectus muscle": "مستقيمة سفلية (عضلة العين التي يدير انقباضها مقلة العين لأسفل وللداخل)",
 "inferior thalamostriate vein": "وريد مخططي, وريد مهادي مخططي سفلي (روافد للوريد القاعدي)",
 "inferior thyroid vein": "وريد درقي سفلي (أي من عدة أوردة على كل جانب تصرف الغدة الدرقية وتصب في الوريد لا اسم له)",
 "inferior vena cava": "وريد أجوف سفلي (يتلقى الدم من الأطراف السفلية وأعضاء البطن ويصب في الجزء الخلفي من الأذين الأيمن للقلب؛ يتكون من اتحاد الوريدين الحرقفيين)",
 "inferior vocal cord": "حبل صوتي حقيقي (أي من الطيتين الصوتيتين السفليتين اللتين تلتقيان لتكوين المزمار؛ تنتجان نغمة صوتية عند تقاربهما ومرور الهواء من الرئتين بينهما)",
 "inferior vocal fold": "حبل صوتي حقيقي (أي من الطيتين الصوتيتين السفليتين اللتين تلتقيان لتكوين المزمار؛ تنتجان نغمة صوتية عند تقاربهما ومرور الهواء من الرئتين بينهما)",
 "inferiority": "جودة منخفضة, دونية (جودة متدنية) / دونية, وضع أدنى (صفة كون الشخص في وضع تنافسي أضعف) / دونية, مكانة أدنى (حالة كونه أدنى)",
 "inferiority complex": "عقدة الدونية, عقدة نقص (شعور بالنقص الشخصي ينشأ من الصراع بين الرغبة في لفت الانتباه والخوف من التعرض للإهانة)",
 "infernal": "جَحِيمِيّ, جَهَنَّمِيّ",
 "infernal machine": "قنبلة موقوتة (قنبلة لها آلية تفجير يمكن ضبطها لتنفجر في وقت معين)",
 "infernal region": "الجحيم, العالم السفلي ((الأديان) عالم الموتى) / الجحيم, الهاوية ((المسيحية) مسكن الشيطان وقوى الشر؛ حيث يعاني الخطاة من العقاب الأبدي)\nمثال: لا أحد يذهب إلى هاديس بكل ثروته الهائلة",
 "infernally": "بشكل رهيب, جحيمياً (بشكل شيطاني أو مزعج جداً)\nمثال: ذكي بشكل شيطاني",
 "inferno": "جَحِيم, جَهَنَّم / جَحِيم, سَعِير",
 "infertile": "عَقِيم",
 "infertility": "عقم (حالة عدم القدرة على إنتاج النسل؛ عند المرأة هو عدم القدرة على الحمل؛ عند الرجل هو عدم القدرة على التلقيح)",
 "infestation": "اجتياح, غزو (سرب من الحشرات يهاجم النباتات) / اجتياح, تفشي (حالة التعرض للغزو أو الاجتياح من قبل الطفيليات)\nمثال: غزو من الجراد",
 "infidel": "كَافِر, كَافِرَة",
 "infidelity": "خِيَانَة / كُفْر, زَنْدَقَة (مصدر للفعل \"كَفَرَ\")",
 "infield": "ساحة البيسبول الداخلية (منطقة ملعب البيسبول المحاطة بالقواعد الثلاث واللوحة الرئيسية)",
 "infielder": "لاعب الدفاع الداخلي",
 "infighting": "التحام قريب (الملاكمة من مسافة قريبة) / اِقْتِتَال دَاخِلِيّ (صراع بين أعضاء نفس المنظمة (عادة ما يكون مخفياً عن الغرباء))",
 "infiltration": "تسلل (عملية يخترق فيها أفراد (أو مجموعات صغيرة) منطقة (خاصة الاختراق العسكري لمواقع العدو دون كشفهم)) / تخلل, ترشيح (المرور البطيء لسائل عبر وسط ترشيح)\nمثال: تخلل مياه الأمطار عبر التربة",
 "infiltrator": "متسلل, مندس (دخيل (كالقوات العسكرية) ذو نوايا عدائية) / متسلل (شخص يتخذ موقعًا خلسة لغرض التجسس)",
 "infinite": "لَا مُتَنَاهٍ (كلّيّ وشامل لكلّ شيء) / فراغ, فضاء (المدى غير المحدود الذي يقع فيه كل شيء) / لَا يُحْصَى, لَا يُعَدّ (أَكْثَر مِنْ أَنْ يُحْصَى أَوْ يُعَدّ) / غير محدود, لانهائي (ليس له حدود أو قيود في الزمان أو المكان أو المدى أو الحجم)\nمثال: اختبروا قدرته على تحديد مواقع الأشياء في الفضاء",
 "infinite sequence": "متتالية لا نهائية (تتابع غير محدود لعناصر مرتبة بترتيب معين)",
 "infinitely": "إِلى مَا لَا نِهَايَة, بِلَا نِهَايَة (الاستمرار للأبد دون توقف) / بِشَكْل لَا نِهَائِيّ, بِشَكْل لَا يُقَاس (بدون قيود أو حدود)\nمثال: هناك احتمالات لا حصر لها",
 "infiniteness": "لا محدودية, لا نهائية (صفة كون الشيء لا نهائياً؛ بلا حدود أو قيود)",
 "infinitesimal": "مُتَنَاهٍ فِي الصِّغَر (صغير بشكل لا نهائي أو لا يُقاس) / متناهي الصغر ((رياضيات) متغير حده هو الصفر)",
 "infinitesimal calculus": "تفاضل وتكامل (فرع الرياضيات المعني بالنهايات وتفاضل وتكامل الدوال)",
 "infinitival": "مصدري\nمثال: جملة مصدرية",
 "infinitive": "مَصْدَر (مَصْدَر)\nمثال: ما مصدر هذا الخوف؟",
 "infinitude": "لا محدودية, لا نهائية (صفة كون الشيء لا نهائياً؛ بلا حدود أو قيود) / لا نهاية, مقدار لا نهائي (كمية لا نهائية)",
 "infinity": "أبدية, خلود (زمن بلا نهاية)",
 "infirm": "ضَعِيفُ الْإِرَادَةِ (يفتقر إلى قوة الإرادة أو ثبات الشخصية) / ضَعِيف, وَاهِن (يفتقر إلى القوة البدنية أو العضلية أو الحيوية)",
 "infirmary": "مُسْتَشْفًى, مَشْفًى (اسم مفعول من الفعل \"اسْتَشْفَى\")\nمثال: أعمل في مستشفى.",
 "infirmity": "ضعف, عجز (حالة الضعف في الصحة أو الجسم (خاصة بسبب الشيخوخة))",
 "infix": "حشو, داخلة (زائدة يتم إدخالها داخل الكلمة)",
 "infix notation": "تدوين ضمني, ترميز إنفكس (تدوين لتكوين تعبيرات رياضية باستخدام الأقواس وتحكمه قواعد أسبقية المعاملات؛ حيث تكون المعاملات مبعثرة بين المعاملات)",
 "inflamed": "مُلْتَهِب",
 "inflaming": "إلهاب, تأجيج (إثارة لمشاعر عنيفة)",
 "inflammability": "سرعة الاشتعال, قابلية الاشتعال السريع (صفة سهولة الاشتعال والاحتراق بسرعة)",
 "inflammable": "سَرِيع الاِشْتِعَال (سهل الاشتعال)",
 "inflammation": "اِلْتِهَاب",
 "inflammatory": "تَحْرِيضِيّ",
 "inflammatory disease": "مرض التهابي (مرض يتميز بالالتهاب)",
 "inflatable": "قَابِل لِلنَّفْخ (مُصَمَّم ليُملأ بالهواء أو الغاز)",
 "inflatable cushion": "وسادة هوائية (وسادة مصنوعة عادة من المطاط أو البلاستيك يمكن نفخها)",
 "inflate": "نَفَخَ (أَطْلَقَ الريح من فمه؛ زَفَرَ أو هَبَّ بشدة)\nمثال: يداك أوكتا وفوك نفخ",
 "inflated": "مَنْفُوخ",
 "inflater": "مضخة هواء, منفاخ (مضخة هواء تعمل باليد لنفخ شيء ما (مثل الإطار))",
 "inflation": "تَضَخُّم (الزِّيادة المُفرِطة في الحجم؛ الزِّيادة المُفرِطة في الوسائل والأَشخاص) / تَضَخُّم, زِيَادَة (الزِّيادة المُفرِطة في الحجم؛ الزِّيادة المُفرِطة في الوسائل والأَشخاص)\nمثال: الجزائر تعاني من التضخم.",
 "inflation rate": "مُعَدَّل التَّضَخُّم (معدل تغير الأسعار (كما يشير إليه مؤشر الأسعار) محسوباً على أساس شهري أو سنوي)",
 "inflation therapy": "علاج بالاستنشاق, علاج بالنفخ (علاج يتم فيه إدخال الماء أو الأكسجين أو دواء إلى الجهاز التنفسي مع الهواء المستنشق)",
 "inflationary": "تضخمي (مرتبط بـ أو يميل إلى التسبب في زيادات في التضخم)\nمثال: أسعار تضخمية",
 "inflationary spiral": "دوامة تضخمية (فترة من التضخم تزداد فيها الأسعار والأجور بمعدل متزايد وتفقد العملة قيمتها بسرعة)",
 "inflator": "مضخة هواء, منفاخ (مضخة هواء تعمل باليد لنفخ شيء ما (مثل الإطار))",
 "inflected": "متصرف, مصرف (يظهر تغيراً في الشكل (خاصة عن طريق إضافة اللواحق)) / متغير النبرة, منغم ((عن الصوت) متغير في النغمة أو الطبقة)\nمثال: كان صوته في جنوب يوركشاير أقل تنغيماً وغناءً من صوتها الشمالي",
 "inflection": "تنغيم, عروض (أنماط الضغط والتنغيم في اللغة) / تعديل الصوت (طريقة في التحدث يتم فيها تعديل جهارة أو حدة أو نبرة الصوت) / انثناء, انعطاف (انحراف عن مسار مستقيم أو طبيعي) / إِعْرَاب, تَصْرِيف (تغيير في شكل الكلمة (عادة بإضافة لاحقة) للإشارة إلى تغيير في وظيفتها النحوية)",
 "inflectional": "إِعْرَابِيّ, تَصْرِيفِيّ (يتميز بتصريفات تشير إلى الفروق النحوية)\nمثال: يستخدم الصرف التصريفي للإشارة إلى العدد والحالة والزمن والشخص وما إلى ذلك",
 "inflectional ending": "علامة إعراب, لاحقة تصريفية (تصريف يضاف في نهاية جذر الكلمة)",
 "inflectional morphology": "صرف تصريفي (جزء القواعد الذي يتعامل مع تصريفات الكلمات)",
 "inflectional suffix": "علامة إعراب, لاحقة تصريفية (تصريف يضاف في نهاية جذر الكلمة)",
 "inflexibility": "جُمُود, صَلَابَة (صفة كون الشخص جامداً وشديد الصرامة) / صلابة, عدم المرونة (الافتقار إلى المرونة الجسدية)",
 "inflexible": "صلب, غير مرن (مقاوم للانحناء) / صارم, غير مرن (غير قابل للتغيير) / صارم, لا هوادة فيه (لا يقدم تنازلات) / جَامِد, صَارِم (غَيْرُ قَادِرٍ عَلَى التَّكَيُّفِ أَوِ التَّغَيُّرِ لِمُوَاجَهَةِ الظُّرُوفِ)\nمثال: قضيب حديدي غير مرن",
 "inflexibleness": "صلابة, عدم المرونة (الافتقار إلى المرونة الجسدية)",
 "inflexibly": "بشكل غير مرن, بصرامة (بطريقة غير مرنة)\nمثال: قالت لها المدام بصرامة: ستفعلين ذلك - لأنك مضطرة!",
 "inflexion": "إِعْرَاب, تَصْرِيف (تغيير في شكل الكلمة (عادة بإضافة لاحقة) للإشارة إلى تغيير في وظيفتها النحوية)",
 "infliction": "إنزال العقاب, إيقاع الألم (فعل يسبب ألماً أو ضرراً) / فرض (فعل فرض شيء ما (مثل ضريبة أو حظر)) / إزعاج, مصدر إزعاج (شيء أو شخص يسبب المتاعب؛ مصدر للتعاسة)\nمثال: إزعاج بسيط",
 "infliximab": "إنفليكسيماب, ريميكيد / إنفليكسيماب, ريميكاد (جسم مضاد وحيد النسيلة (الاسم التجاري ريميكاد) يُستخدم لعلاج مرض كرون والتهاب المفاصل الروماتويدي؛ يُعطى عن طريق التسريب؛ يجب تحديد الاستخدام والجرعة…)",
 "inflorescence": "إزهار, نورة (الجزء المزهر من النبات أو ترتيب الزهور على الساق) / إزهار, تفتح الزهور (وقت وعملية تبرعم وتفتح الزهور)",
 "inflow": "تدفق داخلي (عملية التدفق إلى الداخل)",
 "inflowing": "مُتَدَفِّق إِلَى الدَّاخِل (يجري أو يتدفّق نحو الداخل)",
 "influence": "نَفُوذ, تَأْثِير / تَأْثِير / أَثَّرَ (عَلَامَة؛ بَقِيَّة؛ رَسْم مُتَخَلَّف من شيء ما؛ تأثير؛ انطباع)\nمثال: اختفى فلم ير له أثر.",
 "influence peddler": "وسيط نفوذ (شخص يتدخل لدى السلطات لصالح شخص في ورطة (عادة باستخدام أساليب ملتوية أو غير قانونية مقابل رسوم))",
 "influencer": "مُؤَثِّر",
 "influent": "مُتَدَفِّق إِلَى الدَّاخِل (يجري أو يتدفّق نحو الداخل)",
 "influential": "ذو نفوذ, مؤثر (لديه أو يمارس تأثيراً أو سلطة)\nمثال: صحيفة مؤثرة",
 "influential person": "شخصية مؤثرة, شخصية هامة (شخص تؤثر أفعاله وآراؤه بقوة على مسار الأحداث)",
 "influentially": "بشكل مؤثر, بنفوذ (ممارسة للتأثير)",
 "influenza": "إِنْفْلُوَنْزَا",
 "influx": "تدفق داخلي (عملية التدفق إلى الداخل)",
 "info": "معلومات (رسالة تم استلامها وفهمها)",
 "infodemic": "وباء معلوماتي (المرض العام الذي ينتشر بين الناس)\nمثال: على السلطات أن توقف انتشار الوباء.",
 "infolding": "انخساف, انغماد (انطواء طبقة خارجية لتكوين جيب في السطح)\nمثال: انغماد الأريمة",
 "infomercial": "إِعْلَان مَعْلُومَاتِيّ (إعلان تلفزيوني يقدم في شكل فيلم وثائقي قصير)",
 "inform": "بَلَّغَ, أَبْلَغَ",
 "informal": "غير رسمي (ليس رسمياً) / عامي, غير رسمي (يستخدم في اللغة المنطوقة والمكتوبة) / أَلِيف, حَمِيمِيّ (يُوَفِّرُ جَوًّا دَافِئًا وَوُدِّيًّا وَغَيْر رَسْمِيّ) / غَيْر رَسْمِيّ, فَضْفَاض (غير معترف به أو مُراقَب رسمياً)\nمثال: أناس محافظون غير معتادين على اللباس غير الرسمي",
 "informality": "أَرِيحِيَّة, بَسَاطَة (التحرر من القيد أو الحرج) / بساطة, لا رسمية (أسلوب لا يأخذ الأشكال والمراسم على محمل الجد)\nمثال: لا أشعر بالراحة أبداً مع الغرباء",
 "informally": "بشكل غير رسمي, بودية (بدون رسميات) / بِالعَامِّيَّة, بِشَكْل غَيْر رَسْمِيّ (باستخدام تعابير عامية)\nمثال: زارنا بشكل غير رسمي",
 "informant": "مُخْبِر, مُخْبِرة / مُخْبِر",
 "informatics": "مَعْلُومَاتِيَّة",
 "information": "مَعْلُومَات, مَعْلُومَة",
 "information age": "عصر المعلومات (فترة بدأت في الربع الأخير من القرن العشرين عندما أصبحت المعلومات متاحة بسهولة من خلال المنشورات ومن خلال معالجة المعلومات بواسطة أجهزة الكمبيوتر…)",
 "information audit": "تدقيق المعلومات (تحليل وفحص استخدام المعلومات والموارد والتدفقات، مع التحقق من الوثائق والأشخاص، من أجل تحسين جودة المعلومات المسجلة)",
 "information bulletin": "نشرة معلوماتية (نشرة تحتوي على أحدث المعلومات)",
 "information desk": "مَكْتَبُ الاِسْتِعْلَامَات, مَكْتَبُ الْمَعْلُومَات (الموضع الذي يُكتَب عليه. بعكس المَكْتَب الذي يكتب فيه؛ مِنْضَدَة مخصصة للكتابة، سواء كانت للمَكَاتِب أم لغيرها)\nمثال: عاد إلى المكتب.",
 "information gathering": "جمع المعلومات (فعل جمع المعلومات)",
 "information measure": "مقياس المعلومات (نظام لقياس المعلومات يعتمد على احتمالات الأحداث التي تنقل المعلومات)",
 "information processing": "علم المعلومات, معلوماتية (العلوم المعنية بجمع ومعالجة وتخزين واسترجاع وتصنيف المعلومات المسجلة)",
 "information processing system": "حاسوب, كمبيوتر (آلة لإجراء الحسابات تلقائياً)",
 "information return": "إقرار معلومات (إقرار يوفر معلومات لمحصل الضرائب ولكنه لا يحسب الالتزام الضريبي)",
 "information science": "علم المعلومات (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "information security": "أمن المعلومات (وَثِقَ به وأرْكَنَ إليه)\nمثال: اتصل زيري بالأمن.",
 "information superhighway": "الطريق السريع للمعلومات (شبكة إلكترونية واسعة (مثل الإنترنت) تستخدم للنقل السريع للصوت والفيديو والرسومات في شكل رقمي)",
 "information system": "نظام المعلومات (مَنْهَج، طَرِيقَة؛ تَرْتِيب واتِّسَاق)\nمثال: ليس بنظام كامل.",
 "information technology": "تِقْنِيَّة مَعْلُومَات, تِكْنُولُوجِيَا مَعْلُومَات",
 "information theory": "نظريَة المعلومات (مؤنث نَظَرْيّ، أي يفحض بالنظر لا بالإختبار؛ قضية غير مثبتة ولا مبرهنة لتفسير أمر ما)\nمثال: إنها مجرد نظرية.",
 "information warfare": "حَرْب مَعْلُومَات (حَرَبَ (حربه) بالحربة حربا: طعنه بها؛ حَرَبَ (ه) حربا: سلبه جميع ما يملك)\nمثال: بوتين مجرم حرب.",
 "informational": "مَعْلُومَاتِيّ",
 "informational rna": "حمض نووي ريبوزي رسول (القالب لتخليق البروتين؛ شكل الحمض النووي الريبوزي الذي يحمل المعلومات من الحمض النووي في النواة إلى مواقع الريبوسوم لتخليق البروتين في الخلية)",
 "informative": "إِخْبَارِيّ, إِعْلَامِيّ",
 "informatively": "بشكل تثقيفي, بشكل مفيد (بطريقة غنية بالمعلومات)",
 "informatory": "إعلامي, تثقيفي (يقدم أو ينقل معلومات)",
 "informed": "مثقف, مطلع (لديه الكثير من المعرفة أو التعليم)\nمثال: جمهور مطلع",
 "informed consent": "موافقة مستنيرة (موافقة المريض على الخضوع لعلاج طبي أو جراحي أو المشاركة في تجربة بعد فهم المخاطر التي ينطوي عليها ذلك)",
 "informel": "إنفورميل, الفن غير الرسمي (مدرسة فنية فرنسية نشأت في الخمسينيات وتتميز بضربات غير منتظمة وبقع لونية تطبق عشوائياً على القماش؛ تقارن بالتعبيرية التجريدية الأمريكية)\nمثال: حوالي عام 1945، أسس عدد من الرسامين الأوروبيين والأمريكيين مرحلة حاسمة في الفن الحديث تُعرف عموماً باسم الفن غير الرسمي",
 "informer": "مخبر, واشٍ (من يكشف معلومات سرية للشرطة أو سلطة أخرى)",
 "informer's privilege": "امتياز المخبر (حق الحكومة في رفض الكشف عن هوية المخبر)",
 "informercial": "إِعْلَان مَعْلُومَاتِيّ (إعلان تلفزيوني يقدم في شكل فيلم وثائقي قصير)",
 "informing": "إخبار, إعلام (فعل كلامي ينقل معلومات) / إبلاغ, وشاية (تقديم أدلة تدين شخصاً إلى ضابط القانون (عادة مقابل خدمات))",
 "infotainment": "فيلم وثائقي, وثائقي (فيلم أو برنامج تلفزيوني يعرض الحقائق حول شخص أو حدث)",
 "infra": "أدناه, في الأسفل ((في الكتابة) في مكان لاحق)\nمثال: انظر أدناه",
 "infraction": "مُخَالَفَة",
 "infrahuman": "دُونَ البَشَرِيّ (ينتمي إلى مجموعة أدنى من البشر في التطوّر التطوّري)",
 "inframaxillary": "فكي سفلي (متعلق بالفك السفلي)",
 "infrangible": "لَا يُنْتَهَك, مَصُون (لا يمكن انتهاكه أو التعدي عليه) / غَيْرُ قَابِلٍ لِلْفَصْل (صَعْبٌ أَوْ مُسْتَحِيلٌ كَسْرُهُ أَوْ فَصْلُهُ إِلَى أَجْزَاء)",
 "infraorbital artery": "شريان تحت الحجاج (شريان ينشأ من الشريان الفكي العلوي ويغذي التراكيب الموجودة أسفل محجر العين (من الجفن السفلي إلى الشفة العليا))",
 "infraorder": "رُتْبَة سُفْلَى (رُتْبَة، بضم الراء؛ رَتْبَة، بفتح الراء)",
 "infrared": "تَحْتَ اَلْحَمْرَاء (أَقَلَّ)\nمثال: أنا تحت الشجرة.",
 "infrared emission": "أشعة تحت الحمراء, ضوء تحت أحمر (إشعاع كهرومغناطيسي بأطوال موجية أطول من الضوء المرئي ولكن أقصر من موجات الراديو)",
 "infrared frequency": "أَشِعَّة تَحْت حَمْرَاء, تَرَدُّد دُون الأَحْمَر (المنطقة تحت الحمراء من الطيف الكهرومغناطيسي؛ ترددات الموجات الكهرومغناطيسية التي تقل عن النطاق المرئي)\nمثال: كان بإمكانهم استشعار الإشعاع في النطاق تحت الأحمر",
 "infrared lamp": "مصباح أشعة تحت الحمراء, مصباح حراري (سخان كهربائي يتكون من مصباح متوهج عالي الطاقة يبعث أشعة تحت الحمراء)\nمثال: يمكن تدفئة الحمام بواسطة مصباح أشعة تحت الحمراء",
 "infrared light": "أشعة تحت الحمراء, ضوء تحت أحمر (إشعاع كهرومغناطيسي بأطوال موجية أطول من الضوء المرئي ولكن أقصر من موجات الراديو)",
 "infrared radiation": "أشعة تحت الحمراء, ضوء تحت أحمر (إشعاع كهرومغناطيسي بأطوال موجية أطول من الضوء المرئي ولكن أقصر من موجات الراديو)",
 "infrared ray": "شعاع تحت أحمر (شعاع من الأشعة تحت الحمراء؛ ينتج تأثيراً حرارياً (كما من مصباح الأشعة تحت الحمراء))",
 "infrared spectrum": "طيف الأشعة تحت الحمراء (طيف الإشعاع تحت الأحمر)",
 "infrared therapy": "علاج بالأشعة تحت الحمراء (استخدام الأشعة تحت الحمراء (كما هو الحال بواسطة المصابيح تحت الحمراء أو وسادات التدفئة) لتخفيف الألم وزيادة الدورة الدموية لمنطقة معينة من الجسم)",
 "infrasonic": "تَحْت سَمْعِيّ, دُون صَوْتِيّ (ذو ترددات أدنى من الصوت المسموع)",
 "infrastructure": "بِنْيَة تَحْتِيَّة",
 "infrequency": "ندرة (ندرة ملحوظة)",
 "infrequent": "غير متكرر, نادر (غير متكرر؛ لا يحدث بانتظام أو على فترات قصيرة)\nمثال: نوبات غضب غير متكررة",
 "infrequently": "قليلاً ما, نادراً (ليس لمرات كثيرة)",
 "infrigidation": "تبريد, تثليج (عملية تبريد أو تجميد (مثل الطعام) لأغراض الحفظ)",
 "infringement": "مِسَاس",
 "infringement of copyright": "انتهاك حقوق النشر, تعدي على حق المؤلف (انتهاك الحقوق التي يكفلها حق المؤلف)",
 "infructescence": "إثمار, حمل ثمري (مرحلة الإثمار للنورة الزهرية)",
 "infundibulum": "قِمْع (أي جزء من أجزاء الجسم القمعية الشكل (خاصة السويقة النخامية))",
 "infuriated": "ثَائِر, مُسْتَشِيط (يتّسم بغضب شديد بالغ الحدّة)",
 "infuriating": "مُثِير لِلْجُنُون, مُسْتَفِزّ (مزعج أو مثير للاستياء بشكل شديد)",
 "infuriation": "إغاظة, إغضاب (شعور بالغضب الشديد ونفاد الصبر)",
 "infusion": "بث, حقن (فعل غرس أو إدخال عنصر أو صفة معدلة معينة) / تسريب ((طب) الإدخال السلبي لمادة (سائل أو دواء أو إلكتروليت) في وريد أو بين الأنسجة (كما عن طريق قوة الجاذبية)) / منقوع, نقع (عملية استخلاص خصائص فعالة معينة (كدواء من نبات) عن طريق النقع أو الغمر (عادة في الماء)) / مستخلص, منقوع (محلول يتم الحصول عليه عن طريق نقع مادة (عادة في الماء))\nمثال: يُعزى النجاح المستمر للفريق إلى الضخ المستمر للمواهب الجديدة",
 "infusorian": "إنفوسوريا (أي عضو من طويئفة الإنفوسوريا)",
 "inga": "إنجا (أي شجرة أو شجيرة من جنس الإنجا ذات أوراق ريشية وأزهار مبهرجة عادة ما تكون بيضاء؛ تزرع كنباتات زينة)",
 "inga edulis": "إنجا مأكولة, فاصوليا الآيس كريم (شجرة زينة دائمة الخضرة ذات كتل من الزهور البيضاء؛ توجد في أمريكا الاستوائية وشبه الاستوائية)",
 "inga laurina": "غواما (شجرة استوائية في أمريكا الوسطى وجزر الهند الغربية وبورتوريكو ذات سنابل من الزهور البيضاء؛ تستخدم كظل لمزارع البن)",
 "ingathering": "اسْتِجْدَاء, الْتِمَاس (طلب مبلغ من المال)\nمثال: مناشدة لجمع المال للأطفال الجياع",
 "ingenious": "عَبْقَرِيّ",
 "ingeniously": "ببراعة, بذكاء (بطريقة عبقرية ومبتكرة)\nمثال: كان لدى مزارع هامبشاير طيور من سلالات مختلفة، وميز ببراعة بين (الداكنة) و (البيضاء)",
 "ingeniousness": "عَبْقَرِيَّة",
 "ingenue": "إنجينو, فتاة ساذجة (دور امرأة شابة بريئة وبسيطة في مسرحية) / فتاة ساذجة (فتاة شابة بريئة وساذجة (خاصة كما تُصور على المسرح)) / الحبيبة البريئة, ممثلة دور الفتاة الساذجة (ممثلة تتخصص في لعب دور الفتاة الشابة البريئة والساذجة فنياً)",
 "ingenuity": "براعة, ذكاء (خاصية كون الشخص بارعاً) / إبداع, عبقرية (قوة الخيال الإبداعي)\nمثال: حبكة ذات براعة كبيرة",
 "ingenuous": "بسيط, ساذج (يتميز بعدم القدرة على إخفاء المشاعر؛ غير ماكر) / بَرِيء, فَطِرِيّ (يفتقر إلى الحِنكة أو المعرفة بشؤون الدنيا)\nمثال: اعتراف ساذج بالمسؤولية",
 "ingenuously": "بِبَرَاءَة, بِسَذَاجَة (بطريقة ساذجة)\nمثال: أجابت على أسئلة القاضي بسذاجة",
 "ingenuousness": "براءة, سذاجة (مباشر أو صريح بشكل منفتح) / بَرَاءَة, عَفْوِيَّة (صفة السذاجة البريئة)",
 "inger": "إنجريان, إيجري (عضو من الشعب الفنلندي الغربي الذي كان يعيش سابقاً في مقاطعة البلطيق حيث بنيت سانت بطرسبرغ)",
 "ingerman": "إنجريان, إيجري (عضو من الشعب الفنلندي الغربي الذي كان يعيش سابقاً في مقاطعة البلطيق حيث بنيت سانت بطرسبرغ)",
 "ingesta": "مأكولات, مغذيات (غذاء صلب وسائل يتم تناوله في الجسم عن طريق الفم)",
 "ingestion": "ابتلاع, استهلاك (عملية إدخال الطعام إلى الجسم عن طريق الفم (مثل الأكل))",
 "inglenook": "ركن الموقد, زاوية المدفأة (زاوية بجانب الموقد)",
 "inglorious": "مخزٍ, مهين (لا يجلب الشرف والمجد) / فَاضِح, مُخْزٍ ((للسلوك أو الشخصيَّة) يستحقّ العار أو يجلبه)\nمثال: قد يرقد هنا ميلتون صامت ومغمور",
 "ingloriously": "بِخِزْي, بِشَكْل مُخْزٍ (بطريقة مشينة أو لدرجة مشينة)\nمثال: كانت درجاته منخفضة بشكل مخز",
 "ingot": "سبيكة",
 "ingot iron": "حديد سبائك, حديد صب (حديد عالي النقاء)",
 "ingrained": "رَاسِخ, عَمِيق الجُذُور ((يستخدم خاصة للأفكار أو المبادئ) عميق الجذور؛ ثابت ومتمكّن بقوّة)",
 "ingraining": "ترسيخ, غرس (التعليم أو الطبع في الذهن عن طريق التلقين المتكرر)",
 "ingram": "إِنْجْرَام",
 "ingrate": "جاحد, ناكر للجميل (شخص لا يظهر أي امتنان)",
 "ingratiate": "تَمَلَّقَ",
 "ingratiating": "مُتَمَلِّق, مُتَوَدِّد (مَحْسُوب لإرضاء الآخرين أو كسب ودّهم) / مُتَمَلِّق, مُتَوَدِّد (قادر على كسب الرضا والاستحسان)",
 "ingratiatingly": "تقرباً, تملقاً (بطريقة متملقة تهدف لكسب الرضا)\nمثال: تتصرف تملقاً تجاه رئيسها",
 "ingratiation": "تزلّف, تودد (فعل كسب القبول أو المودة عن طريق التملق المقنع والدقيق)\nمثال: رفضت استخدام التزلف لكسب الحظوة",
 "ingratiatory": "مُتَمَلِّق, مُتَوَدِّد (مَحْسُوب لإرضاء الآخرين أو كسب ودّهم) / اسْتِمَالِيّ, مُتَمَلِّق (يسعى إلى الإقناع بأسلوب لطيف ومتملّق)",
 "ingratitude": "جحود, نكران الجميل (الافتقار إلى الامتنان)",
 "ingredient": "مُقَوِّم",
 "ingress": "دخول (فعل الدخول) / احتجاب, دخول ((في علم الفلك) اختفاء جرم سماوي قبل الكسوف)\nمثال: قامت بدخول مهيب",
 "ingressive": "صوت شهيقي (صوت كلامي يتدفق فيه تيار الهواء إلى الداخل عبر الفم أو الأنف)",
 "ingrian": "الإنغرية (لغة فينية يتحدث بها الإنغريون) / إنجريان, إيجري (عضو من الشعب الفنلندي الغربي الذي كان يعيش سابقاً في مقاطعة البلطيق حيث بنيت سانت بطرسبرغ)",
 "ingrian language": "الإنغرية (لغة فينية يتحدث بها الإنغريون)",
 "ingroup": "بطانة, زمرة (دائرة حصرية من الناس ذات هدف مشترك)",
 "ingrowing": "غائِر, نامٍ لِلدَّاخِل (يَنْمو بِشَكْل غَيْر طَبيعِيّ داخِل الجِسْم أو اللَّحْم)",
 "ingrown": "غائِر, نامٍ لِلدَّاخِل (يَنْمو بِشَكْل غَيْر طَبيعِيّ داخِل الجِسْم أو اللَّحْم)",
 "ingrown hair": "شعر غائر (شعرة لا تخرج من الجريب ولكنها تظل مغروسة في الجلد (مما يسبب عادة التهاباً))",
 "ingrown toenail": "ظفر غائر, ظفر ناشب (ظفر قدم تكون طرفه الحر أو حوافه مغروسة في اللحم المحيط)",
 "ingrowth": "نمو داخلي (شيء ينمو نحو الداخل)",
 "inguen": "أربية, مغبن (الثنية عند تقاطع الجزء الداخلي من الفخذ مع الجذع مع المنطقة المجاورة)",
 "inguinal": "أربي (مكون من أو متعلق بـ أو بالقرب من الأربية (منطقة العانة))",
 "inguinal canal": "قناة أربية (ممر مائل عبر جدار البطن السفلي؛ في الذكور هو الممر الذي تنزل عبره الخصيتان إلى كيس الصفن ويحتوي على الحبل المنوي؛ وفي الإناث ينقل الرباط المستدير…)",
 "inguinal hernia": "فتق إربي (فتق تدخل فيه حلقة من الأمعاء القناة الإربية؛ وهو النوع الأكثر شيوعاً من الفتق عند الذكور)",
 "ingush": "إِنْغُوشِيّ",
 "ingushetia": "إِنْغُوشِيتِيَا, إنغوشيا",
 "inh": "آيزونيازيد, نيدرازين (دواء مضاد للبكتيريا (الاسم التجاري نيدرازين) يستخدم لعلاج السل)",
 "inhabit": "أَقَام, قَطَن (فعل تعدي من قَامَ بمعنى جَعَلَه يقوم؛ ضد أجْلَسَ؛ الشيءَ: جعله يقوم أو جعله قائما مع معنى الثبات)\nمثال: أقام سامي مع بعض الأصدقاء.",
 "inhabitable": "صَالِح لِلسَّكَن, قَابِل لِلسُّكْنَى (مُناسِب لِلإِقامَة وَالعَيْش فيه)",
 "inhabitancy": "استيطان, سكنى (فعل السكن أو العيش الدائم في مكان ما (للإنسان والحيوان))",
 "inhabitant": "سَاكِن, سَاكِنَة",
 "inhabitation": "استيطان, سكنى (فعل السكن أو العيش الدائم في مكان ما (للإنسان والحيوان))",
 "inhabited": "مأهول, مسكون (به سكان؛ يُعاش فيه)\nمثال: المناطق المأهولة من الأرض",
 "inhalant": "استنشاقي, شهيقي (يقوم بالاستنشاق أو يخدم عملية الاستنشاق) / دواء استنشاق, مستنشق (دواء يؤخذ عن طريق استنشاقه) / مستنشق (مادة يتم استنشاقها)\nمثال: مسام شهيقي",
 "inhalation": "شَهِيق",
 "inhalation anaesthetic": "مخدر استنشاقي (غاز ينتج تخديراً عاماً عند استنشاقه)",
 "inhalation anesthesia": "تخدير بالاستنشاق (تخدير عام يتحقق عن طريق إعطاء مخدر بالاستنشاق)",
 "inhalation anesthetic": "مخدر استنشاقي (غاز ينتج تخديراً عاماً عند استنشاقه)",
 "inhalation anthrax": "جمرة خبيثة رئوية (شكل من أشكال عدوى الجمرة الخبيثة المكتسبة عن طريق استنشاق الغبار المحتوي على البكتيريا)",
 "inhalation general anaesthetic": "مخدر استنشاقي (غاز ينتج تخديراً عاماً عند استنشاقه)",
 "inhalation general anesthetic": "مخدر استنشاقي (غاز ينتج تخديراً عاماً عند استنشاقه)",
 "inhalator": "جهاز استنشاق, مستنشقة (موزع ينتج بخاراً كيميائياً يتم استنشاقه لتخفيف احتقان الأنف) / جهاز تنفس صناعي, منشقة (جهاز تنفس لإعطاء تنفس صناعي طويل الأمد)",
 "inhale": "شَهَقَ (تنفس بصوت عالٍ وبشكل مفاجئ نتيجة التعب أو الخوف أو الضيق؛ في لغة الطيور: أصدرت صوتًا عاليًا يشبه الشهيق)",
 "inhaler": "مِنْشَقَة",
 "inharmonic": "مُتَنافِر, نَشاز (غَيْر مُنْسَجِم صَوْتِيًّا؛ ذو أصْوات مُتَضارِبَة)",
 "inharmonious": "غَيْرُ مُتَنَاسِقٍ, مُتَنَافِر (يَفْتَقِرُ إِلَى الِانْسِجَامِ بَيْنَ أَجْزَائِهِ) / غير متناغم, نشاز (ليس في انسجام)",
 "inharmoniousness": "عدم انسجام, نشاز (افتقار للتناغم)",
 "inherence": "تأصل, رسوخ (حالة كونه متأصلاً؛ حالة كونه سمة ثابتة)\nمثال: تأصل تعدد المعاني في اللغة البشرية",
 "inherency": "تأصل, رسوخ (حالة كونه متأصلاً؛ حالة كونه سمة ثابتة)\nمثال: تأصل تعدد المعاني في اللغة البشرية",
 "inherent": "مُتَأَصِّل",
 "inherent aptitude": "غريزة, فطرة (نمط سلوكي فطري يستجيب غالبًا لمحفزات محددة)\nمثال: غريزة وضع البيض عند سمك السلمون",
 "inherently": "بالفطرة, جوهرياً (بطريقة متأصلة)\nمثال: موضوع النشاط الجنسي الصريح، الذي يتم تصويره على أنه مرغوب فيه ومثير جوهرياً",
 "inherit": "وَرَثَ",
 "inheritable": "قابل للتوريث, وراثي (قابل لأن يورَّث)\nمثال: سمات وراثية مثل لون العين",
 "inheritance": "مِيرَاث, إرْثْ",
 "inheritance tax": "ضريبة التركات, ضريبة الميراث (ضريبة على تركة الشخص المتوفى)",
 "inherited": "عَائِلِيّ, وِرَاثِيّ (يحدث بين أفراد الأسرة عادة عن طريق الوراثة)",
 "inherited disease": "اضطراب جيني, مرض وراثي (مرض أو اضطراب يتم توريثه جينياً)",
 "inherited disorder": "اضطراب جيني, مرض وراثي (مرض أو اضطراب يتم توريثه جينياً)",
 "inherited wealth": "ثروة موروثة (ثروة يتم توريثها بدلاً من اكتسابها)",
 "inheriting": "ذُو حَقِّ إِرْث, وَارِث (له الحق القانوني في الميراث)",
 "inheritor": "وريث (شخص يحق له بموجب القانون أو شروط الوصية أن يرث تركة شخص آخر)",
 "inheritress": "وريثة (أنثى ترث)",
 "inheritrix": "وريثة (أنثى ترث)",
 "inhibited": "مقيد, مكبوت (تم كبحه أو تقييده أو منعه)\nمثال: في ظروف معينة، يمكن أن تظهر ردود الفعل الشرطية المكبوتة سابقاً",
 "inhibition": "تحريم, حظر (فعل الحظر أو المنع أو التحريم (أو مثال عليه)) / كبت, كبح ((علم النفس) الاستبعاد الواعي للأفكار أو الرغبات غير المقبولة) / تثبط, كبت (جودة كون المرء مكبوتاً) / تثبيط, كبح ((علم وظائف الأعضاء) العملية التي يمكن للأعصاب من خلالها تأخير أو منع عمل عضو أو جزء)\nمثال: تم تقييدهم بموجب حظر في ميثاقهم",
 "inhibitor": "مانع, مثبط (مادة تؤخر أو توقف نشاطاً ما)",
 "inhibitory": "قَمْعِيّ, كَبْتِيّ (يُقيِّد الفعل أو يكبته)",
 "inhomogeneity": "عَدَم تَجَانُس (صفة كون الشيء غير متجانس)",
 "inhomogeneous": "غَيْر مُتَجَانِس, غَيْر مُنْتَظِم (ليس متجانساً؛ غير موحَّد في التركيب)",
 "inhospitable": "طارد, غير ملائم (غير مواتٍ للحياة أو النمو) / جاف, غير مضياف (غير مضياف)\nمثال: الصحراء القاحلة الطاردة للحياة",
 "inhospitableness": "بخل, سء الضيافة (امتلاك طبع غير ودود وغير مضياف) / عدم ملاءمة, قسوة (البيئة) (الحالة البيئية في منطقة تفتقر إلى مناخ أو تضاريس مواتية للحياة أو النمو)",
 "inhospitably": "بجفاء, بدون ترحيب (بطريقة غير مضيافة)\nمثال: استقبلتها عائلتها الجديدة بجفاء",
 "inhospitality": "جَفَاء, سُوء الِاسْتِقْبَال (ترحيب غير لطيف وغير مراعٍ)\nمثال: لقد فوجئ بمثل هذا الجفاء",
 "inhuman": "غَيْر إِنْسَانِيّ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "inhuman treatment": "قسوة, معاملة غير إنسانية (فعل قاس؛ إلحاق متعمد للألم والمعاناة)",
 "inhumane": "غير إنساني, وحشي (يفتقر ويعكس الافتقار إلى الشفقة أو الرحمة)\nمثال: البشر غير إنسانيين فطرياً؛ هذا يفسر الكثير من البؤس والمعاناة في العالم",
 "inhumanely": "بلا إنسانية, بوحشية (بطريقة غير إنسانية)\nمثال: عومل أسرى الحرب بلا إنسانية",
 "inhumaneness": "لَا إِنْسَانِيَّة, وَحْشِيَّة (صفة الافتقار إلى الرحمة أو مراعاة الآخرين)",
 "inhumanity": "فظاعة, وحشية (عمل من أعمال القسوة الفظيعة) / لَا إِنْسَانِيَّة, وَحْشِيَّة (صفة الافتقار إلى الرحمة أو مراعاة الآخرين)",
 "inhumation": "دفن, مواراة الثرى (الطقس المتمثل في وضع الجثمان في القبر)",
 "inhumed": "مَدْفُون (موضوع في قبر)\nمثال: الجثث المدفونة على عجل",
 "inimical": "غَيْر وُدِّيّ, مُعَادٍ (ليس ودِّيّاً؛ يتَّسم بالجفاء)",
 "inimitable": "فَرِيد, لَا يُضَاهَى (يتحدّى التقليد؛ لا مثيل له)",
 "inimitably": "بشكل فريد, بشكل لا يضاهى (بطريقة لا يمكن تقليدها)\nمثال: لديه أسلوب مسهب بشكل لا يضاهى",
 "inion": "قَمَحْدُوَة",
 "iniquitous": "ظَالِم",
 "iniquitously": "بإجحاف, بظلم فادح (بطريقة ظالمة وشنيعة)\nمثال: لقد اعتقدوا حقاً أن معاهدة فرساي كانت ظالمة بإجحاف",
 "iniquity": "جور, حيف (فعل غير عادل) / شر, فجور (سلوك مرفوض أخلاقياً)",
 "initial": "أَوَّلِيّ, أَوَّل / أَوَّل (الذي يكون ترتيبه وَاحِد، الذي كان قبل الآخرين؛ الأوَّل اسم من الأسماء الحسنى) / حَرْف أَوَّلِيّ (طَرَف وَجَانِب وَحَدّ؛ رَمْز مخطوط أو مطبوع يقوم مقام صوت أو كلمة أو عبارة أو معنى)\nمثال: لم تكن أول مرة.",
 "initial offering": "اكتتاب عام أولي, طرح أولي (أول عرض للشركة لبيع الأسهم للجمهور)",
 "initial public offering": "اكتتاب عام أولي, طرح أولي (أول عرض للشركة لبيع الأسهم للجمهور)",
 "initial rhyme": "جناس استهلالي, قافية أولية (استخدام نفس الحرف الساكن في بداية كل مقطع مشدد في بيت الشعر)",
 "initial stress": "نبر أولي (نبر على المقطع الأول من الكلمة)",
 "initialisation": "تهيئة منخفضة المستوى ((علوم الكمبيوتر) تنسيق القطاعات على سطح محرك الأقراص الثابتة حتى يتمكن نظام التشغيل من الوصول إليها وتحديد موضع البداية)",
 "initialism": "اختصار بالأحرف الأولى (اختصار يتكون من الحروف الأولى لعدة كلمات في الاسم ويُنطق كل حرف على حدة) / لفظة أوائلية, نحت (كلمة تتكون من الحروف الأولى لعدة كلمات في الاسم وتُنطق ككلمة واحدة)",
 "initialization": "تهيئة منخفضة المستوى ((علوم الكمبيوتر) تنسيق القطاعات على سطح محرك الأقراص الثابتة حتى يتمكن نظام التشغيل من الوصول إليها وتحديد موضع البداية)",
 "initially": "أول الأمر, في البداية (في البدء)\nمثال: في البداية لم يلاحظ أي شيء غريب",
 "initiate": "بَادَرَ / عُضْو جَدِيد, مُنْتَسِب (جُزْء من الجَسَد؛ مُشْتَرِك فِي جَمْعِيَّة أو شَرِكَة أو حِزْب أو نَادٍ)\nمثال: اذكر كل عضو باسمه.",
 "initiation": "إطلاق, استحثاث (فعل يحرك سلسلة من الأحداث) / إنشاء, ابتداء (فعل بدء شيء ما لأول مرة؛ تقديم شيء جديد) / اطلاع, دراية (الحكمة كما تتضح من امتلاك المعرفة) / انضمام, تعيين (الدخول الرسمي في منظمة أو منصب أو وظيفة)\nمثال: تطلعت إلى بدايتها كشخص بالغ",
 "initiative": "مُبَادَرَة",
 "initiator": "مُبَادِر",
 "initiatory": "اسْتِهْلَالِيّ, تَدْشِينِيّ (يَهْدِفُ إِلَى تَحْرِيكِ الأُمُورِ أَوْ إِطْلَاقِهَا)",
 "injectable": "قابل للحقن ((يستخدم للأدوية) قابل لأن يُحقن)",
 "injectant": "حقنة, مادة محقونة (أي محلول يتم حقنه (كما في الجلد))",
 "injection": "حُقْنَة, حَقْن",
 "injectiveness": "تباين, خاصية التباين ((في الرياضيات) حالة أو صفة الدالة المتباينة: بحيث يرتبط كل عنصر في المجال المقابل (أو المدى) بعنصر واحد على الأكثر من المجال)",
 "injector": "حاقن (جهاز للحقن (مثل الماء في غلاية محرك بخاري أو الجسيمات في مسرع وما إلى ذلك)) / حاقن بخاري, ضاغط حراري (الحاقن أو اللافظ أو الحاقن البخاري أو المضخة النفاثة هو نوع من المضخات)\nمثال: بناءً على التطبيق المحدد، يمكن للحاقن أن يتخذ شكل مضخة نفاثة، أو قاذف مياه، أو قاذف تفريغ، أو قاذف بخار نفاث، أو شفاط",
 "injector pen": "قلم الحقن (قَطَعَ جزءا من شيء لتزيينه وتحسينه)\nمثال: ارسم بقلم رصاص.",
 "injera": "إِينْجِيرَا",
 "injudicious": "أَخْرَق, غَيْرُ حَصِيف (يفتقر إلى الحكمة أو التمييز أو يُظْهِر ذلك)",
 "injudiciously": "بطيش, بغير حكمة (بطريقة غير حكيمة)\nمثال: استُخدمت اختبارات الذكاء هذه بغير حكمة لسنوات عديدة",
 "injudiciousness": "رعونة, طيش (سمة الافتقار للحصافة) / رعونة, سوء تقدير (الافتقار إلى الحكم الجيد)",
 "injun": "جلد أحمر ((عامية) مصطلح مهين للهنود الأمريكيين)",
 "injunction": "أمر قضائي زجري, أمر منع ((في القانون) تدبير قضائي يصدر لمنع طرف من القيام بنشاط معين أو الاستمرار فيه) / أمر زجري, إنذار قضائي (أمر رسمي أو تحذير)\nمثال: كان يتم الحصول على الأوامر القضائية سابقاً بموجب مذكرة ولكن الآن بموجب أمر قضائي",
 "injure": "جَرَحَ (كَلَمَ، شَقَّ اللَحْم وأسَالَ الدَمّ؛ صَادَ أو اكْتَسَبَ)\nمثال: ذلك سيهيج الجرح.",
 "injured": "مجروح, مصاب (تعرض للأذى) / مَجْرُوح, مُهَان (متألم عاطفياً أو منزعج أو متضايق)\nمثال: جنود مصابون",
 "injured party": "ضَحِيَّة حادِث, مُصاب (شخص أصيب أو قتل في حادث)",
 "injurious": "مُؤْذٍ, مُضِرّ (يُلحِق الأذى أو الضَّرَر بِالصِّحَّة أو المَصْلَحَة)",
 "injuriously": "بشكل مؤذ, بضرر (بطريقة تسبب الأذى)",
 "injuriousness": "إِيذَاء, ضَرَر (التدميرية التي تسبب ضرراً أو أذى)",
 "injury": "جُرْح, إِصَابَة (كَلَمَ، شَقَّ اللَحْم وأسَالَ الدَمّ؛ صَادَ أو اكْتَسَبَ)\nمثال: ذلك سيهيج الجرح.",
 "injury time": "وَقْتٌ بَدَلُ الضَّائِع (\"بَقِيَ وَقْتاً عِنْدَهُ \" : أَيْ مِقْدَاراً مِنَ الزَّمَنِ؛ \"جَاءَ فِي الوَقْتِ الْمُنَاسِبِ \" : فِي اللَّحْظَةِ الْمُنَاسِبَةِ)\nمثال: حان وقت الذهاب.",
 "injustice": "ظُلْم, جَوْر (الثَلَاثُ الظُلَم: الليلة التاسعة عشر، والعشرون، والحادية والعشرون من كل شهر قمري، وسميت بذلك لظلمتها. يسبقها الثلاث الدُرَع ويليها الثلاث الحنادس)\nمثال: نحن نرفض الظلم.",
 "ink": "حِبْر, مِدَاد ((حَبَرَه): سَرَّه ونَعَّمَه؛ (حَبَرَ) الْبُرْدَ: وَشّاه وزَيَّنَه)\nمثال: لا تكتب بالحبر.",
 "ink bottle": "زجاجة حبر (زجاجة حبر)",
 "ink cartridge": "خرطوشة حبر (خرطوشة تحتوي على حبر ويمكن استبدالها)",
 "ink eraser": "ممحاة حبر (ممحاة تزيل علامات الحبر)",
 "ink-black": "أَسْوَد حِبْرِيّ (بلون الحبر الأسود)",
 "ink-jet": "نافث للحبر (مكون من أو متعلق بطابعة نافثة للحبر)",
 "ink-jet printer": "طابعة نافثة للحبر (طابعة تنتج الحروف عن طريق قذف قطرات حبر مشحونة كهربائياً)",
 "inka": "إنكا (فرد من شعب الكيشوا يعيش في وادي كوزكو في بيرو)",
 "inkberry": "بهشية ملساء, توت الحبر (بهشية دائمة الخضرة من شرق أمريكا الشمالية بأوراق جلدية مستطيلة وتوت أسود صغير)",
 "inkblot": "بقعة حبر (لطخة ناتجة عن الحبر)",
 "inkblot test": "اختبار بقع الحبر, اختبار رورشاخ (اختبار إسقاطي يستخدم بقع حبر متناظرة ثنائية الجانب؛ يذكر الأشخاص ما يرونه في بقعة الحبر)",
 "inkiness": "أسود, سواد (اللون اللا لوني الأقل سطوعاً)",
 "inking pad": "محبرة ختم, وسادة حبر (كتلة من مادة ماصة مشبعة بالحبر؛ تستخدم لنقل الحبر بالتساوي إلى ختم مطاطي)",
 "inkle": "شريط كتاني (شريط كتاني يستخدم للزخرفة)",
 "inkling": "إحساس مبهم, تلميح (اقتراح طفيف أو فهم غامض)\nمثال: لم يكن لديه أي فكرة عما كان على وشك الحدوث",
 "inkpad": "محبرة ختم, وسادة حبر (كتلة من مادة ماصة مشبعة بالحبر؛ تستخدم لنقل الحبر بالتساوي إلى ختم مطاطي)",
 "inkpot": "زجاجة حبر (زجاجة حبر)",
 "inkstand": "دَوَاة",
 "inkstone": "حَجَر حَبْر (حَجَرَ عليه الأمرَ:مَنَعَه منه ، حجر الشّيء على نفسه:خَصَّها به وقصره عليها؛ الحجْرُ: المَنْعُ مِن التَّصَرُّفِ ، وحَجَرَ عَلَيْهِ القاضِي يَحْجُرُ حَجْراً، إِذا مَنَعَه مِن التَّصَرُّفِ فِي مالِه)\nمثال: عوقب زيري بالحجر.",
 "inkwell": "دَوَاة, مِحْبَرَة",
 "inky": "أَسْوَد حِبْرِيّ (بلون الحبر الأسود)",
 "inky cap": "فطر الحبر (له قبعة تذوب إلى سائل حبري بعد نضج الأبواغ)",
 "inky-black": "أَسْوَد حِبْرِيّ (بلون الحبر الأسود)",
 "inky-cap mushroom": "فطر الحبر (له قبعة تذوب إلى سائل حبري بعد نضج الأبواغ)",
 "inlaid": "مُرَصَّع, مُطَعَّم (مزين بالتطعيم أو الترصيع)",
 "inland": "بَرًّا, نَحْو الدَّاخِل (نحو أو داخل منطقة) / دَاخِلِيّ (يقع بعيداً عن ساحل المنطقة أو حدودها)\nمثال: المدينة تقع على بعد خمسة أميال للداخل",
 "inland bill": "كمبيالة داخلية (كمبيالة مسحوبة ومستحقة الدفع في نفس البلد)",
 "inland revenue": "إدارة الإيرادات الداخلية, مصلحة الضرائب (مجلس تابع للحكومة البريطانية يدير ويجمع الضرائب المباشرة الرئيسية)",
 "inland sea": "بَحْر دَاخِلِيّ (شَقّ الأرض؛ التَحَيُّر والبَهْت من الفزع أو من شدة العَطَش فنظر لا يقصد شيئا)\nمثال: هبطت على البحر.",
 "inlay": "ترصيع, تطعيم (زينة تُصنع عن طريق تركيب قطع من الخشب في فتحات مجهزة في سطح ما) / حشوة مصبوبة ((طب الأسنان) حشوة تتكون من مادة صلبة (مثل الذهب أو البورسلين) يتم تركيبها في تجويف في السن وتثبيتها في مكانها)",
 "inlet": "ثَغْر, ثَغْر بَحْرِيّ (ثَغَرَ الجدارَ ونحوهَ يَثْغَرُ ثَغْرًا: أحدث فيه ثُلْمة؛ ثَغَرَ فلانًا: كسر أسنانه)",
 "inlet manifold": "مشعب السحب (مشعب يحمل الوقود المتبخر من المكربن إلى صمامات السحب في الأسطوانات)",
 "inmarriage": "زواج الأقارب, زواج داخلي (الزواج داخل قبيلة أو مجموعة المرء كما يقتضي العرف أو القانون)",
 "inmate": "سَاكِن, سَاكِنَة",
 "inmost": "أَعْمَق, أَقْصَى الدَّاخِل (يقع أو يحدث في أعمق نقطة في الداخل) / أَعْمَق مَا فِي النَّفْس (في أعمق أعماق الذات)",
 "inn": "خَان, اِسْتِرَاحَة (النُزْل أو الفُنْدُق أو اِسْتِرَاحَة المسافرين؛ الحَانُوْت أو الدُكَّان)\nمثال: خان ياني سكورة.",
 "innards": "أحشاء, أمعاء (الأعضاء الداخلية مجتمعة (خاصة تلك الموجودة في تجويف البطن))",
 "innate": "فِطْرِيّ",
 "innate immunity": "مناعة طبيعية, مناعة فطرية (مناعة ضد المرض تحدث كجزء من التكوين البيولوجي الطبيعي للفرد)",
 "innate reflex": "رد فعل منعكس, منعكس (رد فعل تلقائي غريزي غير متعلم لمحفز)",
 "innately": "خلقياً, فطرياً (بطريقة فطرية)\nمثال: يقال أن الطفل مهيأ فطرياً لتعلم اللغة",
 "innateness": "أَصَالَة, فِطْرِيَّة (صفة كون الشيء فطرياً)",
 "inner": "داخلى",
 "inner cassock": "ثوب كاهن داخلي (رداء طويل بياقة يصل للقدمين، بأكمام ضيقة مدببة، يرتديه جميع رجال الدين والرهبان وغالباً طلاب اللاهوت الذكور)",
 "inner circle": "بطانة, زمرة (دائرة حصرية من الناس ذات هدف مشترك)",
 "inner city": "الأحياء الداخلية, قلب المدينة (القسم المركزي القديم والمكتظ بالسكان (والفقير عادة) من المدينة)",
 "inner ear": "أذن داخلية, تيه (نظام معقد من التجاويف المترابطة؛ معني بالسمع والتوازن)",
 "inner jib": "جيب داخلي (شراع جيب يقع بين الجيب الخارجي وشراع دعامة الصارية الأمامية في سفينة كبيرة مربعة الأشرعة)",
 "inner light": "النور الداخلي (حضور إلهي يؤمن به الكويكرز (جمعية الأصدقاء) بأنه ينير الروح ويهديها)",
 "inner mongolia": "مُنْغُولِيَا اَلدَّاخِلِيَّة",
 "inner product": "جُدَاء قِيَاسِيّ, ضَرْب نُقَطِيّ (عدد حقيقي (كمية قياسية) هو حاصل ضرب متجهين)",
 "inner rason": "ثوب كاهن داخلي (رداء طويل بياقة يصل للقدمين، بأكمام ضيقة مدببة، يرتديه جميع رجال الدين والرهبان وغالباً طلاب اللاهوت الذكور)",
 "inner resource": "قُوَّة كَامِنَة, مَوْرِد دَاخِلِيّ (مورد يوفره العقل أو القدرات الشخصية للفرد)\nمثال: امتلاك مورد داخلي ضد الوحدة",
 "inner tube": "أنبوب داخلي, إطار داخلي (أنبوب مطاطي قابل للنفخ يوضع داخل غلاف الإطار الهوائي)",
 "innermost": "أَعْمَق, أَقْصَى الدَّاخِل (يقع أو يحدث في أعمق نقطة في الداخل) / أَعْمَق مَا فِي النَّفْس (في أعمق أعماق الذات)",
 "innersole": "نعل داخلي (النعل الداخلي للحذاء حيث تستقر القدم)",
 "innervation": "إِمْدَاد عَصَبِيّ, تَعْصِيب (توزيع الألياف العصبية على عضو أو منطقة في الجسم) / استثارة, تهيج (الاستثارة العصبية أو الكهربائية لعضو أو عضلة أو غدة)",
 "inning": "شوط ((بيسبول) واحد من تسعة أقسام للعب يكون لكل فريق خلالها دور في الضرب)",
 "innings": "إننغز, جولة ضارب (دور الضرب للاعب أو فريق الكريكيت)",
 "innkeeper": "صاحب نُزل, مدير نُزل (المالك أو المدير لنُزل)",
 "innocence": "بَرَاءَة",
 "innocency": "بَرَاءَة (شيء أو فعل أو صفة بريئة)\nمثال: براءة الطفولة",
 "innocense": "المنازل الصينية الأرجوانية, كولينسيا ثنائية اللون (أزهار بيضاء وخزامية إلى زرقاء شاحبة تنمو في حلقات مثالية من شرائط متباعدة على نطاق واسع حول السيقان تشكل نوعاً من الباغودا؛ كاليفورنيا)",
 "innocent": "بَرِيء, بَرِيئَة / بَرِيء",
 "innocently": "ببراءة (بطريقة بريئة وساذجة) / بحسن نية (بطريقة غير مخالفة للقانون)\nمثال: ابتسمت له ببراءة",
 "innocents' day": "28 ديسمبر, عيد الأبرياء (28 ديسمبر، يحيي ذكرى ذبح هيرودس لأطفال بيت لحم)",
 "innocuous": "بَريء, غَيْر مُؤْذٍ (لا يَنْتُج عَنْه ضَرَر؛ بَريء وغَيْر خَطِر) / سليم, غير ضار (غير مؤذ للصحة الجسدية أو العقلية) / غَيْر مُسْتَهْجَن, مَقْبُول (لا يثير الاستنكار أو الاعتراض)",
 "innominate artery": "الجذع العضدي الرأسي, شريان لا اسم له (شريان كبير ينشأ من قوس الأبهر وينقسم إلى الشريان تحت الترقوة الأيمن والشريان السباتي المشترك الأيمن؛ يغذي الجانب الأيمن من الرقبة والرأس والكتف…)",
 "innominate bone": "عظم الحوض, عظم الورك (عظم كبير واسع يشكل نصف الحوض؛ يتكون من الحرقفة والإسك والعانة)",
 "innominate vein": "وريد عضدي رأسي, وريد لا اسم له (أوردة تتكون من اتحاد الوريد الوداجي الباطن والوريد تحت الترقوة)",
 "innovation": "اِبْتِكَار",
 "innovational": "ابْتِكَارِيّ, رَائِد (ينتج شيئاً لم يُنجَز أو يُختَبَر أو يُبتَكَر من قبل)",
 "innovative": "اِبْتِكارِيّ, مُبْتَكَر",
 "innovativeness": "إبداع, ابتكار (الأصالة بحكم تقديم أفكار جديدة)",
 "innovator": "رائد, سبّاق (شخص يساعد في فتح مجال جديد للبحث أو التكنولوجيا أو الفن)",
 "innoxious": "بَرِيء, غَيْر مُؤْذٍ (لا أثر سلبيّ له)",
 "innuendo": "تَلْمِيح",
 "innumerable": "لَا يُحْصَى, لَا يُعَدّ (أَكْثَر مِنْ أَنْ يُحْصَى أَوْ يُعَدّ)",
 "innumerableness": "كثرة لا تحصى, ما لا يحصى (عدد يفوق الحصر)",
 "innumerate": "أمي حسابياً, جاهل بالحساب (يفتقر إلى المعرفة وفهم المفاهيم والأساليب الرياضية)",
 "innumerous": "لَا يُحْصَى, لَا يُعَدّ (أَكْثَر مِنْ أَنْ يُحْصَى أَوْ يُعَدّ)",
 "inocor": "أمرينون, إينوكور (دواء (الاسم التجاري إينوكور) يستخدم عن طريق الوريد في حالات فشل القلب؛ يزيد من قوة انقباض عضلة القلب)",
 "inoculant": "لقاح, مادة التلقيح (مادة (فيروس أو سم أو مصل مناعي) يتم إدخالها في الجسم لإنتاج أو زيادة المناعة ضد مرض معين)",
 "inoculate": "لَقَّحَ",
 "inoculating": "تطعيم, تلقيح (فعل الحماية من المرض عن طريق إدخال لقاح في الجسم للحث على المناعة)\nمثال: فحص الأطباء المجندين لكن الممرضات قمن بالتطعيم",
 "inoculation": "تَلْقِيح",
 "inoculator": "مُلقح (ممارس طبي يلقح الناس ضد الأمراض)",
 "inoculum": "لقاح, مادة التلقيح (مادة (فيروس أو سم أو مصل مناعي) يتم إدخالها في الجسم لإنتاج أو زيادة المناعة ضد مرض معين)",
 "inocybe": "إِنُسِيب",
 "inodorous": "عديم الرائحة (ليس له رائحة)\nمثال: غاز عديم الرائحة",
 "inoffensive": "غير مؤذ, مسالم (لا يسبب أي أذى أو إزعاج) / غير جارح, غير مسيء (لا يسبب الغضب أو الانزعاج)\nمثال: رجل هادئ مسالم",
 "inoffensively": "بِشَكْل غَيْر مُسِيء, بِوَدَاعَة (بطريقة غير مسيئة بشكل غير سار)\nمثال: ذلك الوحش البائس، الفيل، يتنفس دون إيذاء خلفي مباشرة",
 "inoperable": "غير قابل للجراحة (غير مناسب للجراحة) / غَيْر قَابِل لِلتَّشْغِيل (غير قادر على أداء وظيفته الطبيعية)\nمثال: الانتشار جعل الورم غير قابل للجراحة",
 "inoperative": "غير ساري المفعول, غير عامل (لا يعمل أو لا يسري مفعوله)\nمثال: قانون غير ساري المفعول",
 "inopportune": "غير مناسب, في غير وقته (غير مناسب من حيث التوقيت)\nمثال: وصل في ساعة غير مناسبة للغاية",
 "inopportunely": "في غير محله, في وقت غير مناسب (في وقت غير ملائم)\nمثال: وصل في وقت غير مناسب تماماً ونحن نجلس لتناول العشاء",
 "inopportuneness": "عَدَم مُنَاسَبَة التَّوْقِيت, عَدَم مُوَاتَاة (صفة الحدوث في وقت غير مناسب)",
