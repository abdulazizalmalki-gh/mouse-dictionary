 "intestine": "مِعًى / مَعْي / مِعَاء / أَمْصِرَة / مَصِير / مُصْرَان",
 "inti": "إنتي (وحدة المال الأساسية في بيرو)",
 "intifada": "اِنْتِفَاضَة",
 "intifadah": "اِنْتِفَاضَة (انتفاضة من قبل العرب الفلسطينيين (في قطاع غزة والضفة الغربية) ضد إسرائيل في أواخر الثمانينيات ومرة أخرى في عام 2000)\nمثال: انتهت الانتفاضة الأولى عندما منحت إسرائيل حكماً ذاتياً محدوداً للسلطة الوطنية الفلسطينية في عام 1993",
 "intima": "بطانة, غلالة باطنة (الغشاء الداخلي للعضو (خاصة البطانة الداخلية لشريان أو وريد أو وعاء لمفاوي))",
 "intimacy": "أُلْفَة",
 "intimal": "بطاني (من أو يتعلق بالطبقة الداخلية للأوعية الدموية (البطانة))",
 "intimate": "أَلِيف, وَدُود (ذو مصالح أو مودة مشتركة؛ على صداقة راسخة) / حَمِيم, وَثِيق (يتميز بالمعرفة أو الصحبة أو الألفة الوثيقة) / ضَلِيع, مُطَّلِع (على دراية تامة عبر الدراسة أو التجربة) / أَلِيف, حَمِيمِيّ (يُوَفِّرُ جَوًّا دَافِئًا وَوُدِّيًّا وَغَيْر رَسْمِيّ)",
 "intimate apparel": "لانجري, ملابس داخلية نسائية (ملابس داخلية وملابس نوم نسائية)",
 "intimately": "بشكل وثيق, جيداً (بمعرفة كبيرة أو حميمة بشكل خاص) / بشكل وثيق, حميمياً (بطريقة وثيقة)\nمثال: كنا نعرفهم جيداً",
 "intimation": "إحساس مبهم, تلميح (اقتراح طفيف أو فهم غامض) / إِشَارَة, تَلْمِيح (اقتراح غير مباشر)\nمثال: لم يكن لديه أي فكرة عما كان على وشك الحدوث",
 "intimidate": "أَخَافَ, أَرْعَبَ",
 "intimidated": "مُخَوَّف, مُرْتَعِب (جُعل خائفاً أو وَجِلاً بسبب التهديدات)",
 "intimidating": "مُخِيف, مُرْهِب (يُثبِّط الهمّة من خلال بثّ الخوف)",
 "intimidation": "تَرْهِيب, تَخْوِيف",
 "into": "دَاخِل, إِلَّى / فِي (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "into the bargain": "فوق البيعة, في الصفقة (بالإضافة؛ فوق ما هو متوقع)\nمثال: فقد زوجته في الصفقة",
 "into the wind": "عكس الريح (في الاتجاه المعاكس لاتجاه هبوب الريح)\nمثال: طاروا عكس الريح",
 "intolerable": "غير محتمل, لا يطاق (لا يمكن تحمله أو الصبر عليه)\nمثال: درجة لا تطاق من العاطفية",
 "intolerably": "بشكل غير مقبول, بشكل لا يطاق (لدرجة غير مقبولة)\nمثال: نسبة الرصاص في مياه الشرب لدينا مرتفعة بشكل غير مقبول",
 "intolerance": "ضيق الصدر, عدم الاحتمال (نفاد الصبر مع المضايقات) / تعصب, عدم تسامح (عدم الاستعداد للاعتراف بالاختلافات في الآراء أو المعتقدات واحترامها)\nمثال: عدم احتماله للمقاطعات",
 "intolerant": "غَيْر مُتَسَامِح, مُتَعَصِّب (ضَيِّق التَّفْكِير بِشَأْن آرَائِه الرَّاسِخَة) / غير متسامح, متعصب (غير راغب في تحمل اختلاف الرأي)",
 "intolerantly": "بتعصب, بضيق أفق (بطريقة ليست منفتحة التفكير) / بتعصب, بلا تسامح (بطريقة غير متسامحة)\nمثال: طريقة تفكيره المنحازة بضيق أفق",
 "intonation": "تَجْوِيد, تَرْتِيل (جوّد القارئ:أتى بـ التّلاوة على وجهها الحقّ وراعى أحكام التّجويد في القرآن (قرأ القرآن مُجوّداً):رتّله ترتيلاً؛ تجوّد في العمل:تأنّق فيه،والشيء:تخيّره وطلب أن يكون جيّداً)",
 "intonation pattern": "نمط التنغيم (التنغيم المميز للأسئلة والطلبات والبيانات)",
 "intoned": "تَرْتِيلِيّ, رَتِيب (يُنطَق بإيقاع رتيب كالترتيل أو الإنشاد)",
 "intoxicant": "مُخَدِّر, مُسْكِر (يُسَبِّب السُّكْر أو النَّشْوَة) / مادة مسكرة, مُسكر (عقار يمكن أن ينتج حالة من السكر) / كحول, مشروب كحولي (سائل أو شراب يحتوي على الكحول كعامل نشط)\nمثال: الكحول (أو الشراب) دمره",
 "intoxicate": "أَسْكَرَ (الشرابُ فلانًا: جعله يَسْكَر؛ فلانٌ فلانًا: سقاهُ خمرًا فجعله يسكر)",
 "intoxicated": "ثمل, سكران (مذهول أو متهيج بواسطة مادة كيميائية (خاصة الكحول)) / ثَمِل, نَشْوَان (كأنه تحت تأثير الكحول مجازاً)\nمثال: حشد صاخب من البحارة المخمورين",
 "intoxicating": "مُسْكِرٌ",
 "intoxication": "إِنْتِشاء",
 "intra vires": "داخل السلطة, ضمن الصلاحيات (ضمن القوة القانونية أو السلطة لشخص أو مسؤول أو هيئة، إلخ)",
 "intracapsular surgery": "جراحة داخل المحفظة (جراحة الساد التي يتم فيها إزالة العدسة بالكامل)",
 "intracellular": "داخل الخلية (يقع أو يحدث داخل الخلية أو الخلايا)\nمثال: سائل داخل الخلية",
 "intracellular fluid": "سائل داخل خلوي (سائل موجود داخل أغشية الخلايا (يحتوي عادة على مواد مذابة))",
 "intracerebral": "داخل المخ (داخل المخ)",
 "intracranial": "داخل الجمجمة, داخل القحف (داخل الجمجمة)",
 "intracranial aneurysm": "أم الدم داخل القحف, تمدد الأوعية الدموية داخل القحف (تمدد الأوعية الدموية في أحد شرايين الجمجمة)",
 "intracranial cavity": "تجويف قحفي (التجويف المحاط بالجمجمة)",
 "intractability": "استعصاء, جموح (سمة صعوبة التأثير أو السيطرة)",
 "intractable": "صعب المراس, عنيد (غير طيع؛ صعب الإدارة أو التشكيل)\nمثال: طبع عنيد",
 "intractableness": "استعصاء, جموح (سمة صعوبة التأثير أو السيطرة)",
 "intractably": "بشكل مستعصٍ, بعناد (بطريقة مستعصية)",
 "intracutaneous": "داخل الأدمة, داخل الجلد (متعلق بالمناطق الواقعة بين طبقات الجلد)\nمثال: حقن داخل الأدمة",
 "intradepartmental": "داخل القسم, داخلي (داخل قسم واحد)\nمثال: مذكرات داخل القسم",
 "intradermal": "داخل الأدمة, داخل الجلد (متعلق بالمناطق الواقعة بين طبقات الجلد)\nمثال: حقن داخل الأدمة",
 "intradermal injection": "حقن في الأدمة (حقنة في الجلد)",
 "intradermal test": "اختبار داخل الأدمة (شكل من أشكال اختبار الجلد يتم فيه حقن مسبب الحساسية المشتبه به داخل الجلد)",
 "intradermally": "داخل الأدمة, في الجلد (في الجلد)",
 "intradermic": "داخل الأدمة, داخل الجلد (متعلق بالمناطق الواقعة بين طبقات الجلد)\nمثال: حقن داخل الأدمة",
 "intrados": "باطن العقد (المنحنى الداخلي للقوس)",
 "intragroup": "دَاخِلِيّ (يحدث داخل مؤسسة أو مجتمع واحد)",
 "intralinguistic": "داخل اللغة, ضمن لغوي (داخل لغة معينة)\nمثال: تباين ضمن لغوي",
 "intralobular": "داخل الفصيصات (داخل الفصوص أو الفصيصات)",
 "intramolecular": "داخل الجزيء (داخل الجزيء؛ يحدث عن طريق تفاعل بين أجزاء مختلفة من نفس الجزيء)",
 "intramural": "داخلي (يتم تنفيذه داخل حدود مؤسسة أو مجتمع)\nمثال: شارك معظم الطلاب بنشاط في البرنامج الرياضي الداخلي للكلية",
