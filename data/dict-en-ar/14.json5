 "impelled": "مَحْفُوز, مُنْدَفِع (مدفوع أو مُرغَم على الفعل بضغط معنوي)",
 "impellent": "حَاثّ, دَافِع (يدفع إلى الأمام أو يحفّز)",
 "impeller": "دافعة (شفرة الدوار (كما في ضاغط المحرك النفاث))",
 "impelling": "دَافِع, مُؤَثِّرٌ بِقُوَّة (فعّال بشكل ملحوظ كما لو كان بضغط عاطفيّ)",
 "impendence": "دنو, وشوك (حالة كونه وشيكاً وعرضة للحدوث قريباً)",
 "impendency": "دنو, وشوك (حالة كونه وشيكاً وعرضة للحدوث قريباً)",
 "impendent": "مُحْدِق, وَشِيك (قريب في الزمان؛ على وشك الحدوث)",
 "impending": "مُحْدِق, وَشِيك (قريب في الزمان؛ على وشك الحدوث)",
 "impenetrability": "اسْتِعْصَاء, عَمَايَة (عدم القدرة على الفهم بسبب الكثافة الشديدة للمعلومات أو التعقيد) / حَصَانَة, كَتَامَة (صفة كون الشيء غير قابل للاختراق (من قبل الناس أو الضوء أو القذائف وما إلى ذلك))",
 "impenetrable": "عَصِيّ, مُسْتَغْلَق (مستحيل الفهم تمامًا) / حصين, غير قابل للاختراق (لا يسمح بالاختراق أو المرور إلى الداخل أو خلاله) / كَثِيف, مُعْتِم (لَا يَسْمَحُ بِمُرُورِ الضَّوْءِ بِسَبَبِ كَثَافَةِ المَادَّة)\nمثال: قلعة حصينة",
 "impenetrableness": "اسْتِعْصَاء, عَمَايَة (عدم القدرة على الفهم بسبب الكثافة الشديدة للمعلومات أو التعقيد)",
 "impenitence": "إصرار على الذنب, عدم التوبة (سمة رفض التوبة)",
 "impenitency": "إصرار على الذنب, عدم التوبة (سمة رفض التوبة)",
 "impenitent": "غير نادم, مصر (غير تائب أو نادم) / غَيْرُ نَادِمٍ, قَاسِي الْقَلْبِ (لا يتأثر بالوعظ الأخلاقي)",
 "impenitently": "بإصرار, دون ندم (بطريقة لا تظهر الندم)\nمثال: كرر موقفه دون ندم",
 "imperative": "أَسَاسِيّ, ضَرُورِيّ",
 "imperative form": "صِيغَة الأَمْر (صيغة تعبر عن نية للتأثير على سلوك المستمع)",
 "imperative mood": "أَمْر (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة)\nمثال: إنه أمر مختلف .",
 "imperative programming": "برمجة أمرية (نموذج برمجة يصف الحساب من حيث البيانات التي تغير حالة البرنامج)\nمثال: البرمجة الإجرائية هي نوع محدد (أو مجموعة فرعية) من البرمجة الأمرية",
 "imperative verb": "فعل أمر (فعل في صيغة الأمر)",
 "imperatively": "بشكل آمر, بشكل حاسم (بطريقة آمرة وحاسمة)",
 "imperativeness": "إلحاح, إلزام (صفة الإصرار) / إلحاح, ضغط (حالة المطالبة بالملاحظة أو الانتباه)\nمثال: ضغط بمطلبه بإلحاح كبير",
 "imperceptibility": "عدم القابلية للإدراك (خاصية عدم إمكانية الإدراك بالعقل أو الحواس)",
 "imperceptible": "غير محسوس, غير ملحوظ (مستحيل أو صعب الإدراك بالعقل أو الحواس)\nمثال: انخفاض غير محسوس في درجة الحرارة",
 "imperceptibly": "بشكل طفيف جداً, بشكل غير محسوس (بطريقة غير محسوسة أو لدرجة غير محسوسة)\nمثال: ازدادت قوة وزير الدولة في لندن تدريجياً ولكن بشكل غير محسوس",
 "imperfect": "ناقص-غير كامل",
 "imperfect tense": "مستمر (زمن للأفعال يُستخدم في وصف حدث مستمر)",
 "imperfectibility": "عدم قابلية الكمال, قابلية النقص (القدرة على أن يصبح ناقصاً أو غير كامل)",
 "imperfectible": "قَابِل لِلنَّقْص (يمكن أن يُصبح ناقصًا أو معيبًا)",
 "imperfection": "عدم كمال, عيب (حالة أو مثال على كونه غير كامل)",
 "imperfective": "هَيْئَة عَدَم التَّمَام (جهة الفعل دون النظر إلى بداية أو اكتمال الحدث)",
 "imperfective aspect": "هَيْئَة عَدَم التَّمَام (جهة الفعل دون النظر إلى بداية أو اكتمال الحدث)",
 "imperfectly": "بشكل سيء, بشكل غير كامل (بطريقة غير كاملة أو معيبة)\nمثال: تطور الفص بشكل غير كامل",
 "imperfectness": "عدم كمال, عيب (حالة أو مثال على كونه غير كامل)",
 "imperforate": "غَيْرُ مَثْقُوب, مَسْدُود (غير مثقوب؛ ليس له فتحة)",
 "imperforate anus": "رتق الشرج (عيب خلقي في الشرج؛ يوجد انسداد جزئي أو كامل لفتحة الشرج)",
 "imperforate hymen": "غشاء بكارة غير مثقوب (غشاء بكارة مغلق تماماً بحيث لا يمكن لدم الحيض التدفق للخارج)",
 "imperial": "إِمْبِرَاطُورِيّ, مَلَكِيّ",
 "imperial aramaic": "آرَامِيَّة إِمْبَرَاطُورِيَّة",
 "imperial beard": "سُكسُوكَة إِمْبِرَاطُورِيَّة (لحية صغيرة مدببة كان يرتديها الإمبراطور نابليون الثالث)",
 "imperial capacity unit": "وحدة سعة بريطانية (وحدة قياس للسعة معتمدة رسمياً في النظام الإمبراطوري البريطاني)",
 "imperial decree": "مرسوم إمبراطوري (مرسوم يصدره حاكم ذو سيادة)",
 "imperial elephant": "ماموث إمبراطوري (أكبر أنواع الماموث المعروفة؛ عاش في أمريكا)",
 "imperial gallon": "غالون, غالون إمبراطوري (مقياس سعة إمبراطوري بريطاني (سائل أو جاف) يساوي 4 كوارتات)",
 "imperial japanese morning glory": "مجد الصباح الياباني الإمبراطوري (رفع شأن شيء أو شخص وعظمه وأضفى عليه قيمة كبيرة؛ أثنى على عظمة شيء أو شخص وأشاد به)\nمثال: المجد لأوكرانيا",
 "imperial mammoth": "ماموث إمبراطوري (أكبر أنواع الماموث المعروفة؛ عاش في أمريكا)",
 "imperial moth": "عثة إمبراطورية (عثة أمريكية كبيرة ذات أجنحة صفراء بعلامات أرجوانية أو بنية؛ تتغذى اليرقات على أشجار القيقب والصنوبر مثلاً)",
 "imperialism": "إِمْبِرْيَالِيَّة, اِسْتِعْمَارِيَّة",
 "imperialist": "إِمْبَرِيَالِيّ / إِمْبَرِيَالِيّ, إِمْبِرْيالِيَّة",
 "imperialistic": "إمبريالي, استعماري (من أو متعلق بالإمبريالية)\nمثال: حروب إمبريالية",
 "imperially": "إمبراطورياً (بطريقة إمبراطورية)\nمثال: صدر بمرسوم إمبراطوري",
 "imperialness": "إِمْبِرَاطُورِيَّة (صفة الارتباط بإمبراطورية أو إمبراطور أو إمبراطورة)",
 "imperious": "آمِر",
 "imperiously": "باستعلاء, بتسلط (بطريقة متسلطة)\nمثال: قاطعها باستعلاء",
 "imperiousness": "تجبر, تسلط (سمة التسلط والغطرسة)",
 "imperishability": "خلود, عدم القابلية للتلف (خاصية مقاومة التحلل)\nمثال: أعلن عن عدم قابلية المنتج للتلف",
 "imperishable": "خالد, غير قابل للتلف (ليس قابلاً للتلف) / خَالِد, رَاسِخ (يبقى مدّة طويلة؛ لا يزول بسهولة)",
 "imperishableness": "خلود, عدم القابلية للتلف (خاصية مقاومة التحلل)\nمثال: أعلن عن عدم قابلية المنتج للتلف",
 "imperishingness": "خلود, عدم القابلية للتلف (خاصية مقاومة التحلل)\nمثال: أعلن عن عدم قابلية المنتج للتلف",
 "imperium": "سلطة عليا, سيادة مطلقة (السلطة العليا أو الحكم المطلق) / إمبراطورية (المجال الذي يحكمه إمبراطور أو إمبراطورة؛ المنطقة التي تمارس عليها السيادة الإمبراطورية)",
 "impermanence": "زوال, عدم الدوام (خاصية عدم الوجود لمدد طويلة غير محددة)",
 "impermanency": "زوال, عدم الدوام (خاصية عدم الوجود لمدد طويلة غير محددة)",
 "impermanent": "زَائِل, غَيْرُ دَائِم (مَوْجُودٌ أَوْ بَاقٍ لِفَتْرَةٍ مَحْدُودَةٍ فَقَطْ) / زائل, غير دائم (ليس دائماً؛ لا يدوم)\nمثال: السياسة عامل غير دائم في الحياة",
 "impermeability": "عدم نفاذية, كتامة (خاصية الشيء الذي لا يمكن للسائل أن يتخلله)",
 "impermeable": "غير نفاذ, كتيم (يمنع خاصة السوائل من المرور أو الانتشار من خلاله)\nمثال: حجر كتيم",
 "impermeableness": "عدم نفاذية, كتامة (خاصية الشيء الذي لا يمكن للسائل أن يتخلله)",
 "impermissibility": "حَظْر, عَدَم جَوَاز (عدم الجواز كنتيجة لكون الشيء غير مسموح به)",
 "impermissible": "غير مسموح, ممنوع (غير مسموح به) / غَيْر مَسْمُوح بِهِ, مَحْظُور (غير مباح ولا يُسمَح به)\nمثال: سلوك غير مسموح به",
 "impermissibly": "بشكل غير مسموح به (ليس بشكل مسموح به)\nمثال: كان مستوى الرادون في القبو مرتفعاً بشكل غير مسموح به",
 "impersonal": "غَيْر شَخْصِيّ, مُحَايِد (لا تفضيل شخصيّ لديه) / عام, غير شخصي (لا يتعلق بالأشخاص الفرديين أو لا يستجيب لهم)\nمثال: شركة غير شخصية",
 "impersonally": "بشكل غير شخصي, بموضوعية باردة (بطريقة غير شخصية) / ببرود, برسمية (بدون دفء)\nمثال: عندما أخبرته عن روس وجدت صعوبة في التحدث بشكل غير شخصي",
 "impersonation": "انتحال شخصية, تقمص (تقليد سلوكيات شخص آخر) / انتحال الشخصية (التظاهر بأنك شخص آخر) / كَارِيكَاتِير, مُحَاكَاة سَاخِرَة (تمثيل لشخص يتم المبالغة فيه للتأثير الهزلي)",
 "impersonator": "منتحل شخصية (شخص ينتحل (عن طريق الاحتيال) مظهر شخص آخر)",
 "impertinence": "تطاول, وقاحة (مرح غير لائق) / صفاقة, وقاحة (سمة كون المرء وقحاً وسليطاً؛ يميل لأخذ حريات غير مستحقة) / صَفَاقَة, وَقَاحَة (عبارة وقحة)",
 "impertinent": "سَلِيط, صَفِيق (جريء ومتطاول بشكل غير لائق) / خَارِجِيّ, غَيْرُ جَوْهَرِيّ (لا يتعلق بالمسألة قيد البحث) / جَرِيءُ اللِّسَان, وَقِح (يتّسم بخفّة وقحة ومرح طافح)",
 "impertinently": "بصفاقة, بوقاحة (بطريقة وقحة أو سفيهة)\nمثال: كان رفيق أسمر نحيل يحدق عبر النافذة، مبتسماً بوقاحة",
 "imperturbability": "برود, رباطة جأش (ثقة بالنفس هادئة وغير مضطربة)\nمثال: أدى برباطة جأش المخضرمين",
 "imperturbable": "لَا يَتَزَعْزَع, وَقُور (لا يسهل إزعاجه أو إثارته؛ يتّسم بهدوء وضبط نفس شديدَين)",
 "imperturbableness": "برود, رباطة جأش (ثقة بالنفس هادئة وغير مضطربة)\nمثال: أدى برباطة جأش المخضرمين",
 "imperviable": "صامد, غير نفوذ (لا يسمح بالمرور أو غير قابل للتأثر)\nمثال: مادة غير منفذة للماء",
 "impervious": "صامد, غير نفوذ (لا يسمح بالمرور أو غير قابل للتأثر)\nمثال: مادة غير منفذة للماء",
 "imperviousness": "حَصَانَة, كَتَامَة (صفة كون الشيء غير قابل للاختراق (من قبل الناس أو الضوء أو القذائف وما إلى ذلك))",
 "impetiginous": "قوبائي (مكون من أو متعلق بـ أو مصاب بالقوباء)",
 "impetigo": "قوباء (عدوى جلدية معدية للغاية)",
 "impetuosity": "تسرع, هوج (اندفاع طائش)",
 "impetuous": "طَائِش, مُتَهَوِّر (يتّسم بالتسرّع المفرط وعدم التفكير أو التروّي) / جَامِح, عَنِيف (يتميّز بقوّة عنيفة)",
 "impetuously": "باندفاع, بتهور (بطريقة مندفعة أو متهورة؛ دون اتخاذ الحيطة)\nمثال: غالباً ما يتصرف باندفاع ويندم لاحقاً",
 "impetuousness": "تسرع, هوج (اندفاع طائش)",
 "impetus": "دفعة, قوة دافعة مفاجئة (فعل تطبيق قوة فجأة) / اندفاع, حافز (قوة تحرك شيئاً ما للأمام)\nمثال: الدفعة المفاجئة أسقطته أرضاً",
 "impiety": "جحود, عدم تقوى (الفسوق بحكم الافتقار إلى احترام الإله)",
 "impingement": "ارتطام, اصطدام (اصطدام حاد ناتج عن الضرب أو الاندفاع ضد شيء ما) / تأثير, تعدي (التأثير بقوة)\nمثال: استاءوا من طغيان القيم الأمريكية على الثقافة الأوروبية",
 "impinging": "اصطدام, تلامس (التقاء مادي لشيئين أو أكثر)\nمثال: التلامس مع الرصيف كشط الطلاء عن الهيكل",
 "impious": "آثم, غير تقي (يفتقر للتقوى أو تبجيل الإله) / عَاقّ, غَيْرُ بَارّ (يفتقر إلى الاحترام أو الطاعة الواجبة)",
 "impiously": "بفسوق, بكفر (بطريقة غير تقية)\nمثال: تحدى الأعضاء الشباب زعيمهم بفسوق",
 "impiousness": "جحود, عدم تقوى (الفسوق بحكم الافتقار إلى احترام الإله)",
 "impish": "مُشَاغِب, مُشَاكِس (مرح بطريقة مزعجة أو شقيّة)",
 "impishly": "بخبث محبب, بمشاغبة (بطريقة جريئة ولكن جذابة)\nمثال: طلبت منه بمشاغبة الدخول",
 "impishness": "شيطنة, عفرتة (سمة التصرف مثل العفريت الصغير)",
 "implacable": "عنيد, لا يلين (غير قابل للتهدئة أو الاسترضاء)\nمثال: عدو عنيد",
 "implant": "زرعة, غرسة (طرف صناعي يوضع بشكل دائم في الأنسجة)",
 "implantation": "زرع, غرس (إجراء جراحي يضع شيئاً ما في جسم الإنسان) / غرس (فعل الغرس أو الوضع في الأرض) / انغراس, تعشيش ((علم الأجنة) العملية العضوية التي تنغرس فيها البويضة المخصبة في بطانة الرحم لدى الثدييات المشيمية)\nمثال: زرع كريات مشعة في غدة البروستاتا",
 "implanted": "رَاسِخ, عَمِيق الجُذُور ((يستخدم خاصة للأفكار أو المبادئ) عميق الجذور؛ ثابت ومتمكّن بقوّة)",
 "implausibility": "استبعاد, عدم المعقولية (صفة إثارة عدم التصديق أو كون الشيء مستبعداً)",
 "implausible": "غير قابل للتصديق, غير معقول (لديه صفة تثير عدم التصديق)\nمثال: أعطى المعلم عذراً غير معقول",
 "implausibleness": "استبعاد, عدم المعقولية (صفة إثارة عدم التصديق أو كون الشيء مستبعداً)",
 "implausibly": "بِإِعْجَاز, بِشَكْل لَا يُصَدَّق (ليس من السهل تصديقه)\nمثال: بشكل لا يصدق، نجت من التحطم",
 "implement": "نَفَّذَ (نَفَذَ: من النّفَاذ وهو جَوَازُ الشيء من الشيء، والخُلُوصُ منه) / نَجَزَ / حَقَّقَ (حَقَّقَ (الأمرَ): أثبتَه وصدَّقَه؛ ويقال: حَقَّقَ الظنَّ، وحَقَّقَ القولَ والقضيّةَ؛ حَقَّقَ (الشيءَ والأمرَ): أحكمه؛ ويقال: حَقَّقَ الثوبَ: أحكم نَسْجَه)\nمثال: نفذ منا شيء ما.",
 "implemental": "أداتِيّ, وَسيلِيّ (يَعْمَل كَوَسيلَة أو أداة لِتَحْقيق غايَة)",
 "implementation": "تَنْفِيذ",
 "implemented": "قسري, مطبق (مجبور أو مكره أو وضع موضع التنفيذ)\nمثال: حياة من الخمول القسري",
 "implements of war": "أسلحة, تسليح (الأسلحة مجتمعة)",
 "implicated": "مُتَوَرِّطٌ بِجُرْم, مُتَّهَم (ضَالِعٌ فِي أَمْرٍ يَسْتَوْجِبُ المَسْؤُولِيَّة)",
 "implication": "تَلَازُم",
 "implicational": "استلزامي, تضمني (متعلق بـ أو مهتم بالاستلزام المنطقي)\nمثال: كليات اللغة الاستلزامية",
 "implicative": "إِيحَائِيّ, تَلْمِيحِيّ (يَمِيلُ إِلَى التَّلْمِيحِ أَوِ الإِيحَاء)",
 "implicit": "ضِمْنِيّ, مُطْلَق (بلا شكّ أو تحفُّظ) / ضمني, مفهوم ضمناً (مفهوم ضمناً وإن لم يتم التعبير عنه مباشرة؛ متأصل في طبيعة الشيء)\nمثال: اتفاق ضمني بعدم إثارة الموضوع",
 "implicitly": "ضمناً (بدون التعبير عن ذلك بوضوح) / بشكل مطلق, ثقة عمياء (دون شك أو تساؤل)\nمثال: يفترض ضمناً أنك تعرف الإجابة",
 "implicitness": "ضِمْنِيَّة (عدم الصراحة كنتيجة لكون الشيء ضمنياً أو غير مباشر)",
 "implied trust": "ائتمان ضمني (ائتمان يستنتج بحكم القانون)",
 "implike": "مُشَاغِب, مُشَاكِس (مرح بطريقة مزعجة أو شقيّة)",
 "implore": "رَجَا (رَجَا يرْجُو رَجْوًا ورَجاءً ورَجاةً ورَجاءةً ورَجاوةً ومَرْجاةً: رجاه أملًا به؛ ورَجَاه: ناشده وتوسّل إليه)",
 "imploring": "ضارع, متوسل (يقوم بالتوسل أو الاستجداء)",
 "imploringly": "بِإِلْحَاح, بِتَوَسُّل (بطريقة متوسلة)\nمثال: 'يجب أن تساعدني'، قالت بتوسل",
 "implosion": "انحباس صوتي, انطباق (المرحلة الانحباسية الأولية للصامت الانفجاري) / انفجار داخلي, انكماش (انهيار مفاجئ نحو الداخل)\nمثال: انفجار المصباح الكهربائي نحو الداخل",
 "implosion therapy": "علاج بالغمر, علاج بالفيضان (تقنية تستخدم في العلاج السلوكي؛ يتم إغراق العميل بتجارب من نوع معين حتى يصبح كارهاً لها أو مخدراً تجاهها)",
 "imply": "اِنْطَوَى",
 "impolite": "وَقِح",
 "impolitely": "بلا أدب, بوقاحة (بطريقة غير مؤدبة)\nمثال: عاملها بوقاحة",
 "impoliteness": "قلة أدب, وقاحة (أسلوب غير مهذب يتجاهل العرف الاجتماعي المقبول)",
 "impolitic": "أهوج, غير حكيم (يفتقر للحكمة أو الفطنة)\nمثال: نهج غير حكيم لقضية حساسة",
 "imponderable": "غير خاضع للقياس, لا يقدر (صعب أو مستحيل التقييم بدقة) / أمر لا يمكن تقديره, عامل لا يقاس (عامل لا يمكن تقييم آثاره بدقة)\nمثال: مثل هذه العوامل البشرية التي لا يمكن قياسها كالحساسية الجمالية",
 "import": "وَارِدَات / اِسْتِيرَاد, تَوْرِيد / اِسْتَوْرَدَ, وَرَّدَ (جاء بالوِرْد من مكان آخر؛ اِشْتَرَى البضائع من خارج البلاد وبَاعَها في البلاد)",
 "import barrier": "حاجز تجاري (أي تنظيم أو سياسة تقيد التجارة الدولية)",
 "import credit": "ائتمان استيراد (ائتمان يفتحه مستورد في بنك في بلده يمكن للمصدر السحب عليه)",
 "import duty": "رسوم استيراد (رسوم تفرض على الواردات)",
 "importance": "أَهَمِّيَّة",
 "important": "مُهِمّ",
 "important person": "شخصية مؤثرة, شخصية هامة (شخص تؤثر أفعاله وآراؤه بقوة على مسار الأحداث)",
 "importantly": "بشكل بارز, بشكل مهم (بطريقة مهمة) / بشكل مهم, والأهم من ذلك (بطريقة مهمة أو لدرجة مهمة)\nمثال: لعدة قرون، ظهر الهلام بشكل بارز ضمن الحلويات الإنجليزية، خاصة في المناسبات الاحتفالية",
 "importation": "استيراد (النشاط التجاري لشراء وجلب البضائع من دولة أجنبية) / استيراد, واردات (سلع (بضائع أو خدمات) يتم شراؤها من دولة أجنبية)",
 "imported": "مُسْتَوْرَد (يُسْتَخْدَمُ خَاصَّةً لِلْبَضَائِعِ المَجْلُوبَةِ مِنْ مَصْدَرٍ أَجْنَبِيٍّ)",
 "imported input": "مدخلات مستوردة (مادة وسيطة تحصل عليها دولة من شريك تجاري لإنتاج سلعة معينة)",
 "importee": "مستقدَم, وافد (شخص مستورد تم جلبه من بلد أجنبي)\nمثال: لعب الدور الرئيسي وافد من السويد",
 "importer": "مُسْتَوْرِد, مُسْتَوْرِدَة",
 "importing": "استيراد (النشاط التجاري لشراء وجلب البضائع من دولة أجنبية)",
 "importunate": "لَحُوح, مُلِحّ (يُعَبِّرُ عَنْ تَوَسُّلٍ دَائِمٍ وَجَادّ) / لحوح, ملح (مثابر أو مصر لدرجة الإزعاج)",
 "importunately": "بِإِلْحَاح, بِتَوَسُّل (بطريقة متوسلة)\nمثال: 'يجب أن تساعدني'، قالت بتوسل",
 "importunateness": "إلحاح, لجوجية (صفة الشخص الذي يكثر من الطلبات الملحة، ويكون متطلباً بجشع أو دون تفكير)",
 "importunity": "إلحاح (طلب وتوسل بإصرار) / إلحاح, لجوجية (صفة الشخص الذي يكثر من الطلبات الملحة، ويكون متطلباً بجشع أو دون تفكير)\nمثال: لم يترك لي إلحاحه بديلاً سوى الموافقة",
 "imposed": "مَفْرُوض (مُقرَّر بشكل سلطوي باعتباره إلزامياً)",
 "imposing": "جَلِيل, فَخْم (يُوصَف بِهِ مَظْهَر الشَّخْص أَوْ سُلُوكه؛ يَلِيق بِشَخْصٍ بَارِز) / فَخْم, مَهِيب (مُثير للإعجاب في الحجم أو الأسلوب أو المظهر)",
 "imposingly": "بشكل مثير للإعجاب, بشكل مهيب (بطريقة مثيرة للإعجاب)\nمثال: تقدم الطلاب بسرعة مثيرة للإعجاب",
 "imposition": "فَرْض",
 "impossibility": "مُسْتَحِيل",
 "impossible": "مُسْتَحِيل",
 "impossible action": "استحالة (بديل غير متاح)",
 "impossibleness": "استحالة (عدم القدرة على الوجود أو الحدوث)",
 "impossibly": "بِاسْتِحَالَة, بِشَكْل مُسْتَحِيل (إلى درجة يستحيل تحقيقها)\nمثال: كان يُعتقد لفترة طويلة أنها عملية صعبة بشكل مستحيل",
 "impost": "حجر الارتكاز (أدنى حجر في القوس الذي يبدأ منه القوس) / جمارك, مكوس (الأموال المحصلة بموجب التعريفة الجمركية)",
 "imposter": "دجال, محتال (شخص يقدم ادعاءات خادعة)",
 "impostor": "دجال, محتال (شخص يقدم ادعاءات خادعة)",
 "impostor syndrome": "متلازمة المحتال",
 "imposture": "انتحال الشخصية (التظاهر بأنك شخص آخر)",
 "impotence": "عَنَانَة, عُنَّة",
 "impotency": "ضَعْف, عَجْز (صفة الافتقار إلى القوة أو القدرة؛ الضعف والوهن) / عجز جنسي, عنانة (عدم قدرة (عادة عند الحيوان الذكر) على الجماع)",
 "impotent": "عاجز, عديم القوة (يفتقر للقوة أو القدرة) / عاجز جنسياً, عنين ((للذكر) غير قادر على الجماع)\nمثال: التكنولوجيا بلا أخلاق همجية؛ والأخلاق بلا تكنولوجيا عاجزة",
 "impotently": "بعجز, بقلة حيلة (بطريقة عاجزة)\nمثال: راقبه الحشد بقلة حيلة",
 "impounding": "حجز, مصادرة (وضع الممتلكات الخاصة في عهدة ضابط القانون)",
 "impoundment": "حجز, مصادرة (وضع الممتلكات الخاصة في عهدة ضابط القانون)",
 "impoverish": "أَفْقَر",
 "impoverished": "خَرِب, مُفْلِس (دُمِّرَ مَالِيًّا) / مُعْدَم, مُعْوِز (فقير لدرجة الحاجة إلى مساعدة الآخرين)",
 "impoverishment": "إفقار (فعل جعل شخص ما فقيراً) / عوز, فقر (حالة امتلاك القليل من المال أو عدم امتلاكه وقلة الممتلكات المادية)",
 "impracticability": "اسْتِحَالَة التَّطْبِيق, تَعَذُّر التَّنْفِيذ (صفة كون الشيء غير قابل للاستخدام)",
 "impracticable": "غَيْر عَمَلِيّ, غَيْر قَابِل لِلتَّطْبِيق (لا يمكن تنفيذه أو وضعه موضع التطبيق)",
 "impracticableness": "اسْتِحَالَة التَّطْبِيق, تَعَذُّر التَّنْفِيذ (صفة كون الشيء غير قابل للاستخدام)",
 "impracticably": "بشكل غير عملي, لدرجة غير ممكنة (لدرجة غير قابلة للتطبيق)\nمثال: لا يزال هذا مرتفعاً بشكل غير عملي",
 "impractical": "غير عملي (ليس عملياً؛ غير قابل للتطبيق أو لا يهتم بالأمور العملية) / خَيَالِيّ, غَيْرُ وَاقِعِيّ (غَيْرُ عَمَلِيٍّ وَلَا قَابِلٍ لِلتَّحْقِيق؛ تَأَمُّلِيّ)\nمثال: تعويم السفينة ثبت أنه غير عملي بسبب التكلفة",
 "impracticality": "لَا عَمَلِيَّة (الاهتمام بالاحتمالات النظرية بدلاً من الاستخدام الفعلي)",
 "impramine hydrochloride": "إيميبرامين, توفرانيل (مضاد اكتئاب ثلاثي الحلقات (الأسماء التجارية توفرانيل وغيرها) يستخدم لعلاج الاكتئاب السريري)",
 "imprecation": "دعاء بالشر, لعن (فعل استدعاء لعنة تستدعي الشر (وعادة ما تكون بمثابة إهانة)) / اتهام تشهيري, قذف (اتهام يتضمن تشهيراً وافتراء)\nمثال: عانى من لعنات الغوغاء",
 "imprecise": "غير دقيق (ليس دقيقاً)\nمثال: ملاحظات فلكية غير دقيقة",
 "imprecisely": "بشكل غير دقيق (بطريقة غير دقيقة)\nمثال: عبر عن نفسه بشكل غير دقيق",
 "impreciseness": "عَدَم دِقَّة (صفة الافتقار إلى الدقة)",
 "imprecision": "عَدَم دِقَّة (صفة الافتقار إلى الدقة)",
 "impregnability": "حصانة, منعة (امتلاك القوة لمقاومة الهجوم)",
 "impregnable": "لَا يُقْهَر, مَنِيع (لَا يُمْكِنُ التَّغَلُّبُ عَلَيْهِ أَوْ تَحَدِّيهِ أَوْ دَحْضُهُ) / قَابِل لِلحَمْل, قَادِر عَلَى الإِنْجَاب (قَادِر عَلَى الحَمْل والإِخْصَاب) / لَا يُقْهَر, مَنِيع (مُحَصَّنٌ ضِدَّ الهُجُوم؛ لَا يُمْكِنُ العَبَثُ بِه)",
 "impregnably": "بحصانة, بمنعة (بطريقة منيعة لا يمكن اختراقها)\nمثال: رؤية ذلك الوجه الصالح بمنعة كانت كافية لتجعل الدماء تتجمد في عروقهم",
 "impregnate": "حَبَّلَ ((حَبَلَه): شَدّه بالحبْل؛ (حَبَلَه) الصَّيْدَ: نَصَب لَهُ الحِبَالةَ وصاده بهَا. وَيُقَال: حَبَلَت فُلَانَةُ فلَانًا: أوقعَتْه فِي شِباك حُبّها وسحَرته)\nمثال: حبل الكذب قصير.",
 "impregnation": "تَلْقِيح",
 "impresario": "متعهد حفلات, مروّج (راعٍ يقوم بحجز وتنظيم العروض الترفيهية العامة)",
 "impress": "تجنيد إجباري, سخرة (فعل إجبار شخص ما على الخدمة الحكومية)",
 "impressible": "سريع التأثر, طري (سهل التأثر أو الانطباع)\nمثال: شاب سريع التأثر",
 "impression": "اِنْطِبَاع, أَثَر / تَقْلِيد",
 "impressionable": "سريع التأثر, طري (سهل التأثر أو الانطباع)\nمثال: شاب سريع التأثر",
 "impressionism": "انطباعية (مدرسة للرسامين الفرنسيين في أواخر القرن التاسع عشر صورت المظاهر بضربات من الألوان غير الممزوجة لإعطاء انطباع بالضوء المنعكس)",
 "impressionist": "انطباعي (متعلق بـ أو مميز للانطباعية) / انطباعي, فنان انطباعي (فنان يتبع نظريات الانطباعية)\nمثال: موسيقى انطباعية",
 "impressionistic": "انطباعي (متعلق بـ أو مميز للانطباعية) / انطباعي (مكون من أو متعلق بـ أو قائم على انطباع بدلاً من الحقائق أو التفكير المنطقي)\nمثال: موسيقى انطباعية",
 "impressive": "بَلِيغ, مُؤَثِّر (يُنتج أثراً قويّاً) / مؤثر, مثير للإعجاب (يترك انطباعاً قوياً أو حياً)\nمثال: احتفال مثير للإعجاب",
 "impressive aphasia": "حبسة استقبالية, حبسة حسية (حبسة تتميز بكلام طلق ولكنه لا معنى له وضعف شديد في القدرة على فهم الكلمات المنطوقة أو المكتوبة)",
 "impressively": "بشكل مثير للإعجاب, بشكل مهيب (بطريقة مثيرة للإعجاب)\nمثال: تقدم الطلاب بسرعة مثيرة للإعجاب",
 "impressiveness": "إبهار, تأثير قوي (صفة ترك انطباع قوي أو حيوي في الذهن) / عَظَمَة, فَخَامَة (الروعة أو الهيبة في الحجم أو المظهر)\nمثال: عظمة العمارة",
 "impressment": "تجنيد إجباري, سخرة (فعل إجبار شخص ما على الخدمة الحكومية)",
 "imprimatur": "إقرار, تأييد (موافقة رسمية وصريحة)\nمثال: يحصل الديمقراطي عادة على تأييد النقابة",
 "imprint": "بصمة, طبعة (أثر أو علامة تنتج عن الضغط على سطح ما) / أثر, بصمة (تأثير مميز) / بصمة, نقش بارز (انطباع ناتج عن الضغط أو الطباعة) / بصمة الناشر, بيان النشر (تعريف للناشر؛ اسم الناشر مع التاريخ والعنوان والطبعة المطبوعة في أسفل صفحة العنوان)\nمثال: لا تزال اللغة الإنجليزية تحمل بصمة الغزو النورماندي",
 "imprinting": "تطبّع, دمغ (عملية تعلم في مرحلة مبكرة من الحياة يتم بموجبها تأسيس أنماط سلوك خاصة بالنوع)",
 "imprison": "حَبَسَ, سَجَنَ (مَنَعَ الشيءَ عن الفعلِ؛ أَمْسَكَ الشيءَ، قَبَضَ عَلَيْهِ)\nمثال: هو,البارحة حرر من الحبس.",
 "imprisoned": "أَسِير, سَجِين (فِي حَالَة أَسْر أَوِ احْتِجَاز)",
 "imprisonment": "حَبْس, سَجْن (مَنَعَ الشيءَ عن الفعلِ؛ أَمْسَكَ الشيءَ، قَبَضَ عَلَيْهِ)\nمثال: هو,البارحة حرر من الحبس.",
 "improbability": "اسْتِبْعَاد, عَدَم احْتِمَالِيَّة (صفة كون الشيء غير محتمل الحدوث)\nمثال: لا ينبغي الخلط بين الاستحالة وعدم الاحتمالية",
 "improbable": "عَجِيب, مُسْتَبْعَد (مستبعد جداً بحيث لا يمكن تصديقه) / غير محتمل, مستبعد (ليس من المرجح أن يكون صحيحاً أو أن يحدث أو أن يكون قد حدث) / غَيْر مُقْنِع, مُسْتَبْعَد (ذو احتمالية منخفضة جداً لا تبعث على التصديق)\nمثال: التشريع بشأن هذه المسألة مستبعد للغاية",
 "improbableness": "اسْتِبْعَاد, عَدَم احْتِمَالِيَّة (صفة كون الشيء غير محتمل الحدوث)\nمثال: لا ينبغي الخلط بين الاستحالة وعدم الاحتمالية",
 "improbably": "بِإِعْجَاز, بِشَكْل لَا يُصَدَّق (ليس من السهل تصديقه)\nمثال: بشكل لا يصدق، نجت من التحطم",
 "impromptu": "ارتجالياً, بشكل عفوي (بدون تحضير مسبق) / اِرْتِجَالِيّ, عَفْوِيّ (بقليل من الإعداد أو التفكير المسبق أو بدونهما) / ارتجال (خطاب أو ملاحظة مرتجلة) / إمبرومبتو, مرتجلة (مقطع موسيقي قصير يبدو وكأنه صُنع بعفوية دون تحضير مسبق)\nمثال: تحدث ارتجالياً",
 "improper": "خَاطِئ, غَيْر صَحِيح (غير ملائم لغرض أو مناسبة معيّنة) / غير لائق, غير مناسب (غير ملائم أو غير صحيح أو غير مناسب) / غَيْرُ تَقْلِيدِيّ, غَيْرُ مَشْرُوعٍ (لا يتوافق مع القانون أو الأعراف الاجتماعية)\nمثال: من غير اللائق قليلاً تناول العشاء بمفردها مع رجل متزوج",
 "improper fraction": "كَسْر غَيْر حَقِيقِيّ, كَسْر مُعْتَلّ (كسر يكون بسطه أكبر من مقامه)",
 "improperium": "إمبروبريوم, نشيد العتاب ((عادة بصيغة الجمع) واحدة من سلسلة من الترانيم والاستجابات التي تعبر عن عتاب يسوع المسيح لشعبه، وتغنى عادة في يوم الجمعة العظيمة)",
 "improperly": "بشكل خاطئ, بشكل غير لائق (بطريقة غير صحيحة)\nمثال: فحص ما إذا كان الجرح قد التأم بشكل خاطئ",
 "improperness": "عدم لياقة (سلوك غير لائق)",
 "impropriety": "تبسط غير لائق, تطاول (فعل ينطوي على حميمية غير لائقة) / خدش للحياء, فعل غير لائق (فعل غير لائق أو خادش للحياء) / عدم لياقة (سلوك غير لائق) / عدم لياقة, مخالفة للأصول (حالة كون الشيء غير لائق أو غير مناسب)",
 "improvable": "قَابِلٌ لِلتَّحْسِين (يَقْبَلُ التَّحْسِينَ وَالتَّطْوِير)",
 "improve": "حَسَّنَ (جَمِيل؛ مُبْهِج) / تَحَسَّنَ\nمثال: إيمي فتاة حسنة.",
 "improved": "مُحَسَّن, مُطَوَّر (أصبح أو جُعل أفضل جودة) / مطور, مُحسَّن (تم جعله مرغوباً أكثر أو ذا قيمة أو ربحية أكبر؛ خاصة جعله جاهزاً للاستخدام أو التسويق) / مُجَهَّز, مُهَيَّأ ((عن الأراضي) أُعدّت للتطوير أو الزراعة بإزالة الأشجار والشجيرات)\nمثال: منازل جديدة تنشأ على قطعة أرض مطورة بالقرب من النهر",
 "improvement": "تَحْسِين",
 "improver": "إضافة, تحسين (مكون يضاف إلى شيء لتحسينه) / إنساني, فاعل خير (شخص مكرس لتعزيز رفاهية الإنسان والإصلاحات الاجتماعية)\nمثال: كانت إضافة الحمام تحسيناً كبيراً",
 "improvidence": "تبذير, سوء تدبير (نقص في التدبير والعناية من قبل شخص ما في إدارة الموارد)",
 "improvident": "غير متبصر, غير مدبر (غير مدبر؛ لا يوفر للمستقبل) / طَائِش, غَيْرُ مَدْرُوس (لم يُعْطَ تفكيرًا كافيًا أو دراسة متأنّية)",
 "improvidently": "بتبذير, بدون تدبير (بطريقة تفتقر إلى الحيطة والتدبير)\nمثال: عاش اللحظة بتبذير",
 "improving": "آخِذٌ فِي الاِرْتِفَاع, مُتَحَسِّن (يَزْدَادُ ارْتِفَاعًا أَوْ نَشَاطًا)",
 "improvisation": "ارتجال (أداء يُعطى بشكل مرتجل دون تخطيط أو إعداد) / ارتجال, حل مرتجل (وسيلة غير مخطط لها) / ارتجال (إبداع منطوق أو مكتوب أو مؤلف ارتجالياً (بدون إعداد مسبق))",
 "improvise": "اِرْتَجَلَ (الفرس: راوح بين العَنَق والهملجة؛ الطبّاخ: طبخ الطعام في المرجل)",
 "improvised": "مُؤَقَّت الصُّنْع, مُرْتَجَل (مصنوع أو مُنجَز بما هو متاح من موادّ)",
 "improvised explosive device": "عبوة ناسفة مرتجلة (جهاز متفجر يتم ارتجاله)",
 "imprudence": "حماقة, سفاهة (نقص الحذر في الشؤون العملية)",
 "imprudent": "طَائِش, مُتَهَوِّر (يَفْتَقِر إِلَى ضَبْط النَّفْس الحَكِيم) / غير حكيم, متهور (ليس حكيماً أو عاقلاً)\nمثال: تهور كبير من والدتها أن تشجعها على مثل هذه الأفكار الرومانسية السخيفة",
 "imprudently": "بتهور, بحماقة (بطريقة متهورة وغير حكيمة)\nمثال: بطيش، ترك العمل وركض إلى المنزل لإسعاد زوجته",
 "impudence": "صَفَاقَة, وَقَاحَة",
 "impudent": "سَلِيط, صَفِيق (جريء ومتطاول بشكل غير لائق) / صَفِيق, وَقِح (يتسم بعدم الاحترام العَرَضيّ)",
 "impudently": "بصفاقة, بوقاحة (بطريقة وقحة أو سفيهة)\nمثال: كان رفيق أسمر نحيل يحدق عبر النافذة، مبتسماً بوقاحة",
 "impugnable": "قَابِلٌ لِلطَّعْن (يمكن التشكيك فيه أو دحضه)",
 "impuissance": "عَجْز, قِلَّة حِيلَة (العجز الذي يظهر من خلال عدم القدرة على التصرف)\nمثال: رغم ضعفهم ظلت المجموعة نشطة",
 "impuissant": "ضَعِيف البِنْيَة, وَاهِن (يفتقر إلى القوة البدنية أو الحيوية)",
 "impulse": "دفعة, قوة دافعة مفاجئة (فعل تطبيق قوة فجأة) / دفعة, زخم (قوة دافعة) / سيال عصبي, نبضة عصبية (التفريغ الكهربائي الذي ينتقل عبر الليف العصبي) / نبض, نبضة ((في الإلكترونيات) موجة عابرة حادة في الحالة الكهربائية الطبيعية (أو سلسلة من هذه العوابر))\nمثال: الدفعة المفاجئة أسقطته أرضاً",
 "impulse explosive": "دافع متفجر, مادة دافعة (مادة متفجرة تستخدم لدفع المقذوفات من البنادق أو لدفع الصواريخ والقذائف أو لإطلاق الطوربيدات وقنابل الأعماق)",
 "impulse relay": "مرحل ماسك, مرحل نبضي (مرحل يحافظ على وضع التلامس إلى أجل غير مسمى دون تطبيق طاقة على الملف)\nمثال: يسمح المرحل الماسك بالتحكم عن بعد في إضاءة المبنى دون الطنين الذي قد ينتج عن ملف نشط باستمرار (تيار متردد)",
 "impulse turbine": "توربين نبضي, عنفة دفعية (توربين يتم تشغيله بواسطة تدفقات نفاثة مباشرة ضد الشفرات)",
 "impulsion": "دفعة, قوة دافعة مفاجئة (فعل تطبيق قوة فجأة) / اندفاع, حافز (قوة تحرك شيئاً ما للأمام)\nمثال: الدفعة المفاجئة أسقطته أرضاً",
 "impulsive": "طَائِش, مُتَهَوِّر (يتّسم بالتسرّع المفرط وعدم التفكير أو التروّي) / مِزَاجِيّ, نَزَوِيّ (مُحَدَّدٌ بِالصُّدْفَةِ أَوِ النَّزْوَةِ لَا بِالضَّرُورَةِ أَوِ العَقْل) / دَافِع, مُحَرِّك (له قوّة الدفع أو التحريك) / انْدِفَاعِيّ, مُتَهَوِّر (بدون تفكير مسبق أو ترَوٍّ)",
 "impulsively": "باندفاع, بتهور (بطريقة مندفعة أو متهورة؛ دون اتخاذ الحيطة)\nمثال: غالباً ما يتصرف باندفاع ويندم لاحقاً",
 "impulsiveness": "اندفاع (سمة التصرف فجأة بدافع دون تفكير)",
 "impunity": "إفلات من العقاب (الإعفاء من العقاب أو الخسارة)",
 "impure": "غَيْر طَاهِر, نَجِس (لديه شائبة جسدية أو أخلاقية تجعله غير نقي وفقاً للقوانين الغذائية أو الاحتفالية) / غير طاهر, فاسد ((يستخدم للأشخاص أو السلوكيات) غير أخلاقي أو فاحش) / غير نقي, مشوب (مختلط بعناصر دخيلة)\nمثال: أفكار غير طاهرة",
 "impureness": "شوائب, عدم نقاء (حالة كونه غير نقي)",
 "impurity": "شوائب, عدم نقاء (حالة كونه غير نقي) / خبث, شائب (مادة عديمة القيمة أو خطرة يجب إزالتها)\nمثال: كانت هناك شوائب في الماء",
 "imputable": "رَاجِع إِلَى, قَابِل لِلنِّسْبَة (قابل للإسناد أو النسبة إلى شيء ما)",
 "imputation": "إلصاق تهمة, اتهام (العزو إلى مصدر أو سبب (غالباً بشكل سلبي)) / إسناد تهمة, إلصاق تهمة (بيان ينسب شيئاً غير نزيه (خاصة جريمة جنائية))\nمثال: الاتهام بأن نجاحي كان بسبب المحسوبية عنى أنني لم أُؤخذ على محمل الجد",
 "imputrescible": "غَيْر قَابِل لِلتَّعَفُّن (لا يتعرّض للتحلّل أو التعفّن)",
 "imsouane": "إمسوان",
 "imuran": "أزاثيوبرين, إيموران (دواء مثبط للمناعة (الاسم التجاري إيموران) يستخدم لمنع رفض الأعضاء المزروعة)",
 "in": "فِي (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة) / مِن (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: جون في عمر أخي.",
 "in a beastly manner": "بِبَهَائِمِيَّة, بِوَحْشِيَّة (على طريقة الوحش)\nمثال: عاملت زوجها بوحشية",
 "in a broad way": "بإسهاب, بشكل عام (بطريقة عامة)\nمثال: تحدث بإسهاب عن خططه",
 "in a flash": "حالاً, على الفور (بدون أي تأخير)\nمثال: قُتل على الفور",
 "in a heartfelt way": "بصدق, من صميم القلب (بطريقة صادقة ومن القلب)\nمثال: أود بصدق أن أعرف",
 "in a higher place": "فوق, في الأعلى (في أو إلى مكان أعلى)",
 "in a hurry": "مُسْتَعْجِل",
 "in a nutshell": "بِاخْتِصَار شَدِيد, بِخُلَاصَة القَوْل (ملخصاً بإيجاز)\nمثال: أعطى الحقائق باختصار شديد",
 "in a pig's eye": "أبداً, في المشمش (إطلاقاً لا؛ أبداً)",
 "in a pinch": "الشده",
 "in a similar way": "بالمثل, بنفس النوع (بشيء من نفس النوع)\nمثال: ترد له الصاع صاعين (تعامله بالمثل)",
 "in a way": "إلى حد ما, نوعاً ما (من بعض وجهات النظر)\nمثال: كانت محقة نوعاً ما",
 "in absentia": "غِيَابًا",
 "in accordance with": "وَفْقًا لِ",
 "in addition": "إِضَافَةً عَلى ذٰلِكَ",
 "in advance": "سلفاً, مسبقاً (قبل الوقت؛ تحسباً)\nمثال: عندما تدفع مقدماً تحصل على خصم",
 "in all": "إجمالاً, في المجموع (مع تضمين أو عد كل شيء)\nمثال: إجمالاً يكسب ما يقرب من مليون دولار",
 "in all likelihood": "على الأرجح, غالباً (بدرجة كبيرة من اليقين؛ دون شك كبير)\nمثال: من المحتمل أنه خارج البلاد",
 "in all probability": "على الأرجح, غالباً (بدرجة كبيرة من اليقين؛ دون شك كبير)\nمثال: من المحتمل أنه خارج البلاد",
 "in an elaborate way": "بإسهاب, بتفصيل\nمثال: تم توضيحه بإسهاب",
 "in and of itself": "بحد ذاته, جوهرياً (فيما يتعلق بطبيعته المتأصلة)\nمثال: هذا البيان مثير للاهتمام بحد ذاته",
 "in any case": "عَلَى أَيِّ حَالٍ (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال.",
 "in any event": "بأي حال, على أي حال (تستخدم للإشارة إلى أن بياناً يشرح أو يدعم بياناً سابقاً)\nمثال: على أي حال، هو ميت الآن",
 "in apposition": "بدلياً, على سبيل البدل (بطريقة تدل على البدل (في النحو))\nمثال: تُستخدم هذه الصفة بدلياً",
 "in arrears": "فِي حَالَة دَيْن, مُتَأَخِّر (في حالة دين أو تأخر عن سداد المستحقات)\nمثال: تأخر في سداد أقساط الرهن العقاري",
 "in between": "بَيْن (ظرف مكان بمعنى وَسْط) / فِي مَا بَيْن (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: مصيري بين يديك.",
 "in both ears": "بكلتا الأذنين (بطريقة تستخدم الأذنين معاً)\nمثال: تم تقديم المحفز بكلتا الأذنين",
 "in brief": "بِإِيجَاز, بِاخْتِصَار (بطريقة موجزة؛ في بضع كلمات)\nمثال: التاريخ ملخص بإيجاز في هذا الكتاب",
 "in broad daylight": "فِي وَضَح اَلنَّهَار (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة) / جهارًا نهارًا\nمثال: جون في عمر أخي.",
 "in camera": "بشكل خاص, سراً (محتفظ به كسر أو مقتصر على المعنيين بالأمر)\nمثال: نوقش الأمر سراً",
 "in case": "فِي حَال (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "in case of": "فِي حَال, إِذ مَا (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "in chains": "مُقَيَّد بِالسَّلَاسِل (مربوط بالسلاسل)",
 "in circles": "في دوائر مفرغة (دون إحراز تقدم)\nمثال: تحدث المرشحان في دوائر مفرغة",
 "in cold blood": "بِدَم بَارِد",
 "in common": "قواسم مشتركة, مشتركاً (ذو اهتمام مشترك) / بالاشتراك, مشاعاً (في استخدام أو ملكية مشتركة)\nمثال: لدينا عدة أشياء مشتركة",
 "in common with": "أسوة بـ, كغيره من (بنفس الطريقة؛ مثل)\nمثال: أسوة بالعائلات بشكل عام، أصبحت العائلات ذات الوالد الواحد أصغر حجماً",
 "in concert": "بالتنسيق, معاً (بخطط مشتركة)\nمثال: العمل بالتنسيق",
 "in conclusion": "أخيراً, في الختام (العنصر في النهاية)\nمثال: أخيراً، سأناقش القيم العائلية",
 "in danger": "فِي خَطَرٍ (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "in darkness": "في الظلام (بدون ضوء)\nمثال: كان النهر ينزلق في الظلام تحت الضباب",
 "in detail": "بِالتَّفْصِيل, تَفْصِيلًا",
 "in dishabille": "مُبْتَذَل اللِّبَاس (يرتدي ملابس فضفاضة أو مهملة جزئياً)",
 "in doubt": "فِي شَكٍّ, فِي رَيْبٍ (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "in due course": "في الوقت المناسب, في حينه (في الوقت الملائم)\nمثال: سنصل لهذه المسألة في الوقت المناسب",
 "in due season": "في الوقت المناسب, في حينه (في الوقت الملائم)\nمثال: سنصل لهذه المسألة في الوقت المناسب",
 "in due time": "في الوقت المناسب, في حينه (في الوقت الملائم)\nمثال: سنصل لهذه المسألة في الوقت المناسب",
 "in earnest": "بجدية (بطريقة جادة)\nمثال: تحدث بجدية مع ابنه",
 "in effect": "فعلياً, في الواقع (في الواقع أو الحقيقة)\nمثال: هي فعلياً زوجته",
 "in essence": "من حيث المبدأ (فيما يتعلق بالأساسيات وإن لم يكن فيما يتعلق بالتفاصيل)\nمثال: نحن متفقون من حيث المبدأ",
 "in everyone's thoughts": "سائد, في الجو (في أذهان الجميع)\nمثال: كان عيد الميلاد في الأجواء",
 "in evidence": "ظَاهِرٌ لِلعِيَانِ (وَاضِحٌ وَمَرْئِيٌّ بِجَلَاءٍ)",
 "in extremis": "عِنْد الاحْتِضَار, فِي اللَّحَظَات الأَخِيرَة (عند نقطة الموت)",
 "in fact": "فِي الْحَقِيقَة (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "in fashion": "عَصْرِيّ, مُوَاكِب لِلْمُوضَة (رائج ويُعتبر جذاباً أو عصرياً في وقته)",
 "in fiscal matters": "ضريبياً, مالياً (في الشؤون المالية)\nمثال: غير مسؤول مالياً",
 "in flagrante delicto": "مُتَلَبِّسًا",
 "in flight": "أثناء الطيران, محلقاً (يطير في الهواء)\nمثال: رأينا البط أثناء الطيران",
 "in front": "أماماً, في المقدمة (في أو في المقدمة)\nمثال: أرى أضواء مدينة أمامنا",
 "in front of": "أَمَامَ, قُدَّامَ / أَمَامَ",
 "in full": "بالكامل (في إشارة إلى كمية)\nمثال: دُفع المبلغ بالكامل",
