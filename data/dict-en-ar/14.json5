 "ironshod": "مُنْعَل بِالحَدِيد (مُنعَل أو مُغلَّف بالحديد)",
 "ironside": "رجل شجاع (رجل ذو قوة أو شجاعة كبيرة)",
 "ironware": "أدوات معدنية, خردوات (أدوات أو معدات مصنوعة من المعدن)",
 "ironweed": "عشبة الحديد, فيرنونيا",
 "ironwood": "خشب الحديد, ممران شجرة الجنجل الشرقي (ممران شجرة الجنجل متوسط الحجم من شرق أمريكا الشمالية) / شجرة الحديد (شجرة صغيرة بطيئة النمو متساقطة الأوراق من شمال إيران لها شكل قبة منخفضة) / خشب حديدي (خشب صلب أو قاسي بشكل استثنائي لأي من عدد من الأشجار) / خشب الحديد, كستناء الورد (شجرة دائمة الخضرة جميلة من شرق الهند تزرع غالباً كزينة لأزهارها البيضاء العطرة التي تنتج عطراً؛ مصدر لخشب صلب ثقيل جداً يستخدم لروابط السكك الحديدية)",
 "ironwood tree": "خشب الحديد, ممران شجرة الجنجل الشرقي (ممران شجرة الجنجل متوسط الحجم من شرق أمريكا الشمالية) / شجرة الحديد (شجرة صغيرة بطيئة النمو متساقطة الأوراق من شمال إيران لها شكل قبة منخفضة) / خشب الحديد, كستناء الورد (شجرة دائمة الخضرة جميلة من شرق الهند تزرع غالباً كزينة لأزهارها البيضاء العطرة التي تنتج عطراً؛ مصدر لخشب صلب ثقيل جداً يستخدم لروابط السكك الحديدية)",
 "ironwork": "أشغال حديدية (عمل مصنوع من الحديد (شبكات أو قضبان أو درابزين إلخ))\nمثال: كان في المنازل الكثير من الأشغال الحديدية المزخرفة",
 "ironworker": "حداد, عامل حديد (شخص يصنع أدوات من الحديد)",
 "ironworks": "مصنع حديد (مكان العمل الذي يتم فيه صهر الحديد أو صنع المنتجات الحديدية)",
 "irony": "سُخْرِيَة / مُفَارَقَة / تَهَكُّم (تَهَكَّمَ بِزمِيلِهِ أمَامَ النَّاسِ: اِسْتَهْزَأَ بِهِ، سَخِرَ مِنْهُ، زَرَى عَلَيْهِ، عَبَثَ بِهِ. تَهَكَّمَ صَاحِبَهُ) / تَعَارُض / تَنَافُر / اِسْتِهْزَاء",
 "iroquoian": "اللغات الإيروكوية (عائلة من لغات هنود أمريكا الشمالية يتحدث بها الإيروكوا)",
 "iroquoian language": "اللغات الإيروكوية (عائلة من لغات هنود أمريكا الشمالية يتحدث بها الإيروكوا)",
 "iroquois": "اللغات الإيروكوية (عائلة من لغات هنود أمريكا الشمالية يتحدث بها الإيروكوا) / إيروكواس (أي فرد من شعوب الهنود المحاربين في أمريكا الشمالية الذين عاشوا سابقاً في ولاية نيويورك)",
 "iroquois league": "الأمم الخمس, رابطة الإيروكوا (رابطة لقبائل الإيروكوا تضم في الأصل الموهوك وأونيدا وأونونداغا وكايوغا وسينيكا (الأمم الخمس)؛ بعد عام 1722 انضم إليهم توسكارورا (الأمم الست))",
 "irradiation": "تَشَعُّع / تَشْعِيع",
 "irrational": "غير عقلاني, غير منطقي (غير متسق مع العقل أو لا يستخدمه) / أصم, غير نسبي (حقيقي ولكن لا يمكن التعبير عنه كحاصل قسمة عددين صحيحين) / عَدَد غَيْر نِسْبِيّ (عدد حقيقي لا يمكن التعبير عنه كعدد نسبي (كسر))\nمثال: مخاوف غير عقلانية",
 "irrational hostility": "عداء غير عقلاني (تحامل أو تعصب شديد)",
 "irrational impulse": "اندفاع لا عقلاني, نزوة (دافع قوي وتلقائي غير عقلاني)\nمثال: وسائل الإعلام والمعلنون يوجهون نزواتنا غير العقلانية",
 "irrational motive": "دافع غير عقلاني, دافع لا منطقي (دافع يتعارض مع العقل أو المنطق)",
 "irrational number": "عَدَد غَيْر نِسْبِيّ (عدد حقيقي لا يمكن التعبير عنه كعدد نسبي (كسر))",
 "irrationality": "لا عقلانية (حالة كونه غير عقلاني؛ الافتقار لقدرات الفهم)",
 "irrationally": "بشكل غير عقلاني (بطريقة غير عقلانية)\nمثال: تصرفوا بشكل غير عقلاني",
 "irrawaddy": "إِيرَاوَادِي",
 "irreality": "لا واقعية, وهمية (حالة كون الشيء غير جوهري أو خيالي؛ لا وجود له موضوعياً أو في الواقع)",
 "irreclaimable": "غَيْرُ قَابِلٍ لِلإِصْلَاح, لَا يُرْجَى إِصْلَاحُه (لَا يَقْبَلُ الإِصْلَاحَ أَوِ التَّقْوِيم)",
 "irreconcilable": "لا يمكن التوفيق بينه (مستحيل التوفيق بينه)\nمثال: خلافات لا يمكن التوفيق بينها",
 "irrecoverable": "غير قابل للاسترداد (لا يمكن استرداده أو استعادته)",
 "irredeemable": "غَيْر قَابِل لِلصَّرْف ((عن النقود الورقية) لا يمكن تحويلها إلى عملة معدنية حسب رغبة حاملها) / غَيْرُ قَابِلٍ لِلإِصْلَاح, لَا يُرْجَى إِصْلَاحُه (لَا يَقْبَلُ الإِصْلَاحَ أَوِ التَّقْوِيم)",
 "irredenta": "أرض سليبة, منطقة محتلة (منطقة ترتبط عرقياً أو تاريخياً ببلد ما ولكنها تخضع لسيطرة سياسية من قبل بلد آخر)",
 "irredentism": "وَحْدَوِيّة",
 "irredentist": "مناصر لاستعادة الأرض (مدافع عن استعادة الأراضي القومية المحتلة)",
 "irreducible": "غير قابل للاختزال (غير قادر على أن يتم جعله أصغر أو أبسط)\nمثال: حد أدنى غير قابل للاختزال",
 "irrefutable": "دَامِغ, لَا يُدْحَض (مُسْتَحِيلُ النَّفْيِ أَوِ الدَّحْض)",
 "irregardless": "بغض النظر (البُغْض ضدّ الحبّ ، بغَض جَدُّك:كتعس جدّك،ونعِمَ الله بك عيناً وبغَض بعدوّك عيناً؛ بغَضَ فلانٌ الشّيءَ أو الشّخصَ:كَرِهَه ومَقَتَه وأعرض عنه)\nمثال: سأذهب بغض النظر عن مجيئه.",
 "irregular": "شَاذّ, غَيْر مُنْتَظِم",
 "irregular galaxy": "مَجَرَة غَيْر مُنْتَظِمَة (نجوم كثيرة لا تدرك بمجرد البصر، وعندما ينتشر ضوؤها فيُرى كأنه بقعة بيضاء (أي: مصادر ضوء كثيرة بحيث يبدو ضوئها كوهج بدلاً من أن يَبدو كل نجم واضحٍ…؛ باب السماء، وهي البياض الذي يَعبر السماء ويَقع بين النّسرَين (المقصود هنا هو مجرة دَرْب التّبانَة…)\nمثال: أنا بطل المجرة.",
 "irregular verb": "فِعْل غَيْر مُنْتَظِم, فِعْل شَاذّ (عَمِلَ وصَنَعَ، بعلم أو بدون علم، عن قصد أو دون قصد)\nمثال: ماذا فعل للحمي؟",
 "irregularity": "شذوذ, مخالفة (سلوك يخرق القاعدة أو الإتيكيت أو العرف أو الأخلاق) / اضْطِرَاب, شُذُوذ (عدم الاتصاف بمبدأ ثابت أو معدل ثابت؛ الحدوث على فترات غير منتظمة) / عدم انتظام, عدم انتظام هندسي (لا تناظر غير منتظم في الشكل؛ نمط مكاني غير منتظم) / إمساك (إخلاء الأمعاء بشكل غير منتظم وغير متكرر أو صعب؛ يمكن أن يكون عرضاً لانسداد معوي أو التهاب رتجي)",
 "irregularly": "باضطراب, بشكل غير منتظم (بمعدل غير مستوٍ أو مضطرب) / بشكل غير منتظم, بشكل متقطع (بطريقة غير ثابتة، ليس وفق معدل أو جدول ثابت) / بشكل غير منتظم, عشوائياً (ما كان له شكل غير منتظم هندسياً)\nمثال: المريض يتنفس بشكل غير منتظم",
 "irrelevance": "عَدَم الصِّلَة, عَدَم العَلَاقَة (عدم وجود علاقة لشيء ما بالموضوع المطروح)",
 "irrelevancy": "عَدَم الصِّلَة, عَدَم العَلَاقَة (عدم وجود علاقة لشيء ما بالموضوع المطروح)",
 "irrelevant": "عَرَضِيّ",
 "irrelevantly": "بلا صلة بالموضوع, في غير محله (بطريقة غير ذات صلة)\nمثال: فجأة وفي غير محله، طلبت منه المال",
 "irreligion": "لَادِينِيَّة",
 "irreligionist": "لاديني (شخص غير مبالٍ أو معادٍ للدين)",
 "irreligious": "غير متدين, لاديني (معادٍ أو غير مبالٍ بالدين)",
 "irreligiousness": "إلحاد, لا دينية (صفة عدم التدين)",
 "irremediable": "لا يمكن علاجه, مستعص (مستحيل علاجه أو تصحيحه أو إصلاحه)\nمثال: خطأ لا يمكن تداركه",
 "irremovability": "ثبات المنصب, عدم القابلية للعزل (الجودة أو الحالة المتمثلة في عدم إمكانية الإزالة)\nمثال: يؤكد الأيديولوجيون البرجوازيون أن عدم قابلية عزل القضاة يضمن استقلاليتهم في الفصل في قضايا المحاكم",
 "irremovable": "ثابت, راسخ (لا يمكن إزالته أو أخذه أو صرفه)\nمثال: صخور ضخمة لا يمكن إزالتها",
 "irreparable": "لا يمكن إصلاحه (مستحيل إصلاحه أو تصحيحه أو تعديله)\nمثال: ضرر لا يمكن إصلاحه",
 "irreparably": "بشكل لا يمكن إصلاحه (بطريقة أو إلى درجة لا يمكن إصلاحها)",
 "irreplaceable": "لا يستبدل, لا يعوض (مستحيل استبداله)\nمثال: تحف لا تعوض",
 "irreplaceableness": "تَعَذُّر الاسْتِبْدَال (صفة كون الشيء غير قابل للاستبدال)",
 "irrepressibility": "حيوية, مرح لا يكبت (حيوية وروح طيبة لا يمكن كبتها)\nمثال: أعجبت بحيويته وروحه المرحة المستمرة",
 "irrepressible": "جَامِح, لَا يُمْكِنُ كَبْحُهُ (يَسْتَحِيلُ قَمْعُهُ أَوِ السَّيْطَرَةُ عَلَيْه)",
 "irreproachable": "بَرِيء, لَا تَشُوبُهُ شَائِبَة (خالٍ من الذنب؛ لا يستحق اللوم)",
 "irreproachably": "بشكل لا غبار عليه, بنزاهة تامة (بطريقة لا تشوبها شائبة ولا لوم فيها)\nمثال: عاشت بنزاهة تامة حتى قابلت هذا الرجل",
 "irreproducibility": "عدم قابلية التكرار (جودة كون الشيء غير قابل لإعادة الإنتاج)\nمثال: لم يستطع تفسير عدم قابلية تكرار نتائج تجربته",
 "irreproducible": "غير قابل للتكرار, لا يمكن إعادة إنتاجه (مستحيل إعادة إنتاجه أو تكراره)",
 "irresistibility": "جاذبية لا تقاوم, سحر طاغ (صفة كونه طاغيًا ومستحيلاً مقاومته)",
 "irresistible": "لَا يُقَاوَم (بالغ الجاذبيّة إلى حدّ لا يمكن مقاومته) / ساحق, لا يقاوم (مستحيل مقاومته؛ غلاب)\nمثال: دوافع لا تقاوم",
 "irresistible impulse": "إلزام داخلي, اندفاع قسري (رغبة ملحة لفعل أو قول شيء قد يكون من الأفضل تركه دون فعل أو قول)\nمثال: شعر باندفاع قسري للثرثرة حول الحادث",
 "irresistibleness": "جاذبية لا تقاوم, سحر طاغ (صفة كونه طاغيًا ومستحيلاً مقاومته)",
 "irresistibly": "بِشَكْل سَاحِق, بِقُوَّة قَاهِرَة (بشكل لا يمكن مقاومته)\nمثال: بدت الحلوى مرغوبة بشكل ساحق للرجل الذي يتبع حمية",
 "irresolute": "غير حازم, متردد (غير متأكد من كيفية التصرف أو المضي قدماً)\nمثال: كانت اللجنة خجولة ومتواضعة ومترددة",
 "irresolutely": "بِتَرَدُّد (الافتقار إلى التصميم أو الحسم)",
 "irresoluteness": "تردد, خور (سمة كون المرء متردداً؛ يفتقر إلى ثبات الغرض)",
 "irresolution": "تردد, خور (سمة كون المرء متردداً؛ يفتقر إلى ثبات الغرض) / تردد, عدم حزم (شك يتعلق ببديلين أو أكثر من البدائل أو مسارات العمل الممكنة)\nمثال: كان تردده لحظياً فقط ولكن الفرصة ضاعت",
 "irrespective": "بصرف النظر, بغض النظر (على الرغم من كل شيء؛ دون اعتبار للعوائق)\nمثال: واصل العمل بغض النظر عن الصعوبات",
 "irresponsibility": "اِنْعِدام مَسْؤُولِيَّة",
 "irresponsible": "غير مسؤول, مستهتر (يظهر عدم الاكتراث بالعواقب)\nمثال: تصرف كأحمق غير مسؤول",
 "irresponsibleness": "لا مسؤولية (شكل من أشكال عدم الجدارة بالثقة؛ سمة الافتقار إلى الشعور بالمسؤولية وعدم الشعور بالمساءلة عن أفعال المرء)",
 "irresponsibly": "بشكل غير مسؤول (بطريقة غير مسؤولة)\nمثال: تصرف بشكل غير مسؤول",
 "irretrievable": "لَا رَجْعَةَ فِيهِ, لَا يُمْكِنُ تَدَارُكُهُ (يستحيل استرداده أو تعويضه أو تداركه)",
 "irretrievably": "بشكل لا رجعة فيه (بطريقة لا يمكن استعادتها)\nمثال: إنه مفقود بشكل لا رجعة فيه",
 "irreverence": "استخفاف, قلة احترام (فعل ينم عن عدم الاحترام) / عدم اكتراث, قلة توقير (موقف ذهني يفتقر للتبجيل)",
 "irreverent": "غَيْر مُوَقِّر, كَافِر (لا يجلّ الله ولا يوقّره) / غير موقر, مستخف (يظهر عدم الاحترام الواجب أو التبجيل) / جَرِيءُ اللِّسَان, وَقِح (يتّسم بخفّة وقحة ومرح طافح)\nمثال: علماء غير موقرين يسخرون من الأشياء المقدسة",
 "irreverently": "بانتهاك للحرمة, بلا وقار (بطريقة غير موقرة) / باستخفاف, بلا احترام (بدون احترام)\nمثال: قلد الطالب المعلم باستخفاف في حضوره",
 "irreversibility": "عَدَم قَابِلِيَّة لِلْعَكْس, لَا رَجْعِيَّة (صفة عدم القابلية للعكس (بمجرد فعله لا يمكن تغييره))",
 "irreversible": "غير قابل للعكس, لا رجعة فيه (لا يمكن عكسه)\nمثال: زخم لا رجعة فيه نحو الثورة",
 "irreversible process": "عملية غير عكوسة (أي عملية غير قابلة للعكس)",
 "irreversibly": "بشكل لا رجعة فيه, بشكل لا عكس فيه (بطريقة لا يمكن عكسها)\nمثال: هذا التقليد القديم يختفي بشكل لا رجعة فيه",
 "irrevocability": "بَتّ, عَدَم قَابِلِيَّة الإِلْغَاء (حالة أو شرط استحالة التراجع أو العكس؛ النهائية)",
 "irrevocable": "مُبْرَم",
 "irrevocably": "بشكل لا رجعة فيه, بشكل نهائي (بطريقة غير قابلة للإلغاء أو التغيير)",
 "irrevokable": "بات, غير قابل للإلغاء (لا يمكن التراجع عنه أو إلغاؤه)\nمثال: قضائي حازم وبات",
 "irridenta": "أرض سليبة, منطقة محتلة (منطقة ترتبط عرقياً أو تاريخياً ببلد ما ولكنها تخضع لسيطرة سياسية من قبل بلد آخر)",
 "irridentism": "وحدة إيطالية (المذهب القائل بأن الأراضي المقتطعة يجب أن تسيطر عليها الدولة التي ترتبط بها عرقياً أو تاريخياً)",
 "irridentist": "مناصر لاستعادة الأرض (مدافع عن استعادة الأراضي القومية المحتلة)",
 "irrigation": "سَقْي",
 "irrigation ditch": "قناة ري (خندق لتزويد الأراضي الجافة بالمياه صناعياً)",
 "irritability": "حدة المزاج, سرعة الغضب (الميل لإظهار غضب غير منضبط) / تهيج, قابلية للاستثارة (حساسية مفرطة لعضو أو جزء من الجسم) / تهيج, سرعة الغضب (شعور بالتهيج والنزق)\nمثال: كانت حدة مزاجه معروفة لجميع موظفيه",
 "irritable": "سَرِيع التَّأَفُّف, عَصَبِيّ (يتهيج أو ينزعج بسهولة) / سَرِيع الاسْتِثَارَة, قَابِل لِلتَّهَيُّج (قادر على الاستجابة للمحفّزات) / شَدِيد التَّهَيُّج (حسّاس بشكل غير طبيعي لمؤثّر ما)",
 "irritable bowel syndrome": "القولون التشنجي, متلازمة القولون العصبي (ألم بطني متكرر وإسهال (غالباً ما يتناوب مع فترات من الإمساك)؛ يرتبط غالباً بالضغط النفسي)",
 "irritably": "بحدّة, بسرعة انفعال (بطريقة سريعة الانفعال) / بحدة, بنزق (بطريقة نزقة)\nمثال: أصبحت دقيقة بحدّة",
 "irritant": "شوكة, مصدر إزعاج (شيء يسبب التهيج والانزعاج)\nمثال: إنه شوكة في حلقي",
 "irritated": "مُتَضَايِق, مُنْزَعِج (أُثير فيه نفاد الصبر أو الغضب)",
 "irritating": "مُزْعِج, مُضَايِق (يسبب الانزعاج أو الضيق) / مُؤْلِم, مُهَيِّج (يسبب عدم الراحة الجسدية) / تَنْبِيهِيّ, مُهَيِّج ((للمحفزات الجسدية) يعمل على التحفيز أو الإثارة)",
 "irritatingly": "بشكل مزعج, بشكل يثير الغضب (بطريقة مزعجة)",
 "irritation": "إزعاج, غيظ (فعل إقلاق أو إزعاج شخص ما) / إغاظة, استفزاز (سلوك غير ودي يسبب الغضب أو الاستياء) / انزعاج, ضيق (شعور غير مريح بالألم العقلي أو الضيق) / فورة غضب, هيجان (نوبة مفاجئة من الغضب)\nمثال: اشتعل غضبه كالحطب الجاف",
 "irritative": "تَنْبِيهِيّ, مُهَيِّج ((للمحفزات الجسدية) يعمل على التحفيز أو الإثارة)",
 "irruption": "اقتحام مفاجئ, اندفاع (دخول عنيف مفاجئ) / اندلاع, تفشي (حدوث تلقائي عنيف ومفاجئ (عادة لحالة غير مرغوب فيها)) / ازدياد مفاجئ, تفشي (زيادة مفاجئة وحادة في الأعداد النسبية للسكان)\nمثال: الاندفاع الأخير للأخلاق السيئة",
 "irruptive": "اقْتِحَامِيّ, بُلُوتُونِيّ (صخر ناري تصلّب تحت سطح الأرض؛ كالغرانيت أو الديوريت أو الغابرو)",
 "irs": "مصلحة الضرائب (مكتب تابع لوزارة الخزانة مسؤول عن تحصيل الضرائب)",
 "irula": "إيرولا (لغة درافيدية وثيقة الصلة بالتاميل يتم التحدث بها في منطقة تلال بجنوب غرب الهند)",
 "irula language": "إيرولا (لغة درافيدية وثيقة الصلة بالتاميل يتم التحدث بها في منطقة تلال بجنوب غرب الهند)",
 "irvingia gabonensis": "ديكا, مانجو بري (شجرة أفريقية بفاكهة صفراء صالحة للأكل تشبه المانجو؛ تقدر لبذورها الغنية بالزيت وخشبها الأخضر الصلب المقاوم للنمل الأبيض)",
 "is that so": "هَلْ هٰذَا صَحِيح؟, أَلَيْسَ كَذٰلِكَ؟",
 "is there a problem": "هَلْ هُنَاكَ مُشْكِلَة؟",
 "is there a smaller size": "هَل يُوجَد مَقَاس أَصْغَر؟, هَل هُنَاك حَجْم أَصْغَر؟",
 "isaac": "إِسْحَاق (توراتي أصله العبري \"يِصْحاق\" أي: الضاحك، يضحك وهو يدل على ضحك سارة وسرورها حين بُشر زوجها إبراهيم بغلام وهما عجوزان، وحين ولدت أسمته يصحاق…؛ من الأنبياء الذين ورد ذكرُهم في القرآن الكريمِ، وهو الابن الثاني لإبراهيم عليه السلام من سارةَ، وقد وُلد ولأبيه أكثر من مائة عام ولأمّه تسعون عامًا…)\nمثال: تزوج إسحاق بامرأة مسلمة.",
 "isaiah": "إِشَعْياء",
 "isanemone": "خط تساوي سرعة الرياح (خط تساوي يربط النقاط التي لها سرعة رياح متساوية)",
 "isarithm": "خط التساوي, خط الكنتور (خط مرسوم على خريطة يربط بين النقاط التي لها نفس القيمة العددية لمتغير ما)",
 "isatis tinctoria": "نيلة, وسمة الصباغين (نبات أوروبي ثنائي الحول كان يزرع سابقاً للمادة الملونة الزرقاء التي تنتجها أوراقه)",
 "isaw": "إيساو (طعام شوارع من الفلبين، مصنوع من أمعاء الخنزير أو الدجاج المشوية)",
 "ischaemia": "إقفار, نقص التروية (فقر دم موضعي في جزء معين من الجسم ينتج أحيانًا عن تضيق الأوعية أو تجلط الدم أو الانسداد)",
 "ischaemic": "إقفاري, ناقص التروية (متعلق بـ أو مصاب بنقص التروية (الإقفار))",
 "ischaemic stroke": "سكتة دماغية إقفارية (أكثر أنواع السكتات الدماغية شيوعاً؛ ناجمة عن انقطاع تدفق الدم إلى الدماغ (كما هو الحال من جلطة تسد وعاء دموياً))",
 "ischemia": "نقص التروية",
 "ischemic": "إقفاري, ناقص التروية (متعلق بـ أو مصاب بنقص التروية (الإقفار))",
 "ischemic anoxia": "انعدام الأكسجين الاقفاري, انعدام الأكسجين الركودي (انعدام الأكسجين الناتج عن بطء الدورة الدموية المحيطية (مثل ما يتبع فشل القلب الاحتقاني))",
 "ischemic hypoxia": "نقص الأكسجة الاقفاري, نقص الأكسجة الركودي (نقص الأكسجة الناتج عن بطء الدورة الدموية المحيطية (مثل ما يتبع فشل القلب الاحتقاني))",
 "ischemic stroke": "سكتة دماغية إقفارية (أكثر أنواع السكتات الدماغية شيوعاً؛ ناجمة عن انقطاع تدفق الدم إلى الدماغ (كما هو الحال من جلطة تسد وعاء دموياً))",
 "ischial bone": "إسك, عظم الإسك (أحد الأقسام الثلاثة لعظم الورك؛ يقع أسفل الحرقفة)",
 "ischium": "إسك, عظم الإسك (أحد الأقسام الثلاثة لعظم الورك؛ يقع أسفل الحرقفة)",
 "isentropic": "أيزنتروبي, ثابت الاعتلاج (باعتلاج (إنتروبيا) غير متغير؛ عند اعتلاج ثابت)",
 "isfahan": "أَصْفَهَان, إِصْفَهَان",
 "isha": "صَلَاة اَلْعِشَاء, عِشَاء",
 "ishikawa": "إِيشِيكَاوَا",
 "ishmael": "إِسْمَاعِيل (من أنبياء الله الصالحين؛ اسم رجل)\nمثال: ادعوني إسماعيل.",
 "ishtar": "عشتار",
 "isi": "المخابرات الباكستانية, وكالة الاستخبارات الباكستانية (وكالة الاستخبارات الباكستانية؛ قوة سياسية وعسكرية قوية وشبه مستقلة)",
 "isinglass": "ميكا (أي من المعادن المختلفة المكونة من سيليكات مائية للألمنيوم أو البوتاسيوم وغيرها والتي تتبلور في أشكال تسمح بانقسامها إلى أوراق رقيقة جداً)",
 "isis": "إيزيس",
 "iskandar": "إِسْكَنْدَر, الْإِسْكَنْدَر",
 "iskcon": "الجمعية الدولية لوعي كريشنا, هاري كريشنا (طائفة دينية تأسست في الولايات المتحدة عام 1966؛ تستند إلى الكتب الفيدية؛ تنخرط المجموعات في ترديد بهيج لـ \"هاري كريشنا\" ومانترا أخرى تستند إلى اسم…)",
 "iskenderun": "الإِسْكَنْدَرُون",
 "islam": "الْإِسْلَام",
 "islam nation": "الأمة, الأمة الإسلامية (المجتمع أو الشعب المسلم، الذي يمتد من موريتانيا إلى باكستان)\nمثال: يحث المسلمون المعتدلون الأمة على رفض إرهاب المتطرفين",
 "islamabad": "إِسْلَام آباد (استسلام لشيء، إذعان، خضوع، إنقياد) / إِسْلَام أَبَاد (استسلام لشيء، إذعان، خضوع، إنقياد)\nمثال: الإسلام دين حق.",
 "islamic": "إِسْلَامِيّ",
 "islamic calendar": "التَّقْوِيم الْهِجْرِيّ",
 "islamic calendar month": "شهر إسلامي, شهر هجري (أي شهر قمري في التقويم الإسلامي)",
 "islamic emirate of afghanistan": "إِمَارَة أَفْغَانِسْتَان الْإِسْلَامِيَّة (الإمَارَة : منصِب الأمير؛ الإمَارَة: دَوْلَة أو مَنْطِقَة أو جُزْء من الأَرْض يحكمه أَمِير)",
 "islamic fundamentalism": "اَلْأُصُولِيَّة اَلْإِسْلَامِيَّة",
 "islamic law": "شريعة, شريعة إسلامية (قانون مستمد من القرآن وتعاليم ومثال النبي محمد)\nمثال: الشريعة قابلة للتطبيق على المسلمين فقط",
 "islamic republic of afghanistan": "جُمْهُورِيَّةْ أَفْغَانِسْتَان الْإِسْلَامِيَّة",
 "islamic republic of iran": "جُمْهُورِيَّة إِيرَان الْإِسْلَامِيَّة",
 "islamic republic of mauritania": "الجمهورية الإسلامية الموريتانية",
 "islamic republic of pakistan": "جُمْهُورِيَّة بَاكِسْتَان الْإِسْلَامِيَّة",
 "islamic state": "تَنْظِيم الدَّوْلَة الْإِسْلَامِيَّة, الدَّوْلَة الْإِسْلَامِيَّة",
 "islamic state in iraq": "الدَّوْلَة الْإِسْلَامِيَّة فِي العِرَاق",
 "islamic ummah": "الأمة, الأمة الإسلامية (المجتمع أو الشعب المسلم، الذي يمتد من موريتانيا إلى باكستان)\nمثال: يحث المسلمون المعتدلون الأمة على رفض إرهاب المتطرفين",
 "islamism": "إسْلَامَوِيَّة, إِسْلَام سِيَاسِيّ",
 "islamist": "إسلامي (مسلم أرثوذكسي (ملتزم)) / باحث في الإسلاميات (عالم ملم بالدراسات الإسلامية)",
 "islamization": "أَسْلَمَة",
 "islamophobia": "رُهَاب الْإِسْلَام, إِسْلَامُوفُوبِيَا",
 "island": "جَزِيرَة / جزيرة",
 "island dispenser": "مضخة بنزين (مضخة في محطة خدمة تسحب البنزين من صهاريج التخزين تحت الأرض)",
 "island-dweller": "ساكن الجزيرة (أحد سكان جزيرة)",
 "islander": "جَزَرِيّ, جَزَرِيَّة",
 "islands of langerhans": "جزر لانجرهانس (مجموعات خلوية في البنكرياس تشكل الجزء الصم من ذلك العضو؛ تفرز الأنسولين وهرمونات أخرى)",
 "islay": "إيسلاي, كرز هولي الأوراق (برقوق بري دائم الخضرة من كاليفورنيا بأوراق جلدية شائكة وزهور بيضاء)",
 "isle": "جزيرة صغيرة (جزيرة صغيرة الحجم)",
 "isle of man": "جَزِيرَة مَانْ",
 "isles of langerhans": "جزر لانجرهانس (مجموعات خلوية في البنكرياس تشكل الجزء الصم من ذلك العضو؛ تفرز الأنسولين وهرمونات أخرى)",
 "islet": "جُزَيِّرَة",
 "islets of langerhans": "جُزَيْرَاتُ لَنْكَرْهَنْسَ",
 "ism": "عقيدة, فلسفة (معتقد (أو نظام معتقدات) مقبول كسلطة من قبل مجموعة أو مدرسة ما)",
 "ismaili": "إسماعيلي (مكون من أو متعلق بفرع من الشيعة يشتهر بفلسفته الباطنية) / إِسْماعِيلِيّ (معتنق للإسماعيلية؛ عضو في الفرع الإسماعيلي من الشيعة)",
 "ismailia": "الإِسْمَاعِيلِيَّة",
 "ismailian": "إِسْماعِيلِيّ (معتنق للإسماعيلية؛ عضو في الفرع الإسماعيلي من الشيعة)",
 "ismailism": "إسماعيلية (فرع من الشيعة يشتهر بفلسفته الباطنية)",
 "isn": "شبكة العلاقات الدولية والأمن (شبكة المعلومات السويسرية للدراسات الأمنية والدفاعية وأبحاث السلام والصراع والعلاقات الدولية)",
 "isn't it so": "أَلَيْسَ كَذٰلِكَ؟ / نَعَمْ؟",
 "isoagglutination": "تراص متماثل, تلازن متماثل (تراص مولد الضد لفرد ما بواسطة مصل من فرد آخر من نفس النوع)",
 "isoagglutinin": "راصة دموية (جسم مضاد ينتجه فرد ويسبب تراص خلايا الدم الحمراء في أفراد آخرين من نفس النوع)",
 "isoagglutinogen": "مولد التلزن المماثل (مستضد قادر على التسبب في إنتاج (أو التفاعل مع) راصة دموية مماثلة)",
 "isoantibody": "جسم مضاد خيفي (جسم مضاد يحدث طبيعياً ضد الأنسجة الغريبة من شخص من نفس النوع)",
 "isobar": "خط تساوي الضغط ((أرصاد جوية) خط تساوي يربط النقاط ذات الضغط الجوي المتساوي في وقت معين)",
 "isobase": "خط تساوي الارتفاع الأرضي (خط مرسوم على خريطة يربط الأماكن ذات الارتفاع الأرضي المتساوي أو الثابت)",
 "isobilateral": "ثُنَائِيّ التَّنَاظُر (له أجزاء متطابقة على كل جانب من محور)",
 "isobront": "خط تساوي الرعد (خط مرسوم عبر النقاط الجغرافية التي حدثت فيها مرحلة معينة من نشاط العواصف الرعدية في وقت واحد)",
 "isobutyl nitrite": "نتريت البوتيل (سائل لاذع عديم اللون يستخدم أحياناً كعقار منشط من قبل مدمني المخدرات)",
 "isobutylene": "أيزوبوتيلين (يُستخدم أيضاً في صنع مكونات البنزين)",
 "isobutylphenyl propionic acid": "أدفيل, إيبوبروفين (دواء مضاد للالتهاب ومسكن غير ستيرويدي (الأسماء التجارية أدفيل وموترين وغيرها) يستخدم لتخفيف آلام التهاب المفاصل وكخافض للحرارة)\nمثال: الاستخدام اليومي للإيبوبروفين يمكن أن يهيج المعدة",
 "isocarboxazid": "إيزوكاربوكسازيد, ماربلان (مثبط أكسيداز أحادي الأمين (الاسم التجاري ماربلان) يستخدم لعلاج الاكتئاب السريري)",
 "isochalaz": "خط تساوي البرد (خط يشير إلى تردد ثابت لعواصف البرد)",
 "isocheim": "خط تساوي حرارة الشتاء (خط على خريطة يربط الأماكن التي لها نفس متوسط درجة حرارة الشتاء)",
 "isochoric process": "عملية آيزوخوريك, عملية ثابتة الحجم (عملية ديناميكية حرارية يظل خلالها حجم النظام المغلق الذي يخضع لهذه العملية ثابتاً)",
 "isochronal": "مُتَسَاوِي الزَّمَن (متساوٍ في المدّة أو الفاصل الزمني)",
 "isochrone": "خط تساوي الزمن (خط تساوي يربط النقاط التي يحدث فيها شيء ما أو يصل إليها في نفس الوقت)",
 "isochronism": "إيزوكرونية, تساوي الزمن (خاصية الحدوث بانتظام في فترات زمنية متساوية، والحفاظ على فترة أو فاصل زمني ثابت، على الرغم من الاختلافات في العوامل الأخرى القابلة للقياس في نفس…)\nمثال: كان اكتشاف غاليليو هو أن فترة تأرجح البندول مستقلة عن سعته — قوس التأرجح — تساوي زمن البندول",
 "isochronous": "مُتَسَاوِي الزَّمَن (متساوٍ في المدّة أو الفاصل الزمني)",
 "isoclinal": "مُتَسَاوِي المَيْل (ذو ميول مغناطيسية متساوية) / خط تساوي الميل (خط تساوي يربط نقاط الميل المغناطيسي المتساوي)",
 "isoclinic": "مُتَسَاوِي المَيْل (ذو ميول مغناطيسية متساوية)",
 "isoclinic line": "خط تساوي الميل (خط تساوي يربط نقاط الميل المغناطيسي المتساوي)",
 "isocryme": "خط تساوي البرودة (خط يربط النقاط على سطح الأرض التي لها نفس متوسط درجة الحرارة في أبرد شهر في السنة)",
 "isocyanate": "أيزوسيانات (ملح أو إستر لحمض الأيزوسيانيك)",
 "isocyanic acid": "حمض الأيزوسيانيك (حمض يُعرف فقط في شكل إستراته)",
 "isocyclic": "مُتَجَانِسُ الحَلَقَةِ (يحتوي على حلقة مغلقة من ذرات من النوع نفسه خاصة ذرات الكربون)",
 "isodynamic line": "خط تساوي القوة المغناطيسية (خط تساوي يربط النقاط بنفس شدة القوة المغناطيسية)",
 "isoflurane": "أيزوفلوران (مخدر استنشاقي واسع الاستخدام)",
 "isogamete": "مشيج متماثل (أحد زوجين من الأمشاج المقترنة المتماثلة في الحجم والتركيب)",
 "isogamy": "تزاوج متماثل ((علم الأحياء) تكاثر عن طريق اتحاد أو اندماج أمشاج من نفس الحجم والبنية)",
 "isogeotherm": "خط تساوي حرارة الأرض (خط تساوي يربط نقاط درجة الحرارة المتساوية تحت سطح الأرض)",
 "isogloss": "حد لغوي, خط تساوي اللغة (الحدود المكانية لميزة لغوية معينة، مثل نطق حرف متحرك، أو معنى كلمة، أو استخدام ميزة نحوية)",
 "isogon": "مضلع متساوي الزوايا (مضلع زواياه متساوية)",
 "isogonal line": "خط تساوي الانحراف (خط وهمي يربط بين النقاط على سطح الأرض حيث يكون الانحراف المغناطيسي متساوياً)",
 "isogone": "خط تساوي الانحراف (خط وهمي يربط بين النقاط على سطح الأرض حيث يكون الانحراف المغناطيسي متساوياً)",
 "isogonic": "مُتَسَاوِي الزَّوَايَا (ذو زوايا متساوية أو يُشكِّل زوايا متساوية)",
 "isogonic line": "خط تساوي الانحراف (خط وهمي يربط بين النقاط على سطح الأرض حيث يكون الانحراف المغناطيسي متساوياً)",
 "isogram": "خط التساوي, خط الكنتور (خط مرسوم على خريطة يربط بين النقاط التي لها نفس القيمة العددية لمتغير ما)",
 "isohel": "خط تساوي سطوع الشمس (خط تساوي يربط النقاط التي تتلقى كميات متساوية من أشعة الشمس)",
 "isolable": "قَابِل لِلْعَزْل, قَابِل لِلْفَصْل (يمكن عزله أو فصله عن غيره)",
 "isolate": "عَزَلَ (فَصَلَ، فرَز، أَبْعَدَ؛ أَبْعَدَ، نَحَّى)\nمثال: جو بايدن طالب الكونغرس بعزل ترامب.",
 "isolated": "مَعْزُول, مُنْعَزِل (بَعِيدٌ وَمُنْفَصِلٌ مَادِّيًّا أَوِ اجْتِمَاعِيًّا) / شَارِد, مُنْعَزِل (غَيْرُ مُتَقَارِبٍ فِي الزَّمَن) / مَحْجُور, مَعْزُول (خاضع للعزل الإجباري لا سيما لأسباب صحية) / مُنْعَزِل, مُنْفَرِد (بعيد أو منفصل عن الآخرين؛ يشعر بالانفصال عنهم)",
 "isolation": "تَوَحُّد",
 "isolationism": "اِنْعِزَالِيَّة",
 "isolationist": "انعزالي (من أو يتعلق بالانعزالية) / انعزالي (مدافع عن الانعزالية في الشؤون الدولية)",
 "isolationistic": "انعزالي (من أو يتعلق بالانعزالية)",
 "isoleucine": "آيزوليوسين (حمض أميني أساسي يوجد في البروتينات؛ وهو متصاوغ مع الليوسين)",
 "isolex": "خط تساوي المفردات (حد لغوي يحدد المنطقة التي توجد فيها مفردة معينة)",
 "isomer": "أيزومر, متصاوغ (مركب يوجد في أشكال ذات ترتيبات ذرية مختلفة ولكن لها نفس الوزن الجزيئي)",
 "isomerase": "إيزوميراز (إنزيم يحفز مادته إلى شكل متصاوغ)",
 "isomeric": "آيزوميري, تزامري (متعلق بالتزامر (الآيزوميرية) أو يظهره)",
 "isomerisation": "تجازؤ, تزامر (تحويل مركب إلى نظير لنفسه)",
 "isomerism": "إيزوميرية, تزامر (حالة كونه متزامراً (إيزومير)؛ مجمع الظواهر الكيميائية والفيزيائية المميزة للمتزامرات)",
 "isomerization": "تجازؤ, تزامر (تحويل مركب إلى نظير لنفسه)",
 "isometric": "مُتَسَاوِي القِيَاس (يتعلق بـ أو ينطوي على تقلص عضلي يزداد فيه التوتر بينما يظل الطول ثابتاً) / مُتَسَاوِي القِيَاسِ (عن نظام بلوري يتميز بثلاثة محاور متساوية بزوايا قائمة) / مُتَسَاوِي الأَبْعَاد (ذو أبعاد أو قياسات متساوية) / متساوي القياس (مرتبط عن طريق تساوي القياس)",
 "isometric exercise": "تمارين الثبات, تمارين متساوية القياس (تمارين بناء العضلات التي تنطوي على انقباضات عضلية ضد المقاومة دون حركة (تنقبض العضلات ولكن طول العضلة لا يتغير))",
 "isometric line": "خط تساوي, خط متساوي القياس (خط يربط بين نقاط متساوية القياس)",
 "isometric process": "عملية آيزوخوريك, عملية ثابتة الحجم (عملية ديناميكية حرارية يظل خلالها حجم النظام المغلق الذي يخضع لهذه العملية ثابتاً)",
 "isometrical": "مُتَسَاوِي الأَبْعَاد (ذو أبعاد أو قياسات متساوية)",
 "isometrics": "تمارين الثبات, تمارين متساوية القياس (تمارين بناء العضلات التي تنطوي على انقباضات عضلية ضد المقاومة دون حركة (تنقبض العضلات ولكن طول العضلة لا يتغير))",
 "isometropia": "تساوي الانكسار (تساوي القوة الانكسارية في العينين)",
 "isometry": "تَسَاوِي القِيَاس (المساواة في القياس (مثل تساوى الارتفاع فوق مستوى سطح البحر أو تساوي علو الصوت، إلخ)) / تَسَاوِي الِارْتِفَاع (التساوي في الارتفاع فوق مستوى سطح البحر) / تَقَايُس (تخطيط واحد لواحد من فضاء متري إلى فضاء متري آخر يحافظ على المسافات بين كل زوج من النقاط) / تَنَاسُب النُّمُوّ (معدلات النمو في أجزاء مختلفة من كائن حي نامٍ تكون متساوية)",
 "isomorphic": "متشاكل (له مظهر مشابه لكنه مختلف جينياً)",
 "isomorphism": "تَسَاوِي الشَّكْل, تَمَاثُل بَلُّورِيّ ((في علم الأحياء) تشابه أو تطابق الشكل أو الهيئة أو البنية)",
 "isomorphous": "متشاكل (له مظهر مشابه لكنه مختلف جينياً)",
 "isomorphy": "تَسَاوِي الشَّكْل, تَمَاثُل بَلُّورِيّ ((في علم الأحياء) تشابه أو تطابق الشكل أو الهيئة أو البنية)",
 "isonade": "إيسونادي",
 "isoniazid": "آيزونيازيد, نيدرازين (دواء مضاد للبكتيريا (الاسم التجاري نيدرازين) يستخدم لعلاج السل)",
 "isophene": "خط تساوي الظواهر البيولوجية (خط يشير إلى الأحداث البيولوجية التي تحدث بالتزامن مثل إزهار النباتات)",
 "isophone": "خط تساوي الصوت (في اللسانيات، حد لغوي يحدد منطقة توجد فيها ميزة نطق معينة)",
 "isopiestic line": "خط تساوي ضغط الماء الجوفي (خط على خريطة يربط الأماكن ذات ضغط المياه الجوفية المتساوي)",
 "isopieze": "خط تساوي ضغط الماء الجوفي (خط على خريطة يربط الأماكن ذات ضغط المياه الجوفية المتساوي)",
 "isopleth": "خط التساوي, خط الكنتور (خط مرسوم على خريطة يربط بين النقاط التي لها نفس القيمة العددية لمتغير ما)",
 "isopod": "متماثلات الأرجل (أي من القشريات البرية أو المائية الصغيرة المختلفة بسبعة أزواج من الأرجل المتكيفة للزحف)",
 "isopropanol": "إيزوبروبانول, كحول إيزوبروبيلي (كحول يستخدم كمضاد للتجمد أو مذيب)",
 "isopropyl alcohol": "إيزوبروبانول, كحول إيزوبروبيلي (كحول يستخدم كمضاد للتجمد أو مذيب)",
 "isoproterenol": "إيزوبروتيرينول, إيسوبريل (دواء (الاسم التجاري إيسوبريل) يستخدم لعلاج الربو الشعبي وتنشيط القلب)",
 "isopteran": "أرضي, متعلق بالنمل الأبيض (متعلق بـ أو مميز لحشرات رتبة متساويات الأجنحة (النمل الأبيض))",
 "isoptin": "إيزوبتين, فيراباميل (دواء (الأسماء التجارية كالان وإيزوبتين) يستخدم كحاصر للكالسيوم عن طريق الفم أو الحقن في حالات ارتفاع ضغط الدم أو فشل القلب الاحتقاني أو الذبحة…)",
 "isopyrum biternatum": "سداب كاذب, شقائق النعمان الكاذبة (نبات معمر نحيل وقائم في شرق أمريكا الشمالية له جذور درنية وأزهار بيضاء مشوبة بالوردي؛ يشبه سداب المروج)",
 "isordil": "إيزورديل, إيزوسوربيد (دواء (الاسم التجاري إيزورديل) يستخدم لعلاج الذبحة الصدرية وفشل القلب الاحتقاني)",
 "isosceles": "مُتَسَاوِي السَّاقَيْن ((للمثلث) له ضلعان متساويان في الطول)",
 "isosceles triangle": "مثلث متساوي الساقين (مثلث له ضلعان متساويان)",
 "isoseismal": "خط تساوي الزلزال (خط على خريطة يربط النقاط التي تكون فيها الهزات الأرضية متساوية الشدة)",
 "isosmotic": "متساوي التوتر, متساوي الضغط الأسموزي ((يستخدم للمحاليل) لها نفس الضغط الأسموزي أو ضغط متساوٍ)",
 "isosmotic solution": "محلول متساوي التوتر (محلول له نفس الضغط الاسموزي للدم)",
 "isosorbide": "إيزورديل, إيزوسوربيد (دواء (الاسم التجاري إيزورديل) يستخدم لعلاج الذبحة الصدرية وفشل القلب الاحتقاني)",
 "isostasy": "توازن القشرة الأرضية, توازن تضاغطي ((في الجيولوجيا) توازن عام للقوى التي تميل إلى رفع أو خفض القشرة الأرضية)",
 "isosyllabism": "تساوي المقاطع ((لسانيات، شعر) استخدام الشعر متساوي المقاطع)",
 "isotach": "خط تساوي سرعة الرياح (خط يربط النقاط ذات سرعة الرياح الثابتة)",
 "isothere": "خط تساوي حرارة الصيف (خط على خريطة يربط الأماكن التي لها نفس متوسط درجة حرارة الصيف)",
 "isotherm": "خط تساوي الحرارة ((أرصاد جوية) خط تساوي يربط النقاط التي لها نفس درجة الحرارة في وقت معين)",
 "isothermal": "مُتَسَاوِي الحَرَارَة ((عن عملية أو تغيّر) يحدث عند درجة حرارة ثابتة)",
 "isothermic": "آيزوثرمي, متساوي الحرارة (متعلق بخط تساوي الحرارة (الآيزوثرم))",
 "isothiocyanate": "إيزوثيوسيانات (عائلة من المركبات المشتقة من الفجل والبصل والخردل؛ مصدر حرارة تلك النباتات)",
 "isotonic": "مُتَسَاوِي التَّوَتُّر (يتعلق بـ أو ينطوي على تقلص عضلي يكون فيه التوتر ثابتاً بينما يتغير الطول) / متساوي التوتر, متساوي الضغط الأسموزي ((يستخدم للمحاليل) لها نفس الضغط الأسموزي أو ضغط متساوٍ) / مُتَسَاوِي التَّوَتُّر ((لِعَضَلَتَيْنِ أَوْ أَكْثَرَ) ذَوَاتُ تَوَتُّرٍ مُتَسَاوٍ) / متساوي النغمة (متعلق بالفواصل المتساوية للسلم الموسيقي أو يتميز بها)\nمثال: دوزان متساوي النغمة",
 "isotonic exercise": "تمارين متساوية التوتر (تمرين تنقبض فيه العضلات المتقابلة وتوجد حركة مسيطر عليها (يكون التوتر ثابتاً بينما يتغير طول العضلات))\nمثال: التمرين الكلاسيكي متساوي التوتر هو رفع الأوزان الحرة",
 "isotonic solution": "محلول متساوي التوتر (محلول له نفس الضغط الاسموزي للدم)",
 "isotope": "نَظِير",
 "isotopic": "نظائري (متعلق بالنظائر أو يمتلك علاقة النظائر)",
 "isotropic": "مُتَمَاثِل المَنَاحِي, مُتَنَاحٍِ",
 "isotropically": "بشكل موحد الخواص (بطريقة متساوية الخواص في جميع الاتجاهات)",
 "isotropous": "متماثل الخصائص, موحد الخواص (ثابت الخصائص بغض النظر عن الاتجاه)",
 "isotropy": "تماثل الخواص, توحد الخواص ((فيزياء) خاصية كون الشيء متماثل الخواص؛ له نفس القيمة عند قياسه في اتجاهات مختلفة)",
 "isovolumetric process": "عملية آيزوخوريك, عملية ثابتة الحجم (عملية ديناميكية حرارية يظل خلالها حجم النظام المغلق الذي يخضع لهذه العملية ثابتاً)",
 "israel": "إِسْرَائِيل (لقب أُطلق على ٱلنَّبِيِّ يَعْقُوب بن إسحاق عليهما السلام؛ بنو إسرائيل: هم ذُرِّيَّة نبي الله يعقوب عليه السلام) / دولة إسرائيل (بَلَد يتميز بحُدُود معروفة وشَعْب وحُكُومَة ومُؤَسَسَات مُنَظَّمَة؛ مجموعة من الناس مستقلين متحدين معا لتكوين مجتمع لحماية حقوقهم و وضع قوانينهم الخاصة)\nمثال: أنا من إسرائيل.",
 "israeli": "إِسْرَائِيلِيّ, إِسْرَائِيلِيَّة",
 "israeli defense force": "جيش الدفاع الإسرائيلي (القوات البرية والجوية والبحرية لإسرائيل)",
 "israeli monetary unit": "وحدة نقدية إسرائيلية (الوحدة النقدية في إسرائيل)",
 "israelite": "إِسْرَائِيلِيٌّ",
 "israelites": "بنو إسرائيل, عبرانيون (المجموعة العرقية التي تدعي النسب إلى إبراهيم وإسحاق (وخاصة من يعقوب بن إسحاق)؛ الأمة التي اختارها الله لتلقي وحيه والتي اختار الله أن يبرم عهداً معها)",
 "isratine": "إِسْرَاطِين",
 "issuance": "إصدار, إطلاق (فعل توفير عنصر للاستخدام العام أو لأغراض رسمية (عادة بكميات))\nمثال: إصدار جديد من الطوابع",
 "issue": "عَدَد (مِقْدَار مَا يُعَدّ) / مُشْكِل, مَسْأَلَة\nمثال: كم عدد سكان الجزائر؟",
 "issuer": "جهة إصدار, مُصدِر (مؤسسة تصدر شيئاً ما (أوراق مالية أو منشورات أو عملة وما إلى ذلك))",
 "issuing": "إصدار, إطلاق (فعل توفير عنصر للاستخدام العام أو لأغراض رسمية (عادة بكميات))\nمثال: إصدار جديد من الطوابع",
 "issuing house": "بيت إصدار (بنك أو مؤسسة مالية أخرى تقوم بتسجيل وتوزيع وبيع ورقة مالية في السوق الأولية نيابة عن شركة أخرى)",
 "istakhr": "إِصْطَخْر",
 "istanbul": "إِسْطَنْبُول, إِسْتَنْبُول",
 "istanbulite": "إِسْتَانْبُولِيّ",
 "isthmian": "برزخي (مكون من أو متعلق بـ أو يشكل برزخاً)",
 "isthmian games": "الألعاب الإسثمية (الألعاب الهيلينية القديمة التي كانت تقام كل سنتين في برزخ كورنث في السنة الأولى والثالثة من كل دورة أولمبية)",
 "isthmus": "بَرْزَخ",
 "istighfar": "اِسْتِغْفَار (مصدر للفعل \"اسْتَغْفَرَ\"؛ (في الدين) طلب المغفرة من الله)",
 "istiophorus albicans": "سمكة الشراع الأطلسية (نوع من سمك الشراع)",
 "istria": "إستريا",
 "isuprel": "إيزوبروتيرينول, إيسوبريل (دواء (الاسم التجاري إيسوبريل) يستخدم لعلاج الربو الشعبي وتنشيط القلب)",
 "isurus glaucus": "قرش بونيتو (قرش أزرق رمادي شائع في جنوب غرب المحيط الهادئ؛ سمكة رياضة وطعام)",
 "isurus oxyrhinchus": "ماكو قصير الزعنفة (قرش مزرق نشط وسريع جداً يوجد في جميع أنحاء العالم في المياه الدافئة؛ سمكة صيد مهمة)",
 "isurus oxyrhincus": "ماكو قصير الزعنفة (قرش مزرق نشط وسريع جداً يوجد في جميع أنحاء العالم في المياه الدافئة؛ سمكة صيد مهمة)",
 "isurus paucus": "ماكو طويل الزعنفة (يشبه الماكو قصير الزعنفة ولكنه أزرق داكن أكثر)",
 "it": "هُوَ, هِيَ / ـهُ (الحرف السادس والعشرون من الأحرف الهجائية؛ يسبقه \"ن\"، ويتلوه \"و\"؛ اختصارًا لـ\"لِلْهِجْرَة\"، تُكتب بعد التاريخ لتدل على أنه في التقويم الهجري)",
 "it can't be helped": "لَا مَفَرّ, لَا أَسْتَطِيع ذٰلِك (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: لا أحب المدرسة.",
 "it depends": "ذلك يعتمد",
 "it goes without saying": "مِن نَّافِلَةِ القَوْلِ (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "it takes two to tango": "انها رقصَة التانغو تتطلب شخصين",
 "it was delicious": "كَانَ لَذِيذًا جِدًّا (اِتَّصَفَ. (فعل ناقص)؛ حَدَثَ)\nمثال: كان الكلب ميتا.",
 "it's": "اِنَّه / اِنَّهَا",
 "it's an emergency": "إِنَّهَا حَالَة طَوَارِئ",
 "it's cold outside": "الْجَوُّ بَارِدٌ فِي الْخَارِجِ, الطَّقْسُ بَارِدٌ فِي الْخَارِجِ",
 "it's raining": "تُمْطِرُ السَّمَاء, تَمْطُرُ السَّمَاء",
 "it's snowing": "تَثْلُج اَلسَّمَاء",
 "it's too expensive": "هٰذَا اَلسِّعْر غَالٍ جِدًّا",
 "itaconic acid": "حمض الإيتاكونيك (حمض كربوكسيلي بلوري؛ يحدث في بعض عمليات تخمير السكريات)",
 "italian": "إِيطَالِيّ",
