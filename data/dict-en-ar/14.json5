 "iridokeratitis": "التهاب القزحية والقرنية (التهاب القزحية وقرنية العين)",
 "iridoncus": "ورم القزحية (تورم قزحية العين)",
 "iridoprocne bicolor": "سنونو أبيض البطن (سنونو أخضر مزرق وأبيض من أمريكا الشمالية؛ يعشش في تجاويف الأشجار)",
 "iridosmine": "أوزميريديوم (معدن صلب ومقاوم للتآكل وهو سبيكة طبيعية من الأوزميوم والإيريديوم (يحتوي عادة على كميات صغيرة من الروديوم والبلاتين)؛ يستخدم في الإبر وسنون الأقلام…)",
 "iridotomy": "بضع القزحية (إجراء جراحي يحدث شقاً في قزحية العين لتوسيع الحدقة أو لعلاج الجلوكوما مغلقة الزاوية)",
 "iris": "قُزَحِيَّة",
 "iris cristata": "سوسن قزم (سوسن منخفض النمو يزهر في الصيف من شمال شرق الولايات المتحدة)",
 "iris diaphragm": "حجاب قزحي, قزحية (حجاب حاجز يتكون من صفائح رقيقة متداخلة يمكن تعديلها لتغيير قطر الفتحة المركزية)",
 "iris filifolia": "سوسن هولندي (سوسن إسباني بصلي ذو زهور حمراء بنفسجية)",
 "iris florentina": "سوسن فلورنسي (سوسن جرماني له زهور بيضاء كبيرة مع بتلات مشوبة بالخزامى وجذمور عطري)",
 "iris foetidissima": "سوسن كريه الرائحة (سوسن بزهور أرجوانية وأوراق كريهة الرائحة؛ جنوب وغرب أوروبا وشمال أفريقيا)",
 "iris germanica": "سوسن جرماني (سوسن كبير ذو زهور أرجوانية أو بيضاء، موطنه وسط وجنوب أوروبا)",
 "iris germanica florentina": "سوسن فلورنسي (سوسن جرماني له زهور بيضاء كبيرة مع بتلات مشوبة بالخزامى وجذمور عطري)",
 "iris kaempferi": "سوسن ياباني (سوسن موطنه اليابان له زهور كبيرة ملفتة للنظر)",
 "iris kochii": "سوسن كوشي (سوسن من شمال إيطاليا له زهور زرقاء أرجوانية عميقة؛ يشبه السوسن الجرماني ولكنه أصغر)",
 "iris pallida": "سوسن دلماسي (سوسن أوروبي له زهور زرقاء ليلكية ناعمة)",
 "iris persica": "سوسن فارسي (سوسن بصلي موطنه آسيا الصغرى يزرع لزهوره ذات اللون الليلكي الشاحب)",
 "iris pseudacorus": "سوسن أصفر, سوسن الماء الأصفر (سوسن أصفر الأزهار شائع في أوروبا وشمال أفريقيا، توطن في الولايات المتحدة ويزرع غالباً)",
 "iris scanning": "مسح القزحية (تحديد هوية بيومتري عن طريق مسح قزحية العين)\nمثال: تقنيات بيومترية مثل مسح القزحية",
 "iris tingitana": "سوسن طنجة (سوسن إسباني بصلي له زهور زرقاء)",
 "iris verna": "سوسن ربيعي, سوسن قزم (سوسن أمريكي منخفض النمو يزهر في الربيع بزهور ليلكية زرقاء زاهية)",
 "iris versicolor": "سوسن أزرق, سوسن مبرقش (سوسن شائع في شرق الولايات المتحدة له زهور زرقاء أو زرقاء بنفسجية؛ كان جذره يستخدم طبياً سابقاً)",
 "iris virginica": "سوسن جنوبي أزرق (يشبه السوسن الأزرق؛ شرق الولايات المتحدة)",
 "iris xiphioides": "سوسن إنجليزي (سوسن بصلي موطنه البرانس؛ يزرع على نطاق واسع لزهوره الكبيرة الرقيقة بألوان مختلفة عدا الأصفر)",
 "iris xiphium": "سوسن إسباني (سوسن بصلي من منطقة غرب البحر الأبيض المتوسط له زهور بنفسجية أرجوانية عادة)",
 "irish": "أَيِرْلَنْدِيّ / إِيرْلَنْدِيّ, إِيرْلَنْدِيَّة",
 "irish bull": "كَلَام بَذِيء, هُرَاء (كلمة بذيئة للسلوك غير المقبول)\nمثال: تحملت الكثير من الهراء من ذلك الأحمق",
 "irish burgoo": "برغو إيرلندي, يخنة موليجان (نسخة إيرلندية من البرغو)",
 "irish coffee": "قهوة إيرلندية (قهوة محلاة مع الويسكي الأيرلندي والكريمة المخفوقة)",
 "irish english orthography": "الإملاء البريطاني, التهجئة البريطانية (قواعد الإملاء الإنجليزية المستخدمة في المملكة المتحدة وأيرلندا ومعظم دول الكومنولث)",
 "irish english spelling": "الإملاء البريطاني, التهجئة البريطانية (قواعد الإملاء الإنجليزية المستخدمة في المملكة المتحدة وأيرلندا ومعظم دول الكومنولث)",
 "irish gaelic": "الغيلية الأيرلندية, اللغة الأيرلندية (اللغة الكلتية لأيرلندا)",
 "irish gaelic language": "الغيلية الأيرلندية, اللغة الأيرلندية (اللغة الكلتية لأيرلندا)",
 "irish gorse": "جولق, وزال (شجيرة دائمة الخضرة شائكة وكثيفة جداً ذات زهور صفراء ذهبية عطرة؛ شائعة في جميع أنحاء أوروبا الغربية)",
 "irish language": "الغيلية الأيرلندية, اللغة الأيرلندية (اللغة الكلتية لأيرلندا)",
 "irish monetary unit": "وحدة نقدية أيرلندية (الوحدة النقدية في أيرلندا)",
 "irish moss": "طحلب أيرلندي, كاراجين (عشب بحري أرجواني داكن صالح للأكل من سواحل المحيط الأطلسي لأوروبا وأمريكا الشمالية)",
 "irish people": "الأيرلنديون (شعب أيرلندا أو ذوو الأصول الأيرلندية)",
 "irish person": "أيرلندي (مواطن أو ساكن في أيرلندا)",
 "irish potato": "بطاطا, بطاطس (درنة صالحة للأكل موطنها أمريكا الجنوبية؛ طعام أساسي في أيرلندا)",
 "irish pound": "بونت, جنيه (سابقاً وحدة المال الأساسية في أيرلندا؛ تساوي 100 بنس)",
 "irish punt": "بونت, جنيه (سابقاً وحدة المال الأساسية في أيرلندا؛ تساوي 100 بنس)",
 "irish sea": "اَلْبَحْر الأَيِرْلَنْدِيّ",
 "irish setter": "سيتر إيرلندي (سلالة أيرلندية ذات فراء بني كستنائي أو أحمر ماهوجني)",
 "irish soda bread": "خبز الصودا الأيرلندي (رغيف مستدير مصنوع من الصودا واللبن الرائب؛ يحتوي غالباً على بذور الكراويا والزبيب)",
 "irish spelling": "الإملاء البريطاني, التهجئة البريطانية (قواعد الإملاء الإنجليزية المستخدمة في المملكة المتحدة وأيرلندا ومعظم دول الكومنولث)",
 "irish stew": "يخنة إيرلندية (لحم (خاصة الضأن) مطهي مع البطاطس والبصل)",
 "irish strawberry": "شجرة الفراولة, قطلب أونيدو (شجرة شجيرية أوروبية صغيرة دائمة الخضرة تحمل توتاً قرمزياً عديد البذور صالحاً للأكل ولكنه قليل النكهة؛ من أيرلندا وجنوب أوروبا وآسيا الصغرى)",
 "irish terrier": "تيريير إيرلندي (سلالة متوسطة الحجم ذات فراء بني سلكي الملمس؛ طورت في أيرلندا)",
 "irish traveller": "رُحَّل أَيِرْلَنْدِيُون, اَلرُّحَّل اَلْأَيِرْلَنْدِيُون (رَحَّلَ ترحيلًا: جعله يرحل؛ رَحَّلَ الثوبَ: وشاه ونقشه)\nمثال: رحل سامي من مصر.",
 "irish water spaniel": "سبانييل الماء الأيرلندي (سلالة من سبانييل كبيرة طورت في أيرلندا ذات معطف كثيف من تجعيدات بلون الكبد وعقدة علوية من تجعيدات طويلة وذيل شبه أصلع)",
 "irish whiskey": "ويسكي أيرلندي (ويسكي مصنوع في أيرلندا بشكل رئيسي من الشعير)",
 "irish whisky": "ويسكي أيرلندي (ويسكي مصنوع في أيرلندا بشكل رئيسي من الشعير)",
 "irish wolfhound": "كلب صيد الذئاب الإيرلندي (سلالة كبيرة من كلاب الصيد ذات فراء خشن كثيف)",
 "irishman": "أَيِرْلَنْدِيّ",
 "irishwoman": "أيرلندية, امرأة أيرلندية (امرأة مواطنة أو ساكنة في أيرلندا)",
 "iritic": "قزحي (مكون من أو متعلق بموقع قريب من قزحية العين)",
