 "ipod": "آي بُود",
 "ipomoea alba": "أثمان أبيض, زهرة القمر (متسلق استوائي شامل له زهور ليلية بيضاء عطرة)",
 "ipomoea batatas": "بطاطا حلوة, كرمة البطاطا الحلوة (كرمة استوائية شاملة تزرع على نطاق واسع في عدة أصناف لجذرها الدرني الحلو الكبير ذي اللب البرتقالي)",
 "ipomoea coccinea": "أثمان قرمزي, مجد الصباح الأحمر (عشب حولي له زهور قرمزية؛ شرق الولايات المتحدة)",
 "ipomoea fastigiata": "كرمة البطاطا البرية (نبات معمر عشبي مفترش أو متسلق أمريكي استوائي له جذر نشوي ضخم؛ يعتبر أحياناً مصدراً للبطاطا الحلوة)",
 "ipomoea imperialis": "مجد الصباح الياباني الإمبراطوري (رفع شأن شيء أو شخص وعظمه وأضفى عليه قيمة كبيرة؛ أثنى على عظمة شيء أو شخص وأشاد به)\nمثال: المجد لأوكرانيا",
 "ipomoea leptophylla": "أثمان رفيع الأوراق, رجل الأرض (نبات مجد الصباح بجذور طويلة من غرب الولايات المتحدة)",
 "ipomoea nil": "أثمان نيلي, مجد الصباح الياباني (عشب متسلق استوائي حولي من العالم القديم يتميز بمجموعة واسعة من الألوان وزهور مكشكشة أو مزدوجة)",
 "ipomoea orizabensis": "أثمان أوريزابي, سقمونيا (نبات مجد الصباح الأمريكي الاستوائي)",
 "ipomoea panurata": "كرمة البطاطا البرية (نبات معمر عشبي مفترش أو متسلق أمريكي استوائي له جذر نشوي ضخم؛ يعتبر أحياناً مصدراً للبطاطا الحلوة)",
 "ipomoea pes-caprae": "أثمان قدم الماعز, كرمة السكة الحديد (نبات معمر مفترش في الكثبان الرملية الساحلية من فلوريدا إلى تكساس)",
 "ipomoea purpurea": "أثمان أرجواني, مجد الصباح الشائع (عشب متسلق حولي استوائي شامل بزهور قمعية الشكل زرقاء أو أرجوانية أو وردية أو بيضاء)",
 "ipomoea quamoclit": "أثمان ريشي, كرمة السرو (متسلق حولي أمريكي استوائي له زهور حمراء (وأحياناً بيضاء) وأوراق مقطعة بدقة؛ تم توطينه في الولايات المتحدة وأماكن أخرى)",
 "ipomoea tricolor": "أثمان ثلاثي الألوان, مجد الصباح الشائع (عشب متسلق حولي أو معمر من أمريكا الوسطى له زهور زرقاء سماوية؛ أكثر أنواع مجد الصباح زراعة)",
 "ipratropium bromide": "أتروفنت, إبراتروبيوم بروميد (موسع للقصبات عن طريق الاستنشاق (الاسم التجاري أتروفنت))",
