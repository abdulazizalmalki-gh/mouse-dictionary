 "imaginative comparison": "تَشْبِيه, مُقَارَنَة خَيَالِيَّة (نوع المقارنة الذهنية التي يتم التعبير عنها في التشبيهات أو الاستعارات أو الرموز)",
 "imaginatively": "بإبداع, بخيالية\nمثال: زينت الغرفة بخيالية كبيرة",
 "imaginativeness": "تصور, خيال (تكوين صورة ذهنية لشيء لا يُدرك على أنه حقيقي وليس حاضرًا للحواس)\nمثال: خلق الخيال الشعبي عالمًا من الشياطين",
 "imagine": "تَخَيَّلَ, تَصَوَّرَ",
 "imaging": "تصوير طبي, تصوير مقطعي ((طب) الحصول على صور لداخل الجسم) / تخيل, خيال (القدرة على تكوين صور ذهنية للأشياء أو الأحداث)\nمثال: كان لا يزال يسمعها في خياله",
 "imagism": "التصويرية (حركة لشعراء أمريكيين وإنجليز في أوائل القرن العشرين كرد فعل على العاطفية الفيكتورية؛ استخدمت لغة مشتركة في الشعر الحر مع صور حسية واضحة)",
 "imago": "حشرة كاملة, يافعة (حشرة بالغة ناتجة بعد التحول) / إيماجو, صورة الوالد ((في التحليل النفسي) صورة مثالية لشخص (عادة أحد الوالدين) تشكلت في الطفولة)",
 "imam": "إِمَام",
 "imamate": "إِمَامَة",
 "imaret": "تكية, عمارة (نزل للحجاج في تركيا)",
 "imaum": "إمام ((في الإسلام) الرجل الذي يؤم الصلاة في المسجد؛ وعند الشيعة الإمام هو مرجع معترف به في الشريعة وأصول الدين ومرشد روحي)",
 "imavate": "إيميبرامين, توفرانيل (مضاد اكتئاب ثلاثي الحلقات (الأسماء التجارية توفرانيل وغيرها) يستخدم لعلاج الاكتئاب السريري)",
 "imbalance": "اخْتِلَال التَّوَازُن, عَدَم تَنَاسُب (افتقار للتناسب؛ عدم توازن بين أجزاء الشيء) / اختلال, عدم استقرار (نقص التوازن أو حالة اختلال التوازن)\nمثال: اختلال هرموني",
 "imbalanced": "غير متوازن, مختل التوازن (كونه خارج التوازن أو تم إخراجه عن التوازن)",
 "imbauba": "سيكروبيا, شجرة البوق (شجرة أمريكية استوائية بأوراق درعية كبيرة وسيقان مجوفة)",
 "imbecile": "أَبْلَه, مَعْتُوه (ذو عمر عقلي يتراوح بين ثلاث وسبع سنوات) / أبله, متخلف عقلياً (شخص ذو ذكاء دون الطبيعي)",
 "imbecilic": "أَبْلَه, مَعْتُوه (ذو عمر عقلي يتراوح بين ثلاث وسبع سنوات)",
 "imbecility": "حماقة, غباء (خطأ سخيف) / بلاهة (تخلف عقلي أشد من البله ولكن ليس بشدة العته)",
 "imbiber": "سكير, شارب الخمر (شخص يشرب المشروبات الكحولية (خاصة بإفراط))",
 "imbibing": "شرب (فعل استهلاك السوائل)",
 "imbibition": "شرب (فعل استهلاك السوائل) / تشرب ((في الكيمياء) امتصاص سائل بواسطة مادة صلبة أو هلام)",
 "imbricate": "مُتَرَاكِب (مرتّب بحيث تتراكب الحواف كقرميد السقف)",
 "imbricated": "مُتَرَاكِب (مرتّب بحيث تتراكب الحواف كقرميد السقف)",
 "imbrication": "تداخل, تراكب (غطاء بتصميم يغطي فيه عنصر جزءاً من عنصر آخر (كما هو الحال في البلاط أو القرميد))",
