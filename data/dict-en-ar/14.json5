 "if and only if": "شَرْطَ أَنّ, فَقَط إِذَا (شَرِطَ فلانٌ يَشْرِطِ شَرْطًا: وقع في أَمر عظيمٍ)\nمثال: صرخ ليون: \"شرطة!\"",
 "if not": "إِلَّا (حرف استثناء؛ في : للسؤال المنفي، مرادف لبَلَى في الفصحى)\nمثال: لا أعرف إلا هذا.",
 "if only": "لَيْتَ, تَمَنَّى (يفيد التمني)\nمثال: ليت بحاجة لتعمل ساعات إضافية.",
 "ifc": "مؤسسة التمويل الدولية (وكالة تابعة للأمم المتحدة تستثمر مباشرة في الشركات وتضمن القروض للمستثمرين من القطاع الخاص؛ تابعة للبنك الدولي)",
 "iffy": "عُرْضَة لِلْمُصَادَفَة, مُتَقَلِّب (خاضع للحوادث أو المصادفة أو التقلّب)",
 "ifrit": "عِفْرِيت",
 "iftar": "إِفْطَار",
 "ig": "غلوبولين مناعي (فئة من البروتينات تُنتج في الأنسجة الليمفاوية في الفقاريات وتعمل كأجسام مضادة في الاستجابة المناعية)",
 "iga": "الغلوبولين المناعي أ (واحدة من أكثر الفئات الخمس الرئيسية للغلوبولين المناعي شيوعاً؛ الجسم المضاد الرئيسي في أغشية الجهاز الهضمي والجهاز التنفسي)",
 "igbo": "إِيغْبُو (عضو في أكبر مجموعة عرقية في جنوب شرق نيجيريا)\nمثال: معظم الإيغبو مزارعون",
 "igd": "الغلوبولين المناعي د (واحدة من الفئات الخمس الرئيسية للغلوبولين المناعي؛ توجد في مصل الدم بكميات صغيرة)",
 "ige": "الغلوبولين المناعي هـ (واحدة من الفئات الخمس الرئيسية للغلوبولين المناعي؛ توجد بشكل أساسي في الجلد والأغشية المخاطية)",
 "igg": "الغلوبولين المناعي ج (واحدة من الفئات الخمس الرئيسية للغلوبولين المناعي؛ الدفاع الرئيسي بالأجسام المضادة ضد البكتيريا)",
 "iglishmek": "إغليشميك (لغة مبنية ابتكرها جي آر آر تولكين، وهي لغة إشارة يستخدمها الأقزام في الأرض الوسطى)\nمثال: إغليشميك هي الأكثر تقدماً بفارق كبير بين لغات الإيماءات في الأرض الوسطى، كونها النظام الأكثر تفصيلاً وتنظيماً",
 "igloo": "مَبْنًى قَبَّانِي, مَبْنًى اَلقَبَّانِي (كل ما بُنِيَ؛ ما يُبْنى على أرضٍ محاطا بالجُدْرَان ومغطى بسَقْف. (تخصيص))\nمثال: دخل توم المبنى.",
 "iglu": "إيغلو, كوخ اسكيمو (كوخ للإسكيمو؛ يبنى عادة من كتل (من العشب أو الثلج) على شكل قبة)",
 "igm": "الغلوبولين المناعي م (واحدة من الفئات الخمس الرئيسية للغلوبولين المناعي؛ تشارك في محاربة التهابات الدم وفي تحفيز إنتاج الغلوبولين المناعي ج)",
 "ignatius": "إِغْنَاطِيُوس",
 "igneous": "مُتَوَهِّج, نَارِيّ (يُشبه النار أو يُوحي بها) / بركاني, ناري (مُنتَج بفعل النار أو الحرارة الشديدة) / صهيري, ناري (منتج تحت ظروف تنطوي على حرارة شديدة)\nمثال: صخور تشكلت بواسطة عوامل نارية",
 "igneous rock": "صَخَر نَارِيّ",
 "ignescent": "شَرَارِيّ (يمكن أن يُصدر شرارات أو يندلع بالنيران)",
 "ignis fatuus": "سراب, وهم خادع (وهم يضلل) / مصباح العفريت, نار هائمة (ضوء باهت يُرى أحياناً في الليل فوق الأرض المستنقعية)",
 "ignitable": "قَابِل لِلإِشْعَال, قَابِل لِلْحَرْق (يمكن أن يحترق)",
 "ignited": "مُضْرَم, مُوقَد (أُشعلت فيه النار)",
 "igniter": "قداحة, مشعل (جهاز لإشعال الوقود أو الشحنات أو الحرائق) / مادة إشعال, مشعل (مادة تستخدم لإشعال النار أو إضرامها)\nمثال: هل لديك ولاعة؟",
 "ignitible": "قَابِل لِلإِشْعَال, قَابِل لِلْحَرْق (يمكن أن يحترق)",
 "ignition": "إشعال, إضرام (عملية إضرام النار في شيء ما) / نظام إشعال (الآلية التي تشعل الوقود في محرك الاحتراق الداخلي) / إشعال, اتقاد (عملية بدء الاحتراق أو اشتعال النار)",
 "ignition coil": "بوبينة, ملف الإشعال (ملف حث يحول التيار من البطارية إلى تيار عالي الجهد مطلوب لشمعات الإشعال)",
 "ignition interlock": "جهاز منع التشغيل, قفل تعشيق (جهاز يمنع محرك السيارة من البدء)\nمثال: يعرف لصوص السيارات كيفية تجاوز قفل التعشيق",
 "ignition key": "مفتاح تشغيل (مفتاح يشغل مفتاح الإشعال لمحرك السيارة)",
 "ignition lock": "قفل تشغيل (قيد مدمج في مفتاح الإشعال لمنع استخدام المركبة من قبل أشخاص لا يملكون المفتاح)",
 "ignition switch": "مفتاح الإشعال (مفتاح يشغل ملفاً لولبياً يغلق دائرة لتشغيل بادئ التشغيل)",
 "ignition system": "نظام إشعال (الآلية التي تشعل الوقود في محرك الاحتراق الداخلي)",
 "ignitor": "قداحة, مشعل (جهاز لإشعال الوقود أو الشحنات أو الحرائق) / مادة إشعال, مشعل (مادة تستخدم لإشعال النار أو إضرامها)\nمثال: هل لديك ولاعة؟",
 "ignobility": "خسة, دناءة (صفة كون الشخص خسيساً)",
 "ignoble": "خسيس, وضيع (يفتقر تماماً للنبل في الشخصية أو الجودة أو الغرض) / بِلَا لَقَب, غَيْر نَبِيل (لا ينتمي إلى طبقة النبلاء)\nمثال: شيء جبان وخسيس في موقفه",
 "ignobleness": "خسة, دناءة (صفة كون الشخص خسيساً)",
 "ignobly": "بِخِسَّة, بِلُؤْم (بطريقة دنيئة؛ بلؤم)\nمثال: تصرف بخسة",
 "ignominious": "فَاضِح, مُخْزٍ ((للسلوك أو الشخصيَّة) يستحقّ العار أو يجلبه)",
 "ignominiousness": "خزي, عار (عدم الجدارة المستوجب للعار والفضيحة العامة)",
 "ignominy": "خزي, عار (حالة من عدم الشرف)\nمثال: خطأ واحد جلب العار لكل عائلته",
 "ignoramus": "جاهل, غير متعلم (شخص يفتقر للمعرفة)",
 "ignorance": "جَهْل, جَهَالَة (الجَهْل: نَقِيضُ العِلْم؛ تَجَاهَلَ: أَظهر الجَهْل)\nمثال: العلم نور والجهل ظلام.",
 "ignorance is bliss": "الْجَهْل نَعِيمَهُ, الْجَهْل نِعْمَة",
 "ignorant": "جَاهِل",
 "ignorantly": "بجهل (في جهل؛ بطريقة جاهلة)\nمثال: عاشوا بجهل في عالمهم الصغير",
 "ignorantness": "جهالة, عدم دراية (الجهل (خاصة بالمعتقدات التقليدية))",
 "ignoratio elenchi": "تجاهل المطلوب (المغالطة المنطقية المتمثلة في افتراض أن حجة تثبت نقطة غير ذات صلة قد أثبتت النقطة محل الخلاف)",
 "ignore": "تَجَاهَلَ, طَنَّش",
 "ignored": "مُتَجَاهَل, مُهْمَل (لم يُؤبَه له؛ أُهمِل عمداً)",
 "ignosticism": "غنوسطية",
 "iguana": "إِغْوَانَا",
 "iguana iguana": "إغوانة شائعة (سحالي شجرية أمريكية استوائية كبيرة آكلة للأعشاب ذات عرف شائك على طول الظهر؛ تُستخدم كطعام بشري في أمريكا الوسطى والجنوبية)",
 "iguanid": "إغوانة (سحالي العالم الجديد ومدغشقر وبعض جزر المحيط الهادئ؛ تتميز عادة بذيل طويل ورقعة حلق زاهية في الذكور)",
 "iguanid lizard": "إغوانة (سحالي العالم الجديد ومدغشقر وبعض جزر المحيط الهادئ؛ تتميز عادة بذيل طويل ورقعة حلق زاهية في الذكور)",
 "iguanodon": "إغوانودون (ديناصور عاشب ضخم ثنائي الأرجل ذو ذيل طويل ثقيل؛ شائع في أوروبا وشمال أفريقيا؛ من العصر الطباشيري المبكر)",
 "ii": "اِثْنَان (يَدُلُّ عَلَى العَدَد 2) / اثْنَان (العدد الأصلي الذي هو مجموع واحد وواحد أو رمز يمثل هذا العدد)",
 "iii": "ثَلَاثَة (يَدُلُّ عَلَى العَدَد 3) / ثَلَاثَة, ثُلَاثِيّ (العدد الأصلي الذي هو مجموع واحد وواحد وواحد)",
 "iis": "جهاز المخابرات العراقي (الذراع الأكثر شهرة وربما الأهم في النظام الأمني العراقي)\nمثال: تورطت المخابرات العراقية في العديد من الأنشطة الإرهابية",
 "ijtihad": "اجتهاد (سعي عالم مسلم لاستنباط حكم شرعي من القرآن والحديث دون الاعتماد على آراء علماء آخرين)\nمثال: يعتقد بعض العلماء المسلمين الإصلاحيين أن إعادة فتح باب الاجتهاد شرط أساسي لبقاء الإسلام",
 "ikebana": "إِيكِيبَانَا",
 "ikhshid": "إِخْشِيد",
 "ikhshidid": "إِخْشِيدِيّ",
 "ikon": "أيقونة (لوحة دينية تقليدية بالزيت على لوح خشبي صغير؛ مبجلة في الكنيسة الشرقية) / رسم, صورة (تمثيل مرئي (لشيء أو مشهد أو شخص أو فكرة مجردة) منتج على سطح)\nمثال: أرونا صور زفافهم",
 "il": "تِسْعَة وَأَرْبَعُونَ (يَدُلُّ عَلَى العَدَد 49)",
 "il duce": "الْدُوتْشِي",
 "ilam": "عِيلَام",
 "ilama": "إيلاما (فاكهة استوائية مبيضة مع مسحة وردية مرتبطة بالقشطة) / إيلاما (شجرة استوائية أمريكية تزرع في جنوب الولايات المتحدة لها فاكهة بيضاء مشوبة بالوردي)",
 "ilama tree": "إيلاما (شجرة استوائية أمريكية تزرع في جنوب الولايات المتحدة لها فاكهة بيضاء مشوبة بالوردي)",
 "ilang-ilang": "كانانغا, يلانج يلانج (شجرة آسيوية دائمة الخضرة بزهور خضراء صفراء عطرية تنتج زيتاً طياراً؛ تزرع على نطاق واسع في المناطق الاستوائية للزينة) / إيلنغ (زيت مقطر من زهور شجرة الإيلنغ؛ يُستخدم في صناعة العطور)",
 "ileal artery": "شريان لفائفي, شريان معوي (فرع من الشريان المساريقي العلوي يغذي اللفائفي)",
 "ileitis": "التهاب اللفائفي (التهاب اللفائفي)",
 "ileocecal valve": "صمام لفائفي أعوري (صمام بين اللفائفي للأمعاء الدقيقة والأعور للأمعاء الغليظة؛ يمنع المواد من التدفق عائداً من الأمعاء الغليظة إلى الدقيقة)",
 "ileocolic artery": "شريان لفائفي قولوني (شريان ينشأ من الشريان المساريقي العلوي ويغذي الجزء النهائي من اللفائفي والأعور والزائدة الدودية والقولون الصاعد)",
 "ileocolic vein": "وريد لفائفي قولوني (وريد يصرف نهاية اللفائفي والزائدة الدودية والأعور والجزء السفلي من القولون الصاعد)",
 "ileostomy": "فغر اللفائفي (إجراء جراحي يخلق فتحة من اللفائفي عبر جدار البطن لتعمل كشرج؛ يجرى في حالات سرطان القولون أو التهاب القولون التقرحي)",
 "ileum": "اللَفَائِفِيّ",
 "ileus": "انسداد معوي (انسداد الأمعاء (خاصة اللفائفي) الذي يمنع محتويات الأمعاء من المرور إلى الأمعاء السفلية)",
 "ilex cornuta": "بهشية صينية, هولي صيني (شجيرة دائمة الخضرة كثيفة مستديرة من الصين لها أوراق شائكة؛ تزرع على نطاق واسع للزينة)",
 "ilex decidua": "بهشية نفضية, توت الشتاء (شجيرة نفضية من جنوب شرق ووسط الولايات المتحدة)",
 "ilex glabra": "بهشية ملساء, توت الحبر (بهشية دائمة الخضرة من شرق أمريكا الشمالية بأوراق جلدية مستطيلة وتوت أسود صغير)",
 "ilex paraguariensis": "شاي باراغواي, مته (بهشية من أمريكا الجنوبية؛ تستخدم الأوراق في صنع مشروب يشبه الشاي)",
 "ilham": "إِلْهَام",
 "iliac": "حرقفي (من أو يتعلق بعظم الحرقفة)",
