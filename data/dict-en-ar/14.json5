 "intramuscular injection": "حقن عضلي (حقنة في العضلة)",
 "intramuscularly": "عضلياً, في العضل (بطريقة داخل العضل)\nمثال: إعطاء الدواء في العضل",
 "intranet": "إنترانت, شبكة داخلية (شبكة كمبيوتر مقيدة؛ شبكة خاصة تم إنشاؤها باستخدام برمجيات الشبكة العنكبوتية العالمية)",
 "intransigence": "تعنت (سمة التعنت؛ الرفض العنيد للتسوية)",
 "intransigency": "تعنت (سمة التعنت؛ الرفض العنيد للتسوية)",
 "intransigent": "عَنِيد, لَا يَلِين (لَا يَتَأَثَّرُ بِالتَّوَسُّلَاتِ أَوِ الإِقْنَاعِ أَوِ المُنَاشَدَاتِ أَوِ المَنْطِقِ)",
 "intransitive": "لَازِم",
 "intransitive verb": "فِعْل لَازِم (عَمِلَ وصَنَعَ، بعلم أو بدون علم، عن قصد أو دون قصد)\nمثال: ماذا فعل للحمي؟",
 "intransitive verb form": "فعل لازم (فعل (أو بناء فعلي) لا يأخذ مفعولاً به)",
 "intransitively": "بشكل لازم, لازماً (بطريقة لازمة (نحوياً))\nمثال: يمكنك استخدام الفعل (شرب) لازماً، دون مفعول به مباشر",
 "intransitiveness": "لُزُوم (العلاقة النحوية التي ينشئها الفعل اللازم)",
 "intransitivity": "لُزُوم (العلاقة النحوية التي ينشئها الفعل اللازم)",
 "intraocular lens": "عدسة داخل العين (عدسة اصطناعية تزرع في عين شخص ما لاستبدال عدسة طبيعية تالفة أو لشخص تمت إزالة إعتام عدسة العين لديه)",
 "intraocular pressure": "ضغط داخل العين (الضغط الذي تمارسه السوائل داخل مقلة العين؛ ينظم بواسطة مقاومة التدفق الخارجي للخلط المائي)\nمثال: يمكن أن ينتج الجلوكوما عن زيادة الضغط داخل العين",
 "intrapulmonary": "داخل الرئة (كائن أو حادث داخل الرئة)",
 "intrasentential": "داخل الجملة (من أو يتعلق بالمكونات داخل الجملة)\nمثال: التوارد داخل الجملة",
 "intrasexual": "داخل جنسي",
 "intraspecies": "داخل النوع, ضمن النوع (ينشأ أو يحدث داخل نوع واحد؛ يشمل أعضاء نوع واحد)\nمثال: منافسة داخل النوع",
 "intraspecific": "داخل النوع, ضمن النوع (ينشأ أو يحدث داخل نوع واحد؛ يشمل أعضاء نوع واحد)\nمثال: منافسة داخل النوع",
 "intrastate": "داخل الولاية (يتعلق بـ أو يوجد داخل حدود ولاية واحدة)\nمثال: التجارة داخل الولاية وكذلك بين الولايات",
 "intrauterine": "داخل الرحم (كائن أو حادث داخل الرحم)",
 "intrauterine device": "لولب رحمي (جهاز لمنع الحمل يتكون من قطعة من البلاستيك أو المعدن المثني يتم إدخالها عبر المهبل إلى الرحم)",
 "intravasation": "تسرب وعائي (دخول مادة غريبة إلى وعاء دموي)",
 "intravenous": "داخل الوريد, وريدي (داخل الوريد أو عن طريقه)\nمثال: التهاب وريدي",
 "intravenous anesthetic": "مخدر وريدي (مخدر ينتج التخدير عند حقنه في الدورة الدموية)",
 "intravenous drip": "تقطير وريدي (تقطير مستمر بطيء لإدخال المحاليل عن طريق الوريد (قطرة بقطرة))",
 "intravenous feeding": "تغذية وريدية (إعطاء المغذيات عبر الوريد)",
 "intravenous injection": "حقن وريدي (حقنة في الوريد)",
 "intravenous pyelogram": "تصوير الحويضة الوريدي (صورة أشعة سينية للكلى والحالبين بعد حقن صبغة ظليلة للأشعة)",
 "intravenous pyelography": "تصوير الحويض الوريدي (إجراء تصوير الحويض مع حقن وريدي لوسيط التباين)",
 "intravenously": "عبر الوريد, وريدياً (بطريقة وريدية)\nمثال: كان يجب تغذية المريض عبر الوريد",
 "intraventricular": "داخل البطين (داخل نظام البطينات في الدماغ)\nمثال: ضغط داخل البطين",
 "intrenchment": "تحصين, خندق (تحصين راسخ؛ موقع محمي بالخنادق)",
 "intrepid": "جريء, جريئة",
 "intrepidity": "إقدام, جسارة (شجاعة حازمة)",
 "intrepidly": "بشجاعة, بلا خوف\nمثال: قاد القوات إلى القتال بلا خوف",
 "intricacy": "تَعْقِيد دَقِيق, تَفْصِيل (يتميز بتفاصيل معقدة ومتقنة)",
 "intricate": "دَقِيق, مُتْقَن (ذُو عَنَاصِرَ كَثِيرَة مُرَتَّبَة بِشَكْل مُعَقَّد؛ مُفَصَّل)",
 "intricately": "بإسهاب, بتفصيل\nمثال: تم توضيحه بإسهاب",
 "intrigue": "دَسِيسَة",
 "intriguer": "متآمر, مُدَبِّر مكائد (شخص يبتكر مؤامرات أو مكائد)\nمثال: يعتقد أنه المدبر الرئيسي للهجوم الإرهابي",
 "intriguing": "مُثِير لِلْاِهْتِمَام, مُثِير لِلْفُضُول",
 "intrinsic": "جَوْهَرِيّ, ذَاتِيّ (يقع داخل العضو أو جزء الجسم الذي يؤثر فيه ويختص به) / أصيل, جوهري (ينتمي للشيء بحكم طبيعته ذاتها)\nمثال: عولج الشكل كشيء جوهري، كجوهر الشيء ذاته",
 "intrinsic factor": "عامل داخلي (مادة ينتجها الغشاء المخاطي للمعدة والأمعاء ضرورية لامتصاص فيتامين ب 12)\nمثال: نقص العامل الداخلي يمكن أن يؤدي إلى فقر الدم الخبيث",
 "intrinsic fraud": "غش جوهري (الاحتيال (عن طريق استخدام مستندات مزورة أو ادعاءات كاذبة أو شهادة زور) الذي يضلل المحكمة أو هيئة المحلفين ويؤدي إلى حكم لصالح مرتكب الاحتيال)",
 "intrinsical": "أصيل, جوهري (ينتمي للشيء بحكم طبيعته ذاتها)\nمثال: عولج الشكل كشيء جوهري، كجوهر الشيء ذاته",
 "intrinsically": "بحد ذاته, جوهرياً (فيما يتعلق بطبيعته المتأصلة)\nمثال: هذا البيان مثير للاهتمام بحد ذاته",
 "intro": "إنترو, مقدمة (مقطع تمهيدي موجز لقطعة من الموسيقى الشعبية) / تعريف, تقديم (تعريف شخص بآخر أو للجمهور بشكل رسمي)",
 "introduce": "قَدَّمَ (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى الرُّسْغَ؛ أنّ لهم سابقةً وفضلاً له عند فلان قَدَمٌ : معروف)\nمثال: قدم عمي لرؤيتي.",
 "introduction": "مُقَدَّمَة / تَعْرِيف (الإعلام؛ الشيء أو الكلمة: التوضيح بالمعنى بصورة مختصرة ليعرف الناس ما هي) / مُقَدَّمَة, مَدْخَل\nمثال: هل لديه بطاقة شخصية (هوية شخصية - بطاقة تعريف)",
 "introductoriness": "تمهيدية (صفة كون الشيء تمهيدياً؛ أو يعطي لمحة أو فكرة عن)\nمثال: بدلاً من ذلك، ضاعف هذا الجزء التكميلي الطابع التمهيدي الملحوظ لسابقه، حيث قدمه بدوره من خلال إخضاعه لاستجواب أولي",
 "introductory": "اسْتِهْلَالِيّ, تَمْهِيدِيّ (يُستعمَل مقدّمةً أو تمهيدًا لما يليه) / تَمْهِيدِيّ (يُسْتَخْدَمُ لِلِافْتِتَاحِ أَوِ التَّمْهِيدِ) / أَسَاسِيّ, تَمْهِيدِيّ (يَعْمَلُ كَأَسَاسٍ أَوْ نُقْطَةِ انْطِلَاقٍ)",
 "introit": "إنتويت, مقدمة دينية (تكوين من الموسيقى الصوتية مناسب لافتتاح الخدمات الكنسية)",
 "introitus": "مدخل (مدخل أو فتحة لعضو مجوف أو أنبوب (خاصة فتحة المهبل))\nمثال: مدخل المهبل",
 "introject": "استدماج ((التحليل النفسي) الشخصيات الأبوية (وقيمها) التي استدمجتها كطفل؛ عادة ما يكون صوت الضمير هو صوت الوالدين المستدمج)",
 "introjected": "مُسْتَبْطَن, مُسْتَدْخَل (أُدمِج لا شعوريًّا في النفس)",
 "introjection": "إدخال, إسقاط داخلي ((علم النفس) الاستدماج اللاواعي لجوانب من العالم (خاصة جوانب الأشخاص) داخل الذات بطريقة تجعل التمثيل الداخلي يتولى الوظائف النفسية للأشياء الخارجية) / إسقاط داخلي ((التحليل النفسي) استدماج صور الوالدين وقيمهما؛ يؤدي إلى تكوين الأنا العليا)",
 "intromission": "إدخال, إيلاج (عملية وضع شيء داخل شيء آخر)",
 "intron": "إنترون (تسلسل من الحمض النووي لجين حقيقي النواة لا يترجم إلى بروتين)",
 "intropin": "دوبامين (ناقل عصبي أحادي الأمين يوجد في الدماغ وضروري للعمل الطبيعي للجهاز العصبي المركزي؛ كدواء يُستخدم لعلاج الصدمة وانخفاض ضغط الدم)",
 "introspection": "استبطان, تأمل ذاتي (تأمل أفكارك ورغباتك وسلوكك)",
 "introspectionism": "استبطان (مذهب يرى أن علم النفس يجب أن يستند أساساً إلى البيانات المستمدة من الاستبطان)",
 "introspective": "استبطاني, تأملي (يميل لفحص تجاربه الحسية والإدراكية الخاصة)",
 "introspectiveness": "استبطان, تأمل ذاتي (التفكير في وضعك ومشاعرك الخاصة)",
 "introuvable": "مُتَعَذَّر العُثُور عَلَيْه (مستحيل إيجاده أو العثور عليه)",
 "introversion": "اِنْطِوَاء",
 "introversive": "انطوائي, انكفائي (موجه للداخل؛ يتميز بالاهتمام بالذات أو المشاعر الداخلية)",
 "introvert": "اِنْطِوَائِيّ",
 "introverted": "اِنْطِوَائِيّ",
 "introvertish": "مَيَّالٌ لِلِانْطِوَاء (يميل إلى الانطواء بعض الشيء)",
 "introvertive": "انطوائي, انكفائي (موجه للداخل؛ يتميز بالاهتمام بالذات أو المشاعر الداخلية)",
 "intrude": "تَطَفَّلَ, تَدَخَّلَ",
 "intruder": "مُقْتَحِم, دَخِيل",
 "intruding": "مُتَوَغِّلٌ لِلدَّاخِل (يبرز متجهًا نحو الداخل)",
 "intrusion": "تَطَفُّل, مُدَاخَلَة",
 "intrusive": "اقتحامي, تطفلي (يميل للتطفل (خاصة على الخصوصية)) / متوغل, مندس (يندفع للداخل) / تدخلي, جوفي (من المواد الصخرية؛ تندفع وهي منصهرة في الشقوق بين طبقات صخور أخرى)\nمثال: شعرت أن وجودها هناك كان تطفلياً",
 "intrusiveness": "تطفل, فضول (عدوانية تتضح من خلال التطفل؛ من خلال تقديم نفسك أو أفكارك دون دعوة)",
 "intubation": "تنبيب, قسطرة (إدخال قنية أو أنبوب في عضو مجوف في الجسم)",
 "intuition": "حَدْس (الحَدْس: الوَطْءُ، وَقد حَدَسَ برِجلِه الشيءَ، إِذا وَطِئَه؛ الحَدْس: الغَلَبَةُ فِي الصِّراعِ، يُقَال: حَدَسَ بالرجُلِ يَحْدِسُه حَدْسَاً : صَرَعَه وضَرَبَ بِهِ الأرضَ)",
 "intuitionism": "حدسية ((فلسفة) المذهب القائل بأن المعرفة تُكتسب في المقام الأول عن طريق الحدس)",
 "intuitionist": "حدسي (مكون من أو متعلق بالمذهب الحدسي)",
 "intuitive": "بَدِيهِيٌّ",
 "intuitive feeling": "إحساس, شعور (فهم حدسي لشيء ما)\nمثال: كان لديه إحساس رائع بالموسيقى",
 "intuitively": "بالبديهة, حدسياً (بطريقة حدسية)\nمثال: يبدو أن المخترعين اختاروا حدسياً مزيجاً من الأصوات المتفجرة والعدوانية كإشارات تحذير لاستخدامها في السيارات",
 "intumescence": "انتفاخ (الزيادة في حجم بعض المواد عند تسخينها (غالباً ما تكون مصحوبة بإطلاق الماء)) / انتفاخ, توزم (انتفاخ بالدم أو السوائل الأخرى (كما هو الحال مع الاحتقان))",
 "intumescency": "انتفاخ (الزيادة في حجم بعض المواد عند تسخينها (غالباً ما تكون مصحوبة بإطلاق الماء)) / انتفاخ, توزم (انتفاخ بالدم أو السوائل الأخرى (كما هو الحال مع الاحتقان))",
 "intumescent": "مُتَوَرِّم, مُنْتَفِخ (مُتَمَدِّد بِشَكْل غَيْر طَبيعِيّ بِسَبَب السَّوائِل أو الغاز)",
 "intussusception": "اندخال, نمو خلالي ((علم الأحياء) نمو في مساحة سطح الخلية عن طريق ترسيب جزيئات جديدة بين الجزيئات الموجودة في جدار الخلية) / انخساف, انغماد (انطواء طبقة خارجية لتكوين جيب في السطح)\nمثال: انغماد الأريمة",
 "inuit": "إسكيمو, إنويت (فرد من شعب يسكن القطب الشمالي (شمال كندا أو جرينلاند أو ألاسكا أو شرق سيبيريا))",
 "inuktitut": "إِنُكْتِيتُوتِيَّة",
 "inula": "إينولا, راسن (أي نبات من جنس إينولا)",
 "inula helenium": "راسن, زنجبيل شامي (عشبة أوراسية خشنة طويلة ذات أزهار صفراء تشبه الأقحوان بتلات ضيقة تستخدم جذورها الجذمورية طبياً)",
 "inulin": "إينولين (يُستخدم لتصنيع الفركتوز وفي تقييم وظائف الكلى)",
 "inunction": "مسحة مقدسة (المسح بالزيت كجزء من احتفال ديني أو طقس شفاء)",
 "inundated": "غَارِق, مَغْمُور (مُغَطًّى بِالمَاء)",
 "inundation": "فيضان",
 "inured": "مُتَصَلِّب, مُعْتَاد (أصبح قاسيًا بفعل التعرض المتكرر والمعتاد)",
 "inutile": "لَا يَسْتَحِقُّ الاِسْتِخْدَام (لَا يَسْتَحِقُّ أَنْ يُسْتَخْدَم)",
 "inutility": "عَدَم جَدْوَى, لَا نَفْع (صفة عدم وجود فائدة عملية)",
 "invade": "غَزَا, اِجْتاحَ",
 "invader": "غَازٍ, الْغَازِي",
 "invading": "اجْتِيَاحِيّ, غَزْوِيّ (ينطوي على غزو أو هجوم عدوانيّ)",
 "invagination": "انخساف, انغماد (انطواء طبقة خارجية لتكوين جيب في السطح) / انغماد, انقلاب للداخل (حالة الطي للداخل أو التغليف)\nمثال: انغماد الأريمة",
 "invalid": "بَاطِل, غَيْر صَالِح (لم يعد ساري المفعول) / باطل, غير سارٍ (ليس له قوة إقناع أو قوة قانونية) / عاجِز, مُقْعَد (شخص أقعده مرض مزمن أو إصابة)\nمثال: استدلال باطل",
 "invalidated": "مُبْطَل, مُلْغًى (جُرِّدَ مِنَ القُوَّةِ القَانُونِيَّة)",
 "invalidating": "مُبْطِل, نَاقِض (يُثبت بطلان الشيء أو عدم صحته)",
 "invalidation": "إبطال, فسخ ((في القانون) إنهاء رسمي (لعلاقة أو إجراء قضائي ونحوه)) / إبطال, تسفيه المشاعر (عندما يتم رفض أفكار ومشاعر شخص ما أو تجاهلها أو الحكم عليها)\nمثال: الإبطال مزعج عاطفياً لأي شخص",
 "invalidator": "لاغٍ, مبطل (مسؤول يمكنه إبطال أو إلغاء شيء ما)",
 "invalidism": "إقعاد, عجز (اعتلال صحي مزمن)",
 "invalidity": "بُطْلَان, فَسَاد (اللامنطقية كنتيجة لامتلاك استنتاج لا يتبع المقدمات)",
 "invalidness": "بُطْلَان, فَسَاد (اللامنطقية كنتيجة لامتلاك استنتاج لا يتبع المقدمات)",
 "invaluable": "لَا يُقَدَّرُ بِثَمَن, نَفِيس (ذُو قِيمَةٍ مَادِّيَّةٍ أَوْ فِكْرِيَّةٍ أَوْ رُوحِيَّةٍ لَا تُحْصَى)",
 "invaluableness": "قيمة لا تقدر بثمن, نفاسة (الجودة الإيجابية لكون الشيء ثميناً ويفوق القيمة)",
 "invar": "إنفار (سبيكة من الحديد والنيكل ذات معامل تمدد حراري منخفض؛ تستخدم في الشوكات الرنانة وأشرطة القياس وأدوات أخرى)",
 "invariability": "ثَبَات, عَدَم تَغَيُّر (صفة مقاومة التباين) / اسْتِوَاء, انْتِظَام (صفة التماثل وانعدام التباين)",
 "invariable": "ثابت, غير متغير (غير عرضة لـ أو غير قابل للتغيير) / ثابت, كمية ثابتة (كمية لا تتغير)\nمثال: درجة حرارة ثابتة",
 "invariableness": "ثَبَات, عَدَم تَغَيُّر (صفة مقاومة التباين)",
 "invariably": "باستمرار, دائماً (بدون تنوع أو تغيير، في كل حالة)\nمثال: لطيف وكريم دائماً",
 "invariance": "ثَبَات, لَا تَبَايُن (طبيعة كمية أو خاصية أو دالة تظل دون تغيير عند تطبيق تحويل معين عليها) / ثَبَات, عَدَم تَغَيُّر (صفة مقاومة التباين)",
 "invariant": "ثَابِت, لَا يَتَغَيَّر (لَا يَتَبَدَّلُ فِي طَبِيعَتِه) / ثَابِتٌ تَحْتَ التَّحْوِيل, مُطَّرِد (غَيْرُ مُتَأَثِّرٍ بِعَمَلِيَّةٍ أَوْ تَحْوِيلٍ مُحَدَّد) / ثابت, لامتغير (سمة (كمية أو خاصية أو دالة) تظل دون تغيير عند تطبيق تحويل معين عليها)",
 "invasion": "غَزْو, إِغَارَة (أَغَارَ عَلَى العَدُوِّ غَزْواً : سَارَ إِلَى مُحَارَبَتِهِ وَقِتَالِهِ فِي عُقْرِ دِيَارِهِ؛ سيطرة على دولة أو منطقة بواسطة قوّات مُسلَّحة أجنبيّة)\nمثال: الصين مستعدة لغزو تايوان.",
 "invasion of privacy": "انتهاك الخصوصية (التدخل غير المشروع من قبل الأفراد أو الحكومة في الشؤون الخاصة التي لا شأن للجمهور بها)",
 "invasive": "غَازٍ",
 "invasive species": "نَوْعٌ مُجْتَاحٍ (صِنْف؛ في : وحدة تصنيفية أقل من الجنس)\nمثال: انه نوع من الفطر.",
 "invasiveness": "بضع, تدخل جراحي (خاصية تتضمن الدخول إلى الجسم الحي (عن طريق الشق أو إدخال أداة)) / اجتياحية, غزوانية (صفة الميل للانتشار؛ خاصة الميل لغزو الأنسجة السليمة)\nمثال: نتائجنا تدعم التطور داخل المضيف كأحد التفسيرات وليس التفسير الوحيد لغزوانية هذه البكتيريا",
 "invective": "تَقْرِيع, سِبَاب (لغة مسيئة أو سامة تستخدم للتعبير عن اللوم أو الاستهجان أو الضغينة العميقة)",
 "invent": "اِخْتَرَعَ",
 "invention": "اِخْتِرَاع",
 "inventive": "بَارِعٌ فِي الاخْتِرَاعِ, مُبْتَكِر ((يوصف به الأشخاص أو الأعمال) يتميز بالاستقلالية والإبداع في الفكر أو الفعل)",
 "inventively": "بإبداع, بابتكار (بطريقة مبتكرة)\nمثال: أشكال بيكاسو المحررة وألوانه المطبقة بشكل مثير والمجمعة بابتكار",
 "inventiveness": "إبداع, عبقرية (قوة الخيال الإبداعي)",
 "inventor": "مُخْتَرِع, مُبْتَكِر",
 "inventory": "جَرْد (جَرَدَ الشيءَ: أحصى ما فيه، ضبط قيمته؛ جَرَدَ البطاطسَ: قشّرها وأزال ما عليها)\nمثال: كان سامي جرد طفل.",
 "inventory accounting": "محاسبة المخزون (المحاسبة التي تراقب وتقيم المخزون)",
 "inventory control": "مراقبة المخزون (الإشراف على توريد وتخزين وإتاحة العناصر لضمان إمدادات كافية دون تكدس مفرط)",
 "inventory item": "بند المخزون (بند مدرج في قائمة الجرد)",
 "inventory-clearance sale": "بيع تصفية, تصفية (بيع لتقليل المخزون)",
 "inventorying": "إحصاء المخزون, جرد (عمل قائمة مفصلة بالبضائع أو الإمدادات المتاحة)\nمثال: قد يكون الجرد ضرورياً لمعرفة ما إذا كان هناك شيء مفقود",
 "inverse": "عَكْسِيّ, مُعَاكِس (معكوس في الترتيب أو الطبيعة أو الأثر) / عكسي (معاكس في الطبيعة أو التأثير أو العلاقة بكمية أخرى) / مَعْكُوس (شيء معكوس في التسلسل أو الطابع أو التأثير)\nمثال: يكون الحد في تناسب عكسي مع حد آخر إذا زاد (أو نقص) بنقصان (أو زيادة) الآخر",
 "inverse cosecant": "قَوْس قَاطِع التَّمَام, مَعْكُوس قَاطِع التَّمَام (الزاوية التي لها قاطع تمام يساوي عدداً معيناً)",
 "inverse cosine": "قَوْس جَيْب التَّمَام, مَعْكُوس جَيْب التَّمَام (الدالة العكسية لجيب التمام؛ الزاوية التي لها جيب تمام يساوي عدداً معيناً)",
 "inverse cotangent": "قَوْس ظِلّ التَّمَام, مَعْكُوس ظِلّ التَّمَام (الدالة العكسية لظل التمام؛ الزاوية التي لها ظل تمام يساوي عدداً معيناً)",
 "inverse function": "دَالَّة عَكْسِيَّة, مَعْكُوس الدَّالَّة (دالة يتم الحصول عليها من خلال التعبير عن المتغير التابع لدالة واحدة كمتغير مستقل لدالة أخرى)",
 "inverse secant": "قَوْس القَاطِع, مَعْكُوس القَاطِع (الدالة العكسية للقاطع؛ الزاوية التي لها قاطع يساوي عدداً معيناً)",
 "inverse sine": "قَوْس الجَيْب, مَعْكُوس الجَيْب (الدالة العكسية للجيب؛ الزاوية التي لها جيب يساوي عدداً معيناً)",
 "inverse tangent": "قَوْس الظِّلّ, مَعْكُوس الظِّلّ (الدالة العكسية للظل؛ الزاوية التي لها ظل يساوي عدداً معيناً)",
 "inversely": "بالمقابل, عكسياً (بطريقة عكسية أو متبادلة)\nمثال: مرتبط عكسياً",
 "inversion": "عكس, قلب (عملية القلب من الداخل إلى الخارج) / قلب, نكْس (القلب رأساً على عقب؛ الوضع على النهاية) / انقلاب جنسي (مصطلح كان يستخدم سابقاً ليعني تقمص دور الجنس الآخر) / عكس, قلب ((طباق) تنويع للحن أو جزء منه تُستبدل فيه المسافات الصاعدة بمسافات هابطة والعكس صحيح)",
 "invert soap": "صابون مقلوب, منظف كاتيوني (فئة من المنظفات الاصطناعية التي يكون فيها الجزء النشط سطحياً من الجزيء هو الكاتيون (الأيون الموجب))",
 "invert sugar": "سكر محول, سكر منقلب (خليط من أجزاء متساوية من الجلوكوز والفركتوز ناتج عن التحلل المائي للسكروز؛ يوجد طبيعياً في الفواكه؛ وهو أكثر حلاوة من الجلوكوز)",
 "invertase": "إنفرتاز (إنزيم يحفز التحلل المائي للسكروز إلى جلوكوز وفركتوز)",
 "invertebrate": "لَا فَقَارِيّ (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: لا أحب المدرسة.",
 "invertebrate foot": "قدم (أي من أعضاء الحركة أو الالتصاق المختلفة في اللافقاريات)",
 "inverted": "معكوس البويضة, منقلب البويضة ((عن بويضة النبات) مقلوبة تماماً؛ منعطفة للخلف بزاوية 180 درجة على سويقتها) / رَأْسًا عَلَى عَقِب, مَقْلُوب (في وضع انعكس فيه الأعلى والأسفل)",
 "inverted comma": "علامة اقتباس (علامة ترقيم تستخدم لنسب النص المحصور بداخلها إلى شخص آخر)",
 "inverted hang": "تعلق مقلوب (تعلق يُؤدى على الحلقات والجسم مقلوب رأساً على عقب)",
 "inverted pleat": "كسرة معكوسة (كسرة مربعة معكوسة بحيث يكون الامتلاء متجهاً للداخل)",
 "inverter": "انفرتر, عاكس كهربائي (محول كهربائي يحول التيار المستمر إلى تيار متردد)",
 "invertible": "عَكُوْسَة",
 "invest": "اِسْتَثْمَرَ",
 "investigating": "استقصاء, تحقيق (عمل البحث في شيء ما بدقة وبشكل منهجي)",
 "investigation": "تَحْقِيق",
 "investigative": "اِسْتِقْصَائِيّ, تَحْقِيقِيّ (مُصمَّم للعثور على المعلومات أو التحقّق من الحقائق)",
 "investigator": "مُحَقِّق, مُحَقِّقَة (من يُجري تحقيق وتحرِّيات للكشف عن ملابسات قضيَّة غامضة؛ قَاضِي التَّحْقِيقِ الَّذِي يُحَقِّقُ مَعَ الْمُتَّهَمِ فِي قَضِيَّةٍ لِلْكَشْفِ عَنْ مَجْرَيَاتِهَا)\nمثال: تحدث ياني مع محقق.",
 "investigatory": "اِسْتِقْصَائِيّ, تَحْقِيقِيّ (مُصمَّم للعثور على المعلومات أو التحقّق من الحقائق)",
 "investing": "استثمار (عملية الاستثمار؛ وضع المال أو رأس المال في مؤسسة مع توقع الربح)",
 "investiture": "تنصيب, تولية (العمل الرسمي المتمثل في إلباس شخص ما شارة منصب؛ الترقية الرسمية لشخص إلى منصب أو رتبة) / تتويج, تنصيب (مراسم تنصيب ملك جديد)",
 "investment": "اِسْتِثْمَار",
 "investment adviser": "مستشار استثمار (شخص ينصح الآخرين بكيفية استثمار أموالهم)",
 "investment advisor": "مستشار استثمار (شخص ينصح الآخرين بكيفية استثمار أموالهم)",
 "investment banker": "متعهد اكتتاب, مصرفي استثماري (مصرفي يتعامل بشكل رئيسي في ضمان تغطية الأوراق المالية الجديدة)",
 "investment company": "شركة استثمار, صندوق استثمار (مؤسسة مالية تبيع الأسهم للأفراد وتستثمر في الأوراق المالية الصادرة عن شركات أخرى)",
 "investment firm": "شركة استثمار, صندوق استثمار (مؤسسة مالية تبيع الأسهم للأفراد وتستثمر في الأوراق المالية الصادرة عن شركات أخرى)",
 "investment funds": "أموال استثمار, استثمار (المال الذي يتم استثماره مع توقع الربح)",
 "investment letter": "خطاب استثمار (خطاب نوايا يفيد بأن ورقة مالية يتم شراؤها للاستثمار وليس لإعادة البيع؛ يتجنب الحاجة لتسجيل لجنة الأوراق المالية والبورصات)",
 "investment trust": "شركة استثمار, صندوق استثمار (مؤسسة مالية تبيع الأسهم للأفراد وتستثمر في الأوراق المالية الصادرة عن شركات أخرى)",
 "investor": "مُسْتَثْمِر, مُسْتَثْمِرَة",
 "investors club": "نادي المستثمرين (نادي لصغار المستثمرين الذين يشترون ويبيعون الأوراق المالية بشكل مشترك)",
 "inveterate": "مُتَأَصِّل, مُتَوَاصِل",
 "invidia": "حسد (حقد واستياء عند رؤية نجاح الآخرين (تُشخص كإحدى الخطايا السبع المميتة))",
 "invidious": "تَمْيِيزِيّ, مُتَحَيِّز (يَنْطَوِي عَلَى انْتِقَاص أَوْ يُظْهِر تَحَيُّزًا)",
 "invidiously": "بشكل مثير للاستياء, بشكل مجحف (بطريقة تثير الاستياء)",
 "invigilation": "مراقبة الامتحانات (مراقبة المرشحين في الامتحان لمنع الغش)",
 "invigilator": "مراقب",
 "invigorated": "مُتَجَدِّد النَّشَاط, مُنْتَعِش (ذو طاقة متجددة ونشاط مستعاد)",
 "invigorating": "منشط, منعش (يمنح القوة والحيوية)\nمثال: هواء الجبل المنعش",
 "invigoration": "إحياء, إنعاش (نشاط إعطاء الحيوية والنشاط لشيء ما) / انتشاء, حيوية (صفة كون المرء نشطاً أو مفعماً بالحيوية أو حياً وقوياً)",
 "invigorator": "باعث للحيوية, مُحْيِي (عامل يعطي أو يعيد الحياة أو النشاط)\nمثال: الروح هي باعثة الحياة في الجسد",
 "invincibility": "قهر, منعة (خاصية كونه صعباً أو مستحيلاً هزيمته)",
 "invincible": "مَنِيع",
 "invincibly": "بشكل لا يقهر, بمنعة (بطريقة لا تقهر)\nمثال: بشكل لا يقهر، تقدمت القوات إلى الأمام",
 "inviolable": "لَا يُنْتَهَك, مَصُون (لا يمكن انتهاكه أو التعدي عليه) / حُرْمِيّ, مَصُون (يجب أن يُصان ولا يُنتَهَك؛ ذو حرمة لا تُمَسّ) / لا يُنتهك, مصون (لا يمكن تجاوزه أو تدنيسه) / لَا يُقْهَر, مَنِيع (مُحَصَّنٌ ضِدَّ الهُجُوم؛ لَا يُمْكِنُ العَبَثُ بِه)\nمثال: شخص الملك مصون",
 "inviolate": "سَلِيمَة, عَذْرَاء ((عن المرأة) لا يزال غشاء بكارتها سليمًا) / حُرْمِيّ, مَصُون (يجب أن يُصان ولا يُنتَهَك؛ ذو حرمة لا تُمَسّ)",
 "invirase": "إنفيراز, ساكوينافير (مثبط ضعيف للبروتياز (الاسم التجاري إنفيراز) يستخدم في علاج فيروس نقص المناعة البشرية)",
 "invisibility": "خفاء, عدم المرئية (صفة عدم إمكانية الإدراك بالعين)",
 "invisible": "غَيْر مَرْئِيّ, خَفِيّ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "invisible balance": "مِيزَان غَيْر مَنْظُور (الفرق في القيمة خلال فترة زمنية بين واردات وصادرات بلد ما من الخدمات ومدفوعات الدخل العقاري)",
 "invisibleness": "خفاء, عدم المرئية (صفة عدم إمكانية الإدراك بالعين)",
 "invisibly": "بشكل غير مرئي, خفيةً (دون أن يُرى)\nمثال: تدخل هذه الكائنات الجسم خفية",
 "invitation": "دَعْوَة, عزيمة / إِغْرَاء",
 "invitational": "دعوي, متعلق بالدعوة (متعلق بـ أو مميز للدعوة)",
 "invitatory": "اسْتِدْعَائِيّ, دَعَوِيّ (ينقل دعوة أو يتضمنها)",
 "invite": "دَعَا, عَزَمَ (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه)\nمثال: دعا ثلاميذه الاثني عشر",
 "invitee": "ضيف, مدعو (زائر تقدم له الضيافة)",
 "inviting": "جذاب, دعائي (جذاب ومغرٍ)\nمثال: عرض مغرٍ",
 "invitingly": "بإغراء, بشكل مثير (بطريقة مغرية أو مثيرة)\nمثال: ابتسمت له بإغراء",
 "invocation": "استحضار, مناشدة (فعل طلب المساعدة أو الاستعانة) / استحضار, تحضير الأرواح (عملية استدعاء روح أو شيطان) / استدعاء (تعويذة تستخدم في استحضار أو استدعاء شيطان) / ابتهال, دعاء (صلاة لطلب عون الله كجزء من خدمة دينية)",
 "invoice": "فَاتُورَة",
 "invoke": "دَعَا (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه)\nمثال: دعا ثلاميذه الاثني عشر",
 "involucrate": "قلافي, مغلف (لديه قلافة (مجموعة قنابات تحيط بالزهرة))",
 "involucre": "غِلافُ الزَّهْرَة, قُلَافَة (قنابة بارزة للغاية أو زوج قنابات أو حلقة من القنابات عند قاعدة النورة الزهرية)",
 "involuntarily": "رَغْمًا عَنْه, قَسْرًا (ضد إرادة المرء أو دون تفكير واعي)\nمثال: احتجز قسراً رغماً عنه",
 "involuntariness": "عدم الرغبة, عزوف (سمة كون المرء غير راغب)\nمثال: رفض عدم رغبته في التعاون كل اقتراح قدمته",
 "involuntary": "قسري, لا إرادي (غير خاضع لسيطرة الإرادة) / لا إرادي (يتم التحكم فيه بواسطة الجهاز العصبي اللاإرادي؛ دون تحكم واعي)\nمثال: قتل غير عمد (لا إرادي)",
 "involuntary muscle": "عضلة لا إرادية, عضلة ملساء (عضلة تنقبض دون تحكم واعي وتوجد في جدران الأعضاء الداخلية مثل المعدة والأمعاء والمثانة والأوعية الدموية (باستثناء القلب))",
 "involuntary trust": "ائتمان إنشائي, ائتمان حكمي (ائتمان تنشئه المحكمة (بغض النظر عن نية الأطراف) لصالح طرف حُرم من حقوقه ظلماً)",
 "involute": "مُلْتَفّ بِإِحْكَام ((لبعض الأصداف) ملتفّ بإحكام بحيث يختفي المحور) / مَطْوِيّ لِلدَّاخِل, مُنْدَلِق (خاصة لبتلات الأزهار أو الأوراق في البرعم؛ حوافه ملفوفة إلى الداخل)",
 "involution": "التفاف, انطواء (عملية لف شيء ما) / أسس, رفع لقوة (عملية رفع كمية إلى قوة معينة) / اِنْخِرَاط, مُشَارَكَة (فعل المشاركة في أنشطة المجموعة) / تَعْقِيد دَقِيق, تَفْصِيل (يتميز بتفاصيل معقدة ومتقنة)\nمثال: حاول المعلم زيادة مشاركة طلابه في الأنشطة الصفية",
 "involutional depression": "اكتئاب سن اليأس (نوبة اكتئاب كبرى مرتبطة بسن اليأس)",
 "involved": "مُتَوَرِّط",
 "involvement": "اِنْخِرَاط, مُشَارَكَة (فعل المشاركة في أنشطة المجموعة) / انشغال, اهتمام (شعور بالاهتمام والفضول تجاه شخص أو شيء ما) / انْخِرَاط, تَوَرُّط (علاقة اشتمال أو احتواء) / انخراط, مشاركة (حالة المشاركة مع الآخرين (كزملاء أو شركاء وما إلى ذلك))\nمثال: حاول المعلم زيادة مشاركة طلابه في الأنشطة الصفية",
 "invulnerability": "حصانة, منعة (خاصية كون الشخص محصناً؛ خاصية عدم القدرة على التعرض للأذى (جسدياً أو عاطفياً)) / حصانة, منعة (امتلاك القوة لمقاومة الهجوم)",
 "invulnerable": "حصين, منيع (محصن ضد الهجوم؛ غير قابل للاختراق)\nمثال: أطلق المدفعيون النار على الشاطئ من مواقع حصينة على المنحدرات",
 "inward": "إِلَى الدَّاخِل (نحو المركز أو الداخل) / إلى الداخل, داخلاً (إلى أو نحو داخل شيء) / باطني, داخلي (يتعلق بـ أو موجود في العقل أو الأفكار) / دَاخِل, مُتَّجِه إِلَى الدَّاخِل (مُوجّه أو مُتحرّك نحو الداخل أو نحو المركز)\nمثال: حرك الإبرة أكثر للداخل!",
 "inward-developing": "جَاذِب المَرْكَز نُمُوًّا (ينمو نحو المحور، كما في عبّاد الشمس؛ أقدم الأزهار عند الحافّة)",
 "inward-moving": "مُتَحَرِّك نَحْوَ الدَّاخِل (يتحرّك أو يتّجه نحو المركز أو المحور، خاصّة عند الدوران)",
 "inwardly": "دَاخِلِيًّا, فِي السِّرّ (فيما يتعلق بالمشاعر الخاصة)\nمثال: داخلياً، كانت تغلي غضباً",
 "inwardness": "باطنية, تعمق داخلي (الانشغال بما يهم الطبيعة الداخلية للإنسان (خاصة القيم الأخلاقية أو الأيديولوجية)) / بَاطِنِيَّة, جَوَّانِيَّة (صفة أو حالة الوجود في الداخل أو الباطن) / باطنية, جوانية (الانشغال خاصة بمواقف المرء وقيمه الأخلاقية أو الأيديولوجية) / جوهر, خلاصة (الجزء المختار أو الأكثر أهمية أو حيوية في فكرة أو تجربة ما)\nمثال: باطنية سقراط ونزاهته وفضوله",
 "inwards": "إِلَى الدَّاخِل (نحو المركز أو الداخل) / إلى الداخل, داخلاً (إلى أو نحو داخل شيء)\nمثال: حرك الإبرة أكثر للداخل!",
 "inwrought": "ذُو نَقْش مُنْدَمِج, مَنْسُوج بِنَقْش (ذو نقش زخرفي منسوج أو محاك في القماش)",
 "io": "آيُّو",
 "io device": "جهاز إدخال/إخراج (جهاز لديه القدرة على قبول البيانات المخرجة أو المدخلة أو المعالجة)",
 "io moth": "عثة آيو (عثة أمريكية صفراء كبيرة لها بقعة كبيرة تشبه العين على كل جناح خلفي؛ اليرقات لها أشواك لاسعة)",
 "ioannina": "يَانِينَة / يُوَانِينَا",
 "ioc": "اللجنة الأولمبية الدولية (المنظمة المسؤولة عن تنظيم الألعاب الأولمبية الحديثة)",
 "iodic acid": "حمض اليوديك (حمض بلوري قابل للذوبان؛ يستخدم ككاشف ومطهر)",
 "iodide": "يوديد (ملح أو إستر لحمض الهيدرويوديك)",
 "iodin": "يود (عنصر لافلزي ينتمي إلى الهالوجينات؛ يستخدم خاصة في الطب والتصوير الفوتوغرافي وفي الأصباغ)",
 "iodinated": "معالج باليود, ميود (معالج باليود)\nمثال: ملح ميود",
 "iodinated protein": "بروتين يودي (بروتين يحتوي على اليود)",
 "iodinating": "مؤيدن, معالج باليود (يتحد أو يسبب الاتحاد مع اليود)\nمثال: الأنواع المؤيدنة النشطة",
 "iodination": "يودة (استبدال أو إضافة ذرات اليود في المركبات العضوية)",
 "iodine": "يُود",
 "iodine-125": "يود-125 (نظير مشع خفيف لليود له عمر نصف 60 يوماً؛ يستخدم كمتتبع في دراسات الغدة الدرقية وكعلاج لفرط نشاط الغدة الدرقية)",
 "iodine-131": "يود-131 (نظير مشع ثقيل لليود له عمر نصف 8 أيام؛ يستخدم في ملح الصوديوم لتشخيص أمراض الغدة الدرقية ولعلاج تضخم الغدة الدرقية)",
 "iodised": "معالج باليود, ميود (معالج باليود)\nمثال: ملح ميود",
 "iodize": "يَوَّدَ",
 "iodized": "معالج باليود, ميود (معالج باليود)\nمثال: ملح ميود",
 "iodoamino acid": "حمض أميني يودي (حمض أميني مضاف إليه اليود)",
 "iodochlorhydroxyquin": "كليوكينول, يودوكلورهيدروكسيكين (دواء يستخدم لعلاج بعض الالتهابات الفطرية (مثل قدم الرياضي))",
 "iodocompound": "مركب يودي (مركب يحتوي على شق اليود التساهمي)",
 "iodoform": "ثلاثي يود ميثان, يودوفورم (مادة صلبة بلورية صفراء ذات رائحة نفاذة؛ تستخدم أحياناً كضمادة مطهرة) / يودوفورم",
 "iodoprotein": "بروتين يودي (بروتين يحتوي على اليود)",
 "iodopsin": "يودوبسين (خضاب ضوئي بنفسجي في المخاريط الشبكية لعيون معظم الفقاريات؛ يلعب دوراً في الرؤية النهارية)",
 "iodothyronine": "يودوثيرونين (ثيرونين مضاف إليه اليود)",
 "iodotyrosine": "يودوتيروسين (تيروسين مضاف إليه اليود)",
 "iol": "زرعة عدسة (عدسة بلاستيكية شفافة تُزرع في العين؛ تتم عادة عند إزالة العدسة الطبيعية في عملية إعتام عدسة العين)",
 "ion": "شَارِد, أَيُون",
 "ion beam": "حزمة أيونية (حزمة من الأيونات تتحرك في نفس الاتجاه وبنفس السرعة)",
 "ion engine": "محرك أيوني (نوع من محركات الدفع التفاعلي لدفع الصواريخ في الفضاء؛ يتم تسريع تيار من الأيونات الموجبة إلى سرعة عالية بواسطة مجال كهربائي)",
 "ion exchange": "تبادل أيوني (عملية يتم فيها تبادل الأيونات بين محلول ومادة صلبة غير قابلة للذوبان (عادة ما تكون راتنجية)؛ تستخدم على نطاق واسع في المعالجة الصناعية)",
 "ion pump": "مضخة أيونية (مضخة تفريغ تزيل الغاز عن طريق تأيين الذرات أو الجزيئات وامتصاصها على سطح معدني)",
 "ion-exchange polymer": "بوليمر التبادل الأيوني, راتنج التبادل الأيوني (مصفوفة غير قابلة للذوبان عادة ما تكون على شكل خرزات صغيرة (قطرها 0.5-1 مم) مصنوعة من ركيزة بوليمر عضوية)\nمثال: سلفونات بوليسترين الصوديوم هو راتنج تبادل أيوني حمضي قوي ويستخدم لعلاج فرط بوتاسيوم الدم",
 "ion-exchange resin": "بوليمر التبادل الأيوني, راتنج التبادل الأيوني (مصفوفة غير قابلة للذوبان عادة ما تكون على شكل خرزات صغيرة (قطرها 0.5-1 مم) مصنوعة من ركيزة بوليمر عضوية)\nمثال: سلفونات بوليسترين الصوديوم هو راتنج تبادل أيوني حمضي قوي ويستخدم لعلاج فرط بوتاسيوم الدم",
 "ionia": "إِيُونِيَة",
 "ionian": "إيوني (مكون من أو متعلق بالإيونيين القدماء الذين عاشوا في أتيكا والأراضي ذات الصلة، أو لهجتهم الإيونية اليونانية، أو ثقافتهم) / الأيونيون (السكان اليونانيون القدماء في أتيكا والمناطق ذات الصلة في أيونيا) / أيوني (عضو في أحد الأقسام اللغوية الأربعة لليونانيين في عصور ما قبل التاريخ، الذين تحدثوا في الساحل الغربي الأوسط لآسيا الصغرى وجزر شيوس وساموس)",
 "ionian order": "نظام إيوني (ثاني نظام يوناني؛ التاج مزخرف بلفائف لولبية)",
 "ionian sea": "اَلْبَحْر اَلْأَيْوُنِيّ",
 "ionic": "أيوني, شردي (يحتوي على أو يتضمن أو يحدث في شكل أيونات (شوارد)) / إيوني (مكون من أو متعلق بإيونيا أو سكانها أو لغتها) / إيوني (مكون من أو متعلق بالطراز الإيوني للعمارة اليونانية الكلاسيكية) / الأفلاطونية, الأيونية (لهجة اليونانية القديمة التي كان يتم التحدث بها وكتابتها في أتيكا وأثينا وأيونيا)\nمثال: شحنة أيونية",
 "ionic beam": "حزمة أيونية (حزمة من الأيونات تتحرك في نفس الاتجاه وبنفس السرعة)",
 "ionic bond": "رابطة أيونية, رابطة شاردية (رابطة كيميائية تفقد فيها ذرة إلكتروناً لتشكل أيوناً موجباً وتكتسب الذرة الأخرى إلكتروناً لتشكل أيوناً سالباً)",
 "ionic charge": "شِحْنَة أَيُونِيَّة",
 "ionic dialect": "الأفلاطونية, الأيونية (لهجة اليونانية القديمة التي كان يتم التحدث بها وكتابتها في أتيكا وأثينا وأيونيا)",
 "ionic medication": "رحلان أيوني, علاج أيوني (علاج يستخدم تياراً كهربائياً موضعياً لإدخال أيونات الدواء إلى الأنسجة)",
 "ionic order": "نظام إيوني (ثاني نظام يوناني؛ التاج مزخرف بلفائف لولبية)",
 "ionisation": "تأين (عملية التأين؛ تكوين الأيونات عن طريق فصل الذرات أو الجزيئات أو الجذور أو عن طريق إضافة أو طرح الإلكترونات من الذرات بواسطة مجالات كهربائية قوية في غاز) / تأين (حالة التفكك إلى أيونات (كما يحدث بالحرارة أو الإشعاع أو التفاعل الكيميائي أو التفريغ الكهربائي))\nمثال: تأين الغاز",
 "ionised": "مُتَأَيِّن (محول كلياً أو جزئياً إلى أيونات)",
 "ionization": "تأين (عملية التأين؛ تكوين الأيونات عن طريق فصل الذرات أو الجزيئات أو الجذور أو عن طريق إضافة أو طرح الإلكترونات من الذرات بواسطة مجالات كهربائية قوية في غاز) / تأين (حالة التفكك إلى أيونات (كما يحدث بالحرارة أو الإشعاع أو التفاعل الكيميائي أو التفريغ الكهربائي))\nمثال: تأين الغاز",
 "ionization chamber": "غرفة التأين (أداة قياس تقيس كمية الإشعاع المؤين)",
 "ionization constant": "ثابت التأين (ثابت التوازن لتأين إلكتروليت (ضعيف))",
 "ionization tube": "غرفة التأين (أداة قياس تقيس كمية الإشعاع المؤين)",
 "ionize": "أَيَّنَ",
 "ionized": "مُتَأَيِّن (محول كلياً أو جزئياً إلى أيونات)",
 "ionizing radiation": "الإشعاعات المؤينة",
 "ionophoresis": "رحلان كهربائي (حركة الجسيمات المشحونة في مادة غروانية تحت تأثير مجال كهربائي؛ حيث تتجه الجسيمات ذات الشحنة الموجبة إلى الكاثود والسالبة إلى الأنود)",
 "ionosphere": "أَيْونْوسْفِير",
 "ionospheric wave": "موجة أيونوسفيرية (موجة سماوية تنعكس بواسطة الغلاف الأيوني)",
 "iontophoresis": "رحلان أيوني, علاج أيوني (علاج يستخدم تياراً كهربائياً موضعياً لإدخال أيونات الدواء إلى الأنسجة)",
 "iontotherapy": "رحلان أيوني, علاج أيوني (علاج يستخدم تياراً كهربائياً موضعياً لإدخال أيونات الدواء إلى الأنسجة)",
 "iop": "ضغط داخل العين (الضغط الذي تمارسه السوائل داخل مقلة العين؛ ينظم بواسطة مقاومة التدفق الخارجي للخلط المائي)\nمثال: يمكن أن ينتج الجلوكوما عن زيادة الضغط داخل العين",
 "iota": "إِيُوتَا",
 "iou": "سند دين بسيط, وصل أمانة (أداة دين غير رسمية؛ تمثل عبارة 'أنا مدين لك')",
 "iowa": "آيوا",
