 "broadness": "اتساع, سعة (خاصية كون الشيء واسعاً؛ امتلاك عرض كبير)",
 "broadnosed": "عريض الأنف (من أو يتعلق بقرود العالم الجديد التي لها فتحات أنف متباعدة أو لأشخاص ذوي أنوف عريضة)",
 "broadsheet": "مَنْشُور, نَشْرَة إِعْلَانِيَّة (إعلان (عادة ما يطبع على صفحة أو في نشرة) معد للتوزيع على نطاق واسع)\nمثال: أرسل المنشور بالبريد إلى جميع المشتركين",
 "broadside": "بالجانب العريض, بكامل الجانب (بجانب يواجه شيئاً ما) / رماية جانبية (إطلاق النار المتزامن لجميع الأسلحة على جانب واحد من سفينة حربية) / عَرْضِيّ (باتجاه الجانب الكامل؛ على عرض الشيء) / جانب السفينة (الجانب الكامل للسفينة من المقدمة إلى المؤخرة)\nمثال: صدم القطار الشاحنة من جانبها العريض",
 "broadsword": "سيف عريض (سيف ذو نصل عريض و(عادة) حدين قاطعين؛ يستخدم للقطع بدلاً من الطعن)",
 "broadtail": "عريض الذيل, كاراكول (خروف قوي خشن الشعر من وسط آسيا؛ تُقدر الحملان لفرائها الأسود المجعد الناعم) / برودتيل, ذيل عريض (فراء حمل كاراكول صغير جداً)",
 "broadwise": "عَرْضًا (في اتجاه العرض)\nمثال: قص القماش عرضاً",
 "brobdingnag": "بروبدينغناغ (أرض تخيلها جوناثان سويفت حيث كان كل شيء ضخمًا)",
 "brobdingnagian": "جَسِيم, شَاسِع (عظيم بشكل غير معتاد في الحجم أو الكمية أو الدرجة أو خاصة المدى والنطاق) / عملاق (ضخم؛ يتعلق بـ أو من خصائص البلد الخيالي بروبدنجناج (أرض العمالقة في رحلات جليفر))",
 "broca's aphasia": "حبسة بروكا, حبسة تعبيرية (حبسة يكون فيها التعبير عن طريق الكلام أو الكتابة معاقاً بشدة)",
 "broca's area": "باحة بروكا, مركز بروكا (مركز الكلام الحركي في نصف الكرة الأيسر للدماغ في معظم الناس)",
 "broca's center": "باحة بروكا, مركز بروكا (مركز الكلام الحركي في نصف الكرة الأيسر للدماغ في معظم الناس)",
 "broca's convolution": "باحة بروكا, مركز بروكا (مركز الكلام الحركي في نصف الكرة الأيسر للدماغ في معظم الناس)",
 "broca's gyrus": "باحة بروكا, مركز بروكا (مركز الكلام الحركي في نصف الكرة الأيسر للدماغ في معظم الناس)",
 "brocade": "إِسْتَبْرَق (إستَبرَق)",
 "brocaded": "بَارِز النَّقْش, مُطَرَّز (مزين بنقش بارز ناتج عن الضغط أو التطريز)",
 "brocadopa": "ليفودوبا (الشكل الميسر للدوبا؛ كدواء يستخدم لعلاج مرض باركنسون)",
 "broccoli": "بْرُكُولِي, بْرُوكُلِي",
 "broccoli raab": "بروكلي راب, رابيني (أوراق خضراء داكنة مرّة قليلاً وبراعم زهور عنقودية) / بروكلي راب (نبات يزرع لسيقانه الورقية الصالحة للأكل اللاذعة)",
 "broccoli rabe": "بروكلي راب, رابيني (أوراق خضراء داكنة مرّة قليلاً وبراعم زهور عنقودية) / بروكلي راب (نبات يزرع لسيقانه الورقية الصالحة للأكل اللاذعة)",
 "brochette": "سيخ شواء صغير (سيخ صغير أو سيخ للشواء)",
 "brochure": "كُرَّاسَة, كُتَيِّب",
 "brocket": "بروكيت (ذكر الأيل الأحمر في سنته الثانية) / بروكيت (أيل صغير في أمريكا الجنوبية ذو قرون غير متفرعة)",
 "brodiaea": "بروديا (أي من النباتات العديدة من جنس بروديا ذات أوراق قاعدية تشبه العشب ورؤوس زهور كروية على سيقان عديمة الأوراق تشبه تلك الموجودة في جنس الثوم)",
 "brodiaea elegans": "بروديا أنيقة (بروديا لها مظلة من الزهور البنفسجية أو الزرقاء البنفسجية فوق ساق بلا أوراق؛ شمال أوريغون إلى جنوب كاليفورنيا)",
 "brodmann's area": "منطقة برودمان (إحدى المناطق القشرية المحددة بناءً على البنية الخلوية)",
 "brodmann's area 17": "القشرة المخططة, المنطقة البصرية الأولية (جزء القشرة القذالية الذي يستقبل ألياف الإشعاع البصري من الجسم الركبي الجانبي وهو منطقة الاستقبال الأولية للرؤية)",
 "brogan": "حذاء عمل, حذاء غليظ (حذاء سميك وثقيل)",
 "brogue": "حذاء عمل, حذاء غليظ (حذاء سميك وثقيل)",
 "broil": "شوي (الطهي بالتعرض المباشر للحرارة المشعة (كما فوق نار أو تحت شواية))",
 "broiled": "مَشْوِيٌّ بِالحَرَارَة (مَطْهُوٌّ بِالحَرَارَةِ المُشِعَّةِ كَمَا عَلَى الشَّوَّايَة)",
 "broiler": "شواية فرن, محمّرة (فرن أو جزء من الموقد يُستخدم للشوي (بحرارة علوية)) / دجاج شواية (لحم دجاجة صغيرة لا يتجاوز وزنها 2.5 رطل مناسبة للشوي)",
 "broiling": "شوي (الطهي بالتعرض المباشر للحرارة المشعة (كما فوق نار أو تحت شواية))",
 "broke": "مُفْلِس",
 "broken": "مَكْسُور",
 "broken arch": "قوس مكسور (قوس به فجوة في القمة؛ عادة ما تملأ الفجوة ببعض الزخارف)",
 "broken heart": "انكسار القلب (أسى ويأس مدمر)\nمثال: إنه يتعافى من انكسار القلب",
 "broken home": "أسرة مفككة (أسرة انفصل فيها الوالدان أو تطلقا)",
 "broken in": "مُذَلَّل, مُرَوَّض (تَمَّ تَرْوِيضُهُ أَوْ تَدْرِيبُهُ عَلَى الطَّاعَة)",
 "broken plural": "جَمْع تَكْسِير, جَمْع مُكَسَّر (ضَمَّ، لَمَّ، حَشَدَ؛ في : أَضَافَ أعدادا إلى غيرها)\nمثال: جمع خيل هو خيول.",
 "broken record": "أُسْطُوَانَة مَشْرُوخَة",
 "broken wind": "نفس مقطوع (انتفاخ رئوي مزمن للحصان يسبب صعوبة في الزفير وارتفاع الخاصرتين)",
 "broken-backed": "مَكْسُورُ الظَّهْرِ, مُقَوَّس ((عَنِ السَّفِينَةِ) ضَعُفَتْ حَتَّى تَدَلَّى طَرَفَاهَا) / مَكْسُورُ الظَّهْرِ (متضرر العمود الفقري أو الكعب) / مَكْسُورُ الظَّهْر ((عَنِ الخَيْلِ) اِلْتَحَمَتْ عِظَامُ ظَهْرِهِ بِنُمُوٍّ عَظْمِيٍّ)",
 "broken-down": "مُعَطَّل",
 "broken-field": "مُتَعَرِّج, مُتَغَيِّر الاتِّجَاه (يَتَغَيَّر فِي الاتِّجَاه بِشَكْلٍ مُفَاجِئ ومُتَكَرِّر)",
 "brokenhearted": "مَكْسُور الخَاطِر, مُنْكَسِر القَلْب (مليء بالحزن والأسى)",
 "brokenheartedness": "حزن شديد, فجيعة (أسى شديد ناتج عن فقدان شخص محبوب (خاصة بالموت))",
 "broker": "سِمْسَار, وَسِيط",
 "broker-dealer": "وسيط-تاجر (متخصص مالي يتداول لحسابه الخاص وبالتالي يعمل كوسيط وطرف أصيل)",
 "brokerage": "بيت وساطة, شركة وساطة (المكان الذي يدير فيه الوسيط أعماله) / سمسرة, وساطة (عمل السمسار؛ يتقاضى رسوماً لترتيب عقد بين طرفين) / شركة سمسرة, شركة وساطة مالية (أعمال سمسار الأوراق المالية؛ تتقاضى رسوماً للعمل كوسيط بين البائع والمشتري)",
 "brokerage account": "حساب وساطة (صندوق ائتمنه عميل لدى شركة وساطة للأوراق المالية)\nمثال: لا يمكنك الحصول على حساب وساطة ما لم يكن لديك 20,000 دولار",
 "brokerage firm": "شركة سمسرة, شركة وساطة مالية (أعمال سمسار الأوراق المالية؛ تتقاضى رسوماً للعمل كوسيط بين البائع والمشتري)",
 "brokerage house": "بيت وساطة, شركة وساطة (المكان الذي يدير فيه الوسيط أعماله)",
 "brolly": "مظلة (مصطلحات عامية للمظلة)",
 "bromance": "بْرُومَانس, صَدَاقَة رُجُولِيَّة حَمِيمَة (علاقة غير جنسية ولكنها مكثفة بين رجلين)",
 "bromate": "برومات (مركب كيميائي يحتوي على أيون البرومات)",
 "brome": "بروم, عشب البروم (أي من أعشاب الغابات والمروج المختلفة من جنس بروموس؛ موطنها المناطق المعتدلة)",
 "bromegrass": "بروم, عشب البروم (أي من أعشاب الغابات والمروج المختلفة من جنس بروموس؛ موطنها المناطق المعتدلة)",
 "bromeosin": "إيوسين (صبغة حمراء فلورية تنتج عن تفاعل البروم مع الفلوريسين؛ تستخدم في مستحضرات التجميل وكصبغة بيولوجية لدراسة تراكيب الخلايا)",
 "bromic": "بروميك (يتعلق بـ أو يحتوي على البروم (وخاصة البروم خماسي التكافؤ))",
 "bromic acid": "حمض البروميك (حمض غير مستقر يستخدم كعامل مؤكسد)",
 "bromide": "عبارة مبتذلة, قول مأثور مبتذل (ملاحظة مبتذلة أو واضحة بشكل مفرط) / بروميد (أي من أملاح حمض الهيدروبروميك؛ كان يستخدم سابقاً كمهدئ ولكن تم استبداله عموماً بأدوية أكثر أماناً)",
 "bromide paper": "ورق بروميد (ورق تصوير حساس بمستحلبات بروميد الفضة ينتج نغمات صور سوداء محايدة أو زرقاء سوداء باردة)",
 "bromidic": "سَخِيف, سَطْحِيّ (مُمِلّ ومُرهِق مع ادعاءات بالأهمية أو الأصالة) / مبتذل (يميل إلى التلفظ بعبارات مبتذلة)",
 "bromine": "بُرُوم, بُرُومِين",
 "bromo-seltzer": "برومو سيلتزر (نوع من مضادات الحموضة)",
 "bromoform": "بروموفورم",
 "bromoil": "برومويل (مطبوعة مصنوعة بعملية برومويل ولها صفات ناعمة تشبه الرسم)",
 "bromoil process": "عملية برومويل (عملية تصوير مبكرة تعتمد على الطباعة الزيتية، تعود أصولها إلى منتصف القرن التاسع عشر)",
 "bromophenol blue": "أزرق بروموفينول (صبغة تستخدم كمؤشر حمض-قاعدة، ذات نطاق مفيد بين الأس الهيدروجيني 3.0 و 4.6)",
 "bromothymol blue": "أزرق بروموثيمول (صبغة تستخدم كمؤشر حمض-قاعدة، ذات نطاق مفيد بين الأس الهيدروجيني 6.0 و 7.6)",
 "brompheniramine maleate": "برومفينيرامين, ديميتان (مضاد للهيستامين (الاسم التجاري ديميتان) يستخدم لعلاج تفاعلات فرط الحساسية (مثل التهاب الأنف))",
 "bromphenol blue": "أزرق بروموفينول (صبغة تستخدم كمؤشر حمض-قاعدة، ذات نطاق مفيد بين الأس الهيدروجيني 3.0 و 4.6)",
 "brompton stock": "منثور برومبتون, منثور رمادي (نبات أوروبي بعناقيد من الزهور حلوة الرائحة؛ يزرع على نطاق واسع كنبات زينة)",
 "bromthymol blue": "أزرق بروموثيمول (صبغة تستخدم كمؤشر حمض-قاعدة، ذات نطاق مفيد بين الأس الهيدروجيني 6.0 و 7.6)",
 "bromus arvensis": "برومس الحقول (عشبة سنوية من أوروبا وآسيا المعتدلة)",
 "bromus inermis": "برومس عديم السفا (نبات معمر مقاوم للجفاف بسفا مفقود أو قصير جداً وجذامير زاحفة طويلة؛ أوروبا وآسيا المعتدلة)",
 "bromus japonicus": "برومس ياباني (عشبة من البحر الأبيض المتوسط وآسيا المعتدلة)",
 "bromus secalinus": "برومس شيلمي, شطرنج (نبات سنوي ضار موطنه أوروبا ولكنه واسع الانتشار كعشبة ضارة خاصة في القمح)",
 "bromus tectorum": "برومس زغبي, عشبة الغش (عشبة سنوية أو شتوية سنوية بأوراق مشعرة بنعومة من البحر الأبيض المتوسط)",
 "bronc": "برونكو, حصان بري (حصان موستانج غير مروض أو مروض بشكل غير كامل)",
 "bronchial": "شعبي, قصبي (يتعلق بالقصبات الهوائية أو يرتبط بها)\nمثال: أنابيب قصبية",
 "bronchial artery": "شريان قصبي (شرايين ترافق القصيبات)",
 "bronchial asthma": "ربو (اضطراب تنفسي يتميز بصفير؛ عادة من أصل تحسسي)",
 "bronchial pneumonia": "التهاب رئوي قصبي (التهاب رئوي يتميز بالتهاب حاد في جدران القصيبات الهوائية)",
 "bronchial tube": "شعبة هوائية, قصبة هوائية (أي من الفرعين الرئيسيين للرغامى)",
 "bronchial vein": "وريد قصبي (أوردة تخدم القصبات الهوائية؛ تصب في الوريد الفرد)",
 "bronchiectasis": "تَوَسُّع القَصَبَات",
 "bronchiolar": "شعيبي (من أو يتعلق بالشعيبات الهوائية أو يتضمنها)",
 "bronchiole": "قصيبة (أي من أصغر القنوات القصبية؛ تنتهي في الحويصلات الهوائية)",
 "bronchiolitis": "اِلْتِهَاب قُصَيْبَات",
 "bronchitic": "مُصَاب بِالتِهَاب القَصَبَات (يعاني من التهاب القصبات الهوائيّة أو معرَّض له)",
 "bronchitis": "التهاب الشعب الهوائية (التهاب الأغشية المبطنة للشعب الهوائية)",
 "broncho": "برونكو, حصان بري (حصان موستانج غير مروض أو مروض بشكل غير كامل)",
 "bronchodilator": "موسع قصبي (دواء يرخي ويوسع الممرات القصبية ويحسن مرور الهواء إلى الرئتين)",
 "bronchopneumonia": "التهاب رئوي قصبي (التهاب رئوي يتميز بالتهاب حاد في جدران القصيبات الهوائية)",
 "bronchoscope": "منظار القصبات (أداة أنبوبية رفيعة تستخدم لفحص القصبات الهوائية)",
 "bronchoscopic": "منظاري قصبي (من أو متعلق بأداة لفحص الجزء الداخلي من القصبات الهوائية)",
 "bronchoscopic smear": "مَسْحَةُ البَلْغَم, مَسْحَةُ التَّنْظِيرِ القَصَبِيّ (أي من عدة مسحات خلوية يتم الحصول عليها من أجزاء مختلفة من الجهاز التنفسي السفلي؛ تستخدم للدراسة الخلوية للسرطان وأمراض أخرى في الرئتين)",
 "bronchospasm": "تشنج قصبي (تشنج في القصبات الهوائية يجعل الزفير صعباً ومصحوباً بضجيج؛ يرتبط بالربو والتهاب الشعب الهوائية)",
 "bronchus": "القَصَبَة الهَوَائِيَّة",
 "bronco": "برونكو, حصان بري (حصان موستانج غير مروض أو مروض بشكل غير كامل)",
 "bronco buster": "مروض الخيول (شخص يروض الخيول)",
 "bronco busting": "ترويض الخيول البرية (ترويض حصان بري لتقبل السرج)",
 "broncobuster": "مروض الخيول (شخص يروض الخيول)",
 "brontosaur": "أباتوصور, برونتوصور (ديناصور عاشب ضخم رباعي الأرجل كان شائعاً في أمريكا الشمالية في أواخر العصر الجوراسي)",
 "brontosaurus": "أباتوصور, برونتوصور (ديناصور عاشب ضخم رباعي الأرجل كان شائعاً في أمريكا الشمالية في أواخر العصر الجوراسي)",
 "bronx": "الْبْرُونْكْس",
 "bronx cheer": "استهجان, سخرية (صيحة أو ضجيج يصنع للتعبير عن الاستياء أو الازدراء)",
 "brony": "بروني (معجب ذكر بالغ ببرنامج ماي ليتل بوني: الصداقة سحر)",
 "bronze": "بُرُنْزٌ, فِلِزّ / بُرُنْزِيٌّ",
 "bronze age": "العَصْرُ البُرُنْزِيُّ",
 "bronze medal": "ميدالية برونزية (كأس مصنوعة من البرونز (أو لها مظهر البرونز) تمنح عادة للفائز بالمركز الثالث في المسابقة)",
 "bronze star": "النجمة البرونزية (وسام عسكري أمريكي يمنح للخدمة الجديرة بالتقدير (باستثناء الرحلات الجوية))",
 "bronze star medal": "النجمة البرونزية (وسام عسكري أمريكي يمنح للخدمة الجديرة بالتقدير (باستثناء الرحلات الجوية))",
 "bronze-red": "أَحْمَر بُرُونْزِيّ (أحمر مع مسحة برونزية)",
 "bronzed": "بُرُونْزِيّ, مُسَمَّر ((للبشرة) ذو لون سُمرة من التعرض للشمس)",
 "bronzed diabetes": "داء ترسب الأصبغة الدموية, زيادة حمل الحديد (حالة مرضية يتراكم فيها الحديد في الأنسجة؛ تتميز بجلد برونزي وتضخم الكبد والسكري وتشوهات في البنكرياس والمفاصل)",
 "bronzer": "برونزر, بودرة التسمير (مسحوق تجميلي يأتي بدرجات مختلفة من اللون البني، يهدف إلى إعطاء انطباع بالبشرة السمراء)\nمثال: نحت وجهك ببودرة التسمير سيجعله يبدو أنحف",
 "bronzing powder": "برونزر, بودرة التسمير (مسحوق تجميلي يأتي بدرجات مختلفة من اللون البني، يهدف إلى إعطاء انطباع بالبشرة السمراء)\nمثال: نحت وجهك ببودرة التسمير سيجعله يبدو أنحف",
 "bronzy": "بُرُونْزِيّ (بلون البرونز)",
 "brooch": "بْرُوش",
 "brood": "حِضْنَة, صغار (صغار حيوان يتم رعايتهم في وقت واحد)",
 "brood bitch": "كلبة ولود (كلبة تُستخدم للتكاثر)",
 "brood hen": "دجاجة حاضنة, دجاجة راقدة (دجاجة منزلية مستعدة للرقاد على البيض)",
 "brooder": "حاضنة (جهاز يتكون من صندوق مصمم للحفاظ على درجة حرارة ثابتة باستخدام منظم حرارة؛ يستخدم للكتاكيت أو الأطفال الخدج)",
 "brooder pneumonia": "التهاب رئوي بالحضنة (مرض تنفسي شديد للطيور يتخذ شكل التهاب رئوي حاد سريع الفتك في الدجاج الصغير والديوك الرومية)",
 "brooding": "تَأَمُّلِيّ, مُتَدَبِّر (مُسْتَغْرِقٌ فِي تَفْكِيرٍ عَمِيقٍ وَجِدِّيّ) / استغراق في التفكير, وجوم (تأمل مرضي مستمر في مشكلة ما) / تحضين, حضن (الجلوس على البيض لفقسه بواسطة دفء الجسم)",
 "broodmare": "فرس ولود (أنثى حصان تستخدم للتربية)",
 "broody": "دجاجة حاضنة, دجاجة راقدة (دجاجة منزلية مستعدة للرقاد على البيض) / تَأَمُّلِيّ, مُتَدَبِّر (مُسْتَغْرِقٌ فِي تَفْكِيرٍ عَمِيقٍ وَجِدِّيّ) / رَاقِد, مُسْتَعِدٌّ لِلحَضَانَة (مُهَيَّأٌ فِسْيُولُوجِيًّا لِاحْتِضَانِ البَيْض)",
 "broody hen": "دجاجة حاضنة, دجاجة راقدة (دجاجة منزلية مستعدة للرقاد على البيض)",
 "brook": "غَدِير",
 "brook thistle": "شوك الجداول (نبات من وسط وجنوب غرب أوروبا)",
 "brook trout": "تروتة الجدول (تروتة المياه العذبة في أمريكا الشمالية؛ أُدخلت إلى أوروبا) / تراوت الجدول (سمكة طعام لذيذة من المياه العذبة)",
 "brooklet": "جدول صغير (جدول صغير)",
 "brooklime": "زهرة الوحل الأمريكية, فيرونيكا أمريكية (نبات من غرب أمريكا الشمالية وشمال شرق آسيا له سيقان مفترشة مع عناقيد كثيفة من الزهور البنفسجية الشاحبة إلى الليلكية) / زهرة الوحل الأوروبية, فيرونيكا (نبات أوروبي له سيقان منخفضة وزهور زرقاء؛ تم توطينه بشكل متناثر في أمريكا الشمالية)",
 "brooklyn": "بروكلين",
 "brookweed": "عشبة الجدول (أناغالس الماء من أوروبا إلى الصين) / عشبة الجدول الأمريكية (أناغالس الماء الأمريكي)",
 "broom": "مِكْنَسَة, مِقْشَة",
 "broom beard grass": "عشبة البراري, عشبة لحية المكنسة (عشبة أمريكية شمالية قوية التحمل جميلة تتحول أوراقها إلى البرونزي الشاحب في الخريف)",
 "broom closet": "خزانة مكانس (غرفة صغيرة لتخزين المكانس ومعدات التنظيف الأخرى)",
 "broom grass": "عشب المكنسة (أي من عدة أعشاب من جنس أندروبوجون؛ تستخدم في صنع المكانس)",
 "broom handle": "عصا المكنسة, يد المكنسة (مقبض المكنسة)",
 "broom palm": "نخيل القش, نخيل المكنسة (نخيل صغير من جنوب فلوريدا وجزر الهند الغربية يشبه كثيراً بالميتو الفضي)",
 "broom sedge": "سعد المكنسة (عشبة معنقدة طويلة في جنوب شرق الولايات المتحدة)",
 "broom snakeroot": "عشبة الأرنب, عشبة الثعبان المكنسية (شجيرة منخفضة النمو لزجة في جنوب غرب الولايات المتحدة ذات أوراق خطية ضيقة على العديد من الفروع الرفيعة ومئات من رؤوس الزهور الصفراء الصغيرة)",
 "broom snakeweed": "عشبة الأرنب, عشبة الثعبان المكنسية (شجيرة منخفضة النمو لزجة في جنوب غرب الولايات المتحدة ذات أوراق خطية ضيقة على العديد من الفروع الرفيعة ومئات من رؤوس الزهور الصفراء الصغيرة)",
 "broom tree": "جنيستا, وزال إنجليزي (شجيرة شائكة صفراء الأزهار في مستنقعات نيو إنجلاند وأوروبا)",
 "broom-weed": "عشبة المكنسة (نبات سنوي في جنوب غرب الولايات المتحدة ذو فروع خشبية صلبة بأوراق لزجة وزهور صفراء)",
 "broomcorn": "ذرة المكانس (أعشاب طويلة تزرع للنورة المتفرعة الصلبة الممدودة المستخدمة للمكانس والفرش)",
 "broomcorn millet": "دخن الخنزير, دخن المكنسة (يزرع على نطاق واسع في أوروبا وآسيا لحبوبه وفي الولايات المتحدة أحياناً للعلف)",
 "broomrape": "هَالُوك, جَعْفِيل",
 "broomstick": "عصا المكنسة, يد المكنسة (مقبض المكنسة)",
 "broomweed": "عشبة المكنسة (نبات سنوي في جنوب غرب الولايات المتحدة ذو فروع خشبية صلبة بأوراق لزجة وزهور صفراء)",
 "brosme brosme": "كاسك (سمكة بحرية كبيرة صالحة للأكل تعيش في المياه الساحلية الشمالية؛ مرتبطة بالقد)",
 "broth": "مَرَق, مَرَقَة (الطَعَام سائل الخفيف فيه ماء اللحم وقد يكون فيه خضار أو غير ذلك. يؤكل عادة مع الرز أو الخبز. يجوز قول مَرَقَة، وهي أخص من المرَق)",
 "broth of a boy": "فتى رائع (شخص متميز؛ كأنه نتاج غليان مرق لذيذ)",
 "broth of a man": "فتى رائع (شخص متميز؛ كأنه نتاج غليان مرق لذيذ)",
 "brothel": "بَيْت دَعَارَة, مَبْغًى (بمعنى قضى الليل؛ الخَيْمَة من الشَعْر يَبِيت فيها البَدَوي أو المُسافر. الجمع بُيُوت)\nمثال: لنعد إلى البيت.",
 "brothel keeper": "قوادة, مديرة بيت دعارة (امرأة تدير بيت دعارة)",
 "brother": "أَخ / شَقِيق (كل ما شُقَّ نصفين فكل من النصفين شقيق الآخر؛ الأخ من نفس الأم والأب) / إخوات / أخ / أخو\nمثال: لا أحد هناك عرف أن توم هو شقيق ماري.",
 "brother-in-law": "شَقِيق زَوْج, شَقِيق زَوْجَة (كل ما شُقَّ نصفين فكل من النصفين شقيق الآخر؛ الأخ من نفس الأم والأب)\nمثال: لا أحد هناك عرف أن توم هو شقيق ماري.",
 "brotherhood": "أُخُوَّة",
 "brotherlike": "أَخَوِيّ (مثل أو مميز لـ أو يليق بالأخ)\nمثال: مشاعر أخوية",
 "brotherliness": "مُؤَاخَاة",
 "brotherly": "أَخَوِيّ",
 "brotherly love": "محبة, مودة أخوية (موقف طيب ومتسامح تجاه الناس)",
 "brotula": "بروتولا (أسماك أعماق)",
 "brougham": "بروهام (سيدان ليس لها سقف فوق مقعد السائق) / عربة بروهام (عربة خفيفة؛ يجرها حصان واحد)",
 "brouhaha": "عَجِيج, ضَجِيج",
 "broussonetia papyrifera": "توت الورق (شجرة شجيرية آسيوية لها لحاء (تابا) يشبه القماش؛ تزرع كشجرة ظل في أوروبا وأمريكا؛ الزهور الذكرية هي نورات هرية متدلية والأنثوية جرة الشكل تليها ثمار…)",
 "brow": "حَاجِب (قوس الشعر فوق كل عين) / جبهة, جبين (جزء الوجه فوق العينين) / قمة التلة (قمة التل)\nمثال: غربت الشمس خلف قمة التلال البعيدة",
 "brow ptosis": "تدلي الحواجب (ترهل الحواجب)",
 "browallia": "برواليا, بنفسج الشجيرة (أي من عدة أعشاب من جنس برواليا تزرع لزهورها الزرقاء أو البنفسجية أو البيضاء)",
 "browbeat": "أَخَافَ, أَرْعَبَ",
 "brown": "بُنِّيّ (هو لون ينتمي لمجموعة الألوان الحارة. وكلمة بني نسبة للبن (قهوة)) / أَسْمَر / أَسْمَر, سَمْرَاء\nمثال: توم من بني البشر.",
 "brown algae": "طحالب بنية (طحالب يحجب الكلوروفيل فيها أصباغ بنية وصفراء)",
 "brown ash": "مران أسود (شجرة أمريكية شمالية قوية الانتشار لها خشب ثقيل بني داكن؛ تتحول الأوراق إلى الذهب في الخريف)",
 "brown bat": "خفاش بني (أي من خفافيش عديدة متوسطة إلى صغيرة آكلة للحشرات توجد في جميع أنحاء العالم في الكهوف والأشجار والمباني)",
 "brown bear": "دُبّ أَسْمَر",
 "brown bells": "أجراس بنية (عشبة كاليفورنيا بأزهار بنية أرجوانية أو خضراء على شكل جرس)",
 "brown bent": "أغروستيس مخملي, عشبة منحنية مخملية (عشبة شائعة بسيقان نحيلة وأوراق ضيقة)",
 "brown betty": "براون بيتي (بودينغ مخبوز من التفاح وفتات الخبز)",
 "brown bread": "خُبْز أَسْمَر (هو طعام يصنع من الدَقِيق الذي يعجن بالماء والخَمِيرَة ويُخْبَز في الفُرْن أو التَنُّور؛ خُبْز الغُراب: الفِطْر، ويسمى أيضا عُشّ الغُرَاب)\nمثال: هذا الخبز لذيذ.",
 "brown bullhead": "سلور بني (سلور مياه عذبة في شرق الولايات المتحدة)",
 "brown butter": "زبدة بنية (زبدة مصفاة تحمر ببطء وتتبل بالخل أو عصير الليمون والقبار)",
 "brown coal": "فحم بني, ليغنيت (مرحلة وسيطة بين الخث والفحم البيتوميني)",
 "brown creeper": "دابة الشجر البنية (دابة شجر شائعة في أمريكا الشمالية بمنقار منحني لأسفل)",
 "brown cup": "كأس بني (نوع من سكليروتينيا)",
 "brown goldstone": "حجر الذهب البني (نوع بني نحاسي من حجر الذهب)",
 "brown hickory": "جوز الخنزير (شجرة جوز أمريكية لها مكسرات مرة)",
 "brown hyena": "ضبع بني (من جنوب أفريقيا)",
 "brown lacewing": "شبكية الأجنحة البنية (ذبابة شبكية الأجنحة صغيرة داكنة اللون)",
 "brown lemming": "لاموس بني (من شمال غرب كندا وألاسكا)",
 "brown oak": "زان أحمر, هريتييرا ثلاثية الأوراق (شجرة كبيرة من أسترالاسيا)",
 "brown onion sauce": "صلصة البصل البنية, ليونيز (صلصة بنية مع بصل مفروم مقلي وبقدونس ونبيذ أبيض جاف أو خل)",
 "brown pine": "بودوكاربوس روكينغهام, صنوبر بني (شجرة أسترالية كبيرة بخشب أصفر مستقيم الحبيبات يتحول إلى البني عند التعرض للهواء)",
 "brown rat": "جُرْذ أَسْمَر ((جَرَذَت) القرحة جرذا: تعقدت كالجُرَذِ)\nمثال: عبر جرذ الطريق.",
 "brown rice": "أرز أسمر, أرز بني (أرز غير مصقول يحتفظ بالطبقة الخارجية ذات اللون البني المصفر)",
 "brown root rot fungus": "فطر عفن الجذور البني (فطر يسبب عفن الجذور البني في نباتات فصائل البازلاء والبطاطس والخيار)",
 "brown rot": "عفن بني (أي من الأمراض الفطرية المعينة للنباتات التي تتميز بتلون الأنسجة باللون البني وتحللها)",
