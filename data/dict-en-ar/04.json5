 "bumpkin": "فلاح ساذج, قروي بسيط (شخص ليس ذكياً جداً أو غير مهتم بالثقافة)",
 "bumpkinly": "بَسِيطٌ سَاذَج, رِيفِيّ (بَسِيطٌ بِطَرِيقَةٍ فَجَّةٍ وَقَرَوِيّ)",
 "bumptious": "مُتَعَجْرِف, مُتَغَطْرِس (يفرض ذاته بشكل مُسيء ومتعجرف)",
 "bumptiously": "بِصَلَف, بِغُرُور (بطريقة مغرورة)\nمثال: تصرف بغرور وأساء للمضيفة",
 "bumptiousness": "تَطَاوُل, جَرَاءَة (جرأة وتوكيد للذات بشكل مسيء)",
 "bumpy": "مُحَدَّب, مُنْتَأ (ذو نتوءات أو ارتفاعات غير منتظمة) / متخبط, مهتز (يسبب أو يتسم بالاهتزازات والحركات غير المنتظمة)\nمثال: ركوب وعر",
 "bun": "كَعْكَة (واحدة الكَعْك؛ حَلْوَى تُصْنع من الدَقِيق والحَلِيب والسُكَّر والزَيت ويخبز طريًا وقد يوضع عليه القِشْطَة. يُسمى عند البعض كَيْك وعند البعض تُورْتَة)\nمثال: خبزت كعكة لتوم.",
 "bun divider": "مكورة عجين (آلة تقطع العجين الخام إلى أجزاء صغيرة وتلف كل منها للحصول على كرات بنفس الوزن والشكل)",
 "bun rounder": "مكورة عجين (آلة تقطع العجين الخام إلى أجزاء صغيرة وتلف كل منها للحصول على كرات بنفس الوزن والشكل)",
 "bun-fight": "حفل شاي صاخب, حفلة رسمية ((عامية بريطانية) حفلة رسمية كبيرة في مناسبة مهمة)",
 "buna": "مطاط بونا (مصنوع عن طريق بلمرة البوتادين)",
 "buna rubber": "مطاط بونا (مصنوع عن طريق بلمرة البوتادين)",
 "bunce": "رزق ساقه الله, رواج (حدث مفاجئ يجلب الحظ السعيد (مثل فرصة مفاجئة لكسب المال))\nمثال: خلق الطلب على الاختبار طفرة لتلك المختبرات غير الخاضعة للتنظيم",
 "bunch": "حُزْمَة, عُنْقُود / مَجْمُوعَة (مؤنث مَجْمُوع وهو اسم مفعول من جَمَعَ؛ الطَائِفَة أو الجَمَاعَة من الناس) / حُزْمَة / حَزَمَ (جَمَعَ، رَتَّبَ؛ في اللغة: شدّ الأشياء معًا بشكل محكم)\nمثال: شكرا لإضافتي للمجموعة.",
 "bunch grass": "عشب عنقودي (أي من أعشاب مختلفة من أجناس عديدة تنمو في خصلات أو كتل بدلاً من تشكيل بساط عشبي؛ توجد بشكل رئيسي في غرب الولايات المتحدة)",
 "bunchberry": "توت البودنغ, قرانيا قزمية (عشب معمر زاحف يتميز بتوت أحمر ودوامات أوراق عنقودية عند أطراف البراعم؛ غرينلاند إلى ألاسكا)",
 "bunchgrass": "عشب عنقودي (أي من أعشاب مختلفة من أجناس عديدة تنمو في خصلات أو كتل بدلاً من تشكيل بساط عشبي؛ توجد بشكل رئيسي في غرب الولايات المتحدة)",
 "bunchy": "عُنْقُودِيّ, مُتَجَمِّعٌ فِي حُزَمٍ (يَحْدُثُ مُتَقَارِبًا فِي عَنَاقِيدَ أَوْ حُزَمٍ)",
 "bunco": "احتيال, خديعة الثقة (عملية نصب تغش فيها في القمار أو تقنع شخصاً بشراء ممتلكات لا قيمة لها)",
 "bunco game": "احتيال, خديعة الثقة (عملية نصب تغش فيها في القمار أو تقنع شخصاً بشراء ممتلكات لا قيمة لها)",
 "buncombe": "سَخَافَة, كَذِب (سلوك غير مقبول (خاصة التصريحات الكاذبة بشكل مثير للسخرية))",
 "bundesbank": "البنك الاتحادي الألماني, بوندسبنك (البنك المركزي لألمانيا)",
 "bundle": "إِبَالَة, حُزْمَة",
 "bundle of his": "حزمة أذينية بطينية, حزمة هيس (حزمة من عضلة القلب المعدلة تنقل النبض القلبي من العقدة الأذينية البطينية إلى البطينين مسببة انقباضهما)",
 "bundled-up": "مُتَدَثِّر (مرتدٍ ملابس دافئة)",
 "bundling": "دفع بعجالة (فعل الدفع بعجالة) / تحزيم (عملية ربط شيء ما في حزمة) / المبيت معاً (عادة قديمة أثناء التودد تتمثل في نوم الزوجين غير المتزوجين في نفس السرير بملابسهما)\nمثال: اشتكت من دفع الأطفال بعجالة إلى المدرسة",
 "bunfight": "حفل شاي صاخب, حفلة رسمية ((عامية بريطانية) حفلة رسمية كبيرة في مناسبة مهمة)",
 "bung": "سدادة برميل (سدادة تستخدم لإغلاق ثقب في برميل أو قارورة)",
 "bungaloid": "بنغالي الطراز (يتميز ببيوت البنغالو)\nمثال: الضواحي المليئة ببيوت البنغالو",
 "bungalow": "بنغالو, كوخ (منزل صغير من طابق واحد)",
 "bungarus fasciatus": "كرايت مخطط (كرايت بطيء الحركة مخطط بالأسود والأصفر)",
 "bungee": "حبل بانجي, حبل مطاطي ((حَبَلَه): شَدّه بالحبْل؛ (حَبَلَه) الصَّيْدَ: نَصَب لَهُ الحِبَالةَ وصاده بهَا. وَيُقَال: حَبَلَت فُلَانَةُ فلَانًا: أوقعَتْه فِي شِباك حُبّها وسحَرته)\nمثال: حبل الكذب قصير.",
 "bungee cord": "حبل بانجي, حبل مطاطي ((حَبَلَه): شَدّه بالحبْل؛ (حَبَلَه) الصَّيْدَ: نَصَب لَهُ الحِبَالةَ وصاده بهَا. وَيُقَال: حَبَلَت فُلَانَةُ فلَانًا: أوقعَتْه فِي شِباك حُبّها وسحَرته)\nمثال: حبل الكذب قصير.",
 "bunghole": "ثقب السدادة, فتحة البرميل (ثقب في برميل؛ يستخدم لملئه أو تفريغه) / ثقب المؤخرة (مصطلح عامي مبتذل للشرج)",
 "bungle": "خطأ فادح, زلة (خطأ محرج)",
 "bungled": "خَرْبَان, مُفْسَد (أُفسِد بسبب عدم الكفاءة أو الخُرق)",
 "bungler": "أخرق, فاشل (شخص يرتكب أخطاء بسبب عدم الكفاءة)",
 "bunglesome": "صَعْب التَّنَاوُل, مُرْبِك الشَّكْل (صعب المناولة أو الإدارة خاصّةً بسبب شكله)",
 "bungling": "أَخْرَق اليَدَيْن, ثَقِيل اليَد (يفتقر إلى مهارات الحركة الجسدية وخاصة في استخدام اليدين) / أَخْرَق, غَيْرُ كُفْء (يُظهر افتقارًا إلى المهارة أو الكفاءة)",
 "bunion": "إبهام أفحج, وكعة (تضخم مؤلم في الجراب الزلالي للمفصل الأول لإبهام القدم)",
 "bunji-bunji": "بونجي بونجي, فليندرسية شوتية (شجرة خشبية أسترالية ينتج لحاؤها سماً)",
 "bunk": "سرير سفينة, سرير قطار (سرير على متن سفينة أو قطار؛ عادة ما يكون في طبقات) / سرير بسيط, مضجع (سرير خشن الصنع (كما في موقع التخييم)) / معلف طويل (حوض طويل لتغذية الماشية) / سرير بطابقين (أسرّة مبنية فوق بعضها البعض)",
 "bunk bed": "سَرِير بِطَابَقَيْن (قطعة أثاث للنوم والاستلقاء والجلوس؛ مسطبة من الخشب المزيَّن يوضع عليه كرسي، يغلب على ما تحت عرش الملك)\nمثال: قاس طول السرير.",
 "bunker": "مَخْبَأ, قَبْو",
 "bunker mentality": "عقلية الحصار (موقف دفاعي ناتج عن الهجمات المتكررة)\nمثال: بعد العديد من التفجيرات الانتحارية، يجب على الإسرائيليين مقاومة تطوير عقلية الحصار",
 "bunkmate": "رفيق المنامة, زميل الغرفة (شخص يشاركك نفس أماكن النوم)",
 "bunko": "احتيال, خديعة الثقة (عملية نصب تغش فيها في القمار أو تقنع شخصاً بشراء ممتلكات لا قيمة لها)",
 "bunko game": "احتيال, خديعة الثقة (عملية نصب تغش فيها في القمار أو تقنع شخصاً بشراء ممتلكات لا قيمة لها)",
 "bunkum": "سَخَافَة, كَذِب (سلوك غير مقبول (خاصة التصريحات الكاذبة بشكل مثير للسخرية))",
 "bunny": "خَرْنَق (ولدُ الأَرنب)",
 "bunny girl": "نادلة باني (نادلة شابة في ملهى ليلي يتضمن زيها ذيل وأذني أرنب)",
 "bunny hug": "باني هاغ (رقصة صالونات متزامنة كانت شائعة سابقاً في الولايات المتحدة)",
 "bunny rabbit": "أرنب صغير, أرنوب ((عادة غير رسمي) خاصة أرنب صغير)",
 "buns": "أرداف, ألية (الجزء اللحمي من جسم الإنسان الذي يجلس عليه)\nمثال: يستحق ركلة جيدة في مؤخرته",
 "bunsen": "موقد بنسن (موقد غاز يستخدم في المختبرات؛ يحتوي على صمام هواء لتنظيم خليط الغاز والهواء)",
 "bunsen burner": "مَوْقِد بُنْسِن",
 "bunt": "بانت, نكزة ((بيسبول) فعل ضرب كرة البيسبول بخفة عن طريق تثبيت المضرب في وضع ثابت بدلاً من أرجحته) / تفحم نتن, تيليتيا كاريس (فطر يدمر حبات القمح عن طريق استبدالها بكتل دهنية من الأبواغ كريهة الرائحة) / تفحم نتن, تيليتيا فوئتيدا (مشابه لتيليتيا كاريس) / تفحم نتن (مرض يصيب القمح يتميز باستبدال الحبوب بكتل دهنية من أبواغ التفحم ذات الرائحة الكريهة)",
 "buntal": "ألياف البونتتال (ألياف بيضاء ناعمة فلبينية من سيقان أوراق نخيل التاليبوت غير المتفتحة؛ تستخدم في صنع القبعات)",
 "bunter": "ضارب الكرة برفق, مُنت",
 "bunting": "درسة (أي من الطيور المغردة آكلة البذور العديدة في أوروبا أو أمريكا الشمالية) / قماش الأعلام (قماش فضفاض النسج يستخدم للأعلام، إلخ)",
 "buntline coil": "لفة الحبل (لفة أساسية لتخزين الحبل)\nمثال: اربط حبلك في لفة لمنعه من التشابك",
 "bunya bunya": "بونيا بونيا (جوز طعمه مثل الكستناء المحمص؛ طعام أساسي للسكان الأصليين الأستراليين) / بونيا بونيا (صنوبرية أسترالية تحمل بذوراً بحجم بوصتين طعمها مثل الكستناء المحمصة؛ بين السكان الأصليين تعتبر الشجرة ملكية وراثية محمية بالقانون)",
 "bunya bunya tree": "بونيا بونيا (صنوبرية أسترالية تحمل بذوراً بحجم بوصتين طعمها مثل الكستناء المحمصة؛ بين السكان الأصليين تعتبر الشجرة ملكية وراثية محمية بالقانون)",
 "bunyaviridae": "الفيروسات البونية, بونيافيريدي (فصيلة كبيرة من الفيروسات المنقولة بالمفصليات التي تصيب مجموعة واسعة من العوائل (بشكل رئيسي الفقاريات ومفصليات الأرجل))",
 "bunyavirus": "بونيافيروس, فيروس بوني (فيروس حيواني ينتمي إلى فصيلة الفيروسات البونية؛ يمكن استخدامه سلاحاً بيولوجياً)",
 "buoy": "شَمَنْدُورَة / عَوَّامَة",
 "buoyancy": "طَفْو, طُفُوّ",
 "buoyant": "حَيَوِيّ, نَشِيط (يتّسم بالحيويّة وخفّة الروح) / طافٍ, عائِم (يَميل إلى الطُّفُوّ عَلى السَّائِل أو الارْتِفاع في الهَواء)",
 "buoyantly": "بِانْشِرَاح, بِتَفَاؤُل (بطريقة مبهجة ومتفائلة)\nمثال: قبلنا الفرصة بانشراح",
 "buphthalmum salicifolium": "عين الثور الحرجية (نبات أوراسي معمر مشعر ذو أقحوانات صفراء داكنة على سيقان صفصافية متراخية؛ يوجد في البرية في الغابات المفتوحة وعلى المنحدرات الصخرية)",
 "bur": "ريشة حفر صغيرة, سنبُك حفر (ريشة صغيرة تستخدم في طب الأسنان أو الجراحة) / ثَمَرَة شَائِكَة, حَسَك (وعاء بذور يحتوي على خطافات أو أشواك)",
 "bur grass": "سينشروس, عشب الحسك (عشب من جنس سينشروس)",
 "bur marigold": "حسك السيدة, قواض (أي من عدة نباتات من جنس بايدنس لها زهور صفراء وثمار شائكة تلتصق بالفراء والملابس)",
 "bur oak": "سنديان كبير الثمار (سنديان نفضي متوسط إلى كبير الحجم موطنه وسط وشرق أمريكا الشمالية، له بلوط بيضوي مغمور بعمق في أقماع كبيرة مهدبة؛ ينتج خشباً قوياً ناعم الحبيبات)",
 "bur reed": "إسبارغانيون, قيصوب (نبات مستنقعات له أوراق خطية طويلة وثمار مستديرة شائكة)",
 "bura": "بورا (لغة تشادية يتم التحدث بها جنوب بحيرة تشاد، وخاصة في ولاية بورنو)",
 "bura language": "بورا (لغة تشادية يتم التحدث بها جنوب بحيرة تشاد، وخاصة في ولاية بورنو)",
 "burberry": "معطف بربري (معطف واق من المطر خفيف الوزن بحزام، مصنوع عادة من الجبردين الأسمر مع بطانة مميزة بنقشة الترتان؛ سمي باسم المصنع الأصلي)",
 "burbling": "فَيَّاض, مُتَدَفِّق (يُعبَّر عنه بحماسة غير مقيّدة)",
 "burbly": "فَيَّاض, مُتَدَفِّق (يُعبَّر عنه بحماسة غير مقيّدة)",
 "burbot": "بربوط (قد مياه عذبة ممدود في شمال أوروبا وآسيا وأمريكا الشمالية له زوائد حول فمه)",
 "burchell's zebra": "حمار الزرد الشائع (يعيش في سهول وسط وشرق أفريقيا)",
 "burden": "حِمْل, عِبْء (رَفَعَ، أَقَلَّ)\nمثال: حمل سامي سلاحه.",
 "burden of proof": "عِبْء الإثْبات, عِبْء البَيِّنة (عِبْء: اسم؛ الحمل الثقيل. \"يحمل على كاهله عبأً\") / التزام بتقديم الدليل, التزامات بتقديم الدليل",
 "burdened": "مُثْقَل, مُحَمَّل (يحمل عبئاً مادياً ثقيلاً) / مثقل بالأعباء, مرهق (يتحمل عبئاً ثقيلاً من العمل أو الصعوبات أو المسؤوليات)\nمثال: كانت تشعر دائماً بأنها مثقلة بعبء العمل الورقي",
 "burdenless": "بِلَا عِبْء, خَفِيفُ الحِمْل (غير مُثقَل بحمل مادّي)",
 "burdensome": "شاقّ, مُرْهِق (صَعْب التَّحَمُّل؛ يُسَبِّب إرْهاقًا وعَناءً)",
 "burdensomeness": "ثقل, وطأة (صعوبة ثقيلة غير مرغوب فيها)",
 "burdock": "أرقطيون, رأس الحمامة (أي من عدة أعشاب ثنائية الحول قائمة من أوراسيا المعتدلة، لها جذور وتدية قوية وتنتج ثماراً شائكة)",
 "burdwan": "بُرْدُوَان",
 "bureau": "مَكْتَب (الموضع الذي يُكتَب عليه. بعكس المَكْتَب الذي يكتب فيه؛ مِنْضَدَة مخصصة للكتابة، سواء كانت للمَكَاتِب أم لغيرها)\nمثال: عاد إلى المكتب.",
 "bureau de change": "صِرَافَة اَلْعُمْلَات, مَكْتَب صِرَافَة",
 "bureau of alcohol tobacco and firearms": "مكتب الكحول والتبغ والأسلحة النارية (وكالة إنفاذ القانون وتحصيل الضرائب التابعة لوزارة الخزانة التي تطبق القوانين الفيدرالية المتعلقة بمنتجات الكحول والتبغ والأسلحة النارية والمتفجرات…)",
 "bureau of customs": "مصلحة الجمارك, مكتب الجمارك (وكالة تابعة لوزارة الخزانة تطبق تعريفات الاستيراد)",
 "bureau of diplomatic security": "مكتب الأمن الدبلوماسي (المكتب في وزارة الخارجية المسؤول عن أمن الدبلوماسيين والسفارات في الخارج)",
 "bureau of engraving and printing": "مكتب النقش والطباعة (وكالة تابعة لوزارة الخزانة تنتج العملة)",
 "bureau of intelligence and research": "مكتب الاستخبارات والبحوث (وكالة تعد المصدر الرئيسي في وزارة الخارجية للتحليلات التفسيرية للتطورات العالمية ونقطة محورية لقضايا السياسة وأنشطة مجتمع الاستخبارات)",
 "bureau of justice assistance": "مكتب المساعدة القضائية (المكتب في وزارة العدل الذي يساعد أنظمة العدالة الجنائية المحلية لتقليل أو منع الجريمة والعنف وتعاطي المخدرات)",
 "bureau of justice statistics": "مكتب إحصاءات العدالة (الوكالة في وزارة العدل التي تعد المصدر الرئيسي لإحصاءات العدالة الجنائية لصانعي السياسات الفيدراليين والمحليين)",
 "bureau of the census": "مكتب الإحصاء (مكتب وزارة التجارة المسؤول عن إجراء التعداد السكاني؛ يوفر معلومات وتحليلات ديموغرافية حول سكان الولايات المتحدة)",
 "bureaucracy": "بِيرُقْرَاطِيَّة",
 "bureaucrat": "بِيرُوقْرَاطِيّ",
 "bureaucratic": "بيروقراطي (من أو متعلق أو يشبه البيروقراطي أو البيروقراطية)\nمثال: أزعج سلوكه البيروقراطي زملاءه",
 "bureaucratic procedure": "روتين, روتين بيروقراطي (إجراء يستهلك وقتاً طويلاً بلا داع)",
 "bureaucratically": "بِيرُوقْرَاطِيًّا (فيما يتعلق بالبيروقراطية) / بِشَكْل بِيرُوقْرَاطِيّ (بطريقة بيروقراطية)\nمثال: إنها معقدة بيروقراطياً",
 "bureaucratism": "بيروقراطية (مسؤولون حكوميون غير منتخبين)",
 "burek": "بُورَك, بُورِيك",
 "buret": "سحاحة (أداة قياس تتكون من أنبوب زجاجي مدرج مع صنبور في الأسفل؛ تستخدم للمعايرة)",
 "burette": "سَحَّاحَة",
 "burg": "بلدة صغيرة (مصطلح أمريكي عامي لبلدة)\nمثال: لقد عشت في هذه البلدة طوال حياتي",
 "burgas": "بورغاس",
 "burgeoning": "رَائِج, مُزْدَهِر (حيوي ومربح للغاية؛ في حالة ازدهار ونمو)",
 "burger": "بُورْجَر, بُرْغَر",
 "burgess": "مواطن (مواطن في بلدة إنجليزية)",
 "burgh": "بلدة إسكتلندية (بلدة تتمتع بحكم ذاتي في اسكتلندا)",
 "burgher": "برجوازي, من الطبقة المتوسطة (عضو في الطبقة المتوسطة) / مواطن (مواطن في بلدة إنجليزية)",
 "burglar": "لص منازل (لص يدخل مبنى بقصد السرقة)",
 "burglar alarm": "إنذار سرقة (جهاز تحذير ينطلق عند حدوث عملية سطو) / إنذار السرقة (إشارة تحذير عالية يصدرها جهاز إنذار السرقة)\nمثال: كان بإمكانهم سماع إنذار السرقة من مسافة ميل",
 "burglarious": "سطوي, لصوصي (ينطوي على أو يشبه السطو)\nمثال: أدوات السطو",
 "burglarproof": "مَانِع لِلسَّرِقَة (مُؤمَّن ضدّ السطو والسرقة)",
 "burglary": "سَطْو / لُصُوصِيَّة",
 "burgomaster": "عمدة (عمدة بلدية في ألمانيا أو هولندا أو فلاندرز أو النمسا)",
 "burgoo": "برغو (يخنة حارة كثيفة من أي لحم وأي خضروات متوفرة؛ جنوب الولايات المتحدة) / برغو (تجمع يتم فيه تقديم يخنة البرغو) / دقيق الشوفان, عصيدة الشوفان (عصيدة مصنوعة من رقائق الشوفان)",
 "burgrass": "سينشروس, عشب الحسك (عشب من جنس سينشروس)",
 "burgrave": "حاكم قلعة (الحاكم العسكري لبلدة ألمانية في القرنين الثاني عشر والثالث عشر) / حاكم قلعة (نبيل يحكم قلعة ألمانية والأراضي المحيطة بها بحق وراثي)",
 "burgundy": "بُرْجَنْدِي",
 "burgundy sauce": "بورغينيون (نبيذ أحمر مختزل مع بصل وبقدونس وزعتر وزبدة)",
 "burgundy wine": "بورغوندي, نبيذ بورغوندي (نبيذ مائدة أحمر من منطقة بورغوندي بفرنسا (أو أي نبيذ مشابه مصنوع في مكان آخر))",
 "burhinus oedicnemus": "كروان الحصى (طائر شاطئي كبير الرأس والعينين ينشط عند الغسق أو ليلاً من العالم القديم وأمريكا الاستوائية وله مفصل ركبة سميك)",
 "burial": "دَفْن, تَدْفِين (دَفَنَهُ يَدْفِنُهُ: سَتَرَهُ، وواراه)\nمثال: دفن القط فضلاته.",
 "burial chamber": "حجرة الدفن, ضريح (حجرة تُستخدم كقبر)",
 "burial garment": "رداء الدفن (قماش يستخدم لتغطية الجثة استعداداً للدفن)",
 "burial ground": "جبانة, مدفن (قطعة أرض تستخدم للدفن)",
 "burial mound": "تل مدفني, رابية الدفن ((في علم الآثار) كومة من التراب توضع فوق مقابر ما قبل التاريخ)",
 "burial site": "جبانة, مدفن (قطعة أرض تستخدم للدفن)",
 "burial vault": "قبو, مقبرة قبوية (حجرة دفن (عادة تحت الأرض))",
 "buried": "مَدْفُون / دَفِين",
 "burin": "منقاش, مِزمَل (إزميل من الفولاذ المقسى ذو طرف حاد؛ يستخدم للنقش)",
 "burj khalifa": "بُرْج خَلِيفَة (ظهر وارتفع)\nمثال: وصل كارل إلى برج آخر.",
 "burka": "برقع (رداء فضفاض (عادة مع فتحات مغطاة للعينين) ترتديه النساء المسلمات خاصة في الهند وباكستان)\nمثال: أجبرت طالبان جميع النساء على ارتداء البرقع",
 "burkina faso": "بُورْكِينَا فَاسُو",
 "burkina faso franc": "فرنك بوركينا فاسو (وحدة المال الأساسية في بوركينا فاسو)",
 "burl": "تكتل, عقدة (كتلة ناعمة أو عدم استواء في خيط؛ إما عيب أو مخلوق بالتصميم) / عجرة, عقدة خشبية (نتوء دائري كبير على جذع أو فرع شجرة) / عقدة خشبية (الخشب المقطوع من عقدة شجرة أو نمو؛ يستخدم غالباً بشكل زخرفي في القشرة)",
 "burlap": "خيش (قماش الجوت الخشن)",
 "burlap bag": "خيشة, كيس خيش (كيس مصنوع من الخيش)",
 "burled": "مُعَقَّد الأَلْيَاف ((في الخشب) ذو نقش ناتج عن عُقد الشجرة)",
 "burlesque": "عَرْض مَسْرَحِيّ هَزْلِيّ (أتى العروض، أي مكّة والمدينة وما حولهما؛ الفَرَسَ: سار به بالعُرض)\nمثال: قبل كلاي العرض.",
 "burly": "ضَخْمُ البِنْيَة, مَفْتُول (عضليّ وثقيل البنية)",
 "burma": "بُورْمَا",
 "burma padauk": "بادوك بورما, خشب الورد البورمي (شجرة من الهند وبورما تنتج خشباً يشبه الماهوجني)",
 "burmeisteria retusa": "مدرع قزم كبير (نوع من المدرع يعيش في جنوب أمريكا الجنوبية)",
 "burmese": "بُورْمِيّ",
 "burmese cat": "قط بورمي (سلالة قصيرة الشعر بجسم مشابه للقط السيامي ولكن بمعطف بني داكن أو رمادي صلب)",
 "burmese language": "اللغة البورمية (اللغة الرسمية لبورما)",
 "burmese rosewood": "بادوك بورما, خشب الورد البورمي (شجرة من الهند وبورما تنتج خشباً يشبه الماهوجني)",
 "burmese-yi": "لغات لولو-بورمية (لغة تبتية بورمية يتم التحدث بها في شمال بورما ويونان)",
 "burmese-yi language": "لغات لولو-بورمية (لغة تبتية بورمية يتم التحدث بها في شمال بورما ويونان)",
 "burn": "حَرْق (الفعل له عدة معانٍ تتعلق بالتأثير والتلف، منها: برد الحديد، حكّ الأنياب، إتلاف الثوب بالدق، وحرق الشيء بالنار؛ إتلاف شيء ما بالنار أو بأداة حادة، كما يشمل المعنى المجازي للألم الشديد والحزن الذي يُؤثر في القلب) / سَفْعَة / حُرق (الفعل له عدة معانٍ تتعلق بالتأثير والتلف، منها: برد الحديد، حكّ الأنياب، إتلاف الثوب بالدق، وحرق الشيء بالنار؛ إتلاف شيء ما بالنار أو بأداة حادة، كما يشمل المعنى المجازي للألم الشديد والحزن الذي يُؤثر في القلب) / أَحْرَقَ (أحرقت النار الشيءَ: حرقته؛ أحرقَ الشيءَ: أهلكه) / حَرَقَ (الفعل له عدة معانٍ تتعلق بالتأثير والتلف، منها: برد الحديد، حكّ الأنياب، إتلاف الثوب بالدق، وحرق الشيء بالنار؛ إتلاف شيء ما بالنار أو بأداة حادة، كما يشمل المعنى المجازي للألم الشديد والحزن الذي يُؤثر في القلب) / ضَرِمَ / حرق (الفعل له عدة معانٍ تتعلق بالتأثير والتلف، منها: برد الحديد، حكّ الأنياب، إتلاف الثوب بالدق، وحرق الشيء بالنار؛ إتلاف شيء ما بالنار أو بأداة حادة، كما يشمل المعنى المجازي للألم الشديد والحزن الذي يُؤثر في القلب) / وَلَّع\nمثال: قامت ليلى بحرق كل كتب آرت المتعلقة بالأدب العنصري.",
 "burn bag": "كيس حرق الوثائق (كيس توضع فيه الوثائق السرية قبل حرقها)",
 "burn center": "مركز الحروق (مركز يمكن فيه علاج المرضى الذين يعانون من حروق شديدة)",
 "burn mark": "أثر حرق, حرق (مكان أو منطقة تم حرقها (خاصة على جسم الشخص))",
 "burn one's bridges": "حَرَقَ اَلسُّفُن, قَطَعَ اَلْجُسُور (الفعل له عدة معانٍ تتعلق بالتأثير والتلف، منها: برد الحديد، حكّ الأنياب، إتلاف الثوب بالدق، وحرق الشيء بالنار؛ إتلاف شيء ما بالنار أو بأداة حادة، كما يشمل المعنى المجازي للألم الشديد والحزن الذي يُؤثر في القلب)\nمثال: قامت ليلى بحرق كل كتب آرت المتعلقة بالأدب العنصري.",
 "burn plant": "ألو فيرا, صبار (نبات قصير الساق جداً ذو أوراق سميكة بعصير مخاطي مهدئ؛ تطور الأوراق حواف شائكة عند النضج؛ موطنه منطقة البحر الأبيض المتوسط؛ يزرع على نطاق واسع في…)",
 "burn the candle at both ends": "حرق الشمعة من كلتا طرفيها (الفعل له عدة معانٍ تتعلق بالتأثير والتلف، منها: برد الحديد، حكّ الأنياب، إتلاف الثوب بالدق، وحرق الشيء بالنار؛ إتلاف شيء ما بالنار أو بأداة حادة، كما يشمل المعنى المجازي للألم الشديد والحزن الذي يُؤثر في القلب)\nمثال: قامت ليلى بحرق كل كتب آرت المتعلقة بالأدب العنصري.",
 "burn the midnight oil": "أشعل فانوس الليل ((أَشْعَلَ) النارَ: شَعَلها؛ يقال أَشْعَلَ فلانًا: هيَّج غَضبَه)\nمثال: أشعل كين الشمع.",
 "burnability": "قابلية الاحتراق, قابلية الاشتعال (صفة القدرة على الاشتعال والاحتراق)",
 "burnable": "قَابِل لِلإِشْعَال, قَابِل لِلْحَرْق (يمكن أن يحترق)",
 "burned": "مَحْرُوق, مُحْتَرِق (أُفْسِدَ بِالإِفْرَاطِ فِي الطَّهْو) / مَحْرُوق, مُحْتَرِق (دُمِّرَ أَوْ تَضَرَّرَ بِشِدَّةٍ بِسَبَبِ النَّار) / مَحْرُوقٌ, مُكَلَّسٌ (مُعَالَج بالتسخين إلى درجة حرارة عالية دون بلوغ نقطة الانصهار)",
 "burned-out": "مَحْرُوق, مُحْتَرِق (دُمِّرَ أَوْ تَضَرَّرَ بِشِدَّةٍ بِسَبَبِ النَّار) / تَالِف بِالحَرَارَة, مُحْتَرِق (معطّل نتيجة الحرارة أو الاحتكاك) / مُحْتَرِق, مُسْتَنْزَف (مُنْهَكٌ نَتِيجَةَ ضَغْطٍ طَوِيلِ الأَمَد)",
 "burned-over": "مَحْرُوق, مُحْتَرِق (دُمِّرَ أَوْ تَضَرَّرَ بِشِدَّةٍ بِسَبَبِ النَّار)",
 "burner": "حَرَّاق, موقد (جهاز لحرق الوقود (أو النفايات)) / شعلة, عين الموقد (عناصر التسخين في الموقد التي توضع عليها الأواني والمقالي للطهي)\nمثال: محرك الديزل هو حراق زيت",
 "burnet bloodwort": "بوطيريوم, عشبة الدم (عشب حدائق أوروبي بأزهار مشوبة بالأرجواني وأوراق تستخدم أحياناً للسلطات)",
 "burning": "احتراق, حرق (عملية حرق شيء ما) / حرق (شكل من أشكال التعذيب تستخدم فيه السجائر أو السيجار أو أدوات ساخنة أخرى لحرق جلد الضحية) / حرق, حرق على الخازوق (الإعدام بالنار) / صعق كهربائي (الإعدام بالكهرباء)\nمثال: حرق الأوراق كان ممنوعاً بموجب مرسوم المدينة",
 "burning at the stake": "حرق, حرق على الخازوق (الإعدام بالنار)",
 "burning bush": "سرو صيفي, شجيرة النار (نبات أوراسي كثيف التفرع؛ تتحول أوراقه إلى اللون الأحمر الأرجواني في الخريف) / ديكتامنيوس, شجيرة محترقة (عشب معمر أوراسي بأزهار بيضاء تبعث بخاراً قابلاً للاشتعال في الطقس الحار) / شجيرة محترقة, غدب أرجواني (شجيرة نفضية لها كبسولات أرجوانية تحيط ببذور قرمزية) / العليقة المشتعلة ((العهد القديم) الشجيرة التي اشتعلت دون أن تحترق والتي كلم الله موسى منها)",
 "burnish": "رَزَّزَ ((رَزَّزَه): ثَبَّتَه؛ (رَزَّزَه) وطأه ومهده يُقَال: رززت أَمرك عِنْد فلَان ورززت لَك الْأَمر)",
 "burnished": "بَرَّاق, لَمَّاع (جُعل ناعماً ولامعاً كما لو بالحكّ؛ يعكس بريقاً أو توهجاً)",
 "burnisher": "أداة صقل, مِصْقَلَة (أداة يدوية ذات أطراف من العقيق المصقول (أو أحجار كريمة أخرى) لفرك ورق الذهب من أجل الحصول على سطح مصقول للغاية، تستخدم في التذهيب)",
 "burnishing tool": "أداة صقل, مِصْقَلَة (أداة يدوية ذات أطراف من العقيق المصقول (أو أحجار كريمة أخرى) لفرك ورق الذهب من أجل الحصول على سطح مصقول للغاية، تستخدم في التذهيب)",
 "burnoose": "بُرْنُس",
 "burnous": "برنس (عباءة طويلة بغطاء رأس منسوجة من الصوف في قطعة واحدة؛ يرتديها العرب والمغاربة)",
 "burnouse": "برنس (عباءة طويلة بغطاء رأس منسوجة من الصوف في قطعة واحدة؛ يرتديها العرب والمغاربة)",
 "burnside": "سَالِف (شعر الوجه الذي نما على جانب وجه الرجل أمام الأذنين (خاصة عندما تحلق بقية اللحية))",
 "burnt": "مَحْرُوق, مُحْتَرِق",
 "burnt lime": "أكسيد الكالسيوم, الجير الحي (أكسيد بلوري أبيض يستخدم في إنتاج هيدروكسيد الكالسيوم)",
 "burnt sienna": "بني داكن, بني محمر (درجة من البني مع مسحة من الأحمر) / سيينا محروقة (صبغة بنية محمرة تنتج عن تحميص السيينا)",
 "burnt umber": "بني قهوة, بني محروق (لون بني متوسط إلى بني داكن) / أمبر محروق (صبغة بنية داكنة يتم الحصول عليها عن طريق تسخين الأمبر)",
 "burnt-out": "مَحْرُوق, مُحْتَرِق (دُمِّرَ أَوْ تَضَرَّرَ بِشِدَّةٍ بِسَبَبِ النَّار) / تَالِف بِالحَرَارَة, مُحْتَرِق (معطّل نتيجة الحرارة أو الاحتكاك) / مُحْتَرِق, مُسْتَنْزَف (مُنْهَكٌ نَتِيجَةَ ضَغْطٍ طَوِيلِ الأَمَد)",
 "burnup": "احتراق الوقود (كمية الوقود المستهلكة (كما في المفاعل النووي)) / سباق سريع (سباق دراجات نارية عالي السرعة على طريق عام)",
 "burp": "تَجَشُّؤ / تَجَشَّأَ",
 "burp gun": "رشاش قصير, مسدس رشاش (مسدس آلي بالكامل؛ رشاش خفيف صغير الحجم)",
 "burping": "تجشؤ (منعكس يطرد الغازات بصوت عالٍ من المعدة عبر الفم)",
 "burqa": "بُرْقُع (قِنَاع تستر به المرأة وجهها. غِطَاء ٱلْوَجْهِ؛ قناع للدَّوَابِ)",
 "burqini": "بُرْكِينِي",
 "burr": "ريشة حفر صغيرة, سنبُك حفر (ريشة صغيرة تستخدم في طب الأسنان أو الجراحة) / رايش, نتوء خشن (نتوء خشن يتبقى على قطعة العمل بعد الحفر أو القطع) / ريشة حفر, مبرد دوار (مبرد دوار لتنعيم الحواف الخشنة المتبقية على قطعة العمل) / ثَمَرَة شَائِكَة, حَسَك (وعاء بذور يحتوي على خطافات أو أشواك)",
 "burr drill": "مثقاب طبيب الأسنان (مثقاب عالي السرعة يستخدمه أطباء الأسنان للحفر في الأسنان)",
 "burr marigold": "حسك السيدة, قواض (أي من عدة نباتات من جنس بايدنس لها زهور صفراء وثمار شائكة تلتصق بالفراء والملابس)",
 "burr oak": "سنديان كبير الثمار (سنديان نفضي متوسط إلى كبير الحجم موطنه وسط وشرق أمريكا الشمالية، له بلوط بيضوي مغمور بعمق في أقماع كبيرة مهدبة؛ ينتج خشباً قوياً ناعم الحبيبات)",
 "burr-headed": "خَشِن الرَّأْس, قَصير الشَّعْر (ذو شَعْر مُسْتَقيم مَقْصوص قَصيرًا جِدًّا فَيَبْدو خَشِنًا)",
 "burrata": "بُورَّاتَا, بُرَّاتَا",
 "burrawong": "بوراوانغ, ماكروزاميا شائعة (سيكاد جذاب كبير يشبه النخيل دائم الخضرة من نيو ساوث ويلز)",
 "burred": "ذُو أَشْوَاك, شَائِك (يحمل أشواكًا أو إبرًا أو شعيرات واقية أو مُغطَّى بها)",
 "burrfish": "سمكة بورفيش (أي من عدة أسماك لها أشواك مسطحة صلبة)",
 "burrito": "بوريتو (تورتيلا دقيق مطوية حول حشوة)",
 "burrlike": "شائك (يشبه الشوكة؛ خاصة في كونه شائكاً)",
 "burro": "بورو (حمار صغير يستخدم كحيوان حمل)",
 "burro deer": "أيل البغل (أيل طويل الأذنين يعيش في غرب أمريكا الشمالية وله قرون ذات شعبتين)",
 "burrow": "جُحْر, سَرَب (معنى الفعل \"جَحَرَ\" متعدد: يدل على دخول الجحر (للضب مثلاً)، أو تأخر وتخلّف (للخير أو الحيوان أو العام -بمعنى قلة مطره-)…؛ يُشيرُ الفعل معانٍ مُتعدِّدة بحسب سياقه، منها: الدخول في شيء (مثل دخول الضبّ جُحْره)، وإدخال شيء في شيء آخر، والارتفاع (كارتفاع الشمس)…)\nمثال: ادخل إلى ذلك الجحر.",
 "burry": "ذُو أَشْوَاك, شَائِك (يحمل أشواكًا أو إبرًا أو شعيرات واقية أو مُغطَّى بها)",
 "bursa": "بُورْصَة",
 "bursa omentalis": "تجويف بريتوني أصغر, جراب ثربي (جزء معزول من التجويف البريتوني يقع ظهرياً بالنسبة للمعدة)",
 "bursal": "جرابي (يتعلق بـ أو يؤثر على الجراب (كيس مفصلي))",
 "bursar": "أمين صندوق الكلية (أمين الصندوق في كلية أو جامعة)",
 "bursary": "خزانة المؤسسة (خزانة مؤسسة عامة أو نظام ديني)",
 "bursera microphylla": "بورسيرا صغيرة الأوراق, شجرة الفيل (شجرة صغيرة أو شجيرة توجد في جنوب غرب الولايات المتحدة، تتميز برائحة حارة وأوراق ريشية فردية وعناقيد صغيرة من الزهور البيضاء)",
 "bursera simaruba": "بورسيرا سيماروبا, غامبو ليمبو (شجرة أمريكية استوائية تنتج راتنجاً محمر اللون يستخدم في الأسمنت والورنيش)",
 "bursiform": "جِرَابِيُّ الشَّكْل, كِيسِيّ (على شكل جراب أو كيس)",
 "bursitis": "اِلْتِهَاب جِرَاب",
 "burst": "انفجار (عملية الانفجار أو التفرقع) / فورة, نوبة (فورة مفاجئة من النشاط (غالباً لسبب غير واضح)) / رشقة, صلية (إطلاق نار سريع ومتزامن للأسلحة النارية) / اندلاع, انفجار (حدث مفاجئ ومكثف)\nمثال: انفجار الألعاب النارية أيقظ الأطفال",
 "burst forth": "اِنْبَثَقَ",
 "burst into tears": "فجأة بدأ يبكي",
 "burst out": "برز, ظهر فجأة (ظهر أو حدث بشكل مفاجئ أو غير متوقع)\nمثال: ظهرت المزرعة فجأة عندما انعطفنا",
 "burster": "حشوة متفجرة, شحنة (كمية من المتفجرات يتم تفجيرها في وقت واحد)\nمثال: تحتوي هذه الخرطوشة على شحنة بارود تبلغ 50 حبة",
 "bursting charge": "حشوة متفجرة, شحنة (كمية من المتفجرات يتم تفجيرها في وقت واحد)\nمثال: تحتوي هذه الخرطوشة على شحنة بارود تبلغ 50 حبة",
 "bursting explosive": "متفجرات شديدة الانفجار, متفجرات مدمرة (مادة شديدة الانفجار تستخدم لتدمير الهدف الذي يتم مهاجمته)",
 "bursty": "متقطع, متدفق",
 "burthen": "عبء (عِبْء: اسم؛ الحمل الثقيل. \"يحمل على كاهله عبأً\")",
 "burton": "بورتون (جعة إيل إنجليزية داكنة وقوية)",
 "burundi": "بُورُنْدِي, بُورُونْدِي",
 "burundi franc": "فرنك بوروندي (وحدة المال الأساسية في بوروندي)",
 "burundian": "بوروندي (من أو متعلق أو مميز لبوروندي أو شعبها) / بُورُونْدِيّ (مواطن أو ساكن في بوروندي)\nمثال: عاصمة بوروندي",
 "burunduki": "سنجاب سيبيري (سنجاب سيبيري أرضي)",
 "burweed marsh elder": "بلسان المستنقعات الشائك (بلسان مستنقعات حولي طويل شائع في التربة الغنية الرطبة في وسط أمريكا الشمالية يمكن أن يسبب التهاب الجلد التماسي؛ ينتج الكثير من حبوب اللقاح التي تعد…)",
 "bury": "دَفَنَ (دَفَنَهُ يَدْفِنُهُ: سَتَرَهُ، وواراه) / قَبَرَ (مَدْفَنُ الإِنسان، وَجَمْعُهُ قُبُور، والمَقْبَرُ الْمَصْدَرُ)\nمثال: دفن القط فضلاته.",
 "bury the hatchet": "دَفَنَ الأَحْقَادَ (دَفَنَهُ يَدْفِنُهُ: سَتَرَهُ، وواراه)\nمثال: دفن القط فضلاته.",
 "buryatia": "بُورْيَاتْيَا",
 "burying": "دفن (إخفاء شيء تحت الأرض)",
 "burying ground": "جبانة, مدفن (قطعة أرض تستخدم للدفن)",
 "bus": "حَافِلَة, بَاص (وسيلة نَقْل للركاب) / نَاقِل\nمثال: لنذهب بالحافلة.",
 "bus company": "شركة حافلات (مرفق عام يوفر النقل المحلي بالحافلات)",
 "bus depot": "محطة حافلات (محطة طرفية تخدم ركاب الحافلات)",
 "bus driver": "سَائِق حَافِلَة",
 "bus fare": "أجرة الحافلة (الأجرة المفروضة لركوب حافلة أو ترام)",
 "bus lane": "حارة الحافلات (حارة مرورية مخصصة للحافلات فقط)",
 "bus line": "خط حافلات (منظمة مسؤولة عن تشغيل نظام نقل بالحافلات)",
 "bus network": "شبكة الناقل (طوبولوجيا شبكة يتم فيها توصيل العقد في سلسلة خطية بواسطة تسلسل خطي من النواقل)\nمثال: في شبكة الناقل، تتلقى كل محطة جميع حركة مرور الشبكة، ويكون لحركة المرور التي تولدها كل محطة أولوية إرسال متساوية",
 "bus route": "خط سير الحافلة (الطريق الذي تتبعه حافلة الركاب بانتظام)",
 "bus service": "شركة حافلات (مرفق عام يوفر النقل المحلي بالحافلات)",
 "bus station": "مَحَطَّة حَافِلَات",
 "bus stop": "مَوْقِف لِلْحَافِلَات, مَوْقِف بَاص",
 "bus terminal": "محطة حافلات (محطة طرفية تخدم ركاب الحافلات)",
 "bus ticket": "تذكرة حافلة (تذكرة صالحة لركوب الحافلة)",
 "bus topology": "طوبولوجيا الناقل (طوبولوجيا شبكة تكون مكوناتها متصلة بناقل مشترك)",
 "bus traffic": "حركة الحافلات (الحافلات القادمة والذاهبة)",
 "busan": "بُوسَان",
 "busbar": "قضيب توصيل, ناقل عمومي (موصل كهربائي يقوم بعمل اتصال مشترك بين عدة دوائر)\nمثال: يمكن لقضيب التوصيل في هذا الحاسوب نقل البيانات في أي اتجاه بين أي مكونين من مكونات النظام",
 "busboy": "مساعد نادل (عامل مطعم ذكر يجهز الطاولات ويساعد النوادل ويزيل الأطباق المتسخة)",
 "busby": "شاكو, قبعة فرو الدب (قبعة طويلة؛ يرتديها بعض الجنود البريطانيين في المناسبات الاحتفالية)",
 "buscemi": "قَلْعَة أَبِي شَامَة (المرة الواحدة من القَلْع؛ حِصْن منيع غالبا يبنى على تلّ أو جبل أو مكان عالٍ منيع)\nمثال: هو يعيش في قلعة.",
 "bush": "شُجَيْرَة, شَجَرَة",
 "bush administration": "إدارة بوش (السلطة التنفيذية في عهد الرئيس جورج دبليو بوش) / إدارة بوش (السلطة التنفيذية في عهد الرئيس جورج بوش الأب)",
 "bush baby": "جلاجو, طفل الأدغال (ليمور أفريقي ليلي رشيق طويل الذيل ذو فرو صوفي كثيف وعيون وآذان كبيرة)",
 "bush bean": "فاصولياء شجيرية (نبات فاصولياء لا يحتاج نموه الشجيري إلى دعامات)",
 "bush clover": "برسيم الشجيرة, ليسبيديزا (نباتات شجيرية أو عشبية تستخدم على نطاق واسع للعلف وتحسين التربة وخاصة التبن في جنوب الولايات المتحدة)",
 "bush hibiscus": "كركديه شجيري (شجيرة أسترالية جنوبية وغربية ذات أوراق مسننة غير مفصصة أو مفصصة بشكل ضحل وأزهار أرجوانية؛ تصنف أحياناً ضمن جنس الكركديه)",
 "bush honeysuckle": "ديرفيلا, عسلة الشجيرة (شجيرة منتشرة في شمال شرق الولايات المتحدة لها عناقيد صغيرة من الزهور الخضراء والصفراء العطرة) / عسلة الشجيرة الجنوبية (عسلة شجيرية من جنوب شرق الولايات المتحدة لها عناقيد كبيرة مزدحمة من الزهور الصفراء الكبريتية) / عسلة تترية, عسلة شجيرية (شجيرة عسلة من جنوب روسيا إلى وسط آسيا)",
 "bush jacket": "سترة سفاري (سترة فضفاضة؛ تشبه القميص بأربعة جيوب وحزام)",
 "bush lawyer": "شجيرة المحامي, محامي الأدغال (شجيرة زاحفة قوية الساق من نيوزيلندا تتسلق فوق النمو الآخر)",
 "bush league": "الدوري الفرعي, دوري الدرجة الثانية (دوري للفرق التي لا تنتمي إلى دوري رئيسي (خاصة البيسبول))",
 "bush leaguer": "لاعب دوري ثانوي, لاعب مبتدئ (لاعب في فريق بيسبول من الدوري الثانوي)",
 "bush nasturtium": "كبوسين صغير, لادن شجيري (نبات حولي بزهور صفراء عميقة أصغر من اللادن الشائع)",
 "bush pea": "بازلاء الشجيرة, ترمس كاذب",
 "bush poppy": "خشخاش شجري, خشخاش شجيري (شجيرة دائمة الخضرة من جنوب غرب الولايات المتحدة والمكسيك تزرع غالباً لأزهارها الصفراء الذهبية العطرة)",
 "bush shrike": "صرد الشجيرات (صرد أفريقي)",
 "bush tit": "قرقف الشجيرات (قرقف رمادي نشط من غرب أمريكا الشمالية)",
 "bush vetch": "بيقية السياج (بيقية أوروبية بنفسجية الزهور بسيقان رفيعة؛ توجد كعشب ضار في التحوطات)",
 "bush violet": "برواليا, بنفسج الشجيرة (أي من عدة أعشاب من جنس برواليا تزرع لزهورها الزرقاء أو البنفسجية أو البيضاء)",
 "bush willow": "صفصاف الأدغال (شجرة صغيرة متساقطة الأوراق من ترانسفال لها سنابل من الزهور الصفراء) / صفصاف الأدغال (شجرة صغيرة من جنوب أفريقيا لها زهور عطرة صفراء كريمية تنمو عادة على ضفاف الجداول)",
 "bush-cricket": "جُخْدَب, جُخْدُب",
 "bush-league": "غَيْر مُحْتَرِف, هَاوٍ (ليس من أعلى مستويات الجودة أو الرقي)",
 "bushbaby": "جلاجو, طفل الأدغال (ليمور أفريقي ليلي رشيق طويل الذيل ذو فرو صوفي كثيف وعيون وآذان كبيرة)",
 "bushbuck": "بوشبوك, ظبي الشجيرات (ظبي بعلامات بيضاء تشبه السرج وقرون ملتوية)",
 "bushel": "بوشل (مقياس جاف أمريكي يساوي 4 بيكات) / بوشل (مقياس سعة إمبراطوري بريطاني (سائل أو جاف) يساوي 4 بيكات)",
 "bushel basket": "سلة بوشل (سلة كبيرة بما يكفي لتحمل مكيال بوشل)",
 "bushido": "بوشيدو (القانون التقليدي للساموراي الياباني الذي يؤكد على الشجاعة والولاء والانضباط الذاتي والعيش البسيط)",
 "bushing": "بطانة أسطوانية, جلبة (بطانة معدنية أسطوانية تستخدم لتقليل الاحتكاك) / بطانة, جلبة عازلة (بطانة عازلة في فتحة تمر من خلالها الموصلات)",
 "bushman": "بوشمن, خويسان (صيادون وجامعو ثمار رحل يعيشون في جنوب أفريقيا) / ساكن الأحراش (ساكن ذكر في مناطق الأحراش الأسترالية)",
 "bushman's poison": "سم البوشمن, شجرة المحنة (شجيرة أو شجرة دائمة الخضرة من جنوب أفريقيا)",
 "bushperson": "ساكن الأحراش (ساكن في مناطق الأحراش الأسترالية)",
 "bushtit": "قرقف الشجيرات (قرقف رمادي نشط من غرب أمريكا الشمالية)",
 "bushwhacker": "مقاتل عصابات كونفدرالي (مقاتل عصابات كونفدرالي خلال الحرب الأهلية الأمريكية) / جبليّ, قروي ساذج (مصطلح مهين لشخص غير متطور أو ساذج (غالباً من المناطق الجبلية))",
 "bushwhacking": "مُتَرَبِّصٌ فِي كَمِين (يكمن في انتظار الفريسة أو العدوّ)",
 "bushwoman": "ساكنة الأحراش (ساكنة أنثى في مناطق الأحراش الأسترالية)",
 "bushy": "شُجَيْرِيّ, كَثِيف (يُشْبِهُ الشُّجَيْرَةَ فِي كَثَافَةِ تَفَرُّعِهِ وَانْتِشَارِه) / أَشْعَث, كَثِيفُ الشَّعْر ((لِلشَّعْرِ) كَثِيفٌ وَسَيِّئُ التَّصْفِيف)",
 "bushy aster": "أستر شجيري (نبات معمر صلب في شرق الولايات المتحدة ذو أوراق خطية صغيرة ورؤوس زهور بيضاء صغيرة عديدة)",
 "bushytail woodrat": "جرذ الخشب كثيف الذيل, جرذ جامع (أي من عدة قوارض كثيفة الذيل من جنس نيوتوما في غرب أمريكا الشمالية؛ يجمع الطعام وأشياء أخرى)",
 "busily": "بانشغال, بنشاط (بطريقة مشغولة)\nمثال: كانوا منشغلين بشراء الهدايا التذكارية",
 "business": "شَرِكَة / عَمَل, تِجَارَة (فِعْل، صُنْع؛ وسيلة للكسب، مِهْنَة، حِرْفَة) / رِعَايَة\nمثال: المهم هو العمل.",
 "business activity": "نشاط تجاري (نشاط يتم القيام به كجزء من مؤسسة تجارية)",
 "business address": "عنوان العمل (العنوان الذي يقع فيه العمل التجاري)",
 "business agent": "وكيل أعمال (وكيل يتولى الشؤون التجارية لآخر؛ خاصة من يتعامل مع أصحاب العمل)",
 "business card": "بِطَاقَة عَمَل, بِطَاقَة مُؤَسَّسَة",
 "business coaching": "تدريب الأعمال, توجيه الأعمال (نوع من التطوير الشخصي أو الموارد البشرية يقدم دعماً إيجابياً وملاحظات ونصائح لفرد أو مجموعة لتحسين فعاليتهم في بيئة العمل)\nمثال: غالباً ما يكون لدى هؤلاء الأشخاص وقت قليل جداً ويضطرون إلى وضع جلسات توجيه الأعمال الخاصة بهم بين الاجتماعات المهمة والتزامات العمل الأخرى",
 "business college": "كلية تجارة, معهد تجاري (مدرسة لتدريس الجوانب الكتابية للأعمال والتجارة)",
 "business community": "رجال الأعمال, مجتمع الأعمال (مجموعة الأفراد الذين يديرون الأعمال التجارية)",
 "business concern": "شركة, عمل تجاري (مؤسسة تجارية أو صناعية والأشخاص الذين يشكلونها)\nمثال: اشترى عمل شقيقه",
 "business cycle": "دورة اقتصادية, دورة تجارية (تقلبات متكررة في النشاط الاقتصادي تتكون من ركود وانتعاش ونمو وتراجع)",
 "business data processing": "معالجة البيانات الإدارية, معالجة بيانات الأعمال (معالجة البيانات في المحاسبة أو إدارة الأعمال)",
 "business deal": "صفقة, صفقة تجارية (حالة معينة من البيع أو الشراء)\nمثال: كانت صفقة شاملة",
 "business deduction": "خصم تجاري, خصم نفقات العمل (شطب ضريبي لنفقات ممارسة الأعمال التجارية)",
 "business department": "إدارة, قسم تجاري (قسم تابع لمؤسسة تجارية)",
