 "cardholder": "حامل الورق (لاعب يحمل ورقة أو أوراقاً في لعبة ورق) / حامل البطاقة (شخص يحمل بطاقة ائتمان أو بطاقة خصم)",
 "cardhouse": "بيت من ورق (بناء غير مستقر من أوراق اللعب)\nمثال: بنى ثلاثة مستويات من بيته الورقي قبل أن ينهار",
 "cardia": "فؤاد (الفتحة المؤدية إلى المعدة وذلك الجزء من المعدة المتصل بالمريء)",
 "cardiac": "قَلْبِيّ",
 "cardiac arrest": "سَكْتَة قَلْبِيَّة",
 "cardiac arrhythmia": "عدم انتظام ضربات القلب, لا نَظْمِيّة قلبية (معدل غير طبيعي لتقلصات العضلات في القلب)",
 "cardiac cycle": "دورة قلبية (الدورة الكاملة لأحداث القلب من بداية نبضة واحدة إلى بداية النبضة التالية؛ نبضة كهربائية تنتقل عبر عضلة القلب تؤدي إلى انقباض الأذينين يليه انقباض…)\nمثال: يمكن إظهار الدورة القلبية على مخطط كهربية القلب",
 "cardiac glucoside": "جليكوسيد قلبي (يتم الحصول عليه من عدد من النباتات ويستخدم لتحفيز القلب في حالات قصور القلب)",
 "cardiac glycoside": "جليكوسيد قلبي (يتم الحصول عليه من عدد من النباتات ويستخدم لتحفيز القلب في حالات قصور القلب)",
 "cardiac insufficiency": "قُصُور الشِّرْيَان التَّاجِيّ, قُصُور القَلْب (تدفق غير كافٍ للدم إلى عضلات القلب؛ يمكن أن يسبب ذبحة صدرية)",
 "cardiac massage": "تدليك القلب (إجراء طارئ يستخدم الضغط الإيقاعي للقلب (إما من خلال جدار الصدر أو مباشرة على القلب أثناء الجراحة) في محاولة للحفاظ على الدورة الدموية أثناء السكتة…)",
 "cardiac monitor": "جهاز مراقبة القلب (جهاز إلكتروني للمراقبة المستمرة لوظيفة القلب)",
 "cardiac murmur": "لغط القلب, نفخة قلبية (صوت غير طبيعي للقلب؛ أحياناً يكون علامة على وظيفة غير طبيعية لصمامات القلب)",
 "cardiac muscle": "عضلة قلبية (النسيج العضلي للقلب؛ متكيف للانقباض الإيقاعي المستمر)",
 "cardiac output": "النِّتَاج القَلْبِيّ (كمية الدم التي يضخها البطينان في فترة زمنية معينة)\nمثال: يبلغ النتاج القلبي للبالغ في حالة الراحة حوالي ثلاثة لترات في الدقيقة",
 "cardiac pacemaker": "عقدة جيبية أذينية, ناظمة قلبية (قطعة متخصصة من نسيج القلب تتحكم في ضربات القلب)",
 "cardiac plexus": "ضفيرة قلبية (ضفيرة من الأعصاب تغذي القلب والهياكل المجاورة)",
 "cardiac resuscitation": "إنعاش قلبي رئوي (إجراء طوارئ يتكون من تدليك القلب الخارجي والتنفس الاصطناعي)",
 "cardiac rhythm": "إِيقَاع القَلْب (إيقاع ضربات القلب)",
 "cardiac sphincter": "مصرة الفؤاد (الصمام بين الطرف البعيد للمريء والمعدة؛ المصرة الفيزيولوجية عند الوصل المعدي المريئي)",
 "cardiac tamponade": "اندكاك قلبي, سطام قلبي (ضغط ميكانيكي على القلب ناتج عن تجمع كميات كبيرة من السوائل في حيز التامور مما يحد من نطاق الحركة الطبيعي للقلب)",
 "cardiac valve": "صمام قلبي (صمام للتحكم في تدفق الدم في اتجاه واحد)",
 "cardiff": "كَارْدِيف",
 "cardigan": "بَرْنَكَان",
 "cardigan welsh corgi": "كارديجان, كارديجان ويلش كورجي (نوع مقوس الأرجل قليلاً من الكورجي له آذان مستديرة وذيل طويل)",
 "cardinal": "كارْدِينال, كَرْدِينَال / كَرْدِينَال",
 "cardinal compass point": "اِتِّجَاه أَصْلِيّ, نُقْطَة بُوصِلَة رَئِيسِيَّة (إحدى نقاط البوصلة الرئيسية الأربع)",
 "cardinal flower": "زهرة الكاردينال, لوبيليا حمراء (لوبيليا من أمريكا الشمالية ذات أزهار حمراء رائعة)",
 "cardinal grosbeak": "طائر أحمر, كاردينال (عصفور من أمريكا الشمالية ذو عرف ومنقار سميك ويتميز الذكر بريش أحمر ساطع)",
 "cardinal number": "عَدَد أَصْلِيّ (عدد عناصر مجموعة رياضية؛ يشير إلى كمية ولكن ليس إلى الترتيب) / عدد أصلي ((نحو) كلمة تعبر عن كمية قابلة للعد)",
