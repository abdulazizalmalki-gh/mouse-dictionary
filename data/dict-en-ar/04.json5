 "butter daisy": "أقحوان الزبدة (عشب حولي خشن رمادي مخضر أصفر الزهور؛ جنوب غرب الولايات المتحدة إلى المكسيك)",
 "butter dish": "طبق زبدة (طبق صغير (غالباً بغطاء) لحفظ الزبدة على المائدة)",
 "butter knife": "سكين الزبدة (سكين صغير بشفرة غير حادة؛ لقطع أو فرد الزبدة)",
 "butter up": "تَمَلَّقَ",
 "butter-and-eggs": "كتان العلجوم, كتانية شائعة (نبات معمر أوروبي شائع ذو زهور صفراء وبرتقالية مبهرجة؛ عشبة ضارة متوطنة في أمريكا الشمالية)",
 "butter-bean plant": "فاصولياء الزبدة, فاصولياء سيفا (نبات فاصولياء شجيري يزرع خاصة في جنوب الولايات المتحدة له بذور مسطحة صغيرة صالحة للأكل)",
 "butter-flower": "حوذان, زهرة الزبدة",
 "butter-print": "أبو طيلون, خبازة هندية (عشب حولي طويل أو شجيرة صغيرة من آسيا الاستوائية بأوراق مخملية وزهور صفراء وينتج أليافاً قوية)",
 "butterball": "بطة برأس الجاموس (بطة غواصة صغيرة من أمريكا الشمالية؛ الذكور لديهم ريش رأس كثيف) / بدين, سمين (شخص مستدير الجسم)",
 "butterbean": "فاصولياء الزبدة, فاصولياء سيفا (فاصولياء خضراء صغيرة مسطحة تشبه فاصولياء ليما)",
 "butterbur": "أَرَام",
 "buttercrunch": "خس مقرمش (خس ذو أوراق رقيقة ومقرمشة نسبياً)",
 "buttercup": "حَوْذَان",
 "buttercup squash": "قرع الزبدة (قرع أسطواني الشكل ذو قشرة خضراء داكنة معلمة باللون الفضي أو الرمادي) / قرع الحوذان (نبات يحمل ثماراً تشبه الطبل نوعاً ما ذات قشرة خضراء داكنة بعلامات رمادية)",
 "butterfat": "دهن الزبدة (المادة الدهنية للحليب التي تُصنع منها الزبدة)",
 "butterfingered": "أَخْرَق اليَدَيْن, ثَقِيل اليَد (يفتقر إلى مهارات الحركة الجسدية وخاصة في استخدام اليدين)",
 "butterfingers": "أخرق اليدين, مفلت الأشياء (شخص يسقط الأشياء (خاصة من لا يستطيع التقاط الكرة))",
 "butterfish": "جوني الصخر (سمكة طعام زلقة بلا حراشف في المياه الساحلية لشمال المحيط الأطلسي) / سمكة الزبدة (سمكة بحرية صغيرة ذات جسم مضغوط قصير وأشواك ضعيفة) / سمك الزبدة (أي من العديد من أسماك الطعام الصغيرة المفلطحة الأطلسية ذات الجلد الناعم)",
 "butterflower": "حوذان, زهرة الزبدة",
 "butterfly": "فَرَاشَة, ابو دقيق (حشرة صغيرة رقيقة ذات أجنحة كبيرة قد تكون ملونة أو غير ملونة)\nمثال: آه ، هناك فراشة!",
 "butterfly bush": "بودليا, شجيرة الفراشة (شجيرة استوائية ذات عناقيد من الزهور البيضاء أو البنفسجية أو الصفراء)",
 "butterfly collector": "عالم حرشفيات الأجنحة (عالم حشرات متخصص في جمع ودراسة الفراشات والعث)",
 "butterfly effect": "تَأْثِير الْفَرَاشَة",
 "butterfly fish": "سمكة الفراشة (أسماك بحرية استوائية صغيرة عادة ما تكون زاهية الألوان ذات أجسام عميقة ضيقة وزعانف عريضة كبيرة؛ توجد في جميع أنحاء العالم)",
 "butterfly flower": "بوهينيا, زهرة الفراشة (شجيرة أو شجرة صغيرة من غيانا الهولندية ذات عناقيد من الزهور الوردية المخططة بالأرجواني) / أوركيد الفقراء, زهرة الفراشة (أي نبات من جنس شيزانثوس ذو أوراق مقسمة بدقة وزهور مبهرجة متنوعة الألوان)",
 "butterfly nut": "صامولة فراشة, صامولة مجنحة (صامولة مسننة ذات نتوءات تشبه الأجنحة لتدويرها بالإبهام والسبابة)",
 "butterfly orchid": "سحلب الفراشة (سحلب متوسطي له زهور أرجوانية عادة بشفة حمراء وردية مرقطة أو مخططة على شكل مروحة) / أوركيد الفراشة (أوركيد فلوريدا وجزر البهاما ذو زهور زاهية الألوان مبهرجة؛ يوضع أحياناً في جنس إبيدندروم) / أوركيد الفراشة (أوركيد هوائي مكسيكي ذو زهور خضراء شاحبة أو خضراء مصفرة بشفة بيضاء معرقة بالأرجواني) / أوركيد السيدة الراقصة, أونسيديوم (أي أوركيد من جنس أونسيديوم: يتميز برشاشات متفرعة نحيلة من زهور صفراء وبنية صغيرة؛ تزرع غالباً كنباتات منزلية)",
 "butterfly orchis": "سحلب الفراشة (سحلب متوسطي له زهور أرجوانية عادة بشفة حمراء وردية مرقطة أو مخططة على شكل مروحة) / أوركيد الفراشة (أوركيد هوائي مكسيكي ذو زهور خضراء شاحبة أو خضراء مصفرة بشفة بيضاء معرقة بالأرجواني)",
 "butterfly pea": "بازلاء الفراشة, سينتروسيما (كرمة كبيرة الزهر ضعيفة الالتفاف أو منبسطة من نيو جيرسي إلى شرق أمريكا الشمالية الاستوائية، تزرع أحياناً لزهورها الأرجوانية والبيضاء) / بازلاء الفراشة, كليتوريا ماريانا (كرمة برية ملتفة كبيرة الزهر في جنوب شرق ووسط الولايات المتحدة لها أزهار زرقاء شاحبة) / بازلاء الفراشة, بازلاء زرقاء (كرمة من آسيا الاستوائية لها أوراق ريشية وأزهار زرقاء زاهية بمراكز صفراء)",
 "butterfly plant": "أوركيد السيدة الراقصة, أونسيديوم (أي أوركيد من جنس أونسيديوم: يتميز برشاشات متفرعة نحيلة من زهور صفراء وبنية صغيرة؛ تزرع غالباً كنباتات منزلية) / سحلب الفراشة, فالاينوبسيس (سحلب له أوراق لحمية كبيرة بيضاوية إلى بيضاوية مقلوبة وزهور وردية وبيضاء عطرة منقطة بالأحمر)",
 "butterfly ray": "لخمة الفراشة (لخمة ذات ذيل قصير وزعنفة عريضة)",
 "butterfly stroke": "سباحة الفراشة (طريقة سباحة تُرمى فيها الذراعان للأمام معاً خارج الماء بينما تركل القدمان لأعلى ولأسفل)",
 "butterfly valve": "صمام فراشة (صمام في المكربن يتكون من قرص يدور ويعمل كخانق)",
 "butterfly weed": "صقلاب درني, عشبة الفراشة (نبات معمر منتصب من شرق وجنوب الولايات المتحدة له زهور برتقالية بارزة)",
 "butterfly-shaped": "فَرَاشِيّ الشَّكْل (على شكل فراشة)",
 "butterflyfish": "غرنار طائر (سمكة استوائية ذات زعانف صدرية ضخمة تشبه المروحة للانزلاق تحت الماء؛ لا ترتبط بأسماك الروبن البحرية)",
 "butterhead lettuce": "خس الزبدة (خس ذو أوراق ناعمة نسبياً في رأس مفكك؛ ينكسر أو يرض بسهولة)",
 "buttermilk": "مَخِيض, مَمْخُوض / دُوغ",
 "buttermilk biscuit": "بيسكويت اللبن الرائب (بيسكويت طري جداً مخمر جزئياً باللبن الرائب والصودا)",
 "buttermilk pancake": "بان كيك اللبن (بان كيك مصنوع باللبن الرائب)",
 "butternut": "جوز أرمد (جوز زيتي بيضاوي الشكل لشجرة أمريكية من عائلة الجوز) / جوز أبيض, جوز أرمد (شجرة جوز من أمريكا الشمالية لها خشب بني فاتح ومكسرات صالحة للأكل؛ مصدر لصبغة بنية فاتحة)",
 "butternut squash": "قرع الجوز (قرع ذو لون بيج مع عنق طويل مستقيم عادة ولب برتقالي حلو) / قرع الجوز, قرع عسلي (نبات يحمل قرعاً برتقالي اللون له ثمار تشبه الزجاجة نوعاً ما بلب ناعم الملمس وقشرة رقيقة ناعمة)",
 "butternut tree": "جوز أبيض, جوز أرمد (شجرة جوز من أمريكا الشمالية لها خشب بني فاتح ومكسرات صالحة للأكل؛ مصدر لصبغة بنية فاتحة)",
 "butterscotch": "باترسكوتش, حلوى الزبدة والسكر (حلوى صلبة هشة مصنوعة من الزبدة والسكر البني)",
 "butterweed": "باكرا, عشب الزبدة / شيخة, عشب الزبدة (نبات شيخة أمريكي ذو أزهار صفراء)",
 "butterwort": "بينغويكولا, صائد الحشرات (أي من نباتات المستنقعات آكلة اللحوم المتعددة من جنس بينغويكولا لها زهور بارزة أرجوانية أو صفراء أو بيضاء ووريدة من الأوراق القاعدية المغطاة بإفراز…)",
 "buttery": "زُبْدِيّ (يُشْبِه الزُّبْدَة أَوْ يَحْتَوِي عَلَيْها أَوْ مَدْهُون بِها) / لَزِج, مُتَمَلِّق بِكَرَاهَة (مُبَالِغ فِي اللُّطْف بِشَكْل مُنَفِّر وَبَغِيض) / مقصف الكلية (محل شاي حيث يمكن للطلاب في الجامعات البريطانية شراء وجبات خفيفة) / خزانة طعام, مخزن المؤن (مخزن صغير لتخزين الأطعمة أو المشروبات)",
 "buttinsky": "حشري, متدخل (متطفل يميل إلى إقحام نفسه في الأمور)",
 "buttock": "دُبْر, رِدْف (ضد القُبُل؛ من كل شيء عقبه ومؤخره؛ دُبُر الصلاة؛ بعدها مباشرة)\nمثال: دبر المحامي وسلية لهرب توم من السجن.",
 "buttocks": "أرداف, ألية (الجزء اللحمي من جسم الإنسان الذي يجلس عليه)\nمثال: يستحق ركلة جيدة في مؤخرته",
 "button": "زِرّ",
 "button accordion": "أكورديون أزرار (أكورديون يحتوي على أزرار بدلاً من المفاتيح)",
 "button ad": "إِعْلَان زِرّ (إعلان دائري أو مستطيل أو مربع صغير يظهر عادة في أسفل صفحة الويب)",
 "button fern": "سرخس الزر الجامايكي (سرخس جامايكي له بصيلات مستديرة تشبه الأزرار) / سرخس الزر (سرخس من نيوزيلندا وأستراليا له سعف متدلٍ بوريقات خضراء داكنة تشبه الأزرار)",
 "button hole": "ثقب الزر, عروة (ثقب يتم دفع الأزرار من خلاله)",
 "button mangrove": "شجرة الزر, مانغروف الزر (شجرة أو شجيرة دائمة الخضرة ذات ثمار تشبه الأزرار وتنتج خشباً ثقيلاً صلباً مضغوطاً)",
 "button pink": "قرنفل الزر (قرنفل كثير التفرع بزهور في عناقيد؛ وثيق الصلة بقرنفل الشاعر)",
 "button quail": "سمان الشجر (طائر أرضي صغير يشبه السمان من جنوب أوراسيا وشمال أفريقيا يفتقر إلى إصبع القدم الخلفي؛ يصنف مع طيور الخوض ولكنه يسكن السهول العشبية)",
 "button snakeroot": "ريشة غاي, ليآتريس (أي من نباتات أمريكا الشمالية المتنوعة من جنس ليآتريس ذات نورات عنقودية أو عثكولية من رؤوس الزهور القرصية الصغيرة) / زر الثعبان, قرصعنة مائية (قرصعنة معمرة شائكة خشنة بجذور عطرية؛ جنوب شرق الولايات المتحدة؛ غالباً ما يخلط بينها وبين سيد الأفاعي) / سيد الأفاعي, قرصعنة يوكية الأوراق (قرصعنة معمرة خشنة وشائكة في الولايات المتحدة يُعتقد أنها تعالج لدغة الأفعى الجرسية)",
 "button tree": "شجرة الزر, مانغروف الزر (شجرة أو شجيرة دائمة الخضرة ذات ثمار تشبه الأزرار وتنتج خشباً ثقيلاً صلباً مضغوطاً)",
 "button-down": "بِيَاقَة مُزَرَّرَة ((عَنِ القَمِيص) أَطْرَاف اليَاقَة مُثَبَّتَة بِأَزْرَار) / تَقْلِيدِيٌّ جَامِد, مُحَافِظ (تَقْلِيدِيٌّ بِشَكْلٍ يَفْتَقِرُ لِلخَيَال)",
 "button-quail": "سمان الشجر (طائر أرضي صغير يشبه السمان من جنوب أوراسيا وشمال أفريقيا يفتقر إلى إصبع القدم الخلفي؛ يصنف مع طيور الخوض ولكنه يسكن السهول العشبية)",
 "button-shaped": "زِرِّيّ الشَّكْل (على شكل زِرّ)",
 "buttoned": "مُزَرَّر, مُغْلَق بِالأَزْرَار (مجهز أو مغلق بأزرار أو شيء يشبه الزر)",
 "buttoned-down": "تَقْلِيدِيٌّ جَامِد, مُحَافِظ (تَقْلِيدِيٌّ بِشَكْلٍ يَفْتَقِرُ لِلخَيَال)",
 "buttoned-up": "رَسْمِيّ, مُتَحَفِّظ (مُحَافِظٌ فِي السُّلُوكِ المِهْنِيِّ) / مُتَحَفِّظ, مُنْغَلِق ((عامّيّة بريطانيّة) غير ميال للحديث)",
 "buttonhole": "عُرْوَة",
 "buttonhole machine": "آلة صنع العراوي, ماكينة عراوي (آلة خياطة تخيط جميع أنواع عراوي الأزرار مع أو بدون خيط الحشو)",
 "buttonhole stitch": "غرزة العروة (غرزة حلقية مقوية للحواف، كما حول عروة الزر)",
 "buttonhook": "خُطَّاف الأزرار (خُطَّاف لسحب زر عبر عروة الزر)",
 "buttonlike": "لَامِع كَالخَرَز (صَغِير ومُسْتَدِير ولَامِع كَالخَرَزَة أَوِ الزِّرّ)",
 "buttonwood": "جميز أمريكي, دلب غربي (شجرة دلب كبيرة جداً منتشرة في شرق ووسط أمريكا الشمالية إلى المكسيك)",
 "buttony": "كَثِير الأَزْرَار, مُزَرَّر (مزين بأزرار كثيرة) / لَامِع كَالخَرَز (صَغِير ومُسْتَدِير ولَامِع كَالخَرَزَة أَوِ الزِّرّ)",
 "buttress": "دعامة ساندة (دعامة عادة من الحجر أو الطوب؛ تدعم جدار المبنى)",
 "buttressed": "مُدَعَّم, مُعَزَّز بِدِعَامَات (محمول بواسطة دعامات أو ركائز)",
 "buttressing": "دعامة ساندة (دعامة عادة من الحجر أو الطوب؛ تدعم جدار المبنى)",
 "butty": "باتي, شطيرة (شطيرة (مصطلح بريطاني))\nمثال: شطيرة لحم مقدد",
 "butut": "بوتوت (100 بوتوت تساوي 1 دالاسي في غامبيا)",
 "butyl": "بوتيل",
 "butyl alcohol": "بيوتانول, كحول البيوتيل (كحول قابل للاشتعال مشتق من البيوتان ويستخدم للمذيبات)",
 "butyl nitrite": "نتريت البوتيل (سائل لاذع عديم اللون يستخدم أحياناً كعقار منشط من قبل مدمني المخدرات)",
 "butyl rubber": "مطاط البوتيل (مطاط صناعي مصنوع عن طريق بلمرة الأيزوبيوتيلين)",
 "butylene": "بوتيلين, بوتين",
 "butyraceous": "زبدية, سمنية (له خصائص الزبدة أو ينتج أو يحتوي على مادة تشبه الزبدة)",
 "butyric": "زبدية (يتعلق بـ أو ينتج حمض الزبدة (البوتيريك))",
 "butyric acid": "حمض البيوتيريك, حمض الزبدة (حمض دهني كريه الرائحة يوجد خاصة في الزبدة)",
 "butyrin": "بيوتيرين (أي من ثلاثة جلسريدات لحمض الزبدة)",
 "buxom": "فَاتِنَة القَوَام, مُمْتَلِئَة الجِسْم ((عَنْ جِسْم المَرْأَة) مُمْتَلِئَة بِصِحَّة وَحَيَوِيَّة) / ذَات قَوَام مُنْحَنٍ, مُمْتَلِئَة ((عن جسد المرأة) ذات صدر كبير وانحناءات جذّابة)",
 "buxomly": "بِتَقَوُّس جَذَّاب (بطريقة تبرز المنحنيات)\nمثال: كانت رفيقته جذابة بقوامها الممتلئ",
 "buxomness": "امتلاء جذاب (الخاصية الجسدية المتمثلة في الامتلاء الجذاب والحيوية و(للنساء) امتلاء الصدر)",
 "buxus sempervirens": "بقس شائع, شمشاد دائم الخضرة (شجيرة كبيرة بطيئة النمو دائمة الخضرة أو شجرة صغيرة ذات سيقان متعددة؛ تستخدم على نطاق واسع للأسيجة أو الحدود والأشكال المقلمة)",
 "buy": "اِشْتَرَى (أَخَذَ الشيءَ بِثَمَن؛ اشترى الشخصَ (الحرّ) أو رضاه: أراد إرضائه ومحبته بغض النظر عن الكلفة)\nمثال: اشترى زيري ذلك.",
 "buy-and-bust operation": "عملية شراء وضبط (عملية سرية من قبل محققي المخدرات للقبض على تجار المخدرات غير المشتبه بهم)",
 "buyback": "إعادة شراء, استرداد (فعل إعادة شراء شيء تم بيعه سابقاً)",
 "buyer": "مُشْتَرِي, مُشْتَرٍ (الذي قام بالشراء)\nمثال: كوكب المشتري متكون من الغاز.",
