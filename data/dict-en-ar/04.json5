 "carcajou": "شره (ثديي لاحم ممتلئ الجسم أشعث المعطف من أمريكا الشمالية)",
 "carcase": "ذَبِيحَة (جسد حيوان ميت، خاصة الذي ذبح وأعد للطعام)",
 "carcass": "فَطِيسَة",
 "carcassonne": "قرقشونة, قرقسونة",
 "carceral": "سِجْنِيّ",
 "carcharhinus leucas": "قرش الثور (أكثر أنواع القرش شيوعاً في المياه الساحلية المعتدلة والاستوائية حول العالم؛ ضخم الجسم وخطير)",
