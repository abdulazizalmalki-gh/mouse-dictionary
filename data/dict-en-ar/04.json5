 "carina": "جؤجؤ (أي من التراكيب المختلفة التي تشبه العارضة أو الحواف مثل تلك الموجودة على عظم القص للطائر أو تلك التي تشكلها البتلات المندمجة لزهرة البازلاء)",
 "carina fornicis": "جؤجؤ القبو (حافة على السطح السفلي لقبو الدماغ)",
 "carinal": "زورقي (يتعلق بـ أو يشبه الزورق (الجؤجؤ))",
 "carinate": "طيور جؤجؤية, طيور طائرة (طيور لها عظام صدر جؤجؤية لربط عضلات الطيران) / جؤجؤي, عرفي (لديه حافة أو على شكل حافة أو يوحي بقرينة السفينة)\nمثال: سبلة عرفية",
 "carinate bird": "طيور جؤجؤية, طيور طائرة (طيور لها عظام صدر جؤجؤية لربط عضلات الطيران)",
 "carinated": "جؤجؤي, عرفي (لديه حافة أو على شكل حافة أو يوحي بقرينة السفينة)\nمثال: سبلة عرفية",
 "caring": "عَطُوف, مُهْتَمّ (يشعر بالاهتمام والتعاطف تجاه الآخرين ويُظهر ذلك) / اهتمام, مودة (شعور محب)",
 "carinthia": "كِيرَنْتَن, كَارِينْثِيَا",
 "carioca": "كاريوكا (رقصة صالونات حيوية تشبه السامبا) / كاريوكا (موسيقى مؤلفة لرقص الكاريوكا) / كاريوكا (مواطن أو ساكن في ريو دي جانيرو)",
 "carious": "مُسَوَّس, نَخِر ((عَن الأسْنان) مُصاب بِالتَّسَوُّس أو التَّآكُل)",
 "carissa": "كاريسا, نملي (شجيرة من جنس الكاريسا ذات أزهار بيضاء عطرة وثمار تشبه البرقوق حمراء إلى أرجوانية سوداء)",
 "carissa bispinosa": "شوك السياج, كاريس ثنائي الشوك (شجيرة من جنوب إفريقيا لها أشواك متشعبة وثمار تشبه البرقوق؛ تستخدم بكثرة كسياج)",
 "carissa grandiflora": "خوخ ناتال, كاريس كبير الثمار (شجيرة كبيرة جداً كثيفة التفرع من جنوب إفريقيا لها أشواك خضراء زاهية متشعبة وأوراق لامعة)",
 "carissa macrocarpa": "خوخ ناتال, كاريس كبير الثمار (شجيرة كبيرة جداً كثيفة التفرع من جنوب إفريقيا لها أشواك خضراء زاهية متشعبة وأوراق لامعة)",
 "carissa plum": "خوخ الكاريس, كاريس (فاكهة قرمزية صالحة للأكل تشبه الخوخ لنبات من جنوب أفريقيا)",
 "carjacking": "تسليب سيارات, سطو على السيارات (السرقة العنيفة لسيارة مأهولة)",
 "carl": "كَارْل",
 "carlina acaulis": "أداد عديم الساق (نبات معمر عديم الساق له زهور كبيرة بزهيرات بيضاء أو بنية أرجوانية متداخلة في وردة من أوراق شوكية طويلة مشعرة من الأسفل؛ يتواجد في المناطق الألبية…)",
 "carlina vulgaris": "أداد شائع (شوك أوراسي ينمو في الكثبان الرملية والتربة الطباشيرية الجافة)",
 "carline thistle": "أداد, شوك كارلينا (شوك من جنس الكارلينا)",
 "carling float": "طوف نجاة (طوف يستخدم إذا كان يجب التخلي عن السفينة في حالة الطوارئ)",
 "carlisle": "كارلايل",
 "carload": "حمولة سيارة, ركاب سيارة (تجمع من الركاب يكفي لملء سيارة) / حمولة سفينة, حمولة عربة (كمية البضائع التي يمكن أن تستوعبها قارب أو سفينة أو عربة شحن)\nمثال: استورد النبيذ بحمولات السفن",
 "carlos": "كَارْلُوس",
 "carlovingian": "كارولنجي (عضو في السلالة الكارولنجية)",
 "carlovingian dynasty": "سلالة الكارولنجيون (سلالة فرنجية أسسها والد شارلمان حكمت من 751 إلى 987)",
 "carmaker": "شركة تصنيع سيارات, صانع سيارات (عمل تجاري يشارك في تصنيع السيارات)",
 "carmelite": "كرملي (من أو متعلق بالرهبان الكرمليين) / راهب أبيض, كرملي (راهب روماني كاثوليكي يرتدي العباءة البيضاء للرهبنة الكرملية؛ واعظ متسول)\nمثال: أديرة الكرمليين",
 "carmelite order": "الرهبنة الكرملية, رهبنة سيدة جبل الكرمل (نظام رهباني متسول كاثوليكي روماني تأسس في القرن الثاني عشر)",
 "carminative": "طارِد لِلرِّياح (يُساعِد عَلى طَرْد الغازات مِن الجِهاز الهَضْمِيّ) / طارد للغازات (دواء يمنع تكون الغازات في القناة الهضمية أو يسهل خروجها)",
 "carmine": "أَحْمَر, قِرْمِزِيّ (بلون في نهاية الطيف اللوني قرب البرتقالي؛ يشبه لون الدم أو الكرز أو الياقوت) / أحمر كاردينالي, قرمزي (لون متغير يميل إلى الأحمر الزاهي)",
 "carnage": "قتل جماعي, مجزرة (القتل الوحشي والمفرط لعدد كبير من الناس)",
 "carnal": "جَسَدُيّ",
 "carnal abuse": "اعتداء جنسي على قاصر, اغتصاب قاصر (الجماع الجنسي مع شخص (فتاة أو صبي) لم يبلغ سن الرشد (حتى لو شارك الطرفان طواعية)) / اعتداء جسدي, انتهاك عرض (أي اتصال شهواني من قبل شخص بالغ بالأعضاء التناسلية لطفل (خاصة ما لا ينطوي على الجماع))",
 "carnal knowledge": "اتصال جنسي, جماع (نشاط جنسي بين الأفراد، خاصة إيلاج العضو الذكري في المهبل حتى حدوث النشوة والقذف)",
 "carnality": "شهوانية, فجور (الشعور برغبة جنسية مرضية أو ميل للفحش)",
 "carnallite": "كارناليت (معدن أبيض أو محمر يتكون من كلوريدات البوتاسيوم والمغنيسيوم المائية؛ يستخدم كسماد وكمصدر للبوتاسيوم والمغنيسيوم)",
 "carnally": "جسدياً, شهوانياً (بطريقة جسدية/شهوانية)",
 "carnassial": "قَاطِع لِلَّحْم ((عَنِ السِّنّ) مُتَكَيِّف لِتَمْزِيق اللَّحْم)",
 "carnassial tooth": "سن قاطعة (الضاحك العلوي الأخير والرحى السفلية الأولى للحيوانات آكلة اللحوم؛ لها حواف حادة لقطع اللحم)",
 "carnation": "قَرَنْفُل",
 "carnauba": "كارنوبا, نخيل الكارنوبا (نخيل مروحي برازيلي له جذر صالح للأكل؛ ومصدر لألياف أوراق مفيدة وشمع مصفر هش) / شمع الكرنوبا (شمع صلب أصفر إلى بني من أوراق نخيل الكرنوبا يُستخدم خاصة في شمع الأرضيات ومواد التلميع)",
 "carnauba palm": "كارنوبا, نخيل الكارنوبا (نخيل مروحي برازيلي له جذر صالح للأكل؛ ومصدر لألياف أوراق مفيدة وشمع مصفر هش)",
 "carnauba wax": "شمع الكرنوبا (شمع صلب أصفر إلى بني من أوراق نخيل الكرنوبا يُستخدم خاصة في شمع الأرضيات ومواد التلميع)",
 "carnegiea gigantea": "ساجوارو, صبار عملاق (صبار ضخم يشبه الشجرة في المناطق الصحراوية بجنوب غرب الولايات المتحدة له جذع عمودي سميك قليل التفرع يحمل أزهاراً بيضاء وثماراً لبية حمراء صالحة للأكل)",
 "carnelian": "عقيق أحمر, كارنيليان (نوع أحمر أو برتقالي نصف شفاف من الكالسيدوني)",
 "carniolan bee": "نحل كرنيولي (نحل عسل أوروبي رمادي عالي الإنتاجية ذو طبع هادئ)",
 "carnival": "كَرْنَفَال",
 "carnivore": "لَاحِم (فِي حَيَوَانٌ لَاحِم هو الذي يتكون نظامه الغذائي أساسيا من اللُّحُومِ؛ النَّبَات اللََاجِم هو نبات يتغذى على اللحم؛غالباً الحشرات)",
 "carnivorous": "لَاحِم (فِي حَيَوَانٌ لَاحِم هو الذي يتكون نظامه الغذائي أساسيا من اللُّحُومِ؛ النَّبَات اللََاجِم هو نبات يتغذى على اللحم؛غالباً الحشرات)",
 "carnivorous bat": "خفاش آكل للحوم (يتميز عادة بآذان كبيرة ويتغذى بشكل أساسي على الحشرات؛ عالمي الانتشار)",
 "carnivorous plant": "نبات آكل للحشرات, نبات لاحم (نباتات متكيفة لجذب والتقاط وهضم الحشرات بشكل أساسي ولكن أيضاً الحيوانات الصغيرة الأخرى)",
 "carnivorousness": "أكل اللحوم (صفة كون الحيوان يأكل اللحوم كجزء رئيسي من نظامه الغذائي)",
 "carnosaur": "كارنوصور (ديناصور لاحم كبير ثنائي الأرجل له مخالب ضخمة)",
 "carnot cycle": "دورة كارنو (دورة (من التمدد والانضغاط) لمحرك حراري مثالي عكسي ينجز عملاً دون فقدان للحرارة)",
 "carnot's ideal cycle": "دورة كارنو (دورة (من التمدد والانضغاط) لمحرك حراري مثالي عكسي ينجز عملاً دون فقدان للحرارة)",
 "carnotite": "كارنوتيت (معدن أصفر مشع؛ خام لليورانيوم والراديوم والفاناديوم)",
 "carob": "خَرُّوب",
 "carob bar": "لوح خروب (لوح حلوى مصنوع بمسحوق الخروب)",
 "carob bean": "خروب (قرن طويل يحتوي على فاصوليا صغيرة ولب حلو صالح للأكل؛ يستخدم كعلف حيواني ومصدر لبديل الشوكولاتة)",
 "carob bean tree": "خروب, شجرة الخروب (شجرة متوسطية دائمة الخضرة بقرون صالحة للأكل؛ الخروب المذكور في الكتاب المقدس)",
 "carob powder": "خروب, مسحوق الخروب (مسحوق من البذور المطحونة وقرون شجرة الخروب؛ يستخدم كبديل للشوكولاتة)",
 "carob tree": "خروب, شجرة الخروب (شجرة متوسطية دائمة الخضرة بقرون صالحة للأكل؛ الخروب المذكور في الكتاب المقدس)",
 "caroche": "عربة كاروش (عربة فاخرة مناسبة للنبلاء في القرنين السادس عشر والسابع عشر)",
 "carol": "ترنيمة (أغنية بهيجة (عادة للاحتفال بميلاد المسيح)) / ترنيمة الميلاد, كارول (أغنية دينية بهيجة تحتفل بميلاد المسيح)",
 "carolean": "كارولي (من أو متعلق بحياة وعصر الملك تشارلز الأول أو تشارلز الثاني في إنجلترا)",
 "caroler": "مغني ترانيم (منشد ترانيم (خاصة في عيد الميلاد))",
 "carolina allspice": "بهار كارولينا, شجيرة الفراولة (شجيرة قوية من جنوب شرق الولايات المتحدة لها خشب برائحة القرنفل وزهور بنية حمراء عطرة)",
 "carolina buckthorn": "كرز هندي, نبق كارولينا (شجيرة متساقطة الأوراق في شرق ووسط الولايات المتحدة ذات ثمار سوداء تشبه التوت؛ ذهبية صفراء في الخريف)",
 "carolina chickadee": "قرقف كارولينا (قرقف من جنوب الولايات المتحدة يشبه القرقف أسود التاج ولكنه أصغر)",
 "carolina hemlock": "تسوغا كارولينا (شجرة دائمة الخضرة متوسطة الحجم من جنوب شرق الولايات المتحدة لها فروع منتشرة وحراشف مخروطية متباعدة على نطاق واسع)",
 "carolina jasmine": "ياسمين أصفر, ياسمين كارولينا (كرمة خشبية سامة دائمة الخضرة في جنوب شرق الولايات المتحدة لها أزهار صفراء قمعية الشكل وعطرة)",
 "carolina lupine": "ترمس كارولينا (شجيرة بازلاء في شرق الولايات المتحدة)",
 "carolina moonseed": "بذر القمر الكاروليني (كرمة خشبية من جنوب شرق الولايات المتحدة تشبه بذر القمر الشائع ولكن لها ثمار حمراء)",
 "carolina parakeet": "ببغاء كارولينا (ببغاء منقرض امتد نطاقه بعيداً داخل الولايات المتحدة)",
 "carolina pond fern": "أزولا كارولينية, سرخس البعوض (سرخس مائي صغير حر الطفو من شرق الولايات المتحدة إلى أمريكا الاستوائية؛ متوطن في غرب وجنوب أوروبا)",
 "carolina spring beauty": "جمال الربيع الكاروليني, كلايتونيا كارولينية (يشبه كلايتونيا فرجينيكا ولكن له زهور وردية عادة؛ شرق أمريكا الشمالية)",
 "carolina wren": "نمنمة كارولينا (نمنمة أمريكية كبيرة ذات نداء موسيقي)",
 "caroline": "كارولي (من أو متعلق بحياة وعصر الملك تشارلز الأول أو تشارلز الثاني في إنجلترا)",
 "caroling": "ترنيم, غناء التراتيل (غناء الأغاني الدينية المبهجة (خاصة في عيد الميلاد))",
 "carolingian": "كارولنجي (من أو متعلق بالسلالة الفرنجية التي أسسها والد شارلمان) / كارولنجي (عضو في السلالة الكارولنجية)",
 "carolingian dynasty": "سلالة الكارولنجيون (سلالة فرنجية أسسها والد شارلمان حكمت من 751 إلى 987)",
 "carolinian": "كاروليني (مواطن أو مقيم في الكارولينا)",
 "caroller": "مغني ترانيم (منشد ترانيم (خاصة في عيد الميلاد))",
 "carom": "ضربة ارتدادية, كاروم (ضربة في البلياردو تلامس فيها الكرة البيضاء كرة هدف ثم الأخرى) / ارتداد, وثبة (ارتداد جانبي)",
 "carotene": "كاروتين (أصباغ صفراء أو برتقالية حمراء قابلة للذوبان في الدهون موجودة في النباتات) / طليعة فيتامين أ, كاروتين (متصاوغ برتقالي لهيدروكربون غير مشبع يوجد في العديد من النباتات؛ يتحول إلى فيتامين أ في الكبد)",
 "carotenemia": "اصفرار الدم, كاروتينيميا (زيادة الكاروتين في مجرى الدم؛ يمكن أن يسبب تحول الجلد إلى اللون الأصفر الشاحب أو الأحمر)",
 "carotenoid": "صبغة كاروتينية, كاروتينويد (أي فئة من الأصباغ غير المشبعة للغاية ذات اللون الأصفر إلى الأحمر والتي توجد في النباتات والحيوانات)",
 "carotid": "الشَّرْيَان السُّبَاتِيّ",
 "carotid artery": "شريان سباتي (أحد الشريانين الرئيسيين في الرقبة والرأس؛ يتفرع من الأبهر)",
 "carotid body": "جسم سباتي (مستقبل كيميائي يقع بالقرب من تفرعات الشرايين السباتية؛ يراقب محتوى الأكسجين في الدم ويساعد في التحكم في التنفس)",
 "carotid plexus": "ضفيرة سباتية (ضفيرة من الأعصاب تحيط بالشريان السباتي الباطن)",
 "carotin": "طليعة فيتامين أ, كاروتين (متصاوغ برتقالي لهيدروكربون غير مشبع يوجد في العديد من النباتات؛ يتحول إلى فيتامين أ في الكبد)",
 "carousal": "حفل سُكْر, معاقرة الخمر (الاحتفال الصاخب بشرب الكحول؛ حفلة شرب مرحة)",
 "carouse": "حفل سُكْر, معاقرة الخمر (الاحتفال الصاخب بشرب الكحول؛ حفلة شرب مرحة)",
 "carousel": "كارُوسِيل, دُوَّامَة خَيْل",
 "carouser": "معاقر, مُنادِم (شخص يستمتع بحفلات الشرب الصاخبة)",
 "carousing": "خَمْرِيّ, عَرْبَدِيّ (يُوصَف بِهِ العَرْبَدَة وَالسُّكْر الصَّاخِب)",
 "carp": "شَبُّوط",
 "carpal": "رسغي (من أو متعلق بالرسغ) / عظم الرسغ, عظم رسغي (أي من العظام الصغيرة الثمانية لرسغ اليد لدى الرئيسيات)\nمثال: متلازمة النفق الرسغي",
 "carpal bone": "عظم الرسغ, عظم رسغي (أي من العظام الصغيرة الثمانية لرسغ اليد لدى الرئيسيات)",
 "carpal tunnel": "نفق رسغي (ممر في الرسغ تمر عبره الأعصاب والعضلات القابضة لليدين)",
 "carpal tunnel syndrome": "متلازمة النفق الرسغي (اضطراب مؤلم ناتج عن ضغط العصب في النفق الرسغي؛ يتميز بعدم الراحة والضعف في اليدين والأصابع وإحساس بالوخز أو الحرقة أو الخدر)",
 "carpathians": "كَارْبَات",
 "carpel": "كربلة (مدقة بسيطة أو عنصر واحد من مدقة مركبة)",
 "carpellary": "كربلي (ينتمي إلى أو يشكل أو يحتوي على كرابل (أجزاء الزهرة الأنثوية))",
 "carpellate": "كَرْبَلِيّ, مِدَقِّيّ (يحمل أو يتكون من كرابل)",
 "carpenter": "نَجَّار (صاحب مهنة النِجَارَة أو العامل فيها)",
 "carpenter ant": "نمل نجار (نمل يعشش في الخشب المتحلل حيث يحفر أنفاقاً لوضع البيض)",
 "carpenter bee": "نَحْلَة نَجَّارَة, نَحْل نَجَّار",
 "carpenter's hammer": "مطرقة النجار, مطرقة بمخلب (مطرقة ذات شق في أحد طرفيها لسحب المسامير)",
 "carpenter's kit": "عدة نجار (مجموعة من أدوات النجار)",
 "carpenter's level": "ميزان تسوية, ميزان ماء (قضيب مستقيم من معدن خفيف يحتوي على ميزان كحولي)",
 "carpenter's mallet": "مطرقة خشبية للنجار (مطرقة ذات مقبض قصير ورأس خشبي تستخدم لضرب الإزميل أو الإسفين)",
 "carpenter's plane": "فارة نجار, مِسْحَج (أداة يدوية للنجار بشفرة قابلة للتعديل لتنعيم أو تشكيل الخشب)\nمثال: استخدم صانع الخزائن المسحج لعمل الإنهاء",
 "carpenter's rule": "مسطرة النجار (مسطرة يستخدمها النجار)",
 "carpenter's saw": "منشار يدوي (منشار يستخدم بيد واحدة لقطع الخشب)",
 "carpenter's square": "زاوية النجار (زاوية فولاذية يستخدمها النجارون؛ أكبر من الزاوية القائمة العادية)",
 "carpenteria": "شقيقة النعمان الشجيرية, كاربنترية (شجيرة دائمة الخضرة في كاليفورنيا ذات أوراق متقابلة لامعة وعناقيد طرفية من بضع زهور بيضاء عطرة)",
 "carpenteria californica": "شقيقة النعمان الشجيرية, كاربنترية (شجيرة دائمة الخضرة في كاليفورنيا ذات أوراق متقابلة لامعة وعناقيد طرفية من بضع زهور بيضاء عطرة)",
 "carpentry": "نِجَارة (مؤنث نَجَّار، التي تعمل بالنجارة)",
 "carper": "كثير الانتقاد, متصيد للأخطاء (شخص ينتقد باستمرار بطريقة تافهة)",
 "carpet": "سَجَّادَة, بِسَاط",
 "carpet beater": "مضرب السجاد, منفضة السجاد (أداة لضرب الغبار لإخراجه من السجاد)",
 "carpet beetle": "خنفساء السجاد (خنفساء صغيرة تعتبر يرقاتها آفات منزلية تتغذى على الأقمشة الصوفية)",
 "carpet bombing": "قصف بساطي",
 "carpet bug": "خنفساء السجاد (خنفساء صغيرة تعتبر يرقاتها آفات منزلية تتغذى على الأقمشة الصوفية)",
 "carpet grass": "عشبة السجاد, عشبة السناج (عشبة موطنها جزر الهند الغربية ولكنها شائعة في جنوب الولايات المتحدة ذات سيقان سلكية معنقدة غالباً ما تكون مصابة بفطر داكن)",
 "carpet knight": "فارس الصالونات (فارس يقضي وقته في الترف والكسل (حصل على رتبة فارس في البلاط وليس في ميدان المعركة))",
 "carpet loom": "نول السجاد (نول لنسج السجاد)",
 "carpet moth": "عثة السجاد (تتغذى اليرقات على السجاد والمنسوجات الصوفية الأخرى)",
 "carpet pad": "بطانة السجاد (لبادة توضع تحت السجادة)",
 "carpet shark": "قرش السجاد (قرش من غرب المحيط الهادئ ذو جسم مفلطح وجلد مرقش)",
 "carpet slipper": "خف منزلي, شبشب (حذاء منخفض يمكن ارتداؤه وخلعه بسهولة؛ يلبس عادة داخل المنزل)",
 "carpet snake": "ثعبان السجاد (بايثون أسترالي بنمط متنوع الألوان على ظهره)",
 "carpet sweeper": "كانسة ميكانيكية, مكنسة سجاد يدوية (أداة تنظيف بفرش دوارة تلتقط الأوساخ عند دفع الأداة فوق السجادة)",
 "carpet tack": "مسمار السجاد (مسمار صغير يستخدم لتثبيت السجاد)",
 "carpet-weaving": "حياكة السجاد (صناعة السجاد، سواء آلياً أو يدوياً)\nمثال: تشهد الحفريات الأثرية في أذربيجان على التطور الجيد لحياكة السجاد التي يعود تاريخها إلى الألفية الثانية قبل الميلاد",
 "carpetbag": "دَخِيل, مُتَسَلِّق (يسعى بجرأة إلى النجاح أو مكانة في مكان جديد بشكل متطفل) / انتهازي سياسي, دخيل سياسي / حقيبة سجاد (حقيبة سفر مصنوعة من السجاد؛ انتشر استخدامها في القرن التاسع عشر)\nمثال: مغامرون انتهازيون",
 "carpetbagger": "انتهازي دخيل, طامع خارجي (شخص دخيل يسعى للسلطة أو النجاح بوقاحة وافتراض (أصله مصطلح سياسي أمريكي))\nمثال: بعد الحرب الأهلية حاول الانتهازيون الدخلاء من الشمال السيطرة على الجنوب",
 "carpetbagging": "دَخِيل, مُتَسَلِّق (يسعى بجرأة إلى النجاح أو مكانة في مكان جديد بشكل متطفل)",
 "carpeted": "مَفْرُوش بِالسَّجَّاد (مغطى بـ أو كما لو كان بسجاد أو بسجاد كما هو محدد؛ غالباً ما تستخدم في التركيب)\nمثال: المدخل المفروش بالسجاد",
 "carpeting": "بساط, سجادة (غطاء للأرضية يتكون من قطعة من القماش السميك الثقيل (عادة ما يكون له وبر))",
 "carpetweed": "عشبة البساط (عشب ضار حولي منبسط يشكل حصيرة له أوراق دائرية وأزهار بيضاء مخضرة صغيرة؛ واسع الانتشار في جميع أنحاء أمريكا الشمالية)",
 "carphophis amoenus": "ثعبان الدودة (ثعبان صغير محمر يشبه الدودة من شرق الولايات المتحدة)",
 "carping": "تَذَمُّر, تَصَيُّد الْأَخْطَاء (نقد تافه وغير مبرر ومستمر)",
 "carpinus betulus": "شجرة النير الأوروبية (شجرة متوسطة الحجم من العالم القديم بلحاء رمادي ناعم وأوراق تشبه الزان تتحول إلى الأصفر البرتقالي في الخريف)",
 "carpinus caroliniana": "شجرة النير الأمريكية (شجرة أو شجيرة كبيرة بلحاء رمادي وأوراق زرقاء خضراء تتحول إلى الأحمر البرتقالي في الخريف)",
 "carpobrotus edulis": "أصابع العروس, تين هوتنتوت (نبات عصاري منخفض النمو في جنوب أفريقيا له ثمرة كبسولية تحتوي على لب صالح للأكل)",
 "carpocapsa pomonella": "دودة ثمار التفاح, عثة التفاح (عثة رمادية صغيرة تعيش يرقاتها في التفاح والجوز الإنجليزي)",
 "carpodacus mexicanus": "جزم, عصفور المنزل (عصفور صغير أصله من غرب الولايات المتحدة والمكسيك)",
 "carpodacus purpureus": "عصفور أرجواني (عصفور من أمريكا الشمالية له رأس وصدر وردي محمر)",
 "carpophagous": "آكِل الثِّمَار, ثَمَرِيّ التَّغْذِيَة (يَتَغَذَّى عَلَى الفَوَاكِه والثِّمَار)",
 "carpophore": "حامل الثمرة (ساق نحيلة توفر محوراً للكربلة)",
 "carport": "مظلة سيارات (مرآب لسيارة واحدة أو سيارتين يتكون من سقف مسطح مدعوم على أعمدة)",
 "carpospore": "بوغ ثمري (بوغ غير متحرك للطحالب الحمراء)",
 "carposporic": "بوغي ثمري (يتعلق بـ أو يشبه البوغ الثمري)",
 "carposporous": "بوغي ثمري (لديه أبواغ ثمرية)",
 "carpus": "رسغ, مفصل الرسغ (مفصل بين النهاية البعيدة للكعبرة والصف القريب من عظام الرسغ)",
 "carrack": "قرقور",
 "carrageen": "طحلب أيرلندي, كاراجين (عشب بحري أرجواني داكن صالح للأكل من سواحل المحيط الأطلسي لأوروبا وأمريكا الشمالية)",
 "carrageenan": "كاراجينان (مستخلص غرواني من عشب البحر الكاراجين وطحالب حمراء أخرى)",
 "carrageenin": "كاراجينان (مستخلص غرواني من عشب البحر الكاراجين وطحالب حمراء أخرى)",
 "carragheen": "طحلب أيرلندي, كاراجين (عشب بحري أرجواني داكن صالح للأكل من سواحل المحيط الأطلسي لأوروبا وأمريكا الشمالية)",
 "carrefour": "تقاطع (نقطة التقاء حيث يعبر شارع أو طريق شارعاً آخر)",
 "carrel": "كابينة دراسة, مقصورة دراسة (منطقة دراسة فردية صغيرة في مكتبة)",
 "carrell": "كابينة دراسة, مقصورة دراسة (منطقة دراسة فردية صغيرة في مكتبة)",
 "carriage": "عَرَبَة",
 "carriage bolt": "مسمار العربة, مسمار ملولب (مسمار مستدير الرأس للأخشاب؛ ملولب على جزء من الساق؛ يُدخل في ثقوب محفورة مسبقاً)",
 "carriage dog": "كلب دلماسي (سلالة كبيرة لها معطف أبيض ناعم مع بقع سوداء أو بنية؛ نشأت في دالماتيا)",
 "carriage house": "مبنى العربات (مبنى صغير لإيواء العربات والمركبات الأخرى)",
 "carriage return": "عودة الحاملة (العملية التي تمهد لطباعة أو عرض الحرف التالي كأول حرف في السطر)",
 "carriage trade": "تجارة الطبقة الراقية (التجارة مع عملاء من الطبقة العليا)",
 "carriage wrench": "مفتاح العربات (مفتاح ربط مصمم للاستخدام مع مسامير العربات)",
 "carriageway": "مَسْلَك (المَسْلَك: الطريقُ سلكنا مَسْلكًا لم يسلكه أحد من قبل ، - مسالك الجبال ، - هذا مَسْلك وعر؛ المَسْلَك: سلوك، تصرُّف)\nمثال: يعرف السكان المحليون ذلك المسلك.",
 "carrick bend": "عقدة كاريك (عقدة تستخدم لربط نهايات حبلين كبيرين أو كبلات)",
 "carrick bitt": "عمود الرافعة (أحد زوجين من الأعمدة القوية التي تدعم الرافعة (الملفاف) على سطح السفينة)",
 "carried away": "اِنْدَفَعَ, اِنْجَرَفَ",
 "carrier": "نَاقِل / مَوْجَة حامِلة / حَامِل, حَمَلَة (اسم فاعل من حَمَلَ، أي الذي يحمل شيئا؛ امرأة حَامِل: حُبْلَى، في بطنها جَنْيِن، وإذا أريد اسم الفاعل يقال للمرأة حَامِلَة)\nمثال: يبدو أنني حامل.",
 "carrier bag": "كيس, كيس ورقي (كيس مصنوع من الورق أو البلاستيك لحمل مشتريات الزبائن)",
 "carrier electrophoresis": "رحلان كهربائي ورقي (رحلان كهربائي يتم إجراؤه على ورق الترشيح)",
 "carrier pigeon": "حَمامَةٌ زاجِلة, حَمامٌ زاجِلٌ",
 "carrier wave": "موجة حاملة",
 "carrion": "جِيفة, فَطِيسَة",
 "carrion crow": "نسر أسود أمريكي (نسر أمريكي أصغر من النسر الرومي)",
 "carrion flower": "زهرة الجيفة, زهرة نجم البحر",
 "carrion fungus": "فطر الجيفة, فطر القرن النتن (أي من الفطريات المختلفة ذات القبعة البنية كريهة الرائحة من رتبة فالاليس)\nمثال: تجذب الرائحة الكريهة لفطر القرن النتن الحشرات التي تحمل الأبواغ بعيداً على أقدامها",
 "carrizo": "قصب الخنادق, قيصوب شائع (قصب طويل من أمريكا الشمالية له أوراق عريضة نسبياً وعناقيد كبيرة تشبه الريش؛ واسع الانتشار في المناطق الرطبة؛ يستخدم للحصير والستائر وأعمدة السهام)",
 "carron oil": "زيت كارون (مرهم كان يستخدم سابقاً لعلاج الحروق)",
 "carrot": "جَزَر, جزر (جَزَرَ الماءُ عن الأَرضِ يَجْزُرُ جَزْراً: نَضَبَ وحَسَرَ؛ ويقال: جَزَرَ البَحْرُ والنَّهْرُ: انْحسرَ ماؤُهُ)\nمثال: ضع الجزر في القدر.",
 "carrot and stick": "الْعَصَا وَٱلْجَزَرَة",
 "carrot juice": "عصير الجزر (عصير جزر معصور طازجاً عادة)",
 "carrot pudding": "بودينغ الجزر (بودينغ مصنوع من الجزر المبشور)",
 "carrot soup": "شوربة الجزر (حساء مصنوع من الجزر ومكونات أخرى)",
 "carrot stick": "أعواد الجزر (عود من الجزر يُؤكل نيئاً)",
 "carrottop": "أحمر الشعر, أصهب (شخص ذو شعر أحمر)",
 "carroty": "جزري (يشبه اللون البرتقالي الساطع لجذر نبات الجزر)\nمثال: صبي ذو شعر جزري اللون",
 "carrousel": "أرجوحة دوارة, دوامة الخيل (آلة دوارة كبيرة بها مقاعد لركوب الأطفال للتسلية) / دوارة الأمتعة, سير الحقائب (حزام ناقل يحمل الأمتعة ليتم استلامها من قبل المسافرين جواً)",
 "carry": "حَمَلَ (رَفَعَ، أَقَلَّ)\nمثال: حمل سامي سلاحه.",
 "carry out": "شَغَّلَ, نَفَّذَ ((شَغَلَ) الدارَ يَشْغَلَ شَغْلًا: سكنها؛ شَغَلَ فلانًا عن الشيء: لَهَّاهُ وصرَفَه)\nمثال: شغل بيل التلفاز.",
 "carry-forward": "أَرْبَاح مُرَحَّلَة, فَائِض مُرَحَّل (الأرباح المتراكمة وغير الموزعة لشركة ما بعد رصد مخصصات للأرباح الموزعة والاحتياطيات)",
 "carry-on": "حقيبة محمولة باليد (في الطائرة) (الأمتعة أو الحقائب التي تؤخذ إلى داخل الطائرة مع الراكب، بدلاً من شحنها)",
 "carry-over": "نقل التدريب, نقل التعلم (تطبيق مهارة تم تعلمها في موقف ما على موقف مختلف ولكنه مشابه) / أَرْبَاح مُرَحَّلَة, فَائِض مُرَحَّل (الأرباح المتراكمة وغير الموزعة لشركة ما بعد رصد مخصصات للأرباح الموزعة والاحتياطيات)",
 "carryall": "حقيبة حمل, حقيبة كبيرة (حقيبة أو سلة واسعة تتسع لأشياء كثيرة)",
 "carrycot": "سرير نقال, مهد محمول (سرير أطفال على شكل صندوق له مقابض (لينام فيه الطفل أثناء حمله))",
 "carrying charge": "تكلفة الاحتفاظ, رسوم الحمل (تكلفة الفرصة البديلة للأصول غير المنتجة؛ المصاريف المتكبدة عن الملكية) / تكلفة التمويل, رسم إداري (رسم يتم فرضه لحمل حساب أو لبضائع مباعة بخطة تقسيط)",
 "carrying cost": "تكلفة الاحتفاظ, رسوم الحمل (تكلفة الفرصة البديلة للأصول غير المنتجة؛ المصاريف المتكبدة عن الملكية)",
 "carrying into action": "أداء, تنفيذ (فعل الأداء؛ القيام بشيء بنجاح؛ استخدام المعرفة بدلاً من مجرد امتلاكها)\nمثال: انتقدوا أداءه كرئيس للبلدية",
 "carrying out": "أداء, تنفيذ (فعل الأداء؛ القيام بشيء بنجاح؛ استخدام المعرفة بدلاً من مجرد امتلاكها) / تطبيق, تنفيذ (عملية إنجاز هدف ما أو تنفيذ أمر ما)\nمثال: انتقدوا أداءه كرئيس للبلدية",
 "carsick": "مُصَاب بِدُوَار السَّفَر (يعاني من دوار ناتج عن الحركة كالسفر بالسيّارة أو الطائرة أو السفينة)",
 "cart": "عَرَبَةُ نَقْل, عَرَبَة",
 "cart horse": "حصان الجر, حصان العربة (حصان جر يُربى لسحب العربات)",
 "cart track": "طريق العربات, مسار (أي طريق أو ممر يتيح المرور خاصة إذا كان وعراً)",
 "cart-track plant": "لسان الحمل الكبير, لسان الحمل عريض الأوراق (نبات معمر أوروبي شائع تم توطينه في جميع أنحاء العالم؛ يعتبر عشباً ضاراً مزعجاً)",
 "cartage": "نقل بالعربات (عمل نقل شيء ما بعربة أو شاحنة والتخلص منه)",
 "cartagena": "قَرْطَاجَنَّة / قَرْطَاجَنَّة, كَارْتَاخِينَا",
 "cartagena bark": "كينا قرطاجنة, لحاء قرطاجنة (شجرة كولومبية؛ مصدر للحاء قرطاجنة (نوع من لحاء الكينا))",
 "carte": "قائمة طعام (قائمة بالأطباق المتاحة في مطعم)\nمثال: كانت قائمة الطعام باللغة الفرنسية",
 "carte blanche": "تَفْوِيض مُطْلَق, ضَوْء أَخْضَر",
 "carte du jour": "قائمة طعام (قائمة بالأطباق المتاحة في مطعم)\nمثال: كانت قائمة الطعام باللغة الفرنسية",
 "cartel": "اتحاد احتكاري, كارتل (ائتلاف من المنظمات المستقلة تم تشكيله للحد من المنافسة من خلال التحكم في إنتاج وتوزيع منتج أو خدمة)\nمثال: أقاموا الاتحاد الاحتكاري على أمل الحصول على احتكار",
 "cartelization": "تكتل احتكاري, كارتل (عملية تشكيل كارتل، تحدث عادة في الصناعات التي تسيطر عليها قلة)",
 "carter": "كارتر",
 "carter administration": "إدارة كارتر (السلطة التنفيذية في عهد الرئيس كارتر)",
 "cartesian": "ديكارتي (من أو يتعلق برينيه ديكارت أو أعماله) / دِيكارْتِيّ (تابع للفكر الديكارتي (رينيه ديكارت))\nمثال: لسانيات ديكارتية",
 "cartesian coordinate": "إِحْدَاثِيّ دِيكَارْتِيّ (أحد الإحداثيات في نظام يحدد نقطة في مستوى أو فراغ عبر بعدها عن خطين أو ثلاثة مستويات على التوالي؛ الخطان أو تقاطعات المستويات الثلاثة هي محاور…)",
 "cartesian coordinate system": "نظام إحداثيات ديكارتية (نظام إحداثيات تكون فيه إحداثيات نقطة ما هي مسافاتها من مجموعة خطوط متعامدة تتقاطع عند أصل النظام)",
 "cartesian plane": "المستوى الديكارتي (مستوى يمكن وصف جميع النقاط فيه بإحداثيات ديكارتية)",
 "carthage": "قَرْطَاج",
 "carthaginian": "قرطاجي",
