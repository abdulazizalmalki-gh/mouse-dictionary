 "campana": "جرس, شكل جرسي (شكل الجرس)",
 "campania": "كامبانيا, كمبانية",
 "campanile": "برج الناقوس, منارة الجرس (برج جرس؛ عادة ما يقف منفرداً غير متصل بمبنى)",
 "campanula": "جريس, زهرة الجرس",
 "campanula americana": "جريس طويل (حولي أو معمر من شرق أمريكا الشمالية مع سنابل طويلة من الزهور الزرقاء أو البيضاء)",
 "campanula aparinoides": "جريس المستنقع (زهرة الجرس شائعة في مستنقعات شرق أمريكا الشمالية ذات أوراق سنانية خطية وأزهار بيضاء صغيرة)",
 "campanula carpatica": "جريس كارباتي, جريس منتشر (زهرة جرس أوروبية معمرة تنمو في كتل بسيقان منتشرة وأزهار زرقاء أو بيضاء)",
 "campanula divaricata": "جريس جنوبي (زهرة الجرس من جنوب شرق الولايات المتحدة (ماريلاند إلى جورجيا) ذات أزهار زرقاء شاحبة)",
 "campanula glomerata": "جريس عنقودي (زهرة الجرس من أوروبا إلى آسيا المعتدلة ذات سنابل كثيفة من الزهور الزرقاء البنفسجية إلى البيضاء)",
 "campanula medium": "جريس متوسط, كأس وصحن (نبات أوروبي ثنائي الحول يزرع على نطاق واسع لأزهاره الزرقاء أو البنفسجية أو البيضاء)",
 "campanula persicifolia": "جريس خوخي الأوراق (زهرة جرس أوروبية معمرة بأزهار عنقودية بيضاء أو زرقاء)",
 "campanula pyramidalis": "جريس هرمي, نبات المدخنة (زهرة الجرس من جنوب شرق أوروبا)",
 "campanula rapunculoides": "جريس زاحف (عشبة أوروبية منتصبة ذات جذور زاحفة وسنابل متدلية من الزهور الزرقاء إلى البنفسجية)",
 "campanula rapunculus": "جريس اللفت, جريس رابونكولوس (زهرة الجرس من أوروبا وآسيا وشمال أفريقيا ذات أزهار مزرقة وجذر درني صالح للأكل يستخدم مع الأوراق في السلطة)",
 "campanula rotundifolia": "جريس, جريس مستدير الأوراق (نبات معمر من نصف الكرة الشمالي ذو سيقان نحيلة وأزهار زرقاء على شكل جرس)",
 "campanula trachelium": "جريس قراصي الأوراق, عشبة الحلق (زهرة جرس أوروبية بأزهار زرقاء بنفسجية إلى ليلكية كانت تستخدم سابقاً لعلاج التهاب الحلق)",
 "campanular": "جرسي الشكل (على شكل جرس)\nمثال: أزهار جرسية الشكل لجنس كامبانولا",
 "campanulate": "جرسي الشكل (على شكل جرس)\nمثال: أزهار جرسية الشكل لجنس كامبانولا",
 "campanulated": "جرسي الشكل (على شكل جرس)\nمثال: أزهار جرسية الشكل لجنس كامبانولا",
 "campeachy": "خشب الدم, شجرة خشب البقم (شجيرة شائكة أو شجرة صغيرة من أمريكا الوسطى وجزر الهند الغربية لها أوراق ثنائية الريش وعناقيد من الزهور الصفراء الزاهية الصغيرة وتنتج خشباً قلبياً…)",
 "campephilus principalis": "نقار الخشب عاجي المنقار (نقار خشب كبير أسود وأبيض من جنوب الولايات المتحدة وكوبا له منقار عاجي؛ شبه منقرض)",
 "camper": "عربة تخييم, منزل متنقل (مركبة ترفيهية مجهزة للتخييم أثناء السفر) / مخيم (شخص يعيش مؤقتاً في خيمة أو كوخ للترفيه)",
 "camper trailer": "مقطورة تخييم (مقطورة مجهزة للسكن (خاصة لرحلات العطلات))",
 "campestral": "بَرِّيّ, سَهْلِيّ (متعلّق بالسهول أو الأراضي المفتوحة)",
 "campfire": "نَار مُخَيَّم (نارَتِ النارُ: أضاءَت؛ نَارَ النَّارَ مَنْ بَعِيدٍ : أَبْصَرَهَا، نَظَرَ إِلَيْهَا، تَأَمَّلَهَا)\nمثال: سمعن طلقات نار.",
