 "brownish-speckled": "مُنَمَّش بِالبُنِّيّ (ذو نمش بنّيّ اللون)",
 "brownish-striped": "مُخَطَّط بِالبُنِّيّ (ذو خطوط بنّيّة اللون)",
 "brownish-yellow": "أَصْفَر بُنِّيّ, كَهْرَمَانِيّ (ذو لون أصفر بنّيّ متوسّط إلى داكن)",
 "brownness": "بني, سمرة (برتقالي منخفض السطوع والتشبع)",
 "brownout": "انقطاع الكهرباء, تعتيم (الظلام الناتج عن إطفاء الأنوار (كما في مدينة غير مرئية لطائرات العدو))",
 "brownshirt": "صاحب القميص البني (عضو في القوات شبه العسكرية النازية التي كانت ترتدي زياً بنياً)",
 "brownstone": "منزل الحجر البني (منزل متلاصق مبني من الحجر الرملي البني؛ لونه بني محمر) / حجر رملي بني (حجر رملي بني محمر؛ يستخدم في المباني)",
 "browntail": "عثة بنية الذيل (عثة أوروبية صغيرة بنية وبيضاء أُدخلت إلى شرق الولايات المتحدة؛ آفة لأشجار الظل والفاكهة المتنوعة)",
 "browse": "تَصَفَّحَ, اِسْتَعْرَضَ",
 "browser": "متصفح, متصفح ويب / متصفح (مشاهد ينظر حوله بشكل عارض دون البحث عن شيء معين)",
 "browsing": "رعي, قضم الأوراق (فعل التغذية عن طريق القضم المستمر) / تصفح (القراءة بشكل سطحي أو عشوائي)",
 "brucella": "بروسيلا, مجهضة (عصوية مكورة هوائية سالبة الجرام تسبب داء البروسيلات؛ يمكن استخدامها سلاحاً بيولوجياً)",
 "brucellosis": "حمى مالطية, حمى متموجة (مرض بكتيري معد يصيب البشر ينتقل عن طريق الاتصال بالحيوانات المصابة أو اللحوم أو منتجات الألبان المصابة؛ يتميز بالحمى والصداع) / إجهاض معدي, حمى مالطية (مرض معد يصيب الحيوانات الأليفة يؤدي غالبًا إلى الإجهاض التلقائي؛ يمكن أن ينتقل إلى البشر)",
 "bruchus pisorum": "سوسة البازلاء (تعيش اليرقات وتتغذى في بذور نبات البازلاء)",
 "brucine": "بروسين (سم قلويدي مر يشبه الستريكنين ويستخرج من الجوز المقيئ)",
 "bruckenthalia spiculifolia": "خلنج السنابل (شجيرة صغيرة دائمة الخضرة تشكل حصيرة من جنوب أوروبا وآسيا الصغرى لها سيقان صلبة وعناقيد طرفية من زهور جرسية صغيرة)",
 "brugmansia arborea": "بوق الملاك, داتورا شجرية (نبات من أمريكا الجنوبية يزرع لزهوره الكبيرة العطرة بوقية الشكل)",
 "brugmansia sanguinea": "بروجمانسيا دموية, بوق الملاك الأحمر (شجيرة شجرية من أمريكا الجنوبية لها زهور برتقالية حمراء كبيرة جداً)",
 "brugmansia suaveolens": "بروجمانسيا عطرة, بوق الملاك (نبات من أمريكا الجنوبية يزرع لزهوره الكبيرة جداً بوقية الشكل العطرة ليلاً)",
 "bruin": "دب بني (دب شرس كبير من أوراسيا) / بروين (اسم تقليدي للدب يستخدم في الحكايات اتباعاً للاستخدام في الملحمة القديمة 'رينارد الثعلب')",
 "bruise": "كَدَمَ / كَدْمَة, رَضّ",
 "bruiser": "ثور, رجل قوي (رجل ضخم وقوي وثقيل الوزن)\nمثال: كان رجلاً كالثور",
 "bruising": "سَاحِق, مُؤْلِم (قاسٍ وقويّ وجبريّ) / مُؤْلِم, مُوجِع (يُسَبِّب كَدَمات أو أَلَمًا جَسَدِيًّا)",
 "bruitism": "الضوضائية (استخدام الأصوات المأخوذة من مصدر أو سياق غير موسيقي في الموسيقى. يستخدم المصطلح غالباً للإيقاع أو الموسيقى الإلكترونية التي توحي بأصوات الآلات)\nمثال: الأكثر جوهرية، وإن كانت مزعجة محلياً فقط، كانت ضوضائية المستقبليين التي استخدمت أصوات البيئة غير الموسيقية - وتحديداً الضجيج",
 "brule": "برولي (فرد من مجموعة من الشعب السيوي شكلت قسماً من تيتون سيوكس)",
 "brumaire": "بْرُومَيْر",
 "brumal": "شِتْوِيّ (يتّصف بالشتاء أو يتعلّق به)",
 "brummagem": "رَخِيصٌ وَمُبَهْرَج (زَهِيدُ الثَّمَنِ وَاسْتِعْرَاضِيّ)",
 "brummie": "برومي (مواطن أو مقيم في برمنغهام، إنجلترا)",
 "brummy": "برومي (مواطن أو مقيم في برمنغهام، إنجلترا)",
 "brumous": "ضَبَابِيّ, مُعْتِم (ممتلئ بالضباب أو السديم)",
 "brunch": "برانش, فطور متأخر (مزيج من الإفطار والغداء؛ يُقدم عادة في وقت متأخر من الصباح)",
 "brunch coat": "روب منزلي قصير (روب منزلي قصير أو غطاء للمرأة)",
 "brunei": "بْرُونَاي",
 "brunei dollar": "دولار بروناي (وحدة المال الأساسية في بروناي)",
 "bruneian": "بروناوي, بروناي (من أو متعلق أو مميز لبروناي أو شعبها) / بروناوي (مواطن أو ساكن في بروناي)\nمثال: إنتاج النفط في بروناي",
 "brunet": "أَسْمَر (يتميز بتصبغ داكن أو داكن نسبياً للشعر أو الجلد أو العينين) / أسمر, داكن الشعر (شخص ذو شعر داكن (بني عادة))\nمثال: جمال أسمر",
 "brunette": "امرأَة ذات شعر بني أو أسود (أُنْثَى الْإِنْسَانِ الْبَالِغَةُ؛ زَوْجَةٌ) / سمراء / سَمْرَاء\nمثال: أنا امرأة قوية.",
 "brunfelsia americana": "برونفيلسيا أمريكية, سيدة الليل (شجيرة من جزر الهند الغربية بزهور بيضاء مصفرة بارزة عطرة)",
 "bruno": "بْرُونُو",
 "brunswick stew": "يخنة برونزويك (طبق جنوبي حار: دجاج (أو صيد صغير) مع الذرة والطماطم وفاصوليا ليما والبامية والبصل والبطاطس)",
 "brunt": "جُلّ, مُعْظَم",
 "bruschetta": "بْرُوسْكِيتَّا",
 "brush": "فُرْشَاة / فَرَشَ / مَشَّطَ (سرح الشعر باستخدام مشط؛ نظف أو مرر شيئًا باستخدام مشط أو أداة مشابهة)\nمثال: مشط شعرك قبل أن تخرج.",
 "brush cut": "قَصَّة الفُرْشَاة (قصة شعر قصيرة يكون فيها الشعر واقفاً كالفرشاة)",
 "brush discharge": "تفريغ فرجوني, تفريغ هالي (تفريغ بين الأقطاب الكهربائية يخلق خيوطاً مرئية من الجسيمات المتأينة)",
 "brush fire": "حريق الأحراش (حريق غير منضبط يلتهم الشجيرات والأحراش)",
 "brush kangaroo": "ولب (أي من كنغر صغير أو متوسط الحجم متنوع؛ غالباً ما يكون زاهي الألوان)",
 "brush one's teeth": "نَظَّفَ الْأَسْنَان",
 "brush turkey": "ديك رومي الفرشاة (طائر ميغابود أسود من المناطق المشجرة في أستراليا وغينيا الجديدة)",
 "brush wolf": "ذئب البراري, قيوط (ذئب صغير موطنه غرب أمريكا الشمالية)",
 "brush-footed butterfly": "حورية (فراشات متوسطة إلى كبيرة توجد في جميع أنحاء العالم تتميز عادة بأجنحة زاهية الألوان وأرجل أمامية غير وظيفية مختزلة جداً مطوية على الصدر)",
 "brush-off": "رفض جاف, صد (رفض مقتضب أو ازدرائي)",
 "brush-tail porcupine": "شيهم ذو ذيل الفرشاة (شيهم ذو خصلة من شعيرات كبيرة مطرزة على الذيل)",
 "brush-tailed phalanger": "بوسوم كثيف الذيل (بوسوم ذو ذيل كثيف الشعر)",
 "brush-tailed porcupine": "شيهم ذو ذيل الفرشاة (شيهم ذو خصلة من شعيرات كبيرة مطرزة على الذيل)",
 "brushed": "مُخْمَلِيّ, وَبَرِيّ (ذو سَطْح مَمْشوط أو وَبَرِيّ ناعِم) / مَفْرُوش, مُمَشَّط ((لِلشَّعْرِ أَوِ المَلَابِسِ) مَعْنِيٌّ بِالفُرْشَاة) / مَمْسُوح بِخِفَّة (لُمِس بخفة عند المرور؛ احتُكَّ به)",
 "brushing": "تمشيط بالفرشاة (فعل تمشيط شعرك بالفرشاة) / تفريش, تنظيف بالفرشاة (فعل تنظيف أسنانك بالفرشاة)\nمثال: أعطى شعره تمشيطاً سريعاً",
 "brushing machine": "آلة تمشيط, آلة تنعيم (آلة نسيج تستخدم في عملية التشطيب لتحسين مظهر القماش)",
 "brushlike": "شَبِيه بِالفُرْشَاة (يُشبه الفرشاة في هيئته)",
 "brushmaker": "صَانِعُ الْفُرَش (كل من يَصْنَعُ شيئا؛ من يَمْتَهِنُ الصِّنَاعَة)\nمثال: أحب أن أكون صانع محتوى.",
 "brushup": "تنشيط, مراجعة (ممارسة تهدف إلى صقل الأداء أو إنعاش الذاكرة)",
 "brushwood": "أجمة, دغل (نمو كثيف للشجيرات) / حطب, خشب الغابة (الخشب من الشجيرات أو الفروع الصغيرة)\nمثال: أشعلوا ناراً من الحطب",
 "brushwork": "أسلوب الرسم, ضربة الفرشاة (التقنية المميزة للفنان في تطبيق الطلاء بفرشاة)",
 "brushy": "شُجَيْرِيّ, كَثِير الأَدْغَال (مغطّى بالشجيرات والأدغال أو يتكوّن منها)",
 "brusk": "فَظّ, مُقْتَضَب (يتسم بالقصور الوقح أو الاستعلائي في الكلام)",
 "brusque": "فَظّ, مُقْتَضَب (يتسم بالقصور الوقح أو الاستعلائي في الكلام)",
 "brusquely": "بِصَرَاحَة فَجَّة, بِفَظَاظَة (بطريقة مباشرة فظة)\nمثال: تحدث بفظاظة",
 "brusqueness": "جفاء, غلظة (أسلوب فظ مفاجئ)",
 "brussels": "بْرُوكْسِل, بْرُوسِيل / بْرُوكْسِل, بروسيل",
 "brussels biscuit": "بسكويت محمص, بقسماط (شريحة من الخبز المخمر الحلو تخبز مرة ثانية حتى تصبح بنية وصلبة ومقرمشة)",
 "brussels carpet": "سجاد بروكسل (سجادة ذات سداة كتان قوية وبر من خيوط صوفية ملونة مسحوبة في حلقات غير مقطوعة لتشكيل نمط)",
 "brussels griffon": "غريفون, غريفون بروكسل (سلالة من الكلاب الصغيرة جداً المدمجة ذات الشعر السلكي من أصل بلجيكي ولها خطم ملتح قصير)",
 "brussels lace": "دانتيل بروكسل (دانتيل فاخر بتصميم بارز أو مطرز)",
 "brussels sprout": "كُرُنْب بْرُوكْسِل",
 "brussels sprouts": "كرنب بروكسل (البراعم الصغيرة الصالحة للأكل التي تشبه الملفوف والتي تنمو على طول ساق نبات كرنب بروكسل)",
 "brut": "بْرُوت, شَدِيد الجَفَاف ((للشمبانيا) شديد الجفاف؛ بأقل نسبة سكر)",
 "brutal": "فَظّ, قَاسِي الصَّرَاحَة (مُبَاشِر وَدَقِيق بِشَكْلٍ مُنَفِّر) / قَاسٍ, هَمَجِيّ ((عن الأشخاص أو أفعالهم) قادر على إلحاق الألم أو المعاناة أو مُيّال لذلك) / بَهِيمِيّ, حَيَوَانِيّ (يُشبه الوحش؛ يُظهر انعدام الحِسّ الإنساني) / قَاسٍ, لَا يَرْحَم (بَالِغُ القَسْوَةِ بِشَكْلٍ مُؤْلِم)",
 "brutalisation": "إفساد, توحش (فعل يجعل الناس قساة أو مفتقرين للصفات الإنسانية الطبيعية) / معاملة وحشية, وحشية (نشاط معاملة شخص ما بوحشية أو ضراوة) / توحش, معاملة وحشية (حالة التعرض لمعاملة قاسية ووحشية)",
 "brutality": "وحشية",
 "brutalization": "إفساد, توحش (فعل يجعل الناس قساة أو مفتقرين للصفات الإنسانية الطبيعية) / معاملة وحشية, وحشية (نشاط معاملة شخص ما بوحشية أو ضراوة) / توحش, معاملة وحشية (حالة التعرض لمعاملة قاسية ووحشية)",
 "brutally": "بضراوة, بوحشية (بطريقة وحشية)\nمثال: هوجم بوحشية",
 "brute": "حيوان, كائن حي (كائن حي يتميز بالحركة الإرادية) / همجي, وحش (شخص قاسي وجشع)",
 "brutish": "بَهِيمِيّ, حَيَوَانِيّ (يُشبه الوحش؛ يُظهر انعدام الحِسّ الإنساني)",
 "brutishly": "بِبَهَائِمِيَّة, بِوَحْشِيَّة (على طريقة الوحش)\nمثال: عاملت زوجها بوحشية",
 "bruxism": "صرير الأسنان",
 "brya ebenus": "شجرة غرانديلا, غرانديلو (شجرة من جزر الهند الغربية تنتج نوعية جيدة من الأبنوس الأخضر)",
 "bryan": "براين",
 "bryansk": "بْرْيَانْسْك",
 "bryanthus": "بريانثوس (شجيرة دائمة الخضرة منبطحة تشكل حصيرة من العالم القديم مع عناقيد من الزهور البيضاء الوردية)",
 "bryanthus taxifolius": "خلنج الجبل (شجيرة صغيرة بأوراق دائمة الخضرة وزهور وردية أو أرجوانية؛ القمم الألبية والأراضي المرتفعة في آسيا وأوروبا والولايات المتحدة)",
 "bryonia alba": "فاشرا بيضاء, لفت الشيطان (كرمة بيضاء الزهر ذات جذور سميكة وتحمل توتاً أسود صغيراً؛ من أوروبا إلى إيران)",
 "bryonia dioica": "جنجل بري, فاشرا حمراء (فاشرا ذات جذور لحمية وأزهار خضراء باهتة وتوت أحمر صغير جداً؛ توجد في أوروبا وشمال أفريقيا وغرب آسيا)",
 "bryony": "فَاشِرَا",
 "bryophyte": "نبات طحلبي, نبات لا وعائي (أي من النباتات العديدة من قسم النباتات الطحلبيه)",
 "bryophytic": "حزازي (متعلق بنباتات شعبة الحزازيات)",
 "bryozoan": "حيوان طحلبي, مرجانيات (حيوان مائي لاطئ يشكل مستعمرات طحلبية من سلائل صغيرة)",
 "brythonic": "البريثونية, البريطانية (مجموعة جنوبية من اللغات الكلتية)",
 "bs": "بكالوريوس العلوم (درجة البكالوريوس في العلوم)",
 "bsarch": "بكالوريوس العلوم في الهندسة المعمارية (درجة البكالوريوس في الهندسة المعمارية)",
 "bse": "اعتلال دماغي إسفنجي بقري, مرض جنون البقر (مرض قاتل للماشية يصيب الجهاز العصبي المركزي؛ يسبب الترنح والهياج)",
 "btu": "وحدة حرارية بريطانية (وحدة حرارة تساوي كمية الحرارة اللازمة لرفع رطل واحد من الماء درجة فهرنهايت واحدة عند ضغط جوي واحد)",
 "bubaline": "جاموسي (يتعلق بالجاموس أو يشبهه)",
 "bubalus bubalis": "جاموس الماء (جاموس آسيوي غالباً ما يتم استئناسه لاستخدامه كحيوان جر)",
 "bubalus mindorensis": "تاماراو (جاموس صغير في ميندورو بالفلبين)",
 "bubble": "فُقَّاعَة",
 "bubble and squeak": "بابل أند سكويك (بقايا ملفوف مقلية مع بطاطس مطبوخة وأحياناً اللحم)",
 "bubble bath": "حمام فقاعات (حمام يضاف إليه مادة لتكوين رغوة وتعطير ماء الاستحمام) / رغوة الحمام (مستحضر بلوري أو مسحوق أو سائل يُرغي في ماء الاستحمام ويعطره وينعمه)",
 "bubble chamber": "غرفة الفقاقيع (جهاز يسجل مسارات الجسيمات المؤينة)",
 "bubble dance": "رقصة الفقاعات (رقصة فردية تشبه رقصة المروحة إلا أنه يتم استخدام بالونات كبيرة بدلاً من المراوح)",
 "bubble gum": "علكة الفقاعات (نوع من العلكة يمكن نفخه لعمل فقاعات)",
 "bubble gum dermatitis": "التهاب جلد العلكة الفقاعية (التهاب جلد تماسي تحسسي يتطور حول شفاه الأطفال الذين يمضغون العلكة الفقاعية)",
 "bubble jet printer": "طابعة نفث الفقاعات (نوع من طابعات نفث الحبر)",
 "bubble pack": "عبوة فقاعية (تغليف يتم فيه ختم المنتج بين دعامة من الورق المقوى وغطاء بلاستيكي شفاف)",
 "bubble shell": "صدفة فقاعية (رخوي بطني القدم بحري له صدفة رقيقة صغيرة جداً)",
 "bubble sort": "فَرْز فُقّاعِيّ",
 "bubble-jet printer": "طابعة نفث الفقاعات (نوع من طابعات نفث الحبر)",
 "bubblejet": "طابعة نفث الفقاعات (نوع من طابعات نفث الحبر)",
 "bubbler": "جهاز فقاعات, فوارة (أي من الأجهزة المختلفة التي يتم فيها تمرير الهواء أو غاز آخر عبر سائل على شكل فقاعات) / سبيل ماء, نافورة شرب (نافورة عامة لتوفير تيار من مياه الشرب)",
 "bubbliness": "رغوية, فوران (خاصية إطلاق فقاعات)",
 "bubbling": "فَوَّار, مُتَأَلِّق (يتميّز بروح عالية أو حماسة متّقدة) / رَغْوِيّ, فَقَّاعِيّ (يُصدر فقاعات أو مليء بها كما في المشروبات الغازيّة أو التخمير)",
 "bubbly": "فَقَّاعِيّ, مَرِح (مليء بالبهجة والمرح أو يُظهرهما) / رَغْوِيّ, فَقَّاعِيّ (يُصدر فقاعات أو مليء بها كما في المشروبات الغازيّة أو التخمير) / شامبانيا (نبيذ أبيض فوار يُنتج إما في منطقة شامبانيا أو يشبه ذلك المنتج هناك)",
 "bubo": "دبل (عقدة لمفاوية ملتهبة ومتورمة بسبب الطاعون أو السيلان أو السل)",
 "bubo virginianus": "بومة قرناء كبيرة (بومة قرناء بنية من أمريكا الشمالية)",
 "bubonic": "دملي, طاعوني (متعلق أو مظهر للدمل (خاصة في الطاعون))\nمثال: طاعون دملي",
 "bubonic plague": "طاعون دملي (الشكل الأكثر شيوعًا للطاعون لدى البشر؛ يتميز بقشعريرة وإعياء وهذيان وتكون دمامل في الإبطين والفخذ؛ لا ينتشر من شخص لآخر)",
 "bubulcus ibis": "أبو قردان, بلشون القطعان (بلشون أبيض صغير واسع الانتشار في المناطق الدافئة غالباً ما يوجد حول حيوانات الرعي)",
 "buccal": "فموي (متعلق بالفم أو منطقة الفم أو السطح الذي يقع عليه الفم) / شدقي (من أو متعلق بـ أو باتجاه الخد)\nمثال: التجويف الفموي",
 "buccal artery": "شريان شدقي (فرع من الشريان الفكي العلوي يغذي العضلة المبوقة والخد بالدم)",
 "buccal cavity": "تجويف فموي (التجويف بين الفكين والخدين)",
 "buccaneer": "قرصان (شخص يسرق في البحر أو ينهب الأرض من البحر دون أن يكون لديه تفويض من أي دولة ذات سيادة)",
 "buccaneering": "قرصنة (الاختطاف في أعالي البحار أو في سياقات مماثلة؛ أخذ سفينة أو طائرة بعيداً عن سيطرة الأشخاص المخولين قانوناً بذلك)\nمثال: القرصنة الجوية",
 "buccinator muscle": "عضلة مبوقة (عضلة تسطح الخد وتسحب زاوية الفم)",
 "buccula": "ذقن مزدوج (طية من الأنسجة الدهنية تحت الذقن)",
 "bucephala albeola": "بطة برأس الجاموس (بطة غواصة صغيرة من أمريكا الشمالية؛ الذكور لديهم ريش رأس كثيف)",
 "bucephala clangula": "بطة ذهبية العين (بطة غواصة كبيرة الرأس سريعة الطيران من المناطق القطبية)",
 "bucephala islandica": "ذهبية العين بارو (بط غواص من نوع ذهبية العين يعيش في أمريكا الشمالية)",
 "bucephela albeola": "بطة برأس الجاموس (بطة غواصة صغيرة من أمريكا الشمالية؛ الذكور لديهم ريش رأس كثيف)",
 "bucephela clangula": "بطة ذهبية العين (بطة غواصة كبيرة الرأس سريعة الطيران من المناطق القطبية)",
 "bucha": "بُوتْشَا",
 "bucharest": "بُوخَارِسْت",
 "buchloe dactyloides": "عشب الجاموس (عشب قصير ينمو في السهول الجافة بوسط الولايات المتحدة (حيث يتجول الجاموس))",
 "buck": "وَعْل, كَبْش",
 "buck fever": "رهبة الصيد (الإثارة العصبية للصياد قليل الخبرة)",
 "buck private": "جندي (جندي مجند من أدنى رتبة في الجيش أو مشاة البحرية)\nمثال: كان سجيننا مجرد جندي ولم يكن يعرف شيئاً ذا قيمة",
 "buck sergeant": "رَقِيب أَدْنَى (رقيب من أدنى رتبة في الجيش)",
 "buck's fizz": "ميموزا (مشروب مخلوط يحتوي على الشمبانيا وعصير البرتقال)",
 "buck-and-wing": "رقص النقر الحاد (رقصة نقر فردية تركز على النقرات الحادة)",
 "buck-toothed": "أَبْخَق, نَاتِئ الأَسْنَان (له أسنان أمامية علوية بارزة)",
 "buckaroo": "فاكيرو (أسماء محلية لراعي البقر (يستخدم مصطلح \"فاكيرو\" خاصة في جنوب غرب ووسط تكساس))",
 "buckbean": "إطريفل الماء, فاصوليا المستنقعات (نبات معمر في أوروبا وأمريكا له عناقيد من الزهور البيضاء أو الأرجوانية وأوراق ثلاثية شديدة المرارة؛ غالباً ما يتجذر عند حافة الماء وينتشر عبر السطح)",
 "buckboard": "عربة خشبية مفتوحة (عربة مفتوحة تجرها الخيول بأربع عجلات؛ لها مقعد متصل بلوح مرن بين المحورين)",
 "buckeroo": "فاكيرو (أسماء محلية لراعي البقر (يستخدم مصطلح \"فاكيرو\" خاصة في جنوب غرب ووسط تكساس))",
 "bucket": "دَلْو, سَطْل",
 "bucket list": "قائمة أمنيات العمر (قائمة بالأشياء التي تخطط للقيام بها قبل الموت)",
 "bucket seat": "مقعد مقعر, مقعد منفرد (مقعد فردي منخفض كما في السيارات أو الطائرات)",
 "bucket shop": "حانة رخيصة ((سابقاً) صالون رخيص يبيع الخمور بالدلو) / شركة وساطة وهمية, مكتب مراهنات غير قانوني (شركة وساطة غير أخلاقية أو عدوانية بشكل مفرط)",
 "bucketful": "ملء دلو, ملء سطل (الكمية المحتواة في دلو)",
 "buckeye": "أوهايوِي (مواطن أو مقيم في أوهايو) / قسطل الحصان, كستناء الحصان (شجرة ذات أوراق راحية وعناقيد كبيرة من الزهور البيضاء إلى الحمراء تليها بذور بنية لامعة غير صالحة للأكل) / كستناء الحصان (البذرة غير الصالحة للأكل التي تشبه الجوز لكستناء الحصان)",
 "bucking bronco": "حصان جامح (حصان بري شرس وصعب أو مستحيل الترويض)",
 "buckingham palace": "قَصْر بَكِنْغْهَام (ضد الطول؛ غير تام، غير كامل)\nمثال: لقد قصر الخطاب.",
 "buckle": "إِبْزِيم (حديدة الحزام)\nمثال: ذهبت لشراء إبزيم.",
 "buckler": "تُرْس ((تَرَّسَ): توقى بالترس)",
 "buckler fern": "سرخس الدرع (أي من السراخس المتنوعة من أجناس دريوبتريس أو بوليستيشوم أو لاستريوبسيس لها أغطية تشبه الدرع نوعاً ما على البثرات)",
 "buckler mustard": "خردل الترس (نبات من جنوب شرق أوروبا له أزهار صفراء مثل أزهار الخردل وقرون ذات صمامات مفتوحة تشبه التروس)",
 "buckleya": "باكليا (شجيرة طفيلية في شرق الولايات المتحدة لها أوراق متقابلة وزهور خضراء غير مهمة تليها ثمار زيتية خضراء باهتة تشبه الزيتون)",
 "buckleya distichophylla": "باكليا (شجيرة طفيلية في شرق الولايات المتحدة لها أوراق متقابلة وزهور خضراء غير مهمة تليها ثمار زيتية خضراء باهتة تشبه الزيتون)",
 "buckminsterfullerene": "بوكمينستر فوليرين, كرة بوكي (فوليرين كروي؛ أول مثال معروف للفوليرين)",
 "buckram": "مُتَزَمِّت, مُتَصَلِّب (رَسْمِيٌّ بِشَكْلٍ صَارِمٍ وَجَامِدٍ) / بوكرام, قماش مقوى (قماش قطني خشن مقوى بالغراء؛ يستخدم في تجليد الكتب ولتقوية الملابس)",
 "bucksaw": "منشار إطاري, منشار الحطب",
 "buckshee": "مَجَّانِيّ (بِلَا مُقَابِلٍ مَادِّيّ)",
 "buckshot": "خردق الطيور, خردق صيد (خردق رصاصي صغير لخراطيش بنادق الصيد)",
 "buckskin": "حصان أشهب مصفر (حصان ذو لون أسمر مصفر فاتح مع عرف وذيل داكنين) / بوكسكين, جلد الغزال (جلد سويدي ناعم مصفر مصنوع أصلاً من جلد الغزال ولكن الآن عادة من جلد الغنم)",
 "buckskins": "سروال جلد الغزال ((تستخدم بصيغة الجمع) سراويل الركبة المصنوعة من جلد الغزال)",
 "buckthorn": "سِدْر (شَجَرَةُ النَّبْقِ)",
 "buckthorn berry": "توت النبق (فاكهة لنبق مختلف تنتج أصباغاً أو خضاباً)",
 "bucktooth": "سن بارزة (سن أمامية كبيرة بارزة)",
 "bucktoothed": "أَفْقَم",
 "buckwheat": "حِنْطَة سَوْدَاء",
 "buckwheat cake": "فطيرة الحنطة السوداء (بان كيك مصنوع من دقيق الحنطة السوداء)",
 "buckwheat tree": "تيتي, شجرة الحنطة السوداء (شجرة في المناطق الساحلية المنخفضة بجنوب شرق الولايات المتحدة ذات أوراق لامعة وعناقيد من الزهور البيضاء العطرة)",
 "buckyball": "بوكمينستر فوليرين, كرة بوكي (فوليرين كروي؛ أول مثال معروف للفوليرين)",
 "bucolic": "بُكُولِيّ, رَعَوِيّ (يتّسم بطابع الحياة الريفيّة المثاليّة والبساطة الشاعريّة) / رعوي, ريفي (متعلق بالرعاة أو تربية الأغنام والماشية) / أنشودة ريفية, قصيدة رعوية (قصيدة قصيرة تصف الحياة الريفية أو الرعوية) / فلاح, قروي (شخص من الريف)\nمثال: شعب رعوي شبه بدوي",
 "bud": "بُرْعُم",
 "bud brush": "شيح شائك, فرشاة البراعم (نبات معمر ذو قيمة كعلف للأغنام في الولايات المتحدة)",
 "bud sagebrush": "شيح شائك, فرشاة البراعم (نبات معمر ذو قيمة كعلف للأغنام في الولايات المتحدة)",
 "budapest": "بُدَابِسْت, بُودَابِسْت",
 "buddha": "بُوذَا, بُدّ",
 "buddha's hand": "يد بوذا (فاكهة كبيرة تشبه الليمون مقسمة إلى أقسام تشبه الأصابع؛ معظم الأصناف لا تحتوي على لب أو عصير)",
 "buddhism": "بُوذِيَّة, سَمَنِيَّة (المؤنث من \"بُوذِيّ\"؛ ديانة تتبع تعاليم مؤسسها غواتاما بوذا، نشأت في شبه قارة الهند ما بين القرنين السادس والرابع قبل الميلاد)",
 "buddhist": "بُوذِيّ (مِن، أو متعلق بالديانة البوذية؛ أحد أتباع الديانة البوذية وتعليمات مؤسسها وشخصيتها الرئيسية غواتاما بوذا)",
 "buddhistic": "بوذي (متعلق بالبوذية أو مؤيد لها)\nمثال: نحت بوذي",
 "budding": "فِي طَوْرِ النُّمُوّ, نَاشِئ (فِي بِدَايَةِ التَّطَوُّر) / تبرعم (تكاثر بعض الكائنات وحيدة الخلية (مثل الخمائر) عن طريق النمو والتخصص متبوعًا بانفصال جزء من الأصل عن طريق التضييق)",
 "buddleia": "بودليا, شجيرة الفراشة (شجيرة استوائية ذات عناقيد من الزهور البيضاء أو البنفسجية أو الصفراء)",
 "buddy": "رفيق, زميل (صديق مقرب يرافق رفاقه في أنشطتهم)",
 "buddy system": "نظام الرفيق, نظام الزمالة (ممارسة تعاونية تجمع بين شخصين أو أكثر للمساعدة المتبادلة أو السلامة (خاصة في السباحة الترفيهية))",
 "buddy-buddy": "صَدِيق حَمِيم ((غير رسمي) مرتبط بعلاقة وثيقة)",
 "budgereegah": "بادجي, ببغاء الدرة (ببغاء أسترالي صغير عادة ما يكون لونه أخضر فاتح مع علامات سوداء وصفراء في البرية ولكن يتم تربيته بألوان عديدة)",
 "budgerigar": "بُدْجَرِيقَة",
 "budgerygah": "بادجي, ببغاء الدرة (ببغاء أسترالي صغير عادة ما يكون لونه أخضر فاتح مع علامات سوداء وصفراء في البرية ولكن يتم تربيته بألوان عديدة)",
 "budget": "مِيزَانِيَّة, مُوَازَنَة",
 "budget cut": "خفْض الميزانية (عملية تقليل النفقات المدرجة في الميزانية)",
 "budget deficit": "عجز الميزانية (زيادة النفقات على الإيرادات)",
 "budget items": "تكاليف التشغيل, مصاريف إدارية وعامة (نفقات صيانة الممتلكات (مثل دفع الضرائب العقارية والمرافق والتأمين)؛ لا تشمل الإهلاك أو تكلفة التمويل أو ضرائب الدخل)",
 "budgetary": "مالي, ميزاني (من أو يتعلق بالميزانية)\nمثال: اعتبارات الميزانية",
 "budgie": "بادجي, ببغاء الدرة (ببغاء أسترالي صغير عادة ما يكون لونه أخضر فاتح مع علامات سوداء وصفراء في البرية ولكن يتم تربيته بألوان عديدة)",
 "budorcas taxicolor": "تاكين, ماعز الغنو (ظبي ماعز كبير ثقيل البنية يعيش في منطقة الهيمالايا الشرقية)",
 "buenos aires": "بْوِينُس آيْرِس",
 "buff": "جِلْدِيّ اللَّوْن (بلون البيج المائل إلى الاصفرار كالجلد المدبوغ) / أداة تلميع, صاقلة (أداة تتكون من مادة ناعمة مثبتة على كتلة؛ تستخدم للتلميع (كما في تجميل الأظافر)) / بني مصفر, كراميل (لون أسمر متوسط إلى داكن) / جِلْد عَارٍ, عُرْي (الجلد العاري)\nمثال: السباحة في العراء تعني السباحة عارياً",
 "buff-brown": "بُنِّيّ جِلْدِيّ (بني مع مسحة جلدية فاتحة)",
 "buff-colored": "جِلْدِيّ اللَّوْن (بلون البيج المائل إلى الاصفرار)",
 "buff-coloured": "جِلْدِيّ اللَّوْن (بلون البيج المائل إلى الاصفرار)",
 "buffalo": "جَامُوس, جَامُوسَة",
 "buffalo bill's wild west show": "عرض الغرب المتوحش (عرض مذهل نظمه ويليام ف. كودي في عام 1883 وتميز بركوب الخيل والرماية على نطاق واسع؛ وتجول في الولايات المتحدة وأوروبا)",
 "buffalo bur": "مغد منقاري (مغد من أمريكا الشمالية بأوراق شائكة وزهور صفراء عنقودية)",
 "buffalo carpet beetle": "خنفساء السجاد الجاموس (خنفساء سجاد صغيرة سوداء وحمراء وبيضاء)",
 "buffalo chip": "جلة, روث البقر (قطعة من روث البقر المجفف)",
 "buffalo clover": "نفل الجاموس (نفل من غرب الولايات المتحدة) / بلوبونيت, ترمس تكساس (عشب حولي منخفض النمو في جنوب غرب الولايات المتحدة (تكساس) ذو أوراق حريرية وزهور زرقاء؛ وهو سبب رئيسي لتسمم الماشية في جنوب غرب الولايات المتحدة)",
 "buffalo fish": "سمكة الجاموس (أي من عدة أسماك ماصة كبيرة في وادي المسيسيبي)",
 "buffalo gnat": "ذبابة سوداء (ذبابة لاسعة صغيرة مسودة ممتلئة الجسم لها يرقات مائية؛ تمتص دماء الطيور وكذلك البشر والثدييات الأخرى)",
 "buffalo gourd": "قرع البراري, قرع الجاموس (كرمة معمرة في المناطق الجافة بوسط وجنوب غرب الولايات المتحدة والمكسيك ذات ثمار خضراء مرقطة صغيرة صلبة غير صالحة للأكل)",
 "buffalo grass": "عشب الجاموس (عشب قصير ينمو في السهول الجافة بوسط الولايات المتحدة (حيث يتجول الجاموس)) / عشب القديس أوغسطين (عشب منخفض يشكل حصيرة من جنوب الولايات المتحدة وأمريكا الاستوائية؛ يُزرع كعشب للمروج)",
 "buffalo indian": "هندي السهول (فرد من إحدى قبائل الهنود الأمريكيين الذين عاشوا حياة بدوية يتبعون الجاموس في السهول الكبرى لأمريكا الشمالية)",
 "buffalo nut": "جوز الجاموس, خشب الأرنب (شجيرة في جنوب شرق الولايات المتحدة تتطفل على جذور الشوكران ولها سنابل متناثرة من الزهور الخضراء وثمار لبية) / جوز الجاموس (فاكهة زيتية حسلية لنبات خشب الأرنب)",
 "buffalo wing": "أجنحة الدجاج الحارة, أجنحة بافالو (أجنحة دجاج مقرمشة وحارة)",
 "buffalofish": "سمكة الجاموس (أي من عدة أسماك ماصة كبيرة في وادي المسيسيبي) / سمك الجاموس (سمكة أمريكية شمالية كبيرة شبيهة بالشبوط)",
 "buffel grass": "سينكروس هدبي, عشبة الجاموس (عشبة شائكة معمرة منتصبة تشكل خصلات تستخدم بشكل خاص في جنوب أفريقيا وأستراليا للمراعي والعلف)",
 "buffer": "أداة تلميع, صاقلة (أداة تتكون من مادة ناعمة مثبتة على كتلة؛ تستخدم للتلميع (كما في تجميل الأظافر)) / مخمّد صدمات, مصدّ (جهاز يشبه الوسادة يقلل من الصدمة الناتجة عن الارتطام) / آلة تلميع, ملمّع (أداة كهربائية تستخدم لتلميع الأسطح) / ذاكرة مؤقتة, مخزن مؤقت ((علم الحاسوب) جزء من ذاكرة الوصول العشوائي يستخدم للتخزين المؤقت للبيانات التي تنتظر إرسالها إلى جهاز؛ يستخدم لتعويض الاختلافات في معدل تدفق البيانات…)",
 "buffer country": "دولة حاجزة, دولة عازلة (دولة محايدة صغيرة تقع بين قوتين متناحرتين)",
 "buffer solution": "محلول منظم, محلول واق (محلول يحتوي على مادة منظمة (بفر))",
 "buffer state": "دولة حاجزة, دولة عازلة (دولة محايدة صغيرة تقع بين قوتين متناحرتين)",
 "buffer storage": "ذاكرة مؤقتة, مخزن مؤقت ((علم الحاسوب) جزء من ذاكرة الوصول العشوائي يستخدم للتخزين المؤقت للبيانات التي تنتظر إرسالها إلى جهاز؛ يستخدم لتعويض الاختلافات في معدل تدفق البيانات…)",
 "buffer store": "ذاكرة مؤقتة, مخزن مؤقت ((علم الحاسوب) جزء من ذاكرة الوصول العشوائي يستخدم للتخزين المؤقت للبيانات التي تنتظر إرسالها إلى جهاز؛ يستخدم لتعويض الاختلافات في معدل تدفق البيانات…)",
 "buffer zone": "منطقة عازلة (المِنْطَقةُ: المَنْطِقَةُ؛ مِنْطَقَةُ: مُقَاطَعَةٌ)\nمثال: غزة منطقة مكشوفة.",
 "buffered aspirin": "أسبرين مخفف, بافرين (أسبرين مطلي بمادة قادرة على معادلة الحمض (الاسم التجاري بافرين))",
 "bufferin": "أسبرين مخفف, بافرين (أسبرين مطلي بمادة قادرة على معادلة الحمض (الاسم التجاري بافرين))",
 "buffet": "بُوفِيه",
 "buffet car": "عربة طعام (عربة ركاب يتم فيها تقديم الطعام أثناء النقل)",
 "buffeted": "مُبْتَلًى بِالعَوَاصِف, مُعَصَّف بِه (تعرض للضرب المتكرر من العواصف أو المحن)",
 "buffeting": "ضرب متكرر, قصف (ضربات ثقيلة متكررة)",
 "buffing wheel": "عجلة تلميع (عجلة مغطاة بمادة ناعمة)",
 "bufflehead": "بطة برأس الجاموس (بطة غواصة صغيرة من أمريكا الشمالية؛ الذكور لديهم ريش رأس كثيف)",
 "buffoon": "مُهَرِّج",
 "buffoonery": "تهريج (التصرف مثل المهرج أو البهلوان)",
 "buffoonish": "بَهْلَوَانِيّ, مُهَرِّج (يُشبه المُهرّج في السلوك)",
 "bufo": "علجوم",
 "bufo americanus": "علجوم أمريكي (علجوم شائع في أمريكا)",
 "bufo boreas": "علجوم غربي (من مجموعة كبيرة ومتنوعة من الموائل من جنوب ألاسكا إلى باجا كاليفورنيا غرب جبال روكي)",
 "bufo bufo": "علجوم أوروبي (علجوم شائع في أوروبا)",
 "bufo calamita": "علجوم ناترجاك (علجوم شائع بني مصفر قصير الأرجل من غرب أوروبا؛ يركض بدلاً من القفز)",
 "bufo canorus": "علجوم يوسمايت (من مروج سييرا نيفادا العالية وحدود الغابات)",
 "bufo debilis": "علجوم أخضر أمريكي (علجوم صغير أخضر أو أصفر مخضر مع قضبان وخطوط سوداء صغيرة)",
 "bufo marinus": "علجوم أغوا, علجوم القصب (أكبر أنواع العلاجم المعروفة؛ موطنه أمريكا الوسطى؛ مدمر قيم للآفات الحشرية)",
 "bufo microscaphus": "علجوم جنوبي غربي (علجوم ممتلئ الجسم ثؤلولي بشكل موحد من الوديان والجداول في جنوب غرب الولايات المتحدة شبه القاحل)",
 "bufo speciosus": "علجوم تكساس (علجوم ليلي حفار من غابات المسكيت والبراري في جنوب غرب الولايات المتحدة)",
 "bufo viridis": "علجوم أخضر أوراسي (علجوم أوراسي ذو لون أخضر متغير بشكل رئيسي)",
 "bufotes viridis": "علجوم أخضر أوراسي (علجوم أوراسي ذو لون أخضر متغير بشكل رئيسي)",
 "bug": "خَطَأ (تعني ضدّ الصواب. يشمل ذلك الفعل، القول، والرأي. يُستخدم الفعل \"أخطأ\" للدلالة على عدم الإصابة…؛ قام بعمل بعيد عن الصواب أو مخالف للحق سواء كان ذلك في السلوك أو القول أو الكتابة)\nمثال: كان خطأ حاسوبي.",
 "bug-eyed": "جَاحِظ",
 "bug-hunter": "عالم حشرات (عالم حيوان يدرس الحشرات)",
 "bugaboo": "بعبع, فزاعة (مصدر للقلق والخوف) / بعبع, غول (وحش خيالي يستخدم لإخافة الأطفال)\nمثال: لا يزال هاجس التضخم القديم يزعجهم",
 "bugbane": "بق باني, طارد البق ((بَقَّ) الرجل بقا: أَكثر القَوْل فِي صَوَاب أَو خطأ؛ (بَقَّ) الْمَرْأَة: كثر وَلَدهَا) / خربق أبيض, خربق أمريكي (نبات من أمريكا الشمالية له أوراق كبيرة وزهور خضراء مصفرة تنمو في عناقيد؛ ينتج قلويداً ساماً يستخدم طبياً)\nمثال: قد غزا بق الفراش فرنسا.",
 "bugbear": "بعبع, هاجس مخيف (موضوع للخوف أو التوجس) / بعبع, غول (وحش خيالي يستخدم لإخافة الأطفال)\nمثال: كانت ألمانيا دائماً بعبعاً لفرنسا",
 "bugged": "مُرَاقَب إِلِكْتِرُونِيًّا (فيه أجهزة تنصّت إلكترونيّة مخفيّة)",
 "bugger": "لوطي (شخص يمارس اللواط)",
 "bugger all": "لا شيء على الإطلاق (القليل أو لا شيء على الإطلاق)\nمثال: طلبت علاوة ولم يعطوني شيئاً يذكر",
 "buggery": "جنس شرجي, لواط (الجماع عبر فتحة الشرج، يرتكبه رجل مع رجل أو امرأة)",
 "bugginess": "كثرة الأخطاء البرمجية (حالة احتواء على أخطاء برمجية)",
 "buggy": "مَلِيء بِالحَشَرَات (موبوء بالحشرات والبقّ) / مَخْبُول, مَعْتُوه ((غير رسمي) مصطلحات عامّيّة تصف الاضطراب العقليّ) / عربة خفيفة (عربة صغيرة خفيفة الوزن؛ يجرها حصان واحد)",
 "buggy whip": "سوط العربة (سوط خيل كان يستخدمه سائق العربة قديماً)\nمثال: بما أن السيارات حلت محل العربات، فقد أصبح سوط العربة رمزاً لأي شيء عفا عليه الزمن تماماً",
 "bugle": "شَنْدْقُورة, جُعْدَة",
 "bugle call": "نداء البوق (إشارة تُبث بصوت البوق)",
 "bugler": "عازف بوق (شخص يعزف على البوق (البيوجل))",
 "bugleweed": "بوقية, عجوقة (أي من الأعشاب دائمة الخضرة المتنوعة الحولية أو المعمرة منخفضة النمو وموطنها أوراسيا؛ تستخدم كغطاء أرضي) / عشبة البوق, ليكوبس (عشب عطري مخدر قليلاً وقابض له أزهار بيضاء صغيرة؛ شرق الولايات المتحدة)",
 "bugloss": "كَحْلَاء, شِنْجَار",
 "bugologist": "عالم حشرات (عالم حيوان يدرس الحشرات)",
 "bugology": "علم الحشرات (فرع علم الحيوان الذي يدرس الحشرات)",
 "buhl": "بول, تطعيم بول (زخرفة أثاث مطعمة؛ حيث تشكل صدفة السلحفاة والمعدن الأصفر والأبيض لفائف في أعمال النجارة)",
 "build": "بَنَى (أَقَامَ شيئا مثل الجدران و السفن باستخدام مواد مثل الخشب والطَّابُوق والحَجَر والآجَر والخَرَسَانَة وغيرها؛ جعل الشيء يحدث خطوة بعد خطوة كأنه بناء وإن لم يكن شيئا ملموسا)\nمثال: بنى سامي منزلا.",
 "builder": "بَنَّاء, بَنَّاءَة (ضد هَدْم. ؛ المَبْنَى أو البِنَاية)\nمثال: أنا وجدت البناء.",
 "building": "بِنَاء (ضد هَدْم. ؛ المَبْنَى أو البِنَاية) / مَبْنَى, بِنَاء (كل ما بُنِيَ؛ ما يُبْنى على أرضٍ محاطا بالجُدْرَان ومغطى بسَقْف. (تخصيص))\nمثال: أنا وجدت البناء.",
 "building block": "كتلة بناء (كتلة من المواد المستخدمة في أعمال البناء) / لبنة أساسية, وحدة (شيء طبيعي مفرد غير مقسم يدخل في تكوين شيء آخر)\nمثال: وحدات الأحماض النووية",
 "building code": "قانون البناء, كود البناء (مجموعة معايير تضعها وتفرضها الحكومة المحلية للسلامة الهيكلية للمباني)",
 "building complex": "مجمع, مجمع مباني (هيكل كامل (كمبنى) مكون من هياكل مترابطة أو ذات صلة)",
 "building department": "قسم المباني, قسم المنشآت (قسم في مؤسسة تجارية مسؤول عن بناء وصيانة المنشآت المادية)",
 "building material": "مواد البناء (المواد المستخدمة في تشييد المباني)",
 "building permit": "رخصة بناء (وثيقة تخول حاملها بناء مبنى من نوع معين في قطعة أرض معينة)",
 "building site": "أرض خالية, أرض فضاء (قطعة أرض لا توجد عليها مباني دائمة)",
 "building society": "جمعية بناء (المعادل البريطاني لجمعية الادخار والإقراض في الولايات المتحدة)",
 "building supply house": "متجر مواد بناء (متجر حيث يمكن للبنائين شراء مواد بناء المنازل والهياكل ذات الصلة)",
 "building supply store": "متجر مواد بناء (متجر حيث يمكن للبنائين شراء مواد بناء المنازل والهياكل ذات الصلة)",
 "buildup": "تراكم, حشد (عملية بناء تراكم) / تَلْمِيع, دِعَايَة مُكَثَّفَة (دعاية وثناء إيجابي للغاية) / تراكم, حشد (نتيجة عملية التراكم)\nمثال: حسدت تراكم أصوله السريع",
 "built": "مُعَزَّز, مُقَوًّى ((عن الصابون أو عوامل التنظيف) أُضيفت إليه مادّة لزيادة الفعاليّة)",
 "built in bed": "سرير سفينة, سرير قطار (سرير على متن سفينة أو قطار؛ عادة ما يكون في طبقات)",
 "built-in": "مَبْنِيّ, مُدْمَج / مُضَمَّن",
 "built-in bed": "سرير مثبت, سرير مدمج (سرير مبني ومثبت في الجدار)",
 "built-soap powder": "مسحوق الصابون (صابون في شكل مسحوق مخلوط بمواد قلوية)",
 "built-up": "مَأْهُول, مَبْنِيّ (مملوء بالسكّان والمستوطنين)",
 "buirdly": "ضَخْمُ البِنْيَة, مَفْتُول (عضليّ وثقيل البنية)",
 "bujumbura": "بُوجُمْبُورَا",
 "bukhara": "بُخَارَى",
 "bukharan": "بُخَارِيّ",
 "bukkake": "بُوكَاكِيه",
 "bulb": "انتفاخ, بصيلة (جزء مستدير من أداة أسطوانية (عادة في أحد الطرفين)) / لمبة, مصباح كهربائي (مصباح كهربائي يتكون من غلاف زجاجي شفاف أو نصف شفاف يحتوي على فتيل سلكي (عادة من التنجستن) يبعث الضوء عند تسخينه بالكهرباء) / بَصَلَة (اتساع أو تمدد مستدير في قناة أو وعاء أو عضو) / بصلة السيساء, نخاع مستطيل (الجزء السفلي أو الخلفي من الدماغ؛ متصل بالحبل الشوكي)\nمثال: بصيلة المحقنة",
 "bulb syringe": "شفاط الأنف, محقنة بصيلة (جهاز ذو بصيلة مرنة تحل محل المكبس للتقطير أو الشفط، يستخدم لغسل فتحة خارجية، مثل القناة السمعية، أو لإزالة الاحتقان من تجويف الأنف)",
 "bulb-shaped": "بَصَلِيّ, شَبِيهٌ بِالبَصَلَة (على شكل بصلة أو انتفاخ)",
 "bulbaceous": "بصلي (ينتج أو ينمو من بصيلات)",
 "bulbar": "بصلي (يشمل النخاع المستطيل (البصلة السيسائية))\nمثال: شلل بصلي",
 "bulbar conjunctiva": "ملتحمة بصلية (جزء الملتحمة الذي يغطي الوجه الأمامي للصلبة والظهارة السطحية للقرنية)",
 "bulbed": "ذو بصلة, مبصل (لديه بصيلة)",
 "bulbil": "بصيلة (بصلة صغيرة أو نمو على شكل بصلة ينشأ من إبط الورقة أو في مكان الزهور)",
 "bulblet": "بصيلة (بصلة صغيرة أو نمو على شكل بصلة ينشأ من إبط الورقة أو في مكان الزهور)",
 "bulblet bladder fern": "سرخس المثانة البصيلي, سرخس بصيلي (سرخس أمريكي شمالي يحمل غالباً بصيلات على الوريقات)",
 "bulblet fern": "سرخس المثانة البصيلي, سرخس بصيلي (سرخس أمريكي شمالي يحمل غالباً بصيلات على الوريقات)",
 "bulblike": "بَصَلِيّ, شَبِيهٌ بِالبَصَلَة (على شكل بصلة أو انتفاخ)",
 "bulbophyllum": "وَرَق بَصَلِيّ, وَرَقَة بَصَلِيَّة (ما ينمو على النبات من الأعلى والجوانب بشكل صفائح ذات لون أخضر أو مائل إلى الخضرة. انظر الصورة؛ جلود رقاق يُكتَبُ عليها)\nمثال: هات ورقة بيضاء.",
 "bulbourethral gland": "غُدَّةُ بَصَلِيَّةُ إِحْليلِيَّة",
 "bulbous": "مُحَدَّب, مُنْتَفِخ (منحنٍ نحو الخارج؛ ذو شكل بصلي بارز) / بَصَلِيّ, شَبِيهٌ بِالبَصَلَة (على شكل بصلة أو انتفاخ)",
 "bulbous iris": "سوسن بصل (أي من سوسن مختلف له ساق أرضية تشبه البصلة)",
 "bulbous plant": "نبات بصلي (نبات ينمو من بصلة)",
 "bulbul": "بُلْبُل",
 "bulgarian": "بُلْغَارِيّ",
 "bulgarian language": "اللغة البلغارية (لغة سلافية يتم التحدث بها في بلغاريا)",
 "bulgarian monetary unit": "وحدة نقدية بلغارية (الوحدة النقدية في بلغاريا)",
 "bulge": "انتفاخ, بروز (شيء ينتفخ للخارج أو يبرز عن محيطه)\nمثال: أحدث المسدس في جيبه انتفاخاً واضحاً",
 "bulghur": "برغل (قمح مجروش ومسلوق)",
 "bulginess": "استدارة, انتفاخ (الخاصية التي يمتلكها تحدب مستدير)",
 "bulging": "محدب, ناتئ (منحنٍ أو بارز إلى الخارج) / مُحَدَّب, مُنْتَفِخ (منحنٍ نحو الخارج؛ ذو شكل بصلي بارز)",
 "bulgur": "بُرْغُل",
 "bulgur pilaf": "بيلاف البرغل (بيلاف مصنوع من البرغل بدلاً من الأرز وعادة بدون لحم)",
 "bulgur wheat": "برغل (قمح مجروش ومسلوق)",
 "bulgy": "مُحَدَّب, مُنْتَفِخ (منحنٍ نحو الخارج؛ ذو شكل بصلي بارز)",
 "bulimarexia": "الشره المرضي العصبي, النهام العصبي (اضطراب في الأكل يتناوب فيه الشخص بين رغبة قوية في الطعام ونفور منه؛ يتميز بالإفراط في الأكل تليها فترات من الصيام أو التقيؤ المستحث ذاتياً)",
 "bulimia": "نهام (جوع مرضي لا يشبع (خاصة عندما تسببه آفات الدماغ)) / الشره المرضي, النهام (اضطراب في الأكل يظهر بين الشابات اللاتي يفرطن في الأكل ثم يشعرن بالذنب والاكتئاب وإدانة الذات)",
 "bulimia nervosa": "الشره المرضي العصبي, النهام العصبي (اضطراب في الأكل يتناوب فيه الشخص بين رغبة قوية في الطعام ونفور منه؛ يتميز بالإفراط في الأكل تليها فترات من الصيام أو التقيؤ المستحث ذاتياً)",
 "bulimic": "نهامي (يعاني من النهام (الشره المرضي)) / مَرِيض بِالنُّهام, مُصاب بِالشَّرَه المَرَضِيّ (شخص يعاني من الشره المرضي (النهام))",
 "bulk": "جسامة, ضخامة (الخاصية التي تمتلكها كتلة كبيرة) / حجم, كتلة (خاصية الشيء الذي يكون كبيراً في المقدار) / أغلبية, أكثرية (الخاصية الناتجة عن كون الجزء هو الأكبر عدداً بين جزأين؛ الجزء الرئيسي)\nمثال: شراؤها بالجملة أرخص",
 "bulk mail": "بريد بالجملة (بريد يتكون من أعداد كبيرة من العناصر المتطابقة (منشورات أو إعلانات) ترسل إلى عناوين فردية بأسعار أقل من الدرجة الأولى وتدفع في دفعة واحدة)",
 "bulk modulus": "مُعَامِل الْمُرُونَة الْحَجْمِيّ (نسبة التغير في الضغط المؤثر على حجم ما إلى التغير النسبي في الحجم)",
 "bulkhead": "حاجز / جدار ساحلي",
 "bulkiness": "ثقل, ضخامة (كبر حجم غير عملي أو يصعب التعامل معه)",
 "bulky": "ضَخْم",
