 "case": "قَضِيَّة (الأمر أو الشيء المُعَقَّد؛ في : ما يقضي فيه القاضي) / عُلْبَة / حَالَات / دَعْوَى (إدِّعَاء؛ دُعَاء) / عُلَب\nمثال: سأرفع عليك قضية.",
 "case agreement": "مُطَابَقَة الحَالَة الإِعْرَابِيَّة (المطابقة في الحالة الإعرابية بين الكلمات في نفس التركيب)",
 "case history": "تاريخ الحالة, سجل الحالة (سجل مفصل لخلفية شخص أو مجموعة قيد الدراسة أو العلاج)",
 "case in point": "سابقة, مثال حي (مثال يستخدم لتبرير حوادث مماثلة في وقت لاحق)",
 "case knife": "سكين غمدي (سكين بشفرة ثابتة يُحمل في غمد) / سكين مائدة معدني (شفرة معدنية بمقبض؛ تستخدم كأداة مائدة)",
 "case law": "سابقة قضائية, قانون السوابق القضائية ((القانون المدني) قانون تم إنشاؤه من خلال اتباع قرارات قضائية سابقة) / قانون عام, قانون عرفي (نظام فقهي يعتمد على السوابق القضائية بدلاً من القوانين التشريعية)\nمثال: نشأ القانون العام في القوانين غير المكتوبة في إنجلترا وتم تطبيقه لاحقاً في الولايات المتحدة",
 "case load": "عبء القضايا, عدد الحالات (عدد القضايا أو الحالات التي يتم التعامل معها في فترة زمنية معينة (كما في محكمة أو وكالة))",
 "case officer": "ضابط حالة (عميل يعمل أيضًا كموظف رسمي في جهاز استخبارات)",
 "case shot": "طلقة عنقودية, قذيفة علبة (أسطوانة معدنية معبأة بالخردق وتستخدم كذخيرة في سلاح ناري)",
 "case study": "دراسة حالة (تحليل مفصل لشخص أو مجموعة من وجهة نظر اجتماعية أو نفسية أو طبية) / دراسة حالة (دراسة دقيقة لوحدة اجتماعية (مثل شركة أو قسم داخل شركة) تحاول تحديد العوامل التي أدت إلى نجاحها أو فشلها)",
 "case-by-case": "خاص, فردي (كائن أو مميز لشيء واحد أو شخص واحد)\nمثال: قطرات فردية من المطر",
 "case-fatality proportion": "نِسْبَة إِمَاتَة الحَالَات (عدد حالات مرض ينتهي بالوفاة مقسوماً على عدد حالات المرض؛ يعبر عنه عادة كنسبة مئوية أو كعدد الوفيات لكل 1000 حالة)",
 "case-hardened": "عَديم الإحْساس, مُتَقَسٍّ (أصبَح قاسِيًا بِفِعْل التَّجْرِبَة؛ لا تُؤَثِّر فيه المَشاعِر)",
 "case-hardened steel": "فولاذ مصلد السطح (فولاذ ذو سطح أكثر صلابة بكثير من المعدن الداخلي)",
 "case-to-infection proportion": "نِسْبَة الحَالَات إِلَى العَدْوَى (عدد حالات المرض مقسوماً على عدد الإصابات بالعامل المسبب للمرض)",
 "case-to-infection ratio": "نِسْبَة الحَالَات إِلَى العَدْوَى (عدد حالات المرض مقسوماً على عدد الإصابات بالعامل المسبب للمرض)",
 "caseate": "تَجَبَّنَ",
 "casebook": "كِتَابِيّ, نَمُوذَجِيّ (وفقًا لما هو مذكور في الكتب المرجعية أو يتسم بخصائصها؛ نموذجي) / سجل القضايا, مدونة القضايا (كتاب يُحتفظ فيه بسجلات مكتوبة مفصلة لقضية ما ويعد مصدراً للمعلومات للعمل اللاحق)",
 "cased": "فِي عُلْبَة, مُغَلَّف (محاط بغلاف أو علبة) / مُحَاط بِغِلَاف, مُغَلَّف (مُغطّى أو محميّ بغلاف أو ما يُشبهه)",
 "caseful": "ملء حقيبة, ملء صندوق (الكمية المحتواة في صندوق أو حقيبة)",
 "casein": "طلاء الكازين (طلاء مائي مصنوع من بروتين مترسب من الحليب) / كازين (بروتين الحليب يُستخدم في صنع البلاستيك والمواد اللاصقة)",
 "casein glue": "غراء الكازين (مصنوع من الكازين؛ يستخدم للخشب الرقائقي وأعمال الخزائن)",
 "casein paint": "طلاء الكازين (طلاء مائي مصنوع من بروتين مترسب من الحليب)",
 "casemaking clothes moth": "عثة الملابس صانعة الغمد (تعيش يرقاتها في أنابيب من مادة غذائها مثبتة بالحرير الذي تغزله)",
 "casement": "درفة نافذة (إطار نافذة بمفصلات (عادة على جانب واحد))",
 "casement window": "نافذة مفصلية (نافذة بها درفة واحدة أو أكثر)",
 "caseous": "جُبْنِيّ ((في الطِّبّ) شَبيه بِالجُبْن في الأنْسِجَة المُتَنَكْرِزَة)",
 "casern": "ثكنة (ثكنات عسكرية في بلدة حامية)",
 "casework": "دراسة الحالة, عمل اجتماعي فردي (دراسة اجتماعية دقيقة لشخص أو أسرة تعاني من سوء التكيف من أجل التشخيص والعلاج)",
 "caseworker": "أخصائي اجتماعي, باحث اجتماعي (شخص يعمل لتقديم الخدمات الاجتماعية (خاصة للمحرومين))",
 "caseworm": "دودة كيسية (يرقة حشرة تبني غلافاً واقياً حول جسمها)",
 "cash": "نَقْد, نُقُود",
 "cash account": "حساب نقدي (حساب لدى شركة وساطة للأوراق المالية تتم تسوية معاملاته على أساس نقدي)",
 "cash advance": "دفعة مقدمة, سلفة (مبلغ يدفع قبل استحقاقه)",
 "cash bar": "بار نقدي (منضدة في حفلة كبيرة حيث يمكنك شراء المشروبات بالكأس)",
 "cash basis": "الأساس النقدي (طريقة محاسبية يتم فيها إدخال كل بند عند استلام أو سداد المدفوعات)",
 "cash card": "بطاقة سحب نقدي (بطاقة دفع تخول حاملها الحصول على النقد)",
 "cash cow": "بقرة حلوب, مشروع مُدر للربح (مشروع يولد تدفقًا مستمرًا للمال)",
 "cash crop": "محصول تجاري, محصول نقدي (محصول قابل للبيع بسهولة يُزرع ويُجمع من أجل السوق (مثل الخضروات أو القطن أو التبغ))",
 "cash dispenser": "صراف آلي (آلة غير مراقبة (خارج بعض البنوك) تصرف النقود عند استخدام بطاقة مشفرة شخصية)",
 "cash equivalent": "مكافئ نقدي (أداة دين عالية السيولة ذات آجال استحقاق أقل من ثلاثة أشهر)",
 "cash flow": "تدفق نقدي (فائض الإيرادات النقدية عن المصروفات النقدية في فترة زمنية معينة (لا يشمل المصروفات غير النقدية))",
 "cash in hand": "أموال, موارد مالية (أصول في شكل مال)",
 "cash machine": "صراف آلي (آلة غير مراقبة (خارج بعض البنوك) تصرف النقود عند استخدام بطاقة مشفرة شخصية)",
 "cash on delivery": "الدَّفْع عِنْد الاسْتِلَام (تحصيل الرسوم عند التسليم)\nمثال: أرسل طرداً بالدفع عند الاستلام",
 "cash price": "السعر الفوري, سعر النقد (سعر التسليم الحالي لسلعة يتم تداولها في السوق الفورية)",
 "cash register": "آلَة تَسْجِيل نَقْد (الفارسية: ماشين؛ الأوردية: مشين)\nمثال: نسى زيري الآلة.",
 "cash reserve ratio": "نِسْبَة الِاحْتِيَاطِيّ (نسبة مئوية من إجمالي الودائع المصرفية، يتم الاحتفاظ بها لضمان قدرة البنك على دفع عدد كبير غير عادي من عمليات السحب عند الطلب إذا حدث ذلك)\nمثال: تُستخدم نسبة الاحتياطي الإلزامي أحيانًا كأداة في السياسة النقدية",
 "cash surrender value": "قيمة الاسترداد النقدي (المبلغ الذي ستدفعه شركة التأمين على بوليصة تأمين على الحياة معينة إذا تم إلغاء البوليصة قبل وفاة المؤمن عليه)",
 "cash-and-carry": "الدفع والنقل, كاش آند كاري (يباع نقداً ويقوم العميل بنقله (بدون خدمة توصيل))\nمثال: عمل تجاري بنظام الدفع والنقل",
 "cashable": "قَابِل لِلاسْتِرْدَاد, قَابِل لِلصَّرْف (يمكن تحويله إلى نقد جاهز أو ما يعادله)",
 "cashbook": "دَفْتَر حِسَابَات",
 "cashbox": "خزينة نقود, صندوق النقد (صندوق قوي لحفظ النقود)",
 "cashcard": "بطاقة سحب نقدي (بطاقة دفع تخول حاملها الحصول على النقد)",
 "cashed": "مَصْرُوف, مُحَصَّل (قَدْ دُفِعَ فِيهِ المَال)",
 "cashew": "كَاجُو, بَلَاذِر",
 "cashew nut": "جَوْز الكَاجُو, بَلَاذُر (جَوَّز لَهُمْ إِبِلَهم إِذا قَادَهَا بَعِيرًا بَعِيرًا حَتَّى تَجُوزَ)\nمثال: نريد أن نأكل نبات جوز الهند.",
 "cashew tree": "بلاذر, شجرة الكاجو (شجرة استوائية أمريكية دائمة الخضرة تحمل مكسرات كلوية الشكل لا تؤكل إلا محمصة)",
 "cashier": "كَاشِير, صَرَّاف / أَمِينُ الصُّنْدُوقِ (من يتولى رقابة شيء أو المحافظة عليه؛ مُطْمَئِنّ)\nمثال: هو غبي وغير أمين.",
 "cashier's check": "شيك أمين الصندوق, شيك مصرفي (شيك يصدره مسؤول في البنك على حساب البنك الخاص (وليس حساب شخص خاص))\nمثال: الشيكات المصرفية جيدة كالنقد",
 "cashier's cheque": "شيك أمين الصندوق, شيك مصرفي (شيك يصدره مسؤول في البنك على حساب البنك الخاص (وليس حساب شخص خاص))\nمثال: الشيكات المصرفية جيدة كالنقد",
 "cashmere": "كشمير (قماش ناعم مصنوع من صوف ماعز الكشمير) / كشمير (صوف ماعز كشمير)",
 "cashmere goat": "ماعز الكشمير (ماعز الهيمالايا له طبقة تحتية حريرية تُقدر عالياً كصوف الكشمير)",
 "casing": "إطار (الإطار المحيط بفتحة باب أو نافذة) / غلاف الإطار (الغطاء الخارجي للإطار الهوائي) / غلاف, هيكل خارجي (المبيت أو الغطاء الخارجي لشيء ما)\nمثال: تعفنت الأطر وكان لا بد من استبدالها",
 "casino": "كَازِينُو, نَادِي الْقِمَار",
 "casino-hotel": "فندق وكازينو (مبنى يضم فندقاً وكازينو) / فندق وكازينو (مؤسسة تجارية تجمع بين كازينو وفندق)",
 "cask": "برميل (حاوية أسطوانية تحفظ السوائل) / ملء برميل (الكمية التي يستوعبها برميل خشبي)",
 "casket": "صندوق مجوهرات (صندوق صغير ومزخرف غالباً لحفظ المجوهرات أو الأشياء الثمينة الأخرى) / تابوت, نعش (صندوق يدفن فيه الميت أو يُحرق)",
 "caskful": "ملء برميل (الكمية التي يستوعبها برميل خشبي)",
 "casmerodius albus": "بلشون أبيض كبير (بلشون أبيض واسع الانتشار في العالم القديم)",
 "caspase": "كاسبيز (أي من مجموعة البروتياز التي تتوسط عملية موت الخلايا المبرمج)",
 "caspase-mediated cell death": "استماتة, موت الخلية المبرمج (نوع من موت الخلايا تستخدم فيه الخلية آليات خلوية متخصصة لقتل نفسها؛ آلية انتحار خلوية تمكن الكائنات متعددة الخلايا من التحكم في عدد الخلايا والقضاء…)",
 "caspian sea": "بَحْر قَزْوِين, بَحْر الخَزَر (شَقّ الأرض؛ التَحَيُّر والبَهْت من الفزع أو من شدة العَطَش فنظر لا يقصد شيئا)\nمثال: هبطت على البحر.",
 "caspian tit": "قرقف جرجاني",
 "casque": "خوذة ((القرن 15-16) أي درع للرأس؛ عادة ما تكون مزخرفة وبدون قناع)",
 "casquet": "خوذة مفتوحة (خوذة مفتوحة خفيفة بدون قناع أو واقي ذقن)",
 "casquetel": "خوذة مفتوحة (خوذة مفتوحة خفيفة بدون قناع أو واقي ذقن)",
 "cassareep": "كاساريب (نكهة تصنع بغلي عصير الكسافا المرة؛ تستخدم في طبخ جزر الهند الغربية)",
 "cassata siciliana": "كَاسَّاتَا, كَاسَّاتَا سِيشِيلْيَانَا",
 "cassava": "بفرة, كسافا / كاسافا, مانيوك (جذر الكاسافا يؤكل كغذاء أساسي بعد التجفيف والنقع؛ مصدر للتابيوكا) / بفرة, كسافا (نشا يُصنع عن طريق نقع وتجفيف جذر نبات الكسافا؛ مصدر التابيوكا؛ غذاء أساسي في المناطق الاستوائية)",
 "cassava starch": "بفرة, كسافا (نشا يُصنع عن طريق نقع وتجفيف جذر نبات الكسافا؛ مصدر التابيوكا؛ غذاء أساسي في المناطق الاستوائية)",
 "cassegrainian telescope": "تلسكوب كاسيجرين, مقراب كاسيجرين (تلسكوب عاكس يحتوي على مرآة أولية مكافئة ومرآة ثانوية زائدة؛ ويتم تجميع الضوء في بؤرة من خلال فتحة في وسط المرآة الأولية)",
 "casserole": "كَسْرُول, طَاجِن",
 "cassette": "كَاسِيت",
 "cassette deck": "كاسيت ديك, مشغل كاسيت (منفصل) (سطح شريط لتشغيل وتسجيل أشرطة الكاسيت)",
 "cassette player": "مشغل كاسيت (جهاز إلكتروني لتشغيل الكاسيتات)",
 "cassette recorder": "مسجل كاسيت (مسجل لتسجيل أو تشغيل الكاسيتات)",
 "cassette tape": "شريط كاسيت (علبة تحتوي على شريط مغناطيسي)",
 "cassia": "قرفة صينية, كاسيا (شجرة صينية ذات لحاء عطري؛ تنتج قرفة أقل جودة من القرفة السيلانية) / خيار شمبر, كاسيا (أي من الأشجار أو الشجيرات المختلفة من جنس كاسيا ذات أوراق مركبة ريشية وأزهار صفراء عادة تليها قرون بذور طويلة)",
 "cassia acutifolia": "سنا إسكندراني, سنا مكي (شجيرة قائمة لها عناقيد من الزهور الصفراء السمراء؛ تستخدم الأوراق المجففة طبياً كمسهل؛ تصنف أحياناً في جنس كاسيا)",
 "cassia alata": "شجيرة السعفة, كاسيا مجنحة (شجيرة استوائية (خاصة في الأمريكتين) لها زهور صفراء وأوراق كبيرة يستخدم عصيرها كعلاج للسعفة واللدغات السامة؛ تصنف أحياناً في جنس كاسيا)",
 "cassia augustifolia": "سنا إسكندراني, سنا مكي (شجيرة قائمة لها عناقيد من الزهور الصفراء السمراء؛ تستخدم الأوراق المجففة طبياً كمسهل؛ تصنف أحياناً في جنس كاسيا)",
 "cassia auriculata": "أفارام, كاسيا الدباغين (شجيرة هندية دائمة الخضرة بزهور صفراء زاهية يستخدم لحاؤها في الدباغة؛ تصنف أحياناً في جنس كاسيا)",
 "cassia bark": "سَلِيخَة, قِرْفَة صِينِيَّة (اللحاء العطري لشجرة السليخة؛ أقل جودة كنوع من التوابل مقارنة بقرفة سيلان)",
 "cassia fasciculata": "بازلاء الحجل, بازلاء حساسة (نبات أمريكي استوائي له وريقات حساسة نوعاً ما للمس؛ يصنف أحياناً في جنس كاسيا)",
 "cassia fistula": "خيار شمبر, شجرة المطر الذهبي (شجرة متساقطة الأوراق أو شبه دائمة الخضرة لها زهور بنية داكنة إلى صفراء معطرة في عناقيد متدلية وقرون يستخدم لبها طبياً؛ آسيا الاستوائية ووسط وجنوب…)",
 "cassia grandis": "المطر الوردي, كاسيا وردية (شجرة أمريكية استوائية شبه دائمة الخضرة لها عناقيد قائمة من الزهور الوردية أو الوردية الملونة؛ تستخدم للزينة)",
 "cassia javonica": "المطر القزحي, كاسيا جاوية (هجين زينة متساقط الأوراق من جنوب شرق آسيا وهاواي له عناقيد من الزهور تتراوح ألوانها من الكريمي إلى البرتقالي والأحمر)",
 "cassia marginata": "كاسيا الحصان (شجرة من شرق الهند لها قرون طويلة تحتوي على لب مسهل أسود يستخدم كدواء للخيول)",
 "cassia marilandica": "سنا بري, سنا ماريلاند (عشب معمر في أمريكا الشمالية؛ تستخدم الأوراق طبياً؛ يوضع أحياناً في جنس كاسيا)",
 "cassia occidentalis": "سنا القهوة, عشبة منتنة (شجيرة استوائية مورقة جداً كريهة الرائحة استخدمت بذورها كمغشوش للقهوة؛ تصنف أحياناً في جنس كاسيا)",
 "cassia roxburghii": "كاسيا الحصان (شجرة من شرق الهند لها قرون طويلة تحتوي على لب مسهل أسود يستخدم كدواء للخيول)",
 "cassia tora": "سنا منفرجة الأوراق, قرن المنجل (عشب استوائي عالمي أو شجيرة صغيرة بزهور صفراء وقرون منحنية رفيعة؛ عشب ضار؛ يصنف أحياناً في جنس كاسيا)",
 "cassia-bark tree": "قرفة صينية, كاسيا (شجرة صينية ذات لحاء عطري؛ تنتج قرفة أقل جودة من القرفة السيلانية)",
 "cassie": "أكاسيا حلوة, سنط عنبري (شجيرة شائكة أو شجرة صغيرة من أمريكا الاستوائية؛ تستخدم زهورها الصفراء العطرة في صناعة العطور)",
 "cassin's kingbird": "ملك طيور كاسين (طائر يُرى في جنوب غرب الولايات المتحدة؛ رمادي إلى حد كبير مع بطن أصفر)",
 "cassino": "كازينو (لعبة ورق يتم فيها أخذ الأوراق المكشوفة على الطاولة بأوراق مؤهلة في اليد)",
 "cassiope mertensiana": "خلنج أبيض (خلنج من جبال غرب الولايات المتحدة له زهور بيضاء جرسية الشكل)",
 "cassiopeia": "ذَاتُ الكُرْسِيّ",
 "cassiri": "كاسيري (مشروب يشبه البيرة؛ مصنوع من عصير الكسافا المخمر)",
 "cassite": "الكاشية (لغة قديمة كان يتحدث بها الكاشيون) / كاسي, كاشي (عضو في شعب قديم حكم بابل بين 1600 و 1200 قبل الميلاد)",
 "cassite language": "الكاشية (لغة قديمة كان يتحدث بها الكاشيون)",
 "cassiterite": "حجر القصدير, كاسيتريت (معدن داكن ثقيل وصلب يعد المصدر الرئيسي للقصدير)",
 "cassock": "ثوب الكاهن (رداء أسود يصل إلى الكاحلين؛ يرتديه الكهنة أو المنشدون)",
 "cassocked": "مُرْتَدٍ جُبَّة (يرتدي جبة كهنوتية)",
 "cassowary": "شبنم (طائر كبير أسود لا يطير من أستراليا وغينيا الجديدة له عرف قرني على الرأس)",
 "cast": "صَبَّ, رَمَى (سَكَبَ، الفرق بين صَبَّ وسَكَب أن الصَبّ يكون متعمدا والسكب قد يكون متعمدا أو خطأ؛ صَبَّ الطعام، أي سكبه في الإناء أو الصحون) / ضِمَاد مِنَ الْجِبْس\nمثال: صب الشاي لضيفك.",
 "cast iron": "حديد الزهر, حديد مسبوك (سبيكة من الحديد تحتوي على نسبة عالية من الكربون بحيث تكون هشة ولا يمكن طرقها بل يجب تشكيلها بالصب)",
 "cast net": "شَبَكَة",
 "cast of characters": "الشخصيات, الممثلون (الممثلون في مسرحية)",
 "cast-iron": "صَلْبٌ كَالحَدِيد (شديد المتانة والصلابة)",
 "cast-iron plant": "أسبيديسترا, دريقة (نبات معمر دائم الخضرة بأوراق قاعدية وسيمة كبيرة؛ يزرع بشكل أساسي كنبات منزلي ورقي)",
 "castanea chrysophylla": "شنكابين ذهبي, شنكابين عملاق (شجرة زينة صغيرة دائمة الخضرة من ساحل المحيط الهادئ أوراقها الخضراء الصفراء اللامعة صفراء من الأسفل؛ تحمل مكسرات صالحة للأكل)",
 "castanea crenata": "كستناء يابانية (شجرة منتشرة في اليابان لها جذع قصير)",
 "castanea dentata": "كستناء أمريكية (شجرة كبيرة توجد من مين إلى ألاباما)",
 "castanea mollissima": "كستناء صينية (شجرة صغيرة بجوز حلو صغير؛ برية أو موطنة في كوريا والصين)",
 "castanea ozarkensis": "شينكابين أوزارك (شجرة شجيرية وثيقة الصلة بالكستناء القزمية ولكن بأوراق أكبر؛ جنوب وسط غرب الولايات المتحدة)",
 "castanea pumila": "شينكابين, كستناء قزمية (شجرة كستناء شجيرية من جنوب شرق الولايات المتحدة لها جوز صغير صالح للأكل)",
 "castanea sativa": "أبو فروة, كستناء أوروبية (برية أو مزروعة في جميع أنحاء جنوب أوروبا وشمال غرب أفريقيا وجنوب غرب آسيا)",
 "castanets": "صنوج, كاستانيت ((تستخدم بصيغة الجمع) آلة إيقاعية تتكون من زوج من قطع الخشب أو العظم المجوفة (تُمسك عادة بين الإبهام والأصابع) تُطقطق معاً (كما يفعل الراقصون الإسبان)…)",
 "castanopsis chrysophylla": "شنكابين ذهبي, شنكابين عملاق (شجرة زينة صغيرة دائمة الخضرة من ساحل المحيط الهادئ أوراقها الخضراء الصفراء اللامعة صفراء من الأسفل؛ تحمل مكسرات صالحة للأكل)",
 "castaway": "غَرِيق مَنْبُوذ, ناجٍ مِن الغَرَق (شخص تحطمت سفينته ونجا) / طَرِيد, مَنْبُوذ (شخص مرفوض (من المجتمع أو الوطن))",
 "caste": "طَبَقَة, طَبَقِيَّة",
 "caste system": "نظام طبقي (هيكل اجتماعي يتم فيه تحديد الطبقات عن طريق الوراثة)",
 "casteless": "بِلَا طَبَقَة, مَنْبُوذ طَبَقِيًّا (لا ينتمي إلى طبقة اجتماعية أو طُرد منها فلا مكانة له في المجتمع)",
 "castella": "كَاسْتِيلَا",
 "castellan": "حَاكِم قَلْعَة, حَاكِم قِلْعَة (حَاكَمَ القاضي فلانا: أقام عليه محكمة ليرى ما إذا كان مجرما أم لا؛ حَاكَمَ فلانٌ فلانا: رفع عليه قضية؛ اشتكى عليه عند القضاء فأقاموا محكمة للحكم في الأمر)\nمثال: ميت رومني هو حاكم ولاية ماساتشوستس.",
 "castellated": "مُسَنَّن, مُشَرَّف (له أو يشبه حزوزاً مربعة متكررة كتلك الموجودة في شرفات القلاع)",
 "caster": "عجلة الأثاث, عجلة دوارة (عجلة محورية متصلة بأسفل الأثاث أو الشاحنات أو الآلات المحمولة لجعلها قابلة للحركة) / رشاشة سكر (رجاجة ذات غطاء مثقوب لرش السكر البودرة) / سبّاك معادن (عامل يصب المعدن المنصهر في منتجات نهائية)",
 "caster sugar": "سكر ناعم الحبيبات (سكر ناعم الحبيبات جداً كان يرش قديماً من وعاء خاص)",
 "castigation": "تأنيب, توبيخ (عقاب لفظي) / تَقْرِيع شَدِيد, تَوْبِيخ لَاذِع (توبيخ شديد وقاسٍ)",
 "castile": "قَشْتَالَة",
 "castile soap": "صابون قشتالي (صابون صلب جيد مصنوع من زيت الزيتون وهيدروكسيد الصوديوم)",
 "castilian": "القشتالية (اللغة الإسبانية كما يتم التحدث بها في قشتالة) / قشتالي (مواطن أو ساكن في قشتالة)",
 "castilian language": "القشتالية (اللغة الإسبانية كما يتم التحدث بها في قشتالة)",
 "castilleja chromosa": "فرشاة الرسم الصحراوية, كاستيليجا كروموزا (أكثر أنواع فرشاة الرسم شيوعاً في الأراضي الجافة غرب الولايات المتحدة؛ لها سيقان منتصبة تنتهي بسنابل كثيفة من الزهور البرتقالية الزاهية إلى الحمراء)",
 "castilleja miniata": "فرشاة الرسم الحمراء العملاقة, كاستيليجا مينياتا (زهرة برية في غرب أمريكا الشمالية لها عناقيد خشنة من الزهور القرمزية)",
 "castilleja sessiliflora": "فرشاة رسم السهول الكبرى, كاستيليجا لاطئة الأزهار (نبات مشعر بزهور وردية؛ السهول الكبرى إلى شمال المكسيك)",
 "castilleja sulphurea": "فرشاة الرسم الكبريتية, كاستيليجا كبريتية (نبات المروج الجبلية الرطبة له عناقيد خشنة من الزهور الصفراء الشاحبة)",
 "casting": "اختيار الممثلين, توزيع الأدوار (اختيار الممثلين للعب أدوار معينة في مسرحية أو فيلم) / رمي الصنارة (فعل رمي خيط الصيد فوق الماء بواسطة صنارة وبكرة) / سبك, صب (فعل إنشاء شيء ما عن طريق صبه في قالب) / قالب, مصبوب (شيء تم تشكيله بواسطة قالب)",
 "casting lots": "اقتراع, قرعة (اتخاذ قرار بالصدفة باستخدام القرعة (قش أو حصى وغيرها) التي يتم رميها أو سحبها)",
 "casting vote": "صوت مرجح (التصويت الحاسم الذي يدلي به رئيس الجلسة لحل التعادل)",
 "castle": "قَلْعَة, قِلْعَة (المرة الواحدة من القَلْع؛ حِصْن منيع غالبا يبنى على تلّ أو جبل أو مكان عالٍ منيع)\nمثال: هو يعيش في قلعة.",
 "castle in spain": "أحلام اليقظة, سرحان (الحلم بشرود ذهن أثناء اليقظة)",
 "castle in the air": "أحلام اليقظة, سرحان (الحلم بشرود ذهن أثناء اليقظة)",
 "castled": "مُسَنَّن, مُشَرَّف (له أو يشبه حزوزاً مربعة متكررة كتلك الموجودة في شرفات القلاع)",
 "castling": "تَبْيِيت",
 "castling long": "تبييت طويل (التبييت على جانب الوزير)",
 "castling short": "تبييت قصير (التبييت على جانب الملك)",
 "castor": "قبعة القندس (قبعة مصنوعة من فرو القندس (أو مادة مماثلة)) / عجلة الأثاث, عجلة دوارة (عجلة محورية متصلة بأسفل الأثاث أو الشاحنات أو الآلات المحمولة لجعلها قابلة للحركة) / رشاشة سكر (رجاجة ذات غطاء مثقوب لرش السكر البودرة)",
 "castor bean": "الخروع",
 "castor bean plant": "خروع, نبات الخروع (شجيرة كبيرة من إفريقيا الاستوائية وآسيا لها أوراق كفية كبيرة وكبسولات شائكة تحتوي على بذور هي مصدر زيت الخروع والريسين؛ تم توطينها على نطاق واسع في…)",
 "castor canadensis": "قندس العالم الجديد (نوع من القندس يوجد في جميع مناطق أمريكا الشمالية تقريباً باستثناء فلوريدا)",
 "castor fiber": "قندس العالم القديم (نوع أوروبي من القندس)",
 "castor oil": "زيت الخروع (مسهل يستخرج من بذور نبات الخروع؛ يستخدم في الطلاء والورنيش وكذلك طبياً)",
 "castor oil plant": "خِرْوَع, تَنُّوم",
 "castor sugar": "سكر ناعم الحبيبات (سكر ناعم الحبيبات جداً كان يرش قديماً من وعاء خاص)",
 "castor-oil plant": "خروع, نبات الخروع (شجيرة كبيرة من إفريقيا الاستوائية وآسيا لها أوراق كفية كبيرة وكبسولات شائكة تحتوي على بذور هي مصدر زيت الخروع والريسين؛ تم توطينها على نطاق واسع في…)",
 "castoreum": "جُنْدُبَادَسْتَر, خُصْيْة الْبَحْر",
 "castrate": "خَصَى (خصى يخصي: خصاء وخصيا؛ (خ ص ي): جعله خصياً)\nمثال: هناك خصى في حذائي.",
 "castrated": "خَصِيّ, مَخْصِيّ",
 "castration": "إِخْصَاء",
 "castration anxiety": "قلق الخصاء ((التحليل النفسي) قلق ناتج عن تهديدات حقيقية أو متخيلة للوظائف الجنسية؛ كان يطبق في الأصل على الرجال فقط ولكن يمكن من حيث المبدأ أن ينطبق على النساء)",
 "castrato": "كاستراتو, مخصي (مغنٍ ذكر تم خصيه قبل البلوغ ليحتفظ بصوت سوبرانو أو ألتو)",
 "castries": "كَاسْتْرِيس",
 "castroism": "كاستروية (شكل من أشكال الشيوعية طوره فيدل كاسترو في كوبا)",
 "casual": "سَطْحِيّ, عَابِر (مُسْتَعْجِل وبِدُون اهْتِمَام بِالتَّفَاصِيل؛ غَيْر شَامِل) / عَابِث, لَامُبَالٍ (يَتَّسِمُ بِعَدَمِ الِاكْتِرَاثِ وَالِاسْتِهْتَارِ) / بِلَا جُهْد, يَسِير (لَا يُظْهِر جُهْدًا أَوْ إِجْهَادًا) / عَادِيّ, يَوْمِيّ (مُنَاسِبٌ لِلْمُنَاسَبَاتِ العَادِيَّةِ أَوِ الرُّوتِينِيَّةِ)",
 "casually": "بِعَفَوِيَّة, بِلَا مُبَالَاة (بطريقة غير مبالية) / بِشَكْل عَرَضِيّ, غَيْر مَنْهَجِيّ (ليس بشكل منهجي أو وفقاً لخطة)\nمثال: ألقى نظرة غير مبالية على العناوين",
 "casualness": "تلقائية, عفوية (أسلوب عفوي) / عَرَضِيَّة, عَفْوِيَّة (حالة الحدوث دون انتظام؛ كون الشيء عرضياً أو طارئاً)",
 "casualty": "خسائر, خسارة (نقصان في الأفراد أو المعدات العسكرية) / إصابة مميتة, حادث مميت (حادث يتسبب في موت شخص ما) / ضَحِيَّة حادِث, مُصاب (شخص أصيب أو قتل في حادث) / إِصابَة, خَسارَة بَشَرِيَّة (شخص أصيب أو قتل أو أسر أو فقد في اشتباك عسكري)",
 "casualty care research center": "مركز أبحاث رعاية الإصابات (وكالة في وزارة الدفاع تعد مركزًا وطنيًا للأبحاث حول جميع جوانب السيطرة على الإصابات ورعاية المصابين)",
 "casuarina": "كازارينا (أي من الأشجار والشجيرات المختلفة من جنس الكازارينا ذات سيقان مفصلية ودوامات من أوراق تشبه القشور؛ ينتج بعضها خشباً صلباً ثقيلاً)",
 "casuarina equisetfolia": "صنوبر أسترالي (شجرة أسترالية شائعة تزرع على نطاق واسع كنبات زينة في المناطق الاستوائية؛ تنتج خشباً أحمر صلباً ثقيلاً)",
 "casuist": "سفسطائي (شخص يكون استدلاله دقيقاً وغالباً ما يكون خادعاً)",
 "casuistic": "إفتائي, قِيَاسي (من أو متعلق باستخدام المبادئ الأخلاقية لحل المشاكل الأخلاقية (الإفتاء في القضايا الأخلاقية)) / تبريري, سفسطائي (من أو متعلق أو يمارس الإفتاء التبريري (الكازويستية))\nمثال: استدلال سفسطائي دقيق للغاية",
 "casuistical": "إفتائي, قِيَاسي (من أو متعلق باستخدام المبادئ الأخلاقية لحل المشاكل الأخلاقية (الإفتاء في القضايا الأخلاقية)) / تبريري, سفسطائي (من أو متعلق أو يمارس الإفتاء التبريري (الكازويستية))\nمثال: استدلال سفسطائي دقيق للغاية",
 "casuistry": "إفتاء أخلاقي, دراسة الحالات الأخلاقية (فلسفة أخلاقية تقوم على تطبيق المبادئ الأخلاقية العامة لحل المعضلات الأخلاقية) / إفتاء سفسطائي, تلاعب بالألفاظ (مجادلة خادعة أو دقيقة بشكل مفرط وتهدف إلى التضليل)",
 "casus belli": "ذَرِيعَةُ الْحَرْبِ",
 "cat": "قِطّ (حَيْوَان مستأنس من عائلة السَنُّورِيّات، له في اللغة أسماء عديدة تذكر وتؤنث) / قِطَّة (حيوان مستأنس من فصيلة السنوريات) / هِرّ (القطّ؛ صوت الإبل أو دعائها إلى الماء) / هِرَّة (المؤنث من الْهِرّ) / سَنُّور / قطّ (حَيْوَان مستأنس من عائلة السَنُّورِيّات، له في اللغة أسماء عديدة تذكر وتؤنث)\nمثال: أعطنا هذا القط.",
 "cat and mouse": "لعبة القط والفأر (لعبة للأطفال يشكل فيها اللاعبون دائرة ويمسكون أيدي بعضهم؛ يرفعون أيديهم للسماح للاعب بالدخول داخل الدائرة أو يخفضونها لمنع لاعب ثانٍ يطارد الأول)",
 "cat and rat": "لعبة القط والفأر (لعبة للأطفال يشكل فيها اللاعبون دائرة ويمسكون أيدي بعضهم؛ يرفعون أيديهم للسماح للاعب بالدخول داخل الدائرة أو يخفضونها لمنع لاعب ثانٍ يطارد الأول)",
 "cat bear": "باندا أحمر, باندا أصغر (حيوان لاحم شبيه بالراكون من العالم القديم لونه بني محمر؛ يُعتبر في بعض التصنيفات غير مرتبط بالباندا العملاقة)",
 "cat box": "صندوق فضلات القطط (وعاء لفضلات القطط)",
 "cat burglar": "سارق منازل (لص يقتحم ويدخل منزل شخص آخر بشكل غير قانوني)",
 "cat cracker": "وحدة تكسير حفزي (مفاعل كيميائي لتحويل الزيوت ذات درجات الغليان العالية إلى وقود بدرجات غليان أقل في وجود محفز)",
 "cat fancier": "محب للقطط, مربي قطط (شخص يربي ويعتني بالقطط)",
 "cat flea": "برغوث القط (برغوث يتكاثر بشكل رئيسي على القطط والكلاب والجرذان)",
 "cat food": "القط الغذاء",
 "cat rig": "شِرَاع القَارِب الأُحَادِيّ (تجهيز القارب الشراعي ذي الصاري الواحد في المقدمة)",
 "cat scan": "صورة مسحية, مسح ضوئي (صورة منتجة عن طريق المسح)\nمثال: قام بتحليل مسح الدماغ",
 "cat scanner": "ماسح التصوير المقطعي المحوسب, ماسح كات (جهاز تصوير مقطعي يبني نموذجاً ثلاثي الأبعاد لجسم من خلال دمج مستويات متوازية)",
 "cat scratch disease": "مرض خدش القطة (مرض يعتقد أنه ينتقل إلى البشر عن طريق خدش من قطة)",
 "cat shark": "قرش القط (أسماك قرش صغيرة تعيش في القاع ذات عيون تشبه عيون القطط؛ توجد على طول المنحدرات القارية)",
 "cat squirrel": "سنجاب رمادي شرقي (سنجاب متوسط إلى كبير شائع في شرق أمريكا الشمالية؛ أُدخل الآن إلى إنجلترا) / سنجاب أحمر (سنجاب بني محمر شائع في أوروبا وأجزاء من آسيا)",
 "cat suit": "بدلة رقص, جمبسوت ضيق (رداء ضيق من مادة مطاطية يغطي الجسم من الكتفين إلى الفخذين (أو الكاحلين)؛ يرتديه راقصو الباليه ولاعبو الأكروبات)",
 "cat thyme": "زعتر القطط, ماروم (جعدة متوسطية لها أوراق زغبية صغيرة وزهور أرجوانية محمرة؛ جذابة للقطط)",
 "cat valium": "أسيد سوبر, سوبر سي (أسماء دارجة للكيتامين)",
 "cat's cradle": "لعبة الخيط (لعبة تُلعب بخيط ملفوف حول الأصابع)",
 "cat's ear": "أُذْن القَطّ (أَذَن؛ أَذَنَ: ( فعل ) أَذَنَ أَذْناً)\nمثال: من أذن لتوم باستعارة سيارتي?",
 "cat's eye": "عين القط, عين الهر (أي من الأحجار الكريمة المختلفة (مثل الكريسوبيريل أو العقيق الأبيض) التي تعكس الضوء عند قطعها بشكل مستدير)",
 "cat's feet": "رجل القط, هوضل (عشب معمر منخفض النمو له أوراق ذات زغب مبيض وعناقيد من الزهور البيضاء الصغيرة)",
 "cat's foot": "رجل القط, هوضل (عشب معمر منخفض النمو له أوراق ذات زغب مبيض وعناقيد من الزهور البيضاء الصغيرة)",
 "cat's tongue": "لِسَان قِطّ (فِي : جسم لحميّ مستطيل متحرك، يكون في الفم، ويصلح للتّذوُّق والبلع، وللنطق؛ جَارِحَة الْكَلَام؛ كَلِمَة)\nمثال: ماري لها فم ليس لها لسان.",
 "cat's-claw": "خرز أسود, مخلب القط (شجيرة منتصبة ذات أشواك صغيرة إن وجدت، ولها عناقيد من الزهور البيضاء إلى الصفراء تليها قرون منحنية مدببة وبذور سوداء لامعة؛ جزر الهند الغربية وفلوريدا)",
 "cat's-ear": "أذن القط, هندباء خنزيرية (عشب ضار أوروبي مستوطن على نطاق واسع في أمريكا الشمالية له رؤوس زهرية صفراء وأوراق تشبه أذن القط) / أذن القط (أي من النباتات العديدة من جنس كالوشورتوس ذات أزهار ببتلات على شكل آذان القطط)",
 "cat's-paw": "عقدة كف القط (عقدة في منتصف حبل تحتوي على حلقتين يمكن تعليق الرافعة فيهما) / أداة, بيدق (شخص يستخدمه آخر للوصول إلى غاية)",
 "cat's-tail": "بردي, بوط عريض الأوراق (نبات مستنقعات طويل برؤوس بذور أسطوانية تنفجر عند النضج وتذرف كميات كبيرة من الزغب؛ تستخدم أوراقه الطويلة المسطحة لصنع الحصير ومقاعد الكراسي؛ من…)",
 "cat-o'-nine-tails": "سوط ذو تسعة ذيول (سوط له تسعة حبال معقودة)\nمثال: كان البحارة البريطانيون يخشون السوط ذو التسعة ذيول",
 "cata-cornered": "مَائِلٌ قُطْرِيًّا عَبْرَ الزَّاوِيَة (مُنْحَرِفٌ عَبْرَ مُضَلَّعٍ عَلَى خَطٍّ قُطْرِيّ)",
 "catabatic": "هَابِط (لتيار هوائي أو رياح؛ يتحرك لأسفل أو أسفل منحدر بسبب التبريد خاصة في الليل)",
 "catabatic wind": "رياح هابطة (رياح ناتجة عن الحركة الهابطة للهواء البارد)",
 "catabiosis": "شيخوخة خلوية (الشيخوخة الطبيعية للخلايا)",
 "catabolic": "هَدْمِيّ (يتميز بالأيض الهددمي) / هدمي (يتعلق بـ أو يتميز بالهدم الغذائي (التقويض))",
 "catabolism": "أيض هدمي, هدم (تحلل المواد الأكثر تعقيدًا في الكائنات الحية إلى مواد أبسط مع إطلاق الطاقة)",
 "catacaustic": "كاوٍ انعكاسي (منحنى كاوٍ يتشكل بواسطة انعكاس الضوء من سطح منحني)",
 "catachresis": "استعارة متكلفة, سوء استخدام الكلمة (استخدام متكلف أو متناقض للكلمات إما عن طريق الخطأ أو عمداً (كما في الاستعارة المختلطة))",
 "catachrestic": "استعاري تعسفي (يشكل أو يتميز بـ أو يميل إلى الاستعارة التعسفية (استخدام كلمة في غير موضعها))",
 "catachrestical": "استعاري تعسفي (يشكل أو يتميز بـ أو يميل إلى الاستعارة التعسفية (استخدام كلمة في غير موضعها))",
 "cataclinal": "مُوَافِق الاِنْحِدَار (للوديان والأنهار؛ تجري في اتجاه الميل في طبقات الصخور المحيطة)",
 "cataclysm": "فاجعة, كارثة (حدث يؤدي إلى خسارة كبيرة وسوء حظ) / كارثة, نكبة جيولوجية (تغير عنيف ومفاجئ في سطح الأرض)\nمثال: تأثرت المدينة بأكملها بالكارثة التي لا يمكن إصلاحها",
 "cataclysmal": "فَادِح, كَارِثِيّ (تَدْمِيرِيٌّ بِشَكْلٍ بَالِغِ الشِّدَّةِ)",
 "cataclysmic": "فَادِح, كَارِثِيّ (تَدْمِيرِيٌّ بِشَكْلٍ بَالِغِ الشِّدَّةِ)",
 "catacomb": "سرداب الموتى (نفق تحت الأرض به تجاويف حيث كانت تُدفن الجثث (كما في روما القديمة))",
 "catacorner": "مَائِلٌ قُطْرِيًّا عَبْرَ الزَّاوِيَة (مُنْحَرِفٌ عَبْرَ مُضَلَّعٍ عَلَى خَطٍّ قُطْرِيّ)",
 "catadromous": "نَازِل (للأسماك) (يهاجر من المياه العذبة إلى البحر للتكاثر)",
 "catafalque": "منصة التابوت, نعش (نعش مزخرف يوضع عليه التابوت أثناء الجنازة)",
 "cataflam": "ديكلوفيناك البوتاسيوم, كاتافلام (دواء مضاد للالتهاب غير ستيرويدي (الاسم التجاري كاتافلام))",
 "catalan": "كَاتَالَانِيّ, كَاتَالَانِيَّة",
 "catalan language": "اللغة الكتالونية (اللغة الرومانسية التي يتم التحدث بها في كتالونيا في شرق إسبانيا (ذات صلة بالإسبانية والأوكسيتانية))",
 "catalase": "كاتالاز (إنزيم يوجد في معظم الخلايا النباتية والحيوانية يعمل كمحفز مؤكسد؛ يحلل بيروكسيد الهيدروجين إلى أكسجين وماء)",
 "catalatic": "كتالازي (من أو متعلق بإنزيم الكتالاز)",
 "catalectic": "أَبْتَر, مَنْقُوص الوَزْن ((في الشعر) غير مكتمل الوزن؛ خاصة نقص مقطع واحد أو أكثر في التفعيلة الأخيرة) / بيت ناقص التفعيلة الأخيرة ((في العروض) بيت شعر ينقصه مقطع في التفعيلة الأخيرة)",
 "catalepsy": "تَخَشُّب",
 "cataleptic": "تخشببي, جمدي (من أو لديه خصائص التخشب أو مصاب بالجمد) / مُتَخَشِّب, مُصاب بِالجُمْد (شخص يعاني من الجمد (التخشب))\nمثال: أشخاص مصابون بالتخشب",
 "catalexis": "حذف, نقصان (غياب مقطع لفظي في التفعيلة الأخيرة من سطر أو بيت شعر)",
 "catalina cherry": "كرز كاتالينا (شجيرة أو شجرة صغيرة دائمة الخضرة توجد في جزيرة كاتالينا (كاليفورنيا))",
 "catalog": "فهرس, كتالوج (كتاب أو كتيب يحتوي على حصر للأشياء) / فهرس, كتالوج (قائمة كاملة بالأشياء؛ عادة ما تكون مرتبة بشكل منهجي)\nمثال: وجده في كتالوج سيرز",
 "catalog buying": "شراء بالبريد (شراء البضائع ليتم شحنها عبر البريد)",
 "cataloged procedure": "إجراء مفهرس (مجموعة من عبارات التحكم التي وضعت في مكتبة ويمكن استرجاعها بالاسم)",
 "cataloger": "مفهرس (أمين مكتبة يقوم بتصنيف المنشورات وفقاً لنظام فئوي)",
 "catalogue": "كَتَالُوج, فِهْرِس",
 "cataloguer": "مفهرس (أمين مكتبة يقوم بتصنيف المنشورات وفقاً لنظام فئوي)",
 "catalonia": "كَاتَالُونِيَا / كَتَلُونِيَا / قَطَلُونِيَة",
 "catalpa": "فول هندي, كتلبة (شجرة من جنس كتلبة ذات أوراق كبيرة وزهور بيضاء تليها قرون رفيعة طويلة)",
 "catalpa bignioides": "كتالبا جنوبية (شجرة كتالبا من جنوب الولايات المتحدة)",
 "catalpa speciosa": "كتالبا شمالية (شجرة كتالبا من وسط الولايات المتحدة)",
 "catalufa": "كاتالوفا (سمكة آكلة للحوم زاهية الألوان تعيش في مياه غرب المحيط الأطلسي وجزر الهند الغربية)",
 "catalysis": "تحفيز, حفز (تسريع تفاعل كيميائي نتيجة وجود مادة لا تتغير كيميائياً في نهاية التفاعل)\nمثال: من بين أهم 50 مادة كيميائية أساسية، يتم إنشاء 30 منها مباشرة عن طريق التحفيز ويتم صنع 6 أخرى من مواد خام تم إنتاجها بطريقة التحفيز",
 "catalyst": "حَفَّاز",
 "catalytic": "تحفيزي, حفاز (متعلق أو مسبب أو ينطوي على التحفيز (الكيميائي))\nمثال: تفاعلات تحفيزية",
 "catalytic converter": "محول حفزي, محول الحَفَّاز",
 "catalytic cracker": "وحدة تكسير حفزي (مفاعل كيميائي لتحويل الزيوت ذات درجات الغليان العالية إلى وقود بدرجات غليان أقل في وجود محفز)",
 "catalytically": "تحفيزياً (بواسطة العمل التحفيزي؛ بطريقة تحفيزية)\nمثال: احتراق البروبان المستقر تحفيزياً",
 "catamaran": "طوف, كاتاماران (قارب ذو بدنين متوازيين مرتبطين ببعضهما بسطح واحد)",
 "catamenia": "حيض, دورة شهرية (الإفراز الشهري للدم من رحم النساء غير الحوامل من سن البلوغ حتى سن اليأس)\nمثال: كانت النساء مريضات وعرضة للحيض المفرط",
 "catamenial": "حيضي, طمثي (متعلق بالحيض (الطمث))\nمثال: دورة حيضية",
 "catamite": "مَأْبُون",
 "catamount": "أسد الجبال, بوما (سنوري أمريكي كبير يشبه الأسد) / وشق (قطط برية قصيرة الذيل ذات آذان معقودة عادة؛ تُقدر لفرائها)",
 "catamountain": "قط بري أوروبي (قط بري كثيف الذيل يعيش في أوروبا يشبه القط المنزلي ويعتبر سلف القط المنزلي)",
 "catananche": "سهمية, كانتانش (أي من عدة نباتات من جنس الكانتانش لها رؤوس طويلة السيقان من الزهور الزرقاء أو الصفراء)",
 "catananche caerulea": "سهم كيوبيد, هندباء زرقاء (نبات جنوب أوروبي ذو زهور داكنة العين بأشعة زرقاء مسطحة)",
 "catania": "قَطَانِيَة, قَطَالِيَة",
 "cataphasia": "ترداد الكلام (اضطراب في الكلام تتكرر فيه نفس الكلمة عدة مرات متتالية)",
 "cataphatic": "إثباتي, تأكيدي (من أو متعلق بالاعتقاد الديني بأن الله يمكن للبشر معرفته إيجابياً أو بالإثبات)",
 "cataphatism": "تشبيه, لاهوت إيجابي (الاعتقاد الديني بأن الله قد أعطى أدلة كافية لكي يعرفه البشر بشكل إيجابي ومؤكد (مثل: خلق الله آدم 'على صورته'))",
 "cataphoresis": "رحلان كهربائي (حركة الجسيمات المشحونة في مادة غروانية تحت تأثير مجال كهربائي؛ حيث تتجه الجسيمات ذات الشحنة الموجبة إلى الكاثود والسالبة إلى الأنود)",
 "cataphoretic": "رحلاني كهربائي (مكون من أو متعلق بالرحلان الكهربائي)",
 "cataphract": "كاتافراكت",
 "cataphyll": "ورقة حرشفية (ورقة مختزلة أو بالكاد نامية في بداية حياة النبات (أي الفلقات) أو في المراحل المبكرة من تطور الورقة)",
 "cataplasia": "تحول تراجعي, كاتابلاسيا ((في علم الأحياء) ارتداد تنكسي للخلايا أو الأنسجة إلى شكل أقل تمايزاً أو أكثر بدائية)",
 "cataplasm": "لبخة (ضمادة طبية تتكون من كتلة ساخنة لينة من دقيق أو طين تُنشر على قماش وتوضع على الجلد لعلاج المناطق الملتهبة أو تحسين الدورة الدموية)",
 "cataplastic": "ضموري (من أو متعلق بالضمور (أو التراجع الخلوي))",
 "catapres": "كاتابريس, كلونيدين (خافض لضغط الدم (الاسم التجاري كاتابريس) يمكن إعطاؤه عن طريق الفم أو عبر لصقات جلدية)",
 "catapult": "مَنْجَنِيق, مِرْجَام",
 "catapultian": "مقلاعي, منجنيقي (من أو يشبه المنجنيق)\nمثال: نوع من العمل المقلاعي",
 "catapultic": "مقلاعي, منجنيقي (من أو يشبه المنجنيق)\nمثال: نوع من العمل المقلاعي",
 "cataract": "شلالات قوية, مسقط مائي ضخم (شلال كبير؛ تدفق عنيف للمياه فوق جرف) / إعتام عدسة العين, الماء الأبيض (مرض عيني ينطوي على تغيم أو عتامة في العدسة الطبيعية للعين)",
 "cataract surgery": "جراحة الساد, عملية المياه البيضاء (جراحة عيون تتضمن إزالة كل أو جزء من العدسة واستبدالها بعدسة مزروعة داخل العين)",
 "catarrh": "نَزْلَة",
 "catarrhal": "نزلي (من أو متعلق بالنزلات (التهاب الأغشية المخاطية))\nمثال: الحمى النزلية هي أي من عدة أمراض تنفسية أو فموية للماشية مثل اللسان الأزرق في الخيول والأغنام",
 "catarrhal fever": "حمى نزفية (أي من العديد من أمراض الماشية التي تتميز بالحمى ووذمة الجهاز التنفسي)",
 "catarrhine": "ضيق الأنف (من أو يتعلق بقرود العالم القديم التي لها فتحات أنف متقاربة وتفتح لأسفل) / قرد العالم القديم (من أفريقيا أو الجزيرة العربية أو آسيا؛ له ذيول غير قابضة وفتحتا أنف متقاربتان)",
 "catarrhinian": "ضيق الأنف (من أو يتعلق بقرود العالم القديم التي لها فتحات أنف متقاربة وتفتح لأسفل)",
 "catasetum macrocarpum": "أوركيد قافز, كاتاسيتوم (أوركيد ذو زهور ذكرية وأنثوية في نفس العنقود؛ عندما يتم لمس نتوء حساس عند قاعدة عمود الزهرة الذكرية يتم قذف حبوب اللقاح فجأة)",
 "catastrophe": "كَارِثَة, فَاجِعَة / نَكْبَة, فَاجِعَة",
 "catastrophic": "كارِثِيّ, مُدَمِّر (يُسَبِّب دَمارًا شامِلًا أو خَرابًا بالِغًا)",
 "catastrophic illness": "مرض كارثي (مرض شديد يتطلب فترة طويلة من الاستشفاء أو التعافي؛ عادة ما ينطوي على تكاليف باهظة للمستشفيات والأطباء والأدوية)",
 "catastrophically": "كارثياً (بعواقب وخيمة أو كارثية)\nمثال: معقد كارثياً",
 "catathymia": "انفعالية مفرطة, كاتاسيميا (حالة تكون فيها العمليات العقلية تحت سيطرة العواطف)\nمثال: الفكرة الأصلية للكاتاسيميا التي طرحها ماير (1912)، ويرثام (1937)، وغيرهم من المعاصرين كانت أن الحالة تشكل هوية سريرية خاصة بها",
 "catatonia": "فصام تخشبي, فصام جامودي (شكل من أشكال الفصام يتميز بالميل للبقاء في حالة ذهول ثابتة لفترات طويلة؛ قد يفسح الجمود المجال لفترات قصيرة من الهياج الشديد) / جامود, كاتاتونيا (توتر مفرط؛ تصلب عضلي؛ عرض شائع في الفصام الجامودي)",
 "catatonic": "جامودي (يتميز بالجامود (الكاتاتونيا) خاصة إما التصلب أو الارتخاء الشديد للأطراف)",
 "catatonic schizophrenia": "فصام تخشبي, فصام جامودي (شكل من أشكال الفصام يتميز بالميل للبقاء في حالة ذهول ثابتة لفترات طويلة؛ قد يفسح الجمود المجال لفترات قصيرة من الهياج الشديد)",
 "catatonic type schizophrenia": "فصام تخشبي, فصام جامودي (شكل من أشكال الفصام يتميز بالميل للبقاء في حالة ذهول ثابتة لفترات طويلة؛ قد يفسح الجمود المجال لفترات قصيرة من الهياج الشديد)",
 "catawba": "لغة كاتاوبا (لغة سيووية يتحدث بها شعب كاتاوبا) / عنب كاتاوبا (عنب سهل التقشير؛ عنب مائدة أمريكي محمر) / كاتاوبا (فرد من الشعب السيوي الذي عاش سابقاً في الكارولينا)",
 "catawba language": "لغة كاتاوبا (لغة سيووية يتحدث بها شعب كاتاوبا)",
 "catbird": "طائر المواء (طائر مغرد من أمريكا الشمالية يشبه نداءه مواء القطة) / طائر التعريشة (أي من الطيور المتنوعة في المنطقة الأسترالية التي يبني ذكورها هياكل مزخرفة تشبه التعريشات لجذب الإناث)",
 "catboat": "قارب كات بوت (قارب شراعي بصارية واحدة مثبتة بعيداً في الأمام)",
 "catbrier": "عشبة الثور, فصة مستديرة الأوراق (كرمة خشبية شائكة جداً في شرق الولايات المتحدة تنمو في كتل متشابكة ولها سيقان مستديرة قوية بأوراق جلدية لامعة وأزهار خضراء صغيرة تليها عناقيد من التوت…)",
 "catcall": "صفير استهجان (صيحة تعبر عن الرفض)",
 "catch": "لُقْطَة / أَمْسَكَ (حَبَسَ الشيءَ، قَبَضَ عَلَيْهِ. و (يتعدى بالباء)؛ اِمْتَنَعَ بالشيءِ، اِعْتَصَمَ بِه. (يتعدى بالباء)) / مَسَكَ\nمثال: كنت أمسك بالكرة.",
 "catch a cold": "أُصِيبَ بِبَرْدٍ",
 "catch crop": "محصول بيني, محصول مؤقت (محصول ينمو بسرعة (مثل الخس) ويمكن زراعته بين محصولين عاديين يزرعان في مواسم متتالية أو بين صفين من المحاصيل في نفس الموسم)",
 "catch fire": "اِشْتَعَلَ",
 "catch pen": "حظيرة احتجاز (منطقة احتواء صغيرة أو متوسطة لحجز الحيوانات)",
 "catch phrase": "شعار, عبارة جذابة (عبارة أصبحت كلمة طنانة أو مشهورة)",
 "catchall": "جامعة, وعاء الخردوات (وعاء للأشياء المتفرقة)",
 "catcher": "ملتقط (مركز في فريق البيسبول للاعب الذي يتمركز خلف القاعدة الرئيسية ويلتقط الكرات التي يرميها الرامي) / ماسك, ملتقط ((في البيسبول) الشخص الذي يلعب في مركز الماسك خلف الضارب)",
 "catcher's mask": "قناع الماسك (قناع لحماية وجه الماسك في البيسبول)",
 "catchfly": "صائدة الذباب, ليخنيس (أعشاب معمرة في الغالب بسيقان لزجة تمسك بالحشرات؛ واسعة الانتشار في المنطقة المعتدلة الشمالية) / سيلينة",
 "catching": "إصابة, التقاط العدوى (أن تصبح مصاباً بالعدوى) / التقاط ((في البيسبول) اللعب في مركز الملتقط) / اكتشاف, رصد (فعل اكتشاف شيء ما؛ أو ملاحظة شيء ما) / سَارٍ, قَابِلٌ لِلِانْتِقَال ((في الأمراض) قابل للانتقال عن طريق العدوى)\nمثال: التقاط نزلة البرد أمر لا مفر منه أحياناً",
 "catching pen": "حظيرة احتجاز (منطقة احتواء صغيرة أو متوسطة لحجز الحيوانات)"
}
