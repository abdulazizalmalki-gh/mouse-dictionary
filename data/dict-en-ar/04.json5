 "canvasback duck": "بطة كانفاسباك (بطة برية من أمريكا الشمالية تُقدر كصيد وطعام)",
 "canvass": "خيش, قماش القنب (قماش ثقيل منسوج بإحكام) / أرضية الحلبة (البساط الذي يشكل أرضية الحلبة التي يتنافس فيها الملاكمون أو المصارعون المحترفون) / كانفاس, لوحة قماشية (لوحة زيتية على نسيج القنب (الكانفاس)) / خيمة قماشية (خيمة مصنوعة من نسيج القماش)\nمثال: نهض الملاكم عن أرضية الحلبة",
 "canvasser": "جامع الأصوات (شخص يأخذ أو يعد الأصوات) / منظم استطلاعات الرأي (شخص يجري دراسات استقصائية للرأي العام) / فاحص الأصوات (شخص يفحص الأصوات في الانتخابات) / جامع تبرعات, مستجدي (ملتمس يطلب مساهمات أو تجارة أو أصوات)\nمثال: منظم الاستطلاعات يجري استطلاعات الرأي العام",
 "canvassing": "حشد الأصوات, دعاية انتخابية (إقناع الناخبين في حملة سياسية)",
 "canyon": "خَانِق, أُخْدُود",
 "canyon live oak": "سنديان الأخاديد, سنديان الوادي الحي (شجرة دائمة الخضرة متوسطة الحجم موطنها جنوب غرب الولايات المتحدة وشمال غرب المكسيك، ذات أوراق مستطيلة جلدية غالباً ما تكون حوافها شوكية)",
 "canyon oak": "سنديان الأخاديد, سنديان الوادي الحي (شجرة دائمة الخضرة متوسطة الحجم موطنها جنوب غرب الولايات المتحدة وشمال غرب المكسيك، ذات أوراق مستطيلة جلدية غالباً ما تكون حوافها شوكية)",
 "canyon treefrog": "ضفدع الوادي الشجري (ساكن أرضي صغير بشكل رئيسي يبقى على مسافة قفز سهلة من الماء؛ من جنوب غرب الولايات المتحدة وشمال المكسيك)",
 "canyonside": "جانب الوادي (الجانب شديد الانحدار للوادي الضيق)",
 "caoutchouc": "مَطَّاط, كَاوْتْشُوك",
 "caoutchouc tree": "شجرة المطاط, هيفيا برازيلية (شجرة متساقطة الأوراق في نهري الأمازون وأورينوكو ذات أوراق جلدية وزهور بيضاء صفراء عطرة؛ تنتج عصارة لبنية هي المصدر الرئيسي للمطاط التجاري)",
 "cap": "قُبَّعَة, قُبَّعة (خرقة تخاطُ كالبُرْنس يلبسها الصِّبيان؛ غطاء للرأس يكون مُخّيَّط على عكس العَمَامَة التي لا يكون فيها خِيَاطَة. قُلُنْسُوَة)\nمثال: لقد اشترى قبعة.",
 "cap band": "شريط القبعة العسكرية (شريط يدور حول غطاء الرأس للقوات المسلحة، عادة ما يكون بلون داكن ومغاير، غالباً أسود، وقد يكون منقوشاً أو مخططاً)\nمثال: قبعات الضباط العامين مشابهة لقبعات الضباط الميدانيين، لكن شريط القبعة أزرق داكن ومطرز بزخارف أوراق البلوط الذهبية",
 "cap opener": "فتاحة أغطية (فتاحة زجاجات لخلع الأغطية)",
 "cap screw": "برغي غطاء (برغي ملولب لأجزاء الآلة؛ يُربط في ثقب ملولب)",
 "cap shroud": "حبال تدعيم رأس الصاري (حبال تدعيم متصلة بالقرب من رأس الصاري لتثبيت الصاري ضد الأحمال الجانبية)",
 "cap-a-pie": "مِن الرَّأْس إِلَى القَدَم (في جميع النقاط من الرأس إلى القدمين)\nمثال: كان مسلحاً من رأسه إلى أخمص قدميه",
 "capability": "قابلية, كفاءة (صفة القدرة (جسديًا أو فكريًا أو قانونيًا)) / إمكانية, قابلية (استعداد يمكن تطويره) / قابلية, قدرة (قابلية الشيء لعلاج أو معالجة معينة)\nمثال: عمل في حدود مقدرته",
 "capable": "قَادِر (الذي له قُدْرَة أو مقدرة؛ القويّ المتمكن؛ الذي يَقْدُر الأمور أي يقيسها ويُهيأها)\nمثال: سامي قادر على هذا.",
 "capableness": "قابلية, كفاءة (صفة القدرة (جسديًا أو فكريًا أو قانونيًا)) / إمكانية, قابلية (استعداد يمكن تطويره)\nمثال: عمل في حدود مقدرته",
 "capably": "باقتدار, بكفاءة (مع كفاءة؛ بطريقة مقتدرة)\nمثال: عملوا بكفاءة",
 "capacious": "مُتَّسِع",
 "capaciousness": "اتساع, رحابة (الكبر والامتداد المكاني (خاصة داخل المبنى)) / رحابة فكرية, سعة (الاتساع الفكري)\nمثال: أذهلت سعة حقيبة سانتا الطفل",
 "capacitance": "مكثف (جهاز كهربائي يتميز بقدرته على تخزين شحنة كهربائية) / سعة كهربائية, مواسعة (ظاهرة كهربائية يتم فيها تخزين شحنة كهربائية)",
 "capacitance unit": "وحدة سعة (مقياس لقدرة مكون الدائرة الكهربائية على تخزين الشحنة)",
 "capacitive": "سعوي (من أو متعلق بالسعة الكهربائية)",
 "capacitive sensor": "مستشعر سعوي (مستشعر يكتشف أي شيء موصل أو له عازل كهربائي مختلف عن الهواء)",
 "capacitor": "مُكَثِّف, مُكَثِّفَة",
 "capacitor microphone": "ميكروفون مكثف (ميكروفون يتكون من مكثف بلوح ثابت وآخر يشكل الحجاب الحاجز الذي تحركه الموجات الصوتية)",
 "capacitor mike": "ميكروفون مكثف (ميكروفون يتكون من مكثف بلوح ثابت وآخر يشكل الحجاب الحاجز الذي تحركه الموجات الصوتية)",
 "capacity": "سِعَة",
 "capacity measure": "وحدة حجم, وحدة سعة (وحدة لقياس الحجم أو السعة)",
 "capacity unit": "وحدة حجم, وحدة سعة (وحدة لقياس الحجم أو السعة)",
 "caparison": "غطاء زينة للحصان (معدات اسطبل تتكون من غطاء مزخرف للحصان، خاصة (سابقاً) لحصان الحرب)",
 "caparisoned": "مُجَلَّل, مُزَرْكَش (مكسوّ بأبهى الحلل (خاصة الخيل بزينتها))",
 "cape": "رَأْس (عُضْو مِنَ ٱلْجَسَدِ يَحْوِي الدِّمَاغ والفَم والأَنْف والعَيْنَيْن والأُذُنَيْن؛ أَعْلَى ٱلشَّيْءِ)\nمثال: قطع سامي رأس كلب.",
 "cape aloe": "صبار الكاب (نبات جنوب أفريقي كثير التفرع ذو أوراق عصارية شائكة محمرة)",
 "cape buffalo": "جاموس الرأس (جاموس كبير غالباً ما يكون متوحشاً في جنوب أفريقيا له قرون منحنية للأعلى؛ يوجد غالباً في محميات الصيد)",
 "cape dagga": "داغا, ذيل الأسد (عشب جنوب أفريقي غير سام نسبياً يدخن مثل التبغ)",
 "cape forget-me-not": "أذن الفأر الرأسي, كحلاء رأسية (كحلاء من جنوب إفريقيا لها زهور زرقاء بحلوق بيضاء) / كحلاء ضفافية (كحلاء من جنوب إفريقيا لها زهور زرقاء إلى حمراء أرجوانية)",
 "cape gooseberry": "حَرَنْكَش",
 "cape hunting dog": "كلب الصيد الأفريقي, كلب بري أفريقي (ثديي قوي يشبه الكلب من جنوب وشرق أفريقيا يصطاد في قطعان كبيرة؛ نادر الآن في المناطق المستوطنة)",
 "cape hyacinth": "ياقوتية الصيف, ياقوتية الكاب (عشب جنوب أفريقي بزهور بيضاء جرسية الشكل)",
 "cape jasmine": "غاردينيا, ياسمين الكاب (شجيرة دائمة الخضرة تزرع على نطاق واسع لزهورها البيضاء الشمعية العطرة الكبيرة وأوراقها اللامعة)",
 "cape jessamine": "غاردينيا, ياسمين الكاب (شجيرة دائمة الخضرة تزرع على نطاق واسع لزهورها البيضاء الشمعية العطرة الكبيرة وأوراقها اللامعة)",
 "cape kafferboom": "إريثرينا كافرا, شجرة المرجان (شجرة شبه دائمة الخضرة واسعة الانتشار صغيرة من شرق جنوب أفريقيا بزهور برتقالية قرمزية وبذور حمراء مرجانية صغيرة؛ تنتج خشباً ناعماً خفيفاً يستخدم…)",
 "cape lobster": "كركند الكاب (كركند صغير من جنوب أفريقيا)",
 "cape marigold": "قطيفة الرأس, قطيفة الشمس (أي من عدة نباتات من جنوب أفريقيا تُزرع لغزارة زهورها التي تشبه الأقحوان وعادة ما تكون صفراء وأوراقها العطرية)",
 "cape may warbler": "هازجة كيب ماي (هازجة غابات من أمريكا الشمالية؛ خضراء زيتونية وصفراء مخططة بالأسود)",
 "cape of good hope": "رَأْس اَلرَّجَاء اَلصَّالِح (عُضْو مِنَ ٱلْجَسَدِ يَحْوِي الدِّمَاغ والفَم والأَنْف والعَيْنَيْن والأُذُنَيْن؛ أَعْلَى ٱلشَّيْءِ)\nمثال: قطع سامي رأس كلب.",
 "cape periwinkle": "عناقية, عين البزون (عشب خشبي من العالم القديم يزرع عادة وله أزهار كبيرة وردية إلى حمراء)",
 "cape primrose": "زهرة الربيع الكيبية",
 "cape town": "كِيب تَاوْن",
 "cape tulip": "توليب الكاب (نبات مذهل ذو أوراق منبطحة كبيرة مخططة باللون البني المحمر وأزهار بكتلة من الأسدية الصفراء الطويلة في كأس من القنابات اللحمية الحمراء المرجانية؛ جنوب…)",
 "cape verde": "كَابُو فِيرْدِي, الرَّأْسُ ٱلْأَخْضَر",
 "cape verde escudo": "إسكودو, إسكودو الرأس الأخضر (وحدة المال الأساسية في الرأس الأخضر؛ تساوي 100 سنتافو)",
 "cape verde monetary unit": "وحدة نقدية للرأس الأخضر (الوحدة النقدية في الرأس الأخضر)",
 "cape yellowwood": "خشب أصفر أفريقي, خشب أصفر الكاب (شجرة أو شجيرة جنوب أفريقية ذات تاج مستدير)",
 "capelan": "كبلين (سمكة شمالية صغيرة جداً؛ غذاء للطيور البحرية والثدييات البحرية والأسماك الأخرى)",
 "capelet": "كيب صغير (رداء صغير يغطي الكتفين وترتديه النساء في الغالب)",
 "capelin": "كبلين (سمكة شمالية صغيرة جداً؛ غذاء للطيور البحرية والثدييات البحرية والأسماك الأخرى)",
 "capeline bandage": "رباط قلنسوي, ضمادة الرأس (ضمادة تغطي الرأس أو جذع البتر مثل القبعة)",
 "capella": "العَيُّوق",
 "caper": "كَبَر, كَبَّار (قَوْلُ 'الله أكْبَر'؛ أَحَدَ أَرْكَان الصَلاَة: كَبَّرَ المُصَلِّي)\nمثال: ما مدى كبر المسافة بين هنا وهناك؟",
 "caper sauce": "صلصة القبار (صلصة ألموند مع القبار)",
 "caper spurge": "فربيون الكبر, فربيون منشاري (فربيون سام من العالم القديم؛ دخيل في أمريكا؛ تنتج بذوره زيتاً مسهلاً)",
 "caper tree": "شجرة القبار الجامايكية (شجيرة من جنوب فلوريدا إلى جزر الهند الغربية) / شجرة القبار, قبار غاري الورق (شجيرة أو شجرة صغيرة من جنوب فلوريدا إلى أمريكا الوسطى والجنوبية)",
 "capercaillie": "ديك الخلنج, طيهوج الخشب (طيهوج أسود كبير من العالم القديم)",
 "capercailzie": "ديك الخلنج, طيهوج الخشب (طيهوج أسود كبير من العالم القديم)",
 "capernaum": "كفرناحوم",
 "capetian": "كابيتي (من أو متعلق بالسلالة الفرنسية التي أسسها هيو كابيه) / كابيتي (عضو في السلالة الكابية)",
 "capetian dynasty": "سلالة الكابيتيون (سلالة فرنجية أسسها هيو كابيه حكمت من 987 إلى 1328)",
 "capeweed": "أذن القط, هندباء خنزيرية (عشب ضار أوروبي مستوطن على نطاق واسع في أمريكا الشمالية له رؤوس زهرية صفراء وأوراق تشبه أذن القط)",
 "capful": "ملء غطاء (الكمية التي يستوعبها غطاء صغير)",
 "capibara": "خنزير الماء, كابيبارا (قارض برمائي من أمريكا الجنوبية بحجم الخنزير وعديم الذيل ذو أقدام مكففة جزئياً؛ أكبر القوارض الحية)",
 "capillarity": "خاصية شعرية (ظاهرة مرتبطة بالتوتر السطحي وتنتج ارتفاع أو انخفاض السوائل في الأنابيب الشعرية)",
 "capillary": "شُعَيْرَة دَمَوِيَّة",
 "capillary action": "خاصية شعرية (ظاهرة مرتبطة بالتوتر السطحي وتنتج ارتفاع أو انخفاض السوائل في الأنابيب الشعرية)",
 "capillary artery": "شريان شعري, شُرَيْن (أحد الشرايين الصغيرة رقيقة الجدران التي تنتهي في الشعيرات الدموية)",
 "capillary bed": "سرير شعيري, شبكة شعيرية (طبقة من الأنسجة مليئة بكثافة بالشعيرات الدموية)",
 "capillary fracture": "كسر شعري (كسر دون انفصال الأجزاء ويكون خط الكسر رفيعاً جداً)",
 "capillary tube": "أنبوب شعري, خاصية شعرية (أنبوب بقطر داخلي صغير؛ يحتفظ بالسائل عن طريق الخاصية الشعرية)",
 "capillary tubing": "أنبوب شعري, خاصية شعرية (أنبوب بقطر داخلي صغير؛ يحتفظ بالسائل عن طريق الخاصية الشعرية)",
 "capillary vein": "وريد دقيق, وريد صغير (وريد دقيق متصل بشعيرة دموية)",
 "capillary vessel": "شعيرة دموية (أي من الأوعية الدموية الدقيقة التي تربط الشرايين الصغيرة بالأوردة الصغيرة)",
 "capillary water": "ماء شعري (الماء الذي يبقى في التربة بعد تصريف ماء الجاذبية، والذي يخضع لقوانين الحركة الشعرية، ويكون على شكل غشاء حول حبيبات التربة)",
 "capital": "رَأْسْمَال, رَأْس مَال / تَاج العَمُود",
 "capital account": "حساب رأس المال ((في المالية) حساب لصافي قيمة شركة في تاريخ محدد) / حساب رأس المال ((في الاقتصاد) ذلك الجزء من ميزان المدفوعات الذي يسجل تدفق الأوراق المالية من وإلى الدولة)",
 "capital city": "عَاصِمَة (اسم فاعل؛ مؤنث عَاصِم؛ اسم؛ المَدِينَة الكبيرة) / حَاضِرَة (خلاف البَادِيَة، وهي الأرض التي فيها عمران وزرع مثل المدن والقرى والضياع؛ المَدِينَة الكبيرة، العَاصِمَة أو المِصْر. أكثر الاستخدامات شيوعا)\nمثال: باريس عاصمة فرنسا.",
 "capital cost": "تكلفة رأس المال (تكلفة الفرصة البديلة للأموال المستخدمة نتيجة لقرار استثماري؛ معدل العائد الذي يمكن أن تكسبه الشركة إذا اختارت استثماراً آخر بمخاطر معادلة)",
 "capital expenditure": "نفقات رأسمالية (تكلفة التحسينات طويلة الأجل)",
 "capital gain": "أرباح رأسمالية, مكاسب رأسمالية (المبلغ الذي يتجاوز به سعر بيع الأصل سعر الشراء؛ يتحقق الربح عند بيع الأصل)",
 "capital gains tax": "ضريبة الأرباح الرأسمالية (ضريبة تفرض على الأرباح الرأسمالية)\nمثال: لقد تجنب ضريبة الأرباح الرأسمالية عن طريق البيع على المكشوف",
 "capital letter": "حَرْف كَبِير (طَرَف وَجَانِب وَحَدّ؛ رَمْز مخطوط أو مطبوع يقوم مقام صوت أو كلمة أو عبارة أو معنى)\nمثال: ألف هو الحرف الأول للألف باء.",
 "capital levy": "ضريبة رأس المال (ضريبة تفرض على رأس المال أو الممتلكات)",
 "capital loss": "خسارة رأسمالية (المبلغ الذي يتجاوز به سعر شراء الأصل سعر البيع؛ تتحقق الخسارة عند بيع الأصل)",
 "capital market": "سُوق رَأْس الْمَال (مكان للبيع والشراء؛ جمع ساق، قال الله تعالى: 《رُدُّوهَا عَلَيَّ فَطَفِقَ مَسْحًا بِالسُّوقِ وَالْأَعْنَاقِ》)\nمثال: ذهبت إلى السوق.",
 "capital offense": "جريمة كبرى, جناية عقوبتها الإعدام (جريمة خطيرة جداً لدرجة أن عقوبة الإعدام تعتبر مناسبة لها)",
 "capital punishment": "إِعْدَام, عُقُوبَة الْإِعْدَام (في القانون: هي عقوبة يحددها القضاء على جريمة كبرى اقترفها المتهم وتؤدي إلى قتل المتهم غالبا بالشنق)\nمثال: محكم عليه بالإعدام.",
 "capital reserve": "احتياطي رأس المال (احتياطي تنشئه شركة للنفقات المتوقعة وغير المتوقعة؛ غير قابل للتوزيع كأرباح)",
 "capital ship": "سفينة رئيسية (سفينة حربية من الدرجة الأولى في الحجم والتسليح)",
 "capital stock": "رأس مال الأسهم (القيمة الدفترية للأسهم القائمة لشركة ما) / أسهم مصرح بها, رأس المال المصرح به (الحد الأقصى لعدد الأسهم المصرح بها بموجب شروط عقد تأسيس الشركة)",
 "capitalisation": "رسملة (بيع الأسهم الرأسمالية) / استغلال الفرص, توظيف رأس المال (فعل الاستفادة من فرصة ما) / رسملة (تقدير قيمة مشروع تجاري) / كتابة بحروف كبيرة (الكتابة باستخدام الأحرف الكبيرة)",
 "capitalism": "رَأْسْمَالِيَّة (الرَّسُمالبَّة : نظامٌ اقتصاديّ تكون فيه وسائل الانتاج مُلْكً لأَصحاب ِ الأَموال المُوَظَّفة؛ مجْموعُ الرَّأْسماايِّين أو البلدان الرَّأْسماليَّة)",
 "capitalist": "رَأْسُمَالِيّ (يفضل أو يمارس الرأسمالية) / رأسمالي (من أو يتعلق بالرأسمالية أو الرأسماليين) / رأسمالي (شخص يستثمر رأس المال في مشروع تجاري (خاصة المشاريع الكبيرة)) / رأسمالي (مدافع محافظ عن الرأسمالية)\nمثال: أمة رأسمالية",
 "capitalist economy": "اقتصاد رأسمالي, رأسمالية (نظام اقتصادي يقوم على الملكية الخاصة لرأس المال)",
 "capitalistic": "رَأْسُمَالِيّ (يفضل أو يمارس الرأسمالية) / رأسمالي (من أو يتعلق بالرأسمالية أو الرأسماليين)\nمثال: أمة رأسمالية",
 "capitalization": "رسملة (بيع الأسهم الرأسمالية) / استغلال الفرص, توظيف رأس المال (فعل الاستفادة من فرصة ما) / رسملة (تقدير قيمة مشروع تجاري) / كتابة بحروف كبيرة (الكتابة باستخدام الأحرف الكبيرة)",
 "capitate": "رَأْسِيُّ الشَّكْل (متضخّم فجأة وكُرَوِيّ عند الطرف) / عظم كبير (عظم الرسغ ذو الرأس المستدير الذي يتمفصل مع العظم السنعي الثالث)",
 "capitate bone": "عظم كبير (عظم الرسغ ذو الرأس المستدير الذي يتمفصل مع العظم السنعي الثالث)",
 "capitation": "الجزية, ضريبة الرؤوس (ضريبة تفرض على أساس مبلغ ثابت لكل شخص)",
 "capitol": "كَابِيتُول الوِلَايَات المُتَّحِدَة",
 "capitol hill": "كَابِيتُول هِيل",
 "capitula": "قراءة دينية قصيرة (قراءة قصيرة من الكتاب المقدس؛ تتم بعد المزامير)",
 "capitular": "مجمعي كنسي (من أو متعلق بفصل كنسي (مجمع رهبان))\nمثال: عقارات المجمع الكنسي",
 "capitulary": "مجمعي كنسي (من أو متعلق بفصل كنسي (مجمع رهبان))\nمثال: عقارات المجمع الكنسي",
 "capitulate": "اِسْتَسْلَمَ",
 "capitulation": "اِسْتِسْلَام",
 "capitulum": "هامة (ترتيب من الفروع المورقة يشكل قمة أو رأس الشجرة) / سنبلة, كوز (السنبلة المثمرة لنبات الحبوب وخاصة الذرة) / رأس, رؤيس (كتلة كثيفة من الزهور أو أوراق الشجر)\nمثال: رأس قرنبيط",
 "capiz": "محار النافذة (ذوات صدفتين بحرية شائعة في المياه الساحلية الفلبينية تتميز بصدفة شفافة مسطحة رقيقة كبيرة)",
 "caplin": "كبلين (سمكة شمالية صغيرة جداً؛ غذاء للطيور البحرية والثدييات البحرية والأسماك الأخرى)",
 "capo": "زعيم عصابة, كابو (رئيس فرع لعصابة الجريمة المنظمة)",
 "capon": "ديك مخصي (ذكر دجاج مخصي) / ديك مخصي (لحم ذكر الدجاج المخصي)",
 "capote": "عباءة بغطاء رأس, كابوت (عباءة طويلة بغطاء رأس يمكن سحبه فوق الرأس) / كابوت, معطف بغطاء رأس (معطف طويل بغطاء رأس يمكن سحبه فوق الرأس)",
 "capoten": "كابتوبريل, كابوتن (دواء (الاسم التجاري كابوتن) يمنع تكوين الأنجيوتنسين في الكلى مما يؤدي إلى توسع الأوعية؛ يستخدم في علاج ارتفاع ضغط الدم وفشل القلب الاحتقاني)",
 "cappadocia": "قَبَاذُق, قَبَادُوقِيَّة",
 "cappadocian": "كبادوكي (من أو متعلق بكبادوكيا أو شعبها أو ثقافتها)",
 "capparis arborea": "رمان أصلي, قبار شجري (شجرة أسترالية صغيرة تحمل ثماراً صالحة للأكل تشبه الرمان)",
 "capparis cynophallophora": "شجرة القبار الجامايكية (شجيرة من جنوب فلوريدا إلى جزر الهند الغربية)",
 "capparis flexuosa": "شجرة القبار, قبار غاري الورق (شجيرة أو شجرة صغيرة من جنوب فلوريدا إلى أمريكا الوسطى والجنوبية)",
 "capparis mitchellii": "برتقال أصلي, قبار ميتشلي (شجرة أسترالية صغيرة تحمل ثماراً أرجوانية داكنة صالحة للأكل)",
 "capparis spinosa": "قبار شائع, كبار (شجيرة شائكة مفترشة من منطقة البحر الأبيض المتوسط تزرع لبراعم زهورها المخضرة التي تخلل)",
 "capped": "مُغَطًّى, مُقَبَّب (مُغطَّى كأنه بقبعة أو تاج من نوع محدد) / مُلَبَّس (يُستخدَم خاصة عن الأسنان الأمامية التي عليها تيجان (اصطناعية))",
 "capped macaque": "مكاك القلنسوة (مكاك هندي ذو خصلة شعر تشبه القلنسوة)",
 "cappelletti": "رافيولي (أغلفة صغيرة دائرية أو مربعة من العجين بحشوات مالحة)",
 "capping machine": "آلة تغطية الزجاجات, كابة الزجاجات (جهاز يدوي أو أوتوماتيكي يستخدم لوضع الأغطية على الزجاجات)",
 "cappuccino": "كَابُتْشِينُو, كَابُّتْشِينُو",
 "cappuccino coffee": "كابتشينو (أجزاء متساوية من الإسبريسو والحليب الساخن مغطاة بالقرفة وجوزة الطيب وعادة الكريمة المخفوقة)",
 "capra aegagrus": "الوعل الفارسي, ماعز البازهر (ماعز بري في إيران والمناطق المجاورة)",
 "capra falconeri": "مارخور (ماعز هيمالايا كبير بقرون لولبية كبيرة)",
 "capra hircus": "ماعز أهلي (أي من سلالات الماعز المختلفة التي تربى من أجل الحليب أو اللحم أو الصوف)",
 "capra ibex": "آيبكس, وعل (ماعز بري في المناطق الجبلية في أوراسيا وشمال أفريقيا له قرون كبيرة منحنية للخلف)",
 "capreolus capreolus": "يحمور (أيل صغير رشيق يعيش في الغابات الأوراسية وله قرون صغيرة متشعبة)",
 "capric acid": "حمض الكابريك (حمض دهني يوجد في الزيوت والدهون الحيوانية؛ له رائحة كريهة تشبه الماعز)",
 "capriccio": "كابريتشيو (مقطوعة آلية لا تلتزم بقواعد أي شكل موسيقي محدد وتُعزف بارتجال)",
 "caprice": "نزوة, هوى (رغبة مفاجئة)\nمثال: اشتراه بدافع نزوة",
 "capricious": "مُتَقَلِّب",
 "capriciously": "بِتَقَلُّب (بطريقة متقلبة) / بِشَذُوذ, بِغَرَابَة (بشكل لا يمكن التنبؤ به)\nمثال: كانت هناك زنابق وبقع من السوسن، جزر من الأزرق الساطع موضوعة بتقلب في البحر الأخضر",
 "capriciousness": "تقلب, نزوة (سمة التصرف بشكل غير متوقع وبدافع نزوة أكثر منه بدافع العقل أو الحكم) / عَشْوَائِيَّة, مَزَاجِيَّة (صفة الانقياد لنزوات مفاجئة لا يمكن التنبؤ بها)\nمثال: أيأس من تقلب ونزوة ذاكرتي",
 "capricorn": "بُرْج اَلْجَدْي (ظهر وارتفع) / اَلْجَدْي\nمثال: وصل كارل إلى برج آخر.",
 "capricornus": "بُرْج اَلْجَدْي, اَلْجَدْي (ظهر وارتفع)\nمثال: وصل كارل إلى برج آخر.",
 "caprifig": "تين بري (صنف بري من التين الشائع يستخدم لتسهيل تلقيح أنواع معينة من التين)",
 "caprimulgid": "سبد (طيور غير جاثمة شفقية أو ليلية بشكل رئيسي بريش بني رمادي مبقع وعيون كبيرة؛ تتغذى على الحشرات)",
 "caprimulgiform bird": "سبديات (طيور غير جاثمة طويلة الأجنحة)",
 "caprimulgus carolinensis": "تشك ويلز ويدو (طائر كبير يشبه السبد الصياح من جنوب الولايات المتحدة)",
 "caprimulgus europaeus": "سبد أوروبي (سبد من العالم القديم)",
 "caprimulgus vociferus": "طائر السبد الصياح (سبد ليلي أمريكي ذو ريش رمادي وأبيض)",
 "caprine": "ماعزي (كونه أو يتعلق بـ أو يشبه الماعز)\nمثال: مخلوقات ماعزية",
 "caprine animal": "ماعز (أي من المجترات الرشيقة العديدة المرتبطة بالأغنام ولكن لها لحية وقرون مستقيمة)",
 "capriole": "طفرة, قفزة مرحة (قفزة أو وثبة مرحة) / قفزة الحصان, كابريول ((ترويض الخيول) قفزة عمودية لحصان مدرب مع ركلة بالساقين الخلفيتين في قمة القفزة)",
 "caproic acid": "حمض الكابرويك (حمض دهني يوجد في الزيوت والدهون الحيوانية أو يُصنع صناعياً؛ رائحته تشبه الماعز)",
 "capros aper": "سمك الخنزير (سمكة ذات خطم بارز)",
 "caprylic acid": "حمض الكابريليك (حمض دهني له طعم زنخ؛ يوجد في الزبدة والدهون والزيوت الأخرى)",
 "capsaicin": "كابسيسين (مركب بلوري لاذع عديم اللون مشتق من الفليفلة؛ مصدر حرارة الفلفل الحار)",
 "capsella bursa-pastoris": "كيس الراعي (عشبة أوروبية حولية بيضاء الزهر تحمل قروناً مثلثة الشكل مسننة؛ عالمية الانتشار تقريباً كعشبة دخيلة)",
 "capsicum": "نَبَات فُلْفُل (مصدر للفعل نَبَتَ؛ اسم جنس شامل لكل ما تنبته الأرض من شجر أو بقل أو عشب أو غيره) / فُلَيْفِلَة\nمثال: هذا النبات مهدد بالانقراض.",
 "capsicum annuum cerasiforme": "فلفل كرزي (نبات يحمل ثماراً صغيرة مستديرة عادة ما تكون لاذعة)",
 "capsicum annuum conoides": "فلفل مخروطي (نبات يحمل ثماراً حمراء أو صفراء أو أرجوانية مخروطية منتصبة لاذعة؛ يزرع أحياناً للزينة)",
 "capsicum annuum grossum": "بابريكا, فلفل حلو (نبات يحمل ثماراً كبيرة معتدلة سميكة الجدران عادة ما تكون على شكل جرس؛ فلفل السلطة الرئيسي)",
 "capsicum annuum longum": "فلفل تشيلي, فلفل حريف (نبات يحمل فلفلاً طويلاً حاراً جداً ومستدقاً بدقة؛ عادة ما يكون أحمر)",
 "capsicum baccatum": "فلفل الطيور (نبات يحمل ثماراً حمراء مستطيلة صغيرة جداً وحارة جداً؛ يشمل أشكالاً برية موطنها أمريكا الاستوائية؛ يعتقد أنه سلف الفلفل الحلو والعديد من الفلفل الحار)",
 "capsicum frutescens": "فلفل تاباسكو, فلفل حار (نبات يحمل فلفلاً أحمر مستطيلاً متوسط الحجم وحاراً جداً؛ يزرع بشكل رئيسي في ولايات ساحل الخليج لإنتاج الصلصة الحارة)",
 "capsicum frutescens baccatum": "فلفل الطيور (نبات يحمل ثماراً حمراء مستطيلة صغيرة جداً وحارة جداً؛ يشمل أشكالاً برية موطنها أمريكا الاستوائية؛ يعتقد أنه سلف الفلفل الحلو والعديد من الفلفل الحار)",
 "capsicum pepper plant": "فلفل, فليفلة (حَبّ حريف يوضع في الطعام أو يطحن يستخدم كتابل. يكون منه أسود أو أبيض، حرارته متوسطة؛ فُلْفُل حَارّ: نبات ثمره حريف لونه أخضر وقد يحمرّ شديد الحرارة. يؤكل كما هو أو يجفف ويطحن ويستخدم كتابل)\nمثال: نحب الفلفل الحار.",
 "capsid": "قفيصة (الغطاء الخارجي البروتيني المحيط بالحمض النووي للفيروس) / بق ميريد (نوع من بق الأوراق)",
 "capsizing": "انقلاب ((ملاحة) حدث انقلاب قارب في الماء عن طريق الخطأ)",
 "capstan": "رحوية, ملفاف (رافعة تدور في مستوى أفقي حول محور عمودي؛ تستخدم على السفن لرفع المرساة أو الأشرعة الثقيلة)",
 "capstone": "حجر التتويج, حجر القمة (حجر يشكل قمة الجدار أو المبنى) / تتويج, لمسة نهائية (لمسة أخيرة؛ إنجاز متوج؛ ذروة)",
 "capsula glomeruli": "محفظة بومان, محفظة كبيبية (غشاء مزدوج رقيق يحيط بكبيبة النفرون)",
 "capsular": "كبسولي, محفظي (من أو متعلق بكبسولة (محفظة)) / محفظي (يشبه الكبسولة (المحفظة))\nمثال: الرباط المحفظي هو كيس يحيط بالتجويف المفصلي لمفصل حر الحركة ومتصل بالعظام",
 "capsulate": "مُتَكَيِّس, مُغَلَّف بِكَبْسُولَة (يُوصَف بالبذور أو الأبواغ المحاطة بكبسولة)",
 "capsulated": "مُتَكَيِّس, مُغَلَّف بِكَبْسُولَة (يُوصَف بالبذور أو الأبواغ المحاطة بكبسولة)",
 "capsule": "كَبْسُولة",
 "captagon": "كبتاجون",
 "captain": "طَيَّار, قُبْطَان (اسم فاعل للمبالغة على وزن فَعَّال؛ الذي يقود الطَائِرَة سواء كانت مهنته أم لا) / نَقِيب, قُبْطَان / قَائِد, كَبْتِن\nمثال: لم توجه أبدا تهمة القيادة غير المسؤولة للطيار.",
 "captain hicks": "سُدَاسِيّ, سِتَّة (العدد الأصلي الذي هو مجموع خمسة وواحد)",
 "captain's chair": "كرسي القبطان (كرسي خشبي بذراعين ومقعد مقعر وظهر منخفض به قضبان عمودية)",
 "captaincy": "رتبة نقيب, شارة القيادة (منصب القائد أو النقيب)",
 "captainship": "رتبة نقيب, شارة القيادة (منصب القائد أو النقيب)",
 "caption": "تعليق (وصف موجز مصاحب لرسم توضيحي) / ترجمة مرئية, سطر ترجمة (ترجمة الحوار الأجنبي لفيلم أو برنامج تلفزيوني؛ تُعرض عادة في أسفل الشاشة) / اعتراض تافه, مماحكة (إبداء اعتراض؛ خاصة المراوغة المبنية على حجة خادعة)",
 "captious": "عَيَّاب, مُتَصَيِّدٌ لِلْأَخْطَاءِ (يميل إلى إيجاد العيوب ولفت الانتباه إليها)",
 "captiously": "بِانْتِقَاد, بِتَعَنُّت (بطريقة انتقادية متعنتة)\nمثال: كان متحذلقاً بتعنت",
 "captivate": "أَخَذَ, أَسَرَ (تَنَاوَلَ الشيء بيده، تملكه أو تحكم فيه، بالقوة أو بدونها؛ أمْسَكَ بِالشيء. (يتعدى بالباء))\nمثال: أخذ الولد يبكي.",
 "captivated": "مَأْسُور, مُنْبَهِر (مملوء بالدهشة والسرور) / مَسْحُور, مَفْتُون (منجذب بشدة)",
 "captivating": "أَخَّاذ",
 "captivatingly": "بِسِحْر, بِفِتْنَة (بطريقة ساحرة)\nمثال: كانت جميلة بشكل ساحر",
 "captivation": "افتتان, انبهار (شعور بإعجاب كبير بشيء رائع وغير عادي) / افتتان, انبهار (حالة الاهتمام الشديد بشيء ما (كما في الرهبة أو الإعجاب أو الرعب))",
 "captive": "أَسِير, أَسِيرَة (اَلْأَسِيرُ هُوَ مَنْ أُسِرَ فِي مَعْرَكَةٍ حَيّّا فَسُجِنَ إِلَى حِينٍ؛ الأَسيرُ: الأَخِيذُ) / أَسِير, مَحْبُوس (اَلْأَسِيرُ هُوَ مَنْ أُسِرَ فِي مَعْرَكَةٍ حَيّّا فَسُجِنَ إِلَى حِينٍ؛ الأَسيرُ: الأَخِيذُ)\nمثال: أنا بريء وأسير حرب.",
 "captive finance company": "شركة تمويل تابعة (شركة تمويل مملوكة لشركة مصنعة لتمويل مخزونات التجار أو لتقديم قروض للمستهلكين الذين يشترون منتجات الشركة)",
 "captivity": "أَسْر, سَبْي (الأَسْر : شدة الخَلْق؛ الأَسْر : القيدُ)\nمثال: إن توم لا يملك أسرة.",
 "captopril": "كابتوبريل, كابوتن (دواء (الاسم التجاري كابوتن) يمنع تكوين الأنجيوتنسين في الكلى مما يؤدي إلى توسع الأوعية؛ يستخدم في علاج ارتفاع ضغط الدم وفشل القلب الاحتقاني)",
 "captor": "آسر (شخص يأسر ويحتجز الناس أو الحيوانات)",
 "capture": "أَسْر (الأَسْر : شدة الخَلْق؛ الأَسْر : القيدُ) / أَسَرَ (الأَسْر : شدة الخَلْق؛ الأَسْر : القيدُ)\nمثال: إن توم لا يملك أسرة.",
 "capturer": "آسر (شخص يأسر ويحتجز الناس أو الحيوانات)",
