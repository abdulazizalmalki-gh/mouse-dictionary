 "candent": "مُتَأَجِّج, مُتَوَهِّج (يَبْعَث الضَّوْء نَتِيجَة التَّسْخِين)",
 "candescent": "مُتَوَهِّج بِالحَرَارَة (يَتَوَهَّج مِنْ شِدَّة الحَرَارَة)",
 "candid": "صَرِيح, فَصِيح (يَتَّسِم بِالمُبَاشَرَة فِي الأُسْلُوب أَوِ الكَلَام؛ بِدُون مُوَارَبَة أَوْ تَهَرُّب) / صَرِيح, مُبَاشِر (صريح ومباشر بلا تحفظ أو مواربة) / طَبِيعِيّ, عَفْوِيّ (غير رسمي أو طبيعي؛ خاصة ما يُلتقط على حين غرة)",
 "candid camera": "كاميرا خفية, كاميرا لقطات عفوية (كاميرا صغيرة بعدسة سريعة)",
 "candida": "كانديدا, مبيضات (أي من الفطريات الناقصة الشبيهة بالخميرة من جنس كانديدا)",
 "candida albicans": "كانديدا ألبيكانس, مبيضات بيضاء (فطر طفيلي يمكن أن يصيب الفم أو الجلد أو الأمعاء أو المهبل)",
 "candidacy": "حملة انتخابية (حملة المرشح ليتم انتخابه)",
 "candidate": "مُرَشَّح / مُرَشَّحَة",
 "candidature": "حملة انتخابية (حملة المرشح ليتم انتخابه)",
 "candidiasis": "داء المبيضات, سفاد (عدوى تسببها فطريات من جنس المبيضات (خاصة المبيضة البيضاء))",
 "candidly": "بِصَرَاحَة, بِصِدْق ((تستخدم للتأكيد وتعكس موقف المتحدث) من الصحيح بصدق أن)\nمثال: بصدق، أنا لا أصدق ذلك",
 "candidness": "صدق, صراحة (صفة كون الشخص صادقاً ومباشراً في الموقف والكلام)",
 "candied": "مُبَلْوَر, مُسَكَّر ((خَاصَّةً عَنِ الفَوَاكِه) مَحْفُوظ بِتَغْلِيفِه بِالسُّكَّر أَوْ تَشَرُّبِه إِيَّاه) / مُسَكَّر, مُغَلَّف بِالسُّكَّر (مُغَطّى بطبقة من السكر أو الشراب المركز)",
 "candied apple": "تفاح الحلوى, تفاح مكرمل (تفاحة مغطاة بمادة تشبه الحلوى (عادة سكر مكرمل))",
 "candied citrus peel": "قشر حمضيات مسكر (شرائح من قشر الحمضيات مطبوخة في شراب السكر)",
 "candied fruit": "فاكهة مبلورة, فاكهة مسكرة (فاكهة مطبوخة في شراب السكر ومغلفة ببلورات السكر)",
 "candle": "شَمْعَة, قِنْدِيل (عَمود تُعمَد عليه القَنْطَرة؛ وحدة تُقاس بها القوَّة الكهربائيَّة)\nمثال: أشعل سيسيل شمعة.",
