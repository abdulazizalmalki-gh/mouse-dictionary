 "caiman lizard": "سحلية الكايمن (سحلية شبيهة بالتمساح من أمريكا الجنوبية لها فكوك قوية لسحق القواقع وبلح البحر)",
 "caiman sclerops": "كايمان نظاراتي (كايمان ذو حواف عظمية حول العينين؛ يوجد من جنوب المكسيك إلى الأرجنتين)",
 "caimitillo": "كريسوفيلوم, ورقة الساتان (شجرة خشبية أمريكية استوائية ذات خشب ثقيل صلب داكن وثمار أرجوانية صغيرة تشبه البرقوق)",
 "caimito": "تفاح النجمة, كايميتو (شجرة دائمة الخضرة من جزر الهند الغربية وأمريكا الوسطى لها فاكهة أرجوانية صالحة للأكل على شكل نجمة في المقطع العرضي وأوراق خضراء داكنة بجوانب سفلية…)",
 "cain": "قَابِيل, قَايِين ((في الإسلام) أحد أبناء النبي آدم، يُعرف بأول من سنَّ القتل، حيث قتل أخاه هَابِيل)",
 "cainogenesis": "تطور محدث, تكون مستحدث (إدخال صفات أو بنية أثناء التطور الجنيني لم تكن موجودة في التاريخ التطوري السابق للسلالة أو النوع (مثل إضافة المشيمة في تطور الثدييات))",
 "caipiblack": "كايبيبلاك (نوع من الكايبيرينيا يصنع بالفودكا السوداء بدلاً من الكاشاسا)",
 "cairene": "قَاهِرِيّ",
 "cairina moschata": "بطة مسكية (بطة برية متوجة كبيرة من أمريكا الوسطى والجنوبية؛ مستأنسة على نطاق واسع)",
 "cairn": "كايرن تيريير (سلالة صغيرة خشنة الشعر من التيريير من اسكتلندا) / رجم, كومة حجارة (كومة من الحجارة مكدسة كنصب تذكاري أو لتحديد حد أو مسار)",
 "cairn terrier": "كايرن تيريير (سلالة صغيرة خشنة الشعر من التيريير من اسكتلندا)",
 "cairned": "مرجوم (مميز بوجود رجم (كومة حجارة))",
 "cairngorm": "كوارتز دخاني, كيرنغورم (كوارتز أصفر دخاني أو بني)",
 "cairns": "كِيرْنْز",
 "cairo": "الْقَاهِرَة (مدينة تقع في مِصر، وهي عاصمتها وأكبر مدنها؛ جمهورية القاهرة، وهي الجمهورية التي تقع فيها المدينة)\nمثال: أسكن في القاهرة.",
 "caisson": "صندوق غاطس, قيسون (حجرة كبيرة مانعة لتسرب الماء تستخدم للبناء تحت الماء) / صندوق ذخيرة (صندوق لحفظ الذخيرة) / عربة ذخيرة (مركبة عسكرية بعجلتين تحمل ذخيرة المدفعية) / لوحة غائرة (لوحة غائرة زخرفية في سقف أو قبة)",
 "caisson disease": "انسداد وعائي غازي, داء الغواص (ألم ناتج عن تغير سريع في الضغط الجوي)",
 "caitiff": "خَسِيس, وَضِيع (حَقِير الطَّبْع وجَبَان بِشَكْلٍ مُحْتَقَر) / جبان حقير, لئيم (شخص جبان وحقير)",
 "caitra": "شيترا (الشهر الأول من التقويم الهندوسي (يقابل مارس في التقويم الغريغوري))",
 "cajan pea": "بازلاء الحمام, بسلة هندية (بذور صغيرة ذات قيمة غذائية عالية لنبات بازلاء الحمام الاستوائي) / بازلاء الحمام, لوبيا العدس (عشبة خشبية استوائية ذات أزهار صفراء مبهرجة وقرون مسطحة؛ تزرع بكثرة في المناطق الاستوائية)",
 "cajanus cajan": "بازلاء الحمام, لوبيا العدس (عشبة خشبية استوائية ذات أزهار صفراء مبهرجة وقرون مسطحة؛ تزرع بكثرة في المناطق الاستوائية)",
 "cajolery": "مداهنة, ملاطفة (تملق يهدف إلى الإقناع)",
 "cajolingly": "بِتَمَلُّق, بِمُدَاهَنَة (بطريقة متملقة)\nمثال: 'تعال إلى هنا'، قالت بمداهنة",
 "cajun": "كاجون (لويزياني ينحدر من المهاجرين الأكاديين من نوفا سكوشا)",
 "cakchiquel": "لغة كاكتشيكيل (لغة مايانية يتحدث بها شعب كاكتشيكيل) / كاكشيكل (فرد من شعب المايا يعيش في جنوب وسط غواتيمالا)",
 "cakchiquel language": "لغة كاكتشيكيل (لغة مايانية يتحدث بها شعب كاكتشيكيل)",
 "cake": "كَعْكَة (واحدة الكَعْك؛ حَلْوَى تُصْنع من الدَقِيق والحَلِيب والسُكَّر والزَيت ويخبز طريًا وقد يوضع عليه القِشْطَة. يُسمى عند البعض كَيْك وعند البعض تُورْتَة)\nمثال: خبزت كعكة لتوم.",
 "cake mix": "خليط الكيك (خليط تجاري لصنع الكيك)",
 "cake mold": "قالب خبز, قالب كيك (قوالب أو صواني تستخدم لصنع المخبوزات وتأتي بأشكال وأحجام متنوعة)",
 "cake mould": "قالب خبز, قالب كيك (قوالب أو صواني تستخدم لصنع المخبوزات وتأتي بأشكال وأحجام متنوعة)",
 "cake tin": "قالب خبز, قالب كيك (قوالب أو صواني تستخدم لصنع المخبوزات وتأتي بأشكال وأحجام متنوعة)",
 "cakehole": "بوز, فم (مصطلحات عامية للفم)",
 "cakewalk": "أمر يسير, مهمة سهلة (إنجاز سهل للغاية) / كيك ووك (رقصة تبختر تعتمد على المسير؛ كانت تؤدى في عروض المنستريل؛ نشأت كمسابقة بين الراقصين السود للفوز بكعكة)\nمثال: كان الفوز بالبطولة نزهة بالنسبة له",
 "cakile maritima": "جرجير البحر, كاكيلي (نبات حولي ساحلي متحمل للملوحة يزرع لزهوره العطرة الوردية أو البنفسجية وأوراقه اللحمية الرمادية المخضرة)",
 "calaba": "شجرة سانتا ماريا, كالابا (شجرة من جزر الهند الغربية ذات عناقيد من الزهور البيضاء العطرة وتنتج خشباً متيناً وعصارة راتنجية)",
 "calabar bean": "فول كالابار (بذرة بنية داكنة شديدة السمية لكرمة فول كالابار؛ مصدر للفيزوستيغمين وتستخدم في السحر المحلي)",
 "calabar-bean vine": "فول كالابار (كرمة خشبية أفريقية استوائية تنتج حبوب كالابار)",
 "calabash": "دُبَّاء",
 "calabash pipe": "غليون القرع, غليون الكالاباش (غليون للتدخين؛ له ساق منحنية ووعاء كبير مصنوع من قرع الكالاباش)",
 "calabash tree": "شجرة القرع, كاليلاش (شجرة أمريكية استوائية دائمة الخضرة تنتج قرعاً مستديراً كبيراً)",
 "calabazilla": "قرع البراري, قرع الجاموس (كرمة معمرة في المناطق الجافة بوسط وجنوب غرب الولايات المتحدة والمكسيك ذات ثمار خضراء مرقطة صغيرة صلبة غير صالحة للأكل)",
 "calabur tree": "شجرة كالابور, كرز جامايكي (شجرة استوائية أمريكية سريعة النمو دائمة الخضرة ذات أزهار بيضاء وثمار صالحة للأكل لحمية؛ ينتج اللحاء أليافاً حريرية تستخدم في الحبال والخشب قيم للألواح)",
 "calabura": "شجرة كالابور, كرز جامايكي (شجرة استوائية أمريكية سريعة النمو دائمة الخضرة ذات أزهار بيضاء وثمار صالحة للأكل لحمية؛ ينتج اللحاء أليافاً حريرية تستخدم في الحبال والخشب قيم للألواح)",
 "caladenia": "كالادينيا (أي من بساتين الفاكهة المختلفة من جنس كالادينيا)",
 "caladenia cairnsiana": "سحلب الحمار الوحشي (سحلب بأوراق خطية محمرة وعنقود من الزهور الصفراء الشاحبة المعلمة بالأرجواني بشفة حمراء عميقة أو أرجوانية؛ جنوب غرب أستراليا)",
 "caladium": "أذن الفيل الملون, كالاديوم (أي نبات من جنس كالاديوم يزرع لأوراق الزينة المنقوشة بشتى الأشكال باللون الأبيض أو الوردي أو الأحمر)",
 "caladium bicolor": "كلاديوم ثنائي اللون (أكثر أنواع الكلاديوم شعبية؛ يزرع في العديد من الأصناف منذ أواخر القرن التاسع عشر)",
 "calamagrostic quadriseta": "عشبة القصب الأسترالية (عشبة أسترالية طويلة تشبه القصب تستخدم أحياناً للتبن)",
 "calamagrostis acutiflora": "عشبة القصب الريشية (نوع من عشبة القصب)",
 "calamari": "حبار, كاليماري ((في المطبخ الإيطالي) حبار مجهز كطعام)",
 "calamary": "حبار, كاليماري ((في المطبخ الإيطالي) حبار مجهز كطعام)",
 "calamine": "كالامين, هيميمورفيت (معدن أبيض؛ خام شائع للزنك)",
 "calamine lotion": "غسول كالامين (غسول يتكون من مستحضر سائل يحتوي على الكالامين؛ يستخدم لعلاج الحكة أو تهيجات الجلد الخفيفة)",
 "calamint": "فُوذَنَج",
 "calamintha grandiflora": "كالامينت كبير الأزهار (عشب عطري بزهور وردية كبيرة؛ موطنه جنوب وجنوب شرق أوروبا والأناضول وشمال إيران)",
 "calamintha nepeta": "بلسم الحقل, كالامينت صغير (عشب معمر عطري بقوة منخفض النمو من جنوب أوروبا إلى بريطانيا العظمى؛ تم توطينه في الولايات المتحدة)",
 "calamintha nepeta glantulosa": "بلسم الحقل, كالامينت صغير (عشب معمر عطري بقوة منخفض النمو من جنوب أوروبا إلى بريطانيا العظمى؛ تم توطينه في الولايات المتحدة)",
 "calamintha sylvatica": "كالامينت شائع, نعناع الجبل (نبات معمر برائحة النعناع من وسط وجنوب أوروبا)",
 "calamitous": "جَائِح",
 "calamity": "بَلَاء, بُؤْس",
 "calamondin": "كَلَمَنْسِي, كَلَمُنْدِين",
 "calamus": "قصبة الريشة (العمود الفقري المجوف للريشة) / عود الوج, قصب الذريرة (نبات مستنقعات معمر ذو أوراق تشبه السيف وجذور عطرية) / قصب الذريرة (الجذر العطري لنبات الوج المستخدم طبياً) / كلاموس, نخيل القصب (أي نخيل آسيوي استوائي من جنس كلاموس؛ سيقانه الخفيفة القوية مصدر لعيدان الروتان)",
 "calamus australis": "قصب المحامي (نخيل شائك متسلق طويل من شمال شرق كوينزلاند، أستراليا)",
 "calamus oil": "زيت القصب (زيت مسرطن من جذر القصب يُستخدم كعطر)",
 "calamus penna": "مرجان رأس الغنم (من فلوريدا وجزر البهاما إلى البرازيل)",
 "calamus rotang": "خيزران, رتان (نخيل متسلق من سريلانكا وجنوب الهند يتميز بطول سيقانه الكبير والتي تستخدم لعصي الملقا)",
 "calan": "إيزوبتين, فيراباميل (دواء (الأسماء التجارية كالان وإيزوبتين) يستخدم كحاصر للكالسيوم عن طريق الفم أو الحقن في حالات ارتفاع ضغط الدم أو فشل القلب الاحتقاني أو الذبحة…)",
 "calando": "كَالَانْدُو ((في الموسيقى) يتناقص تدريجيًّا في الإيقاع وشدّة الصوت)",
 "calandra lark": "قبرة كلاندرا",
 "calandrinia ciliata": "خادمة حمراء, كالاندرينا مهدبة (نبات عصاري يشكل بساطاً وله أزهار صغيرة زاهية باللون الوردي المحمر؛ جنوب غرب الولايات المتحدة)",
 "calanthe": "كالانث (أي من بساتين الفاكهة المبهرجة المختلفة من جنس كالانث ذات زهور بيضاء أو صفراء أو وردية وأوراق عريضة مطوية طولياً)",
 "calapan": "كالابان",
 "calapooya": "كالابويا (فرد من شعب هندي في أمريكا الشمالية في حوض ويلاميت، أوريغون)",
 "calapuya": "كالابويا (فرد من شعب هندي في أمريكا الشمالية في حوض ويلاميت، أوريغون)",
 "calash": "غطاء العربة المكشوفة (الغطاء القابل للطي لعربة تجرها الخيول) / غطاء رأس مطوي, كلاش (غطاء رأس نسائي كبير مطوي ومطوق؛ كان يُرتدى في القرن الثامن عشر)",
 "calash top": "غطاء العربة المكشوفة (الغطاء القابل للطي لعربة تجرها الخيول)",
 "calathian violet": "جنطيانا المستنقعات (جنطيانا أوراسية معمرة ذات زهور زرقاء سماوية قمعية الشكل تنمو في المروج المفتوحة الرطبة)",
 "calc-tufa": "توفة, توفة جيرية (صخر مسامي ناعم يتكون من كربونات الكالسيوم المترسبة من الينابيع الغنية بالجير)",
 "calcaneal": "عقبي (يتعلق بعظم العقب أو الكعب)",
 "calcaneus": "عظم العقب, عظم الكعب (أكبر عظام الرصغ؛ يشكل كعب الإنسان)",
 "calcareous": "جيري, طباشيري (مكون من أو يحتوي على أو يشبه كربونات الكالسيوم أو الكالسيت أو الطباشير)",
 "calcarine fissure": "التلم المهمازي (تلم في السطح الإنسي للفص القذالي للمخ)",
 "calcarine sulcus": "التلم المهمازي (تلم في السطح الإنسي للفص القذالي للمخ)",
 "calced": "منتعل (يُستخدم لبعض الطوائف الدينية التي يرتدي أفرادها الأحذية)",
 "calcedony": "عقيق أبيض, كالسيدوني (كوارتز حليبي أو رمادي نصف شفاف إلى شفاف)",
 "calceiform": "خفي الشكل (خاص بالأزهار التي تشبه الخف (الحذاء))\nمثال: الشفة الخفية الشكل لبعض بساتين الفاكهة",
 "calceolaria": "زهرة الخف, كالسيولاريا (أي نبات حديقة من جنس كالسيولاريا ذو زهور بشفة سفلية كبيرة منتفخة تشبه الخف)",
 "calceolate": "خفي الشكل (خاص بالأزهار التي تشبه الخف (الحذاء))\nمثال: الشفة الخفية الشكل لبعض بساتين الفاكهة",
 "calceus": "كلسيوس (حذاء يغطي الكاحل؛ ارتداه الرومان القدماء)",
 "calcic": "كلسي (مشتق من أو يحتوي على الكالسيوم أو الجير)",
 "calcicolous": "أليف الكلس, كلسي (ينمو أو يعيش في تربة غنية بالجير)",
 "calciferol": "فيتامين د, كالسيفيرول (فيتامين قابل للذوبان في الدهون يمنع الكساح)",
 "calciferous": "كلسي (يحمل أو ينتج أو يحتوي على الكالسيوم أو كربونات الكالسيوم أو الكالسيت)",
 "calcific": "تكلسي (يتضمن التكلس أو ينتج عنه)",
 "calcification": "تَكَلُّس",
 "calcifugous": "حمضي, نافر من الكلس (ينمو أو يعيش في تربة حمضية)",
 "calcimine": "كالسيمين (طلاء مائي يحتوي على أكسيد الزنك وغراء وملونات؛ يستخدم كطلاء للجدران والأسقف)",
 "calcination": "تكليس (تحويل المعادن إلى أكاسيدها نتيجة للتسخين إلى درجة حرارة عالية)",
 "calcined lime": "أكسيد الكالسيوم, الجير الحي (أكسيد بلوري أبيض يستخدم في إنتاج هيدروكسيد الكالسيوم)",
 "calcite": "كالسيت (معدن شائع يتكون من كربونات الكالسيوم المتبلورة؛ مكون رئيسي للحجر الجيري)",
 "calcitic": "كالسيتي (من أو متعلق بـ أو يحتوي على الكالسيت)",
 "calcitonin": "كالسيتونين (هرمون الغدة الدرقية الذي يميل لخفض مستوى الكالسيوم في بلازما الدم وتثبيط ارتشاف العظام)",
 "calcium": "كَلْسِيُوم, كَالْسِيُوم",
 "calcium bicarbonate": "بيكربونات الكالسيوم",
 "calcium blocker": "حاصر الكالسيوم, حاصر قنوات الكالسيوم (أي من فئة الأدوية التي تمنع تدفق إلكتروليت الكالسيوم (إما في التوصيل العصبي أو انقباض العضلات الملساء للقلب)؛ تستخدم في علاج الذبحة الصدرية أو عدم…)",
 "calcium carbide": "كربيد الكالسيوم",
 "calcium carbonate": "كربونات الكالسيوم (ملح يوجد في الطبيعة كطباشير أو كالسيت أو أراجونيت أو حجر جيري)",
 "calcium chloride": "كلوريد الكالسيوم (ملح متميع؛ يستخدم في إزالة الجليد وكعامل تجفيف)",
 "calcium hydrate": "جير, هيدروكسيد الكالسيوم (مادة كاوية تنتج عن تسخين الحجر الجيري)",
 "calcium hydride": "هيدريد الكالسيوم",
 "calcium hydroxide": "جير, هيدروكسيد الكالسيوم (مادة كاوية تنتج عن تسخين الحجر الجيري)",
 "calcium hypochlorite": "هيبوكلوريت الكالسيوم (أي هيبوكلوريت للكالسيوم؛ يستخدم كعامل تبييض)",
 "calcium ion": "أيون الكالسيوم (أيون الكالسيوم؛ عامل في تخثر الدم)",
 "calcium lactate": "لاكتات الكالسيوم (ملح بلوري أبيض يُصنع بتفاعل حمض اللاكتيك مع كربونات الكالسيوم؛ يستخدم في الأطعمة ويعطى طبياً كمصدر للكالسيوم)",
 "calcium light": "ضوء الكلس (مصباح يتكون من لهب موجه إلى أسطوانة من الجير مع عدسة لتركيز الضوء؛ كان يستخدم سابقاً لإضاءة المسرح)",
 "calcium nitrate": "نترات الكالسيوم (ملح متميع قابل للذوبان في الماء؛ يستخدم أحياناً كمصدر للنيتروجين في الأسمدة)",
 "calcium octadecanoate": "ستيرات الكالسيوم (ملح كالسيوم غير قابل للذوبان لحمض الستيريك وحمض البالمتيك؛ يتكون عند خلط الصابون بالماء الذي يحتوي على أيونات الكالسيوم وهو الزبد الذي ينتج في مناطق…)",
 "calcium oxide": "أكسيد الكالسيوم, الجير الحي (أكسيد بلوري أبيض يستخدم في إنتاج هيدروكسيد الكالسيوم)",
 "calcium phosphate": "فوسفات الكالسيوم (فوسفات للكالسيوم؛ مكون رئيسي لعظام الحيوانات)",
 "calcium stearate": "ستيرات الكالسيوم (ملح كالسيوم غير قابل للذوبان لحمض الستيريك وحمض البالمتيك؛ يتكون عند خلط الصابون بالماء الذي يحتوي على أيونات الكالسيوم وهو الزبد الذي ينتج في مناطق…)",
 "calcium sulfate": "كبريتات الكالسيوم",
 "calcium sulphate": "كبريتات الكالسيوم",
 "calcium-channel blocker": "حاصر الكالسيوم, حاصر قنوات الكالسيوم (أي من فئة الأدوية التي تمنع تدفق إلكتروليت الكالسيوم (إما في التوصيل العصبي أو انقباض العضلات الملساء للقلب)؛ تستخدم في علاج الذبحة الصدرية أو عدم…)",
 "calcium-cyanamide": "سياناميد, سياناميد الكالسيوم (مركب يستخدم كسماد وكمصدر لمركبات النيتروجين)",
 "calcium-silicate brick": "طوب رملي جيري, طوب سيليكات الكالسيوم (طوب مصنوع من الرمل والجير المطفأ بدلاً من الطين؛ عادة ما يكون لونه رمادياً فاتحاً أو أبيض مائلاً للصفرة)",
 "calculability": "قَابِلِيَّة الحِسَاب (صفة الخضوع للحساب أو إمكانية التحقق بالحساب)",
 "calculable": "قَابِل لِلْتَّقْدِير, قَابِل لِلْحِسَاب (قادر على أن يُحسب أو يُقدر)\nمثال: خطر قابل للحساب",
 "calculate": "حَسَبَ (عَدَّ مع الجَمْع والطَرْح وغيرها من العمليات الحِسَابية؛ عند أكثر العامة: هو العَدّ مطلقا)\nمثال: حسب سامي المال.",
 "calculated": "مَحْسُوب, مَدْرُوس (مُفكَّر فيه بعناية مسبقًا)",
 "calculating": "داهِيَة, مُتَآمِر (حاذِق في التَّدْبير والتَّخْطيط بِمَكْر وحِيلَة)",
 "calculating machine": "آلة حاسبة (آلة صغيرة تستخدم للحسابات الرياضية؛ يمكن أن تكون ميكانيكية أو إلكترونية)",
 "calculatingly": "بحساب ومكر (بطريقة محسوبة)\nمثال: نظر إليها بحساب ومكر",
 "calculation": "حَسْب, مُحَاسَبَة (عَدَّ مع الجَمْع والطَرْح وغيرها من العمليات الحِسَابية؛ عند أكثر العامة: هو العَدّ مطلقا)\nمثال: حسب سامي المال.",
 "calculative": "داهِيَة, مُتَآمِر (حاذِق في التَّدْبير والتَّخْطيط بِمَكْر وحِيلَة)",
 "calculator": "حَاسِبَة, آلَة حَاسِبَة (أو حَسِبَ أو كلاهما)\nمثال: هذه حاسبة ييذير.",
 "calculous": "حصوي (يتعلق بـ أو ناتج عن أو لديه حصاة أو حصوات)",
 "calculus": "حِسْبَان / حِسْبَان, التَّفَاضُل وَ التَّكَامُل",
 "calculus of variations": "حساب المتغيرات (حساب القيم القصوى والدنيا للتكاملات المحددة)",
 "calcutta": "كَالْكُوتَا",
 "calcuttan": "كلكتي (من أو يتعلق بكلكتا أو سكانها أو يميزهم)",
 "caldera": "حُفْرَة بُرْكَانِيَّة, فُوَّهَة",
 "caldron": "قِدر كبير, مِرْجَل (وعاء كبير جداً يستخدم للغلي)",
 "calean": "أرجيلة, شيشة (غليون تبغ شرقي ذو أنبوب مرن طويل متصل بوعاء حيث يتم تبريد الدخان بمروره عبر الماء)\nمثال: عالم ثنائي القطب مع الأرجيلة والقهوة التركية مقابل الهامبرغر والكوكا كولا",
 "caleb": "كَالِب",
 "caleche": "غطاء العربة المكشوفة (الغطاء القابل للطي لعربة تجرها الخيول) / غطاء رأس مطوي, كلاش (غطاء رأس نسائي كبير مطوي ومطوق؛ كان يُرتدى في القرن الثامن عشر)",
 "calefacient": "مُدَفِّئ, مُسَخِّن (يُنتِج إحساساً بالحرارة عند وضعه على الجسم)",
 "calefaction": "تدفئة, تسخين (خاصية التسبب بالدفء)",
 "calefactive": "تَسْخِينِيّ (يُستعمَل للتسخين والتدفئة)",
 "calefactory": "تَسْخِينِيّ (يُستعمَل للتسخين والتدفئة)",
 "calendar": "تَقْوِيم",
 "calendar day": "يوم تقويمي, يوم مدني (يوم يحسب من منتصف الليل إلى منتصف الليل)",
 "calendar method": "طريقة التقويم, طريقة العد (تنظيم الأسرة الطبيعي الذي يُفترض فيه حدوث الإباضة قبل 14 يوماً من بدء الدورة الشهرية)",
 "calendar method of birth control": "طريقة التقويم, طريقة العد (تنظيم الأسرة الطبيعي الذي يُفترض فيه حدوث الإباضة قبل 14 يوماً من بدء الدورة الشهرية)",
 "calendar month": "شهر, شهر تقويمي (أحد الأقسام الاثني عشر للسنة التقويمية)\nمثال: دفع الفاتورة الشهر الماضي",
 "calendar week": "أسبوع (فترة من سبعة أيام متتالية)",
 "calendar year": "سنة تقويمية, سنة ميلادية (السنة (التي تحسب من 1 يناير إلى 31 ديسمبر) وفقاً للتقويم الغريغوري)",
 "calender": "مَاكِينَة صَقْل اَلْوَرَق / صَقَلَ",
 "calendered": "مَصْقُول, مُلَمَّع ((عن الورق والقماش والجلد) ذو سطح أملس ولامع خاصة بالضغط بين الأسطوانات)",
 "calendric": "تقويمي (يتعلق بـ أو من خصائص أو مستخدم في التقويم أو قياس الوقت)\nمثال: أنظمة تقويمية",
 "calendrical": "تقويمي (يتعلق بـ أو من خصائص أو مستخدم في التقويم أو قياس الوقت)\nمثال: أنظمة تقويمية",
 "calends": "غُرَّة (بياض في جبهة الفرس فوق العينين أو بينهما وتحت الأذنين. انظر الصورة؛ أول يوم في الشهر، أو ليلة اِسْتِهْلَال القمر)",
 "calendula": "آذريون, بكورية (أي من العديد من الأعشاب الحولية بشكل رئيسي من جنس الآذريون تُزرع على نطاق واسع لزهورها الصفراء أو البرتقالية؛ تستخدم غالباً لأغراض طبية وطهوية)",
 "calendula officinalis": "آذريون, أقحوان الذهب (القطيفة السنوية الأوروبية الشائعة)",
 "caley pea": "بازلاء سنجلتاري, جلبان مشعر (نبات حولي شتوي ضعيف الساق موطنه منطقة البحر الأبيض المتوسط واستقر منذ فترة طويلة في جنوب الولايات المتحدة؛ يزرع كمحصول تغطية ومرعى)",
 "calf": "عِجْل (أسرع في إنجاز شيء أو القيام به؛ قدم شيئًا قبل وقته المعتاد) / دَغْفَل, حُوَار / بَطَّة, رَبْلَةُ (نوع من الطيور يسبح في الماء والأنواع البرية منه تهاجر إلى إفريقيا شتاءً؛ العضلة الخلفية في الساق) / بَطْن اَلسَّاق (خلاف الظهر؛ الجزء الباطن من الشيء غير الظاهر؛ الجزء الداخلي من الشيء)\nمثال: أنا في عجلة من أمري.",
 "calf bone": "شَظْيَة",
 "calf love": "إعجاب عابر, حب المراهقة (حب مؤقت لمراهق)",
 "calf raise": "رَفْع رَبْلَة السَّاق, رَفْع السَّمَانَة (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ)\nمثال: رفع سامي نظارته.",
 "calf roping": "صيد العجول بالحبل (إمساك عجل بحبل وربط قدميه)",
 "calf's brain": "مخ عجل (مخ العجل يؤكل كلحم)",
 "calf's liver": "كبد عجل (كبد العجل يستخدم كطعام)",
 "calf's tongue": "لسان عجل (لسان العجل يؤكل كلحم)",
 "calf's-foot jelly": "كوارع, هلام أقدام العجل (هلام مالح مصنوع من الجيلاتين المستخرج من غلي أقدام العجول)",
 "calfskin": "جلد العجل (جلد ناعم من جلد عجل)",
 "caliber": "عِيَار (اسم للمُعَايَرَة؛ كل ما تقدر به الأشياء من كيل أو وزن)\nمثال: هل أصبت بعيار ناري؟",
 "calibrated": "مدرج, معاير (معلم بـ أو مقسم إلى درجات)\nمثال: ميزان حرارة معاير",
 "calibration": "معايرة (المُعايرَةُ :  تقدير الشيء بالوزن أو الحجم حسب معايير قياسية معروفة؛ المُعايرَةُ : ( و) التقدير بالحجم بمحاليلَ قياسيةٍ معروفةٍ قُوَّتُها)",
 "calibre": "جودة, عيار (درجة أو مرتبة من التميز أو القيمة) / عيار, قُطْر داخلي (قُطر أنبوب أو ماسورة سلاح ناري)\nمثال: ارتفعت جودة الطلاب",
 "caliche": "كاليش (صخر أو حصى حامل للنترات من رواسب نترات الصوديوم في تشيلي وبيرو) / قشرة كلسية, كاليش (قشرة أو طبقة من التربة التحتية الصلبة المغطاة بكربونات الكالسيوم توجد في المناطق القاحلة أو شبه القاحلة)",
 "caliche-topped": "مَكْسُوٌّ بِالكَالِيش (مُغَطًّى بِالكَالِيشِ وَهِيَ تُرْبَةٌ صُلْبَةٌ مُتَكَلِّسَة)",
 "calico": "أَبْلَق, مُتَعَدِّد الأَلْوَان (ذو أجزاء أو بقع ملوّنة بألوان مختلفة وزاهية عادةً) / كاليكو, منقط (مصنوع من الكاليكو (قماش قطني) أو يشبه الكاليكو في كونه منقوشاً) / كاليكو (قماش خشن ذو طباعة زاهية)\nمثال: فساتين كاليكو",
 "calico aster": "أستر جائع, أستر كاليكو",
 "calico bush": "غار الجبل, كلمية عريضة الأوراق (شجيرة دائمة الخضرة من أمريكا الشمالية لها أوراق لامعة وزهور بيضاء أو وردية اللون)",
 "calico cat": "قط ذبل, قط كاليكو (قط ذو علامات سوداء وكريمية وصفراء)",
 "calico crab": "سلطعون السيدة الأمريكي (سلطعون مرقط بزهو يعيش في الشواطئ الرملية لساحل المحيط الأطلسي للولايات المتحدة)",
 "calicular": "كؤيسي (يتعلق بـ أو يشبه الكؤيس (كأس صغير))",
 "caliculus": "كؤيس (بنية صغيرة على شكل كوب (مثل برعم التذوق أو الكأس البصرية أو تجويف المرجان المحتوي على البوليب))",
 "calidris canutus": "دريجة حمراء (طيطوي يتكاثر في القطب الشمالي ويشتي في نصف الكرة الجنوبي)",
 "calidris ferruginea": "دريجة كروانية (طيطوي من العالم القديم له منقار منحني مثل الكروان)",
 "calidris melanotos": "دريجة سوداء الظهر (طيطوي أمريكي ينفخ صدره عند المغازلة)",
 "calif": "خليفة (الزعيم المدني والديني لدولة إسلامية ويعتبر ممثلاً لله على الأرض)\nمثال: يعتقد العديد من المسلمين المتطرفين أن الخليفة سيوحد جميع الأراضي والشعوب الإسلامية ويخضع بقية العالم",
 "california": "كَالِيفُورْنِيَا",
 "california allspice": "بهار كاليفورنيا, شجيرة التوابل (شجيرة عطرية متناثرة من جنوب غرب الولايات المتحدة لها زهور بنية عطرة)",
 "california bay tree": "آس أوريغون, غار كاليفورنيا (شجرة ساحل المحيط الهادئ ذات أوراق عطرية وزهور خيمية صغيرة تليها ثمار تشبه الزيتون؛ تنتج خشباً صلباً متيناً)",
 "california beauty": "شجيرة الفانيلا (أي من الشجيرات دائمة الخضرة الجميلة في كاليفورنيا وشمال المكسيك ذات أوراق مفصصة زغبية وأزهار صفراء مبهرجة)",
 "california black oak": "بلوط أسود كاليفورني (شجرة كبيرة متساقطة الأوراق من ساحل المحيط الهادئ لها أوراق عميقة الفصوص ذات أطراف شائكة)",
 "california black walnut": "جوز كاليفورنيا الأسود (شجرة متوسطة الحجم بأوراق مركبة عطرية نوعاً ما ومكسرات صالحة للأكل)",
 "california bluebell": "جريس كاليفورنيا (نبات حولي من جنوب كاليفورنيا بسيقان متفرعة بشكل معقد ونوارات فضفاضة من الزهور العطرية الزرقاء العميقة بوقية الشكل) / جريس كاليفورنيا, ويتلافيا (نبات صحراوي من جنوب كاليفورنيا بزهور أنبوبية زرقاء أو بنفسجية في عناقيد طرفية)",
 "california box elder": "قيقب مانيتوبا الكاليفورني (قيقب من ساحل المحيط الهادئ للولايات المتحدة؛ الثمار بيضاء عند النضج)",
 "california buckthorn": "توت القهوة, نبق كاليفورنيا (شجيرة دائمة الخضرة في غرب الولايات المتحدة تحمل ثماراً حمراء أو سوداء صغيرة)",
 "california buckwheat": "حنطة سوداء برية, حنطة سوداء كاليفورنيا (شجيرة منخفضة النمو ذات فروع منتشرة وزهور في رؤوس فضفاضة؛ المناطق الصحراوية في غرب الولايات المتحدة (كاليفورنيا إلى يوتا))",
 "california coffee": "توت القهوة, نبق كاليفورنيا (شجيرة دائمة الخضرة في غرب الولايات المتحدة تحمل ثماراً حمراء أو سوداء صغيرة)",
 "california condor": "كندور كاليفورنيا (كندور من أمريكا الشمالية؛ أسود باهت بشكل رئيسي؛ منقرض تقريباً)",
 "california dandelion": "أذن القط, هندباء خنزيرية (عشب ضار أوروبي مستوطن على نطاق واسع في أمريكا الشمالية له رؤوس زهرية صفراء وأوراق تشبه أذن القط)",
 "california false morel": "موريل كاليفورنيا الكاذب (جيروميترا بجزء خصب بني منتفخ وساق مخدد سميك؛ يوجد تحت الصنوبريات في كاليفورنيا)",
 "california fern": "سيكران, شوكران (عشب كبير متفرع ثنائي الحول موطنه أوراسيا وأفريقيا ووافد إلى أمريكا الشمالية، له أوراق كبيرة تشبه السرخس وأزهار بيضاء؛ يوجد عادة في البيئات الرطبة؛…)",
 "california four o'clock": "شب الليل الكاليفورني (شب الليل الكاليفورني بزهور أرجوانية حمراء)",
 "california fuchsia": "فوشية كاليفورنية (شجيرة صغيرة من جنوب غرب الولايات المتحدة إلى المكسيك لها زهور قرمزية متألقة)",
 "california lady's slipper": "خف السيدة الكاليفورني (غالباً ما يكون له العديد من السحلب الأصفر المخضر بجيوب بيضاء ينمو على طول الجداول والينابيع في جنوب غرب أوريغون وشمال كاليفورنيا)",
 "california laurel": "آس أوريغون, غار كاليفورنيا (شجرة ساحل المحيط الهادئ ذات أوراق عطرية وزهور خيمية صغيرة تليها ثمار تشبه الزيتون؛ تنتج خشباً صلباً متيناً)",
 "california live oak": "بلوط الساحل الحي, سنديان أغريفولي (سنديان دائم الخضرة، غالباً ما يكون شجيرياً، ينمو في المناطق الساحلية لغرب أمريكا الشمالية، وله أوراق خضراء داكنة صغيرة وسميكة ومسننة عادةً)",
 "california newt": "سمندل كاليفورنيا (سمندل يشبه السمندل خشن الجلد في الخصائص والموطن)",
 "california nutmeg": "جوزة الطيب الكاليفورنية (شجرة دائمة الخضرة من كاليفورنيا لها فاكهة تشبه جوزة الطيب ولكن بنكهة تربنتين قوية)",
 "california olive": "آس أوريغون, غار كاليفورنيا (شجرة ساحل المحيط الهادئ ذات أوراق عطرية وزهور خيمية صغيرة تليها ثمار تشبه الزيتون؛ تنتج خشباً صلباً متيناً)",
 "california personality inventory": "استبيان كاليفورنيا للشخصية",
 "california pitcher plant": "دارلينجتونيا, نبات الإبريق الكاليفورني (عشبة مستنقعات ذات زهور صفراء مخضرة متدلية وحيدة وأباريق ملتوية نوعاً ما بأجنحة عريضة في الأسفل)",
 "california pompano": "بالوميتا, بومبانو كاليفورنيا (أصغر من بومبانو فلوريدا؛ شائعة في جزر الهند الغربية)",
 "california poppy": "إيشولتسية, خشخاش كاليفورنيا (من ساحل المحيط الهادئ لأمريكا الشمالية؛ يزرع على نطاق واسع لزهوره الصفراء إلى الحمراء)",
 "california privet": "تمرحنة كاليفورنية (شجيرة يابانية شبه دائمة الخضرة لها زهور كريهة الرائحة؛ تستخدم بكثرة للتحوط لأنها تبقى خضراء أكثر من التمرحنة الشائعة)",
 "california quail": "سمان كاليفورنيا (طائر ممتلئ الجسم من ساحل كاليفورنيا وأوريغون)",
 "california redbud": "زمزريق غربي, زمزريق كاليفورنيا (شجيرة من غرب الولايات المتحدة ذات أزهار وردية أو قرمزية؛ غالباً ما تشكل غابات كثيفة)",
 "california redwood": "خشب أحمر كاليفورني (شجرة دائمة الخضرة شاهقة في التلال الساحلية للولايات المتحدة من أوريغون إلى بيغ سور؛ تزدهر في البيئات الرطبة والممطرة والضبابية)",
 "california romero": "تجعيدات زرقاء صوفية, مريمية سوداء (نبات عطري بأوراق صوفية يوجد في جنوب كاليفورنيا والمكسيك)",
 "california sage": "شيح كاليفورنيا, ميرمية كاليفورنيا (شجيرة كاليفورنية رمادية منخفضة)",
 "california sagebrush": "شيح كاليفورنيا, ميرمية كاليفورنيا (شجيرة كاليفورنية رمادية منخفضة)",
 "california sea lion": "أسد البحر الكاليفورني (غالباً ما يتم تدريبه كحيوان استعراضي)",
 "california single-leaf pinyon": "بينيون كاليفورنيا أحادي الورقة (شجرة صغيرة جداً تشبه بينيون جبال روكي ولكن لها إبرة واحدة لكل حزمة؛ تشبه بينيون باري في النطاق)",
 "california sycamore": "جميز كاليفورنيا, دلب عنقودي (شجرة طويلة في باها كاليفورنيا ذات لحاء متساقط وأوراق كبيرة مفصصة راحياً متبادلة وعناقيد كروية من الزهور)",
 "california tree poppy": "خشخاش ماتيليجا, رومنيا (شجيرة فرعية طويلة متفرعة من كاليفورنيا والمكسيك تزرع غالباً لأوراقها الزرقاء الفضية وزهورها البيضاء الكبيرة العطرة)",
 "california whipsnake": "ثعبان سوط كاليفورنيا, متسابق مخطط (ثعبان سوط يعيش في الأراضي الشجرية وسفوح التلال الصخرية)",
 "california white fir": "شوح أبيض, شوح كولورادو (شوح متوسط إلى طويل من وسط إلى غرب الولايات المتحدة له تاج منتصب ضيق وخشب ناعم)",
 "california white oak": "سنديان الوادي, سنديان كاليفورنيا الأبيض (سنديان نفضي طويل ورشيق موطنه كاليفورنيا، له أوراق جلدية وبلوط (ثمر) نحيل ومدبب)",
 "california wine": "نبيذ كاليفورنيا (أي من أنواع النبيذ المتعددة المنتجة في كاليفورنيا)",
 "california yellow bells": "أجراس صفراء, أجراس هامسة (عشب لزج في الموائل القاحلة أو الصحراوية في جنوب غرب الولايات المتحدة له أزهار صفراء متدلية)",
 "california yew": "طقسوس المحيط الهادئ (شجرة صغيرة أو متوسطة غير منتظمة التفرع من ساحل المحيط الهادئ لأمريكا الشمالية؛ تنتج خشباً ناعماً صلباً متقارب الحبيبات)",
 "californian": "كاليفورني (من أو متعلق أو مميز لولاية كاليفورنيا أو سكانها) / كاليفورني (مواطن أو مقيم في كاليفورنيا)\nمثال: شواطئ كاليفورنية",
 "californium": "كَالِيفُورْنِيُوم / كَلِيفُورْنِيُوم",
 "caliginous": "ضَبَابِيّ مُعْتِم (مُظْلِم وضَبَابِيّ وكَئِيب)",
 "caliper": "فرجار, قدمة ذات ورنية (أداة لقياس المسافة بين نقطتين)",
 "caliph": "خَلِيفَة",
 "caliphate": "خِلَافَة",
 "caliphism": "خَلِيفِيَّة",
 "calisaya": "كاليسايا, كينا كاليسايا (شجيرة أو شجرة صغيرة من بيرو لها أوراق لامعة كبيرة وسيمات من الزهور الصفراء إلى الخضراء أو الحمراء العطرة؛ تزرع للحائها الطبي)",
 "calisthenic": "رياضي بدني, كاليستيني (من أو متعلق بالتمارين الرياضية (الكاليستينيكس))",
 "calisthenics": "تمارين سويدية, جمبازيات (تمارين خفيفة مصممة لتعزيز اللياقة البدنية العامة) / تمرينات سويدية, جمبازيات (ممارسة التمارين الرياضية البسيطة (للياقة))\nمثال: تم توضيح العديد من التمارين السويدية المختلفة في الفيديو",
 "calk": "مسمار الحدوة, نتوء الحدوة (نتوء معدني في مقدمة أسفل حدوة الحصان لمنع الانزلاق)",
 "calkin": "مسمار الحدوة, نتوء الحدوة (نتوء معدني في مقدمة أسفل حدوة الحصان لمنع الانزلاق)",
 "call": "دَعَا, نَادَى (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه) / اِتَّصَلَ بِـ / دَعَا, سَمَّى (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه) / اِتِّصَال, مُكَالَمَة / زِيَارَة\nمثال: دعا ثلاميذه الاثني عشر",
 "call an ambulance": "أُطْلُب سَيَّارَة إِسْعَاف",
 "call box": "صندوق بريد (حجرة مرقمة في مكتب بريد حيث يتم وضع البريد لاستلامه) / كابينة هاتف, كشك هاتف (كشك لاستخدام الهاتف)",
 "call center": "مركز اتصال (مركز مجهز للتعامل مع كمية كبيرة من المكالمات الهاتفية (خاصة لتلقي الطلبات أو خدمة العملاء))",
 "call centre": "مركز اتصال (مركز مجهز للتعامل مع كمية كبيرة من المكالمات الهاتفية (خاصة لتلقي الطلبات أو خدمة العملاء))",
 "call fire": "نيران مطلوبة (نيران توجه لهدف محدد استجابة لطلب من الوحدة المدعومة)",
 "call for": "دَعَا إِلَى (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه)\nمثال: دعا ثلاميذه الاثني عشر",
 "call forwarding": "تحويل المكالمات (يتيح لك تحويل مكالماتك الواردة إلى أي هاتف يمكنك الاتصال به مباشرة)",
 "call girl": "فتاة اتصال (عاهرة يمكن استئجارها عبر الهاتف)",
 "call it a day": "اِعْتَزَلَ",
 "call loan": "قرض تحت الطلب (قرض واجب السداد عند الطلب)",
 "call mark": "رقم الاستدعاء, رقم الطلب (علامة تتكون من أحرف مكتوبة على كتاب؛ تستخدم للإشارة إلى موقعه على الرف)",
 "call number": "رقم الاستدعاء, رقم الطلب (علامة تتكون من أحرف مكتوبة على كتاب؛ تستخدم للإشارة إلى موقعه على الرف)",
 "call on": "زَارَ (زيارة شخص ما، عادة لفترة قصيرة)",
 "call option": "خيار الشراء (خيار شراء سهم معين (أو مؤشر أسهم أو سلعة آجلة) بسعر معين قبل تاريخ معين) / خيار شراء (خيار للشراء)",
 "call sign": "رَمْز نِدَاء (رمز (جمعه رموز)؛ الرمز يعني الرسم الذي يعبر عن شيء معين وعموما فأن العلامة ينبغي نقل رسالتها بنظرة واحدة دون الحاجة للكلمات)\nمثال: تمثال الحرية رمز لأمريكا.",
 "call the fire department": "أُطْلُب الْإِطْفَائِيِّينَ",
 "call the police": "أُطْلُب الشُّرْطَة, نَاد الشُّرْطَة",
 "call to action": "دَعْوَة",
 "call to prayer": "أذان",
 "call up": "استدعاء للخدمة, استنفار (أمر بالالتحاق بالواجب العسكري)",
 "call waiting": "انتظار المكالمات (طريقة لإعلامك بأن شخصاً آخر يتصل بك أثناء استخدامك للهاتف)",
 "call-back": "استدعاء (استدعاء موظف بعد تسريحه) / إعادة اتصال, رد المكالمة (مكالمة للرد على اتصال سابق)",
 "call-board": "لوحة الاستدعاء (لوحة إعلانات خلف كواليس المسرح)",
 "call-in": "مداخلة هاتفية (مكالمة هاتفية لمحطة راديو أو تلفزيون يشارك فيها المتصل في البرنامج الجاري)",
 "call-out": "دعوة للنزال (تحد لقتال أو مبارزة)",
 "calla": "زنبق الكالا, كالا (نبات من جنوب إفريقيا يزرع على نطاق واسع لقنابته البيضاء النقية البارزة وطلعه الأصفر)",
 "calla lily": "زنبق الكالا, كالا (نبات من جنوب إفريقيا يزرع على نطاق واسع لقنابته البيضاء النقية البارزة وطلعه الأصفر)",
 "calla palustris": "كالا برية, لوف الماء (نبات الأراضي الرطبة والمستنقعات في المناطق المعتدلة ذو أزهار خضراء صغيرة محاطة جزئياً بقنابة بيضاء وتوت أحمر)",
 "callable": "قَابِل لِلِاسْتِدْعَاء (خاضع لطلب السداد قبل تاريخ الاستحقاق)",
 "callathump": "شيفاري, ضوضاء احتفالية (سيريناد ساخر صاخب (يُصنع بقرع القدور والغلايات) لزوجين حديثي الزواج) / اِسْتِعْرَاض صَاخِب (عرض صاخب ومرح)",
 "callback": "استدعاء منتج, سحب منتج (طلب من الشركة المصنعة لمنتج معيب لإرجاع المنتج (للاستبدال أو الإصلاح))",
 "caller": "طَازَج (طَازَج وَجَدِيد) / بَارِد عَلِيل, مُنْعِش ((عامّيّة اسكتلنديّة) يمنح البرودة والانتعاش) / زائر, ضيف (زائر اجتماعي أو للعمل) / متصل (الشخص الذي يبدأ مكالمة هاتفية)\nمثال: كانت الغرفة فوضوية لأنه لم يكن يتوقع ضيوفاً",
 "caller id": "كاشف الرقم, معرف المتصل (شاشة صغيرة تظهر رقم هاتف الطرف المتصل بك)",
 "caller-out": "ملقن خطوات الرقص (شخص يعلن تغييرات الخطوات أثناء الرقص)\nمثال: أنت بحاجة إلى عازف كمان وملقن للرقص الريفي",
 "caller-up": "متصل (الشخص الذي يبدأ مكالمة هاتفية)\nمثال: كان هناك الكثير من المتصلين لدرجة أنه فصل الهاتف أخيرًا",
 "calliandra": "كالياندرا (أي من الشجيرات والأشجار الصغيرة المختلفة التي تُقدر لأوراقها الجميلة وطبيعتها المنتشرة الجذابة وأزهارها المتجمعة البيضاء إلى الوردية الداكنة أو…)",
 "calligrapher": "خَطَّاط",
 "calligraphic": "خطي (متعلق بفن الخط أو معبر عنه)",
 "calligraphical": "خطي (متعلق بفن الخط أو معبر عنه)",
 "calligraphist": "خطاط (شخص ماهر في فن الخط)",
 "calligraphy": "خَطّ (كِتَابَة؛ ما يَصِل نقطتين أو أكثر)\nمثال: إرسم خط مستقيم.",
 "callimorpha jacobeae": "عثة الزنجفر (عثة أوروبية كبيرة حمراء وسوداء؛ تتغذى اليرقات على أوراق عشبة الشيخ؛ أُدخلت إلى الولايات المتحدة للسيطرة على عشبة الشيخ)",
 "callinectes sapidus": "سلطعون أزرق (سلطعون أزرق صالح للأكل من سواحل المحيط الأطلسي والخليج في أمريكا الشمالية)",
 "calling": "رسالة مهنية, مسار مهني (المهنة المحددة التي تدربت من أجلها)",
 "calling card": "بصمة, علامة مميزة (خاصية أو سلوك مميز) / بِطَاقَة زِيَارَة (تحية مطبوعة أو مكتوبة تترك للإشارة إلى أنك قمت بزيارة) / بطاقة هاتف (بطاقة تستخدم بدلاً من النقد لإجراء مكالمات هاتفية)\nمثال: القنابل هي بصمات الإرهابيين",
 "calling into question": "تشكيك, طلب تفسير (تحد للدفاع عما قاله شخص ما)",
 "calling together": "اِسْتِدْعَاء, دَعْوَة لِلْاِجْتِمَاع (عملية دعوة الناس للتجمع)",
 "calliope": "كاليوبي",
 "calliopsis": "بذرة القراد, كاليوبسيس (نبات حولي من أمريكا الشمالية يزرع على نطاق واسع لأزهاره الصفراء ذات المراكز الحمراء الأرجوانية إلى البنية؛ يصنف في بعض التصنيفات ضمن جنس فرعي…)",
 "calliper": "فرجار, قدمة ذات ورنية (أداة لقياس المسافة بين نقطتين)",
 "calliphora vicina": "ذباب أزرق (ذباب ذو جسم أزرق قزحي؛ يصدر طنيناً عالياً أثناء الطيران)",
 "callipygian": "حَسَن الأَرْدَاف (يتعلّق بأرداف متناسقة ومكتملة النموّ)",
 "callipygous": "حَسَن الأَرْدَاف (يتعلّق بأرداف متناسقة ومكتملة النموّ)",
 "callirhoe digitata": "ختمية الخشخاش المهدبة (ختمية خشخاش معمرة في ولايات السهول الجنوبية للولايات المتحدة ذات زهور حمراء وردية أو أرجوانية وردية)",
 "callirhoe involucrata": "ختمية الخشخاش الأرجوانية (نبات معمر مشعر في وسط الولايات المتحدة ذو أوراق مستديرة مفصصة بعمق وعناقيد فضفاضة من الزهور القرمزية الأرجوانية أو الحمراء الكرزية الكبيرة)",
 "callirhoe triangulata": "ختمية الخشخاش العنقودية (نبات معمر كثيف الشعر ذو أوراق قاعدية مثلثة في الغالب وزهور وردية أرجوانية في عناقيد عثكولية)",
 "callisaurus draconoides": "سحلية حمار الزرد (سحلية سريعة ذات ذيل طويل مخطط بالأسود وأرجل طويلة؛ من صحاري الولايات المتحدة والمكسيك)",
 "callistephus chinensis": "أستر صيني (نبات يُقدّر لزهوره الجميلة ذات الألوان الزاهية والنقية المتنوعة؛ يُزرع بشكل أساسي للقطف)",
 "callisthenics": "تمارين سويدية, جمبازيات (تمارين خفيفة مصممة لتعزيز اللياقة البدنية العامة) / تمرينات سويدية, جمبازيات (ممارسة التمارين الرياضية البسيطة (للياقة))\nمثال: تم توضيح العديد من التمارين السويدية المختلفة في الفيديو",
 "callisto": "كَالِيسْتُو",
 "callithump": "شيفاري, ضوضاء احتفالية (سيريناد ساخر صاخب (يُصنع بقرع القدور والغلايات) لزوجين حديثي الزواج) / اِسْتِعْرَاض صَاخِب (عرض صاخب ومرح)",
 "callithump parade": "اِسْتِعْرَاض صَاخِب (عرض صاخب ومرح)",
 "callithumpian": "ضوضائي (من أو متعلق بموكب ضوضائي صاخب)",
 "callitris calcarata": "صنوبر السرو الأسود (شجرة أسترالية ذات قشور صغيرة مسطحة كأوراق وبذور عديدة بنية داكنة؛ تُثمن لخشبها وراتنجها)",
 "callitris cupressiformis": "صنوبر بورت جاكسون (صنوبر سرو أسترالي له مخاريط كروية)",
 "callitris endlicheri": "صنوبر السرو الأسود (شجرة أسترالية ذات قشور صغيرة مسطحة كأوراق وبذور عديدة بنية داكنة؛ تُثمن لخشبها وراتنجها)",
 "callitris glauca": "صنوبر السرو الأبيض (شجرة صغيرة أو شجيرة في جنوب أستراليا)",
 "callitris glaucophylla": "صنوبر السرو الأبيض (شجرة صغيرة أو شجيرة في جنوب أستراليا)",
 "callitris parlatorei": "صنوبر السرو ذو اللحاء الليفي (صنوبر سرو أسترالي ذو لحاء داخلي ليفي)",
 "callitris quadrivalvis": "سنداروس (شجرة صنوبرية كبيرة دائمة الخضرة في شمال أفريقيا وإسبانيا لها فروع مسطحة وأوراق تشبه القشور تنتج خشباً عطرياً صلباً؛ وينتج لحاؤها راتنجاً يستخدم في…)",
 "callorhinus ursinus": "فقمة ألاسكا (تعيش في ساحل المحيط الهادئ من ألاسكا جنوباً إلى كاليفورنيا)",
 "callosectomy": "بضع الجسم الثفني (قطع الجسم الثفني بحيث ينقطع الاتصال بين نصفي الكرة المخية (في حالات الصرع الشديد المستعصي))",
 "callosity": "تَبَلُّد شُعُورِيّ, غِلْظَة (الخلو من العاطفة أو الشعور؛ قسوة القلب) / تثفن, جسأة (منطقة من الجلد سميكة أو صلبة بسبب الضغط المستمر أو الاحتكاك (كما في باطن القدم))",
 "callosotomy": "بضع الجسم الثفني (قطع الجسم الثفني بحيث ينقطع الاتصال بين نصفي الكرة المخية (في حالات الصرع الشديد المستعصي))",
 "callous": "قَاسٍ, مُتَحَجِّر المَشَاعِر (متصلّب عاطفيًّا؛ فاقد للرقّة الإنسانية) / سَمِيك الجِلْد, مُتَثَفِّن (عليه ثفن؛ ذو جلد أصبح سميكًا وخشنًا من كثرة الاستعمال)",
 "calloused": "سَمِيك الجِلْد, مُتَثَفِّن (عليه ثفن؛ ذو جلد أصبح سميكًا وخشنًا من كثرة الاستعمال)",
 "callously": "بِقَسْوَة, بِلَا إِحْسَاس (بطريقة قاسية)\nمثال: استغل مشاعرهم بقسوة",
 "callousness": "تَبَلُّد شُعُورِيّ, غِلْظَة (الخلو من العاطفة أو الشعور؛ قسوة القلب)",
 "callow": "غِرّ, نَاشِئ (صغير السن وعديم الخبرة)",
 "callowness": "سذاجة, قلة خبرة (الافتقار إلى خبرة الحياة وإظهار ذلك)",
 "calluna vulgaris": "خلنج, كالونا (خلنج العالم القديم الشائع ممثل بالعديد من الأصناف؛ دائم الخضرة منخفض ينمو على نطاق واسع في نصف الكرة الشمالي)",
 "callus": "جُسْأَة / الكالس النباتات",
 "calm": "هَادِئ / طَمْأَنَ",
 "calm air": "سكون, هواء ساكن (رياح تتحرك بسرعة أقل من 1 عقدة؛ 0 على مقياس بوفورت)",
 "calm before the storm": "الْهُدُوء الَّذِي يَسْبِق الْعَاصِفَةَ",
 "calm down": "أَهْدَأَ, هَدَّأَ",
 "calming": "استرضاء, تهدئة (فعل الاسترضاء (كالموافقة على مطالب))",
 "calmly": "بهدوء (برباطة جأش (خاصة في أوقات التوتر)) / برزانة, بهدوء ووقار (بطريقة رزينة وهادئة)\nمثال: تحدث بهدوء للطلاب المشاغبين",
 "calmness": "هُدُوء",
 "calnada pea": "بيقية الطيور, بيقية معنقدة (متسلق معمر شائع في المناطق المعتدلة من أوراسيا وأمريكا الشمالية له عناقيد طويلة كثيفة من الزهور)",
 "calocarpum zapota": "سابوت, شجرة السابوت (شجرة أمريكية استوائية ذات خشب يشبه الماهوجني وثمار حلوة صالحة للأكل بيضاوية الشكل؛ في بعض التصنيفات توضع في جنس كالوكاربوم)",
 "calocedrus decurrens": "أرز البخور (شجرة طويلة من ساحل المحيط الهادئ لأمريكا الشمالية لها أوراق تشبه السرو ولحاء أحمر قرفي)",
 "calochortus albus": "زنبق الكرة الأبيض, فانوس الجنية الأبيض (زنبق كروي له عناقيد متفرعة مفتوحة من الزهور البيضاء بيضاوية الشكل؛ جنوب كاليفورنيا)",
 "calochortus amabilis": "زنبق الكرة الأصفر, فانوس الجنية الذهبي (زنبق كروي له عناقيد متفرعة مفتوحة من الزهور الصفراء الصافية بيضاوية الشكل؛ شمال كاليفورنيا)",
 "calochortus amoenus": "زنبق الكرة الوردي (زنبق كروي بزهور بيضاوية الشكل وردية عميقة أو أرجوانية على سيقان مرنة؛ المنحدرات الغربية لسييرا نيفادا في وادي سان جواكين)",
 "calochortus elegans": "آذان القط الأنيقة, توليب النجمة (نبات صغير بسيقان منحنية رفيعة تحمل عناقيد متفرعة لعدد قليل من الزهور البيضاء النجمية ببتلات تشبه آذان القط؛ جنوب شرق واشنطن وشمال شرق أوريغون إلى…)",
 "calochortus kennedyi": "توليب ماريبوسا الصحراوي (ماريبوسا بعناقيد من الزهور القرمزية أو البرتقالية أو الصفراء جرسية الشكل فوق سيقان قصيرة؛ جنوب كاليفورنيا إلى أريزونا والمكسيك)",
 "calochortus luteus": "توليب ماريبوسا الأصفر (ماريبوسا لها عناقيد لعدد قليل من الزهور الصفراء العميقة الكبيرة جرسية الشكل فوق سيقان رفيعة؛ السلاسل الساحلية لكاليفورنيا)",
 "calochortus macrocarpus": "توليب ماريبوسا الشيح (ماريبوسا لها عناقيد فضفاضة من زهرة إلى ثلاث زهور ليلكية وسيمة تشبه المظلات فوق سيقان قائمة قوية؛ شمال غرب أمريكا الشمالية القاحل شرق جبال كاسكيد من…)",
 "calochortus nuttallii": "زنبق سيجو (نبات معمر ذو عناقيد من زهرة واحدة إلى أربع زهور بيضاء مبهرجة على شكل جرس فوق سيقان منتصبة غير متفرعة؛ أبصال صالحة للأكل مفيدة في أوقات الندرة؛ شرق…)",
 "calomel": "كالوميل, كلوريد الزئبقوز (مسحوق عديم اللون والطعم يستخدم طبياً كمسهل)",
 "calophyllum calaba": "شجرة سانتا ماريا, كالابا (شجرة من جزر الهند الغربية ذات عناقيد من الزهور البيضاء العطرة وتنتج خشباً متيناً وعصارة راتنجية)",
 "calophyllum candidissimum": "خشب الرمح, خشب الغار (شجرة أمريكية استوائية؛ تقدر لخشبها الصلب المتين)",
 "calophyllum inophyllum": "غار إسكندري (شجرة من شرق الهند لها عناقيد من الزهور البيضاء العطرة؛ المناطق الساحلية من جنوب الهند إلى ماليزيا)",
 "calophyllum longifolium": "ماريا (شجرة خشبية قيمة من بنما)",
 "calopogon pulchellum": "قرنفل العشب, كالوبوجون (نوع من الأوركيد)",
 "calopogon tuberosum": "قرنفل العشب, كالوبوجون (نوع من الأوركيد)",
 "caloric": "سعري (من أو متعلق بالسعرات الحرارية في الطعام) / حراري (متعلق بالحرارة أو مرتبط بها)\nمثال: مقارنة الأطعمة على أساس سعري",
 "calorie": "سُعْر, سُعْرَة (سَعِرَ يَسْعَرَ سَعَراً، وسُعْرَةً: ضرب لونه إِلى السواد فُوَيْقَ الأُدْمة؛ فهو أَسْعَرُ، وهي سَعْراءُ. والجمع: سُعْرٌ)\nمثال: إتفقوا على سعر.",
 "calorie chart": "جدول السعرات الحرارية (قائمة بالأطعمة ومعلومات حول محتواها من السعرات الحرارية)",
 "calorie-free": "خَفِيف السُّعْرَات, قَلِيل السُّعْرَات (يَحْتَوِي عَلَى سُعْرَات حَرَارِيَّة قَلِيلَة نِسْبِيًّا)",
 "calorifacient": "مُوَلِّد لِلحَرَارَة (يُنتِج حرارة؛ يُستخدَم عادة لوصف الأطعمة)",
 "calorific": "حَرَارِيّ (مُولِّد للحرارة)",
 "calorimeter": "مسعر, مقياس الحرارة (أداة قياس تحدد كميات الحرارة)",
 "calorimetric": "مسعري (من أو متعلق بقياس الحرارة)",
 "calorimetry": "قياس السعرات الحرارية (قياس كميات الحرارة)",
 "calorisator": "كالوريزاتور, مسخن العصير (جهاز يستخدم في مصانع بنجر السكر لتسخين العصير للمساعدة في الانتشار)",
 "calorizator": "كالوريزاتور, مسخن العصير (جهاز يستخدم في مصانع بنجر السكر لتسخين العصير للمساعدة في الانتشار)",
 "caloscypha fulgens": "كالوسيفا فولجينس (نوع ربيعي مبكر من الفطريات القرصية ببطانة صفراء إلى برتقالية صفراء للكأس)",
 "calosoma": "كالوسوما",
 "calosoma scrutator": "خنفساء البحث (خنفساء كبيرة زرقاء مخضرة معدنية تفترس اليرقات؛ توجد في أمريكا الشمالية)",
 "calostoma cinnabarina": "كالوستوما سينا بارينا (فطر معدي بساق جلدي وجسم ثمري كروي وله كيس بوغي أحمر)",
 "calostoma lutescens": "كالوستوما لوتيسينس (فطر معدي بساق جلدي وجسم ثمري كروي وله كيس بوغي أصفر شاحب)",
 "calostoma ravenelii": "كالوستوما رافينيلي (فطر معدي بساق جلدي وجسم ثمري بكيس بوغي جيلاتيني رقيق وأبواغ بيضاوية)",
 "calpac": "قلق (قبعة سوداء عالية التاج (مصنوعة عادة من اللباد أو جلد الغنم) يرتديها الرجال في تركيا وإيران والقوقاز)",
 "calpack": "قلق (قبعة سوداء عالية التاج (مصنوعة عادة من اللباد أو جلد الغنم) يرتديها الرجال في تركيا وإيران والقوقاز)",
 "calque": "تَرْجَمَة اِقْتِرَاضِيَّة (شرح الكِتَاب أو توضيحه؛ تحويل الكلام من لغة إلى أخرى كي يفهمه قوم آخرون)\nمثال: أنا مدرس للترجمة.",
 "calque formation": "استعارة مترجمة, محاكاة لغوية (تعبير أُدخل إلى لغة ما عن طريق ترجمته من لغة أخرى)",
 "caltanissetta": "كَالْتَانِيسِّيتَّا, قَلْعَة النِسَاء",
 "caltha palustris": "آذريون المستنقع, قطيفة المستنقع (نبات مستنقعات من أوروبا وأمريكا الشمالية ذو أزهار صفراء زاهية تشبه الحوذان)",
 "caltrop": "حَسَك ((حَسِكَ) الْمَكَان حسكا: كثر حسكه؛ (حَسِكَ) رَأسه: اشتدت جعودته)",
 "calumet": "غليون السلام (غليون احتفالي مزخرف للغاية للهنود الحمر؛ يدخن في المناسبات الاحتفالية (خاصة كرمز للسلام))",
 "calumniation": "اغْتِيَال مَعْنَوِيّ, افْتِرَاء (اتهام كاذب بارتكاب جريمة أو تحريف خبيث لكلمات أو أفعال شخص ما)",
 "calumniatory": "افْتِرائِيّ, تَشْهيرِيّ (يَنْطَوي عَلى تَشْهير أو افْتِراء يُسيء إلى السُّمْعَة)",
 "calumnious": "افْتِرائِيّ, تَشْهيرِيّ (يَنْطَوي عَلى تَشْهير أو افْتِراء يُسيء إلى السُّمْعَة)",
 "calumniously": "بتشهير, بقذف (بطريقة كاذبة وتشهيرية؛ تتضمن الافتراء)",
 "calumny": "بُهْتَان, اِفْتِرَاء (عُرِفَ بِالبُهْتَانِ بَيْنَ زُمَلائِهِ : بِالكَذِبِ وَالافْتِرَاءِ، اِخْتِلاَقُ الكَذِبِ؛ أَتَى البُهْتَانَ : البَاطِلَ، الزَّيْفَ) / طَعْن",
 "calvados": "كالفادوس (براندي تفاح جاف مصنوع في نورماندي)",
 "calvaria": "قبة الجمجمة (قبة الجمجمة)",
 "calvary": "عذاب, معاناة (أي تجربة تسبب معاناة شديدة)",
 "calvary clover": "فصة متداخلة, نفل الجلجثة (نبات حولي من منطقة البحر الأبيض المتوسط له قرون بذور شائكة وأوراق ذات بقع داكنة)",
 "calvary cross": "صليب الجلجثة (صليب لاتيني موضوع على ثلاث درجات)",
 "calvatia gigantea": "فطر نفاث عملاق (فطر نفاث ضخم صالح للأكل يصل قطره إلى 2 قدم ووزنه 25 رطلاً)",
 "calves' feet": "أقدام العجل, كوارع عجل (أقدام العجول تستخدم كطعام؛ عادة ما تكون هلامية)",
 "calves' liver": "كبد عجل (كبد العجل يستخدم كطعام)",
 "calving": "ولادة العجل (ولادة عجل)",
 "calvinism": "كالفينية (النظام اللاهوتي لجون كالفن وأتباعه الذي يؤكد على قدرة الله المطلقة والخلاص بالنعمة وحدها)",
 "calvinist": "كالفيني",
 "calvinistic": "كالفيني (من أو يتعلق بالكالفينية أو أتباعها أو يتميز بها)",
 "calvinistic baptist": "المعمدانيون الكالفينيون (مجموعة من التجمعات المعمدانية التي تؤمن بتعاليم اللاهوتي الفرنسي جون كالفن الذي آمن بالقدر الصارم)",
 "calvinistical": "كالفيني (من أو يتعلق بالكالفينية أو أتباعها أو يتميز بها)",
 "calx": "أكسيد الكالسيوم, الجير الحي (أكسيد بلوري أبيض يستخدم في إنتاج هيدروكسيد الكالسيوم)",
 "calycanthus floridus": "بهار كارولينا, شجيرة الفراولة (شجيرة قوية من جنوب شرق الولايات المتحدة لها خشب برائحة القرنفل وزهور بنية حمراء عطرة)",
 "calycanthus occidentalis": "بهار كاليفورنيا, شجيرة التوابل (شجيرة عطرية متناثرة من جنوب غرب الولايات المتحدة لها زهور بنية عطرة)",
 "calyceal": "كأسي (من أو متعلق بـ أو يشبه الكأس (في الزهرة))",
 "calycinal": "كأسي (من أو متعلق بـ أو يشبه الكأس (في الزهرة))",
 "calycine": "كأسي (من أو متعلق بـ أو يشبه الكأس (في الزهرة))",
 "calycle": "كؤيس (بنية صغيرة على شكل كوب (مثل برعم التذوق أو الكأس البصرية أو تجويف المرجان المحتوي على البوليب)) / كَأْس كَاذِب, كُؤَيْس (مجموعة من القنابات تحاكي الكأس كما في القرنفل أو الخطمي)",
 "calycled": "مكأس (لديه كؤيس)",
 "calycophyllum candidissimum": "خشب الليمون, كاليكوفيلوم (مصدر لخشب مرن وقوي)",
 "calycular": "كؤيسي (يتعلق بـ أو يشبه الكؤيس (كأس صغير))",
 "calyculate": "مكأس (لديه كؤيس)",
 "calyculus": "كؤيس (بنية صغيرة على شكل كوب (مثل برعم التذوق أو الكأس البصرية أو تجويف المرجان المحتوي على البوليب)) / كَأْس كَاذِب, كُؤَيْس (مجموعة من القنابات تحاكي الكأس كما في القرنفل أو الخطمي)",
 "calymmatobacterium": "كاليما توباكتيريوم (جنس من العصويات البكتيرية يحتوي فقط على النوع الوحيد الذي يسبب الورم الحبيبي الأربي)",
 "calypso": "كاليبسو ((الأساطير اليونانية) حورية البحر التي احتجزت أوديسيوس لمدة سبع سنوات) / خف الجنية, كاليبسو (أوركيد مستنقعات نادر في المنطقة المعتدلة الشمالية يحمل زهرة بيضاء إلى وردية وحيدة معلمة بالأرجواني عند طرف ساق محمر منتصب فوق ورقة قاعدية واحدة)",
 "calypso bulbosa": "خف الجنية, كاليبسو (أوركيد مستنقعات نادر في المنطقة المعتدلة الشمالية يحمل زهرة بيضاء إلى وردية وحيدة معلمة بالأرجواني عند طرف ساق محمر منتصب فوق ورقة قاعدية واحدة)",
 "calypter": "جُنَيْح, مِقْرَنَة (هيكل يشبه الحرشفة يقع بين قاعدة الجناح والدبوس في الذباب ثنائي الجناحين)",
 "calyptra": "قلنسوة (الغطاء الذي يغطي كأس بعض النباتات: مثل الخشخاش الكاليفورني)",
 "calyptrate": "قلنسوي (لديه قلنسوة) / حرشفي الأجنحة (لديه حراشف (في أجنحة بعض الحشرات))",
 "calyptridium umbellatum": "سبرياغا, مخلب القطة (عناقيد وردية من الزهور المكتظة بكثافة على سيقان منبسطة تشبه وسائد أقدام القطط المقلوبة؛ تنمو في الغابات الصنوبرية في غرب أمريكا الشمالية)",
 "calystegia sepium": "لبلاب السياج",
 "calyx": "كأس الزهرة ((نبات) دوارة السبلات للزهرة التي تشكل الغلاف الخارجي)",
 "calyx tube": "أنبوب الكأس, مجن (الهيكل الذي يشبه الكوب أو الحلقة أو الأنبوب للزهرة والذي يحمل السبلات والأسدية والكأس (كما في الوردية))",
 "cam": "حدبة, كامة (قرص دوار مُشكّل لتحويل الحركة الدائرية إلى حركة خطية)",
 "cam stroke": "شوط (الحد الأقصى للحركة المتاحة لقطعة محورية أو ترددية بواسطة كامة)",
 "camachile": "تمرهندي مانيلا, كاماشيل (شجرة استوائية أمريكية شائكة شائعة ذات عناقيد طرفية من الزهور الصفراء تليها قرون صالحة للأكل منجلية أو دائرية وتنتج خشباً جيداً وصبغة صفراء وصمغاً…)",
 "camail": "غطاء رأس وسلسلة عنق (غطاء رأس من الزرد في العصور الوسطى يتدلى من الخوذة لحماية الرأس والرقبة)",
 "camaraderie": "صَدَاقَة (المَحَبَّة بالصِّدْق. هي العِلاقَة بين شخصين أو أكثر قائِمَة على المحبة والصدق فكل منهم يحب الآخر ويَصْدُقه ويُصَدِّقه، كل منهم هو صَدِيق للآخر)\nمثال: الغيرة عدوة الصداقة.",
 "camarilla": "زمرة سرية, عصبة (زمرة (غالباً ما تكون سرية) تسعى للسلطة عادة من خلال المؤامرات)",
 "camas": "كاماس, كاماسيا (أي من النباتات العديدة من جنس كاماسيا؛ أمريكا الشمالية والجنوبية)",
 "camash": "كاماس, كاماسيا (أي من النباتات العديدة من جنس كاماسيا؛ أمريكا الشمالية والجنوبية)",
 "camass": "كاماس, كاماسيا (أي من النباتات العديدة من جنس كاماسيا؛ أمريكا الشمالية والجنوبية)",
 "camassia leichtlinii": "كاماسيا ليتشتلين (كاماسيا توجد غرب جبال كاسكيد)",
 "camassia quamash": "كاماسيا, كاماسيا شائعة (نبات له بصلة كبيرة صالحة للأكل وأوراق قاعدية خطية وعناقيد من الزهور النجمية البنفسجية الزرقاء الفاتحة إلى العميقة على سيقان خضراء طويلة؛ غرب أمريكا…)",
 "camassia scilloides": "كاماسيا شرقية, ياقوتية برية (كاماسيا شرقية؛ شرق ووسط أمريكا الشمالية)",
 "camber": "حدبة, ميل العجلات (محاذاة عجلات السيارة لتكون أقرب لبعضها في الأسفل منها في الأعلى) / ميل جانبي (ميل في منعطف طريق أو مسار؛ يكون الجانب الخارجي أعلى من الداخلي لتقليل تأثيرات قوة الطرد المركزي) / تحدب طفيف, تقوس (تحدب طفيف (كما في سطح الطريق))",
 "camber arch": "قوس محدب (قوس ذو ظهر أفقي مستقيم وبطن مقوس قليلاً)",
 "camberwell beauty": "فراشة العباءة, فراشة كامبرويل (من المناطق المعتدلة؛ لها أجنحة أرجوانية داكنة بحواف صفراء)",
