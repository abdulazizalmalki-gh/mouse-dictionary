{
 "unmusically": "بشكل غير منغم, بلا موسيقية (بطريقة غير موسيقية)\nمثال: تغني بشكل غير منغم إلى حد ما",
 "unmutilated": "بِلَا شَائِبَة, نَاصِع (خال من البقع أو اللطخات الجسدية أو الأخلاقية)\nمثال: سجل ناصع",
 "unmyelinated": "غير ميليني, غير نخاعيني ((عن الخلايا العصبية) غير مغطاة بالمايلين)",
 "unnameable": "جَلَّ عَنِ الوَصْفِ, لَا يُنْطَق (أقدس من أن يُنطَق به أو يُذكَر)",
 "unnamed": "غَيْر مُعَرَّف, مَجْهُول الهُوِيَّة (ذو مصدر مجهول أو غير مُسمَّى)",
 "unnatural": "مُتَصَنَّع, مُتَكَلَّف (يتحدث أو يتصرف بطريقة مصطنعة لترك انطباع) / غير طبيعي, مخالف للطبيعة (غير متوافق مع الطبيعة أو محدد بها؛ مخالف للطبيعة) / شاذ, غير طبيعي (ليس طبيعياً؛ ليس نموذجياً أو معتاداً أو منتظماً أو مطابقاً لمعيار)\nمثال: موت غير طبيعي",
 "unnaturalised": "غَيْرُ مُتَجَنِّس (لَمْ يَحْصُلْ عَلَى الجِنْسِيَّةِ أَوِ المُوَاطَنَةِ)",
 "unnaturalized": "غَيْرُ مُتَجَنِّس (لَمْ يَحْصُلْ عَلَى الجِنْسِيَّةِ أَوِ المُوَاطَنَةِ)",
 "unnaturally": "بشكل غير طبيعي (بطريقة تختلف عما هو طبيعي أو عادي) / اصطناعياً, بشكل غير طبيعي (ليس وفقاً للطبيعة؛ ليس بوسائل طبيعية) / بشكل غير طبيعي (بطريقة غير طبيعية)\nمثال: لم تتبن الكنيسة المبكرة بشكل غير طبيعي الموقف القائل بأن الفشل في رؤية الطبيعة المسيحية لعمله كان سببه في الواقع عمى الناس أنفسهم",
 "unnaturalness": "تَصَنُّع, تَكَلُّف (صفة كون الشيء غير طبيعي أو غير قائم على مبادئ طبيعية)",
 "unnavigable": "غَيْرُ صَالِحٍ لِلْمِلَاحَة (لَا يُمْكِنُ الإِبْحَارُ فِيه)",
 "unnecessarily": "دون داع (بدون أي ضرورة) / بلا ضرورة (بطريقة غير ضرورية)\nمثال: هذا الماراثون سيرهقه دون داع",
 "unnecessary": "غَيْر ضَرُورِيّ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "unneeded": "غير ضروري (ليس ضرورياً)",
 "unneighborliness": "سء الجوار (طبع مسيء للجوار)",
 "unneighborly": "سَيِّئ الجِوَار (لَا يُظْهِرُ الصِّفَات المُتَوَقَّعَة فِي جَار وَدُود)",
 "unneighbourly": "سَيِّئ الجِوَار (لَا يُظْهِرُ الصِّفَات المُتَوَقَّعَة فِي جَار وَدُود)",
 "unnerved": "فَاقِد الشَّجَاعَة, مُحَطَّم الأَعْصَاب (فقد الشجاعة والقوة والعزيمة)",
 "unnerving": "مَهِيب, مُرْهِب (يبعث على الخوف والرهبة)",
 "unneurotic": "سوي, غير عصابي (ليس عصابياً)\nمثال: أمهات ناجحات - أمهات لديهن أطفال أسوياء",
 "unnie": "أوني (أنثى أكبر سناً من المتحدث، يستخدم خاصة من قبل الإناث الكوريات)",
 "unnilquadium": "رذرفورديوم (عنصر مشع ما بعد اليورانيوم تم تصنيعه)",
 "unnotched": "أَمْلَسُ الحَافَّة, غَيْرُ مُسَنَّن (خالٍ من الشُّقوق أو الأسنان على الحافة)",
 "unnoted": "غَيْر مُلَاحَظ, مُغْفَل (لم يُؤخَذ في الحسبان)",
 "unnoticeable": "خَفِيّ, غَيْرُ مُلَاحَظٍ (لَا يَلْفِتُ الِانْتِبَاهَ) / غير لافت للنظر, غير ملحوظ (غير ملحوظ؛ لا يجذب الانتباه)\nمثال: كانت ملابسها بسيطة وغير لافتة للنظر",
 "unnoticeableness": "خفاء, عدم الملاحظة (صفة عدم سهولة الملاحظة)",
 "unnoticeably": "بشكل طفيف جداً, بشكل غير محسوس (بطريقة غير محسوسة أو لدرجة غير محسوسة)\nمثال: ازدادت قوة وزير الدولة في لندن تدريجياً ولكن بشكل غير محسوس",
 "unnoticed": "غير ملحوظ (لم يتم ملاحظته)\nمثال: أمل أن يكون رحيله قد مر دون أن يلاحظه أحد",
 "unnourished": "غَيْر مُغَذًّى (لم يحصل على أي تغذية)",
 "unnumberable": "لَا يُحْصَى, لَا يُعَدّ (أَكْثَر مِنْ أَنْ يُحْصَى أَوْ يُعَدّ)",
 "unnumbered": "لَا يُحْصَى, لَا يُعَدّ (أَكْثَر مِنْ أَنْ يُحْصَى أَوْ يُعَدّ)",
 "unnumerable": "لَا يُحْصَى, لَا يُعَدّ (أَكْثَر مِنْ أَنْ يُحْصَى أَوْ يُعَدّ)",
 "unobjectionable": "غَيْر مُسْتَهجَن (لا يُثير اعتراضًا) / عَفِيف, مُهَذَّب ((للسلوك أو خاصة اللغة) خالٍ من العناصر المرفوضة؛ صالح لجميع المراقبين) / غَيْر مُسْتَهْجَن, مَقْبُول (لا يثير الاستنكار أو الاعتراض)\nمثال: مرح نظيف جيد",
 "unobjective": "غَيْر قَابِل لِلتَّحَقُّق, غَيْر مَوْضُوعِيّ ((كالأدلة مثلاً) ليس موضوعياً أو سهل التحقّق منه)",
 "unobligated": "غير ملزم (ليس ملزماً)",
 "unobliging": "غَيْر مُتَعَاوِن (غير متعاون أو غير مجامل)\nمثال: تحرك سائق الحافلة غير المتعاون بينما كانت تطرق على الباب",
 "unobservable": "غَيْرُ قَابِلٍ لِلرَّصْد (لَا يُمْكِنُ مُلَاحَظَتُهُ مُبَاشَرَةً)",
 "unobservant": "غَافِل, غَيْرُ مُنْتَبِه (لَا يُلَاحِظُ بِوَعْي)",
 "unobserved": "غَيْر مَرْئِيّ, غَيْر مُلَاحَظ (لم يُلاحَظ ولم يُشاهَد)",
 "unobserved fire": "نيران غير مرصودة (نيران لا يمكن رصد نقطة تأثيرها (الانفجارات))",
 "unobstructed": "سالك, غير مسدود (خالٍ من العوائق أو الانسداد)\nمثال: رؤية غير محجوبة",
 "unobtainable": "بَعِيد المَنَال, مُتَعَذَّر الحُصُول عَلَيْه (لا يمكن الحصول عليه أو الوصول إليه)",
 "unobtrusive": "غَيْر مُتَطَفِّل, مُتَحَفِّظ (غير مُتطفّل ولا ملحوظ بشكل مُزعج)",
 "unobtrusively": "بخفية, دون تطفل (بطريقة غير متطفلة)\nمثال: كان الرسل يتحركون بخفية فوق سلاسل الجبال السوداء، حاملين أخباراً سرية من مشيخة إلى أخرى",
 "unobtrusiveness": "توارٍ, تواضع (صفة عدم البروز بطريقة غير مرحب بها)",
 "unobvious": "خفي, غير واضح (ليس ظاهراً على الفور)\nمثال: في العلوم الرياضية تظهر الروابط التي؛ تكون غير واضحة للغاية",
 "unoccupied": "شَاغِر, غَيْرُ مُؤَجَّر (غير مؤجر أو غير مشغول بمستأجر) / خال, شاغر (غير ممتلئ أو غير مستخدم) / حر, غير محتل (لم يتم الاستيلاء عليه والسيطرة عليه)\nمثال: كشك هاتف شاغر",
 "unoffending": "غير جارح, غير مسيء (لا يسبب الغضب أو الانزعاج) / بريء, غير مخالف (لا يرتكب مخالفة)\nمثال: سلوك غير مسيء",
 "unofficial": "غير رسمي (ليس له سلطة أو إقرار رسمي) / غَيْر رَسْمِيّ, غَيْر مُثَبَّت (لم يُقَرّ أو يُثبَّت رسمياً)\nمثال: نوع من العمدة غير الرسمي",
 "unofficially": "بشكل غير رسمي (ليس بصفة رسمية) / بِشَكْل غَيْر رَسْمِيّ (بدون موافقة رسمية)\nمثال: بشكل غير رسمي، يعمل كأمين صندوق",
 "unoiled": "غَيْرُ مَزِيت (لَمْ يُدْهَنْ بِالزَّيْتِ عَلَى سَطْحِه) / غير مزيت (بحاجة لمعالجة بالزيت)\nمثال: طرق غير مزيتة مغبرة",
 "unopen": "مغلق, موصد (ليس مفتوحاً)\nمثال: انصفق الباب مغلقاً",
 "unopened": "غَيْرُ مَفْتُوح, مُغْلَق (لم يُفتَح بعد ولم يُفَكّ ختمه)",
 "unopposable": "غير قابل للمقابلة (غير قابل للمقابلة)",
 "unopposed": "بلا منافس, غير معارَض (ليس لديه معارضة أو خصم)\nمثال: قوات عسكرية لم تواجه مقاومة",
 "unordered": "غَيْر مُدَرَّج, غَيْر مُرَتَّب (غير منظَّم ترتيباً هرميّاً) / غير مرتب, مبعثر (غير مرتب بنظام)",
 "unorganised": "غير منظم (لا يملك أو ينتمي إلى كل منظم) / غَيْرُ مُنَظَّم نِقَابِيًّا (غير منتسب إلى نقابة عمالية)\nمثال: الأقاليم غير المنظمة تفتقر لحكومة رسمية",
 "unorganized": "غير منظم (لا يملك أو ينتمي إلى كل منظم) / غَيْرُ مُنَظَّم نِقَابِيًّا (غير منتسب إلى نقابة عمالية)\nمثال: الأقاليم غير المنظمة تفتقر لحكومة رسمية",
 "unoriented": "تائه, غير موجه (ليس له وضع أو هدف محدد أو معلوم)\nمثال: منخرط في دراسة غير موجهة",
 "unoriginal": "غير أصلي, مقلد (ليس أصلياً؛ ليس كائناً أو منتجاً لشيء جديد وغير عادي)\nمثال: احتوت المخطوطة على تنقيحات غير أصلية",
 "unoriginality": "تَقْلِيدِيَّة, لَا أَصَالَة (صفة كون الشيء غير أصلي) / عدم أصالة (افتقار للإبداع بسبب نقص الأصالة)",
 "unoriginally": "بتقليد, بشكل غير أصيل (بطريقة تفتقر للأصالة)",
 "unornamented": "خَالٍ مِنَ الزَّخْرَفَة, سَادَة (يفتقر إلى التزيين أو الزخرفة)",
 "unorthodox": "غير تقليدي (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "unorthodoxy": "بِدْعَة, خُرُوج عَن المَأْلُوف (صفة كون الشيء غير أرثوذكسي أو مخالفاً للمعتقد السائد) / بدعة, زندقة (معتقد يرفض العقائد الأرثوذكسية (التقليدية) لدين ما) / خروج عن المألوف, مروق (أي آراء أو مذاهب تتعارض مع الموقف الرسمي أو التقليدي)",
 "unostentatious": "بسيط, غير متفاخر (غير استعراضي) / غَيْرُ مُتَكَلَّف, مُتَحَفِّظ (يُظْهِرُ ذَوْقًا رَفِيعًا بِتَحَفُّظٍ وَاعْتِدَال)\nمثال: مكتبه المتواضع",
 "unowned": "سَائِب, غَيْر مَمْلُوك (ليس لديه مالك)",
 "unoxygenated": "غَيْرُ مُؤَكْسَج ((يُستخدم عن الدم) غَيْرُ مُزَوَّدٍ بِالأُكْسِجِين)",
 "unpackaged": "سائب, غير معبأ (غير معبأ أو موضوع في عبوات)\nمثال: مكسرات سائبة",
 "unpaid": "بلا أجر, غير مدفوع (لم يتم الدفع له) / تَرْفِيهِيّ, هَاوٍ (يُمارَس كهواية أو تسلية) / تَطَوُّعِيّ, غَيْرُ مَأْجُور (بِدُونِ مُقَابِلٍ مَادِّيّ)\nمثال: أجور غير مدفوعة",
 "unpaid worker": "متطوع (شخص يؤدي عملاً تطوعياً)",
 "unpainful": "خَالٍ مِنَ الأَلَم, غَيْرُ مُؤْلِم (لَا يُصَاحِبُهُ إِحْسَاسٌ بِالأَلَم)",
 "unpaintable": "عصي على الرسم, غير قابل للرسم (لا يمكن رسمه ولا سيما أنه غير مناسب للتمثيل الفني على القماش)\nمثال: النبضة اللاواعية التي لا يمكن التعبير عنها ولا رسمها",
 "unpainted": "غير مطلي (ليس لديه طبقة طلاء أو بحاجة ماسة لطلاء جديد) / طبيعي الوجه, غير متبرج (لا يضع مكياجاً)\nمثال: منزل غير مطلي",
 "unpaired": "بِلَا نَظِير, فَرْدِيّ (العضو المتبقي من زوج)",
 "unpalatability": "عَدَم اسْتِسَاغَة, عَدَم قَبُول (خاصية كون الشيء غير مقبول للعقل) / عدم استساغة (خاصية كون الشيء غير مقبول للفم)\nمثال: أثار عدم استساغة السياسة ضجة",
 "unpalatable": "غير مستساغ, كريه (غير لطيف أو غير مقبول للطعم أو للعقل)\nمثال: وجبة غير مستساغة",
 "unpalatableness": "عَدَم اسْتِسَاغَة, عَدَم قَبُول (خاصية كون الشيء غير مقبول للعقل) / عدم استساغة (خاصية كون الشيء غير مقبول للفم)\nمثال: أثار عدم استساغة السياسة ضجة",
 "unpalatably": "بشكل غير مستساغ, بشكل غير مقبول (بطريقة غير مستساغة)\nمثال: بدت الخضروات ذابلة بشكل غير مستساغ",
 "unparallel": "غَيْر مُتَوَازٍ (ليس مستقيماً ولا متوازياً)",
 "unparalleled": "فَرِيدٌ مِنْ نَوْعِه, لَا يُضَاهَى (مُتميّز جذريًّا وليس له مثيل أو نظير)",
 "unpardonable": "غير قابل للعفو, لا يغتفر (مما لا يقبل العفو)\nمثال: سلوك لا يغتفر",
 "unpardonably": "بشكل غير مقبول, بشكل لا يغتفر (بطريقة لا يمكن الصفح عنها أو إلى درجة لا تغتفر)\nمثال: كان قاسياً بشكل لا يغتفر تجاه زوجته",
 "unparented": "بلا والدين, يتيم (ليس لديه والد أو والدين أو لا يرعاه بدائل الوالدين)",
 "unparliamentary": "غَيْرُ بَرْلَمَانِيّ (بالغ الوقاحة والبذاءة بحيث لا يليق بالبرلمان)",
 "unpartitioned": "غَيْرُ مُقَسَّم بِحَوَاجِز (لم يُقسَّم بفواصل أو حواجز)",
 "unpassable": "غير سالك, مسدود (لا يمكن اجتيازه)",
 "unpasteurised": "غير مبستر (لم يخضع للبسترة)",
 "unpasteurized": "غير مبستر (لم يخضع للبسترة)",
 "unpatented": "غَيْر مُسَجَّل بِبَرَاءَة اخْتِرَاع ((عن الأجهزة والعمليات) غير محمي ببراءة اختراع)",
 "unpatriotic": "خائن, غير وطني (يظهر عدم حب لوطنه)",
 "unpatriotically": "بلا وطنية (بطريقة غير وطنية)\nمثال: دبر طريقة لتجنب الخدمة العسكرية بلا وطنية",
 "unpatronised": "غير مقصود, قليل الزبائن (لديه القليل من الرعاية أو قليل من الزبائن)\nمثال: مطعم لا تقصده النخبة",
 "unpatronized": "غير مقصود, قليل الزبائن (لديه القليل من الرعاية أو قليل من الزبائن)\nمثال: مطعم لا تقصده النخبة",
 "unpatterned": "سادة, غير منقوش (يفتقر للنقوش خاصة في اللون)",
 "unpaved": "ترابي, غير معبد (ليس له سطح معبد)",
 "unpeaceable": "غَيْرُ مُسَالِم (لَا يَمِيلُ إِلَى السَّلَام)",
 "unpeaceful": "غير سلمي, مضطرب (ليس سلمياً)\nمثال: أوقات غير سلمية",
 "unpeopled": "خَالٍ, غَيْرُ مَأْهُول (لا يعيش فيه أحد)",
 "unperceivable": "غير محسوس, غير ملحوظ (مستحيل أو صعب الإدراك بالعقل أو الحواس)\nمثال: انخفاض غير محسوس في درجة الحرارة",
 "unperceived": "غَيْر مُدْرَك (لم يُدرَك أو يُعلَّق عليه)",
 "unperceiving": "بليد, غير مدرك (يفتقر للإدراك)\nمثال: غير مدرك مثل صخرة",
 "unperceptive": "عَدِيم الذَّوْق, قَلِيل الحِسّ (يَفْتَقِر إِلَى الحِسّ أَوِ الذَّوْق أَوِ الحُكْم السَّلِيم) / بليد, غير مدرك (يفتقر للإدراك)\nمثال: غير مدرك مثل صخرة",
 "unperceptiveness": "ضَعْف بَصِيرَة, قِلَّة إِدْرَاك (الافتقار إلى البصيرة والتفهم المتعاطف)",
 "unperformed": "غَيْر مُؤَدًّى, غَيْر مُمَثَّل (لم يُؤَدَّ أو لم يُعرَض)",
 "unpermed": "غَيْرُ مُمَوَّج ((عَنِ الشَّعْرِ) لَمْ يَخْضَعْ لِتَمْوِيجٍ دَائِمٍ)",
 "unpermissive": "صارم, غير متساهل (لا يميل إلى منح الإذن؛ صارم في الانضباط)",
 "unpermissiveness": "تقييد, عدم التساهل (نقص في التساهل أو التهاون والميل لحصر السلوك ضمن حدود معينة)",
 "unperplexed": "غير محتار, واثق (لا يعاني من أي صعوبة أو ارتباك أو حيرة)",
 "unperson": "شَخْص مَلْغِيّ الوُجُود, لَا شَخْص (شخص يُعتبر غير موجود ولا يتمتع بأي حقوق؛ شخص يتم تجاهل وجوده بشكل منهجي (خاصة لأسباب أيديولوجية أو سياسية))\nمثال: يُعامل السيناتور السابق كشخص غير موجود من قبل هذه الإدارة",
 "unpersuadable": "غَيْر قَابِل لِلْإِقْنَاع (لا يستجيب للإقناع)",
 "unpersuaded": "غَيْرُ مُقْتَنِعٍ, غَيْرُ مُهْتَدٍ (لم يتحول أو يقتنع)",
 "unpersuasive": "غَيْرُ مُقْنِع (غَيْرُ قَادِرٍ عَلَى الإِقْنَاع)",
 "unpersuasiveness": "عَدَم إِقْنَاع (عدم القدرة على الإقناع)",
 "unperturbed": "غَيْرُ مُضْطَرِب, مُطْمَئِنّ (خالٍ من الاضطراب العاطفيّ والتوتّر العصبيّ)",
 "unpictured": "غَيْرُ مُصَوَّر (لَمْ يُصَوَّرْ أَوْ يُرْسَم)",
 "unpicturesque": "بِلَا جَمَال, غَيْر جَذَّاب (خالٍ من الجمال أو السحر)",
 "unpierced": "غَيْرُ مَخْرُوق (لم يُثقَب أو يُخرَق)",
 "unpigmented": "عديم الصبغة, غير مصطبغ (لا يحتوي على صبغة)",
 "unpillared": "بِلَا دَعَائِم (يفتقر إلى الدعائم أو الركائز)",
 "unpitying": "بِلَا رَحْمَة, عَدِيمُ الشَّفَقَة (خَالٍ مِنَ الرَّحْمَةِ أَوِ الشَّفَقَة)",
 "unplaced": "غَيْر مُصَنَّف (ليس من بين الثلاثة الأوائل في سباق أو مسابقة)",
 "unplanned": "غَيْرُ مَقْصُود, غَيْرُ مُخَطَّط (لم يُفعَل عن قصد أو نية) / عفوي, غير مخطط (بدون تفكير مسبق ظاهر أو تحفيز أو تخطيط)\nمثال: اقتصاد غير مخطط",
 "unplanted": "غير مزروع (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "unplayable": "غير قابل للعب (غير قادر على أو غير مناسب للعب أو اللعب عليه)\nمثال: كانت كرة الجولف في وضعية غير قابلة للعب",
 "unplayful": "جاد, رصين (يفتقر تمامًا إلى المرح)",
 "unpleasant": "بغيض, غير سار (مسيء أو غير مقبول؛ يسبب عدم الراحة أو التعاسة)\nمثال: شخصية بغيضة",
 "unpleasant person": "شَخْص بَغِيض, شَخْص كَرِيه (شخص غير لطيف أو غير مقبول في التعامل)",
 "unpleasant-smelling": "كريه الرائحة, نتن (ذو رائحة غير محببة)",
 "unpleasantly": "بشكل غير سار, بشكل مزعج (بطريقة غير سارة)\nمثال: فوجئ بشكل غير سار",
 "unpleasantness": "إِزْعَاج, عَدَم سَارِّيَّة (صفة ما يسبب عدم الارتياح أو الانزعاج) / انزعاج, كدر (الشعور الناجم عن المحفزات الكريهة؛ قطب واحد من سلسلة متصلة من حالات الشعور)\nمثال: سوء الأحوال الجوية الأخير",
 "unpleasing": "غَيْر مُسْتَسَاغ, مُنَفِّر (غير سارّ أو غير مقبول للحواس)",
 "unpleasingness": "عَدَم جَاذِبِيَّة, قُبْح (صفة كون الشيء غير سار للحواس)",
 "unpledged": "حُرّ, غَيْر مَخْطُوب (لم يُعطِ وعدًا بالزواج؛ غير مرتبط)",
 "unploughed": "بور, غير محروث ((للأراضي الزراعية) لم تحرث)\nمثال: حقول غير محروثة",
 "unplowed": "بور, غير محروث ((للأراضي الزراعية) لم تحرث)\nمثال: حقول غير محروثة",
 "unplumbed": "سَحِيق, غَوْر (يَقَعُ فِي عُمْقٍ كَبِيرٍ أَوْ يَمْتَدُّ إِلَيْهِ؛ أَعْمَقُ مِنْ أَنْ يُسْبَرَ)",
 "unpointed": "ثلم, غير مدبب (ليس له رأس، خاصة الرأس الحاد)\nمثال: أقلام الرصاص كلها غير مدببة",
 "unpointedness": "عدم تدبب (خاصية امتلاك طرف غير حاد (إن وجد))",
 "unpolished": "غَيْرُ مُهَذَّب, فَظّ (يفتقر إلى اللباقة الاجتماعية والتهذيب) / خشن, غير مصقول (لم يتم إعادة صياغته بعناية أو إتقانه أو جعله ناعماً بالصقل)\nمثال: أحذية باهتة غير مصقولة",
 "unpolitical": "لَا سِيَاسِيّ, مُحَايِد سِيَاسِيًّا (محايد من الناحية السياسية)",
 "unpolluted": "غَيْرُ مُلَوَّث (خالٍ من الاختلاط بعناصر ضارّة؛ نظيف)",
 "unpompous": "غَيْر مُتَبَجِّح (غير متنطّع أو متعاظم)",
 "unpopular": "غير رائج, غير شعبي (يُنظر إليه بعدم رضا أو يفتقر إلى القبول العام)\nمثال: أفكار غير شعبية",
 "unpopularity": "عدم الشعبية, قلة الرواج (صفة الافتقار إلى الموافقة العامة أو القبول)",
 "unpopulated": "خَالٍ, غَيْرُ مَأْهُول (لا يعيش فيه أحد)",
 "unportable": "غير قابل للنقل, غير محمول (غير سهل الحمل أو النقل)",
 "unposed": "عفوي, غير متخذ وضعية (غير مرتب لأغراض التصوير)\nمثال: صور عفوية",
 "unpotted": "غير مزروع في أصيص (لم يزرع في أوعية)",
 "unpowered": "غير آلي, غير مزود بطاقة (لا يمتلك أو لا يستخدم طاقة ميكانيكية)\nمثال: يتم دعم الأوتوجيرو في الطيران بواسطة أجنحة دوارة غير مزودة بمحرك",
 "unpracticed": "غَيْر مُتَمَرِّس, قَلِيل المُمَارَسَة (لم يحظَ بممارسة واسعة)",
 "unpractised": "غَيْر مُتَمَرِّس, قَلِيل المُمَارَسَة (لم يحظَ بممارسة واسعة)",
 "unprecedented": "غَيْر مَسْبُوق (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "unprecedentedly": "بشكل غير مسبوق (بطريقة لم يسبق لها مثيل)",
 "unpredictability": "عَشْوَائِيَّة, مَزَاجِيَّة (صفة الانقياد لنزوات مفاجئة لا يمكن التنبؤ بها) / عَدَم قَابِلِيَّة التَّنَبُّؤ (الافتقار إلى إمكانية التنبؤ) / تقلب (سمة التردد غير المتوقع)\nمثال: دفع تقلب السوق العديد من المستثمرين بعيداً",
 "unpredictable": "غَيْرُ مُتَوَقَّع, غَيْرُ مُنْتَظَم (لَا يَحْدُثُ بِمُعَدَّلٍ مُنْتَظَمٍ أَوْ فَتَرَاتٍ ثَابِتَة) / غَيْرُ مُتَوَقَّع (غَيْرُ مَعْرُوفٍ مُسْبَقًا) / غير متوقع, لا يمكن التنبؤ به (لا يمكن التنبؤ به)",
 "unpredictably": "بشكل غير منتظم, بشكل متقطع (بطريقة غير منتظمة ولا يمكن التنبؤ بها)\nمثال: التغيرات الاقتصادية تسير بشكل متقطع",
 "unpredicted": "بِلَا إِنْذَار, غَيْر مُعْلَن (بدون تحذير أو إعلان مُسبَق)",
 "unpredictive": "عَدِيم القِيمَة التَّنَبُّؤِيَّة (ليست له قيمة تنبّؤية)",
 "unprejudiced": "غَيْر مُتَحَيِّز, مُنْصِف (خالٍ من التحيز غير المبرر أو الآراء المسبقة)\nمثال: تقييم غير متحيز للإيجابيات والسلبيات",
 "unpremeditated": "غَيْر مُعَدّ مُسْبَقًا (لم يُحضَّر أو يُخطَّط له مسبقاً) / عفوي, غير مدبر (غير مخطط له مسبقاً)",
 "unprepared": "غير مجهز, غير مستعد (دون إعداد؛ غير مستعد لـ)\nمثال: ملاحظات مرتجلة",
 "unprepossessing": "غَيْر لَائِق, غَيْر مُسْتَحْسَن (يترك انطباعاً أولياً سلبياً أو محايداً)",
 "unpresentable": "غَيْر لَائِق, غَيْر مُسْتَحْسَن (يترك انطباعاً أولياً سلبياً أو محايداً)",
 "unpresidential": "غير رئاسي, لا يليق برئيس (لا يليق برئيس)\nمثال: سلوك غير رئاسي للغاية",
 "unpressed": "غَيْر مَكْبُوس ((للملابس) لم يُملَّس بالحرارة)",
 "unpretending": "بسيط, غير متفاخر (غير استعراضي)\nمثال: مكتبه المتواضع",
 "unpretentious": "بسيط, غير متفاخر (غير استعراضي) / بسيط, غير متصنع (يفتقر إلى الادعاء أو التصنع) / غَيْرُ مُتَكَلَّف, مُتَحَفِّظ (يُظْهِرُ ذَوْقًا رَفِيعًا بِتَحَفُّظٍ وَاعْتِدَال)\nمثال: مكتبه المتواضع",
 "unpretentiously": "ببساطة, بتواضع (بطريقة غير متكلفة)\nمثال: كانت ترتدي ملابس ببساطة رغم أنها كانت ضيفة الشرف",
 "unpretentiousness": "تَوَاضُع, عَدَم ادِّعَاء (صفة كون الشخص طبيعياً وبلا ادعاءات)",
 "unpreventable": "لَا يُمْكِن مَنْعُه (غير قابل للمنع)\nمثال: هستيريا لا يمكن منعها",
 "unpriestly": "غير كهنوتي (ليس كهنوتياً؛ لا يليق بالكاهن)\nمثال: سلوك غير كهنوتي",
 "unprincipled": "عَدِيم المَبَادِئ (يفتقر إلى النزاهة أو المبادئ الأخلاقيَّة) / غير مبدئي, مجرد من المبادئ (يفتقر للمبادئ أو الوازع الأخلاقي)\nمثال: التحرر من الافتراء الفظ غير المبدئي",
 "unprintable": "غير صالح للنشر (غير صالح للطباعة لكونه مرفوضاً أخلاقياً أو قانونياً أو مسيئاً للذوق العام)\nمثال: نعت غير صالح للنشر",
 "unproblematic": "بَسِيط, غَيْر مُعَقَّد (سَهْل وَغَيْر مُعَقَّد أَوْ مُتَشَعِّب)",
 "unproblematicalness": "خلو من المشاكل (خاصية عدم تشكيل مشكلة؛ عدم الصعوبة في التغلب عليها أو حلها)",
 "unprocessed": "خَام, غَيْر مُعَالَج (لَمْ يُعَالَج أَوْ يُحَضَّر بِعَمَلِيَّة خَاصَّة) / خام, غير معالج (غير مغير عن حالته الأصلية أو الطبيعية) / خام, غير مكرر (غير مكرر أو معالج)\nمثال: سلع أولية (غير مصنعة)",
 "unprocurable": "بَعِيد المَنَال, مُتَعَذَّر الحُصُول عَلَيْه (لا يمكن الحصول عليه أو الوصول إليه)",
 "unproductive": "غَيْرُ مُثْمِر, غَيْرُ مُنْتِج (لا يُنتج النتائج المرجوّة) / عقيم, غير مثمر (لا ينتج أو غير قادر على الإنتاج)\nمثال: القضاء على الصناعات عالية التكلفة أو غير المنتجة",
 "unproductively": "بشكل غير منتج, بلا جدوى (بطريقة غير منتجة)",
 "unproductiveness": "عَدَم إِنْتَاجِيَّة, عُقْم (صفة الافتقار إلى القدرة على الإنتاج)",
 "unprofessional": "غير احترافي, غير مهني (ليس من سمات المهنة أو لا يليق بها أو بمن يمارسها)\nمثال: موصوف بلغة غير مهنية حتى يتمكن طلاب المدارس الثانوية من فهمه",
 "unprofitability": "خسارة, عدم ربحية (صفة عدم تحقيق مكسب أو فائدة أو ربح)",
 "unprofitable": "خاسر, غير مربح (ينتج القليل من الربح أو المكسب أو لا ينتج شيئاً)\nمثال: رواسب تخلت عنها شركات التعدين لكونها غير مربحة",
 "unprofitableness": "خسارة, عدم ربحية (صفة عدم تحقيق مكسب أو فائدة أو ربح)",
 "unprofitably": "بشكل غير منتج, بلا جدوى (بطريقة غير منتجة) / بلا جدوى, دون نفع (بدون مكسب أو ربح)",
 "unprogressive": "جَامِد, عَتِيقُ الطِّرَازِ (قَدِيمُ الطَّرِيقَةِ وَمُتَخَلِّفٌ عَنِ العَصْرِ)",
 "unpromised": "حُرّ, غَيْر مَخْطُوب (لم يُعطِ وعدًا بالزواج؛ غير مرتبط)",
 "unpromising": "غَيْر وَاعِد (من غير المرجح أن يؤدي إلى نتائج إيجابية أو متعة)",
 "unprompted": "انْدِفَاعِيّ, عَفْوِيّ (ينبع من شعور طبيعيّ أو دافع داخليّ بلا مؤثّر خارجيّ)",
 "unpronounceable": "صَعْبُ اللَّفْظ, مُسْتَعْصٍ عَلَى النُّطْق (يصعب نطقه بشكل صحيح جدًّا) / صعب النطق, لا يلفظ (مستحيل أو صعب النطق بشكل صحيح)",
 "unprophetic": "غير تنبؤي (ليس نبوياً؛ لا يتنبأ بشكل صحيح)",
 "unpropitious": "غَيْر مُؤَاتٍ (غير ملائم)",
 "unpropitiously": "بشكل مشؤوم (بطريقة غير مبشرة)\nمثال: بدأ عمله الجديد بشكل مشؤوم في الجمعة الثالث عشر",
 "unpropitiousness": "شؤم, نذير سوء (صفة الإيحاء بنتيجة غير ناجحة)",
 "unprotected": "غير محمي, مكشوف (يفتقر للحماية أو الدفاع)",
 "unprotectedness": "انعدام الدفاع (خاصية العجز في مواجهة الهجوم)",
 "unprotective": "غير واق (لا يوفر الحماية)",
 "unprovable": "غَيْر قَابِل لِلإِثْبَات (لا يمكن إثباته أو البرهنة عليه)",
 "unproved": "غير مبرهن, غير مثبت (لم يتم إثباته)\nمثال: ادعاءات غير مثبتة",
 "unproven": "غير مبرهن, غير مثبت (لم يتم إثباته)\nمثال: ادعاءات غير مثبتة",
 "unprovocative": "غير مثير, غير مستفز (ليس مستفزاً)",
 "unprovoked": "بِلَا دَافِع, عَابِث (يحدث دون دافع أو استفزاز)",
 "unprovoking": "غير مثير, غير مستفز (ليس مستفزاً)",
 "unpublishable": "غَيْر صَالِح لِلنَّشْر (غير مناسب للنشر)",
 "unpublished": "غَيْر مَنْشُور (غير منشور)\nمثال: رسائل ومذكرات غير منشورة",
 "unpunctual": "غير دقيق في المواعيد, متأخر (ليس في الموعد؛ بعد الوقت المحدد)",
 "unpunished": "بلا عقاب, غير معاقب (لم يعاقب)\nمثال: هل سينسى الجريمة ويتركها تمر بلا عقاب؟",
 "unpurified": "غَيْرُ مُنَقًّى (لم يتمّ تنقيته أو تصفيته)",
 "unq": "رذرفورديوم (عنصر مشع ما بعد اليورانيوم تم تصنيعه)",
 "unqualified": "غير مؤهل, غير مختص قانونياً (غير مؤهل أو غير كافٍ قانونياً) / بِلَا حَقّ, غَيْرُ مُسْتَحِقّ (لا يملك حقاً أو استحقاقاً) / غير مؤهل (غير مستوف للمعايير والمتطلبات والتدريب المناسب) / غير مشروط, مطلق (غير محدود أو مقيد)\nمثال: تعتبر الزوجة عادة غير مؤهلة للشهادة ضد زوجها",
 "unqualifiedly": "بِلَا تَحَفُّظ, دُونَ قَيْد (بدون تحفظ أو قيد)",
 "unquenchable": "لَا يُرْوَى, لَا يُطْفَأ (يستحيل إشباعه أو إطفاؤه)",
 "unquestionability": "عَدَم قَابِلِيَّة الجَدَل, قَطْعِيَّة (صفة كون الشيء فوق الشك أو الجدال أو النزاع)",
 "unquestionable": "لَا يَقْبَلُ الشَّكّ (غير قابل للتساؤل أو الطعن) / أَصِيل, مَوْثُوق (غير مُزيَّف أو منسوخ؛ حقيقي لا شك فيه) / غير قابل للشك, لا جدال فيه (غير قابل للتساؤل أو الشك)\nمثال: سلطة لا جدال فيها",
 "unquestionableness": "عَدَم قَابِلِيَّة الجَدَل, قَطْعِيَّة (صفة كون الشيء فوق الشك أو الجدال أو النزاع)",
 "unquestionably": "أَلاَ",
 "unquestioned": "بِلَا مُنَازِع, مُسَلَّمٌ بِه (مُتَّفَقٌ عَلَيْهِ عُمُومًا؛ لَا يَخْضَعُ لِلنِّزَاع)",
 "unquestioning": "ضِمْنِيّ, مُطْلَق (بلا شكّ أو تحفُّظ) / بِلَا تَسَاؤُلٍ, مُسَلِّم (لا يميل إلى طرح الأسئلة)",
 "unquestioningly": "بطاعة عمياء, دون تساؤل (بطريقة لا تطرح أسئلة)\nمثال: تبع قائده دون تساؤل",
 "unquiet": "قلق, مضطرب (يتميز بالاضطراب أو الفوضى) / قَلِق, مُتَوَتِّر (يسبب القلق أو مفعم به أو يُظهره)\nمثال: أيام مضطربة من الشغب",
 "unquietly": "بِاضْطِرَاب, بِقَلَق (مع هيجان أو اضطراب)",
 "unquotable": "لا يمكن اقتباسه, لا يمكن تكراره (لا يمكن أو لا يصلح تكراره أو اقتباسه)\nمثال: ما قاله كان مضحكاً لكن لا يمكن اقتباسه",
 "unraised": "غير مختمر, فطير (مصنوع بدون خميرة)\nمثال: الخبز الفطير غالباً ما يكون مجرد دقيق مخلوط بالماء",
 "unranked": "غَيْر مُدَرَّج, غَيْر مُرَتَّب (غير منظَّم ترتيباً هرميّاً)",
 "unratable": "غَيْرُ خَاضِعٍ لِلتَّقْيِيمِ المَحَلِّيّ (لَا يَخْضَعُ لِضَرَائِبِ المُمْتَلَكَاتِ المُقَدَّرَةِ مَحَلِّيًّا)",
 "unratified": "غَيْر مُصَدَّق (لَمْ تَتِمّ المُصادَقَة عَلَيْه رَسْمِيًّا)",
 "unraveler": "حَلَّال الْعُقَد, فَاكّ الاشْتِبَاك (شخص يزيل التشابك؛ شخص يخرج شيئاً من حالة تشابك)",
 "unraveller": "حَلَّال الْعُقَد, فَاكّ الاشْتِبَاك (شخص يزيل التشابك؛ شخص يخرج شيئاً من حالة تشابك)",
 "unreachable": "بَعِيد المَنَال, لَا يُمكِن الوُصُول إِلَيْه (يقع في مكان يتعذّر الوصول إليه)",
 "unreached": "بَعِيد المَنَال, لَا يُمكِن الوُصُول إِلَيْه (يقع في مكان يتعذّر الوصول إليه)",
 "unreactive": "خامل, غير تفاعلي ((كيمياء) لا يتفاعل كيميائياً) / غَيْر تَفَاعُلِيّ (لا يميل إلى التفاعل مع المحفّزات)",
 "unread": "غَيْرُ قَارِئ (لم يكتسب معرفة عن طريق القراءة)",
 "unreadable": "غَيْر مَقْرُوء, مُسْتَغْلَق (يَتَعَذَّر قِراءَتُه أَوْ فَكّ رُموزِه)",
 "unreadably": "بخط غير مقروء, بشكل مبهم (بطريقة غير مقروءة)\nمثال: هذا الطالب يكتب بخط غير مقروء",
 "unready": "غير جاهز, غير مستعد (غير مستعد أو ليس في حالة جاهزية؛ بطيء الفهم أو الاستجابة)\nمثال: لعنت لسانها غير المستعد",
 "unreal": "غير جوهري, غير مادي (يفتقر إلى الشكل المادي أو المادة؛ غير حقيقي) / اصطناعي, صناعي (مبتكر عن طريق الصناعة وليس الطبيعة) / غير حقيقي, وهمي (يفتقر للواقعية أو الجوهر أو الأصالة؛ لا يتوافق مع الحقائق أو المعايير المعترف بها) / خيالي, غير واقعي (ليس كذلك فعلياً؛ كائن أو يبدو خيالياً أو وهمياً)\nمثال: غير جوهري مثل حلم",
 "unrealised": "غَيْر مُتَحَقِّق, غَيْر مُنْجَز ((للأشخاص) يتميز بالفشل في تحقيق كامل إمكاناته)",
 "unrealism": "تجريدية, لا واقعية (تمثيل لا يشير إلى كائنات ملموسة أو أمثلة محددة)",
 "unrealistic": "غير واقعي (ليس واقعياً)\nمثال: توقعات غير واقعية",
 "unrealistically": "بشكل غير واقعي (بطريقة غير واقعية)\nمثال: كانت توقعاته عالية بشكل غير واقعي",
 "unreality": "لَا وَاقِعِيَّة, وَهْم (الصفة التي يمتلكها شيء غير حقيقي) / لا واقعية, وهمية (حالة كون الشيء غير جوهري أو خيالي؛ لا وجود له موضوعياً أو في الواقع) / عدم واقعية (عدم الكفاءة في التعامل مع الواقع)",
 "unrealizable": "بَعِيد المَنَال, مُسْتَحِيل التَّحْقِيق (يستحيل تحقيقه أو بلوغه)",
 "unrealized": "غَيْر مُتَحَقِّق, غَيْر مُنْجَز ((للأشخاص) يتميز بالفشل في تحقيق كامل إمكاناته)",
 "unreason": "لا عقلانية (حالة كونه غير عقلاني؛ الافتقار لقدرات الفهم)",
 "unreasonable": "غَيْرُ مَعْقُول, مُفْرِط (يَتَجَاوَزُ الحُدُودَ الطَّبِيعِيَّة) / غير معقول, غير منطقي (غير معقول؛ لا يظهر حكماً صائباً)",
 "unreasonably": "بشكل غير معقول, بشكل مفرط (لدرجة تتجاوز حدود العقل أو الاعتدال) / بشكل غير معقول (بطريقة غير معقولة أو غير ذكية)\nمثال: أسعاره مرتفعة بشكل غير معقول",
 "unreasoning": "أَعْمَى, غَيْرُ مُسْتَنِد إِلَى العَقْل (غير مبنيّ على العقل أو الدليل)",
 "unreasoningly": "بدون تفكير, بشكل غريزي (بطريقة غريزية غير عقلانية)",
 "unreassuring": "غَيْر مُطَمْئِن, مُقْلِق (غير مطمئن؛ يميل إلى إحداث القلق)",
 "unreceptive": "غير متقبل, منغلق (غير متقبل)",
 "unreciprocated": "بِلَا مُقَابِلٍ, غَيْرُ مَرْدُودٍ (لا يُرَدُّ بالمثل)",
 "unrecognisable": "بشكل لا يمكن التعرف عليه, لدرجة التنكر (بشكل يتجاوز التعرف عليه) / لَا يُمْكِن التَّعَرُّف عَلَيْه (يستعصي على التعرّف، كأن يكون بسبب تلف أو تغيير)\nمثال: لقد شاخ بشكل لا يمكن التعرف عليه",
 "unrecognised": "غَيْر مَعْرُوف, غَيْر مُعتَرَف بِه (لم يُتعرَّف عليه أو يُقَرّ به) / غَيْر مُعْتَرَف بِه (لا يتمتّع بسمعة راسخة)",
 "unrecognizable": "لَا يُمْكِن التَّعَرُّف عَلَيْه (يستعصي على التعرّف، كأن يكون بسبب تلف أو تغيير)",
 "unrecognizably": "بشكل لا يمكن التعرف عليه, لدرجة التنكر (بشكل يتجاوز التعرف عليه)\nمثال: لقد شاخ بشكل لا يمكن التعرف عليه",
 "unrecognized": "غَيْر مَعْرُوف, غَيْر مُعتَرَف بِه (لم يُتعرَّف عليه أو يُقَرّ به) / غَيْر مُعْتَرَف بِه (لا يتمتّع بسمعة راسخة)",
 "unrecognized state": "دولة غير معترف بها, دولة محدودة الاعتراف (إقليم يتمتع بسيادة فعلية ولكنه يفتقر إلى الاعتراف الدولي)",
 "unreconcilable": "لا يمكن التوفيق بينه (مستحيل التوفيق بينه)\nمثال: خلافات لا يمكن التوفيق بينها",
 "unreconciled": "غَيْرُ مُتَصَالِحٍ (لَمْ يُجْعَلْ مُتَّسِقًا أَوْ مُتَوَافِقًا)",
 "unreconstructed": "غَيْر مُتَكَيِّف, مُتَمَسِّك بِالقَدِيم (التمسك بموقف أو وضع يُعتقد على نطاق واسع أنه عفا عليه الزمن)\nمثال: الفلاحون لا يزالون رأسماليين صغاراً متمسكين بالقديم في القلب",
 "unrecorded": "حي, مباشر (يتم أداؤه فعلياً في وقت السمع أو المشاهدة)\nمثال: برنامج تلفزيوني مباشر",
 "unrecoverable": "غير قابل للاسترداد (لا يمكن استرداده أو استعادته)",
 "unredeemable": "غَيْرُ قَابِلٍ لِلإِصْلَاح, لَا يُرْجَى إِصْلَاحُه (لَا يَقْبَلُ الإِصْلَاحَ أَوِ التَّقْوِيم)",
 "unredeemed": "مَحْكُومٌ عَلَيْه, مَلْعُون (مُعرَّض لعذاب جهنم الأبدي)",
 "unreduced": "غَيْر مُخْتَزَل (لم يُغيَّر عن طريق الاختزال أو التقليص)",
 "unrefined": "خشن, غير مهذب ((للأشخاص وسلوكهم) غير مهذب؛ فظ) / خام, غير مكرر (غير مكرر أو معالج)\nمثال: كيف يمكن لفتاة مهذبة أن تنجذب لرجل خشن كهذا؟",
 "unreflected": "غير منعكس ((خاصة للصوت أو الضوء الساقط) لم يرتد عن طريق الانعكاس الفيزيائي)",
 "unreflective": "بِلَا تَفْكِير, غَيْرُ مُتَأَمِّل (لَا يُظْهِرُ أَوْ يَتَّسِمُ بِالتَّفْكِيرِ المُتَأَنِّي)",
 "unreformable": "عَاتٍ, غَيْرُ قَابِلٍ لِلإِصْلَاح (لَا يَنْدَمُ وَلَا يُمْكِنُ إِصْلَاحُه) / غَيْرُ قَابِلٍ لِلإِصْلَاح, لَا يُرْجَى إِصْلَاحُه (لَا يَقْبَلُ الإِصْلَاحَ أَوِ التَّقْوِيم)",
 "unreformed": "غَيْر مُصْلَح (لم يتأثر بحركة الإصلاح الديني البروتستانتي)",
 "unrefreshed": "غَيْرُ مُسْتَرِيح, غَيْرُ مُنْتَعِش (لم يحصل على الراحة أو الانتعاش)",
 "unregenerate": "عَاتٍ, غَيْرُ قَابِلٍ لِلإِصْلَاح (لَا يَنْدَمُ وَلَا يُمْكِنُ إِصْلَاحُه) / غير تائب, غير متجدد (لم يتم إصلاحه أخلاقياً أو روحياً) / عنيد, متعنت (غير راغب بإصرار أو يتميز بعدم الرغبة المستمرة في الاستسلام)\nمثال: الطبيعة البشرية غير التائبة",
 "unregenerated": "غير تائب, غير متجدد (لم يتم إصلاحه أخلاقياً أو روحياً)\nمثال: الطبيعة البشرية غير التائبة",
 "unregistered": "غَيْر مُسَجَّل ((عَنِ القَارِب أَوِ السَّفِينَة) غَيْر مُزَوَّد بِالوَثَائِق الرَّسْمِيَّة) / غير مسجل (غير مسجل) / غير مسجل ((للحيوانات) غير مسجل أو معتمد لدى جمعية سلالة رسمية)\nمثال: مواطن غير مسجل",
 "unregretful": "غير نادم (لا يشعر بالندم)\nمثال: كان غير نادم تماماً عما حدث",
 "unregretting": "غير نادم (لا يشعر بالندم)\nمثال: كان غير نادم تماماً عما حدث",
 "unregularity": "اضْطِرَاب, شُذُوذ (عدم الاتصاف بمبدأ ثابت أو معدل ثابت؛ الحدوث على فترات غير منتظمة)",
 "unregulated": "بِلَا ضَوَابِط, غَيْر مُنَظَّم (بدون تنظيم أو انضباط) / غير مضبوط, غير منظم (غير منظم؛ لا يخضع لقاعدة أو انضباط)\nمثال: صيد بحري غير منظم",
 "unrehearsed": "اِرْتِجَالِيّ, عَفْوِيّ (بقليل من الإعداد أو التفكير المسبق أو بدونهما)",
 "unrelated": "لا تربطه قرابة, ليس قريباً (غير متصل بقرابة) / غير ذي صلة, غير مرتبط (يفتقر لعلاقة منطقية أو سببية)",
 "unrelatedness": "عَدَم الارْتِبَاط (غياب أي طريقة معينة للترابط)",
 "unrelaxed": "غَيْرُ مُسْتَرْخٍ (لَيْسَ فِي حَالَةِ اسْتِرْخَاء)",
 "unreleased": "غَيْر صَادِر, غَيْر مَنْشُور (لم يُتح (أو لم يُتح بعد) للتوزيع أو النشر)",
 "unrelenting": "حَثِيث, دَائِم (لَا يَتَوَقَّفُ أَبَدًا) / قَاسٍ, لَا يَرْحَم (بَالِغُ القَسْوَةِ بِشَكْلٍ مُؤْلِم) / صَارِم, لَا يَرْحَم (لا يمكن استرضاؤه أو ثَنيه بالتوسّل)",
 "unrelentingly": "بلا هوادة (بطريقة لا تكل ولا تمل)\nمثال: عمل بلا هوادة",
 "unreliability": "عدم الاعتمادية, عدم الموثوقية (سمة عدم كون الشخص أو الشيء جديراً بالاعتماد أو الثقة)",
 "unreliable": "غير موثوق, لا يعول عليه (لا يستحق الاعتماد أو الثقة) / غَيْر مَوْثُوق, لَا يُعْتَمَد عَلَيْه (مُحْتَمَل أَنْ يَكُون خَاطِئًا أَوْ مُضَلِّلًا) / غَيْرُ مَوْثُوق (يفتقر إلى الإحساس بالمسؤولية) / غَدَّار, لَا يُوثَقُ بِهِ (غير مستقرّ وغير متوقَّع بشكل خطير)\nمثال: في أوائل الخمسينيات كانت الحواسيب كبيرة ومكلفة وغير موثوقة",
 "unreliableness": "عدم الاعتمادية, عدم الموثوقية (سمة عدم كون الشخص أو الشيء جديراً بالاعتماد أو الثقة)",
 "unreliably": "بِخِيَانَة, بِدُون إِخْلَاص (بطريقة تفتقر إلى الأمانة أو الاعتمادية)",
 "unrelieved": "غَيْرُ مُتَنَاقِص, لَا يَخِفّ (لَمْ يَنْقُصْ وَلَمْ تَتَرَاجَعْ شِدَّتُه)",
 "unremarkable": "رُوتِينِيّ, يَوْمِيّ (يوجد في المجرى العادي للأحداث)",
 "unremarkably": "بشكل طبيعي, عادة (في ظل الظروف العادية)\nمثال: عادة كانت تتأخر",
 "unremarked": "غَيْر مُدْرَك (لم يُدرَك أو يُعلَّق عليه)",
 "unremedied": "غَيْرُ مُصَحَّح, غَيْرُ مُعَالَج (لَمْ يَتِمَّ تَصْحِيحُهُ أَوْ إِصْلَاحُه)",
 "unremitting": "دَائِم, لَا يَنْقَطِع (غَيْرُ مُنْقَطِعٍ فِي الزَّمَنِ وَمُسْتَمِرٌّ إِلَى أَجَلٍ غَيْرِ مُسَمًّى)",
 "unremorseful": "غير نادم, مصر (غير تائب أو نادم)",
 "unremunerative": "غَيْر مُجْزٍ (لا يُدرّ ربحًا أو مكافأة)",
 "unrenewable": "غير قابل للتجديد (لا يمكن تجديده)\nمثال: الكتب على ذلك الرف غير قابلة للتجديد",
 "unrenewed": "غير متجدد, غير منتعش (لم يتم إنعاشه)",
 "unrentable": "غير قابل للتأجير (لا يمكن أو لا يصلح تأجيره)\nمثال: المنزل كان غير قابل للتأجير في تلك الحالة",
 "unrepaired": "غَيْر مُصْلَح (غير صالح للخدمة لأنّ الإصلاحات اللازمة لم تُجرَ)",
 "unrepeatable": "فَرِيد مِن نَوْعِه, لَا يَتَكَرَّر (فريد لا نظير له ولا يتكرّر) / لا يمكن اقتباسه, لا يمكن تكراره (لا يمكن أو لا يصلح تكراره أو اقتباسه)\nمثال: ما قاله كان مضحكاً لكن لا يمكن اقتباسه",
 "unrepentant": "غير نادم, مصر (غير تائب أو نادم) / عَنِيدٌ, مُصِرٌّ عَلَى الْخَطَأِ (مُصِرّ بعناد على ارتكاب الخطأ)",
 "unrepentantly": "بإصرار, دون ندم (بطريقة لا تظهر الندم)\nمثال: كرر موقفه دون ندم",
 "unreplaceable": "لا يستبدل, لا يعوض (مستحيل استبداله)\nمثال: تحف لا تعوض",
 "unreportable": "غَيْر وَاجِب الإِبْلَاغ عَنْه ((للدخل) غير واجب الإبلاغ عنه؛ غير مطلوب بموجب القانون الإبلاغ عنه)\nمثال: القليل جداً من الدخل غير واجب الإبلاغ عنه",
 "unreported": "غَيْر مُبَلَّغ عَنْه (لم يتم الإبلاغ عنه)\nمثال: نتائج غير مبلغ عنها",
 "unrepresentative": "غَيْرُ مُمَثِّل (لا يُمثِّل فئة أو نوعًا معينًا)",
 "unrepressed": "غَيْرُ مَكْبُوت (لم يُكبَت أو يُقمَع)",
 "unreproducible": "غير قابل للتكرار, لا يمكن إعادة إنتاجه (مستحيل إعادة إنتاجه أو تكراره)",
 "unreproducibly": "بشكل فريد, بشكل لا يضاهى (بطريقة لا يمكن تقليدها)\nمثال: لديه أسلوب مسهب بشكل لا يضاهى",
 "unrequested": "غير مطلوب (لم يتم طلبه)\nمثال: البضاعة كانت غير مطلوبة",
 "unrequited": "بِلَا مُقَابِلٍ, غَيْرُ مَرْدُودٍ (لا يُرَدُّ بالمثل)",
 "unresentful": "غَيْر مُسْتَاء, مُتَسَامِح (ليس مستاءً)\nمثال: غير مستاء ومتسامح تماماً",
 "unreserved": "صريح, غير متحفظ (غير حذر أو متحفظ) / غير محجوز (غير محجوز)\nمثال: سلوك غير متحفظ",
 "unreservedly": "بلا تحفظ, تماماً (بدون تحفظ)\nمثال: أستطيع أن أوصي بهذا المطعم بلا تحفظ!",
 "unresistant": "عُرْضَة لِلْإِصَابَة, غَيْر مَنِيع ((يتبعه غالبًا 'لـ') من المرجح أن يتأثر بـ)",
 "unresisting": "غَيْر مُقَاوِم, مُسْتَسْلِم (لا يُقدِّم مقاومة؛ يقبل الوضع بسلبيّة)",
 "unresolvable": "غَيْر قَابِل لِلحَلّ (لا يمكن حله أو فك تعقيده) / عَصِيٌّ عَلَى الحَلّ, مُسْتَعْصٍ (ليس سهل الحلّ؛ يصعب التوصّل إلى حلّه)",
 "unresolved": "غَيْر مَحْلول, مُعَلَّق ((في المُوسيقى) لَمْ يُحَلّ إلى تَوافُق؛ يَظَلّ مُتَنافِرًا) / غَيْر مَحْسُوم, مَفْتُوح (لم يُبَتّ فيه بعد؛ قابل لمزيد من التفكير والنقاش) / عالق, غير محلول (لم يتم حله)\nمثال: العديد من الجرائم تبقى غير محلولة",
 "unrespectability": "سوء السمعة, قلة الاحترام (الخزي بحكم الافتقار إلى الاحترام أو السمعة الطيبة)",
 "unrespectable": "غير محترم (لا يستحق الاحترام)",
 "unresponsive": "غير متجاوب, غير مستجيب (لا يستجيب لتأثير أو محفز ما) / غَيْر مُسْتَجِيب (لا يتأثر بالإيحاء أو التأثير) / غَيْرُ مُتَجَاوِب, لَامُبَالٍ (منعزل وغير مبالٍ؛ بارد المشاعر)",
 "unresponsiveness": "جمود, خدر (صفة عدم الاستجابة أو عدم التفاعل؛ بالنسبة للأشخاص، تتميز بالفشل في الاستجابة بسرعة أو بعاطفة تجاه الناس أو الأحداث)\nمثال: بدأت تتعافى من حالة عدم الاستجابة والخدر بعد الحادث",
 "unrest": "عدم استقرار, قلق (شعور باضطراب قلق) / غليان, قلق (حالة من الهياج أو التغيير المضطرب أو التطور)\nمثال: أنتج الغليان السياسي قيادة جديدة",
 "unrested": "غَيْرُ مُسْتَرِيح, غَيْرُ مُنْتَعِش (لم يحصل على الراحة أو الانتعاش)",
 "unrestrained": "طليق, غير مقيد (غير خاضع للتقييد) / مَجْنُون, مَحْمُوم (يَتَّسِمُ بِالإِثَارَةِ أَوِ الانْفِعَالِ غَيْرِ المُسَيْطَرِ عَلَيْه)\nمثال: ضحك غير مقيد",
 "unrestrainedly": "بانطلاق, بلا قيد (بطريقة غير مقيدة)",
 "unrestraint": "تحرر, عدم تقيد (جودة الافتقار للتحفظ)",
 "unrestricted": "غَيْر حَسَّاس, غَيْر مُقَيَّد (لا يخضع لتصنيف سرّيّ ومتاح للتداول) / بِلَا قُيُود, غَيْر مَحْدُود (خَالٍ مِنَ القُيُود عَلَى السُّلُوك) / غَيْرُ مُقَيَّد, مُطْلَقُ المَعْنَى (غَيْرُ مَحْصُورٍ أَوْ مُعَدَّلٍ فِي المَعْنَى) / غَيْر حَصْرِيّ, غَيْر مُقَيَّد (غير محصور أو مقيَّد بفئة معيّنة)",
 "unrestrictive": "غير تقييدي (لا يميل إلى التقييد)",
 "unretentive": "ضعيف الذاكرة, كثير النسيان ((للذاكرة) قاصر في الاحتفاظ أو المدى)\nمثال: ذاكرة قصيرة",
 "unretrievable": "لَا رَجْعَةَ فِيهِ, لَا يُمْكِنُ تَدَارُكُهُ (يستحيل استرداده أو تعويضه أو تداركه)",
 "unrevealed": "غَيْرُ مَكْشُوف, غَيْرُ مُعْلَن (لَمْ يُفْصَحْ عَنْهُ أَوْ يُعْلَن)",
 "unreverberant": "غير رنان, غير مدو (غير مرجع للصدى؛ يفتقر للميل لإحداث صدى)",
 "unrevised": "غَيْر مُرَاجَع (لم يُحسَّن أو يُحدَّث)",
 "unrevived": "غير متجدد, غير منتعش (لم يتم إنعاشه)",
 "unrewarded": "خَالِي الوِفَاض, صِفْر اليَدَيْن (لم يكتسب أو يحصل على شيء)",
 "unrewarding": "غير مجز (غير مجز؛ لا يوفر الرضا الشخصي)",
 "unrhetorical": "غير بلاغي (ليس بلاغياً)",
 "unrhymed": "غير مقفى, مرسل (ليس له قافية)\nمثال: كتابة الشعر المرسل غير المقفى تشبه لعب التنس بدون شبكة",
 "unrhythmic": "غير موزون, لا إيقاعي (ليس إيقاعياً؛ غير منتظم في النبض أو النبر)",
 "unrhythmical": "غير موزون, لا إيقاعي (ليس إيقاعياً؛ غير منتظم في النبض أو النبر)",
 "unrifled": "أملس السبطانة, غير مششخن ((للسلاح الناري) ليس لديه ششخنة أو أخاديد لولبية داخل السبطانة)",
 "unrigged": "مجرد من التجهيزات (مجرّد من التجهيزات (مثل الأشرعة))",
 "unrighteous": "آثم, ظالم (غير صالح)",
 "unrighteously": "بظلم, بغير حق (بطريقة غير صالحة أو ظالمة)\nمثال: تصرف بغير حق",
 "unrighteousness": "إثم, طغيان (الفشل في التمسك بالمبادئ الأخلاقية)\nمثال: يغفر لنا خطايانا ويطهرنا من كل إثم",
 "unrimed": "غير مقفى, مرسل (ليس له قافية)\nمثال: كتابة الشعر المرسل غير المقفى تشبه لعب التنس بدون شبكة",
 "unripe": "غير ناضج, فج (غير مكتمل النمو أو النضج؛ غير يانع) / غَيْرُ جَاهِز, غَيْرُ نَاضِج (لم يكتمل استعداده بعد)\nمثال: فاكهة غير ناضجة",
 "unripened": "غير ناضج, فج (غير مكتمل النمو أو النضج؛ غير يانع)\nمثال: فاكهة غير ناضجة",
 "unrivaled": "لَا مَثِيلَ لَهُ, لَا نَظِيرَ لَهُ (بارز يفوق أيّ مقارنة؛ فريد لا يُضاهى)",
 "unrivalled": "لَا مَثِيلَ لَهُ, لَا نَظِيرَ لَهُ (بارز يفوق أيّ مقارنة؛ فريد لا يُضاهى)",
 "unromantic": "غَيْرُ رُومَانْسِيّ (لا يُعبِّر عن الحب الرومانسي ولا يُثيره)",
 "unromantically": "بلا رومانسية, بواقعية جافة (بدون رومانسية؛ بطريقة غير رومانسية)\nمثال: تزوجنا، بشكل غير رومانسي، في مكتب كئيب في دار البلدية",
 "unroofed": "بِلَا سَقْف (لا يملك سقفاً)",
 "unrouged": "غَيْرُ مُتَوَرِّد (لَا يَضَعُ أَحْمَرَ الخُدُود)",
 "unrounded vowel": "صائت غير مدور (صوت صائت تكون فيه الشفاه مرتخية أو مسحوبة للخلف)",
 "unruffled": "رَاكِد, سَاجٍ ((عَنْ جِسْمٍ مَائِيّ) خَالٍ مِنَ الاضْطِرَاب بِسَبَب الأَمْوَاج الكَبِيرَة) / غَيْرُ مُضْطَرِب, مُطْمَئِنّ (خالٍ من الاضطراب العاطفيّ والتوتّر العصبيّ)",
 "unruliness": "تمرد, عدم انضباط (سمة الميل للعصيان ونقص الانضباط)",
 "unruly": "مُتَوَحِّش, خارج عن السيطرَة",
 "unsaddled": "غَيْر مُسْرَج (بدون سرج)",
 "unsafe": "خطر, خطير (ينطوي على خطر أو يسببه؛ عرضة للتسبب في الأذى أو الضرر) / غير آمن, محفوف بالمخاطر (يفتقر إلى الأمن أو السلامة) / غَيْرُ آمِن, مُعَرَّضٌ لِلخَطَر (غَيْرُ مَحْمِيٍّ مِنَ الهُجُوم)\nمثال: مجرم خطير",
 "unsaid": "غَيْر مُعَبَّر عَنْه, مَسْكُوت عَنْه (لم يُصَرَّح به أو يُفْصَح عنه)",
 "unsalable": "غير قابل للبيع, كاسد (يستحيل بيعه)",
 "unsalaried": "بِلَا رَاتِب, غَيْرُ مَأْجُور (لَا يَدْفَعُ رَاتِبًا)",
 "unsaleable": "غير قابل للبيع, كاسد (يستحيل بيعه)",
 "unsalted": "غَيْرُ مُتَبَّل, غَيْرُ مُمَلَّح (بِدُونِ مِلْحٍ أَوْ تَوَابِل)",
 "unsanctification": "تَجْدِيف, دَنَس (عدم القداسة بحكم كون الشيء مدنساً)",
 "unsanctified": "غَيْرُ مُقَدَّس, مُدَنَّس (غير مقدّس لأنّه لم يُكرَّس أو لكونه نجسًا أو مدنَّسًا)",
 "unsanctioned": "غَيْر مُعْتَمَد (بدون إذن رسميّ صريح)",
 "unsanded": "خَام, غَيْرُ مَصْقُول ((عَنِ الخَشَبِ وَالأَثَاثِ) غَيْرُ مُعَالَجٍ أَوْ مَصْقُولٍ)",
 "unsanitariness": "عدم النظافة, قذارة (حالة غير ملائمة للصحة)",
 "unsanitary": "غير صحي, ملوث (ليس صحيًا أو نظيفًا)\nمثال: مجاري مفتوحة غير صحية",
 "unsaponified": "غير متصبن (لم يتحول إلى صابون)\nمثال: دهون غير متصبنة",
 "unsarcastic": "غير ساخر (ليس ساخرًا أو تهكمياً)",
 "unsated": "غَيْرُ رَاضٍ, غَيْرُ مُشْبَع (لم يُشبَع أو لم يُلَبَّ له ما يطلب)",
 "unsatiable": "شره, لا يشبع (يستحيل إشباعه أو إرضاؤه)\nمثال: شهية لا تشبع",
 "unsatiably": "بشكل لا يرتوي, بنهم لا يشبع (بطريقة لا تشبع؛ بإصرار ولكن دون رضا) / بشكل نهم, لدرجة لا تشبع (لدرجة لا يمكن إشباعها)\nمثال: تشبث بنهم لا يشبع بالمفاهيم التقليدية",
 "unsatiated": "غَيْرُ رَاضٍ, غَيْرُ مُشْبَع (لم يُشبَع أو لم يُلَبَّ له ما يطلب)",
 "unsatisfactorily": "بشكل غير مرضٍ (بطريقة غير مرضية)\nمثال: أدى بشكل غير مرضٍ كمدير",
 "unsatisfactoriness": "عَدَم إِرْضَاء, قُصُور (صفة كون الشيء غير ملائم أو غير مناسب)",
 "unsatisfactory": "غير مُرضٍ (لا يبعث على الرضا)\nمثال: يجب أن تسترجع المتاجر البضائع غير المرضية",
 "unsatisfiable": "مُسْتَعْصٍ عَلَى الإِرْضَاء (لا يمكن إرضاؤه أو إشباعه)",
 "unsatisfied": "غَيْرُ مُرْتَاح, قَلِق (مَشْغُول البَال وَغَيْر مُطْمَئِنّ) / غَيْرُ رَاضٍ, غَيْرُ مُشْبَع (لم يُشبَع أو لم يُلَبَّ له ما يطلب)",
 "unsatisfying": "غَيْرُ مُرْضٍ, مُخَيِّبٌ لِلآمَال (لا يرقى إلى مستوى التوقّعات)",
 "unsaturated": "غَيْر مُشَبَّع ((للألوان) غير نقي لونيًا؛ مخفف) / غير مشبع (يستخدم لمركب (خاصة الكربون) يحتوي على ذرات تشترك في أكثر من رابط تكافؤ واحد) / غير مشبع (ليس مشبعاً؛ قادر على إذابة المزيد من المادة عند درجة حرارة معينة)\nمثال: أحمر غير مشبع",
 "unsaturated compound": "مركب غير مشبع (مركب كيميائي يحتوي على روابط كربون-كربون مزدوجة أو ثلاثية، مثل تلك الموجودة في الألكينات أو الألكاينات على التوالي)\nمثال: المركبات المشبعة وغير المشبعة لا تتكون بالضرورة فقط من سلسلة ذرات كربون",
 "unsaturated fatty acid": "حمض دهني غير مشبع (حمض دهني يمكن لسلسلة الكربون الخاصة به امتصاص ذرات هيدروجين إضافية)",
 "unsaved": "مَحْكُومٌ عَلَيْه, مَلْعُون (مُعرَّض لعذاب جهنم الأبدي)",
 "unsavoriness": "بَشَاعَة, قَرَف (خاصية كون الشيء غير مقبول للعقل بدرجة شديدة) / إثارة للاشمئزاز, قرف (عدم استساغة شديدة للفم)",
 "unsavory": "بغيض, شائن (مسيء أخلاقياً) / غَيْرُ مُسْتَسَاغ, كَرِيهُ الطَّعْم (غَيْرُ مُسْتَحَبٍّ فِي الرَّائِحَةِ أَوِ الطَّعْم)\nمثال: سمعة سيئة",
 "unsavoury": "بغيض, شائن (مسيء أخلاقياً) / غَيْرُ مُسْتَسَاغ, كَرِيهُ الطَّعْم (غَيْرُ مُسْتَحَبٍّ فِي الرَّائِحَةِ أَوِ الطَّعْم)\nمثال: سمعة سيئة",
 "unscalable": "غير قابل للتسلق, وعر (يعجز المرء عن صعوده)",
 "unscathed": "سَالِم, مُعَافًى (لم يُصَب بأذى أو ضرر)",
 "unscheduled": "غير مجدول, مفاجئ (غير مجدول أو ليس في جدول منتظم)\nمثال: اجتماع غير مجدول",
 "unscholarly": "غير أكاديمي, غير علمي (ليس علميًا أو أكاديميًا)",
 "unschooled": "غَيْرُ مُتَمَدْرِس (يفتقر إلى التعليم المدرسي)",
 "unscientific": "غير علمي (لا يتسق مع أساليب أو مبادئ العلم)\nمثال: افتقار غير علمي للموضوعية",
 "unscientifically": "بشكل غير علمي (بطريقة غير علمية؛ ليس وفقاً لمبادئ العلم)\nمثال: شرعوا بشكل غير علمي عندما شرحوا المومياء",
 "unscripted": "غير مكتوب (نصياً), مرتجل (غير مزود بنص أو لا يستخدم نصًا)\nمثال: مقابلات فورية غير محضرة ومرتجلة",
 "unscrupulous": "عديم الضمير, متجرد من المبادئ (بلا وازع أو مبادئ أخلاقية)\nمثال: السياسيون عديمو الضمير الذين يسعدهم بيع بلادهم من أجل السلطة",
 "unscrupulously": "بتجرد من المبادئ, بلا ضمير (بدون وازع أخلاقي)\nمثال: تستخدم سحرها بلا ضمير لجعل الرجال يفعلون ما تريد",
 "unscrupulousness": "انتهازية, انعدام الضمير (صفة عدم الأمانة والتجرد من المبادئ الأخلاقية)",
 "unsealed": "غير مختوم, مفتوح (غير مغلق أو غير مؤمن بختم أو ما شابه) / غير مؤكد, غير محتوم (لم يتم إقراره أو تأكيده)\nمثال: بضائع غير مختومة",
 "unseamanlike": "غير لائق ببحار (ليس من سمات البحار الماهر)",
 "unseamed": "بِلَا تَجَاعِيد, بِلَا خُطُوط (أملس وناعم خاصّة في وصف البشرة) / بِلَا دَرْزَة (خالٍ من الدرزات أو خطوط الخياطة)",
 "unseasonable": "في غير موسمه (لا يتماشى مع (وعادة ما يكون غير مرغوب فيه لـ) الموسم) / سَيِّئ التَّوْقِيت, فِي غَيْر أَوَانِه (ذو توقيت سيئ أو غير ملائم)\nمثال: عاصفة ثلجية مفاجئة في غير موسمها",
 "unseasonableness": "توقيت غير مناسب, عدم مناسبة الوقت (الكون في وقت غير مناسب)",
 "unseasonably": "فِي غَيْر أَوَانِه (ليس وفقاً للموسم)\nمثال: كان الجو بارداً في غير أوانه",
 "unseasoned": "غَيْر مُجَرَّب, غَيْر مُخْتَبَر (لم يُخْتَبَر أو يُجَرَّب بالتجربة العملية) / غير مُعتق (غير مُعمر أو مُعالج) / غَيْرُ مُتَبَّل, غَيْرُ مُمَلَّح (بِدُونِ مِلْحٍ أَوْ تَوَابِل)\nمثال: أخشاب غير معتقة",
 "unseaworthy": "غير صالح للإبحار (غير مناسب للرحلات البحرية)",
 "unsectarian": "غير طائفي, لا طائفي (لا يقتصر على طائفة أو مدرسة أو حزب واحد)\nمثال: تدريب ديني في جو غير طائفي",
 "unsecured": "بِلَا ضَمَان, غَيْر مَضْمُون (بدون ضمان ماليّ) / غَيْر مُقْفَل, مَحْلُول (غير مثبّت أو مؤمّن بإحكام)",
 "unsecured bond": "سند دين, سند غير مضمون (قدرة العميل على الحصول على سلع أو خدمات قبل الدفع، بناءً على الثقة بأن الدفع سيتم في المستقبل)",
 "unseductive": "غير مغرٍ (ليس مغرياً أو فاتناً)",
 "unseeable": "خفي, غير مرئي (مستحيل أو شبه مستحيل رؤيته؛ غير مدرك بالعين)\nمثال: الرجل الخفي",
 "unseeded": "غَيْر مَبْذُور ((عن قطعة أرض) لم تُبذر فيها بذور محاصيل) / غير مصنف (غير مصنف؛ تُستخدم للاعبين ذوي المهارات الأقل)",
 "unseeing": "غَافِل, غَيْرُ مُنْتَبِه (لَا يُلَاحِظُ بِوَعْي) / بِلَا عَيْنَيْن, فَاقِد البَصَر (يفتقر إلى حاسّة البصر)",
 "unseemliness": "شذوذ, عدم لياقة (نقص في مراعاة الآخرين)",
 "unseemly": "غَيْر لَائِق, مُنَافٍ لِلآدَاب (لا يتوافق مع المعايير المقبولة للسلوك اللائق في المجتمع المهذّب)",
 "unseen": "غَيْر مَنْظُور, غَيْر مُتَوَقَّع (لم يكن في الحسبان ولم يُتَرَقَّب) / غَيْر مَرْئِيّ, غَيْر مُلَاحَظ (لم يُلاحَظ ولم يُشاهَد) / غَيْرُ مَرْئِيّ, غَيْرُ مُلَاحَظ (لَمْ يُرَ أَوْ لَمْ يُدْرَك) / العالم الروحي, عالم الغيب (اعتقاد بوجود عالم تسيطر عليه روح إلهية)",
 "unsegmented": "غَيْرُ مُجَزَّأ (له جسم غير مقسم إلى أجزاء أو فقرات)",
 "unsegregated": "غَيْرُ مَفْصُول, مُنْهِي لِلْفَصْل (أُزيل منه الفصل العنصري؛ انتهى فيه التمييز)",
 "unselected": "غير مختار (لم يتم اختياره)",
 "unselective": "غَيْر اِنْتِقَائِيّ (لَا يَنْتَقِي وَلَا يُمَيِّز)",
 "unselfconscious": "تِلْقَائِيّ, غَيْر وَاعٍ بِذَاتِه (لا يشعر بوعي ذاتي مفرط)",
 "unselfconsciously": "بعفوية, دون تكلف (بطريقة مريحة خالية من التكلف أو الخجل)\nمثال: كانوا عراة، غير خجلين، وجميلين بعفوية",
 "unselfconsciousness": "عدم تكلف, عفوية (صفة عدم الوعي بالذات أو بآراء الآخرين عن الذات)\nمثال: كان لديه عفوية الطفل",
 "unselfish": "غَيْر أَنَانِيّ, نَزِيه (ليس جشعاً أو طمّاعاً) / غير أناني, مؤثر (للغير) (يتجاهل مصالحه ورفاهيته الخاصة لصالح الآخرين)",
 "unselfishly": "بِإِيثَار, بِتَجَرُّد مِن الأَنَانِيَّة (بطريقة غير أنانية)\nمثال: تصرف بإيثار عندما ساعدها في الحصول على الترقية",
 "unselfishness": "إيثار, سخاء (التصرف بكرم وسخاء) / إيثار, نكران الذات (صفة عدم وضع النفس أولاً والاستعداد لبذل الوقت أو المال أو الجهد من أجل الآخرين)\nمثال: يظهر سكان الريف تفانياً ونكراناً للذات أكثر من أبناء عمومتهم في المناطق الحضرية",
 "unsensational": "عادي, غير مثير (ليس من النوع الذي يثير اهتمامًا شديدًا أو فضولًا أو رد فعل عاطفي)",
 "unsent": "غير مرسل (لم يتم إرساله أو نقله)\nمثال: بقيت الرسالة غير مكتوبة وغير مرسلة",
 "unsentimental": "غَيْرُ عَاطِفِيّ, وَاقِعِيّ (يواجه الحقائق أو الصعوبات بواقعية وعزيمة)",
 "unsentimentally": "بلا عاطفة, بواقعية جافة (بطريقة خالية من العاطفة)\nمثال: رمت ألعاب ابنها الميت بلا عاطفة",
 "unserviceable": "غير صالح للاستخدام, غير صالح للخدمة (غير جاهز للخدمة) / غَيْرُ صَالِحٍ لِلاِسْتِخْدَام (غَيْرُ قَابِلٍ لِلاِسْتِخْدَام)\nمثال: يمكن استبدال المعدات غير الصالحة للاستخدام",
 "unservile": "أبي, غير خاضع (غير خانع أو خاضع)",
 "unsettled": "غَيْرُ مُسْتَوْطَن (لم يُسْتَوطَن بعد) / غير مستقر (غير مستقر أو مؤسس) / غير محسوم, معلق (لا يزال موضع شك) / غَيْرُ مُسْتَقِرّ, مُتَحَوِّل (عُرْضَةٌ لِلتَّغَيُّر)\nمثال: نمط حياة غير مستقر",
 "unsexed": "مخصي (محروم من القدرة الجنسية أو الصفات الجنسية)",
 "unsexy": "غير مثير (جنسياً) (ليس مثارًا جنسيًا أو مثيرًا)",
 "unshackled": "طَلِيق, مَحْلُول القُيُود (غير مُقيَّد بأغلال أو سلاسل)",
 "unshaded": "غَيْر مُظَلَّل (غير معتم أو خافت بالظل) / غَيْر مُظَلَّل ((للصور) ليس فيها تمثيل للظل)\nمثال: مرج غير مظلل",
 "unshadowed": "غَيْر مُظَلَّل, مَكْشُوف (غَيْر مُعَتَّم أَوْ مَحْجُوب بِالظِّلّ)",
 "unshakable": "رَاسِخ, مَنِيع (خَالٍ مِنَ الثَّغَرَاتِ أَوِ العُيُوب) / ثَابِتٌ, رَاسِخٌ (يتميز بعزيمة راسخة لا تتزعزع)",
 "unshakably": "بتصميم, بعزم (مع تصميم؛ بطريقة مصممة)\nمثال: تشبث بالماضي بتصميم",
 "unshaken": "لَا يَرْتَدِعُ, لَا يَهَابُ (لا يتزعزع في عزمه وهدفه)",
 "unshaped": "نَاقِص التَّشْكِيل (مُشكَّل بصورة ناقصة أو غير تامّة)",
 "unshapely": "غير متناسق, مشوه القوام (ليس متناسقًا أو ممتعًا في الشكل)\nمثال: امرأة بدينة غير متناسقة القوام",
 "unshapen": "نَاقِص التَّشْكِيل (مُشكَّل بصورة ناقصة أو غير تامّة)",
 "unshared": "غير مشترك (غير مشترك مع الآخرين)",
 "unsharpened": "غَيْر مَسْنُون (لَمْ يُشْحَذ أَوْ يُسَنّ)",
 "unshaved": "غير محلوق (لم يتم حلاقته)",
 "unshaven": "غير محلوق (لم يتم حلاقته)",
 "unsheared": "غَيْرُ مَجْزُوز ((يستخدم خاصة عن الفراء أو الصوف) لم يُجَزّ) / غير مجزوز (لم يتم جزه)\nمثال: لحية أشيب غير مجزوزة",
 "unsheathe": "اِسْتَلّ, شَهَرَ",
 "unsheathed": "عارٍ, مسلول (ليس له غطاء واقٍ)\nمثال: كابلات مكشوفة",
 "unshelled": "بلا صدفة, مقشور (للحيوانات أو الفواكه التي ليس لها صدفة)",
 "unshielded": "غَيْر مُدَرَّع ((خاصة عن الآلات) غير محميّ بدرع واقٍ)",
 "unshockable": "غير قابل للصدمة, متفتح الذهن (لا يمكن أن يصاب بالصدمة (يتقبل كل شيء))\nمثال: كان طيب القلب وعاقلاً وغير قابل للصدمة",
 "unshod": "حافٍ, غير محذو (لا يرتدي حذاء) / حافٍ ((يُستخدم لبعض الطوائف الدينية) حفاة الأقدام أو يرتدون الصنادل فقط)\nمثال: رهبان حفاة",
 "unshoed": "حافٍ, غير محذو (لا يرتدي حذاء)",
 "unshorn": "غير مجزوز (لم يتم جزه)\nمثال: لحية أشيب غير مجزوزة",
 "unshrinkable": "غير قابل للانكماش (غير قابل للانكماش أو التقليص)",
 "unshrinking": "ثَابِت, لَا يَتَرَاجَع (لا يتراجع أمام الخطر ولا يرتدع)",
 "unshuttered": "بلا مصاريع (غير مزود بمصاريع أو مصاريعه مفتوحة)\nمثال: نوافذ بلا مصاريع",
 "unsighted": "أعمى, كفيف (غير قادر على الرؤية)\nمثال: الشخص يعتبر أعمى بالقدر الذي يجعله يبتكر تقنيات بديلة للقيام بكفاءة بالأشياء التي كان سيفعلها بالبصر لو كان لديه رؤية طبيعية",
 "unsightliness": "بشاعة, قبح المنظر (قبح غير سار للنظر)",
 "unsightly": "كَرِيه المَنْظَر (غير سار للنظر)",
 "unsigned": "غير موقع (يفتقر إلى التوقيع)\nمثال: الرسالة كانت مطبوعة وغير موقعة",
 "unsilenced": "غير مسكَت (لم يتم إسكاته)",
 "unsimilarity": "تَبَايُن, عَدَم تَشَابُه (صفة عدم التشابه)",
 "unsinkable": "غير قابل للغرق (لا يمكن إغراقه)\nمثال: ظنوا أن التيتانيك غير قابلة للغرق",
 "unsized": "غير مصنف الحجم (غير مصمم بمقاسات) / غير مُعالَج, غير مُغرى (سطحه غير معالج أو مطلي بمادة تحجيم)\nمثال: قفازات غير مصنفة الحجم: مقاس واحد يناسب الجميع",
 "unskilled": "عَدِيم المَهَارَة, غَيْر كُفْء (لا يؤدي العمل بشكل جيد؛ يفتقر إلى الكفاءة) / غَيْر مَاهِر, هَاوٍ (يفتقر إلى المهارة أو الخبرة المهنية) / غير ماهر (لا يمتلك أو يظهر أو يتطلب مهارة خاصة أو كفاءة)\nمثال: غير ماهر في فن البلاغة",
 "unskilled person": "شخص غير ماهر, عامل غير مدرب (شخص يفتقر إلى التدريب الفني)",
 "unskillful": "رَدِيء, مُتَخَبِّط (منفَّذ بشكل سيّئ ورديء)",
 "unskillfulness": "عدم مهارة, نقص الحذق (نقص المهارة المعرفية)",
 "unslaked lime": "أكسيد الكالسيوم, الجير الحي (أكسيد بلوري أبيض يستخدم في إنتاج هيدروكسيد الكالسيوم)",
 "unsleeping": "سَاهِر, يَقِظ تَمَامًا (مستيقظ تماماً وفي كامل اليقظة)",
 "unsloped": "قَائِم, مُنْتَصِب (في وضع عموديّ؛ غير مائل)",
 "unsmiling": "عَبُوس, غَيْر مُبْتَسِم (لا يبتسم)",
 "unsmilingly": "بعبوس, دون ابتسام (دون ابتسامة؛ بطريقة عابسة)\nمثال: استقبل أصهاره بعبوس",
 "unsmooth": "خشن, غير أملس (له سطح غير منتظم)\nمثال: أشجار ذات لحاء خشن",
 "unsmoothed": "غَيْر مُمَلَّس (لم يُجعل أملسَ بتمرير اليد على سطحه)",
 "unsnarled": "مَفْكُوك, مُنْحَلّ (تم فك تشابكه واستقامته)",
 "unsnarling": "تخليص, فك التشابك (عملية التحرير من حالة تشابك أو تعقيد)",
 "unsociability": "انعزالية, نفور اجتماعي (طبع غير اجتماعي؛ تجنب الصداقة أو الرفقة)",
 "unsociable": "انطوائي, غير اجتماعي (لا يميل إلى المجتمع أو الرفقة)\nمثال: طبيعة غير اجتماعية؛ خجول ومتحفظ",
 "unsociableness": "انعزالية, نفور اجتماعي (طبع غير اجتماعي؛ تجنب الصداقة أو الرفقة)",
 "unsociably": "بانعزال, بشكل غير اجتماعي (بطريقة غير اجتماعية)\nمثال: يتصرف الجيران الجدد بانعزال شديد",
 "unsocial": "انعزالي, غير اجتماعي (لا يسعى للاختلاط؛ يعيش بدون رفاق)\nمثال: الميل غير الاجتماعي لإهمال الجيران",
 "unsoiled": "غَيْر مُلَطَّخ, نَقِيّ (خالٍ من الأوساخ والبقع واللطخات)",
 "unsold": "غير مباع (لم يتم بيعه)\nمثال: المنزل معروض في السوق منذ عام تقريباً ولا يزال غير مباع",
 "unsoldierly": "غَيْرُ جُنْدِيّ (لَا يَتَوَافَقُ مَعَ المَعَايِيرِ العَسْكَرِيَّة)",
 "unsolicited": "تَطَوُّعِيّ, غَيْرُ مَطْلُوبٍ (لم يُطلب ولم يُلتمس)",
 "unsoluble": "عَصِيٌّ عَلَى الحَلّ, مُسْتَعْصٍ (ليس سهل الحلّ؛ يصعب التوصّل إلى حلّه)",
 "unsolvability": "استحالة الحل, عدم قابلية الحل (الخاصية (لمشكلة أو صعوبة) التي تجعل من المستحيل حلها)",
 "unsolvable": "عَصِيٌّ عَلَى الحَلّ, مُسْتَعْصٍ (ليس سهل الحلّ؛ يصعب التوصّل إلى حلّه)",
 "unsolved": "عالق, غير محلول (لم يتم حله)\nمثال: العديد من الجرائم تبقى غير محلولة",
 "unsophisticated": "بَسِيطٌ سَاذَج, رِيفِيّ (بَسِيطٌ بِطَرِيقَةٍ فَجَّةٍ وَقَرَوِيّ) / بَسِيط, غَيْر مُعَقَّد (يفتقر إلى التعقيد) / غَيْرُ دُنْيَوِيّ, غَيْرُ مُتَحَضِّر (لا يعرف طرق العالم ولا يملك خبرة فيها)",
 "unsorted": "غَيْر مُصَنَّف (لم يُصنَّف أو يُرتَّب في فئات) / غَيْرُ مُصَنَّفٍ (غير مرتّب وفقًا للحجم)",
 "unsought": "غَيْرُ مَرْغُوب, غَيْرُ مَنْشُود (غير مرغوب فيه ولا مطلوب)",
 "unsound": "غَيْرُ سَلِيم ((عَنِ النَّصِيحَةِ مَثَلًا) لَا يُمْكِنُ الوُثُوقُ بِهِ) / سَقيم, مَعيب (غَيْر سَليم جَسَدِيًّا؛ مُصاب بِعِلَّة) / مَرِيضٌ عَقْلِيًّا, مُضْطَرِبٌ نَفْسِيًّا (يعاني من مرض عقليّ شديد) / غير سليم (مالياً) (غير سليم من الناحية المالية)\nمثال: ممارسات مصرفية غير سليمة",
 "unsoundable": "لَا يُسْبَر غَوْرُه (شَدِيد العُمْق بِحَيْث لَا يُمْكِن تَحْدِيد عُمْقِه)",
 "unsounded": "صَامِت, غَيْر مَنْطُوق (لا يُنطق ولا يُلفظ) / سَحِيق, غَوْر (يَقَعُ فِي عُمْقٍ كَبِيرٍ أَوْ يَمْتَدُّ إِلَيْهِ؛ أَعْمَقُ مِنْ أَنْ يُسْبَرَ)",
 "unsoundness": "اعتلال, خلل (عدم الصحة عقليًا أو جسديًا) / بطلان, فساد (مفهوم خاطئ مغلوط وليس صحيحًا أو صالحًا) / اعتلال, تلف (حالة من التلف أو التحلل)\nمثال: لا يمكن لأحد أن يكون شاعرًا دون قدر معين من الاعتلال العقلي",
 "unsoured": "غير محمض (لم يتحول إلى حالة سيئة)",
 "unsown": "غَيْر مَبْذُور ((عن قطعة أرض) لم تُبذر فيها بذور محاصيل)",
 "unspaced": "غير متباعد, متراص (مرتب دون مسافات فاصلة)",
 "unsparing": "صَارِم, لَا يَرْحَم (عديم الشفقة والرحمة؛ قاسٍ لا يتساهل) / بَاذِخ, مُسْرِف فِي العَطَاء (بالغ السخاء؛ يُعطي بإسراف ودون حساب)",
 "unsparingly": "بحدة بالغة, بشكل لاذع (بطريقة قاسية وناقدة بحدة دون هوادة)\nمثال: انتقدته بشكل لاذع",
 "unspeakable": "لَا يُوصَف, يَفُوق الوَصْف (يتحدى التعبير اللغوي أو الوصف؛ لا تسعه الكلمات) / بَشِع, شَنِيع (سيء أو مُزعج بشكل استثنائي) / جَلَّ عَنِ الوَصْفِ, لَا يُنْطَق (أقدس من أن يُنطَق به أو يُذكَر)",
 "unspeakably": "بشكل لا يوصف, بشكل يعجز عنه الوصف (لدرجة لا يمكن التعبير عنها)\nمثال: بدت صغيرة جداً الليلة، وكعادتها، جميلة بشكل لا يوصف، في فستان بسيط مكشوف الكتفين من القطن الحريري الأخضر والأبيض",
 "unspecialised": "غير متخصص (غير متخصص أو معدل لغرض أو وظيفة معينة)",
 "unspecialized": "غير متخصص (غير متخصص أو معدل لغرض أو وظيفة معينة)",
 "unspecific": "عَرِيض, غَيْر مُفَصَّل (غير مفصل أو دقيق؛ يتناول الخطوط العامة فقط)",
 "unspecified": "غير محدد (غير مذكور بصراحة أو بالتفصيل)\nمثال: هدد بـأعمال انتقامية غير محددة",
 "unspectacular": "عَادِيّ, غَيْر مُبْهِر (لَيْسَ مُثِيرًا لِلإِعْجَاب)",
 "unspent": "غَيْر مُنْفَق ((عن الموارد المالية) لم يُنْفَق بعد)",
 "unspoiled": "سَلِيم, غَيْرُ فَاسِد (لَمْ يَتَحَلَّلْ أَوْ يَتَعَفَّن) / صَالِح, غَيْر فَاسِد (لَمْ يُتْرَك لِيَفْسُد)",
 "unspoilt": "صَالِح, غَيْر فَاسِد (لَمْ يُتْرَك لِيَفْسُد)",
 "unspoken": "بِلَا كَلَام, صَامِت (مُعبَّر عنه دون استخدام الكلام أو الألفاظ) / غَيْر مُعَبَّر عَنْه, مَسْكُوت عَنْه (لم يُصَرَّح به أو يُفْصَح عنه)",
 "unspoken accusation": "اتهام ضمني, اتهام مبطن (اتهام يُفهم دون الحاجة إلى التعبير عنه بالكلمات)",
 "unspoken rule": "قاعدة غير مكتوب",
 "unsporting": "غَشَّاش, مُخَالِف (يَنْتَهِك المَعَايِير أَوِ القَوَاعِد المَقْبُولَة)",
 "unsportingly": "بلا روح رياضية (بطريقة تفتقر للروح الرياضية)",
 "unsportsmanlike": "غَشَّاش, مُخَالِف (يَنْتَهِك المَعَايِير أَوِ القَوَاعِد المَقْبُولَة)",
 "unspotted": "غَيْر مُلَطَّخ, نَقِيّ (خالٍ من الأوساخ والبقع واللطخات)",
 "unstable": "سَائِل, غَيْر ثَابِت (خاضع للتغيّر؛ متبدّل وغير مستقرّ) / غَيْرُ مُسْتَقِرّ, هَشّ (لا يوفّر راحة أو طمأنينة) / شَدِيدُ التَّفَاعُل (تفاعليّ بشكل مرتفع أو عنيف) / مُتَقَلِّبٌ (ميال إلى التقلب النفسي وعدم الثبات)",
 "unstableness": "تَقَلُّب, عَدَم اسْتِقْرَار (الصفة أو الخاصية المتمثلة في كون الشيء غير مستقر ومتردد)",
 "unstaged": "غير مسرحي (لا يُؤدى على المسرح)",
 "unstained": "بِلَا شَائِبَة, نَقِيّ ((للسمعة) خالٍ من الشوائب والعيوب) / غَيْر مُلَطَّخ, نَظِيف (غير ملطخ) / غَيْر مُلَطَّخ, نَقِيّ (خالٍ من الأوساخ والبقع واللطخات) / غَيْرُ مَصْبُوغ, غَيْرُ مُلَمَّع (لَيْسَ عَلَيْهِ طَبَقَةُ صَبْغٍ أَوْ وَرْنِيش)\nمثال: مريلة تبقي ملابسه غير ملطخة",
 "unstarred": "غَيْرُ مُنَجَّم (غير مُعلَّم بعلامة النجمة)",
 "unstated": "غَيْر مُعَبَّر عَنْه, مَسْكُوت عَنْه (لم يُصَرَّح به أو يُفْصَح عنه)",
 "unstatesmanlike": "لا يليق برجل دولة (لا يتسم بصفات رجل الدولة)\nمثال: إجراء لا يليق برجل دولة",
 "unsteadily": "بترنح, بشكل غير مستقر (بطريقة غير ثابتة)\nمثال: مشى مترنحاً نحو المخرج",
 "unsteadiness": "تَزَعْزُع, عَدَم ثَبَات (صفة عدم الثبات والتغير وصعوبة التنبؤ) / تَرَنُّح, عَدَم ثَبَات (صفة كون الشيء غير ثابت أو غير مثبت بإحكام في مكانه)",
 "unsteady": "غَيْر ثَابِت, مُتَزَعْزِع (غَيْر مُسْتَقِرّ أَوْ رَاسِخ فِي مَكَانِه) / غير ثابت, مترنح (عرضة للتغيير أو التباين)\nمثال: مشيتها المترنحة",
 "unsterilised": "غَيْر مُعَقَّم (لم يتمّ تعقيمه)",
 "unsterilized": "غَيْر مُعَقَّم (لم يتمّ تعقيمه)",
 "unstilted": "سَلِس, مُنْسَاب (يتدفق بشكل طبيعي ومتواصل دون تكلّف)",
 "unstimulating": "غير محفز, ممل (لا يثير أو ينشط)",
 "unstinted": "بَاذِخ, مُسْرِف فِي العَطَاء (بالغ السخاء؛ يُعطي بإسراف ودون حساب)",
 "unstinting": "بَاذِخ, مُسْرِف فِي العَطَاء (بالغ السخاء؛ يُعطي بإسراف ودون حساب)",
 "unstintingly": "بسخاء, بلا شح (بطريقة سخية وغير مقترة)",
 "unstirred": "غَيْر مُحَرَّك (لم يُحرَّك بالتقليب أو الخلط)",
 "unstoppable": "جامح, لا يمكن إيقافه (غير قابل للإيقاف)\nمثال: لا يمكن إيقافه كالرياح",
 "unstoppered": "مَنْزُوع السِّدَادَة ((يوصف به وعاء) أُزيلت سدادته)",
 "unstrained": "طَبِيعِيّ, غَيْرُ مُتَكَلَّف (لا ينتج عن جهد مفرط؛ غير مُكرَه) / غَيْرُ مُرْهَق (لَمْ يَتَعَرَّضْ لِضَغْطٍ نَفْسِيّ)",
 "unstratified": "غَيْر طَبَقِيّ (غير مترسب في طبقات)\nمثال: الرواسب الجليدية غير طبقية",
 "unstratified language": "لغة غير طبقية (لغة برمجة يمكن استخدامها (مثل اللغة الطبيعية) كلغة واصفة لنفسها)",
 "unstressed": "غير منبور (لا يحمل نبرة أو شدة)\nمثال: حروف العلة القصيرة غير منبورة",
 "unstructured": "عشوائي, غير مهيكل (يفتقر لهيكل محدد أو تنظيم) / غَيْر مُهَيْكَل, لَا شَكْلِيّ (يفتقر للنظام أو البنية المميزة للأجسام الحية)\nمثال: وضع غير منظم بلا مسؤول",
 "unstrung": "مُتَزَعْزِع, مُنْهَارٌ عَصَبِيًّا (منهار عاطفيًّا ومضطرب نفسيًّا)",
 "unstuck": "حُرّ, مُنْفَكّ (ضد البَرْد) / مُفَكَّك, مُنْهَار (أُلقي في حالة من التفكك أو عدم الترابط)\nمثال: رجل معه بغل حرر سيارتي\nمثال: أنا حر كالطائر.",
 "unstudied": "غَيْرُ مُتَبَحِّر (يفتقر إلى المعرفة المكتسبة بالدراسة غالباً في مجال معيّن) / تلقائي, عفوي (ليس بتصميم أو تصنع؛ غير قسري وارتجالي)\nمثال: جو من الكلام العفوي التلقائي غالباً ما يتم تحقيقه بجهد شاق",
 "unstudious": "غَيْرُ دَؤُوب (لا يميل إلى الدراسة أو المطالعة)",
 "unstylish": "غير مواكب للموضة, قديم الطراز (لا يتفق مع أو لا يتبع الموضة الحالية) / غير أنيق, فاقد للأناقة (يفتقر إلى الأسلوب أو الأناقة)\nمثال: ملابس غير عصرية",
 "unsuasible": "غَيْر قَابِل لِلْإِقْنَاع (لا يستجيب للإقناع)",
 "unsubdivided": "بسيط, غير مقسم ((علم النبات) لأشكال الأوراق؛ الأوراق التي ليس لها انقسامات أو تقسيمات فرعية)",
 "unsubduable": "عَصِيّ, لَا يُرْوَض (مُسْتَحِيلُ الإِخْضَاعِ أَوِ التَّطْوِيعِ)",
 "unsubdued": "غَيْرُ مُخْضَع (لَمْ يُخْضَعْ لِلسَّيْطَرَة)",
 "unsubmissive": "أبي, غير خاضع (غير خانع أو خاضع)",
 "unsubstantial": "غير جوهري, غير مادي (يفتقر إلى الشكل المادي أو المادة؛ غير حقيقي)\nمثال: غير جوهري مثل حلم",
 "unsubstantiated": "غَيْر مُؤَيَّد بِأَدِلَّة, غَيْر مُوَثَّق (غير مدعوم بأدلة أخرى)",
 "unsubtle": "صَرِيح, فَجّ (يفتقر إلى الدقّة والخفاء؛ واضح وسافر)",
 "unsuccessful": "فَاشِل, مُجْهَض (أَخْفَقَ فِي تَحْقِيق النَّتِيجَة المَرْجُوَّة) / غير ناجح, فاشل (غير ناجح؛ فشل أو كانت نتيجته غير مواتية)",
 "unsuccessful person": "خاسِر, فاشِل (شخص لديه سجل من الفشل؛ شخص يخسر باستمرار)",
 "unsuccessfully": "دون نجاح (بدون نجاح)\nمثال: حاولت دون نجاح إقناعه",
 "unsufferable": "فَوْقَ الطَّاقَة, لَا يُحْتَمَل (بالغ الشدة إلى حد لا يُطاق)",
 "unsufferably": "بشكل لا يطاق (إلى درجة لا تحتمل)\nمثال: كان الجو حاراً بشكل لا يطاق في الغرفة",
 "unsugared": "بِلَا سُكَّر (لم يُضَف إليه سكر)",
 "unsuitability": "عَدَم مُلَاءَمَة, عَدَم مُنَاسَبَة (صفة امتلاك خصائص خاطئة لغرض معين)",
 "unsuitable": "غَيْرُ لَائِق, غَيْرُ مَرْغُوب (غير جدير بالاختيار خاصة كشريك زواج) / غَيْرُ مُلَائِم (لَيْسَ مُعَدًّا أَوْ مُكَيَّفًا لِغَرَضٍ مُعَيَّنٍ) / غَيْر مُلَائِم (لا يُساعد على التنشئة الأخلاقية السليمة) / غَيْرُ قَابِلٍ لِلتَّطْبِيقِ (لا يمكن تطبيقه)",
 "unsuitableness": "عَدَم مُلَاءَمَة, عَدَم مُنَاسَبَة (صفة امتلاك خصائص خاطئة لغرض معين)",
 "unsuitably": "بشكل غير لائق, بشكل غير مناسب (بطريقة غير مناسبة)\nمثال: كان يرتدي ملابس غير لائقة",
 "unsuited": "غَيْرُ مُتَوَافِق, مُتَنَافِر (ليس من السهل الجمع بينها بانسجام)",
 "unsullied": "بِلَا شَائِبَة, نَقِيّ ((للسمعة) خالٍ من الشوائب والعيوب) / طَاهِر, نَقِيّ تَمَامًا (بالغ النظافة والنقاء والطهارة)",
 "unsung": "غَيْر مُقَدَّر, مَجْهُول القَدْر (له قيمة لا يُعتَرف بها) / مَجْهُول, مَغْمُور (غير مشهور أو معروف؛ لم يُحتفَ به)",
 "unsung hero": "بطل مجهول",
 "unsupervised": "غير خاضع للإشراف (غير خاضع للإشراف أو المراقبة المستمرة)\nمثال: تحافظ المدرسة على قاعات دراسة غير خاضعة للإشراف خلال فترات الفراغ",
 "unsupportable": "لَا يُمْكِن الدِّفَاع عَنْهُ (لا يمكن دعمه أو تبريره)",
 "unsupported": "غير مدعوم, غير مسنود (غير محمول أو مسنود) / بلا سند, غير مدعوم (غير مستدام أو مُعان بمساعدة غير مادية)\nمثال: إزالة العمود المركزي تركت السقف غير مدعوم",
 "unsupportive": "غير داعم, متخاذل (لا يقدم الدعم أو المساعدة)",
 "unsuppressed": "مُتَنَفَّسٌ عَنْه, مُفْرَغ (تم التعبير عنه والتنفيس عنه)",
 "unsure": "غَيْر وَاثِق, مُتَرَدِّد (يفتقر إلى أو يشير إلى نقص الثقة أو الاطمئنان) / خَجُول, غَيْر وَاثِق (يفتقر إلى الثقة بالنفس)\nمثال: غير واثق من قناعاته",
 "unsurmountable": "غَيْرُ قَابِلٍ لِلتَّسَلُّق, مُسْتَعْصٍ (لَا يُمْكِنُ تَجَاوُزُهُ أَوْ تَسَلُّقُه) / غير قابل للتجاوز, مستعصٍ (غير قابل للتغلب عليه أو تجاوزه)\nمثال: عيوب لا يمكن التغلب عليها",
 "unsurpassable": "لَا يُمْكِن تَجَاوُزُهُ (لا يمكن تخطيه أو التفوق عليه)",
 "unsurpassed": "لَا نَظِير لَهُ, لَا يُضَاهَى (لا يمكن تحسينه أو التفوق عليه)",
 "unsurprised": "غير متفاجئ, غير مندهش (ليس مندهشًا أو لا يبدي اندهاشًا)\nمثال: تلك النظرة العنيدة غير المتفاجئة على وجهه",
 "unsurprising": "غير مفاجئ, متوقع (لا يسبب المفاجأة)",
 "unsusceptibility": "حصانة, عدم قابلية التأثر (حالة عدم القابلية للتأثر)\nمثال: عدم القابلية للتأثر بالصدأ",
 "unsusceptible": "غير سريع التأثر, غير قابل (غير سريع التأثر بـ)",
 "unsuspected": "غير متوقع, غير مشتبه به (غير مشكوك فيه أو لا يُعتقد أنه محتمل)\nمثال: بقي غير مشتبه به كرئيس لشبكة التجسس",
 "unsuspecting": "غَيْر مُتَشَكِّك, غَيْر مُرْتَاب ((غالباً يتبعه 'بـ') لا يعلم ولا يتوقع؛ لا يظن ذلك محتملاً) / سَاذَج, غَيْرُ مُرْتَاب (لا يشك في نوايا الآخرين ولا يرتاب)",
 "unsuspectingly": "بغفلة, دون شك (بدون شكوك)\nمثال: كان يجلس دون شك خلف ذلك الجدار على بعد بضعة ياردات فقط من اللص",
 "unsuspicious": "سَاذَج, غَيْرُ مُرْتَاب (لا يشك في نوايا الآخرين ولا يرتاب)",
 "unswayed": "غَيْر مُتَأَثِّر, غَيْر مُنْقَاد (لم يتأثر أو لم ينقد لتأثير خارجي)",
 "unsweet": "غَيْر مُسْتَسَاغ, مُسْتَكْرَه (بغيض وغير مقبول الطعم أو المذاق المعنوي) / سِيك, مُعْتَدِل الجَفَاف ((للشمبانيا) جاف بشكل معتدل)",
 "unsweetened": "غَيْر مُحَلًّى (لم يُجعل حلو المذاق)",
 "unswept": "غَيْر مَكْنُوس (لم يُكنَس أو يُنظَّف بالمكنسة) / غير مرتد للخلف (غير مرتد للخلف أو ليس له انحناء)\nمثال: طائرة صغيرة مربعة بأجنحة غير مرتدة للخلف",
 "unswerving": "رَاسِخ, صَامِد (ثَابِتٌ وَمَوْثُوقٌ خَاصَّةً فِي الوَلَاءِ) / ثَابِت الِاتِّجَاه, لَا يَحِيد (يَسِير مُبَاشَرَةً مِنْ نُقْطَة إِلَى أُخْرَى بِدُون انْحِرَاف)",
 "unswervingly": "بثبات, دون انحراف (بدون انحراف؛ بطريقة مباشرة وغير منحرفة) / بإخلاص ثابت (بطريقة ثابتة وراسخة)\nمثال: سافرت السفينة بثبات عبر الليل",
 "unsworn": "غير محلوف (غير ملزم أو مُقر بقسم)\nمثال: الشاهد يقف غير محلوف",
 "unsyllabic": "غير مقطعي (لا يشكل مقطعًا أو نواة مقطع؛ يتكون من صوت ساكن مصحوب في نفس المقطع بصوت متحرك أو يتكون من صوت متحرك يهيمن عليه أصوات متحركة أخرى في مقطع)",
 "unsyllabled": "غَيْرُ مُقَطَّع (لا يُنطَق بمقاطع مُفَصَّلة)",
 "unsymbolic": "غير رمزي, غير ممثل (لا ينوب عن شيء آخر)",
 "unsymmetric": "عَدِيم التَّنَاظُر (يفتقر إلى التناظر)",
 "unsymmetrical": "غَيْرُ مُتَمَاثِل, مُتَبَايِنُ القِيَاس (ذو أجزاء غير متماثلة أو أبعاد غير متساوية) / عَدِيم التَّنَاظُر (يفتقر إلى التناظر)",
 "unsymmetrically": "بشكل غير متناظر (بطريقة غير متناظرة)\nمثال: كانت مرتبة بشكل غير متناظر",
 "unsympathetic": "غَيْرُ مُتَعَاطِفٍ, مُنَفِّر (لَا يَتَّفِقُ مَعَ أَذْوَاقِكَ أَوْ تَوَقُّعَاتِكَ) / بِلَا تَعَاطُف, غَيْر وُدِّيّ (يفتقر إلى التعاطف والطيبة) / غَيْرُ مُتَعَاطِفٍ, مُنْغَلِقٌ (ليس منفتح الذهن) / عديم الشفقة, غير متعاطف (غير متعاطف أو غير ميال لـ)\nمثال: بيروقراطية غير متعاطفة",
 "unsympathetically": "دون تعاطف (بدون تعاطف)\nمثال: استمع القاضي للمتهم دون تعاطف",
 "unsympathising": "غَيْر مُتَعَاطِف (لا يُظهر أو يُعبر عن تعاطف)",
 "unsympathizing": "غَيْر مُتَعَاطِف (لا يُظهر أو يُعبر عن تعاطف)",
 "unsynchronised": "غَيْر مُتَزَامِن (لا يحدث في وقت واحد)",
 "unsynchronized": "غَيْر مُتَزَامِن (لا يحدث في وقت واحد)",
 "unsynchronous": "غَيْر مُتَزَامِن (لا يحدث في وقت واحد)",
 "unsystematic": "عشوائي, غير منهجي (يفتقر إلى الترتيب المنهجي أو الطريقة أو التنظيم)\nمثال: سجلات غير منهجية ومجزأة",
 "unsystematically": "بشكل غير منظم, بشكل غير منهجي (بطريقة غير منهجية)\nمثال: كانت كتبه مصطفة بشكل غير منظم على الرف",
 "untactful": "غير لبق, فظ (يفتقر إلى أو يظهر نقصًا فيما هو لائق ومراعٍ في التعامل مع الآخرين)\nمثال: في ظل الظروف، كان من قلة اللباقة سؤالها عن عمرها",
 "untagged": "غير معنون, غير موسوم (يفتقر إلى ملصق أو وسم)\nمثال: الأمتعة غير المعنونة معرضة للضياع",
 "untainted": "بِلَا شَائِبَة, نَقِيّ ((للسمعة) خالٍ من الشوائب والعيوب)",
 "untalented": "عديم الموهبة (خالٍ من الموهبة؛ غير موهوب)",
 "untalkative": "قَلِيل الحَدِيث, مُتَكَتِّم (يميل بطبعه إلى عدم الكلام)",
 "untamed": "وَحْشِيّ, بَرِّيّ",
 "untangled": "غَيْر مُتَشَابِك, مَفْكُوك (غير متشابك)",
 "untangling": "تخليص, فك التشابك (عملية التحرير من حالة تشابك أو تعقيد)",
 "untanned": "غير مدبوغ (لم يتم تحويله إلى جلد بواسطة مادة دباغة)\nمثال: سوط مصنوع من جلد غير مدبوغ",
 "untaped": "غَيْر مُسَجَّل (لَمْ يُسَجَّل عَلى فِيلْم أَوْ شَريط)",
 "untapped": "غَيْر مُسْتَغَلّ (لم يُسْتَخْدَم أو يُسْتَفَد منه بعد) / غير مبزول, غير مستغل (لم يخضع للبزل أو الاستغلال)\nمثال: برميل غير مبزول",
 "untarnished": "بِلَا شَائِبَة, نَقِيّ ((للسمعة) خالٍ من الشوائب والعيوب)",
 "untasted": "غَيْر مَمْسُوس, كَامِل (لَا يَزَالُ مَمْلُوءًا وَلَمْ يُمَسّ)",
 "untaught": "غَيْرُ مُتَمَدْرِس (يفتقر إلى التعليم المدرسي)",
 "untaxed": "غَيْرُ مُضَرَّب, مُعْفًى مِنَ الضَّرِيبَة ((لِلسِّلَعِ أَوِ الأَمْوَالِ) لَا تُفْرَضُ عَلَيْهِ ضَرَائِب)",
 "untechnical": "غير تقني, غير فني (ليس من سمات أو لا يتطلب مهارة في الفنون والعلوم التطبيقية)\nمثال: جوانب غير فنية للوظيفة",
 "untellable": "لَا يُوصَف, يَفُوق الوَصْف (يتحدى التعبير اللغوي أو الوصف؛ لا تسعه الكلمات)",
 "untempered": "جامح, غير مضبوط (غير معتدل أو غير خاضع للسيطرة) / غير مصلد, غير مقسى (لم يتم إيصاله إلى القوام أو الصلابة المناسبة)\nمثال: نزعته الفردية الجامحة",
 "untempting": "غَيْر مُسْتَسَاغ, مُنَفِّر (لا يستهوي الحواس) / غَيْر جَذَّاب, مُنَفِّر (ليس مُغريًا أو جاذبًا)",
 "untenable": "لَا يُحْتَجُّ بِهِ, لَا يُمْكِنُ الدِّفَاعُ عَنْهُ ((عن النظريات وغيرها) لا يمكن الدفاع عنه أو تبريره)",
 "untenanted": "شَاغِر, غَيْرُ مُؤَجَّر (غير مؤجر أو غير مشغول بمستأجر)",
 "untended": "بِلَا عِنَايَة, غَيْر مَرْعِيّ (يَفْتَقِر إِلَى الرِّعَايَة والاهْتِمَام)",
 "untested": "غَيْر مُجَرَّب, غَيْر مُخْتَبَر (لم يُخْتَبَر أو يُجَرَّب بالتجربة العملية) / غَيْر مُجَرَّب, غَيْر مُخْتَبَر (لم يُثبَت أو يُخضَع للاختبار بعد)",
 "untethered": "غَيْر مَرْبُوط (غير محصور أو مقيد بحبل)",
 "unthankful": "جاحد, غير ممتن (لا يشعر أو لا يظهر الامتنان)\nمثال: ورثة جاحدون",
 "unthawed": "غَيْر مُذَاب (لَا يَزَالُ مُتَجَمِّدًا)",
 "untheatrical": "غير مسرحي (غير مناسب لـ أو ليس من خصائص خشبة المسرح أو المسرح)\nمثال: مسرحية مكتوبة جيداً لكنها غير مسرحية (لا تصلح للعرض)",
 "unthematic": "غير موضوعي, لا لحني (غير متعلق بموضوع لحني (في الموسيقى))\nمثال: لا يوجد شيء غير لحني في هذا التأليف",
 "unthinkable": "لَا يَخْطُرُ عَلَى الْبَالِ (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: لا أحب المدرسة.",
 "unthinkably": "بشكل لا يصدق, فوق التصور (إلى حد لا يمكن تخيله)",
 "unthinking": "دون تفكير (بطريقة خالية من التفكير) / خَامِل الذِّهْن (بطيء التفكير وخامل عقليّاً) / غَافِل, لَامُبَالٍ (بلا اكتراث أو اهتمام بالآخرين) / بِلَا تَفْكِير, غَيْرُ مُتَأَمِّل (لَا يُظْهِرُ أَوْ يَتَّسِمُ بِالتَّفْكِيرِ المُتَأَنِّي)\nمثال: حدق دون تفكير في الصورة",
 "unthinkingly": "دون تفكير (بطريقة خالية من التفكير)\nمثال: حدق دون تفكير في الصورة",
 "unthought": "غَيْر مَأْمُول, لَا يَخْطُر عَلَى البَال (بالغ عدم التوقع لدرجة أنه لم يُتَخَيَّل)",
 "unthought-of": "غَيْر مَأْمُول, لَا يَخْطُر عَلَى البَال (بالغ عدم التوقع لدرجة أنه لم يُتَخَيَّل)",
 "unthoughtful": "بِلَا تَفْكِير, غَيْرُ مُتَأَمِّل (لَا يُظْهِرُ أَوْ يَتَّسِمُ بِالتَّفْكِيرِ المُتَأَنِّي)",
 "unthoughtfulness": "طيش, عدم اكتراث (سمة عدم التفكير بعناية قبل التصرف)",
 "unthreatening": "حَسَن القَصْد, غَيْر مُهَدِّد (ليس معادياً ولا يُشكِّل تهديداً)",
 "untidily": "بفوضوية, بقذارة (بطريقة فوضوية وغير مرتبة)\nمثال: بصق روس بتعمد شديد، وبقذارة شديدة، على بطاقة حزب دوريو",
 "untidiness": "عدم ترتيب, فوضى (سمة كون المرء غير مرتب وفوضوي) / عدم ترتيب (حالة كونه غير مرتب)",
 "untidy": "شعث, غير مرتب (غير نظيف وغير منظم)\nمثال: مهملة وغير مرتبة في عاداتها الشخصية",
 "untie": "فَكَّ",
 "untied": "طَلِيق, مَحْلُول القُيُود (غير مُقيَّد بأغلال أو سلاسل) / مَحْلُول الأَرْبِطَة (مع أربطة غير مربوطة) / غَيْر مَرْبُوط, مَحْلُول (غير مربوط)\nمثال: مراهقون يتسكعون بأحذية رياضية محلولة الأربطة",
 "untier": "حَالّ, فَاكّ (شخص يفك أو يفتح شيئاً ما)\nمثال: الأطفال موهوبون في فك أربطة أحذيتهم",
 "until": "حَتَّى (يفيد انتهاء الغاية؛ يفيد الغاية) / حَتَّى, إِلَى أَنْ (يفيد انتهاء الغاية؛ يفيد الغاية)\nمثال: انتظر حتى أجلس.",
 "until further notice": "حتّى إشعار آخر (يفيد انتهاء الغاية؛ يفيد الغاية)\nمثال: انتظر حتى أجلس.",
 "until now": "بعد, حتى الآن (تستخدم في الجمل المنفية لوصف موقف كان قائماً حتى هذه النقطة أو حتى الوقت الحاضر)\nمثال: حتى الآن لم يتصل",
 "until proven otherwise": "حتّى يثبت العكس (يفيد انتهاء الغاية؛ يفيد الغاية)\nمثال: انتظر حتى أجلس.",
 "untilled": "غَيْر مَفْلُوح (لم يُحرث أو يُعزق أو يُمشَّط)",
 "untimbered": "غير خشبي (يفتقر إلى الأخشاب) / عَارٍ مِنَ الأَشْجَارِ (خَالٍ مِنَ الأَشْجَارِ)\nمثال: قارب غير خشبي",
 "untimeliness": "عَدَم مُنَاسَبَة التَّوْقِيت, عَدَم مُوَاتَاة (صفة الحدوث في وقت غير مناسب) / توقيت غير مناسب, عدم مناسبة الوقت (الكون في وقت غير مناسب)",
 "untimely": "قبل الأوان, مبكراً (في وقت مبكر جداً) / سَابِقٌ لِأَوَانِه, مُبْتَسَر (مبكّر بشكل غير مألوف أو قبل الوقت المتوقّع) / سَيِّئ التَّوْقِيت, فِي غَيْر أَوَانِه (ذو توقيت سيئ أو غير ملائم)\nمثال: تحدثت قبل الأوان",
 "untipped": "بلا طرف (غير مزود بطرف خاص)\nمثال: سجائر بدون فلتر (طرف)",
 "untired": "غَيْرُ مُتْعَب, لَا يَكِلّ (ذو طاقة غير منقوصة؛ لم يُصِبْهُ تعب)",
 "untiring": "كَادِح, لَا يَكِلّ (يَتَّصِف بِالعَمَل الشَّاقّ وَالمُثَابَرَة)",
 "untitled": "بِلَا لَقَب, غَيْر نَبِيل (لا ينتمي إلى طبقة النبلاء)",
 "unto": "إِلَى (حرف جر يُفيد الغاية الزمنية؛ حرف جر يُفيد الغاية المكانية)\nمثال: تعال إلى منزلي.",
 "untoasted": "غَيْرُ مُحَمَّص (لَمْ يُحَمَّصْ أَوْ يُعَرَّضْ لِلحَرَارَة)",
 "untold": "لَا يُحْصَى, لَا يُقَدَّر (أكثر من أن يُقاس أو يُحصى)",
 "untoothed": "أَمْلَسُ الحَافَّة, غَيْرُ مُسَنَّن (خالٍ من الشُّقوق أو الأسنان على الحافة)",
 "untouchable": "بَعِيد المَنَال, مُتَعَذَّر الحُصُول عَلَيْه (لا يمكن الحصول عليه أو الوصول إليه) / لَا يُمَسّ, مَنْبُوذ (ينتمي إلى أدنى طبقة في المعتقد الهندوسيّ التقليديّ ويُعَدّ نجساً) / لَا يُمَسّ, مَحْظُور اللَّمْس (ممنوع لمسه أو الاقتراب منه) / لَا يُمَسّ, لَا يُنَال (يَسْتَحِيلُ الاِعْتِدَاءُ عَلَيْه)",
 "untouched": "غَيْر مُتَأَثِّر, غَيْر مُنْقَاد (لم يتأثر أو لم ينقد لتأثير خارجي) / غَيْر مَمْسُوس, كَامِل (لَا يَزَالُ مَمْلُوءًا وَلَمْ يُمَسّ) / جامد المشاعر, غير مبال (غير منفعل عاطفياً) / بكر, غير ملموس (لم يحدث بينه وبين شيء آخر تلامس)\nمثال: بدا دائماً غير متأثر تماماً ورابط الجأش",
 "untoughened": "رقيق, ناعم (غير متصلب جسدياً)\nمثال: أقدام ناعمة",
 "untoward": "سَيِّئ الطَّالِع, مُعَاكِس (مُنَافٍ لِمَصَالِحك أَوْ رَفَاهِيَتِك) / غَيْر لَائِق, مُنَافٍ لِلآدَاب (لا يتوافق مع المعايير المقبولة للسلوك اللائق في المجتمع المهذّب)",
 "untraceable": "لا يمكن تتبعه, مجهول المصدر (يستحيل تتبعه أو تعقبه)\nمثال: مصدر لا يمكن تتبعه",
 "untracked": "بِلَا مَسَالِك, وَعْر (يفتقر إلى الممرّات والطرق المعبَّدة)",
 "untraditional": "غير تقليدي (لا يتوافق مع أو لا ينسجم مع التقاليد)\nمثال: تصاميم غير تقليدية",
 "untrained": "غير مدرب (غير منضبط أو مكيف أو ماهر بسبب التدريب)\nمثال: صوت غير مدرب",
 "untrammeled": "طَلِيق, غَيْر مُقَيَّد (حُرّ مِن القُيود وَالحُدود)",
 "untrammelled": "طَلِيق, غَيْر مُقَيَّد (حُرّ مِن القُيود وَالحُدود)",
 "untransferable": "غَيْر قَابِل لِلتَّحْوِيل (لا يمكن نقله أو تحويله إلى شخص آخر)",
 "untranslatable": "غير قابل للترجمة (غير قادر على التحول إلى شكل أو أسلوب أو لغة أخرى)\nمثال: مصطلح غير قابل للترجمة",
 "untransmutable": "غَيْر قَابِل لِلتَّحْوِيل (لا يمكن تحويله إلى شيء آخر)",
 "untraveled": "غَيْرُ مُسَافِرٍ, قَلِيلُ التَّرْحَالِ (لم يسافر كثيراً خاصة إلى البلاد الأجنبية؛ لم يكتسب خبرة من السفر) / غير مسلوك, غير مطروق (لم يتم السفر عليه أو من خلاله)\nمثال: طرق غير مطروقة",
 "untravelled": "غَيْرُ مُسَافِرٍ, قَلِيلُ التَّرْحَالِ (لم يسافر كثيراً خاصة إلى البلاد الأجنبية؛ لم يكتسب خبرة من السفر) / غير مسلوك, غير مطروق (لم يتم السفر عليه أو من خلاله)\nمثال: طرق غير مطروقة",
 "untraversable": "غَيْرُ قَابِلٍ لِلْعُبُور (لَا يُمْكِنُ عُبُورُهُ أَوِ اجْتِيَازُه)",
 "untraversed": "غير مسلوك, غير مطروق (لم يتم السفر عليه أو من خلاله)\nمثال: طرق غير مطروقة",
 "untreated": "غَيْر مُعَالَج (لم يُعالَج بمادّة كيميائيّة أو فيزيائيّة أو بيولوجيّة) / غير معالج (لم يخضع لمعالجة كيميائية أو فيزيائية) / غير معالج (لم يتلق رعاية أو علاجاً طبياً)\nمثال: نسيج غير معالج",
 "untried": "غَيْر مُجَرَّب, غَيْر مُخْتَبَر (لم يُخْتَبَر أو يُجَرَّب بالتجربة العملية) / غَيْر مُجَرَّب, غَيْر مُخْتَبَر (لم يُثبَت أو يُخضَع للاختبار بعد)",
 "untrimmed": "غير مشذب, غير مقصص (لم يتم تشذيبه)\nمثال: خصلات شعر شعثاء غير مشذبة",
 "untrod": "بِلَا مَسَالِك, وَعْر (يفتقر إلى الممرّات والطرق المعبَّدة)",
 "untrodden": "بِلَا مَسَالِك, وَعْر (يفتقر إلى الممرّات والطرق المعبَّدة)",
 "untroubled": "بِلَا قَلَق, مُطْمَئِنّ (خالٍ من الاضطراب والقلق) / آمن, مرتاح البال (خالٍ من الخوف أو الشك؛ مرتاح البال) / غير مهموم, مرتاح البال (غير مثقل بالمتاعب أو الاضطراب أو الضيق)\nمثال: كان مطمئناً بأنه لن يُحاسب على أي شيء",
 "untroublesomeness": "عَدَم إِزْعَاج, هَدَاوَة (خاصية عدم التسبب في المتاعب أو القلق)",
 "untrue": "خَائِن, غَادِر ((خَاصَّةً عَنِ الأَشْخَاصِ) غَيْرُ مَوْثُوقٍ فِي الوَفَاءِ أَوِ المَحَبَّةِ) / غَيْر مَضْبُوط, مُنْحَرِف (غير مُرَكَّب بدقة؛ غير مستوٍ) / غَيْر وَفِيّ, نَاكِث (غَيْر صَادِق فِي التِزَام أَوْ عَهْد) / غَيْرُ صَحِيح (لا يتوافق مع الحقائق والوقائع)",
 "untruly": "زوراً, كذباً (بطريقة غير حقيقية)\nمثال: أسكت الهمسات التي ربطتها، زوراً وظلماً، بانفصاله عن زوجته",
 "untrustiness": "خيانة, عدم الجدارة بالثقة (سمة عدم استحقاق الثقة أو الاعتماد)",
 "untrusting": "حَذِر, مُتَوَجِّس (كثير الارتياب صراحةً وغير مستعد للثقة بالآخرين)",
 "untrustworthiness": "خيانة, عدم الجدارة بالثقة (سمة عدم استحقاق الثقة أو الاعتماد)",
 "untrustworthy": "غير جدير بالثقة, غير موثوق (لا يستحق الثقة أو التصديق)\nمثال: شخص غير جدير بالثقة",
 "untrusty": "غير جدير بالثقة, غير موثوق (لا يستحق الثقة أو التصديق)\nمثال: شخص غير جدير بالثقة",
 "untruth": "زيف, قول كاذب (بيان كاذب)",
 "untruthful": "كَاذِب",
 "untruthfully": "افتراءً, كذباً (بطريقة كاذبة وغير صادقة)\nمثال: أخبرته، كذباً تماماً، أنني عدت لتوّي من إجازة",
 "untruthfulness": "افتراء, عدم صدق (صفة عدم قول الحقيقة)",
 "untucked": "غير مشبك, غير مطوي (يفتقر إلى الثنيات أو غير مشبك)\nمثال: الملاءة أصبحت غير مشبكة (فلتت)",
 "untufted": "بِلَا خُصَل (غير مزين بخصل أو عُقد)",
 "untuneful": "بلا نغم, نشاز (ليس لديه صوت موسيقي أو نغمة ممتعة)",
 "unturned": "غير مقلوب, في مكانه (لم يتم قلبه)\nمثال: لم يترك حجرًا إلا وقلبه (لم يترك وسيلة إلا جربها)",
 "untutored": "غَيْرُ مُتَمَدْرِس (يفتقر إلى التعليم المدرسي)",
 "untwisted": "غَيْر مَلْوِيّ, مَفْرُود (غير ملتوٍ؛ كان ملتويًا في السابق لكنه الآن مستقيم)",
 "untying": "حل, فك (إرخاء الأربطة التي تثبت شيئاً ما)\nمثال: ربط ربطات العنق فن؛ أما فكها فهو سهل",
 "untypical": "شاذ, غير نمطي (لا يمثل مجموعة أو فئة أو نوعًا)\nمثال: فئة من الطحالب غير النموذجية",
 "untypicality": "لا نمطية (أي حالة ليست نمطية)",
 "untypically": "بشكل غير نموذجي, على غير العادة (بطريقة غير مألوفة أو غير نموذجية)\nمثال: كانت هادئة على غير العادة",
 "ununbium": "أُنُون بِيُوم",
 "ununderstandably": "بشكل غير مفهوم (بطريقة لا يمكن فهمها)\nمثال: تحدث الأجانب بشكل غير مفهوم",
 "ununderstood": "غير مفهوم (غير مفهوم)\nمثال: لا ينبغي أن نخضع بخنوع لدوامات الحروب غير المتوقعة وغير المفهومة",
 "ununennium": "أُونُون إِينْيُوم",
 "ununhexium": "أُنُون هِيكْسِيُوم",
 "ununoctium": "أُنُون أُوكْتِيُوم",
 "ununpentium": "أُنُون بِينْتِيُوم",
 "ununquadium": "أُنُون كُوَادْيُوم",
 "ununseptium": "أُنُون سِيبْتِيُوم",
 "ununtrium": "أُنُون تْرِيُّوم",
 "unusable": "غَيْرُ صَالِحٍ لِلاِسْتِخْدَام (غَيْرُ قَابِلٍ لِلاِسْتِخْدَام)",
 "unuseable": "غَيْرُ صَالِحٍ لِلاِسْتِخْدَام (غَيْرُ قَابِلٍ لِلاِسْتِخْدَام)",
 "unused": "عَاطِل, غَيْر مُسْتَخْدَم (ليس قيد الاستخدام الفعليّ) / جَدِيد, غَيْر مُسْتَعْمَل (نظيف لأنّه لم يُستخدَم من قبل) / غَيْر مُسْتَخْدَم (لم يُوضَع قيد الاستعمال بعد)",
 "unusefulness": "عَدَم جَدْوَى, لَا نَفْع (صفة عدم وجود فائدة عملية)",
 "unusual": "غَيْر مَأْلُوف (لا يُصادف عادة) / استثنائي, غير عادي (غير معتاد أو غير شائع أو غير عادي) / شاذ, عجيب (خارج عن المألوف وغير متوقع بشكل قاطع؛ غريب قليلاً أو حتى شاذ)\nمثال: مشهد ذو جمال غير عادي",
 "unusual person": "شخص استثنائي, شخص غير مألوف (شخص يختلف عن المعتاد أو الطبيعي)",
 "unusually": "بشكل غير عادي, بشكل لافت (لدرجة أو مدى ملحوظ)\nمثال: كانت طويلة بشكل غير عادي",
 "unusualness": "شُذُوذ عَن المَأْلُوف, غَرَابَة (الندرة بحكم كون الشيء غير معتاد)",
 "unutterable": "صَعْبُ اللَّفْظ, مُسْتَعْصٍ عَلَى النُّطْق (يصعب نطقه بشكل صحيح جدًّا) / لَا يُوصَف, يَفُوق الوَصْف (يتحدى التعبير اللغوي أو الوصف؛ لا تسعه الكلمات) / جَلَّ عَنِ الوَصْفِ, لَا يُنْطَق (أقدس من أن يُنطَق به أو يُذكَر)",
 "unutterably": "بشكل لا يوصف, بشكل يعجز عنه الوصف (لدرجة لا يمكن التعبير عنها)\nمثال: بدت صغيرة جداً الليلة، وكعادتها، جميلة بشكل لا يوصف، في فستان بسيط مكشوف الكتفين من القطن الحريري الأخضر والأبيض",
 "unuttered": "غَيْر مُعَبَّر عَنْه, مَسْكُوت عَنْه (لم يُصَرَّح به أو يُفْصَح عنه)",
 "unvaccinated": "غَيْر مُطَعَّم, غَيْر مُلَقَّح (لم يتلقَّ التطعيم)",
 "unvalued": "غَيْر مُقَدَّر, مَجْهُول القَدْر (له قيمة لا يُعتَرف بها)",
 "unvaned": "بِلَا رِيش ((عَنِ السَّهْم) غَيْر مُزَوَّد بِالرِّيش)",
 "unvanquishable": "لَا يُغْلَب, لَا يُقْهَر (لَا يُمْكِنُ هَزِيمَتُهُ أَوْ إِخْضَاعُهُ)",
 "unvanquished": "غَيْرُ مَغْلُوب, لَمْ يُقْهَر (لَمْ يُغْلَبْ أَوْ يُقْهَر)",
 "unvaried": "رتيب, غير متنوع (يفتقر إلى التنوع)",
 "unvariedness": "عَدَم تَنَوُّع, وَتِيرَة وَاحِدَة (يتميز بغياب التنوع)",
 "unvarnished": "بِلَا رَتْوَشَة, عَلَى حَقِيقَتِه (خَالٍ مِنْ أَيّ مُحَاوَلَة لِلتَّلْطِيف أَوِ الإِخْفَاء) / غَيْرُ مَصْبُوغ, غَيْرُ مُلَمَّع (لَيْسَ عَلَيْهِ طَبَقَةُ صَبْغٍ أَوْ وَرْنِيش)",
 "unvarying": "متجانس, متماثل (هو نفسه دائماً؛ يظهر شكلاً أو طابعاً واحداً في جميع الحالات) / ثَابِت, لَا يَتَغَيَّر (لَا يَتَبَدَّلُ فِي طَبِيعَتِه) / رتيب, غير متنوع (يفتقر إلى التنوع)\nمثال: شارع من مباني بيضاء طويلة موحدة",
 "unveiled": "سافر, غير محتجب (تم كشفه؛ خاصة بإزالة الحجاب)\nمثال: جيل جديد من النساء السافرات في إيران",
 "unveiling": "إطلاق, تدشين (فعل البدء بشيء جديد) / كشف النقاب (العرض لأول مرة)\nمثال: تطلعوا إلى الظهور الأول لخط إنتاجهم الجديد",
 "unvendible": "غَيْرُ صَالِحٍ لِلبَيْع (لا يصلح للعرض في السوق أو البيع)",
 "unvented": "بِلَا فَتَحَاتِ تَهْوِيَة (غَيْرُ مُزَوَّدٍ بِفَتَحَاتِ تَهْوِيَة)",
 "unventilated": "سيء التهوية, مكتوم (غير مهوى)\nمثال: غرف خانقة سيئة التهوية",
 "unverbalised": "غَيْر مُعَبَّر عَنْه, مَسْكُوت عَنْه (لم يُصَرَّح به أو يُفْصَح عنه)",
 "unverbalized": "غَيْر مُعَبَّر عَنْه, مَسْكُوت عَنْه (لم يُصَرَّح به أو يُفْصَح عنه)",
 "unverifiable": "غَيْر قَابِل لِلتَّحَقُّق, غَيْر مَوْضُوعِيّ ((كالأدلة مثلاً) ليس موضوعياً أو سهل التحقّق منه)",
 "unverified": "غَيْرُ مُتَحَقَّقٍ مِنْهُ (يفتقر إلى الدليل أو الإثبات)",
 "unversed": "غَيْر مُتَمَرِّس, قَلِيل المُمَارَسَة (لم يحظَ بممارسة واسعة)",
 "unvigilant": "غَافِل, غَيْر يَقِظ (غير متنبه لما هو خطير محتمل)",
 "unvindictive": "غَيْرُ حَقُود (لَا يَسْعَى إِلَى الِانْتِقَامِ)",
 "unvitrified": "غَيْر مُزَجَّج ((عن الخزف) يفتقر إلى طبقة زجاجية لامعة)",
 "unvoiced": "غَيْر مُعَبَّر عَنْه, مَسْكُوت عَنْه (لم يُصَرَّح به أو يُفْصَح عنه) / مهموس (يُنتج دون اهتزاز الحبال الصوتية)\nمثال: الحروف الساكنة المهموسة مثل 'ب' و 'ك' و 'س'",
 "unvoluntary": "قسري, لا إرادي (غير خاضع لسيطرة الإرادة)\nمثال: قتل غير عمد (لا إرادي)",
 "unvulcanised": "غَيْرُ مُفَلْكَنٍ ((للمطاط) لم يخضع لعملية الفلكنة)",
 "unvulcanized": "غَيْرُ مُفَلْكَنٍ ((للمطاط) لم يخضع لعملية الفلكنة)",
 "unwanted": "غير مرغوب فيه, مكروه (غير مطلوب أو غير مراد) / غير مرغوب فيه, غير مطلوب (غير مطلوب؛ غير محتاج إليه)\nمثال: شوائب غير مرغوب فيها في الصلب",
 "unwantedly": "بشكل غير مرغوب فيه (بطريقة غير مرغوب فيها)\nمثال: كان ودوداً بشكل غير مرغوب فيه",
 "unwarily": "بِدُون حَذَر, بِغَفْلَة (دون انتباه أو اتخاذ تدابير الحيطة)",
 "unwariness": "غفلة (سمة عدم الحذر والترقب)",
 "unwarmed": "غَيْر مُدَفَّأ, غَيْر مُسَخَّن (لم يتمّ تسخينه أو تدفئته)",
 "unwarrantable": "غَيْرُ مُبَرَّر, لَا يُسَوَّغ (غَيْرُ قَابِلٍ لِلتَّبْرِيرِ أَوِ التَّفْسِير)",
 "unwarrantably": "بشكل غير مسوغ, بلا مبرر (بطريقة غير مبررة أو إلى درجة غير مسوغة)\nمثال: في هذه اللوحة، علاقة الجزء العلوي من الجسم بالسفلي غير مريحة ويبدو الفخذ الأيمن مضغوطاً بلا مبرر",
 "unwarranted": "غَيْرُ مُبَرَّر, لَا يُسَوَّغ (غَيْرُ قَابِلٍ لِلتَّبْرِيرِ أَوِ التَّفْسِير) / غَيْرُ مُبَرَّرٍ, غَيْرُ مُسَوَّغٍ (يفتقر إلى التبرير أو التفويض) / لَا أَسَاس لَه, وَاهٍ (بدون أساس في العقل أو الواقع)",
 "unwary": "غَافِل, غَيْر حَذِر (غير منتبه للخطر أو الخداع)\nمثال: صرخات الحيوانات الغافلة التي أخذت على حين غرة",
 "unwashable": "غَيْر قَابِل غَسِيل, غَيْر قَابِلَة غَسِيلَة (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "unwashed": "غَيْر مَغْسُول (لم يُنظَّف بالماء والصابون) / شَعْبِيّ, عَامِّيّ (مرتبط بعامة الناس أو ينتمي إليهم)",
 "unwatchful": "غَافِل, غَيْر يَقِظ (غير متنبه لما هو خطير محتمل)",
 "unwatered": "بَعْلِيّ",
 "unwavering": "رَاسِخ, صَارِم",
 "unwaveringly": "بإصرار, بثبات (بتصميم حازم)\nمثال: صدقنا ذلك بحزم",
 "unwaxed": "غير مشمع (غير مشمع)\nمثال: الأرضية غير المشمعة",
 "unweaned": "رضيع, غير مفطوم\nمثال: بعض الأطفال يبقون غير مفطومين حتى عيد ميلادهم الثاني أو الثالث",
 "unwearable": "غير قابل للارتداء (غير مناسب للارتداء أو لا يمكن ارتداؤه)\nمثال: أحذية مهترئة لدرجة أنها غير قابلة للارتداء",
 "unwearied": "غَيْرُ مُتْعَب, لَا يَكِلّ (ذو طاقة غير منقوصة؛ لم يُصِبْهُ تعب)",
 "unweary": "غَيْرُ مُتْعَب, لَا يَكِلّ (ذو طاقة غير منقوصة؛ لم يُصِبْهُ تعب)",
 "unwearying": "دَائِبٌ بِلَا هَوَادَة, لَا يَكِلّ (يُظهِر نشاطاً متواصلاً بحيوية لا تفتر)",
 "unweathered": "غَيْرُ مُتَجَوٍّ (غَيْرُ مُتَآكِلٍ بِفِعْلِ العَوَامِلِ الجَوِّيَّةِ)",
 "unwebbed": "غير مكفف ((لأقدام بعض الحيوانات) غير مكففة)\nمثال: ضفدع بدائي بأصابع غير مكففة",
 "unwed": "غَيْرُ مُتَزَوِّج (لم يسبق له الزواج)",
 "unwedded": "غَيْرُ مُتَزَوِّج (لم يسبق له الزواج)",
 "unwelcome": "غَيْرُ مُرَحَّب بِه (غير مرحَّب به ولا مُتمنَّى) / غير مرحب به, غير مرغوب فيه (غير مرحب به؛ لا يعطي متعة أو لا يتم استقباله بمتعة)\nمثال: دعاية غير مرحب بها",
 "unwelcome guest": "ضيف غير مدعو, طفيلي (شخص يدخل (إلى حفل) دون دعوة أو دون دفع رسوم الدخول)",
 "unwelcome person": "شَخْص غَيْر مَرْغُوب فِيه (شخص غير مرغوب فيه أو غير مُرحَّب به لسبب ما)",
 "unwell": "عَلِيل, مُتَوَعِّك (يعاني من وعكة صحّيّة خفيفة أو معرَّض للمرض)",
 "unwellness": "داء, سقم (ضعف في الوظائف الفسيولوجية الطبيعية يؤثر على جزء من الكائن الحي أو كله)",
 "unwholesome": "ضار, غير صحي (ضار بالرفاهية الجسدية أو الأخلاقية)\nمثال: طعام غير صحي",
 "unwholesomeness": "إِمْرَاض, فَسَاد (صفة كون الشيء غير صحي وضاراً بشكل عام)",
 "unwieldiness": "ثقل, صعوبة التعامل (مشكلة في الحمل أو الإدارة بسبب الحجم أو الشكل) / استعصاء, صعوبة القيادة (صفة الصعوبة في التوجيه أو التحكم بسبب التعقيد)\nمثال: لعن الحمالون ثقل البيانو الكبير",
 "unwieldy": "أَخْرَق, ثَقِيل الحَرَكَة (يفتقر إلى الرشاقة في الحركة أو الوقفة) / صَعْب التَّعَامُل, مُرْهِق (صعب العمل به أو التحكم فيه) / ثقيل, صعب الاستخدام (صعب الاستخدام أو التعامل معه أو إدارته بسبب الحجم أو الوزن أو الشكل)\nمثال: بدأنا في جر الهيكل غير العملي إلى الملجأ",
 "unwilled": "بِلَا إِرَادَة, غَيْرُ مَقْصُود (بِدُونِ إِرَادَةٍ أَوْ رَغْبَةٍ أَوْ نِيَّةٍ مُتَعَمَّدَة)",
 "unwilling": "رَغْمَ الإِرَادَة, كَارِه (بِالرَّغْمِ مِنَ الإِرَادَةِ المُعَاكِسَة) / غير راغب, ممانع (غير ميال ويرفض القيام بشيء ما)\nمثال: غير راغب في مواجهة الحقائق",
 "unwillingly": "دُونَ رَغْبَة, عَلَى مَضَض (بطريقة غير راغبة)\nمثال: لقد أخطأ بحقها كرهاً",
 "unwillingness": "عدم الرغبة, عزوف (سمة كون المرء غير راغب)\nمثال: رفض عدم رغبته في التعاون كل اقتراح قدمته",
 "unwise": "غَيْر حَكِيم, غَيْر مُنَاسِب (لا يلائم الغرض المطلوب) / طَائِش, غَيْر حَكِيم (يدلّ على افتقار إلى الحُكم السليم والحكمة أو ينتج عنه)",
 "unwisely": "بحماقة, بغباء (دون حس سليم أو حكم جيد)\nمثال: تصرف بحماقة عندما وافق على المجيء",
 "unwiseness": "حماقة (سمة التصرف بغباء أو تهور)",
 "unwished": "غَيْرُ مُرَحَّب بِه (غير مرحَّب به ولا مُتمنَّى)",
 "unwished-for": "غَيْرُ مُرَحَّب بِه (غير مرحَّب به ولا مُتمنَّى)",
 "unwitting": "غَافِل, غَيْر مُتَعَمَّد (غير مدرك أو عارف) / جَاهِل, غَافِل (غير واعٍ بسبب نقص المعلومات أو المعرفة ذات الصلة) / غَيْرُ مَقْصُود, غَيْرُ مُخَطَّط (لم يُفعَل عن قصد أو نية)\nمثال: موضوع غافل في تجربة",
 "unwittingly": "دُونَ قَصْد, عَنْ غَيْر عَمْد (بدون معرفة أو نية)\nمثال: حذف المراجع دون قصد",
 "unwomanly": "غير نسوي (غير نسوي)\nمثال: الوضوح المنطقي لحججها؛ حكم عليها بأنها غريبة الأطوار وغير نسوية",
 "unwonted": "غَيْر مُعْتَاد (غير معتاد أو غير مألوف)",
 "unwontedly": "على غير عادة (بطريقة غير معتادة)",
 "unwooded": "أجرد, غير مشجر (غير مشجر)",
 "unworkable": "غَيْر عَمَلِيّ, غَيْر قَابِل لِلتَّطْبِيق (لا يمكن تنفيذه أو وضعه موضع التطبيق)",
 "unworkmanlike": "رَدِيءُ الصَّنْعَة, غَيْرُ مُتْقَن (لا يليق بعامل ماهر؛ يفتقر إلى الإتقان)",
 "unworldly": "غَيْرُ دُنْيَوِيّ, غَيْرُ مُتَحَضِّر (لا يعرف طرق العالم ولا يملك خبرة فيها) / زاهد, غير دنيوي (غير معني بالعالم الدنيوي أو لا يتأثر بالاعتبارات الدنيوية)\nمثال: كان زاهداً ولم يفتقد المكافآت الدنيوية كثيراً",
 "unworried": "بِلَا قَلَق, خَالٍ مِنَ الهُمُوم (خالٍ من المتاعب والقلق والهموم)",
 "unworthily": "بغير استحقاق, بوضاعة (بطريقة غير جديرة بالتقدير)",
 "unworthiness": "عَدَم جَدَارَة, عَدَم مُلَاءَمَة (صفة كون الشيء غير مناسب أو غير لائق بشكل خاص) / عدم استحقاق, عدم جدارة (حالة الافتقار إلى الجدارة أو القيمة)\nمثال: لم يتراجع عن أي شيء قاله بخصوص عدم ملاءمة",
 "unworthy": "حَقِير, دَنِيء (مستنكَر أخلاقياً؛ يستحق الاحتقار) / غير جدير, لا يستحق (يفتقر إلى القيمة أو الاستحقاق) / غَيْرُ مُسْتَحِقٍّ (لَا يَسْتَحِقُّ التَّقْدِيرَ أَوِ المُكَافَأَةَ)\nمثال: طرد طالب يعتبر سلوكه غير جدير",
 "unwounded": "غَيْرُ مُصَاب (لم يُجرَح أو يُصَب)",
 "unwoven": "غير منسوج (غير منسوج)\nمثال: قماش التابا هو قماش غير منسوج مصنوع بدق اللحاء إلى ورقة رقيقة",
 "unwrapped": "غير مغلف, مكشوف (لم يُغلف بعد أو أزيل غلافه)\nمثال: واجهت كومة جبلية من الهدايا التي لا تزال غير مغلفة",
 "unwrinkled": "أملس, غير مجعد (غير مجعد أو مكرمش)",
 "unwritten": "تِلْقَائِيّ, مُرْتَجَل (يُقال أو يُفعل دون تخطيط أو كتابة مسبقة) / شَفَهِيّ, غَيْرُ مَكْتُوب (يستخدم الكلام بدلًا من الكتابة) / عرفي, غير مدون (قائم على العرف بدلاً من التوثيق)\nمثال: قانون عرفي",
 "unwritten law": "قانون عرفي, قانون غير مكتوب (قانون قائم على السلوك العرفي)",
 "unyielding": "عَنِيد, لا يَلِين (لا يَتَراخى ولا يَنْثَنِي تَحْت الضَّغْط) / عَنُود, مُثَابِر (ثابت بإصرار لا يلين ولا يتراجع)",
 "unyieldingness": "تعنت, صلابة (الحزم بحكم كونه غير مرن ولا يلين)",
 "up": "فَوْقَ, فَوْق / لِأَعْلَى",
 "up and down": "ذهاباً وإياباً, صعوداً وهبوطاً (التحرك للخلف وللأمام على طول مسار معين) / صُعُودًا وَهُبُوطًا, مِنْ أَعْلَى إلى أَسْفَل (بالتبادل بين الاتجاهين العلوي والسفلي)\nمثال: مشى ذهاباً وإياباً في غرفة تبديل الملابس",
 "up here": "هُنَا (في منطقة أو مكان محدد)\nمثال: لا يجب أن تكون هنا",
 "up in the air": "فِي مَهَبّ الرِّيح, مُعَلَّق (شديد الغموض وعدم اليقين) / لَمْ يُحْسَم بَعْد, مُعَلَّق (لم يُحدَّد أو يُبَتّ فيه بعد)",
 "up quark": "كُوَارْك عُلْوِيّ",
 "up the stairs": "أعلى الدرج, في الطابق العلوي (في طابق أعلى)\nمثال: عاشوا في الطابق العلوي",
 "up to": "مُنْكَبّ عَلَى (مَشْغُول أَوْ مُنْهَمِك بِشَيْءٍ مَا)",
 "up to date": "مُحَدَّث, مُوَاكِب (يعكس أحدث المعلومات أو التغييرات) / مُتَطَوِّر, مُوَاكِب لِلعَصْر (مُتَوَافِق مَعَ أَحْدَث الأَفْكَار أَوِ الأَنْمَاط العَصْرِيَّة)",
 "up to her neck": "غَارِقٌ حَتَّى أُذُنَيْه (مُنْخَرِطٌ بِعُمْقٍ شَدِيدٍ فِي أَمْرٍ مَا)",
 "up to his neck": "غَارِقٌ حَتَّى أُذُنَيْه (مُنْخَرِطٌ بِعُمْقٍ شَدِيدٍ فِي أَمْرٍ مَا)",
 "up to my neck": "غَارِقٌ حَتَّى أُذُنَيْه (مُنْخَرِطٌ بِعُمْقٍ شَدِيدٍ فِي أَمْرٍ مَا)",
 "up to now": "بعد, حتى الآن (تستخدم في الجمل المنفية لوصف موقف كان قائماً حتى هذه النقطة أو حتى الوقت الحاضر) / حتى الآن (قبل الوقت الحاضر)\nمثال: حتى الآن لم يتصل",
 "up to our necks": "غَارِقٌ حَتَّى أُذُنَيْه (مُنْخَرِطٌ بِعُمْقٍ شَدِيدٍ فِي أَمْرٍ مَا)",
 "up to their necks": "غَارِقٌ حَتَّى أُذُنَيْه (مُنْخَرِطٌ بِعُمْقٍ شَدِيدٍ فِي أَمْرٍ مَا)",
 "up to your neck": "غَارِقٌ حَتَّى أُذُنَيْه (مُنْخَرِطٌ بِعُمْقٍ شَدِيدٍ فِي أَمْرٍ مَا)",
 "up-and-coming": "مُجْتَهِد, نَشِيط (يعمل بجدّ لتعزيز مشروع أو مؤسّسة)",
 "up-bow": "سحبة قوس لأعلى (ضربة لأعلى من طرف القوس إلى كعبه)",
 "up-country": "في المناطق الداخلية, نحو الداخل (إلى أو في المناطق الداخلية لبلد أو منطقة)\nمثال: يعيشون في المناطق الداخلية",
 "up-tick": "ارتفاع طفيف, زيادة طفيفة (زيادة صغيرة)\nمثال: الارتفاع الطفيف في النشاط الإرهابي",
 "up-to-date": "حتى الآن, عصري (يفيد انتهاء الغاية؛ يفيد الغاية)\nمثال: انتظر حتى أجلس.",
 "up-to-dateness": "حالية, رواج (خاصية الانتماء إلى الوقت الحاضر)\nمثال: رواج مصطلح عامي",
 "up-to-the-minute": "آخِرُ مَا صَدَرَ, أَحْدَث (مواكب للحاضر المباشر؛ الأكثر حداثة)",
 "upbeat": "مُبْتَهِج, مُتَفَائِل بِسَذَاجَة (متفائل بشكل لطيف وربما غير واقعي) / نبرة صاعدة, نقر ضعيف (نقر غير مشدد (خاصة النقر الأخير في المقياس)) / رفاهية, سعادة (حالة قناعة وسعادة وصحة وازدهار)\nمثال: كانت المدينة أخيراً في حالة تحسن (رفاهية) بعد مشاكلنا الأخيرة",
 "upbound": "مُتَّجِهٌ لِلْأَعْلَى (يَسِيرُ فِي اتِّجَاهٍ يُعْتَبَرُ تَقْلِيدِيًّا صُعُودًا)",
 "upbraider": "مؤنب, موبخ (شخص يجد الخطأ أو يلقي اللوم)",
 "upbraiding": "تَقْرِيع شَدِيد, تَوْبِيخ لَاذِع (توبيخ شديد وقاسٍ)",
 "upbringing": "تَرْبِيَة",
 "upcast": "عمود تهوية صاعد (ممر هوائي يتكون من عمود تهوية يخرج من خلاله الهواء من المنجم)",
 "upcoming": "قَادِم, مُقْبِل (فِي المُسْتَقْبَلِ القَرِيبِ نِسْبِيًّا)",
 "upcountry": "جَوْفِيّ, دَاخِلِيّ (من وسط المنطقة أو البلاد أو قادم منه) / في المناطق الداخلية, نحو الداخل (إلى أو في المناطق الداخلية لبلد أو منطقة)\nمثال: يعيشون في المناطق الداخلية",
 "upcurved": "مُنْحَنٍ لِلْأَعْلَى (ينحني أو يتقوس نحو الأعلى)",
 "update": "تحديث (حَدَّث الشّخصُ:روى حديث الرّسول -صلّى الله عليه وسلّم-،حدّثه الشّخصُ:أخبره وتكلّم إليه،حدّثه قلبه:أعلمه،أحسّ مسبقاً بشيء،حدّث الشيء:جعله حديثاً،جدّده؛ حدّث بالنّعمة:أشاعها وشكر عليها)\nمثال: تم تحديث القاموس.",
 "updating": "تحديث (عملية تغيير شيء ما لجعله محدثاً (عادة بإضافة شيء ما))\nمثال: السجلات الجنائية تحتاج إلى تحديث منتظم",
 "updraft": "تيار صاعد (تيار هوائي صاعد قوي)",
 "upended": "مَقْلُوب رَأْساً (قُلِب على طرفه العلويّ)",
 "upending": "قلب, نكْس (القلب رأساً على عقب؛ الوضع على النهاية)",
 "upfield": "نَحْوَ مَلْعَبِ الخَصْم (بَعِيدًا عَنْ طَرَفِ المَلْعَبِ الخَاصِّ بِالفَرِيقِ المُدَافِع)",
 "upfront": "صَرِيح, مَكْشُوف (صَادِق وَمُنْفَتِح)",
 "upgrade": "تَرْقِيَة",
 "upheaval": "اِضْطِرَاب",
 "uphill": "صعوداً, نحو القمة (إلى الأعلى على تل أو منحدر) / بشق الأنفس, بصعوبة (ضد الصعوبات) / طَالِع, مُنْحَدِرٌ صُعُودًا (مَائِلٌ نَحْوَ الأَعْلَى) / صعود التل (المنحدر الصاعد للتل)\nمثال: يقع هذا الشارع صعوداً",
 "uphold": "رَفَعَ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ) / سَنَدَ ((سَنَدَ )إِليه يَسْنُدُ سُنُودًا: رَكَنَ إِليه، واعتمد عليه واتكأَ؛ (سَنَدَ) ذَنَبُ الناقة:، خَطَرَ فضربَ قَطاتَها يَمْنَةً ويَسْرَةً) / دَعَمَ (• دَعَمَهُ، كمنَعهُ: مالَ فأقامَهُ)\nمثال: رفع سامي نظارته.",
 "upholder": "مؤيد, مناصر (شخص يؤيد أو يحافظ على)\nمثال: مؤيدون حازمون للتقاليد",
 "upholster": "مُنَجِّد",
 "upholsterer": "مُنَجِّد",
 "upholstering": "تَنجِيد",
 "upholstery": "تَنجِيد",
 "upholstery material": "قماش تنجيد (القماش المستخدم في التنجيد)",
 "upholstery needle": "إبرة تنجيد (أي من عدة إبر خياطة ثقيلة ومنحنية أحياناً يستخدمها المنجدون)",
 "upkeep": "صيانة, عناية (نشاط يتضمن الحفاظ على شيء في حالة عمل جيدة) / إعاشة, صيانة (فعل الحفاظ على الحياة بالطعام أو توفير وسائل العيش)\nمثال: ألف دليل العناية بالسيارة",
 "upland": "جبلي, مرتفع (تستخدم للبلاد المرتفعة أو التلال) / أرض مرتفعة (أرض مرتفعة (مثل الجبال))",
 "upland cotton": "قطن المرتفعات, قطن مشعر (نبات أمريكي استوائي أصلي يُزرع الآن في الولايات المتحدة وينتج قطناً قصير التيلة)",
 "upland plover": "طيطوي المرتفعات (طيطوي كبير يشبه الزقزاق يعيش في حقول ومرتفعات أمريكا الشمالية)",
 "upland sandpiper": "طيطوي المرتفعات (طيطوي كبير يشبه الزقزاق يعيش في حقول ومرتفعات أمريكا الشمالية)",
 "upland white aster": "أستر المرتفعات الأبيض (نبات معمر صلب معنقد في أمريكا الشمالية بعناقيد فضفاضة من الزهور البيضاء)",
 "uplift": "حمالة صدر رافعة (حمالة صدر ترفع وتدعم الثديين) / رفع, نهوض تكتوني ((جيولوجيا) ارتفاع الأرض إلى مستوى أعلى (كما في عملية بناء الجبال))",
 "uplifted": "مُتَسَامٍ, مُرْتَفِعُ المَعْنَوِيَّات (فِي حَالَةِ سُمُوٍّ عَاطِفِيٍّ خَاصَّةً بِالفَخْر)",
 "uplifting": "ارتفاع, انقشاع (ارتفاع شيء ما)\nمثال: كشف انقشاع السحب عن زرقة سماء الصيف",
 "uplifting trance": "أبليفتنغ ترانس, ترانس حماسي (نوع فرعي كبير من موسيقى الترانس، سمي بذلك للشعور الذي يدعي المستمعون الحصول عليه (يوصف غالباً بـ 'الاندفاع'))",
 "uplink": "إرسال صاعد, وصلة صاعدة (إرسال من الأرض إلى مركبة فضائية أو مسار مثل هذا الإرسال)",
 "upload": "حَمّل (رَفَعَ، أَقَلَّ) / تَحْمٍيْل\nمثال: حمل سامي سلاحه.",
 "upmarket": "راقي, فاخر (مصمم للمستهلكين ذوي الدخل المرتفع)\nمثال: ظهر بملابس أنيقة؛ وقبعات فاخرة",
 "upmost": "الأَعْلَى, فِي أَقْصَى القِمَّة (في القمة أو أقرب ما يكون إليها)",
 "upper": "أَعْلَى, عُلْيَا (اسم تفضيل من عَلَا/ علا في؛ أكثر ارتفاعًا، عكْسه أسفل سقط من أعلى المبنى) / عُلْوِيّ, فَوْقَانِيّ\nمثال: خذها إلى الأعلى.",
