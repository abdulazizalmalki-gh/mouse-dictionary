 "vaccinated": "مُلَقَّح",
 "vaccinating": "تطعيم, تلقيح (فعل الحماية من المرض عن طريق إدخال لقاح في الجسم للحث على المناعة)\nمثال: فحص الأطباء المجندين لكن الممرضات قمن بالتطعيم",
 "vaccination": "تَطْعِيم, تَلْقِيح (زرع غصن من نوع من الشجر على غصن من نوع آخر، مثلا زرع غصن من البرتقال في شجرة ليمون لتكون النتيجة أن شجرة الليمون تنتج ليمونا وبرتقالا؛ علاج طبي يستهدف إلى منع الأمراض التي تتسبب من الجراثيم أو الفيروسات. استخدام حديث)",
 "vaccinator": "مُلقح (ممارس طبي يلقح الناس ضد الأمراض)",
 "vaccine": "لَقَاح",
 "vaccinee": "مُطَعَّم, مُلَقَّح (مريض تم تطعيمه (تلقيحه))",
 "vaccinia": "جدري البقر (مرض فيروسي يصيب الماشية يسبب مرضاً جلدياً خفيفاً يؤثر على الضرع؛ كان يستخدم سابقًا لتلقيح البشر ضد الجدري) / جدري البقر, وقس (عدوى موضعية يتم تحفيزها في البشر عن طريق التلقيح بالفيروس المسبب لجدري البقر من أجل منح المقاومة ضد الجدري)",
 "vaccinia gangrenosa": "وقس متفاقم (شكل حاد أو قاتل من الوقس يحدث بشكل رئيسي عند الأشخاص الذين يعانون من نقص مناعي)",
 "vaccinium angustifolium": "توت أزرق منخفض (شجيرة متساقطة الأوراق منخفضة النمو من شمال شرق أمريكا الشمالية لها زهور في عناقيد مدمجة وتحمل توتاً أزرق داكناً حلواً)",
 "vaccinium arboreum": "عنب الأحراش الشجري (شجيرة أو شجرة صغيرة من شرق الولايات المتحدة لها توت أسود غير صالح للأكل)",
 "vaccinium ashei": "توت عين الأرنب (شجيرة من جنوب شرق الولايات المتحدة تُزرع تجارياً خاصة لصناعة التعليب)",
 "vaccinium caespitosum": "توت أزرق قزم (شجيرة متساقطة الأوراق متكتلة منخفضة النمو من شمال وألب أمريكا الشمالية لها زهور وردية إلى حمراء مرجانية يتبعها توت أزرق حلو)",
 "vaccinium corymbosum": "توت أزرق عالي الشجيرة (شجيرة متساقطة الأوراق عالية النمو من شرق أمريكا الشمالية تحمل توتاً مائلاً للزرقة إلى السواد صالحاً للأكل مع طبقة شمعية مميزة؛ مصدر لمعظم التوت…)",
 "vaccinium macrocarpon": "توت بري أمريكي, كرانبيري كبير (نبات زاحف ذو ثمار حمراء)",
 "vaccinium membranaceum": "عنب الجبل (توت أزرق قائم من غرب الولايات المتحدة له زهور منفردة وتوت حامض نوعاً ما)",
 "vaccinium myrsinites": "توت أزرق دائم الخضرة (شجيرة من شرق الولايات المتحدة لها أوراق دائمة الخضرة لامعة وثمار زرقاء مسودة)",
 "vaccinium myrtillus": "توت أزرق أوروبي, عنب الأحراش (توت أزرق أوروبي قائم له زهور منفردة وتوت أزرق مسود)",
 "vaccinium ovatum": "عنب الأحراش دائم الخضرة (شجيرة كثيفة صلبة دائمة الخضرة من غرب أمريكا الشمالية لها توت أسود حامض وأوراق خضراء لامعة تستخدم في تنسيق الزهور)",
 "vaccinium oxycoccus": "توت بري أوروبي, كرانبيري صغير (توت بري زاحف ذو ثمار حمراء صغيرة من المناطق القطبية والباردة في نصف الكرة الشمالي)",
 "vaccinium pallidum": "توت الأراضي الجافة (شجيرة منخفضة متساقطة الأوراق من شرق الولايات المتحدة تحمل توتاً أزرق داكناً حلواً)",
 "vaccinium pennsylvanicum": "توت أزرق منخفض (شجيرة متساقطة الأوراق منخفضة النمو من شمال شرق أمريكا الشمالية لها زهور في عناقيد مدمجة وتحمل توتاً أزرق داكناً حلواً)",
 "vaccinium scoparium": "توت الطيهوج (شجيرة من شمال غرب أمريكا الشمالية تحمل توتاً أحمر)",
 "vaccinium stamineum": "توت الغزلان (توت أزرق متفرع صغير شائع في المناطق المستنقعية بشرق الولايات المتحدة له توت مخضر أو مصفر غير مستساغ يقال إن الغزلان تأكله)",
 "vaccinium uliginosum alpinum": "عنب المستنقعات (شجيرة دائمة الخضرة بأوراق جلدية)",
 "vaccinium vitis-idaea": "توت البقر, توت الجبل الأحمر (شجيرة منخفضة دائمة الخضرة من المناطق المعتدلة الشمالية العالية في أوروبا وآسيا وأمريكا تحمل توتاً أحمر صالحاً للأكل)",
 "vaccinum": "طعم, لقاح (مولد مناعة يتكون من معلق لخلايا مسببة للأمراض ميتة أو ضعيفة يتم حقنها لتحفيز إنتاج الأجسام المضادة)",
 "vacillant": "مُتَذَبْذِبٌ, مُتَرَدِّدٌ (غير ثابت في الغرض أو الفعل)",
 "vacillate": "تَذَبْذَبَ",
 "vacillating": "مُتَذَبْذِبٌ, مُتَرَدِّدٌ (غير ثابت في الغرض أو الفعل)",
 "vacillation": "تأرجح (تغيير الموقع عن طريق التحرك ذهاباً وإياباً) / تردد, تريث (تردد في الكلام أو العمل)",
 "vacillator": "متردد (من يتردد (عادة بدافع الخوف))",
 "vacuity": "فَرَاغ / فَرَاغ, حَيِّز",
 "vacuolate": "فجوي, متفج (متشكل أو محتوٍ على فجوات (تجاويف صغيرة) داخل الخلية)",
 "vacuolated": "فجوي, متفج (متشكل أو محتوٍ على فجوات (تجاويف صغيرة) داخل الخلية)",
 "vacuolation": "تشكل فجوات, تفجي (حالة الامتلاء بالفجوات)",
 "vacuole": "فجوة (تجويف صغير مملوء بالسائل في سيتوبلازم الخلية)",
 "vacuolisation": "تشكل فجوات, تفجي (حالة الامتلاء بالفجوات)",
 "vacuolization": "تشكل فجوات, تفجي (حالة الامتلاء بالفجوات)",
 "vacuous": "فَارِغ",
 "vacuously": "ببلادة, بخواء (بطريقة فارغة العقل)",
 "vacuousness": "خلو البال, فراغ ذهني (مؤشر على أو متسم بالفراغ العقلي وغياب الأفكار)\nمثال: فراغ تعابير وجهها كذّب مشاعرها",
 "vacuum": "خَلَاء, فَرَاغ (المكان الخالي من الناس، غالبا ما يقصد به الأماكن غير المزروعة والتي تركت طبيعية؛ المِرْحَاض، الغرفة التي تقضى فيها الحاجة)\nمثال: حبب إليه الخلاء.",
 "vacuum aspiration": "شفط فراغي, كشط بالشفط (طريقة للإجهاض المستحث؛ قبل الأسبوع الرابع عشر من الحمل يتم إزالة الجنين والمشيمة عن طريق تطبيق الشفط على عنق الرحم المتوسع)",
 "vacuum bag": "كيس الغبار, كيس المكنسة (كيس يتم شفط الأوساخ إليه بواسطة المكنسة الكهربائية)",
 "vacuum bomb": "قنبلة حرارية ضغطية, قنبلة فراغية (قنبلة تستخدم متفجرات الوقود والهواء)\nمثال: يمكن للقنبلة الفراغية أن تخلق ضغوطاً زائدة تعادل القنبلة الذرية",
 "vacuum bottle": "ترمس, قارورة مفرغة (قارورة بجدران مزدوجة مفصولة بتفريغ هوائي؛ تستخدم للحفاظ على حرارة المواد)",
 "vacuum chamber": "حُجْرَة فَرَاغِيَة (الغُرْفَة أو القَاعَة. تطلق على القَبْر والحَضِيرَة من باب التشبيه؛ ما يشبه الغرفة من الأرض، المكان المحمي أو المحاط بما يجعله شبيها بالمنعى الأول. استخدام مجازي وقديم)\nمثال: قعدنا في وسط الحجرة.",
 "vacuum cleaner": "مِكْنَسَة كَهْرَبَائِيَّة",
 "vacuum flask": "ترمس, قارورة مفرغة (قارورة بجدران مزدوجة مفصولة بتفريغ هوائي؛ تستخدم للحفاظ على حرارة المواد)",
 "vacuum gage": "مقياس الفراغ (مقياس للإشارة إلى الضغط الجوي السلبي)",
 "vacuum gauge": "مقياس الفراغ (مقياس للإشارة إلى الضغط الجوي السلبي)",
 "vacuum pump": "مضخة تفريغ, مضخة هواء (مضخة تحرك الهواء داخل أو خارج شيء ما)",
 "vacuum tube": "أنبوب إلكتروني, صمام مفرغ (جهاز إلكتروني يتكون من نظام من الأقطاب الكهربائية مرتبة في غلاف زجاجي أو معدني مفرغ)",
 "vade mecum": "كتاب تعليمي (موضع تعليم الكتابة. الاستخدام الأصلي؛ مدرسة شبه رسمية لتعليم الأطفال الكِتَابَة والقِرَاءَة ومباديء الحِسَاب وبعض القُرَآن…)\nمثال: هذا الكتاب جديد",
 "vaduz": "فَادُوز",
 "vagabond": "تَائِه, مُتَشَرِّد (يتنقّل باستمرار خاصّة من مسكن أو عمل لآخر) / صُعْلُوك, مُقْتَلَع الجُذُور (يتشرّد بلا هدف ودون روابط بمكان أو مجتمع) / جسم تائه, شارد (أي شيء يشبه المتشرد في عدم وجود مكان ثابت له) / متشرد, هائم (متجول ليس لديه إقامة ثابتة أو وسيلة عيش ظاهرة)\nمثال: كانت سفن القراصنة شوارد البحر",
 "vagabondage": "تجوال, هيام (السفر دون وجهة واضحة)\nمثال: تبعته في ترحاله واعتنت به",
 "vagal": "مبهمي (متعلق بالعصب المبهم)",
 "vagary": "تقلب, نـزوة (تغير غير متوقع وغير قابل للتفسير في شيء ما (في موقف أو سلوك شخص، وما إلى ذلك))\nمثال: تقلبات الطقس",
 "vagile": "مُتَجَوِّل, مُتَحَرِّك (لديه حرية التحرك)\nمثال: حيوانات مائية متحركة",
 "vagina": "مَهْبَل / مَهْبِل / فَرْج / ڤاچاينا",
 "vaginal": "مهبليّ",
 "vaginal artery": "شريان مهبلي (فرع من الشريان الحرقفي الباطن يوفر الدم للمهبل وقاعدة المثانة والمستقيم)",
 "vaginal birth": "وضع, ولادة (عملية الولادة عند البشر؛ إنجاب طفل)",
 "vaginal discharge": "إفراز مهبلي (إفرازات من غدد عنق الرحم للمهبل؛ عادة ما تكون صافية أو بيضاء)",
 "vaginal smear": "مَسْحَة مَهْبِلِيَّة (مسحة مأخوذة من الغشاء المخاطي المهبلي للتحليل الخلوي)",
 "vaginismus": "تشنج المهبل (انقباض عضلي يسبب انغلاق المهبل؛ عادة ما يكون رد فعل قلق قبل الجماع أو فحص الحوض)",
 "vaginitis": "التهاب المهبل (التهاب المهبل (يرتبط عادة بداء المبيضات))",
 "vaginocele": "قيلة مهبلية (فتق يبرز في المهبل)",
 "vaginoscope": "منظار المهبل, منظار عنق الرحم (أداة تنظير تكبر ظهارة المهبل وعنق الرحم في الجسم الحي للسماح بالمراقبة والدراسة المباشرة لهذه الأنسجة)\nمثال: يستخدم منظار المهبل المتخصص المجهز بكاميرا في فحص وجمع الأدلة لضحايا الاغتصاب والاعتداء الجنسي",
 "vagrancy": "تسكع, تشرد (حالة التجوال من مكان إلى آخر؛ عدم وجود منزل دائم أو وسيلة للعيش)",
 "vagrant": "تَائِه, مُتَشَرِّد (يتنقّل باستمرار خاصّة من مسكن أو عمل لآخر) / متشرد, هائم (متجول ليس لديه إقامة ثابتة أو وسيلة عيش ظاهرة)",
 "vague": "غَامِض, مُبْهَم (غير واضح التعبير أو المعنى) / غامض, غير محدد (غير محدود أو مقرر أو مميز بدقة) / بَاهِت, خَافِت (يَفْتَقِر إِلَى الوُضُوح أَوِ التَّمَيُّز)\nمثال: مصطلح غير محدد (مبهم)",
 "vaguely": "بِشَكْل مُبْهَم, بِغُمُوض (بطريقة غامضة)\nمثال: بدا مألوفاً بشكل غامض",
 "vagueness": "إِبْهَام (الإِصْبَعُ الغليظةُ الخامسةُ من أَصابع اليد والرِّجل، وهي ذات سُلامَيَيْن (مؤنثة وقد تذكَّر) والجمع: أباهيم، وإبهامات)",
 "vagus": "عصب قحفي عاشر, عصب مبهم (عصب مختلط يغذي البلعوم والحنجرة والرئتين والقلب والمريء والمعدة ومعظم الأحشاء البطنية)",
 "vagus nerve": "عَصَب مُبْهَم",
 "vain": "سُدًى, عَبَثِيّ (لا يؤدّي إلى نجاح أو نتيجة مرجوّة) / مَغْرُور, مُعْجَب بِنَفْسِه (يتّسم بكبرياء زائف؛ لديه شعور مبالَغ فيه بأهمية الذات)",
 "vainglorious": "مَزْهُوّ بِنَفْسِه, مُتَعَاظِم (يشعر بأهمية ذاتية مبالَغ فيها)",
 "vainglory": "تباهي, تفاخر (غرور صريح)",
 "vainly": "دون جدوى, عبثاً (بلا فائدة)\nمثال: بحث عنها عبثاً",
 "vaisakha": "فايساخا (الشهر الثاني من التقويم الهندوسي)",
 "vaishnava": "فيشنوي (عابد لفيشنو)",
 "vaishnavism": "فيشنوية (عبادة فيشنو أحد الآلهة الرئيسية الثلاثة في البانثيون الهندوسي) / الفيشنوية (طائفة هندوسية تعبد فيشنو)",
 "vaisnavism": "فيشنوية (عبادة فيشنو أحد الآلهة الرئيسية الثلاثة في البانثيون الهندوسي) / الفيشنوية (طائفة هندوسية تعبد فيشنو)",
 "vaisya": "فايشيا (ثالث الطبقات الأربع: عامة الناس أو المزارعين أو التجار والفئات المهنية) / فايشيا (عضو في الطبقة التجارية والمهنية الهندوسية؛ الثالثة من بين الطبقات الأربع الرئيسية)",
 "vajra": "فاجرا (صاعقة إندرا)",
 "valance": "ستارة, كورنيش (هيكل زخرفي لإخفاء تركيبات الستائر في الجزء العلوي من غلاف النافذة)",
 "valance board": "ستارة, كورنيش (هيكل زخرفي لإخفاء تركيبات الستائر في الجزء العلوي من غلاف النافذة)",
 "valdecoxib": "بيكسترا, فالديكوكسيب (مثبط كوكس-2 (الاسم التجاري بيكسترا) يخفف الألم والالتهاب دون الإضرار بالجهاز الهضمي)",
 "vale": "وادي (منخفض طويل في سطح الأرض يحتوي عادة على نهر)",
 "vale of tears": "وادِي دُمُوعٍ",
 "valediction": "توديع, كلمة الوداع (فعل قول الوداع) / كلمة وداع (خطبة وداع (خاصة التي تلقى أثناء حفلات التخرج من قبل عضو متميز في الفصل المتخرج))",
 "valedictorian": "طالب الخطاب الوداعي (الطالب صاحب أفضل الدرجات الذي يلقي عادة خطاب الوداع في حفل التخرج)",
 "valedictory": "وَدَاعِيّ (يتعلّق بخطاب التوديع أو الوداع) / توديعي, وداعي (متعلق بمناسبة أو تعبير عن الوداع) / كلمة وداع (خطبة وداع (خاصة التي تلقى أثناء حفلات التخرج من قبل عضو متميز في الفصل المتخرج))\nمثال: خطاب توديعي",
 "valedictory address": "كلمة وداع (خطبة وداع (خاصة التي تلقى أثناء حفلات التخرج من قبل عضو متميز في الفصل المتخرج))",
 "valedictory oration": "كلمة وداع (خطبة وداع (خاصة التي تلقى أثناء حفلات التخرج من قبل عضو متميز في الفصل المتخرج))",
 "valedictory speaker": "طالب الخطاب الوداعي (الطالب صاحب أفضل الدرجات الذي يلقي عادة خطاب الوداع في حفل التخرج)",
 "valence": "تكافؤ / تَعَلُّق",
 "valence electron": "إِلِكْتْرُون التَّكَافُؤ (إلكترون في الغلاف الخارجي للذرة يمكنه الاتحاد مع ذرات أخرى لتكوين جزيئات)",
 "valencia": "فَالِنْسِيَا, بَلِنْسِيَة",
 "valencia orange": "برتقال فالنسيا (مجموعة متنوعة من البرتقال الحلو تزرع على نطاق واسع في فلوريدا وكاليفورنيا)",
 "valencian community": "منطقة بلنسية (المِنْطَقةُ: المَنْطِقَةُ؛ مِنْطَقَةُ: مُقَاطَعَةٌ)\nمثال: غزة منطقة مكشوفة.",
 "valencian country": "بلد بلنسية (فَتَرَ طبعه من المحاسن العَقْلِيَّة؛ ضد فَطُنَ؛ قل ذَكَاءه وانْتِبَاهه؛ ضد ذَكا)\nمثال: الصين بلد عظيم.",
 "valenciennes": "دانتيل فالنسيان (نوع من دانتيل البكرة بنقوش زهرية)",
 "valenciennes lace": "دانتيل فالنسيان (نوع من دانتيل البكرة بنقوش زهرية)",
 "valency": "تكافؤ ((في الكيمياء) خاصية للذرات أو الجذور؛ قدرتها على الاتحاد معطاة بدلالة عدد ذرات الهيدروجين (أو ما يعادلها)) / تكافؤ حيوي, قدرة تفاعلية ((في الأحياء) القدرة النسبية على الاتحاد أو التفاعل كما هو الحال مع المستضدات أو الركيزة البيولوجية) / تكافؤ (ظاهرة تشكيل الروابط الكيميائية)",
 "valent": "تكافؤي ((كيمياء) ذو تكافؤ؛ تستخدم عادة في التركيبات)",
