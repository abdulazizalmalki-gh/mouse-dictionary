 "volumetrically": "حجمياً (فيما يتعلق بالحجم)\nمثال: تم تحليله حجمياً",
 "voluminosity": "امتلاء, ضخامة الحجم (عِظَم الحجم)",
 "voluminous": "ضَخْم, غَزِير (كبير في العدد أو الكمّ، خاصّة في الكلام أو الكتابة) / حَجِيم, ضَخْم الحَجْم (كبير في الحجم أو الكتلة) / مُتَعَرِّج, مُلْتَوٍ (يتميز بمنعطفات وانحناءات متكررة)",
 "voluminously": "بإسهاب, بضخامة (بطريقة ضخمة أو مسهبة)",
 "voluminousness": "امتلاء, ضخامة الحجم (عِظَم الحجم)",
 "voluntarily": "بِإِرَادَتِه, طَوَاعِيَة (بمحض إرادته الحرة)\nمثال: خضع طواعية لأخذ البصمات",
 "voluntary": "إرادي, تطوعي (بمحض إرادتك أو تصميمك؛ تم بالاختيار؛ غير مجبر أو مكره) / إرادي (يتم التحكم فيه بواسطة الإرادة الفردية) / عزف حر, مقطوعة تطوعية (تأليف (غالباً ما يكون مرتجلاً) لآلة منفردة (خاصة الأرغن) وليس جزءاً منتظماً من الخدمة الدينية أو الأداء الموسيقي) / متطوع, متطوع عسكري ((عسكرياً) شخص يتطوع بحرية للخدمة)\nمثال: الإنسان فاعل مختار",
 "voluntary muscle": "عضلة إرادية (عضلة مخططة يمكن التحكم فيها إرادياً)",
 "volunteer": "مُتَطَوِّع, مُتَطَوِّعَة / مُتَطَوِّع",
 "voluptuary": "أَبِيقُورِيّ, مُتَرَفّ (يعرض الترف ويُمتِّع الحواسّ) / منغمس في الملذات (شخص مدمن على الرفاهية وملذات الحواس)",
 "voluptuous": "أَبِيقُورِيّ, مُتَرَفّ (يعرض الترف ويُمتِّع الحواسّ) / فَاتِن, مُغْرٍ جِنْسِيًّا (ذو جاذبية جنسية قوية) / ذَات قَوَام مُنْحَنٍ, مُمْتَلِئَة ((عن جسد المرأة) ذات صدر كبير وانحناءات جذّابة)",
 "voluptuously": "بترف حسي, بشهوانية (بطريقة تتسم بالانغماس في الملذات الحسية) / بأنوثة طاغية, بفتنة (بطريقة حسية وجذابة)\nمثال: استنشق العطر بشهوانية",
 "voluptuousness": "امتلاء الجسم, تناسق القوام (صفة امتلاك جسم ممتلئ وجذاب) / ترف, رغد (خاصية كون الشيء غزيراً ووفيراً وممتعاً للحواس) / إثارة, جاذبية طاغية (صفة الجاذبية والإثارة (خاصة الإثارة الجنسية))\nمثال: كان يعتقد أنها مثيرة للغاية",
 "volute": "حَلَزُونِيّ, لَوْلَبِيّ (على شكل لفائف حلزونية) / لفة, لولب (هيكل يتكون من شيء ملفوف في سلسلة متصلة من الحلقات) / زخرفة حلزونية (زخرفة تتكون من منحنى على مستوى يلتف حول مركز بمسافة متزايدة من المركز)\nمثال: لفة من الحبل",
 "volute spring": "زنبرك حلزوني, نابض لولبي (نابض على شكل ملف)",
 "voluted": "حَلَزُونِيّ, لَوْلَبِيّ (على شكل لفائف حلزونية)",
 "volution": "التفاف, دوران (حركة دحرجة أو دوران)",
 "volva": "غمد الفطر (هيكل يشبه الكوب حول قاعدة ساق بعض الفطريات)",
 "volvaria bombycina": "فولفاريا بومبيسينا (طفيلي على أشجار مختلفة)",
 "volvariella bombycina": "فولفاريلا بومبيسينا (فطر بقبعة ليفية جافة مصفرة إلى بيضاء)",
 "volvariella volvacea": "فطر القش, فطر صيني (فطر صغير صالح للأكل استوائي وشبه استوائي له قبعة بيضاء وساق طويل؛ طعام شهي باهظ الثمن في الصين ودول آسيوية أخرى حيث يزرع تجارياً)",
 "volvelle": "مخطط عجلة (مخطط انزلاقي دائري يحتوي على أجزاء دوارة)",
 "volvo": "فُولْفُو, ڤُولْڤُو",
 "volvulus": "انفتال (التواء غير طبيعي للأمعاء (عادة في منطقة اللفائفي أو القولون السيني) مما يؤدي إلى انسداد معوي)",
 "vomer": "عظم الميكعة, ميكعة (عظم شبه منحرف رقيق للجمجمة يشكل الأجزاء الخلفية والسفلية من الحاجز الأنفي)",
 "vomit": "تَقَيَّأَ, قَاءَ / تَقَيُّؤ",
 "vomiter": "مُتَقَيِّئ (شخص يتقيأ)",
 "vomiting": "قَيْءُ, اِسْتِفْرَاغ",
 "vomitive": "دواء مقيئ, مقيئ (دواء يحفز الغثيان والقيء)",
 "vomitory": "مدخل الملعب, منفذ المدرج (مدخل إلى مدرج أو ملعب رياضي)",
 "vomitus": "قيء (المادة التي يتم إخراجها عند التقيؤ)",
 "von blucher": "بلوشر, جبهارد فون بلوشر (جنرال بروسي يذكر لقيادته في الحروب ضد نابليون (1742-1819))",
 "von neumann machine": "آلة فون نيومان (أي حاسوب رقمي يدمج أفكار البرامج المخزنة والعدادات المتسلسلة التي اقترحها فون نيومان وزملاؤه في عام 1946)",
 "von recklinghausen's disease": "ورم ليفي عصبي (مرض وراثي سائد يتميز بالعديد من الأورام الليفية العصبية وبقع على الجلد وغالباً تشوهات في النمو)",
 "von willebrand's disease": "مرض فون ويليبراند (شكل من أشكال الهيموفيليا اكتشفه إريك فون ويليبراند؛ وهو اضطراب وراثي ينتقل كصفة جسدية متنحية؛ يتميز بنقص في عامل التخثر ونزيف الغشاء المخاطي)",
 "voodoo": "تميمة سحرية, سحر (تميمة يُعتقد بخرافة أنها تجسد قوى سحرية) / فودو (طائفة دينية تمارس بشكل رئيسي في دول الكاريبي (خاصة هايتي)؛ تنطوي على السحر وآلهة أرواحية) / الفودو ((هايتي) أتباع ديانة تتضمن السحر والآلهة الروحانية)",
 "voodooism": "فودو (طائفة دينية تمارس بشكل رئيسي في دول الكاريبي (خاصة هايتي)؛ تنطوي على السحر وآلهة أرواحية)",
 "voracious": "قِرْشَبّ, أَكُول (الرجل المسن الضخم العظيم الخلق؛ السيد الشريف الذي له هيبة ووقار)",
 "voraciously": "بشراهة, بنهم (بطريقة شرهة بلهفة)\nمثال: تقرأ بنهم",
 "voraciousness": "جشع, طمع (رغبة مفرطة في الثروة (عادة بكميات كبيرة)) / نهم شديد (شراهة مفرطة) / شراهة, نهم (رغبة مفرطة في الأكل)\nمثال: جشع المحامين",
 "voracity": "نهم شديد (شراهة مفرطة) / شراهة, نهم (رغبة مفرطة في الأكل)",
 "vorarlberg": "فُورَارَلْبَرْغ",
 "voronezh": "فُورُونِيج",
 "vortex": "دردور, دوامة مائية (تيار دائري قوي من الماء (عادة نتيجة لتعارض المد والجزر)) / تلفيف, دوامة (شكل شيء يدور بسرعة)",
 "vortex vein": "وريد دوامي (وريد يتكون من فروع من السطح الخلفي للعين والجسم الهدبي؛ يصب في الأوردة العينية)",
 "vorticella": "جرسية, فورتيسيلا (أي من أوالي مختلفة لها جسم شفاف يشبه الكأس مع ساق قابل للانكماش)",
 "vorticose vein": "وريد دوامي (وريد يتكون من فروع من السطح الخلفي للعين والجسم الهدبي؛ يصب في الأوردة العينية)",
 "votary": "عابِد, مُكَرَّس (نصير مخلص (بشكل ديني تقريباً) لقضية أو شخص أو نشاط) / متعبد, نذير (كاهن أو كاهنة (أو عابد مكرس) في ديانة أو طائفة غير مسيحية) / ناذر (شخص ملزم بنذور لدين أو حياة عبادة أو خدمة)\nمثال: النذير المثقف للعلم",
 "vote": "تَصْوِيت, اِقْتِرَاع / صَوَّتَ (أكثر من إحداث الصوت؛ بالغ في إحداث الصوت؛ في : صاح نوحا أو استغاثة)\nمثال: اقرأ بصوت عالي.",
 "vote counter": "عداد, فارز الأصوات (مسؤول معين لعد الأصوات (خاصة في الجمعية التشريعية))",
 "vote of confidence": "تصويت بالثقة, منح الثقة (تعبير عن الموافقة والتشجيع)\nمثال: أعطوا الرئيس تصويتاً بالثقة",
 "voteless": "محروم من الحقوق, مسلوب الحقوق (محروم من حقوق المواطنة وخاصة حق التصويت)\nمثال: كان العمال مسلوبي الصوت (الحقوق)",
 "voter": "مُصَوِّت, نَاخِب",
 "voter turnout": "أصوات المقترعين, نسبة المشاركة (العدد الإجمالي للناخبين الذين شاركوا)\nمثال: يتوقعون عددًا كبيرًا من الأصوات",
 "voting": "تَصْوِيت",
 "voting age": "سن الانتخاب, سن التصويت (السن الذي يكون فيه الشخص كبيراً بما يكفي للتصويت في الانتخابات العامة)",
 "voting booth": "كابينة التصويت (كشك يمكن للشخص فيه الإدلاء بصوت خاص)",
 "voting machine": "آلة تصويت (جهاز ميكانيكي لتسجيل وعد الأصوات آلياً)",
 "voting precinct": "دائرة انتخابية, منطقة اقتراع (واحدة من عدة مناطق تُقسَّم إليها المدينة أو البلدة من أجل التصويت؛ وتحتوي كل منها على مركز اقتراع واحد)",
 "voting right": "حق التصويت (الحق في التصويت؛ وخاصة حق المساهم العادي في التصويت شخصيًا أو بالوكالة في شؤون الشركة)",
 "voting stock": "أسهم تصويت (أسهم في شركة تمنح المساهم حقوق التصويت والوكالة)",
 "voting system": "نظام التصويت, نظام انتخابي (نظام قانوني لاتخاذ خيارات ديمقراطية)",
 "voting trust": "ائتمان التصويت (اتفاقية يحتفظ فيها الأشخاص الذين يملكون أسهماً تتمتع بصلاحيات التصويت بالملكية مع نقل حقوق التصويت إلى الأمناء)",
 "votive": "نَذْرِيّ (مُكَرَّسٌ وَفَاءً لِنَذْرٍ)",
 "votyak": "الأودمورتية (اللغة الفينية التي يتحدث بها الفوتياك) / أودمورتي, فوتياك (عضو في الشعب الناطق باللغات الفنلندية الأوغرية الذي يعيش في شرق روسيا الأوروبية)",
 "votyak language": "الأودمورتية (اللغة الفينية التي يتحدث بها الفوتياك)",
 "vouchee": "الضامن المستدعى ((قانون) شخص يُستدعى إلى المحكمة للدفاع عن سند ملكية)",
 "voucher": "قَسِيمَة",
 "vouge": "فأس فوج (نوع من الرماح (الفؤوس) كان يستخدمه المشاة في القرن الرابع عشر)",
 "voussoir": "حجر العقد, صنجة (كتلة بناء حجرية إسفينية الشكل تستخدم في بناء القوس أو القبو)",
 "vouvray": "فوفراي (نبيذ فرنسي أبيض جاف (إما ساكن أو فوار) مصنوع في وادي اللوار)",
 "vow": "نَذْر / نَذَرَ",
 "vowel": "صَائِت, مُصَوِّت / حَرَكَة, حَرْفُ مَدّ / حَرَّكَ (غَيَّرَ مَوْضِعَهُ أو مَكَانَهُ أو حَالَه؛ حَرُكَ الوَلَدُ : تَحَرَّكَ، أَوْ خَرَجَ عَنْ سُكُونِهِ)\nمثال: لقد أوقفنا حركة المرور.",
 "vowel harmony": "اِنْسِجَام مُصَوَّتٍ, تَوَافُق صَوْتِيّ",
 "vowel point": "حركة, نقطة الحركة (علامة توضع أسفل أو بالقرب من حرف ساكن (كما في العبرية أو العربية) للإشارة إلى الحرف المتحرك المنطوق)",
 "vowel rhyme": "سجع, قافية حروف العلة (تكرار حروف العلة المتشابهة في المقاطع المشددة للكلمات المتتالية)",
 "vowel sound": "حركة, صوت صائت (صوت كلامي يصدر مع فتح المجرى الصوتي)",
 "vowel system": "نظام الحروف المتحركة, نظام الصوائت (نظام الحروف المتحركة المستخدم في لغة معينة)",
 "vowellike": "شَبِيهٌ بِالحَرَكَة (ذو خصائص تشبه الصوت الصائت (الحركة))",
 "vower": "مقسِم, ناذر (شخص يقطع وعدًا رسميًا بفعل شيء أو التصرف بطريقة معينة)\nمثال: ناذرون شباب بالحب الأبدي",
 "vox": "صوت, لفظ (الصوت الناتج عن اهتزاز الأحبال الصوتية المعدل برنين المسالك الصوتية)\nمثال: المغني يعتني جيداً بصوته",
 "vox angelica": "الصوت الملائكي, فوكس أنجليكا (موقف أرغن ينتج تأثير اهتزاز لطيف)",
 "vox humana": "صوت بشري, فوكس هيومانا (قصبة توقف في الأرغن تنتج نغمات تحاكي الصوت البشري)",
 "vox populi": "رأي عام, صوت الشعب (معتقد أو شعور يشاركه معظم الناس)\nمثال: طلب إجراء استطلاع للرأي العام",
 "voyage": "رِحْلَة",
 "voyager": "رحالة بحري, مسافر (مسافر إلى أرض بعيدة (خاصة من يسافر عن طريق البحر))",
 "voyeur": "مُتَلَصِّص",
 "voyeurism": "تلصص, تلصصية (انحراف يحصل فيه الشخص على إشباع جنسي من رؤية الأعضاء التناسلية للآخرين أو مشاهدة السلوك الجنسي للآخرين)",
 "voyeuristic": "تلصصي (من أو متعلق بالمتلصصين أو التلصص)\nمثال: متعه التلصصية",
 "voyeuristical": "تلصصي (من أو متعلق بالمتلصصين أو التلصص)\nمثال: متعه التلصصية",
 "voyeuristically": "بتلصص (مثل المتلصص)\nمثال: يتسلل بتلصص حول حمام السباحة",
 "voyeuse": "فوايوز, كرسي المتفرج (كرسي من القرن الثامن عشر يستخدم عند طاولات اللعب، له حاجز علوي مبطن يمكن للمتفرجين الاتكاء عليه)",
 "vroom": "هدير المحرك (صوت الهدير الذي يصدره محرك يعمل بسرعة عالية)",
 "vuelta a españa": "طَوَاف إِسْبَانِيَا",
 "vulcanisation": "فلكنة (عملية معالجة المطاط أو المواد الشبيهة بالمطاط بالكبريت عند حرارة عالية لتحسين المرونة والقوة أو لتصلبها)",
 "vulcanised": "مُفَلْكَنٌ, مُقَسًّى ((للمطاط) مُعَالَج بعملية كيميائية أو فيزيائية لتحسين خصائصه)",
 "vulcaniser": "عامل فلكنة, مفلكن (شخص يقوم بفلكنة المطاط لتحسين قوته ومرونته) / جهاز فلكنة (جهاز يستخدم لفلكنة المطاط)",
 "vulcanite": "إيبونيت, مطاط صلب (مطاط صلب غير مرن يتكون من فلكنة المطاط الطبيعي)",
 "vulcanization": "فلكنة (عملية معالجة المطاط أو المواد الشبيهة بالمطاط بالكبريت عند حرارة عالية لتحسين المرونة والقوة أو لتصلبها)",
 "vulcanize": "بَرْكَنَ, فَلْكَنَ",
 "vulcanized": "مُفَلْكَنٌ, مُقَسًّى ((للمطاط) مُعَالَج بعملية كيميائية أو فيزيائية لتحسين خصائصه)",
 "vulcanized fiber": "ليف مقوى (مادة تشبه الجلد مصنوعة بضغط طبقات من الورق أو القماش)",
 "vulcanizer": "عامل فلكنة, مفلكن (شخص يقوم بفلكنة المطاط لتحسين قوته ومرونته) / جهاز فلكنة (جهاز يستخدم لفلكنة المطاط)",
 "vulcanology": "علم البراكين (فرع الجيولوجيا الذي يدرس البراكين)",
 "vulgar": "بَذِيء",
 "vulgar latin": "اللاتينية العامية (لهجات لاتينية غير كلاسيكية كان يتم التحدث بها في الإمبراطورية الرومانية؛ مصدر اللغات الرومانسية)",
 "vulgarian": "سوقي, مبتذل (شخص مبتذل (خاصة من يستعرض ثروته بابتذال))",
 "vulgarisation": "ابتذال, تعميم (فعل جعل الشيء جذاباً للجمهور العام) / ابتذال (فعل جعل الشيء خشناً وغير مهذب)",
 "vulgariser": "مقرِّب للعامة, مُبَسِّط (شخص يجعل شيئًا ما جذابًا للجمهور العام) / مُبْتَذِل (شخص يجعل شيئاً ما مبتذلاً أو سوقياً)",
 "vulgarism": "ابْتِذَال, سُوقِيَّة (صفة الافتقار إلى الذوق والتهذيب) / بذاءة, فحش (كلمة أو عبارة مسيئة أو غير لائقة)",
 "vulgarity": "ابْتِذَال, سُوقِيَّة (صفة الافتقار إلى الذوق والتهذيب)",
 "vulgarization": "ابتذال, تعميم (فعل جعل الشيء جذاباً للجمهور العام) / ابتذال (فعل جعل الشيء خشناً وغير مهذب)",
 "vulgarizer": "مقرِّب للعامة, مُبَسِّط (شخص يجعل شيئًا ما جذابًا للجمهور العام) / مُبْتَذِل (شخص يجعل شيئاً ما مبتذلاً أو سوقياً)",
