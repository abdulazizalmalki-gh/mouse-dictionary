 "war baby": "طفل الحرب (طفل حُمل به أو ولد أثناء الحرب)",
 "war bride": "عروس الحرب (عروس لجندي خلال وقت الحرب)",
 "war chest": "صندوق طوارئ, ميزانية حرب (صندوق مجمع لتمويل حرب (أو حملة سياسية))",
 "war cloud": "نذر الحرب (علامة مشؤومة تهدد بالحرب)",
 "war communism": "شُيُوعِيَّةُ الْحَرْب",
 "war correspondent": "مراسل حربي (صحفي يرسل تقارير إخبارية وتعليقات من منطقة قتال أو مكان معركة للنشر أو البث)",
 "war crime": "جَرِيمَةْ حَرْب",
 "war criminal": "مُجْرِم حَرْب, مُجْرِمَة حَرْب",
 "war cry": "صيحة الحرب, نداء المعركة (صرخة تهدف إلى حشد مجموعة من الجنود في المعركة) / صيحة الحرب, كلمة السر (شعار يستخدم لحشد الدعم لقضية ما)\nمثال: دعوة لحمل السلاح",
 "war dance": "رقصة الحرب (رقصة احتفالية تؤدى قبل المعركة أو بعد الانتصار)",
 "war department": "وزارة الحرب (إدارة تنفيذية سابقة لحكومة الولايات المتحدة؛ أنشئت عام 1789 ودُمجت مع وزارة البحرية عام 1947)",
 "war game": "لُعْبَة حَرْب (اللَعْبَة البَرْبَرية دواء عشبيّ)\nمثال: عنده لعبة يويو.",
 "war god": "إله الحرب (إله يُعبد بصفته مانحاً للنصر في الحرب)",
 "war hawk": "صَقْر (داعية لسياسة عدوانية في العلاقات الخارجية)",
 "war machine": "الجيش, القوات المسلحة (القوات العسكرية لدولة ما)\nمثال: جيشهم هو الأكبر في المنطقة",
 "war of attrition": "حَرْب اِسْتِنْزاف (حَرَبَ (حربه) بالحربة حربا: طعنه بها؛ حَرَبَ (ه) حربا: سلبه جميع ما يملك)\nمثال: بوتين مجرم حرب.",
 "war of nerves": "حرب أعصاب, حرب نفسية (استخدام تكتيكات نفسية لتدمير معنويات الخصوم)",
 "war paint": "تبرج, مكياج (مستحضرات تجميل توضع على الوجه لتحسين أو تغيير المظهر) / ألوان الحرب, زينة الحرب (الملابس والمراسم الاحتفالية الكاملة (مجازياً)) / طلاء الحرب (زينة تتكون من طلاء يوضع على الوجه والجسم لدى بعض المحاربين الهنود الحمر قبل المعركة)",
 "war party": "حزب الحرب (حزب سياسي يدعم الحرب) / فريق الحرب (مجموعة من المحاربين الذين يغيرون أو يقاتلون عدواً (تستخدم بشكل خاص للأمريكيين الأصليين))",
 "war power": "سلطة الحرب (سلطة استثنائية تمارس (عادة من قبل الفرع التنفيذي) في شن الحرب وتتضمن توسيع السلطات التي تتمتع بها الحكومة عادة في وقت السلم)",
 "war room": "غرفة العمليات, غرفة عمليات حربية (غرفة تُتخذ فيها القرارات الاستراتيجية (خاصة للحملات العسكرية أو السياسية))",
 "war secretary": "وزير الحرب (رئيس وزارة تنفيذية سابقة؛ تم دمجها مع وزارة البحرية لتشكيل وزارة الدفاع عام 1947)",
 "war vessel": "بارجة, سفينة حربية (سفينة حكومية متاحة لشن الحرب)",
 "war whoop": "صيحة الحرب, نداء المعركة (صرخة تهدف إلى حشد مجموعة من الجنود في المعركة)",
 "war widow": "أرملة الحرب (امرأة توفي زوجها في الحرب)",
 "war zone": "منطقة حرب (منطقة قتال حيث يتم تنسيق العمليات العسكرية (خاصة منطقة معينة في المياه الدولية حيث لا تُحترم حقوق المحايدين من قبل الدول المتحاربة))",
 "war-ridden": "فِي حَالَةِ حَرْب, مُتَحَارِب (مُنْخَرِطٌ فِي الحَرْب)",
 "war-torn": "مُمَزَّقٌ بِالحَرْب (خَرَّبَتْهُ الحَرْبُ وَدَمَّرَتْه)",
 "war-worn": "مُمَزَّقٌ بِالحَرْب (خَرَّبَتْهُ الحَرْبُ وَدَمَّرَتْه)",
 "waratah": "وراته (شجيرة طويلة من شرق أستراليا ذات أوراق سنانية مقلوبة إلى بيضاوية مقلوبة وأزهار حمراء في عناقيد مدمجة) / وراته (شجيرة متناثرة ذات أوراق ضيقة وأزهار حمراء بارزة في عناقيد كروية كثيفة)",
 "warble": "نغفة (خراج متكتل تحت جلد الثدييات المنزلية تسببه يرقات ذبابة النبر)",
 "warble fly": "نبر البقر (ذباب مشعر يشبه النحل يرقاته تنتج خراجات متكتلة تحت جلد الماشية)",
 "warbler": "دُخَّلَة",
 "ward": "جَنَاح",
 "ward off": "يَدْرَأ",
 "ward-heeler": "سياسي نفعي, منتفع حزبي (سياسي ينتمي إلى زمرة صغيرة تسيطر على حزب سياسي لأغراض خاصة بدلاً من الأغراض العامة)",
 "warden": "آمِر سِجْن",
 "wardenship": "مأمورية, منصب المأمور (منصب المأمور أو آمر السجن)",
 "warder": "حارِس سِجْن, سَجَّان (شخص يعمل في السجن ومسؤول عن السجناء)",
 "wardership": "حراسة, منصب الحارس (منصب الحارس)",
 "wardress": "سجّانة (سجانة أنثى)",
 "wardrobe": "خِزَانَة, خِزَانَة ثَوْب (مكان الخَزْن؛ قطعة أثاث للخَزْن)\nمثال: اقترب من الخزانة.",
 "wardroom": "غرفة الضباط (أماكن عسكرية لتناول الطعام والترفيه لضباط سفينة حربية (باستثناء القبطان))",
 "ware": "بضائع, سلع (أصناف للبيع للمستهلك الفرد) / آنية, أدوات (أصناف من نفس النوع أو المادة؛ تستخدم عادة في التركيبات اللفظية)\nمثال: تعتمد التجارة الجيدة على وجود بضائع جيدة",
 "warehouse": "مَخْزَن, مُسْتَوْدَع",
 "warehouseman": "أمين مستودع, عامل مخزن (عامل ذكر يدير أو يعمل في مستودع)",
 "warehouseman's lien": "حجز أمين المستودع (حق أمين المستودع في الاحتفاظ بالبضائع حتى يتم دفع جميع رسوم التخزين)",
 "warehouser": "أمين مستودع, عامل مخزن (عامل يدير أو يعمل في مستودع)",
 "warehousewoman": "أمينة مستودع, عاملة مخزن (عاملة أنثى تدير أو تعمل في مستودع)",
 "warehousing": "إيداع, تخزين (الإيداع في مستودع)\nمثال: قرروا إيداع أثاثهم في مستودع موصى به في بروكلين",
 "warfare": "حرب, قتال (شن صراع مسلح ضد عدو) / حَرْب (صراع نشط بين كيانات متنافسة)\nمثال: قُتل آلاف الأشخاص في الحرب",
 "warfarin": "كومادين, وارفارين (مضاد للتخثر (الاسم التجاري كومادين) يستخدم لمنع وعلاج الجلطة أو الانصمام)",
 "warhead": "رَأْس حَرْبِيّ (عُضْو مِنَ ٱلْجَسَدِ يَحْوِي الدِّمَاغ والفَم والأَنْف والعَيْنَيْن والأُذُنَيْن؛ أَعْلَى ٱلشَّيْءِ)\nمثال: قطع سامي رأس كلب.",
 "warhorse": "حصان حرب (حصان يستخدم في الحرب) / عمل كلاسيكي مكرر (عمل فني (مقطوعة أو دراما) جزء من الذخيرة القياسية ولكنه أصبح مبتذلاً من كثرة التكرار) / محارب قديم, مخضرم (شخص ذو خبرة مر بالعديد من المعارك؛ أو شخص قدم خدمة طويلة)",
 "warily": "بِتَرَقُّب, بِحَذَر (بطريقة تتسم بالحيطة والحذر)\nمثال: راقب البحار السماء بحذر",
 "wariness": "توجس, حذر (سمة كون المرء حذراً ومترقباً)",
 "warji": "وارجي (لغة تشادية يتم التحدث بها في شمال نيجيريا، وخاصة في ولاية باوتشي)",
