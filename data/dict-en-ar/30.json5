 "variety show": "عرض منوعات (عرض يتكون من سلسلة من العروض القصيرة غير المترابطة)",
 "variform": "مُتَنَوِّعُ الشَّكْل (يَتَفَاوَتُ فِي الشَّكْلِ أَوِ الهَيْئَة)",
 "variola": "جدري (مرض فيروسي شديد العدوى يتميز بحمى وضعف وطفح جلدي مع بثور تشكل قشورًا تسقط تاركة ندوبًا)",
 "variola major": "الجدري الكبير, فيروس الجدري الكبير (نوع من فيروس الجدري لديه معدل وفيات يصل إلى 25 بالمائة) / جدري (مرض فيروسي شديد العدوى يتميز بحمى وضعف وطفح جلدي مع بثور تشكل قشورًا تسقط تاركة ندوبًا)",
 "variola major virus": "الجدري الكبير, فيروس الجدري الكبير (نوع من فيروس الجدري لديه معدل وفيات يصل إلى 25 بالمائة)",
 "variola minor": "الجدري الصغير, فيروس الجدري الصغير (نوع من فيروس الجدري لديه معدل وفيات يبلغ حوالي 1 بالمائة) / جدري خفيف (شكل خفيف من الجدري يسببه فيروس أقل ضراوة)",
 "variola minor virus": "الجدري الصغير, فيروس الجدري الصغير (نوع من فيروس الجدري لديه معدل وفيات يبلغ حوالي 1 بالمائة)",
 "variola vaccina": "جدري البقر, وقس (عدوى موضعية يتم تحفيزها في البشر عن طريق التلقيح بالفيروس المسبب لجدري البقر من أجل منح المقاومة ضد الجدري)",
 "variola vaccine": "جدري البقر, وقس (عدوى موضعية يتم تحفيزها في البشر عن طريق التلقيح بالفيروس المسبب لجدري البقر من أجل منح المقاومة ضد الجدري)",
 "variola vaccinia": "جدري البقر, وقس (عدوى موضعية يتم تحفيزها في البشر عن طريق التلقيح بالفيروس المسبب لجدري البقر من أجل منح المقاومة ضد الجدري)",
 "variola virus": "فيروس الجدري البشري, فيروس فاريولا (الفيروس الذي يسبب الجدري لدى البشر؛ يمكن استخدامه سلاحاً بيولوجياً)",
 "variolar": "جدري, متعلق بالجدري (متعلق بمرض الجدري)",
 "variolation": "تجدير (عملية قديمة لتلقيح شخص معرض للإصابة بمادة مأخوذة من حويصلة شخص مصاب بالجدري)",
 "variolic": "جدري, متعلق بالجدري (متعلق بمرض الجدري)",
 "variolization": "تجدير (عملية قديمة لتلقيح شخص معرض للإصابة بمادة مأخوذة من حويصلة شخص مصاب بالجدري)",
 "variolous": "جدري, متعلق بالجدري (متعلق بمرض الجدري)",
 "variometer": "مقياس التباين (أداة قياس لقياس التغيرات في المجال المغناطيسي)",
 "variorum": "طبعة جامعة (طبعة تحتوي على نسخ مختلفة من نص أو ملاحظات من قبل علماء أو محررين مختلفين)",
 "variorum edition": "طبعة جامعة (طبعة تحتوي على نسخ مختلفة من نص أو ملاحظات من قبل علماء أو محررين مختلفين)",
 "various": "مُخْتَلِف, مُتَنَوَّع",
 "variously": "بشكل متنوع, بشكل مختلف (بطرق متنوعة)\nمثال: البدائل التي يتم تمثيلها بشكل مختلف من قبل المشاركين",
 "variously-leaved pondweed": "بوتاموجيتون عشبي, جار النهر متباين الأوراق (من أوروبا (باستثناء منطقة البحر الأبيض المتوسط) وشمال الولايات المتحدة)",
 "varix": "دوالي (وعاء دموي أو وعاء لمفاوي متضخم أو ملتوي بشكل غير طبيعي)",
 "varlet": "وصيف (في العصور الوسطى، شاب يعمل كمرافق لفارس كأول مرحلة في التدريب للفروسية) / أفاق, محتال (شخص مخادع ولا يمكن الوثوق به)",
 "varment": "آفة برية, حيوان ضار (أي حيوان بري مفترس عادة يعتبر غير مرغوب فيه؛ مثل القيوط)",
 "varmint": "آفة برية, حيوان ضار (أي حيوان بري مفترس عادة يعتبر غير مرغوب فيه؛ مثل القيوط) / حشرة, شخص بغيض (شخص مزعج أو بغيض)",
 "varna": "فارنا ((في الهندوسية) اسم التقسيم الاجتماعي الأصلي للشعب الفيدي إلى أربع مجموعات (والتي تنقسم إلى آلاف الطوائف))",
 "varnish": "وَرْنِيش",
 "varnish tree": "شجرة اللك, شجرة الورنيش (شجرة آسيوية صغيرة تفرز مادة سامة يتم الحصول منها على اللك (الورنيش)) / جوزة الشمع, شجرة الورنيش (شجرة كبيرة موطنها جنوب شرق آسيا؛ تنتج المكسرات زيتاً يستخدم في الورنيش؛ تستخدم حبات المكسرات المربوطة معاً محلياً كشموع)",
 "varnished": "مَصْبُوغ, مُلَمَّع (مُغَطًّى بِطَبَقَةٍ مِنَ الصَّبْغِ أَوِ الوَرْنِيش)",
 "varnisher": "دهان الورنيش, مورنش (شخص يضع طبقة نهائية من الورنيش)",
 "varsity": "فريق الجامعة الرسمي (فريق يمثل كلية أو جامعة) / فارسيتي (اختصار بريطاني لـ 'جامعة'؛ يشير عادة إلى جامعة أكسفورد أو جامعة كامبريدج)",
 "varsity letter": "شارة رياضية (جائزة تُكتسب من خلال المشاركة في الرياضات المدرسية)\nمثال: حصل على شارات في ثلاث رياضات",
 "varsity sock": "جورب رياضي (جورب يُرتدى للأنشطة الرياضية)",
 "varus": "فحج (تشوه ينقلب فيه جزء من الطرف إلى الداخل بدرجة غير طبيعية)",
 "varying": "مُتَبَايِن, مُتَفَاوِت (يَتَّسِمُ بِالتَّنَوُّعِ أَوِ الاِخْتِلَاف)",
 "varying hare": "أرنب حذاء الثلج (أرنب بري كبير ذو أقدام كبيرة من أمريكا الشمالية؛ أبيض في الشتاء)",
 "vas": "وعاء (أنبوب يدور فيه سائل جسدي)",
 "vas deferens": "قَنَاة مَنَوِيَّة",
 "vasa brevis": "شريان معدي قصير (عدة شرايين صغيرة تتفرع من الشريان الطحالي وتذهب إلى الانحناء الكبير للمعدة)",
 "vasa efferentia": "الأوعية الصادرة (العديد من النبيبات شديدة الالتواء التي تمتد من شبكة الخصية إلى الأسهر وتشكل رأس البربخ)",
 "vasa vasorum": "أوعية الأوعية (أي وعاء دموي صغير يتفرع على السطح الخارجي لشريان أو وريد رئيسي)",
 "vascular": "وعائي (متعلق بالأوعية التي تنقل وتوزع السوائل (كالدم أو النسغ) أو يحتوي عليها)\nمثال: تضيق وعائي",
 "vascular bundle": "حزمة وعائية, ضفيرة وعائية (خيط وحدة من النظام الوعائي في سيقان وأوراق النباتات العليا يتكون أساسًا من الخشب واللحاء)",
 "vascular conduit": "قناة وعائية, وعاء دموي اصطناعي (وعاء دموي اصطناعي يستخدم في إجراء جراحي لإعادة توجيه تدفق الدم في منطقة من الجسم)",
 "vascular hemophilia": "مرض فون ويليبراند (شكل من أشكال الهيموفيليا اكتشفه إريك فون ويليبراند؛ وهو اضطراب وراثي ينتقل كصفة جسدية متنحية؛ يتميز بنقص في عامل التخثر ونزيف الغشاء المخاطي)",
 "vascular plant": "نبات وعائي (نبات أخضر يحتوي على نظام وعائي: السراخس، عاريات البذور، كاسيات البذور)",
 "vascular prosthesis": "قناة وعائية, وعاء دموي اصطناعي (وعاء دموي اصطناعي يستخدم في إجراء جراحي لإعادة توجيه تدفق الدم في منطقة من الجسم)",
 "vascular ray": "شعاع نخاعي, شعاع وعائي (ورقة من الأنسجة الوعائية تفصل بين الحزم الوعائية)",
 "vascular spider": "وحمة عنكبوتية, ورم وعائي عنكبوتي (توسع في الشعيرات الدموية السطحية مع نقطة حمراء مركزية تشع منها الأوعية الدموية)",
 "vascular strand": "حزمة وعائية, ضفيرة وعائية (خيط وحدة من النظام الوعائي في سيقان وأوراق النباتات العليا يتكون أساسًا من الخشب واللحاء)",
 "vascular structure": "بنية وعائية (بنية تتكون من أو مزودة بأوعية دموية)",
 "vascular system": "الجهاز الوعائي (الأوعية والأنسجة التي تحمل أو تدور السوائل مثل الدم أو الليمف أو النسغ عبر جسم الحيوان أو النبات)",
 "vascular tissue": "نسيج وعائي (نسيج يوصل الماء والمواد المغذية عبر جسم النبات في النباتات العليا)",
 "vascularisation": "تكون الأوعية, توعي (العملية العضوية التي تصبح فيها أنسجة الجسم وعائية وتطور شعيرات دموية)",
 "vascularity": "وعائية (خاصية كون الشيء وعائياً)\nمثال: وعائية بارزة",
 "vascularization": "تكون الأوعية, توعي (العملية العضوية التي تصبح فيها أنسجة الجسم وعائية وتطور شعيرات دموية)",
 "vasculitis": "التهاب الأوعية الدموية (التهاب وعاء دموي)",
 "vase": "زَهْرِيَّة",
 "vase vine": "زهرة الجلود, كرمة المزهرية (شجيرة متسلقة من جنوب شرق الولايات المتحدة ذات أزهار كبيرة حمراء أرجوانية على شكل جرس بسبلات جلدية منحنية للخلف)",
 "vase-shaped": "مَزْهَرِيّ الشَّكْل (على شكل مزهريّة)",
 "vase-vine": "زهرة الجلود, كرمة المزهرية (شجيرة متسلقة من جنوب شرق الولايات المتحدة ذات أزهار كبيرة حمراء أرجوانية على شكل جرس بسبلات جلدية منحنية للخلف)",
 "vasectomy": "قطع القناة المنوية (إجراء جراحي يزيل كل أو جزء من الأسهر (عادة كوسيلة للتعقيم)؛ وأحياناً تكون قابلة للعكس)",
 "vaseline": "ڤازلين, فازلين",
 "vasiform": "أُنْبُوبِيّ (يشكّل أنبوبًا أو يحتوي على أنابيب مجوّفة لمرور السوائل)",
 "vasoconstriction": "تضيق الأوعية (انخفاض في قطر الأوعية الدموية)",
 "vasoconstrictive": "رافع للضغط, مُقَبِّض للأوعية (أي عامل يسبب تضييق فتحة الأوعية الدموية مما يرفع ضغط الدم أو يحافظ عليه؛ مثل البرد أو النيكوتين أو الإبينفرين)",
 "vasoconstrictor": "رافع للضغط, مُقَبِّض للأوعية (أي عامل يسبب تضييق فتحة الأوعية الدموية مما يرفع ضغط الدم أو يحافظ عليه؛ مثل البرد أو النيكوتين أو الإبينفرين)",
 "vasodilation": "توسع الأوعية (توسع الأوعية الدموية (خاصة الشرايين))",
 "vasodilative": "موسع للأوعية الدموية (عقار يسبب توسع الأوعية الدموية)",
 "vasodilator": "موسع للأوعية الدموية (عقار يسبب توسع الأوعية الدموية)",
 "vasomax": "فينتولامين (عقار للفحولة (الاسم التجاري فاسوماكس) لعلاج ضعف الانتصاب لدى الرجال)",
 "vasomotor": "وعائي حركي (متعلق بالأعصاب والعضلات التي تسبب انقباض أو توسع الأوعية الدموية)",
 "vasopressin": "الهرمون المضاد لإدرار البول, فازوبريسين (هرمون تفرزه الغدة النخامية الخلفية؛ يؤثر على ضغط الدم ويقلل تدفق البول)",
 "vasopressor": "رافع ضغط الدم, مُقَبِّض وعائي (أي عامل يسبب تضيق الأوعية وارتفاع ضغط الدم (يُفهم عادة على أنه زيادة الضغط الشرياني))",
 "vasosection": "بضع الأسهر, قطع القناة المنوية (شق جراحي أو تقسيم للأسهر (القناة الناقلة للمني))",
 "vasotec": "إنالابريل, فاسوتيك (مثبط للإنزيم المحول للأنجيوتنسين (الاسم التجاري فاسوتيك) يمنع تكوين الأنجيوتنسين في الكلى وبالتالي يؤدي إلى توسع الأوعية؛ يعطى بعد النوبات القلبية)",
 "vasotomy": "بضع الأسهر, قطع القناة المنوية (شق جراحي أو تقسيم للأسهر (القناة الناقلة للمني))",
 "vasovasostomy": "مفاغرة الأسهر (إجراء جراحي يحاول استعادة وظيفة الأسهر بعد قطع القناة المنوية)",
 "vasovesiculitis": "التهاب الأسهر والحويصلات المنوية (التهاب الأسهر والحويصلات المنوية؛ يحدث عادة مع التهاب البروستاتا)",
 "vassal": "تابِع إِقْطاعِيّ, خادِم (شخص يملك إقطاعية؛ شخص يدين بالولاء والخدمة لسيد إقطاعي)",
 "vassalage": "عبودية الأرض, قنانة (حالة القن (عبد الأرض))",
 "vast": "شَاسِع, وَاسِع",
 "vastly": "إلى حد كبير, بشكل هائل (إلى مدى أو درجة كبيرة جداً)\nمثال: لقد بالغ في تقدير موارده بشكل هائل",
 "vastness": "شساعة, ضخامة (كبر غير عادي في الحجم أو المدى أو العدد)",
 "vat": "حوض كبير, دن (وعاء مفتوح كبير لحفظ أو تخزين السوائل) / ضريبة القيمة المضافة (ضريبة تعتمد على قيمة السلع التي يحصلها بائع التجزئة النهائي)",
 "vat color": "صبغة الحوض, صبغة وعائية (صبغة غير قابلة للذوبان في الماء يتم تطبيقها عن طريق اختزال الصبغة إلى شكل قلوي، ثم تطبيق الصبغة، ثم إعادة تكوين الصبغة غير القابلة للذوبان عن طريق…)",
 "vat dye": "صبغة الحوض, صبغة وعائية (صبغة غير قابلة للذوبان في الماء يتم تطبيقها عن طريق اختزال الصبغة إلى شكل قلوي، ثم تطبيق الصبغة، ثم إعادة تكوين الصبغة غير القابلة للذوبان عن طريق…)",
 "vatic": "عِرَافِيّ, كَهَنُوتِيّ (يُشبِه أو يتّسم بسمات نبيّ أو نبوءة)",
 "vatical": "عِرَافِيّ, كَهَنُوتِيّ (يُشبِه أو يتّسم بسمات نبيّ أو نبوءة)",
 "vatican": "الْفَاتِيكَان",
 "vatican city state": "دولة مدينة الفاتيكان (بَلَد يتميز بحُدُود معروفة وشَعْب وحُكُومَة ومُؤَسَسَات مُنَظَّمَة؛ مجموعة من الناس مستقلين متحدين معا لتكوين مجتمع لحماية حقوقهم و وضع قوانينهم الخاصة)\nمثال: لبنان دولة صغيرة.",
 "vatican council": "مجمع الفاتيكان (كل من المجمعين للكنيسة الرومانية الكاثوليكية)",
 "vatican i": "مجمع الفاتيكان الأول (اسم مفعول من جَمَّعَ؛ كُلِّيَّة، جَامِعَة)\nمثال: كان سامي يعيش في مجمع مسور.",
 "vatican ii": "مجمع الفاتيكان الثاني (مجمع الفاتيكان في 1962-1965 الذي تخلى عن الليتورجيا اللاتينية العالمية واعترف بالحركة المسكونية وقام بإصلاحات أخرى)",
 "vaticination": "تكهن, نبوءة (معرفة المستقبل (يُقال عادة أنه يتم الحصول عليها من مصدر إلهي))",
 "vaticinator": "متنبئ, نبي (شخص ذو سلطة يتنبأ بالمستقبل)",
 "vaudeville": "فودفيل (عرض منوعات مع أغاني وفقرات كوميدية وغيرها)",
 "vaudeville theater": "قاعة موسيقى, مسرح فودفيل (مسرح يتم فيه تقديم عروض الفودفيل)",
 "vaudeville theatre": "قاعة موسيقى, مسرح فودفيل (مسرح يتم فيه تقديم عروض الفودفيل)",
 "vaudevillian": "فنان فودفيل (فنان يؤدي عروضاً في مسرح الفودفيل)",
 "vaudois": "الولدينيسية (طائفة مسيحية من المنشقين نشأت في جنوب فرنسا في أواخر القرن الثاني عشر واعتمدت المذاهب الكالفينية في القرن السادس عشر)",
 "vault": "قَبْو",
 "vault of heaven": "القبة السماوية, سماء (السطح الظاهري للكرة الوهمية التي تبدو الأجرام السماوية مسقطة عليها)",
 "vaulted": "مُقَبَّب (ذو قبّة نصف كرويّة أو سقف مقوّس)",
 "vaulter": "قافز بالزانة (رياضي يقفز فوق عارضة عالية بمساعدة زانة طويلة)",
 "vaulting": "مُفْرِط الطُّمُوح (يكشف عن ثقة مفرطة بالنفس؛ يتطلع إلى أعلى المراتب) / جمباز على الخيل, فولتنج (قفزة خفيفة للحصان تغادر فيها ساقاه الخلفيتان الأرض قبل نزول الساقين الأماميتين) / بناء مقبب, قبو ((في العمارة) هيكل مقبب)\nمثال: أقواس وقبو",
 "vaulting horse": "حصان القفز, حصان طويل (حصان جمباز بدون مقابض وبطرف ممدود؛ يستخدم طولياً للقفز)",
 "vaunt": "مباهاة (مدح النفس بشكل مبالغ فيه)",
 "vaunter": "متباهٍ, متفاخر (شخص كثير التفاخر والحديث عن نفسه)",
 "vauntingly": "بِتَبَاهٍ, بِتَفَاخُر (بطريقة تتسم بالتباهي)\nمثال: تحدث بتباهٍ طوال المساء",
 "vav": "وَاو",
 "vcr": "جهاز فيديو, مسجل كاسيت فيديو (مسجل شريط مغناطيسي لتسجيل (وتشغيل) البرامج التلفزيونية)",
 "vd": "مرض تناسلي, مرض منقول جنسياً (عدوى سارية تنتقل عن طريق الاتصال الجنسي)",
 "vdu": "وحدة العرض المرئي ((بريطاني) مصطلح بريطاني لشاشة العرض)",
 "ve day": "يوم النصر في أوروبا (فترة من الزمان تبدأ عند غُرُوب الشمس وتنتهي عند غُرُوب شمس النهار التالي ويشمل اللَيْلَة ونَهَارا. طوله أربع وعشرين سَاعَة؛ النَهَار، يبدأ من طلوع الفَجْر إلى غُرُوب الشَمس، على المجاز)\nمثال: طقس اليوم جميل.",
 "veadar": "أذار الثاني (يدرج سبع مرات كل 19 سنة)",
 "veal": "لَحْم عِجْل (ما يبقى من جسم الحيوان أو الإنسان بعد إزالة الجلد الأحشاء والعظم والشحم والدم والأعصاب. يتكون أساسا من العَضَلَات؛ ما يؤكل من لحم من الحيوان والطير والسمك عامة)\nمثال: أفضل لحم البقر.",
 "veal cordon bleu": "عجل كوردون بلو (شرائح رقيقة من العجل محشوة بالجبن واللحم المقدد ثم تُشوح)",
 "veal parmesan": "عجل بارميزان (شريحة عجل مشوحة مغطاة بفتات الخبز والجبن وتُقدم مع صلصة الطماطم)",
 "veal parmigiana": "عجل بارميزان (شريحة عجل مشوحة مغطاة بفتات الخبز والجبن وتُقدم مع صلصة الطماطم)",
 "veal roast": "شواء عجل, لحم عجل للتحمير (قطعة من لحم العجل مناسبة للتحمير)",
 "veal scallopini": "سكالوبيني العجل (شرائح رقيقة مشوحة من لحم العجل)",
 "veau": "لحم عجل (لحم مأخوذ من العجل)",
 "vector": "مُتَّجِهٌ / مُتَّجِهاتٌ / شُعاعٌ / أَشِعَّةٌ / ناقِلٌ / نَواقِلُ",
 "vector algebra": "جبر المتجهات (جزء الجبر الذي يتعامل مع نظرية المتجهات والفضاءات المتجهية)",
 "vector decomposition": "تحليل المتجهات (تحليل حقل المتجهات)",
