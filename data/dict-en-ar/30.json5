 "waiver": "تَنَازُل, وَثِيقَةُ تَنَازُل",
 "wakashan": "لغات واكاشان (عائلة من لغات هنود أمريكا الشمالية في كولومبيا البريطانية وواشنطن) / واكاشان (فرد من أحد الشعوب في كولومبيا البريطانية واشنطن الذين يتحدثون لغة واكاشان)",
 "wakashan language": "لغات واكاشان (عائلة من لغات هنود أمريكا الشمالية في كولومبيا البريطانية وواشنطن)",
 "wakayama": "وَاكَايَامَا",
 "wake": "أَيْقَظَ (نبَّهه، ضد نَوَّمَه؛ الغبارَ: أثاره)\nمثال: أيقظ زيري السائق",
 "wake board": "لوح تزلج مائي (ويك بورد) (لوح طافٍ (يشبه لوح ركوب الأمواج) يستخدم للركوب فوق الماء أثناء السحب خلف قارب بمحرك)",
 "wake up": "صَحَا, اِسْتَيْقَظَ (أَفَاقَ؛ اِسْتَيْقَظَ) / أَيْقَظَ (نبَّهه، ضد نَوَّمَه؛ الغبارَ: أثاره)\nمثال: أيقظ زيري السائق",
 "wake-robin": "أريسيما, لفت هندي (عشبة غابات أمريكية شائعة تزهر في الربيع ذات أوراق غمدية وطلع منتصب يشبه الهراوة مع قنابة خضراء وأرجوانية متقوسة تنتج توتاً قرمزياً) / تريليوم, زنبق الخشب (أي نبات زنبقي من جنس التريليوم له دوامة من ثلاث أوراق في قمة الساق مع زهرة واحدة بثلاث بتلات)",
 "wake-up call": "مكالمة إيقاظ (مكالمة هاتفية تطلب إجراءها في وقت محدد لإيقاظك) / جرس إنذار, نداء تيقظ (تحذير لاتخاذ إجراء بخصوص شيء تم التغاضي عنه أو إهماله)\nمثال: طلبت مكالمة إيقاظ للساعة 7 صباحاً",
 "wake-up signal": "إشارة الاستيقاظ, نوبة صحيان ((عسكري) إشارة للاستيقاظ)",
 "wakeboard": "لوح تزلج مائي (ويك بورد) (لوح طافٍ (يشبه لوح ركوب الأمواج) يستخدم للركوب فوق الماء أثناء السحب خلف قارب بمحرك)",
 "wakeful": "حَذِر, سَاهِر (شديد الملاحظة والانتباه؛ يترقب الخطر المحتمل) / وَاعٍ, يَقِظ (يتسم بالوعي الكامل والانتباه) / خَفِيف, مُتَقَطِّع ((عَنِ النَّوْمِ) يَسْهُلُ إِزْعَاجُهُ وَتَنْبِيهُهُ)",
 "wakefulness": "صحو, يقظة (حالة دورية تكون فيها واعيًا ومدركًا للعالم) / تنبه, تيقظ (عملية إيلاء اهتمام وثيق ومستمر) / أرق, سهاد (حالة مؤقتة تكون فيها غير قادر (أو غير راغب) في النوم)\nمثال: الوعي أثناء اليقظة عند الشخص السليم يكون منظمًا ومألوفًا إلى حد كبير",
 "wakeless": "ثَقِيل, عَمِيق ((عَنِ النَّوْمِ) عَمِيقٌ وَتَامّ)",
 "wakening": "استيقاظ, صحوة (فعل الاستيقاظ)\nمثال: كان استيقاظاً مبكراً",
 "waker": "مُسْتَيْقِظ (شخص يستيقظ) / موقظ (شخص يوقظ الآخرين من النوم)\nمثال: مستيقظ مبكراً",
 "waking": "وَاعٍ, يَقِظ (يتسم بالوعي الكامل والانتباه) / صحو, يقظة (حالة البقاء مستيقظاً)\nمثال: أيام الخطر وليالي اليقظة",
 "waking up": "استيقاظ, صحوة (فعل الاستيقاظ)\nمثال: كان استيقاظاً مبكراً",
 "walapai": "لغة والاباي (اللغة اليومية التي يتحدث بها شعب والاباي) / والاباي (فرد من شعب في أمريكا الشمالية كان يعيش سابقاً في وادي نهر كولورادو في أريزونا)",
 "walapai language": "لغة والاباي (اللغة اليومية التي يتحدث بها شعب والاباي)",
 "walbiri": "لغة وارلبيري (لغة لسكان أستراليا الأصليين، يتم التحدث بها في الإقليم الشمالي لأستراليا)",
 "walbiri language": "لغة وارلبيري (لغة لسكان أستراليا الأصليين، يتم التحدث بها في الإقليم الشمالي لأستراليا)",
 "waldenses": "الولدينيسية (طائفة مسيحية من المنشقين نشأت في جنوب فرنسا في أواخر القرن الثاني عشر واعتمدت المذاهب الكالفينية في القرن السادس عشر)",
 "waldmeister": "غديرة, وودروف حلو (أوراق خضراء داكنة عطرة تستخدم لتنكيه نبيذ مايو) / جويسئة عطرة, نبات الخشبة",
 "waldorf salad": "سلطة والدورف (تُصنع عادة من التفاح والكرفس مع المكسرات أو الزبيب وتُتبل بالمايونيز)",
 "wale": "لوح جانبي (لوح سميك يشكل حافة على طول جانب سفينة خشبية) / أثر ضربة, انتبار (علامة بارزة على الجلد (تنتج عن ضربة سوط مثلاً)؛ سمة مميزة للعديد من ردود الفعل التحسسية)",
 "wales": "وِيلْز",
 "walhalla": "فالهالا ((الأساطير الإسكندنافية) القاعة التي يستقبل فيها أودين أرواح الأبطال الذين قتلوا في المعركة)",
 "walima": "وَلِيمَة (طعام العُرْس؛ أي طعام صنع لدعوة ولجمع كبير من الناس)\nمثال: كانت الوليمة من أطيب ما ذقت.",
 "walk": "مَشَى, تَمَشَّى (اِنْتَقَلَ من مكان إلى آخر؛ اِنْتَقَلَ من مكان إلى آخر على الأقدام. (تخصيص)) / تمشّى / مَسِير, سِيرَة / مِشْيَة\nمثال: مشى ياني مع سكورا.",
 "walk in on": "دَخَلَ عَلَى (وَلَجَ؛ أَدْخَلَ. (تعدية خاصة بالباء))\nمثال: دخل توم المبنى.",
 "walk of life": "مجال الحياة, مسلك حياة (المسارات المهنية بشكل عام)\nمثال: يحدث ذلك في جميع مجالات الحياة",
 "walk the talk": "التزم بوعودك",
 "walk-in": "غرفة صغيرة (غرفة صغيرة كبيرة بما يكفي للسماح بالدخول) / فوز مضمون, نزهة (نصر مؤكد (خاصة في الانتخابات)) / منشق طوعي (عميل يبادر بالانشقاق (عادة إلى بلد معادٍ) من أجل اللجوء السياسي) / زَائِر دُونَ مَوْعِد (شخص يدخل دون الحصول على موعد مسبق)\nمثال: غرفة الطوارئ كانت مكتظة بالزائرين دون موعد",
 "walk-on": "صَامِت, غَيْر نَاطِق (غير قادر على أو لا ينطوي بشكل خاص على الكلام أو السطور المنطوقة) / ممثل دور عابر (يؤدي دوراً صغيراً في عمل درامي)\nمثال: كان له دور صامت في المسرحية",
 "walk-through": "جولة تفقدية (فعل المشي لرؤية شيء ما) / بروفة أولية (أول بروفة سطحية لإنتاج مسرحي حيث يقرأ الممثلون سطورهم من النص ويتحركون وفق التوجيهات) / ممر مشاة (ممر للمشاة عبر الطابق الأرضي للمبنى) / شرح تفصيلي, عرض خطوة بخطوة (شرح شامل (مصحوب عادة بعرض توضيحي) لكل خطوة في إجراء أو عملية)\nمثال: أخذتها الوكيلة العقارية في جولة تفقدية للشقة",
 "walk-up": "بِلَا مِصْعَد (مبنى لا يحتوي على مصعد؛ يُصعَد إليه مشياً) / مبنى بدون مصعد (مبنى سكني بدون مصعد) / شقة بدون مصعد (شقة في مبنى بدون مصعد)",
 "walk-up apartment": "شقة بدون مصعد (شقة في مبنى بدون مصعد)",
 "walkabout": "رحلة برية (رحلات بدوية في الأحراش يقوم بها السكان الأصليون لأستراليا) / جولة بين الجماهير (تجول عام لأحد المشاهير للقاء الناس بشكل غير رسمي) / جولة سيراً (رحلة مشي أو جولة)",
 "walkaway": "اكتساح, فوز سهل (انتصار سهل)",
 "walker": "مَاشٍ",
 "walker foxhound": "ووكر هاوند (سلالة أمريكية من كلاب صيد الثعالب)",
 "walker hound": "ووكر هاوند (سلالة أمريكية من كلاب صيد الثعالب)",
 "walkie-talkie": "اللَاسِلْكِيّ",
 "walking": "مُتَجَسِّد / مَشْي (السَيْر على رجلين؛ السير عامّة)\nمثال: مشي توم مع ماري.",
 "walking delegate": "مندوب متجول (ممثل نقابي يزور العمال في وظائفهم لمعرفة ما إذا كانت الاتفاقيات مُراعية)",
 "walking fern": "سرخس ماشي, ورقة ماشية (سراخس ذات سعف رمحي يتجذر عند الطرف)",
 "walking frame": "مَشَّايَة",
 "walking horse": "حصان تينيسي المشاء (حصان يتميز بالقدرة على التحمل ومدرب على التحرك بمشية سريعة)",
 "walking leaf": "حشرة ورقية (حشرة استوائية لها جسم مفلطح يشبه الورقة؛ شائعة في جنوب آسيا وجزر الهند الشرقية) / سرخس ماشي, ورقة ماشية (سراخس ذات سعف رمحي يتجذر عند الطرف)",
 "walking on air": "سعادة قصوى, غبطة (حالة من السعادة الغامرة)",
 "walking papers": "إشعار بالطرد ((غير رسمي) إشعار بالفصل أو التسريح)",
 "walking shoe": "حذاء المشي الرياضي (حذاء خفيف مريح مصمم للمشي القوي)",
 "walking stick": "عَصَايَة, خَيْزُرَانَة",
 "walkingstick": "حشرة عصوية (أي من الحشرات المتنوعة الاستوائية غالباً التي لها أجسام طويلة تشبه الأغصان)",
 "walkman": "جهاز ستيريو محمول, ووكمان ((علامة تجارية) نظام ستيريو بحجم الجيب مع سماعات أذن خفيفة الوزن)",
 "walkout": "مَسِيرَة",
 "walkover": "انحناء خلفي مع الوقوف على اليدين, شقلبة ماشية (دمج بين الانحناء الخلفي والوقوف على اليدين) / أمر سهل, لعب أطفال (أي مشروع يسهل القيام به)\nمثال: تسويق هذا المنتج لن يكون نزهة",
 "walkway": "ممشى (مسار مخصص للمشي)\nمثال: بعد العاصفة الثلجية جرف الثلج من الممشى الأمامي",
 "walky-talky": "جهاز اتصال لاسلكي, ووكي توكي (وصلة راديو محمولة صغيرة (جهاز استقبال وإرسال))",
 "wall": "حَائِط, جِدَار / سُور, سور / جِدَار, حيط",
 "wall barley": "شعير الحائط (عشب حولي أوروبي يوجد غالباً كعشبة ضارة في الأراضي المهملة خاصة على طول جوانب الطرق والأسيجة)",
 "wall bracket": "حامل جداري, كتيفة (دعامة تبرز من الجدار (لحمل رف مثلاً))",
 "wall clock": "ساعة حائط (ساعة مثبتة على الحائط)",
 "wall creeper": "دابة الجدار (طائر مغرد قرمزي ورمادي يعيش في جدران المدن والمنحدرات الجبلية في جنوب أوراسيا وشمال أفريقيا)",
 "wall fern": "بوليبودي شائع, سرخس الجدار (سرخس صخري أو أرضي يشكل حصيرة بجذامير زاحفة وسعف ريشي كبير يوجد في جميع أنحاء أمريكا الشمالية وأوروبا وأفريقيا وشرق آسيا)",
 "wall germander": "جعدة الحائط (شجيرة أوروبية معمرة بزهور حمراء أرجوانية أو وردية زاهية مع بقع حمراء وبيضاء)",
 "wall hanging": "ستارة حائطية, معلقة (زينة تُعلق (مثل نسيج مزخرف) على الحائط أو فوق النافذة)\nمثال: كانت جدران القلعة الباردة مغطاة بالمعلقات",
 "wall mural": "جدارية ورقية (ورق حائط مطبوع زخرفي يوضع عادة على جدار واحد فقط؛ يمكن أن تكون الطباعة مخصصة أو مختارة من مجموعة محددة مسبقاً)",
 "wall of silence": "جدار الصمت, جدار الصمت الأزرق (سرية ضباط الشرطة الذين يكذبون أو يغضون الطرف لحماية ضباط شرطة آخرين)\nمثال: تصدع جدار الصمت عندما رفض بعض الضباط المشاركة في التستر",
 "wall painting": "جدارية, رسم جداري (لوحة يتم تطبيقها على سطح جدار)",
 "wall panel": "لوحة جدارية (تكسية تشكل جزءاً من الجدار)",
 "wall pellitory": "جدارية, حشيشة الزجاج (عشب ينمو في الشقوق له أوراق ضيقة طويلة وأزهار وردية صغيرة عديمة البتلات)",
 "wall pepper": "سيدوم لاذع, فلفل الجدار (سيدوم زاحف أوروبي طحلبي ذو زهور صفراء؛ تم إدخاله على نطاق واسع كغطاء أرضي)",
 "wall plate": "لوح حائط (لوح (عارضة خشبية على طول الجزء العلوي من الجدار) لدعم نهايات الروافد وتوزيع الحمل)",
 "wall plug": "مأخذ كهربائي, مِقبس جداري (مقبس يوفر مكاناً في نظام الأسلاك يمكن منه أخذ التيار لتشغيل الأجهزة الكهربائية)",
 "wall rock": "صَخْرُ الجِدَار (صخرة ملاصقة مباشرة لعرق أو صدع)",
 "wall rocket": "جَهَق, خَفَج",
 "wall rue": "سذاب الجدار, طحال سذاب الجدار (طحال رقيق صغير يوجد على منحدر حاد (كجدار أو جرف) في أوراسيا وأمريكا الشمالية)",
 "wall rue spleenwort": "سذاب الجدار, طحال سذاب الجدار (طحال رقيق صغير يوجد على منحدر حاد (كجدار أو جرف) في أوراسيا وأمريكا الشمالية)",
 "wall socket": "مِقْبَس",
 "wall street": "وول ستريت (يستخدم للإشارة إلى صناعة الأوراق المالية في الولايات المتحدة)",
 "wall tent": "خيمة جدارية (خيمة قماشية بأربعة جدران عمودية)",
 "wall unit": "مكتبة حائطية, وحدة حائطية (قطعة أثاث تتكون من عدة وحدات توضع بمحاذاة أحد جدران الغرفة)",
 "wall-paperer": "عامل ورق الحائط, لاصق ورق الجدران (عامل يقوم بلصق الورق على الجدران)",
 "wallaby": "ولب (أي من كنغر صغير أو متوسط الحجم متنوع؛ غالباً ما يكون زاهي الألوان)",
 "wallachia": "اَلأَفْلَاق",
 "wallah": "مسؤول, والي (عادة في تركيبة: شخص مسؤول عن أو يعمل في شيء معين)\nمثال: مسؤول المطبخ",
 "wallboard": "دريوال, لوح جداري (لوح مسطح عريض يستخدم لتغطية الجدران أو القواطع؛ مصنوع من الجص أو لب الخشب أو مواد أخرى ويستخدم بشكل أساسي لتشكيل الجدران الداخلية للمنازل)",
 "wallet": "مِحْفَظَة, حَافِظَة",
 "wallet calendar": "تقويم جيب, مفكرة جيب (تقويم صغير مصمم ليوضع في الجيب أو المحفظة؛ يأتي في إصدارات مختلفة، من بطاقة بلاستيكية بسيطة إلى كتيب أو دفتر ملاحظات)\nمثال: جدي لا يزال يستخدم تقويمات الجيب",
 "walleye": "الوالي, سمك الجاحظ (أسماك فرخ المياه العذبة تشبه الكراكي) / حول خارجي, حول وحشي (حول تتجه فيه إحدى العينين أو كلتيهما إلى الخارج)",
 "walleyed": "أحول (للخارج) (لديه حول خارجي (تباعد العينين))",
 "walleyed pike": "الوالي, سمك الجاحظ (أسماك فرخ المياه العذبة تشبه الكراكي)",
 "wallflower": "خَيْرِيّ, قَصِيصَة",
 "wallis and futuna": "وَالِس وَفُوتُونَا",
 "walloon": "الوالونية (لهجة فرنسية يتم التحدث بها في بلجيكا والأجزاء المجاورة من فرنسا) / والوني (فرد من الشعب الناطق بالفرنسية الذي يعيش في بلجيكا)",
 "walloons": "والونيون (مجموعة عرقية تتحدث لهجة فرنسية وتعيش في جنوب وشرق بلجيكا والأجزاء المجاورة من فرنسا)",
 "wallop": "ضربة مبرحة (ضربة شديدة) / تأثير, وقع (عاقبة قوية؛ تأثير قوي)\nمثال: كان للكتاب تأثير مهم على تفكيري",
 "walloper": "فرية, كذبة كبيرة (كذبة فادحة؛ كذبة صارخة) / فائز ساحق (فائز بفارق كبير) / ضارب عنيف (ضارب قوي جداً)",
 "walloping": "ضَخْم جِدًّا ((غير رسمي) كبير جداً) / سحق, هزيمة نكراء (هزيمة قوية)",
 "wallow": "تَمَرَّغَ",
 "wallpaper": "وَرَق حَائِط, خَلْفِيَّة (ما ينمو على النبات من الأعلى والجوانب بشكل صفائح ذات لون أخضر أو مائل إلى الخضرة. انظر الصورة؛ جلود رقاق يُكتَبُ عليها)\nمثال: هات ورقة بيضاء.",
 "wallpaperer": "عامل ورق الحائط, لاصق ورق الجدران (عامل يقوم بلصق الورق على الجدران)",
 "walls have ears": "اَلْجِدْرَانُ لَهَا آذَانٌ, لِلْحِيطَانِ آذَانٌ",
 "wally": "أحمق (شخص سخيف وغير كفء؛ شخص يعتبر غبياً)",
 "walnut": "جَوْز (جَوَّز لَهُمْ إِبِلَهم إِذا قَادَهَا بَعِيرًا بَعِيرًا حَتَّى تَجُوزَ)\nمثال: نريد أن نأكل نبات جوز الهند.",
