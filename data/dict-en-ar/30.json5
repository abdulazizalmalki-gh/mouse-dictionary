 "vector sum": "محصلة المتجهات (متجه هو مجموع متجهين آخرين أو أكثر)",
 "vector-borne transmission": "انْتِقَال عَبْرَ نَاقِل (انتقال غير مباشر لعامل معدٍ يحدث عندما يعض ناقل شخصاً أو يلمسه)",
 "veda": "الأدب الفيدي, الفيدا (أي من أقدم الكتابات المقدسة للهندوسية المكتوبة بالسنسكريتية المبكرة)",
 "vedalia": "فيداليا (موطنها أستراليا؛ أدخلت في أماكن أخرى لمكافحة الحشرات القشرية)",
 "vedanta": "فيدانتا ((من السنسكريتية 'نهاية الفيدا') واحد من ستة أنظمة فلسفية أرثوذكسية أو وجهات نظر متجذرة في الأوبنشاد على عكس الميمامسا التي تعتمد على الفيدا…)",
 "vedic": "فيدي (متعلق بالفيدا أو بالسنسكريتية القديمة التي كتبت بها)\nمثال: الأدب الفيدي",
 "vedic literature": "الأدب الفيدي, الفيدا (أي من أقدم الكتابات المقدسة للهندوسية المكتوبة بالسنسكريتية المبكرة)",
 "vedism": "فيديه (شكل الهندوسية الذي يدور بشكل أساسي حول النسخة الأسطورية والأيديولوجيات الطقسية في الفيدا)",
 "vedist": "فيداني (باحث أو خبير في الفيدات (الكتب المقدسة الهندوسية))",
 "vee": "ڤِي / وِي / فِي (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "veering": "انحراف مفاجئ, زيغ (عملية الانحراف جانباً فجأة)",
 "veery": "سمنة فيري (سمنة بنية مصفرة من أمريكا الشمالية تشتهر بتغريدها)",
 "veg": "خضار, خضراوات (بذور أو جذور أو سيقان أو أوراق أو أبصال أو درنات أو ثمار غير حلوة صالحة للأكل من العديد من النباتات العشبية)",
 "vega": "اَلنَّسْر اَلْوَاقِع",
 "vegan": "خُضْرِيّ",
 "veganism": "خُضْرِيَّة, نَبَاتِيَّة صِرْفَة",
 "vegetable": "نَبَات, بَقْلَة (مصدر للفعل نَبَتَ؛ اسم جنس شامل لكل ما تنبته الأرض من شجر أو بقل أو عشب أو غيره) / خُضَر, خُضَار (خَضَر الرجلُ النَّخْلَ خَضَر ُ خَضْرًا: قطعه) / نَبَاتِيّ / خَضْرَاوِيّ\nمثال: هذا النبات مهدد بالانقراض.",
 "vegetable garden": "حَديقة الخُضار (الحَديقَةُ، الرَّوْضَةُ ذاتُ الشجرِ؛ حديقة , العاطل عن العمل في اللهجة العراقية وأصل تولد المعنى أن بعض العاطلين يقضون أوقاتهم في العناية بحدائق بيوتهم, فإذا سألهم سائل عن عملهم, ما هو؟…)\nمثال: ليس لدينا حديقة.",
 "vegetable hummingbird": "سيسبان كبير الأزهار, طائر الطنان النباتي (شجرة خشب لينة ذات عناقيد رخوة من الزهور الحمراء أو الوردية عادة؛ موطنها أستراليا الاستوائية وآسيا؛ وتم توطينها في جنوب فلوريدا وجزر الهند الغربية)",
 "vegetable ivory": "جوز العاج, عاج نباتي (بذرة تشبه الجوز لنخيل أمريكي جنوبي؛ القشرة البيضاء الصلبة تأخذ تلميعاً عالياً وتستخدم للأزرار مثلاً)",
 "vegetable lamb": "نَبْتَة الْحَمَل التَّتَارِيَّة",
 "vegetable marrow": "قرع, قرع الكوسا (قرع طويل كبير ذو قشور كريمية إلى خضراء عميقة) / قرع نباتي, كوسة (أي من نباتات القرع المختلفة التي تزرع لثمارها الممدودة ذات القشرة الخضراء الداكنة واللب الأبيض)",
 "vegetable matter": "مادة نباتية (مادة تنتجها النباتات أو تنمو بطريقة نمو النبات)",
 "vegetable oil": "زيت نباتي (أي من مجموعة الدهون السائلة الصالحة للأكل التي يتم الحصول عليها من النباتات)",
 "vegetable oyster": "سلسفي أبيض (سلسفي أبيض طويل) / تيس الجبل, ساسفي (عشب متوسطي ثنائي الحول برؤوس طويلة العنق من أزهار شعاعية أرجوانية وعصارة لبنية وجذر طويل صالح للأكل؛ مستوطن في جميع أنحاء الولايات المتحدة)",
 "vegetable patch": "حديقة خضروات, حديقة منزلية (حديقة صغيرة تُزرع فيها الخضروات)",
 "vegetable sheep": "خروف نباتي, هاستيا (عشب نيوزيلندي يشكل وسائد وله أوراق مغطاة بكثافة بشعيرات سمراء مصفرة) / خروف نباتي, راوليا (عشب معمر منبسط يشكل حصيرة بأوراق صوفية شائبة)",
 "vegetable silk": "قطن حريري, كابوك (ألياف نباتية من شجرة الكابوك؛ تستخدم للحشو والعزل)",
 "vegetable soup": "حساء الخضروات, مينستروني (حساء مصنوع من مجموعة متنوعة من الخضروات)",
 "vegetable sponge": "لوف, ليفة نباتية (متسلقة اللوف التي لها ثمار أسطوانية)",
 "vegetable tallow": "شحم نباتي (دهن شمعي يتم الحصول عليه من نباتات معينة (مثل التوت البري) ويستخدم كشحم)",
 "vegetable wax": "شمع نباتي (مادة شمعية يتم الحصول عليها من النباتات (خاصة من جذوع بعض أنواع النخيل))",
 "vegetal": "خُضْرِيّ, نَبَاتِيّ التَّكَاثُر ((عن التكاثر) يتّسم بعمليات لاجنسية) / نباتي (يتكون من نباتات أو غطاء نباتي)\nمثال: مناطق غنية بالمنتجات النباتية",
 "vegetarian": "نَبَاتِيّ",
 "vegetarianism": "نَباتِيَّة",
 "vegetation": "خُضْرَة, عَشَابَة",
 "vegetation unit": "وحدة نباتية (رقعة مميزة أو مجموعة من النباتات يمكن تمييزها عن الوحدات الأخرى)",
 "vegetational": "نباتي (يتكون من نباتات أو غطاء نباتي)\nمثال: مناطق غنية بالمنتجات النباتية",
 "vegetative": "خُضْرِيّ, نَبَاتِيّ التَّكَاثُر ((عن التكاثر) يتّسم بعمليات لاجنسية) / خُضْرِيّ, نَبَاتِيّ (مُتَعَلِّقٌ بِالوَظَائِفِ الجَسَدِيَّةِ اللَّاإِرَادِيَّة) / إنباتي, خامل (متعلق بنشاط سلبي ورتيب) / نباتي (يتكون من نباتات أو غطاء نباتي)\nمثال: نمط حياة إنباتي ممل",
 "vegetative cell": "خلية إنباتية, خلية جسدية (أي من خلايا النبات أو الحيوان باستثناء الخلايا التناسلية؛ خلية لا تشارك في إنتاج الأمشاج)\nمثال: تنتج الخلايا الجسدية من خلايا موجودة مسبقاً",
 "vegetive": "إنباتي, خامل (متعلق بنشاط سلبي ورتيب)\nمثال: نمط حياة إنباتي ممل",
 "veggie": "خضار, خضراوات (بذور أو جذور أو سيقان أو أوراق أو أبصال أو درنات أو ثمار غير حلوة صالحة للأكل من العديد من النباتات العشبية)",
 "vehemence": "تأكيد, حدة (شدة أو قوة التعبير) / ضراوة, عنف (خاصية كون الشيء جامحاً أو مضطرباً)\nمثال: حدة إنكاره",
 "vehement": "جَامِح, حَادّ (يَتَّسِمُ بِشِدَّةٍ مُتَطَرِّفَةٍ فِي المَشَاعِرِ أَوِ القَنَاعَات؛ يَمِيلُ إِلَى رَدِّ الفِعْلِ العَنِيف) / جَارِف, عَارِم (يتميز بقوة أو طاقة عظيمة وشدة كبيرة)",
 "vehemently": "بحدة, بشدة (بطريقة عنيفة أو شديدة)\nمثال: نفى بشدة الاتهامات الموجهة إليه",
 "vehicle": "وَاسِطَة, وَسِيلَة",
 "vehicle traffic": "حركة المركبات (تجمع المركبات القادمة والذاهبة في منطقة معينة)",
 "vehicle-borne transmission": "انْتِقَال عَبْرَ وَسِيط (انتقال غير مباشر لعامل معدٍ يحدث عندما يلمس وسيط (أو أداة ملوثة) جسم الشخص أو يتم ابتلاعه)",
 "vehicular": "مركبي (من أو متعلق بـ أو مخصص للمركبات (ذات المحركات))\nمثال: حركة المركبات",
 "vehicular traffic": "حركة المركبات (تجمع المركبات القادمة والذاهبة في منطقة معينة)",
 "veil": "حِجَاب, خِمَار (الغطاء أو الساتر؛ يُطلق مجازا على لباس المرأة الذي يستر جميع جسمها)\nمثال: ارتدت أمها الحجاب.",
 "veiled": "مَكْتُوم, مُحْتَجِب (مُخَفَّف أَوْ غَيْر وَاضِح) / محتجب, مستتر (لديه أو يبدو كأن لديه حجاب أو غطاء خافٍ)\nمثال: راقصة محتجبة",
 "veiled accusation": "اتهام ضمني, اتهام مبطن (اتهام يُفهم دون الحاجة إلى التعبير عنه بالكلمات)",
 "veiling": "شبك, طرحة (شبكة من قماش شفاف بنسج مفتوح فضفاض)",
 "vein": "وَرِيد, عِرْق",
 "vein of penis": "وريد القضيب (وريد يخدم القضيب)",
 "veinal": "عرقي, عروقي (يتعلق بعروق النباتات)\nمثال: أوراق مصابة بفسيفساء عرقية",
 "veined": "مُعَرَّق (ذو علامات تُشبه العروق أو يُظهرها)",
 "veinlike": "مُعَرَّق (ذو علامات تُشبه العروق أو يُظهرها)",
 "vela": "الشراع",
 "velar": "طَبَقِيّ",
 "velar consonant": "صوت طبقي (صامت يُنتج بلمس مؤخرة اللسان للحنك الرخو أو الاقتراب منه)",
 "velban": "فيلبان, فينبلاستين (مشتق نبات العناقية يستخدم كدواء مضاد للأورام (الاسم التجاري فيلبان) يعطل انقسام الخلايا)",
 "velcro": "فِيلْكْرُو",
 "veld": "فيلد (أرض عشبية مفتوحة مرتفعة في جنوب أفريقيا)",
 "veldt": "فيلد (أرض عشبية مفتوحة مرتفعة في جنوب أفريقيا)",
 "velleity": "إرادة واهنة, رغبة ضعيفة (الإرادة في أضعف صورها) / رغبة ضعيفة (مجرد أمنية، غير مصحوبة بجهد للحصول عليها)",
 "vellication": "ارتعاش, نفضة (تشنج عضلي مفاجئ؛ خاصة الناتج عن حالة عصبية)",
 "vellum": "رِقّ ناعم (رق ناعم محضر من جلد حيوان صغير مثل العجل أو الحمل) / فيلوم, ورق الرق (ورق ثقيل كريمي اللون يشبه الرق)",
 "velocipede": "دراجة ثلاثية العجلات (مركبة بثلاث عجلات يتم تحريكها بواسطة دواسات القدم) / فيلوسيبيد (أي من الدراجات القديمة المتنوعة ذات الدواسات على العجلة الأمامية)",
 "velociraptor": "فيلوسيرابتور (آكل لحوم صغير نشط ربما كان يتغذى على البروتوسيراتوبس؛ ربما يرتبط بالطيور بشكل أوثق من الديناصورات الأخرى)",
 "velocity": "سُرْعَة, سُرْعَة مُتَّجِهَة (المسافة المقطوعة لكل وحدة زمنية)",
 "velodrome": "فيلودروم (مضمار بيضاوي مائل لسباق الدراجات أو الدراجات النارية)",
 "velour": "فيلور, قطيفة (قماش ثقيل يشبه المخمل)",
 "velours": "فيلور, قطيفة (قماش ثقيل يشبه المخمل)",
 "veloute": "فيلوتيه (صلصة بيضاء مصنوعة بالمرق بدلاً من الحليب)",
 "velum": "حنك رخو (سديلة عضلية تغلق البلعوم الأنفي أثناء البلع أو الكلام) / حجاب (غطاء غشائي متصل بالجسم الثمري غير الناضج لبعض الفطريات)",
 "velveeta": "فيلفيتا (جبن أمريكي معالج طري)",
 "velvet": "مُخْمَل, قَطِيفَة",
 "velvet ant": "نمل مخملي",
 "velvet bean": "فاصولياء مخملية, ميقونة (كرمة خشبية حولية من آسيا لها عناقيد طويلة من الزهور الأرجوانية وقرون مشعرة كثيفة؛ تزرع في جنوب الولايات المتحدة للسماد الأخضر والرعي)",
 "velvet bent": "أغروستيس مخملي, عشبة منحنية مخملية (عشبة شائعة بسيقان نحيلة وأوراق ضيقة)",
 "velvet bent grass": "أغروستيس مخملي, عشبة منحنية مخملية (عشبة شائعة بسيقان نحيلة وأوراق ضيقة)",
 "velvet flower": "حب الحب, زهرة القطيفة (تستخدم الأوراق الصغيرة على نطاق واسع كخضروات ورقية؛ تستخدم البذور كحبوب)",
 "velvet grass": "ضباب يوركشاير, عشب مخملي (عشب أوروبي معمر طويل له ساق مخملية؛ توطن في الولايات المتحدة ويستخدم للعلف)",
 "velvet osier": "صفصاف السلال, صفصاف القنب (صفصاف بغصينات مرنة طويلة تستخدم في صناعة السلال)",
 "velvet plant": "جينورا برتقالية, نبات المخمل (نبات ورقي جاوي يُزرع لأوراقه المخملية الجميلة ذات الشعيرات البنفسجية الأرجوانية) / آذان الدب, بوصير",
 "velvet sumac": "سماق قرن الوعل, سماق مخملي (شجرة شجيرية متساقطة الأوراق في شرق أمريكا الشمالية بأوراق مركبة تتحول إلى اللون الأحمر اللامع في الخريف وعناقيد كثيفة من الزهور الصفراء المخضرة تليها…)",
 "velvet worm": "حاملات المخالب, دودة مخملية (أي من الحيوانات آكلة اللحوم العديدة التي تشبه الديدان ذات الجلد المخملي الشائعة في الغابات الاستوائية ولها خصائص كل من المفصليات والديدان الحلقية)",
 "velvet-leaf": "أبو طيلون, خبازة هندية (عشب حولي طويل أو شجيرة صغيرة من آسيا الاستوائية بأوراق مخملية وزهور صفراء وينتج أليافاً قوية) / خبازة شجرية, ورقة المخمل (شجيرة معمرة شجرية ذات أوراق فروية مفصصة كفياً وأزهار حمراء أرجوانية مبهرجة؛ جنوب غرب الولايات المتحدة)",
 "velvet-textured": "مُخْمَلِيّ, نَاعِمٌ كَالْمُخْمَلِ (ناعم ولطيف للنظر أو السمع أو اللمس أو الذوق)",
 "velveteen": "مخمل قطني (قماش عادة ما يكون قطنياً بوبر قصير يقلد المخمل)",
 "velvetiness": "مخملية (جودة المخمل: مظهر أو ملمس أو طعم مخملي)\nمثال: كان رقيقاً وبدا وكأنه سيركز اهتماماً خاصاً على مخملية بشرتها",
 "velvetleaf": "أبو طيلون, خبازة هندية (عشب حولي طويل أو شجيرة صغيرة من آسيا الاستوائية بأوراق مخملية وزهور صفراء وينتج أليافاً قوية) / خبازة شجرية, ورقة المخمل (شجيرة معمرة شجرية ذات أوراق فروية مفصصة كفياً وأزهار حمراء أرجوانية مبهرجة؛ جنوب غرب الولايات المتحدة)",
 "velvetweed": "أبو طيلون, خبازة هندية (عشب حولي طويل أو شجيرة صغيرة من آسيا الاستوائية بأوراق مخملية وزهور صفراء وينتج أليافاً قوية)",
 "velvety": "مَخْمَلِيّ (ناعِم وأمْلَس كالمَخْمَل في المَلْمَس) / مُخْمَلِيّ, نَاعِمٌ كَالْمُخْمَلِ (ناعم ولطيف للنظر أو السمع أو اللمس أو الذوق)",
 "velvety-furred": "مُخْمَلِيّ الشَّعْر (ذو شعر ناعم يشبه المخمل في ملمسه)",
 "velvety-haired": "مُخْمَلِيّ الشَّعْر (ذو شعر ناعم يشبه المخمل في ملمسه)",
 "velvety-plumaged": "مَخْمَلِيّ الرِّيش (ذُو رِيش يُشْبِه المَخْمَل فِي نُعُومَتِه)",
 "velvety-skinned": "مُخْمَلِيُّ الجِلْدِ (لَهُ جِلْدٌ كَالمُخْمَلِ)",
 "vena": "وريد (وعاء دموي يحمل الدم من الشعيرات الدموية باتجاه القلب)\nمثال: تحمل جميع الأوردة دماً غير مؤكسج باستثناء الوريد الرئوي",
 "vena anastomotica": "وريد مفاغر (أي من وريدين متصلين يخدمان الدماغ)",
 "vena angularis": "وريد زاوي (وريد قصير يتكون من الوريد فوق الحجاج والوريد فوق البكرة ويستمر كوريد وجهي)",
 "vena appendicularis": "وريد زائدي (وريد يرافق الشريان الزائدي ويصب في الوريد اللفائفي القولوني)",
 "vena arcuata renis": "وريد مقوس للكلية (أوردة تتلقى الدم من الأوردة بين الفصيصات في الكلية والوريدات المستقيمة)",
 "vena auricularis": "وريد أذني (واحد من وريدين يخدمان منطقة الأذن)",
 "vena axillaris": "وريد إبطي (استمرار للوريد الباسلي والوريد العضدي يصبح الوريد تحت الترقوة)",
 "vena azygos": "وريد أزيغوس, وريد فرد (أحد أجهزة الأوردة التي تصرف جدران الصدر والبطن؛ ينشأ كاستمرار للوريد القطني الصاعد الأيمن وينتهي في الوريد الأجوف العلوي)",
 "vena basalis": "وريد قاعدي (وريد كبير يمر على طول السطح الأنسي للفص الصدغي ويصب في الوريد المخي الكبير)",
 "vena basilica": "وريد باسلي (وريد يصرف ظهر اليد والساعد ويصب في الوريد الإبطي)",
 "vena basivertebralis": "وريد قاعدي فقري (واحد من عدة أوردة تصرف المادة الإسفنجية للفقرات وتصب في الضفيرة الوريدية الفقرية الداخلية الأمامية)",
 "vena brachialis": "وريد عضدي (وريدان في كل ذراع يرافقان الشريان العضدي ويصبان في الوريد الإبطي)",
 "vena brachiocephalica": "وريد عضدي رأسي, وريد لا اسم له (أوردة تتكون من اتحاد الوريد الوداجي الباطن والوريد تحت الترقوة)",
 "vena bronchialis": "وريد قصبي (أوردة تخدم القصبات الهوائية؛ تصب في الوريد الفرد)",
 "vena bulbi penis": "وريد بصلة القضيب (وريد رأس القضيب؛ رافد للوريد الفروجي الداخلي الذي يصرف العجان)",
 "vena bulbi vestibuli": "وريد بصلة الدهليز (وريد البصلة الدهليزية)",
 "vena canaliculi cochleae": "وريد نفيق القوقعة (وريد القناة القوقعية)",
 "vena cava": "وريد أجوف (أي من وريدين كبيرين يعيدان الدم المستنفد للأكسجين إلى الأذين الأيمن للقلب)",
 "vena centralis glandulae suprarenalis": "وريد الغدة الكظرية المركزي (وريد تصريف وحيد؛ على اليمين يصب في الوريد الأجوف السفلي؛ وعلى اليسار يصب في الوريد الكلوي الأيسر)",
 "vena centralis retinae": "وريد الشبكية المركزي (وريد يتكون من اتحاد أوردة الشبكية؛ يرافق الشرايين المركزية للشبكية في العصب البصري)",
 "vena cephalica": "وريد رأسي (وريد كبير في الذراع يصب في الوريد الإبطي)",
 "vena cephalica accessoria": "وريد رأسي إضافي (وريد يمر على طول الحافة الكعبرية للساعد وينضم إلى الوريد الرأسي بالقرب من المرفق)",
 "vena cerebellum": "وريد مخيخي (الأوردة التي تصرف المخيخ)",
 "vena cerebri": "وريد مخي (أي من عدة أوردة تخدم نصفي الكرة المخية)",
 "vena cerebri anterior": "وريد مخي أمامي (يرافق الشريان المخي الأمامي ويصب في الوريد القاعدي)",
 "vena cerebri magna": "وريد غالين, وريد مخي كبير (وريد مخي يتكون من الوريدين المخيين الداخليين ويستمر في الجيب المستقيم)",
 "vena cerebri media": "وريد مخي أوسط (أي من وريدين مخيين)",
 "vena cerebrum internus": "وريد مخي باطن (وريدان مزدوجان يمران ذيلياً بالقرب من الخط الناصف ويتحدان لتشكيل الوريد المخي الكبير)",
 "vena cerebrum superior": "وريد مخي علوي (وريد مخي يصرف التحدب الظهري لنصف الكرة المخية ويصب في الجيب الكهفي)",
 "vena cervicalis profunda": "وريد رقبي, وريد رقبي عميق (وريد يرافق شرياناً بنفس الاسم)",
 "vena choroidea": "وريد مشيموي (أي من وريدين يخدمان الغلاف المشيمي للعين)",
 "vena circumflexa": "وريد منعطف (أي من عدة أوردة متوازية منحنية ترافق شرايين بنفس الاسم)",
 "vena circumflexa ilium": "وريد حرقفي منعطف (يرافق الشريان الذي يحمل نفس الاسم)",
 "vena circumflexus femoris": "وريد فخذي منعطف (أي من وريدين يرافقان شرايين بنفس الاسم تخدم الورك والفخذ)",
 "vena clitoridis": "وريد بظري (أوردة تخدم البظر)",
 "vena colica": "وريد قولوني (وريد يخدم الأمعاء الغليظة)",
 "vena comitans": "وريد مرافق (وريد يرافق بنية أخرى؛ قد يرافق الوريد شرياناً بطريقة تساعد فيها النبضات الشريانية على العودة الوريدية)",
 "vena cutanea": "وريد جلدي (واحد من عدد من الأوردة في النسيج تحت الجلد التي تصب في الأوردة العميقة)",
 "vena cystica": "وريد مراري (وريد يصرف المرارة)",
 "vena digitalis": "وريد إصبعي (واحد من الأوردة التي تخدم الأصابع أو أصابع القدم)",
 "vena diploica": "وريد ضعفاني (واحد من الأوردة التي تخدم الجزء الإسفنجي من عظام القحف)",
 "vena dorsalis clitoridis profunda": "وريد بظري ظهري عميق (الوريد الظهري العميق للبظر؛ رافد للضفيرة الوريدية المثانية)",
 "vena emissaria": "وريد مشبكي (واحد من عدة أوردة واصلة في فروة الرأس والرأس تصرف الدم من الجيوب في الأم الجافية إلى الأوردة خارج الجمجمة)",
 "vena epigastrica inferior": "وريد شرسوفي سفلي (يصب في الوريد الحرقفي الظاهر)",
 "vena epigastrica superficialis": "وريد شرسوفي سطحي (يصب في الوريد الصافن الكبير)",
 "vena ethmoidalis": "وريد غربالي (أوردة تصرف الجيوب الغربالية وتصب في الوريد العيني العلوي)",
 "vena facialis": "وريد وجهي (أي من عدة أوردة تصرف الوجه)",
 "vena facialis anterior": "وريد وجهي أمامي (استمرار للوريد الزاوي؛ يتحد مع الوريد خلف الفك السفلي قبل أن يصب في الوريد الوداجي الباطن)",
 "vena femoralis": "وريد فخذي (وريد يرافق الشريان الفخذي في نفس الغمد؛ وهو استمرار للوريد المأبضي؛ يصبح الوريد الحرقفي الظاهر)",
 "vena gastrica": "وريد معدي (واحد من عدة أوردة تصرف جدران المعدة)",
 "vena gastrica sinistra": "وريد معدي أيسر (ينشأ من اتحاد أوردة من فؤاد المعدة؛ يمتد في الثرب الصغير؛ يصب في الوريد البابي)",
 "vena gastrica-dextra": "وريد بوابي, وريد معدي أيمن (يتلقى أوردة من الأسطح العلوية للمعدة ويصب في الوريد البابي)",
 "vena gastroomentalis": "وريد معدي ثربي (واحد من وريدين يخدمان الانحناء الكبير للمعدة)",
 "vena genus": "وريد ركبي (أوردة تصرف الدم من التراكيب حول الركبة؛ تصب في الوريد المأبضي)",
 "vena gluteus": "وريد ألوي (أوردة تصرف العضلات الألوية على جانبي الجسم)",
 "vena hemiazygos accessoria": "وريد نصف فرد إضافي (وريد يتكون من اتحاد الأوردة الوربية الخلفية الرابعة إلى السابعة؛ يصب في الوريد الفرد)",
 "vena hemizygos": "وريد نصف فرد (استمرار للوريد القطني الصاعد الأيسر؛ يعبر الخط الناصف عند الفقرة الثامنة ويصب في الوريد الفرد)",
 "vena hepatica": "وريد كبدي (وريد يصرف الكبد؛ يصب في الوريد الأجوف)",
 "vena ileocolica": "وريد لفائفي قولوني (وريد يصرف نهاية اللفائفي والزائدة الدودية والأعور والجزء السفلي من القولون الصاعد)",
 "vena iliaca": "وريد حرقفي (واحد من ثلاثة أوردة تصرف منطقة الحوض)",
 "vena iliolumbalis": "وريد حرقفي قطني (فرع من الوريد الحرقفي الباطن)",
 "vena intercapitalis": "وريد بين الرؤوس (أوردة تربط الأوردة الظهرية والراحية لليد أو الأوردة الظهرية والأخمصية للقدم)",
 "vena intercostalis": "وريد بين الضلوع, وريد ورابي (عدة أوردة تصرف المسافات الوربية للقفص الصدري)",
 "vena intervertebralis": "وريد بين الفقرات (واحد من عدة أوردة ترافق الأعصاب الشوكية)",
 "vena jugularis": "وريد وداجي (أوردة في الرقبة تعيد الدم من الرأس)",
 "vena labialis": "وريد شفوي (وريد يصرف شفاه الفم) / وريد شفري (أوردة تصرف شفاه الفرج)",
 "vena labialis inferior": "وريد شفوي سفلي (رافد للوريد الوجهي يصرف الشفة السفلى)",
 "vena labialis superior": "وريد شفوي علوي (رافد للوريد الوجهي يصرف الشفة العليا)",
 "vena lacrimalis": "وريد دمعي (يصرف الغدة الدمعية؛ يصب في الوريد العيني العلوي)",
 "vena laryngea": "وريد حنجري (واحد من وريدين يصرفان الحنجرة)",
 "vena lienalis": "وريد طحالي (وريد يتكون من عدة أوردة صغيرة على سطح الطحال؛ ينضم إلى الوريد المساريقي العلوي لتكوين الوريد البابي)",
 "vena lingualis": "وريد لساني (وريد يتلقى الدم من اللسان وقاع الفم ويصب في الوريد الوداجي الباطن أو الوريد الوجهي)",
 "vena lumbalis": "وريد قطني (أوردة تصرف جدار الجسم الخلفي والضفائر الوريدية الفقرية القطنية)",
 "vena maxillaris": "وريد فكي علوي (الاستمرار الخلفي للضفيرة الجناحية؛ ينضم إلى الوريد الصدغي السطحي لتكوين الوريد خلف الفك السفلي)",
 "vena mesenterica": "وريد مساريقي (رافد للوريد البابي يمر من الأمعاء بين طبقتي المساريق)",
 "vena metacarpus": "وريد سنعي (أوردة ظهرية وراحية لليد)",
 "vena metatarsus": "وريد مشطي (فروع ظهرية وأخمصية للأوردة التي تخدم منطقة مشط القدم)",
 "vena musculophrenica": "وريد عضلي حجابي (أوردة تصرف جدار البطن العلوي والمسافات الوربية السفلية والبطن)",
 "vena nasalis externa": "وريد أنفي خارجي (واحد من الأوردة التي تصرف الأنف الخارجي وتصب في الوريد الزاوي أو الوجهي)",
 "vena nasofrontalis": "وريد أنفي جبهي (وريد يقع في الجزء الإنسي الأمامي من محجر العين؛ يربط الوريد العيني العلوي بالوريد الزاوي)",
 "vena obliqua atrii sinistri": "وريد الأذين الأيسر المائل (رافد للجيب التاجي؛ يقع على الجدار الخلفي للأذين الأيسر)",
 "vena obturatoria": "وريد سدادي (وريد يتكون من اتحاد الروافد التي تصرف مفاصل الورك وعضلات الفخذ؛ يصب في الوريد الحرقفي الباطن)",
 "vena occipitalis": "وريد قذالي (وريد يصرف المنطقة القذالية)",
 "vena ophthalmica": "وريد عيني (أي من وريدين يخدمان العين؛ يصب في الجيب الكهفي)",
 "vena ovarica": "وريد مبيضي (واحد من الأوردة التي تصرف المبيضين؛ الأيمن يصب في الوريد الأجوف السفلي؛ والأيسر يصب في الوريد الكلوي الأيسر)",
 "vena palatina": "وريد حنكي (وريد يصرف منطقة الحنك ويصب في الوريد الوجهي)",
 "vena paraumbilicalis": "وريد مجاور للسرة (أوردة صغيرة تنشأ في الجلد حول السرة؛ تنتهي كأوردة بابية إضافية)",
 "vena pectoralis": "وريد صدري (أوردة تصرف العضلات الصدرية وتصب في الوريد تحت الترقوة)",
 "vena perforantis": "وريد ثاقب (أوردة ترافق الشرايين الثاقبة؛ تصرف عضلات الساق؛ تصب في الوريد الفخذي العميق)",
 "vena pericardiaca": "وريد تاموري (عدة أوردة صغيرة من التامور)",
 "vena peroneus": "وريد شظوي (ترافق الشرايين الشظوية؛ تنشأ في الكعب وتمتد صعوداً خلف الساق لتنضم إلى الأوردة الظنبوبية الخلفية للوريد المأبضي)",
 "vena pharyngeus": "وريد بلعومي (أوردة من الضفيرة البلعومية تصب في الوريد الوداجي الباطن)",
 "vena phrenica": "وريد حجابي (أي من وريدين يصرفان الحجاب الحاجز)",
 "vena poplitea": "وريد مأبضي (وريد ينشأ في الركبة ويصعد ليصبح الوريد الفخذي)",
 "vena portae": "وريد بابي, وريد بابي كبدي (وريد قصير يحمل الدم إلى الكبد)",
 "vena posterior ventriculi sinistri": "وريد البطين الأيسر الخلفي (ينشأ بالقرب من قمة القلب ويصب في الجيب التاجي)",
 "vena profunda penis": "وريد عميق للقضيب (وريد عميق للقضيب؛ يدخل الضفيرة البروستاتية)",
 "vena pulmanalis inferior": "وريد رئوي سفلي (أي من وريدين رئويين (أيسر وأيمن) يعيدان الدم من الفصوص السفلية للرئتين)",
 "vena pulmonalis": "وريد رئوي (أي من أربعة أوردة تحمل الدم الشرياني من الرئتين إلى الأذين الأيسر للقلب)",
 "vena pulmonalis superior": "وريد رئوي علوي (أي من وريدين رئويين (أيسر وأيمن) يعيدان الدم من الفصوص العلوية للرئتين)",
 "vena pylorica": "وريد ما قبل البواب (رافد للوريد المعدي الأيمن)",
 "vena radialis": "وريد كعبري (أوردة سطحية تصعد على الجانب الكعبري للساعد؛ تتحد مع الأوردة الزندية لتكوين الوريد العضدي)",
 "vena rectalis": "وريد باصوري, وريد مستقيمي (أي من عدة أوردة تصرف جدران القناة الشرجية والمستقيم)",
 "vena renalis": "وريد كلوي (أوردة ترافق الشرايين الكلوية؛ تفتح في الوريد الأجوف عند مستوى الفقرة القطنية الثانية)",
 "vena retromandibularis": "وريد خلف الفك السفلي (الفرع الخلفي للوريد الوجهي؛ يتكون من الأوردة الصدغية أمام الأذن)",
 "vena sacralis": "وريد عجزي (وريد المنطقة العجزية)",
 "vena saphena": "وريد صافن (أي من وريدين سطحيين رئيسيين في الساق يصرفان الدم من القدم)",
 "vena scapularis dorsalis": "وريد كتفي ظهري (وريد هو رافد للوريد تحت الترقوة أو الوريد الوداجي الظاهر ويرافق الشريان الكتفي النازل)",
 "vena scrotalis": "وريد صفني (أوردة تمر من كيس الصفن إلى الأوردة الفرجية)",
 "vena sigmoideus": "وريد سيني (روافد للوريد المساريقي السفلي؛ تصرف القولون السيني)",
 "vena spinalis": "وريد شوكي (أوردة تصرف الحبل الشوكي)",
 "vena sternocleidomastoidea": "وريد قصي ترقوي خشائي (يصرف العضلة القصية الترقوية الخشائية؛ يصب في الوريد الوداجي الباطن)",
 "vena stylomastoidea": "وريد إبري خشائي (وريد يصرف التجويف الطبلي ويصب في الوريد خلف الفك السفلي)",
 "vena subclavia": "وريد تحت الترقوة (استمرار للوريد الإبطي؛ ينضم إلى الوريد الوداجي الباطن لتكوين الوريد العضدي الرأسي)",
 "vena sublingualis": "وريد تحت اللسان (رافد للوريد اللساني)",
 "vena supraorbitalis": "وريد فوق الحجاج (يصرف مقدمة فروة الرأس؛ يتحد مع الوريد فوق البكرة لتكوين الوريد الزاوي)",
 "vena supratrochlearis": "وريد فوق البكرة (يصرف مقدمة فروة الرأس؛ يتحد مع الوريد فوق الحجاج لتكوين الوريد الزاوي)",
 "vena temporalis": "وريد صدغي (أي من عدة أوردة تصرف المنطقة الصدغية)",
 "vena testicularis": "وريد خصوي (وريد من الخصيتين)",
 "vena thoracica": "وريد صدري (أوردة تصرف الجدران الصدرية)",
 "vena thoracoepigastrica": "وريد صدري شرسوفي (وريد ينشأ من منطقة الوريد الشرسوفي السطحي ويفتح في الوريد الإبطي أو الوريد الصدري)",
 "vena thyroidea": "وريد درقي (أي من عدة أوردة صغيرة تصرف الدم من منطقة الغدة الدرقية)",
 "vena tibialis": "وريد ظنبوبي, وريد قصبة الساق (أوردة الساق السفلى؛ تصب في الوريد المأبضي)",
 "vena trachealis": "وريد رغامي (عدة أوردة صغيرة من الرغامى)",
 "vena ulnaris": "وريد زندي (أي من عدة أوردة في الساعد)",
 "vena umbilicalis": "وريد سري (وريد في الحبل السري؛ يعيد الدم المغذي من المشيمة إلى الجنين)",
 "vena vertebralis": "وريد فقري (وريد يمر عبر ثقوب الفقرات العنقية ويشكل ضفيرة حول الشريان الفقري؛ يصب في الوريد العضدي الرأسي)",
 "vena vertebralis accessoria": "وريد فقري إضافي (وريد يرافق الوريد الفقري ولكنه يمر عبر ثقبة النتوء المستعرض للفقرة العنقية السابعة ويصب في الوريد العضدي الرأسي)",
 "vena vertebralis anterior": "وريد فقري أمامي (وريد يرافق الشريان العنقي الصاعد ويصب في الوريد الفقري)",
 "vena vesicalis": "وريد مثاني (أوردة تصرف الضفيرة المثانية وتنضم إلى الأوردة الحرقفية الباطنة)",
 "vena vestibularis": "وريد دهليزي (أوردة تصرف الكييس والقريبة)",
 "vena vorticosum": "وريد دوامي (وريد يتكون من فروع من السطح الخلفي للعين والجسم الهدبي؛ يصب في الأوردة العينية)",
 "venae centrales hepatis": "أوردة مركزية للكبد (الفروع النهائية للأوردة الكبدية التي تقع في الفصيصات الكبدية وتتلقى الدم من الجيوب الكبدية)",
