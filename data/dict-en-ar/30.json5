 "veridical": "صَادِق, مُوَافِقٌ لِلوَاقِع (يتطابق مع الواقع والحقيقة)",
 "verifiability": "قَابِلِيَّة التَّحَقُّق (حالة أو خاصية كون الشيء قابلاً للتحقق منه وتأكيده)",
 "verifiable": "قَابِلٌ لِلتَّحَقُّق, قَابِلٌ لِلتَّكْذِيب (يمكن اختباره (التحقّق منه أو تكذيبه) بالتجربة أو الملاحظة) / قَابِل لِلتَّحَقُّق (يمكن التثبّت من صحّته)",
 "verification": "إثبات, تأكيد (دليل إضافي على أن شيئاً كان يُعتقد (حقيقة أو فرضية أو نظرية) صحيح) / تحقق, توثيق ((في القانون) إقرار مرفق ببيان يؤكد صحة ذلك البيان)\nمثال: قدمت الحفريات تأكيداً إضافياً لنظرية التطور",
 "verificatory": "تَأْكِيدِيّ, مُؤَيِّد (يُستخدم لدعم أو تأييد أو تأكيد صحة شيء)",
 "verified": "مُتَحَقَّق مِنْهُ, مُوَثَّق (ثبتت صحّته بالدليل)",
 "verifier": "ضامن, مزكٍّ (شخص يضمن آخر أو يشهد بصحة بيان ما)",
 "verify": "أَكَّدَ (أكَّد الخبرَ ونحوه :صرّح بصحَّته؛ أَكَدَّ : قَرَّرَ، أَثْبَتَ، وثَّقَ) / حَقَّقَ (حَقَّقَ (الأمرَ): أثبتَه وصدَّقَه؛ ويقال: حَقَّقَ الظنَّ، وحَقَّقَ القولَ والقضيّةَ؛ حَقَّقَ (الشيءَ والأمرَ): أحكمه؛ ويقال: حَقَّقَ الثوبَ: أحكم نَسْجَه) / شَهِدَ (شَهَدَ؛ شُهِدَ)\nمثال: أكد صمته شكوكها",
 "verifying": "تَأْكِيدِيّ, مُؤَيِّد (يُستخدم لدعم أو تأييد أو تأكيد صحة شيء)",
 "verily": "حقاً, يقيناً (في الحقيقة؛ بالتأكيد)\nمثال: أعتقد ذلك حقاً",
 "verisimilar": "شَبِيه بِالحَقِيقَة (يَبْدو صادِقًا أَوْ قَريبًا مِنَ الواقِع)",
 "verisimilitude": "محاكاة الصدق, موهمة بالواقعية (مظهر الحقيقة؛ صفة أن يبدو الشيء حقيقياً)",
 "veritable": "أَصِيل, مَوْثُوق (غير مُزيَّف أو منسوخ؛ حقيقي لا شك فيه)",
 "verity": "حقيقة أبدية, حقيقة ثابتة (حقيقة أخلاقية أو دينية أو جمالية دائمة أو ضرورية) / حقيقة, صحة (المطابقة للواقع أو الفعليّة)\nمثال: ناقشوا صحة الاقتراح",
 "verjuice": "حصرم",
 "vermicelli": "إِطْرِيَة, شُعَيْرِيَّة",
 "vermicide": "مبيد للديدان (عامل يقتل الديدان (خاصة تلك الموجودة في الأمعاء))",
 "vermicular": "دُودِيّ الزَّخْرَفَة (مزين بنقوش أو علامات تشبه مسارات الديدان)",
 "vermiculate": "دُودِيّ الزَّخْرَفَة (مزين بنقوش أو علامات تشبه مسارات الديدان) / مَسُوس, مُتَأَكِّلٌ بِالدُّودِ (مُصَابٌ أَوْ مُتَضَرِّرٌ بِفِعْلِ الدِّيدَانِ)",
 "vermiculated": "دُودِيّ الزَّخْرَفَة (مزين بنقوش أو علامات تشبه مسارات الديدان)",
 "vermiculation": "زخرفة دودية (زخرفة تتكون من منحوتات تشبه الديدان) / تمعج, حركة دودية (عملية تقلصات العضلات الشبيهة بالموجة في القناة الهضمية التي تحرك الطعام)",
 "vermiculite": "فيرميكوليت (أي من مجموعة معادن السيليكات المائية الصفراء أو البنية ذات البنية الميكائية)",
 "vermiform": "دُودِيّ الشَّكْل (يُشبه الدودة؛ طويل ورفيع وأسطوانيّ)",
 "vermiform appendix": "اَلزَّائِدَة اَلدُّودِيَّة, اَلْمُصْرَان اَلْأَعْوَر",
 "vermiform process": "زائدة, زائدة دودية (نتوء أثري يمتد من الطرف السفلي للمصران الأعور ويشبه جيباً صغيراً)",
 "vermifuge": "طارد للديدان (دواء قادر على التسبب في إخلاء الديدان المعوية الطفيلية)",
 "vermilion": "زِنْجَفْرِيّ (بلون أحمر زاهٍ إلى برتقالي محمر) / أحمر زاهٍ, قرمزي فاتح (لون متغير يكون أحمر زاهياً ولكن أحياناً مع مسحة برتقالية)",
 "vermillion": "زِنْجَفْرِيّ (بلون أحمر زاهٍ إلى برتقالي محمر)",
 "vermillion flycatcher": "صائد الذباب القرمزي (صائد ذباب أمريكي استوائي يوجد شمالاً حتى جنوب تكساس وأريزونا؛ الذكر البالغ له ريش قرمزي ساطع وأسود)",
 "vermillion rockfish": "سمكة الصخر القرمزية (سمكة مهمة تجارياً في ساحل المحيط الهادئ لأمريكا الشمالية)",
 "vermin": "خَشَاش, هَامَّة",
 "verminous": "حَقِير, طُفَيْلِيّ (من طبيعة الهوامّ؛ بالغ الكراهة والبشاعة)",
 "vermis": "دودة المخيخ (الجزء المركزي الضيق من المخيخ بين نصفي الكرة المخيخية)",
 "vermis cerebelli": "دودة المخيخ (الجزء المركزي الضيق من المخيخ بين نصفي الكرة المخيخية)",
 "vermont": "فِيرْمُونْت",
 "vermonter": "فيرمونتي (مواطن أو مقيم في فيرمونت)",
 "vermouth": "إِسْفِنْط, فِيرْمُوت",
 "vernacular": "دَارِج, عَامِّيّ (خَاصٌّ بِاللُّغَةِ اليَوْمِيَّةِ أَوْ مُنَاسِبٌ لَهَا) / لغة دارجة (الكلام اليومي للناس (تمييزاً عن اللغة الأدبية)) / رطانة, عامية خاصة (لغة مميزة لمجموعة معينة (كما بين اللصوص))\nمثال: هم لا يتحدثون لغتنا",
 "vernacular art": "فن الدخلاء, فن الفطرة (نوع من الفن والإنشاءات الخارجية صنعها فنانون غير مدربين لا يعتبرون أنفسهم فنانين)",
 "vernal": "ربيعي (من أو مميز لـأو يحدث في الربيع) / شَبَابِيّ, مَفْعَم بِالحَيَوِيَّة (يوحي بالشباب؛ نشيط ومفعم بالحيويّة)\nمثال: الاعتدال الربيعي",
 "vernal equinox": "اعتدال ربيعي ((في الفلك) نقطة الاعتدال التي تقع في كوكبة الحوت) / اعتدال ربيعي (الوَسَطِيَّة، يقابله التَطَرُّف؛ التَنَاسُب وأن يكون الأمر عَدْلا، يقابله الاِنْقِلاب)\nمثال: الاعتدال هو اليوم الذي يتساوى به الليل و النهار بنفس المدة.",
 "vernal iris": "سوسن ربيعي, سوسن قزم (سوسن أمريكي منخفض النمو يزهر في الربيع بزهور ليلكية زرقاء زاهية)",
 "vernal witch hazel": "بندق الساحرة الربيعي (شجيرة عطرة من وادي المسيسيبي السفلي لها زهور صغيرة جداً من منتصف الشتاء إلى الربيع)",
 "vernation": "ترتيب الأوراق ((علم النبات) ترتيب الأوراق الصغيرة في برعم الورقة قبل تفتحه)",
 "verner's law": "قانون فيرنر (تعديل لقانون غريم)",
 "vernier": "مقياس ورني, ورنية (مقياس صغير متحرك ينزلق على طول مقياس رئيسي؛ المقياس الصغير معاير للإشارة إلى الأقسام الكسرية للمقياس الرئيسي)",
 "vernier caliper": "قدمة ذات الورنية (فرجار مزود بمقياس ورنية لإجراء قياسات دقيقة للغاية)",
 "vernier micrometer": "قدمة ذات الورنية (فرجار مزود بمقياس ورنية لإجراء قياسات دقيقة للغاية)",
 "vernier scale": "مقياس ورني, ورنية (مقياس صغير متحرك ينزلق على طول مقياس رئيسي؛ المقياس الصغير معاير للإشارة إلى الأقسام الكسرية للمقياس الرئيسي)",
 "vernix": "طلاء دهني, فيرنيكس كازيوزا (مادة وقائية بيضاء تشبه الجبن تغطي جلد الجنين)",
 "vernix caseosa": "طلاء دهني, فيرنيكس كازيوزا (مادة وقائية بيضاء تشبه الجبن تغطي جلد الجنين)",
 "vernonia": "عشبة الحديد, فيرنونيا",
 "verona": "فيرونا",
 "veronal": "باربيتال, فيرونال (باربيتورات يستخدم كمنوم)",
 "veronica": "وِيرُونِكَة",
 "veronica agrestis": "زهرة الحواشي الحقلية (نبات أوروبي بزهور زرقاء إبطية دقيقة على سيقان طويلة؛ متوطن على نطاق واسع في أمريكا)",
 "veronica americana": "زهرة الوحل الأمريكية, فيرونيكا أمريكية (نبات من غرب أمريكا الشمالية وشمال شرق آسيا له سيقان مفترشة مع عناقيد كثيفة من الزهور البنفسجية الشاحبة إلى الليلكية)",
 "veronica anagallis-aquatica": "زهرة الحواشي المائية, فيرونيكا مائية (نبات الأماكن الرطبة في أوراسيا وأمريكا)",
 "veronica arvensis": "زهرة الحواشي الغيطية (نبات حولي أزرق الزهور منتصب أو منبطح يوجد في الأماكن المهملة في أوروبا وأمريكا)",
 "veronica beccabunga": "زهرة الوحل الأوروبية, فيرونيكا (نبات أوروبي له سيقان منخفضة وزهور زرقاء؛ تم توطينه بشكل متناثر في أمريكا الشمالية)",
 "veronica chamaedrys": "زهرة الحواشي الجعدية, عين الطائر (نبات من العالم القديم بعناقيد إبطية من الزهور الزرقاء والبيضاء)",
 "veronica michauxii": "زهرة الحواشي المائية, فيرونيكا مائية (نبات الأماكن الرطبة في أوراسيا وأمريكا)",
 "veronica officinalis": "زهرة الحواشي المخزنية, فيرونيكا شائعة (نبات أوروبي معمر زغبي شائع بزهور زرقاء شاحبة أو ليلكية في عناقيد إبطية)",
 "veronica peregrina": "زهرة الحواشي الرجلة (نبات حولي من أمريكا الشمالية بزهور بيضاء صغيرة متوطن كعشبة ضارة في أمريكا الجنوبية وأوروبا)",
 "veronica serpyllifolia": "زهرة الحواشي الزعترية (عشب معمر منبطح له أوراق متقابلة صغيرة وعناقيد من الزهور الزرقاء؛ في جميع أنحاء أوراسيا والعالم الجديد)",
 "verpa": "فيربا, موريل الجرس (موريل يشبه جزؤه الخصب الجرس ويتصل بالساق فقط في الأعلى)",
 "verpa bohemica": "فيربا بوهيمية, موريل مبكر (يشبه الكشتبان على الإصبع؛ سطح الجزء الخصب مطوي في تجاعيد تمتد من الأعلى إلى الأسفل؛ يبدأ الإثمار في الربيع قبل خروج الأوراق على الأشجار)",
 "verpa conica": "فيربا مخروطية (موريل بجزء خصب له سطح أملس نسبياً؛ الساق هشة)",
 "verruca": "ثآليل, ثؤلول (آفة جلدية صلبة وبارزة غير طبيعية؛ يسببها فيروس)",
 "verruca acuminata": "ثؤلول تناسلي (ثؤلول حميد صغير على أو حول الأعضاء التناسلية والشرج)",
 "verrucose": "ثُؤْلُولِيّ (مغطّى بنتوءات تشبه الثآليل)",
 "vers": "مُبَادِل",
 "vers libre": "شعر حر (شعر غير مقفى وبدون نمط وزني ثابت)",
 "versailles": "فِرْسَايْ, فيرساي",
 "versant": "سفح الجبل (جانب أو منحدر الجبل)\nمثال: تغطي غابات الصنوبريات السفح الشرقي",
 "versatile": "حُرُّ الحَرَكَة, مُتَعَدِّدُ الاتِّجَاهَات (قَادِرٌ عَلَى التَّحَرُّكِ بِحُرِّيَّةٍ فِي جَمِيعِ الاتِّجَاهَات) / مُتَعَدِّدُ الْمَوَاهِبِ, مُتَنَوِّعُ الْمَهَارَاتِ (كُفء في مجالات عديدة وقادر على الانتقال بسهولة بينها) / غَيْرُ ثَابِت, مُتَلَوِّن (مُتَغَيِّرٌ أَوْ غَيْرُ مُسْتَقِرّ) / مُتَشَعِّب, وَاسِعُ التَّنَوُّع (ذُو تَنَوُّعٍ كَبِيرٍ وَاتِّسَاعٍ فِي المَجَالَات)",
 "versatility": "تعدد المهارات, موسوعية (امتلاك مجموعة واسعة من المهارات)",
 "verse": "نَظْم (نَظَّمَه تَنْظِيمًا:أَلَّفَه وجَمَعَه فِي سِلْكٍ فانْتَظَمَ وتَنَظَّمَ ، وَمِنْه:نَظَمْتُ الشِّعْرَ ونَظَّمْتُه؛ نَظّم الأشياء :نظمها ،رتّبها،وضمّ بعضها إلى بعض في صورة منسّقة) / بَيْت (بمعنى قضى الليل؛ الخَيْمَة من الشَعْر يَبِيت فيها البَدَوي أو المُسافر. الجمع بُيُوت) / آيَة, عَدَد (العَلامَة أو الأمَارَة؛ المُعْجِزَة)\nمثال: نظم سامي كل شيء.",
 "verse form": "شعر, قصيدة (مؤلف مكتوب بتفعيلات مترية تشكل أسطراً إيقاعية)",
 "verse line": "بيت موزون, شعر (سطر من نص موزون)",
 "versed": "ضَلِيع, مُطَّلِع (على دراية تامة عبر الدراسة أو التجربة) / فيرسيد, ميدازولام (شكل قابل للحقن من البنزوديازيبين (الاسم التجاري فيرسيد) مفيد للتهدئة ولتقليل الألم أثناء الإجراءات الطبية غير المريحة)",
 "versicle": "آية قصيرة, فقرة ترتيل (آية قصيرة يلقيها أو يغنيها الكاهن في العبادة العامة ويتبعها رد من الجماعة)",
 "versification": "عروض, نظم الشعر (فن أو ممارسة كتابة الشعر) / عروض, نظم (الشكل أو التركيب المتري للقصيدة) / نظم شعري (اقتباس موزون لشيء ما (على سبيل المثال، لنص نثري))",
 "versifier": "نَاظِم",
 "versify": "نَظَمَ (نَظَّمَه تَنْظِيمًا:أَلَّفَه وجَمَعَه فِي سِلْكٍ فانْتَظَمَ وتَنَظَّمَ ، وَمِنْه:نَظَمْتُ الشِّعْرَ ونَظَّمْتُه؛ نَظّم الأشياء :نظمها ،رتّبها،وضمّ بعضها إلى بعض في صورة منسّقة)\nمثال: نظم سامي كل شيء.",
 "version": "رِوَايَة / تَرْجَمَة (شرح الكِتَاب أو توضيحه؛ تحويل الكلام من لغة إلى أخرى كي يفهمه قوم آخرون) / إِصْدَار, نُسْخَة\nمثال: أنا مدرس للترجمة.",
 "verso": "الوجه الخلفي (جانب العملة أو الميدالية الذي لا يحمل التصميم الرئيسي) / الصفحة اليسرى, الظهر (الصفحة على الجانب الأيسر)",
 "verst": "فيرست (وحدة طول روسية (1.067 كم))",
 "versus": "فِي مُقَابِل, ضِِدَّ (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة) / عَلَى اَلْعَكْس, ضِِدَّ (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: جون في عمر أخي.",
 "vertebra": "فَقَرَة",
 "vertebral": "فِقْرِيّ, فِقَرِيّ",
 "vertebral arch": "قوس عصبية, قوس فقرية (بنية تنشأ ظهرياً من مركز الفقرة وتحيط بالحبل الشوكي)",
 "vertebral artery": "شريان فقري (الفرع الأول للشريان تحت الترقوة؛ مقسم إلى أربعة أجزاء)",
 "vertebral canal": "قناة شوكية, قناة فقرية (القناة في الفقرات المتعاقبة التي يمر عبرها الحبل الشوكي)",
 "vertebral column": "عَمُود فِقْرِيّ",
 "vertebral vein": "وريد فقري (وريد يمر عبر ثقوب الفقرات العنقية ويشكل ضفيرة حول الشريان الفقري؛ يصب في الوريد العضدي الرأسي)",
 "vertebrate": "فَقَارِيّ, فَقَارِيَّة",
 "vertebrate foot": "قدم فقارية (نهاية الطرف في الفقاريات)",
 "vertebrate paleontology": "علم أحافير الفقاريات (علم الأحافير للفقاريات)",
 "vertex": "يَافُوخ",
 "vertical": "عَمُودِيّ / رَأْسِيّ",
 "vertical angle": "زاوية رأسية, زاوية متقابلة بالرأس (إحدى زاويتين متساويتين ومتقابلتين ناتجتين عن تقاطع خطين مستقيمين)",
 "vertical bank": "انحناء عمودي (انحناء شديد الانحدار بحيث يقترب المحور الجانبي للطائرة من الوضع العمودي)",
 "vertical blind": "ستارة رأسية, ستارة عمودية (ستارة نافذة تتكون من سلسلة من الشرائح الرفيعة تتدلى أمام النافذة، ويمكن تدويرها كمجموعة لتغلق بتداخل طفيف لحجب النافذة)\nمثال: على عكس الستائر الأفقية، الستائر العمودية أقل عرضة لتجمع الغبار لأنها تقف بشكل عمودي",
 "vertical circle": "دائرة راسية (دائرة عظمى على الكرة السماوية تمر عبر السمت وتكون عمودية على الأفق)",
 "vertical combination": "تكامل رأسي (الاستيعاب في شركة واحدة لعدة شركات تعمل في جميع جوانب تصنيع المنتج من المواد الخام إلى التوزيع)",
 "vertical file": "ملف عمودي (ملف يتم فيه تخزين السجلات بشكل قائم على حافة واحدة)",
 "vertical fin": "زعنفة الذيل, مثبت عمودي (مثبت يعد جزءاً من هيكل الذيل العمودي للطائرة)",
 "vertical flute": "ريكوردر, ناي عمودي (آلة نفخ أنبوبية بـ 8 ثقوب للأصابع وقطعة فم)",
 "vertical integration": "تكامل رأسي (الاستيعاب في شركة واحدة لعدة شركات تعمل في جميع جوانب تصنيع المنتج من المواد الخام إلى التوزيع)",
 "vertical section": "مقطع رأسي (رسم ميكانيكي يظهر الجزء الداخلي من جسم كما لو تم صنعه بواسطة مستوى رأسي يمر عبره)",
 "vertical stabiliser": "زعنفة الذيل, مثبت عمودي (مثبت يعد جزءاً من هيكل الذيل العمودي للطائرة)",
 "vertical stabilizer": "زعنفة الذيل, مثبت عمودي (مثبت يعد جزءاً من هيكل الذيل العمودي للطائرة)",
 "vertical surface": "سطح عمودي (سطح يكون عمودياً)",
 "vertical tail": "ذيل عمودي (السطح الانسيابي العمودي في مجموعة ذيل الطائرة)",
 "vertical union": "نقابة صناعية (نقابة عمالية تقبل جميع العمال في صناعة معينة بغض النظر عن حرفتهم)",
 "verticality": "تَعَامُد, رَأْسِيَّة (الوضع بزاوية قائمة مع الأفق)",
 "vertically": "رأسياً, عمودياً (في اتجاه عمودي)\nمثال: غالباً ما يتم إضافة معرض للاستفادة من المساحة رأسياً وأفقياً",
 "verticalness": "تَعَامُد, رَأْسِيَّة (الوضع بزاوية قائمة مع الأفق)",
 "verticil": "دوارة, سوارة (دوارة من الأوراق تنمو حول ساق)",
 "verticillate": "حَلَزُونِيّ, سُوَارِيّ (يُشكِّل دوارة واحدة أو أكثر (خاصة دوارة من الأوراق حول ساق))",
 "verticillated": "حَلَزُونِيّ, سُوَارِيّ (يُشكِّل دوارة واحدة أو أكثر (خاصة دوارة من الأوراق حول ساق))",
 "verticilliosis": "ذبول فيرتيسيليوم (ذبول تسببه فطريات من جنس فيرتيسيليوم)",
 "verticillium": "فيرتيسيليوم (فطر من جنس فيرتيسيليوم)",
 "vertiginous": "دَائِخ, مُصَاب بِالدُّوَار (يشعر بدوار ودوخة؛ معرَّض للسقوط)",
 "vertigo": "دَوْخَة, دُوَار",
 "vertu": "جودة فنية, قيمة فنية (الجودة الفنية (للتحف والأعمال الفنية)) / خبرة فنية, ولع بالتحف (حب أو تذوق للأشياء الفنية الجميلة)",
 "vervain": "رِعْي الْحَمَام",
 "vervain sage": "قصعين رعي الحمام, ميرمية برية (ميرمية أوراسية بزهور زرقاء وأوراق تشبه رعي الحمام؛ تم توطينها في الولايات المتحدة)",
 "verve": "تدفق, حيوية (أسلوب نشيط)",
 "vervet": "سعدان الفرفت (قرد جنوب أفريقي ذو وجه وأيدٍ سوداء)",
 "vervet monkey": "سعدان الفرفت (قرد جنوب أفريقي ذو وجه وأيدٍ سوداء)",
 "very": "جِدًّا (كلمة \"جدا\" لها معانٍ متعددة؛ يرتبط المعنى بالعطاء والكرم، سواء بالمنح أو طلبه)\nمثال: إنها غالية جدا!",
 "very fast": "بسرعة فائقة, في لمح البصر (في وقت قصير نسبياً)\nمثال: أنهت المهمة في لمح البصر",
 "very high frequency": "تَرَدُّد عَالٍ جِدّاً (30 إلى 300 ميجاهرتز)",
 "very important person": "شخصية هامة جداً, كبار الشخصيات (شخص مهم أو مؤثر (وغالباً ما يكون متسلطاً))",
 "very light": "ضوء فيري (توهج ملون يُطلق من مسدس فيري)",
 "very loudly": "بصوت عالٍ جداً, فورتيسيمو (توجيه في الموسيقى؛ للعزف بقوة شديدة)",
 "very low density lipoprotein": "بروتين دهني منخفض الكثافة جداً (بروتينات دهنية كبيرة غنية بالدهون الثلاثية؛ تدور في الدم وتتخلى عن دهونها الثلاثية للأنسجة الدهنية والعضلية حتى يتم تعديل بقاياها وتحويلها إلى بروتين…)",
 "very low frequency": "تَرَدُّد مُنْخَفِض لِلغَايَة (3 إلى 30 كيلوهرتز)",
 "very much like": "تماما مثل (بطريقة مماثلة)",
 "very pistol": "مسدس إشارة, مسدس فيري (اسم مفعول من سَدَّسَ؛ في : شَكْل هندسي مُسَطَّح له سِتَّة أضلاع متساوية فإن لم تكن متساوية سميّ بالسُدَاسِيّ)\nمثال: كان عند زيري مسدس.",
 "very reverend": "القس الجليل (لقب احترام لمختلف المسؤولين الكنسيين)",
 "very softly": "بهدوء شديد (توجيه في الموسيقى؛ للعزف بنعومة شديدة)",
 "very well": "تمام, حسناً (تعبير عن الموافقة يحدث عادة في بداية الجملة) / بشكل ممتاز, على ما يرام (بشكل جيد جداً)\nمثال: إنها لا تشعر أنها على ما يرام اليوم",
 "very-light": "ضوء فيري (توهج ملون يُطلق من مسدس فيري)",
 "vesica": "مثانة (كيس غشائي قابل للتمدد (عادة يحتوي على سائل أو غاز))",
 "vesical": "مثاني (من أو متعلق بالمثانة (خاصة المثانة البولية))",
 "vesical vein": "وريد مثاني (أوردة تصرف الضفيرة المثانية وتنضم إلى الأوردة الحرقفية الباطنة)",
 "vesicant": "كَاوٍ, مُنَفِّط (يسبّب ظهور البثور والنفطات على الجلد) / عامل مسبب للبثور, مادة منفطة (عامل كيميائي يسبب التقرحات أو البثور (خاصة غاز الخردل))",
 "vesication": "تبثر, تكون الحويصلات (تكون حويصلات في الجلد أو تحته)",
 "vesicatory": "كَاوٍ, مُنَفِّط (يسبّب ظهور البثور والنفطات على الجلد) / عامل مسبب للبثور, مادة منفطة (عامل كيميائي يسبب التقرحات أو البثور (خاصة غاز الخردل))",
 "vesicle": "حويصلة, كيس (كيس صغير طبيعي تشريحياً أو بنية شبيهة بالمثانة (خاصة تلك التي تحتوي على سائل))",
 "vesicopapule": "حطاطة حويصلية (حطاطة تتحول إلى بثرة)",
 "vesicoureteral reflux": "جزر مثاني حالبي (تدفق عكسي للبول من المثانة إلى الحالب)",
 "vesicula umbilicus": "حويصلة سرية, كيس المح (بنية غشائية تعمل كجهاز دوري في أجنة الثدييات حتى يصبح القلب وظيفياً)",
 "vesicular": "حويصلي (من أو يتعلق بالحويصلات أو يتضمنها)\nمثال: تنفس حويصلي طبيعي",
 "vesicular stomatitis": "التهاب الفم الحويصلي (مرض يصيب الخيول والماشية والخنازير وأحياناً البشر؛ يسببه فيروس الحويصلة)",
 "vesiculation": "تبثر, تكون الحويصلات (تكون حويصلات في الجلد أو تحته)",
 "vesiculitis": "التهاب الحويصلة المنوية (التهاب الحويصلة المنوية (عادة بالتزامن مع التهاب البروستاتا))",
 "vesiculovirus": "فيروس حويصلي (فيروس حيواني يسبب التهاب الفم الحويصلي)",
 "vespa crabro": "دبور عملاق (دبور أوروبي أُدخل إلى الولايات المتحدة)",
 "vesper": "صلاة الغروب (خدمة عبادة في وقت متأخر من بعد الظهر أو المساء)",
 "vesper mouse": "فأر أبيض القدمين (فأر غابات أمريكي ذو أقدام وأجزاء سفلية بيضاء)",
 "vesper sparrow": "عصفور المساء (عصفور شائع في أمريكا الشمالية يشتهر بغنائه المسائي)",
 "vespers": "صلاة الغروب, صلاة المساء (السادسة من الساعات القانونية السبع للمكتب الإلهي؛ في وقت مبكر من المساء)",
 "vespertilian bat": "خفاش الليل (نوع من الخفافيش اللاحمة)",
 "vespertilio murinus": "خفاش مثلج (خفاش أوراسي شائع ذو شعر أبيض الأطراف في معطفه)",
 "vespertilionid": "خفاش الليل (نوع من الخفافيش اللاحمة)",
 "vespid": "زنبوريات (دبابير اجتماعية بانية للأعشاش في الغالب)",
 "vespid wasp": "زنبوريات (دبابير اجتماعية بانية للأعشاش في الغالب)",
 "vespula maculata": "دبور أصلع الوجه (دبور من أمريكا الشمالية)",
 "vespula maculifrons": "دبور أصفر, سترة صفراء (دبور اجتماعي صغير معلم بالأصفر يعشش عادة في الأرض)",
 "vespula vulgaris": "دبور شائع (نوع من الدبابير)",
 "vessel": "وِعَاء (الوِعَاءُ : الظَّرْفُ يوعَى فيه الشيءُ، ما يُجْمَعُ فيه الشّيءُ ويُحْفظ؛ الوِعَاءُ : إناء منزليّ يُصنع من الخزف أو المعدن أو الزُّجاج كوعاء الطَّبخ الذي له يد وغطاء أو وعاء دائريّ لتقديم الطَّعام أو إناء حفظ القهوة والشَّاي)\nمثال: وعاء السکر فارغ.",
 "vest": "صُدَيْرِيّ (المنسوب إلى الصُدَيْر أي مصغر الصدر؛ لباس للرجال غربي يغطي الجذع ويزرّر عند الصدر وليس له أكمام، يُرتدى غالبا تحت السترة)",
 "vest pocket": "جيب الصدرية (جيب صغير في سترة الرجل (الصديري))",
 "vesta": "فِسْتَا / فِيسْتَا",
 "vestal": "بِكْر, طَاهِر (في حالة عذريّة جنسيّة) / عذراوي, فستالي (من أو متعلق بالإلهة فستا) / راهبة فيستا, عذراء (امرأة عفيفة)\nمثال: عذراء فستالية",
 "vestal virgin": "عذراء فيستال ((الأساطير الرومانية) واحدة من الكاهنات العذارى المكرسات للإلهة الرومانية فيستا وللحفاظ على النار المقدسة في معبدها)",
 "vested": "ثَابِت, مُكْتَسَب (مُحَدَّدٌ وَمُطْلَقٌ وَغَيْرُ مَشْرُوطٍ)",
 "vested interest": "مصلحة خاصة, مصلحة راسخة (مجموعات تسعى للسيطرة على نظام اجتماعي أو نشاط تستمد منه منفعة خاصة) / حق مكتسب, مصلحة مكتسبة ((قانون) مصلحة يوجد فيها حق ثابت في التمتع الحالي أو المستقبلي والتي يمكن نقلها إلى شخص آخر)",
 "vestiary": "ملبسي (متعلق بالملابس (خاصة الأردية الكهنوتية))",
 "vestibular": "دهليزي (يتعلق بحاسة التوازن (في الأذن الداخلية))",
 "vestibular apparatus": "الجهاز الدهليزي (الأعضاء التي تتوسط حاسة التيه (الأذن الداخلية)؛ المعنية بالتوازن)",
 "vestibular fold": "حبل صوتي كاذب (أي من الحبلين الصوتيين العلويين غير المشاركين في التصويت)",
 "vestibular gland": "غدة دهليزية (غدة تفتح في دهليز المهبل؛ تشحم إفرازاتها المهبل أثناء الجماع)",
 "vestibular sense": "توازن, حاسة التوازن (نظام حسي يقع في هياكل الأذن الداخلية يسجل اتجاه الرأس)",
 "vestibular system": "الجهاز الدهليزي (الأعضاء التي تتوسط حاسة التيه (الأذن الداخلية)؛ المعنية بالتوازن)",
 "vestibular vein": "وريد دهليزي (أوردة تصرف الكييس والقريبة)",
 "vestibule": "بهو, ردهة (مدخل كبير أو غرفة استقبال أو منطقة استقبال) / دهليز (أي من التجاويف الجسدية المختلفة المؤدية إلى تجويف آخر (كما في الأذن أو المهبل))",
 "vestibule of the ear": "دهليز الأذن (التجويف المركزي للتيه العظمي للأذن)",
 "vestibule of the vagina": "دهليز المهبل (الحيز بين الشفرين الصغيرين المحتوي على فتحة الإحليل)",
 "vestibulocochlear nerve": "عصب دهليزي قوقعي, عصب سمعي (عصب حسي مركب يغذي الخلايا الشعرية للعضو الدهليزي والخلايا الشعرية للقوقعة)",
 "vestige": "أثر, بقية (دلالة على أن شيئاً ما كان موجوداً)\nمثال: لم يكن هناك أي أثر لدليل على الادعاء",
 "vestigial": "أَثَرِيّ, بِدَائِيّ (لَمْ يَتَطَوَّرْ بِالكَامِلِ فِي الكَائِنَاتِ البَالِغَة)",
 "vestiture": "كسوة (مصطلح قديم للملابس)",
 "vestment": "رداء كهنوتي (ثوب (وخاصة الملابس الاحتفالية) يرتديه رجال الدين)",
 "vestmental": "ردائي (من أو متعلق أو يشبه الرداء الكهنوتي)",
 "vestmented": "مُرْتَدٍ حُلَّة طَقْسِيَّة (يرتدي ملابس احتفالية خاصة الملابس الكهنوتية)",
 "vestry": "سقيفة الكنيسة, غرفة الملابس الكنسية (غرفة في كنيسة تُحفظ فيها الأواني المقدسة والملابس الكهنوتية أو تُعقد فيها الاجتماعات) / مجلس الكنيسة (في الكنيسة الأسقفية البروتستانتية: لجنة تنتخبها الرعية للعمل مع نظار الكنيسة في إدارة الشؤون الدنيوية للكنيسة)",
 "vestryman": "عضو مجلس الكنيسة (رجل عضو في مجلس الكنيسة)",
 "vestrywoman": "عضوة مجلس الكنيسة (امرأة عضوة في مجلس الكنيسة)",
 "vesture": "ثياب, كساء (غطاء مصمم ليتم ارتداؤه على جسم الإنسان) / رِدَاء, كِسَاء (شيء يغطي أو يحجب مثل الثوب)\nمثال: حقول في كساء من الخضرة",
 "vesuvian": "إيدوكراس, فيزوفيانيت (معدن أخضر أو أصفر أو بني يتكون من سيليكات مائية؛ يوجد كبلورات في الحجر الجيري ويستخدم كحجر كريم)",
 "vesuvianite": "إيدوكراس, فيزوفيانيت (معدن أخضر أو أصفر أو بني يتكون من سيليكات مائية؛ يوجد كبلورات في الحجر الجيري ويستخدم كحجر كريم)",
 "vesuvius": "فِيزُوف",
 "vet": "متقاعد عسكري, محارب قديم (شخص خدم في القوات المسلحة) / طبيب بيطري (طبيب يمارس الطب البيطري)",
 "vetch": "بِيقِيَّة",
 "vetchling": "بيقية, جلبان",
 "vetchworm": "دودة كوز الذرة (يرقة عثة ليلية؛ مدمرة للغاية خاصة لمحاصيل الذرة والقطن والطماطم)",
 "veteran": "مُحَارِب قَدِيم",
 "veteran soldier": "جندي مخضرم, مخضرم (جندي شهد خدمة نشطة كبيرة)\nمثال: ضحك المخضرمون على المجندين الجدد",
 "veterancy": "أقدمية, خبرة (حالة أو شرط كون الشخص محارباً قديماً أو خبيراً)",
 "veterans day": "11 نوفمبر, يوم المحاربين القدامى (عطلة قانونية في الولايات المتحدة؛ كانت تسمى سابقًا يوم الهدنة ولكن سميت يوم المحاربين القدامى منذ عام 1954)",
 "veterans of foreign wars": "منظمة قدامى المحاربين في الحروب الخارجية (منظمة للمحاربين القدامى في الولايات المتحدة)",
 "veterans' day": "11 نوفمبر, يوم المحاربين القدامى (عطلة قانونية في الولايات المتحدة؛ كانت تسمى سابقًا يوم الهدنة ولكن سميت يوم المحاربين القدامى منذ عام 1954)",
 "veterinarian": "طَبِيب بَيْطَرِيّ, بيطار (العالم بالطب)\nمثال: سوف تصبح طبيبة.",
 "veterinary": "بَيْطَرِيّ",
 "veterinary medicine": "طب بيطري (فرع الطب الذي يتعامل مع تشخيص وعلاج أمراض وإصابات الحيوانات)",
 "veterinary school": "كلية الطب البيطري, مدرسة بيطرية (مدرسة لتدريس الطب البيطري)",
 "veterinary surgeon": "طبيب بيطري (طبيب يمارس الطب البيطري)",
 "veto": "نَقْضْ (هَدَمَ أو أَبْطَلَ؛ خَالَفَ أو تَرَاجَعَ في الوعد أو العهد)\nمثال: لقد نقض الاتفاق.",
 "vexation": "إزعاج, غيظ (فعل إقلاق أو إزعاج شخص ما) / صداع, قلق (شيء أو شخص يسبب القلق؛ مصدر للتعاسة) / إغاظة, انزعاج (غضب ناتج عن إثارة مزعجة) / استياء, انزعاج (الحالة النفسية للشعور بالتهيج أو الانزعاج)\nمثال: حركة المرور في نيويورك مصدر قلق دائم",
 "vexatious": "مُزْعِج, مُضَايِق (يسبب الانزعاج أو الضيق)",
 "vexatious litigation": "دعوى كيدية (تقاضي يتبين أنه تم رفعه بشكل كيدي ودون سبب محتمل)",
