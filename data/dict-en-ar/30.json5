 "vinaigrette": "تتبيلة فرنسية, فينيغريت (زيت وخل مع خردل وثوم)",
 "vinayak": "ڤِيناياك",
 "vinayaka": "ڤِيناياك",
 "vinblastine": "فيلبان, فينبلاستين (مشتق نبات العناقية يستخدم كدواء مضاد للأورام (الاسم التجاري فيلبان) يعطل انقسام الخلايا)",
 "vinca major": "عناقية كبيرة, فنسة كبيرة (نبات ذو أوراق مبرقشة ويستخدم لصناديق النوافذ)",
 "vinca minor": "عناقية صغيرة, فنسة صغيرة (تزرع على نطاق واسع كغطاء أرضي لأوراقها الخضراء الداكنة اللامعة وزهورها البنفسجية الزرقاء عادة)",
 "vinca rosea": "عناقية, عين البزون (عشب خشبي من العالم القديم يزرع عادة وله أزهار كبيرة وردية إلى حمراء)",
 "vincent's angina": "ذباح فنسنت, فم الخندق (عدوى حادة سارية في الجهاز التنفسي والفم تتميز بتقرح الغشاء المخاطي)",
 "vincent's infection": "ذباح فنسنت, فم الخندق (عدوى حادة سارية في الجهاز التنفسي والفم تتميز بتقرح الغشاء المخاطي)",
 "vincetoxicum hirsutum": "فينسيتوكسيكوم, كرمة سوداء (كرمة ملتفة ذات أوراق مشعرة وأزهار بنية أرجوانية داكنة)",
 "vincetoxicum negrum": "فينسيتوكسيكوم, كرمة سوداء (كرمة ملتفة ذات أوراق مشعرة وأزهار بنية أرجوانية داكنة)",
 "vincible": "قَابِلٌ لِلهَزِيمَةِ, مَغْلُوب (عُرْضَةٌ لِلهَزِيمَةِ أَوِ الغَلَبَةِ)",
 "vincristine": "أونكوفين, فينكريستين (مشتق نبات العناقية يستخدم كدواء مضاد للأورام (الاسم التجاري أونكوفين)؛ يستخدم لعلاج سرطان الجهاز الليمفاوي)",
 "vindicated": "مُبَرَّأ, مُعْفًى (أُعفي من أي شبهة ذنب)",
 "vindication": "تَزْكِيَة",
 "vindicator": "مدافع, مُبرر (شخص يجادل للدفاع عن أو تبرير سياسة أو مؤسسة ما)\nمثال: مدافع عن عقوبة الإعدام",
 "vindicatory": "تَبْرِيرِيّ, تَسْوِيغِيّ (يُقَدِّم التبرير أو التسويغ) / جَزَائِيّ, عِقَابِيّ (يُمنح أو يُوقع كجزاء وفقاً للاستحقاق) / اِنْتِقَامِيّ, جَزَائِيّ (يتعلّق بالقِصاص أو الجزاء أو يتّسم بطبيعته)",
 "vindictive": "اِنْتِقَامِيّ, حَقُود (يُظهر سوء نية خبيثة ورغبة في الإيذاء؛ مدفوع بالحقد) / اِنْتِقَامِيّ, حَقُود (يَمِيلُ إِلَى طَلَبِ الثَّأْرِ أَوْ يَهْدِفُ إِلَى الِانْتِقَامِ)",
 "vindictively": "بانتقام, بتشفٍ (بطريقة حاقدة تسعى للانتقام)\nمثال: تآمر بانتقام ضد رؤسائه السابقين",
 "vindictiveness": "انتقامية, حب الانتقام (رغبة خبيثة في الانتقام)",
 "vine": "كرمة, نبات متسلق (نبات ذو ساق ضعيفة يستمد الدعم من التسلق أو الالتفاف أو الزحف على سطح ما)",
 "vine cactus": "أوكوتيلو, سوط المدرب (شجيرة صحراوية من جنوب غرب الولايات المتحدة والمكسيك لها فروع شائكة عارية رفيعة تخرج أوراقاً وعناقيد من الزهور الحمراء بعد موسم الأمطار)",
 "vine maple": "قيقب الكرمة (قيقب صغير من شمال غرب أمريكا الشمالية له سيقان منبطحة تتجذر بحرية وتشكل غابات كثيفة)",
 "vine snake": "ثعبان الكرمة (ثعبان شجري نحيل يوجد من جنوب أريزونا إلى بوليفيا)",
 "vinegar": "خَلّ ((خَلَّ) خلا وخلولا: صار فيه خلل؛ (خَلَّ) لحمه: قل ونحف)\nمثال: تذوق زيري ذلك الخل.",
 "vinegar eel": "دودة الخل (دودة ثعبانية دقيقة تتغذى على الكائنات الحية التي تسبب التخمير في الخل مثلاً)",
 "vinegar fly": "ذبابة الخل (ذباب تتغذى يرقاته على المخللات والمحفوظات غير محكمة الإغلاق)",
 "vinegar tree": "سماق أملس, سماق قرمزي (شجيرة شائعة غير سامة في شرق أمريكا الشمالية بأوراق مركبة شمعية وزهور خضراء عنقودية تليها ثمار حمراء) / سماق قرن الوعل, سماق مخملي (شجرة شجيرية متساقطة الأوراق في شرق أمريكا الشمالية بأوراق مركبة تتحول إلى اللون الأحمر اللامع في الخريف وعناقيد كثيفة من الزهور الصفراء المخضرة تليها…)",
 "vinegar worm": "دودة الخل (دودة ثعبانية دقيقة تتغذى على الكائنات الحية التي تسبب التخمير في الخل مثلاً)",
 "vinegariness": "خلية (حموضة تشبه حموضة الخل)",
 "vinegarish": "حَامِضِيّ الطَّبْع, لَاذِع (ذو مزاج حامض؛ سيء الطبع) / خَلِّيّ (ذو طعم أو رائحة تشبه الخل)",
 "vinegarishness": "خلية (حموضة تشبه حموضة الخل)",
 "vinegarroon": "عقرب الخل (عقرب سوطي كبير من المكسيك وجنوب الولايات المتحدة يبعث رائحة خلية عند الانزعاج)",
 "vinegarweed": "عشبة الخل, عشبة كافور التربنتين (نبات عطري من غرب الولايات المتحدة)",
 "vinegary": "حَامِضِيّ الطَّبْع, لَاذِع (ذو مزاج حامض؛ سيء الطبع) / خَلِّيّ (ذو طعم أو رائحة تشبه الخل)",
 "vinery": "كرم عنب, مزرعة عنب (مزرعة لكروم العنب حيث يتم إنتاج عنب النبيذ)",
 "vineyard": "كَرْم",
 "vingt-et-un": "بلاك جاك, واحد وعشرون (لعبة قمار تستخدم الأوراق؛ الهدف هو الحصول على أوراق ذات مجموع أعلى من أوراق المصرفي ولكن لا تتجاوز 21)",
 "viniculture": "زراعة الكروم (زراعة العنب وكروم العنب)",
 "vinifera": "دالية, كرمة (عنب أوروبي شائع يزرع في العديد من الأصناف؛ المصدر الرئيسي لنبيذ العالم القديم وعنب المائدة)",
 "vinifera grape": "عنب أوروبي, عنب نبيذي (عنب من صنف مزروع لكرمة العنب الشائعة في أوروبا) / دالية, كرمة (عنب أوروبي شائع يزرع في العديد من الأصناف؛ المصدر الرئيسي لنبيذ العالم القديم وعنب المائدة)",
 "vinification": "تخمير النبيذ, صناعة النبيذ (العملية التي يحول فيها التخمر عصير العنب إلى نبيذ)",
 "vino": "خمر, نبيذ (عصير مخمر (من العنب خاصة))",
 "vinous": "روحاني",
 "vintage": "زمن المنشأ, عتق (قدم النبيذ) / محصول الكرم, نبيذ الموسم (إنتاج موسم من النبيذ من كرم معين)",
 "vintager": "قاطف العنب (شخص يحصد العنب لصنع النبيذ)",
 "vintner": "صانع نبيذ (شخص يصنع النبيذ) / تاجر خمور, تاجر نبيذ (شخص يبيع النبيذ)",
 "vinyl": "فاينيل",
 "vinyl cyanide": "أكريلونتريل, سيانيد الفاينيل (نتريل غير مشبع سائل عديم اللون يصنع من البروبين)",
 "vinyl ether": "إيثر (سائل متطاير عديم اللون وشديد الاشتعال كان يستخدم سابقاً كمخدر استنشاقي)",
 "vinyl group": "شق فينيل, فينيل (شق كيميائي أحادي التكافؤ مشتق من الإيثيلين)",
 "vinyl polymer": "بوليمر الفينيل, راتنج الفينيل (بلاستيك حراري مشتق عن طريق البلمرة من مركبات تحتوي على مجموعة الفينيل)",
 "vinyl radical": "شق فينيل, فينيل (شق كيميائي أحادي التكافؤ مشتق من الإيثيلين)",
 "vinyl resin": "بوليمر الفينيل, راتنج الفينيل (بلاستيك حراري مشتق عن طريق البلمرة من مركبات تحتوي على مجموعة الفينيل)",
 "vinylbenzene": "ستايرين, فينيل بنزين (سائل زيتي عديم اللون؛ هو المونومر للبوليسترين)",
 "vinylite": "راتنج الفينيل, فينيلات (أي من راتنجات الفينيل المختلفة)",
 "viocin": "فيوسين, فيوميسين (مضاد حيوي أساسي عديد الببتيد (الاسم التجاري فيوسين) يعطى في العضل (جنباً إلى جنب مع أدوية أخرى) في علاج السل)",
 "viol": "الكمان القديم, فيول (أي من عائلة الآلات الوترية ذات القوس التي سبقت عائلة الكمان)",
 "viola": "كَمَان أَوْسَط",
 "viola arvensis": "بانسي الحقل (فيولا شائعة في العالم القديم ذات أزهار كريمية غالباً ما تكون مشوبة باللون البنفسجي)",
 "viola blanda": "بنفسج أبيض حلو (بنفسج قصير الساق من شرق أمريكا الشمالية له زهور بيضاء عطرة بعروق أرجوانية)",
 "viola canadensis": "بنفسج كندا (نبات معمر طويل من أمريكا الشمالية بأوراق على شكل قلب وزهور بيضاء بخطوط أرجوانية)",
 "viola canina": "بنفسج الكلب (بنفسج أزرق الأزهار مورق الساق من العالم القديم)",
 "viola clef": "مفتاح ألتو (مفتاح يضع دو الوسطى على الخط الثالث للمدرج)",
 "viola conspersa": "بنفسج الكلب الأمريكي (بنفسج من شرق أمريكا الشمالية له زهور بنفسجية شاحبة إلى بيضاء)",
 "viola cornuta": "بانسي عنقودي, بنفسج مقرن (فيولا أوروبية ذات مهماز تويج طويل بشكل غير عادي)",
 "viola d'amore": "فيولا داموري (فيول يمثل طبقة التينور في عائلة الفيول)",
 "viola da braccio": "فيولا دا براتشيو (عضو من عائلة الفيول له نطاق صوتي يقارب الفيولا)",
 "viola da gamba": "فيولا دا جامبا (فيول هو العضو الجهير (باص) في عائلة الفيول وله نطاق يقارب التشيلو)",
 "viola ocellata": "بنفسج ذو العينين (بنفسج من ساحل المحيط الهادئ لأمريكا الشمالية له بتلات بيضاء مشوبة بالأصفر والبنفسجي العميق)",
 "viola odorata": "بنفسج الحديقة, بنفسج عطري (بنفسج أوروبي يتميز عادة بزهور أرجوانية إلى بيضاء؛ متوطن على نطاق واسع)",
 "viola pedata": "بنفسج قدم الطائر (بنفسج شائع في شرق الولايات المتحدة بزهور زرقاء شاحبة أو أرجوانية كبيرة تشبه زهور الثالوث)",
 "viola pubescens": "بنفسج أصفر زغبي (بنفسج من شرق أمريكا الشمالية له أوراق وسيقان مزغبة ناعمة وزهور صفراء صافية بعروق بنية أرجوانية)",
 "viola reichenbachiana": "بنفسج السياج (بنفسج أوروبي شائع ينمو في الغابات والتحوطات)",
 "viola rostrata": "بنفسج طويل المهماز (بنفسج من شرق أمريكا الشمالية له زهور أرجوانية ليلكية بمهماز رفيع طويل)",
 "viola striata": "بنفسج شاحب (بنفسج مورق الساق من شرق أمريكا الشمالية له زهور بيضاء كبيرة أو كريمية معلمة بشكل خافت بالأرجواني)",
 "viola sylvatica": "بنفسج السياج (بنفسج أوروبي شائع ينمو في الغابات والتحوطات)",
 "viola tricolor": "بانسي بري, زهرة الثالوث البرية (عشبة أوروبية شائعة ومزروعة منذ فترة طويلة تشتق منها معظم زهور البانسي الشائعة في الحدائق)",
 "viola tricolor hortensis": "بانسي, زهرة الثالوث (نبات حديقة كبير الزهر مشتق أساساً من البانسي البري في أوروبا وله بتلات مخملية بألوان مختلفة)",
 "violable": "قابل للانتهاك (يمكن انتهاكه أو خرقه)\nمثال: قاعدة قابلة للانتهاك",
 "violate": "اِنْتَهَكَ",
 "violated": "مُدَنَّس, مُنْتَهَك (عُومِلَ بِاسْتِخْفَافٍ أَوِ انْتِهَاكٍ لِلقَدَاسَةِ)",
 "violation": "اِنْتِهَاك",
 "violative": "مُخِلّ, مُنْتَهِك (ينتهك أو يميل إلى انتهاك قاعدة أو قانون)",
 "violator": "معتدٍ جنسي (شخص يعتدي على الآخرين جنسياً) / مخالف للقانون (شخص يخالف القانون)",
 "violence": "عُنْف, عَنْف / عُنْف",
 "violent": "عَنِيف",
 "violent death": "قتل, موت عنيف (حدث يتسبب في موت شخص ما)",
 "violent disorder": "عربدة, هيجان (سلوك عنيف غاضب ومدمر)",
 "violent storm": "عاصفة, عاصفة عنيفة (حالة جوية عنيفة برياح سرعتها 64-72 عقدة (11 على مقياس بوفورت) وهطول أمطار ورعد وبرق)",
 "violent stream": "تيار جارف, سيل (تيار مائي سريع وعنيف (أو سائل آخر))\nمثال: جرفت المنازل في السيل",
 "violently": "بِعُنْف",
 "violet": "بَنَفْسَج (نبات عطري) / بَنَفْسَجِيّ",
 "violet suksdorfia": "سوكسدورفيا بنفسجية (نبات دقيق رفيع بأوراق عريضة مستديرة مفصصة بعمق وزهور وردية داكنة إلى بنفسجية على شكل قمع؛ كولومبيا البريطانية إلى شمال أوريغون وغرباً إلى أيداهو…)",
 "violet wood sorrel": "حميض بنفسجي (عشب معمر من شرق أمريكا الشمالية بأوراق مركبة كفياً وزهور عادة وردية أرجوانية)",
 "violet-black": "أَسْوَد بَنَفْسَجِيّ (أسود مع مسحة بنفسجية)",
 "violet-blue": "أَزْرَق بَنَفْسَجِيّ, أَزْرَق لَيْلَكِيّ (أزرق مع مسحة خزامية)",
 "violet-colored": "بَنَفْسَجِيّ اللَّوْن (ذو لون بنفسجيّ أو أزهار بنفسجيّة)",
 "violet-coloured": "بَنَفْسَجِيّ اللَّوْن (ذو لون بنفسجيّ أو أزهار بنفسجيّة)",
 "violet-flowered": "بَنَفْسَجِيّ اللَّوْن (ذو لون بنفسجيّ أو أزهار بنفسجيّة)",
 "violet-flowered petunia": "بيتونيا بنفسجية (عشب أو شجيرة صغيرة لها زهور منفردة بنفسجية إلى حمراء وردية)",
 "violet-pink": "وَرْدِيّ بَنَفْسَجِيّ, وَرْدِيّ لَيْلَكِيّ (وردي مع مسحة خزامية)",
 "violet-purple": "بَنَفْسَجِيّ أُرْجُوَانِيّ (ذو لون بنفسجيّ مائل إلى الأرجوانيّ)",
 "violet-scented": "بِرَائِحَةِ البَنَفْسَج (ذُو رَائِحَة البَنَفْسَج)",
 "violet-streaked": "ذُو خُطُوط بَنَفْسَجِيَّة (عليه خطوط بنفسجيّة اللون)",
