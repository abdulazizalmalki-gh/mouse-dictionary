 "verbal description": "توصيف, وصف (بيان يمثل شيئاً ما بالكلمات)",
 "verbal expression": "إفصاح, تعبير (إيصال معتقداتك أو آرائك (بالكلام أو الكتابة))\nمثال: تعبيرات عن حسن النية",
 "verbal intelligence": "ذكاء لفظي (الذكاء في استخدام وفهم اللغة)",
 "verbal noun": "مَصْدَر (مَصْدَر)\nمثال: ما مصدر هذا الخوف؟",
 "verbalisation": "تعبير لفظي, صياغة لفظية (نشاط التعبير عن شيء ما بالكلمات) / تعبير لفظي (الكلمات التي يتم التحدث بها في نشاط التعبير اللفظي)",
 "verbalised": "مَنْطُوق, مُعَبَّرٌ عَنْهُ (أُبلِغ عنه بالكلمات أو عُبِّر عنه لفظيًّا)",
 "verbaliser": "متحدث, متكلم (شخص يعبر باللغة؛ شخص يتحدث (خاصة من يلقي خطابًا عامًا أو شخص كثير الكلام))\nمثال: المتحدث في حفل التخرج",
 "verbalism": "إسهاب, كثرة الكلام (وفرة مفرطة من الكلمات) / إفصاح, تعبير (إيصال معتقداتك أو آرائك (بالكلام أو الكتابة))\nمثال: تعبيرات عن حسن النية",
 "verbalization": "تعبير لفظي, صياغة لفظية (نشاط التعبير عن شيء ما بالكلمات) / تعبير لفظي (الكلمات التي يتم التحدث بها في نشاط التعبير اللفظي)",
 "verbalized": "مَنْطُوق, مُعَبَّرٌ عَنْهُ (أُبلِغ عنه بالكلمات أو عُبِّر عنه لفظيًّا)",
 "verbalizer": "متحدث, متكلم (شخص يعبر باللغة؛ شخص يتحدث (خاصة من يلقي خطابًا عامًا أو شخص كثير الكلام))\nمثال: المتحدث في حفل التخرج",
 "verbally": "شفهياً, لفظياً (بواسطة اللغة) / فعلياً (كفعل (في النحو))\nمثال: معبر عنه لفظياً",
 "verbascum blattaria": "بوصير العث, بوصير صرصوري (بوصير أوروبي بأوراق ملساء وزهور صفراء أو أرجوانية كبيرة؛ تم توطينه كعشب ضار في أمريكا الشمالية)",
 "verbascum lychnitis": "بوصير أبيض (عشب أوراسي كثيف الشعر بزهور بيضاء عنقودية؛ تم توطينه في أمريكا الشمالية)",
 "verbascum phoeniceum": "بوصير أرجواني (بوصير أوراسي بزهور أرجوانية أو وردية بارزة)",
 "verbascum thapsus": "آذان الدب, بوصير (بوصير طويل الساق صوفي جداً بزهور صفراء مكتظة بكثافة؛ كان الإغريق والرومان القدماء يغمسون السيقان في الشحم لاستخدامها كمشاعل جنائزية)",
 "verbatim": "حَرْفًا بِحَرْفٍ, حَرْفِيًّا",
 "verbena": "رعي الحمام, فيربينا (أي من النباتات الأمريكية الاستوائية أو شبه الاستوائية العديدة من جنس رعي الحمام تزرع لسنابلها المبهرجة من الزهور متنوعة الألوان)",
 "verbesina alternifolia": "فيربيسينا متبادلة الأوراق (عشب معمر بزهور صفراء ملفتة للنظر؛ شرق الولايات المتحدة)",
 "verbesina encelioides": "أقحوان الزبدة (عشب حولي خشن رمادي مخضر أصفر الزهور؛ جنوب غرب الولايات المتحدة إلى المكسيك)",
 "verbesina helianthoides": "عشبة الحصى (عشب معمر بزهور صفراء؛ جنوب وجنوب وسط الولايات المتحدة)",
 "verbesina virginica": "عشبة الصقيع (عشب معمر طويل له عناقيد من الزهور البيضاء؛ شرق الولايات المتحدة)",
 "verbiage": "ألفاظ, صياغة (الطريقة التي يتم بها التعبير عن شيء ما بالكلمات) / إسهاب, كثرة الكلام (وفرة مفرطة من الكلمات)",
 "verbolatry": "عبادة الألفاظ (تقديس الكلمات)",
 "verbose": "إِطْنَابِيّ, ثَرْثَار (يَسْتَخْدِمُ أَوْ يَحْتَوِي عَلَى كَلِمَاتٍ أَكْثَرَ مِمَّا يَنْبَغِي)",
 "verbosely": "بإسهاب, بإطناب (بطريقة مسهبة وكثيرة الكلام)\nمثال: شرحت أفكارها بإسهاب",
 "verboseness": "إطناب, حشو (أسلوب تعبيري يستخدم كلمات مفرطة أو فارغة)",
