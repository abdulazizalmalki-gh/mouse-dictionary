 "vip": "شخصية هامة جداً, كبار الشخصيات (شخص مهم أو مؤثر (وغالباً ما يكون متسلطاً))",
 "viper": "أَفْعًى",
 "viper's bugloss": "زهرة الأفعى, شوك أزرق (عشب أوروبي شائك خشن بسنابل من الزهور الزرقاء؛ مستوطن في الولايات المتحدة)",
 "viper's grass": "تيس الجبل الإسباني, ساسفي أسود (عشب معمر من جنوب أوروبا له أوراق كاملة ضيقة ورؤوس زهرية صفراء منعزلة وجذور طويلة سوداء صالحة للأكل تشبه الجزر)",
 "vipera aspis": "أفعى أوروبية (من جنوب أوروبا؛ تشبه الأفعى الشائعة ولكنها أصغر)",
 "vipera berus": "أفعى شائعة (أفعى أرضية صغيرة شائعة في شمال أوراسيا)",
 "viperine grass snake": "ثعبان العشب الأفعواني (ثعبان عشب صغير غير ضار)",
 "viracept": "فيراسيبت, نلفينافير (مثبط للبروتياز (الاسم التجاري فيراسيبت) يستخدم في علاج فيروس نقص المناعة البشرية عادة بالاشتراك مع أدوية أخرى)",
 "viraemia": "فيريميا, وجود الفيروس في الدم (وجود فيروس في مجرى الدم)\nمثال: فيريميا نشرت فيروس الجدري إلى الأعضاء الداخلية",
 "virago": "أمازونية, امرأة مترجلة (امرأة ضخمة وقوية وعدوانية) / امرأة مترجلة, متسلطة (امرأة صاخبة أو كثيرة التوبيخ أو متسلطة)",
 "viral": "فيروسي (متعلق بفيروس أو ناتج عنه)\nمثال: عدوى فيروسية",
 "viral delivery vector": "ناقل توصيل فيروسي (ناقل جيني يستخدم فيروساً قهقرياً)",
 "viral haemorrhagic fever": "حمى نزفية (مجموعة من الأمراض التي تسببها عدوى فيروسية؛ تلي الحمى والأعراض المعوية نزيف شعيري)",
 "viral hemorrhagic fever": "حمى نزفية (مجموعة من الأمراض التي تسببها عدوى فيروسية؛ تلي الحمى والأعراض المعوية نزيف شعيري)",
 "viral hepatitis": "التهاب الكبد الفيروسي (التهاب الكبد الناجم عن فيروس)",
 "viral infection": "عدوى فيروسية (عدوى يسببها فيروس ممرض للبشر)",
 "viral pneumonia": "التهاب رئوي فيروسي (التهاب رئوي يسببه فيروس)",
 "virama": "وِرَام",
 "viramune": "فيرامون, نيفيرابين (مثبط المنتسخة العكسية غير النوكليوزيدي (الاسم التجاري فيرامون) يستخدم لعلاج الإيدز وفيروس نقص المناعة البشرية)",
 "virazole": "ريبافيرين, فيرازول (عامل مضاد للفيروسات يُستنشق (الاسم التجاري فيرازول) قد يستخدم لعلاج الالتهابات الفيروسية الخطيرة)",
 "viremia": "فيريميا, وجود الفيروس في الدم (وجود فيروس في مجرى الدم)\nمثال: فيريميا نشرت فيروس الجدري إلى الأعضاء الداخلية",
 "vireo": "خضيري (أي من الطيور الأمريكية الصغيرة المتنوعة آكلة الحشرات ذات لون زيتوني رمادي بشكل رئيسي)",
 "vireo olivaceous": "فيريو أحمر العينين (من شمال أمريكا الشمالية له قزحية حمراء وجسم رمادي زيتوني مع أجزاء سفلية بيضاء)",
 "vireo solitarius": "فيريو منعزل (من شرق أمريكا الشمالية له رأس رمادي مزرق وجسم أخضر في الغالب)",
 "vireo solitarius solitarius": "فيريو أزرق الرأس (فيريو شائع في شمال شرق أمريكا الشمالية برأس رمادي مزرق)",
 "virga": "أذيال المطر, فيرجا (هطول خفيف يتبخر قبل وصوله إلى الأرض (خاصة عندما يكون الهواء السفلي منخفض الرطوبة))",
 "virgil": "فِرْجِيل / فَرْقِيلَش",
 "virgilia capensis": "فيرجيليا, كيربوم (شجرة ذات أوراق ريشية فردية وعناقيد من الزهور العطرة الوردية إلى الأرجوانية)",
 "virgilia divaricata": "فيرجيليا متباعدة, كيربوم (شجرة سريعة النمو مستديرة الرأس ذات زهور بيضاء عطرة إلى زهرية داكنة؛ تزرع للزينة)",
 "virgilia oroboides": "فيرجيليا, كيربوم (شجرة ذات أوراق ريشية فردية وعناقيد من الزهور العطرة الوردية إلى الأرجوانية)",
 "virgin": "بتول, بِكْر (المنقطعه عن الرجال)",
 "virgin birth": "ميلاد, ولادة عذرية (العقيدة اللاهوتية القائلة بأن يسوع المسيح لم يكن له أب بشري؛ يعتقد المسيحيون أن ولادة يسوع حققت نبوءات العهد القديم وحضرتها المعجزات؛ يُحتفل بالميلاد…) / توالد عذري, ولادة عذرية (حمل بشري دون إخصاب من قبل رجل)",
 "virgin forest": "غابة بكر, غابة قديمة النمو (غابة أو أرض حرجية ذات نظام بيئي ناضج أو مفرط النضج لم يتأثر تقريباً بالنشاط البشري)",
 "virgin islands": "اَلْجُزُر اَلْعَذْرَاء",
 "virgin mary": "مَرْيَم اَلْعَذْرَاء ((في الديانات الإبراهيمية) مريم بنت عمران، وهي أم النبي عِيسَى، والمرأة الوحيدة التي ورد ذكرها في القرآن، حيث سميت على اسمها السورة التاسعة عشر؛ اسم شخصي معطًى لدى الإناث من العَرَب)\nمثال: مريم طرقت الباب.",
 "virgin wool": "صوف بكر (صوف لم يستخدم من قبل؛ صوف لم يُعالج أو يُنسج من قبل)",
 "virgin's bower": "لحية العجوز, ياسمين بري فرجيني (نبات متسلق شائع في شرق أمريكا الشمالية يمتد فوق النباتات الأخرى ويحمل عناقيد عديدة من الزهور البيضاء الكريمية الصغيرة)",
 "virginal": "بِكْر, طَاهِر (في حالة عذريّة جنسيّة) / بِكْر, عَذْرِيّ (لم يُمَسّ ولم يُدَنَّس) / بتولي, عذري (مميز للعذراء أو العذرية) / فيرجينال (هاربسيكورد مستطيل بدون أرجل؛ كان يعزف عليه (عادة النساء) في القرنين السادس عشر والسابع عشر)\nمثال: فساتين بيضاء عذرية",
 "virginal membrane": "غشاء البكارة (طية من الأنسجة تغطي جزئياً مدخل المهبل لدى العذراء)",
 "virginia": "فِيرْجِينِيَا, فِرْجِينْيَا",
 "virginia bluebell": "جريس فرجينيا, ميرتنسيا (عشب قائم أملس في شرق أمريكا الشمالية له أوراق كاملة وأزهار زرقاء مبهرجة تكون وردية في البرعم)",
 "virginia chain fern": "سرخس السلسلة الفرجيني (سرخس أمريكي شمالي)",
 "virginia cowslip": "جريس فرجينيا, ميرتنسيا (عشب قائم أملس في شرق أمريكا الشمالية له أوراق كاملة وأزهار زرقاء مبهرجة تكون وردية في البرعم)",
 "virginia creeper": "فرجينيا الزاحفة, لبلاب أمريكي (كرمة شائعة في أمريكا الشمالية بأوراق مركبة وثمار تشبه التوت الأسود المزرق)",
 "virginia crownbeard": "عشبة الصقيع (عشب معمر طويل له عناقيد من الزهور البيضاء؛ شرق الولايات المتحدة)",
 "virginia deer": "أيل أبيض الذيل, أيل فرجينيا (أيل شائع في أمريكا الشمالية؛ ذيله له جانب سفلي أبيض)",
 "virginia fence": "سياج متعرج (سياج عوارض يتكون من خط متعرج من القضبان المتشابكة)",
 "virginia ham": "هام فرجينيا (هام قليل الدهن مدخن بخشب الجوز؛ لحمه أحمر داكن)",
 "virginia mallow": "خبازة فرجينيا (عشب معمر جميل طويل من جنوب شرق الولايات المتحدة له أوراق تشبه القيقب وزهور بيضاء)",
 "virginia oyster": "محار فرجينيا (محار صالح للأكل شائع في ساحل المحيط الأطلسي لأمريكا الشمالية)",
 "virginia pine": "صنوبر جيرسي, صنوبر فرجينيا (صنوبر شجيري صغير شائع في شرق الولايات المتحدة له فروع متناثرة ملتوية غالباً وإبر قصيرة في حزم من 2)",
 "virginia reel": "ريل, فرجينيا ريل (رقصة ريفية أمريكية تبدأ بمواجهة الأزواج لبعضهم البعض في خطين)",
 "virginia serpentaria": "جذر الثعبان الفرجيني (نبات من الغابات الشرقية للولايات المتحدة)",
 "virginia serpentary": "جذر الثعبان الفرجيني (نبات من الغابات الشرقية للولايات المتحدة)",
 "virginia snakeroot": "جذر الثعبان الفرجيني (نبات من الغابات الشرقية للولايات المتحدة)",
 "virginia spring beauty": "جمال الربيع الفرجيني, كلايتونيا فرجينية (نبات معمر ذو ورم صغير يزرع لوريدته المنخفضة من الأوراق اللحمية وعناقيد الزهور البيضاء المشوبة بالوردي؛ شرق أمريكا الشمالية)",
 "virginia stock": "مالكولميا بحرية, مخزون فرجينيا (عشب متفرع منتصب يزرع لعناقيده الرخوة من الزهور البيضاء أو الوردية أو الحمراء أو الليلكية العطرة؛ موطنه الرمال والمنحدرات البحرية في جنوب غرب اليونان…)",
 "virginia strawberry": "فراولة فرجينيا, فراولة قرمزية (فراولة برية من أمريكا الشمالية ذات ثمار قرمزية حلوة؛ مصدر للعديد من أصناف الفراولة المزروعة)",
 "virginia thimbleweed": "شقيقة النعمان الفرجينية (شقيقة نعمان من وسط وشرق أمريكا الشمالية)",
 "virginia waterleaf": "هايدروفيلوم, ورقة الماء الفرجينية (عشب معمر بارز بزهور بيضاء؛ تستخدم أوراقه أحياناً كخضروات صالحة للأكل في جنوب شرق الولايات المتحدة)",
 "virginian": "فيرجيني (مواطن أو مقيم في فيرجينيا)",
 "virginian stock": "مالكولميا بحرية, مخزون فرجينيا (عشب متفرع منتصب يزرع لعناقيده الرخوة من الزهور البيضاء أو الوردية أو الحمراء أو الليلكية العطرة؛ موطنه الرمال والمنحدرات البحرية في جنوب غرب اليونان…)",
 "virginian sumac": "سماق قرن الوعل, سماق مخملي (شجرة شجيرية متساقطة الأوراق في شرق أمريكا الشمالية بأوراق مركبة تتحول إلى اللون الأحمر اللامع في الخريف وعناقيد كثيفة من الزهور الصفراء المخضرة تليها…)",
 "virginian witch hazel": "بندق الساحرة الفرجيني (شجيرة شائعة في شرق أمريكا الشمالية لها زهور صفراء صغيرة تظهر بعد سقوط الأوراق)",
 "virginity": "بَكَارَة, بَتُولِيَّة",
 "virgo": "بُرْج الْعَذْرَاء, الْعَذْرَاء (ظهر وارتفع) / بُرْج اَلْعَذْرَاء, العذراء (ظهر وارتفع)\nمثال: وصل كارل إلى برج آخر.",
 "virgule": "شرطة مائلة (علامة ترقيم ('/') تستخدم لفصل عناصر المعلومات ذات الصلة)",
 "viricidal": "مبيد للفيروسات (يميل إلى تدمير الفيروسات)",
 "viricide": "مبيد للفيروسات (عامل (فيزيائي أو كيميائي) يعطل الفيروسات أو يدمرها)",
 "viridity": "أخضر, خضرة (اللون الأخضر أو الصبغة؛ يشبه لون العشب النامي)",
 "virile": "رَجُولِيّ, فُحُولِيّ (من سمات الرجل وصفاته) / فحل, قوي جنسياً ((للذكر) قادر على الجماع) / فَتِيّ, مَلِيء بِالحَيَوِيَّة (يتسم بالطاقة والحيوية والنشاط)",
 "virilisation": "استرجال, تذكر (التطور غير الطبيعي لخصائص جنسية ذكرية في الأنثى (عادة نتيجة للعلاجات الهرمونية أو خلل في الغدة الكظرية))",
 "virilism": "استرجال (تطور الخصائص الجنسية الثانوية الذكرية لدى الأنثى (أو قبل الأوان لدى صبي صغير))",
 "virility": "فُحُولَة",
 "virility drug": "دواء علاج العجز الجنسي, عقار الفحولة (دواء لعلاج العجز الجنسي الناتج عن ضعف الانتصاب)",
 "virilization": "استرجال, تذكر (التطور غير الطبيعي لخصائص جنسية ذكرية في الأنثى (عادة نتيجة للعلاجات الهرمونية أو خلل في الغدة الكظرية))",
 "virino": "فِيرِينُو ((علم الأحياء الدقيقة) جسيم معدٍ افتراضي يعتقد أنه سبب مرض الرعاش والأمراض التنكسية الأخرى للجهاز العصبي المركزي؛ يتكون من حمض نووي في غطاء واقٍ من…)",
 "virion": "جُسَيْم فَيْرُوسِيّ, فِيرِيُون ((علم الفيروسات) جسيم فيروسي كامل؛ حمض نووي وقفيصة (وغلاف دهني في بعض الفيروسات))",
 "viroid": "شبيه الفيروس, فيرويد (أصغر الفيروسات؛ فيروس نباتي يترتب حمضه النووي الريبوزي في كروموسوم دائري بدون غلاف بروتيني)",
 "virological": "فيروسي (متعلق بعلم الفيروسات)\nمثال: بحث فيروسي",
 "virologist": "عالم فيروسات (متخصص في علم الفيروسات)",
 "virology": "علم الفيروسات (فرع العلوم الطبية الذي يدرس الفيروسات والأمراض الفيروسية)",
 "virtu": "أنتيكات فنية, تحف فنية (التحف الفنية مجتمعة (خاصة التحف القديمة الجميلة)) / جودة فنية, قيمة فنية (الجودة الفنية (للتحف والأعمال الفنية)) / خبرة فنية, ولع بالتحف (حب أو تذوق للأشياء الفنية الجميلة)",
 "virtual": "خَيَالِيّ",
 "virtual image": "خيال, صورة افتراضية (صورة بصرية منعكسة (كما تُرى في مرآة مستوية))",
 "virtual memory": "ذاكرة افتراضية, ذاكرة ظاهرية ((في علم الحاسوب) ذاكرة يتم إنشاؤها باستخدام القرص الصلب لمحاكاة ذاكرة وصول عشوائي إضافية؛ مساحة التخزين القابلة للعنونة المتاحة لمستخدم نظام الحاسوب…)",
 "virtual particle": "جُسَيْم اِفْتِرَاضِيّ (في الفيزياء: الجُسيْمات التحت ذريّة، أي الجُسيْمات الأوليّة والمركّبة (معنى مستحدث))\nمثال: نحن نعيش بعض اللحظات الحزينة حقا لأن بلادنا عانت من خسارة جسيمة. وسوف يستغرق وقتا طويلا قبل أن تعود إلى مجدها السابق.",
 "virtual reality": "وَاقِع اِفْتِرَاضِيّ (الأمر الذي حَدَثَ وحَصَلَ؛ الحَال كما هي عليه، الحَقِيقَة الملموسة) / حَقِيقَة ظَاهِرِيَّة (الحَقّ، نقيض البَاطِل؛ نقيض المَجَاز)\nمثال: أنا واقع في حبك",
 "virtual storage": "ذاكرة افتراضية, ذاكرة ظاهرية ((في علم الحاسوب) ذاكرة يتم إنشاؤها باستخدام القرص الصلب لمحاكاة ذاكرة وصول عشوائي إضافية؛ مساحة التخزين القابلة للعنونة المتاحة لمستخدم نظام الحاسوب…)",
 "virtualization": "بِيئَة اِفْتِرَاضِيَّة (النُزُوْل أو المَنْزِل؛ الحَال)\nمثال: نشأ جون في بيئة سعيدة.",
 "virtually": "تقريباً, على وشك ((للأفعال أو الحالات) قريبة جداً من الاكتمال ولكن ليس تماماً) / عملياً, فعلياً (في الجوهر أو التأثير ولكن ليس في الواقع)\nمثال: العمل قد انتهى تقريباً",
 "virtue": "فَضِيلَة / عِفَّة, طَهَارَة",
 "virtue signalling": "رِيَاء",
 "virtuosity": "اتقان, براعة فنية (المهارة الفنية أو الطلاقة أو الأسلوب الذي يظهره الفنان البارع)",
 "virtuoso": "بارع, جهبذ (شخص يتمتع بمهارة مذهلة في أي مجال) / فيرتوزو, موسيقي بارع (موسيقي يمتلك إتقاناً فائقاً للتقنية والفن)",
 "virtuous": "فَاضِل",
 "virtuously": "بِعِفَّة (بطريقة عفيفة وفاضلة) / أخلاقياً, بفضيلة (بطريقة أخلاقية)\nمثال: عاشت بعفة",
 "virtuousness": "تميز أخلاقي, فضيلة (صفة فعل ما هو صواب وتجنب ما هو خطأ)",
 "virucidal": "مبيد للفيروسات (يميل إلى تدمير الفيروسات)",
 "virucide": "مبيد للفيروسات (عامل (فيزيائي أو كيميائي) يعطل الفيروسات أو يدمرها)",
 "virulence": "حدة الجرثوم",
 "virulency": "حقد دفين, ضراوة (عداء شديد) / خُبْث, ضَرَاوَة (الضرر الشديد (مثل قدرة الكائنات الحية الدقيقة على التسبب في المرض))\nمثال: ضراوة الرجل العجوز الخبيث",
 "virulent": "خَبِيث, شَدِيد العَدْوَى (مُعدٍ؛ لديه القدرة على التسبب في المرض) / حَارِق, لَاذِع (قاسٍ أو كاوٍ في اللهجة) / سَامّ قَاتِل, مُفْرِز لِلسُّمّ (بالغ السمية أو الضرر؛ يُنتج سمًّا)",
 "virulently": "بخبث, بضراوة (بطريقة خبيثة)\nمثال: تقدمت امرأة عجوز بضع خطوات لتهز قبضتها بضراوة في وجهي",
 "virus": "فِيرُوس, فَيْرُوس",
 "virus infection": "عدوى فيروسية (عدوى يسببها فيروس ممرض للبشر)",
 "virusoid": "شبيه الفيروس, فيرويد (أصغر الفيروسات؛ فيروس نباتي يترتب حمضه النووي الريبوزي في كروموسوم دائري بدون غلاف بروتيني)",
