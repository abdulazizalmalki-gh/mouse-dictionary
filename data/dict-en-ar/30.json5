 "washingtonian": "واشنطني (من أو يتعلق بولاية واشنطن أو يقع فيها) / واشنطني (من أو يتعلق بعاصمة الولايات المتحدة) / واشنطني (من أو يتعلق بالأشخاص الذين يديرون الحكومة الفيدرالية) / واشنطني (من أو يتعلق بجورج واشنطن أو على طريقته)\nمثال: متاحف واشنطنية",
 "washman": "غسالة (امرأة عاملة تقوم بغسل الملابس للآخرين)",
 "washout": "فاشِل, مُخْفِق (شخص غير ناجح) / انجراف, جرف (عملية التعرية المتمثلة في جرف التربة أو الحصى بواسطة الماء (كما يحدث في الطرق)) / انجراف, جرف (القناة أو الكسر الناتج عن تآكل التربة اللينة نسبياً بواسطة الماء)\nمثال: شاهدوا من المنزل انجراف حديقتهم المزروعة حديثاً بواسطة الماء",
 "washpot": "وعاء غسيل (قدر أو وعاء يتم غسل أي شيء فيه)",
 "washrag": "فوطة وجه, ليفة (بياضات حمام تتكون من قطعة قماش تستخدم لغسل الوجه والجسم)",
 "washroom": "دورة مياه, مغسلة (مرحاض (خاصة مرحاض في مكان عام))",
 "washstand": "مَغْسَلَة (مكان الغسل، لا تخلط بينها وبين مِغْسَلَة؛ حانوت يقوم بغسل وكيّ الملابس وغيرها من الستائر والبُسُط مقابل أجر)\nمثال: كان في المغسلة.",
 "washtub": "حوض غسيل, طشت غسيل (حوض يمكن غسل الملابس أو البياضات فيه)",
 "washup": "استحمام, اغتسال (فعل غسل النفس (أو شخص آخر)) / غسل الأطباق, غسل الصحون (فعل غسل الأطباق)",
 "washwoman": "غسالة (امرأة عاملة تستقبل الغسيل)",
 "washy": "بَاهِت, مَغْسُول (فاقد اللون بسبب التعرّض للضوء أو الغسيل المتكرّر) / رَقِيق, مَائِيّ (مُخَفَّف أَكْثَر مِنَ اللَّازِم؛ ضَعِيف وَبِلَا طَعْم)",
 "wasit": "وَاسِط",
 "wasiti": "وَاسِطِيّ",
 "wasla": "وَصْلَة, هَمْزَةُ الْوَصْلِ",
 "wasp": "دَبُّور, زُنْبُور (حشرة تشبه النحل إلا أنها أكبر ولا تنتج عسلا، لها قرصة مؤذية بواسطة إبرة في دُبُرِها)",
 "wasp waist": "خصر النحلة (خصر نحيل جداً)",
 "wasp's nest": "عُشُّ الدَّبَابِير (مسكن للدبابير أو الزنابير)",
 "wasp-waisted": "دَقِيق الخَصْر, نَحِيل الخَصْر (ذُو خَصْر صَغِير وَنَحِيل)",
 "waspish": "حَادّ الطَّبْع, لَاسِع (شديد الانفعال وسريع الغضب)",
 "wasps' nest": "عُشُّ الدَّبَابِير (مسكن للدبابير أو الزنابير)",
 "wassail": "واسيل (بونش مصنوع من الإيل المحلى أو النبيذ المسخن مع التوابل والتفاح المحمص؛ خاصة في عيد الميلاد)",
 "wassailer": "شارب نخب (شخص يشرب نخب صحة شخص ما أو نجاح مشروع ما) / معاقر, مُنادِم (شخص يستمتع بحفلات الشرب الصاخبة)",
 "wasserman reaction": "اختبار فاسترمان (فحص دم للكشف عن الزهري)",
 "wassermann": "اختبار فاسترمان (فحص دم للكشف عن الزهري)",
 "wassermann test": "اختبار فاسترمان (فحص دم للكشف عن الزهري)",
 "wastage": "فاقد, هدر (أي شيء مفقود بسبب الاستعمال أو الهدر) / ضياع, هدر (عملية الإهدار)",
 "waste": "إسراف, تبديد (نشاط غير مجدٍ أو غير مربح؛ استخدام أو إنفاق أو استهلاك بلا تفكير أو بإهمال) / قَفْر, مَهْجُور (في منطقة نائية وموحشة؛ خَرِبة) / إضرار بالمال, تبديد الممتلكات ((قانون) انخفاض في قيمة العقار ناتج عن فعل أو إهمال) / إتلاف, إهدار (سمة إهدار الموارد)\nمثال: إذا لم يحقق الجهد أي مكسب تعويضي فهو هدر",
 "waste baler": "مكبس حزم, مكبس نفايات (آلة تستخدم بشكل أساسي لضغط النفايات والورق المقوى والبلاستيك وغيرها من المواد القابلة لإعادة التدوير)",
 "waste basket": "سلة أوراق, سلة مهملات (حاوية مفتوحة من الأعلى؛ للأوراق المرمية وغيرها من القمامة)",
 "waste material": "مخلفات, نفايات (أي مواد غير مستخدمة ومرفوضة على أنها عديمة القيمة أو غير مرغوب فيها)\nمثال: يجمعون النفايات مرة واحدة في الأسبوع",
 "waste matter": "مخلفات, نفايات (أي مواد غير مستخدمة ومرفوضة على أنها عديمة القيمة أو غير مرغوب فيها)\nمثال: يجمعون النفايات مرة واحدة في الأسبوع",
 "waste of effort": "هدر الجهد (جهد لا طائل منه)",
 "waste of energy": "هدر الجهد (جهد لا طائل منه)",
 "waste of material": "هدر المواد (استهلاك غير مجدٍ للمواد)",
 "waste of money": "هدر المال (المال الذي ينفق مقابل عائد غير كاف)\nمثال: قال السناتور إن المشروع كان هدراً للمال",
 "waste of time": "مضيعة للوقت, هدر الوقت (تكريس الوقت لنشاط غير مجد)\nمثال: قد يكون هدر الوقت قاتلاً",
 "waste paper": "نفايات ورقية, ورق مهمل (الورق المتخلص منه بعد الاستخدام)",
 "waste pipe": "أنبوب صرف, أنبوب نفايات (أنبوب يتم من خلاله نقل السوائل بعيداً)",
 "waste product": "مخلفات, نفايات (أي مواد غير مستخدمة ومرفوضة على أنها عديمة القيمة أو غير مرغوب فيها)\nمثال: يجمعون النفايات مرة واحدة في الأسبوع",
 "waste time": "ضَيَّعَ اَلْوَقْت",
 "waste-paper basket": "سلة أوراق, سلة مهملات (حاوية مفتوحة من الأعلى؛ للأوراق المرمية وغيرها من القمامة)",
 "waste-yard": "مزبلة, مقلب قمامة (قطعة أرض يتم فيها تفريغ مواد النفايات)",
 "wastebasket": "سلة أوراق, سلة مهملات (حاوية مفتوحة من الأعلى؛ للأوراق المرمية وغيرها من القمامة)",
 "wastebin": "حاوية نفايات, سلة مهملات (حاوية تُحفظ فيها النفايات حتى يتم جمعها)",
 "wasted": "ضامر, مهزول ((عن عضو أو جزء من الجسم) متناقص في الحجم أو القوة نتيجة لمرض أو إصابة أو قلة الاستخدام) / مُتَهَالِك, هَزِيل جِدًّا (شَدِيد النُّحُول خَاصَّةً بِسَبَب المَرَض أَوِ الجُوع أَوِ البَرْد) / مُبَدَّد, مُهْدَر (لَمْ يُسْتَغَلّ بِشَكْل جَيِّد) / عَبَثِيّ, لَا طَائِلَ مِنْه (لَا يَخْدِمُ أَيَّ غَرَضٍ مُفِيد؛ لَا مُبَرِّرَ لِوُجُودِه)\nمثال: أدى الشلل الجزئي إلى ذراع يسرى ضامرة",
 "wasteful": "مُبَدِّد, مُخَرِّب (يُحْدِثُ الخَرَابَ وَالدَّمَارَ) / مُبَذِّر, مُسْرِف (غير كفء في استخدام الوقت والجهد والموارد) / مبذر, مسرف (يميل إلى التبذير والإهدار)",
 "wastefully": "بإسراف, بتبذير (بطريقة مسرفة)\nمثال: ما زلنا أغنياء بإسراف مقارنة بالآخرين",
 "wastefulness": "إسراف, تبديد (نشاط غير مجدٍ أو غير مربح؛ استخدام أو إنفاق أو استهلاك بلا تفكير أو بإهمال) / إتلاف, إهدار (سمة إهدار الموارد)\nمثال: إذا لم يحقق الجهد أي مكسب تعويضي فهو هدر",
 "wasteland": "أَرْض خَرَاب (الكَوْكَب الذي نعيش عليه. لا جمع له؛ البَرّ، ضد البَحْر. يجمع على أرضون)\nمثال: أرض الله واسعة.",
 "wastepaper basket": "سلة أوراق, سلة مهملات (حاوية مفتوحة من الأعلى؛ للأوراق المرمية وغيرها من القمامة)",
 "waster": "مخرب, مدمر (شخص يدمر أو يخرب) / مُبَدِّد, مُضيع (شخص يبدد الموارد في إشباع رغباته الذاتية)\nمثال: مدمر للبيئة",
 "wastewater": "مياه عادمة, مياه مبتذلة (ماء مخلوط بمواد النفايات)",
 "wasteweir": "مجرى الفائض, مفيض (قناة تحمل المياه الزائدة فوق السد أو حوله أو حول أي عائق آخر)",
 "wasteyard": "مزبلة, مقلب قمامة (قطعة أرض يتم فيها تفريغ مواد النفايات)",
 "wasting": "ضمور (انخفاض في حجم عضو ناتج عن مرض أو عدم الاستخدام) / دنف, هزال (أي انخفاض عام في الحيوية وقوة الجسم والعقل ناتج عن مرض مزمن منهك)",
 "wasting away": "ضمور (انخفاض في حجم عضو ناتج عن مرض أو عدم الاستخدام)",
 "wasting disease": "تدرن رئوي, سل رئوي (يشمل الرئتين مع هزال تدريجي للجسم)",
 "wastrel": "مُبَدِّد, مُضيع (شخص يبدد الموارد في إشباع رغباته الذاتية)",
 "watch": "سَاعَة (ثُلْث ثُمْن اليَوْم بمعنى مجموع النَهَار واللَيْل، أي جزء من أربعة وعشرين جزءا من مجموع النهار والليل وتتكون من ستين دَقِيقَة؛ الوَقْت الحاضر، الآن) / حَارِس / رَصَدَ (الرَّصْد : المُراقبة؛ الرَّصد الجوّي: دراسة الأَحوال الجوّيَّة لمعرفة تقلُّبات الطقس) / حَذِرَ (حذِر الشّخصُ: تيقّظ واستعدّ وتأهّب وتنبّه؛ حذِر الأمرَ: كَتَمَه وأخفاه) / حَرَسَ (حَفِظَ الشيء أو الشخص أو مكاناً من المخاطر أو الأضرار؛ راقب شيئاً أو شخصاً بعناية لضمان الأمان)\nمثال: درست لمدة ساعة.",
 "watch bracelet": "حزام الساعة, سوار المعصم (شريط من القماش أو الجلد أو حلقات معدنية متصل بساعة اليد ويلف حول المعصم)",
 "watch cap": "قبعة بحرية صوفية (قبعة صوفية زرقاء داكنة محبوكة يرتديها البحارة في الطقس البارد أو العاصف)",
 "watch case": "هيكل الساعة (الغلاف المعدني الذي يحتوي على أجزاء الساعة)",
 "watch chain": "سلسلة الساعة (سلسلة قصيرة أو شريط يربط ساعة الجيب بصدرية الرجل)",
 "watch crystal": "بلورة الساعة, زجاجة الساعة (غطاء واقٍ يحمي وجه الساعة)",
 "watch fire": "نار المراقبة (نار تُشعل في الليل كإشارة)",
 "watch glass": "بلورة الساعة, زجاجة الساعة (غطاء واقٍ يحمي وجه الساعة) / زجاجة ساعة (مختبر) (أداة زجاجية للمختبر؛ طبق زجاجي ضحل يستخدم كسطح للتبخير أو لتغطية الكأس)",
 "watch guard": "سلسلة الساعة (سلسلة قصيرة أو شريط يربط ساعة الجيب بصدرية الرجل)",
 "watch key": "مفتاح الساعة (أداة لف تتكون من مفتاح بفتحة مربعة؛ تستخدم لتعبئة بعض الساعات)",
 "watch night": "سهر الليل (خدمة تعبدية (خاصة ليلة رأس السنة الجديدة))",
 "watch pocket": "جيب ساعة (جيب في الصدرية مخصص لحمل ساعة الجيب)",
 "watchband": "حزام الساعة, سوار المعصم (شريط من القماش أو الجلد أو حلقات معدنية متصل بساعة اليد ويلف حول المعصم)",
 "watchdog": "كلب حراسة (كلب مدرب لحراسة الممتلكات) / جِهَة رَقابِيَّة, حارِس (وصي أو مدافع ضد السرقة أو الممارسات غير القانونية أو الهدر)\nمثال: هي الرقيب العالمي على انتهاكات حقوق الإنسان",
 "watcher": "شاهد, متفرج (مراقب عن كثب؛ شخص ينظر إلى شيء ما (مثل عرض من نوع ما)) / سَاهِر, مُرَاقِب (شخص يحافظ على سهر تعبدي بجوار سرير مريض أو جثة ميت) / حارِس أَمْن, مُراقِب (حارس يقوم بالمراقبة)\nمثال: صفق المتفرجون للأداء",
 "watchful": "مُتَنَبِّه, يَقِظ (منخرط في أو معتاد على المراقبة الدقيقة) / حَذِر, سَاهِر (شديد الملاحظة والانتباه؛ يترقب الخطر المحتمل) / أَرِق, سَاهِر (يعاني من الأرق وعدم القدرة على النوم)\nمثال: قُبض عليه من قبل شرطيين يقظين",
 "watchfully": "بحذر, بيقظة (بطريقة يقظة)",
 "watchfulness": "ترقب, سهر (انتباه يقظ) / تنبه, تيقظ (عملية إيلاء اهتمام وثيق ومستمر)\nمثال: يبقي عيناً يقظة مفتوحة للمتاعب",
 "watching": "رصد, مراقبة (فعل المراقبة؛ أخذ نظرة متأنية)",
 "watchlist": "قَائِمَةُ مُرَاقَبَةٍ",
 "watchmaker": "سَاعَاتِيّ",
 "watchman": "حَارِس",
 "watchstrap": "حزام الساعة, سوار المعصم (شريط من القماش أو الجلد أو حلقات معدنية متصل بساعة اليد ويلف حول المعصم)",
 "watchtower": "مَرْقَب, بُرْج الْمُرَاقَبَة",
 "watchwoman": "حارسة, ناطورة (حارسة أنثى تقوم بالمراقبة)",
 "watchword": "كلمة سر, كلمة مرور (كلمة أو عبارة سرية لا يعرفها إلا مجموعة محددة) / صيحة الحرب, كلمة السر (شعار يستخدم لحشد الدعم لقضية ما)\nمثال: نسي كلمة السر",
 "water": "مِيَاه / سَقَى / أَسْقَى, سَقَى",
 "water absorption": "امتصاص الماء (كمية الماء التي تمتصها مادة مركبة عند غمرها في الماء لفترة محددة)\nمثال: مقارنة امتصاص الماء لمختلف أنواع البلاستيك ممكنة فقط إذا كانت عينات الاختبار ذات أبعاد متطابقة وفي نفس الحالة الفيزيائية",
 "water arum": "كالا برية, لوف الماء (نبات الأراضي الرطبة والمستنقعات في المناطق المعتدلة ذو أزهار خضراء صغيرة محاطة جزئياً بقنابة بيضاء وتوت أحمر)",
 "water avens": "أفينس أرجواني, أفينس مائي (نبات معمر منتصب من المنطقة المعتدلة الشمالية له أوراق ريشية وعدد قليل من الزهور المتدلية بكأس بني أرجواني وبتلات برتقالية ووردية)",
 "water back": "خزان مياه خلفي (سخان مياه يتكون من خزان أو أنابيب موضوعة في الجزء الخلفي من الموقد أو في صندوق النار الخاص بالموقد)",
 "water bear": "بَطِيء الخَطْو, بَطِيء المِشْيَة",
 "water bearer": "مَوْلُود بُرْج الدَّلْو ((علم التنجيم) شخص ولد بينما الشمس في برج الدلو)",
 "water bed": "سرير مائي (سرير بمرتبة مصنوعة من بلاستيك قوي ومملوءة بالماء)",
 "water beetle": "خنفساء الماء",
 "water birch": "بتولا المستنقعات, بتولا مائية (بتولا من غرب الولايات المتحدة تشبه البتولا الورقية ولكن لها لحاء بني)",
 "water bird": "طائر مائي (طائر مائي يعيش في المياه العذبة)",
 "water biscuit": "بسكويت الماء (بسكويت رقيق من الدقيق والماء يصنع عادة بدون دهن؛ يقدم غالباً مع الجبن)",
 "water bitternut": "بيكان مر, جوز الماء (جوز من جنوب الولايات المتحدة له العديد من الوريقات الضيقة ومكسرات مرة نوعاً ما)",
 "water blister": "فقاعة مائية (بثرة تحتوي على محتوى مائي صافٍ غير قيحي)",
 "water boatman": "بق الماء المجدف (بق مائي آكل للحوم له أرجل خلفية تشبه المجداف)",
 "water bottle": "قِنِّينَةُ مَاء (وعاء توضع فيه السوائل، ويصنع من مواد مختلفة مثل الزجاج والبلاستيك)\nمثال: لم يبق في القنينة أي ماء.",
 "water boy": "ساقي الماء, فتى الماء (مساعد ذكر يقوم بتوفير مياه الشرب)",
 "water buffalo": "جاموس الماء (جاموس آسيوي غالباً ما يتم استئناسه لاستخدامه كحيوان جر)"
}
