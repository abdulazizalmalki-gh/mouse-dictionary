 "ventral fin": "زعنفة بطنية, زعنفة حوضية (إحدى زوج من الزعانف المتصلة بحزام الحوض في الأسماك تساعد في التحكم في اتجاه الحركة؛ تقابل الأطراف الخلفية للفقاريات البرية)",
 "ventral horn": "جذر أمامي, جذر بطني (أحد جذري العصب الشوكي الذي يمر بطنياً من الحبل الشوكي ويتكون من ألياف حركية)",
 "ventral placentation": "وضع مشيمة حافي (مع وجود بويضات محمولة على الجدار على طول الدرز البطني لمبيض بسيط)",
 "ventral root": "جذر أمامي, جذر بطني (أحد جذري العصب الشوكي الذي يمر بطنياً من الحبل الشوكي ويتكون من ألياف حركية)",
 "ventrally": "بطنياً (في موقع أو اتجاه بطني)",
 "ventricle": "بُطَيْن",
 "ventricose": "بَطْنِيّ, مُنْتَفِخ الجَانِب (ذو انتفاخ في أحد الجوانب)",
 "ventricous": "بَطْنِيّ, مُنْتَفِخ الجَانِب (ذو انتفاخ في أحد الجوانب)",
 "ventricular": "بطيني (متعلق ببطين (القلب أو الدماغ))",
 "ventricular aneurysm": "أم الدم البطينية, تمدد الأوعية الدموية البطيني (تمدد موضعي أو نتوء في جدار البطين الأيسر للقلب (يحدث عادة بعد احتشاء عضلة القلب))",
 "ventricular fibrillation": "رجفان بطيني",
 "ventricular fold": "حبل صوتي كاذب (أي من الحبلين الصوتيين العلويين غير المشاركين في التصويت)",
 "ventricular septal defect": "عيب الحاجز البطيني (عيب خلقي شائع في القلب؛ تسمح فتحة غير طبيعية في الحاجز الفاصل بين البطينين بمرور الدم مباشرة من البطين الأيسر إلى الأيمن؛ الفتحات الكبيرة قد تسبب فشل…)",
 "ventriculus": "قانصة (جيب عضلي سميك الجدران أسفل الحوصلة في العديد من الطيور والزواحف لطحن الطعام)",
 "ventriloquism": "التكلم من البطن (فن إسقاط صوتك بحيث يبدو أنه يأتي من مصدر آخر (مثل دمية المتكلم من البطن))",
 "ventriloquist": "مُتَكَلِّم مِنْ بَطْنِه",
 "ventriloquist's dummy": "دمية المتكلم من البطن (دمية خشبية يسقط فيها المتكلم من البطن صوته)",
 "ventriloquy": "التكلم من البطن (فن إسقاط صوتك بحيث يبدو أنه يأتي من مصدر آخر (مثل دمية المتكلم من البطن))",
 "venture": "مجازفة, مغامرة (أي مشروع ينطوي على مغامرة خاصة المشروع ذو النتيجة غير المؤكدة) / مشروع مجازف, مغامرة تجارية (مشروع تجاري يخاطر بالخسارة لكنه يعد بالربح) / مضاربة, مغامرة تجارية (استثمار محفوف بالمخاطر ولكنه قد يدر أرباحاً كبيرة)\nمثال: كان يعلم أن السهم كان مضاربة عندما اشتراه",
 "venture capital": "رأس مال جريء, رأس مال مخاطر (ثروة متاحة للاستثمار في مشاريع جديدة أو مضاربة)",
 "venture capitalism": "رأس المال الاستثماري, رأسمالية المخاطرة (الرأسمالية التي تستثمر في المشاريع المبتكرة (خاصة التكنولوجيا العالية) حيث تكون الأرباح المحتملة كبيرة)",
 "venture capitalist": "صاحب رأس مال مغامر, مستثمر جريء (مضارب يوفر المال للمشاريع المبتكرة (خاصة في التكنولوجيا العالية))",
 "venturer": "مغامر (شخص يستمتع بالمخاطرة) / تاجر مغامر (تاجر يقوم بمشروع تجاري (خاصة المشاريع التي ترسل البضائع عبر البحار))",
 "venturesome": "جَرِيء, مُجَازِف (مُستعد لخوض المخاطر والمجازفة)",
 "venturesomeness": "حب المغامرة, روح المغامرة (سمة الميل للمغامرة)",
 "venturi": "أنبوب فنتوري (أنبوب ذو تضييق؛ يستخدم للتحكم في تدفق السوائل (كما في مدخل هواء المكربن))",
 "venturi tube": "أنبوب فينتوري (أنبوب قصير يدرج في خط أنابيب ويستخدم لقياس كمية السائل المتدفق في خط الأنابيب)",
