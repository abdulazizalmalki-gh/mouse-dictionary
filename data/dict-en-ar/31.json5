 "wyrd": "ويرد (تجسيد القدر؛ أي واحدة من الأخوات الغريبات الثلاث)",
 "wysiwyg": "مطابق للعرض (متعلق بـ أو كونه نظام معالجة نصوص يطبع النص تماماً كما يظهر على شاشة الكمبيوتر)",
 "wytensin": "غوانابنز, وايتينسين (دواء خافض لضغط الدم (الاسم التجاري وايتينسين) يقلل ضغط الدم عن طريق تأثيره على الجهاز العصبي المركزي)",
 "wyvern": "وايفرن (تنين ينفث النار يستخدم في شعارات النبالة في العصور الوسطى؛ له رأس تنين وذيل ثعبان وجسم بأجنحة ورجلين)",
 "x": "س (السِّين هو الحرف الخامس عشر من حروف الهجاء العربية بالترتيب الأبجدي للحروف العربية يسبقه حرف النُوْن ويلية حرف العَيْن وهو الحرف الثاني عشر بالترتيب…؛ تنقل المضارع من الحال إلى الاستقبال)",
 "x ray": "أشعة إكس, صورة أشعة سينية (صورة شعاعية مصنوعة بتعريض فيلم فوتوغرافي للأشعة السينية؛ تستخدم في التشخيص الطبي) / أشعة إكس, أشعة سينية (إشعاع كهرومغناطيسي قصير الموجة ينتج عندما تضرب إلكترونات عالية السرعة هدفاً صلباً)",
 "x-axis": "المحور السيني, محور السينات (المحور الأفقي في نظام إحداثي مستو)",
 "x-or circuit": "بوابة أو الحصرية (بوابة لـ (أو) الحصرية؛ دائرة في الكمبيوتر تعمل فقط إذا عمل أحد مدخلاتها فقط)",
 "x-radiation": "تصوير بالأشعة السينية (الحصول على صور باستخدام الأشعة السينية) / أشعة إكس, أشعة سينية (إشعاع كهرومغناطيسي قصير الموجة ينتج عندما تضرب إلكترونات عالية السرعة هدفاً صلباً)",
 "x-ray": "أَشِعَّة إِكْس, أَشِعَّة سِينِيَّة / صُورَة أَشِعَّة",
 "x-ray diffraction": "حيود الأشعة السينية (تشتت الأشعة السينية بواسطة ذرات البلورة؛ يظهر نمط الحيود بنية البلورة)",
 "x-ray film": "فيلم أشعة سينية (فيلم فوتوغرافي يستخدم لعمل صور الأشعة السينية)",
 "x-ray machine": "جهاز الأشعة السينية (جهاز يوفر مصدراً للأشعة السينية)",
 "x-ray photograph": "أشعة إكس, صورة أشعة سينية (صورة شعاعية مصنوعة بتعريض فيلم فوتوغرافي للأشعة السينية؛ تستخدم في التشخيص الطبي)",
 "x-ray photography": "تصوير بالأشعة السينية (التصوير الشعاعي الذي يستخدم الأشعة السينية لإنتاج صورة شعاعية)",
 "x-ray picture": "أشعة إكس, صورة أشعة سينية (صورة شعاعية مصنوعة بتعريض فيلم فوتوغرافي للأشعة السينية؛ تستخدم في التشخيص الطبي)",
 "x-ray therapy": "علاج بالأشعة السينية (الاستخدام العلاجي للأشعة السينية)",
 "x-ray tube": "أنبوب الأشعة السينية (أنبوب مفرغ يحتوي على هدف معدني يتم توجيه شعاع من الإلكترونات إليه بطاقة عالية لتوليد الأشعة السينية)",
 "x-raying": "تصوير بالأشعة السينية (الحصول على صور باستخدام الأشعة السينية)",
 "x64": "إكس 64",
 "x86": "إكس 86 (معمارية حاسوب مبنية على شريحة إنتل 8086)",
 "xanax": "ألبرازولام, زاناكس (عامل مضاد للقلق (الاسم التجاري زاناكس) من فئة البنزوديازيبين)",
 "xanthate": "زانثات (ملح أو إستر لحمض الزانثيك)",
 "xanthelasma": "لُوَيْحَة صَفْرَاء",
 "xanthemia": "اصفرار الدم, كاروتينيميا (زيادة الكاروتين في مجرى الدم؛ يمكن أن يسبب تحول الجلد إلى اللون الأصفر الشاحب أو الأحمر)",
 "xanthic acid": "حمض الزانثيك (أي من فئة الأحماض العضوية غير المستقرة التي تحتوي على الكبريت)",
 "xanthine": "زانثين (ناتج أكسدة بلوري لعملية التمثيل الغذائي للبروتينات النووية؛ طليعة لحمض اليوريك؛ يوجد في العديد من الأعضاء وفي البول)",
 "xanthoma": "ورم أصفر (مشكلة جلدية تتميز بتطور عقيدات صفراء غير منتظمة)",
 "xanthoma disseminatum": "ورم أصفر منتشر (ورم أصفر مزمن نادر يصيب البالغين تتطور فيه حطاطات برتقالية أو بنية على العديد من أسطح الجسم)",
 "xanthoma multiplex": "داء الورم الأصفر, ورم أصفر متعدد (أورام صفراء منتشرة (خاصة على المرفقين والركبتين)؛ ترتبط غالبًا باضطراب في استقلاب الدهون)",
 "xanthomatosis": "داء الورم الأصفر, ورم أصفر متعدد (أورام صفراء منتشرة (خاصة على المرفقين والركبتين)؛ ترتبط غالبًا باضطراب في استقلاب الدهون)",
 "xanthomonad": "زانثوموناس, صفراء (بكتيريا تنتج أصباغاً صفراء غير قابلة للذوبان في الماء؛ بعضها ممرض للنباتات)",
 "xanthophyl": "زانثوفيل, لوتين (أصباغ كاروتينويد صفراء في النباتات والدهون الحيوانية وصفار البيض)",
 "xanthophyll": "زانثوفيل, لوتين (أصباغ كاروتينويد صفراء في النباتات والدهون الحيوانية وصفار البيض)",
 "xanthopsia": "رؤية صفراء (عيب بصري تبدو فيه الأشياء ذات صبغة صفراء؛ يحدث أحياناً في حالات اليرقان)",
 "xanthosis": "اصفرار الجلد (تغير لون الجلد إلى الأصفر بشكل غير طبيعي)",
 "xanthosoma atrovirens": "قلقاس أمريكي, ياوتيا (نبات لوفي استوائي أمريكي له درنات صالحة للأكل تطهى وتؤكل مثل اليام أو البطاطس)",
 "xanthosoma sagittifolium": "قلقاس أمريكي, ياوتيا (نبات لوفي استوائي أمريكي له درنات صالحة للأكل تطهى وتؤكل مثل اليام أو البطاطس)",
 "xanthous": "أَصْفَر (بلون متوسط بين الأخضر والبرتقالي في الطيف اللوني؛ يشبه لون صفار البيض)",
 "xc": "تِسْعُونَ (يَدُلُّ عَلَى العَدَد 90) / تِسْعُون (العدد الأصلي الذي هو حاصل ضرب عشرة في تسعة)",
 "xci": "وَاحِد وَتِسْعُونَ (يَدُلُّ عَلَى العَدَد 91)",
 "xcii": "اِثْنَان وَتِسْعُونَ (يَدُلُّ عَلَى العَدَد 92)",
 "xciii": "ثَلَاثَة وَتِسْعُونَ (يَدُلُّ عَلَى العَدَد 93)",
 "xciv": "أَرْبَعَة وَتِسْعُونَ (يَدُلُّ عَلَى العَدَد 94)",
 "xcl": "مِئَة وَتِسْعُونَ (يَدُلُّ عَلَى العَدَد 190)",
 "xcv": "خَمْسَة وَتِسْعُونَ (يَدُلُّ عَلَى العَدَد 95)",
 "xcvi": "سِتَّة وَتِسْعُونَ (يَدُلُّ عَلَى العَدَد 96)",
 "xcvii": "سَبْعَة وَتِسْعُونَ (يَدُلُّ عَلَى العَدَد 97)",
 "xcviii": "ثَمَانِيَة وَتِسْعُونَ (يَدُلُّ عَلَى العَدَد 98)",
 "xe": "زينون (عنصر غازي خامل عديم اللون والرائحة يوجد في الغلاف الجوي للأرض بكميات ضئيلة)",
 "xena": "زِينَا",
 "xenicus gilviventris": "نمنمة الصخور (طائر قصير الذيل يشبه النمنمة)",
 "xenogeneic": "أجنبي المنشأ (يدل على أو يتعلق بخلايا أو أنسجة من أفراد ينتمون لأنواع مختلفة)",
 "xenogenesis": "تعاقب الأجيال, تولد متباين (تناوب شكلين مختلفين أو أكثر في دورة حياة نبات أو حيوان)",
 "xenoglossy": "زينوغلوسيا",
 "xenograft": "طعم أجنبي, طعم مغاير (نسيج من حيوان من نوع واحد يستخدم كطعم مؤقت (كما في حالات الحروق الشديدة) على فرد من نوع آخر)",
 "xenolith": "دَخِيلَة صَخْرِيَّة ((جيولوجيا) قطعة من الصخر من أصل مختلف عن الصخر الناري الذي توجد فيه)",
 "xenon": "إِكْسِينُون, زِينُون",
 "xenophobia": "رُهَاب الْأَجَانِب, كَرْه الْأَجَانِب",
 "xenophobic": "كَارِه لِلأَجَانِب (يعاني من كراهية الأجانب؛ يخاف أو يكره الغرباء والأجانب بشكل غير طبيعي)",
 "xenopus laevis": "ضفدع أفريقي ذو مخالب (ضفدع عديم اللسان موطنه أفريقيا؛ استقر في الولايات المتحدة نتيجة إطلاق حيوانات المختبرات وأحواض السمك)",
 "xenorhyncus asiaticus": "لقلق أسود العنق (لقلق أسترالي كبير أبيض في الغالب)",
 "xenotime": "زينوتيم (معدن بني إلى أصفر عبارة عن فوسفات الإيتريوم في شكل بلوري)",
 "xenotransplant": "زراعة أعضاء مغايرة (إجراء جراحي يتم فيه نقل أنسجة أو أعضاء كاملة من نوع بيولوجي إلى نوع آخر)",
 "xenotransplantation": "زرع الأعضاء (بَذَرَ الحَبَّ؛ أَنْبَتَ، نَمَّى)\nمثال: يريد الإنفصاليون زرع رايتهم بمواقع الأنترنت.",
 "xeranthemum": "زهرة الخلود, كسيرانثموم (أي نبات من جنس كسيرانثموم موطنه جنوب أوروبا له رؤوس زهور فضية أو قشية مع زهور أنبوبية أرجوانية)",
 "xeranthemum annuum": "زهرة الخلود, زيرنثيموم (أكثر أنواع الزهور الخالدة زراعة على نطاق واسع ولها زهور أرجوانية عادة؛ جنوب أوروبا إلى إيران؛ متوطنة في أماكن أخرى)",
 "xeric": "جفافي (يعاني من نقص في الرطوبة)\nمثال: توفر الصحاري بيئات جفافية",
 "xeroderma": "جفاف الجلد (شكل خفيف من السماك يتميز بجفاف وخشونة الجلد غير الطبيعيين)",
 "xeroderma pigmentosum": "جفاف الجلد المصطبغ (حالة وراثية نادرة تتميز بطفح جلدي على الجلد المكشوف يحدث في مرحلة الطفولة وحساسية للضوء مع حروق شمس شديدة؛ يورث كصفة جسدية متنحية تكون فيها عمليات…)",
 "xerodermia": "جفاف الجلد (شكل خفيف من السماك يتميز بجفاف وخشونة الجلد غير الطبيعيين)",
 "xerographic": "تصويري جاف, زيروغرافِي (من أو متعلق بالتصوير الجاف (الزيروغرافيا))",
 "xerographic copier": "آلة تصوير زيروغرافية, زيروكس (ناسخة (العلامة التجارية زيروكس) تنسخ المواد الرسومية بفعل الضوء على سطح عازل موصل ضوئياً مشحون كهربائياً يتم فيه تطوير الصورة الكامنة بمسحوق راتنجي)",
 "xerographic printer": "طابعة زيروجرافية (طابعة صفحات تستخدم عملية التصوير الزيروجرافي)",
 "xerography": "تصارخ جاف, زيروغرافيا (تكوين صورة بفعل الضوء على لوحة مشحونة مطلية خصيصًا؛ يتم تطوير الصورة الكامنة بمساحيق تلتصق فقط بالمناطق المشحونة كهربائياً)\nمثال: تحسين الحواف هو أمر جوهري في التصوير الجاف",
 "xeroma": "جفاف العين, رمد جاف (جفاف غير طبيعي لملتحمة وقرنية العين؛ قد يكون بسبب نقص جهازي في فيتامين أ)",
 "xerophile": "نبات جفافي, نبات صحراوي (نبات متكيف للحياة مع إمدادات محدودة من الماء؛ قارنه بالنبات المائي والنبات الوسطي)",
 "xerophilous plant": "نبات جفافي, نبات صحراوي (نبات متكيف للحياة مع إمدادات محدودة من الماء؛ قارنه بالنبات المائي والنبات الوسطي)",
 "xerophthalmia": "جفاف العين, رمد جاف (جفاف غير طبيعي لملتحمة وقرنية العين؛ قد يكون بسبب نقص جهازي في فيتامين أ)",
 "xerophthalmus": "جفاف العين, رمد جاف (جفاف غير طبيعي لملتحمة وقرنية العين؛ قد يكون بسبب نقص جهازي في فيتامين أ)",
 "xerophyllum tenax": "عشبة الدب, عشبة الزيروفيليوم (نبات من غرب أمريكا الشمالية له جذمورات خشبية وخصل من الأوراق القاعدية الصلبة التي تشبه العشب وسنابل من الزهور البيضاء الكريمية)",
 "xerophyte": "نبات جفافي, نبات صحراوي (نبات متكيف للحياة مع إمدادات محدودة من الماء؛ قارنه بالنبات المائي والنبات الوسطي)",
 "xerophytic": "جَفَافِيُّ النَّبَاتِ (مُتَكَيِّفٌ مَعَ بِيئَةٍ جَافَّةٍ)",
 "xerophytic plant": "نبات جفافي, نبات صحراوي (نبات متكيف للحياة مع إمدادات محدودة من الماء؛ قارنه بالنبات المائي والنبات الوسطي)",
 "xeroradiography": "تصوير إشعاعي جاف, زيرو راديوجرافي (التصوير الإشعاعي باستخدام الأشعة السينية وتقنيات التصوير الجاف (الزيروغرافية))",
 "xerostomia": "جفاف الفم (جفاف غير طبيعي للفم ناتج عن انخفاض إفراز اللعاب)",
 "xerotes": "جفاف, يبوسة (حالة عدم احتواء سائل أو عدم التغطية به (خاصة الماء))",
 "xerox": "آلة تصوير زيروغرافية, زيروكس (ناسخة (العلامة التجارية زيروكس) تنسخ المواد الرسومية بفعل الضوء على سطح عازل موصل ضوئياً مشحون كهربائياً يتم فيه تطوير الصورة الكامنة بمسحوق راتنجي) / زيروكس, نسخة زيروكس (نسخة مصنوعة بواسطة ناسخة زيروغرافية)",
 "xerox copy": "زيروكس, نسخة زيروكس (نسخة مصنوعة بواسطة ناسخة زيروغرافية)",
 "xerox machine": "آلة تصوير زيروغرافية, زيروكس (ناسخة (العلامة التجارية زيروكس) تنسخ المواد الرسومية بفعل الضوء على سطح عازل موصل ضوئياً مشحون كهربائياً يتم فيه تطوير الصورة الكامنة بمسحوق راتنجي)",
 "xerxes": "خْشَايَارْشَا, خَرْخَس",
 "xestobium rufovillosum": "خنفساء ساعة الموت (تحفر في الخشب وتصدر صوتاً يشبه دقات الساعة يعتقد شعبياً أنه ينذر بالموت)",
 "xhosa": "الْكُوسِيَّة, كُوسِيُّون",
 "xhosa language": "الخوسا (لغة بانتو وثيقة الصلة بالزولو، وهي ثاني أكثر اللغات الأم شيوعًا في جنوب أفريقيا)",
 "xi": "كْسِي (لَبِسَ الثوب، اِكْتَسَى به؛ اِكْتَسَى)",
 "xi'an": "شِيَان, شِيئَان",
 "xiamen": "شْيَامِن",
 "xii": "اِثْنَا عَشَرَ (يَدُلُّ عَلَى العَدَد 12) / اثْنَا عَشَر, دَزِينَة (العدد الأصلي الذي هو مجموع أحد عشر وواحد)",
 "xiii": "ثَلَاثَةَ عَشَرَ (يَدُلُّ عَلَى العَدَد 13) / ثَلَاثَة عَشَر (العدد الأصلي الذي هو مجموع اثنا عشر وواحد)",
 "ximenesia encelioides": "أقحوان الزبدة (عشب حولي خشن رمادي مخضر أصفر الزهور؛ جنوب غرب الولايات المتحدة إلى المكسيك)",
 "xining": "شِينِينْغ",
 "xinjiang": "شِينْجْيَانْغ",
 "xiongnu": "شيونغنو",
 "xiphias gladius": "أبو سيف, سمكة السيف (سمكة طعام بحرية كبيرة بلا أسنان ذات فك علوي طويل يشبه السيف؛ ليست من ذوات الدم البارد تماماً أي أنها قادرة على تدفئة أدمغتها وعيونها: توجد عالمياً في…)",
 "xiphium iris": "سوسن إسباني (سوسن بصلي من منطقة غرب البحر الأبيض المتوسط له زهور بنفسجية أرجوانية عادة)",
 "xiphoid process": "زائدة سيفية, ناتئ رهابي (أصغر الأجزاء الثلاثة لعظم القص؛ يتمفصل مع جسم القص والضلع السابع)",
 "xiphosurus polyphemus": "سرطان حدوة الحصان, سلطعون حدوة الحصان (مفصلي بحري كبير من ساحل المحيط الأطلسي لأمريكا الشمالية له درقة مقببة تشبه حدوة الحصان وذيل مدبب صلب)",
 "xishuangbanna dai": "تاي لو (فرع من لغات تاي، يُتحدث به في جنوب مقاطعة يونان الصينية)",
 "xiv": "أَرْبَعَةَ عَشَرَ (يَدُلُّ عَلَى العَدَد 14) / أَرْبَعَة عَشَر (العدد الأصلي الذي هو مجموع ثلاثة عشر وواحد)",
 "xix": "تِسْعَةَ عَشَرَ (يَدُلُّ عَلَى العَدَد 19) / تِسْعَة عَشَر (العدد الأصلي الذي هو مجموع ثمانية عشر وواحد)",
 "xl": "أَرْبَعُونَ (يَدُلُّ عَلَى العَدَد 40) / أَرْبَعُون (العدد الأصلي الذي هو حاصل ضرب عشرة في أربعة)",
