 "wide screen": "شاشة عريضة (شاشة عرض أعرض بكثير مما هي عالية)",
 "wide wale": "قماش مضلع عريض (كودري بأضلاع عريضة)",
 "wide-angle": "عين السمكة, واسع الزاوية (مكون من أو متعلق بعدسة عين السمكة)",
 "wide-angle lens": "عدسة واسعة الزاوية (عدسة كاميرا ذات زاوية رؤية أوسع من المعتاد (وعادةً بعد بؤري قصير))",
 "wide-awake": "مُتَيَقِّظ تَمَامًا (في حالة يقظة وانتباه كاملين) / سَاهِر, يَقِظ تَمَامًا (مستيقظ تماماً وفي كامل اليقظة)",
 "wide-body": "طائرة بممرين, طائرة عريضة البدن (طائرة ركاب تجارية بممرين)",
 "wide-body aircraft": "طائرة بممرين, طائرة عريضة البدن (طائرة ركاب تجارية بممرين)",
 "wide-cut": "فَضْفَاض, وَاسِع (ذو قماش وفير وواسع)",
 "wide-eyed": "جَاحِظ, وَاسِع العَيْنَيْن ((يوصف به العينان) مفتوحتان بالكامل أو متّسعتان) / سَاذَج, طِفْلِيُّ البَرَاءَة (يُظهر بساطة طفوليّة وسذاجة في التصديق)",
 "wide-open": "بِلَا ضَوَابِط, مُتَسَاهِل (متراخٍ في تطبيق القوانين) / مَفْتُوح عَلَى مِصْرَاعَيْه (مفتوح على اتّساعه)",
 "wide-ranging": "مُتَنَوِّع, وَاسِع النِّطَاق (مُخْتَلِف اخْتِلَافًا كَبِيرًا) / شَامِل, وَاسِع التَّنَوُّع (يتضمّن الكثير ومتنوّع)",
 "wideband": "عريض النطاق (يستجيب لـ أو يعمل في نطاق واسع من الترددات)\nمثال: هوائي عريض النطاق",
 "widebody aircraft": "طائرة بممرين, طائرة عريضة البدن (طائرة ركاب تجارية بممرين)",
 "widegrip pushup": "ضغط واسع القبضة (تمرين ضغط تكون فيه الذراعين متباعدتين بشكل واسع)",
 "widely": "بعيداً, على نطاق واسع (إلى أو على مدى أو نطاق كبير؛ بعيداً) / بتباعد (بحيث تترك مساحة كبيرة أو مسافة بين الأشياء)\nمثال: تجول بعيداً عبر العديد من الأراضي",
 "widely distributed": "عالمي الانتشار, كوزموبوليتاني (ينمو أو يحدث في أجزاء كثيرة من العالم)\nمثال: عشبة عالمية الانتشار",
 "wideness": "شساعة, ضخامة (كبر غير عادي في الحجم أو المدى أو العدد) / اتساع, سعة (خاصية كون الشيء واسعاً؛ امتلاك عرض كبير)",
 "widening": "توسيع (عملية جعل الشيء أوسع) / توسعة جانبية, مفسح (جزء من الطريق تم توسيعه للسماح للسيارات بالمرور أو التوقف) / تعريض, توسيع (زيادة في العرض)",
 "widescale": "وسيع النطاق",
 "widespread": "مُتَرَامِي الأَطْرَافِ, وَاسِعُ الِانْتِشَارِ (مُوَزَّعٌ عَلَى مَدًى جُغْرَافِيٍّ وَاسِعٍ) / وَاسِع الانْتِشَار (متداول أو منتشر على نطاق واسع)",
 "widgeon": "بط صواي, صواي (بط مياه عذبة من أوراسيا وشمال أفريقيا قريب من البركة والحذف)",
 "widget": "آلة مبتكرة, أداة (جهاز أو أداة تحكم مفيدة جداً لأداء عمل معين) / أداة, أداة مبهمة الاسم (شيء غير محدد تم نسيان اسمه أو غير معروف)\nمثال: أعادت الأداة كروية الشكل إلى مكانها",
 "widow": "أَرْمَلَة",
 "widow bird": "طائر الأرملة, ويداه (طائر نساج أفريقي أسود في الغالب)",
 "widow woman": "أرملة (امرأة توفي زوجها خاصة تلك التي لم تتزوج مرة أخرى)",
 "widow's peak": "قمة الأرملة, ناصية مثلثية",
 "widow's walk": "ممشى الأرملة (نقطة مراقبة تعلو منزلاً ساحلياً)",
 "widow's weeds": "ثياب الحداد (رداء أسود (فستان) ترتديه الأرملة كعلامة على الحداد)",
 "widowed": "أَرْمَل, مُتَرَمِّل (أعزب بسبب وفاة الزوج)",
 "widower": "أَرْمَل ((أَرْمَلَ) المكان: صار ذا رمل؛ (أَرْمَلَ) فلان: نفد زاده وافتقر)\nمثال: هي أصبحت أرملة.",
 "widowhood": "ترمل (حالة كون المرأة أرملة لم تتزوج مرة أخرى) / ترمل (فترة حياة المرأة عندما تكون أرملة)",
 "widowman": "أرمل (رجل توفيت زوجته خاصة ذلك الذي لم يتزوج مرة أخرى)",
 "width": "عَرْض (أتى العروض، أي مكّة والمدينة وما حولهما؛ الفَرَسَ: سار به بالعُرض)\nمثال: قبل كلاي العرض.",
 "wield": "مَارَسَ (ومَرِسَ؛ إله الحرب في الأساطير الرُومِيَّة، وهو المَرِيِّخ، لا يؤنث ولا يجمع)\nمثال: مارس الأمازيغية.",
 "wieldy": "سهل الاستخدام, طَيع (سهل التعامل معه أو استخدامه أو إدارته)\nمثال: كتاب كبير ولكنه سهل التعامل معه",
 "wiener": "نقانق, هوت دوغ (سجق ناعم القوام من لحم البقر أو الخنزير المفروم وعادة ما يكون مدخناً؛ يقدم غالباً في خبز)",
 "wiener roast": "شواء النقانق (طهي في الهواء الطلق حيث تكون النقانق المشوية هي الطبق الرئيسي)",
 "wiener schnitzel": "شنيتزل, شنيتزل فيينا (شرائح عجل مغطاة بالبقسماط ومقلية بعمق)",
 "wienerwurst": "نقانق, هوت دوغ (سجق ناعم القوام من لحم البقر أو الخنزير المفروم وعادة ما يكون مدخناً؛ يقدم غالباً في خبز)",
 "wiesenboden": "فيزن بودن (تربة مروج داكنة غنية بالمواد العضوية؛ تطورت من خلال سوء الصرف في المناطق العشبية الرطبة)",
 "wife": "زَوْجَة, اِمْرَأَة",
 "wifelike": "زوجي (يليق بالزوجة أو من سماتها)",
 "wifely": "زوجي (يليق بالزوجة أو من سماتها)",
 "wiffle": "كرة ويفل ((علامة تجارية) كرة بلاستيكية مجوفة ذات فتحات)",
 "wiffle ball": "كرة ويفل ((علامة تجارية) كرة بلاستيكية مجوفة ذات فتحات)",
 "wifi": "شبكة محلية لاسلكية, واي فاي (شبكة محلية تستخدم إشارات راديو عالية التردد لإرسال واستقبال البيانات عبر مسافات تصل إلى بضع مئات من الأقدام؛ تستخدم بروتوكول إيثرنت)",
 "wig": "شَعْر مُسْتَعَار, بَارُوكَة (العِلْم؛ في : هو كلام مُقَفَّى ومُوَازَن على أوزان معروفة يُقصد به إظهار الكلام بصيغة فنية)\nمثال: شعر ماريا طويل.",
 "wig tree": "سماق البندقية, شجرة الدخان (شجيرة من العالم القديم ذات أعمدة كبيرة من الزهور الريشية الصفراء تشبه نفثات الدخان)",
 "wigeon": "بط صواي, صواي (بط مياه عذبة من أوراسيا وشمال أفريقيا قريب من البركة والحذف)",
 "wigged": "مرتدٍ شعراً مستعاراً (يرتدي شعرًا مستعارًا)\nمثال: القضاة جميعهم يرتدون شعرًا مستعارًا وأروابًا",
 "wigging": "تَوْبِيخ (توبيخ (مصطلح عامي بريطاني))",
 "wiggle": "تلوّي, تململ (عملية التلوّي أو التململ)",
 "wiggle nail": "مثبت مموج (شريط صغير من الفولاذ المموج ذو نقاط حادة على جانب واحد؛ يُطرق عبر وصلات الخشب في النجارة الخشنة)",
 "wiggle room": "مساحة للحركة, هامش مناورة (مرونة في التفسير أو الخيارات)\nمثال: ترك الطلب بعض هامش المناورة لإعادة الهيكلة المستقبلية",
 "wiggler": "دودة الأرض (دودة برية تحفر في التربة وتساعد في تهويتها؛ تظهر غالباً عندما تكون الأرض باردة أو رطبة؛ تستخدم كطعم من قبل الصيادين) / يرقة البعوض (يرقة البعوض) / كَثِير الْحَرَكَة, مُتَمَلْمِل (شخص لا يستطيع البقاء ساكناً (خاصة الطفل))\nمثال: كان الطفل الصغير كثير الحركة حقاً في رحلات الطائرة",
 "wiggliness": "تَذَبْذُب, حَرَكَة مُتَلَوِّيَة (نوع متقطع من الحركة ذهاباً وإياباً)\nمثال: مشى بتمايل طفل يرتدي كعباً عالياً",
 "wiggly": "مُتَعَرِّج, مُتَلَوٍّ (يتحرك بطريقة ملتوية كحركة الأفعى أو الدودة) / مُتَعَرِّج, مُتَمَوِّج (ينحني ويتعرج إلى الداخل والخارج)",
 "wight": "كائن, مخلوق / شبح, طيف خبيث (روح حاقدة أو مسكونة)",
 "wigless": "غير مرتدٍ شعراً مستعاراً (لا يرتدي شعرًا مستعارًا)",
 "wigmaker": "صانع شعر مستعار (شخص يصنع ويبيع الشعر المستعار)",
 "wigwam": "كوخ ويغوام (كوخ للهنود الحمر غالباً ما يكون بيضاوي الشكل ومغطى باللحاء أو الجلود)",
 "wii": "وي",
 "wiimote": "وي موت",
 "wiki": "وِيكِي",
 "wikipedia": "وِيكِيبِيدِيَا (موسوعة ويكي مجانية المحتوى ومتعددة اللغات على الإنترنت تديرها مؤسسة ويكيميديا؛ (مَجَازِيًّا) المجتمع الذي يطور ويكيبيديا)\nمثال: استعمل ويكيبيديا.",
 "wikipedian": "وِيكِيبِيدِيّ, وِيكِيبِيدِيَّة",
 "wikiup": "كوخ ويكي أب (كوخ يتكون من إطار مغطى بالحصير أو الشجيرات؛ استخدمه الهنود الرحل في جنوب غرب الولايات المتحدة)",
 "wiktionarian": "وِيكَامُوسِيّ",
 "wiktionary": "وِيكَامُوس (اسم مشروع للقَامُوس الحُرّ)\nمثال: مرحبا بك في ويكاموس.",
 "wild": "مُتَوَحِّش / بَرِّيّ",
 "wild angelica": "أنجليكا برية, حشيشة الملاك البرية (عشب أوروبي بأوراق مركبة وزهور بيضاء؛ دخيل على جزيرة كيب بريتون)",
 "wild animal": "حَيَوَان بَرِّيّ, حَيَوَان وَحْشِيّ (بمعنى أصبح له حياة؛ الحَيَاة. والحَيَوَان أبلغ من الحَيَاة؛ جنس الحَيّ الذي يأكل وينمو ويتحرك بالإرادة وبه حِسّ بخلاف ما به حياة فقط دون الحس مثل النَبَات. بعض العامة تقول حَيْوَان وهو غلط)\nمثال: هذا حيوان أليف.",
 "wild apple": "تفاح بري (أي من أشجار التفاح البري العديدة عادة بفاكهة حمضية صغيرة)",
 "wild ass": "عَيْر, فَرَأ (قافلة الحمير؛ كل قافلة من قوافل الإبل والبغالِ والحميرِ تحمل الطعام)\nمثال: من عير أخاه بذنب لم يمت حتى يعمله.",
 "wild basil": "ريحان بري, كلينوبوديوم (عشب عطري له رؤوس من الزهور الصغيرة الوردية أو البيضاء؛ موزع على نطاق واسع في الولايات المتحدة وأوروبا وآسيا)",
 "wild bean": "فول سوداني (درنة تشبه الجوز؛ طعام مهم للأمريكيين الأصليين) / أبيوس, بطاطس هندية (كرمة من أمريكا الشمالية ذات أزهار عطرة ودرنات صالحة للأكل؛ محصول غذائي مهم للأمريكيين الأصليين)",
 "wild bergamot": "برغموت بري, موناردا",
 "wild blue yonder": "زرقة السماء, سماء زرقاء (السماء كما تُرى في وضح النهار)\nمثال: أطلق سهماً في كبد السماء",
 "wild boar": "خَنْزِير بَرِيّ",
 "wild buckwheat": "حنطة سوداء برية, حنطة سوداء كاليفورنيا (شجيرة منخفضة النمو ذات فروع منتشرة وزهور في رؤوس فضفاضة؛ المناطق الصحراوية في غرب الولايات المتحدة (كاليفورنيا إلى يوتا))",
 "wild cabbage": "كرنب بري, ملفوف بري (الأصل البري للملفوف المزروع؛ شائع في غرب أوروبا الساحلية)",
 "wild calla": "كالا برية, لوف الماء (نبات الأراضي الرطبة والمستنقعات في المناطق المعتدلة ذو أزهار خضراء صغيرة محاطة جزئياً بقنابة بيضاء وتوت أحمر)",
 "wild card": "ورقة جوكر, ورقة حرة (ورقة لعب يمكن تحديد قيمتها من قبل الشخص الذي يحملها) / عامل لا يمكن التنبؤ به, ورقة رابحة (عامل لا يمكن التنبؤ به)\nمثال: كان الطقس عاملاً لا يمكن التنبؤ به",
 "wild carrot": "جزر بري, دانتيل الملكة آن (عشب أوراسي مستوطن على نطاق واسع بأوراق مقطعة بدقة وخيمات مركبة بيضاء من الزهور الصغيرة البيضاء أو الصفراء وجذور صفراء رفيعة)",
 "wild cavy": "كافياء برية (كافياء من أمريكا الجنوبية؛ ربما تكون سلف خنزير غينيا المستأنس)",
 "wild celery": "عشب الشريط, فاليسنيريا (نبات مائي مغمور بأوراق تشبه الشريط؛ العالم القديم وأستراليا) / كرفس بري (عشب من أوروبا وآسيا المعتدلة)",
 "wild chamomile": "بابونج ألماني, بابونج بري (عشب حولي أوراسي يشبه البابونج في العطر والاستخدامات الطبية وإن كان طعمه أكثر مرارة وتأثيره يعتبر أقل جودة)",
 "wild cherry": "كَرَز حُلْو",
 "wild cherry tree": "كرز بري (شجرة كرز غير مزروعة)",
 "wild chervil": "بقدونس البقر, سرفيل بري (عشب ثنائي الحول خشن قائم من العالم القديم أدخل كعشب ضار في شرق أمريكا الشمالية)",
 "wild china tree": "شجرة الصابون البرية (شجرة متساقطة الأوراق في جنوب غرب الولايات المتحدة ذات ثمار لبية تحتوي على الصابونين)",
 "wild cinnamon": "شجرة الباي, شجرة رم الباي (شجرة من جزر الهند الغربية؛ مصدر لرم الباي) / شجرة القرفة البيضاء, قرفة برية (شجيرة دائمة الخضرة كبيرة أو شجرة صغيرة ذات لحاء عطري أبيض وأوراق جلدية وأزهار أرجوانية إلى حمراء صغيرة في سيمات طرفية)",
 "wild clary": "قصعين رعي الحمام, ميرمية برية (ميرمية أوراسية بزهور زرقاء وأوراق تشبه رعي الحمام؛ تم توطينها في الولايات المتحدة)",
 "wild climbing hempweed": "قنب متسلق, ميكانيا متسلقة (عشب من أمريكا الاستوائية له أزهار برائحة الفانيليا؛ يتسلق الأشجار)",
 "wild coffee": "جذر الحمى, جنطيانا الحصان (عشب أمريكي معمر خشن ضار بأوراق كبيرة عادة ما تكون محيطة بالساق وأزهار أرجوانية أو حمراء باهتة)",
 "wild cotton": "قطن أريزونا البري, قطن بري (شجيرة من جنوب أريزونا والمكسيك)",
 "wild crab": "تفاح بري (تفاح بري موطنه أوروبا؛ سلف رئيسي للتفاح المزروع)",
 "wild cranberry": "عنب الدب, قطلب عنب الدب (شجيرة دائمة الخضرة تشكل حصيرة من أمريكا الشمالية وشمال أوراسيا لها زهور بيضاء صغيرة وتوت أحمر؛ تتحول الأوراق إلى الأحمر في الخريف)",
 "wild crocus": "زهرة الفصح الأمريكية, شقائق النعمان البراري (نبات معمر قصير مشعر ذو أزهار زرقاء بنفسجية أو ليلكية في أوائل الربيع؛ أمريكا الشمالية وسيبيريا)",
 "wild dog": "كلب بري (أي من ثدييات متنوعة غير مستأنسة من فصيلة الكلبيات يُعتقد أنها تشبه الكلاب المستأنسة لتمييزها عن ابن آوى أو الذئاب)",
 "wild duck": "بط بري (بطة غير مستأنسة (خاصة البركة))",
 "wild emmer": "قمح بري (يوجد برياً في فلسطين؛ يعتبر النموذج الأولي للقمح المزروع)",
 "wild fig": "تين بري (كلوزيا من جزر الهند الغربية ذات ثمار تشبه التين) / تين خانق, تين ذهبي (شجرة خانقة موطنها جنوب فلوريدا وجزر الهند الغربية؛ تبدأ كنبات هوائي وتطور في النهاية العديد من الجذور الهوائية السميكة وتغطي مساحات هائلة)",
 "wild flower": "زهرة برية (نبات زهري بري أو غير مزروع)",
 "wild garlic": "ثوم الكرمة, ثوم بري (بصل بري لاذع من العالم القديم) / ثوم الدببة, ثوم بري (نبات عشبي نفاذ من العالم القديم)",
 "wild geranium": "إبرة الراعي البرية, غرنوقي مبقع (إبرة راعي برية شائعة في شرق أمريكا الشمالية بأوراق مشقوقة بعمق وزهور وردية أرجوانية)",
 "wild ginger": "زنجبيل بري (عشب معمر منخفض النمو ذو أوراق زنجبيلية حريفة وجذامير)",
 "wild goat": "وَعْل",
 "wild hollyhock": "ختمية برية (خبازة نادرة توجد فقط في إلينوي تشبه الختمية الشائعة ولها زهور وردية بنفسجية باهتة) / ختمية برية (خبازة برية معمرة ذات زهور أرجوانية من غرب أمريكا الشمالية تزرع أيضاً)",
 "wild hop": "جنجل بري, فاشرا حمراء (فاشرا ذات جذور لحمية وأزهار خضراء باهتة وتوت أحمر صغير جداً؛ توجد في أوروبا وشمال أفريقيا وغرب آسيا)",
 "wild horse": "حصان بري (حصان منزلي غير مروض أو وحشي)",
 "wild hyacinth": "كاماسيا شرقية, ياقوتية برية (كاماسيا شرقية؛ شرق ووسط أمريكا الشمالية) / جريس, ياسنت الخشب (يصنف أحياناً في جنس سيلا)",
 "wild hydrangea": "كوبية شجرية, هيدرانجيا برية (شجيرة متساقطة الأوراق بعناقيد زهور بيضاء كريمية؛ شرق الولايات المتحدة)",
 "wild indigo": "نيلة برية, نيلة كاذبة",
 "wild leek": "ثوم المشرق, كراث بري (نبات معمر خشن من العالم القديم له بصلة كبيرة وساق طويل من زهور مخضرة مشوبة بالأرجواني؛ متوطن على نطاق واسع) / رامب, كراث بري (نبات معمر من أمريكا الشمالية له بصلة رفيعة وزهور بيضاء)",
 "wild licorice": "عرقسوس بري (نبات أوروبي معمر) / عرق سوس أمريكي, عرق سوس بري (نبات من أمريكا الشمالية يشبه العرق سوس الحقيقي وله جذر بخصائص مماثلة) / جويسئة رمحية, عرق السوس البري (جويسئة ذات جذور حلوة المذاق)",
 "wild lily of the valley": "زنبق الوادي البري, ورقة الساق (نبات دائم الخضرة من أمريكا الشمالية بأزهار صغيرة وردية على شكل جرس وأوراق مستطيلة كانت تستخدم سابقاً كلصقات للساق) / زنبق الوادي البري (دائم الخضرة بأوراق مستديرة وأزهار بيضاء كريمية عطرة جداً؛ موزعة على نطاق واسع في الأجزاء الشمالية من العالمين القديم والجديد)",
 "wild liquorice": "عرقسوس بري (نبات أوروبي معمر) / عرق سوس أمريكي, عرق سوس بري (نبات من أمريكا الشمالية يشبه العرق سوس الحقيقي وله جذر بخصائص مماثلة)",
 "wild lupine": "ترمس بري, ترمس معمر (نبات معمر قوي من شرق ووسط أمريكا الشمالية له أوراق كفية وزهور زرقاء عنقودية مبهرجة)",
 "wild madder": "جويسئة بيضاء, فوة برية (عشب أوراسي ذو عناقيد واسعة من الزهور البيضاء الصغيرة؛ تم توطينه في أمريكا الشمالية)",
 "wild man": "رجل بري, رجل متوحش (شخص ذكر غير متكيف اجتماعياً)",
 "wild mandrake": "تفاح مايو, يبروح بري (عشب من أمريكا الشمالية ذو ساق جذري سام وثمرة صالحة للأكل رغم طعمها غير المستساغ)",
 "wild mango": "ديكا, مانجو بري (شجرة أفريقية بفاكهة صفراء صالحة للأكل تشبه المانجو؛ تقدر لبذورها الغنية بالزيت وخشبها الأخضر الصلب المقاوم للنمل الأبيض)",
 "wild mango tree": "ديكا, مانجو بري (شجرة أفريقية بفاكهة صفراء صالحة للأكل تشبه المانجو؛ تقدر لبذورها الغنية بالزيت وخشبها الأخضر الصلب المقاوم للنمل الأبيض)",
 "wild marjoram": "أوريغانو, زعتر بري (نبات معمر عطري أوراسي)",
 "wild meadow lily": "زنبق أصفر بري, زنبق كندا (زنبق شائع في شرق الولايات المتحدة له زهور صفراء أو محمرة متدلية منقطة بالبني)",
 "wild medlar": "زعرور بري, فانجيريا (شجرة نفضية صغيرة من جنوب إفريقيا ذات ثمار صالحة للأكل)",
 "wild medlar tree": "زعرور بري, فانجيريا (شجرة نفضية صغيرة من جنوب إفريقيا ذات ثمار صالحة للأكل)",
 "wild morning-glory": "لبلاب الحقول, مجعد (نبات متسلق معمر أوروبي ضعيف بزهور بيضاء أو وردية؛ تم توطينه في أمريكا الشمالية وهو عشب ضار غازٍ) / لبلاب السياج",
 "wild mustard": "خردل الحقل, خردل بري (نبات أوراسي ضار غالباً ما يكون آفة في حقول الحبوب)",
 "wild oat": "شوفان بري (شائع في المروج والمراعي)",
 "wild oat grass": "شوفان بري (شائع في المروج والمراعي)",
 "wild oats": "أوفولاريا, عشبة الجرس (أي من نباتات مختلفة من جنس أوفولاريا لها زهور جرسية الشكل متدلية مصفرة)",
 "wild olive": "زَنْبُوج",
 "wild onion": "بصل بري (أي من نباتات مختلفة من جنس الثوم ذات بصيلات صالحة للأكل توجد نامية برياً)",
 "wild orange": "غار الكرز, كرز الغار (شجرة مزهرة صغيرة دائمة الخضرة من جنوب الولايات المتحدة) / برتقال بري, برتقال ثلاثي الأوراق (شجرة برتقال صينية نفضية شائكة صغيرة سريعة النمو تحمل زهوراً حلوة الرائحة وثماراً زخرفية ولكن غير صالحة للأكل: تستخدم كأصل في التطعيم وللأسوار الحية)",
 "wild ox": "ثور بري (حُمْرَة الشفق الثائرة فيه؛ الطُحْلُب وما أشبهه فوق الماء. سميّ كذلك لأنه يثور فجأة)\nمثال: حرث ما حرث الثور.",
 "wild pansy": "بانسي بري, زهرة الثالوث البرية (عشبة أوروبية شائعة ومزروعة منذ فترة طويلة تشتق منها معظم زهور البانسي الشائعة في الحدائق)",
 "wild parsley": "بقدونس بري (أي من النباتات الخيمية غير المزروعة المختلفة ذات أوراق تشبه أوراق الجزر أو البقدونس)",
 "wild parsnip": "جزر أبيض بري (عشب ضار ثنائي الحول في أوروبا وأمريكا له أوراق ريشية كبيرة وزهور صفراء وجذر مر وسام نوعاً ما؛ سلف الجزر الأبيض المزروع)",
 "wild pea": "بازلاء برية (أي من النباتات المتنوعة من فصيلة البقوليات التي تنمو عادةً مثل الكروم)",
 "wild peach": "خوخ بري (شجيرة كبيرة كثيرة التفرع تزرع أساساً لأوراقها دائمة الخضرة)",
 "wild peanut": "فول الخنزير, فول سوداني بري (كرمة واسعة الانتشار في شرق أمريكا الشمالية تنتج عناقيد من الزهور الأرجوانية إلى المارونية وقروناً وفيرة (تحت الأرض عادة) صالحة للأكل ذات بذرة واحدة…)",
 "wild pink": "سيلينة كارولينية, قرنفل بري (نبات معمر في شرق ووسط أمريكا الشمالية ذو زهور وردية أو بيضاء قصيرة الساق في عناقيد مشعرة) / أريثوسا, فم التنين (سحلب مستنقعات بزهور وردية أرجوانية عطرية منفردة عادة بتويج واسع الفجوة؛ كندا)",
 "wild pitch": "رمية طائشة (رمية شاردة لا يُتوقع من الماسك التقاطها وتسمح لعداء القاعدة بالتقدم)",
 "wild plum": "برقوق بري (فاكهة البرقوق البري في جنوب الولايات المتحدة) / برقوق بري (شجرة أو شجيرة برقوق غير مزروعة)",
 "wild plum tree": "برقوق بري (شجرة أو شجيرة برقوق غير مزروعة)",
 "wild potato": "بطاطس برية (نبات معمر قائم أو منتشر في جنوب غرب الولايات المتحدة والمكسيك يحمل درنات صغيرة بنية شاحبة إلى قشدية اللون تشبه البطاطس)",
 "wild potato vine": "كرمة البطاطا البرية (نبات معمر عشبي مفترش أو متسلق أمريكي استوائي له جذر نشوي ضخم؛ يعتبر أحياناً مصدراً للبطاطا الحلوة)",
 "wild pumpkin": "قرع البراري, قرع الجاموس (كرمة معمرة في المناطق الجافة بوسط وجنوب غرب الولايات المتحدة والمكسيك ذات ثمار خضراء مرقطة صغيرة صلبة غير صالحة للأكل)",
 "wild quinine": "أقحوان الحمى الأمريكي, كينا برية (عشب معمر قوي من شرق الولايات المتحدة بزهور بيضاء؛ استخدم الهنود أوراقه تقليدياً لعلاج الحروق)",
 "wild radish": "فجل بري, لفت بري (عشب ضار أوراسي له أزهار صفراء أو بنفسجية أو بيضاء وثمار تشبه القرون)",
 "wild rape": "فجل بري, لفت بري (عشب ضار أوراسي له أزهار صفراء أو بنفسجية أو بيضاء وثمار تشبه القرون)",
 "wild raspberry": "توت العليق الأوروبي, توت العليق البري (توت العليق الأوروبي الشائع؛ الفاكهة حمراء أو برتقالية)",
 "wild red oat": "شوفان أحمر بري (شوفان متوسطي يعتبر سلف الشوفان المزروع الحديث)",
 "wild rice": "أرز بري (حبوب عشب مائي من أمريكا الشمالية) / أرز بري (عشبة مائية معمرة في أمريكا الشمالية تحمل حبوباً تستخدم للغذاء)",
 "wild rosemary": "إكليل الجبل البري, شاي المستنقع (شجيرة مستنقعات من شمال ووسط أوروبا وشرق سيبيريا إلى كوريا واليابان)",
 "wild rye": "جاودار بري (أي من عدة أعشاب من جنس إليموس)",
 "wild sage": "قصعين رعي الحمام, ميرمية برية (ميرمية أوراسية بزهور زرقاء وأوراق تشبه رعي الحمام؛ تم توطينها في الولايات المتحدة)",
 "wild sarsaparilla": "أراليا عارية الساق, سارساباريلا كاذبة (عشب معمر شائع له جذور عطرية تستخدم كبديل للسارساباريلا؛ وسط وشرق أمريكا الشمالية)",
 "wild sarsparilla": "أراليا عارية الساق, سارساباريلا كاذبة (عشب معمر شائع له جذور عطرية تستخدم كبديل للسارساباريلا؛ وسط وشرق أمريكا الشمالية)",
 "wild senna": "سنا بري, سنا ماريلاند (عشب معمر في أمريكا الشمالية؛ تستخدم الأوراق طبياً؛ يوضع أحياناً في جنس كاسيا)",
 "wild sensitive plant": "بازلاء الحجل, بازلاء حساسة (نبات أمريكي استوائي له وريقات حساسة نوعاً ما للمس؛ يصنف أحياناً في جنس كاسيا)",
 "wild service tree": "غُبَيْرَاء ممغصة (تصغير غَبْرَاء، وهي الأرض ومؤنث أغْبَر ووأنثى الحجل؛ نبات أو ثمرته)",
 "wild sheep": "خروف بري (خروف غير مستأنس)",
 "wild silkworm": "دودة قز عملاقة (يرقة عثة ساتورنيد؛ تغزل كمية كبيرة من الحرير القوي في بناء شرنقتها)",
 "wild snapdragon": "كتان العلجوم, كتانية شائعة (نبات معمر أوروبي شائع ذو زهور صفراء وبرتقالية مبهرجة؛ عشبة ضارة متوطنة في أمريكا الشمالية)",
 "wild spinach": "رجل الوز, سرمق (أوراق تجمع من البرية) / سبانخ بري (خضراوات ورقية تجمع من البرية وتستخدم كبديل للسبانخ) / رجل الوزة, سبانخ بري (نبات عشبي أوروبي شائع دخيل في أمريكا الشمالية؛ غالباً ما يستخدم كبقلة) / سبانخ بري, هنري الطيب (نبات أوروبي متوطن في أمريكا الشمالية؛ غالباً ما يجمع من البرية كبقلة)",
 "wild spurge": "فربيون بري, فربيون مزهر (فربيون معمر شائع في الولايات المتحدة ذو قنابات بيضاء مبهرجة تشبه البتلات)",
 "wild strawberry": "فراولة الغابات, فراولة برية (موطنها أوروبا)",
 "wild sweet pea": "بازلاء حلوة برية, سذاب الماعز (شجيرة معمرة من شرق أمريكا الشمالية لها أوراق زغبية وزهور مصفرة ووردية؛ ومصدر للروتينون)",
 "wild sweet potato vine": "كرمة البطاطا البرية (نبات معمر عشبي مفترش أو متسلق أمريكي استوائي له جذر نشوي ضخم؛ يعتبر أحياناً مصدراً للبطاطا الحلوة)",
 "wild tamarind": "تمرهندي بري (شجرة من جزر الهند الغربية وفلوريدا والمكسيك؛ تشبه التمرهندي ولها قرون مسطحة طويلة) / تمرهندي مانيلا, كاماشيل (شجرة استوائية أمريكية شائكة شائعة ذات عناقيد طرفية من الزهور الصفراء تليها قرون صالحة للأكل منجلية أو دائرية وتنتج خشباً جيداً وصبغة صفراء وصمغاً…)",
 "wild teasel": "ديبساق حرجي, مشط الراعي البري (مشط راعي أوروبي بزهور بيضاء إلى وردية؛ تم توطينه في الولايات المتحدة)",
 "wild thyme": "زَعْتَر بَرِّيّ, نَمَّام (هو الصَعْتَر ببعض اللهجات العامية؛ شراب يشبه الشَاي يصنع من الصعتر)",
 "wild tobacco": "تبغ بري, تبغ هندي (نبات تبغ من أمريكا الجنوبية والمكسيك)",
 "wild turkey": "دِيك رُومِي (ذكر الدَجَاج؛ ذكر أي طير داجن يشبه الدجاج كالقَبَج وغيره)\nمثال: لديك بعض الكتب.",
 "wild vanilla": "تريليسا, فانيليا برية (نبات معمر في جنوب شرق الولايات المتحدة بأوراق لها رائحة الفانيليا)",
 "wild water lemon": "حب في الضباب, ليمون الماء البري (زهرة العاطفة الاستوائية الأمريكية ذات قنابات مقسمة بدقة؛ السيقان كريهة الرائحة عند سحقها)",
 "wild west show": "عرض الغرب المتوحش (عرض مذهل نظمه ويليام ف. كودي في عام 1883 وتميز بركوب الخيل والرماية على نطاق واسع؛ وتجول في الولايات المتحدة وأوروبا)",
 "wild wheat": "قمح بري (يوجد برياً في فلسطين؛ يعتبر النموذج الأولي للقمح المزروع)",
 "wild winterpea": "بازلاء سنجلتاري, جلبان مشعر (نبات حولي شتوي ضعيف الساق موطنه منطقة البحر الأبيض المتوسط واستقر منذ فترة طويلة في جنوب الولايات المتحدة؛ يزرع كمحصول تغطية ومرعى)",
 "wild woman": "امرأة متوحشة (شخص أنثى غير متكيفة اجتماعياً)",
 "wild yam": "يام بري (نبات له جذمور كان يُجفف سابقاً ويستخدم لعلاج الروماتيزم أو اضطرابات الكبد)",
 "wild yellow lily": "زنبق أصفر بري, زنبق كندا (زنبق شائع في شرق الولايات المتحدة له زهور صفراء أو محمرة متدلية منقطة بالبني)",
 "wild-eyed": "جَاحِظ العَيْنَيْن, مَذْعُور المَظْهَر (يبدو في حالة اضطراب شديدة) / حَالِم, دُونْكِيشُوتِيّ (غير واقعي في الأمور العملية؛ مثالي وبعيد عن الواقع)",
 "wild-goose chase": "سعي عبثي, مطاردة السراب (السعي غير المثمر وراء شيء لا يمكن تحقيقه)",
 "wildcat": "ضَيْوَن",
 "wildcat strike": "إِضْرَاب عَشْوَائِيّ, إِضْرَاب غَيْر مُصَرَّح بِه (إضراب يقوم به العمال دون موافقة مسؤولي نقابتهم)",
 "wildcat well": "بئر استكشافي (بئر نفط استكشافي محفور في أرض غير معروفة بأنها حقل نفط)",
 "wildcatter": "منقب عشوائي, منقب مغامر (رجل نفط يحفر آباراً استكشافية في منطقة غير معروفة بكونها حقلاً نفطياً)",
 "wilde dagga": "داغا, ذيل الأسد (عشب جنوب أفريقي غير سام نسبياً يدخن مثل التبغ)",
 "wildebeest": "ظبي أفريقي, نو (ظبي أفريقي كبير له رأس بقرون تشبه الثور وذيل طويل معقود)",
 "wilderness": "بَرِّيَّة",
 "wildfire": "حَرِيق هَائِل (النَار المشتعلة في شيء كالدَار او الغَابَة)\nمثال: أين هو الحريق إذا؟",
 "wildflower": "زهرة برية (نبات زهري بري أو غير مزروع)",
 "wildfowl": "طيور برية (لحم أي عدد من طيور الصيد البرية الصالحة للأكل)",
 "wilding": "هيجان عنيف (هيجان شنيع يتضمن عادة اعتداءات جنسية من رجال على نساء) / نبات بري (نبات بري غير مزروع (خاصة شجرة التفاح البرية))",
 "wildlife": "اَلْحَيَاة اَلْبَرِّيَّة",
 "wildly": "إلى حد كبير, بشكل جامح (إلى درجة متطرفة أو مبالغ فيها جداً) / بشراسة, بوحشية (مع عاطفة عنيفة وغير مسيطر عليها) / بانفلات, بجنون (بطريقة غير مسيطر عليها)\nمثال: القصة غير واقعية بشكل جامح",
 "wildness": "همجية, وحشية (حالة طبيعية بربرية أو غير مهذبة بشكل مستعصٍ) / رعونة, طيش (ميل جامح لفعل ما يحلو للمرء) / ضراوة, عنف (خاصية كون الشيء جامحاً أو مضطرباً) / تحرر, جموح (شعور بحدة عاطفية مفرطة)\nمثال: كان لدى ليزا دائماً ميل للطيش",
