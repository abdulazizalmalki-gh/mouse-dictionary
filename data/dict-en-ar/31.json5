 "wingback": "وينغ باك ((كرة قدم أمريكية) مركز الظهير الهجومي الذي يصطف خلف أو خارج الطرف) / ظهير جناح خلفي ((في كرة القدم الأمريكية) الشخص الذي يلعب في مركز الجناح الخلفي)",
 "winged": "طَائِر السُّرْعَة, مُجَنَّح (سَرِيع جِدًّا كَأَنَّ لَه أَجْنِحَة) / مجنح (له أجنحة أو كأن له أجنحة من نوع محدد)\nمثال: أقدام ميركوري المجنحة",
 "winged bean": "فاصوليا مجنحة, فول غوا (كرمة حولية درنية ملتفة تحمل عناقيد من الزهور الأرجوانية وقروناً بأربعة أجنحة مسننة؛ المناطق الاستوائية في العالم القديم)",
 "winged elm": "دردار مجنح (دردار من أمريكا الشمالية له غصينات وفروع صغيرة ببروزات فلينية بارزة)",
 "winged everlasting": "أموبيوم, زهرة الخلود المجنحة (نبات أسترالي يزرع على نطاق واسع لزهوره البيضاء الفضية الجميلة ذات المراكز الصفراء الزاهية على سيقان مجنحة طويلة)",
 "winged pea": "بازلاء مجنحة, لوتس (نبات حولي أوروبي مترامي الأطراف له قرن صالح للأكل ذو 4 أجنحة) / فاصوليا مجنحة, فول غوا (كرمة حولية درنية ملتفة تحمل عناقيد من الزهور الأرجوانية وقروناً بأربعة أجنحة مسننة؛ المناطق الاستوائية في العالم القديم)",
 "winged pigweed": "عشبة الخنازير المجنحة, عشبة دحروجة (عشبة حولية كثيفة في وسط أمريكا الشمالية ذات أزهار مخضرة وبذور مجنحة)",
 "winged spindle tree": "مغزلية مجنحة (شجيرة كثيفة متساقطة الأوراق ذات فروع لها أجنحة طولية فلينية عريضة ورقيقة؛ حمراء زاهية في الخريف؛ من شمال شرق آسيا إلى وسط الصين)",
 "winger": "جناح ((في الرياضة) لاعب في مركز الجناح)",
 "wingless": "غير مجنح (يفتقر إلى الأجنحة)",
 "winglike": "شَبِيه بِالْجَنَاح (يشبه الجناح في شكله أو موضعه)",
 "wingman": "رفيق, طيار مساعد (طيار ذكر يضع طائرته خارج وخلف (على جناح) قائد تشكيل الطيران)",
 "wings": "أجنحة (وسيلة للطيران أو الصعود (مجازياً)) / أجنحة (أجنحة طيور منمقة يرتديها الطيارون المؤهلون أو أفراد طاقم الطائرة كشارة)\nمثال: الضرورة تعطي أجنحة للإلهام",
 "wingspan": "باع الجناح (المسافة الخطية بين طرفي سطح انسيابي هوائي)",
 "wingspread": "باع الجناح (المسافة الخطية بين طرفي سطح انسيابي هوائي) / امتداد الجناحين (المسافة بين طرفي الأجنحة (لطائر أو حشرة) عند فردها بالكامل)",
 "wingstem": "فيربيسينا متبادلة الأوراق (عشب معمر بزهور صفراء ملفتة للنظر؛ شرق الولايات المتحدة)",
 "wingwoman": "طيارة جناح (طيارة أنثى تضع طائرتها خارج وخلف (على جناح) قائد تشكيل الطيران)",
 "wink": "غَمَزَ / غَمْزَة",
 "winker": "غطاء العين, غمامة (ساتر يتكون من رقعة جلدية مخيطة بجانب الرسن تمنع الحصان من رؤية ما هو موجود على الجانبين) / غَامِز (شخص يغمز بعينه)",
 "winking": "رفة عين, رمش (منعكس يغلق ويفتح العينين بسرعة) / رَامِش, طَارِف (يُغلق العينين بشكل متقطع وسريع)",
 "winkle": "برونكل (بطني قدم بحري صالح للأكل) / بروينكل, حلزون بحري (حلزون بحري صغير صالح للأكل؛ يطهى بالبخار في النبيذ أو يخبز)",
 "winless": "بِلَا انْتِصَارَات (لم يحقق أي فوز أو انتصار)",
 "winnebago": "لغة وينيباغو (اللغة السيووية التي يتحدث بها شعب وينيباغو) / وينيباغو (فرد من الشعب الناطق باللغة السيوية كان يعيش سابقاً في شرق ويسكونسن جنوب الخليج الأخضر)",
 "winnebago language": "لغة وينيباغو (اللغة السيووية التي يتحدث بها شعب وينيباغو)",
 "winner": "فَائِز, فَائِزَة",
 "winner's circle": "دائرة الفائزين (منطقة صغيرة في مضمار السباق حيث يتم منح الجوائز لأصحاب الخيول الفائزة)",
 "winnie the pooh": "ويني-ذا-بوه, ويني الدبدوب",
 "winning": "انتصار, فوز (النجاح بعد صعوبة كبيرة) / أَخَّاذ, خَلَّاب (بالغ الجاذبيّة؛ يستولي على الاهتمام) / فَائِز, مُنْتَصِر (حقق الفوز أو الانتصار)\nمثال: الفوز ليس كل شيء",
 "winning post": "عمود الفوز (العمود الموجود في نهاية مضمار السباق)",
 "winning streak": "سلسلة انتصارات (فترة متصلة من الانتصارات)",
 "winnings": "أرباح, مكاسب (شيء تم كسبه (خاصة المال))",
 "winnipeg": "وِينِيبِيغ",
 "winnow": "ذَرَّى, نَسَفَ (ذَرَتِ الريحُ التُّرابَ: فَرَّقَتْهُ وَأَطَارَتْهُ؛ ذَرَى القمحَ: نَقَّاهُ فِي الرِّيحِ) / ذَرَّايَة, مِذْرَاة",
 "winnowing": "تذرية, غربلة (فعل فصل الحبوب عن القشر)\nمثال: تمت التذرية بواسطة النساء",
 "winnowing basket": "مِنْسَف, مِنْسَفَة",
 "winnowing fork": "مِذْرًى, مِذْرَاة",
 "winnowing shovel": "مِذْرًى, مِذْرَاة",
 "wino": "سكير, مدمن خمر (شخص يشرب الخمر بشكل مزمن)",
 "winsome": "رَقِيق, سَاحِر (جذاب بطريقة طفولية أو ساذجة)",
 "winsomely": "بِأَسْر, بِجَاذِبِيَّة (بطريقة جذابة وآسرة)\nمثال: لعبت الدور بجاذبية",
 "winsomeness": "جاذبية بريئة, ملاحة (سحر أو جاذبية طفولية)",
 "winsorized mean": "متوسط وينسور, وسط وينسور (مقياس إحصائي للنزعة المركزية، يشبه المتوسط والوسيط، يتضمن حساب المتوسط بعد استبدال أجزاء معينة من التوزيع الاحتمالي عند الأطراف العالية والمنخفضة…)",
 "winter": "شِتَاء, شتا (أحد فُصُول السنة، يبدأ في 21 ديسمبر، وينتهي في 20 مارس، وفيه تنخفض درجات الحَرَارَة)\nمثال: ولد في فصل الشتاء.",
 "winter aconite": "أكونيت شتوي, خانق الذئب الشتوي (عشب معمر صغير من العالم القديم يزرع لزهوره الصفراء الزاهية التي تظهر في أوائل الربيع وغالباً قبل ذوبان الثلج)",
 "winter break": "إجازة منتصف العام, عطلة الشتاء (عطلة مدرسية في الشتاء، يعتمد تاريخها ومدتها على الدولة)\nمثال: العام الصيني الجديد هو أيضاً عطلة مدرسية تسمى عطلة الشتاء",
 "winter cherry": "كرز الشتاء, كرز القدس (شجيرة صغيرة من أمريكا الجنوبية تزرع كنبات منزلي لثمارها الحمراء أو الصفراء الزخرفية الوفيرة ولكن السامة بحجم الكرز) / فانوس صيني, كرز الشتاء (نبات معمر من العالم القديم يزرع لكأسه الورقي البرتقالي المحمر المنفوخ الزخرفي)",
 "winter cress": "رشاد شتوي (رشاد يزرع للسلطات الشتوية) / رشاد الشتاء, عشبة القديسة بربارة (أي نبات من جنس برباريا: نباتات رشاد أوراسية صفراء الزهور؛ تزرع على نطاق واسع كسلطة شتوية)",
 "winter crookneck": "قرع شتوي معقوف الرقبة (أي من نباتات مختلفة تحمل قرعاً بقشور صلبة وأعناق ممدودة منحنية)",
 "winter crookneck squash": "قرع شتوي معقوف (قرع ذو قشرة صلبة وعنق منحني ممدود) / قرع شتوي معقوف الرقبة (أي من نباتات مختلفة تحمل قرعاً بقشور صلبة وأعناق ممدودة منحنية)",
 "winter currant": "ريباس دموي, كشمش شتوي (شجيرة مزهرة تعرف أيضاً باسم الكشمش المزهر أو الكشمش أحمر الأزهار)",
 "winter fern": "سيكران, شوكران (عشب كبير متفرع ثنائي الحول موطنه أوراسيا وأفريقيا ووافد إلى أمريكا الشمالية، له أوراق كبيرة تشبه السرخس وأزهار بيضاء؛ يوجد عادة في البيئات الرطبة؛…)",
 "winter flounder": "سمك موسى الليموني, فلو ندر الشتاء (سمكة طعام أمريكية مهمة في الشتاء) / سمك موسى الليموني, هلبوت شتوي (لحم الهلبوت الأمريكي؛ مهم في الشتاء)",
 "winter flowering cherry": "كرز برعم الورد, كرز مزهر شتوي (شجيرة أو شجرة موطنها اليابان تزرع للزينة لأزهارها الوردية)",
 "winter hardiness": "تحمل البرد, صلابة شتوية (الخاصية المميزة للنباتات التي تنمو خلال فصل الشتاء، أو على الأقل تظل صحية وفي سبات)\nمثال: الكثير جداً أو القليل جداً من الماء خلال الجزء الأخير من موسم النمو يمكن أن يقلل من الصلابة الشتوية لمحاصيل المشاتل",
 "winter hazel": "بندق الشتاء, بندق مزهر (أي من الشجيرات النفضية الآسيوية المتعددة المزروعة لعناقيدها المتدلية من الزهور الصفراء التي تظهر قبل الأوراق)",
 "winter heath": "خلنج ربيعي, خلنج شتوي (شجيرة أوروبية قزمة بزهور حمراء على شكل جرس تزهر مبكراً جداً)",
 "winter heliotrope": "حشيشة السعال العطرة, رقيب الشمس الشتوي (عشب أوروبي ذو أزهار بيضاء وردية برائحة الفانيليا)",
 "winter jasmine": "ياسمين شتوي (شجيرة متسلقة متساقطة الأوراق تُزرع على نطاق واسع لزهورها الصفراء التي تتفتح في الشتاء)",
 "winter melon": "شمام شتوي (ثمرة كرمة الشمام الشتوي؛ شمام أخضر ذو لحم أخضر باهت إلى برتقالي يحفظ جيداً) / بطيخ شتوي, شمام عسلي (أي من أصناف كرمة الشمام ذات ثمار بقشرة بيضاء ملساء ولحم أبيض أو مخضر ليس له رائحة مسكية)",
 "winter melon vine": "بطيخ شتوي, شمام عسلي (أي من أصناف كرمة الشمام ذات ثمار بقشرة بيضاء ملساء ولحم أبيض أو مخضر ليس له رائحة مسكية)",
 "winter mushroom": "فطر الشتاء (غاريقون صالح للأكل يتوفر في أوائل الربيع أو أواخر الخريف عندما يقل الفطر الآخر؛ له قبعة برتقالية إلى بنية ملساء لزجة وساق مخملي يتحول إلى الأسود عند…)",
 "winter olympic games": "الألعاب الأولمبية الشتوية (أولمبياد للرياضات الشتوية)",
 "winter olympics": "الألعاب الأولمبية الشتوية (أولمبياد للرياضات الشتوية)",
 "winter purslane": "خس عامل المنجم, رجلة الشتاء (عشبة عصارية تزرع أحياناً كسلطة أو بقلة؛ تنمو في الكثبان والأراضي البور بساحل المحيط الهادئ لأمريكا الشمالية)",
 "winter rose": "خربق أسود, وردة عيد الميلاد (نبات أوروبي دائم الخضرة ذو أزهار شتوية بيضاء أو أرجوانية تشبه الورد)",
 "winter savory": "ندغ شتوي (أوراق راتنجية تستخدم في اليخنات والحشوات ورغيف اللحم) / ندغ جبلي, ندغ شتوي (شجيرة فرعية معمرة منتصبة لها زهور وردية أو بيضاء وأوراق جلدية بنكهة الزعتر؛ جنوب أوروبا)",
 "winter savoury": "ندغ شتوي (أوراق راتنجية تستخدم في اليخنات والحشوات ورغيف اللحم)",
 "winter solstice": "انقلاب شتوي (22 ديسمبر، عندما تكون الشمس في أقصى نقطة جنوبية لها)",
 "winter squash": "قرع شتوي (أي من ثمار العائلة القرعية المختلفة ذات القشور السميكة واللب الأصفر إلى البرتقالي الصالح للأكل والتي تنضج في الخريف ويمكن تخزينها لعدة أشهر) / قرع شتوي (ضرب بشدة على شيء يَصْدُرُ منه صوت قوي؛ في سياق مجازي: أوقع الضربة أو وقع الصوت المفاجئ أو الحاد)\nمثال: توقف ذلك القرع.",
 "winter squash plant": "قرع شتوي (ضرب بشدة على شيء يَصْدُرُ منه صوت قوي؛ في سياق مجازي: أوقع الضربة أو وقع الصوت المفاجئ أو الحاد)\nمثال: توقف ذلك القرع.",
 "winter sweet": "بهار ياباني, حلوى الشتاء (شجيرة يابانية نفضية تزرع لأزهارها الصفراء العطرة) / حلوى الشتاء, نبات السهم السام (شجرة شجيرية متوسطة الحجم من جنوب أفريقيا ذات أوراق جلدية سميكة دائمة الخضرة وأزهار بيضاء أو وردية وثمار كروية عادة ما تكون سوداء أرجوانية ذات بذرتين) / أوريغانو, زعتر بري (نبات معمر عطري أوراسي) / دكتامني, مردقوش كريتي (شجيرة عطرية قزمة من جزيرة كريت)",
 "winter urn": "جرة الشتاء (نوع من ساركوسوماتاسيا (أورنولا هيماليس))",
 "winter wren": "نمنمة الشتاء (نمنمة صغيرة تعيش في الغابات الصنوبرية في نصف الكرة الشمالي)",
 "winter's bark": "شجرة لحاء الشتاء, لحاء الشتاء (شجرة دائمة الخضرة من أمريكا الجنوبية تنتج لحاء الشتاء وخشبًا طريًا خفيفًا يشبه خشب الزيزفون) / لِحَاءُ وينتر (لحاء عطري له خصائص مقوية ومنشطة)",
 "winter's bark tree": "شجرة لحاء الشتاء, لحاء الشتاء (شجرة دائمة الخضرة من أمريكا الجنوبية تنتج لحاء الشتاء وخشبًا طريًا خفيفًا يشبه خشب الزيزفون)",
 "winter-blooming": "مُزْهِر فِي الشِّتَاء (من النباتات التي تُزهر خلال فصل الشتاء)",
 "winter-flowering": "مُزْهِر فِي الشِّتَاء (من النباتات التي تُزهر خلال فصل الشتاء)",
 "wintera colorata": "شجيرة الفلفل (شجيرة دائمة الخضرة أو شجرة صغيرة أوراقها ملطخة بوضوح باللونين الأحمر والأصفر ولها ثمار سوداء صغيرة)",
 "winterberry": "بهشية نفضية, توت الشتاء (شجيرة نفضية من جنوب شرق ووسط الولايات المتحدة)",
 "wintergreen": "عنب الأرض, وينترغرين (فاكهة حمراء حارة تشبه التوت؛ مصدر لزيت وينترغرين) / توت الشاي, عنب الأرض (شجيرة زاحفة من شرق أمريكا الشمالية لها زهور بيضاء جرسية الشكل تليها ثمار حمراء تشبه التوت حارة وأوراق عطرية لامعة تنتج زيت الوينترغرين) / بيرولا, شاي كندا",
 "wintergreen oil": "زيت وينترغرين (زيت أو نكهة يتم الحصول عليها من نبات الوينترغرين الزاحف)",
 "wintertime": "شتاء (أبرد فصول السنة)",
 "wintery": "شتوي (مميز لـأو يحدث في الشتاء)\nمثال: عانى من طقس شتوي قاسي",
 "wintriness": "بُرُودَة شِتَائِيَّة, شِتَائِيَّة (حالة أو صفة الإيحاء أو الاتصاف بصفات الشتاء؛ بارد، عاصف)",
 "wintry": "شَتَوِيّ",
 "wintun": "لغة وينتون (لغة كوبيهان يتحدث بها شعب وينتون) / وينتون (فرد من شعب هندي في أمريكا الشمالية يعيش في وادي سكرامنتو في كاليفورنيا)",
 "wintun language": "لغة وينتون (لغة كوبيهان يتحدث بها شعب وينتون)",
 "winy": "خَمْرِيُّ المَذَاق (ذُو طَعْمٍ يُشْبِهُ النَّبِيذ)",
 "wipe": "مَسَحَ (مَرَّ عليه بكفه وهو يلامسه؛ مَحَا، مرَّ عليه بكفه حتى يُزيله)\nمثال: مسح توم الطاولة.",
 "wipe off": "مَسَحَ (مَرَّ عليه بكفه وهو يلامسه؛ مَحَا، مرَّ عليه بكفه حتى يُزيله) / مَحَى, عَفَا\nمثال: مسح توم الطاولة.",
 "wipeout": "سقوط رياضي (سقوط في رياضة ما (مثل السقوط من دراجة أو أثناء التزلج أو الانقلاب على لوح التزلج)) / إفناء, تدمير (حدث يدمر شيئاً ما تماماً)",
 "wiper": "مِمْسَحَة, مِمْسَح",
 "wiper arm": "ذراع تلامس, ماسحة (نقطة تلامس تتكون من ذراع موصلة تدور فوق سلسلة من نقاط التلامس الثابتة وتستقر على مخرج)",
 "wiper blade": "مساحة, ممسحة الزجاج الأمامي (جهاز ميكانيكي ينظف الزجاج الأمامي)",
 "wiper motor": "محرك المساحات (محرك كهربائي يحرك مساحات الزجاج الأمامي)",
 "wiping cloth": "خرقة مسح, قماش تنظيف (قطعة قماش تستخدم في البيئة الصناعية لتنظيف الشحوم والزيوت وغيرها)",
 "wire": "سِلْك (السِّلْكُ : الخيطُ الذي ينظَم فيه الخرز ونحوه، أَو الذي يخاط به؛ السِّلْكُ : خيط من معدن تسري فيه الكهرباء)\nمثال: هذا السلك ساخن.",
 "wire cloth": "قماش سلكي, نسيج سلكي (قماش منسوج من الأسلاك المعدنية)",
 "wire cutter": "قاطع الأسلاك, قطاعة (أداة ذات حد تستخدم لقطع الأسلاك)",
 "wire cutters": "قَاطِعُ الْأَسْلَاك",
 "wire gage": "مقياس الأسلاك (مقياس لقياس قطر السلك)",
 "wire gauge": "مقياس الأسلاك (مقياس لقياس قطر السلك)",
 "wire glass": "زجاج سلكي, زجاج مسلح (زجاج يحتوي على طبقة من الشبك السلكي بداخله)",
 "wire grass": "عشب الإوز, نجيل هندي (عشب حولي خشن له سنابل زهور تشبه الأصابع؛ موطنه المناطق الاستوائية في العالم القديم؛ عشبة ضارة متوطنة في أماكن أخرى) / عشبة البراري, عشبة لحية المكنسة (عشبة أمريكية شمالية قوية التحمل جميلة تتحول أوراقها إلى البرونزي الشاحب في الخريف)",
 "wire matrix printer": "طابعة نقطية (طابعة تصادمية يتم فيها تمثيل كل حرف بنمط من النقاط بواسطة أسلاك أو إبر)",
 "wire printer": "طابعة نقطية (طابعة تصادمية يتم فيها تمثيل كل حرف بنمط من النقاط بواسطة أسلاك أو إبر)",
 "wire recorder": "مسجل سلكي (نوع مبكر من المسجلات المغناطيسية يستخدم سلكاً حديدياً)",
 "wire service": "وكالة أنباء (وكالة لجمع التقارير الإخبارية للصحف وتوزيعها إلكترونياً)",
 "wire stripper": "أداة تعرية الأسلاك, قشّارة أسلاك (أداة يدوية يستخدمها الكهربائيون لإزالة العزل من الطرف المقطوع لسلك معزول)",
 "wire wool": "سلك مواعين, صوف صلب (كتلة من ألياف الصلب المنسوجة تستخدم كمادة كاشطة)",
 "wire-guided torpedo": "طوربيد موجه سلكياً (طوربيد يتم توجيهه كهربائياً من السفينة المهاجمة عبر أسلاك رفيعة متصلة بين الطوربيد وآلية التوجيه الخاصة به)",
 "wire-haired": "سِلْكِيّ الشَّعْر ((خاصة للكلاب) ذو شعر صلب يشبه السلك المعدني)",
 "wire-haired fox terrier": "فوكس تيريير خشن الشعر (فوكس تيريير ذو شعر سلكي)",
 "wire-haired pointing griffon": "غريفون (سلالة من الكلاب متوسطة الحجم طويلة الرأس ذات طبقة تحتية زغبية وطبقة خارجية خشنة سلكية؛ نشأت في هولندا ولكن طورت بشكل كبير في فرنسا)",
 "wire-haired terrier": "تيريير خشن الشعر, تيريير سلكي الشعر (تيريير ذو شعر سلكي الملمس)",
 "wire-puller": "صاحب نفوذ خفي, محرك الخيوط (شخص يستخدم نفوذاً سرياً (يحرك الخيوط) لتحقيق غاياته الخاصة)",
 "wired": "مَرْبُوط بِسِلْك (مُقيَّد أو مربوط بسلك معدني) / مُتَحَمِّس, مُتَوَقِّد (مُتَوَتِّرٌ بِالحَمَاسِ وَالإِثَارَةِ كَأَنَّهُ فِي انْدِفَاعِ أَدْرِينَالِين) / سلكي, موصول بأسلاك (مجهز بسلك أو أسلاك خاصة للخدمة الكهربائية أو الهاتفية) / مُرَاقَب إِلِكْتِرُونِيًّا (فيه أجهزة تنصّت إلكترونيّة مخفيّة)\nمثال: منزل مجهز جيدًا بالأسلاك",
 "wirehair": "تيريير خشن الشعر, تيريير سلكي الشعر (تيريير ذو شعر سلكي الملمس)",
 "wirehaired terrier": "تيريير خشن الشعر, تيريير سلكي الشعر (تيريير ذو شعر سلكي الملمس)",
 "wireless": "لَاسِلْكِيّ",
 "wireless fidelity": "شبكة محلية لاسلكية, واي فاي (شبكة محلية تستخدم إشارات راديو عالية التردد لإرسال واستقبال البيانات عبر مسافات تصل إلى بضع مئات من الأقدام؛ تستخدم بروتوكول إيثرنت)",
 "wireless local area network": "شبكة محلية لاسلكية, واي فاي (شبكة محلية تستخدم إشارات راديو عالية التردد لإرسال واستقبال البيانات عبر مسافات تصل إلى بضع مئات من الأقدام؛ تستخدم بروتوكول إيثرنت)",
 "wireless telegraph": "البرق اللاسلكي (استخدام الراديو لإرسال الرسائل البرقية (عادة بشفرة مورس))",
 "wireless telegraphy": "البرق اللاسلكي (استخدام الراديو لإرسال الرسائل البرقية (عادة بشفرة مورس)) / إبراق لاسلكي, راديو تلغراف (الإبراق الذي يستخدم الإرسال عن طريق الراديو بدلاً من الأسلاك)",
 "wireless telephone": "هاتف راديوي, هاتف لاسلكي (هاتف يتصل عبر موجات الراديو بدلاً من الكابلات) / راديو تليفون, هاتف لاسلكي (المهاتفة التي تستخدم الإرسال عن طريق الراديو بدلاً من الأسلاك)",
 "wirelessness": "لاسلكية (حالة أو شرط كون الشيء لاسلكياً؛ عدم وجود أسلاك أو كابلات)\nمثال: هذه الخريطة تذكير بليغ بحقيقة أنه على الرغم من اللاسلكية الظاهرية للاتصالات العالمية، هناك أسلاك مادية في مكان ما",
 "wireman": "كهربائي تمديدات (عامل ذكر يقوم بتركيب وإصلاح الأسلاك الكهربائية)",
 "wirer": "عامل تمديدات (عامل يركب ويصلح الأسلاك الكهربائية) / مرسل برقية (شخص يرسل برقية)",
 "wiretap": "تنصت, تنصت هاتفي (فعل التنصت على خط هاتف أو تلغراف للحصول على المعلومات)",
 "wiretapper": "متنصت, مراقب الهاتف (شخص يتنصت على سلك هاتف أو تلغراف)",
 "wirewoman": "عاملة أسلاك, كهربائية (عاملة أنثى تقوم بتركيب وإصلاح الأسلاك الكهربائية)",
 "wirework": "شبك معدني, شبكة سلكية (شبكة مصنوعة من الأسلاك)",
 "wireworm": "دودة سلكية (يرقة تشبه الدودة لخنفساء النقر؛ تتغذى على جذور العديد من المحاصيل)",
 "wiriness": "عصبية, متانة (خاصية كونه نحيلاً وصلباً وعضلياً (مليء بالعصب))",
 "wiring": "تسليك, تمديد الأسلاك (عمل تركيب الأسلاك لنظام أو جهاز كهربائي) / أسلاك, تمديدات كهربائية (دائرة من الأسلاك لتوزيع الكهرباء)",
 "wiring diagram": "مخطط الأسلاك (رسم تخطيطي لأسلاك نظام كهربائي)",
 "wiry": "خَشِن, سِلْكِيّ (يشبه السلك في صلابته؛ يوصف به الشعر الجاف القاسي) / سِلْكِيّ, عَضَلِيّ نَحِيل (نَحِيل وَعَضَلِيّ البِنْيَة) / سلكي (من أو متعلق بالسلك)",
 "wiry-coated": "سِلْكِيّ الشَّعْر ((خاصة للكلاب) ذو شعر صلب يشبه السلك المعدني)",
 "wiry-stemmed": "سِلْكِيّ السَّاق (ذو ساق رفيعة كالسلك)",
 "wisconsin": "وِيسْكُنْسِن, وِيسْكُونْسِن",
 "wisconsin weeping willow": "صفصاف ويسكونسن الباكي (صفصاف هجين عادة لا يكون شديد التدلي في نموه)",
 "wisconsinite": "ويسكونسني (مواطن أو مقيم في ويسكونسن)",
 "wisdom": "حِكْمَة (مؤنث حَكَم)\nمثال: خذ الحكمة من أي وعاء خرجت.",
 "wisdom book": "أدب الحكمة, كتب الحكمة (أي من الكتب الكتابية (أمثال، جامعة، نشيد الإنشاد، حكمة سليمان، يشوع بن سيراخ) التي تعتبر محتوية على الحكمة)",
 "wisdom literature": "أدب الحكمة, كتب الحكمة (أي من الكتب الكتابية (أمثال، جامعة، نشيد الإنشاد، حكمة سليمان، يشوع بن سيراخ) التي تعتبر محتوية على الحكمة)",
 "wisdom of solomon": "سِفْر الحِكْمَة, سِفْر حِكْمَة سُلَيْمَان (السَّفَرُ : قَطْعُ المسافة؛ هو مِنِّي سفَرٌ : بعيد)\nمثال: صاحبته في السفر.",
 "wisdom tooth": "ضِرْس اَلْعَقْل",
 "wise": "حَكِيم, فَطِن (الذي يتصرف دوما بحكمة وتكون الحكمة من صفاته؛ في : هو الطَبِيب)\nمثال: هذه كلمات حكيمة.",
 "wise guy": "متعجرف, وقح (شخص ذكر مغرور يدلي بتعليقات ساخرة ووقحة)",
 "wise man": "رجل حكيم (مرشد ومستشار ذكر حكيم وموثوق به)",
 "wise woman": "امرأة حكيمة (مرشدة ومستشارة أنثى حكيمة وموثوق بها)",
 "wiseacre": "مُتَعَالِم, مُتَحَذْلِق",
 "wisecrack": "دعابة, نكتة ذكية (ملاحظة بارعة)",
 "wisely": "بحكمة (بطريقة حكيمة)\nمثال: تصرفت بحكمة عندما دعت والديها",
 "wiseness": "حكمة (سمة استخدام المعرفة والخبرة مع الحس السليم والبصيرة) / حِكْمَة, رَجَاحَة (صفة التعقل والحصافة)",
 "wisenheimer": "متحذلق, متعالم (شخص مغرور يدلي بتعليقات ساخرة ووقحة ومعجبة بالنفس)",
 "wisent": "بَيْسُون أُورُوبِّيّ",
 "wish": "أُمْنِيَّة / رَغْبَة / مُنْيَة / تَمَنَّى",
 "wish list": "قائمة أمنيات (قائمة بالأحداث التي تتمنى حدوثها)",
 "wish-wash": "تُرَّهَات, كَلَام تَافِه (حديث أو كتابة لا معنى لها) / شراب خفيف, مشروب مائي (أي شراب مائي خفيف القوام)",
 "wishbone": "عظم التمني, عظم الجؤجؤ (عظم الفريقة لدى الدجاج المنزلي)",
 "wished-for": "مُتَوَقّ إِلَيْه, مُشْتَاق إِلَيْه (مرغوب فيه بشدّة وشوق عظيم)",
 "wishful": "تَوَّاق, طَامِح (يرغب في الاعتراف والتقدم أو يسعى إليهما) / تواق, راغب (لديه أو يعبر عن رغبة في شيء ما)\nمثال: راغب في منصب رفيع",
 "wishful thinker": "حالم, هروبي (شخص يهرب إلى عالم من الخيال)",
 "wishful thinking": "تَفْكِير رَغْبَوِيّ (عملية عقلية يتم من خلالها تحليل الأفكار أو المعلومات للوصول إلى فهم أو قرار؛ إعمال العقل في تأمل أو تخطيط لأمر معين)\nمثال: ابدأ في التفكير.",
 "wishfully": "بأمل, بتمن (بطريقة متمنية)\nمثال: انغمس بتمن في أحلام الشهرة",
 "wishfulness": "تمنٍ (توق غير واقعي)",
 "wishing": "أمنية, رغبة (شعور محدد بالرغبة)\nمثال: حصل على أمنيته",
 "wishing bone": "عظم التمني, عظم الجؤجؤ (عظم الفريقة لدى الدجاج المنزلي)",
 "wishing cap": "قبعة الأمنيات (قبعة سحرية تؤمن كل ما يتمناه المرء)",
 "wishy-washy": "جَبَان, ضَعِيف الشَّخْصِيَّة (يفتقر إلى الشجاعة أو الحيوية)\nمثال: كان دودة صفراء عديمة الشجاعة",
 "wisp": "خُصْلَة, حُزْمَة",
 "wisplike": "ضَئِيل, وَاهِن (نَحِيف وَضَعِيف البِنْيَة)",
 "wispy": "بَاهِت, خَافِت (يَفْتَقِر إِلَى الوُضُوح أَوِ التَّمَيُّز) / ضَئِيل, وَاهِن (نَحِيف وَضَعِيف البِنْيَة)",
 "wistaria": "ستارية, ويستيريا",
 "wisteria": "ستارية, ويستيريا",
 "wisteria chinensis": "ستارية صينية, ويستيريا صينية (نبات له زهور أرجوانية داكنة)",
 "wisteria floribunda": "ستارية يابانية, ويستيريا يابانية (نبات له زهور وردية إلى بنفسجية أو زرقاء بنفسجية)",
 "wisteria frutescens": "ستارية أمريكية, ويستيريا أمريكية (نبات أصلي في شرق الولايات المتحدة يشبه الستارية اليابانية المزروعة وله زهور ليلك أرجوانية شاحبة)",
 "wisteria venusta": "ستارية حريرية, ويستيريا حريرية (ستارية من الصين لها زهور بيضاء)",
 "wistful": "تَأَمُّلِيّ, حَنِين (يُظهر حزناً تأمُّلياً وحنيناً هادئاً)",
 "wistfully": "بحسرة, بشجن (بطريقة حزينة وتواقة)\nمثال: فكر بحسرة أن أخته كانت ستبدو جميلة في ذلك الفستان، مثل ملاك تماماً",
 "wistfulness": "حنين حزين, شجن (شوق حزين ومتأمل)",
 "wit": "وعي, إدراك (الفَهْم والتَدَبُّر واِحْتِوَاء كل معاني الشيء؛ في علم النفس: حالة وعي ويعني أيضا محتوى العقل، ويشمل المشاعر والوعي الذاتي وٱلصور وَالأفكار وَٱلقدرة على إدراك العلاقة بين المرء وٱلبيئة والشعور بما…)\nمثال: إنها فاقدة الوعي.",
 "witbier": "بيرة القمح البلجيكية, فيتبير (بيرة شعير/قمح علوية التخمير تُنتج بشكل رئيسي في بلجيكا وهولندا)",
 "witch": "سَاحِرَة",
 "witch alder": "ألدر الساحرة, فوثرجيلا (أي من الشجيرات النفضية منخفضة النمو المتعددة من جنس فوثرجيلا ذات سنابل تشبه الفرشاة من الزهور البيضاء في الربيع ولون خريفي أحمر وبرتقالي ناري؛ تنمو…)",
 "witch broom": "مكنسة الساحرة (نمو غير طبيعي كثيف (متكتل) للأغصان الصغيرة على شجرة أو شجيرة ناتج عن فطريات أو حشرات أو اضطرابات فسيولوجية أخرى)",
 "witch doctor": "طَبِيب سَاحِر (العالم بالطب)\nمثال: سوف تصبح طبيبة.",
 "witch elm": "دردار جبلي (دردار أوراسي يزرع غالباً كشجرة ظل)",
 "witch grass": "عشبة الكلب, نجيل زاحف (عشبة أوروبية تنتشر بسرعة عن طريق الجذامير الزاحفة؛ متوطنة في أمريكا الشمالية كعشبة ضارة) / عشب الساحرة, عشب الساحرة القديم (عشب من أمريكا الشمالية بنوارات فرشاة نحيلة؛ غالباً ما يكون عشبة ضارة في الأراضي المزروعة)",
 "witch hazel": "بندق الساحرة, ويتش هازل (غسول يتكون من محلول كحولي قابض يحتوي على مستخلص من نبات بندق الساحرة) / بندق الساحرة, مشتركة (أي من الشجيرات أو الأشجار المتعددة من جنس المشتركة؛ ينتج اللحاء غسولاً قابضاً)",
 "witch hazel plant": "بندق الساحرة, مشتركة (أي من الشجيرات أو الأشجار المتعددة من جنس المشتركة؛ ينتج اللحاء غسولاً قابضاً)",
 "witch's brew": "خليط مخيف, وصفة شيطانية (خليط مخيف أو مثير للرهبة)\nمثال: خليط مخيف من رجال العصابات والإرهابيين",
 "witch-hunt": "مُطَارَدَةُ السَّاحِرَاتِ",
 "witch-hunter": "صائد الساحرات, ملاحق فكري (شخص يلاحق الناس ويعاقبهم بسبب آرائهم أو معتقداتهم)",
 "witchcraft": "سِحْر, شَعْوَذَة (ألقى السحر على شخص أو شيء، بمعنى جعله تحت تأثير السحر؛ أدهش أو أبهر بجمال أو جاذبية غير عادية)\nمثال: هذا هو سحر الجزائر.",
 "witchery": "سحر, عمل السحر (فن ممارسة السحر والشعوذة)",
 "witches' brew": "خليط مخيف, وصفة شيطانية (خليط مخيف أو مثير للرهبة)\nمثال: خليط مخيف من رجال العصابات والإرهابيين",
 "witches' broom": "مكنسة الساحرة (نمو غير طبيعي كثيف (متكتل) للأغصان الصغيرة على شجرة أو شجيرة ناتج عن فطريات أو حشرات أو اضطرابات فسيولوجية أخرى)",
 "witches' broth": "خليط مخيف, وصفة شيطانية (خليط مخيف أو مثير للرهبة)\nمثال: خليط مخيف من رجال العصابات والإرهابيين",
 "witches' butter": "زبدة الساحرات (فطر هلامي أصفر)",
 "witches' sabbath": "اجتماع الساحرات, سبت الساحرات (اجتماع ليلي للساحرات لممارسة السحر والشعوذة؛ في العصور الوسطى كان يُعتقد أنه طقوس شيطانية)",
 "witchgrass": "عشبة الكلب, نجيل زاحف (عشبة أوروبية تنتشر بسرعة عن طريق الجذامير الزاحفة؛ متوطنة في أمريكا الشمالية كعشبة ضارة) / عشب الساحرة, عشب الساحرة القديم (عشب من أمريكا الشمالية بنوارات فرشاة نحيلة؛ غالباً ما يكون عشبة ضارة في الأراضي المزروعة)",
 "witching": "سحر, شعوذة (استخدام أو ممارسة السحر)",
 "witching hour": "ساعة السحر (ثُلْث ثُمْن اليَوْم بمعنى مجموع النَهَار واللَيْل، أي جزء من أربعة وعشرين جزءا من مجموع النهار والليل وتتكون من ستين دَقِيقَة؛ الوَقْت الحاضر، الآن)\nمثال: درست لمدة ساعة.",
 "witchlike": "سَاحِرِيّ, شَبِيه بِالسِّحْر (يشبه السحر أو يتسم بطابع الشعوذة)",
 "with": "مَعَ (يفيد الاجتماع والمصاحبة؛ مكان الاجتماع) / بِـ (الإلصاق: أمسكت بالشيء؛ الاستعانة: كتبت بالقلم)\nمثال: جئت مع أصدقائي.",
 "with difficulty": "بصعوبة",
 "with kid gloves": "بِحَذَر, بِعِنَايَة (كما لو كان بقفازات ناعمة؛ بحذر أو حكمة أو لباقة)\nمثال: نزلت الدرج بحذر",
 "with pleasure": "بِرَغْبَة, بِمَتْعَة",
 "with regard to": "فِيمَا يَتَعَلَّقُ بِـ, بِالنِّسَبَة لِـ",
 "with-it": "ابْن شَوَارِع, مُتَمَرِّس (يملك الحيلة والدهاء اللازمَيْن للنجاة في البيئة الحضريّة) / مُتَطَوِّر, مُوَاكِب لِلعَصْر (مُتَوَافِق مَعَ أَحْدَث الأَفْكَار أَوِ الأَنْمَاط العَصْرِيَّة)",
 "withal": "رغم ذلك, لكن (على الرغم من أي شيء مخالف (تسبق عادة التنازل)) / بالإضافة لذلك, مع ذلك (جنباً إلى جنب مع هذا)\nمثال: على الرغم من أنني خائف قليلاً، إلا أنني أود تجربتها مع ذلك",
 "withdraw": "سَحَبَ (سحب أو جذب شيئًا باتجاهه أو بعيدًا عنه؛ أزال أو سحب شيء من مكانه) / تَرَاجَعَ\nمثال: سحب ياني تصريحه.",
 "withdrawal": "اِنْسِحَاب",
 "withdrawal method": "الجماع المقطوع, العزل (طريقة لتحديد النسل يتم فيها بدء الجماع ولكن يتم سحب القضيب عمداً قبل القذف)",
 "withdrawal symptom": "عَرَض الانسحاب (أي اضطراب جسدي أو نفسي (مثل التعرق أو الاكتئاب) يعاني منه مدمن المخدرات عند حرمانه من الدواء)",
 "withdrawer": "ساحب (مودع يسحب أموالاً أودعها سابقاً) / طالب منسحب (طالب ينسحب من المؤسسة التعليمية التي كان مسجلاً فيها) / مُنسحب (متسابق ينسحب من المنافسة) / مُنسحب (مدمن مخدرات يقطع استخدام المخدرات)",
 "withdrawing room": "غرفة الاستقبال الرسمية, غرفة الصالون (غرفة رسمية يمكن فيها استقبال الزوار والترفيه عنهم)",
 "withdrawn": "مُنْطَوٍ, مُنْعَزِلٌ (يميل إلى الانطواء والتأمل الداخلي) / مُعْتَزِل, مُنْزَوٍ (منسحب من المجتمع ويطلب العزلة)",
 "withdrawnness": "انعزال, تحفظ (الميل لكون المرء بعيداً وغير متعاطف في أسلوبه)",
 "withe": "رباط غصني, سير (شريط أو حبل مصنوع من أغصان أو سيقان ملتوية) / خوصة, غصن صفصاف (غصن قوي مرن)",
 "wither": "صَعَقَ",
 "withered": "ذَابِل, مُتَجَعِّد (نَحِيل وَمُتَجَعِّد بِسَبَب الانْكِمَاش مِنَ الشَّيْخُوخَة أَوِ المَرَض) / ذَابِل, يَابِس ((يُوصف به النبات خاصّةً) فَقَد كلّ رطوبته وذبل)",
 "withering": "مُبِيد, مُدَمِّر (يَتَسَبَّبُ أَوْ يَقْدِرُ عَلَى التَّدْمِيرِ الكَامِلِ) / سَاحِقٌ, مَاحِقٌ (يستخف بالآخرين ويحقرهم) / ذبول, ضمور (أي ضعف أو تدهور (خاصة بسبب عدم الاستخدام))",
 "witheringly": "بازدراء ساحق, بشكل مفحم (بطريقة مدمرة أو ساخرة بشدة)\nمثال: أطلقت المدافع نيرانها بشكل ساحق على عربات السكك الحديدية",
 "withers": "حارك (أعلى جزء من الظهر عند قاعدة العنق لحيوانات مختلفة خاصة حيوانات الجر)",
 "withhold": "اِحْتَفَظَ / كتم",
 "withholder": "حابس, مانع (شخص يمنع أو يكبح أو يحبس) / مَانِع, مُمْتَنِع (شخص يمتنع عن منح شيء ما)\nمثال: ممتنع عن الدفع",
 "withholding": "استقطاع (عملية الخصم من راتب الموظف) / إمساك, حجب (فعل الامتناع عن إعطاء شيء أو الاحتفاظ به في حوزتك) / حجز ضريبي, ضريبة الاستقطاع (ضريبة دخل تُستقطع من أجور الموظفين وتدفع مباشرة للحكومة من قبل صاحب العمل)\nمثال: استأت من حجبه الإذن",
 "withholding tax": "حجز ضريبي, ضريبة الاستقطاع (ضريبة دخل تُستقطع من أجور الموظفين وتدفع مباشرة للحكومة من قبل صاحب العمل)",
 "within": "دَاخِل / في غضون (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة) / فِي خِلَال (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "without": "بِدُونِ, بِلَا",
 "without a stitch": "بِلَا خَيْط وَاحِد (بدون أي ملابس على الإطلاق)",
 "without doubt": "بلا شك, مما لا شك فيه (باستدراك أو تسليم)\nمثال: مما لا شك فيه، هو ليس أينشتاين",
 "withstand": "قَاوَمَ (ظَلَّ يقوم ضد الشيء، استمر في القيام)\nمثال: قاوم حتى النهاية!",
 "withstander": "مدافع (مقاتل يصمد ضد الهجوم) / صامد, مقاوم (خصم يقاوم بالقوة أو العزم)\nمثال: مقاومون عنيدون للابتكار",
 "withy": "خوصة, غصن صفصاف (غصن قوي مرن)",
 "witless": "فَاقِد الرَّشَاد, مَعْتُوه (يفتقر إلى الإدراك والحكمة والحسّ السليم) / لِأَقْصَى حَدّ ((تُسْتَخْدَمُ مُتَمِّمًا) إِلَى أَقْصَى دَرَجَة (غير رسمي))",
 "witloof": "هندباء بلجيكية, هندباء فرنسية (نبات هندباء عريض الأوراق صغير يحرم من الضوء لتشكيل رأس أبيض ضيق) / إنديف, هندباء (عشب مزروع على نطاق واسع بأوراق ذات قيمة كخضروات للسلطة؛ إما أوراق مسننة مجعدة أو عريضة مسطحة يتم تبييضها عادة)",
 "witness": "شَهَادَة / شَاهِد, شَاهِدَة (اسم فاعلٍ للفعل شَهِدَ؛ هو مَنْ رَأَى وَعَايَنَ وَحَضَرَ ٱلْأَمْرَ) / شَاهِد, شَوَاهِد (اسم فاعلٍ للفعل شَهِدَ؛ هو مَنْ رَأَى وَعَايَنَ وَحَضَرَ ٱلْأَمْرَ) / شَهِدَ (شَهَدَ؛ شُهِدَ)\nمثال: شاهد هذا الفيلم.",
 "witness box": "منصة الشهود (مقصورة للشاهد عند الإدلاء بشهادته)",
 "witness stand": "منصة الشهود (مقصورة للشاهد عند الإدلاء بشهادته)",
 "witnesser": "شاهد, مخبر (شخص يرى حدثًا ويبلغ عما حدث)",
 "wits": "قوى عقلية, مدارك (القوة البشرية الأساسية للتفكير الذكي والإدراك)\nمثال: استخدم ذكاءه للتقدم",
 "wittgensteinian": "فتغنشتايني (على طريقة لودفيج فتغنشتاين)",
 "witticism": "دُعَابَة, ظَرْف (رسالة تمتلك ببراعتها أو مهارتها اللفظية أو تناقضها القدرة على إثارة الضحك)",
 "wittily": "بذكاء, بظرف (بطريقة ذكية وفطنة)\nمثال: كان يتدخل بذكاء وظرف في محادثتنا",
 "wittiness": "دُعَابَة, ظَرْف (رسالة تمتلك ببراعتها أو مهارتها اللفظية أو تناقضها القدرة على إثارة الضحك) / ظرف, فطنة (صفة كون المرء ذكياً ومبدعاً بشكل مسلي)\nمثال: والنتيجة ستكون أنه سيقتل ظرف السطور بالسخرية",
 "witting": "عَنْ عِلْم, مَقْصُود (مدرك أو عارف) / مُتَعَمَّد, وَاعٍ (مُتصوَّر عن قصد ووعي)\nمثال: أداة واعية للشيوعيين",
 "wittingly": "عَنْ دِرَايَة, عَنْ عَمْد (بمعرفة كاملة وتعمّد)\nمثال: حذف المراجع عمداً",
 "wittol": "ديوث (مصطلح قديم للزوج المخدوع الذي يعرف بخيانة زوجته ولكنه يتسامح معها)",
 "witty": "بَلِيغ الدُّعَابَة, حَاضِر البَدِيهَة (يجمع بين الفكرة الذكيّة والتعبير الطريف)",
 "wivern": "وايفرن (تنين ينفث النار يستخدم في شعارات النبالة في العصور الوسطى؛ له رأس تنين وذيل ثعبان وجسم بأجنحة ورجلين)",
 "wiz": "بارع, جهبذ (شخص يتمتع بمهارة مذهلة في أي مجال)",
 "wizard": "سَاحِر, مُشَعْوِذ",
 "wizardly": "سِحْرِيّ, شَعْوَذِيّ (يمتلك أو يستخدم قوى خارقة للطبيعة أو يتسم بها)",
 "wizardry": "سحر, عبقرية (قدرة إبداعية استثنائية)",
 "wizen": "ذَابِل, مُتَجَعِّد (نَحِيل وَمُتَجَعِّد بِسَبَب الانْكِمَاش مِنَ الشَّيْخُوخَة أَوِ المَرَض)",
 "wizened": "ذَابِل, مُتَجَعِّد (نَحِيل وَمُتَجَعِّد بِسَبَب الانْكِمَاش مِنَ الشَّيْخُوخَة أَوِ المَرَض)",
 "wlan": "شبكة محلية لاسلكية, واي فاي (شبكة محلية تستخدم إشارات راديو عالية التردد لإرسال واستقبال البيانات عبر مسافات تصل إلى بضع مئات من الأقدام؛ تستخدم بروتوكول إيثرنت)",
 "wmd": "سلاح دمار شامل (سلاح يقتل أو يصيب المدنيين والعسكريين على حد سواء (الأسلحة النووية والكيميائية والبيولوجية))",
 "wmo": "المنظمة العالمية للأرصاد الجوية (وكالة الأمم المتحدة المعنية بالجمع الدولي لبيانات الأرصاد الجوية)",
 "wnw": "الغَرْب الشَّمَالِيّ الغَرْبِيّ, غَرْب شَمَال غَرْب (نقطة البوصلة في منتصف المسافة بين الغرب والشمال الغربي)",
 "woad": "وَسْمَة, سُدُوس",
 "woadwaxen": "جنيستا الصباغين, وزال الصباغين (شجيرة أوراسية صغيرة لها عناقيد من الزهور الصفراء التي تنتج صبغة؛ شائعة كعشب ضار في بريطانيا والولايات المتحدة؛ تزرع أحياناً للزينة)",
 "wobble": "تذبذب, ترنح (حركة اهتزاز غير ثابتة)",
 "wobbler": "جسم متأرجح, متذبذب (شيء يهتز أو يتأرجح)",
 "wobbling": "مُتَأَرْجِح, مُتَمَوِّج ((للصوت) يتذبذب بشكل غير ثابت)",
 "wobbly": "مُتَرَنِّح, مُهْتَزّ (يميل إلى الاهتزاز والترنّح بسبب ضعف أو خلل) / وابلي (عضو في عمال الصناعة في العالم)",
 "woe": "حَزَن (يقالُ: أَصابَهُ حَزَنٌ شَديدٌ وحُزْنٌ شَديدٌ:(الهَمُّ)؛ حَزِنَ الرّجل : اغْتَمَّ ، حزِنت المرأة:لبست السّواد) / وَيْل\nمثال: شعر توم بالحزن.",
 "woebegone": "بَائِس, مَكْرُوب (يعاني من الحزن والبؤس أو مليء بهما) / مُتَدَاعٍ, مُتَهَالِك (بَالٍ وَمُتَحَطِّمٌ بِسَبَبِ الاسْتِعْمَالِ الشَّدِيدِ)",
 "woeful": "بَائِس, مَكْرُوب (يعاني من الحزن والبؤس أو مليء بهما) / بَائِس, مُزْرٍ (رديء الجودة أو الحالة جدًا)",
 "woefully": "بشكل مؤسف, بشكل محزن (بطريقة مؤسفة أو تدعو للرثاء)\nمثال: كان مهملاً بشكل محزن",
 "woefulness": "شقاء, ويل (كآبة شديدة)",
 "wog": "شخص ملون ((عامية بريطانية مهينة) مصطلح يستخدمه البريطانيون للإشارة إلى الأشخاص الملونين من أفريقيا أو آسيا)",
 "wok": "وُوك",
 "woke": "يَقِظ, نَبِه",
 "wokeism": "ووكية",
 "wold": "أرض مرتفعة مفتوحة (قطعة أرض مفتوحة متموجة (خاصة المرتفعات))",
 "wolf": "ذِئْب (حيوان مفترس من فصيلة الكلاب يعيش في جماعات وأكثر ما يصطاد في الليل؛ صفة تطلق على الرجل الذي يخدع النساء ليحصل على مراده منهن بالدهاء) / ديب / ذيب / اِلْتَهَمَ بِشَرَاهَة\nمثال: نظرة الذئب للشاة.",
 "wolf bean": "ترمس أبيض, ترمس مصري (عشب أوراسي ذو زهور بيضاء يزرع على نطاق واسع للعلف ومكافحة التعرية)",
 "wolf boy": "فتى الذئب (شخص ذكر يُفترض أنه تربى بواسطة الذئاب)",
 "wolf cub": "جرموز, جرو الذئب (ذئب صغير)",
 "wolf fish": "السمكة القطة, سمكة الذئب (أسماك طعام كبيرة مفترسة تعيش في أعماق البحار الشمالية ولها أسنان قوية وبدون زعانف حوضية)",
 "wolf in sheep's clothing": "ذِئْبٌ فِي ثَوْبِ حَمَلٍ (حيوان مفترس من فصيلة الكلاب يعيش في جماعات وأكثر ما يصطاد في الليل؛ صفة تطلق على الرجل الذي يخدع النساء ليحصل على مراده منهن بالدهاء)\nمثال: نظرة الذئب للشاة.",
 "wolf pack": "قطيع ذئاب (مجموعة من الذئاب تصطاد معًا) / زمرة ذئاب (مجموعة من الغواصات تعمل معاً في مهاجمة قوافل العدو)",
 "wolf pup": "جرموز, جرو الذئب (ذئب صغير)",
 "wolf spider": "عَنْكَبُوت ذِئْبِيّ",
 "wolf's bane": "خانق الذئب (عشب معمر أوراسي سام ذو أوراق مستديرة عريضة وأزهار صفراء وساق جذري ليفي)",
 "wolf's milk": "حليب الذئب, فربيون ورقي (نبات معمر أوروبي طويل متوطن ومزعج كعشبة ضارة في شرق أمريكا الشمالية)",
 "wolf-sized": "بِحَجْمِ الذِّئْبِ (بحجم ذئب تقريبًا)",
 "wolfbane": "خانق الذئب (عشب معمر أوراسي سام ذو أوراق مستديرة عريضة وأزهار صفراء وساق جذري ليفي)",
 "wolfberry": "عَوْسَج / لُسَاس",
 "wolffia columbiana": "ولفيا كولومبية (أصغر النباتات المزهرة المعروفة؛ من الأمريكتين)",
 "wolffiella gladiata": "قزم الطين (له سعف مغمورة ضيقة مسطحة منجلية الشكل؛ أمريكا الشمالية)",
 "wolffish": "سمكة الذئب, سمكة المبضع (أسماك محيطية كبيرة ممدودة عديمة القشور ذات أسنان حادة وزعنفة ظهرية طويلة تشبه الشراع) / السمكة القطة, سمكة الذئب (أسماك طعام كبيرة مفترسة تعيش في أعماق البحار الشمالية ولها أسنان قوية وبدون زعانف حوضية)",
 "wolfgang": "فولفغانغ",
 "wolfhound": "كلب صيد الذئاب (أكبر سلالات الكلاب؛ كان يستخدم سابقاً لصيد الذئاب)",
 "wolfish": "جَشِع, شَرِه (يلتهم الطعام أو يشتهيه بكمّيّات كبيرة) / ذئبي, شبيه بالذئب (يشبه الذئب أو من خصائصه (أو يعتبر كذلك))\nمثال: ركضوا في مجموعات تشبه الذئاب",
 "wolfishly": "بشراسة, كالذئب (بطريقة تشبه الذئب)",
 "wolflike": "ذئبي, شبيه بالذئب (يشبه الذئب أو من خصائصه (أو يعتبر كذلك))\nمثال: ركضوا في مجموعات تشبه الذئاب",
 "wolfman": "الرجل الذئب, مستذئب (وحش قادر على تغيير مظهره من إنسان إلى ذئب والعكس)",
 "wolfram": "تنجستن, ولفرام (عنصر فلزي ثقيل رمادي-أبيض؛ يستخدم الشكل النقي منه بشكل أساسي في التطبيقات الكهربائية)",
 "wolfram steel": "فولاذ تنجستن (فولاذ صلب جداً ومقاوم للحرارة يحتوي على التنجستن)",
 "wolframite": "ولفراميت (معدن يتكون من تنغستات الحديد والمنغنيز في شكل بلوري؛ الخام الرئيسي للتنجستن؛ يوجد في عروق الكوارتز المصاحبة لصخور الجرانيت)",
 "wolfsbane": "خانق الذئب (عشب معمر أوراسي سام ذو أوراق مستديرة عريضة وأزهار صفراء وساق جذري ليفي)",
 "wollaston prism": "موشور روشون, موشور ولاستون (جهاز بصري ينتج ضوءاً فوق بنفسجي مستقطباً مستوياً)",
 "wollastonite": "ولاستونيت (معدن أبيض أو رمادي يوجد عادة في الحجر الجيري المتحول؛ سيليكات الكالسيوم)",
 "wollemi pine": "صنوبر وليمي (صنوبر مكتشف حديثاً (1994) كان يعتقد أنه انقرض منذ فترة طويلة؛ أستراليا؛ لم يتم تعيين أسماء الجنس والنوع بعد)",
 "wollongong": "ولونغونغ",
 "wolof": "ولوف (اللغة الغرب أفريقية للولوف في السنغال؛ مرتبطة بالفولانية)",
 "wolof language": "ولوف (اللغة الغرب أفريقية للولوف في السنغال؛ مرتبطة بالفولانية)",
 "wolstonian glaciation": "تجلد ولستوني (التجلد قبل الأخير في العصر البليستوسيني في بريطانيا والرواسب التي تكونت في ذلك الوقت)",
 "wolverhampton": "ولفرهامبتن",
 "wolverine": "شَرِه, وُلْفِيرِين ((شَرِهَ) إلى الطعام وغيره، وشَرِهَ عليه يَشْرَهَ شَرَهًا: اشتد حرصُه عليه واشتِهاؤه له؛ فهو شَرِهٌ وشَرْهَانُ، وهي شَرِهة وشَرْهَى)\nمثال: كانت صوفيا شرهة.",
 "woman": "اِمْرَأَة (أُنْثَى الْإِنْسَانِ الْبَالِغَةُ؛ زَوْجَةٌ)\nمثال: أنا امرأة قوية.",
 "woman chaser": "زير نساء, ملاحق النساء (رجل عدواني في التودد للنساء وملاحقتهن)",
 "woman hater": "كاره للنساء, مبغض للمرأة (مبغض للبشر يكره النساء بشكل خاص)",
 "woman of the cloth": "امرأة دين (عضو أنثى في سلك الكهنوت وقائدة روحية للكنيسة المسيحية)",
 "woman of the house": "ربة منزل (زوجة تدير منزلاً بينما يكسب زوجها دخل الأسرة)",
 "woman of the street": "بائعة هوى, عاهرة (امرأة تمارس الجماع الجنسي مقابل المال)",
 "woman's body": "جَسَدُ المَرْأَة (جسد امرأة بالغة)",
 "woman's doctor": "أخصائي أمراض نساء, طبيب نساء (أخصائي في طب النساء)",
 "woman's hat": "قبعات نسائية (القبعات المخصصة للنساء؛ البضائع التي يبيعها صانع القبعات النسائية)",
 "woman-worship": "تقديس النساء, عبادة المرأة (عبادة النساء)",
 "womanhood": "أنوثة (حالة كون الشخص امرأة) / الجنس اللطيف, النساء (النساء كطبقة) / أنوثة (حالة كونها امرأة بالغة)\nمثال: إنها إهانة للنساء الأمريكيات",
 "womaniser": "زير نساء (رجل يحب العديد من النساء ويقيم علاقات جنسية قصيرة معهن)",
 "womanish": "نِسَائِيّ (يمتلك خصائص مرتبطة بالنساء وتُعتبر غير مرغوبة في الرجال)",
 "womanishness": "تخنث, ميوعة (سمة التخنث (استخدام ازدرائي للرجل))\nمثال: ربط الطلاب العلم بالرجولة والفنون بالتخنث",
 "womanizer": "زِير نِسَاء, مُتَأَنِّق ((زَيَّرَ) الدابة: شدها بالزيار)\nمثال: وزير الصحة زار تيزي وزو، لكن لم يأت بمشروع جديد.",
 "womankind": "النساء, معشر النساء (النساء بتمييزهن عن الرجال)",
 "womanlike": "شَبِيهٌ بِالمَرْأَة (يشبه المرأة) / أنوثة ناضجة, نسوية (سمة كون المرأة أنثوية؛ امتلاك خصائص الأنثى البالغة)",
 "womanliness": "أنوثة ناضجة, نسوية (سمة كون المرأة أنثوية؛ امتلاك خصائص الأنثى البالغة)",
 "womanly": "نِسَوِيّ",
 "womb": "رَحِم, بَيْت الْوَلِد (رَحِم: عضو تناسلي أنثوي داخلي مستجيب للهرمون الأنثوي في الجهاز التناسلي لدى البشر ومعظم الثدييات الأخرى؛ الجمع: أرحام) / مَنشَأ, رَحِم\nمثال: رحمة الله عليه.",
 "womb-to-tomb": "مَدَى الحَيَاة, مِنَ المَهْدِ إِلَى اللَّحْد (يَسْتَمِرّ طَوالَ الحَياة)",
 "wombat": "وُمْبَت",
 "women": "سورة النساء",
 "women's army corps": "فيلق الجيش النسائي (فيلق جيش تم تنظيمه في الحرب العالمية الثانية ولكنه لم يعد فرعًا منفصلاً للجيش الأمريكي)",
 "women's clothing": "ملابس نسائية (ملابس مصممة لترتديها النساء)",
 "women's lib": "تحرير المرأة, حركة نسوية (الحركة التي تهدف إلى الحقوق المتساوية للمرأة)",
 "women's liberation movement": "تحرير المرأة, حركة نسوية (الحركة التي تهدف إلى الحقوق المتساوية للمرأة)",
 "women's liberationist": "مُدافِع عَن حُقُوق المَرْأَة, نِسْوِيّ (مؤيد للنسوية وحقوق المرأة)",
 "women's rightist": "مُدافِع عَن حُقُوق المَرْأَة, نِسْوِيّ (مؤيد للنسوية وحقوق المرأة)",
 "won": "رابع, مكسوب (غير خاضع للهزيمة) / وون, وون كوريا الشمالية (وحدة المال الأساسية في كوريا الشمالية) / وون, وون كوريا الجنوبية (وحدة المال الأساسية في كوريا الجنوبية)\nمثال: بهذه الحركة تكون اللعبة رابحة",
 "won ton": "شوربة وون تون (حساء يحتوي على زلابية وون تون) / وان تان (زلابية صينية محشوة بلحم الخنزير المفروم المتبل؛ تقدم عادة في الحساء)",
 "won-lost record": "سجل الفوز والخسارة ((رياضة) سجل للفوز مقابل الخسائر)",
 "wonder": "عَجَب / تَسَاءَلَ (القوم: سَألوأ بعضهم بعضا؛ المرء: سَألَ نفسه مرة بعد مرة)\nمثال: قطة؟ تساءل الرجل العجوز.",
 "wonder bean": "فاصوليا جاك, فاصوليا سيفية (نبات حولي كثيف شبه قائم في أمريكا الجنوبية الاستوائية يحمل قروناً طويلة ببذور بيضاء يزرع خاصة للعلف)",
 "wonder flower": "زهرة العجب (نبات جنوب أفريقي معمر بسنابل طويلة الأمد من الزهور البيضاء يتم شحنها إلى أوروبا وأمريكا لاستخدامها كزهور قطف شتوية)",
 "wonder-struck": "مَبْهُور, مُنْدَهِش (متأثر بالدهشة أو غلبه العَجَب)",
 "wonderberry": "توت العجائب, عنب الذيب البستاني (صنف حديقة محسن من عنب الذيب الأسود يحمل ثماراً برتقالية أو سوداء صغيرة صالحة للأكل)",
 "wonderer": "مَنْبَهِر, مُتَعَجِّب (شخص مليء بالإعجاب والرهبة؛ شخص يتعجب من شيء ما) / متسائل (شخص لديه فضول حول شيء ما)",
 "wonderful": "عَجِيب",
 "wonderfully": "بشكل رائع, بشكل مذهل ((يستخدم للمبالغة) بشكل ممتاز)\nمثال: صوتها منضبط بشكل رائع",
 "wonderfulness": "إِثَارَة الإِعْجَاب, رَوْعَة (الامتياز المثير للإعجاب)",
 "wonderingly": "باستفهام, بتساؤل (بطريقة فضولية واستفهامية)\nمثال: أداروا رؤوسهم بتساؤل، كما لو كانوا ينتظرون المزيد من التعليمات",
 "wonderland": "بلاد العجائب",
 "wonderment": "تعجب, عجب (الشعور الذي يثيره شيء غريب ومفاجئ)",
 "wonderworking": "خَارِق, صَانِع المُعْجِزَات (يؤدي أو قادر على أداء العجائب والمعجزات)",
 "wondrous": "بشكل رائع, بشكل مذهل ((يستخدم للمبالغة) بشكل ممتاز) / رَائِع, عَظِيم (جيد أو عظيم بشكل استثنائي؛ يُستخدم خاصة كمكثف)\nمثال: صوتها منضبط بشكل رائع",
 "wondrously": "بشكل رائع, بشكل مذهل ((يستخدم للمبالغة) بشكل ممتاز)\nمثال: صوتها منضبط بشكل رائع",
 "wonk": "دحيح, مجتهد ممل (طالب غير مهم يتعرض للسخرية لكونه متصنعاً أو مجتهداً بشكل ممل)",
 "wonky": "مُتَرَنِّح, مُهْتَزّ (يميل إلى الاهتزاز والترنّح بسبب ضعف أو خلل) / مَائِل, مُنْحَرِف (ملتوٍ أو مائل نحو جانب واحد)",
 "wont": "ديدن, عادة (عادة راسخة)\nمثال: كانت عادتهم تناول العشاء في الساعة 7 كل مساء",
 "wonton": "وُونْتُون, وَانْتَان",
 "wonton soup": "شوربة وون تون (حساء يحتوي على زلابية وون تون)",
 "woo": "تَوَدَّدَ",
 "wood": "خَشَب, خشب (هو ما غَلَظَ وصَلُبَ من أصول الشَجَر وفروعها مثل الجِذْع والأغْصَان؛ هو ما صنع من جذوع أو أغصان الشَجَر)\nمثال: نحن نقطع الخشب.",
 "wood alcohol": "كحول الخشب, كحول ميثيلي (كحول سائل خفيف متطاير قابل للاشتعال وسام؛ يستخدم كمضاد للتجمد ومذيب ووقود)",
 "wood anemone": "شقائق النعمان الحرجية (شقائق نعمان أوروبية بزهور بيضاء وحيدة شائعة في الغابات النفضية) / شقائق النعمان الحرجية, قطرة الثلج (شقائق نعمان شائعة في شرق أمريكا الشمالية بزهور بيضاء وحيدة مشوبة بالوردي)",
 "wood ant": "نمل الخشب (نمل أوروبي بني محمر يعيش عادة في تلال النمل في الغابات)",
 "wood apple": "تفاح الخشب (شجر فاكهة من الفصيلة الوردية؛ ثمر شجر التفاح)\nمثال: هذه تفاحة أيضا.",
 "wood aster": "أستر الغابة (أي من عدة أنواع من الأستر في شرق أمريكا الشمالية تنمو عادة في الغابات)",
 "wood avens": "أفينس الغابة, عشبة بينيت (نبات أوراسي زغبي بزهور صفراء صغيرة وجذر قابض كان يستخدم طبياً سابقاً)",
 "wood block": "قالب خشبي (نقش يتكون من كتلة من الخشب تم قطع تصميم فيها؛ تستخدم لعمل المطبوعات)",
 "wood carving": "نحت الخشب (شكل من أشكال العمل على الخشب باستخدام أداة قطع)\nمثال: بعض من أرقى الأمثلة الموجودة لنحت الخشب الأوروبي المبكر تعود إلى العصور الوسطى",
 "wood chisel": "إزميل خشب (إزميل للعمل في الخشب؛ يتم طرقه بمطرقة خشبية أو دفعه باليد)",
 "wood coal": "فحم, فحم نباتي (مادة كربونية يتم الحصول عليها عن طريق تسخين الخشب أو المواد العضوية الأخرى بمعزل عن الهواء) / فحم بني, ليغنيت (مرحلة وسيطة بين الخث والفحم البيتوميني)",
 "wood cudweed": "بَرْسِيَّة حَرْجِيَّة",
 "wood drake": "بط الخشب (ذكر بط الخشب)",
 "wood duck": "بطة الخشب (بطة مبهرجة من أمريكا الشمالية تعشش في الأشجار المجوفة)",
 "wood engraving": "قالب خشبي (نقش يتكون من كتلة من الخشب تم قطع تصميم فيها؛ تستخدم لعمل المطبوعات) / كليشيه خشبي, نقش خشبي (مطبوعة مصنوعة من نقش على الخشب)",
 "wood fern": "سرخس الخشب (أي من السراخس المتنوعة من جنس دريوبتريس)",
 "wood file": "مِبْرَد خشب, مِبْرَد خشن (مبرد خشن بنتوءات مدببة حادة)",
 "wood frog": "ضفدع الخشب (ضفدع بني فاتح واسع الانتشار في غابات أمريكا الشمالية الرطبة وخاصة التنوب)",
 "wood garlic": "ثوم الدببة, ثوم بري (نبات عشبي نفاذ من العالم القديم)",
 "wood grain": "تجزع خشبي, عروق الخشب (ملمس ناتج عن الألياف في الخشب)",
 "wood hen": "ويكا (طائر مرعة نيوزيلندي لا يطير ذو طبع لصوصي وله أجنحة قصيرة بكل منها مهز (شوكة) يستخدم في القتال)",
 "wood hoopoe": "هدهد الغابة (طائر أفريقي استوائي له ريش أسود معدني ولكن بدون عرف)",
 "wood horsetail": "ذيل الحصان الحرجي, كنباث حرجي (أوراسيا باستثناء جنوب روسيا؛ شمال أمريكا الشمالية)",
 "wood hyacinth": "جريس, ياسنت الخشب (يصنف أحياناً في جنس سيلا)",
 "wood ibis": "لقلق الخشب (لقلق أمريكي يشبه طيور أبو منجل الحقيقية في امتلاكه منقاراً منحنياً لأسفل؛ يعيش في المستنقعات المشجرة في المناطق الاستوائية للعالم الجديد) / لقلق الخشب الأفريقي (أي من عدة طيور من العالم القديم من جنس أبو منجل)",
 "wood laurel": "غار الجبل, كلمية عريضة الأوراق (شجيرة دائمة الخضرة من أمريكا الشمالية لها أوراق لامعة وزهور بيضاء أو وردية اللون) / غار الخشب, غار الفربيون (شجيرة أوراسية كثيفة بأوراق مستطيلة جلدية لامعة وزهور خضراء مصفرة)",
 "wood lily": "زنبق الخشب (زنبق من شرق أمريكا الشمالية له زهور برتقالية إلى برتقالية حمراء منقطة بالأرجواني) / تريليوم, زنبق الخشب (أي نبات زنبقي من جنس التريليوم له دوامة من ثلاث أوراق في قمة الساق مع زهرة واحدة بثلاث بتلات)",
 "wood louse": "قمل الخشب (أي من متماثلات الأرجل الأرضية الصغيرة المتنوعة ذات جسم مسطح بيضاوي مقسم؛ توجد في البيئات الرطبة)",
 "wood meadowgrass": "قبأ الغابات (عشبة أوروبية نحيلة في الأماكن الظليلة؛ تزرع أيضاً في شمال شرق أمريكا وآسيا المعتدلة)",
 "wood mint": "بليفيلية, نعناع الخشب",
 "wood mouse": "فأر الخشب (أي من فئران الغابات المتنوعة في العالم الجديد)",
 "wood nettle": "قراص الخشب (عشبة أمريكية معمرة توجد في الغابات الغنية ومزودة بشعيرات لاذعة؛ توفر أليافاً تستخدم للمنسوجات)",
 "wood nymph": "حورية الغابة, درياد (إلهة أو حورية الغابات)",
 "wood pewee": "بيوي (صائد ذباب صغير زيتوني اللون يعيش في غابات شرق أمريكا الشمالية)",
 "wood pigeon": "وَرَشَان",
 "wood poppy": "خشخاش الغابة, خشخاش عروق الصباغين (عشبة معمرة موطنها غابات شرق الولايات المتحدة ذات زهور صفراء)",
 "wood pulp": "لب الخشب (خشب تم طحنه إلى لب؛ يُستخدم في صنع منتجات السليلوز (مثل الرايون أو الورق))",
 "wood pussy": "ظربان (ثديي أمريكي من العرسيات يطلق عادة سائلاً كريه الرائحة بشدة عند الفزع؛ في بعض التصنيفات يوضع في فصيلة فرعية منفصلة)",
 "wood rabbit": "أرنب قطني الذيل (أرنب صغير شائع في أمريكا الشمالية ذو فرو رمادي أو بني وذيل بجانب سفلي أبيض؛ مضيف لقراد داء لايم)",
 "wood rat": "جرذ الخشب (أي من القوارض الصغيرة قصيرة الذيل المتنوعة في نصف الكرة الشمالي، تتميز بفراء ناعم رمادي من الأعلى وأبيض من الأسفل مع ذيول مكسوة بالفراء وآذان كبيرة؛…)",
 "wood sage": "جعدة أمريكية, مريمية الخشب (شجيرة بأوراق مسننة وزهور كريمية إلى وردية أو أرجوانية في عناقيد تشبه السنابل؛ أمريكا الشمالية) / مريمية الخشب (جعدة أوروبية بعناقيد أحادية الجانب من الزهور الصفراء؛ متوطنة في أمريكا الشمالية)",
 "wood shavings": "قش خشب, نشارة خشب (نشارة خشب مجعد رقيقة تستخدم للتعبئة أو الحشو)",
 "wood sorrel": "أقصليس, حميض الخشب",
 "wood spirit": "كحول الخشب, كحول ميثيلي (كحول سائل خفيف متطاير قابل للاشتعال وسام؛ يستخدم كمضاد للتجمد ومذيب ووقود)",
 "wood spurge": "فربيون الغابة, فربيون لوزي (عشبة معمرة أوروبية ذات عناقيد زهور طرفية صفراء مخضرة)",
 "wood stork": "لقلق الغياض",
 "wood strawberry": "فراولة الغابات, فراولة برية (موطنها أوروبا)",
 "wood sugar": "زايلوز, سكر الخشب (سكر مستخرج من الخشب أو القش؛ يُستخدم في أطعمة مرضى السكري)",
 "wood swallow": "سنونو الغابة (طائر أسترالي وآسيوي قريب من الصرد ويشبه السنونو)",
 "wood tar": "قطران الخشب (أي قطران يتم الحصول عليه عن طريق التقطير الإتلافي للخشب)",
 "wood thrush": "سمنة الغياض (سمنة كبيرة شائعة في غابات شرق أمريكا؛ تشتهر بتغريدها الشجي)",
 "wood tick": "قراد الخشب, قراد الكلب الأمريكي (قراد شائع يمكن أن ينقل حمى الجبال الصخرية المبقعة وداء التولاريميا)",
 "wood vinegar": "حمض الخليك الخشبي, خل الخشب (سائل بني محمر يتكون عند تقطير الخشب ويحتوي على حمض الخليك والميثانول والأسيتون وزيوت الخشب والقطران)",
 "wood violet": "بنفسج قدم الطائر (بنفسج شائع في شرق الولايات المتحدة بزهور زرقاء شاحبة أو أرجوانية كبيرة تشبه زهور الثالوث) / بنفسج السياج (بنفسج أوروبي شائع ينمو في الغابات والتحوطات)",
 "wood vise": "ملزمة خشب, ملزمة نجارة (ملزمة ذات فكوك مبطنة لتثبيت الخشب دون إحداث خدوش فيه)",
 "wood warbler": "نقشارة الغياض (هازجة غابات أوروبية ذات ريش أصفر باهت) / هازجة العالم الجديد (طائر مغرد أمريكي صغير زاهي الألوان ذو تغريد ضعيف غير موسيقي)",
 "wood widgeon": "بطة الخشب (بطة مبهرجة من أمريكا الشمالية تعشش في الأشجار المجوفة)",
 "wood's alloy": "معدن وود (سبيكة قابلة للانصهار تتكون من نصف بزموت بالإضافة إلى الرصاص والقصدير والكادميوم؛ تنصهر عند حوالي 160 درجة فهرنهايت)",
 "wood's metal": "معدن وود (سبيكة قابلة للانصهار تتكون من نصف بزموت بالإضافة إلى الرصاص والقصدير والكادميوم؛ تنصهر عند حوالي 160 درجة فهرنهايت)",
 "wood-burning": "يَعْمَل بِالحَطَب (يُشغَّل بحرق الخشب)",
 "wood-creeper": "متسلق الأخشاب (أي من الطيور العديدة في أمريكا الجنوبية والوسطى ذات منقار منحني وريش ذيل صلب تتسلق وتتغذى مثل نقار الخشب)",
 "wood-fern": "سرخس الخشب (أي من السراخس المتنوعة من جنس دريوبتريس)",
 "wood-fired": "يَعْمَل بِالحَطَب (يُشغَّل بحرق الخشب)",
 "wood-frog": "ضفدع الخشب (ضفدع بني فاتح واسع الانتشار في غابات أمريكا الشمالية الرطبة وخاصة التنوب)",
 "wood-rat": "جرذ الخشب (أي من القوارض الصغيرة قصيرة الذيل المتنوعة في نصف الكرة الشمالي، تتميز بفراء ناعم رمادي من الأعلى وأبيض من الأسفل مع ذيول مكسوة بالفراء وآذان كبيرة؛…)",
 "woodbine": "خشب العنب, عسلة متسلقة (عسلة أوروبية ملتفة بزهور حمراء وصفراء بيضاء عطرة) / فرجينيا الزاحفة, لبلاب أمريكي (كرمة شائعة في أمريكا الشمالية بأوراق مركبة وثمار تشبه التوت الأسود المزرق)",
 "woodborer": "ثاقبة الخشب, حفار الخشب (أي من الحشرات أو اليرقات أو الرخويات المختلفة التي تحفر في الخشب)",
 "woodcarver": "حفار, نحات الخشب (يصنع ألواحاً خشبية مزخرفة)",
 "woodcarving": "نحت خشبي (نحت تم إنشاؤه بنحت الخشب)",
 "woodchuck": "جرذ الأرض, مرموط خنزيري (مرموط بني محمر من أمريكا الشمالية)",
 "woodcock": "ديك الغابة (طائر صيد من فصيلة الطيطوي يشبه الشنقب)",
 "woodcock snipe": "دجاجة الأرض الأمريكية (دجاجة أرض صغيرة طويلة المنقار؛ تُقدر كطائر صيد) / شنقب كبير (شنقب من العالم القديم أكبر وأغمق من الشنقب الشائع)",
 "woodcraft": "حرفة النجارة, فن العمل بالخشب (المهارة في نحت أو تشكيل الأشياء من الخشب) / مهارات العيش في الغابة (المهارة والخبرة في المسائل المتعلقة بالغابات (مثل الصيد أو صيد الأسماك أو التخييم))",
 "woodcreeper": "متسلق الأخشاب (أي من الطيور العديدة في أمريكا الجنوبية والوسطى ذات منقار منحني وريش ذيل صلب تتسلق وتتغذى مثل نقار الخشب)",
 "woodcut": "قالب خشبي (نقش يتكون من كتلة من الخشب تم قطع تصميم فيها؛ تستخدم لعمل المطبوعات) / كليشيه خشبي, نقش خشبي (مطبوعة مصنوعة من نقش على الخشب)",
 "woodcutter": "حَطَّاب",
 "wooded": "حرجي, مشجر (مغطى بالأشجار النامية والشجيرات وما إلى ذلك)\nمثال: أرض مشجرة",
 "wooden": "خَشَبِيّ",
 "wooden leg": "ساق خشبية (طرف صناعي يحل محل ساق مفقودة)",
 "wooden shoe": "سابو, قبقاب خشبي (حذاء منحوت من كتلة واحدة من الخشب)",
 "wooden spoon": "ملعقة خشبية (ملعقة مصنوعة من الخشب) / ملعقة خشبية (جائزة ترضية تتكون من ملعقة مصنوعة من الخشب)",
 "wooden-headed": "بَلِيد, غَلِيظ الفَهْم ((غير رسمي) غبيّ وبطيء الفهم)",
 "woodenly": "بجمود, بلا كياسة (بدون لطف؛ بصلابة)\nمثال: تحركوا بجمود",
 "woodenness": "تَخَشُّب, جُمُود (صفة كون الشخص جامداً وأخرق كأنه قطعة خشب)\nمثال: انتقد جمود التمثيل",
 "woodenware": "أواني خشبية (أواني للاستخدام المنزلي مصنوعة من الخشب)",
 "woodfern": "سرخس الخشب (أي من السراخس المتنوعة من جنس دريوبتريس)",
 "woodgrain": "تجزع خشبي, عروق الخشب (ملمس ناتج عن الألياف في الخشب)",
 "woodgraining": "تجزيع, تخشب (ملمس يشبه ملمس الخشب)",
 "woodhewer": "متسلق الأخشاب (أي من الطيور العديدة في أمريكا الجنوبية والوسطى ذات منقار منحني وريش ذيل صلب تتسلق وتتغذى مثل نقار الخشب)",
 "woodiness": "تجزع خشبي, عروق الخشب (ملمس ناتج عن الألياف في الخشب) / حراجية, كثافة شجرية (صفة وفرة الأشجار في المكان)",
 "woodland": "أحراج, غابة (أرض مغطاة بالأشجار والشجيرات)",
 "woodland caribou": "كاريبو الغابات",
 "woodland oxeye": "عين الثور الحرجية (نبات أوراسي معمر مشعر ذو أقحوانات صفراء داكنة على سيقان صفصافية متراخية؛ يوجد في البرية في الغابات المفتوحة وعلى المنحدرات الصخرية)",
 "woodland star": "ليثوفراجما, نجمة الغابة (عشبة معمرة في كاليفورنيا تزرع لزهورها البيضاء العنقودية ذات البتلات واسعة الانتشار؛ توضع أحياناً في جنس تيليما)",
 "woodland white violet": "بنفسج أبيض حلو (بنفسج قصير الساق من شرق أمريكا الشمالية له زهور بيضاء عطرة بعروق أرجوانية)",
 "woodlet": "بستان, غابة صغيرة (حديقة تتكون من خشب مزروع صغير بدون شجيرات سفلية)",
 "woodlouse": "قَمْل الخَشَب",
 "woodman": "حطاب, رجل الغابة (رجل يعيش في الغابة) / صانع خشب, نجار (رجل يصنع أشياء من الخشب)",
 "woodpecker": "نَقَّار الخَشَب",
 "woodpile": "كومة حطب (كومة أو كدس من الخشب لاستخدامه كوقود)",
 "woodrat": "جرذ الخشب (أي من القوارض الصغيرة قصيرة الذيل المتنوعة في نصف الكرة الشمالي، تتميز بفراء ناعم رمادي من الأعلى وأبيض من الأسفل مع ذيول مكسوة بالفراء وآذان كبيرة؛…)",
 "woodruff": "جويسئة, خشب الغابة (أي نبات من جنس الجويسئة) / جويسئة عطرة, نبات الخشبة",
 "woods": "حرش, غابة (الأشجار والنباتات الأخرى في منطقة حرجية كثيفة كبيرة)",
 "woodscrew": "برغي خشب (برغي معدني يستدق إلى نقطة بحيث يمكن دفعه في الخشب بمفك براغي)",
 "woodshed": "سقيفة الحطب (سقيفة لتخزين حطب الوقود أو أدوات الحديقة)",
 "woodsia": "وودسيا (أي سرخس من جنس وودسيا)",
 "woodsia alpina": "وودسيا ألبية, وودسيا شمالية (سرخس نحيل في شمال أمريكا الشمالية بسويقات بلون الكستناء اللامع وسعف ثنائي الريش مع بثرات بوغية هامشية مميزة عادة)",
 "woodsia glabella": "وودسيا ملساء (سرخس صخري من القطب الشمالي وشبه القطبي في أوروبا إلى شرق آسيا)",
 "woodsia ilvensis": "وودسيا صدئة, وودسيا عطرية (سرخس صخري شائع في المناطق المعتدلة الشمالية ذو سويقات بنية صدئة وسعف ريشي رمحي)",
 "woodsiness": "حراجية, كثافة شجرية (صفة وفرة الأشجار في المكان)",
 "woodsman": "حطاب, رجل الغابة (رجل يعيش في الغابة) / صانع خشب, نجار (رجل يصنع أشياء من الخشب)",
 "woodswoman": "صانعة خشب, نجارة (امرأة تصنع أشياء من الخشب) / ساكنة الغابة (امرأة تعيش في الغابة)",
 "woodsy": "حَرَجِيّ, كَثِير الأَشْجَار (غنيّ بالأشجار ووافرها) / غَابَوِيّ (يَتَّسِمُ بِسِمَاتِ الغَابَاتِ أَوْ يُوحِي بِهَا)",
 "woodwardia virginica": "سرخس السلسلة الفرجيني (سرخس أمريكي شمالي)",
 "woodwaxen": "جنيستا الصباغين, وزال الصباغين (شجيرة أوراسية صغيرة لها عناقيد من الزهور الصفراء التي تنتج صبغة؛ شائعة كعشب ضار في بريطانيا والولايات المتحدة؛ تزرع أحياناً للزينة)",
 "woodwind": "آلة نفخ خشبية (أي آلة نفخ غير الآلات النحاسية)",
 "woodwind family": "عائلة آلات النفخ الخشبية ((موسيقى) عائلة آلات النفخ الخشبية)",
 "woodwind instrument": "آلَة نَفْخ خَشَبِيَّة (الفارسية: ماشين؛ الأوردية: مشين)\nمثال: نسى زيري الآلة.",
 "woodwork": "أعمال خشبية, نجارة (حرفة النجار: صنع الأشياء من الخشب) / مشغولات خشبية, نجارة (عمل مصنوع من الخشب؛ خاصة القوالب أو السلالم أو الأثاث)",
 "woodworker": "عامل خشب, نجار (شخص يصنع أشياء من الخشب)",
 "woodworking": "أعمال خشبية, نجارة (حرفة النجار: صنع الأشياء من الخشب)",
 "woodworking bench": "طاولة النجارة (طاولة يستخدمها عمال الخشب لتثبيت قطع العمل أثناء العمل عليها بأدوات أخرى)\nمثال: هناك العديد من أنماط طاولات النجارة، يعكس كل منها نوع العمل المراد القيام به أو طريقة عمل الحرفي",
 "woodworking plane": "فارة نجار, مِسْحَج (أداة يدوية للنجار بشفرة قابلة للتعديل لتنعيم أو تشكيل الخشب)\nمثال: استخدم صانع الخزائن المسحج لعمل الإنهاء",
 "woodworking vise": "ملزمة خشب, ملزمة نجارة (ملزمة ذات فكوك مبطنة لتثبيت الخشب دون إحداث خدوش فيه)",
 "woodworm": "دودة الخشب (يرقة حفار الخشب)",
 "woody": "خَشَبِيّ (شَبيه بالخَشَب في الصَّلابَة أو القِوام) / حَرَجِيّ, كَثِير الأَشْجَار (غنيّ بالأشجار ووافرها) / خشبي, ليفي (مصنوع من أو يحتوي على أو يشبه الخشب)\nمثال: نباتات خشبية",
 "woody nightshade": "عنب الديب, مغد حلو ومر (كرمة معمرة سامة من العالم القديم لها زهور بنفسجية وتوت أحمر مرجاني بيضاوي؛ عشب ضار واسع الانتشار في أمريكا الشمالية)",
 "woody pear": "كمثرى أصلية, كمثرى خشبية (شجرة تحمل ثماراً على شكل كمثرى ذات غلاف ثخين خشبي)",
 "woody plant": "نبات خشبي (نبات له أنسجة خشبية صلبة، خاصة السيقان)",
 "woody-stemmed": "خَشَبِيّ السَّاق (ذو ساق خشبيّة)",
 "wooer": "خاطب, طالب الزواج (رجل يتودد لامرأة (بغرض الزواج))",
 "woof": "هَوْ / هَو هَو",
 "woofer": "مجهار ترددات منخفضة, ووفر (مكبر صوت يعيد إنتاج الأصوات ذات الترددات الصوتية المنخفضة)",
 "wooing": "تودد, مغازلة (تودد الرجل للمرأة؛ السعي لكسب عواطف المرأة (عادةً بهدف الزواج))\nمثال: كانت فترة تودد قصيرة ومكثفة",
 "wool": "صُوف",
 "wool fat": "دهن الصوف, لانولين (زيت حيواني لزج أصفر يُستخرج من الصوف؛ خليط من الأحماض الدهنية والاسترات؛ يُستخدم في بعض المراهم ومستحضرات التجميل)",
 "wool grass": "عشبة الصوف, عشبة رافينا (عشبة تزرع غالباً لأوراقها الطويلة المضلعة بالأبيض وأعمدتها الكبيرة التي تشبه تلك الموجودة في عشبة البامباس) / عشب الصوف (سعد من شرق أمريكا الشمالية له العديد من السنيبلات الصوفية المتجمعة)",
 "wool grease": "دهن الصوف, لانولين (زيت حيواني لزج أصفر يُستخرج من الصوف؛ خليط من الأحماض الدهنية والاسترات؛ يُستخدم في بعض المراهم ومستحضرات التجميل)",
 "wool oil": "زيت الصوف (أي زيت يُستخدم لتزييت الصوف قبل الغزل)",
 "wool stapler": "فرّاز الصوف (شخص يفرز الصوف إلى درجات مختلفة) / تاجر صوف (تاجر في الصوف)",
 "woolen": "صُوفِيّ",
 "woolgatherer": "حالم اليقظة, شارد الذهن (شخص ينغمس في أحلام اليقظة الخاملة أو الشرود)",
 "woolgathering": "حَالِم, سَارِح فِي الخَيَال (ذو طبيعة حالمة؛ يستغرق في أحلام اليقظة) / استغراق في الخيال, شرود (الانغماس الخامل في الخيال)",
 "woollen": "صوفي (من أو متعلق أو مصنوع من الصوف) / صوف (قماش مصنوع من شعر الأغنام)\nمثال: سترة صوفية",
 "woolliness": "صوفية الملمس, مظهر صوفي (حالة تشبه الصوف، في الملمس أو الشكل) / صوفية (حالة كون الشيء مصنوعاً من الصوف أو يحمل صوفاً)\nمثال: الشعر إما أملس أو مجعد، لكنه لا يقترب أبداً من صوفية شعر الزنجي",
 "woolly": "صُوفِيّ, قُطْنِيّ الشَّعْر (مغطى بشعيرات كثيفة قطنية تشبه الصوف) / صُوفِيّ, مُجَعَّد (مغطى بشعر كثيف غالباً ما يكون متلبداً أو مجعداً) / مُخْتَلِط, مُشَوَّش الذِّهْن (مرتبك وغامض التفكير؛ يُقال خاصّة عن طريقة التفكير) / صُوفِيّ, نَدِفِيّ (شَبيه بالصُّوف في مَلْمَسِه ونُعومَتِه)",
 "woolly adelgid": "أرقة صوفية (حشرة تتغذى على أشجار الشوكران؛ أكياس بيضها عبارة عن كرات بيضاء زغبية صغيرة تشبه الثلج الاصطناعي على شجرة عيد الميلاد)",
 "woolly alder aphid": "من النغت الصوفي (يهاجم أشجار النغت)",
 "woolly aphid": "من صوفي (يفرز مادة شمعية تشبه كتلة من خيوط القطن الأبيض المجعد الناعم أو الصوف)",
 "woolly apple aphid": "من التفاح الصوفي (يتغذى بشكل رئيسي على اللحاء في الأجزاء الهوائية وجذور التفاح وأشجار أخرى)",
 "woolly bear": "دودة صوفية (يسروع العديد من العث يتميز بمعطف كثيف من الشعر الصوفي؛ يتغذى على النباتات وبعضها آفات مدمرة)",
 "woolly bear caterpillar": "دودة صوفية (يسروع العديد من العث يتميز بمعطف كثيف من الشعر الصوفي؛ يتغذى على النباتات وبعضها آفات مدمرة)",
 "woolly bear moth": "عثة الدودة الصوفية (يرقة عثة من عائلة أركتيدي)",
 "woolly daisy": "أقحوان صوفي, إريوفيلوم والاسي (نبات حولي صغير رمادي صوفي معنقد ذو رؤوس زهرية صفراء ذهبية صغيرة؛ جنوب شرق كاليفورنيا إلى شمال غرب أريزونا وجنوب غرب يوتا؛ يوضع أحياناً في جنس…)",
 "woolly indris": "إندري صوفي (إندري ليلي ذو فرو رمادي بني كثيف وذيل طويل)",
 "woolly mammoth": "ماموث شمالي, ماموث صوفي (ماموث كثيف الشعر كان شائعاً في المناطق الباردة من نصف الكرة الشمالي)",
 "woolly manzanita": "مانزانيتا زغبية (شجيرة كاليفورنية قائمة مفتوحة التفرع تكون أغصانها صوفية عندما تكون صغيرة)",
 "woolly monkey": "سَعْدَان صُوفِيّ",
 "woolly mullein": "آذان الدب, بوصير (بوصير طويل الساق صوفي جداً بزهور صفراء مكتظة بكثافة؛ كان الإغريق والرومان القدماء يغمسون السيقان في الشحم لاستخدامها كمشاعل جنائزية)",
 "woolly plant louse": "من صوفي (يفرز مادة شمعية تشبه كتلة من خيوط القطن الأبيض المجعد الناعم أو الصوف)",
 "woolly rhinoceros": "وحيد القرن الصوفي (نوع منقرض كثيف الشعر من المناطق القطبية)",
 "woolly sunflower": "إريوفيلوم, دوار الشمس الصوفي (أي نبات من جنس إريوفيلوم)",
 "woolly thistle": "شوك صوفي (شوك من غرب أمريكا الشمالية له أوراق بيضاء صوفية) / شوك اسكتلندي, شوك صوفي (شوك أوراسي ثنائي الحول أبيض مشعر ذو أزهار أرجوانية شاحبة؛ متوطن في أمريكا الشمالية)",
 "woolly-haired": "صُوفِيّ, مُجَعَّد (مغطى بشعر كثيف غالباً ما يكون متلبداً أو مجعداً)",
 "woolly-headed": "مُخْتَلِط, مُشَوَّش الذِّهْن (مرتبك وغامض التفكير؛ يُقال خاصّة عن طريقة التفكير)",
 "woolly-stemmed": "صُوفِيّ السَّاق (ذو ساق مغطّاة بزغب صوفيّ)",
 "woolsorter": "فرّاز الصوف (شخص يفرز الصوف إلى درجات مختلفة)",
 "woolsorter's disease": "جمرة خبيثة رئوية (شكل من أشكال عدوى الجمرة الخبيثة المكتسبة عن طريق استنشاق الغبار المحتوي على البكتيريا)",
 "woolsorter's pneumonia": "جمرة خبيثة رئوية (شكل من أشكال عدوى الجمرة الخبيثة المكتسبة عن طريق استنشاق الغبار المحتوي على البكتيريا)",
 "wooly": "صُوفِيّ, مُجَعَّد (مغطى بشعر كثيف غالباً ما يكون متلبداً أو مجعداً) / مُخْتَلِط, مُشَوَّش الذِّهْن (مرتبك وغامض التفكير؛ يُقال خاصّة عن طريقة التفكير) / صُوفِيّ, نَدِفِيّ (شَبيه بالصُّوف في مَلْمَسِه ونُعومَتِه)",
 "wooly blue curls": "تجعيدات زرقاء صوفية, مريمية سوداء (نبات عطري بأوراق صوفية يوجد في جنوب كاليفورنيا والمكسيك)",
 "wooly lip fern": "سرخس الشفة الصوفي, سرخس الشفة المشعر (سرخس دائم الخضرة صغير في أمريكا الشمالية تكون سويقاته وأسطح سعفه السفلية صوفية كثيفة)",
 "wooly-haired": "صُوفِيّ, مُجَعَّد (مغطى بشعر كثيف غالباً ما يكون متلبداً أو مجعداً)",
 "wooly-minded": "مُخْتَلِط, مُشَوَّش الذِّهْن (مرتبك وغامض التفكير؛ يُقال خاصّة عن طريقة التفكير)",
 "woozle effect": "تأثير ووزل",
 "woozy": "دَائِخ, مُصَاب بِالدُّوَار (يشعر بدوار ودوخة؛ معرَّض للسقوط)",
 "wop": "إيطالي (مهين) (مصطلح عدائي أو مهين لشخص من أصل إيطالي)",
 "worcester": "وُسْتَر",
 "worcester sauce": "صلصة ورسيستيرشاير (صلصة لذيذة من الخل وصلصة الصويا والتوابل)",
 "worcestershire": "صلصة ورسيستيرشاير (صلصة لذيذة من الخل وصلصة الصويا والتوابل)",
 "worcestershire sauce": "صلصة ورسيستيرشاير (صلصة لذيذة من الخل وصلصة الصويا والتوابل)",
 "word": "كَلِمَة, كَلَام (الكلِمَةُ : اللفظةُ الدَّالةُ على معنًى مُفْرَد بالوضع، وتكون؛ الكلِمَةُ: الكلامُ المؤلَّفُ المطوَّل، قصيدةً، أَو خُطْبَةً، أَو مقالةً، أَو رسالة) / كَلِمَةُ اللهِ (الكلِمَةُ : اللفظةُ الدَّالةُ على معنًى مُفْرَد بالوضع، وتكون؛ الكلِمَةُ: الكلامُ المؤلَّفُ المطوَّل، قصيدةً، أَو خُطْبَةً، أَو مقالةً، أَو رسالة)\nمثال: كلمة السر طويلة.",
