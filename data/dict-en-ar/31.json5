 "yours sincerely": "اَلْمُخْلِص",
 "yourself": "نفسكَ, نفسكِ",
 "yourselves": "أَنْفُسُكُم",
 "youth": "شَبَاب / شَبَاب, صِبًا / شَابّ",
 "youth crusade": "حركة شبابية (حركة إصلاح سياسي أو ديني أو اجتماعي تتكون بشكل رئيسي من الشباب)",
 "youth culture": "ثقافة الشباب (الشباب (كوحدة جيلية) باعتبارهم طبقة ثقافية أو ثقافة فرعية)",
 "youth gang": "عصابة أحداث, عصابة شباب (عصابة أعضاؤها من المراهقين)",
 "youth hostel": "بَيْت اَلشَّبَاب, نُزُل اَلشَّبَاب (بمعنى قضى الليل؛ الخَيْمَة من الشَعْر يَبِيت فيها البَدَوي أو المُسافر. الجمع بُيُوت)\nمثال: لنعد إلى البيت.",
 "youth movement": "حركة شبابية (حركة إصلاح سياسي أو ديني أو اجتماعي تتكون بشكل رئيسي من الشباب)",
 "youth subculture": "ثقافة فرعية شبابية (ثقافة شبابية أقلية يعتمد تميزها بشكل كبير على الطبقة الاجتماعية والخلفية العرقية لأعضائها؛ وغالباً ما تتميز بتبنيها لنوع معين من الموسيقى)",
 "youth-on-age": "تولميا, نبات الشباب (عشب معمر قوي بأزهار في عناقيد منتصبة وتتطور نباتات صغيرة عند اتصال نصل الورقة بسويقتها)",
 "youthful": "شَبَابِيّ, مَفْعَم بِالحَيَوِيَّة (يوحي بالشباب؛ نشيط ومفعم بالحيويّة)",
 "youthfully": "بروح شبابية, بفتوة (بطريقة شبابية)\nمثال: لا يزال متحمساً بروح شبابية",
 "youthfulness": "شباب, فتوة (النضارة والحيوية المميزة للشاب)",
 "youtube": "يُوتِيُوب, يُوتْيُوب",
 "yowl": "خوار, زئير (تلفظ عالٍ جداً (مثل صوت حيوان))\nمثال: ملأ خواره الممر",
 "yozgat": "يوزغاد",
 "yquem": "إيكيم (نبيذ فرنسي أبيض حلو)",
 "yr": "سنة, عام (فترة زمنية تحتوي على 365 (أو 366) يوماً)\nمثال: عمرها 4 سنوات",
 "ytterbite": "جادولينيت (معدن يعد مصدراً للأتربة النادرة؛ يتكون من سيليكات الحديد والبريليوم والسيريوم والإيتريوم والإربيوم)",
 "ytterbium": "أُوتِّرْبِيُوم / يُتِرْبِيُوم / إِتِيرْبِيُوم",
 "yttrium": "إِتْرِيُوم, أُتْرِيُوم",
 "yuan": "يُوَان",
 "yuan dynasty": "السلالة المغولية, سلالة يوان (السلالة الإمبراطورية للصين من 1279 إلى 1368)",
 "yucatec": "لغة يوكاتيك, لغة يوكاتيكو (لغة مايانية يتحدث بها شعب يوكاتيك) / يوكاتيك (فرد من شعب المايا في شبه جزيرة يوكاتان في المكسيك)",
 "yucatec language": "لغة يوكاتيك, لغة يوكاتيكو (لغة مايانية يتحدث بها شعب يوكاتيك)",
 "yucateco": "لغة يوكاتيك, لغة يوكاتيكو (لغة مايانية يتحدث بها شعب يوكاتيك) / يوكاتيك (فرد من شعب المايا في شبه جزيرة يوكاتان في المكسيك)",
 "yucateco language": "لغة يوكاتيك, لغة يوكاتيكو (لغة مايانية يتحدث بها شعب يوكاتيك)",
 "yucatán": "وِلَايَة يُوكَاتَان (منطقة إدارية لها استقلالها الإداري والمعنوي؛ ويختلف المعنى من بلد لآخر كما يختلف من فترة زمنية لأخرى)\nمثال: كان زيري من ولاية أخرى.",
 "yucca": "يوكا (أي من النباتات دائمة الخضرة المتعددة من جنس اليوكا ذات سيقان قوية طويلة عادة وعنقود طرفي من الزهور البيضاء؛ المناطق الدافئة في أمريكا الشمالية)",
 "yucca aloifolia": "حربة إسبانية, يوكا ألوفوليا (يوكا صلبة بجذع قصير؛ توجد في جنوب الولايات المتحدة وأمريكا الاستوائية؛ لها أوراق صلبة مدببة بشوكة وعناقيد من الزهور البيضاء)",
 "yucca baccata": "حربة إسبانية, يوكا توتية (يوكا طويلة من جنوب غرب الولايات المتحدة والمكسيك لها ساق خشبية وأوراق مدببة صلبة تشبه السيف وعنقود كبير من الزهور البيضاء)",
 "yucca brevifolia": "شجرة جوشوا (يوكا شجرية متفرعة كبيرة من جنوب غرب الولايات المتحدة لها أوراق قصيرة وزهور بيضاء مخضرة متجمعة)",
 "yucca carnerosana": "خنجر إسباني (يوكا شجرية من جنوب غرب الولايات المتحدة وشمال المكسيك بأوراق سيفية الشكل وزهور بيضاء)",
 "yucca elata": "شجرة الصابون, عشبة الصابون (يوكا شجرية طويلة من جنوب غرب الولايات المتحدة)",
 "yucca filamentosa": "إبرة آدم, يوكا خيطية (يوكا بأوراق صلبة طويلة لها زوائد تشبه الخيوط)",
 "yucca glauca": "عشب الدب, يوكا زرقاء (يوكا من غرب وسط الولايات المتحدة لها كتلة من الأوراق القاعدية التي تشبه العشب وساق مركزي بعنقود طرفي من الزهور البيضاء الصغيرة)",
 "yucca gloriosa": "خنجر إسباني, يوكا مجيدة (يوكا من جنوب شرق الولايات المتحدة تشبه الحراب الإسبانية ولكن بجذع أقصر وأوراق أنعم)",
 "yucca smalliana": "عشب الدب (يوكا من جنوب الولايات المتحدة لها كتلة من الأوراق القاعدية التي تشبه العشب وساق مركزي بعنقود طرفي من الزهور البيضاء الصغيرة)",
 "yucca whipplei": "شمعة ربنا, يوكا ويبلي (يوكا من جنوب غرب الولايات المتحدة والمكسيك بسنبلة طويلة من الزهور البيضاء الكريمية)",
 "yuck": "يَع",
 "yucky": "مُثِير لِلاشْمِئْزَاز, مُقْرِف (بالغ الكراهة؛ يثير النفور والاشمئزاز)",
 "yue": "الكانتونية, لغة يوي (لهجة صينية يتم التحدث بها في كانتون والمقاطعات المجاورة وفي هونغ كونغ وأماكن أخرى خارج الصين)",
 "yue dialect": "الكانتونية, لغة يوي (لهجة صينية يتم التحدث بها في كانتون والمقاطعات المجاورة وفي هونغ كونغ وأماكن أخرى خارج الصين)",
 "yuga": "يوغا (اسم لحقبة أو عصر ضمن دورة الأعمار الأربعة في الفلسفة الهندوسية)\nمثال: مثل الصيف والربيع والشتاء والخريف، كل يوغا تنطوي على مراحل أو تغيرات تدريجية تمر بها الأرض ووعي البشرية ككل",
 "yugoslav": "يوغوسلافي (من أو يتعلق بدولة يوغوسلافيا السابقة أو شعبها أو لغاتها أو يميزهم) / يوغوسلافي (مواطن أو ساكن في يوغوسلافيا)\nمثال: نبيذ يوغوسلافي",
 "yugoslavia": "يُوغُسْلَافِيَا / يُوجُوسْلَافِيَا / يُوجُسْلَافِيَا / يُوغُوسْلافِيَا",
 "yugoslavian": "يُوجُوسْلَافِيّ",
 "yugoslavian dinar": "دينار, دينار يوغوسلافي (وحدة المال الأساسية في يوغوسلافيا)",
 "yugoslavian monetary unit": "وحدة نقدية يوغوسلافية (الوحدة النقدية في يوغوسلافيا)",
 "yukata": "يُوكَاتَا",
 "yukon": "يُوكُون",
 "yukon territory": "مقاطعة يوكون",
 "yukon time": "توقيت ألاسكا (التوقيت القياسي في المنطقة الزمنية التاسعة غرب غرينتش، يحسب عند خط الطول 135 غرباً؛ يستخدم في هاواي ومعظم ألاسكا)",
 "yukon white birch": "بتولا يوكون البيضاء (بتولا ألاسكية بلحاء أبيض إلى بني شاحب)",
 "yule": "الكريسماس, عيد الميلاد (الفترة الممتدة من 24 ديسمبر إلى 6 يناير)",
 "yule log": "جذع عيد الميلاد (جذع كبير يتم حرقه تقليدياً في عيد الميلاد)",
 "yuletide": "الكريسماس, عيد الميلاد (الفترة الممتدة من 24 ديسمبر إلى 6 يناير)",
 "yuma": "لغة يوما (اللغة اليومية التي يتحدث بها شعب يوما) / يوما (فرد من شعب الهنود في أمريكا الشمالية في أريزونا والمناطق المجاورة في المكسيك وكاليفورنيا)",
 "yuma language": "لغة يوما (اللغة اليومية التي يتحدث بها شعب يوما)",
 "yuman": "يومي (من أو متعلق بلغة أو ثقافة شعب يوما) / اللغات اليومية (مجموعة من لغات عائلة هوكان في أريزونا وكاليفورنيا والمكسيك)",
 "yummy": "لَذِيذ",
 "yunnan": "يُنَّان",
 "yup": "نَعَم, إِي (الإبِل والبَقَر والغَنَم. وتسمى نَعَم فقط إذا كان فيها إبل، فالإبل لوحدها نَعَم…)\nمثال: أنت نعم الطالب.",
 "yuppie": "شاب مهني طموح, يابي (شاب محترف صاعد اجتماعياً؛ مهني من الطبقة المتوسطة يتقاضى أجراً جيداً ويعمل في المدينة ولديه أسلوب حياة فاخر)",
 "yurak-samoyed": "نينيتس (لغة أورالية يتحدث بها ساموييد شمال سيبيريا)",
