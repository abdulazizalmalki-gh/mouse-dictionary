 "yarder": "رافعة جذوع الأشجار (ونش (أو نظام من الروافع) يعمل بمحرك ويستخدم لسحب جذوع الأشجار من الجذع المقطوع إلى منطقة التجميع أو طريق السحب) / ياردة ((تستخدم في التراكيب فقط) ارتفاع أو طول شيء ما بالياردات)",
 "yardgrass": "عشب الإوز, نجيل هندي (عشب حولي خشن له سنابل زهور تشبه الأصابع؛ موطنه المناطق الاستوائية في العالم القديم؛ عشبة ضارة متوطنة في أماكن أخرى)",
 "yardie": "ياردي (عضو في عصابة دولية من المجرمين الجامايكيين الذين يبيعون المخدرات ويمارسون العنف)",
 "yardman": "بستاني, عامل ساحة (عامل ذكر يتم استئجاره للقيام بأعمال خارجية (مثل جز العشب)) / عامل ساحة (عامل ذكر في ساحة السكك الحديدية)",
 "yardmaster": "مدير الساحة, ناظر المحطة (موظف سكة حديد مسؤول عن ساحة القطارات)",
 "yardstick": "مسطرة ياردة (مسطرة أو شريط قياس طوله ثلاثة أقدام) / معيار, مقياس (مقياس أو معيار يستخدم للمقارنة)\nمثال: على أي نوع من المقاييس يبني حكمه؟",
 "yardwoman": "عاملة ساحة (عاملة أنثى في ساحة السكك الحديدية) / بستانية, عاملة ساحة (عاملة أنثى يتم استئجارها للقيام بأعمال خارجية (مثل جز العشب))",
 "yarmelke": "قلنسوة يهودية, كيباه (قلنسوة يرتديها اليهود المتدينون (خاصة عند الصلاة))",
 "yarmouk": "اليَرْمُوك",
 "yarmulka": "قلنسوة يهودية, كيباه (قلنسوة يرتديها اليهود المتدينون (خاصة عند الصلاة))",
 "yarmulke": "قُبَّة, كِبَّة",
 "yarn": "خَيْط ((خَيَّطَ) الشَّيْبُ في رأسِهِ تَخْييطًا: بَدَا، أو صارَ كالخُيُوطِ فَتَخَيَّطَ رأسُهُ بالشَّيْبِ؛ (خَيَّطَ) الثَّوْب: خاطه)\nمثال: حل الصرة تلقى خيط.",
 "yarn-spinning": "رَاوِي حَكَايَات, قَصَّاص (يميل إلى سرد قصص طويلة ومعقّدة غالبًا عن أحداث خارقة)",
 "yaroslavl": "يَارُوسْلَافْل",
 "yarrow": "قَيْصُوم",
 "yashmac": "يشمك (نقاب الوجه الذي ترتديه النساء المسلمات)",
 "yashmak": "خِمَار, نِقَاب (مَا تُغَطِّي الْمَرْأَةُ بِهِ شَعْرَهَا وَرَقَبَتَهَا؛ مَا تُغَطِّي الْمَرْأَةُ بِهِ وَجْهَهَا)\nمثال: اعتنقت ليلى الإسلام و بدأت ترتدي الخمار.",
 "yassa": "يَاسَق",
 "yataghan": "سيف تركي, ياتاجان (سكين تركي طويل ذو نصل منحني وحافة واحدة)",
 "yathrib": "يَثْرِب (الاسم القديم ل في الحجاز، تسمّى حاليا المَدِينَةُ المُنَوَّرَة)",
 "yatobyo": "تولاريميا, حمى الأرانب (مرض شديد العدوى يصيب القوارض (وخاصة الأرانب والسناجب) وينتقل أحيانًا إلى البشر عن طريق القراد أو الذباب أو عن طريق التعامل مع الحيوانات المصابة)",
 "yaupon holly": "بهشية يوبون (شجيرة دائمة الخضرة؛ نوع من البهشية موطنه جنوب شرق أمريكا الشمالية)",
 "yautia": "قلقاس أمريكي, ياوتيا (نبات لوفي استوائي أمريكي له درنات صالحة للأكل تطهى وتؤكل مثل اليام أو البطاطس)",
 "yavapai": "لغة يافاباي (اللغة اليومية التي يتحدث بها شعب يافاباي) / يافاباي (فرد من شعب هندي في أمريكا الشمالية في وسط أريزونا)",
 "yavapai language": "لغة يافاباي (اللغة اليومية التي يتحدث بها شعب يافاباي)",
 "yaw": "انحراف, زيغان (انحراف غير منتظم عن المسار المقصود)",
 "yawl": "يول (سفينة شراعية بصاريتين؛ صارية خلفية صغيرة تقع خلف عمود الدفة) / يول (قارب صغير للسفينة (يُجدف عادة بـ 4 أو 6 مجاديف))",
 "yawn": "تَثَاءَبَ / تَثَاؤُب",
 "yawner": "مُتَثَائِب (شخص يتثائب)",
 "yawning": "تثاؤب (استنشاق لا إرادي للهواء من خلال فم مفتوح على مصراعيه؛ عادة ما يسببه التعب أو الملل) / فَاغِر, مُتَثَائِب (فاتح فاه كأنّه يهدّد بابتلاع شيء) / مُتَثَائِب (بفم مفتوح على مصراعيه دلالةً على الملل أو النعاس)\nمثال: لم يستطع كبت التثاؤب",
 "yaws": "داء عليقي (مرض استوائي معد يشبه الزهري في مراحله المبكرة؛ يتميز بطفح جلدي أحمر وآفات متقرحة)",
 "yay": "لغة بويي (فرع من لغات تاي، يُتحدث به في جنوب وجنوب غرب مقاطعة قويتشو ومقاطعة يونان في الصين)",
 "yazdegerd": "يَزْدَجِرْد",
 "yazidism": "الإيزيدية",
 "yb": "يوبي بايت, يوتابايت (وحدة معلومات تساوي 1024 زيبي بايت أو 2 أس 80 بايت) / يوتابايت (وحدة معلومات تساوي 1000 زيتابايت أو 10 أس 24 بايت) / يوتابت (وحدة معلومات تساوي 1000 زيتابت أو 10 أس 24 بت) / إيتربيوم (عنصر فلزي فضي ناعم؛ من أتربة اللنثانيدات النادرة)",
 "ybit": "يوتابت (وحدة معلومات تساوي 1000 زيتابت أو 10 أس 24 بت)",
 "yea": "بل, نعم (ليس ذلك فحسب، بل) / أجل, نعم (نعم (تستخدم غالباً في التصويت))\nمثال: أنا بذلك أفرح، بل وسأفرح",
 "yeah": "بل, نعم (ليس ذلك فحسب، بل)\nمثال: أنا بذلك أفرح، بل وسأفرح",
 "year": "صَفّ (سَطْر مستقيم؛ مستوى تعليمي)\nمثال: صف كليتي وقلبي‎.",
 "year dot": "الزمن الغابر, سنة جدّي (منذ زمن بعيد بقدر ما يتذكر أي شخص)\nمثال: هو قائد فرقة موسيقية منذ زمن سحيق",
 "year of grace": "سنة ميلادية (أي سنة من العصر المسيحي)",
 "year-around": "على مدار السنة (يعمل أو يستمر طوال العام)\nمثال: منتجع يعمل على مدار السنة",
 "year-end": "فِي نِهَايَةِ العَام (يَجْرِي فِي خِتَامِ السَّنَةِ المَالِيَّةِ) / نهاية العام (نهاية السنة التقويمية)\nمثال: اضطر لتفريغ البضائع قبل نهاية العام",
 "year-round": "على مدار السنة (يعمل أو يستمر طوال العام)\nمثال: منتجع يعمل على مدار السنة",
 "yearbook": "كتاب سنوي (كتاب مرجعي ينشر بانتظام مرة كل عام) / كتاب سنوي (كتاب تنشره سنوياً دفعة التخرج في مدرسة ثانوية أو كلية يحتوي عادة على صور أعضاء هيئة التدريس والطلاب المتخرجين)",
 "yearling": "حولي (حيوان في سنته الثانية) / حولي (حصان سباق يُعتبر عمره سنة واحدة حتى الأول من يناير الثاني بعد ولادته) / طفل صغير, طفل يحبو (طفل صغير بدأ للتو في المشي)",
 "yearlong": "لِمُدَّة سَنَة (يَسْتَمِرّ سَنَة كامِلَة)",
 "yearly": "سَنَوِيّ / سَنَوِيًّا",
 "yearn": "تَاقَ (اشتاقَ ومالَ بشدة إلى الشيء أو الشخص؛ تحركَ أو تطلعَ بشوق نحو أمر مرغوب) / اِشْتَاقَ",
 "yearned-for": "مُتَوَقّ إِلَيْه, مُشْتَاق إِلَيْه (مرغوب فيه بشدّة وشوق عظيم)",
 "yearner": "تَوَّاق, مُتَلَهِّف (شخص لديه رغبة قوية في شيء ما)\nمثال: تواق للمال",
 "yearning": "شَوْق (نزوعُ النَّفْس إِلى الشيء، أو تَعَلُّقها به؛ مصدر الفعل شَاقَ)\nمثال: سأشعر بالشوق إليك.",
 "yearningly": "بشوق, بلهفة (بطريقة مشتاقة)\nمثال: قضى بقية الفصل يحدق بشوق فوق كتفي الأيمن إلى كلمة (خروج) المضاءة",
 "years": "أيام, سنوات (الوقت الذي تستمر فيه حياة شخص ما) / أرذل العمر, شيخوخة (مرحلة متأخرة من الحياة) / دهر, سنوات (فترة زمنية طويلة)\nمثال: أيام الملك الأخيرة",
 "yeasayer": "إِمَّعَة",
 "yeast": "خَمِيرَة",
 "yeast cake": "قالب خميرة (قالب صغير من الخميرة الرطبة المضغوطة)",
 "yeast dough": "عجين الخميرة (عجين الخميرة هو أي عجين مصنوع باستخدام الخميرة)",
 "yeastlike": "خميري (من أو يشبه أو يحتوي على الخميرة)",
 "yeasty": "فَوَّار, مُفْعَمٌ بِالإبْدَاعِ (مُبدِع بحيوية وفيض) / مُتَحَمِّس, مُتَّقِد (يتّسم بالاستمتاع الحماسيّ والنشاط المُفعَم بالحيويّة) / خميري (من أو يشبه أو يحتوي على الخميرة)",
 "yeatsian": "ييتسي (على طريقة ويليام بتلر ييتس)",
 "yekaterinburg": "ييكاتيرينبرغ",
 "yelena": "يِلِينَا",
 "yell": "صَاحَ (صاتَ بأقصى طاقته وأعلى صوته، يستخدم للحيّ ولا يقال صاح للجماد؛ عليه: ناداه)\nمثال: سأساعدك يا صاح.",
 "yelled": "مَصْرُوخ, مُنَادًى (صادر بصراخ عنيف)",
 "yeller": "زاعق, صائح (شخص يتواصل صوتيًا بصوت عالٍ جدًا)",
 "yelling": "صراخ, صياح (إطلاق صرخة عالية غير واضحة الكلمات كما في الألم أو الإثارة)",
 "yellow": "أَصْفَر (أحد الأَلْوَان الرئيسية (الأَحْمَر والأَصْفَر والأَزْرَق)، وهو لون الزُعْفُرَان والذَهَب والعُصْفُر. انظر الصورة؛ صفة ما كان لونه أصفرا) / جَبَان (شديد الخوف ممتنع عن الإقدام؛ ضد الشجاع) / أَصْفَر, صَفْرَاء (أحد الأَلْوَان الرئيسية (الأَحْمَر والأَصْفَر والأَزْرَق)، وهو لون الزُعْفُرَان والذَهَب والعُصْفُر. انظر الصورة؛ صفة ما كان لونه أصفرا) / اِصْفَرَّ, صَفَّرَ\nمثال: قلبي أخضر و أصفر.",
 "yellow adder's tongue": "زنبق السلمون المرقط, لسان الحية الأصفر (نبات سن الكلب من شرق أمريكا الشمالية له زهور صفراء منفردة معلمة بالبني أو الأرجواني وداخل منقط)",
 "yellow ageratum": "أجيراتوم أصفر, أقحوان أفريقي (شجيرة من منطقة جنوب غرب البحر الأبيض المتوسط لها زهور صفراء تشبه الأقحوان)",
 "yellow asphodel": "بروق أصفر, رمح الملك (بروق بساق مورقة وزهور صفراء عطرة)",
 "yellow avens": "أفينس أصفر (شجيرة منتصبة ذات زهور صفراء عميقة؛ أوروبا وآسيا وأمريكا الشمالية) / أفينس أصفر كبير الأوراق (نبات زغبي أصفر الزهور من شرق آسيا وأمريكا الشمالية)",
 "yellow bachelor's button": "مستدرة برتقالية, مستدرة صفراء (نبات مستنقعات في غابات الصنوبر بجنوب شرق الولايات المتحدة له سنابل من الزهور الصفراء البرتقالية غير المنتظمة)",
 "yellow bass": "باس أصفر (باس مياه عذبة في أمريكا الشمالية يشبه الباس المخطط البحري الأكبر)",
 "yellow bean": "فاصولياء شمعية, فاصولياء صفراء (فاصولياء ذات قرون صفراء)",
 "yellow bedstraw": "جويسئة السيدة العذراء, جويسئة صفراء (جويسئة معمرة شائعة ذات زهور صفراء؛ أمريكا الشمالية وأوروبا وآسيا)",
 "yellow bells": "أجراس صفراء, أجراس هامسة (عشب لزج في الموائل القاحلة أو الصحراوية في جنوب غرب الولايات المتحدة له أزهار صفراء متدلية)",
 "yellow berry": "توت النبق (فاكهة لنبق مختلف تنتج أصباغاً أو خضاباً)",
 "yellow bile": "صَفْرَاء (مؤنث أَصْفَر؛ صفة ما كان لونها الصفار؛ الغُدّة الصفراء: غدة في الكبد، تسمى أيضا الغدّة الصفراوية والمَرَارَة)\nمثال: هذه وردة صفراء.",
 "yellow birch": "بتولا صفراء (شجرة من شرق أمريكا الشمالية بلحاء أصفر أو رمادي لامع رقيق)",
 "yellow bone marrow": "نخاع أصفر (نخاع العظم الذي يكون أصفر اللون بسبب الدهون؛ يوجد في نهايات العظام الطويلة عند البالغين)",
 "yellow bristle grass": "ذيل الثعلب الأصفر (عشب ضار وشائك شائع يوجد في جميع المناطق المعتدلة تقريباً)",
 "yellow bristlegrass": "ذيل الثعلب الأصفر (عشب ضار وشائك شائع يوجد في جميع المناطق المعتدلة تقريباً)",
 "yellow bugle": "صنوبر أرضي, عجوقة صفراء (نبات حولي منخفض النمو بزهور صفراء منقطة بالأحمر؛ معطر برائحة خفيفة من راتنج الصنوبر؛ أوروبا والجزر البريطانية وشمال إفريقيا)",
 "yellow bunting": "درسة صفراء (طائر درسة أوروبي يتميز الذكر منه بلون أصفر ساطع)",
 "yellow card": "بِطَاقَة صَفْرَاء",
 "yellow cattley guava": "جوافة الفراولة, جوافة كاتلي الصفراء (شجرة شجيرية استوائية صغيرة تحمل ثماراً صفراء صغيرة)",
 "yellow cedar": "أرز ألاسكا, سرو نوتكا (شجرة دائمة الخضرة طويلة من ساحل المحيط الهادئ لأمريكا الشمالية تزرع غالباً للزينة)",
 "yellow chamomile": "أقحوان الصباغين, بابونج أصفر (عشبة أوراسية معمرة بأوراق مقسمة مشعرة وزهور صفراء؛ متوطنة في أمريكا الشمالية)",
 "yellow chestnut oak": "سنديان أصفر, سنديان تشينكابين (شجرة نفضية متوسطة الحجم موطنها شرق الولايات المتحدة، تنتج خشباً قوياً ومتيناً)",
 "yellow cleavers": "جويسئة السيدة العذراء, جويسئة صفراء (جويسئة معمرة شائعة ذات زهور صفراء؛ أمريكا الشمالية وأوروبا وآسيا)",
 "yellow clintonia": "كلينتونيا شمالية, كلينتونيا صفراء (عشب غابات شائع في أمريكا الشمالية المعتدلة له زهور صفراء متدلية وثمار زرقاء مستديرة صغيرة)",
 "yellow colicroot": "عشبة المغص الصفراء (نبات بزهور عنقودية ذات قنابات صفراء؛ أصغر من الأليتريس الدقيق؛ جنوب شرق الولايات المتحدة)",
 "yellow cypress": "أرز ألاسكا, سرو نوتكا (شجرة دائمة الخضرة طويلة من ساحل المحيط الهادئ لأمريكا الشمالية تزرع غالباً للزينة)",
 "yellow delicious": "تفاح ذهبي, تفاح غولدن ديليشس (تفاح أكل حلو ذو قشرة صفراء)",
 "yellow dock": "حميض أصفر, حميض عريض الأوراق (حميض أوروبي بأوراق عريضة منفرجة وجذمور مر شائع كعشب ضار في أمريكا الشمالية)",
 "yellow dwarf": "قزم اصفر (أي من عدة أمراض فيروسية للنباتات تتميز بالتقزم واصفرار الأوراق)",
 "yellow dwarf of potato": "تقزم البطاطس الأصفر (مرض التقزم الأصفر لنباتات البطاطس)",
 "yellow fever": "حَمَّى صَفْرَاء (حمَى الشيءُ فلانًا: منَعه ودفع عنه؛ حمى المريضَ: منعه ما يضره)\nمثال: ليس لديك أي حمى.",
 "yellow flag": "سوسن أصفر, سوسن الماء الأصفر (سوسن أصفر الأزهار شائع في أوروبا وشمال أفريقيا، توطن في الولايات المتحدة ويزرع غالباً)",
 "yellow foxglove": "قمعية صفراء (قمعية أوروبية ذات زهور صفراء)",
 "yellow foxtail": "ذيل الثعلب الأصفر (عشب ضار وشائك شائع يوجد في جميع المناطق المعتدلة تقريباً)",
 "yellow giant hyssop": "أجاستاش, زوفا عملاقة صفراء (نبات معمر منتصب بسيقان قوية وزهور صفراء مخضرة؛ جنوب كندا وجنوب شرق الولايات المتحدة)",
 "yellow globe lily": "زنبق الكرة الأصفر, فانوس الجنية الذهبي (زنبق كروي له عناقيد متفرعة مفتوحة من الزهور الصفراء الصافية بيضاوية الشكل؛ شمال كاليفورنيا)",
 "yellow goatfish": "سمكة الماعز الصفراء (سمكة ماعز تعيش في أسراب؛ رمادية اللون مع شريط أصفر)",
 "yellow granadilla": "كوب حلو, ليمون مائي (الفاكهة الصفراء الصالحة للأكل لصريمة الجدي الجاميكية) / صريمة الجدي الجامايكية, غرانديلا صفراء (زهرة العاطفة من جزر الهند الغربية؛ تزرع لثمارها الصفراء الصالحة للأكل)",
 "yellow green": "أخضر ليموني, أخضر مصفر (درجة من الأخضر مشوبة بالأصفر)",
 "yellow gurnard": "الخرنار, الغرنار الأصفر (نوع من أسماك الغرنار)",
 "yellow hawkweed": "حشيشة الغراب الصفراء (حشيشة الغراب الأوروبية التي أدخلت إلى شمال شرق الولايات المتحدة؛ أعشاب ضارة مزعجة محلياً)",
 "yellow henbane": "بنج أصفر, حرنكش لزج (يوجد على شواطئ البحر من فرجينيا إلى أمريكا الجنوبية له زهور صفراء مخضرة وتوت برتقالي أو أصفر)",
 "yellow honeysuckle": "صريمة الجدي الصفراء, عسلة صفراء (شجيرة متساقطة الأوراق ملتفة بعناقيد من الزهور الخضراء المصفرة المشوبة بالأرجواني؛ شمال شرق أمريكا) / عسلة صفراء (شجيرة متساقطة الأوراق متسلقة بزهور صفراء عطرة (تصبح برتقالية لاحقاً) في دوامات طرفية؛ جنوب شرق الولايات المتحدة)",
 "yellow horned poppy": "خشخاش أصفر, خشخاش مقرن (عشب أوراسي أزرق مخضر ذو زهور صفراء تم توطينه على طول الشواطئ الرملية في شرق أمريكا الشمالية)",
 "yellow hornet": "دبور أصفر, سترة صفراء (دبور اجتماعي صغير معلم بالأصفر يعشش عادة في الأرض)",
 "yellow iris": "سوسن أصفر, سوسن الماء الأصفر (سوسن أصفر الأزهار شائع في أوروبا وشمال أفريقيا، توطن في الولايات المتحدة ويزرع غالباً)",
 "yellow ironweed": "فيربيسينا متبادلة الأوراق (عشب معمر بزهور صفراء ملفتة للنظر؛ شرق الولايات المتحدة)",
 "yellow jacaranda": "تيبو, جاكاراندا صفراء (شجرة شبه دائمة الخضرة من أمريكا الجنوبية بأوراق ريشية فردية وزهور صفراء ذهبية تزرع للزينة)",
 "yellow jack": "جاك أصفر (سمكة من غرب المحيط الأطلسي وخليج المكسيك) / العلم الأصفر (علم أصفر يرفع على سفينة في الحجر الصحي) / حمى صفراء (مرض يسببه فيروس مصفر ينتقل عن طريق البعوض)",
 "yellow jacket": "دبور أصفر, سترة صفراء (دبور اجتماعي صغير معلم بالأصفر يعشش عادة في الأرض) / بنتوباربيتال الصوديوم, نيمبوتال (باربيتورات (الاسم التجاري نيمبوتال) يستخدم كمهدئ ومنوم ومضاد للتشنج)",
 "yellow jasmine": "ياسمين أصفر, ياسمين كارولينا (كرمة خشبية سامة دائمة الخضرة في جنوب شرق الولايات المتحدة لها أزهار صفراء قمعية الشكل وعطرة)",
 "yellow jersey": "قَمِيص أَصْفَر (المَشِيْمَة؛ ثَوْب بكمين مخيط غير مفرج يلبس تحت الثياب ولا يكون إلا من القطن أو الكتان، يذكر غالبا وقد يؤنث)\nمثال: لديه قميص أسود.",
 "yellow jessamine": "ياسمين أصفر, ياسمين كارولينا (كرمة خشبية سامة دائمة الخضرة في جنوب شرق الولايات المتحدة لها أزهار صفراء قمعية الشكل وعطرة)",
 "yellow journalism": "صَحَافَة الصَّفْرَاء, صَحَافَة الفَاضِحَة (هي مهنة من يكتب في الصُحُف والمَجَلات وغيرها من الدَوْريَّات؛ هي مجموعة المؤسسات التي تصدر أو تنشر الصُحُف والمَجَلات وغيرها من الدَوْريَّات)\nمثال: قرأ هذا في الصحافة.",
 "yellow lady's slipper": "خف السيدة الأصفر (سحلب كستنائي إلى بني أرجواني بشفة صفراء؛ أوروبا وأمريكا الشمالية واليابان)",
 "yellow lady-slipper": "خف السيدة الأصفر (سحلب كستنائي إلى بني أرجواني بشفة صفراء؛ أوروبا وأمريكا الشمالية واليابان)",
 "yellow light": "ضوء أصفر (إشارة للمضي قدماً بحذر)",
 "yellow locust": "روبينيا سنطية, سنط كاذب (شجرة شائكة كبيرة من شرق ووسط الولايات المتحدة لها أوراق ريشية مركبة وعناقيد متدلية من الزهور البيضاء؛ متوطنة على نطاق واسع في العديد من الأصناف في…)",
 "yellow loosestrife": "ليسيماكيا الحدائق, ليسيماكيا صفراء (تعتبر في كثير من الأحيان عشبة ضارة؛ أوروبا وآسيا)",
 "yellow lupine": "ترمس أصفر (ترمس أوروبي ذو زهور صفراء يزرع للعلف)",
 "yellow man": "رجل أصفر (مصطلح مسيء) (مصطلح مسيء لرجل آسيوي)",
 "yellow mariposa tulip": "توليب ماريبوسا الأصفر (ماريبوسا لها عناقيد لعدد قليل من الزهور الصفراء العميقة الكبيرة جرسية الشكل فوق سيقان رفيعة؛ السلاسل الساحلية لكاليفورنيا)",
 "yellow marrow": "نخاع أصفر (نخاع العظم الذي يكون أصفر اللون بسبب الدهون؛ يوجد في نهايات العظام الطويلة عند البالغين)",
 "yellow metal": "معدن مونتز, نحاس أصفر ألفا-بيتا (نحاس أصفر يحتوي على زنك أكثر ويكون أقوى من نحاس ألفا؛ يستخدم في صنع المسبوكات والمنتجات المشكلة على الساخن)",
 "yellow milkwort": "مستدرة برتقالية, مستدرة صفراء (نبات مستنقعات في غابات الصنوبر بجنوب شرق الولايات المتحدة له سنابل من الزهور الصفراء البرتقالية غير المنتظمة)",
 "yellow mombin": "خنزير البرقوق, مومبين أصفر (فاكهة استوائية بيضاوية صفراء) / برقوق الخنزير, مومبين أصفر (شجرة استوائية أمريكية لها فاكهة صفراء صالحة للأكل)",
 "yellow mombin tree": "برقوق الخنزير, مومبين أصفر (شجرة استوائية أمريكية لها فاكهة صفراء صالحة للأكل)",
 "yellow mountain saxifrage": "كاسر الحجر الجبلي الأصفر (نبات معمر دائم الخضرة ذو خصلات له أوراق مهدبة وزهور خيمية صفراء غالباً ما تكون مرقطة بالبرتقالي)",
 "yellow nutgrass": "حب العزيز, سعد لذيذ (سعد أوروبي له درنات صغيرة صالحة للأكل تشبه الجوز)",
 "yellow oak": "بلوط أسود, بلوط أصفر (شجرة أخشاب متساقطة الأوراق متوسطة إلى كبيرة من شرق الولايات المتحدة وجنوب شرق كندا لها لحاء خارجي داكن ولحاء داخلي أصفر يستخدم للدباغة؛ الأوراق…)",
 "yellow ocher": "مغرة صفراء (صبغة تتكون من الليمونيت الممزوج بالطين والسيليكا)",
 "yellow ochre": "مغرة صفراء (صبغة تتكون من الليمونيت الممزوج بالطين والسيليكا)",
 "yellow oleander": "تيفتيا, دفلى صفراء (شجيرة أو شجرة صغيرة استوائية أمريكية ذات أوراق خضراء داكنة لامعة وأزهار عطرية صفراء زعفرانية إلى برتقالية أو بلون الخوخ؛ جميع أجزائها سامة للغاية)",
 "yellow pages": "الصفحات الصفراء (دليل هاتف أو قسم من دليل (مطبوع عادة على ورق أصفر) حيث يتم سرد المنتجات والخدمات التجارية أبجدياً حسب المجال مع الإعلانات المبوبة)",
 "yellow paper daisy": "ذهب الشمس, زهرة القش (نبات أسترالي متوطن في إسبانيا له زهور صفراء ليمونية إلى ذهبية عميقة؛ الخيار المتكرر لمحبي الزهور المجففة)",
 "yellow parilla": "بذر القمر الشائع, بذر القمر الكندي (كرمة خشبية من شرق أمريكا الشمالية ذات أوراق بيضاوية كبيرة وأزهار بيضاء صغيرة وثمار أرجوانية إلى سوداء زرقاء)",
 "yellow pea": "بازلاء ذهبية, ترمس كاذب (عشب كثيف في غرب الولايات المتحدة له زهور صفراء تشبه البازلاء)",
 "yellow perch": "فرخ أصفر (فرخ أمريكا الشمالية)",
 "yellow peril": "الخطر الأصفر (التهديد للحضارة الغربية الذي يُقال إنه ينشأ من قوة الشعوب الآسيوية)",
 "yellow pimpernel": "ليسيماكيا صفراء (نبات أوروبي زاحف دائم الخضرة ذو أزهار صفراء)",
 "yellow pine": "صنوبر أصفر (خشب مصفر صلب للصنوبر الأصفر) / صنوبر أصفر (أي من أنواع الصنوبر المختلفة ذات الخشب الأصفر)",
 "yellow pitcher plant": "بوق الصياد, سراسينية صفراء (نبات إبريق في جنوب شرق الولايات المتحدة ذو أباريق صفراء منتصبة على شكل بوق ذات أفواه واسعة وأغطية منتصبة)",
 "yellow pond lily": "زنبق البرك الأصفر, زنبق البقر (زنبق ماء شائع في شرق ووسط أمريكا الشمالية، ذو أوراق عريضة وأزهار صفراء كروية الشكل؛ يعيش في المياه العذبة الراكدة أو قليلة الملوحة)",
 "yellow poplar": "حور أصفر, شجرة الزنبق (شجرة خشب نفضية طويلة في أمريكا الشمالية لها زهور صفراء مخضرة كبيرة تشبه الزنبق وثمار تشبه المخروط؛ تنتج أخشاباً بيضاء ناعمة تستخدم خاصة لأعمال الخزائن) / خشب الحور الأصفر, خشب الزنبق (خشب خفيف سهل العمل لشجرة الزنبق؛ يستخدم للأثاث والقشرة)",
 "yellow press": "صِحَافَة صَفْرَاء (هي مهنة من يكتب في الصُحُف والمَجَلات وغيرها من الدَوْريَّات؛ هي مجموعة المؤسسات التي تصدر أو تنشر الصُحُف والمَجَلات وغيرها من الدَوْريَّات)\nمثال: قرأ هذا في الصحافة.",
 "yellow prussiate of potash": "فيروسيانيد البوتاسيوم (مركب سيانيد يتم تحضيره بتفاعل سيانيد البوتاسيوم مع أملاح الحديدوز؛ يستخدم عادة من قبل البستانيين)",
 "yellow race": "العرق الأصفر, العرق المغولي (عرق آسيوي)",
 "yellow river": "اَلنَّهْر اَلْأَصْفَر, خْوَانْغْخِي",
 "yellow rocket": "بربارة شائعة, جرجير الشتاء (رشاد ضار ذو أزهار صفراء؛ يوضع أحياناً في جنس سيسيمبريم)",
 "yellow root": "الجذر الأصفر, خاتم الذهب (عشب معمر في شمال شرق الولايات المتحدة له ساق جذري أصفر سميك وعقدي وأوراق مستديرة كبيرة)",
 "yellow salsify": "تيس الجبل الأصفر, ساسفي أصفر (نبات معمر أوروبي مستوطن في جميع أنحاء الولايات المتحدة له سيقان مجوفة مع عدد قليل من الأوراق الضيقة الطويلة المدببة ويحمل كل منها زهرة صفراء شاحبة…)",
 "yellow sand verbena": "لويسية رملية صفراء (نبات ذو رؤوس نصف كروية من الزهور الصفراء قمعية الشكل؛ يوجد في الكثبان الساحلية من كاليفورنيا إلى كولومبيا البريطانية)",
 "yellow sea": "الْبَحْر الْأَصْفَر",
 "yellow spiny daisy": "أقحوان شائك أصفر (نبات معمر نحيل من غرب أمريكا الشمالية ذو أوراق خشنة ضعيفة ورؤوس زهور صفراء)",
 "yellow spot": "بقعة صفراء, لطخة (منطقة مركزية صفراء صغيرة في الشبكية غنية بالمخاريط وتتوسط الرؤية التفصيلية الواضحة) / تبقع أصفر (أي من العديد من الأمراض الفطرية أو الفيروسية التي تتميز بتبقع أصفر على الأوراق)",
 "yellow spot fungus": "فطر البقعة الصفراء (فطر يسبب البقعة الصفراء (مرض قصب السكر في أستراليا))",
 "yellow spruce": "تنوب أحمر (تنوب متوسط الحجم من شرق أمريكا الشمالية؛ تنوب الخشب الرئيسي في المنطقة؛ ومصدر لخشب اللب)",
 "yellow squash": "قرع أصفر, كوسا صفراء (قرع ذو قشرة صفراء ولب مصفر وعادة ما يكون له عنق طويل) / قرع أصفر (أي من نباتات القرع المختلفة التي تزرع لثمارها الصفراء ذات الأعناق الممدودة نوعاً ما)",
 "yellow star-thistle": "شوك النجم الأصفر, قنطريون صيفي (عشب ضار أوروبي له ساق مجنحة وأوراق مشعرة؛ وافد في شرق الولايات المتحدة)",
 "yellow sweet clover": "إكليل الملك الأصفر, حندقوق طبي (نبات أوراسي ثنائي الحول أصفر الزهر ذو أوراق عطرية تستخدم كطارد للغازات أو مادة منكهة؛ يزرع على نطاق واسع خاصة كسماد أخضر أو محصول تغطية)",
 "yellow tea": "شَاي أَصْفَر (شَجَرَة خَضْرَاء من فَصِيلَة الكَامِيلِيات لها أزْهَار بَيْضَاء، وتُعْطِي أوراقاً يصنع منها شَرَاب مُنَبِّه؛ أوراق الشجرة المجففة)\nمثال: صب الشاي لضيفك.",
 "yellow trefoil": "فصة ذئبية, فصة سوداء (عشب أوروبي مفترش ذو زهور صفراء صغيرة وقرون سوداء منحنية؛ تم توطينه في أمريكا الشمالية)",
 "yellow trumpet": "بوق الصياد, سراسينية صفراء (نبات إبريق في جنوب شرق الولايات المتحدة ذو أباريق صفراء منتصبة على شكل بوق ذات أفواه واسعة وأغطية منتصبة)",
 "yellow turnip": "لفت سويدي (الجذر الأصفر الكبير لنبات اللفت السويدي المستخدم كغذاء)",
 "yellow twining snapdragon": "أنف العجل الأصفر المتسلق (نبات من جنوب غرب الولايات المتحدة بزهور صفراء على سيقان تلتف وتتسلق عبر النباتات الأخرى)",
 "yellow vetchling": "بازلاء المروج, بيقية شائعة (بازلاء برية أوراسية معمرة متسلقة لها زهور مصفرة وقرون بذور مضغوطة؛ تزرع للعلف)",
 "yellow warbler": "هازجة صفراء (هازجة غابات أمريكية صفراء الحنجرة)",
 "yellow water flag": "سوسن أصفر, سوسن الماء الأصفر (سوسن أصفر الأزهار شائع في أوروبا وشمال أفريقيا، توطن في الولايات المتحدة ويزرع غالباً)",
 "yellow water lily": "زنبق الماء الأصفر, نوفار أصفر (زنبق ماء ذو أزهار صفراء)",
 "yellow watercress": "جرجير أصفر, رشاد المستنقعات (رشاد سنوي أو ثنائي الحول ينمو في الأماكن الرطبة يستخدم أحياناً في السلطات أو كعشبة طهي؛ عشبة ضارة مزعجة في بعض المناطق)",
 "yellow woman": "امرأة صفراء (مصطلح مهين لامرأة آسيوية)",
 "yellow-banded": "ذُو أَشْرِطَة صَفْرَاء (عليه أشرطة صفراء اللون)",
 "yellow-beige": "بِيج مُصْفَرّ (بيج مع مسحة صفراء)",
 "yellow-bellied": "رَعْدِيد, هَيَّاب (سَرِيع الخَوْف وسَهْل الإِفْزَاع)",
 "yellow-bellied sapsucker": "نقار الخشب مصاص العصارة أصفر البطن (نقار خشب مصاص للعصارة من شرق أمريكا الشمالية ذو بطن أصفر شاحب)",
 "yellow-bellied terrapin": "سلحفاة منزلقة (سلحفاة مياه عذبة من الولايات المتحدة وأمريكا الجنوبية؛ تُربى تجارياً بشكل متكرر؛ يُباع بعض صغارها كحيوانات أليفة)",
 "yellow-blindness": "عمى الأصفر (شكل من أشكال عمى الألوان الثنائي يتميز بانخفاض الحساسية للضوء الأصفر؛ وهو نادر جدًا لدرجة أن وجوده كان موضع تساؤل)",
 "yellow-blue color blindness": "عمى الألوان الأصفر والأزرق (الخلط بين اللونين الأصفر والأزرق)",
 "yellow-blue dichromacy": "عمى الألوان الأصفر والأزرق (الخلط بين اللونين الأصفر والأزرق)",
 "yellow-breasted bunting": "درسة صفراء الصدر (شائع في روسيا وسيبيريا)",
 "yellow-breasted chat": "دجال أصفر الصدر (طائر مغرد أمريكي يشتهر بتقليد أغاني الطيور الأخرى)",
 "yellow-browed warbler": "نقشارة صفراء الحاجب",
 "yellow-brown": "أَصْفَر بُنِّيّ, كَهْرَمَانِيّ (ذو لون أصفر بنّيّ متوسّط إلى داكن)",
 "yellow-crowned night heron": "بلشون الليل أصفر التاج (بلشون ليلي من أمريكا الشمالية)",
 "yellow-dog contract": "عقد الكلب الأصفر (عقد عمل (غير قانوني الآن) يوافق بموجبه الموظف على عدم الانضمام إلى نقابة عمالية)",
 "yellow-eyed grass": "أزهار الزيريس, عشب أصفر العين (أي من النباتات الشبيهة بالأسل المتعددة، خاصة في أراضي الصنوبر الجرداء في جنوب الولايات المتحدة)",
 "yellow-fever mosquito": "بَعُوضَة مِصْرِيَّة",
 "yellow-gray": "رَمَادِيّ مُصْفَرّ (رمادي مع مسحة صفراء)",
 "yellow-green": "أَخْضَر مُصْفَرّ (بلون متوسط بين الأصفر والأخضر)",
 "yellow-green algae": "طحالب صفراء خضراء (أي طحلب من قسم الطحالب الذهبية يحجب صبغة صفراء الكلوروفيل الخاص به)",
 "yellow-grey": "رَمَادِيّ مُصْفَرّ (رمادي مع مسحة صفراء)",
 "yellow-leaf sickle pine": "صنوبر منجلي أصفر الأوراق (شجرة أو شجيرة غابات مطيرة في كاليدونيا الجديدة ذات تاج مخروطي وأوراق منجلية خضراء شاحبة؛ نوع مضيف لطفيل الطقسوس النادر)",
 "yellow-marked": "ذُو عَلَامَات صَفْرَاء (عليه علامات صفراء)",
 "yellow-orange": "بُرْتُقَالِيّ مُصْفَرّ (برتقالي مع مسحة صفراء)",
 "yellow-shafted flicker": "نقار الخشب أصفر العمود (نقار خشب كبير من شرق أمريكا الشمالية ذو رقبة حمراء وسطح سفلي أصفر للأجنحة والذيل)",
 "yellow-spotted": "ذُو بُقَع صَفْرَاء (عليه بقع صفراء اللون)",
