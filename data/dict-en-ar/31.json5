 "zirconium oxide": "أكسيد الزركونيوم, ثاني أكسيد الزركونيوم (أكسيد بلوري أبيض؛ يستخدم في الحراريات والعزل والمواد الكاشطة والمينا والزجاج)",
 "zirconium silicate": "زركون, سيليكات الزركونيوم (معدن شائع يوجد في بلورات صغيرة؛ المصدر الرئيسي للزركونيوم؛ يستخدم كمادة مقاومة للحرارة عندما يكون معتماً وكحجر كريم عندما يكون شفافاً)",
 "zit": "بثرة, حبة (ارتفاع ملتهب صغير في الجلد؛ بثرة أو حطاطة؛ عرض شائع في حب الشباب)",
 "zither": "آلة الزيثر, آلة القانون (آلة موسيقية وترية ذات أوتار مشدودة فوق لوحة صوت مسطحة؛ توضع بشكل مسطح وتُعزف بريشة وبالأصابع)",
 "zithern": "آلة الزيثر, آلة القانون (آلة موسيقية وترية ذات أوتار مشدودة فوق لوحة صوت مسطحة؛ توضع بشكل مسطح وتُعزف بريشة وبالأصابع)",
 "zithromax": "أزيثروميسين, زيثروماكس (دواء مضاد للبكتيريا جهازي (الاسم التجاري زيثروماكس) يوصف لعلاج الالتهابات البكتيرية في أجزاء مختلفة من الجسم)",
 "ziti": "زيتي (مكرونة أنبوبية متوسطة الحجم في قطع قصيرة)",
 "zizania aquatica": "أرز بري (عشبة مائية معمرة في أمريكا الشمالية تحمل حبوباً تستخدم للغذاء)",
 "ziziphus jujuba": "سدر, عناب (شجرة شائكة ذات ثمار حمراء داكنة صالحة للأكل)",
 "ziziphus lotus": "سدر اللوتس, شجرة اللوتس (شجرة نفضية شجيرية من منطقة البحر الأبيض المتوسط)",
 "zizz": "غفوة (قيلولة قصيرة) / أزيز (صوت طنين أو أزيز)\nمثال: آرثر يأخذ غفوة قصيرة",
 "zloty": "زْلوتِي, زْووتِي",
 "zmiyovka": "زميفكا",
 "zn": "خارصين, زنك (عنصر فلزي لامع أبيض مزرق؛ هش في درجات الحرارة العادية ولكنه قابل للطرق عند تسخينه)",
 "znco3": "كربونات الزنك",
 "zoanthropy": "قطرب, وهم التحول لحيوان (الوهم بأنك اتخذت شكل حيوان)",
 "zoarces viviparus": "إيل بوت ولود (إيل بوت من شمال أوروبا يلد صغاراً أحياء)",
 "zoarium": "زواريوم, مستعمرة حيوانية (مستعمرة من الحيوانات المجهرية (الزويدات))",
 "zocor": "زوكور, سيمفاستاتين (دواء فموي خافض للدهون (الاسم التجاري زوكور) يعطى لتقليل مستويات الكوليسترول في الدم؛ يوصى به بعد النوبات القلبية)",
 "zodiac": "أَبْرَاجُ السَّمَاء",
 "zodiac sign": "بُرْج (ظهر وارتفع)\nمثال: وصل كارل إلى برج آخر.",
 "zodiacal": "فَلَكِيّ, خَاصّ بِالأَبْرَاج الفَلَكِيَّة",
 "zodiacal light": "اَلْفَجْر اَلْكَاذِب",
 "zoftig": "فَاتِنَة القَوَام, مُمْتَلِئَة الجِسْم ((عَنْ جِسْم المَرْأَة) مُمْتَلِئَة بِصِحَّة وَحَيَوِيَّة)",
 "zoic": "حيواني (متعلق بالحيوانات أو الحياة الحيوانية أو الفعل الحيواني)",
 "zolaesque": "زولائي (على طريقة إميل زولا)",
 "zollinger-ellison syndrome": "متلازمة زولينجر إليسون (متلازمة تتكون من تقرحات هضمية مستعصية مع فرط إفراز المعدة وفرط الحموضة)",
 "zoloft": "زولوفت, سيرترالين (مثبط استرداد السيروتونين الانتقائي يوصف عادة كمضاد للاكتئاب (الاسم التجاري زولوفت))",
 "zombi": "زومبي (عدة أنواع من الرم مع عصير الفاكهة وعادة ليكير المشمش) / إِمَّعَة, زُومْبِي (شخص يتصرف أو يستجيب بطريقة ميكانيكية أو بلا مبالاة) / زومبي, ميت حي (جسد ميت أعيدت إليه الحياة بواسطة قوة خارقة للطبيعة) / إله الثعبان, زومبي (إله في طوائف الفودو ذات الأصل الأفريقي، يُعبد خاصة في جزر الهند الغربية)\nمثال: وحده الإمعة لم يكن ليلاحظ",
 "zombi spirit": "زومبي ((الفودو) روح أو قوة خارقة تعيد إحياء جثة ميتة)",
 "zombie": "زُومْبِي, المَيِّت الحَيّ",
 "zombie spirit": "زومبي ((الفودو) روح أو قوة خارقة تعيد إحياء جثة ميتة)",
 "zona": "حزام, منطقة ((في التشريح) أي بنية مطوقة أو تشبه الحزام)",
 "zona pellucida": "منطقة شفافة (غشاء سميك حول بويضة الثدييات؛ يمكن اختراقه بواسطة حيوان منوي واحد في عملية الإخصاب؛ يبقى عادة حول البويضة المخصبة حتى يتم زرعها في جدار الرحم)",
 "zonal": "منطقي, نطاقي (مرتبط بـ أو مقسم إلى مناطق) / منطقي, نطاقي (متعلق بـ أو من طبيعة المنطقة أو النطاق)\nمثال: نمط نطاقي لهيكل الخلية",
 "zonal pelargonium": "غرنوقي الحدائق, لقلقي منطق (غرنوقي منتصب له أوراق صدفيّة ذات منطقة ملونة عريضة داخل الحافة وزهور بيضاء أو وردية أو حمراء)",
 "zonary": "منطقي, نطاقي (متعلق بـ أو من طبيعة المنطقة أو النطاق)\nمثال: الحدود النطاقية",
 "zone": "نِطَاق, مِنْطَقَة (الحزام المصنوع من القماش ليس له إبزيم ولا ما أشبه؛ قطعة من القماش تُلفّ على وسط الإنسان. الجمع نُطُق؛ في : هو جزء الدائرة كسطح (ليس قوس)؛ يقال أيضا قطاع. الجمع نطاقات) / يسهو\nمثال: هل تمثل الزراعة على نطاق واسع النظام البيئي في الجزائر؟",
 "zone fire": "نيران المنطقة (نيران مدفعية أو هاون يتم إطلاقها في اتجاه ثابت عند عدة ارتفاعات ربعية)",
 "zone of interior": "المنطقة الداخلية (جزء من مسرح الحرب غير مشمول في مسرح العمليات)",
 "zonguldak": "زونغولداق",
 "zoning": "تقسيم المناطق (تقسيم المنطقة إلى مناطق أو أقسام مخصصة لأغراض مختلفة مثل السكن والأعمال والتصنيع وغيرها)",
 "zoning board": "مجلس تقسيم المناطق (مجلس من المسؤولين الذين يقسمون منطقة إلى مناطق تخضع لقيود مختلفة)",
 "zoning change fee": "رسم إعادة التنظيم, رسم تغيير المناطق (رسم لمرة واحدة تفرضه المقاطعة عادةً لطلب إعادة تنظيم الممتلكات (تغيير الغرض من استخدام الأرض))",
 "zoning commission": "لجنة تقسيم المناطق (لجنة مفوضة للإشراف على تقسيم المناطق للاستخدام السكني أو التجاري)",
 "zonked": "مُرْهَق لِلْغَايَة / نَائِماً بِعُمْق",
 "zonotrichia albicollis": "عصفور أبيض الحنجرة (عصفور شائع في أمريكا الشمالية بقعة بيضاء على الحنجرة وتاج مخطط بالأبيض والأسود)",
 "zonotrichia leucophrys": "عصفور أبيض التاج (عصفور ذو تاج مخطط بالأبيض والأسود)",
 "zonula": "منطقة صغيرة, نطيقة (منطقة صغيرة تشبه الحزام)",
 "zonule": "منطقة صغيرة, نطيقة (منطقة صغيرة تشبه الحزام)",
 "zoo": "حَدِيقَة الْحَيَوَان, حَدِيقَة حَيَوَان (الحَديقَةُ، الرَّوْضَةُ ذاتُ الشجرِ؛ حديقة , العاطل عن العمل في اللهجة العراقية وأصل تولد المعنى أن بعض العاطلين يقضون أوقاتهم في العناية بحدائق بيوتهم, فإذا سألهم سائل عن عملهم, ما هو؟…)\nمثال: ليس لدينا حديقة.",
 "zoo keeper": "حارِس حَدِيقَة الحَيَوان (الشخص المسؤول الرئيسي عن العناية بالحيوانات في حديقة الحيوان)",
 "zooecdysone": "زوإيكديسون (يشير المصطلح إلى هرمونات الانسلاخ لدى الحشرات)",
 "zooerastia": "بهيمية, مواقعة الحيوان (نشاط جنسي بين شخص وحيوان)",
 "zooerasty": "بهيمية, مواقعة الحيوان (نشاط جنسي بين شخص وحيوان)",
 "zooflagellate": "سوطي حيواني (أوالي سوطي يفتقر إلى التمثيل الضوئي وخصائص النباتات الأخرى)",
 "zooid": "حييوان, فرد مستعمرة (أحد الأفراد المتميزين الذين يشكلون حيواناً مستعمراً مثل الحيوانات الطحلبية أو الهيدرية)",
 "zoolatry": "عبادة الحيوان (عبادة الحيوانات)",
 "zoological": "حيواني (متعلق بالحيوانات أو المجموعات الحيوانية) / حيواني, متعلق بعلم الحيوان (متعلق بدراسة الحيوانات وتصنيفها وخصائصها)\nمثال: حديقة حيوان",
 "zoological garden": "حَدِيقَة الْحَيَوَان (الحَديقَةُ، الرَّوْضَةُ ذاتُ الشجرِ؛ حديقة , العاطل عن العمل في اللهجة العراقية وأصل تولد المعنى أن بعض العاطلين يقضون أوقاتهم في العناية بحدائق بيوتهم, فإذا سألهم سائل عن عملهم, ما هو؟…)\nمثال: ليس لدينا حديقة.",
 "zoological science": "علم الحيوان (فرع علم الأحياء الذي يدرس الحيوانات)",
 "zoologist": "عالم حيوان (متخصص في فرع الأحياء الذي يتعامل مع الحيوانات)",
 "zoology": "عِلْم اَلْحَيَوَان (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "zoom": "كَبَّرَ, قَرَّبَ (قَوْلُ 'الله أكْبَر'؛ أَحَدَ أَرْكَان الصَلاَة: كَبَّرَ المُصَلِّي)\nمثال: ما مدى كبر المسافة بين هنا وهناك؟",
 "zoom lens": "عدسة زوم, عدسة مقربة (عدسة كاميرا تقوم بتكبير الصورة)",
 "zoomastigote": "سوطي حيواني (أوالي سوطي يفتقر إلى التمثيل الضوئي وخصائص النباتات الأخرى)",
 "zoomorphism": "تشبيه بالحيوان (إضفاء أشكال أو صفات حيوانية على إله)",
 "zoonosis": "مرض حيواني المنشأ (مرض حيواني يمكن أن ينتقل إلى البشر)",
 "zoonotic": "حيواني المنشأ (من أو متعلق بـ أو يشكل مرضاً حيواني المنشأ)\nمثال: يعتقد أن فيروس إيبولا حيواني المنشأ",
 "zoonotic disease": "مرض حيواني المنشأ (مرض حيواني يمكن أن ينتقل إلى البشر)",
 "zoophagous": "آكِل لُحُوم, لَحُوم المُفْتَرِس ((عَنِ الحَيَوَانَات) يَتَغَذَّى عَلَى اللُّحُوم)",
 "zoophagy": "أكل اللحوم (صفة كون الحيوان يأكل اللحوم كجزء رئيسي من نظامه الغذائي)",
 "zoophilia": "بهيمية, ولع بالحيوانات (الانجذاب الجنسي للحيوانات)",
 "zoophilism": "بهيمية, ولع بالحيوانات (الانجذاب الجنسي للحيوانات)",
 "zoophobia": "رهاب الحيوان",
 "zoophyte": "حيوان نباتي (أي من الحيوانات اللافقارية المختلفة التي تشبه النبات مثل شقائق النعمان البحرية أو المرجان أو الإسفنج)",
 "zooplankton": "عوالق حيوانية (المكون الحيواني للعوالق؛ بشكل رئيسي القشريات الصغيرة ويرقات الأسماك)",
 "zoopsia": "رؤية الحيوانات, هلع حيواني (هلوسة بصرية لرؤية حيوانات؛ تحدث أحياناً في الهذيان الارتعاشي)",
 "zoospore": "بوغ حيواني, بوغ متحرك (بوغ لاجنسي لبعض الطحالب والفطريات يتحرك بواسطة الأسواط)",
 "zoot suit": "بدلة زوت (بدلة مبهرجة ذات قصة متطرفة)",
 "zootoxin": "ذيفان حيواني, سم حيواني (ذيفان يشبه الذيفانات البكتيرية في خصائصه المستضدية ويوجد في سوائل حيوانات معينة)",
 "zori": "زوري (صندل يثبت في القدم بواسطة شريط فوق الأصابع)",
 "zoril": "زوريل (ابن عرس يعيش في شمال أفريقيا)",
 "zoroaster": "زَرَادُشْت, زَرَادَشْت",
 "zoroastrian": "زَرَادُشْتِيّ, زَرَادَشْتِيّ",
 "zoroastrianism": "زرادشتِيَّة",
 "zorro": "زُورُو",
 "zoster": "حزام ناري, هربس نطاقي (طفح جلدي على طول مسار العصب غالبًا ما يكون مصحوبًا بألم عصبي شديد)",
 "zostera marina": "حشيشة البحر, زوستيرا (نبات بحري مغمور بأوراق ضيقة طويلة جداً يوجد بكثرة على طول سواحل شمال الأطلسي)",
 "zouave": "الزواف",
 "zovirax": "آسيكلوفير, زوفيراكس (دواء مضاد للفيروسات يؤخذ عن طريق الفم (الاسم التجاري زوفيراكس) يستخدم لعلاج الهربس التناسلي؛ لا يشفي المرض ولكنه يخفف الأعراض)",
 "zoysia": "زويسيا (أي من عدة أعشاب زاحفة من جنس زويسيا)",
 "zoysia japonica": "عشبة المروج الكورية, عشبة المروج اليابانية (عشبة مروج شائعة في الصين واليابان؛ تزرع أيضاً في الولايات المتحدة)",
 "zoysia matrella": "عشبة السجاد اليابانية, عشبة مانيلا (عشبة مروج شائعة في الفلبين؛ تزرع أيضاً في الولايات المتحدة)",
 "zoysia tenuifolia": "عشبة ماسكارين, عشبة مخملية كورية (عشبة معمرة زاحفة آسيوية؛ أدخلت في جنوب الولايات المتحدة كعشبة مروج مقاومة للجفاف)",
 "zr": "زركونيوم (عنصر فلزي قوي رمادي لامع يشبه التيتانيوم؛ يستخدم في المفاعلات النووية كممتص للنيوترونات)",
 "zubeneschamali": "اَلزُّبَانَى اَلشَّمَالِيّ",
 "zucchini": "كوسا (قرع صغير يشبه الخيار؛ عادة ما يكون أخضر داكن) / قرع كوسا, كوسا (نبات قرع تؤكل ثماره عندما تكون صغيرة)",
 "zulu": "الزولو (لغة بانتو ذات أهمية أدبية كبيرة في جنوب شرق أفريقيا) / زُولُو (عضو في شعب يعيش في شرق جنوب أفريقيا)",
 "zulu language": "الزولو (لغة بانتو ذات أهمية أدبية كبيرة في جنوب شرق أفريقيا)",
 "zumbooruck": "زنبورك, مدفعية الجمال (سلاح فرسان الجمال استخدم في العصر الحديث المبكر من قبل الجيوش العربية والأفغانية والفارسية والهندية)",
 "zumbooruk": "زنبورك, مدفعية الجمال (سلاح فرسان الجمال استخدم في العصر الحديث المبكر من قبل الجيوش العربية والأفغانية والفارسية والهندية)",
 "zuni": "زوني (فرد من شعب بويبلو يعيش في غرب نيو مكسيكو)",
 "zurich": "زْيُورِخ",
 "zurvanism": "زروانية (عقيدة زرادشتية هرطقية ترى أن زروان كان المصدر النهائي للكون وأن كل من أهورا مازدا وأهريمان كانا من نسل زروان) / الزرفانية (طائفة زرادشتية تدعي أن زرفان كان المصدر النهائي للكون)",
 "zwieback": "بسكويت محمص, بقسماط (شريحة من الخبز المخمر الحلو تخبز مرة ثانية حتى تصبح بنية وصلبة ومقرمشة)",
 "zwitterion": "أيون مزدوج",
 "zwj": "وَاصِل صِفْر اَلْعَرْض",
 "zwnj": "فَاصِل صِفْر الْعَرْض",
 "zydeco": "زايديكو",
 "zygion": "وُجَيْنَى",
 "zygocactus truncatus": "صبار السلطعون, صبار عيد الشكر (صبار مفصلي من أمريكا الجنوبية ذو أزهار حمراء عادة؛ غالباً ما يزرع كنبات منزلي)",
 "zygodactyl": "متقابلة الأصابع ((لأقدام الطيور) وجود أصابع القدم الأول والرابع موجهة للخلف والثاني والثالث للأمام)",
 "zygodactyl foot": "قدم مزدوجة الأصابع (قدم طائر يكون فيها الإصبع الأول والرابع متجهين للخلف والثاني والثالث للأمام)",
 "zygoma": "قوس وجنية (القوس النحيل الذي يشكله الناتئ الصدغي لعظم الوجنة والذي يمتد إلى الناتئ الوجني للعظم الصدغي)",
 "zygomatic": "وجني (من أو متعلق بمنطقة الخد في الوجه) / عظم الخد, عظم وجني (قوس العظم تحت العين الذي يشكل بروز الخد)",
 "zygomatic arch": "قوس وجنية (القوس النحيل الذي يشكله الناتئ الصدغي لعظم الوجنة والذي يمتد إلى الناتئ الوجني للعظم الصدغي)",
 "zygomatic bone": "عظم الخد, عظم وجني (قوس العظم تحت العين الذي يشكل بروز الخد)",
 "zygomatic process": "نتوء وجني (نتوء رفيع للعظم الصدغي يقوي القوس الوجنية)",
 "zygomorphic": "جانبي التناظر (قابل للانقسام إلى نصفين متماثلين بواسطة مستوى طولي واحد فقط يمر عبر المحور)",
 "zygomorphous": "جانبي التناظر (قابل للانقسام إلى نصفين متماثلين بواسطة مستوى طولي واحد فقط يمر عبر المحور)",
 "zygophyllum fabago": "زيجوفيلوم, قبار الفول (شجيرة معمرة من منطقة شرق البحر الأبيض المتوسط وجنوب غرب آسيا لها زهور تستخدم براعمها كالقبار)",
 "zygospore": "بوغ اقتراني, بوغ زيجوتي (بوغ نباتي يتكون من خليتين جنسيتين متشابهتين)",
 "zygote": "زىجوت",
 "zygotene": "الطور الازدواجي (المرحلة الثانية من الطور التمهيدي للانقسام المنصف)",
 "zygotic": "زيجوتي, لاقحي (متعلق بالزيجوت (اللاقحة))"
}
