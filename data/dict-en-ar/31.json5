 "waterskin": "قِرْبَة",
 "waterspout": "تِنِّين",
 "watertight": "رَاسِخ, مَنِيع (خَالٍ مِنَ الثَّغَرَاتِ أَوِ العُيُوب) / مَانِع لِلْمَاء (لا يسمح بمرور الماء دخولاً أو خروجاً)",
 "watertightness": "كَتَامَة لِلْمَاء, مُقَاوَمَة المَاء (حالة الصنع المحكم لدرجة تمنع دخول أو خروج الماء)",
 "watertube": "أنبوب مياه (أنبوب مرجل يتدفق الماء من خلاله)",
 "waterway": "مَمَرّ مَائِيّ (على مَمَرّ العصور: على طولها ومداها؛ على مَمَرّ الفصول: على تواليها وتعاقبها)\nمثال: الباب في نهاية الممر.",
 "waterweed": "إلوديا, عشبة الماء",
 "waterwheel": "توربين مائي, عجلة مائية (عجلة تدور بفعل التأثير المباشر للماء؛ توربين بسيط) / ساقية, عجلة مائية (عجلة ذات دلاء متصلة بحافتها؛ ترفع الماء من تيار مائي أو بركة)",
 "waterwheel plant": "الدرواندة, نبات طاحونة الماء (نبات مائي آكل للحوم معمر وطافٍ من وسط وجنوب أوروبا وإفريقيا وآسيا وأستراليا، له دوارات من 6 إلى 9 أوراق تنتهي بفصوص مفصلية لاصطياد براغيث الماء مثلاً)",
 "waterwoman": "مراكبية (امرأة تقود أو تركب قارباً)",
 "waterworks": "كُلْوَة, كُلْيَة",
 "waterworn": "مَنْحُوتٌ بِالمَاءِ ((لِلصُّخُورِ خَاصَّةً) مُمَلَّسٌ بِفِعْلِ المَاءِ)",
 "watery": "رَقِيق, مَائِيّ (مُخَفَّف أَكْثَر مِنَ اللَّازِم؛ ضَعِيف وَبِلَا طَعْم) / مَائِيّ (متعلّق بالماء أو شبيه به أو مؤلَّف منه) / دَامِع, رَاشِح (مبلَّل بإفرازات رطبة كالعَرَق أو الدموع) / مَمْلُوء بِالْمَاء (مملوء بالماء)",
 "watery-eyed": "دَامِع العَيْنَيْن (عيناه مليئتان بالدموع)",
 "wats": "خدمة الهاتف واسعة النطاق (خط هاتف؛ خدمة للمسافات الطويلة بأسعار ثابتة لمناطق محددة)",
 "wats line": "خدمة الهاتف واسعة النطاق (خط هاتف؛ خدمة للمسافات الطويلة بأسعار ثابتة لمناطق محددة)",
 "watson": "واتسون",
 "watt": "وَاط",
 "watt second": "جول, واط ثانية (وحدة للطاقة الكهربائية تساوي الشغل المبذول عندما يمر تيار مقداره أمبير واحد عبر مقاومة مقدارها أوم واحد لمدة ثانية واحدة)",
 "watt-hour": "واط ساعي (وحدة طاقة تساوي قدرة واط واحد تعمل لمدة ساعة واحدة)",
 "wattage": "استطاعة كهربائية, قدرة كهربائية (حاصل ضرب الجهد في التيار)",
 "wattle": "تعريشة, سياج أغصان (هيكل يتكون من أوتاد متشابكة مع الفروع لتشكيل سياج) / دالية, لغد (طية جلدية لحمية مجعدة وغالباً ما تكون زاهية الألوان تتدلى من عنق أو حلق بعض الطيور (الدجاج والديك الرومي) أو السحالي) / أكاسيا, سنط (أي من الأشجار الأسترالية المتنوعة التي تنتج أعمدة رفيعة مناسبة للسياج المضفر)",
 "wattle and daub": "أغصان وطين (مادة بناء تتكون من قضبان وأغصان متداخلة مغطاة بالطين)",
 "wattmeter": "مقياس الواط, واطميتر (أداة لقياس تدفق الطاقة الكهربائية في دائرة كهربائية بوحدة الواط)",
 "watusi": "تُوتْسِي (عضو في شعب يتحدث البانتو يعيش في رواندا وبوروندي)",
 "watutsi": "تُوتْسِي (عضو في شعب يتحدث البانتو يعيش في رواندا وبوروندي)",
 "wau": "وَاو",
 "wave": "لَوَّحَ, رَفْرَفَ / مَوْج, مَوْجَة",
 "wave angle": "زاوية الموجة (زاوية وصول (أو مغادرة) موجة الراديو بالنسبة لمحور مصفوفة الهوائي)",
 "wave equation": "معادلة موجية (معادلة تفاضلية تصف مرور الموجات التوافقية عبر وسط ما)",
 "wave form": "شكل الموجة (شكل الموجة موضحاً بيانياً برسم قيم الكمية الدورية مقابل الوقت)",
 "wave front": "جبهة الموجة ((في الفيزياء) سطح وهمي يربط بين جميع النقاط في الفضاء التي تصل إليها موجة تنتشر عبر وسط في نفس اللحظة) / جبهة الموجة (جميع النقاط التي وصلتها الموجة للتو أثناء انتشارها)",
 "wave guide": "موجه موجي (موصل معدني مجوف يوفر مساراً لتوجيه الموجات الدقيقة؛ يستخدم في الرادار)",
 "wave mechanics": "ميكانيكا الموجات (الشكل الحديث لنظرية الكم؛ امتداد لميكانيكا الكم بناءً على معادلة شرودنغر)",
 "wave number": "عَدَد مَوْجِيّ (مقلوب الطول الموجي للموجة)",
 "wave shape": "شكل الموجة (شكل الموجة موضحاً بيانياً برسم قيم الكمية الدورية مقابل الوقت)",
 "wave theory": "نظرية موجية ((فيزياء) النظرية القائلة بأن الضوء ينتقل كموجات)",
 "wave theory of light": "نظرية موجية ((فيزياء) النظرية القائلة بأن الضوء ينتقل كموجات)",
 "wave train": "قطار أمواج (تتابع من الأمواج المتباعدة بفترات منتظمة)",
 "wave-off": "إلغاء الهبوط, تجاوز الهدف (اقتراب يفشل ويفسح المجال لمحاولة أخرى)",
 "wave-particle duality": "ازدواجية, ازدواجية الموجة والجسيم ((فيزياء) خاصية المادة والإشعاع الكهرومغناطيسي التي تتميز بحقيقة أن بعض الخصائص يمكن تفسيرها بشكل أفضل بنظرية الموجة والبعض الآخر بنظرية الجسيمات)",
 "waveband": "حزمة موجية, نطاق التردد (نطاق من الترددات الراديوية المتجاورة (مثل تلك المخصصة لنقل إشارات الراديو أو التلفزيون))",
 "waveform": "شَكْل مَوْجِيّ ((شَكَلَ) الأمْرُ يَشْكُلُ شُكُولاً: الْتَبَسَ؛ (شَكَلَ) المريضُ: تماثَلَ)\nمثال: اجلس بشكل مريح.",
 "wavefront": "جبهة الموجة ((في الفيزياء) سطح وهمي يربط بين جميع النقاط في الفضاء التي تصل إليها موجة تنتشر عبر وسط في نفس اللحظة)",
 "wavefunction": "دَالَّة مَوْجِيَّة",
 "waveguide": "موجه موجي (موصل معدني مجوف يوفر مساراً لتوجيه الموجات الدقيقة؛ يستخدم في الرادار)",
 "wavelength": "طُول مَوْج (قُدرة؛ غنى أو فضل)\nمثال: قاس طول السرير.",
 "wavelet": "تموج صغير, مويجة (موجة صغيرة على سطح سائل)",
 "wavelike": "مُتَمَوِّج, مُجَعَّد (غير مستوٍ بسبب وجود تجاعيد أو موجات)",
 "waver": "تمايل, رفرفة (فعل التحرك ذهاباً وإياباً) / تردد, تلكؤ (فعل التوقف بشكل غير مؤكد) / ملوِّح (شخص يتواصل عن طريق التلويح)\nمثال: كان هناك تردد في كلامه",
 "waverer": "متردد (من يتردد (عادة بدافع الخوف))",
 "wavering": "مُتَذَبْذِبٌ, مُتَرَدِّدٌ (غير ثابت في الغرض أو الفعل) / تَذَبْذُب, تَقَلُّب (صفة كون الشيء غير ثابت وخاضع للتغيرات) / تردد, تريث (تردد في الكلام أو العمل)\nمثال: احتفظ بسجل لتقلبات الأسعار",
 "waviness": "تَمَوُّج (عدم استواء ناتج عن موجات أو تجاعيد) / تجعد, تموج ((للشعر) الميل للالتفاف)",
 "waving": "تلويح (فعل الإشارة بحركة اليد)",
 "wavy": "مُتَمَوِّج, مُجَعَّد (غير مستوٍ بسبب وجود تجاعيد أو موجات) / مُمَوَّج ((عَنِ الشَّعْرِ) ذُو تَمَوُّجَاتٍ)",
 "wavy-grained": "مُتَعَرِّج الأَلْيَاف (عن الخشب؛ ذو ألياف تجري بشكل غير منتظم بدلاً من التوازي)",
 "wavy-leaved aster": "أستر متموج الأوراق",
 "waw": "وَاو",
 "wax": "شَمْع, شَمَع ((شَمَعَ) يَشْمُعُ شَمْعًا، وشُمُوعًا: مَزَحَ وطَرِبَ)\nمثال: أشعل كين الشمع.",
 "wax bean": "فاصولياء شمعية, فاصولياء صفراء (فاصولياء ذات قرون صفراء) / فاصولياء شمعية (نبات فاصولياء شائع يزرع لقرنه الذهبي الصالح للأكل)",
 "wax begonia": "بيغونيا شمعية (بيغونيا هجينة ليفية الجذور لها أوراق عريضة بيضاوية خضراء إلى برونزية حمراء وعناقيد صغيرة من الزهور البيضاء أو الوردية أو الحمراء؛ تستخدم على نطاق…)",
 "wax crayon": "قلم تلوين شمعي, قلم شمع (أداة كتابة تتكون من عصا ملونة من الشمع المركب تستخدم للكتابة والرسم)",
 "wax figure": "تمثال شمع (تمثال (عادة لشخص مشهور) مصنوع من الشمع)",
 "wax insect": "حشرة الشمع (أي من حشرات متنوعة تفرز مادة شمعية)",
 "wax light": "شمعة (عصا من الشمع بداخلها فتيل في المنتصف)",
 "wax mallow": "خبازة شمعية, خطمي نائم (أي من نباتات مختلفة من جنس مالفافيسكوس لها زهور لامعة جرسية الشكل متدلية تشبه زهور الخطمي غير المتفتحة تماماً)",
 "wax moth": "عثة الشمع, عثة النحل (عثة تعيش يرقاتها وتتغذى في أقراص عسل النحل)",
 "wax museum": "مَتْحَف شَمْع (مكان تُجمع وتُعْرَض فيه الآثار التاريخيَّة أو الفنيَّة أو العِلْميَّة وغيرها)\nمثال: عاد إلى المتحف.",
 "wax myrtle": "آس شمعي (نوع نباتي من جنس الآس من الفَصِيلَة الآسيّة. وهو شجر دائم الخُضْرَة، بيضيّ الورق، أبيض الزَّهْر أو ورديُّه، يُزرع للتزيين ولرائحته العِطْريّة…؛ ورقة من أوراق اللعب ذات نقطة أو علامة واحدة)\nمثال: لدي الآس الكوبا.",
 "wax palm": "نخيل الشمع (نخيل من جبال الأنديز ينتج شمعاً راتنجياً يخلط مع الشحم لصنع الشموع) / كارنوبا, نخيل الكارنوبا (نخيل مروحي برازيلي له جذر صالح للأكل؛ ومصدر لألياف أوراق مفيدة وشمع مصفر هش) / كارانداي, نخيل كاراندا (نخيل من أمريكا الجنوبية ينتج شمعاً مشابهاً لشمع الكارنوبا)",
 "wax paper": "وَرَق شَمْع, مُهْرَق (ما ينمو على النبات من الأعلى والجوانب بشكل صفائح ذات لون أخضر أو مائل إلى الخضرة. انظر الصورة؛ جلود رقاق يُكتَبُ عليها)\nمثال: هات ورقة بيضاء.",
 "wax plant": "نبات الشمع, هويا (متسلق عصاري من جنوب آسيا مع خيمات من الزهور النجمية الوردية والبيضاء)",
 "wax-chandler": "بائع الشمع (شخص يتاجر في الشموع الشمعية)",
 "waxberry": "توت الشمع, شمعية (شجيرة عطرية نفضية من شرق أمريكا الشمالية بتوت مغطى بالشمع الرمادي الأخضر) / توت الثلج, سيمفوريكاربوس (شجيرة متساقطة الأوراق من غرب أمريكا الشمالية لها سنابل من الأزهار الوردية يليها توت أبيض مستدير)",
 "waxed": "مشمع, مطلي بالشمع (معالج بالشمع)\nمثال: أرضيات مشمعة",
 "waxen": "شَمْعِيّ, كَالشَّمْع (ذو مظهر شاحب أملس يشبه الشمع) / شمعي (مصنوع من الشمع أو مغطى به)\nمثال: شموع شمعية",
 "waxflower": "زهرة الشمع, غليون هندي (نبات غابات رمي صغير شمعي أبيض أو وردي مبيض له أوراق تشبه القشور وزهرة متدلية؛ يتحول إلى الأسود مع التقدم في العمر) / زهرة الشمع / زهرة الشمع, ياسمين مدغشقر (كرمة خشبية ملتفة في مدغشقر ذات أوراق دائمة الخضرة شمعية داكنة سميكة وعناقيد من الزهور البيضاء الشمعية العطرة الكبيرة على طول السيقان؛ تزرع على نطاق…)",
 "waxiness": "شمعية (صفة كون الشيء مصنوعاً من الشمع أو مغطى به)",
 "waxing": "تشميع",
 "waxlike": "شَمْعِيّ, كَالشَّمْع (ذو مظهر شاحب أملس يشبه الشمع)",
 "waxmallow": "خبازة شمعية, خطمي نائم (أي من نباتات مختلفة من جنس مالفافيسكوس لها زهور لامعة جرسية الشكل متدلية تشبه زهور الخطمي غير المتفتحة تماماً)",
 "waxwing": "جناح الشمع (طيور مغردة ذات ريش مخملي بني في نصف الكرة الشمالي لها رؤوس متوجة وأطراف أجنحة شمعية حمراء)",
 "waxwork": "تمثال شمع (تمثال (عادة لشخص مشهور) مصنوع من الشمع) / حلوة مرة أمريكية, سيلاستروس (شجيرة ملتفة في أمريكا الشمالية لها كبسولات صفراء تحيط ببذور قرمزية)",
 "waxy": "شَمْعِيّ, كَالشَّمْع (ذو مظهر شاحب أملس يشبه الشمع) / طَيِّع, قَابِلٌ لِلثَّنْي (يُمْكِنُ ثَنْيُهُ أَوْ لَيُّهُ دُونَ أَنْ يَنْكَسِرَ) / سريع التأثر, طري (سهل التأثر أو الانطباع) / شمعي (مصنوع من الشمع أو مغطى به)\nمثال: شاب سريع التأثر",
 "waxycap": "قبعة شمعية (أي فطر من فصيلة هيجروفوراسيا له خياشيم شمعية المظهر إلى حد ما)",
 "way": "طَرِيق, سَبِيل (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من ٱلشَّارِعِ، سَبِيل)\nمثال: أسأل عن الطريق.",
 "way of life": "حَيَاة, طَرِيقَة فِي حَيَاة (الحَياة: ضد الموت والحَيُّ: ضدُّ الميّت؛ والمَحْيا مَفْعَلٌ من الحياة. تقول: مَحْيَاي ومماتي. والجمع الحَحايي)\nمثال: ما أغرب الحياة!",
 "way out": "مخرج, منفذ (فتحة تسمح بالهروب أو الخروج)\nمثال: أغلق المخرج",
 "way station": "محطة توقف صغيرة (محطة سكة حديد صغيرة بين المحطات الرئيسية أو محطة يتوقف فيها القطار فقط عند الإشارة) / استراحة, محطة توقف (مكان توقف في رحلة)\nمثال: هناك توقف لتغيير الطائرات في شيكاغو",
 "way-out": "غَرِيب, مُثِيرٌ لِلدَّهْشَة ((غير رسمي) غَيْرُ تَقْلِيدِيٍّ بِشَكْلٍ لَافِت)",
 "waybill": "بُولِيصَة شَحْن (إيصال يقدمه الناقل إلى الشاحن يقر فيه باستلام البضائع التي يتم شحنها ويحدد شروط التسليم)",
 "wayfaring": "ارتحال (السفر (خاصة سيراً على الأقدام)) / جَوَّاب, مُسَافِر (يسافر ويتنقّل خاصّة سيرًا على الأقدام)",
 "wayfaring tree": "رباطية لانتانا, شجرة الطريق (شجيرة أوروبية قوية تشبه الشجرة شائعة على جوانب الطرق؛ يتحول توتها الأحمر إلى الأسود)",
 "ways": "مدرج السفن, منزلق السفن (هيكل يتكون من طريق منحدر لأسفل إلى الماء من المكان الذي يتم فيه بناء السفن أو إصلاحها)",
 "ways and means": "طرق ووسائل (الموارد المتاحة لتغطية النفقات (خاصة التشريعات لزيادة الإيرادات للحكومة))",
 "ways and means committee": "لجنة السبل والوسائل (لجنة دائمة في مجلس النواب الأمريكي تقدم توصيات إلى مجلس النواب بشأن جميع مشاريع القوانين التي من شأنها زيادة الإيرادات)",
 "wayside": "جانب الطريق (حافة طريق أو مسار)\nمثال: زهور على جانب الطريق",
 "wayward": "شَارِد, عَنِيد (مقاوم للتوجيه أو الانضباط)",
 "wazukhana": "مُتَوَضَّأٌ",
 "wb": "ويبر (وحدة للتدفق المغناطيسي تساوي 100,000,000 ماكسويل)",
 "wbc": "خلية دم بيضاء, كريّة دم بيضاء (خلايا دم تبتلع وتهضم البكتيريا والفطريات؛ جزء مهم من نظام دفاع الجسم)",
 "wbn": "الغَرْب المَائِل لِلشَّمَال, غَرْب لِشَمَال (نقطة البوصلة التي تقع شمال الغرب بنقطة واحدة)",
