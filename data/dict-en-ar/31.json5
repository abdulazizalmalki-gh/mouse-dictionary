 "zebibyte": "زيبي بايت, زيتابايت (وحدة معلومات تساوي 1024 إكسبي بايت أو 2 أس 70 بايت)",
 "zebra": "حِمَار وَحْشِيّ, حِمَار وَحْشِيّ مُخَطَّط (حَيْوَان مُسْتَأْنَس من الجِنْس الذي ينتمي اليه الحِصَان (انظر الصورة). مؤنثه أَتَان؛ صفة تَحْقِيْر تطلق على الغَبِيّ أو الأَحْمَق. مؤنثه حِمَارَة)\nمثال: هن بحاجة لحمار.",
 "zebra crossing": "مَمَرُّ الرَّاجِلِين (على مَمَرّ العصور: على طولها ومداها؛ على مَمَرّ الفصول: على تواليها وتعاقبها)\nمثال: الباب في نهاية الممر.",
 "zebra dove": "يمامة مخططة",
 "zebra finch": "عصفور الزيبرا (طائر حباك أسترالي صغير ذو علامات تشبه الحمار الوحشي)",
 "zebra mussel": "بلح البحر المخطط (رخوي بطول بوصة تم استيراده عن طريق الخطأ من أوروبا؛ يسد أنابيب المرافق ويتغذى على بلح البحر الصالح للأكل في المياه العذبة)",
 "zebra orchid": "سحلب الحمار الوحشي (سحلب بأوراق خطية محمرة وعنقود من الزهور الصفراء الشاحبة المعلمة بالأرجواني بشفة حمراء عميقة أو أرجوانية؛ جنوب غرب أستراليا)",
 "zebra-tailed lizard": "سحلية حمار الزرد (سحلية سريعة ذات ذيل طويل مخطط بالأسود وأرجل طويلة؛ من صحاري الولايات المتحدة والمكسيك)",
 "zebrawood": "خشب الزيبرا, شجر الزيبرا (أي من الأشجار أو الشجيرات المختلفة التي لها خشب مرقط أو مخطط) / خشب الحمار الوحشي (خشب مخطط أو مبقع بشكل جميل لشجرة خشب الحمار الوحشي؛ يستخدم خاصة للخزائن)",
 "zebrawood tree": "خشب الزيبرا, شجر الزيبرا (أي من الأشجار أو الشجيرات المختلفة التي لها خشب مرقط أو مخطط)",
 "zebu": "بقر الهند, زيبو (ثور مستأنس له سنام على الظهر وقرون طويلة ولبب كبير؛ يستخدم بشكل رئيسي كحيوان جر في الهند وشرق آسيا)",
 "zechariah": "زَكَرِيَّا ((في الإسلام) نبي مذكور في القرآن، وهو والد النبي يحيى؛ (في المسيحية) مذكور في العهد الجديد، وهو والد القدِّيس يُوحَنَّا الْمَعْمَدَان)\nمثال: يحيى وأبوه زكريا نبيان من عند الله.",
 "zedoary": "جَدْوَار",
 "zee": "زِيد, دْزِيتَا ((زَيَّدَ): زاد؛ (زَيَّدَ) الشيء: زاده)\nمثال: خضع زيد لدورة مكثفة",
 "zeeland": "زيلند, زيلاندا",
 "zeitgeist": "رُوحُ الْعَصْر (رَوَّحَ عليه بالمِرْوحَة: حَرَّكَها ليجلبَ إِليه نسيمَ الهواء؛ رَوَّحَ بالقوم: صلَّى بهم التراويح)\nمثال: كان سامي هو روح الحفلة.",
 "zelda": "زِيلْدَا",
 "zelenskyy": "زِيلِينْسْكِي",
 "zemfira": "زمفيرا",
 "zen": "زَن, زِن ((زَنَّ) عصبه زنا: يبس واسترخت مفاصله؛ (زَنَّ) فلانا بخير أو شر زنا: اتهمه به)\nمثال: هل خسرت وزن مؤخرا؟",
 "zen buddhism": "زِن ((زَنَّ) عصبه زنا: يبس واسترخت مفاصله؛ (زَنَّ) فلانا بخير أو شر زنا: اتهمه به)\nمثال: هل خسرت وزن مؤخرا؟",
 "zen buddhist": "بُوذِيّ (زِن) (معتنق لمذاهب بوذية الزن)",
 "zenaidura macroura": "حمامة الحداد (حمامة برية في الولايات المتحدة لها نداء حزين)",
 "zend": "الأفستية (لغة إيرانية قديمة، تستخدم كلغة الكتاب المقدس الزرادشتي)",
 "zend language": "الأفستية (لغة إيرانية قديمة، تستخدم كلغة الكتاب المقدس الزرادشتي)",
 "zenerdiode": "ثنائي زينر, ديود زينر (صمام ثنائي شبه موصل يظهر زيادة حادة في التيار العكسي عند جهد عكسي محدد جيداً: يستخدم كمنظم للجهد)",
 "zenith": "سَمْت, ذُرْوَة ((سَمَتَ) سمتا: حسن سمته؛ (سَمَتَ): سار على الطريق بالظن)\nمثال: سمت ابنتها ماري.",
 "zenithal": "سمتي (متعلق بـ أو يقع عند أو بالقرب من السمت (نقطة الرأس))",
 "zeolite": "زيوليت (أي من عائلة المعادن الزجاجية المشابهة للفلدسبار والتي تحتوي على سيليكات الألومنيوم المائية للكالسيوم أو الصوديوم أو البوتاسيوم؛ تتشكل في تجاويف…)",
 "zeolitic water": "ماء زيوليتي (ماء مدمص بواسطة الزيوليت)",
 "zep": "سابمارين, سندويتش غواصة (شطيرة كبيرة مصنوعة من لفافة خبز طويلة مقسومة طولياً ومحشوة باللحوم والجبن (والطماطم والبصل والخس والتوابل))",
