 "workpiece": "قطعة عمل (عمل يتكون من قطعة معدنية يتم تشكيلها آلياً)",
 "workplace": "مَكَان عَمَل (مَوْضِع؛ المنزلة والشأن، يقال أيضا مكانة)\nمثال: هذا المكان مقدس",
 "workroom": "غرفة عمل, مشغل (غرفة يتم فيها إنجاز العمل)",
 "works": "أعمال, أفعال (أداء الأعمال الأخلاقية أو الدينية) / مصنع, منشأة صناعية (مباني لممارسة العمل الصناعي) / آلية داخلية (الآلية الداخلية لجهاز ما) / الشلة كلها, العدة والعتاد (كل شيء متاح)\nمثال: الخلاص بالأعمال",
 "works council": "مجلس العمال (مجلس يمثل صاحب العمل والموظفين في مصنع أو شركة لمناقشة ظروف العمل وغيرها؛ وأيضًا: لجنة تمثل العمال المنتخبين للتفاوض مع الإدارة بشأن المظالم والأجور…)",
 "works program": "برنامج أشغال عامة (برنامج لتوفير وظائف في الأشغال العامة بتمويل حكومي)",
 "worksheet": "ورقة عمل (ورقة ذات أعمدة متعددة؛ يستخدمها المحاسب لتجميع الأرقام للبيانات المالية) / ورقة عمل (ورقة تسجل العمل المخطط له أو المنجز في مشروع ما)",
 "workshop": "مَشْغَل, وَرْشَة",
 "workspace": "مِسَاحةُ عَمَل",
 "workstation": "مَحَطَّة عَمَل",
 "worktable": "طاولة عمل (طاولة مصممة لمهمة معينة)",
 "workwear": "ملابس عمل (ملابس شديدة التحمل للعمل اليدوي أو البدني)",
 "workweek": "أسبوع, أسبوع العمل (ساعات أو أيام العمل في الأسبوع التقويمي)\nمثال: عملوا أسبوعاً مدته 40 ساعة",
 "workwoman": "امرأة عاملة, عاملة (موظفة أنثى تؤدي عملاً يدوياً أو صناعياً)",
 "world": "عالم (الذي يعلم؛ متخصص في عِلْم ما وباحث فيه) / عَالَم, دُنْيَا (الذي يعلم؛ متخصص في عِلْم ما وباحث فيه)\nمثال: هو عالم أحيائي.",
 "world affairs": "شؤون دولية, شؤون عالمية (الشؤون بين الأمم)\nمثال: لا يمكنك حقاً مواكبة الشؤون العالمية من خلال مشاهدة التلفزيون",
 "world bank": "البنك الدولي, البنك الدولي للإنشاء والتعمير (وكالة تابعة للأمم المتحدة أنشئت لمساعدة الدول النامية بقروض تضمنها الحكومات الأعضاء)",
 "world council": "مجلس عالمي (مجلس يضم ممثلين من دول مختلفة)",
 "world council of churches": "مجلس الكنائس العالمي (منظمة مسكونية للكنائس البروتستانتية والشرقية؛ تهدف إلى تعزيز الوحدة والتعاون في الشؤون الدينية والعلمانية)",
 "world court": "المحكمة العالمية, محكمة العدل الدولية (محكمة أنشئت لتسوية النزاعات بين أعضاء الأمم المتحدة)",
 "world cup": "كَأْس عَالَم, كَأْس الْعَالَم (إناء الشرب إذا كان فيه شراب؛ الشراب الذي في الإناء)\nمثال: هل لي بكأس ماء؟",
 "world exposition": "مَعْرِض عَالَمِيّ",
 "world health organization": "مُنَظَّمَة الصِّحَّة الْعَالَمِيَّة",
 "world map": "خَرِيطَةُ الْعَالَمِ (الخَارِطَة، رسم عليه تضاريس الأرض وحدودها)\nمثال: انظر إلى الخريطة.",
 "world meteorological organization": "المنظمة العالمية للأرصاد الجوية (وكالة الأمم المتحدة المعنية بالجمع الدولي لبيانات الأرصاد الجوية)",
 "world music": "موسيقى العالم (مُوسِيقى، فنُّ تأليف الألحان وتوزيعها وإيقاعها والغناء والتطريب بضروب المعازف؛ علم الموسيقى : علمٌ يُبحَثُ فيه عن أُصَول النغم من حيث تأَتلف أَو تتنافر، وأَحوال الأَزمنة المتخللة بينها، ليُعلَمَ كيف يؤلَّف اللَّحْن)\nمثال: أتعلم الموسيقى.",
 "world order": "نِظَام عَالَمِيّ (مَنْهَج، طَرِيقَة؛ تَرْتِيب واتِّسَاق)\nمثال: ليس بنظام كامل.",
 "world organisation": "منظمة دولية, منظمة عالمية (تحالف دولي يضم العديد من البلدان المختلفة)",
 "world organization": "منظمة دولية, منظمة عالمية (تحالف دولي يضم العديد من البلدان المختلفة)",
 "world power": "قوة عالمية, قوة عظمى (دولة قوية بما يكفي للتأثير على الأحداث في جميع أنحاء العالم)",
 "world premiere": "عرض عالمي أول ((موسيقى) أول عرض عام (لعمل درامي أو موسيقي) في أي مكان في العالم)",
 "world record": "رقم قياسي عالمي (أفضل سجل في العالم كله)",
 "world series": "بطولة العالم للبيسبول, وورلد سيريس (سلسلة تشكل التصفيات النهائية لبطولة البيسبول)\nمثال: شاهدنا بطولة العالم للبيسبول على التلفاز",
 "world trade center": "مَرْكَز اَلتِّجَارَة اَلْعَالَمِيَّة (موضع الاِرْتِكَاز عامة؛ موضع الشخص ومحلّه الذي يبقى فيه عادة)\nمثال: أين أقرب مركز شرطة؟",
 "world trade organization": "مُنَظَّمَة اَلتِّجَارَة اَلْعَالَمِيَّة",
 "world traveler": "جوال, رحالة (شخص يسافر على نطاق واسع وكثيراً)",
 "world view": "رؤية كونية, نظرة للعالم (نظرة شاملة للعالم وللحياة البشرية)",
 "world war": "حَرْب عَالَمِيَّة, الْحَرْب الْعَالَمِيَّة (حَرَبَ (حربه) بالحربة حربا: طعنه بها؛ حَرَبَ (ه) حربا: سلبه جميع ما يملك)\nمثال: بوتين مجرم حرب.",
 "world war i": "اَلْحَرْبُ العَالَمِيَّةُ الْأُولَى",
 "world war ii": "الْحَرْبُ الْعَالَمِيَّةُ الثَّانِيَة",
 "world war iii": "اَلْحَرْبُ اَلْعَالَمِيَّةُ اَلثَّالِثَة",
 "world war iv": "الحرب العالمية الرابعة",
 "world wide web": "شَبَكَة عَنْكَبُوتِيَّة عَالَمِيَّة, نَسِيج عَنْكَبُوتِي عَالَمِي",
 "world-beater": "بطل لا يقهر, متفوق عالمي (منافس يحتل مكانة بارزة ومتفوقة جداً)",
 "world-class": "أَوَّل, مِن الطِّرَاز الأَوَّل (يتصدر جميع الآخرين في الترتيب)",
 "world-shaking": "مُزَلْزِل, هَائِل التَّأْثِير (بالغ الأهمّيّة بما يكفي للتأثير في العالم كلّه)",
 "world-shattering": "مُزَلْزِل, هَائِل التَّأْثِير (بالغ الأهمّيّة بما يكفي للتأثير في العالم كلّه)",
 "world-weariness": "سأم من الحياة (الحزن عند التفكير في شرور العالم)",
 "world-weary": "سَئِمٌ مِنَ الدُّنْيَا, ضَجِر (مُتْعَبٌ مِنَ الحَيَاةِ وَمَا فِيهَا)",
 "world-wide": "عَالَمِيّ, كَوْنِيّ (ذو نطاق أو تطبيق عالميّ شامل) / عَالَمِيّ, فِي جَمِيع أَنْحَاء العَالَم (يمتد أو ينتشر في جميع أنحاء العالم) / كَوْكَبِيّ, كَوْنِيّ (يشمل الأرض بأسرها؛ غير محدود بنطاق إقليمي)",
 "worldliness": "دُنْيَوِيَّة (الانشغال بالشؤون الدنيوية مع إهمال الاحتياجات الروحية) / حنكة, خبرة دنيوية (صفة أو طابع الرقي الفكري والخبرة الدنيوية المكتسبة من خلال الثقافة أو التجربة أو خيبات الأمل)\nمثال: كان يكره دنيوية العديد من الأساقفة من حوله",
 "worldling": "أرضي, من سكان الأرض (أحد سكان الأرض) / دُنْيَوِيّ (شخص مستغرق في هموم ومصالح وملذات العالم الحالي (الدنيا))",
 "worldly": "دُنْيَوِيّ",
 "worldly belongings": "كل ما يملك, متاع الدنيا (جميع الممتلكات التي يحوزها شخص ما)\nمثال: ترك كل ما يملكه في الدنيا لابنته",
 "worldly concern": "دنيا, شأن دنيوي (اهتمامات هذه الحياة بتمييزها عن الآخرة)\nمثال: يعتبرون الكنيسة مستقلة عن العالم",
 "worldly good": "متاع دنيوي, ممتلكات دنيوية (سلعة أو متاع مرتبط بالوجود الدنيوي للبشر بدلاً من الوجود الروحي)",
 "worldly goods": "كل ما يملك, متاع الدنيا (جميع الممتلكات التي يحوزها شخص ما)\nمثال: ترك كل ما يملكه في الدنيا لابنته",
 "worldly possession": "متاع دنيوي, ممتلكات دنيوية (سلعة أو متاع مرتبط بالوجود الدنيوي للبشر بدلاً من الوجود الروحي)",
 "worldly possessions": "كل ما يملك, متاع الدنيا (جميع الممتلكات التي يحوزها شخص ما)\nمثال: ترك كل ما يملكه في الدنيا لابنته",
 "worldly-minded": "مَادِّيّ النَّزْعَةِ, نَفْعِيّ (يَتَّسِمُ بِالنَّزْعَةِ المَادِّيَّةِ)",
 "worldly-wise": "حَكِيمٌ بِطُرُقِ الدُّنْيَا (ذو خبرة ودراية بطرق العالم وأساليبه)",
 "worldview": "رُؤْيَةٌ كَوْنِيَّة, رُؤْيَةُ الْعَالَم",
 "worldwide": "عَالَمِيّ الاِنْتِشَار, عَالَمِيّ",
 "worm": "شَخْص دَنِيء (سواد الإنسان حين يرى من بعيد فلا يُعرَف؛ واحد الإنسان بصورة عامة بدون تحديد لسنه وجنسه وقومه وغير ذلك)\nمثال: هذا الشخص فنان.",
 "worm family": "فصيلة ديدان (فصيلة من الديدان)",
 "worm fence": "سياج متعرج (سياج عوارض يتكون من خط متعرج من القضبان المتشابكة)",
 "worm fish": "سمكة الدودة (فصيلة غير معروفة جيداً من الأسماك الاستوائية الصغيرة في المياه الضحلة مرتبطة بالقوبيون)",
 "worm gear": "ترس دودي (ترس يتكون من عمود ذو لولب (الدودة) يتعشق مع عجلة مسننة (العجلة الدودية)؛ يغير اتجاه محور الحركة الدورانية)",
 "worm genus": "جنس ديدان (جنس من الديدان)",
 "worm lizard": "سحلية دودية (سحلية من جنس أمفيسباينا؛ سحلية غير ضارة تشبه الدودة وعديمة الأطراف من المناطق الدافئة أو الاستوائية لها عيون وآذان مخفية وذيل قصير غير حاد)",
 "worm salamander": "سمندل نحيل (أي من عدة سمندلات نحيلة صغيرة من ساحل المحيط الهادئ للولايات المتحدة)",
 "worm snake": "ثعبان الدودة (ثعبان صغير محمر يشبه الدودة من شرق الولايات المتحدة) / ثعبان أعمى (ثعبان حفار يشبه الدودة من المناطق الدافئة له عيون أثرية)",
 "worm wheel": "عجلة دودية (ترس بأسنان تتوافق مع لولب الدودة)",
 "worm-eaten": "مَسُوس, مُتَأَكِّلٌ بِالدُّودِ (مُصَابٌ أَوْ مُتَضَرِّرٌ بِفِعْلِ الدِّيدَانِ)",
 "worm-shaped": "دُودِيّ الشَّكْل (يُشبه الدودة؛ طويل ورفيع وأسطوانيّ)",
 "wormcast": "أثر دودي متحجر (أثر أحفوري لدودة) / قذفة الدود (كتلة أسطوانية من التراب تفرغها دودة الأرض أو دودة الرمل)",
 "wormhole": "ثَقْب دُودِيّ, مَمَرّ دُودِيّ (فَجَّرَ أو خَرَقَ شيئًا بفتح فيه؛ نَفَذَ أو مرَّ عبر شيء)\nمثال: انه ثقب الاسود.",
 "wormian bone": "عظم درزي (أي من العظام الرخوة الصغيرة الموجودة في الدروز بين عظام القحف)",
 "wormlike": "زَاحِف, مُتَذَلِّل (خَاضِع خُضُوعًا تَامًّا)",
 "wormseed": "دودة البذور الأمريكية, شاي مكسيكي (عشبة الخنازير الاستوائية الأمريكية كريهة الرائحة)",
 "wormseed mustard": "إريسيموم, خردل بذور الدود (خردل أوروبي نحيل أصفر الزهر غالباً ما يكون عشباً ضاراً مزعجاً؛ كان يستخدم سابقاً كطارد للديدان)",
 "wormwood": "حَبَق اَلرَّاعِيّ (الحَبِق : ضراط المَعز ، تقول : حبَقت تحْبِق حَبْقاً وحَبِقاً ، وقد تستعمل في النّاس : حَبَقَ يحبِق حبْقاً وحَبِقاً وحُباقاً؛ الحَبْق : ضُراط المَعِز ، وقد تستعمل في النّاس)",
 "wormwood oil": "زيت الشيح (زيت مر داكن يتم الحصول عليه من أوراق الشيح؛ ينكه مشروبات الأفسنتين)",
 "wormwood sage": "شيح بارد, ميرمية الشيح (نبات معمر عطري حريري الأوراق في المناطق الشمالية الجافة من نصف الكرة الشمالي؛ له زهيرات سمراء)",
 "wormy": "زَاحِف, مُتَذَلِّل (خَاضِع خُضُوعًا تَامًّا) / مَسُوس, مُتَأَكِّلٌ بِالدُّودِ (مُصَابٌ أَوْ مُتَضَرِّرٌ بِفِعْلِ الدِّيدَانِ)",
 "worn": "شَاحِب, مُتْعَبُ المَلَامِح (يُظْهِرُ آثَارَ الإِرْهَاقِ أَوِ الهَمِّ أَوِ المُعَانَاة) / بالٍ, مهترئ (متأثر بالاهتراء؛ تالف بسبب الاستخدام الطويل)\nمثال: خيوط بالية على المسمار",
 "worn spot": "موضع تآكل (بقعة تآكلت بفعل الاحتكاك أو التعرية)",
 "worn-out": "بَالٍ",
 "worried": "قَلِق (شاعر بالقَلَق؛ تَحَرّك/اهتزاز/اضطراب في الوضع الطبيعي للشيء)\nمثال: ليلى قلقة بشأنك.",
 "worriedly": "بقلق (بطريقة قلقة)\nمثال: قالت بقلق: 'أتساءل ماذا أفعل'",
 "worrier": "دائم التوتر, كثير القلق (شخص يفكر دائماً في الأشياء المؤسفة التي قد تحدث)",
 "worriment": "إزعاج, إقلاق (صعوبة تسبب القلق)",
 "worrisome": "غَيْر مُطَمْئِن, مُقْلِق (غير مطمئن؛ يميل إلى إحداث القلق) / مُزْعِج, مُقْلِق (يُسَبِّب القَلَق أو الانْزِعاج أو الكَرْب)",
 "worry": "قَلِقَ (شاعر بالقَلَق؛ تَحَرّك/اهتزاز/اضطراب في الوضع الطبيعي للشيء) / قَلَق (شاعر بالقَلَق؛ تَحَرّك/اهتزاز/اضطراب في الوضع الطبيعي للشيء)\nمثال: ليلى قلقة بشأنك.",
 "worrying": "خلخلة, زعزعة (عملية تحريك شيء ما عن طريق الشد أو الدفع المتكرر) / إلحاح, تنغيص (فعل مضايقة شخص ما) / مُزْعِج, مُقْلِق (يُسَبِّب القَلَق أو الانْزِعاج أو الكَرْب)\nمثال: الزعزعة القوية أدت أخيراً إلى فك المنشار",
 "worryingly": "بشكل مقلق (بطريقة تسبب القلق)",
 "worrywart": "دائم التوتر, كثير القلق (شخص يفكر دائماً في الأشياء المؤسفة التي قد تحدث)",
 "worse": "أَسْوَأ (أَسْوَأُ)\nمثال: أنا أستعد للأسوأ.",
 "worse things happen at sea": "أَسْوَأُ أَمُوْرٍ تَحْدُثُ فِي البَحَر (أَسْوَأُ)\nمثال: أنا أستعد للأسوأ.",
 "worsened": "مُتَدَهْوِر, مُتَرَدٍّ (أصبح أو جُعل أسوأ؛ متضرر) / أَسْوَأ, مُتَدَهْوِر (تغير للأسوأ في الصحة أو اللياقة)\nمثال: أشعر أنني أسوأ اليوم",
 "worsening": "مُتَدَهْوِر, نَحْو الأَسْوَأ (يتغير للأسوأ) / إساءة, تدهور (تغيير شيء ما بحيث يصبح أسوأ) / تدهور, تردي (عملية التغير إلى حالة أدنى)\nمثال: قلق من العاصفة المتدهورة (تزداد سوءاً)",
 "worship": "عِبَادَة / عَبَدَ, سَجَدَ (خلاف الحُرّ، المَمْلُوْك، من له مالك يملكه. الجمع عبيد وأعبد وعِبدان وعُبدان؛ الإنسان حرا كان أم لا مؤمنا كان أن ملحدا من حيث أنه مملوك لله) / سَجَدَ (وَضَعَ جَبْهَتَهُ عَلَى ٱلْأَرْضِ)\nمثال: ماذا أنجز عبد العزيز بوتفليقة؟",
 "worship of heavenly bodies": "تنجيم, عبادة الكواكب (عبادة الكواكب أو النجوم)",
 "worship of man": "عبادة البشر (عبادة الكائنات البشرية)",
 "worshiper": "عابد, مؤمن (شخص لديه إيمان ديني) / عابد, عاشق ولهان (شخص يعجب بشدة لدرجة عدم رؤية العيوب)",
 "worshipful": "تَقِيّ, خَاشِع (يُظهِر إجلالًا عظيمًا لله) / مُتَعَبِّد, مُحِبّ (يُظهِر التعبّد والعشق)",
 "worshipper": "عَابِد",
 "worst": "الأسوأ (لأقصى درجة من الرداءة أو السوء) / أسوأ جهد (أضعف جهد أو أفقر إنجاز يمكن للمرء القيام به) / أَسْوَأ ((صيغة التفضيل من 'سيء') الأكثر نقصاً في الجودة أو القيمة أو الحالة) / أسوأ ما يمكن (أقصى درجات الضرر أو الشر التي يقدر عليها المرء)\nمثال: عانت الأسوأ من بينهم جميعاً",
 "worsted": "صوف ممشط, ورستد (قماش صوفي بسطح محكم صلب وبدون وبر؛ منسوج من خيوط صوفية ممشطة) / غزل صوفي ممشط (خيط صوفي مجدول بإحكام مغزول من الصوف طويل التيلة)\nمثال: ارتدى بدلة من الصوف الممشط",
 "worsted yarn": "غزل صوفي ممشط (خيط صوفي مجدول بإحكام مغزول من الصوف طويل التيلة)",
 "wort": "نقيع الشعير (مالت غير مخمر أو قيد التخمير) / عشبة (تستخدم عادة في التركيب: 'عشبة الكبد'، 'عشبة الحليب'، 'عشبة الدوامة')",
 "worth": "مَاثَلَ / اِسْتَحَقَّ, اِسْتَأْهَلَ / اِسْتَحَقَّ / قِيمَة",
 "worthful": "ذُو قِيمَةٍ, قَيِّم (لَهُ قِيمَةٌ أَوْ اسْتِحْقَاقٌ أَوْ جَدَارَةٌ)",
 "worthily": "باستحقاق, بجدارة (بطريقة مستحقة؛ بجدارة)",
 "worthiness": "اسْتِحْقَاق, جَدَارَة (صفة أو حالة امتلاك ميزة أو قيمة)",
 "worthless": "لَا قِيمَةَ لَهُ, حَقِير (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: لا أحب المدرسة.",
 "worthlessly": "بلا قيمة (بطريقة عديمة القيمة)",
 "worthlessness": "انْعِدَام القِيمَة, لَا جَدْوَى (عدم امتلاك أي صفات تجعل الشيء قيماً أو مفيداً) / انْعِدَام القِيمَة (صفة كون الشيء بلا فائدة عملية)\nمثال: كان هدف رقيب التدريب إقناع المجندين بانعدام قيمتهم",
 "worthwhile": "جَدِيرٌ بِالاهْتِمَامِ (ذُو قِيمَةٍ كَافِيَةٍ تُبَرِّرُ اسْتِثْمَارَ الوَقْتِ أَوِ الاهْتِمَامِ)",
 "worthwhileness": "استحقاق العناء, جدوى (قيمة كافية لتعويض الوقت أو الجهد المبذول)",
 "worthy": "جَدِير, لَائِق (جدير بالاختيار خاصة كشريك زواج) / جَدِير, مُسْتَحِقّ (ذُو صِفَاتٍ أَوْ قُدُرَاتٍ تَسْتَحِقُّ التَّقْدِيرَ بِشَكْلٍ مِنَ الأَشْكَالِ) / جدير, مستحق (له قيمة أو استحقاق؛ كونه مشرفًا أو مثيرًا للإعجاب) / وجيه (شخص مهم ومحترم (تستخدم الكلمة غالباً بشكل فكاهي))\nمثال: رفيق جدير",
 "would like": "وَدَّ (تمنى ورجا؛ أراد شيئا)\nمثال: السيدة وود طباخة جيدة.",
 "wound": "جُرْح, جِرَاحَة (كَلَمَ، شَقَّ اللَحْم وأسَالَ الدَمّ؛ صَادَ أو اكْتَسَبَ) / جَرَحَ (كَلَمَ، شَقَّ اللَحْم وأسَالَ الدَمّ؛ صَادَ أو اكْتَسَبَ)\nمثال: ذلك سيهيج الجرح.",
 "wound tumor virus": "فيروس ورم الجروح (فيروس ورمي تنقله نطاطات الأوراق)",
 "wound up": "مُتَأَهِّب, مُسْتَثَار (أُوصِلَ إِلَى حَالَةِ تَوَتُّرٍ شَدِيد)",
 "wounded": "جَرِيح / مَجْرُوح",
 "wounding": "إصابة, جرح (فعل إحداث جرح) / جارِح, طاعِن (يُسَبِّب جِراحًا أو ألَمًا حادًّا)",
 "woundwort": "قَسْطَرَان",
 "wove paper": "ورق منسوج (ورق كتابة له نمط شبكي باهت جداً)",
 "woven": "محاك, منسوج (مصنوع أو مشيد بتشابك خيوط أو شرائط من المواد أو عناصر أخرى في كل واحد)\nمثال: أقمشة منسوجة",
 "wow": "عَجَبًا / سُبْحَانَ الله (مصدر للفعل سَبَحَ؛ تُقال حصرًا للَّٰه، كما في العبارة \"سُبْحَانَ اللَّٰهِ\")\nمثال: سبحان الله عما يشركون.",
 "wpm": "كَلِمَة فِي الدَّقِيقَة (المعدل الذي يتم به إنتاج الكلمات (كما في التحدث أو الكتابة))",
 "wrack": "حطام البحر (عشب بحري مجفف خاصة الذي يلقيه البحر على الشاطئ) / عشب البحر (نمو النباتات البحرية وخاصة الأشكال الكبيرة مثل طحالب الصخور وعشب البحر) / خراب, دمار (تدمير أو انهيار شيء ما)\nمثال: خراب ودمار",
 "wraith": "روح, شبح (تمثيل عقلي لتجربة مؤرقة (كأرواح الموتى)) / شبح, طيف خبيث (روح حاقدة أو مسكونة)\nمثال: بدا وكأنه رأى شبحاً",
 "wraithlike": "شَبَحِيّ, ظِلِّيّ (يَفْتَقِرُ إِلَى المَادَّةِ وَالجَوْهَر)",
 "wrangle": "مساومة حادة, مماحكة (حالة من الجدل الشديد (كما في المساومة)) / خصام, مشاجرة (نزاع غاضب)\nمثال: حدثت بينهم مشاجرة",
 "wrangler": "سايس الخيل (راعي بقر يعتني بخيول السرج) / مُخاصِم, مُشاكِس (شخص يجادل بصخب أو غضب)",
 "wrangling": "مساومة حادة, مماحكة (حالة من الجدل الشديد (كما في المساومة))",
 "wrap": "لَفَّ, غَلَّفَ",
 "wraparound": "رداء ملفوف (رداء (مثل فستان أو معطف) بفتحة كاملة الطول؛ يُضبط على الجسم بلفه حوله)",
 "wrapped": "مَلْفُوف",
 "wrapped up": "مُسْتَغْرِق, مُنْهَمِك (شديد التعلّق والانهماك في شيء ما)",
 "wrapper": "غِلَاف",
 "wrapping": "لفافة (ضمادة مغلفة) / غلاف, غلاف خارجي (الغطاء (عادة من الورق أو السلوفان) الذي يُلف فيه شيء ما)",
 "wrapping paper": "وَرَق تَغْلِيف (ما ينمو على النبات من الأعلى والجوانب بشكل صفائح ذات لون أخضر أو مائل إلى الخضرة. انظر الصورة؛ جلود رقاق يُكتَبُ عليها)\nمثال: هات ورقة بيضاء.",
 "wrasse": "لبروسية (أسماك بحرية استوائية بشكل رئيسي ذات شفاه لحمية وأسنان قوية؛ عادة ما تكون زاهية الألوان)",
 "wrath": "غَضَب, غَيْظ",
 "wrathful": "سَاخِط, غَضُوب (شديد الغضب والاستنكار؛ ثائر بحدّة)",
 "wrathfully": "بسخط, بغضب (بطريقة غاضبة)\nمثال: نظر إليها، ليس بغضب الآن، بل باستغراب",
 "wreath": "إِكْلِيل",
 "wreck": "تَصَادُّم",
 "wreckage": "حطام (الأجزاء المتبقية من شيء تحطم)\nمثال: بحثوا في الحطام عن علامات لوجود ناجين",
 "wrecked": "مُحَطَّم (دُمِّرَ فِي حَادِث)",
 "wrecker": "مُخَرِّب",
 "wreckfish": "قاروص الحجارة (سمكة بنية من المحيط الأطلسي والبحر الأبيض المتوسط توجد حول الصخور وحطام السفن)",
 "wrecking": "إفساد, تخريب (التدمير المتحقق عن طريق تحطيم الشيء أو إفساده) / تقويض, هدم (حدث هدم هيكل ما وتسويته بالأرض تماماً)",
 "wrecking ball": "كُرَة اَلتَّحْطِيم",
 "wrecking bar": "عتلة, مِخْل (رافعة حديدية ثقيلة أحد طرفيها مُشَكَّل كإسفين)",
 "wren": "صَعْو / وَصْع",
 "wren warbler": "هازجة النمنمة (طائر آسيوي وأفريقي صغير؛ يبني أعشاشاً تشبه أعشاش الطيور الخياطة)",
 "wren-tit": "نمنمة القرقف (طائر بني صغير من كاليفورنيا يشبه النمنمة)",
 "wrench": "مِفْتَاحُ رَبْط (مفتاح)\nمثال: بحث عن المفتاح.",
 "wrenching": "مُعَذِّب, مُمَزِّق (يُسَبِّبُ مُعَانَاةً جَسَدِيَّةً أَوْ نَفْسِيَّةً شَدِيدَة)",
 "wrest": "اِنْتَزَعَ (الشيء من مكانه: بمعنى نَزَعَ وغالبا ما يقصد به الشدة والاجبار)",
 "wrester": "نازع (شخص يحصل على شيء بسحبه بعنف مع حركات التواء)",
 "wrestle": "صَارَعَ",
 "wrestler": "مصارع (مقاتل يحاول طرح الخصم أرضاً)",
 "wrestling": "مُصَارَعَة",
 "wrestling hold": "مسكة مصارعة (مسكة تستخدم في رياضة المصارعة)",
 "wrestling mat": "بساط المصارعة (بساط تجرى عليه مباريات المصارعة)",
 "wrestling match": "مباراة مصارعة (مباراة بين مصارعين)",
 "wrestling ring": "حلبة المصارعة (حلبة مربعة يتنافس فيها المصارعون)",
 "wretch": "بائِس, مِسْكِين (شخص تشعر بالأسف تجاهه) / بائس, شقي (يقوم بعمل شرير)",
 "wretched": "بَائِس, تَعِيس (يتسم بالبؤس الجسدي) / بَائِس, مُثِيرٌ لِلشَّفَقَة (يَسْتَحِقُّ الشَّفَقَةَ أَوْ يَسْتَدْعِيهَا) / حَقِير, دَنِيء (مستنكَر أخلاقياً؛ يستحق الاحتقار) / بَائِس, مُعَذَّب (شَديد التَّعاسَة؛ مَليء بالبُؤس والشَّقاء)",
 "wretchedly": "ببؤس, بشقاء (بطريقة بائسة)\nمثال: قلت ببؤس: 'لا أستطيع أن أتذكر من أنا'",
 "wretchedness": "بؤس, تعاسة (جودة كون الشيء فقيراً ودون المستوى ومؤسفاً) / بؤس, شقاء (طابع كونه غير مريح وغير سار) / بؤس, تعاسة (حالة من سوء الحال ناتجة عن بلاء أو سوء حظ)\nمثال: لقد جمع سجلاً لا يعلى عليه في بؤسه",
 "wrick": "تشنج, وثء (تشنج عضلي مؤلم خاصة في الرقبة أو الظهر)",
 "wriggle": "تلوّي, تململ (عملية التلوّي أو التململ)",
 "wriggler": "يرقة البعوض (يرقة البعوض) / كَثِير الْحَرَكَة, مُتَمَلْمِل (شخص لا يستطيع البقاء ساكناً (خاصة الطفل))\nمثال: كان الطفل الصغير كثير الحركة حقاً في رحلات الطائرة",
 "wriggling": "مُتَعَرِّج, مُتَلَوٍّ (يتحرك بطريقة ملتوية كحركة الأفعى أو الدودة)",
 "wriggly": "مُتَعَرِّج, مُتَلَوٍّ (يتحرك بطريقة ملتوية كحركة الأفعى أو الدودة)",
 "wright": "صانع (شخص يصنع أو يصلح شيئاً ما (تستخدم عادة في التركيبات))",
 "wring": "عصر, لوي (عصر مع التواء)\nمثال: عصر القماش المبلل",
 "wringer": "عصّارة (مجفف ملابس يتكون من أسطوانتين يتم عصر الملابس المبللة بينهما)",
 "wrinkle": "جَعْدَة / تَجَعُّد, جَعْدَة",
 "wrinkle-resistant": "ضد الكرمشة, مقاوم للتجعد (من القماش الذي لا يتجعد بسهولة)",
 "wrinkled": "مُغَضَّن",
 "wrinkleless": "أملس, غير مجعد (غير مجعد أو مكرمش)",
 "wrinkleproof": "ضد الكرمشة, مقاوم للتجعد (من القماش الذي لا يتجعد بسهولة)",
 "wrinkly": "مجعد, مكرمش (تظهر عليه التجاعيد)\nمثال: مسافرون متعبون بملابس مجعدة",
