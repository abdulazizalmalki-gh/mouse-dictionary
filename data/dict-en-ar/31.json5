 "yokuts language": "لغة يوكوتس (لغة بينوتية يتحدث بها شعب يوكوتس في وادي سان جواكين)",
 "yolk": "صَفَار اَلْبَيْض, أَصْفَر اَلْبَيْض",
 "yolk sac": "كيس المح (بنية غشائية تحيط بمح البيض في الطيور والزواحف والجرابيات وبعض الأسماك؛ تقوم بتدوير العناصر الغذائية للجنين النامي) / حويصلة سرية, كيس المح (بنية غشائية تعمل كجهاز دوري في أجنة الثدييات حتى يصبح القلب وظيفياً)",
 "yom kippur": "يَوْم الْكَفَّارَة, يَوْم الْغُفْرَان (فترة من الزمان تبدأ عند غُرُوب الشمس وتنتهي عند غُرُوب شمس النهار التالي ويشمل اللَيْلَة ونَهَارا. طوله أربع وعشرين سَاعَة؛ النَهَار، يبدأ من طلوع الفَجْر إلى غُرُوب الشَمس، على المجاز)\nمثال: طقس اليوم جميل.",
 "yom kippur war": "حرب أكتوبر (حَرَبَ (حربه) بالحربة حربا: طعنه بها؛ حَرَبَ (ه) حربا: سلبه جميع ما يملك)\nمثال: بوتين مجرم حرب.",
 "yon": "في ذلك المكان, هناك (في أو في مكان محدد (بعيد عادة)) / ذَاكَ, هُنَاكَ (بعيد ولكن في مرمى البصر)\nمثال: المنزل هناك",
 "yonder": "هُنَاك, هُنَالِك",
 "yore": "زمن غابر, سالف العصر (زمن ماضٍ منذ فترة طويلة)",
 "york": "يورك",
 "yorkshire": "يُورْكْشَايْر",
 "yorkshire fog": "ضباب يوركشاير, عشب مخملي (عشب أوروبي معمر طويل له ساق مخملية؛ توطن في الولايات المتحدة ويستخدم للعلف)",
 "yorkshire pudding": "بودنغ يوركشاير (خبز خفيف منتفخ مصنوع من عجين سائل ويخبز تقليدياً في الصينية مع لحم البقر المشوي)",
 "yorkshire terrier": "يوركشاير تيريير (سلالة صغيرة جداً ذات فراء طويل لامع بلون أزرق رمادي وأسمر)",
 "yoruba": "اليوروبا (لغة كوا يتحدث بها اليوروبا في جنوب غرب نيجيريا) / يُورُوبا (عضو في شعب غرب أفريقي يعيش بشكل رئيسي في جنوب غرب نيجيريا)",
 "yoruba language": "اليوروبا (لغة كوا يتحدث بها اليوروبا في جنوب غرب نيجيريا)",
 "yosemite toad": "علجوم يوسمايت (من مروج سييرا نيفادا العالية وحدود الغابات)",
 "yoshkar-ola": "يُوشْكَار-أُولَا",
 "yottabit": "يوتابت (وحدة معلومات تساوي 1000 زيتابت أو 10 أس 24 بت)",
 "yottabyte": "يَوتَابَايْت",
 "yottaflop": "يوتا فلوب ((علم الحاسوب) وحدة لقياس سرعة نظام الحاسوب، تساوي سبتيليون (10 أس 24) عملية نقطة عائمة في الثانية)",
 "you": "مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة!",
 "you and whose army": "أَنْتَ وَالَّذِي الْجَيْش؟, أَنْتِ وَالَّتِي الْجَيْش؟ (أنْتَ ضَميرُ رَفْعٍ مُنْفَصِلٌ لِلْمُخاطَبِ وَالْمُخاطَبَةِ)\nمثال: أنت لست صديقنا.",
 "you bet": "بالتأكيد, وبشدة (تعبير عن الموافقة المؤكدة)",
 "you can't judge a book by its cover": "لَا تَحْكُم عَلَى كِتَابِ مِِنْ غِلَافِهِ (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: لا أحب المدرسة.",
 "you don't get something for nothing": "الْبِلَاش يُجِيبُ ٱلْعَمَى وَٱلطُرَاش",
 "you have beautiful eyes": "لَدَيْكِ عَيْنَيْن جَمِيلَتَيْن",
 "you know": "يَعْنِي",
 "you learn something new every day": "أَنْتَ تَتَعَلَّمُ شَيْئًا جَدِيْدًا كُلَّ يَوْمٍ (أنْتَ ضَميرُ رَفْعٍ مُنْفَصِلٌ لِلْمُخاطَبِ وَالْمُخاطَبَةِ)\nمثال: أنت لست صديقنا.",
 "you said it": "بالتأكيد, وبشدة (تعبير عن الموافقة المؤكدة)",
 "you're never too old to learn": "لَيْسَ هُنَاكَ سِنٌ مُتَأَخِّرَةٌ لِلتَعَلُّمِ",
 "you're right": "أَنْتَ عَلَى حَقّ, أَنْتِ عَلَى حَقّ (أنْتَ ضَميرُ رَفْعٍ مُنْفَصِلٌ لِلْمُخاطَبِ وَالْمُخاطَبَةِ)\nمثال: أنت لست صديقنا.",
 "you're welcome": "عَفْوًا, الْعَفْو",
 "you-drive": "تأجير السيارات, سيارة مستأجرة (سيارة مستأجرة)\nمثال: استلمت سيارة مستأجرة من المطار وقادتها إلى فندقها",
 "you-know-who": "تَعْرِفُ مَن, تَعْرِفِينَ مَن",
 "young": "صَغِير, حَدَث",
 "young bird": "طائر صغير, فرخ طائر (طائر لا يزال صغيراً)",
 "young blood": "دماء شابة, عناصر شابة (عضو أو أعضاء أصغر سناً في مجموعة يُعتبرون قوة منشطة، كما في منظمة ما)",
 "young buck": "شاب (مراهق أو شاب بالغ ذكر)",
 "young camel": "حُوَار, فَصِيل",
 "young carnivore": "جرو, شبل (صغير بعض الثدييات آكلة اللحوم مثل الدب أو الذئب أو الأسد)",
 "young donkey": "جَحْش, جَحْشَة (وَلَدُ ٱلْحِمَار)",
 "young fish": "سمكة صغيرة (سمكة لا تزال صغيرة)",
 "young girl": "صبية, فتاة (فتاة أو شابة غير متزوجة)",
 "young lady": "آنسة, شابة (أنثى شابة)\nمثال: شابة في الثامنة عشرة من عمرها",
 "young mammal": "صغير الثدييات (أي حيوان ثديي غير ناضج)",
 "young man": "شاب (مراهق أو شاب بالغ ذكر)",
 "young person": "شاب, يافع (شخص صغير السن (خاصة شاب أو صبي))",
 "young turk": "تُرْكِيَة الفَتَاة",
 "young woman": "آنسة, شابة (أنثى شابة)\nمثال: شابة في الثامنة عشرة من عمرها",
 "young's modulus": "مُعَامِل يُونْغ (معامل مرونة ينطبق على تمدد سلك)",
 "younger": "الأَصْغَر, الاِبْن (يُستخدم للأصغر سنًّا من شخصين يحملان الاسم ذاته؛ خاصة لتمييز الابن عن أبيه)",
 "younger brother": "أَخ الْأَصْغَر, أَخ الصَّغِير",
 "youngish": "شَابّ نَوْعًا مَا (صغير السنّ إلى حدّ ما)",
 "youngness": "حداثة سن, صغر (عكس الكبر)",
 "youngster": "صغير, طفل (شخص صغير السن من أي من الجنسين)\nمثال: هي تكتب كتباً للأطفال",
 "younker": "شاب, يافع (شخص صغير السن (خاصة شاب أو صبي))",
 "your": "ـك / ـكُم, ـكُنَّ",
 "your guess is as good as mine": "مَا الْمَسْؤُولُ بِأَعْلَمَ مِنَ السَّائِلِ (انظر مَا)\nمثال: هلا! ما الجديد؟",
