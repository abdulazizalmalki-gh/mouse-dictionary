 "weight gaining": "زيادة الوزن (كمال أجسام يزيد من كتلة العضلات ووزن الجسم)",
 "weight unit": "وحدة وزن (وحدة تُستخدم لقياس الوزن) / وحدة وزن, وحدة وزن مترية (وحدة وزن عشرية تعتمد على الغرام)\nمثال: وضع وزنين في كفة الميزان",
 "weighted": "مَوْزُون, مُرَجَّح (مُعدَّل ليعكس القيمة أو النسبة) / رَصاصِيّ, مُثْقَل (أصبَح ثَقيلًا أو بَطيئًا بِسَبَب الإرْهاق والتَّعَب)",
 "weighted arithmetic mean": "متوسط حسابي موزون, متوسط موزون (متوسط يتم فيه تعيين وزن لكل كمية مراد حساب متوسطها، مما يحدد الأهمية النسبية لكل كمية في المتوسط)\nمثال: هذا النموذج الميكانيكي البسيط هو الآن تمثيل مألوف للمتوسط الحسابي الموزون لمجموعة من الملاحظات",
 "weighted average": "متوسط حسابي موزون, متوسط موزون (متوسط يتم فيه تعيين وزن لكل كمية مراد حساب متوسطها، مما يحدد الأهمية النسبية لكل كمية في المتوسط)\nمثال: هذا النموذج الميكانيكي البسيط هو الآن تمثيل مألوف للمتوسط الحسابي الموزون لمجموعة من الملاحظات",
 "weighted mean": "متوسط حسابي موزون, متوسط موزون (متوسط يتم فيه تعيين وزن لكل كمية مراد حساب متوسطها، مما يحدد الأهمية النسبية لكل كمية في المتوسط)\nمثال: هذا النموذج الميكانيكي البسيط هو الآن تمثيل مألوف للمتوسط الحسابي الموزون لمجموعة من الملاحظات",
 "weightfulness": "جَاذِبِيَّة",
 "weightily": "بتثاقل (كشيء ثقيل جداً) / بجدية, برزانة (بطريقة مهيبة)\nمثال: تحركت بتثاقل",
 "weightiness": "ثقل, وزن (خاصية كون الشيء عظيم الوزن نسبياً) / اعتبار, ثقل (الأهمية النسبية الممنوحة لشيء ما)\nمثال: ثقل الرصاص",
 "weighting": "ثِقَل تَرْجِيحِيّ, وَزْن ((في الإحصاء) معامل يُخصص لعناصر توزيع تكراري لتمثيل أهميتها النسبية)",
 "weightless": "عديم الوزن (له وزن ضئيل أو معدوم أو جاذبية ظاهرية معدومة؛ خفيف)\nمثال: تطفو بحرية في حالة انعدام الوزن",
 "weightlessness": "انعدام الوزن, خفة (خاصية كون الشيء صغير الوزن نسبياً)\nمثال: خفة خشب البالسا",
 "weightlift": "رفع الأثقال (كمال أجسام عن طريق تمرين يتضمن رفع الأوزان)",
 "weightlifter": "رافع أثقال (رياضي يرفع الأثقال)",
 "weightlifting": "رفع الأثقال (كمال أجسام عن طريق تمرين يتضمن رفع الأوزان)",
 "weighty": "بَدِين جِدًّا, سَمِين مُفْرِطًا (مُفْرِط فِي السِّمْنَة والبَدَانَة) / ثقيل, وزين (ذو وزن كبير نسبياً؛ ثقيل) / جَسيم, ذو ثِقَل (يُثْقِل الرُّوح؛ يُسَبِّب قَلَقًا أو هَمًّا كَبيرًا) / ثَقِيل, خَطِير (بالغ الخطورة أو حاسم؛ يستدعي تفكيرًا جادًّا)\nمثال: حمل ثقيل",
 "weil's disease": "داء ويل (شكل حاد من داء البريميات عند البشر)",
 "weimar republic": "جمهورية فايمار (الجمهورية الألمانية التي تأسست في فايمار عام 1919)\nمثال: أطيح بجمهورية فايمار عام 1933 وحل محلها الرايخ الثالث",
 "weimaraner": "فيمارانير, كلب فيمار (سلالة كبيرة من كلاب الصيد ذات فراء رمادي ناعم؛ نشأت في ألمانيا)",
 "weir": "هَدَّار (\"صَوْتٌ هَدَّارٌ\" : مُجَلْجِلٌ قَوِيٌّ؛ \"مَطَرٌ هَدَّارٌ\" : هَاطِلٌ بِقُوَّةٍ)",
 "weird": "عَجِيب, غَرِيب",
 "weird sister": "نورن ((الأساطير الإسكندنافية) أي من إلهات القدر الثلاث؛ تتماهى مع ويرد الأنجلوساكسونية؛ تشبه المويراي اليونانية والباركاي الرومانية)",
 "weirdie": "شخص منفر, غريب الأطوار (شخص غريب بشكل مزعج أو شاذ)",
 "weirdly": "بشكل غريب (بطريقة غريبة)\nمثال: كانت ترتدي ملابس غريبة",
 "weirdness": "شُذُوذ, غَرَابَة شَدِيدَة (الخروج عن المألوف بشكل لافت للنظر)",
 "weirdo": "مَجْنُون, مَخْبُول (شخص مضطرب عقلياً وربما خطير) / شخص منفر, غريب الأطوار (شخص غريب بشكل مزعج أو شاذ)",
 "weirdy": "شخص منفر, غريب الأطوار (شخص غريب بشكل مزعج أو شاذ)",
 "weisenheimer": "متحذلق, متعالم (شخص مغرور يدلي بتعليقات ساخرة ووقحة ومعجبة بالنفس)",
 "weissbier": "بيرة القمح, بيرة بيضاء (اسم عام للبيرة المصنوعة من القمح بالتخمير العلوي؛ عادة ما تكون شاحبة جداً وغائمة وفوارة)",
 "weizenbier": "فايتسنبير (اسم عام في جنوب ألمانيا لبيرة القمح)",
 "weizenbock": "فايتسنبوك (بيرة قمح ألمانية بقوة بيرة البوك)",
 "weka": "ويكا (طائر مرعة نيوزيلندي لا يطير ذو طبع لصوصي وله أجنحة قصيرة بكل منها مهز (شوكة) يستخدم في القتال)",
 "welcher": "متهرب من الدفع (شخص يحتال عليك بعدم سداد دين أو رهان)",
 "welcome": "أَهْلًا وَسَهْلًا, مَرْحَبًا (تحية ترحيب بالضيف؛ تحية عند اللقاء أو لبدء المحادثة) / تَرْحِيب / رَحَّبَ, اِسْتَقْبِل (بنو رَحَب: اسم؛ بطن من همذان)\nمثال: أهلا يا أصدقاء.",
 "welcome mat": "ممسحة الباب (حصيرة توضع خارج الباب الخارجي لمسح الأحذية قبل الدخول)",
 "welcome wagon": "عربة الترحيب (مركبة بعجلات تحمل معلومات وهدايا من التجار المحليين للسكان الجدد في منطقة ما)",
 "welcomer": "مُرَحِّب, مُسْتَقْبِل (شخص يقوم بالترحيب)\nمثال: استقبل القادمين الجدد مرحبون مبتسمون",
 "welcoming": "تَرْحِيبِيّ, وَدُود (بالغ الودّ والحفاوة)",
 "welcoming committee": "لجنة استقبال (لجنة للترحيب بالمقيمين الجدد في المجتمع)",
 "weld": "لَحَمَ (ما يبقى من جسم الحيوان أو الإنسان بعد إزالة الجلد الأحشاء والعظم والشحم والدم والأعصاب. يتكون أساسا من العَضَلَات؛ ما يؤكل من لحم من الحيوان والطير والسمك عامة)\nمثال: أفضل لحم البقر.",
 "welder": "لَحَّام",
 "welder's mask": "قناع اللحام (قناع ترتديه للحماية عند القيام بعمليات اللحام)",
 "welding": "لَحْم, لِحَام (ما يبقى من جسم الحيوان أو الإنسان بعد إزالة الجلد الأحشاء والعظم والشحم والدم والأعصاب. يتكون أساسا من العَضَلَات؛ ما يؤكل من لحم من الحيوان والطير والسمك عامة)\nمثال: أفضل لحم البقر.",
 "weldment": "تجميعة ملحومة, ملحومة (تجميع لأجزاء ملحومة معاً)",
 "welfare": "رَفَاهَة, خَيْر",
 "welfare case": "حالة رعاية اجتماعية (حالة لعامل الرعاية الاجتماعية)",
 "welfare state": "دولة الرفاهية (حكومة تتحمل المسؤولية عن رفاهية مواطنيها من خلال برامج في الصحة العامة والإسكان العام والمعاشات التقاعدية وتعويض البطالة وما إلى ذلك)",
 "welfare work": "خدمة اجتماعية, عمل خيري (نشاط منظم لتحسين ظروف المحرومين في المجتمع)",
 "welfare worker": "أخصائي اجتماعي, باحث اجتماعي (شخص يعمل لتقديم الخدمات الاجتماعية (خاصة للمحرومين))",
 "welfare-statist": "رِعَائِيّ, مُتَعَلِّقٌ بِدَوْلَةِ الرَّفَاهِ (مُتَعَلِّقٌ بِدَوْلَةِ الرَّفَاهِ أَوْ مُنْتَمٍ إِلَيْهَا)",
 "welfarist": "رِعَائِيّ, مُتَعَلِّقٌ بِدَوْلَةِ الرَّفَاهِ (مُتَعَلِّقٌ بِدَوْلَةِ الرَّفَاهِ أَوْ مُنْتَمٍ إِلَيْهَا)",
 "welkin": "سَمَاء",
 "well": "حَسَنًا, بِخَيْر (تقال عند استحسان الفعل أو القول، هَذَا حَسَن) / طيّب / حسنًا (تقال عند استحسان الفعل أو القول، هَذَا حَسَن) / بِئْر, بير / عَيْن, بِئْر (المُعَايَنَة والمشاهدة؛ العين : حاسة البصر والرؤية - مؤنث - تكون للإنسان وغيره من الحيوان . قال ابن السكيت : العين التي يبصر بها الناظر…)\nمثال: حسنا. أنا موافق.",
 "well behaved": "حَسَن السُّلُوك, مُؤَدَّب ((عادة عن الأطفال) يتصرف بالطريقة التي يراها المتحدث صحيحة)",
 "well disposed": "حَسَن النِّيَّة, وُدِّيّ (ميَّال للمساعدة أو الدعم؛ غير عدائيّ أو معادٍ)",
 "well done": "أَحْسَنْتَ, أَحْسَنْتِ",
 "well point": "رأس البئر, نقطة البئر (أنبوب مثقب يدفع في الأرض لجمع المياه من المنطقة المحيطة)",
 "well said": "لَا فُضَّ فُوكَ (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: لا أحب المدرسة.",
 "well water": "مياه جوفية (مياه تحت الأرض محتجزة في التربة وفي الصخور المنفذة)",
 "well-adjusted": "سَوِيّ, مُتَوَازِن (خالٍ من الاضطراب النفسيّ)",
 "well-advised": "حَكِيم, سَدِيد (يحظى بميزة التفكير المسبق المتأني أو المشورة)\nمثال: تأخير مدروس في تنفيذ الخطة",
 "well-appointed": "حَسَن التَّجْهِيز, كَامِل التَّأْثِيث (يمتلك مجموعة كاملة من التجهيزات أو الأثاث المناسب)",
 "well-balanced": "مُتَوَازِن",
 "well-behaved": "حَسَن السُّلُوك, مُؤَدَّب ((عادة عن الأطفال) يتصرف بالطريقة التي يراها المتحدث صحيحة)",
 "well-being": "رَفَاهِيَة",
 "well-bound": "مُجَلَّد بِإِتْقَان ((للكتب) ذو تجليد متين وجذاب)",
 "well-branched": "حَسَنُ التَّفَرُّع (لَهُ أَغْصَانٌ جَيِّدَة)",
 "well-bred": "حَسَنُ التَّرْبِيَةِ, مُؤَدَّبٌ (ذو تربية حسنة وتنشئة راقية)",
 "well-chosen": "مُحْكَم الاخْتِيَار, مُوَفَّق التَّعْبِير (حَسَن التَّعْبِير وَفِي صُلْب المَوْضُوع)",
 "well-conducted": "مُحْكَم الإِدَارَة (يتسم بحسن التنظيم والإدارة)",
 "well-connected": "حَسَنُ الصِّلَاتِ, ذُو عَلَاقَاتٍ (مُرْتَبِطٌ بِالقَرَابَةِ أَوِ المَعْرِفَةِ الوَثِيقَةِ بِأَشْخَاصٍ ذَوِي ثَرْوَةٍ أَوْ مَكَانَةٍ)",
 "well-defined": "محدد جيداً, واضح المعالم (مصرح به أو موصوف بدقة) / مَنْحُوت المَعَالِم, وَاضِح القَسَمَات (ذُو خُطُوط وَاضِحَة وَمُحَدَّدَة كَأَنَّهَا مَنْحُوتَة بِدِقَّة)\nمثال: مجموعة من القيم المحددة جيداً",
 "well-disposed": "حَسَن النِّيَّة, وُدِّيّ (ميَّال للمساعدة أو الدعم؛ غير عدائيّ أو معادٍ)",
 "well-done": "نَاضِجٌ تَمَامًا ((عَنِ اللَّحْم) مَطْهُوٌّ حَتَّى لَمْ يَبْقَ لَحْمٌ وَرْدِيٌّ بِدَاخِلِه)",
 "well-dressed": "حَسَنُ المَلْبَس, مُهَنْدَم (ذُو مَلَابِسَ أَنِيقَةٍ وَنَظَافَةٍ فَائِقَة)",
 "well-educated": "مُطَّلِع, وَاسِعُ الثَّقَافَة (على درجة عالية من التعليم؛ ذو معلومات أو فهم واسع)",
 "well-endowed": "ذَات قَوَام مُنْحَنٍ, مُمْتَلِئَة ((عن جسد المرأة) ذات صدر كبير وانحناءات جذّابة)",
 "well-favored": "حَسَن المَظْهَر, وَسِيم (ممتع المظهر خاصة بسبب التناسق مع مُثُل الشكل والتناسب)",
 "well-favoured": "حَسَن المَظْهَر, وَسِيم (ممتع المظهر خاصة بسبب التناسق مع مُثُل الشكل والتناسب)",
 "well-fed": "حَسَن التَّغْذِيَة (يتلقى تغذية سليمة وكافية)",
 "well-fixed": "مَيْسُورُ الحَال, مُرْتَاحٌ مَادِّيًّا (في ظروف مالية ميسورة؛ غنيّ بشكل معتدل)",
 "well-formed": "سليم لغوياً, نحوي (مطابق لقواعد النحو أو الاستخدام المقبول من قبل الناطقين الأصليين)\nمثال: تحدث بجمل سليمة نحوياً",
 "well-found": "حَسَن التَّجْهِيز, كَامِل التَّأْثِيث (يمتلك مجموعة كاملة من التجهيزات أو الأثاث المناسب)",
 "well-founded": "قَائِمٌ عَلَى أُسُسٍ سَلِيمَة, وَجِيه (مبنيّ على استدلال أو أدلّة سليمة)",
 "well-groomed": "حَسَنُ الهِنْدَام (ذُو شَعْرٍ مُمَشَّطٍ وَمُرَتَّبٍ بِعِنَايَة) / حَسَنُ المَلْبَس, مُهَنْدَم (ذُو مَلَابِسَ أَنِيقَةٍ وَنَظَافَةٍ فَائِقَة)",
 "well-grooved": "رُوتِينِيّ, مُعْتَاد (ثابت كأنّه استقرّ في أخدود أو نمط روتينيّ)",
 "well-grounded": "سَلِيمُ الحُجَّة, مُعَلَّل (صَحِيحٌ مَنْطِقِيًّا)",
 "well-heeled": "مَيْسُورُ الحَال, مُرْتَاحٌ مَادِّيًّا (في ظروف مالية ميسورة؛ غنيّ بشكل معتدل)",
 "well-informed": "مُطَّلِع",
 "well-intentioned": "حَسَنُ النِّيَّة (ينبع من نوايا حسنة وإن أدى في الغالب إلى نتائج غير مرغوبة)",
 "well-kept": "حَسَنُ الصِّيَانَة, مَعْتَنًى بِه (يُحَافَظُ عَلَيْهِ فِي حَالَةٍ جَيِّدَة) / حَسَنُ الصِّيَانَة, مُعْتَنًى بِه (يَتَّسِمُ بِالنِّظَامِ وَالتَّرْتِيبِ؛ خَالٍ مِنَ الفَوْضَى)",
 "well-knit": "مَتِين البِنَاء, مَحْبُوك (مبنيّ بإحكام وصلابة)",
 "well-known": "ذَائِع الصِّيت, مَعْرُوف جَيِّدًا (معروف على نطاق واسع أو بشكل تامّ)",
 "well-lighted": "مُضَاء, مُنَار (مُزَوَّد بِإِضَاءَة صِنَاعِيَّة)",
 "well-lined": "مَمْلُوء بِالمَال (مَلِيء بِالمَال)",
 "well-made": "مَصْنُوع بِمَهَارَة, مُتْقَن الصُّنْع (مصنوع بحرفية عالية)",
 "well-mannered": "حَسَنُ الأَخْلَاقِ, مُؤَدَّب (صحيح السلوك اجتماعياً) / حَسَنُ التَّرْبِيَةِ, مُؤَدَّبٌ (ذو تربية حسنة وتنشئة راقية)",
 "well-marked": "وَاضِحُ المَعَالِم (مُحدَّد بوضوح)",
 "well-meaning": "حَسَن القَصْد, غَيْر مُهَدِّد (ليس معادياً ولا يُشكِّل تهديداً) / حَسَنُ النِّيَّة (ينبع من نوايا حسنة وإن أدى في الغالب إلى نتائج غير مرغوبة)",
 "well-meant": "حَسَنُ النِّيَّة (ينبع من نوايا حسنة وإن أدى في الغالب إلى نتائج غير مرغوبة)",
 "well-mined": "مَعْرُوفٌ جَيِّدًا, مُسْتَنْفَد (مَعْرُوفٌ وَمُسْتَخْدَمٌ عَلَى نِطَاقٍ وَاسِع)",
 "well-nigh": "تقريباً, على وشك ((للأفعال أو الحالات) قريبة جداً من الاكتمال ولكن ليس تماماً)\nمثال: العمل قد انتهى تقريباً",
 "well-nourished": "حَسَن التَّغْذِيَة (يتلقى تغذية سليمة وكافية)",
 "well-off": "فِي وَضْعٍ جَيِّد, مُيَسَّر (فِي وَضْعٍ مُوَاتٍ وَمُرِيحٍ) / مَيْسُورُ الحَال, مُرْتَاحٌ مَادِّيًّا (في ظروف مالية ميسورة؛ غنيّ بشكل معتدل)",
 "well-ordered": "حَسَنُ التَّنْظِيمِ, مُرَتَّبٌ (منظم ومرتب ترتيباً جيداً)",
 "well-preserved": "مُحافِظ عَلى شَبابِه (يَبْدو بِحالَة جَيِّدَة رَغْم تَقَدُّم العُمْر)",
 "well-proportioned": "مُتَنَاسِب الأَبْعَاد (ذو نسب مُرضية وجميلة)",
 "well-qualified": "كُفْءٌ تَمَامًا, مُؤَهَّلٌ جِدًّا (مؤهّل أكثر من الحدّ الكافي)",
 "well-read": "وَاسِع الاطلاع (واسِع: (اسم)؛ واسع: (اسم))\nمثال: أرض الله واسعة.",
 "well-rounded": "شَامِلُ المَهَارَات, مُتَعَدِّدُ الجَوَانِب (متعدّد الأوجه والمهارات والاهتمامات)",
 "well-set": "مَتِين البِنَاء, مَحْبُوك (مبنيّ بإحكام وصلابة)",
 "well-shaven": "حَلِيق, نَاعِم الحِلَاقَة (محلوق حلاقة ناعمة حديثة)",
 "well-situated": "مَيْسُورُ الحَال, مُرْتَاحٌ مَادِّيًّا (في ظروف مالية ميسورة؛ غنيّ بشكل معتدل)",
 "well-spoken": "حَسَن الكَلَام, رَشِيق العِبَارَة (يتكلّم بأسلوب لائق ومُستحسَن)",
 "well-thought-of": "مَوْقُورٌ, مُحْتَرَمٌ (يحظى باحترام وتقدير الآخرين)",
 "well-timed": "فِي الوَقْت المُنَاسِب (في وقت ملائم)\nمثال: وصلت رسالتك في الوقت المناسب",
 "well-to-do": "مُقْتَدِر",
 "well-tried": "مُجَرَّب, مُخْتَبَر (تمّ اختباره وثبتت فائدته أو صحّته)",
 "well-turned": "حَسَن الصِّيَاغَة ((عَنِ اللُّغَة) مَصُوغ بِمَهَارَة وَبِشَكْلٍ مُمْتِع) / حَسَن التَّشْكِيل (ذو شكل أنيق ومُرضٍ)",
 "well-wisher": "مؤيد, متعاطف (شخص يشاركك مشاعرك أو آرائك ويأمل أن تنجح)",
 "well-wishing": "تَمَنِّيَات طَيِّبَة (تعبير عن حسن النية من شخص لآخر)\nمثال: الكثير من المصافحات والتمنيات الطيبة",
 "well-worn": "مُبْتَذَل, مُسْتَهْلَك (مُكرَّر أكثر من اللازم؛ مألوف بشكل مفرط بسبب كثرة الاستخدام) / كَثِيرُ الاسْتِعْمَالِ (تَظْهَرُ عَلَيْهِ عَلَامَاتُ كَثْرَةِ الاسْتِعْمَالِ)",
 "wellbeing": "رفاهية, سعادة (حالة قناعة وسعادة وصحة وازدهار)\nمثال: كانت المدينة أخيراً في حالة تحسن (رفاهية) بعد مشاكلنا الأخيرة",
 "wellborn": "كَرِيم الأَصْل, نَبِيل المَحْتِد (مِنْ نَسَبٍ رَفِيعٍ أَوْ سُلَالَة عُلْيَا)",
 "wellerism": "قول مأثور ساخر (مقارنة تتكون من اقتباس معروف يليه تكملة فكاهية)",
 "wellhead": "رأس البئر (هيكل مبني فوق بئر) / مصدر فياض, نبع (مصدر المياه للبئر)",
 "wellington": "وِيلِينْغْتُون",
 "wellington boot": "جزمة عسكرية, جزمة هسية ((في القرن التاسع عشر) حذاء رجالي طويل مزين بشراشيب)",
 "wellness": "صِحَّة, سَلامة (سَلَامَة؛ سَلَامَة الْجِسْم)\nمثال: أشك في صحة ذلك.",
 "wellpoint": "رأس البئر, نقطة البئر (أنبوب مثقب يدفع في الأرض لجمع المياه من المنطقة المحيطة)",
 "wellspring": "مصدر غني, منبع (مصدر وفير) / مصدر فياض, نبع (مصدر المياه للبئر)\nمثال: كانت نبعاً من المعلومات",
 "welsh": "ويلش, ويلش الأسود (سلالة من الماشية ثنائية الغرض طُورت في ويلز) / ويلزي (من أو متعلق أو مميز لويلز أو شعبها أو لغتهم) / الويلزية (لغة كلتية في ويلز) / ويلزي (مواطن أو مقيم في ويلز)\nمثال: الساحل الويلزي",
 "welsh black": "ويلش, ويلش الأسود (سلالة من الماشية ثنائية الغرض طُورت في ويلز)",
 "welsh cake": "الكعك الويلزي",
 "welsh corgi": "كورجي, ويلش كورجي (أي من سلالتين ويلزيتين من الكلاب طويلة الجسم وقصيرة الأرجل ذات آذان منتصبة ورأس يشبه الثعلب)",
 "welsh language": "الويلزية (لغة كلتية في ويلز)",
 "welsh onion": "بصل ويلزي, كراث ياباني (بصل آسيوي ذو بصيلات نحيلة؛ يستخدم كبصل أخضر مبكر)",
 "welsh pony": "مهر ويلزي (سلالة من المهور الصغيرة أصلها من ويلز)",
 "welsh poppy": "خشخاش ويلزي (نبات غرب أوروبي يزرع على نطاق واسع بزهور صفراء شاحبة مبهرجة)",
 "welsh rabbit": "توست بالجبن, ويلش ريربيت (جبن مذاب مع البيرة يُقدم فوق التوست)",
 "welsh rarebit": "توست بالجبن, ويلش ريربيت (جبن مذاب مع البيرة يُقدم فوق التوست)",
 "welsh springer spaniel": "سبرينغر سبانييل الويلزي (سلالة حمراء وبيضاء أصغر قليلاً من سبرينغر سبانييل الإنجليزي)",
 "welsh terrier": "تيريير ويلزي (تيريير سلكي الشعر يشبه الإيرديل ولكنه أصغر؛ تم تطويره في ويلز للصيد)",
 "welsher": "متهرب من الدفع (شخص يحتال عليك بعدم سداد دين أو رهان)",
 "welshman": "ويلزي (مواطن أو مقيم ذكر في ويلز)",
 "welshwoman": "ويلزية (مواتنة أو مقيمة أنثى في ويلز)",
 "welt": "إطار, حاشية بارزة (درزة بارزة أو مقواة) / أثر ضربة, انتبار (علامة بارزة على الجلد (تنتج عن ضربة سوط مثلاً)؛ سمة مميزة للعديد من ردود الفعل التحسسية)",
 "weltanschauung": "رؤية كونية, نظرة للعالم (نظرة شاملة للعالم وللحياة البشرية)",
 "welted thistle": "شوك مجعد (نبات أوروبي ثنائي الحول أدخل إلى أمريكا الشمالية ذو رؤوس زهور في عناقيد مزدحمة في نهايات الفروع)",
 "welter": "خليط, ركام (مجموعة مشوشة من الأشياء)",
 "welterweight": "وزن الوسط (ملاكم محترف يتراوح وزنه بين 141 و 147 رطلاً) / وزن الوسط (مصارع يزن 154-172 رطلاً) / وزن الوسط (ملاكم هاوٍ لا يزيد وزنه عن 148 رطلاً (حوالي 67 كجم)) / وزن متوسط, ويلترويت (وزن قدره 28 رطلاً؛ يُفرض أحيانًا كإعاقة في سباق الخيل)",
 "weltschmerz": "سأم من الحياة (الحزن عند التفكير في شرور العالم)",
 "welwitschia": "فلفيتشية, فلفيتشية رائعة (نبات غريب ينمو في المناطق القاحلة بجنوب غرب أفريقيا، له جذع ارتفاعه وعرضه ياردة يشبه اللفت مع جذر وتدي عميق ورقتين خشبيتين كبيرتين دائمتين تشبهان…)",
 "welwitschia mirabilis": "فلفيتشية, فلفيتشية رائعة (نبات غريب ينمو في المناطق القاحلة بجنوب غرب أفريقيا، له جذع ارتفاعه وعرضه ياردة يشبه اللفت مع جذر وتدي عميق ورقتين خشبيتين كبيرتين دائمتين تشبهان…)",
 "wen": "وَن, وِين",
 "wench": "امرأة, فتاة (مصطلحات غير رسمية لامرأة (شابة))",
 "wencher": "زير نساء (شخص يرتاد المومسات)",
 "wendigo": "وِينْدِيجُو",
 "wendy house": "بيت اللعب (لعبة تتكون من نموذج صغير لمنزل يمكن للأطفال اللعب بداخله)",
 "wenzhou": "وَنْتْشُو, وَنْجُو",
 "werdnig-hoffman disease": "مرض فيردنيغ هوفمان (مرض وراثي جسمي متنحٍ يؤدي فيه تنكس الخلايا العصبية الشوكية والخلايا العصبية الدماغية إلى ضمور العضلات الهيكلية والشلل الرخو؛ تحدث الوفاة عادة في…)",
 "werewolf": "مُسْتَذْئِب, مُسْتَذْئِبَة",
 "wergeld": "دِيَة",
 "werlhof's disease": "فرفرية قليلة الصفيحات (فرفرية مرتبطة بانخفاض في الصفائح الدموية الدائرة والتي يمكن أن تنتج عن مجموعة متنوعة من العوامل)",
 "wernicke's aphasia": "حبسة استقبالية, حبسة حسية (حبسة تتميز بكلام طلق ولكنه لا معنى له وضعف شديد في القدرة على فهم الكلمات المنطوقة أو المكتوبة)",
 "wernicke's area": "باحة فيرنيكه, مركز فيرنيكه (مركز الكلمات السمعي؛ يقع في الجزء الخلفي من التلفيف الصدغي العلوي في معظم الناس)",
 "wernicke's center": "باحة فيرنيكه, مركز فيرنيكه (مركز الكلمات السمعي؛ يقع في الجزء الخلفي من التلفيف الصدغي العلوي في معظم الناس)",
 "wernicke's encephalopathy": "اعتلال دماغ فيرنيكه (مرض دماغي تنكسي التهابي ناجم عن نقص الثيامين ويرتبط عادة بإدمان الكحول)",
 "weser": "فِيزَر",
 "wesleyan": "منهجي, ميثودي (من أو يخص أو يميز فرع البروتستانتية المتمسك بآراء ويسلي) / ويزلي (تابع للمذهب الويزلي)\nمثال: اللاهوت الميثودي",
 "wesleyan methodist church": "الكنيسة الميثودية الويسليانية (الكنيسة الميثودية الأصلية)",
 "wesleyan methodists": "الكنيسة الميثودية الويسليانية (الكنيسة الميثودية الأصلية)",
 "wesleyanism": "ويزلية (المبادئ الإنجيلية التي علمها جون ويسلي)",
 "wesleyism": "ويزلية (المبادئ الإنجيلية التي علمها جون ويسلي)",
 "west": "غَرْب (الجِهَة التي تغرب نحوها الشَمس؛ ضد الشَرْق؛ الأَرَاضِي والبِلَاد التي تقع جهة الغرب في العَالم) / مَغْرِب (مَكَان غُرُوب الشَمْس، ويقصد به الغَرْب مجَازًا؛ زَمَان غروب الشمس) / غرب (الجِهَة التي تغرب نحوها الشَمس؛ ضد الشَرْق؛ الأَرَاضِي والبِلَاد التي تقع جهة الغرب في العَالم)\nمثال: تغرب الشمس في الغرب.",
 "west african": "غرب أفريقي (من أو يتعلق بدول أو ثقافات أو شعوب غرب أفريقيا) / غرب أفريقية (مجموعة من اللغات يتم التحدث بها في أقصى الجزء الغربي من غرب أفريقيا)",
 "west african cfa franc": "فرنك سيفا الغرب أفريقي, فرنك غرب أفريقيا (عملة ثماني دول مستقلة في غرب أفريقيا: بنين، وبوركينا فاسو، وغينيا بيساو، وساحل العاج، ومالي، والنيجر، والسنغال، وتوغو)\nمثال: فرنك وسط أفريقيا يساوي في القيمة فرنك غرب أفريقيا",
 "west asia": "غَرْب آسِيَا (الجِهَة التي تغرب نحوها الشَمس؛ ضد الشَرْق؛ الأَرَاضِي والبِلَاد التي تقع جهة الغرب في العَالم)\nمثال: تغرب الشمس في الغرب.",
 "west azerbaijan": "أَذَرْبَيْجَان الْغَرْبِيَّة",
 "west bank": "الضِّفَّة الْغَرْبِيَّة",
 "west bengal": "بَنْغَال اَلْغَرْبِيَّة",
 "west berlin": "بَرْلِين الْغَرْبِيَّة",
 "west berliner": "برليني غربي (أحد سكان برلين الغربية)",
 "west by north": "الغَرْب المَائِل لِلشَّمَال, غَرْب لِشَمَال (نقطة البوصلة التي تقع شمال الغرب بنقطة واحدة)",
 "west by south": "الغَرْب المَائِل لِلجَنُوب, غَرْب لِجَنُوب (نقطة البوصلة التي تقع جنوب الغرب بنقطة واحدة)",
 "west chadic": "التشادية الغربية (مجموعة من اللغات التشادية يتم التحدث بها في شمال نيجيريا؛ الهوسا هي أهم عضو فيها)",
 "west coast hemlock": "تسوغا غربية (شجرة دائمة الخضرة طويلة من غرب أمريكا الشمالية؛ شجرة خشب مهمة تجارياً)",
 "west germanic": "اللغات الجرمانية الغربية (فرع من اللغات الجرمانية)",
 "west germanic language": "اللغات الجرمانية الغربية (فرع من اللغات الجرمانية)",
 "west germany": "أَلْمَانِيَا الْغَرْبِيَّة (دولة أوروبية في وسط أوروبا)\nمثال: ستعجبك ألمانيا.",
 "west highland white terrier": "تيريير ويست هايلاند الأبيض (تيريير صغير أبيض طويل الفراء تم تطويره في اسكتلندا)",
 "west indian": "هندي غربي (مواطن أو ساكن في جزر الهند الغربية)",
 "west indian cherry": "أسيرولا, كرز هندي (فاكهة حمراء أو صفراء حامضة تشبه الكرز لشجيرة استوائية أمريكية غنية جداً بفيتامين سي) / أسيرولا, كرز باربادوس (شجيرة أمريكية استوائية تحمل ثماراً حمراء حامضة صالحة للأكل تشبه الكرز)",
 "west indian jasmine": "بلوميريا بيضاء, ياسمين غرب الهند (شجرة طويلة قليلة التفرع مخروطية الشكل لها زهور صفراء كبيرة عطرة بقلب أبيض)",
 "west indian satinwood": "خشب الساتان, خشب الساتان الهندي الغربي (شجرة من جزر الهند الغربية بخشب ناعم لامع وزيتي قليلاً)",
 "west indian smallpox": "جدري خفيف (شكل خفيف من الجدري يسببه فيروس أقل ضراوة)",
 "west indian snowberry": "توت الثلج لغرب الهند, كيوكوكا ألبا (شجيرة متسلقة دائمة الخضرة من جنوب فلوريدا وجزر الهند الغربية تزرع لعناقيدها من الزهور البيضاء العطرة إلى الكريمية تليها ثمار توت عصارية بيضاء كروية)",
 "west jerusalem": "اَلْقُدْس اَلْغَرْبِيَّة",
 "west midland": "غرب ميدلاند (لهجة من الإنجليزية الوسطى، كان يتم التحدث بها في النصف الغربي من منطقة لهجة مرسيا الإنجليزية القديمة)",
 "west nile encephalitis": "التهاب دماغ النيل الغربي (التهاب الدماغ الناجم عن فيروس غرب النيل؛ يمكن أن يكون قاتلاً للبشر والخيول والطيور)",
 "west nile encephalitis virus": "فيروس التهاب الدماغ غرب النيل, فيروس غرب النيل (الفيروس المصفر الذي يسبب التهاب الدماغ (حمى غرب النيل))",
 "west nile virus": "فيروس التهاب الدماغ غرب النيل, فيروس غرب النيل (الفيروس المصفر الذي يسبب التهاب الدماغ (حمى غرب النيل))",
 "west northwest": "الغَرْب الشَّمَالِيّ الغَرْبِيّ, غَرْب شَمَال غَرْب (نقطة البوصلة في منتصف المسافة بين الغرب والشمال الغربي)",
 "west saxon": "الجنوبية الغربية, الساكسونية الغربية (لهجة من الإنجليزية الوسطى، كان يتم التحدث بها في المنطقة الواقعة غرب ساسكس وجنوب وجنوب غرب نهر التايمز) / الساكسونية الغربية (لهجة أدبية للإنجليزية القديمة) / سكسوني غربي (أحد سكان ويسيكس)",
 "west side": "الجانب الغربي (الجانب الذي يقع في الغرب)",
 "west southwest": "الغَرْب الجَنُوبِيّ الغَرْبِيّ, غَرْب جَنُوب غَرْب (نقطة البوصلة في منتصف المسافة بين الغرب والجنوب الغربي)",
 "west tocharian": "التوخارية الغربية, كوتشيان (لهجة من التوخارية، خاصة بكوتشا وقراشهر وتوربان)",
 "west virginia": "فِيرْجِينْيَا اَلْغَرْبِيَّة",
 "west virginian": "غرب فيرجيني (مواطن أو مقيم في فرجينيا الغربية)",
 "west wind": "رياح غربية (رياح تهب من الغرب إلى الشرق)",
 "west-central": "وَسَطِيّ (من منطقة في الولايات المتحدة تشمل عادة كولورادو ونيفادا ويوتا)",
 "west-sider": "ساكن الجانب الغربي (أحد سكان الجانب الغربي من مانهاتن في مدينة نيويورك)",
 "westbound": "مُتَّجِهٌ غَرْباً (يتحرّك نحو الغرب)",
 "westcentrism": "مَرْكَزِيَّة غَرْبِيَّة",
 "wester": "رياح غربية (رياح تهب من الغرب إلى الشرق)",
 "westerly": "غَرْبِيًّا, مِن الغَرْب (من الغرب) / بِاتِّجَاه الغَرْب (في اتجاه الغرب) / مُتَّجِهٌ غَرْباً (يتحرّك نحو الغرب) / غَرْبِيّ (قادم من الغرب؛ يُستخدم عن الرياح)\nمثال: هبت الرياح غربياً",
 "western": "غَرْبِيّ / وِيسْتَرْن, الْغَرْب",
 "western australia": "أُسْتْرَالِيَا الْغَرْبِيَّة, أُوسْتُرَالِيَا الْغَرْبِيَّة (دولة في أوقيانوسيا؛ اسمها الرسمي كومنولث أستراليا؛ (في الجيولوجيا) قارة أستراليا-غينيا الجديدة؛ تُعتبر غينيا الجديدة أيضًا جزءًا من قارة أستراليا جيولوجيًّا بما أنها تقع على الصفيحة التكتونية…)\nمثال: جين من أستراليا.",
 "western australia coral pea": "بازلاء مرجانية غرب أستراليا, هاردنبيرجيا (متسلق قوي في غابات غرب أستراليا؛ يزرع لعناقيده الكثيفة من الزهور الأرجوانية الوردية الزاهية الجذابة)",
 "western ax": "فأس مزدوجة الحد (فأس لها حواف قاطعة على كلا جانبي الرأس)",
 "western axe": "فأس مزدوجة الحد (فأس لها حواف قاطعة على كلا جانبي الرأس)",
 "western balsam poplar": "خشب القطن الأسود (خشب قطن من غرب أمريكا الشمالية بأوراق خضراء داكنة لامعة من الأعلى وصدئة أو فضية من الأسفل)",
 "western big-eared bat": "خفاش غربي كبير الأذن (خفاش يعيش في غرب أمريكا الشمالية له أذنان كبيرتان للغاية)",
 "western birch": "بتولا المستنقعات, بتولا مائية (بتولا من غرب الولايات المتحدة تشبه البتولا الورقية ولكن لها لحاء بني)",
 "western black-legged tick": "قراد أسود الأرجل الغربي (قراد يتغذى على جرذ الخشب داكن القدمين ويعض البشر؛ ناقل رئيسي لداء لايم في غرب الولايات المتحدة وخاصة شمال كاليفورنيا)",
 "western blackberry": "عليق غربي (عليق أمريكي بفاكهة سوداء مستطيلة)",
 "western blind snake": "ثعبان أعمى غربي (يحفر بين جذور الشجيرات وتحت الصخور في المناطق الصحراوية والتلال الصخرية ورمال الشواطئ في غرب الولايات المتحدة)",
 "western box turtle": "سلحفاة صندوقية غربية (سلحفاة براري بشكل أساسي من غرب الولايات المتحدة وشمال المكسيك)",
 "western buttercup": "حوذان غربي (نبات معمر من غرب أمريكا الشمالية)",
 "western chimpanzee": "شمبانزي غربي (شمبانزي مقنع أو شاحب الوجه في غرب أفريقيا؛ يرتبط بصلة بعيدة بالشمبانزي الشرقي والمركزي؛ ربما يكون نوعاً منفصلاً)",
 "western chokecherry": "كرز مخنوق غربي (كرز مخنوق من غرب الولايات المتحدة)",
 "western church": "الكاثوليكية الرومانية, الكنيسة الرومانية الكاثوليكية (الكنيسة المسيحية التي مقرها الفاتيكان ويرأسها البابا وتسلسل هرمي أسقفي)",
 "western civilization": "الثقافة الغربية, الحضارة الغربية (الثقافة الحديثة لأوروبا الغربية وأمريكا الشمالية)",
 "western concert flute": "ناي الحفلات الغربي, ناي بوهيم (ناي الحفلات الغربي (يسمى أيضاً الناي المستعرض أو ناي بوهيم) هو آلة نفخ خشبية تُعزف من الجانب ومصنوعة من المعدن أو الخشب)",
 "western coral snake": "ثعبان مرجاني غربي (يمتد نطاقه من أمريكا الوسطى إلى جنوب غرب الولايات المتحدة)",
 "western crab apple": "تفاح آيوا البري, تفاح البراري البري (تفاح بري من غرب الولايات المتحدة بزهور وردية عطرة)",
 "western culture": "الثقافة الغربية, الحضارة الغربية (الثقافة الحديثة لأوروبا الغربية وأمريكا الشمالية)",
 "western dewberry": "عليق غربي (عليق أمريكي بفاكهة سوداء مستطيلة)",
 "western diamondback": "أفعى جرسية ماسية الظهر الغربية (أكبر وأخطر ثعبان في أمريكا الشمالية؛ يعيش في جنوب غرب الولايات المتحدة والمكسيك)",
 "western diamondback rattlesnake": "أفعى جرسية ماسية الظهر الغربية (أكبر وأخطر ثعبان في أمريكا الشمالية؛ يعيش في جنوب غرب الولايات المتحدة والمكسيك)",
 "western europe": "أُورُوبَّا الْغَرْبِيَّة (الجزء من يوراسيا الذي يقع غرب جبال الأورال، والمعتبر تقليديًّا قارة بحد ذاته، كما يقع شمال قارة إفريقيا، وغرب قارة آسيا، وشرق المحيط الأطلسي؛ كيان سياسي؛ الاتحاد الأوروبي)\nمثال: ذهبت إلى أوروبا مرة.",
 "western fence lizard": "سحلية السياج الغربية (سحلية غربية شائعة؛ تُشاهد على جذوع الأشجار أو الصخور)",
 "western gray squirrel": "سنجاب رمادي غربي (سنجاب رمادي كبير من المناطق الغربية البعيدة للولايات المتحدة)",
 "western grey squirrel": "سنجاب رمادي غربي (سنجاب رمادي كبير من المناطق الغربية البعيدة للولايات المتحدة)",
 "western hemisphere": "المغرب, نصف الكرة الغربي (نصف الكرة الذي يشمل أمريكا الشمالية وأمريكا الجنوبية)",
 "western hemlock": "تسوغا غربية (شجرة دائمة الخضرة طويلة من غرب أمريكا الشمالية؛ شجرة خشب مهمة تجارياً)",
 "western holly fern": "سرخس البهشية الغربي (سرخس أمريكي شمالي، يعرف أيضاً بأسماء سرخس البهشية الجبلي وسرخس السيف الصخري)",
 "western honey mesquite": "بروسوبس غدي, مسكيت العسل (شجيرة شائكة عميقة الجذور مقاومة للجفاف موطنها جنوب غرب الولايات المتحدة والمكسيك تحمل قروناً غنية بالسكر ومهمة كعلف للماشية؛ تميل إلى تشكيل غابات…)",
 "western kingbird": "ملك الطيور الغربي (طائر يُرى في غرب الولايات المتحدة؛ الرأس والظهر رماديان شاحبان والصدر مصفر والذيل أسود)",
 "western ladies' tresses": "جدائل السيدة الغربية",
 "western larch": "أرزية غربية (أرزية طويلة من غرب أمريكا الشمالية لها أوراق خضراء شاحبة حادة الرؤوس ومخاريط مستطيلة؛ شجرة خشب مهمة)",
 "western lowland gorilla": "غوريلا السهول الغربية",
 "western malayo-polynesian": "اللغات الملايو بولينيزية الغربية (عائلة فرعية غربية من اللغات الملايو بولينيزية)",
 "western meadowlark": "قبرة المروج الغربية (قبرة مروج من غرب أمريكا الشمالية)",
 "western mountain ash": "مران الجبل الغربي (مران من الساحل الغربي لأمريكا الشمالية)",
 "western mugwort": "شيح لويزيانا, مريمية بيضاء (عشب معمر أبيض قطني من جنوب غرب الولايات المتحدة)",
 "western narrow-mouthed toad": "علجوم ضيق الفم الغربي (علجوم سري صغير بجلد ناعم قوي من وسط وغرب أمريكا الشمالية)",
 "western omelet": "عجة ويسترن (عجة متماسكة تحتوي على مكعبات اللحم والفلفل والبصل)",
 "western paper birch": "بتولا المستنقعات, بتولا مائية (بتولا من غرب الولايات المتحدة تشبه البتولا الورقية ولكن لها لحاء بني)",
 "western pasqueflower": "زهرة الفصح الغربية (نوع نباتي عشبي من غرب أمريكا الشمالية)",
 "western pipistrel": "خفاش بيبيستريل غربي (خفاش من غرب أمريكا الشمالية)",
 "western poison oak": "بلوط سام غربي (شجيرة سامة في ساحل المحيط الهادئ لأمريكا الشمالية تسبب طفحاً جلدياً عند اللمس)",
 "western poppy": "خشخاش غربي, خشخاش كاليفورنيا (نبات سنوي مبهرج في كاليفورنيا بزهور حمراء)",
 "western prince's pine": "حب في الشتاء, صنوبر الأمير الغربي (عشبة أوراسية بأزهار بيضاء أو وردية في عذقة طرفية)",
 "western ragweed": "دمسيسة غربية, رجيد معمر (رجيد معمر خشن ذو جذور زاحفة في الأراضي الجرداء الجافة بجنوب غرب الولايات المتحدة والمكسيك)",
 "western rattlesnake": "أفعى جرسية البراري (واسعة الانتشار بين المسيسيبي وجبال روكي)",
 "western red cedar": "أرز أحمر غربي, عفص مطوي (عفص كبير قيم من شمال غرب الولايات المتحدة)",
 "western red-backed salamander": "سمندل أحمر الظهر الغربي (سمندل من ساحل المحيط الهادئ لأمريكا الشمالية)",
 "western redbud": "زمزريق غربي, زمزريق كاليفورنيا (شجيرة من غرب الولايات المتحدة ذات أزهار وردية أو قرمزية؛ غالباً ما تشكل غابات كثيفة)",
 "western ribbon snake": "ثعبان الشريط الغربي (ثعبان مخطط بالأصفر أو المحمر يعيش في الغابات المعتدلة والمراعي حتى المناطق الاستوائية)",
 "western saddle": "سرج غربي (سرج مزخرف يستخدمه رعاة البقر؛ له قرن مرتفع لحمل الوهق)",
 "western sahara": "الصَّحْرَاء الْغَرْبِيَّة",
 "western samoa": "سَامُوَا الْغَرْبِيَّة",
 "western samoan monetary unit": "وحدة نقدية لساموا الغربية (الوحدة النقدية في ساموا الغربية)",
 "western sand cherry": "كرز الرمل الغربي (شجيرة زينة قزمية من غرب الولايات المتحدة لها ثمار صالحة للأكل كبيرة سوداء إلى حمراء وصفراء حلوة)",
 "western sandwich": "شطيرة ويسترن (شطيرة مصنوعة من عجة ويسترن (بيض مع خضار ولحم))",
 "western saxifrage": "كاسر الحجر الغربي (كاسر حجر له عناقيد رخوة من الزهور البيضاء على سيقان مشعرة تنمو من عنقود من الأوراق القاعدية؛ المنحدرات الرطبة في غرب أمريكا الشمالية)",
 "western silvery aster": "أستر فضي غربي",
 "western skink": "سقنقور غربي (يوجد في المراعي والغابات المفتوحة في غرب أمريكا الشمالية)",
 "western spadefoot": "علجوم قدم المجرفة الغربي (يعيش هذا العلجوم ذو قدم المجرفة في كاليفورنيا)",
 "western tamarack": "أرزية غربية (أرزية طويلة من غرب أمريكا الشمالية لها أوراق خضراء شاحبة حادة الرؤوس ومخاريط مستطيلة؛ شجرة خشب مهمة)",
 "western tanager": "تناجر غربي (من غرب أمريكا الشمالية؛ الذكر أسود وأصفر وبرتقالي محمر)",
 "western toad": "علجوم غربي (من مجموعة كبيرة ومتنوعة من الموائل من جنوب ألاسكا إلى باجا كاليفورنيا غرب جبال روكي)",
 "western wall": "حَائِط الْبُرَاق, حَائِط الْغَرْبِي",
 "western wall flower": "زهرة الجدار الغربية (صاروخ البراري ثنائي الحول أو قصير العمر المعمر له زهور صفراء برتقالية؛ غرب أمريكا الشمالية إلى مينيسوتا وكانساس؛ يوضع أحياناً في جنس خيري)",
 "western wheatgrass": "عشبة القمح الغربية (عشبة علف قيمة في غرب الولايات المتحدة)",
 "western whiptail": "سحلية السوط الغربية (سحلية نشطة تتميز بشبكة من العلامات الداكنة القاتمة؛ تعيش في المناطق شبه القاحلة من أوريغون وأيداهو إلى باجا كاليفورنيا)",
 "western white pine": "صنوبر أبيض غربي, صنوبر فضي (صنوبر طويل من غرب أمريكا الشمالية بإبر زرقاء خضراء قوية؛ اللحاء رمادي بني بصفائح مستطيلة عند النضج)",
 "western wood pewee": "بيوي الغياض الغربي (صائد ذباب صغير من غرب أمريكا الشمالية)",
 "western yellow pine": "صنوبر أصفر غربي, صنوبر بونديروسا (صنوبر خشب طويل شائع وواسع الانتشار في غرب أمريكا الشمالية له إبر خضراء داكنة في حزم من 2 إلى 5 ولحاء سميك بصفائح بنية داكنة عند النضج)",
 "western yew": "طقسوس المحيط الهادئ (شجرة صغيرة أو متوسطة غير منتظمة التفرع من ساحل المحيط الهادئ لأمريكا الشمالية؛ تنتج خشباً ناعماً صلباً متقارب الحبيبات)",
 "westerner": "غَرْبِيّ",
 "westernisation": "تغريب (استيعاب الثقافة الغربية؛ العملية الاجتماعية المتمثلة في التعرف على عادات وممارسات الحضارة الغربية أو التحول إليها)",
 "westernization": "تَغْرِيب",
 "westernmost": "أَقْصَى الغَرْب (الأبعد باتّجاه الغرب)",
 "westland pine": "صنوبر فضي, صنوبر ويستلاند (شجرة خشبية في نيوزيلندا ذات خشب أبيض لامع)",
 "westminster abbey": "دَيْر وِسْتْمِنْسْتَر, كَنِيسَة وِسْتْمِنْسْتَر (بيت يسكنه الرُهْبَان أو الرَاهِبَات ممن كان على دين المسيحية)\nمثال: سيداتي و سادتي ، رجاء قفوا للنشيد الوطني للاتحاد الروسي باداء جوقة دير سرتينسكي .",
 "westminster cathedral": "كَاتِدْرَائِيَّة وِسْتْمِنْسْتَر",
 "westmost": "أَقْصَى الغَرْب (الأبعد باتّجاه الغرب)",
 "weston cell": "خلية ويستون (خلية فولتية قياسية (علامة تجارية ويستون))",
 "westphalia": "وِسْتْفَالِيَا, وَسْتْفَالِيَا",
 "westside": "فِي الجَانِبِ الغَرْبِيّ (من الجزء الغربيّ لمدينة ما)",
 "westward": "بِاتِّجَاه الغَرْب, غَرْبًا (نحو الغرب) / مُتَّجِهٌ غَرْباً (يتحرّك نحو الغرب) / الغَرْب (نقطة البوصلة الأصلية التي تكون عند 270 درجة)\nمثال: سافروا غرباً نحو غروب الشمس",
 "westwards": "بِاتِّجَاه الغَرْب, غَرْبًا (نحو الغرب)\nمثال: سافروا غرباً نحو غروب الشمس",
 "wet": "مُبْتَلّ / مَبْلُول, مُبْتَلّ",
 "wet bar": "بار مجهز بمغسلة (بار لخلط المشروبات يحتوي على حوض بمياه جارية)",
 "wet blanket": "ثقيل الظل, مفسد البهجة (شخص يفسد متعة الآخرين)",
 "wet cell": "بطارية سائلة, خلية رطبة (خلية فولتية أولية تحتوي على إلكتروليت سائل)",
 "wet dream": "احتلام (حلم جنسي (عادة في الليل) مصحوب بقذف (ليلي) للمني)",
 "wet fly": "طعم ذبابة غاطس (طعم صيد صناعي يطفو تحت سطح الماء)",
 "wet lung": "رئة رطبة, متلازمة الضائقة التنفسية الحادة (إصابة رئوية حادة تتميز بالسعال والخرخرة؛ التهاب في الرئتين اللتين تصبحان صلبتين وليفيتين ولا تستطيعان تبادل الأكسجين)",
 "wet nurse": "ظِئْر, دَايَة (العاطفة على غير ولدها المرضعة له من الناس والإبل وغيرها. الذكر والأنثى في ذلك سواء)",
 "wet suit": "بدلة غطس, بدلة مبللة (رداء محكم القياس مصنوع من مادة نفاذة؛ يرتدى في الماء البارد (كما من قبل الغواصين) للحفاظ على حرارة الجسم)",
 "wet-bulb thermometer": "مقياس حرارة مبلل (مقياس حرارة بصيلة مغطاة بقماش شاش رطب؛ يستخدم في الهيجرومتر (مقياس الرطوبة) لقياس الرطوبة)",
 "wet-nurse": "مرضعة (امرأة تُستأجر لإرضاع طفل شخص آخر)",
 "wetback": "غريسر ((افتراء عرقي) مصطلح مهين لشخص من أصل مكسيكي)",
 "wether": "خروف مخصي (ذكر الخروف خاصة المخصي)",
 "wetland": "أرض رطبة (منطقة منخفضة تكون الأرض فيها مشبعة بالماء)",
 "wetness": "بلل, رطوبة (حالة احتواء سائل أو التغطية به (خاصة الماء))\nمثال: أكد بلل سروال السباحة",
 "wetnurse": "مرضعة (امرأة تُستأجر لإرضاع طفل شخص آخر)",
 "wetter": "بَوَّال فِي الْفِرَاش (شخص يعاني من سلس البول؛ شخص يتبول أثناء النوم في الفراش) / مرطّب (عامل يرطب العمل في عملية التصنيع) / خافض التوتر السطحي, عامل ترطيب (عامل كيميائي قادر على تقليل التوتر السطحي للسائل الذي يذوب فيه)",
 "wetting": "تبليل, ترطيب (فعل جعل الشيء مبللاً) / تبول (تعبير مخفف للتبول)",
 "wetting agent": "خافض التوتر السطحي, عامل ترطيب (عامل كيميائي قادر على تقليل التوتر السطحي للسائل الذي يذوب فيه)",
 "weymouth pine": "صنوبر أبيض أمريكي, صنوبر أبيض شرقي (صنوبر طويل النمو من شرق أمريكا الشمالية؛ اللحاء بني بشقوق طولية عند النضج؛ يقدر كشجرة خشب)",
 "whack": "قَتَلَ (تعمّد جعله يَمُوتُ، أزهق روحه، أمَاتَه متعمدا؛ الوقتَ: ضيعه بشيء غير ذي فائدة وهو ينتظر أمرا آخر)\nمثال: قتل الصياد دبا.",
 "whacked": "مَنْهُوك, مُتْعَب جِدًّا ((عامّيّة بريطانيّة) منهك أو متهالك)",
 "whacker": "شيء ضخم, شيء هائل (شيء كبير أو مثير للإعجاب بشكل خاص من نوعه)",
 "whacking": "بشكل هائل (إلى حد غير طبيعي) / جلد, ضرب (فعل إيقاع العقاب البدني بضربات متكررة) / ضَخْم ((عامّيّة بريطانيّة) هائل الحجم)\nمثال: قصة جيدة بشكل هائل",
 "whacko": "مَجْنُون, مَخْبُول (شخص يعتبر غريب الأطوار أو مجنوناً)",
 "whacky": "مَخْبُول, مَعْتُوه ((غير رسمي) مصطلحات عامّيّة تصف الاضطراب العقليّ) / أَبْلَه, مُهَرِّج (مضحك بسخافته وحماقته)",
 "whale": "حُوت (سمكة صَغيرة كانت أو كبيرة؛ حوت كبير: صاحب مال وسَطْوَة ونفوذ)\nمثال: هل الحوت من الثدييات؟",
 "whale louse": "قمل الحوت (قشري من مزدوجات الأرجل يتطفل على الحيتان)",
 "whale oil": "زيت الحوت (زيت أبيض إلى بني يتم الحصول عليه من شحم الحوت؛ كان يستخدم سابقاً للإضاءة)",
 "whale shark": "قرش حوت (قرش مرقط كبير يعيش في المياه السطحية الدافئة في جميع أنحاء العالم؛ يشبه الحوت ويتغذى بشكل رئيسي على العوالق)",
 "whale sucker": "ماصة الحوت (ريمورا زرقاء كبيرة في المحيط الهادئ تلتصق بالحيتان والدلافين)",
 "whaleboat": "قارب صيد الحيتان (قارب ضيق طويل مصمم للدوران السريع والاستخدام في البحار الهائجة)",
 "whalebone": "بالين, عظم الحوت (مادة قرنية من الفك العلوي لبعض الحيتان؛ تستخدم كأضلاع للمراوح أو كدعامات في المشدات)",
 "whalebone whale": "حوت باليني (حوت ذو صفائح بالين على طول الفك العلوي لتصفية العوالق من الماء)",
 "whaler": "سفينة صيد الحيتان (سفينة تعمل في صيد الحيتان) / صائد الحيتان (بحار يعمل على سفينة تصطاد الحيتان)",
 "whalesucker": "ماصة الحوت (ريمورا زرقاء كبيرة في المحيط الهادئ تلتصق بالحيتان والدلافين)",
 "whaling": "صَيْد اَلْحِيتَان",
 "whaling gun": "بندقية صيد الحيتان (بندقية (أو جهاز يشبه البندقية) لإطلاق قذيفة (خاصة الحراب) على الحوت)",
 "whaling ship": "سفينة صيد الحيتان (سفينة تعمل في صيد الحيتان)",
 "whammy": "لعنة, نحس (تعويذة شريرة) / ضربة قاصمة, نكسة شديدة (نكسة خطيرة أو مدمرة)\nمثال: وضعت ساحرة لعنة على عائلته بأكملها",
 "whang": "خبطة, طرحة (فعل الضرب بقوة)\nمثال: ضرب الطاولة خبطة قوية",
 "wharf": "رَصِيف",
 "wharf rat": "جرذ الأرصفة (جرذ بني يغزو الأرصفة البحرية) / لص الأرصفة (شخص يعيش بالقرب من الأرصفة ويعيش على السرقة من السفن أو المستودعات)",
 "wharfage": "رصيف بحري, مرفأ (منصة مبنية من الشاطئ إلى الماء ومدعومة بأعمدة؛ توفر الوصول للسفن والقوارب) / رسوم الرصيف (رسم يُفرض لاستخدام رصيف الميناء)",
 "what": "يَا لَ (يستعمل لنِدَاء البعيد والقريب) / مَا (انظر مَا) / مَاذَا, مَا (أداة استفهام)\nمثال: يا لها من جملة!",
 "what a pity": "يَا خَسَارَة, يَا لَلْأَسَف (يستعمل لنِدَاء البعيد والقريب)\nمثال: يا لها من جملة!",
 "what are you doing": "مَاذَا تَفْعَلُ؟ (أداة استفهام) / مَاذَا تَفْعَلِينَ؟ (أداة استفهام) / مَاذَا تَعْمَلُ؟ (أداة استفهام) / مَاذَا تَعْمَلِينَ؟ (أداة استفهام)\nمثال: ماذا تريد الآن؟",
 "what date is it today": "مَا تَارِيخُ ٱلْيَوْم؟ (انظر مَا)\nمثال: هلا! ما الجديد؟",
 "what does … mean": "مَاذَا يَعْنِي …؟ (أداة استفهام)\nمثال: ماذا تريد الآن؟",
 "what doesn't kill you makes you stronger": "مَا لَا يَقْتُلُكَ يَجْعَلُكَ أَقْوَى, مَا لَا يَقْتُلُكِ يَجْعَلُكِ قُويَا (انظر مَا)\nمثال: هلا! ما الجديد؟",
 "what for": "لِمَ, لِمَاذَا (جَمَعَ، ضَمَّ)\nمثال: لم يساعدني أحد.",
 "what goes around comes around": "كَمَا تَدِينُ تُدَان",
 "what hath god wrought": "مَا شَاءَ ٱللّٰهُ (انظر مَا)\nمثال: هلا! ما الجديد؟",
 "what is her name": "مَا اسْمُهَا (انظر مَا)\nمثال: هلا! ما الجديد؟",
 "what is more": "عِلَاوَة عَلَى ذٰلِكَ",
 "what is that": "مَا هٰذَا؟ (انظر مَا)\nمثال: هلا! ما الجديد؟",
 "what is the wi-fi password": "مَا هِيَ كَلِمَةُ مُرُورِ الوَاي فَاي؟ (انظر مَا)\nمثال: هلا! ما الجديد؟",
 "what is your name": "مَا ٱسْمُكَ؟, مَا ٱسْمُكِ؟ (انظر مَا)\nمثال: هلا! ما الجديد؟",
 "what languages do you speak": "مَا هِيَ اللُّغَات اَلَّتِي تَتَكَلَّمُهَا؟, مَا هِيَ اللُّغَات اَلَّتِي تَتَكَلَّمِينَهَا؟ (انظر مَا)\nمثال: هلا! ما الجديد؟",
 "what the fuck": "ما نكح (انظر مَا) / مثال: هلا! ما الجديد؟",
 "what the hell": "مَاذَا بِحَقّ اَلسَّمَاء (أداة استفهام)\nمثال: ماذا تريد الآن؟",
 "what time is it": "كَمِ ٱلسَّاعَةُ؟, أَيَّةُ سَاعَةٍ هٰذِهِ؟",
 "what with": "حَيْث, لِأَن",
 "what would you like": "مَاذَا تُرِيدُ؟, مَاذَا تُرِيدِينَ؟ (أداة استفهام)\nمثال: ماذا تريد الآن؟",
 "what's done is done": "مَا حَدَثَ قَد حَدَثَ, مَا فَاتَ قَدْ مَاتْ (انظر مَا)\nمثال: هلا! ما الجديد؟",
 "what's it to you": "أنت مالك؟ (أنْتَ ضَميرُ رَفْعٍ مُنْفَصِلٌ لِلْمُخاطَبِ وَالْمُخاطَبَةِ)\nمثال: أنت لست صديقنا.",
 "what's on your mind": "بماذا تفكر به؟",
 "what's the matter": "مَاذَا حَدَثَ؟, مَا الْخَطْب؟ (أداة استفهام)\nمثال: ماذا تريد الآن؟",
 "what's your job": "مَا عَمَلُك؟ (انظر مَا)\nمثال: هلا! ما الجديد؟",
 "what's your phone number": "مَا رَقْمُ هَاتِفِكَ؟, مَا رَقْمُ هَاتِفِكِ؟ (انظر مَا)\nمثال: هلا! ما الجديد؟",
 "what's-his-name": "مَا اِسْمَهُ (انظر مَا)\nمثال: هلا! ما الجديد؟",
 "whatchamacallit": "أداة, أداة مبهمة الاسم (شيء غير محدد تم نسيان اسمه أو غير معروف)\nمثال: أعادت الأداة كروية الشكل إلى مكانها",
 "whatchamacallum": "أداة, أداة مبهمة الاسم (شيء غير محدد تم نسيان اسمه أو غير معروف)\nمثال: أعادت الأداة كروية الشكل إلى مكانها",
 "whatever": "أَيّ, أَيَّمَا (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير) / مَهْمَا مَا / طُز\nمثال: لم تقصد أي أذى.",
 "whatever may come": "مهما حدث, مهما كانت الظروف (رغم كل العقبات)\nمثال: سنذهب إلى التبت مهما حدث",
 "whatnot": "تحف صغيرة, حلي رخيصة (تحف متنوعة صغيرة)",
 "whatsapp": "واتساب",
 "whatsis": "أداة, أداة مبهمة الاسم (شيء غير محدد تم نسيان اسمه أو غير معروف)\nمثال: أعادت الأداة كروية الشكل إلى مكانها",
 "whatsoever": "أَيّ (واحد أو بعض أو كلّ دون تحديد؛ مُبهَم الدلالة)",
 "wheal": "أثر ضربة, انتبار (علامة بارزة على الجلد (تنتج عن ضربة سوط مثلاً)؛ سمة مميزة للعديد من ردود الفعل التحسسية)",
 "wheat": "قَمْح, حِنْطَة",
 "wheat beer": "بيرة القمح, بيرة بيضاء (اسم عام للبيرة المصنوعة من القمح بالتخمير العلوي؛ عادة ما تكون شاحبة جداً وغائمة وفوارة)",
 "wheat berry": "حنطة, قمح (حبوب القمح الشائع؛ تطهى أحياناً كاملة أو مجروشة كحبوب إفطار؛ وتطحن عادة لتصبح دقيقاً) / حبة قمح (حبة من القمح)",
 "wheat eel": "دودة القمح (دودة أسطوانية صغيرة تتطفل على القمح)",
 "wheat eelworm": "دودة القمح (دودة أسطوانية صغيرة تتطفل على القمح)",
 "wheat field": "حقل قمح (حقل مزروع بالقمح)",
 "wheat flag smut": "تفحم علم القمح (فطر يصيب أوراق وسيقان القمح)",
 "wheat flour": "دقيق القمح, طحين القمح (ضد الغَلِيْظ، الرَفِيْع الرَقِيْق؛ صغير الحجم جدا)\nمثال: ساعتي غير دقيقة.",
 "wheat future": "عقود القمح الآجلة (قمح يتم شراؤه أو بيعه بسعر متفق عليه للتسليم في تاريخ مستقبلي محدد)",
 "wheat germ": "جنين القمح (جنين حبة القمح؛ يُزال قبل الطحن ويؤكل كمصدر للفيتامينات)",
 "wheat gluten": "غلوتين القمح (غلوتين محضر من القمح)",
 "wheat rust": "صدأ القمح (فطر صدأ يهاجم القمح)",
 "wheat scab": "جرب القمح (مرض يصيب رؤوس نباتات القمح)",
 "wheat-grass": "عشب القمح (عشب من جنس أجرو بيرون)",
 "wheatear": "أبلق (طائر مغرد صغير من شمال أمريكا وأوراسيا يتميز بكفل أبيض مميز)",
 "wheately elm": "دردار جيرسي (صنف من الدردار الإنجليزي بفروع قائمة وأوراق أعرض)",
 "wheaten": "قمحي (من أو متعلق أو مشتق من القمح)\nمثال: خبز قمحي",
 "wheatfield": "حقل قمح (حقل مزروع بالقمح)",
 "wheatflake": "رقائق القمح (رقاقة مقرمشة مصنوعة من القمح)",
 "wheatgrass": "عشب القمح (عشب من جنس أجرو بيرون)",
 "wheatstone bridge": "قنطرة ويتستون (قنطرة كهربائية تستخدم لقياس المقاومات)",
 "wheatworm": "دودة القمح (دودة أسطوانية صغيرة تتطفل على القمح)",
 "wheedler": "متملق, مدّاح (شخص يحاول الإقناع بالتملق والملاطفة)",
 "wheedling": "تملق, مداهنة (فعل الحث عن طريق الملاطفة أو الإطراء)",
 "wheel": "عَجَلَة / عجلة / رويضة",
 "wheel and axle": "العجلة والمحور, الملفاف (رافعة مرتبة بحيث يُلف حبل ينفك من عجلة على أسطوانة أو عمود متحد المحور مع العجلة)",
 "wheel bug": "بق العجلة (بق مفترس كبير من أمريكا الشمالية يمتص دماء الحشرات الأخرى)",
 "wheel chart": "مخطط عجلة (مخطط انزلاقي دائري يحتوي على أجزاء دوارة)",
 "wheel clamp": "مشبك العجلة",
 "wheel fiddle": "قيثارة العجلة, هردي قردي (آلة وترية تنتج الأصوات عن طريق عجلة تحتك بالأوتار)",
 "wheel horse": "حصان العجلة (حصان جر يُربط خلف الآخرين ويكون الأقرب لعجلات المركبة)",
 "wheel lathe": "مخرطة عجلات (مخرطة لخرط عجلات عربات السكك الحديدية والقاطرات)",
 "wheel lock": "قفل العجلة (قفل بندقية قديم يستخدم الصوان وعجلة دوارة)",
 "wheel of fortune": "عجلة الحظ",
 "wheel spoke": "برمق, سلك العجلة (دعامة تتكون من عضو شعاعي لعجلة يربط المحور بالحافة)",
 "wheel tree": "شجرة العجلة, شجرة عجلة النار (شجرة من شرق أستراليا تزرع على نطاق واسع كشجرة ظل ولأوراقها اللامعة وعناقيدها الدائرية من الزهور الحمراء إلى البرتقالية القرمزية المبهرجة)",
 "wheel-like": "شَبِيهٌ بِالعَجَلَة (مستدير كالعجلة في شكله)",
 "wheelbarrow": "عَرَبَة يَدَوِيَّة, عَجَلَة يَد",
 "wheelbase": "قَاعِدَة العَجَلَات (المسافة من مركز العجلة الأمامية للسيارة إلى المحور الخلفي)",
 "wheelchair": "كُرْسِيّ لِلْمُقْعَدِين, كُرْسِيّ مُتَحَرِّك (مَقْعَد لواحد؛ العِلْم. يقال هو من أهل الكُرسِيّ أي أهل العِلم)\nمثال: أحب ذاك الكرسي.",
 "wheeled": "ذو عجلات, مُعجَّل (له عجلات؛ غالبًا ما تستخدم في المركبات)",
 "wheeled forecarriage": "عربة أمامية (عربة صغيرة بعجلات متصلة أسفل الطرف الأمامي لعارضة المحراث)",
 "wheeled vehicle": "مركبة بعجلات (مركبة تتحرك على عجلات ولها عادة حاوية لنقل الأشياء أو الأشخاص)\nمثال: أقدم المركبات ذات العجلات المعروفة عُثر عليها في سومر وسوريا وتعود إلى حوالي 3500 قبل الميلاد",
 "wheeler": "حصان العجلة (حصان جر يُربط خلف الآخرين ويكون الأقرب لعجلات المركبة) / دراج, راكب دراجة (شخص يركب دراجة هوائية) / الرجل الطرفي (الرجل في أقصى طرف الصف أثناء الدوران) / صانع العجلات (شخص يصنع ويصلح العجلات الخشبية)",
 "wheeler dealer": "داهية, محتال ذكي (شخص ذكي أو عديم المبادئ يعرف كيفية التحايل على الصعوبات لتحقيق أهدافه)",
 "wheelhouse": "غرفة القيادة, قمرة القيادة (مقصورة مغلقة يمكن من خلالها توجيه السفينة) / صميم التخصص, مجال الخبرة (مجال اهتمام الفرد أو خبرته)\nمثال: مع تحول الحملة إلى الجنوب، يجب أن يكون ذلك في صميم تخصصه",
 "wheeling": "تحريك بالعجلات, دحرجة (دفع شيء على عجلات)",
 "wheelless": "بلا عجلات (ليس له عجلات أو ليس لديه مركبات ذات عجلات)\nمثال: جر زلاجة حجرية بلا عجلات مليئة بالصخور",
 "wheelwork": "آلية تروس, مجموعة عجلات (جهاز ميكانيكي يتضمن ترتيباً للعجلات في آلة (خاصة سلسلة من التروس))",
 "wheelwright": "صانع العجلات (شخص يصنع ويصلح العجلات الخشبية)",
 "wheeze": "أزيز (التنفس مع صوت أجش أو صفير) / حيلة ذكية ((بريطانية) مخطط أو خدعة ذكية أو مسلية)\nمثال: حيلة ذكية نجحت على الأرجح في تحييد تهديد التجسس الألماني",
 "wheezily": "بأزيز, بصوت مبحوح (مع أزيز في التنفس)\nمثال: تحدث بصوت فيه أزيز",
 "wheeziness": "أزيز (وجود صوت غير طبيعي عالي النبرة يُسمع بسماعة الطبيب عند انسداد مجرى الهواء (كما في الربو أو التهاب الشعب الهوائية المزمن))",
 "wheezing": "أَزْمِيّ, رَبْوِيّ (مُتَعَلِّق بِالتَّنَفُّس بِصَوْت صَفير)",
 "wheezingly": "بأزيز, بصوت مبحوح (مع أزيز في التنفس)\nمثال: تحدث بصوت فيه أزيز",
 "wheezy": "أَزْمِيّ, رَبْوِيّ (مُتَعَلِّق بِالتَّنَفُّس بِصَوْت صَفير) / أَزِيزِيّ, نَاعِر (ذو نبرة تشبه صوت آلة القصب الموسيقية)",
 "whelk": "بوق, ويلك (بطنيات قدم بحرية لاحمة كبيرة تعيش في المياه الساحلية ومناطق المد والجزر ولها صدفة قوية تشبه الحلزون) / بوق, ويلك (حلزون بحري كبير يستخدم كثيراً كطعام في أوروبا)",
 "whelp": "جرو (صغير أي من الكلبيات المختلفة مثل الكلب أو الذئب)",
 "when": "مَتَى / إمتى / متى / امتى / فوقتاش / حِينَمَا, عِنْدَمَا",
 "when first seen": "للوهلة الأولى, من أول نظرة (كانطباع أولي)\nمثال: للوهلة الأولى بدا العرض جذاباً",
 "when in rome, do as the romans do": "عِنْدَمَا تَكُون فِي رُومَا، اِفْعَل مَا يَفْعَلَه الرُّومَان",
 "when push comes to shove": "عندما يجدّ الجدّ",
 "when the time comes": "في الوقت المناسب, في حينه (في الوقت الملائم)\nمثال: سنصل لهذه المسألة في الوقت المناسب",
 "whence": "أَنَّى, مِن أَيْن / مِن حَيْث (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "whenever": "مَتَى, مَتَى مَا / كُلَّمَا",
 "where": "أَيْن, فين / حَيْثُ",
 "where are we": "أَيْنَ نَحْنُ؟",
 "where are you": "أَيْنَ أَنْتَ؟, أَيْنَ أَنْتِ؟",
 "where are you from": "مِنْ أَيْنَ أَنْتَ؟, مِنْ أَيْنَ أَنْتِ؟ (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "where do you live": "أَيْنَ تَسْكُنُ؟, أَيْنَ تَسْكُنِينَ؟",
 "where does this bus go": "إِلَى أَيْنَ هِيَ ذَاهِبَةٌ هٰذِهِ الْحَافِلَة؟ (حرف جر يُفيد الغاية الزمنية؛ حرف جر يُفيد الغاية المكانية)\nمثال: تعال إلى منزلي.",
 "where is the toilet": "أَيْنَ الْمِرْحَاض؟, أَيْنَ الْحَمَّام؟",
 "where there is a will there is a way": "إِنَ مَفَاتِيحُ الأُمُورٍ العَزَائِمَ (يفيد التوكيد)\nمثال: إن شاء الله ؛",
 "where there's smoke, there's fire": "لَا دُخَانَ بِلَا نَار, أَيْنَمَا يُوجَدُ دُخَانٌ، تُوجَدُ نَار (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: لا أحب المدرسة.",
 "whereabouts": "مكان التواجد (الموقع العام الذي يوجد فيه شيء ما)\nمثال: سألته عن مكان تواجده ليلة الجريمة",
 "whereas": "عِنْدَمَا",
 "whereby": "الذي به, بذلك",
 "wherefore": "حيثية, سبب (السبب أو النية الكامنة وراء فعل أو موقف ما، خاصة في عبارة 'الأسباب والحيثيات')",
 "wheresoever": "أينما, حيثما (في أي مكان في العالم؛ الموقع، مفرد، ضمير وجودي اختياري)",
 "whereupon": "عِنْدَئِذٍ",
 "wherever": "أَيْنَ, أَيْنَمَا",
 "wherewithal": "إمكانيات, موارد ضرورية (الوسائل الضرورية (خاصة الوسائل المالية))",
 "wherry": "قارب تجديف خفيف (قارب تجديف خفيف يستخدم في السباقات أو لنقل البضائع والركاب في المياه الداخلية والموانئ) / قارب تجديف, قارب شحن نهري (صندل شراعي يستخدم بشكل خاص في شرق أنجليا)",
 "whet": "حَدَّدَ ((حَدَّدَ) على الشَّيْء: أَقَامَ لَهُ حدا؛ (حَدَّدَ) عَلى فلَان: مَنعه من حريَّة التَّصَرُّف) / شَحَذَ (سنّ شيئًا ليصبح حادًا أو أكثر قدرة على القطع؛ استثار أو حفّز قوة ذهنية أو عاطفية لتحقيق هدف معين)\nمثال: حدد له موعدا مع الطبيب.",
 "whether": "إِذَا مَا, إِذَا",
 "whetstone": "مِسَنّ, مِجْلَخَة",
 "whey": "شِرْش, مَاء الْجُبْن",
 "which": "أَيّ (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير) / مَما / اَلَّذِي\nمثال: لم تقصد أي أذى.",
 "whicker": "حمحة, صهيل (الأصوات المميزة التي يصدرها الحصان)",
 "whidah": "طائر الأرملة, ويداه (طائر نساج أفريقي أسود في الغالب)",
 "whiff": "نَسَمَة",
 "whiffer": "ضارب مخفق (ضارب يخرج من اللعبة عن طريق الأرجحة وتفويت الضربة الثالثة)",
 "whiffletree": "عارضة الجر, ميزان الجر (عارضة مستعرضة تُربط بزمام حصان الجر وبالمركبة أو الأداة التي يسحبها الحصان)",
 "whig": "يميني (عضو في حزب الويغ الذي كان موجوداً في الولايات المتحدة قبل الحرب الأهلية الأمريكية) / مؤيد للثورة, ويغ (مؤيد للثورة الأمريكية) / عضو حزب الويغ, ويغ (عضو في الحزب السياسي الذي حث على الإصلاح الاجتماعي في إنجلترا في القرنين الثامن عشر والتاسع عشر؛ كان حزب المعارضة للمحافظين (التوريز))",
 "whig party": "الويغ, حزب اليمين (حزب سياسي سابق في الولايات المتحدة؛ تشكل عام 1834 في معارضة للحزب الديمقراطي؛ دعا إلى تفسير فضفاض للدستور وتعريفات وقائية عالية)",
 "while": "مُدَّة / فَتْرَة / فِي حِين, بَيْنَمَا (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "whim": "نَزْوَة",
 "whimper": "أنين, تباكي (شكوى يتم التلفظ بها بطريقة شاكية وحزينة)",
 "whimsey": "تقلب, نزوة (سمة التصرف بشكل غير متوقع وبدافع نزوة أكثر منه بدافع العقل أو الحكم) / خاطرة غريبة, شطحة (فكرة غريبة أو خيالية أو متقلبة)\nمثال: أيأس من تقلب ونزوة ذاكرتي",
 "whimsical": "مِزَاجِيّ, نَزَوِيّ (مُحَدَّدٌ بِالصُّدْفَةِ أَوِ النَّزْوَةِ لَا بِالضَّرُورَةِ أَوِ العَقْل)",
 "whimsicality": "شيطنة, عفرتة (سمة التصرف مثل العفريت الصغير) / تقلب, نزوة (سمة التصرف بشكل غير متوقع وبدافع نزوة أكثر منه بدافع العقل أو الحكم)\nمثال: أيأس من تقلب ونزوة ذاكرتي",
 "whimsically": "بشكل جامح, بشكل خيالي (بطريقة خيالية ومبتكرة)\nمثال: تم تزيين شجرة عيد الميلاد بشكل خيالي",
 "whimsy": "تقلب, نزوة (سمة التصرف بشكل غير متوقع وبدافع نزوة أكثر منه بدافع العقل أو الحكم) / خاطرة غريبة, شطحة (فكرة غريبة أو خيالية أو متقلبة)\nمثال: أيأس من تقلب ونزوة ذاكرتي",
 "whin": "حَجَر صَلْد (أي من الصخور الملونة الصلبة المتنوعة (وخاصة الصخور المكونة من الصوان أو البازلت)) / جنيستا الصباغين, وزال الصباغين (شجيرة أوراسية صغيرة لها عناقيد من الزهور الصفراء التي تنتج صبغة؛ شائعة كعشب ضار في بريطانيا والولايات المتحدة؛ تزرع أحياناً للزينة) / جولق, وزال (شجيرة دائمة الخضرة شائكة وكثيفة جداً ذات زهور صفراء ذهبية عطرة؛ شائعة في جميع أنحاء أوروبا الغربية)",
 "whinberry": "توت أزرق أوروبي, عنب الأحراش (توت أزرق أوروبي قائم له زهور منفردة وتوت أزرق مسود)",
 "whinchat": "قليعي أحمر (طائر مغرد أوروبي بني وأصفر برتقالي يعيش في المروج العشبية)",
 "whine": "أنين, تباكي (شكوى يتم التلفظ بها بطريقة شاكية وحزينة)",
 "whiner": "بكاء, كثير الشكوى (شخص يميل إلى الشكوى المفرطة والبكاء والأنين)",
 "whiney": "كَثِيرُ التَّذَمُّر, نَكِد (كثير الشكوى والتذمّر بشكل معتاد)",
 "whinny": "حمحة, صهيل (الأصوات المميزة التي يصدرها الحصان)",
 "whinstone": "حَجَر صَلْد (أي من الصخور الملونة الصلبة المتنوعة (وخاصة الصخور المكونة من الصوان أو البازلت))",
 "whiny": "كَثِيرُ التَّذَمُّر, نَكِد (كثير الشكوى والتذمّر بشكل معتاد)",
 "whip": "سَوْط / كِرْبَاج / كُرْبَاج / جَلَدَ بِسَوْط, سَاطَ (ضَرَبَ بشدّة بعصا أو سوط أو نحوهما؛ تَحَمَّلَ المصاعب بصبر وشدّة)\nمثال: هذا حزام من الجلد.",
 "whip hand": "اليَد العُلْيَا, سَيْطَرَة (موقف الأفضلية والسيطرة)",
 "whip scorpion": "عقرب سوطي (عنكبوتي غير سام يشبه العقرب وله ذيل رفيع طويل بدون إبرة)",
 "whip snake": "ثعبان سوطي (أي من عدة ثعابين صغيرة سريعة الحركة ذات ذيول طويلة تشبه السوط)",
 "whip top": "بلبل السوط (بلبل يتم تدويره عن طريق الجلد بالسوط)",
 "whip-round": "جَمْع تَبَرُّعَات ((بريطاني) التماس المال عادة لغرض خيري)",
 "whip-scorpion": "عقرب سوطي (عنكبوتي غير سام يشبه العقرب وله ذيل رفيع طويل بدون إبرة)",
 "whip-snake": "ثعبان سوطي (أي من عدة ثعابين صغيرة سريعة الحركة ذات ذيول طويلة تشبه السوط)",
 "whipcord": "ويبكورد (قماش قوي من الصوف الصخري أو القطن بضلع قطري) / خيط السوط (خيط صلب مجدول بإحكام يستخدم لجلود السياط)",
 "whiplash": "جلد, ضرب بالسوط (ضربة سريعة توجه بسوط أو أداة تشبه السوط) / إصابة السوط, إصابة المصع (إصابة في الرقبة (الفقرات العنقية) ناتجة عن التسارع أو التباطؤ السريع (كما في حوادث السيارات))\nمثال: أحدث السوط علامة حمراء",
 "whiplash injury": "إصابة السوط, إصابة المصع (إصابة في الرقبة (الفقرات العنقية) ناتجة عن التسارع أو التباطؤ السريع (كما في حوادث السيارات))",
 "whiplike": "سوطي (له سوط أو يشبهه)",
 "whipped cream": "قِشْدَة مَخْفُوقة",
 "whipper": "جلاد, ضارب بالسوط (شخص ينفذ العقوبة باستخدام قضيب أو سوط)",
 "whipper-in": "مساعد الصياد (مساعد الصياد في إدارة كلاب الصيد)",
 "whippersnapper": "متغطرس صغير, وقح (شخص غير مهم ولكنه وقح ومتطاول)",
 "whippet": "ويبت (كلب نحيل صغير من نوع الغريهاوند تم تطويره في إنجلترا)",
 "whipping": "جلد, سوط (الضرب بسوط أو حزام أو حبل كشكل من أشكال العقاب) / ضَرْب, هَزِيمَة (فعل التغلب أو التفوق) / أَنِيق, لَبِق (ذكيّ وأنيق في المظهر والأسلوب) / غرزة السوط, غرزة ملفقة (غرزة خياطة تمر فوق الحافة بشكل قطري)",
 "whipping boy": "كبش فداء (رجل يعاقب على أخطاء الآخرين)",
 "whipping cream": "كريمة الخفق (كريمة تحتوي على ما يكفي من دهن الزبدة (30% إلى 36%) ليتم خفقها)",
 "whipping girl": "كبش فداء (امرأة تعاقب على أخطاء الآخرين)",
 "whipping post": "عمود الجلد (عمود كان يستخدم سابقاً في الأماكن العامة لربط الجناة لجلدهم)",
 "whipping top": "بلبل السوط (بلبل يتم تدويره عن طريق الجلد بالسوط)",
 "whipple's penstemon": "بنستيمون ويبل (أزهار بلون النبيذ والخزامى إلى الأرجواني والأسود في عدة عناقيد على النصف العلوي من السيقان الورقية؛ مونتانا جنوباً عبر جبال الروكي إلى أريزونا ونيو…)",
 "whippletree": "عارضة الجر, ميزان الجر (عارضة مستعرضة تُربط بزمام حصان الجر وبالمركبة أو الأداة التي يسحبها الحصان)",
 "whippoorwill": "طائر السبد الصياح (سبد ليلي أمريكي ذو ريش رمادي وأبيض)",
 "whippy": "سَلِسُ الانْثِنَاء, لَيِّن (ينثني ويعود بسرعة دون أن ينكسر)",
 "whipsaw": "منشار لشخصين (منشار بمقابض في كلا الطرفين؛ مخصص للاستخدام من قبل شخصين)",
 "whipsnake": "ثعبان سوطي (أي من عدة ثعابين صغيرة سريعة الحركة ذات ذيول طويلة تشبه السوط)",
 "whipstitch": "غرزة السوط, غرزة ملفقة (غرزة خياطة تمر فوق الحافة بشكل قطري)",
 "whipstitching": "غرزة السوط, غرزة ملفقة (غرزة خياطة تمر فوق الحافة بشكل قطري)",
 "whiptail": "سحلية سوطية الذيل (أي من العديد من سحالي العالم الجديد الرشيقة واليقظة جداً)",
 "whiptail lizard": "سحلية سوطية الذيل (أي من العديد من سحالي العالم الجديد الرشيقة واليقظة جداً)",
 "whir": "أزيز, هفيف (صوت شيء يتحرك بسرعة)\nمثال: رفرفة أجنحة الطائر",
 "whirl": "برم, دوران سريع (عملية الدوران بسرعة) / تجربة, محاولة سريعة (محاولة عادة ما تكون قصيرة) / جلبة, دوامة (حركة مضطربة) / تلفيف, دوامة (شكل شيء يدور بسرعة)\nمثال: أدار الكرنك بقوة",
 "whirler": "دوارة (آلية دوارة) / درويش راقص, درويش مولوي (درويش تتضمن أفعاله الرقص النشوي والدوران)",
 "whirligig": "أرجوحة دوارة, دوامة الخيل (آلة دوارة كبيرة بها مقاعد لركوب الأطفال للتسلية) / بلبل, خذروف (لعبة أطفال مخروطية الشكل تتناقص إلى نقطة فولاذية يمكن تدويرها عليها)\nمثال: حصل على بلبل أحمر زاهي وخيط لعيد ميلاده",
 "whirligig beetle": "دُوَّامَة, جِرِنُوسِيَّة",
 "whirling": "دوران حلزوني (عملية الدوران في دائرة أو حلزون)",
 "whirling dervish": "درويش راقص, درويش مولوي (درويش تتضمن أفعاله الرقص النشوي والدوران)",
 "whirling table": "طاولة دوارة (جهاز مزود بأقراص دوارة وأوزان وبكرات لتوضيح القوانين والظواهر الفيزيائية)",
 "whirlpool": "دَوَّامَة",
 "whirlwind": "زَوْبَعَة",
 "whirlybird": "مروحية, هليكوبتر (طائرة بدون أجنحة تحصل على رفعها من دوران شفرات علوية)",
 "whirr": "أزيز, هفيف (صوت شيء يتحرك بسرعة)\nمثال: رفرفة أجنحة الطائر",
 "whirring": "دَوَّار, طَنَّان (يُصْدِر صوتًا كصوت اهتزاز الأجنحة السريع) / أزيز, هفيف (صوت شيء يتحرك بسرعة)\nمثال: رفرفة أجنحة الطائر",
 "whisk": "مِخْفَقَة",
 "whisk broom": "مِكْنَسَة صغيرة, مِكْنَسَة يدوية (مكنسة صغيرة ذات مقبض قصير تستخدم لتنظيف الملابس)",
 "whisk fern": "سرخس الخفاقة (نباتات تشكل كتلاً استوائية بشكل رئيسي ذات مظهر هيكلي يشبه مكانس الخفق؛ تفتقر إلى الجذور)",
 "whisker": "شَارِب, كُلْبَة",
