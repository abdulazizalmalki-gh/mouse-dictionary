 "yellow-tipped": "أَصْفَرُ الطَّرَف ((لِلزَّهْرَةِ) ذَاتُ طَرَفٍ أَصْفَرِ اللَّوْن)",
 "yellow-vented bulbul": "بلبل التمر",
 "yellow-white": "أَبْيَض مُصْفَرّ (أبيض مع مسحة صفراء)",
 "yellowbelly marmot": "مرموط أصفر البطن (مرموط ثقيل الجسم بني مصفر من المناطق الصخرية في غرب أمريكا الشمالية)",
 "yellowbird": "حسون أمريكي, طائر أصفر (عصفور أمريكي يتميز الذكر بريش جسم أصفر في الصيف) / هازجة صفراء (هازجة غابات أمريكية صفراء الحنجرة)",
 "yellowcake": "الكعكة الصفراء (خليط غير نقي من أكاسيد اليورانيوم يتم الحصول عليه أثناء معالجة خام اليورانيوم)",
 "yellowed": "مُصْفَرّ (تحوّل لونه إلى الأصفر بفعل القِدَم)",
 "yellowfin": "تونة صفراء الزعانف (قد تصل إلى 400 رطل؛ توجد عالمياً في المناطق الاستوائية)",
 "yellowfin croaker": "كرواكر أصفر الزعانف (سمكة من ساحل المحيط الهادئ لأمريكا الشمالية)",
 "yellowfin mojarra": "موجارا صفراء الزعانف (سمكة مقلاة شعبية من برمودا وخليج المكسيك إلى البرازيل)",
 "yellowfin tuna": "تونة صفراء الزعانف (قد تصل إلى 400 رطل؛ توجد عالمياً في المناطق الاستوائية)",
 "yellowhammer": "درسة صفراء (طائر درسة أوروبي يتميز الذكر منه بلون أصفر ساطع) / نقار الخشب أصفر العمود (نقار خشب كبير من شرق أمريكا الشمالية ذو رقبة حمراء وسطح سفلي أصفر للأجنحة والذيل)",
 "yellowish": "أَصْفَر (بلون متوسط بين الأخضر والبرتقالي في الطيف اللوني؛ يشبه لون صفار البيض)",
 "yellowish brown": "بني مصفر, كراميل (لون أسمر متوسط إلى داكن)",
 "yellowish green": "أخضر ليموني, أخضر مصفر (درجة من الأخضر مشوبة بالأصفر)",
 "yellowish pink": "خوخي, مشمشي (درجة من الوردي مشوبة بالأصفر)",
 "yellowish-beige": "بِيج مُصْفَرّ (بيج مع مسحة صفراء)",
 "yellowish-gray": "رَمَادِيّ مُصْفَرّ (رمادي مع مسحة صفراء)",
