 "whiskery": "ذُو لِحْيَة, مُلْتَحٍ (له شعر على الخدّين والذقن)",
 "whiskey": "وِيسْكِي / وِسْكِي",
 "whiskey bottle": "زجاجة ويسكي (زجاجة لحفظ الويسكي)",
 "whiskey jug": "إبريق ويسكي (إبريق يحتوي على الويسكي)",
 "whiskey neat": "ويسكي صافي (مشروب ويسكي بدون أي مضافات)\nمثال: طلب ويسكي صافياً",
 "whiskey on the rocks": "ويسكي مع ثلج (ويسكي مع ثلج)",
 "whiskey sour": "ويسكي ساور (كوكتيل ساور مصنوع بالويسكي)",
 "whisky": "ويسكي (مشروب مصنوع من هريس الحبوب المخمر)",
 "whisky neat": "ويسكي صافي (مشروب ويسكي بدون أي مضافات)\nمثال: طلب ويسكي صافياً",
 "whisky on the rocks": "ويسكي مع ثلج (ويسكي مع ثلج)",
 "whisky sour": "ويسكي ساور (كوكتيل ساور مصنوع بالويسكي)",
 "whisper": "هَمْس / هَمَسَ, وَسْوَسَ",
 "whispered": "مَهْمُوس (مُتحدَّث به بنبرات خافتة ناعمة بلا اهتزاز الحبال الصوتيّة)",
 "whisperer": "هامس (من يتحدث بصوت هامس)",
 "whispering": "خَرِير, هَامِس (يُصدر صوتاً مستمراً منخفضاً غير واضح) / همس, وشوشة (التحدث بنعومة دون اهتزاز الحبال الصوتية) / حفيف, همس (ضجيج خفيف، مثل ضجيج الملابس الحريرية أو أوراق الشجر التي تهب عليها الرياح)",
 "whispering bells": "أجراس صفراء, أجراس هامسة (عشب لزج في الموائل القاحلة أو الصحراوية في جنوب غرب الولايات المتحدة له أزهار صفراء متدلية)",
 "whispering campaign": "حملة تشهير, حملة شائعات (النشر المنظم للشائعات المهينة المصممة لتشويه سمعة مرشح)",
 "whispering dome": "دهليز الهمس, قبة هامسة (مساحة أسفل قبة أو قوس تكون فيها الأصوات الصادرة عند نقاط معينة مسموعة بوضوح عند نقاط بعيدة معينة)",
 "whispering gallery": "دهليز الهمس, قبة هامسة (مساحة أسفل قبة أو قوس تكون فيها الأصوات الصادرة عند نقاط معينة مسموعة بوضوح عند نقاط بعيدة معينة)",
 "whist": "ويست (لعبة ورق لأربعة لاعبين يشكلون شراكتين؛ يتم توزيع حزمة من 52 ورقة ويسجل كل جانب نقطة واحدة لكل جولة يأخذها تزيد عن ستة)",
 "whist drive": "حفلة ويست (حفلة لعبة ورق متتابعة (لعبة ويست))",
 "whistle": "صَفَّارَة / صَفَرَ, صَفَّرَ (الخَالِي كأنه تَصْفِر فيه الرِيح. ويقال أيضا صَفْر وصُفْر؛ في : هي عَدَد قيمته لا شيء، أو خالية)\nمثال: بدأ سامي من نقطة الصفر.",
 "whistle blower": "كاشف الفساد, مُبلِّغ عن المخالفات (مخبر يكشف المخالفات داخل منظمة على أمل إيقافها)\nمثال: يعطي القانون حماية قليلة للمبلغين عن المخالفات الذين يشعرون أن للجمهور الحق في معرفة ما يحدث",
 "whistle buoy": "عوامة صافرة (عوامة تصدر صوت صفير)",
 "whistle stop": "محطة توقف صغيرة (محطة سكة حديد صغيرة بين المحطات الرئيسية أو محطة يتوقف فيها القطار فقط عند الإشارة)",
 "whistle-blower": "كاشف الفساد, مُبلِّغ عن المخالفات (مخبر يكشف المخالفات داخل منظمة على أمل إيقافها)\nمثال: يعطي القانون حماية قليلة للمبلغين عن المخالفات الذين يشعرون أن للجمهور الحق في معرفة ما يحدث",
 "whistle-stop tour": "جولة انتخابية سريعة (جولة يقوم بها مرشح كجزء من حملة سياسية يتم فيها زيارة سلسلة من البلدات الصغيرة)\nمثال: في عام 1948 عبر ترومان البلاد عدة مرات في جولاته الانتخابية السريعة",
 "whistleblower": "كاشف الفساد, مُبلِّغ عن المخالفات (مخبر يكشف المخالفات داخل منظمة على أمل إيقافها)\nمثال: يعطي القانون حماية قليلة للمبلغين عن المخالفات الذين يشعرون أن للجمهور الحق في معرفة ما يحدث",
 "whistler": "صفار (طيور أسترالية وجنوب شرق آسيوية ذات نداء صفير شجي) / بطة ذهبية العين (بطة غواصة كبيرة الرأس سريعة الطيران من المناطق القطبية) / مرموط أشيب (مرموط جبلي كبير من أمريكا الشمالية) / صافر (شخص يصدر صوتًا عاليًا حادًا)",
 "whistling": "صفير (فعل الصفير بلحن) / تصفير, صفير (فعل الإشارة (مثل الاستدعاء) عن طريق التصفير أو النفخ في صافرة) / صفير (الصوت الناتج عن شيء يتحرك بسرعة أو بخار يخرج من فتحة صغيرة)\nمثال: أشار صفيره المبهج إلى أنه يستمتع بعمله",
 "whistling buoy": "عوامة صافرة (عوامة تصدر صوت صفير)",
 "whistling marmot": "مرموط أشيب (مرموط جبلي كبير من أمريكا الشمالية)",
 "whistling swan": "تم صفار (نويع من تم التندرا في أمريكا الشمالية له نغمة صفير ناعمة)",
 "whit": "ذرة, مثقال ذرة (كمية صغيرة جداً أو نادرة الوجود)",
 "whit leather": "جلد أبيض (جلد تمت معالجته بالشبة و/أو الملح)",
 "whit-tuesday": "ثلاثاء العنصرة (اليوم التالي لإثنين العنصرة)",
 "white": "أَبْيَض, أبيض (اسم لون البَيَاض، أي ما كان لونه كالثلج النظيف أو حليب الجاموس. وهذا اللون يعتبر مجموع كل الألوان في الطيف الشمسيّ. انظر الصورة؛ صفة ما كان لونه أبيضًا) / قَوْقَازِيّ, يَافِثِيّ / أَبْيَض, بَيْضَاء (اسم لون البَيَاض، أي ما كان لونه كالثلج النظيف أو حليب الجاموس. وهذا اللون يعتبر مجموع كل الألوان في الطيف الشمسيّ. انظر الصورة؛ صفة ما كان لونه أبيضًا)\nمثال: هذا الكلب أبيض.",
 "white admiral": "فراشة الأميرال الأبيض (فراشة أوراسية بأجنحة بنية وعلامات بيضاء) / فراشة الأميرال الأبيض الأمريكية (فراشة من أمريكا الشمالية بأجنحة زرقاء سوداء يقطعها شريط أبيض عريض)",
 "white alder": "ألدر أبيض, شجيرة الفلفل الحلوة (شجيرة من شرق وجنوب الولايات المتحدة الساحلية ذات عناقيد جميلة من الزهور البيضاء المعطرة برائحة التوابل) / نغت أبيض, نغت جبلي (شجرة من غرب الولايات المتحدة)",
 "white anglo-saxon protestant": "بروتستانتي أنجلو-ساكسوني أبيض (شخص أبيض من أصل أنجلو-ساكسوني ينتمي إلى طائفة بروتستانتية)",
 "white ant": "أرضة, نمل أبيض (حشرة اجتماعية بيضاء ناعمة الجسم تشبه النمل تتغذى على الخشب)",
 "white arsenic": "ثلاثي أكسيد الزرنيخ, زرنيخ (مسحوق أبيض سام من ثلاثي أكسيد الزرنيخ؛ يستخدم في صناعة الزجاج وكمبيد للآفات (سم الفئران) ومبيد للأعشاب)",
 "white asbestos": "كريزوتيل (معدن ليفي رمادي أو أخضر؛ مصدر تجاري مهم للأسبستوس)",
 "white ash": "مُرَّان أَمْرِيكِيّ",
 "white aspen": "حور أبيض (حور يزرع على نطاق واسع في الولايات المتحدة؛ له لحاء أبيض وأوراق ذات أسطح سفلية بيضاء)",
 "white avens": "أفينس أبيض (أفينس أبيض الزهور من أمريكا الشمالية) / أفينس أبيض, أفينس فرجينيا (أفينس من فرجينيا له زهور شاحبة أو صفراء مخضرة)",
 "white backlash": "رد فعل البيض العنيف (رد فعل عنيف من قبل العنصريين البيض ضد تقدم الحقوق المدنية للسود)",
 "white baneberry": "أكتيا بيضاء, توت سام أبيض (عشب من أمريكا الشمالية ذو ثمار لبية بيضاء سامة)",
 "white basswood": "زيزفون أبيض (زيزفون أمريكي من منطقة أليغني)",
 "white bead": "أكتيا بيضاء, توت سام أبيض (عشب من أمريكا الشمالية ذو ثمار لبية بيضاء سامة)",
 "white bean": "فاصولياء بيضاء (فاصولياء ذات بذور بيضاء؛ عادة ما تكون مجففة)",
 "white bedstraw": "جويسئة بيضاء, فوة برية (عشب أوراسي ذو عناقيد واسعة من الزهور البيضاء الصغيرة؛ تم توطينه في أمريكا الشمالية)",
 "white beech": "زان أمريكي (شجرة غابات أمريكية شمالية بأوراق خضراء فاتحة وجوز صالح للأكل)",
 "white beer": "بيرة القمح, بيرة بيضاء (اسم عام للبيرة المصنوعة من القمح بالتخمير العلوي؛ عادة ما تكون شاحبة جداً وغائمة وفوارة)",
 "white birch": "بتولا بيضاء, بتولا زغبية (بتولا أوروبية بلحاء أبيض باهت إلى بني شاحب وفروع مشعرة متدلية نوعاً ما)",
 "white blood cell": "كُرَيَّةُ دَمٍ بَيْضَاءُ, خَلِيَّةُ دَمٍ بَيْضَاءُ",
 "white blood corpuscle": "خلية دم بيضاء, كريّة دم بيضاء (خلايا دم تبتلع وتهضم البكتيريا والفطريات؛ جزء مهم من نظام دفاع الجسم)",
 "white book": "كتاب أبيض, ورقة بيضاء (تقرير حكومي؛ يغلف عادة بغلاف أبيض)",
 "white borscht": "بورش أبيض (نويع من حساء الجاودار الحامض مصنوع بدقيق القمح بدلاً من دقيق الجاودار الحامض)",
 "white bread": "خبز أبيض (خبز مصنوع من دقيق القمح المطحون ناعماً والمبيض عادة)",
 "white broom": "وزال أبيض, وزال إسباني أبيض (وزال أوروبي منخفض له أوراق ثلاثية وزهور بيضاء مصفرة)",
 "white bryony": "فاشرا بيضاء, لفت الشيطان (كرمة بيضاء الزهر ذات جذور سميكة وتحمل توتاً أسود صغيراً؛ من أوروبا إلى إيران)",
 "white burgundy": "بورغوندي أبيض, شابلي (نبيذ مائدة أبيض جاف من منطقة شابلي في فرنسا أو نبيذ يشبهه)",
 "white cake": "كعكة بيضاء (كعكة مصنوعة بدون صفار البيض)",
 "white camas": "كاماسيا بيضاء (نبات من شرق ووسط أمريكا الشمالية له زهور بيضاء كريمية مشوبة بالبني أو الأرجواني؛ سام خاصة للحيوانات الراعية)",
 "white campion": "سيلينة بيضاء, ليخنيس أبيض (عشبة خضراء مزرقة ذات سيقان لزجة وعناقيد من الزهور البيضاء الكبيرة التي تفتح مساءً بكأس منتفخ جداً؛ توضع أحياناً في جنس ليخنيس)",
 "white cedar": "أرز أبيض أطلسي, سرو أبيض (أرز متوسط الحجم بطيء النمو من الساحل الشرقي للولايات المتحدة؛ يشبه العفص الأمريكي) / أرز أبيض شمالي, عفص غربي (شجرة دائمة الخضرة صغيرة من شرق أمريكا الشمالية لها أوراق صغيرة تشبه الحراشف على غصينات مسطحة)",
 "white cell": "خلية دم بيضاء, كريّة دم بيضاء (خلايا دم تبتلع وتهضم البكتيريا والفطريات؛ جزء مهم من نظام دفاع الجسم)",
 "white chocolate": "شوكولاتة بيضاء (مزيج من زبدة الكاكاو ومواد صلبة من الحليب والسكر والفانيليا؛ تستخدم في ألواح الحلوى والخبز والتغطيات؛ ليست شوكولاتة تقنياً لأنها لا تحتوي على سائل…)",
 "white cinnamon": "قِرْفَة بَيْضَاء, كَانِيلا (اللحاء الداخلي شديد العطرية لشجرة الكانيلا، يستخدم كتابل وكمقوٍ)",
 "white cinnamon tree": "شجرة القرفة البيضاء, قرفة برية (شجيرة دائمة الخضرة كبيرة أو شجرة صغيرة ذات لحاء عطري أبيض وأوراق جلدية وأزهار أرجوانية إلى حمراء صغيرة في سيمات طرفية)",
 "white clover": "نفل أبيض, نفل زاحف (نفل أوروبي زاحف ذو أزهار بيضاء إلى وردية وأوراق خضراء زاهية؛ متوطن في الولايات المتحدة؛ يزرع على نطاق واسع كعلف)",
 "white cockle": "سيلينة بيضاء, ليخنيس أبيض (عشبة خضراء مزرقة ذات سيقان لزجة وعناقيد من الزهور البيضاء الكبيرة التي تفتح مساءً بكأس منتفخ جداً؛ توضع أحياناً في جنس ليخنيس)",
 "white coffee": "اَلْقَهْوَة اَلْبَيْضَاء",
 "white cohosh": "أكتيا بيضاء, توت سام أبيض (عشب من أمريكا الشمالية ذو ثمار لبية بيضاء سامة)",
 "white corpuscle": "خلية دم بيضاء, كريّة دم بيضاء (خلايا دم تبتلع وتهضم البكتيريا والفطريات؛ جزء مهم من نظام دفاع الجسم)",
 "white crappie": "كرابي أبيض (نوع من سمك الكرابي لونه أبيض)",
 "white croaker": "كرواكر أبيض (سمكة طعام بحرية فضية صغيرة توجد قبالة كاليفورنيا) / السمكة الملكة, كرواكر أبيض (سمكة طبل فضية ومائلة للزرقة في المياه الساحلية الضحلة لكاليفورنيا)",
 "white currant": "كشمش أبيض (كشمش حدائق يحمل ثماراً بيضاء صغيرة) / كشمش أبيض\nمثال: نادرًا ما يتم تحديد الكشمش الأبيض في وصفات الطهي المالحة مقارنة بنظيراتها الحمراء",
 "white cypress": "أرز أبيض أطلسي, سرو أبيض (أرز متوسط الحجم بطيء النمو من الساحل الشرقي للولايات المتحدة؛ يشبه العفص الأمريكي)",
 "white cypress pine": "صنوبر السرو الأبيض (شجرة صغيرة أو شجيرة في جنوب أستراليا)",
 "white daisy": "أقحوان أبيض, أقحوان المروج (نبات أوراسي معمر طويل الساق ومورق بزهور بيضاء؛ متوطن على نطاق واسع)",
 "white dead nettle": "قراص أبيض, لاميون أبيض (نبات قراص أوروبي ميت بزهور بيضاء)",
 "white dipladenia": "ديبلادينيا بيضاء, مانديفيلا (نبات متسلق شجيري ذو أوراق لامعة وأزهار بيضاء قمعية الشكل ذات حلق أصفر)",
 "white dog's-tooth violet": "إريثرونيوم أبيض, سن الكلب الأبيض (نبات سن الكلب من أمريكا الشمالية له زهور بيضاء منفردة بمراكز صفراء وخارج أزرق أو وردي)",
 "white dogtooth violet": "إريثرونيوم أبيض, سن الكلب الأبيض (نبات سن الكلب من أمريكا الشمالية له زهور بيضاء منفردة بمراكز صفراء وخارج أزرق أو وردي)",
 "white dwarf": "قَزْم أَبْيَض",
 "white dwarf star": "قَزَم أَبْيَض (نجم خافت ذو كثافة هائلة)",
 "white elephant": "فيل أبيض (فيل هندي أمهق؛ نادر ومقدس أحياناً في شرق آسيا) / الفيل الأبيض (ممتلكات قيمة تكون تكاليف صيانتها باهظة للغاية)",
 "white elm": "دردار أمريكي (شجرة زينة كبيرة بفروع رشيقة تنتشر تدريجياً شائعة في شرق أمريكا الشمالية)",
 "white fairy lantern": "زنبق الكرة الأبيض, فانوس الجنية الأبيض (زنبق كروي له عناقيد متفرعة مفتوحة من الزهور البيضاء بيضاوية الشكل؛ جنوب كاليفورنيا)",
 "white false indigo": "نيلة كاذبة بيضاء (عشبة منتصبة أو منتشرة ذات عناقيد من الزهور البيضاء الكريمية؛ شرق الولايات المتحدة)",
 "white feather": "ريشة بيضاء (رمز للجبن)",
 "white feldspar": "ألبيت, فلسبار أبيض (فلسبار واسع الانتشار يشكل الصخور)",
 "white fir": "شوح بهي, شوح فضي باسيفيكي (شوح متوسط إلى طويل من غرب أمريكا الشمالية له تاج مخروطي وفروع في طبقات؛ الأوراق تفوح منها رائحة البرتقال عند سحقها) / شوح أبيض, شوح كولورادو (شوح متوسط إلى طويل من وسط إلى غرب الولايات المتحدة له تاج منتصب ضيق وخشب ناعم)",
 "white flag": "راية الهدنة, علم أبيض (علم يتكون من قطعة قماش بيضاء تُرفع للإشارة إلى الاستسلام أو لطلب الهدنة)",
 "white fox": "ثعلب أبيض, ثعلب قطبي (ثعلب كثيف الفرو من المناطق القطبية؛ بني في الصيف وأبيض في الشتاء)",
 "white friar": "راهب أبيض, كرملي (راهب روماني كاثوليكي يرتدي العباءة البيضاء للرهبنة الكرملية؛ واعظ متسول)",
 "white fringed orchid": "سحلب أبيض مهدب (سحلب مستنقعات من شرق أمريكا الشمالية بسنبلة من الزهور البيضاء النقية المهدبة)",
 "white fringed orchis": "سحلب أبيض مهدب (سحلب مستنقعات من شرق أمريكا الشمالية بسنبلة من الزهور البيضاء النقية المهدبة)",
 "white fritillary": "بوقية بيضاء (عشبة كاليفورنيا بأزهار بيضاء مخروطية أو على شكل جرس عادة ما تكون مشوبة بالأخضر)",
 "white fungus": "فطر أبيض (فطر يهاجم الأسماك الحية والضفادع الصغيرة والبيض مسبباً مرض الفطر الأبيض: طبقة من الخيوط البيضاء خاصة على الأجزاء الطرفية (مثل الزعانف))",
 "white genocide": "نظرية مؤامرة (مؤنث نَظَرْيّ، أي يفحض بالنظر لا بالإختبار؛ قضية غير مثبتة ولا مبرهنة لتفسير أمر ما)\nمثال: إنها مجرد نظرية.",
 "white globe lily": "زنبق الكرة الأبيض, فانوس الجنية الأبيض (زنبق كروي له عناقيد متفرعة مفتوحة من الزهور البيضاء بيضاوية الشكل؛ جنوب كاليفورنيا)",
 "white gold": "ذهب أبيض (سبيكة شاحبة اللون من الذهب عادة مع البلاتين أو النيكل أو البلاديوم)",
 "white goods": "بياضات منزلية, سلع بيضاء (سلع جافة للاستخدام المنزلي مصنوعة عادة من قماش أبيض) / أجهزة منزلية كبيرة, سلع بيضاء (الأجهزة المنزلية الكهربائية الكبيرة (مثل الثلاجات أو الغسالات) التي تكون عادة مطلية بالمينا الأبيض)",
 "white hat": "هَاكِر",
 "white heat": "احتدام, توهج أبيض (سخونة شيء يتم تسخينه حتى يتحول إلى اللون الأبيض)",
 "white heather": "خلنج أبيض (خلنج من جبال غرب الولايات المتحدة له زهور بيضاء جرسية الشكل)",
 "white hellebore": "خربق أبيض, خربق أمريكي (نبات من أمريكا الشمالية له أوراق كبيرة وزهور خضراء مصفرة تنمو في عناقيد؛ ينتج قلويداً ساماً يستخدم طبياً)",
 "white honeysuckle": "أزاليا المستنقعات (شجيرة تنمو في المستنقعات في جميع أنحاء شرق الولايات المتحدة ولها زهور بيضاء إلى وردية صغيرة تشبه زهر العسل) / صريمة الجدي البيضاء, عسلة بيضاء (عسلة كثيفة بفروع ملتفة وزهور بيضاء أو بيضاء مصفرة؛ جنوب الولايات المتحدة)",
 "white hope": "أمل كبير (شخص (أو شيء) يُتوقع منه تحقيق نجاح كبير في مجال معين)\nمثال: هذه الشركة هي الأمل الكبير لسياسة إدارة النفايات في الصناعة النووية",
 "white horehound": "فراسيون أبيض, فراسيون شائع (عشب عطري أوروبي بأوراق مشعرة والعديد من الزهور البيضاء في سيمات إبطية؛ تنتج الأوراق مستخلصاً مراً يستخدم طبياً وكنكهة)",
 "white horse": "رغوة الموج, زبد الموج (موجة تهب عليها الرياح فينكسر عرفها ويظهر أبيض اللون)",
 "white horse nettle": "باذنجان بري, مغد فضي الأوراق (نبات مغد ضار بأوراق فضية وزهور بنفسجية أو زرقاء أو بيضاء؛ تستخدم ثمرته المستديرة على نطاق واسع لتخثير الحليب؛ من وسط الولايات المتحدة إلى أمريكا…)",
 "white house": "الْبَيْت الْأَبْيَض / بَيْت أَبْيَض (بمعنى قضى الليل؛ الخَيْمَة من الشَعْر يَبِيت فيها البَدَوي أو المُسافر. الجمع بُيُوت)\nمثال: لنعد إلى البيت.",
 "white knight": "الفارس الأبيض (شركة تكون مستحوذاً ودوداً في عملية استحواذ)",
 "white lead": "سِبِيدَاج, بَارُوق",
 "white lead ore": "خام الرصاص الأبيض, سيروسيت (معدن يتكون من كربونات الرصاص وهو مصدر مهم للرصاص)",
 "white leather": "جلد أبيض (جلد تمت معالجته بالشبة و/أو الملح)",
 "white leg": "التهاب الوريد الخثاري, رجل الحليب (تخثر مؤلم للوريد الفخذي في الساق بعد الولادة)",
 "white lettuce": "خس أبيض (عشبة من شمال شرق أمريكا الشمالية ذات عناقيد متدلية من الزهور البيضاء المصفرة)",
 "white lie": "كذبة بيضاء (كذبة غير مهمة (خاصة تلك التي تُقال لتكون لبقاً أو مؤدباً))",
 "white lily": "زنبق الماء المصري, لوتس (اللوتس المصري الأبيض: زنبق الماء في مصر إلى جنوب شرق أفريقيا؛ كان مقدساً عند المصريين القدماء) / زنبق أبيض, زنبق مادونا (زنبق شرق البحر الأبيض المتوسط والبلقان بزهور بيضاء عريضة قمعية الشكل)",
 "white line": "خط أبيض (شريط أبيض في منتصف الطريق لتحديد مسارات المرور)",
 "white lotus": "زنبق الماء المصري, لوتس (اللوتس المصري الأبيض: زنبق الماء في مصر إلى جنوب شرق أفريقيا؛ كان مقدساً عند المصريين القدماء)",
 "white lung": "رئة رطبة, متلازمة الضائقة التنفسية الحادة (إصابة رئوية حادة تتميز بالسعال والخرخرة؛ التهاب في الرئتين اللتين تصبحان صلبتين وليفيتين ولا تستطيعان تبادل الأكسجين)",
 "white lupine": "ترمس أبيض, ترمس مصري (عشب أوراسي ذو زهور بيضاء يزرع على نطاق واسع للعلف ومكافحة التعرية)",
 "white madder": "جويسئة بيضاء, فوة برية (عشب أوراسي ذو عناقيد واسعة من الزهور البيضاء الصغيرة؛ تم توطينه في أمريكا الشمالية)",
 "white magic": "سحر أبيض (سحر يُستخدم لأغراض خيرة فقط)",
 "white maire": "مايري أبيض (شجرة نيوزيلندية صغيرة لها فاكهة لبية حمراء ذات بذرة واحدة)",
 "white mallee": "مالي أبيض (مالي شجيري صغير)",
 "white mallow": "ختمية طبية, خطمي مخزني (نبات معمر أوروبي متوطن في الولايات المتحدة ذو أوراق بيضاوية مثلثة وزهور وردية ليلكية)",
 "white man": "رجل أبيض (رجل من العرق الأبيض)",
 "white man's burden": "عبء الرجل الأبيض (المسؤولية المفترضة للعرق الأبيض في توفير الرعاية لرعاياهم من غير البيض)",
 "white mangrove": "مانغروف أبيض (شجيرة إلى شجرة متوسطة الحجم تنمو في المياه قليلة الملوحة على طول سواحل غرب أفريقيا وأمريكا الاستوائية؛ مهمة محلياً كمصدر للتانين) / قرم, مانغروف أبيض (شجرة صغيرة إلى متوسطة الحجم تنمو في المياه قليلة الملوحة خاصة على طول سواحل جنوب غرب المحيط الهادئ)",
 "white marlin": "مارلين أبيض (مارلين صغير (حتى 180 رطلاً) في غرب المحيط الأطلسي)",
 "white matsutake": "ماتسوتاكي أبيض (فطر أبيض كبير يطور بقعاً بنية مع تقدمه في العمر؛ الخياشيم بيضاء؛ الرائحة حارة وعطرية؛ يجمع تجارياً للطبخ الشرقي في شمال غرب المحيط الهادئ)",
 "white matter": "مادة بيضاء (نسيج عصبي أبيض للجهاز العصبي المركزي يتكون من عصبونات وأغمادها المايلينية)",
 "white meat": "صدر, لحم أبيض (اللحم المقطع من صدر الطائر)",
 "white melilot": "إكليل الملك الأبيض, حندقوق أبيض (نبات ثنائي الحول؛ يعتبر نبات عسل قيم)",
 "white metal": "معدن أبيض, معدن المحامل (سبيكة (غالباً ما تكون أساسها الرصاص أو القصدير) تستخدم للمحامل)",
 "white milkweed": "صقلاب أبيض (عشب طويل بسيقان بيضاء شمعية بلا أوراق وزهور بيضاء تشبه النجوم؛ جنوب غرب الولايات المتحدة)",
 "white mountain ash": "مران الجبل الأبيض (شجرة كبيرة ذات لحاء داكن متماسك على الجذع السفلي ولكنه أملس وأبيض في الأعلى؛ تنتج خشباً مشابهاً لخشب المران الأوروبي أو الأمريكي)",
 "white mulberry": "توت أبيض (توت آسيوي بفاكهة بيضاء إلى حمراء شاحبة؛ تستخدم الأوراق لتغذية ديدان القز)",
 "white mullein": "بوصير أبيض (عشب أوراسي كثيف الشعر بزهور بيضاء عنقودية؛ تم توطينه في أمريكا الشمالية)",
 "white mullet": "بوري أبيض (بوري فضي في سواحل المحيط الأطلسي والهادئ)",
 "white mustard": "خَرْدَل أَبْيَض",
 "white noise": "ضوضاء بيضاء (ضوضاء ناتجة عن محفز يحتوي على جميع ترددات الاهتزاز المسموعة)\nمثال: الضوضاء البيضاء عامل حجب جيد",
 "white oak": "بلوط أبيض (أي من العديد من أشجار البلوط في العالم القديم وأمريكا التي تحتوي على 6 إلى 8 أسدية في كل زهيرة، وبلوط ينضج في عام واحد وعروق أوراق لا تمتد أبداً إلى…)",
 "white onion sauce": "سوبيز, صلصة البصل الأبيض (صلصة فيلوتيه مع بصل مفروم مقلي وكريمة خفق)",
 "white pages": "الصفحات البيضاء (دليل هاتف أو قسم من دليل (مطبوع عادة على ورق أبيض) حيث يتم سرد أسماء الأشخاص أبجدياً مع أرقام هواتفهم)",
 "white paper": "كتاب أبيض, ورقة بيضاء (تقرير حكومي؛ يغلف عادة بغلاف أبيض)",
 "white pelican": "بجع أبيض (بجع أمريكي كبير؛ أبيض مع ريش جناح أسود)",
 "white people": "العرق الأبيض, قوقازيون (عرق ذو بشرة فاتحة)",
 "white pepper": "فلفل أبيض (فلفل يطحن من حبوب الفلفل المقشرة) / فلفل, فلفل أسود (نبات متسلق يحمل توتاً أحمر داكناً (حبوب الفلفل) عند النضج الكامل؛ جنوب الهند وسريلانكا؛ تم توطينه في شمال بورما وآسام)",
 "white perch": "فرخ أبيض (سمكة غذائية ورياضية فضية صغيرة في جداول شرق الولايات المتحدة)",
 "white person": "أبيض, قوقازي (شخص من أصل أوروبي ذو بشرة فاتحة أو شاحبة)",
 "white pine": "صنوبر أبيض (خشب أبيض ناعم من أشجار الصنوبر الأبيض) / صنوبر أبيض (أي من عدة أنواع من الصنوبر خماسي الإبر بخشب أبيض ولحاء أملس عادة رمادي فاتح عندما يكون صغيراً؛ خاصة الصنوبر الأبيض الشرقي)",
 "white pine blister rust": "صدأ الصنوبر الأبيض, صدأ تبثري",
 "white plague": "إدمان المخدرات (إدمان على مخدر (خاصة المخدرات الأفيونية)) / تدرن رئوي, سل رئوي (يشمل الرئتين مع هزال تدريجي للجسم)",
 "white popinac": "شجرة الرصاص, ليوسينا (شجرة منخفضة شجيرية من المناطق الاستوائية وشبه الاستوائية في أمريكا الشمالية ذات أزهار بيضاء مشوبة بالأصفر تشبه الميموزا وقرون مسطحة طويلة)",
 "white poplar": "خشب الحور الأصفر, خشب الزنبق (خشب خفيف سهل العمل لشجرة الزنبق؛ يستخدم للأثاث والقشرة) / حور أبيض (حور يزرع على نطاق واسع في الولايات المتحدة؛ له لحاء أبيض وأوراق ذات أسطح سفلية بيضاء)",
 "white potato": "بطاطا, بطاطس (درنة صالحة للأكل موطنها أمريكا الجنوبية؛ طعام أساسي في أيرلندا) / بطاطا, بطاطس (نبات حولي موطنه أمريكا الجنوبية له سيقان جارية تحت الأرض تحمل درنات نشوية صالحة للأكل؛ يزرع على نطاق واسع كخضروات حدائق؛ السيقان سامة)",
 "white potato vine": "بطاطا, بطاطس (نبات حولي موطنه أمريكا الجنوبية له سيقان جارية تحت الأرض تحمل درنات نشوية صالحة للأكل؛ يزرع على نطاق واسع كخضروات حدائق؛ السيقان سامة)",
 "white pox": "جدري خفيف (شكل خفيف من الجدري يسببه فيروس أقل ضراوة)",
 "white prairie aster": "أستر البراري الأبيض (نبات معمر في غرب أمريكا الشمالية ذو زهور بيضاء)",
 "white race": "العرق الأبيض, قوقازيون (عرق ذو بشرة فاتحة)",
 "white rhinoceros": "وحيد القرن الأبيض (وحيد قرن أفريقي كبير رمادي فاتح له قرنان؛ مهدد بالانقراض)",
 "white rice": "أرز أبيض (أرز تمت إزالة القشرة أو الطبقات البنية الخارجية منه)",
 "white rocket": "جرجير أبيض, ديبلوتاكسيس أبيض (من منطقة البحر الأبيض المتوسط؛ عشب ضار مستوطن في جميع أنحاء جنوب أوروبا)",
 "white room": "غرفة معقمة, غرفة نظيفة (غرفة خالية تقريباً من الغبار أو البكتيريا؛ تستخدم في العمل المخبري وفي تجميع أو إصلاح المعدات الدقيقة)",
 "white russian": "الروسية البيضاء, اللغة البيلاروسية (اللغة السلافية التي يتم التحدث بها في بيلاروسيا) / وايت راشن (كوكتيل مصنوع من الفودكا وليكير القهوة والحليب أو الكريمة) / بيلاروسي, روسي أبيض (مواطن أو ساكن في بيلاروسيا)",
 "white russian language": "الروسية البيضاء, اللغة البيلاروسية (اللغة السلافية التي يتم التحدث بها في بيلاروسيا)",
 "white rust": "صدأ أبيض (فطر يسبب مرضاً يتميز بكتلة مسحوقية بيضاء من الكونيديا)",
 "white sage": "شيح لويزيانا, مريمية بيضاء (عشب معمر أبيض قطني من جنوب غرب الولايات المتحدة)",
 "white sale": "تخفيضات المنسوجات, موسم البياضات (تخفيضات على البياضات المنزلية)",
 "white sanicle": "أغراتينا, جذر الثعبان الأبيض",
 "white sauce": "صلصة البشاميل, صلصة بيضاء (حليب مكثف بمزيج من الزبدة والدقيق (رو))",
 "white sea": "اَلْبَحْر اَلْأَبْيَض",
 "white separatism": "انفصالية البيض (نظام اجتماعي يعيش فيه البيض بشكل منفصل عن أعضاء الأعراق الأخرى)",
 "white separatist": "انفصالي أبيض (شخص يدافع عن مجتمع يعيش فيه البيض منفصلين عن أعضاء الجماعات العرقية الأخرى)",
 "white shark": "قرش أبيض, قرش أبيض كبير (قرش عدواني كبير واسع الانتشار في البحار الدافئة؛ معروف بمهاجمته للبشر)",
 "white sheep": "خروف دال (خروف بري أبيض كبير يعيش في شمال غرب كندا وألاسكا)",
 "white silk-cotton tree": "شجرة القطن الحريري, قابوق (شجرة استوائية ضخمة ذات تلال عميقة على جذعها الضخم وتحمل قروناً كبيرة من البذور مغطاة بزغب حريري؛ مصدر لألياف القابوق الحريرية)",
 "white slave": "جارية بيضاء, رقيقة بيضاء (امرأة بيعت لممارسة البغاء)",
 "white slaver": "تاجر الرقيق الأبيض (شخص يجبر النساء على ممارسة البغاء)",
 "white slime mushroom": "فطر لزج أبيض (نوع من الفطر اللزج)",
 "white snakeroot": "أغراتينا, جذر الثعبان الأبيض",
 "white snapdragon": "أنف العجل الأبيض (نبات من كاليفورنيا بعناقيد نحيلة من الزهور البيضاء)",
 "white spanish broom": "وزال أبيض, وزال إسباني أبيض (وزال أوروبي منخفض له أوراق ثلاثية وزهور بيضاء مصفرة)",
 "white spruce": "تنوب أبيض (تنوب متوسط الحجم من شمال شرق أمريكا الشمالية له أوراق زرقاء خضراء قصيرة ومخاريط نحيلة)",
 "white squire": "المرافق الأبيض (فارس أبيض يشتري أقل من حصة الأغلبية)",
 "white stork": "لَقْلَق أَبْيَض",
 "white stringybark": "لحاء الخيط الأبيض (لحاء خيط له خشب أبيض)",
 "white sturgeon": "حفش أبيض, حفش المحيط الهادئ (سمكة غذائية ورياضية في المياه البحرية والعذبة للساحل الشمالي الغربي لأمريكا الشمالية) / بيلوغا (مصدر قيم للكافيار والجيلاتين السمكي؛ توجد في البحر الأسود وبحر قزوين)",
 "white supremacist": "مؤمن بتفوق البيض (شخص يعتقد أن العرق الأبيض هو الأسمى أو يجب أن يكون كذلك)",
 "white supremacy": "تفوق العرق الأبيض (التحيز القائل بأن أفراد العرق الأبيض متفوقون على أفراد الأعراق الأخرى)",
 "white sweet clover": "إكليل الملك الأبيض, حندقوق أبيض (نبات ثنائي الحول؛ يعتبر نبات عسل قيم)",
 "white tai": "لغة تاي البيضاء (فرع من لغات تاي، يُتحدث به في الشمال، بشكل رئيسي على طول النهر الأحمر والنهر الأسود في فيتنام)",
 "white tail": "أيل أبيض الذيل, أيل فرجينيا (أيل شائع في أمريكا الشمالية؛ ذيله له جانب سفلي أبيض)",
 "white tea": "شَاي أَبْيَض (شَجَرَة خَضْرَاء من فَصِيلَة الكَامِيلِيات لها أزْهَار بَيْضَاء، وتُعْطِي أوراقاً يصنع منها شَرَاب مُنَبِّه؛ أوراق الشجرة المجففة)\nمثال: صب الشاي لضيفك.",
 "white thistle": "رغل عدسي, شجيرة السمان (شجيرة شائكة بأوراق فضية قشرية في السهول القلوية بجنوب غرب الولايات المتحدة والمكسيك) / أرجيمون, خشخاش شائك (أي نبات من جنس أرجيمون له أزهار بيضاء أو صفراء كبيرة وأوراق وسيقان وقرون شائكة؛ بشكل رئيسي في أمريكا الاستوائية)",
 "white tie": "بدلة بذيول, بدلة رسمية كاملة (ملابس رسمية تتكون من زي سهرة كامل للرجال) / ربطة عنق بيضاء (ربطة عنق فراشة بيضاء تلبس كجزء من زي السهرة الرسمي للرجال)",
 "white tie and tails": "بدلة بذيول, بدلة رسمية كاملة (ملابس رسمية تتكون من زي سهرة كامل للرجال)",
 "white titi": "خشب الجلد, سيريلا (شجيرة أو شجرة صغيرة من جنوب شرق الولايات المتحدة إلى جزر الهند الغربية والبرازيل؛ تزرع لعناقيدها الرفيعة من الزهور البيضاء وأوراقها البرتقالية…)",
 "white trash": "حُثالَة البِيض ((عامية) مصطلح مهين للبيض الفقراء)",
 "white trumpet lily": "زنبق الفصح, زنبق برمودا (زنبق طويل له زهور بيضاء كبيرة بوقية الشكل تتفتح في الربيع)",
 "white turnip": "لفت أبيض (جذر أبيض لنبات اللفت) / لفت, لفت أبيض (نبات يزرع على نطاق واسع له جذر أبيض أو أصفر لحمي كبير صالح للأكل)",
 "white violet": "بنفسج أبيض حلو (بنفسج قصير الساق من شرق أمريكا الشمالية له زهور بيضاء عطرة بعروق أرجوانية) / بنفسج كندا (نبات معمر طويل من أمريكا الشمالية بأوراق على شكل قلب وزهور بيضاء بخطوط أرجوانية)",
 "white vitriol": "كبريتات الزنك (مسحوق عديم اللون قابل للذوبان في الماء؛ يستخدم كمثبت للون أو لحفظ الخشب أو للترسيب الكهربائي للزنك)",
 "white walnut": "جوز أبيض, جوز أرمد (شجرة جوز من أمريكا الشمالية لها خشب بني فاتح ومكسرات صالحة للأكل؛ مصدر لصبغة بنية فاتحة)",
 "white water": "مياه بيضاء, مياه هائجة (مياه رغوية كما في المنحدرات النهرية أو الشلالات)",
 "white wax tree": "تمرحنة صينية, شجرة الشمع الأبيض (شجيرة تشبه الشجرة قائمة دائمة الخضرة من الصين وكوريا واليابان لها أوراق مستدقة وزهور في عناقيد قائمة طويلة؛ تشبه التمرحنة اليابانية)",
 "white whale": "بيلوغا, حوت أبيض (حوت شمالي صغير يكون لونه أبيض عند البلوغ)",
 "white willow": "صفصاف أبيض (شجرة صفصاف كبيرة في أوراسيا وشمال أفريقيا ذات أوراق رمادية مبيضة ولحاء رمادي)",
 "white wine": "نَبِيذ أَبْيَض, خَمْر أَبْيَض (نَبِيذ (صفة مفردة مذكرة، مؤنثها نَبِيْذَة، وجمعها السالم نَبِيْذُوْن، وجمعها المؤنث السالم نَبِيْذَات، وجمعها المكسر أَنْبِذَة)؛ نَبِيذ (لا يؤنث، وجمعه أَنْبِذَة))\nمثال: أنا شربت النبيذ.",
 "white wolf": "ذئب أبيض, ذئب قطبي (ذئب من القطب الشمالي لأمريكا الشمالية ذو فرو أبيض وذيل أسود الطرف)",
 "white woman": "امرأة بيضاء (امرأة من العرق الأبيض)",
 "white wood aster": "أستر الغابة الأبيض (أستر غابات معمر جذموري من شرق أمريكا الشمالية بزهور بيضاء)",
 "white yam": "يام أبيض, يام الماء (يزرع في أسترالاسيا وبولينيزيا لجذره الكبير ذو اللحم الأبيض الناعم الصالح للأكل)",
 "white zinnia": "زينيا بيضاء (شجيرة صغيرة بسيقان صوفية نحيلة وأوراق ضيقة طويلة ورؤوس زهور بأشعة بيضاء؛ جنوب الولايات المتحدة وشمال المكسيك)",
 "white-bellied swallow": "سنونو أبيض البطن (سنونو أخضر مزرق وأبيض من أمريكا الشمالية؛ يعشش في تجاويف الأشجار)",
 "white-berry yew": "طقسوس أبيض التوت (طقسوس من جنوب شرق الصين، يختلف عن طقسوس العالم القديم بوجود توت أبيض)",
 "white-blotched": "ذُو بُقَع بَيْضَاء (عليه بقع بيضاء)",
 "white-bread": "بُرْجُوَازِيّ, تَقْلِيدِيّ (يَنْتَمِي إِلَى أَوْ يُمَثِّلُ الطَّبَقَةَ الوُسْطَى البَيْضَاء)",
 "white-breasted nuthatch": "كاسر الجوز أبيض الصدر (كاسر جوز رمادي مزرق برأس أسود وصدر أبيض؛ من شرق أمريكا الشمالية)",
 "white-browed tit": "قرقف أبيض الحواجب",
 "white-chinned petrel": "نوء أبيض الذقن (طائر نوء أسود كبير من البحار الجنوبية له علامة بيضاء على الذقن)",
 "white-coat hypertension": "ارتفاع ضغط الدم المعطفي, ارتفاع ضغط الدم عند رؤية الطبيب (ارتفاع مؤقت في ضغط الدم في عيادة الطبيب)",
 "white-collar": "إداري, ذو الياقات البيضاء (من أو يحدد العمل المهني أو الكتابي المأجور أو العمال)\nمثال: طمح ابن عامل المنجم إلى وظيفة مكتبية (ذوي الياقات البيضاء) كمحاسب",
 "white-crowned sparrow": "عصفور أبيض التاج (عصفور ذو تاج مخطط بالأبيض والأسود)",
 "white-edged": "أَبْيَض الحَافَّة (ذو حافة بيضاء)",
 "white-faced hornet": "دبور أصلع الوجه (دبور من أمريكا الشمالية)",
 "white-flowered": "أَبْيَض الأَزْهَار ((للنباتات) ذو أزهار بيضاء)",
 "white-footed mouse": "فأر أبيض القدمين (فأر غابات أمريكي ذو أقدام وأجزاء سفلية بيضاء)",
 "white-haired": "أَشْيَب",
 "white-headed stilt": "أبو مغازل أبيض الرأس (أبو مغازل من جنوب غرب المحيط الهادئ بما في ذلك أستراليا ونيوزيلندا ذو ريش أبيض في الغالب ولكن بأجنحة سوداء ومؤخرة عنق سوداء)",
 "white-headed vulture": "نَسْر أَبْيَض اَلرَّأْس (الكشط والجرح والنقب؛ طَيْر من الجَوَارِح أكبرها حجما يقتات الجِيَف وله منقار معقوف)\nمثال: الصغر أسرع من النسر",
 "white-heart hickory": "جوز موكرنت (جوز من أمريكا الشمالية أملس اللحاء بـ 7 إلى 9 وريقات يحمل جوزة صالحة للأكل صلبة القشرة)",
 "white-hot": "أَبْيَض مِنَ الحَرَارَة, مُتَوَهِّج (مُتوهِّج بالبياض من شدّة الحرارة) / غَيُور, مُتَحَمِّس بِشِدَّة (شديد الحماسة والتوقّد)",
 "white-leaved rockrose": "قيضة بيضاء الأوراق (شجيرة مدمجة بيضاء مزغبة من جنوب غرب أوروبا لها زهور وردية)",
 "white-lipped": "أَبْيَض الشَّفَتَيْن مِنَ الخَوْف (ابيضّت شفتاه من الخوف أو الرعب)",
 "white-lipped peccary": "بيكاري أبيض الشفة (بيكاري مسود ذو خدود بيضاء؛ أكبر من البيكاري المطوق)",
 "white-livered": "رَعْدِيد, هَيَّاب (سَرِيع الخَوْف وسَهْل الإِفْزَاع)",
 "white-man's foot": "لسان الحمل الكبير, لسان الحمل عريض الأوراق (نبات معمر أوروبي شائع تم توطينه في جميع أنحاء العالم؛ يعتبر عشباً ضاراً مزعجاً)",
 "white-pine rust": "صدأ الصنوبر الأبيض, صدأ تبثري",
 "white-pink": "وَرْدِيّ شَبَه أَبْيَض (وردي مع مسحة بيضاء؛ درجة فاتحة جداً من الوردي)",
 "white-rayed mule's ears": "أذن البغل بيضاء الشعاع (عشب بأوراق قاعدية وسيقان مشعرة ورقية تحمل رؤوساً زهرية منعزلة بأشعة بيضاء أو قشدية باهتة؛ شمال غرب الولايات المتحدة)",
 "white-ribbed": "ذُو أَضْلُع بَيْضَاء (عليه أضلاع أو حزوز بيضاء)",
 "white-rumped shrike": "صرد أبيض الردف (طائر صرد من غرب أمريكا الشمالية؛ رمادي مع أجزاء سفلية بيضاء)",
 "white-seeded": "أَبْيَضُ البُذُور (ذو بذور بيضاء اللون)",
 "white-shoe": "نُخْبَوِيّ مُحَافِظ (يدلّ على شركة أو مكتب محاماة يملكه ويديره أفراد من النخبة المحافظة)",
 "white-stemmed filaree": "رقمة مسكية, نفل المسك (عشب أوروبي حولي منخفض توطن في أمريكا؛ يشبه الرقمة الشوكرانية)",
 "white-streaked": "ذُو خُطُوط بَيْضَاء (عليه خطوط بيضاء)",
 "white-tailed deer": "أيل أبيض الذيل, أيل فرجينيا (أيل شائع في أمريكا الشمالية؛ ذيله له جانب سفلي أبيض)",
 "white-tailed jackrabbit": "أرنب بري أبيض الذيل (أكبر أرنب بري في السهول الشمالية والجبال الغربية للولايات المتحدة؛ لونه بني رمادي في الصيف ورمادي شاحب في الشتاء؛ ذيله أبيض بالكامل تقريباً دائماً)",
 "white-tailed kite": "حدأة بيضاء الذيل (حدأة أمريكية رمادية وبيضاء من المناطق الدافئة والاستوائية)",
 "white-tailed sea eagle": "عقاب البحر أبيض الذيل (عقاب ضخم بني رمادي بذيل أبيض قصير وتدي الشكل؛ من أوروبا وجرينلاند)",
 "white-throated sparrow": "عصفور أبيض الحنجرة (عصفور شائع في أمريكا الشمالية بقعة بيضاء على الحنجرة وتاج مخطط بالأبيض والأسود)",
 "white-tie": "بِرَبْطَةِ عُنُقٍ بَيْضَاء (يَسْتَلْزِمُ ارْتِدَاءَ رَبْطَاتِ عُنُقٍ بَيْضَاءَ وَمَعَاطِفَ بِأَذْيَالٍ لِلرِّجَالِ)",
 "white-tipped shark": "قرش أبيض الطرف, قرش محيطي أبيض الطرف (قرش كبير يعيش في المياه العميقة ذو زعنفة ظهرية بيضاء الطرف؛ واسع الانتشار عالمياً؛ يعتبر أخطر أنواع القرش)",
 "white-topped aster": "أستر أبيض القمة (عشب له زهور بيضاء شعاعية مع قنابات حرشفية وثمار حريرية غير متفتحة)",
 "whitebait": "أسماك صغيرة (الصغار الصالحة للأكل خاصة من الرنجة والاسبرط والهف) / أسماك صغيرة, وايت بيت (أسماك المنوة أو غيرها من الأسماك الصغيرة في المياه العذبة أو المالحة (خاصة الرنجة)؛ تطهى عادة كاملة)",
 "whitebark pine": "صنوبر أبيض اللحاء (صنوبر صغير من غرب أمريكا الشمالية؛ له لحاء أبيض رمادي أملس وخشب هش ناعم؛ يشبه الصنوبر المرن)",
 "whitebarked pine": "صنوبر أبيض اللحاء (صنوبر صغير من غرب أمريكا الشمالية؛ له لحاء أبيض رمادي أملس وخشب هش ناعم؛ يشبه الصنوبر المرن)",
 "whitebeam": "مُشْتَهَى",
 "whiteboard": "سَبُورَة بَيْضَاء",
 "whitecap": "رغوة الموج, زبد الموج (موجة تهب عليها الرياح فينكسر عرفها ويظهر أبيض اللون)",
 "whitecup": "كأس أبيض, نيرمبيرجيا زاحفة (عشب خشبي مفترش من أمريكا الجنوبية بزهور أنبوبية بيضاء غالباً مشوبة بالأزرق أو الوردي)",
 "whited sepulcher": "قبر مبيض (شخص شرير في الباطن ولكنه يتظاهر ظاهرياً بالفضيلة)",
 "whited sepulchre": "قبر مبيض (شخص شرير في الباطن ولكنه يتظاهر ظاهرياً بالفضيلة)",
 "whiteface": "أبيض الوجه, هيرفورد (سلالة إنجليزية قوية من الماشية تُربى على نطاق واسع في الولايات المتحدة) / مهرج أبيض الوجه (مهرج يغطي وجهه بمكياج أبيض)",
 "whitefish": "سمكة بيضاء (سمكة مياه عذبة فضية تشبه الرنجة صالحة للأكل تعيش في البحيرات الباردة في نصف الكرة الشمالي) / سمك أبيض (لحم سمكة مياه باردة شبيهة بالسلمون أو التراوت من البحيرات الباردة في نصف الكرة الشمالي) / سمك أبيض (أي سمك سوق - سمك صالح للأكل من المياه المالحة أو المحاريات - باستثناء الرنجة)",
 "whitefly": "ذبابة بيضاء (حشرة دقيقة تتغذى على عصارة النباتات؛ قريبة من الحشرات القشرية)",
 "whitehall": "وايتهول (الخدمة المدنية البريطانية)",
 "whitehead": "رأس سوداء, زؤان (سدادة سوداء الرأس تسد مسام الجلد)",
 "whitelash": "رد فعل البيض العنيف (رد فعل عنيف من قبل العنصريين البيض ضد تقدم الحقوق المدنية للسود)",
 "whiteman's foot": "لسان الحمل الكبير, لسان الحمل عريض الأوراق (نبات معمر أوروبي شائع تم توطينه في جميع أنحاء العالم؛ يعتبر عشباً ضاراً مزعجاً)",
 "whiten": "بَيَّضَ, اِبْيَضَّ (الأيام البِيض: الأيام التي توافق اليوم الثالث عشر، والرابع عشر، والخامس عشر من كل شهر من أشهر العام الهجري، وقد سُمِّيت بذلك…)\nمثال: ياني يحب البيض.",
 "whitened": "أَبْيَض, مُبْيَضّ (صار أبيض اللون أو شديد الشحوب)",
 "whitener": "عامل تبييض, مبيض (عامل يجعل الأشياء بيضاء أو عديمة اللون)",
 "whiteness": "بَيَاض",
 "whitening": "تبييض, تفتيح (التغيير إلى لون أفتح)",
 "whiteout": "بياض شامل, تعتيم ثلجي (حالة جوية قطبية بوجود سحب فوق الثلج تنتج بياضاً موحداً وتصعب رؤية الأشياء؛ تحدث عندما يساوي الضوء المنعكس من الثلج الضوء القادم عبر السحب)",
 "whitetail": "أيل أبيض الذيل, أيل فرجينيا (أيل شائع في أمريكا الشمالية؛ ذيله له جانب سفلي أبيض)",
 "whitetail antelope squirrel": "سنجاب الظبي (سنجاب أرضي صغير من غرب الولايات المتحدة)",
 "whitetail deer": "أيل أبيض الذيل, أيل فرجينيا (أيل شائع في أمريكا الشمالية؛ ذيله له جانب سفلي أبيض)",
 "whitetail jackrabbit": "أرنب بري أبيض الذيل (أكبر أرنب بري في السهول الشمالية والجبال الغربية للولايات المتحدة؛ لونه بني رمادي في الصيف ورمادي شاحب في الشتاء؛ ذيله أبيض بالكامل تقريباً دائماً)",
 "whitetail prairie dog": "كلب البراري أبيض الذيل (ذيله أبيض الطرف)",
 "whitethorn": "زعرور أبيض, زعرور إنجليزي (شجرة شجيرية أوراسية شائكة صغيرة لها عناقيد كثيفة من الزهور البيضاء إلى القرمزية تليها ثمار حمراء عميقة؛ استقرت كهارب في شرق أمريكا الشمالية)",
 "whitethroat": "عصفور أبيض الحنجرة (عصفور شائع في أمريكا الشمالية بقعة بيضاء على الحنجرة وتاج مخطط بالأبيض والأسود) / هازجة بيضاء الزور (هازجة من العالم القديم بنية رمادية ذات حلق وأجزاء سفلية بيضاء) / هازجة بيضاء الزور الصغرى (هازجة من العالم القديم تشبه الهازجة بيضاء الزور الكبرى ولكنها أصغر)",
 "whitetip shark": "قرش أبيض الطرف, قرش محيطي أبيض الطرف (قرش كبير يعيش في المياه العميقة ذو زعنفة ظهرية بيضاء الطرف؛ واسع الانتشار عالمياً؛ يعتبر أخطر أنواع القرش) / قرش الشعاب أبيض الطرف (كلب بحر أملس يعيش في المحيطين الهادئ والهندي والبحر الأحمر وله زعانف ظهرية وذيلية بيضاء الطرف)",
 "whitetop": "قُنَابَرَى, قُنَّابَرَى",
 "whitewash": "تستر, تلميع (تبرئة مخادعة تحاول التغطية على الإخفاقات والعيوب) / جير, طلاء جيري (غسول يتكون من الجير والغراء في الماء؛ يستخدم لتبييض الجدران والأسطح الأخرى) / هزيمة نظيفة (هزيمة يفشل فيها الشخص أو الفريق الخاسر في التسجيل)",
 "whitewashed": "مَطْلِيٌّ بِالجِير, مُبَيَّض (مُغَطًّى بِطِلَاءِ الجِير)",
 "whitewasher": "بَيَّاض",
 "whitewater": "مياه بيضاء, مياه هائجة (مياه رغوية كما في المنحدرات النهرية أو الشلالات)",
 "whitewood": "خشب الحور الأصفر, خشب الزنبق (خشب خفيف سهل العمل لشجرة الزنبق؛ يستخدم للأثاث والقشرة)",
 "whitey": "أبيض (تحقير) ((عامية) أسماء مهينة للرجل الأبيض)",
 "whither": "إِلَى أَيْنَ (حرف جر يُفيد الغاية الزمنية؛ حرف جر يُفيد الغاية المكانية)\nمثال: تعال إلى منزلي.",
 "whiting": "بياض / نازلي فضي (يوجد قبالة ساحل المحيط الأطلسي لأمريكا الشمالية) / بياض (أي من عدة أسماك غذائية في المياه الساحلية لأمريكا الشمالية)",
 "whitish": "أَبْيَض مَائِل, مُبْيَضّ (بلون يميل إلى البياض) / أَبْيَض مُعْتِم, حَلِيبِيّ (يُشبه الحليب في لونه الأبيض غير الصافي)",
 "whitlavia": "جريس كاليفورنيا, ويتلافيا (نبات صحراوي من جنوب كاليفورنيا بزهور أنبوبية زرقاء أو بنفسجية في عناقيد طرفية)",
 "whitlow": "دَاحِس",
 "whitlow grass": "دربة, عشبة الداحس (عشبة ضارة حولية من أوروبا وأمريكا الشمالية ذات وريدة من الأوراق القاعدية وأزهار صغيرة تليها كبسولات بذور مستطيلة)",
 "whitlowwort": "داحسية",
