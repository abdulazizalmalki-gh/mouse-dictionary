 "huskiness": "أَجَشِّيَّة, بَحَّة (خشونة تخرج من الحلق) / خشونة, قوة (خاصية كون الشخص كبيراً وقوياً)",
 "husking": "تعرية, كشف (إزالة الغطاء)",
 "husking bee": "تجمع تقشير الذرة (تجمع اجتماعي لغرض تقشير الذرة)",
 "husky": "أَجَشّ, مَبْحُوح (عَمِيق وخَشِن الصَّوْت كَأَنَّهُ مِنْ صُرَاخٍ أَوْ مَرَض أَوِ انْفِعَال) / ضَخْمُ البِنْيَة, مَفْتُول (عضليّ وثقيل البنية) / كلب الإسكيمو (سلالة من كلاب الزلاجات القطبية كثيفة المعطف)",
 "hussar": "فارس خفيف, هوسار (عضو في وحدة فرسان أوروبية خفيفة؛ اشتهروا بملابسهم الأنيقة)",
 "hussar monkey": "سعدان باتاس, سعدان عسكري (قرد محمر طويل الذيل من غرب أفريقيا)",
 "hussite": "هُوسِيّ (معتنق للإصلاحات الدينية لجون هوس)",
 "hussitism": "هوسية (حركة مسيحية تتبع تعاليم المصلح التشيكي يان هوس (حوالي 1369-1415)، الذي أصبح أشهر ممثل للإصلاح البوهيمي وأحد رواد الإصلاح البروتستانتي)\nمثال: عادة ما كان التابوريون يحظون بدعم الأوريبيين (الذين سموا لاحقاً بالأيتام)، وهي طائفة هوسية من شرق بوهيميا مقرها في هرادتس كرالوفه",
 "hussy": "زانية, فاجرة (امرأة ترتكب الزنا) / عاهرة, فاجرة (امرأة منحلّة جنسياً)",
 "hustings": "أنشطة الحملة, منصة انتخابية (الأنشطة التي تنطوي عليها الحملات السياسية (خاصة إلقاء الخطب))",
 "hustle": "صخب, ضجة (اضطراب نشط وسريع) / احتيال, خديعة الثقة (عملية نصب تغش فيها في القمار أو تقنع شخصاً بشراء ممتلكات لا قيمة لها)",
 "hustler": "داهية, محتال ذكي (شخص ذكي أو عديم المبادئ يعرف كيفية التحايل على الصعوبات لتحقيق أهدافه) / عاهرة شوارع (عاهرة تجذب الزبائن بالمشي في الشوارع)",
 "hut": "كُوخ, تَخْشِيبَة",
 "hutch": "عشة, كوخ (مأوى صغير بدائي يستخدم كمسكن) / قفص حيوانات صغيرة, قفص خشبي (قفص (يُصنع عادة من الخشب وشبكة سلكية) للحيوانات الصغيرة)",
 "hutment": "مخيم أكواخ (مخيم من الأكواخ (عسكري بشكل رئيسي))",
 "hutu": "هُوتُو (عضو في شعب بانتو يعيش في رواندا وبوروندي)",
 "hutzpah": "جرأة وقحة ((اليديشية) وقاحة لا تصدق؛ صفاقة؛ جرأة)",
 "huxleian": "هكسلي (من أو يتعلق بتوماس هكسلي)",
 "huxleyan": "هكسلي (من أو يتعلق بتوماس هكسلي)",
 "huygens' principle of superposition": "مبدأ التراكب (إزاحة أي نقطة بسبب تراكب أنظمة الموجات تساوي مجموع إزاحات الموجات الفردية عند تلك النقطة)\nمثال: مبدأ التراكب هو أساس النظرية الموجية للضوء",
 "hyacinth": "خزامى, ياسنت (أي من الأعشاب المعمرة البصلية المتعددة) / زركون أحمر, هياسينث (نوع شفاف أحمر من الزركون يستخدم كحجر كريم)",
 "hyacinth bean": "لَبْلَاب",
 "hyacinthoides nonscripta": "جريس, ياسنت الخشب (يصنف أحياناً في جنس سيلا)",
 "hyacinthus candicans": "ياقوتية الصيف, ياقوتية الكاب (عشب جنوب أفريقي بزهور بيضاء جرسية الشكل)",
 "hyacinthus orientalis": "صفير, ياقوتية شائعة (تزرع على نطاق واسع لرائحتها وزهورها البيضاء أو الوردية أو الزرقاء أو الأرجوانية)",
 "hyacinthus orientalis albulus": "ياقوتية رومانية (ياقوتية بسنابل فضفاضة الزهور، تنمو عدة منها من بصلة واحدة)",
 "hyades": "هياديس ((الأساطير اليونانية) 7 بنات لأطلس وأخوات غير شقيقات للثريا (البلياديس)؛ قمن بتربية ديونيسوس الرضيع ووضعهن زيوس بين النجوم كمكافأة)",
 "hyaena": "ضبع (ثديي ليلي يشبه الكلب من أفريقيا وجنوب آسيا يتغذى بشكل رئيسي على الجيف)",
 "hyaena brunnea": "ضبع بني (من جنوب أفريقيا)",
 "hyaena hyaena": "ضبع مخطط (من شمال أفريقيا والجزيرة العربية والهند)",
 "hyalin": "مادة زجاجية, هيالين (مادة شفافة زجاجية توجد في الغضروف الزجاجي أو في حالات جلدية معينة)",
 "hyaline": "زُجَاجِيّ, هَيَالِينِيّ (يُشبه الزجاج في شفافيّته أو شبه شفافيّته) / مادة زجاجية, هيالين (مادة شفافة زجاجية توجد في الغضروف الزجاجي أو في حالات جلدية معينة)",
 "hyaline cartilage": "غضروف زجاجي (غضروف شفاف شائع في المفاصل والممرات التنفسية؛ يشكل معظم الهيكل العظمي للجنين)",
 "hyaline membrane disease": "متلازمة الضائقة التنفسية (مرض رئوي حاد يصيب حديثي الولادة (خاصة الخدج))",
 "hyalinisation": "تزجج, تنكس زجاجي (حالة التحول إلى زجاجي أو شفاف)\nمثال: أظهرت الشرايين الصغيرة للمريض تنكساً زجاجياً ملحوظاً",
 "hyalinization": "تزجج, تنكس زجاجي (حالة التحول إلى زجاجي أو شفاف)\nمثال: أظهرت الشرايين الصغيرة للمريض تنكساً زجاجياً ملحوظاً",
 "hyaloid": "زُجَاجِيّ, هَيَالِينِيّ (يُشبه الزجاج في شفافيّته أو شبه شفافيّته) / غشاء زجاجي (الغشاء الشفاف الذي يغلف الخلط الزجاجي للعين ويفصله عن الشبكية)",
 "hyaloid membrane": "غشاء زجاجي (الغشاء الشفاف الذي يغلف الخلط الزجاجي للعين ويفصله عن الشبكية)",
 "hyalophora cecropia": "عثة سيكروبيا (عثة دودة قز من أمريكا الشمالية؛ تتغذى اليرقات على أوراق أشجار الغابات)",
 "hyaloplasm": "جبلة شفافة, هيالوبلازم (الجزء الشفاف غير الحبيبي من سيتوبلازم الخلية)",
 "hyaloplasmic": "زجاجي, هيالي (مكون من أو متعلق بالهيالوبلازم (الجبلة الشفافة))",
 "hyaluronic acid": "حمض الهيالورونيك (عديد سكاريد مخاطي لزج يوجد في النسيج الضام والسائل الزليلي للمفاصل المتحركة وسوائل العين؛ مادة لاصقة وواقية)",
 "hyaluronidase": "هيالورونيداز (إنزيم يحلل حمض الهيالورونيك وبالتالي يقلل من لزوجته ويزيد من نفاذية النسيج الضام وامتصاص السوائل)",
 "hyazyme": "هيالورونيداز (إنزيم يحلل حمض الهيالورونيك وبالتالي يقلل من لزوجته ويزيد من نفاذية النسيج الضام وامتصاص السوائل)",
 "hybrid": "هَجِين",
 "hybrid car": "سيارة هجينة (سيارة تعمل بمصدرين للطاقة، عادة محرك احتراق داخلي ومحرك كهربائي)",
 "hybrid petunia": "بيتونيا هجينة (هجائن من البيتونيا البيضاء والبنفسجية: مجموعة معقدة من البيتونيا لها زهور مفردة أو مزدوجة بألوان من الأبيض إلى الأرجواني)",
 "hybrid tuberous begonia": "بيغونيا درنية هجينة (أي من العديد من البيغونيا الهجينة التي لها جذور درنية وزهور ملونة بألوان مختلفة)",
 "hybrid vigor": "تغاير, قوة الهجين ((وراثة) ميل الكائن الهجين لامتلاك صفات متفوقة على صفات أي من الوالدين)",
 "hybridisation": "تزاوج خلطي, تهجين ((في الوراثة) فعل خلط أنواع أو أصناف مختلفة من الحيوانات أو النباتات لإنتاج هجائن)",
 "hybridization": "تَهْجِين",
 "hybridizing": "تزاوج خلطي, تهجين ((في الوراثة) فعل خلط أنواع أو أصناف مختلفة من الحيوانات أو النباتات لإنتاج هجائن)",
 "hybridoma": "خلية هجينة, ورم هجين (خلية هجينة ناتجة عن اندماج خلية لمفاوية وخلية ورمية؛ تستخدم لاستنبات جسم مضاد وحيد النسيلة محدد)",
 "hydantoin": "هيدانتوين (أي من مجموعة أدوية مضادة للاختلاج تستخدم في علاج الصرع)",
 "hydathode": "ثغر مائي (مسام يفرز الماء على سطح أو حافة ورقة النباتات العليا)",
 "hydatid": "كيسة مائية (كيس مملوء بسائل؛ يتشكل نتيجة لغزو يرقات الديدان الشريطية)",
 "hydatid disease": "داء المشوكات, كيسات عذرية (الإصابة بيرقات المشوكات (الديدان الشريطية))",
 "hydatid mole": "حمل عنقودي, رحى عدارية (شذوذ أثناء الحمل؛ تتحلل الزغابات المشيمية حول الجنين وتشكل عناقيد من أكياس مملوءة بسائل؛ يرتبط عادة بموت الجنين)",
 "hydatidiform mole": "حمل عنقودي, رحى عدارية (شذوذ أثناء الحمل؛ تتحلل الزغابات المشيمية حول الجنين وتشكل عناقيد من أكياس مملوءة بسائل؛ يرتبط عادة بموت الجنين)",
 "hydatidosis": "داء المشوكات, كيسات عذرية (الإصابة بيرقات المشوكات (الديدان الشريطية))",
 "hyde park": "هَايْد بَارْك",
 "hyderabad": "حَيْدَر أَبَاد (من أسماء الأسد، وقد يستخدم للتشبيه؛ اسم علم مذكر عربي،معناه : الأسد ، الجميل ، السمين . يكثر هذا الاسم بين الإمامية لأنه اسم الإمام علي ؛ سمته به أمُّه حين ولدته…)",
 "hydnocarpus kurzii": "تشالموجرا (شجرة من شرق الهند ذات بذور زيتية تنتج زيت التشالموجرا المستخدم لعلاج الجذام)",
 "hydnocarpus laurifolia": "هيدنوكاربوس (شجرة جلدية الأوراق من غرب الهند تحمل ثماراً مستديرة ذات قشرة بنية مشعرة بكثافة تحيط بلب زيتي ينتج زيت الهيدنوكاربوس)",
 "hydnocarpus oil": "زيت الهيدنوكاربوس (زيت من بذور أشجار جنس الهيدنوكاربوس)",
 "hydnocarpus wightiana": "هيدنوكاربوس (شجرة جلدية الأوراق من غرب الهند تحمل ثماراً مستديرة ذات قشرة بنية مشعرة بكثافة تحيط بلب زيتي ينتج زيت الهيدنوكاربوس)",
 "hydra": "هِيدْرَا",
 "hydralazine": "أبريسولين, هيدرالازين (دواء خافض لضغط الدم (الاسم التجاري أبريسولين) يوسع الأوعية الدموية؛ يستخدم (غالباً مع مدر للبول) لعلاج ارتفاع ضغط الدم وفشل القلب الاحتقاني)",
 "hydramnios": "استسقاء سلوي, موه السلى (شذوذ في الحمل؛ تراكم السائل السلوي الزائد)",
 "hydrangea": "كوبية, هيدرانجيا (أي من الشجيرات النفضية أو دائمة الخضرة المتنوعة من جنس كوبية)",
 "hydrangea anomala": "كوبية شاذة, هيدرانجيا متسلقة (نبات متسلق متساقط الأوراق بجذور هوائية وزهور بيضاء إلى كريمية في رؤوس مسطحة إلى حد ما)",
 "hydrangea arborescens": "كوبية شجرية, هيدرانجيا برية (شجيرة متساقطة الأوراق بعناقيد زهور بيضاء كريمية؛ شرق الولايات المتحدة)",
 "hydrangea macrophylla hortensis": "كوبية كبيرة الأوراق, هورتنسيا (شجيرة متساقطة الأوراق تحمل عناقيد زهور مستديرة الرأس تفتح خضراء وتتحول إلى الوردي أو الأزرق مع تقدم العمر)",
 "hydrangea paniculata": "كوبية عثكولية, هيدرانجيا خريفية (شجيرة متساقطة الأوراق أو شجرة صغيرة بعناقيد زهور هرمية)",
 "hydrangea petiolaris": "كوبية معنقة, هيدرانجيا متسلقة (نبات متسلق متساقط الأوراق بجذور هوائية ورؤوس زهور مسطحة كبيرة)",
 "hydrant": "حنفية إطفاء, صنبور (أنبوب تصريف مزود بصمام وفوهة يمكن من خلاله سحب المياه من شبكة المياه الرئيسية) / حنفية, صنبور المياه (صنبور لسحب الماء من أنبوب أو برميل)",
 "hydrargyrum": "زئبق (عنصر فلزي ثقيل فضي سام أحادي وثنائي التكافؤ؛ المعدن الوحيد الذي يكون سائلاً في درجات الحرارة العادية)",
 "hydrarthrosis": "موه المفصل (التهاب وتورم مفصل متحرك بسبب زيادة السائل الزليلي)",
 "hydrastis canadensis": "الجذر الأصفر, خاتم الذهب (عشب معمر في شمال شرق الولايات المتحدة له ساق جذري أصفر سميك وعقدي وأوراق مستديرة كبيرة)",
 "hydrate": "هَايْدْرَات",
 "hydrated": "مائي, مميه (يحتوي على ماء متحد (خاصة ماء التبلور كما في الهيدرات))",
 "hydrated aluminium oxide": "هيدروكسيد الألومنيوم (مركب بلوري أبيض يوجد بشكل طبيعي كمعدن الجبسيت)",
 "hydrated aluminum oxide": "هيدروكسيد الألومنيوم (مركب بلوري أبيض يوجد بشكل طبيعي كمعدن الجبسيت)",
 "hydrated lime": "جير, هيدروكسيد الكالسيوم (مادة كاوية تنتج عن تسخين الحجر الجيري)",
 "hydrated oxide": "أكسيد مائي, هيدروكسيد (مركب من أكسيد مع ماء)",
 "hydration": "إِمَاهَة",
 "hydraulic": "هيدروليكي (من أو متعلق بدراسة الهيدروليكا (ميكانيكا السوائل)) / هيدروليكي (يتحرك أو يعمل أو يتأثر بواسطة سائل (ماء أو زيت))\nمثال: مهندس هيدروليكي",
 "hydraulic brake": "مكبح هيدروليكي (نظام مكابح تحرك فيه دواسة الفرامل مكبساً في الأسطوانة الرئيسية؛ ثم يطبق سائل الفرامل قوة كبيرة على وسادات الفرامل أو الأحذية)",
 "hydraulic brake cylinder": "أسطوانة الفرامل, الأسطوانة الرئيسية (أسطوانة تحتوي على سائل الفرامل الذي يتم ضغطه بواسطة مكبس)",
 "hydraulic brakes": "مكبح هيدروليكي (نظام مكابح تحرك فيه دواسة الفرامل مكبساً في الأسطوانة الرئيسية؛ ثم يطبق سائل الفرامل قوة كبيرة على وسادات الفرامل أو الأحذية)",
 "hydraulic cement": "أسمنت بورتلاندي, أسمنت هيدروليكي (أسمنت يتصلب تحت الماء؛ يصنع بتسخين الحجر الجيري والطين في فرن وطحن الناتج)",
 "hydraulic engineering": "هندسة هيدروليكية (الحدُّ والقياس؛ في الرياضيات: هي العلم الذي يبحث في الأشكال وعلاقاتها من حيث الخطوط والأبعاد والسطوح وغيرها)\nمثال: هو ضليع في علم الهندسة .",
 "hydraulic motor": "محرك هيدروليكي (مشغل ميكانيكي يحول الضغط والتدفق الهيدروليكي إلى عزم دوران وإزاحة زاوية (دوران))",
 "hydraulic press": "مكبس هيدروليكي (مكبس تنتقل فيه القوة المطبقة بواسطة مكبس على مساحة صغيرة عبر الماء إلى مكبس آخر ذي مساحة كبيرة)",
 "hydraulic pump": "كبش هيدروليكي, مضخة هيدروليكية (مضخة مياه تستخدم الطاقة الحركية للمياه المتدفقة لدفع جزء صغير من تلك المياه إلى خزان بمستوى أعلى)",
 "hydraulic ram": "كبش هيدروليكي, مضخة هيدروليكية (مضخة مياه تستخدم الطاقة الحركية للمياه المتدفقة لدفع جزء صغير من تلك المياه إلى خزان بمستوى أعلى)",
 "hydraulic system": "نظام هيدروليكي (آلية تعمل بالمقاومة أو الضغط المنقول عندما يتم دفع سائل عبر فتحة صغيرة أو أنبوب)",
 "hydraulic transmission": "ناقل حركة هيدروليكي (ناقل حركة يعتمد على نظام هيدروليكي)",
 "hydraulic transmission system": "ناقل حركة هيدروليكي (ناقل حركة يعتمد على نظام هيدروليكي)",
 "hydraulically": "هيدروليكياً (بطريقة هيدروليكية)\nمثال: يتم اختبار الكتلة هيدروليكياً للتأكد من تحمل ضغط التصميم الكامل",
 "hydraulicly": "هيدروليكياً (بطريقة هيدروليكية)\nمثال: يتم اختبار الكتلة هيدروليكياً للتأكد من تحمل ضغط التصميم الكامل",
 "hydraulics": "ميكانيك السوائل",
 "hydrazide": "هيدرازيت (أي من فئة المركبات العضوية التي تشترك في مجموعة وظيفية تتميز برابطة تساهمية بين نيتروجين ونيتروجين مع 4 بدائل يكون أحدها على الأقل مجموعة أسيل)",
 "hydrazine": "هيدرازين (سائل أكال عديم اللون ومدخن؛ عامل اختزال قوي؛ يستخدم بشكل رئيسي في وقود الصواريخ)",
 "hydrazo group": "شق هيدرازو, مجموعة هيدرازو ((شَقَّ) الفَرَسُ ونحوُهُ يَشِقَّ شَقَقًا: مال في جَرْيِهِ إِلى جانب؛ فهو أشَقُّ، وهي شَقَّاءُ)\nمثال: اكشف عن الشق العلوي من الجسم.",
 "hydrazo radical": "شق هيدرازو, مجموعة هيدرازو ((شَقَّ) الفَرَسُ ونحوُهُ يَشِقَّ شَقَقًا: مال في جَرْيِهِ إِلى جانب؛ فهو أشَقُّ، وهي شَقَّاءُ)\nمثال: اكشف عن الشق العلوي من الجسم.",
 "hydrazoic acid": "حمض الهيدرازويك (سائل متفجر عديم اللون متطاير وسام وكريه الرائحة)",
 "hydrazoite": "هيدرازويت (ملح لحمض الهيدرازويك)",
 "hydremia": "موه الدم (اضطراب دموي يكون فيه حجم السائل زائداً مقارنة بحجم خلايا الدم)",
 "hydric": "رطوبي (يحتوي على أو يتميز برطوبة مفرطة)\nمثال: موطن رطوبي",
 "hydride": "هيدريد (أي مركب ثنائي يتكون من اتحاد الهيدروجين وعناصر أخرى)",
 "hydrilla": "هيدريلا (نبات مغمور بأوراق رمحية محيطية وأزهار إبطية منعزلة؛ نبات من العالم القديم استوطن في جنوب الولايات المتحدة ويسد الممرات المائية في فلوريدا)",
 "hydrilla verticillata": "هيدريلا (نبات مغمور بأوراق رمحية محيطية وأزهار إبطية منعزلة؛ نبات من العالم القديم استوطن في جنوب الولايات المتحدة ويسد الممرات المائية في فلوريدا)",
 "hydriodic acid": "حمض الهيدرويوديك\nمثال: حمض الهيدرويوديك هو حمض قوي (أصبح حامضًا، تغير الطعم إلى الحموضة؛ ارتفعت نسبة الحموضة في شيء ما، كما في الطعام أو السوائل)\nمثال: رمى ياني الحمض على وجه سكورة.",
 "hydrobates pelagicus": "نوء العاصفة (طائر نوء أسود فحمي مع علامات بيضاء؛ يعيش في شمال المحيط الأطلسي والبحر الأبيض المتوسط)",
 "hydrobromic acid": "حمض الهيدروبروميك (محلول مائي لبروميد الهيدروجين وهو حمض سائل قوي)",
 "hydrocarbon": "هيدروكربون (مركب عضوي يحتوي فقط على الكربون والهيدروجين)",
 "hydrocele": "قِيلَة مَائِيَّة",
 "hydrocephalic": "استسقائي (متعلق بـ أو يتميز بـ أو يظهر استسقاء الدماغ)",
 "hydrocephalus": "مواه الرأس",
 "hydrocephaly": "استسقاء الدماغ (حالة غير طبيعية يتجمع فيها السائل النخاعي في بطينات الدماغ؛ عند الرضع يمكن أن يسبب نمواً سريعاً غير طبيعي للرأس وانتفاخ اليافوخ وصغر الوجه؛ في…)",
 "hydrocharis morsus-ranae": "لكمة الضفدع, هيدروشاريس (نبات أوروبي عائم بأوراق دائرية على شكل قلب وأزهار بيضاء)",
 "hydrochloric acid": "حَامِض الْهِيدْرُولِيك, حَمْض الْهِيدْرُولِيك",
 "hydrochloride": "هيدروكلوريد (معقد يتكون من قاعدة عضوية مرتبطة بكلوريد الهيدروجين)",
 "hydrochlorofluorocarbon": "هيدروكلوروفلوروكربون (فلوروكربون يحل محل الكلوروفلوروكربون كمبرد ووقود في علب الرش؛ يُعتبر أقل تدميراً للغلاف الجوي إلى حد ما)",
 "hydrochlorothiazide": "هيدروكلوروثيازيد (دواء مدر للبول (الاسم التجاري ميكروزيد وإيسيدريكس) يستخدم في علاج ارتفاع ضغط الدم)",
 "hydrochoerus hydrochaeris": "خنزير الماء, كابيبارا (قارض برمائي من أمريكا الجنوبية بحجم الخنزير وعديم الذيل ذو أقدام مكففة جزئياً؛ أكبر القوارض الحية)",
 "hydrocolloid": "غرواني مائي (مادة تشكل هلاماً مع الماء)",
 "hydrocortisone": "كورتيزول, هيدروكورتيزون (هرمون قشرة الكظر الذي ينشط في استقلاب الكربوهيدرات والبروتين)",
 "hydrocortone": "كورتيزول, هيدروكورتيزون (هرمون قشرة الكظر الذي ينشط في استقلاب الكربوهيدرات والبروتين)",
 "hydrocracking": "تكسير هيدروجيني (العملية التي يتم فيها تكسير جزيئات الهيدروكربون البترولي إلى كيروسين وبنزين عن طريق إضافة الهيدروجين تحت ضغط عالٍ بوجود عامل حفاز)",
 "hydrocyanic acid": "حمض البروسيك, حمض الهيدروسيانيك (محلول لسيانيد الهيدروجين في الماء؛ تستخدم المحاليل الضعيفة في التبخير وفي تخليق المركبات العضوية)",
 "hydrodamalis gigas": "بقر البحر ستيلر (ثديي خيلاني ضخم منقرض كان يوجد سابقاً بالقرب من الساحل الآسيوي لبحر بيرينغ)",
 "hydrodiuril": "هيدروكلوروثيازيد (دواء مدر للبول (الاسم التجاري ميكروزيد وإيسيدريكس) يستخدم في علاج ارتفاع ضغط الدم)",
 "hydrodynamic": "هيدروديناميكي (من أو يتعلق بالهيدروديناميكا (ديناميكا السوائل))",
 "hydrodynamics": "ديناميكا الموائع, هيدروديناميكا (دراسة السوائل المتحركة)",
 "hydroelectric": "كهرمائي (متعلق بإنتاج الكهرباء بواسطة الطاقة المائية أو مستخدم فيها)\nمثال: طاقة كهرمائية",
 "hydroelectric turbine": "توربين كهرومائي, عنفة كهرومائية (توربين يتكون من نسخة كبيرة وفعالة من عجلة مائية تستخدم لتشغيل مولد كهربائي)",
 "hydroelectricity": "طاقة كهرمائية (القُدْرَة والشِدَّة؛ هي مقدار ما يمكن للإنسان أن يفعله بمشقة، كأن قدرته محددة بطَوْق)\nمثال: طلب بطاقة اعتماد.",
 "hydroflumethiazide": "هيدروفلوميثيازيد (مدر للبول يستخدم لعلاج ارتفاع ضغط الدم والوذمة)",
 "hydrofluoric acid": "حمض الهيدروفلوريك (حمض سائل سام ضعيف؛ يتكون من ذوبان فلوريد الهيدروجين في الماء)",
 "hydrofluorocarbon": "هيدروفلوروكربون (فلوروكربون ينبعث كمنتج ثانوي للتصنيع الصناعي)",
 "hydrofluosilicic acid": "حمض الفلوروسيليسيك (حمض سام غير مستقر ومسبب للتآكل يعرف أساساً في شكل أملاحه)",
 "hydrofoil": "قارب مجنح, قارب محلق (زورق سريع مجهز بهياكل تشبه الأجنحة ترفعه بحيث ينزلق فوق الماء بسرعات عالية) / جنيح مائي, زعنفة مائية (جهاز يتكون من قطعة مسطحة أو منحنية (كلوح معدني) بحيث يتفاعل سطحها مع الماء الذي تمر عبره)\nمثال: يضم المتحف نسخة طبق الأصل من القارب المجنح النفاث الذي حطم الرقم القياسي",
 "hydrogel": "هلام مائي (هلام غرواني يكون فيه الماء هو وسط التشتت)",
 "hydrogen": "هَيْدُرُوجِين / هِيدْرُوجِين",
 "hydrogen atom": "ذرة هيدروجين (ذرة من الهيدروجين)",
 "hydrogen azide": "حمض الهيدرازويك (سائل متفجر عديم اللون متطاير وسام وكريه الرائحة)",
 "hydrogen bomb": "قنبلة هيدروجينية (سلاح نووي يطلق طاقة ذرية عن طريق اتحاد نوى خفيفة (هيدروجين) عند درجات حرارة عالية لتكوين الهيليوم)",
 "hydrogen bond": "رابطة هيدروجينية (رابطة كيميائية تتكون من ذرة هيدروجين بين ذرتين سلبيتين كهربائياً (مثل الأكسجين أو النيتروجين) بحيث يكون أحد الجانبين رابطة تساهمية والآخر رابطة أيونية)",
 "hydrogen bromide": "بروميد الهيدروجين (غاز عديم اللون ينتج حمض الهيدروبروميك عند ذوبانه في الماء)",
 "hydrogen carbonate": "بيكربونات, كربونات الهيدروجين",
 "hydrogen chloride": "كلوريد الهيدروجين",
 "hydrogen cyanide": "سيانيد الهيدروجين (غاز شديد السمية أو سائل متطاير تفوح منه رائحة اللوز المر؛ يتحول إلى غاز عند حوالي 90 درجة فهرنهايت ويكون أخطر عند استنشاقه؛ وهو أنهيدريد حمض…)",
 "hydrogen electrode": "قطب الهيدروجين ((كيمياء، فيزياء) قطب كهربائي يتم فيه امتزاز غاز الهيدروجين على البلاتين)",
 "hydrogen fluoride": "فلوريد الهيدروجين (سائل تآكلي سام عديم اللون ينتج عن تفاعل حمض الكبريتيك مع فلوريد الكالسيوم؛ ومحاليله المائية هي حمض الهيدروفلوريك)",
 "hydrogen iodide": "يوديد الهيدروجين (غاز عديم اللون ينتج حمض الهيدرويوديك في المحلول المائي)",
 "hydrogen ion": "أَيُون الهِيدْرُوجِين (ذرة هيدروجين موجبة الشحنة؛ أي نواة ذرة هيدروجين عادية)",
 "hydrogen ion concentration": "تركيز أيون الهيدروجين (عدد مولات أيونات الهيدروجين لكل ديسيمتر مكعب)",
 "hydrogen peroxide": "بيروكسيد, بيروكسيد الهيدروجين (سائل لزج ذو خصائص أكسدة قوية؛ عامل تبييض قوي؛ يستخدم أيضاً (في المحاليل المائية) كمطهر خفيف، وفي (التركيزات القوية) كمؤكسد في وقود الصواريخ)",
 "hydrogen selenide": "سيلينيد الهيدروجين",
 "hydrogen sulfate": "بيكبريتات, كبريتات الهيدروجين",
 "hydrogen sulfide": "كبريتيد الهيدروجين (كبريتيد له رائحة كريهة تشبه رائحة البيض الفاسد)",
 "hydrogen vehicle": "سَيَّارَة هِيدْرُوجِينِيَّة (مؤنث سَيَّار، صفة للكثير السَيْر؛ القَافِلَة أوالقَوْم الذين يسيرون)\nمثال: إنه يملك سيارة.",
 "hydrogenate": "هَدْرَجَ",
 "hydrogenation": "هدرجة (عملية كيميائية تضيف ذرات الهيدروجين إلى زيت غير مشبع)\nمثال: يستخدم منتجو الأغذية الهدرجة لمنع الدهون من التعفن",
 "hydrographic": "مسحي مائي, هيدروغرافي (مكون من أو متعلق بعلم الهيدروغرافيا (مسح المياه))",
 "hydrographical": "مسحي مائي, هيدروغرافي (مكون من أو متعلق بعلم الهيدروغرافيا (مسح المياه))",
 "hydrography": "مسح مائي, هيدروغرافيا (علم قياس ووصف ورسم خرائط المياه السطحية للأرض مع إشارة خاصة للملاحة)",
 "hydroid": "أبابيات, هيدريات (جوفمعويات استعمارية تكون فيها مرحلة السليلة سائدة)",
 "hydroiodic acid": "حمض الهيدرويوديك (حمض يتكون من المحلول المائي ليوديد الهيدروجين)",
 "hydroisohypse": "خط تساوي ارتفاع الماء الجوفي (خط على خريطة يربط نقاط المستوى المتساوي على السطح البيزومتري)",
 "hydroisopieze": "خط تساوي ضغط الطبقة المائية (خط على خريطة يربط نقاط الضغوط المتماثلة في الطبقة الحاملة للمياه)",
 "hydrokinetic": "حركي مائي, هيدروحركي (متعلق بالسوائل في حالة الحركة أو القوى التي تنتج أو تؤثر على تلك الحركة)",
 "hydrokinetic engine": "محرك مائي حركي (محرك يحول طاقة المياه المتساقطة إلى طاقة عمود دوران)",
 "hydrokinetics": "ديناميكا الموائع, هيدروديناميكا (دراسة السوائل المتحركة)",
 "hydrolith": "هيدريد الكالسيوم",
 "hydrologist": "عالم مياه, هيدرولوجي (جيولوجي ماهر في علم المياه)",
 "hydrology": "عِلْم المِيَاهِيَّات (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "hydrolysate": "حلمهة, ناتج التحلل المائي (ناتج عملية التحلل المائي)",
 "hydrolysis": "تحلل مائي (تفاعل كيميائي يتفاعل فيه الماء مع مركب لإنتاج مركبات أخرى؛ ويتضمن انقسام الرابطة وإضافة كاتيون الهيدروجين وأنيون الهيدروكسيد من الماء)",
 "hydrolyzable": "قابل للتحلل المائي (قادر على الخضوع للتحلل المائي)",
 "hydromancer": "عرّاف الماء (من يمارس العرافة بالماء)",
 "hydromancy": "عرافة الماء (التنجيم بواسطة الماء)",
 "hydromantes brunus": "سمندل الحجر الجيري (يشبه سمندل شاستا؛ يعيش في شقوق المنحدرات والركام الصخري)",
 "hydromantes shastae": "سمندل شاستا (ساكن كهوف بشكل أساسي في منطقة جبل شاستا)",
 "hydromel": "شراب العسل, هيدروميل (عسل مخفف بالماء؛ يصبح نبيذ العسل (الميد) عند تخمره)",
 "hydrometer": "مقياس كثافة السوائل, هيدرومتر (أداة قياس لتحديد الثقل النوعي لسائل أو صلب)",
 "hydrometric": "قياس مائي, هيدرومتري (من أو يتعلق بالهيدرومتري (قياس كثافة السوائل))",
 "hydrometry": "قياس الكثافة النوعية, قياس الوزن النوعي (قياس الثقل النوعي للسوائل)",
 "hydromorphone": "ديلوديد, هيدرومورفون (مسكن مخدر (الاسم التجاري ديلوديد) يستخدم لعلاج الألم المتوسط إلى الشديد)",
 "hydromorphone hydrochloride": "ديلوديد, هيدرومورفون (مسكن مخدر (الاسم التجاري ديلوديد) يستخدم لعلاج الألم المتوسط إلى الشديد)",
 "hydronephrosis": "استسقاء الكلية, موه الكلية (تراكم البول في الكلية بسبب انسداد في الحالب)",
 "hydropathic": "مائي علاجي (من أو متعلق بالمعالجة المائية أو إدارتها)\nمثال: علاجات مائية",
 "hydropathy": "علاج مائي (الاستخدام الداخلي والخارجي للماء في علاج المرض)",
 "hydrophilic": "أليف للماء, محب للماء (لديه ألفة قوية للماء؛ يميل للذوبان في الماء أو الامتزاج به أو التبلل به)",
 "hydrophobia": "كَلَب (بمعنى ضربهُ بالكُلاب أو جعل لها كَلْبًا؛ سَيْر أحمر يُجعَل بين طرفي الأديم إذا خُرِز)\nمثال: كان الكلب ميتا.",
 "hydrophobic": "رُهَابِيّ المَاء (خائف بشكل غير طبيعي من الماء) / كاره للماء, نافر من الماء (يفتقر إلى الألفة مع الماء؛ يميل إلى صد الماء وعدم امتصاصه؛ يميل لعدم الذوبان في الماء أو الاختلاط به)",
 "hydrophobicity": "كراهية الماء, هيدروفوبيا (خاصية كون الشيء طارداً للماء؛ يميل لصد وعدم امتصاص الماء)",
 "hydrophyllum virginianum": "هايدروفيلوم, ورقة الماء الفرجينية (عشب معمر بارز بزهور بيضاء؛ تستخدم أوراقه أحياناً كخضروات صالحة للأكل في جنوب شرق الولايات المتحدة)",
 "hydrophyte": "نبات مائي (نبات ينمو جزئياً أو كلياً في الماء سواء كان متجذراً في الطين، مثل اللوتس، أو عائماً دون تثبيت، مثل ورد النيل)",
 "hydrophytic": "مَائِيُّ النَّبَاتِ (يَنْمُو كُلِّيًّا أَوْ جُزْئِيًّا فِي المَاءِ)",
 "hydrophytic plant": "نبات مائي (نبات ينمو جزئياً أو كلياً في الماء سواء كان متجذراً في الطين، مثل اللوتس، أو عائماً دون تثبيت، مثل ورد النيل)",
 "hydroplane": "قارب مجنح, قارب محلق (زورق سريع مجهز بهياكل تشبه الأجنحة ترفعه بحيث ينزلق فوق الماء بسرعات عالية) / طائرة مائية (طائرة يمكنها الهبوط أو الإقلاع من الماء)\nمثال: يضم المتحف نسخة طبق الأصل من القارب المجنح النفاث الذي حطم الرقم القياسي",
 "hydroplane racing": "سباق الزوارق السريعة (السباق في زوارق بمحركات عالية السرعة)",
 "hydroponic": "استزراعي مائي, مائي الزراعة (مكون من أو متعلق بتربية الأحياء المائية)\nمثال: طرق الاستزراع المائي",
 "hydroponics": "زراعة مائية (تقنية زراعة النباتات (بدون تربة) في ماء يحتوي على مغذيات مذابة)",
 "hydropower industry": "صناعة الطاقة الكهرومائية (مجموع الصناعات المشاركة في إنتاج الكهرباء والطاقة المستغلة من المياه المتساقطة والجارية)",
 "hydrops": "استسقاء, وذمة (تورم ناتج عن تراكم مفرط للسوائل المائية في الخلايا أو الأنسجة أو التجاويف المصلية)",
 "hydrosol": "صل مائي (صل (غرواني) يكون فيه الطور المستمر هو الماء)",
 "hydrosphere": "غلاف مائي (الطبقة المائية لسطح الأرض؛ وتشمل بخار الماء)",
 "hydrostatic": "سكوني مائي, هيدروستاتيكي (متعلق بالسوائل في حالة السكون أو الضغوط التي تمارسها أو تنقلها)\nمثال: ضغط هيدروستاتيكي",
 "hydrostatic head": "ضاغط هيدروستاتيكي (الضغط عند نقطة معينة في سائل مقاساً بدلالة الارتفاع الرأسي لعمود من السائل اللازم لإنتاج نفس الضغط)",
 "hydrostaticity": "هيدروستاتيكية (حالة التعلق بالسوائل، خاصة بالضغط الذي تمارسه أو تنقله)\nمثال: تختلف بنية الطور عالي الضغط تماماً، اعتماداً على هيدروستاتيكية الضغط المطبق",
 "hydrostatics": "علم توازن الموائع, هيدروستاتيكا (دراسة الخصائص الميكانيكية للسوائل غير المتحركة)",
 "hydrotherapy": "علاج مائي (الاستخدام الداخلي والخارجي للماء في علاج المرض)",
 "hydrothorax": "موه الصدر (تراكم السوائل في التجويف الجنبي (الفراغ بين الرئتين وجدران الصدر) ناتج غالباً عن مرض في القلب أو الكلى)",
 "hydrous": "مائي, مميه (يحتوي على ماء متحد (خاصة ماء التبلور كما في الهيدرات))",
 "hydroxide": "هيدروكسيد (مركب كيميائي يحتوي على مجموعة الهيدروكسيل) / أكسيد مائي, هيدروكسيد (مركب من أكسيد مع ماء)",
 "hydroxide ion": "أَيُون الهِيدْرُوكْسِيد",
 "hydroxy": "هيدروكسيلي (كونه أو محتوياً على مجموعة هيدروكسيل)",
 "hydroxy acid": "حمض هيدروكسيلي (أي حمض يحتوي على مجموعات هيدروكسيل بالإضافة إلى مجموعة الهيدروكسيل في الحمض نفسه)",
 "hydroxy amino acid": "حمض هيدروكسي أميني (أي حمض أميني يحتوي على مجموعة هيدروكسي)",
 "hydroxy-amino acid": "حمض هيدروكسي أميني (أي حمض أميني يحتوي على مجموعة هيدروكسي)",
 "hydroxyacetic acid": "حمض الجليكوليك (مركب بلوري شفاف يوجد في قصب السكر والبنجر والعنب غير الناضج)",
 "hydroxybenzene": "حمض الكربوليك, فينول (مشتق حمضي بلوري أبيض سام للبنزين قابل للذوبان؛ يستخدم في التصنيع وكمطهر ومعقم)",
 "hydroxybenzoic acid": "حمض هيدروكسي بنزويك (مشتق بلوري لحمض البنزويك)",
 "hydroxybutyric acid": "حمض هيدروكسي بيوتيريك (مشتق هيدروكسي لحمض الزبدة)",
 "hydroxychloroquine": "بلاكوينيل, هيدروكسي كلوروكوين (دواء مضاد للالتهاب (الاسم التجاري بلاكوينيل) يستخدم في علاج التهاب المفاصل الروماتويدي والملاريا والذئبة الحمامية)",
 "hydroxyl": "شق هيدروكسيل, مجموعة هيدروكسيل ((شَقَّ) الفَرَسُ ونحوُهُ يَشِقَّ شَقَقًا: مال في جَرْيِهِ إِلى جانب؛ فهو أشَقُّ، وهي شَقَّاءُ)\nمثال: اكشف عن الشق العلوي من الجسم.",
 "hydroxyl group": "شق هيدروكسيل, مجموعة هيدروكسيل ((شَقَّ) الفَرَسُ ونحوُهُ يَشِقَّ شَقَقًا: مال في جَرْيِهِ إِلى جانب؛ فهو أشَقُّ، وهي شَقَّاءُ)\nمثال: اكشف عن الشق العلوي من الجسم.",
 "hydroxyl ion": "أَيُون الهِيدْرُوكْسِيد",
 "hydroxyl radical": "شق هيدروكسيل, مجموعة هيدروكسيل ((شَقَّ) الفَرَسُ ونحوُهُ يَشِقَّ شَقَقًا: مال في جَرْيِهِ إِلى جانب؛ فهو أشَقُّ، وهي شَقَّاءُ)\nمثال: اكشف عن الشق العلوي من الجسم.",
 "hydroxymethyl": "هيدروكسي ميثيل (ميثيل يحل فيه الهيدروكسيد محل ذرات الهيدروجين)",
 "hydroxynervonic acid": "حمض الهيدروكسينيرفونيك (مشتق من حمض النيرفونيك)\nمثال: حمض الهيدروكسينيرفونيك هو مكون مهم لبعض السيربوزيدات",
 "hydroxyproline": "هيدروكسي برولين (حمض أميني بلوري يتم الحصول عليه من الجيلاتين أو الكولاجين)",
 "hydroxytetracycline": "أوكسي تتراسيكلين, تيراميسين (مضاد حيوي بلوري أصفر (العلامة التجارية تيراميسين) يتم الحصول عليه من شعيات التربة؛ يستخدم لعلاج الالتهابات البكتيرية والريكتسية المختلفة)",
 "hydroxyzine": "أتاراكس, فيستاريل (دواء (الأسماء التجارية أتاراكس وفيستاريل) يستخدم كمهدئ لعلاج القلق ودوار الحركة)",
 "hydroxyzine hydrochloride": "أتاراكس, فيستاريل (دواء (الأسماء التجارية أتاراكس وفيستاريل) يستخدم كمهدئ لعلاج القلق ودوار الحركة)",
 "hydrozoan": "أبابيات, هيدريات (جوفمعويات استعمارية تكون فيها مرحلة السليلة سائدة)",
 "hyemoschus aquaticus": "طرغول مائي (أكبر أنواع الطرغول؛ يعيش في المناطق المستنقعية بغرب أفريقيا)",
 "hyena": "ضَبُع, ضِبْعَان",
 "hyena dog": "كلب الصيد الأفريقي, كلب بري أفريقي (ثديي قوي يشبه الكلب من جنوب وشرق أفريقيا يصطاد في قطعان كبيرة؛ نادر الآن في المناطق المستوطنة)",
 "hygiene": "عِلْم الصِّحَّة, عِلْم حِفْظ الصِّحَّة (أَدْرَكَ حقيقة الشيء) / نَظَافَة, حِفْظ الصِّحَّة\nمثال: أدرس علم النفس.",
 "hygienic": "صِحِّيّ, وِقَائِيّ (يميل إلى تعزيز الصحة أو الحفاظ عليها)",
 "hygienical": "صِحِّيّ, وِقَائِيّ (يميل إلى تعزيز الصحة أو الحفاظ عليها)",
 "hygienically": "بطريقة صحية, صحياً (بطريقة صحية ونظيفة)\nمثال: يجب العناية بالجسم صحياً",
 "hygienics": "علم الصحة العامة, نظافة (العلم المعني بالوقاية من المرض والحفاظ على الصحة)",
 "hygienist": "أخصائي صحة عامة (أخصائي طبي في علم الصحة)",
 "hygrocybe acutoconica": "قبعة شمعية مخروطية (فطر له قبعة مخروطية حادة وسيقان جافة)",
 "hygrodeik": "هيجروديك (مقياس رطوبة ببصلة رطبة وجافة)",
 "hygrometer": "جَهَاز قِيَاس الرُطُوبَة",
 "hygrophorus borealis": "هيجروفوروس شمالي (فطر بقبعة محدبة بيضاء وخياشيم بيضاء مقوسة وساق يستدق نحو القاعدة)",
 "hygrophorus caeruleus": "هيجروفوروس أزرق (فطر بقبعة محدبة عريضة بلون كريمي مع مسحة زرقاء على الحافة؛ خياشيم شمعية خضراء مزرقة إلى رمادية زرقاء؛ ساق قصير يستدق فجأة عند القاعدة)",
 "hygrophorus inocybiformis": "هيجروفوروس إينوسيبيفورميس (فطر بقبعة حرشفية باهتة وحراشف بنية رمادية على الخلفية البيضاء للساق وخياشيم شمعية بيضاء رمادية)",
 "hygrophorus kauffmanii": "هيجروفوروس كوفمان (فطر بقبعة لزجة قليلاً؛ القبعة والخياشيم بنية محمرة والساق رمادي)",
 "hygrophorus marzuolus": "هيجروفوروس مارزولوس (فطر رمادي يوجد كثيراً بالقرب من ضفاف الثلج الذائب)",
 "hygrophorus purpurascens": "هيجروفوروس أرجواني (فطر بقبعة وساق حمراء أرجوانية لزجة؛ يوجد تحت شجرة التنوب والصنوبريات الأخرى)",
 "hygrophorus russula": "هيجروفوروس روسولا (فطر صالح للأكل بقبعة محمرة وخياشيم شاحبة متقاربة وساق جاف؛ يوجد تحت الأخشاب الصلبة)",
 "hygrophorus sordidus": "هيجروفوروس قذر (فطر صالح للأكل بقبعة بيضاء كبيرة وساق جاف وخياشيم بيضاء)",
 "hygrophorus tennesseensis": "هيجروفوروس تينيسي (فطر له قبعة بنية لزجة بحافة بيضاء وخياشيم بيضاء ورائحة البطاطس النيئة)",
 "hygrophorus turundus": "هيجروفوروس توروندوس (فطر صغير بقبعة برتقالية وخياشيم صفراء يوجد في مستنقعات الطحالب)",
 "hygrophyte": "نبات رطوبي (نبات ينمو في بيئة رطبة)",
 "hygrophytic": "رُطُوبِيُّ النَّبَاتِ (يَحْتَاجُ إِلَى وَفْرَةٍ مِنَ الرُّطُوبَةِ)",
 "hygroscope": "هيجروسكوب (مقياس رطوبة يظهر التغيرات في الرطوبة النسبية للغلاف الجوي)",
 "hygroscopic": "اسْتِرْطَابِيّ (يمتصّ الرطوبة من الهواء)",
 "hygroton": "كلورثاليدون (مدر للبول (الأسماء التجارية هيغروتون وثاليدون) يستخدم للسيطرة على ارتفاع ضغط الدم والحالات التي تسبب الوذمة؛ فعال في خفض ضغط الدم لمنع النوبات القلبية)",
 "hygrotrama foetens": "هيجروتراما نتنة (فطر بني رمادي صغير برائحة كريهة تشبه كرات العث)",
 "hyla arenicolor": "ضفدع الوادي الشجري (ساكن أرضي صغير بشكل رئيسي يبقى على مسافة قفز سهلة من الماء؛ من جنوب غرب الولايات المتحدة وشمال المكسيك)",
 "hyla crucifer": "ضفدع الربيع (علجوم شجري بني صغير له نداء حاد يسمع بالقرب من الأراضي الرطبة في شرق الولايات المتحدة وكندا في أوائل الربيع)",
 "hyla regilla": "علجوم الشجر الباسيفيكي (الضفدع الأكثر سماعاً على ساحل المحيط الهادئ لأمريكا)",
 "hylactophryne augusti": "ضفدع نابح (من جنوب غرب الولايات المتحدة والمكسيك؛ نداءه يشبه نباح الكلب)",
 "hylobates lar": "جيبون (أصغر القردة العليا وأكثرها تكيفاً مع الحياة الشجرية، له أذرع طويلة ولا ذيل له؛ يعيش في جنوب آسيا وجزر الهند الشرقية)",
 "hylobates syndactylus": "سيامانج (جيبون أسود كبير يعيش في سومطرة يتميز بأن إصبعي القدم الثاني والثالث متصلان جزئياً بغشاء)",
 "hylocichla fuscescens": "سمنة فيري (سمنة بنية مصفرة من أمريكا الشمالية تشتهر بتغريدها)",
 "hylocichla guttata": "سمنة الناسك (سمنة من أمريكا الشمالية تشتهر بتغريدها المعقد والجذاب)",
 "hylocichla mustelina": "سمنة الغياض (سمنة كبيرة شائعة في غابات شرق أمريكا؛ تشتهر بتغريدها الشجي)",
 "hylophylax naevioides": "طائر النمل المرقط (نوع من طيور النمل يوجد في هندوراس ونيكاراغوا وكوستاريكا وبنما، وكذلك كولومبيا والإكوادور في شمال غرب أمريكا الجنوبية)",
 "hymen": "غِشَاء اَلْبَكَارَة",
 "hymenaea courbaril": "كورباريل, هيمينيا (شجرة جراد من جزر الهند الغربية لها أوراق ريشية وعناقيد من الزهور البيضاء أو الأرجوانية الكبيرة؛ تنتج خشباً صلباً وقوياً للغاية)",
 "hymenal": "بكاري (من أو متعلق بغشاء البكارة)",
 "hymeneal": "زفافي, عرسي (من أو متعلق بحفل زفاف أو زواج) / أنشودة الزفاف (ترنيمة زفاف)\nمثال: طقوس الزفاف",
 "hymeneals": "زفاف, عقد قران (الحدث الاجتماعي الذي تُجرى فيه مراسم الزواج)",
 "hymenium": "غُشَيّ",
 "hymenopter": "غشائيات الأجنحة (حشرات لها زوجان من الأجنحة الغشائية ومسرأ متخصص للسع أو الثقب)",
 "hymenopteran": "غشائيات الأجنحة (حشرات لها زوجان من الأجنحة الغشائية ومسرأ متخصص للسع أو الثقب)",
 "hymenopteron": "غشائيات الأجنحة (حشرات لها زوجان من الأجنحة الغشائية ومسرأ متخصص للسع أو الثقب)",
 "hymenopterous": "غشائي الأجنحة (مكون من أو متعلق بحشرات رتبة غشائيات الأجنحة)",
 "hymenopterous insect": "غشائيات الأجنحة (حشرات لها زوجان من الأجنحة الغشائية ومسرأ متخصص للسع أو الثقب)",
 "hymenoxys acaulis": "هيمينوكسيس عديم الساق (نبات معمر له أوراق قاعدية معنقدة وسيقان قصيرة خالية من الأوراق تحمل كل منها رأس زهرة صفراء وحيدة؛ سفوح التلال الجافة وسهول غرب وسط أمريكا الشمالية)",
 "hymenoxys grandiflora": "دوار الشمس الألبي, شيخ الجبل (نبات مشعر مبيض بأوراق تشبه الريش وبضعة سيقان قوية تحمل كل منها رأس زهرة صفراء كبيرة وحيدة وجميلة بشكل خاص؛ المناطق الجبلية شمال وسط الولايات المتحدة)",
 "hymie": "نعت مهين لليهودي ((إهانة عرقية) مصطلح مهين لليهودي)",
 "hymn": "تَرْتِيلَة, تَرْنِيمَة",
 "hymnal": "كتاب ترانيم (كتاب أغاني يحتوي على مجموعة من الترانيم)",
 "hymnary": "كتاب ترانيم (كتاب أغاني يحتوي على مجموعة من الترانيم)",
 "hymnbook": "كتاب ترانيم (كتاب أغاني يحتوي على مجموعة من الترانيم)",
 "hymnody": "ترتيل المزامير (فعل غناء المزامير أو التراتيل)",
 "hymnography": "تأليف الترانيم ((موسيقى) فن تأليف الترانيم)",
 "hynerpeton bassetti": "هينربيتون (برمائي أحفوري من العصر الديفوني له أطراف أمامية متطورة؛ وجد في بنسلفانيا)",
 "hyogo": "هْيُوغُو",
 "hyoid": "لامي (من أو يتعلق بالعظم اللامي) / عظم لامي",
 "hyoid bone": "عظم لامي",
 "hyoscine": "سكوبولامين, هيوسين (قلويد له تأثيرات مضادة للكولين يستخدم كمهدئ ولعلاج الغثيان ولتوسيع حدقة العين في الإجراءات العينية)\nمثال: يستخدم السكوبولامين عبر الجلد لعلاج دوار الحركة",
 "hyoscyamine": "هيوسيامين (قلويد بلوري سام (متصاوغ مع الأتروبين ولكنه أكثر فاعلية)؛ يستخدم لعلاج الحركة الزائدة للجهاز الهضمي)",
 "hyoscyamus muticus": "بنج مصري (عشب سام تعتبر أوراقه مصدراً للهيوسيامين)",
 "hyoscyamus niger": "بنج, بنج أسود (عشب سام منتن من العالم القديم له أوراق مشعرة لزجة وأزهار بنية صفراء؛ ينتج الهيوسيامين والسكوبولامين)",
 "hypaethral": "مَكْشُوف لِلسَّمَاء (مفتوح جزئياً أو كلياً على السماء)",
 "hypallage": "قلب إسنادي, مجاز عقلي (عكس العلاقة النحوية لكلمتين)",
 "hypanthium": "أنبوب الكأس, مجن (الهيكل الذي يشبه الكوب أو الحلقة أو الأنبوب للزهرة والذي يحمل السبلات والأسدية والكأس (كما في الوردية))",
 "hype": "تَهْوِيل, دِعَايَة صَاخِبَة (ترويج صارخ أو مثير)",
 "hypentelium nigricans": "ماصة الخنزير (موزعة على نطاق واسع في الجداول الضحلة الصافية الدافئة)",
 "hyper-eutectoid steel": "فولاذ فوق يوتكتودي (فولاذ يحتوي على أكثر من 0.9% كربون)",
 "hyperacidity": "فرط الحموضة (حموضة زائدة)",
 "hyperactive": "مُفْرِط النَّشَاط (أكثر نشاطًا من المعتاد)",
 "hyperactivity": "فرط النشاط (حالة تتميز بالأرق المفرط والحركة الزائدة)",
 "hyperacusia": "احتداد السمع (حدة سمع غير طبيعية بسبب زيادة تهيج الآلية العصبية الحسية)",
 "hyperacusis": "احتداد السمع (حدة سمع غير طبيعية بسبب زيادة تهيج الآلية العصبية الحسية)",
 "hyperadrenalism": "فرط نشاط القشر الكظري, مرض كوشينغ",
 "hyperadrenocorticism": "متلازمة كوشينغ (اضطراب غدي ناتج عن زيادة الكورتيزول)",
 "hyperaemia": "احتقان دموي, فرط الدم (زيادة الدم في عضو أو جزء آخر من الجسم)",
 "hyperaldosteronism": "الألدوستيرونية, فرط الألدوستيرونية (حالة ناتجة عن الإنتاج المفرط للألدوستيرون)",
 "hyperalimentation": "تغذية وريدية كاملة (إعطاء محلول كافٍ غذائياً عبر قسطرة في الوريد الأجوف)",
 "hyperbaric chamber": "غرفة الضغط العالي (حجرة كبيرة يكون فيها ضغط الأكسجين أعلى من الضغط الجوي الطبيعي؛ تستخدم في علاج اضطرابات التنفس أو التسمم بأول أكسيد الكربون)",
 "hyperbaton": "فصل (عكس ترتيب الكلمات الطبيعي)",
 "hyperbetalipoproteinemia": "فرط البروتين الشحمي بيتا (اضطراب وراثي يتميز بمستويات عالية من البروتينات الدهنية بيتا والكوليسترول)",
 "hyperbilirubinemia": "فرط بيليروبين الدم (كميات عالية بشكل غير طبيعي من صبغة الصفراء (البيليروبين) في الدم)",
 "hyperbilirubinemia of the newborn": "يرقان الوليد (اضطراب شائع يرجع عادة إلى عدم نضج الكبد؛ يزول عادة تلقائياً)",
 "hyperbola": "قَطْعٌ زَائِد, هَذْلُول (قطع الشيء : جزه؛ قطع الشيء : فصل بعضه عن بعضه الآخر)\nمثال: قطع زيري العشب.",
 "hyperbole": "مُبَالَغَةٌ (بصيغة المؤنث؛ الزيادة حتى يبلغ أقصى الشيء أو الأمر)\nمثال: توم يحب المبالغة.",
 "hyperbolic": "مُبَالَغٌ فِيه, مُتَضَخِّم (مُضخَّم بما يتجاوز الحقيقة أو المعقول) / زائدي (من أو يتعلق بالقطع الزائد)\nمثال: دوال زائدية",
 "hyperbolic geometry": "هَنْدَسَة زَائِدِيّة (الحدُّ والقياس؛ في الرياضيات: هي العلم الذي يبحث في الأشكال وعلاقاتها من حيث الخطوط والأبعاد والسطوح وغيرها)\nمثال: هو ضليع في علم الهندسة .",
 "hyperbolically": "بشكل مبالغ فيه (بطريقة مبالغ فيها)",
 "hyperbolism": "مبالغة (استخدام المبالغة)",
 "hyperboloid": "مجسم قطع زائد (سطح تربيعي يتولد عن دوران قطع زائد حول محوره الرئيسي)",
 "hyperboloidal": "زَائِدِيّ (ذو شكل القَطْع الزائد المجسَّم)",
 "hypercalcaemia": "فرط كالسيوم الدم (وجود مستويات عالية بشكل غير طبيعي من الكالسيوم في الدم؛ عادة ما يكون نتيجة لامتصاص العظام المفرط في فرط نشاط جارات الدرق أو داء باجيت)",
 "hypercalcemia": "فَرْط كَالْسِيُوم الدَّم, فَرْط كَالْسِيُوم فِي الدَّم",
 "hypercalcinuria": "فرط كالسيوم البول (وجود مستويات عالية بشكل غير طبيعي من الكالسيوم في البول؛ عادة ما يكون نتيجة لامتصاص العظام المفرط في فرط نشاط جارات الدرق أو هشاشة العظام)",
 "hypercalciuria": "فرط كالسيوم البول (وجود مستويات عالية بشكل غير طبيعي من الكالسيوم في البول؛ عادة ما يكون نتيجة لامتصاص العظام المفرط في فرط نشاط جارات الدرق أو هشاشة العظام)",
 "hypercapnia": "فرط ثنائي أكسيد الكربون في الدم",
 "hypercarbia": "فرط كربونات الدم (الحالة الجسدية المتمثلة في وجود مستوى مرتفع بشكل غير طبيعي من ثاني أكسيد الكربون في الدم المتنقل)",
 "hypercatalectic": "زَائِد الوَزْن, مُذَيَّل ((في الشعر) وجود مقطع أو مقاطع إضافية في نهاية بيت كامل الوزن أو في تفعيلة) / بيت زائد التفعيلة الأخيرة ((في العروض) بيت شعر يحتوي على مقطع إضافي أو مقاطع في نهاية التفعيلة الأخيرة)",
 "hypercellularity": "فرط الخلوية (حالة وجود عدد كبير بشكل غير طبيعي من الخلايا)",
 "hypercholesteremia": "فرط كوليسترول الدم (وجود كمية غير طبيعية من الكوليسترول في خلايا وبلازما الدم؛ يرتبط بخطر تصلب الشرايين)",
 "hypercholesterolemia": "فرط كوليسترول الدم (وجود كمية غير طبيعية من الكوليسترول في خلايا وبلازما الدم؛ يرتبط بخطر تصلب الشرايين)",
 "hyperchromic anaemia": "فقر الدم مفرط الصباغ (فقر دم يتميز بزيادة في تركيز هيموغلوبين الكريات)",
 "hyperchromic anemia": "فقر الدم مفرط الصباغ (فقر دم يتميز بزيادة في تركيز هيموغلوبين الكريات)",
 "hypercoaster": "أفعوانية فائقة (أفعوانية ترتفع 200 قدم أو أكثر ويمكنها إطلاق الركاب من 0 إلى 70 ميلاً في الساعة في 4 ثوانٍ بواسطة محركات صممت أصلاً لإطلاق الصواريخ)",
 "hypercritical": "مُبَالِغٌ فِي النَّقْدِ, مُفْرِطُ الانْتِقَادِ (يميل إلى الحكم بقسوة مُفرِطة)",
 "hypercriticism": "نقد مفرط (النقد المفرط أو القاسي بشكل غير عادل)\nمثال: النقد المفرط للجسد يبدو أكثر شيوعاً في كتابات النساء منه في كتابات الرجال",
 "hyperdactyly": "كثرة الأصابع (عيب خلقي يتميز بوجود عدد أكبر من العدد الطبيعي لأصابع اليدين أو القدمين)",
 "hyperemesis": "قيء مفرط (تقيؤ شديد ومفرط)",
 "hyperemesis gravidarum": "قيء حملي مفرط (قيء مفرط أثناء الحمل؛ إذا كان شديدًا يمكن أن يؤدي إلى تلف الدماغ والكبد والكلى)",
 "hyperemia": "احتقان دموي, فرط الدم (زيادة الدم في عضو أو جزء آخر من الجسم)",
 "hyperemic": "احتقاني دموي (يتعلق بفرط دم (احتقان) أو ناتج عنه)",
 "hyperextension": "فرط البسط (تمديد أكبر من الطبيعي)",
 "hyperfine": "فَائِقُ الدِّقَّة (بَالِغُ الدِّقَّةِ أَوِ الرِّقَّةِ فِي القِيَاس)",
 "hyperfocal distance": "مَسَافَة بُؤْرِيَّة مُفْرِطَة, مَسَافَة فَرْط البُؤْرَة (المسافة أمام العدسة التي يتم تركيزها عند اللانهاية والتي تكون بعدها جميع الأشياء محددة وواضحة بشكل جيد)",
 "hyperglycaemia": "فرط سكر الدم (ارتفاع نسبة السكر في الدم بشكل غير طبيعي يرتبط عادة بمرض السكري)",
 "hyperglycemia": "فرط سكر الدم",
 "hyperglyphe perciformis": "سمكة البرميل (سمكة سوداء اللون تعيش في مياه نيو إنجلاند)",
 "hyperhidrosis": "فرط التعرق (تعرق مفرط وغزير)",
 "hypericism": "تسمم بالهيبيريسين (التهاب جلد شديد يصيب الحيوانات الأليفة العاشبة يُعزى إلى التحسس الضوئي من تناول عشبة القديس يوحنا)",
 "hypericum androsaemum": "عشبة القديس يوحنا الشائعة, هيوفاريقون (شجيرة أوراسية نفضية كثيفة ذات زهور صفراء ذهبية وثمار أرجوانية محمرة يصنع منها مرهم مهدئ في إسبانيا)",
 "hypericum ascyron": "عشبة القديس يوحنا الكبيرة (شجيرة معمرة لها زهور صفراء كبيرة على شكل نجمة في نوارات هرمية ضيقة)",
 "hypericum calycinum": "عشبة القديس يوحنا الزاحفة (شجيرة زاحفة دائمة الخضرة ذات زهور صيفية صفراء زاهية على شكل نجمة؛ مفيدة كغطاء أرضي)",
 "hypericum crux andrae": "صليب القديس أندرو (نبات شجيري له زهور صفراء إلى مشمشية بأربع بتلات مرتبة على شكل صليب؛ جنوب شرق الولايات المتحدة: نيويورك إلى تكساس)",
 "hypericum gentianoides": "عشبة البرتقال, عشبة الصنوبر (عشبة حولية سلكية الساق من أمريكا الشمالية ذات أوراق دقيقة تشبه الحراشف وزهور صفراء صغيرة)",
 "hypericum hypericoides": "صليب القديس أندرو المنخفض (نبات شجيري منخفض له زهور صفراء بأربع بتلات مرتبة على شكل صليب؛ برمودا وجنوب شرق الولايات المتحدة إلى جزر الهند الغربية وشرق المكسيك)",
 "hypericum maculatum": "عشبة القديس بطرس (عشبة القديس يوحنا المعمرة الأوروبية؛ من أيرلندا وفرنسا إلى غرب سيبيريا)",
 "hypericum perforatum": "عشبة كلاماث, هيوفاريقون مثقب (نبات معمر أصفر الزهور شائع في الحقول والأماكن المهملة ولكنه يعتبر عشبة ضارة في المراعي)",
 "hypericum prolificum": "عشبة القديس يوحنا الشجيرية (شجيرة صلبة لها أوراق مستطيلة كاملة ونوارات كثيفة من الزهور الصفراء)",
 "hypericum pyramidatum": "عشبة القديس يوحنا الكبيرة (شجيرة معمرة لها زهور صفراء كبيرة على شكل نجمة في نوارات هرمية ضيقة)",
 "hypericum spathulatum": "عشبة القديس يوحنا الشجيرية (شجيرة صلبة لها أوراق مستطيلة كاملة ونوارات كثيفة من الزهور الصفراء)",
 "hypericum tetrapterum": "عشبة القديس بطرس (عشبة القديس يوحنا المعمرة الأوروبية؛ من أيرلندا وفرنسا إلى غرب سيبيريا)",
 "hypericum virginianum": "عشبة القديس يوحنا المستنقعية (عشبة مستنقعات معمرة ذات زهور وردية إلى بنفسجية؛ جنوب شرق الولايات المتحدة)",
 "hyperidrosis": "فرط التعرق (تعرق مفرط وغزير)",
 "hyperintelligence": "ذكاء خارق, ذكاء فائق (ذكاء ملحوظ، عند مستوى أو أعلى من مستوى العبقرية)",
 "hyperkalemia": "فرط بوتاسيوم الدم (مستويات البوتاسيوم في الدم المتداول أعلى من الطبيعي؛ يرتبط بالفشل الكلوي أو أحياناً باستخدام الأدوية المدرة للبول)",
 "hyperkinetic syndrome": "اضطراب فرط الحركة ونقص الانتباه, اضطراب نقص الانتباه (حالة (تغلب عند الأولاد) تتميز باضطرابات سلوكية وصعوبات في التعلم)",
 "hyperlink": "اِرْتِبَاط تَشَعُّبِيّ",
 "hyperlipaemia": "شحمية الدم, فرط شحميات الدم (وجود الدهون الزائدة في الدم)",
 "hyperlipemia": "شحمية الدم, فرط شحميات الدم (وجود الدهون الزائدة في الدم)",
 "hyperlipidaemia": "شحمية الدم, فرط شحميات الدم (وجود الدهون الزائدة في الدم)",
 "hyperlipidemia": "فَرْط شَحْمِيَّات الدَّم",
 "hyperlipoidaemia": "شحمية الدم, فرط شحميات الدم (وجود الدهون الزائدة في الدم)",
 "hyperlipoidemia": "شحمية الدم, فرط شحميات الدم (وجود الدهون الزائدة في الدم)",
 "hyperlipoproteinemia": "فرط بروتينات الدم الشحمية (أي من الاضطرابات المختلفة لاستقلاب البروتين الدهني والكوليسترول والتي تؤدي إلى مستويات عالية من البروتين الدهني والكوليسترول في الدم المتنقل)",
 "hypermarket": "سوق ضخم, هايبر ماركت (سوبر ماركت ضخم (يُبنى عادة في ضواحي المدينة))",
 "hypermastigote": "سوطي مفرط (سوطي تكافلي في أمعاء النمل الأبيض مثلاً)",
 "hypermedia": "وسائط فائقة, وسائط متعددة تفاعلية (نظام وسائط متعددة يتم فيه ربط عناصر المعلومات ذات الصلة ويمكن تقديمها معاً)",
 "hypermedia system": "وسائط فائقة, وسائط متعددة تفاعلية (نظام وسائط متعددة يتم فيه ربط عناصر المعلومات ذات الصلة ويمكن تقديمها معاً)",
 "hypermenorrhea": "غزارة الطمث, نزيف رحمي (حيض غزير أو طويل بشكل غير طبيعي؛ يمكن أن يكون عرضًا لأورام الرحم ويمكن أن يؤدي إلى فقر الدم إذا طال أمده)",
 "hypermetropia": "طول النظر, مد البصر (حالة غير طبيعية تكون فيها الرؤية للأشياء البعيدة أفضل من الأشياء القريبة)",
 "hypermetropic": "مُصَاب بِطُول النَّظَر (ذو قدرة غير طبيعيّة على التركيز على الأشياء البعيدة)",
 "hypermetropy": "طول النظر, مد البصر (حالة غير طبيعية تكون فيها الرؤية للأشياء البعيدة أفضل من الأشياء القريبة)",
 "hypermotility": "فرط الحركة, فرط الحركية (حركة مفرطة؛ خاصة الحركية المفرطة للجهاز الهضمي)",
 "hypernatremia": "فرط صوديوم الدم (كميات مفرطة من الصوديوم في الدم؛ ربما تشير إلى مرض السكري الكاذب)",
 "hypernym": "اسم شامل, لفظ أعم (كلمة أكثر شمولاً وعمومية من كلمة أخرى)",
 "hypernymy": "اشْتِمَال, فَوْقِيَّة دَلَالِيَّة (العلاقة الدلالية لكون الكلمة شاملة أو تابعة لرتبة أو فئة أعلى (مثل: فاكهة شاملة لتفاحة))",
 "hyperon": "هَيْبِرُون (أي باريون ليس نيوكليوناً؛ جسيم غير مستقر ذو كتلة أكبر من النيوترون)",
 "hyperoodon ampullatus": "حوت قاروري الأنف (حوت منقاري يعيش في شمال المحيط الأطلسي ذو جبهة منتفخة)",
 "hyperope": "بعيد النظر (شخص يعاني من طول النظر)",
 "hyperopia": "طول النظر, مد البصر (حالة غير طبيعية تكون فيها الرؤية للأشياء البعيدة أفضل من الأشياء القريبة)",
 "hyperopic": "مُصَاب بِطُول النَّظَر (ذو قدرة غير طبيعيّة على التركيز على الأشياء البعيدة)",
 "hyperparasite": "تطفل فوقي",
 "hyperparathyroidism": "فرط نشاط جارات الدرقية (إفراز مفرط لهرمون الغدة الجار درقية يؤدي إلى مستويات عالية غير طبيعية من الكالسيوم في الدم؛ يمكن أن يؤثر على العديد من أجهزة الجسم (خاصة التسبب في…)",
 "hyperpiesia": "ارتفاع ضغط الدم الأساسي, فرط ضغط الدم الأولي (ارتفاع مستمر ومرضي في ضغط الدم لا يمكن العثور على سبب محدد له)",
 "hyperpiesis": "ارتفاع ضغط الدم الأساسي, فرط ضغط الدم الأولي (ارتفاع مستمر ومرضي في ضغط الدم لا يمكن العثور على سبب محدد له)",
 "hyperpigmentation": "فرط التصبغ (اسمرار غير عادي للجلد)",
 "hyperpituitarism": "فرط نشاط الغدة النخامية (نشاط مفرط للغدة النخامية (خاصة فرط نشاط الفص الأمامي الذي يؤدي إلى إفراز زائد لهرمون النمو))",
 "hyperplasia": "فرط التنسج (زيادة غير طبيعية في عدد الخلايا)",
 "hyperpnea": "زيادة التنفس, فرط التنفس (تنفس نشط (عميق وسريع) يحدث عادة بعد التمرين أو بشكل غير طبيعي مع الحمى أو اضطرابات مختلفة)",
 "hyperpyrexia": "فرط الحمى (حمى شديدة الارتفاع (خاصة عند الأطفال))",
 "hypersecretion": "فرط الإفراز (إفراز مفرط)",
 "hypersensitised": "تَحَسُّسِيّ, مُفْرِط الحَسَاسِيَّة (لديه حساسية أو قابلية مفرطة أو خاصة (تجاه عامل معين))",
 "hypersensitive": "تَحَسُّسِيّ, مُفْرِط الحَسَاسِيَّة (لديه حساسية أو قابلية مفرطة أو خاصة (تجاه عامل معين))",
 "hypersensitivity": "فرط حساسية (حساسية مفرطة) / فرط الحساسية (حساسية مرضية)",
 "hypersensitivity reaction": "تفاعل فرط الحساسية (رد فعل غير مناسب ومفرط تجاه مادة مسببة للحساسية (مثل حبوب اللقاح أو الغبار أو شعر الحيوانات أو أطعمة معينة)؛ تتراوح الشدة من حساسية خفيفة إلى ردود…)",
 "hypersensitized": "تَحَسُّسِيّ, مُفْرِط الحَسَاسِيَّة (لديه حساسية أو قابلية مفرطة أو خاصة (تجاه عامل معين))",
 "hypersomnia": "فرط النوم (عدم القدرة على البقاء مستيقظاً)",
 "hypersplenism": "فرط نشاط الطحال (تضخم الطحال وانخفاض في نوع واحد أو أكثر من خلايا الدم؛ يرتبط بالعديد من الاضطرابات)",
 "hyperstat": "ديازوكسيد (موسع للأوعية الدموية (الاسم التجاري هايبرستات) يستخدم لعلاج ارتفاع ضغط الدم الشديد)",
 "hypertensin": "أنجيوتنسين, أنجيوتونين (أي من عدة مواد مقبضة للأوعية تسبب تضيق الأوعية الدموية)",
 "hypertension": "ارتفاع ضغط الدم, فرط ضغط الدم (اضطراب شائع يظل فيه ضغط الدم مرتفعاً بشكل غير طبيعي (قراءة 140/90 ملم زئبقي أو أكثر))",
 "hypertensive": "مصاب بارتفاع ضغط الدم (لديه ضغط دم مرتفع بشكل غير طبيعي) / مُصاب بِارْتِفاع ضَغْط الدَّم (شخص لديه ضغط دم مرتفع بشكل غير طبيعي)",
 "hypertext": "هَايْبَرْتِكْسْت",
 "hypertext mark-up language": "لغة ترميز النص التشعبي (هِيَ مجموعة من الأصوات التي يصدرها الإنسان على شكل كلمات منظمة بقواعد، ليتواصل به الناس وينقلون به الافكار والمعاني، اللسان؛ يقصد بها أحيانا اللهجة)\nمثال: الأمازيغية لغة.",
 "hypertext markup language": "لغة ترميز النص التشعبي (هِيَ مجموعة من الأصوات التي يصدرها الإنسان على شكل كلمات منظمة بقواعد، ليتواصل به الناس وينقلون به الافكار والمعاني، اللسان؛ يقصد بها أحيانا اللهجة)\nمثال: الأمازيغية لغة.",
 "hypertext system": "نظام النص التشعبي (نظام إدارة قواعد بيانات يسمح بمعالجة سلاسل النصوص ('الكائنات') كشبكة معقدة من العقد المرتبطة ببعضها البعض بطريقة اعتباطية)",
 "hypertext transfer protocol": "بْرُوتُوكُول نَقْل النَّصّ التَّشَعُّبِيّ",
 "hyperthermal": "مفرط الحرارة (من أو يتعلق بفرط حرارة الجسم أو مصاب به)",
 "hyperthermia": "فرط الحرارة (درجة حرارة الجسم عالية بشكل غير طبيعي؛ يتم تحفيزها أحياناً (كما في علاج بعض أشكال السرطان))",
 "hyperthermy": "فرط الحرارة (درجة حرارة الجسم عالية بشكل غير طبيعي؛ يتم تحفيزها أحياناً (كما في علاج بعض أشكال السرطان))",
 "hyperthyroidism": "الانسمام الدرقي, فرط نشاط الغدة الدرقية (غدة درقية مفرطة النشاط؛ إنتاج مفرط مرضياً لهرمونات الغدة الدرقية أو الحالة الناتجة عن الإنتاج المفرط لهرمونات الغدة الدرقية)",
 "hypertonia": "فرط التوتر, فرط التوترية ((للنسيج العضلي) حالة فرط التوتر)",
 "hypertonic": "عالي الضغط الأسموزي, مفرط التوتر ((عن محلول) له ضغط أسموزي أعلى من محلول المقارنة) / شديد التوتر, فرط التوتر ((للأنسجة الحية) في حالة من التوتر العالي غير الطبيعي)\nمثال: أنسجة عضلية شديدة التوتر",
 "hypertonic solution": "محلول مفرط التوتر (أي محلول بتركيز ملحي أعلى من خلايا الجسم الطبيعية بحيث يتم سحب الماء من الخلايا عن طريق التناضح)\nمثال: المحلول مفرط التوتر لديه ضغط اسموزي أعلى من محلول آخر",
 "hypertonicity": "فرط التوتر, فرط التوترية ((للنسيج العضلي) حالة فرط التوتر) / فرط التوترية ((للمحلول) المدى الذي يكون فيه للمحلول ضغط أسموزي أعلى من غيره)",
 "hypertonus": "فرط التوتر, فرط التوترية ((للنسيج العضلي) حالة فرط التوتر)",
 "hypertrophic cardiomyopathy": "اعتلال عضلة القلب التضخمي (اضطراب تكون فيه عضلة القلب قوية جداً لدرجة أنها لا ترتخي بما يكفي لملء القلب بالدم، وبالتالي تنخفض قدرة الضخ)",
 "hypertrophic rosacea": "فيمة الأنف (تضخم الأنف مع توسع الجريبات واحمرار وبروز الأوعية الدموية في الجلد)",
 "hypertrophied": "متضخم ((عن عضو أو جزء من الجسم) متضخم بشكل مفرط نتيجة لزيادة حجم الخلايا المكونة له)\nمثال: ألياف عضلة القلب المتضخمة",
 "hypertrophy": "تضخم (تضخم غير طبيعي لجزء من الجسم أو عضو)",
 "hypervelocity": "سُرْعَة فَائِقَة (سرعة مفرطة)\nمثال: ضربت النيازك الأرض بتأثيرات ذات سرعة فائقة",
 "hyperventilation": "فرط التهوية (زيادة عمق ومعدل التنفس بشكل أكبر مما تتطلبه حاجة الجسم؛ يمكن أن يسبب الدوار ووخز الأصابع وألم الصدر إذا استمر)",
 "hypervitaminosis": "فَرْط الفيتامين",
 "hypervolaemia": "فرط حجم الدم (اضطراب دموي يتمثل في زيادة حجم الدم المتداول)",
 "hypervolemia": "فرط حجم الدم (اضطراب دموي يتمثل في زيادة حجم الدم المتداول)",
 "hypesthesia": "نقص الحس (ضعف الحساسية اللمسية)",
 "hypethral": "مَكْشُوف لِلسَّمَاء (مفتوح جزئياً أو كلياً على السماء)",
 "hypha": "خيط فطري, هيفا (أي من الخيوط الشبيهة بالخيط التي تشكل الغزل الفطري للفطريات)",
 "hyphantria cunea": "دودة الويب الخريفية (عثة يرقاتها هي ديدان الويب الخريفية) / دودة الويب الخريفية",
 "hyphema": "تحدمية (نزيف في الغرفة الأمامية للعين)",
 "hyphen": "شَحْطَة, شَرْطَة",
 "hyphenation": "ربط بواصلة, وصل (ربط المقاطع والكلمات بواصلات) / فصل الكلمة, وصل بفواصل (تقسيم الكلمة خاصة في نهاية السطر على الصفحة)",
 "hypnagogic": "جَالِب لِلنَّوْم, مُنَوِّم (يُحدِث النعاس ويجلب النوم)",
 "hypnagogue": "جالب للنوم, منوم (عامل يحفز النعاس أو النوم)",
 "hypnoanalysis": "تحليل بالتنويم المغناطيسي (استخدام التنويم المغناطيسي بالتزامن مع التحليل النفسي)",
 "hypnogenesis": "استحثاث النوم, تنويم (استحثاث النوم أو التنويم المغناطيسي)",
 "hypnogogic": "جَالِب لِلنَّوْم, مُنَوِّم (يُحدِث النعاس ويجلب النوم)",
 "hypnoid": "تَنْوِيمِيّ, شِبْه نَوْمِيّ (متعلق بحالة النوم أو التنويم المغناطيسي)",
 "hypnopedia": "تعلم أثناء النوم (التدريس أثناء النوم (مثل استخدام التسجيلات لتعليم لغة أجنبية لشخص نائم))",
 "hypnophobia": "رهاب النوم (خوف مرضي من النوم)",
 "hypnosis": "تَنْوِيم مَغْنَاطِيسِيّ",
 "hypnotherapy": "علاج بالتنويم المغناطيسي (استخدام التنويم المغناطيسي في العلاج النفسي)",
 "hypnotic": "مُنَوِّم",
 "hypnotic trance": "غشية تنويمية (غشية ناتجة عن التنويم المغناطيسي؛ حيث يقبل الشخص اقتراحات المنوم المغناطيسي)",
 "hypnotically": "بالتنويم المغناطيسي, مغناطيسياً (بواسطة التنويم المغناطيسي)",
 "hypnotised": "مَسْلُوبُ اللُّبّ, مَشْدُوه (ثابت الانتباه كأنّه تحت تأثير سحر)",
 "hypnotiser": "منوم إيحائي, منوم مغناطيسي (شخص يحفز التنويم المغناطيسي)",
 "hypnotism": "تنويم إيحائي, تنويم مغناطيسي (فعل إحداث التنويم المغناطيسي)",
 "hypnotist": "منوم إيحائي, منوم مغناطيسي (شخص يحفز التنويم المغناطيسي)",
 "hypnotized": "مَسْلُوبُ اللُّبّ, مَشْدُوه (ثابت الانتباه كأنّه تحت تأثير سحر)",
 "hypnotizer": "منوم إيحائي, منوم مغناطيسي (شخص يحفز التنويم المغناطيسي)",
 "hypo": "حقنة تحت الجلد (حقنة مكبس مزودة بإبرة تحت الجلد لإعطاء الحقن) / ثيوكبريتات الصوديوم, هيبو (مركب يستخدم كعامل تثبيت في التحميض الفوتوغرافي)",
 "hypo-eutectoid steel": "فولاذ تحت يوتكتودي (فولاذ يحتوي على أقل من 0.9% كربون)",
 "hypoactive": "قَلِيل النَّشَاط (أقلّ نشاطًا من المعتاد بشكل غير طبيعيّ)",
 "hypoadrenalism": "قصور الكظر, مرض أديسون (اضطراب غدي ناتج عن فشل وظيفة قشرة الغدة الكظرية ويتميز بفقر الدم والإنهاك مع جلد بني اللون)",
 "hypoadrenocorticism": "قصور الكظر, مرض أديسون (اضطراب غدي ناتج عن فشل وظيفة قشرة الغدة الكظرية ويتميز بفقر الدم والإنهاك مع جلد بني اللون)",
 "hypoallergenic": "مِن غَيْر المُرَجَّح أَن يُسَبِّب حَسَاسِيَّة (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "hypobasidium": "دعامة سفلية (خلية خاصة تشكل قاعدة الدعامة في فطريات مختلفة خاصة من رتبة التريميلات)",
 "hypobetalipoproteinemia": "نقص بيتا ليبوبروتين الدم (اضطراب وراثي يتميز بمستويات منخفضة من بروتينات بيتا الدهنية والدهون والكوليسترول)",
 "hypoblast": "أديم باطن, الأرومة الباطنة (الطبقة المنتشة الداخلية التي تتطور لتشكل بطانة الجهاز الهضمي والتنفسي)",
 "hypocalcaemia": "نقص كالسيوم الدم (مستوى منخفض بشكل غير طبيعي للكالسيوم في الدم؛ يرتبط بقصور جارات الدرق أو خلل في الكلى أو نقص فيتامين د)",
 "hypocalcemia": "نقص كالسيوم الدم (مستوى منخفض بشكل غير طبيعي للكالسيوم في الدم؛ يرتبط بقصور جارات الدرق أو خلل في الكلى أو نقص فيتامين د)",
 "hypocapnia": "نقص كربونات الدم (حالة يكون فيها مستوى ثاني أكسيد الكربون في الدم أقل من الطبيعي؛ يمكن أن تنتج عن التنفس العميق أو السريع)",
 "hypocellularity": "نقص الخلوية (حالة وجود عدد قليل بشكل غير طبيعي من الخلايا)",
 "hypochaeris radicata": "أذن القط, هندباء خنزيرية (عشب ضار أوروبي مستوطن على نطاق واسع في أمريكا الشمالية له رؤوس زهرية صفراء وأوراق تشبه أذن القط)",
 "hypochlorite": "هيبوكلوريت (أي ملح أو إستر لحمض الهيبوكلوروز)",
 "hypochlorous acid": "حمض الهيبوكلوروز (حمض ضعيف غير مستقر يعرف فقط في المحلول وفي أملاحه؛ يستخدم كعامل تبييض ومؤكسد)",
 "hypochondria": "وَسَاوِس مرضية",
 "hypochondriac": "مُتَوَهِّم المَرَض, وَسْوَاسِيّ صِحِّيًّا (يعاني من توهم المرض) / مَرَضِيّ الوَهْم, مُتَوَهِّم المَرَض (مريض بأعراض وأمراض وهمية)",
 "hypochondriacal": "مُتَوَهِّم المَرَض, وَسْوَاسِيّ صِحِّيًّا (يعاني من توهم المرض)",
 "hypochondriasis": "توهم المرض, هيبوكوندريا (قلق مزمن وغير طبيعي بشأن أعراض وأمراض وهمية)",
 "hypochondrium": "المراق, منطقة تحت الضلع (المنطقة العليا من البطن أسفل الأضلاع السفلية مباشرة على جانبي الشرسوف)",
 "hypochromic anaemia": "فقر الدم نقص الصباغ (فقر دم يتميز بانخفاض في تركيز هيموغلوبين الكريات)",
 "hypochromic anemia": "فقر الدم نقص الصباغ (فقر دم يتميز بانخفاض في تركيز هيموغلوبين الكريات)",
 "hypocorism": "اسم تدليل (اسم للتودد (خاصة الذي يستخدم لاحقة تصغير))",
 "hypocrisy": "رِيَاء, نِفَاق",
 "hypocrite": "مُرَاءٍ, مُنَافِق",
 "hypocrites": "سورة المنافقون",
 "hypocritical": "مُرَائِي, مُنَافِق (يَدَّعِي مَشَاعِرَ أَوْ فَضَائِلَ لَا يَمْلِكُهَا)",
 "hypocritically": "بِرِيَاء, بِنِفَاق (بطريقة منافقة)\nمثال: تصرف بنفاق بالصلاة بتقوى عندما كان الناس يشاهدونه",
 "hypocycloid": "دويري داخلي (خط يتولد عن نقطة على دائرة تتدحرج داخل دائرة أخرى)",
 "hypodermal": "تحت أدمي (متعلق بمنطقة تحت الأدمة)",
 "hypodermic": "تحت الجلد (متعلق بالمنطقة الواقعة تحت البشرة أو يقع فيها) / حقنة تحت الجلد (حقنة مكبس مزودة بإبرة تحت الجلد لإعطاء الحقن)\nمثال: إبرة تحت الجلد",
 "hypodermic needle": "إبرة تحت الجلد, إبرة حقن (إبرة مجوفة)",
 "hypodermic syringe": "حقنة تحت الجلد (حقنة مكبس مزودة بإبرة تحت الجلد لإعطاء الحقن)",
 "hypodermis": "تحت الأدمة (طبقة من الخلايا تفرز الجليد الكيتيني في المفصليات مثلاً)",
 "hypoesthesia": "نقص الحس (ضعف الحساسية اللمسية)",
 "hypogammaglobulinemia": "نقص غاما غلوبولين الدم (انخفاض غير طبيعي في تركيز غاما غلوبولين في الدم وزيادة خطر الإصابة بالعدوى)",
 "hypogastric artery": "شريان حرقفي باطن, شريان خثلي (الفرع الداخلي للشريان الحرقفي المشترك على جانبي الجسم؛ ينقسم إلى عدة فروع تغذي مناطق الحوض والأرداف بالدم)",
 "hypogastric plexus": "ضفيرة خثلية (ضفيرة من الأعصاب تخدم أحشاء الحوض)",
 "hypogastric vein": "وريد حرقفي باطن (وريد يتحد مع الوريد الحرقفي الظاهر لتكوين الوريد الحرقفي المشترك)",
 "hypoglossal": "عصب تحت اللسان, عصب قحفي ثاني عشر (يغذي العضلات الداخلية لللسان وعضلات اللسان الأخرى)",
 "hypoglossal nerve": "عصب تحت اللسان, عصب قحفي ثاني عشر (يغذي العضلات الداخلية لللسان وعضلات اللسان الأخرى)",
 "hypoglycaemia": "نقص سكر الدم (انخفاض نسبة السكر في الدم بشكل غير طبيعي ناتج عادة عن الأنسولين المفرط أو سوء التغذية)",
 "hypoglycaemic": "متعلق بنقص سكر الدم, ناقص السكر (متعلق بنقص السكر في الدم)\nمثال: عوامل خفض السكر",
 "hypoglycaemic agent": "خافض السكر, عامل خافض لسكر الدم (أي من العوامل المختلفة التي تقلل مستوى الجلوكوز في الدم وتستخدم في علاج داء السكري)",
 "hypoglycemia": "نقص سكر الدم (انخفاض نسبة السكر في الدم بشكل غير طبيعي ناتج عادة عن الأنسولين المفرط أو سوء التغذية)",
 "hypoglycemic": "متعلق بنقص سكر الدم, ناقص السكر (متعلق بنقص السكر في الدم)\nمثال: عوامل خفض السكر",
 "hypoglycemic agent": "خافض السكر, عامل خافض لسكر الدم (أي من العوامل المختلفة التي تقلل مستوى الجلوكوز في الدم وتستخدم في علاج داء السكري)",
 "hypognathous": "بارز الفك (لديه فك سفلي بارز)",
 "hypogonadism": "قصور الغدد التناسلية (عجز الغدد التناسلية (خاصة عند الذكور مع انخفاض هرمون التستوستيرون))",
 "hypokalemia": "نقص بوتاسيوم الدم (مستوى منخفض بشكل غير طبيعي للبوتاسيوم في الدم المتداول مما يؤدي إلى الضعف وتشوهات القلب؛ يرتبط بأورام الغدة الكظرية أو الجوع أو تناول مدرات البول)",
 "hypolipoproteinemia": "نقص بروتينات الدم الشحمية (أي من الاضطرابات المختلفة لاستقلاب البروتين الدهني والكوليسترول والتي تؤدي إلى مستويات منخفضة من البروتين الدهني والكوليسترول في الدم المتنقل)",
 "hyponatremia": "نقص صوديوم الدم (مستوى منخفض بشكل غير طبيعي للصوديوم في الدم؛ يرتبط بالجفاف)",
 "hyponitrous acid": "حمض الهيبونيتروز (أصبح حامضًا، تغير الطعم إلى الحموضة؛ ارتفعت نسبة الحموضة في شيء ما، كما في الطعام أو السوائل)\nمثال: رمى ياني الحمض على وجه سكورة.",
 "hyponychium": "تَحْت ظُفْر (أَقَلَّ)\nمثال: أنا تحت الشجرة.",
 "hyponym": "اسم مندرج, لفظ أخص (كلمة أكثر تحديداً وخصوصية من كلمة أخرى)",
 "hyponymy": "انْدِرَاج, تَبَعِيَّة دَلَالِيَّة (العلاقة الدلالية لكون الكلمة فرعية أو تابعة لرتبة أو فئة أدنى (مثل: تفاحة مندرجة تحت فاكهة))",
 "hypoparathyroidism": "قصور الدريقية, قصور جارات الدرقية (إفراز غير كافٍ لهرمون الغدة الجار درقية يؤدي إلى مستويات منخفضة غير طبيعية من الكالسيوم في الدم)",
 "hypophosphoric acid": "حمض الهيبوفوسفوريك (أصبح حامضًا، تغير الطعم إلى الحموضة؛ ارتفعت نسبة الحموضة في شيء ما، كما في الطعام أو السوائل)\nمثال: رمى ياني الحمض على وجه سكورة.",
 "hypophosphorous acid": "حمض الهيبوفوسفوروز (أصبح حامضًا، تغير الطعم إلى الحموضة؛ ارتفعت نسبة الحموضة في شيء ما، كما في الطعام أو السوائل)\nمثال: رمى ياني الحمض على وجه سكورة.",
 "hypophyseal": "نخامي (من أو يتعلق بالغدة النخامية)",
 "hypophyseal stalk": "سُوَيْقَة نُخَامِيَّة (السويقة قمعية الشكل التي تصل الغدة النخامية بمنطقة تحت المهاد (الوطاء))",
 "hypophysectomised": "مستأصل النخامية (أزيلت غدته النخامية بالجراحة)\nمثال: شراغف مستأصلة النخامية",
 "hypophysectomized": "مستأصل النخامية (أزيلت غدته النخامية بالجراحة)\nمثال: شراغف مستأصلة النخامية",
 "hypophysectomy": "استئصال الغدة النخامية (إزالة جراحية للغدة النخامية)",
 "hypophysial": "نخامي (من أو يتعلق بالغدة النخامية)",
 "hypophysial dwarf": "قزم نخامي (قزم حالته ناتجة عن نقص هرمونات النمو، وليس عن عوامل وراثية (كما في حالة القزم الودروي))",
 "hypophysis": "غدة نخامية (الغدة الرئيسية لجهاز الغدد الصماء؛ تقع في قاعدة الدماغ)",
 "hypopigmentation": "نقص التصبغ (نقص غير عادي في لون الجلد)",
 "hypoplasia": "نقص التنسج (تخلف عضو ما بسبب انخفاض في عدد الخلايا)",
 "hypoplastic anaemia": "فقر الدم الناقص التنسج (فقر دم ناتج عن عدم كفاية وظائف نخاع العظم؛ يمكن أن يتطور إلى فقر دم لاتنسجي)",
 "hypoplastic anemia": "فقر الدم الناقص التنسج (فقر دم ناتج عن عدم كفاية وظائف نخاع العظم؛ يمكن أن يتطور إلى فقر دم لاتنسجي)",
 "hypoplastic dwarf": "قزم أولي (قزم ودروي ناتج صغر حجمه عن عيب وراثي؛ أجزاء الجسم والنمو العقلي والجنسي طبيعية)",
 "hypopnea": "تنفس ضحل, ضعف التنفس (تنفس بطيء أو ضحل)",
 "hypoproteinemia": "نقص بروتين الدم (مستوى منخفض بشكل غير طبيعي للبروتين في الدم؛ يمكن أن يشير إلى نظام غذائي غير كافٍ أو اضطرابات معوية أو كلوية)",
 "hyposmia": "نقص الشم (انخفاض الحساسية للروائح)",
 "hypospadias": "إحليل تحتي (حالة غير طبيعية عند الذكور يفتح فيها مجرى البول على السطح السفلي للقضيب)",
 "hypostasis": "أُقْنُوم",
 "hypostatic union": "اتحاد أقنومي (مصطلح تقني في اللاهوت المسيحي لوصف اتحاد الطبيعتين البشرية والإلهية للمسيح في أقنوم واحد أو وجود فردي)",
 "hypostatisation": "تجسيم, تشخيص (اعتبار شيء مجرد كأنه شيء مادي)",
 "hypostatization": "تجسيم, تشخيص (اعتبار شيء مجرد كأنه شيء مادي)",
 "hypotension": "انخفاض ضغط الدم, هبوط الضغط (انخفاض غير طبيعي في ضغط الدم)",
 "hypotensive": "مصاب بانخفاض ضغط الدم (لديه ضغط دم منخفض بشكل غير طبيعي) / مُصاب بِانْخِفاض ضَغْط الدَّم (شخص لديه ضغط دم منخفض بشكل غير طبيعي)",
 "hypotenuse": "وَتَر, ضِلْع مُتَوَتِّر (خيط شديد أو سلك يربط بين طرفي القوس ليستخدم في إطلاق السهام. سمي كذلك لأنه واحد، مشتق من الوِتْر وهو الفرد؛ خيط شديد أو سلك يربط على الآلة الموسيقية لإطلاق الصوت. سمي كذلك تشبيها له بوَتَر القَوْس)",
 "hypothalamic": "تحت مهادي, وطائي (من أو يتعلق بالوطاء (تحت المهاد))",
 "hypothalamic releasing factor": "عامل مطلق, هرمون مطلق (أي من عدة هرمونات تنتج في الهايبوتلاموس وتحمل إلى الغدة النخامية الأمامية حيث تحفز إطلاق هرمونات الغدة النخامية الأمامية)",
 "hypothalamic releasing hormone": "عامل مطلق, هرمون مطلق (أي من عدة هرمونات تنتج في الهايبوتلاموس وتحمل إلى الغدة النخامية الأمامية حيث تحفز إطلاق هرمونات الغدة النخامية الأمامية)",
 "hypothalamically": "تحت المهاد (فيما يتعلق بمنطقة تحت المهاد (الهيبوثلامس))\nمثال: إفرازات مسيطر عليها من تحت المهاد",
 "hypothalamus": "تَحْت اَلْمِهَاد, وِطَاء (أَقَلَّ)\nمثال: أنا تحت الشجرة.",
 "hypothermia": "انخفاض حرارة الجسم",
 "hypothermic": "منخفض الحرارة (من أو يتعلق بانخفاض حرارة الجسم أو مصاب به)",
 "hypothesis": "فَرْضِيَّة (مؤنث الفَرَضِيّ، وهو المنسوب إلى الفَرَض؛ الفَرَض، ما يُفْتَرَض من الأمور، خلاف الحَقِيقَة. كلمة حديثة)\nمثال: الحقائق تؤكد هذه الفرضية.",
 "hypothetic": "اِفْتِرَاضِيّ, تَخْمِينِيّ (مبنيّ أساساً على التخمين بدلاً من الأدلة الكافية)",
 "hypothetical": "اِفْتِرَاضِيّ",
 "hypothetical creature": "كائن افتراضي (مخلوق لم يتم رصده ولكن يُفترض وجوده)",
 "hypothetical imperative": "أَمْر شَرْطِيّ (مبدأ ينص على الإجراء المطلوب لتحقيق هدف منشود)",
 "hypothetically": "افتراضياً (عن طريق الفرضية)",
 "hypothrombinemia": "نقص البروثرومبين (مستوى منخفض من البروثرومبين في الدم المتداول)",
 "hypothyroidism": "قُصُور اَلدَّرَقِيَّة",
 "hypotonia": "ارتخاء, نقص التوتر ((للنسيج العضلي) حالة نقص التوتر)",
 "hypotonic": "منخفض التوتر, منخفض الضغط الأسموزي ((عن محلول) له ضغط أسموزي أقل من محلول المقارنة) / منخفض التوتر, ناقص التوتر ((للأنسجة الحية) تفتقر إلى النغمة أو التوتر الطبيعي)",
 "hypotonicity": "ارتخاء, نقص التوتر ((للنسيج العضلي) حالة نقص التوتر) / نقص التوترية ((للمحلول) المدى الذي يكون فيه للمحلول ضغط أسموزي أقل من غيره)",
 "hypotonus": "ارتخاء, نقص التوتر ((للنسيج العضلي) حالة نقص التوتر)",
 "hypotyposis": "تصوير بياني, وصف حي (وصف تصويري حي)",
 "hypovitaminosis": "عوز الفيتامين, نقص الفيتامين (أي من الأمراض المتعددة الناجمة عن نقص فيتامين واحد أو أكثر)",
 "hypovolaemia": "نقص حجم الدم (اضطراب دموي يتمثل في انخفاض حجم الدم المتداول)",
 "hypovolaemic": "ناقص حجم الدم (متعلق بانخفاض حجم الدم المتداول)",
 "hypovolemia": "نقص حجم الدم (اضطراب دموي يتمثل في انخفاض حجم الدم المتداول)",
 "hypovolemic": "ناقص حجم الدم (متعلق بانخفاض حجم الدم المتداول)",
 "hypovolemic shock": "صدمة نقص حجم الدم (صدمة ناتجة عن فقدان شديد للدم أو السوائل)",
 "hypoxia": "نقص الأكسجة (نقص الأكسجين مما يسبب دافعاً قوياً جداً لتصحيح النقص)",
 "hypoxic hypoxia": "نقص الأكسجة نقص التأكسج (نقص الأكسجة الناتج عن خلل في أكسجة الدم في الرئتين)",
 "hypoxis hirsuta": "عشب النجمة الأمريكي (عشب نجمة معمر من أمريكا الشمالية)",
 "hypozeugma": "ربط سفلي (استخدام سلسلة من الموضوعات مع مسند واحد)",
 "hypozeuxis": "ربط متوازٍ (استخدام سلسلة من الجمل المتوازية)",
 "hypsiglena torquata": "ثعبان ليلي (ثعبان ليلي متجول من غرب الولايات المتحدة والمكسيك)",
 "hypsiprymnodon moschatus": "كنغر المسك (كنغر صغير من شمال شرق أستراليا)",
 "hypsography": "قياس الارتفاعات (قياس ارتفاع الأرض فوق مستوى سطح البحر) / قياس الارتفاعات (الدراسة العلمية لتكوين الأرض فوق مستوى سطح البحر)",
 "hypsometer": "مقياس الارتفاع بالغليان (مقياس ارتفاع يستخدم نقطة غليان الماء لتحديد ارتفاع الأرض)",
 "hypsometry": "قياس الارتفاعات (قياس ارتفاع الأرض فوق مستوى سطح البحر)",
 "hyrax": "وَبْر, طَبْسُون (مجموع شعر بعض الحيوانات؛ للبعير وَبَرٌ رَمْلي اللون)",
 "hyson": "هايسون (شاي أخضر صيني بأوراق ملتوية)",
 "hyssop": "زُوفَا",
 "hyssop loosestrife": "ليثروم زوفي الأوراق (نبات حولي ذو زهور وردية صغيرة منفردة؛ أصله من أوروبا ولكنه متوطن على نطاق واسع في المناطق الرطبة)",
 "hyssop oil": "زيت الزوفا (يُستخدم بشكل رئيسي في المشروبات الكحولية)",
 "hyssopus officinalis": "زوفا (نعناع أوروبي بأوراق عطرية وحريفة تستخدم في العطور وكوابل في الطبخ؛ يزرع غالباً كعلاج للكدمات؛ ينتج زيت الزوفا)",
 "hysterectomy": "استئصال الرحم (إزالة جراحية للرحم)",
 "hysteresis": "تخلفية, هستيريا مغناطيسية (تأخر التأثير عن سببه؛ وخاصة الظاهرة التي يتخلف فيها الحث المغناطيسي لمادة فيرومغناطيسية عن المجال المغناطيسي المتغير)",
 "hysteria": "هِسْتِيرْيَا",
 "hysteric": "هِسْتِيرِيّ (يتسم بالهستيريا العصبية النفسية أو ينشأ عنها) / هِسْتِيرِيّ (شخص يعاني من الهستيريا)",
 "hysterical": "هِسْتِيرِيّ (يتسم بانفعال مفرط أو لا يمكن السيطرة عليه) / هِسْتِيرِيّ (يتسم بالهستيريا العصبية النفسية أو ينشأ عنها)",
 "hysterical neurosis": "عصاب هستيري, هستيريا (اضطراب عصابي يتميز بنوبات عاطفية عنيفة واضطرابات في الوظائف الحسية والحركية)",
 "hysterically": "بجنون, بشكل هستيري (بطريقة هستيرية)\nمثال: صرخت بشكل هستيري عندما سمعت الخبر",
 "hysterics": "هستيريا (نوبة هستيريا)",
 "hysterocatalepsy": "تخشب هستيري (هستيريا مصحوبة بأعراض تخشبية)",
 "hysteron proteron": "القلب المنطقي, مغالطة وضع العربة أمام الحصان (المغالطة المنطقية المتمثلة في استخدام افتراض لم يتم إثباته بعد كمقدمة صحيحة) / قلب منطقي (عكس الترتيب الطبيعي لكلمتين أو جملتين)",
 "hysterosalpingogram": "صورة الرحم والبوق (أشعة سينية للرحم وقناتي فالوب؛ تجرى عادة لتشخيص العقم (لمعرفة ما إذا كان هناك أي انسداد))",
 "hysteroscopy": "تنظير الرحم (فحص بصري للرحم وبطانة الرحم باستخدام منظار داخلي يتم إدخاله عبر المهبل)",
 "hysterotomy": "بضع الرحم (شق جراحي في الرحم (كما في الولادة القيصرية))",
 "hytrin": "تيرازوسين, هيترين (دواء خافض لضغط الدم (الاسم التجاري هيترين) يستخدم لعلاج ارتفاع ضغط الدم)",
 "hz": "دَوْرَة فِي الثَّانِيَة, هَرْتز (وحدة التردد؛ الهرتز الواحد له فترة دورية تبلغ ثانية واحدة (سميت تيمناً بـ هاينريش رودولف هرتز))",
 "háček": "كَارُون",
 "i": "أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى.",
 "i am a doctor": "أَنَا طَبِيب, أَنَا طَبِيبة",
 "i am afraid of this": "أَنَا خَائِفٌ مِنْ هٰذَا, أَنَا خَائِفَةٌ مِنْ هٰذَا",
 "i am english": "أَنَا إِنْجْلِيزِيّ, أَنَا إِنْجْلِيزِيَّة",
 "i came, i saw, i conquered": "أَتَيْتُ، رَأَيْتُ، اِنْتَصَرْتُ, جِئْتُ، رَأَيْتُ، اِنْتَصَرْتُ",
 "i can't swim": "لَا أَسْتَطِيعُ السِّبَاحَة (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: لا أحب المدرسة.",
 "i don't care": "لَا يَهُمُّنِي (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: لا أحب المدرسة.",
