 "hottentot bread vine": "ديسقوريا الفيل, قدم الفيل (كرمة من جنوب أفريقيا لها ساق جذري ضخم مغطى بلحاء عميق التشقق)",
 "hottentot fig": "أصابع العروس, تين هوتنتوت (نبات عصاري منخفض النمو في جنوب أفريقيا له ثمرة كبسولية تحتوي على لب صالح للأكل)",
 "hottentot language": "الهوتنتوت, لغة الخويخو (أي من لغات الخويسان التي يتحدث بها الشعب الرعوي في ناميبيا وجنوب أفريقيا)",
 "hottentot's bread": "خبز الهوتنتوت (جذمور سميك صالح للأكل لنبات قدم الفيل)",
 "hottentot's bread vine": "ديسقوريا الفيل, قدم الفيل (كرمة من جنوب أفريقيا لها ساق جذري ضخم مغطى بلحاء عميق التشقق)",
 "hottentot's fig": "أصابع العروس, تين هوتنتوت (نبات عصاري منخفض النمو في جنوب أفريقيا له ثمرة كبسولية تحتوي على لب صالح للأكل)",
 "hottish": "حَارّ نَوْعاً مَا (ساخن بعض الشيء)",
 "hottonia inflata": "ريشة الماء الأمريكية (ريشة ماء في شرق الولايات المتحدة ذات سيقان زهرية منتفخة إسفنجية مغمورة وأزهار بيضاء)",
 "hottonia palustris": "بنفسج الماء (ريشة ماء من أوروبا وغرب آسيا ذات أوراق مغمورة وطافية وأزهار بنفسجية)",
 "houbara bustard": "حُبَارَى",
 "houdah": "هودج (مقعد (عادة ما يكون مظللاً) للركوب على ظهر جمل أو فيل)",
 "houhere": "خشب الشريط, لحاء الدانتيل (شجرة صغيرة أو شجيرة من نيوزيلندا ذات غزارة في عناقيد إبطية من الزهور البيضاء الورقية برائحة العسل والتي يستخدم لحاؤها للحبال)",
 "hoummos": "حمص (معجون سميك مصنوع من الحمص المهروس والطحينة وعصير الليمون والثوم؛ يستخدم خاصة كغموس للخبز؛ نشأ في الشرق الأوسط)",
 "hound": "كَلْبُ صَيْد (بمعنى ضربهُ بالكُلاب أو جعل لها كَلْبًا؛ سَيْر أحمر يُجعَل بين طرفي الأديم إذا خُرِز)\nمثال: كان الكلب ميتا.",
 "hound dog": "كلب صيد (أي من عدة سلالات من الكلاب المستخدمة للصيد تتميز عادة بآذان كبيرة متدلية)",
 "hound's tongue": "لِسَان الكَلْب (فِي : جسم لحميّ مستطيل متحرك، يكون في الفم، ويصلح للتّذوُّق والبلع، وللنطق؛ جَارِحَة الْكَلَام؛ كَلِمَة)\nمثال: ماري لها فم ليس لها لسان.",
 "hound's-tongue": "لسان الكلب المخزني (شجيرة ثنائية الحول في أوروبا وغرب آسيا لها أوراق خشنة على شكل لسان وأزهار حمراء أرجوانية داكنة) / لسان الكلب الفرجيني (شجيرة معمرة في أمريكا الشمالية لها أوراق خشنة على شكل لسان وأزهار زرقاء شاحبة إلى أرجوانية)",
 "hound's-tooth check": "كاروهات مسننة, نمط سن الكلب (نسيج بنمط مربعات صغيرة مكسورة أو خشنة)",
 "houndstooth check": "كاروهات مسننة, نمط سن الكلب (نسيج بنمط مربعات صغيرة مكسورة أو خشنة)",
 "hour": "وَقْت (\"بَقِيَ وَقْتاً عِنْدَهُ \" : أَيْ مِقْدَاراً مِنَ الزَّمَنِ؛ \"جَاءَ فِي الوَقْتِ الْمُنَاسِبِ \" : فِي اللَّحْظَةِ الْمُنَاسِبَةِ)\nمثال: حان وقت الذهاب.",
 "hour angle": "الزَّاوِيَة السَّاعِيَّة (المسافة الزاوية على طول خط الاستواء السماوي من خط زوال الراصد إلى الدائرة الساعية لجرم سماوي معين) / زاوية الساعة ((علم الفلك) المسافة الزاوية لنقطة سماوية مقاسة غرباً على طول خط الاستواء السماوي من تقاطع السمت؛ المطلع المستقيم لمراقب في موقع معين ووقت معين من…)",
 "hour circle": "دائرة الساعة (دائرة عظمى على الكرة السماوية تمر عبر كلا القطبين السماويين)",
 "hour hand": "عَقْرَب سَاعَات",
 "hourglass": "سَاعَةٌ رَمْلِيَّة (ثُلْث ثُمْن اليَوْم بمعنى مجموع النَهَار واللَيْل، أي جزء من أربعة وعشرين جزءا من مجموع النهار والليل وتتكون من ستين دَقِيقَة؛ الوَقْت الحاضر، الآن)\nمثال: درست لمدة ساعة.",
 "hourglass-shaped": "سَاعَاتِيّ الشَّكْل (على شكل ساعة رمليّة)",
 "houri": "حَوْرَاء",
 "hourlong": "لِمُدَّة سَاعَة (يَسْتَمِرّ ساعَة واحِدَة)",
 "hourly": "بالساعة, كل ساعة (كل ساعة؛ حسب الساعة) / سَاعِيّ (يحدث كل ساعة أو يُدفع بالساعة)\nمثال: يومياً، بل كل ساعة، كنت أزداد قوة",
 "hours": "ساعات (فترة زمنية غير محددة (عادة ما تكون طويلة)) / ساعات العمل (فترة زمنية مخصصة للعمل)\nمثال: تحدثوا لساعات",
 "house": "مَجْلِس",
 "house agent": "سمسار عقارات, وسيط عقاري (شخص مخول للعمل كوكيل لبيع الأراضي والعقارات)",
 "house arrest": "إِقَامَة جَبْرِيَّة",
 "house cat": "قط, قط أليف (حَيْوَان مستأنس من عائلة السَنُّورِيّات، له في اللغة أسماء عديدة تذكر وتؤنث)\nمثال: أعطنا هذا القط.",
 "house centipede": "مئوية أرجل المنزل (مئوية أرجل طويلة الأرجل شائعة في الأماكن الرطبة مثل الأقبية)",
 "house decorator": "مزخرف داخلي, مهندس ديكور (شخص يتخصص في الديكور الداخلي)",
 "house detective": "مخبر الفندق (محقّق خاص يعمل لدى فندق أو متجر بيع بالتجزئة)",
 "house dick": "مخبر الفندق (محقّق خاص يعمل لدى فندق أو متجر بيع بالتجزئة)",
 "house finch": "جزم, عصفور المنزل (عصفور صغير أصله من غرب الولايات المتحدة والمكسيك)",
 "house fly": "ذبابة منزلية (ذبابة شائعة تتردد على مساكن البشر وتنشر العديد من الأمراض)",
 "house guest": "ضيف المنزل (ضيف يتم استقباله في منزلك)",
 "house husband": "زوج مدبر للمنزل (زوج يدير المنزل بينما تكسب زوجته دخل الأسرة)",
 "house martin": "سنونو المنازل (سنونو أوروبي صغير شائع يبني أعشاشاً تحت أفاريز المنازل)",
 "house mouse": "فأر المنزل (فأر بني رمادي من العالم القديم أصبح الآن آفة منزلية شائعة في جميع أنحاء العالم)",
 "house music": "هاوس, موسيقى الهاوس",
 "house of burgesses": "مجلس بورغيس (المجلس الأدنى للهيئة التشريعية في فرجينيا الاستعمارية)",
 "house of cards": "بَيْت مِنْ وَرَق (بمعنى قضى الليل؛ الخَيْمَة من الشَعْر يَبِيت فيها البَدَوي أو المُسافر. الجمع بُيُوت)\nمثال: لنعد إلى البيت.",
 "house of commons": "مَجْلِس عُمُوم",
 "house of correction": "إصلاحية, دار تقويم ((سابقاً) سجن أو مكان احتجاز آخر للأشخاص المدانين بجرائم بسيطة)",
 "house of detention": "دار أحداث, دار احتجاز (مؤسسة يمكن فيها احتجاز الجناة الأحداث مؤقتاً (عادة تحت إشراف محكمة الأحداث))",
 "house of god": "بيت الصلاة, مكان عبادة (أي مبنى تتجمع فيه الجماعات للصلاة)",
 "house of hanover": "بيت هانوفر, هانوفر (البيت الملكي الإنجليزي الذي حكم من 1714 إلى 1901 (من جورج الأول إلى فيكتوريا))",
 "house of ill repute": "بيت دعارة, ماخور (مبنى تتوفر فيه البغايا)",
 "house of islam": "دار الإسلام (المناطق التي يشكل المسلمون فيها الأغلبية)",
 "house of lancaster": "بيت لانكستر, لانكستر (البيت الملكي الإنجليزي الذي حكم من 1399 إلى 1461؛ كان شعاره وردة حمراء)",
 "house of lords": "مَجْلِس لُورْدَات",
 "house of prayer": "بيت الصلاة, مكان عبادة (أي مبنى تتجمع فيه الجماعات للصلاة)",
 "house of prostitution": "بيت دعارة, ماخور (مبنى تتوفر فيه البغايا)",
 "house of representatives": "مَجْلِس النُّوَّاب, مَجْلِسْ أَدْنٰى",
 "house of tudor": "بيت تيودور, تيودور (سلالة إنجليزية تنحدر من هنري تيودور؛ حكم ملوك تيودور من هنري السابع إلى إليزابيث الأولى (من 1485 إلى 1603))",
 "house of war": "دار الحرب (المناطق التي لا تخضع للحكم الإسلامي (في الفقه الإسلامي التقليدي))",
 "house of windsor": "بيت وندسور, وندسور (العائلة المالكة البريطانية منذ عام 1917)",
 "house of worship": "بيت الصلاة, مكان عبادة (أي مبنى تتجمع فيه الجماعات للصلاة)",
 "house of york": "بيت يورك, يورك (البيت الملكي الإنجليزي (فرع من خط بلانتاجينت) الذي حكم من 1461 إلى 1485؛ كان شعاره وردة بيضاء)",
 "house organ": "نشرة داخلية (دورية تنشرها شركة تجارية لموظفيها وعملائها)",
 "house paint": "دهان المنازل (طلاء يستخدم لتغطية الأعمال الخشبية الخارجية للمنزل)",
 "house painter": "دهان منازل (دهان المنازل أو المباني المماثلة)",
 "house painting": "دهان, طلاء المنازل (مهنة دهان المنازل)\nمثال: كان طلاء المنازل هو الحرفة الوحيدة التي يعرفها",
 "house party": "حفلة منزلية (حفلة تستمر لأكثر من ليلة واحدة في منزل كبير)",
 "house physician": "طبيب مقيم (طبيب يعيش في المستشفى ويعتني بالمرضى المقيمين تحت إشراف الطاقم الطبي للمستشفى)\nمثال: كان الطبيب المقيم يتلقى تدريباً سريرياً خاصاً في المستشفى",
 "house servant": "خادم منزلي, عامل منزلي (خادم يتقاضى أجراً لأداء مهام وضيعة حول المنزل)",
 "house sitter": "جَلِيس المَنْزِل, راعِي البَيْت (شخص يقيم في منزل ويعتني به أثناء غياب شاغله الأصلي (عادة دون مقابل مادي))",
 "house snake": "ثعبان الحليب (ثعبان ملك غير سام أسمر وبني مع بقعة قذالية على شكل سهم؛ الأنواع الجنوبية الشرقية لها خطوط حمراء مثل الثعابين المرجانية)",
 "house sparrow": "عُصْفُور, دُورِيّ",
 "house trailer": "مقطورة سكنية (مركبة بعجلات يمكن سحبها بواسطة سيارة أو شاحنة ومجهزة للسكن)",
 "house wren": "نمنمة المنازل (نمنمة أمريكية شائعة تعشش حول المنازل)",
 "house-builder": "باني منازل (شخص يبني المنازل كعمل تجاري)",
 "house-proud": "فَخُور بِمَنْزِلِه (فخور ببيته أو أثاثه أو صيانته)",
 "house-raising": "بناء جماعي (البناء بواسطة مجموعة من الجيران)",
 "house-to-house": "مِنْ بَابٍ إِلَى بَاب (لا يُغفِل أحدًا؛ يتنقّل من بيت إلى بيت)",
 "house-trained": "مُدَرَّب عَلَى النَّظَافَة ((في الحيوانات الأليفة) مدرّب على قضاء الحاجة خارج المنزل أو في مكان مخصّص)",
 "houseboat": "عوامة, منزل عائم (صندل مصمم ومجهز للاستخدام كمسكن)",
 "housebound": "حَبِيسُ المَنْزِلِ, مُلَازِمٌ لِلبَيْتِ (مَحْصُورٌ فِي البَيْتِ عَادَةً بِسَبَبِ المَرَضِ)",
 "housebreaker": "سارق منازل (لص يقتحم ويدخل منزل شخص آخر بشكل غير قانوني) / هادم المنازل (هادم للمنازل)",
 "housebreaking": "اقتحام, كسر وخلع (التعدي لغرض غير قانوني؛ الدخول غير المشروع إلى مبنى بنية إجرامية)",
 "housebroken": "مُدَرَّب عَلَى النَّظَافَة ((في الحيوانات الأليفة) مدرّب على قضاء الحاجة خارج المنزل أو في مكان مخصّص)",
 "housebuilder": "باني منازل (شخص يبني المنازل كعمل تجاري)",
 "housecleaning": "تنظيف المنزل (فعل تنظيف غرف ومفروشات المنزل) / تنظيف داخلي, حملة تطهير ((مجازياً) فعل الإصلاح عن طريق إزالة الموظفين أو الممارسات أو الظروف غير المرغوب فيها)\nمثال: تنظيف المنزل الفعال يجب أن يتم غرفة غرفة",
 "housecoat": "قميص نوم, نيجليجيه (روب نوم فضفاض للنساء)",
 "housecraft": "تدبير منزلي (المهارة في الإدارة المنزلية)",
 "housedog": "كلب حراسة المنزل, كلب منزلي (كلب مدرب على حراسة المنزل)",
 "housefather": "مشرف سكن (رجل مسؤول عن الأطفال في مؤسسة)",
 "housefly": "ذُبَابَة مَنْزِلِيَّة (حشرة صغيرة سوداء اللون معروفة)\nمثال: أمسك بتلك الذبابة.",
 "houseful": "بيت ممتلئ, ملء منزل (العدد الذي يستوعبه المنزل)\nمثال: استضافوا منزلاً مليئاً بالضيوف",
 "houseguest": "ضيف المنزل (ضيف يتم استقباله في منزلك)",
 "household": "أسرة, عائلة (وحدة اجتماعية تعيش معًا)\nمثال: نقل عائلته إلى فيرجينيا",
 "household appliance": "جِهَاز كَهْرُومَنْزِلِيّ",
 "household arts": "اقتصاد منزلي, تدبير منزلي (نظرية وممارسة إدارة المنزل)",
 "household linen": "بياضات منزلية, سلع بيضاء (سلع جافة للاستخدام المنزلي مصنوعة عادة من قماش أبيض)",
 "householder": "صاحب منزل, مالك المنزل (شخص يمتلك منزلاً)",
 "househusband": "زوج مدبر للمنزل (زوج يدير المنزل بينما تكسب زوجته دخل الأسرة)",
 "housekeeper": "مُدَبَّرَة الْمَنْزَل",
 "housekeeping": "أعمال منزلية, تنظيف المنزل (عمل تنظيف وإدارة المنزل)",
 "houseleek": "حَيّ الْعَالَم (ضد المَيِّت، على قيد الحَيَاة؛ جمع حَيَاء)\nمثال: ينبح كلب في الحي.",
 "houselights": "أضواء القاعة (أضواء تضيء جزء الجمهور في المسرح أو قاعة أخرى)",
 "housemaid": "خادمة (عاملة منزلية)",
 "housemaid's knee": "ركبة الخادمة (تورم الجراب في الركبة (بسبب الصدمة أو الركوع المفرط))",
 "houseman": "طبيب امتياز (طالب متقدم أو خريج طب يكتسب خبرة عملية تحت الإشراف)",
 "housemaster": "مشرف سكن طلابي (معلم مسؤول عن سكن داخلي مدرسي)",
 "housemate": "رفيق سكن (شخص يقيم معك في نفس المنزل)",
 "housemother": "مشرفة سكن (امرأة تعمل كمرافقة في سكن للشباب)",
 "housepaint": "دهان المنازل (طلاء يستخدم لتغطية الأعمال الخشبية الخارجية للمنزل)",
 "houseplant": "نبات داخلي, نبات منزلي (أي من النباتات المتنوعة التي تُزرع داخل المنازل لأغراض الزينة)",
 "houseroom": "حَيِّز مَنْزِلِيّ (مساحة للإقامة أو الوضع في منزل)\nمثال: لن أمنح تلك الطاولة حيزاً في منزلي",
 "housetop": "سطح المنزل (سقف البيت)\nمثال: أعلنها من فوق أسطح المنازل",
 "housewarming": "حفل تدشين المنزل, حفل نزالة (حفلة يجتمع فيها الناس للاحتفال بالانتقال إلى منزل جديد)",
 "housewife": "رَبَّة مَنْزِل, رَبَّة بَيْت",
 "housewifely": "خَاصٌّ بِرَبَّةِ المَنْزِل (مُتَعَلِّقٌ بِرَبَّةِ المَنْزِلِ أَوْ مُنَاسِبٌ لَهَا)",
 "housewifery": "أعمال ربة المنزل, تدبير منزلي (عمل ربة المنزل)",
 "housework": "أَعْمَال مَنْزِل, أَعْمَال الْمَنْزِل (في يطلق على أي عمل حرّ يحتاج إلى رأس مال مثل الصناعة والتجارة وقطاع المال وما أشبه)\nمثال: أنا في رحلة أعمال.",
 "housewrecker": "هادم المنازل (هادم للمنازل)",
 "housing": "غطاء زينة للحصان (معدات اسطبل تتكون من غطاء مزخرف للحصان، خاصة (سابقاً) لحصان الحرب) / إسكان, سكن (هياكل مجتمعة يتم فيها إيواء الناس) / غلاف احتواء, مبيت (غطاء واقٍ مصمم لاحتواء أو دعم مكون ميكانيكي)",
 "housing and urban development": "وزارة الإسكان والتنمية الحضرية (الإدارة الفيدرالية الأمريكية التي تدير البرامج الفيدرالية التي تتعامل مع تحسين الإسكان والتجديد الحضري؛ أنشئت عام 1965)",
 "housing commissioner": "مفوض الإسكان (مفوض مسؤول عن الإسكان العام)",
 "housing development": "مجمع سكني, مشروع سكني (منطقة سكنية تضم مساكن متشابهة بناها مطورون عقاريون وتخضع عادة لإدارة واحدة)\nمثال: يعيشون في المجمع السكني الجديد",
 "housing estate": "حي سكني مخطط (منطقة سكنية حيث تم تخطيط وبناء المنازل كلها في نفس الوقت)",
 "housing industry": "صناعة الإسكان, صناعة البناء والتشييد (صناعة تقوم ببناء المساكن)",
 "housing project": "مساكن شعبية, مشروع إسكان عام (مجمع سكني ممول ومُدار حكومياً للأسر ذات الدخل المنخفض)",
 "housing start": "بدء الإسكان, بدء البناء (فعل البدء في بناء منزل)",
 "houthi": "حُوثِيّ",
 "houyhnhnms": "هوانم (أرض تخيلها جوناثان سويفت حيث تحكم الخيول الذكية كائنات الياهو)",
 "hovea": "بازلاء أرجوانية, هوفا (أي من الشجيرات دائمة الخضرة الجذابة المتعددة في أستراليا، تزرع لأوراقها الخضراء الداكنة اللامعة وزهورها ذات اللون الأزرق الغني والبنفسجي المكثف)",
 "hovel": "عشة, كوخ (مأوى صغير بدائي يستخدم كمسكن)",
 "hover": "حَامَ (دار أو طاف حول شيء؛ اقترب من شيء دون الوصول إليه)",
 "hoverboard": "لوح طائر, هوفر بورد (جهاز يشبه لوح التزلج بدون عجلات يمكن أن يحلق فوق الأرض)",
 "hovercraft": "حَوَّامَة",
 "hoverfly": "ذُبَاب حَوَّام, ذُبَاب الزُّهُور",
 "how": "كَيْف, ازاي / كَيْفَ, ازاي / كَمْ, يَا لَ",
 "how are you": "كَيْف الْحال؟, كَيْفَ حَالُكَ؟",
 "how do i get to": "كَيْفَ يُمْكِنُنِي الْوُصُولُ إِلَى؛؟",
 "how do i get to the airport": "كَيْفَ يُمْكِنُنِي الْوُصُولُ إِلَى الْمَطَار؟",
 "how do i get to the train station": "كَيْفَ أَصِلُ إِلَى مَحَطَّةِ الْقِطَار؟, كَيْفَ يُمْكِنُنِي الْوُصُولُ إِلَى مَحَطَّةِ الْقِطَار؟",
 "how do you do": "تَشَرَّفْنَا",
 "how do you pronounce this word": "كَيْفَ نَنْطِق هٰذِهِ الْكَلِمَة؟, كَيْفَ تُنْطَق هٰذِهِ الْكَلِمَة؟",
 "how do you say … in english": "كَيْفَ تَقُولُ … بِالْإِنْجِلِيزِيَّة؟",
 "how do you spell this word": "كَيْفَ تَتَهَجَّى هٰذِهِ الْكَلِمَة؟",
 "how long": "كَم وَقْتًا, إِلَى مَتَى",
 "how many": "كَم / كَمْ",
 "how many languages do you speak": "كَمْ لُغَةً تَتَحَدَّثُ؟, كَم مِنْ لُغَةٍ تَتَحَدَّثُ",
 "how much": "كَمْ",
 "how much does it cost": "بِكَمْ هٰذَا؟, مَا ثَمَنُهُ؟ (عجز عَن الْكَلَام)\nمثال: بكم كيلو طماطم؟",
 "how old are you": "كَم عُمْرُكَ؟, كَم عُمْرُكِ؟",
 "how should i know": "كَيْفَ لِي أَنْ أَعْرِفَ؟",
 "how's it going": "كَيْفَ تَجرِْي الأُمُور",
 "how's the weather": "مَا هُوَ الطَّقْس؟, كَيْفَ حَالُ الطَّقْس؟ (انظر مَا)\nمثال: هلا! ما الجديد؟",
 "how-d'ye-do": "موقف محرج (وضع محرج)\nمثال: هذا موقف محرج حقاً",
 "how-do-you-do": "أَهْلًا, سَلَام (تعبير عن التحية) / موقف محرج (وضع محرج)\nمثال: كانوا يتبادلون التحيات المهذبة كل صباح",
 "howard": "هُوَارْد",
 "howdah": "هَوْدَج, مِحَفَّة",
 "howdy": "أَهْلًا, سَلَام (تعبير عن التحية)\nمثال: كانوا يتبادلون التحيات المهذبة كل صباح",
 "however": "بِأَيَّةِ طَرِيقَة, عَلَى كُلِّ حَال",
 "howitzer": "مورتر, هاون (مدفع يلقم من الفوهة ذو سبطانة قصيرة يطلق القذائف بزوايا مرتفعة لمدى قصير)",
 "howl": "عُوَاء / عَوَى / أَنَّ (يفيد التوكيد)\nمثال: كيف لي أن أعرف؟",
 "howler": "غلطة شنيعة (خطأ فادح وصارخ) / العواء, سعدان العواء (قرد يعيش في غابات أمريكا الجنوبية الاستوائية، يتميز بصيحات عواء عالية) / نُكْتَة صَارِخَة, نُكْتَة مُضْحِكَة جِدًّا (نكتة تبدو مضحكة للغاية)",
 "howler monkey": "العواء, سعدان العواء (قرد يعيش في غابات أمريكا الجنوبية الاستوائية، يتميز بصيحات عواء عالية)",
 "howling": "عُوَاء",
 "hoy": "صندل, طوافة (قارب مسطح القاع لحمل الأحمال الثقيلة (خاصة في القنوات))",
 "hoya": "نبات الشمع, هويا (مصدر للفعل نَبَتَ؛ اسم جنس شامل لكل ما تنبته الأرض من شجر أو بقل أو عشب أو غيره)\nمثال: هذا النبات مهدد بالانقراض.",
 "hoya carnosa": "نبات الشمع, هويا (متسلق عصاري من جنوب آسيا مع خيمات من الزهور النجمية الوردية والبيضاء)",
 "hoyden": "فتاة مسترجلة (فتاة تتصرف بطريقة صبيانية)",
 "hoydenish": "صَبْيَانِيَّة, مُسْتَرْجِلَة (تُوصف بالفتيات؛ متوحشة وصاخبة)",
 "hoydenism": "استرجال (الذكورة عند النساء (خاصة عند الفتيات والشابات))",
 "hp": "حصان, قوة حصان (وحدة للقدرة تساوي 746 واط)",
 "hq": "المقر الرئيسي, مقر القيادة (المنشأة العسكرية التي يؤدي منها القائد مهام القيادة)\nمثال: كان مقر الجنرال عبارة عن خيمتين كبيرتين",
 "hr": "ساعة (فترة زمنية تعادل 1/24 من اليوم)\nمثال: ستستغرق المهمة أكثر من ساعة",
 "hromokliia": "جروموكليا",
 "hrt": "علاج بالهرمونات البديلة (إعطاء هرمونات (الإستروجين والبروجستين) للنساء بعد انقطاع الطمث؛ يُعتقد أنها تحميهن من أمراض القلب وهشاشة العظام)",
 "hryvnia": "هَرِيفْنَا, هْرِيفْنَا",
 "hs": "هاسيوم (عنصر مشع ما بعد اليورانيوم، عدده الذري 108)",
 "hs1": "الهربس البسيط 1 (فيروس هربس يسبب الهربس الفموي)",
 "hs2": "الهربس البسيط 2 (فيروس هربس يمكن أن يسبب الهربس التناسلي)",
 "hsi": "شِي",
 "hsinchu": "شِينْجُو, شِينْتْشُو",
 "hsk": "اِمْتِحَان مُسْتَوَى اَللُّغَة اَلصِّينِيَّة, إتش إس كاي (اِمْتِحَان)\nمثال: لدي امتحان غدا.",
 "hsuan chiao": "طاوية (نظام فلسفي صيني شعبي قائم على تعاليم لاو تزو ولكنه يتميز بوحدة وجود لآلهة متعددة وممارسات الخيمياء والعرافة والسحر)",
 "hsv-1": "الهربس البسيط 1 (فيروس هربس يسبب الهربس الفموي)",
