 "hognose snake": "ثعبان خنزيري الأنف (ثعبان غير ضار من أمريكا الشمالية ذو أنف مقلوب؛ قد ينشر رأسه ورقبته أو يتظاهر بالموت عند الانزعاج)",
 "hognosed skunk": "ظربان خنزيري الأنف (ظربان كبير عاري الخطم ذو ظهر وذيل أبيض؛ من جنوب غرب أمريكا الشمالية والمكسيك)",
 "hogshead": "برميل كبير (برميل كبير خاصة واحد بسعة 63 جالون) / هوغسهيد (وحدة سعة بريطانية للمشروبات الكحولية)",
 "hogwarts": "هُوجْوَرْتْس",
 "hogwash": "سَخَافَة, كَذِب (سلوك غير مقبول (خاصة التصريحات الكاذبة بشكل مثير للسخرية))",
 "hogweed": "هَرْقَلِيَّة, عُشْبَة الْخِنْزِير",
 "hohenzollern": "هوهنزولرن (عائلة نبيلة ألمانية حكمت براندنبورغ وبروسيا)",
 "hohenzollern empire": "الرايخ الثاني (الرايخ عندما حكم ملوك هوهنزولرن ألمانيا (من 1871 إلى 1919))",
 "hoheria populnea": "خشب الشريط, لحاء الدانتيل (شجرة صغيرة أو شجيرة من نيوزيلندا ذات غزارة في عناقيد إبطية من الزهور البيضاء الورقية برائحة العسل والتي يستخدم لحاؤها للحبال)",
 "hohhot": "هُوهِيهُوت, خُوخِيخَاوْتِي",
 "hoi polloi": "جماهير, جموع (عامة الناس بشكل عام)\nمثال: افصل المحاربين عن الجموع",
 "hoisin sauce": "صلصة البط, صلصة هويسين (تابل صيني سميك حلو ولاذع)",
 "hoist": "رَفَعَ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ) / رَافِعَة\nمثال: رفع سامي نظارته.",
 "hoister": "مشغل رافعة (مشغل لآلة الرفع)",
 "hoity-toity": "مُتَعَاظِم, مُتَكَبِّر بِتَصَنُّع (متأنّق بتصنّع؛ يحمل جوًّا من الأهمية المصطنعة؛ متكبّر ومتعجرف)",
 "hoka": "لغات هوكان (عائلة من لغات الهنود الحمر يتم التحدث بها في كاليفورنيا) / هوكان (فرد من شعب هندي في أمريكا الشمالية يتحدث إحدى لغات هوكان)",
 "hokan": "لغات هوكان (عائلة من لغات الهنود الحمر يتم التحدث بها في كاليفورنيا) / هوكان (فرد من شعب هندي في أمريكا الشمالية يتحدث إحدى لغات هوكان)",
 "hokey": "مُتَصَلِّب, مُصْطَنَع (رسمي بشكل مصطنع ومتكلّف) / رَكِيكُ الحِسّ, مُبْتَذَلُ العَاطِفَة (مُفرِط في العاطفة بشكل مُتصنَّع أو غير صادق)",
 "hokkaido": "هُوكَايْدُو, هُكَّايْدُو",
 "hokkianese": "فوكين, لغة مين (أي من أشكال اللغة الصينية التي يتم التحدث بها في مقاطعة فوجيان)",
 "hokkianese language": "فوكين, لغة مين (أي من أشكال اللغة الصينية التي يتم التحدث بها في مقاطعة فوجيان)",
 "hokum": "كَلَام فَارِغ, لَغْو (رسالة يبدو أنها لا تحمل أي معنى)",
 "holarrhena antidysenterica": "شجرة العاج, كورشي (شجرة آسيوية استوائية ذات خشب أبيض صلب ولحاء كان يستخدم سابقاً كعلاج للدوسنتاريا والإسهال)",
 "holarrhena pubescens": "شجرة العاج, كورشي (شجرة آسيوية استوائية ذات خشب أبيض صلب ولحاء كان يستخدم سابقاً كعلاج للدوسنتاريا والإسهال)",
 "holcus lanatus": "ضباب يوركشاير, عشب مخملي (عشب أوروبي معمر طويل له ساق مخملية؛ توطن في الولايات المتحدة ويستخدم للعلف)",
 "holcus mollis": "عشب ناعم زاحف (عشب أوروبي معمر بأوراق مخملية ناعمة)",
 "hold": "مَسَكَ, مسك",
 "hold one's tongue": "صَمَتَ",
 "hold-down": "تقييد, كبح (تحديد أو قيد)\nمثال: دافعو الضرائب يريدون كبح الإنفاق الحكومي",
 "holdall": "حقيبة حمل, حقيبة كبيرة (حقيبة أو سلة واسعة تتسع لأشياء كثيرة)",
 "holder": "حامل (جهاز حمل) / حامل (الشخص الذي بحوزته شيك أو كمبيالة أو سند أو وثيقة ملكية مظهرة له أو لمن يحملها) / حائز, حامل (شخص يحمل أو يحوز شيئاً ما)\nمثال: حامل مناشف",
 "holdfast": "أداة تثبيت, مثبت (قيد يربط بشيء ما أو يثبت شيئاً في مكانه)",
 "holding": "إبقاء, احتفاظ (فعل الاحتفاظ بشيء ما) / أملاك, مقتنيات (شيء مملوك؛ أي حيازة ملموسة أو غير ملموسة يمتلكها شخص ما)\nمثال: تلك القبعة ملكي",
 "holding cell": "زنزانة احتجاز, نظارة المحكمة (سجن في مبنى المحكمة حيث يمكن احتجاز المتهمين أثناء المحاكمة)",
 "holding company": "شَرِكَة قَابِضَة",
 "holding device": "أداة تثبيت, حامل (جهاز لحمل أو تثبيت شيء ما)",
 "holding paddock": "حظيرة احتجاز (حظيرة يتم فيها حبس الماشية مؤقتاً)",
 "holding pattern": "نمط الانتظار (مسار الطيران (عادة دائري) الذي تحافظ عليه الطائرة التي تنتظر الإذن بالهبوط) / حالة ترقب, نمط الانتظار (حالة من عدم النشاط مع عدم وجود تقدم وعدم وجود تغيير)\nمثال: يجب أن تدخل في حالة ترقب حتى يتغلب على خيبة أمله",
 "holding pen": "حظيرة احتجاز (حظيرة يتم فيها حبس الماشية مؤقتاً)",
 "holding yard": "حظيرة احتجاز (حظيرة يتم فيها حبس الماشية مؤقتاً)",
 "holdout": "إخفاء الورق (فعل إخفاء أوراق اللعب في لعبة القمار لتكون متاحة للاستخدام الشخصي لاحقاً) / امتناع, مماطلة (رفض المفاوض التوصل إلى اتفاق على أمل الحصول على صفقة أفضل) / رافض للتسوية, ممتنع (مفاوض يأمل في الحصول على تنازلات عن طريق رفض التوصل إلى اتفاق)\nمثال: كان رامي فريقهم النجم ممتنعاً عن التوقيع لمدة ستة أسابيع",
 "holdover": "أثر باق, بقية (شيء نجا وبقي من الماضي) / الباقي في المنصب (مسؤول يبقى في منصبه بعد انتهاء ولايته)\nمثال: بقية من الستينيات",
 "holdup": "سطو مسلح (سطو تحت تهديد السلاح) / إرجاء, تأجيل (فعل التأخير؛ عدم النشاط الناتج عن تأجيل شيء ما إلى وقت لاحق)",
 "holdup man": "قاطع طريق, لص مسلح (لص مسلح ذكر)",
 "holdup woman": "لصة مسلحة (لصة أنثى مسلحة)",
 "hole": "ثَقْب, حُفْرة (فَجَّرَ أو خَرَقَ شيئًا بفتح فيه؛ نَفَذَ أو مرَّ عبر شيء) / تقب\nمثال: انه ثقب الاسود.",
 "hole card": "ورقة مقلوبة ((في البوكر) ورقة لعب توزع ووجهها لأسفل ولا يتم كشفها حتى مرحلة الكشف) / ورقة رابحة مخفية (أي أصول مخفية حتى يمكن استخدامها بشكل مفيد)",
 "hole plug": "زر سدادة (سدادة صغيرة مسطحة مصنوعة من البلاستيك أو المعدن أو الخشب، تستخدم لتغطية الثقوب والبراغي الظاهرة في الأثاث)\nمثال: بعد تثبيت الألواح ببرغي، استخدم زر سدادة لتغطيته",
 "hole punch": "خَرَّامَة, خَرَّامَة وَرَق",
 "hole-and-corner": "ثَانَوِيّ, هَامِشِيّ (يتعلَّق بالجوانب الهامشيّة وغير المهمّة من الحياة)",
 "hole-in-corner": "ثَانَوِيّ, هَامِشِيّ (يتعلَّق بالجوانب الهامشيّة وغير المهمّة من الحياة)",
 "hole-in-one": "حفرة بضربة واحدة (لعبة في الغولف حيث تكتمل الحفرة بضربة واحدة)",
 "hole-in-the-wall": "دكان صغير, مكان صغير منعزل (مكان صغير متواضع وبعيد عن الأنظار)\nمثال: كان مكتبه عبارة عن مكان صغير منعزل",
 "holey": "مُثَقَّب, مُسَامِيّ (يسمح بالمرور دخولاً وخروجاً)",
 "holibut": "هلبوت (سمكة غذائية بحرية في شمال المحيط الأطلسي أو شمال المحيط الهادئ؛ أكبر الأسماك المفلطحة وواحدة من أكبر الأسماك العظمية)",
 "holiday": "عِيد / عُطْل, عُطْلَة (أوقف أو جعل شيء غير فعال لفترة معينة؛ إيقاف شيء عن العمل أو تركه بدون استخدام أو اهتمام) / إِجَازَة, عُطْلَة\nمثال: ذهب سامي في عطلة.",
 "holiday resort": "فندق منتجع, منتجع (فندق يقع في منطقة منتجع)",
 "holiday season": "موسم العطلات (وقت يأخذ فيه الكثير من الناس إجازات)",
 "holidaymaker": "سائح (شخص يسافر للمتعة)",
 "holier-than-thou": "مُتَظَاهِر بِالتَّقْوَى, مُرَائِي (مُفرِط في إظهار التقوى بشكل نفاقيّ)",
 "holiness": "قُدْسِيَّة",
 "holism": "شمولية, نظرية شمولية (النظرية القائلة بأن أجزاء أي كل لا يمكن أن توجد ولا يمكن فهمها إلا في علاقتها بالكل)\nمثال: تفيد الشمولية بأن الكل أكبر من مجموع أجزائه",
 "holistic": "شمولي, كلي (يؤكد على العلاقة العضوية أو الوظيفية بين الأجزاء والكل)",
 "holistic medicine": "طب شمولي (الرعاية الطبية للشخص ككل باعتباره خاضعاً لعوامل شخصية واجتماعية وكذلك عضوية)\nمثال: يعالج الطب الشمولي العقل وكذلك الجسم",
 "holistic theory": "شمولية, نظرية شمولية (النظرية القائلة بأن أجزاء أي كل لا يمكن أن توجد ولا يمكن فهمها إلا في علاقتها بالكل)\nمثال: تفيد الشمولية بأن الكل أكبر من مجموع أجزائه",
 "holla": "خوار, زئير (تلفظ عالٍ جداً (مثل صوت حيوان))\nمثال: ملأ خواره الممر",
 "holland": "هُولَنْدَا, هُولَنْدَة",
 "holland gin": "جن هولندي (جن مصنوع في هولندا)",
 "hollandaise": "هولنديز (بيض وزبدة مع عصير الليمون)",
 "hollander": "هولندي (مواطن أو ساكن في هولندا)",
 "hollands": "جن هولندي (جن مصنوع في هولندا)",
 "holler": "خوار, زئير (تلفظ عالٍ جداً (مثل صوت حيوان)) / جوف, منخفض (وادٍ صغير بين الجبال)\nمثال: ملأ خواره الممر",
 "hollering": "خوار, زئير (تلفظ عالٍ جداً (مثل صوت حيوان))\nمثال: ملأ خواره الممر",
 "hollerith card": "بطاقة مثقبة (بطاقة يمكن تسجيل البيانات عليها في شكل ثقوب)",
 "hollo": "خوار, زئير (تلفظ عالٍ جداً (مثل صوت حيوان))\nمثال: ملأ خواره الممر",
 "holloa": "خوار, زئير (تلفظ عالٍ جداً (مثل صوت حيوان))\nمثال: ملأ خواره الممر",
 "hollow": "أَجْوَف",
 "hollow out": "تَجَوَّفَ",
 "hollow-back": "الظهر الأجوف, بقعس (انحناء داخلي (أمامي) غير طبيعي للعمود الفقري)",
 "hollow-eyed": "غَائِر العَيْنَيْن (ذُو سِمَات وَجْه عَظْمِيّ كَالجُثَّة؛ غَائِر العَيْنَيْن)",
 "hollow-horned": "مُجَوَّفُ القُرُون (ذو قرون مجوّفة من الداخل)",
 "holloware": "أواني مجوفة (أطباق تقديم فضية)",
 "hollowly": "بشكل أجوف, بفراغ (بطريقة جوفاء)\nمثال: تردد صدى خطواتها بشكل أجوف في القاعة الفارغة",
 "hollowness": "رياء, زيف (صفة عدم الصراحة أو الصدق؛ الخداع أو النفاق) / تجويف, فراغ (خاصية وجود منطقة غائرة) / تجوّف (حالة كونه مجوفاً: وجود مساحة فارغة في الداخل)",
 "hollowware": "أواني مجوفة (أطباق تقديم فضية)",
 "holly": "بَهَشِيَّة, إِيلِكْس",
 "holly fern": "سرخس مسنن, سرخس هولي (سرخس استوائي من العالم القديم له سعف لامع يوحي بالهولي؛ يوضع أحياناً في جنس بوليستيشوم) / سرخس هولي (أي من السراخس المتنوعة من جنس بوليستيشوم لها سعف بملمس ولمعان مثل الهولي)",
 "holly-leaf cherry": "إيسلاي, كرز هولي الأوراق (برقوق بري دائم الخضرة من كاليفورنيا بأوراق جلدية شائكة وزهور بيضاء)",
 "holly-leaved cherry": "إيسلاي, كرز هولي الأوراق (برقوق بري دائم الخضرة من كاليفورنيا بأوراق جلدية شائكة وزهور بيضاء)",
 "holly-leaved oak": "بلوط هولم, سنديان أخضر (بلوط دائم الخضرة من جنوب أوروبا له أوراق تشبه إلى حد ما أوراق البهشية؛ ينتج خشباً صلباً)",
 "holly-leaves barberry": "عنب أوريغون, ماهونيا (شجيرة زينة دائمة الخضرة من ساحل المحيط الهادئ لأمريكا الشمالية ذات أوراق خضراء داكنة ريشية وعناقيد من الزهور الصفراء تليها حبات توت زرقاء سوداء)",
 "hollygrape": "عنب أوريغون, ماهونيا (شجيرة زينة دائمة الخضرة من ساحل المحيط الهادئ لأمريكا الشمالية ذات أوراق خضراء داكنة ريشية وعناقيد من الزهور الصفراء تليها حبات توت زرقاء سوداء)",
 "hollyhock": "ختمية (أي من نباتات طويلة متنوعة من جنس ألسيا؛ موطنها الشرق الأوسط ولكنها توطنت وزرعت على نطاق واسع لزهورها الكبيرة جداً والمتنوعة الألوان) / ألثيا, ختمية (أي من نباتات متنوعة من جنس ألثيا؛ تشبه ولكن بزهور أصغر من جنس ألسيا)",
 "hollywood": "هُولِيوُود",
 "holm oak": "سِنْدِيَان",
 "holm tree": "بلوط هولم, سنديان أخضر (بلوط دائم الخضرة من جنوب أوروبا له أوراق تشبه إلى حد ما أوراق البهشية؛ ينتج خشباً صلباً)",
 "holmium": "هُلْمِيُوم / هُولْمِيُوم",
 "holocanthus tricolor": "جميلة الصخور (سمكة فراشة ذهبية وسوداء توجد من جزر الهند الغربية إلى البرازيل)",
 "holocaust": "مُحْرَقَة",
 "holocentrus ascensionis": "سمكة السنجاب الحمراء (سمكة حمراء زاهية في جزر الهند الغربية وبرمودا)",
 "holocentrus bullisi": "سمكة السنجاب للمياه العميقة (سمكة سنجاب توجد من ساوث كارولينا إلى برمودا وخليج المكسيك)",
 "holocentrus coruscus": "سمكة السنجاب المرجانية (توجد في الشعاب المرجانية من برمودا وفلوريدا إلى شمال أمريكا الجنوبية)",
 "holocephalan": "كاملات الرؤوس (سمك ذو رأس مضغوط عالٍ وجسم يتناقص تدريجياً إلى ذيل طويل)",
 "holocephalian": "كاملات الرؤوس (سمك ذو رأس مضغوط عالٍ وجسم يتناقص تدريجياً إلى ذيل طويل)",
 "holodomor": "هُولُودُومُور",
 "hologram": "صورة ثلاثية الأبعاد, هولوغرام (الصورة الوسيطة (أو السجل الفوتوغرافي) التي تحتوي على معلومات لإعادة إنتاج صورة ثلاثية الأبعاد عن طريق التصوير المجسم)",
 "holograph": "صورة ثلاثية الأبعاد, هولوغرام (الصورة الوسيطة (أو السجل الفوتوغرافي) التي تحتوي على معلومات لإعادة إنتاج صورة ثلاثية الأبعاد عن طريق التصوير المجسم) / مخطوطة (كتاب أو وثيقة مكتوبة بخط اليد)",
 "holographic": "هُولُوغْرَافِيّ (مكتوب بالكامل بخطّ يد المُوَقِّع) / بخط اليد (مكتوب بالكامل بخط يد الشخص نفسه) / تجسيمي, هولوغرافي (من أو يتعلق بالهولوغرافيا أو الهولوغرام)\nمثال: وثيقة بخط اليد",
 "holographical": "بخط اليد (مكتوب بالكامل بخط يد الشخص نفسه)\nمثال: وثيقة بخط اليد",
 "holography": "تصوير مجسم, هولوغرافيا (فرع البصريات الذي يتعامل مع استخدام الضوء المتماسك من الليزر لعمل صورة ثلاثية الأبعاد)",
 "holometabola": "كاملات التحول (حشرات تخضع لتحول كامل)",
 "holometabolic": "كَامِلُ التَّحَوُّل ((لِلْحَشَرَات) يَمُرُّ بِتَحَوُّلٍ كَامِل)",
 "holometabolism": "تحول كامل (تحول كامل في الحشرات)",
 "holometabolous": "كَامِلُ التَّحَوُّل ((لِلْحَشَرَات) يَمُرُّ بِتَحَوُّلٍ كَامِل)",
 "holometaboly": "تحول كامل (تحول كامل في الحشرات)",
 "holonym": "اسم الكل (كلمة تسمي الكل الذي تُعد كلمة أخرى جزءاً منه)\nمثال: 'قبعة' هي اسم الكل لـ 'حافة' و 'تاج'",
 "holonymy": "عَلَاقَة الكُلّ بِالجُزْء (العلاقة الدلالية التي تربط بين الكل وأجزائه)",
 "holophyte": "نبات ذاتي التغذية (كائن حي ينتج غذاءه بنفسه عن طريق التمثيل الضوئي)",
 "holophytic": "نَبَاتِيّ التَّغْذِيَة (الحصول على الغذاء كما تفعل النباتات الخضراء)",
 "holothuria edulis": "خيار البحر الصالح للأكل (من السواحل الدافئة من أستراليا إلى آسيا؛ يستخدم كطعام خاصة من قبل الصينيين)",
 "holothurian": "خيار البحر (شوكيات جلد لها جسم مرن يشبه النقانق ومجسات تحيط بالفم وأقدام أنبوبية؛ تتغذى على الطين وتعيش بحرية)",
 "holotype": "عينة نمطية, عينة نموذجية (العينة الأصلية التي يتم بناءً عليها وصف نوع جديد (في البيولوجيا))",
 "holozoic": "حَيَوَانِيّ التَّغْذِيَة (الحصول على الغذاء كما تفعل الحيوانات عن طريق تناول المواد العضوية المعقدة)",
 "holstein": "فريزيان, هولشتاين (سلالة من ماشية الحليب من شمال هولندا)",
 "holstein-friesian": "فريزيان, هولشتاين (سلالة من ماشية الحليب من شمال هولندا)",
 "holster": "قِرابُ الْمُسَدََّّسِ",
 "holy": "مُقَدَّس",
 "holy city": "المدينة السماوية, المدينة المقدسة (عبارات تستخدم للإشارة إلى الجنة)\nمثال: كانت المدينة السماوية هدف كريستيان في رواية 'رحلة الحاج' لبونيان",
 "holy clover": "سانفوان, عنبريس (عشب معمر أوراسي له أزهار وردية شاحبة وقرون منحنية؛ مستوطن في بريطانيا ومراعي أمريكا الشمالية في التربة الجيرية؛ محصول علف مهم ومصدر للعسل في بريطانيا)",
 "holy communion": "تَنَاوُل, إِفْخَارِيسْتِيَا (فعل مطاوعة من نَاوَلَ، ناولته فتناول؛ أخذ الشيء الذي ناولته إياه؛ الطعام والدواء: أكَلَه)\nمثال: تناول سامي سما.",
 "holy day": "عطلة دينية, يوم مقدس (يوم محدد للاحتفال الديني)",
 "holy day of obligation": "يوم واجب ديني (يوم يجب على الكاثوليك حضور القداس فيه والامتناع عن العمل الشاق، ويجب على الأسقفيين تناول القربان)",
 "holy eucharist": "الإفخارستيا, القربان المقدس (سر مسيحي يحيي ذكرى العشاء الأخير بتكريس الخبز والنبيذ)",
 "holy family": "اَلْعائِلةُ ٱلْمُقَدَّسةُ",
 "holy father": "بابا, حبر أعظم (رئيس الكنيسة الكاثوليكية الرومانية)",
 "holy innocents' day": "28 ديسمبر, عيد الأبرياء (28 ديسمبر، يحيي ذكرى ذبح هيرودس لأطفال بيت لحم)",
 "holy joe": "قسيس عسكري, مرشد ديني عسكري (قسيس في إحدى الخدمات العسكرية)",
 "holy land": "اَلْأَرْض اَلْمُقَدَّسَة",
 "holy man": "رجل صالح, ولي (رجل ذو قداسة استثنائية)",
 "holy of holies": "قدس الأقداس ((اليهودية) مزار مقدس يتكون من الغرفة الداخلية للمسكن في هيكل سليمان حيث كان يُحفظ تابوت العهد) / قُدْس الأَقْدَاس ((مجازياً) شيء يعتبر مقدساً أو لا يجوز انتهاكه)\nمثال: كل سياسي يخشى المساس بقدس الأقداس، نظام الضمان الاجتماعي",
 "holy oil": "زيت مقدس, ميرون (مرهم مكرس يتكون من خليط من الزيت والبلسم)",
 "holy order": "سر الكهنوت (سر السيامة الكهنوتية) / درجة كهنوتية, رتبة دينية ((عادة جمع) الوضع أو الرتبة أو المنصب لرجل دين مسيحي في تسلسل هرمي كنسي)\nمثال: لا يزال اللاهوتيون يختلفون حول ما إذا كان 'الأسقف' يجب أن يكون رتبة منفصلة أم لا",
 "holy person": "شخص مقدس, قديس (شخص يتمتع بقداسة استثنائية)",
 "holy place": "حرم, مكان مقدس (مكان مقدس للحج)",
