{
 "hearing dog": "كلب سمع (كلب مدرب لمساعدة الصم عن طريق الإشارة إلى حدوث أصوات معينة)",
 "hearing examiner": "فاحص جلسة الاستماع, مسؤول جلسة الاستماع (مسؤول تعينه وكالة حكومية لإجراء تحقيق أو جلسة استماع إدارية لتتمكن الوكالة من ممارسة سلطاتها القانونية)",
 "hearing impairment": "اضطراب السمع, ضعف السمع (قصور في حاسة السمع)",
 "hearing loss": "صمم, فقدان السمع (فقدان جزئي أو كلي للسمع)",
 "hearing officer": "فاحص جلسة الاستماع, مسؤول جلسة الاستماع (مسؤول تعينه وكالة حكومية لإجراء تحقيق أو جلسة استماع إدارية لتتمكن الوكالة من ممارسة سلطاتها القانونية)",
 "hearing-impaired": "ثَقِيلُ السَّمْعِ, ضَعِيفُ السَّمْعِ (لديه فقدان جزئي في السمع)",
 "hearsay": "بِالتَّنَاقُل, سَمَاعِيّ (مَسْمُوع عَنْ طَرِيق آخَرِين وَلَيْسَ مُبَاشَرَةً) / إشاعة, شائعة (قيل وقال (عادة مزيج من الحقيقة والأكاذيب) ينتقل عبر الكلام الشفهي)",
 "hearsay evidence": "دليل نقلي, شهادة السمع (دليل يستند إلى ما أخبر به شخص ما الشاهد وليس على معرفة مباشرة)",
 "hearsay rule": "قَاعِدَة اسْتِبْعَاد الْإِشَاعَات, قَاعِدَة الْإِشَاعَات (قاعدة تعلن عدم قبول أي بيان كدليل غير ذلك الصادر عن الشاهد نفسه)",
 "hearse": "سَيَّارة نَقْل مَوْتَى, عَرَبة نَقْل مَوْتَى (مؤنث سَيَّار، صفة للكثير السَيْر؛ القَافِلَة أوالقَوْم الذين يسيرون)\nمثال: إنه يملك سيارة.",
 "heart": "قَلْب, فُؤَاد / قَلْب / كُبَّا",
 "heart and soul": "قلباً وقالباً (بإيمان كامل) / جوهر, خلاصة (الجزء المختار أو الأكثر أهمية أو حيوية في فكرة أو تجربة ما)\nمثال: كانت معه قلباً وقالباً",
 "heart attack": "اِحْتِشَاء قَلْبِيّ, احتشاء عضلة القلب",
 "heart block": "إحصار القلب, حصار أذيني بطيني (نوبات مفاجئة متكررة من فقدان الوعي ناجمة عن ضعف توصيل الإشارة التي تنظم ضربات القلب)",
 "heart cherry": "كرز قلبي (كرز حلو كبير على شكل قلب ذو لحم طري) / كرز القلب, كرز قلب الثور (أي من عدة أنواع من الكرز الحلو المزروع له ثمار حلوة عصيرية على شكل قلب)",
 "heart disease": "اعتلال القلب, مرض القلب (مرض يصيب القلب)",
 "heart failure": "قُصُور القَلْب, فَشَل القَلْب",
 "heart line": "خط الحب, خط القلب (تجعد في راحة اليد؛ يقال في قراءة الكف أنه يشير إلى الطبيعة العاطفية)",
 "heart massage": "تدليك القلب (إجراء طارئ يستخدم الضغط الإيقاعي للقلب (إما من خلال جدار الصدر أو مباشرة على القلب أثناء الجراحة) في محاولة للحفاظ على الدورة الدموية أثناء السكتة…)",
 "heart monitor": "جهاز مراقبة القلب (جهاز إلكتروني للمراقبة المستمرة لوظيفة القلب)",
 "heart murmur": "لغط القلب, نفخة قلبية (صوت غير طبيعي للقلب؛ أحياناً يكون علامة على وظيفة غير طبيعية لصمامات القلب)",
 "heart muscle": "عضلة قلبية (النسيج العضلي للقلب؛ متكيف للانقباض الإيقاعي المستمر)",
 "heart of palm": "جُمَّار, قَُِلْب",
 "heart pea": "بازلاء القلب, كرمة البالون (نبات متسلق معمر خشبي ذو قرون بذور زينة كبيرة تشبه البالونات؛ الهند الاستوائية وإفريقيا وأمريكا)",
 "heart rate": "مُعَدَّل النَّبْض, مُعَدَّل ضَرَبَات القَلْب (المعدل الذي ينبض به القلب؛ يقاس عادة للحصول على تقييم سريع لصحة الشخص)",
 "heart rhythm": "إِيقَاع القَلْب (إيقاع ضربات القلب)",
 "heart specialist": "أخصائي قلب, جراح قلب (أخصائي في طب القلب؛ متخصص في بنية ووظيفة واضطرابات القلب)",
 "heart surgeon": "أخصائي قلب, جراح قلب (أخصائي في طب القلب؛ متخصص في بنية ووظيفة واضطرابات القلب)",
 "heart surgery": "جراحة القلب (أي إجراء جراحي يتعلق بالقلب)",
 "heart urchin": "قنفذ القلب (قنفذ بحر له جسم على شكل قلب في صدفة شائكة صلبة)",
 "heart valve": "صمام قلب (زرعة تحل محل صمام قلبي طبيعي) / صمام قلبي (صمام للتحكم في تدفق الدم في اتجاه واحد)",
 "heart ventricle": "بطين, بطين القلب (حجرة في القلب تتلقى الدم من الأذين وتضخه إلى الشرايين)",
 "heart-healthy": "صِحِّيّ لِلْقَلْب, مُفِيد لِلْقَلْب (قليل الدهون والصوديوم والمكوّنات التي قد تُسبِّب أمراض القلب)",
 "heart-leaf": "ورقة القلب (نبات معمر دائم الخضرة منخفض النمو ذو أوراق قلبية الشكل لاذعة ومرقطة بالأخضر والرمادي الفضي؛ من فرجينيا إلى كارولينا الجنوبية) / أصاروم, ورقة القلب (زنجبيل بري له أوراق دائمة على شكل قلب وحريفة؛ من فيرجينيا الغربية إلى ألاباما)",
 "heart-leaved aster": "أستر قلبي الأوراق (أستر غابات معمر من شرق أمريكا الشمالية)",
 "heart-lung machine": "جهاز القلب والرئة (مضخة للحفاظ على الدورة الدموية أثناء جراحة القلب؛ تحول الدم من القلب وتؤكسده ثم تضخه عبر الجسم)",
 "heart-shaped": "قَلْبِيّ الشَّكْل ((عن الورقة) على شكل قلب)",
 "heart-to-heart": "صَرِيح, مُبَاشِر (صريح ومباشر بلا تحفظ أو مواربة) / حديث من القلب للقلب, مصارحة (حديث حميم على انفراد)\nمثال: أخذني جانباً لحديث من القلب للقلب",
 "heart-whole": "كُلِّيّ الإِخْلَاص, مُخْلِص (بِتَفَانٍ وَحَمَاسَة غَيْر مَشْرُوطَيْن)",
 "heartache": "حزن شديد, فجيعة (أسى شديد ناتج عن فقدان شخص محبوب (خاصة بالموت))",
 "heartbeat": "نَبْض, نَبْضُ القَلْب",
 "heartbreak": "حزن شديد, فجيعة (أسى شديد ناتج عن فقدان شخص محبوب (خاصة بالموت))",
 "heartbreaker": "خسارة مفجعة (هزيمة بفارق ضئيل أو هزيمة في اللحظة الأخيرة) / خَاطِف الْقُلُوب, مُحَطِّم الْقُلُوب (شخص ساحر ولكنه غير مسؤول في العلاقات العاطفية)",
 "heartbreaking": "مُحْزِن, مُفْجِع (يسبب أو يتسم بالحزن الشديد أو الكرب)",
 "heartbroken": "كَسِير الْقَلْب",
 "heartburn": "حُرْقَة الْمَعِدَة, حموضة معوية",
 "heartburning": "حرقان قلب, غيرة شديدة (استياء شديد)\nمثال: ترقيته تسببت في الكثير من الغيرة بين منافسيه",
 "heartening": "بَاعِثٌ لِلأَمَل, مُبَشِّر (يُشجِّع بطريقة تبعث البهجة والأمل)",
 "heartfelt": "حَارّ, صَمِيمِيّ (صَادِق وَجَادّ فِي المَشَاعِر)",
 "hearth": "كانون",
 "hearth money": "بنس بطرس, ضريبة الموقد (مساهمة سنوية يقدمها الروم الكاثوليك لدعم الكرسي الرسولي)",
 "hearthrug": "سجادة الموقد (سجادة تفرش أمام المدفأة)",
 "hearthstone": "حجر الموقد (حجر يشكل الموقد)",
 "heartily": "بحماس, بقلب قوي (بمتعة ودون تحفظ) / بحرارة, بقلب خالص (بطريقة قلبية)\nمثال: ألقى الصبي بنفسه بحماس في عمله",
 "heartiness": "إخلاص قلبي, حرارة (صفة الإخلاص القلبي الحار) / حيوية, نشاط (قوة نشطة للجسد أو العقل)",
 "heartland": "قلب البلاد, معقل (المنطقة المركزية لبلد أو قارة؛ وخاصة المنطقة المهمة لبلد أو ثقافة ما)",
 "heartleaf": "ورقة القلب (نبات معمر دائم الخضرة منخفض النمو ذو أوراق قلبية الشكل لاذعة ومرقطة بالأخضر والرمادي الفضي؛ من فرجينيا إلى كارولينا الجنوبية) / أصاروم, ورقة القلب (زنجبيل بري له أوراق دائمة على شكل قلب وحريفة؛ من فيرجينيا الغربية إلى ألاباما)",
 "heartleaf arnica": "أرنيكا قلبية الأوراق (زهرة برية ذات أوراق على شكل قلب ورؤوس زهرية صفراء عريضة؛ توجد في مناطق جبال الألب غرب جبال الروكي من ألاسكا إلى جنوب كاليفورنيا)",
 "heartleaf manzanita": "مانزانيتا قلبية الأوراق (شجيرة كاليفورنية قائمة لها أوراق ذات فصوص قلبية الشكل عند القاعدة)",
 "heartless": "عديم الرحمة, قاسي القلب (يفتقر إلى الشعور أو الشفقة أو الدفء) / فَاقِدُ الشَّجَاعَة (خالٍ من الشجاعة أو الحماس)",
 "heartlessly": "بقسوة, بلا قلب (بطريقة خالية من الرحمة)\nمثال: تتصرف بقسوة إلى حد ما تجاه معجبيها",
 "heartlessness": "غلظة, قسوة القلب (غياب الاهتمام برفاهية الآخرين)",
 "heartrending": "مُحْزِن, مُفْجِع (يسبب أو يتسم بالحزن الشديد أو الكرب)",
 "heartrot": "عفن القلب (أي مرض نباتي يتعفن فيه الجزء المركزي من النبات (خاصة في الأشجار))",
 "hearts": "كُبَّا / كُوبَة",
 "heartsease": "راحة بال, سلام (غياب التوتر العقلي أو القلق) / بانسي الحقل (فيولا شائعة في العالم القديم ذات أزهار كريمية غالباً ما تكون مشوبة باللون البنفسجي) / بنفسج ذو العينين (بنفسج من ساحل المحيط الهادئ لأمريكا الشمالية له بتلات بيضاء مشوبة بالأصفر والبنفسجي العميق) / بانسي بري, زهرة الثالوث البرية (عشبة أوروبية شائعة ومزروعة منذ فترة طويلة تشتق منها معظم زهور البانسي الشائعة في الحدائق)",
 "heartseed": "كرمة القلب, نبات القلب (كرمة عشبية من أمريكا الاستوائية وإفريقيا)",
 "heartsick": "قَنُوط, مَكْسُور القَلْب (بلا أمل أو يكاد يكون بلا أمل) / مَكْسُور الخَاطِر, مُنْكَسِر القَلْب (مليء بالحزن والأسى)",
 "heartsickness": "انكسار, قنوط (الشعور بالإحباط واليأس وتثبيط الهمة)",
 "heartstrings": "أوتار القلب, شغاف القلب (أعمق مشاعر الحب والرحمة لديك)\nمثال: العديد من حالات التبني تلامس شغاف القلب",
 "heartthrob": "فارس الأحلام, معشوق (محط إعجاب وشغف عاطفي)",
 "heartwarming": "دَافِئ, مُفْرِح (يبعث على السرور والبهجة في القلب)",
 "heartwood": "خشب القلب (هو ما غَلَظَ وصَلُبَ من أصول الشَجَر وفروعها مثل الجِذْع والأغْصَان؛ هو ما صنع من جذوع أو أغصان الشَجَر)\nمثال: نحن نقطع الخشب.",
 "hearty": "حَمِيم, عَمِيق (عميق الإحساس وصادق المشاعر) / جَلْد, قَوِيّ (ذو صِحَّة قَوِيَّة وطاقَة عالِيَة) / فَتِيّ, مِلْؤُه الحَيَوِيَّة (مَليء بِالقُوَّة والنَّشاط والحَيَوِيَّة الدَّمَوِيَّة) / حَارّ, صَادِق (يُظهر ودًّا حارًّا وصادقًا نابعًا من القلب)",
 "heat": "حَرَارَة (السخونة والحماوة؛ شدة العَطَش) / حَرَارَة, سُخُونَة (السخونة والحماوة؛ شدة العَطَش) / سَخَّنَ, أَحَرَّ (حمي وأصبح حارا)\nمثال: حرارة الطقس تتزايد.",
 "heat barrier": "حاجز حراري (حد لسرعة الطيران العالية يفرضه التسخين الديناميكي الهوائي)",
 "heat capacity ratio": "نِسْبَة السِّعَة الحَرَارِيَّة (نسبة السعة الحرارية عند ضغط ثابت إلى السعة الحرارية عند حجم ثابت)",
 "heat content": "إنثالبي, محتوى حراري (كمية ديناميكية حرارية تساوي الطاقة الداخلية للنظام زائد حاصل ضرب حجمه وضغطه)\nمثال: المحتوى الحراري هو مقدار الطاقة في النظام القادر على القيام بعمل ميكانيكي",
 "heat dissipation": "تبديد الحرارة (تبديد الحرارة)",
 "heat energy": "حرارة, طاقة حرارية (شكل من أشكال الطاقة يتم نقله عن طريق اختلاف في درجة الحرارة)",
 "heat engine": "محرك حراري (أي محرك يستخدم الحرارة للقيام بعمل)",
 "heat exchanger": "مبادل حراري (جهاز ينقل الحرارة من سائل إلى آخر دون السماح باختلاطهما)",
 "heat exhaustion": "إنهاك حراري (حالة تتميز بالدوخة والغثيان والضعف الناجم عن استنزاف سوائل الجسم والشوارد)",
 "heat flash": "وميض حراري (وميض حراري شديد (كما ينبعث من انفجار ذري))",
 "heat hyperpyrexia": "ضربة شمس, فرط الحرارة (انهيار ناتج عن التعرض للحرارة المفرطة)",
 "heat lamp": "مصباح أشعة تحت الحمراء, مصباح حراري (سخان كهربائي يتكون من مصباح متوهج عالي الطاقة يبعث أشعة تحت الحمراء)\nمثال: يمكن تدفئة الحمام بواسطة مصباح أشعة تحت الحمراء",
 "heat lightning": "برق الحر, برق صيفي (ومضات ضوئية ساطعة بالقرب من الأفق دون رعد (خاصة في الأمسيات الحارة)؛ تُعزى عادة إلى برق بعيد تعكسه السحب)",
 "heat of condensation": "حرارة التكثف (حرارة تتحرر بواسطة وحدة كتلة من الغاز عند نقطة غليانه عندما يتكثف إلى سائل)\nمثال: حرارة التكثف تساوي حرارة التبخر",
 "heat of dissociation": "حرارة التفكك (الحرارة اللازمة لمادة سائلة لتتفكك إلى مكونات أبسط)",
 "heat of formation": "حرارة التشكل (الحرارة المنبعثة أو الممتصة أثناء تشكيل مول واحد من مادة من عناصرها المكونة)",
 "heat of fusion": "حرارة الانصهار (حرارة تمتصها وحدة كتلة من مادة صلبة عند نقطة انصهارها لتحويل المادة الصلبة إلى سائل عند نفس درجة الحرارة)\nمثال: حرارة الانصهار تساوي حرارة التجمد",
 "heat of solidification": "حرارة التجمد, حرارة التصلب (حرارة تتحرر بواسطة وحدة كتلة من سائل عند نقطة تجمده عندما يتصلب)",
 "heat of solution": "حرارة المحلول (الحرارة المنبعثة أو الممتصة عند إذابة مول واحد من مادة في حجم كبير من المذيب)",
 "heat of sublimation": "حرارة التسامي (حرارة تمتصها وحدة كتلة من مادة عندما تتغير من حالة صلبة إلى غازية)",
 "heat of transformation": "حرارة التحول, حرارة كامنة (حرارة ممتصة أو مشعة أثناء تغير الطور عند درجة حرارة وضغط ثابتين)",
 "heat of vaporisation": "حرارة التبخر (حرارة تمتصها وحدة كتلة من مادة عند نقطة غليانها لتحويل المادة إلى غاز عند نفس درجة الحرارة)",
 "heat of vaporization": "حرارة التبخر (حرارة تمتصها وحدة كتلة من مادة عند نقطة غليانها لتحويل المادة إلى غاز عند نفس درجة الحرارة)",
 "heat prostration": "إنهاك حراري (حالة تتميز بالدوخة والغثيان والضعف الناجم عن استنزاف سوائل الجسم والشوارد)",
 "heat pump": "مضخة حرارية (جهاز يستخرج الحرارة من سائل ذي درجة حرارة أعلى من محيطه؛ يمكن استخدامه لنقل الحرارة من خزان خارجي لتدفئة مبنى)",
 "heat rash": "حمو النيل, طفح حراري (انسداد القنوات العرقية أثناء الحرارة العالية والرطوبة)",
 "heat ray": "شعاع حراري (شعاع ينتج تأثيراً حرارياً)",
 "heat shield": "درع حراري (غطاء واقٍ يحمي المركبة الفضائية من السخونة المفرطة عند العودة للغلاف الجوي)",
 "heat sink": "مبدد حراري (موصل معدني مصمم خصيصاً لتوصيل (وإشعاع) الحرارة)",
 "heat stroke": "رَعْن, ضَرْبَة شَمْس ((رَعُنَ) رَعَنًا، ورُعونةً: رَعَنَ)",
 "heat unit": "وحدة حرارة, وحدة شغل (وحدة لقياس الشغل أو الطاقة)",
 "heat up": "سَخَّنَ (حمي وأصبح حارا)\nمثال: سخن زيري الماء.",
 "heat wave": "مَوْجَة اَلْحَرّ",
 "heat-absorbing": "ماص للحرارة ((عن تفاعل كيميائي أو مركب) يحدث أو يتشكل مع امتصاص للحرارة)",
 "heat-releasing": "باعث للحرارة, ناشر للحرارة ((عن تفاعل كيميائي أو مركب) يحدث أو يتشكل مع تحرير للحرارة)",
 "heat-resistant": "مَانِع لِلْحَرَارة",
 "heat-seeking missile": "صاروخ حراري (صاروخ مزود بنظام توجيه يوجهه نحو الأهداف التي تبعث أشعة تحت الحمراء (مثل انبعاثات المحرك النفاث))",
 "heatable": "قَابِل لِلتَّسْخِين (يمكن أن يصبح ساخناً)",
 "heated": "مُسَخَّن (جُعِل دافئاً أو ساخناً) / حَامٍ, مُحْتَدِم (يتّسم بالحدّة العاطفيّة؛ عنيف)",
 "heated up": "مُسَخَّن (جُعِل دافئاً أو ساخناً)",
 "heatedly": "باحتدام, بحدة (بطريقة محتدمة)\nمثال: أعلن السيد هارفي باحتدام: القول بأنني وراء الإضراب هو محض هراء",
 "heater": "مِدْفَأَة",
 "heath": "أرض الخلنج (قطعة أرض بور مستوية؛ أرض غير مزروعة ذات تربة رملية ونباتات شجيرية) / خلنج, هيذر (شجيرة دائمة الخضرة منخفضة من العائلة الخلنجية؛ لها أزهار صغيرة وردية أو أرجوانية على شكل جرس)",
 "heath aster": "أستر الخلنج (نبات معمر شائع في أمريكا الشمالية بأوراق تشبه الخلنج ورؤوس زهور بيضاء صغيرة) / أستر الخلنج (نبات معمر شائع كثير التفرع في أمريكا الشمالية بأوراق تشبه الخلنج وزهور بيضاء صغيرة تشبه النجوم)",
 "heath hen": "دجاجة الطيهوج الرمادية (أنثى الطيهوج الأسود) / دجاجة الخلنج (دجاجة براري منقرضة)",
 "heath pea": "بسلة الأرض, جلبان درني (عشب أوروبي يحمل درنات صغيرة تستخدم للغذاء وفي اسكتلندا لتنكيه الويسكي)",
 "heath violet": "بنفسج الكلب (بنفسج أزرق الأزهار مورق الساق من العالم القديم)",
 "heathen": "وَثَنِيّ / وَثَنِيّ, وَثَنِيَّة",
 "heathenish": "وَثَنِيّ (لا يعترف بإله الأديان السماويّة)",
 "heathenism": "وثنية (أي من الأديان المختلفة غير المسيحية أو اليهودية أو الإسلام)",
 "heather": "خَلَنْج",
 "heather bell": "خلنج جرسي, خلنج ناعم الأوراق (شجيرة أوروبية منخفضة شائعة بزهور أرجوانية حمراء)",
 "heather mixture": "خليط أرقط, نسيج مرقط (خيوط متداخلة من ألوان مختلطة تنتج ظلالاً رمادية هادئة مع بقع ملونة)",
 "heathfowl": "طيهوج أسود أوروبي (طيهوج كبير من شمال أوروبا أسود اللون وذيله على شكل قيثارة)",
 "heathland": "أرض الخلنج (قطعة أرض بور مستوية؛ أرض غير مزروعة ذات تربة رملية ونباتات شجيرية)",
 "heathlike": "خلنجي, شبه خلنجي (يشبه نبات الخلنج)",
 "heathrow": "هِيثْرُو",
 "heating": "تَدْفِئَة",
 "heating element": "عنصر تسخين (مكون في سخان أو موقد يحول الوقود أو الكهرباء إلى حرارة)",
 "heating oil": "زيت الوقود, مازوت (منتج بترولي يُستخدم كوقود)",
 "heating pad": "وسادة تدفئة (سخان يتكون من عناصر تسخين كهربائية موجودة في وسادة مرنة)",
 "heating plant": "تدفئة, نظام تدفئة (مرفق لتدفئة مبنى)\nمثال: لم يكن نظام التدفئة يعمل",
 "heating system": "تدفئة, نظام تدفئة (مرفق لتدفئة مبنى)\nمثال: لم يكن نظام التدفئة يعمل",
 "heatless": "عَدِيم الحَرَارَة (لا يُولِّد حرارة)",
 "heatstroke": "ضربة شمس, فرط الحرارة (انهيار ناتج عن التعرض للحرارة المفرطة)",
 "heaume": "خوذة الفارس العظيمة, خوذة كبيرة (خوذة كبيرة من العصور الوسطى تستند على الكتفين)",
 "heave": "رمي ثقيل, قذف بجهد (رمي شيء ثقيل (بجهد كبير)) / رفع (فعل رفع شيء ما) / تقيؤ جاف, تهوع (تشنج لا إرادي لمحاولة التقيؤ دون جدوى) / رفع بجهد (فعل رفع شيء بجهد كبير)\nمثال: أعطاها دفعة قوية",
 "heaven helps those who help themselves": "اسعى يا عبدي وأنا أسعى معاك",
 "heaven-sent": "رَبَّانِيّ, مِنْ عِنَايَةِ السَّمَاء (مُنَاسِبٌ أَوْ مَحْظُوظٌ بِشَكْلٍ اسْتِثْنَائِيٍّ كَأَنَّمَا بِتَدَخُّلٍ إِلَهِيٍّ)",
 "heavenly": "سَمَاوِيّ",
 "heavenly body": "جِرْم سَمَاوِيّ, جِرْم فَلَكِيّ (جَرَم الشَّخْصُ: أَذْنَبَ وَاكتَسَبَ الإِثْمَ؛ جَرَم نفسَه / جَرَم قومَه / جَرَم على / جَرَم على قومه: جَنَى جَنَايَةً)\nمثال: الإهمال هو نوع من الضرر أو الجرم",
 "heavenly city": "المدينة السماوية, المدينة المقدسة (عبارات تستخدم للإشارة إلى الجنة)\nمثال: كانت المدينة السماوية هدف كريستيان في رواية 'رحلة الحاج' لبونيان",
 "heavens": "سَمَاوَات",
 "heavenward": "نحو السماء (باتجاه السماء) / مُتَّجِهٌ نَحْوَ السَّمَاء (مُوَجَّهٌ نَحْوَ السَّمَاءِ أَوِ الأُفُقِ العُلْوِيّ)\nمثال: أشار نحو السماء",
 "heavenwardly": "نحو السماء (باتجاه السماء)\nمثال: أشار نحو السماء",
 "heavenwards": "نحو السماء (باتجاه السماء)\nمثال: أشار نحو السماء",
 "heaver": "عتلة, قضيب رفع (قضيب يستخدم كرافعة (كما في جدل الحبال)) / حمّال, عتال (عامل يرفع البضائع أو البضائع السائبة (خاصة في حوض بناء السفن))",
 "heaves": "نفس مقطوع (انتفاخ رئوي مزمن للحصان يسبب صعوبة في الزفير وارتفاع الخاصرتين)",
 "heavier-than-air": "أَثْقَل مِن الهَواء (أثْقَل مِن الهَواء الَّذي يُزيحُه (عَن الطَّائِرات))",
 "heavier-than-air craft": "مركبة أثقل من الهواء (طائرة غير طافية تتطلب مصدراً للطاقة لإبقائها مرتفعة ولدفعها)",
 "heavily": "بثقل, بشكل كبير (بدرجة كبيرة) / بإفراط, بشراهة (الانغماس بإفراط) / بثقل, بصعوبة (بطريقة مجهدة) / بثقل (ببطء كما لو كان مثقلاً بوزن كبير)\nمثال: اعتمد بشكل كبير على بيانات الآخرين",
 "heavily traveled": "كَثِير الاِزْدِحَام, مَطْرُوق بِكَثَافَة (يتعرض لكثير من حركة المرور أو السفر)",
 "heaviness": "ثِقَل (ثَقَلَ الشيءَ يَثْقُلُه بِيَدِهِ ثَقْلًا: رَازَ ثِقَلَه؛ ثَقَلَ الشَّيْء بِيَدِهِ ثقلا قدّر ثِقْلَه)\nمثال: ان ثقل ما تحمل، فضع بعضا منه.",
 "heaving": "رمي ثقيل, قذف بجهد (رمي شيء ثقيل (بجهد كبير)) / رفع بجهد (فعل رفع شيء بجهد كبير) / لهاث (التنفس بصعوبة وثقل (كما يحدث بعد المجهود)) / تمايل, تموج (حركة تصاعدية (خاصة الارتفاع والانخفاض الإيقاعي))\nمثال: أعطاها دفعة قوية",
 "heaving line": "حبل الرمي (حبل خفيف الوزن مزود بوزن في نهايته، يُلقى بين سفينتين أو بين سفينة والشاطئ لسحب حبل أثقل)\nمثال: غالباً ما تُستخدم عقدة قبضة القرد كوزن في حبل الرمي",
 "heavy": "ثَقِيل",
 "heavy cream": "كريمة ثقيلة (تحتوي على أكثر من 36% من دهن الزبدة)",
 "heavy hitter": "مؤثر قوي (شخص مؤثر يعمل بجد لترويج القضايا التي يهتم بها)",
 "heavy hydrogen": "ديوتيريوم, هيدروجين ثقيل (نظير للهيدروجين يحتوي على نيوترون واحد (مقارنة بعدم وجود نيوترونات في الهيدروجين العادي))",
 "heavy industry": "صناعات ثقيلة",
 "heavy lifting": "عبء ثقيل, عمل شاق\nمثال: أمل الرئيس أن تنجح الخطة لكنه لم يكن مستعداً للقيام بالعمل الشاق (عِبْء: اسم؛ الحمل الثقيل. \"يحمل على كاهله عبأً\")",
 "heavy metal": "مُوسِيقَى الْمِيتَال (مُوسِيقى، فنُّ تأليف الألحان وتوزيعها وإيقاعها والغناء والتطريب بضروب المعازف؛ علم الموسيقى : علمٌ يُبحَثُ فيه عن أُصَول النغم من حيث تأَتلف أَو تتنافر، وأَحوال الأَزمنة المتخللة بينها، ليُعلَمَ كيف يؤلَّف اللَّحْن) / هيفي ميتال\nمثال: أتعلم الموسيقى.",
 "heavy metal music": "موسيقى الميتال, هيفي ميتال (موسيقى روك صاخبة وقاسية الصوت ذات إيقاع قوي؛ تتضمن الكلمات عادة صوراً عنيفة أو خيالية)",
 "heavy particle": "بَارِيُون (أي من الجسيمات الأولية التي لها كتلة مساوية أو أكبر من كتلة البروتون وتشارك في التفاعلات القوية؛ هادرون ذو عدد باريوني +1)",
 "heavy spar": "باريت, باريتا",
 "heavy swell": "تموج عميق, موج عظيم (تموج واسع وعميق للمحيط)",
 "heavy syllable": "مقطع ثقيل (مقطع صوتي ذو نواة متفرعة أو قافية متفرعة)",
 "heavy torpedo": "طوربيد ثقيل (طوربيد يحمل رأساً حربياً لا يقل وزنه عن 450 كجم، ويستخدم بشكل أساسي كسلاح بعيد المدى، خاصة بواسطة الغواصات المغمورة)\nمثال: على الرغم من سهولة التعامل مع الطوربيدات الخفيفة، إلا أن نقل والتعامل مع الطوربيدات الثقيلة أمر صعب، خاصة في المساحة الصغيرة للغواصة",
 "heavy water": "أكسيد الديوتيريوم, ماء ثقيل (ماء يحتوي على نسبة كبيرة من ذرات الديوتيريوم، يستخدم في المفاعلات النووية)",
 "heavy weapon": "سلاح ثقيل, مدفعية (تسليح كبير ولكن قابل للنقل)",
 "heavy whipping cream": "كريمة خفق ثقيلة, كريمة مزدوجة (كريمة تحتوي على نسبة دهون 48% أو أكثر)",
 "heavy-armed": "ضَخْمُ الذِّرَاعَيْن (ذو ذراعَيْن ضخمتَيْن)",
 "heavy-coated": "مُرْتَدٍ مِعْطَفاً ثَقِيلاً (يرتدي معطفاً ثقيلاً)",
 "heavy-duty": "شديد التحمل, للمهام الشاقة (مصمم للعمل الشاق)\nمثال: منظف للمهام الشاقة",
 "heavy-footed": "ثقيل الخطى ((للحركة) يفتقر إلى السهولة أو الخفة)\nمثال: مشيته المتعبة ثقيلة الخطى",
 "heavy-handed": "أَخْرَق اليَدَيْن, ثَقِيل اليَد (يفتقر إلى مهارات الحركة الجسدية وخاصة في استخدام اليدين) / بَاطِش, غَاشِم (مُتَسَلِّط بِظُلْم)",
 "heavy-handedness": "ثقل يد, غلاظة (صفة الخرق والافتقار للبراعة، وبالتالي المبالغة غير المتقنة)",
 "heavy-laden": "مُثْقَل, مُحَمَّل (يحمل عبئاً مادياً ثقيلاً) / مُثْقَل بِالهُمُوم (يحمل أعباءً ثقيلة من الهموم)",
 "heavy-limbed": "ثَقِيل الأَطْرَاف (ذو أَطْراف غَليظَة وَثَقيلَة)",
 "heavyhearted": "كَسِير, مُثْقَل القَلْب (مكتئب ومُثقل بالهمّ)",
 "heavyheartedness": "انقباض الصدر, كآبة (شعور بالكآبة المثبطة للهمة)",
 "heavyset": "مَتِين البُنْيَة, مُمْتَلِئ الجِسْم (ذو بنية قصيرة وصلبة)",
 "heavyweight": "جبار, عملاق (شخص ذو أهمية وسمعة استثنائية) / ضخم, عملاق (شخص كبير جداً؛ مثير للإعجاب في الحجم أو الصفات) / وزن ثقيل (ملاكم محترف يزيد وزنه عن 190 رطلاً) / وزن ثقيل (مصارع يزيد وزنه عن 214 رطلاً)",
 "heavyweight torpedo": "طوربيد ثقيل (طوربيد يحمل رأساً حربياً لا يقل وزنه عن 450 كجم، ويستخدم بشكل أساسي كسلاح بعيد المدى، خاصة بواسطة الغواصات المغمورة)\nمثال: على الرغم من سهولة التعامل مع الطوربيدات الخفيفة، إلا أن نقل والتعامل مع الطوربيدات الثقيلة أمر صعب، خاصة في المساحة الصغيرة للغواصة",
 "hebdomad": "أسبوع (أي فترة من سبعة أيام متتالية)\nمثال: أمطرت لمدة أسبوع",
 "hebdomadal": "أُسْبُوعِيّ (يتعلق بكل سبعة أيام أو يحدث كل أسبوع)",
 "hebdomadally": "أسبوعياً, كل أسبوع (دون تفويت أسبوع)\nمثال: زارت عمتها أسبوعياً",
 "hebdomadary": "أُسْبُوعِيّ (يتعلق بكل سبعة أيام أو يحدث كل أسبوع)",
 "hebei": "خِبِي, خِيبِي",
 "hebephrenia": "فصام غير منتظم, فصام مراهقة (شكل من أشكال الفصام يتميز بتفكك شديد للشخصية، بما في ذلك الكلام المضطرب والتصرفات الطفولية والسلوك الغريب؛ وعادة ما يتضح خلال فترة البلوغ؛ وهو الفئة…)",
 "hebephrenic": "هِيبِفْرِينِيّ (مصاب بنوع من الفصام يتّسم بسلوكيّات صبيانيّة وسخافة)",
 "hebephrenic schizophrenia": "فصام غير منتظم, فصام مراهقة (شكل من أشكال الفصام يتميز بتفكك شديد للشخصية، بما في ذلك الكلام المضطرب والتصرفات الطفولية والسلوك الغريب؛ وعادة ما يتضح خلال فترة البلوغ؛ وهو الفئة…)",
 "hebetude": "بلادة, خمول ذهني (خمول عقلي أو بلادة)",
 "hebraic": "عبري, عبراني (عِبْرِي بتخفيف الياء (ليست ياء النسب) مدينة صغيرة في شمال عُمَان على حدود الرَبْع الخالي)",
 "hebraic alphabet": "الأبجدية العبرية, الخط العبري (أبجدية سامية استُخدمت منذ القرن الخامس قبل الميلاد لكتابة اللغة العبرية (ولاحقاً لكتابة اليديشية واللادينو))",
 "hebraical": "عبري (من أو يتعلق بلغة العبرانيين) / عبراني (من أو يتعلق بالعبرانيين أو يميزهم)\nمثال: حروف العلة العبرية",
 "hebraism": "الديانة اليهودية, اليهودية (اليهود مجتمعين الذين يمارسون ديناً قائماً على التوراة والتلمود)",
 "hebraist": "متخصص في اللغة العبرية (لغوي متخصص في اللغة العبرية)",
 "hebraization": "عبرنة",
 "hebrew": "عِبْرَانِيّ, عِبْرِيّ",
 "hebrew alphabet": "الأبجدية العبرية, الخط العبري (أبجدية سامية استُخدمت منذ القرن الخامس قبل الميلاد لكتابة اللغة العبرية (ولاحقاً لكتابة اليديشية واللادينو))",
 "hebrew calendar": "تقويم عبري, تقويم يهودي ((اليهودية) التقويم الذي يستخدمه اليهود؛ يؤرخ من 3761 قبل الميلاد (التاريخ المفترض لخلق العالم)؛ يتم تعديل السنة القمرية المكونة من 354 يوماً لتتوافق…)",
 "hebrew language": "اللغة العبرية (اللغة الكنعانية القديمة للعبرانيين التي تم إحياؤها كلغة رسمية لإسرائيل)",
 "hebrew lesson": "درس لغة عبرية (تعليم في اللغة العبرية)",
 "hebrew script": "الأبجدية العبرية, الخط العبري (أبجدية سامية استُخدمت منذ القرن الخامس قبل الميلاد لكتابة اللغة العبرية (ولاحقاً لكتابة اليديشية واللادينو))",
 "hebrews": "الْعِبْرَانِيُّون",
 "hebridean": "هبريدي (مكون من أو متعلق بجزر الهبريدس)",
 "hebron": "الْخَلِيل / حَبْرُون",
 "hecatomb": "ذبح عظيم, هيكاتومب (تضحية كبيرة؛ تضحية يونانية أو رومانية قديمة بـ 100 ثور)",
 "heckelphone": "أوبوا باسيت, هيكلفون (أوبوا مضبوطة بأوكتاف أقل من الأوبوا العادية)",
 "heckle": "مشط الكتان, مِندَف (مشط لفصل ألياف الكتان)",
 "heckler": "مشاغب, معترض (شخص يحاول إحراج المتحدث بالسخرية والأسئلة والاعتراضات)",
 "heckling": "تشويش, مقاطعة (الصياح لمقاطعة خطاب لا توافق عليه)",
 "hectare": "هِكْتَار",
 "hectic": "مَحْمُوم, مُحْتَدِم (يتسم باضطراب أو انفعال شديد)",
