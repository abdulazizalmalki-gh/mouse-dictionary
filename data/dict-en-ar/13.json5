 "homegrown": "مَحَلِّيُّ النَّشْأَة (نَشَأَ أَوْ زُرِعَ فِي مَكَانٍ مُعَيَّنٍ)",
 "homeland": "وَطَن (أقام بالمكان وكان وَطَنا له)\nمثال: دعاها لحفلة العودة للوطن.",
 "homeland security": "وزارة الأمن الداخلي (الإدارة الفيدرالية التي تدير جميع المسائل المتعلقة بالأمن الداخلي)",
 "homeless": "مُتَشَرِّد",
 "homeless person": "بِلا مَأْوَى, مُشَرَّد (شخص سيء الحظ بدون سكن)\nمثال: عُثر على مشرد مقتولاً في سنترال بارك",
 "homelessness": "تشرد (حالة أو وضع عدم امتلاك منزل (خاصة حالة العيش في الشوارع))",
 "homelike": "أَلِيف, بَيْتِيّ (يبعث على الشعور بأجواء البيت؛ مريح ودافئ)",
 "homeliness": "بساطة المظهر, تواضع الجمال (مظهر ليس جذاباً أو جميلاً) / دَمَامَة, رَثَاثَة (امتلاك صفة رثة أو كئيبة؛ الافتقار إلى الأناقة أو الجمال)\nمثال: الملابس الفاخرة لم تستطع إخفاء تواضع جمال الفتاة",
 "homely": "دَمِيم, عَادِيّ (يفتقر إلى الجمال الجسدي أو التناسق) / أَلِيف, بَيْتِيّ (يبعث على الشعور بأجواء البيت؛ مريح ودافئ) / بَسِيط, سَاذَج (بلا تكلّف أو تصنّع في الأناقة) / غَيْر مُتَكَلَّف, مُتَوَاضِع (بسيط ومتواضع بلا تكلّف)",
 "homemade": "مَنْزِلِيّ",
 "homemaker": "رَبّ بَيْت, رَبّة بَيْت (رَبَّ الولدَ يَرُبُّ رَبًّا: ولِيَه وتعهده بما يغذيه وينميه ويؤدّبه؛ الفاعل: رَابٌّ، والمفعول: مَرْبوبٌ، وربيبٌ)\nمثال: اعتني بي يا رب.",
 "homemaking": "تدبير منزلي (إدارة الأسرة والمنزل)",
 "homeobox": "صندوق المثلية, هوموبوكس (واحد من جينات مثلية متشابهة تشارك في تجزئة الجسم أثناء التطور الجنيني)",
 "homeobox gene": "صندوق المثلية, هوموبوكس (واحد من جينات مثلية متشابهة تشارك في تجزئة الجسم أثناء التطور الجنيني)",
 "homeopath": "معالج مثلي (ممارس للمعالجة المثلية (هوميباثي))",
 "homeopathic": "تجانسي, مثلي (من أو متعلق بممارسة الطب التجانسي (المثلي))",
 "homeopathy": "مُعَالَجَة مَثَلِيَّة",
 "homeostasis": "تَجَانُس (الشيئان: أصبحا كقطعة واحدة لا ينفصل جزء عن الآخر؛ الشخصان: توائما)",
 "homeostatic": "استتبابي (متعلق بـ أو يتميز بالاستتباب (التوازن الداخلي))",
 "homeostatically": "بشكل استتبابي (بطريقة تحافظ على التوازن الداخلي (الاستتباب))\nمثال: ضغط الدم منظم استتبابياً",
 "homeotherm": "ذوات الدم الحار, كائن ثابت الحرارة (حيوان لديه درجة حرارة جسم ثابتة نسبياً ومستقلة عن درجة حرارة البيئة)",
 "homeothermic": "ثَابِت الحَرَارَة (ذو حرارة جسم ثابتة ومرتفعة نسبيًّا؛ يوصف به الطيور والثدييّات)",
 "homeotic gene": "جين مثلية, جين هوميوتيك (أحد الجينات المشاركة في التطور الجنيني)",
 "homeowner": "صاحب منزل, مالك المنزل (شخص يمتلك منزلاً)",
 "homepage": "صفحة رئيسية (الصفحة الافتتاحية لموقع ويب؛ أيضاً الصفحة الأولى التي تفتح عند تشغيل متصفح الويب (الصفحة الافتراضية أو صفحة البدء))",
 "homer": "هُومِيرُوس",
 "homeric": "هوميري (متعلق أو مميز لهوميروس أو عصره أو الأعمال المنسوبة إليه)\nمثال: اليونانية الهوميرية",
 "homeroom": "غرفة الصف الرئيسي (فصل دراسي يجتمع فيه جميع الطلاب في صف معين (أو في قسم من صف) في أوقات معينة تحت إشراف معلم يأخذ الحضور ويقوم بأعمال إدارية أخرى)",
 "homesick": "مُشْتَاقٌ لِلْوَطَن (يشتاق إلى العودة إلى الوطن)",
 "homesickness": "حَنِين, اِشْتِيَاق",
 "homespun": "مَغْزُولٌ بَيْتِيًّا (مصنوع من قماش غُزِل أو نُسِج في المنزل) / بَسِيط, شَعْبِيّ (يتّسم بطابع الحياة الريفيّة البسيطة والعفويّة) / غزل منزلي (قماش خشن فضفاض النسج صنع أصلاً من خيوط تم غزلها في المنزل)",
 "homestead": "عزبة, مسكن مع أرض (مسكن يكون عادة مزرعة وأرض مجاورة) / أرض استيطان, هومستيد (أرض تم الحصول عليها من الأراضي العامة للولايات المتحدة عن طريق تسجيل سجل والعيش عليها وزراعتها بموجب قانون الاستيطان) / الدار وما حولها, مسكن العائلة (المنزل والأراضي المجاورة التي تشغلها عائلة)",
 "homestead law": "قانون الحماية من الحجز (قانون يمنح امتيازات لأصحاب المنازل لحمايتها من الدائنين)",
 "homesteader": "مستوطن, واضع اليد (شخص يستقر بشكل قانوني على أرض حكومية بقصد الحصول على حق ملكيتها)",
 "homestretch": "الشوط الأخير, المستقيم النهائي (الامتداد المستقيم لمضمار السباق المؤدي إلى خط النهاية) / شوط أخير, مرحلة أخيرة (نهاية مشروع ما)\nمثال: كانوا في المرحلة الأخيرة عندما تعطل الكمبيوتر",
 "hometown": "مَسْقَط اَلرَّأْس, وَطَن الأُمّ (اسم مكان من السقوط؛ موضع السقوط عامّة؛ رأسه: عن المكان الذي وُلِد فيه. يُقصد بها الدولة أو المدينة لا المبنى)\nمثال: دفنت في مسقط رأسها.",
 "homeward": "باتجاه المنزل, نحو الوطن (نحو المنزل) / عَائِد إِلَى الوَطَن (موجه نحو المنزل أو الوطن)\nمثال: شق طريقه باتجاه المنزل عبر الثلوج العميقة",
 "homeward-bound": "عَائِد إِلَى الوَطَن (موجه نحو المنزل أو الوطن)",
 "homewards": "باتجاه المنزل, نحو الوطن (نحو المنزل)\nمثال: شق طريقه باتجاه المنزل عبر الثلوج العميقة",
 "homework": "وَاجِب, وَاجِب مَنْزِلِيّ (اسم لما يُوجَبُ فعله؛ اسم لما صار حدوثه أكيد)\nمثال: لا شكر على واجب.",
 "homework problem": "مَسْأَلَة وَاجِب, وَاجِب مَنْزِلِيّ (مشكلة يكلف الطلاب بحلها خارج الفصل)",
 "homey": "أَلِيف, بَيْتِيّ (يبعث على الشعور بأجواء البيت؛ مريح ودافئ)",
 "homicidal": "قَاتِل, قَتَّال (يتسم بالقتل أو لديه ميل إليه)",
 "homicide": "قتل البشر (قتل إنسان بواسطة إنسان آخر)",
 "homiletic": "وعظي (من أو متعلق بفن الوعظ) / وعظي (من طبيعة العظة أو الخطبة)\nمثال: خطاب وعظي",
 "homiletical": "وعظي (من أو متعلق بفن الوعظ) / وعظي (من طبيعة العظة أو الخطبة)\nمثال: خطاب وعظي",
 "homiletics": "علم الوعظ (فن الوعظ) / علم الوعظ (فرع اللاهوت الذي يتعامل مع الخطب والمواعظ)",
 "homily": "عظة أخلاقية (عظة حول موضوع أخلاقي أو ديني)",
 "hominal": "نَوْعِيّ بَشَرِيّ (متعلّق بالجنس البشري كنوع)",
 "homing": "مُوَجِّه ذَاتِيًّا (يوجه أو يقود نحو المنزل أو الوجهة)",
 "homing device": "جهاز توجيه ذاتي (الآلية في الصاروخ الموجه التي توجهه نحو هدفه)",
 "homing pigeon": "حمام زاجل (حمامة مدربة على العودة إلى المنزل)",
 "homing torpedo": "طوربيد موجه (طوربيد يتم توجيهه إلى هدفه (مثلاً عن طريق صوت محركات السفينة))",
 "hominian": "بَشَرَانِيّ (يتّصف بعائلة البشرانيّات التي تشمل الإنسان العاقل وأنواعًا منقرضة شبيهة بالإنسان)",
 "hominid": "بَشَرَانِيّ (يتّصف بعائلة البشرانيّات التي تشمل الإنسان العاقل وأنواعًا منقرضة شبيهة بالإنسان) / بشريات, هومينيد (رئيسيات من فصيلة القردة العليا (الهومينيدات))",
 "hominine": "إِنْسَانِيّ الطَّابِع (من خصائص الجنس البشري)",
 "hominoid": "قرديات الشكل (رئيسيات من فصيلة القردة العليا)",
 "hominy": "ذرة مجروشة, هوميني (ذرة مقشرة تمت إزالة النخالة والجنين منها)",
 "hominy grits": "جريش الذرة, غريتس (ذرة مقشرة ومطحونة خشناً تسلق كطبق إفطار في جنوب الولايات المتحدة)",
 "hommos": "حمص (معجون سميك مصنوع من الحمص المهروس والطحينة وعصير الليمون والثوم؛ يستخدم خاصة كغموس للخبز؛ نشأ في الشرق الأوسط)",
 "homo": "إنسان, بشر (أي عضو حي أو منقرض من فصيلة القردة العليا يتميز بذكاء فائق وكلام مفصلي وقامة منتصبة) / مثليّ, مثليّ الجنس (شخص ينجذب جنسياً لأشخاص من نفس الجنس)",
 "homo erectus": "إنسان منتصب (نوع منقرض من أشباه البشر البدائيين ذو قامة منتصبة ولكن دماغ صغير)\nمثال: كان الإنسان المنتصب يُسمى سابقاً بيثكانثروبوس إريكتوس",
 "homo habilis": "إنسان ماهر (نوع منقرض من أشباه البشر المنتصبين في شرق أفريقيا له بعض الخصائص المتقدمة الشبيهة بالإنسان)",
 "homo heidelbergensis": "إنسان هايدلبرغ (نوع من البشر البدائيين عاش في أوروبا)",
 "homo rhodesiensis": "إنسان روديسيا (إنسان بدائي يشبه إنسان نياندرتال ولكنه عاش في أفريقيا)",
 "homo sapiens": "إنسان عاقل (شبيه البشر الوحيد الباقي؛ النوع الذي ينتمي إليه الإنسان الحديث؛ رئيسيات تسير على قدمين ولها لغة وقدرة على صنع واستخدام أدوات معقدة؛ حجم الدماغ لا يقل…)",
 "homo sapiens neanderthalensis": "إنسان نياندرتال (إنسان قوي البنية منقرض من العصر الحجري القديم الأوسط في أوروبا وغرب آسيا)",
 "homo sapiens sapiens": "إنسان حديث (نويع من الإنسان العاقل؛ يشمل جميع الأعراق الحديثة)",
 "homo soloensis": "إنسان سولو (شبيه بشر بدائي منقرض من أواخر العصر البليستوسيني؛ جاوة؛ سابقاً جافانثروبوس)",
 "homocentric": "متحد المركز (له مركز مشترك)\nمثال: حلقات متحدة المركز",
 "homocercal": "متناظر الذيل (يمتلك ذيلاً متماثلاً يمتد إلى ما بعد نهاية العمود الفقري (كما في معظم الأسماك العظمية))",
 "homocercal fin": "زعنفة ذيلية متناظرة الفصوص, زعنفة متناظرة (زعنفة ذيلية متماثلة تمتد خلف نهاية العمود الفقري كما في معظم الأسماك العظمية)",
 "homochromatic": "أُحَادِيّ اللَّوْن ((للضوء أو الإشعاع الكهرومغناطيسي الآخر) لديه طول موجي واحد فقط)\nمثال: ضوء أحادي اللون",
 "homocyclic": "مُتَجَانِسُ الحَلَقَةِ (يحتوي على حلقة مغلقة من ذرات من النوع نفسه خاصة ذرات الكربون)",
 "homoecious": "وَحِيد العَائِل (للطفيليات وخاصة فطريات الصدأ؛ تكمل دورة الحياة بأكملها على عائل واحد)\nمثال: فطريات صدأ وحيدة العائل",
 "homoeopath": "معالج مثلي (ممارس للمعالجة المثلية (هوميباثي))",
 "homoeopathic": "تجانسي, مثلي (من أو متعلق بممارسة الطب التجانسي (المثلي))",
 "homoeopathy": "مداواة مثلية, هيموباثي (طريقة لعلاج المرض بكميات صغيرة من العلاجات التي تنتج، بكميات كبيرة في الأشخاص الأصحاء، أعراضاً مشابهة لتلك التي يتم علاجها)",
 "homoerotic": "مِثْلِيّ الهَوَى (متعلِّق بالحبّ المثليّ أو يخصُّه)",
 "homoeroticism": "مثلية جنسية (انجذاب جنسي (أو علاقات جنسية) لأشخاص من نفس الجنس)",
 "homogenate": "مادة متجانسة (مادة تمت مجانستها (خاصة الأنسجة التي تم طحنها وخلطها))\nمثال: نسيج كبد متجانس",
 "homogeneity": "تَجَانُس (صفة التشابه أو القابلية للمقارنة في النوع أو الطبيعة) / تَجَانُس (صفة كون الشيء موحداً في جميع أنحائه في التكوين أو الهيكل)\nمثال: هناك تجانس ملحوظ بين الشركتين",
 "homogeneous": "متجانس (كله من نفس النوع أو الطبيعة أو متشابه)\nمثال: مجموعة متجانسة متماسكة",
 "homogeneous polynomial": "كَثِيرَة حُدُود مُتَجَانِسَة (كثيرة حدود تتكون من حدود جميعها من نفس الدرجة)",
 "homogeneously": "بتجانس (كلهم بشكل متشابه)\nمثال: الطلاب في هذه الكلية متجانسون من الطبقة المتوسطة",
 "homogeneousness": "تَجَانُس (صفة التشابه أو القابلية للمقارنة في النوع أو الطبيعة)\nمثال: هناك تجانس ملحوظ بين الشركتين",
 "homogenisation": "تجانُس, مجانسة (عملية جعل الشيء متجانساً أو موحداً في التركيب)\nمثال: مجانسة القشطة",
 "homogenised": "مُتَجَنَّس, مُجَانَس (جُعِل متجانساً بالمعالجة) / مُتَجَانِس, مُجَنَّس (تم مزج عناصره المختلفة حتى أصبح متجانسًا)",
 "homogenization": "تجانُس, مجانسة (عملية جعل الشيء متجانساً أو موحداً في التركيب)\nمثال: مجانسة القشطة",
 "homogenized": "مُتَجَنَّس, مُجَانَس (جُعِل متجانساً بالمعالجة) / مُتَجَانِس, مُجَنَّس (تم مزج عناصره المختلفة حتى أصبح متجانسًا)",
 "homogenized milk": "حليب متجانس (حليب تم تكسير جزيئات الدهون فيه وتوزيعها بانتظام حتى لا تطفو القشدة على السطح)",
 "homogenous": "متجانس (كله من نفس النوع أو الطبيعة أو متشابه)\nمثال: مجموعة متجانسة متماسكة",
 "homogentisic acid": "ألكابتون, حمض الهوموجنتيسيك (حمض يتكون كمنتج وسيط في عملية التمثيل الغذائي للتيروزين والفينيل ألانين)",
 "homogeny": "تَجَانُس نُشُوئِيّ ((في علم الأحياء) التشابه بسبب التطور المشترك)",
 "homograft": "طعم مباين (نسيج أو عضو يُنقل من متبرع من نفس النوع ولكن بتركيب وراثي مختلف؛ يجب قمع الجهاز المناعي للمتلقي لمنع رفض الطعم)",
 "homograph": "جناس خطي, مشترك خطي (تكون الكلمتان مشتركتين خطياً إذا كُتبتا بنفس الطريقة واختلفتا في المعنى)",
 "homogyne alpina": "حشيشة السعال الألبية (عشب جذموري ذو أزهار حمراء أرجوانية مناسب كغطاء أرضي؛ يوضع أحياناً في جنس توسيلاغو)",
 "homoiotherm": "ذوات الدم الحار, كائن ثابت الحرارة (حيوان لديه درجة حرارة جسم ثابتة نسبياً ومستقلة عن درجة حرارة البيئة)",
 "homoiothermic": "ثَابِت الحَرَارَة (ذو حرارة جسم ثابتة ومرتفعة نسبيًّا؛ يوصف به الطيور والثدييّات)",
 "homologic": "تَنَادُدِيّ, هُومُولُوجِيّ (مشابه في الأصل التطوُّريّ لكن ليس في الوظيفة)",
 "homological": "تَنَادُدِيّ, هُومُولُوجِيّ (مشابه في الأصل التطوُّريّ لكن ليس في الوظيفة)",
 "homologous": "متجانس, متماثل (متوافق أو مشابه في الموقع أو البنية أو الوظيفة أو الخصائص؛ وخاصة المشتقة من كائن حي من نفس النوع) / متنادد, متناظر (له نفس الأصل التطوري ولكن ليس بالضرورة نفس الوظيفة)\nمثال: طعم نسيجي متماثل",
 "homology": "تَجَانُس, تَمَاثُل (صفة التشابه أو التطابق في الموقع أو القيمة أو الهيكل أو الوظيفة)",
 "homolosine projection": "إسقاط هومولوسين (خريطة إسقاط متساوي المساحات للكرة الأرضية؛ يتم تشويه المحيطات لتقليل تشويه القارات)",
 "homomorphism": "تَشَاكُل",
 "homomorphy": "تَشَاكُل, تَمَاثُل شَكْلِيّ (تشابه الشكل)",
 "homona coffearia": "عثة الشاي (عثة هندية صغيرة تغزو نباتات الشاي والبن مثلاً)",
 "homonym": "جناس تام, مشترك لفظي (تكون الكلمتان مشتركتين لفظياً إذا كان لهما نفس النطق والهجاء ولكن بمعانٍ مختلفة)",
 "homonymic": "متجانس لفظيا, مشترك اللفظ (مكون من أو متعلق بـ أو كونه متجانسات لفظية)",
 "homonymous": "متجانس لفظيا, مشترك اللفظ (مكون من أو متعلق بـ أو كونه متجانسات لفظية)",
 "homonymy": "اشْتِرَاك لَفْظِيّ, جِنَاس (العلاقة بين كلمتين تكتبان بنفس الطريقة أو تلفظان بنفس الطريقة ولكنهما تختلفان في المعنى)",
 "homophile": "مثليّ, مثليّ الجنس (شخص ينجذب جنسياً لأشخاص من نفس الجنس)",
 "homophobe": "مناهض للمثليين (شخص يكره أو يخشى المثليين)",
 "homophobia": "رُهَاب اَلْمِثْلِيَّة, هُومُوفُوبِيَا",
 "homophobic": "كَارِه لِلْمِثْلِيِّين, هُومُوفُوبِيّ (مُتَحَيِّز ضِدَّ المِثْلِيِّين جِنْسِيًّا)",
 "homophone": "لَفْظَة مُتَجَانِسَة",
 "homophonic": "أُحَادِيُّ اللَّحْن (ذُو خَطٍّ لَحْنِيٍّ وَاحِدٍ مَعَ مُصَاحَبَةٍ مُوسِيقِيَّة) / مُتَجَانِسُ اللَّفْظ (ذو صوت أو لفظ متطابق)",
 "homophonous": "متجانس اللفظ (مميز لظاهرة الكلمات ذات الأصول المختلفة التي تنطق بنفس الطريقة)",
 "homophony": "توافق صوتي, هوموفوني (موسيقى متعددة الأجزاء بصوت مهيمن واحد) / تجانس لفظي (نفس النطق لكلمات من أصول مختلفة)",
 "homopteran": "متشابهات الأجنحة (حشرات لها أجنحة أمامية وخلفية غشائية)",
 "homopterous insect": "متشابهات الأجنحة (حشرات لها أجنحة أمامية وخلفية غشائية)",
 "homosexual": "مِثْليّ, مِثْليّ الجنس / مِثْلِيّ, لُوطِيّ",
 "homosexualism": "مثلية جنسية (انجذاب جنسي (أو علاقات جنسية) لأشخاص من نفس الجنس)",
 "homosexuality": "مِثْلِيَّة, مِثْلِيَّة جِنْسِيَّة",
 "homosporous": "متماثل الأبواغ (يتميز بتماثل الأبواغ)",
 "homospory": "تماثل الأبواغ (تطور نوع واحد من الأبواغ اللاجنسية)",
 "homostyled": "متماثل الأقلام ((علم النبات) ذو أقلام (في الزهرة) كلها بنفس الطول)",
 "homostylic": "متماثل الأقلام ((علم النبات) ذو أقلام (في الزهرة) كلها بنفس الطول)",
 "homostylous": "متماثل الأقلام ((علم النبات) ذو أقلام (في الزهرة) كلها بنفس الطول)",
 "homothecy": "تَحَاكِي ((الرياضيات) تحويل قياس متماثل لفضاء تآلفي بنقطة ثابتة واحدة)",
 "homotherm": "ذوات الدم الحار, كائن ثابت الحرارة (حيوان لديه درجة حرارة جسم ثابتة نسبياً ومستقلة عن درجة حرارة البيئة)",
 "homothermic": "ثَابِت الحَرَارَة (ذو حرارة جسم ثابتة ومرتفعة نسبيًّا؛ يوصف به الطيور والثدييّات)",
 "homothety": "تَحَاكِي ((الرياضيات) تحويل قياس متماثل لفضاء تآلفي بنقطة ثابتة واحدة)",
 "homotoxicology": "علم السموم المتجانس (تحليل المرض في إطار فشل الجسم في التعامل مع عبء السموم)",
 "homozygosity": "تطابق الألائل, تماثل الزيجوت (حالة كونه متماثل الزيجوت؛ وجود أليلين متطابقين لنفس الجين)",
 "homozygote": "متماثل الزيجوت, متماثل اللاقحة ((علم الوراثة) كائن حي يمتلك أليلين متطابقين لجين معين وبالتالي يتكاثر بصفات نقية لتلك الخاصية)",
 "homozygous": "متماثل الزيجوت, متماثل اللواقح (وجود أليلات متطابقة في المواقع الكروموسومية المقابلة)\nمثال: هاتان الذبابتان متماثلتا الزيجوت بالنسبة للون العين الأحمر",
 "homs": "حِمْص (حَمَصَ الجُرْحُ: سَكَنَ وَرَمُه؛ حَمَصَ القَذَاةَ: أَخْرَجَها مِنْ عَيْنِه بِرِفْقٍ)\nمثال: الحمص مكون أساسي في طبق الفلافل.",
 "homsi": "حِمْصِيّ",
 "homunculus": "إنسان مصغر, قزم (فرد صغير مكتمل التكوين يُفترض (وفقاً لنظرية التكوين المسبق التي تم دحضها) أنه موجود داخل الحيوان المنوي) / رجل ضئيل, قزم (شخص صغير جداً ولكنه ليس مشوهاً أو غير طبيعي من نواحٍ أخرى)",
 "homy": "أَلِيف, بَيْتِيّ (يبعث على الشعور بأجواء البيت؛ مريح ودافئ)",
 "honcho": "رئيس العمال, ملاحظ (شخص يمارس السيطرة على العمال)\nمثال: إذا كنت تريد المغادرة مبكراً فعليك أن تطلب من رئيس العمال",
 "honda": "هُونْدَا (نوع من السيارات الحديثة يتم تصنيعها في اليابان)",
 "honduran": "هندوراسي (من أو يتعلق بهندوراس أو شعبها أو يميزهم) / هندوراسي (مواطن أو ساكن في هندوراس)",
 "honduran monetary unit": "وحدة نقدية هندوراسية (الوحدة النقدية في هندوراس)",
 "honduras": "هُنْدُورَاس, هُونْدُورَاس",
 "honduras mahogany": "ماهوجني كبير الأوراق, ماهوجني هندوراس (شجرة ماهوجني مهمة في أمريكا الوسطى)",
 "honduras rosewood": "خشب الورد الهندوراسي (شجرة من أمريكا الوسطى تنتج خشب ورد مخطط داكن قيم)",
 "hone": "مسن دقيق (حجر شحذ مصنوع من الحجر الرملي الدقيق؛ يستخدم لشحذ شفرات الحلاقة) / أداة شحذ دقيق, مِصْقَلَة (أداة تتكون من عدد من الشرائح الكاشطة الدقيقة المثبتة في رأس آلة، تدور وتتردد لإعطاء لمسة ناعمة لثقوب الأسطوانات، إلخ)",
 "honest": "نَزِيه, صَادِق",
 "honest man": "رجل شريف (رجل تزوج من امرأة كان يقيم معها علاقة جنسية بالفعل)",
 "honest woman": "امرأة شريفة (زوجة تزوجت رجلاً كانت تعيش معه لبعض الوقت (خاصة إذا كانت حاملاً في ذلك الوقت))\nمثال: جعل منها امرأة شريفة (تزوجها)",
 "honest-to-god": "أَصْلِيّ تَمَامًا, حَقِيقِيّ فِعْلًا ((غير رسمي، للتأكيد) حقيقي وأصلي فعلاً)",
 "honest-to-goodness": "أَصْلِيّ تَمَامًا, حَقِيقِيّ فِعْلًا ((غير رسمي، للتأكيد) حقيقي وأصلي فعلاً)",
 "honestly": "بِصَراحة",
 "honestness": "أمانة, صدق (صفة كون الشخص صادقاً)",
 "honesty": "أمانة, صدق (صفة كون الشخص صادقاً) / زهرة الدراهم, لوناريا (نبات من جنوب شرق أوروبا يُزرع لأزهاره الأرجوانية العطرة وقرون بذوره الورقية الفضية البيضاء المستديرة المسطحة التي تستخدم للزينة الداخلية)",
 "honey": "عَسَل, شَهْد (عَسَل) / حَبِيبِي, عَزِيزَتِي (الحَبِيْب الذي يُنسب إلى المتكلم؛ كلمة يطلقها المُتَحَابِّيْن على بعضهم البعض) / عَسَل, عَسُّولَة (عَسَل) / عَسَلِيّ\nمثال: يصنع النحل العسل.",
 "honey badger": "غُرَيْر العَسَل",
 "honey bear": "دب العسل, كنكاج (ثديي شجري آكل للفاكهة من أمريكا الاستوائية ذو ذيل طويل قابض)",
 "honey bee": "نَحْل, نَحْلَة الْعَسَلِ",
 "honey bell": "جرس العسل, هيرمانيا (شجيرة أفريقية ذات سيقان منبطحة وأزهار صفراء نحيلة برائحة العسل إما مفردة أو في أزواج)",
 "honey berry": "ليمون إسباني, مامونسيلو (شجرة استوائية أمريكية تحمل فاكهة صغيرة صالحة للأكل ذات قشرة جلدية خضراء ولب شفاف عصيري حلو)",
 "honey bun": "كعكة العسل, كعكة لزجة (عجين ملفوف مدهون بالسكر والمكسرات ثم يقطع ويخبز في قوالب مافن مع العسل أو السكر والزبدة في القاع)",
 "honey buzzard": "حوام النحل (صقر من العالم القديم يتغذى على يرقات النحل والقوارض الصغيرة والزواحف)",
 "honey cake": "كعكة العسل (كعكة متبلة محلاة جزئياً بالعسل)",
 "honey crisp": "مقرمشات العسل (حلوى مقرمشة مصنوعة بالعسل)",
 "honey eater": "آكل العسل (طائر أسترالي ذو لسان ومنقار متكيفين لاستخراج الرحيق)",
 "honey fungus": "فطر العسل (فطر صالح للأكل بلون العسل يرتبط عادة بجذور الأشجار في أواخر الصيف والخريف؛ لا يؤكل نيئاً)",
 "honey gland": "غدة رحيقية (غدة (غالباً ما تكون نتوءاً أو انخفاضاً) تفرز الرحيق)",
 "honey guide": "مرشد العسل (طائر صغير من أفريقيا الاستوائية وآسيا؛ يتغذى على شمع العسل والعسل واليرقات)",
 "honey locust": "خروب العسل, غلاديتشية ثلاثية الأشواك (شجرة أمريكية شمالية طويلة عادة ما تكون شائكة لها زهور بيضاء مخضرة صغيرة في عناقيد متدلية تليها قرون بذور طويلة ملتوية؛ تنتج خشباً بنياً محمراً متيناً…)",
 "honey mesquite": "بروسوبس غدي, مسكيت العسل (شجيرة شائكة عميقة الجذور مقاومة للجفاف موطنها جنوب غرب الولايات المتحدة والمكسيك تحمل قروناً غنية بالسكر ومهمة كعلف للماشية؛ تميل إلى تشكيل غابات…)",
 "honey mushroom": "فطر العسل (فطر صالح للأكل بلون العسل يرتبط عادة بجذور الأشجار في أواخر الصيف والخريف؛ لا يؤكل نيئاً)",
 "honey oil": "أسيد سوبر, سوبر سي (أسماء دارجة للكيتامين)",
 "honey plant": "نبات عسلي (نبات يوفر رحيقاً مناسباً لصنع العسل)",
 "honey trap": "فَخّ الْعَسَل",
 "honey-colored": "عَسَلِيّ اللَّوْن (ذو لون العسل)",
 "honey-coloured": "عَسَلِيّ اللَّوْن (ذو لون العسل)",
 "honey-flower": "زهرة العسل (شجيرة أسترالية تنتج زهورها العسل بغزارة) / زهرة العسل, شيطان الجبل (شجيرة كثيفة منتصبة من شرق أستراليا ذات عناقيد طرفية من الزهور الحمراء تنتج الكثير من الرحيق)",
 "honey-scented": "بِرَائِحَةِ العَسَل (ذُو رَائِحَة العَسَل)",
 "honeybee": "نحل العسل (نحل اجتماعي يتم تدجينه غالباً من أجل العسل الذي ينتجه)",
 "honeybells": "جرس العسل, هيرمانيا (شجيرة أفريقية ذات سيقان منبطحة وأزهار صفراء نحيلة برائحة العسل إما مفردة أو في أزواج)",
 "honeycomb": "قَرْص اَلْعَسَل",
 "honeycomb tripe": "القلنسوة, كرشة العسل (بطانة المعدة الثانية (الشبكية) للحيوانات المجترة تستخدم كطعام)",
 "honeycombed": "سِنْخِيّ, مُجَوَّف (مليء بتجاويف تشبه الخلايا (كقرص العسل))",
 "honeycreeper": "طائر العسل (طائر مغرد استوائي أمريكي صغير زاهي الألوان ذو منقار منحني لامتصاص الرحيق) / آكل العسل, آكل العسل الهاواي (عصافير صغيرة إلى متوسطة الحجم في جزر هاواي)",
 "honeydew": "مغثر / مَنّ (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "honeydew honey": "عسل الندوة العسلية (عسل داكن وقوي برائحة غنية من الفاكهة المطبوخة أو مربى التين، وليس حلواً مثل عسل الرحيق)",
 "honeydew melon": "شمام كوز العسل (ثمرة صنف من كرمة الشمام الشتوي؛ شمام كبير أملس أبيض مخضر ذو لحم أخضر باهت) / بطيخ شتوي, شمام عسلي (أي من أصناف كرمة الشمام ذات ثمار بقشرة بيضاء ملساء ولحم أبيض أو مخضر ليس له رائحة مسكية)",
 "honeyed": "مَعْسُول",
 "honeyed words": "كلمات معسولة, همسات الحب (تعبيرات عاطفية غير مهمة المضمون)\nمثال: همس بكلمات معسولة في أذنها",
 "honeyflower": "زهرة العسل (شجيرة أسترالية تنتج زهورها العسل بغزارة) / زهرة العسل, شيطان الجبل (شجيرة كثيفة منتصبة من شرق أستراليا ذات عناقيد طرفية من الزهور الحمراء تنتج الكثير من الرحيق)",
 "honeylike": "شَبِيه بِالعَسَل (يُشبه العسل في قوامه أو طعمه)",
 "honeymoon": "شَهْر عَسَل (اسم مفرد: مدة زمنية قدرها 28 أو 29 أو 30 أو 31 يوما، والشَّهرُ جزءٌ من اثني عشر جزئا من السَنَة…)\nمثال: رمضان شهر حرام.",
 "honeymoon resort": "منتجع شهر العسل (منتجع يلبي احتياجات المتزوجين حديثاً)\nمثال: شلالات نياجرا هي منتجع شهر عسل معروف",
 "honeymooner": "حديث الزواج (شخص تزوج حديثاً)",
 "honeypot": "بروطيا عملاقة, بروطيا ملكية (شجيرة من جنوب أفريقيا تكون زهورها عند التفتح كأسية الشكل تشبه الخرشوف)",
 "honeysucker": "آكل العسل (طائر أسترالي ذو لسان ومنقار متكيفين لاستخراج الرحيق)",
 "honeysuckle": "صَرِيمَة الْجَدْي",
 "hong kong": "هُونْغ كُونْغ / هُونْج كُونْج / هُونْق كُونْق",
 "hong kong dollar": "دولار هونغ كونغ (وحدة المال الأساسية في هونغ كونغ)",
 "honiara": "هُونِيَارَا",
 "honied": "مَمْزُوج بِالعَسَل, مُعَسَّل (مُضاف إليه العسل)",
 "honing machine": "آلة تنعيم الأسطوانات, آلة شحذ (آلة تستخدم في عملية التشغيل الكاشطة المعروفة بالشحذ)\nمثال: من المفارقات أن آلة الشحذ غير دقيقة نسبياً ومطاوعة",
 "honk": "صوت الإوز, فحيح (صوت الإوزة (أو أي صوت يشبه هذا))",
 "honker": "إوز كندي (إوز بري بني رمادي شائع في أمريكا الشمالية ذو نداء عالٍ يشبه البوق) / أنف, منقار (مصطلحات غير رسمية للأنف) / مطلق البوق, مُزَمِّر (سائق يتسبب في إصدار صوت عالٍ من بوق سيارته)\nمثال: تم تغريم المزمّر بتهمة إزعاج السكينة العامة",
 "honkey": "أبيض (تحقير) ((عامية) أسماء مهينة للرجل الأبيض)",
 "honkie": "أبيض (تحقير) ((عامية) أسماء مهينة للرجل الأبيض)",
 "honky": "أبيض (تحقير) ((عامية) أسماء مهينة للرجل الأبيض)",
 "honky-tonk": "حانة رخيصة (مؤسسة رخيصة للشرب والرقص)",
 "honkytonk": "ملهى رخيص (ملهى ليلي رخيص سيء السمعة أو قاعة رقص)",
 "honolulu": "هُونُولُولُو",
 "honor": "شَرَف, عِزَّة (شَرَف) / شَرَف (شَرَف)\nمثال: لا أستحق هذا الشرف.",
 "honor guard": "حرس الشرف (مرافق لضيف مميز أو للنعش في جنازة عسكرية)",
 "honor killing": "جريمة شرف, قتل الشرف (تقليد قديم لا يزال يتبع أحياناً؛ حيث يقتل ذكر من الأسرة قريبته بدعوى تلويث سمعة العائلة)",
 "honor system": "نظام الثقة, نظام الشرف (نظام سلوكي يوثق فيه بالمشاركين لعدم استغلال الآخرين بشكل غير عادل)\nمثال: الطلاب يخضعون لنظام الشرف",
 "honorable": "شريف, صادق (غير ميال للغش أو الاحتيال؛ غير خادع أو مخادع؛ يتسم بالصدق) / مبجل, مشرف (يستحق التبجيل؛ يستحق الشرف والاحترام) / جَدِيرٌ بِالِاحْتِرَامِ, مَحْمُودٌ (يستحق التقدير والاحترام) / أَخْلَاقِيّ, شَرِيف (يلتزم بالمبادئ الأخلاقية والقِيَمية)\nمثال: محامون نزيهون",
