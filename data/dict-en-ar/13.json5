 "hertz": "هِيرْتِز, هِرْتِز",
 "hertzian": "هيرتزي (من أو متعلق بالفيزيائي هاينريش هيرتز أو عمله)\nمثال: اكتشافات هيرتزية",
 "hertzian wave": "موجة هيرتزية (اسم سابق للموجة الراديوية؛ موجة كهرومغناطيسية ذات تردد راديوي تتولد عن تذبذبات في دائرة كهربائية)",
 "herzegovina": "الْهَرْسَك",
 "heshvan": "حشفان (الشهر الثاني من السنة المدنية؛ الشهر الثامن من السنة الدينية في التقويم اليهودي (في أكتوبر ونوفمبر))",
 "hesitance": "تردد (شعور بعدم الثقة والتردد حول فعل شيء ما)",
 "hesitancy": "تثاقل, تردد (درجة معينة من عدم الرغبة) / تردد (شعور بعدم الثقة والتردد حول فعل شيء ما)\nمثال: ممانعة في إلزام نفسه",
 "hesitant": "مُتَحَيِّر, مُتَرَدِّد (يفتقر إلى حسم الشخصية؛ عاجز عن الفعل أو القرار بسرعة أو حزم)",
 "hesitantly": "بتردد (مع تردد؛ بطريقة مترددة)\nمثال: قبل أخيراً بتردد",
 "hesitate": "تَرَدَّدَ (الذهاب إلى المكان مرة أخرى إلى نفس المكان بصورة متكررة؛ عدم الاستقرار على رأي معين)\nمثال: قبل ماثيو بتردد.",
 "hesitater": "متردد (من يتردد (عادة بدافع الخوف))",
 "hesitating": "مُتَحَيِّر, مُتَرَدِّد (يفتقر إلى حسم الشخصية؛ عاجز عن الفعل أو القرار بسرعة أو حزم)",
 "hesitatingly": "بتردد (مع تردد؛ بطريقة مترددة)\nمثال: قبل أخيراً بتردد",
 "hesitation": "تردد, تلكؤ (فعل التوقف بشكل غير مؤكد) / تثاقل, تردد (درجة معينة من عدم الرغبة) / تردد, تريث (تردد في الكلام أو العمل)\nمثال: كان هناك تردد في كلامه",
 "hesitator": "متردد (من يتردد (عادة بدافع الخوف))",
 "hesperian": "أُوكْسِيدَنْتَالِيّ, غَرْبِيّ (يدلّ على دول أوروبا ونصف الكرة الغربي أو يتّسم بخصائصها)",
 "hesperides": "هسبيريديس ((الأساطير اليونانية) مجموعة من 3 إلى 7 حوريات حرسن التفاح الذهبي الذي أهدته غايا لحيرا كهدية زفاف)",
 "hesperiphona vespertina": "مغلظ المنقار المسائي (طائر مغلظ المنقار من أمريكا الشمالية)",
 "hesperis matronalis": "منثور دمشقي, هيسبيرس (عشب مزروع منذ فترة طويلة له زهور تكون رائحتها أكثر وضوحاً في المساء؛ تم توطينه في جميع أنحاء أوروبا إلى سيبيريا وإلى أمريكا الشمالية)",
 "hesse": "هِسِّن",
 "hessian": "جزمة عسكرية, جزمة هسية ((في القرن التاسع عشر) حذاء رجالي طويل مزين بشراشيب)",
 "hessian boot": "جزمة عسكرية, جزمة هسية ((في القرن التاسع عشر) حذاء رجالي طويل مزين بشراشيب)",
 "hessian fly": "ذبابة هسيان (ذبابة صغيرة تتلف يرقاتها القمح والحبوب الأخرى)",
 "hessonite": "حجر القرفة, هيسونيت (عقيق يتراوح لونه من الأصفر إلى البني)",
 "het": "مُسَخَّن (جُعِل دافئاً أو ساخناً)",
 "het up": "مُسَخَّن (جُعِل دافئاً أو ساخناً)",
 "heteranthera dubia": "عشب نجمة الماء, هيترانثيرا (نبات مائي في أمريكا الشمالية ذو أوراق عشبية وأزهار صفراء على شكل نجمة)",
 "heterocercal": "متباين الذيل (يمتلك ذيلاً بفص علوي أكبر من السفلي ويمتد العمود الفقري إلى الفص العلوي)",
 "heterocercal fin": "زعنفة ذيلية متباينة الفصوص, زعنفة متباينة (زعنفة ذيلية ذات فصوص غير متساوية حيث يتجه العمود الفقري صعودًا نحو الفص الأكبر كما في أسماك القرش)",
 "heteroclitic antibody": "جسم مضاد غير نمطي (جسم مضاد يُنتج استجابة للتحصين بمستضد واحد ولكن له ألفة أعلى لمستضد ثانٍ لم يكن موجوداً أثناء التحصين)",
 "heterocycle": "حلقة غير متجانسة, مركب حلقي غير متجانس (حلقة من ذرات من أكثر من نوع؛ خاصة حلقة من ذرات الكربون تحتوي على ذرة واحدة على الأقل ليست كربوناً) / مركب حلقي غير متجانس (مركب يحتوي على حلقة غير متجانسة)",
 "heterocyclic": "غَيْرِيُّ الحَلَقَةِ (يحتوي على حلقة مغلقة من الذرات تكون إحداها على الأقل غير كربونية) / مركب حلقي غير متجانس (مركب يحتوي على حلقة غير متجانسة)",
 "heterocyclic compound": "مركب حلقي غير متجانس (مركب يحتوي على حلقة غير متجانسة)",
 "heterocyclic ring": "حلقة غير متجانسة, مركب حلقي غير متجانس (حلقة من ذرات من أكثر من نوع؛ خاصة حلقة من ذرات الكربون تحتوي على ذرة واحدة على الأقل ليست كربوناً)",
 "heterodactyl": "متباين الأصابع ((لأقدام الطيور) وجود أصابع القدم الأول والثاني موجهة للخلف والثالث والرابع للأمام)",
 "heterodactyl foot": "قدم متباينة الأصابع (قدم طائر يكون فيها الإصبع الأول والثاني متجهين للخلف والثالث والرابع للأمام)",
 "heterodox": "مُنْشَقّ, هَرْطُوقِيّ (يتسم بالخروج عن المعتقدات أو المعايير المقبولة)",
 "heterodoxy": "بِدْعَة, خُرُوج عَن المَأْلُوف (صفة كون الشيء غير أرثوذكسي أو مخالفاً للمعتقد السائد) / خروج عن المألوف, مروق (أي آراء أو مذاهب تتعارض مع الموقف الرسمي أو التقليدي)",
 "heterodyne": "تضاربي, هيتروداين (مكون من أو متعلق بالنبض الناتج عن تضارب (خلط) ذبذبتين)",
 "heterodyne oscillator": "مذبذب محلي (مذبذب يتداخل خرجه مع إشارة الراديو الواردة لإنتاج نغمات المجموع والفرق)",
 "heterodyne receiver": "مستقبل هيتروداين (جهاز استقبال راديو يجمع تردداً مولداً محلياً مع تردد الموجة الحاملة لإنتاج إشارة فوق صوتية يتم استخلاصها وتضخيمها)",
 "heteroecious": "مُتَبَايِن العَائِل (للطفيليات؛ تمر بمراحل مختلفة من دورة الحياة على أنواع مضيفة مختلفة)\nمثال: فطريات متباينة العائل",
 "heterogeneity": "تَبَايُن الخَوَاصّ, عَدَم تَجَانُس (صفة التنوع وعدم القابلية للمقارنة في النوع)",
 "heterogeneous": "خَارِجِيّ المَنْشَأ, غَيْر مُتَجَانِس (ناشئ خارج الجسم) / غير متجانس, متباين (يتكون من عناصر ليست من نفس النوع أو الطبيعة)\nمثال: سكان الولايات المتحدة شاسعون وغير متجانسين",
 "heterogeneousness": "تَبَايُن الخَوَاصّ, عَدَم تَجَانُس (صفة التنوع وعدم القابلية للمقارنة في النوع)",
 "heterogenesis": "تعاقب الأجيال, تولد متباين (تناوب شكلين مختلفين أو أكثر في دورة حياة نبات أو حيوان)",
 "heterogenous": "خَارِجِيّ المَنْشَأ, غَيْر مُتَجَانِس (ناشئ خارج الجسم) / غير متجانس, متباين (يتكون من عناصر ليست من نفس النوع أو الطبيعة)\nمثال: سكان الولايات المتحدة شاسعون وغير متجانسين",
 "heterogloss": "حد لغوي, خط تساوي اللغة (الحدود المكانية لميزة لغوية معينة، مثل نطق حرف متحرك، أو معنى كلمة، أو استخدام ميزة نحوية)",
 "heterograft": "طعم أجنبي, طعم مغاير (نسيج من حيوان من نوع واحد يستخدم كطعم مؤقت (كما في حالات الحروق الشديدة) على فرد من نوع آخر)",
 "heteroicous": "مُتَعَدِّدُ المَسَاكِن (لَهُ عِدَّةُ أَشْكَالٍ مِنْ أَعْضَاءِ التَّكَاثُرِ عَلَى نَفْسِ النَّبَات)",
 "heterokontophyta": "قسم متباينات السوط, متباينات السوط (فَرَّقَ أو قَسَّمَ الشَّيءَ إلى أجزاء أو أجزاء مختلفة؛ أَحْلَفَ، أَي جَعَلَ يَحْلِفُ على أمرٍ ما)\nمثال: أنا أزين القسم.",
 "heterologic": "غير متنادد (لا يتوافق في الهيكل أو الأصل التطوري)",
 "heterological": "غير متنادد (لا يتوافق في الهيكل أو الأصل التطوري)",
 "heterologous": "غير متجانس, متباين (مشتق من كائنات حية من أنواع مختلفة ولكن ذات صلة) / غير متنادد (لا يتوافق في الهيكل أو الأصل التطوري)\nمثال: طعم غير متجانس",
 "heterology": "تَبَايُن بَيُولُوجِيّ, عَدَم تَمَاثُل ((في علم الأحياء) عدم توافق أجزاء الجسم المتشابهة ظاهرياً)",
 "heteromeles arbutifolia": "توت عيد الميلاد, تويون (شجيرة زينة دائمة الخضرة تشبه الشجرة من ساحل المحيط الهادئ للولايات المتحدة لها زهور بيضاء كبيرة وثمار حمراء تشبه التوت؛ توضع غالباً في جنس فوتينيا)",
 "heterometabolic": "مُتَبَايِنُ التَّحَوُّل ((لِلْحَشَرَات) يَمُرُّ بِتَحَوُّلٍ نَاقِصٍ تُشْبِهُ فِيهِ الحَوْرِيَّةُ البَالِغ)",
 "heterometabolism": "تباين التحول (تطور الحشرات ذات التحول غير الكامل حيث لا تسبق مرحلة العذراء النضج)",
 "heterometabolous": "مُتَبَايِنُ التَّحَوُّل ((لِلْحَشَرَات) يَمُرُّ بِتَحَوُّلٍ نَاقِصٍ تُشْبِهُ فِيهِ الحَوْرِيَّةُ البَالِغ)",
 "heterometaboly": "تباين التحول (تطور الحشرات ذات التحول غير الكامل حيث لا تسبق مرحلة العذراء النضج)",
 "heteronormativity": "مِعْيَارِيّة مُغَايَرَة",
 "heteronym": "متجانس كتابةً مختلف نطقاً, مجانس خطي (تكون الكلمتان مجانستين خطياً إذا كُتبتا بنفس الطريقة ولكنهما اختلفتا في النطق)",
 "heterophil antibody": "جسم مضاد غير متجانس (جسم مضاد يوجد في دم شخص يعاني من كثرة الوحيدات العدوائية)",
 "heterophil test": "اختبار الأجسام المضادة المتغايرة (فحص دم للكشف عن الأجسام المضادة المتغايرة؛ النتيجة الإيجابية تشير إلى كريات الدم البيضاء المعدية)",
 "heterophile antibody": "جسم مضاد غير متجانس (جسم مضاد يوجد في دم شخص يعاني من كثرة الوحيدات العدوائية)",
 "heterophobia": "رهاب الاختلاف",
 "heteroploid": "مغاير الصيغة الصبغية ((في علم الوراثة) كائن أو خلية تحتوي على عدد كروموسومات ليس مضاعفاً زوجياً لعدد الكروموسومات الأحادي لذلك النوع)",
 "heteroploidy": "تغاير الصيغة الصبغية (حالة كون الكائن متغاير الصيغة الصبغية)",
 "heteropterous insect": "متباينات الأجنحة (البق الحقيقي: حشرات تكون أجنحتها الأمامية غشائية ولكن لها أطراف جلدية)",
 "heteroscelus incanus": "ثرثارة بولينيزية (طائر ثرثار يعيش في المناطق الساحلية للمحيط الهادئ)",
 "heterosexism": "تمييز ضد المثليين (التمييز لصالح المغايرين جنسياً وضد المثليين)",
 "heterosexual": "مغاير للجنس",
 "heterosexual person": "غيري الجنس, مباين الجنس (شخص لديه ميول جنسية تجاه أشخاص من الجنس الآخر)",
 "heterosexualism": "غيرية جنسية (انجذاب جنسي (أو علاقات جنسية) لأشخاص من الجنس الآخر)",
 "heterosexuality": "مُغَايَرَة, هيتيروسكسوالية",
 "heterosis": "تغاير, قوة الهجين ((وراثة) ميل الكائن الهجين لامتلاك صفات متفوقة على صفات أي من الوالدين)",
 "heterosporous": "متباين الأبواغ (يتميز بتباين الأبواغ)",
 "heterospory": "تباين الأبواغ (تطور كل من الأبواغ الصغيرة والأبواغ الكبيرة)",
 "heterostracan": "مغايرات الدرقة (سمكة منقرضة عديمة الفك الجزء الأمامي من جسمها مغطى بصفائح عظمية؛ من العصر السيلوري والديفوني)",
 "heterotaxy": "انقلاب الأحشاء, تبدل الموضع (أي وضع غير طبيعي لأعضاء الجسم)",
 "heterotheca villosa": "أستر ذهبي مشعر, هيتروتيكا (نبات معمر مشعر ذو رؤوس زهرية صفراء في عناقيد متفرعة؛ يوجد في كل مكان تقريباً في الأماكن الجافة من كندا إلى غرب وسط وغرب الولايات المتحدة؛ يوضع…)",
 "heterothermic": "مُتَغَيِّر الحَرَارَة (ذو حرارة جسم تتغيّر بحسب البيئة؛ يوصف به الحيوانات عدا الطيور والثدييّات)",
 "heterotroph": "غيري التغذية (كائن يعتمد على مواد عضوية معقدة للتغذية)",
 "heterotrophic": "غيري التغذية (يتطلب مركبات عضوية من الكربون والنيتروجين للتغذية)\nمثال: معظم الحيوانات غيرية التغذية",
 "heterozygosity": "اختلاف الألائل, تغاير الزيجوت (حالة كونه متغاير الزيجوت؛ وجود أليلين مختلفين لنفس الجين)",
 "heterozygote": "متباين اللاقحة, متغاير الزيجوت ((علم الوراثة) كائن حي يمتلك أليلين مختلفين لجين معين مما يؤدي إلى ذرية متنوعة)",
 "heterozygous": "متغاير الزيجوت, متغاير اللواقح (وجود أليلات غير متشابهة في المواقع الكروموسومية المقابلة)\nمثال: متغاير الزيجوت للون العين",
 "heth": "حيط, خيط (الحرف الثامن من الأبجدية العبرية)",
 "heuchera americana": "غرنوقي صخري, هيوشيرا أمريكية (نبات بأوراق قاعدية مرقشة بالأبيض وزهور في عناقيد رخوة على سيقان منتصبة)",
 "heuchera cylindrica": "هيوشيرا أسطوانية (نبات بنصال أوراق جلدية على شكل قلب متجمعة عند قاعدة سيقان طويلة مع زهور بيضاء مخضرة متجمعة على الجزء العلوي؛ غرب أمريكا الشمالية)",
 "heuchera sanguinea": "أجراس المرجان, هيوشيرا دموية (نبات معمر من غرب الولايات المتحدة له زهور حمراء زاهية في سنابل ريشية؛ يستخدم للزينة)",
 "heulandite": "هيولانديت (مجموعة معادن من عائلة الزيوليت تتكون من سيليكات ألومنيوم مائية للصوديوم والكالسيوم)",
 "heuristic": "إرشادي",
 "heuristic program": "إرشاديات, خوارزمية استكشافية (قاعدة بديهية (أو مجموعة من القواعد) تهدف إلى زيادة احتمالية حل مشكلة ما)",
 "heuristic rule": "إرشاديات, خوارزمية استكشافية (قاعدة بديهية (أو مجموعة من القواعد) تهدف إلى زيادة احتمالية حل مشكلة ما)",
 "hevea brasiliensis": "شجرة المطاط, هيفيا برازيلية (شجرة متساقطة الأوراق في نهري الأمازون وأورينوكو ذات أوراق جلدية وزهور بيضاء صفراء عطرة؛ تنتج عصارة لبنية هي المصدر الرئيسي للمطاط التجاري)",
 "hewer": "حطّاب, قطّاع (شخص يقوم بالقطع أو النحت)",
 "hewn": "مَنْحُوت (مُشكَّل بضربات قوية من أداة قطع ثقيلة كالفأس أو الإزميل)",
 "hex": "نَحَسَ / ساحِرة, مُشَعْوِذة",
 "hex key": "مفتاح ألن, مفتاح سداسي (مفتاح ربط للبراغي السداسية (ألن))",
 "hex nut": "صامولة سداسية (صامولة ذات شكل سداسي)",
 "hexachlorophene": "سداسي كلوروفين (مادة مضادة للبكتيريا عبارة عن مسحوق قابل للذوبان في الماء يستخدم في الصابون المطهر ومعجون الأسنان)",
 "hexacosanoic acid": "حمض السيروتيك (حمض دهني صلب أبيض يوجد في الشموع (مثل شمع العسل))",
 "hexad": "سُدَاسِيّ, سِتَّة (العدد الأصلي الذي هو مجموع خمسة وواحد)",
 "hexadecanoic acid": "حمض البالمتيك (حمض دهني مشبع يُعد الدهن الرئيسي في اللحوم ومنتجات الألبان)",
 "hexadecimal": "ست عشري (مكون من أو متعلق بنظام عددي أساسه 16)",
 "hexadecimal digit": "رَقَم سِتَّة عَشْرِيّ (رقم من 0 إلى 15 في التدوين الستة عشري)",
 "hexadecimal notation": "تدوين ستة عشري (أي تدوين يستخدم 16 حرفاً مختلفاً)",
 "hexadecimal number system": "النظام الستة عشري, نظام العد الستة عشري (نظام عد موضعي يستخدم أرقاماً ستة عشرية وأساساً هو الستة عشر)",
 "hexadecimal system": "النظام الستة عشري, نظام العد الستة عشري (نظام عد موضعي يستخدم أرقاماً ستة عشرية وأساساً هو الستة عشر)",
 "hexadrol": "ديكادرون, ديكساميثازون (دواء كورتيكوستيرويد (الأسماء التجارية ديكادرون وغيرها) يستخدم لعلاج الحساسية أو الالتهاب)",
 "hexagon": "مُسَدَّس (اسم مفعول من سَدَّسَ؛ في : شَكْل هندسي مُسَطَّح له سِتَّة أضلاع متساوية فإن لم تكن متساوية سميّ بالسُدَاسِيّ)\nمثال: كان عند زيري مسدس.",
 "hexagonal": "سداسي الأضلاع, سداسي الزوايا (له ستة جوانب أو مقسم إلى أشكال سداسية)",
 "hexagram": "نجمة سداسية (مضلع منتظم يتكون من مد كل ضلع من أضلاع مسدس منتظم لتشكيل مثلثين متساويي الأضلاع)",
 "hexagrammos decagrammus": "جرينلينج عشب البحر (سمكة طعام ورياضة شائعة في الساحل الغربي لأمريكا الشمالية)",
 "hexahedron": "سداسي السطوح (أي متعدد سطوح له ستة أوجه مستوية)",
 "hexakosioihexekontahexaphobia": "رهاب الرقم 666 (الخوف من الخصائص السحرية للرقم 666)",
 "hexalectris spicata": "جذر المرجان المتوج (أوركيد بزهور بنية مصفرة بعروق داكنة؛ جنوب شرق أريزونا إلى شرق الولايات المتحدة)",
 "hexalectris warnockii": "سنبلة تكساس الأرجوانية (أوركيد بسيقان بنية محمرة نحيلة عديمة الأوراق تقريباً مع عناقيد فضفاضة من الزهور البنية المحمرة؛ في الغابات الشجيرية المفتوحة بجنوب شرق أريزونا ووسط…)",
 "hexalogy": "سُداسِيَّة",
 "hexameter": "سداسي التفعيلة (بيت شعر يحتوي على ست تفعيلات عروضية)",
 "hexanchus griseus": "قرش البقر, قرش سداسي الخياشيم (قرش بدائي كبير موزع على نطاق واسع في البحار الدافئة)",
 "hexane": "هكسان (ألكان سائل عديم اللون قابل للاشتعال مشتق من البترول ويُستخدم كمذيب)",
 "hexanedioic acid": "حمض الأديبيك, حمض الهكسانديوك (حمض كربوكسيلي يستخدم في صناعة النايلون)",
 "hexangular": "سداسي الأضلاع, سداسي الزوايا (له ستة جوانب أو مقسم إلى أشكال سداسية)",
 "hexanoic acid": "حمض الكابرويك (حمض دهني يوجد في الزيوت والدهون الحيوانية أو يُصنع صناعياً؛ رائحته تشبه الماعز)",
 "hexapod": "سداسي الأرجل (حيوان له ستة أقدام)",
 "hexed": "مَسْحُور, مَنْحُوس ((تُستخدم عامّياً) يُسبِّب أو يُرافقه سوء الحظ)",
 "hexenbesen": "مكنسة الساحرة (نمو غير طبيعي كثيف (متكتل) للأغصان الصغيرة على شجرة أو شجيرة ناتج عن فطريات أو حشرات أو اضطرابات فسيولوجية أخرى)",
 "hexene": "هِكْسِين",
 "hexestrol": "هيكسيسترول (مركب استروجيني يستخدم لعلاج عدم انتظام الدورة الشهرية وأعراض انقطاع الطمث ولمنع الحمل)",
 "hexine": "هكسين\nمثال: يتم الحصول على الهكسين صناعياً كسائل متطاير عديم اللون",
 "hexose": "سكر سداسي, هكسوز (سكر أحادي يحتوي على ست ذرات كربون في الجزيء)",
 "hey": "يَاه, اسمع / هَلَا",
 "heyday": "أوج, إبان (فترة الازدهار أو الإنتاجية القصوى)",
 "hezbollah": "حِزْب اللّٰه (حزّب القومَ:جعلهم أحزاباً ، قوّاهم ، جعلهم من حزبه؛ حَزَّبْتُ القُرْآنَ: جَعَلْتُه أَحْزَاباً)\nمثال: التحقت بذلك الحزب.",
 "hf": "تَرَدُّد عَالٍ (3 إلى 30 ميجاهرتز) / هافنيوم (عنصر فلزي رمادي رباعي التكافؤ يشبه الزركونيوم كيميائياً)",
 "hfc": "هيدروفلوروكربون (فلوروكربون ينبعث كمنتج ثانوي للتصنيع الصناعي)",
 "hg": "هيكتوغرام (100 غرام) / زئبق (عنصر فلزي ثقيل فضي سام أحادي وثنائي التكافؤ؛ المعدن الوحيد الذي يكون سائلاً في درجات الحرارة العادية)",
 "hhs": "وزارة الصحة والخدمات الإنسانية (الإدارة الفيدرالية الأمريكية التي تدير جميع البرامج الفيدرالية التي تتعامل مع الصحة والرفاهية؛ أنشئت عام 1979)",
 "hi": "مَرْحَبًا, سَلَام (تَحِيَّة تقال للضيف؛ تَحِيَّة تقال عند لقاء شخص ما أو لبدء المُحَادَثَة)\nمثال: مرحبا يا فتيات.",
 "hi-fi": "عَالِي الدِّقَّة (يتّسم بالحدّ الأدنى من التشويه في إعادة إنتاج الصوت) / دقة عالية (إعادة إنتاج الصوت مع قليل من التشويه أو بدونه) / نظام صوت عالي الدقة, هاي فاي (معدات لاستنساخ الصوت بدقة عالية)",
 "hi-tech": "تكنولوجيا متطورة, عالي التقنية (يشبه أو يستخدم تكنولوجيا أو أجهزة متقدمة للغاية)",
 "hiatal hernia": "فتق الحجاب الحاجز, فتق حجابي (فتق ناتج عن بروز جزء من المعدة عبر الحجاب الحاجز)",
 "hiatus": "فُرْجَة",
 "hiatus hernia": "فتق الحجاب الحاجز, فتق حجابي (فتق ناتج عن بروز جزء من المعدة عبر الحجاب الحاجز)",
 "hiba arborvitae": "عفص هيبا, هيبا (شجرة يابانية دائمة الخضرة متوسطة إلى كبيرة بطيئة النمو تستخدم للزينة)",
 "hibachi": "هيباتشي (موقد محمول يحرق الفحم وله شواية للطهي)",
 "hibernal": "شِتْوِيّ (يتّصف بالشتاء أو يتعلّق به)",
 "hibernate": "أَسْبَتَ ((أَسْبَتَت) الْحَيَّة: أطرقَت لَا تتحرك؛ (أَسْبَتَ) فُلَان: دَخَلَ فِي يَوْم السبت)",
 "hibernation": "إِسْبَات",
 "hibiscus": "خطمي, كركديه (أي نبات من جنس الخطمي)",
 "hibiscus cannabinus": "تيل, كيناف (نبات ليفي قيم من جزر الهند الشرقية واسع الانتشار الآن في الزراعة)",
 "hibiscus elatus": "لحاء كوبي, ماهو أزرق (شجرة غابات منتصبة في كوبا وجامايكا ذات أوراق مشعرة بشكل متباين وزهور برتقالية صفراء أو برتقالية حمراء؛ تنتج خشباً متوسط الكثافة لأعمال الخزائن…)",
 "hibiscus esculentus": "أصابع الست, بامية (نبات حولي طويل وخشن من المناطق الاستوائية في العالم القديم يزرع على نطاق واسع في جنوب الولايات المتحدة وجزر الهند الغربية لقرونه الخضراء المخاطية…)",
 "hibiscus farragei": "كركديه شجيري (شجيرة أسترالية جنوبية وغربية ذات أوراق مسننة غير مفصصة أو مفصصة بشكل ضحل وأزهار أرجوانية؛ تصنف أحياناً ضمن جنس الكركديه)",
 "hibiscus heterophyllus": "شجرة الحميض (شجرة أسترالية ذات أوراق حمضية)",
 "hibiscus moschatus": "حب المسك, ختمية مسكية (عشب كثيف من آسيا الاستوائية يُزرع لزهوره الصفراء أو الوردية إلى القرمزية التي تشبه الخطمي)",
 "hibiscus moscheutos": "ختمية المستنقعات, ختمية وردية (شجيرة مبهرجة في المستنقعات المالحة بشرق الولايات المتحدة ذات زهور وردية كبيرة)",
 "hibiscus mutabilis": "ورد القطن, ورد كونفدرالي (شجيرة صينية أو شجرة صغيرة ذات زهور بيضاء أو وردية تصبح حمراء داكنة في الليل؛ تزرع على نطاق واسع؛ متوطنة في جنوب شرق الولايات المتحدة)",
 "hibiscus rosa-sinensis": "كركديه صيني, ورد صيني (شجيرة آسيوية كبيرة مبهرجة أو شجرة صغيرة ذات زهور حمراء إلى حمراء داكنة كبيرة مفردة أو مزدوجة)",
 "hibiscus sabdariffa": "حميض أحمر, غجر (عشبة سنوية شائكة قليلاً من شرق الهند أو شجيرة معمرة تزرع على نطاق واسع لكؤوسها اللحمية المستخدمة في الفطائر والهلام ولألياف اللحاء)",
 "hibiscus syriacus": "ختمية سورية, ورد شارون (شجيرة آسيوية أو شجرة شجيرية صغيرة ذات زهور وردية أو أرجوانية أو بيضاء مبهرجة على شكل جرس وأوراق ثلاثية الفصوص عادة؛ تزرع على نطاق واسع في أمريكا…)",
 "hibiscus tiliaceus": "ماجاجوا, ماهو (شجرة شجيرية واسعة الانتشار على طول الشواطئ الاستوائية؛ تنتج خشباً خفيفاً متيناً يستخدم لركائز الزوارق وأليافاً تستخدم للحبال والسد؛ تزرع غالباً للزينة)",
 "hibiscus trionum": "زهرة الساعة, كتمد (عشبة سنوية ضارة بزهور صفراء سريعة الزوال بعين أرجوانية؛ المناطق الاستوائية في العالم القديم؛ متوطنة كعشبة ضارة في أمريكا الشمالية)",
 "hiccough": "حازوقة, فواق (حالة حدوث تشنجات انعكاسية في الحجاب الحاجز مصحوبة بإغلاق سريع للمزمار مما ينتج صوتًا مسموعًا؛ أحيانًا تكون عرضًا لعسر الهضم)\nمثال: كيف تعالج الفواق؟",
 "hiccough nut": "جوز الفواق (شجيرة أفريقية زينية أو متسلقة ذات أزهار حمراء)",
 "hiccup": "حَازُوقَة / فُوَاق / فَوَاقَ",
 "hiccup nut": "جوز الفواق (شجيرة أفريقية زينية أو متسلقة ذات أزهار حمراء)",
 "hiccups": "حَازُوقَة",
 "hick": "بَسِيطٌ سَاذَج, رِيفِيّ (بَسِيطٌ بِطَرِيقَةٍ فَجَّةٍ وَقَرَوِيّ) / فلاح ساذج, قروي بسيط (شخص ليس ذكياً جداً أو غير مهتم بالثقافة)",
 "hickey": "علامة قبلة, لدغة حب (علامة حمراء مؤقتة على جلد الشخص ناتجة عن التقبيل أو المص من قبل الحبيب) / بثرة, حبة (ارتفاع ملتهب صغير في الجلد؛ بثرة أو حطاطة؛ عرض شائع في حب الشباب)",
 "hickory": "جوز أمريكي, هيكوري (شجرة خشب صلب أمريكية تحمل مكسرات صالحة للأكل) / جوز أمريكي, خشب الهيكوري (خشب صلب ثقيل قيم من أشجار الهيكوري المختلفة)",
 "hickory nut": "جوز الهيكوري (جوز صغير صلب القشرة لأشجار الهيكوري في أمريكا الشمالية)",
 "hickory pine": "صنوبر الجبل المسطح, صنوبر شائك (صنوبر مرتفعات صغير ثنائي الإبر من شرق الولايات المتحدة (الأبالاش) له لحاء بني داكن متقشر وحراشف مخروطية مدببة الأشواك)",
 "hickory tree": "جوز أمريكي, هيكوري (شجرة خشب صلب أمريكية تحمل مكسرات صالحة للأكل)",
 "hidatsa": "لغة هيداتسا (لغة سيووية يتحدث بها شعب هيداتسا) / هيداتسا (فرد من شعب السيوكس كان يسكن سابقاً منطقة على طول نهر ميسوري في غرب داكوتا الشمالية)",
 "hidatsa language": "لغة هيداتسا (لغة سيووية يتحدث بها شعب هيداتسا)",
 "hidden": "مُخْفًى, خَفِيّ (مُخْفَى هُوَ؛ مُخْفِي أَوْ مُخْفٍ)",
 "hidden agenda": "أَجَنْدَة",
 "hidden curriculum": "مَنْهَج خَفِيّ, مَنْهَج دِرَاسِيّ خَفِيّ",
 "hidden reserve": "احتياطي خفي (احتياطيات لا تظهر في الميزانية العمومية (كما هو الحال عن طريق تقليل القيم))",
 "hidden tax": "ضريبة خفية, ضريبة مستترة (ضريبة يدفعها المستهلك دون علمه (مثل الضرائب القيمية))",
 "hiddenite": "هيدنيت (شكل أخضر شفاف لمعدن السبودومين يستخدم كحجر كريم)",
 "hiddenness": "استتار, خفاء (حالة كونه خفياً ومستتراً)",
 "hide": "أَخْفَى, خَبَأَ / اِخْتَبَأَ (فعل مطاوعة لأَخْبَأَ، أخبأْتُهُ فأخْتَبَأ؛ خَبَّأ نفسه متعمدًا، أي أخْفَى نفسه عن الناس فلا يعلمون مكانه) / إِهَاب, جِلْد\nمثال: أين اختبأ ياني؟",
 "hide and go seek": "الغميضة, لعبة الاختباء (لعبة يغطي فيها طفل عينيه بينما يختبئ اللاعبون الآخرون ثم يحاول العثور عليهم)",
 "hide and seek": "غُمَّيْضَة",
 "hide-and-go-seek": "الغميضة, لعبة الاختباء (لعبة يغطي فيها طفل عينيه بينما يختبئ اللاعبون الآخرون ثم يحاول العثور عليهم)",
 "hide-and-seek": "الغميضة, لعبة الاختباء (لعبة يغطي فيها طفل عينيه بينما يختبئ اللاعبون الآخرون ثم يحاول العثور عليهم)",
 "hideaway": "مخبأ, ملاذ (منطقة يمكنك أن تكون فيها بمفردك) / مخبأ سري, وكر (مكان للاختباء؛ عادة مكان ناءٍ يستخدمه الخارجون عن القانون)",
 "hidebound": "ضَيِّقُ الأُفُقِ, مُتَزَمِّت (مُحَافِظٌ بِعِنَادٍ وَضَيِّقُ التَّفْكِيرِ)",
 "hideous": "بَشِع, مُنَفِّر (قبيح لدرجة تبعث على الرعب) / شَنِيع, فَظِيع (مسيء بشكل فاحش للآداب أو الأخلاق؛ مثير للرعب)",
 "hideously": "بشكل بشع, بفظاعة (بطريقة بشعة)\nمثال: تشوه وجهها بفظاعة بعد الحادث",
 "hideousness": "بشاعة, شناعة (قبح مريع؛ نفور فظيع)",
 "hideout": "مخبأ سري, وكر (مكان للاختباء؛ عادة مكان ناءٍ يستخدمه الخارجون عن القانون)",
 "hiding": "إخفاء, كتمان (نشاط إبقاء شيء ما سراً) / اختباء (حالة الاختباء)\nمثال: ذهب في الاختباء (تواري عن الأنظار)",
 "hiding place": "مخبأ (مكان مناسب لإخفاء شيء ما (مثل نفسك))",
 "hidrosis": "تعرق",
 "hidrotic": "عرقي (مكون من أو متعلق بالعرق)",
 "hiemal": "شِتْوِيّ (يتّصف بالشتاء أو يتعلّق به)",
 "hieracium aurantiacum": "حشيشة الغراب البرتقالية (حشيشة غراب أوروبية لها رؤوس زهرية بأشعة حمراء برتقالية زاهية؛ عشب ضار مزعج خاصة في شمال شرق أمريكا الشمالية؛ توضع أحياناً في جنس هيراسيوم)",
 "hieracium pilocella": "صقور أذن الفأر (صقور أوروبي ذو أوراق مشعرة ناعمة)",
 "hieracium pilosella": "صقور أذن الفأر (صقور أوروبي ذو أوراق مشعرة ناعمة)",
 "hieracium praealtum": "حشيشة الغراب الصفراء (حشيشة الغراب الأوروبية التي أدخلت إلى شمال شرق الولايات المتحدة؛ أعشاب ضارة مزعجة محلياً)",
 "hieracium venosum": "عشبة الأفعى المجلجلة (صقور ذو وريدة من الأوراق القاعدية ذات العروق الأرجوانية؛ من كندا إلى شمال جورجيا وكنتاكي)",
 "hierarch": "حبر, رئيس كهنة (رجل دين كبير وشخصية رفيعة المستوى) / رئيس كهنة, متصدر (شخص يشغل منصباً عالياً في تسلسل هرمي)",
 "hierarchal": "تسلسلي, هرمي (مصنف وفقاً لمعايير مختلفة في مستويات أو طبقات متتالية)\nمثال: قيل إن المجتمع الهرمي فقط مع وجود طبقة ترفيهية في القمة يمكنه إنتاج أعمال فنية",
 "hierarchic": "تسلسلي, هرمي (مصنف وفقاً لمعايير مختلفة في مستويات أو طبقات متتالية)\nمثال: قيل إن المجتمع الهرمي فقط مع وجود طبقة ترفيهية في القمة يمكنه إنتاج أعمال فنية",
 "hierarchical": "تسلسلي, هرمي (مصنف وفقاً لمعايير مختلفة في مستويات أو طبقات متتالية)\nمثال: قيل إن المجتمع الهرمي فقط مع وجود طبقة ترفيهية في القمة يمكنه إنتاج أعمال فنية",
 "hierarchical classification system": "نظام تصنيف هرمي (نظام تصنيف حيث يتم ترتيب المدخلات بناءً على بنية هرمية)",
 "hierarchical data structure": "بنية بيانات هرمية, بنية هرمية (بنية بيانات لها عدة مستويات مرتبة في هيكل شجري)",
 "hierarchical menu": "قائمة فرعية, قائمة هرمية (قائمة ثانوية تظهر أثناء وضع المؤشر فوق عنصر في القائمة الرئيسية)",
 "hierarchical structure": "بنية بيانات هرمية, بنية هرمية (بنية بيانات لها عدة مستويات مرتبة في هيكل شجري)",
 "hierarchically": "هَرَمِيًّا (بطريقة هرمية)\nمثال: منظم هرمياً",
 "hierarchisation": "تراتبية, تسلسل هرمي (فعل أو نتيجة إنشاء تسلسل هرمي)",
 "hierarchization": "تراتبية, تسلسل هرمي (فعل أو نتيجة إنشاء تسلسل هرمي)",
 "hierarchy": "هَرَمِيَّة, سِلْسِلَةُ مَراتِب",
 "hieratic": "كَهَنُوتِيّ, هِيرَاطِيقِيّ (يلتزم بأنماط وأساليب ثابتة؛ شديد التقييد والرسمية) / هيراطيقي (مكتوب بـ أو ينتمي إلى شكل متصل من الكتابة المصرية القديمة) / كهنوتي (مرتبط بالكهنوت أو الكهنة) / الخط الهيراطيقي, هيراطيقية (شكل متصل (مختزل) من الهيروغليفية المصرية؛ استخدمه الكهنة بشكل خاص)\nمثال: نص مصري هيراطيقي",
 "hieratic script": "الخط الهيراطيقي, هيراطيقية (شكل متصل (مختزل) من الهيروغليفية المصرية؛ استخدمه الكهنة بشكل خاص)",
 "hieratical": "كهنوتي (مرتبط بالكهنوت أو الكهنة)\nمثال: ثياب كهنوتية",
 "hierocracy": "حكم رجال الدين, هيروقراطية (هيئة حاكمة تتكون من رجال الدين)",
 "hieroglyph": "هِيرُوغْلِيفِيَّة",
 "hieroglyphic": "هيروغليفي (مكتوب بـ أو ينتمي إلى نظام كتابة يستخدم رموزاً تصويرية) / هيروغليفي الشكل (يشبه الكتابة الهيروغليفية) / كتابة هيروغليفية, هيروغليفية (نظام كتابة يستخدم رموزاً صورية؛ استُخدم في مصر القديمة) / كتابة هيروغليفية (كتابة تشبه الهيروغليفية (عادة لكونها غير مقروءة))",
 "hieroglyphical": "هيروغليفي (مكتوب بـ أو ينتمي إلى نظام كتابة يستخدم رموزاً تصويرية) / هيروغليفي الشكل (يشبه الكتابة الهيروغليفية)",
 "hieroglyphically": "هيروغليفياً (بواسطة الهيروغليفية)\nمثال: مكتوب هيروغليفياً",
 "hierolatry": "تقديس القديسين (عبادة القديسين)",
 "hifalutin": "مُتَعَاظِم, مُتَكَبِّر بِتَصَنُّع (متأنّق بتصنّع؛ يحمل جوًّا من الأهمية المصطنعة؛ متكبّر ومتعجرف)",
 "higgledy-piggledy": "بِفَوْضَى, رَأْسًا عَلَى عَقِب (بطريقة غير منظمة) / مَقْلُوبٌ رَأْسًا عَلَى عَقِب, مُبَعْثَر (فِي فَوْضَى عَارِمَة)\nمثال: كانت مكدسة بفوضى",
 "higgs boson": "بُوزُون هِيغْز",
 "high": "عَالٍ, اَلْعَالِي (افتقر واحتاج إلى مساعدة غيره المادية؛ عاله الشيء: اعوزه واحتاجه) / مَسْطُول\nمثال: بدأ يبكي بصوت عال",
 "high altar": "المذبح الرئيسي, المذبح العالي (المذبح الرئيسي في الكنيسة)",
 "high and low": "في كل حدب وصوب, في كل مكان (في كل مكان (عالياً ومنخفضاً))\nمثال: بحث في كل مكان",
 "high anglican church": "الأنجليكانية العليا, الكنيسة العليا (مجموعة في الكنيسة الأنجليكانية تؤكد على التقليد الكاثوليكي (خاصة في الأسرار والطقوس وطاعة سلطة الكنيسة))",
 "high anglicanism": "أنجلو-كاثوليكية (عقيدة وممارسة داخل كنيسة إنجلترا تؤكد على التقليد الكاثوليكي)",
 "high bar": "عقلة, قضيب أفقي (جهاز جمباز يتكون من قضيب مثبت في وضع أفقي بواسطة قائمين عند كلا الطرفين)",
 "high beam": "ضوء عالٍ (شعاع المصابيح الأمامية للسيارة الذي يوفر إضاءة بعيدة)",
 "high beam headlamp": "ضوء الطريق, ضوء عالي (مصباح أمامي للسيارة يوفر توزيعاً ساطعاً للضوء مركزاً في الوسط دون تحكم معين في الضوء الموجه نحو أعين مستخدمي الطريق الآخرين؛ وهو مناسب فقط للاستخدام…)\nمثال: تسمح لوائح اللجنة الاقتصادية لأوروبا الدولية بمصابيح أمامية عالية الشعاع ذات كثافة أعلى مما هو مسموح به بموجب لوائح أمريكا الشمالية",
 "high blood pressure": "ارتفاع ضغط الدم, فرط ضغط الدم (اضطراب شائع يظل فيه ضغط الدم مرتفعاً بشكل غير طبيعي (قراءة 140/90 ملم زئبقي أو أكثر))",
 "high brass": "نحاس أصفر عالي الزنك (نحاس أصفر يحتوي على 35% زنك)",
 "high church": "الأنجليكانية العليا, الكنيسة العليا (مجموعة في الكنيسة الأنجليكانية تؤكد على التقليد الكاثوليكي (خاصة في الأسرار والطقوس وطاعة سلطة الكنيسة))",
 "high colonic": "غسيل قولوني عالي (حقنة شرجية تحقن كميات كبيرة من السوائل عالياً في القولون لأغراض التنظيف)",
 "high comedy": "كوميديا راقية (كوميديا متطورة؛ غالباً ما تسخر من المجتمع الراقي)",
 "high command": "قيادة عليا, مقر القيادة العليا (أعلى القادة في منظمة (مثل القائد العام وكبار ضباط الجيش))",
 "high commission": "مفوضية عليا (سفارة لإحدى دول الكومنولث البريطاني في دولة أخرى تابعة للكومنولث)",
 "high commissioner": "مُفَوَّضٌ سَامٍ",
 "high country": "أراض مرتفعة, منطقة جبلية (منطقة تقع فوق سفوح الجبال ولكن تحت خط الأشجار)",
 "high court": "المحكمة العليا للولاية, محكمة عليا (أعلى محكمة في معظم ولايات الولايات المتحدة)",
 "high dudgeon": "حنق, غيظ مكتوم (شعور بالسخط الشديد)",
 "high energy physics": "فيزياء الجسيمات, فيزياء الطاقة العالية (فرع الفيزياء الذي يدرس الجسيمات دون الذرية وتفاعلاتها)",
 "high explosive": "مادة شديدة الانفجار, متفجرات قوية (مادة كيميائية متفجرة قوية تنتج غازاً بمعدل مرتفع جداً)",
 "high fashion": "أزياء راقية, هوت كوتور (أزياء تحدد اتجاهات الموضة)",
 "high fidelity": "دقة عالية (إعادة إنتاج الصوت مع قليل من التشويه أو بدونه)",
 "high fidelity sound system": "نظام صوت عالي الدقة, هاي فاي (معدات لاستنساخ الصوت بدقة عالية)",
 "high finance": "تمويل ضخم, معاملات مالية كبرى (معاملات مالية كبيرة ومعقدة)",
 "high five": "تَخْمِيسَة, كَفَّك",
 "high frequency": "تردد عالي, طبقة عالية (طبقة صوتية تُدرك على أنها أعلى من غيرها) / تَرَدُّد عَالٍ (3 إلى 30 ميجاهرتز)",
 "high gear": "الترس العالي, السرعة العالية (ترس أمامي بنسبة تروس تعطي أكبر سرعة للمركبة لسرعة محرك معينة)",
 "high german": "الألمانية العليا, اللغة الألمانية (اللغة الألمانية القياسية؛ تطورت تاريخيًا من الجرمانية الغربية)",
 "high german language": "الألمانية العليا, اللغة الألمانية (اللغة الألمانية القياسية؛ تطورت تاريخيًا من الجرمانية الغربية)",
 "high ground": "أرضية عليا, تفوق (موقف تفوق على الخصوم أو المنافسين)",
 "high hat": "قبعة رسمية, قبعة عالية (قبعة رجالية ذات تاج عالٍ؛ عادة ما تكون مغطاة بالحرير أو بفرو القندس) / صنج عالي القبعة (صنوج يتم تشغيلها بواسطة دواسة قدم)",
 "high heels": "كعب",
 "high heels shoe": "حذاء بكعب عال (نوع من الأحذية يكون فيه الكعب طويلاً أو مرتفعاً، مما يؤدي إلى ارتفاع كعب قدم المرتدي عن الأرض بشكل ملحوظ مقارنة بأصابع القدم)",
 "high holiday": "عيد مقدس كبير (أيام مقدسة يهودية يُحتفل بها بجدية خاصة)",
 "high holy day": "عيد مقدس كبير (أيام مقدسة يهودية يُحتفل بها بجدية خاصة)",
 "high horse": "استعلاء, فوقية (موقف يتسم بالفوقية والتعجرف)\nمثال: توقف عن استعلائك واعترف بأنك مخطئ",
 "high jinks": "عبث, لهو (مرح صاخب ومشاكس)",
 "high jinx": "عبث, لهو (مرح صاخب ومشاكس)",
 "high jump": "قفز عالي, وثب عالي (فعل القفز لأعلى ارتفاع ممكن فوق عارضة أفقية) / القفز العالي, الوثب العالي (مسابقة تتضمن القفز لأعلى ارتفاع ممكن فوق عارضة أفقية)",
 "high life": "إسراف, بذخ (نشاط الإنفاق المفرط)",
 "high mallow": "خبازة برية, خبازة طويلة (نبات معمر قائم أو منبطح من العالم القديم بعناقيد إبطية من الزهور الوردية الأرجوانية)",
 "high mass": "قداس احتفالي (قداس مهيب ومفصل مع موسيقى)",
 "high muckamuck": "شخصية هامة جداً, كبار الشخصيات (شخص مهم أو مؤثر (وغالباً ما يكون متسلطاً))",
 "high noon": "ظهر, ظهيرة (منتصف اليوم)",
 "high pitch": "تردد عالي, طبقة عالية (طبقة صوتية تُدرك على أنها أعلى من غيرها)",
 "high point": "أبرز نقطة, ذروة (الجزء الأكثر إمتاعًا في تجربة معينة)\nمثال: كان عزف البوق المنفرد هو أبرز نقطة في الحفل",
 "high priest": "حبر, رئيس كهنة (رجل دين كبير وشخصية رفيعة المستوى) / زعيم روحي, كاهن أعظم (سلطة بارزة أو مؤيد رئيسي لحركة أو مذهب ما)\nمثال: إنه الكاهن الأعظم لموسيقى الجاز المعاصرة",
 "high profile": "صيت ذائع, مكانة بارزة (موقف يجذب الكثير من الاهتمام والدعاية)",
 "high quality": "تفوق, جودة عالية (جودة كون الشيء متفوقاً)",
 "high relief": "نقش بارز عالي (نحت بارز تبرز فيه الأشكال من الخلفية لنصف عمقها على الأقل)",
 "high renaissance": "عصر النهضة العليا (الأسلوب الفني للرسم في أوائل القرن السادس عشر في فلورنسا وروما؛ يتميز بالإتقان التقني والتكوين البطولي والمحتوى الإنساني)",
 "high roller": "مقامر كبير, مقامر مغامر (مقامر يراهن بمبالغ كبيرة) / باذخ, منفق كبير (شخص ينفق ببذخ وتفاخر على الترفيه)\nمثال: آخر المنفقين الكبار",
 "high school": "مَدْرَسَة ثَانَوِيَّة (الموضع الذي تُدَرَّس فيه العلوم؛ البناء فيه عدة غرف تُدَرَّسُ فيها العلوم وتمنح شهادة رسمية بعد إكمال الدروس)\nمثال: لا أحب المدرسة.",
 "high seas": "أعالي البحار, مياه دولية (البحار المفتوحة في العالم خارج المياه الإقليمية لأي دولة)",
 "high season": "موسم الذروة (الموسم الذي يكون فيه السفر أكثر نشاطًا والأسعار أعلى)\nمثال: سافروا إلى أوروبا في موسم الذروة",
 "high sign": "إشارة خفية (إشارة صامتة للتحذير أو التعرف)\nمثال: بدأت في التحدث لكنه أعطاها إشارة خفية",
 "high society": "مُجْتَمَع رَاقِيّ (قد يقصد به المكان الذي يجتمع فيه الناس؛ مجموعة من الناس من طبقة اجتماعية واحدة تختلط ببعضها ولها ما يميزها عن غيرها من المجموعات البشرية)\nمثال: سامي خطر للمجتمع.",
 "high spirits": "ابتهاج, زهو (شعور بالفرح والفخر)",
 "high spot": "الجزء الأبرز, علامة مميزة (الجزء الأكثر إثارة للاهتمام أو الذي لا يُنسى)\nمثال: كان الجزء الأبرز في الجولة زيارتنا للفاتيكان",
 "high status": "مكانة عالية (منصب ذو مكانة متفوقة)",
 "high stepper": "حصان عالي الخطوة (حصان مدرب على رفع قدميه عالياً عن الأرض أثناء المشي أو الخبب)",
 "high street": "الشَارِع الرَئِيسِيّ",
 "high style": "أزياء راقية, هوت كوتور (أزياء تحدد اتجاهات الموضة)",
 "high table": "مائدة عليا (طاولة طعام في قاعة طعام مرفوعة على منصة؛ وتخصص المقاعد للأشخاص المتميزين)",
 "high tea": "شاي العشاء, هاي تي (وجبة مسائية مبكرة دسمة تشمل الشاي)",
 "high tech": "تقنية عالية, تكنولوجيا عالية (تطور تكنولوجي متقدم للغاية (خاصة في الإلكترونيات))",
 "high technology": "تِقْنِيَّة عَالِيَّة",
 "high temperature": "حرارة, سخونة (وجود الحرارة)",
 "high tide": "ذروة المد, مد عالي (المد عندما يكون الماء في أعلى مستوياته)",
 "high time": "آن الأوان (الوقت الذي كان ينبغي أن يتم فيه شيء ما)\nمثال: لقد آن الأوان لكي تذهب إلى العمل",
 "high treason": "خِيَانَة عُظْمَى",
 "high up": "عالياً, في الأعالي (على ارتفاع كبير)\nمثال: تسلق عالياً على السلم",
 "high voltage": "الفُوُلطِيَةُ مُرتَفِعَةٌ",
 "high vowel": "صائت مرتفع, صائت مغلق (صوت صائت يُصنع واللسان بالقرب من سقف الحلق)",
 "high water": "ذروة المد, مد عالي (المد عندما يكون الماء في أعلى مستوياته)",
 "high wind": "رياح شديدة (رياح قوية جداً)\nمثال: غطت الأمطار والرياح الشديدة المنطقة",
 "high wire": "سلك عالي (حبل مشدود عالياً جداً فوق الأرض)",
 "high-altitude": "عَالِي الارْتِفَاع (يحدث عند ارتفاع عالٍ نسبيّاً أو منه)",
 "high-and-mighty": "مُتَجَبِّر, مُتَسَلِّط (مُعْتَدّ بِنَفْسِهِ بِشَكْلٍ مُسِيء أَوْ يُمَارِس سُلْطَةً غَيْر مُبَرَّرَة)",
 "high-angle fire": "نيران بزاوية عالية (نيران من مدفع يتم إطلاقها بارتفاع أكبر من الارتفاع الأقصى للمدى)",
 "high-angle gun": "مدفع الهاون, مدفع عالي الزاوية (مدفع يمكن إطلاقه بزاوية مرتفعة لمديات قصيرة نسبياً)",
 "high-backed": "ذُو ظَهْر عَالٍ (ذو مسند ظهر مرتفع)",
 "high-bush blueberry": "توت أزرق عالي الشجيرة (شجيرة متساقطة الأوراق عالية النمو من شرق أمريكا الشمالية تحمل توتاً مائلاً للزرقة إلى السواد صالحاً للأكل مع طبقة شمعية مميزة؛ مصدر لمعظم التوت…)",
 "high-ceilinged": "عَالِي السَّقْف (ذو سقف أعلى من المعتاد)",
 "high-class": "رَاقٍ بِتَصَنُّع (أنيق بشكل مُتَظَاهَر)",
 "high-crowned": "عَالِي القُبَّةِ ((عن القبعة) ذو قبة عالية)",
 "high-definition television": "تلفزيون عالي الوضوح (نظام تلفزيوني يحتوي على عدد أكبر من الخطوط لكل إطار بحيث تظهر صوره تفاصيل أكثر)",
 "high-density lipoprotein": "بروتين دهني عالي الكثافة (بروتين دهني ينقل الكوليسترول في الدم؛ يتكون من نسبة عالية من البروتين وقليل نسبياً من الكوليسترول؛ يُعتقد أن المستويات العالية منه ترتبط بانخفاض خطر…)",
 "high-energy": "جَبَّار, عَالِي الطَّاقَة (شديد النشاط أو القوّة) / عَالِي الطَّاقَة (يوفّر كمية كبيرة نسبياً من الطاقة عند التفاعل الكيميائي) / عالي الطاقة (مكون من أو متعلق بجسيمات أولية ذات طاقات تبلغ مئات الآلاف من الإلكترون فولت)",
 "high-energy physics": "فيزياء الجسيمات, فيزياء الطاقة العالية (فرع الفيزياء الذي يدرس الجسيمات دون الذرية وتفاعلاتها)",
 "high-fidelity": "عَالِي الدِّقَّة (يتّسم بالحدّ الأدنى من التشويه في إعادة إنتاج الصوت)",
 "high-five": "كف بكف, هاي فايف (إيماءة للتحية أو الابتهاج؛ يضرب كف شخص مرفوع كف شخص آخر مرفوع)",
 "high-flown": "رَفِيع, سَامٍ (ذو قيمة أخلاقية أو فكرية عالية؛ سامٍ في طبيعته أو أسلوبه) / رَنَّان, مُتَضَخِّم (متصنّع (خاصة فيما يتعلق باللغة أو المُثُل))",
 "high-grade": "مُرْتَفِع الدَّرَجَة",
 "high-handed": "مُتَعَالٍ, مُتَعَجْرِف (يَتَّسِم بِتَجَاهُل مُتَعَالٍ لِلآخَرِين)",
 "high-handedly": "باستبداد, بتعسف (بطريقة متسلطة ومتغطرسة)\nمثال: تصرف بتعسف تجاه موظفيه",
 "high-handedness": "تكبر, عنجهية (فخر متغطرس يظهر من خلال التصرف بفوقية تجاه من هم أقل شأناً)",
 "high-hat cymbal": "صنج عالي القبعة (صنوج يتم تشغيلها بواسطة دواسة قدم)",
 "high-heeled shoe": "حذاء بكعب عال (نوع من الأحذية يكون فيه الكعب طويلاً أو مرتفعاً، مما يؤدي إلى ارتفاع كعب قدم المرتدي عن الأرض بشكل ملحوظ مقارنة بأصابع القدم)",
 "high-interest": "عالي الفائدة ((تستخدم للقروض) تفرض نسبة كبيرة نسبياً من المبلغ المقترض)",
 "high-keyed": "شَدِيد الحَسَاسِيَّة, عَصَبِيّ المِزَاج ((عن الأشخاص) سريع الاستثارة)",
 "high-level": "عَالِي الارْتِفَاع (يحدث عند ارتفاع عالٍ نسبيّاً أو منه) / رَفِيع المُسْتَوَى (في مستوى مرتفع من الرتبة أو الأهمية)",
 "high-level formatting": "تهيئة عالية المستوى ((علوم الكمبيوتر) تنسيق الدليل الجذري وجداول تخصيص الملفات والتكوينات الأساسية الأخرى)",
 "high-level language": "لغة عالية المستوى (لغة موجهة للمشاكل تتطلب معرفة قليلة بالحاسوب الذي ستعمل عليه)",
 "high-level radioactive waste": "نفايات مشعة عالية المستوى (نفايات مشعة تتبقى في مفاعل نووي بعد استهلاك الوقود النووي)",
 "high-low": "هاي-لو (بوكر تقسم فيه الأيدي العالية والمنخفضة الرهان)",
 "high-low-jack": "أول فورز (ألعاب ورق يتم فيها كسب النقاط لأخذ الأوراق العالية أو المنخفضة أو الولد أو اللعبة)",
 "high-minded": "رَفِيع, سَامٍ (ذو قيمة أخلاقية أو فكرية عالية؛ سامٍ في طبيعته أو أسلوبه)",
 "high-mindedly": "بترفّع, بنبل (بطريقة نبيلة وسامية)\nمثال: يتحدث بنبل، لكننا لا نعرف ما إذا كان يتصرف وفقاً لمبادئه",
 "high-mindedness": "ترفّع, سمو النفس (المبادئ أو السلوك السامي؛ صفة الاعتقاد بضرورة السعي وراء المثل العليا)",
 "high-muck-a-muck": "شخصية مغرورة (شخص متعجرف أو مغرور ذو أهمية)",
 "high-necked": "عَالِي الرَّقَبَة ((للملابس) ذو فتحة عنق مرتفعة)",
 "high-octane": "جَبَّار, عَالِي الطَّاقَة (شديد النشاط أو القوّة) / عَالِي الأُوكْتَان (يُستخدم عن البنزين؛ ذو رقم أوكتان عالٍ)",
 "high-pass filter": "مرشح الترددات العالية (مرشح يمرر الترددات فوق قيمة معينة ويخفف الترددات الأقل من تلك القيمة)",
 "high-performance": "عَالِي الأَدَاء (مُعدَّل لتقديم أداء متفوق)",
 "high-pitched": "حاد, عالي النبرة (تستخدم للأصوات والأصوات البشرية؛ عالية في النغمة أو التردد) / شَدِيد المَيْل (مضبوط بزاوية حادَّة أو عالية)",
 "high-potential": "عَالِي الجُهْد (يعمل على جهد كهربائي مرتفع أو يُشغَّل به)",
 "high-power": "جَبَّار, عَالِي الطَّاقَة (شديد النشاط أو القوّة)",
 "high-powered": "جَبَّار, عَالِي الطَّاقَة (شديد النشاط أو القوّة) / عَالِي القُدْرَة ((عن المجاهر) قادر على درجة عالية من التكبير)",
 "high-pressure": "ضَاغِط, عَنِيف الإِقْنَاع (مُقنِع بإلحاح وعدوانية)",
 "high-priced": "ثَمِين, غَالٍ (ذو سعر مرتفع)",
 "high-principled": "رَفِيع المَبَادِئ, سَامِي الأَخْلَاق (ذو مبادئ أخلاقية رفيعة وعالية)",
 "high-protein diet": "حمية عالية البروتين, نظام غذائي غني بالبروتين (نظام غذائي غني بالبروتينات النباتية والحيوانية؛ يستخدم لعلاج سوء التغذية أو لزيادة الكتلة العضلية)",
 "high-ranking": "عَالِيّ الرُتْبَة",
 "high-resolution": "عالي الدقة (إنتاج صور حادة ومفصلة بدقة)\nمثال: تصوير عالي الدقة",
 "high-rise": "شاهق, ناطح للسحاب (تستخدم للمباني ذات الطوابق المتعددة المجهزة بمصاعد؛ طويل) / برج سكني, مبنى شاهق (برج يتكون من مبنى متعدد الطوابق للمكاتب أو الشقق)\nمثال: شوارع تصطف على جانبيها مبانٍ سكنية شاهقة",
 "high-risk": "خَطِر, مُحْفُوفٌ بِالمَخَاطِر (غير آمن ماليًّا؛ ينطوي على مضاربة ومخاطرة عالية)",
 "high-sounding": "رَنَّان, مُتَضَخِّم (متصنّع (خاصة فيما يتعلق باللغة أو المُثُل))",
 "high-speed": "عَالِي السُّرْعَة (يَعْمَل بِسُرْعَة عَالِيَة)",
 "high-speed rail": "سِكَّةٌ حَدِيدِيَّةٌ فَائِقَةُ السُّرْعَةِ",
 "high-speed steel": "فولاذ العمل الساخن, فولاذ عالي السرعة (فولاذ سبائكي يظل صلباً عند الاحمرار؛ يستخدم لصنع أدوات قطع المعادن)",
 "high-spirited": "فَيَّاض, مُتَدَفِّق (طافح بالفرح والحيويّة بلا قيود)",
 "high-spiritedness": "حماس عال, معنويات عالية (حيوية مفرطة)",
 "high-stepped": "عَالِي الخَطْو (ذو خطوة عالية أو يتحرَّك بخطوة مرتفعة)",
 "high-stepping": "عَالِي الخَطْو (ذو خطوة عالية أو يتحرَّك بخطوة مرتفعة)",
 "high-strength brass": "برونز منغنيزي, نحاس أصفر منغنيزي (نحاس أصفر يحتوي على 1-4% منغنيز لزيادة صلابته)",
 "high-strung": "حَسَّاسُ الأَعْصَاب, عَصَبِيّ (فِي حَالَةِ تَوَتُّرٍ وَانْفِعَال)",
 "high-sudsing": "عالي الرغوة, كثير الرغوة ((تستخدم للمنظفات) تنتج رغوة كثيرة)",
 "high-tech": "تكنولوجيا متطورة, عالي التقنية (يشبه أو يستخدم تكنولوجيا أو أجهزة متقدمة للغاية)",
 "high-tension": "توتر عال, ضغط عال (خاضع لـ أو قادر على العمل تحت جهد كهربائي مرتفع نسبياً)\nمثال: سلك ضغط عالٍ",
 "high-toned": "رَاقٍ بِتَصَنُّع (أنيق بشكل مُتَظَاهَر)",
 "high-top": "عَالِي السَّاق ((للأحذية أو الجزم) ذو رقبة مرتفعة نسبيّاً)",
 "high-topped": "عَالِي السَّاق ((للأحذية أو الجزم) ذو رقبة مرتفعة نسبيّاً)",
 "high-up": "شخصية هامة جداً, كبار الشخصيات (شخص مهم أو مؤثر (وغالباً ما يكون متسلطاً))",
 "high-velocity": "عَالِي السُّرْعَة (يَعْمَل بِسُرْعَة عَالِيَة)",
 "high-vitamin diet": "حمية غنية بالفيتامينات (نظام غذائي مصمم للمرضى الذين يعانون من نقص الفيتامينات)",
 "high-voltage": "جَبَّار, عَالِي الطَّاقَة (شديد النشاط أو القوّة) / عَالِي الجُهْد (يعمل على جهد كهربائي مرتفع أو يُشغَّل به)",
 "high-warp loom": "نول عمودي (نول يدوي يتم فيه حمل السداة عمودياً؛ لنسج المفروشات)",
 "high-water mark": "علامة المد العالي (خط يحدد أعلى مستوى تم الوصول إليه)",
 "high-yield": "عَالِي الإِنْتَاجِيَّة (يُنْتِجُ كَمِّيَّة كَبِيرَة مِنَ المُنْتَجَات الزِّرَاعِيَّة أَوِ الصِّنَاعِيَّة)",
 "high-yield bond": "سند خردة, سند عالي العائد (سند (مضاربة) بتصنيف ائتماني منخفض؛ يصدر لعمليات الاستحواذ بالرافعة المالية وغيرها من عمليات الاستحواذ من قبل شركات ذات ائتمان مشكوك فيه)",
 "highball": "هايبول (مشروب مخلوط مصنوع من مشروب كحولي ممزوج بالماء أو مشروب غازي ويقدم في كأس طويل)",
 "highball glass": "كأس طويلة (كأس طويل لتقديم المشروبات الممزوجة)",
 "highbinder": "سياسي فاسد (سياسي فاسد)",
 "highboard": "لوح غطس عالٍ (لوح غطس مرتفع)",
 "highborn": "حَامِل لَقَب نَبِيل, رَفِيع النَّسَب (ينتمي إلى طبقة النبلاء ذوي الألقاب)",
 "highboy": "خزانة أدراج عالية (خزانة أدراج طويلة مقسمة إلى قسمين وتستند على أربع أرجل)",
 "highbrow": "رَاقٍ, مُثَقَّف (على درجة عالية من الثقافة أو التعليم) / مثقف رفيع, نخبوي (شخص ذو أذواق فكرية أو علمية رفيعة)",
 "highbrowed": "رَاقٍ, مُثَقَّف (على درجة عالية من الثقافة أو التعليم)",
 "highbush cranberry": "رباطية ثلاثية الفصوص, شجيرة التوت البري الأمريكية (شجيرة نفضية أو شجرة صغيرة من أمريكا الشمالية لها أوراق ثلاثية الفصوص وتوت أحمر)",
 "highchair": "كُرْسِيّ اَلْأَطْفَال مُرْتَفَع (مَقْعَد لواحد؛ العِلْم. يقال هو من أهل الكُرسِيّ أي أهل العِلم)\nمثال: أحب ذاك الكرسي.",
 "higher cognitive process": "عملية معرفية عليا (عمليات معرفية تفترض توفر المعرفة وتضعها موضع الاستخدام)",
 "higher criticism": "النقد الأعلى (الدراسة العلمية للكتابات الكتابية لتحديد أصلها ومعناها)",
 "higher education": "تعليم عالي (التعليم الذي تقدمه كلية أو جامعة)",
 "higher law": "قَانُون أَسْمَى, قَانُون إِلَهِيّ (مبدأ له الأسبقية على قوانين المجتمع)",
 "higher national diploma": "الدبلوم الوطني العالي (دبلوم يُمنح للتدريب المهني الذي يعد الطالب لمهنة في مجال معين؛ قد يتقدم الطلاب المتفوقون لدورة تؤدي إلى درجة علمية)",
 "higher rank": "أقدمية (رتبة أعلى من الآخرين خاصة بسبب الخدمة الأطول)",
 "higher status": "أقدمية (رتبة أعلى من الآخرين خاصة بسبب الخدمة الأطول)",
 "higher up": "فوق, في الأعلى (في أو إلى مكان أعلى)",
 "higher-ranking": "أَعْلَى رُتْبَة, رَفِيع المَقَام (ذو رتبة أعلى من غيره)",
 "higher-up": "أعلى مرتبة, رئيس (شخص ذو رتبة أو مكانة أو جودة أعلى)",
 "highest common factor": "العَامِل المُشْتَرَك الأَكْبَر, القَاسِم المُشْتَرَك الأَكْبَر (أكبر عدد صحيح يقسم مجموعة من الأعداد الصحيحة بدون باقي)",
 "highfalutin": "مُتَعَاظِم, مُتَكَبِّر بِتَصَنُّع (متأنّق بتصنّع؛ يحمل جوًّا من الأهمية المصطنعة؛ متكبّر ومتعجرف)",
 "highfaluting": "مُتَعَاظِم, مُتَكَبِّر بِتَصَنُّع (متأنّق بتصنّع؛ يحمل جوًّا من الأهمية المصطنعة؛ متكبّر ومتعجرف)",
 "highflier": "طموح, ناجح جداً (شخص ذو قدرة وطموح كبيرين)",
 "highflyer": "طموح, ناجح جداً (شخص ذو قدرة وطموح كبيرين)",
 "highjack": "اختطاف مركبة (الاستيلاء على مركبة أثناء النقل إما لسرقتها أو لتحويل مسارها إلى وجهة بديلة)",
 "highjacker": "قاطع طريق (شخص يوقف مركبة ويسرق منها) / خاطف الطائرة (شخص يستخدم القوة للاستيلاء على مركبة (خاصة طائرة) للوصول إلى وجهة بديلة)",
 "highjacking": "اختطاف, قرصنة (سرقة مسافر أو مركبة أثناء النقل أو الاستيلاء على مركبة باستخدام القوة)",
 "highland": "نَجْد, صَعِيد (مصدر للفعل \"نَجَدَ\"؛ إقليم يشكِّل وسط المملكة العربية السعودية الجغرافي، حيث يحُل ثلث مساحتها)\nمثال: علينا أن نجد حلا.",
 "highland fling": "هايلاند فلينغ (رقصة ريل اسكتلندية قوية)",
 "highland scot": "جبلي اسكتلندي (مواطن من مرتفعات اسكتلندا)",
 "highlander": "جَبَلِيّ, نَجْدِيّ",
 "highlife": "إسراف, بذخ (نشاط الإنفاق المفرط)",
 "highlight": "إبراز ضوئي, منطقة مضيئة (منطقة من السطوع في الصورة) / الجزء الأبرز, علامة مميزة (الجزء الأكثر إثارة للاهتمام أو الذي لا يُنسى)\nمثال: كان الجزء الأبرز في الجولة زيارتنا للفاتيكان",
 "highlighter": "قلم تحديد, قلم تظليل (قلم تمييز فلوري يستخدم لتمييز الفقرات المهمة في النص) / قلم تمييز, هايلايتر (مستحضر تجميل يستخدم لإبراز العيون أو عظام الوجنتين)",
 "highlighting": "إبراز ضوئي, منطقة مضيئة (منطقة من السطوع في الصورة)",
 "highly": "رفيعاً, عالياً (في منصب أو مستوى أو رتبة عالية) / بشكل كبير, جداً (إلى درجة أو مدى عال؛ بشكل إيجابي أو باحترام كبير) / بأجر عالٍ (بمعدل أو أجر مرتفع)\nمثال: تفاصيل لا يعرفها سوى قلة من الأشخاص ذوي المناصب الرفيعة",
 "highly active antiretroviral therapy": "علاج مضاد للفيروسات القهقرية عالي النشاط, كوكتيل دوائي (مزيج من مثبطات البروتياز تؤخذ مع مثبطات المنتسخة العكسية؛ يستخدم في علاج الإيدز وفيروس نقص المناعة البشرية)",
 "highly infective": "شَدِيد العَدْوَى ((عن الكائنات الدقيقة) بالغ القدرة على نقل العدوى)",
 "highly strung": "حَسَّاسُ الأَعْصَاب, عَصَبِيّ (فِي حَالَةِ تَوَتُّرٍ وَانْفِعَال)",
 "highly-developed": "مُتَقَدِّم صِنَاعِيًّا ((عن المجتمعات) ذو تطوّر صناعيّ عالٍ)",
 "highly-sexed": "مُفْرِط الشَّهْوَة (ذو رغبة أو جاذبية جنسية مفرطة)",
 "highness": "سُمُوّ (العُلُوّ والرفعةُ؛ لقب تكريم) / سُمُوَّة\nمثال: أرفض أن أنادى بغير \"صاحب السمو\".",
 "highroad": "طريق رئيسي (طريق سريع)",
 "highschool": "مدرسة ثانوية, مدرسة ثانوية عليا (مدرسة ثانوية عامة تشمل عادة الصفوف من 9 إلى 12)\nمثال: يذهب إلى المدرسة الثانوية في الحي",
 "highwater": "ذروة المد, مد عالي (المد عندما يكون الماء في أعلى مستوياته)",
 "highway": "طَرِيق, طَرِيق عَامّ (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من ٱلشَّارِعِ، سَبِيل)\nمثال: أسأل عن الطريق.",
 "highway code": "قانون السير, قواعد المرور (مجموعة القواعد التي تحكم استخدام الطرق العامة)",
 "highway engineer": "مهندس طرق (مهندس مدني يتخصص في تصميم وبناء الطرق والطرق السريعة)",
 "highway robbery": "قطع الطريق (سلب المسافرين على طريق عام أو بالقرب منه) / سرقة علنية, سعر فاحش (سعر باهظ جداً)\nمثال: ما يطلبونه للوقود هذه الأيام هو سرقة علنية",
 "highway system": "نظام الطرق السريعة (نظام نقل يتكون من طرق للنقل بالسيارات)",
 "highwayman": "قاطِعُ طَرِيق, قُطّاعُ ٱلطُّرُق",
 "highwaywoman": "قاطعة طريق (لصة أنثى تقوم بإيقاف المركبات وسرقتها)",
 "higi": "هيجي (لغة تشادية يتم التحدث بها جنوب بحيرة تشاد، وخاصة في ولاية أداماوا)",
 "higi language": "هيجي (لغة تشادية يتم التحدث بها جنوب بحيرة تشاد، وخاصة في ولاية أداماوا)",
 "hijab": "حِجَاب, خِمَار (الغطاء أو الساتر؛ يُطلق مجازا على لباس المرأة الذي يستر جميع جسمها) / اِحْتِجَاب\nمثال: ارتدت أمها الحجاب.",
 "hijabi": "مُحَجَّبَة, مُتَحَجِّبَة",
 "hijack": "خَطَفَ (كلمة \"خَطِفَ\" تعني سرق أو أخذ بسرعة و فجأة. يُمكن استخدامها بمعنى \"خَطَفَ الشيءَ\" أي سرقه؛ يدل على سرعةٍ وفجائيةٍ في الأثر، سواء كان ذلك على العقل أو البصر أو حتى على قدرة الاستماع) / إِخْتِطَاف",
 "hijacker": "قاطع طريق (شخص يوقف مركبة ويسرق منها) / خاطف الطائرة (شخص يستخدم القوة للاستيلاء على مركبة (خاصة طائرة) للوصول إلى وجهة بديلة)",
 "hijacking": "اِخْتِطَاف",
 "hijazi arabic": "العَرَبِيَّة الحِجَازِيِّة, اللَّهْجَة الحِجَازِيِّة",
