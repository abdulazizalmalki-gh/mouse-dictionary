 "huainan": "خْوَايْنَان / هْوَايْنَان",
 "hualapai": "لغة والاباي (اللغة اليومية التي يتحدث بها شعب والاباي) / والاباي (فرد من شعب في أمريكا الشمالية كان يعيش سابقاً في وادي نهر كولورادو في أريزونا)",
 "hualapai language": "لغة والاباي (اللغة اليومية التي يتحدث بها شعب والاباي)",
 "hualpai": "لغة والاباي (اللغة اليومية التي يتحدث بها شعب والاباي) / والاباي (فرد من شعب في أمريكا الشمالية كان يعيش سابقاً في وادي نهر كولورادو في أريزونا)",
 "hualpai language": "لغة والاباي (اللغة اليومية التي يتحدث بها شعب والاباي)",
 "huamachil": "تمرهندي مانيلا, كاماشيل (شجرة استوائية أمريكية شائكة شائعة ذات عناقيد طرفية من الزهور الصفراء تليها قرون صالحة للأكل منجلية أو دائرية وتنتج خشباً جيداً وصبغة صفراء وصمغاً…)",
 "huarache": "واراشي (صندل بكعب مسطح وجزء علوي من أشرطة جلدية منسوجة)",
 "huaraches": "واراشي (صندل بكعب مسطح وجزء علوي من أشرطة جلدية منسوجة)",
 "huayna capac": "واينا كاباك (حاكم الإنكا الذي وصلت الإمبراطورية في عهده إلى أقصى اتساع لها (توفي عام 1525))",
 "hub": "صرة, محور العجلة (الجزء المركزي لعجلة السيارة (أو المروحة ونحوها) الذي يمر من خلاله العمود أو المحور) / محور, مركز نشاط (مركز للنشاط أو الاهتمام أو التجارة أو النقل؛ نقطة محورية تدور حولها الأحداث)\nمثال: الملعب هو محور إشراف الوالدين",
 "hub-and-spoke": "نظام المحور والأطراف (نظام للنقل الجوي تقدم فيه المطارات المحلية النقل الجوي إلى مطار مركزي حيث تتوفر رحلات لمسافات طويلة)",
 "hub-and-spoke system": "نظام المحور والأطراف (نظام للنقل الجوي تقدم فيه المطارات المحلية النقل الجوي إلى مطار مركزي حيث تتوفر رحلات لمسافات طويلة)",
 "hubbard squash": "قرع هبارد (قرع شتوي كبير كروي الشكل ذو قشرة رمادية خضراء ثؤلولية) / قرع شتوي, قرع هوبارد (أي من عدة نباتات قرع شتوي تنتج ثماراً كبيرة رمادية مخضرة على شكل كرة قدم بقشرة ثؤلولية خشنة)",
 "hubble constant": "ثَابِت هَابل, مُعَامِل هَابل ((في علم الكونيات) نسبة سرعة ابتعاد مجرة ما (بسبب توسع الكون) إلى بعدها عن المراقب؛ ثابت هابل ليس ثابتاً في الواقع، بل يُعتبر مقياساً لمعدل التوسع…)",
 "hubble law": "قانون هابل ((فلك) التعميم القائل بأن سرعة ابتعاد المجرات البعيدة (الانزياح الأحمر) تتناسب مع بعدها عن المراقب)",
 "hubble parameter": "ثَابِت هَابل, مُعَامِل هَابل ((في علم الكونيات) نسبة سرعة ابتعاد مجرة ما (بسبب توسع الكون) إلى بعدها عن المراقب؛ ثابت هابل ليس ثابتاً في الواقع، بل يُعتبر مقياساً لمعدل التوسع…)",
 "hubble's constant": "ثَابِت هَابل, مُعَامِل هَابل ((في علم الكونيات) نسبة سرعة ابتعاد مجرة ما (بسبب توسع الكون) إلى بعدها عن المراقب؛ ثابت هابل ليس ثابتاً في الواقع، بل يُعتبر مقياساً لمعدل التوسع…)",
 "hubble's law": "قانون هابل ((فلك) التعميم القائل بأن سرعة ابتعاد المجرات البعيدة (الانزياح الأحمر) تتناسب مع بعدها عن المراقب)",
 "hubble's parameter": "ثَابِت هَابل, مُعَامِل هَابل ((في علم الكونيات) نسبة سرعة ابتعاد مجرة ما (بسبب توسع الكون) إلى بعدها عن المراقب؛ ثابت هابل ليس ثابتاً في الواقع، بل يُعتبر مقياساً لمعدل التوسع…)",
 "hubble-bubble": "أرجيلة, شيشة (غليون تبغ شرقي ذو أنبوب مرن طويل متصل بوعاء حيث يتم تبريد الدخان بمروره عبر الماء)\nمثال: عالم ثنائي القطب مع الأرجيلة والقهوة التركية مقابل الهامبرغر والكوكا كولا",
 "hubbly-bubbly": "أرجيلة, شيشة (غليون تبغ شرقي ذو أنبوب مرن طويل متصل بوعاء حيث يتم تبريد الدخان بمروره عبر الماء)\nمثال: عالم ثنائي القطب مع الأرجيلة والقهوة التركية مقابل الهامبرغر والكوكا كولا",
 "hubbub": "جَلَبَة, صَخَب",
 "hubby": "زوج (رجل متزوج؛ شريك المرأة في الزواج)",
 "hubcap": "طاسة العجلة, غطاء العجلة (غطاء يركب فوق محور العجلة)",
 "hubei": "خُوبِي, هُوبِي",
 "hubris": "غَطْرَسَة",
 "huck": "قماش هوك, هوكاباك (قماش مناشف يتكون من نسيج قطني أو كتاني خشن ماص)",
 "huckaback": "قماش هوك, هوكاباك (قماش مناشف يتكون من نسيج قطني أو كتاني خشن ماص)",
 "huckleberry": "عنبية آسية (توت أزرق مسود يشبه التوت الأزرق والعنبية في شرق الولايات المتحدة) / توت العليق (أي من الشجيرات المتعددة من جنس جيلوساكيا تحمل توتاً صغيراً يشبه التوت الأزرق) / عنب الأحراش (أي من نباتات التوت الداكن تمييزاً عن التوت الأزرق)",
 "huckleberry oak": "بلوط التوت (شجيرة منخفضة منتشرة أو زاحفة في جنوب غرب الولايات المتحدة ذات بلوط صغير وأوراق تشبه أوراق التوت البري)",
 "huckster": "بائع متجول لبضائع رديئة (بائع لبضائع رديئة) / كاتب إعلانات (شخص يكتب إعلانات الراديو أو التلفزيون)",
 "hud": "هُود ((في الإسلام) نبي ورد ذكره في القرآن، وسميت على اسمه سورة فيه، أُرسل إلى قوم عَاد؛ سُورَةُ هُود، السورة الحادية عشر في القرآن)\nمثال: حصل زيري على دور روبن هود.",
 "huddle": "تشاور سريع ((غير رسمي) مؤتمر خاص سريع) / تجمهر, لمة (حشد غير منظم ومكتظ)\nمثال: تجمهر لنساء خائفات",
 "huddled": "مُتَرَاكِم, مُتَكَدِّس (مُتَجَمِّعٌ وَمُتَكَدِّسٌ بَعْضُهُ فَوْقَ بَعْضٍ)",
 "huddler": "مُتَجَمِّع, مُتَكَوِّم (شخص يجثم أو يتكوم على نفسه) / عُضْو فِي حَلْقَة, مُتَكَتِّل (عضو في مجموعة متجمهرة (تجمع))",
 "hudood": "حدود (القوانين الإسلامية التي تبين الحدود التي أمر بها الله وتشمل العقوبات الرادعة للجرائم الخطيرة)",
 "hudson": "نَهْر هَدْسُون (صَارَ عَصَبِيًّا وغَضِبَ؛ أَصَابَ الشَّيْءَ أو الكَائِنَ بِغَضَبٍ أو صَارَ يَأْمُرُهُ) / هَدْسُون\nمثال: عبر جوناس النهر.",
 "hudson bay": "خَلِيج هَدْسُون",
 "hudson bay collared lemming": "لاموس خليج هدسون المطوق (من شمال كندا)",
 "hudson river school": "الواقعية الرومانسية, مدرسة نهر هدسون (أول مدرسة متماسكة للفن الأمريكي؛ نشطت من 1825 إلى 1870؛ رسمت مناظر طبيعية برية لوادي نهر هدسون ونيو إنجلاند المحيطة)",
 "hudson seal": "فراء الفقمة المقلد, فراء هدسون سيل (فراء جرذ المسك المعالج ليحاكي جلد الفقمة)",
 "hudsonia ericoides": "خلنج ذهبي, خلنج كاذب (نبات أمريكي شمالي دائم الخضرة منبطح يشبه الخلنج بزهور صفراء)",
 "hudsonia tomentosa": "خلنج الشاطئ, عشب الفقر (نبات صغير يشبه الخلنج مغطى بزغب أبيض ينمو على الشواطئ في شمال شرق أمريكا الشمالية)",
 "hudsonian godwit": "بقويقة هدسونية (بقويقة من العالم الجديد)",
 "hudud": "جريمة حدية, حد ((الإسلام) جرائم خطيرة يرتكبها المسلمون ويعاقب عليها بعقوبات مقررة في القرآن) / حدود (القوانين الإسلامية التي تبين الحدود التي أمر بها الله وتشمل العقوبات الرادعة للجرائم الخطيرة)\nمثال: تشمل جرائم الحدود الردة عن الإسلام والقتل والسرقة والزنا",
 "hue": "تدرج لوني, صبغة (نوع اللون كما يتحدد بطوله الموجي السائد)",
 "hue and cry": "جلبة, صخب (صيحات عالية ومستمرة من العديد من الناس)\nمثال: تجاهل صخب الحشد",
 "hueless": "عَدِيم التَّدَرُّج اللَّوْنِيّ (يفتقر تماماً إلى التشبع اللوني فلا يملك أي تدرج)",
