 "human activity": "عَمَل بَشَرِيّ, فِعْل (شيء يفعله الناس أو يتسبّبون في حدوثه)",
 "human being": "إِنْسَان, نَاس (كَائِن بَشَرِيّ؛ سَوَاد العَيْن)\nمثال: أنا إنسان صادق.",
 "human beings": "بشرية, جنس بشري (جميع السكان البشريين الأحياء على الأرض)\nمثال: كل العالم يحب المحب",
 "human body": "جَسَد, جِسْمُ الإِنْسَان (أسماء بديلة لجسد الإنسان)\nمثال: درس ليوناردو جسم الإنسان",
 "human botfly": "نبرة الإنسان (ذبابة أمريكية استوائية كبيرة؛ طفيلية على البشر والثدييات الأخرى)",
 "human chorionic gonadotrophin": "موجهة الغدد التناسلية المشيمائية البشرية (هرمون تنتجه المشيمة في وقت مبكر من الحمل؛ الكشف عنه في البول والمصل هو أساس أحد أنواع اختبارات الحمل)",
 "human chorionic gonadotropin": "موجهة الغدد التناسلية المشيمائية البشرية (هرمون تنتجه المشيمة في وقت مبكر من الحمل؛ الكشف عنه في البول والمصل هو أساس أحد أنواع اختبارات الحمل)",
 "human death": "ضحية, وفاة (وفاة ناتجة عن حادث أو كارثة)\nمثال: انخفاض في عدد وفيات السيارات",
 "human dynamo": "دِينَامُو, شُعْلَة طَاقَة (شخص عالي الطاقة لا يكل)",
 "human ecology": "ديموغرافيا, علم السكان (فرع علم الاجتماع الذي يدرس خصائص السكان البشريين)",
 "human elbow": "مرفق, مفصل المرفق (مفصل رزي بين الساعد والعضد والمفصل المقابل في الطرف الأمامي لذوات الأربع)",
 "human face": "وجه, وجه بشري (مقدمة الرأس البشري من الجبهة إلى الذقن ومن الأذن للأذن)\nمثال: غسل وجهه",
 "human foot": "قدم, قدم بشرية (جزء الساق البشرية أسفل مفصل الكاحل)\nمثال: برزت قدماه العاريتان من بنطاله",
 "human gamma globulin": "غاما غلوبولين (بروتين بلازما يحتوي على الغلوبولين المناعي المسؤول عن الاستجابات المناعية)",
 "human growth hormone": "سوماتروبين, هرمون النمو (هرمون تنتجه الغدة النخامية الأمامية؛ يعزز النمو عند البشر)",
 "human head": "رأس بشري (رأس كائن بشري)",
 "human immunodeficiency virus": "الإيدز, فيروس نقص المناعة البشرية (الفيروس الذي يسبب متلازمة نقص المناعة المكتسب (الإيدز)؛ يتكاثر في الخلايا التائية المساعدة ويقتلها)",
 "human knee": "ركبة, مفصل الركبة (مفصل رزي في الساق البشرية يربط القصبة والشظية بعظم الفخذ وتحميه الرضفة من الأمام)",
 "human language technology": "معالجة اللغات الطبيعية (فرع علم المعلومات الذي يتعامل مع معلومات اللغة الطبيعية)",
 "human nature": "طبيعة بشرية (السمات النفسية المشتركة للبشرية التي يفترض أنها مشتركة بين جميع البشر)\nمثال: مراقب عظيم للطبيعة البشرية",
 "human palaeontology": "أنثروبولوجيا قديمة, علم الحفريات البشرية (الدراسة العلمية للحفريات البشرية)",
 "human paleontology": "أنثروبولوجيا قديمة, علم الحفريات البشرية (الدراسة العلمية للحفريات البشرية)",
 "human papilloma virus": "فيروس الورم الحليمي البشري (أي من مجموعة فيروسات بابوفا المرتبطة بالسرطانات التناسلية أو الفموية أو مجموعة مرتبطة بأورام تناسلية حميدة)",
 "human process": "عملية بشرية (عملية يشارك فيها البشر)",
 "human race": "بشرية, جنس بشري (جميع السكان البشريين الأحياء على الأرض)\nمثال: كل العالم يحب المحب",
 "human relationship": "عَلَاقَة, عَلَاقَة إِنْسَانِيَّة (علاقة بين الناس)\nمثال: العلاقة بين الأمهات وأطفالهن",
 "human remains pouch": "كيس الموتى, كيس جثث (كيس يوضع فيه جثمان الجندي الميت أو المتوفى)",
 "human reproductive cloning": "استنساخ بشري (الاستنساخ الإنجابي لإنسان واعٍ؛ يعتبر غير مقبول أخلاقياً بشكل عام)",
 "human right": "حَقّ إِنْسَانِيّ, حُقُوق إِنْسَان (اسم من الأسماء الحسنى وهو من صفات الله. لا جمع له؛ ضد البَاطِل، العَدْل والحَقِيْقَة والوُجُوْد الثَابِت والصِدْق والذي لا جدال فيه. لا جمع له)\nمثال: الأستاذ على حق.",
 "human rights": "حُقُوق الإِنْسَان (صِيْغَةُ جَمْعٍ مُفْرَدُهَا: حق)\nمثال: الحقوق إنسانية.",
 "human shield": "دِرْع بَشَرِيّ, دُرُوع بَشَرِيَّة (الثَلَاثُ الدُرَع: الليلة السادسة عشر والسابعة عشر والثامنة عشر من كل شهر قمري…)\nمثال: اعطني هذا الدرع.",
 "human t-cell leukemia virus-1": "فيروس سرطان الدم التائي البشري-1 (فيروس قهقري يسبب سرطان الدم التائي)",
 "human trafficking": "اِتِّجَار بِالْبَشَر",
 "human waste": "فضلات بشرية (نفايات أجسام البشر)",
 "human-centered": "إِنْسَانَوِيّ (يتّسم بالقيم الإنسانويّة والتفاني في رعاية البشر)",
 "human-centred": "إِنْسَانَوِيّ (يتّسم بالقيم الإنسانويّة والتفاني في رعاية البشر)",
 "human-sized": "بِحَجْمِ الْإِنْسَانِ (بحجم إنسان تقريبًا)",
 "humane": "إِنْسَانِيّ",
 "humanely": "بإنسانية (بطريقة إنسانية)\nمثال: لنعامل أسرى الحرب بإنسانية",
 "humaneness": "إِنْسَانِيَّة, رَأْفَة (صفة الرحمة أو مراعاة الآخرين (الناس أو الحيوانات))",
 "humanisation": "أنسنة (فعل جعل الشيء أكثر إنسانية)",
 "humanism": "إِنْسَانِيَّة",
 "humanist": "إِنْسَانَوِيّ (يتّسم بالقيم الإنسانويّة والتفاني في رعاية البشر) / إنساني (متعلق بـ أو معني بالعلوم الإنسانية) / إنساني (مكون من أو متعلق بإنسانية عصر النهضة) / إنساني (مكون من أو متعلق بفلسفة تؤكد الكرامة الإنسانية وقدرة الإنسان على التحقق من خلال العقل والمنهج العلمي وغالباً ما ترفض الدين)\nمثال: دراسات إنسانية",
 "humanistic": "إِنْسَانَوِيّ (يتّسم بالقيم الإنسانويّة والتفاني في رعاية البشر) / إنساني (متعلق بـ أو معني بالعلوم الإنسانية) / إنساني (مكون من أو متعلق بإنسانية عصر النهضة) / إنساني (مكون من أو متعلق بفلسفة تؤكد الكرامة الإنسانية وقدرة الإنسان على التحقق من خلال العقل والمنهج العلمي وغالباً ما ترفض الدين)\nمثال: دراسات إنسانية",
 "humanistic discipline": "إنسانيات, علوم إنسانية (دراسات تهدف إلى توفير معرفة عامة ومهارات فكرية (بدلاً من المهارات المهنية أو الوظيفية))\nمثال: كلية الآداب والعلوم",
 "humanitarian": "إِنْسَانَوِيّ (يتّسم بالقيم الإنسانويّة والتفاني في رعاية البشر) / إنساني (من أو يتعلق بالمذهب الإنساني أو يميزه) / إنساني (مدافع عن مبادئ الإنسانية؛ شخص مهتم بمصالح البشر ورفاهيتهم) / إنساني, فاعل خير (شخص مكرس لتعزيز رفاهية الإنسان والإصلاحات الاجتماعية)\nمثال: مساعدات إنسانية",
 "humanitarian corridor": "مَمَرّ إِنْسَانِيّ (على مَمَرّ العصور: على طولها ومداها؛ على مَمَرّ الفصول: على تواليها وتعاقبها)\nمثال: الباب في نهاية الممر.",
 "humanitarianism": "إنسانية (المذهب القائل بأن واجب الناس هو تعزيز الرفاهية البشرية)",
 "humanities": "إنسانيات, علوم إنسانية (دراسات تهدف إلى توفير معرفة عامة ومهارات فكرية (بدلاً من المهارات المهنية أو الوظيفية))\nمثال: كلية الآداب والعلوم",
 "humanity": "بَشَرِيَّة, إِنْسَانِيَّة / إِنْسَانِيَّة, بَشَرِيَّة",
 "humanization": "أَنْسَنَة",
 "humankind": "بشرية, جنس بشري (جميع السكان البشريين الأحياء على الأرض)\nمثال: كل العالم يحب المحب",
 "humanlike": "أَنْسَنِيّ, مُؤَنْسَن (يُضفي صفات بشرية على الحيوانات أو الجمادات)",
 "humanly": "إنسانياً, بشرياً (على طريقة البشر)\nمثال: ممكن بشرياً",
 "humanness": "إنسانية, بشرية (صفة كون الكائن بشرياً أو إنساناً)\nمثال: كان يخشى التدهور السريع لكل ما هو إنساني",
 "humanoid": "أندرويد, روبوت بشري (إنسان آلي يشبه البشر)",
 "humans": "بشرية, جنس بشري (جميع السكان البشريين الأحياء على الأرض)\nمثال: كل العالم يحب المحب",
 "humate": "هيومات (مادة غنية بالأحماض الدبالية)",
 "humble": "مُتَوَاضِع / وضع (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه)\nمثال: لقد أزمت الوضع.",
 "humble plant": "ست المستحية, ميموزا خجولة (شجيرة فرعية مفترشة أو شبه منتصبة من أمريكا الاستوائية وأستراليا؛ مسلحة بشدة بأشواك منحنية ولها وريقات خضراء رمادية ناعمة حساسة تطوى وتتدلى في الليل…)",
 "humblebee": "نحلة طنانة (نحلة اجتماعية مشعرة قوية من المناطق المعتدلة)",
 "humbled": "مَكْسُور, مُذَلَّل (خاضع أو مُنزَل إلى حالة أو مكانة متدنّية)",
 "humbleness": "تواضع (ميل لأن يكون المرء متواضعاً؛ نقص في الكبرياء الزائف) / تواضع (شعور متواضع) / تواضع المكانة, خمول (حالة كونه متواضعاً وغير مهم)\nمثال: لا يعتبر الجميع التواضع فضيلة",
 "humbling": "مُذِلّ, مُهِين (يُثِير الشُّعُور بِالنَّقْص أَوِ القُصُور)",
 "humbly": "بتواضع (بطريقة متواضعة) / ببخل, بتقتير (بطريقة بخيلة)\nمثال: خفض رأسه بتواضع",
 "humboldt current": "تيار بيرو, تيار همبولدت (تيار محيطي بارد يتدفق شمالاً على طول ساحل المحيط الهادئ لأمريكا الجنوبية قبل أن يتجه غرباً)",
 "humbug": "احتيال, خدعة (شيء يهدف إلى الخداع؛ حيلة متعمدة تهدف إلى الحصول على ميزة) / خداع, دجل (تواصل (مكتوب أو منطوق) يهدف إلى الخداع) / تَفَاهَة, دَجَل (حديث أو كتابة مدعية أو سخيفة)",
 "humdinger": "أعجوبة, شخص استثنائي (شخص ذو تميز ملحوظ واستثنائي)\nمثال: سكرتيرة استثنائية",
 "humdrum": "رَتِيب, مُمِلّ (مكرّر بشكل مملّ أو يفتقر إلى التنوّع) / رَتِيب, عَادِيّ (غير مُلهِم ولا يُشكِّل تحدياً؛ باهت وخالٍ من الإثارة) / رَتَابَة, مَلَل (صفة الثبات المرهق والروتين ونقص التنوع)\nمثال: لم يعتد أبداً على رتابة عمله",
 "humectant": "حافظ للرطوبة, مادة مرطبة (أي مادة تضاف إلى مادة أخرى للحفاظ على رطوبتها)",
 "humeral": "كَتِفِيّ",
 "humeral veil": "وشاح الكتف الكنسي (رداء يرتديه الكاهن في القداس العالي في الكنيسة الكاثوليكية؛ شال من الحرير)",
 "humerus": "عَضُد (مُعِين؛ قُوَّة)",
 "humic": "دبالي (مكون من أو متعلق بـ أو مشتق من الدبال)\nمثال: حمض الدبال (هيوميك)",
 "humic acid": "حمض الهيوميك (مادة دبالية بنية داكنة قابلة للذوبان في الماء فقط عند قيم أس هيدروجيني تزيد عن 2)",
 "humic shale": "طفل صفحي دبالي (طفل صفحي غني بالأحماض الدبالية)",
 "humic substance": "مادة دبالية (بقايا عضوية من المواد العضوية المتحللة)",
 "humid": "رَطْب, رَطِب (يحتوي على الماء أو الرطوبة، غير جاف؛ لين أو طري الملمس بسبب وجود الرطوبة)\nمثال: ملابسي رطبة ومليئة في التراب علي تبديلها.",
 "humidifier": "مرطب هواء (جهاز مصمم لإضافة الرطوبة إلى الهواء في المبنى)\nمثال: يضمن مرطب الهواء مستوى الرطوبة المناسب للوحاتنا",
 "humidity": "رُطُوبَة",
 "humidness": "رطوبة (الرطوبة في الغلاف الجوي)",
 "humification": "تدبل, تكون الدبال (عملية تكوين الدبال من بقايا النباتات)",
 "humified": "متحول لدبال, مدبل (متحول إلى دبال)\nمثال: تربة مدبلة",
 "humiliate": "أَخْزَى, اِسْتَذَلَّ (أَخْزَى: (فعل) أخزَى يُخزي ، أخْزِ ، إخزاءً ، فهو مُخْزٍ ، والمفعول مُخزًى)",
 "humiliated": "ذَلِيل, مُحْرَج (شعر بالضيق بسبب الخجل أو جُرح كرامته) / مَكْسُور, مُذَلَّل (خاضع أو مُنزَل إلى حالة أو مكانة متدنّية)",
 "humiliating": "مُذِلّ, مُهِين (يُثِير الشُّعُور بِالنَّقْص أَوِ القُصُور)",
 "humiliatingly": "بشكل مهين (بطريقة مهينة)\nمثال: أعيد إنتاج اللوحة بحجم صغير بشكل مهين",
 "humiliation": "إِذْلَال, ذِلَّة",
 "humility": "تَوَاضُع",
 "humin": "هيومين (مادة دبالية سوداء غير قابلة للذوبان في الماء)",
 "hummer": "كرة سريعة ((بيسبول) رمية ترمى بأقصى سرعة) / همهم (مغنٍ يصدر نغمة دون فتح الشفاه أو تشكيل كلمات)\nمثال: تأخر في ضرب الكرة السريعة",
 "humming": "دندنة (فعل الغناء بشفاه مغلقة) / دندنة, همهمة (صوت همهمة)\nمثال: همهمة حركة المرور البعيدة",
 "humming bird's trumpet": "فوشية كاليفورنية (شجيرة صغيرة من جنوب غرب الولايات المتحدة إلى المكسيك لها زهور قرمزية متألقة)",
 "humming top": "بلبل طنان (بلبل يصدر صوتاً طناناً أثناء دورانه)",
 "hummingbird": "طَنَّان, طَنَان",
 "hummingbird moth": "عثة الصقر (أي من العث المتنوع ذو أجنحة أمامية ضيقة طويلة قادرة على الطيران القوي والتحويم فوق الزهور للتغذية)",
 "hummock": "أكمة, رابية (تل طبيعي صغير)",
 "hummus": "حِمَّص (حَمَصَ الجُرْحُ: سَكَنَ وَرَمُه؛ حَمَصَ القَذَاةَ: أَخْرَجَها مِنْ عَيْنِه بِرِفْقٍ)\nمثال: الحمص مكون أساسي في طبق الفلافل.",
 "humongous": "ضَخْم جِدًّا ((غير رسمي) كبير جداً)",
 "humor": "روح الدعابة, فكاهة (سمة تقدير (والقدرة على التعبير عن) الفكاهة) / طَرَافَة, فُكَاهَة (صفة كون الشيء مضحكا) / سائل جسدي, سوائل الجسم (الأجزاء السائلة من الجسم) / خلط ((في العصور الوسطى) أحد السوائل الأربعة في الجسم التي كان يعتقد أن توازنها يحدد الحالة العاطفية والجسدية)\nمثال: لم تقدر فكاهتي",
 "humoral": "خلطي (متعلق بسوائل الجسم أو الأخلاط)",
 "humoral immune response": "استجابة مناعية خلطية (استجابة مناعية (بشكل رئيسي ضد الغزو البكتيري) تتوسطها الخلايا البائية)",
 "humoring": "انغماس, تدليل (فعل الانغماس أو إشباع رغبة)",
 "humorist": "فكاهي, كاتب ساخر (شخص يتصرف أو يتحدث أو يكتب بطريقة مسلية ومضحكة)",
 "humorless": "جاف, جامد (يفتقر إلى الفكاهة)\nمثال: كانت غمزة خالية من الدعابة؛ غمزة تحذير",
 "humorlessly": "بجدية مفرطة, بلا فكاهة (بطريقة تفتقر للفكاهة)\nمثال: كان رد فعله على هذه الشائعات جاداً بلا أي فكاهة",
 "humorous": "طريف, فکاهي (مليء بـأو يتميز بالفكاهة)\nمثال: قصص فكاهية",
 "humorously": "بفكاهة, بمرح (بطريقة فكاهية)\nمثال: اقترح ديكنز بفكاهة خدمة خاصة للشفاعة في كاتدرائية القديس بولس",
 "humorousness": "دعابة, مرح (سمة المزاح المرح)",
 "humour": "فُكَاهَة, دُعَابَة / مِزَاج / خِلْط, أَخْلَاط (اختلط)\nمثال: خلط توم بين السكر و الملح.",
 "humouring": "انغماس, تدليل (فعل الانغماس أو إشباع رغبة)",
 "humourist": "فكاهي, كاتب ساخر (شخص يتصرف أو يتحدث أو يكتب بطريقة مسلية ومضحكة)",
 "humourless": "جاف, جامد (يفتقر إلى الفكاهة)\nمثال: كانت غمزة خالية من الدعابة؛ غمزة تحذير",
 "humourlessly": "بجدية مفرطة, بلا فكاهة (بطريقة تفتقر للفكاهة)\nمثال: كان رد فعله على هذه الشائعات جاداً بلا أي فكاهة",
 "humourous": "طريف, فکاهي (مليء بـأو يتميز بالفكاهة)\nمثال: قصص فكاهية",
 "humous": "حمص (معجون سميك مصنوع من الحمص المهروس والطحينة وعصير الليمون والثوم؛ يستخدم خاصة كغموس للخبز؛ نشأ في الشرق الأوسط)",
 "hump": "سَنَام / حَدَبَة, سَنَام",
 "humpback": "أَحْدَب, حَدْبَاء (صفة من كان له حَدْبَة؛ لما كان أحدبًا)",
 "humpback whale": "حوت أحدب (حوت باليني كبير ذو زعانف طويلة يشتهر بتقويس ظهره عند الغوص)",
 "humpbacked": "أَحْدَب (صفة من كان له حَدْبَة؛ لما كان أحدبًا)",
 "humped": "أَحْدَب, مُقَوَّسُ الظَّهْر (يُعَانِي مِنْ تَقَوُّسٍ غَيْرِ طَبِيعِيٍّ فِي العَمُودِ الفِقَرِيّ (حُدَاب))",
 "humpty dumpty": "هَمْبْتِي دَمْبْتِي",
 "humulin": "إنسولين بشري مؤتلف, هيومولين",
 "humulus americanus": "جنجل أمريكي (نبات أمريكي أصلي يخلط أحياناً مع الجنجل الأوروبي)",
 "humulus japonicus": "جنجل ياباني (كرمة زينة موطنها شرق آسيا؛ تزرع لأوراقها المبرقشة)",
 "humulus lupulus": "جنجل شائع, حشيشة الدينار (نبات متسلق أوروبي تستخدم أزهاره بشكل رئيسي لتنكيه المشروبات الكحولية (البيرة)؛ يزرع في أمريكا)",
 "humus": "الدبال",
 "humvee": "همفي (مركبة عسكرية عالية الحركة ومتعددة الأغراض ذات دفع رباعي)",
 "hun": "كراوت, هوني (مصطلح مهين لشخص من أصل ألماني) / هوني (عضو في شعب بدوي غزا أوروبا في القرن الرابع)",
 "hunan": "خُونَان, هُونَان",
 "hunch": "تحَدُّب (عملية ثني نفسك في وضعية محدبة) / حدس, شعور غريزي (انطباع بأن شيئًا ما قد يكون هو الحال)\nمثال: كان لديه حدس بأن شيئًا ما قد حدث بشكل خاطئ",
 "hunchback": "أحدب (شخص ظهره مقوس بسبب انحناء غير طبيعي في العمود الفقري العلوي) / الحدب, حداب (انحناء خلفي غير طبيعي للعمود الفقري)",
 "hunchbacked": "أَحْدَب, مُقَوَّسُ الظَّهْر (يُعَانِي مِنْ تَقَوُّسٍ غَيْرِ طَبِيعِيٍّ فِي العَمُودِ الفِقَرِيّ (حُدَاب))",
 "hunched": "مُحْدَوْدِب, مُنْحَنِي الظَّهْر (ذو ظهر وكتفَين مُنحنيَين؛ غير منتصب)",
 "hundred": "مِٱئَة, مِئَة",
 "hundred and one": "مِئَة وَوَاحِد (يَدُلُّ عَلَى العَدَد 101)",
 "hundred dollar bill": "ورقة مئة دولار (ورقة نقدية أمريكية بقيمة 100 دولار)",
 "hundred thousand": "مِائَة أَلْف",
 "hundred-and-eightieth": "اَلثَّمَانُونَ وَالْمِئَةُ (العدد الترتيبي لثمانين ومئة في العدّ)",
 "hundred-and-fifteenth": "اَلْخَامِسَ عَشَرَ وَالْمِئَةُ (العدد الترتيبي لخمسة عشر ومئة في العدّ)",
 "hundred-and-fifth": "اَلْخَامِسُ وَالْمِئَةُ (العدد الترتيبي لخمسة ومئة في العدّ)",
 "hundred-and-fiftieth": "اَلْخَمْسُونَ وَالْمِئَةُ (العدد الترتيبي لخمسين ومئة في العدّ)",
 "hundred-and-fifty-fifth": "اَلْخَامِسُ وَالْخَمْسُونَ وَالْمِئَةُ (العدد الترتيبي لخمسة وخمسين ومئة في العدّ)",
 "hundred-and-first": "اَلْحَادِي وَالْمِئَةُ (العدد الترتيبي لواحد ومئة في العدّ)",
 "hundred-and-fortieth": "اَلْأَرْبَعُونَ وَالْمِئَةُ (العدد الترتيبي لأربعين ومئة في العدّ)",
 "hundred-and-forty-fifth": "اَلْخَامِسُ وَالْأَرْبَعُونَ وَالْمِئَةُ (العدد الترتيبي لخمسة وأربعين ومئة في العدّ)",
 "hundred-and-ninetieth": "اَلتِّسْعُونَ وَالْمِئَةُ (العدد الترتيبي لتسعين ومئة في العدّ)",
 "hundred-and-seventieth": "اَلسَّبْعُونَ وَالْمِئَةُ (العدد الترتيبي لسبعين ومئة في العدّ)",
 "hundred-and-seventy-fifth": "اَلْخَامِسُ وَالسَّبْعُونَ وَالْمِئَةُ (العدد الترتيبي لخمسة وسبعين ومئة في العدّ)",
 "hundred-and-sixtieth": "اَلسِّتُّونَ وَالْمِئَةُ (العدد الترتيبي لستين ومئة في العدّ)",
 "hundred-and-sixty-fifth": "اَلْخَامِسُ وَالسِّتُّونَ وَالْمِئَةُ (العدد الترتيبي لخمسة وستين ومئة في العدّ)",
 "hundred-and-tenth": "اَلْعَاشِرُ وَالْمِئَةُ (العدد الترتيبي لعشرة ومئة في العدّ)",
 "hundred-and-thirtieth": "اَلثَّلَاثُونَ وَالْمِئَةُ (العدد الترتيبي لثلاثين ومئة في العدّ)",
 "hundred-and-thirty-fifth": "اَلْخَامِسُ وَالثَّلَاثُونَ وَالْمِئَةُ (العدد الترتيبي لخمسة وثلاثين ومئة في العدّ)",
 "hundred-and-twentieth": "اَلْعِشْرُونَ وَالْمِئَةُ (العدد الترتيبي لعشرين ومئة في العدّ)",
 "hundred-and-twenty-fifth": "اَلْخَامِسُ وَالْعِشْرُونَ وَالْمِئَةُ (العدد الترتيبي لخمسة وعشرين ومئة في العدّ)",
 "hundred-percenter": "شوفيني, متعصب قومي (قومي متطرف ومولع بالحرب)",
 "hundredfold": "مائة ضعف (بمعامل مائة)\nمثال: زادت أموالهم مائة ضعف",
 "hundreds and thousands": "آلافٌ مُؤَلَّفَة (إحدى فئات الأَعْدَاد، وهي الأعداد التي يكون إلى يَسَارها ثلاثة أعداد أخرى. أكبر من المِئَات وأصغر من المَلايِيين)\nمثال: سيكلفك ذلك عشرة آلاف ين.",
 "hundredth": "مائة",
 "hundredweight": "قِنْطَار",
 "hung jury": "هيئة محلفين معلقة (هيئة محلفين غير قادرة على الاتفاق على حكم (النتيجة هي بطلان المحاكمة))",
 "hung parliament": "برلمان معلق",
 "hungarian": "مَجَرِيّ / هَنْغَارِيّ",
 "hungarian goulash": "جولاش, جولاش مجري (يخنة لحم غنية متبلة جداً بالبابريكا)",
 "hungarian grass": "دخن إيطالي, دخن ذيل الثعلب (عشب حولي خشن مقاوم للجفاف يزرع للحبوب والتبن والعلف في أوروبا وآسيا وبشكل رئيسي للعلف والتبن في الولايات المتحدة)",
 "hungarian lilac": "ليلك مجري (شجيرة قائمة من وسط أوروبا لها أوراق إهليلجية وعناقيد قائمة من الزهور الليلكية أو البنفسجية العميقة)",
 "hungarian monetary unit": "وحدة نقدية مجرية (الوحدة النقدية في المجر)",
 "hungarian partridge": "حجل رمادي (حجل أوروبي شائع)",
 "hungarian pointer": "بوينتر هنغاري, فيزلا (كلب صيد هنغاري يشبه الفيمارانير ولكن له فراء أحمر غامق غني)",
 "hungarian sauce": "صلصة البابريكا, صلصة مجرية (صلصة فيلوتيه مع بصل مفروم مقلي وبابريكا وكريمة)",
 "hungarumlaut": "نبرة حادة مزدوجة (علامة تشكيل في النص اللاتيني، تُستخدم بشكل أساسي في المجرية المكتوبة)",
 "hunger": "رَغْبَة, تَعَطُّش / جَاعَ (أَصَابَهُ الجُوعُ؛ أَصَابَهُ الفَقْرُ الشَّديدُ)\nمثال: جاع الرجل العجوز حتى الموت.",
 "hunger is a good sauce": "الجوع كافر",
 "hunger march": "مَسِيرَة الجُوع (مسيرة احتجاجية أو مظاهرة للعاطلين عن العمل)",
 "hunger marcher": "مشارك في مسيرة الجوع (شخص عاطل يشارك في مسيرة للجوع)",
 "hunger strike": "اِضْرَاب عَن الطَّعَام",
 "hungover": "مَخْمُور (يُعَانِي مِنَ الآثَارِ اللَّاحِقَةِ لِشُرْبِ الكُحُولِ)",
 "hungrily": "بجوع, بنهم (بأسلوب شخص جائع جداً)\nمثال: انقض على الطعام بنهم",
 "hungriness": "تعطش, توق (رغبة قوية لشيء ما (ليس الطعام أو الشراب)) / توق, حنين (رغبة أو حاجة طويلة الأمد غير محققة) / جوع (حاجة فسيولوجية للغذاء؛ نتيجة الحرمان من الطعام)\nمثال: تعطش للمعرفة",
 "hungry": "جَائِع, جَوْعَان",
 "hunk": "قِطْعَة, كُتْلَة (قطعة كبيرة من شيء ما ليس لها شكل محدد) / شاب مفتول العضلات (رجل حسن البنية وجذاب جنسياً)\nمثال: قطعة كبيرة من الخبز",
 "hunkpapa": "لغة هونكبابا (لغة سيووية يتحدث بها شعب هونكبابا) / هونكبابا (فرد من الشعب السيوي شكل قسماً من تيتون سيوكس وعاش سابقاً في غرب الداكوتا)",
 "hunkpapa language": "لغة هونكبابا (لغة سيووية يتحدث بها شعب هونكبابا)",
 "hunky-dory": "حَسَن, عَلَى مَا يُرَام (مُرْضٍ أو في حالة مُرْضِية)",
 "hunnemania fumariifolia": "خشخاش التوليب المكسيكي, كأس ذهبي (موطنه المرتفعات المكسيكية يزرع لزهوره الصفراء الصافية اللامعة وأوراقه الزرقاء الرمادية المقسمة بدقة)",
 "hunt": "اِصْطَادَ, صَادَ / صَيْد, مُطارَدَة",
 "hunt club": "نادي الصيد (رابطة من الصيادين الذين يصطادون من أجل الرياضة)",
 "hunted": "مَذْعُور, مُطَارَد (يعكس خوف ورعب من يُطارَد)",
 "hunted person": "طَرِيد, مُطارَد (شخص يتم مطاردته)",
 "hunter": "صَيَّاد, صَائِد (اِسْمٌ وَصِفَةٌ لِلْأَسَد)\nمثال: قتل الصياد دبا.",
 "hunter's chicken": "دجاج الصياد, دجاج كاتشاتوري (طاجن دجاج محضر مع الطماطم والفطر والأعشاب على الطريقة الإيطالية)",
 "hunter's sauce": "صلصة الصياد (صلصة بنية وهريس طماطم مع بصل وفطر ونبيذ أبيض جاف)",
 "hunter-gatherer": "صياد وجامع ثمار (عضو في مجتمع يعتمد على الصيد وجمع الثمار)",
 "hunting": "صَيْد",
 "hunting and gathering society": "مجتمع الصيد والجمع (مجموعة تعيل نفسها بالصيد وصيد الأسماك وجمع الفواكه والخضروات البرية؛ عادة ما تكون بدوية)",
 "hunting and gathering tribe": "مجتمع الصيد والجمع (مجموعة تعيل نفسها بالصيد وصيد الأسماك وجمع الفواكه والخضروات البرية؛ عادة ما تكون بدوية)",
 "hunting crop": "سوط الركوب, سوط الصيد (سوط قصير بجلد في نهايته ومقبض لفتح البوابات)",
 "hunting dog": "كلب صيد (كلب يستخدم في صيد الطرائد)",
 "hunting expedition": "رحلة سفاري, رحلة صيد (رحلة برية للصيادين (خاصة في أفريقيا))",
 "hunting ground": "منطقة صيد (منطقة يتم فيها صيد الطرائد) / مجال خصب, ميدان للصيد (مكان تكثر فيه الفرص)",
 "hunting guide": "دليل صيد (دليل للأشخاص الذين يصطدون في مناطق غير مألوفة)",
 "hunting knife": "سكين صيد (سكين حاد كبير بمقبض مشكل ليتناسب مع القبضة)",
 "hunting licence": "تصريح صيد بري, رخصة صيد (رخصة تخول حاملها قتل نوع معين من الحيوانات خلال فترة زمنية محددة)",
 "hunting license": "تصريح صيد بري, رخصة صيد (رخصة تخول حاملها قتل نوع معين من الحيوانات خلال فترة زمنية محددة)",
 "hunting lodge": "كوخ الصيد (منزل صغير (ريفي) يستخدم كمأوى مؤقت)",
 "hunting permit": "تصريح صيد بري, رخصة صيد (رخصة تخول حاملها قتل نوع معين من الحيوانات خلال فترة زمنية محددة)",
 "hunting season": "موسم الصيد (الموسم الذي يكون فيه قتل نوع معين قانونيًا)",
 "hunting spider": "عنكبوت ذئبي (عنكبوت أرضي يصطاد فريسته بدلاً من استخدام الشبكة)",
 "hunting watch": "ساعة الصياد (ساعة ذات غطاء معدني مفصلي لحماية الزجاجة)",
 "hunting whip": "سوط الصيد (سوط يحمله الراكب؛ لا يُقصد به استخدامه على الحصان، بل لتذكير كلاب الصيد بالابتعاد عن حوافر الحصان، ويمكن استخدامه أيضاً كأداة تواصل مع الكلاب)",
 "huntingdon elm": "دردار هنتنغدون (شجرة دردار هجينة للزينة قائمة وقوية)",
 "huntingdon willow": "صفصاف أبيض (شجرة صفصاف كبيرة في أوراسيا وشمال أفريقيا ذات أوراق رمادية مبيضة ولحاء رمادي)",
 "huntington's chorea": "داء هنتنغتون, رقص هنتنغتون (مرض وراثي؛ يتطور في مرحلة البلوغ وينتهي بالخرف)",
 "huntington's disease": "داء هنتنغتون, رقص هنتنغتون (مرض وراثي؛ يتطور في مرحلة البلوغ وينتهي بالخرف)",
 "huntress": "صَيَّادَة, صَائِدَة",
 "huntsman": "صياد (رجل يصطاد الطرائد)",
 "huntsman's cup": "سراسينية أرجوانية, نبات الإبريق الشائع (عشبة مستنقعات معمرة ذات زهور حمراء داكنة وأباريق مجنحة عريضة تشكل وردية؛ من شمال شرق أمريكا الشمالية ومتوطنة في أوروبا وخاصة أيرلندا)",
 "huntsman's cups": "سراسينية أرجوانية, نبات الإبريق الشائع (عشبة مستنقعات معمرة ذات زهور حمراء داكنة وأباريق مجنحة عريضة تشكل وردية؛ من شمال شرق أمريكا الشمالية ومتوطنة في أوروبا وخاصة أيرلندا)",
 "huntsman's horn": "بوق الصياد, سراسينية صفراء (نبات إبريق في جنوب شرق الولايات المتحدة ذو أباريق صفراء منتصبة على شكل بوق ذات أفواه واسعة وأغطية منتصبة)",
 "huntsman's horns": "بوق الصياد, سراسينية صفراء (نبات إبريق في جنوب شرق الولايات المتحدة ذو أباريق صفراء منتصبة على شكل بوق ذات أفواه واسعة وأغطية منتصبة)",
 "huntswoman": "صيادة (امرأة تصطاد الطرائد)",
 "huon pine": "صنوبر هوون (شجرة خشبية تاسمانية بخشب أصفر عطري متموج الحبيبات يستخدم للنحت وبناء السفن؛ توضع أحياناً في جنس داكريديوم)",
 "hupa": "لغة هوبا (اللغة الأثاباسكوية التي يتحدث بها شعب هوبا) / هوبا (فرد من شعب أثاباسكان في وادي نهر ترينيتي في كاليفورنيا)",
 "hupa language": "لغة هوبا (اللغة الأثاباسكوية التي يتحدث بها شعب هوبا)",
 "hurdle": "حَاجِز / عَقَبَة, حَاجِز",
 "hurdle race": "سباق الحواجز (سباق جري يجب على المتسابقين فيه اجتياز سلسلة من الحواجز)",
 "hurdler": "عداء الحواجز (رياضي يركض في سباقات الحواجز)",
 "hurdles": "سباق الحواجز (سباق جري يجب على المتسابقين فيه اجتياز سلسلة من الحواجز)",
 "hurdling": "سباق الحواجز (سباق جري يجب على المتسابقين فيه اجتياز سلسلة من الحواجز)",
 "hurdy gurdy": "قيثارة العجلة, هردي قردي (آلة وترية تنتج الأصوات عن طريق عجلة تحتك بالأوتار)",
 "hurdy-gurdy": "قيثارة العجلة, هردي قردي (آلة وترية تنتج الأصوات عن طريق عجلة تحتك بالأوتار)",
 "hurghada": "الْغَرْدَقَة",
 "hurl": "أَلْقَى ((مُتَعَدٍّ بِنَفْسِهِ) رَمَى)\nمثال: ألقى زيري تحية.",
 "hurler": "رامي الكرة, رامٍ ((في البيسبول) الشخص الذي يقوم برمي الكرة)\nمثال: يعاني رامي فريقنا من ألم في ذراعه",
 "hurler's disease": "متلازمة هيرلر (مرض وراثي (متنحي) يتمثل في خطأ في استقلاب عديدات السكاريد المخاطية؛ يتميز بتشوهات شديدة في تطور الغضروف الهيكلي والعظام والتخلف العقلي)",
 "hurler's syndrome": "متلازمة هيرلر (مرض وراثي (متنحي) يتمثل في خطأ في استقلاب عديدات السكاريد المخاطية؛ يتميز بتشوهات شديدة في تطور الغضروف الهيكلي والعظام والتخلف العقلي)",
 "hurling": "هيرلينغ (لعبة أيرلندية تقليدية تشبه الهوكي؛ يلعبها فريقان من 15 لاعباً لكل منهما)",
 "hurly burly": "اضطراب, قلاقل (ثوران أو صخب غير منظم)\nمثال: لقد ذهلوا من الاضطراب العنيف الذي سببوه",
 "hurrah": "مرحى, هتاف النصر (هتاف النصر)\nمثال: دعونا نعطي الفريق هتافاً كبيراً",
 "hurricane": "زَوْبَعَة شَدِيدَة, إِعْصَار",
 "hurricane deck": "سطح التنزه, سطح علوي (سطح في أعلى سفينة ركاب)",
 "hurricane lamp": "فانوس العاصفة, مصباح العاصفة (مصباح زيت بمدخنة زجاجية وغطاء معدني مثقوب لحماية اللهب من الرياح العاتية؛ شمعدان بمدخنة زجاجية)",
 "hurricane lantern": "فانوس العاصفة, مصباح العاصفة (مصباح زيت بمدخنة زجاجية وغطاء معدني مثقوب لحماية اللهب من الرياح العاتية؛ شمعدان بمدخنة زجاجية)",
 "hurricane roof": "سطح التنزه, سطح علوي (سطح في أعلى سفينة ركاب)",
 "hurridly": "أثناء الركض, على عجل (أثناء الركض أو في عجلة من أمره)\nمثال: كتبت تلك الرسائل على عجل",
 "hurried": "سريع, مستعجل (يتحرك بسرعة أو يؤدى بسرعة أو بعجلة كبيرة)\nمثال: رحلة سريعة إلى المتجر",
 "hurriedly": "بسرعة, بعجلة (بطريقة سريعة أو متسرعة)\nمثال: الطريقة التي دفنوه بها بسرعة كانت معيبة",
