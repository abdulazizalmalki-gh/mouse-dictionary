 "hedge": "وَشِيع, سِيَاج نَبَاتِيّ",
 "hedge bindweed": "لبلاب السياج",
 "hedge fund": "صندوق تحوط (شركة استثمار مرنة لعدد صغير من كبار المستثمرين (عادة ما يكون الحد الأدنى للاستثمار مليون دولار)؛ يمكنها استخدام تقنيات عالية المخاطر (غير مسموح بها…)",
 "hedge garlic": "ثوم السياج, خردل الثوم (عشبة أوروبية تفوح منها رائحة الثوم)",
 "hedge maple": "قيقب الحقل, قيقب السياج (قيقب أوراسي شجيري يستخدم غالباً كسياج)",
 "hedge mustard": "خردل السياج, سيسيمبريم مخزني (نبات حولي متفرع وصلب من العالم القديم بأزهار صفراء شاحبة؛ مستوطن على نطاق واسع في أمريكا الشمالية؛ كان يستخدم طبياً سابقاً)",
 "hedge nettle": "بطونية الأحراش, ستاكس حرجية (عشب أوراسي معمر كريه الرائحة بجذمور زاحف أخضر) / بطونية المستنقعات, ستاكس (عشب معمر بجذمور عديم الرائحة واسع الانتشار في الأماكن الرطبة في نصف الكرة الشمالي)",
 "hedge pink": "صابونية مخزنية, عرق الحلاوة (نبات من أصل أوروبي له زهور وردية أو بيضاء وأوراق تنتج منظفاً عند سحقها)",
 "hedge sparrow": "عصفور, عصفور الشوك (طائر مغرد أوروبي صغير بني اللون)",
 "hedge thorn": "شوك السياج, كاريس ثنائي الشوك (شجيرة من جنوب إفريقيا لها أشواك متشعبة وثمار تشبه البرقوق؛ تستخدم بكثرة كسياج)",
 "hedge trimmer": "مشذب الشجيرات, مقص السياج (أداة حديقة لتقليم السياج الشجري)",
 "hedge violet": "بنفسج السياج (بنفسج أوروبي شائع ينمو في الغابات والتحوطات)",
 "hedged": "مُتَمَلِّص, مُرَاوِغ (مصاغ بطريقة مراوغة لتجنّب التصريح القاطع)",
 "hedgefund": "صندوق تحوط (شركة استثمار مرنة لعدد صغير من كبار المستثمرين (عادة ما يكون الحد الأدنى للاستثمار مليون دولار)؛ يمكنها استخدام تقنيات عالية المخاطر (غير مسموح بها…)",
 "hedgehog": "قُنْفُذ",
 "hedgehog cactus": "صبار القنفذ",
 "hedgehog cereus": "شمعية القنفذ (صبار من جنس شمعية القنفذ)",
 "hedger": "مشذب السياج (بستاني يعتني بسياج الشجيرات ويقلمه) / مُتحوّط (شخص يوازن معاملة (كراهن) بأخرى للحماية من الخسارة) / مراوغ, موارب (مجيب يتجنب إعطاء إجابة مباشرة واضحة)",
 "hedgerow": "سياج شجري (سياج يتكون من صف من الشجيرات المزروعة بشكل وثيق)",
 "hedging": "تحوط, مراوغة (بيان غير ملزم أو غامض عمداً) / تحوط (أي تقنية مصممة لتقليل أو القضاء على المخاطر المالية؛ على سبيل المثال، اتخاذ موقفين يعوض كل منهما الآخر إذا تغيرت الأسعار)\nمثال: عندما تقول 'ربما' فأنت تتحوط فقط",
 "hediondilla": "شجيرة الكريوسوت, لاريا (شجيرة صحراوية في جنوب غرب الولايات المتحدة ونيو مكسيكو لها أوراق عطرية راتنجية دائمة وزهور صفراء صغيرة)",
 "hedonic": "لَذَّوِيّ, مُتَمَتِّع (مُكرَّس للمُتعة واللذّة)",
 "hedonic treadmill": "تَكَيُّف المُتْعَة, تَكَيُّف اللَذَّة",
 "hedonism": "مَذْهَب اَللِّذَّة (المَذْهَب : بمعنى الذَهْاب، السَيْر، المَسْلَك، الإزَالَة؛ المَذْهَب: المُعْتَقَد الديني الذي يُذهب إليه)\nمثال: الوجودية مذهب إنساني.",
 "hedonist": "باحث عن اللذة, متعي (شخص تحفزه الرغبة في الملذات الحسية)",
 "hedonistic": "لَذَّوِيّ, مُتَمَتِّع (مُكرَّس للمُتعة واللذّة)",
 "hedwig": "هدويغ",
 "hedysarum boreale": "بيقية حلوة, هيديساروم شمالي (نبات معمر من غرب الولايات المتحدة له عناقيد من الزهور الوردية إلى الأرجوانية تليها قرون مسطحة تنفصل إلى مفاصل دائرية تقريباً)",
 "hedysarum coronarium": "سلة, عسلة فرنسية (نبات معمر من جنوب أوروبا يزرع للعلف ولزهوره الوردية الغنية بالرحيق التي تجعله محصول عسل مهماً)",
 "hee-haw": "صهلة, ضحكة عالية (ضحكة عالية تشبه صهيل الحصان)",
 "heebie-jeebies": "ارتعاش, توتر شديد (عصبية شديدة)",
 "heed": "اكتراث, اهتمام (إيلاء اهتمام خاص (كما هو الحال مع الأطفال أو العاجزين))\nمثال: يقظته لرغباتها",
 "heedful": "حَرِيص, مُنْتَبِه (يُولي انتباهًا واهتمامًا) / مراعٍ, منتبه (يأخذ الحذر؛ يعطي اهتماماً وثيقاً وعميقاً) / حَذِرٌ, يَقِظٌ (منتبه بحذر وعناية)\nمثال: منتبه للتحذيرات",
 "heedfully": "بانتباه, بحرص (بطريقة متعمدة وحذرة)",
 "heedfulness": "وعي, يقظة ذهنية (سمة البقاء واعياً (إيلاء اهتمام وثيق) بمسؤولياتك)",
 "heedless": "طَائِش, مُتَهَوِّر (يَتَّسِم بِعَدَم الاكْتِرَاث والاسْتِهْتَار) / طائش, غافل (يتسم بـأو يولي القليل من الاهتمام أو الانتباه)\nمثال: لقد عرفنا دائماً أن المصلحة الذاتية الطائشة هي أخلاق سيئة؛ ونعلم الآن أنها اقتصاد سيء",
 "heedlessly": "بإهمال, بلا مبالاة (دون عناية أو اهتمام)\nمثال: رفع آمال الأطفال بإهمال",
 "heedlessness": "سهو, غفلة (سمة نسيان أو تجاهل مسؤولياتك) / رعونة, طيش (سمة التصرف برعونة وبدون تعقل) / سهو, عدم اكتراث (نقص في الانتباه أو اليقظة (تجاه الأطفال أو العاجزين مثلاً))",
 "heel": "عَقِب, كَعْب / كَعْب",
 "heel counter": "دعامة الكعب (قطعة جلد تشكل خلفية الحذاء أو الجزمة)\nمثال: قد تستخدم دعامة الكعب لتقوية المادة حول الكعب وتوفير الدعم للقدم",
 "heel tip": "طرف الكعب (الطرف السفلي للكعب، وعادة ما يكون مصنوعاً من البلاستيك أو المعدن)\nمثال: يحتوي الجزء السفلي من معظم الكعوب عادة على طرف بلاستيكي أو معدني يتآكل مع الاستخدام ويمكن استبداله بسهولة",
 "heelbone": "عظم العقب, عظم الكعب (أكبر عظام الرصغ؛ يشكل كعب الإنسان)",
 "heels over head": "بتهور, رأساً على عقب (في عجلة مضطربة)\nمثال: ركضنا بتهور نحو الملجأ",
 "heeltip": "طرف الكعب (الطرف السفلي للكعب، وعادة ما يكون مصنوعاً من البلاستيك أو المعدن)\nمثال: يحتوي الجزء السفلي من معظم الكعوب عادة على طرف بلاستيكي أو معدني يتآكل مع الاستخدام ويمكن استبداله بسهولة",
 "hefei": "خِفِي, خِيفِي (اختفى أو صار غير مرئي؛ أصبح سريًا أو مجهولًا)\nمثال: كانت لدى سامي حياة خفية.",
 "heft": "ثقل, جسامة (خاصية كون الشيء كبيراً في الكتلة)",
 "heftiness": "ثقل, جسامة (خاصية كون الشيء كبيراً في الكتلة) / فتوة, قوة عضلية (امتلاك قوة عضلية)",
 "hefty": "كَبِير, وَافِر (كَبِيرٌ فِي المِقْدَارِ أَوِ النِّطَاقِ أَوِ الدَّرَجَة) / ثَقيل الوَزْن, ضَخْم (ذو وَزْن وحَجْم كَبيرَيْن) / قَوِيّ البُنْيَة, مَفْتُول العَضَلَات ((للشخص) يمتلك قوة بدنية ووزنًا؛ متين وجبار)",
 "hegari": "هيغاري (سورغم سوداني له بذور بيضاء؛ صنف واحد يزرع في جنوب غرب الولايات المتحدة)",
 "hegelian": "هيغلي (من أو يتعلق بهيغل أو فلسفته الجدلية) / هِِيغْلِيّ (تابع لفكر هيغل)",
 "hegemon": "قوة مهيمنة (قوة رائدة أو مسيطرة)",
 "hegemony": "هَيْمَنَة, سَيْطَرَة",
 "hegira": "نزوح جماعي, هجرة (رحلة لمجموعة كبيرة للهروب من بيئة معادية)",
 "hegumen": "قُمُّص (قَلَق ونفر ووثب؛ لم يستقر في موضع، تراه يقمص فيثب من مكانه من غير صبر)",
 "heidelberg man": "إنسان هايدلبرغ (نوع من البشر البدائيين عاش في أوروبا)",
 "heifer": "عِجْل, عِجْلَة (أسرع في إنجاز شيء أو القيام به؛ قدم شيئًا قبل وقته المعتاد)\nمثال: أنا في عجلة من أمري.",
 "height": "اِرْتِفَاع",
 "height of capillary rise": "اِرْتِفَاع الخَاصِيَّة الشَّعْرِيَّة, اِرْتِفَاع الصُّعُود الشَّعْرِيّ (الارتفاع الذي يصعد إليه السائل في أنبوب شعري)\nمثال: كلما كان الأنبوب أضيق، زاد ارتفاع الخاصية الشعرية",
 "heights": "مرتفع, مكان عال (مكان مرتفع)\nمثال: وقفوا في الأعالي وراقبوا الريف",
 "heihe": "خِيخِه",
 "heilongjiang": "هِيلُونْغْجْيَانْغ, خِيلُونْغْجْيَانْغ",
 "heimlich maneuver": "ضَغْطَات البَطْن, مُناوَرَة هَيْمْلِيك",
 "heimlich manoeuvre": "مناورة هيمليك (إجراء طوارئ لمساعدة شخص يختنق بسبب انحشار الطعام في القصبة الهوائية)",
 "heine": "هَايْنَه",
 "heinous": "شَنِيع, فَاحِش (بَالِغُ الشَّرِّ؛ إِجْرَامِيٌّ فِي أَعْمَاقِه)",
 "heinously": "بشكل وحشي, بشناعة (بطريقة شريرة للغاية)\nمثال: قُتل الطفل بشناعة",
 "heinousness": "شَنَاعَة, فَظَاعَة (صفة كون الفعل قاسياً بشكل مروع وغير إنساني)",
 "heir": "وَارِث, وَرِيث (اسم فاعل من الفعل وَرَثَ؛ الوَارِث: اسم من الأسماء الحسنى)",
 "heir apparent": "وَلِيّ عَهْد (مَلَكَ الأمر وقَامَ به وسيطر عليه وولي عليه ولايةَ)\nمثال: ولي العهد هو من يرث العرش.",
 "heir presumptive": "وريث محتمل (شخص يتوقع أن يرث ولكن يمكن إبطال حقه بولادة قريب أقرب)",
 "heir-at-law": "وريث شرعي (الشخص المخول قانوناً بوراثة ممتلكات شخص يموت دون وصية)",
 "heiress": "وَارِثَة",
 "heirloom": "إرث عائلي, تحفة متوارثة (شيء كان موجوداً في العائلة لأجيال) / إرث عائلي, تحفة متوارثة ((قانون) أي ممتلكات يعتبرها القانون أو العرف غير قابلة للفصل عن الميراث وتورث معه)",
 "heist": "سطو مسلح (سطو تحت تهديد السلاح) / سرقة كبرى, نهب (فعل السرقة)",
 "hejaz": "اَلْحِجَاز (منطقة في المملكة العربية السعودية، تقع في الحد الغربي من شبه الجزيرة العربية، حيث يحدها البحر الأحمر من الغرب)",
 "hejira": "نزوح جماعي, هجرة (رحلة لمجموعة كبيرة للهروب من بيئة معادية)",
 "held": "محتل, ممسوك (مشغول أو تحت سيطرة؛ تستخدم غالباً في التركيبات)\nمثال: أراضٍ يحتلها العدو",
 "helen": "هِيلِين",
 "helenium autumnale": "عشبة العطاس الخريفية (نبات معمر من أمريكا الشمالية بزهور صفراء زاهية في أواخر الصيف)",
 "helenium hoopesii": "عشبة العطاس البرتقالية (عشبة معمرة قوية من غرب الولايات المتحدة ذات رؤوس زهور بأشعة صفراء برتقالية متدلية؛ تسبب مرض القيء في الأغنام)",
 "helenium puberulum": "روزيلا (عشبة عطاس من جنوب غرب الولايات المتحدة وخاصة جنوب كاليفورنيا)",
 "heliac": "شروقي, شمسي (متعلق بـ أو بالقرب من الشمس؛ خاصة الشروق الأول لنجم بعد اختفائه وآخر غروب له قبل اختفائه بسبب اقترانه بالشمس)\nمثال: الشروق الاحتراقي لنجم الشعرى اليمانية",
 "heliacal": "شروقي, شمسي (متعلق بـ أو بالقرب من الشمس؛ خاصة الشروق الأول لنجم بعد اختفائه وآخر غروب له قبل اختفائه بسبب اقترانه بالشمس)\nمثال: الشروق الاحتراقي لنجم الشعرى اليمانية",
 "helianthemum": "هيليانثيموم, وردة الشمس (أي نبات من جنس هيليانثيموم؛ نباتات قوية في المروج الألبية الصخرية ومناطق الأحراش الجافة)",
 "helianthemum canadense": "عشبة الصقيع (نبات معمر من شرق الولايات المتحدة له زهور صفراء منفردة مبكرة تليها زهور متأخرة بدون بتلات؛ سمي كذلك لأن بلورات الجليد تتشكل عليه خلال الصقيع الأول)",
 "helianthemum scoparium": "وردة الأسل (نبات معمر خشبي أصفر الأزهار من جنوب شرق الولايات المتحدة)",
 "helianthus": "دوار الشمس, عباد الشمس (أي نبات من جنس هيليانثوس له رؤوس زهور كبيرة بزهيرات قرصية داكنة وأشعة صفراء مبهرجة)",
 "helianthus angustifolius": "عباد شمس المستنقعات (عباد شمس في شرق أمريكا الشمالية ذو أوراق ضيقة ويوجد في المستنقعات)",
 "helianthus annuus": "دوار الشمس, عباد الشمس الشائع (عباد شمس سنوي يزرع للسيلاج ولبذوره التي تعد مصدراً للزيت؛ شائع في جميع أنحاء الولايات المتحدة ومعظم أمريكا الشمالية)",
 "helianthus giganteus": "بطاطس هندية, عباد شمس عملاق (نبات معمر أمريكي طويل جداً في وسط وشرق الولايات المتحدة إلى كندا ذو جذور درنية صالحة للأكل)",
 "helianthus laetiflorus": "عباد شمس مبهرج (نبات معمر طويل خشن الأوراق بعدد قليل من رؤوس الزهور الكبيرة؛ وسط الولايات المتحدة)",
 "helianthus maximilianii": "عباد شمس ماكسيميليان (نبات معمر طويل من وسط الولايات المتحدة إلى كندا ذو زهور صفراء ذهبية)",
 "helianthus petiolaris": "عباد شمس البراري (مشابه لعباد الشمس الشائع بسيقان نحيلة متفرعة عادة شائع في وسط الولايات المتحدة)",
 "helianthus tuberosus": "أرضي شوكي, خرشوف القدس (نبات معمر طويل بسيقان وأوراق مشعرة؛ يزرع على نطاق واسع لدرناته الكبيرة غير المنتظمة الصالحة للأكل)",
 "helical": "حَلَزُونِيّ, لَوْلَبِيّ (على شكل لفائف حلزونية)",
 "helichrysum bracteatum": "ذهب الشمس, زهرة القش (نبات أسترالي متوطن في إسبانيا له زهور صفراء ليمونية إلى ذهبية عميقة؛ الخيار المتكرر لمحبي الزهور المجففة)",
 "helichrysum secundiflorum": "أوزوثامنوس",
 "helicon": "هيليكون (توبا تلتف فوق كتف الموسيقي)",
