 "ichneumon fly": "دبور النمس, ذبابة النمس (حشرة غشائية الأجنحة تشبه الدبور وتتطفل يرقاتها على اليرقات ويرقات الحشرات الأخرى)",
 "ichor": "صديد, قيح (منتج سائل للالتهاب) / إيكور, دم الآلهة ((في الميثولوجيا الإغريقية) سائل أثيري يُقال إنه يجري في عروق الآلهة)",
 "ichorous": "صديدي, قيحي مائي (متعلق بالصديد المائي (المصل الدموي) أو يشبهه أو يتميز به)\nمثال: إفراز صديدي مائي",
 "ichthyolatry": "عبادة الأسماك (عبادة الأسماك)",
 "ichthyologist": "عالم أسماك (عالم حيوان يدرس الأسماك)",
 "ichthyology": "عِلْم اَلْأَسْمَاك (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "ichthyosaur": "إكتيوصور (أي من الزواحف البحرية المتعددة من حقبة الحياة الوسطى لها جسم يشبه خنزير البحر مع زعانف ظهرية وذيلية وأطراف على شكل مجداف)",
 "ichthyosaurus": "إكتيوصور, عظاية سمكية (عظايات سمكية من العصر الجوراسي)",
 "ichthyosis": "سماك (أي من العديد من الأمراض الخلقية التي يكون فيها الجلد جافاً ومتقشراً مثل السمكة)",
 "ichthyostega": "إكتيوستيجا (برمائي رباعي الأطراف مبكر وجد في جرينلاند)",
 "icicle": "دَلَاة جَلِيدِيَّة",
 "icicle plant": "نبات الثلج, نبات الجليد (نبات سنوي من العالم القديم متوطن على نطاق واسع في المناطق الدافئة ذو زهور بيضاء وأوراق لحمية مغطاة بشعيرات تشبه الجليد)",
 "icily": "ببرود جليدي, بجفاء شديد (بطريقة باردة وجافة)\nمثال: علق السيد براون ببرود جليدي: يجد السيد باول أنه من الأسهل صب غضبه على الأمهات والأطفال والمرضى بدلاً من مواجهة هذه الصناعة الضخمة",
 "iciness": "برود, جفاء (نقص في المودة أو الحماس) / برودة شديدة, صقيع (برودة ناتجة عن بيئة باردة)\nمثال: برود مؤلم في النبرة والأسلوب",
 "icing": "تَغْطِيَة سُكَّر (وضع شيء فوق آخر لإخفائه أو حمايته؛ معالجة ونقل أخبار حدث أو موضوع معين ونشره لجمهور أو ما يصطلح عليه بالتغطية الإعلامية)\nمثال: تمت تغطية زيري.",
 "icing sugar": "سكر التزيين (سكر مسحوق ناعم يستخدم لصنع التزيين)",
 "icing syringe": "محقنة تزيين, محقنة تزيين الكعك (أداة بلاستيكية أو معدنية تستخدم لتزيين الكعك والمعجنات، تشبه في مبدئها كيس الحلواني)",
 "icing the puck": "تشتيت الكرة بعيداً ((هوكي الجليد) فعل ضرب القرص من داخل منطقتك الدفاعية بطول الملعب ليتجاوز مرمى الخصم)",
 "icky": "لَيِّن وَلَزِج (طريّ ولزج الملمس) / تَافِه, رَدِيء جِدًّا ((غير رسمي) سيء جداً ومُقزِّز)",
 "icon": "قُونَة, أَيْقُونَة / أَيْقُونَة",
 "iconic": "أَيْقُونِيّ",
 "iconoclasm": "أيقونية, تحطيم المعتقدات التقليدية (توجه يهدف إلى مهاجمة المعتقدات أو المؤسسات الراسخة)",
 "iconoclast": "متمرد على التقاليد, محطم الأيقونات (شخص يهاجم الأفكار المعتزة أو المؤسسات التقليدية) / محطم الأيقونات (مدمر للصور المستخدمة في العبادة الدينية)",
 "iconoclastic": "مُحَطِّمٌ لِلأَصْنَامِ (مُدَمِّرٌ لِلصُّوَرِ المُسْتَخْدَمَةِ فِي العِبَادَةِ الدِّينِيَّةِ) / تَحْطِيمِيّ, مُهَاجِم لِلْمُسَلَّمَات (يتسم بمهاجمة المعتقدات أو المؤسسات الراسخة)",
 "iconography": "علم رسم الأيقونات (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "iconolatry": "عبادة الأيقونات (عبادة الصور المقدسة)",
 "iconology": "علم الأيقونات (فرع تاريخ الفن الذي يدرس الصور المرئية ومعانيها الرمزية (خاصة من الناحية الاجتماعية أو السياسية))",
 "iconoscope": "أيقونوسكوب (أول كاميرا تلفزيونية عملية لالتقاط الصور؛ اخترعها فلاديمير كوسما زوريكين عام 1923)",
 "iconostasis": "حَاجِز الأَيْقُونِيّ",
 "icosahedral": "عشروني الأوجه, عشروني السطوح (متعلق بالمجسم عشروني الأوجه)",
 "icosahedron": "عشروني السطوح (أي متعدد سطوح له عشرون وجهاً مستوياً)",
 "icsh": "الهرمون الملوتن (هرمون موجه للغدد التناسلية تفرزه الغدة النخامية الأمامية؛ يحفز التبويض في إناث الثدييات ويحفز إطلاق الأندروجين في ذكور الثدييات)",
 "ictal": "تشنجي, نوبي (متعلق بالنوبة المرضية أو التشنج)",
 "ictalurus punctatus": "سلور القنوات (سمكة غذائية من المياه العذبة شائعة في جميع أنحاء وسط الولايات المتحدة)",
 "icteria virens": "دجال أصفر الصدر (طائر مغرد أمريكي يشتهر بتقليد أغاني الطيور الأخرى)",
 "icteric": "مُصاب بِاليَرَقان, يَرَقانِيّ (مُصاب بِاليَرَقان الَّذي يُسَبِّب اصْفِرار الجِلْد)",
 "icterogenic": "محدث للصفار, مسبب لليرقان (يسبب اليرقان (الصفار))",
 "icterus": "صفار, يرقان (اصفرار الجلد وبياض العينين الناتج عن تراكم صبغة الصفراء (البيليروبين) في الدم؛ يمكن أن يكون عرضاً لحصوات المرارة أو عدوى الكبد أو فقر الدم)",
 "icterus galbula": "صفارية شمالية (نوع من صفاريات العالم الجديد)",
 "icterus galbula bullockii": "صفارية بولوك (نويع غربي من الصفارية الشمالية)",
 "icterus galbula galbula": "صفارية بالتيمور (نويع شرقي من الصفارية الشمالية)",
 "icterus neonatorum": "يرقان وليدي (مظهر مصفر عند الرضع حديثي الولادة؛ عادة ما يهدأ تلقائياً)",
 "icterus spurius": "صفارية البساتين (الذكر لونه كستنائي وأسود)",
 "ictic": "تشنجي, نوبي (متعلق بالنوبة المرضية أو التشنج)",
 "ictiobus niger": "جاموس أسود (سمكة في المسيسيبي السفلي)",
 "ictodosaur": "إكتودوصور (متوسط في الشكل بين الثيرابسيدات والثدييات الحقيقية الأكثر بدائية)",
 "ictonyx frenata": "زوريل (ابن عرس يعيش في شمال أفريقيا)",
 "ictonyx striata": "ابن عرس مخطط (ابن عرس بحجم النمس غالباً ما يتم ترويضه)",
 "ictus": "نوبة مرضية (حدوث مفاجئ (أو تكرار) لمرض)\nمثال: عانى من نوبة صرع",
 "icu": "وحدة العناية المركزة (وحدة مستشفى مزودة بموظفين ومعدات لتوفير رعاية مركزة)",
 "icy": "جَلِيدِيّ",
 "id": "هُوَ",
 "id al-adha": "عيد الأضحى (عيد للمسلمين في اليوم العاشر من ذي الحجة يتضمن ذبح الأضاحي)",
 "id al-fitr": "عيد الفطر (يوم احتفال للمسلمين في نهاية شهر رمضان)",
 "id est": "أي (بمعنى؛ أي (لتقديم شرح))",
 "ida": "المؤسسة الدولية للتنمية (وكالة تابعة للأمم المتحدة تابعة للبنك الدولي)",
 "idahoan": "أيداهي (مواطن أو مقيم في أيداهو)",
 "iddm": "السكري المعتمد على الأنسولين, السكري من النوع الأول (داء سكري شديد يظهر مبكرًا؛ يتميز بكثرة التبول والعطش الشديد وزيادة الشهية وفقدان الوزن والحماض الكيتوني العرضي؛ يتطلب النظام الغذائي وحقن الأنسولين…)",
 "idea": "فِكْرَة, فِكْر (صورة ذهنية لأمر ما؛ فِكْر، نَظَر، رَأْي)\nمثال: إنها فكرة جيدة.",
 "ideal": "مِثَالِيّ",
 "ideal gas": "غاز مثالي (غاز افتراضي ذو جزيئات مهملة الحجم لا تمارس أي قوى بين الجزيئات)",
 "ideal solid": "متعدد سطوح منتظم, مجسم أفلاطوني (أي واحد من خمسة مجسمات أوجهها مضلعات منتظمة متطابقة وزواياها متعددة السطوح متطابقة)",
 "idealisation": "إضفاء المثالية, مثالية (تصوير شيء ما على أنه مثالي) / تجسيد مثالي, مثالية (شيء موجود فقط كفكرة) / إضفاء المثالية, مثالية ((في الطب النفسي) آلية دفاع تقسم شيئاً لديك مشاعر متناقضة تجاهه إلى تمثيلين - أحدهما جيد والآخر سيء)\nمثال: كانت مثالية الحياة الريفية مضللة للغاية",
 "idealised": "مُثَالِيّ, مُمَجَّد (مُرتقٍ إلى درجة الكمال المثاليّ)",
 "idealism": "مِثَالِيَّة",
 "idealist": "حَالِم, مِثَالِيّ (شخص تسيّره المثل العليا أكثر من الاعتبارات العملية)",
 "idealistic": "رَفِيع, سَامٍ (ذو قيمة أخلاقية أو فكرية عالية؛ سامٍ في طبيعته أو أسلوبه) / مثالي (مكون من أو متعلق بالمذهب الفلسفي لواقعية الأفكار (المثالية))",
 "ideality": "مثالية (صفة كون الشيء مثالياً)",
 "idealization": "إضفاء المثالية, مثالية (تصوير شيء ما على أنه مثالي) / تجسيد مثالي, مثالية (شيء موجود فقط كفكرة) / إضفاء المثالية, مثالية ((في الطب النفسي) آلية دفاع تقسم شيئاً لديك مشاعر متناقضة تجاهه إلى تمثيلين - أحدهما جيد والآخر سيء)\nمثال: كانت مثالية الحياة الريفية مضللة للغاية",
 "idealized": "مُثَالِيّ, مُمَجَّد (مُرتقٍ إلى درجة الكمال المثاليّ)"
}
