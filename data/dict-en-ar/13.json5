 "hopefully": "إن شاء الله (يفيد التوكيد)\nمثال: إن شاء الله ؛",
 "hopefulness": "أمل, تفاؤل (الشعور الذي ينتابك عندما يكون لديك أمل) / أمل, تفاؤل (ممتلئ بالأمل)",
 "hopeless": "مَيْئُوس مِنْه ((غير رسمي للتأكيد) يتجاوز أي أمل في الإصلاح أو المعالجة) / فاقد للأمل, ميؤوس منه (بدون أمل لعدم وجود إمكانية للراحة أو النجاح) / بِلَا أَمَل, مَيْؤُوس مِنْه (محكوم عليه بالفشل حتماً) / عَاجِز, يَائِس ((عن شخص) غير قادر على فعل شيء بمهارة)\nمثال: في عذاب من الحزن الميؤوس منه",
 "hopelessly": "بيأس (دون أمل؛ يائس لعدم وجود إمكانية للنجاح) / بشكل ميؤوس منه (بطريقة لا أمل فيها) / بِإِحْبَاط, بِفُتُور (بطريقة محبطة وبلا أمل)\nمثال: قال بيأس: 'يجب أن أموت'",
 "hopelessness": "فقدان الأمل (اليأس الذي تشعر به عندما تتخلى عن الأمل في الراحة أو النجاح)",
 "hoper": "آمِل, رَاجٍ (شخص يأمل)\nمثال: وحده الآمل النهم يمكن أن يتوقع فوز الفريق الآن",
 "hopi": "لغة الهوبي (لغة شوشونية يتحدث بها شعب الهوبي) / هوبي (فرد من الشعب الشوشوني في شمال شرق أريزونا)",
 "hopi language": "لغة الهوبي (لغة شوشونية يتحدث بها شعب الهوبي)",
 "hopped-up": "مَسْطُول (تَحْتَ تَأْثِير المُخَدِّرَات وَخَاصَّةً القِنَّب) / مُعَدَّل المُحَرِّك ((عن السيارات) مُعدَّل محركه لإعطاء قوة إضافية)",
 "hopper": "ضربة أرضية, كرة أرضية ((بيسبول) ضربة تسير على الأرض) / جرادة, جندب (حشرة أرضية آكلة للنباتات ذات أرجل خلفية متكيفة للقفز) / قادوس (وعاء قمعي الشكل؛ تمر المحتويات بفعل الجاذبية إلى وعاء أدناه) / آلة قطف الجنجل, قادوس (آلة تستخدم لقطف الجنجل)",
 "hops": "جنجل, حشيشة الدينار (نباتات معمرة ملتفة لها أوراق قلبية الشكل وأزهار مرتبة في سنابل تشبه المخروط؛ تستخدم الأزهار المجففة لهذا النبات في التخمير لإضافة الطعم المر المميز…)",
 "hopsack": "خيش (قماش خشن فضفاض النسج من القطن أو الكتان؛ يستخدم في الملابس)",
 "hopsacking": "خيش (قماش خشن فضفاض النسج من القطن أو الكتان؛ يستخدم في الملابس)",
 "hopscotch": "الحجلة (لعبة يرمي فيها الطفل حجراً في منطقة مرسومة على الأرض ثم يقفز خلالها ويعود لاستعادة الحجر)",
 "horary": "ساعي (متعلق بالساعات)\nمثال: الدورة الساعية",
 "horatian ode": "قصيدة هوراسية (قصيدة غنائية ذات عدة مقطوعات (على نمط هوراس))",
 "horatianism": "هوراسية (نمط من الهجاء صاغه هوراس، وهو شاعر روماني عاش خلال القرن الأول قبل الميلاد)",
 "horchata": "هورشاتا (مشروب إسباني تقليدي، مصنوع من اللوز المطحون، أو السمسم، أو الأرز، أو الشعير، أو حب العزيز، أو بذور البطيخ)",
 "horde": "حَشْد (حَشَد القَوْمَ: جَمَعَهم؛ حَشَد الزَّرْعُ: نَبَتَ كُلُّه)\nمثال: لمحته للحظة وسط الحشد",
 "hordeolum": "جنجل, شحاذ العين (عدوى في الغدة الدهنية للجفن)",
 "hordeum jubatum": "شعير ذيل السنجاب (شعير يزرع لرؤوس زهوره الزخرفية للغاية ذات السفا الحريري الطويل الرقيق؛ أمريكا الشمالية وشمال شرق آسيا)",
 "hordeum murinum": "شعير الحائط (عشب حولي أوروبي يوجد غالباً كعشبة ضارة في الأراضي المهملة خاصة على طول جوانب الطرق والأسيجة)",
 "hordeum pusillum": "شعير صغير (شعير حولي موطنه غرب أمريكا الشمالية ومنتشر في جنوب الولايات المتحدة وأمريكا الاستوائية)",
 "hordeum vulgare": "شعير شائع (عشب ينتج حبوباً تستخدم في طعام الإفطار وعلف الحيوانات وفي مشروبات الشعير)",
 "horehound": "فَرَاسِيُون, شَنَّار",
 "horizon": "أُفُق ((أَفِقَ) أفَقَاً: بلغ النِّهَايَة فِي الْكَرم وَالْعلم فَهُوَ أفق وأفيق)\nمثال: طلعت الشمس فوق الأفق.",
 "horizontal": "أُفُقِيّ",
 "horizontal bar": "عقلة, قضيب أفقي (جهاز جمباز يتكون من قضيب مثبت في وضع أفقي بواسطة قائمين عند كلا الطرفين)",
 "horizontal combination": "تكامل أفقي (الاستيعاب في شركة واحدة لعدة شركات تعمل في نفس مستوى الإنتاج وتشارك الموارد في ذلك المستوى)",
 "horizontal integration": "تكامل أفقي (الاستيعاب في شركة واحدة لعدة شركات تعمل في نفس مستوى الإنتاج وتشارك الموارد في ذلك المستوى)",
 "horizontal merger": "اندماج أفقي (اندماج عادة بين شركتين في نفس قطاع الأعمال)\nمثال: مثال على الاندماج الأفقي هو شراء نظام رعاية صحية لنظام رعاية صحية آخر",
 "horizontal parallax": "تزيح أفقي (أقصى تزيح يتم رصده عندما يكون الجرم السماوي عند الأفق)",
 "horizontal section": "مقطع أفقي (رسم ميكانيكي لجسم كما لو تم صنعه بواسطة مستوى يقطعه أفقياً)",
 "horizontal stabiliser": "ذيل الطائرة, مثبت أفقي (السطح الانسيابي الأفقي لمجموعة ذيل الطائرة الذي يكون ثابتاً ويتم تعليق الرافع عليه)",
 "horizontal stabilizer": "ذيل الطائرة, مثبت أفقي (السطح الانسيابي الأفقي لمجموعة ذيل الطائرة الذي يكون ثابتاً ويتم تعليق الرافع عليه)",
 "horizontal surface": "سطح أفقي, مستوى (سطح مستوٍ بزاوية قائمة مع خط التسامت)\nمثال: أوقف السيارة على مستوى",
 "horizontal tail": "ذيل أفقي (المثبت الأفقي والرافع في مجموعة ذيل الطائرة)",
 "horizontality": "أُفُقِيَّة (صفة التوازي مع الأفق)\nمثال: منازل ذات أفقية واضحة",
 "horizontally": "أفقياً (في اتجاه أفقي)\nمثال: غالباً ما يتم إضافة معرض للاستفادة من المساحة رأسياً وأفقياً",
 "hormic psychology": "علم النفس الغرضي, هرمية (علم نفس معني بالعامل الهادف أو القوة في السلوك)",
 "hormism": "علم النفس الغرضي, هرمية (علم نفس معني بالعامل الهادف أو القوة في السلوك)",
 "hormonal": "هرموني (من أو يتعلق بالهرمونات أو ناتج عنها)\nمثال: تغيرات هرمونية",
 "hormone": "هُرْمُون",
 "hormone replacement therapy": "علاج بالهرمونات البديلة (إعطاء هرمونات (الإستروجين والبروجستين) للنساء بعد انقطاع الطمث؛ يُعتقد أنها تحميهن من أمراض القلب وهشاشة العظام)",
 "hormone-replacement therapy": "علاج بالهرمونات البديلة (إعطاء هرمونات (الإستروجين والبروجستين) للنساء بعد انقطاع الطمث؛ يُعتقد أنها تحميهن من أمراض القلب وهشاشة العظام)",
 "hormuz": "هُرْمُز, مَضِيق هُرْمُز",
 "horn": "بُوق (فَسَد؛ باق الرجل: كَذَب) / زَمْر, بُوق\nمثال: كان سامي ينبه بالبوق.",
 "horn button": "زر البوق, كلاكس (زر تضغطه لتفعيل بوق السيارة)",
 "horn fly": "ذبابة القرن (ذبابة أوروبية سوداء صغيرة أدخلت إلى أمريكا الشمالية؛ تمتص الدم من الماشية خاصة عند قاعدة القرن)",
 "horn of africa": "اَلْقَرْنُ الْأَفْرِيقِيّ",
 "horn of plenty": "قرن الوفرة (قرن ماعز مليء بالحبوب والزهور والفواكه يرمز للازدهار)",
 "horn poppy": "خشخاش أصفر, خشخاش مقرن (عشب أوراسي أزرق مخضر ذو زهور صفراء تم توطينه على طول الشواطئ الرملية في شرق أمريكا الشمالية)",
 "horn-rimmed": "ذُو إِطَارٍ قَرْنِيّ (ذو إطار مصنوع من القرن أو صَدَفة السلحفاة أو البلاستيك المُشابِه)",
 "horn-shaped": "قَرْنِيّ الشَّكْل (على شكل قرن)",
 "hornbeam": "شجرة النير, نير (أي من الأشجار أو الشجيرات المتعددة من جنس النير)",
 "hornbill": "أبو قرن (طائر من أفريقيا الاستوائية وآسيا له منقار كبير جداً يعلوه نتوء عظمي؛ مرتبط بالرفراف)",
 "hornblende": "هورنبلند (معدن أخضر إلى أسود من مجموعة الأمفيبول؛ يتكون من سيليكات الكالسيوم والصوديوم والمغنيسيوم والحديد)",
 "hornbook": "لوح تعليمي (كتاب مبادئ يوفر تعليمات في الأساسيات أو المهارات الأساسية لفرع من المعرفة)",
 "horned": "أَقْرَن",
 "horned asp": "أفعى مقرنة (أفعى شديدة السمية من شمال أفريقيا وجنوب غرب آسيا لها شوكة قرنية فوق كل عين)",
 "horned chameleon": "حرباء مقرنة (نوع من الحرباء)",
 "horned dinosaur": "ديناصور مقرن (أي من عدة ديناصورات عشبية رباعية الأرجل ذات جماجم ضخمة بمنقار؛ من أواخر العصر الطباشيري في أمريكا الشمالية ومنغوليا)",
 "horned lark": "قبرة مقرنة",
 "horned lizard": "سحلية مقرنة (سحلية آكلة للحشرات ذات أشواك تشبه القرون على الرأس وحراشف شائكة على الجسم؛ من غرب أمريكا الشمالية)",
 "horned melon": "كيوانو",
 "horned owl": "بومة قرناء (بوم كبير له خصلات أذن بارزة)",
 "horned pondweed": "جار النهر المقرن, زانيشيليا (يوجد في المياه العذبة أو قليلة الملوحة الراكدة أو بطيئة الحركة؛ مفيد لإضافة الأكسجين لبرك الماء البارد وأحواض السمك)",
 "horned poppy": "خشخاش أصفر, خشخاش مقرن (عشب أوراسي أزرق مخضر ذو زهور صفراء تم توطينه على طول الشواطئ الرملية في شرق أمريكا الشمالية)",
 "horned pout": "سلور مقرن (سلور شائع في شرق الولايات المتحدة)",
 "horned puffin": "بفن مقرن (بفن شمال المحيط الهادئ)",
 "horned rattlesnake": "أفعى جانبية الحركة, أفعى مقرنة",
 "horned screamer": "صياح مقرن (طائر صياح له نتوء يشبه القرن يبرز من الجبهة)",
 "horned toad": "سحلية مقرنة (سحلية آكلة للحشرات ذات أشواك تشبه القرون على الرأس وحراشف شائكة على الجسم؛ من غرب أمريكا الشمالية)",
 "horned violet": "بانسي عنقودي, بنفسج مقرن (فيولا أوروبية ذات مهماز تويج طويل بشكل غير عادي)",
 "horned viper": "أفعى مقرنة (أفعى شديدة السمية من شمال أفريقيا وجنوب غرب آسيا لها شوكة قرنية فوق كل عين)",
 "horned whiff": "ويف مقرن (سمكة ويف توجد في المياه من جزر البهاما وشمال خليج المكسيك إلى البرازيل)",
 "horner's syndrome": "متلازمة هورنر (نمط من الأعراض يحدث نتيجة تلف الأعصاب في منطقة العنق من العمود الفقري (تدلي الجفون وتقبض الحدقة وغياب تعرق الوجه))",
 "hornet": "زُنْبُور",
 "hornet's nest": "عُشُّ الدَّبَابِير (مسكن للدبابير أو الزنابير) / عش الدبابير (وضع شديد الخلاف أو الخطورة)\nمثال: الحديث عن غزو العراق أثار عش دبابير سياسي",
 "hornets' nest": "عش الدبابير",
 "hornfels": "حجر قرني, هورنفلس (صخر متحول ناعم الحبيبات تشكل بفعل الحرارة على الصخور الطينية)",
 "horniness": "تهيج جنسي, شبق (حالة من الاستثارة الجنسية)",
 "hornist": "عازف بوق (موسيقي يعزف على البوق (خاصة البوق الفرنسي))",
 "hornless": "أَجْلَح",
 "hornlike": "شَبِيه بِالقَرْن, قَرْنِيّ (يُشبِه القَرْن في صَلابَتِه وقِوامِه)",
 "hornpipe": "هورن بايب (رقصة فردية بريطانية يؤديها البحارة) / مزمار القرن, هورن بايب (آلة نفخ خشبية قديمة (لم تعد مستخدمة) ذات قصبة واحدة؛ مصنوعة عادة من العظم) / هورن بايب (موسيقى لرقص الهورن بايب)",
 "hornpout": "سلور مقرن (سلور شائع في شرق الولايات المتحدة)",
 "hornstone": "حجر قرني, هورنفلس (صخر متحول ناعم الحبيبات تشكل بفعل الحرارة على الصخور الطينية)",
 "hornwork": "تحصين قرني (عنصر من نظام التحصين الإيطالي يتكون من زوج من أنصاف الحصون)",
 "hornwort": "حشيشة القرن (حشائش كبدية بكبسولات رفيعة تشبه القرن) / شمبلان, نبات قرني الأوراق",
 "horny": "أَقْرَن",
 "horny frog": "سحلية مقرنة (سحلية آكلة للحشرات ذات أشواك تشبه القرون على الرأس وحراشف شائكة على الجسم؛ من غرب أمريكا الشمالية)",
 "horny layer": "طبقة قرنية, طبقة متقرنة (الطبقة الخارجية من البشرة وتتكون من خلايا ميتة تتساقط)",
 "horny structure": "بنية قرنية (أي بنية جسدية صلبة تتكون أساساً من الكيراتين)",
 "horologe": "أداة توقيت, ساعة (أداة قياس أو جهاز لحفظ الوقت)",
 "horologer": "ساعاتي, صانع ساعات (شخص يصنع أو يصلح الساعات)",
 "horologist": "ساعاتي, صانع ساعات (شخص يصنع أو يصلح الساعات)",
 "horology": "صناعة الساعات, علم الساعات (فن تصميم وصناعة الساعات)",
 "horoscope": "خَرِيطَةُ الْبُرُوج, أَبْرَاج (الخَارِطَة، رسم عليه تضاريس الأرض وحدودها)\nمثال: انظر إلى الخريطة.",
 "horoscopy": "قراءة الأبراج (رسم وتفسير خرائط الأبراج)",
 "horrendous": "رَهِيب, مَهُول (يسبب الخوف أو الرعب أو الهلع)",
 "horrible": "رَهِيب, فَظِيع / فَظِيع, أَرْبَد",
 "horribly": "بشكل مروع, بفظاعة (من نوع مروع)\nمثال: كان هناك حادث دموي بشكل مروع على الطريق هذا الصباح",
 "horrid": "بَشِع, مُنْفِر (سيء في أقصى الدرجات) / شَنِيع, فَظِيع (مسيء بشكل فاحش للآداب أو الأخلاق؛ مثير للرعب)",
 "horridly": "بشكل بشع, بفظاعة (بطريقة بشعة)\nمثال: تشوه وجهها بفظاعة بعد الحادث",
 "horridness": "رُعْب, فَظَاعَة (صفة لعدم الارتياح الشديد أو السوء البالغ)",
 "horrific": "رَهِيب, مَهُول (يسبب الخوف أو الرعب أو الهلع) / شَنِيع, فَظِيع (مسيء بشكل فاحش للآداب أو الأخلاق؛ مثير للرعب)",
 "horrified": "مُرَوَّع, مُصَاب بِالهَلَع (أصابه رعب شديد وهول)",
 "horrifying": "فَظِيع, مُرَوِّع (يثير الرعب والهلع)",
 "horrifyingly": "بِرُعْب, بِشَكْل مُرَوِّع (بطريقة مرعبة)\nمثال: ضحك بشكل مرعب",
 "horripilation": "قشعريرة, منعكس محرك للشعر (انتصاب انعكاسي لشعر الجلد استجابة للبرد أو الضغط العاطفي أو تهيج الجلد)",
 "horror": "رُعْب, خَوْف ((رَعَبَ) يَرْعُبُ رُعْبًا: خاف وفَزِعَ؛ في التنزيل العزيز) / رُعْب ((رَعَبَ) يَرْعُبُ رُعْبًا: خاف وفَزِعَ؛ في التنزيل العزيز)\nمثال: سامي يحب قصص الرعب.",
 "horror movie": "فِيلْمُ رُعْبٍ",
 "horror-stricken": "مُرَوَّع, مُصَاب بِالهَلَع (أصابه رعب شديد وهول)",
 "horror-struck": "مُرَوَّع, مُصَاب بِالهَلَع (أصابه رعب شديد وهول)",
 "hors d'oeuvre": "مشهيات, مقبلات (طبق يُقدم لفتح الشهية قبل الوجبة الرئيسية)",
 "horse": "حِصَان, فَرَس (الواحد الذكر من الخَيْل؛ يطلق مجازًا على الواحد من الخيل الذي لا يُعرف ذكر كان أم أنثى)\nمثال: لم يشفى الحصان.",
 "horse balm": "بلسم الحصان, جذر الحجر (عشب معمر قائم قوي الرائحة بأوراق مسننة مدببة وعثكول فضفاض من الزهور المصفرة؛ شرق الولايات المتحدة)",
 "horse balsam": "بلسم الحصان, كريم كستناء الحصان (مرهم يحتوي على مستخلص كستناء الحصان، يستخدم لتخفيف آلام العضلات وآلام المفاصل)\nمثال: أستخدم بلسم الحصان بعد التمرين لتهدئة آلام العضلات",
 "horse barn": "إسطبل (مبنى مزرعة لإيواء الخيول أو غيرها من الماشية)",
 "horse bean": "باقلاء العلف, فول الخيل (نبات فول يُزرع لاستخدامه كعلف للحيوانات)",
 "horse blanket": "لَبَّادَة, لُبَّادَة",
 "horse botfly": "نبرة الخيل (طفيلية بشكل رئيسي على الخيول)",
 "horse breeding": "تربية الخيول (تربية الخيول)",
 "horse brier": "عشبة الثور, فصة مستديرة الأوراق (كرمة خشبية شائكة جداً في شرق الولايات المتحدة تنمو في كتل متشابكة ولها سيقان مستديرة قوية بأوراق جلدية لامعة وأزهار خضراء صغيرة تليها عناقيد من التوت…)",
 "horse cart": "عربة حصان, عربة خيول (عربة ثقيلة؛ يجرها حصان؛ تستخدم للعمل الزراعي)",
 "horse cassia": "المطر الوردي, كاسيا وردية (شجرة أمريكية استوائية شبه دائمة الخضرة لها عناقيد قائمة من الزهور الوردية أو الوردية الملونة؛ تستخدم للزينة) / كاسيا الحصان (شجرة من شرق الهند لها قرون طويلة تحتوي على لب مسهل أسود يستخدم كدواء للخيول)",
 "horse cavalry": "سلاح الفرسان الخيالة (وحدة جيش ممتطية الخيول) / سلاح الفرسان (قوات مدربة للقتال على ظهور الخيل)\nمثال: قاد 500 فارس الهجوم",
 "horse chestnut": "قسطل الحصان, كستناء الحصان (شجرة ذات أوراق راحية وعناقيد كبيرة من الزهور البيضاء إلى الحمراء تليها بذور بنية لامعة غير صالحة للأكل) / كستناء الحصان (البذرة غير الصالحة للأكل التي تشبه الجوز لكستناء الحصان)",
 "horse chestnut balm": "بلسم الحصان, كريم كستناء الحصان (مرهم يحتوي على مستخلص كستناء الحصان، يستخدم لتخفيف آلام العضلات وآلام المفاصل)\nمثال: أستخدم بلسم الحصان بعد التمرين لتهدئة آلام العضلات",
 "horse chestnut cream": "بلسم الحصان, كريم كستناء الحصان (مرهم يحتوي على مستخلص كستناء الحصان، يستخدم لتخفيف آلام العضلات وآلام المفاصل)\nمثال: أستخدم بلسم الحصان بعد التمرين لتهدئة آلام العضلات",
 "horse doctor": "طبيب خيول (طبيب بيطري يعالج الخيول)",
 "horse fancier": "مربي خيول, هاوي خيول (شخص يربي ويعتني بالخيول)",
 "horse fly": "ذباب الخيل (ذباب كبير سريع تمتص إناثه دماء حيوانات مختلفة)",
 "horse gentian": "جذر الحمى, جنطيانا الحصان (عشب أمريكي معمر خشن ضار بأوراق كبيرة عادة ما تكون محيطة بالساق وأزهار أرجوانية أو حمراء باهتة)",
 "horse grain": "حمص الحصان, ماكروتيولما (حَمَصَ الجُرْحُ: سَكَنَ وَرَمُه؛ حَمَصَ القَذَاةَ: أَخْرَجَها مِنْ عَيْنِه بِرِفْقٍ)\nمثال: الحمص مكون أساسي في طبق الفلافل.",
 "horse gram": "حمص الحصان, ماكروتيولما (حَمَصَ الجُرْحُ: سَكَنَ وَرَمُه؛ حَمَصَ القَذَاةَ: أَخْرَجَها مِنْ عَيْنِه بِرِفْقٍ)\nمثال: الحمص مكون أساسي في طبق الفلافل.",
 "horse latitude": "عروض الخيل (أي من الحزامين أو المنطقتين بالقرب من 30 درجة شمالاً أو 30 درجة جنوباً؛ تتميز بهدوء ورياح خفيفة محيرة)",
 "horse mackerel": "جاك ماكريل, ماكريل الحصان (سمكة طعام من كاليفورنيا) / ماكريل الحصان (سمكة طعام كبيرة ممدودة ومضغوطة تعيش في مياه المحيط الأطلسي لأوروبا) / تونة زرقاء الزعانف (أكبر أنواع التونة؛ تصل إلى 1500 رطل؛ تعيش غالباً في البحار المعتدلة: تتغذى في المناطق القطبية ولكن تتكاثر في المناطق الاستوائية)",
 "horse manure": "روث الخيل (فضلات الخيل المستخدمة كسماد)",
 "horse mushroom": "فطر الحصان (فطر خشن صالح للأكل بساق مجوفة وقبعة بيضاء عريضة)",
 "horse nettle": "قراص الحصان, مغد كاروليني (عشب خشن شائك له زهور صفراء شاحبة وثمار صفراء تشبه التوت؛ شائع في جميع أنحاء جنوب وشرق الولايات المتحدة)",
 "horse of the wood": "ديك الخلنج, طيهوج الخشب (طيهوج أسود كبير من العالم القديم)",
 "horse opera": "فيلم الغرب الأمريكي, فيلم ويسترن (فيلم عن الحياة في غرب الولايات المتحدة خلال فترة الاستكشاف والتطوير)",
 "horse parsley": "ألكسندر, سميرنيوم (عشب أوروبي يشبه الكرفس إلى حد ما ومستوطن على نطاق واسع في المناطق الساحلية البريطانية ويزرع غالباً كبقلة)",
 "horse pistol": "مسدس الفرسان (مسدس كبير (عادة في جراب) كان يحمله الفرسان قديماً)",
 "horse race": "سباق خيل (مسابقة سرعة بين الخيول؛ تُقام عادة لغرض المراهنة)",
 "horse racing": "سباق الخيل (رياضة سباق الخيول)",
 "horse radish": "فجل الخيل, فجل حار (نبات أوراسي خشن يُزرع لجذره الأبيض السميك الحريف)",
 "horse sense": "بديهة, حس سليم (حكم عملي سليم)\nمثال: الحس السليم ليس شائعًا جدًا",
 "horse stance": "مَوْقِف حِصَان",
 "horse thistle": "خس شائك (خس بري حولي أوروبي له سيقان شائكة؛ عشبة ضارة مزعجة في أجزاء من الولايات المتحدة)",
 "horse tick": "ذبابة الخيل (ذبابة مجنحة طفيلية على الخيول)",
 "horse trade": "متاجرة بالخيول, مساومة شديدة (مبادلة الخيول (مصحوبة بالكثير من المساومة))",
 "horse trader": "تاجر خيول, مساوم صعب (مساوم صعب المراس (أو تاجر خيول))",
 "horse trading": "متاجرة بالخيول, مساومة شديدة (مبادلة الخيول (مصحوبة بالكثير من المساومة)) / مساومة ذكية, مقايضة ذكية (تفاوض مصحوب بتنازلات متبادلة ومساومة ذكية)",
 "horse wrangler": "سايس الخيل (راعي بقر يعتني بخيول السرج)",
 "horse's foot": "حافر الحصان (حافر حصان)",
 "horse-and-buggy": "مِنْ زَمَنِ العَرَبَات (يَتَعَلَّقُ بِالزَّمَنِ الَّذِي سَبَقَ ظُهُورَ السَّيَّارَاتِ وَالاخْتِرَاعَاتِ الحَدِيثَة)",
 "horse-brier": "عشبة الثور, فصة مستديرة الأوراق (كرمة خشبية شائكة جداً في شرق الولايات المتحدة تنمو في كتل متشابكة ولها سيقان مستديرة قوية بأوراق جلدية لامعة وأزهار خضراء صغيرة تليها عناقيد من التوت…)",
 "horse-cart": "عربة حصان, عربة خيول (عربة ثقيلة؛ يجرها حصان؛ تستخدم للعمل الزراعي)",
