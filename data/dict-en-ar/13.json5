 "hemp agrimony": "غافث القنب (عشب أوروبي خشن ذو أوراق مقسمة كفياً وعناقيد من رؤوس الزهور الحمراء الأرجوانية الصغيرة)",
 "hemp nettle": "غاليوبسيس, قراص القنب (نبات أوراسي خشن ذو شعيرات بأزهار بيضاء أو حمراء وأوراق تشبه أوراق القراص؛ شائع كعشب ضار في الولايات المتحدة)",
 "hemp seed": "بذور القنب (بذرة نبات القنب؛ يمكن أن تؤكل نيئة أو مطحونة أو منبتة أو تحول إلى مسحوق براعم مجفف)",
 "hemp willow": "صفصاف السلال, صفصاف القنب (صفصاف بغصينات مرنة طويلة تستخدم في صناعة السلال)",
 "hempen": "قِنَّبِيّ, لِيفِيّ (ذو ألياف أو يشبه الألياف خاصة تلك المستخدمة في صناعة الحبال)",
 "hempen necktie": "حبل المشنقة (حبل يستخدمه الجلاد لإعدام الأشخاص المحكوم عليهم بالموت شنقاً)",
 "hempseed": "بُذُور الْقِنَّب, شَاهْدَانَج",
 "hemstitch": "تطريز الحاشية (تطريز مشابه للتطريز مسحوب الخيوط) / غرزة الحاشية (غرزة يتم فيها سحب الخيوط المتوازية وجمع الخيوط المكشوفة معاً في مجموعات)",
 "hemstitching": "غرزة الحاشية (غرزة يتم فيها سحب الخيوط المتوازية وجمع الخيوط المكشوفة معاً في مجموعات)",
 "hen": "دَجَاجَة, دُجَاجَة (طَيْر من الدواجن، لا يطير ويربيه البشر لبيضه ولحمه وريشه؛ أنثى بعض الطيور من الفصائل التي لا تطير كالقَبَج وغيره)\nمثال: وضعت الدجاجة بيضة.",
 "hen harrier": "مرزة الدجاج (مرزة شائعة في أمريكا الشمالية وأوروبا؛ تعشش في المستنقعات والأراضي المفتوحة)",
 "hen hawk": "صقر الدجاج (مصطلح غير تقني لأي صقور يقال إنها تفترس الدواجن)",
 "hen of the woods": "دجاجة الغابة, فطر دجاجة الغابة (فطر كبير صالح للأكل بني رمادي يشكل كتلة من القبعات المتداخلة تشبه الدجاجة إلى حد ما عند قاعدة الأشجار)",
 "hen party": "حفلة توديع العزوبية (للنساء), حفلة نسائية (حفلة مخصصة للنساء فقط)",
 "hen turkey": "لحم أنثى الرومي (لحم أنثى الديك الرومي)\nمثال: يتفق معظم الخبراء على أن لحم أنثى الرومي أفضل من لحم الذكر",
 "hen yard": "ساحة الدجاج (فناء مسيج لحفظ الدواجن)",
 "hen-of-the-woods": "دجاجة الغابة, فطر دجاجة الغابة (فطر كبير صالح للأكل بني رمادي يشكل كتلة من القبعات المتداخلة تشبه الدجاجة إلى حد ما عند قاعدة الأشجار)",
 "henan": "خِنَان, خِينَان",
 "henbane": "بَنْج ((بَنَّجَه): خَدَّرَه (مَأْخُوذ من البنج))",
 "henbit": "أذن القسيس, لاميون متموج (نبات أوراسي له أوراق مسننة وزهور صغيرة ثنائية الشفة بيضاء أو حمراء أرجوانية)",
 "hence": "وَعَلَيْهِ, وَمِنْ ثَمَّ",
 "henceforth": "من الآن, من الآن فصاعداً (من هذا الوقت فصاعداً؛ من الآن فصاعداً)\nمثال: من الآن فصاعداً ستعرف باسم السيدة سميث",
 "henceforward": "من الآن, من الآن فصاعداً (من هذا الوقت فصاعداً؛ من الآن فصاعداً)\nمثال: من الآن فصاعداً ستعرف باسم السيدة سميث",
 "henchman": "ذَنَب (ذَنَّبَ: مدَّ ذَنَبَه؛ ذَنَّبَ الضَّبّ: أخرج ذَنَبَهُ من أدنى الجُحْر عند الحَرْشِ)\nمثال: عذر أقبح من ذنب.",
 "henchwoman": "تابعة, مساعدة (امرأة تساعد في مؤامرة)",
 "hencoop": "خم دجاج, قن دجاج (مبنى مزرعة لإيواء الدواجن)",
 "hendiadys": "تثنية المعنى (استخدام اسمين معطوفين بدلاً من اسم وصفة)",
 "henhouse": "خم دجاج, قن دجاج (مبنى مزرعة لإيواء الدواجن)",
 "henna": "حِنَّاء (الحِنَّاءُ : نَبَات من الفصيلة الخثرية التي تتبع رتبة الآسيّات، وَرَقُهُ كورق الرُّمان وعيدانه كعيدانه، له زهر أبيضَ كالعناقيد، وَرَقُهُ أخْضَرُ…؛ خضاب أحمر يُؤخذ من ورق شجرة الحِنَّاء)\nمثال: طائر ابو الحناء هو من اشهر الطيور المغردة التي تعيش في انكلترا .",
 "henotheism": "هينوثية",
 "henpecked": "خَاضِع لِلزَّوْجَة, مُهَيْمَن عَلَيْه (مُضَايَق بِالتَّذَمُّر المُسْتَمِرّ)",
 "henroost": "خم الدجاج, مجثم الدجاج (مجثم للدجاج في الليل)",
 "henry": "هِنْرِي",
 "henry's law": "قانون هنري ((كيمياء) كمية الغاز التي سيتم امتصاصها بواسطة الماء تزداد مع زيادة ضغط الغاز)",
 "hentai": "هِنْتَاي",
 "hep": "عَصْرِيّ, مُوَاكِبٌ لِلْمَوْضَة (مُطّلع على أحدث الصيحات والاتجاهات)",
 "hepadnavirus": "فيروس كبدي, هيبادنافيروس (مجموعة من فيروسات الدنا الحيوانية تشمل فيروسات البط ومرموط الخشب والسناجب وغيرها، بالإضافة إلى الفيروس المسبب لالتهاب الكبد ب لدى البشر)",
 "heparin": "هيبارين (عديد السكاريد ينتج في الخلايا القاعدية (خاصة في الرئة والكبد) ويثبط نشاط الثرومبين في تخثر الدم؛ يستخدم (الأسماء التجارية ليبو-هيبين وغيرها) كمضاد…)",
 "hepatic": "كَبِدِيّ, كِبْدِيّ",
 "hepatic artery": "شريان كبدي (شرايين تغذي الكبد)",
 "hepatic coma": "غيبوبة كبدية (غيبوبة قد تحدث في حالات أمراض الكبد الشديدة)",
 "hepatic duct": "قناة كبدية (القناة التي تصرف الصفراء من الكبد)",
 "hepatic lobe": "فص كبدي (أي من الفصوص الخمسة المكونة للكبد)",
 "hepatic portal vein": "وريد بابي, وريد بابي كبدي (وريد قصير يحمل الدم إلى الكبد)",
 "hepatic tanager": "تناجر كبدي (تناجر شائع في جنوب غرب الولايات المتحدة والمكسيك)",
 "hepatic vein": "وريد كبدي (وريد يصرف الكبد؛ يصب في الوريد الأجوف)",
 "hepatica": "ماركانتيا بوليمورفا, هيباتيكا (حشيشة كبد شائعة) / حشيشة الكبد, هيباتيكا (أي من عدة نباتات من جنس هيباتيكا ذات أوراق ثلاثية الفصوص وأزهار بيضاء أو وردية في أوائل الربيع؛ توجد في مناطق الغابات الرطبة والمغطاة بالطحالب في…)",
 "hepatitis": "اِلْتِهَاب الْكَبِد",
 "hepatitis a": "التهاب الكبد أ, التهاب الكبد المعدي",
 "hepatitis a virus": "فيروس التهاب الكبد أ (الفيروس المسبب لالتهاب الكبد الوبائي أ)",
 "hepatitis b": "التهاب الكبد المصلي, التهاب الكبد ب",
 "hepatitis c": "التهاب الكبد ج",
 "hepatitis delta": "التهاب الكبد دال (شكل حاد من التهاب الكبد)",
 "hepatocarcinoma": "سرطانة الخلية الكبدية, ورم كبدي (سرطانة الكبد)",
 "hepatocellular carcinoma": "سرطانة الخلية الكبدية, ورم كبدي (سرطانة الكبد)",
 "hepatoflavin": "ريبوفلافين, فيتامين ب2 (فيتامين ب يمنع الآفات الجلدية وفقدان الوزن)",
 "hepatojugular reflux": "جزر كبدي وداجي (جزر وريدي يحدث في فشل القلب الاحتقاني)",
 "hepatolenticular degeneration": "تنكس الكبد والعدسة, مرض ويلسون (اضطراب وراثي نادر في استقلاب النحاس)",
 "hepatoma": "سرطانة الخلية الكبدية, ورم كبدي (سرطانة الكبد)",
 "hepatomegaly": "تضخم الكبد (تضخم غير طبيعي للكبد)",
 "hepatotoxic": "سَامّ لِلْكَبِد (ذو تأثير سامّ على الكبد)",
 "hepatotoxin": "ذيفان كبدي, سم كبدي (أي سم يؤثر على الكبد)",
 "heptad": "سَبْعَة, سُبَاعِيّ (العدد الأصلي الذي هو مجموع ستة وواحد)",
 "heptadecanoic acid": "حمض المارجريك (حمض دهني صناعي بلوري عديم اللون)",
 "heptagon": "مُسَبَّع",
 "heptalogy": "سُباعِيَّة",
 "heptane": "هبتان (سائل عديم اللون متطاير وسريع الاشتعال يُستخرج من البترول ويُستخدم كمخدر أو مذيب أو في تحديد تصنيف الأوكتان)",
 "heptasyllable": "سباعي المقاطع (كلمة أو بيت شعر من سبعة مقاطع)",
 "heptose": "هبتوز (سكر أحادي يحتوي على سبع ذرات كربون)",
 "her": "ـهَا / ـهَا, إِيَّاهَا",
 "heracleum sphondylium": "جزر البقر, هرقلية (نبات خشن طويل له سيقان سميكة وعنقود من الزهور البيضاء إلى الأرجوانية)",
 "herald": "بَشِير, مُبَشِّر",
 "heralded": "مُبَشَّر بِهِ (أُعلن عنه أو بُشّر به)",
 "heraldic": "مُبَشِّر, مُنْذِر (يدلّ على شيء قادم أو يُنبئ به) / شعاراتي, نبالي (من أو يتعلق بعلم الشعارات والنبالة)",
 "heraldic bearing": "رسم شعار النبالة, شحنة (شعار النبالة المتمثل في تصميم أو صورة مرسومة على درع)",
 "heraldist": "شعاراتي, نبالي (من أو يتعلق بعلم الشعارات والنبالة)",
 "heraldry": "عِلْم شِعَارات النَبَالَة (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "herat": "هَرَاة",
 "herati": "هَرَوِيّ",
 "herb": "عُشْبَة طِبِّيَّة",
 "herb bennet": "أفينس الغابة, عشبة بينيت (نبات أوراسي زغبي بزهور صفراء صغيرة وجذر قابض كان يستخدم طبياً سابقاً)",
 "herb christopher": "أكتيا, نبات الراهب (نبات من جنس الأكتيا يحمل ثماراً لبية سامة وحريفة الطعم)",
 "herb doctor": "طبيب أعشاب, عشّاب (معالج يعالج باستخدام الأعشاب)",
 "herb garden": "حديقة أعشاب (حديقة لزراعة الأعشاب)",
 "herb mercury": "زئبق العشب, ميركوريالس حولي (نبات حولي أورو-أفريقي مستوطن في أمريكا كعشب ضار؛ كان يجفف سابقاً للاستخدام كمسهل أو مدر للبول أو مضاد للزهري)",
 "herb of grace": "سذاب, فيجن (عشب معمر أوروبي قوي الرائحة بأوراق رمادية مخضرة مرة المذاق؛ مهيج يشبه اللبلاب السام)",
 "herb paris": "عشبة باريس (عشب أوروبي ذو أزهار خضراء مصفرة يشبه ويرتبط ارتباطاً وثيقاً بالتريليوم؛ يشتهر بكونه ساماً)",
 "herb pepper": "فلفل الأعشاب (توابل تتكون من مزيج من الفلفل وأعشاب مختلفة (عادة الريحان والمردقوش والأوريغانو والميرمية والبقدونس والزعتر والفلفل))",
 "herb robert": "إبرة الراعي المنتنة, عشبة روبرت (عشب لزج منخفض بزهور حمراء أرجوانية صغيرة؛ واسع الانتشار في نصف الكرة الشمالي)",
 "herb roberts": "إبرة الراعي المنتنة, عشبة روبرت (عشب لزج منخفض بزهور حمراء أرجوانية صغيرة؛ واسع الانتشار في نصف الكرة الشمالي)",
 "herb tea": "شاي الأعشاب, مشروب عشبي (مشروب يشبه الشاي مصنوع من أوراق أعشاب متنوعة)",
 "herba impia": "عشبة عاقة, فيلاجو ألمانية ((حرفياً عشبة غير مطيعة) نوع من ورد القطن)",
 "herbaceous": "عُشْبِيّ (مِنْ سِمَاتِ النَّبَاتِ العُشْبِيِّ غَيْرِ الخَشَبِيِّ)",
 "herbaceous plant": "عشب, نبات عشبي (نبات يفتقر إلى ساق خشبي دائم؛ العديد منها نباتات حدائق مزهرة أو أعشاب طبخ؛ لبعضها خصائص طبية؛ وبعضها آفات)",
 "herbage": "حشائش, كلأ (الغطاء النباتي العشبي العصاري في أراضي الرعي)",
 "herbal": "عشبي (متعلق بالأعشاب) / شاي الأعشاب, مشروب عشبي (مشروب يشبه الشاي مصنوع من أوراق أعشاب متنوعة)\nمثال: شاي عشبي، طب عشبي",
 "herbal medicine": "طب الأعشاب (استخدام الأعشاب الطبية للوقاية من الأمراض أو علاجها أو تعزيز الصحة) / دواء عشبي (دواء مصنوع من النباتات ويستخدم للوقاية من المرض أو علاجه أو تعزيز الصحة)",
 "herbal tea": "شاي الأعشاب, مشروب عشبي (مشروب يشبه الشاي مصنوع من أوراق أعشاب متنوعة)",
 "herbal therapy": "طب نباتي, علاج بالأعشاب (استخدام النباتات أو المستخلصات النباتية لأغراض طبية (خاصة النباتات التي ليست جزءاً من النظام الغذائي العادي))",
 "herbalist": "طبيب أعشاب, عشّاب (معالج يعالج باستخدام الأعشاب)",
 "herbarium": "مَعْشَبَة",
 "herbicide": "مبيد الأعشاب, مبيد نباتي (عامل كيميائي يدمر النباتات أو يمنع نموها)",
 "herbivore": "حَيَوَان عَاشِب (بمعنى أصبح له حياة؛ الحَيَاة. والحَيَوَان أبلغ من الحَيَاة؛ جنس الحَيّ الذي يأكل وينمو ويتحرك بالإرادة وبه حِسّ بخلاف ما به حياة فقط دون الحس مثل النَبَات. بعض العامة تقول حَيْوَان وهو غلط)\nمثال: هذا حيوان أليف.",
 "herbivorous": "عَاشِب",
 "herbs mercury": "زئبق العشب, ميركوريالس حولي (نبات حولي أورو-أفريقي مستوطن في أمريكا كعشب ضار؛ كان يجفف سابقاً للاستخدام كمسهل أو مدر للبول أو مضاد للزهري)",
 "herbs robert": "إبرة الراعي المنتنة, عشبة روبرت (عشب لزج منخفض بزهور حمراء أرجوانية صغيرة؛ واسع الانتشار في نصف الكرة الشمالي)",
 "herculean": "جَبَّار, خَارِق الصُّعُوبَة (بَالِغ الصُّعُوبَة؛ يَتَطَلَّب قُوَّةً خَارِقَة) / جَبَّار, خَارِق القُوَّة (يُظهر قوّة أو جبروتًا يفوق البشر)",
 "hercules": "هِرَقْل",
 "hercules'-club": "شجرة أنجليكا الأمريكية, عصا الشيطان (شجرة أو شجيرة نفضية صغيرة تشكل كتلاً في شرق الولايات المتحدة) / فاغرة هرقلية, هراوة هرقل (نبات زينة كثيف الأشواك ينمو في جنوب شرق الولايات المتحدة وجزر الهند الغربية)",
 "hercules'-clubs": "فاغرة هرقلية, هراوة هرقل (نبات زينة كثيف الأشواك ينمو في جنوب شرق الولايات المتحدة وجزر الهند الغربية)",
 "hercules-club": "فاغرة هرقلية, هراوة هرقل (نبات زينة كثيف الأشواك ينمو في جنوب شرق الولايات المتحدة وجزر الهند الغربية)",
 "herd": "قَطِيع / رَعَى / رَاعٍ ((رَاعَ) يَرُوعُ رَوْعًا: فَزِعَ؛ يُقال: (راع) منه) / مثال: سلم إيغور القطيع لراع آخر.",
 "herd immunity": "مناعة القطيع",
 "herd's grass": "تيموثي, عشب القطيع (عشب بسنابل أسطوانية طويلة يُزرع في شمال الولايات المتحدة وأوروبا للقش)",
 "herder": "رَاعٍ ((رَاعَ) يَرُوعُ رَوْعًا: فَزِعَ؛ يُقال: (راع) منه)\nمثال: سلم إيغور القطيع لراع آخر.",
 "herdsman": "رَاعٍ ((رَاعَ) يَرُوعُ رَوْعًا: فَزِعَ؛ يُقال: (راع) منه)\nمثال: سلم إيغور القطيع لراع آخر.",
 "herdswoman": "راعية, راعية ماشية (امرأة تقود قطيعاً)",
 "here": "إِلَى هُنَا (حرف جر يُفيد الغاية الزمنية؛ حرف جر يُفيد الغاية المكانية)\nمثال: تعال إلى منزلي.",
 "here and now": "اللحظة الراهنة, الوقت الحاضر (في هذا الوقت)\nمثال: خيبات أمل اللحظة الراهنة",
 "here and there": "هُنَا وَهُنَاكَ",
 "here we go again": "نعيد الكَرة مرة أخرى",
 "here you are": "تَفَضَّل, تَفَضَّلِي",
 "hereabout": "في هذا الجوار, في هذه الأنحاء (في هذا الجوار العام)\nمثال: الناس ودودون في هذه الأنحاء",
 "hereabouts": "في هذا الجوار, في هذه الأنحاء (في هذا الجوار العام)\nمثال: الناس ودودون في هذه الأنحاء",
 "hereafter": "فيما بعد, من الآن فصاعداً (بعد هذا في الزمان أو الترتيب أو المكان؛ بعد هذا) / في الآخرة, في الحياة الآخرة (في حياة أو حالة مستقبلية) / أدناه, فيما بعد (في جزء لاحق من هذه الوثيقة أو البيان أو المسألة) / مستقبل (الزمن الذي لم يأت بعد)\nمثال: من الآن فصاعداً لن تتلقى مصروفاً",
