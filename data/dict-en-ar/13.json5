 "horsecar": "ترام تجره الخيول (شكل مبكر من الترام كان يجر بالخيول)",
 "horsecloth": "غطاء الحصان (قماش لزينة الحصان)",
 "horsefish": "سمكة القمر (أي من عدة أسماك بحرية فضية ذات أجسام مسطحة جداً)",
 "horseflesh": "لحم خيل (لحم الخيول كطعام)",
 "horsefly": "نُعَرَة",
 "horsefly weed": "عشبة ذبابة الخيل, نيلة برية (عشبة منتصبة كثيرة التفرع ذات أزهار صفراء زاهية؛ موزعة من ماساتشوستس إلى فلوريدا)",
 "horsehair": "قماش شعر الخيل (قماش مصنوع من الألياف المأخوذة من عرف أو ذيل الخيل؛ يستخدم للتنجيد) / شعر الخيل (الشعر المأخوذ من عرف أو ذيل الحصان)",
 "horsehair lichen": "أشنة شعر الحصان (أي من عدة أشنات من جنس ألكتوريا لها ثالوس يتكون من خيوط تشبه الشعر)",
 "horsehair wig": "باروكة شعر الخيل (شعر مستعار مصنوع من شعر الخيل)\nمثال: يرتدي القضاء الإنجليزي باروكات شعر الخيل التقليدية",
 "horsehead": "سمكة القمر (أي من عدة أسماك بحرية فضية ذات أجسام مسطحة جداً)",
 "horsehide": "جلد الحصان (جلد مصنوع من إهاب الحصان)",
 "horselaugh": "صهلة, ضحكة عالية (ضحكة عالية تشبه صهيل الحصان)",
 "horseleech": "علقة الخيل (أي من عدة علقات مياه عذبة كبيرة)",
 "horseless carriage": "عربة بلا حصان (مصطلح مبكر للسيارة)\nمثال: عندما حلت السيارات لأول مرة محل العربات التي تجرها الخيول، كانت تسمى عربات بلا خيول",
 "horseman": "فَارِس, رَاكِب (اسم فاعل لفَرَسَ؛ راكب الفَرَس أو الحِصَان)\nمثال: فارس الظلام فيلم جيد.",
 "horsemanship": "فروسية (المهارة في التعامل مع الخيول وركوبها)",
 "horsemeat": "لَحْم حِصَان (ما يبقى من جسم الحيوان أو الإنسان بعد إزالة الجلد الأحشاء والعظم والشحم والدم والأعصاب. يتكون أساسا من العَضَلَات؛ ما يؤكل من لحم من الحيوان والطير والسمك عامة)\nمثال: أفضل لحم البقر.",
 "horsemint": "حبق الحصان, نعناع طويل الأوراق (نعناع مائي بري خشن من العالم القديم له أوراق طويلة وعناقيد من الزهور تشبه السنابل؛ تم توطينه في شرق الولايات المتحدة) / مونردة منقطة (نبات معمر أو حولي منتصب طويل له أوراق رمحية ورؤوس من الزهور الكريمية المرقطة بالأرجواني؛ تزرع العديد من سلالاته من شرق إلى جنوب غرب الولايات المتحدة…) / مونردة ليمونية, نعناع ليموني (نبات حولي من وسط وغرب الولايات المتحدة وشمال المكسيك)",
 "horseplay": "مزاح خشن (لعب صاخب أو خشن)",
 "horsepond": "بركة خيول (بركة لسقي الخيول)",
 "horsepower": "حِصَان (الواحد الذكر من الخَيْل؛ يطلق مجازًا على الواحد من الخيل الذي لا يُعرف ذكر كان أم أنثى)\nمثال: لم يشفى الحصان.",
 "horsepower-hour": "حصان ساعي (وحدة شغل تساوي الشغل الذي يبذله حصان ميكانيكي واحد في ساعة واحدة)",
 "horseradish": "فُجْل حَارّ (فَجَّلَ الشيءَ تعني عرَّضَهُ، أي جعله مكشوفًا أو ظاهرًا. يمكن استخدام الفعل للإشارة إلى تعريض شيء ما للآخرين أو جعله واضحًا؛ فجل - يفجل، فجلا، الكلمة مرتبطة بتغيير شكل الشيء ليصبح أوسع أو أكثر استرخاءً وغلظة)",
 "horseradish peroxidase": "بيروكسيداز الفجل (إنزيم يُستخدم في الكيمياء الهيستولوجية المناعية لتسمية المستضدات وأجسامها المضادة)",
 "horseradish root": "فجل الحصان (جذر نبات فجل الحصان؛ يبشر أو يطحن ويستخدم للتتبيل)",
 "horseradish sauce": "صلصة الفجل الحار (صلصة بيضاء كريمية مع الفجل الحار والخردل)",
 "horseshit": "كَلَام بَذِيء, هُرَاء (كلمة بذيئة للسلوك غير المقبول)\nمثال: تحملت الكثير من الهراء من ذلك الأحمق",
 "horseshoe": "حَدْوَة, حِدْوَة",
 "horseshoe arch": "قوس حدوة الحصان, قوس مغاربي (قوس مستدير يتسع قبل أن يدور)",
 "horseshoe bat": "خفاش حدوة الحصان (خفاش من فصيلة رينولوفيداي له ورقة على شكل حدوة حصان على الأنف) / خفاش حدوة الحصان (أي من العديد من الخفافيش من فصيلة هيبوسيديريداي في شمال غرب أفريقيا أو الفلبين أو أستراليا لها ورقة على شكل حدوة حصان على الأنف)",
 "horseshoe crab": "سرطان حدوة الحصان, سلطعون حدوة الحصان (مفصلي بحري كبير من ساحل المحيط الأطلسي لأمريكا الشمالية له درقة مقببة تشبه حدوة الحصان وذيل مدبب صلب)",
 "horseshoe vetch": "بيقية حدوة الحصان (نبات معمر خشبي أوروبي بزهور مظلية صفراء تليها قرون مسطحة تنفصل إلى مفاصل على شكل حدوة حصان)",
 "horseshoe whipsnake": "ثعبان السوط حدوة الحصان (ثعبان أوراسي نحيل سريع الحركة)",
 "horseshoer": "بيطار, حاذي الخيول (شخص يركب حدوات الخيول)",
 "horseshoes": "رمي الحلقات, رمي حدوة الحصان (لعبة يتم فيها رمي حلقات حديدية (أو حلقات حديدية مفتوحة) على وتد في الأرض على أمل تطويقه)",
 "horseshow": "عرض خيول (معرض تنافسي للخيول)",
 "horsetail": "كِنْبَاث, ذَنَب الْخَيْل",
 "horsetail lichen": "أشنة شعر الحصان (أي من عدة أشنات من جنس ألكتوريا لها ثالوس يتكون من خيوط تشبه الشعر)",
 "horsetail milkweed": "صقلاب ذيل الحصان, صقلاب سام (صقلاب من جنوب غرب الولايات المتحدة والمكسيك؛ سام للماشية)",
 "horseweed": "أريغارون كندي, ذيل الحصان (عشب ضار شائع في أمريكا الشمالية بأوراق خطية ورؤوس قرصية صغيرة من الزهور الصفراء؛ مستوطن على نطاق واسع في جميع المناطق المعتدلة؛ يوضع أحياناً في جنس…) / بلسم الحصان, جذر الحجر (عشب معمر قائم قوي الرائحة بأوراق مسننة مدببة وعثكول فضفاض من الزهور المصفرة؛ شرق الولايات المتحدة)",
 "horsewhip": "سوط الخيل (سوط للتحكم في الخيول)",
 "horsewhipping": "ضرب بسوط الخيل (فعل الجلد بسوط الخيل)",
 "horsewoman": "خيالة, فارسة (امرأة ماهرة في الفروسية) / سايسة, مربية خيول (شخص أنثى تقوم بتربية ورعاية الخيول)",
 "horsey set": "عشاق الخيل (مجموعة من الأشخاص يتشاركون في حب الخيول وركوب الخيل وسباق الخيل)",
 "horst": "كتلة ناتئة, هورست (حيد من القشرة الأرضية تم دفعه للأعلى بين صدعين ويكون أعلى من الأرض المحيطة)",
 "horsy set": "عشاق الخيل (مجموعة من الأشخاص يتشاركون في حب الخيول وركوب الخيل وسباق الخيل)",
 "hortative": "تَحْرِيضِيّ, وَعْظِيّ (يقدّم تشجيعاً قويّاً وحثّاً شديداً)",
 "hortatory": "تَحْرِيضِيّ, وَعْظِيّ (يقدّم تشجيعاً قويّاً وحثّاً شديداً)",
 "hortensia": "توهج ذهبي (عشب متفرع طويل جداً برؤوس زهور صفراء مزدوجة كثيرة ملفتة للنظر) / كوبية كبيرة الأوراق, هورتنسيا (شجيرة متساقطة الأوراق تحمل عناقيد زهور مستديرة الرأس تفتح خضراء وتتحول إلى الوردي أو الأزرق مع تقدم العمر)",
