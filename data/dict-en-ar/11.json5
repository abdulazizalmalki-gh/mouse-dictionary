 "for all the world": "بأي حال, تحت أي ظرف (تحت أي ظرف من الظروف)\nمثال: لن تتخلى عن حيواناتها الأليفة بأي حال",
 "for any price": "بأي حال, تحت أي ظرف (تحت أي ظرف من الظروف)\nمثال: لن تتخلى عن حيواناتها الأليفة بأي حال",
 "for anything": "بأي حال, تحت أي ظرف (تحت أي ظرف من الظروف)\nمثال: لن تتخلى عن حيواناتها الأليفة بأي حال",
 "for certain": "بالتأكيد, حتماً (بشكل قاطع أو إيجابي)\nمثال: النتائج مشجعة بالتأكيد",
 "for dear life": "للنجاة بحياته (كما لو كانت حياتك على المحك)\nمثال: كان يركض للنجاة بحياته",
 "for each one": "لِكُلّ وَاحِد (لكل فرد من اثنين أو أكثر (يعتبرون بشكل فردي))\nمثال: حصل كل واحد منهم على 10 دولارات",
 "for example": "مَثَلاً, عَلَى سَبِيل الْمِثَال",
 "for free": "مَجَّانًا, بلاش",
 "for fun": "على سبيل المزاح, للمرح (غير مقصود بجدية؛ يعني مزحة)\nمثال: كان كل ذلك للمرح",
 "for god's sake": "مِنْ أَجْلِ اللّٰهِ, لِوَجْهِ اللّٰهِ (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "for good": "إلى الأبد, بشكل دائم (لفترة طويلة دون تغيير جوهري)\nمثال: هو معاق بشكل دائم",
 "for good measure": "زيادة في الخير, علاوة على ذلك (بالإضافة (لإتمام صفقة))\nمثال: أضاف بائع السيارات الراديو، زيادة في الخير",
 "for heaven's sake": "لِوَجْهِ اللّٰهِ, مِنْ أَجْلِ اللّٰهِ",
 "for instance": "على سبيل المثال, مثلاً\nمثال: خذ الثعابين الشريطية على سبيل المثال (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال.",
 "for keeps": "بشكل نهائي, للأبد (ليحتفظ الفائز بالكل)\nمثال: لعبوا بشكل نهائي",
 "for love or money": "بأي حال, تحت أي ظرف (تحت أي ظرف من الظروف)\nمثال: لن تتخلى عن حيواناتها الأليفة بأي حال",
 "for nothing": "من دون مقابل (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "for one": "على سبيل المثال لا الحصر, من جهة (كواحد معين من عدة احتمالات)\nمثال: أنا على سبيل المثال ممتن جداً",
 "for real": "جادّ, صادق (تَكَرَّمَ أو بَذَلَ مَالَهُ أو فَضْلَهُ؛ سَخَا، أَعْطَى بسخاءٍ)\nمثال: أنا جاد يا توم.",
 "for rent": "لِلْإِيجَار",
 "for sale": "لِلبَيع",
 "for short": "اختصاراً\nمثال: نادني بوب اختصاراً",
 "for sure": "بالتأكيد, حتماً (بشكل قاطع أو إيجابي) / مُؤَكَّد, يَقِينِيّ (غير قابل للشكّ أو الطعن)\nمثال: النتائج مشجعة بالتأكيد",
 "for that matter": "في هذا الشأن, لهذا الأمر (بقدر ما يتعلق الأمر بذلك)\nمثال: لهذا الأمر، أنا لا أهتم أيضاً",
 "for the asking": "رهن الطلب, عند الطلب (بمناسبة الطلب)\nمثال: كانت النصيحة مجانية عند الطلب",
 "for the moment": "في الوقت الحالي, مؤقتاً (بشكل مؤقت)\nمثال: سنتوقف في الوقت الحالي",
 "for the most part": "إلى حد كبير, بشكل رئيسي (في جزء كبير؛ بشكل رئيسي أو أساسي)\nمثال: هذه الحسابات غير نشطة إلى حد كبير",
 "for the sake of": "مِن أَجْلِ (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "for the time being": "في الوقت الحالي, مؤقتاً (بشكل مؤقت)\nمثال: سنتوقف في الوقت الحالي",
 "for your information": "لمعلوماتك",
 "forage": "بحث عن الطعام (فعل البحث عن الطعام والمؤن) / حشيش, كلأ (طعام ضخم الحجم مثل العشب أو التبن للخيول أو الماشية التي ترعى)",
 "forager": "باحث عن الطعام, بَحّاث (شخص يبحث عن الطعام والمؤن)\nمثال: في اليابان يمكن للباحث عن الفطر أن يكسب عيشاً جيداً",
 "foraging": "بحث عن الطعام (فعل البحث عن الطعام والمؤن)",
 "foram": "منخربات (كائن دقيق بحري له صدفة كلسية ذات فتحات تبرز منها الأقدام الكاذبة)",
 "foramen": "ثُقْبَة",
 "foramen magnum": "الثقبة العظمى (الفتحة الكبيرة في قاعدة الجمجمة التي يمر من خلالها الحبل الشوكي)",
 "foramen of monro": "الثقبة بين البطينين, ثقبة مونرو (الفتحة الصغيرة (على الجانبين الأيمن والأيسر) التي تربط البطين الثالث في الدماغ البيني بالبطين الجانبي في نصف الكرة المخية)",
 "foraminifer": "منخربات (كائن دقيق بحري له صدفة كلسية ذات فتحات تبرز منها الأقدام الكاذبة)",
 "foray": "غزوة, محاولة استكشافية (محاولة أولية (خاصة خارج مجالات اختصاصك المعتادة)) / غارة, هجمة مباغتة (هجوم قصير مفاجئ)\nمثال: غزوات العلماء في السياسة",
 "forbear": "سلف (شخص تنحدر منه)",
 "forbearance": "حِلْم (رأى في نومه)\nمثال: هذا الحلم سيتحقق.",
 "forbearing": "أَنَاةٌ, حَلِيم (يُظْهِرُ ضَبْطَ النَّفْسِ وَالتَّحَمُّلَ فِي الشَّدَائِدِ؛ بَطِيءٌ فِي الانْتِقَام)",
 "forbid": "حَرَّمَ, حَظَرَ (مَنَعَ ولم يعطِ)\nمثال: حرم الإسلام الترويع",
 "forbiddance": "تحريم, حظر (فعل الحظر أو المنع أو التحريم (أو مثال عليه)) / حظر, منع (حظر رسمي أو مرسوم ضد شيء ما)\nمثال: تم تقييدهم بموجب حظر في ميثاقهم",
 "forbidden": "مَحْظُور, مُحَرَّم (اسم مفعول من حَظَرَ؛ المَمْنُوع والمُحَرَّم، ضد المُبَاح)",
 "forbidden fruit": "فَاكِهَة مُحَرَّمَة (الثمار كلها؛ ما يتنعم بأكله رطبا كان أم يابسا كالتين واللوز والرمان ونحوها)\nمثال: التفاح فاكهة لذيذة.",
 "forbidden fruit is the sweetest": "كُلُّ مَمْنُوعٍ مَرْغُوب",
 "forbidding": "مُتَوَعِّد, مُنْذِر بِالشَّرّ (يهدد أو ينذر بتطورات شريرة أو مأساوية) / صَارِم, عَبُوس (غير مرحب بقسوة أو مهيب في الأسلوب أو المظهر) / حظر, منع (حظر رسمي أو مرسوم ضد شيء ما)",
 "forbiddingly": "بشكل منفر, بشكل مهدد (بطريقة بغيضة أو مهددة)\nمثال: كان الظلام موحشاً بشكل منفر في الممر",
 "force": "قُوَّة (ضد الضُعْف، الشِدَّة والقُدْرَة الجِسْمَانِيَّة؛ ضد الضُعْف، المَقْدِرَة والحَوْل والتَمَكُّن، القدرة المعنوية) / أَجْبَرَ, اِضْطَرَّ (فعل تعدّي من جَبَرَ؛ جعله يَجْبُر، ضد أَكْسَرَ؛ جعله يفعل شيئا رُغْما عنه؛ أَرْغَمَ)\nمثال: توم شعر بالقوة.",
 "force feed": "نظام تزييت (نظام ميكانيكي لتزييت محركات الاحتراق الداخلي حيث تضخ مضخة الزيت إلى محامل المحرك)",
 "force field": "حقل, حقل القوة (الحيز حول جسم مشع والذي يمكن لتذبذباته الكهرومغناطيسية أن تمارس قوة على جسم مشابه آخر غير ملامس له)",
 "force majeure": "قوة قاهرة (ضد الضُعْف، الشِدَّة والقُدْرَة الجِسْمَانِيَّة؛ ضد الضُعْف، المَقْدِرَة والحَوْل والتَمَكُّن، القدرة المعنوية)\nمثال: توم شعر بالقوة.",
 "force out": "إخراج قسري, فورس آوت (إخراج عداء قاعدة مطلوب منه الركض)\nمثال: أمسك لاعب الشورت ستوب بالعداء عند الثانية في لعبة إجبارية",
 "force per unit area": "ضغط, مستوى الضغط\nمثال: يمارس الغاز المضغوط ضغطاً متزايداً",
 "force play": "إخراج قسري, فورس آوت (إخراج عداء قاعدة مطلوب منه الركض)\nمثال: أمسك لاعب الشورت ستوب بالعداء عند الثانية في لعبة إجبارية",
 "force pump": "مضخة ضغط (مضخة تستخدم لدفع السائل لأعلى وطرده تحت الضغط)",
 "force unit": "وحدة قوة (وحدة لقياس القوة الفيزيائية)",
 "force-feed lubricating system": "نظام تزييت (نظام ميكانيكي لتزييت محركات الاحتراق الداخلي حيث تضخ مضخة الزيت إلى محامل المحرك)",
 "force-out": "إخراج قسري, فورس آوت (إخراج عداء قاعدة مطلوب منه الركض)\nمثال: أمسك لاعب الشورت ستوب بالعداء عند الثانية في لعبة إجبارية",
 "forced": "قَسْرِيّ, مُتَكَلَّف (يفتقر إلى العفوية؛ غير طبيعي) / اضْطِرَارِيّ, قَسْرِيّ (فُرض بسبب وضع طارئ أو غير متوقع) / إِجْبَارِيّ, قَسْرِيّ (تَمَّ بِالإِجْبَارِ وَالإِكْرَاه) / إجباري, قسري (ناتج عن أو خاضع للقوة)\nمثال: تدفئة بالهواء القسري",
 "forced feeding": "تغذية أنبوبية, تغذية قسرية (تغذية تتكون من إيصال محلول مغذ (كما عبر أنبوب أنفي) لشخص لا يستطيع أو لا يريد الأكل)",
 "forced labor": "عمل قسري (فِعْل، صُنْع؛ وسيلة للكسب، مِهْنَة، حِرْفَة)\nمثال: المهم هو العمل.",
 "forced landing": "هبوط اضطراري (هبوط غير مجدول للطائرة يتم في ظروف خارجة عن سيطرة الطيار)",
 "forced sale": "بيع جبري, بيع قضائي (بيع الممتلكات من قبل الشريف بموجب أمر تنفيذ من المحكمة للوفاء بالتزام غير مدفوع)",
 "forceful": "حَازِم, قَاطِع (قويّ وحاسم في التعبير أو الفعل) / حازم, فعال (يتميز بـ أو مليء بالقوة أو الشدة (غالباً ولكن ليس بالضرورة جسدياً))\nمثال: متحدث قوي",
 "forcefully": "بزخم, بقوة (بكامل القوة والتأثير)\nمثال: نحن نشاهد هذا الفيلم متأخرين جداً لنشعر بتأثيره الأصلي بقوة",
 "forcefulness": "شدة, قوة (طاقة بدنية أو شدة)\nمثال: ضرب بكل القوة التي استطاع حشدها",
 "forceless": "بلا قوة, ضعيف (يفتقر إلى القوة؛ ضعيف)\nمثال: حجة واهية",
 "forcemeat": "حشوة مفرومة, فورس ميت (خليط من الدجاج النيئ المفروم والفطر مع الفستق والكمأة والبصل والبقدونس والكثير من الزبدة ويربط بالبيض)",
 "forceps": "جفت, ملقط جراحي (أداة استخراج تتكون من زوج من الكماشات تستخدم في العلاج الطبي (خاصة لتوليد الأطفال))",
 "forceps delivery": "ولادة بالملقط (ولادة يتم فيها إدخال الملقط عبر المهبل واستخدامه للإمساك برأس الجنين وسحبه)",
 "forcible": "بِالقُوَّة, قَسْرِيّ (مدفوع بالقوّة الجسدية خاصة ضدّ المقاومة)",
 "forcibly": "بالإكراه, بالقوة (بطريقة تتضمن استخدام القوة)\nمثال: تذكر مخاطر فرض قيمنا وتحيزاتنا بالقوة",
 "forcing out": "إخراج, طرد (فعل الطرد أو القذف أو الإخراج)",
 "forcipate": "متشعب, ملقطي (على شكل ملقط؛ متشعب بعمق)",
 "ford": "مَخَاضَة",
 "fordable": "قَابِلٌ لِلْخَوْض (ضَحْلٌ بِمَا يَكْفِي لِعُبُورِهِ مَشْيًا أَوْ رُكُوبًا)",
 "fordhooks": "فاصولياء فورد هوك (فاصولياء ليما كبيرة نسبياً)",
 "fording": "خوض (فعل عبور مجرى مائي أو نهر عن طريق الخوض أو في سيارة أو على حصان)",
 "fordism": "فَوْرِدِيَّة",
 "fore": "فِي المُقَدِّمَة (بالقرب من أو باتجاه مقدمة السفينة أو قمرة القيادة للطائرة) / أنف, مقدمة (الجزء الأمامي لسفينة أو طائرة)\nمثال: ذهب القبطان إلى المقدمة لفحص الأجهزة",
 "fore carriage": "عربة أمامية (عربة صغيرة بعجلات متصلة أسفل الطرف الأمامي لعارضة المحراث)",
 "fore edge": "الحافة الأمامية (جزء الكتاب الذي يواجه الداخل عند وضع الكتاب على الرف؛ الجزء المقابل للكعب)",
 "fore plane": "فارة خشنة, مِسْحَج تمهيدي",
 "fore staysail": "شراع دعامة الصارية الأمامية (شراع الجيب الداخلي (يقع مباشرة أمام الصارية الأمامية) في سفينة كبيرة مربعة الأشرعة)",
 "fore wing": "جناح أمامي (أي من الزوج الأمامي من الأجنحة في حشرة لها أربعة أجنحة)",
 "fore-and-aft": "مِن المُقَدِّمَة إِلَى المُؤَخِّرَة (مُوازٍ لِعارِضَة السَّفينَة أَوْ القارِب)",
 "fore-and-aft rig": "شِرَاع طُولِيّ (تجهيز تكون فيه الأشرعة الرئيسية طولية (من الأمام للخلف))",
 "fore-and-aft sail": "شراع طولي (أي شراع غير مثبت على عارضة ويكون وضعه الطبيعي في اتجاه طولي)",
 "fore-and-aft topsail": "شراع علوي طولي, شراع قمة جافي (شراع طولي مثلثي تمتد قاعدته على الجاف وحافته الأمامية على الصارية العلوية)",
 "fore-and-after": "سفينة ذات أشرعة طولية (سفينة شراعية مجهزة بأشرعة طولية)",
 "fore-topmast": "الصاري الأمامي العلوي (الصاري العلوي الذي يلي الصاري الأمامي مباشرة من الأعلى)",
 "fore-topmast staysail": "شراع دعامة الصارية الأمامية (شراع الجيب الداخلي (يقع مباشرة أمام الصارية الأمامية) في سفينة كبيرة مربعة الأشرعة)",
 "fore-topsail": "شراع القمة الأمامي (شراع القمة الموجود على الصارية الأمامية)",
 "fore-wing": "جناح أمامي (أي من الزوج الأمامي من الأجنحة في حشرة لها أربعة أجنحة)",
 "fore-yard": "عارضة الصاري الأمامي (عارضة على الصاري السفلي لصاري المقدمة مربع التجهيز لسفينة تستخدم لدعم الشراع الأمامي)",
 "forearm": "سَاعِد (عَاوَنَ، أَعَانَ)\nمثال: ساعد زيري ريمة.",
 "forebear": "سلف (شخص تنحدر منه)",
 "foreboding": "توجس, نذير شؤم (فأل غير مواتٍ) / بشيرة سوء, نذير شؤم (شعور بقدوم شر)\nمثال: شعور متزايد بنذير شؤم",
 "forebrain": "دماغ أمامي (الجزء الأمامي من الدماغ؛ الجزء من الدماغ الذي يتطور من الجزء الأمامي للأنبوب العصبي)",
 "forecarriage": "عربة أمامية (عربة صغيرة بعجلات متصلة أسفل الطرف الأمامي لعارضة المحراث)",
 "forecast": "تَنَبَّأَ / تَوَقُّع",
 "forecaster": "عرّاف, متنبئ (شخص يقوم بتنبؤات للمستقبل (عادة على أساس معرفة خاصة))",
 "forecasting": "تنبؤ, توقع (بيان يصدر حول المستقبل)",
 "forecastle": "عنبر البحارة (أماكن معيشة تتكون من بنية فوقية في مقدمة السفينة التجارية حيث يتم إيواء الطاقم)",
 "foreclosure": "حجز الرهن (الإجراءات القانونية التي يبدأها الدائن لاستعادة الضمان لقرض متخلف عن السداد)",
 "forecourt": "ساحة أمامية, فناء أمامي (الفناء الخارجي أو الأمامي لمبنى أو لمجموعة مبانٍ)",
 "foredeck": "السطح الأمامي (السطح الواقع بين الجسر والسطح الأمامي المرتفع)",
 "foredge": "الحافة الأمامية (جزء الكتاب الذي يواجه الداخل عند وضع الكتاب على الرف؛ الجزء المقابل للكعب)",
 "forefather": "جد, سلف (مؤسس العائلة) / جَدّ, سَلَف (شخص من زمن سابق ساهم في التقاليد التي تشترك فيها مجموعة ما)\nمثال: حافظوا على إيمان أجدادنا",
 "forefinger": "سَبَّابَة",
 "forefoot": "قدم أمامية (قدم أمامية لذوات الأربع)",
 "forefront": "طَلِيعَة",
 "foregone": "سَالِف, غَابِر (فِي المَاضِي البَعِيدِ؛ سَابِق)",
 "foregone conclusion": "أَمْر مَحْتُوم, شَيْء مُؤَكَّد (شيء مؤكد الحدوث) / أمر مفروغ منه, نتيجة حتمية (نهاية لا مفر منها)\nمثال: فوزه أمر يقيني",
 "foreground": "مقدمة ((في علم الحاسوب) نافذة لتطبيق نشط) / مقدمة (جزء المشهد القريب من المشاهد)",
 "foreground processing": "معالجة في المقدمة (تنفيذ برنامج يستحوذ على استخدام نظام المعالجة)",
 "foregrounding": "معالجة في المقدمة (تنفيذ برنامج يستحوذ على استخدام نظام المعالجة)",
 "forehand": "ضربة أمامية ((رياضة) رد يتم بحيث تواجه راحة اليد اتجاه الضربة (كما في التنس أو كرة الريشة أو الاسكواش))",
 "forehand drive": "ضربة أمامية مستقيمة ((رياضة) رد مستقيم قوي يتم على الجانب الأمامي (كما في التنس أو كرة الريشة أو الاسكواش))",
 "forehand shot": "ضربة أمامية ((رياضة) رد يتم بحيث تواجه راحة اليد اتجاه الضربة (كما في التنس أو كرة الريشة أو الاسكواش))",
 "forehand stroke": "ضربة أمامية ((رياضة) رد يتم بحيث تواجه راحة اليد اتجاه الضربة (كما في التنس أو كرة الريشة أو الاسكواش))",
 "forehanded": "أمامي, ضربة أمامية ((عن ضربات المضرب) مصنوعة بحيث تواجه راحة اليد اتجاه الضربة) / مُحْتَاط, مُسْتَعِدّ (قد وفّر واستعدّ للمستقبل)",
 "forehead": "جَبْهَة, جَبِين",
 "foreign": "أَجْنَبِيّ / غَرِيب, أَجْنَبِيّ",
 "foreign affairs": "وِزَارَةُ الْخَارِجِيَّة",
 "foreign agent": "عميل أجنبي (جاسوس لدولة أجنبية)",
 "foreign aid": "معونة خارجية (مساعدة (مثل المساعدة الاقتصادية أو العسكرية) تقدمها دولة لأخرى)",
 "foreign bill": "كمبيالة خارجية (كمبيالة مسحوبة في بلد ومستحقة الدفع في بلد آخر)",
 "foreign correspondent": "مراسل أجنبي (صحفي يرسل تقارير إخبارية وتعليقات من دولة أجنبية للنشر أو البث)",
 "foreign country": "بَلَد أَجْنَبِيّ (فَتَرَ طبعه من المحاسن العَقْلِيَّة؛ ضد فَطُنَ؛ قل ذَكَاءه وانْتِبَاهه؛ ضد ذَكا)\nمثال: الصين بلد عظيم.",
 "foreign direct investment": "استثمار أجنبي مباشر (مشروع مشترك بين شركة أجنبية وشركة أمريكية) / استثمار أجنبي مباشر (الاستثمار في الأعمال التجارية من قبل مواطنين أجانب (يتضمن غالباً ملكية الأسهم في العمل التجاري))",
 "foreign draft": "كمبيالة خارجية (كمبيالة مسحوبة في بلد ومستحقة الدفع في بلد آخر)",
 "foreign exchange": "سوق صرف العملات (مكان للبيع والشراء؛ جمع ساق، قال الله تعالى: 《رُدُّوهَا عَلَيَّ فَطَفِقَ مَسْحًا بِالسُّوقِ وَالْأَعْنَاقِ》)\nمثال: ذهبت إلى السوق.",
 "foreign intelligence service": "جهاز الاستخبارات الخارجية (جهاز الاستخبارات الروسي المسؤول عن العمليات الخارجية وجمع المعلومات الاستخبارية وتحليلها وتبادل المعلومات الاستخبارية؛ يتعاون مع الدول الأخرى لمعارضة…)",
 "foreign intelligence surveillance act": "قانون مراقبة الاستخبارات الأجنبية (قانون أقره الكونغرس عام 1978 لوضع إجراءات لطلب إذن قضائي للمراقبة الاستخباراتية الأجنبية)",
 "foreign intelligence surveillance court": "محكمة مراقبة الاستخبارات الأجنبية (محكمة فيدرالية سرية أنشئت عام 1978 بموجب قانون مراقبة الاستخبارات الأجنبية؛ مسؤولة عن التصريح بالتنصت وأشكال المراقبة الإلكترونية الأخرى وتفتيش…)",
 "foreign language": "لُغَة أَجْنَبِيَّة (هِيَ مجموعة من الأصوات التي يصدرها الإنسان على شكل كلمات منظمة بقواعد، ليتواصل به الناس وينقلون به الافكار والمعاني، اللسان؛ يقصد بها أحيانا اللهجة)\nمثال: الأمازيغية لغة.",
 "foreign legion": "فيلق أجنبي (وحدة عسكرية تتكون من متطوعين أجانب يخدمون الدولة)",
 "foreign minister": "وَزِير الْخَارِجِيَّة",
 "foreign mission": "بعثة أجنبية, مفوضية (بعثة دبلوماسية دائمة يرأسها وزير مفوض) / إرسالية, مهمة تبشيرية (منظمة من المبشرين في أرض أجنبية أرسلت للقيام بعمل ديني)",
 "foreign office": "وزارة الخارجية (الإدارة الحكومية المسؤولة عن العلاقات الخارجية (خاصة في بريطانيا))",
 "foreign policy": "سياسة خارجية (بمعنى رعى الغنم وقادها؛ بمعنى قاد الناس وحَكَمَهم باللين والحكمة لا بالغصب والقهر)\nمثال: عاد إلى السياسة.",
 "foreign service": "الخدمة الخارجية, السلك الدبلوماسي (جزء من وزارة الخارجية يوفر الدبلوماسيين لسفارات وقنصليات الولايات المتحدة حول العالم)",
 "foreign terrorist organization": "جماعة إرهابية, منظمة إرهابية (حركة سياسية تستخدم الإرهاب كسلاح لتحقيق أهدافها)",
 "foreign-born": "مَوْلُودٌ فِي الخَارِج ((عَنِ الأَشْخَاصِ) وُلِدَ فِي مَنْطِقَةٍ أَوْ بَلَدٍ غَيْرِ الَّذِي يَعِيشُ فِيهِ)",
 "foreigner": "أَجْنَبِيّ, أَجْنَبِيَّة",
 "foreignness": "أَعْجَمِيَّة, غَرَابَة (صفة كون الشخص غريباً أو غير محلي)\nمثال: غرابة الأجنبي",
 "foreknowledge": "تنبؤ, معرفة مسبقة (معرفة حدث قبل وقوعه)",
 "forelady": "رئيسة المحلفين (امرأة ترأس هيئة المحلفين)",
 "foreland": "أرض أمامية, مقدمة الأرض (الأرض التي تشكل الحافة الأمامية لشيء ما) / رأس صخري, نتوء جبلي (ارتفاع طبيعي (خاصة الصخري الذي يبرز في البحر))",
 "foreleg": "رجل أمامية, ساق أمامية (الطرف الأمامي لذوات الأربع)",
 "forelimb": "طرف أمامي (الطرف الأمامي (أو البنية المماثلة في حيوانات أخرى، مثل الزعنفة أو الجناح))",
 "forelock": "نَاصِيَة (خصلة من شعر عرف الحصان تنمو للأمام بين الأذنين) / خُصْلَة أَمَامِيَّة, نَاصِيَة (خصلة شعر تنمو (أو تتدلى) فوق الجبهة)",
 "foreman": "مُشْرِف, رَئِيس عُمَّال",
 "foremanship": "رئاسة العمال (منصب رئيس العمال)",
 "foremast": "الصاري الأمامي (الصاري الأقرب إلى المقدمة في السفن التي تحتوي على صاريين أو أكثر)",
 "foremilk": "لِبَأ",
 "foremost": "أولاً, في المقام الأول (قبل أي شيء آخر) / الأَمَامِيّ, الأَوَّل (يسبق جميع الآخرين في الموقع المكاني) / أَوَّل, مِن الطِّرَاز الأَوَّل (يتصدر جميع الآخرين في الترتيب) / أَوَّلًا, فِي المُقَدِّمَة (في المقدمة بشكل بارز)\nمثال: أولاً يجب أن نعتبر ثعبان الرباط",
 "foremother": "جدة, سلف أنثى (سلف من الإناث)",
 "forename": "اسم أول, اسم شخصي (الاسم الذي يسبق اللقب)",
 "forenoon": "ضُحًا",
 "forensic": "جِنائِيّ",
 "forensic medicine": "طِبّ شَرْعِيّ (العِلْم؛ دراسة أسباب وتَشْخِيْص ومُعَاْلَجَة الأمراض)\nمثال: اختص في طب القلب.",
 "forensic pathology": "طب شرعي (فرع العلوم الطبية الذي يستخدم المعرفة الطبية لأغراض قانونية)\nمثال: قدم الطب الشرعي الأدلة التي أدانت القاتل",
 "forensic science": "طِبّ شَرْعِيّ (العِلْم؛ دراسة أسباب وتَشْخِيْص ومُعَاْلَجَة الأمراض)\nمثال: اختص في طب القلب.",
 "forensics": "أدلة جنائية, طب شرعي (اختبارات أو تقنيات علمية تستخدم في التحقيق في الجرائم)",
 "foreordained": "مَكْتُوب, مُقَدَّر سَلَفًا (مقرّر أو مرتّب سلفًا بشكل لا يتغيّر)",
 "foreordination": "تعيين مسبق, قدرية ((اللاهوت) التحديد مسبقاً؛ وخاصة المذهب (المرتبط عادة بكالفن) القائل بأن الله قد قضى بكل حدث عبر الأبدية (بما في ذلك الخلاص النهائي للبشرية))",
 "forepart": "مقدمة, واجهة (الجانب الذي يكون في الأمام أو البارز)",
 "forepaw": "كف أمامي (الكف الأمامي؛ مناظر لليد البشرية)",
 "foreperson": "رئيس هيئة المحلفين (العضو الذي يترأس هيئة المحلفين ويتحدث نيابة عنهم)",
 "foreplay": "إثارة, مداعبة (الملاطفة الجنسية المتبادلة قبل الجماع)",
 "forequarter": "الربع الأمامي (النصف الأمامي من جانب الذبيحة)",
 "forerunner": "بشير, سلف (شيء يسبق ويشير إلى اقتراب شيء أو شخص ما) / رَائِد, سَابِق (شخص يسبق غيره أو يعلن عن قدوم آخر) / رَائِد, سَابِق (أي شيء يسبق شيئًا مشابهًا في الوقت)\nمثال: كان علم فراسة الدماغ سابقة لعلم الأعصاب الحديث",
 "foresail": "شراع أمامي (أدنى شراع على الصارية الأمامية لسفينة مربعة الأشرعة)",
 "foresee": "تَوَقَّعَ",
 "foreseeable": "قَابِل لِلاسْتِبَاق, مُتَوَقَّع (يمكن توقعه واستباق حدوثه)",
 "foreshadowing": "تَمْهِيدِيّ, مُنْبِئ بِشَكْل غَامِض (نبوئيّ بشكل غامض وغير واضح) / إرهاص, تلميح مسبق (فعل تقديم مؤشرات غامضة مسبقة؛ التمثيل مسبقاً)",
 "foreshank": "موزة أمامية (قطعة لحم من الجزء العلوي للساق الأمامية)",
 "foreshock": "زلزال نذير, هزة استباقية (هزة تسبق الزلزال)",
 "foreshore": "شاطئ أمامي (جزء الشاطئ الواقع بين علامة المد العالي وعلامة الجزر المنخفض)",
 "foresight": "بصيرة, بعد نظر (حسن التدبير بحكم التخطيط الحكيم للمستقبل) / استشراف, بصيرة (الرؤية المسبقة؛ المعرفة مسبقاً)",
 "foresighted": "بَعِيدُ النَّظَر, مُتَبَصِّر (يُخَطِّط بحكمة للمستقبل)",
 "foresightedness": "بصيرة, بعد نظر (حسن التدبير بحكم التخطيط الحكيم للمستقبل)",
 "foresightful": "بَعِيدُ النَّظَر, مُتَبَصِّر (يُخَطِّط بحكمة للمستقبل)",
 "foresightfulness": "بصيرة, بعد نظر (حسن التدبير بحكم التخطيط الحكيم للمستقبل)",
 "foreskin": "قَلْفَة, غُرْلَة",
 "forest": "غَابَة, غابة (الغَابَةُ: الأَجَمَةُ ذاتُ الشَّجَرِ المُتَكَاثِف؛ لأَنَّها تُغَيِّبُ مَا فِيهَا. أو الأَجَمَةُ الَّتِي طالتْ، وَلَهَا أَطْراف مُرْتَفِعَةٌ باسِقَة؛ الغابةُ أَجَمة القَصَب، قَالَ: وَقَدْ جُعِلَتْ جماعةَ الشَّجَرِ، لأَنه مأْخوذ مِنَ الغَيابةِ)\nمثال: مشينا في الغابة",
 "forest fire": "حريق غابة (حريق غير منضبط في منطقة حرجية)",
 "forest fire fighter": "حارس الغابات, مكافح حرائق الغابات (مسؤول عن إدارة وحماية منطقة من الغابات)",
 "forest goat": "ساولا, ماعز الغابة (مخلوق يشبه البقرة بمعطف لامع كالحصان ورشاقة كالماعز وقرون طويلة كالظبي؛ يوصف بأنه بقرة تعيش حياة الماعز)",
 "forest god": "إله الغابة, ساتير (واحد من فئة آلهة الغابات؛ تابع لباخوس؛ يتماهى مع الفون الروماني)",
 "forest red gum": "صمغ الغابة الأحمر (شجرة طويلة من كوينزلاند ونيو ساوث ويلز وفيكتوريا)",
 "forest tent caterpillar": "يسروع خيمة الغابة (يرقات عثة أمريكية شمالية اجتماعية تغزل شبكة تشبه السجادة بدلاً من الخيمة؛ آكلة أوراق خطيرة للأشجار المتساقطة)",
 "forestage": "خشبة المسرح الأمامية (جزء من مسرح حديث يقع بين الستار والأوركسترا (أي أمام الستار))",
 "forestalling": "استباق, تحاشي (فعل منع شيء ما عن طريق توقعه والتخلص منه بفعالية)",
 "forestay": "دعامة أمامية (دعامة قابلة للتعديل من الصاري الأمامي إلى السطح أو عمود المقدمة؛ تتحكم في انحناء الصاري)",
 "forested": "حُرْجِيّ, مُغَطَّى بِالغَابَات (مُغَطَّى بِالغَابَاتِ)",
 "forester": "حراجي, خبير الغابات (شخص مدرب في علم الحراجة وزراعة الغابات)",
 "forestiera": "فوريستيرا (أي نبات من جنس فوريستيرا)",
 "forestiera neomexicana": "زيتون الصحراء (شجيرة متفرعة شائكة متساقطة الأوراق من جنوب غرب الولايات المتحدة لها عناقيد من الزهور الصفراء البيضاء غير الملحوظة تظهر قبل الأوراق تليها ثمار سوداء…)",
 "forestry": "علم الغابات (علم زراعة ورعاية الغابات وإدارة الأخشاب النامية)",
 "foretaste": "استشعار مسبق, نذير (وعي مبكر ومحدود لشيء لم يحدث بعد)",
 "foretell": "تَكَهَّنَ, تَنَبَّأَ",
 "foretelling": "تنجيم, عرافة (فن أو موهبة النبوءة (أو ادعاء النبوءة) بوسائل خارقة للطبيعة) / تنبؤ, توقع (بيان يصدر حول المستقبل)",
 "forethought": "احتراس, تروي (التعقل في تجنب الضرر أو الخطر) / تدبير, تروٍ (التخطيط أو التآمر قبل التصرف)\nمثال: توخى الحذر عند فتح الباب",
 "forethoughtful": "مُتَأَنٍّ, مُتَرَوٍّ (يُفَكِّر مَلِيًّا في المستقبل)",
 "foretoken": "إرهاص, علامة (حدث يُختبر على أنه يشير إلى أشياء مهمة ستحدث)\nمثال: كان يأمل أن يكون ذلك نذيراً",
 "foretop": "نَاصِيَة (خصلة من شعر عرف الحصان تنمو للأمام بين الأذنين) / منصة الصاري الأمامي (منصة عند رأس الصاري الأمامي)",
 "forever": "إِلَى الْأَبَد (حرف جر يُفيد الغاية الزمنية؛ حرف جر يُفيد الغاية المكانية)\nمثال: تعال إلى منزلي.",
 "forever and a day": "للأبد, لوقت طويل جداً (لوقت طويل جداً أو يبدو بلا نهاية)\nمثال: استغرقت وقتاً طويلاً جداً لكتابة الورقة",
 "forevermore": "إلى الأبد, دائماً وأبداً (في أي وقت في المستقبل؛ مستقبلاً وبشكل دائم)\nمثال: عش حياة خالية من اللوم إلى الأبد",
 "forewarning": "إشعار مسبق, تحذير مسبق (تحذير مبكر حول حدث مستقبلي)",
 "forewing": "جناح أمامي (أي من الزوج الأمامي من الأجنحة في حشرة لها أربعة أجنحة)",
 "forewoman": "رئيسة العمال (امرأة مسؤولة عن مجموعة من العمال) / رئيسة المحلفين (امرأة ترأس هيئة المحلفين)",
 "foreword": "توطئة, ديباجة (مقال تمهيدي قصير يسبق نص كتاب)",
 "foreyard": "عارضة الصاري الأمامي (عارضة على الصاري السفلي لصاري المقدمة مربع التجهيز لسفينة تستخدم لدعم الشراع الأمامي)",
 "forfeit": "فقدان كعقوبة, مصادرة (فعل فقدان أو تسليم شيء ما كعقوبة لخطأ أو فشل في الأداء) / مَسْلُوب, مُصَادَر (تمّت مصادرته كعقوبة) / شرط جزائي, مصادرة (عقوبة لخطأ أو هفوة تتضمن خسارة أو التخلي عن شيء ما) / فقدان الحق, مصادرة (شيء يتم فقده أو التنازل عنه كعقوبة)\nمثال: حدد العقد مصادرات إذا لم يكتمل العمل في الوقت المحدد",
 "forfeited": "مَسْلُوب, مُصَادَر (تمّت مصادرته كعقوبة)",
 "forfeiture": "فقدان كعقوبة, مصادرة (فعل فقدان أو تسليم شيء ما كعقوبة لخطأ أو فشل في الأداء) / شرط جزائي, مصادرة (عقوبة لخطأ أو هفوة تتضمن خسارة أو التخلي عن شيء ما) / فقدان الحق, مصادرة (شيء يتم فقده أو التنازل عنه كعقوبة)\nمثال: حدد العقد مصادرات إذا لم يكتمل العمل في الوقت المحدد",
 "forficate": "شَوْكِيّ, مُتَشَعِّب (يشبه الشوكة؛ منقسم أو منفصل إلى فرعين)",
 "forficula auricularia": "إبرة العجوز, حشرة أذن (مدمرة أحياناً للأبصال المزروعة)",
 "forge": "وَرْشَة حِدَادَة",
 "forged": "مُزَوَّر (أُعيد إنتاجه بطريقة احتيالية)",
 "forger": "مزور, مقلد (شخص يقوم بعمل نسخ غير قانونية) / عامل حدادة (شخص يشغل ورشة حدادة)",
