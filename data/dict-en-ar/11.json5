 "footlights": "أضواء المسرح الأمامية (ضوء مسرح في مقدمة المسرح يضيء الديكور والممثلين)",
 "footling": "تَافِه, زَهِيد ((غير رسمي) صغير ولا أهمّيّة له)",
 "footlocker": "صندوق الجندي, صندوق قدم السرير (صندوق لتخزين الممتلكات الشخصية؛ يوضع عادة عند قدم السرير (كما في الثكنات))",
 "footloose": "حُرّ التَّنَقُّل, طَلِيق (حُرّ فِي الذَّهَاب وَالتَّصَرُّف كَمَا يَشَاء)",
 "footman": "خادم (رجل يعمل كخادم في مؤسسة كبيرة (مثل قصر) لقضاء المهمات والقيام بالأعمال المنزلية)",
 "footmark": "أثر قدم, دعسة (علامة لقدم أو حذاء على سطح)\nمثال: صنعت الشرطة قوالب لآثار الأقدام في الأرض الرخوة خارج النافذة",
 "footnote": "حاشية سفلية (ملاحظة مطبوعة توضع أسفل النص في صفحة مطبوعة)",
 "footpad": "قاطع طريق راجل (قاطع طريق يسرق وهو سائر على قدميه)",
 "footpath": "مَمْشًى, مَسار الْشَاة",
 "footplate": "أرضية القاطرة (المنصة في مقصورة القاطرة التي يقف عليها المهندس لتشغيل عناصر التحكم)",
 "footprint": "أَثَر قَدَم (عَلَامَة؛ بَقِيَّة؛ رَسْم مُتَخَلَّف من شيء ما؛ تأثير؛ انطباع)\nمثال: اختفى فلم ير له أثر.",
