 "full-blood": "كَامِلُ الدَّم, نَقِيُّ السُّلَالَة (من نسب غير مختلط؛ خالص الأصل)",
 "full-blooded": "فَتِيّ, مِلْؤُه الحَيَوِيَّة (مَليء بِالقُوَّة والنَّشاط والحَيَوِيَّة الدَّمَوِيَّة) / كَامِلُ الدَّم, نَقِيُّ السُّلَالَة (من نسب غير مختلط؛ خالص الأصل)",
 "full-blown": "كَامِلُ الأَوْصَاف, مُكْتَمِلُ النُّضْج (يملك أو يُظهر جميع الخصائص اللازمة للاكتمال) / مُكْتَمِلُ الإِزْهَار, نَاضِج (ناضج تماماً؛ في ذروة الإزهار)",
 "full-bodied": "غَنِيّ, مُكْتَنِزُ النَّكْهَة (يَتَّسِمُ بِالثَّرَاءِ وَالامْتِلَاءِ فِي النَّكْهَة)",
 "full-bosomed": "ذَات قَوَام مُنْحَنٍ, مُمْتَلِئَة ((عن جسد المرأة) ذات صدر كبير وانحناءات جذّابة)",
 "full-clad": "مُفَصَّل, مُكْتَمِلُ المَعَالِم (أُعطِي مادّة وتفاصيل كافية؛ اكتمل بنيانه)",
 "full-dress": "كَامِل, وَافٍ (كامل من كلّ جهة ووجه) / بِلِبَاسٍ رَسْمِيّ ((عَنِ المُنَاسَبَاتِ) يَسْتَلْزِمُ ارْتِدَاءَ مَلَابِسَ رَسْمِيَّةٍ) / لِلْمُنَاسَبَاتِ الرَّسْمِيَّة (مُنَاسِبٌ لِلمُنَاسَبَاتِ الرَّسْمِيَّةِ)",
 "full-dress uniform": "زي تشريفات كامل (الزي البحري أو العسكري المحدد باللوائح للارتداء في المناسبات الاحتفالية)",
 "full-face": "مُوَاجِه, نَاظِر لِلأَمَام (ينظر ويتطلع إلى الأمام)",
 "full-fashioned": "مُفَصَّل عَلَى الجَسَد (محاك ليُلائم شكل الجسد)",
 "full-fledged": "كَامِل الأَهْلِيَّة, مُكْتَمِل ((عن الأشخاص) حاز على مكانة أو صفة كاملة) / مُكْتَمِل الرِّيش, نَاضِج ((عن الطائر) بلغ النمو الكامل بريش بالغ مكتمل؛ جاهز للطيران)",
