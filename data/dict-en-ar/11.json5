 "getatable": "فِي المُتَنَاوَل (يُمكن بلوغه أو تحقيقه)",
 "getaway": "فرار, هروب (هروب سريع (خاصة من قبل المجرمين)) / انطلاقة, تسارع (سمة القدرة على التسارع السريع)\nمثال: قام اللصوص بفرار ناجح",
 "gethsemane": "جَثْسَيْمَانِي",
 "gettable": "يُمْكِن الحُصُول عَلَيْه (قابل للحصول عليه واقتنائه)",
 "getting": "اكتساب, حصول (فعل الحصول على شيء ما)\nمثال: حسدت موهبته في الاكتساب",
 "getting even": "رَدّ, مُعَامَلَة بِالمِثْل (عمل جماعي متبادل)\nمثال: في المقابل، أعطيناهم بقدر ما حصلنا عليه",
 "getup": "طقم ملابس, هندام (مجموعة متناسقة من الملابس (مع الإكسسوارات))\nمثال: كان هندامه أنيقاً للغاية",
 "geum alleppicum strictum": "أفينس أصفر (شجيرة منتصبة ذات زهور صفراء عميقة؛ أوروبا وآسيا وأمريكا الشمالية)",
 "geum canadense": "أفينس أبيض (أفينس أبيض الزهور من أمريكا الشمالية)",
 "geum macrophyllum": "أفينس أصفر كبير الأوراق (نبات زغبي أصفر الزهور من شرق آسيا وأمريكا الشمالية)",
 "geum rivale": "أفينس أرجواني, أفينس مائي (نبات معمر منتصب من المنطقة المعتدلة الشمالية له أوراق ريشية وعدد قليل من الزهور المتدلية بكأس بني أرجواني وبتلات برتقالية ووردية)",
 "geum strictum": "أفينس أصفر (شجيرة منتصبة ذات زهور صفراء عميقة؛ أوروبا وآسيا وأمريكا الشمالية)",
 "geum triflorum": "أفينس أرجواني, دخان البراري (نبات معمر من أمريكا الشمالية بأوراق ريشية قاعدية زغبية وزهور أرجوانية وثمار ذات ريش)",
 "geum urbanum": "أفينس الغابة, عشبة بينيت (نبات أوراسي زغبي بزهور صفراء صغيرة وجذر قابض كان يستخدم طبياً سابقاً)",
 "geum virginianum": "أفينس أبيض, أفينس فرجينيا (أفينس من فرجينيا له زهور شاحبة أو صفراء مخضرة)",
 "gewgaw": "حلي رخيصة, حلية مبهرجة (مجوهرات رخيصة ومبهرجة أو زينة على الملابس)",
 "geyser": "سَخَّان (شبه إبْرِيق من معدن كالنحاس أو الصلب أو غيره يوضع على النار مباشرة ويستخدم لتسخين الماء. قد يقول البعض سَخَّانَة؛ آله تسخن الماء تعمل على الكهرباء أو الغاز أو غيره من الوقود. استخدام حديث)",
 "gflops": "غيغا فلوب (وحدة قياس لسرعة الحساب في الحاسوب تساوي مليار عملية نقطة عائمة في الثانية)",
 "ghana": "غَانَا",
 "ghanaian": "غاني (من أو متعلق أو مميز لغانا أو شعبها أو لغتها) / غانِيّ (مواطن أو ساكن في غانا)\nمثال: إنتاج الكاكاو الغاني",
 "ghanaian monetary unit": "وحدة نقدية غانية (الوحدة النقدية لغانا)",
 "ghanese": "غاني (من أو متعلق أو مميز لغانا أو شعبها أو لغتها)\nمثال: إنتاج الكاكاو الغاني",
 "ghani": "غني",
 "ghanian": "غاني (من أو متعلق أو مميز لغانا أو شعبها أو لغتها) / غانِيّ (مواطن أو ساكن في غانا)\nمثال: إنتاج الكاكاو الغاني",
 "ghanian monetary unit": "وحدة نقدية غانية (الوحدة النقدية لغانا)",
 "gharial": "جَرَال, جَافِيال",
 "gharry": "عربة غاري (عربة تجرها الخيول في الهند)",
 "ghastliness": "بَشَاعَة, شَنَاعَة (صفة كون الشيء مروعاً أو بشعاً)",
 "ghastly": "بَشِع, مَكَابِرِيّ (منفّر بشكل صادم؛ يثير الرعب والاشمئزاز) / قَبْرِيّ, مَشْؤُوم (يوحي بشكل مروّع بالموت أو الأموات)",
 "ghat": "غات, مدرج نهري (درج في الهند يؤدي إلى رصيف على الماء)",
 "ghatti": "صمغ الغاتي (صمغ هندي من شجرة الدهاوا؛ يستخدم كبديل للصمغ العربي)",
 "ghatti gum": "صمغ الغاتي (صمغ هندي من شجرة الدهاوا؛ يستخدم كبديل للصمغ العربي)",
 "ghawa syndrome": "ظاهِرة قْهَوة (ظَاهِرَة: اسم؛ تطلق على شيء يَظْهر أي يبين. \"ظَاهِرة قَوس قُزَح بعد المَطَر\"؛ ظَاهِرَة: اسم؛ الإبل أو الغنم ترِد نصف النهار أي ظُهراً. استعمال قديم)\nمثال: علينا أن نكشف تستر الحكومة بشأن ظاهرة الأجسام الطائرة المجهولة.",
 "ghazal": "غَزَل (غَزَلَ بمعنى حاك أو نسج، سواء في الحياكة أو الكلام. ويمكن أن يكون مرتبطًا بـ الغرام أو الحديث الغزلي؛ مُغازَلَةُ النِّساءِ: مُحادَثَتُهُنَّ، والاسمُ: الغَزَلُ والمَغْزَلُ)",
 "ghazwa": "غَزْوَة",
 "ghazwa-e-hind": "غَزْوَة الْهِنْد",
 "ghb": "جاما هيدروكسي بيوتيريت (مخدر نوادي يتوفر في شكل سائل أو مسحوق يؤخذ عن طريق الفم (غالباً مع الكحول)؛ يستخدم لشل حركة الأفراد لارتكاب الاعتداء الجنسي والاغتصاب)",
 "ghedda wax": "شمع غيدا (شمع من النحل الهندي والأفريقي)",
 "ghee": "سَمْن حَيَوَانِيّ (الدُهُون التي تؤكل، وتشمل الزُبْد والقِشْطَة وما يستخرج من الحَيْوَان والنبات. قيل السمن من الحيوان والدهن من النبات وقيل السمن ما يؤكل والدهن ما لا…)",
 "gheg": "لهجة الغيغ (لهجة الألبانية التي يتم التحدث بها في شمال ألبانيا ويوغوسلافيا)",
 "gheg dialect": "لهجة الغيغ (لهجة الألبانية التي يتم التحدث بها في شمال ألبانيا ويوغوسلافيا)",
 "ghent": "جِينْت, غِنْت",
 "gherkin": "خيار صغير, خيار مخلل (خيار شائك صغير) / خيار مخلل صغير (أي من الخيار الصغير المتنوع المخلل كاملاً)",
 "ghetto": "غِيتُو",
 "ghetto blaster": "مسجل محمول كبير (جهاز ستيريو محمول)",
 "ghibelline": "غيبلين",
 "ghillie": "غيلي (حذاء بدون لسان وذو أربطة مزخرفة أعلى مشط القدم)",
 "ghosn": "غُصْن",
 "ghost": "شَبَح, خَيَال",
 "ghost dance": "رقصة الشبح (رقصة دينية للأمريكيين الأصليين طلباً للتواصل مع الموتى)",
 "ghost gum": "صمغ الثلج, صمغ الشبح (شجرة صغيرة إلى متوسطة الحجم من أستراليا وتسمانيا ذات لحاء أبيض ناعم إلى رمادي فاتح يتساقط في بقع أو شرائط)",
 "ghost town": "مَدِينَة أَشْبَاح, مَدِينَة الْأَشْبَاح",
 "ghost weed": "ثلج على الجبل, فربيون مهدب (فربيون سنوي في غرب الولايات المتحدة ذو عناقيد زهور بيضاء القنابات وحليب سام جداً)",
 "ghost word": "كلمة وهمية (صيغة كلمة دخلت اللغة من خلال استدامة خطأ ما)",
 "ghostfish": "رايموث, سمكة الشبح (سمكة قاع أطلسية تشبه الثعبان ولها فم كبير عمودي تقريباً)",
 "ghostlike": "شَبَحِيّ, طَيْفِيّ (يشبه الأشباح أو يتسم بخصائصها)",
 "ghostliness": "غُمُوض مُخِيف, وَحْشَة (الغرابة بحكم كون الشيء غامضاً ومثيراً للخوف)",
 "ghostly": "شَبَحِيّ, طَيْفِيّ (يشبه الأشباح أو يتسم بخصائصها)",
 "ghostwriter": "كاتب خفي, كاتب شبح (كاتب ينسب فضل التأليف لشخص آخر)",
 "ghoti": "غُوتِيّ",
 "ghoul": "غُول",
 "ghoulish": "سَوْدَاوِيّ, مَرَضِيّ (يوحي برعب الموت والتحلّل)",
 "ghq": "المقر العام, مركز القيادة (مقر عسكري يسيطر منه القائد العسكري وينظم القوات)",
 "ghrelin": "جريلين",
 "ghrf": "عامل مطلق لهرمون النمو (عامل مطلق يسرع إفراز هرمون النمو من الجسم النخامي الأمامي)",
 "ghusl": "غُسْل (معنى غَسَّلَ، بِالتَّشْدِيدِ، اغْتَسَلَ بعدَ الجِمَاع، ثمّ اغْتسلَ للجُمُعَة،التَّغْسيل: المُبَالَغةُ فِي غَسْلِ الأعْضاءِ؛ غسّل الأعضاء:بالغ في غسلها أو تنظيفها،غسّل الميّت:غسل جسمه بالماء،طَهَّرَه ونقّاه)\nمثال: سأذهب لغسل يدي.",
 "ghz": "جِيجَاهَرْتز (مليار دورة في الثانية)",
 "gi": "معدي معوي (من أو يتعلق بالمعدة والأمعاء) / مؤشر جغرافي ((قانون) اسم أو علامة تستخدم على منتجات معينة وتتوافق مع موقع جغرافي أو منشأ محدد) / جيلبرت (وحدة للقوة الدافعة المغناطيسية تساوي 0.7958 أمبير-لفة)\nمثال: اضطراب معدي معوي",
 "gi hormones": "هرمون معدي معوي (هرمونات تؤثر على وظائف الجهاز الهضمي)",
 "gi series": "سلسلة الجهاز الهضمي (اختبارات تشخيصية للقناة الهضمية؛ تتضمن عادة إدخال وسط تباين (مثل كبريتات الباريوم) وأخذ صورة بالأشعة السينية)",
 "gi tract": "جهاز هضمي, قناة هضمية (ممر أنبوبي من الغشاء المخاطي والعضلات يمتد حوالي 8.3 متر من الفم إلى الشرج؛ وظيفته الهضم والإخراج)",
 "gianduja": "جَانْدُويَا",
 "giant": "عِمْلَاق",
 "giant anteater": "آكل النمل العملاق (آكل نمل كبير أشعث الشعر وعديم الأسنان ذو لسان طويل ومخالب قوية؛ من أمريكا الجنوبية)",
 "giant armadillo": "مدرع عملاق (يبلغ طوله حوالي ثلاثة أقدام باستثناء الذيل)",
 "giant bamboo": "خيزران عملاق (خيزران استوائي ضخم من جنوب شرق آسيا بسيقان مجوفة قاسية تشبه جذوع الأشجار)",
 "giant buttercup": "حوذان عملاق (نبات معمر مذهل موطنه المروج الجبلية الرطبة في بيرو؛ كان يُصنف سابقاً ضمن جنس الحوذان)",
 "giant cane": "أرونديناريا عملاقة, قصب عملاق (عشب طويل من جنوب الولايات المتحدة ينمو في غابات كثيفة)",
 "giant chinkapin": "شنكابين ذهبي, شنكابين عملاق (شجرة زينة صغيرة دائمة الخضرة من ساحل المحيط الهادئ أوراقها الخضراء الصفراء اللامعة صفراء من الأسفل؛ تحمل مكسرات صالحة للأكل)",
 "giant clam": "محار عملاق (محار كبير يسكن الشعاب المرجانية في جنوب المحيط الهادئ ويزن ما يصل إلى 500 رطل)",
 "giant cockroach": "صرصور عملاق (صراصير أمريكية استوائية كبيرة)",
 "giant conch": "كونش عملاق (نوع كبير من الكونش)",
 "giant coreopsis": "بذرة القراد العملاقة, كوريوبسيس عملاق (شجيرة كبيرة تشبه الشجرة ذات أوراق ريشية وعناقيد من رؤوس الزهور الصفراء الكبيرة؛ ساحل جنوب كاليفورنيا)",
 "giant crab": "سلطعون العنكبوت الياباني, سلطعون عملاق (سلطعون ياباني كبير جداً يعيش في المياه العميقة)",
 "giant eland": "إيلاند عملاق (إيلاند كبير مخطط داكن من غرب أفريقيا الاستوائية)",
 "giant fennel": "كَلْخ كَبِير, كلخ",
 "giant fern": "أنجيوبتريس, سرخس عملاق (نوع متغير للغاية من السراخس البدائية الكبيرة جداً في المناطق الاستوائية بالمحيط الهادئ ذات الأمطار الغزيرة)",
 "giant fir": "شوح عملاق, شوح كبير (شوح شاهق من ساحل المحيط الهادئ لشمال غرب أمريكا له فروع منحنية طويلة وأوراق خضراء عميقة)",
 "giant foxtail": "ذيل الثعلب العملاق (نوعان من ذيل الثعلب الحولي الخشن وهما أعشاب ضارة متوطنة في الولايات المتحدة)",
 "giant fulmar": "نوء عملاق (طائر نوء بني كبير يوجد بشكل رئيسي في بحار القطب الجنوبي)",
 "giant garlic": "ثوم عملاق, كراث رملي (كراث أوروبي يزرع ويستخدم مثل الكراث)",
 "giant granadilla": "غرانديلا عملاقة (زهرة العاطفة الاستوائية الأمريكية التي تنتج ثمرة الغرانديلا الكبيرة)",
 "giant helleborine": "سحلب الجدول (سحلب ينمو على طول الجداول أو البرك في غرب أمريكا الشمالية له سيقان ورقية وزهرة واحدة بنية مخضرة ووردية في إبط كل ورقة علوية)",
 "giant hives": "وذمة وعائية (مناطق محددة كبيرة متكررة من وذمة تحت الجلد؛ تبدأ فجأة وتختفي خلال 24 ساعة؛ تظهر بشكل رئيسي عند الشابات، غالباً كرد فعل تحسسي للطعام أو الأدوية)",
 "giant hornet": "دبور عملاق (دبور أوروبي أُدخل إلى الولايات المتحدة)",
 "giant hyssop": "أغاستاش, زوفا عملاقة",
 "giant kangaroo": "كنغر رمادي شرقي, كنغر عملاق (كنغر أسترالي بني رمادي كبير جداً كان وفيراً سابقاً في المناطق المشجرة المفتوحة)",
 "giant lizard": "تنين كومودو (أكبر سحلية في العالم (10 أقدام)؛ توجد في الجزر الإندونيسية)",
 "giant moa": "موا عملاق (أكبر أنواع الموا؛ يبلغ ارتفاعه حوالي 12 قدماً)",
 "giant northwest shipworm": "دودة السفن العملاقة (دودة سفن عملاقة من ساحل المحيط الهادئ لأمريكا الشمالية)",
 "giant panda": "باندا عملاق, دب الباندا (ثديي عشبي كبير أبيض وأسود يعيش في غابات الخيزران في الصين والتبت؛ يُعتبر في بعض التصنيفات عضواً في فصيلة الدببة أو فصيلة منفصلة)",
 "giant petrel": "نوء عملاق (طائر نوء بني كبير يوجد بشكل رئيسي في بحار القطب الجنوبي)",
 "giant pigfish": "سمكة الخنزير العملاقة (توجد حول الحاجز المرجاني العظيم)",
 "giant potato creeper": "كرمة البطاطس العملاقة (كرمة من كوستاريكا مسلحة بشكل متناثر بأشواك تشبه الخطاف ولها أزهار زرقاء ليلكية كبيرة)",
 "giant puffball": "فطر نفاث عملاق (فطر نفاث ضخم صالح للأكل يصل قطره إلى 2 قدم ووزنه 25 رطلاً)",
 "giant red paintbrush": "فرشاة الرسم الحمراء العملاقة, كاستيليجا مينياتا (زهرة برية في غرب أمريكا الشمالية لها عناقيد خشنة من الزهور القرمزية)",
 "giant reed": "غاب عملاق, قيصوب (أعشاب معمرة جذمورية كبيرة توجد بجانب الأنهار وفي الخنادق لها سيقان مفصلية وعناقيد ريشية رمادية بيضاء كبيرة)",
 "giant roundworm": "إِسْكَارِس",
 "giant ryegrass": "عشبة الجاودار العملاقة (عشبة معمرة قوية في غرب أمريكا الشمالية)",
 "giant salamander": "سمندل عملاق (سمندل آسيوي كبير (يصل إلى أكثر من ثلاثة أقدام) صالح للأكل)",
 "giant scallop": "إسقلوب البحر (إسقلوب كبير يسكن المياه العميقة لساحل المحيط الأطلسي لأمريكا الشمالية)",
 "giant schnauzer": "شناوزر عملاق (شناوزر كبير)",
 "giant scrambling fern": "سرخس متسلق عملاق (سرخس متسلق كبير يشكل بقعاً كبيرة يصل ارتفاعها إلى 18 قدماً؛ منطقة المحيط الهادئ والصين)",
 "giant sequoia": "سيكويا عملاقة (شجرة دائمة الخضرة شاهقة الارتفاع في الطرف الجنوبي من التلال الغربية لسييرا نيفادا في كاليفورنيا؛ أكبر كائن حي)",
 "giant silkworm": "دودة قز عملاقة (يرقة عثة ساتورنيد؛ تغزل كمية كبيرة من الحرير القوي في بناء شرنقتها)",
 "giant silkworm moth": "عثة دودة القز العملاقة (أي عثة دودة قز من فصيلة ساتورنيداي)",
 "giant squid": "حبار عملاق (أكبر رخوي معروف عنه ولكن لم يُرَ قط (يصل طوله إلى 60 قدماً))",
 "giant star": "عِمْلَاق, نَجْم عِمْلَاق (نجم شديد اللمعان ذو قطر كبير وكثافة منخفضة (نسبة للشمس))",
 "giant star grass": "عشب النجمة العملاق (عشب معمر يبلغ ارتفاع سيقانه 3 إلى 4 أقدام؛ يستخدم خاصة في أفريقيا والهند للمراعي والقش)",
 "giant stock bean": "فاصوليا جاك, فاصوليا سيفية (نبات حولي كثيف شبه قائم في أمريكا الجنوبية الاستوائية يحمل قروناً طويلة ببذور بيضاء يزرع خاصة للعلف)",
 "giant sunflower": "بطاطس هندية, عباد شمس عملاق (نبات معمر أمريكي طويل جداً في وسط وشرق الولايات المتحدة إلى كندا ذو جذور درنية صالحة للأكل)",
 "giant taro": "ألوكاسيا, قلقاس عملاق (نبات دائم الخضرة كبير بأوراق منتصبة أو منتشرة كبيرة جداً؛ يزرع على نطاق واسع في المناطق الاستوائية لجذموره وبراعمه الصالحة للأكل؛ يستخدم في المناطق…)",
 "giant timber bamboo": "خيزران الخشب العملاق, ماداكي (خيزران كبير له سيقان سميكة الجدران؛ موطنه الصين وربما اليابان؛ يُزرع على نطاق واسع في أماكن أخرى)",
 "giant tortoise": "سلحفاة عملاقة (سلاحف كبيرة جداً من جزر غالاباغوس وسيشيل)",
 "giant water bug": "بق الماء العملاق (بق مائي كبير ذو أجزاء فم ثاقبة وماصة؛ يتغذى على الأسماك الصغيرة)",
 "giant willowherb": "عشبة الصفصاف العملاقة, عشبة النار (نبات معمر طويل من أمريكا الشمالية ذو جذور زاحفة وأوراق ضيقة وسنابل من الزهور الوردية الأرجوانية توجد بكثرة كبيرة في المناطق المحترقة أو المناطق التي…)",
 "giantess": "عملاقة (أنثى عملاقة)",
 "giantism": "داء العملقة, عملقة (كبر مفرط في القامة) / عملقة, فرط النمو (حجم مفرط؛ ناتج عادة عن إفراز مفرط لهرمون النمو من الغدة النخامية)",
 "giaour": "كَافِر",
 "giardia": "جيارديا (سبب مشتبه به للإسهال لدى البشر)",
 "giardiasis": "داء الجيارديات (عدوى الأمعاء بطفيليات توجد في الطعام والماء الملوث)",
 "gib": "قط مخصي (قط ذكر مخصي) / غيبي بايت, غيغابايت (وحدة معلومات تساوي 1024 ميبي بايت أو 2 أس 30 بايت)",
 "gibber": "بَرْبَرَة, رَطَانَة (حديث غير مفهوم)",
 "gibberellic acid": "حمض الجبريليك (حمض بلوري مرتبط بالجبريلين)",
 "gibberellin": "جبريلين (هرمون نباتي معزول من فطر؛ يستخدم في تعزيز نمو النبات)",
 "gibberish": "رَطَانَة / ثَرْثَرَة, بَرْبَرَة",
 "gibbet": "مشنقة (مصطلحات بديلة للمشنقة)",
 "gibbon": "غِيبُون, جِبَّوْن",
 "gibbose": "أَحْدَب, مُحَدْوَدِب ((عَنِ القَمَرِ) أَكْثَرُ مِنْ نِصْفِهِ مُضِيء)",
 "gibbosity": "انتفاخ, بروز (شيء ينتفخ للخارج أو يبرز عن محيطه)\nمثال: أحدث المسدس في جيبه انتفاخاً واضحاً",
 "gibbous": "أَحْدَب, مُحَدْوَدِب ((عَنِ القَمَرِ) أَكْثَرُ مِنْ نِصْفِهِ مُضِيء) / أَحْدَب, مُقَوَّسُ الظَّهْر (يُعَانِي مِنْ تَقَوُّسٍ غَيْرِ طَبِيعِيٍّ فِي العَمُودِ الفِقَرِيّ (حُدَاب))",
