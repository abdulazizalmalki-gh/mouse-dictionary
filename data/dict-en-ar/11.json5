 "gadus merlangus": "بياض",
 "gadus morhua": "قد أطلسي (واحدة من أهم الأسماك التجارية في العالم)",
 "gadwall": "بط سماري ((بَطَّ) الْقُرْحَةَ شَقَّهَا)\nمثال: ذهب لاصطياد البط.",
 "gael": "غالي (كلتي يتحدث الغالية في أيرلندا أو اسكتلندا أو جزيرة مان)",
 "gaelic": "سلتي, كلتي (يتعلق بالكلت (السلتيين) أو يميزهم) / الجودية, الغيلية (أي من عدة لغات ذات صلة بالكلت في أيرلندا واسكتلندا)",
 "gaelic language": "الجودية, الغيلية (أي من عدة لغات ذات صلة بالكلت في أيرلندا واسكتلندا)",
 "gaelic-speaking": "نَاطِقٌ بِالغِيلِيَّة (قادر على التواصل باللغة الغيلية)",
 "gaeta": "غَيْطَة",
 "gaff": "خُطَّاف سمك كبير (خطاف حديدي بمقبض؛ يستخدم لإخراج الأسماك الكبيرة من الماء) / الخاطف, عارضة الشراع (عارضة ترتفع في المؤخرة من صاري لدعم رأس شراع أمامي وخلفي رباعي الأضلاع) / مهماز (مسمار معدني حاد أو مهماز يُربط في ساق ديك المصارعة)",
 "gaff topsail": "شراع علوي طولي, شراع قمة جافي (شراع طولي مثلثي تمتد قاعدته على الجاف وحافته الأمامية على الصارية العلوية)",
 "gaff-headed sail": "شراع جاف (شراع طولي رباعي الأضلاع معلق من جاف (عمود مائل))",
 "gaffe": "زلة اجتماعية, فو با (فعل محرج اجتماعياً أو غير لبق)",
 "gaffer": "رئيس العمال, ملاحظ (شخص يمارس السيطرة على العمال) / جافر, رئيس الكهربائيين (كهربائي مسؤول عن الإضاءة في موقع تصوير فيلم أو تلفزيون) / عجوز, مخضرم\nمثال: إذا كنت تريد المغادرة مبكراً فعليك أن تطلب من رئيس العمال",
 "gaffsail": "شراع جاف (شراع طولي رباعي الأضلاع معلق من جاف (عمود مائل))",
 "gafsa": "قَفْصَة, ڨَفْصَة",
 "gag": "كمامة (قيد يوضع في فم الشخص لمنعه من التحدث أو الصراخ) / طُرْفَة, مَزْحَة (حكاية فكاهية أو ملاحظة تهدف إلى إثارة الضحك)\nمثال: روى نكتة مضحكة جداً",
 "gag law": "قانون تكميم الأفواه (أي قانون يحد من حرية الصحافة) / إِغْلَاق بَاب النِّقَاش, قَفْل بَاب الْمُرَافَعَات (قاعدة للحد من النقاش أو إنهائه في هيئة تداولية)",
 "gag line": "بيت القصيد, خاتمة النكتة (مغزى نكتة أو قصة فكاهية)",
 "gag order": "أمر حظر النشر (أمر محكمة يقيد المعلومات أو التعليقات من قبل المشاركين في دعوى قضائية)\nمثال: فرض أمر حظر النشر على أعضاء الصحافة ينتهك التعديل الأول للدستور",
 "gag reflex": "منعكس البلعوم, منعكس التقيؤ (منعكس طبيعي يتكون من التهوع؛ قد ينتج عن لمس الحنك الرخو في الجزء الخلفي من الفم)",
 "gag rule": "إِغْلَاق بَاب النِّقَاش, قَفْل بَاب الْمُرَافَعَات (قاعدة للحد من النقاش أو إنهائه في هيئة تداولية)",
 "gaga": "مَهْوُوس, مُوَلَّه (شديد الحماسة أو الانشغال بشيء ما) / خَرِف, هَرِم (ضعيف عقلياً أو جسدياً بسبب الشيخوخة)",
 "gagarin": "جَاجَارِين / غَاغَارِين",
 "gagauzia": "غَاغَاوْزِيَا",
 "gage": "مقياس (أداة قياس لقياس وتوضيح كمية مثل سمك السلك أو كمية المطر وما إلى ذلك) / بانجو, عشب (أسماء دارجة للماريجوانا)",
 "gaggle": "سرب وَزّ (سرب من الوَزّ)",
 "gagman": "كاتب نكات (رجل يكتب مواد كوميدية للمؤدين العامين) / كوميدي (كوميدي ذكر يستخدم النكات والمواقف المضحكة)",
 "gagster": "كاتب نكات, مؤلف نكات (شخص يكتب مواد كوميدية لفناني الأداء العام)",
 "gagwoman": "ممثلة هزلية (كوميدية أنثى تستخدم النكات والمواقف المضحكة) / كاتبة نكات (امرأة تكتب مواد كوميدية للمؤدين العامين)",
 "gagwriter": "كاتب نكات, مؤلف نكات (شخص يكتب مواد كوميدية لفناني الأداء العام)",
 "gai choi": "خردل صيني, خردل هندي (خردل آسيوي يستخدم كعشب وعائي)",
 "gaia": "غَايَا",
 "gaiety": "عبث, مرح (شعور احتفالي بهيج) / حبور, مرح (شعور بالمرح)",
 "gaillardia": "جيلاردية, عنبر كشمير (أي نبات من غرب أمريكا من جنس جيلاردية له أوراق مشعرة وأزهار طويلة العنق بألوان زاهية حارة من الأصفر الذهبي والنحاسي إلى العنابي الغني)",
 "gaillardia pulchella": "زهرة البطانية, عجلة النار (نبات حولي من وسط الولايات المتحدة له رؤوس زهور صفراء مبهرجة طويلة الساق معلمة باللون القرمزي أو الأرجواني في المركز)",
 "gaily": "بمرح (بطريقة مرحة)\nمثال: كانت الفضائح مسلية بمرح",
 "gain": "كَسَبَ",
 "gainer": "غطسة عكسية (غطسة يرمي فيها الغطاس قدميه للأمام لإكمال شقلبة خلفية كاملة ويدخل الماء بقدميه أولاً ووجهه بعيداً عن لوح الغطس) / رَابِح, كَاسِب (شخص يربح (يكتسب ميزة أو يجني أرباحاً)) / مُكْتَسِب لِلْوَزْن (شخص يزداد وزنه)\nمثال: كانت هي الرابحة بوضوح في ذلك التبادل",
 "gainful": "مُجْزٍ, مُدِرّ لِلرِّبْح (يُدرّ ربحًا معقولاً)",
 "gainfully": "بشكل مجدٍ, بشكل مربح (بطريقة تدر ربحاً أو فائدة)\nمثال: هل تعمل بشكل مجدٍ الآن؟",
 "gainfulness": "جَدْوَى, رِبْحِيَّة (صفة تحقيق مكسب أو فائدة أو ربح)",
 "gaining control": "أسر, سيطرة (فعل نزع ملكية المالك بالقوة)",
 "gainlessly": "بلا جدوى, دون نفع (بدون مكسب أو ربح)",
 "gainly": "ظَرِيف, لَبِق (رشيق وممتع المظهر)",
 "gait": "مشية (طريقة مشي الشخص) / مشية الحصان (طريقة تحرك الحصان) / سُرْعَة المَشْي, مِشْيَة (معدل الحركة (خاصة المشي أو الجري))",
 "gaiter": "لفافة ساق, واقي ساق (غطاء للساق مصنوع من القماش أو الجلد يمتد من الركبة إلى الكاحل) / جرموق (حذاء يغطي الكاحل بجوانب مرنة) / سبات, غطاء حذاء (غطاء قماشي يغطي مشط القدم والكاحلين)",
 "gal": "فتاة (مصطلح لفتاة (أو امرأة)) / غالون (وحدة سائلة أمريكية تساوي 4 كوارتات أو 3.785 لتراً) / غال (وحدة لتسارع الجاذبية تساوي سنتيمترًا واحدًا لكل ثانية لكل ثانية (سميت باسم غاليليو))",
 "gala": "احتفال بهيج, حفل (احتفال مبهج أو مناسبة اجتماعية كبيرة)",
 "gala affair": "احتفال بهيج, حفل (احتفال مبهج أو مناسبة اجتماعية كبيرة)",
 "galactagogue": "مدر للحليب, مدر لللبن (عامل يحفز إفراز الحليب)",
 "galactic": "فَلَكِيّ, هَائِل (كبير بشكل لا يُتصوَّر) / مجري (متعلق بمجرة (خاصة مجرتنا درب التبانة))\nمثال: المستوى المجري",
 "galactocele": "قيلة لبنية (ورم كيسي يحتوي على حليب أو مادة لبنية (خاصة في الغدد الثديية))",
 "galactocentric": "مَجَرِّيّ الْمَرْكَز",
 "galactose": "جالاكتوز (سكر بسيط يوجد في اللاكتوز)",
 "galactosemia": "غالاكتوسيميا, وجود الغالاكتوز في الدم (مرض وراثي (متنحي) يكون فيه الإنزيم اللازم لاستقلاب الجالاكتوز ناقصاً أو غائباً؛ يتطور عادة بعد الولادة بفترة وجيزة)",
 "galactosis": "إدرار الحليب (إفراز الحليب)",
 "galago": "جلاجو, طفل الأدغال (ليمور أفريقي ليلي رشيق طويل الذيل ذو فرو صوفي كثيف وعيون وآذان كبيرة)",
 "galangal": "خَوْلَنْجَان",
 "galantine": "جالانتين (دواجن منزوعة العظم محشوة ثم مطبوخة ومغطاة بالهلام؛ تُقدم باردة)",
 "galanty show": "خيال الظل, مسرح الظل (دراما يتم تنفيذها عن طريق إلقاء الظلال على الحائط)",
 "galatian": "غلاطي (مواطن أو ساكن في غلاطية في آسيا الصغرى (خاصة من الشعوب التي يُعتقد أنها كانت من الغال وغزت غلاطية في القرن الثالث قبل الميلاد))",
 "galatians": "الرِّسَالَة إِلَى أَهْلِ غَلَاطِيَّة",
 "galax": "غالاكس (عشب معمر دائم الخضرة معنقد له سنابل من الزهور البيضاء الصغيرة وأوراق لامعة خضراء مستديرة إلى قلبية الشكل تتحول إلى اللون النحاسي أو العنابي أو…)",
 "galax urceolata": "غالاكس (عشب معمر دائم الخضرة معنقد له سنابل من الزهور البيضاء الصغيرة وأوراق لامعة خضراء مستديرة إلى قلبية الشكل تتحول إلى اللون النحاسي أو العنابي أو…)",
 "galaxy": "مَجَرَّة (نجوم كثيرة لا تدرك بمجرد البصر، وعندما ينتشر ضوؤها فيُرى كأنه بقعة بيضاء (أي: مصادر ضوء كثيرة بحيث يبدو ضوئها كوهج بدلاً من أن يَبدو كل نجم واضحٍ…؛ باب السماء، وهي البياض الذي يَعبر السماء ويَقع بين النّسرَين (المقصود هنا هو مجرة دَرْب التّبانَة…)\nمثال: أنا بطل المجرة.",
 "galbanum": "جلبان, قنة (راتنج صمغي عطري مر يشبه الحلتيت)",
 "galbulus": "مخروط السرو, مخروط كروي (المخروط المنتج للبذور لشجرة السرو)",
 "gale": "ريح عاتية, عاصفة (رياح قوية تتحرك بسرعة 45-90 عقدة؛ قوة 7 إلى 10 على مقياس بوفورت)",
 "galea": "خوذة (عضو على شكل خوذة؛ عادة ما يكون بتلة مقببة ومتضخمة كما في البيش)",
 "galega officinalis": "سذاب الماعز, مدرة مخزنية (نبات أوروبي معمر طويل وكثيف يزرع لأوراقه الريشية وسنابله النحيلة من الزهور الزرقاء؛ يستخدم أحياناً طبياً)",
 "galen": "جَالِينُوس",
 "galena": "غَالِينَا",
 "galeocerdo cuvieri": "قرش النمر, قرش ببري (قرش كبير خطير يعيش في المياه الدافئة ذو جسم مخطط أو مرقط)",
 "galeopsis tetrahit": "غاليوبسيس, قراص القنب (نبات أوراسي خشن ذو شعيرات بأزهار بيضاء أو حمراء وأوراق تشبه أوراق القراص؛ شائع كعشب ضار في الولايات المتحدة)",
 "galeorhinus zyopterus": "قرش حساء الزعانف (قرش في المحيط الهادئ يُقدر لزعانفه (التي يستخدمها الصينيون في الحساء) وكبده (الغني بفيتامين أ))",
 "galere": "زمرة الأشرار (زمرة من الأشخاص غير المرغوب فيهم)",
 "galicia": "جِلِّيقِيَّة",
 "galician": "اللغة الغاليسية (لغة يتم التحدث بها في غاليسيا، وهي منطقة حكم ذاتي في إسبانيا)",
 "galician language": "اللغة الغاليسية (لغة يتم التحدث بها في غاليسيا، وهي منطقة حكم ذاتي في إسبانيا)",
 "galictis vittatus": "غريسون (لاحم من أمريكا الوسطى والجنوبية يشبه ابن عرس بظهر أبيض رمادي وأجزاء سفلية داكنة)",
 "galiella rufa": "جاليلا روفا (الجسم الثمري الكأسي الشكل لهذا الفطر القرصي له داخل يشبه الهلام وساق قصير)",
 "galilaean": "جليلي (مكون من أو متعلق بالجليل أو سكانه) / جليلي (أحد سكان الجليل (لقب ليسوع المسيح))",
 "galilean": "جليلي (مكون من أو متعلق بالجليل أو سكانه) / غاليلي (مكون من أو متعلق بغاليليو أو أعماله) / قَمَر غَالِيلِيّ (أحد أقمار المشتري الأربعة التي اكتشفها غاليليو) / جليلي (أحد سكان الجليل (لقب ليسوع المسيح))",
 "galilean satellite": "قَمَر غَالِيلِيّ (أحد أقمار المشتري الأربعة التي اكتشفها غاليليو)",
 "galilean telescope": "تلسكوب غاليلي, مقراب غاليلي (نوع من التلسكوبات الكاسرة لم يعد يستخدم في علم الفلك)",
 "galilee": "الْجَلِيل",
 "galileo": "غاليليو",
 "galingale": "خولنجان, سعد طويل (سعد أوروبي له أوراق خشنة الحواف وسنيبلات من زهور حمراء وجذور عطرية)",
 "galium aparine": "جويسئة خشنة, عشب الإوز (نبات حولي له ساق مغطى بأشواك منحنية؛ أمريكا الشمالية وأوروبا وآسيا)",
 "galium boreale": "جويسئة شمالية (نبات معمر ذو رئد من أمريكا الشمالية له زهور بيضاء؛ يستخدم أحياناً للزينة)",
 "galium lanceolatum": "جويسئة رمحية, عرق السوس البري (جويسئة ذات جذور حلوة المذاق)",
 "galium mollugo": "جويسئة بيضاء, فوة برية (عشب أوراسي ذو عناقيد واسعة من الزهور البيضاء الصغيرة؛ تم توطينه في أمريكا الشمالية)",
 "galium odoratum": "جويسئة عطرة, نبات الخشبة",
 "galium verum": "جويسئة السيدة العذراء, جويسئة صفراء (جويسئة معمرة شائعة ذات زهور صفراء؛ أمريكا الشمالية وأوروبا وآسيا)",
 "gall": "صفاقة, وقاحة (سمة كون المرء وقحاً وسليطاً؛ يميل لأخذ حريات غير مستحقة) / صفراء, عصارة صفراوية (عصارة هضمية يفرزها الكبد وتخزن في المرارة؛ تساعد في هضم الدهون) / استياء, حقد (شعور بالغضب العميق والمرارة وسوء النية) / عفصة (تورم غير طبيعي في أنسجة النبات ناتج عن الحشرات أو الكائنات الحية الدقيقة أو الإصابة)",
 "gall bladder": "مَرَارَة",
 "gall gnat": "بعوضة العفص (ذباب هش يشبه البعوض ينتج العفص على النباتات)",
 "gall midge": "بعوضة العفص (ذباب هش يشبه البعوض ينتج العفص على النباتات)",
 "gall of the earth": "رجل الأسد, نابالوس سربنتاريوس (عشب معمر شائع واسع التوزيع في جنوب وشرق الولايات المتحدة له عناقيد متدلية من الزهور الوردية وأوراق قاعدية سميكة توحي بشكل قدم الأسد؛ يوضع أحياناً في…)",
 "gall wasp": "دبور العفص (دبور منعزل صغير ينتج العفص على البلوط والنباتات الأخرى)",
 "gall-berry": "بهشية ملساء, توت الحبر (بهشية دائمة الخضرة من شرق أمريكا الشمالية بأوراق جلدية مستطيلة وتوت أسود صغير)",
 "gallamine": "غالامين, فلاكسيديل (عامل حاصر للعصب العضلي (الاسم التجاري فلاكسيديل) يستخدم كمرخي للعضلات في التخدير)",
 "gallant": "بَاسِل, صَنْدِيد (لَا يَتَرَاجَع فِي المَعْرَكَة أَوِ العَمَل) / فُرُوسِيّ, نَبِيل (يُبدي اهتماماً بالنساء كالفارس المثالي) / جَلِيل, شَامِخ (يتحلّى بالوقار والنُّبل الكبيرين أو يُظهرهما) / أَنِيق, جَرِيء (حيويّ ومفعم بالحماس والأناقة)",
 "gallantly": "بِشَهَامَة, بِفُرُوسِيَّة (بطريقة شهمة)\nمثال: عرض بشهامة أن يوصلها للمنزل",
 "gallantry": "شهامة, مروءة (الاهتمام المهذب بالنساء) / إقدام, بسالة (صفات البطل أو البطلة؛ شجاعة استثنائية أو بطولية عند مواجهة الخطر (خاصة في المعركة)) / شهامة, فروسية (المجاملة تجاه النساء)\nمثال: أظهر بطولة عظيمة في المعركة",
 "gallberry": "بهشية ملساء, توت الحبر (بهشية دائمة الخضرة من شرق أمريكا الشمالية بأوراق جلدية مستطيلة وتوت أسود صغير)",
 "gallbladder": "مرارة (كيس عضلي ملحق بالكبد يخزن الصفراء (التي يفرزها الكبد) حتى الحاجة إليها للهضم)",
 "galled": "مُتَسَلِّخ, مُحْتَكّ (مُؤْلِمٌ بِسَبَبِ تَسَلُّخِ الجِلْد)",
 "galleon": "غليون (سفينة شراعية كبيرة مربعة الأشرعة بثلاثة صواري أو أكثر؛ استخدمها الإسبان للتجارة والحرب من القرن الخامس عشر إلى الثامن عشر)",
 "galleria mellonella": "عثة الشمع, عثة النحل (عثة تعيش يرقاتها وتتغذى في أقراص عسل النحل)",
 "gallery": "مَعْرِض, صَالَةُ عَرْض",
 "galley": "قَادِس",
 "galley proof": "تجربة نصوص, مسودة مطبعية (تجربة تؤخذ قبل تكسير الحروف لطباعة الصفحات)",
 "galley slave": "عامل شاق, كادح (عامل ملزم بالقيام بأعمال وضيعة) / عبد التجديف (عبد محكوم عليه بالتجديف في سفينة شراعية)",
 "gallfly": "ذبابة العفص (أي من الحشرات المختلفة التي تضع بيضها في النباتات مما يسبب العفص الذي تتغذى فيه اليرقات) / بعوضة العفص (ذباب هش يشبه البعوض ينتج العفص على النباتات) / دبور العفص (دبور منعزل صغير ينتج العفص على البلوط والنباتات الأخرى)",
 "galliano": "جاليانو (ليكير إيطالي ذهبي منكه بالأعشاب)",
