 "global aphasia": "حبسة شاملة, حبسة كلية (فقدان كلي للقدرة على التواصل)",
 "global attribution": "عزو شمولي (عندما يعتقد الفرد أن سبب الأحداث السلبية ثابت عبر سياقات مختلفة)",
 "global climate change": "تغير المناخ, تغير المناخ العالمي (تغير في مناخ العالم)",
 "global demand": "طلب عالمي, طلب كلي (في الاقتصاد الكلي، إجمالي الطلب على السلع والخدمات النهائية في الاقتصاد في وقت ومستوى سعر معينين)",
 "global organization": "منظمة دولية, منظمة عالمية (تحالف دولي يضم العديد من البلدان المختلفة)",
 "global positioning system": "نِظَام اَلتَّمَوْضُع اَلْعَالَمِيّ, جِي بِي إِس (مَنْهَج، طَرِيقَة؛ تَرْتِيب واتِّسَاق) / مثال: ليس بنظام كامل.",
 "global south": "الْجَنُوب الْعَالَمِيّ, جَنُوب عَالَمِيّ",
 "global warming": "اِحْتِبَاس حَرَارِيّ, اِحْتِرَار عَالَمِيّ (الحَبْسُ: المَنْعُ والإمساكُ، وَهُوَ ضِدُّ التَّخْلِيَة)\nمثال: هل يجب ان اقول المناخ يتغير او الاحتباس الحراري؟",
