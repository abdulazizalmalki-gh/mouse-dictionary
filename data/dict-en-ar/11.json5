 "frenchness": "الطابع الفرنسي (حالة أو شرط كون الشيء فرنسياً)",
 "frenchwoman": "فَرَنْسِيَّة",
 "frenemy": "الصَّدِيقُ العَدُوُّ / صَدِيقُ مَصْلَحَة (هو الصَاحِب والخّل الذي بينك وبينه صَدَاقَة)\nمثال: ليس لديه صديقة.",
 "frenetic": "مَجْنُون, مَحْمُوم (في حالة هياج مفرط؛ مذهول من الخوف أو العاطفة العنيفة)",
 "frenetically": "بجنون, بهستيريا (بطريقة مضطربة للغاية؛ كما لو كان ممسوساً بروح شريرة)",
 "frenzied": "مَجْنُون, مَحْمُوم (في حالة هياج مفرط؛ مذهول من الخوف أو العاطفة العنيفة) / مَسْعُور, هَوَسِيّ (مُصَابٌ بِالهَيَجَانِ أَوِ الهَوَسِ غَيْرِ المُنْضَبِطِ بِالعَقْل)",
 "frenziedly": "بجنون, بشكل محموم (بطريقة محمومة ومضطربة)\nمثال: تدربنا بشكل محموم في الأيام القليلة الماضية قبل العرض الأول",
 "frenzy": "نوبة جنون, هياج (حالة من الهياج العقلي العنيف)",
 "freon": "فريون (أي واحد أو أكثر من مركبات الكلوروفلوروكربون (أو المركبات ذات الصلة) التي تُستخدم كوقود للهباء الجوي أو مذيب عضوي أو مبرد)",
 "frequence": "تَرَدُّد, تَكْرَار (عدد مرات الحدوث ضمن فترة زمنية معينة)\nمثال: كان تردد التعديل 40 دورة في الثانية",
 "frequency": "تَرَدُّد (الذهاب إلى المكان مرة أخرى إلى نفس المكان بصورة متكررة؛ عدم الاستقرار على رأي معين)\nمثال: قبل ماثيو بتردد.",
 "frequency band": "حزمة موجية, نطاق التردد (نطاق من الترددات الراديوية المتجاورة (مثل تلك المخصصة لنقل إشارات الراديو أو التلفزيون))",
 "frequency distribution": "توزيع تكراري (توزيع التكرارات المرصودة لقيم متغير)",
 "frequency modulation": "تضمين التردد (تضمين تردد الموجة الحاملة (للراديو))",
 "frequency response": "استجابة ترددية ((في الإلكترونيات) منحنى يمثل نسبة المخرجات إلى المدخلات لمحول الطاقة كدالة للتردد)",
 "frequency-response characteristic": "منحنى استجابة التردد ((إلكترونيات) رسم بياني لاستجابة التردد مع سعة الإشارة أو الكسب مرسوماً مقابل التردد)",
 "frequency-response curve": "منحنى استجابة التردد ((إلكترونيات) رسم بياني لاستجابة التردد مع سعة الإشارة أو الكسب مرسوماً مقابل التردد)",
 "frequent": "مُتَكَرِّر / اِرْتَادَ (لأهله: ذهب أمامهم رائدًا ليجد النجعة والكلاء؛ المكانَ: كان من روّادِه، أي من الذين كانوا فيه منذ البدء)",
 "frequentative": "صيغة التكرار (صيغة فعل تفيد التكرار المتواتر للحدث)",
 "frequenter": "زبون دائم, مرتاد (زبون منتظم)",
 "frequently": "غالباً, كثيراً (مرات عديدة على فترات قصيرة)\nمثال: غالباً ما التقينا لتناول فنجان من القهوة",
 "frequently asked questions": "أَسِئْلَة مُكَرَّرَة",
 "fresco": "تصوير جصي, فريسكو (طريقة متينة للرسم على الحائط باستخدام الألوان المائية على الجص الرطب) / أفرسكو, تصوير جصي (جدارية تُنفذ بالألوان المائية على الجص الرطب)",
 "fresh": "طَازَج, طَازَة / عَذْب",
 "fresh air": "هَوَاء نَقِيّ (خَلِيط من الغَازَات يغلف الكرة الأرضية؛ فَارِغ)\nمثال: أخرجي الهواء من فمك.",
 "fresh bean": "فاصولياء طازجة (فاصولياء تؤكل قبل نضجها وتجفيفها)",
 "fresh breeze": "نسيم عليل (رياح تتحرك بسرعة 19-24 عقدة؛ 5 على مقياس بوفورت)",
 "fresh fish": "وقود المدافع (جنود يُعتبرون قابلين للتضحية بهم في مواجهة نيران المدفعية)",
 "fresh food": "طعام طازج (طعام غير محفوظ بالتعليب أو التجفيف أو التجميد أو التدخين)",
 "fresh foods": "طعام طازج (طعام غير محفوظ بالتعليب أو التجفيف أو التجميد أو التدخين)",
 "fresh gale": "عاصفة نشطة (رياح تتحرك بسرعة 39-46 عقدة؛ 8 على مقياس بوفورت)",
 "fresh start": "بداية جديدة, صفحة بيضاء (فرصة للبدء من جديد دون أحكام مسبقة)",
 "fresh water": "مَاء عَذْب (السائل الشفاف المعروف الذي تنشأ به الحياة، عديم اللون والرائحة والطعم عندما يكون نقيا؛ علميا فِي : جزيئة متكونة من ذرتي هيدروجين مرتبطين بذرة واحدة من الأوكسيجين)\nمثال: أنا أشرب الماء.",
 "fresh-cut": "مَقْطُوف حَدِيثًا (قُطِعَ أَوْ قُطِفَ مُؤَخَّرًا)",
 "freshener": "مُلَطِّف, مُنعِش (أي شيء يقوم بالإنعاش أو التلطيف)",
 "fresher": "طالب سنة أولى (طالب جامعي في السنة الأولى)",
 "freshet": "سيل, فيضان (حدوث تدفق للمياه ناتج عن مطر مفاجئ أو ذوبان الثلوج)",
 "freshly": "قُبَيْلاً",
 "freshman": "فِي السَّنَةِ الأُولَى, مُسْتَجِدّ (يُوصَفُ بِهِ الشَّخْصُ فِي سَنَتِهِ الأُولَى مِنْ تَجْرِبَةٍ (خَاصَّةً فِي المَدْرَسَةِ أَوِ الجَامِعَةِ)) / طالب سنة أولى (طالب جامعي في السنة الأولى) / قادم جديد, مستجد (أي مشارك جديد في نشاط ما)",
 "freshman class": "السنة الأولى, الصف الأول (الصف الأول في الكلية أو المدرسة الثانوية)",
 "freshness": "جِدَّة, طَرَافَة (الأصالة بحكم كون الشيء جديداً ومنعشاً) / صفاقة, وقاحة (سمة كون المرء وقحاً وسليطاً؛ يميل لأخذ حريات غير مستحقة) / طزاجة, نضارة (خاصية كون الشيء نقياً وطازجاً (كأنه صنع حديثاً)؛ غير بائت أو متدهور) / جدة, حداثة (الأصالة بحكم كونها جديدة ومفاجئة)\nمثال: أحبت طزاجة الخبز المخبوز حديثاً",
 "freshwater": "ماء عذب (ماء غير مالح)",
 "freshwater bass": "باس المياه العذبة (سمكة غذائية ورياضية في أمريكا الشمالية) / سمك الباس (أي من أسماك المياه العذبة المختلفة في أمريكا الشمالية ذات لحم قليل الدهن)",
 "freshwater bream": "أبراميس المياه العذبة / أبراميس المياه العذبة (لحم أسماك مياه عذبة مختلفة من أمريكا الشمالية أو أوروبا)",
 "freshwater clam": "بلح البحر النهري (رخوي ذو صدفتين وفير في أنهار وسط الولايات المتحدة)",
 "freshwater cordgrass": "عشبة الحبل البراري, عشبة الحبل للمياه العذبة (عشبة حبل أمريكية شمالية ذات أوراق بحواف غشائية جافة وقنابات بسفا طويل)",
 "freshwater eel": "أنقليس المياه العذبة, أنقليس شائع (أنقليس يعيش في المياه العذبة كبالغ ولكنه يعود إلى البحر للتكاثر؛ يوجد في أوروبا وأمريكا؛ يُسوق طازجاً ومدخناً)",
 "freshwater fish": "سمك مياه عذبة (لحم السمك من المياه العذبة المستخدم كطعام)",
 "freshwater limpet": "بطلينوس نهري (بطني قدم مخروطي دقيق يشبه البطلينوس ظاهرياً ولكنه يعيش ويتغذى على نباتات المياه العذبة)",
 "freshwater mussel": "بلح البحر النهري (رخوي ذو صدفتين وفير في أنهار وسط الولايات المتحدة)",
 "fresnel lens": "عدسة فرينل (عدسة تتكون من عدد من العدسات الصغيرة المرتبة لتكوين عدسة خفيفة الوزن ذات قطر كبير وبعد بؤري قصير)",
 "fret": "دستان, عتبة (قضيب صغير من المعدن عبر لوحة أصابع الآلة الموسيقية؛ لإنتاج نغمة ذات حدة مطلوبة عند الضغط على الوتر) / تعشيق هندسي, مفتاح إغريقي (نمط زخرفي يتكون من خطوط عمودية وأفقية متكررة (غالباً بشكل بارز)) / موضع تآكل (بقعة تآكلت بفعل الاحتكاك أو التعرية) / غمة, قلق (هياج ناتج عن قلق نشط)\nمثال: كان هناك تعشيق هندسي بسيط في أعلى الجدران",
 "fretful": "كَثِيرُ التَّذَمُّر, نَكِد (كثير الشكوى والتذمّر بشكل معتاد) / قَلِق, مُتَمَلْمِل (عَصَبِيٌّ وَغَيْرُ قَادِرٍ عَلَى الاسْتِرْخَاء)",
 "fretfully": "بتبرم, بقلق (بطريقة قلقة ومتذمرة)\nمثال: بتبرم، تقلب الطفل في سريره",
 "fretfulness": "تهيج, سرعة الغضب (شعور بالتهيج والنزق)",
 "fretsaw": "منشار أركت, منشار منحنيات (منشار آلي دقيق الأسنان بشفرة ضيقة؛ يستخدم لقطع الخطوط المنحنية)",
 "fretted": "مُتَشَابِك, مُشَبَّك (ذو نمط زخرفيّ شبكيّ أو مُخرَّم) / ذو دساتين (يحتوي على دساتين (فواصل معدنية على رقبة الآلات الوترية))",
 "fretwork": "شبكة خشبية (هيكل يتكون من تصميم زخرفي مصنوع من شرائط من الخشب أو المعدن)",
 "freud": "فْرُويْد",
 "freudian": "فرويدي (من أو يتعلق بسيغموند فرويد أو أفكاره في التحليل النفسي) / فْرُويْدِيّ (شخص يتبع النظريات أو الممارسات الأساسية لسيغموند فرويد)\nمثال: نظريات فرويدية",
 "freudian psychology": "علم النفس الفرويدي (النظريات النفسية لسيغموند فرويد)",
 "freudian slip": "مُنْزَلَق فْرُويْد, زَلّة فْرُويْد",
 "fri": "الجمعة, يوم الجمعة (اليوم السادس من الأسبوع)",
 "friability": "تفتت, قابلية التفتت (قابلية الكسر المفرطة)",
 "friable": "رِخْو, مُتَفَتِّت (يَسْهُلُ تَفَتُّتُهُ إِلَى قِطَعٍ صَغِيرَةٍ أَوْ تَحَوُّلُهُ إِلَى مَسْحُوق)",
 "friar": "راهب متسول (عضو ذكر في رهبنة دينية كانت تعتمد في الأصل كلياً على الصدقات)",
 "friar preacher": "دومينيكاني, راهب أسود (راهب روماني كاثوليكي يرتدي العباءة السوداء للرهبنة الدومينيكانية)",
 "friar's cowl": "أُذُن الفِيل (أَذَن؛ أَذَنَ: ( فعل ) أَذَنَ أَذْناً)\nمثال: من أذن لتوم باستعارة سيارتي?",
 "friar's lantern": "مصباح العفريت, نار هائمة (ضوء باهت يُرى أحياناً في الليل فوق الأرض المستنقعية)",
 "friar's-cowl": "قلنسوة الراهب (نبات معمر درني ذو قنابة كستنائية أو بنفسجية سوداء تشبه القلنسوة: موطنه البحر الأبيض المتوسط وجزر الكناري وجزر الآزور)",
 "friary": "دير الرهبان (دير للرهبان المتجولين)",
 "fricandeau": "فريكاندو (شريحة لحم عجل مطعمة بالدهن ومطهية ببطء ومغطاة بصلصة من عصارتها)",
 "fricassee": "فريكاسي (قطع دجاج أو لحم آخر مطهية في مرق مع الجزر والبصل مثلاً وتُقدم مع المعكرونة أو الزلابية)",
 "fricative": "اِحْتِكَاكِي, رَخْو",
 "fricative consonant": "صامت احتكاكي (صامت استمراري يُنتج عن طريق حركة النفس ضد تضييق في المجرى الصوتي)",
 "fricativeness": "احتكاكية\nمثال: بالنسبة للأول، تكون احتكاكية النفس مسموعة من الحلق، عبر التشكيل الفموي؛ وبالنسبة للأخير، يكون احتكاك النفس مسموعاً فقط من الشفة",
 "friction": "اِحْتِكَاك",
 "friction clutch": "قابض احتكاكي (قابض يقوم فيه جزء بتدوير الجزء الآخر عن طريق الاحتكاك بينهما)",
 "friction match": "عود ثقاب (مشعل يتكون من قطعة رقيقة من الخشب أو الكرتون ذات رأس بمادة كيميائية قابلة للاشتعال؛ يشتعل بالاحتكاك)\nمثال: يحمل دائماً أعواد ثقاب لإشعال غليونه",
 "friction prop": "دعامة احتكاكية (دعامة فولاذية يتم التحكم في خضوعها عن طريق الاحتكاك بين سطحين منزلقين أو أنابيب متداخلة)",
 "friction tape": "شريط عازل (شريط لاصق مقاوم للماء يستخدم لعزل الموصلات الكهربائية المكشوفة)",
 "friction yielding prop": "دعامة احتكاكية (دعامة فولاذية يتم التحكم في خضوعها عن طريق الاحتكاك بين سطحين منزلقين أو أنابيب متداخلة)",
 "frictional": "احتكاكي (يخص أو يعمل أو ينتج عن الاحتكاك)\nمثال: كهرباء احتكاكية",
 "frictionless": "عديم الاحتكاك (يفتقر إلى كل احتكاك)\nمثال: يجب أن تكون آلة الحركة الدائمة عديمة الاحتكاك",
 "friday": "الْجُمُعَة, الجُمْعَة",
 "fridge": "ثلاجة كهربائية (ثلاجة يتم ضخ سائل التبريد فيها بواسطة محرك كهربائي)",
 "fridge-freezer": "ثَلّاجة",
 "fried": "مَقْلِيّ",
 "fried chicken": "دَجَاج مَقْلِيّ",
 "fried egg": "بَيْض مَقْلِيّ (الأيام البِيض: الأيام التي توافق اليوم الثالث عشر، والرابع عشر، والخامس عشر من كل شهر من أشهر العام الهجري، وقد سُمِّيت بذلك…)\nمثال: ياني يحب البيض.",
 "fried rice": "أرز صيني مقلي, أرز مقلي (أرز مسلوق مخلوط بالبصل الأخضر ولحم الخنزير المفروم أو الجمبري ومخفوق بسرعة مع البيض)",
 "friedcake": "كعكة مقلية (كعكة صغيرة على شكل حلقة أو جديلة أو كرة أو شريط تقلى في زيت غزير)",
 "friedman test": "اختبار الأرنب, اختبار فريدمان (اختبار حمل يتضمن حقن بعض بول المرأة في أنثى أرنب غير متزاوجة وفحص مبايض الأرنب لاحقًا)",
 "friedreich's ataxia": "رنح فريدريك (تصلب الأعمدة الخلفية والجانبية للحبل الشوكي؛ يتميز بضعف عضلي ومشية غير طبيعية؛ يحدث عند الأطفال)",
 "friend": "صَدِيق, صَدِيقَة (هو الصَاحِب والخّل الذي بينك وبينه صَدَاقَة)\nمثال: ليس لديه صديقة.",
 "friend of the court": "صديق المحكمة (مستشار للمحكمة في مسألة قانونية ليس طرفًا في القضية؛ عادة شخص يريد التأثير على نتيجة دعوى قضائية تنطوي على مسائل تهم الرأي العام)",
 "friend with benefits": "صديق حميم (صديق تربطك به علاقة جنسية)",
 "friend zone": "خَانَة الصَدَاقَة",
 "friendless": "مَنْبُوذ, مُقْصًى (مُستبعَد من المجتمع ولا صديق له)",
 "friendlessness": "افتقار للأصدقاء, عزلة اجتماعية (أن يكون المرء بلا أصدقاء)",
 "friendliness": "ألفة, ود (طبع ودود) / لطف, ود (شعور بالإعجاب بشخص آخر؛ الاستمتاع برفقته)",
 "friendly": "لَطِيف (ذو اللطف وذو اللطافة؛ من الكلام: هو عمض معناه وخفي)\nمثال: هي مدرسة لطيفة.",
 "friendly fire": "نِيرَان صَدِيقَة",
 "friendly relationship": "صداقة, علاقة ودية (حالة كون الأشخاص أصدقاء (أو ودودين))",
 "friendly takeover": "استحواذ ودي (استحواذ ترحب به إدارة الشركة المستهدفة)",
 "friendship": "صَدَاقَة (المَحَبَّة بالصِّدْق. هي العِلاقَة بين شخصين أو أكثر قائِمَة على المحبة والصدق فكل منهم يحب الآخر ويَصْدُقه ويُصَدِّقه، كل منهم هو صَدِيق للآخر)\nمثال: الغيرة عدوة الصداقة.",
 "friendship plant": "باناميكا, نبات الصداقة (قراص منخفض غير لاذع من أمريكا الوسطى والجنوبية ذو أوراق مسننة بنية مخضرة مخملية وعناقيد من الزهور الخضراء الصغيرة)",
 "frier": "دجاج قلي (لحم دجاجة صغيرة متوسطة الحجم مناسبة للقلي) / قلاية, مقلاة عميقة (جهاز مطبخ للقلي العميق؛ يعتمد حجمه على الاستخدام المقصود)\nمثال: تُستخدم المقالي العميقة لطهي العديد من الوجبات السريعة وجعلها مقرمشة",
 "fries": "أصابع البطاطس المقلية, بطاطس مقلية (شرائح من البطاطس مقلية في زيت غزير)",
 "friesian": "فريزيان, هولشتاين (سلالة من ماشية الحليب من شمال هولندا)",
 "friesland": "فريزلاند, فريزلند",
 "frieze": "إِفْرِيز",
 "frigate": "فِرْقَاطَة",
 "frigate bird": "فرقاط (طائر بحري طويل المنقار من المياه الدافئة ذو باع جناحين عريض وذيل متشعب)",
 "fright": "رُعْب, ذُعْر ((رَعَبَ) يَرْعُبُ رُعْبًا: خاف وفَزِعَ؛ في التنزيل العزيز)\nمثال: سامي يحب قصص الرعب.",
 "frighten": "خَشَّى, أَفْزَعَ",
 "frightened": "فزعان",
 "frightening": "مُجَفِّل, مُخِيف",
 "frighteningly": "برعب, بشكل مخيف (بطريقة تبعث على الرعب)\nمثال: الشيء المقلق في سلوك الوزير هو أنه بعيداً عن كونه مصطنعاً، فإنه في كثير من الأحيان يبدو حقيقياً بشكل مخيف",
 "frightful": "فَظِيع, مُرَوِّع (يثير الرعب والهلع) / مُرَوِّع, مُفْزِع (مُقلِق ومؤلم في أقصى الدرجات) / شَدِيد, مَهُول (بالغ في الدرجة أو المدى أو المقدار أو التأثير)",
 "frightfully": "بشكل رهيب, جداً (تستخدم للتوكيد)\nمثال: مثير للاهتمام جداً",
 "frightfulness": "إِخَافَة, إِرْعَاب (صفة كون الشيء مخيفاً)",
 "frigid": "زَمْهَرِيرِيّ, قَارِس (شديد البرودة للغاية) / جَلِيدِيّ, فَاتِر (خالٍ من الدفء والوُدّ؛ يُعبِّر عن الجفاء أو الازدراء) / بَارِد, فَاتِر (غير مستجيب جنسياً)",
 "frigid zone": "المنطقة القطبية, المنطقة المتجمدة (جزء سطح الأرض الذي يشكل غطاء فوق القطب؛ ويتميز بمناخ متجمد)",
 "frigidity": "برود, جفاء (نقص في المودة أو الحماس) / انخفاض درجة الحرارة, برد (غياب الحرارة) / برود جنسي (عدم الاستجابة الجنسية (خاصة عند النساء) وعدم القدرة على الوصول إلى النشوة أثناء الجماع)\nمثال: برود مؤلم في النبرة والأسلوب",
 "frigidly": "ببرود, بجفاء (بدون دفء أو حماس)\nمثال: قال ببرود: ادخل إن كان لا بد من ذلك",
 "frigidness": "برود, جفاء (نقص في المودة أو الحماس) / انخفاض درجة الحرارة, برد (غياب الحرارة) / برود جنسي (عدم الاستجابة الجنسية (خاصة عند النساء) وعدم القدرة على الوصول إلى النشوة أثناء الجماع)\nمثال: برود مؤلم في النبرة والأسلوب",
 "frigorific": "مُبَرِّد, مُجَمِّد (يُسبِّب البرودة؛ يُبرِّد أو يُقشعِرّ)",
 "frijol": "فاصولياء كلوية (نبات الفاصولياء الشائع الذي يزرع للفاصولياء بدلاً من القرون (خاصة صنف ذو فاصولياء حمراء كبيرة كلوية الشكل))",
 "frijole": "فاصولياء مكسيكية (فاصولياء مكسيكية؛ عادة ما تكون مجففة) / فاصولياء كلوية (نبات الفاصولياء الشائع الذي يزرع للفاصولياء بدلاً من القرون (خاصة صنف ذو فاصولياء حمراء كبيرة كلوية الشكل))",
 "frijoles refritos": "فاصوليا مقلية, فريخولي (فاصوليا مجففة مطبوخة ومهروسة ثم مقلية في شحم الخنزير مع توابل متنوعة)",
 "frijolillo": "صفيراء ثانوية الأزهار, فاصولياء المسكال (شجيرة أو شجرة صغيرة لها أوراق ريشية سامة للماشية وعناقيد كثيفة من الزهور الزرقاء شديدة العطر وفاصولياء حمراء)",
 "frijolito": "صفيراء ثانوية الأزهار, فاصولياء المسكال (شجيرة أو شجرة صغيرة لها أوراق ريشية سامة للماشية وعناقيد كثيفة من الزهور الزرقاء شديدة العطر وفاصولياء حمراء)",
 "frill": "حلي تافهة, خردوات (أشياء زخرفية ليس لها قيمة كبيرة) / كشكشة, هدب (شريط من القماش المثني يُستخدم كزينة أو حاشية) / طوق, ياقة (جزء خارجي من الجسم يتكون من ريش أو شعر حول عنق طائر أو حيوان آخر) / هدب عظمي ((علم الحفريات) صفيحة عظمية تنحني لأعلى خلف جمجمة العديد من الديناصورات القرنية)",
 "frilled": "ذُو كَشَاكِش, مُكَشْكَش (ذو كشاكش أو حواشٍ زخرفية)",
 "frilled lizard": "سحلية مكشكشة (سحلية أسترالية شجرية كبيرة آكلة للحشرات ذات طوق من الجلد حول الرقبة)",
 "frilly": "ذُو كَشَاكِش, مُكَشْكَش (ذو كشاكش أو حواشٍ زخرفية)",
 "frimaire": "فْرِيمَيْر",
 "fringe": "هُدْب (هُدْبُ العين ما نبت من الشعر على أشفارها) / هُدُب (هُدْبُ العين ما نبت من الشعر على أشفارها)",
 "fringe benefit": "امتياز وظيفي, ميزة إضافية (ميزة عرضية تُمنح لأنواع معينة من التوظيف (خاصة إذا كانت تُعتبر حقاً))\nمثال: سيارة الليموزين هي إحدى الامتيازات الإضافية للوظيفة",
 "fringe bush": "شجرة الأهداب (شجرة كثيفة صغيرة من جنوب شرق الولايات المتحدة لها عناقيد غزيرة من الزهور البيضاء)",
 "fringe cups": "أكواب مهدبة, تيليما (نبات ينمو في كتل بأوراق قاعدية غالباً وأزهار مهدبة قشدية اللون أو وردية باهتة في عدة عناقيد طويلة؛ ألاسكا إلى ساحل وسط كاليفورنيا وشرقاً إلى أيداهو)",
 "fringe tree": "شجرة الأهداب (أي من الأشجار المزهرة الصغيرة المزخرفة أو الشجيرات المختلفة من جنس خيونانثوس)",
 "fringe-toed lizard": "سحلية هدبية الأصابع (ذات حراشف طويلة مدببة حول أصابع القدم؛ من صحاري الولايات المتحدة والمكسيك)",
 "fringed": "ذُو أَهْدَاب, مُهَدَّب (ذو حافة زخرفية من الخيوط أو الشرائط المعلقة) / ذُو أَهْدَاب, مُهَدَّب (محاط كأنه بإطار أو أهداب) / مُشَرَّم, مُهَدَّبُ الحَوَافّ (ذو حوافّ مشقوقة بشكل غير منتظم ودقيق)",
 "fringed gecko": "وزغة طائرة (وزغة لها تمددات غشائية على جانبي جسمها وأطرافها وذيلها تمكنها من الانزلاق لمسافات قصيرة)",
 "fringed gentian": "جنطيانا مهدبة",
 "fringed grass of parnassus": "عشب بارناسوس المهدب (نبات مستنقعات بأوراق قاعدية عريضة على شكل قلب وأزهار قشدية اللون أو بيضاء على شكل صحن ببتلات مهدبة؛ غرب جبال الروكي من ألاسكا إلى نيو مكسيكو)",
 "fringed loosestrife": "ليسيماكيا مهدبة (من أمريكا الشمالية)",
 "fringed orchid": "أوركيد مهدب (أي من عدة بساتين فاكهة أمريكية تزهر صيفاً تتميز بشفة مهدبة أو ممزقة)",
 "fringed orchis": "أوركيد مهدب (أي من عدة بساتين فاكهة أمريكية تزهر صيفاً تتميز بشفة مهدبة أو ممزقة)",
 "fringed pink": "قرنفل رائع, قرنفل مهدب (قرنفل أوراسي معمر ذو زهور ليلكية أو وردية عطرة بحواف مهدبة بعمق) / لينانثوس (عشب متفرع بساق سلكية منخفض من جنوب كاليفورنيا له زهور وردية مهدبة)",
 "fringed polygala": "مستدرة مهدبة, وينترغرين مزهر (مستدرة معمرة زاحفة شائعة في شرق أمريكا الشمالية لها أوراق تشبه الوينترغرين وزهور وردية أرجوانية عادة بسبلات مجنحة)",
 "fringed poppy mallow": "ختمية الخشخاش المهدبة (ختمية خشخاش معمرة في ولايات السهول الجنوبية للولايات المتحدة ذات زهور حمراء وردية أو أرجوانية وردية)",
 "fringepod": "قرن الدانتيل, قرن مهدب (عشب حولي له أوراق قاعدية ريشية وعناقيد نحيلة من الزهور البيضاء الصغيرة تليها خردلات مجنحة ذات بذرة واحدة)",
 "fringilla coelebs": "شرشور (عصفور أوروبي صغير ذو تغريد مبهج)",
 "fringilla montifringilla": "شرشور الجبل (عصفور أوراسي)",
 "fringy": "حَدِّيّ, هَامِشِيّ (عند الحدود أو الحافّة أو يشكّلها)",
 "frippery": "زينة رخيصة, شيء تافه (شيء قليل القيمة أو الأهمية)",
 "frisbee": "صَحْنٌ طَائِر (ساحة وسط الدَار. الجمع صحون؛ المستوي من الأرض)\nمثال: توم يلعب الصحن الطائر.",
 "frisia": "فريزيا",
 "frisian": "فريزي (مكون من أو متعلق بشعب أو ثقافة أو لغة فريزلاند أو فريزيا) / اللغة الفريزية (لغة جرمانية غربية يتم التحدث بها في فريزلاند في شمال غرب هولندا؛ قريبة من الإنجليزية) / الفريزيون (مواطن أو ساكن فريزلاند أو فريزيا)",
 "frisian language": "اللغة الفريزية (لغة جرمانية غربية يتم التحدث بها في فريزلاند في شمال غرب هولندا؛ قريبة من الإنجليزية)",
 "frisk": "تفتيش جسدي (فعل تفتيش شخص ما بحثاً عن أسلحة مخفية أو مخدرات غير قانونية)\nمثال: أجرى للمشتبه به تفتيشاً سريعاً",
 "friskily": "بمرح, بنشاط (بطريقة مرحة ونشطة)\nمثال: يتحرك بمرح رغم تقدمه في السن",
 "friskiness": "مرح, وثب (مرح حيوي عالي الروح)",
 "frisking": "تفتيش جسدي (فعل تفتيش شخص ما بحثاً عن أسلحة مخفية أو مخدرات غير قانونية)\nمثال: أجرى للمشتبه به تفتيشاً سريعاً",
 "frisky": "مَرِح كَالقِطَط, نَشِيط (لعوب كقطّ صغير نشيط وحيويّ)",
 "frisson": "رجفة, رعشة (إحساس بالخوف يكاد يكون ممتعاً)\nمثال: سرت فيه رعشة مفاجئة",
 "fritillaria affinis": "أجراس المهمة, فريتيلاريا (عشبة من شمال غرب أمريكا ذات أزهار خضراء وأرجوانية على شكل جرس)",
 "fritillaria agrestis": "جرس النتن (عشبة كاليفورنيا كريهة الرائحة بأزهار على شكل جرس؛ عشبة ضارة شائعة في حقول الحبوب)",
 "fritillaria biflora": "أجراس المهمة, فريتيلاريا سوداء (عشبة من جنوب غرب الولايات المتحدة ذات أزهار أرجوانية داكنة على شكل جرس مرقطة بالأخضر)",
 "fritillaria imperialis": "بوقية إمبراطورية, تاج الإمبراطور (عشبة أوراسية بكتلة من الأوراق وأزهار برتقالية حمراء على شكل جرس في أعلى الساق)",
 "fritillaria lanceolata": "أجراس المهمة, فريتيلاريا (عشبة من شمال غرب أمريكا ذات أزهار خضراء وأرجوانية على شكل جرس)",
 "fritillaria liliaceae": "بوقية بيضاء (عشبة كاليفورنيا بأزهار بيضاء مخروطية أو على شكل جرس عادة ما تكون مشوبة بالأخضر)",
 "fritillaria meleagris": "رأس الثعبان, زهرة دجاج غينيا (زنبق متقلب أوراسي بأزهار متدلية عادة ما تكون معرقة ومتقلبة بالأرجواني أو الماروني على خلفية شاحبة وعلى شكل الأجراس التي كان يحملها مرضى الجذام في…)",
 "fritillaria micrantha": "أجراس بنية (عشبة كاليفورنيا بأزهار بنية أرجوانية أو خضراء على شكل جرس)",
 "fritillaria mutica": "أجراس المهمة, فريتيلاريا (عشبة من شمال غرب أمريكا ذات أزهار خضراء وأرجوانية على شكل جرس)",
 "fritillaria parviflora": "أجراس بنية (عشبة كاليفورنيا بأزهار بنية أرجوانية أو خضراء على شكل جرس)",
 "fritillaria pluriflora": "بوقية وردية, زنبق الطوب (عشبة كاليفورنيا بأزهار أرجوانية وردية)",
 "fritillaria recurva": "بوقية قرمزية (عشبة غرب الولايات المتحدة بأزهار قرمزية وصفراء ضيقة على شكل جرس)",
 "fritillary": "بُوقِيَّة, عَرَار",
 "frittata": "فريتاتا (عجة إيطالية مع خضروات ولحوم مقطعة؛ تُطهى حتى يتماسك القاع ثم تقلب في مقلاة أخرى لطهي الوجه)",
 "fritter": "فريتر, فطيرة مقلية (كمية صغيرة من العجين المقلي تحتوي على فواكه أو لحم أو خضروات)",
 "fritter batter": "عجين الفريتر (عجين سائل لصنع الفريتر (المقليات))",
 "friuli": "الفريولية (لهجة رومانشية يتم التحدث بها في شمال شرق إيطاليا)",
 "friuli-venezia giulia": "فريولي فينيتسيا جوليا",
 "friulian": "الفريولية (لهجة رومانشية يتم التحدث بها في شمال شرق إيطاليا)",
 "frivolity": "خِفَّة, رُعُونَة",
 "frivolous": "تافه, طائش (غير جاد في المحتوى أو الموقف أو السلوك)\nمثال: رواية تافهة",
 "frivolously": "باستهتار, بعبث (بطريقة عابثة وغير جادة)\nمثال: تقضي وقتها بعبث مستمتعة بالحياة السهلة لفتاة غنية ومدللة",
 "frivolousness": "طيش, عبث (سمة كون المرء عابثاً؛ غير جاد أو عاقل)",
 "frizz": "تَجْعِيْد",
 "frizzly": "شَدِيدُ التَّجْعِيد, مُكَرَّش ((عَنِ الشَّعْرِ) ذُو تَجْعِيدَاتٍ صَغِيرَةٍ وَمُحْكَمَةٍ)",
 "frizzy": "شَدِيدُ التَّجْعِيد, مُكَرَّش ((عَنِ الشَّعْرِ) ذُو تَجْعِيدَاتٍ صَغِيرَةٍ وَمُحْكَمَةٍ)",
 "frock": "ثوب, فستان (رداء من قطعة واحدة للمرأة؛ يتكون من تنورة وصدرية) / ثوب كاهن (ثوب يرتديه رجال الدين) / ثوب خارجي فضفاض (رداء خارجي طويل وفضفاض)",
 "frock coat": "معطف رسمي طويل, معطف فراك (معطف رجالي له أذيال تصل للركبة من الأمام والخلف؛ كان يرتدى في القرن التاسع عشر)",
 "frog": "ضِفْدِع (مِنْ فَصِيلَةِ الضِّفْدَعِيَّاتِ ، بَرْمَائِيٌّ لاَ ذَنَبَ لَهُ ، رَخْوٌ ، دَقِيقُ العِظَامِ ، جَمِيلُ السِّبَاحَةِ ، وَهُوَ أَنْوَاعٌ…؛ \" نَقَّتْ ضَفَادِعُ بَطْنِهِ \" : صَوَّتَتْ عَصَافِيرُ بَطْنِهِ ، أَيْ جَاعَ) / ضَفْدَع (مِنْ فَصِيلَةِ الضِّفْدَعِيَّاتِ ، بَرْمَائِيٌّ لاَ ذَنَبَ لَهُ ، رَخْوٌ ، دَقِيقُ العِظَامِ ، جَمِيلُ السِّبَاحَةِ ، وَهُوَ أَنْوَاعٌ…؛ \" نَقَّتْ ضَفَادِعُ بَطْنِهِ \" : صَوَّتَتْ عَصَافِيرُ بَطْنِهِ ، أَيْ جَاعَ) / ضِفْدَع (مِنْ فَصِيلَةِ الضِّفْدَعِيَّاتِ ، بَرْمَائِيٌّ لاَ ذَنَبَ لَهُ ، رَخْوٌ ، دَقِيقُ العِظَامِ ، جَمِيلُ السِّبَاحَةِ ، وَهُوَ أَنْوَاعٌ…؛ \" نَقَّتْ ضَفَادِعُ بَطْنِهِ \" : صَوَّتَتْ عَصَافِيرُ بَطْنِهِ ، أَيْ جَاعَ) / ضفدع (مِنْ فَصِيلَةِ الضِّفْدَعِيَّاتِ ، بَرْمَائِيٌّ لاَ ذَنَبَ لَهُ ، رَخْوٌ ، دَقِيقُ العِظَامِ ، جَمِيلُ السِّبَاحَةِ ، وَهُوَ أَنْوَاعٌ…؛ \" نَقَّتْ ضَفَادِعُ بَطْنِهِ \" : صَوَّتَتْ عَصَافِيرُ بَطْنِهِ ، أَيْ جَاعَ) / بقرور\nمثال: الضفدع في البئر.",
 "frog kick": "ركلة الضفدع (ركلة سباحة؛ يتم سحب الركبتين للأعلى وللخارج بحيث يمكن ضم الساقين معاً عند تمديدهما بالكامل)",
 "frog legs": "أرجل الضفادع (الأرجل الخلفية للضفادع تستخدم كطعام؛ تشبه الدجاج وتُطهى كالدجاج)",
 "frog orchid": "أوركيد الضفدع (أوركيد ذو زهور خضراء إلى خضراء مصفرة طويلة القنابات مقنعة مشوبة بالأرجواني) / أوركيد الضفدع (أي من عدة بساتين فاكهة خضراء من جنس هابيناريا)",
 "frog's lettuce": "خس الضفدع (خَسَّ الرجُلُ يَخِسُّ خِسَّةً، وخَسَاسَةً: حَقُرَ؛ يقال: خَسَّ فِعْلُهُ وقولُه ورأْيُه)\nمثال: بيع المنزل بثمن بخس.",
 "frog's-bit": "لكمة الضفدع, هيدروشاريس (نبات أوروبي عائم بأوراق دائرية على شكل قلب وأزهار بيضاء)",
 "frogbit": "لكمة الضفدع, هيدروشاريس (نبات أوروبي عائم بأوراق دائرية على شكل قلب وأزهار بيضاء)",
 "frogfish": "سمكة الضفدع (سمكة لها فم يشبه فم الضفدع مع طُعم على الخطم)",
 "froghopper": "نطاط الضفدع (نوع من حشرة البصاق)",
 "froglike": "ضِفْدَعِيّ",
 "frogman": "ضِفْدِع بَشَرِيّ (مِنْ فَصِيلَةِ الضِّفْدَعِيَّاتِ ، بَرْمَائِيٌّ لاَ ذَنَبَ لَهُ ، رَخْوٌ ، دَقِيقُ العِظَامِ ، جَمِيلُ السِّبَاحَةِ ، وَهُوَ أَنْوَاعٌ…؛ \" نَقَّتْ ضَفَادِعُ بَطْنِهِ \" : صَوَّتَتْ عَصَافِيرُ بَطْنِهِ ، أَيْ جَاعَ)\nمثال: الضفدع في البئر.",
 "frogmouth": "فم الضفدع (طائر آكل للحشرات من أستراليا وجنوب شرق آسيا له فم واسع يشبه الضفدع)",
 "frogwoman": "غواصة (امرأة تعمل تحت الماء)",
 "frolic": "لهو, مرح (نشاط ترفيهي مبهج أو خفيف الظل للتسلية)\nمثال: كل ذلك تم من باب المزاح",
 "frolicky": "لَعُوب, مَرِح (ميّال إلى اللهو والمرح بحيوية)",
 "frolicsome": "لَعُوب, مَرِح (ميّال إلى اللهو والمرح بحيوية)",
 "frolicsomeness": "مرح, وثب (مرح حيوي عالي الروح)",
 "from": "مِن (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / مِن, عَنْ (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "from a to z": "مِنَ الأَلِف إِلَى اليَاء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "from each one": "لِكُلّ وَاحِد (لكل فرد من اثنين أو أكثر (يعتبرون بشكل فردي))\nمثال: حصل كل واحد منهم على 10 دولارات",
 "from head to toe": "مِن الرَّأْس إِلَى القَدَم (في جميع النقاط من الرأس إلى القدمين)\nمثال: كان مسلحاً من رأسه إلى أخمص قدميه",
 "from now on": "مِنَ الآنَ فَصَاعِدًا, اِنْطِلَاقًا مِنَ الْآنِ (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "from nowhere": "فجأة, من العدم (دون سابق إنذار)\nمثال: وصل ابن عمك من العدم",
 "from pillar to post": "جيئة وذهاباً, من مكان لآخر (من مكان أو وضع إلى آخر)\nمثال: تم تقاذفنا من مكان لآخر",
 "from scratch": "من الصفر (من البداية، خاصة دون الاعتماد على موارد أو مزايا أخرى)\nمثال: خبز الكعكة من الصفر",
 "from start to finish": "من البداية إلى النهاية (بشكل كامل وشامل)",
 "from the cradle to the grave": "مِنَ ٱلْمَهْدِ إِلَىٰ ٱللَّحْدِ (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "from the get-go": "مُنْذُ الْبِدايةِ",
 "from the heart": "من القلب, من صميم القلب (بصدق شديد)\nمثال: تحدث من القلب",
 "from the river to the sea": "مِنَ ٱلنَّهْرِ إِلَى ٱلْبَحْرِ (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "from the start": "مُنْذُ البِدَايَة",
 "from time to time": "بَيْنَ ٱلْحِينِ وَٱلْآخَرِ, بين وقت وآخر (ظرف مكان بمعنى وَسْط)\nمثال: مصيري بين يديك.",
 "from way back": "منذ زمن بعيد (منذ وقت طويل)\nمثال: تعرفه منذ زمن بعيد",
