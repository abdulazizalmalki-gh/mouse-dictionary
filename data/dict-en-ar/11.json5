 "garcinia hanburyi": "جارسينيا, شجرة غامبوج (شجرة منخفضة الانتشار من إندونيسيا تنتج صمغاً راتنجياً برتقالياً إلى بني (غامبوج) يستخدم كصبغة عند سحقه)",
 "garcinia mangostana": "شجرة المانغوستين, مانغوستين (شجرة من جزر الهند الشرقية ذات أوراق جلدية سميكة وفاكهة صالحة للأكل)",
 "garden": "بُسْتَان (أَرْض يحيطها سُوْر وفيها نخيل متفرقة وأعناب وأشجار، تستخدم في الأساس للحصول على منتوجها من الفَاكِهَة والثَمَر. الجَنَّة) / حَدِيقَة (الحَديقَةُ، الرَّوْضَةُ ذاتُ الشجرِ؛ حديقة , العاطل عن العمل في اللهجة العراقية وأصل تولد المعنى أن بعض العاطلين يقضون أوقاتهم في العناية بحدائق بيوتهم, فإذا سألهم سائل عن عملهم, ما هو؟…) / جَنَّة (أرض محاطة بسُور فيها نخل وشجر وكروم، البُسْتَان؛ الحَدِيقَة أو الحَائِط) / جنينة / بَخْشَة\nمثال: أحب سقي البستان.",
 "garden angelica": "أنجليكا بستانية, حشيشة الملاك (عشب ثنائي الحول مزروع؛ سيقانه تسكر وتؤكل وجذوره تستخدم طبياً)",
 "garden balm": "ترنجان, عشبة الليمون (نعناع معمر كثيف من العالم القديم له أزهار بيضاء أو مصفرة صغيرة وأوراق عطرية بنكهة الليمون؛ هارب من الحدائق في شمال أوروبا وأمريكا الشمالية)",
 "garden cart": "برويطة, عربة يدوية بعجلة واحدة (عربة لحمل الأحمال الصغيرة؛ لها مقابض وعجلة واحدة أو أكثر)",
 "garden centipede": "مئوية أرجل الحدائق (مفصلي دقيق يصيب غالباً الأجزاء الموجودة تحت الأرض من محاصيل الحدائق والدفيئات)",
 "garden chair": "كرسي حديقة (كرسي يترك في الخارج للاستخدام في الحديقة أو الفناء)",
 "garden cress": "رشاد مزروع (رشاد يزرع للسلطات والزينة)",
 "garden current": "ريباس أحمر, كشمش أحمر (كشمش أوروبي مزروع يحمل ثماراً حمراء صغيرة صالحة للأكل)",
 "garden egg": "باذنجان (عشب مشعر قائم موطنه جنوب شرق آسيا ولكنه يزرع على نطاق واسع لفاكهته اللحمية اللامعة الكبيرة المستخدمة عادة كخضروات)",
 "garden forget-me-not": "لا تنسني الحدائقية (عشب صغير ثنائي الحول إلى معمر في أوروبا وشمال أفريقيا وغرب آسيا له أزهار زرقاء أو أرجوانية أو بيضاء)",
 "garden heliotrope": "ناردين شائع, ناردين مخزني (نبات جذموري طويل له زهور عطرة جداً وجذامير تستخدم طبياً)",
 "garden hose": "خرطوم الحديقة (خرطوم يستخدم لري العشب أو الحديقة)",
 "garden huckleberry": "توت العجائب, عنب الذيب البستاني (صنف حديقة محسن من عنب الذيب الأسود يحمل ثماراً برتقالية أو سوداء صغيرة صالحة للأكل)",
 "garden lettuce": "خس, خس الحدائق (نبات حديقة حولي أو معمر ذو أوراق عصارية تستخدم في السلطات؛ يزرع على نطاق واسع)",
 "garden loosestrife": "ليسيماكيا الحدائق, ليسيماكيا صفراء (تعتبر في كثير من الأحيان عشبة ضارة؛ أوروبا وآسيا)",
 "garden nasturtium": "كبوسين كبير, لادن (نبات متسلق حولي قوي النمو له زهور كبيرة بجميع ظلال البرتقالي من الأحمر البرتقالي إلى البرتقالي المصفر وبذور تخلل وتستخدم مثل الكبر)",
 "garden of eden": "عَدْن, جَنَّة عَدْن (الإقَامَة والتَوَطُّن بالمكان؛ جَنَّاتُ عَدْن: المكان الذي وعد الله المؤمنين، الجَنَّة)\nمثال: عدن إلى المصرف.",
 "garden orache": "رغل بستاني, سبانخ الجبل (نبات آسيوي يشبه السبانخ غالباً ما يستخدم كبقلة؛ متوطن في أوروبا وأمريكا الشمالية)",
 "garden party": "حفلة حديقة, حفلة خارجية (حفلة يجتمع فيها الناس للتفاعل الاجتماعي في الهواء الطلق)",
 "garden pea": "بازلاء خضراء (بازلاء طازجة) / بازلاء الحديقة, بازلاء شائعة (نبات ينتج بازلاء تؤكل عادة طازجة بدلاً من مجففة) / بازلاء الحدائق (الفاكهة المسطحة إلى الأسطوانية المنتفخة متعددة البذور لنبات البازلاء الشائع)",
 "garden pea plant": "بازلاء الحديقة, بازلاء شائعة (نبات ينتج بازلاء تؤكل عادة طازجة بدلاً من مجففة)",
 "garden pepper cress": "رشاد الحديقة, رشاد مزروع (عشب حولي يستخدم كخضار للسلطة وللزينة)",
 "garden peppergrass": "رشاد الحديقة, رشاد مزروع (عشب حولي يستخدم كخضار للسلطة وللزينة)",
 "garden pink": "قرنفل, قرنفل الحدائق",
 "garden plant": "نبات حدائق (أي من النباتات المتنوعة التي تُزرع عادة في حديقة زهور أو حديقة أعشاب)",
 "garden rake": "مشط الحديقة (مشط يستخدمه البستانيون)",
 "garden rhubarb": "راوند الحدائق",
 "garden rocket": "جرجير, روكا (نبات حولي أوروبي قائم يزرع غالباً كمحصول سلطة ليحصد عندما يكون صغيراً وطرياً)",
 "garden roller": "أسطوانة التسوية, محدلة الحديقة (أسطوانة ثقيلة من الحديد الزهر تستخدم لتسوية المروج)",
 "garden snail": "حلزون الحديقة (أي من عدة حلزونات غير صالحة للأكل من جنس هيليكس؛ غالباً ما تكون آفات مدمرة)",
 "garden sorrel": "حميض الحدائق, حميض حامض (حميض أوروبي بأوراق سهمية كبيرة حمضية قليلاً يزرع في جميع أنحاء المنطقة المعتدلة الشمالية للسلطة والخضروات الربيعية) / حميض ترسي, حميض فرنسي (نبات معمر منخفض بأوراق بيضاوية إلى رمحية صغيرة خضراء فضية)",
 "garden spade": "مجرفة الحديقة (مجرفة يستخدمها البستانيون)",
 "garden spider": "عنكبوت الحديقة (عنكبوت شائع في الحدائق الأوروبية)",
 "garden stater": "نيوجيرسي (مواطن أو مقيم في نيو جيرسي)",
 "garden strawberry": "شليك, فراولة الحديقة (تزرع على نطاق واسع)",
 "garden symphilid": "مئوية أرجل الحدائق (مفصلي دقيق يصيب غالباً الأجزاء الموجودة تحت الأرض من محاصيل الحدائق والدفيئات)",
 "garden tool": "أداة بستنة, أداة حديقة (أداة تستخدم للعمل في الحدائق أو الساحات)",
 "garden trowel": "مجرفة يدوية, مسطرين الحديقة (مجرفة صغيرة يستخدمها البستانيون)",
 "garden truck": "خضراوات وفواكه, منتجات زراعية (فواكه وخضراوات طازجة تزرع من أجل السوق)",
 "garden violet": "بنفسج الحديقة, بنفسج عطري (بنفسج أوروبي يتميز عادة بزهور أرجوانية إلى بيضاء؛ متوطن على نطاق واسع)",
 "garden webworm": "دودة ويب الحدائق",
 "gardener": "بُسْتَانِيّ, بُسْتَانِيَّة",
 "gardener's delight": "قرنفل البوصير, ليخنيس إكليلي (نبات حديقة قديم في جنوب شرق أوروبا يزرع على نطاق واسع لأوراقه الصوفية البيضاء الجذابة وزهوره القرمزية المبهرجة)",
 "gardener's garters": "عشب الشريط, عشب القصب الكناري (عشب معمر في مروج المستنقعات والخنادق له أوراق عريضة؛ أوروبا وأمريكا الشمالية)",
 "gardenia": "غاردينيا (أي من الشجيرات والأشجار الصغيرة المتنوعة من جنس غاردينيا لها زهور بيضاء أو صفراء عطرة كبيرة)",
 "gardenia augusta": "غاردينيا, ياسمين الكاب (شجيرة دائمة الخضرة تزرع على نطاق واسع لزهورها البيضاء الشمعية العطرة الكبيرة وأوراقها اللامعة)",
 "gardenia jasminoides": "غاردينيا, ياسمين الكاب (شجيرة دائمة الخضرة تزرع على نطاق واسع لزهورها البيضاء الشمعية العطرة الكبيرة وأوراقها اللامعة)",
 "gardening": "بَسْتَنَة",
 "gardening knife": "سكين بستنة (أي سكين يستخدم في البستنة)",
 "garfield": "غَارْفِيلْد",
 "garfish": "خرم, سمكة الرمح (سمكة بدائية مفترسة في أمريكا الشمالية مغطاة بقشور صلبة ولها فكوك طويلة بأسنان تشبه الإبر)",
 "garganey": "شَرْشِير صَيْفِيّ",
 "gargantuan": "جَسِيم, عِمْلَاق (ذو كتلة عظيمة؛ ضخم وثقيل)",
 "garget": "توت الحمام, صبغة أمريكية (عشبة أمريكية معمرة طويلة خشنة ذات أزهار بيضاء صغيرة تليها توت أسود محمر على عناقيد متدلية طويلة؛ السيقان اللحمية الصغيرة صالحة للأكل؛ التوت والجذر…)",
 "gargle": "تَمَضْمَضَ, غَرْغَرَ / سَائِل الْغَرْغَرَة",
 "gargoyle": "مزراب (جرغول) (زخرفة تتكون من شكل منحوت بشكل غريب لشخص أو حيوان) / جرغول, مزراب (فوهة تنتهي بشكل تمثال بشري أو حيواني منحوت بشكل غريب)",
 "gargoylism": "متلازمة هيرلر (مرض وراثي (متنحي) يتمثل في خطأ في استقلاب عديدات السكاريد المخاطية؛ يتميز بتشوهات شديدة في تطور الغضروف الهيكلي والعظام والتخلف العقلي)",
 "garhwal": "گڑھوال",
 "gari": "بفرة, كسافا مرة (كسافا ذات جذور درنية طويلة صالحة للأكل وسيقان هشة ناعمة؛ تستخدم خاصة لصنع الكاسيري (مشروب مسكر) والتابيوكا)",
 "garibaldi": "بلوزة غاريبالدي (بلوزة فضفاضة عالية الرقبة بأكمام طويلة؛ صممت على غرار القمصان الفلانيل الحمراء التي ارتداها جنود غاريبالدي)",
 "garish": "صَارِخ, مُبَهْرَج (بَرَّاقٌ وَلَافِتٌ بِطَرِيقَةٍ تَفْتَقِرُ إِلَى الذَّوْق)",
 "garishly": "ببهرجة, بشكل فاقع (بطريقة مبهرجة وتفتقر إلى الذوق)\nمثال: تم تزيين المعبد ببهرجة بزهور بلاستيكية زاهية",
 "garishness": "بهرجة, صخب لوني (لون صارخ أو زخرفة مفرطة) / بَهْرَجَة, زَخْرَفَة صَارِخَة (الاستعراض المبتذل عديم الذوق)",
 "garland": "إكليل (تنسيق زهور يتكون من شريط دائري من أوراق الشجر أو الزهور لأغراض الزينة) / مقتطفات أدبية (أنثولوجيا من القطع الأدبية القصيرة والقصائد والبالاد وما إلى ذلك)",
 "garland crab": "تفاح بري أمريكي (شجرة متوسطة الحجم من شرق الولايات المتحدة لها أزهار وردية وفاكهة صفراء صغيرة)",
 "garland flower": "دفنة, زهرة الإكليل (شجيرة منخفضة دائمة الخضرة تزرع على نطاق واسع بعناقيد كثيفة من الزهور الوردية العطرة إلى الوردية العميقة)",
 "garlic": "ثُوم, ثُومَة",
 "garlic bread": "خُبْز بِالثُّوم (هو طعام يصنع من الدَقِيق الذي يعجن بالماء والخَمِيرَة ويُخْبَز في الفُرْن أو التَنُّور؛ خُبْز الغُراب: الفِطْر، ويسمى أيضا عُشّ الغُرَاب)\nمثال: هذا الخبز لذيذ.",
 "garlic butter": "زبدة الثوم (زبدة متبلة بالثوم المهروس)",
 "garlic chive": "ثوم معمر صيني (أوراق مسطحة كبيرة تستخدم كما يستخدم الثوم المعمر) / ثوم معمر صيني, كراث صيني (نبات من شرق آسيا؛ أكبر من الثوم المعمر)",
 "garlic clove": "فص ثوم (أحد البصيلات الصغيرة التي يمكن فصلها عن محور بصلة ثوم أكبر)",
 "garlic mustard": "ثوم السياج, خردل الثوم (عشبة أوروبية تفوح منها رائحة الثوم)",
 "garlic press": "هراسة الثوم",
 "garlic salt": "ملح الثوم (ثوم مجفف مطحون وملح)",
 "garlic sauce": "أيولي, صلصة الثوم (مايونيز بالثوم)",
 "garlicky": "ثومي (متعلق بـ أو له طعم أو رائحة الثوم)\nمثال: صلصة ثومية",
 "garment": "لِبَاس, مَلَابِس (الزِيّ أو بعض الثياب تُلْبَس مع بعض لا جمع له؛ ما يُلْبَس من الثياب، الجمع ألْبِسَة)\nمثال: أحسن زيري اللباس.",
 "garment bag": "حقيبة ملابس, غطاء بدلة (حقيبة سفر تُفرد لتعليق الملابس بداخلها)",
 "garment cutter": "فصّال, قاطع الملابس (شخص يقص القماش وما إلى ذلك حسب المقاس لصنع الملابس)",
 "garment industry": "صناعة الملابس, قطاع الأزياء (صناع وبائعو الملابس العصرية)",
 "garment worker": "خياط, صانع ملابس (شخص يصنع الملابس)",
 "garment-worker": "خياط, صانع ملابس (شخص يصنع الملابس)",
 "garmented": "مُتَأَنِّق, مُرْتَدٍ (يرتدي ملابس خاصة أنيقة؛ تستخدم غالباً في التركيب)",
 "garmentless": "بِلَا ثِيَاب (لا يملك أي ملابس)",
 "garmentmaker": "خياط, صانع ملابس (شخص يصنع الملابس)",
 "garner": "صومعة, مخزن حبوب (مستودع للحبوب المدروسة أو علف الحيوانات)",
 "garnet": "بِجَادِيّ",
 "garnet lac": "لك العقيق (لك مكرر بالمعالجة بالمذيب؛ لونه عقيقي)",
 "garnet-colored": "عَقِيقِيّ اللَّوْن (بلون العقيق الأحمر الداكن)",
 "garnet-coloured": "عَقِيقِيّ اللَّوْن (بلون العقيق الأحمر الداكن)",
 "garnierite": "غارنيريت (معدن أخضر يتكون من سيليكات النيكل والمغنيسيوم المائية؛ مصدر للنيكل)",
 "garnish": "زَيَّن, زَخْرَف (في : تعني الحسن أي الوسيم، وتعني أيضا الشيء الرائع) / زَيَّن (في : تعني الحسن أي الوسيم، وتعني أيضا الشيء الرائع)\nمثال: زين سامي المكتب.",
 "garnishee": "محجوز لديه (كاسب أجر يتم إبلاغه بأمر حجز على الراتب)",
 "garnishment": "أمر حجز على الأجور (أمر محكمة لصاحب عمل باقتطاع كل أو جزء من أجر الموظف وإرسال المال إلى المحكمة أو للشخص الذي كسب دعوى قضائية ضد الموظف)",
 "garotte": "طوق حديدي, مخنق (أداة إعدام للإعدام عن طريق الخنق)",
 "garpike": "خرم, سمكة الرمح (سمكة بدائية مفترسة في أمريكا الشمالية مغطاة بقشور صلبة ولها فكوك طويلة بأسنان تشبه الإبر)",
 "garret": "علية, غرفة السطح (طابق يتكون من مساحة مفتوحة في أعلى المنزل أسفل السقف مباشرة؛ تستخدم غالباً للتخزين)",
 "garrison": "حَامِيَة",
 "garrison cap": "قبعة عسكرية جانبية (قبعة صوفية أو قطنية على شكل إسفين؛ تلبس كجزء من الزي الرسمي)",
 "garrote": "طوق حديدي, مخنق (أداة إعدام للإعدام عن طريق الخنق)",
 "garroter": "خانِق (شخص يقتل عن طريق الخنق)",
 "garrotte": "طوق حديدي, مخنق (أداة إعدام للإعدام عن طريق الخنق)",
 "garrotter": "خانِق (شخص يقتل عن طريق الخنق)",
 "garrulity": "ثرثرة (صفة الإطناب وكثرة الكلام)",
 "garrulous": "ثَرْثَار, كَثِير الكَلَام (مليء بالأحاديث التافهة)",
 "garrulously": "بإسهاب, بثرثرة (بطريقة ثرثارة)\nمثال: تابعت بثرثرة: عندما كنت شابة، اعتدت أن أفعل كل أنواع الأشياء المشاغبة",
 "garrulousness": "ثرثرة (صفة الإطناب وكثرة الكلام)",
 "garrulus glandarius": "قيق أوروبي شائع (قيق لونه أسمر مصفر ذو عرف أسود وأبيض وأجنحة زرقاء وسوداء)",
 "garry oak": "سنديان أوريغون الأبيض, سنديان غاري (شجرة نفضية صغيرة موطنها غرب أمريكا الشمالية ذات فروع ملتوية ولحاء رمادي شاحب)",
 "garshuni": "كرشوني",
 "garter": "رباط جورب, مشد (شريط (عادة مطاطي) يرتدى حول الساق لتثبيت الجورب (أو حول الذراع لتثبيت الكم))",
 "garter belt": "حزام جوارب (حزام عريض من المطاط تتدلى منه أشرطة؛ ترتديه النساء لتثبيت الجوارب)",
 "garter snake": "غَرْطَر",
 "garter stitch": "غرزة المرنة (غرزة حياكة تنتج نمطاً من التلال الأفقية تتشكل بحياكة كلا الجانبين (بدلاً من قلب جانب واحد))",
 "gartner's bacillus": "سالمونيلا معوية, عصوية غارتنر (شكل من أشكال السالمونيلا يسبب التهاب المعدة والأمعاء لدى البشر)",
