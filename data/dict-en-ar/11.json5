 "fulminate of mercury": "فلمينات الزئبق (فلمينات تنفجر بعنف عندما تكون جافة إذا ضُربت أو سُخنت؛ تستخدم في الصواعق وأغطية التفجير)",
 "fulminating mercury": "فلمينات الزئبق (فلمينات تنفجر بعنف عندما تكون جافة إذا ضُربت أو سُخنت؛ تستخدم في الصواعق وأغطية التفجير)",
 "fulmination": "انفجار شديد (عملية الانفجار بضجيج وعنف) / تهجم لاذع, هجوم عنيف (هجوم لفظي صاعق)\nمثال: انفجاراته الشديدة أخافت الخيول",
 "fulminic acid": "حمض الفلمينيك (أصبح حامضًا، تغير الطعم إلى الحموضة؛ ارتفعت نسبة الحموضة في شيء ما، كما في الطعام أو السوائل)\nمثال: رمى ياني الحمض على وجه سكورة.",
 "fulsome": "لَزِج, مُتَمَلِّق بِكَرَاهَة (مُبَالِغ فِي اللُّطْف بِشَكْل مُنَفِّر وَبَغِيض)",
 "fulsomely": "بتملق, بنفاق (بطريقة متملقة)",
 "fulsomeness": "تملق, مداهنة (الجدية المفتعلة المليئة بالرضا عن الذات والتملق لخدمة المصالح الشخصية) / تملق لزج, نفاق (مجاملات مفرطة ولكن سطحية تُعطى بسحر متصنع)",
 "fulvic acid": "حمض الفولفيك (مادة دبالية صفراء إلى بنية صفراء قابلة للذوبان في الماء تحت جميع ظروف الأس الهيدروجيني)",
 "fulvicin": "غريسيوفولفين, فولفيسين (نوع من البنسلين (مضاد حيوي مبيد للفطريات بالاسم التجاري فولفيسين) تنتجه قوالب من جنس البنسليوم)",
 "fumaria claviculata": "كورداليس متسلق (نبات متسلق حولي بأوراق مركبة وعناقيد من الزهور الصفراء والوردية)",
 "fumaria fungosa": "أدلوميا, شاهترج متسلق (نبات متسلق بأوراق ريشية وأزهار بيضاء أو وردية؛ يوضع أحياناً في جنس الشاهترج)",
 "fumaria officinalis": "بقلة الملك, دخانية (عشب أوروبي رقيق بأوراق رمادية وسنابل من الزهور الأرجوانية؛ كان يستخدم طبياً سابقاً)",
 "fumaric acid": "حمض الفوماريك (حمض بلوري عديم اللون ذو طعم فاكهي؛ يُستخدم في صنع راتنجات البوليستر)",
 "fumble": "إفلات الكرة ((رياضة) إسقاط الكرة)",
 "fumbler": "أخرق, فاشل (شخص يرتكب أخطاء بسبب عدم الكفاءة)",
 "fumbling": "أَخْرَق, غَيْرُ كُفْء (يُظهر افتقارًا إلى المهارة أو الكفاءة)",
 "fume": "إِسْتِشَاط غَضَبًا, ثَار",
 "fumed": "مُبَخَّرٌ ((للخشب) قُتِّم لونه بالتعرض لأبخرة الأمونيا)",
 "fumed oak": "بلوط مدخن (بلوط مُعطى مظهراً قديماً عن طريق التعرض لأبخرة الأمونيا؛ يستخدم للخزائن)",
 "fumeroot": "بقلة الملك, دخانية (عشب أوروبي رقيق بأوراق رمادية وسنابل من الزهور الأرجوانية؛ كان يستخدم طبياً سابقاً)",
 "fumes": "أبخرة العادم, عادم (غازات منبعثة من محرك كمنتجات نفايات)",
 "fumewort": "بقلة الملك, دخانية (عشب أوروبي رقيق بأوراق رمادية وسنابل من الزهور الأرجوانية؛ كان يستخدم طبياً سابقاً)",
 "fumigant": "مادة تبخير, مبيد تبخيري (مادة كيميائية تستخدم في التبخير)",
 "fumigation": "تبخير, تعقيم بالدخان (تطبيق غاز أو دخان على شيء لغرض تطهيره)",
 "fumigator": "جهاز تبخير, مبخرة (جهاز يولد غازاً لغرض التطهير أو القضاء على الآفات) / عامل تبخير, مُبَخِّر (شخص وظيفته القيام بعملية التبخير (للتطهير أو القضاء على الحشرات))",
 "fumitory": "بَقْلَة الْمَلَك, شَاهْتَرَج",
 "fun": "مَرَح, تَرْفِيه / مَرِح, مُسَلٍّ",
 "fun run": "جري خيري, سباق ترفيهي (سباق جري للمتعة (غالباً ما يشمل عدائين يتم رعايتهم لجمعية خيرية))",
 "funafuti": "فُونَافُوتِي",
 "funambulism": "المشي على الحبل (المشي على حبل مشدود أو حبل مرتخٍ)",
 "funambulist": "سائر على الحبل المشدود (بهلوان يؤدي عروضاً على حبل مشدود أو حبل مرتخٍ)",
 "function": "وَظِيفَة (ما يُقَدَّر من الشيء في زمن مُعَيَّن؛ مَنْصِب) / مَهَمَّة / دَالَّة, تَابِع / وَظِيفَة, دَالَّة (ما يُقَدَّر من الشيء في زمن مُعَيَّن؛ مَنْصِب)\nمثال: ما وظيفة زوجتك؟",
 "function call": "استدعاء دالة (استدعاء يمرر التحكم إلى روتين فرعي؛ وبعد تنفيذ الروتين الفرعي يعود التحكم إلى التعليمة التالية في البرنامج الرئيسي)",
 "function word": "كَلِمَة وَظِيفِيَّة (الكلِمَةُ : اللفظةُ الدَّالةُ على معنًى مُفْرَد بالوضع، وتكون؛ الكلِمَةُ: الكلامُ المؤلَّفُ المطوَّل، قصيدةً، أَو خُطْبَةً، أَو مقالةً، أَو رسالة)\nمثال: كلمة السر طويلة.",
 "functional": "عملي, وظيفي (مصمم لـ أو قادر على أداء وظيفة أو استخدام معين) / شَغَّال, عَامِل ((عَنِ الآلَات مَثَلًا) يَعْمَلُ أَوْ قَادِر عَلَى العَمَل) / وظيفي (يتعلق بالوظيفة أو يؤثر عليها بدلاً من علم وظائف الأعضاء (الفسيولوجيا)) / وَظِيفِيّ (مصمم لوظيفة معينة أو مكيَّف لاستخدام محدد)\nمثال: أسلوب في الكتابة تكون فيه كل كلمة وظيفية",
 "functional anatomy": "تشريح وظيفي (دراسة التشريح في علاقته بالوظيفة)",
 "functional calculus": "حساب المحمولات (نظام للمنطق الرمزي يمثل الأفراد والمحمولات والتكميم على الأفراد (وكذلك العلاقات بين القضايا))",
 "functional disorder": "اضطراب وظيفي (اضطراب يظهر أعراضاً لا يمكن تحديد سبب فسيولوجي أو تشريحي لها)",
 "functional genomics": "جينوم وظيفي (فرع علم الجينوم الذي يحدد الوظيفة البيولوجية للجينات ومنتجاتها)",
 "functional group": "مجموعة وظيفية (مؤنث مَجْمُوع وهو اسم مفعول من جَمَعَ؛ الطَائِفَة أو الجَمَاعَة من الناس)\nمثال: شكرا لإضافتي للمجموعة.",
 "functional illiterate": "أمي وظيفياً (شخص لديه قدرة محدودة على القراءة والكتابة ولكنها غير كافية للاحتياجات العملية اليومية)",
 "functional magnetic resonance imaging": "رنين مغناطيسي وظيفي (شكل من أشكال التصوير بالرنين المغناطيسي للدماغ يسجل تدفق الدم إلى المناطق العاملة في الدماغ)",
 "functionalism": "وظيفية (أي مذهب يركز على المنفعة أو الغرض) / وظيفية (علم نفس يقوم على افتراض أن جميع العمليات العقلية مفيدة للكائن الحي في التكيف مع البيئة)",
 "functionalist": "وظيفي (مؤيد للوظيفية)",
 "functionality": "عَمَلِيَّة, وَظِيفِيَّة (القدرة على خدمة غرض ما بشكل جيد)\nمثال: برمجيات ذات وظيفية أكبر",
 "functionally": "وظيفياً (فيما يتعلق بالوظيفة أو الأداء)\nمثال: الوحدتان مترابطتان وظيفياً",
 "functionally illiterate": "أُمِّيّ وَظِيفِيًّا (لا يَمْلِك مَهارات قِراءَة وَكِتابَة كافِيَة لِلحَياة اليَوْمِيَّة)",
 "functionary": "مسؤول, موظف رسمي (عامل يشغل منصباً أو مكلفاً بمكتب)",
 "functioning": "شغال, عامل (يؤدي أو قادر على أداء وظيفته العادية) / أداء, تشغيل (عملية أو طريقة العمل أو التشغيل)\nمثال: مصباح يدوي شغال",
 "fund": "ذَخِيرَة / مَوَّل",
 "fund-raising campaign": "حملة جمع تبرعات (حملة لجمع المال لقضية ما)",
 "fund-raising drive": "حملة جمع تبرعات (حملة لجمع المال لقضية ما)",
 "fund-raising effort": "حملة جمع تبرعات (حملة لجمع المال لقضية ما)",
 "fundament": "أساس (أدنى دعامة لهيكل ما) / أرداف, ألية (الجزء اللحمي من جسم الإنسان الذي يجلس عليه) / أساس, حجر الزاوية (الافتراضات الأساسية التي يبدأ منها شيء ما أو يتطور أو يُحسب أو يُشرح)\nمثال: بُني على أساس من الصخر الصلب",
 "fundamental": "أَسَاسِيّ",
 "fundamental analysis": "تحليل أساسي ((سوق الأوراق المالية) استخدام الأساسيات كاستراتيجية استثمار)",
 "fundamental frequency": "تردد أساسي, نغمة أساسية (أدنى نغمة في سلسلة توافقية)",
 "fundamental interaction": "تفاعل, تفاعل أساسي ((في الفيزياء) نقل الطاقة بين الجسيمات الأولية أو بين جسيم أولي ومجال أو بين المجالات؛ يتوسطه بوزونات قياس)",
 "fundamental law": "دستور, قانون أساسي (قانون يحدد المبادئ السياسية الأساسية للحكومة)",
 "fundamental measure": "كَمِّيَّة أَسَاسِيَّة, مِقْيَاس أَسَاسِيّ (إحدى الكمّيّات الأربع التي تُشكِّل أساس أنظمة القياس)",
 "fundamental particle": "جُسَيْم أَوَّلِيّ ((فيزياء) جسيم أقل تعقيداً من الذرة؛ يعتبر من مكونات كل المواد)",
 "fundamental principle": "أساسيات, مبادئ أساسية (مبادئ يمكن استنتاج حقائق أخرى منها)\nمثال: أولاً يجب أن تتعلم الأساسيات",
 "fundamental quantity": "كَمِّيَّة أَسَاسِيَّة, مِقْيَاس أَسَاسِيّ (إحدى الكمّيّات الأربع التي تُشكِّل أساس أنظمة القياس)",
 "fundamentalism": "أُصُولِيَّة",
 "fundamentalist": "أُصُولِيّ",
 "fundamentalistic": "أصولي (من أو يتعلق بالأصولية البروتستانتية أو أتباعها أو يتميز بها) / أصولي (من أو يتعلق بالأصولية الأيديولوجية أو يميل إليها)",
 "fundamentally": "أساساً, جوهرياً (في الجوهر؛ في الأصل أو بحكم الطبيعة)\nمثال: هو في الأساس غير صادق",
 "fundamentalness": "أساسية, جوهرية (حالة أو شرط كون الشيء أساسياً؛ أهمية جوهرية)\nمثال: في مستوى مماثل من الجوهرية أو 'الاتساع' تكمن مسألة ما إذا كان ينبغي تبني استراتيجيات صريحة مقابل سرية",
 "fundamentals": "أساسيات, مبادئ أساسية (مبادئ يمكن استنتاج حقائق أخرى منها)\nمثال: أولاً يجب أن تتعلم الأساسيات",
 "fundamentals analysis": "تحليل أساسي ((سوق الأوراق المالية) استخدام الأساسيات كاستراتيجية استثمار)",
 "funday": "يوم المرح (يوم الأحد كيوم للاسترخاء والاستمتاع)",
 "funded": "ممول (مزود بالأموال)\nمثال: بحث ممول جيداً",
 "funding": "تمويل (عملية التمويل) / تمويل, دعم مالي (الموارد المالية المقدمة لجعل مشروع ما ممكناً)\nمثال: قدمت المؤسسة الدعم للتجربة",
 "fundraiser": "حفل خيري, حملة جمع تبرعات (حدث اجتماعي يُقام لغرض جمع الأموال) / جامع تبرعات (شخص يطلب مساهمات مالية)",
 "funds": "أموال, موارد مالية (أصول في شكل مال)",
 "fundulus heteroclitus": "مومي تشوج (سمكة كيلي فضية وسوداء تعيش في مستنقعات المياه المالحة على طول ساحل المحيط الأطلسي للولايات المتحدة)",
 "fundulus majalis": "سمكة كيلي المخططة, سمكة مايو (سمكة مخططة بالأسود تعيش في الخلجان والمستنقعات الساحلية للمحيط الأطلسي وساحل الخليج في الولايات المتحدة)",
 "fundus": "قَاع ((في التشريح) قاعدة عضو مجوف أو الجزء الأبعد من فتحة العضو)\nمثال: قاع الرحم",
 "funeral": "جَنَازَة, دَفْن (مراسم تقام لتشييع وفاة شخص)\nمثال: \"أنا ذاهب إلى جنازة.\" \"من توفي؟\"",
 "funeral chapel": "دار الجنازة, صالة العزاء (مبنى جنائزي حيث يمكن لمن عرفوا المتوفى الحضور لتقديم احترامهم الأخير)",
 "funeral church": "دار الجنازة, صالة العزاء (مبنى جنائزي حيث يمكن لمن عرفوا المتوفى الحضور لتقديم احترامهم الأخير)",
 "funeral director": "حفار قبور, متعهد دفن الموتى (شخص عمله إدارة الجنازات)",
 "funeral home": "دار الجنازة, صالة العزاء (مبنى جنائزي حيث يمكن لمن عرفوا المتوفى الحضور لتقديم احترامهم الأخير)",
 "funeral march": "مارش جنائزي (مارش بطيء يُعزف للجنازات)",
 "funeral parlor": "دار الجنازة, صالة العزاء (مبنى جنائزي حيث يمكن لمن عرفوا المتوفى الحضور لتقديم احترامهم الأخير)",
 "funeral parlour": "دار الجنازة, صالة العزاء (مبنى جنائزي حيث يمكن لمن عرفوا المتوفى الحضور لتقديم احترامهم الأخير)",
 "funeral pyre": "كومة الحرق, محرقة الجثث (خشب مكدس لحرق جثة الميت كطقس جنائزي)",
 "funeral undertaker": "حفار قبور, متعهد دفن الموتى (شخص عمله إدارة الجنازات)",
 "funeral-residence": "دار الجنازة, صالة العزاء (مبنى جنائزي حيث يمكن لمن عرفوا المتوفى الحضور لتقديم احترامهم الأخير)",
 "funerary": "جنائزي (من أو لأجل أو يتعلق بالجنازة)\nمثال: جرة جنائزية",
 "funereal": "جَنَائِزِيّ, قَبْرِيّ (يلائم القبر أو الدفن أو يوحي بهما)",
 "funfair": "كرنفال, مدينة ملاهي متنقلة (عرض متنقل؛ يحتوي على عروض جانبية وألعاب ركوب وألعاب مهارة) / متنزه ترفيهي, مدينة ملاهي (متنزه يدار تجارياً ويضم أكشاكاً وعروضاً للترفيه)",
 "fungal": "فطري (متعلق بالفطريات)",
 "fungal infection": "عدوى فطرية, فطار (حالة التهابية تسببها الفطريات)",
 "fungibility": "تَبَادُلِيَّة, قَابِلِيَّة لِلتَّبَادُل (صفة القابلية للاستبدال أو التبادل)",
 "fungible": "قَابِل لِلمُقَايَضَة, مِثْلِيّ (عن السلع أو البضائع؛ يمكن مبادلته أو استبداله بمثيل من نفس النوع وفاءً لالتزام) / سلع قابلة للاستبدال, سلع مثلية (سلعة يمكن استبدالها بحرية بأخرى للوفاء بالتزام ما)",
 "fungicidal": "مبيد للفطريات, مضاد للفطريات (قادر على تدمير الفطريات)",
 "fungicide": "مبيد فطريات, مضاد للفطريات (أي عامل يقضي على الفطريات أو يمنع نموها)",
 "fungoid": "شبيه بالفطر, فطراني (يشبه الفطريات)",
 "fungous": "فطري (متعلق بالفطريات)",
 "fungus": "فُطْر ( مَا تَفَطَّر مِنَ النَّبَاتِ، والفُطْر جِنْسٌ مِنَ الكَمْءِ أَبيض عِظَامٌ لأَن الأَرض تَنْفطر عَنْهُ؛  في هو اسم يطلق على طائفة من اللازهريات خالية من الكلوروفيل منها فصائل وأَجناس وأَنواع عديدة وتسمى أيضًا فُطْريّات، منها ما يُؤْكَلُ، وما هو سامٌ…)\nمثال: وجدت بعض الفطر.",
 "fungus family": "فصيلة فطرية (تشمل فصائل الأشنات)",
 "fungus genus": "جنس فطري (يشمل أجناس الأشنات)",
 "fungus gnat": "بعوضة الفطر (حشرة تشبه البعوض تتغذى يرقاتها على الفطريات أو النباتات المتحللة) / بعوضة الفطر السوداء, سيارا (ذباب دقيق مسود اجتماعي مدمر للفطر والشتلات)",
 "fungus order": "رتبة فطرية (رتبة من الفطريات)",
 "funguslike": "شبيه بالفطر, فطراني (يشبه الفطريات)",
 "funicle": "حبل سري (ساق بويضة أو بذرة النبات)",
 "funicular": "سِكَّة حَدِيد مُعَلَّقَة, سِكَّة حَدِيد وَتَرِيَّة",
 "funicular railway": "سكة حديد بالكابلات, قطار جبلي مائل (سكة حديد صاعدة على جانب جبل يتم سحبها بواسطة كابل متحرك ولها عربات صاعدة وهابطة متوازنة)",
 "funiculitis": "التهاب الحبل (التهاب الحبل (خاصة التهاب الحبل المنوي))",
 "funiculus": "حبل, حزمة (أي من عدة تراكيب جسدية تشبه الحبل) / حبل سري (ساق بويضة أو بذرة النبات)",
 "funk": "فانك (نوع ترابي من الجاز يجمعه مع البلوز والسول؛ له خط باص ثقيل يبرز النبرة الأولى في المازورة) / خوف واكتئاب, وجوم (حالة من الاكتئاب العصبي)\nمثال: كان في حالة وجوم",
 "funk hole": "مخبأ (خندق كمكان للتراجع الآمن (عند الخوف))",
 "funkiness": "تميز, طرافة ((عامية) خاصية كون الشيء أصلياً، غير تقليدي، أو غريب الأطوار)\nمثال: لدينا مجموعة متنوعة من خطوط الملابس لنمط حياة نشط وغير رسمي، مع قليل من الطرافة المضافة!",
 "funky": "خَائِف, مَذْعُور (فِي حَالَة خَوْفٍ جَبَان) / أَنِيقٌ بِطَرِيقَةٍ غَيْرِ تَقْلِيدِيَّة, عَصْرِيّ (أَنِيقٌ وَعَصْرِيٌّ بِأُسْلُوبٍ غَيْرِ مَأْلُوف) / بِلُوزِيّ, رُوحَانِيّ ((في الجاز) ذو إحساس روحاني يشبه البلوز القديم) / زَنِخ, مُنْتِن (ذُو رَائِحَةٍ كَرِيهَةٍ بِشَكْلٍ مُؤْذٍ)",
 "funnel": "قِمْع",
 "funnel shape": "شكل قمعي, قمع (شكل مخروطي بفتحة واسعة وأخرى ضيقة عند الطرفين)",
 "funnel web": "شبكة قمعية (شبكة عنكبوت على شكل قمع؛ يجلس العنكبوت في وسط الشبكة)",
 "funnel-crest rosebud orchid": "أوركيد برعم الورد قمعي العرف, بوجونيا منتشرة (أوركيد في شمال شرق الولايات المتحدة بزهور وردية أرجوانية ذات شفة قمعية الشكل؛ يوضع أحياناً في جنس بوجونيا)",
 "funnel-shaped": "قُمْعِيّ الشَّكْل (على شكل قِمع)",
 "funnies": "شَرِيط مُصَوَّر, قِصَّة مُصَوَّرَة (سلسلة من الرسومات تحكي قصة في صحيفة أو كتاب هزلي)",
 "funnily": "بشكل عجيب, بغرابة (بطريقة غريبة)\nمثال: ورقة مكتوبة بغرابة",
 "funniness": "طَرَافَة, مَوْقِف هَزْلِيّ (حادث هزلي أو سلسلة من الحوادث)",
 "funny": "مُضْحِك, هَزْلِيّ",
 "funny bone": "العظم المجنون, عصب الكوع (نقطة على الكوع حيث يمر العصب الزندي بالقرب من السطح؛ ينتج إحساس بالوخز الحاد عند ارتطام العصب بالعظم)",
 "funny farm": "مارستان, مستشفى المجانين (مصطلحات تحقيرية لمصحة المجانين)",
 "funny house": "مارستان, مستشفى المجانين (مصطلحات تحقيرية لمصحة المجانين)",
 "funny remark": "قِصَّة مُضْحِكَة, مَوْقِف طَرِيف (رواية لحادث مسلٍ (عادة مع جملة ختامية مضحكة))\nمثال: روت قصة مضحكة",
 "funny story": "قِصَّة مُضْحِكَة, مَوْقِف طَرِيف (رواية لحادث مسلٍ (عادة مع جملة ختامية مضحكة))\nمثال: روت قصة مضحكة",
 "funny wagon": "سيارة نقل المرضى النفسيين (سيارة إسعاف تستخدم لنقل المرضى إلى مستشفى الأمراض العقلية)",
 "funrun": "جري خيري, سباق ترفيهي (سباق جري للمتعة (غالباً ما يشمل عدائين يتم رعايتهم لجمعية خيرية))",
 "fur": "فَرْو / مِعْطَف, ثَوْبٌ مُفَرًّى / فَرَّى",
 "fur coat": "معطف فرو (معطف مصنوع من الفرو)",
 "fur hat": "قبعة فرو (قبعة مصنوعة من الفرو)",
 "fur seal": "فقمة الفراء (فقمة ذات أذنين تعيش في نصف الكرة الجنوبي؛ فراؤها السفلي الناعم الكثيف هو مصدر جلد الفقمة) / فقمة الفراء الشمالية (فقمة ذات أذنين تعيش في شمال المحيط الهادئ)\nمثال: ذكر فقمة الفراء أكبر بكثير من الأنثى",
 "fur-bearing": "ذُو فِرَاء ((عن الحيوانات) يمتلك فراءً (خاصة ذا جودة تجارية))",
 "fur-piece": "قطعة فرو للعنق (قطعة للرقبة مصنوعة من الفرو)",
 "furan": "فوران (سائل سام عديم اللون قابل للاشتعال يستخدم في تخليق النايلون)",
 "furane": "فوران (سائل سام عديم اللون قابل للاشتعال يستخدم في تخليق النايلون)",
 "furbelow": "كشكشة, هدب (شريط من القماش المثني يُستخدم كزينة أو حاشية)",
 "furcation": "تفرع (المكان الذي ينقسم فيه الشيء إلى فروع)",
 "furcula": "عظم الشوكة, عظم الفريقة (عظم متشعب يتكون من اندماج الترقوتين في معظم الطيور)",
 "furfural": "فورفورال (ألديهيد سائل ذو رائحة نفاذة؛ يصنع من قشور النباتات وكوالح الذرة؛ يستخدم في صنع الفوران وكمذيب)",
 "furfuraldehyde": "فورفورال (ألديهيد سائل ذو رائحة نفاذة؛ يصنع من قشور النباتات وكوالح الذرة؛ يستخدم في صنع الفوران وكمذيب)",
 "furfuran": "فوران (سائل سام عديم اللون قابل للاشتعال يستخدم في تخليق النايلون)",
 "furigana": "فُورِيغَانَا",
 "furious": "ثَائِر, مُسْتَشِيط (يتّسم بغضب شديد بالغ الحدّة) / عَاتٍ, هَائِج ((عَنِ العَنَاصِر الطَّبِيعِيَّة) كَأَنَّهُ يُظْهِر غَضَبًا عَنِيفًا) / شَرِس, ضَارٍ (يَتَّسِمُ بِطَاقَةٍ بَالِغَةِ العُنْفِ وَالشِّدَّة)",
 "furiously": "بِعُنْف, بِهَوَج ((عن العناصر الطبيعية) بطريقة جامحة وعاصفة) / بِحَنَق, بِغَضَب شَدِيد (بطريقة تعبر عن غضب شديد أو انفعال) / بِجُنُون, بِحَمَاسَة شَدِيدَة (بطريقة تتميز بطاقة قصوى أو عنيفة)\nمثال: كانت الرياح تهب بهوج",
 "furiousness": "ضراوة, عنف (خاصية كون الشيء جامحاً أو مضطرباً)\nمثال: عنف العاصفة",
 "furket": "ركيزة المسكيت, مسند البندقية (عمود متشعب، طوله حوالي أربعة أقدام، يستخدم كدعامة لبنادق المسكيت)",
 "furled": "مَطْوِيّ, مَلْفُوف (ملفوف ومُثبَّت)",
 "furlike": "شَبِيه بِالفَرْو (يشبه الفرو في ملمسه ومظهره)",
 "furlong": "فرلنغ",
 "furlough": "إجازة عسكرية (إجازة مؤقتة من الخدمة العسكرية)",
 "furnace": "فرن (حجرة مغلقة يتم فيها إنتاج الحرارة لتدفئة المباني، أو تدمير النفايات، أو صهر الخامات وتنقيتها، وما إلى ذلك)",
 "furnace lining": "بطانة الفرن, مادة حرارية (بطانة تتكون من مادة ذات نقطة انصهار عالية؛ تستخدم لتبطين الجدران الداخلية للفرن)",
 "furnace room": "غرفة الفرن (غرفة (عادة في قبو المبنى) تحتوي على فرن لتدفئة المبنى)",
 "furnish": "أْثَث ((أَثَّثَ): لين ومهد؛ (أَثَّثَ) البيت: فرشه بالأثاث)",
 "furnished": "مؤثث, مفروش (مزود بما هو ضروري لغرض ما (مثل الأثاث أو المعدات أو السلطة))\nمثال: شقة مفروشة",
 "furnishing": "تأثيث (عملية تزويد منزل أو غرفة بالأثاث وغيرها من العناصر القابلة للإزالة مثل الرفوف والسجاد والأجهزة، إلخ) / أثاث منزلي, تجهيزات منزلية (الوسائل (الأثاث والأجهزة والملحقات المنقولة الأخرى بما في ذلك الستائر والسجاد) التي تجعل المنزل (أو أي منطقة أخرى) صالحة للعيش) / توابع ملابس, لوازم زينة ((عادة بصيغة الجمع) ملحقات الملابس الثانوية)",
 "furniture": "أَثَاث, مَفْرُوشَات (الرياش والمتاع وما يوضع للاستخدام للجلوس أو النوم أو حفظ المتاع أو غيره داخل البيت أو خارجه؛ الرياش والمتاع بما فيها المال والملابس)\nمثال: يصنع قطعة أثاث خشبية.",
 "furniture beetle": "خُنْفُسَاء الْأَثَاثِ",
 "furniture company": "شركة أثاث (شركة تبيع الأثاث)",
 "furniture maker": "صانع الأثاث, صانع الخزائن (نجار متخصص في صنع الأثاث)",
 "furor": "ثورة غضب, هياج (فورة مفاجئة (كما في الاحتجاج)) / بدعة, صرعة (اهتمام يُتبع بحماس مبالغ فيه)\nمثال: يتبع دائماً أحدث الصرعات",
 "furore": "ثورة غضب, هياج (فورة مفاجئة (كما في الاحتجاج)) / بدعة, صرعة (اهتمام يُتبع بحماس مبالغ فيه)\nمثال: يتبع دائماً أحدث الصرعات",
 "furosemide": "فوروسيميد, لازيكس (مدر للبول شائع الاستخدام (الاسم التجاري لازيكس) يستخدم لعلاج ارتفاع ضغط الدم والوذمة)",
 "furred": "ذُو فَرْو, فَرْوِيّ (مغطى بطبقة كثيفة من الشعر الحريري الناعم)",
 "furrier": "صانع عباءات, فرّاء (شخص مهنته صنع أو إصلاح الملابس المصنوعة من الفراء)",
 "furring": "شريحة تسوية (شريط يستخدم لإعطاء سطح مستو لربط ألواح الحائط) / تغشية (طبقة تشبه الفراء من مادة ما كما على اللسان)",
 "furring strip": "شريحة تسوية (شريط يستخدم لإعطاء سطح مستو لربط ألواح الحائط)",
 "furrow": "ثَلْم (ثلَم الإناءَ: كسر حرفَه؛ ثلَم الحائطَ: أحدث خلل أو شقّ في الحائط)",
 "furrowed": "متجعد, مخدد (به انخفاضات ضحلة ضيقة طويلة (كالأخاديد أو التجاعيد) في السطح)\nمثال: حقول محروثة",
 "furry": "فَرْوِيّ, مُفَرَّى",
 "furry tongue": "لسان مشعر (أثر جانبي حميد لبعض المضادات الحيوية؛ فرط نمو داكن لحليمات اللسان)",
 "fursuit": "بدلة فرو, زي حيوان (بدلة حيوان تغطي كامل الجسم)",
 "further": "أَبْعَد, أَقْصَى (جعله بَعيدًا؛ جَاوَزَ الحَدَّ)\nمثال: أبعد صورتها عني.",
 "furtherance": "ترويج, تعزيز (النهوض بمشروع ما) / ترويج, تعزيز (تشجيع تقدم أو نمو أو قبول شيء ما)\nمثال: أدت خبرته في التسويق إلى تعزيز مسيرته المهنية",
 "furthermore": "عِلَاوَة عَلَى ذٰلِكَ, أَضِف إِلَى ذٰلِك",
 "furthermost": "أَبْعَد, أَقْصَى (الأكثر بُعداً في المكان أو الزمان أو الترتيب)",
 "furthest": "الأبعد, الأقصى (إلى أقصى مسافة في المكان أو الزمان) / الأبعد, الأقصى (إلى أقصى درجة أو مدى أو مرحلة متقدمة) / أَبْعَد, أَقْصَى (الأكثر بُعداً في المكان أو الزمان أو الترتيب)\nمثال: انظر من يستطيع القفز لأبعد مسافة",
 "furtive": "مَاكِر, مُسْتَرَق",
 "furtively": "خلسة, سراً (بطريقة خفية)\nمثال: كان الجنود يزحفون خلسة عبر الليل",
 "furtiveness": "تستر, خفية (الميل لكون المرء ماكراً ومتستراً والقيام بالأشياء خلسة)",
 "furuncle": "خراج, دمل (قرحة مؤلمة ذات لب صلب مملوء بالقيح)",
 "furunculosis": "داء الدمامل (مرض جلدي حاد يتميز بوجود العديد من الدمامل)",
 "fury": "حَنَق, غَيْظ ((حَنِقَ) عَلَيْهِ حنقا: اشْتَدَّ غيظه فَهُوَ حنق وحنيق) / حَنِق, مُغْتَاظ ((حَنِقَ) عَلَيْهِ حنقا: اشْتَدَّ غيظه فَهُوَ حنق وحنيق)",
 "furze": "جولق, وزال (شجيرة دائمة الخضرة شائكة وكثيفة جداً ذات زهور صفراء ذهبية عطرة؛ شائعة في جميع أنحاء أوروبا الغربية)",
 "fusain": "فحم رسم, قلم فحم (عصا من مادة كربونية سوداء تستخدم للرسم)",
 "fusanus acuminatus": "خوخ الصحراء, كواندونغ (شجرة أسترالية ذات لب صالح للأكل وبذرة تشبه الجوز صالحة للأكل)",
 "fusarium wilt": "ذبول فيوزاريومي (ذبول تسببه فطريات من جنس الفيوزاريوم)",
 "fuscoboletinus paluster": "فوسكوبوليتينوس بالوستر (فطر صالح للأكل بقبعة وساق وردية أرجوانية وسطح مسامي أصفر بمسام زاوية كبيرة تصبح مثل الخياشيم عند النضج)",
 "fuscoboletinus serotinus": "فوسكوبوليتينوس سيروتينوس (فطر صالح للأكل بقبعة بنية محدبة عريضة وسطح مسامي وساق مبيض)",
 "fuscous": "رَمَادِيّ بُنِّيّ دَاكِن (بلون بني رمادي معتم)",
 "fuse": "فَتِيل / مُنْصَهِرَة, مصهر",
 "fuse indicator regulator": "ضابط الصمام (أداة تضبط وقت الصمام على المقذوفات ذات الصمامات الزمنية الميكانيكية)",
 "fuse setter": "ضابط الصمام (أداة تضبط وقت الصمام على المقذوفات ذات الصمامات الزمنية الميكانيكية)",
 "fused": "مُنْدَمِج, مُوَحَّد (اندمج في كلّ واحد متكامل)",
 "fusee": "بادئ إشعال, فتيل (أي مشعل يستخدم لبدء حرق الوقود الدافع) / عود ثقاب مقاوم للرياح (عود ثقاب احتكاكي برأس كبير يظل مشتعلاً في الرياح) / شعلة تحذير (شعلة ملونة تستخدم كإشارة تحذير من قبل الشاحنات والقطارات) / فيوزي, محرك فيوزي (عمود دوران ذو أخدود حلزوني في الساعة يعمل على موازنة القوة المتناقصة للنابض الرئيسي أثناء انبساطه)",
 "fusee drive": "فيوزي, محرك فيوزي (عمود دوران ذو أخدود حلزوني في الساعة يعمل على موازنة القوة المتناقصة للنابض الرئيسي أثناء انبساطه)",
 "fusel oil": "زيت الفوسل (خليط من كحولات الأميل والبروبانول والبيوتانول يتكون من تقطير المشروبات المخمرة)",
 "fuselage": "جِسْم طَائِرَة, جِسْم (شيء مادي؛ جسد الإنسان أو الحيوان)\nمثال: الحليب مفيد للجسم.",
 "fusha": "الْفُصْحَى, اللُّغَة الْعَرَبِيَّة الْفُصْحَى",
 "fushun": "فُوشُون",
 "fusible": "قَابِلٌ لِلذَّوَبَان, قَابِلٌ لِلِانْصِهَار (يُمْكِنُ صَهْرُهُ وَدَمْجُهُ بِالحَرَارَة)",
 "fusible metal": "سبيكة سهلة الانصهار, معدن صهور (سبيكة ذات نقطة انصهار منخفضة وتستخدم كلحام وفي سدادات الأمان وصمامات الرشاشات)",
 "fusiform": "مِغْزَلِيّ",
 "fusil": "بندقية فتيل خفيفة (بندقية مسكيت خفيفة بقفل صوان)",
 "fusilier": "جندي بندقية, فوزيلير ((سابقاً) جندي مشاة بريطاني مسلح ببندقية ذات قادح صوان خفيفة)",
 "fusillade": "رشقة, صلية (إطلاق نار سريع ومتزامن للأسلحة النارية)\nمثال: فاجأتهم رشقنا من الجناح الأيسر",
 "fusion": "اِنْدِمَاج / ذَوَبَان (تحول الجامد إلى سائل) / اِتِّحَاد (اِتِّحَاد؛ الاتِّحاد الأوربيّ : (السياسة) اتِّحاد أوربيّ إقليميّ أنشئ بمقتضى معاهدة ماستريخت في عام 1993 م…)\nمثال: عاش الاتحاد السوفيتي!",
 "fusion bomb": "قنبلة هيدروجينية (سلاح نووي يطلق طاقة ذرية عن طريق اتحاد نوى خفيفة (هيدروجين) عند درجات حرارة عالية لتكوين الهيليوم)",
 "fusion cooking": "طبخ فيوجن, طهي مدمج (الطهي الذي يجمع بين المكونات والتقنيات والتوابل من مطابخ مختلفة)",
 "fusion reactor": "مفاعل اندماجي, مفاعل نووي حراري (مفاعل نووي يستخدم الاندماج النووي المتحكم فيه لتوليد الطاقة)",
 "fusional language": "لغة اندماجية (نوع من اللغات التركيبية حيث يمكن للمورفيمات الفردية أن تنقل أجزاء متعددة من المعلومات)",
 "fuss": "صخب, ضجة (اضطراب نشط وسريع) / مشاجرة تافهة, ملاحاة (شجار حول نقاط تافهة) / إزعاج, جلبة (اضطراب غاضب) / اضطراب, حيرة (حالة من الهياج المثار)\nمثال: لم يرد إثارة جلبة",
 "fuss-budget": "دائم التوتر, كثير القلق (شخص يفكر دائماً في الأشياء المؤسفة التي قد تحدث)",
