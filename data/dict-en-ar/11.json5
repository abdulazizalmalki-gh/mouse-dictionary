 "german measles": "حصبة ألمانية (مرض فيروسي معدٍ هو شكل أخف من الحصبة يستمر ثلاثة أو أربعة أيام؛ يمكن أن يضر بالجنين خلال الأشهر الثلاثة الأولى)",
 "german millet": "دخن ألماني, دخن العجب الذهبي (دخن بحبوب صفراء في سنابل كبيرة متدلية)",
 "german monetary unit": "وحدة نقدية ألمانية (الوحدة النقدية في ألمانيا)",
 "german nazi": "نازي (عضو ألماني في حزب أدولف هتلر السياسي)",
 "german pancake": "بان كيك ألماني (خليط بيض منتفخ خفيف الحلاوة بنكهة الليمون مرشوش بسكر الحلواني ويقدم مع المربى أو صلصة النبيذ أو الفاكهة)",
 "german police dog": "كلب الراعي الألماني (سلالة من كلاب الرعي الكبيرة تستخدم في أعمال الشرطة وكدليل للمكفوفين)",
 "german rampion": "زهرة الربيع المسائية الشائعة (نبات ثنائي الحول خشن من شرق أمريكا الشمالية بأزهار صفراء تتفتح في المساء؛ متوطن في أوروبا)",
 "german shepherd": "كَلْب راعٍ أَلْمَانِيّ (بمعنى ضربهُ بالكُلاب أو جعل لها كَلْبًا؛ سَيْر أحمر يُجعَل بين طرفي الأديم إذا خُرِز)\nمثال: كان الكلب ميتا.",
 "german shepherd dog": "كلب الراعي الألماني (سلالة من كلاب الرعي الكبيرة تستخدم في أعمال الشرطة وكدليل للمكفوفين)",
 "german short-haired pointer": "بوينتر ألماني قصير الشعر (كلب صيد كبدي اللون أو كبدي وأبيض تم تطويره في ألمانيا؛ 3/4 بوينتر و 1/4 بلودهاوند)",
 "german silver": "فضة ألمانية, فضة النيكل (سبيكة بيضاء فضية تحتوي على النحاس والزنك والنيكل)",
 "german tamarisk": "أثل ألماني, أثل كاذب (شجيرة أوراسية تشبه الأثل)",
 "german-american": "ألماني أمريكي (متعلق بالأمريكيين من أصل ألماني أو مميز لهم)",
 "german-speaking": "نَاطِقٌ بِالأَلْمَانِيَّة (قادر على التواصل باللغة الألمانية)",
 "germander": "جَعْدَة",
 "germander speedwell": "زهرة الحواشي الجعدية, عين الطائر (نبات من العالم القديم بعناقيد إبطية من الزهور الزرقاء والبيضاء)",
 "germaneness": "وَثَاقَة الصِّلَة (الملاءمة بحكم وجود علاقة وثيقة بالموضوع المطروح)",
 "germanic": "الجِرْمَانِيَّة",
 "germanic language": "اللغات الجرمانية (فرع من عائلة اللغات الهندية الأوروبية؛ تنقسم اللغات التي يتم التحدث بها حاليًا إلى مجموعتين رئيسيتين: الإسكندنافية والجرمانية الغربية)",
