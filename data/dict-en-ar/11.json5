 "glib": "فَصِيح, لَبِق (بارع في الإقناع بسلاسة الكلام) / بَرَّاق, سَطْحِيّ (ذو معقولية سطحية فقط) / طَلِق اللِّسَان سَطْحِيًّا (يتّسم بافتقار العمق الفكري)",
 "glib-tongued": "فَصِيح, لَبِق (بارع في الإقناع بسلاسة الكلام)",
 "glibly": "بِتَمَلُّق, بِلَبَاقَة مُصْطَنَعَة (بمعقولية سطحية)\nمثال: تحدث بطلاقة سطحية",
 "glibness": "زلاقة لسان, لباقة سطحية (نوع من السطحية السلسة والطلقة)\nمثال: زلاقة لسان بائع لحوح",
 "glide": "طيران شراعي (نشاط الطيران بطائرة شراعية) / انزلاق (فعل التحرك بسلاسة على سطح مع البقاء ملامساً له) / شبه صائت, نصف حركة (صوت يشبه الصائت يعمل كصامت)\nمثال: لم يتوقف انزلاقه حتى أسفل التل",
 "glide path": "مسار الاقتراب, مسار الانزلاق (المسار النهائي الذي تتبعه الطائرة أثناء هبوطها)",
 "glide slope": "مسار الاقتراب, مسار الانزلاق (المسار النهائي الذي تتبعه الطائرة أثناء هبوطها)",
 "glider": "طائرة شراعية (مَرْكَبَة كبيرة لها جناحان وتنقل الرُكَّاب والبَضَائِع بالجَوّ. ؛ كل من تَطِير، مؤنث طائر)\nمثال: لقد وصلت الطائرة.",
 "gliding": "طيران شراعي (نشاط الطيران بطائرة شراعية)",
 "gliding bacteria": "بكتيريا مخاطية, ميكسوبكتيريا (بكتيريا تشكل مستعمرات في مادة لزجة تنتجها ذاتياً؛ تعيش في التربة الرطبة أو المواد النباتية المتحللة أو فضلات الحيوانات)",
 "gliding joint": "مفصل انزلاقي, مفصل مسطح (مفصل حر الحركة تسمح فيه التمفصلات بحركات انزلاقية فقط)",
 "gliese 581": "غْلِيزَا ٥٨١",
 "glimmer": "إحساس مبهم, تلميح (اقتراح طفيف أو فهم غامض) / بريق خافت, بصيص (وميض من الضوء (خاصة الضوء المنعكس))\nمثال: لم يكن لديه أي فكرة عما كان على وشك الحدوث",
 "glimmer of hope": "بصيص الأمل",
 "glimmering": "إحساس مبهم, تلميح (اقتراح طفيف أو فهم غامض)\nمثال: لم يكن لديه أي فكرة عما كان على وشك الحدوث",
 "glimmery": "خَافِت اللَّمَعَان, وَامِض بِرِفْق (يَلْمَع بِنُعُومَةٍ وبِشَكْلٍ مُتَقَطِّع)",
 "glimpse": "لمحة, نظرة خاطفة (نظرة سريعة) / لمحة, نظرة خاطفة (رؤية موجزة أو غير كاملة) / لمحة (إشارة غامضة)\nمثال: من النافذة استطاع أن يلمح البحيرة لمحة سريعة",
 "glint": "بريق خاطف, لمعة (سطوع موضعي مكانياً) / بريق, شرارة (وميض ضوئي لحظي)",
 "glinting": "بَرَّاق, مُتَلَأْلِئ (ذُو وَمَضَاتٍ قَصِيرَةٍ وبَرَّاقَة مِنَ الضَّوْء)",
 "glioblastoma": "ورم أرومي دبقي (ورم دماغي خبيث سريع النمو يتكون من أرومات إسفنجية؛ قاتل تقريبًا دائمًا)",
 "glioma": "ورم دبقي (ورم في الدماغ يتكون من الخلايا الدبقية)",
 "glipizide": "غلوكوترول, غليبيزيد (دواء فموي مضاد للسكري (الاسم التجاري غلوكوترول) يحفز إفراز الأنسولين من البنكرياس)",
 "gliricidia": "جليريسيديا (أي من الأشجار النفضية الصغيرة المتعددة ذات القيمة لخشبها الداكن وعناقيدها الكثيفة من الزهور الوردية الغنية بالرحيق التي تنمو بغزارة على الفروع…)",
 "glis glis": "زغبة سمينة (زغبة أوروبية كبيرة)",
 "glissade": "انزلاق ((باليه) خطوة انزلاقية في الباليه)",
 "glissando": "زلقاً, غليساندو ((توجيه موسيقي) بأسلوب الغليساندو (سلسلة سريعة من النغمات المتصلة)) / تزحلق موسيقي, جليساندو (سلسلة سريعة من النغمات الصاعدة أو الهابطة على السلم الموسيقي)\nمثال: يجب عزف هذا بأسلوب الغليساندو، من فضلك",
 "glisten": "لَمَعَ (لمع أي أصدر ضَوْءً أو عَكَسَهُ)",
 "glistening": "بَرَّاق, لَمَّاع (يَعْكِس الضَّوْء)",
 "glister": "بريق, تألق (صفة اللمعان بضوء منعكس ساطع)",
 "glistering": "بَرَّاق, مُتَلَأْلِئ (ذُو وَمَضَاتٍ قَصِيرَةٍ وبَرَّاقَة مِنَ الضَّوْء)",
 "glitch": "بق, خطأ برمجي (خطأ أو عيب في برنامج حاسوبي أو نظام أو آلة)",
 "glitter": "لَمَعَ, بَرَقَ (لمع أي أصدر ضَوْءً أو عَكَسَهُ)",
 "glittering": "بَرَّاق, مُتَلَأْلِئ (ذُو وَمَضَاتٍ قَصِيرَةٍ وبَرَّاقَة مِنَ الضَّوْء)",
 "glittery": "بَرَّاق, مُتَلَأْلِئ (ذُو وَمَضَاتٍ قَصِيرَةٍ وبَرَّاقَة مِنَ الضَّوْء)",
 "glitz": "بَهْرَجَة, زَخْرَفَة صَارِخَة (الاستعراض المبتذل عديم الذوق)",
 "gloam": "أصيل, شفق (الوقت من اليوم الذي يلي غروب الشمس مباشرة)\nمثال: كان يحب الشفق",
 "gloaming": "أصيل, شفق (الوقت من اليوم الذي يلي غروب الشمس مباشرة)\nمثال: كان يحب الشفق",
