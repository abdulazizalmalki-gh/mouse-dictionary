 "food grain": "حبوب, غلال (مادة غذائية محضرة من الحبوب النشوية للأعشاب الحقلية)",
 "food hamper": "سلة طعام (سلة لتعبئة ونقل الطعام)",
 "food manufacturer": "مصنع أغذية (شخص يقوم بتصنيع المنتجات الغذائية)",
 "food market": "بقالة, متجر بقالة (سوق تباع فيه مواد البقالة)\nمثال: تضمن متجر البقالة سوقاً للحوم",
 "food poisoning": "اضطراب معوي, تسمم غذائي (مرض ناتج عن طعام سام أو ملوث)",
 "food processor": "محضر طعام (جهاز مطبخ ذو شفرات قابلة للتبديل؛ يُستخدم لبشر أو خلط أو فرم أو تقطيع الطعام)",
 "food product": "مادة غذائية, منتج غذائي (مادة يمكن استخدامها أو تحضيرها للاستخدام كطعام)",
 "food pyramid": "هرم غذائي ((في البيئة) تسلسل هرمي للسلاسل الغذائية مع وجود المفترس الرئيسي في القمة؛ حيث يفترس كل مستوى المستوى الذي يليه)",
 "food shop": "ديلي, مطعم مأكولات جاهزة (متجر يبيع منتجات غذائية جاهزة للأكل)",
 "food stamp": "طابع غذاء, قسيمة طعام (طابع تصدره الحكومة يمكن استخدامه مقابل الطعام)",
 "food truck": "شَاحِنَةُ طَعَام (اسم فاعل مؤنث من الفعل \"شَحَنَ\"؛ أي عربة أو سيارة تُستخدم للشحن أو النقل)\nمثال: انقلبت الشاحنة.",
 "food turner": "مقلب طعام, ملعقة تقليب (أداة طهي لها جزء مرن مسطح ومقبض طويل؛ تستخدم لقلب أو تقديم الطعام)",
 "food waste": "قمامة, نفايات الطعام (طعام يتم التخلص منه (كما هو الحال من المطبخ))",
 "food web": "شبكة غذائية",
 "foodgasm": "نشوة الطعام (شعور شديد بالمتعة ناتج عن رؤية الطعام)",
 "foodie": "ذواقة, محب للطعام (شخص مكرس للاستمتاع الحسي المترف (خاصة الطعام والشراب الجيد))",
 "foodless": "بِلَا طَعَام, فَاقِد الغِذَاء (يفتقر إلى الطعام تمامًا)",
 "foodstuff": "بقالة, مواد غذائية (سلع استهلاكية تباع عند البقال) / مادة غذائية, منتج غذائي (مادة يمكن استخدامها أو تحضيرها للاستخدام كطعام)",
 "fool": "مُغَفَّل, أَحْمَق",
 "fool's cap": "قبعة المغفلين (قبعة ورقية مخروطية الشكل كانت توضع سابقاً على رأس التلاميذ البطيئين أو الكسالى)",
 "fool's errand": "سعي عبثي, مهمة حمقاء (مهمة غير مثمرة)",
 "fool's gold": "بايرايت الحديد, بايريت (معدن شائع (ثنائي كبريتيد الحديد) لونه أصفر شاحب)",
 "fool's huckleberry": "أزاليا كاذبة, توت الأحمق (شجيرة متناثرة من شمال غرب أمريكا الشمالية ذات أوراق بمسحة مزرقة وخيمات من الزهور الصغيرة على شكل جرس)",
 "fool's mate": "كش مات المغفل, مات النقلتين",
 "fool's paradise": "جنة الحمقى, نعيم زائف (حالة وهمية من الرفاهية)",
 "fool's parsley": "بقدونس الأحمق, شوكران صغير (عشب أوروبي ضار استوطن أمريكا يشبه البقدونس ولكنه يسبب الغثيان والتسمم عند تناوله)",
 "foolery": "حماقة, طيش (سلوك أحمق أو لا معنى له)",
 "foolhardiness": "تهور, طيش (سمة إيلاء القليل من التفكير للخطر)",
 "foolhardy": "طَائِش, مُتَهَوِّر (يتسم بتجاهل متحدٍّ للخطر أو العواقب)",
 "fooling": "خِيَانَة",
 "foolish": "أَحْمَق, غَبِيّ (مُغَفَّل، أَبْلَه، طَائِش)\nمثال: قبلني ايها الأحمق.",
 "foolish woman": "ثرثارة, حمقاء (أنثى حمقاء)",
 "foolishly": "بحماقة, بغباء (دون حس سليم أو حكم جيد)\nمثال: تصرف بحماقة عندما وافق على المجيء",
 "foolishness": "حَمَاقَة (خطأ سخيف)",
 "foolproof": "مُحْكَمَة (مقام الحاكم. وغلبت على مقام الحاكم الشرعي أي القاضي)\nمثال: عاد إلى المحكمة.",
 "foolscap": "ورق فولسكاب (حجم ورق يستخدم خاصة في بريطانيا)",
 "foot": "رِجْل (العُضْو في جسد الإنسان يتكون من القَدَم والسَاق والفُخْذ. الجمع أرجُل، وقد تقول العامّة رِجْلين ورجْلينات؛ القَدَم من باب اطلاق اسم الكل على الجزء) / قَدَم (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى الرُّسْغَ؛ أنّ لهم سابقةً وفضلاً له عند فلان قَدَمٌ : معروف) / قدم (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى الرُّسْغَ؛ أنّ لهم سابقةً وفضلاً له عند فلان قَدَمٌ : معروف) / رجل (العُضْو في جسد الإنسان يتكون من القَدَم والسَاق والفُخْذ. الجمع أرجُل، وقد تقول العامّة رِجْلين ورجْلينات؛ القَدَم من باب اطلاق اسم الكل على الجزء) / ريل\nمثال: هذا الرجل تاجر.",
 "foot brake": "فرامل القدم (مكبح هيدروليكي يتم تشغيله بالضغط على دواسة القدم)",
 "foot doctor": "أخصائي أقدام, طبيب أقدام (أخصائي في العناية بالقدمين)",
 "foot file": "حجر خفاف, مبرد قدم (أداة تستخدم لفرك الجلد الميت من باطن القدمين)",
 "foot joint": "وصلة القدم (في الناي) (وصلة القدم هي القسم الأخير من الأقسام الثلاثة للناي الموسيقي الغربي)\nمثال: تحتوي آلة الناي الموسيقية على ثلاثة أجزاء: وصلة الرأس، والجسم، ووصلة القدم",
 "foot lever": "دواسة (رافعة يتم تشغيلها بالقدم)",
 "foot pedal": "دواسة (رافعة يتم تشغيلها بالقدم)",
 "foot race": "سباق جري, عدو (سباق يتم الجري فيه على الأقدام)\nمثال: حطمت الرقم القياسي في سباق النصف ميل",
 "foot rot": "تعفن القدم (عدوى تنكسية معدية لأقدام الحيوانات ذات الحوافر) / عفن القدم (مرض نباتي يتعفن فيه الساق أو الجذع عند القاعدة)",
 "foot rule": "مسطرة قدم (مسطرة طولها قدم واحد)",
 "foot soldier": "جندي مشاة, سائر (شخص يقاتل سيراً على الأقدام بأسلحة خفيفة) / تابع, مرؤوس (مساعد خاضع لسلطة أو سيطرة آخر)",
 "foot traffic": "حركة المشاة (الأشخاص القادمون والذاهبون سيرًا على الأقدام)",
 "foot-and-mouth disease": "حَمَّى قُلَاعِيَّة (حمَى الشيءُ فلانًا: منَعه ودفع عنه؛ حمى المريضَ: منعه ما يضره)\nمثال: ليس لديك أي حمى.",
