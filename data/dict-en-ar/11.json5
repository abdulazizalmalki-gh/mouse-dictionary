 "gerris lacustris": "بق الماء الشائع (نوع من بق الماء)",
 "gerrymander": "تلاعب بحدود الدوائر الانتخابية (فعل التلاعب بالدوائر (تقسيم منطقة التصويت لإعطاء حزبك ميزة غير عادلة))",
 "gerund": "صِيغَةُ فِعْل, مَصْدَر",
 "gerundial": "مصدري",
 "geryon": "جيريون ((الأساطير اليونانية) وحش أسطوري بثلاثة رؤوس قتله هرقل)",
