{
 "flying robin": "غرنار طائر (سمكة استوائية ذات زعانف صدرية ضخمة تشبه المروحة للانزلاق تحت الماء؛ لا ترتبط بأسماك الروبن البحرية)",
 "flying saucer": "طَبَق طَائِر (جَعَلَ شيئًا يغطي شيئًا آخر بشكل كامل؛ نفَّذَ أمرًا أو خطةً عمليةً)\nمثال: هذا الطبق لذيذ.",
 "flying school": "مدرسة طيران (مدرسة لتعليم الطلاب قيادة الطائرات)",
 "flying spaghetti monster": "وحش السباجيتي الطائر (حَيْوَان غير مستأنس يعيش بعيدا عن الناس، وهي أصل الكلمة؛ حيوان مُفْتَرِس)\nمثال: ضرب زيري الوحش.",
 "flying squad": "فرقة التدخل السريع, فرقة طيارة (مجموعة متنقلة من الأشخاص المدربين (شرطة أو مديرين تنفيذيين أو مسؤولين) قادرة على التحرك بسرعة في حالات الطوارئ)",
 "flying squirrel": "بوسوم طائر, سنجاب طائر (بوسوم ليلي يتحرك بقفزات انزلاقية باستخدام طيات جلدية تشبه المظلة على طول جانبي الجسم)",
 "flying start": "انطلاقة قوية, بداية سريعة (بداية سريعة ومبشرة) / انطلاق طائر (بداية سباق يكون فيها المتسابقون في حركة كاملة بالفعل عندما يتجاوزون خط البداية)",
 "flying visit": "زِيَارَة خَاطِفَة, زِيَارَة سَرِيعَة (زيارة تستمر لفترة قصيرة جداً)\nمثال: أراد سماع كل شيء عن زيارتي الخاطفة لأماكن سكنه القديمة",
 "flyleaf": "الورقة الحرة, بطانة الغلاف (ورقة فارغة في مقدمة أو مؤخرة الكتاب)",
 "flyover": "تحليق استعراضي منخفض (طيران على ارتفاع منخفض (عادة لطائرات عسكرية) فوق المتفرجين على الأرض) / جسر علوي (جسر يتشكل من المستوى العلوي لتقاطع طريقين سريعين على مستويات مختلفة)",
 "flypaper": "ورق صائد الذباب (ورق مسمم أو مطلي بمادة لزجة لقتل الذباب)",
 "flypast": "تحليق استعراضي منخفض (طيران على ارتفاع منخفض (عادة لطائرات عسكرية) فوق المتفرجين على الأرض)",
 "flyspeck": "دَقِيق, زَهِيد (صغير جداً) / نقطة صغيرة, وسخ الذباب (بقعة داكنة صغيرة ناتجة عن فضلات ذبابة)",
 "flyswat": "مضرب الذباب, منشة ذباب (أداة ذات جزء مسطح (من شبكة أو بلاستيك) ومقبض طويل؛ تستخدم لقتل الحشرات)",
 "flyswatter": "مضرب الذباب, منشة ذباب (أداة ذات جزء مسطح (من شبكة أو بلاستيك) ومقبض طويل؛ تستخدم لقتل الحشرات)",
 "flytrap": "مصيدة ذباب (فخ لصيد الذباب)",
 "flyway": "مسار الهجرة (الطريق الجغرافي الذي تهاجر الطيور على طوله عادة)",
 "flyweight": "وزن الذبابة (ملاكم هاوٍ لا يزيد وزنه عن 112 رطلاً (حوالي 51 كجم)) / وزن الذبابة (مصارع لا يزيد وزنه عن 115 رطلاً) / وزن الذبابة (فئة وزن في الرياضات القتالية، وغالباً ما تكون الأخف)",
 "flywheel": "حَدَّافَة",
 "fm": "تضمين التردد (تضمين تردد الموجة الحاملة (للراديو)) / فيرميوم (عنصر فلزي مشع ما بعد اليورانيوم يتم إنتاجه بقصف البلوتونيوم بالنيوترونات)",
 "fmri": "رنين مغناطيسي وظيفي (شكل من أشكال التصوير بالرنين المغناطيسي للدماغ يسجل تدفق الدم إلى المناطق العاملة في الدماغ)",
 "fnma": "الجمعية الفيدرالية الوطنية للرهن العقاري, فاني ماي (مؤسسة مرخصة فيدرالياً تشتري الرهون العقارية)",
 "fo": "ضابط ميداني (ضابط يحمل رتبة رائد أو مقدم أو عقيد)",
 "fo'c'sle": "عنبر البحارة (أماكن معيشة تتكون من بنية فوقية في مقدمة السفينة التجارية حيث يتم إيواء الطاقم)",
 "foal": "مُهْر, فِلْو",
 "foam": "رَغْوَة / زَبَد (هو السَمْن الموجود في الحَلِيب يستخرج بأن يُخَضّ الحليب خَضا مستمرا حتى يتكتل بداخله) / زَبَد البَحْر (هو السَمْن الموجود في الحَلِيب يستخرج بأن يُخَضّ الحليب خَضا مستمرا حتى يتكتل بداخله)\nمثال: اشترت رطلي زبدة.",
 "foam bath": "رغوة الحمام (مستحضر بلوري أو مسحوق أو سائل يُرغي في ماء الاستحمام ويعطره وينعمه)",
 "foam glass": "زجاج خلوي, زجاج رغوي (زجاج خفيف ومعتم يحتوي على خلايا هوائية، يُصنع بإضافة مسحوق الكربون إلى الزجاج المسحوق وحرق الخليط)\nمثال: يستخدم الزجاج الخلوي للعزل",
 "foam rubber": "مطاط رغوي (مطاط إسفنجي؛ يصنع بإدخال فقاعات الهواء قبل الفلكنة ويستخدم للتبطين أو التنجيد)",
 "foamed concrete": "خرسانة خلوية, خرسانة رغوية (نوع من الخرسانة المهواة مع إضافة عامل تهوية (أو ركام خفيف الوزن مثل ركام الطين الممدد أو حبيبات الفلين والفيرميكوليت))\nمثال: لا تخلط بين الخرسانة الخلوية والخرسانة المهواة المعالجة بالأوتوكلاف، والتي يتم تصنيعها خارج الموقع باستخدام طريقة مختلفة تماماً",
 "foamflower": "تياريلا قلبية الأوراق, زهرة الرغوة (نبات غابات رئدي أبيض الزهر يزهر في الربيع)",
 "foaminess": "رغوية (خاصية الرغوة)",
 "foaming": "رَغْوِيّ, مُزْبِد (يُنْتِج أو يُغَطّى بِرَغْوَة مِن العَرَق أو اللُّعاب بِسَبَب الإرْهاق أو المَرَض) / رَغْوِيّ, فَقَّاعِيّ (يُصدر فقاعات أو مليء بها كما في المشروبات الغازيّة أو التخمير)",
 "foaming bath": "رغوة الحمام (مستحضر بلوري أو مسحوق أو سائل يُرغي في ماء الاستحمام ويعطره وينعمه)",
 "foamy": "رَغْوِيّ, مُزْبِد (يُنْتِج أو يُغَطّى بِرَغْوَة مِن العَرَق أو اللُّعاب بِسَبَب الإرْهاق أو المَرَض) / رَغْوِيّ, فَقَّاعِيّ (يُصدر فقاعات أو مليء بها كما في المشروبات الغازيّة أو التخمير)",
 "fob": "سلسلة الساعة (سلسلة قصيرة أو شريط يربط ساعة الجيب بصدرية الرجل) / دلاية الساعة, سلسلة الساعة (زينة تتدلى من سلسلة الساعة) / جيب ساعة (جيب في الصدرية مخصص لحمل ساعة الجيب)",
 "focal": "بُؤْرِيّ (يقع أو يتركّز عند البؤرة) / بؤري (متعلق بالبؤرة)\nمثال: البعد البؤري",
 "focal distance": "بُعْد بُؤْرِيّ, مَسَافَة بُؤْرِيَّة (المسافة من العدسة إلى بؤرتها)",
 "focal epilepsy": "صرع بؤري, صرع قشري (صرع تبدأ نوباته باضطراب معزول في وظيفة الدماغ (مثل ارتعاش في طرف أو إحساس وهمي أو اضطراب عقلي))",
 "focal infection": "عدوى بؤرية (عدوى بكتيرية تقتصر على عضو أو منطقة معينة تسبب أعراضاً في أماكن أخرى)",
 "focal length": "بُعْد بُؤْرِيّ, مَسَافَة بُؤْرِيَّة (المسافة من العدسة إلى بؤرتها)",
 "focal point": "بؤرة, تركيز (تركيز الانتباه أو الطاقة على شيء ما) / بؤرة, نقطة التجمع (نقطة التقاء الضوء (أو أي إشعاع آخر) أو النقطة التي ينبعث منها) / بؤرة, بؤرة الإصابة (نقطة مركزية أو موضع العدوى في كائن حي)\nمثال: تحول محور النشاط إلى البيولوجيا الجزيئية",
 "focal ratio": "النِّسْبَة البُؤْرِيَّة, رَقَم البُؤْرَة (نسبة البعد البؤري إلى قطر نظام عدسة (الكاميرا))",
 "focal seizure": "نوبة بؤرية (اضطراب عابر في الوظيفة الحركية أو الحسية ناتج عن نشاط قشري غير طبيعي)",
 "focalisation": "تبيؤر, تركيز البؤرة (عملية وضع الشيء في البؤرة) / تبؤر, تمركز (حصر العدوى في منطقة محدودة)",
 "focalization": "تبيؤر, تركيز البؤرة (عملية وضع الشيء في البؤرة) / تبؤر, تمركز (حصر العدوى في منطقة محدودة)",
 "focally": "بؤرياً (بطريقة بؤرية)\nمثال: تم تسلل الطبقة تحت المخاطية بؤرياً",
 "focus": "بُؤْرَة",
 "focused": "مَضْبُوط البُؤْرَة ((لنظام بصريّ) مُعدَّل لإنتاج صورة واضحة) / مُجَمَّع, مُرَكَّز ((عَنِ الأَشِعَّةِ الضَّوْئِيَّة) تَتَلَاقَى عِنْدَ نُقْطَةٍ وَاحِدَة) / في البؤرة, مبأر (كائن في بؤرة التركيز أو تم وضعه في البؤرة (للصورة أو العدسة))",
 "focusing": "تبيؤر, تركيز البؤرة (عملية وضع الشيء في البؤرة) / بؤرة, تركيز (تركيز الانتباه أو الطاقة على شيء ما)\nمثال: تحول محور النشاط إلى البيولوجيا الجزيئية",
 "focussed": "مُجَمَّع, مُرَكَّز ((عَنِ الأَشِعَّةِ الضَّوْئِيَّة) تَتَلَاقَى عِنْدَ نُقْطَةٍ وَاحِدَة) / في البؤرة, مبأر (كائن في بؤرة التركيز أو تم وضعه في البؤرة (للصورة أو العدسة))",
 "focussing": "بؤرة, تركيز (تركيز الانتباه أو الطاقة على شيء ما)\nمثال: تحول محور النشاط إلى البيولوجيا الجزيئية",
 "fodder": "عَلَف",
 "foe": "عدو (خصم مسلح (خاصة عضو في قوة عسكرية معادية)) / خصم, عدو (عدو شخصي)\nمثال: يجب أن يكون الجندي مستعداً لقتل أعدائه",
 "foehn": "رياح الفون, فون (رياح دافئة وجافة تهب أسفل المنحدرات الشمالية لجبال الألب)",
 "foeman": "خصم, عدو (خصم مسلح ذكر (خاصة عضو في قوة عسكرية معادية))",
 "foeniculum dulce": "شمر حلو, شمر فلورنسا (يزرع خاصة لقاعدة ساقه البصلية العطرية الصالحة للأكل)",
 "foeniculum vulgare": "بسباس, شمر (نبات عطري بقوة برائحة اليانسون؛ تستخدم الأوراق والبذور للتتبيل)",
 "foeniculum vulgare dulce": "شمر حلو, شمر فلورنسا (يزرع خاصة لقاعدة ساقه البصلية العطرية الصالحة للأكل)",
 "foetal": "جنيني (متعلق بالجنين)\nمثال: تطور جنيني",
 "foetal circulation": "الدورة الدموية الجنينية (نظام الأوعية الدموية والهياكل التي يتحرك من خلالها الدم في الجنين)",
 "foetal distress": "ضائقة جنينية (حالة غير طبيعية للجنين؛ تكتشف عادة أثناء الحمل وتتميز بضربات قلب غير طبيعية)",
 "foetal monitor": "جهاز مراقبة الجنين الإلكتروني (شاشة إلكترونية تراقب ضربات قلب الجنين وتقلصات رحم الأم أثناء الولادة)",
 "foetal movement": "حركة الجنين (حركة الجنين داخل الرحم (تُكتشف عادة بحلول الأسبوع السادس عشر من الحمل))",
 "foetid": "زَنِخ, مُنْتِن (ذُو رَائِحَةٍ كَرِيهَةٍ بِشَكْلٍ مُؤْذٍ)",
 "foetid bugbane": "بق توت نتن (نبات البق توت من سيبيريا وشرق آسيا ذو أزهار خضراء بيضاء كريهة الرائحة)",
 "foetid pothos": "عشبة الظربان, ملفوف الظربان (نبات مستنقعات معمر نفضي منخفض النمو كريه الرائحة في شرق أمريكا الشمالية له أزهار دقيقة محاطة بقنابة مرقطة خضراء أو أرجوانية تشبه القلنسوة)",
 "foetology": "طب الجنين, علم الأجنة الطبية (فرع الطب المعني بالجنين داخل الرحم)",
 "foetometry": "قياس الجنين (قياس الجنين (خاصة قطر الرأس))",
 "foetoprotein": "بروتين جنيني (أي من عدة مستضدات تحدث بشكل طبيعي في الجنين وأحياناً عند البالغين المصابين بالسرطان)",
 "foetor": "رائحة كريهة, نتانة (رائحة مميزة كريهة ومزعجة)",
 "foetoscope": "منظار الجنين (سماعة طبية توضع على بطن المرأة الحامل للاستماع إلى نبضات قلب الجنين)",
 "foetoscopy": "تنظير الجنين (تشخيص ما قبل الولادة الذي يسمح بالملاحظة المباشرة للجنين في الرحم وسحب دم الجنين)",
 "foetus": "جنين (فقاري غير مولود أو غير مفقوس في مراحل التطور اللاحقة يظهر السمات الرئيسية المميزة للحيوان الناضج)",
 "fog": "ضَبَاب, شبورة",
 "fog of war": "ضباب الحرب",
 "fogbank": "ركام ضبابي (كتلة كبيرة من الضباب في البحر (كما تُرى من مسافة))",
 "fogbound": "مُحَاصَر بِالضَّبَاب (محاط بالضباب ولا يمكنه التحرك)",
 "fogey": "دقة قديمة (شخص أسلوبه قديم وغير مواكب للموضة)",
 "fogged": "ضَبَابِيّ, مُغَطًّى بِالضَّبَاب (محجوب بالضباب أو الغيم)",
 "fogginess": "ضَبَابِيَّة, طَمْس (صفة كون الشيء غير واضح وبدون حدود حادة) / ضباب, قتام (جو تنخفض فيه الرؤية بسبب سحابة من مادة ما)",
 "foggy": "ضَبَابِيّ",
 "foggy bottom": "فوغي بوتوم (وزارة الخارجية الأمريكية، التي تقع في مبنى في منطقة منخفضة في واشنطن بالقرب من نهر بوتوماك)",
 "foghorn": "بوق الضباب (جهاز تحذير يتكون من بوق يولد نغمة منخفضة عالية الصوت) / إشارة الضباب, بوق الضباب (إشارة تحذير منخفضة وعالية الصوت يمكن سماعها من قبل السفن المحاصرة بالضباب)",
 "foglamp": "مصباح ضباب (مصباح أمامي يوفر شعاعاً قوياً للاستخدام في الطقس الضبابي)",
 "fogsignal": "إشارة الضباب, بوق الضباب (إشارة تحذير منخفضة وعالية الصوت يمكن سماعها من قبل السفن المحاصرة بالضباب)",
 "fogy": "دقة قديمة (شخص أسلوبه قديم وغير مواكب للموضة)",
 "fogyish": "رَجْعِيّ, مُتَحَجِّر ((ازدرائيًّا) قَدِيم الطِّرَاز وَمُتَخَلِّف عَنِ العَصْر)",
 "fohn": "رياح الفون, فون (رياح دافئة وجافة تهب أسفل المنحدرات الشمالية لجبال الألب)",
 "foible": "الجزء الضعيف (الجزء الأضعف من نصل السيف من الجزء القوي إلى الطرف) / خصوصية, سمة شخصية غريبة (سمة سلوكية مميزة وخاصة بالفرد) / ضعف بسيط, نقيصة (عيب بسيط أو نقص في الشخصية أو السلوك)\nمثال: أعجب الطلاب بمعلمهم على الرغم من نقائصه",
 "foie gras": "كبد دسم, فْوَا غْرَا",
 "foil": "فَشَّلَ, أحبط (فَشَلَ الطالبُ في الامتحان: لم ينجح في الاختبار ولم يحقق النتيجة المطلوبة؛ فَشَلَ الشيءُ: انهار أو انكسر أو توقف عن العمل)\nمثال: فشل ياني مجددا.",
 "foiled": "مَهْزُوم, مُحْبَط (فاشل بشكل مخيّب للآمال)",
 "foiling": "إحباط, إفشال (فعل إعاقة خطط أو جهود شخص ما)",
 "folacin": "حمض الفوليك, فولات (فيتامين ب ضروري لنمو الخلايا والتكاثر)",
 "folate": "حمض الفوليك, فولات (فيتامين ب ضروري لنمو الخلايا والتكاثر)",
 "fold": "طَوَى / طَيَّة",
 "foldable": "قَابِل لِلطَّيّ (يمكن طيّه وتخزينه)",
 "foldaway": "قَابِل لِلطَّيّ (يمكن طيّه وتخزينه)",
 "folder": "مِلَفّ, مُجَلَّد / مُجَلَّد",
 "folderal": "حلي تافهة, خردوات (أشياء زخرفية ليس لها قيمة كبيرة)",
 "folderol": "تُرَّهَات, كَلَام تَافِه (حديث أو كتابة لا معنى لها)",
 "folding": "طي (عملية الطي) / طي (عملية جيولوجية تسبب انحناء في طبقة صخرية) / طي البروتين (العملية التي يتخذ فيها جزيء البروتين شكله المعقد ثلاثي الأبعاد)\nمثال: قام بطي المناديل طية مزدوجة",
 "folding chair": "كرسي قابل للطي, كرسي منطوي (كرسي يمكن طيه بشكل مسطح للتخزين)",
 "folding door": "باب أكورديون, باب قابل للطي (باب داخلي يفتح عن طريق الطي للخلف في أقسام (بدلاً من التأرجح على مفصلات))",
 "folding money": "بنكنوت, نقود ورقية (عملة تصدرها حكومة أو بنك مركزي وتتكون من ورق مطبوع يمكن تداوله كبديل للنقود المعدنية)",
 "folding saw": "منشار قابل للطي (منشار ذو نصل مسنن يطوى داخل مقبض (كما يطوى سكين الجيب))",
 "folding screen": "سَاتِر",
 "foldout": "مطوية (صفحة كبيرة الحجم تطوى داخل كتاب أو مجلة)",
 "foliaceous": "صَفَائِحِيّ, وَرَقِيّ ((خاصة للصخور المتحولة) ذو طبقات رقيقة تشبه الأوراق) / غَزِير الأَوْرَاق, وَرَقِيّ (يحمل أوراقاً عديدة وكثيفة) / ورقي (مكون من أو يخص أو يشبه ورقة النبات)",
 "foliage": "زخرفة ورقية ((في العمارة) زخرفة معمارية تشبه الأوراق) / ورقة (العضو الرئيسي للتمثيل الضوئي والنتح في النباتات العليا)",
 "foliaged": "غَزِير الأَوْرَاق, وَرَقِيّ (يحمل أوراقاً عديدة وكثيفة)",
 "foliate": "صَفَائِحِيّ, وَرَقِيّ ((خاصة للصخور المتحولة) ذو طبقات رقيقة تشبه الأوراق) / ذُو أَوْرَاق (يملك أو يشبه الورقة أو ذو نوع أو عدد محدد من الأوراق) / ذي وريقات, مورق (مزخرف بأوراق الشجر أو الوريقات (في العمارة))\nمثال: زخرفة مورقة",
 "foliated": "صَفَائِحِيّ, وَرَقِيّ ((خاصة للصخور المتحولة) ذو طبقات رقيقة تشبه الأوراق) / ذي وريقات, مورق (مزخرف بأوراق الشجر أو الوريقات (في العمارة))\nمثال: زخرفة مورقة",
 "foliation": "تغليف بالرقائق, توريق (عمل طلاء الزجاج برقائق معدنية) / ترقيق المعدن (إنتاج الرقائق عن طريق قطع أو طرق المعدن إلى أوراق رقيقة) / زخرفة ورقية ((في العمارة) زخرفة معمارية تشبه الأوراق) / توريق ((في الجيولوجيا) ترتيب الطبقات الشبيهة بالأوراق في الصخر)",
 "folic acid": "حمض الفوليك, فولات (فيتامين ب ضروري لنمو الخلايا والتكاثر)",
 "folie": "اضطراب عقلي, اضطراب نفسي ((الطب النفسي) اضطراب نفسي في التفكير أو العاطفة؛ مصطلح أكثر حيادية من المرض العقلي)",
 "folie a deux": "جنون الاثنين, ذهان مشترك (حدوث متزامن لأعراض اضطراب عقلي (مثل الأوهام) لدى شخصين تربطهما صلة قرابة وثيقة (مثل الأشقاء أو الزوج والزوجة))",
 "folio": "فوليو, كتاب من القطع الكبير (كتاب (أو مخطوطة) يتكون من أوراق كبيرة مطوية في المنتصف لتكوين ورقتين أو أربع صفحات) / صحيفة, ورقة (ورقة من أي مادة مكتوبة أو مطبوعة (خاصة في مخطوطة أو كتاب)) / تَرْقِيم, تَرْقِيم الصَّفَحَات (نظام ترقيم الصفحات)\nمثال: الفوليو الأول لمسرحيات شكسبير",
 "foliolate": "ذُو وُرَيْقَات (يملك وريقات (أوراق مركبة) أو نوعاً أو عدداً محدداً منها)",
 "foliose": "غَزِير الأَوْرَاق, وَرَقِيّ (يحمل أوراقاً عديدة وكثيفة)",
 "folium": "توريق, طبقة رقيقة (طبقة رقيقة أو صفائح من الصخور (خاصة المتحولة))",
 "folk": "شَعْبِيّ",
 "folk art": "فن شعبي (نوع فني مجهول الأصل يعكس القيم التقليدية للمجتمع)",
 "folk ballad": "أغنية شعبية, أغنية فلكلورية (أغنية يغنيها تقليدياً عامة الناس في منطقة ما وتشكل جزءاً من ثقافتهم)",
 "folk dance": "رَقْص شَعْبِيّ (حركة الجسم بتنسيق موسيقي أو لحن، حيث يتحرك الشخص بشكل إيقاعي أو متناسق مع الموسيقى أو أنغام معينة؛ نشاط جسدي يتم على عادة أو تقليد، حيث يشارك الأفراد في الاحتفالات أو الفعاليات الاجتماعية)\nمثال: كنت تجيد الرقص.",
 "folk dancer": "راقص شعبي (شخص يمارس الرقصات الشعبية)",
 "folk dancing": "رقص شعبي, رقص فلكلوري (أسلوب رقص نشأ بين عامة الناس (وليس في البلاط الملكي))",
 "folk etymology": "تأثيل شعبي (تأثيل شائع ولكنه خاطئ)",
 "folk hero": "بطل شعبي",
 "folk medicine": "طب تقليدي (العِلْم؛ دراسة أسباب وتَشْخِيْص ومُعَاْلَجَة الأمراض)\nمثال: اختص في طب القلب.",
 "folk metal": "فولك ميتال (نوع موسيقي يدمج موسيقى الهيفي ميتال والموسيقى الشعبية التقليدية، تطور في أوروبا خلال التسعينيات)",
 "folk music": "مُوسِيقَى فُلْكْلُورِيَّة (مُوسِيقى، فنُّ تأليف الألحان وتوزيعها وإيقاعها والغناء والتطريب بضروب المعازف؛ علم الموسيقى : علمٌ يُبحَثُ فيه عن أُصَول النغم من حيث تأَتلف أَو تتنافر، وأَحوال الأَزمنة المتخللة بينها، ليُعلَمَ كيف يؤلَّف اللَّحْن)\nمثال: أتعلم الموسيقى.",
 "folk poet": "شاعر شعبي (كاتب شعبي ينظم الشعر)",
 "folk singer": "تروبادور, مغني شعبي (مغنٍ للأغاني الشعبية والفلكلورية)",
 "folk song": "أُغْنِيَّةٌ شَعْبِيَّة (الجمع : أُغْنِيَات و أغانٍ؛ الأُغنيَة المقتسمة : ( الموسيقى ) قطعة موسيقيَّة ذات لفظ مجانس متعلِّق بالكورال في القرن التَّاسع عشر)\nمثال: أنا أغني أغنية.",
 "folk tale": "حِكَايَة شَعْبِيَّة, فُولْكُلُور (حكاية تتداول شفهياً بين عامة الناس)",
 "folk writer": "كاتب شعبي (كاتب للحكايات الشعبية)",
 "folklore": "فُولْكْلُور, فُولْكُلُور",
 "folklorism": "الفلكلورية (اختراع أو تكييف الفولكلور؛ بما في ذلك أي استخدام لتقليد خارج السياق الثقافي الذي نشأ فيه)\nمثال: في الدول الرأسمالية الغربية، رأى تفوقاً للفلكلورية بسبب توسع الأسواق الصناعية، بدءاً من السياحة إلى السلع الاستهلاكية",
 "folks": "عامة الناس, قوم (الناس بشكل عام (وغالباً ما تستخدم بصيغة الجمع)) / الأهل, الوالدان\nمثال: إنهم مجرد ناس ريفيين",
 "folksong": "أغنية شعبية, أغنية فلكلورية (أغنية يغنيها تقليدياً عامة الناس في منطقة ما وتشكل جزءاً من ثقافتهم)",
 "folksy": "شَعْبِيّ, وُدِّيّ (غَيْرُ رَسْمِيٍّ جِدًّا وَأَلِيفٌ) / شَعْبِيّ الطَّابِع (ينتمي إلى عامة الناس خاصة في أنماط الكلام والمواقف)",
 "folktale": "حِكَايَة خُرَافِيَّة",
 "follicle": "حُوَيْصِلَة",
 "follicle-stimulating hormone": "الهرمون المنبه للجريب (هرمون موجه للغدد التناسلية تفرزه الغدة النخامية الأمامية ويحفز نمو بصيلات غراف في إناث الثدييات، وينشط الخلايا المكونة للحيوانات المنوية في ذكور…)",
 "follicular": "جريبي (من أو يتعلق بالجريب أو يشكله)",
 "folliculitis": "التهاب الجريبات (التهاب بصيلة الشعر)",
 "follies": "استعراض فوليز (عرض استعراضي بأزياء متقنة)",
 "follow": "تَبِعَ, اِتَّبَعَ (تبِع الشيءَ: سار في إثرِه، تلاه؛ تبِعه تبَعًا: مرَّ به فمضى معه) / اِتَّبَعَ (تَكَلَّفَ وبذل الجُهْد في أن يَتْبَع) / تَابَعَ, تَتَبَّعَ / تَابَعَ\nمثال: تبع المشتبه محققان.",
 "follow-on": "متابعة اللعب (جولة ثانية فورية مفروضة على فريق كريكيت يسجل عدداً محدداً من الركضات أقل من خصومه في الجولة الأولى)",
 "follow-through": "إنجاز, متابعة (تنفيذ مشروع أو نية حتى الاكتمال التام) / استكمال الضربة, متابعة الحركة (فعل مواصلة الضربة إلى نهايتها الطبيعية)\nمثال: قدرت متابعته وإنجازه لوعده",
 "follow-up": "فحص لاحق, متابعة (فحص لاحق للمريض لغرض مراقبة العلاج السابق) / متابعة (نشاط يواصل شيئاً قد بدأ بالفعل أو يكرر شيئاً تم القيام به بالفعل) / عمل لاحق, متابعة (قطعة عمل تستغل أو تبني على عمل سابق)\nمثال: برنامجه الجديد هو متابعة للبرامج التي بدؤوا بها",
 "follower": "تَابِع / مُتَابِع",
 "followers": "أتباع, أنصار (مجموعة من المتابعين أو المتحمسين)",
 "following": "تَالٍ, التَّالِي ((تَالَ): عالَجَ التِّوَلةَ: (السِّحْر)؛ (تَالَ) بِه: دُهِيَ ومُنِيَ) / بَعْد (يدل على اللحاق في الزمان؛ يكون مضافا، وينصب أو يجر)\nمثال: و بعد قليل أتى.",
 "followup": "فحص لاحق, متابعة (فحص لاحق للمريض لغرض مراقبة العلاج السابق) / متابعة (نشاط يواصل شيئاً قد بدأ بالفعل أو يكرر شيئاً تم القيام به بالفعل) / عمل لاحق, متابعة (قطعة عمل تستغل أو تبني على عمل سابق)\nمثال: برنامجه الجديد هو متابعة للبرامج التي بدؤوا بها",
 "folly": "حماقة, طيش (سلوك أحمق أو لا معنى له) / حماقة, غباء (خطأ سخيف) / حماقة (سمة التصرف بغباء أو تهور) / جنون, حماقة (صفة التهور والحماقة)\nمثال: محاولة القيادة خلال عاصفة ثلجية هي قمة الحماقة",
 "folsom culture": "ثقافة فولسوم (ثقافة الأمريكيين القدماء في أمريكا الوسطى وأمريكا الشمالية؛ تتميز بشكل رئيسي برأس مقذوف رقيق مصنوع بدقة من الصوان على شكل ورقة)",
 "fomalhaut": "فَمُ الْحُوت",
 "fomentation": "إثارة, تحريض (الإشعال المتعمد والمقصود (للمشاكل أو الفتنة)) / كمادة دافئة (وضع أغطية مبللة دافئة على جزء من الجسم لتخفيف الألم والالتهاب) / كمادة ساخنة (مادة تستخدم ككمادة طبية رطبة ودافئة)",
 "fomenter": "مثير للفتن, محرض (شخص يقوم بالتحريض؛ مثير للقلاقل السياسية)",
 "fomes igniarius": "غاريقون النار (فطر يستخدم في تحضير مادة لإشعال الصمامات)",
 "fomite": "أداة ناقلة للعدوى, ناقل للمرض (أي جسم غير حي (مثل منشفة أو نقود أو ملابس أو أطباق أو كتب أو ألعاب وما إلى ذلك) يمكن أن ينقل العوامل المعدية من شخص لآخر)",
 "fomor": "فومور, فوموريان (واحد من مجموعة شياطين البحر الكلتية المرتبطة أحياناً بقوى الطبيعة المعادية)",
 "fomorian": "فومور, فوموريان (واحد من مجموعة شياطين البحر الكلتية المرتبطة أحياناً بقوى الطبيعة المعادية)",
 "fond": "مُتَيَّم, مُدَلِّل (محب بإفراط أو بحماقة ومُتسامح بلا حدود) / حَنُون, وَدُود (يتحلّى بالدفء العاطفي والمودة أو يُظهرهما) / سَاذَج, وَاهِم (سخيف أو أحمق لكونه غير مرجَّح الحدوث)",
 "fond regard": "تعلق (شعور بالمودة لشخص أو مؤسسة)",
 "fondant": "فوندان (حلوى مصنوعة من عجينة سكر كريمية كثيفة)",
 "fondle": "لَاطَفَ, رَبَتَ",
 "fondler": "مداعب, ملامس (متحرش يلمس الأجزاء الحميمة للضحية) / مدلل, ملاطف (عاشق يداعب ويلاطف المحبوب برفق)",
 "fondling": "تقبيل, عناق (اللعب العاطفي (أو المداعبة دون ملامسة الأعضاء التناسلية))",
 "fondly": "بِحَنَان, بِحُبّ (بمودة وحب)\nمثال: تحدثت إلى أطفالها بحنان",
 "fondness": "دفء عاطفي, محبة (صفة نابعة من مشاعر المودة أو الحب) / هوى, ولع (استعداد للإعجاب بشيء ما) / عاطفة, محبة (شعور إيجابي بالإعجاب)\nمثال: كان لديه ولع بالويسكي",
 "fondu": "فوندو (جبن ساخن أو شوكولاتة مذابة بقوام الصلصة يتم تغميس الخبز أو الفواكه فيها) / فوندو, فوندو اللحم (مكعبات من اللحم أو المأكولات البحرية مطبوخة في زيت ساخن ثم تُغمس في أي من الصلصات المتنوعة)",
 "fondue": "فُونْدُو",
 "font": "خَطّ, بُنْط (كِتَابَة؛ ما يَصِل نقطتين أو أكثر)\nمثال: إرسم خط مستقيم.",
 "font cartridge": "خرطوشة الخطوط (أي خط موجود في خرطوشة يمكن توصيلها بطابعة كمبيوتر)",
 "fontanel": "يافوخ (أي فجوة غشائية بين عظام الجمجمة عند الرضيع أو الجنين)",
 "fontanelle": "يَأْفُوخ",
 "food": "طَعَام, أَكْل (كُلُّ مَا يُؤْكَلُ. مُرادفه أَكْل)\nمثال: ليس لدينا طعام.",
 "food additive": "مادة مضافة للطعام, مضاف غذائي (مادة تضاف للطعام لتحسين نكهته أو مظهره أو فترة صلاحيته)",
 "food allergy": "حساسية الطعام (رد فعل تحسسي لمادة يتم تناولها في الطعام)",
 "food and agriculture organization": "الفاو, منظمة الأغذية والزراعة (وكالة الأمم المتحدة المعنية بالتنظيم الدولي للأغذية والزراعة)",
 "food and agriculture organization of the united nations": "الفاو, منظمة الأغذية والزراعة (وكالة الأمم المتحدة المعنية بالتنظيم الدولي للأغذية والزراعة)",
 "food and drug administration": "إدارة الغذاء والدواء (وكالة فيدرالية في وزارة الصحة والخدمات الإنسانية تأسست لتنظيم إصدار الأطعمة الجديدة والمنتجات المتعلقة بالصحة)",
 "food bank": "بنك الطعام (مكان يتم فيه التبرع بالطعام وإتاحته للمحتاجين)\nمثال: أنشأوا بنك طعام لضحايا الفيضان",
 "food cache": "مخبأ طعام (طعام في مكان تخزين آمن أو مخفي)",
 "food cart": "عَرَبَةُ طَعَام",
