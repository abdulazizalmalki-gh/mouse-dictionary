 "fothergilla": "ألدر الساحرة, فوثرجيلا (أي من الشجيرات النفضية منخفضة النمو المتعددة من جنس فوثرجيلا ذات سنابل تشبه الفرشاة من الزهور البيضاء في الربيع ولون خريفي أحمر وبرتقالي ناري؛ تنمو…)",
 "fots": "نظام نقل بالألياف الضوئية (نظام اتصال يستخدم كابلات الألياف الضوئية)",
 "foucault pendulum": "بندول فوكو (بندول بسلك طويل يمكنه التأرجح في أي اتجاه؛ ويوضح التغيير في مستوى تأرجحه دوران الأرض)",
 "fouka": "فوكة",
 "foul": "مُخَالَفَة",
 "foul ball": "كرة خاطئة ((البيسبول) كرة تُضرب بالمضرب بحيث لا تبقى بين الخطوط (الخطوط الجانبية) التي تحدد عرض ملعب اللعب)",
 "foul language": "قَبَاحَة",
 "foul line": "خط الخطأ (خطوط تمر عبر القاعدة الأولى والثالثة تشير إلى حدود ملعب البيسبول) / خط التجاوز (خط عبر ممر البولينج لا يجب على اللاعب تجاوزه) / خط الرمية الحرة (خط ينفذ منه لاعبو كرة السلة رميات الجزاء)",
 "foul play": "غدر, لعب قذر (سلوك غير عادل أو غير نزيه (يتضمن العنف خاصة))",
 "foul shot": "رمية حرة (رمية كرة سلة غير معاقة من خط الخطأ؛ تمنح لمعاقبة الفريق الآخر لارتكابه خطأ)",
 "foul-mouthed": "بَذِيء اللِّسَان",
 "foul-smelling": "زَنِخ, مُنْتِن (ذُو رَائِحَةٍ كَرِيهَةٍ بِشَكْلٍ مُؤْذٍ)",
 "foul-spoken": "بَذِيء اللِّسَان (يستخدم لغة فاحشة وبذيئة في كلامه)",
 "foul-up": "خطأ فادح, زلة (خطأ محرج)",
 "foul-weather gear": "ملابس وقاية من الطقس السيء (ملابس واقية تهدف إلى إبقاء مرتديها جافاً ودافئاً في الطقس السيء)",
 "foulard": "فولار (قماش حريري أو شبيه بالحرير خفيف ذو نسج بسيط أو مبرد (عادة بتصميم مطبوع))",
 "fouled": "مُتَشَابِك, مُعَقَّد (خاصة لحبال السفن وما شابهها؛ متشابك ومتعقد) / مُلَوَّث (صار قذراً أو ملوّثاً بالأوساخ)",
 "foully": "بخسة, بشكل شنيع (بطريقة شريرة ومخزية) / بشكل مهين, بفظاظة (بطريقة غير عادلة ومهينة)\nمثال: قُتل شرطيان بشكل شنيع",
 "foulmart": "ظربان أوروبي (حيوان عرسيات بني داكن من غابات أوراسيا يطلق رائحة كريهة عند التهديد)",
 "foulness": "رائحة كريهة, نتانة (سمة امتلاك رائحة كريهة قوية) / رداءة الطقس ((للطقس) سوء الأحوال الجوية) / قذارة, نجاسة (حالة تتميز بالقذارة والنفايات الكريهة) / دناءة, فحش (شر وفساد مثير للاشمئزاز)\nمثال: لقد أرهقتهم رداءة الطقس",
 "foumart": "ظربان أوروبي (حيوان عرسيات بني داكن من غابات أوراسيا يطلق رائحة كريهة عند التهديد)",
 "found": "أَسَّسَ",
 "foundation": "إِنْشاء, إِشَادَة (مصدر للفعل \"أَنْشَأَ\") / أَسَاس, قَاعِدَة (مبدأ عام تعتمد عليه طائفة من الظواهر أو القضايا؛ مُرتكز البناء وقاعدته) / مُؤَسَّسَة / أَسَاس (مبدأ عام تعتمد عليه طائفة من الظواهر أو القضايا؛ مُرتكز البناء وقاعدته)\nمثال: إنشاء موقع إلكتروني بدون أي تكلفة؟",
 "foundation garment": "مشد, ملابس داخلية مشكلة (رداء داخلي نسائي يرتدى لإعطاء شكل لمنحنيات الجسم)",
 "foundation stone": "حجر الأساس (حجر يوضع في حفل لتدشين تأسيس مبنى جديد)",
 "founder": "مُؤَسِّس, مُؤَسِّسَة",
 "founder effect": "تَأْثِير المُؤَسِّس, تَأْثِير المُؤَسَّسَة",
 "foundering": "غرق ((للسفينة) الغرق أو الغوص تحت الماء)",
 "founders' share": "سهم المؤسس (أسهم يحتفظ بها مؤسسو الشركة؛ تمنح عادة امتيازات خاصة)",
 "founding": "إنشاء, ابتداء (فعل بدء شيء ما لأول مرة؛ تقديم شيء جديد)\nمثال: تطلعت إلى بدايتها كشخص بالغ",
 "founding father": "أب مؤسس, مؤسس (شخص يؤسس أو يقيم مؤسسة ما) / أب مؤسس (عضو في المؤتمر الدستوري الذي صاغ دستور الولايات المتحدة عام 1787)\nمثال: جورج واشنطن هو الأب المؤسس لبلاده",
 "foundling": "لَقِيط, مَلْقُوط",
 "foundling hospital": "مأوى اللقطاء, مستشفى اللقطاء (مستشفى يتم فيه استقبال اللقطاء (الأطفال الرضع مجهولي الوالدين) ورعايتهم)",
 "foundress": "مؤسسة (امرأة قامت بالتأسيس)",
 "foundry": "مسبك, معمل صهر (مصنع يتم فيه إنتاج المسبوكات المعدنية)",
 "foundry proof": "تجربة سبك (تجربة مأخوذة من قالب قبل صنع الألواح المكررة)",
 "fount": "سبيل, نافورة (تجهيزات صحية توفر تدفقاً للمياه) / خط, نمط الخط (حجم وأسلوب محدد للحروف ضمن عائلة خطوط معينة)",
 "fountain": "نَافُورَة, فَوَّارَة",
 "fountain grass": "ثيوم, عشب النافورة (عشب زينة معمر طويل بريش زهور متدلية طويل من أفريقيا الاستوائية وآسيا)",
 "fountain of youth": "نبع الشباب (نبع يوصف في الحكايات الشعبية بأنه قادر على إعادة الشباب للناس)\nمثال: اكتشف بونس دي ليون فلوريدا أثناء بحثه عن نبع الشباب",
 "fountain pen": "قَلَم مِدَاد, قَلَم حِبْر سَائِل (قَطَعَ جزءا من شيء لتزيينه وتحسينه)\nمثال: ارسم بقلم رصاص.",
 "fountainhead": "مصدر غني, منبع (مصدر وفير) / مصدر رئيسي, منبع (مصدر المياه الذي ينشأ منه الجدول أو النهر)\nمثال: كانت نبعاً من المعلومات",
 "fouquieria columnaris": "سيريو, شجرة بوجوم (خشب الشمع من المكسيك وجنوب غرب كاليفورنيا له سيقان عمودية طويلة ويحمل زهوراً صفراء كريمية برائحة العسل)",
 "fouquieria splendens": "أوكوتيلو, سوط المدرب (شجيرة صحراوية من جنوب غرب الولايات المتحدة والمكسيك لها فروع شائكة عارية رفيعة تخرج أوراقاً وعناقيد من الزهور الحمراء بعد موسم الأمطار)",
 "four": "أَرْبَعَة, أَرْبَع (أَرْبِعَة؛ أربعَة)\nمثال: مرت أربعة أيام.",
 "four flush": "خداع, مخادعة (فعل المخادعة في البوكر؛ الخداع بإظهار ثقة زائفة في قوة أوراقك)",
 "four horsemen": "فرسان الرؤيا الأربعة ((في العهد الجديد) الشرور الأربعة التي ستأتي في نهاية العالم: الغزو يمتطي حصانًا أبيض، والحرب حصانًا أحمر، والمجاعة حصانًا أسود، والطاعون حصانًا شاحبًا)",
 "four horsemen of the apocalypse": "فرسان رؤيا يوحنا الأربعَة (بمعنى الخَيَّال؛ في : سِلَاحُ الفُرْسَان أو فِرْقَة الفُرْسَان: هم الفرقة التي تركب الخيول في الجيوش القديمة وكانت أهم الفرق…)\nمثال: كان يعرف أسماء كل الفرسان.",
 "four hundred": "أَرْبَعُمِئَة, أَرْبَعُمِا۟ئَة",
 "four o'clock": "اَلسَّاعَة اَلرَّابِعَة",
 "four thousand": "أَرْبَعَة آلَاف (أَرْبِعَة؛ أربعَة)\nمثال: مرت أربعة أيام.",
 "four times": "أربعة أضعاف (بمقدار أربعة أضعاف)\nمثال: ارتفع سعر البنزين أربعة أضعاف خلال العامين الماضيين",
 "four-act play": "مسرحية من أربعة فصول (بنية مسرحية توجد في دراما أوائل القرن العشرين)",
 "four-card monte": "فور كارد مونتي (نسخة مختلفة من ثري كارد مونتي تُلعب بـ 4 أوراق)",
 "four-centered arch": "قوس تيودور, قوس رباعي المراكز (قوس بيضاوي منخفض أو مدبب؛ يُرسم عادة من أربعة مراكز)",
 "four-dimensional": "رُبَاعِيُّ الأَبْعَادِ (ينطوي على البعد الرابع (الزمن) أو يتصل به)",
 "four-flusher": "مخادع, مراوغ (شخص يحاول خداع الآخرين بالتبجح)",
 "four-fold": "أَرْبَعَةُ أَضْعَافٍ, رُبَاعِيُّ الضِّعْفِ (أربعة أمثال الكمية أو العدد) / رُبَاعِيّ (ذو أربع وحدات أو مكوّنات)",
 "four-footed": "رُبَاعِيّ الأَرْجُل (لديه أربعة أقدام)",
 "four-footed butterfly": "حورية (فراشات متوسطة إلى كبيرة توجد في جميع أنحاء العالم تتميز عادة بأجنحة زاهية الألوان وأرجل أمامية غير وظيفية مختزلة جداً مطوية على الصدر)",
 "four-four time": "زمن شائع, وزن رباعي (توقيع زمني يشير إلى أربع دقات في المقياس)",
 "four-hitter": "مباراة بأربع ضربات (مباراة لا يسمح فيها الرامي للفريق المنافس سوى ب4 ضربات)",
 "four-hundredth": "اَلْأَرْبَعُمِئَةِ (العدد الترتيبي لأربعمئة في العدّ)",
 "four-in-hand": "عربة جياد, كوتش (عربة تجرها أربعة خيول مع سائق واحد) / ربطة عنق طويلة (ربطة عنق طويلة تربط بعقدة منزلقة مع تدلي طرف أمام الآخر)",
 "four-lane": "ذُو أَرْبَعِ حَارَاتٍ (به حارتان في كل اتجاه)",
 "four-letter anglo-saxon word": "كلمة نابية, لفظ فاحش (أي من عدة كلمات قصيرة (غالباً ما تكون من 4 أحرف في الإنجليزية) تُعتبر عموماً بذيئة أو مسيئة)",
 "four-letter word": "كلمة نابية, لفظ فاحش (أي من عدة كلمات قصيرة (غالباً ما تكون من 4 أحرف في الإنجليزية) تُعتبر عموماً بذيئة أو مسيئة)",
 "four-line brevier": "بريفييه رباعي الأسطر (نوع طباعة بحجم 32 نقطة)",
 "four-lined leaf bug": "بق النبات رباعي الخطوط (بق أوراق أصفر أو برتقالي بأربعة خطوط سوداء أسفل الظهر؛ واسع الانتشار في وسط وشرق أمريكا الشمالية)",
 "four-lined plant bug": "بق النبات رباعي الخطوط (بق أوراق أصفر أو برتقالي بأربعة خطوط سوداء أسفل الظهر؛ واسع الانتشار في وسط وشرق أمريكا الشمالية)",
 "four-lobed": "رُبَاعِيّ الفُصُوص (ذو أربعة فصوص)",
 "four-membered": "رُبَاعِيُّ الأَعْضَاء (مُرَكَّبٌ كِيمِيَائِيٌّ لَهُ حَلْقَةٌ مِنْ أَرْبَعَةِ أَعْضَاء)",
 "four-minute man": "عداء الأربع دقائق (شخص ركض الميل في أقل من 4 دقائق)",
 "four-needled": "ذُو أَرْبَع إِبَر ((عن الصَّنَوْبَريّات) ذو أربع إبر)",
 "four-part harmony": "تناغم رباعي الأجزاء (تناغم يحتوي فيه كل كورد على أربع نغمات تخلق أربعة خطوط لحنية)",
 "four-party": "رُبَاعِيّ الأَطْرَاف (يشمل أربعة أطراف)",
 "four-petaled": "رُبَاعِيّ البَتَلَات ((في الأزهار) ذو أربع بتلات)",
 "four-petalled": "رُبَاعِيّ البَتَلَات ((في الأزهار) ذو أربع بتلات)",
 "four-ply": "رُبَاعِيُّ الطَّبَقَات (ذُو سَمَاكَةٍ مُكَوَّنَةٍ مِنْ أَرْبَعِ طَبَقَاتٍ أَوْ خُيُوط)",
 "four-poster": "سرير ذو أربعة أعمدة (سرير ذو أعمدة في الزوايا الأربع يمكن استخدامها لدعم مظلة أو ستائر)",
 "four-pounder": "مدفع أربعة باوند (مدفع يطلق قذيفة تزن أربعة أرطال (باوندات))",
 "four-pronged": "رُبَاعِيُّ الشُّعَب (ذُو أَرْبَعِ شُعَب)",
 "four-sided": "رُبَاعِيّ الأَضْلَاع (ذو أربعة أضلاع)",
 "four-spot": "أربعة (ورقة لعب أو حجر دومينو أو نرد يظهر وجهه العلوي أربع نقاط)",
 "four-stroke engine": "محرك رباعي الأشواط (محرك احتراق داخلي يتم فيه سحب خليط متفجر إلى الأسطوانة في الشوط الأول وضغطه وإشعاله في الشوط الثاني؛ يتم العمل في الشوط الثالث ويتم طرد نواتج…)",
 "four-stroke internal-combustion engine": "محرك رباعي الأشواط (محرك احتراق داخلي يتم فيه سحب خليط متفجر إلى الأسطوانة في الشوط الأول وضغطه وإشعاله في الشوط الثاني؛ يتم العمل في الشوط الثالث ويتم طرد نواتج…)",
 "four-tailed bandage": "رباط رباعي الأطراف (ضمادة تتكون من شريط قماشي مشقوق إلى شقين في كلا الطرفين؛ يوضع الجزء الأوسط تحت الذقن لتقييد حركة الفك السفلي وتربط الأطراف فوق الرأس)",
 "four-wheel": "رباعي العجلات (مكون من أو متعلق بالمركبات ذات العجلات الأربع)\nمثال: دفع رباعي العجلات",
 "four-wheel drive": "اَلدَّفْع اَلرَّبَاعِيّ",
 "four-wheeled": "رباعي العجلات (مكون من أو متعلق بالمركبات ذات العجلات الأربع)\nمثال: دفع رباعي العجلات",
 "four-wheeler": "عربة بأربع عجلات (عربة هاكني بأربع عجلات)",
 "four-wing flying fish": "سمكة طائرة ثنائية الجناح (تتميز بتضخم كل من الزعانف الصدرية والحوضية)",
 "four-year-old": "بِعُمُر أَرْبَع سَنَوَات (في عامه الرابع من العمر)",
 "fourfold": "أربعة أضعاف (بمقدار أربعة أضعاف) / أَرْبَعَةُ أَضْعَافٍ, رُبَاعِيُّ الضِّعْفِ (أربعة أمثال الكمية أو العدد) / رُبَاعِيّ (ذو أربع وحدات أو مكوّنات)\nمثال: ارتفع سعر البنزين أربعة أضعاف خلال العامين الماضيين",
 "fourfold point correlation": "ارتباط فاي, معامل فاي (مؤشر للعلاقة بين أي مجموعتين من الدرجات يمكن تمثيلهما بأبعاد ثنائية مرتبة (مثل ذكر-أنثى))",
 "fourhanded": "رباعي الأيدي ((عن ألعاب الورق) تشمل أو تتطلب أربعة لاعبين)",
 "fourier analysis": "تحليل توافقي, تحليل فورييه (تحليل دالة دورية إلى مجموع مكونات جيبية بسيطة)",
 "fourier series": "مُتَسَلْسِلَة فُورْيِيِه (مجموع سلسلة من التعبيرات المثلثية؛ تستخدم في تحليل الدوال الدورية)",
 "fourpence": "أربعة بنسات, غروت (عملة فضية إنجليزية سابقة بقيمة أربعة بنسات)",
 "fourpenny": "رُبَاعِيُّ الْبِنْس ((في قياس المسامير) بطول 1.5 بوصة أو 3.8 سم)",
 "fourpenny nail": "مسمار 1.5 بوصة (مسمار طوله 1.5 بوصة)",
 "fourscore": "ثَمَانُونَ (يَدُلُّ عَلَى العَدَد 80) / ثَمَانُون (العدد الأصلي الذي هو حاصل ضرب عشرة في ثمانية)",
 "foursome": "رباعي, مجموعة رباعية (أربعة أشخاص يُنظر إليهم كوحدة واحدة) / أَرْبَعَة, رُبَاعِيّ (العدد الأصلي الذي هو مجموع ثلاثة وواحد)\nمثال: انضم إلى رباعي غنائي",
 "foursquare": "بشكل مباشر, بصراحة (بحزم وقناعة؛ بدون مساومة) / بِثَبَات, بِشَكْل مُرَبَّع (في وضع مربع أو ثابت) / رَاسِخُ الْقَنَاعَةِ (يتميز بقناعة راسخة لا تتزعزع) / مربع ((هندسة) مستطيل مستوٍ بأربعة أضلاع متساوية وأربع زوايا قائمة؛ مضلع منتظم رباعي الأضلاع)\nمثال: وقف بصلابة من أجل الحرية الدينية والتسامح",
 "fourteen": "أَرْبَعَةَ عَشَرَ (أَرْبِعَة؛ أربعَة)\nمثال: مرت أربعة أيام.",
 "fourteenth": "رَابِعَ عَشَرَ, رَابِعَةَ عَشْرَةَ (رابعوا الحمِلَ مرابعة: أدخلوا المِربَعة تحتهُ)\nمثال: زيري هو الرابع.",
 "fourteenth salary": "راتب الشهر الرابع عشر (راتب شهر إضافي، بالإضافة إلى راتب الشهر الثالث عشر، يدفع للموظفين وفقاً لشروط قانونية أو عقود عمل مختلفة؛ غالباً ما يعادل راتب شهر كامل)",
 "fourth": "رَابِع, رَابِعَة (رابعوا الحمِلَ مرابعة: أدخلوا المِربَعة تحتهُ)\nمثال: زيري هو الرابع.",
 "fourth council of constantinople": "مجمع القسطنطينية الرابع (المجمع المنعقد عام 869 الذي أدان فوتيوس الذي أصبح بطريرك القسطنطينية دون موافقة الفاتيكان، مما عجل بالانشقاق بين الكنائس الشرقية والغربية)",
 "fourth cranial nerve": "عصب بكري, عصب قحفي رابع (أي من العصبين القحفيين على كلا الجانبين اللذين يتحكمان في العضلات المائلة العلوية للعينين)",
 "fourth deck": "أدنى سطح, السطح الرابع (السطح الرابع أو الأدنى)",
 "fourth dimension": "البعد الرابع, الزمن (الإحداثي الرابع المطلوب (إلى جانب الأبعاد المكانية الثلاثة) لتحديد حدث فيزيائي)",
 "fourth estate": "السلطة الرابعة, الصحافة (الصحافة، بما في ذلك الصحفيون وكتاب الصحف والمصورون)",
 "fourth lateran council": "مجمع لاتران الرابع (مجمع لاتران عام 1215 وكان أهم مجمع في العصور الوسطى؛ أصدر قانون إيمان ضد الألبيجنسية، ونشر مراسيم إصلاحية، وأعلن عقيدة الاستحالة الجوهرية، وأوضح…)",
 "fourth of july": "الرابع من يوليو, عيد الاستقلال (عطلة قانونية تحتفل باستقلال الدولة (خاصة في الولايات المتحدة))",
 "fourth part": "رُبْع (واحد من أربعة أجزاء متساوية)",
 "fourth power": "ثُنَائِيّ التَّرْبِيع, قُوَّة رَابِعَة (معادلة جبرية أو دالة من الدرجة الرابعة)",
 "fourth reich": "الرَّايْخ الرَابِع",
 "fourth stomach": "أنفحة, المعدة الرابعة (القسم الرابع من معدة الحيوان المجتر؛ حيث يحدث الهضم)",
 "fourth ventricle": "بطين رابع (بطين غير منتظم بين البطين الثالث والقناة المركزية للحبل الشوكي)",
 "fourth-year": "فِي السَّنَةِ الرَّابِعَةِ (يُسْتَخْدَمُ لِوَصْفِ السَّنَةِ الرَّابِعَةِ وَالأَخِيرَةِ فِي المَدْرَسَةِ الثَّانَوِيَّةِ أَوِ الجَامِعَةِ الأَمْرِيكِيَّةِ)",
 "fourthly": "رابعاً (في المرتبة الرابعة)\nمثال: رابعاً، يجب عليك دفع الإيجار في الأول من الشهر",
 "fovea": "نقرة, نقرة مركزية (منطقة تتكون من انخفاض صغير في الشبكية يحتوي على مخاريط وحيث تكون الرؤية أكثر حدة)",
 "fovea centralis": "نقرة, نقرة مركزية (منطقة تتكون من انخفاض صغير في الشبكية يحتوي على مخاريط وحيث تكون الرؤية أكثر حدة)",
 "foveal vision": "رؤية نقيرية (الرؤية باستخدام النقرة (مركز الشبكية))",
 "fowl": "دجاج داجن (طائر داجن من الدجاجيات يعتقد أنه ينحدر من دجاج الأدغال الأحمر) / لحم دجاج, لحم طير (لحم طائر أو دجاجة (برية أو داجنة) يستخدم كطعام)",
 "fowl cholera": "كوليرا الطيور (مرض إسهالي حاد (خاصة للدجاج) تسببه الكائنات الحية الدقيقة التي تسبب التسمم الدموي النزفي)",
 "fowl pest": "طاعون الطيور (أي من مرضين فيروسيين حادين يصيبان الطيور الداجنة؛ يتميزان برفض الأكل وارتفاع درجة الحرارة وتغير لون العرف)",
 "fowl run": "ساحة الدجاج (فناء مسيج لحفظ الدواجن)",
 "fowler": "صياد الطيور (شخص يصطاد الطيور البرية للطعام)",
 "fowling piece": "بندقية صيد الطيور (بندقية صيد خفيفة تستخدم لصيد الطيور)",
 "fox": "ثَعْلَب (أي فصيلة من فصائل الكلبيّات القارتة (أكلة للحوم والنبات) الصغيرة الحجم، والبالغ عددها 27 نوعاً. يقصد العامّة من كلمة ثعلب في العادة الثعلب الأحمر…؛ شخص ماكر) / تعلب / ثعلب (أي فصيلة من فصائل الكلبيّات القارتة (أكلة للحوم والنبات) الصغيرة الحجم، والبالغ عددها 27 نوعاً. يقصد العامّة من كلمة ثعلب في العادة الثعلب الأحمر…؛ شخص ماكر)\nمثال: أردى الصياد الثعلب.",
 "fox cub": "جَرْو ثَعْلَب (الصَغير من كل نَبَات أو حَيَوَان؛ الصغير من الثَمَر كالبَطِّيخ والرُمَّان وغيره)\nمثال: كان الجرو يلحس خدها.",
 "fox grape": "عنب الثعلب (عنب بري أسود مائل للأرجواني في شرق الولايات المتحدة ذو قشور قاسية تنزلق بسهولة عن اللحم) / عنب الثعلب (عنب أصلي في شمال شرق الولايات المتحدة؛ أصل للعديد من الأصناف المزروعة مثل عنب كونكورد)",
 "fox hole": "حفرة فردية (خندق صغير به حفرة للمأوى الفردي ضد نيران العدو)",
 "fox hunter": "صائد الثعالب (صياد يمتطي حصاناً يتبع كلاب الصيد في مطاردة الثعلب)",
 "fox hunting": "صيد الثعالب (صيادون على الخيول يتبعون كلاب الصيد في مطاردة ثعلب)",
 "fox language": "لغة فوكس (لغة ألغونكوية خاصة بشعب فوكس)",
 "fox shark": "قرش دراس (قرش كبير يعيش في عرض البحار الدافئة ذو ذيل يشبه السوط يستخدمه لتجميع الأسماك الصغيرة ليتغذى عليها)",
 "fox squirrel": "سنجاب الثعلب (سنجاب شجري كبير بشكل استثنائي من شرق الولايات المتحدة)",
 "fox terrier": "فوكس تيريير, كلب صيد الثعالب الصغير (تيريير صغير حيوي أبيض وأسود كان يستخدم سابقاً لإخراج الثعالب من جحورها)",
 "fox-trot": "فوكس تروت (رقصة صالونات بإيقاع رباعي؛ تجمع بين خطوات قصيرة وطويلة وسريعة وبطيئة في تسلسلات ثابتة)",
 "foxberry": "توت البقر, توت الجبل الأحمر (شجيرة منخفضة دائمة الخضرة من المناطق المعتدلة الشمالية العالية في أوروبا وآسيا وأمريكا تحمل توتاً أحمر صالحاً للأكل)",
 "foxfire": "فوكسفيري",
 "foxglove": "قِمَعِيَّة",
 "foxhole": "حفرة فردية (خندق صغير به حفرة للمأوى الفردي ضد نيران العدو)",
 "foxhound": "فوكس هاوند, كلب صيد الثعالب (كلاب صيد متوسطة الحجم ذات فراء لامع تم تطويرها لصيد الثعالب)",
 "foxhunt": "صيد الثعالب (صيادون على الخيول يتبعون كلاب الصيد في مطاردة ثعلب)",
 "foxily": "بِاحْتِيَال, بِخُبْث (بطريقة خفية وماكرة)\nمثال: رتب بمكر ليكون هناك عندما أعلن القرار",
 "foxiness": "خبث, خديعة (الدهاء الذي يظهر من خلال المهارة في الخداع)",
 "foxtail": "ذيل الثعلب, عشبة ذيل الثعلب (أعشاب من جنسي ألوبيكوروس وسيتاريا ذات سنابل مزهرة كثيفة حريرية أو شائكة تشبه الفرشاة)",
 "foxtail barley": "شعير ذيل السنجاب (شعير يزرع لرؤوس زهوره الزخرفية للغاية ذات السفا الحريري الطويل الرقيق؛ أمريكا الشمالية وشمال شرق آسيا)",
 "foxtail grass": "ذيل الثعلب, عشبة ذيل الثعلب (أعشاب من جنسي ألوبيكوروس وسيتاريا ذات سنابل مزهرة كثيفة حريرية أو شائكة تشبه الفرشاة) / عشبة ذيل الثعلب (صنوبر أرضي مغطى بكثافة بأوراق شائكة؛ موزع على نطاق واسع في المناطق الساحلية الرملية القاحلة أو الخثية الرطبة في شرق وجنوب شرق الولايات المتحدة)",
 "foxtail millet": "دخن إيطالي, دخن ذيل الثعلب (عشب حولي خشن مقاوم للجفاف يزرع للحبوب والتبن والعلف في أوروبا وآسيا وبشكل رئيسي للعلف والتبن في الولايات المتحدة)",
 "foxtail orchid": "أوركيد ذيل الثعلب (أي من بساتين الفاكهة المختلفة من جنس رينكوستيليس ذات زهور بيضاء معلمة بالوردي إلى الأرجواني في عنقود أسطواني كثيف)",
 "foxtrot": "فوكس تروت (رقصة صالونات بإيقاع رباعي؛ تجمع بين خطوات قصيرة وطويلة وسريعة وبطيئة في تسلسلات ثابتة)",
 "foxy": "خَبِيث, مُحْتَال (يتّسم بالمهارة في الخداع والمكر)",
 "foyer": "بَهْو",
 "fpd": "شاشة مسطحة (نوع من شاشات الفيديو رقيقة ومسطحة؛ تستخدم عادة في الحواسيب المحمولة)",
 "fps": "خدمة الحماية الفيدرالية (وكالة في إدارة الخدمات العامة وهي منظمة أمنية لتوفير بيئة آمنة حيث يمكن للوكالات الفيدرالية القيام بأعمالها)",
 "fr": "فرانسيوم (عنصر مشع من مجموعة الفلزات القلوية اكتشف كمنتج تحلل للأكتينيوم)",
 "fracas": "شجار صاخب, مشادة (شجار صاخب)",
 "fracking": "تكسير هيدروليكي (تقنية تحفيز الآبار حيث يتم تكسير الصخور بواسطة سائل مضغوط)",
 "fractal": "فركتل, كسرية ((رياضيات) نمط هندسي يتكرر عند كل مقياس، وبالتالي لا يمكن تمثيله بالهندسة الكلاسيكية)",
 "fractal geometry": "هندسة الفراكتلات, هندسة كسرية ((رياضيات) هندسة الفراكتلات (الأشكال الكسورية))",
 "fraction": "قِطْعَة (القِطْعَةُ: الْجُزْءَ أو الحِصَّة من الشيءِ؛ القِطْعَةُ: فقرة قصيرة عادة من مقالٍ أو كتاب) / كَسْر, كُسُور\nمثال: يصنع قطعة أثاث خشبية.",
 "fractional": "جزئي, كسري (يشكل أو يضم جزءاً أو كسراً من كل محتمل أو كامل) / فِئَوِيّ, كَسْرِيّ (يشكّل قسمًا أو جزءًا كسريًّا من الوحدة النقدية الأساسية)\nمثال: حصة جزئية من التصويت",
 "fractional currency": "عملة كسرية (عملة ورقية بفئات أقل من الوحدة النقدية الأساسية)",
 "fractional distillation": "تقطير تجزيئي (تجزئة سائل عن طريق التقطير)",
 "fractional monetary unit": "وحدة نقدية فرعية, وحدة نقدية كسرية (وحدة نقدية تُقدر بكسر (عادة واحد بالمائة) من الوحدة النقدية الأساسية)",
 "fractional process": "تجزئة, تقطير تجزيئي (عملية تستخدم الحرارة لفصل مادة إلى مكوناتها)",
 "fractional rig": "تَجْهِيز جُزْئِيّ, شِرَاع جُزْئِيّ (تجهيز على سفينة شراعية يتكون من شراع أمامي لا يصل إلى قمة الصاري بالكامل)\nمثال: تم إدخال التجهيزات الجزئية على قوارب السباق للسماح بمزيد من التحكم في سطح الشراع الرئيسي",
 "fractionation": "تجزئة (الفصل إلى أجزاء أو حصص) / تجزئة, تقطير تجزيئي (عملية تستخدم الحرارة لفصل مادة إلى مكوناتها)",
 "fractious": "جَمُوح, مُتَقَلِّب (صَعْب التَّشْغِيل عَلَى نَحْوٍ غَيْرِ مُتَوَقَّع؛ مُرَجَّح أَنْ يُسَبِّب مَشَاكِل) / سَرِيع التَّأَفُّف, عَصَبِيّ (يتهيج أو ينزعج بسهولة) / جَمُوح, مُتَمَرِّد (يقاوم السلطة أو السيطرة بعناد شديد)",
 "fractiously": "بمشاكسة, بنكد (بطريقة مشاكسة وسريعة الغضب) / بحدة طبع, بنزق (بطريقة نزقة)\nمثال: كان الحصان يتصرف بمشاكسة ورفض القفز",
 "fractiousness": "تمرد, عدم انضباط (سمة الميل للعصيان ونقص الانضباط)",
 "fracture": "كَسْر, اِنْكِسَار / كَسْر / يكسر, ينكسر",
 "fradicin": "نيوبايوتيك, نيومايسين (مضاد حيوي يتم الحصول عليه من شعيات ويستخدم (كبريتات تحت الاسم التجاري نيوبايوتيك) كمطهر معوي في الجراحة)",
 "fragaria ananassa": "شليك, فراولة الحديقة (تزرع على نطاق واسع)",
 "fragaria chiloensis": "فراولة الشاطئ, فراولة تشيلية (فراولة برية من غرب الولايات المتحدة وأمريكا الجنوبية؛ مصدر للعديد من أصناف الفراولة المزروعة)",
 "fragaria vesca": "فراولة الغابات, فراولة برية (موطنها أوروبا)",
 "fragaria virginiana": "فراولة فرجينيا, فراولة قرمزية (فراولة برية من أمريكا الشمالية ذات ثمار قرمزية حلوة؛ مصدر للعديد من أصناف الفراولة المزروعة)",
 "fragile": "هَشّ (رقيق أو ضعيف البنية؛ لين وسهل الكسر أو التفتيت)",
 "fragile fern": "سرخس المثانة الهش, سرخس هش (سرخس رقيق واسع الانتشار في أمريكا الشمالية وأوروبا ذو سعف ريشي رقيق بسيقان هشة)",
 "fragility": "رقة, هشاشة (نقص القوة البدنية) / قابلية الكسر, هشاشة (جودة التضرر أو التدمير بسهولة)",
 "fragment": "قِطْعَة, شَقَفَة (القِطْعَةُ: الْجُزْءَ أو الحِصَّة من الشيءِ؛ القِطْعَةُ: فقرة قصيرة عادة من مقالٍ أو كتاب)\nمثال: يصنع قطعة أثاث خشبية.",
 "fragmental": "شِظْوِيّ, مُتَشَظٍّ (يتألّف من أجزاء صغيرة غير مترابطة)",
 "fragmentary": "شِظْوِيّ, مُتَشَظٍّ (يتألّف من أجزاء صغيرة غير مترابطة)",
 "fragmentation": "تذرية, تفتيت (فصل شيء ما إلى جزيئات دقيقة) / تشظي, تفتت (تناثر شظايا القنبلة بعد انفجارها) / تجزئة ((في علم الحاسوب) حالة الملف المقسم والمخزن في العديد من المواقع المختلفة على قرص ممغنط) / تفتت, شرذمة (تفكك المعايير الاجتماعية التي تحكم السلوك والفكر والعلاقات الاجتماعية)\nمثال: تؤدي التجزئة إلى إبطاء أداء النظام لأنه يستغرق وقتاً إضافياً لتحديد موقع أجزاء الملف المجزأ وتجميعها",
 "fragmentation bomb": "قنبلة شظية, قنبلة مضادة للأفراد (قنبلة تحتوي على 10 إلى 20 في المائة فقط من المواد المتفجرة والباقي يتكون من أغلفة مصممة لتتفتت إلى العديد من الشظايا الصغيرة عالية السرعة؛ وهي الأكثر…)",
 "fragmented": "مُفَكَّك, مُمَزَّق (تَمَّ تَقْسِيمُهُ؛ فُقِدَتْ وَحْدَتُهُ)",
 "fragrance": "أَرِيج, عَبِير",
 "fragrancy": "أريج, شذى (خاصية شمية حلوة وممتعة)",
 "fragrant": "رَيًّا, عَبِق",
 "fragrant agrimony": "أغريمونيا طويلة, غافث عطري (عشب معمر أوروبي عطري يوجد عند هوامش الغابات في التربة الرطبة)",
 "fragrant bedstraw": "جويسئة عطرة, نبات الخشبة",
 "fragrant cliff fern": "سرخس الجرف العطر, سرخس الدرع العطر (سرخس شمال أوراسيا وأمريكا الشمالية ذو سعف عطر)",
 "fragrant orchid": "أوركيد عطري (أوركيد أوروبي ذو سنابل كثيفة من زهور وردية أو ليلكية أو حمراء عطرة بمهاميز بارزة)",
 "fragrant shield fern": "سرخس الجرف العطر, سرخس الدرع العطر (سرخس شمال أوراسيا وأمريكا الشمالية ذو سعف عطر)",
 "fragrant sumac": "سماق عطري (سماق ذو رائحة حلوة في شرق أمريكا ذو أوراق ثلاثية وزهور خضراء مصفرة في سنابل تشبه النورات الهرية تليها ثمار حمراء مشعرة)",
 "fragrant water lily": "حورية الماء, زنبق الماء العطر (زنبق ماء ذو أوراق كبيرة وأزهار عطرية مبهرجة تطفو على الماء؛ من المناطق المعتدلة والاستوائية)",
 "fragrant wood fern": "سرخس الجرف العطر, سرخس الدرع العطر (سرخس شمال أوراسيا وأمريكا الشمالية ذو سعف عطر)",
 "fragrant woodsia": "وودسيا صدئة, وودسيا عطرية (سرخس صخري شائع في المناطق المعتدلة الشمالية ذو سويقات بنية صدئة وسعف ريشي رمحي)",
 "frail": "رَقِيق, سَهْلُ الكَسْر (يَسْهُلُ كَسْرُهُ أَوْ إِتْلَافُهُ أَوْ تَدْمِيرُهُ) / ضَعِيف, قَابِل لِلْخَطَأ (يفتقر إلى القوّة الأخلاقيّة أو الشجاعة؛ له صفات بشريّة مقابل الكائنات الإلهيّة) / ضعيف, واهن (ضعيف جسدياً) / سلة فواكه مجففة, قفة (سلة لحفظ الفاكهة المجففة (خاصة الزبيب أو التين))\nمثال: جسد المريض الواهن",
 "frailness": "ضعف, عجز (حالة الضعف في الصحة أو الجسم (خاصة بسبب الشيخوخة))",
 "frailty": "رذيلة, ضعف أخلاقي (ضعف أخلاقي) / ضعف, عجز (حالة الضعف في الصحة أو الجسم (خاصة بسبب الشيخوخة))",
 "fraise": "سياج وتدي مائل (متراس مائل أو أفقي من أوتاد مدببة) / ياقة مكشكشة (طوق للرقبة كان يرتدى في القرن السادس عشر)",
 "frambesia": "داء عليقي (مرض استوائي معد يشبه الزهري في مراحله المبكرة؛ يتميز بطفح جلدي أحمر وآفات متقرحة)",
 "framboesia": "داء عليقي (مرض استوائي معد يشبه الزهري في مراحله المبكرة؛ يتميز بطفح جلدي أحمر وآفات متقرحة)",
 "framboise": "توت العليق الأوروبي, توت العليق البري (توت العليق الأوروبي الشائع؛ الفاكهة حمراء أو برتقالية)",
 "frame": "أَطَّرَ ((أَطَّرَ) الشَّيْء: أَطَرَهُ) / وَرَّطَ / لَقْطَة\nمثال: دهنت أطر النافذة بالأصفر.",
 "frame buffer": "مخزن الإطار ((في علم الحاسوب) ذاكرة مؤقتة تخزن محتويات بكسلات الصورة بكسل تلو الآخر)",
 "frame of mind": "حالة ذهنية, مزاج (حالة نفسية مؤقتة)",
 "frame of reference": "إطار, إطار مرجعي (نظام من الافتراضات والمعايير التي تقر السلوك وتعطيه معنى) / إطار مرجعي, نظام إحداثيات (نظام يستخدم الإحداثيات لتحديد الموقع)",
 "frame-up": "تلفيق تهمة, مكيدة (فعل يورط شخصاً ما في تهمة كاذبة)",
 "framed": "داخل إطار, مؤطر (مزود بإطار)\nمثال: كانت هناك لقطات مؤطرة للعائلة والأصدقاء على مكتبها",
 "framer": "مشرع, واضع (شخص يكتب قانوناً جديداً أو خطة) / صانع إطارات, مؤطر (شخص يقوم بصناعة الإطارات (للصور وما شابه))\nمثال: واضعو الدستور",
 "framework": "إطار, هيكل (هيكل يدعم أو يحتوي على شيء ما) / إطار, نسيج (الهيكل الأساسي) / إطار نظري, نموذج (وصف افتراضي لكيان أو عملية معقدة)\nمثال: توفير إطار عمل واقعي للبحث المستقبلي",
 "framing": "تأطير, صياغة (صياغة الخطط والتفاصيل الهامة) / إطار صورة, برواز (إطار يدعم ويحمي صورة أو مرآة)\nمثال: صياغة المراسيم القضائية",
 "franc": "فْرَنْك",
 "franc-tireur": "قناص (قناص (في الجيش الفرنسي))",
 "france": "فَرَنْجَة / فرنسا (أوروبية تقع في الجزء الجنوبي الغربي من قارة أوروبا. كانت تسمى بلاد الإِفْرَنْجَ أو الفَرَنْجَة)\nمثال: نساء فرنسا جميلات.",
 "franchise": "حق التصويت, حق المواطنة (حق قانوني أو امتياز تمنحه الحكومة لشخص أو مجموعة (خاصة حقوق المواطنة والحق في التصويت)) / حق الامتياز, فرنشايز (تفويض لبيع سلع أو خدمات شركة في مكان معين) / امتياز تجاري, وكالة تجارية (عمل تم تأسيسه أو تشغيله بموجب تصريح لبيع أو توزيع سلع أو خدمات شركة في منطقة معينة)",
 "franchise tax": "ضريبة الامتياز (ضريبة تفرضها الولايات على الشركات؛ وتعتمد على كل من صافي قيمة الشركة وصافي دخلها المنسوب للأنشطة داخل الولاية)",
 "francis": "فَرَنْسِيس",
 "francis turbine": "توربين فرانسيس, عنفة فرانسيس (نوع من التوربينات الكهرومائية)",
 "franciscan": "فرنسيسكاني (من أو متعلق بالقديس فرنسيس الأسيزي أو بالرهبنة التي أسسها) / راهب رمادي, فرنسيسكاني (راهب روماني كاثوليكي يرتدي الزي الرمادي للرهبنة الفرنسيسكانية)\nمثال: رهبان فرنسيسكان",
 "franciscan order": "الرهبنة الفرنسيسكانية (نظام كاثوليكي روماني أسسه القديس فرنسيس الأسيزي في القرن الثالث عشر)",
 "franciscanism": "فرنسيسكانية (معتقدات أو ممارسات الرهبنة الكاثوليكية الرومانية المتسولة التي أسسها القديس فرنسيس الأسيزي عام 1209 والمكرسة لفضائل التواضع والفقر)",
 "francisella": "فرانسيسيلا (جنس من البكتيريا الهوائية سالبة الجرام التي توجد كمسببات للأمراض وطفيليات في العديد من الحيوانات (بما في ذلك البشر))",
 "francium": "فَرَنْسِيُوم / فَرَنْكِيُوم",
 "franco-american": "أمريكي فرنسي (أمريكي ولد في فرنسا أو من أجداد فرنسيين)",
 "francoa ramosa": "إكليل العروس, فرانكوا (شجيرة تشيلية دائمة الخضرة لها سنابل دقيقة من الزهور البيضاء الصغيرة)",
 "francolin": "دُرَّاج",
 "franconia": "فْرَانْكُونِيَا, فْرَنْكُونِيَا",
 "francophil": "محب لفرنسا (معجب بفرنسا وكل ما هو فرنسي)",
 "francophile": "محب لفرنسا (معجب بفرنسا وكل ما هو فرنسي)",
 "francophobe": "كاره للفرنسيين (شخص يكره فرنسا وكل ما هو فرنسي)",
 "frangibility": "قابلية الكسر, هشاشة (جودة التضرر أو التدمير بسهولة)",
 "frangible": "قَابِلٌ لِلْكَسْر (يُمْكِنُ كَسْرُهُ)",
 "frangibleness": "قابلية الكسر, هشاشة (جودة التضرر أو التدمير بسهولة)",
 "frangipane": "حلوى اللوز, فرانجيبان (معجنات بحشوة اللوز الكريمية)",
 "frangipani": "بلوميريا, فتنة (أي من الشجيرات أو الأشجار النفضية الاستوائية الأمريكية المختلفة من جنس بلوميريا ذات عصارة لبنية وأزهار قمعية الشكل مبهرجة عطرة ومتعددة الألوان)",
 "frangipanni": "بلوميريا, فتنة (أي من الشجيرات أو الأشجار النفضية الاستوائية الأمريكية المختلفة من جنس بلوميريا ذات عصارة لبنية وأزهار قمعية الشكل مبهرجة عطرة ومتعددة الألوان)",
 "frank": "إِفْرَنْجِيّ",
 "frank breech": "ولادة مقعدية صريحة (وضعية للجنين تكون فيها الأرداف عند مخرج الحوض للأم)",
 "frank breech delivery": "ولادة مقعدية صريحة (وضعية للجنين تكون فيها الأرداف عند مخرج الحوض للأم)",
 "frankenstein": "فرانكنشتاين (قوة أو كيان يخرج عن السيطرة ويدمر خالقه)",
 "frankfurt": "فَرَانْكْفُورْت",
 "frankfurt am main": "فرانكفورت على الماين, فرانكفورت أم ماين",
 "frankfurt an der oder": "فرانكفورت على أودر",
 "frankfurter": "نقانق, هوت دوغ (سجق ناعم القوام من لحم البقر أو الخنزير المفروم وعادة ما يكون مدخناً؛ يقدم غالباً في خبز)",
 "frankfurter bun": "خبز النقانق, خبز الهوت دوغ (لفافة طويلة مشكلة لتحتوي النقانق)",
 "frankincense": "لُبَان",
 "frankincense pine": "صنوبر اللبان, صنوبر لوبلولي (صنوبر طويل منتشر ثلاثي الإبر من جنوب شرق الولايات المتحدة له لحاء متشقق بني محمر ورأس علوي كثيف ممتلئ)",
 "franking": "تخليص بريدي, دمغة بريدية (جهاز أو علامة مثل طابع بريدي، أو انطباعات مطبوعة أو مختومة، أو ترميزات، أو ملصقات، أو كتابات يدوية، أو أي شكل آخر معتمد من العلامات الملصقة أو…)",
 "franking machine": "آلة تخليص بريد (آلة تختم الرسائل أو الطرود المارة عبرها تلقائياً وتحسب التكلفة الإجمالية)",
 "frankish": "إِفْرَنْجِيّ",
 "franklin": "فرانكلين (مالك أرض (في القرنين 14 و 15) كان حراً ولكنه ليس من أصل نبيل)",
 "frankliniella fusca": "تربس التبغ (ضار بالتبغ والفول السوداني النامي)",
 "frankly": "بِصَراحة",
 "frankness": "صراحة (سمة كون المرء صريحاً ومباشراً) / صدق, صراحة (صفة كون الشخص صادقاً ومباشراً في الموقف والكلام)",
 "frantic": "مَجْنُون, مَحْمُوم (في حالة هياج مفرط؛ مذهول من الخوف أو العاطفة العنيفة) / مَجْنُون, مَحْمُوم (يَتَّسِمُ بِالإِثَارَةِ أَوِ الانْفِعَالِ غَيْرِ المُسَيْطَرِ عَلَيْه)",
 "frantically": "بجنون, بهيجان (بطريقة لا يمكن كبحها)\nمثال: قاومت بجنون",
 "frappe": "فرابيه, مثلجات (تحلية مجمدة بنكهة الفاكهة (خاصة تلك التي لا تحتوي على حليب)) / فرابيه, مخفوق مثلج (مخفوق حليب سميك يحتوي على آيس كريم) / فرابيه ليكيور (مشروب كحولي (ليكيور) يصب فوق ثلج مجروش)",
 "fraser fir": "شوح فريزر (شوح صغير سريع النمو ولكنه قصير العمر من جنوب الأليغني يشبه الشوح البلسمي ولكن بأوراق قصيرة جداً)",
 "frasera speciosa": "جنطيانا خضراء (عشب طويل له عثاكيل من الزهور البيضاء المشوبة بالخضرة؛ شمال غرب الولايات المتحدة؛ يوضع أحياناً في جنس سويرتيا)",
 "frat": "أخوية, نادي أخوي (نادي اجتماعي للطلاب الجامعيين الذكور)",
 "frat house": "بيت الأخوية (منزل يستخدم كسكن لفرع من أخوية طلابية)",
 "fratercula arctica": "بفن أطلسي (بفن شائع في شمال المحيط الأطلسي)",
 "fratercula cirrhata": "بفن ذو عرف (بفن شمال المحيط الهادئ ذو ريشة صفراء كبيرة فوق كل عين)",
 "fratercula corniculata": "بفن مقرن (بفن شمال المحيط الهادئ)",
 "fraternal": "أَخَوِيّ",
 "fraternal nephew": "اِبْنُ الأَخ (الولد الذكر)\nمثال: هو له ابن صغير.",
 "fraternal niece": "بِنْت اَلْأَخ",
 "fraternal twin": "توأم غير متطابق (أحد توأمين تطورا من بويضتين مخصبتين منفصلتين)",
 "fraternally": "أخوياً, بشكل أخوي (بطريقة أخوية)",
 "fraternisation": "تَآخٍ, تَصَافٍ (الاختلاط بالآخرين بطريقة أخوية أو ودية؛ خاصة مع عدو)",
 "fraternity": "أُخُوَّة / أَخَوِيَّة",
 "fraternity house": "بيت الأخوية (منزل يستخدم كسكن لفرع من أخوية طلابية)",
 "fraternization": "مُؤَاخَاة",
 "fratricide": "قتل الأخ, قتل الشقيق (قتل الشخص لأخيه أو أخته) / نيران صديقة (نيران تصيب أو تقتل حليفاً) / قاتل أخيه (شخص يقتل أخاه أو أخته)",
 "frau": "فراو (لقب مجاملة ألماني أو صيغة خطاب لامرأة بالغة)",
 "fraud": "غِشّ, اِحْتِيال",
 "fraud in fact": "غش فعلي (خداع فعلي؛ إخفاء شيء ما أو تقديم عرض كاذب بنية شريرة لإلحاق الضرر بشخص آخر)",
 "fraud in law": "غش بحكم القانون (احتيال يُفترض من الظروف على الرغم من أن مرتكبه قد لا يكون لديه أي نية شريرة)",
 "fraud in the factum": "غش في المستند (الاحتيال الذي ينشأ عن التفاوت بين المستند المراد تنفيذه والمستند الذي تم تنفيذه بالفعل؛ على سبيل المثال، دفع شخص ما للتوقيع على العقد الخطأ)",
 "fraud in the inducement": "غش دافع للتعاقد (الاحتيال الذي يدفع الشخص عمداً إلى تنفيذ مستند أو إبرام اتفاقية أو إصدار حكم؛ على سبيل المثال، تضليل شخص ما بشأن الحقائق الحقيقية)",
 "fraudulence": "احتيال, خدعة (شيء يهدف إلى الخداع؛ حيلة متعمدة تهدف إلى الحصول على ميزة) / احتيال, خداع (صفة الاحتيال والمكر) / احتيال, ازدواجية (تمثيل احتيالي أو مزدوج)",
 "fraudulent": "محتال",
 "fraudulent scheme": "مخطط احتيالي, مشروع غير شرعي (مشروع غير قانوني (مثل الابتزاز أو الاحتيال أو تجارة المخدرات أو الدعارة) يتم تنفيذه من أجل الربح)",
 "fraudulently": "احتيالاً, غشاً (بطريقة غير شريفة ومحتالة)\nمثال: تم الحصول على هذا المال احتيالاً",
 "fraught": "مَمْلُوء",
 "fraulein": "فرويلاين (لقب مجاملة ألماني أو صيغة خطاب لامرأة غير متزوجة)",
 "fraxinella": "ديكتامنيوس, شجيرة محترقة (عشب معمر أوراسي بأزهار بيضاء تبعث بخاراً قابلاً للاشتعال في الطقس الحار)",
 "fraxinus americana": "مران أبيض (مران أمريكي منتشر بأوراق خضراء شاحبة أو فضية من الأسفل وخشب بني صلب)",
 "fraxinus caroliniana": "مران المستنقعات (مران صغير في المناطق المستنقعية بجنوب شرق الولايات المتحدة)",
 "fraxinus cuspidata": "مران مزهر (مران شجيري من جنوب غرب الولايات المتحدة له زهور بيضاء عطرة)",
 "fraxinus dipetala": "مران مزهر (مران شجيري من كاليفورنيا بزهور بيضاء مائلة للصفرة مبهرجة)",
 "fraxinus excelsior": "مران أوروبي, مران عالي (مران طويل من أوروبا إلى القوقاز له أوراق خضراء داكنة لامعة من الأعلى وشاحبة زغبية من الأسفل)",
 "fraxinus latifolia": "مران أوريغون (شجرة أخشاب من غرب أمريكا الشمالية تنتج خشباً خفيفاً صلباً؛ وثيقة الصلة بالمران الأحمر)",
 "fraxinus nigra": "مران أسود (شجرة أمريكية شمالية قوية الانتشار لها خشب ثقيل بني داكن؛ تتحول الأوراق إلى الذهب في الخريف)",
 "fraxinus oregona": "مران أوريغون (شجرة أخشاب من غرب أمريكا الشمالية تنتج خشباً خفيفاً صلباً؛ وثيقة الصلة بالمران الأحمر)",
 "fraxinus ornus": "مران المن (مران جنوب متوسطي له زهور بيضاء عطرة في عناقيد كثيفة وينتج المن)",
 "fraxinus pennsylvanica": "مران أحمر, مران زغبي (شجرة أمريكية صغيرة نوعاً ما بغصينات مخملية وأسطح أوراق سفلية مخملية)",
 "fraxinus pennsylvanica subintegerrima": "مران أخضر (صنف من المران الأحمر يتميز بغصينات وأسطح أوراق سفلية لامعة)",
 "fraxinus quadrangulata": "مران أزرق (مران من وسط وجنوب الولايات المتحدة بأوراق خضراء مزرقة وخشب بني صلب)",
 "fraxinus texensis": "مران تكساس (مران منخفض النمو من تكساس)",
 "fraxinus tomentosa": "مران اليقطين (شجرة أخشاب من وسط وجنوب شرق الولايات المتحدة لها غصينات مشعرة وقاعدة جذع منتفخة)",
 "fraxinus velutina": "مران أريزونا (مران شجيري صغير من جنوب غرب الولايات المتحدة وشمال غرب المكسيك)",
 "fray": "شِجَار عَلَنِيّ, عِرَاك (قتال صاخب)",
 "frayed": "مُهْتَرِئُ الأَطْرَافِ (بَالٍ أَوْ مُتَسَلِّخٌ عِنْدَ الحَوَافِّ)",
 "frazzle": "إنهاك تام (حالة من الإرهاق الشديد)\nمثال: لقد أُنكه التعب تماماً",
 "freak": "مدمن, مهووس (شخص مكرس لشيء ما بحماس شديد يشبه الإدمان) / شخص مشوه, مسخ (شخص أو حيوان غير عادي أو مشوه بشكل ملحوظ)\nمثال: مدمن غولف",
 "freak out": "خرج عن طوره (اِنْتَقَلَ إلى خارج المكان)\nمثال: خرج سامي ليحتفل.",
 "freakish": "شَاذّ, عَجِيب (غَيْرُ تَقْلِيدِيٍّ أَوْ غَيْرُ مَأْلُوفٍ بِشَكْلٍ لَافِتٍ لِلنَّظَر) / شَاذّ الشَّكْل, نَزَوِيّ (يتسم بخصائص الشذوذ والغرابة) / مُتَقَلِّب, نَزَوِيّ (سريع التحول والتغير بلا نمط ثابت)",
 "freakishly": "بِشَذُوذ, بِغَرَابَة (بشكل لا يمكن التنبؤ به)\nمثال: كان الطقس متقلباً بغرابة",
 "freakishness": "شُذُوذ, عَدَم سَوِيَّة (غرابة ملحوظة نتيجة لكون الشيء غير طبيعي)",
 "freaky": "غَرِيب",
 "freckle": "نَمَش",
 "freckled": "مُنَمَّش (مغطّى بالنمش أو يُشبهه)",
 "freddie mac": "فريدي ماك, مؤسسة رهن المنازل الفيدرالية (مؤسسة مرخصة من الكونغرس لتوفير سوق ثانوية للرهون العقارية السكنية)",
 "frederick": "فريدرش",
 "fredericton": "فريدريكتون",
 "free": "حُرّ (ضد البَرْد) / شَاغِر, فَاضٍ / بِغَيْرِ, بِدُونِ / مَجَّانًا / حَرَّرَ (يُصَغَّرُ عَلَى حُرَيْحٍ وَيُجْمَعُ عَلَى أَحْرَاحٍ؛ ضد الْعَبْدِ)\nمثال: أنا حر كالطائر.",
 "free agency": "انتقال حر ((رياضة) حالة اللاعب المحترف الحر في التفاوض على عقد للعب لأي فريق)",
 "free agent": "رُوح حُرَّة, شَخْص مُتَحَرِّر (شخص يتصرف بحرية أو حتى بمسؤولية أقل) / لاعب حر ((في الرياضة) رياضي محترف حر في توقيع عقد للعب مع أي فريق)",
 "free and clear": "خَالٍ مِنْ (بمعنى ظَنَّ، استخدام نادر والأغلب استخدام خَيْل أو مَخَالَة؛ أخو الأم. جمعه أخوال للمذكر وخالات للمؤنث)\nمثال: عندي ابنا خالة.",
 "free as a bird": "حُرّ كَالطَّائِر, حُرّ كَالْعُصْفُور (ضد البَرْد)\nمثال: أنا حر كالطائر.",
 "free association": "تداعي حر (عملية تفكير تقترح فيها الأفكار (كلمات أو صور) أفكاراً أخرى في تسلسل)",
 "free burning": "مُتَّصِل, مُسْتَدَام ((عَنِ القَوْسِ الكَهْرَبَائِيّ) مُسْتَمِرٌّ دُونَ انْقِطَاع)",
 "free central placentation": "وضع مشيمة مركزي سائب (حيث تتطور البويضات على عمود مركزي في مبيض مركب يفتقر للحواجز أو به حواجز عند القاعدة فقط)",
 "free electron": "إِلِكْتْرُون حُرّ (إلكترون غير مرتبط بذرة أو أيون أو جزيء ولكنه حر الحركة تحت تأثير مجال كهربائي)",
 "free energy": "طاقة ((في الفيزياء) كمية ديناميكية حرارية تكافئ قدرة نظام فيزيائي على القيام بشغل؛ وحدات الطاقة هي الجول أو الإرج)\nمثال: يمكن للطاقة أن تتخذ أشكالاً متنوعة",
 "free enterprise": "اقتصاد السوق, مشروع حر (اقتصاد يعتمد بشكل رئيسي على قوى السوق لتخصيص السلع والموارد وتحديد الأسعار)",
 "free fall": "انخفاض حاد, سقوط (انخفاض حاد ومفاجئ في كمية ما) / سقوط حر (حركة السقوط المثالية لشيء يخضع فقط لمجال الجاذبية)\nمثال: انخفاض بمقدار 57 نقطة في مؤشر داو جونز",
 "free form": "مورفيم حر (مورفيم يمكن أن يظهر بمفرده)",
 "free french": "فرنسا الحرة (حركة فرنسية خلال الحرب العالمية الثانية نظمها شارل ديغول في لندن للقتال من أجل تحرير فرنسا من السيطرة الألمانية واستعادة الجمهورية)",
 "free grace": "فضل إلهي, نعمة ((اللاهوت المسيحي) الفضل المجاني وغير المستحق من الله)\nمثال: تتجلى نعمة الله في خلاص الخطاة",
 "free hand": "تفويض مطلق, حرية التصرف (حرية التصرف كما تراه مناسباً)\nمثال: لدى الكثيرين شكوك حول منحه حرية التصرف للهجوم",
 "free house": "حانة حرة (حانة عامة لا يسيطر عليها مصنع جعة وبالتالي فهي حرة في بيع ماركات مختلفة من البيرة)",
 "free kick": "رَكْلَة حُرَّة, مُخَالَفَة",
 "free lance": "عامل مستقل, فريلانسر (كاتب أو فنان يبيع خدماته لأصحاب عمل مختلفين دون عقد طويل الأجل مع أي منهم)",
 "free list": "قائمة الإعفاء الجمركي (قائمة بالسلع التي لا تخضع للتعريفات الجمركية)",
 "free living": "حياة متحررة, حياة مرفهة (نمط حياة يميل إلى الانغماس السهل في الشهوات)",
 "free love": "جنس خارج إطار الزواج, حب حر (الجماع الجنسي بين أفراد غير متزوجين من بعضهم البعض)",
 "free lunch": "غداء مجاني, مكسب مجاني (شيء يتم الحصول عليه دون جهد أو دفع أو التزام)\nمثال: لا يوجد غداء مجاني في السياسة أو هوليوود",
 "free morpheme": "مورفيم حر (مورفيم يمكن أن يظهر بمفرده)",
 "free nerve ending": "نهاية عصبية حرة (نهايات عصبية حسية مجهرية في الجلد غير متصلة بأي مستقبل حسي محدد)",
 "free of charge": "مَجَّانِيّ, مَجَّانًا",
 "free palestine": "فِلِسْطِين حُرَّة (دَوْلَةُ فِلَسْطِين: مِنَ الْبُلْدَانِ الْعَرَبِيَّةِ بِالشَّرْقِ الأَوْسَطِ، عَاصِمَتُهَا الْقُدْسُ (مُحتَلَةٌ/ مُتَنَازَعٌ عَلَيْهَا)؛ مِنْطَقَةُ فِلَسْطِين: كُورَةٌ بالشّامِ، والْمَعْرُوفَةُ فيما بين الأُرْدُنّ وديار مِصْرَ، وأُمُّ بِلَادِهَا بيتُ المَقْدِسِ. وهي من أجناد الشام)\nمثال: الحرية لفلسطين.",
 "free pardon": "صفح, عفو (الفعل الرسمي لتحرير شخص ما)",
 "free people": "أحرار (الناس الذين يتمتعون بالحرية)\nمثال: موطن الأحرار والشجعان",
 "free phagocyte": "بلعمية حرة (خلية بلعمية تدور في الدم)",
 "free port": "ميناء حر (ميناء مفتوح بشروط متساوية لجميع السفن التجارية) / منطقة حرة, ميناء حر (منطقة مجاورة للميناء حيث يمكن استلام البضائع المعدة لإعادة الشحن وتخزينها دون دفع رسوم جمركية)",
 "free press": "صحافة حرة (صحافة غير مقيدة أو خاضعة لرقابة الحكومة فيما يتعلق بالسياسة أو الأيديولوجية)",
 "free radical": "جذر حر, شق طليق (ذرة أو مجموعة ذرات بها إلكترون واحد غير مزدوج على الأقل؛ في الجسم عادة ما يكون جزيء أكسجين فقد إلكتروناً وسيعمل على استقرار نفسه عن طريق سرقة إلكترون…)\nمثال: الجذور الحرة في الجسم هي جسيمات عالية الطاقة ترتد بعشوائية وتضر بالخلايا",
 "free rein": "يد مطلقة (عُضْو من أعضاء الجَسَد، من المَنْكِب إلى أطراف الأصابع؛ مَقْبَض)\nمثال: ليس باليد حيلة.",
 "free rhythm": "إيقاع حر (نوع من الإيقاع لا يتميز بلكنات متكررة وقيم زمنية غير محددة)\nمثال: يمكن اعتبار بعض الترانيم والمقطوعات الصوتية الإلقائية أمثلة على الإيقاع الحر",
 "free software": "بَرْمَجِيَّات حُرَّة",
 "free soil party": "حزب الأرض الحرة (حزب سياسي سابق في الولايات المتحدة؛ تشكل عام 1848 لمعارضة تمديد العبودية في المناطق؛ اندمج مع حزب الحرية في عام 1848)",
 "free speech": "حُرِّيَّة اَلتَّعْبِير, حُرِّيَّة الْكَلَام (الحُرِّيَة : الخلُوص من الشَّوائب أَو الرقّ أَو اللُّؤْم؛ الحُرِّيَة : حَقُّ الإنْسَانِ فِي اخْتِيَارِ مَا يُرِيدُ حَسَبَ اعْتِقَادِهِ…)\nمثال: الحرية لفلسطين.",
 "free spirit": "رُوح حُرَّة, شَخْص مُتَحَرِّر (شخص يتصرف بحرية أو حتى بمسؤولية أقل)",
 "free state": "ولاية حرة (أي ولاية كانت تحظر العبودية قبل الحرب الأهلية الأمريكية)",
 "free thought": "ربوبية, فكر حر (شكل من أشكال العقلانية اللاهوتية يؤمن بالله على أساس العقل دون الرجوع إلى الوحي)",
 "free throw": "رَمْيَة حُرَّة",
 "free throw lane": "منطقة الرمية الحرة (مسار في ملعب كرة السلة يمتد من خط النهاية إلى مسافة 15 قدماً أمام اللوحة الخلفية؛ لا يجوز للاعبين دخول هذا المسار أثناء الرمية الحرة)",
 "free time": "رَاحَة, خُلُو مِنَ الْعَمَل",
 "free trade": "تِجَارَة حُرَّة",
 "free trader": "مناصر التجارة الحرة (مدافع عن التجارة الدولية غير المقيدة)",
 "free verse": "شعر حر (شعر غير مقفى وبدون نمط وزني ثابت)",
 "free weight": "ثقل, وزن رياضي (معدات رياضية تستخدم في التمارين الرياضية ورفع الأثقال؛ وهي غير مثبتة بشيء وترفع وتخفض باستخدام اليدين والذراعين)",
 "free will": "حُرِّيَّة الْإِرَادَة (الحُرِّيَة : الخلُوص من الشَّوائب أَو الرقّ أَو اللُّؤْم؛ الحُرِّيَة : حَقُّ الإنْسَانِ فِي اخْتِيَارِ مَا يُرِيدُ حَسَبَ اعْتِقَادِهِ…)\nمثال: الحرية لفلسطين.",
 "free world": "الْعَالَم الْحُرّ",
 "free zone": "منطقة حرة, ميناء حر (منطقة مجاورة للميناء حيث يمكن استلام البضائع المعدة لإعادة الشحن وتخزينها دون دفع رسوم جمركية)",
 "free-and-easy": "تِلْقَائِيّ, عَفْوِيّ (طَبِيعِيٌّ وَغَيْرُ مُتَكَلَّفٍ)",
 "free-flying": "حُرّ الطَّيَرَان (قادر على الطيران في الهواء (كالطائر))",
 "free-for-all": "شِجَار صَاخِب (قتال صاخب وسط حشد من الناس)",
 "free-lance": "حر, مستقل (يعمل لنفسه (وليس موظفاً دائماً)) / عامل مستقل, فريلانسر (كاتب أو فنان يبيع خدماته لأصحاب عمل مختلفين دون عقد طويل الأجل مع أي منهم)",
 "free-liver": "مُنْغَمِس فِي الْمَلَذَّات (شخص يشبع شهواته الجسدية (خاصة الطعام والشراب) بحرية أكثر من المعتاد)",
 "free-living": "حُرُّ المَعِيشَة, غَيْرُ طُفَيْلِيّ (لَا يَتَطَفَّلُ عَلَى كَائِنٍ آخَر)",
 "free-range": "حُرُّ المَرْعَى, طَلِيق ((عَنِ المَوَاشِي وَالدَّوَاجِنِ) مَسْمُوحٌ لَهُ بِالرَّعْيِ الحُرِّ بَدَلًا مِنَ الحَبْسِ)",
 "free-reed": "ريشة حرة (ريشة لا تنطبق تماماً فوق الفتحة)",
 "free-reed instrument": "آلة ذات ريشة حرة (آلة نفخ ذات ريشة حرة)",
 "free-soil": "خَالٍ مِنَ العُبُودِيَّة (حَيْثُ كَانَتِ العُبُودِيَّة مَحْظُورَة)",
 "free-spoken": "صَرِيح, فَصِيح (يَتَّسِم بِالمُبَاشَرَة فِي الأُسْلُوب أَوِ الكَلَام؛ بِدُون مُوَارَبَة أَوْ تَهَرُّب)",
 "free-swimming": "حُرّ السِّبَاحَة, طَلِيق ((عن الحيوانات) قادر على السباحة بحرّيّة؛ غير مُثبَّت)",
 "free-tailed bat": "خفاش حر الذيل (خفاش صغير سريع آكل للحشرات ذو آذان جلدية وذيل طويل؛ شائع في المناطق الدافئة)",
 "free-thinking": "حُرّ الفِكْر, لَاعَقَائِدِيّ (يَرْفُض الانْصِيَاع لِلسُّلْطَة أَوِ العَقِيدَة الجَامِدَة (خَاصَّةً فِي الدِّين))",
 "freebee": "هدية مجانية (شيء مجاني (يتم تقديمه عادةً كجزء من مخطط ترويجي))\nمثال: كانت خارطة الطريق هدية مجانية",
 "freebie": "هدية مجانية (شيء مجاني (يتم تقديمه عادةً كجزء من مخطط ترويجي))\nمثال: كانت خارطة الطريق هدية مجانية",
 "freeboard deck": "سطح الطفو الحر (أعلى سطح مانع لتسرب الماء)",
 "freebooter": "سالب, ناهب (شخص يأخذ الغنائم أو الأسلاب (كما في الحرب))",
 "freeborn": "حُرّ المَوْلِد (وُلِدَ حُرًّا مِنْ أَبَوَيْن حُرَّيْن)",
 "freecell": "الخلية الحرة",
 "freedman": "مَعْتُوق",
 "freedom": "حُرِّيَّة, حرية (الحُرِّيَة : الخلُوص من الشَّوائب أَو الرقّ أَو اللُّؤْم؛ الحُرِّيَة : حَقُّ الإنْسَانِ فِي اخْتِيَارِ مَا يُرِيدُ حَسَبَ اعْتِقَادِهِ…) / حُرِّيَّة (الحُرِّيَة : الخلُوص من الشَّوائب أَو الرقّ أَو اللُّؤْم؛ الحُرِّيَة : حَقُّ الإنْسَانِ فِي اخْتِيَارِ مَا يُرِيدُ حَسَبَ اعْتِقَادِهِ…)\nمثال: الحرية لفلسطين.",
 "freedom day": "يَوْم الحُرِّيَّة (فترة من الزمان تبدأ عند غُرُوب الشمس وتنتهي عند غُرُوب شمس النهار التالي ويشمل اللَيْلَة ونَهَارا. طوله أربع وعشرين سَاعَة؛ النَهَار، يبدأ من طلوع الفَجْر إلى غُرُوب الشَمس، على المجاز)\nمثال: طقس اليوم جميل.",
 "freedom fighter": "محارب للحرية",
 "freedom from cruel and unusual punishment": "الحماية من العقوبة القاسية (حق يمنع فرض عقوبات قاسية وغير عادية)",
 "freedom from discrimination": "التحرر من التمييز (الحصانة من التمييز على أساس العرق أو الجنس أو الجنسية أو الدين أو العمر)",
 "freedom from double jeopardy": "الحرية من الخطر المزدوج, الحماية من الازدواجية في المحاكمة (حق مدني يمنع محاكمة الشخص مرتين لنفس الجرم)",
 "freedom from involuntary servitude": "التحرر من العبودية القسرية (حق مدني يمنع العمل القسري أو الاستعباد)",
 "freedom from search and seizure": "الحماية من التفتيش والمصادرة (حق يكفله الدستور (مثل التعديل الرابع للدستور الأمريكي))",
 "freedom from self-incrimination": "الحق في عدم تجريم الذات, حرية من تجريم الذات (الحق المدني في رفض الإجابة على الأسئلة أو الإدلاء بشهادة ضد النفس)",
 "freedom of assembly": "حُرِّيَّة التَّجَمُّع (الحُرِّيَة : الخلُوص من الشَّوائب أَو الرقّ أَو اللُّؤْم؛ الحُرِّيَة : حَقُّ الإنْسَانِ فِي اخْتِيَارِ مَا يُرِيدُ حَسَبَ اعْتِقَادِهِ…)\nمثال: الحرية لفلسطين.",
 "freedom of expression": "حُرِّيَّة التَّعْبِير (الحُرِّيَة : الخلُوص من الشَّوائب أَو الرقّ أَو اللُّؤْم؛ الحُرِّيَة : حَقُّ الإنْسَانِ فِي اخْتِيَارِ مَا يُرِيدُ حَسَبَ اعْتِقَادِهِ…)\nمثال: الحرية لفلسطين.",
 "freedom of religion": "حُرِّيَّة اَلدِّين, حُرِّيَّة اَلْمُعْتَقَد (الحُرِّيَة : الخلُوص من الشَّوائب أَو الرقّ أَو اللُّؤْم؛ الحُرِّيَة : حَقُّ الإنْسَانِ فِي اخْتِيَارِ مَا يُرِيدُ حَسَبَ اعْتِقَادِهِ…)\nمثال: الحرية لفلسطين.",
 "freedom of speech": "حرية التعبير, حرية الكلام (حق مدني يكفل الحق في نقل الآراء والأفكار لأي شخص يرغب في تلقيها)",
 "freedom of the press": "حُرِّيَّة اَلصِّحَافَة (الحُرِّيَة : الخلُوص من الشَّوائب أَو الرقّ أَو اللُّؤْم؛ الحُرِّيَة : حَقُّ الإنْسَانِ فِي اخْتِيَارِ مَا يُرِيدُ حَسَبَ اعْتِقَادِهِ…)\nمثال: الحرية لفلسطين.",
 "freedom of the seas": "حرية الملاحة (حق السفن التجارية في السفر بحرية في المياه الدولية)",
 "freedom of thought": "حرية الفكر (الحق في اعتناق أفكار غير شائعة)",
 "freedom rider": "راكِب الحُرِّيَّة (واحد من مجموعة ناشطي الحقوق المدنية من أعراق مختلفة ركبوا الحافلات عبر أجزاء من الجنوب الأمريكي للاحتجاج على الفصل العنصري)",
 "freedom to bear arms": "حق حمل السلاح (حق يكفله الدستور (مثل التعديل الثاني للدستور الأمريكي))",
 "freedperson": "مُحرر, مُعتَق (شخص تم تحريره من العبودية)",
 "freedwoman": "محررة, معتوقة (شخص أنثى تم تحريرها من العبودية)",
 "freehand": "يَدَوِيّ الرَّسْم (يُنجَز باليد دون أدوات أو أجهزة ميكانيكية)",
 "freehanded": "جَوَاد, سَخِيّ اليَد (يُعطي أو يُمنح بسخاء وبلا تردد) / يَدَوِيّ الرَّسْم (يُنجَز باليد دون أدوات أو أجهزة ميكانيكية)",
 "freehearted": "خَيِّر, مِعْطَاء (سخيّ في تقديم المساعدة للآخرين)",
 "freehold": "حيازة حرة, ملكية حرة (حيازة الأرض بملكية مطلقة أو مدى الحياة) / ملكية حرة, ملكية مطلقة (حيازة عقارية مطلقة أو مدى الحياة)",
 "freeholder": "مالك حر (مالك عقار حر)",
 "freeing": "إطلاق سراح, إفراج (فعل تحرير شخص أو شيء ما)",
 "freelance": "حر, مستقل (يعمل لنفسه (وليس موظفاً دائماً)) / عامل مستقل, فريلانسر (كاتب أو فنان يبيع خدماته لأصحاب عمل مختلفين دون عقد طويل الأجل مع أي منهم)",
 "freelancer": "عامل مستقل, فريلانسر (كاتب أو فنان يبيع خدماته لأصحاب عمل مختلفين دون عقد طويل الأجل مع أي منهم)",
 "freeloader": "انتهازي, طفيلي (شخص يستغل كرم الآخرين)",
 "freely": "بحرية (بطريقة حرة)\nمثال: تتميز اللوحة بضربات فرشاة حرة",
