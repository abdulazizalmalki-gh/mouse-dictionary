 "slivery": "شظوي, متشظ (يشبه أو يتكون من أو مغروس بشظايا طويلة ورفيعة (خاصة من الخشب) ذات رؤوس حادة)\nمثال: أرضية خشنة متشظية من ألواح الصنوبر القديمة",
 "slivovitz": "سليفوفيتس (براندي برقوق عديم اللون شائع في البلقان)",
 "slo-bid": "إليكسوفيلين, ثيوفيلين (قلويد بلوري عديم اللون مشتق من أوراق الشاي أو يصنع صناعياً؛ يستخدم في الطب كموسع للشعب الهوائية)",
 "sloanea jamaicensis": "كاسر الفأس (شجرة خشبية من جزر الهند الغربية ذات خشب صلب جداً)",
 "slob": "تَنْبَل",
 "slobber": "ريالة, لعاب سائل (اللعاب المنسكب من الفم)",
 "slobberer": "مُرَيِّل (شخص يسيل لعابه)\nمثال: ذلك الطفل مريّل؛ يحتاج إلى مريلة",
 "sloe": "برقوق السياج (فاكهة أرجوانية داكنة حامضة صغيرة خاصة لشجيرة برقوق أليغيني) / برقوق أليغني (برقوق بري من شمال شرق الولايات المتحدة له ثمار أرجوانية داكنة بلحم أصفر) / خوخ شائك, شجيرة الشوك الأسود (شجيرة أوراسية شائكة ذات ثمار تشبه البرقوق)",
 "sloe gin": "جن برقوق السياج (جن منكه بفاكهة برقوق السياج (ثمرة الشوك الأسود))",
 "slogan": "شِعَار (العلامة: وذلك من شعار العقلاء (مادة حلم من مجمع بحار الأنوار))\nمثال: الشعار ☭ هو رمز الشيوعية.",
 "sloganeer": "صائغ شعارات (شخص يصيغ ويستخدم الشعارات لترويج قضية)",
 "sloganeering": "ترويج الشعارات (الإقناع عن طريق الشعارات الفارغة)",
 "slogger": "ملاكم قوي اللكمات (ملاكم مشهور بقدرته على توجيه لكمات قوية) / دؤوب ببطء, عامل كدوب (شخص يعمل ببطء ورتابة لساعات طويلة) / سائر بتثاقل (شخص يمشي بطريقة مجهدة وثقيلة الخطى)",
 "sloop": "سلوب (سفينة شراعية بصارية واحدة مثبتة على بعد ثلث طول القارب خلف المقدمة)",
 "sloop of war": "سلوب حربي (سفينة حربية شراعية أو بخارية لها مدافع على سطح واحد فقط)",
 "slop": "ابتذال عاطفي (كتابة أو موسيقى حلوة وعاطفية بشكل مفرط) / حساء الخنازير, غسالة (علف رطب (خاصة للخنازير) يتكون غالباً من فضلات المطبخ ممزوجة بالماء أو الحليب منزوع الدسم) / حساء خفيف, طعام رديء ((عادة بالجمع) طعام أو شراب ضعيف أو مائي غير مشهٍ) / غسالة, مياه قذرة (مياه الصرف من المطبخ أو الحمام أو وعاء الغرفة التي يجب تفريغها يدوياً)\nمثال: عاش على الحساء الخفيف الذي توفره مطابخ الطعام",
 "slop basin": "وعاء الفضلات (للشاي) (وعاء تفرغ فيه بقايا أكواب الشاي والقهوة على الطاولة)",
 "slop bowl": "وعاء الفضلات (للشاي) (وعاء تفرغ فيه بقايا أكواب الشاي والقهوة على الطاولة)",
 "slop chest": "مخزن السفينة (مخزن تموين على متن السفن التجارية لبيع البضائع للطاقم)",
 "slop jar": "دلو الفضلات السائلة (دلو كبير يستخدم لاستقبال مياه الصرف من حوض الغسيل)",
 "slop pail": "دلو الفضلات السائلة (دلو كبير يستخدم لاستقبال مياه الصرف من حوض الغسيل)",
 "slop-seller": "بائع ملابس رخيصة (تاجر في الملابس الجاهزة الرخيصة)",
 "slope": "مُنْحَدَر / مَيْل",
 "sloped": "قُطْرِيّ, مَائِل (ذو اتِّجاه مائل أو منحرف عن الأفق)",
 "sloping": "مَائِل, مُنْحَدِر (ذو شكل أو اتجاه مائل) / قُطْرِيّ, مَائِل (ذو اتِّجاه مائل أو منحرف عن الأفق)",
 "sloping trough": "مجرى مائل, مزلقة (قناة مائلة يمكن للأشياء أن تنحدر عبرها)",
 "slopingly": "بانحدار, بشكل مائل (بميل أو انحراف)",
 "slopped": "ثَمِل تَمَامًا, سَكْرَان طَافِح (فِي حَالَة سُكْرٍ شَدِيد)",
 "sloppily": "بإهمال, بشكل فوضوي (بطريقة مهملة)\nمثال: أُنجز هذا العمل بإهمال",
 "sloppiness": "ابتذال عاطفي, عاطفية مفرطة (عاطفي زائف بطريقة عاطفية مبالغ فيها) / إهمال, لا مبالاة (صفة عدم الحذر أو عدم بذل الجهد) / إهمال, رثاثة (نقص في النظام والترتيب؛ عدم الاعتناء به) / طين, وحل (بلل الأرض المغطاة أو المشبعة بالماء)\nمثال: أُلغيت لعبة البيسبول بسبب بلل الملعب",
 "sloppy": "غَيْر مُتْقَن, مُرْتَجَل (يَتَّسِم بِالإِهْمَال الشَّدِيد وعَدَم الدِّقَّة) / مُفْرِطُ العَاطِفَة (عاطفيّ بشكل مُفرط أو غير طبيعي) / فَضْفَاض, وَاسِع (غَيْر مُحْكَم؛ يَتَدَلَّى بِشَكْل فَضْفاض) / مُبَعْثَر (يَفْتَقِرُ إِلَى التَّرْتِيبِ وَالنِّظَام)",
 "sloppy joe": "سلوبي جو (لحم بقري مفروم (ليس قرصاً) مطبوخ في صلصة حارة ويقدم على خبز كعك)",
 "slops": "ملابس رخيصة (ملابس رخيصة (كما كانت توزع سابقاً على البحارة في بريطانيا)) / حساء الخنازير, غسالة (علف رطب (خاصة للخنازير) يتكون غالباً من فضلات المطبخ ممزوجة بالماء أو الحليب منزوع الدسم)",
 "slopseller": "بائع ملابس رخيصة (تاجر في الملابس الجاهزة الرخيصة)",
 "slopseller's shop": "متجر ملابس رخيصة (متجر يبيع ملابس جاهزة رخيصة)",
 "slopshop": "متجر ملابس رخيصة (متجر يبيع ملابس جاهزة رخيصة)",
 "sloshed": "ثَمِل تَمَامًا, سَكْرَان طَافِح (فِي حَالَة سُكْرٍ شَدِيد)",
 "slot": "فتحة إدخال (شق صغير (لإدخال عملة معدنية أو إيداع البريد)) / آلة القمار, سلوت (آلة قمار تستخدم للمقامرة) / شق, فتحة ((حاسوب) مقبس في الحاسوب المصغر يقبل لوحة دوائر إضافية) / خَانَة, مَوْقِع نَحْوِيّ (موقع في بناء لغوي نحوي يمكن فيه تبادل مجموعة متنوعة من الوحدات البديلة)\nمثال: وضع ربع دولار في الفتحة",
 "slot machine": "آلة بيع, آلة قمار (آلة يتم تشغيلها عن طريق إدخال عملة معدنية في فتحة)",
 "sloth": "كَسَل / كَسْلَان",
 "sloth bear": "دب الكسلان (دب شائع خشن الشعر طويل الخطم من جنوب وسط آسيا)",
 "slothful": "كَسُول, مُتَقَاعِس (غَيْر رَاغِب فِي العَمَل أَوِ الجُهْد)",
 "slothfulness": "خمول, كسل (عزوف عن العمل أو بذل الجهد)",
 "slouch": "انحناء, ترهل (انحناء القامة عند الوقوف والمشي) / شخص غير كفء, متكاسل (شخص غير كفء؛ تستخدم عادة في صيغ النفي)\nمثال: إنه ليس متكاسلاً عندما يتعلق الأمر بالبيسبول",
 "slouch hat": "قبعة الفرسان, قبعة مرنة (قبعة لباد ناعمة بحافة مرنة واسعة)",
 "sloucher": "مُتَهَادِل, مُحْدَوْدِب الظَّهْر (شخص يقف أو يمشي بظهر منحنٍ وأكتاف متهدلة)",
 "slouchily": "بشكل مترهل (بطريقة مترهلة)\nمثال: مرتدي ملابس بشكل مترهل",
 "slouchingly": "بانحناء كسل, بتهدل (بمشية أو وقفة متهدلة)\nمثال: وقف بتهدل عند بوابة الحديقة",
 "slouchy": "مُتَرَهِّل (يَفْتَقِرُ إِلَى الصَّلَابَةِ فِي الشَّكْلِ أَوِ الوَضْعِيَّة)",
 "slough": "سَلْخ (قشر الجلد عن اللحم؛ نزع الشيء عن الشيء بقوة) / اِنْسَلَخَ, سَلَخَ\nمثال: سلخ زيري ذلك الغزال.",
 "slough grass": "عشبة الحبل البراري, عشبة الحبل للمياه العذبة (عشبة حبل أمريكية شمالية ذات أوراق بحواف غشائية جافة وقنابات بسفا طويل)",
 "slough of despond": "قنوط شديد, مستنقع اليأس ((رسمي) اكتئاب شديد)",
 "sloughing": "انسلاخ, تساقط (العملية التي يتم بموجبها التخلص من شيء ما)",
 "sloughy": "مُسْتَنْقَعِيّ, وَحِل ((عن التربة) ليّنة ومشبَعة بالماء)",
 "slovak": "سْلُوفَاكِيّ",
 "slovak language": "اللغة السلوفاكية (اللغة السلافية التي يتم التحدث بها في سلوفاكيا)",
 "slovak republic": "جُمْهُورِيَّة سْلُوفَاكِيَا",
 "slovakia": "سُلُوفَاكِيَا",
 "slovakian": "سلوفاكي (من أو يتعلق بسلوفاكيا أو شعبها أو لغتها أو يميزهم)",
 "slovakian monetary unit": "وحدة نقدية سلوفاكية (الوحدة النقدية في سلوفاكيا)",
 "sloven": "فوضوي, قذر (شخص فظ ومكروه وغير مرتب)",
 "slovene": "سْلُوفِينِيّ",
 "slovene language": "اللغة السلوفينية (اللغة السلافية للسلوفينيين)",
 "slovenia": "سُلُوفِينِيَا",
 "slovenian": "سلوفيني (من أو يتعلق بسلوفينيا أو شعبها أو لغتها أو يميزهم) / اللغة السلوفينية (اللغة السلافية للسلوفينيين) / سلوفيني (مواطن أو ساكن في سلوفينيا)\nمثال: استقلال سلوفيني",
 "slovenian language": "اللغة السلوفينية (اللغة السلافية للسلوفينيين)",
 "slovenian monetary unit": "وحدة نقدية سلوفينية (الوحدة النقدية المستخدمة في سلوفينيا)",
 "slovenliness": "إهمال المظهر, قذارة (عدم نظافة معتادة) / إهمال, رثاثة (نقص في النظام والترتيب؛ عدم الاعتناء به)",
 "slovenly": "قَذِر, مُهْمَل (مُهْمِلٌ لِلنَّظَافَةِ خَاصَّةً فِي المَلْبَسِ وَالمَظْهَرِ الشَّخْصِيّ)",
 "slovenly person": "فوضوي, قذر (شخص فظ ومكروه وغير مرتب)",
 "slovincian": "سْلُوفِينْسِيَّة, لُغَة سْلُوفِينْسِيَّة",
 "slow": "بَطِيء / أَبْطَأَ, بَطَّأَ",
 "slow lane": "الحارة البطيئة, المسار البطيء (الحارة المرورية للمركبات التي تتحرك ببطء)",
 "slow loris": "لوريس بطيء (ليمور ممتلئ الجسم من جنوب شرق آسيا)",
 "slow match": "فتيل بطيء (عود ثقاب أو فتيل مصنوع ليحترق ببطء وبشكل متساوٍ)",
 "slow motion": "حركة بطيئة (فيلم يحدث ظاهرياً بسرعة أبطأ من السرعة الطبيعية؛ يتحقق بتصوير الفيلم بمعدل أسرع)",
 "slow time scale": "مقياس زمني ممتد ((محاكاة) المقياس الزمني المستخدم في معالجة البيانات عندما يكون عامل المقياس الزمني أكبر من واحد)",
 "slow virus": "فيروس بطيء (فيروس يظل خاملاً في الجسم لفترة طويلة قبل ظهور الأعراض)\nمثال: مرض كورو يسببه فيروس بطيء",
 "slow-burning stove": "موقد بطيء الاحتراق (موقد يتحكم فيه مدخل الهواء لإبطاء عملية الاحتراق)",
 "slow-moving": "بَطِيء الحَرَكَة (يَتَحَرَّك بِبُطْء)",
 "slow-witted": "بَطِيء الفَهْم, ضَعِيف العَقْل (متأخر في التطور العقلي والذهني)",
 "slow-wittedness": "بلادة, ثقل فهم (صفة البطء العقلي والمحدودية)",
 "slowcoach": "بطيء الحركة, بليد (شخص يتحرك ببطء)",
 "slowdown": "تباطؤ, تلكؤ (فعل الإبطاء أو التخلف عن الركب)",
 "slower": "أبطأ (ببطء أكثر)",
 "slowest": "الأبطأ (بأقصى بطء)",
 "slowgoing": "بَطِيء, مُتَرَاخٍ (لا يميل إلى المبادرة أو الاجتهاد)",
 "slowing": "إبطاء, تباطؤ (نقصان في معدل التغير)\nمثال: تباطؤ سباق التسلح",
 "slowly": "بِبُطْء",
 "slowness": "بطء, تأنٍ (معدل يظهر غياب العجلة أو التسرع) / تأخر, تخلف عقلي (نقص في التطور الطبيعي للقدرات الفكرية) / خرق, عدم براعة (عدم المهارة الناتج عن نقص التدريب)",
 "slowpoke": "بطيء الحركة, بليد (شخص يتحرك ببطء)",
 "slowworm": "برص أعمى, دودة بطيئة (سحلية أوروبية صغيرة تحفر الجحور وعديمة الأرجل ذات عيون صغيرة جداً؛ يُعتقد شعبياً أنها عمياء)",
 "sls": "لوريل كبريتات الصوديوم (منظف كاوٍ مفيد لإزالة الشحوم؛ وعلى الرغم من إدراجه عادة في منتجات العناية الشخصية (الشامبو ومعاجين الأسنان وما إلى ذلك) إلا أنه قد يهيج الجلد ويجب…)",
 "slub": "تكتل, عقدة (كتلة ناعمة أو عدم استواء في خيط؛ إما عيب أو مخلوق بالتصميم)",
 "slubbed": "ذُو عُقَدٍ, مُعَقَّد (ذو نسيج خشن وعُقد بارزة كالقماش المنزلي)",
 "sludge": "حَمَأ, حَمأَة ((حَمَأَ) الْبِئْر حَمَأً: أخرج حمأتها) / رُسَابَة",
 "slug": "بَزَّاقَة",
 "slug cutter": "قاطعة السبائك, قاطعة المسطر الطباعي (أداة قطع تستخدم لقطع المسافات (التباعد بين الأسطر) والسبائك (قطع سميكة من الرصاص لتوفير الدعم لتجهيز نماذج الطباعة))",
 "slugabed": "كسول, نؤوم (شخص يبقى في السرير حتى ساعة متأخرة نسبياً)",
 "slugfest": "قِتَال بِالأَيْدِي, مُلَاكَمَة (قتال بقبضات اليد العارية)",
 "sluggard": "بليد, كسول (شخص خامل كسول)",
 "slugger": "ضارب, ضارب الكرة ((في البيسبول) لاعب الكرة الذي يقوم بضرب الكرة بالمضرب) / ملاكم قوي اللكمات (ملاكم مشهور بقدرته على توجيه لكمات قوية)",
 "sluggish": "بَلِيد, خَامِل (بطيء ولا مُبالٍ) / بَطِيء, رَاكِد ((عن الأعمال التجاريّة) غير نشط أو رائج) / خَامِل, كَسُول (بَطِيء أَوْ مُتَرَاخٍ فِي الحَرَكَة)",
 "sluggishly": "ببطء, بكسل (بطريقة بطيئة)\nمثال: تصاعد الدخان ببطء",
 "sluggishness": "تراخ, سبات (خمول؛ إظهار نقص غير عادي في الطاقة) / خمول, ركود (وتيرة الأشياء التي تتحرك ببطء نسبي) / خمول مرضي, وسن (حالة من السبات تشبه الغيبوبة (كما توجد في مرض النوم))\nمثال: أقلق المظهر العام للسبات أصدقاءه",
 "sluice": "فُتْحَةُ التَّصْرِيف (فِي اللُّغَةِ الْعَرَبِيَّةِ (إعراب) : الفَتْحَة أو الفَتْح هي إحدى الحركات التشكيلية في اللغة العربية…؛ الثُّقْب و الْمَنْفَذ)\nمثال: انظر من الفتحة.",
 "sluice gate": "خَوْخَة",
 "sluice valve": "بوابة هويس, صمام هويس (منظم يتكون من صمام أو بوابة تتحكم في معدل تدفق المياه عبر هويس)",
 "sluicegate": "بوابة هويس, صمام هويس (منظم يتكون من صمام أو بوابة تتحكم في معدل تدفق المياه عبر هويس)",
 "sluiceway": "قناة بوابية, مجرى مائي محكوم (قناة تحمل تدفقاً سريعاً للمياه يتم التحكم فيه بواسطة بوابة سد)",
 "sluicing": "متدفق, منهمر (ينصب من أو كما لو كان من قناة تصريف)\nمثال: المطر المنهمر",
 "slum": "مِنْطَقَة عَشْوَائِيَّة (المِنْطَقةُ: المَنْطِقَةُ؛ مِنْطَقَةُ: مُقَاطَعَةٌ)\nمثال: غزة منطقة مكشوفة.",
