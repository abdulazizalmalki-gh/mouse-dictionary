 "southbound": "مُتَّجِه جَنُوبًا (يتحرك باتجاه الجنوب)",
 "southeast": "باتجاه الجنوب الشرقي (إلى أو نحو أو في الجنوب الشرقي) / جَنُوب شَرْقِيّ (يقع في الجنوب الشرقي أو موجَّه نحوه) / قَادِم مِنَ الجَنُوب الشَّرْقِيّ (قادم من اتجاه الجنوب الشرقي) / جنوب شرق (موقع في الجزء الجنوبي الشرقي من بلد أو منطقة أو مدينة)",
 "southeast asia": "جَنُوب شَرْق آسِيَا (الْجِهَةُ الْمُقَابِلَةُ لِلشَّمَال؛ رِيحٌ تَهُبُّ مِنَ الْجَنُوب)\nمثال: لا بد أنه من الجنوب.",
 "southeast by east": "الجَنُوب الشَّرْقِيّ المَائِل لِلشَّرْق, جَنُوب شَرْقِيّ لِشَرْق (نقطة البوصلة التي تقع شرق الجنوب الشرقي بنقطة واحدة)",
 "southeast by south": "الجَنُوب الشَّرْقِيّ المَائِل لِلجَنُوب, جَنُوب شَرْقِيّ لِجَنُوب (نقطة البوصلة التي تقع جنوب الجنوب الشرقي بنقطة واحدة)",
 "southeaster": "رياح جنوبية شرقية (رياح قوية من الجنوب الشرقي)",
 "southeasterly": "جَنُوب شَرْقِيّ (يقع في الجنوب الشرقي أو موجَّه نحوه) / قَادِم مِنَ الجَنُوب الشَّرْقِيّ (قادم من اتجاه الجنوب الشرقي)",
 "southeastern": "جَنُوبِيٌّ شَرْقِيّ (من منطقة في الولايات المتحدة تشمل عموماً ألاباما وجورجيا وفلوريدا وتينيسي) / جَنُوب شَرْقِيّ (يقع في الجنوب الشرقي أو موجَّه نحوه)",
 "southeastern pocket gopher": "غوفر جيبي جنوبي شرقي (غوفر يعيش في ألاباما وجورجيا وفلوريدا)",
 "southeastward": "باتجاه الجنوب الشرقي (في اتجاه الجنوب الشرقي) / بِاتِّجَاه الجَنُوب الشَّرْقِيّ (نحو الجنوب الشرقي) / الجَنُوب الشَّرْقِيّ (نقطة البوصلة في منتصف المسافة بين الجنوب والشرق؛ عند 135 درجة)\nمثال: يتدفق النهر باتجاه الجنوب الشرقي نحو الخليج",
 "southeastwardly": "باتجاه الجنوب الشرقي (في اتجاه الجنوب الشرقي)\nمثال: يتدفق النهر باتجاه الجنوب الشرقي نحو الخليج",
 "souther": "رياح جنوبية (رياح تهب من الجنوب)",
 "southerly": "جنوبياً, من الجنوب (قادماً من الجنوب) / جنوباً, نحو الجنوب (باتجاه الجنوب) / جَنُوبِيّ المَصْدَر (قادم من الجنوب؛ يوصف به خاصة الرياح) / جَنُوبِيّ الاتِّجَاه (يقع في الجنوب أو موجَّه نحوه)\nمثال: هبت رياح جنوبية",
 "southern": "جَنُوبِيّ",
 "southern arrow wood": "خشب السهم, رباطية مسننة (شجيرة نفضية من شرق أمريكا الشمالية لها توت أزرق مسود وخشب مرن قوي كان يستخدم سابقاً لصنع السهام)",
 "southern aster": "أستر جنوبي",
 "southern baptist": "معمداني جنوبي (عضو في الاتفاقية المعمدانية الجنوبية)",
 "southern baptist convention": "المؤتمر المعمداني الجنوبي (رابطة المعمدانيين الجنوبيين)",
 "southern beech": "زان جنوبي, زان دائم الخضرة (أي من أشجار الزان المختلفة في نصف الكرة الجنوبي ذات أوراق صغيرة دائمة الخضرة عادة)",
 "southern beech fern": "سرخس الزان الجنوبي, سرخس الزان العريض (سرخس زان في غابات أمريكا الشمالية بخطوط بلون القش)",
 "southern blue flag": "سوسن جنوبي أزرق (يشبه السوسن الأزرق؛ شرق الولايات المتحدة)",
 "southern bog lemming": "لاموس المستنقعات الجنوبي (من المستنقعات المنخفضة والمروج في شمال شرق ووسط الولايات المتحدة وجنوب كندا)",
 "southern buckthorn": "بوميلية, نبق جنوبي (شجرة شجيرية شائكة متساقطة الأوراق في جنوب شرق الولايات المتحدة ذات زهور بيضاء وثمار سوداء صغيرة تشبه الحسلة)",
 "southern bug": "بُوه الْجَنُوبِيّ",
 "southern cabbage butterfly": "فراشة الملفوف الجنوبية (شكل شائع في أمريكا الشمالية لفراشة الملفوف)",
 "southern crab apple": "تفاح بري جنوبي (شجرة صغيرة أو شجيرة من جنوب شرق الولايات المتحدة؛ تزرع للزينة لأزهارها الوردية اللون)",
 "southern cross": "صَلِيب اَلْجَنُوب",
 "southern cypress": "سرو أصلع, سرو المستنقعات (خشب سرو شائع في جنوب شرق الولايات المتحدة له جذع موسع عند القاعدة؛ يوجد في المستنقعات الساحلية وقيعان الأنهار الفيضية) / سرو أصلع, سرو المستنقعات (سرو شائع في جنوب شرق الولايات المتحدة له جذع متوسع عند القاعدة؛ يوجد في المستنقعات الساحلية وقيعان الأنهار الفيضية)",
 "southern dewberry": "ديوبيري جنوبي (من جنوب أمريكا الشمالية)",
 "southern europe": "أُورُوبَّا اَلْجَنُوبِيَّة (الجزء من يوراسيا الذي يقع غرب جبال الأورال، والمعتبر تقليديًّا قارة بحد ذاته، كما يقع شمال قارة إفريقيا، وغرب قارة آسيا، وشرق المحيط الأطلسي؛ كيان سياسي؛ الاتحاد الأوروبي)\nمثال: ذهبت إلى أوروبا مرة.",
 "southern flounder": "فلو ندر جنوبي (سمكة مفلطحة في جنوب الولايات المتحدة)",
 "southern flying squirrel": "سنجاب طائر جنوبي (سنجاب طائر ليلي صغير كبير العينين من شرق الولايات المتحدة)",
 "southern harebell": "جريس جنوبي (زهرة الجرس من جنوب شرق الولايات المتحدة (ماريلاند إلى جورجيا) ذات أزهار زرقاء شاحبة)",
 "southern hemisphere": "نِصْف اَلْكُرَة الْأَرْضِيَّة الجَنُوبِيّ",
 "southern kurdish": "الكُرْدِيَّة الجُنوبِيَّة",
 "southern lights": "شفق قطبي جنوبي (الشفق القطبي في نصف الكرة الجنوبي)",
 "southern live oak": "سنديان حي جنوبي, سنديان فرجينيا (شجرة دائمة الخضرة متوسطة الحجم موطنها شرق أمريكا الشمالية إلى الساحل الشرقي للمكسيك؛ تزرع غالباً كشجرة ظل لتاجها واسع الانتشار؛ خشبها صلب للغاية…)",
 "southern magnolia": "ماغنوليا جنوبية, ماغنوليا كبيرة الأزهار (شجرة دائمة الخضرة في جنوب الولايات المتحدة ذات أوراق لامعة صلبة كبيرة وزهور بيضاء ضخمة حلوة الرائحة)",
 "southern maidenhair": "شعر الزهرة, كزبرة البئر (سرخس كزبرة البئر الرقيق بسيقان أوراق سوداء لامعة رفيعة؛ عالمي الانتشار)",
 "southern ocean": "اَلْمُحِيط اَلْمُتَجَمِّد اَلْجَنُوبِيّ, اَلْمُحِيط اَلْجَنُوبِيّ",
 "southern porgy": "سكوب, مرجان جنوبي (مرجان المياه الساحلية الأطلسية الجنوبية لأمريكا الشمالية)",
 "southern red cedar": "عرعر أحمر جنوبي (عرعر المناطق الساحلية المستنقعية في جنوب شرق الولايات المتحدة؛ مشابه للعرعر الأحمر الشرقي)",
 "southern red oak": "سنديان أحمر جنوبي, سنديان إسباني (شجرة نفضية كبيرة مستديرة القمة ذات فروع منتشرة وأوراق ضيقة منجلية الشكل ذات فصوص عميقة التموج، وخشبها مشابه لخشب السنديان الأحمر الشمالي؛ تنتشر من…)",
 "southern scup": "سكوب, مرجان جنوبي (مرجان المياه الساحلية الأطلسية الجنوبية لأمريكا الشمالية)",
 "southern spadefoot": "علجوم قدم المجرفة الجنوبي (يعيش هذا العلجوم ذو قدم المجرفة في جنوب غرب الولايات المتحدة)",
 "southern spatterdock": "قوصرة جنوبية (من نباتات المياه الجارية في جنوب شرق الولايات المتحدة؛ قد تشكل حصائر معيقة في الجداول)",
 "southern tai": "تاي الجنوبية (فرع من لغات تاي، يُتحدث به في المقاطعات الجنوبية لتايلاند)",
 "southern white cedar": "أرز أبيض أطلسي, سرو أبيض (أرز متوسط الحجم بطيء النمو من الساحل الشرقي للولايات المتحدة؛ يشبه العفص الأمريكي)",
 "southern yellow pine": "صنوبر أصفر جنوبي, صنوبر طويل الأوراق (صنوبر كبير ثلاثي الإبر من جنوب شرق الولايات المتحدة له إبر طويلة جداً وأطراف ملتوية معقدة؛ اللحاء بني محمر مخدد بعمق؛ شجرة خشب مهمة)",
 "southerner": "جنوبي (أمريكي يعيش في الجنوب)",
 "southernism": "طابع جنوبي, نزعة جنوبية (موقف يميز سكان الجنوب (خاصة في الولايات المتحدة)) / تعبير جنوبي (عبارة أو نطق خاص بجنوب الولايات المتحدة)",
 "southernmost": "أَقْصَى الجَنُوب (يقع في أبعد نقطة جنوبًا)",
 "southernness": "جَنُوبِيَّة (خاصية الوجود باتجاه الجنوب)",
 "southernwood": "شيح قيصوم, قيصوم (شيح أوروبي شجيري متوطن في أمريكا الشمالية؛ يستخدم أحياناً في تخمير البيرة)",
 "southland": "الأراضي الجنوبية, الجنوب (أي منطقة تقع في الجنوب أو باتجاهه)",
 "southmost": "أَقْصَى الجَنُوب (يقع في أبعد نقطة جنوبًا)",
 "southpaw": "رامٍ أعسر (رامي بيسبول يرمي الكرة باليد اليسرى) / أَشْوَل, أَعْسَر (شخص يستخدم اليد اليسرى بمهارة أكبر من اليمنى)\nمثال: كان الرامي أعسر",
 "southward": "جنوباً, نحو الجنوب (باتجاه الجنوب) / مُتَّجِه جَنُوبًا (يتحرك باتجاه الجنوب) / الجَنُوب (نقطة البوصلة الأصلية التي تكون عند 180 درجة)\nمثال: اتجهت السفينة جنوباً",
 "southwards": "جنوباً, نحو الجنوب (باتجاه الجنوب)\nمثال: اتجهت السفينة جنوباً",
 "southwest": "باتجاه الجنوب الغربي (إلى أو نحو أو في الجنوب الغربي) / جَنُوب غَرْبِيّ (يقع في الجنوب الغربي أو موجَّه نحوه) / قَادِم مِنَ الجَنُوب الغَرْبِيّ (قادم من اتجاه الجنوب الغربي) / جنوب غرب (موقع في الجزء الجنوبي الغربي من بلد أو منطقة أو مدينة)",
 "southwest by south": "الجَنُوب الغَرْبِيّ المَائِل لِلجَنُوب, جَنُوب غَرْبِيّ لِجَنُوب (نقطة البوصلة التي تقع جنوب الجنوب الغربي بنقطة واحدة)",
 "southwest by west": "الجَنُوب الغَرْبِيّ المَائِل لِلغَرْب, جَنُوب غَرْبِيّ لِغَرْب (نقطة البوصلة التي تقع غرب الجنوب الغربي بنقطة واحدة)",
 "southwester": "رياح جنوبية غربية (رياح قوية من الجنوب الغربي)",
 "southwesterly": "جَنُوب غَرْبِيّ (يقع في الجنوب الغربي أو موجَّه نحوه) / قَادِم مِنَ الجَنُوب الغَرْبِيّ (قادم من اتجاه الجنوب الغربي)",
 "southwestern": "جَنُوبِيٌّ غَرْبِيّ (من منطقة في الولايات المتحدة تشمل عموماً نيو مكسيكو وأريزونا وتكساس وكاليفورنيا) / جَنُوب غَرْبِيّ (يقع في الجنوب الغربي أو موجَّه نحوه) / الجنوبية الغربية, الساكسونية الغربية (لهجة من الإنجليزية الوسطى، كان يتم التحدث بها في المنطقة الواقعة غرب ساسكس وجنوب وجنوب غرب نهر التايمز)",
 "southwestern lip fern": "سرخس الشفة الجنوبي الغربي (سرخس شفة من تكساس إلى أوكلاهوما وكولورادو وأريزونا والمكسيك بسعف منتصب طويل)",
 "southwestern toad": "علجوم جنوبي غربي (علجوم ممتلئ الجسم ثؤلولي بشكل موحد من الوديان والجداول في جنوب غرب الولايات المتحدة شبه القاحل)",
 "southwestern white pine": "صنوبر أبيض جنوبي غربي (صنوبر متوسط الحجم من شمال غرب المكسيك؛ اللحاء بني داكن ومخدد عند النضج)",
 "southwestward": "باتجاه الجنوب الغربي (في اتجاه الجنوب الغربي) / بِاتِّجَاه الجَنُوب الغَرْبِيّ (نحو الجنوب الغربي) / الجَنُوب الغَرْبِيّ (نقطة البوصلة في منتصف المسافة بين الجنوب والغرب؛ عند 225 درجة)",
 "southwestwardly": "باتجاه الجنوب الغربي (في اتجاه الجنوب الغربي)",
 "souvenir": "تَذْكار",
 "souvlaki": "سوفلاكي (مصنوع من لحم الضأن)",
 "souvlakia": "سوفلاكي (مصنوع من لحم الضأن)",
 "sovereign": "مُسْتَقِلّ (اسم فاعل مِن اِسْتَقَلَّ؛ من لا يعتمد على غيره) / عَاهِل, مَلِك\nمثال: الجزائر مستقلة الآن.",
 "sovereign immunity": "حصانة سيادية (إعفاء يمنع رفع دعوى قضائية ضد الحكومة ذات السيادة دون موافقتها)\nمثال: نشأ مبدأ الحصانة السيادية من القاعدة القائلة بأن الملك لا يخطئ",
 "sovereignty": "سِيَادَة, حَاكِمِيَّة (السِّيَادةُ : الشرفُ؛سادَ يَسُودُ سِيَادَةً، والاسمُ السُّؤدُد، وَهُوَ المَجْدُ و الشَّرفُ؛ ساد يسود سيادةً وسُودَداً وسؤْدُداً :عظُم ومجُد وشرُف)\nمثال: أوكرانيا دولة ذات سيادة.",
 "soviet": "سوفييت, سُوفْيَات",
 "soviet kgb": "كي جي بي, لجنة أمن الدولة (منظمة الشرطة الأمنية السائدة سابقًا في روسيا السوفيتية)",
 "soviet socialist republic": "جمهورية اشتراكية سوفيتية (واحدة من الدول التي كانت تشكل الاتحاد السوفيتي السابق (1922-1991))",
 "soviet union": "الْاِتِّحَادُ السُّوفْيَاتِيّ, الْاِتِّحَادُ السُّوفْيَتِيّ",
 "sovietism": "بلشفية, جماعية (الشيوعية السوفيتية)",
 "sovietness": "الطابع السوفيتي (حالة أو شرط كون الشيء سوفيتياً)\nمثال: يستكشف هذا الفصل مفهوم المساحات السوفيتية والطابع السوفيتي، باستخدام الفيلم كدليل",
 "soviets": "السوفييت (حكومة الاتحاد السوفيتي)\nمثال: قال السوفييت إنهم يريدون زيادة التجارة مع أوروبا",
 "sow": "خِنْزِيرَة / زَرَعَ, بَذَرَ (بَذَرَ الحَبَّ؛ أَنْبَتَ، نَمَّى)\nمثال: يريد الإنفصاليون زرع رايتهم بمواقع الأنترنت.",
 "sow bug": "قملة الخشب (متماثل أرجل أرضي ذو جسم مقسم بيضاوي)",
 "sow thistle": "تِفَاف, جَعْضِيض",
 "sowbane": "رجل الوزة الأحمر, سرمق هجين (عشبة تعتبر قاتلة للخنازير)",
 "sowbelly": "لحم بطن الخنزير المملح (لحم مملح من بطن ذبيحة الخنزير)",
 "sowbread": "خبز الخنزير, سيكلامين لبلابي الأوراق (سيكلامين أوروبي بري شائع بزهور وردية)",
 "sower": "باذر, زارع (الشخص الذي يقوم بنثر البذور للزراعة)",
 "sown": "مَبْذُور (نُثرت عليه البذور للزراعة)",
 "soy": "صُويَا",
 "soy flour": "دقيق الصويا (دقيق مصنوع من فول الصويا)",
 "soy milk": "حَلِيب صُويَا (هو اللَبَن المَحْلُوْب، أو ما لم يتغير طعمه. أصل التسمية؛ هو ما لم يَرُوْب واللَبَن هو ما رَابَ)\nمثال: كنت أشرب الحليب",
 "soy sauce": "صَلْصَةْ اَلصُّويَا",
 "soya": "صويا, فول الصويا (أكثر الخضراوات المعروفة احتواءً على البروتين؛ تستخدم ثمرة نبات الصويا في مجموعة متنوعة من الأطعمة وكعلف (خاصة كبديل للبروتين الحيواني)) / صويا, فول الصويا (عشب حولي منتصب كثيف الشعر له أوراق ثلاثية وزهور أرجوانية إلى وردية؛ يزرع على نطاق واسع للغذاء والعلف ولتحسين التربة، وخاصة لبذوره المغذية الغنية…)",
 "soya bean": "صويا, فول الصويا (أكثر الخضراوات المعروفة احتواءً على البروتين؛ تستخدم ثمرة نبات الصويا في مجموعة متنوعة من الأطعمة وكعلف (خاصة كبديل للبروتين الحيواني)) / صويا, فول الصويا (عشب حولي منتصب كثيف الشعر له أوراق ثلاثية وزهور أرجوانية إلى وردية؛ يزرع على نطاق واسع للغذاء والعلف ولتحسين التربة، وخاصة لبذوره المغذية الغنية…) / فول الصويا (مصدر للزيت؛ يستخدم للعلف وتحسين التربة وكغذاء)",
 "soya milk": "حليب الصويا (بديل للحليب يحتوي على دقيق فول الصويا والماء؛ يستخدم في بعض تركيبات الرضع وفي صنع التوفو)",
 "soyabean oil": "زيت فول الصويا (زيت مستخرج من فول الصويا)",
