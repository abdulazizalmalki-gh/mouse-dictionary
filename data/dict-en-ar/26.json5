 "smartly": "بأناقة, على الموضة (بطريقة عصرية وأنيقة) / بقوة, بنشاط (بنشاط وحيوية) / ببراعة, بذكاء (بطريقة ذكية)\nمثال: كان يرتدي ملابس أنيقة",
 "smartness": "خفة, سرعة استجابة (حيوية ولهفة) / أَنَاقَة عَصْرِيَّة, شِيَاكَة (الأناقة بحكم مسايرة الموضة) / ذكاء, شطارة (الذكاء الذي يظهر في سرعة البديهة والفطنة) / ألم لاسع, حرقان (نوع من الألم مثل الذي يسببه جرح أو حرق أو تقرح)\nمثال: قبل بخفة",
 "smartphone": "هَاتِف ذَكِيّ, سِمَارْت فُون (جهاز يستخدم للتحدث؛ الصوت يسمع دون أن يرى صاحبه)\nمثال: رن الهاتف تكرارا.",
 "smash": "كَسَّرَ / تَكَسَّرَ",
 "smash hit": "بلوك باستر, عمل ضخم النجاح (نجاح غير عادي مع شعبية واسعة ومبيعات ضخمة (خاصة لفيلم أو مسرحية أو تسجيل أو رواية))",
 "smash-up": "تحطم, تصادم عنيف (تصادم خطير (خاصة للمركبات الآلية))",
 "smashed": "ثَمِل تَمَامًا, سَكْرَان طَافِح (فِي حَالَة سُكْرٍ شَدِيد)",
 "smasher": "عمل ناجح, نجاح ساحق (نجاح بارز وملحوظ) / حسناء, فاتنة (امرأة جذابة جداً أو مغرية المظهر) / مُحَطِّم, مُهَشِّم (شخص يهشم شيئاً ما)\nمثال: تلك الأغنية كانت أول عمل ناجح له ومثلت بداية مسيرته",
 "smashing": "تحطيم, تهشيم (عملية كسر شيء ما إلى قطع صغيرة) / رَائِع, مُمْتَاز (ممتاز؛ بالغ الجودة)",
 "smashingly": "باصطدام عنيف, بتحطم (بصوت تحطم عالٍ)\nمثال: اخترقت السيارة السياج بتحطم",
 "smatter": "لَحَنَ (وضع الألحان أو التأليف الموسيقي؛ قرأ النص بلحن أو أداء صوتي مميز)\nمثال: أنا أحب هذا اللحن.",
 "smattering": "إلمام بسيط, معرفة سطحية (فهم طفيف أو سطحي لموضوع ما) / حفنة, قلة (عدد أو كمية صغيرة)\nمثال: تم تلقي حفنة فقط من الردود",
 "smear": "دَهَنَ (طلى الشيء بالدهن أو الزيت أو الطيب؛ ضرب بالرفق) / لَوَّثَ\nمثال: توم بدهن غرفته.",
 "smear test": "اختبار باب, لطخة عنق الرحم (طريقة لفحص الخلايا المصبوغة في مسحة عنق الرحم للتشخيص المبكر لسرطان الرحم)",
 "smear word": "كَلِمَة تَشْوِيه (نعت يمكن استخدامه لتشويه سمعة شخص ما)\nمثال: استخدم كلمة التشويه 'شيوعي' لكل من اختلف معه",
 "smegma": "لَخَن",
 "smell": "رَائِحَة, رِيحة (الخاصية التي تمتلكها بعض المركبات الكيميائية المتطايرة في الهواء على الأرجح بتركيز منخفض جدًا…) / شَمّ ((شَمَّ) البناءُ أو الجبلُ يَشُمُّ شَمَمًا: ارتفَعَ أعلاهُ؛ (شَمَّ) الأنفُ: ارتفعت قَصَبَتُهُ قليلاً في استواء) / شَمَّ ((شَمَّ) البناءُ أو الجبلُ يَشُمُّ شَمَمًا: ارتفَعَ أعلاهُ؛ (شَمَّ) الأنفُ: ارتفعت قَصَبَتُهُ قليلاً في استواء) / اِشْتَمَّ (اجتذب الرائحة، قَرَبَّ الشيء أو اقترب منه ليشمه) / شم ((شَمَّ) البناءُ أو الجبلُ يَشُمُّ شَمَمًا: ارتفَعَ أعلاهُ؛ (شَمَّ) الأنفُ: ارتفعت قَصَبَتُهُ قليلاً في استواء) / شَمَّمَ\nمثال: شم تلك الرائحة.",
 "smelling": "شم (فعل إدراك رائحة شيء ما)",
 "smelling bottle": "زجاجة شم (زجاجة تحتوي على أملاح الشم)",
 "smelling salts": "أملاح الشم (مستحضر نفاذ من كربونات الأمونيوم والعطور؛ يُستنشق كمنبه لتخفيف الإغماء)",
 "smelly": "مُنْتِن",
 "smelt": "سمك الهف, هف (أسماك غذائية صغيرة فضية اللون تشبه الترويت تعيش في المياه البحرية أو العذبة الباردة الشمالية) / سمك الهف (سمكة صغيرة فضية من المياه الباردة؛ تهاجر بين المياه المالحة والعذبة)",
 "smelter": "مسبك, معمل صهر (منشأة صناعية للصهر)",
 "smeltery": "مسبك, معمل صهر (منشأة صناعية للصهر)",
 "smelting": "صَهْر (تغلى: واعلى لونها صهر فعلى:- يقال شئ صهر حار والصهر اذابة الشحم، ونحوه يصهره؛ تعلى واعلى لونها صهرا اي حار فوضع المصدر موضع الاسم وكانه قال اعلى لونها صهر)",
 "smew": "بلقشة بيضاء (أصغر أنواع البلقشة وأكثرها مهارة في الغوص؛ توجد في شمال أوراسيا)",
 "smidge": "ذرة, مثقال ذرة (كمية صغيرة جداً أو نادرة الوجود)",
 "smidgen": "ذرة, مثقال ذرة (كمية صغيرة جداً أو نادرة الوجود)",
 "smidgeon": "ذرة, مثقال ذرة (كمية صغيرة جداً أو نادرة الوجود)",
 "smidgin": "ذرة, مثقال ذرة (كمية صغيرة جداً أو نادرة الوجود)",
 "smilax": "فصة, هليون ناعم (نبات ملتف رقيق من جنوب أفريقيا ذو سيقان مسطحة خضراء زاهية وأوراق لامعة، شائع كزينة زهرية)",
 "smilax aspera": "فشاغ خشن (نبات متسلق أو زاحف دائم الخضرة ذو سيقان متعرجة شائكة وأوراق لامعة وعناقيد من الزهور الخضراء الباهتة؛ جزر الكناري إلى جنوب أوروبا وإثيوبيا والهند)",
 "smilax rotundifolia": "عشبة الثور, فصة مستديرة الأوراق (كرمة خشبية شائكة جداً في شرق الولايات المتحدة تنمو في كتل متشابكة ولها سيقان مستديرة قوية بأوراق جلدية لامعة وأزهار خضراء صغيرة تليها عناقيد من التوت…)",
 "smile": "اِبْتِسَامَة, بَسْمَة / اِبْتَسَمَ",
 "smiledon californicus": "سميلودون كاليفورني (نمر سيفي الأسنان من أمريكا الشمالية؛ ذروة تطور النمور سيفية الأسنان)",
 "smiler": "سحنة, محيا (الوجه البشري) / مُبْتَسِم (شخص يبتسم أو يبتسم بسهولة)",
 "smiley": "وجه مبتسم (رمز تعبيري لوجه يبتسم)",
 "smiling": "ابتسامة (تعبير وجهي يتميز برفع زوايا الفم؛ يظهر عادة السعادة أو التسلية)",
 "smilingly": "بابتسام, مبتسماً (مع الابتسامات؛ بطريقة مبتسمة)\nمثال: ذكرتها الفتاة مبتسمة بطفولتهما التي قضياها معاً",
 "smilo": "سميلو (أرز جبلي معمر موطنه منطقة البحر الأبيض المتوسط وأدخل إلى أمريكا الشمالية)",
 "smilo grass": "سميلو (أرز جبلي معمر موطنه منطقة البحر الأبيض المتوسط وأدخل إلى أمريكا الشمالية)",
 "smirch": "لطخة, وصمة (فعل يجلب العار للشخص الذي يقوم به) / بقعة, تلطخ (عيب ناتج عن الأوساخ)\nمثال: أحدث لطخة كبيرة في سجله",
 "smirk": "إِهْلَاس",
 "smirker": "مُبْتَسِم بِزَهْو, مُبْتَسِم بِغُرُور (مبتسم ابتسامة تنم عن الرضا عن النفس بشكل مسيء)",
 "smitane": "سميتان (فيلوتيه أو صلصة بنية مع بصل مفروم مقلي ونبيذ أبيض جاف وكريمة حامضة)",
 "smite": "ضَرَبَ (معروف، وهو اللطم أو الدق أو الصكّ و ما أشبه؛ النَوْع أو الصنف أو المثال)\nمثال: ضرب سامي زوجته.",
 "smith": "حَدَّاد, قَيْن",
 "smithereens": "أشلاء, قطع صغيرة (مجموعة من الشظايا الصغيرة تعتبر ككل)\nمثال: قُصفت برلين حتى تحولت إلى ركام",
 "smithsonite": "سميثسونيت",
 "smithy": "مسبك, ورشة حدادة (مكان عمل يتم فيه تشكيل المعدن بالتسخين والطرق)",
 "smitten": "مَذْهُول, مَصْدُوم ((يُستخدم في التركيب) متأثر بشيء طاغٍ أو ساحق) / مُتَيَّم, مُغْرَم (يتسم بولع أحمق أو غير عقلاني)",
 "smock": "مريول, معطف واق من الغبار (رداء شامل فضفاض (معطف أو ثوب) يصل إلى الكاحلين)",
 "smocking": "تطريز مزموم, سموكي (تطريز يتكون من أشغال إبرة زخرفية على ثوب يتم عن طريق جمع القماش بإحكام في غرز)",
 "smog": "ضُبْخَان, الضَّبَاب الدُّخَانِيّ",
 "smogginess": "ضباب دخاني (تلوث هواء بمزيج من الدخان والضباب)",
 "smoggy": "ضَبَابِيّ دُخَانِيّ (مغطى بمزيج من الدخان والضباب)",
 "smoke": "دُخَان, دخان / دَخَّنَ (دخن: الشَّيْء دخنة دخن؛ دخنت: النَّار دخنت والوقود دخن)\nمثال: دخن زيري سيجارة.",
 "smoke alarm": "إنذار حريق, كاشف دخان (إنذار ينطلق بسبب الحريق أو الدخان)",
 "smoke bomb": "قنبلة دخانية (قنبلة تطلق دخاناً كثيفاً عند انفجارها؛ تستخدم لعمل ستار دخاني أو لتحديد موقع)",
 "smoke bush": "شجيرة الدخان (أي من الشجيرات المختلفة من جنس كونوسبيرموم ذات عناقيد من الزهور الصوفية البيضاء في الغالب) / شجرة الدخان, شجيرة الدخان (نبات قائم على سَاق صلبة؛ مخطط له تفرعات)\nمثال: أنا تحت الشجرة.",
 "smoke grenade": "قنبلة دخانية (قنبلة تطلق دخاناً كثيفاً عند انفجارها؛ تستخدم لعمل ستار دخاني أو لتحديد موقع)",
 "smoke hole": "فتحة الدخان (فتحة تهوية (كما في السقف) لخروج الدخان)",
 "smoke screen": "تمويه, ستار دخاني (إجراء يهدف إلى الإخفاء أو الإرباك أو التعتيم) / ستار دخاني ((عسكرياً) شاشة تتكون من سحابة من الدخان تحجب التحركات)\nمثال: طلب صلاحيات مراقبة جديدة هو مجرد ستار دخاني لإخفاء فشلهم",
 "smoke tree": "داليا شوكية, شجرة الدخان (شجيرة رمادية مخضرة في المناطق الصحراوية بجنوب غرب الولايات المتحدة والمكسيك، لها أوراق متناثرة وسنابل طرفية من الزهور البنفسجية المزرقة؛ وتعد مصدراً…) / شجرة الدخان, شجيرة الدخان (نبات قائم على سَاق صلبة؛ مخطط له تفرعات)\nمثال: أنا تحت الشجرة.",
 "smoke-cured": "مُدَخَّن ((خَاصَّةً عَنِ اللُّحُوم وَالأَسْمَاك) مُجَفَّف وَمَحْفُوظ بِالتَّعْلِيق فِي دُخَان الخَشَب)",
 "smoke-dried": "مُدَخَّن ((خَاصَّةً عَنِ اللُّحُوم وَالأَسْمَاك) مُجَفَّف وَمَحْفُوظ بِالتَّعْلِيق فِي دُخَان الخَشَب)",
 "smoke-filled": "مَمْلُوءٌ بِالدُّخَانِ (يحتوي على الدخان)",
 "smoke-free": "خَالٍ مِنَ الدُّخَانِ (خالٍ من الدخان)",
 "smoked": "مُدَخَّن ((خَاصَّةً عَنِ اللُّحُوم وَالأَسْمَاك) مُجَفَّف وَمَحْفُوظ بِالتَّعْلِيق فِي دُخَان الخَشَب)",
 "smoked eel": "ثعبان بحر مدخن (ثعبان بحر محفوظ بالتدخين)",
 "smoked haddock": "هادوك مدخن (هادوك يخبز عادة ولكن أحياناً يشوى مع الكثير من الزبدة)",
 "smoked herring": "رنجة حمراء (رنجة مجففة ومدخنة ذات لون مائل للاحمرار)",
 "smoked mackerel": "ماكريل مدخن (إسقمري محفوظ بالتدخين)",
 "smoked salmon": "سلمون مدخن (سلمون محفوظ بالتدخين)",
 "smokefall": "غُرُوب, عَشِيّ (المَغْرِب، أيْ الوَقْت الذي تَغْرُبُ فيه الشَمْس) / سُخَام / عَرْضُ دُخَان, عَرْضُ شَلَّال (أتى العروض، أي مكّة والمدينة وما حولهما؛ الفَرَسَ: سار به بالعُرض)\nمثال: نحب غروب الشمس.",
 "smokehouse": "بيت التدخين, مدخنة (منزل صغير يستخدم فيه الدخان لمعالجة اللحوم أو الأسماك)",
 "smokeless": "بلا دخان, غير مدخن (ينبعث منه القليل من الدخان أو لا ينبعث منه على الإطلاق)\nمثال: مداخن مصانع بلا دخان",
 "smokeless powder": "بارود عديم الدخان, باليستيت (مادة متفجرة (الاسم التجاري باليستيت) تحترق بدخان قليل نسبيًا؛ تحتوي على البايروسليلوز وتستخدم كوقود دافع)",
 "smoker": "مُدَخِّن, مُدَخِّنَة",
 "smoker fuel": "وقود مدخن النحل (وقود طبيعي غير ملوث بمواد ضارة، يستخدم في مداخن النحل)\nمثال: يشمل وقود المدخن الخيش، وإبر الصنوبر، والورق المقوى المموج، وعلب البيض الورقية، والخشب المتعفن",
 "smokescreen": "سِتَار دُخَانِيّ",
 "smokestack": "مدخنة, مدخنة المصنع (مدخنة طويلة وكبيرة يمكن من خلالها تفريغ غازات الاحتراق والدخان)",
 "smoking": "تَدْخِين",
 "smoking car": "عربة للمدخنين (عربة ركاب للمسافرين الذين يرغبون في التدخين)",
 "smoking carriage": "عربة للمدخنين (عربة ركاب للمسافرين الذين يرغبون في التدخين)",
 "smoking compartment": "عربة للمدخنين (عربة ركاب للمسافرين الذين يرغبون في التدخين)",
 "smoking gun": "دليل دامغ, دليل قاطع (دليل لا يقبل الجدل (خاصة في جريمة))",
 "smoking jacket": "سترة تدخين (سترة ناعمة للرجل عادة بحزام ربط؛ تلبس في المنزل)",
 "smoking mixture": "خليط تدخين (مزيج من التبغ لتدخينه في الغليون)",
 "smoking room": "غرفة المدخنين (غرفة في فندق أو نادٍ مخصصة للمدخنين)",
 "smoky": "مدخن, مليء بالدخان (يتميز بوجود الدخان أو انبعاثه أو الامتلاء به) / مُدَخَّن (ذُو طَعْمِ الدُّخَان)\nمثال: عوارض مدخنة",
 "smoky quartz": "كوارتز دخاني, كيرنغورم (كوارتز أصفر دخاني أو بني)",
 "smol": "صَغِيرٌ وَظَرِيف ((غير رسمي) صَغِيرٌ جِدًّا وَلَطِيفُ المَظْهَرِ)",
 "smolder": "احتراق بطيء, جمر (نار تحترق بدخان كثيف ولكن دون لهب)\nمثال: تحول الجمر فجأة إلى لهب",
 "smoldering": "مَكْظُوم الغَيْظ, مُحْتَدِم (يُظهر غضبًا مكبوتًا بالكاد يُخفيه)",
 "smolderingly": "باحتقان, بالتهاب مكبوت (بغضب مكبوت بالكاد)\nمثال: أجابت باحتقان: 'لا أستطيع الانتظار'",
 "smolensk": "سْمُولِينْسْك",
 "smooch": "قبلة حارة (قبلة مفعمة بالحماس)",
 "smooching": "تقبيل, عناق (اللعب العاطفي (أو المداعبة دون ملامسة الأعضاء التناسلية))",
 "smooth": "نَاعِم, أَمْلَس (لطيف الملمس، غير خشن؛ رقيقٌ أو ملساء في الهيئة أو الصوت)\nمثال: صوتها ناعم و واضح.",
 "smooth alder": "نغت ناعم (شجيرة شائعة في شرق الولايات المتحدة بلحاء ناعم)",
 "smooth aster": "أستر أملس",
 "smooth bark kauri": "كاوري كوينزلاند (شجرة خشب أسترالية تشبه الكاوري ولكن خشبها أخف وزناً وأكثر ليونة بكثير)",
 "smooth crabgrass": "عشبة السلطعون الملساء (عشبة ضارة، عشبة سنوية صيفية منخفضة النمو تنتشر بالبذور ومن تجذير المفاصل السفلية للسيقان)",
 "smooth darling pea": "بازلاء دارلينج الملساء (نبات معمر منتصب أو زاحف في شرق أستراليا ذو عناقيد إبطية من الزهور الزرقاء إلى الأرجوانية أو الحمراء)",
 "smooth dogfish": "كلب البحر الأملس (قرش صغير يعيش في القاع يوجد على طول سواحل المحيط الأطلسي)",
 "smooth earthball": "سكليروديرما بوفيستا (كرة أرضية ذات غلاف صلب جاف وأملس عندما تكون صغيرة ولكن تتطور فيها شقوق عند النضج؛ برتقالية صفراء شاحبة عندما تكون صغيرة وبنية محمرة عند النضج)",
 "smooth green snake": "ثعبان أخضر أملس (من غرب ووسط الولايات المتحدة)",
 "smooth hammerhead": "قرش المطرقة الأملس (يتم صيده من أجل جلوده وكبده الغني بالفيتامينات)",
 "smooth lip fern": "سرخس الشفة ألاباما, سرخس الشفة الأملس (من جنوب شرق الولايات المتحدة إلى شمال المكسيك وجامايكا)",
 "smooth muscle": "عضلة ملساء (نسيج عضلي لا يبدو مخططاً تحت المجهر؛ يتخذ شكل طبقات رقيقة أو صفائح) / عضلة لا إرادية, عضلة ملساء (عضلة تنقبض دون تحكم واعي وتوجد في جدران الأعضاء الداخلية مثل المعدة والأمعاء والمثانة والأوعية الدموية (باستثناء القلب))",
 "smooth muscle cell": "خلية عضلية ملساء (خلايا العضلات الملساء)",
 "smooth plane": "فارة ناعمة, مِسْحَج تنعيم (مسحج صغير لعمليات الإنهاء)",
 "smooth softshell": "سلحفاة ناعمة ملساء (سلحفاة نهرية من حوض المسيسيبي؛ تفضل المياه الجارية)",
 "smooth sumac": "سماق أملس, سماق قرمزي (شجيرة شائعة غير سامة في شرق أمريكا الشمالية بأوراق مركبة شمعية وزهور خضراء عنقودية تليها ثمار حمراء)",
 "smooth winterberry holly": "بهشية ملساء",
 "smooth woodsia": "وودسيا ملساء (سرخس صخري من القطب الشمالي وشبه القطبي في أوروبا إلى شرق آسيا)",
 "smooth-bodied": "أَمْلَسُ الجَسَد (لَهُ جَسَدٌ أَمْلَس)",
 "smooth-faced": "أَمْرَد, حَلِيق الوَجْه (يفتقر إلى الشعر على الوجه)",
 "smooth-haired": "نَاعِم الشَّعْر (ذو شعر ناعم الملمس)",
 "smooth-haired fox terrier": "فوكس تيريير ناعم الشعر (فوكس تيريير ذو شعر ناعم)",
 "smooth-leaved elm": "دردار ناعم الأوراق (دردار أوروبي بأوراق ناعمة لامعة يستخدم للزينة)",
 "smooth-shaven": "حَلِيق, نَاعِم الحِلَاقَة (محلوق حلاقة ناعمة حديثة)",
 "smooth-shelled": "أَمْلَسُ الصَّدَفَةِ (لَهُ صَدَفَةٌ أَوْ قِشْرَةٌ مَلْسَاءُ)",
 "smooth-skinned": "أَمْلَسُ الجِلْدِ, نَاعِمُ البَشَرَةِ (لَهُ جِلْدٌ أَمْلَسُ)",
 "smooth-spoken": "بَلِيغ, طَلِيق اللِّسَان (يُعبِّر عن نفسه بسهولة ووضوح وفعاليّة)",
 "smooth-textured": "نَاعِمُ الْمَلْمَسِ (ذو بنية ناعمة ودقيقة الحبيبات)",
 "smooth-tongued": "فَصِيح, لَبِق (بارع في الإقناع بسلاسة الكلام)",
 "smoothbark": "أملس اللحاء (أي من عدة أنواع من الأوكالبتوس الأسترالي ذو لحاء أملس باستثناء عند أو بالقرب من قاعدة الجذع)",
 "smoothbore": "أملس السبطانة, غير مششخن ((للسلاح الناري) ليس لديه ششخنة أو أخاديد لولبية داخل السبطانة) / سلاح أملس الجوف (سلاح ناري لا يحتوي على حلزنة)",
 "smoothed": "مُمَلَّس (جُعل أملسَ عن طريق الكيّ)",
 "smoothened": "مُمَلَّس (جُعل أملسَ عن طريق الكيّ)",
 "smoother": "آلة صنفرة أسطوانية (أداة كهربائية تستخدم لصنفرة الخشب؛ يتم تحريك حلقة لا نهائية من ورق الصنفرة بسرعة عالية بواسطة محرك كهربائي)",
 "smoothhound": "كلب البحر الأملس (كلب بحر أملس يعيش في المياه الساحلية الأوروبية)",
 "smoothhound shark": "كلب البحر الأملس (كلب بحر أملس يعيش في المياه الساحلية الأوروبية)",
 "smoothie": "سموذي, مخفوق الفواكه (مشروب سميك ناعم يتكون من الفاكهة الطازجة المهروسة مع الآيس كريم أو الزبادي أو الحليب) / ساحر, متملق (شخص ذو أسلوب واثق ومتملق)",
 "smoothing iron": "مكواة, مكواة ملابس (جهاز منزلي يتكون من قاعدة معدنية مسطحة يتم تسخينها وتستخدم لكيّ وتنعيم القماش)",
 "smoothing plane": "فارة ناعمة, مِسْحَج تنعيم (مسحج صغير لعمليات الإنهاء)",
 "smoothly": "بسلاسة (بدون مشاكل أو صعوبات) / بسلاسة, بنعومة (بطريقة سلسة ودبلوماسية)\nمثال: نفذ الخطط بسرعة وسلاسة",
 "smoothness": "انْسِيَابِيَّة, سَلَاسَة (صفة الخلو من الأخطاء أو الانقطاعات) / مَلَاسَة, نُعُومَة (صفة امتلاك سطح مستوٍ وأملس) / رقة, نعومة (جودة كون المرء لطيفاً ودمثاً أو متودداً في الأسلوب) / ملوسة, نعومة (ملمس بدون خشونة؛ ناعم الملمس)\nمثال: معجباً بالنعومة الرشيقة لفخذيها",
 "smoothy": "ساحر, متملق (شخص ذو أسلوب واثق ومتملق)",
 "smorgasbord": "سمورجاسبورد (تشكيلة من الأطعمة تبدأ بالرنجة أو الثعبان المدخن أو السلمون مع الخبز والزبدة؛ ثم الأجبان والبيض والمخللات والهلام؛ وأخيراً الأطعمة الساخنة؛ تقدم…) / تشكيلة, خليط (مجموعة تحتوي على تشكيلة متنوعة من أنواع الأشياء)\nمثال: كانت هناك تشكيلة كبيرة من السيارات معروضة",
 "smother": "سحابة دخان خانقة (سحابة خانقة من الدخان) / خليط, ركام (مجموعة مشوشة من الأشياء)",
 "smothered": "مَخْنُوق, مَقْمُوع (مُحتبَس بصعوبة ومُسيطَر عليه بالكاد) / مُغَطًّى بِالكَامِل (مُغَطًّى تماماً وبشكل كامل)",
 "smotherer": "خَانِق, كَابِت (شخص يكبت أو يخنق أو يقمع)\nمثال: هو شخص خانق للمحادثة حقاً",
 "smothering": "خَنَّاق, كَاتِم لِلْأَنْفَاس (يُسَبِّب صُعُوبَة فِي التَّنَفُّس خَاصَّةً بِسَبَب نَقْص الهَوَاء النَّقِيّ)",
 "smoulder": "احتراق بطيء, جمر (نار تحترق بدخان كثيف ولكن دون لهب)\nمثال: تحول الجمر فجأة إلى لهب",
 "smouldering": "مَكْظُوم الغَيْظ, مُحْتَدِم (يُظهر غضبًا مكبوتًا بالكاد يُخفيه)",
 "smoulderingly": "باحتقان, بالتهاب مكبوت (بغضب مكبوت بالكاد)\nمثال: أجابت باحتقان: 'لا أستطيع الانتظار'",
 "sms": "رِسَالَة, رِسَالَة إِس إِم إِس",
 "smsgt": "رقيب أول جوي (ضابط صف كبير في القوات الجوية برتبة مماثلة لرقيب أول في الجيش)",
 "smudge": "بقعة, تلطخ (عيب ناتج عن الأوساخ) / دخان طارد (نار مدخنة لطرد الحشرات)\nمثال: كانت هناك لطخة على خده",
 "smudgy": "مُلَطَّخ, مُلَوَّث (ملطّخ بمادّة توسّخ أو تُلوّث)",
 "smug": "مُتَعَجْرِف, مُعْجَبٌ بِنَفْسِهِ (يَتَّسِمُ بِالرِّضَا المُفْرِطِ عَنِ الذَّاتِ)",
 "smuggle": "هَرَّبَ (الفِرارُ)\nمثال: هرب كأرنب خائف.",
 "smuggled": "مُحَرَّم, مُهَرَّب (مُنْتَج أَوْ مُتاجَر بِهِ بِشَكْل غَيْر قانونِيّ)",
 "smuggler": "مُهَرِّب",
 "smuggling": "تَهْرِيب",
 "smugly": "بزهو, بغرور (بطريقة الرضا المفرط عن النفس)\nمثال: شرح البيروقراطيون بزهو أن الحقائق المقدمة من خبرائهم لا تظهر أي داع للقلق",
 "smugness": "اعتداد بالنفس, عجرفة (شعور مفرط بالرضا عن النفس)",
 "smurf": "سَنْفُور, سَنَافِر",
 "smut": "أدب مكشوف, إباحية (نشاط إبداعي (كتابة أو صور أو أفلام وغيرها) ليس له قيمة أدبية أو فنية سوى إثارة الرغبة الجنسية) / بذاءة, فحش (كلمة أو عبارة مسيئة أو غير لائقة) / تفحم, فطر التفحم (أي فطر من رتبة أوستيلاجيناليس) / تفحم (أمراض مدمرة للنباتات (خاصة الحبوب) تسببها فطريات تنتج كتل مسحوقية سوداء من الجراثيم)",
 "smut fungus": "تفحم, فطر التفحم (أي فطر من رتبة أوستيلاجيناليس)",
 "smut grass": "عشبة السجاد, عشبة السناج (عشبة موطنها جزر الهند الغربية ولكنها شائعة في جنوب الولايات المتحدة ذات سيقان سلكية معنقدة غالباً ما تكون مصابة بفطر داكن)",
 "smuttily": "ببذاءة, بفحش (بطريقة بذيئة)",
 "smuttiness": "بذاءة, قذارة (الفحش في الكلام أو الكتابة) / تفحم, سخام (حالة الاتساخ بالسخام)",
 "smutty": "مُسَوَّد, مُلَطَّخ بِالسُّخَام (ملوّث بالأوساخ أو السُّخام) / بَذِيء, سَافِل (يتّسم بالفحش وخدش الحياء)",
 "smyrna": "سْمِيرْنَا",
 "smyrnium olusatrum": "ألكسندر, سميرنيوم (عشب أوروبي يشبه الكرفس إلى حد ما ومستوطن على نطاق واسع في المناطق الساحلية البريطانية ويزرع غالباً كبقلة)",
 "sn": "قصدير (عنصر فلزي فضي قابل للطرق ومقاوم للتآكل؛ يستخدم في العديد من السبائك ولطلاء المعادن الأخرى لمنع التآكل)",
 "snack": "وَجْبَة خَفِيفَة, لُمْجَة (الحصة التي صارت واجبة؛ الحصة الواحدة من الطعام توجب في موعد محدد)\nمثال: التهم زيري الوجبة.",
 "snack bar": "مَطْعَم التَّصَابِير, كُشْك التَّصَابِير",
 "snack counter": "بوفيه وجبات خفيفة, مقصف (مقصف أو منصة عادة ما تكون غير مكلفة لتقديم الوجبات)",
 "snack food": "تسالي, طعام خفيف (طعام للوجبات الخفيفة أو للأكل بين الوجبات)",
 "snacker": "آكل الوجبات الخفيفة (شخص يأكل طعاماً خفيفاً أو وجبات خفيفة بين الوجبات الرئيسية)",
 "snaffle": "شكيمة, لجام مفصلي (لجام بسيط مفصلي للحصان؛ بدون سلسلة ذقن)",
 "snaffle bit": "شكيمة, لجام مفصلي (لجام بسيط مفصلي للحصان؛ بدون سلسلة ذقن)",
 "snafu": "سنافو, فوضى عارمة (اختصار كان يستخدمه الجنود في الحرب العالمية الثانية يعني: الوضع طبيعي وكل شيء فوضوي) / فِي فَوْضَى عَارِمَة, مُخَرْبَط ((غير رسمي) في حالة ارتباك وفوضى تامة)",
 "snag": "عقبة خفية, عقدة (عقبة غير متوقعة) / تمزق, شرم (فتحة أحدثت بالقوة عن طريق الشد) / جذل, شجرة ميتة قائمة (شجرة ميتة لا تزال قائمة، عادة في غابة غير مضطربة) / عقدة, نتوء حاد (نتوء حاد)\nمثال: كان هناك تمزق في بنطاله",
 "snail": "حَلَزُون",
 "snail bean": "زهرة الحلزون, لوبياء كاراكالا (كرمة معمرة من أمريكا الاستوائية تزرع لعناقيدها من الزهور الصفراء والأرجوانية البارزة التي يكون تويجها ملفوفاً مثل قوقعة الحلزون)",
 "snail butter": "زبدة الحلزون (لتحضير الحلزون: زبدة متبلة بالكراث والثوم والبقدونس)",
 "snail darter": "سمكة الحلزون (فرخ صغير آكل للحلزون في نهر تينيسي)",
 "snail flower": "زهرة الحلزون, لوبياء كاراكالا (كرمة معمرة من أمريكا الاستوائية تزرع لعناقيدها من الزهور الصفراء والأرجوانية البارزة التي يكون تويجها ملفوفاً مثل قوقعة الحلزون)",
 "snail mail": "بريد عادي (أي بريد يتم توصيله مادياً عن طريق الخدمة البريدية)\nمثال: البريد الإلكتروني أسرع بكثير من البريد العادي",
 "snail-flower": "زهرة الحلزون, لوبياء كاراكالا (كرمة معمرة من أمريكا الاستوائية تزرع لعناقيدها من الزهور الصفراء والأرجوانية البارزة التي يكون تويجها ملفوفاً مثل قوقعة الحلزون)",
 "snailfish": "سمكة الحلزون (أسماك صغيرة تشبه الشرغوف تعيش في المياه الباردة مع زعانف حوضية تشكل ممصاً؛ مرتبطة بسمكة الكتل)",
 "snailflower": "زهرة الحلزون, لوبياء كاراكالا (كرمة معمرة من أمريكا الاستوائية تزرع لعناقيدها من الزهور الصفراء والأرجوانية البارزة التي يكون تويجها ملفوفاً مثل قوقعة الحلزون)",
 "snake": "ثُعْبَان, حَنَش",
 "snake charmer": "حاوي الثعابين, مروض الثعابين (فنان يستخدم الحركات والموسيقى للسيطرة على الثعابين)",
 "snake dance": "رقصة الثعبان (رقصة احتفالية (كما عند الهوبي) يتم فيها التعامل مع الثعابين أو استحضارها) / رقصة الأفعى (مجموعة تتقدم في مسار متعرج في رتل واحد)",
 "snake doctor": "يعسوب (حشرة نحيلة الجسم غير لاسعة ذات أجنحة قزحية الألوان تكون مفرودة عند الراحة؛ تتغذى البالغات والحوريات على البعوض وما إلى ذلك)",
 "snake eyes": "رَمْيَة خَاسِرَة, عَيْنَا الثُّعْبَان (تعبيرات تستخدم عند رمي حجري نرد وظهور نقطة واحدة على كل منهما)",
 "snake feeder": "يعسوب (حشرة نحيلة الجسم غير لاسعة ذات أجنحة قزحية الألوان تكون مفرودة عند الراحة؛ تتغذى البالغات والحوريات على البعوض وما إلى ذلك)",
 "snake fence": "سياج متعرج (سياج عوارض يتكون من خط متعرج من القضبان المتشابكة)",
 "snake fern": "سرخس الثعبان, كزبرة البئر المتسلقة (سرخس استوائي واسع الانتشار في العالم القديم؛ متوطن في جامايكا وفلوريدا)",
 "snake god": "إله الثعبان, زومبي (إله في طوائف الفودو ذات الأصل الأفريقي، يُعبد خاصة في جزر الهند الغربية)",
 "snake in the grass": "أفعى, خائن (شخص مخادع أو غادر)",
 "snake island": "جَزِيرَةُ الثُّعْبَان",
 "snake mackerel": "ماكريل الثعبان (أسماك استوائية مفترسة ذات فكوك بارزة وأسنان قوية)",
 "snake muishond": "ابن عرس الثعباني (ابن عرس صغير نحيل يحفر الجحور ذو قمة رأس بيضاء)",
 "snake oil": "خداع, دجل (تواصل (مكتوب أو منطوق) يهدف إلى الخداع) / زيت الثعبان ((طبياً) أي سائل من سوائل متنوعة يباع كدواء ولكنه عديم الفائدة طبياً)",
 "snake palm": "لسان الشيطان, نخيل الثعبان (نبات استوائي لحمي نوعاً ما كريه الرائحة من جنوب شرق آسيا يزرع لكورماته الصالحة للأكل أو في البيوت الزجاجية لأوراقه الكبيرة وقنابته الحمراء الداكنة…)",
 "snake pit": "مارستان, مستشفى المجانين (مصطلحات تحقيرية لمصحة المجانين) / جحيم, عذاب (أي مكان يسوده الألم والاضطراب)\nمثال: جحيم المعركة",
 "snake plant": "جلد النمر, لسان الحماة (نبات عديم الساق له أوراق صلبة ضيقة يزرع غالباً كنبات منزلي)",
 "snake polypody": "بوليبودي الثعبان (سراخس هوائية بجذامير طويلة؛ أمريكا الاستوائية)",
 "snake venom": "زعاف الثعبان, سم الأفعى (سم تفرزه بعض الثعابين)",
 "snake wood": "سيكروبيا, شجرة البوق (شجرة أمريكية استوائية بأوراق درعية كبيرة وسيقان مجوفة)",
 "snake's head fritillary": "رأس الثعبان, زهرة دجاج غينيا (زنبق متقلب أوراسي بأزهار متدلية عادة ما تكون معرقة ومتقلبة بالأرجواني أو الماروني على خلفية شاحبة وعلى شكل الأجراس التي كان يحملها مرضى الجذام في…)",
 "snake-eel": "أَنْقَلِيس ثُعْبَانِيّ",
 "snake-fish": "سمكة السحلية (أسماك استوائية ذات أفواه كبيرة في رؤوس تشبه السحالي؛ توجد في جميع أنحاء العالم)",
 "snake-haired": "أَفْعَوِيّ الشَّعْر ((للوحوش الأسطورية) ذو أفاعٍ بدلاً من الشعر)",
 "snake-head": "زهرة السلحفاة, كيلون (نبات معمر بارز في الأراضي المستنقعية في شرق ووسط أمريكا الشمالية له أوراق رمحية شمعية وزهرة ذات جزء سفلي أبيض كريمي وأجزاء علوية وردية شاحبة إلى…)",
 "snake-rail fence": "سياج متعرج (سياج عوارض يتكون من خط متعرج من القضبان المتشابكة)",
 "snakeberry": "أكتيا حمراء, توت سام أحمر (عشب معمر في أمريكا الشمالية بأوراق مركبة وعناقيد من الزهور البيضاء الصغيرة تليها ثمار لبية بيضاوية حمراء زاهية وسامة)",
 "snakebird": "زق, قاذف (طائر آكل للأسماك من المياه الداخلية الدافئة ذو رقبة طويلة مرنة ومنقار نحيل حاد الطرف)",
 "snakebite": "لدغة ثعبان (عضة يسببها ثعبان (سام))",
 "snakeblenny": "بليني الثعبان (توجد في مياه القطب الشمالي وشمال المحيط الأطلسي)",
 "snakefish": "سمكة السحلية (أسماك استوائية ذات أفواه كبيرة في رؤوس تشبه السحالي؛ توجد في جميع أنحاء العالم)",
 "snakefly": "ذبابة الثعبان (حشرة مفترسة من غرب أمريكا الشمالية لها صدر أمامي طويل يشبه الرقبة)",
 "snakehead": "زهرة السلحفاة, كيلون (نبات معمر بارز في الأراضي المستنقعية في شرق ووسط أمريكا الشمالية له أوراق رمحية شمعية وزهرة ذات جزء سفلي أبيض كريمي وأجزاء علوية وردية شاحبة إلى…)",
 "snakelike": "أَفْعَوَانِيّ, ثُعْبَانِيّ (يشبه الأفعى في شكله الملتوي والمتعرج)",
 "snakeroot": "ريشة غاي, ليآتريس (أي من نباتات أمريكا الشمالية المتنوعة من جنس ليآتريس ذات نورات عنقودية أو عثكولية من رؤوس الزهور القرصية الصغيرة) / جذر الثعبان, سانيكولة (جِذْرُ ٱلشَّيْءِ هُوَ: أَصْلُهُ؛ في : جذر العدد النوني هو عدد ما إذا رفعناه لقوة ما أعطانا العدد الأصلي)\nمثال: أحسب جذر خمسة بالآلة الحاسبة.",
 "snakes and ladders": "السلم والثعبان (لعبة لوحية للأطفال يستخدمون النرد لتحريك العدادات صعوداً في السلالم ونزولاً في الثعابين)",
 "snakeweed": "عشبة الأرنب, عشبة الثعبان المكنسية (شجيرة منخفضة النمو لزجة في جنوب غرب الولايات المتحدة ذات أوراق خطية ضيقة على العديد من الفروع الرفيعة ومئات من رؤوس الزهور الصفراء الصغيرة)",
 "snakewood": "خشب الثعبان, راولفية ثعبانية (شجيرة متسلقة من جزر الهند الشرقية بأطراف ملتوية وجذور تشبه الثعابين)",
 "snaky": "ثُعْبَانِيّ",
 "snap": "سحب الكرة, سناب ((كرة القدم الأمريكية) وضع الكرة في اللعب عن طريق تمريرها (بين الساقين) إلى الخلف) / إمساك, التقاط (فعل التقاط شيء باليدين) / فرقعة الأصابع (فعل فرقعة الأصابع؛ حركة إصبع من الطرف إلى قاعدة الإبهام في نفس اليد) / أمر سهل, لعب أطفال (أي مشروع يسهل القيام به)\nمثال: أسقط لاعب الوسط الكرة عند السحب",
 "snap bean": "فاصولياء مقرمشة (فاصولياء خضراء طرية بدون خيوط تنكسر بسهولة إلى قطع)",
 "snap brim": "حافة قلابة, حافة مرنة (حافة قبعة يمكن طيها لأعلى ولأسفل على جوانب متعاكسة)",
 "snap fastener": "زر كبس, كبسولة (أداة تثبيت تستخدم في الملابس؛ تغلق بصوت طقطقة)\nمثال: يمكن للأطفال التعامل مع أزرار الكبس بشكل أفضل من الأزرار العادية",
 "snap line": "خيط الطباشير, خيط العلام (خيط مطلي بالطباشير يستخدم في أعمال البناء لعمل خط مستقيم على سطح عمودي)",
 "snap pea": "بازلاء سكرية مقرمشة (صنف من نبات البازلاء ينتج بازلاء ذات قرون مستديرة مقرمشة صالحة للأكل)",
 "snap ring": "حلقة تسلق, حلقة خطافية (حلقة معدنية مستطيلة ذات مشبك زنبركي؛ تستخدم في تسلق الجبال لربط الحبل بالوتد أو لربط حبلين معاً)",
 "snap roll": "لفة خاطفة (لفة سريعة)",
 "snap willow": "صفصاف هش (شجرة صفصاف كبيرة ذات فروع صلبة تنكسر بسهولة)",
 "snap-brim hat": "قبعة بحافة مرنة (قبعة ذات حافة يمكن ثنيها)",
 "snapchat": "سْنَاب",
 "snapdragon": "أَنْف الْعِجْل (أنف:اشْتَكَى أَنفه فَهُوَ مأنوف؛ أنف الشَّيْء: حدد طرفه)\nمثال: أنت لديك أنف كبير.",
 "snapline": "خيط الطباشير, خيط العلام (خيط مطلي بالطباشير يستخدم في أعمال البناء لعمل خط مستقيم على سطح عمودي)",
 "snapper": "سلحفاة نهاشة (سلحفاة كبيرة الرأس ذات فكوك معقوفة قوية توجد في الماء أو بالقرب منه؛ تميل للعض) / نهاش (أي من عدة أسماك بحرية كبيرة حادة الأسنان صالحة للأكل والصيد من فصيلة النهاشيات، تعيش بشكل رئيسي في المياه الساحلية الاستوائية) / نهاش (سمكة غذائية أسترالية ذات جسم وردي مع بقع زرقاء) / مفرقعة حفلات (هدية حفلات تتكون من لفافة ورقية (تحتوي عادة على حلوى أو هدية صغيرة) تنفجر عند سحبها من كلا الطرفين)",
 "snapping beetle": "خنفساء مطقطقة (قادرة على تعديل وضعها عندما تكون على ظهرها عن طريق القفز في الهواء مع صوت طقطقة)",
 "snapping shrimp": "روبيان طقاق (روبيان صغير يصدر صوت طقطقة بأحد مخالبه المتضخمة)",
 "snapping turtle": "سلحفاة نهاشة (سلحفاة مياه عذبة كبيرة عدوانية ذات فكوك قوية)",
 "snappish": "حَادّ الكَلَام, لَاذِع (يميل إلى الكلام بانفعال وحِدَّة)",
 "snappishly": "بحدة, بفظاظة (بطريقة حادة وسيئة الطباع)\nمثال: قالت بفظاظة: 'لا تتحدث معي الآن'",
 "snappishness": "حدة المزاج, سرعة الغضب (الميل لإظهار غضب غير منضبط)\nمثال: كانت حدة مزاجه معروفة لجميع موظفيه",
 "snappy": "خَفِيفُ الحَرَكَة, نَشِيط (سريع ومفعم بالطاقة والحيوية) / أَنِيق, مُتَأَلِّق (يَتَمَيَّز بِمُوَاكَبَة العَصْر فِي المَلْبَس وَالسُّلُوك) / حَادّ الكَلَام, لَاذِع (يميل إلى الكلام بانفعال وحِدَّة) / بَارِد مُنَشِّط, مُنْعِش (بارد بشكل لطيف ومُنعش)",
 "snapshot": "صورة فورية, لقطة سريعة (صورة غير رسمية؛ تُلتقط عادة بكاميرا صغيرة محمولة باليد)\nمثال: لم يتم تحميض صوري الفورية بعد",
 "snapshot program": "برنامج لقطة (برنامج تتبع ينتج مخرجات لشروط مختارة)",
 "snare": "شَرَكٌ ((شَرِكَتِ) النَّعْلُ تَشْرَكُ شَرَكًا: انقطَعَ شِراكُها؛ (شَرِكَتْ) فُلانًا في الأمْرِ شِرْكًا، وشَرِكَةً، وشِرْكَةً: كان لكل منهما نصيب منه) / مِصْيَدَةٌ\nمثال: هذه شركة صينية.",
 "snare drum": "طبلة جانبية, طبلة سنير (طبلة صغيرة برأسين وسلك مشدود عبر الرأس السفلي)",
 "snarer": "ناصب الشراك (شخص ينصب الفخاخ للطيور أو الحيوانات الصغيرة)",
 "snarky": "سَاخِر, مُسْتَهْزِئ (ساخر باحتقار واستهزاء؛ يسخر ويتهكّم)",
 "snarl": "تشابك, متاهة (شيء مختلط أو مشوش) / زمجرة (تعبير غاضب وشرس) / زمجرة (هدير غاضب شرس)\nمثال: تشابك من اللوائح الحكومية",
 "snarl-up": "اختناق مروري, ازدحام مروري (عدد من المركبات تعيق بعضها البعض حتى تكاد لا تتحرك)",
 "snarled": "مَعْقُود, مُعَقَّد (متشابك في عُقد وتشابكات)",
 "snarly": "مَعْقُود, مُعَقَّد (متشابك في عُقد وتشابكات)",
 "snatch": "إمساك, التقاط (فعل التقاط شيء باليدين) / خطف (رفعة أوزان يتم فيها رفع البار فوق الرأس في حركة واحدة سريعة) / اختطاف, خطف ((قانون) العمل غير القانوني المتمثل في القبض على شخص وحمله بعيداً رغماً عنه واحتجازه في سجن زائف) / فرج (مصطلحات بذيئة للأعضاء التناسلية الأنثوية)\nمثال: أمسك ميس بالكرة وظهره للوحة",
 "snatch block": "بكرة خطف, بكرة مفتوحة الجانب (بكرة يمكن فتحها لاستقبال حلقة الحبل)",
 "snatcher": "خاطف (شخص يستولي على ضحية ويحتجزها بشكل غير قانوني (عادة من أجل فدية)) / خاطف (لص يمسك بالشيء ويهرب)\nمثال: خاطف حقائب",
 "snazzy": "بَرَّاق, لَافِت الأَنَاقَة (أَنِيق بِشَكْلٍ لَافِت وَبَرَّاق)",
 "sneak": "تَسَلَّلَ",
 "sneak peek": "نظرة خاطفة (نظرة مبكرة لمنتج غير مُصدر)",
 "sneak preview": "عرض تجريبي (عرض مسبق لاختبار ردود فعل الجمهور)",
 "sneak thief": "لص متسلل (لص يسرق دون استخدام العنف)",
 "sneaker": "مُتَسَلِّل / حِذَاء رِيَاضِيّ (بمعنى الإزاء والجوار؛ النَعْل)\nمثال: أردت حذاء أحمر.",
 "sneakily": "خلسة, سراً (بطريقة سرية)\nمثال: كان يراقبها خلسة وهي تنتظر في ردهة الفندق",
 "sneakiness": "تستر, خفية (الميل لكون المرء ماكراً ومتستراً والقيام بالأشياء خلسة)",
 "sneakingly": "في الخفاء, في قرارة النفس (بطريقة خفية)\nمثال: شعرت دائماً في قرارة نفسي أنني أريد أن أكون عازف بيانو",
 "sneaky": "خَلْسِيّ, مُتَسَلِّل (يتّسم بالهدوء والحذر والسرّيّة؛ يحرص على تجنّب الملاحظة) / مُتَسَلِّل, مُحْتَال (يتسم بالخداع والمراوغة)",
 "sneer": "تَكْشِيرَة سَاخِرَة, نَظْرَة ازْدِرَاء (تعبير وجهي يدل على الازدراء أو الاحتقار (برفع الشفة العليا)) / تَعْلِيق مُتَهَكِّم, مُلَاحَظَة سَاخِرَة (ملاحظة ازدرائية أو محتقرة)",
 "sneerer": "محتقر, مزدري (شخص يعبر عن الازدراء من خلال الملاحظات أو تعابير الوجه)",
 "sneering": "سَاخِر, مُتَعَجْرِف (يُعَبِّر عن الازدراء والتعالي)",
 "sneeringly": "باستهزاء, بتهكم (مع سخرية؛ بطريقة تهكمية غير مجاملة)\nمثال: قال باستهزاء: 'أنا لا أؤمن بهذه العادات'",
 "sneeze": "عَطَسَ / عُطَاس, عَطْسَة",
 "sneezer": "عَاطِس (شخص يعطس)",
 "sneezeweed": "عشبة العطاس, هيلينيوم (أي من النباتات المتنوعة من جنس هيلينيوم التي تسبب العطس بشكل مميز)",
 "sneezeweed yarrow": "ألفية العطاس, عشبة العطاس (عشبة أوراسية ذات رؤوس فضفاضة من الزهور البيضاء التي تشبه الأزرار وأوراق خضراء رمادية طويلة تسبب العطس عند سحقها)",
 "sneezewort": "ألفية العطاس, عشبة العطاس (عشبة أوراسية ذات رؤوس فضفاضة من الزهور البيضاء التي تشبه الأزرار وأوراق خضراء رمادية طويلة تسبب العطس عند سحقها)",
 "sneezing": "عطاس, عطس (عَرَض يتكون من طرد لا إرادي للهواء من الأنف)",
 "sneezy": "مَيَّال لِلْعُطَاس (يميل إلى العطاس بكثرة)",
 "snellen chart": "لوحة سنيلين (عرض يتكون من بطاقة مطبوعة بحروف وأرقام في سطور ذات حجم متناقص؛ تستخدم لاختبار حدة البصر)",
 "snellen test": "اختبار سنيلين (اختبار لحدة البصر باستخدام مخطط سنيلين)",
 "snick": "احتكاك خفيف (تلامس جانبي مع الكرة من حافة مضرب الكريكت) / ثلم, حز (قطع صغير)",
 "snicker": "ضحكة ساخرة (ضحكة غير محترمة)",
 "snickers": "سنيكرز",
 "snickersnee": "قِتَال بِالسَّكَاكِين (القتال باستخدام السكاكين)",
 "snide": "سَاخِر, مُتَعَجْرِف (يُعَبِّر عن الازدراء والتعالي)",
 "snidely": "باستهزاء, بتهكم (مع سخرية؛ بطريقة تهكمية غير مجاملة)\nمثال: قال باستهزاء: 'أنا لا أؤمن بهذه العادات'",
 "sniff": "استنشاق, تشمم (استشعار رائحة عن طريق الاستنشاق من الأنف)",
 "sniff out": "يَشُمّ, يَكْتَشِف",
 "sniffer": "شَامّ, مُسْتَنْشِق (شخص يشمشم)",
 "sniffle": "خنخنة, خنين (فعل التنفس بصوت مسموع عبر الأنف (كما هو الحال عند احتقان الأنف))",
 "sniffler": "مُخَنْفِر (شخص يتنفس بصوت مسموع من خلال أنف محتقن)",
 "sniffly": "شَهَّاق, نَشَّاج (يميل إلى الشهقة والنشيج من البكاء)",
 "sniffy": "مُتَعَجْرِف, مُتَكَبِّر (لديه أو يُظهِر تفوّقًا متعجرفًا واحتقارًا لمن يعتبرهم أدنى منه)",
 "snifter": "كأس براندي (كأس كروي ذو قمة صغيرة؛ يستخدم لتقديم البراندي)",
 "snigger": "ضحكة ساخرة (ضحكة غير محترمة)",
 "snip": "قصاصة, قُصاصة (عملية القص أو القصقصة) / قُصاصة, نتفة (قطعة صغيرة من أي شيء (خاصة قطعة تم قصها))",
 "snipe": "قنص (إطلاق نار من موقع مخفي) / جهلول, شنقب (طائر صيد مستقيم المنقار من العالم القديم أو الجديد من فصيلة الطيطوي؛ يعيش في المناطق المستنقعية؛ يشبه ديك الغابة)",
 "snipe hunt": "صيد طائر الوهم, مهمة وهمية (مقلب معقد يُرسل فيه الضحية غير المشكك لصيد حيوان خيالي (الشنقب) وغالباً ما يُترك في الظلام ممسكاً بكيس بانتظار دخول الحيوان فيه)\nمثال: في الجنوب، تُعتبر 'مهمة صيد الشنقب' بمثابة طقس عبور عملياً",
 "snipefish": "سمكة قناصة (سمكة صغيرة تعيش في قاع البحار الدافئة ذات جسم مضغوط وخطم طويل وفم عديم الأسنان)",
 "sniper": "قَنَّاص (صيغة مبالغة من قَنَصَ. وقد تستخدم بمعنى قَانِص؛ الذي مهنته القَنْص، أي صيد الغِزْلان وغيرها من حيوان البَرِّيَّة)",
 "sniper rifle": "قَنَّاصَة",
 "snippet": "قُصاصة, نتفة (قطعة صغيرة من أي شيء (خاصة قطعة تم قصها))",
 "snipping": "قُصاصة, نتفة (قطعة صغيرة من أي شيء (خاصة قطعة تم قصها))",
 "snips": "مقص صفيح ((جمع) مقص يدوي لقطع الصفائح المعدنية)",
 "snit": "حنق, نوبة غضب (حالة من التهيج والانفعال)\nمثال: كان في نوبة غضب",
 "snitch": "عصفورة, مخبر للشرطة (شخص يعمل كمخبر أو طُعم للشرطة)",
 "snitcher": "عصفورة, مخبر للشرطة (شخص يعمل كمخبر أو طُعم للشرطة) / لص متسلل (لص يسرق دون استخدام العنف)",
 "snivel": "خنخنة, خنين (فعل التنفس بصوت مسموع عبر الأنف (كما هو الحال عند احتقان الأنف)) / تخنع, نشيج (الأنين بطريقة باكية)",
 "sniveler": "مُخَنْفِر (شخص يتنفس بصوت مسموع من خلال أنف محتقن)",
 "sniveling": "تخنع, نشيج (الأنين بطريقة باكية)",
 "sniveller": "بكاء, كثير الشكوى (شخص يميل إلى الشكوى المفرطة والبكاء والأنين)",
 "sno-cat": "مركبة ثلجية (نوع من الزلاجات الآلية)",
 "snob": "مُتَعَالٍ, المُتَعَالِي",
 "snobbery": "خيلاء اجتماعي, عجرفة (سمة التعالي على من هم في مكانة اجتماعية أدنى)",
 "snobbish": "عَشَائِرِيّ, مُتَعَصِّب لِجَمَاعَتِه (يليق بمن يميلون إلى التمييز الاجتماعي ويصدّون من يعتبرونهم أدنى منهم)",
 "snobbishly": "بتكبر, بغطرسة (بطريقة متعجرفة)\nمثال: استبعدوا بتكبر أصدقاءهم الأقل ثراءً من الحفلة",
 "snobbishness": "خيلاء اجتماعي, عجرفة (سمة التعالي على من هم في مكانة اجتماعية أدنى)",
 "snobbism": "خيلاء اجتماعي, عجرفة (سمة التعالي على من هم في مكانة اجتماعية أدنى)",
 "snobby": "عَشَائِرِيّ, مُتَعَصِّب لِجَمَاعَتِه (يليق بمن يميلون إلى التمييز الاجتماعي ويصدّون من يعتبرونهم أدنى منهم)",
 "snoek": "باراكوت (سمكة بحرية كبيرة صالحة للأكل شائعة على سواحل أستراليا ونيوزيلندا وجنوب أفريقيا)",
 "snogging": "تعانق وتقبيل ((عامية بريطانية) العناق والتقبيل)",
 "snood": "سنود, شبكة شعر (شبكة زخرفية على شكل حقيبة تحصر شعر المرأة؛ تثبت بدبابيس أو أربطة في الجزء الخلفي من الرأس)",
 "snook": "سنوك (أسماك غذائية ورياضية أمريكية استوائية كبيرة تعيش في المياه الساحلية وقليلة الملوحة؛ تشبه الكراكي)",
 "snooker": "سْنُوكَر",
 "snooker table": "طاولة بلياردو (معدات ألعاب تتكون من طاولة ثقيلة تلعب عليها البلياردو)",
 "snoop": "تَجَسَّسَ",
 "snooper": "فضولي, متطفل (جاسوس يقوم بتحقيقات غير مدعوة في الشؤون الخاصة للآخرين)",
 "snoopiness": "تطفل, حشرية (فضول مزعج وتدخل فيما لا يعنيك)",
 "snoopy": "سْنُوبِي",
 "snoot": "أنف, منقار (مصطلحات غير رسمية للأنف) / متعالي, متغطرس (شخص يُعتبر مغروراً ومزعجاً)",
 "snootily": "بتكبر, بغطرسة (بطريقة متعجرفة)\nمثال: استبعدوا بتكبر أصدقاءهم الأقل ثراءً من الحفلة",
 "snootiness": "تكبر, عجرفة (صفة التكبر والتعالي)\nمثال: كان يكره عجرفة جيرانه",
 "snooty": "مَغْرُور, مُتَعَالٍ ((غير رسمي) مفرط في الغرور والتعالي)",
 "snooze": "غَفَا / غَفْوَة",
 "snore": "شَخَرَ / شَخِير",
 "snorer": "شاخِر (شخص يشخر أثناء النوم)",
 "snoring": "شخير (فعل الشخير أو إصدار صوت الشخير)",
 "snorkel": "أنبوب التنفس, سنوركل (ممر هوائي يوفره جهاز قابل للسحب يحتوي على أنابيب سحب وعادم؛ يسمح للغواصة بالبقاء تحت الماء لفترات طويلة) / أنبوب تنفس (جهاز تنفس يتكون من أنبوب منحني يوضع في فم السباح ويمتد فوق السطح؛ يسمح للسباح بالتنفس ووجهه لأسفل في الماء)",
 "snorkel breather": "أنبوب التنفس, سنوركل (ممر هوائي يوفره جهاز قابل للسحب يحتوي على أنابيب سحب وعادم؛ يسمح للغواصة بالبقاء تحت الماء لفترات طويلة)",
 "snorkel diving": "سنوركلينغ, غوص بالأنبوب (السباحة باستخدام أنبوب التنفس)",
 "snorkeling": "سنوركلينغ, غوص بالأنبوب (السباحة باستخدام أنبوب التنفس)",
 "snort": "استهجان, سخرية (صيحة أو ضجيج يصنع للتعبير عن الاستياء أو الازدراء) / ضحكة ساخرة (ضحكة غير محترمة)",
 "snorter": "أعجوبة, شيء استثنائي (شيء خارق للعادة أو ملحوظ أو بارز بشكل كبير) / أمر عسير, معضلة (شيء صعب للغاية) / ناخر (شخص يعبر عن الازدراء أو السخط بإصدار صوت النخير)\nمثال: كانت خطبة استثنائية",
 "snorting": "نخير, نفخ (فعل الزفير بقوة)",
 "snorty": "مُتَضَايِق, مُتَوَتِّر ((عامّيّة بريطانيّة) سيء المزاج أو منزعج)",
 "snot": "مُخَاط, مُخَاط أَنْف",
 "snot-nosed": "سَائِل الأَنْف, مُتَمَخِّط (متّسخ بإفرازات الأنف) / مَغْرُور, مُتَعَالٍ ((غير رسمي) مفرط في الغرور والتعالي)",
 "snotty": "سَائِل الأَنْف, مُتَمَخِّط (متّسخ بإفرازات الأنف) / مَغْرُور, مُتَعَالٍ ((غير رسمي) مفرط في الغرور والتعالي)",
 "snotty-nosed": "صَفِيق, وَقِح (يتسم بعدم الاحترام العَرَضيّ)",
 "snout": "خَطْم (وضع الخِطام على الدابة أو الحيوان؛ أخذ الشيء بقوة أو سيطرة)",
 "snout beetle": "خنفساء الخطم (سوسة صغيرة لها خطم طويل؛ مدمرة للحبوب والمكسرات وغيرها)",
 "snow": "ثَلْج (ثلَجتنا السماء: مطَرَتنا، ألقت علينا الثلج؛ ثلَجت نفسي: اشتَفَت به، واطمأنت إليه) / تلج / ثلج (ثلَجتنا السماء: مطَرَتنا، ألقت علينا الثلج؛ ثلَجت نفسي: اشتَفَت به، واطمأنت إليه) / أَثْلَجَ (أثلج يومُنا: دخل في الثلج؛ أثلجت الأرض: أصابها الثلج)\nمثال: سامي يحب الثلج.",
 "snow bank": "ضفة ثلجية, كومة ثلج (كومة أو ركام من الثلج)",
 "snow blower": "قاذفة ثلج (آلة تزيل الثلج عن طريق جرفه ورميه بقوة عبر مجرى)",
 "snow bunting": "درسة الثلج (طائر درسة قطبي أبيض)",
 "snow chain": "سلاسل الإطارات, سلاسل الثلج (سلسلة تثبت على العجلات لزيادة الجر على الجليد أو الثلج)",
 "snow day": "عطلة بسبب الثلج, يوم مثلج (يوم تلغى فيه المدارس أو الفعاليات بسبب الثلوج)",
 "snow eater": "آكلة الثلج, رياح الشينوك (رياح دافئة وجافة تهب أسفل المنحدرات الشرقية لجبال روكي)",
 "snow flurry": "هبة ثلجية (تساقط ثلوج خفيف وقصير وهبة رياح (أو ما يشبه ذلك))\nمثال: اضطر لإغلاق النافذة ضد الهبات الثلجية",
 "snow goose": "إوز الثلج (الإوز الأزرق في الطور اللوني الأبيض)",
 "snow gum": "صمغ الثلج, صمغ الشبح (شجرة صغيرة إلى متوسطة الحجم من أستراليا وتسمانيا ذات لحاء أبيض ناعم إلى رمادي فاتح يتساقط في بقع أو شرائط)",
 "snow job": "تضليل متعمد, كلام منمق (تضليل طويل ومتقن)",
 "snow leopard": "نِمْر اَلثُّلُوج (النّمر: حيوان مرقّط يُشبه الأَسَد؛ النّمر: لونه أنمر، وفيه نُمر حمراء أو بيضاء وسوداء)\nمثال: دخل نمر مخيمنا.",
 "snow lily": "زنبق الثلج, زنبق النهر الجليدي (بنفسج سن الكلب من غرب أمريكا الشمالية له زهور صفراء زاهية)",
 "snow line": "خط الثلج (الخط على الجبل الذي يوجد فوقه ثلج وجليد دائم)",
 "snow mist": "بلورة جليدية, رذاذ ثلجي (بلورات صغيرة من الجليد)",
 "snow mushroom": "فطر الثلج (شائع في الصين واليابان وتايوان؛ فطر هلامي؛ معظمه مجفف)",
 "snow orchid": "أوركيد الثلج, أوركيد الشبح (نبات أبيض شمعي عديم الأوراق تقريباً بسيقان في مجموعات وعناقيد من الزهور البيضاء؛ شمال غرب الولايات المتحدة إلى شمال كاليفورنيا وشرقاً إلى أيداهو)",
 "snow pea": "بازلاء ثلجية, بازلاء سكرية (بازلاء خضراء ذات قرون مسطحة صالحة للأكل) / بازلاء ثلجية, بازلاء سكرية (صنف من نبات البازلاء ينتج بازلاء ذات قرون مسطحة رقيقة صالحة للأكل)",
 "snow plant": "نبات الثلج (نبات رمي أحمر زاهي لحمي في جبال غرب أمريكا الشمالية يظهر في أوائل الربيع بينما لا يزال الثلج على الأرض)",
 "snow queen": "مَلِكَة الثَّلْجِ (مؤنث مَلِك)\nمثال: ليحفظ الله الملكة.",
 "snow thrower": "قاذفة ثلج (آلة تزيل الثلج عن طريق جرفه ورميه بقوة عبر مجرى)",
 "snow tire": "إطار الثلج (إطار سيارة هوائي ذو نقش عميق لتوفير الجر في الثلج)",
 "snow trillium": "تريليوم أبيض قزم, تريليوم الثلج (تريليوم معمر منخفض أبيض الأزهار يوجد في جنوب شرق الولايات المتحدة)",
 "snow white": "بَيْضَاء الثَّلْج, بَيَاضُ الثَّلْج (مؤنث أَبْيَض، صفة ما كان لونها البياض؛ يد بيضاء: هي اليد التي تعمل الخير وتسبق بالحسنات)\nمثال: هي بيضاء اللون.",
 "snow-blind": "مُصَاب بِعَمَى الثَّلْج (فاقد البصر مؤقّتًا بسبب انعكاس الضوء على الثلج أو الجليد)",
 "snow-blinded": "مُصَاب بِعَمَى الثَّلْج (فاقد البصر مؤقّتًا بسبب انعكاس الضوء على الثلج أو الجليد)",
 "snow-blindness": "عمى الثلج (عمى مؤقت ناتج عن التعرض لأشعة الشمس المنعكسة من الثلج أو الجليد)",
 "snow-capped": "مكلل بالثلوج ((عن الجبال) مغطى قمتها بطبقة من الثلج)",
 "snow-clad": "ثَلْجِيّ, مُكَلَّل بِالثَّلْج (مغطى بالثلج)",
 "snow-covered": "ثَلْجِيّ, مُكَلَّل بِالثَّلْج (مغطى بالثلج)",
 "snow-in-summer": "ثلج في الصيف (عشبة الطيور ذات أوراق رمادية فضية مشعرة وأزهار بيضاء كبيرة نوعاً ما) / ثلج على الجبل, فربيون مهدب (فربيون سنوي في غرب الولايات المتحدة ذو عناقيد زهور بيضاء القنابات وحليب سام جداً)",
 "snow-on-the-mountain": "ثلج على الجبل, فربيون مهدب (فربيون سنوي في غرب الولايات المتحدة ذو عناقيد زهور بيضاء القنابات وحليب سام جداً)",
 "snow-white": "أَبْيَض ثَلْجِيّ (بلون أبيض كبياض الثلج)",
 "snowball": "كُرَةُ الثَّلْج",
 "snowball effect": "تأثير كرة الثلج",
 "snowbank": "ضفة ثلجية, كومة ثلج (كومة أو ركام من الثلج)",
 "snowbell": "إصطرك أوباسي, جرس الثلج (شجرة صغيرة موطنها اليابان)",
 "snowberry": "توت الثلج, سيمفوريكاربوس (شجيرة متساقطة الأوراق من غرب أمريكا الشمالية لها سنابل من الأزهار الوردية يليها توت أبيض مستدير)",
 "snowbird": "جنكو, طائر الثلج (عصفور صغير من أمريكا الشمالية يُرى بشكل رئيسي في الشتاء) / درسة الثلج (طائر درسة قطبي أبيض) / سمنة الحقول (سمنة أوراسية متوسطة الحجم تُرى بشكل رئيسي في الشتاء)",
 "snowblindness": "عمى الثلج (عمى مؤقت ناتج عن التعرض لأشعة الشمس المنعكسة من الثلج أو الجليد)",
 "snowboard": "لوح تزلج على الثلج (لوح يشبه زلاجة عريضة أو لوح تزلج صغير؛ يستخدم في وضع الوقوف للانزلاق على المنحدرات المغطاة بالثلوج)",
 "snowboarder": "مُتَزَلِّج بِاللَّوْح, مُتَزَلِّج عَلَى الثَّلْج (شخص ينزلق على منحدرات مغطاة بالثلوج وهو يقف على لوح تزلج)",
 "snowboarding": "تزلج على الثلوج (فعل الانزلاق أسفل منحدر مغطى بالثلج أثناء الوقوف على لوح تزلج)",
 "snowbound": "مَحْصُورٌ بِالثَّلْجِ (مَحْبُوسٌ أَوْ مُحَاصَرٌ بِسَبَبِ الثُّلُوجِ الكَثِيفَةِ)",
 "snowcap": "غِطَاء ثَلْجِيّ, قَلَنْسُوَة ثَلْجِيَّة (غطاء من الثلج (كما على قمة الجبل))",
 "snowcock": "قوقل (شركة تقنية أمريكية تقدم خدمات ومنتجات في مجالات الإنترنت والبرمجيات والحوسبة)",
 "snowdonia": "سنودونيا",
 "snowdrift": "كَثِيب ثَلْجِيّ (كتلة من الثلج كدّستها الرياح)",
 "snowdrop": "شقائق النعمان الحرجية, قطرة الثلج (شقائق نعمان شائعة في شرق أمريكا الشمالية بزهور بيضاء وحيدة مشوبة بالوردي)",
 "snowdrop anemone": "شقائق نعمان قطرة الثلج (عشبة أوراسية بزهور بيضاء عطرية متدلية وحيدة)",
 "snowdrop tree": "شجرة الجرس الفضي, شجرة قطرة الثلج (شجرة متوسطة الحجم من فرجينيا الغربية إلى فلوريدا وتكساس)",
 "snowdrop windflower": "شقائق نعمان قطرة الثلج (عشبة أوراسية بزهور بيضاء عطرية متدلية وحيدة)",
 "snowfall": "تَسَاقُط ثُلُوج",
 "snowfield": "حقل ثلجي (مساحة واسعة دائمة من الثلج)",
 "snowflake": "رُقَاقَةُ الثَّلْج, نُدْفَةُ الثَّلْج",
 "snowiness": "بياض الثلج, تغطية ثلجية (الخاصية أو الحالة التي تتميز بوجود الثلج أو تغطيتها به)\nمثال: الرسم التوضيحي مليء بالبياض، تصوير لتغطية الثلج لمنظر أنغولا",
 "snowman": "إِنْسَان ثَلْجِيّ, تِمْثَال ثَلْجِيّ (كَائِن بَشَرِيّ؛ سَوَاد العَيْن)\nمثال: أنا إنسان صادق.",
 "snowmobile": "زَحَّافَةُ ثَلْج, زَحَّافَةُ الثَّلْج",
 "snowplough": "كاسحة ثلوج (مركبة تستخدم لدفع الثلوج من الطرق)",
 "snowplow": "كَاسِحَةُ ثُلُوج",
 "snowshoe": "حذاء ثلجي (جهاز يساعدك على المشي فوق الثلج العميق؛ إطار خفيف الوزن يشبه المضرب مقوى بقطع عرضية ويحتوي على شبكة من السيور؛ يلبس واحد في كل قدم)",
 "snowshoe hare": "أرنب حذاء الثلج (أرنب بري كبير ذو أقدام كبيرة من أمريكا الشمالية؛ أبيض في الشتاء)",
 "snowshoe rabbit": "أرنب حذاء الثلج (أرنب بري كبير ذو أقدام كبيرة من أمريكا الشمالية؛ أبيض في الشتاء)",
 "snowstorm": "عاصفة ثلجية (عاصفة ذات تساقط ثلوج واسع النطاق مصحوبة برياح قوية)",
 "snowsuit": "بدلة ثلج (رداء خارجي للأطفال للطقس البارد)",
 "snowy": "ثَلْجِيّ",
 "snowy egret": "بلشون ثلجي (بلشون صغير من العالم الجديد)",
 "snowy heron": "بلشون ثلجي (بلشون صغير من العالم الجديد)",
 "snowy orchid": "سحلب ثلجي (سحلب مهدب نحيل من شرق أمريكا الشمالية له زهور بيضاء)",
 "snowy tree cricket": "صرصور الشجر الثلجي (صرصور شجر مصفر شاحب واسع الانتشار في أمريكا الشمالية)",
 "snp": "تعدد أشكال النوكليوتيدات المفردة ((في علم الوراثة) تباين وراثي في تسلسل الحمض النووي يحدث عندما يتغير نيوكليوتيد واحد في الجينوم؛ وتعتبر عادة طفرات نقطية كانت ناجحة تطورياً بما يكفي…)",
 "snub": "ازدراء, تجاهل (رفض التعرف على شخص تعرفه) / أَفْطَس, قَصِير بِشَكْل غَيْر عَادِيّ (قَصير بِشَكْل غَيْر اعتِيادِيّ) / رفض, زجر (حالة من الإبعاد أو الصد)\nمثال: كان التجاهل متعمداً بوضوح",
 "snub-nosed": "أَفْطَس, قَصِير الأَنْف (ذو أنف قصير وأفطس)",
 "snuff": "نَشُوق",
 "snuff user": "مستنشق السعوط (شخص يتعاطى السعوط (النشوق))",
 "snuff-brown": "بُنِّيّ رَمَادِيّ مُصْفَرّ (بلون بني رمادي إلى بني مصفر كلون السَّعُوط)",
 "snuff-color": "لون السعوط (بني مصفر داكن)",
 "snuff-colour": "لون السعوط (بني مصفر داكن)",
 "snuffbox": "مِسْعَط, مَنْشَقَة",
 "snuffbox fern": "سرخس المرج, سرخس صندوق السعوط (سرخس في شمال شرق أمريكا الشمالية)",
 "snuffer": "قمع الإطفاء, مطفأة الشموع (أداة مخروطية الشكل ذات مقبض؛ تستخدم لإطفاء الشموع) / مستنشق السعوط (شخص يتعاطى السعوط (النشوق)) / مُطْفِئ الشُّمُوع (شخص يطفئ الشموع)",
 "snuffers": "مقص الشموع (مقص لقص وإمساك ذبالة فتيل الشمعة)",
 "snuffle": "خنخنة, خنين (فعل التنفس بصوت مسموع عبر الأنف (كما هو الحال عند احتقان الأنف))",
 "snuffler": "مُخَنْفِر (شخص يتنفس بصوت عالٍ (بسبب انسداد الأنف بالمخاط))",
 "snuffling": "شَهَّاق, نَشَّاج (يميل إلى الشهقة والنشيج من البكاء)",
 "snuffly": "شَهَّاق, نَشَّاج (يميل إلى الشهقة والنشيج من البكاء)",
 "snug": "دَافِئ, مُرِيح (يوفر دفئاً مريحاً ومأوى خاصة في مكان صغير) / مُحْكَم البِنَاء (مبنيّ بإحكام ومتانة) / مُحْكَم, مُلائِم (ضَيِّق وَمُلائِم لِلجِسْم بِشَكْل مُريح) / آمِن, مُحْتَمٍ (يوفّر الأمان؛ محميّ أو مخبَّأ بشكل جيّد)",
 "snuggery": "غرفة صغيرة مريحة, مخدع (غرفة صغيرة منعزلة)",
 "snuggle": "معانقة حميمة (عناق وثيق وحنون (وغالبا ما يطول))",
 "snuggled": "مُتَوَاضِع, مُحْتَضَن (مشدود أو ملتصق بشخص أو شيء طلباً للحماية أو الحنان)",
 "snuggling": "تقبيل, عناق (اللعب العاطفي (أو المداعبة دون ملامسة الأعضاء التناسلية))",
 "snugly": "بإحكام (بشكل ملائم تماماً (للملابس)) / بأمان (محمي بأمان) / بدفء وراحة (محمي بشكل دافئ ومريح)\nمثال: ناسقت السترة بإحكام",
 "snugness": "حميمية, دفء وراحة (حالة من الراحة الدافئة)",
 "so": "فَـ, لِذَا (الحرف العشرون في حروف الهجاء العربية؛ يفيد الترتيب والتعقيب) / إِذًا, فَ",
 "so far": "حَتَّى الْآنَ (يفيد انتهاء الغاية؛ يفيد الغاية)\nمثال: انتظر حتى أجلس.",
 "so long": "إِلَى اللِّقَاء, مَعَ السَّلَامَة (عبارة وداع)\nمثال: تبادلوا عبارات الوداع",
 "so long as": "مَا دَامَ, مَا (انظر مَا)\nمثال: هلا! ما الجديد؟",
 "so that": "حَتَّى (يفيد انتهاء الغاية؛ يفيد الغاية)\nمثال: انتظر حتى أجلس.",
 "so to speak": "إن جازَ التَعْبِير (يفيد التوكيد)\nمثال: إن شاء الله ؛",
 "so what": "ثُمَّ ماذَا (يفيد الترتيب والتراخي)\nمثال: ثم هناك مشكلة؛",
 "so yeah": "إذاً, وبالتالي (بعبارة أخرى، ونتيجة لذلك)",
 "so-and-so": "فُلَان, فُلَانَة (كلمة تستخدم لوصف شخص ما بدون ذكر من هو، غالبًا يقصد به \"أي شخص من الناس\"، أو شخص لا يريد المتحدث ذكره)\nمثال: سمعنا ذلك من فلان و فلان.",
 "so-called": "مَا يُسَمَّى (انظر مَا)\nمثال: هلا! ما الجديد؟",
 "so-so": "بَيْنَ بَيْنَ (ظرف مكان بمعنى وَسْط) / نِصْف نِصْف, نُصّ نُصّ\nمثال: مصيري بين يديك.",
 "soak": "اِبْتَلَّ",
 "soakage": "غمر, نقع (عملية التلين والتشبع نتيجة الغمر في الماء (أو سائل آخر))\nمثال: أعاد النقع الجيد الحياة للعربة",
 "soaked": "مَنْقُوع",
 "soaker": "كحولي, مدمن كحول (شخص يشرب الكحول بإفراط وبشكل اعتيادي) / طوفان, هطول غزير (مطر غزير)",
 "soaking": "نقع (غسل شيء عن طريق تركه منقعاً في سائل) / إشباع بالماء, نقع (فعل جعل الشيء مبللاً تماماً) / غارقاً في البلل, مبللاً تماماً (رطب للغاية) / غمر, نقع (عملية التلين والتشبع نتيجة الغمر في الماء (أو سائل آخر))\nمثال: نقعه بالماء نقعاً",
 "soaking syrup": "شراب التسقية (مزيج من الماء والسكر ومكونات مختلفة (مثل الكحول)، يستخدم لغمر الكعك)\nمثال: حيلة بسيطة للحفاظ على الكعكة رطبة وجميلة هي دهنها بشراب التسقية فور إخراجها من الفرن",
 "soaking up": "امتصاص ((في الكيمياء) عملية تتغلغل فيها مادة في أخرى؛ حيث يتغلغل مائع في سائل أو صلب أو يذوب فيه)",
 "soap": "صَابُون, صابونة",
