 "spotless": "بِلَا شَائِبَة, نَاصِع (بالغ النظافة وخالٍ من أيّ بقعة أو لطخة)",
 "spotlessly": "بلا شائبة, بنظافة تامة (بطريقة خالية من البقع)\nمثال: نظيف تماماً",
 "spotlessness": "طهارة, نظافة تامة (حالة النظافة التامة (بلا بقع))",
 "spotlight": "أَضْوَاء",
 "spots": "أجسام طافية, ذباب طائر (بقع أمام العينين تسببها شظايا خلايا معتمة في الجسم الزجاجي والعدسة)\nمثال: تبدو الأجسام الطافية وكأنها تنجرف عبر مجال الرؤية",
 "spotted": "مُنَقَّط, أَرْقَط / أَبْرَش (مِن على جلده نقط بيضاء، أو نقط يختلف لونها عن لون الجلد، فيُقال فَرَسٌ أَبْرَش؛ يُقال مَكَانٌ أَبْرَش أي كثير النبات مختلف الألوان)",
 "spotted antbird": "طائر النمل المرقط (نوع من طيور النمل يوجد في هندوراس ونيكاراغوا وكوستاريكا وبنما، وكذلك كولومبيا والإكوادور في شمال غرب أمريكا الجنوبية)",
 "spotted bat": "خفاش مرقط (خفاش كبير من جنوب غرب الولايات المتحدة له بقع وآذان ضخمة)",
 "spotted black bass": "قاروص كنتاكي الأسود (نوع من القاروص الأسود)",
 "spotted coral root": "جذر المرجان المرقط (جذر مرجان شائع له سيقان عديمة الأوراق بنية مصفرة أو محمرة أو أرجوانية تحمل عناقيد فضفاضة من الزهور الملونة بالمثل بشفاه بيضاء مرقطة بالأرجواني؛…)",
 "spotted cowbane": "شوكران مائي مبقع (شوكران مائي طويل ثنائي الحول في شمال شرق أمريكا الشمالية له سيقان مبقعة بالأرجواني وعناقيد من الجذور الدرنية شديدة السمية تشبه البطاطا الحلوة الصغيرة)",
 "spotted crake": "مرعة رقطاء (طائر مرعة أوراسي يعيش في المستنقعات والأهوار)",
 "spotted cranesbill": "إبرة الراعي البرية, غرنوقي مبقع (إبرة راعي برية شائعة في شرق أمريكا الشمالية بأوراق مشقوقة بعمق وزهور وردية أرجوانية)",
 "spotted dick": "سبوتد ديك (بودينغ شحم يحتوي على الكشمش)",
 "spotted eagle ray": "لخمة النسر المرقطة (لخمة ظهرها مغطى ببقع بيضاء أو صفراء؛ واسعة الانتشار في البحار الدافئة)",
 "spotted fever": "حمى مبقعة (أي من الأمراض الحمّية الشديدة التي تتميز بطفح جلدي أو بقع على الجلد)",
 "spotted flycatcher": "صائد الذباب المرقط (صائد ذباب غابات أوروبي شائع بريش بني رمادي)",
 "spotted gum": "صمغ مرقط (شجرة صمغ كبيرة ذات لحاء مرقط)",
 "spotted hemlock": "شوكران مائي مبقع (شوكران مائي طويل ثنائي الحول في شمال شرق أمريكا الشمالية له سيقان مبقعة بالأرجواني وعناقيد من الجذور الدرنية شديدة السمية تشبه البطاطا الحلوة الصغيرة)",
 "spotted hyena": "ضبع ضاحك, ضبع مرقط (ضبع أفريقي يشتهر بعوائه المميز)",
 "spotted joe-pye weed": "جو باي المرقط, غافث مرقط (عشب من أمريكا الشمالية له أوراق محيطية وعناقيد طرفية من رؤوس الزهور الوردية أو الأرجوانية الصغيرة)",
 "spotted lynx": "وشق أيبيري (يعيش في جنوب أوروبا)",
 "spotted owl": "بومة رقطاء (بومة كبيرة من أمريكا الشمالية توجد في الغابات من كولومبيا البريطانية إلى وسط المكسيك؛ لها ريش بني داكن وصدر مرقط بكثافة)",
 "spotted ray": "لخمة النسر المرقطة (لخمة ظهرها مغطى ببقع بيضاء أو صفراء؛ واسعة الانتشار في البحار الدافئة)",
 "spotted salamander": "سمندل منقط (سمندل أوروبي ذو جلد داكن مع بقع صفراء عادة) / سمندل أرقط (سمندل أسود لامع من أمريكا الشمالية ذو بقع صفراء)",
 "spotted sandpiper": "طيطوي منقط (طيطوي شائع في أمريكا الشمالية)",
 "spotted sea trout": "السمكة الضعيفة المرقطة, تراوت البحر المرقط (سمكة ضعيفة في جنوب المحيط الأطلسي وسواحل الخليج في الولايات المتحدة)",
 "spotted skunk": "ظربان مرقط (ظربان صغير ذو معطف رخامي أسود وأبيض؛ من الولايات المتحدة والمكسيك)",
 "spotted squeateague": "السمكة الضعيفة المرقطة, تراوت البحر المرقط (سمكة ضعيفة في جنوب المحيط الأطلسي وسواحل الخليج في الولايات المتحدة)",
 "spotted sunfish": "سمكة الشمس المرقطة (تعيش في الجداول من كارولينا الجنوبية إلى فلوريدا؛ سمكة مقلاة محبوبة)",
 "spotted water hemlock": "شوكران مائي مبقع (شوكران مائي طويل ثنائي الحول في شمال شرق أمريكا الشمالية له سيقان مبقعة بالأرجواني وعناقيد من الجذور الدرنية شديدة السمية تشبه البطاطا الحلوة الصغيرة)",
 "spotted weakfish": "السمكة الضعيفة المرقطة, تراوت البحر المرقط (سمكة ضعيفة في جنوب المحيط الأطلسي وسواحل الخليج في الولايات المتحدة)",
 "spottedness": "تبقع, تنقيط (صفة أو حالة التميز بوجود بقع)\nمثال: غالباً ما يُخطأ في أنها نمور بسبب التشابه التقريبي في الحجم والتنقيط",
 "spotter": "راصد, مكتشف (شخص يكون أول من يلاحظ شيئاً) / حارِس, خَفِير (شخص يتم توظيفه للمراقبة تحسباً لحدث متوقع) / علّام, محدد المواقع (عامل يتم توظيفه لوضع علامات (كمحددات أو معرفات)) / مزيل البقع (عامل يعمل في مؤسسة للتنظيف الجاف لإزالة البقع)",
 "spotting": "اكتشاف, رصد (فعل اكتشاف شيء ما؛ أو ملاحظة شيء ما) / تبقيع, تلطيخ (فعل تبقيع أو تلطيخ شيء ما)",
 "spotty": "غَيْرُ مُنْتَظِمٍ, مُتَفَاوِت (يَفْتَقِرُ إِلَى الِاتِّسَاقِ وَالِانْتِظَامِ) / مُبَقَّع, مُرَقَّع (ذو بقع أو رقع صغيرة من لون أو ملمس مغاير)",
 "spousal": "زوجي (متعلق بالزوج أو الزوجة) / زفافي, زواجي (متعلق بحفل الزفاف)\nمثال: رمز مناسب للحب الزوجي",
 "spousal equivalent": "شَرِيك حَياة, شَرِيك مُساكِن (شخص (ليس بالضرورة زوجاً) تعيش معه وتشترك معه في علاقة طويلة الأمد)",
 "spousal relationship": "زواج, قران (حالة كون الزوجين مرتبطين طوعاً مدى الحياة (أو حتى الطلاق))\nمثال: زواج طويل وسعيد",
 "spouse": "زَوْج, زَوْجَة (زَوَّجَ الأَشياءَ تَزْويجًا، وزَواجًا: قرن بعضَها ببعض؛ زَوَّجَ فلانًا امرأةً، وبها: جعله يتزوَجَها)\nمثال: زوجة ماري طبيبة.",
 "spouse equivalent": "شَرِيك حَياة, شَرِيك مُساكِن (شخص (ليس بالضرورة زوجاً) تعيش معه وتشترك معه في علاقة طويلة الأمد)",
 "spout": "فوهة, مصب (فتحة تسمح بمرور السوائل أو الحبوب)",
 "spouter": "حوت نافث (حوت ينفث الماء) / بئر متفجر (بئر نفط يتدفق بقوة) / ثرثار, مهذار (متحدث مزعج وأحمق وكثير الكلام)",
 "spouting": "مُتَطَاير, مُنْدَفِع (يُدفَع بقوَّة في مجرى ضيِّق عادةً)",
 "sprachgefuhl": "حس لغوي (شعور حدسي بالأسلوب الطبيعي للغة)",
 "sprag": "دعامة منجم (دعامة خشبية تستخدم لدعم سقف المنجم) / سنادة العجلة (إسفين أو قضيب يوضع تحت العجلة أو بين القضبان لمنع المركبة من التدحرج على منحدر)",
 "spraguea umbellatum": "سبرياغا, مخلب القطة (عناقيد وردية من الزهور المكتظة بكثافة على سيقان منبسطة تشبه وسائد أقدام القطط المقلوبة؛ تنمو في الغابات الصنوبرية في غرب أمريكا الشمالية)",
 "sprain": "اِلْتِوَاء",
 "sprat": "إسبرط, رنجة صغيرة (رنجة صغيرة تُعالج مثل السردين) / إسبرط, رنجة صغيرة (سمكة أوروبية صغيرة دهنية؛ عادة تدخن أو تعلب مثل السردين)",
 "sprawl": "انبطاح, تمدد (وضعية غير أنيقة مع تباعد الذراعين والساقين) / تكتل حضري, تمدد حضري (تجمع أو شبكة متصلة من المجتمعات الحضرية)",
 "sprawler": "مُتَمَدِّد, مُنْبَطِح (شخص يتمدد بغير انتظام)\nمثال: إنه متمدد للغاية لدرجة أنه يحتاج إلى سرير لنفسه",
 "sprawling": "مُتَرَامِي الأَطْرَاف, مُتَنَاثِر (يَمْتَدُّ فِي اتِّجَاهَاتٍ مُخْتَلِفَةٍ أَوْ مُوَزَّعٌ بِشَكْلٍ غَيْرِ مُنْتَظِم) / انبطاح, تمدد (وضعية غير أنيقة مع تباعد الذراعين والساقين)",
 "sprawly": "مُتَمَدِّد بِشَكْل غَيْر مُنْتَظَم (مُمْتَدّ بِشَكْل عَشْوائِيّ وَغَيْر مُنَظَّم)",
 "spray": "مرذاذ (موزع يحول السائل (مثل العطر) إلى رذاذ ناعم) / غصن مزهر (تنسيق زهور يتكون من غصن واحد أو فرع يحمل أزهاراً وأوراقاً) / رذاذ (دفق من البخار أو قطرات السائل) / رذاذ, رشقة (كمية من الأجسام الصغيرة تتطاير في الهواء)\nمثال: رشقة من الرصاص",
 "spray can": "بخاخ, رذاذ (موزع يحمل مادة تحت الضغط ويمكنه إطلاقها كرذاذ ناعم)",
 "spray extraction cleaner": "آلة تنظيف بالرش والشفط, منظفة سجاد (آلة تنظف أسطح المنسوجات، مثل السجاد والأرضيات الصلبة والمفروشات والمراتب)",
 "spray extraction machine": "آلة تنظيف بالرش والشفط, منظفة سجاد (آلة تنظف أسطح المنسوجات، مثل السجاد والأرضيات الصلبة والمفروشات والمراتب)",
 "spray gun": "مسدس رش (أداة تشبه المسدس لوضع المواد السائلة (مثل الطلاء) على شكل رذاذ)",
 "spray paint": "طلاء بالرش (طلاء يطبق بمسدس الرش)",
 "spray painting": "طلاء بالرش (وضع الطلاء باستخدام بخاخ)",
 "spray-dried": "مجفف بالرذاذ (مجفف عن طريق ملامسة مادة مرشوشة (مثل الحليب أو الصابون) بالهواء الساخن واستعادتها في شكل مسحوق)",
 "sprayer": "مرذاذ (موزع يحول السائل (مثل العطر) إلى رذاذ ناعم) / عامل رش (عامل يضع الرذاذ على سطح ما)",
 "spraying": "رش المحاصيل (نثر مبيدات الفطريات أو الحشرات أو الأسمدة على المحاصيل النامية (غالباً من طائرة تحلق على ارتفاع منخفض)) / رش (وضع سائل على شكل جزيئات صغيرة تقذف من بخاخ) / رذاذ, رشقة (كمية من الأجسام الصغيرة تتطاير في الهواء)\nمثال: رشقة من الرصاص",
 "spread": "نَشَرَ (بَسَطَ، فَرَّقَ، نَشَرَ الشيءَ: جعله منتشراً، مثل نشر الأخبار أو نشر كتاب؛ نَشَرَ: وزع أو عمم شيئًا بين الناس، مثل نشر المقالات) / اِنْتِشَار (مصدر الفعل \"انْتَشَرَ\"؛ (في الفيزياء) عملية توزيع جزيئات أو ذرات أو حبيبات بشكل متساوٍ في فراغ أو في حيز متاح أو تخللها خلال حاجز غشائي)\nمثال: نشر توم الغسيل.",
 "spread eagle": "حركة النسر (شكل تزلج يُنفذ بوضع الزلاجات كعباً لكعب في خط مستقيم) / النسر المنبسط (شعار (نسر بأجنحة وأرجل مفرودة) على وجه الختم العظيم للولايات المتحدة)",
 "spread head": "صفحتان متقابلتان (صفحتان متواجهتان في كتاب أو منشور آخر)",
 "spread out": "تَفَرَّقَ (تفرق الشَّيْء تفَرقا وتفراقا تبدد وَالرجلَانِ ذهب كل مِنْهُمَا فِي طَرِيق؛ تفرَّقَ) / فَرَّقَ / مُنْتَشِر, مُتَفَرِّق\nمثال: أتستطيع أن تفرق توم من أخيه؟",
 "spread-eagle": "مُنْبَطِح مُتَفَرِّج (مُمْتَدّ وَالذِّراعان وَالسَّاقان مَفْتوحَتان وَمُتَباعِدَتان)",
 "spreader": "آلة نثر, ناثرة (جهاز ميكانيكي لنثر شيء ما (مثل البذور أو السماد أو الرمل وما إلى ذلك) في جميع الاتجاهات) / أداة فرد, سكين فرد (أداة يدوية لفرد شيء ما)\nمثال: استخدم سكينه كأداة للفرد",
 "spreader beam": "عارضة توزيع الأحمال, عارضة رفع (عارضة تُستخدم أسفل الخطاف للرفع، ومجهزة بعدد من الحبال في نقاط مختلفة على طولها)",
 "spreadhead": "صفحتان متقابلتان (صفحتان متواجهتان في كتاب أو منشور آخر)",
 "spreading": "انتشار, نشر (عملية الامتداد على نطاق أوسع أو مساحة من المكان أو الزمان) / إذاعة, نشر (فتح موضوع لمناقشة واسعة وجدل) / انتشار, تفشي (عملية أو نتيجة التوزيع أو الامتداد على مساحة واسعة من الفضاء)",
 "spreading bellflower": "جريس كارباتي, جريس منتشر (زهرة جرس أوروبية معمرة تنمو في كتل بسيقان منتشرة وأزهار زرقاء أو بيضاء)",
 "spreading dogbane": "دفل شائع, قاتل الكلب الشائع (نبات معمر في أمريكا الشمالية له أزهار وردية في نورات محدودة سائبة؛ يستخدم في الطب الشعبي لعلاج الألم أو الالتهاب في المفاصل)",
 "spreading factor": "هيالورونيداز (إنزيم يحلل حمض الهيالورونيك وبالتالي يقلل من لزوجته ويزيد من نفاذية النسيج الضام وامتصاص السوائل)",
 "spreading fleabane": "يرغوث مفترش (نبات جيد التفرع ذو أوراق وسيقان مشعرة كل منها برأس زهرة منفرد بأشعة ضيقة بيضاء أو وردية أو لافندر؛ غرب أمريكا الشمالية)",
 "spreading pogonia": "أوركيد برعم الورد قمعي العرف, بوجونيا منتشرة (أوركيد في شمال شرق الولايات المتحدة بزهور وردية أرجوانية ذات شفة قمعية الشكل؛ يوضع أحياناً في جنس بوجونيا)",
 "spreadsheet": "جَدْوَل بَيَانَات",
 "sprechgesang": "غناء كلامي (أسلوب من الأداء الصوتي الدرامي بين الغناء والكلام)",
 "sprechstimme": "غناء كلامي (أسلوب من الأداء الصوتي الدرامي بين الغناء والكلام)",
 "spree": "مرح, نوبة انغماس (انغماس قصير في دوافعك)",
 "spree killer": "قاتل فورة الغضب (قاتل متسلسل تحدث جرائم قتله خلال فترة زمنية وجيزة)",
 "sprig": "عَسْلُوج",
 "sprig tail": "طيهوج حاد الذيل (طيهوج كبير من البراري والغابات المفتوحة في غرب أمريكا الشمالية)",
 "sprigged": "مُزَيَّن بِأَغْصَان (مُزخرَف بنقوش أغصان صغيرة)",
 "sprigger": "نازع العروق (عامل ينزع السيقان من أوراق التبغ المرطبة ويربط الأوراق معاً)",
 "sprightliness": "حيوية, روح (الحيوية والطاقة في العمل أو التعبير)\nمثال: كانت مسرحية ثقيلة وحاول الممثلون عبثاً بث الحياة فيها",
 "sprightly": "دَجِر",
 "sprigtail": "طيهوج حاد الذيل (طيهوج كبير من البراري والغابات المفتوحة في غرب أمريكا الشمالية)",
 "spring": "عَيْن, يَنْبُوع (المُعَايَنَة والمشاهدة؛ العين : حاسة البصر والرؤية - مؤنث - تكون للإنسان وغيره من الحيوان . قال ابن السكيت : العين التي يبصر بها الناظر…) / يَاي, زُنْبُرُك\nمثال: كان عين ليلى مسودة.",
 "spring balance": "ميزان زنبركي (ميزان يقيس الوزن عن طريق الشد في زنبرك حلزوني)",
 "spring beauty": "جمال الربيع, كلايتونيا رمحية (نبات رفيع صغير له زوج واحد من الأوراق اللحمية في منتصف الساق وعنقود رخو من الزهور البيضاء أو الوردية أو الوردية على شكل وعاء وورم صالح للأكل)",
 "spring break": "عُطْلَة الرَّبِيع, إِجَازَة الرَّبِيع",
 "spring cankerworm": "دودة الربيع القاطعة",
 "spring chicken": "دجاج ربيعي (دجاجة صغيرة ذات لحم طري) / شاب, يافع (شخص صغير السن (خاصة شاب أو صبي))",
 "spring cleavers": "جويسئة خشنة, عشب الإوز (نبات حولي له ساق مغطى بأشواك منحنية؛ أمريكا الشمالية وأوروبا وآسيا)",
 "spring cress": "حرف بصيلي, رشاد الربيع (رشاد صغير أبيض الزهور شائع في الأماكن الرطبة في شرق أمريكا الشمالية)",
 "spring equinox": "اعتدال ربيعي (الوَسَطِيَّة، يقابله التَطَرُّف؛ التَنَاسُب وأن يكون الأمر عَدْلا، يقابله الاِنْقِلاب)\nمثال: الاعتدال هو اليوم الذي يتساوى به الليل و النهار بنفس المدة.",
 "spring frog": "ضفدع النمر (ضفدع أخضر أو بني شائع في أمريكا الشمالية له بقع بيضاوية داكنة ذات حواف بيضاء) / ضفدع أخضر (يشبه ضفدع الثور؛ يوجد في المستنقعات والبرك أو بالقرب منها؛ في الولايات المتحدة وكندا)",
 "spring gun": "بندقية فخ (بندقية مضبوطة لإطلاق النار على أي متسلل يلامس السلك الذي يشغلها)",
 "spring heath": "خلنج ربيعي, خلنج شتوي (شجيرة أوروبية قزمة بزهور حمراء على شكل جرس تزهر مبكراً جداً)",
 "spring mattress": "مرتبة زنبركية (مرتبة تحتوي على نوابض في إطار صلب)",
 "spring onion": "بصل أخضر (بصل صغير قبل تضخم البصلة؛ يؤكل في السلطات)",
 "spring peeper": "ضفدع الربيع (علجوم شجري بني صغير له نداء حاد يسمع بالقرب من الأراضي الرطبة في شرق الولايات المتحدة وكندا في أوائل الربيع)",
 "spring roll": "سبرينغ رول, لفافة البيض (خضروات ولحم مفروم ملفوف في فطيرة ومقلية)",
 "spring scale": "ميزان زنبركي (ميزان يقيس الوزن عن طريق الشد في زنبرك حلزوني)",
 "spring squill": "إشقيلي ربيعي, عنصل (إشقيلي أوروبي بزهور زرقاء أو أرجوانية صغيرة)",
 "spring training": "تدريب الربيع (تدريب ما قبل الموسم خلال الربيع)",
 "spring vetch": "جلبان ربيعي (نبات معمر أوروبي كثيف له زهور بنفسجية زرقاء عنقودية مائلة للأسفل) / بيقية الربيع, بيقية مزروعة (نبات متسلق عشبي قيم كعلف ولتحسين التربة)",
 "spring vetchling": "جلبان ربيعي (نبات معمر أوروبي كثيف له زهور بنفسجية زرقاء عنقودية مائلة للأسفل)",
 "spring water": "مياه الينابيع (مياه من نبع طبيعي) / مياه جوفية (مياه تحت الأرض محتجزة في التربة وفي الصخور المنفذة)",
 "spring-blooming": "مُزْهِر فِي الرَّبِيع (من النباتات التي تُزهر خلال فصل الربيع)",
 "spring-cleaning": "تنظيف الربيع, تنظيف شامل (نشاط تنظيف المنزل بشكل شامل في نهاية الشتاء)",
 "spring-flowering": "مُزْهِر فِي الرَّبِيع (من النباتات التي تُزهر خلال فصل الربيع)",
 "spring-loaded": "زنبركي, محمل بنابض (يحتوي على نابض مضغوط يضغط جزءاً ضد آخر)",
 "springboard": "منطلق",
 "springbok": "قَوْفَز",
 "springbuck": "سبرينغبوك, غزال القفز (غزال جنوب أفريقي معروف بقفزه بخفة في الهواء)",
 "springer": "سبرينغر سبانييل (سبانييل كبير ذو فراء حريري مموج عادة ما يكون أسود أو كبدي وأبيض) / بقرة على وشك الولادة (بقرة على وشك أن تلد) / حجر الارتكاز (أدنى حجر في القوس الذي يبدأ منه القوس)",
 "springer spaniel": "سبرينغر سبانييل (سبانييل كبير ذو فراء حريري مموج عادة ما يكون أسود أو كبدي وأبيض)",
 "springfield": "سْبْرِينْغْفِيلْد / سْبْرِينْجْفِيلْد",
 "springiness": "لينة, مرونة (مرونة شيء يمكن تمديده ويعود إلى طوله الأصلي)",
 "springing cow": "بقرة على وشك الولادة (بقرة على وشك أن تلد)",
 "springless": "بِلَا نُبُوضَة, جَامِد (يفتقر إلى المرونة أو الحيوية)",
 "springlike": "شَبِيهٌ بِالنَّابِض, نَابِضِيّ (يُشبه النابض أو حركته)",
 "springtail": "قافزات الذيل (أي من الحشرات البدائية الدقيقة عديمة الأجنحة العديدة التي تمتلك زائدة بطنية خاصة تسمح بنمط القفز المميز شبه الدائم؛ توجد في التربة الغنية بالحطام…)",
 "springtide": "مد ربيعي, مد عالي (مد أكبر من المتوسط يحدث أثناء المحاق والبدر) / فيض (اندفاع متزايد لأي شيء)\nمثال: ارتقى على فيض الازدهار",
 "springtime": "ربيع (موسم النمو)\nمثال: البراعم الناشئة كانت علامة أكيدة على الربيع",
 "springy": "خَفِيف, مَرِن ((عن الحركات) خفيف ونشط بثقة) / مَرِنٌ مُرْتَدّ, نَابِض (مرن ويرتدّ بسهولة)",
 "sprinkle": "رش, نثر (فعل رش أو طرطشة الماء) / رشراش, زخات خفيفة متفرقة (زخة خفيفة تسقط في بعض المواقع دون غيرها القريبة)",
 "sprinkler": "رشاش (جهاز ميكانيكي يربط بخرطوم الحديقة لري العشب أو الحديقة)",
 "sprinkler system": "نظام إطفاء الحرائق, نظام الرشاشات (نظام لإطفاء الحرائق؛ يتم إطلاق الماء من شبكة من الأنابيب العلوية عبر فوهات تفتح تلقائياً مع ارتفاع درجة الحرارة)",
 "sprinkles": "حبيبات شوكولاتة, سبرنكلز (قطع صغيرة من الشوكولاتة الحلوة تستخدم كزينة على الآيس كريم مثلاً)",
 "sprinkling": "رش, نثر (فعل رش أو طرطشة الماء) / رش الماء (فعل رش الماء في المعمودية (نادر)) / رشراش, زخات خفيفة متفرقة (زخة خفيفة تسقط في بعض المواقع دون غيرها القريبة) / رشات, قلة متناثرة (عدد صغير (من شيء ما) مبعثر بشكل عشوائي)\nمثال: أولى علامات الاخضرار المتناثرة",
 "sprint": "ركض سريع, عدو سريع (جري سريع)",
 "sprinter": "عداء سريع (شخص يركض مسافة قصيرة بأقصى سرعة)",
 "sprit": "دقل (عارضة خفيفة تعبر شراعاً أمامياً وخلفياً بشكل قطري)",
 "sprite": "سْبْرَايْت",
 "sprites": "عفاريت حمراء (كهرباء جوية (تستمر 10 مللي ثانية) تظهر كومضات كروية من الضوء الأحمر (وردي إلى أحمر قاني) ترتفع لارتفاعات تصل إلى 60 ميلاً (تُرى أحياناً مع عفاريت…)",
 "spritsail": "شراع ذراع, شراع سبريت (شراع طولي ممدود بواسطة ذراع مائلة (سبريت))",
 "spritz": "بخة, رشة (دفق سريع لسائل ما (عادة ماء غازي))",
 "spritzer": "سبريتزر (مشروب مخلوط مصنوع من النبيذ الممزوج بماء فوار)",
 "sprocket": "سن الترس (سن على حافة عجلة مسننة) / ترس مسنن (عجلة رقيقة ذات أسنان تتعشق مع سلسلة) / ترس مسنن, عجلة مسننة (بكرة ذات أسنان على الحواف لسحب الفيلم أو الورق من خلالها)",
 "sprocket wheel": "ترس مسنن (عجلة رقيقة ذات أسنان تتعشق مع سلسلة)",
 "sprog": "طفل (الصَغِير السِنّ من الحَيْوَان أو الإنْسَان، وَلَد الإنسان أو الحيوان؛ الإنسان منذ أن تلده أمه حتى يَبْلُغ) / مجند جديد (مجند عسكري جديد (مصطلح عامي))\nمثال: هو طفل العائلة.",
 "sprout": "نَبْتَة",
 "sprouted": "مُنْبَثِق, نَابِت ((عن النباتات النامية) خَرَجَ لِتَوِّهِ مِنَ الأَرْض)",
 "sprouter": "منبت بذور (جهاز لإنبات البذور)",
 "sprouting": "إنبات, تبرعم (العملية التي تنبت بها البذور أو الأبواغ وتبدأ في النمو)",
 "spruce": "تَنُّوب",
 "spruce bark beetle": "خنفساء لحاء التنوب (خنفساء صغيرة تحب الحفر عبر لحاء أشجار التنوب وأكل الكامبيوم مما يقتل الشجرة في النهاية)",
 "spruce beer": "بيرة التنوب (مشروب يُصنع عن طريق تخمير دبس السكر وسكريات أخرى مع عصارة أشجار التنوب (وأحياناً مع الشعير))",
 "spruce gall aphid": "من عفص التنوب (نوع من الأرقة يعد آفة لتنوب النرويج وأنواع مختلفة من تنوب أمريكا الشمالية، وخاصة التنوب الأبيض والتنوب الأسود)",
 "spruce grouse": "طيهوج التنوب (طيهوج من أمريكا الشمالية يتغذى على براعم وإبر الأشجار دائمة الخضرة)",
 "spruce pine": "صنوبر التنوب (صنوبر كبير ثنائي الإبر من جنوب شرق الولايات المتحدة بخشب ناعم خفيف) / صنوبر الشاطئ, صنوبر لودجبول (صنوبر شجيري ثنائي الإبر من الساحل الشمالي الغربي للولايات المتحدة؛ لحاء أحمر إلى أصفر بني متشقق إلى مربعات صغيرة) / تنوب أسود (تنوب صغير في المناطق المستنقعية بشمال شرق أمريكا الشمالية له فروع منتشرة بأوراق كثيفة؛ خشب رديء) / تسوغا شرقية, تسوغا كندية (شجرة غابات شائعة في شرق الولايات المتحدة وكندا؛ تستخدم خاصة لخشب اللب)",
 "spruce squirrel": "سنجاب أحمر أمريكي (من شمال الولايات المتحدة وكندا)",
 "spruced up": "بِأَبْهَى حُلَّة, مُتَأَنِّق (يرتدي ملابس أنيقة أو رسمية)",
 "sprucely": "بأناقة, على الموضة (بطريقة عصرية وأنيقة)\nمثال: كان يرتدي ملابس أنيقة",
 "spruceness": "أناقة, هندام (حالة كون الشخص أنيقاً ومهندماً)",
 "sprue": "إسهال مداري, ذرب (اضطراب مزمن يحدث بأشكال مدارية وغير مدارية وفي كل من الأطفال والبالغين؛ لا يتم امتصاص العناصر الغذائية؛ تشمل الأعراض إسهالاً كريه الرائحة وهزالاً)",
 "sprung rhythm": "إيقاع مرن, إيقاع منطلق (إيقاع شعري يحاكي إيقاع الكلام)",
 "spry": "خَفِيف الحَرَكَة, رَشِيق (يتحرّك بسرعة وخفّة)",
 "spud": "مجرفة قلع (مجرفة يدوية حادة لاقتلاع الجذور والأعشاب الضارة) / بطاطا, بطاطس (درنة صالحة للأكل موطنها أمريكا الجنوبية؛ طعام أساسي في أيرلندا)",
 "spume": "زبد البحر (رغوة أو زبد على سطح البحر)",
 "spumy": "رَغْوِيّ, فَقَّاعِيّ (يُصدر فقاعات أو مليء بها كما في المشروبات الغازيّة أو التخمير)",
 "spun silk": "حرير مغزول (خيط مصنوع من نفايات الحرير)\nمثال: عمل الغازل هو تقويم هذه الألياف بمساعدة الآلات، ثم ضمها معاً لتصبح خيطاً يُعرف بالحرير المغزول",
 "spun sugar": "حلوى القطن, شعر البنات (حلوى تُصنع بغزل السكر الذي تم غليه إلى درجة حرارة عالية)",
 "spun yarn": "خيط مغزول ((مصطلح بحري) حبال صغيرة تتكون من حبل خفيف الوزن مصنوع من عدة خيوط حبال ملفوفة معاً برخاوة)",
 "spunk": "جسارة, جلد (الشجاعة للاستمرار والمضي قدماً) / صوفان, قشاشة (مادة لبدء إشعال النار)\nمثال: استمر في القتال بفضل جسارته المحضة",
 "spunky": "جَرِيء, ذُو هِمَّة (مُسْتَعِدّ لِمُوَاجَهَة الخَطَر) / جَسُور, شُجَاع (يُظهر شجاعة وإقدامًا وروحًا قتاليّة)",
 "spur": "مِهْمَاز",
 "spur blight": "لفحة النتوءات (مرض يصيب التوت)",
 "spur gear": "ترس أسطواني, ترس عدل (عجلات تروس تتعشق في نفس المستوى)",
 "spur track": "خط فرعي (خط سكة حديد متصل بخط رئيسي)",
 "spur wheel": "ترس أسطواني, ترس عدل (عجلات تروس تتعشق في نفس المستوى)",
 "spur-of-the-moment": "آنِيّ, وَلِيد اللَّحْظَة (استجابةً لحاجة غير متوقعة)",
 "spurge": "فربيون, يتوع",
 "spurge laurel": "غار الخشب, غار الفربيون (شجيرة أوراسية كثيفة بأوراق مستطيلة جلدية لامعة وزهور خضراء مصفرة)",
 "spurge nettle": "عشبة لاسعة, قراص الدربيون (عشب لاسع في أمريكا الاستوائية)",
 "spurious": "زَائِف, مَنْحُول (كاذب أو مُقلَّد؛ ليس كما يبدو عليه) / لَقِيط, نَغْل (وُلِدَ خارِج إِطار الزَّواج الشَّرْعِيّ) / زَائِف, مُضَلِّل (يبدو معقولًا لكنه كاذب في حقيقته) / زَائِف, مُزَيَّف (يَبْدُو صَحِيحًا ظَاهِرِيًّا لَكِنَّهُ غَيْرُ صَحِيحٍ فِعْلِيًّا)",
 "spurious correlation": "ارتباط زائف (ارتباط بين متغيرين لا ينتج عن أي علاقة مباشرة بينهما بل من علاقتهما بمتغيرات أخرى)",
 "spurious wing": "الجَنَاحُ الكَاذِب, جُنَيْح (خصلة من الريش الصغير الصلب على الإصبع الأول لجناح الطائر)",
 "spuriously": "بشكل باطل, زيفاً (بطريقة كاذبة ومزيفة)\nمثال: جادل المحامي بشكل زائف بأن موكله لا يعرف شيئاً عن السطو",
 "spuriousness": "انتحال, زيف (حالة الافتقار للأصالة)",
 "spurned": "مَرْفُوض, مَهْجُور (رفضه الحبيب دون سابق إنذار)",
 "spurner": "رَافِض بَازْدِرَاء, لَافِظ (شخص يرفض (شخصاً أو شيئاً) بازدراء)\nمثال: كانت معروفة بأنها رافضة لكل الخاطبين",
 "spurred gentian": "جنطيانا مهمازية",
 "spurring": "تحفيز, حث (لفظ يشجعك على محاولة شيء ما)\nمثال: النكز المستمر أثار أعصابه",
 "spurt": "بَخَّ, نَضَحَ (بلل بدفقة من السائل) / بخ, دفق (حدوث تصريف مفاجئ (لسائل))\nمثال: بخ الجدار بالماء",
 "spurting": "مُتَطَاير, مُنْدَفِع (يُدفَع بقوَّة في مجرى ضيِّق عادةً)",
 "sputnik": "سْبُوتْنِيك",
 "sputter": "بقبقة, تأتأة غاضبة (تلفظ (بكلمات) مع أصوات بصق (كما في الغضب)) / تطاير, طرطشة (ضجيج شيء يتناثر أو يطرطش بشكل انفجاري)\nمثال: سمع طرطشة نيران",
 "sputtering": "تطاير, طرطشة (ضجيج شيء يتناثر أو يطرطش بشكل انفجاري)\nمثال: سمع طرطشة نيران",
 "sputum": "بلغم (مادة مقشوعة (مبصوقة)؛ لعاب ممزوج بإفرازات من الممرات التنفسية)",
 "sputum smear": "مَسْحَةُ البَلْغَم, مَسْحَةُ التَّنْظِيرِ القَصَبِيّ (أي من عدة مسحات خلوية يتم الحصول عليها من أجزاء مختلفة من الجهاز التنفسي السفلي؛ تستخدم للدراسة الخلوية للسرطان وأمراض أخرى في الرئتين)",
 "spy": "جَاسُوس / تَجَسَّسَ",
 "spy satellite": "قمر تجسس (قمر صناعي مزود بأجهزة استشعار للكشف عن الانفجارات النووية أو المراقبة)",
 "spyglass": "تلسكوب صغير, منظار (تلسكوب كاسر (انكساري) صغير الحجم)",
 "spyhole": "ثقب النظر, عدسة الباب (ثقب (في باب أو فرن وما إلى ذلك) يمكنك من خلاله الاختلاس)",
 "spying": "اكتشاف, رصد (فعل اكتشاف شيء ما؛ أو ملاحظة شيء ما) / تجسس, عمل سري (فعل المراقبة السرية لأغراض استخباراتية) / تجسس (الحفاظ على مراقبة سرية أو خفية)",
 "spymaster": "رئيس الجواسيس, مدير المخابرات (شخص يدير أنشطة استخباراتية سرية)",
 "spyware": "بَرَامِج تَجَسُّس",
 "sq ft": "قدم مربع (وحدة مساحة تساوي مربعًا طول ضلعه قدم واحدة)",
 "sq in": "بوصة مربعة (وحدة مساحة تساوي مربعًا طول ضلعه بوصة واحدة)",
 "sq yd": "ياردة مربعة (وحدة مساحة تساوي مربعًا طول ضلعه ياردة واحدة)",
 "sql": "إِس كْيُو إِل, إسْ كْيُو إلْ",
 "squab": "زُغْلُول, جَوْزَل",
 "squabble": "شِجَار / شَاجَرَ",
 "squabbler": "مُشَاكِس, مُنَازِع (شخص يتشاجر حول أمور تافهة)",
 "squabby": "قَصِيرٌ وَبَدِين, مُكَتَّل (قَصِيرُ القَامَةِ وَسَمِين)",
 "squad": "فِرْقَة, جَمَاعَة",
 "squad car": "دورية شرطة, سيارة شرطة (سيارة يجوب فيها رجال الشرطة الشوارع؛ مجهزة باتصالات لاسلكية بالمقر الرئيسي)",
 "squad room": "غرفة الفرقة (غرفة في ثكنة حيث يتم تسكين الجنود) / غرفة التجمع (غرفة في مركز شرطة حيث يجتمع أفراد القوة لنداء الأسماء وتوزيع المهام)",
 "squadron": "سرب طيران ((سَرِبَ) المَاء سَرَباً: سَالَ فَهُوَ سَرِب)\nمثال: سرب الطيور ذلك جميل جدا.",
 "squalid": "بَائِس, مُزْرٍ (قذر ومتهالك ومنفّر) / رَذِيلٌ, قَذِرٌ (منحط أخلاقياً)",
 "squalidly": "بخسة, بقذارة (بطريقة دنيئة أو قذرة)",
 "squalidness": "دناءة, قذارة (قذارة دنيئة)",
 "squall": "عاصفة مفاجئة, هبة عاصفة (رياح عنيفة مفاجئة؛ غالباً ما تكون مصحوبة بهطول)",
 "squall line": "خط عاصف (جبهة باردة يُحتمل على طولها حدوث عواصف أو عواصف رعدية)",
 "squalling": "عَاصِف, هَوْجَائِيّ (يتّسم بفترات قصيرة من الضجيج والاضطراب)",
 "squally": "ذُو زَوَابِع, عَاصِف مُتَقَطِّع (يَتَّسِم بِفَتَرَاتٍ قَصِيرَة مِنَ الرِّيَاح العَنِيفَة أَوِ المَطَر) / عَاصِف, هَوْجَائِيّ (يتّسم بفترات قصيرة من الضجيج والاضطراب)",
 "squalor": "دناءة, قذارة (قذارة دنيئة)",
 "squalus acanthias": "كلب البحر الشائك الأطلسي (كلب بحر مدمر يعيش في المياه الساحلية الأطلسية لأمريكا وأوروبا؛ يستخدم على نطاق واسع في دروس التشريح)",
 "squalus suckleyi": "كلب البحر الشائك الهادئ (كلب بحر يعيش في ساحل المحيط الهادئ لأمريكا الشمالية)",
 "squama": "حَرْشَفَة (هيكل وقائي يشبه الحرشفة)",
 "squamation": "تحرشف، حرشفة",
 "squamous": "مُحَرْشَف, حَرْشَفِيّ",
 "squamous cell": "خلية حرشفية (خلية طلائية مسطحة مثل الصفيحة وتشكل طبقة واحدة من النسيج الطلائي)",
 "squamous cell carcinoma": "سرطانة حرشفية الخلايا (أكثر أشكال سرطان الجلد شيوعًا)",
 "squamule": "حراشف صغيرة (حرشفة دقيقة)",
 "squamulose": "حُرْشُفِيّ (مغطّى بحراشف صغيرة جدًّا)",
 "squandered": "مُبَدَّد, مُهْدَر (لَمْ يُسْتَغَلّ بِشَكْل جَيِّد)",
 "squanderer": "مبذر, مسرف (مستهلك مسرف بتهور)",
 "squandering": "تبذير (إنفاق الموارد ببذخ وإسراف)\nمثال: أكثر تبذيراً من إضاعة الوقت",
 "squandermania": "هوس التبذير (تبذير هائل (عادة من قبل حكومة))",
 "square": "مُرَبَّع (كُلُّ ما يُرَبَّعُ؛ كُلُّ ما له أربعة أركانٍٍ) / مثال: لا توجد مثلثات مربعة.",
 "square and rabbet": "حلقة العمود (إطار زخرفي على شكل حلقة؛ في قمة العمود)",
 "square block": "مكعب (كتلة على شكل (تقريبي) مكعب)",
 "square bracket": "قوس مربع (إحدى علامتي الترقيم  المستخدمة لتطويق مادة نصية)",
 "square capitals": "الخط الروماني المربع, حروف كبيرة مربعة (شكل روماني قديم للكتابة، وهو الأساس للأحرف الكبيرة الحديثة)\nمثال: استُخدمت الحروف الكبيرة المربعة لكتابة النقوش، وبشكل أقل لتكملة خط اليد اليومي",
 "square centimeter": "سنتيمتر مربع (وحدة قياس للمساحة تعادل 1 سنتيمتر طولاً مضروبًا في 1 سنتيمتر عرضًا)",
 "square centimetre": "سنتيمتر مربع (وحدة قياس للمساحة تعادل 1 سنتيمتر طولاً مضروبًا في 1 سنتيمتر عرضًا)",
 "square dance": "رقص المربعات, سكوير دانس (رقص ريفي أمريكي يشكل فيه الأزواج مربعات)",
 "square dancer": "راقص المربع (شخص يمارس رقصة المربع)",
 "square dancing": "رقص المربعات, سكوير دانس (رقص ريفي أمريكي يشكل فيه الأزواج مربعات)",
 "square deal": "معاملة عادلة (معاملة منصفة)",
 "square fathom": "قامة مربعة (وحدة قياس للمساحة تعادل قامة واحدة طولاً مضروبة في قامة واحدة عرضًا؛ القامة تساوي 6 أقدام)",
 "square flipper": "فقمة ملتحية (فقمة متوسطة الحجم رمادية إلى صفراء ذات شعيرات على جانبي الخطم؛ تعيش في المحيط المتجمد الشمالي)",
 "square flipper seal": "فقمة ملتحية (فقمة متوسطة الحجم رمادية إلى صفراء ذات شعيرات على جانبي الخطم؛ تعيش في المحيط المتجمد الشمالي)",
 "square foot": "قدم مربع (وحدة مساحة تساوي مربعًا طول ضلعه قدم واحدة)",
 "square inch": "بوصة مربعة (وحدة مساحة تساوي مربعًا طول ضلعه بوصة واحدة)",
 "square kilometer": "كيلومتر مربع (مضاعف عشري لوحدة مساحة السطح، المتر المربع، ويساوي 1,000,000 متر مربع)\nمثال: كانت المساحة التي تحيط بها أسوار العديد من المدن الأوروبية في العصور الوسطى حوالي كيلومتر مربع واحد",
 "square kilometre": "كيلومتر مربع (مضاعف عشري لوحدة مساحة السطح، المتر المربع، ويساوي 1,000,000 متر مربع)\nمثال: كانت المساحة التي تحيط بها أسوار العديد من المدن الأوروبية في العصور الوسطى حوالي كيلومتر مربع واحد",
 "square knot": "عقدة مربعة (عقدة مزدوجة مصنوعة من عقدتين نصفيتين وتستخدم لربط نهايات حبلين)",
 "square matrix": "مَصْفُوفَة مُرَبَّعَة",
 "square meal": "وجبة دسمة, وجبة مشبعة (وجبة كبيرة ومغذية)\nمثال: نادراً ما كان يحصل على ثلاث وجبات مشبعة في اليوم",
 "square measure": "مقياس مربع, وحدة مساحة (نظام من الوحدات يُستخدم لقياس المساحات)",
 "square meter": "متر مربع (وحدة قياس للمساحة، تُعرف بمساحة مربع أضلاعه متر واحد بالضبط)",
 "square metre": "مِتْرٌ مُرَبَّعٌ (فِي : مُسْتَعْمَلٌ لِتَحْدِيدِ طُولِ مُخْتَلِفِ الأَشْيَاءِ، قَدْرُهُ ذِرَاعٌ وَنِصْفٌ تَقْرِيباً…؛ فِي : هوَ النَادل أو موَظف خدْمة الزَّبائن في المطْعم، يقَال أيْضاً \"مِيتْر\")\nمثال: أنا أقل بقليل من 150 سنتي متر.",
 "square mile": "ميل مربع (مساحة تبلغ 640 فدانًا (إيكر))",
 "square millimeter": "مليمتر مربع (وحدة قياس للمساحة تعادل 1 مليمتر طولاً مضروبًا في 1 مليمتر عرضًا)",
 "square millimetre": "مليمتر مربع (وحدة قياس للمساحة تعادل 1 مليمتر طولاً مضروبًا في 1 مليمتر عرضًا)",
 "square nut": "صامولة مربعة (صامولة ذات شكل مربع)",
 "square one": "المربع الأول, نقطة الصفر (الموقف الذي تبدأ فيه مسعى وتعود إليه إذا فشلت جهودك)\nمثال: الشرطة عادت الآن إلى نقطة الصفر بعد اعتقال وإطلاق سراح 27 رجلاً",
 "square pyramid": "هرم مربع (شكل هندسي ثلاثي الأبعاد بقاعدة مربعة وأربعة جوانب مثلثة تتصل في نقطة واحدة)\nمثال: الهرم الأكبر في الجيزة هو مثال على الهرم المربع",
 "square root": "جَذْر تَرْبِيعِيّ (جِذْرُ ٱلشَّيْءِ هُوَ: أَصْلُهُ؛ في : جذر العدد النوني هو عدد ما إذا رفعناه لقوة ما أعطانا العدد الأصلي)\nمثال: أحسب جذر خمسة بالآلة الحاسبة.",
 "square sail": "شراع مربع (شراع رباعي الأضلاع يوضع تحت عارضة أفقية معلقة من المنتصف في الصارية)",
 "square shooter": "شخص مستقيم, نزيه (شخص صريح وصادق)",
 "square the circle": "رَبَّعَ الدائِرة (وقف وانتظر وتحبّس؛ الرجلُ: رفع الحجر بيده امتحانا لقوتّه)\nمثال: الساعة السادسة و الربع مساء.",
 "square toes": "تقليدي, محافظ (شخص رسمي ومحافظ ذو آراء قديمة الطراز)",
 "square yard": "ياردة مربعة (وحدة مساحة تساوي مربعًا طول ضلعه ياردة واحدة)",
 "square-bashing": "تدريب الساحة (التدريب في ساحة الثكنات)",
 "square-built": "مُرَبَّعُ البِنْيَة (عريض وصلب البنية)",
 "square-dance music": "موسيقى الرقص المربع (موسيقى تؤدى للرقص المربع)",
 "square-jawed": "مُرَبَّعُ الفَكِّ (لَهُ فَكٌّ مُرَبَّعُ الشَّكْلِ نِسْبِيًّا)",
 "square-rigged": "ذُو أَشْرِعَة مُرَبَّعَة (مُجَهَّز بِأَشْرِعَة مُرَبَّعَة كَأَشْرِعَة رَئِيسِيَّة)",
 "square-rigger": "سفينة مربعة الأشرعة (سفينة شراعية مجهزة بأشرعة مربعة)",
 "square-shaped": "مُرَبَّعُ الشَّكْلِ (على هيئة المربّع)",
 "square-shouldered": "عَرِيضُ المَنْكِبَيْن (ذو أكتاف عريضة)",
 "square-tailed": "مُرَبَّع الذَّيْل (ذو ذيل مربّع الشكل)",
 "square-toed": "مُرَبَّعُ المُقَدِّمَة (ذُو مُقَدِّمَةٍ مُرَبَّعَةٍ (فِي الحِذَاءِ)) / مُتَحَفِّظ بِإِفْرَاط, مُتَزَمِّت (مبالِغ في التمسّك باللياقة والتحفّظ)",
 "squared": "مُرَبَّع (جُعِل على شكل مربّع)",
 "squared-toe": "مُرَبَّعُ المُقَدِّمَة (ذُو مُقَدِّمَةٍ مُرَبَّعَةٍ (فِي الحِذَاءِ))",
 "squareflipper": "فقمة ملتحية (فقمة متوسطة الحجم رمادية إلى صفراء ذات شعيرات على جانبي الخطم؛ تعيش في المحيط المتجمد الشمالي)",
 "squarely": "بشكل مباشر, بصراحة (بحزم وقناعة؛ بدون مساومة) / بشكل كامل, مباشرة (بشكل ثابت ومتين) / بشكل مربع (بشكل مربع) / بشكل مباشر, بصراحة (مباشرة وبدون مراوغة؛ ليس بشكل ملتوٍ)\nمثال: وقف بصلابة من أجل الحرية الدينية والتسامح",
 "squareness": "تربيع (خاصية التشكل على هيئة مربع)",
 "squaretail": "مربعة الذيل (سمكة بطيئة الحركة مربعة الذيل مدرعة بحراشف عظمية صلبة؛ تعيش في المياه الدافئة العميقة)",
 "squarish": "شِبْهُ مُرَبَّع (مربّع إلى حدٍّ ما في المظهر أو الشكل)",
 "squash": "اسكواش (لعبة تُلعب في ملعب مغلق من قبل لاعبين أو أربعة يضربون الكرة بمضارب طويلة المقبض) / قرع, كوسا (الفاكهة الصالحة للأكل لنبات القرع؛ تؤكل كخضار) / قرع, كوسا (ضرب بشدة على شيء يَصْدُرُ منه صوت قوي؛ في سياق مجازي: أوقع الضربة أو وقع الصوت المفاجئ أو الحاد)\nمثال: توقف ذلك القرع.",
 "squash ball": "كرة الاسكواش (كرة مطاطية تستخدم في لعب الاسكواش)",
 "squash bug": "بق القرع (بق أمريكي أسود كبير يمتص عصارة كروم فصيلة القرعيات)",
 "squash court": "ملعب اسكواش (الملعب الداخلي الذي تُلعب فيه الاسكواش)",
 "squash pie": "فطيرة القرع (مشابهة لفطيرة اليقطين ولكن مصنوعة من القرع الشتوي بدلاً من اليقطين)",
 "squash racket": "مضرب الاسكواش (مضرب صغير بمقبض طويل يستخدم للعب الاسكواش)",
 "squash rackets": "اسكواش (لعبة تُلعب في ملعب مغلق من قبل لاعبين أو أربعة يضربون الكرة بمضارب طويلة المقبض)",
 "squash racquet": "مضرب الاسكواش (مضرب صغير بمقبض طويل يستخدم للعب الاسكواش)",
 "squash racquets": "اسكواش (لعبة تُلعب في ملعب مغلق من قبل لاعبين أو أربعة يضربون الكرة بمضارب طويلة المقبض)",
 "squash vine": "قرع, كوسا (ضرب بشدة على شيء يَصْدُرُ منه صوت قوي؛ في سياق مجازي: أوقع الضربة أو وقع الصوت المفاجئ أو الحاد)\nمثال: توقف ذلك القرع.",
 "squashed": "مسحوق, مهروس (الذي تم ضغطه بعنف)\nمثال: العري المهروس للطيور الصغيرة",
 "squashy": "إسْفَنْجِيّ, طَرِيّ مَطَّاطِيّ (ذو قِوام إسْفَنْجِيّ؛ لَيِّن ومَليء بالمَسامّ) / مُسْتَنْقَعِيّ, وَحِل ((عن التربة) ليّنة ومشبَعة بالماء) / طَرِيّ, لُبِّيّ (يُشْبِهُ اللُّبَّ أَوِ الثَّمَرَ المُفْرِطَ النُّضْجِ؛ لَا يَتَّسِمُ بِالصَّلَابَةِ)",
 "squat": "صَغِير وَثَخِين / قُرْفُصَاء / جَثَمَ (وجَثَم فُلَانٌ بالأَرضَ يَجْثُم جُثومًا: لصِق بِهَا ولَزِمها؛ قَالَ النَّابِغَةُ يصِف رَكَبَ امرأَةٍ)",
 "squatina squatina": "قرش ملاك (أسماك قرش ذات أجسام عريضة مسطحة وزعانف صدرية تشبه الأجنحة ولكنها تسبح بطريقة أسماك القرش)",
 "squatness": "اكتناز, قصر وغلظ (خاصية كون الشيء قصيراً وعريضاً)",
 "squatter": "محتل للمكان, واضع اليد (شخص يستقر في أرض أو مسكن دون حق أو سند قانوني) / مستوطن, واضع اليد (شخص يستقر بشكل قانوني على أرض حكومية بقصد الحصول على حق ملكيتها)",
 "squattiness": "اكتناز, قصر وغلظ (بنية قصيرة وممتلئة)",
 "squatting": "قرفصاء (فعل اتخاذ أو الحفاظ على وضعية الانحناء مع ثني الركبتين والأرداف بالقرب من الكعبين) / القرفصاء, سكوات (تمرين عن طريق اتخاذ وضعية الانحناء مع ثني الركبتين بشكل متكرر؛ يقوي عضلات الساق)",
 "squatty": "قَصِير مُمْتَلِئ, مُكَتَّل (قصير وسمين؛ ذو ساقين قصيرتين وعضلات ثقيلة)",
 "squaw": "سكوا (مصطلح ازدرائي لامرأة هندية أمريكية)",
 "squaw corn": "ذرة الدقيق, ذرة ناعمة (ذرة تتكون حبوبها بالكامل تقريباً من النشا الناعم)",
 "squaw grass": "عشبة الدب, عشبة الزيروفيليوم (نبات من غرب أمريكا الشمالية له جذمورات خشبية وخصل من الأوراق القاعدية الصلبة التي تشبه العشب وسنابل من الزهور البيضاء الكريمية)",
 "squaw huckleberry": "توت الغزلان (توت أزرق متفرع صغير شائع في المناطق المستنقعية بشرق الولايات المتحدة له توت مخضر أو مصفر غير مستساغ يقال إن الغزلان تأكله)",
 "squaw man": "رجل متزوج من هندية (مصطلح ازدرائي لرجل أبيض متزوج من امرأة من الهنود الحمر في أمريكا الشمالية)",
 "squaw root": "جذر التوت الأزرق, كوهوش أزرق (عشبة طويلة من شرق أمريكا الشمالية وآسيا لها ثمار تشبه التوت الأزرق وجذمور سميك وعقدي كان يستخدم طبياً سابقاً)",
 "squaw-bush": "سماق الظربان, سماق ثلاثي الفصوص (شجيرة متساقطة الأوراق في كاليفورنيا ذات أوراق كريهة الرائحة عادة ما تكون ثلاثية الوريقات وثمار صالحة للأكل)",
 "squawbush": "سماق الظربان, سماق ثلاثي الفصوص (شجيرة متساقطة الأوراق في كاليفورنيا ذات أوراق كريهة الرائحة عادة ما تكون ثلاثية الوريقات وثمار صالحة للأكل)",
 "squawk": "صَخَب / صَخِبَ",
 "squawk box": "مكبر صوت الاتصال الداخلي (مكبر الصوت في نظام الاتصال الداخلي أو نظام الإذاعة العامة)",
 "squawker": "مكبر صوت الاتصال الداخلي (مكبر الصوت في نظام الاتصال الداخلي أو نظام الإذاعة العامة) / بكاء, كثير الشكوى (شخص يميل إلى الشكوى المفرطة والبكاء والأنين)",
 "squawky": "قَهْقَاهِيّ, نَقْنَاقِيّ (يُشْبِه قَهْقَهَة الدَّجَاجَة خَاصَّةً بَعْد وَضْع البَيْض)",
 "squawroot": "جذر التوت الأزرق, كوهوش أزرق (عشبة طويلة من شرق أمريكا الشمالية وآسيا لها ثمار تشبه التوت الأزرق وجذمور سميك وعقدي كان يستخدم طبياً سابقاً)",
 "squeak": "صَرِير / صَرَّ ((صَرَّ) يَصْرِرِ صَريرًا: صوَّتَ. يقال: (صَرَّ) العصفورُ والجُندُبُ، و(صَرَّ) القلم، و(صَرَّ) البابُ؛ (صَرَّتِ) الأُذنُ: كان لها طنين)\nمثال: لدى مايوكو حاسة بصر حادة.",
 "squeaker": "فوز بشق الأنفس, نجاة بأعجوبة (شيء تم تحقيقه (أو الهروب منه) بفارق ضئيل) / أداة مُصدرة للصرير, لعبة بزمارة (أي أداة أو جسم يُصدر صوت صرير عند استخدامه)\nمثال: تلك الأحذية الرياضية تُصدر صريراً",
 "squeakiness": "حدة الصوت, صرير (حالة الميل لإصدار صوت عالي الطبقة أو صرير)\nمثال: الصرير الأنفي السابق والأصوات المتحشرجة للطبقات العليا تظهر الآن فقط عندما يتحمس",
 "squeaking": "صَاخِب, صَرَّار (يُصدر صوتاً عالي النبرة كصوت الفأر أو المفصلة الصدئة)",
 "squeaky": "صَاخِب, صَرَّار (يُصدر صوتاً عالي النبرة كصوت الفأر أو المفصلة الصدئة)",
 "squeal": "زعيق, صراخ (عواء عالي النبرة)",
 "squealer": "خنزير (خنزير مستأنس) / مخبر, واشٍ (من يكشف معلومات سرية للشرطة أو سلطة أخرى)",
 "squealing": "صَاخِب, صَرَّار (يُصدر صوتاً عالي النبرة كصوت الفأر أو المفصلة الصدئة)",
 "squeamish": "مُتَقَزِّز, مُتَنَطِّع (مُفْرِط فِي التَّدْقِيق وَسَرِيع الاشْمِئْزَاز)",
 "squeamishly": "بتقزز, بحساسية مفرطة (بطريقة سريعة التأثر والاشمئزاز)\nمثال: قال بتقزز: 'أفضل ألا ألمس'",
 "squeamishness": "تقزز, حساسية مفرطة (سمة الحساسية المفرطة وسرعة الصدمة) / انزعاج معدي, غثيان خفيف (حالة خفيفة من الغثيان)\nمثال: تم سحب البرنامج بسبب تقزز بعض المشاهدين",
 "squeegee": "مَسَّاحَة",
 "squeezability": "إسفنجية, قابلية الانضغاط (خاصية القدرة على شغل حيز أقل)",
 "squeezable": "قابِل لِلانْضِغاط, مَرِن (يُمكِن ضَغْطُه أو عَصْرُه)",
 "squeeze": "عَصَرَ (مصدر للفعل \"عَصَرَ\"؛ أي مدة زمنية، دهر من الوقت)\nمثال: صلى زيري العصر.",
 "squeeze box": "أكورديون (آلة ذات قصبات حرة محمولة على شكل صندوق؛ يتم جعل القصبات تهتز بواسطة الهواء من المنفاخ الذي يتحكم فيه العازف)",
 "squeeze play": "لعبة ضغط (لعبة بيسبول يحاول فيها عداء على القاعدة الثالثة التسجيل بينما يقوم الضارب بضرب الكرة برفق) / لعبة ضغط, مناورة قوة (محاولة عدوانية لإجبار الإذعان عن طريق تركيز القوة أو التلاعب بها)\nمثال: ضحكت من مناورة القوة الجنسية هذه وابتعدت",
 "squeezer": "عصّارة (أداة مطبخ لعصر العصير من الفاكهة)",
 "squeezing": "اعتصار, عصر (فعل الإمساك والضغط بقوة)\nمثال: عصر خدها بمرح",
 "squelch": "دائرة الإسكات (دائرة كهربائية تقطع جهاز الاستقبال عندما تصبح الإشارة أضعف من الضوضاء) / إِفْحَام, تَقْلِيل مِن الشَّأْن (ملاحظة ساحقة ومحبطة)",
 "squelch circuit": "دائرة الإسكات (دائرة كهربائية تقطع جهاز الاستقبال عندما تصبح الإشارة أضعف من الضوضاء)",
 "squelched": "مَقْمُوع, مُخْمَد (أُخضع أو قُهر)",
 "squelcher": "دائرة الإسكات (دائرة كهربائية تقطع جهاز الاستقبال عندما تصبح الإشارة أضعف من الضوضاء) / إِفْحَام, تَقْلِيل مِن الشَّأْن (ملاحظة ساحقة ومحبطة)",
 "squib": "مفرقعة أنبوبية (لعبة نارية تتكون من أنبوب مملوء بالبارود (مثل مفرقعة مكسورة) تحترق بصوت أزيز)",
 "squid": "حَبَّار",
 "squiffy": "ثَمِل تَمَامًا, سَكْرَان طَافِح (فِي حَالَة سُكْرٍ شَدِيد)",
 "squiggle": "خربشة (خربشة غير مقروءة) / خربشة, خط متعرج (خط قصير ملتوٍ)\nمثال: توقيعه كان مجرد خربشة ولكن هو فقط من يستطيع عمل تلك الخربشة",
 "squiggly": "مُتَعَرِّج, مُتَمَوِّج (متموج وملتوٍ بشكل غير منتظم)",
 "squill": "إشقيل, عنصل (نبات من العالم القديم من جنس الإشقيل ذو أوراق قاعدية ضيقة وأزهار عنقودية وردية أو زرقاء أو بيضاء) / بصل البحر, عنصل بحري (ذو سنابل كثيفة من الزهور البيضاء الصغيرة وينتج بصلة ذات خصائص طبية) / بصل العنصل (بصلة بصل البحر، التي تقطع وتجفف وتستخدم كمقشع)",
 "squilla": "روبيان السرعوف (نوع من روبيان السرعوف)",
 "squinch": "حنية ركنية (قوس صغير مبني عبر الزاوية الداخلية لجدارين (عادة لدعم برج))",
 "squinched": "أَحْوَل, مُحَوِّل (ذو عينين نصف مغلقتين من أجل الرؤية بشكل أفضل)",
 "squint": "بِطَرْف العَيْن, مُنْحَرِف النَّظْرَة ((خَاصَّةً عَنِ النَّظَرَات) مُوَجَّه إِلَى جَانِبٍ بِشَكٍّ أَوِ ارْتِيَاب) / تحديق بعينين مغلقتين جزئياً, حول (فعل النظر بعينين مغلقتين جزئياً) / حول (محاذاة غير طبيعية لإحدى العينين أو كلتيهما)",
 "squint-eye": "أحول (شخص مصاب بالحول)",
 "squint-eyed": "بِطَرْف العَيْن, مُنْحَرِف النَّظْرَة ((خَاصَّةً عَنِ النَّظَرَات) مُوَجَّه إِلَى جَانِبٍ بِشَكٍّ أَوِ ارْتِيَاب) / أحول (مصاب بالحول)",
 "squinter": "أحول (شخص مصاب بالحول)",
 "squinting": "أَحْوَل, مُحَوِّل (ذو عينين نصف مغلقتين من أجل الرؤية بشكل أفضل)",
 "squinty": "بِطَرْف العَيْن, مُنْحَرِف النَّظْرَة ((خَاصَّةً عَنِ النَّظَرَات) مُوَجَّه إِلَى جَانِبٍ بِشَكٍّ أَوِ ارْتِيَاب) / ضيق العينين, مزرور العينين (يتميز بتضييق العينين (تحديق))\nمثال: نظر بعينين مزرورتين",
 "squire": "أقطاعي, إسكواير (مالك أرض ريفي إنجليزي) / مرافق الفارس (نبيل شاب مرافق لفارس) / مرافق السيدات (رجل يرافق امرأة)",
 "squirearchy": "أعيان الريف, ملاك الأراضي (الأعيان الذين يمتلكون الأراضي (يُعتبرون كطبقة))",
 "squirm": "تلوّي, تململ (عملية التلوّي أو التململ)",
 "squirmer": "كَثِير الْحَرَكَة, مُتَمَلْمِل (شخص لا يستطيع البقاء ساكناً (خاصة الطفل))\nمثال: كان الطفل الصغير كثير الحركة حقاً في رحلات الطائرة",
 "squirrel": "سِنْجَاب",
 "squirrel cage": "عجلة السنجاب, قفص السنجاب (قفص به إطار أسطواني يدور عندما يركض حيوان صغير داخله)",
 "squirrel corn": "ديسنترا كندية, ذرة السنجاب (نبات أمريكي ذو أزهار قشدية اللون وجذور درنية تشبه حبات الذرة)",
 "squirrel monkey": "سعدان السنجاب (قرد صغير طويل الذيل يعيش في أمريكا الوسطى والجنوبية، ذو فراء مخضر وخطم أسود)",
 "squirrel's-foot fern": "سرخس الكرة, سرخس قدم السنجاب (سرخس ريشي في آسيا الاستوائية وماليزيا)",
 "squirrel-cage motor": "محرك قفص السنجاب (محرك كهربائي ذو دوار قفص السنجاب)",
 "squirrel-sized": "بِحَجْمِ السِّنْجَابِ (بحجم سنجاب تقريبًا)",
 "squirrelfish": "سمك السنجاب (أسماك ليلية صغيرة جداً وزاهية الألوان (خاصة الأحمر) تعيش في المياه الضحلة أو الشعاب المرجانية الاستوائية؛ تصدر أصواتاً تشبه نباح السنجاب) / سمكة الدبوس (تشبه الدنيس؛ سمكة صغيرة شائكة الزعانف توجد في الخلجان على طول الساحل الجنوبي الشرقي للولايات المتحدة)",
 "squirreltail barley": "شعير ذيل السنجاب (شعير يزرع لرؤوس زهوره الزخرفية للغاية ذات السفا الحريري الطويل الرقيق؛ أمريكا الشمالية وشمال شرق آسيا)",
 "squirreltail grass": "شعير ذيل السنجاب (شعير يزرع لرؤوس زهوره الزخرفية للغاية ذات السفا الحريري الطويل الرقيق؛ أمريكا الشمالية وشمال شرق آسيا)",
 "squirt": "بَخَّ, بَجَّسَ (معناه عظم الأمر وفخُم تقال عند الرضى والإعجاب بالشيء أو عند الفخر أو المدح)\nمثال: توم التقط بطل الشامبو و بخ القليل في يده",
 "squirt gun": "رشاش ماء, مسدس مائي (لعبة تتكون من مسدس لعبة يرش الماء)",
 "squirter": "رشاش ماء, مسدس مائي (لعبة تتكون من مسدس لعبة يرش الماء)",
 "squirting": "مُتَطَاير, مُنْدَفِع (يُدفَع بقوَّة في مجرى ضيِّق عادةً)",
 "squirting cucumber": "قِثَّاء الْحِمَار, فَقُّوس الْحِمَار",
 "squish": "صوت المشي في الطين (ضجيج المشي على الطين الناعم)",
 "squishy": "إسْفَنْجِيّ, طَرِيّ مَطَّاطِيّ (ذو قِوام إسْفَنْجِيّ؛ لَيِّن ومَليء بالمَسامّ)",
 "sr": "زاوية مجسمة, ستيراديان (وحدة الزاوية المجسمة المعتمدة في النظام الدولي للوحدات) / سترونتيوم (عنصر فلزي ناعم فضي-أبيض أو مصفر من مجموعة الفلزات القلوية الترابية؛ يتحول لونه للأصفر في الهواء)",
 "sr.": "الأَبّ, الأَكْبَر (يُستخدم للأكبر سنًّا من شخصين يحملان الاسم ذاته؛ خاصة لتمييز الأب عن ابنه)",
 "sravana": "شرافانا (الشهر الخامس من التقويم الهندوسي)",
 "sri lanka": "سِرِيلَانْكَا, سَرَنْدِيب (دولة تقع في جنوب آسيا)",
 "sri lanka rupee": "روبية, روبية سريلانكية (وحدة المال الأساسية في سريلانكا؛ تساوي 100 سنت)",
 "sri lankan": "سريلانكي, سيلاني (من أو متعلق بسريلانكا (سيلان سابقاً) أو شعبها أو ثقافتها) / سريلانكي (مواطن أو ساكن في سريلانكا)\nمثال: شواطئ سريلانكية",
 "sri lankan monetary unit": "وحدة نقدية سريلانكية (الوحدة النقدية في سريلانكا)",
 "srinagar": "سْرِينَاجَار",
 "sriracha": "سريراتشا (صلصة مصنوعة من الثوم المهروس والفلفل الحار سميت تيمناً بمدينة سي راشا في تايلاند)",
 "ss": "القوات الخاصة, شوتزشتافل (قوة شرطة خاصة في ألمانيا النازية تأسست كحرس شخصي لأدولف هتلر عام 1925؛ أدارت القوات الخاصة معسكرات الاعتقال) / الخدمة السرية الأمريكية (وكالة الاستخبارات الأمريكية التي تحمي الرؤساء ونواب الرئيس الحاليين والسابقين وعائلاتهم المباشرة وتحمي الزوار الأجانب المتميزين؛ تكشف وتقبض على مزوري…)",
 "ssa": "إدارة الضمان الاجتماعي (وكالة حكومية مستقلة مسؤولة عن نظام الضمان الاجتماعي)",
 "sse": "الجَنُوب الجَنُوبِيّ الشَّرْقِيّ, جَنُوب جَنُوب شَرْق (نقطة البوصلة في منتصف المسافة بين الجنوب والجنوب الشرقي)",
 "ssmg": "منحة الأمومة (ميزة تُدفع لمرة واحدة لكل طفل متوقع أو مولود أو متبنى)",
 "sspe": "التهاب الدماغ المصلب تحت الحاد (التهاب دماغ مزمن نادر ومترقٍ يسببه فيروس الحصبة ويحدث بشكل أساسي عند الأطفال والشباب؛ تحدث الوفاة عادة في غضون ثلاث سنوات)",
 "ssri": "مثبط استرداد السيروتونين الانتقائي (دواء مضاد للاكتئاب يعمل عن طريق منع استرداد السيروتونين بحيث يتوفر المزيد من السيروتونين للعمل على المستقبلات في الدماغ)",
 "sss": "نظام الخدمة الانتقائية (وكالة فيدرالية مستقلة تدير الخدمة العسكرية الإجبارية)",
 "ssw": "الجَنُوب الجَنُوبِيّ الغَرْبِيّ, جَنُوب جَنُوب غَرْب (نقطة البوصلة في منتصف المسافة بين الجنوب والجنوب الغربي)",
 "st andrews's cross": "صليب القديس أندرو (نبات شجيري له زهور صفراء إلى مشمشية بأربع بتلات مرتبة على شكل صليب؛ جنوب شرق الولايات المتحدة: نيويورك إلى تكساس)",
 "st bernard": "سانت برنارد (سلالة ألبية سويسرية من الكلاب القوية الكبيرة ذات معطف سميك من الشعر تستخدم ككلب إنقاذ)",
 "st george's channel": "قَنَاة سْاَنْت جُورْج",
 "st john's day": "24 يونيو, يوم منتصف الصيف (يوم ربع سنوي في إنجلترا وويلز وأيرلندا)",
 "st john's eve": "23 يونيو, ليلة منتصف الصيف (الليلة التي تسبق يوم منتصف الصيف)",
 "st john's night": "23 يونيو, ليلة منتصف الصيف (الليلة التي تسبق يوم منتصف الصيف)",
 "st john's wort": "عشبة القديس يوحنا, هيوفاريقون (أي من العديد من نباتات جنس هيبريكوم ذات زهور صفراء وأوراق منقطة بشفافية؛ تُجمع تقليدياً في عشية القديس يوحنا لدرء الشر)",
 "st joseph": "19 مارس, عيد القديس يوسف (يوم مقدس مسيحي، هو يوم عيد القديس يوسف، زوج السيدة العذراء مريم)",
 "st martin's day": "11 نوفمبر, عيد القديس مارتن (عيد القديس مارتن؛ يوم ربع سنوي في اسكتلندا)",
 "st patrick's day": "17 مارس, يوم القديس باتريك (يوم يحتفل به الأيرلنديون لإحياء ذكرى القديس الشفيع لأيرلندا)",
 "st peter's wort": "عشبة القديس بطرس (عشبة القديس يوحنا المعمرة الأوروبية؛ من أيرلندا وفرنسا إلى غرب سيبيريا)",
 "st valentine's day": "عيد الحب, فالنتاين (يوم لتبادل رموز المودة والحب)",
 "st. andrew's cross": "صليب القديس أندرو, صليب مائل",
 "st. anthony's cross": "صليب القديس أنطوني, صليب تاو (صليب يشبه الحرف اليوناني تاو)",
 "st. augustine grass": "عشب القديس أوغسطين (عشب منخفض يشكل حصيرة من جنوب الولايات المتحدة وأمريكا الاستوائية؛ يُزرع كعشب للمروج)",
 "st. barbara's herb": "رشاد الشتاء, عشبة القديسة بربارة (أي نبات من جنس برباريا: نباتات رشاد أوراسية صفراء الزهور؛ تزرع على نطاق واسع كسلطة شتوية)",
 "st. cyril": "القديس كيرلس, كيرلس (مبشر يوناني؛ يُنسب إليه اختراع الأبجدية السيريلية (826-869))",
 "st. dabeoc's heath": "خلنج كونيمارا (شجيرة دائمة الخضرة منخفضة من غرب أوروبا ممثلة بعدة أصناف بزهور من الأبيض إلى الوردي الأرجواني)",
 "st. elmo's fire": "شَرَر القِدِّيس إِلْمُو",
 "st. george's": "سانت جورجز",
 "st. john's": "سانت جونز",
 "st. john's wort": "حَشِيشَة الْقَلْب, دَاذِيّ",
 "st. joseph": "أسبرين, حمض الأسيتيل ساليسيليك (مشتق مؤستل لحمض الساليسيليك؛ يستخدم كدواء مسكن ومضاد للالتهابات (الأسماء التجارية باير وغيرها) يؤخذ عادة على شكل أقراص؛ يستخدم كخافض للحرارة ويبطئ…)",
 "st. peter's wreath": "إكليل العروس (شجيرة لها زهور بيضاء صغيرة غزيرة في الربيع)",
 "st. petersburg": "سانت بيترسبرغ",
 "st. polycarp": "القِدِّيس بُولِيكارْبُوس (أسقف سميرنا اليوناني الذي رفض التراجع عن إيمانه المسيحي وحُرق حتى الموت (حوالي 69-155))",
 "st. vitus dance": "رقص سيدنهام, رقصة القديس فيتوس (رقص يحدث بشكل رئيسي عند الأطفال ويرتبط بالحمى الروماتيزمية)",
 "st. vitus' dance": "دَاء الرَقْص",
 "st.-bruno's-lily": "براديسيا, زنبق القديس برونو",
 "stab": "طَعْن / طَعْنَة / طَعَنَ",
 "stabber": "طاعن (شخص يطعن شخصاً آخر)",
 "stabbing": "طَاعِن, لَاذِع (مؤلم كما لو كان ناتجاً عن أداة حادّة) / جارِح, طاعِن (يُسَبِّب جِراحًا أو ألَمًا حادًّا)",
 "stabile": "رَاسِخ, غَيْرُ قَابِلٍ لِلتَّحْرِيك (لَا يُمْكِنُ تَحْرِيكُهُ أَوْ لَا يُقْصَدُ بِهِ أَنْ يُنْقَل) / مُقَاوِمٌ لِلتَّغَيُّر ((في الكيمياء والفيزياء والأحياء) مقاوم للتغيّر والتحوّل) / منحوتة ثابتة (نحت له وحدات ثابتة (مصنوعة عادة من الصفائح المعدنية) ومثبتة بدعامة ثابتة)",
 "stabilisation": "استقرار, تثبيت (فعل جعل الشيء مستقراً أو أكثر استقراراً) / تثبيت, موازنة (فعل جعل شيء ما (كسفينة أو طائرة) أقل عرضة للانقلاب)",
 "stabilised": "مُثَبَّت (جُعِل مستقرًّا وثابتًا)",
 "stabiliser": "مثبت, موازن (جهاز لجعل شيء ما مستقراً)",
 "stabilising": "مُثَبِّت, مُسْتَقِرّ (يُؤَدِّي إلى الاسْتِقْرار والثَّبات)",
 "stabilitron": "ثنائي زينر, ديود زينر (صمام ثنائي شبه موصل يظهر زيادة حادة في التيار العكسي عند جهد عكسي محدد جيداً: يستخدم كمنظم للجهد)",
 "stability": "اِسْتِقْرَار",
 "stabilization": "استقرار, تثبيت (فعل جعل الشيء مستقراً أو أكثر استقراراً) / تثبيت, موازنة (فعل جعل شيء ما (كسفينة أو طائرة) أقل عرضة للانقلاب)",
 "stabilization pond": "بركة أكسدة (برك كبيرة وضحلة مصممة لمعالجة مياه الصرف الصحي من خلال تفاعل ضوء الشمس والبكتيريا والطحالب)",
 "stabilized": "مُثَبَّت (جُعِل مستقرًّا وثابتًا)",
 "stabilizer": "مثبت, موازن (جهاز لجعل شيء ما مستقراً) / مثبت (سطح انسيابي يتكون من جهاز لتثبيت الطائرة) / مادة مثبتة, مثبت (مادة كيميائية تضاف إلى محلول أو خليط أو معلق للحفاظ عليه في حالة مستقرة أو غير متغيرة)",
 "stabilizer bar": "قضيب توازن (قضيب معدني صلب بين أنظمة التعليق الأمامية وبين أنظمة التعليق الخلفية للسيارات والشاحنات؛ يعمل على تثبيت الهيكل)",
 "stabilizing": "مُثَبِّت, مُسْتَقِرّ (يُؤَدِّي إلى الاسْتِقْرار والثَّبات)",
 "stable": "حَظِيرَة, اِسْطَبْل / زَرِيبَة / ثَابِت (اسم فاعل من ثَبَتَ؛ المُسْتَقِرّ الذي لا يتحرك، ضد المُتَحَرِّك)\nمثال: الشاحنة غير ثابتة.",
 "stable attribution": "عزو مستقر (عزو لا يتغير بمرور الوقت أو عبر المواقف)",
 "stable companion": "رفيق الإسطبل (حصان يتم إيواؤه مع آخر أو واحد من عدة خيول يملكها نفس الشخص)",
 "stable factor": "بروكونفيرتين (عامل تخثر يتكون في الكلى تحت تأثير فيتامين ك)",
 "stable gear": "سروج, عدة الخيل (تجهيزات للحصان)",
 "stableboy": "سايس, عامل إسطبل (رجل يعمل في إسطبل لرعاية الخيول)",
 "stablegirl": "سايسة, عاملة إسطبل (امرأة تعمل في إسطبل لرعاية الخيول)",
 "stableman": "سايس, عامل إسطبل (رجل يعمل في إسطبل لرعاية الخيول)",
 "stablemate": "رفيق الإسطبل (حصان يتم إيواؤه مع آخر أو واحد من عدة خيول يملكها نفس الشخص)",
 "stableness": "اسْتِقْرَار, ثَبَات (الصفة أو الخاصية المتمثلة في كون الشيء حازماً وثابتاً)",
 "stablewoman": "سايسة, عاملة إسطبل (امرأة تعمل في إسطبل لرعاية الخيول)",
 "stabling": "إسطبل (إقامة للحيوانات (خاصة للخيول))",
 "stably": "بثبات, بشكل مستقر (بطريقة مستقرة غير متغيرة) / بتوازن, برسوخ (بطريقة ثابتة وراسخة)\nمثال: كان معدل الوفيات في روسيا مرتفعاً بشكل مستقر",
 "staccato": "بشكل متقطع, ستاكاتو (فصل النغمات؛ في الموسيقى) / ستاكاتو, متقطع ((موسيقى) يتميز بـ أو يتألف من أجزاء أو أصوات غير متصلة؛ مقطوعة بحدة)\nمثال: اعزف هذا بشكل متقطع من فضلك",
 "stachyose": "ستاكيوز (سكر رباعي يوجد في درنات الخرشوف الصيني)",
 "stachys palustris": "بطونية المستنقعات, ستاكس (عشب معمر بجذمور عديم الرائحة واسع الانتشار في الأماكن الرطبة في نصف الكرة الشمالي)",
 "stachys sylvatica": "بطونية الأحراش, ستاكس حرجية (عشب أوراسي معمر كريه الرائحة بجذمور زاحف أخضر)",
 "stack": "كَوْمَة / كُومَة",
 "stacked": "ذَات قَوَام مُنْحَنٍ, مُمْتَلِئَة ((عن جسد المرأة) ذات صدر كبير وانحناءات جذّابة) / مكدس (مرتب في كومة)",
 "stacked heel": "كعب متعدد الطبقات (كعب مصنوع من طبقات عديدة من الجلد)",
 "stacker": "مرصّص, مكوّم (عامل يبني كومة أو رصة)",
 "stacker crane": "رافعة تكديس, رافعة رص (رافعة ذات آلية تشبه الرافعة الشوكية تستخدم في المستودعات الآلية (التي يتحكم فيها الحاسوب))\nمثال: غالباً ما تستخدم رافعات التكديس في مستودعات التجميد الكبيرة لمصنعي الأغذية المجمدة",
 "stacks": "أرفف المكتبة, مخزن الكتب (مساحة تخزين في مكتبة تتكون من ترتيب واسع لأرفف الكتب حيث يتم تخزين معظم الكتب) / أطنان, أكوام (عدد أو كمية كبيرة)\nمثال: كون الكثير من الصداقات الجديدة",
 "stacte": "ميعة ((العهد القديم) أحد التوابل العطرية المتعددة المستخدمة في البخور)",
 "stactometer": "مقياس التقطير, مقياس التوتر السطحي بالتقطير (جهاز لفحص التوتر السطحي باستخدام طريقة قياس القطرات)\nمثال: يتم تضييق جزء من قاع مقياس التقطير للسماح للسائل بالسقوط من الأنبوب على شكل قطرة",
 "staddle": "قاعدة التكديس (قاعدة أو منصة يتم تكديس التبن أو الذرة عليها)",
 "stadium": "مَلْعَب, إِسْتَاد (موضع اللَعِب عامة؛ موضع يلعب فيه الصغار، يوضع لهم فيه العاب)\nمثال: .يمشون في الملعب",
 "stadium jumping": "قفز الحواجز (ركوب الخيل في مسابقات عبر مسارات محددة لإظهار المهارة في القفز فوق العقبات)",
 "staff": "طَاقَم, طَاقِم",
 "staff line": "خط المدرج الموسيقي (أي من الخطوط الأفقية الخمسة التي تشكل المدرج الموسيقي)",
 "staff member": "عضو هيئة, موظف (موظف يكون عضواً في هيئة عاملين (خاصة عضو في الطاقم الذي يعمل لرئيس الولايات المتحدة))",
 "staff of life": "خبز (طعام مصنوع من عجين الدقيق أو الطحين وعادة ما يخمّر بالخميرة أو مسحوق الخبز ثم يخبز)",
 "staff office": "إدارة الموارد البشرية, قسم شؤون الموظفين (القسم المسؤول عن تعيين وتدريب وتوزيع الموظفين ووضع سياسات إدارة الأفراد)",
 "staff officer": "ضابط أركان (ضابط مفوض معين في طاقم القائد العسكري)",
 "staff sergeant": "رقيب أركان (ضابط صف رتبته أعلى من عريف وأقل من رقيب أول في الجيش أو المارينز)",
 "staff tree": "سيلاستروس, شجرة العصا (أي شجرة صغيرة أو شجيرة متسلقة من جنس سيلاستروس)",
 "staff vine": "حلوة مرة أمريكية, سيلاستروس (شجيرة ملتفة في أمريكا الشمالية لها كبسولات صفراء تحيط ببذور قرمزية)",
 "staffer": "عضو هيئة, موظف (موظف يكون عضواً في هيئة عاملين (خاصة عضو في الطاقم الذي يعمل لرئيس الولايات المتحدة))",
 "staffordshire bull terrier": "ستافوردشاير بول تيريير (سلالة إنجليزية من الكلاب القوية الممتلئة ذات جمجمة عريضة وفراء ناعم)",
 "staffordshire bullterrier": "ستافوردشاير بول تيريير (سلالة إنجليزية من الكلاب القوية الممتلئة ذات جمجمة عريضة وفراء ناعم)",
 "staffordshire terrier": "ستافوردشاير تيريير أمريكي (سلالة أمريكية من التيريير العضلي ذو فراء قصير صلب ملتصق بالجسم)",
 "stag": "أَيَّل",
 "stag beetle": "حُنْظُب / خُنْفُسَاء الْأَيِّل",
 "stag party": "حفلة عزاب, سهرة رجالية (حفلة للرجال فقط (أو تعتبر مناسبة للرجال فقط))",
 "stag's garlic": "ثوم الكرمة, ثوم بري (بصل بري لاذع من العالم القديم)",
 "stag's-horn coral": "مرجان قرن الأيل (مرجان متفرع كبير يشبه قرون الأيل)",
 "stage": "مَرْحَلَة / مُنَصَّة, مَسْرَح",
 "stage business": "حركة مسرحية (نشاط عرضي يؤديه الممثل للتأثير الدرامي)\nمثال: كانت حركته بالعصا مضحكة",
 "stage crew": "طاقم المسرح (طاقم من العمال الذين ينقلون المشاهد أو يتعاملون مع الممتلكات في إنتاج مسرحي)",
 "stage dancing": "تصميم الرقصات, رقص مسرحي (عرض يتضمن رقصاً فنياً)",
 "stage direction": "إِرْشَاد مَسْرَحِيّ, تَوْجِيه مَسْرَحِيّ (تعليمات مكتوبة كجزء من نص المسرحية)",
 "stage director": "مخرج مسرحي (شخص يشرف على الممثلين ويوجه الحركة في إنتاج عرض مسرحي)",
 "stage door": "باب المسرح, مدخل الكواليس (مدخل إلى منطقة الكواليس في المسرح؛ يستخدمه الفنانون وموظفو المسرح الآخرون)",
 "stage effect": "مؤثر مسرحي (تأثير خاص يتم إنشاؤه على المسرح)",
 "stage fright": "رَهَاب المَسْرَح",
 "stage left": "يسار المسرح (جزء المسرح الواقع على يسار الممثل عندما يواجه الجمهور)",
 "stage manager": "مدير المسرح (شخص يشرف على الجوانب المادية في إنتاج عرض ما ويكون مسؤولاً عن المسرح أثناء أداء العرض)",
 "stage monitor": "سماعة المراقبة, سماعة المسرح (إحدى السماعات الموجودة على المسرح والموجهة نحو المؤدين لمساعدتهم على سماع أنفسهم)",
 "stage name": "اسم فني (الاسم المستعار لممثل)",
 "stage right": "يمين المسرح (جزء المسرح الواقع على يمين الممثل عندما يواجه الجمهور)",
 "stage set": "ديكور المسرح, موقع التصوير (تمثيل يتكون من المناظر الطبيعية والخصائص الأخرى المستخدمة لتحديد موقع إنتاج درامي)\nمثال: كانت الديكورات أصلية بدقة",
 "stage setting": "إعداد المسرح, ديكور المسرح (ترتيب المناظر والممتلكات لتمثيل المكان الذي تُمثل فيه مسرحية أو فيلم)",
 "stage technician": "عامل مسرح (موظف في المسرح يؤدي الأعمال المتعلقة بإقامة عرض مسرحي)",
 "stage whisper": "همس مسرحي (همس عالٍ يمكن سماعه؛ على المسرح يسمعه الجمهور ولكن يفترض أن يكون غير مسموع لبقية الممثلين)",
 "stage-struck": "مَفْتُون بِالمَسْرَح (مولع بالمسرح أو مأسور به وخاصة الرغبة في التمثيل)",
 "stagecoach": "ستيج كوتش, عربة البريد والركاب (عربة كبيرة تجرها أربعة خيول كانت تستخدم سابقاً لنقل الركاب والبريد على طرق منتظمة بين المدن)\nمثال: خرجنا من المدينة معاً في عربة البريد لحوالي عشرة أو اثني عشر ميلاً",
 "stagecraft": "فن المسرح, مهارة مسرحية (المهارة في كتابة أو إخراج المسرحيات)",
 "staged": "مُرَتَّب, مُعَدّ لِلتَّأْثِير (مرتب عمدًا لإحداث تأثير معين) / مسرحي, ممسرح (مكتوب لـ أو يُؤدى على المسرح)\nمثال: نسخة مسرحية من الرواية",
 "stagehand": "عامل مسرح (موظف في المسرح يؤدي الأعمال المتعلقة بإقامة عرض مسرحي)",
 "stager": "مدير المسرح (شخص يشرف على الجوانب المادية في إنتاج عرض ما ويكون مسؤولاً عن المسرح أثناء أداء العرض) / محارب قديم, مخضرم (شخص ذو خبرة مر بالعديد من المعارك؛ أو شخص قدم خدمة طويلة)",
 "stagey": "مَسْرَحِيّ, مُصْطَنَع (يَحْمِل سِمَات المَسْرَح خَاصَّةً التَّكَلُّف وَالِافْتِعَال)",
 "stagflation": "رُكُود تَضَخُّمِي",
 "stagflationary": "ركودي تضخمي (مميز لـ أو معزز للركود التضخمي)",
 "stagger": "تَرَنُّح / تَرَنَّحَ",
 "stagger bush": "شجيرة الترنح (شجيرة نفضية في السهل الساحلي لشرق الولايات المتحدة ذات أزهار بيضاء وردية متدلية؛ سامة للماشية)",
 "stagger head": "عنوان متدرج (عنوان رئيسي يكون سطره العلوي محاذياً لليسار والأسطور التالية مزاحة لليمين)",
 "staggerbush": "شجيرة الترنح (شجيرة نفضية في السهل الساحلي لشرق الولايات المتحدة ذات أزهار بيضاء وردية متدلية؛ سامة للماشية)",
 "staggered board of directors": "مجلس إدارة متدرج (مجلس إدارة يتم انتخاب جزء من أعضائه كل عام بدلاً من انتخاب جميع الأعضاء سنويًا)",
 "staggered head": "عنوان متدرج (عنوان رئيسي يكون سطره العلوي محاذياً لليسار والأسطور التالية مزاحة لليمين)",
 "staggerer": "مترنح (شخص يمشي بشكل غير مستقر وكأنه على وشك السقوط)",
 "staggering": "مُدْهِش, مُذْهِل (مُثير للإعجاب بشكل مُفاجئ لدرجة الذهول أو الإرباك)",
 "staggeringly": "بشدة, بشكل هائل (بدرجة كبيرة جداً)\nمثال: كان محبوباً بشكل هائل",
 "staggers": "ترنح, دوار (مرض في الجهاز العصبي المركزي يؤثر خاصة على الخيول والماشية؛ يتميز بمشية غير مستقرة وسقوط متكرر)",
 "staghead": "مكنسة الساحرة (نمو غير طبيعي كثيف (متكتل) للأغصان الصغيرة على شجرة أو شجيرة ناتج عن فطريات أو حشرات أو اضطرابات فسيولوجية أخرى)",
 "staghorn coral": "مرجان قرن الأيل (مرجان متفرع كبير يشبه قرون الأيل)",
 "staghorn fern": "سرخس قرن الغزال (أي من السراخس الاستوائية المتنوعة من جنس بلاتيسيريوم لها سعف مفصص مسطح كبير يشبه غالباً قرون الغزال)",
 "staghorn moss": "أرز أرضي, طحلب قرن الأيل (صنف من طحلب النادي، بأسماء شائعة مثل جيني الزاحفة أو الصنوبر الجاري الشمالي)",
 "staghorn sumac": "سماق قرن الوعل, سماق مخملي (شجرة شجيرية متساقطة الأوراق في شرق أمريكا الشمالية بأوراق مركبة تتحول إلى اللون الأحمر اللامع في الخريف وعناقيد كثيفة من الزهور الصفراء المخضرة تليها…)",
 "staghound": "كلب صيد الأيائل (كلب صيد كبير وثقيل كان يستخدم سابقاً في صيد الأيائل والطرائد الكبيرة الأخرى؛ يشبه كلب صيد الثعالب ولكنه أكبر منه)",
 "stagily": "بأسلوب مسرحي, بتصنع مسرحي (بطريقة مسرحية متكلفة)\nمثال: أعلن بأسلوب مسرحي: 'لا أستطيع أن أظهر وجهي في منزلها'",
 "staginess": "افْتِعَال, مَسْرَحِيَّة (صفة مصطنعة ومتكلفة)",
 "staging": "فصل المراحل (التخلص من مرحلة من مراحل صاروخ متعدد المراحل) / سفر بالعربات (السفر بواسطة عربة الخيول) / سقالات (نظام من السقالات) / إنتاج مسرحي, عمل مسرحي (إنتاج دراما على المسرح)",
 "staging area": "منطقة تجميع, منطقة حشد (منطقة يتم فيها تجميع القوات والمعدات العابرة قبل عملية عسكرية)",
 "stagnancy": "جمود, ركود (حالة من الخمول (في الأعمال التجارية أو الفن وما إلى ذلك)) / أسن, ركود (خمول السوائل؛ كونها راكدة؛ واقفة بلا حراك؛ بدون تيار أو دوران)\nمثال: النمو الاقتصادي الأقل من 1% سنوياً يعتبر ركوداً اقتصادياً",
 "stagnant": "رَاكِد, مُحْتَضِر (لا ينمو ولا يتغيّر؛ بلا قوّة أو حيوية) / آسِن, رَاكِد (لا يدور ولا يتدفَّق)",
 "stagnant anoxia": "انعدام الأكسجين الاقفاري, انعدام الأكسجين الركودي (انعدام الأكسجين الناتج عن بطء الدورة الدموية المحيطية (مثل ما يتبع فشل القلب الاحتقاني))",
 "stagnant hypoxia": "نقص الأكسجة الاقفاري, نقص الأكسجة الركودي (نقص الأكسجة الناتج عن بطء الدورة الدموية المحيطية (مثل ما يتبع فشل القلب الاحتقاني))",
 "stagnation": "رُكُود / ركود اقتصادي",
 "stagy": "مَسْرَحِيّ, مُصْطَنَع (يَحْمِل سِمَات المَسْرَح خَاصَّةً التَّكَلُّف وَالِافْتِعَال)",
 "staid": "رَزِين, رَصِين (يتميز بالوقار والاحتشام)",
 "staidly": "برزانة, بوقار (بطريقة جادة ورصينة)\nمثال: مشى بوقار نحو المذبح",
 "staidness": "رزانة, مهابة (سمة الجدية الوقورة)",
 "stain": "بُقْعَة",
 "stainability": "قابلية الانصباغ ((علم الخلايا) قدرة الخلايا أو أجزاء الخلية على التلون بأصباغ معينة بشكل محدد)",
 "stainable": "قابل للتلوين, قابل للصبغ (قادر على أن يصبغ (خاصة الخلايا وأجزاء الخلية))",
 "stained": "مُبَقَّع, مُلَطَّخ (موسوم أو مصبوغ أو متغير اللون بمادة غريبة) / مَصْبُوغ, مُلَمَّع (مُغَطًّى بِطَبَقَةٍ مِنَ الصَّبْغِ أَوِ الوَرْنِيش)\nمثال: مفرش طاولة ملطخ بشدة",
 "stained glass": "زُجَاج مُعَشَّق",
 "stained-glass window": "نافذة زجاج معشق (نافذة مصنوعة من الزجاج الملون)",
 "stainer": "صبّاغ (عامل يصبغ (الخشب أو القماش))",
 "staining": "تصبيغ, تلوين مجهري ((علم الأنسجة) استخدام صبغة لتلوين العينات للدراسة المجهرية) / تبقيع, تلطيخ (فعل تبقيع أو تلطيخ شيء ما)",
 "stainless": "بِلَا شَائِبَة, نَقِيّ ((للسمعة) خالٍ من الشوائب والعيوب) / ستانلس ستيل, فولاذ مقاوم للصدأ (فولاذ يحتوي على الكروم مما يجعله مقاوماً للتآكل)",
 "stainless steel": "فُولَاذ مُقَاوِم لِلصَّدَأ",
 "stair": "سَلَالِم",
 "stair-carpet": "سجاد الدرج (شريط من السجاد يفرش على الدرج)",
 "stair-rod": "قضيب الدرج (قضيب يثبت سجادة الدرج في الزاوية بين درجتين)",
 "staircase": "بَيْتُ الدَّرَج, دَرَج (بمعنى قضى الليل؛ الخَيْمَة من الشَعْر يَبِيت فيها البَدَوي أو المُسافر. الجمع بُيُوت)\nمثال: لنعد إلى البيت.",
 "stairhead": "رأس الدرج (منصة في قمة الدرج)",
 "stairs": "سَلَالِم",
 "stairway": "درج, سلم (وسيلة وصول (صعوداً وهبوطاً) تتكون من مجموعة من الدرجات)",
 "stairwell": "عَمُود السُّلَّم",
 "stake": "وَتِد, خَازُوق (العصا تثبت في الأرض لتثبيت شيء ما بربطه إليها) / مِحْرَقَة / حِصَّة / رِهَان",
 "stake driver": "واق أمريكي (نوع من الواق، أصغر قليلاً من الواق الأوروبي)",
 "stake race": "سباق الجوائز, سباق الرهان (سباق خيل يتم فيه دفع جزء من الجائزة من قبل أصحاب الخيول المشاركة في السباق)",
 "stakeholder": "وكيل الضمان (1.وَكيل: ( اسم )؛ وكيل ( اسم ))",
 "stakeout": "كمين مراقبة (مراقبة مكان أو شخص ما من قبل الشرطة (كما في توقع جريمة))",
 "stakes": "رهان, مراهنة (المال المخاطر به في مقامرة)",
 "stalactite": "نوازل الكهوف, هابطة (أسطوانة من كربونات الكالسيوم تتدلى من سقف كهف جيري)",
 "stalagmite": "صاعدة, صواعد الكهوف (أسطوانة من كربونات الكالسيوم تبرز لأعلى من أرضية كهف جيري)",
 "stalagmometer": "مقياس التقطير, مقياس التوتر السطحي بالتقطير (جهاز لفحص التوتر السطحي باستخدام طريقة قياس القطرات)\nمثال: يتم تضييق جزء من قاع مقياس التقطير للسماح للسائل بالسقوط من الأنبوب على شكل قطرة",
 "stale": "بائت, فاسد (يفتقر إلى النضارة أو الطعم المستساغ، أو يظهر عليه التدهور بسبب القدم) / بَالٍ, قَدِيم (يفتقر للأصالة أو العفوية؛ لم يعد جديداً)\nمثال: خبز بائت",
 "stalemate": "رَدْب / طَرِيق مَسْدُود, مَأْزِق (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من ٱلشَّارِعِ، سَبِيل)\nمثال: أسأل عن الطريق.",
 "stalemated": "فِي طَرِيق مَسْدُود, مُتَعَادِل (في حالة جمود تامّ بسبب تعارض قوّتين أو فريقين لا يتزحزحان)",
 "staleness": "بيات, عفونة (فقدان النقاء والطزاجة نتيجة للتقادم) / ابتذال (عدم الأصالة نتيجة كون الشيء مملاً ومكرراً)",
 "stalin": "سْتَالِين",
 "stalinisation": "تحول للستالينية, ستلنة (العملية الاجتماعية لتبني (أو الإجبار على تبني) سياسات وممارسات جوزيف ستالين)\nمثال: رفض العديد من المجريين المشاركة في ستلنة بلادهم",
 "stalinism": "سْتَالِينِيَّة",
 "stalinist": "سْتَالِينِيّ",
 "stalinization": "تحول للستالينية, ستلنة (العملية الاجتماعية لتبني (أو الإجبار على تبني) سياسات وممارسات جوزيف ستالين)\nمثال: رفض العديد من المجريين المشاركة في ستلنة بلادهم",
 "stalk": "سَاق",
 "stalked": "ذُو سُوَيْقَة, مُعَنَّق (لديه أو ينمو على أو من سويقة أو ساق)\nمثال: زهرة معنقة",
 "stalked puffball": "فطر نفاث ذو ساق (نوع من بوداكساسيا) / فطر نفاث ذو ساق (فطر من جنس تولوستوما يشبه الفطر النفاث)",
 "stalker": "مُطَارِد",
 "stalking": "تسلل وراء الفريسة (فعل تتبع الفريسة خلسة) / تتبع, مطاردة خلسة (صيد الطرائد عن طريق تتبعها خلسة أو الانتظار في كمين)",
 "stalking-horse": "حصان التمويه (حصان يختبئ خلفه الصياد أثناء مطاردة الطرائد) / حصان التسلل, ذريعة (ستار يتكون من مجسم حصان يختبئ خلفه الصياد أثناء تعقب الطرائد) / حجة, ذريعة (شيء يعمل على إخفاء الخطط؛ سبب وهمي يتم اختلاقه لإخفاء السبب الحقيقي) / مرشح تمويه, مرشح واجهة (مرشح يُطرح لتقسيم المعارضة أو لإخفاء المرشح الحقيقي)",
 "stalkless": "جَالِس, عَدِيم السُّوَيْقَة (متصل مباشرة بالقاعدة؛ ليس له ساق وسيطة)\nمثال: زهور لاطئة",
 "stall": "مَعْلِف, مُرَاح / بَسْطة",
 "stall bar": "سلم حائطي, عقلة حائطية (جهاز جمباز يستخدم لتمارين التقوية؛ عبارة عن قوائم مثبتة على الحائط ومتصلة ببعضها بواسطة درجات أفقية)",
 "stall-fed": "مُسَمَّن فِي الحَظِيرَة, مُعَلَّف ((للماشية) يُحتجَز ويُطعَم في الحظيرة بغرض التسمين للسوق)",
 "stalling": "تعطيل, مماطلة (تكتيك يستخدم للتضليل أو التأخير)",
 "stallion": "جَوَاد (السَخِيّ والسَخِيَّة؛ الحِصَان)",
 "stalls": "إسطبل (مبنى مزرعة لإيواء الخيول أو غيرها من الماشية)",
 "stalogometer": "مقياس التقطير, مقياس التوتر السطحي بالتقطير (جهاز لفحص التوتر السطحي باستخدام طريقة قياس القطرات)\nمثال: يتم تضييق جزء من قاع مقياس التقطير للسماح للسائل بالسقوط من الأنبوب على شكل قطرة",
 "stalwart": "ثَابِت الجَأْش, رَابِط الجَأْش (يُوصَف بِهِ الأَشْخَاص بِشَكْلٍ خَاصّ؛ قَوِيّ العَزِيمَة) / صَلْبٌ, وَفِيٌّ (يُعتمد عليه ولا يتراجع) / صُلْب, قَوِيُّ البُنْيَة (ذو قوة بدنية متينة؛ متمرّس على التعب والمشقّة) / موالي, نصير (شخص مخلص لولائه (خاصة في أوقات الثورة))",
 "stalwartness": "بأس, صلابة (خاصية كون الشخص قوياً وحازماً)",
 "stamen": "سَدَاة",
 "stamina": "تَحَمُّل, قُوَّةُ تَحَمُّل",
 "staminate": "سَدَائِيّ, مُذَكَّر (قادر على تلقيح الأعضاء الأنثوية)",
 "stammel": "ستاميل (قماش صوفي خشن كان يستخدم سابقاً للملابس الداخلية وعادة ما يكون مصبوغاً باللون الأحمر الفاتح)",
 "stammer": "تَلَجْلَجَ, تَلَعْثَمَ",
 "stammerer": "متلعثم (شخص يتحدث بوقفات وتكرارات لا إرادية)",
 "stamp": "خَتْم (أنهى الشيءَ وأتمّه؛ طبع بخاتم أو ختم رسميّ) / طَابَع\nمثال: ختم سامي القرآن في شهر رمضان.",
 "stamp act": "قانون الدمغة (قانون أقره البرلمان البريطاني عام 1756 لزيادة الإيرادات من المستعمرات الأمريكية عن طريق ضريبة على شكل طابع)",
 "stamp album": "ألبوم طوابع (ألبوم للطوابع)",
 "stamp battery": "بطارية تكسير (سلسلة من المطارق تعمل في هاون واحد لسحق الخامات)",
 "stamp collecting": "جمع الطوابع, فيلاتلي (جمع ودراسة الطوابع البريدية)",
 "stamp collection": "جمع الطوابع, فيلاتلي (جمع ودراسة الطوابع البريدية) / مجموعة طوابع (مجموعة من الطوابع)",
 "stamp collector": "جامع طوابع, هاوي طوابع (جامع ودارس للطوابع البريدية)",
 "stamp dealer": "تاجر طوابع (تاجر في الطوابع (عملائه هم هواة جمع الطوابع))",
 "stamp duty": "رسوم الطوابع, ضريبة الدمغة (ضريبة تُحصل عن طريق اشتراط شراء طابع ولصقه (عادة على المستندات أو المنشورات))",
 "stamp mill": "طاحونة تكسير, طاحونة ركاز (طاحونة يتم فيها سحق الخام بالمطارق)",
 "stamp pad": "محبرة ختم, وسادة حبر (كتلة من مادة ماصة مشبعة بالحبر؛ تستخدم لنقل الحبر بالتساوي إلى ختم مطاطي)",
 "stamp tax": "رسوم الطوابع, ضريبة الدمغة (ضريبة تُحصل عن طريق اشتراط شراء طابع ولصقه (عادة على المستندات أو المنشورات))",
 "stampede": "تَدَافُع, هَرْج (تزاحمَ وتدافعَ الأشخاصُ في مكانٍ واحدٍ؛ يدافع بمعنى الحماية والدفاع)\nمثال: لا تدافع عن القتلة!",
 "stamper": "آلة ختم, خاتمة (أداة آلية تقوم بالختم) / داهس, ضارب بقدمه (شخص يمشي بمشية ثقيلة صاخبة أو يضرب بقدمه على الأرض) / دمّاغ, عامل كبس (عامل وظيفته التشكيل أو القص عن طريق تطبيق قالب أو ختم (إما يدوياً أو بتشغيل آلة الختم))\nمثال: خاتمة معدنية",
 "stamping ground": "مرتع, مزار (مكان يتردد عليه المرء كثيراً)",
 "stamping machine": "آلة ختم, خاتمة (أداة آلية تقوم بالختم)\nمثال: خاتمة معدنية",
 "stamping mill": "طاحونة تكسير, طاحونة ركاز (طاحونة يتم فيها سحق الخام بالمطارق)",
 "stance": "مَوْقِف",
 "stanchion": "عَمُود ، دِعَامَة ، قائِمُ دَعمٍ فُولاذيّ",
 "stanchly": "باستماتة, بثبات (بطريقة مخلصة وثابتة)\nمثال: دافع باستماتة عن مبادئه",
 "stand": "وَقَفَ, وقف (قَامَ، اِنْتَصَبَ، نَهَضَ؛ ثَبَتَ)\nمثال: وقف وراء الباب.",
 "stand for": "إِسْتَنَدَ / سَانَدَ",
 "stand mixer": "خلاط ثابت (خلاط يتم فيه تثبيت المحرك الذي يقود الحركة الدوارة في إطار أو حامل يتحمل وزن الجهاز)\nمثال: يتضمن الخلاط الثابت المنزلي النموذجي مخفقة سلكية لخفق الكريمات وبياض البيض؛ ومضرب مسطح لخلط العجين السائل؛ وخطاف عجين للعجن",
 "stand oil": "زيت الحامل (زيت سميك يتكون من زيوت بذر الكتان أو التونغ أو الصويا التي تم تسخينها إلى أكثر من 300 درجة مئوية)",
 "stand up": "قَامَ (اِنْتَصَبَ، نَهَضَ، وَقَفَ؛ ثَبَتَ، وَقَفَ، حَبَسَ)\nمثال: لقد قام بواجبه.",
 "stand-alone": "قَائِمٌ بِذَاتِه, مُسْتَقِلّ (قادر على العمل بشكل مستقلّ دون الاعتماد على غيره)",
 "stand-down": "تعليق العمليات, هدنة ((عسكرية) توقف مؤقت للعمل العسكري الهجومي) / استرخاء, تخفيف التأهب (تعليق واسترخاء من حالة تأهب أو حالة استعداد)",
 "stand-in": "احْتِياطِيّ, بَدِيل (شخص يأخذ مكان آخر (كما هو الحال عندما تصبح الأمور خطيرة أو صعبة))\nمثال: كان لدى النجم بديل للمشاهد الخطرة",
 "stand-up": "يَتَطَلَّب الوُقُوف (يستلزم وضعيَّة الوقوف)",
 "standard": "مِعْيَارِيّ / مُسْتَوَى, مِعْيَار / لِوَاء (على غير قياس؛ الرَايَة تُلوَى على العَلَم لتدلّ على شيء)",
 "standard anatomical position": "الوضع التشريحي القياسي (موضع جسم الإنسان، واقفاً منتصباً، والوجه متجه للأمام، والأطراف العلوية على الجانبين وراحتا اليد متجهتان للأمام (مستلقية)، والقدمان متجهتان للأمام؛…)\nمثال: لغرض المقارنة العالمية، هناك وضع قياسي - الوضع التشريحي - يفترض نظرياً أن المريض أو الجثة قد اتخذه",
 "standard atmosphere": "ضغط جوي, ضغط جوي قياسي (وحدة ضغط: الضغط الذي يدعم عمودًا من الزئبق بارتفاع 760 مم عند مستوى سطح البحر ودرجة صفر مئوية)",
 "standard bengali": "اَلْبَنْغَالِيَة اَلْفُصْحَى",
 "standard candle": "شمعة, شمعة معيارية (الوحدة الأساسية لشدة الإضاءة المعتمدة في النظام الدولي للوحدات؛ تساوي 1/60 من شدة الإضاءة لكل سنتيمتر مربع لجسم أسود يشع عند درجة حرارة 2046 كلفن)",
 "standard cell": "خلية قياسية (خلية أولية تستخدم كمعيار للقوة الدافعة الكهربائية)",
 "standard deviation": "انحراف معياري",
 "standard gauge": "سكة قياسية, قياس قياسي للسكة (سكة حديدية يبلغ عرضها القياسي 56.5 بوصة)",
 "standard generalized markup language": "لغة الترميز القياسية العامة ((علوم الحاسوب) لغة موحدة للترميز الوصفي للمستندات؛ مجموعة من القواعد لاستخدام أي مفردات ترميز معتمدة)",
 "standard language": "معيرة لغة",
 "standard of life": "مستوى المعيشة (مستوى الراحة المادية من حيث السلع والخدمات المتاحة لشخص أو مجموعة ما)\nمثال: تمتعوا بأعلى مستوى معيشي في البلاد",
 "standard of living": "مُسْتَوَى اَلْمَعِيشَة",
 "standard of measurement": "عيار, مقياس معياري (نموذج أو مثال مقبول أو معتمد لكمية أو جودة يتم الحكم على الآخرين أو قياسهم أو مقارنتهم مقابلها)",
 "standard operating procedure": "إجراء تشغيلي قياسي, إجراء قياسي (إجراء مقرر يجب اتباعه بشكل روتيني)\nمثال: الحفظ عن ظهر قلب كان الإجراء التشغيلي القياسي للمعلمين لقرون",
 "standard poodle": "بودل قياسي (سلالة من البودل متوسط الحجم)",
 "standard pressure": "ضغط جوي, ضغط جوي قياسي (وحدة ضغط: الضغط الذي يدعم عمودًا من الزئبق بارتفاع 760 مم عند مستوى سطح البحر ودرجة صفر مئوية)",
 "standard procedure": "إجراء تشغيلي قياسي, إجراء قياسي (إجراء مقرر يجب اتباعه بشكل روتيني)\nمثال: الحفظ عن ظهر قلب كان الإجراء التشغيلي القياسي للمعلمين لقرون",
 "standard schnauzer": "شناوزر قياسي (شناوزر متوسط الحجم)",
 "standard temperature": "درجة الحرارة القياسية (صفر درجة مئوية بالضبط)",
 "standard time": "توقيت محلي, توقيت مدني (الوقت الرسمي في منطقة محلية (معدل حسب الموقع حول الأرض)؛ يحدد بالقانون أو العرف)",
 "standard transmission": "ناقل حركة يدوي (ناقل حركة يتم تشغيله يدوياً برافعة تروس ودواسة قابض)",
 "standard-bearer": "حامل الراية, حامل العلم (الجندي الذي يحمل راية الوحدة في العروض العسكرية أو في المعركة) / حامل اللواء (قائد بارز لحركة سياسية)",
 "standardisation": "توحيد المعايير, معايرة (فعل فحص أو تعديل دقة أداة قياس (بالمقارنة مع معيار)) / تطبيع, تقييس (فرض المعايير أو اللوائح) / تقييس, توحيد قياسي (الحالة التي يتم فيها إنشاء معيار بنجاح)\nمثال: احتاج مقياس الحرارة إلى معايرة",
 "standardised": "قَابِلٌ لِلتَّبَادُلِ, مُعَيَّرٌ (يمكن أن يحل محل شيء آخر أو يتبادل معه دون فقدان الوظيفة) / مُقَيَّس, مُوَحَّد (أُخضِع للتوافق مع معيار موحد)",
 "standardiser": "موحد المعايير (شخص يضع معياراً للأشياء لتتوافق معه)",
 "standardization": "توحيد المعايير, معايرة (فعل فحص أو تعديل دقة أداة قياس (بالمقارنة مع معيار)) / تطبيع, تقييس (فرض المعايير أو اللوائح) / تقييس, توحيد قياسي (الحالة التي يتم فيها إنشاء معيار بنجاح)\nمثال: احتاج مقياس الحرارة إلى معايرة",
 "standardized": "قَابِلٌ لِلتَّبَادُلِ, مُعَيَّرٌ (يمكن أن يحل محل شيء آخر أو يتبادل معه دون فقدان الوظيفة) / مُقَيَّس, مُوَحَّد (أُخضِع للتوافق مع معيار موحد)",
 "standardizer": "موحد المعايير (شخص يضع معياراً للأشياء لتتوافق معه)",
 "standby": "اِحْتِيَاطِيّ, لِلطَّوَارِئ (جاهز للاستخدام في حالات الطوارئ) / احتياطي, بديل جاهز (شيء يمكن الاعتماد عليه واللجوء إليه عند الحاجة) / ممثل بديل (ممثل قادر على استبدال المؤدي الأساسي عند الضرورة)",
 "standdown": "تعليق العمليات, هدنة ((عسكرية) توقف مؤقت للعمل العسكري الهجومي) / استرخاء, تخفيف التأهب (تعليق واسترخاء من حالة تأهب أو حالة استعداد)",
 "standee": "ستاندي, مجسم كرتوني (مجسم مفرغ من الورق المقوى بالحجم الطبيعي (عادة لأحد المشاهير)) / واقف (شخص يقف في مكان قد يجلس فيه المرء (كمتفرج يستخدم مساحة الوقوف في مسرح أو راكب في حافلة أو قطار مزدحم))\nمثال: التقط صورته مع مجسم كرتوني للرئيس",
 "stander": "واقف (كائن (شخص أو حيوان) يقف)\nمثال: حشد من الجالسين والواقفين",
 "standing": "مَنْزِلَة, مَكَانَة",
 "standing army": "جيش نظامي (جيش دائم من الجنود مدفوعي الأجر)",
 "standing committee": "لجنة دائمة (لجنة دائمة)",
 "standing operating procedure": "إجراء تشغيلي قياسي, إجراء قياسي (إجراء مقرر يجب اتباعه بشكل روتيني)\nمثال: الحفظ عن ظهر قلب كان الإجراء التشغيلي القياسي للمعلمين لقرون",
 "standing order": "أَمْر دَائِم, لَائِحَة دَائِمَة (قاعدة تنظيمية سارية المفعول بشكل دائم)",
 "standing ovation": "تَصْفِيقٌ مَعَ الوُقُوف, تَصْفِيقٌ حَارّ",
 "standing press": "مكبس عمودي (مكبس طباعة كبير يمارس الضغط عمودياً)",
 "standing rib roast": "ريش للتحمير, شواء الضلع (قطعة من اللحم (بقر أو غزال) تشمل أكثر من ضلع واللحم الموجود على الجانب الخارجي للأضلاع)",
 "standing room": "أَمَاكِن وُقُوف (مساحة للركاب أو المتفرجين للوقوف)\nمثال: كان هناك أماكن وقوف لآلاف الأشخاص الإضافيين",
 "standing stone": "قائمة حجرية, منهير (ميغاليث عمودي طويل؛ يوجد بشكل أساسي في إنجلترا وشمال فرنسا)",
 "standing wave": "موجة راكدة, موجة موقوفة (موجة (كموجة صوتية في غرفة أو موجة كهرومغناطيسية في خط نقل) لا تتغير فيها نسبة سعتها اللحظية عند نقطة واحدة إلى تلك الموجودة عند أي نقطة أخرى بمرور…)",
 "standoff": "ردع, صد (فعل صد أو دفع الهجوم؛ موقف دفاعي ناجح) / تعادل (نهاية مسابقة تتعادل فيها النتيجة ولا يتحدد الفائز)\nمثال: انتهت المباراة بالتعادل",
 "standoffish": "فَاتِر, مُتَبَاعِد (يفتقر إلى الودّ والمؤانسة؛ جافّ في التعامل)",
 "standoffishly": "بتحفظ شديد, بتكبر (بطريقة متحفظة وبعيدة)\nمثال: بتحفظ شديد، رفض الدعوة لحفلة المكتب",
 "standoffishness": "انعزال, تحفظ (الميل لكون المرء بعيداً وغير متعاطف في أسلوبه)",
 "standpipe": "أنبوب قائم (أنبوب رأسي)",
 "standpoint": "زاوية نظر, منظور (موقف ذهني يتم من خلاله النظر إلى الأشياء)\nمثال: يجب أن ننظر في هذه المشكلة من وجهة نظر الروس",
 "standstill": "توقف, جمود (انقطاع النشاط الطبيعي) / جمود, طريق مسدود (وضع لا يمكن فيه إحراز تقدم أو لا يمكن فيه أي تقدم)\nمثال: وصلوا إلى طريق مسدود في المفاوضات",
 "standup comedian": "فنان كوميديا ارتجالية, مؤدي ستاند أب (كوميدي يستخدم النكات والطرائف في عرض مباشر)",
 "stanford-binet test": "اختبار ستانفورد بينيه (مراجعة لمقياس بينيه سيمون)",
 "stanhope": "عربة ستانهوب (عربة خفيفة مفتوحة تجرها الخيول بعجلتين أو أربع ومقعد واحد)",
 "stanhopea": "ستانهوبيا (أي من بساتين الفاكهة المختلفة من جنس ستانهوبيا ذات ورقة كبيرة واحدة وعناقيد رخوة من الزهور العطرة الكبيرة بألوان مختلفة؛ المكسيك إلى البرازيل)",
 "stank": "رائحة جنسية (رائحة الأعضاء التناسلية أو الجنس)",
 "stanley steamer": "سيارة ستانلي البخارية (سيارة تعمل بالبخار)",
 "stanleya pinnata": "ريشة الأمير, ستانليا (نبات معمر من جنوب غرب الولايات المتحدة له أوراق ريشية جلدية زرقاء خضراء وسنابل سميكة تشبه الريش من الزهور الصفراء؛ يوضع أحياناً في جنس كليوم)",
 "stannic": "قصديري (مكون من أو متعلق بـ أو يحتوي على القصدير)",
 "stannic chloride": "كلوريد القصديريك (سائل كاوٍ عديم اللون يُصنع بمعالجة القصدير بالكلور)",
 "stannic sulfide": "ذهب فسيفسائي, كبريتيد القصديريك (خضاب أصفر يعلق أحياناً في الطلاء)",
 "stannite": "بايريت القصدير, ستانيت (معدن رمادي غامق بلمعان معدني يعد مصدراً للقصدير)",
 "stannous": "قصديري (مكون من أو متعلق بـ أو يحتوي على القصدير)",
 "stannous fluoride": "فلوريد القصدير (مسحوق أبيض يُستخدم لفلورة معجون الأسنان)",
 "stanza": "مَقْطَع, بَيْت",
 "stapedectomy": "استئصال عظم الركاب (إزالة جراحية لعظم الركاب في الأذن الوسطى)",
 "stapelia": "زهرة الجيفة, زهرة نجم البحر",
 "stapelias asterias": "ستابيليا نجمية (ستابيليا من مقاطعة الكاب لها زهور بنية حمراء داكنة غالباً بتويجات مسطحة تشبه النجوم)",
 "stapes": "ركاب (العظمة التي تشبه الركاب والتي تنقل الصوت من السندان إلى القوقعة)",
 "staph": "مكورة عنقودية (بكتيريا طفيلية كروية موجبة الجرام تميل لتشكيل مستعمرات غير منتظمة؛ يسبب بعضها دمامل أو تسمم الدم أو التهابات)",
 "staphylococcal": "عنقودي (مكون من أو متعلق بالبكتيريا المكورة العنقودية)\nمثال: عدوى عنقودية",
 "staphylococcal enterotoxin": "ذيفان معوي عنقودي (ذيفان خارجي قابل للذوبان تنتجه بعض سلالات المكورات العنقودية؛ أحد أسباب التسمم الغذائي)",
 "staphylococcal enterotoxin b": "ذيفان معوي عنقودي ب (شكل من أشكال الذيفان المعوي العنقودي الذي استخدم كعامل شل القدرة في الحرب البيولوجية)",
 "staphylococcal infection": "عدوى المكورات العنقودية (عدوى بكتيريا المكورات العنقودية؛ تتميز عادة بتكوين خراج)",
 "staphylococci": "مكورة عنقودية (بكتيريا طفيلية كروية موجبة الجرام تميل لتشكيل مستعمرات غير منتظمة؛ يسبب بعضها دمامل أو تسمم الدم أو التهابات)",
 "staphylococcus": "مكورة عنقودية (بكتيريا طفيلية كروية موجبة الجرام تميل لتشكيل مستعمرات غير منتظمة؛ يسبب بعضها دمامل أو تسمم الدم أو التهابات)",
 "staple": "أَسَاسِيّ, رَئِيسِيّ (ضروريّ أو مهمّ خاصة فيما يتعلّق بالأغذية أو السلع) / سلع أساسية (سلعة ضرورية يكون الطلب عليها ثابتاً) / دبوس دباسة / مسمار مشبك (وتد صغير من حَدِيد أحد طرفيه مسنون والآخر له رأس يدق في الخشب والجدران وغيرها للتثبيت؛ غِلْظ صغير مخروطي الشكل قد يحدث في أصابع القدم أو في أخْمَص القدم)",
 "staple fiber": "ألياف أساسية, تيلة (ألياف طبيعية (قطن خام، صوف، قنب، كتان) يمكن غزلها لتشكيل خيوط)\nمثال: تتفاوت الألياف الأساسية بشكل كبير في الطول",
 "staple fibre": "ألياف أساسية, تيلة (ألياف طبيعية (قطن خام، صوف، قنب، كتان) يمكن غزلها لتشكيل خيوط)\nمثال: تتفاوت الألياف الأساسية بشكل كبير في الطول",
 "staple gun": "مسدس دبابيس (آلة محمولة باليد لدق الدبابيس)",
 "staplegun": "مسدس دبابيس (آلة محمولة باليد لدق الدبابيس)",
 "stapler": "دَبَّاسَة",
 "stapling machine": "دباسة (آلة تدخل الدبابيس في أوراق لتثبيتها معاً)",
 "star": "إِجَّامَة / نَجْمَة",
 "star anise": "ليسوم حقيقي, ينسون نجمي",
 "star aniseed": "ينسون نجمي (فاكهة أو بذرة على شكل نجمة برائحة الينسون تستخدم في الطبخ الآسيوي والطب)",
 "star apple": "تفاح النجمة, كايميتو (شجرة دائمة الخضرة من جزر الهند الغربية وأمريكا الوسطى لها فاكهة أرجوانية صالحة للأكل على شكل نجمة في المقطع العرضي وأوراق خضراء داكنة بجوانب سفلية…)",
 "star atlas": "أطلس النجوم ((علم الفلك) سلسلة من خرائط النجوم لأوقات مختلفة، على سبيل المثال، لكل شهر؛ تُرسم الخرائط عموماً بمقياس صغير وفي شكل كتاب)",
 "star begonia": "بيغونيا النجمة (بيغونيا جذمورية لها أوراق ذات فصوص مدببة توحي بالنجوم وزهور وردية)",
 "star chamber": "غرفة النجوم (محكمة إنجليزية سابقة اشتهرت بأساليبها التعسفية وعقوباتها القاسية)",
 "star chart": "خريطة النجوم (مخطط يوضح المواقع النسبية للنجوم في جزء معين من السماء)",
 "star divination": "تنجيم (علم زائف يدعي العرافة من خلال مواقع الكواكب والشمس والقمر)",
 "star drill": "إزميل نجمي, مثقاب نجمي (مثقاب صخري فولاذي بنقطة على شكل نجمة يستخدم لعمل ثقوب في الحجارة أو البناء؛ يتم تشغيله بضرب النهاية بمطرقة أثناء تدويره بين الضربات)",
 "star earthball": "سكليروديرما صفراء (كرة أرضية ذات سطح علوي أملس تكون مدفونة في الرمل في البداية؛ ينفتح الجزء العلوي من الجسم الثمري ليشكل قطعاً تشبه شعاع الخيمة)",
 "star fort": "حصن نجمي (تحصين يتكون من العديد من الحصون المثلثة البارزة (عادة من خمسة إلى ثمانية)، مصممة خصيصاً لتغطية بعضها البعض؛ شوهد لأول مرة في منتصف القرن الخامس عشر…)",
 "star fortress": "حصن نجمي (تحصين يتكون من العديد من الحصون المثلثة البارزة (عادة من خمسة إلى ثمانية)، مصممة خصيصاً لتغطية بعضها البعض؛ شوهد لأول مرة في منتصف القرن الخامس عشر…)",
 "star fruit": "فَاكِهَةْ اَلنَّجْمَة, قُلُنْبَاقْ (الثمار كلها؛ ما يتنعم بأكله رطبا كان أم يابسا كالتين واللوز والرمان ونحوها)\nمثال: التفاح فاكهة لذيذة.",
 "star grass": "عشبة طاحونة الهواء (عشبة أسترالية معمرة ذات سنابل طويلة عديدة مرتبة مثل ريش طاحونة الهواء) / ثيّل, عشب برمودا (عشب زاحف موطنه أوروبا وعالمي الانتشار الآن في المناطق الدافئة؛ يستخدم للمروج والمراعي خاصة في جنوب الولايات المتحدة والهند) / عشب النجمة, هيبوكسيس / جذر المغص, عشبة النجمة (أي من النباتات المعمرة العديدة من جنس ألتريس ذات أوراق تشبه العشب وجذور مرة تشتهر بعلاج المغص)",
 "star ipomoea": "أثمان قرمزي, مجد الصباح الأحمر (عشب حولي له زهور قرمزية؛ شرق الولايات المتحدة)",
 "star jasmine": "ياسمين نجمي (متسلق خشبي صيني دائم الخضرة ذو أوراق خضراء داكنة لامعة وأزهار بيضاء شديدة العطرية)",
 "star magnolia": "ماغنوليا نجمية (ماغنوليا شجيرية متساقطة الأوراق من اليابان ذات زهور بيضاء عطرية تشبه النجوم تتفتح قبل أن تنبسط الأوراق؛ تزرع كنبات زينة في الولايات المتحدة)",
 "star of bethlehem": "نَجْم بَيْتَ لَحْمَ (طَلَعَ وظَهَرَ؛ نَجَمَ عن الأمر: أي ظهر نَتِيجَة عنه أو نَتَجَ عنه)\nمثال: سميت السفينة \"النجم الفضي\".",
 "star of david": "نَجْمَة دَاوُود",
 "star of the veldt": "قطيفة الرأس, قطيفة الشمس (أي من عدة نباتات من جنوب أفريقيا تُزرع لغزارة زهورها التي تشبه الأقحوان وعادة ما تكون صفراء وأوراقها العطرية)",
 "star sapphire": "ياقوت نجمي (ياقوت أزرق يُظهر شكلاً يشبه النجمة في الضوء المنعكس عند قطعه بسبب هيكله البلوري)",
 "star saxifrage": "كاسر الحجر النجمي (نبات ألبي صغير يشكل حصيرة غالباً له زهور بيضاء صغيرة تشبه النجوم؛ أوروبا)",
 "star shell": "قذيفة مضيئة (قذيفة مدفعية تحتوي على مادة مضيئة)",
 "star sign": "برج, برج فلكي ((علم التنجيم) واحدة من 12 منطقة متساوية تنقسم إليها دائرة البروج)",
 "star system": "نِظَام نَجْمِيّ (مَنْهَج، طَرِيقَة؛ تَرْتِيب واتِّسَاق)\nمثال: ليس بنظام كامل.",
 "star topology": "طوبولوجيا النجمة",
 "star tulip": "آذان القط الأنيقة, توليب النجمة (نبات صغير بسيقان منحنية رفيعة تحمل عناقيد متفرعة لعدد قليل من الزهور البيضاء النجمية ببتلات تشبه آذان القط؛ جنوب شرق واشنطن وشمال شرق أوريغون إلى…)",
 "star wars": "حَرْب النُّجُوم (حَرَبَ (حربه) بالحربة حربا: طعنه بها؛ حَرَبَ (ه) حربا: سلبه جميع ما يملك)\nمثال: بوتين مجرم حرب.",
 "star-duckweed": "عدس الماء النجمي (عالمي الانتشار في المناطق المعتدلة باستثناء أمريكا الشمالية)",
 "star-glory": "أثمان ريشي, كرمة السرو (متسلق حولي أمريكي استوائي له زهور حمراء (وأحياناً بيضاء) وأوراق مقطعة بدقة؛ تم توطينه في الولايات المتحدة وأماكن أخرى)",
 "star-leaf begonia": "بيغونيا النجمة (بيغونيا جذمورية لها أوراق ذات فصوص مدببة توحي بالنجوم وزهور وردية)",
 "star-nosed mole": "خلد نجمي الأنف (خلد برمائي من شرق أمريكا الشمالية له مجسات لحمية وردية حول الأنف)",
 "star-of-bethlehem": "أورنيثوغالم, نجمة بيت لحم",
 "star-shaped": "نَجْمِيُّ الشَّكْلِ, نَجْمِيّ (ذو شكل يشبه النجمة)",
 "star-shaped fortress": "حصن نجمي (تحصين يتكون من العديد من الحصون المثلثة البارزة (عادة من خمسة إلى ثمانية)، مصممة خصيصاً لتغطية بعضها البعض؛ شوهد لأول مرة في منتصف القرن الخامس عشر…)",
 "star-spangled banner": "العلم الأمريكي, علم النجوم والخطوط (العلم الوطني للولايات المتحدة الأمريكية)",
 "star-struck": "مُنْبَهِرٌ بِالمَشَاهِير (مفتون بشخص مشهور)",
 "star-thistle": "شوك النجم, قنطريون شوكي (عشبة متوسطية سنوية أو ثنائية الحول ذات زهور وردية إلى أرجوانية محاطة بحراشف ذات أطراف شوكية؛ متوطنة في أمريكا)",
 "starboard": "يَمِينِيُّ السَّفِينَة (واقع على الجانب الأيمن من السفينة أو الطائرة) / الجانب الأيمن, الميمنة (الجانب الأيمن لسفينة أو طائرة لشخص على متنها ويواجه المقدمة أو الأنف)",
 "starbucks": "سْتَارْبَكْس",
 "starch": "نَشَاء",
 "starch wheat": "إيمر, قمح ثنائي الحبة (قمح أحمر صلب يزرع خاصة في روسيا وألمانيا؛ وفي الولايات المتحدة كعلف للماشية)",
 "starches": "نشويات (مواد غذائية غنية بالنشا الطبيعي (خاصة البطاطس والأرز والخبز))",
 "starchless": "خال من النشا (يفتقر إلى النشا)",
 "starchlike": "شَبِيه بِالنَّشَا, نَشَوِيّ الشَّكْل (يشبه النشا في مظهره أو خصائصه)",
 "starchy": "مُتَزَمِّت, مُتَصَلِّب (رَسْمِيٌّ بِشَكْلٍ صَارِمٍ وَجَامِدٍ) / نشوي (يتكون من أو يحتوي على النشا)\nمثال: أطعمة نشوية",
 "stardom": "نُجُومِيَّة",
 "stardust": "خيال حالم, سحر رومانسي (صفة رومانسية حالمة أو عاطفية)",
 "stare": "حَدَّقَ (حَدَقَ فلَان الشَّيْءَ بعَيْنِه يَحْدِقُه حَدْقاً: إِذا نَظَرَ إلَيهِ، وحدَقَ فُلاناً: إِذا أَصَابَ حَدَقَتَه؛ حدَق به:أَحَاطَ به من كلّ جهة (حدَقت قوات الأمن بالقرية))\nمثال: حدق الجميع في وجهي.",
 "starer": "محدق (مشاهد يحدق بثبات (غالباً بعداء))",
 "starets": "ستارتس, شيخ روحي (مستشار ديني (ليس بالضرورة كاهنًا) في الكنيسة الأرثوذكسية الشرقية)",
 "starfighter": "مقاتلة نجمية (مركبة فضائية مصممة للقتال في الفضاء الخارجي)",
 "starfish": "نَجْمَةُ اَلْبَحْرِ",
 "starfish flower": "زهرة الجيفة, زهرة نجم البحر",
 "starflower": "زهرة النجم, نجمة بيت لحم (عشبة شائعة في العالم القديم ذات أوراق تشبه العشب وعناقيد من الزهور البيضاء على شكل نجمة مع خطوط خضراء؛ متوطنة في شرق الولايات المتحدة)",
 "stargazer": "محدقة النجوم (أسماك بحرية ثقيلة الجسم تكمن في القاع وعيونها على قمة الرأس المسطحة) / عالم فلك, فلكي (فيزيائي يدرس علم الفلك) / آكل اللوتس, حالم (شخص غير مبالٍ بالعالم المشغول)",
 "stargazing": "تحديق في النجوم (مراقبة النجوم)",
 "staring": "شَاخِص, مُحَمْلِق ((يوصف به العينان) مفتوحتان وجامدتان كما في حالة خوف أو دهشة)",
 "stark": "تماماً, كلياً (لأقصى درجة) / جَرْدَاء, قَاحِلَة (لا توفِّر مأوى ولا قوتاً) / تَامّ, صِرْف (كَامِلٌ أَوْ مُتَطَرِّفٌ فِي شِدَّتِه) / تَقَشُّفِيّ, صَارِم (بسيط بشكل صارم وخالٍ من أيّ زخرفة)\nمثال: مجنون تماماً",
 "stark naked": "عَارٍ تَمَاماً ((غير رسمي) عارٍ تماماً بلا أي ملابس)",
 "starkers": "عَارٍ تَمَاماً ((عامّيّة بريطانيّة) عارٍ تماماً)",
 "starkly": "بصراحة جارحة, بفظاظة (بطريقة فظة ومباشرة) / بتباين صارخ (بخطوط واضحة أو تباين حاد) / بشكل صارخ, تماماً (بطريقة صارخة)\nمثال: بمصطلحات واقعية بفظاظة",
 "starkness": "خلو من الزينة, عري (نقص شديد في المفروشات أو الزخرفة) / حدة, صرامة (صفة كون الشيء كاملاً أو مطلقاً أو متطرفاً)\nمثال: لقد أذهلني خلو غرفة أبي من الزينة",
 "starless": "غير مرصع بالنجوم (ليس مرصعاً بالنجوم؛ ليس به نجوم أو أشياء تشبه النجوم)\nمثال: ليال مظلمة بلا نجوم",
 "starlessness": "غياب النجوم (حالة عدم وجود نجوم مرئية)\nمثال: ومع ذلك، تذكر كوة في السقف، والظلام الخالي من النجوم لليل الذي تؤطره",
 "starlet": "نُجَيْمَة (نجم صغير) / نجمة صاعدة (ممثلة (سينمائية) شابة يتم الترويج لها كنجمة مستقبلية)",
 "starlight": "ضوء النجوم (ضوء النجوم)",
 "starlike": "شَبِيه بِالنَّجْم, نَجْمِيّ الشَّكْل (يشبه النجم في شكله)",
 "starling": "زُرْزُور",
 "starlit": "مُضَاء بِالنُّجُوم (لا يُنيره سوى ضوء النجوم)",
 "starnose mole": "خلد نجمي الأنف (خلد برمائي من شرق أمريكا الشمالية له مجسات لحمية وردية حول الأنف)",
 "starred": "مُعَلَّمٌ بِنَجْمَة, مُنَجَّم (مُعلَّم بعلامة النجمة)",
 "starry": "مرصع بالنجوم, مضاء بالنجوم (يزخر بالنجوم أو يشبهها)\nمثال: ليلة مرصعة بالنجوم",
 "starry saxifrage": "كاسر الحجر النجمي (نبات ألبي صغير يشكل حصيرة غالباً له زهور بيضاء صغيرة تشبه النجوم؛ أوروبا)",
 "starry-eyed": "حَالِم, سَاذَج التَّفَاؤُل (متفائل بشكل غير واقعي أو ساذج)",
 "stars": "سورة النجم",
 "stars and bars": "النجوم والقضبان, علم الكونفدرالية (أول علم للولايات الكونفدرالية الأمريكية)",
 "stars and stripes": "العلم الأمريكي, علم النجوم والخطوط (العلم الوطني للولايات المتحدة الأمريكية)",
 "starship": "سفينة نجمية (مركبة فضائية مصممة لحمل طاقم إلى الفضاء بين النجوم (خاصة في الخيال العلمي))",
 "start": "نَجْمَة, اِبْتِدَاء / نَجْمَة / بَدَأَ (حَدَثَ ونَشَأَ وحَصَلَ؛ أَخَذَ، شَرَعَ)\nمثال: بدأ سامي يتكلم.",
 "start menu": "اَلْقَائِمَة اِبْدَأْ",
 "start-off": "انطلاق, ضربة البداية (بداية تعطى للمتسابقين)\nمثال: كنت هناك مع والدي عند الانطلاق",
 "starter": "بادئ (مزرعة تحتوي على خميرة أو بكتيريا تستخدم لبدء عملية التخمير أو التحمض في صنع الزبدة أو الجبن أو العجين) / ذراع تدوير, مرفق تدوير (أداة يدوية تتكون من عمود دوار بمقبض مواز) / بادئ التشغيل, مارش (محرك كهربائي لبدء تشغيل المحرك) / فاتح للشهية, مقبلات (طعام أو شراب لتحفيز الشهية (يُقدم عادة قبل الوجبة أو كطبق أول))\nمثال: لصنع العجين المخمر تحتاج إلى بادئ",
 "starter motor": "بادئ التشغيل, مارش (محرك كهربائي لبدء تشغيل المحرك)",
 "starting": "بدء, مشاركة أساسية (دور للبدء (في لعبة في البداية)) / ابْتِدَائِيّ, انْطِلَاقِيّ (مُنَاسِبٌ لِبِدَايَةِ حَدَثٍ أَوِ انْطِلَاقَتِهِ) / جَاحِظ ((خاصة العيون) منتفخ أو بارز كما في حالة الخوف)\nمثال: حصل على بدايته لأن أحد الرماة الأساسيين كان في المستشفى",
 "starting block": "كتلة البداية (كتلة توفر دعماً لأقدام العداء عند بدء السباق)",
 "starting buffer": "محلول منظم أولي (محلول منظم عند بداية التفاعل)",
 "starting gate": "بوابة الانطلاق (حاجز متحرك على خط بداية مسار السباق)",
 "starting handle": "مقبض بدء التشغيل, مقبض تدوير (مرفق يستخدم لبدء تشغيل المحرك)",
 "starting line": "خط البداية (خط يشير إلى موقع بدء سباق أو لعبة)",
 "starting motor": "بادئ التشغيل, مارش (محرك كهربائي لبدء تشغيل المحرك)",
 "starting pitcher": "رامٍ أساسي ((في البيسبول) الرامي الذي يبدأ المباراة)",
 "starting point": "نقطة البداية (أقرب نقطة حدية)",
 "starting post": "عمود البداية (عمود يحدد نقطة انطلاق السباق (خاصة سباق الخيل))",
 "starting signal": "إشارة البدء (إشارة للبدء (كما في السباق))\nمثال: كانت إشارة البدء ضوءاً أخضر",
 "starting stall": "بوابة الانطلاق (حاجز متحرك على خط بداية مسار السباق)",
 "starting time": "استهلال, انطلاق (الوقت الذي يفترض أن يبدأ فيه شيء ما)\nمثال: بدأوا بداية مبكرة",
 "startle": "فَاجَأَ, بَاغَثَ",
 "startle reaction": "استجابة الجفل (رد فعل لا إرادي معقد لمحفز غير متوقع ومفاجئ (خاصة الضوضاء العالية)؛ يتضمن انثناء معظم العضلات الهيكلية ومجموعة متنوعة من ردود الفعل الحشوية)",
 "startle reflex": "منعكس الإجفال, منعكس مورو (منعكس طبيعي للرضع الصغار؛ تسبب الضوضاء العالية المفاجئة قيام الطفل بمد ذراعيه وثني ساقيه)",
 "startle response": "استجابة الجفل (رد فعل لا إرادي معقد لمحفز غير متوقع ومفاجئ (خاصة الضوضاء العالية)؛ يتضمن انثناء معظم العضلات الهيكلية ومجموعة متنوعة من ردود الفعل الحشوية)",
 "startled": "مَفْزُوع, مُرْتَاع (أُثير بمفاجأة أو فزع مفاجئ فقام بحركة لا إرادية)",
 "startling": "صَادِم, مُفْزِع (مختلف أو مفاجئ بشكل يُسبب صدمة أو فزعًا لحظيًا)",
 "startlingly": "بشكل مذهل, بصورة مفاجئة (بطريقة مثيرة للدهشة)\nمثال: صوت حديث بشكل مذهل",
 "startup": "افتتاح, بدء تشغيل (فعل بدء عملية أو ممارسة جديدة) / بدء التشغيل (فعل وضع الشيء في حالة التشغيل)\nمثال: عارض بدء تطبيق الفلورة",
 "starvation": "جُوع شَدِيد (جَوَّعَ: أجاع (جوعه) أجاعه، أي مَنعه الطَّعَام وَالشرَاب واضطره إِلَى الْجُوع)\nمثال: بدأت أحس بالجوع.",
 "starvation acidosis": "حماض المجاعة (حماض ناتج عن نقص الغذاء الذي يؤدي إلى تكسير الدهون وإطلاق الكيتونات الحمضية)",
 "starve": "تَضَوَّرَ",
 "starved": "مُتَضَوِّر جُوعًا, نَهِم (جائع للغاية؛ شديد الجوع) / مُتَضَوِّر جُوعًا, يَتَضَوَّر جُوعًا (يعاني من نقص شديد في الغذاء)",
 "starved aster": "أستر جائع, أستر كاليكو",
 "starveling": "جائِع, مُتَضَوِّر جُوعاً (شخص يتضور جوعاً)",
 "starving": "تجويع (فعل الحرمان من الطعام أو التعريض للمجاعة) / مُتَضَوِّر جُوعًا, يَتَضَوَّر جُوعًا (يعاني من نقص شديد في الغذاء)",
 "starwort": "حشيشة القزاز الكبرى (عشبة منخفضة النمو في المنطقة المعتدلة الشمالية ذات أزهار بيضاء صغيرة على شكل نجمة؛ سميت لقدرتها المزعومة على تخفيف الآلام الحادة في الجانب)",
 "stash": "كنز مخفي, مخبأ (مخزون سري من الأشياء الثمينة أو المال)",
 "stash house": "منزل إخفاء, وكر (منزل تُخفى فيه الأسلحة والإمدادات)\nمثال: الهجمات على منازل الإخفاء هي الطريقة الأكثر استخداماً لمكافحة الإرهاب",
 "stasis": "ركودة (خمول ناتج عن توازن ثابت بين القوى المتعارضة) / ركود (حالة غير طبيعية يتباطأ فيها التدفق الطبيعي للسائل (مثل الدم) أو يتوقف)",
 "stassano furnace": "فرن القوس الكهربائي (فرن كهربائي يوفر فيه القوس الكهربائي مصدر الحرارة لصنع الصلب)",
 "stat mi": "ميل (وحدة للطول تساوي 1,760 ياردة أو 5,280 قدماً؛ تساوي بالضبط 1609.344 متراً)",
 "state": "وَضْع (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه) / دَوْلَة (بَلَد يتميز بحُدُود معروفة وشَعْب وحُكُومَة ومُؤَسَسَات مُنَظَّمَة؛ مجموعة من الناس مستقلين متحدين معا لتكوين مجتمع لحماية حقوقهم و وضع قوانينهم الخاصة) / وِلَايَة (منطقة إدارية لها استقلالها الإداري والمعنوي؛ ويختلف المعنى من بلد لآخر كما يختلف من فترة زمنية لأخرى) / يُبْدِي\nمثال: لقد أزمت الوضع.",
 "state attorney": "مدعي الولاية (محامي ادعاء لولاية)",
 "state bank": "بنك محلي, بنك ولاية (بنك مرخص من قبل ولاية بدلاً من الحكومة الفيدرالية)",
 "state boundary": "حدود الولاية (الحدود بين ولايتين)",
 "state capital": "عاصمة الولاية (العاصمة لتقسيم سياسي داخل بلد ما)",
 "state capitalism": "رأسمالية الدولة (نظام اقتصادي رأسمالي في المقام الأول ولكن مع وجود درجة من الملكية الحكومية لوسائل الإنتاج)",
 "state change": "تحول الطور, تغير الطور (تغير من حالة (صلبة أو سائلة أو غازية) إلى أخرى دون تغيير في التركيب الكيميائي)",
 "state department": "إدارة الولاية (إدارة حكومية في إحدى الولايات الخمسين (الأمريكية)) / وزارة الخارجية, وزارة الخارجية الأمريكية (الإدارة الفيدرالية في الولايات المتحدة التي تضع وتحافظ على السياسات الخارجية)\nمثال: تأسست وزارة الخارجية عام 1789",
 "state government": "حكومة الولاية (حكومة ولاية في الولايات المتحدة)",
 "state highway": "أوتوستراد, طريق سريع (طريق سريع عريض مصمم لحركة المرور عالية السرعة)",
 "state line": "حدود الولاية (الحدود بين ولايتين)",
 "state of affairs": "حالة, ظرف (الحالة العامة للأشياء؛ مجموعة الظروف في وقت معين)\nمثال: الوضع الدولي الحالي خطير",
 "state of eritrea": "دَوْلَة إِرِتْرِيَا (بَلَد يتميز بحُدُود معروفة وشَعْب وحُكُومَة ومُؤَسَسَات مُنَظَّمَة؛ مجموعة من الناس مستقلين متحدين معا لتكوين مجتمع لحماية حقوقهم و وضع قوانينهم الخاصة)\nمثال: لبنان دولة صغيرة.",
 "state of flux": "تغير مستمر, عدم استقرار (حالة من عدم اليقين بشأن ما يجب فعله (عادة بعد حدث مهم) تسبق إنشاء اتجاه جديد للعمل)\nمثال: حالة التغير المستمر بعد وفاة الإمبراطور",
 "state of grace": "حالة النعمة, نعمة ((اللاهوت المسيحي) حالة التقديس من قبل الله؛ حالة الشخص الذي يخضع لمثل هذا التأثير الإلهي)\nمثال: تطور مفهوم النعمة جنباً إلى جنب مع مفهوم الخطيئة",
 "state of israel": "دَوْلَة إِسْرَائِيل (بَلَد يتميز بحُدُود معروفة وشَعْب وحُكُومَة ومُؤَسَسَات مُنَظَّمَة؛ مجموعة من الناس مستقلين متحدين معا لتكوين مجتمع لحماية حقوقهم و وضع قوانينهم الخاصة)\nمثال: لبنان دولة صغيرة.",
 "state of japan": "دولة اليابان (بَلَد يتميز بحُدُود معروفة وشَعْب وحُكُومَة ومُؤَسَسَات مُنَظَّمَة؛ مجموعة من الناس مستقلين متحدين معا لتكوين مجتمع لحماية حقوقهم و وضع قوانينهم الخاصة)\nمثال: لبنان دولة صغيرة.",
 "state of kuwait": "دَوْلَة اَلْكُوَيْت (بَلَد يتميز بحُدُود معروفة وشَعْب وحُكُومَة ومُؤَسَسَات مُنَظَّمَة؛ مجموعة من الناس مستقلين متحدين معا لتكوين مجتمع لحماية حقوقهم و وضع قوانينهم الخاصة)\nمثال: لبنان دولة صغيرة.",
 "state of libya": "دَوْلَةُ لِيبْيَا (بَلَد يتميز بحُدُود معروفة وشَعْب وحُكُومَة ومُؤَسَسَات مُنَظَّمَة؛ مجموعة من الناس مستقلين متحدين معا لتكوين مجتمع لحماية حقوقهم و وضع قوانينهم الخاصة)\nمثال: لبنان دولة صغيرة.",
 "state of matter": "حَالَة تَجَمُّع",
 "state of mind": "حالة إدراكية, حالة معرفية (حالة العمليات المعرفية للشخص) / حالة ذهنية, مزاج (حالة نفسية مؤقتة)",
 "state of nature": "برية, حالة الطبيعة (حالة بدائية برية لم تمسها الحضارة)\nمثال: عاش في البرية",
 "state of palestine": "دولة فلسطين (بَلَد يتميز بحُدُود معروفة وشَعْب وحُكُومَة ومُؤَسَسَات مُنَظَّمَة؛ مجموعة من الناس مستقلين متحدين معا لتكوين مجتمع لحماية حقوقهم و وضع قوانينهم الخاصة)\nمثال: لبنان دولة صغيرة.",
 "state of qatar": "دولة قطر (بَلَد يتميز بحُدُود معروفة وشَعْب وحُكُومَة ومُؤَسَسَات مُنَظَّمَة؛ مجموعة من الناس مستقلين متحدين معا لتكوين مجتمع لحماية حقوقهم و وضع قوانينهم الخاصة)\nمثال: لبنان دولة صغيرة.",
 "state of the art": "أحدث ما توصلت إليه التكنولوجيا, قمة التطور (أعلى درجة من التطور لفن أو تقنية في وقت معين)\nمثال: أحدث ما توصلت إليه التكنولوجيا في السفر إلى الفضاء",
 "state of the union": "خُطْبَة حَالَةِ الاِتِّحَاد",
 "state of war": "حالة حرب, حرب (حالة قانونية تنشأ بإعلان الحرب وتنتهي بإعلان رسمي تسري خلالها القواعد الدولية للحرب)\nمثال: أعلنت الحرب في نوفمبر لكن القتال الفعلي لم يبدأ حتى الربيع التالي",
 "state prison": "سجن الولاية (سجن تديره ولاية من الولايات المتحدة)",
 "state school": "مَدْرَسَة حُكُومِيَّة (الموضع الذي تُدَرَّس فيه العلوم؛ البناء فيه عدة غرف تُدَرَّسُ فيها العلوم وتمنح شهادة رسمية بعد إكمال الدروس)\nمثال: لا أحب المدرسة.",
 "state secret": "سِرّ دَوْلَة (شَعَرَ بِالسُّرُورِ)\nمثال: السر سيبقى سرا.",
