 "spacial": "حيزي, مكاني (متعلق بالمكان (الحيز) أو ينطوي عليه أو له طبيعته)\nمثال: البعد الأول الذي يجب التركيز عليه هو البعد المكاني",
 "spacing": "تَبَاعُد, تَوْزِيع مَكَانِيّ (الخاصية التي تمتلكها مجموعة من الأشياء التي توجد مسافة بينها) / تَبَاعُد زَمَنِيّ (الوقت بين حدوث حدث متكرر)\nمثال: بعض النساء لا يتحكمن في المباعدة بين أطفالهن",
 "spaciotemporal": "زَمَكَانِيّ (موجود في المكان والزمان معًا؛ له امتداد مكانيّ وديمومة زمنيّة)",
 "spacious": "وَاسِع, رَحْب (واسِع: (اسم)؛ واسع: (اسم))\nمثال: أرض الله واسعة.",
 "spaciously": "باتساع, برحابة (مع وجود مساحة واسعة)\nمثال: كان الأثاث موزعاً برحابة",
 "spaciousness": "رُحْب, رَحَب (بنو رَحَب: اسم؛ بطن من همذان)\nمثال: رحب فاضل بليلى.",
 "spackle": "معجون شقوق, معجونة (مسحوق (يحتوي على جص الجبس والغراء) يشكل عند خلطه بالماء معجوناً لدنًا يستخدم لملء الشقوق والثقوب في الجص)",
 "spackling compound": "معجون شقوق, معجونة (مسحوق (يحتوي على جص الجبس والغراء) يشكل عند خلطه بالماء معجوناً لدنًا يستخدم لملء الشقوق والثقوب في الجص)",
 "spacy": "ذَاهِل, مُشَوَّشُ الذِّهْن (فَاقِدُ التَّرْكِيزِ بِسَبَبِ مُخَدِّرٍ أَوْ مَا يُشْبِهُه)",
 "spade": "مِجْرَفَة, مِجْرَف / الْبَسْتُونِيّ",
 "spade bit": "ريشة مجرافية, ريشة مسطحة (ريشة رفيعة بنقطة مركزية وحواف قطع على كلا الجانبين)",
 "spade casino": "سبيد كازينو (شكل من أشكال الكازينو تكون فيه قيمة السبيت نقطة واحدة)",
 "spade-like": "مِجْرَفِيّ الشَّكْل (على شكل مِجرفة)",
 "spade-shaped": "مِجْرَفِيّ الشَّكْل (على شكل مِجرفة)",
 "spadefish": "سمكة المجرفة (سمكة غذائية عميقة الجسم قرصية الشكل تعيش في المياه الساحلية الدافئة لغرب المحيط الأطلسي)",
 "spadefoot": "علجوم قدم المجرفة (علجوم حفار من نصف الكرة الشمالي ببروز قرني يشبه المجرفة على كل قدم خلفية)",
 "spadefoot toad": "علجوم قدم المجرفة (علجوم حفار من نصف الكرة الشمالي ببروز قرني يشبه المجرفة على كل قدم خلفية)",
 "spadeful": "ملء مجرفة (الكمية التي يمكن لمجرفة حملها)",
 "spades": "بَسْتُونِيّ",
 "spadework": "عمل تمهيدي, عمل شاق (عمل أولي ممل أو روتيني للتحضير لمشروع ما)",
 "spadix": "إغريض (المحور اللحمي لسنبلة محاط غالباً بقنابة)",
 "spaghetti": "مَعْكَرُونَة / سَبَاغِيتِي",
 "spaghetti and meatballs": "سباغيتي وكرات اللحم (سباغيتي مع كرات اللحم في صلصة طماطم)",
 "spaghetti junction": "تقاطع معقد (تقاطع طرق سريعة معقد يحتوي على جسور متعددة)",
 "spaghetti sauce": "صلصة الباستا, صلصة المكرونة (أي من الصلصات العديدة للإسباجيتي أو أنواع أخرى من المعكرونة)",
 "spaghetti squash": "قرع السباغيتي (قرع بيضاوي متوسط الحجم ذو لب على شكل خيوط تشبه السباغيتي) / قرع السباغيتي (نبات قرع يحمل ثماراً بيضاوية بقشرة صفراء ناعمة ولب طري خيطي يشبه السباغيتي)",
 "spaghetti western": "فِلْم سْبَاغِيتِي, غَرْبِيّ سْبَاغِيتِي (شريط من السِّلِيلُوز تعلوه قشرة من الجلاتين ومن برومور الفِضَّة يستعمل للتصوير الفوتوغرافي والسينمائي؛ قصة سينمائية، نتاج سينمائي: «فلم تاريخي»)\nمثال: استمر الفلم ساعتين.",
 "spaghettini": "سباغيتيني (سباغيتي رفيعة)",
 "spahbed": "إِصْبَهْبَذ",
 "spain": "إِسْبَانِيَة, إِسْبَانِيَا",
 "spall": "شَظِيَّة صخرية, كِسْرَة حجر (شظية مكسورة من حافة أو سطح حجر أو خام ولها حافة رفيعة واحدة على الأقل)\nمثال: شاحنة تحمل كومة من شظايا الحجر الأزرق",
 "spallation": "تشظية ((في الفيزياء) تفاعل نووي تتفتت فيه النواة المقذوفة إلى العديد من الجسيمات)\nمثال: يعتقد بعض علماء الفلك أن النظام الشمسي تشكل عن طريق التشظية عندما كانت الشمس نجماً شاباً جداً",
 "spam": "بَيَانٌ مُزْعِج, سُخَام (ما يتبيَّن به الشيء من الدلالة والفصاحة وغيرها، وقيل هو الإفصاح مع ذكاء؛ كل شيء كُشف لك وبان عليك، وقيل هو الكشف والتوضيح بمعنى الإثبات بالدليل)\nمثال: وأوضح البيان ذاته، أن الوزارة وجهت تعليمات من أجل تسخير كافة الإمكانيات البشرية والمادية للتسريع من وتيرة سير العملية.",
 "spammer": "مرسل بريد عشوائي (شخص يرسل بريدًا إلكترونيًا غير مرغوب فيه (غالبًا بكميات كبيرة))",
 "span": "شِبْر",
 "span loading": "حِمْل البَاع (نسبة وزن الطائرة إلى باع جناحها)",
 "spandau": "سبانداو (نوع من الرشاشات الألمانية)",
 "spandex": "سباندكس (قماش صناعي مرن)",
 "spandrel": "مثلث العقد (مساحة سطحية مثلثة تقريباً بين قوسين متجاورين والمستوى الأفقي فوقهما)",
 "spandril": "مثلث العقد (مساحة سطحية مثلثة تقريباً بين قوسين متجاورين والمستوى الأفقي فوقهما)",
 "spangle": "بَرْق, ترتر (زينة تتكون من قطعة صغيرة من مادة لامعة تُستخدم لتزيين الملابس)",
 "spangled": "مُرَصَّع, مُزَيَّن بِالجَوَاهِر (مُغطّى بالخرز أو الجواهر أو الترتر)",
 "spangly": "مُرَصَّع, مُزَيَّن بِالجَوَاهِر (مُغطّى بالخرز أو الجواهر أو الترتر)",
 "spaniard": "إِسْبَانِيّ, إِسْبَانِيَّة",
 "spaniel": "سبانييل, كلب الذعرة (أي من سلالات كلاب الصيد الصغيرة إلى متوسطة الحجم ذات فراء حريري طويل وآذان طويلة مزينة بالشعر)",
 "spanish": "إِسْبَانِيّ / إسبانية",
 "spanish american": "أمريكي إسباني, هسباني (أمريكي لغته الأولى الإسبانية)",
 "spanish bayonet": "حربة إسبانية, يوكا ألوفوليا (يوكا صلبة بجذع قصير؛ توجد في جنوب الولايات المتحدة وأمريكا الاستوائية؛ لها أوراق صلبة مدببة بشوكة وعناقيد من الزهور البيضاء) / حربة إسبانية, يوكا توتية (يوكا طويلة من جنوب غرب الولايات المتحدة والمكسيك لها ساق خشبية وأوراق مدببة صلبة تشبه السيف وعنقود كبير من الزهور البيضاء)",
 "spanish broom": "وَزّال, وَزّال أَسَلِيّ",
 "spanish burgoo": "أويا بودريدا, برغو إسباني (نسخة إسبانية من يخنة البرغو)",
 "spanish cedar": "أرز إسباني, سيدريلا عطرية (شجرة أمريكية استوائية تنتج خشباً عطرياً يستخدم بشكل خاص للصناديق)",
 "spanish cedar tree": "أرز إسباني, سيدريلا عطرية (شجرة أمريكية استوائية تنتج خشباً عطرياً يستخدم بشكل خاص للصناديق)",
 "spanish chestnut": "أبو فروة, كستناء أوروبية (برية أو مزروعة في جميع أنحاء جنوب أوروبا وشمال غرب أفريقيا وجنوب غرب آسيا)",
 "spanish dagger": "خنجر إسباني (يوكا شجرية من جنوب غرب الولايات المتحدة وشمال المكسيك بأوراق سيفية الشكل وزهور بيضاء) / خنجر إسباني, يوكا مجيدة (يوكا من جنوب شرق الولايات المتحدة تشبه الحراب الإسبانية ولكن بجذع أقصر وأوراق أنعم)",
 "spanish dancer": "خيار البحر الشفاف (الإسم من الإختيار ، وهو إنتقاء شيء فيكون خير من غيره؛ صيغة جمع لخير ، بمعنى أفضل)\nمثال: لم يكن لدي خيار.",
 "spanish elm": "دردار إسباني, كورديا (شجرة أمريكية استوائية كبيرة من جنس كورديا تزرع لزهورها البيضاء الكريمية الوفيرة وخشبها القيم) / خشب الأمير, دردار إسباني (شجرة خشب أمريكية استوائية)",
 "spanish fly": "ذبابة إسبانية (خنفساء خضراء من جنوب أوروبا)",
 "spanish garlic": "ثوم عملاق, كراث رملي (كراث أوروبي يزرع ويستخدم مثل الكراث)",
 "spanish gorse": "جنيستا إسبانية, وزال إسباني (شجيرة قائمة من جنوب غرب أوروبا لها عناقيد من الزهور الصفراء الذهبية)",
 "spanish grunt": "ناخر إسباني (نوع من الناخر)",
 "spanish heath": "خلنج إسباني, خلنج برتغالي (شجيرة كثيفة منتصبة موطنها غرب شبه الجزيرة الأيبيرية ذات زهور بيضاء أو وردية غزيرة؛ متوطنة في جنوب غرب إنجلترا)",
 "spanish iris": "سوسن إسباني (سوسن بصلي من منطقة غرب البحر الأبيض المتوسط له زهور بنفسجية أرجوانية عادة)",
 "spanish language": "اللغة الإسبانية (اللغة الرومانسية التي يتم التحدث بها في معظم إسبانيا والبلدان التي استعمرتها إسبانيا)",
 "spanish lime": "جينيب, ليمون إسباني (فاكهة كاريبية مستديرة بقطر بوصة واحدة ذات قشرة جلدية خضراء ولب شفاف عصيري حلو) / ليمون إسباني, مامونسيلو (شجرة استوائية أمريكية تحمل فاكهة صغيرة صالحة للأكل ذات قشرة جلدية خضراء ولب شفاف عصيري حلو)",
 "spanish lime tree": "ليمون إسباني, مامونسيلو (شجرة استوائية أمريكية تحمل فاكهة صغيرة صالحة للأكل ذات قشرة جلدية خضراء ولب شفاف عصيري حلو)",
 "spanish mackerel": "جاك ماكريل, ماكريل الحصان (سمكة طعام من كاليفورنيا) / ماكريل إسباني (ماكريل متوسط الحجم في المحيط الأطلسي المعتدل وخليج المكسيك) / ماكريل إسباني / ماكريل إسباني (لحم أسماك هامة تجارياً وخاصة من المياه الساحلية الأطلسية لأمريكا)",
 "spanish monetary unit": "وحدة نقدية إسبانية (الوحدة النقدية في إسبانيا)",
 "spanish moss": "طحلب إسباني, لحية العجوز (أكاليل كثيفة من خيوط مرنة تشبه الشعر بلون رمادي مخضر مثبتة بجذوع الأشجار وفروعها بواسطة جذور سلكية متفرقة؛ جنوب شرق الولايات المتحدة وجزر الهند…)",
 "spanish needles": "إبر إسبانية, بيدنس ثنائي الريش (قطيفة شائكة شائعة في شرق الولايات المتحدة) / بُذُور الحَسَك (بذور نبات الحسك)",
 "spanish oak": "بلوط إسباني, بلوط تكساس (شجرة متساقطة الأوراق صغيرة يتفرع جذعها تقريباً من القاعدة بفروع منتشرة؛ تكساس وجنوب أوكلاهوما)",
 "spanish onion": "بصل إسباني (بصل كبير خفيف وعصاري؛ يؤكل نيئاً غالباً)",
 "spanish oyster plant": "سكوليمس, نبات المحار الإسباني (شوك ذهبي من جنوب غرب أوروبا يُزرع لجذوره الحلوة الصالحة للأكل وأوراقه وسيقانه الصالحة للأكل؛ تستخدم زهوره الصفراء كبديل للزعفران)",
 "spanish paprika": "بابريكا إسبانية (توابل خفيفة مصنوعة من مجموعة متنوعة من الفليفلة المزروعة في إسبانيا)",
 "spanish people": "الإسبان (شعب إسبانيا)",
 "spanish peseta": "بيزيتا, بيزيتا إسبانية (سابقاً وحدة المال الأساسية في إسبانيا؛ تساوي 100 سنتيمو)",
 "spanish pointer": "بوينتر, كلب المؤشر (كلب قوي نحيل ناعم الشعر من أصل إسباني ذو فراء أبيض مع بقع بنية أو سوداء؛ يشم الطريدة ويشير إليها)",
 "spanish psyllium": "قطونة, لسان الحمل الأسيوي (نبات لسان الحمل في مناطق البحر الأبيض المتوسط تنتفخ بذوره وتصبح هلامية عند ترطيبها وتستخدم كملين خفيف)",
 "spanish rice": "أرز إسباني (أرز حار مع الطماطم والبصل والفلفل الأخضر)",
 "spanish sign language": "لُغَة اَلْإِشَارَة اَلْإِسْبَانِيَّة (هِيَ مجموعة من الأصوات التي يصدرها الإنسان على شكل كلمات منظمة بقواعد، ليتواصل به الناس وينقلون به الافكار والمعاني، اللسان؛ يقصد بها أحيانا اللهجة)\nمثال: الأمازيغية لغة.",
 "spanish tamarind": "تمر هندي إسباني, فانجيريا مدغشقرية (شجرة شجيرية من مدغشقر تزرع أحياناً لثمارها الصالحة للأكل التي تشبه التفاح)",
 "spanish tea": "دودة البذور الأمريكية, شاي مكسيكي (عشبة الخنازير الاستوائية الأمريكية كريهة الرائحة)",
 "spanish-speaking": "نَاطِقٌ بِالإِسْبَانِيَّة (قادر على التواصل باللغة الإسبانية)",
 "spank": "صَفَعَ, سَتَهَ (ضرب بشدة على الوجه أو الجفن؛ في السياق المجازي: أوقع الشخص في موقف محرج أو مهين)\nمثال: صفع المدرس مؤخرتي.",
 "spanker": "سبانكر, شراع خلفي كبير (شراع طولي يوضع على الصارية السفلية الخلفية (عادة صارية الميزن) للسفينة) / صافع, ضارب (ضارب يصفع (عادة شخصًا آخر) بيد مفتوحة)\nمثال: صفعني شخص ما على ظهري واستدرت لأرى من الصافع",
 "spanking": "خَفِيفُ الحَرَكَة, نَشِيط (سريع ومفعم بالطاقة والحيوية) / صفع على الأرداف (فعل الصفع على الأرداف)",
 "spanner": "مِفْتَاح رَبْط (مفتاح)\nمثال: بحث عن المفتاح.",
 "spar": "ملاكمة تدريبية, مناوشة (القيام بحركات الهجوم والدفاع بالقبضات والأذرع؛ جزء من تدريب الملاكم) / صارية, عارضة (عمود قوي مستدير من الخشب أو المعدن يستخدم لدعم الحبال والأشرعة) / سبار, فلسبار (أي من المعادن اللافلزية المختلفة (الكالسيت أو الفلسبار) فاتحة اللون وشفافة أو نصف شفافة وقابلة للانفصام)",
 "spar buoy": "عوامة عمودية (عوامة تشبه جذع شجرة عمودي)",
 "sparaxis tricolor": "زهرة المهرج, سباراكسيس (نبات مبهرج يزرع غالباً بزهور صفراء سمراء غالباً ما تكون منقطة بالأرجواني)",
 "spare": "رَحِمَ (رَحِم: عضو تناسلي أنثوي داخلي مستجيب للهرمون الأنثوي في الجهاز التناسلي لدى البشر ومعظم الثدييات الأخرى؛ الجمع: أرحام)\nمثال: رحمة الله عليه.",
 "spare no effort": "لا يدّخر جهدًا (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: لا أحب المدرسة.",
 "spare part": "قِطْعَة غَيَار (القِطْعَةُ: الْجُزْءَ أو الحِصَّة من الشيءِ؛ القِطْعَةُ: فقرة قصيرة عادة من مقالٍ أو كتاب)\nمثال: يصنع قطعة أثاث خشبية.",
 "spare time": "وقت الفراغ, وقت حر (الوقت الخالي من الواجبات أو المسؤوليات) / وقت حر, وقت فراغ (الوقت المتاح للهوايات والأنشطة الأخرى التي تستمتع بها)",
 "spare tire": "دهون الخصر, طوق دهني (الدهون الزائدة حول الخصر)",
 "spare tyre": "العَجَلَة الاحْتِيَاطِيَّة",
 "spare-time activity": "هواية (نشاط إضافي أو جانبي)",
 "spareness": "نحافة, هزال (خاصية وجود القليل من دهون الجسم) / تشتت, قلة كثافة (خاصية كون الشيء شحيحاً أو مبعثراً؛ الافتقار إلى الكثافة)",
 "sparer": "صافح, عافٍ (شخص يمتنع عن الإيذاء أو التدمير)",
 "sparerib": "ضلع مشذب (قطعة من ضلوع الخنزير مع إزالة معظم اللحم منها)",
 "spareribs": "ضلوع خنزير (قطعة من الخنزير من منطقة الضلوع مع إزالة معظم اللحم) / أضلاع مشوية (مخبوزة أو مشوية مع صلصة حارة)",
 "sparge": "رش, نثر (فعل رش أو طرطشة الماء)",
 "sparge pipe": "أنبوب رش (أنبوب أفقي به ثقوب دقيقة محفورة على طوله لتوصيل رذاذ من الماء)",
 "sparid": "أسبورية (أسماك غذائية شائكة الزعانف تعيش في المياه الدافئة ولها أسنان متطورة)",
 "sparid fish": "أسبورية (أسماك غذائية شائكة الزعانف تعيش في المياه الدافئة ولها أسنان متطورة)",
 "sparing": "زَاهِد, مُقْتَصِد (يَتَجَنَّبُ الإِسْرَافَ وَالهَدْر)",
 "sparingly": "بشح, بضآلة (لدرجة ضئيلة أو بطريقة شحيحة)\nمثال: هذه الأصوات ممثلة بقلة في المؤتمر",
 "spark": "شَرَارَة",
 "spark advance": "تقديم الشرارة, سبق الإشعال (توقيت الإشعال بالنسبة لموضع المكبس في محرك الاحتراق الداخلي)",
 "spark arrester": "مانع الشرر (شبكة سلكية لمنع الشرر من مدفأة مفتوحة أو مدخنة) / مانع الشرر (جهاز كهربائي لتقليل الشرر عند فتح أو إغلاق نقاط التلامس الكهربائية)",
 "spark chamber": "عداد الشرارة, غرفة الشرارة (جهاز يكشف الإشعاع المؤين من الجسيمات الأولية)",
 "spark coil": "ملف الشرارة (ملف حث يستخدم لتوليد الشرر)",
 "spark counter": "عداد الشرارة, غرفة الشرارة (جهاز يكشف الإشعاع المؤين من الجسيمات الأولية)",
 "spark gap": "فجوة الشرارة (الفجوة بين طرفين عاليي الجهد) / فجوة الشرارة (مكون في نظام الإشعال؛ يتكون من قطبين كهربائيين والمساحة بينهما)",
 "spark lever": "ذراع الشرارة ((في السيارات القديمة) رافعة مثبتة على عمود التوجيه وتستخدم لضبط توقيت الإشعال)",
 "spark plug": "بوجيه, شمعة احتراق (جهاز كهربائي يركب في رأس أسطوانة محرك الاحتراق الداخلي ويشعل الغاز بواسطة شرارة كهربائية)",
 "spark transmitter": "جهاز إرسال بالشرارة (جهاز إرسال راديوي مبكر يستخدم التفريغ عبر فجوة شرارة كمصدر للطاقة)",
 "sparker": "مانع الشرر (شبكة سلكية لمنع الشرر من مدفأة مفتوحة أو مدخنة)",
 "sparking plug": "بوجيه, شمعة احتراق (جهاز كهربائي يركب في رأس أسطوانة محرك الاحتراق الداخلي ويشعل الغاز بواسطة شرارة كهربائية)",
 "sparkle": "بريق, تألق (صفة اللمعان بضوء منعكس ساطع) / بريق, لمعان (المرح المعبر عنه ببريق أو لمعان أو حيوية في الوجه) / تألق, تلألؤ (حدوث وميض صغير أو شرارة)\nمثال: كان في عينيه بريق",
 "sparkle metal": "مات نحاسي غني (مات يحتوي على 74 في المائة من النحاس)",
 "sparkleberry": "عنب الأحراش الشجري (شجيرة أو شجرة صغيرة من شرق الولايات المتحدة لها توت أسود غير صالح للأكل)",
 "sparkler": "سلك شرار, شمعة شرارة (لعبة نارية تحترق ببطء وتطلق وابلًا من الشرر) / ألماس (قطع الألماس (مصطلح عامي))\nمثال: انظر إلى الألماس الذي ترتديه تلك السيدة!",
 "sparkling": "غازي, فوار (يُستخدم للنبيذ والمياه؛ مشحون طبيعياً أو صناعياً بثاني أكسيد الكربون) / بَرَّاق, مُتَأَلِّق (يلمع بنقاط ضوء ساطعة كالنجوم) / تلألؤ, وميض (تغير سريع في السطوع؛ شرارة قصيرة أو وميض)\nمثال: نبيذ فوار",
 "sparkling water": "صودا, مياه غازية (مشروب فوار مشبع صناعياً بثاني أكسيد الكربون)",
 "sparkling wine": "نبيذ فوار (نبيذ ذو فوران غازي)",
 "sparkly": "بَرَّاق, مُتَلَأْلِئ (ذُو وَمَضَاتٍ قَصِيرَةٍ وبَرَّاقَة مِنَ الضَّوْء) / فَوَّار, مُتَأَلِّق (يتميّز بروح عالية أو حماسة متّقدة)",
 "sparkplug wrench": "مفتاح بوجيهات, مفتاح شمعات الاحتراق (مفتاح لإزالة أو شد شمعات الإشعال في رأس الأسطوانة لمحرك الاحتراق الداخلي)",
 "sparling": "هف أوروبي (الهف الشائع في أوروبا)",
 "sparmannia africana": "قنب أفريقي (شجيرة كبيرة من جنوب أفريقيا ذات فروع عديدة مشعرة بوضوح بأوراق مشعرة كبيرة وعناقيد من الزهور البيضاء البارزة)",
 "sparring": "ملاكمة تدريبية, مناوشة (القيام بحركات الهجوم والدفاع بالقبضات والأذرع؛ جزء من تدريب الملاكم) / سجال, مناوشة كلامية (جدال يحاول فيه المشاركون الحصول على ميزة ما)",
 "sparring match": "نزال تدريبي (مباراة ملاكمة للتدريب أو الاستعراض)",
 "sparring mate": "شريك تدريب (ملاكم يتدرب معه ملاكم آخر استعداداً لنزال مهم)",
 "sparring partner": "شريك تدريب (ملاكم يتدرب معه ملاكم آخر استعداداً لنزال مهم)",
 "sparrow": "عَصْفُور, عُصْفُور / عَصْفُور",
 "sparrow hawk": "باشق (صقر صغير من أوراسيا وشمال أفريقيا) / عوسق أمريكي (صقر صغير من أمريكا الشمالية)",
 "sparrow unit": "وحدة العصافير (فرقة اغتيال تابعة لجيش الشعب الجديد في الفلبين)",
 "sparrow-sized": "بِحَجْمِ الْعُصْفُورِ (بحجم عصفور تقريبًا)",
 "sparse": "ضَئِيل",
 "sparsely": "بشكل متناثر, بكثافة قليلة (بطريقة متفرقة وغير كثيفة)\nمثال: مأهولة بشكل متناثر",
 "sparseness": "تشتت, قلة كثافة (خاصية كون الشيء شحيحاً أو مبعثراً؛ الافتقار إلى الكثافة)",
 "sparsity": "تشتت, قلة كثافة (خاصية كون الشيء شحيحاً أو مبعثراً؛ الافتقار إلى الكثافة)",
 "sparta": "إِسْبَرْطَة",
 "spartacus": "سبارتاكوس",
 "spartan": "زَاهِد, مُتَقَشِّف (يُمارِس حرمانًا ذاتيًّا شديدًا) / إسْبَرْطِيّ, شَدِيد (لا يرحم ولا يتهاون في الانضباط أو الحكم) / إِسْبَرْطِيّ, صَبُورٌ (صامد في وجه الألم أو الخطر أو المحن) / إسبرطي (من أو يتعلق بإسبرطة أو شعبها أو يميزهم)",
 "spartina cynosuroides": "عشبة القصب المالحة (عشبة طويلة تشبه القصب شائعة في المروج المالحة)",
 "spartina pectinata": "عشبة الحبل البراري, عشبة الحبل للمياه العذبة (عشبة حبل أمريكية شمالية ذات أوراق بحواف غشائية جافة وقنابات بسفا طويل)",
 "spartium junceum": "سبارتيوم, وزال إسباني (شجيرة طويلة خالية من الأشواك لها زهور صفراء شاحبة وأغصان مرنة تشبه الأسل تستخدم في صناعة السلال؛ من جنوب غرب أوروبا والبحر الأبيض المتوسط؛ متوطنة في…)",
 "spasm": "تَشَنُّج",
 "spasmodic": "تَشَنُّجِيّ, نَوْبِيّ (يَحْدُثُ عَلَى شَكْلِ نَوْبَاتٍ وَغَالِبًا بِشَكْلٍ مُفَاجِئ) / تَشَنُّجِيّ, تَقَلُّصِيّ (يتأثر بتقلصات عضلية لاإرادية مفاجئة؛ يشبه التشنج)",
 "spasmodic laryngitis": "التهاب الحنجرة التشنجي, الخانوق (مرض يصيب الرضع والأطفال الصغار؛ سعال حاد وبحة في الصوت وحمى وصعوبة في التنفس)",
 "spasmodically": "بشكل متقطع (في نوبات متقطعة) / بتشنج, بحركات ارتعاشية (مع تشنجات)\nمثال: بدأت أكتب بشكل متقطع وغير منتظم",
 "spasmolysis": "حَل التشنج (استرخاء أو تخفيف تشنجات العضلات)",
 "spasmolytic": "حال للتشنج, مضاد للتشنج (دواء يستخدم لتخفيف أو منع التشنجات (خاصة العضلات الملساء))",
 "spastic": "تَشَنُّجِيّ, تَقَلُّصِيّ (يتأثر بتقلصات عضلية لاإرادية مفاجئة؛ يشبه التشنج) / تَشَنُّجِيّ (يعاني من الشلل التشنّجيّ) / تشنجي (متعلق بـ أو يتميز بالتشنج) / مصاب بالتشنج (شخص يعاني من شلل تشنجي)\nمثال: قولون تشنجي",
 "spastic abasia": "عدم القدرة على المشي التشنجي (عدم القدرة على المشي بسبب التقلصات التشنجية لعضلات الساق)",
 "spastic bladder": "المثانة التشنجية (اضطراب في المثانة البولية ناتج عن آفة في الحبل الشوكي أو التصلب المتعدد أو صدمة؛ يتميز بغياب الإحساس بالمثانة وسلس البول وإفراغ البول المتقطع)",
 "spastic colon": "القولون التشنجي, متلازمة القولون العصبي (ألم بطني متكرر وإسهال (غالباً ما يتناوب مع فترات من الإمساك)؛ يرتبط غالباً بالضغط النفسي)",
 "spastic paralysis": "شلل تشنجي, شلل دماغي (فقدان أو نقص في التحكم الحركي مع تشنجات لا إرادية ناتجة عن تلف دائم في الدماغ موجود عند الولادة)",
 "spasticity": "تَشَنُّجِيَّة (صفة التحرك أو التصرف في تشنجات)",
 "spat": "محار صغير, يرقات المحار (محار صغير أو ذوات الصدفتين الأخرى) / سبات, غطاء حذاء (غطاء قماشي يغطي مشط القدم والكاحلين) / مشاجرة تافهة, ملاحاة (شجار حول نقاط تافهة)",
 "spatchcock": "دجاج مشقوق الظهر, دجاجة مسطحة (لحم دجاجة (أو طائر صيد) مشقوقة من الظهر ومشوية (عادة فور ذبحها))",
 "spate": "سيل, فيضان (حدوث تدفق للمياه ناتج عن مطر مفاجئ أو ذوبان الثلوج) / اندفاع, فورة (تدفق قوي مفاجئ) / الكثير, دفعة (عدد كبير أو كمية أو مدى كبير (وغالباً ما تتبعها كلمة 'من'))\nمثال: دفعة من الرسائل",
 "spathe": "إِغْرِيض, قِنَّابَة إِغْرِيضِيَّة (قنابة بارزة تحيط أو تكتنف طلعاً أو نورة زهرية أخرى)",
 "spathe flower": "زنبق السلام, سباثيفيليوم (أي من النباتات المتنوعة من جنس سباثيفيليوم لها قنابة بيضاء أو خضراء وسنبلة من الزهور العطرة وتزرع غالباً للزينة)",
 "spathiphyllum": "زنبق السلام, سباثيفيليوم (أي من النباتات المتنوعة من جنس سباثيفيليوم لها قنابة بيضاء أو خضراء وسنبلة من الزهور العطرة وتزرع غالباً للزينة)",
 "spatial": "فَضَائِيّ",
 "spatial arrangement": "تَبَاعُد, تَوْزِيع مَكَانِيّ (الخاصية التي تمتلكها مجموعة من الأشياء التي توجد مسافة بينها)",
 "spatial property": "حيزية, خاصية مكانية (أي خاصية تتعلق بالمكان أو شغله)",
 "spatial relation": "عَلاقَة مَكَانِيَّة, مَوْضِع (الخاصية المكانية لمكان أو طريقة توجد بها الأشياء)\nمثال: موضع العقارب على الساعة",
 "spatialism": "المكانية (حركة فنية أسسها الفنان الإيطالي لوتشيو فونتانا في ميلانو عام 1947 وكان ينوي فيها توليف اللون والصوت والمساحة والحركة والوقت في نوع جديد من الفن)\nمثال: في الأصل كان فناناً تصويرياً مثل العديد من التجريبيين، وقد تأثر بالمكانية لفونتانا",
 "spatiality": "حيزية, خاصية مكانية (أي خاصية تتعلق بالمكان أو شغله)",
 "spatially": "مكانياً (فيما يتعلق بالمكان)\nمثال: محدود مكانياً",
 "spationaut": "سبَشُنَات",
 "spatiotemporal": "زَمَكَانِيّ (موجود في المكان والزمان معًا؛ له امتداد مكانيّ وديمومة زمنيّة) / مكاني زماني (مكون من أو متعلق بالمكان والزمان معاً)\nمثال: ترافق مكاني زماني",
 "spatter": "ترشيش, طرطشة",
 "spatterdock": "زنبق البرك الأصفر, زنبق البقر (زنبق ماء شائع في شرق ووسط أمريكا الشمالية، ذو أوراق عريضة وأزهار صفراء كروية الشكل؛ يعيش في المياه العذبة الراكدة أو قليلة الملوحة)",
 "spattered": "مُبَقَّع, مُرَشَّش (مغطى ببقع زاهية؛ يُستخدم غالباً في التركيب)",
 "spattering": "رش, طرطشة (فعل رش مادة (سائلة) على سطح) / تطاير, طرطشة (ضجيج شيء يتناثر أو يطرطش بشكل انفجاري)\nمثال: سمع طرطشة نيران",
 "spatula": "مِلْعَقَةُ الصَيْدَلِيِّ, محراك (أداة للأكل والاحتساء والطبخ وتقديم الطعام)",
 "spatula clypeata": "أبو مجرفة, كيش (بط مياه عذبة من نصف الكرة الشمالي له منقار عريض مسطح)",
 "spatula discors": "حذف أزرق الجناح (بط صغير أمريكي)",
 "spatula querquedula": "شرشير صيفي (بط صغير أوراسي)",
 "spatula-shaped": "مِلْوَقِيّ الشَّكْل ((عن شكل الورقة) ذو قمّة عريضة مُستديرة وقاعدة ضيّقة)",
 "spatulate": "مِلْوَقِيّ الشَّكْل ((عن شكل الورقة) ذو قمّة عريضة مُستديرة وقاعدة ضيّقة)",
 "spatulate leaf": "ورقة ملعقية (ورقة على شكل ملعقة؛ لها قمة مستديرة عريضة وقاعدة ضيقة)",
 "spavin": "جرذ ((جَرَذَت) القرحة جرذا: تعقدت كالجُرَذِ)\nمثال: عبر جرذ الطريق.",
 "spavined": "مُصَابٌ بِدَاءِ العُرْقُوب ((عَنِ الخَيْلِ) مُصَابٌ بِوَرَمٍ فِي مَفْصِلِ العُرْقُوبِ)",
 "spawl": "شَظِيَّة صخرية, كِسْرَة حجر (شظية مكسورة من حافة أو سطح حجر أو خام ولها حافة رفيعة واحدة على الأقل)\nمثال: شاحنة تحمل كومة من شظايا الحجر الأزرق",
 "spawn": "بيض السمك, سرء (كتلة البيض التي تضعها الأسماك أو البرمائيات أو الرخويات)",
 "spawner": "سمكة بياضة (أنثى السمك في وقت وضع البيض)",
 "spayed": "مَنْزُوعَة المَبَايِض, مُعَقَّمَة ((عن أنثى الحيوان) أُزيلت مبايضها)",
 "spaying": "استئصال المبيض (تعقيم أنثى الحيوان عن طريق إزالة المبيضين)",
 "speak": "تَحَدَّثَ, تَكَلَّمَ (كَلَّمَ، حَدَّثَ، تَكَلَّمَ)\nمثال: يمكنكما التحدث.",
 "speakable": "قَابِل لِلنُّطْق, يُمْكِن التَّلَفُّظ بِه (يمكن التعبير عنه بالكلمات أو الجمل)",
 "speakeasy": "حانة غير قانونية ((أثناء فترة الحظر) حانة غير قانونية)",
 "speaker": "خَطِيب, مُتَكَلِّم / سَمَاعَة",
 "speaker identification": "تحديد هوية المتحدث (التعرف على شخص من خلال صوت كلامه)",
 "speaker system": "مكبر صوت (محول كهروصوتي يحول الإشارات الكهربائية إلى أصوات عالية بما يكفي لسماعها من مسافة بعيدة)",
 "speaker unit": "مكبر صوت (محول كهروصوتي يحول الإشارات الكهربائية إلى أصوات عالية بما يكفي لسماعها من مسافة بعيدة)",
 "speakeress": "خَطِيبَة, مُتَكَلِّمَة",
 "speakerphone": "مكبر صوت الهاتف, هاتف بمكبر صوت (هاتف مزود بميكروفون ومكبر صوت؛ يمكن استخدامه دون رفع سماعة اليد؛ يمكن لعدة أشخاص المشاركة في المكالمة في نفس الوقت)",
 "speakership": "رئاسة المجلس (منصب رئيس المجلس (مثل البرلمان))",
 "speaking": "كَلَام, تَكَلُّم",
 "speaking of": "على فِكْرَةٍ (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال.",
 "speaking trumpet": "بوق تحدث (جهاز صوتي على شكل بوق لتكثيف وتوجيه الصوت البشري؛ كان يوضع سابقاً على أذن الشخص ضعيف السمع)",
 "speaking tube": "أنبوب التحدث (أنبوب لنقل صوت الكلام من غرفة إلى أخرى)",
 "spear": "رُمْح, حَرْبَة (عُود طَوِيلٌ فِي رَأْسِهِ حَرْبَة يُطعَن بِهَا الْعَدُوُّ، يُجمع جَمْع تَكْسِير على رِمَاح؛ الْفَقْرُ وَالْفَاقَةُ. اسْتِخْدَامٌ قَدِيمٌ)\nمثال: راس الرمح كان مغموسا في سم قاتل.",
 "spear carrier": "كومبارس, ممثل إضافي (ممثل ثانوي يظهر في مشاهد الحشود)",
 "spear thistle": "شوك رمحي, شوك شائك (شوك أوروبي ذو رؤوس كبيرة نوعاً ما وأوراق شائكة؛ توطن على نطاق واسع كعشب ضار في الولايات المتحدة)",
 "spear thrower": "عصا رمي, قاذفة رماح (جهاز يشبه المقلاع يستخدم في مجتمعات بدائية مختلفة لدفع سهم أو رمح)",
 "spear-point": "رأس الحربة (الرأس والطرف المشحوذ للرمح)",
 "spearfish": "سمكة الرمح (أي من عدة أسماك بحرية كبيرة قوية تشبه أسماك الشراع ولكن بزعنفة ظهرية أولى أصغر بكثير؛ عالمية ولكنها نادرة)",
 "spearhead": "رأس حربة (عُضْو مِنَ ٱلْجَسَدِ يَحْوِي الدِّمَاغ والفَم والأَنْف والعَيْنَيْن والأُذُنَيْن؛ أَعْلَى ٱلشَّيْءِ)\nمثال: قطع سامي رأس كلب.",
 "spearhead-shaped": "حَرْبِيّ الشَّكْل ((عن شكل الورقة) كرأس الحربة مع فصوص قاعديّة بارزة مُدبَّبة)",
 "spearman": "رَمَّاح (جمع للاسم رُمْح)",
 "spearmint": "نَعْنَاع مُدَبَّب",
 "spearmint oil": "زيت النعناع السنبلي (زيت عطري يتم الحصول عليه من نبات النعناع السنبلي)",
 "spearnose bat": "خفاش رمحي الأنف (خفاش من العالم الجديد ذو ورقة أنفية مدببة؛ يوجد من جنوب الولايات المتحدة إلى باراغواي)",
 "spearpoint": "رأس الحربة (الرأس والطرف المشحوذ للرمح)",
 "spec": "تحديد المواصفات, مواصفة (وصف تفصيلي لمعايير تصميم عمل ما)",
 "special": "خَاصّ, خُصُوصِيّ (قلَّ أو أصبح أقل؛ خَاصَ العَطَاءَ خَاصَ خَوْصًا: قلَّله)\nمثال: كل الخضار الخاص بك.",
