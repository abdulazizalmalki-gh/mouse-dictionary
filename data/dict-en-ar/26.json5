 "sphygmomanometer": "مقياس ضغط الدم (مقياس ضغط لقياس ضغط الدم)",
 "sphyraena barracuda": "باراكودا كبيرة (باراكودا رمادية بنية كبيرة (تصل إلى 6 أقدام) تحظى بتقدير كبير كسمكة غذائية ورياضية؛ قد تكون خطرة على السباحين)",
 "sphyrapicus varius": "نقار الخشب مصاص العصارة أصفر البطن (نقار خشب مصاص للعصارة من شرق أمريكا الشمالية ذو بطن أصفر شاحب)",
 "sphyrapicus varius ruber": "نقار الخشب مصاص العصارة أحمر الصدر (نقار خشب مصاص للعصارة من غرب أمريكا الشمالية)",
 "sphyrna tiburo": "قرش القلنسوة (قرش مطرقة صغير غير ضار ذو رأس يشبه المجرفة؛ وفير في الخلجان ومصبات الأنهار)",
 "sphyrna tudes": "قرش المطرقة صغير العين (يتم صيده من أجل جلده وكبده الغني بالفيتامينات)",
 "sphyrna zygaena": "قرش المطرقة الأملس (يتم صيده من أجل جلوده وكبده الغني بالفيتامينات)",
 "spic": "بِلَا شَائِبَة, نَاصِع (بالغ النظافة وخالٍ من أيّ بقعة أو لطخة) / سبيك ((افتراء عرقي) مصطلح مهين للأشخاص من أصل أمريكي لاتيني)",
 "spic-and-span": "بِلَا شَائِبَة, نَاصِع (بالغ النظافة وخالٍ من أيّ بقعة أو لطخة) / جَدِيد تَمَامًا, لَامِع (جديد بشكل لافت للنظر)",
 "spicate": "سنبلي (لديه أو متعلق بالسنابل)\nمثال: نورة سنبلية",
 "spiccato": "سبيكاتو (استخدام القوس بطريقة تجعل القوس يرتد بخفة عن الأوتار)",
 "spiccato bowing": "سبيكاتو (استخدام القوس بطريقة تجعل القوس يرتد بخفة عن الأوتار)",
 "spice": "بَهَار, تَوَابِل",
 "spice bush": "شجيرة البنزوين, شجيرة التوابل (شجيرة نفضية في شرق الولايات المتحدة ذات أوراق ولحاء عطري للغاية وأزهار صفراء تليها توت قرمزي أو أصفر)",
 "spice cake": "كعكة التوابل (كعكة منكهة بالتوابل)",
 "spice cookie": "بسكويت التوابل (بسكويت منكه بالتوابل)",
 "spice mill": "طاحونة توابل (طاحونة لطحن التوابل)",
 "spice rack": "رف التوابل (رف لعرض الحاويات المملوءة بالتوابل)",
 "spice tree": "آس أوريغون, غار كاليفورنيا (شجرة ساحل المحيط الهادئ ذات أوراق عطرية وزهور خيمية صغيرة تليها ثمار تشبه الزيتون؛ تنتج خشباً صلباً متيناً) / شجرة التوابل (شجرة تحمل لحاء أو ثماراً عطرية)",
 "spice-scented": "بِرَائِحَةِ التَّوَابِل (ذُو رَائِحَة التَّوَابِل)",
 "spiceberry": "عنب الأرض, وينترغرين (فاكهة حمراء حارة تشبه التوت؛ مصدر لزيت وينترغرين) / توت التوابل, توت المرجان (شجيرة ذات توت أحمر مرجاني؛ اليابان إلى شمال الهند)",
 "spicebush": "بهار كاليفورنيا, شجيرة التوابل (شجيرة عطرية متناثرة من جنوب غرب الولايات المتحدة لها زهور بنية عطرة) / شجيرة البنزوين, شجيرة التوابل (شجيرة نفضية في شرق الولايات المتحدة ذات أوراق ولحاء عطري للغاية وأزهار صفراء تليها توت قرمزي أو أصفر)",
 "spiced": "مُتَبَّل",
 "spicemill": "طاحونة توابل (طاحونة لطحن التوابل)",
 "spicery": "تتبيل, حرارة (خاصية التتبيل بالتوابل وبالتالي كونه قوي النكهة)",
 "spicily": "بشكل حريف, بشكل لاذع (مع توابل قوية؛ بطريقة حريفة)\nمثال: كان الحساء منكهاً بشكل حريف",
 "spiciness": "بذاءة, فحش (سلوك أو لغة تقترب من الفجاجة) / تتبيل, حرارة (خاصية التتبيل بالتوابل وبالتالي كونه قوي النكهة)",
 "spick": "بِلَا شَائِبَة, نَاصِع (بالغ النظافة وخالٍ من أيّ بقعة أو لطخة) / سبيك ((افتراء عرقي) مصطلح مهين للأشخاص من أصل أمريكي لاتيني)",
 "spick-and-span": "جديد (مصنوع حديثا؛ لم يمر على حدوثه زمن طويل)\nمثال: هذا الكتاب جديد",
 "spicule": "شويكة (هيكل مدبب صغير يعمل كعنصر هيكلي في مختلف اللافقاريات البحرية والمياه العذبة مثل الإسفنج والمرجان)",
 "spiculum": "شويكة (هيكل مدبب صغير يعمل كعنصر هيكلي في مختلف اللافقاريات البحرية والمياه العذبة مثل الإسفنج والمرجان)",
 "spicy": "حَار, حَرَّاق (ساخن من نفسه بدون تسخين) / حِرِّيف, حَارّ\nمثال: الجو حار اليوم.",
 "spider": "عَنْكَبُوت, شَبَث",
 "spider angioma": "وحمة عنكبوتية, ورم وعائي عنكبوتي (توسع في الشعيرات الدموية السطحية مع نقطة حمراء مركزية تشع منها الأوعية الدموية)",
 "spider brake": "تيريس متعدد, سرخس العنكبوت (سرخس آسيوي تم إدخاله إلى أمريكا)",
 "spider crab": "سرطان العنكبوت (أي من السرطانات العديدة ذات الأرجل الطويلة جداً والأجسام المثلثة الصغيرة)",
 "spider fern": "تيريس متعدد, سرخس العنكبوت (سرخس آسيوي تم إدخاله إلى أمريكا) / سرخس الشريط, سرخس العنكبوت (سرخس من شمال إفريقيا وجزر الأزور وجزر الكناري)",
 "spider flower": "زهرة العنكبوت (موطنها أمريكا الجنوبية ولكنها متوطنة في الأجزاء الدافئة من الولايات المتحدة؛ تزرع لأزهارها طويلة الأمد التي تشبه العنكبوت بيضاء إلى وردية أرجوانية)",
 "spider mite": "سوس عنكبوتي (سوس غازل للشبك يهاجم نباتات الحدائق وأشجار الفاكهة)",
 "spider monkey": "سَعْدَان عَنْكَبُوتِيّ, آتِل",
 "spider nevus": "وحمة عنكبوتية, ورم وعائي عنكبوتي (توسع في الشعيرات الدموية السطحية مع نقطة حمراء مركزية تشع منها الأوعية الدموية)",
 "spider orchid": "أوركيد العنكبوت, براسيا لورانس (أوركيد أمريكي جنوبي بزهور صفراء شاحبة إلى خضراء شاحبة تشبه العنكبوت) / أوركيد العنكبوت, براسيا ثؤلولية (أوركيد أمريكي أوسط ذو زهور تشبه العنكبوت بثآليل خضراء بارزة) / أوركيد العنكبوت (أي من عدة بساتين فاكهة أوروبية من جنس أوفريس)",
 "spider plant": "زهرة العنكبوت (موطنها أمريكا الجنوبية ولكنها متوطنة في الأجزاء الدافئة من الولايات المتحدة؛ تزرع لأزهارها طويلة الأمد التي تشبه العنكبوت بيضاء إلى وردية أرجوانية)",
 "spider web": "شبكة عنكبوت, نسيج عنكبوت (شبكة تغزلها العناكب لاصطياد الفرائس من الحشرات) / شبكة عنكبوت (شبكة تشبه الشبكات التي تغزلها العناكب)",
 "spider's web": "شبكة عنكبوت, نسيج عنكبوت (شبكة تغزلها العناكب لاصطياد الفرائس من الحشرات) / شبكة عنكبوت (شبكة تشبه الشبكات التي تغزلها العناكب)",
 "spider-shaped": "عَنْكَبُوتِيّ الشَّكْل (على شكل عنكبوت)",
 "spiderflower": "زهرة العنكبوت, كليومي (أي من النباتات المتنوعة غالباً قوية الرائحة من جنس الكليومي ذات أزهار مبهرجة تشبه العنكبوت)",
 "spiderlike": "عنكبوتي (يتعلق بـ أو يشبه عضواً من فئة العناكب)",
 "spiderly": "عنكبوتي (يتعلق بـ أو يشبه عضواً من فئة العناكب)",
 "spiderweb": "بَيْت الْعَنْكَبُوت, نَسِيج الْعَنْكَبُوت (بمعنى قضى الليل؛ الخَيْمَة من الشَعْر يَبِيت فيها البَدَوي أو المُسافر. الجمع بُيُوت)\nمثال: لنعد إلى البيت.",
 "spiderwort": "زهرة النهار, عشبة العنكبوت",
 "spidery": "عنكبوتي (يتعلق بـ أو يشبه عضواً من فئة العناكب)",
 "spiegel": "حديد مرآتي, شبيغل آيزن (حديد غفل يحتوي على المنجنيز؛ يستخدم كعامل مزيل للأكسدة ولزيادة محتوى المنجنيز في صنع الصلب)",
 "spiegel iron": "حديد مرآتي, شبيغل آيزن (حديد غفل يحتوي على المنجنيز؛ يستخدم كعامل مزيل للأكسدة ولزيادة محتوى المنجنيز في صنع الصلب)",
 "spiegeleisen": "حديد مرآتي, شبيغل آيزن (حديد غفل يحتوي على المنجنيز؛ يستخدم كعامل مزيل للأكسدة ولزيادة محتوى المنجنيز في صنع الصلب)",
 "spiel": "حديث منمق, كلام معسول (كلام سلس ومقنع (مفيد خاصة للبائع))",
 "spielmeyer-vogt disease": "مرض شبيلمير-فوغت (اضطراب خلقي تدريجي في استقلاب الدهون)",
 "spiff": "أناقة, هندام (الجاذبية في المظهر أو اللباس أو الأسلوب)\nمثال: إنه يتدبر أموره بفضل أناقته البحتة",
 "spiffed up": "بِأَبْهَى حُلَّة, مُتَأَنِّق (يرتدي ملابس أنيقة أو رسمية)",
 "spiffing": "بَدِيع, رَائِع (ممتاز أو فاخر)",
 "spiffy": "أَنِيق, مُتَأَلِّق (يَتَمَيَّز بِمُوَاكَبَة العَصْر فِي المَلْبَس وَالسُّلُوك)",
 "spigot": "حنفية, صنبور (منظم للتحكم في تدفق السائل من خزان) / سدادة حنفية, صنبور (سدادة لفتحة البرميل في برميل خشبي)",
 "spik": "سبيك ((افتراء عرقي) مصطلح مهين للأشخاص من أصل أمريكي لاتيني)",
 "spike": "سنبلة",
 "spike arrester": "مانع اندفاع التيار, واقي من الارتفاع المفاجئ (جهاز كهربائي يدرج في خط الطاقة لحماية المعدات من التقلبات المفاجئة في التيار)",
 "spike heath": "خلنج السنابل (شجيرة صغيرة دائمة الخضرة تشكل حصيرة من جنوب أوروبا وآسيا الصغرى لها سيقان صلبة وعناقيد طرفية من زهور جرسية صغيرة)",
 "spike heel": "كعب خنجري, كعب عالٍ (كعب ضيق وعالٍ جداً في أحذية النساء)",
 "spike lavender": "خزامى سنبلية, ضرم عريض الأوراق (نبات متوسطي ذو زهور أرجوانية شاحبة ينتج زيت الخزامى السنبلي)",
 "spike lavender oil": "زيت الخزامى (زيت عطري أصفر شاحب يُستخرج من الخزامى ويُستخدم في تعطير الصابون ومستحضرات التجميل)",
 "spike microphone": "ميكروفون مسماري (ميكروفون تلامسي للاستماع عبر الجدران)",
 "spike mike": "ميكروفون مسماري (ميكروفون تلامسي للاستماع عبر الجدران)",
 "spike moss": "سيلاجينيلا, طحلب سنبلي (أي من حلفاء السراخس العديدة من جنس سيلاجينيلا)",
 "spike oil": "زيت الخزامى (زيت عطري أصفر شاحب يُستخرج من الخزامى ويُستخدم في تعطير الصابون ومستحضرات التجميل)",
 "spike rush": "أسل شائك, إليوكاريس (سعد من جنس إليوكاريس)",
 "spike suppressor": "مانع اندفاع التيار, واقي من الارتفاع المفاجئ (جهاز كهربائي يدرج في خط الطاقة لحماية المعدات من التقلبات المفاجئة في التيار)",
 "spiked": "ذُو شَوْكَة طَوِيلَة, مُسَمَّر (له رأس حاد وطويل كالمسمار)",
 "spiked loosestrife": "حناء دجال, ليثروم صفصافي (عشب مستنقعات ذو سنبلة طويلة من الزهور الأرجوانية؛ أصله من أوروبا ولكنه ينتشر الآن بكثرة في شرق الولايات المتحدة)",
 "spikelike": "شَبِيه بِالسِّنْبُلَة (يشبه السنبلة أو المسمار في الشكل)",
 "spikemoss": "سيلاجينيلا, طحلب سنبلي (أي من حلفاء السراخس العديدة من جنس سيلاجينيلا)",
 "spikenard": "ناردين (مرهم عطري كان يستخدم في العصور القديمة)",
 "spiky": "حَادّ الذُّرْوَة, مُدَبَّب النَّبْرَة (ذو نقاط عالية النبرة بشكل خاصّ أو كأنَّه كذلك)",
 "spile": "سدادة برميل (سدادة تستخدم لإغلاق ثقب في برميل أو قارورة) / ركيزة, وتد (عمود من الخشب أو الفولاذ أو الخرسانة يتم دقه في الأرض لتوفير الدعم لهيكل ما)",
 "spill": "دَلَقَ, أَرَاقَ (صب وأراق؛ خرج سريعًا)",
 "spillage": "انسكاب, تسرب (فعل السماح لسائل بالتسرب) / المنسكب, انسكاب (الكمية التي انسكبت)",
 "spiller": "خيط الشباك, خيط الصيد بالجر (خيط صيد طويل ترتبط به العديد من الخيوط القصيرة والخطافات (عادة ما يكون معلقاً بين عوامات)) / سافك الدماء (مهاجم يسفك الدم)\nمثال: صياد عظيم وسافك للدماء",
 "spillikin": "عود اللعب (شريط رفيع من الخشب يستخدم في لعبة \"جاك سترو\")",
 "spillikins": "جاك ستروز, لعبة التقاط القش (لعبة يحاول فيها اللاعبون التقاط قشة (أو عود) من كومة دون تحريك أي من القشات الأخرى)",
 "spillover": "تأثير الامتداد, تداعيات ((في الاقتصاد) أي تأثير غير مباشر للإنفاق العام)",
 "spillway": "مجرى الفائض, مفيض (قناة تحمل المياه الزائدة فوق السد أو حوله أو حول أي عائق آخر)",
 "spilogale putorius": "ظربان مرقط (ظربان صغير ذو معطف رخامي أسود وأبيض؛ من الولايات المتحدة والمكسيك)",
 "spin": "رَدَنَ, غَزَلَ (رَدَنَ رَدْنًا: غزل الرَّدَن أو غزل بالمِردَن؛ ويقال: رَدَنَ الثوبَ: نسجه بالغزل المردون)",
 "spin doctor": "خَبِير تَلْمِيع إِعْلَامِيّ (مسؤول علاقات عامة يحاول استباق الدعاية السلبية بنشر تفسير إيجابي لكلمات أو أفعال شركة أو حزب سياسي أو شخص مشهور)\nمثال: لقبه مدير اتصالات ولكنه مجرد خبير تلميع إعلامي",
 "spin drier": "مجفف طرد مركزي, نشافة طرد مركزي (مجفف ملابس يستخدم حركة الطرد المركزي لتجفيف الملابس الموضوعة بداخله)",
 "spin dryer": "مجفف طرد مركزي, نشافة طرد مركزي (مجفف ملابس يستخدم حركة الطرد المركزي لتجفيف الملابس الموضوعة بداخله)",
 "spin the bottle": "لعبة الزجاجة, لف الزجاجة (لعبة يقوم فيها لاعب بلف زجاجة ويقبل الشخص الذي تشير إليه عندما تتوقف عن الدوران)",
 "spin the plate": "تدوير الصحن (لعبة يتم فيها تدوير شيء مستدير (مثل الصحن) على حافته ويتم مناداة اسم لاعب؛ يجب على اللاعب المذكور الإمساك بالشيء الدوار قبل أن يسقط أو يدفع غرامة)",
 "spin the platter": "تدوير الصحن (لعبة يتم فيها تدوير شيء مستدير (مثل الصحن) على حافته ويتم مناداة اسم لاعب؛ يجب على اللاعب المذكور الإمساك بالشيء الدوار قبل أن يسقط أو يدفع غرامة)",
 "spin-off": "منتج ثانوي (منتج تم صنعه أثناء تصنيع شيء آخر)",
 "spina bifida": "السنسنة المشقوقة, الصلب المشقوق (عيب خلقي غير نادر تتشوه فيه فقرة؛ ما لم تتأثر عدة فقرات أو يكون هناك قيلة نخاعية سحائية، تكون الأعراض قليلة؛ يمكن تشخيصه عن طريق بزل السلى)",
 "spinach": "سَبَانِخ, إِسْفَانَاخ",
 "spinach beet": "سلق, سلق سويسري (سيقان بيضاء طويلة عصارية ذات أوراق خضراء كبيرة) / سلق, سلق سويسري (شمندر يفتقر إلى الجذر المتضخم؛ يزرع كخضروات لأوراقه وسيقانه الصالحة للأكل)",
 "spinach blight": "لفحة السبانخ (مرض يصيب نباتات السبانخ)",
 "spinach mustard": "خردل السبانخ (نبات آسيوي يزرع لتاجه الجذري المنتفخ وأوراقه الصالحة للأكل)",
 "spinach plant": "سبانخ (نبات من جنوب غرب آسيا يزرع على نطاق واسع لأوراقه الخضراء الداكنة العصارية الصالحة للأكل)",
 "spinacia oleracea": "سبانخ (نبات من جنوب غرب آسيا يزرع على نطاق واسع لأوراقه الخضراء الداكنة العصارية الصالحة للأكل)",
 "spinal": "فِقْرِيّ / فِقَرِيّ",
 "spinal accessory": "عصب إضافي, عصب قحفي حادي عشر (ينشأ من مجموعتين من الجذور (قحفية وشوكية) تتحد لتشكل العصب)",
 "spinal anaesthesia": "تخدير شوكي, تخدير نصفي (تخدير النصف السفلي من الجسم؛ ناتج عن إصابة الحبل الشوكي أو عن طريق حقن مخدر تحت الغشاء العنكبوتي المحيط بالحبل الشوكي)",
 "spinal anaesthetic": "تخدير نصفي, مخدر نخاعي (مخدر يحقن في العمود الفقري)",
 "spinal anesthesia": "تخدير شوكي, تخدير نصفي (تخدير النصف السفلي من الجسم؛ ناتج عن إصابة الحبل الشوكي أو عن طريق حقن مخدر تحت الغشاء العنكبوتي المحيط بالحبل الشوكي)",
 "spinal anesthetic": "تخدير نصفي, مخدر نخاعي (مخدر يحقن في العمود الفقري)",
 "spinal canal": "قناة شوكية, قناة فقرية (القناة في الفقرات المتعاقبة التي يمر عبرها الحبل الشوكي)",
 "spinal column": "عمود شوكي, عمود فقري (سلسلة الفقرات التي تشكل محور الهيكل العظمي وتحمي الحبل الشوكي)\nمثال: تسبب السقوط في كسر ظهره",
 "spinal cord": "نُخَاع شَوْكِيّ",
 "spinal curvature": "انحناء العمود الفقري (انحناء غير طبيعي للعمود الفقري)",
 "spinal fluid": "سائل دماغي شوكي (سائل صاف ينتج في بطينات الدماغ؛ يملأ ويحمي التجاويف في الدماغ والحبل الشوكي)",
 "spinal fusion": "دمج الفقرات, دمج شوكي (تصحيح جزء غير مستقر من العمود الفقري عن طريق ضم فقرتين أو أكثر؛ يتم عادةً جراحياً ولكن يتم أحياناً عن طريق الشد أو التثبيت)",
 "spinal nerve": "عصب شوكي (أي من الأزواج الـ 31 من الأعصاب الخارجة من كل جانب من الحبل الشوكي (كل منها متصل بالحبل بواسطة جذرين: بطني وظهري))",
 "spinal nerve root": "جذر عصب شوكي (أحد جذري الأعصاب الشوكية)",
 "spinal nerve roots": "جذور الأعصاب الشوكية (أي من جذري الأعصاب الشوكية)",
 "spinal puncture": "بزل شوكي, بزل قطني (إزالة السوائل عن طريق البزل من الحيز تحت العنكبوتية في المنطقة القطنية من الحبل الشوكي لأغراض تشخيصية أو علاجية)",
 "spinal tap": "بزل شوكي, بزل قطني (إزالة السوائل عن طريق البزل من الحيز تحت العنكبوتية في المنطقة القطنية من الحبل الشوكي لأغراض تشخيصية أو علاجية)",
 "spinal vein": "وريد شوكي (أوردة تصرف الحبل الشوكي)",
 "spinally": "شوكياً, نخاعياً (في العمود الفقري)\nمثال: مُعطى نخاعياً",
 "spindle": "مِغْزَل",
 "spindle horn": "ساولا, ماعز الغابة (مخلوق يشبه البقرة بمعطف لامع كالحصان ورشاقة كالماعز وقرون طويلة كالظبي؛ يوصف بأنه بقرة تعيش حياة الماعز)",
 "spindle tree": "شجرة المغزل, غدب (نبات قائم على سَاق صلبة؛ مخطط له تفرعات)\nمثال: أنا تحت الشجرة.",
 "spindle-legged": "دَقِيق السَّاقَيْن (ذُو سَاقَيْن طَوِيلَتَيْن وَنَحِيلَتَيْن)",
 "spindle-shanked": "دَقِيق السَّاقَيْن (ذُو سَاقَيْن طَوِيلَتَيْن وَنَحِيلَتَيْن)",
 "spindle-shaped": "سِيجَارِيّ الشَّكْل, مِغْزَلِيّ (مستدق من كلا الطرفين)",
 "spindleberry": "شجرة المغزل, غدب (نبات قائم على سَاق صلبة؛ مخطط له تفرعات)\nمثال: أنا تحت الشجرة.",
 "spindleberry tree": "شجرة المغزل, غدب (نبات قائم على سَاق صلبة؛ مخطط له تفرعات)\nمثال: أنا تحت الشجرة.",
 "spindlelegs": "سيقان مغزلية (سيقان طويلة ونحيفة) / نحيل الساقين (شخص نحيف ذو ساقين طويلتين ونحيفتين)",
 "spindleshanks": "سيقان مغزلية (سيقان طويلة ونحيفة) / نحيل الساقين (شخص نحيف ذو ساقين طويلتين ونحيفتين)",
 "spindly": "مُمْتَدّ وَنَحِيل (طَوِيل وَنَحِيف كَالمِغْزَل)",
 "spindrift": "زبد البحر المتطاير (رذاذ متطاير من سطح البحر)",
 "spine": "عَمُود فَقْرِيّ",
 "spine-tipped": "ذُو طَرَفٍ شَوْكِيّ ((لِلنَّبَاتِ) ذُو طَرَفٍ يَنْتَهِي بِشَوْكَة)",
 "spinel": "لَعْل, إِسْبِينِل (يفيد التوقع مع الترجي؛ يفيد التوقع مع الإشفاق والخوف)\nمثال: لعل المجتهد ينجح.",
 "spinel ruby": "ياقوت إسبنيل (إسبنيل يستخدم كحجر كريم (عادة أحمر داكن))",
 "spineless": "عَدِيم الأَشْوَاك (خالٍ من الأشواك أو الإبر) / جَبَان, ضَعِيف الشَّخْصِيَّة (يفتقر إلى الشجاعة أو الحيوية) / أملس, غير شوكي (يفتقر إلى النتوءات الشوكية) / لافقاري (يفتقر إلى عمود فقري)\nمثال: كان دودة صفراء عديمة الشجاعة",
 "spinelessness": "خوار, ضعف شخصية (جودة الافتقار لشخصية قوية؛ طبع متردد)",
 "spinet": "سبينيت (نموذج مبكر من الهاربسيكورد بوتر واحد فقط لكل نغمة) / بيانو سبينيت (بيانو رأسي صغير ومدمج البناء)",
 "spininess": "شوكية, وخز (جودة التغطية بأشواك وخازة)",
 "spinmeister": "خَبِير تَلْمِيع إِعْلَامِيّ (مسؤول علاقات عامة يحاول استباق الدعاية السلبية بنشر تفسير إيجابي لكلمات أو أفعال شركة أو حزب سياسي أو شخص مشهور)\nمثال: لقبه مدير اتصالات ولكنه مجرد خبير تلميع إعلامي",
 "spinnability": "قابلية الغزل (صفة الصلاحية للغزل أو القدرة على أن تُغزل (تستخدم لألياف النسيج))",
 "spinnable": "قَابِلٌ لِلْغَزْل (يُمْكِنُ غَزْلُهُ وَتَحْوِيلُهُ إِلَى أَلْيَافٍ) / قَابِل لِلتَّضْلِيل (يمكن التأثير فيه بمعلومات متحيزة)",
 "spinnaker": "سبينكر, شراع بالوني (شراع مقدمة كبير ومثلث عادة؛ تحمله اليخوت كشراع مقدمة عند الإبحار مع الريح)",
 "spinnbar": "قَابِلٌ لِلْغَزْل (يُمْكِنُ غَزْلُهُ وَتَحْوِيلُهُ إِلَى أَلْيَافٍ)",
 "spinnbarkeit": "تمططية, لزوجة مطاطية (قدرة السائل اللزج (وخاصة مخاط عنق الرحم) على التمدد في شكل خيط أو الانتفاخ في فقاعة)",
 "spinner": "طعم دوار (طعم للصياد؛ يدور عند سحبه عبر الماء) / دوارة, قرص دوار (من معدات ألعاب الطاولة تتكون من قرص وسهم يتم تدويره لتحديد الحركة التالية في اللعبة) / غزّال (شخص يغزل (يبرم الألياف لتصبح خيوطاً))",
 "spinney": "أجمة صغيرة (دغل يؤوي الطرائد)",
 "spinning": "غزل (صنع الخيوط)",
 "spinning frame": "إطار الغزل (آلة غزل تسحب وتبرم وتلف الخيوط)",
 "spinning jenny": "غزالة جيني (آلة غزل مبكرة ذات مغازل متعددة)",
 "spinning machine": "آلة غزل (آلة نسيج لغزل الخيوط والخيوط)",
 "spinning rod": "قصبة صيد (قصبة صيد مصممة لرمي الطعم الدوار)",
 "spinning top": "دُوَّامَة, بُلْبُل",
 "spinning wheel": "عَجَلَة الْمِغْزَل",
 "spinocerebellar disorder": "اضطراب نخاعي مخيخي (أي من الاضطرابات الخلقية المتعددة التي تتميز بتنكس المخيخ والحبل الشوكي مما يؤدي إلى التشنج والرنح)",
 "spinose": "شَوْكِيّ, مُشَوَّك (مسلّح بالأشواك على الحافة)",
 "spinous": "شَائِك, شَوْكِيّ (على شكل شوكة أو عمود فقري) / شوكي (يحتوي على أشواك)\nمثال: الزعنفة الظهرية شوكية",
 "spinous process": "نتوء شوكي (نتوء يبرز من الفقرة يربط العضلات والأربطة)\nمثال: النتوءات الشوكية مبالغ فيها في بعض الحيوانات، مثل ديميترودون وسبينوصور المنقرضين، حيث تشكل شراع ظهر أو زعنفة ظهر",
 "spinster": "عَانِس",
 "spinsterhood": "عنوسة (حالة كون المرأة عانس (عادة امرأة مسنة غير متزوجة))",
 "spinto soprano": "سوبرانو سبينتو (نوع من أصوات السوبرانو الأوبرالية)",
 "spinus pinus": "حسون الصنوبر (عصفور صغير يعيش في الغابات الصنوبرية بأمريكا الشمالية)",
 "spinus tristis": "حسون أمريكي, طائر أصفر (عصفور أمريكي يتميز الذكر بريش جسم أصفر في الصيف)",
 "spiny": "ذُو أَشْوَاك, شَائِك (يحمل أشواكًا أو إبرًا أو شعيرات واقية أو مُغطَّى بها) / شوكي (يحتوي على أشواك)\nمثال: الزعنفة الظهرية شوكية",
 "spiny anteater": "آكل النمل الشوكي, إيكيدنا (ثديي أحادي المسلك حفار مغطى بالأشواك وله خطم طويل ومخالب لصيد النمل والنمل الأبيض؛ موطنه أستراليا) / إيكيدنا (ثديي أحادي المسلك حفار مغطى بالأشواك وله خطم طويل ومخالب لصيد النمل والنمل الأبيض؛ موطنه غينيا الجديدة)",
 "spiny dogfish": "كلب البحر الشائك (كلاب بحر صغيرة تعيش في القاع)",
 "spiny lizard": "سحلية شائكة (أي من العديد من السحالي ذات الحراشف المدببة المتداخلة والمضلعة؛ من أمريكا الشمالية والوسطى) / سحلية شائكة, شيطان الجبل (سحلية صحراوية تتغذى على النمل)",
 "spiny lobster": "جراد البحر الشائك (قشري بحري كبير صالح للأكل له درقة شوكية ولكنه يفتقر إلى المخالب الكبيرة للكركند الحقيقي) / إستاكوزا شائكة, كركند شائك (كركند المياه الدافئة بدون مخالب؛ تلك القادمة من أستراليا وجنوب أفريقيا تسوق عادة كذيول مجمدة؛ تصاد أيضاً في فلوريدا وكاليفورنيا)",
 "spiny puffer": "ينفوخ شائك (ينفوخ ذو أشواك صلبة أو قابلة للانتصاب)",
 "spiny softshell": "سلحفاة ناعمة شوكية (سلحفاة نهرية من غرب الولايات المتحدة ذات صدفة ثؤلولية؛ تفضل المياه الهادئة)",
 "spiny talinum": "تالينوم شوكي (نبات منخفض يشكل وسادة ذو أزهار وردية إلى قرمزية أرجوانية وأضلاع أوراق وسطية تستمر كأشواك عند موت الأوراق؛ جنوب غرب الولايات المتحدة)",
 "spiny-backed": "شَائِك الظَّهْر (ذو ظهر مغطى بالأشواك)",
 "spiny-edged": "شَوْكِيّ الحَافَّة (ذو حافة شوكية)",
 "spiny-finned": "شوكي الزعانف (من أو متعلق بالأسماك ذات الزعانف الشوكية)",
 "spiny-finned fish": "شائكات الزعانف (سمكة عظمية ذات زعانف مدعومة بأشعة حادة غير مرنة)",
 "spiny-headed worm": "شائكات الرؤوس (أي من الديدان المختلفة التي تعيش طفيلياً في أمعاء الفقاريات ولها خرطوم قابل للسحب مغطى بالعديد من الأشواك المعقوفة)",
 "spiny-leafed": "شَوْكِيّ الأَوْرَاق (ذو أوراق شوكية)",
 "spiny-leaved": "شَوْكِيّ الأَوْرَاق (ذو أوراق شوكية)",
 "spiny-stemmed": "شَائِك السَّاق (ذو ساق شائكة)",
 "spiny-tailed lizard": "ضَبّ",
 "spiracle": "متنفس (فتحة تنفسية)",
 "spiraea": "إكليلية, سبيريا / أستيلب ياباني",
 "spiraea prunifolia": "إكليل العروس (شجيرة لها زهور بيضاء صغيرة غزيرة في الربيع)",
 "spiral": "لَوْلَب, بُرْغِيّ",
 "spiral bandage": "رباط حلزوني (ضمادة مائلة تتداخل فيها اللفات المتتالية مع اللفات السابقة)",
 "spiral galaxy": "مَجَرَة حَلَزُونِيَّة (نجوم كثيرة لا تدرك بمجرد البصر، وعندما ينتشر ضوؤها فيُرى كأنه بقعة بيضاء (أي: مصادر ضوء كثيرة بحيث يبدو ضوئها كوهج بدلاً من أن يَبدو كل نجم واضحٍ…؛ باب السماء، وهي البياض الذي يَعبر السماء ويَقع بين النّسرَين (المقصود هنا هو مجرة دَرْب التّبانَة…)\nمثال: أنا بطل المجرة.",
 "spiral nebula": "مجرة حلزونية (مجرة ذات بنية حلزونية؛ أذرع تحتوي على نجوم أصغر سناً تلتف خارجة من نجوم قديمة في المركز)",
 "spiral notebook": "دفتر سلك (دفتر ملاحظات بتجليد حلزوني)",
 "spiral ratchet screwdriver": "مفك سقاطة حلزوني (مفك براغي بسقاطة (بحيث يدور النصل في اتجاه واحد فقط) وحلزون في المقبض (بحيث يدور النصل) مع الضغط لأسفل على المقبض)",
 "spiral spring": "نابض حلزوني (نابض ملفوف مثل الحلزون)",
 "spiral-shelled": "حَلَزُونِيُّ الصَّدَفَةِ (لَهُ صَدَفَةٌ تَتَّخِذُ شَكْلًا حَلَزُونِيًّا)",
 "spiraling": "حَلَزُونِيّ, لَوْلَبِيّ (على شكل لفائف حلزونية)",
 "spiralling": "حَلَزُونِيّ, لَوْلَبِيّ (على شكل لفائف حلزونية)",
 "spirally": "بشكل حلزوني, لولبياً (مع لوالب)\nمثال: مقابض محززة لولبياً",
 "spirant": "احْتِكاكِيّ, صَفيرِيّ ((في الصَّوْتِيّات) صَوْت يُنْتَج باحْتِكاك الهَواء في مَمَرّ ضَيِّق) / صامت احتكاكي (صامت استمراري يُنتج عن طريق حركة النفس ضد تضييق في المجرى الصوتي)",
 "spiranthes cernua": "جدائل السيدة المنحنية",
 "spiranthes porrifolia": "جدائل السيدة الغربية",
 "spiranthes romanzoffiana": "جدائل السيدة ذات القلنسوة (سحلب له عناقيد كثيفة من الزهور البيضاء الكريمية الحلزونية بلطف مع بتلتين علويتين تشكلان غطاء؛ غرب أمريكا الشمالية)",
 "spiranthes spiralis": "جدائل السيدة الأوروبية (سحلب أوروبي له عناقيد أقصر من الزهور البيضاء الثلجية الحلزونية بقوة)",
 "spire": "برج مستدق, قمة البرج (برج طويل يشكل البنية الفوقية لمبنى (عادة كنيسة أو معبد) ويضيق حتى يصل إلى نقطة في الأعلى)",
 "spirea": "إكليلية, سبيريا / أستيلب ياباني",
 "spirilla": "بكتيريا حلزونية, لولبية (أي بكتيريا هوائية ذات سوط ولها شكل عصوي ملتوي حلزونياً)",
 "spirillum": "بكتيريا حلزونية, لولبية (أي بكتيريا هوائية ذات سوط ولها شكل عصوي ملتوي حلزونياً) / بكتيريا حلزونية (بكتيريا عصوية طويلة ملتوية حلزونياً تعيش عادة في المياه الراكدة)",
 "spirillum fever": "حمى عضة الجرذ, سودوكو (شكل من أشكال حمى عضة الجرذ يحدث في الشرق الأقصى)",
 "spirillum minus": "بكتيريا حمى عضة الجرذ, لولبية صغرى (بكتيريا تسبب حمى عضة الجرذ)",
 "spirit": "رُوح (رَوَّحَ عليه بالمِرْوحَة: حَرَّكَها ليجلبَ إِليه نسيمَ الهواء؛ رَوَّحَ بالقوم: صلَّى بهم التراويح) / رُوَح (رَوَّحَ عليه بالمِرْوحَة: حَرَّكَها ليجلبَ إِليه نسيمَ الهواء؛ رَوَّحَ بالقوم: صلَّى بهم التراويح) / كُحُول (سَائِلٌ لاَ لَوْنَ لَهُ، لاَذِعُ الطَّعْمِ، يُسْتَخْرَجُ مِنْ تَخْمِيرِ بَعْضِ الْمَوَادِّ، يُمْزَجُ بِالْمَشْرُوبَاتِ الرُّوحِيَّةِ…)\nمثال: كان سامي هو روح الحفلة.",
 "spirit animal": "حيوان روحي (حيوان تتطابق خصائصه مع جزء من سلوك الشخص)",
 "spirit gum": "صمغ الروح (محلول لاصق مصنوع من الصمغ والإيثر ويستخدم لربط الشعر المستعار بالجلد)",
 "spirit lamp": "مصباح كحولي (مصباح يحرق وقوداً سائلاً متطايراً مثل الكحول)",
 "spirit level": "مِيزَانُ مَاء (آلة تُوزن بها الأشياء ويُعْرف مِقْدارها؛ عَدْل)",
 "spirit of turpentine": "زيت التربنتين (سائل متطاير مقطر من راتنج التربنتين؛ يُستخدم كمخفف للطلاء ومذيب وطبياً)",
 "spirit rapper": "وسيط طرقي (شخص يدعي تلقي رسائل من الموتى على شكل طرقات على الطاولة)",
 "spirit rapping": "نقر الطاولة (شكل مزعوم من التواصل مع أرواح الموتى)",
 "spirit stove": "سبرتاية, موقد كحولي (موقد يحرق وقوداً سائلاً متطايراً مثل الكحول)",
 "spirit world": "عالم الأرواح (أي مكان خيالي تسكنه كائنات روحية (شياطين أو جنيات أو ملائكة أو ما شابه))\nمثال: لقد أفرغ العلم عالم الأرواح من سكانه السابقين",
 "spirited": "مُفْعَم بِالحَيَاة, مُنْتَعِش (أُضفِيَت عليه الحيويّة والنشاط) / جَرِيء, ذُو هِمَّة (مُسْتَعِدّ لِمُوَاجَهَة الخَطَر) / حَيَوِيّ, مِقْدَام (يتميّز بالحركة النشطة والحيوية) / حيوي, مفعم بالحيوية (يظهر حيوية أو نشاطًا أو حماسًا)",
 "spiritedly": "بحماس, بروح معنوية عالية (بطريقة مفعمة بالحيوية أو النشاط؛ بحيوية ونشاط)",
 "spiritedness": "انتشاء, حيوية (صفة كون المرء نشطاً أو مفعماً بالحيوية أو حياً وقوياً)",
 "spiritism": "روحانية (الاهتمام بأمور الروح)",
 "spiritless": "خَنُوع, مُسْتَكِين (يُظْهِر قِلَّة فِي الشَّجَاعَة؛ مُفْرِط فِي الِامْتِثَال) / خامل, فاتر الهمة (يفتقر إلى الحماس أو النشاط أو الطاقة)\nمثال: رد فاتر على الانتقادات",
 "spiritlessness": "فتور, لامبالاة (سمة الافتقار للحماس أو الاهتمام بالأشياء عموماً)",
 "spiritous": "رُوحِيّ, كُحولِيّ مُقَطَّر (مَصْنوع بِالتَّقْطير؛ ذو كَثافَة كُحولِيَّة عالِيَة)",
 "spirits": "كُحُول, خَمْر (سَائِلٌ لاَ لَوْنَ لَهُ، لاَذِعُ الطَّعْمِ، يُسْتَخْرَجُ مِنْ تَخْمِيرِ بَعْضِ الْمَوَادِّ، يُمْزَجُ بِالْمَشْرُوبَاتِ الرُّوحِيَّةِ…)\nمثال: أكره ذوق الكحول.",
 "spirits of ammonia": "روح النشادر, نشادر متطاير (محلول من كربونات الأمونيوم في ماء الأمونيا والكحول)",
 "spirits of wine": "روح الخمر, كحول نقي (كحول إيثيلي مقطر)",
 "spiritual": "رُوحَانِيّ, رُوحِيّ",
 "spiritual being": "كائن خارق للطبيعة, كيان روحي (كائن غير مادي يُعتقد أن له قوى تؤثر على مسار الأحداث البشرية)",
 "spiritual bouquet": "باقة روحية ((الكنيسة الكاثوليكية) بطاقة تشير إلى أن المرسل سيقوم بأعمال تعبدية معينة نيابة عن شخص آخر)",
 "spiritual domain": "العالم الروحي, عالم الغيب (اعتقاد بوجود عالم تسيطر عليه روح إلهية)",
 "spiritual leader": "زعيم ديني, قائد روحي (قائد في الشؤون الدينية أو المقدسة)",
 "spiritual rebirth": "اعتناق, هداية (استنارة روحية تدفع الشخص لعيش حياة جديدة)",
 "spiritual world": "العالم الروحي, عالم الغيب (اعتقاد بوجود عالم تسيطر عليه روح إلهية)",
 "spiritualisation": "إضفاء الطابع الروحي, روحنة (فعل جعل الشيء روحياً؛ بث محتوى روحي فيه)",
 "spiritualism": "روحانية (الاهتمام بأمور الروح) / تحضير الأرواح, روحانية (الاعتقاد بأن أرواح الموتى يمكن أن تتواصل مع الأحياء (خاصة عبر وسيط)) / روحانية ((اللاهوت) أي مذهب يؤكد الوجود المنفصل لله)",
 "spiritualist": "روحاني (متعلق بالروحانية أو متصل بها) / وسيط روحي (شخص يعمل كوسيط بين الأحياء والأموات)\nمثال: استشار العديد من الوسطاء",
 "spiritualistic": "روحاني (متعلق بالروحانية أو متصل بها)",
 "spirituality": "رُوحَانِيَّة, رَوْحَانِيَّة",
 "spiritualization": "إضفاء الطابع الروحي, روحنة (فعل جعل الشيء روحياً؛ بث محتوى روحي فيه)",
 "spiritually": "روحياً (بطريقة روحية)\nمثال: كان القرن التاسع الفترة الأكثر حرية روحياً",
 "spiritualty": "ممتلكات كنسية (ممتلكات أو دخل تملكه الكنيسة)",
 "spirituous": "رُوحِيّ, كُحولِيّ مُقَطَّر (مَصْنوع بِالتَّقْطير؛ ذو كَثافَة كُحولِيَّة عالِيَة)",
 "spirochaete": "سبيروكيتا, ملتوية (بكتيريا طفيلية أو حرة المعيشة؛ العديد منها ممرض للبشر والحيوانات الأخرى)",
 "spirochete": "سبيروكيتا, ملتوية (بكتيريا طفيلية أو حرة المعيشة؛ العديد منها ممرض للبشر والحيوانات الأخرى)",
 "spirodela polyrrhiza": "عدس الماء الكبير (عالمي الانتشار باستثناء أمريكا الجنوبية ونيوزيلندا وبعض جزر المحيطات)",
 "spirogram": "مخطط التنفس (تسجيل للتنفس يتم بواسطة جهاز قياس التنفس (سبيروجراف))",
 "spirograph": "سبيروجراف, مقياس التنفس البياني (أداة قياس لتسجيل عمق وسرعة حركات التنفس)",
 "spirogyra": "سبيروجيرا, لولبية (طحالب مياه عذبة تتكون من خيوط دقيقة تحتوي على أشرطة كلوروفيل حلزونية)",
 "spirometer": "سبيرومتر, مقياس التنفس (أداة قياس لقياس السعة الحيوية للرئتين)",
 "spirometry": "قياس التنفس (استخدام مقياس التنفس لقياس السعة الحيوية)",
 "spironolactone": "ألداكتون, سبيرونولاكتون (كورتيكوستيرويد صناعي (الاسم التجاري ألداكتون) يستخدم لعلاج ارتفاع ضغط الدم)",
 "spirt": "بخ, دفق (حدوث تصريف مفاجئ (لسائل))",
 "spirula": "سبيرولا (رأسيات أرجل استوائية صغيرة من جنس سبيرولا لها عيون بارزة وأذرع قصيرة وصدفة متعددة الغرف ملفوفة في لولب مسطح)",
 "spirula peronii": "سبيرولا (رأسيات أرجل استوائية صغيرة من جنس سبيرولا لها عيون بارزة وأذرع قصيرة وصدفة متعددة الغرف ملفوفة في لولب مسطح)",
 "spit": "سَفُّود, سِيخ / بَصَقَ, بَزَقَ (بَصَقَ من باب نَصَرَ؛ لفظ مَا فِي فَمه) / بُزَاق",
 "spit and polish": "أناقة وانضباط (اهتمام دقيق بالنظام والمظهر (كما في الجيش))",
 "spit curl": "خُصْلَة مُلْتَصِقَة (تجعيدة لولبية ملصقة على الجبهة أو الخد)",
 "spitball": "كرة ملعوبة (رمية غير قانونية يتم فيها وضع مادة غريبة (لعاب أو فازلين) على الكرة من قبل الرامي قبل رميها) / كرة ورقية ممضوغة (قذيفة تصنع عن طريق مضغ قطعة من الورق وتشكيلها في كرة)",
 "spite": "خبث, لؤم (الخبث الناتج عن كون الشخص حقودًا أو سيئ الطبع) / حقد, كيد (الشعور بالحاجة لرؤية الآخرين يعانون)",
 "spiteful": "اِنْتِقَامِيّ, حَقُود (يُظهر سوء نية خبيثة ورغبة في الإيذاء؛ مدفوع بالحقد)",
 "spitefully": "بحقد, بغل / بِحِقْد, بِغِلّ (بطريقة حاقدة خبيثة)\nمثال: أجاب متهميه بحقد",
 "spitefulness": "خبث, لؤم (الخبث الناتج عن كون الشخص حقودًا أو سيئ الطبع) / حقد, كيد (الشعور بالحاجة لرؤية الآخرين يعانون)",
 "spitfire": "سَرِيعَة الْغَضَب, شَرِسَة (شخص عاطفي للغاية وسريع الغضب (خاصة فتاة أو امرأة))",
 "spitter": "كرة ملعوبة (رمية غير قانونية يتم فيها وضع مادة غريبة (لعاب أو فازلين) على الكرة من قبل الرامي قبل رميها) / بَاصِق (شخص يبصق (يخرج اللعاب أو البلغم من الفم))",
 "spitting": "بصق (فعل البصق (طرد اللعاب بقوة))",
 "spitting cobra": "كوبرا باصقة, كوبرا سوداء العنق (كوبرا عدوانية واسعة الانتشار في أفريقيا؛ نادراً ما تعض ولكنها تبصق السم الذي قد يسبب العمى)",
 "spitting image": "صُورَة طِبْق الأَصْل, نُسْخَة مُطَابِقَة (صورة مماثلة تماماً أو نظير مطابق)",
 "spitting snake": "ثعبان باصق, رينغالس (ثعبان شديد السمية من جنوب أفريقيا قادر على بصق السم لمسافة تصل إلى سبعة أقدام)",
 "spittle": "ريق, لعاب (سائل صاف تفرزه الغدد اللعابية والغدد المخاطية للفم في الفم؛ يرطب الفم ويبدأ هضم النشويات)",
 "spittle insect": "حشرة البصاق (حشرة صغيرة قافزة آكلة للأعشاب تعيش في كتلة من الرغوة الواقية التي تفرزها هي ويرقاتها)",
 "spittlebug": "حشرة البصاق (حشرة صغيرة قافزة آكلة للأعشاب تعيش في كتلة من الرغوة الواقية التي تفرزها هي ويرقاتها)",
 "spittoon": "مبصقة (وعاء للبصق (عادة في مكان عام))",
 "spitz": "سبيتز (أي من سلالات الكلاب الممتلئة كثيفة الشعر الأصلية في المناطق الشمالية ولها خطوم مدببة وآذان منتصبة مع ذيل فروي مجعد)",
 "spiv": "نصاب أنيق (شخص بلا عمل يكسب المال بمخططات مشبوهة مختلفة؛ يتجول بملابس أنيقة ويستمتع بوقته)",
 "spizella arborea": "عصفور الشجر (عصفور شائع في الشتاء في شمال الولايات المتحدة)",
 "spizella passerina": "عصفور السقسقة (عصفور صغير من أمريكا الشمالية شائع في المناطق الحضرية)",
 "spizella pusilla": "عصفور الحقل (عصفور شائع في أمريكا الشمالية يعيش في المراعي ذات الشجيرات)",
 "splanchnic": "حشوي (متعلق بالأحشاء أو يؤثر فيها)\nمثال: نزيف حشوي",
 "splanchnic nerve": "عصب حشوي (أي من عدة أعصاب من الجزء الودي للجهاز العصبي الذاتي تعصب الأحشاء والأوعية الدموية)",
 "splash": "رش, طرطشة (فعل نثر الماء بشكل عشوائي) / رش, طرطشة (فعل رش مادة (سائلة) على سطح) / لطخة لونية (رقعة ذات لون ساطع) / رشق, طرطشة (الصوت الذي يشبه طرطشة الماء)\nمثال: أعطت قبعتها الحمراء ملابسها لطخة من الألوان",
 "splash guard": "واقي الطين (قطعة منحنية فوق عجلة دراجة أو دراجة نارية لحماية الراكب من الماء أو الطين الذي تقذفه العجلات)",
 "splash-guard": "واقي الطين (قطعة منحنية فوق عجلة دراجة أو دراجة نارية لحماية الراكب من الماء أو الطين الذي تقذفه العجلات)",
 "splashboard": "حاجز الطين, لوحة حماية من الرذاذ (غطاء واقٍ يتكون من لوحة لحماية الناس من رذاذ الماء أو الطين وما إلى ذلك) / لوح منع الرذاذ (غطاء واقٍ يتكون من لوح عريض على طول حافة القارب لمنع الماء من التناثر فوق الجانب)",
 "splashdown": "هبوط مائي (هبوط مركبة فضائية في البحر في نهاية رحلة فضائية)",
 "splashed": "مُتَرَشِّش, مُتَطَايِر ((عَنِ السَّائِلِ) اندَفَعَ عَلَى هَيْئَةِ قَطَرَاتٍ أَوْ كُتَلٍ مُتَطَايِرَةٍ) / مُبَقَّع, مُرَشَّش (مغطى ببقع زاهية؛ يُستخدم غالباً في التركيب)",
 "splasher": "حاجز الطين, لوحة حماية من الرذاذ (غطاء واقٍ يتكون من لوحة لحماية الناس من رذاذ الماء أو الطين وما إلى ذلك) / واقي الرذاذ (غطاء واقٍ فوق أو بجانب عجلة لحماية الجزء العلوي من المركبة من رذاذ الطين)",
 "splashiness": "انْتِفَاخ, تَبَاهِي (انعدام الأناقة نتيجة التفاخر والغرور وانتفاخ الذات)",
 "splashing": "رش, طرطشة (فعل نثر الماء بشكل عشوائي) / رش, طرطشة (فعل رش مادة (سائلة) على سطح)",
 "splashy": "مُبَقَّع بِأَلْوَان زَاهِيَة (مغطى ببقع من الألوان الزاهية) / بَرَّاق, صَارِخ (يتّسم بالتباهي لكنّه غالبًا عديم الذوق) / طرطاشي, متطاير (يتميز بتطاير الماء عشوائياً)",
 "splat": "شريحة ظهر الكرسي (شريحة خشبية في منتصف ظهر كرسي مستقيم) / ارتطام رطب, لطخة (طرطشة واحدة)\nمثال: سمع صوت ارتطام رطب عندما اصطدم بالأرض",
 "splatter": "تطاير, طرطشة (ضجيج شيء يتناثر أو يطرطش بشكل انفجاري) / رشة, لطخة (كمية صغيرة من شيء رطب أو سائل)\nمثال: سمع طرطشة نيران",
 "splattered": "مُبَقَّع, مُرَشَّش (مغطى ببقع زاهية؛ يُستخدم غالباً في التركيب)",
 "splattering": "رش, طرطشة (فعل رش مادة (سائلة) على سطح) / تطاير, طرطشة (ضجيج شيء يتناثر أو يطرطش بشكل انفجاري)\nمثال: سمع طرطشة نيران",
 "splay": "مُتَبَاعِد, مُنْفَرِج (مُتَّجِهٌ نَحْوَ الخَارِجِ بِشَكْلٍ غَيْرِ مُتَنَاسِقٍ) / شطب خارجي (شطب خارجي حول باب أو نافذة يجعلها تبدو أكبر)",
 "splayfoot": "أفحج, متباعد القدمين (ذو قدمين تتجهان نحو الخارج) / قدم مسطحة (قدم مصابة بهبوط القوس؛ مسطحة ومنبسطة بشكل غير طبيعي)",
 "splayfooted": "أفحج, متباعد القدمين (ذو قدمين تتجهان نحو الخارج)",
 "spleen": "طِحَال",
 "spleenwort": "سبلينورت, طحال (أي من السراخس المتنوعة التي تعيش بشكل رئيسي على الصخور من جنس أسبلينيوم)",
 "splendid": "بَاهِر, رَائِع (يتمتع بجمال وروعة عظيمين) / بَهِيّ, رَائِع (يتّسم بالعظمة والفخامة) / رَفِيع, مُتَأَلِّق (جيد جدًا؛ من أرقى مستويات الجودة)",
 "splendidly": "بشكل رائع, بشكل ممتاز (بشكل رائع) / بأبهة, بروعة (بطريقة جميلة ومثيرة للإعجاب)\nمثال: أبلى بلاءً حسناً بشكل ممتاز في الامتحان",
 "splendiferous": "بَاهِر, رَائِع (يتمتع بجمال وروعة عظيمين)",
 "splendor": "مَجْد (رفع شأن شيء أو شخص وعظمه وأضفى عليه قيمة كبيرة؛ أثنى على عظمة شيء أو شخص وأشاد به)\nمثال: المجد لأوكرانيا",
 "splendour": "أُبَّهَة, رَوْعَة (صفة كون الشيء رائعاً أو فاخراً أو عظيماً) / بهاء, تألق (جودة تتفوق في لمعانها على المعتاد)\nمثال: بالنسبة للفخامة والخدمة الشخصية",
 "splenectomy": "استئصال الطحال (إزالة جراحية للطحال)",
 "splenetic": "حَادّ الطَّبْع, لَاسِع (شديد الانفعال وسريع الغضب) / طحالي (مكون من أو متعلق بالطحال)",
 "splenic": "طحالي (مكون من أو متعلق بالطحال)",
 "splenic artery": "شريان طحالي (شريان ينشأ من الجذع الزلاقي ويغذي الطحال بالدم)",
 "splenic fever": "الجمرة الخبيثة (مرض حيواني شديد العدوى (خاصة الماشية والأغنام)؛ يمكن أن ينتقل إلى البشر)",
 "splenic vein": "وريد طحالي (وريد يتكون من عدة أوردة صغيرة على سطح الطحال؛ ينضم إلى الوريد المساريقي العلوي لتكوين الوريد البابي)",
 "splenitis": "التهاب الطحال (التهاب الطحال)",
 "splenius": "عضلة طحالية (إحدى عضلتين مسطحتين تمتدان من الفقرات العلوية إلى قاعدة الجمجمة وتعملان على تدوير أو ثني أو مد الرأس والرقبة)",
 "splenius muscle": "عضلة طحالية (إحدى عضلتين مسطحتين تمتدان من الفقرات العلوية إلى قاعدة الجمجمة وتعملان على تدوير أو ثني أو مد الرأس والرقبة)",
 "splenomegaly": "تضخم الطحال (تضخم غير طبيعي للطحال)",
 "splice": "وصلة تراكبية (وصلة تصنع عن طريق تداخل طرفين وربطهما معاً) / لصقة, وصلة (نقطة اتصال حيث يتم ضم شيئين (مثل الورق أو الفيلم أو الشريط المغناطيسي) معاً)\nمثال: كان الانقطاع بسبب وصلة غير متقنة",
 "splicer": "آلة لصق (جهاز ميكانيكي لربط قطعتين من الورق أو الفيلم أو الشريط المغناطيسي) / ضفّار الحبال (عامل يربط الحبال ببعضها عن طريق تداخل الضفائر) / واصل الأخشاب (عامل خشب يصل قطع الخشب بوصلة)",
 "splicing": "لصقة, وصلة (نقطة اتصال حيث يتم ضم شيئين (مثل الورق أو الفيلم أو الشريط المغناطيسي) معاً)\nمثال: كان الانقطاع بسبب وصلة غير متقنة",
 "spliff": "جوينت, سيجارة ماريجوانا (أوراق ماريجوانا ملفوفة في سيجارة للتدخين)",
 "spline": "سدابة, شريحة (شريط رفيع (من الخشب أو المعدن)) / شريحة رسم مرنة (شريط مرن (خشب أو مطاط) يستخدم في رسم الخطوط المنحنية)",
 "splint": "جبيرة (جهاز ميكانيكي لتقويم العظام يستخدم لتثبيت وحماية جزء من الجسم (مثل الساق المكسورة)) / شَظِيَّة خشبية, شُقَاقَة (شظية رفيعة من الخشب)\nمثال: أشعل النار باستخدام شظية خشبية مشتعلة",
 "splint bone": "عظم جبيري, عظم شظوي (عظم سنعي أو مشطي أثري على جانبي عظم الوظيف في ساق الحصان أو الحيوانات ذات الصلة)",
 "splinter": "شَظِيَّة",
 "splinter group": "مجموعة منشقة (فصيل أو طائفة انفصلت عن منظمتها الأم)",
 "splintering": "تفتيت, شطف (عملية شطف جزء من شيء ما)",
 "splinterless": "مُضَادٌّ لِلتَّشَظِّي, مُقَاوِمٌ لِلتَّحَطُّم (مُقَاوِمٌ لِلتَّحَطُّمِ أَوِ التَّشَظِّي)",
 "splinterproof": "مُضَادٌّ لِلتَّشَظِّي, مُقَاوِمٌ لِلتَّحَطُّم (مُقَاوِمٌ لِلتَّحَطُّمِ أَوِ التَّشَظِّي)",
 "splinters": "حطام خشبي, شظايا خشبية (خشب في قطع صغيرة أو شظايا)\nمثال: تحطمت السفينة إلى شظايا خشبية على الصخور",
 "splintery": "شَظَوِيّ, قَابِلٌ لِلتَّشَظِّي (عُرْضَةٌ لِلانْكِسَارِ إِلَى شَظَايَا حَادَّةٍ وَدَقِيقَة) / شظوي, متشظ (يشبه أو يتكون من أو مغروس بشظايا طويلة ورفيعة (خاصة من الخشب) ذات رؤوس حادة)\nمثال: أرضية خشنة متشظية من ألواح الصنوبر القديمة",
 "split": "انفصل",
 "split decision": "قرار منقسم (قرار ملاكمة لا يجمع عليه الحكام)",
 "split down": "تجزئة عكسية للأسهم (انخفاض في عدد الأسهم القائمة للشركة دون تغيير حقوق المساهمين)",
 "split end": "جناح متباعد ((كرة القدم الأمريكية) لاعب هجومي يصطف على مسافة من لاعبي الخط الآخرين)",
 "split infinitive": "مصدر مفصول (مصدر يتم فصله بظرف بين أداة المصدر والفعل (في اللغة الإنجليزية))",
 "split personality": "انفصام الشخصية, تعدد الشخصيات (اضطراب انشقاقي نادر نسبياً ينهار فيه التكامل المعتاد للشخصية وتظهر شخصيتان مستقلتان أو أكثر)",
 "split rail": "عارضة مشقوقة (عارضة يتم شقها من جذع شجرة)",
 "split run": "تشغيل مقسم (دورة طباعة لصحيفة يتم خلالها تغيير بعض المقالات أو الإعلانات لإنتاج طبعة مختلفة)",
 "split second": "طرفة عين, لمح البصر (وقت قصير جداً (مثل الوقت الذي تستغرقه العين لتطرف))\nمثال: سأفعل ذلك في لمح البصر",
 "split shift": "وردية مجزأة (نوبة عمل مقسمة إلى فترتين زمنيتين مع وجود عدة ساعات فاصلة بينهما)",
 "split ticket": "تصويت منقسم (بطاقة اقتراع يدلي بها ناخب يصوت لمرشحين من أكثر من حزب)",
 "split up": "تجزئة الأسهم (زيادة في عدد الأسهم القائمة للشركة دون تغيير حقوق المساهمين)\nمثال: أعلنوا عن تجزئة اثنين مقابل واحد للأسهم العادية",
 "split-brain technique": "تقنية فصل الدماغ (جراحة دماغ على الحيوانات يتم فيها قطع الجسم الثفني (وأحياناً التصالب البصري) لقطع الاتصال بين نصفي الكرة المخية)",
 "split-half correlation": "ارتباط التجزئة النصفية (معامل ارتباط يُحسب بين الدرجات في نصفي اختبار؛ يُتخذ كمؤشر لموثوقية الاختبار)",
 "split-pea": "بازلاء مجروشة, بازلاء مقشرة (بازلاء مقشرة ومجففة؛ تستخدم في الحساء)",
 "split-pea soup": "حساء البازلاء المقشورة (مصنوع من المرق والبازلاء المقشورة مع البصل والجزر والكرفس)",
 "split-rail fence": "سياج عوارض (سياج (عادة مصنوع من جذوع الأشجار المشقوقة الموضوعة عبر بعضها البعض بزاوية))",
 "splitsaw": "منشار شق طولي (منشار يدوي للقطع مع اتجاه ألياف الخشب)",
 "splitsville": "افتراق, انفصال (حالة الانفصال أو الطلاق أو الافتراق)\nمثال: بعد 15 عاماً معاً، يتجهان نحو الانفصال",
 "splitter": "فالف الحطب (عامل يشق جذوع الأشجار لبناء أسوار من السكك الخشبية) / مُقسِّم (عالم تصنيف يصنف الكائنات الحية في مجموعات عديدة بناءً على خصائص ثانوية نسبياً) / شقّاق الأسماك (عامل يشق السمك ويزيل العمود الفقري)",
 "splitting": "شَاقّ, مُمَزِّق (يُشْبِه صَوْت تَمْزِيق عَنِيف كَصَوْت البَرْق المُشَقِّق لِلسَّمَاء)",
 "splitworm": "عثة البطاطس, عثة درنات البطاطس (عثة بنية رمادية يرقتها هي دودة درنات البطاطس)",
 "splodge": "بقعة كبيرة, تلطخ (بقعة غير منتظمة الشكل)",
 "splotch": "بقعة كبيرة, تلطخ (بقعة غير منتظمة الشكل)",
 "splotched": "مُبَقَّع, مُلَطَّخ (مُعلَّم ببقع غير منتظمة الشكل)",
 "splurge": "عربدة, نوبة إفراط (أي فعل من أفعال الانغماس غير المعتدل) / إسراف استعراضي (عرض متباه (للجهد أو الإسراف، إلخ.))\nمثال: نوبة إفراط في التسوق",
 "splutter": "بقبقة, تأتأة غاضبة (تلفظ (بكلمات) مع أصوات بصق (كما في الغضب)) / تطاير, طرطشة (ضجيج شيء يتناثر أو يطرطش بشكل انفجاري)\nمثال: سمع طرطشة نيران",
 "spock": "سبوك",
 "spode": "خزف سبود (علامة تجارية للبورسلين الإنجليزي الفاخر)",
 "spodoptera exigua": "دودة جيش البنجر (عثة يرقاتها هي ديدان جيش البنجر) / دودة حشد البنجر (يرقة عثة تأكل أوراق البنجر والخضروات الأخرى)",
 "spodoptera frugiperda": "دودة الجيش الخريفية (عثة يرقاتها هي ديدان الجيش الخريفية) / دودة الحشد الخريفية (يرقة عثة ليلية أمريكية مهاجرة؛ تدمر الأعشاب والحبوب الصغيرة)",
 "spodumene": "سبودومين (معدن بيروكسين يتكون من سيليكات الليثيوم والألمنيوم؛ مصدر لليثيوم)",
 "spoil": "أَفْسَدَ / دَلَّلَ, غَنَّجَ (دلل: أَدَلَّ عَلَيْهِ وتَدَلَّلَ: انْبَسَطَ؛ قالَ ابْنُ دُرَيْدٍ: أَدَلَّ عَلَيْهِ وَثِق بِمَحَبَّتِهِ فأَفْرَط عَلَيْهِ) / فَسَدَ, نَتِنَ\nمثال: دلل سامي صديقته.",
 "spoilable": "سَرِيع الفَسَاد, قَابِل لِلتَّعَفُّن (عُرضة للتحلّل أو الفساد أو التعفّن) / طعام قابل للتلف (طعام سيفسد بسرعة إذا لم يبرد)",
 "spoilage": "إفساد, تخريب (فعل إفساد الشيء عن طريق إلحاق الضرر به) / تلف, فساد (عملية التحول إلى شيء تالف أو فاسد) / الفاسد, تلف (الكمية التي فسدت)\nمثال: كان إفسادها لثوبي متعمداً",
 "spoilation": "تجريد, سلب (فعل التجريد والأخذ بالقوة)",
 "spoiled": "فَاسِد",
 "spoiler": "كابح (سطح انسيابي مفصلي على السطح العلوي لجناح الطائرة يتم رفعه لتقليل الرفع وزيادة السحب) / جناح خلفي (سطح انسيابي مثبت في الجزء الخلفي من السيارة لتقليل الرفع عند السرعات العالية) / مُدَلِّل (شخص يدلل أو يفسد بالتدليل المفرط) / سالب, ناهب (شخص يأخذ الغنائم أو الأسلاب (كما في الحرب))",
 "spoiling": "إفساد, تخريب (فعل إفساد الشيء عن طريق إلحاق الضرر به) / تلف, فساد (عملية التحول إلى شيء تالف أو فاسد)\nمثال: كان إفسادها لثوبي متعمداً",
 "spoils of war": "سورة الأنفال",
 "spoils system": "نظام الغنائم, نظام المحسوبية (نظام توظيف وترقية الموظفين المدنيين الذين هم أصدقاء ومؤيدون للمجموعة الحاكمة)",
 "spoilsport": "ثقيل الظل, مفسد البهجة (شخص يفسد متعة الآخرين)",
 "spoilt": "مُدَلَّل",
 "spoke misalignment": "اختلال القضبان (حالة كون عجلة الدراجة غير مضبوطة بشكل صحيح)\nمثال: يسبب اختلال القضبان ترنح العجلة من جانب لآخر وغالباً ما تلامس وسادات الفرامل",
 "spoken": "مَنْطُوق, شَفَهِيّ",
 "spoken communication": "حديث, كلام ((لغة) التواصل عن طريق الكلام الشفهي)\nمثال: كان كلامه مشوشاً",
 "spoken language": "حديث, كلام ((لغة) التواصل عن طريق الكلام الشفهي)\nمثال: كان كلامه مشوشاً",
 "spoken word": "كلمة منطوقة, لفظة منطوقة (كلمة يتم نطقها بصوت عالٍ)",
 "spokeshave": "قشاطة, مِسْحَج العوارض (مسحج صغير له مقبض على كل جانب من شفرته؛ يستخدم لتشكيل أو تنعيم الأسطح الخشبية الأسطوانية (في الأصل قضبان العجلات))",
 "spokesman": "متحدث رسمي (متحدث رسمي ذكر)",
 "spokesperson": "نَاطِق رَسْمِيّ, مُتَحَدِّث رَسْمِيّ",
 "spokeswoman": "متحدثة رسمية (متحدثة رسمية أنثى)",
 "spoliation": "تجريد, سلب (فعل التجريد والأخذ بالقوة) / إتلاف الأدلة, تجريد ((في القانون) التدمير المتعمد لوثيقة أو تغييرها بما يفقدها قيمتها كدليل)",
 "spondaic": "تفعيلي طويل, سبوندي (من أو يتكون من تفعيلات طويلة (مقطعين طويلين))\nمثال: سداسي التفعيلة الطويلة",
 "spondee": "تفعيلة طويلة-طويلة, سبوندي (وحدة مترية بمقاطع مشددة-مشددة)",
 "spondias mombin": "برقوق الخنزير, مومبين أصفر (شجرة استوائية أمريكية لها فاكهة صفراء صالحة للأكل)",
 "spondias purpurea": "شجرة المومبين, مومبين (شجيرة أو شجرة صغيرة استوائية أمريكية شائعة بفاكهة أرجوانية)",
 "spondylarthritis": "التهاب الفقار والمفاصل (التهاب مفاصل يؤثر على واحد أو أكثر من المفاصل بين الفقرات في العمود الفقري)",
 "spondylitis": "التهاب الفقار (التهاب مفصل فقري؛ يتميز بالألم والتصلب)",
 "spondylolisthesis": "انزلاق الفقار (انزلاق أمامي لإحدى الفقرات فوق الفقرة التي تحتها مما يسبب ضغطاً على الأعصاب الشوكية)",
 "sponge": "إِسْفَنْج / سَفِنْج",
 "sponge bag": "حقيبة أدوات النظافة, حقيبة الحمام (حقيبة مقاومة للماء لحفظ أدوات الحمام (الصابون ومعجون الأسنان وما إلى ذلك) أثناء السفر)",
 "sponge bath": "حمام إسفنجي (غسل الجسم بإسفنجة أو قطعة قماش مبللة بدلاً من الغمر في حوض الاستحمام)",
 "sponge cake": "كَعْكَة إسْفَنْجِيَّة (واحدة الكَعْك؛ حَلْوَى تُصْنع من الدَقِيق والحَلِيب والسُكَّر والزَيت ويخبز طريًا وقد يوضع عليه القِشْطَة. يُسمى عند البعض كَيْك وعند البعض تُورْتَة)\nمثال: خبزت كعكة لتوم.",
 "sponge cloth": "قماش إسفنجي (أي قماش ناعم مسامي (خاصة ذو نسج قرص العسل الفضفاض))",
 "sponge filter": "مرشح إسفنجي (مرشح لأحواض السمك مصنوع من الإسفنج الصناعي؛ يأتي بأشكال وأحجام مختلفة)",
 "sponge genus": "جنس إسفنجي (جنس من الإسفنجيات)",
 "sponge gourd": "لوف, ليفة (أي من عدة نباتات متسلقة حولية استوائية لها أزهار صفراء كبيرة وثمار صغيرة صالحة للأكل؛ تُزرع تجارياً للحصول على اللب الليفي المجفف للثمار الناضجة الذي…)",
 "sponge mop": "ممسحة اسفنجية (ممسحة رطبة تستخدم الاسفنج كمادة ماصة)",
 "sponge morel": "غوشنة مألوفة, موريل شائع (موريل صالح للأكل وممتاز ذو رأس كروي إلى مستطيل بنمط غير منتظم من الحفر والنتوءات)",
 "sponge mushroom": "غوشنة مألوفة, موريل شائع (موريل صالح للأكل وممتاز ذو رأس كروي إلى مستطيل بنمط غير منتظم من الحفر والنتوءات)",
 "spongefly": "ذبابة الإسفنج (حشرة مشعرة الجسم تتغذى يرقاتها على إسفنج المياه العذبة)",
 "spongelike": "إِسْفَنْجِيّ (يُشبه الإسفنج في قدرته على امتصاص السوائل وإعادتها عند الضغط) / إسْفَنْجِيّ, طَرِيّ مَطَّاطِيّ (ذو قِوام إسْفَنْجِيّ؛ لَيِّن ومَليء بالمَسامّ)",
 "sponger": "طُفَيْلِيّ, عالَة (تابع يلتصق بمضيف (دون فائدة للمضيف) أملاً في الكسب أو الميزة) / جامع الإسفنج (عامل يعمل لجمع الإسفنج)",
 "spongillafly": "ذبابة الإسفنج (حشرة مشعرة الجسم تتغذى يرقاتها على إسفنج المياه العذبة)",
 "sponginess": "إسفنجية, قابلية الانضغاط (خاصية القدرة على شغل حيز أقل) / إسفنجية (مسامية الإسفنج)",
 "spongioblast": "أرومة إسفنجية (أي من الخلايا الطلائية العمادية المختلفة في الجهاز العصبي المركزي التي تتطور إلى خلايا دبقية عصبية)",
 "spongioblastoma": "ورم أرومي دبقي (ورم دماغي خبيث سريع النمو يتكون من أرومات إسفنجية؛ قاتل تقريبًا دائمًا)",
 "spongy": "إِسْفَنْجِيّ (يُشبه الإسفنج في قدرته على امتصاص السوائل وإعادتها عند الضغط) / إسْفَنْجِيّ, طَرِيّ مَطَّاطِيّ (ذو قِوام إسْفَنْجِيّ؛ لَيِّن ومَليء بالمَسامّ)",
 "sponsor": "رَاعٍ ((رَاعَ) يَرُوعُ رَوْعًا: فَزِعَ؛ يُقال: (راع) منه)\nمثال: سلم إيغور القطيع لراع آخر.",
 "sponsorship": "رعاية, كفالة (فعل الرعاية (سواء رسمياً أو مالياً))",
 "spontaneity": "تِلْقَائِيَّة, عَفْوِيَّة (صفة كون الشيء عفوياً ونابعاً من مشاعر طبيعية دون قيد)\nمثال: عفوية ضحكته",
 "spontaneous": "تِلْقَائِيّ, مُرْتَجَل (يُقال أو يُفعل دون تخطيط أو كتابة مسبقة) / تلقائي, عفوي (يحدث أو ينشأ دون سبب خارجي ظاهر)\nمثال: ضحك عفوي",
 "spontaneous abortion": "إجهاض تلقائي, إسقاط (فقدان طبيعي لنتاج الحمل)",
 "spontaneous combustion": "احتراق ذاتي (اشتعال مادة (مثل الخرق الزيتية) ناتج عن عملية أكسدة داخلية)",
 "spontaneous generation": "تولد ذاتي, نشوء تلقائي (ظاهرة عضوية افتراضية يتم من خلالها إنشاء الكائنات الحية من مواد غير حية)",
 "spontaneously": "ارتجالياً, بشكل عفوي (بدون تحضير مسبق) / بشكل عفوي, تلقائياً (بطريقة عفوية)\nمثال: تحدث ارتجالياً",
 "spontaneousness": "تِلْقَائِيَّة, عَفْوِيَّة (صفة كون الشيء عفوياً ونابعاً من مشاعر طبيعية دون قيد)\nمثال: عفوية ضحكته",
 "spoof": "بَارُودِيَا, مُحَاكَاة سَاخِرَة (تكوين يقلد أو يحرف أسلوب شخص ما، عادة بطريقة فكاهية)",
 "spook": "روح, شبح (تمثيل عقلي لتجربة مؤرقة (كأرواح الموتى)) / شخص منفر, غريب الأطوار (شخص غريب بشكل مزعج أو شاذ)\nمثال: بدا وكأنه رأى شبحاً",
 "spookily": "بِشَكْل مُخِيف, بِشَكْل مُوحِش (بطريقة مخيفة غير طبيعية)\nمثال: كان الجو هادئاً بشكل مخيف في الكنيسة",
 "spooky": "مُخيف, مُخيفة",
 "spool": "بَكَرَة",
 "spoon": "مِلْعَقَة, معلقة (أداة للأكل والاحتساء والطبخ وتقديم الطعام)",
 "spoon bread": "خبز الملعقة (خبز طري مصنوع من دقيق الذرة وأحياناً الأرز أو الذرة المجروشة؛ يجب تقديمه بملعقة)",
 "spoon food": "حمية لينة, طعام لين (نظام غذائي لا يتطلب المضغ؛ ينصح به لمن يعانون من اضطرابات معوية)",
 "spoon-shaped": "مِلْعَقِيّ الشَّكْل (على شكل ملعقة)",
 "spoonbill": "أبو ملعقة (طيور خوض لها منقار طويل مسطح بطرف يشبه الملعقة)",
 "spoonbill catfish": "سلور مسطح الرأس (سلور كبير في وسط الولايات المتحدة له رأس مسطح وفك بارز)",
 "spoondrift": "زبد البحر المتطاير (رذاذ متطاير من سطح البحر)",
 "spoonerism": "تللعثم, سبونرية (تبديل الحروف الساكنة الأولية في زوج من الكلمات)",
 "spoonfeeding": "إطعام بالملعقة, تلقين مبسط (التدريس بطريقة مبسطة للغاية لا تشجع على التفكير المستقل) / إطعام بالملعقة (إطعام شخص (كطفل) من ملعقة)",
 "spoonflower": "قلقاس أمريكي, ياوتيا (نبات لوفي استوائي أمريكي له درنات صالحة للأكل تطهى وتؤكل مثل اليام أو البطاطس)",
 "spoonful": "ملء ملعقَة (هو الكميّة التي يأخذا شيء كالإناء أو الكفّ أو غيره إذا امتلأ بشيء، يستخدم حرفيّا وا)\nمثال: يرجى ملء نموذج طلب الوظيفة المرفق.",
 "spoonie": "سبوني, مريض مزمن",
 "spoonleaf yucca": "إبرة آدم, يوكا خيطية (يوكا بأوراق صلبة طويلة لها زوائد تشبه الخيوط)",
 "spoopy": "مُخِيفٌ بِطُرْفَةٍ ((غير رسمي) مُضْحِكٌ وَمُخِيفٌ فِي آنٍ وَاحِدٍ)",
 "spoor": "أثر, مقتفى (الأثر الذي يتركه شخص أو حيوان؛ ما يتبعه الصياد في مطاردة الطرائد)\nمثال: تبعت كلاب الصيد أثر الثعلب",
 "sporadic": "متفرق, متقطع (يتكرر في حالات متناثرة وغير منتظمة أو غير متوقعة)\nمثال: مدينة تتعرض لغارات قصف متقطعة",
 "sporadically": "بشكل متقطع (بطريقة متقطعة)\nمثال: يعمل بشكل متقطع فقط",
 "sporadicalness": "تشتت, تقطع (صفة كونه نادراً ومشتتاً في الحدوث)\nمثال: تشتت المجموعات يعني أن سيداً واحداً لا يمكنه الاعتماد على التداخل لتنسيق الاستحواذ",
 "sporangiophore": "حامل الأبواغ (ساق تحمل واحدة أو أكثر من الحوافظ البوغية)",
 "sporangium": "كيس الأبواغ, محفظة بوغية (عضو يحتوي على الأبواغ أو ينتجها)",
 "sporanox": "إيتراكونازول, سبورانوكس",
 "spore": "بوغ (جسم تكاثري لاجنسي صغير عادة ما يكون وحيد الخلية تنتجه العديد من النباتات غير الزهرية والفطريات وبعض البكتيريا والأوالي، وهو قادر على التطور إلى فرد…)\nمثال: يتكون البوغ الجنسي بعد اندماج الأمشاج",
 "spore case": "ثمرة بوغية, محفظة أبواغ (فرع ورقي متخصص في بعض السراخس المائية يحيط بالبثرات البوغية أو مجموعات من الحوافظ البوغية) / كيس الأبواغ, محفظة بوغية (عضو يحتوي على الأبواغ أو ينتجها)",
 "spore mother cell": "خلية أم بوغية, خلية أم للأبواغ (خلية يتطور منها البوغ)",
 "spore sac": "كيس الأبواغ, محفظة بوغية (عضو يحتوي على الأبواغ أو ينتجها)",
 "spore-bearing": "بَوْغِيّ, حَامِلٌ لِلْأَبْوَاغِ (يَحْمِلُ الأَبْوَاغَ بَدَلًا مِنْ إِنْتَاجِ البُذُورِ)",
 "sporicidal": "مبيد للأبواغ (مَادَّةٌ كيميائيَّة سَامَّةٌ تُستخدم لإِبَادَةِ الْحَشَرَاتِ والجراثيم)\nمثال: اشترى ياني مبيد النمل.",
 "spork": "سبورك, ملعقة شوكية (علامة تجارية لأداة أكل بلاستيكية لها أسنان وتجويف مثل الملعقة)",
 "sporobolus cryptandrus": "سبوروبولوس رملي (عشبة ملساء منتصبة في الأماكن الرملية في شرق أمريكا الشمالية)",
 "sporobolus poiretii": "عشبة السجاد, عشبة السناج (عشبة موطنها جزر الهند الغربية ولكنها شائعة في جنوب الولايات المتحدة ذات سيقان سلكية معنقدة غالباً ما تكون مصابة بفطر داكن)",
 "sporocarp": "ثمرة بوغية, محفظة أبواغ (فرع ورقي متخصص في بعض السراخس المائية يحيط بالبثرات البوغية أو مجموعات من الحوافظ البوغية)",
 "sporogenous": "بوغي, منتج للأبواغ (ينتج الأبواغ أو يتكاثر بواسطة الأبواغ)",
 "sporophore": "حامل الأبواغ (فرع أو عضو حامل للأبواغ: جزء من مشرة النبات البوغي الذي يطور الأبواغ؛ في السراخس والحزازيات وحشيشة الكبد يعادل عملياً النبات البوغي)",
 "sporophyl": "ورقة بوغية (ورقة في السراخس والحزازيات تحمل الحوافظ البوغية)",
 "sporophyll": "ورقة بوغية (ورقة في السراخس والحزازيات تحمل الحوافظ البوغية)",
 "sporophyte": "طور بوغي, نابت بوغي (الفرد أو الطور المنتج للأبواغ في دورة حياة النبات الذي يمر بتبادل الأجيال)",
 "sporotrichosis": "داء الشعريات المبوغة (عدوى فطرية مزمنة في الجلد والعقد الليمفاوية)",
 "sporozoan": "بوغيات (أوالي طفيلية تكون أبواغاً)",
 "sporozoite": "بوغ حيواني, سبوروزويت (أحد الأجسام الدقيقة النشطة التي تنقسم إليها البوغيات في مرحلة واحدة من دورة حياتها)",
 "sporran": "جراب اسكتلندي, سبوران (جراب من الفرو أو الجلد يُلبس في مقدمة التنورة كجزء من الزي التقليدي لسكان المرتفعات الاسكتلندية)",
 "sport": "رِيَاضَة / ذو روح رياضية (أحد الأسماء الستة، لا يأتي إلا مُضَافًا، بمعنى صاحب) / خلوق\nمثال: كان رجل ذو قامة طويله.",
 "sport car": "سيارة رياضية (سيارة منخفضة صغيرة بمحرك قوي؛ تتسع عادة لشخصين)",
 "sport coat": "بليزر, سترة رياضية (سترة خفيفة الوزن أحادية الصدر؛ غالباً ما تكون مخططة بألوان نادٍ أو مدرسة)",
 "sport fish": "سمك الصيد الرياضي (أي سمكة توفر رياضة للصياد)",
 "sport jacket": "بليزر, سترة رياضية (سترة خفيفة الوزن أحادية الصدر؛ غالباً ما تكون مخططة بألوان نادٍ أو مدرسة)",
 "sport kite": "طائرة ورقية رياضية (طائرة ورقية قابلة للمناورة يتم التحكم فيها بخطين وتطير بكلتا اليدين)",
 "sport shirt": "قميص بولو, قميص رياضي (قميص بأكمام قصيرة مصمم للراحة والارتداء غير الرسمي)",
 "sport utility": "سيارة رياضية متعددة الأغراض (سيارة دفع رباعي عالية الأداء مبنية على هيكل شاحنة)",
 "sport utility vehicle": "سيارة رياضية متعددة الأغراض (سيارة دفع رباعي عالية الأداء مبنية على هيكل شاحنة)",
 "sportfishing": "صيد السمك (فعل شخص يصطاد السمك كتسلية)",
 "sportiness": "رياضية, طابع رياضي (المظهر والسلوك المميز للأشخاص الذين يمارسون الرياضة)",
 "sporting": "مُجَازِف, مُخَاطِر (ينطوي على مخاطرة أو استعداد لتحمّلها) / رِيَاضِيّ, شَرِيف (يُظْهِر أَوْ يَسْتَدْعِي الرُّوحَ الرِّيَاضِيَّة وَاللَّعِبَ النَّظِيف) / مُقَامِر, مُنْغَمِس فِي اللَّهْو (منشغل بالسعي وراء المُتعة وخاصّة ألعاب الحظّ) / رياضي (متعلق بـ أو مستخدم في الرياضة)\nمثال: أحداث رياضية",
