 "space travel": "رِحْلَةٌ فَضَائِيَّة",
 "space vehicle": "سفينة فضاء, مركبة فضائية (مركبة قادرة على السفر في الفضاء الخارجي؛ تقنياً، قمر صناعي حول الشمس)",
 "space walk": "سير في الفضاء (أي نوع من النشاط البدني خارج المركبة الفضائية يقوم به أحد أفراد الطاقم)",
 "space writer": "كاتب بالمساحة (كاتب يتقاضى أجره حسب مساحة المادة المكتوبة)",
 "space-reflection symmetry": "تكافؤ, حفظ التكافؤ ((فيزياء) التكافؤ محفوظ في كون تكون فيه قوانين الفيزياء هي نفسها في نظام إحداثيات يمني كما في نظام يساري)",
 "space-time": "زمكان, متصل مكاني زماني (نظام الإحداثيات رباعي الأبعاد (3 أبعاد للمكان و1 للزمان) الذي تقع فيه الأحداث الفيزيائية)",
 "space-time continuum": "زمكان, متصل مكاني زماني (نظام الإحداثيات رباعي الأبعاد (3 أبعاد للمكان و1 للزمان) الذي تقع فيه الأحداث الفيزيائية)",
 "spacecraft": "مَرْكَبَةٌ فَضَائِيَّة",
 "spacecraft clock time": "توقيت ساعة المركبة الفضائية (وقت الساعة المعروض بواسطة ساعة محمولة على متن مركبة فضائية)",
 "spacecraft event time": "وقت حدث المركبة الفضائية (التوقيت العالمي المنسق على متن المركبة الفضائية)\nمثال: وقت حدث المركبة = وقت الإرسال + وقت الضوء في اتجاه واحد",
 "spaced": "مُتَبَاعِد, مُفَصَّل (بَيْنَهُ مَسَافَاتٌ فَاصِلَة) / متباعد (مرتب مع وجود مسافات بين الأجزاء)\nمثال: عينان متباعدتان",
 "spaced-out": "تَائِه, شَارِد الذِّهْن (مُشوَّش أو فاقد الاتّجاه كأنّه تحت تأثير مخدّر) / ذَاهِل, مُشَوَّشُ الذِّهْن (فَاقِدُ التَّرْكِيزِ بِسَبَبِ مُخَدِّرٍ أَوْ مَا يُشْبِهُه)",
 "spacefaring": "رحلة فضائية, سفر عبر الفضاء (رحلة خارج الغلاف الجوي للأرض)",
