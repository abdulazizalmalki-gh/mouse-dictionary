 "sob story": "قِصَّة اسْتِعْطَاف, قِصَّة حَزِينَة (قصة عاطفية (أو دراما) عن ضائقة شخصية؛ مصممة لإثارة التعاطف)",
 "sob stuff": "قِصَّة اسْتِعْطَاف, قِصَّة حَزِينَة (قصة عاطفية (أو دراما) عن ضائقة شخصية؛ مصممة لإثارة التعاطف)",
 "soba": "سُوبَا",
 "sobbing": "شهيق البكاء, نشيج (شهقة تشنجية تحدث أثناء البكاء)",
 "sobbingly": "بانتحاب, بنشيج (مع التنهدات والبكاء)\nمثال: اعترف المراهق بنشيج بقتل الطفل",
 "sober": "صَاحٍ (صاتَ بأقصى طاقته وأعلى صوته، يستخدم للحيّ ولا يقال صاح للجماد؛ عليه: ناداه)\nمثال: سأساعدك يا صاح.",
 "sober up": "صَحَا (أَفَاقَ؛ اِسْتَيْقَظَ)",
 "sobering": "دَاعٍ إِلَى الجِدِّيَّة, مُنَبِّه (يميل إلى جعل المرء أكثر جدّية ورصانة)",
 "soberly": "برزانة, بوقار (بطريقة جادة ورصينة)\nمثال: مشى بوقار نحو المذبح",
 "soberness": "رصانة, وقار (أسلوب جاد ورزين) / رزانة, صحو (حالة كونه صاحياً وغير مسكر بالكحول)",
 "sobersided": "جَادّ, صَارِم (يفتقر كلّيًّا إلى الفكاهة أو خفّة الروح)",
 "sobersides": "جَادّ, شَخْص رَزِين (شخص جاد ورزين)",
 "sobralia": "سوبراليا (أي من بساتين الفاكهة المبهرجة المختلفة من جنس سوبراليا ذات سيقان ورقية وزهور وحيدة أو عنقودية زاهية الألوان مشابهة لتلك الموجودة في جنس كاتليا)",
 "sobriety": "اعتدال, رصانة (الامتناع عن الإفراط) / رصانة, وقار (أسلوب جاد ورزين) / رصانة, صحو (الاعتدال في أو الامتناع عن الكحول أو المخدرات الأخرى) / رزانة, صحو (حالة كونه صاحياً وغير مسكر بالكحول)",
 "sobriquet": "كنية, لقب تحبب (اسم مألوف لشخص (غالباً نسخة مختصرة من الاسم الأول للشخص))\nمثال: لم تستخدم والدة جو كنيته وكانت تناديه دائماً جوزيف",
 "socage": "حيازة زراعية, سوكاج (حيازة الأرض عن طريق الخدمة الزراعية أو دفع الإيجار؛ غير مثقلة بالخدمة العسكرية)",
 "soccer": "كُرَةُ الْقَدَم",
 "soccer ball": "كرة قدم (كرة منفوخة تستخدم في لعب كرة القدم)",
 "soccer field": "ملعب كرة قدم (ملعب رياضي ذو أبعاد محددة لممارسة كرة القدم)",
 "soccer player": "لاعب كرة قدم (رياضي يلعب كرة القدم)",
 "sochi": "سُوتْشِي",
 "sociability": "ألفة, حب الاختلاط (الميل النسبي أو الاستعداد ليكون المرء اجتماعياً أو يختلط بأقرانه)",
 "sociable": "أَنِيس, اجْتِمَاعِيّ (وَدُودٌ وَلَطِيفٌ فِي المُعَامَلَةِ) / أليف, أنيس (يميل إلى الرفقة مع الآخرين أو يؤدي إليها) / تجمع اجتماعي, لقاء تعارفي (حفلة تجمع الناس لتعزيز الروابط الاجتماعية والنشاط الجماعي)\nمثال: مناسبة اجتماعية",
 "sociableness": "ألفة, حب الاختلاط (الميل النسبي أو الاستعداد ليكون المرء اجتماعياً أو يختلط بأقرانه)",
 "sociably": "بألفة, باجتماعية (بطريقة اجتماعية ومحبة للمخالطة) / بشكل اجتماعي, بود (بطريقة اجتماعية)\nمثال: دعا الجيران الجدد بود الجميع في الحي لتناول القهوة",
 "social": "مُجْتَمَعِيّ, اِجْتِمَاعِيّ",
 "social action": "إجراء اجتماعي, عمل اجتماعي (سياسة اجتماعية للإصلاح (خاصة الإصلاح الاجتماعي والاقتصادي))",
 "social activity": "نَشَاط اِجْتِمَاعِيّ (نشاط يعتبر مناسباً في المناسبات الاجتماعية)",
 "social affair": "حدث اجتماعي, حفل (تجمع اجتماعي رسمي أو احتفال للناس)\nمثال: كانت الحفلة حدثاً مهماً حقاً",
 "social anthropologist": "عالم أنثروبولوجيا اجتماعية, عالم أنثروبولوجيا ثقافية (عالم أنثروبولوجيا يدرس الظواهر الثقافية مثل أنظمة القرابة)",
 "social anthropology": "أنثروبولوجيا اجتماعية, أنثروبولوجيا ثقافية (فرع الأنثروبولوجيا الذي يتعامل مع الثقافة والمجتمع البشري)",
 "social anxiety": "رُهَاب اِجْتِمَاعِيّ",
 "social anxiety disorder": "اِضْطِرَاب الْقَلَقِ الاِجْتِمَاعِي",
 "social assistance": "إعانة تكميلية, مساعدة اجتماعية (مزايا تُدفع لرفع الدخل إلى الحد الأدنى للمستويات التي يحددها القانون)",
 "social class": "طبقة, طبقة اجتماعية (مجموعة من الناس لديهم نفس الوضع الاجتماعي أو الاقتصادي أو التعليمي)\nمثال: الطبقة العاملة",
 "social climber": "متسلق اجتماعي (شخص يسعى للوجاهة الاجتماعية من خلال التملق)",
 "social club": "جمعية, رابطة (رابطة رسمية لأشخاص لديهم اهتمامات مماثلة)\nمثال: انضم إلى نادي الجولف",
 "social contract": "عَقْد اِجْتِمَاعِيّ (العَشْر من السَنَوَات؛ الاتِّفَاق والعَهْد بين طرفين)\nمثال: أمضى زيري العقد.",
