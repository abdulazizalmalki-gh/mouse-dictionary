 "sort": "نَوْع (صِنْف؛ في : وحدة تصنيفية أقل من الجنس) / فَرَزَ\nمثال: انه نوع من الفطر.",
 "sort of": "إلى حد ما, نسبياً (إلى حد (كبير أو صغير) ما)\nمثال: كان الجو بارداً نوعاً ما",
 "sort program": "برنامج فرز (برنامج خدمي يرتب عناصر البيانات)",
 "sorted": "مُجَمَّع, مُرَتَّب (تمّ تجميعه أو فرزه في مجموعات) / مُرَتَّبٌ حَسَبَ الْحَجْمِ, مُصَنَّف (مرتّب وفقًا للحجم)",
 "sorter": "آلة فرز (آلة لفرز الأشياء (مثل البطاقات المثقوبة أو الرسائل) إلى فئات) / فارز (كاتب يقوم بفرز الأشياء (مثل الرسائل في مكتب البريد))",
 "sortie": "طلعة جوية ((عسكرية) رحلة تشغيلية لطائرة واحدة (كما في عملية عسكرية)) / خروج للقوات المحاصرة, طلعة جوية (عمل عسكري تندفع فيه القوات المحاصرة من موقعها)",
 "sorting": "تصنيف, فرز (التجميع حسب الفئة أو النوع أو الحجم) / تصنيف, تويب (العملية المعرفية الأساسية للترتيب في فئات أو أصناف) / تصنيف, فرز (عملية تفصل العناصر إلى مجموعات وفقاً لمعيار محدد)\nمثال: عنق الزجاجة في تسليم البريد هو عملية الفرز",
 "sorting algorithm": "خوارزمية الفرز (خوارزمية لفرز قائمة)",
 "sorting program": "برنامج فرز (برنامج خدمي يرتب عناصر البيانات)",
 "sortition": "اقتراع, قرعة (اتخاذ قرار بالصدفة باستخدام القرعة (قش أو حصى وغيرها) التي يتم رميها أو سحبها)",
 "sorus": "بثرة بوغية, كويمة بوغية (مجموعة من الحوافظ البوغية عادة على الجانب السفلي لسعفة السرخس) / بثرة (بنية منتجة للأبواغ في بعض الأشنات والفطريات)",
 "sos": "إشارة استغاثة, سوس (إشارة استغاثة معترف بها دولياً في شفرة الراديو)",
 "soshnik": "سكة المحراث الروسي, سوشنيك (سكة محراث حديدية تشكل جزءاً من المحراث الروسي التقليدي (سوخا))",
 "sot": "سكير, مدمن خمر (شخص يشرب الخمر بشكل مزمن)",
 "sotadic verse": "شعر سوطادي, شعر معكوس (شعر متناظر (يقرأ من الاتجاهين بنفس المعنى أو اللفظ)، سمي نسبة للشاعر اليوناني سوتاديس)",
 "soteriological": "خلاصي (مكون من أو متعلق بعلم الخلاص (اللاهوتي))",
 "soteriology": "سوتيريولوجيا, علم الخلاص (فرع من اللاهوت المسيحي يتعامل مع الخلاص كأثر لفعل إلهي)",
 "sotho": "سوثو (من أو متعلق بأي من مجموعة لغات السوثو) / سوتو (أي من لغات البانتو الجنوبية المفهومة بشكل متبادل للسوتو في بوتسوانا وجنوب أفريقيا وليسوتو) / سُوتُو (عضو في شعب البانتو الذين يسكنون بوتسوانا وليسوتو وشمال جنوب أفريقيا)\nمثال: مصنفات الأسماء في السوثو",
 "sotho language": "سوتو (أي من لغات البانتو الجنوبية المفهومة بشكل متبادل للسوتو في بوتسوانا وجنوب أفريقيا وليسوتو)",
 "sottish": "سِكِّير, مُدْمِن الخَمْر (مُنْغَمِس فِي شُرْب الكُحُول أَوْ يَتَّسِم بِهِ)",
 "sottishly": "بذهول السكر, كالثمل (بطريقة السكير)",
 "sottishness": "إدمان الشرب (عدم التحفظ في استخدام الكحول) / ذهول السكر (ذهول ناتج عن الشراب)",
 "sotto voce": "بِصَوْت خَافِت (بنبرة منخفضة)\nمثال: نطق بلعنة بصوت خافت",
 "sou": "سو (عملة فرنسية سابقة ذات فئة منخفضة؛ غالباً ما تستخدم لأي مبلغ صغير من المال)\nمثال: ليس لديه سو واحد باسمه",
 "sou'-east": "باتجاه الجنوب الشرقي (إلى أو نحو أو في الجنوب الشرقي) / الجَنُوب الشَّرْقِيّ (نقطة البوصلة في منتصف المسافة بين الجنوب والشرق؛ عند 135 درجة)",
 "sou'-sou'-east": "باتجاه الجنوب الجنوب الشرقي (إلى أو نحو أو في الجنوب الجنوب الشرقي) / الجَنُوب الجَنُوبِيّ الشَّرْقِيّ, جَنُوب جَنُوب شَرْق (نقطة البوصلة في منتصف المسافة بين الجنوب والجنوب الشرقي)",
 "sou'-sou'-west": "باتجاه الجنوب الجنوب الغربي (إلى أو نحو أو في الجنوب الجنوب الغربي) / الجَنُوب الجَنُوبِيّ الغَرْبِيّ, جَنُوب جَنُوب غَرْب (نقطة البوصلة في منتصف المسافة بين الجنوب والجنوب الغربي)",
 "sou'-west": "الجَنُوب الغَرْبِيّ (نقطة البوصلة في منتصف المسافة بين الجنوب والغرب؛ عند 225 درجة)",
 "sou'easter": "رياح جنوبية شرقية (رياح قوية من الجنوب الشرقي)",
 "sou'west": "باتجاه الجنوب الغربي (إلى أو نحو أو في الجنوب الغربي)",
 "sou'wester": "قبعة الصيادين (قبعة مقاومة للماء ذات حافة مائلة واسعة تكون أطول من الخلف منها من الأمام) / رياح جنوبية غربية (رياح قوية من الجنوب الغربي)",
 "souari": "جوز السواري, سواري (شجرة دائمة الخضرة كبيرة من أمريكا الجنوبية ذات أوراق ثلاثية وثمار حسلة ببذور تشبه الجوز تستخدم كغذاء ومصدر لزيت الطهي)",
 "souari nut": "جوز سواري (بذرة كبيرة تشبه الجوز لشجرة من أمريكا الجنوبية) / جوز السواري, سواري (شجرة دائمة الخضرة كبيرة من أمريكا الجنوبية ذات أوراق ثلاثية وثمار حسلة ببذور تشبه الجوز تستخدم كغذاء ومصدر لزيت الطهي)",
 "souari tree": "جوز السواري, سواري (شجرة دائمة الخضرة كبيرة من أمريكا الجنوبية ذات أوراق ثلاثية وثمار حسلة ببذور تشبه الجوز تستخدم كغذاء ومصدر لزيت الطهي)",
 "soubise": "سوبيز, صلصة البصل الأبيض (صلصة فيلوتيه مع بصل مفروم مقلي وكريمة خفق)",
 "soubrette": "سوبريت (دور نسائي ثانوي كخادمة جريئة ومغازلة في كوميديا) / فتاة لعوب (فتاة شابة وقحة أو مغازلة)",
 "soubriquet": "كنية, لقب تحبب (اسم مألوف لشخص (غالباً نسخة مختصرة من الاسم الأول للشخص))\nمثال: لم تستخدم والدة جو كنيته وكانت تناديه دائماً جوزيف",
 "souchong": "سوشونغ (نوعية فاخرة من الشاي الأسود موطنه الصين)",
 "souffle": "سوفليه (طبق خفيف وهش من صفار البيض وبياض البيض المخفوق بشدة ومخلوط مع الجبن أو السمك أو الفاكهة)",
 "souffle-like": "شَبِيهٌ بِالسُّوفْلِيه (يُشْبِهُ السُّوفْلِيه فِي قِوَامِه)",
 "soufflé": "نَّفيخة",
 "soughing": "حَفِيف, هَمْهَمِيّ (يتميز بأصوات ناعمة وخافتة)",
 "soughingly": "بحفيف, بهمس (بصوت ناعم)\nمثال: تحركت أغصان الأشجار بحفيف في النسيم",
 "sought": "مَبْحُوث عَنْه, مَنْشُود (يُبحَث عنه ويُسعى إليه) / مطلوب, منشود (الذي يتم البحث عنه)\nمثال: الأقارب المنشودون طويلاً",
 "sought after": "مَرْغُوب, مَطْلُوب (مَطْلُوبٌ كَثِيرًا)",
 "sought-after": "مَرْغُوب, مَطْلُوب (مَطْلُوبٌ كَثِيرًا)",
 "souk": "سوق (سوق مفتوح في مدينة عربية)",
 "soul": "رُوح, نَفْس (رَوَّحَ عليه بالمِرْوحَة: حَرَّكَها ليجلبَ إِليه نسيمَ الهواء؛ رَوَّحَ بالقوم: صلَّى بهم التراويح) / سول\nمثال: كان سامي هو روح الحفلة.",
 "soul brother": "أخ, رفيق (رجل أسود زميل)",
 "soul food": "طعام الروح (طعام يؤكل تقليدياً من قبل الأمريكيين من أصل أفريقي في الجنوب الأمريكي)",
 "soul kiss": "قبلة عميقة, قبلة فرنسية (قبلة بفم مفتوح يتم فيها إدخال اللسان في فم الآخر)",
 "soul mate": "توأم الروح (شخص تشعر تجاهه بانسجام عميق)",
 "soul patch": "عنفقَة",
 "soul-destroying": "مُحَطِّمٌ لِلرُّوحِ (مُدَمِّرٌ لِلرُّوحِ أَوِ النَّفْسِ)",
 "soul-searching": "تحليل ذاتي, محاسبة النفس (فحص دقيق لمعتقداتك ودوافعك)",
 "soul-stirring": "مُثِير, مُحَرِّك لِلْمَشَاعِر (يثير مشاعر قوية لكنها غير مزعجة)",
 "soulful": "رُوحَانِيّ, مُفْعَمٌ بِالإِحْسَاس (ملیء بالعاطفة العميقة أو معبّر عنها)",
 "soulfully": "بشكل معبر, بعمق روحي (بطريقة مليئة بالمشاعر العميقة)\nمثال: نظر إليها بعمق",
 "soulfulness": "روحانية, عاطفة عميقة (شعور أو عاطفة عميقة)",
 "soulless": "بِلَا رُوح, جَامِد المَشَاعِر (يفتقر إلى الحساسية أو القدرة على المشاعر العميقة)",
 "soullessly": "بلا إحساس, بلا روح (بطريقة خالية من الروح والمشاعر)\nمثال: كانوا يسعون بلا روح وراء الربح",
 "soulmate": "تَوْأَم رُوح",
 "sound": "سليم / صَوْت, صوت (أكثر من إحداث الصوت؛ بالغ في إحداث الصوت؛ في : صاح نوحا أو استغاثة) / صَوَّتَ, طَلَّع صوت (أكثر من إحداث الصوت؛ بالغ في إحداث الصوت؛ في : صاح نوحا أو استغاثة)\nمثال: اقرأ بصوت عالي.",
 "sound alphabet": "أبجدية صوتية (أبجدية من الرموز تهدف إلى تمثيل أصوات الكلام المحددة)",
 "sound barrier": "حاجز الصوت (الزيادة في الكبح الديناميكي الهوائي (مقاومة الهواء) عندما تقترب الطائرة من سرعة الصوت)",
 "sound bite": "مقتطف صوتي (خطاب قصير جداً؛ عادة في الإذاعة أو التلفزيون)",
 "sound bow": "حافة الجرس, قوس الصوت (نقطة التلامس (الجزء من الجرس) التي يضرب عليها المصفق)",
 "sound camera": "كاميرا صوتية (كاميرا سينمائية تسجل الأصوات بالتزامن مع الصور المرئية)",
 "sound effect": "مُؤَثِّر صَوْتِيّ",
 "sound engineer": "مُهَنْدِس صَوْت (الذي يمارس مهنة الهَنْدَسَة)\nمثال: أبي مهندس مدني.",
 "sound film": "فيلم صوتي, فيلم ناطق (فيلم سينمائي تم تسجيل المؤثرات الصوتية والحوار عليه)",
 "sound hole": "فتحة الصوت (ثقب في لوحة الصوت (كما في الكمان) مصمم لتردد النغمات)",
 "sound isolation": "عَزْل الضَّوْضَاء (فَصَلَ، فرَز، أَبْعَدَ؛ أَبْعَدَ، نَحَّى)\nمثال: جو بايدن طالب الكونغرس بعزل ترامب.",
 "sound judgement": "تقدير, حكم (القدرة على تقييم المواقف أو الظروف بذكاء واستخلاص استنتاجات سليمة)",
 "sound judgment": "تقدير, حكم (القدرة على تقييم المواقف أو الظروف بذكاء واستخلاص استنتاجات سليمة)",
 "sound law": "قانون صوتي (قانون يصف التغيرات الصوتية في تاريخ لغة ما)",
 "sound perception": "إدراك سمعي (إدراك الصوت كظاهرة ذات معنى)",
 "sound plural": "جَمْع سَالِم (ضَمَّ، لَمَّ، حَشَدَ؛ في : أَضَافَ أعدادا إلى غيرها)\nمثال: جمع خيل هو خيول.",
 "sound pollution": "تلوث سمعي, تلوث ضوضائي (ضوضاء بيئية مزعجة وربما ضارة)",
 "sound pressure": "ضغط الصوت (الفرق بين الضغط اللحظي عند نقطة في مجال صوتي والضغط المتوسط عند تلك النقطة)",
 "sound pressure level": "قدرة صوتية, مستوى ضغط الصوت (الشدة الفيزيائية للصوت)",
 "sound projection": "إسقاط صوتي, إيصال الصوت (الظاهرة الصوتية التي تعطي الصوت جودة اختراقية)\nمثال: صُممت آلات القيثارة الخاصة بنا لتتمتع بصوت وإسقاط صوتي فائق",
 "sound property": "خاصية صوتية, سمة صوتية (صفة متعلقة بالصوت)",
 "sound ranging": "تحديد المدى الصوتي (تحديد موقع مصدر الصوت (مثل مدفع العدو) عن طريق قياس الوقت الذي يصل فيه الصوت إلى ميكروفونات في مواقع معروفة)",
 "sound recording": "تسجيل صوتي (تسجيل للإشارات الصوتية)",
 "sound reflection": "تردد الصدى, صدى (تكرار الصوت الناتج عن انعكاس الموجات الصوتية)\nمثال: كانت تستطيع سماع أصداء خطواتها",
 "sound reproduction": "إعادة إنتاج الصوت, استنساخ الصوت (إعادة إنتاج الصوت)",
 "sound spectrograph": "مرسمة الطيف الصوتي (مرسمة طيف للأطياف الصوتية)",
 "sound spectrum": "طيف صوتي (توزيع الطاقة كدالة للتردد لمصدر صوت معين)",
 "sound structure": "بنية الكلمة, صرف (الترتيب المقبول للأصوات في الكلمات)",
 "sound system": "نظام صوت, نظام صوتي (نظام من المعدات الإلكترونية لتسجيل أو إعادة إنتاج الصوت)",
 "sound technician": "فني صوت (فني مسؤول عن تضخيم الصوت أو إنتاج المؤثرات الصوتية (كما في البث التلفزيوني أو الإذاعي))",
 "sound truck": "شاحنة دعاية صوتية (شاحنة مجهزة بمكبر صوت وتستخدم للإعلان)",
 "sound unit": "وحدة صوت (أي وحدة قياس صوتية)",
 "sound wave": "مَوْجَة صَوْتِيَّة",
 "soundable": "قابل لقياس العمق, قابل للسبر ((عن العمق) قادر على أن يسبر أو يقاس عمقه)",
 "soundboard": "لوحة الرنين, لوحة الصوت (رنان موسيقي يتكون من لوح رقيق تعزز اهتزازاته صوت الآلة)",
 "soundbox": "جسم الآلة, صندوق الصوت (حجرة رنين في آلة موسيقية (مثل جسم الكمان))",
 "sounder": "جهاز سبر, مسبار صوتي (جهاز لعمل عمليات السبر)",
 "sounding": "ذُو صَوْت, مُصَوِّت (يُصدر صوتاً أو ذو صوت محدد؛ يُستخدم كلاحقة تركيبية) / سبر الغور (فعل قياس عمق الماء (عادة باستخدام حبل السبر)) / رَنَّان, مُصَوِّت (ذو حجم صوتي أو عمق) / ذُو صَوْت, ذُو مَظْهَر (يبدو كما يُوصَف؛ يُستخدَم عادةً في التراكيب المركّبة)",
 "sounding board": "لوحة الرنين, لوحة الصوت (رنان موسيقي يتكون من لوح رقيق تعزز اهتزازاته صوت الآلة) / صَدَى, مُسْتَشَار لِقِيَاس الرَّأْي (شخص تُستخدم ردود أفعاله تجاه شيء ما كمؤشر على مدى قبوله)\nمثال: سأستخدم الصحفيين كمستشارين لقياس ردود الفعل تجاه مثل هذه السياسات",
 "sounding lead": "ثقل السبر (ثقل معدني في نهاية خيط السبر)",
 "sounding line": "حبل السبر, خيط السبر ((مصطلح بحري) خيط شاقول لتحديد العمق)",
 "sounding rocket": "صاروخ السبر (صاروخ بحثي يستخدم للحصول على معلومات حول الغلاف الجوي على ارتفاعات مختلفة)",
 "soundless": "سَاكِن, هَادِئ (يتّسم بغياب الصوت تمامًا)",
 "soundlessly": "بصمت, بلا ضجيج (بدون صوت)\nمثال: وقف بصمت ودون كلام وانزلق عبر الردهة ومن خلال الباب",
 "soundlessness": "انعدام الصوت, هدوء (خاصية عدم إصدار أي صوت)",
 "soundly": "بشكل جيد, بقوة (كلياً وبالكامل) / بثقل, بعمق (بعمق أو بشكل كامل)\nمثال: هُزم شر هزيمة",
 "soundman": "فني صوت, مهندس صوت (فني ذكر مسؤول عن تضخيم الصوت أو إنتاج المؤثرات الصوتية (كما في البث التلفزيوني أو الإذاعي))",
 "soundness": "تماسك, سلامة (التوتر العضلي للأنسجة السليمة) / حِكْمَة, رَجَاحَة (صفة التعقل والحصافة) / سلامة, متانة (حالة أو وضع الخلو من التلف أو التحلل)\nمثال: تماسكه العضلي",
 "soundproof": "عَازِل لِلصَّوْت (لا ينفذ منه الصوت)",
 "soundtrack": "مسار الصوت (تسجيل صوتي على شريط ضيق من فيلم سينمائي)",
 "soundwoman": "فنية صوت, مهندسة صوت (فنية أنثى مسؤولة عن تضخيم الصوت أو إنتاج المؤثرات الصوتية (كما في البث التلفزيوني أو الإذاعي))",
 "soup": "شُورَبَة (في : هي الحَسَاء) / شُرْبَة / حَسَاء\nمثال: هل مذاق الشوربة جيد؟",
 "soup bowl": "زبدية حساء, طبق شوربة (وعاء لتقديم الحساء)",
 "soup du jour": "حَساء اليَوْم",
 "soup kitchen": "تكية, مطعم الفقراء (مكان يتم فيه توزيع الطعام على المحتاجين)",
 "soup ladle": "مغرفة حساء (مغرفة لتقديم الحساء)",
 "soup plate": "طبق الحساء (طبق عميق ذو حافة عريضة)",
 "soup spoon": "ملعقة حساء (ملعقة ذات وعاء مستدير لتناول الحساء)",
 "soup-fin": "قرش حساء الزعانف (قرش في المحيط الهادئ يُقدر لزعانفه (التي يستخدمها الصينيون في الحساء) وكبده (الغني بفيتامين أ))",
 "soup-strainer": "شَارِب (مصطلح عامي للشارب)",
 "soupcon": "ذرة, رشة (كمية طفيفة ولكن محسوسة)\nمثال: هذا الطبق يحتاج لمسة من الثوم",
 "soupfin": "قرش حساء الزعانف (قرش في المحيط الهادئ يُقدر لزعانفه (التي يستخدمها الصينيون في الحساء) وكبده (الغني بفيتامين أ))",
 "soupfin shark": "قرش حساء الزعانف (قرش في المحيط الهادئ يُقدر لزعانفه (التي يستخدمها الصينيون في الحساء) وكبده (الغني بفيتامين أ))",
 "soupiness": "ابتذال عاطفي, عاطفية مفرطة (عاطفي زائف بطريقة عاطفية مبالغ فيها) / دسامة, قوام كريمي (خاصية امتلاك كثافة القشدة الثقيلة)",
 "soupspoon": "مِلْعَقَة اَلْحَسَاء (أداة للأكل والاحتساء والطبخ وتقديم الطعام)",
 "soupy": "رَكِيكُ الحِسّ, مُبْتَذَلُ العَاطِفَة (مُفرِط في العاطفة بشكل مُتصنَّع أو غير صادق) / حَسَائِيّ (ذُو قِوَامٍ وَمَظْهَرٍ يُشْبِهُ الحَسَاء)",
 "souq": "سُوق (مكان للبيع والشراء؛ جمع ساق، قال الله تعالى: 《رُدُّوهَا عَلَيَّ فَطَفِقَ مَسْحًا بِالسُّوقِ وَالْأَعْنَاقِ》)\nمثال: ذهبت إلى السوق.",
 "sour": "حَامِض",
 "sour bread": "خبز العجين المخمر (مصنوع باستخدام بادئة من كمية صغيرة من العجين ينشط فيها التخمير)",
 "sour cherry": "كرز حامض, وشنة (كرز حامضي يستخدم للفطائر والمربيات) / كرز حامض أسترالي (شجرة أسترالية ذات ثمار حمراء حامضة) / كرز حامض (شجرة أوراسية صغيرة نوعاً ما تنتج فاكهة حمضية صالحة للأكل حمراء إلى سوداء)",
 "sour cherry tree": "كرز حامض (شجرة أوراسية صغيرة نوعاً ما تنتج فاكهة حمضية صالحة للأكل حمراء إلى سوداء)",
 "sour cream": "كْرِيم حَامِض (نبيل النفس عزيزها ذو الخلق العالي والخير الكثير والعطاء السخي. الكَرَم يشمل مجموعة من الأخلاق أهمها العطاء؛ الجَوَاد السخيّ تحديدا)\nمثال: يا لك من رجل كريم!",
 "sour dock": "حميض الحدائق, حميض حامض (حميض أوروبي بأوراق سهمية كبيرة حمضية قليلاً يزرع في جميع أنحاء المنطقة المعتدلة الشمالية للسلطة والخضروات الربيعية)",
 "sour fig": "أصابع العروس, تين هوتنتوت (نبات عصاري منخفض النمو في جنوب أفريقيا له ثمرة كبسولية تحتوي على لب صالح للأكل)",
 "sour gourd": "أدنسونية غريغورية (فاكهة أسترالية تشبه القرع حامضة الطعم ذات قشرة خشبية وبذور كبيرة) / باوباب, ثمرة التبلدي (فاكهة أفريقية تشبه القرع ذات لب صالح للأكل) / أدانسونية غريغورية, شجرة كريم الترتار (شجرة أسترالية لها ثمرة حمضية مقبولة تشبه القرع)",
 "sour grapes": "حِصْرِم",
 "sour grass": "حماض, حميض (أي من الأعشاب الضارة الخشنة المعينة ذات الجذور الوتدية الطويلة، تستخدم أحياناً كخضروات مائدة أو في الطب الشعبي)",
 "sour gum": "صمغ أسود, صمغ حامض (شجرة عمودية من شرق أمريكا الشمالية لها أطراف أفقية وأوراق صغيرة تظهر متأخرة في الربيع وتكتسب لوناً رائعاً في أوائل الخريف)",
 "sour mash": "ويسكي الهريس الحامض (أي ويسكي مقطر من الهريس الحامض) / نقيع حامض (نقيع ذو حموضة مثالية لتخمير الخميرة؛ خليط من نقيع قديم وجديد؛ يستخدم في تقطير بعض أنواع الويسكي)",
 "sour mash whiskey": "ويسكي الهريس الحامض (أي ويسكي مقطر من الهريس الحامض)",
 "sour milk": "رَائِب",
 "sour orange": "برتقال مر, نارنج (برتقال شديد الحموضة يستخدم خاصة في المربى) / برتقال إشبيلية, برتقال حامض (أي من أشجار البرتقال الشائعة المختلفة التي تنتج فاكهة حامضة أو مرة؛ تستخدم كأصل للتطعيم)",
 "sour salt": "ملح الليمون (بلورات حمض الستريك تستخدم للتتبيل)",
 "sour-tasting": "حَامِضُ المَذَاق (ذُو طَعْمٍ حَامِضٍ حِمْضِيّ)",
 "sourball": "كرة حامضة (قطعة مستديرة من الحلوى الصلبة اللاذعة)",
 "source": "مَصْدَر, مَصَادِر (مَصْدَر) / عَيْن (المُعَايَنَة والمشاهدة؛ العين : حاسة البصر والرؤية - مؤنث - تكون للإنسان وغيره من الحيوان . قال ابن السكيت : العين التي يبصر بها الناظر…) / مَصْدَر (مَصْدَر)\nمثال: ما مصدر هذا الخوف؟",
