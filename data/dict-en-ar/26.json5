 "state trooper": "شُرْطِيّ الوِلايَة (ضابط شرطة تابع للولاية)",
 "state with limited recognition": "دولة غير معترف بها, دولة محدودة الاعتراف (إقليم يتمتع بسيادة فعلية ولكنه يفتقر إلى الاعتراف الدولي)",
 "state's attorney": "مدعي الولاية (محامي ادعاء لولاية)",
 "state's evidence": "دليل الادعاء, شاهد ملك (دليل للادعاء في الإجراءات الجنائية)",
 "state-controlled": "تَحْت سَيْطَرَة الدَّوْلَة, جَمَاعَوِيّ (يَتَبَنَّى مَبْدَأ المِلْكِيَّة الجَمَاعِيَّة لِلشَّعْب)",
 "state-of-the-art": "بِأَحْدَث التِّقْنِيَّات (على أعلى مستوى من التطوّر في وقت معيّن (خاصة الوقت الحالي))",
 "state-sponsored terrorism": "إرهاب ترعاه الدولة (إرهاب تمارسه حكومة ضد شعبها أو لدعم الإرهاب الدولي)",
 "state-supported": "مَدْعُوم حُكُومِيًّا (مدعوم ومُشغَّل من قِبَل حكومة الدولة)",
 "statecraft": "حنكة سياسية (الحكمة في إدارة الشؤون العامة)",
 "stated": "مُصَرَّح بِه, مُعْلَن (مُعْلَن كحقيقة؛ مذكور صراحةً)",
 "statehouse": "دار الولاية, مبنى برلمان الولاية (مبنى حكومي يجتمع فيه المجلس التشريعي للولاية)",
 "stateless": "بِلَا وَطَن, عَدِيم الجِنْسِيَّة (بلا جنسية أو مواطنة)",
 "stateless person": "شخص بلا جنسية, نازح (شخص أجبر على الفرار من منزله أو بلده)",
 "stateliness": "جَلَال, شُمُوخ (الهيبة في الحجم أو التناسب) / جلال, فخامة (أسلوب متقن لعمل شيء ما)\nمثال: قدمت القهوة بفخامة كبيرة",
 "stately": "مَهِيب, وَقُور (رَاقٍ أَوْ مَهِيب فِي السُّلُوك أَوِ المَظْهَر؛ يَلِيق بِبَلَاط مَلَكِيّ) / فَخْم, مَهِيب (مُثير للإعجاب في الحجم أو الأسلوب أو المظهر) / أَشْبَه بِالتِّمْثَال, مَهِيب القَامَة (ذو حجم ووقار يوحيان بالتماثيل)",
 "stately home": "قصر تاريخي, منزل فخم (قصر تشغله (أو كانت تشغله سابقاً) عائلة أرستقراطية)",
 "statement": "تَصْرِيح, بَيَان",
 "stater": "ساكن ولاية (مقيم في ولاية معينة أو مجموعة من الولايات) / ستاتر (أي من العملات الفضية أو الذهبية المختلفة لليونان القديمة)\nمثال: ساكن ولاية كيستون (بنسلفانيا)",
 "stateroom": "غرفة فاخرة, قمرة خاصة (قمرة للضيوف)",
 "states general": "المجلس العمومي, الولايات العامة (جمعية تمثل فئات دولة بأكملها، وخاصة الهيئة السيادية للجمهورية الهولندية من القرن السادس عشر إلى الثامن عشر)",
 "states' rights": "حقوق الولايات (الحقوق الممنوحة للولايات بموجب دستور الولايات المتحدة) / حقوق الولايات (مذهب يرى وجوب تقليص السلطات الفيدرالية وإعادتها إلى الولايات الفردية)",
 "states' rights democratic party": "الحزب الديمقراطي لحقوق الولايات, ديكسيكراتس (حزب سياسي سابق في الولايات المتحدة؛ شكله ديمقراطيون من الولايات الجنوبية عام 1948 لمعارضة ترشيح هاري إس ترومان)",
 "statesman": "رَجُل دَوْلَة (العُضْو في جسد الإنسان يتكون من القَدَم والسَاق والفُخْذ. الجمع أرجُل، وقد تقول العامّة رِجْلين ورجْلينات؛ القَدَم من باب اطلاق اسم الكل على الجزء)\nمثال: هذا الرجل تاجر.",
 "statesmanlike": "حكيم سياسياً, كفؤ كرجل دولة (يتميز بصفات رجل الدولة أو يليق به)\nمثال: رجل ذو حكم يليق برجل دولة",
 "statesmanly": "حكيم سياسياً, كفؤ كرجل دولة (يتميز بصفات رجل الدولة أو يليق به)\nمثال: رجل ذو حكم يليق برجل دولة",
 "statesmanship": "حنكة سياسية (الحكمة في إدارة الشؤون العامة)",
 "stateswoman": "سيدة دولة (امرأة قائدة محترمة في الشؤون الوطنية أو الدولية)",
 "statewide": "عَلَى مُسْتَوَى الوِلَايَة (يحدث أو يمتدّ في أنحاء الولاية كلّها)",
 "static": "سَاكِن, مُسْتَقِرّ (لا يُظهر تغيّرًا يُذكر إن وُجد) / ثَابِت, جَامِد (ليس في حالة حركة جسدية) / كهروستاتيكي, كهروسكوني (معني بـ أو منتج لـ أو ناتج عن الكهرباء الساكنة) / تَشْوِيش, نَقْد غَاضِب (نقد غاضب)\nمثال: مولد كهروستاتيكي ينتج كهرباء ساكنة عالية الجهد",
 "static electricity": "كهرباء ساكنَة",
 "static line": "حبل التثبيت التلقائي, حبل ثابت (حبل يستخدم بدلاً من حبل الفتح لفتح المظلة؛ يُربط أحد طرفيه بالطائرة والآخر بحقيبة المظلة، ويفتح المظلة بعد قفز المظلي من الطائرة)",
 "static magnet": "مغناطيس دائم (مغناطيس يحتفظ بمغنطته بعد إزالته من المجال المغناطيسي)",
 "static tube": "أنبوب ساكن (أداة قياس تستخدم لقياس الضغط الساكن في تيار من السوائل)",
 "statice": "لافندر البحر, ليمونيوم (أي من نباتات مختلفة من جنس ليمونيوم في المستنقعات الملحية المعتدلة لها سنابل من الزهور البيضاء أو البنفسجية الباهتة)",
 "statics": "إستاتيكا, علم السكون (فرع الميكانيكا المعني بالقوى في حالة توازن)",
 "statin": "دواء خافض للدهون, ستاتين",
 "statin drug": "دواء خافض للدهون, ستاتين",
 "station": "إِذَاعَة, مَحَطَّة إِذَاعِيَّة",
 "station agent": "مدير المحطة, ناظر المحطة (الشخص المسؤول عن محطة السكك الحديدية)",
 "station house": "قسم شرطة, مركز شرطة (محطة تعمل كمقر للشرطة في منطقة معينة؛ وتخدم كمكان يتم منه إرسال رجال الشرطة وإحضار الأشخاص المقبوض عليهم إليه)",
 "station keeper": "رَقِيب المَكْتَب, ضابِط النُّوبِتْجِيَّة (رقيب الشرطة المناوب في مركز الشرطة)",
 "station of the cross": "مرحلة درب الصليب (تمثيل لأي من المراحل الأربع عشرة في رحلة المسيح إلى الجلجثة)",
 "station waggon": "ستيشن واغن, سيارة عائلية (سيارة ذات جسم طويل وباب خلفي مع مساحة خلف المقعد الخلفي)",
 "station wagon": "ستيشن واغن, سيارة عائلية (سيارة ذات جسم طويل وباب خلفي مع مساحة خلف المقعد الخلفي)",
 "stationariness": "استقرار, ثبات (البقاء في المكان)",
 "stationary": "سَاكِن, غَيْر مُتَحَرِّك (لَا يُمْكِن تَحْرِيكُه) / ثَابِت المَوْقِع, مُسْتَقِرّ (واقف في مكانه دون حركة)",
 "stationary stochastic process": "عملية عشوائية مستقرة (عملية عشوائية يكون فيها توزيع المتغيرات العشوائية هو نفسه لأي قيمة للمتغير البارامتري)",
 "stationary wave": "موجة راكدة, موجة موقوفة (موجة (كموجة صوتية في غرفة أو موجة كهرومغناطيسية في خط نقل) لا تتغير فيها نسبة سعتها اللحظية عند نقطة واحدة إلى تلك الموجودة عند أي نقطة أخرى بمرور…)",
 "stationer": "صاحب مكتبة قرطاسية, قرطاسي (تاجر يبيع مواد الكتابة واللوازم المكتبية)",
 "stationery": "قِرْطَاسِيَّة",
 "stationery seller": "صاحب مكتبة قرطاسية, قرطاسي (تاجر يبيع مواد الكتابة واللوازم المكتبية)",
 "stationmaster": "مدير المحطة, ناظر المحطة (الشخص المسؤول عن محطة السكك الحديدية)",
 "stations": "درب الصليب, مراحل درب الصليب ((الكنيسة الكاثوليكية) تعبد يتكون من أربع عشرة صلاة تقال أمام سلسلة من الصور أو المنحوتات التي تمثل أحداثاً متتالية لرحلة المسيح من بيت بيلاطس إلى…)",
 "stations of the cross": "درب الصليب, مراحل درب الصليب ((الكنيسة الكاثوليكية) تعبد يتكون من أربع عشرة صلاة تقال أمام سلسلة من الصور أو المنحوتات التي تمثل أحداثاً متتالية لرحلة المسيح من بيت بيلاطس إلى…)",
 "statistic": "اِحْصَائِيَّة",
 "statistical": "إِحْصَائِيّ",
 "statistical commission": "اللجنة الإحصائية (لجنة المجلس الاقتصادي والاجتماعي للأمم المتحدة المعنية بالبيانات الإحصائية من الدول الأعضاء)",
 "statistical distribution": "توزيع, توزيع إحصائي ((إحصاء) ترتيب لقيم متغير يوضح تكرار حدوثها الملحوظ أو النظري)",
 "statistical mechanics": "ميكانيكا إحصائية (فرع الفيزياء الذي يقدم تنبؤات نظرية حول سلوك الأنظمة الماكروسكوبية بناءً على القوانين الإحصائية التي تحكم جسيماتها المكونة)",
 "statistical method": "إجراء إحصائي, طريقة إحصائية (طريقة لتحليل أو تمثيل البيانات الإحصائية؛ إجراء لحساب إحصائية)",
 "statistical procedure": "إجراء إحصائي, طريقة إحصائية (طريقة لتحليل أو تمثيل البيانات الإحصائية؛ إجراء لحساب إحصائية)",
 "statistical regression": "انحدار, انحدار إحصائي",
 "statistical table": "جدول إحصائي, جدول إكتواري (جدول للبيانات الإحصائية)",
 "statistically": "إحصائياً (فيما يتعلق بالإحصاء)\nمثال: هذا مستحيل إحصائياً",
 "statistician": "إحصائي, خبير اكتواري (شخص متمكن من جمع وتفسير البيانات الرقمية (خاصة من يستخدم الإحصاء لحساب أقساط التأمين)) / إحصائي, عالم إحصاء (عالم رياضيات يتخصص في الإحصاء)",
 "statistics": "عِلْم اَلْإِحْصَاء, إِحْصَائِيَّات (أَدْرَكَ حقيقة الشيء) / إِحْصَائِيَّة, إِحْصَاء\nمثال: أدرس علم النفس.",
 "stative": "ثُبُوتِيّ, سُكُونِيّ ((يستخدم للأفعال ومعظم الصفات المشتقة) يعبر عن وجود أو حالة بدلاً من فعل)",
 "stator": "عضو ثابت (جهاز ميكانيكي يتكون من الجزء الثابت من محرك أو مولد يدور فيه أو حوله الدوار)",
 "stator coil": "عضو ثابت (جهاز ميكانيكي يتكون من الجزء الثابت من محرك أو مولد يدور فيه أو حوله الدوار)",
 "statoscope": "ستاتوسكوب, مقياس تغير الارتفاع (أداة تشير إلى التغيرات الصغيرة في ارتفاع الطائرة عن طريق تسجيل التغيرات الصغيرة في الضغط الجوي)",
 "statuary": "تمثالي (متعلق بالتماثيل أو مناسب لها) / تماثيل, مجموعة تماثيل (التماثيل مجتمعة)",
 "statue": "تِمْثال, دُمْيَة",
 "statue maker": "مثّال, نحات (فنان يبدع المنحوتات)",
 "statue of liberty": "تِمْثَال الْحُرِّيَّة",
 "statuesque": "فَارِع, كَالتِّمْثَال (يُوحي بتمثال في مهابته وتناسقه) / أَشْبَه بِالتِّمْثَال, مَهِيب القَامَة (ذو حجم ووقار يوحيان بالتماثيل)",
 "statuette": "بيبلو, تمثال صغير (تمثال صغير منحوت أو مقولب)",
 "stature": "طول, قامة ((لشخص واقف) المسافة من الرأس إلى القدم) / قامة, منزلة رفيعة (مستوى عالٍ من الاحترام يتم اكتسابه من خلال التطور أو الإنجاز المثير للإعجاب)\nمثال: رجل ذو قامة عظيمة",
 "status": "تَرْتِيب, دَرَجَة (تنظيم الأشياء أو الأحداث في تسلسل معين أو وضعها في نظام؛ إعداد أو تجهيز شيء لتحقيق غاية معينة) / حَال, حَالَة (تحول أو تغيّر من حالٍ إلى حالٍ؛ اعترض أو فصل بين شيئين)\nمثال: أعاد زيري ترتيب المطبخ كلية.",
 "status asthmaticus": "حالة ربوية (نوبة ربو طويلة وشديدة لا تستجيب للعلاج القياسي)",
 "status epilepticus": "حالة صرعية (حالة تحدث فيها نوبات صرع مستمرة دون فترات من الوعي؛ يمكن أن تؤدي إلى تلف الدماغ والموت)",
