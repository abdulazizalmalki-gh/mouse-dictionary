 "sorbus aucuparia": "روان, شجرة الروان (شجرة أوراسية ذات ثمار تشبه التوت برتقالية حمراء)",
 "sorbus domestica": "شجرة الخدمة, غبيراء (شجرة أوروبية متوسطة الحجم تشبه الروان ولكنها تحمل فاكهة صالحة للأكل)",
 "sorbus sitchensis": "مران الجبل الغربي (مران من الساحل الغربي لأمريكا الشمالية)",
 "sorbus torminalis": "شجرة الخدمة البرية (شجرة أوروبية تحمل فاكهة بنية صغيرة مرقطة صالحة للأكل)",
 "sorcerer": "سَاحِر",
 "sorceress": "سَاحِرَة",
 "sorcerous": "سِحْرِيّ, شَعْوَذِيّ (يمتلك أو يستخدم قوى خارقة للطبيعة أو يتسم بها)",
 "sorcery": "سِحْر (ألقى السحر على شخص أو شيء، بمعنى جعله تحت تأثير السحر؛ أدهش أو أبهر بجمال أو جاذبية غير عادية)\nمثال: هذا هو سحر الجزائر.",
 "sordid": "بَخِيل, دَنِيء (بخيل وطمّاع بشكل وضيع) / بَائِس, مُزْرٍ (قذر ومتهالك ومنفّر) / لَا أَخْلَاقِيّ, وَضِيع (غَيْرُ أَخْلَاقِيٍّ أَوْ غَيْرُ نَزِيه) / رَذِيلٌ, قَذِرٌ (منحط أخلاقياً)",
 "sordidly": "بخسة, بقذارة (بطريقة دنيئة أو قذرة)",
 "sordidness": "حقارة, خسة (عدم الجدارة بسبب الافتقار إلى القيم العليا) / دناءة, قذارة (قذارة دنيئة)",
 "sordino": "كاتم صوت الكمان (كاتم صوت للكمان)",
 "sore": "مُوجِع, مُؤْلِم / سَعْفَة",
 "sore throat": "اِلْتِهَاب حَلْق",
 "sore-eyed": "مُلْتَهِب العَيْنَيْن (يُعاني مِن التِهاب أو تَهَيُّج في العَيْنَيْن)",
 "sorehead": "حَنِق, شَخْص نَكِد (شخص نكد أو مستاء)",
 "sorely": "بشدة, للغاية (إلى حد كبير) / بألم, بوجع (في حالة ألم أو كما لو كان متألماً)\nمثال: افتقدته بشدة",
 "soreness": "انزعاج, ضيق (شعور غير مريح بالألم العقلي أو الضيق) / ألم عند اللمس, إيلام (ألم يتم الشعور به (كما هو الحال عند لمس المنطقة))\nمثال: يتم الحصول على أفضل النتائج بشكل عام عن طريق إدخال الإبرة في نقطة الإيلام القصوى",
