 "sorex cinereus": "زباب مقنع (أكثر أنواع الزباب شيوعاً في الموائل الرطبة في أمريكا الشمالية)",
 "sorex palustris": "زباب الماء الأمريكي (زباب ماء من أمريكا الشمالية)",
 "sorgho": "سورغم حلو, سورغو (أي من عدة أنواع من السورغم تزرع كمصدر للشراب)",
 "sorghum": "ذُرَة, سرغوم",
 "sorghum bicolor": "ذرة بيضاء, سورغم (مهم لغذاء الإنسان والحيوان؛ عادة النمو وشكل الساق يشبه الذرة الهندية ولكن بأوراق مسننة الحواف)",
 "sorghum halepense": "عشب جونسون, عشب حلب (عشب معمر طويل ينتشر عن طريق الجذامير الزاحفة ويزرع للعلف؛ متوطن في جنوب الولايات المتحدة حيث يعتبر آفة خطيرة في الأراضي المزروعة)",
 "sorghum molasses": "دبس السورغم, سورغم (مصنوع من عصير السورغم الحلو)",
 "sorghum vulgare caudatum": "فيتيريتا (سورغم سوداني له حبوب بيضاء ناعمة كبيرة بشكل استثنائي)",
 "sorghum vulgare roxburghii": "شالو (سورغم له سيقان جافة نحيلة وحبوب صلبة صغيرة؛ أدخل إلى الولايات المتحدة من الهند)",
 "sorghum vulgare technicum": "ذرة المكانس (أعشاب طويلة تزرع للنورة المتفرعة الصلبة الممدودة المستخدمة للمكانس والفرش)",
 "sorgo": "سورغم حلو, سورغو (أي من عدة أنواع من السورغم تزرع كمصدر للشراب)",
 "sororal": "أُخْتِيّ",
 "sororal nephew": "اِبْنِ الاُخْت (الولد الذكر)\nمثال: هو له ابن صغير.",
 "sororal niece": "بِنْت اَلْأُخْت",
 "sorority": "أخوية نسائية (نادي اجتماعي للطالبات الجامعيات)",
 "soros": "سوروس",
 "sorption": "امتزاز, تشارب (العملية التي تأخذ فيها مادة مادة أخرى أو تمسك بها (سواء عن طريق الامتصاص أو الامتزاز))",
 "sorrel": "حُمَّاض بُسْتَانِيّ / أَشْقَر (هو لون الشُقْرَة، وأصله اللون الأحمر المائل إلى الصُفرة ثم أصبح يطلق على ما كان لونه أصفر أيضا؛ صفة ما كان لونه الشُقرة)\nمثال: أنا لديها شعر بني كستنائي, ولكن ماجدالينا لديها شعر أشقر.",
 "sorrel tree": "شجرة الحميض (شجرة أسترالية ذات أوراق حمضية) / خشب حامض, شجرة الحميض (شجرة شجيرية متساقطة الأوراق من شرق أمريكا الشمالية لها لحاء متشقق بعمق وعناقيد من الزهور البيضاء العطرية الصغيرة وأوراق حامضة الطعم)",
 "sorrento": "سُورِّينْتُو",
 "sorriness": "بَخْس, تَفَاهَة (انعدام القيمة بسبب الضآلة)",
 "sorrow": "حُزْن (يقالُ: أَصابَهُ حَزَنٌ شَديدٌ وحُزْنٌ شَديدٌ:(الهَمُّ)؛ حَزِنَ الرّجل : اغْتَمَّ ، حزِنت المرأة:لبست السّواد)\nمثال: شعر توم بالحزن.",
 "sorrower": "ثاكِل, حَزِين (شخص يشعر بالحزن (خاصة الحزن على شخص مات))",
 "sorrowful": "مُحْزَن",
 "sorrowfully": "بِأَسًى, بِحُزْن (مع الحزن؛ بطريقة حزينة) / بأسى, بحزن (بطريقة حزينة)\nمثال: نظرت إليه والدته بحزن عندما أخبرها أنه انضم للجيش",
 "sorrowfulness": "حزن, كآبة (حالة من الأسى الكئيب) / أسى, حزن (حالة الشعور بالحزن)\nمثال: سئمت من حزنه الدائم",
