 "softball": "الكرة اللينة, سوفتبول (لعبة تشبه البيسبول إلى حد كبير تُلعب في ملعب أصغر وبكرة أكبر) / سوفتبول, كرة لينة (الكرة المستخدمة في لعب السوفتبول)",
 "softball game": "الكرة اللينة, سوفتبول (لعبة تشبه البيسبول إلى حد كبير تُلعب في ملعب أصغر وبكرة أكبر)",
 "softened": "مَكْتُوم, مُخَفَّف (أصبح أو جُعل أكثر نعومة أو أقل علواً أو وضوحاً) / مُخَفَّفُ اللَّهْجَة, مُلَطَّف (خُفِّفَتْ حِدَّتُهُ وَلُطِّفَ تَأْثِيرُه)",
 "softener": "ملين, منعم (مادة تضاف إلى مادة أخرى لجعلها أقل صلابة)",
 "softening": "مُلَطِّف, مُلَيِّن (يُنَعِّم ويُلَيِّن البَشَرَة أو الأنْسِجَة) / تليين (عملية التحول إلى شيء أكثر ليونة)\nمثال: أخر التبريد تليين الفاكهة",
 "softheaded": "أَحْمَق, طَائِش (سخيف وعديم الجدوى تماماً)",
 "softhearted": "رقيق القلب, طيب القلب (سهل التأثر بالشفقة أو الحزن)\nمثال: قاضٍ رقيق القلب",
 "softheartedness": "حنان, رقة قلب (شعور بالاهتمام برفاهية شخص ما (خاصة شخص لا حول له ولا قوة))",
 "softie": "رقيق القلب, عاطفي (شخص ضعيف وعاطفي بشكل مفرط)",
 "softish": "شِبْه لَيِّن, لَيِّن نَوْعًا ما (بَيْن اللِّين والصَّلابَة؛ طَرِيّ إلى حَدٍّ ما)",
 "softly": "بصوت خافت, بهدوء (بحجم صوت منخفض) / بخفة, برفق (بقليل من الوزن أو القوة) / بشكل خافت, بنعومة (توجيه في الموسيقى؛ للعزف بنعومة وهدوء نسبي) / برقة, بنعومة (بطريقة ترضي الحواس)\nمثال: تحدث بهدوء ولكن احمل عصا غليظة",
 "softness": "نُعُومَة",
 "software": "بَرْمَجِيَات, بَرَامِج حَاسِب",
 "software documentation": "توثيق, وثائق البرمجيات (قوائم البرامج أو الأدلة الفنية التي تصف تشغيل واستخدام البرامج)",
 "software engineer": "مبرمج, مبرمج حاسوب (شخص يصمم ويكتب ويختبر برامج الحاسوب)",
 "software error": "خطأ برمجي (خطأ ناتج عن كود سيء في برنامج ما مشارك في إنتاج النتيجة الخاطئة)",
 "software optimisation": "تحسين البرمجيات (عملية تعديل نظام برمجي لجعل جانب منه يعمل بكفاءة أكبر أو يستخدم موارد أقل)\nمثال: مع مرور الوقت، ارتفعت الرهانات في تحسين البرمجيات والامتثال بشكل كبير مع تكاثر أنواع التراخيص وازدياد تعقيدها",
 "software optimization": "تحسين البرمجيات (عملية تعديل نظام برمجي لجعل جانب منه يعمل بكفاءة أكبر أو يستخدم موارد أقل)\nمثال: مع مرور الوقت، ارتفعت الرهانات في تحسين البرمجيات والامتثال بشكل كبير مع تكاثر أنواع التراخيص وازدياد تعقيدها",
 "software package": "حزمة برمجية, منتج برمجي (سلعة تتكون من برنامج حاسوب معروض للبيع) / برمجية, برنامج حاسوبي ((علم الحاسوب) برامج مكتوبة أو إجراءات أو قواعد والوثائق المرتبطة بها والتي تتعلق بتشغيل نظام الحاسوب وتُخزن في ذاكرة القراءة/الكتابة)\nمثال: من المتوقع أن يتوسع سوق البرمجيات",
 "software product": "حزمة برمجية, منتج برمجي (سلعة تتكون من برنامج حاسوب معروض للبيع)",
 "software program": "برمجية, برنامج حاسوبي ((علم الحاسوب) برامج مكتوبة أو إجراءات أو قواعد والوثائق المرتبطة بها والتي تتعلق بتشغيل نظام الحاسوب وتُخزن في ذاكرة القراءة/الكتابة)\nمثال: من المتوقع أن يتوسع سوق البرمجيات",
 "software system": "برمجية, برنامج حاسوبي ((علم الحاسوب) برامج مكتوبة أو إجراءات أو قواعد والوثائق المرتبطة بها والتي تتعلق بتشغيل نظام الحاسوب وتُخزن في ذاكرة القراءة/الكتابة)\nمثال: من المتوقع أن يتوسع سوق البرمجيات",
 "softwood": "خشب لين (خشب يسهل نشره (من الصنوبريات مثل الصنوبر أو التنوب))",
 "softy": "رقيق القلب, عاطفي (شخص ضعيف وعاطفي بشكل مفرط)",
 "sogdian": "صُغْدِيّ",
 "sogginess": "تشبع بالماء, رطوبة شديدة (بلل ثقيل)",
 "soggy": "بَلِيد, خَامِل (بطيء ولا مُبالٍ) / عَجينِيّ, غَيْر مُخْتَمِر (ذو قِوام العَجين بِسَبَب قِلَّة التَّخْمير أو سوء الطَّبْخ) / مُسْتَنْقَعِيّ, وَحِل ((عن التربة) ليّنة ومشبَعة بالماء)",
 "soh": "صول (المقطع الذي يسمي النغمة الخامسة لأي سلم موسيقي في الصولفيج)",
 "soi-disant": "مُتَسَمٍّ, مُدَّعٍ (كما يدّعيه المرء لنفسه في كثير من الأحيان دون مبرّر)",
 "soigne": "بَالِغُ العِنَايَة, مَصْقُول (مصقول وحسن الهندام؛ يُظهر أناقة راقية)",
 "soignee": "بَالِغُ العِنَايَة, مَصْقُول (مصقول وحسن الهندام؛ يُظهر أناقة راقية)",
 "soil": "تُرْبَة, أَرْض / اِتَّسَخَ",
 "soil bank": "بنك التربة (الأرض التي تم سحبها من زراعة المحاصيل وزُرعت بمحاصيل بناء التربة؛ تُدفع الإعانات الحكومية للمزارعين مقابل أراضيهم المسحوبة)",
 "soil conditioner": "محسن التربة (مادة كيميائية تستخدم لتحسين بنية التربة وزيادة مساميتها)\nمثال: يمكن استخدام الجبس كمحسن للتربة",
 "soil conservation": "حفظ التربة (حماية التربة من التعرية أو التدهور)",
 "soil erosion": "انجراف التربة (جرف التربة عن طريق تدفق المياه)",
 "soil horizon": "أفق التربة (طبقة في قطاع التربة)",
 "soil pipe": "أنبوب الصرف الصحي (مصرف ينقل النفايات السائلة من المراحيض، إلخ)",
 "soil profile": "قطاع التربة (قطاع رأسي للتربة من سطح الأرض إلى الصخر الأم)",
 "soil sifter": "غربال التربة, منخل التراب (نوع من الغرابيل يستخدم في البستنة لإزالة العناصر الكبيرة غير المرغوب فيها من التربة)",
 "soil-building": "مُحَسِّن لِلتُّرْبَة ((عن المحاصيل) يُزرع لتحسين جودة التربة)",
 "soiled": "قَذِر, مُتَّسِخ (متسخ أو من المحتمل أن يتسخ بالأوساخ أو القذارة)\nمثال: أرصفة قذرة غير مكنوسة",
 "soiling": "تلويث, توسيخ (فعل توسيخ شيء ما)",
 "soilure": "تلويث, توسيخ (فعل توسيخ شيء ما)",
 "soiree": "أمسية, سهرة (حفلة يجتمع فيها الناس في المساء (عادة في منزل خاص))",
 "soiree musicale": "أمسية موسيقية (سهرة تُقام لغرض الاستماع إلى الموسيقى)",
 "soixante-neuf": "تسعة وستون (جنس فموي يمارسه شخصان في نفس الوقت)",
 "soja": "صويا, فول الصويا (عشب حولي منتصب كثيف الشعر له أوراق ثلاثية وزهور أرجوانية إلى وردية؛ يزرع على نطاق واسع للغذاء والعلف ولتحسين التربة، وخاصة لبذوره المغذية الغنية…)",
 "soja bean": "صويا, فول الصويا (عشب حولي منتصب كثيف الشعر له أوراق ثلاثية وزهور أرجوانية إلى وردية؛ يزرع على نطاق واسع للغذاء والعلف ولتحسين التربة، وخاصة لبذوره المغذية الغنية…)",
 "sojourn": "إِقَامَة",
 "sojourner": "مقيم مؤقت (ساكن مؤقت)",
 "sokha": "محراث سوخا (محراث عودي خشبي خفيف، يتكون من محراثين عوديين، بحيث تشكل عوارضهما المتوازية ذراعي جر لمركبة حراثة يجرها حصان واحد مع سكتين)\nمثال: يكيف محراث سوخا المحراث العودي ليتناسب مع سرج حيوان واحد باتباع نمط عربة تجرها الحيوانات ويضيف مكوناً يشبه المجرفة لقلب التربة",
 "sokoro": "سوكورو (لغة تشادية يتم التحدث بها في تشاد في منطقة غويرا)",
 "sokoro language": "سوكورو (لغة تشادية يتم التحدث بها في تشاد في منطقة غويرا)",
 "solace": "سلوى, عزاء (فعل المواساة؛ تقديم الراحة وتخفيف الحزن أو البلاء) / سلوان, عزاء (الراحة التي تشعر بها عند المواساة في أوقات خيبة الأمل) / سلوى, عزاء (راحة في خيبة الأمل أو البؤس)\nمثال: كان وجوده مواساة لها",
 "solacement": "سلوان, عزاء (الراحة التي تشعر بها عند المواساة في أوقات خيبة الأمل) / سلوى, عزاء (راحة في خيبة الأمل أو البؤس)\nمثال: لم يكن المركز الثاني عزاءً له",
 "solan": "أطيش شمالي (أطيش أبيض كبير جداً ذو أطراف أجنحة سوداء)",
 "solan goose": "أطيش شمالي (أطيش أبيض كبير جداً ذو أطراف أجنحة سوداء)",
 "solanaceous": "باذنجاني (مكون من أو متعلق بنباتات الفصيلة الباذنجانية (فصيلة البطاطس))",
 "solanaceous vegetable": "خضراوات باذنجانية (أي من ثمار نباتات العائلة الباذنجانية؛ وخاصة من أجناس المغد والفليفلة والطماطم)",
 "solandra guttata": "زهرة البوق, سولاندرا (نبات متسلق دائم الخضرة مكسيكي له زهور صفراء عطرة كبيرة قمعية الشكل مفردة مع حواف بنية أرجوانية في الحلق)",
 "solanopteris bifrons": "سرخس البطاطا (سرخس هوائي صغير من أمريكا الجنوبية بانتفاخات درنية على طول الجذامير)",
 "solant goose": "أطيش شمالي (أطيش أبيض كبير جداً ذو أطراف أجنحة سوداء)",
 "solanum aviculare": "تفاح الكنغر, مغد الطيور (نبات حولي أسترالي يزرع أحياناً لعناقيد زهوره الأرجوانية وثماره الصفراء البيضاوية الصالحة للأكل)",
 "solanum burbankii": "توت العجائب, عنب الذيب البستاني (صنف حديقة محسن من عنب الذيب الأسود يحمل ثماراً برتقالية أو سوداء صغيرة صالحة للأكل)",
 "solanum carolinense": "قراص الحصان, مغد كاروليني (عشب خشن شائك له زهور صفراء شاحبة وثمار صفراء تشبه التوت؛ شائع في جميع أنحاء جنوب وشرق الولايات المتحدة)",
 "solanum commersonii": "بطاطس أوروغواي (كرمة بطاطس من أمريكا الجنوبية)",
 "solanum crispum": "شجرة البطاطس, مغد مجعد (شجيرة متسلقة قوية من تشيلي تزرع للزينة لزهورها العطرة؛ ليست بطاطس حقيقية)",
 "solanum dulcamara": "عنب الديب, مغد حلو ومر (كرمة معمرة سامة من العالم القديم لها زهور بنفسجية وتوت أحمر مرجاني بيضاوي؛ عشب ضار واسع الانتشار في أمريكا الشمالية)",
 "solanum elaeagnifolium": "باذنجان بري, مغد فضي الأوراق (نبات مغد ضار بأوراق فضية وزهور بنفسجية أو زرقاء أو بيضاء؛ تستخدم ثمرته المستديرة على نطاق واسع لتخثير الحليب؛ من وسط الولايات المتحدة إلى أمريكا…)",
 "solanum giganteum": "مغد عملاق, هولي أفريقي (شجيرة شجرية ثنائية الحول بساق صوفية من إفريقيا الاستوائية وجنوب آسيا لها فروع شائكة بيضاء فضية، وعناقيد من الزهور الزرقاء أو البيضاء، وتوت أحمر ساطع…)",
 "solanum jamesii": "بطاطس برية (نبات معمر قائم أو منتشر في جنوب غرب الولايات المتحدة والمكسيك يحمل درنات صغيرة بنية شاحبة إلى قشدية اللون تشبه البطاطس)",
 "solanum jasmoides": "كرمة البطاطس, ياسمين البطاطس (كرمة كثيرة التفرع من البرازيل ذات أوراق متساقطة وأزهار بيضاء مشوبة بالزرقة)",
 "solanum macranthum": "شجرة البطاطا (شجيرة أو شجرة صغيرة من أمريكا الجنوبية تزرع على نطاق واسع في المناطق الاستوائية؛ ليست بطاطا حقيقية)",
 "solanum melanocerasum": "توت العجائب, عنب الذيب البستاني (صنف حديقة محسن من عنب الذيب الأسود يحمل ثماراً برتقالية أو سوداء صغيرة صالحة للأكل)",
 "solanum melongena": "باذنجان (عشب مشعر قائم موطنه جنوب شرق آسيا ولكنه يزرع على نطاق واسع لفاكهته اللحمية اللامعة الكبيرة المستخدمة عادة كخضروات)",
 "solanum nigrum": "عنب الديب, مغد أسود (عشب أوراسي تم توطينه في أمريكا له زهور بيضاء وأوراق مشعرة سامة ويحمل توتاً أسود يكون ساماً أحياناً ولكنه صالح للأكل أحياناً أخرى)",
 "solanum nigrum guineese": "توت العجائب, عنب الذيب البستاني (صنف حديقة محسن من عنب الذيب الأسود يحمل ثماراً برتقالية أو سوداء صغيرة صالحة للأكل)",
 "solanum pseudocapsicum": "كرز الشتاء, كرز القدس (شجيرة صغيرة من أمريكا الجنوبية تزرع كنبات منزلي لثمارها الحمراء أو الصفراء الزخرفية الوفيرة ولكن السامة بحجم الكرز)",
 "solanum quitoense": "مغد كيتوني, نارنجيلا (شجيرة معمرة صغيرة تزرع في مرتفعات أمريكا الجنوبية لثمارها البرتقالية الزاهية الصالحة للأكل التي تشبه الطماطم أو البرتقال)",
 "solanum rostratum": "مغد منقاري (مغد من أمريكا الشمالية بأوراق شائكة وزهور صفراء عنقودية)",
 "solanum tuberosum": "بطاطا, بطاطس (نبات حولي موطنه أمريكا الجنوبية له سيقان جارية تحت الأرض تحمل درنات نشوية صالحة للأكل؛ يزرع على نطاق واسع كخضروات حدائق؛ السيقان سامة)",
 "solanum wendlandii": "كرمة البطاطس العملاقة (كرمة من كوستاريكا مسلحة بشكل متناثر بأشواك تشبه الخطاف ولها أزهار زرقاء ليلكية كبيرة)",
 "solanum wrightii": "شجرة البطاطا (شجيرة أو شجرة صغيرة من أمريكا الجنوبية تزرع على نطاق واسع في المناطق الاستوائية؛ ليست بطاطا حقيقية)",
 "solar": "شَمْسِيّ",
 "solar apex": "أوج شمسي, قمة (النقطة على الكرة السماوية التي تبدو الشمس والنظام الشمسي وكأنهما يتحركان نحوها بالنسبة للنجوم الثابتة)",
 "solar array": "بطارية شمسية, مصفوفة شمسية (جهاز كهربائي يتكون من مصفوفة كبيرة من الخلايا الشمسية المتصلة)",
 "solar battery": "بطارية شمسية, مصفوفة شمسية (جهاز كهربائي يتكون من مصفوفة كبيرة من الخلايا الشمسية المتصلة)",
 "solar calendar": "تقويم شمسي (تقويم يعتمد على الدورات الشمسية)",
 "solar cell": "خلية شمسية, خلية كهروضوئية (خلية تحول الطاقة الشمسية إلى طاقة كهربائية)",
 "solar collector": "طبق شمسي, مجمع شمسي (مرآة مقعرة تركز أشعة الشمس؛ يمكن أن تنتج درجات حرارة عالية)",
 "solar constant": "ثَابِت شَمْسِيّ (المعدل الذي يتم به استقبال الطاقة الشمسية الإشعاعية عند الطبقة الخارجية للغلاف الجوي للأرض)",
 "solar day": "أربع وعشرون ساعة, يوم (الوقت الذي تستغرقه الأرض للقيام بدورة كاملة حول محورها)\nمثال: غادروا بعد يومين",
 "solar dish": "طبق شمسي, مجمع شمسي (مرآة مقعرة تركز أشعة الشمس؛ يمكن أن تنتج درجات حرارة عالية)",
 "solar eclipse": "كُسُوف اَلشَّمْس",
 "solar energy": "طاقة شمسية, قدرة شمسية (طاقة من الشمس يتم تحويلها إلى طاقة حرارية أو كهربائية)\nمثال: يتم تحديد كمية الطاقة الساقطة على الأرض بواسطة الثابت الشمسي، ولكن لم يتم الاستفادة إلا قليلاً جداً من الطاقة الشمسية",
 "solar facula": "شعلة شمسية (بقعة ساطعة كبيرة على الغلاف الضوئي للشمس تحدث غالباً بالقرب من البقع الشمسية)",
 "solar flare": "اِنْفِجَار شَمْسِيّ",
 "solar furnace": "طبق شمسي, مجمع شمسي (مرآة مقعرة تركز أشعة الشمس؛ يمكن أن تنتج درجات حرارة عالية)",
 "solar gravity": "جاذبية شمسية (جاذبية الشمس)\nمثال: تخلق الجاذبية الشمسية ضغوطاً ودرجات حرارة قصوى",
 "solar halo": "حلقة شمسية, هالة شمسية (هالة مضيئة موازية للأفق عند ارتفاع الشمس؛ تسببها بلورات الجليد في الغلاف الجوي)",
 "solar heater": "سخان شمسي (سخان يستخدم الطاقة الشمسية بشكل مباشر)",
 "solar house": "منزل شمسي (منزل مصمم لاستخدام الإشعاع الشمسي للتدفئة؛ عادة ما يكون له مساحات زجاجية كبيرة أمام مواد ماصة للحرارة)",
 "solar magnetic field": "مجال مغناطيسي شمسي (المجال المغناطيسي للشمس)",
 "solar month": "شهر شمسي (واحد من اثني عشر من السنة الشمسية أو المدارية)",
 "solar panel": "بطارية شمسية, مصفوفة شمسية (جهاز كهربائي يتكون من مصفوفة كبيرة من الخلايا الشمسية المتصلة)",
 "solar parallax": "تزيح شمسي (الزاوية التي يقابلها متوسط نصف القطر الاستوائي للأرض عند مسافة وحدة فلكية واحدة)",
 "solar physics": "فيزياء شمسية (فرع علم الفلك الذي يتعامل مع الشمس)",
 "solar plexus": "ضفيرة زلاقية, ضفيرة شمسية (ضفيرة كبيرة من الأعصاب الودية في البطن خلف المعدة)",
 "solar power": "طاقة شمسية, قدرة شمسية (طاقة من الشمس يتم تحويلها إلى طاقة حرارية أو كهربائية)\nمثال: يتم تحديد كمية الطاقة الساقطة على الأرض بواسطة الثابت الشمسي، ولكن لم يتم الاستفادة إلا قليلاً جداً من الطاقة الشمسية",
 "solar prominence": "شواظ شمسي (ثورانات كبيرة لغاز الهيدروجين المضيء ترتفع آلاف الكيلومترات فوق الغلاف اللوني)",
 "solar radiation": "إشعاع شمسي (إشعاع صادر من الشمس)",
 "solar system": "منظومة شمسية",
 "solar telescope": "تلسكوب شمسي (تلسكوب مصمم لرصد الشمس)",
 "solar thermal system": "نظام حراري شمسي (نظام يحول ضوء الشمس إلى حرارة)",
 "solar time": "توقيت شمسي (حساب لمرور الوقت بناءً على موقع الشمس في السماء)",
 "solar trap": "مصيدة الشمس (شرفة أو حديقة موجهة للاستفادة من الشمس مع الحماية من الرياح الباردة)",
 "solar wind": "رِيح شَمْسِيَّة",
 "solar year": "سنة شمسية, سنة فلكية (الوقت اللازم للأرض لعمل دورة واحدة حول الشمس، مقاسة بين اعتدالين ربيعيين)",
 "solarisation": "تعرض للشمس (التعرض لأشعة الشمس)",
 "solarium": "غرفة مشمسة, مقصورة شمسية (غرفة محاطة بالزجاج بشكل كبير وتوفر التعرض للشمس)",
 "solarization": "تعرض للشمس (التعرض لأشعة الشمس)",
 "sold": "مباع (تم التصرف فيه لمشتري)\nمثال: هذه البضاعة مباعة",
 "sold-out": "مَبِيعٌ بِالكَامِل (بِيع بالكامل مسبقًا)",
 "solder": "سبيكة لحام, مادة اللحام (سبيكة (عادة من الرصاص والقصدير) تستخدم عند صهرها لربط سطحين معدنيين)",
 "solderer": "لحّام (عامل يربط أو يصلح باستخدام اللحام)",
 "soldering": "لحام, لصق (التثبيت بإحكام معاً)",
 "soldering flux": "صهورة لحام, مساعد لحام (مادة صاهرة توضع على الأسطح المراد وصلها باللحام؛ تقوم بتنظيف الأسطح وتؤدي إلى ترابط أفضل)",
 "soldering iron": "مِكْوَاةُ اللَّحَّام, كاوِيَةُ اللَّحَّام",
 "soldier": "جُنْدِيّ, عَسْكَرِيّ (لقب عسكري يُطلق على من يلتحق بالجَيْش ويعمل فيه، مقاتل، محارب، عسكري؛ (في الشطرنج) اسم آخر للبيدق)\nمثال: غادر ذلك الجندي.",
 "soldier grainy club": "هراوة حبيبية جندية (نوع من الهراوة الحبيبية)",
 "soldier of fortune": "جندي مرتزق, مرتزق (شخص يُستأجر للقتال لصالح دولة غير دولته)",
 "soldier-fish": "سمكة الجندي (الأنواع الأكبر من أسماك السنجاب)",
 "soldierfish": "سمكة الجندي (الأنواع الأكبر من أسماك السنجاب)",
 "soldiering": "تكاسل, تهرب من العمل (التهرب من العمل أو الواجب) / جندية, مهارات عسكرية (المهارات المطلوبة لحياة الجندي)",
 "soldierlike": "جُنْدِيّ, فُرُوسِيّ ((لِلأَشْخَاص) يَلِيقُ بِالمُحَارِبِ؛ ذُو خِصَالٍ عَسْكَرِيَّة)",
 "soldierly": "جُنْدِيّ, فُرُوسِيّ ((لِلأَشْخَاص) يَلِيقُ بِالمُحَارِبِ؛ ذُو خِصَالٍ عَسْكَرِيَّة)",
 "soldiership": "جندية, مهارات عسكرية (المهارات المطلوبة لحياة الجندي)",
 "soldiery": "جنود, قوات (الجنود مجتمعين)",
 "sole": "وَحِيد / عَزْب / أَخْمُص, بَاطِن القَدَم / نَعْل / سَمَك مُوسَى (سَمَك جمع سَمَكَة، كما تجمع سمكة أسماك)\nمثال: سمكة ميناد ماتت",
 "solea lascaris": "سمك موسى الليموني (سمك موسى أوروبي صغير)",
 "solea solea": "سمك موسى الأوروبي (ذو قيمة عالية كطعام)",
 "solebar": "عارضة جانبية, عتبة جانبية (واحدة من العوارض الطولية التي تمتد على طول جانبي عربة السكك الحديدية، والتي يركب عليها هيكل العربة، وتشكل عادة في عربات الركاب الجانب أو قاعدة الأرضية)",
 "solecism": "لَحْن (وضع الألحان أو التأليف الموسيقي؛ قرأ النص بلحن أو أداء صوتي مميز)\nمثال: أنا أحب هذا اللحن.",
 "soled": "منعل (له نعل أو نعال كما هو محدد؛ تستخدم في المركبات)\nمثال: نصف منعل",
 "soledad pine": "صنوبر توري (صنوبر متوسط الحجم خماسي الإبر من جنوب غرب كاليفورنيا له مخاريط أسطوانية طويلة)",
 "soleirolia soleirolii": "دموع الطفل (عشبة كورسيكية زاحفة أو منبسطة ذات أوراق صغيرة دائرية قصيرة السيقان تشبه الطحالب)",
 "soleless": "بلا نعل (ليس له نعل)",
 "solely": "حصرياً, فقط (دون تضمين أو إشراك أي آخرين)\nمثال: كان الملوم وحده",
 "solemn": "جَادّ, صَادِق (يتّسم بإيمان ثابت وجادّ بأهمية الشيء ذاته) / رَزِين, وَقُور (يتّسم بالوقار والرصانة في الطبع والسلوك)",
 "solemness": "رزانة, مهابة (سمة الجدية الوقورة)",
 "solemnisation": "احتفال, مراسم (الأداء العام لسر مقدس أو احتفال مهيب مع جميع الطقوس المناسبة)\nمثال: مراسم الزواج",
 "solemnity": "رزانة, مهابة (سمة الجدية الوقورة) / جدية, وقار (شعور مهيب ورصين)",
 "solemnity of mary": "1 يناير, عيد مريم والدة الله ((الكنيسة الكاثوليكية) يوم مقدس واجب)",
 "solemnization": "احتفال, مراسم (الأداء العام لسر مقدس أو احتفال مهيب مع جميع الطقوس المناسبة)\nمثال: مراسم الزواج",
 "solemnly": "برصانة, بمهابة (بطريقة جادة ورصينة)\nمثال: جلس القاضي هناك بمهابة",
 "solenogaster": "محاريات دودية (رخويات تشبه الديدان تعيش في المياه العميقة تفتقر إلى الصفائح الجيرية على الجسم ولكن لها شويكات لزجة دقيقة على العباءة المغطية)",
 "solenoid": "سولينويد, ملف لولبي (ملف من الأسلاك حول قلب حديدي؛ يصبح مغناطيساً عند مرور التيار عبر الملف)",
 "solenostemon blumei": "سجاد, كوليوس",
 "solenostemon scutellarioides": "سجاد, كوليوس",
 "soleus": "عضلة نعلية (عضلة مسطحة عريضة في ربلة الساق تحت عضلة الساق التوأمية)",
 "soleus muscle": "عضلة نعلية (عضلة مسطحة عريضة في ربلة الساق تحت عضلة الساق التوأمية)",
 "solfa": "صولفا (نظام صولفيج يستخدم مقاطع الصولفا: دو، ري، مي، فا، صول، لا، سي)",
 "solfa syllable": "مقطع صولفائي (أحد أسماء نغمات السلم الموسيقي في نظام الصولفيج)",
 "solfege": "صولفيج (تمرين صوتي؛ غناء سلالم أو جمل موسيقية بنفس المقطع اللفظي) / صولميزاسيون (الغناء باستخدام مقاطع الصولفا للدلالة على نغمات سلم دو الكبير)",
 "solfeggio": "صولفيج (تمرين صوتي؛ غناء سلالم أو جمل موسيقية بنفس المقطع اللفظي) / صولميزاسيون (الغناء باستخدام مقاطع الصولفا للدلالة على نغمات سلم دو الكبير)",
 "solferino": "سولفرينو (صبغة وردية اكتشفت عام 1859)",
 "solfège": "صولفيج",
 "solicitation": "إغواء للرذيلة, استدراج (فعل إغراء شخص للقيام بشيء خاطئ (مثل عرض الجنس مقابل المال)) / اسْتِجْدَاء, الْتِمَاس (طلب مبلغ من المال) / التماس (توسل موجه إلى شخص ذي مكانة أعلى)\nمثال: مناشدة لجمع المال للأطفال الجياع",
 "solicitor": "محامي استشاري (محامٍ بريطاني يقدم المشورة القانونية ويعد الوثائق القانونية) / جامع تبرعات, مستجدي (ملتمس يطلب مساهمات أو تجارة أو أصوات)",
 "solicitor general": "المُحامِي العامّ (مسؤول قانوني يعين لمساعدة النائب العام)",
 "solicitorship": "استشارة قانونية, منصب المحامي (منصب المحامي أو المستشار القانوني)",
 "solicitous": "حَنُون, مُهْتَمّ (يُظهر عناية واهتمامًا بالغَيْن وانشغالًا حريصًا) / حَرِيص, شَدِيدُ الِاهْتِمَامِ (مَلِيءٌ بِالقَلَقِ وَالِاهْتِمَامِ البَالِغِ)",
 "solicitously": "باهتمام وقلق, بعناية (بطريقة مهتمة وقلقة)\nمثال: سألته والدته باهتمام: 'ألا تشعر بأنك بخير؟'",
 "solicitousness": "اهتمام مفرط, حدب (شعور بالاهتمام المفرط)",
 "solicitude": "عِنَايَة, رِعايَة",
 "solid": "صُلْب (قوي وصلب الملمس، لا ينحني بسهولة؛ متماسك وثابت، غير قابل للتغيير أو الانكسار) / جَامِد\nمثال: هذا التخت جدا صلب.",
 "solid angle": "زاوية مجسمة (زاوية مشكلة من ثلاثة مستويات أو أكثر تتقاطع عند نقطة مشتركة (الرأس))",
 "solid bastion": "حصن مصمت (حصن ممتلئ بالكامل، وتكون أرضيته متساوية مع ارتفاع السور، دون أي مساحة فارغة باتجاه المركز)",
 "solid body substance": "مادة جسدية صلبة (الأجزاء الصلبة من الجسم)",
 "solid figure": "شكل ثلاثي الأبعاد, شكل صلب (شكل يمكن وصفه بثلاثة معايير أو الهندسة الديكارتية)",
 "solid food": "طَعَام, غِذَاء صُلْب (أيّ مادّة صلبة تُستخدَم مصدرًا للتغذية، في مقابل السوائل)",
 "solid geometry": "هندسة فراغية (هندسة الفضاء ثلاثي الأبعاد)",
 "solid ground": "أرض, بر (الجزء الصلب من سطح الأرض)\nمثال: انحرفت الطائرة بعيداً عن البحر وعادت فوق اليابسة",
 "solid propellant rocket": "صاروخ بالوقود الصلب, محرك صاروخي بالوقود الصلب (محرك صاروخي كيميائي يستخدم الوقود الدافع في الحالة الصلبة)",
 "solid solution": "محلول جامد, محلول صلب (مادة صلبة متجانسة يمكن أن توجد عبر نطاق من المكونات الكيميائية؛ مكون من السبائك يتشكل عندما تندمج ذرات عنصر في بلورات معدن)",
 "solid state": "حالة صلبة, صلابة (الحالة التي لا تميل فيها المادة للتدفق تحت إجهاد معتدل؛ وتقاوم القوى (مثل الضغط) التي تميل لتشويهها؛ وتحتفظ بحجم وشكل محددين)",
 "solid-colored": "أُحَادِيّ اللَّوْن, بِلَوْنٍ وَاحِد (ذو لون واحد في جميع أجزائه)",
 "solid-coloured": "أُحَادِيّ اللَّوْن, بِلَوْنٍ وَاحِد (ذو لون واحد في جميع أجزائه)",
 "solid-fuel rocket": "صاروخ بالوقود الصلب, محرك صاروخي بالوقود الصلب (محرك صاروخي كيميائي يستخدم الوقود الدافع في الحالة الصلبة)",
 "solid-hoofed": "ذُو حَافِرٍ صَلْب (يَمْتَلِكُ حَوَافِرَ صُلْبَةً غَيْرَ مَشْقُوقَة)",
 "solid-propellant motor": "صاروخ بالوقود الصلب, محرك صاروخي بالوقود الصلب (محرك صاروخي كيميائي يستخدم الوقود الدافع في الحالة الصلبة)",
 "solid-state": "حَالَةٌ صُلْبَة (يتألّف من موادّ وعناصر أشباه الموصلات والأجهزة المتّصلة بها) / خَاصٌّ بِالحَالَةِ الصُّلْبَة (يتعلّق بالخصائص الفيزيائيّة للموادّ الصلبة؛ خاصّةً التوصيل الكهربائيّ)",
 "solid-state physics": "فيزياء الحالة الصلبة (فرع الفيزياء الذي يدرس خصائص المواد في الحالة الصلبة)",
 "solidago bicolor": "سوليداجو ثنائي اللون, عصا الفضة (نبات من شرق أمريكا الشمالية ذو أزهار بيضاء كريمية)",
 "solidago canadensis": "عصا الذهب الكندية, عصا الذهب المرجية (عصا الذهب كبيرة من أمريكا الشمالية ذات عناقيد مبهرجة من الزهور الصفراء على فروع مقوسة؛ غالباً ما تكون عشبة ضارة)",
 "solidago missouriensis": "عصا الذهب الميسورية (تشبه عصا الذهب المرجية ولكنها عادة أصغر)",
 "solidago multiradiata": "عصا الذهب الألبية (عصا ذهب تشبه عصا الذهب الضيقة ولكن لها شعيرات خشنة على حواف سيقان الأوراق؛ المناطق الجبلية في غرب أمريكا)",
 "solidago nemoralis": "عصا الذهب الرمادية (عشبة صباغين في كندا وشرق الولايات المتحدة ذات أزهار صفراء تستخدم أحياناً في الصباغة)",
 "solidago odora": "شاي الجبل الأزرق, عصا الذهب الحلوة (عصا ذهب من شرق أمريكا ذات أوراق عطرية يصنع منها شاي طبي)",
 "solidago rugosa": "عشبة الصباغين (عشبة من شرق أمريكا الشمالية تستخدم أزهارها الصفراء (أو كانت تستخدم) في الصباغة)",
 "solidago sempervirens": "عصا الذهب الشاطئية (عصا ذهب مبهرجة قوية شائعة على طول الساحل الشرقي وساحل الخليج لأمريكا الشمالية)",
 "solidago spathulata": "عصا الذهب الضيقة (عصا ذهب أمريكية غربية ذات عناقيد ضيقة طويلة من الزهور الصفراء الصغيرة)",
 "solidarity": "تَضَامُن (التعاون والتكاتف بين أفراد أو جهات لتحقيق هدف مشترك أو دعم بعضهم البعض؛ الشعور بالمسؤولية الجماعية تجاه قضية أو موقف)\nمثال: التضامن اساس الإنسانية.",
 "solidarity surcharge": "رسوم تضامن إضافية, ضريبة التضامن (ضريبة تفرضها الحكومة في ظروف خاصة، تهدف لتوفير التمويل لمشاريع تدعيم أو توحيد)",
 "solidarity tax": "رسوم تضامن إضافية, ضريبة التضامن (ضريبة تفرضها الحكومة في ظروف خاصة، تهدف لتوفير التمويل لمشاريع تدعيم أو توحيد)",
 "solidarize": "تَضَامَنَ (التعاون والتكاتف بين أفراد أو جهات لتحقيق هدف مشترك أو دعم بعضهم البعض؛ الشعور بالمسؤولية الجماعية تجاه قضية أو موقف)\nمثال: التضامن اساس الإنسانية.",
 "solidification": "تصلب, تصلد (عملية التحول إلى صلب أو قاسي عن طريق التبريد أو التجفيف أو التبلور)\nمثال: تصلب الخرسانة",
 "solidified": "مُتَجَمِّد, مُتَخَثِّر (تحوّل إلى كتلة صلبة بالتخثّر)",
 "solidifying": "تصلب, تصلد (عملية التحول إلى صلب أو قاسي عن طريق التبريد أو التجفيف أو التبلور)\nمثال: تصلب الخرسانة",
 "solidity": "رسوخ, متانة (جودة كون الشيء متيناً وموثوقاً مالياً أو واقعياً أو أخلاقياً) / صلابة (قوام المادة الصلبة) / امتلاء داخلي, تماسك (حالة امتلاء الداخل بالمادة)\nمثال: عملت متانة الأدلة لصالحه",
 "solidly": "بِمَتَانَة (بقوة وصلابة) / بِالإِجْمَاع, كَكُتْلَة وَاحِدَة (ككل غير مقسم)\nمثال: منزل مبني بمتانة",
 "solidness": "رسوخ, متانة (جودة كون الشيء متيناً وموثوقاً مالياً أو واقعياً أو أخلاقياً) / جُسْمَانِيَّة, مَادِّيَّة (صفة كون الشيء مادياً أو له جوهر) / صلابة (قوام المادة الصلبة) / حالة صلبة, صلابة (الحالة التي لا تميل فيها المادة للتدفق تحت إجهاد معتدل؛ وتقاوم القوى (مثل الضغط) التي تميل لتشويهها؛ وتحتفظ بحجم وشكل محددين)\nمثال: عملت متانة الأدلة لصالحه",
 "solidus": "شرطة مائلة (علامة ترقيم ('/') تستخدم لفصل عناصر المعلومات ذات الصلة) / بيزنط (عملة ذهبية للإمبراطورية البيزنطية؛ تم تداولها على نطاق واسع في أوروبا في العصور الوسطى)",
 "soliloquy": "مناجاة النفس (خطاب درامي (طويل عادة) يهدف إلى إعطاء وهم بتأملات غير منطوقة) / مناجاة النفس, مونولوج داخلي (حديث توجهه لنفسك)",
 "solipsism": "وَحْدَة الْأَنَا",
 "solitaire": "سوليتير, لعبة الصبر (لعبة ورق يلعبها شخص واحد) / سمنة منعزلة (سمنة رمادية باهتة من أمريكا الشمالية تشتهر بتغريدها الجميل) / طائر الناسك (طائر منقرض لا يطير قريب من الدودو) / جوهرة يتيمة, سوليتير (جوهرة (عادة ماسة) مثبتة بمفردها)",
 "solitarily": "بانفراد, بعزلة\nمثال: يختار الناسك أن يعيش بعزلة",
 "solitariness": "انطواء, عزلة (ميل نحو البقاء وحيداً) / شعور بالوحدة, وحدة (حالة الانفراد في عزلة)",
 "solitary": "مُنْعَزِل, مُوحِش (خالٍ من الكائنات الحية) / مُتَوَحِّد, مُنْفَرِد (يتّسم بتفضيل العزلة والانفراد) / بِلَا رَفِيق, وَحِيد (يفتقر إلى الرفاق أو الصُّحْبَة) / انْفِرَادِيّ, غَيْرُ قَطِيعِيّ ((في النباتات والحيوانات) لا ينمو أو يعيش في مجموعات أو مستعمرات)",
 "solitary confinement": "حَبْس اِنْفِرَادِيّ (مَنَعَ الشيءَ عن الفعلِ؛ أَمْسَكَ الشيءَ، قَبَضَ عَلَيْهِ)\nمثال: هو,البارحة حرر من الحبس.",
 "solitary pussytoes": "رجل القط الوحيدة (صنف من نبات رجل القط)",
 "solitary vireo": "فيريو منعزل (من شرق أمريكا الشمالية له رأس رمادي مزرق وجسم أخضر في الغالب)",
 "solitary wave": "سوليتون, موجة منعزلة ((في الفيزياء) كم من الطاقة أو شبه جسيم يمكن نشره كموجة متنقلة في الأنظمة غير الخطية ولا يسبقه أو يتبعه اضطراب آخر؛ لا يطيع مبدأ التراكب ولا يتبدد)\nمثال: يمكن لموجات السوليتون أن تقطع مسافات طويلة مع فقدان ضئيل للطاقة أو البنية",
 "soliton": "سوليتون, موجة منعزلة ((في الفيزياء) كم من الطاقة أو شبه جسيم يمكن نشره كموجة متنقلة في الأنظمة غير الخطية ولا يسبقه أو يتبعه اضطراب آخر؛ لا يطيع مبدأ التراكب ولا يتبدد)\nمثال: يمكن لموجات السوليتون أن تقطع مسافات طويلة مع فقدان ضئيل للطاقة أو البنية",
 "soliton wave": "سوليتون, موجة منعزلة ((في الفيزياء) كم من الطاقة أو شبه جسيم يمكن نشره كموجة متنقلة في الأنظمة غير الخطية ولا يسبقه أو يتبعه اضطراب آخر؛ لا يطيع مبدأ التراكب ولا يتبدد)\nمثال: يمكن لموجات السوليتون أن تقطع مسافات طويلة مع فقدان ضئيل للطاقة أو البنية",
 "solitude": "عُزْلَة",
 "solitudinarian": "زاهد, معتزل (من يعيش في عزلة)",
 "solleret": "حذاء درعي, واقي القدم (درع صفيحي يحمي القدم؛ يتكون من زرد مع مقدمة وكعب صلبين)",
 "solmisation": "تسمية النغمات, صولفيج (نظام لتسمية نوتات السلم الموسيقي بمقاطع صوتية بدلاً من الحروف)",
 "solmization": "صولميزاسيون (الغناء باستخدام مقاطع الصولفا للدلالة على نغمات سلم دو الكبير) / تسمية النغمات, صولفيج (نظام لتسمية نوتات السلم الموسيقي بمقاطع صوتية بدلاً من الحروف)",
 "solo": "منفرداً, وحده (دون أي شخص أو شيء آخر) / طيران منفرد (رحلة طيران يكون فيها الطيار غير مصحوب بأحد) / أداء منفرد, انفراد (أي نشاط يتم أداؤه بمفرده دون مساعدة) / فَرْدِيّ, مُنْفَرِد (مؤلَّف أو مُؤَدّى بصوت واحد أو آلة واحدة)\nمثال: بقي الطفل في المنزل وحده",
 "solo blast": "ركضة كاملة فردية, ضربة فردية ساحقة (ركضة كاملة (هوم ران) تتحقق عندما لا يكون هناك عدائون على القواعد)",
 "solo homer": "ركضة كاملة فردية, ضربة فردية ساحقة (ركضة كاملة (هوم ران) تتحقق عندما لا يكون هناك عدائون على القواعد)",
 "solo man": "إنسان سولو (إنسان مبكر من أواخر العصر البليستوسيني؛ جمجمته تشبه جمجمة إنسان نياندرتال ولكن بسعة دماغية أصغر؛ عُثر عليه في جاوة)",
 "soloist": "عازف منفرد (موسيقي يؤدي عزفاً منفرداً)",
 "solomon": "سُلَيْمَان, سُلَيْمٰن / سُلَيْمَان",
 "solomon islands": "جُزُر سُلَيْمَان (جَزَرَ الماءُ عن الأَرضِ يَجْزُرُ جَزْراً: نَضَبَ وحَسَرَ؛ ويقال: جَزَرَ البَحْرُ والنَّهْرُ: انْحسرَ ماؤُهُ)\nمثال: ضع الجزر في القدر.",
 "solomon's seal": "خاتم سليمان, نجمة داود (نجمة سداسية مكونة من مثلثين متساويي الأضلاع)",
 "solomon's-seal": "خاتم سليمان (أي من النباتات المتعددة من جنس بوليغوناتوم ذات أزهار خضراء مصفرة متدلية مقترنة وجذمور سميك بندوب تشبه خاتم سليمان)",
 "solomonic": "سليماني (يظهر أو يتطلب حكمة سليمان في اتخاذ القرارات الصعبة)",
 "solon": "رجل دولة, قائد وطني (شخص يعد قائداً محترماً في الشؤون الوطنية أو الدولية)",
 "solresol": "سولريصول (لغة مصطنعة يمكن فيها تمثيل الوحدات الصوتية كألوان قوس قزح السبعة، أو نغمات السلم الموسيقي السبع، أو المقاطع المنطوقة (المبنية على السولفيج)، أو…)",
 "solstice": "اِنْقِلَاب شَمْسِيّ",
 "solubility": "ذوبانية, قابلية الذوبان (خاصية القابلية للذوبان وسهولة الانحلال في السائل) / إمكانية الحل, قابلية الحل (الخاصية (لمشكلة أو صعوبة) التي تجعل من الممكن حلها) / ذَائِبِيَّة, قَابِلِيَّة الذَّوَبَان (كمية مادة معينة يمكن أن تذوب في مذيب معين (لإنتاج محلول مشبع))",
 "soluble": "قابل للذوبان ((للمادة) قادر على الذوبان في مذيب ما (عادة الماء)) / قابل للحل (قابل للحل أو التفسير)\nمثال: اللغز قابل للحل",
 "soluble glass": "زجاج مائي, سيليكات الصوديوم (زجاج لزج يتكون من سيليكات الصوديوم في محلول؛ يستخدم كمادة لاصقة أو طلاء واقي وحفظ البيض)",
 "soluble rna": "حمض نووي ريبوزي ناقل (أصبح حامضًا، تغير الطعم إلى الحموضة؛ ارتفعت نسبة الحموضة في شيء ما، كما في الطعام أو السوائل)\nمثال: رمى ياني الحمض على وجه سكورة.",
 "solubleness": "انحلالية, قابلية الذوبان (خاصية القابلية للانحلال)\nمثال: قاس قابلية ذوبان السكر في الماء",
 "solute": "مُذاب (المادة المذابة في محلول؛ مكون المحلول الذي يغير حالته)",
 "solution": "مَحْلُول (أكثر ما يستخدم في حَلَّ بمعنى وصل إلى حَلّ في مشكلة ما أو مسألة رياضية أو سؤال ما وإن جاز استخدامه في غيره؛ ماء قد حُلَّ فيه شيء ما مثل الملح أو السكر أو غيره) / حَلّ (للعقدة: ضد عَقْدها؛ للجامد في السائل: إذابته)\nمثال: اصبعي تحول الى بني بعد ان غمرته في محلول برمنغانات البوتاسيوم الكثيف جزئيا.",
 "solvability": "إمكانية الحل, قابلية الحل (الخاصية (لمشكلة أو صعوبة) التي تجعل من الممكن حلها)",
 "solvable": "قَابِلٌ لِلْحَلّ (يمكن حلّه والتوصّل إلى إجابته)",
 "solvate": "سولفات, مركب مذاب (مركب يتكون عن طريق التذاوب (اتحاد جزيئات المذيب مع جزيئات أو أيونات المذاب))",
 "solvating agent": "عامل إذابة, عامل تذاوب (عامل يحول شيئاً ما إلى مركب ذائب)",
 "solvation": "تذاوب (عملية كيميائية تتحد فيها جزيئات المذيب مع جزيئات أو أيونات المذاب لتكوين مركب)",
 "solvay process": "عملية سولفاي (عملية صناعية لإنتاج كربونات الصوديوم من كلوريد الصوديوم والأمونيا وثاني أكسيد الكربون)",
 "solve": "ذَابَ, حَلَّ (تحوّل الشيء من حالته الصلبة إلى حالة سائلة نتيجة الحرارة؛ زال أو تلاشى شيئًا فشيئًا، مثل ذوبان الجليد أو اختفاء الألم)\nمثال: ذاب ذلك الجليد.",
 "solved": "محلول, مفكك (لغزه) (تم تفسيره أو الإجابة عليه)\nمثال: ألغاز محلولة وغير محلولة",
 "solvency": "سُيُولَة",
 "solvency margin": "هَامِش الْمَلَاءَة (الفرق بين أصول وخصوم شركة تأمين معينة (مقدار زيادة الأصول عن الخصوم)، وينظمه القانون)",
 "solvent": "قادر على الوفاء, مليء (قادر على الوفاء بالالتزامات المالية) / إجابة, حل (بيان يحل مشكلة أو يشرح كيفية حل المشكلة) / مذيب, مُحِل (مادة سائلة قادرة على إذابة مواد أخرى)\nمثال: كانوا يحاولون إيجاد حل سلمي",
 "solver": "حَالّ, حَلَّال (تحول أو تغيّر من حالٍ إلى حالٍ؛ اعترض أو فصل بين شيئين)\nمثال: كيف حال الجميع؟",
 "solving": "حل (إيجاد حل لمشكلة)",
 "som": "سوم",
 "soma": "جَسَد, جِسْمُ الإِنْسَان (أسماء بديلة لجسد الإنسان) / سوما (تجسيد لشراب مسكر مقدس يُستخدم في الطقوس الفيدية) / سوما, هاوما (كرمة عديمة الأوراق من جزر الهند الشرقية؛ كانت عصارتها اللبنية الحامضة تستخدم سابقاً لصنع مشروب مسكر)\nمثال: درس ليوناردو جسم الإنسان",
 "somaesthesia": "إحساس جسدي, حس جسدي (ملكة الإدراك الجسدي؛ الأنظمة الحسية المرتبطة بالجسم؛ تشمل حواس الجلد واستقبال الحس العميق والأعضاء الداخلية) / إحساس جسدي, حس جسدي (إدراك الأحاسيس اللمسية أو استقبال الحس العميق أو الأحاسيس الحشوية)\nمثال: اعتمد على الحس الجسدي لتحذيره من تغيرات الضغط",
 "somaesthesis": "إحساس جسدي, حس جسدي (ملكة الإدراك الجسدي؛ الأنظمة الحسية المرتبطة بالجسم؛ تشمل حواس الجلد واستقبال الحس العميق والأعضاء الداخلية)",
 "somali": "صُومَالِيَّة, صُومَالِيّ",
 "somali language": "الصومالية (اللغة الكوشية التي يتحدث بها الصوماليون)",
 "somalia": "اَلصُّومَال (عربية تقع في القَرْن الْإِفْرِيقِيّ)",
 "somalian": "صومالي (من أو متعلق بجمهورية الصومال الأفريقية أو شعبها أو لغتهم وثقافتهم) / صُومالِيّ (عضو في شعب يعيش في الصومال)\nمثال: القهوة الصومالية ممتازة",
 "somalian monetary unit": "وحدة نقدية صومالية (الوحدة النقدية في الصومال)",
 "somalian shilling": "شلن, شلن صومالي (وحدة المال الأساسية في الصومال؛ تساوي 100 سنت)",
 "somaliland": "صُومَالِيلَانْد, أَرْض اَلصُّومَال",
 "somaliland monetary unit": "وحدة نقدية لأرض الصومال (الوحدة النقدية في أرض الصومال، وهي دولة أعلنت استقلالها من جانب واحد ومعترف بها دولياً كمنطقة تتمتع بالحكم الذاتي في الصومال)",
 "soman": "سومان, غاز جي دي (عامل أعصاب يمتصه الجسم بسهولة؛ وهو مثبط قاتل للكولين إستراز وشديد السمية عند استنشاقه)",
 "somataesthesis": "إحساس جسدي, حس جسدي (ملكة الإدراك الجسدي؛ الأنظمة الحسية المرتبطة بالجسم؛ تشمل حواس الجلد واستقبال الحس العميق والأعضاء الداخلية)",
 "somatesthesia": "إحساس جسدي, حس جسدي (ملكة الإدراك الجسدي؛ الأنظمة الحسية المرتبطة بالجسم؛ تشمل حواس الجلد واستقبال الحس العميق والأعضاء الداخلية) / إحساس جسدي, حس جسدي (إدراك الأحاسيس اللمسية أو استقبال الحس العميق أو الأحاسيس الحشوية)\nمثال: اعتمد على الحس الجسدي لتحذيره من تغيرات الضغط",
 "somatic": "جَسَدِيّ",
 "somatic cell": "خلية إنباتية, خلية جسدية (أي من خلايا النبات أو الحيوان باستثناء الخلايا التناسلية؛ خلية لا تشارك في إنتاج الأمشاج)\nمثال: تنتج الخلايا الجسدية من خلايا موجودة مسبقاً",
 "somatic cell nuclear transfer": "نقل نواة الخلية الجسدية (نقل نواة الخلية ومادتها الوراثية من خلية إلى أخرى)",
 "somatic cell nuclear transplantation": "نقل نواة الخلية الجسدية (نقل نواة الخلية ومادتها الوراثية من خلية إلى أخرى)",
 "somatic chromosome": "كْرُومُوسُوم جَسَدِيّ (أي كروموسوم ليس كروموسوماً جنسياً؛ تظهر في أزواج في خلايا الجسم ولكن ككروموسومات مفردة في الحيوانات المنوية)",
 "somatic delusion": "توهم جسدي, ضلالة جسدية (وهم يتعلق بصورة الجسم أو أجزاء من الجسم)",
 "somatic sensation": "إحساس جسدي, حس جسدي (إدراك الأحاسيس اللمسية أو استقبال الحس العميق أو الأحاسيس الحشوية)\nمثال: اعتمد على الحس الجسدي لتحذيره من تغيرات الضغط",
 "somatic sense": "إحساس جسدي, حس جسدي (ملكة الإدراك الجسدي؛ الأنظمة الحسية المرتبطة بالجسم؛ تشمل حواس الجلد واستقبال الحس العميق والأعضاء الداخلية)",
 "somatic sensory system": "إحساس جسدي, حس جسدي (ملكة الإدراك الجسدي؛ الأنظمة الحسية المرتبطة بالجسم؛ تشمل حواس الجلد واستقبال الحس العميق والأعضاء الداخلية)",
 "somatogenetic": "جَسَدِيّ المَنْشَأ (ناشئ عن أسباب جسديّة لا نفسيّة)",
 "somatogenic": "جَسَدِيّ المَنْشَأ (ناشئ عن أسباب جسديّة لا نفسيّة)",
 "somatosense": "حاسة جسدية (أي من الأنظمة الحسية التي تتوسط أحاسيس الضغط والدغدغة والدفء والبرودة والاهتزاز ووضعية الأطراف وحركة الأطراف والألم)",
 "somatosensory": "حسي جسدي (مكون من أو متعلق بالحواس الجسدية)",
 "somatosensory system": "إحساس جسدي, حس جسدي (ملكة الإدراك الجسدي؛ الأنظمة الحسية المرتبطة بالجسم؛ تشمل حواس الجلد واستقبال الحس العميق والأعضاء الداخلية)",
 "somatotrophic hormone": "سوماتروبين, هرمون النمو (هرمون تنتجه الغدة النخامية الأمامية؛ يعزز النمو عند البشر)",
 "somatotrophin": "سوماتروبين, هرمون النمو (هرمون تنتجه الغدة النخامية الأمامية؛ يعزز النمو عند البشر)",
 "somatotropic hormone": "سوماتروبين, هرمون النمو (هرمون تنتجه الغدة النخامية الأمامية؛ يعزز النمو عند البشر)",
 "somatotropin": "سوماتروبين, هرمون النمو (هرمون تنتجه الغدة النخامية الأمامية؛ يعزز النمو عند البشر)",
 "somatotype": "نمط الجسم (فئة من البنية الجسدية)",
