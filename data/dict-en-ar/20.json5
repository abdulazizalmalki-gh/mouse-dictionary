 "peace treaty": "مُعَاهَدَة سَلَام (مؤنث مُعَاهَد، وهو اسم مفعول من عَاهَدَ؛ اتِّفَاق مُقَرّر بين دَوْلَتَيْن أو أكثر على أمور معينة)\nمثال: أمضيت المعاهدة يوم 18 نوفمبر 1903.",
 "peace-loving": "مُحِبٌّ لِلسَّلَام (مَيَّالٌ لِلسَّلَامِ أَوْ رَاغِبٌ فِيه)",
 "peaceable": "سلمي, مسالم (غير مضطرب بالنزاع أو الاضطراب أو الحرب) / مَيَّالٌ لِلسَّلَام, مُسَالِم (يَمِيلُ إِلَى السَّلَامِ أَوْ ذُو طَبِيعَةٍ سِلْمِيَّة) / مُحِبٌّ لِلسَّلَام (مَيَّالٌ لِلسَّلَامِ أَوْ رَاغِبٌ فِيه)\nمثال: أمة مسالمة",
 "peaceableness": "سلمية, مسالمة (حالة تتسم بالهدوء والسكينة)",
 "peaceably": "بسلام, سلمياً (بطريقة سلمية)\nمثال: يجب على المستأجر الذي يدفع الإيجار المحجوز بموجب هذا ويؤدي العهود المتعددة الواردة هنا من جانبه أن يشغل ويتمتع بالمباني المؤجرة بسلام",
 "peaceful": "سِلْمِيّ / مُسَالِم",
 "peaceful coexistence": "تَعَايُش سِلْمِيّ",
 "peacefully": "بسلام, بهدوء (بطريقة سلمية)\nمثال: استقرت الدجاجة على العش بسلام تام",
 "peacefulness": "راحة بال, سلام (غياب التوتر العقلي أو القلق) / سلمية, مسالمة (حالة تتسم بالهدوء والسكينة)",
 "peacekeeper": "مسدس حفظ السلام (مسدس رجل القانون في الغرب القديم) / حافِظ السَّلام (شخص يحافظ على السلام) / جندي حفظ السلام (عضو في قوة عسكرية مكلفة (غالباً بعقوبات دولية) بحفظ السلام في منطقة مضطربة)\nمثال: إنها حافظة السلام في تلك العائلة",
 "peacekeeping": "حِفْظ سَلَام (الحِفْظُ نَقِيضُ النِّسْيَان، وهو التَّعَاهُدُ وقِلَّةُ الغَفْلَةِ؛ قِلَّةُ الغَفْلَةِ)\nمثال: حفظ رقم هاتفها.",
 "peacekeeping mission": "حفظ السلام, مهمة حفظ السلام (نشاط الحفاظ على السلام بواسطة القوات العسكرية (خاصة عندما تفرض القوات العسكرية الدولية هدنة بين الجماعات أو الدول المتعادية))",
 "peacekeeping operation": "حفظ السلام, مهمة حفظ السلام (نشاط الحفاظ على السلام بواسطة القوات العسكرية (خاصة عندما تفرض القوات العسكرية الدولية هدنة بين الجماعات أو الدول المتعادية))",
 "peacemaker": "صانِعُ ٱلسَّلام, مُصْلِح (كل من يَصْنَعُ شيئا؛ من يَمْتَهِنُ الصِّنَاعَة)\nمثال: أحب أن أكون صانع محتوى.",
 "peacenik": "حَمَامَة, دَاعِيَة سَلْمِيَّة (شخص يفضل المفاوضات على الصراع المسلح في إدارة العلاقات الخارجية)",
 "peacetime": "وَقْت السَّلَامِ, وَقْت السِّلْمِ (\"بَقِيَ وَقْتاً عِنْدَهُ \" : أَيْ مِقْدَاراً مِنَ الزَّمَنِ؛ \"جَاءَ فِي الوَقْتِ الْمُنَاسِبِ \" : فِي اللَّحْظَةِ الْمُنَاسِبَةِ)\nمثال: حان وقت الذهاب.",
 "peach": "خَوْخ / خَوْخَة / دُرَّاق / فِرْسِك",
 "peach bell": "جريس خوخي الأوراق (زهرة جرس أوروبية معمرة بأزهار عنقودية بيضاء أو زرقاء)",
 "peach bells": "جريس خوخي الأوراق (زهرة جرس أوروبية معمرة بأزهار عنقودية بيضاء أو زرقاء)",
 "peach blight": "لفحة الخوخ (مرض يصيب الأشجار التي تحمل ثمارًا نووية)",
 "peach blossom": "زَهْرَة خَوْخ",
 "peach ice cream": "آيس كريم الخوخ (آيس كريم بنكهة الخوخ الطازج)",
 "peach liqueur": "ليكير الخوخ (أي من مجموعة متنوعة من الليكيرات الكحولية القوية المصنوعة من الخوخ)\nمثال: ليكير الخوخ محلي الصنع هذا لذيذ وسهل التحضير",
 "peach melba": "بيتش ملبا (آيس كريم وخوخ مع مشروب كحولي أو صلصة)",
 "peach orchard": "بستان خوخ (بستان من أشجار الخوخ)",
 "peach pit": "نَوَاة الخَوْخ (البذرة الحجرية للخوخ)",
 "peach sauce": "صلصة الخوخ (للأطباق الصينية: محفوظات الخوخ والتشاتني)",
 "peach tree": "خوخ, دراق (تزرع في المناطق المعتدلة)",
 "peach-colored": "خَوْخِيّ اللَّوْن (ذو لون الخوخ)",
 "peach-leaved willow": "صفصاف خوخي الأوراق (صفصاف في غرب الولايات المتحدة بأوراق تشبه أوراق أشجار الخوخ أو اللوز)",
 "peach-wood": "خشب البرازيل, خشب الخوخ (شجرة استوائية ذات جذع شائك؛ ينتج خشبها الأحمر الثقيل صبغة حمراء ويستخدم في صناعة الخزائن)",
 "peachick": "فرخ الطاووس (صغير الطاووس)",
 "peachleaf willow": "صفصاف خوخي الأوراق (صفصاف في غرب الولايات المتحدة بأوراق تشبه أوراق أشجار الخوخ أو اللوز)",
 "peachwood": "خشب البرازيل, خشب الخوخ (شجرة استوائية ذات جذع شائك؛ ينتج خشبها الأحمر الثقيل صبغة حمراء ويستخدم في صناعة الخزائن)",
 "peachy": "خَوْخِيّ اللَّوْن (بلون يشبه لون الخوخ) / رَائِع, مُمْتَاز (ممتاز؛ بالغ الجودة)",
 "peachy-colored": "خَوْخِيّ اللَّوْن (بلون يشبه لون الخوخ)",
 "peachy-coloured": "خَوْخِيّ اللَّوْن (بلون يشبه لون الخوخ)",
 "peacoat": "بي كوت, معطف بحار (سترة صوفية ثقيلة مزدوجة الصدر للبحارة)",
 "peacock": "طَاوُوس",
 "peacock blue": "أزرق مخضر, تركواز (درجة من الأزرق مشوبة بالأخضر)",
 "peacock butterfly": "فراشة الطاووس (فراشة أوروبية لها أجنحة بنية محمرة كل منها معلم ببقعة عينية أرجوانية)",
 "peacock flower": "بوانسيانا ملكية, زهرة الطاووس (شجرة استوائية مبهرجة أو شجيرة موطنها مدغشقر؛ تزرع على نطاق واسع في المناطق الاستوائية لعناقيدها الضخمة من الزهور القرمزية والبرتقالية؛ تصنف أحياناً…)",
 "peacock flower fence": "خشب المرجان, صندل أحمر (شجرة من شرق الهند ذات عناقيد من الزهور الصفراء البيضاء؛ تزرع للزينة)",
 "peacock ore": "بورنيت, خام الطاووس (معدن يتكون من كبريتيدات النحاس والحديد ويوجد في رواسب النحاس)",
 "peacock-blue": "أَزْرَق طَاوُوسِيّ (بلون أزرق مخضر زاهٍ كلون ريش الطاووس)",
 "peacock-throne": "عرش الطاووس (العرش الذهبي لملوك دلهي السابقين؛ سرقه الفرس عام 1739 وفُقد لاحقاً؛ رمز لشاه إيران السابق)",
 "peafowl": "طَاوُوس",
 "peag": "وامبوم (خرزات أسطوانية صغيرة مصنوعة من الأصداف المصقولة ومشكّلة في خيوط أو أحزمة؛ استخدمتها بعض الشعوب الأصلية في أمريكا كمجوهرات أو عملة)",
 "peahen": "أنثى الطاووس (أنثى الطاووس)",
 "peak": "أَوْجٌ, ذُرْوَةٌ",
 "peak season": "موسم الذروة (الموسم الذي يكون فيه السفر أكثر نشاطًا والأسعار أعلى)\nمثال: سافروا إلى أوروبا في موسم الذروة",
 "peaked": "ذُو قِمَّة, مُرْتَفِع الذُّرْوَة (له قمة أو يرتفع إلى ذروة)",
 "peaked cap": "قبعة عسكرية, كيبي (قبعة ذات قمة دائرية مسطحة وحاجب)",
 "peaky": "حَادّ الذُّرْوَة, مُدَبَّب النَّبْرَة (ذو نقاط عالية النبرة بشكل خاصّ أو كأنَّه كذلك)",
 "peal": "جلجلة, قصف (صوت عميق طويل (كما في الرعد أو الأجراس الكبيرة))",
 "pealing": "جلجلة, قصف (صوت عميق طويل (كما في الرعد أو الأجراس الكبيرة))",
 "pean": "قصيدة مدح, مديح رسمي (تعبير رسمي عن الثناء) / بيان, نشيد الشكر ((اليونان القديمة) ترنيمة تسبيح (خاصة تلك التي كانت تغنى في اليونان القديمة لاستدعاء أو شكر إله))",
 "peanut": "فُولٌ سُودَانِيٌّ, فُسْتُقُ العَبِيد",
 "peanut bar": "لوح فول سوداني (لوح من الفول السوداني في التوفي)",
 "peanut brittle": "بريتل الفول السوداني, فول سوداني مقرمش (حلوى السكر المكرمل المحتوية على الفول السوداني)",
 "peanut butter": "زُبْدَةْ فُول سُودَانِيّ (هي الزُبْد أو هي أخص من الزُبْد. أنظر الصورة؛ زُبْدَة الكلام: هو فحواه أو ما يراد به أو أهم ما فيه)\nمثال: اشترت رطلي زبدة.",
 "peanut gallery": "الدرجة الثالثة, الشرفة الثانية (المنطقة الخلفية أو العلوية في الشرفة التي تحتوي على أرخص المقاعد) / المتفرجون البسطاء, جمهور الساخرين ((مجازياً) أشخاص تُعتبر انتقاداتهم غير ذات صلة أو تافهة (تشبيهاً بالأشخاص غير المتعلمين الذين يلقون الفول السوداني على المسرح للتعبير عن استيائهم من…)\nمثال: تجاهل الشكاوى من جمهور الساخرين",
 "peanut oil": "زيت الفول السوداني (زيت مستخرج من الفول السوداني؛ يُستخدم في الطهي وصنع الصابون)",
 "peanut vine": "فول سوداني (نبات أمريكي يُزرع على نطاق واسع في المناطق الاستوائية والدافئة؛ له أزهار صفراء مبهرجة على سيقان تنحني نحو التربة بحيث تنضج قرون البذور تحت الأرض)",
 "peanut worm": "دودة الفول السوداني, دودة رشفية (دودة بحرية صغيرة غير مقسمة تسحب جزأها الأمامي إلى الجسم عند إزعاجها مما يعطيها مظهر الفول السوداني)",
 "peanuts": "مبلغ تافه, ملاليم (مبلغ غير مهم من المال؛ مبلغ تافه)\nمثال: راتبها تافه مقارنة براتبه",
 "pear": "كُمَّثْرَى, إِجَّاص",
 "pear blight": "لفحة الكمثرى, لفحة نارية (مرض يسبب اسوداد أوراق أشجار الكمثرى والتفاح)",
 "pear haw": "زعرور أسود, زعرور الكمثرى (زعرور أمريكي قائم ويكاد يكون بلا أشواك بثمار تشبه الكمثرى نوعاً ما)",
 "pear hawthorn": "زعرور أسود, زعرور الكمثرى (زعرور أمريكي قائم ويكاد يكون بلا أشواك بثمار تشبه الكمثرى نوعاً ما)",
 "pear tree": "شَجَرَةُ اَلكُمَّثْرَى (نبات قائم على سَاق صلبة؛ مخطط له تفرعات)\nمثال: أنا تحت الشجرة.",
 "pear-shaped": "فَخْم, مُسْتَدِير ((للأصوات) ممتلئ وغني) / إِجَّاصِيُّ الشَّكْل (ذو شكل مستدير يتناقص عند أحد الطرفَيْن)",
 "pearl": "لُؤْلُؤَة / لُؤْلُؤ (نوع من المجوهرات الغالية التي تكون في البحر عميقًا؛ اسم شخصي معطًى ذو استخدامات تاريخية للذكور من العرب) / جَوْهَر (جَوْهَر)\nمثال: يريد شراء عقد لؤلؤ لزوجته.",
