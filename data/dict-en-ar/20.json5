 "pearly-white": "أَبْيَض لُؤْلُؤِيّ (أبيض كلون اللؤلؤ)",
 "pearmain": "تفاح بيرمين (أي من عدة أصناف من التفاح ذي القشور الحمراء)",
 "pearson product-moment correlation coefficient": "معامل ارتباط العزم, معامل ارتباط بيرسون للعزم (الطريقة الأكثر استخداماً لحساب معامل الارتباط بين المتغيرات المرتبطة خطياً)",
 "peasant": "فَلَّاح, فَلَّاحَة",
 "peasant dress": "فستان ريفي (أي فستان يشبه الجزء العلوي منه البلوزة الريفية)",
 "peasantess": "فَلَّاحَة",
 "peasanthood": "حياة الفلاح, فلاحة (حالة كون الشخص فلاحاً)\nمثال: نفس الثوب المنزلي الذي ارتدته في أيام فلاحتها",
 "peasantry": "طبقة الفلاحين, فلاحون (طبقة الفلاحين)",
 "pease pudding": "بيز بودينغ (بودينغ مصنوع من البازلاء المقشورة المهروسة المخلوطة مع البيض)",
 "peasecod": "قَرْنُ البَازِلَّاء (قشرة البازلاء؛ صالحة للأكل في بعض أنواع بازلاء الحدائق)",
 "peat": "خُثّ",
 "peat bog": "سبخة, مستنقع خثي (أرض إسفنجية رطبة من النباتات المتحللة؛ تصريفها أفقر من المستنقعات العادية؛ تربتها غير صالحة للزراعة ولكن يمكن قطعها وتجفيفها واستخدامها كوقود)",
