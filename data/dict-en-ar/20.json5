 "paradoxical": "مُتَنَاقِض ظَاهِرِيّاً (يبدو متناقضاً لكنه قد يكون صحيحاً مع ذلك)",
 "paradoxical sleep": "نوم حركة العين السريعة, نوم متناقض (حالة نوم متكررة تحدث خلالها الأحلام؛ حالة من حركات العين المتغيرة بسرعة أثناء النوم)",
 "paradoxically": "بشكل متناقض, للمفارقة (بطريقة متناقضة)\nمثال: للمفارقة، يبدو أن العصور الجليدية تحدث عندما تصبح الشمس أكثر سخونة",
 "paraduodenal smear": "مَسْحَةُ الاِثْنَيْ عَشَر (مسحة القناة الهضمية من مادة تم الحصول عليها من الاثني عشر)",
 "paraesthesia": "تنميل, خدر (أحاسيس جلدية غير طبيعية (مثل الوخز أو الدغدغة أو الحكة أو الحرقان) ترتبط عادة بتلف الأعصاب المحيطية)",
 "paraffin": "زيت الكاز, كيروسين ((الاستخدام البريطاني) الكيروسين) / ألكان, برافين / شمع البارافين (من البترول الخام؛ يُستخدم للشموع وللطبقات الحافظة أو المقاومة للماء)",
 "paraffin oil": "زيت الكاز, كيروسين ((الاستخدام البريطاني) الكيروسين)",
 "paraffin scale": "شمع البارافين القشري (شمع بارافين مكرر جزئياً)",
 "paraffin series": "ألكان, برافين",
 "paraffin wax": "شمع البارافين (من البترول الخام؛ يُستخدم للشموع وللطبقات الحافظة أو المقاومة للماء)",
 "parafovea": "جنيب النقرة (منطقة الشبكية المحيطة مباشرة بالنقرة)",
 "paragliding": "تزلج هوائي, طيران مظلي (الطيران بمظلة شراعية)",
 "paragneiss": "بارانايس (نايس مشتق من صخر رسوبي)",
 "paragon": "قدوة, كمال (حالة مثالية؛ تجسيد مثالي لمفهوم ما) / مثال للكمال, نموذج مثالي (نموذج للتميز أو الكمال من نوعه؛ شخص لا مثيل له)",
 "paragonite": "باراغونيت (ميكا عديمة اللون أو بنية شاحبة تحتوي على الصوديوم)",
 "paragram": "تَحْرِيف لَفْظِيّ (تورية تصنع عن طريق تغيير حروف الكلمة، وخاصة الحرف الأول)",
 "paragraph": "فِقْرَة, بَنْد",
 "paragrapher": "كاتب فقرات صحفية (كاتب فقرات قصيرة (عادة للنشر في الصفحة الافتتاحية للصحيفة))",
 "paraguay": "بَارَاجُوَاي, بَارَاغُوَاي",
 "paraguay tea": "شاي باراغواي, مته (بهشية من أمريكا الجنوبية؛ تستخدم الأوراق في صنع مشروب يشبه الشاي)",
 "paraguayan": "بَارَاغْوَانِيّ, بَارَاغْوائِيّ",
 "paraguayan monetary unit": "وحدة نقدية باراغوايانية (الوحدة النقدية في باراغواي)",
 "parahoma": "باراهوما (مشروب طقسي يحضر من نبات الهوما)\nمثال: أنتج نبات الهوما المكون الأساسي للمشروب الطقسي باراهوما",
 "parahyaena brunnea": "ضبع بني (من جنوب أفريقيا)",
 "parainfluenza virus": "فيروس نظير الإنفلونزا (فيروس يسبب عدوى الجهاز التنفسي العلوي (بما في ذلك نزلات البرد والتهاب القصيبات)؛ غالباً عند الأطفال)",
 "parakeet": "دُرَّة, بَارَاكِيت",
 "paralanguage": "تواصل شبه لغوي, لغة مصاحبة (استخدام طريقة التحدث لتوصيل معانٍ معينة)",
 "paraldehyde": "بارالدهيد (سائل عديم اللون (ثلاثي الوحدات حلقي للأسيتالدهيد) يستخدم كمهدئ ومذيب)",
 "paralegal": "مساعد قانوني (شخص ذو تدريب متخصص يساعد المحامين)",
 "paraleipsis": "تجاهل بلاغي (الإيحاء من خلال المعالجة الموجزة المتعمدة بأن الكثير من الأهمية قد تم حذفه)",
 "paralepsis": "تجاهل بلاغي (الإيحاء من خلال المعالجة الموجزة المتعمدة بأن الكثير من الأهمية قد تم حذفه)",
 "paralichthys dentatus": "فلو ندر الصيف (سمكة مفلطحة في الساحل الشرقي لأمريكا الشمالية)",
 "paralichthys lethostigmus": "فلو ندر جنوبي (سمكة مفلطحة في جنوب الولايات المتحدة)",
 "paralinguistic communication": "تواصل شبه لغوي, لغة مصاحبة (استخدام طريقة التحدث لتوصيل معانٍ معينة)",
 "paralipomenon": "أخبار الأيام, باراليبومينون ((العهد القديم) اسم قديم لسفري أخبار الأيام الأول والثاني في العهد القديم)",
 "paralipsis": "تجاهل بلاغي (الإيحاء من خلال المعالجة الموجزة المتعمدة بأن الكثير من الأهمية قد تم حذفه)",
 "paralithodes camtschatica": "سرطان الملك (سرطان كبير صالح للأكل من مياه شمال المحيط الهادئ وخاصة على طول سواحل ألاسكا واليابان)",
 "parallax": "اختلاف المنظر, تزيح (الإزاحة الظاهرية لجسم كما يُرى من نقطتين مختلفتين ليستا على خط واحد مع الجسم)",
 "parallel": "مُوَازٍ / مُتَوَازٍ",
 "parallel axiom": "بديهية إقليدس الخامسة, بديهية التوازي (يمكن رسم خط واحد فقط عبر نقطة موازياً لخط آخر)",
 "parallel bars": "المتوازي, قضيبان متوازيان (جهاز جمباز يتكون من قضيبين خشبيين متوازيين مثبتين على قوائم)",
 "parallel circuit": "دائرة توازي (دائرة مغلقة ينقسم فيها التيار إلى مسارين أو أكثر قبل إعادة الاتحاد لإكمال الدائرة)",
 "parallel computing": "حَوْسَبَة مُتَوَازِية",
 "parallel interface": "منفذ متوازي, واجهة متوازية (واجهة بين الكمبيوتر والطابعة حيث يرسل الكمبيوتر بتات متعددة من المعلومات إلى الطابعة في وقت واحد)",
 "parallel of latitude": "خط عرض, دائرة العرض (خط وهمي حول الأرض موازٍ لخط الاستواء)",
 "parallel operation": "عملية متزامنة, عملية متوازية (التنفيذ المتزامن لعمليتين أو أكثر)",
 "parallel port": "منفذ متوازي, واجهة متوازية (واجهة بين الكمبيوتر والطابعة حيث يرسل الكمبيوتر بتات متعددة من المعلومات إلى الطابعة في وقت واحد)",
 "parallel processing": "معالجة متعددة, معالجة متوازية (معالجة متزامنة بواسطة وحدتي معالجة أو أكثر)",
 "parallel universe": "عَالَم مُوَازِي (الذي يعلم؛ متخصص في عِلْم ما وباحث فيه)\nمثال: هو عالم أحيائي.",
 "parallel-veined leaf": "ورقة متوازية التعرق (ورقة تمتد عروقها بشكل متوازٍ من الساق)",
 "parallelepiped": "متوازي السطوح (منشور قاعدتاه متوازيات أضلاع)",
 "parallelepipedon": "متوازي السطوح (منشور قاعدتاه متوازيات أضلاع)",
 "parallelism": "تَنَاظُر, تَوَازٍ (التشابه بحكم التوافق أو التناظر)",
 "parallelogram": "مُتَوَازِي أَضْلَاع",
 "parallelopiped": "متوازي السطوح (منشور قاعدتاه متوازيات أضلاع)",
 "parallelopipedon": "متوازي السطوح (منشور قاعدتاه متوازيات أضلاع)",
 "paralogism": "قياس فاسد (حجة غير صحيحة عن غير قصد)",
 "paralympian": "بَارَالَمْبِيّ, بَارَالَمْبِيّة",
 "paralympic": "بَارَالَمْبِيّ",
 "paralympic games": "أَلْعَاب بَارَالِمْبِيَّة",
 "paralympics": "الألعاب البارالمبية (أحداث رياضية دولية متعددة للأشخاص ذوي الإعاقة)",
 "paralysis": "شَلَل, فَالَج",
 "paralysis agitans": "الشلل الرعاش, داء باركنسون (اضطراب تنكسي في الجهاز العصبي المركزي يتميز بالرعاش وضعف التنسيق العضلي)",
 "paralytic": "مَشْلُول (مصاب بالشلل) / شللي (متعلق بـ أو من طبيعة الشلل) / مشلول (شخص يعاني من الشلل)\nمثال: أعراض شللية",
 "paralytic abasia": "عدم القدرة على المشي الشللي (عدم القدرة على المشي المرتبط بشلل عضلات الساق)",
 "paralytical": "شللي (متعلق بـ أو من طبيعة الشلل)\nمثال: أعراض شللية",
 "paralyze": "أَشَلَّ ((أَشَلَّ) فلانٌ: أصَابه الشَّلَل؛ (أَشَلَّ) اللهُ فلانًا أَو يَدَهُ: أصابَها بالشَّلَل)",
 "paralyzed": "مَشْلُول",
 "paramagnet": "مغناطيس مساير (مغناطيس مصنوع من مادة تتناسب مغنطتها مع قوة المجال المغناطيسي المطبق عليها)",
 "paramagnetic": "بارامغناطيسي (من أو يتعلق بالمادة البارامغناطيسية)",
 "paramagnetism": "بارامغناطيسية, مغناطيسية مسايرة (مواد مثل الألومنيوم أو البلاتين تصبح ممغنطة في مجال مغناطيسي لكنها تختفي عند إزالة المجال)",
 "paramaribo": "بَارَامَارِيبُو",
 "paramecia": "براميسيوم (أي عضو من جنس البراميسيوم)",
 "paramecium": "براميسيوم (أي عضو من جنس البراميسيوم)",
 "paramedic": "مُسْعِف, مُسْعِفة",
 "paramedical": "شبه طبي, مساعد طبي (مكون من أو يشير إلى شخص مدرب لمساعدة الأطباء والممرضات في أنشطتهم) / مسعف (شخص مدرب لمساعدة المهنيين الطبيين وتقديم العلاج الطبي الطارئ)\nمثال: سائقو سيارات الإسعاف هم شبه طبيين لتقديم المساعدة الطبية الطارئة",
 "parameter": "وَسِيط, بَارَامِتِر / مَعْلَم, وَسِيط (من يمتهن التعليم، مُدَرِّس)\nمثال: هي أصبحت معلمة.",
 "parametric": "بارامتري, وسيطي (متعلق بالوسيط (البارامتر) أو بدلالته)\nمثال: معادلة وسيطية",
 "parametric quantity": "بارامتر, وسيط (ثابت في معادلة منحنى يمكن تغييره لإنتاج عائلة من المنحنيات المماثلة)",
 "parametric statistic": "إحصائية معلمية (أي إحصائية تُحسب بإجراءات تفترض أن البيانات سُحبت من توزيع معين)",
 "parametritis": "التهاب حول الرحم (التهاب النسيج الضام المجاور للرحم)",
 "paramilitary": "شبه عسكري (مكون من أو متعلق بمجموعة من المدنيين المنظمين للعمل مثل وحدة عسكرية أو لمساعدتها) / قوات شبه عسكرية (مجموعة من المدنيين منظمين بطريقة عسكرية (خاصة للعمل بدلاً من أو لمساعدة قوات الجيش النظامي))",
 "paramilitary force": "قوات شبه عسكرية (مجموعة من المدنيين منظمين بطريقة عسكرية (خاصة للعمل بدلاً من أو لمساعدة قوات الجيش النظامي))",
 "paramilitary organisation": "قوات شبه عسكرية (مجموعة من المدنيين منظمين بطريقة عسكرية (خاصة للعمل بدلاً من أو لمساعدة قوات الجيش النظامي))",
 "paramilitary organization": "قوات شبه عسكرية (مجموعة من المدنيين منظمين بطريقة عسكرية (خاصة للعمل بدلاً من أو لمساعدة قوات الجيش النظامي))",
 "paramilitary unit": "قوات شبه عسكرية (مجموعة من المدنيين منظمين بطريقة عسكرية (خاصة للعمل بدلاً من أو لمساعدة قوات الجيش النظامي))",
 "paramnesia": "بارامنيزيا, ذاكرة كاذبة ((الطب النفسي) اضطراب في الذاكرة يتم فيه الخلط بين الأحلام أو الأوهام والواقع)",
 "paramount": "أعلى فائق (اسم تفضيل من عَلَا/ علا في؛ أكثر ارتفاعًا، عكْسه أسفل سقط من أعلى المبنى) / أساسي\nمثال: خذها إلى الأعلى.",
 "paramount issue": "قضية جوهرية, قضية قصوى (قضية تعتبر تسويتها أكثر أهمية من أي شيء آخر؛ قضية يجب تسويتها قبل أي شيء آخر)",
 "paramountcy": "أفضلية, صدارة (حالة كونه الأسمى؛ المرتبة أو السلطة الأعلى)",
 "paramour": "خَلِيل, خَلِيلَة",
 "paramyxovirus": "باراميكسوفيروس, فيروس مخاطي (مجموعة من الفيروسات تشمل تلك المسببة للنكاف والحصبة)",
 "paranasal": "جنيب الأنف, مجاور للأنف (متاخم للتجاويف الأنفية)\nمثال: جيب مجاور للأنف",
 "paranasal sinus": "جيب أنفي, جيب جانب أنفي (أي من الجيوب المزدوجة في عظام الوجه المجاورة للتجويف الأنفي والمبطنة بغشاء مخاطي متصل ببطانة تجاويف الأنف)",
 "parang": "بارانج, سكين المنجل (سكين مستقيم قوي يستخدم في ماليزيا وإندونيسيا)",
 "paranoia": "بَارَانُويَا, جُنُون اِضْطِهَاد",
 "paranoiac": "مُرْتاب, مُصاب بِالبارانُويا (شخص مصاب بالبارانويا (الارتياب))",
 "paranoic type schizophrenia": "فصام بارانوي, فصام زوراني (شكل من أشكال الفصام يتميز بأوهام (الاضطهاد أو العظمة أو الغيرة)؛ قد تشمل الأعراض الغضب والقلق والانعزال والشكوك حول الهوية الجنسية؛ وخلافاً لأنواع…)",
 "paranoid": "بَارَانُويِيّ",
 "paranoid schizophrenia": "فصام بارانوي, فصام زوراني (شكل من أشكال الفصام يتميز بأوهام (الاضطهاد أو العظمة أو الغيرة)؛ قد تشمل الأعراض الغضب والقلق والانعزال والشكوك حول الهوية الجنسية؛ وخلافاً لأنواع…)",
 "paranormal": "خارق للطبيعَة (الشيء)\nمثال: ذلك خارق للعادة.",
 "paranthias furcifer": "سمكة الكريول (سمكة أعماق في المحيط الأطلسي الاستوائي)",
 "paranthropus": "بارانثروبوس (تصنيف سابق لأسترالوبيثكس روبوستوس)",
 "paraná": "بَارَانَا",
 "paraparesis": "خزل سفلي, شلل نصفي سفلي طفيف (شلل طفيف أو ضعف في كلا الساقين)",
 "parapet": "حاجز صد, ساتر (تحصين يتكون من جدار منخفض) / تصوينة, درابزين سور (جدار منخفض على طول حافة السطح أو الشرفة)",
 "paraph": "توقيع مختصر (جرة قلم تُضاف بعد توقيعك أو تحته (أصلاً للحماية من التزوير))",
 "paraphernalia": "تجهيزات, عُدَّة (معدات تتكون من مواد متنوعة لازمة لعملية معينة أو رياضة وما إلى ذلك)",
 "paraphilia": "بَارَافِيلِيَا / اِنْحِرَاف جِنْسِيّ / شُذُوذ جِنْسِيّ",
 "paraphrase": "سَرَدَ (الشيء: نَسَجَهُ ليصبح مفهوما؛ الأمر:الحديث يتلوه بإستمرار)\nمثال: يحاول الانفصاليون تطوير سرد زائف من أجل تبرير مشروعهم السياسي.",
 "paraphrasis": "إعادة صياغة توضيحية, تفسير (إعادة الصياغة بغرض التوضيح)",
 "paraphrastic": "مُعَاد صِيَاغَتُه (تمّ تعديله عن طريق إعادة الصياغة)",
 "paraphrenia": "فصام بارانوي, فصام زوراني (شكل من أشكال الفصام يتميز بأوهام (الاضطهاد أو العظمة أو الغيرة)؛ قد تشمل الأعراض الغضب والقلق والانعزال والشكوك حول الهوية الجنسية؛ وخلافاً لأنواع…)",
 "paraphrenic schizophrenia": "فصام بارانوي, فصام زوراني (شكل من أشكال الفصام يتميز بأوهام (الاضطهاد أو العظمة أو الغيرة)؛ قد تشمل الأعراض الغضب والقلق والانعزال والشكوك حول الهوية الجنسية؛ وخلافاً لأنواع…)",
 "paraphysis": "بارافيز, شعيرة عقيمة (خيط بسيط أو متفرع عقيم أو شعرة تحمل بين الأبواغ؛ قد تكون مدببة أو هراوية الشكل)",
 "paraplegia": "شلل سفلي (شلل النصف السفلي من الجسم)",
 "paraplegic": "مُصَاب بِالشَّلَل النِّصْفِيّ السُّفْلِيّ (يعاني من شلل كامل في النصف السفليّ من الجسم نتيجة إصابة في الحبل الشوكيّ عادةً) / مشلول النصف السفلي (شخص يعاني من شلل نصفي سفلي (مشلول من الخصر إلى الأسفل))",
 "parapodium": "قدم جانبية, نظير قدم (واحدة من زوج من الزوائد اللحمية للديدان الحلقية عديدة الأشواك التي تعمل في الحركة والتنفس)",
 "parapraxis": "زلة, هفوة (خطأ بسيط غير مقصود يُلاحظ عادة في الكلام أو الكتابة أو في الحوادث الصغيرة أو هفوات الذاكرة)",
 "paraprofessional": "مساعد مهني (عامل مدرب ليس عضواً في مهنة ولكنه يساعد محترفاً)",
 "parapsychological": "بَارَاسِيكُولُوجِيّ (يتجاوز التفسير الفيزيائي العادي)",
 "parapsychologist": "باراسيكولوجي, عالم ما وراء النفس (شخص يدرس الأدلة على الظواهر النفسية مثل التحريك النفسي والتخاطر والاستبصار)",
 "parapsychology": "باراسيكولوجيا, ظواهر نفسية خارقة (ظواهر تبدو وكأنها تتناقض مع القوانين الفيزيائية وتشير إلى إمكانية السببية عن طريق العمليات العقلية)",
 "paraquat": "باراكوات (مادة صلبة صفراء سامة تستخدم في محلول كمبيد للأعشاب)",
 "paraquat poisoning": "تسمم بالباركوات (تسمم ناتج عن تناول الباركوات؛ يتميز بتلف تدريجي للمريء والكبد والكلى)",
 "paraquet": "ببغاء صغير, براكيت (أي من الببغاوات الصغيرة النحيلة طويلة الذيل العديدة)",
 "parasail": "مظلة هوائية (مظلة ترفع الشخص في الهواء عندما يتم سحبها بواسطة قارب بمحرك أو سيارة)",
 "parasailing": "تزلج هوائي, طيران مظلي (الطيران بمظلة شراعية)",
 "parascalops breweri": "خلد مشعر الذيل (خلد من شرق أمريكا الشمالية)",
 "parasitaemia": "تطفل الدم (حالة توجد فيها طفيليات في الدم)",
 "parasitaxus ustus": "طقسوس طفيلي (صنوبرية طفيلية نادرة ومهددة بالانقراض أحادية المسكن في كاليدونيا الجديدة؛ تتطفل على فالكاتيفوليوم تاكسويدس)",
 "parasite": "طُفَيْلِيّ",
 "parasite yew": "طقسوس طفيلي (صنوبرية طفيلية نادرة ومهددة بالانقراض أحادية المسكن في كاليدونيا الجديدة؛ تتطفل على فالكاتيفوليوم تاكسويدس)",
 "parasitemia": "تطفل الدم (حالة توجد فيها طفيليات في الدم)",
 "parasitic": "طُفَيْلِيّ",
 "parasitic jaeger": "كركر طفيلي, كركر قطبي (نوع من الكركر)",
 "parasitic plant": "نبات طفيلي (نبات يعيش على نبات آخر ويحصل منه على الغذاء العضوي)",
 "parasitic worm": "دودة طفيلية (دودة تتطفل على أمعاء الفقاريات خاصة الديدان الأسطوانية والديدان الشريطية والمثقوبات)",
 "parasitical": "طُفَيْلِيّ, مُتَطَفِّل (لَهُ طَبِيعَةُ الطُّفَيْلِيّ؛ يَعِيشُ عَلَى حِسَابِ غَيْرِه) / طفيلي (متعلق بالطفيليات أو ناتج عنها)\nمثال: عدوى طفيلية",
 "parasitically": "بشكل طفيلي, تطفلياً (بطريقة طفيلية)",
 "parasiticidal": "طارِد لِلدِّيدان, مُبيد لِلطُّفَيْلِيّات (يَقْتُل الدِّيدان والطُّفَيْلِيّات المِعَوِيَّة)",
 "parasitism": "تَطَفُّل (العلاقة بين نوعين مختلفين من الكائنات الحية يحصل فيها أحدهما على فوائد من الآخر عن طريق التسبب في ضرر له (عادة ما يكون ضرراً غير مميت))",
 "parasitoid wasp": "زِنْبَار طُفَيْلِيّ",
 "parasol": "مَظَلَّة, شَمْسِيَّة",
 "parasol mushroom": "فطر المظلة (فطر صالح للأكل طويل الساق بلحم أبيض وخياشيم وأبواغ؛ يوجد في الغابات المفتوحة في الخريف)",
 "parasympathetic": "جار سمبثاوي, نظير الودي (من أو يتعلق بالجهاز العصبي نظير الودي) / الجهاز العصبي الباراسمبثاوي, الجهاز العصبي اللاودي (ينشأ في جذع الدماغ والجزء السفلي من الحبل الشوكي؛ يعارض التأثيرات الفسيولوجية للجهاز العصبي الودي: يحفز الإفرازات الهضمية؛ يبطئ القلب؛ يقبض حدقة…)",
 "parasympathetic nervous system": "الجهاز العصبي الباراسمبثاوي, الجهاز العصبي اللاودي (ينشأ في جذع الدماغ والجزء السفلي من الحبل الشوكي؛ يعارض التأثيرات الفسيولوجية للجهاز العصبي الودي: يحفز الإفرازات الهضمية؛ يبطئ القلب؛ يقبض حدقة…)",
 "parasympathomimetic": "محاكي نظير الودي (له تأثير مماثل لذلك الناتج عن تحفيز الجهاز العصبي نظير الودي)\nمثال: الأدوية المحاكية لنظير الودي تبطئ معدل ضربات القلب",
 "parathelypteris novae-boracensis": "سرخس نيويورك (سرخس درعي رفيع في الغابات الرطبة في شرق أمريكا الشمالية؛ يوضع أحياناً في جنس دريوبتريس)",
 "parathelypteris simulata": "سرخس ماساتشوستس (سرخس درعي ريشي رقيق في شرق الولايات المتحدة؛ يوضع أحياناً في جنس ثيليبترس)",
 "parathion": "باراثيون (زيت سام عديم اللون والرائحة يستخدم كمبيد حشري)",
 "parathion poisoning": "تسمم بالباراثيون (حالة تسمم ناتجة عن استنشاق أو تناول مبيد الحشرات باراثيون؛ تتميز بالغثيان وآلام البطن والصداع والتشنجات والتعرق)",
 "parathormone": "باراثورمون, هرمون الغدة الجار درقية (هرمون يتم تصنيعه وإطلاقه في مجرى الدم بواسطة الغدد الجار درقية؛ ينظم الفوسفور والكالسيوم في الجسم)",
 "parathyroid": "غدة جار درقية, غدة جارات الدرقية (أي واحدة من أربع غدد صماء تقع فوق أو داخل الغدة الدرقية)",
 "parathyroid gland": "غدة جار درقية, غدة جارات الدرقية (أي واحدة من أربع غدد صماء تقع فوق أو داخل الغدة الدرقية)",
 "parathyroid hormone": "باراثورمون, هرمون الغدة الجار درقية (هرمون يتم تصنيعه وإطلاقه في مجرى الدم بواسطة الغدد الجار درقية؛ ينظم الفوسفور والكالسيوم في الجسم)",
 "paratrooper": "مِظَلِّيّ",
 "paratroops": "مظليين (مشاة مدربون ومجهزون للقفز بالمظلات)",
 "paratyphoid": "حمى نظيرة التيفوئيد, نظير التيفوئيد (أي من مجموعة متنوعة من الأمراض المعوية المعدية التي تشبه حمى التيفوئيد)",
 "paratyphoid fever": "حمى نظيرة التيفوئيد, نظير التيفوئيد (أي من مجموعة متنوعة من الأمراض المعوية المعدية التي تشبه حمى التيفوئيد)",
 "paraumbilical vein": "وريد مجاور للسرة (أوردة صغيرة تنشأ في الجلد حول السرة؛ تنتهي كأوردة بابية إضافية)",
 "parazoan": "إسفنج, إسفنجيات (حيوان بحري بدائي متعدد الخلايا يدعم جسمه المسامي هيكل ليفي؛ يوجد عادة في مستعمرات لاطئة)",
 "paraíba": "بَارَايْبَا",
 "parcae": "باركاي (أي من إلهات القدر أو المصير الثلاث الرومانيات؛ يتماهين مع المويراي اليونانية ويشبهن نورن الإسكندنافية)",
 "parcel": "رِزْمَة, رُزْمَة",
 "parcel bomb": "رسالة مفخخة, طرد مفخخ (جهاز متفجر رقيق داخل ظرف أو طرد وينفجر عند فتحه)",
 "parcel of land": "رقعة أرض, قطعة أرض (مساحة ممتدة من الأرض)",
 "parcel post": "خدمة الطرود (خدمة بريدية تتولى نقل الطرود)",
 "parceled out": "مُقَسَّم, مُوَزَّعٌ بِالتَّقْسِيطِ (مُوَزَّعٌ عَلَى حِصَصٍ أَوْ أَنْصِبَةٍ)",
 "parceling": "تخصيص, تقسيم (فعل التوزيع عن طريق التخصيص أو التقسيم؛ التوزيع وفقاً لخطة)\nمثال: يعتمد توزيع المقاعد في مجلس النواب على الكثافة السكانية لكل ولاية",
 "parcellation": "تجزئة, تقسيم إلى قطع (التقسيم إلى طرود أو قطع أراض)\nمثال: التجزئة المتزايدة للأراضي مع كل جيل",
 "parcelling": "تخصيص, تقسيم (فعل التوزيع عن طريق التخصيص أو التقسيم؛ التوزيع وفقاً لخطة)\nمثال: يعتمد توزيع المقاعد في مجلس النواب على الكثافة السكانية لكل ولاية",
 "parched": "مُحَمَّص (مُحَمَّصٌ أَوْ مَشْوِيٌّ قَلِيلًا) / مُحْتَرِق, يَابِس مِنَ الحَرّ (جفّ بفعل الحرارة أو التعرّض المفرط لأشعّة الشمس)",
 "parcheesi": "بارشيسي (لعبة لوحية حديثة تعتمد على الباتشيسي)",
 "parchesi": "باتشيسي (لعبة لوحية قديمة تشبه الطاولة؛ تُلعب على لوحة صليبية الشكل)",
 "parchisi": "باتشيسي (لعبة لوحية قديمة تشبه الطاولة؛ تُلعب على لوحة صليبية الشكل)",
 "parchment": "رَقّ",
 "pardner": "شَرِيك, مُتَعاوِن (شريك في نشاط أو مسعى أو مجال ذي اهتمام مشترك)\nمثال: كان الموسيقي وكاتب الليبريتو متعاونين",
 "pardon": "إِبْرَاء, إِعْفَاء / عَفْو, صَفْح / عَفَا (عَفَا شَعَرُ البَعِيرِ: كَثُرَ، وطَالَ فَغَطَّى دُبُرَهُ؛ عَفَا أثَرُهُ عفاءً: هَلَكَ) / عَفْواً!, مَاذَا قُلْتَ؟",
 "pardon me": "عَفْوًا",
 "pardon my french": "لَا تُؤَاخِذْنِي, أَسْتَمِيحُكَ عُذْرًا (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: لا أحب المدرسة.",
 "pardonable": "قابل للعفو, مغتفر (مما يقبل العفو)",
 "pardonably": "بشكل مقبول, بشكل يُعذر عليه (بطريقة قابلة للعذر أو إلى درجة يمكن التجاوز عنها)\nمثال: تأخر بشكل يمكن عذره",
 "pardoner": "بائع صكوك الغفران (رجل دين من العصور الوسطى كان يجمع المال للكنيسة عن طريق بيع صكوك الغفران البابوية) / غَافِر, مُسَامِح (شخص يعفو أو يغفر أو يسامح عن خطأ أو جريمة)",
 "paregmenon": "اشتقاق (تجاوز كلمات لها اشتقاق مشترك)",
 "paregoric": "باراغوريك, صبغة الأفيون الكافورية (دواء يستخدم لعلاج الإسهال)",
 "pareidolia": "بَارِيدُولِيَا",
 "pareidolic": "بَارِيدُولِيّ",
 "parenchyma": "متن, نسيج حشوي (نسيج حيواني يشكل الجزء الأساسي والوظيفي للعضو على النقيض من النسيج الضام والأوعية الدموية) / نسيج برانشيمي, نسيج حشوي (النسيج الأولي للنباتات العليا المكون من خلايا رقيقة الجدران تظل قادرة على الانقسام حتى عند النضج؛ يشكل الجزء الأكبر من الأوراق والجذور ولب الفواكه…)",
 "parenesis": "تحذير أخلاقي, وعظ ((بلاغة) حث؛ تحذير ونصح)",
 "parent": "وَالِد (الذي قام بالولادة؛ هو الذكر الذي كان له دور مباشر وعضوي في تكوين الطفل في الجنين؛ الأب الطبيعي) / وَالِدَة (اسم فاعل مؤنث للفعل \"وَلَدَ\"؛ مرادف لـ\"أُمّ\") / وَالِدَان (الشكل المثنى من \"وَالِد\" في حالة الرفع)\nمثال: ألست والدة توم؟",
 "parentage": "أصل, سلالة (الاشتقاق الوراثي للفرد) / أُبُوَّة وَأُمُومَة, وِلَادَة (علاقة القرابة بين النسل والوالدين) / أبوة أو أمومة, والدية (حالة كونه والداً)\nمثال: كل سلالته كانت محاربين",
 "parental": "وَالِدِيّ",
 "parental leave": "إجازة عائلية, إجازة والدية (ميزة للموظفين تتيح إجازة مدفوعة الأجر لرعاية طفل أو ترتيب شؤونه، تشمل إجازة الأمومة والأبوة)",
 "parental quality": "أُبُوَّة/أُمُومَة, صِفَة وَالِدِيَّة (صفة مناسبة للوالد)",
 "parentally": "بأسلوب الوالدين (بطريقة أبوية أو أمومية)",
 "parented": "ذو أبوين, مرعي (لديه والد أو والدين أو يرعاه بدائل الوالدين)",
 "parenteral": "حقني, خارج معوي (يقع خارج الجهاز الهضمي) / بالحقن, خارج معوي (يتم إعطاؤه بوسائل أخرى غير القناة الهضمية (كما عن طريق الحقن العضلي أو الوريدي))",
 "parenterally": "بالحقن (عن طريق الحقن (طبياً))\nمثال: المقصود إعطاء الدواء بالحقن",
 "parenthesis": "حشو",
 "parenthesis-free notation": "تدوين خالٍ من الأقواس (تدوين لتكوين تعبيرات رياضية لا يستخدم الأقواس لتحديد المكونات)",
 "parenthetic": "اِعْتِرَاضِيّ, بَيْنَ قَوْسَيْن (يُوضِّح أو يُقيِّد؛ موضوع أو كأنّه موضوع بين قوسين)",
 "parenthetical": "اِعْتِرَاضِيّ, بَيْنَ قَوْسَيْن (يُوضِّح أو يُقيِّد؛ موضوع أو كأنّه موضوع بين قوسين) / تعبير اعتراضي (تعبير بين قوسين)\nمثال: كانت كتاباته مليئة بالعبارات الاعتراضية",
 "parenthetical expression": "تعبير اعتراضي (تعبير بين قوسين)\nمثال: كانت كتاباته مليئة بالعبارات الاعتراضية",
 "parenthetically": "بين قوسين, عرضاً (بطريقة اعتراضية)\nمثال: أضاف عرضاً أنه لن يحضر حفل الزفاف",
 "parenthood": "أبوة أو أمومة, والدية (حالة كونه والداً)\nمثال: لمفاجأة الجميع، أصلحت الأبوة الرجل",
 "parentless": "بلا والدين, يتيم (ليس لديه والد أو والدين أو لا يرعاه بدائل الوالدين)",
 "parer": "سكين تقشير (سكين حاد صغير يستخدم في تقشير الفواكه أو الخضروات) / مقلّم (أخصائي تقليم أظافر يقلم الأظافر)",
 "paresis": "خزل, شلال جزئي (شلل طفيف أو جزئي)",
 "paresthesia": "تنميل, خدر (أحاسيس جلدية غير طبيعية (مثل الوخز أو الدغدغة أو الحكة أو الحرقان) ترتبط عادة بتلف الأعصاب المحيطية)",
 "paretic": "مصاب بالخزل (شخص مصاب بالخزل (شلل جزئي))",
 "pareve": "بَارِف, مُحَايِدٌ غِذَائِيًّا (لا يحتوي على لحم أو حليب (أو مشتقّاتهما) فيُؤكل مع أطباق اللحم والألبان وفق الشريعة اليهودية)",
 "parfait": "بارفيه (طبقات من الآيس كريم والشراب المركز والكريمة المخفوقة)",
 "parfait glass": "كأس بارفيه (كأس طويل نحيف ذو ساق قصيرة يقدم فيه البارفيه)",
 "parget": "جص تكسية, ملاط تكسية (جص يستخدم لطلاء الجدران الخارجية وتبطين المداخن)",
 "pargeting": "زخرفة جصية (تجصيص زخرفي) / زخرفة جصية (أعمال جصية زخرفية) / جص تكسية, ملاط تكسية (جص يستخدم لطلاء الجدران الخارجية وتبطين المداخن)",
 "pargetry": "زخرفة جصية (أعمال جصية زخرفية)",
 "pargetting": "زخرفة جصية (تجصيص زخرفي) / زخرفة جصية (أعمال جصية زخرفية) / جص تكسية, ملاط تكسية (جص يستخدم لطلاء الجدران الخارجية وتبطين المداخن)",
 "parheliacal": "شمسي كاذب (متعلق بـ أو يشبه الشمس الكاذبة (ظاهرة بصرية))",
 "parhelic": "شمسي كاذب (متعلق بـ أو يشبه الشمس الكاذبة (ظاهرة بصرية))",
 "parhelic circle": "حلقة شمسية, هالة شمسية (هالة مضيئة موازية للأفق عند ارتفاع الشمس؛ تسببها بلورات الجليد في الغلاف الجوي)",
 "parhelic ring": "حلقة شمسية, هالة شمسية (هالة مضيئة موازية للأفق عند ارتفاع الشمس؛ تسببها بلورات الجليد في الغلاف الجوي)",
 "parhelion": "شمس كاذبة, شمس وهمية (بقعة ساطعة على الدائرة الشمسية؛ ناتجة عن انكسار الضوء بواسطة بلورات الجليد)\nمثال: عادة ما تُرى شمسين وهميتين أو أكثر في وقت واحد",
 "pari passu": "بِنَفْس النِّسْبَة, عَلَى قَدَم المُسَاوَاة (تستخدم في اللغة القانونية)",
 "pari-mutuel machine": "آلة الرهان المتبادل, توتاليزيتور (حاسوب يسجل الرهانات ويقسم المبلغ الإجمالي للرهان بين الفائزين)",
 "pariah": "طَرِيد, مَنْبُوذ (شخص مرفوض (من المجتمع أو الوطن))",
 "pariah dog": "كلب منبوذ (كلب هجين نصف بري بلا مالك شائع حول القرى الآسيوية خاصة الهند)",
 "paries": "جدار ((تشريح) طبقة (بطانة أو غشاء) تحيط بهيكل ما)\nمثال: جدران المعدة",
 "parietal": "جِدَارِيّ",
 "parietal bone": "عظم جداري (أي من عظمي الجمجمة الواقعين بين العظم الجبهي والعظم القذالي ويشكلان أعلى وجوانب القحف)",
 "parietal cortex": "الفص الجداري (ذلك الجزء من القشرة المخية في أي من نصفي الدماغ الواقع أسفل قمة الرأس)",
 "parietal gyrus": "تلفيف جداري (أي من تلافيف السطح الخارجي للفص الجداري للمخ)",
 "parietal lobe": "فص جداري",
 "parietal pericardium": "تامور جداري (الطبقة الخارجية القوية للتامور المتصلة بالحجاب الحاجز والقص)",
 "parietal placentation": "وضع مشيمة جداري (حيث تتطور البويضات على الجدار أو نتوءات طفيفة للجدار تشكل حواجز مكسورة داخل مبيض مركب)",
 "parietal pleura": "جنب جداري (الجنب الذي يبطن جدران الصدر الداخلية ويغطي الحجاب الحاجز)",
 "parietaria difusa": "جدارية, حشيشة الزجاج (عشب ينمو في الشقوق له أوراق ضيقة طويلة وأزهار وردية صغيرة عديمة البتلات)",
 "parieto-occipital fissure": "التلم الجداري القذالي (تلم بالقرب من الطرف الخلفي لكل نصف كرة يفصل الفصوص الجدارية عن الفصوص القذالية)",
 "parieto-occipital sulcus": "التلم الجداري القذالي (تلم بالقرب من الطرف الخلفي لكل نصف كرة يفصل الفصوص الجدارية عن الفصوص القذالية)",
 "parietomastoid suture": "درز جداري خشائي (الدرز بين العظم الجداري والعظم الصدغي)",
 "parimutuel": "باري-موتويل, رهان متبادل (مراهنة يتقاسم فيها الفائزون المبلغ الإجمالي للمراهنات)",
 "paring": "قُشارة ((عادة بالجمع) جزء من فاكهة أو خضروات تم تقشيره أو قطعه؛ وخاصة الجلد أو القشرة) / قُشَارة, كُشَاطَة (شظية أو شريحة رفيعة (خاصة من الخشب) تم كشطها أو حلقها من شيء ما)\nمثال: كانت تستطيع تقشير تفاحة بقشارة واحدة طويلة",
 "paring knife": "سكين تقشير (سكين حاد صغير يستخدم في تقشير الفواكه أو الخضروات)",
 "paripinnate": "زَوْجِيّ التَّرِيُّش ((عن شكل الورقة) ريشيّ بزوج من الوريقات عند القمّة)",
 "paris": "بَارِيس / بَارِيز / باريس / پاريس",
 "paris daisy": "أقحوان المارغريت, أقحوان شجيري (شجيرة معمرة من جزر الكناري لها زهور تشبه الأقحوان صفراء شاحبة عادة؛ تُصنف غالباً ضمن جنس الأقحوان)",
 "paris green": "أخضر ليموني, أخضر مصفر (درجة من الأخضر مشوبة بالأصفر) / أخضر باريس (ملح مزدوج سام من زرنيخات النحاس وخلات النحاس)",
 "paris quadrifolia": "عشبة باريس (عشب أوروبي ذو أزهار خضراء مصفرة يشبه ويرتبط ارتباطاً وثيقاً بالتريليوم؛ يشتهر بكونه ساماً)",
 "parish": "أبرشية / رَعِيَّة",
 "parishioner": "أبناء الرعية (عضو في رعية)",
 "parisian": "بَارِيسِيّ, بَارِيسِيَّة",
 "parisienne": "بَارِيسِيَّة",
 "parisology": "استخدام كلمات ملتبسة (استخدام كلمات غامضة)",
 "parity": "تَكَافُؤ, تَمَاثُل (مساواة وظيفية) / تكافؤ, حفظ التكافؤ ((فيزياء) التكافؤ محفوظ في كون تكون فيه قوانين الفيزياء هي نفسها في نظام إحداثيات يمني كما في نظام يساري) / بت التدقيق, بت التكافؤ ((علم الحاسوب) بت يُستخدم في إجراء كشف الأخطاء حيث يُضاف 0 أو 1 إلى كل مجموعة من البتات ليكون مجموع الآحاد فرديًا أو زوجيًا) / تَمَاثُل, زَوْجِيَّة ((الرياضيات) علاقة بين زوج من الأعداد الصحيحة: إذا كان كلاهما فردياً أو كلاهما زوجياً فلهما نفس الزوجية)",
 "parity bit": "بت التدقيق, بت التكافؤ ((علم الحاسوب) بت يُستخدم في إجراء كشف الأخطاء حيث يُضاف 0 أو 1 إلى كل مجموعة من البتات ليكون مجموع الآحاد فرديًا أو زوجيًا)",
 "parity check": "فحص التكافؤ (نظام للتحقق من الأخطاء في عمل الكمبيوتر)",
 "parji": "بارجي (لغة درافيدية يتم التحدث بها في جنوب وسط الهند، يتحدث بها قبيلة دوروا)",
 "parji language": "بارجي (لغة درافيدية يتم التحدث بها في جنوب وسط الهند، يتحدث بها قبيلة دوروا)",
 "park": "حَدِيقَة (الحَديقَةُ، الرَّوْضَةُ ذاتُ الشجرِ؛ حديقة , العاطل عن العمل في اللهجة العراقية وأصل تولد المعنى أن بعض العاطلين يقضون أوقاتهم في العناية بحدائق بيوتهم, فإذا سألهم سائل عن عملهم, ما هو؟…) / وَقَّفَ, صَفَّ (قَامَ، اِنْتَصَبَ، نَهَضَ؛ ثَبَتَ)\nمثال: ليس لدينا حديقة.",
 "park bench": "مقعد حديقة (مقعد في حديقة عامة)",
 "park commissioner": "مفوض الحدائق (مفوض مسؤول عن الحدائق العامة)",
 "parka": "باركا, سترة واقية (نوع من السترات الثقيلة)",
 "parka squirrel": "سنجاب الأرض القطبي (سنجاب أرضي كبير من أقصى شمال أمريكا الشمالية)",
 "parked": "متوقف, مركون (التي تم تركها (مركونة))\nمثال: كانت هناك أربع سيارات متوقفة عبر الشارع",
 "parker house roll": "لفافة باركر هاوس (لفافة عشاء مخمرة بالخميرة تصنع بطي قرص من العجين قبل الخبز)",
 "parkia javanica": "باركية جاوية (شجرة غابات مطيرة طويلة دائمة الخضرة ذات تاج واسع الانتشار وزهور بيضاء صفراء؛ تزرع للزينة في المتنزهات والحدائق الكبيرة)",
 "parking": "مَوْقِف, مَوْقِف سَيَّارَات",
 "parking area": "مرآب, موقف سيارات (قطعة أرض تُوقف فيها السيارات)",
 "parking brake": "مكبح الطوارئ, مكبح يدوي (مكبح يعمل باليد؛ يعمل عادة عن طريق وصلة ميكانيكية)",
 "parking lot": "مَوْقِف سَيَّارَات, مَوْقِف",
 "parking meter": "عداد انتظار السيارات",
 "parking space": "مَوْقِف",
 "parking ticket": "مخالفة انتظار (مخالفة تصدر للوقوف في مكان محظور)",
 "parking zone": "مكان انتظار, موقف سيارة (مساحة يمكن إيقاف السيارة فيها)",
 "parkinson's": "الشلل الرعاش, داء باركنسون (اضطراب تنكسي في الجهاز العصبي المركزي يتميز بالرعاش وضعف التنسيق العضلي)",
 "parkinson's disease": "مَرَض بَارْكِنْسُون (أصابه مرضٌ أو علّة أو سَقَم)\nمثال: هذا المرض قلبي.",
 "parkinson's syndrome": "الشلل الرعاش, داء باركنسون (اضطراب تنكسي في الجهاز العصبي المركزي يتميز بالرعاش وضعف التنسيق العضلي)",
 "parkinsonia aculeata": "شوكة القدس, فاصوليا الحصان (شجيرة كبيرة أو شجرة شجيرية ذات أشواك حادة وأوراق ريشية وريقات صغيرة متساقطة وأزهار صفراء برتقالية عنقودية حلوة الرائحة؛ تزرع كزينة أو سياج أو طعام…)",
 "parkinsonia florida": "بالو فيردي (شجرة شائكة كثيفة التفرع من جنوب غرب الولايات المتحدة ذات أزهار صفراء مبهرجة ولحاء أزرق مخضر؛ تصنف أحياناً في جنس سيرسيديوم)",
 "parkinsonism": "الشلل الرعاش, داء باركنسون (اضطراب تنكسي في الجهاز العصبي المركزي يتميز بالرعاش وضعف التنسيق العضلي)",
 "parkland": "متنزه بري, محمية طبيعية (مساحة كبيرة من الأرض يتم الحفاظ عليها في حالتها الطبيعية كملكية عامة)\nمثال: توجد قوانين تحمي الحياة البرية في هذه المحمية",
 "parkour": "وَثَابَة",
 "parkway": "طريق مشجر (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من ٱلشَّارِعِ، سَبِيل)\nمثال: أسأل عن الطريق.",
 "parky": "بَارِد نَوْعًا مَا (بارد بشكل ملحوظ أو مُزعج)",
 "parlance": "اصطلاح, لغة (طريقة تحدث طبيعية للمتحدثين الأصليين للغة)",
 "parlay": "رهان متراكم (سلسلة من الرهانات تُستخدم فيها الأرباح من رهان واحد كحصة للرهانات اللاحقة)",
 "parley": "مفاوضة, مهادنة (تفاوض بين الأعداء)",
 "parliament": "مَجْلِس, بَرْلَمَان",
 "parliamentarian": "بَرْلَمَانِيّ, بَرْلَمَانِيَّة",
 "parliamentary": "بَرْلَمَانِيّ",
 "parliamentary agent": "وكيل برلماني (شخص يُوظف لرعاية شؤون الشركات التي تتأثر بتشريعات البرلمان البريطاني)",
 "parliamentary democracy": "ديمقراطية برلمانية (ديمقراطية لديها برلمان)",
 "parliamentary law": "إِجْرَاءَات بَرْلَمَانِيَّة, قَوَاعِد النِّظَام (مجموعة من القواعد تتبعها جمعية أو هيئة تشريعية)",
 "parliamentary monarchy": "ملكية برلمانية (ملكية لديها برلمان)",
 "parliamentary procedure": "إِجْرَاءَات بَرْلَمَانِيَّة, قَوَاعِد النِّظَام (مجموعة من القواعد تتبعها جمعية أو هيئة تشريعية)",
 "parliamentary-cabinet system": "نظام برلماني وزاري (نظام سياسي يقرر فيه مجلس الوزراء بشكل جماعي اتجاه الحكومة، خاصة فيما يتعلق بالتشريعات التي يمررها البرلمان)",
 "parlor": "صالون, غرفة جلوس (غرفة في منزل خاص أو منشأة حيث يمكن للناس الجلوس والتحدث والاسترخاء) / ردهة, غرفة جلوس (غرفة استقبال في نزل أو نادٍ حيث يمكن استقبال الزوار)",
 "parlor car": "عربة صالون (عربة ركاب للسفر النهاري؛ تدفع أجرة إضافية للكراسي الفردية)",
 "parlor game": "لعبة صالون (لعبة مناسبة للعب في الصالون)",
 "parlor grand": "بيانو بيبي جراند, بيانو كبير صغير",
 "parlor grand piano": "بيانو بيبي جراند, بيانو كبير صغير",
 "parlormaid": "خادمة استقبال (خادمة في منزل خاص واجباتها العناية بغرفة الاستقبال والمائدة وفتح الباب)",
 "parlour": "صالون, غرفة جلوس (غرفة في منزل خاص أو منشأة حيث يمكن للناس الجلوس والتحدث والاسترخاء) / ردهة, غرفة جلوس (غرفة استقبال في نزل أو نادٍ حيث يمكن استقبال الزوار)",
 "parlour car": "عربة صالون (عربة ركاب للسفر النهاري؛ تدفع أجرة إضافية للكراسي الفردية)",
 "parlour game": "لعبة صالون (لعبة مناسبة للعب في الصالون)",
 "parlour grand": "بيانو بيبي جراند, بيانو كبير صغير",
 "parlour grand piano": "بيانو بيبي جراند, بيانو كبير صغير",
 "parlourmaid": "خادمة استقبال (خادمة في منزل خاص واجباتها العناية بغرفة الاستقبال والمائدة وفتح الباب)",
 "parlous": "مَحْفُوفٌ بِالخَطَر, وَخِيم (مليء بالأخطار والمهالك)",
 "parmesan": "بَارْمِيجْيَانُو, بَارْمِيزَان",
 "parnassia": "بارناسيا, عشب بارناسوس (أي من نباتات المستنقعات دائمة الخضرة عادة من جنس بارناسيا لها أوراق قاعدية ناعمة عريضة وزهرة شاحبة واحدة تشبه الحوذان)",
 "parnassia fimbriata": "عشب بارناسوس المهدب (نبات مستنقعات بأوراق قاعدية عريضة على شكل قلب وأزهار قشدية اللون أو بيضاء على شكل صحن ببتلات مهدبة؛ غرب جبال الروكي من ألاسكا إلى نيو مكسيكو)",
 "parnassia palustris": "بارناسية سبخية, نجمة المستنقع (نبات ذو أوراق بيضاوية في وردية قاعدية وزهور بيضاء تشبه النجوم معرقة باللون الأخضر)",
 "parnassianism": "البارناسية (نظريات وممارسات مدرسة من الشعراء الفرنسيين في القرن التاسع عشر، وخاصة التأكيد على الفن من أجل الفن، والقياس الدقيق، وقمع العناصر العاطفية)\nمثال: في أوائل ثمانينيات القرن التاسع عشر، شرع في مهنة أدبية في باريس، رافضاً بنفس الشدة طبيعية إميل زولا وبارناسية ليكونت دي ليزل",
 "parochetus communis": "باروشيتوس, بازلاء النفل (عشب آسيوي وأفريقي زاحف ثلاثي الأوراق له أزهار زرقاء كوبالتية)",
 "parochial": "ضَيِّقُ الأُفُقِ, مَحَلِّيّ (محدود النظرة والأفق بشكل ضيق) / أبرشي, رعوي (متعلق بالرعية (وحدة كنسية محلية) أو مدعوم منها أو يقع فيها)\nمثال: مدارس رعوية",
 "parochial school": "مدرسة أبرشية, مدرسة كنسية (مدرسة دينية خاصة تديرها كنيسة أو أبرشية)",
 "parochialism": "ضيق أفق محلي, قروية (محدودية في وجهات النظر أو المصالح تشبه تلك الموجودة في المجتمعات المحلية الضيقة)",
 "parochially": "بضيق أفق, بمحلية ضيقة (بطريقة ضيقة الأفق)\nمثال: ضيق الأفق بمحلية في نظرته",
 "parodist": "محاكي ساخر, مقلد ساخر (شخص يقلد الأسلوب الأدبي أو الموسيقي بغرض التأثير الكوميدي الساخر)",
 "parody": "مُحَاكَاة سَاخِرَة (تقليد أو محاولة إعادة عملية أو نظام موجود في الواقع بطريقة اصطناعية أو نموذجية)\nمثال: ويتم الآن طرح التساؤل التالي: هل يفهم الذكاء الصناعي اللغة الصينية حقيقة أم أنه يتم فقط محاكاة هذه المقدرة.",
 "paroicous": "مُتَجَاوِرُ المَسْكَن (أَعْضَاءُ التَّكَاثُرِ الذَّكَرِيَّةُ وَالأُنْثَوِيَّةُ مُنْفَصِلَةٌ فِي نَفْسِ العُضْوِ التَّنَاسُلِيّ)",
 "parol evidence rule": "قَاعِدَة الْأَدِلَّة الشَّفَوِيَّة (قاعدة تنص على أنه لا يمكن استخدام الأدلة الشفوية لمناقضة شروط عقد مكتوب)",
 "parole": "إفراج مشروط ((قانون) إفراج مشروط عن السجن يخول الشخص قضاء ما تبقى من العقوبة خارج السجن طالما تم الالتزام بشروط الإفراج) / كلمة سر, كلمة مرور (كلمة أو عبارة سرية لا يعرفها إلا مجموعة محددة) / كلمة شرف, وعد\nمثال: نسي كلمة السر (الكلِمَةُ : اللفظةُ الدَّالةُ على معنًى مُفْرَد بالوضع، وتكون؛ الكلِمَةُ: الكلامُ المؤلَّفُ المطوَّل، قصيدةً، أَو خُطْبَةً، أَو مقالةً، أَو رسالة)\nمثال: كلمة السر طويلة.",
 "parolee": "مطلق سراحه بشروط (شخص أُطلق سراحه تحت المراقبة أو بكفالة)",
 "paronomasia": "تَلَاعُب لَفْظِيّ, تَوْرِيَة (تلاعب فكاهي بالكلمات)\nمثال: أفعل ذلك من أجل التلاعب اللفظي",
 "paronychia": "التهاب حول الظفر, داحس (عدوى في الأنسجة المجاورة للظفر في إصبع اليد أو القدم)",
 "paronym": "كلمة مجانسة, لفظ مجانس (كلمة تشبه كلمة أخرى بشدة في الكتابة)",
 "parophrys vetulus": "سمك موسى الإنجليزي (سمكة مفلطحة شائعة ذات لون بني شاحب من ساحل المحيط الهادئ لأمريكا الشمالية)",
 "parophrys vitulus": "سمك موسى الإنجليزي (سمكة مفلطحة شائعة ذات لون بني شاحب من ساحل المحيط الهادئ لأمريكا الشمالية)",
 "paroquet": "ببغاء صغير, براكيت (أي من الببغاوات الصغيرة النحيلة طويلة الذيل العديدة)",
 "parosmia": "خطل شمي (يُعبّر عن حالة من الخلل أو الاضطراب في جوانب متعددة من الحياة؛ يُشير إلى خللٍ أو اضطرابٍ في كلام أو رأي أو حركة أو سلوك)",
 "parotid": "نكفي (متعلق بـ أو يقع بالقرب من الغدة النكفية)",
 "parotid gland": "غدة نكفية (غدة لعابية كبيرة تنتج 50% من اللعاب أثناء النهار؛ توجد في البشر أمام وأسفل كل أذن)",
 "parotid vein": "وريد نكفي (فروع نكفية للوريد الوجهي؛ تصرف جزءاً من الغدة النكفية وتصب في الوريد خلف الفك السفلي)",
 "parotitis": "التهاب الغدة النكفية (التهاب إحدى الغدد النكفية أو كلتيهما)",
 "parous": "سبق لها الولادة, ولود (التي أنجبت طفلاً واحداً أو أكثر قابلاً للحياة)",
 "paroxetine": "باروكستين, باكسيل (مثبط استرداد السيروتونين الانتقائي يوصف عادة كمضاد للاكتئاب (الاسم التجاري باكسيل))",
 "paroxysm": "نَوْبَة",
 "paroxysmal": "انتيابي, نوبي (مصحوب بـ أو ذو طبيعة نوبات مفاجئة (انتياب))",
 "paroxysmal trepidant abasia": "عدم القدرة على المشي التشنجي المتقطع (عدم القدرة على المشي المرتبط بتشنج الساقين)",
 "paroxytone": "كلمة منبورة ما قبل الآخر (كلمة يكون فيها النبر أو الشدة على المقطع قبل الأخير)",
 "parquet": "بَاركِيه, مَقَاعِد أَرْضِيَّة (الجلوس في الطابق الرئيسي بين الأوركسترا والدائرة الأرضية) / أرضية باركيه (أرضية مصنوعة من الخشب المزخرف (الباركيه))",
 "parquet circle": "مَقَاعِد خَلْفِيَّة أَرْضِيَّة (الجلوس في الجزء الخلفي من الطابق الرئيسي (تحت الشرفات))",
 "parquet floor": "أرضية باركيه (أرضية مصنوعة من الخشب المزخرف (الباركيه))",
 "parqueterie": "أرضية خشبية مزخرفة, باركية (تطعيم خشبي منقوش يستخدم لتغطية الأرضية)",
 "parquetry": "أرضية خشبية مزخرفة, باركية (تطعيم خشبي منقوش يستخدم لتغطية الأرضية)",
 "parr": "سلمون صغير (صغار الأسماك المختلفة) / سلمون صغير (سلمون صغير يصل عمره إلى عامين)",
 "parrakeet": "ببغاء صغير, براكيت (أي من الببغاوات الصغيرة النحيلة طويلة الذيل العديدة)",
 "parricide": "قتل أحد الوالدين (قتل الشخص لأبيه أو أمه) / قاتل أحد الوالدين (شخص يقتل والده أو والدته)",
 "parroket": "ببغاء صغير, براكيت (أي من الببغاوات الصغيرة النحيلة طويلة الذيل العديدة)",
 "parroquet": "ببغاء صغير, براكيت (أي من الببغاوات الصغيرة النحيلة طويلة الذيل العديدة)",
 "parrot": "بَبَّغَاء (طائر من فصيلة كبيرة من الطيور ذوات ألوان زاهية قادرة على تقليد صوت كلام الإنسان دون القدرة على التواصل بالكلام)",
 "parrot disease": "حمى الببغاء, داء الببغائية (مرض معد يصيب الطيور)",
 "parrot fever": "حمى الببغاء, داء الببغائية (التهاب رئوي لانمطي يسببه كائن دقيق من الريكيتسيا وينتقل إلى البشر من الطيور المصابة)",
 "parrot's beak": "كليانثوس, منقار الببغاء (شجيرة دائمة الخضرة بزهور قرمزية إلى بيضاء تشبه المخلب أو المنقار؛ نيوزيلندا)",
 "parrot's bill": "كليانثوس, منقار الببغاء (شجيرة دائمة الخضرة بزهور قرمزية إلى بيضاء تشبه المخلب أو المنقار؛ نيوزيلندا)",
 "parrotfish": "سمكة الببغاء (أسماك استوائية زاهية ذات مناقير تشبه الببغاء ناتجة عن التحام الأسنان)",
 "parrotlike": "بَبَّغَائِيّ (يُقلَّد أو يُردَّد آليّاً بلا تفكير أو فهم)",
 "parry": "نَاكَفَ",
 "parry manzanita": "مانزانيتا باري (شجيرة تشبه الشجرة قائمة تشكل غابات كثيفة ولها عناقيد متدلية من الزهور البيضاء أو الوردية وثمار حمراء تشبه التوت؛ كاليفورنيا)",
 "parry's penstemon": "بنستيمون باري (سيقان منتصبة بأزهار وردية خزامية في عناقيد طويلة متقطعة؛ أريزونا)",
 "parry's pinyon": "بينيون باري",
 "pars anterior": "جزء قاصي (الجزء الأمامي من النخامية الأمامية)",
 "pars distilis": "جزء قاصي (الجزء الأمامي من النخامية الأمامية)",
 "pars intermedia": "جزء متوسط (قطعة رقيقة من الأنسجة أصبحت جزءاً من النخامية الخلفية)",
 "pars nervosa": "غدة نخامية خلفية, نخامية خلفية (الفص الخلفي للغدة النخامية؛ ذو طبيعة غدية في المقام الأول)",
 "parsec": "فرسخ, فرسخ فلكي",
 "parsee": "بارسي, فارسي (عضو في طائفة توحيدية من أصل زرادشتي؛ تنحدر من الفرس؛ وتوجد الآن في غرب الهند)",
 "parseeism": "بارسية (عقيدة طائفة زرادشتية في الهند)",
 "parser": "تجزئَة",
 "parsi": "بارسي, فارسي (عضو في طائفة توحيدية من أصل زرادشتي؛ تنحدر من الفرس؛ وتوجد الآن في غرب الهند)",
 "parsiism": "بارسية (عقيدة طائفة زرادشتية في الهند)",
 "parsimonious": "شَدِيد البُخْل, مُقَتِّر جِدًّا (شديد الامتناع عن الإنفاق بصورة مفرطة)",
 "parsimoniousness": "خسة, شح (بخل شديد) / بخل, تقتير (الحرص الشديد في إنفاق المال؛ التردد في إنفاق المال بلا ضرورة)",
 "parsimony": "خسة, شح (بخل شديد) / بخل, تقتير (الحرص الشديد في إنفاق المال؛ التردد في إنفاق المال بلا ضرورة)",
 "parsley": "مَقْدُونِس, بَقْدُونِس",
 "parsley haw": "زعرور البقدونس (زعرور من جنوب الولايات المتحدة بأوراق ريشية الفصوص)",
 "parsley root": "جذر البقدونس (خضار جذري شائع في مطبخ وسط وشرق أوروبا، حيث يستخدم في الحساء واليخنات، أو يؤكل نيئاً كوجبة خفيفة (مشابه للجزر))",
 "parsley-leaved thorn": "زعرور البقدونس (زعرور من جنوب الولايات المتحدة بأوراق ريشية الفصوص)",
 "parsnip": "جَزَر أَبْيَض (جَزَرَ الماءُ عن الأَرضِ يَجْزُرُ جَزْراً: نَضَبَ وحَسَرَ؛ ويقال: جَزَرَ البَحْرُ والنَّهْرُ: انْحسرَ ماؤُهُ)\nمثال: ضع الجزر في القدر.",
 "parson": "قِسِّيس (الذي يُقَسِّس الإبل أو الماشية أو الغنم، أي يحسن رعايتها، الراعي؛ عند المَسِيْحِيِّيْن هو لقب فوق الشَمَّاس ودون الأُسْقُف وهو القَسّ)",
 "parson's nose": "ذيل الطائر (ذيل الطائر المجهز للأكل)",
 "parsonage": "بيت القسيس, سكن الكاهن (مقر إقامة رسمي توفره الكنيسة لقسيسها أو كاهنها)",
 "parsons table": "طاولة بارسونز (طاولة مستطيلة متينة ذات أرجل كتلية في الزوايا الأربع؛ السطح والأرجل بنفس العرض)",
 "part": "جُزْء, جُزَء / دَوْر (جَعَله يَدُور؛ جَعَلَه مُدَوَّر) / اِفْتَرَقَ, تَفَارَقَ\nمثال: في أي دور تسكن؟",
 "part music": "موسيقى متعددة الأجزاء (موسيقى صوتية لعدة أصوات في أجزاء مستقلة (تؤدى عادة بدون مرافقة))",
 "part name": "اسم الجزء (كلمة تسمي جزءاً من كل أكبر)\nمثال: 'حافة' و 'تاج' هما اسما جزء لـ 'قبعة'",
 "part of speech": "جُزْء كَلَام, قَسْم كَلَام",
 "part time": "بدوام جزئي (ينطوي على وقت أقل من الوقت القياسي أو المعتاد لنشاط ما)\nمثال: موظفون بدوام جزئي",
 "part to whole relation": "عَلَاقَة الجُزْء بِالكُلّ (العلاقة الدلالية التي تربط بين الجزء والكل)",
 "part-of-speech tagger": "موسّم أقسام الكلام (برنامج توسيم تشير تسمياته إلى قسم الكلام الخاص بالكلمة)",
 "part-owner": "شريك في الملكية (شخص يمتلك شيئاً مشتركاً مع الآخرين)",
 "part-singing": "غناء متعدد الأصوات (الغناء بثلاثة أجزاء صوتية أو أكثر)",
 "part-time": "وَظِيفَة بِدَوَامٍ جُزْئِيّ, عَمَل جُزْئِيّ (ما يُقَدَّر من الشيء في زمن مُعَيَّن؛ مَنْصِب)\nمثال: ما وظيفة زوجتك؟",
 "part-timer": "عامل بدوام جزئي (شخص يعمل أقل من الوقت المعتاد أو القياسي)",
 "partaker": "شَرِيك",
 "partav": "بَرْذَعَة",
 "parted": "مَقْسُوم (ذو حافّة مُفرَّضة تكاد تصل إلى القاعدة مُشكِّلةً أقسامًا أو فُصوصًا واضحة)",
 "parted leaf": "ورقة مجزأة (ورقة ذات حواف محززة حتى القاعدة تقريبًا بحيث تخلق انقسامات أو فصوصًا متميزة)",
 "parterre": "مَقَاعِد خَلْفِيَّة أَرْضِيَّة (الجلوس في الجزء الخلفي من الطابق الرئيسي (تحت الشرفات)) / حديقة مزخرفة (حديقة زهور للزينة؛ تترتب فيها الأحواض والممرات لتشكل نمطاً معيناً)",
 "parthenium argentatum": "غوايولي (شجيرة كثيرة التفرع بأوراق فضية وزهور بيضاء صغيرة من تكساس وشمال المكسيك؛ تُزرع كمصدر للمطاط)",
 "parthenium hysterophorus": "أقحوان كاذب, بارثينيوم (عشب ضار حولي أمريكي استوائي برؤوس شعاعية صغيرة من الزهور البيضاء؛ وافد في جنوب الولايات المتحدة)",
 "parthenium integrifolium": "أقحوان الحمى الأمريكي, كينا برية (عشب معمر قوي من شرق الولايات المتحدة بزهور بيضاء؛ استخدم الهنود أوراقه تقليدياً لعلاج الحروق)",
 "parthenocarpy": "إثمار عذري ((علم النبات) تطور الثمرة دون إخصاب أو بذور)",
 "parthenocissus quinquefolia": "فرجينيا الزاحفة, لبلاب أمريكي (كرمة شائعة في أمريكا الشمالية بأوراق مركبة وثمار تشبه التوت الأسود المزرق)",
 "parthenocissus tricuspidata": "لبلاب بوسطن, لبلاب ياباني (كرمة آسيوية بأوراق ثلاثية الفصوص وثمار أرجوانية)",
 "parthenogenesis": "توالد عذري (عملية تتطور فيها البويضة غير المخصبة إلى فرد جديد؛ شائعة بين الحشرات وبعض المفصليات الأخرى) / توالد عذري, ولادة عذرية (حمل بشري دون إخصاب من قبل رجل)",
 "parthenogenetic": "تَوَالُدِيّ عَذْرِيّ, لَاجِنْسِيّ ((عن التكاثر) لا ينطوي على اندماج خلايا ذكرية وأنثوية)",
 "parthenogeny": "توالد عذري (عملية تتطور فيها البويضة غير المخصبة إلى فرد جديد؛ شائعة بين الحشرات وبعض المفصليات الأخرى) / توالد عذري, ولادة عذرية (حمل بشري دون إخصاب من قبل رجل)",
 "parthenon": "بارثينون",
 "parthenote": "كائن التوالد العذري (خلية ناتجة عن التوالد العذري)",
 "parthia": "فَرْثِيَا",
 "parthian": "فَرْثِيّ",
 "parthian empire": "الْإِمْبَرَاطُورِيَّةُ الْفَرْثِيَّة, الْإِمْبَرَاطُورِيَّةُ الْأَرْشَكِيَّة",
 "parthian language": "البارثية (اللغة الإيرانية التي كان يتم التحدث بها في المملكة البارثية (250 قبل الميلاد إلى 226 بعد الميلاد))",
 "parti pris": "حكم مسبق, فكرة مسبقة (رأي تم تشكيله مسبقاً دون أدلة كافية)\nمثال: لم يحاول حتى التأكد من أفكاره المسبقة",
 "partial": "جُزْئِيّ",
 "partial abortion": "إجهاض غير كامل (إنهاء الحمل دون طرد جميع نواتج الحمل)",
 "partial breach": "إخلال جزئي (خرق لا يدمر قيمة العقد ولكن يمكن أن يؤدي إلى مطالبة بالتعويض عن الأضرار)",
 "partial correlation": "ارتباط جزئي (ارتباط بين متغيرين عندما يتم إزالة تأثيرات متغير واحد أو أكثر من المتغيرات ذات الصلة)",
 "partial denture": "طقم أسنان جزئي (طقم أسنان يحل محل سن واحد أو أكثر في قوس الأسنان)",
 "partial derivative": "مشتقة جزئية (مشتق دالة لمتغيرين أو أكثر بالنسبة لمتغير واحد بينما تعتبر المتغيرات الأخرى ثابتة)",
 "partial differential equation": "معادلة تفاضلية جزئية (معادلة تفاضلية تتضمن دوال لأكثر من متغير واحد)",
 "partial eclipse": "كسوف جزئي (كسوف يُحجب فيه الجرم السماوي جزئياً فقط)",
 "partial fraction": "كَسْرٌ جُزْئِيٌّ",
 "partial tone": "نغمة تابعة, نغمة فوقية (نغمة توافقية ذات تردد يمثل مضاعفاً للتردد الأساسي)",
 "partial veil": "حجاب جزئي (غشاء لحامل الأبواغ الصغير لفطريات مختلفة يمتد من حافة الغطاء إلى الساق ويتمزق بالنمو؛ يظهر في الفطر الناضج كحلقة حول الساق وأحياناً كستارة على حافة…)",
 "partial verdict": "حكم جزئي ((قانون جنائي) نتيجة بأن المدعى عليه مذنب في بعض التهم ولكنه بريء من أخرى)",
 "partiality": "اِنْحِيَاز",
 "partially": "بشكل جزئي, جزئياً (إلى حد ما؛ بدرجة معينة؛ ليس كلياً)\nمثال: شعرت باللوم جزئياً",
 "partially ordered set": "فِئَةٌ مُرَتَّبَةٌ جُزْئِيًّا (هي الجماعة المُتَظَاهِرَة التي يرجع بعضها إلى بعض في التعاضد؛ هي الطائفة المقيمة وراء الجيش للاتجاء إليهم عند الهزيمة) / مَجْمُوعَةٌ مُرَتَّبَةٌ جُزْئِيًّا (مؤنث مَجْمُوع وهو اسم مفعول من جَمَعَ؛ الطَائِفَة أو الجَمَاعَة من الناس)\nمثال: سأقدم طلبي في إطار فئة أخرى.",
 "partially-recognized state": "دولة غير معترف بها, دولة محدودة الاعتراف (إقليم يتمتع بسيادة فعلية ولكنه يفتقر إلى الاعتراف الدولي)",
 "partialness": "جزئية, عدم اكتمال (حالة كونه جزءاً فقط؛ ليس كلياً؛ غير كامل)",
 "partible": "قَابِل لِلتَّقْسِيم ((عَنِ المُمْتَلَكَات مَثَلًا) يُمْكِن تَقْسِيمُه أَوْ تَجْزِئَتُه)",
 "participant": "مُشَارِك / مُشَارِكَة",
 "participant role": "دور دلالي ((لغويات) العلاقة الأساسية التي يمتلكها مكون مع الفعل الرئيسي في الجملة)",
 "participate": "شَارَكَ, سَاهَمَ",
 "participating": "مُشَارِك, نَشِط (يَأْخُذُ دَوْرًا فَاعِلًا فِي نَشَاطٍ مَا)",
 "participation": "مُسَاهَمَة, اِشْتِرَاك (المُساهَمَة : المُشاركة والاشتراك في الشيء)\nمثال: ويستطيع الجميع المساهمة.",
 "participation financing": "تمويل بالمشاركة, قرض مشترك (قرض تشترك فيه مجموعة من المصارف لتقديم مبلغ كبير جداً لا يستطيع أي منها تقديمه منفرداً)",
 "participation loan": "تمويل بالمشاركة, قرض مشترك (قرض تشترك فيه مجموعة من المصارف لتقديم مبلغ كبير جداً لا يستطيع أي منها تقديمه منفرداً)",
 "participatory": "تَشَارُكِيّ (يُتِيحُ فُرْصَةَ المُشَارَكَةِ الفَرْدِيَّة)",
 "participial": "اسم فاعلي, وصفي (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر) / اسم الفاعل أو المفعول, الصيغة الوصفية للفعل (شكل غير محدود من الفعل؛ يُستخدم في الإنجليزية كصفة ولتكوين الأزمنة المركبة)\nمثال: تصريفات اسم الفاعل\nمثال: ما اسم حصان توم؟",
 "participle": "اِسْم فَاعِل, اِسْم مَفْعُول (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)\nمثال: ما اسم حصان توم؟",
 "particle": "جُسَيْم, ذَرَّة (في الفيزياء: الجُسيْمات التحت ذريّة، أي الجُسيْمات الأوليّة والمركّبة (معنى مستحدث)) / جُسَيْم (في الفيزياء: الجُسيْمات التحت ذريّة، أي الجُسيْمات الأوليّة والمركّبة (معنى مستحدث))\nمثال: نحن نعيش بعض اللحظات الحزينة حقا لأن بلادنا عانت من خسارة جسيمة. وسوف يستغرق وقتا طويلا قبل أن تعود إلى مجدها السابق.",
 "particle accelerator": "مُعَجِّل جُسَيْمَات",
 "particle beam": "حزمة جسيمات (تدفق موازى لجسيمات (ذرات أو إلكترونات أو جزيئات))",
 "particle board": "فايبر بورد, لوح حبيبي (لوح جداري يتكون من رقائق الخشب أو النشارة المترابطة مع الراتنج والمضغوطة في أوراق صلبة)",
 "particle detector": "كاشف الجسيمات (حجرة يمكن فيها جعل الجسيمات مرئية)",
