 "outsider art": "فن الدخلاء, فن الفطرة (نوع من الفن والإنشاءات الخارجية صنعها فنانون غير مدربين لا يعتبرون أنفسهم فنانين)",
 "outsize": "أَكْبَر مِن المُعْتَاد, مُفْرِط الحَجْم (أكبر من الحجم الطبيعي لنوعه) / حجم ضخم, مقاس استثنائي (مقاس ملابس غير عادي (خاصة المقاس الكبير جداً))",
 "outsized": "أَكْبَر مِن المُعْتَاد, مُفْرِط الحَجْم (أكبر من الحجم الطبيعي لنوعه)",
 "outskirt": "ضَاحِيَة, مَشَارِف",
 "outskirts": "أطراف, ضواحي (المناطق الخارجية (كما في مدينة أو بلدة))\nمثال: عاشوا في ضواحي هيوستن",
 "outsole": "نعل خارجي (النعل الخارجي للحذاء الذي يمثل الجزء السفلي من الحذاء ويلامس الأرض)",
 "outspoken": "جَرِيء, صَدَّاح (يُعبّر عن رأيه بحرّيّة وإصرار) / صَرِيح, فَصِيح (يَتَّسِم بِالمُبَاشَرَة فِي الأُسْلُوب أَوِ الكَلَام؛ بِدُون مُوَارَبَة أَوْ تَهَرُّب)",
 "outspokenly": "بجهر, بصراحة تامة (بطريقة صريحة)\nمثال: كان ناقداً بصراحة تامة للسياسة الاجتماعية الجديدة للحكومة",
 "outspokenness": "صراحة (سمة كون المرء صريحاً ومباشراً)",
 "outspread": "مَنْشُور, مُمْتَدّ (مَبْسوط بِالكامِل في العَرْض)",
 "outstanding": "لَافِت, مُلْفِتٌ لِلنَّظَرِ (لَهُ صِفَةٌ تَفْرِضُ نَفْسَهَا عَلَى الِانْتِبَاهِ) / بَارِز, عَظِيم (ذو أهمّيّة أو دلالة كُبرى) / غَيْرُ مُسَدَّد, مُسْتَحَقّ (مُسْتَحَقٌّ كَدَيْن) / بَارِع, مُتَمَيِّز (يتميز عن غيره بالتفوق)",
 "outstandingly": "بامتياز, بشكل بارز (بطريقة بارزة أو إلى درجة بارزة)\nمثال: كانت ناجحة بشكل بارز في مهنتها",
 "outstation": "مخفر أمامي, نقطة نائية (محطة في موقع ناء أو قليل السكان)",
 "outstretched": "مَمْدُود (مَبْسوط بِالكامِل خاصَّةً في الطُّول)",
 "outstroke": "شوط خارجي (شوط مكبس المحرك يتحرك نحو العمود المرفقي)",
 "outtake": "لقطة محذوفة (مشهد تم تصويره ولكنه لم يُستخدم في المونتاج النهائي للفيلم)",
 "outthrust": "نُتُوء صَخْرِيّ (منكشف صخري يمتد للخارج)",
 "outturn": "إنتاج, مخرجات (ما يتم إنتاجه في فترة زمنية معينة)",
 "outward": "إِلَى الخَارِج (نحو الخارج) / ظاهري, مادي (يتعلق بالواقع المادي بدلاً من الأفكار أو العقل) / مُتَّجِه إِلَى الخَارِج, مُغَادِر (ذاهب أو مُتّجه إلى الخارج أو مُغادر)\nمثال: حرك الإبرة أكثر للخارج!",
 "outward-bound": "مُتَّجِه إِلَى الخَارِج, مُغَادِر (ذاهب أو مُتّجه إلى الخارج أو مُغادر)",
 "outward-developing": "نَابِذ المَرْكَز نُمُوًّا (ينمو مبتعدًا عن المحور، كما في عنقود زهريّ تكون أقدم الأزهار في المركز)",
 "outward-moving": "مُتَحَرِّك نَحْوَ الخَارِج (يتحرّك أو يتّجه بعيدًا عن المركز، خاصّة عند الدوران)",
 "outwardly": "ظَاهِرِيًّا, مِن الخَارِج (في المظهر الخارجي) / خَارِجِيًّا (فيما يتعلق بالخارج)\nمثال: ظاهرياً، بدت هادئة",
 "outwardness": "اهتمام بالخارج, ظاهرية (الاهتمام أو التجاوب مع الأشياء الخارجية (خاصة الأشياء المادية مقابل المفاهيم المثالية)) / خَارِجِيَّة, ظَاهِرِيَّة (صفة أو حالة الوجود في الخارج أو التوجه نحو الخارج أو التعلق به) / خارجية, ظاهرية (الاهتمام بالأشياء الخارجية أو المادية بدلاً من العقل والروح)\nمثال: استعراض ودي واهتمام شامل بالخارج",
 "outwards": "إِلَى الخَارِج (نحو الخارج)\nمثال: حرك الإبرة أكثر للخارج!",
 "outweigh": "ثَقَلَ (ثَقَلَ الشيءَ يَثْقُلُه بِيَدِهِ ثَقْلًا: رَازَ ثِقَلَه؛ ثَقَلَ الشَّيْء بِيَدِهِ ثقلا قدّر ثِقْلَه)\nمثال: ان ثقل ما تحمل، فضع بعضا منه.",
 "outwith": "خَارِج",
 "outwork": "تحصين خارجي (هيكل دفاعي فرعي يقع خارج المنطقة المحصنة الرئيسية)\nمثال: التحصينات الخارجية للقلعة",
 "ouzel": "شحرور (سمنة أوروبية سوداء شائعة)",
 "ouzo": "أوزو (مشروب يوناني منكه باليانسون)",
 "oval": "إِهْلِيلَج / إِهْلِيلَجِيّ, بَيْضَوِيّ",
 "oval kumquat": "كمكوات بيضاوي, ناغامي (شجيرة تحمل كمكوات بيضاوي الثمار)",
 "oval office": "الْمَكْتَب الْبَيْضَاوِيّ",
 "oval window": "نافذة بيضوية (نافذة تتصل بها قاعدة الركاب)",
 "oval-bodied": "بَيْضَاوِيُّ الجَسَد (لَهُ جَسَدٌ بَيْضَاوِيُّ الشَّكْل)",
 "oval-fruited": "ذُو ثِمَار بَيْضَاوِيَّة (يَحْمِلُ ثِمَارًا بَيْضَاوِيَّة الشَّكْل)",
 "oval-shaped": "إِهْلِيلَجِيّ, بَيْضَوِيّ (مستدير كالبيضة؛ ذو شكل بيضاوي)",
 "ovalbumin": "بياض البيض, زلال (الجزء الأبيض من البيضة؛ المادة الهلامية المغذية والواقية المحيطة بالصفار وتتكون أساساً من الألبومين المذاب في الماء)",
 "ovalipes ocellatus": "سلطعون السيدة الأمريكي (سلطعون مرقط بزهو يعيش في الشواطئ الرملية لساحل المحيط الأطلسي للولايات المتحدة)",
 "ovarian": "مبيضي (من أو يتعلق بالمبيضين)\nمثال: سرطان المبيض",
 "ovarian artery": "شريان مبيضي (الشريان الذي يتفرع من الأبهر ويغذي المبيضين بالدم)",
 "ovarian cyst": "كيس المبيض (ورم كيسي (حميد عادة) في المبيض)",
 "ovarian pregnancy": "حمل مبيضي (حمل خارج الرحم في المبيض)",
 "ovarian vein": "وريد مبيضي (واحد من الأوردة التي تصرف المبيضين؛ الأيمن يصب في الوريد الأجوف السفلي؛ والأيسر يصب في الوريد الكلوي الأيسر)",
 "ovariectomy": "استئصال المبيض (إزالة جراحية لمبيض واحد أو كليهما)",
 "ovaritis": "التهاب المبيض (التهاب المبايض)",
 "ovary": "مِبْيَض, مَبِيض",
 "ovate": "إِهْلِيلَجِيّ, بَيْضَوِيّ (مستدير كالبيضة؛ ذو شكل بيضاوي) / بَيْضَوِيّ ((عن شكل الورقة) بيضاويّ مع الطرف الأعرض عند القاعدة)",
 "ovate leaf": "ورقة بيضاوية (ورقة على شكل بيضة نهايتها الأعرض عند القاعدة)",
 "ovation": "تصفيق حار, حفاوة بالغة (تقدير حماسي (خاصة ذلك المصحوب بتصفيق عالٍ))",
 "oven": "فُرْن, تَنُّور",
 "oven stuffer": "دجاج أوفن ستافر, دجاج الحشو (اسم تجاري لدجاج التحمير)",
 "oven stuffer roaster": "دجاج أوفن ستافر, دجاج الحشو (اسم تجاري لدجاج التحمير)",
 "oven thermometer": "مقياس حرارة الفرن (مقياس حرارة يسجل درجة الحرارة داخل الفرن)",
 "oven-ready": "جَاهِز لِلطَّبْخ (مُعَدّ قبل البيع وجاهز للطهي)",
 "oven-shaped": "فُرْنِيّ الشَّكْل (على شكل فُرن)",
 "ovenbird": "طائر الفران",
 "ovenware": "أواني الفرن (أواني أطباق مقاومة للحرارة يمكن طهي الطعام فيها وكذلك تقديمه)",
 "over": "فَوْقَ / عَلَى (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال.",
 "over again": "ثانية, مجدداً\nمثال: حاولت مرة أخرى (وحدة زمنية تعادل جزءًا من ستين جزءًا من الدقيقة)\nمثال: لن أفعلها ثانية.",
 "over and above": "عِلَاوَةً عَلَى ذٰلِكَ, زِيَادَةً عَلَى ذٰلِكَ / أَكْثَر مِمَّا يَنْبَغِي",
 "over and over": "مراراً وتكراراً (بشكل متكرر)\nمثال: ظهرت الكلمة غير المعروفة مراراً وتكراراً",
 "over and over again": "مراراً وتكراراً (بشكل متكرر)\nمثال: ظهرت الكلمة غير المعروفة مراراً وتكراراً",
 "over here": "هُنَا (في منطقة أو مكان محدد)\nمثال: لا يجب أن تكون هنا",
 "over the counter security": "ورقة مالية خارج المقصورة, ورقة مالية غير مدرجة (ورقة مالية يتم تداولها في السوق خارج المقصورة)",
 "over the counter stock": "سهم خارج المقصورة, سهم غير مدرج (سهم غير مدرج ومتداول في بورصة منظمة)",
 "over there": "هُنَاك, هُنَالِك",
 "over-burned lime": "جير محروق بشدة (جير تم حرقه فوق 1100 درجة مئوية، مما يفقده تفاعليته، ويؤدي إلى ضعف أو انعدام قوة الترابط)",
 "over-crowding": "احتقان, اكتظاظ مفرط (الاكتظاظ المفرط)\nمثال: احتقان مروري",
 "over-embellished": "مُبَالَغٌ فِي تَزْيِينِه, مُتَكَلَّف (مُبالَغ فيه بشكل مفرط أو مُعبَّر عنه بتصنُّع)",
 "over-the-counter": "خَارِج البُورْصَة ((في الأوراق المالية) لا يُتَداوَل في سوق الأَوْراق المالِيَّة الرَّسْمِيّ)",
 "over-the-counter derivative": "مشتقات خارج المقصورة, مشتقات غير مدرجة (عقود يتم تداولها (والتفاوض عليها بشكل خاص) مباشرة بين طرفين، دون المرور عبر بورصة أو وسيط آخر)\nمثال: سوق المشتقات خارج المقصورة هو أكبر سوق للمشتقات",
 "over-the-counter drug": "دواء بدون وصفة طبية, دواء لا يستلزم وصفة طبية (دواء يباع بدون وصفة طبية)",
 "over-the-counter market": "سوق التداول المباشر, سوق خارج البورصة (بورصة أسهم تتم فيها معاملات الأوراق المالية عبر الهاتف والكمبيوتر بدلاً من قاعة البورصة)",
 "over-the-counter medicine": "دواء بدون وصفة طبية, دواء لا يستلزم وصفة طبية (دواء يباع بدون وصفة طبية)",
 "over-the-hill": "عَفَا عَلَيْه الزَّمَن, مُتَجَاوِز السِّنّ (تجاوز السنّ المناسبة بحيث لم يعد صالحاً للعمل)",
 "over-the-shoulder bombing": "قصف خلفي (حالة خاصة من القصف القذفي يتم فيها إطلاق القنبلة بعد الوضع الرأسي بحيث تُقذف للخلف نحو الهدف)",
 "over-the-top": "اسْتِثْنَائِيّ, خَارِقٌ لِلْعَادَة (يَفُوقُ المُعْتَادَ أَوِ المُتَوَقَّعَ بِكَثِير)",
 "overabundance": "إفراط, فرط (كمية تزيد عما هو مناسب) / إفراط, تخمة (حالة الامتلاء بأكثر من اللازم)\nمثال: الأطفال في سن الرابعة لديهم فرط في الطاقة",
 "overabundant": "مُفْرِط الوَفْرَة (وافر بشكل مفرط)",
 "overachievement": "أداء فائق, تفوق غير متوقع (أداء أفضل من المتوقع (أفضل مما كان يمكن التنبؤ به من اختبارات الذكاء))",
 "overachiever": "طالب متفوق (طالب يحقق معايير أعلى مما يشير إليه معدل ذكائه)",
 "overacting": "مبالغة في التمثيل (تمثيل رديء من قبل ممثل مبالغ)",
 "overactive": "مُفْرِط النَّشَاط (أكثر نشاطًا من المعتاد)",
 "overactivity": "فرط النشاط (نشاط مفرط)\nمثال: فرط نشاط الغدد الدهنية يجعل الجلد دهنيًا",
 "overage": "عَفَا عَلَيْه الزَّمَن, مُتَجَاوِز السِّنّ (تجاوز السنّ المناسبة بحيث لم يعد صالحاً للعمل) / زيادة, فائض (فائض أو زيادة في المال أو البضائع الموجودة فعلياً والتي تتجاوز التوقعات)",
 "overaged": "عَفَا عَلَيْه الزَّمَن, مُتَجَاوِز السِّنّ (تجاوز السنّ المناسبة بحيث لم يعد صالحاً للعمل)",
 "overall": "إِجْمَالِيّ, شَامِل (يتناول السمات الرئيسية فقط) / إِجْمَالِيّ, شَامِل (يشمل كل شيء بلا استثناء) / أفرول, سروال عمل ((عادة جمع) ملابس عمل تتكون من سراويل دنيم (عادة بمريلة وحمالات كتف)) / أفرول, بدلة عمل (رداء واقٍ فضفاض أو مريول يرتدى فوق الملابس العادية للعمل المتسخ)",
 "overambitious": "مُفْرِط الطُّمُوح (طموح بشكل مفرط يتجاوز الحد المعقول)",
 "overanxiety": "فرط القلق, قلق مفرط (قلق زائد عن الحد)",
 "overanxious": "مُفْرِط فِي القَلَق (قلق أو متوتر إلى حدّ مفرط)",
 "overappraisal": "تقدير مبالغ فيه, مغالاة في التثمين (تقييم مرتفع للغاية)",
 "overarm": "من فوق الذراع (مع تقديم اليد وخفضها من فوق مستوى الكتف)\nمثال: رمية من فوق الذراع",
 "overawed": "مَرْهُوب, مُرْتَاع (غلبه شعور بالرهبة والهيبة)",
 "overbearing": "مُتَسَلِّط",
 "overbearingly": "بتجبر, بصلف (بطريقة متجبرة)",
 "overbearingness": "تجبر, تسلط (سمة التسلط والغطرسة)",
 "overbid": "مزايدة أعلى ((في لعبة البريدج) عطاء أعلى من عطاء خصمك (خاصة عندما لم يقم شريكك بالمزايدة على الإطلاق وتجاوز عطاءك قيمة يدك)) / مُزَايَدَة أَعْلَى (عطاء أعلى من العطاءات السابقة)",
 "overbite": "بروز الفك العلوي, تراكب العضة ((طب الأسنان) سوء إطباق تمتد فيه الأسنان العلوية بشكل غير طبيعي فوق الأسنان السفلية)",
 "overblown": "ذَابِل, مُتَجَاوِزٌ لِلنُّضْج (تجاوز مرحلة الإزهار الكامل) / طَنَّان, مُتَنَطِّع (متورّم بالغرور والتباهي الفارغ)",
 "overboard": "خارج السفينة, في البحر (من على متن سفينة إلى الماء) / بشكل مفرط, في مبالغة (إلى أقصى الحدود)\nمثال: ألقوا قمامتهم في البحر",
 "overbold": "سَلِيط, صَفِيق (جريء ومتطاول بشكل غير لائق)",
 "overburden": "حمل زائد (عبء مفرط) / طبقة سطحية, غطاء ترابي (التربة السطحية التي يجب إزالتها للوصول إلى طبقات الفحم والرواسب المعدنية)",
 "overburdened": "مُثْقَلٌ بِالأَعْبَاء, مُنْهَك (مُثقَل بشدّة بالعمل أو الهموم)",
 "overburned lime": "جير محروق بشدة (جير تم حرقه فوق 1100 درجة مئوية، مما يفقده تفاعليته، ويؤدي إلى ضعف أو انعدام قوة الترابط)",
 "overbusy": "مُفْرِط الانْشِغَال (مَشْغُول أَكْثَر مِمَّا يَنْبَغِي)",
 "overcall": "مزايدة أعلى ((في لعبة البريدج) عطاء أعلى من عطاء خصمك (خاصة عندما لم يقم شريكك بالمزايدة على الإطلاق وتجاوز عطاءك قيمة يدك))",
 "overcapitalisation": "فرط الرسملة ((أعمال) رسملة مفرطة (بيع أسهم أكثر مما تضمنه الأعمال))",
 "overcapitalization": "فرط الرسملة ((أعمال) رسملة مفرطة (بيع أسهم أكثر مما تضمنه الأعمال))",
 "overcareful": "مُفْرِط الحَذَر (حَذِر بِشَكْلٍ مُبَالَغ فِيه أَوْ زَائِد عَنِ الحَدّ)",
 "overcast": "رمية مفرطة (رمية تسقط أبعد من المكان المقصود) / مُكْفَهِرّ, مُلَبَّد بِالغُيُوم (ممتلئ أو مغطى بالغيوم) / حبكة, سرفلة (غرزة ملفقة طويلة أو غرزة علوية تغطي الحافة لمنع التنسيل) / تلبد الغيوم, غائم (شبه ظلام كئيب ناتج عن غطاء سحابي)",
 "overcasting": "حبكة, سرفلة (غرزة ملفقة طويلة أو غرزة علوية تغطي الحافة لمنع التنسيل)",
 "overcautious": "مُفْرِط فِي الحَذَر (حذر بلا داعٍ أو أكثر من اللازم)",
 "overcharge": "زيادة في السعر, سعر مبالغ فيه (سعر مرتفع جداً)",
 "overclothes": "ملابس خارجية (ملابس للاستخدام خارج المنزل)",
 "overcoat": "مِعْطَف",
 "overcoating": "طبقة علوية, طلاء إضافي (طلاء واقٍ إضافي (مثل الدهان أو الورنيش))",
 "overcome": "هَزَمَ, غَلَبَ",
 "overcomer": "خاضع, قاهر (شخص يتغلب ويؤسس للهيمنة والسيطرة بالقوة أو الإقناع)",
 "overcompensation": "تعويض مفرط (تعويض زائد عن الحد) / تعويض مفرط ((في الطب النفسي) محاولة للتغلب على عيب حقيقي أو متخيل أو سمة غير مرغوب فيها عن طريق المبالغة المفرطة في نقيضها)",
 "overconfidence": "ثقة مفرطة, يقين مطلق (اليقين التام أو اليقين الأكبر مما تبرره الظروف)",
 "overconfident": "مَغْرُور, مُفْرِط الثِّقَة (يتّسم بثقة مفرطة تتجاوز الحدّ المعقول)",
 "overcredulity": "سذاجة مفرطة (الإفراط في سرعة التصديق)",
 "overcredulous": "مُفْرِطٌ فِي السَّذَاجَةِ (مُفرِط في التصديق بما يضر بنفسه)",
 "overcritical": "مُبَالِغٌ فِي النَّقْدِ, مُفْرِطُ الانْتِقَادِ (يميل إلى الحكم بقسوة مُفرِطة)",
 "overcrossing": "جسر مشاة (جسر مصمم لعبور المشاة)",
 "overcrowdedness": "اِزْدِحَام, زِحَام",
 "overcrowding": "احتقان, اكتظاظ مفرط (الاكتظاظ المفرط)\nمثال: احتقان مروري",
 "overcup oak": "بلوط القيثارة (شجرة أخشاب متساقطة الأوراق متوسطة إلى كبيرة من وسط وجنوب الولايات المتحدة؛ البلوط مغمور بعمق في الكأس وينضج في السنة الأولى)",
 "overcurious": "مُفْرِطُ الفُضُولِ (يُظهِر فضولاً مُفرِطاً)",
 "overdelicate": "شَدِيدُ الحَسَاسِيَّة, مُفْرِطُ الرِّقَّة (بَالِغُ الرِّقَّةِ وَالدِّقَّةِ إِلَى حَدٍّ مُفْرِط)",
 "overdone": "مُفْرَطُ الطَّهْو (طُهِيَ أَكْثَرَ مِنَ اللَّازِمِ لَكِنَّهُ لَا يَزَالُ صَالِحًا لِلأَكْل) / مُبَالَغٌ فِيه (مُصَوَّرٌ عَلَى أَنَّهُ أَكْبَرُ مِمَّا هُوَ فِي الحَقِيقَة)",
 "overdose": "جُرْعَة زَائِدَة",
 "overdraft": "سحب على المكشوف (سحب يتجاوز الرصيد الدائن)",
 "overdraft credit": "ائتمان السحب على المكشوف (ائتمان يوفره البنك لتغطية السحب على المكشوف للعميل)",
 "overdressed": "مُبَالِغ فِي اللِّبَاس (يرتدي ملابس أنيقة أكثر من اللازم)",
 "overdrive": "أوفردرايف, سرعة زائدة (ترس عالٍ يستخدم بسرعات عالية للحفاظ على سرعة القيادة بطاقة خرج أقل) / طاقة قصوى, نشاط مفرط (حالة النشاط العالي أو المفرط أو الإنتاجية أو التركيز)\nمثال: القوات مستعدة للعمل بطاقة قصوى بمجرد إعطاء الإشارة",
 "overdue": "مُتَأَخِّر, مُنْقَضِي الأَجَل (تجاوز موعد استحقاقه ولم يُسدَّد في الوقت المحدّد)",
 "overeager": "مُفْرِطُ الحَمَاسَة (متحمّس بشكل مفرط)",
 "overeating": "شراهة, نهم (الأكل بإفراط (تُشخص كإحدى الخطايا السبع المميتة))",
 "overemotional": "مُفْرِطُ العَاطِفَة (عاطفيّ بشكل مُفرط أو غير طبيعي)",
 "overemphasis": "مبالغة في التأكيد (تأكيد زائد عن الحد)",
 "overenthusiastic": "مُفْرِطُ الحَمَاسَة (متحمّس بشكل مفرط وغير متناسب)",
 "overestimate": "تقدير مفرط, مغالاة في التقدير (حساب ينتج عنه تقدير مرتفع جداً) / تقدير مبالغ فيه, مغالاة في التثمين (تقييم مرتفع للغاية)",
 "overestimation": "تقدير مفرط, مغالاة في التقدير (حساب ينتج عنه تقدير مرتفع جداً) / تقدير مبالغ فيه, مغالاة في التثمين (تقييم مرتفع للغاية)",
 "overexcited": "مُفْرِط الإِثَارَة (مُثَار بشكل مُفرِط يتجاوز الحدّ)",
 "overexertion": "إجهاد مفرط (إجهاد مفرط؛ بذل جهد كبير لدرجة تسبب الانزعاج أو الإصابة)",
 "overexploitation": "استغلال مفرط, استنزاف (الاستغلال إلى حد تناقص العوائد)",
 "overexposure": "تعريض مفرط (فعل تعريض شخص ما بشكل مفرط لتجربة مؤثرة) / تعريض مفرط (فعل تعريض الفيلم للكثير من الضوء أو لفترة طويلة جدًا)\nمثال: التعرض المفرط للعنف في التلفزيون",
 "overfamiliar": "مُتَجَاوِز لِلحُدُود (يأخذ حريات غير لائقة في التعامل مع الآخرين)",
 "overfamiliarity": "اعْتِيَادِيَّة مُمِلَّة, الْفَة مُفْرِطَة (حالة كون الشيء شائعاً أو مكرراً لدرجة عدم ملاحظته أو الإزعاج)",
 "overfed": "مُفْرَط التَّغْذِيَة (يتلقى تغذية أكثر من اللازم)",
 "overfeeding": "إفراط في التغذية (تغذية مفرطة)",
 "overflight": "تحليق فوق منطقة (طيران طائرة فوق منطقة معينة (خاصة فوق منطقة في أرض أجنبية))",
 "overflow": "فَيَضَان / فَاضَ",
 "overflow incontinence": "سلس فيضي (سلس البول الذي يحدث عندما تكون المثانة ممتلئة لدرجة أنها تسرب البول باستمرار؛ يُعزى غالبًا إلى انسداد مجرى البول (على سبيل المثال، بسبب تضخم…)",
 "overflowing": "غَارِق, مَغْمُور (مُغَطًّى بِالمَاء)",
 "overfond": "مُفْرِطُ الوَلَع (مولع بشكل مبالغ فيه)",
 "overfull": "مُتْخَم, مُفْرِط الامْتِلَاء (يَفُوقُ الطَّلَب؛ مُمْتَلِئ أَكْثَر مِنَ اللَّازِم)",
 "overgarment": "رداء خارجي, ملابس خارجية (رداء يلبس فوق ملابس أخرى)",
 "overgenerous": "بَاذِخ, مُسْرِف فِي العَطَاء (بالغ السخاء؛ يُعطي بإسراف ودون حساب)",
 "overgreedy": "مُفْرِط الشَّرَه (شَرِه بإفراط مُبالَغ فيه)",
 "overgrown": "مُتَكَاثِف النَّبَات (مغطى بنباتات نامية بكثافة) / مُتَشَعِّب, مُتَكَاثِف النَّبَات (مَلِيءٌ بِالنَّبَاتَاتِ غَيْرِ المَرْغُوبَةِ عَادَةً)",
 "overgrowth": "نمو مفرط (غزارة النمو على أو فوق شيء آخر) / عملقة, فرط النمو (حجم مفرط؛ ناتج عادة عن إفراز مفرط لهرمون النمو من الغدة النخامية)",
 "overhand": "مَخِيطٌ بِغُرْزَةٍ عُلْوِيَّةٍ (مخيط بغرز عمودية قريبة تمر فوق الحافتين وتجمعهما معاً) / من فوق الذراع (مع تقديم اليد وخفضها من فوق مستوى الكتف)\nمثال: رمية من فوق الذراع",
 "overhand knot": "عقدة بسيطة (عقدة صغيرة بسيطة)",
 "overhand pitch": "رمية علوية (رمية بيسبول تتحرك فيها اليد فوق الكتف)",
 "overhand stitch": "غرزة علوية (غرزة تمر فوق الحافة بشكل عمودي)",
 "overhanded": "من فوق الذراع (مع تقديم اليد وخفضها من فوق مستوى الكتف)\nمثال: رمية من فوق الذراع",
 "overhang": "بروز, تدلّ (نتوء يمتد إلى ما بعد شيء آخر أو يتدلى فوقه)",
 "overhasty": "مُتَرَسِّع, مُتَعَجِّل (يتمّ بعجلة شديدة وبدون تَرَوٍّ كافٍ)",
 "overhaul": "إعادة تأهيل, تجديد (فعل التحسين عن طريق التجديد والاستعادة) / عمرة, فحص وإصلاح شامل (صيانة دورية لسيارة أو آلة)\nمثال: إنهم يتابعون برنامجاً عاماً لتجديد العقار بأكمله",
 "overhead": "فَوْق الرَّأْس (أعلى الرأس) / عَالِيًا, فِي السَّمَاء (فوق رأسك؛ في السماء) / سماش, ضربة ساحقة (رد قوي بضرب كرة التنس فوق رأسك) / علوي, فوقي (يقع أو ينشأ من الأعلى)\nمثال: اجمع الساقين معاً فوق الرأس",
 "overhead press": "ضغط فوق الرأس (تمرين تدريب بالأوزان، عادة ما يؤدى أثناء الوقوف، حيث يتم ضغط الوزن بشكل مستقيم للأعلى من الكتفين حتى يتم قفل الذراعين فوق الرأس)",
 "overhead projector": "جهاز عرض علوي (جهاز عرض يشغله متحدث؛ يعرض الصورة فوق رأس المتحدث)",
 "overhead railway": "سكة حديد معلقة, قطار معلق (سكة حديد تعمل بالكهرباء وتسير على مسار مرتفع فوق مستوى الشارع)",
 "overheated": "مُحْتَرّ بِإِفْرَاط (سُخِّن فوق الحدّ الآمن أو المطلوب)",
 "overheating": "تسخين مفرط, فرط السخونة (تسخين مفرط)",
 "overindulgence": "إفراط في التدليل (التدليل المفرط)\nمثال: أفسد الطفل بسبب الإفراط في التدليل",
 "overindulgent": "مُفْرِط فِي التَّسَاهُل (مُتساهل بشكل مُفرط)",
 "overinterpretation": "إفراط في التفسير (تفسير مفرط)\nمثال: يمكن للمراجعين المجتهدين والمحررين الدقيقين تحديد الأخطاء وتوفير التوازن وكبح الإفراط في التفسير",
 "overjealous": "حَسُود, غَيُور (شديد الارتياب أو الخوف من أن يحلّ منافس محله)",
 "overjoyed": "طَرِب, مُفْرِط الفَرَح (بالغ الفرح والسرور إلى أقصى حدّ)",
 "overkill": "إفراط, مبالغة (أي جهد يبدو أنه يذهب أبعد مما هو ضروري لتحقيق هدفه) / إفراط في التسلح, قوة مفرطة (القدرة على تدمير هدف بأسلحة تزيد عن الحاجة (خاصة الأسلحة النووية))",
 "overladen": "مُحَمَّل فَوْقَ طَاقَتِه (مُحَمَّل بِأَكْثَر مِنْ طَاقَتِه)",
 "overland": "بَرِّيّ, عَبْر البَرّ (يسافر أو يمرّ عبر اليابسة)",
 "overlap": "تراكب, طية (لسان يقع فوق جزء آخر) / تداخل (خاصية التصادف الجزئي في الوقت) / التقاء, تداخل (تمثيل للأرضية المشتركة بين النظريات أو الظواهر)\nمثال: يجب أن يكون تراكب القرميد عشر بوصات على الأقل",
 "overlapping": "تداخل, تراكب (غطاء بتصميم يغطي فيه عنصر جزءاً من عنصر آخر (كما هو الحال في البلاط أو القرميد))",
 "overlarge": "مُفْرِط الكِبَر (كبير بشكل مفرط)",
 "overlay": "طبقة تغطية (طبقة من مادة زخرفية (مثل ورق الذهب أو قشرة الخشب) توضع فوق سطح) / تغليف, تكسية (غطاء واقٍ يتكون مثلاً من طبقة من الألواح تطبق على دعامات وعوارض المبنى لتقويته وتكون بمثابة أساس للتكسية الخارجية المقاومة للعوامل الجوية)",
 "overlayer": "تغليف, تكسية (غطاء واقٍ يتكون مثلاً من طبقة من الألواح تطبق على دعامات وعوارض المبنى لتقويته وتكون بمثابة أساس للتكسية الخارجية المقاومة للعوامل الجوية)",
 "overleaf": "على الوجه الآخر, في الصفحة التالية (على أو إلى الجانب الآخر من الصفحة)\nمثال: البيانات مبوبة في الصفحة التالية",
 "overlip": "شفة عليا (الشفة العلوية)",
 "overload": "حمل زائد (عبء مفرط) / حمل زائد (حمل كهربائي يتجاوز الطاقة الكهربائية المتاحة)",
 "overloaded": "مُحَمَّل فَوْقَ طَاقَتِه (مُحَمَّل بِأَكْثَر مِنْ طَاقَتِه)",
 "overlook": "صَفَحَ (الصَّفْحُ : العفو؛ صَفْحُ الإِنْسَانِ : جَنْبُهُ)\nمثال: كل صفحة مغامرة.",
 "overlooked": "غَيْر مُلَاحَظ, مُغْفَل (لم يُؤخَذ في الحسبان)",
 "overlooking": "مُشْرِف, مُطِلّ (يُستخدَم لوصف ارتفاع أو موقع مُطِلّ على ما حوله)",
 "overlord": "حاكم أعلى, سيد أعلى (شخص لديه سلطة عامة على الآخرين)",
 "overlordship": "سيادة عليا, هيمنة (منصب السيد الأعلى)",
 "overly": "بإفراط, بشكل مبالغ فيه (لدرجة تتجاوز الحدود الطبيعية أو المناسبة)\nمثال: كبير جداً",
 "overlying": "مُتَرَاكِب, مُرَكَّب فَوْق (موضوع فوق شيء آخر)",
 "overmantel": "رف فوق الموقد (رف فوق رف الموقد)",
 "overmodest": "خَجُولٌ تَصَنُّعًا, مُتَدَلِّل (يَتَصَنَّعُ الحَيَاءَ أَوِ الخَجَلَ بِشَكْلٍ مُغَازِلٍ أَوْ مُثِير)",
 "overmorrow": "بَعْدَ ٱلْغَد (يدل على اللحاق في الزمان؛ يكون مضافا، وينصب أو يجر)\nمثال: و بعد قليل أتى.",
 "overmuch": "بإفراط, كثيراً جداً (أكثر مما يلزم) / زَائِد عَنِ الحَدّ, مُفْرِط (بالغ الكثرة؛ فائض عن الحاجة) / إفراط, فرط (كمية تزيد عما هو مناسب)\nمثال: إنها تأكل كثيراً جداً",
 "overmuchness": "إفراط, فرط (كمية تزيد عما هو مناسب)\nمثال: الأطفال في سن الرابعة لديهم فرط في الطاقة",
 "overnice": "مُتَقَزِّز, مُتَنَطِّع (مُفْرِط فِي التَّدْقِيق وَسَرِيع الاشْمِئْزَاز)",
 "overnight": "بَيْنَ لَيْلةٍ وَضُحاهَا (ظرف مكان بمعنى وَسْط)\nمثال: مصيري بين يديك.",
 "overnight bag": "حقيبة ليلية, حقيبة مبيت (حقيبة سفر صغيرة لحمل الملابس واللوازم للإقامة لليلة واحدة)",
 "overnight case": "حقيبة ليلية, حقيبة مبيت (حقيبة سفر صغيرة لحمل الملابس واللوازم للإقامة لليلة واحدة)",
 "overnighter": "حقيبة ليلية, حقيبة مبيت (حقيبة سفر صغيرة لحمل الملابس واللوازم للإقامة لليلة واحدة) / نزيل لليلة واحدة (ضيف يقيم لليلة واحدة)",
 "overpass": "جسر علوي (جسر يتشكل من المستوى العلوي لتقاطع طريقين سريعين على مستويات مختلفة)",
 "overpayment": "دفع زائد (فعل دفع أكثر من اللازم) / دفعة زائدة (دفعة أكبر مما هو مطلوب أو متوقع)",
 "overplus": "فائض, وفرة مفرطة (إفراط شديد)\nمثال: وفرة محرجة من الثروات",
 "overpopulation": "زيادة سكانية",
 "overpower": "اِسْتَبَدَّ (حزم ولم يتردد في اتخاذ القرار وتنفيذه؛ (في السياسة) حكم بنظام استبدادي)",
 "overpowering": "سَاحِقٌ, طَاغٍ (بالغ القوة لدرجة لا يمكن مقاومتها)",
 "overpoweringly": "بِشَكْل سَاحِق, بِقُوَّة قَاهِرَة (بشكل لا يمكن مقاومته)\nمثال: بدت الحلوى مرغوبة بشكل ساحق للرجل الذي يتبع حمية",
 "overpraise": "إفراط في الثناء (ثناء مفرط أو غير مستحق)\nمثال: تؤمن معلمة البيانو بتشجيع طلابها لكنها تتجنب أي إفراط في الثناء قد يجعلهم يشعرون بالرضا عن النفس",
 "overpressure": "ضغط زائد, ضغط مفرط (ضغط هواء عابر أكبر من الضغط الجوي المحيط)\nمثال: الضغط المفرط للانفجار يقتل عن طريق الارتجاج المميت",
 "overpriced": "مُبَالَغ فِي سِعْرِه (أغلى مما تستحقه قيمته الفعلية)",
 "overprint": "طباعة فوقية (شيء مضاف عن طريق الطباعة الفوقية)",
 "overproduction": "تجاوز الإنتاج, فرط الإنتاج (إنتاج مفرط أو أكثر من المتوقع)",
 "overprotection": "حماية مفرطة (حماية زائدة عن الحد)",
 "overprotective": "مُفْرِط فِي الحِمَايَة (يحمي بشكل مبالغ فيه)",
 "overproud": "مُفْرِط فِي الفَخْر (فخور بشكل مبالَغ فيه)",
 "overrating": "تقدير مفرط, مغالاة في التقدير (حساب ينتج عنه تقدير مرتفع جداً)",
 "overreach": "أَنَافَ / غَلَا / نَيَّفَ / تَطَاوَلَ",
 "overreaching": "مُفْرِط الطُّمُوح (يكشف عن ثقة مفرطة بالنفس؛ يتطلع إلى أعلى المراتب)",
 "overreact": "ثور بصورة مبالغة (حُمْرَة الشفق الثائرة فيه؛ الطُحْلُب وما أشبهه فوق الماء. سميّ كذلك لأنه يثور فجأة)\nمثال: حرث ما حرث الثور.",
 "overreaction": "رد فعل مبالغ فيه (رد فعل مفرط؛ رد فعل بسلوك عاطفي غير لائق)",
 "overreckoning": "تقدير مفرط, مغالاة في التقدير (حساب ينتج عنه تقدير مرتفع جداً)",
 "overrefined": "مُبَالَغٌ فِي رِقَّتِهِ, مُفْرِطُ التَّهْذِيبِ (مفرط في الرقة أو التهذيب)",
 "overrefinement": "تشويه, لوي الحقائق (فعل تشويه الشيء ليبدو وكأنه يعني شيئاً لم يكن يقصده)",
 "override": "إبطال, إلغاء المفعول (فعل الإبطال؛ جعل الشيء لاغياً وباطلاً؛ أو تجاوز تأثير أو قوة شيء ما) / تجاوز يدوي, جهاز تجاوز (جهاز يعمل يدوياً لتصحيح تشغيل جهاز أوتوماتيكي)",
 "overriding": "رَاجِح, طَاغٍ (ذُو قُوَّة وَتَأْثِير أَعْلَى)",
 "overripe": "مُتَفَسِّخ, مُفْرِط اَلنُّضْج",
 "overrun": "تجاوز الإنتاج, فرط الإنتاج (إنتاج مفرط أو أكثر من المتوقع)",
 "oversea": "في الخارج, وراء البحار (ما وراء أو عبر البحر) / عَبْر البِحَار, مَا وَرَاء البَحْر (يكون أو يمرّ عبر البحر)\nمثال: عاش في الخارج لسنوات عديدة",
 "overseas": "عبر البحار, في الخارج (في مكان عبر المحيط) / في الخارج, وراء البحار (ما وراء أو عبر البحر) / فِي الخَارِج, وَرَاءَ البِحَار (فِي بَلَدٍ أَجْنَبِيٍّ) / عَبْر البِحَار, مَا وَرَاء البَحْر (يكون أو يمرّ عبر البحر)\nمثال: عاش في الخارج لسنوات عديدة",
 "overseas cap": "قبعة عسكرية جانبية (قبعة صوفية أو قطنية على شكل إسفين؛ تلبس كجزء من الزي الرسمي)",
 "overseas telegram": "برقية دولية (برقية ترسل إلى الخارج)",
 "oversee": "أَشْرَفَ عَلَى (للشَرَف)",
 "overseer": "مُشْرِف / مُشْرِفَة",
 "oversensitive": "مُفْرِط الحَسَاسِيَّة (حسّاس بشكل مبالغ فيه)",
 "oversensitiveness": "حساسية مفرطة (حساسية تؤدي إلى سهولة الانزعاج أو الغضب)",
 "overserious": "مُفْرِط فِي الجِدِّيَّة (جادّ إلى حدّ المبالغة)",
 "oversewn": "مَخِيطٌ بِغُرْزَةٍ عُلْوِيَّةٍ (مخيط بغرز عمودية قريبة تمر فوق الحافتين وتجمعهما معاً)",
 "oversexed": "مُفْرِط الشَّهْوَة (ذو رغبة أو جاذبية جنسية مفرطة)",
 "overshadow": "غَطَّى",
 "overshielding": "حماية مفرطة (حماية زائدة عن الحد)",
 "overshoe": "حذاء فوقي (حذاء يحمي حذاءك الأصلي من الماء أو الثلج أو البرد)",
 "overshoot": "إلغاء الهبوط, تجاوز الهدف (اقتراب يفشل ويفسح المجال لمحاولة أخرى)",
 "overshot": "بَارِز العُلْوِيّ (ذو جزء علوي يبرز متجاوزاً الجزء السفلي)",
 "overside": "فوق الجانب (فوق جانب القارب)\nمثال: أنزل ويلي نفسه فوق الجانب إلى البحر",
 "oversight": "سهو, غفلة (خطأ ناتج عن عدم الانتباه) / إشراف, رقابة (الإدارة من خلال الإشراف على أداء أو تشغيل شخص أو مجموعة) / سهو, غفلة غير مقصودة (إغفال غير مقصود ناتج عن الفشل في ملاحظة شيء ما)",
 "oversimplification": "تبسيط مفرط, سطحية (فعل التبسيط المفرط؛ عملية جعل الشيء يبدو أبسط مما هو عليه في الواقع) / تبسيط مخل (شرح يبسط الأمور إلى حد التشويه)",
 "oversize": "أَكْبَر مِن المُعْتَاد, مُفْرِط الحَجْم (أكبر من الحجم الطبيعي لنوعه)",
 "oversized": "أَكْبَر مِن المُعْتَاد, مُفْرِط الحَجْم (أكبر من الحجم الطبيعي لنوعه)",
 "overskirt": "تنورة فوقية (تنورة خارجية تلبس فوق تنورة أخرى)",
 "oversleep": "اِسْتَغْرَقَ فِي النَّوْم",
 "oversolicitous": "مُفْرِط فِي العِنَايَة (مبالغ في الاهتمام والرعاية بشكل زائد)",
 "overspill": "جريان سطحي, طفح (حدوث فائض سائل (مثل الماء) يتجاوز الحد أو السعة) / إعادة تسكين, تخفيف الاكتظاظ (نقل الناس من المدن المكتظة؛ يتم استيعابهم في منازل أو شقق جديدة في مدن أصغر)",
 "overstated": "مُبَالَغٌ فِيه (مُصَوَّرٌ عَلَى أَنَّهُ أَكْبَرُ مِمَّا هُوَ فِي الحَقِيقَة)",
 "overstatement": "تهويل, مبالغة (جعل الشيء يبدو أكثر أهمية مما هو عليه في الواقع)",
 "oversteer": "انعطاف مفرط, فرط التوجيه (عندما تنعطف السيارة بمقدار أكثر مما أمر به السائق)",
 "overstep": "تَخَطَّى",
 "overstrain": "إجهاد مفرط (إجهاد زائد عن الحد)",
 "overstrung": "مُفْرِطُ الشَّدّ (مَشْدُودٌ أَكْثَرَ مِنَ اللَّازِم) / حَسَّاسُ الأَعْصَاب, عَصَبِيّ (فِي حَالَةِ تَوَتُّرٍ وَانْفِعَال)",
 "overstuffed": "مَحْشُوّ بِإفْراط (مُبالَغ في حَشْوِه حتّى أصبَح شَديد النُّعومَة)",
 "overstuffed chair": "كرسي استرخاء, كرسي مريح (كرسي بذراعين منجد ومريح)",
 "oversubscribed": "مُفْرِطُ الاكْتِتَاب (بِيع بما يفوق الكمّيّة المتاحة؛ خاصّة التذاكر الموسميّة)",
 "oversupply": "إغراق, تخمة (صفة الوفرة المفرطة لدرجة انخفاض الأسعار)",
 "oversuspicious": "مُفْرِط الشَّكّ (شديد الارتياب بدون مبرر كافٍ)",
 "overt": "صريح, ظاهر (مفتوح وقابل للملاحظة؛ غير سري أو مخفي)\nمثال: كذبة صريحة",
 "overt operation": "عملية علنية (جمع المعلومات الاستخباراتية بشكل علني دون إخفاء)",
 "overtake": "سَبَقَ (سَبَقَهُ إِلَى الشيءِ يَسْبِقَهُ سَبْقًا: تقدَّمَهُ؛ يقال سَبَقَ الفرسُ في الحَلْبةِ: جاءَ قبل الأَفراسِ)\nمثال: سبق و رأيت ذلك.",
 "overtaking": "تجاوز, تخطي (المرور بجانب شيء متحرك للوصول إلى أمامه)\nمثال: كانت تقود بشكل جيد لكن تجاوزها المتهور لكل سيارة على الطريق أخافني",
 "overthrow": "أَطَاحَ",
 "overthrust fault": "صدع الدسر, صدع عكسي (صدع جيولوجي يبدو فيه أن الجانب العلوي قد تم دفعه للأعلى بفعل الضغط)",
 "overtime": "وَقْت إِضَافِيّ (\"بَقِيَ وَقْتاً عِنْدَهُ \" : أَيْ مِقْدَاراً مِنَ الزَّمَنِ؛ \"جَاءَ فِي الوَقْتِ الْمُنَاسِبِ \" : فِي اللَّحْظَةِ الْمُنَاسِبَةِ)\nمثال: حان وقت الذهاب.",
 "overtime period": "فترة إضافية (فترة من اللعب الإضافي لحسم التعادل؛ مثل كرة السلة)",
 "overtly": "علناً (بطريقة علنية)\nمثال: فعل ذلك علناً",
 "overtolerance": "تسامح مفرط (الإفراط في التساهل)",
 "overtone": "نغمة تابعة, نغمة فوقية (نغمة توافقية ذات تردد يمثل مضاعفاً للتردد الأساسي) / إِيحَاء, نَبْرَة خَفِيَّة ((عادة الجمع) معنى أو جودة ضمنية خفية)\nمثال: إيحاءات اليأس",
 "overture": "اِفْتِتَاحِيَّة",
 "overturn": "فوز غير متوقع, قلب التوقعات (نصر غير محتمل وغير متوقع) / انقلاب, قلب (عملية قلب شيء ما)\nمثال: أكبر فوز غير متوقع منذ فوز داود على جالوت",
 "overturned": "مَكْفُوء, مُنْقَلِب (أُدير بحيث لم يعد القاع في الأسفل)",
 "overuse": "استغلال مفرط, استنزاف (الاستغلال إلى حد تناقص العوائد)",
 "overutilisation": "استغلال مفرط, استنزاف (الاستغلال إلى حد تناقص العوائد)",
 "overutilization": "استغلال مفرط, استنزاف (الاستغلال إلى حد تناقص العوائد)",
 "overvaliant": "مُفْرِط الشَّجَاعَة (لديه أو يُظهر جرأة مفرطة)",
 "overvaluation": "تقدير مفرط, مغالاة في التقييم (تحديد قيمة أو سعر مرتفع جداً لشيء ما) / تقدير مبالغ فيه, مغالاة في التثمين (تقييم مرتفع للغاية)",
 "overview": "عرض شامل, نظرة عامة (ملخص عام لموضوع ما)\nمثال: قدم أمين الصندوق نظرة عامة موجزة عن العواقب المالية",
 "overwatch": "تغطية, مراقبة وتغطية (مراقبة من قبل وحدة (في ألعاب الفيديو أو العسكرية) للرد على أفعال العدو)",
 "overweening": "مُتَعَجْرِف, مُتَغَطْرِس (مُتَكَبِّرٌ بِشَكْلٍ وَقِحٍ وَمُتَجَاوِزٍ لِلْحُدُود) / مُبَالَغٌ فِيه, مُفْرِط (بلا قيود، خاصة فيما يتعلق بالمشاعر)",
 "overweight": "زَائِد الوَزْن, ضَخْم البِنْيَة (يَصِف عَادَةً شَخْصًا كَبِيرًا بَدِينًا لَكِنْ لَه هَيْكَل كَبِير يَحْمِل وَزْنَه) / بدانة, وزن زائد (خاصية السمنة المفرطة)",
 "overwhelm": "اِسْتَبَدَّ (حزم ولم يتردد في اتخاذ القرار وتنفيذه؛ (في السياسة) حكم بنظام استبدادي)",
 "overwhelming": "غَالِب",
 "overwhelmingly": "بِشَكْل سَاحِق, بِقُوَّة قَاهِرَة (بشكل لا يمكن مقاومته)\nمثال: بدت الحلوى مرغوبة بشكل ساحق للرجل الذي يتبع حمية",
 "overwork": "إرهاق في العمل, عمل مفرط (فعل العمل كثيراً جداً أو لفترة طويلة جداً)\nمثال: أصيب بالمرض من الإرهاق في العمل",
 "overworking": "إرهاق في العمل, عمل مفرط (فعل العمل كثيراً جداً أو لفترة طويلة جداً)\nمثال: أصيب بالمرض من الإرهاق في العمل",
 "overwrought": "مُضْطَرِب بِشِدَّة, مُنْهَار (في حالة اضطراب شديد وخاصة من فرط العاطفة)",
 "overzeal": "حماسة مفرطة, مغالاة (صفة الحماسة المفرطة)\nمثال: نحن ندرك قلق الجمهور من أي نوع من الحماسة المفرطة من قبل رجال إنفاذ القانون والتي قد تسبب بعض الحرج",
 "overzealous": "مَهْوُوس, مُتَعَصِّب (مُفْرِطٌ فِي الحَمَاسِ وَشَدِيدُ التَّفَانِي لِقَضِيَّةٍ أَوْ فِكْرَة)",
 "overzealousness": "حماسة مفرطة, مغالاة (صفة الحماسة المفرطة)\nمثال: نحن ندرك قلق الجمهور من أي نوع من الحماسة المفرطة من قبل رجال إنفاذ القانون والتي قد تسبب بعض الحرج",
 "ovibos moschatus": "ثور المسك (ثديي بقري كبير أشعث المعطف يعيش في كندا وجرينلاند؛ متوسط الحجم والتشريح بين الثور والخروف)",
 "oviduct": "قَنَاةُ الْبَيْض",
 "oviedo": "أُوفِيِيدُو, أُبِيط",
 "oviform": "إِهْلِيلَجِيّ, بَيْضَوِيّ (مستدير كالبيضة؛ ذو شكل بيضاوي)",
 "ovimbundu": "مبوندو (مجموعة عرقية تتحدث لغة أومبوندو وتعيش في غرب أنغولا)",
 "ovine": "غَنَمِيّ",
 "oviparous": "بيوض (يضع البيض)",
 "ovipositor": "مضع البيض (هيكل أنبوبي لوضع البيض في نهاية البطن في العديد من إناث الحشرات وبعض الأسماك)",
 "oviraptorid": "أوفيرابتوريد (ثيروبودات لاحمة متطورة، تتميز بمناقيرها عديمة الأسنان التي تشبه الببغاء، وفي عدة حالات، بأعراف معقدة)",
 "ovis ammon": "أرغالي (خروف بري يعيش في المناطق شبه الصحراوية في وسط آسيا)",
 "ovis aries": "خروف أهلي (أي من السلالات المختلفة التي تربى من أجل الصوف أو اللحم الصالح للأكل أو الجلد)",
 "ovis canadensis": "الضأن كبير القرون, كباش الجبال الصخرية (خروف بري في المناطق الجبلية بغرب أمريكا الشمالية له قرون ضخمة ملتوية)",
 "ovis montana dalli": "خروف دال (خروف بري أبيض كبير يعيش في شمال غرب كندا وألاسكا)",
 "ovis musimon": "الكبش البري, موفلون (خروف جبلي بري في كورسيكا وسردينيا)",
 "ovis poli": "خروف ماركو بولو (خروف بري آسيوي ذو قرون كبيرة بشكل استثنائي؛ يعتبر أحياناً صنفاً من الأرغالي)",
 "ovis vignei": "أريل (خروف ملتحٍ محمر يعيش في جنوب آسيا)",
 "ovo-lacto vegetarianism": "نباتية الألبان والبيض, نباتية لبنية بيضية (نظام غذائي يتكون أساساً من أطعمة نباتية المصدر ولكنه يشمل بعض المنتجات الحيوانية مثل البيض والحليب والجبن، دون اللحوم والأسماك والدواجن)\nمثال: نباتية الألبان والبيض هي النمط الأكثر شيوعاً للنباتية في الولايات المتحدة",
 "ovocon": "أوفوكون (اسم تجاري لمانع حمل فموي يحتوي على 30 ميكروغرام إيثينيل استراديول و 1.5 ملغ خلات نوريثيندرون)",
 "ovoflavin": "ريبوفلافين, فيتامين ب2 (فيتامين ب يمنع الآفات الجلدية وفقدان الوزن)",
 "ovoid": "إِهْلِيلَجِيّ, بَيْضَوِيّ (مستدير كالبيضة؛ ذو شكل بيضاوي) / شكل بيضوي (جسم على شكل بيضة)",
 "ovolo": "أوفولو (ربع دائرة محدبة) (إطار محدب له مقطع عرضي على شكل ربع دائرة أو قطع ناقص)",
 "ovotestis": "مبيض خصوي (غدة تناسلية خنثوية تحتوي على أنسجة الخصية والمبيض معاً)",
 "ovoviviparous": "بيوض ولود (ينتج صغارًا أحياء من بيض يفقس داخل الجسم)",
 "ovral": "أوفرال (اسم تجاري لمانع حمل فموي يحتوي على استراديول ونورجيستريل)",
 "ovrette": "أوفريت (اسم تجاري لمانع حمل فموي يحتوي على نورجيستريل)",
 "ovular": "بويضي (من أو يتعلق بالبويضة) / بويضي (يكون بويضة أو من طبيعتها)",
 "ovulation": "إباضة, تبويض (طرد البويضة من المبيض (عادة في منتصف الدورة الشهرية))",
 "ovulation method": "طريقة الإباضة (تنظيم الأسرة الطبيعي الذي يتم فيه استنتاج فترة الخصوبة من التغيرات في طبيعة وكمية مخاط عنق الرحم)",
 "ovulation method of family planning": "طريقة الإباضة (تنظيم الأسرة الطبيعي الذي يتم فيه استنتاج فترة الخصوبة من التغيرات في طبيعة وكمية مخاط عنق الرحم)",
 "ovule": "بويضة صغيرة (بويضة صغيرة أو غير ناضجة) / بويضة (جسم صغير يحتوي على الخلية الجرثومية الأنثوية للنبات؛ يتطور إلى بذرة بعد الإخصاب)",
 "ovulen": "أوفولين (اسم تجاري لمانع حمل فموي يحتوي على ميسترانول ومركب بروجستين)",
 "ovum": "بُيَيْضَة, بُوَيْضَة",
 "owing to": "بِسَبَبّ",
 "owl": "بُومَة",
 "owlclaws": "عشبة العطاس البرتقالية (عشبة معمرة قوية من غرب الولايات المتحدة ذات رؤوس زهور بأشعة صفراء برتقالية متدلية؛ تسبب مرض القيء في الأغنام)",
 "owlet": "فرخ البومة (بومة صغيرة)",
 "owlet moth": "عثة ليلية (عثة ليلية متوسطة الحجم باهتة اللون عادة؛ اليرقات عادة ما تكون ملساء الجسم وهي آفات زراعية مدمرة)",
 "owlish": "بُومِيّ الْمَظْهَر (يشبه البومة في مظهره؛ وقور وحكيم الهيئة)",
 "owlishly": "بوقار مصطنع (بطريقة تشبه البومة في الوقار المصطنع)\nمثال: حدق المحامي ذو المظهر اللطيف بوقار مصطنع حوله",
 "owlt": "زمن الضوء باتجاه واحد (الوقت المنقضي الذي يستغرقه الضوء (أو الإشارات الراديوية) للسفر بين الأرض وجرم سماوي)",
 "own": "مِلْك, نَفْس (لغة في المَالِك، وهو الذي يَمْلِكُ؛ السُلْطَان الحَاكِم الذي يملك الأَرْض والبِلاد) / مَلَكَ (لغة في المَالِك، وهو الذي يَمْلِكُ؛ السُلْطَان الحَاكِم الذي يملك الأَرْض والبِلاد)\nمثال: زيري ملك لنفسه.",
 "own goal": "هدف ذاتي, هدف عكسي (جاء إلى الهَدَف؛ ارتفع عن الأرض)\nمثال: لقد أخطأ الهدف.",
 "owned": "مَمْلُوك (لديه مالك؛ غالباً ما تستخدم في التركيب)\nمثال: سكك حديدية مملوكة للدولة",
 "owner": "مَالِك, مَالِكَة (اسم شخصي معطًى للذكور من العرب)\nمثال: من مالك هذا البيت؟",
 "owner's equity": "حقوق الملاك (استثمار المالك في العمل التجاري والذي يتكون من صافي أصول الكيان)",
