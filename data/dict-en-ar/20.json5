 "pahlavi iran": "إِيرَان الْبَهْلَوِيَّة (في الشرق الأوسط تقع شرق العِرَاق، كانت تسمى بلاد فَارِس ،واسمها الكامل الجمهورية الإسلامية الإيرانية)\nمثال: إيران بلد كبير.",
 "pahlavi language": "البهلوية (اللغة الإيرانية للأدب الزرادشتي من القرن الثالث إلى العاشر)",
 "pahoehoe": "لابة باهوهو (حمم بركانية تتدفق بحرية)",
 "paid": "مأجور, مدفوع (يتميز بتلقي أجر) / غَيْر تَرْفِيهِيّ, مَأْجُور (ينطوي على عمل مأجور فيما يُمارَس غالبًا كهواية) / مُجْزٍ, مُدِرّ لِلرِّبْح (يُدرّ ربحًا معقولاً)\nمثال: عمل مأجور",
 "paid vacation": "إجازة مدفوعة الأجر (إجازة من العمل للموظف مع منح الراتب)",
 "paid-up": "مَدْفُوعٌ مُسْبَقًا (مَدْفُوعُ الثَّمَنِ مُقَدَّمًا)",
 "paigle": "زهرة الربيع, كعب الثلج (زهرة ربيعية مبكرة شائعة في الجزر البريطانية ذات أزهار عطرة صفراء أو أرجوانية أحياناً) / زهرة الربيع العالية (زهرة ربيع أوراسية ذات أزهار صفراء مجمعة في خيمة أحادية الجانب)",
 "pail": "دلو, سطل (وعاء أسطواني الشكل مفتوح من الأعلى) / ملء دلو (الكمية المحتواة في دلو)",
 "pailful": "ملء دلو (الكمية المحتواة في دلو)",
 "paillasse": "فرشة قش (مرتبة تتكون من وسادة رقيقة مملوءة بالقش أو نشارة الخشب)",
 "pain": "أَلَمٌ (الوَجَع) / آلَمَ, يُؤْلِمُ (سبَّبَ أَلَمًا حسّيًّا أو وجعًا في الجسد؛ سَبَّبَ له الألَم)\nمثال: ألم أقل لك ذلك؟",
 "pain in the ass": "أَلَم فِي الْمُؤَخَّرَة (الوَجَع)\nمثال: ألم أقل لك ذلك؟",
 "pain in the neck": "إزعاج, مصدر إزعاج (شيء أو شخص يسبب المتاعب؛ مصدر للتعاسة)\nمثال: إزعاج بسيط",
 "pain pill": "دواء مسكن, مسكن (دواء يستخدم لتخفيف الألم)",
 "pain relief": "تسكين الألم",
 "pain sensation": "ألم, وجع (إحساس جسدي بعدم راحة حاد)\nمثال: مع زيادة الشدة، تحول الإحساس من دغدغة إلى ألم",
 "pain threshold": "عتبة الألم (أقل شدة للتحفيز التي يتم عندها الشعور بالألم)\nمثال: يتمتع بعض الناس بعتبات ألم أعلى بكثير من غيرهم",
 "pain unit": "وحدة ألم (وحدة قياس شدة الألم)",
 "pain-free": "خَالٍ مِنَ الأَلَم, غَيْرُ مُؤْلِم (لَا يُصَاحِبُهُ إِحْسَاسٌ بِالأَلَم)",
 "pained": "مَجْرُوح, مُهَان (متألم عاطفياً أو منزعج أو متضايق)",
 "painful": "أَلِيم, مُؤْلِم",
 "painful sensation": "ألم, وجع (إحساس جسدي بعدم راحة حاد)\nمثال: مع زيادة الشدة، تحول الإحساس من دغدغة إلى ألم",
 "painfully": "بشكل مؤلم, بشكل محزن (بشكل غير سار) / بألم, بوجع (في حالة ألم أو كما لو كان متألماً)\nمثال: كان جهله واضحاً بشكل مؤلم",
 "painfulness": "إيلام, وجع (صفة كون الشيء مؤلماً أو مسبباً للألم) / ألم, وجع (ضيق عاطفي؛ شعور أساسي يحاول الناس تجنبه)\nمثال: كانت تخشى آلام الولادة",
 "painkiller": "ضِدَّ الأَلَم, مُسَكِّن",
 "painless": "غَيْر مُؤْلِم (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "painlessly": "بلا ألم, دون وجع (بدون ألم)\nمثال: بعد الجراحة، استطاعت تحريك ذراعيها بلا ألم",
 "painlessness": "خلو من الألم (جودة الخلو من الألم أو المتاعب) / انْعِدَام الأَلَم, سُهُولَة (سهولة؛ عدم وجود صعوبة)\nمثال: الدكتور فراي، الحاضر هذا المساء، سيشهد على خلو هذه العملية من الألم",
 "pains": "سعي, كفاح (محاولة جاهدة لتحقيق هدف)",
 "painstaking": "مُجْتَهِد, وَرِع فِي عَمَلِه (يَتَّسِم بِعِنَايَة فَائِقَة وجُهْدٍ كَبِير)",
 "painstakingly": "بدأب, بعناية فائقة (بطريقة دقيقة ومجتهدة)\nمثال: تعلم روتين البيع بدأب",
 "painstakingness": "إتقان, ضمير حي (سمة كون المرء مجتهداً وحذراً)",
 "paint": "دِهَان / لَوَّنَ (صفة خارجة للشيء ترى بالعين فقط ولا تلمس أو تسمع أو تشم أو يمكن تذوقها؛ كناية عن النَوع أو الشكل أو مجموعة من الصفات المختلفة في جنس واحد)\nمثال: ما هو لون شعرك؟",
 "paint leaf": "بنت القنصل اليابانية, فربيون متباين الأوراق (بنت القنصل المبهرجة توجد من جنوب الولايات المتحدة إلى بيرو)",
 "paint roller": "بكرة طلاء, رول دهان (بكرة ذات سطح ماص تستخدم لفرد الطلاء)",
 "paintable": "قابل للرسم, قابل للطلاء (يصلح للرسم عليه أو طلائه)\nمثال: منظر طبيعي قابل للرسم للغاية",
 "paintball": "بينتبول, كرات الطلاء (لعبة تحاكي القتال العسكري؛ يحاول اللاعبون في فريق واحد القضاء على لاعبي الفريق المعارض عن طريق إطلاق كبسولات الطلاء عليهم) / كرة طلاء (كبسولة مملوءة بصبغة قابلة للذوبان في الماء تستخدم كقذيفة في لعبة كرات الطلاء)",
 "paintball gun": "بندقية كرات الطلاء (بندقية هوائية تستخدم في لعبة كرات الطلاء؛ مصممة لتحاكي السلاح نصف الآلي)",
 "paintbox": "علبة ألوان (صندوق يحتوي على مجموعة من مكعبات أو أنابيب ألوان الفنانين)",
 "paintbrush": "فُرْشَاة الطِلَاء",
 "painted": "أَبْلَق, مُتَعَدِّد الأَلْوَان (ذو أجزاء أو بقع ملوّنة بألوان مختلفة وزاهية عادةً) / مَدْهُون, مَطْلِيّ (يفتقر إلى الحيوية أو الجوهر كما لو أُنتِج بالرسم) / مدهون, مطلي (مغطى بالطلاء) / متبرج, مصبوغ (يضع مكياجاً)\nمثال: أثاث حديقة مطلي حديثاً",
 "painted beauty": "فراشة الجمال الملون (فراشة أمريكية لها أجنحة بنية داكنة مع بقع بيضاء وبرتقالية ذهبية)",
 "painted cup": "فرشاة الرسم الهندية, كاستيخا",
 "painted daisy": "أقحوان ملون, بيريثروم (نبات حديقة معمر يزهر في الربيع من أصل آسيوي له أوراق عطرية مقسمة بدقة وزهور بيضاء إلى وردية أرجوانية؛ مصدر لمبيد حشري)",
 "painted greenling": "السمكة المدانة, جرينلينج ملونة (سمكة جرينلينج ذات جسم مائل للبياض ومخطط بشرائط سوداء)",
 "painted leaf": "بنت القنصل, زهرة الميلاد (نبات أمريكي استوائي ذو حليب سام وأوراق مبهرجة مستدقة عادة ما تكون قرمزية تشبه البتلات تحيط بزهور صفراء صغيرة) / فربيون كأسي, نار على الجبل (بنت القنصل في الولايات المتحدة وشرق المكسيك؛ غالباً ما يتم الخلط بينها وبين الفربيون متباين الأوراق)",
 "painted nettle": "سجاد, كوليوس",
 "painted sandgrouse": "قطا ملون (قطا من الهند)",
 "painted terrapin": "سلحفاة مزركشة (سلاحف مياه عذبة لها علامات صفراء وحمراء زاهية؛ شائعة في شرق الولايات المتحدة)",
 "painted tongue": "سالبجلوسيس, لسان مصبوغ (عشب تشيلي له زهور مخملية قمعية الشكل صفراء أو بنفسجية مع أقلام تشبه اللسان الطويل عند حلق التويج)",
 "painted tortoise": "سلحفاة مزركشة (سلاحف مياه عذبة لها علامات صفراء وحمراء زاهية؛ شائعة في شرق الولايات المتحدة)",
 "painted turtle": "سلحفاة مزركشة (سلاحف مياه عذبة لها علامات صفراء وحمراء زاهية؛ شائعة في شرق الولايات المتحدة)",
 "painted-leaf begonia": "بيغونيا الملك, بيغونيا ريكس (أي من العديد من البيغونيا الهجينة الجذمورية عادةً المشتقة من نبات من جزر الهند الشرقية، لها أوراق خشنة الملمس منقوشة بالفضة والبرونز والأرجواني…)",
 "painter": "رَسَّام, رَسَّامَة (الفَنَّان الذي يَصْنَعُ الرُّسُومَ) / دَهَّان, دَهَّانَة\nمثال: إنه رسام مشهور.",
 "painter's colic": "مغص الرصاص (عَرَض للتسمم المزمن بالرصاص ويرتبط بالإمساك المستعصي)",
 "painterly": "تَشْكِيلِيّ (ذو صفات خاصة بفن الرسم والتصوير)",
 "painting": "لَوْحَة, صُورَة / طِلَاء, دِهَان",
 "paipai": "بايباي (فرد من مجتمع أكوالا في باجا كاليفورنيا)",
 "pair": "زَوْج (زَوَّجَ الأَشياءَ تَزْويجًا، وزَواجًا: قرن بعضَها ببعض؛ زَوَّجَ فلانًا امرأةً، وبها: جعله يتزوَجَها)\nمثال: زوجة ماري طبيبة.",
 "pair creation": "إنتاج الزوج (تحول فوتون أشعة جاما إلى إلكترون وبوزيترون عندما يمر الفوتون بالقرب من نواة ذرية)",
 "pair formation": "إنتاج الزوج (تحول فوتون أشعة جاما إلى إلكترون وبوزيترون عندما يمر الفوتون بالقرب من نواة ذرية)",
 "pair of compasses": "فِرْجَار, بِرْكَار",
 "pair of pincers": "كماشة, ملقط (أداة يدوية للإمساك تتكون من رافعة مركبة للقبض)",
 "pair of pliers": "زردية, كماشة (أداة يدوية للإمساك بذراعين مفصليين وفكين (عادة) مسننين)",
 "pair of scissors": "مقص (أداة قاطعة ذات نصلين متقاطعين محوريين)",
 "pair of tongs": "كماشة, ملقط (أي من الأجهزة المختلفة للإمساك بالأشياء؛ عادة ما يكون لها ساقان مفصليتان بمقابض في الأعلى وخطافات مدببة في الأسفل)",
 "pair of trousers": "بنطال, سروال ((عادة بصيغة الجمع) رداء يمتد من الخصر إلى الركبة أو الكاحل، ويغطي كل ساق على حدة)\nمثال: كان لديه كسرة حادة في بنطاله",
 "pair of tweezers": "كماشة, ملقط (أداة يدوية للإمساك تتكون من رافعة مركبة للقبض)",
 "pair of virginals": "فيرجينال (هاربسيكورد مستطيل بدون أرجل؛ كان يعزف عليه (عادة النساء) في القرنين السادس عشر والسابع عشر)",
 "pair production": "إنتاج الزوج (تحول فوتون أشعة جاما إلى إلكترون وبوزيترون عندما يمر الفوتون بالقرب من نواة ذرية)",
 "paired": "مُزَاوَج (مُقترن لأغراض التكاثر) / مُتَقَارِن, مُزْدَوِج (يحدث في أزواج أو كزوج) / متقابل (للأوراق ونحوها؛ تنمو في أزواج على جانبي الساق)\nمثال: أوراق متقابلة",
 "pairing": "اقتران, مزاوجة (فعل تجميع الأشياء أو الأشخاص في أزواج) / اقتران, تزاوج (عملية اقتران الذكر والأنثى لأغراض التكاثر)\nمثال: الاقتران العرضي للمراهقين",
 "paisa": "بيزة, بيسة (وحدة نقدية كسرية في بنغلاديش والهند ونيبال وباكستان)",
 "paisley": "بيزلي (قماش صوفي ناعم بنمط ملون ملتوي من الأشكال المنحنية)",
 "paiute": "لغة بايوت (لغة شوشونية يتحدث بها شعب بايوت) / بايوت (فرد من أحد شعبي شوشوني (بايوت الشمالي وبايوت الجنوبي) مرتبط بالأزتيك ويعيش في جنوب غرب الولايات المتحدة)",
 "paiute language": "لغة بايوت (لغة شوشونية يتحدث بها شعب بايوت)",
 "paiwanic": "لغة بايونيك (لغة فورموزية يتحدث بها شعب بايون في تايوان)",
 "paiwanic language": "لغة بايونيك (لغة فورموزية يتحدث بها شعب بايون في تايوان)",
 "pajama": "بيجامة, منامة ((عادة جمع) ملابس نوم فضفاضة للنوم أو الاسترخاء؛ لها سترة علوية وسروال) / بنطال منامة, سروال بيجامة (زوج من السراويل الفضفاضة المربوطة بحبل حول الخصر؛ يرتديه الرجال والنساء في بعض الدول الآسيوية)",
 "pajamas": "مِنَامَةٌ, بِيجَامَا",
 "pak choi": "بوك تشوي, ملفوف صيني أبيض (نبات آسيوي يزرع لعنقوده من السيقان البيضاء الصالحة للأكل مع أوراق خضراء داكنة)",
 "pakchoi": "بوك تشوي, ملفوف صيني أبيض (نبات آسيوي يزرع لعنقوده من السيقان البيضاء الصالحة للأكل مع أوراق خضراء داكنة)",
 "pakistan": "بَاكِسْتَان, الْبَاكِسْتَان (دولة في وسط وغرب قارة آسيا؛ اسمها الرسمي جُمْهُورِيَّة بَاكِسْتَان الْإِسْلَامِيَّة، وعاصمتها إِسْلَام أَبَاد)\nمثال: درست في باكستان.",
 "pakistani": "بَاكِسْتَانِيّ",
 "pakistani monetary unit": "وحدة نقدية باكستانية (الوحدة النقدية في باكستان)",
 "pakistani rupee": "روبية, روبية باكستانية (وحدة المال الأساسية في باكستان؛ تساوي 100 بيزة)",
 "paktong": "خَارَصِين, تُوتِيَاء مَعْدِنِيّ",
 "pal": "رفيق, زميل (صديق مقرب يرافق رفاقه في أنشطتهم)",
 "palace": "قَصْر, بَلَاط (ضد الطول؛ غير تام، غير كامل)\nمثال: لقد قصر الخطاب.",
 "palace car": "عربة صالون (عربة ركاب للسفر النهاري؛ تدفع أجرة إضافية للكراسي الفردية)",
 "palace of westminster": "قَصْر وِسْتْمِنْسْتَر (ضد الطول؛ غير تام، غير كامل)\nمثال: لقد قصر الخطاب.",
 "paladin": "بَطَل, مُكافِح (شخص يقاتل من أجل قضية ما)",
 "palaeencephalon": "دماغ قديم (الأجزاء الأكثر بدائية من الدماغ فيلوجينياً؛ معظم التراكيب بخلاف القشرة المخية)",
 "palaemon australis": "قريدس طويل المخالب (قريدس مياه عذبة كبير (قدم أو أكثر) صالح للأكل شائع في الأنهار الأسترالية)",
 "palaeoanthropology": "أنثروبولوجيا قديمة, علم الحفريات البشرية (الدراسة العلمية للحفريات البشرية)",
 "palaeobiology": "بيولوجيا الحفريات (فرع من علم الأحياء القديمة يتعامل مع أصل ونمو وبنية الحيوانات والنباتات الأحفورية ككائنات حية)",
 "palaeobotany": "علم النباتات القديمة (دراسة النباتات الأحفورية)",
 "palaeoclimatology": "علم المناخ القديم (دراسة مناخ العصور الماضية)",
 "palaeodendrology": "علم الأشجار القديمة (فرع علم النباتات القديمة الذي يدرس الأشجار الأحفورية)",
 "palaeoecology": "بيئة قديمة (فرع علم البيئة الذي يدرس البيئة القديمة)",
 "palaeoethnography": "إثنوغرافيا قديمة (إثنوغرافيا بشر العصر الحجري القديم)",
 "palaeogeography": "جغرافيا قديمة (دراسة جغرافيا العصور القديمة أو الحقب القديمة)",
 "palaeogeology": "جيولوجيا قديمة (دراسة السمات الجيولوجية التي كانت ذات يوم على سطح الأرض ولكنها الآن مدفونة تحت الصخور)",
 "palaeolithic": "باليوليثي, حجري قديم (من أو متعلق بالفترة الثانية من العصر الحجري (تلي العصر الحجري الفجري))\nمثال: قطع أثرية من العصر الحجري القديم",
 "palaeology": "علم العاديات (دراسة الآثار القديمة (خاصة ما قبل التاريخ))",
 "palaeontological": "أحفوري, متعلق بعلم الأحافير (مكون من أو متعلق بعلم الأحافير (الباليونتولوجيا))",
 "palaeontologist": "عالم حفريات, عالم مستحاثات (متخصص في علم الحفريات)",
 "palaeontology": "بليونتولوجيا, علم الأحافير (علم الأرض الذي يدرس الكائنات الحية الأحفورية والبقايا ذات الصلة)",
 "palaeopathology": "علم الأمراض القديمة (دراسة أمراض العصور السابقة (المستنتجة من الأدلة الأحفورية))",
 "palaeornithology": "علم الطيور القديمة (علم الأحياء القديمة للطيور)",
 "palaeozoology": "علم الحيوانات القديمة (دراسة الحيوانات الأحفورية)",
 "palaestra": "باليسترا (مكان عام في اليونان القديمة أو روما مخصص لتدريب المصارعين والرياضيين الآخرين)",
 "palaetiology": "علم الأسباب القديمة (تفسير الأحداث الماضية من حيث الأسباب العلمية (كالأسباب الجيولوجية))",
 "palaic": "البالايية (لغة أناضولية كان يتم التحدث بها في شمال غرب تركيا الحالية)",
 "palaic language": "البالايية (لغة أناضولية كان يتم التحدث بها في شمال غرب تركيا الحالية)",
 "palankeen": "محفّة مغلقة, هودج (محفّة مغلقة تُحمل على أكتاف أربعة حمالين)",
 "palanquin": "حَمَّالَة, مِحَفَّة",
 "palaquium gutta": "شجرة جوتا بيرشا (واحدة من عدة أشجار في جزر الهند الشرقية تنتج جوتا بيرشا)",
 "palas": "بلاش, شجرة اللهب (شجرة من شرق الهند تحمل غزارة من الزهور القرمزية المخملية الكثيفة وتنتج صبغة صفراء)",
 "palatability": "اسْتِسَاغَة (القبول لدى العقل أو المشاعر) / استساغة, قبول الطعم (خاصية كون الشيء مقبولاً للفم)\nمثال: السعي وراء القبول الانتخابي",
 "palatable": "لذيذ, مستساغ (مقبول للطعم أو للعقل)\nمثال: طعام مستساغ",
 "palatableness": "اسْتِسَاغَة (القبول لدى العقل أو المشاعر) / استساغة, قبول الطعم (خاصية كون الشيء مقبولاً للفم)\nمثال: السعي وراء القبول الانتخابي",
 "palatably": "بشكل مستساغ, بشكل مقبول (بطريقة مستساغة)",
 "palatal": "غَارِيّ",
 "palatalised": "غارِيّ, مُرَقَّق ((في الصَّوْتِيّات) يُنْطَق بِرَفْع وَسَط اللِّسان نَحْو الغار)",
 "palatalized": "غارِيّ, مُرَقَّق ((في الصَّوْتِيّات) يُنْطَق بِرَفْع وَسَط اللِّسان نَحْو الغار)",
 "palate": "حَنَك ((حَنَكَت) الْأُم الصَّبِي حنكا: دلكت حنكه؛ (حَنَكَ) فُلَان الدَّابَّة: جعل الرسن فِي فمها)",
 "palatial": "فَخْم كَالقَصْر, قَصْرِيّ (يُناسب القُصور أو يُشبهها في الفخامة) / فخم, قصري (متعلق بـ أو كونه قصراً)\nمثال: الإقامة القصرية",
 "palatinate": "كونتية بلاطية (إقليم خاضع لولاية كونت بلاطي)",
 "palatinate forest": "غَابَة بَلاتِنَة, غَابَة بْفَلْتْس (الغَابَةُ: الأَجَمَةُ ذاتُ الشَّجَرِ المُتَكَاثِف؛ لأَنَّها تُغَيِّبُ مَا فِيهَا. أو الأَجَمَةُ الَّتِي طالتْ، وَلَهَا أَطْراف مُرْتَفِعَةٌ باسِقَة؛ الغابةُ أَجَمة القَصَب، قَالَ: وَقَدْ جُعِلَتْ جماعةَ الشَّجَرِ، لأَنه مأْخوذ مِنَ الغَيابةِ)\nمثال: مشينا في الغابة",
 "palatine": "بلاطي, قصري (متعلق بالقصر) / بلاتيني, بلاطي (متعلق بالكونت البلاتيني والامتيازات الملكية للبلاتين) / حنكي (يتعلق بالحنك أو يقع بالقرب منه) / عظم حنكي (أي من عظمين غير منتظمي الشكل يشكلان مؤخرة الحنك الصلب ويساعدان في تكوين التجويف الأنفي وأرضية محاجر العين)\nمثال: مؤشر حنكي",
 "palatine artery": "شريان حنكي (واحد من عدة شرايين تغذي الوجه)",
 "palatine bone": "عظم حنكي (أي من عظمين غير منتظمي الشكل يشكلان مؤخرة الحنك الصلب ويساعدان في تكوين التجويف الأنفي وأرضية محاجر العين)",
 "palatine raphe": "الرفاء الحنكي (الدرز الموجود في منتصف الحنك الصلب)",
 "palatine tonsil": "لوزة, لوزة حنكية (إحدى كتلتين من النسيج اللمفاوي تقعان على جانبي البلعوم الفموي)",
 "palatine vein": "وريد حنكي (وريد يصرف منطقة الحنك ويصب في الوريد الوجهي)",
 "palatoglossal": "حنكي لساني (متعلق بالحنك واللسان)",
 "palatopharyngoplasty": "رأب الحنك والبلعوم (استئصال جراحي للأنسجة الحنكية والبلعومية غير الضرورية لفتح مجرى الهواء؛ يهدف لعلاج الحالات الشديدة من الشخير (مع أو بدون توقف التنفس أثناء النوم))",
 "palau": "بَالَاو",
 "palaver": "خِطَابَة جَوْفَاء, كَلَام مُنَمَّق (كلام صاخب ومشوش وفارغ) / مداهنة, ملاطفة (تملق يهدف إلى الإقناع)\nمثال: مجرد خطاب منمق",
 "palawan": "بَلَاوَن, بَالَاوَان",
 "pale": "بَاهِت, شَاحِب / لَوْح / تَخْم, حَدّ",
 "pale ale": "بيل إيل, جعة شاحبة (جعة ذات لون كهرماني مخمرة مع شعير شاحب؛ تشبه الجعة المُرة لكنها أكثر جفافاً وأخف)",
 "pale blue": "أَزْرَق فَاتِح (بدرجة فاتحة من الأزرق)",
 "pale chrysanthemum aphid": "من الأقحوان الشاحب (آفة مهمة للأقحوان)",
 "pale coral root": "جذر المرجان المبكر (نبات له كتل من السيقان الصفراء الشاحبة إلى المخضرة عديمة الأوراق تقريباً تحمل زهوراً ملونة بالمثل بشفاه سفلية بيضاء؛ شمال نيو مكسيكو شمالاً عبر…)",
 "pale violet": "بنفسج شاحب (بنفسج مورق الساق من شرق أمريكا الشمالية له زهور بيضاء كبيرة أو كريمية معلمة بشكل خافت بالأرجواني)",
 "pale yellow": "أصفر شاحب, تِبنِي (صبغة صفراء متغيرة؛ أصفر باهت، غالباً ما يكون مخففاً بالأبيض)",
 "pale-colored": "بَاهِت, شَاحِب اللَّوْن (ذو لون شاحب أو باهت)",
 "pale-faced": "شَاحِب الوَجْه (ذو وجه شاحب)",
 "pale-hued": "بَاهِت, شَاحِب اللَّوْن (ذو لون شاحب أو باهت)",
 "paleacrita vernata": "عثة دودة القياس الربيعية (عثة يرقاتها هي ديدان القياس الربيعية)",
 "palearctic": "مِنْطَقَة قُطْبِيَّة شَمَالِيَّة قَدِيمَة (المِنْطَقةُ: المَنْطِقَةُ؛ مِنْطَقَةُ: مُقَاطَعَةٌ)\nمثال: غزة منطقة مكشوفة.",
 "paleencephalon": "دماغ قديم (الأجزاء الأكثر بدائية من الدماغ فيلوجينياً؛ معظم التراكيب بخلاف القشرة المخية)",
 "paleface": "ذو الوجه الشاحب ((عامية) مصطلح مهين لشخص أبيض (يفترض أن هنود أمريكا الشمالية استخدموه))",
 "palely": "بجمود, بشحوب (بطريقة باهتة؛ دون لون جسدي أو عاطفي) / بشحوب, بضعف (بطريقة تفتقر إلى الاهتمام أو الحيوية)\nمثال: زوجته، الجذابة دائماً بشحوب",
 "paleness": "شحوب (الافتقار إلى اللون) / بياض البشرة, شقرة (خاصية التمتع ببشرة فاتحة بشكل طبيعي) / امتقاع, شحوب (نقص غير طبيعي في لون الجلد (بسبب كدمات أو مرض أو ضائقة عاطفية))",
 "paleo-american": "أمريكي قديم, أمريكي من العصر الحجري القديم (فرد من الشعوب الأمريكية القديمة التي كانت أول سكان بشريين لأمريكا الشمالية والجنوبية خلال أواخر العصر البليستوسيني)",
 "paleo-american culture": "ثقافة الأمريكيين القدماء, ثقافة الهنود القدماء (ثقافة ما قبل التاريخ لأقدم السكان البشريين لأمريكا الشمالية وأمريكا الجنوبية)",
 "paleo-amerind": "أمريكي قديم, أمريكي من العصر الحجري القديم (فرد من الشعوب الأمريكية القديمة التي كانت أول سكان بشريين لأمريكا الشمالية والجنوبية خلال أواخر العصر البليستوسيني)",
 "paleo-amerind culture": "ثقافة الأمريكيين القدماء, ثقافة الهنود القدماء (ثقافة ما قبل التاريخ لأقدم السكان البشريين لأمريكا الشمالية وأمريكا الجنوبية)",
 "paleo-indian": "أمريكي قديم, أمريكي من العصر الحجري القديم (فرد من الشعوب الأمريكية القديمة التي كانت أول سكان بشريين لأمريكا الشمالية والجنوبية خلال أواخر العصر البليستوسيني)",
 "paleo-indian culture": "ثقافة الأمريكيين القدماء, ثقافة الهنود القدماء (ثقافة ما قبل التاريخ لأقدم السكان البشريين لأمريكا الشمالية وأمريكا الجنوبية)",
 "paleoanthropological": "باليوأنثروبولوجي, متعلق بأسلاف البشر (معني بالدراسة العلمية للأحافير البشرية)",
 "paleoanthropology": "أنثروبولوجيا قديمة, علم الحفريات البشرية (الدراسة العلمية للحفريات البشرية)",
 "paleobiology": "بيولوجيا الحفريات (فرع من علم الأحياء القديمة يتعامل مع أصل ونمو وبنية الحيوانات والنباتات الأحفورية ككائنات حية)",
 "paleobotany": "علم النباتات القديمة (دراسة النباتات الأحفورية)",
 "paleocerebellum": "مخيخ قديم (الفص الأمامي للمخيخ الذي كان أحد أقدم أجزاء الدماغ الخلفي تطوراً في الثدييات)",
 "paleoclimatology": "علم المناخ القديم (دراسة مناخ العصور الماضية)",
 "paleocontact hypothesis": "فرضية رواد الفضاء القدماء (فرضية علمية زائفة تفترض أن كائنات ذكية من خارج الأرض قد زارت الأرض واتصلت بالبشر في العصور القديمة وما قبل التاريخ)",
 "paleocortex": "قشرة عتيقة (القشرة الشمية للمخ)",
 "paleocortical": "قشري قديم",
 "paleodendrology": "علم الأشجار القديمة (فرع علم النباتات القديمة الذي يدرس الأشجار الأحفورية)",
 "paleoecology": "بيئة قديمة (فرع علم البيئة الذي يدرس البيئة القديمة)",
 "paleoencephalon": "دماغ قديم (الأجزاء الأكثر بدائية من الدماغ فيلوجينياً؛ معظم التراكيب بخلاف القشرة المخية)",
 "paleoethnography": "إثنوغرافيا قديمة (إثنوغرافيا بشر العصر الحجري القديم)",
 "paleogeography": "جغرافيا قديمة (دراسة جغرافيا العصور القديمة أو الحقب القديمة)",
 "paleogeology": "جيولوجيا قديمة (دراسة السمات الجيولوجية التي كانت ذات يوم على سطح الأرض ولكنها الآن مدفونة تحت الصخور)",
 "paleographer": "باليوغرافي, خبير خطوط قديمة (عالم آثار ماهر في علم الخطاطة القديمة)",
 "paleographist": "باليوغرافي, خبير خطوط قديمة (عالم آثار ماهر في علم الخطاطة القديمة)",
 "paleography": "عِلْم الكِتَابَات القَدِيمَة (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "paleolith": "أداة باليوليثية, أداة من العصر الحجري القديم (أداة حجرية من العصر الحجري القديم)",
 "paleolithic": "باليوليثي, حجري قديم (من أو متعلق بالفترة الثانية من العصر الحجري (تلي العصر الحجري الفجري))\nمثال: قطع أثرية من العصر الحجري القديم",
 "paleology": "علم العاديات (دراسة الآثار القديمة (خاصة ما قبل التاريخ))",
 "paleomammalogy": "علم الثدييات القديمة (علم الأحياء القديمة للثدييات)",
 "paleontological": "أحفوري, متعلق بعلم الأحافير (مكون من أو متعلق بعلم الأحافير (الباليونتولوجيا))",
 "paleontologist": "عالم حفريات, عالم مستحاثات (متخصص في علم الحفريات)",
 "paleontology": "بليونتولوجيا, علم الأحافير (علم الأرض الذي يدرس الكائنات الحية الأحفورية والبقايا ذات الصلة)",
 "paleopathology": "علم الأمراض القديمة (دراسة أمراض العصور السابقة (المستنتجة من الأدلة الأحفورية))",
 "paleornithology": "علم الطيور القديمة (علم الأحياء القديمة للطيور)",
 "paleostriatum": "الكرة الشاحبة, شاحبة (الجزء الداخلي الأصفر الشاحب من النواة العدسية)",
 "paleozoic": "بليوزوي (من أو يتعلق بحقبة الحياة القديمة (الباليوزوي))",
 "paleozoology": "علم الحيوانات القديمة (دراسة الحيوانات الأحفورية)",
 "palermo": "بَالِيرْمُو",
 "palestine": "فِلَسْطِين (دَوْلَةُ فِلَسْطِين: مِنَ الْبُلْدَانِ الْعَرَبِيَّةِ بِالشَّرْقِ الأَوْسَطِ، عَاصِمَتُهَا الْقُدْسُ (مُحتَلَةٌ/ مُتَنَازَعٌ عَلَيْهَا)؛ مِنْطَقَةُ فِلَسْطِين: كُورَةٌ بالشّامِ، والْمَعْرُوفَةُ فيما بين الأُرْدُنّ وديار مِصْرَ، وأُمُّ بِلَادِهَا بيتُ المَقْدِسِ. وهي من أجناد الشام)\nمثال: الحرية لفلسطين.",
 "palestine liberation organization": "منظمة التحرير الفلسطينية (حركة سياسية توحد العرب الفلسطينيين في محاولة لإنشاء دولة فلسطين المستقلة؛ عند تشكيلها عام 1964 كانت منظمة تهيمن عليها حركة فتح بقيادة ياسر عرفات؛ في…)",
 "palestinian": "فِلَسْطِينِيّ, فِلَسْطِيّ",
 "palestinian arab": "عربي فلسطيني, فلسطيني (سليل العرب الذين سكنوا فلسطين)",
 "palestinian arabic": "لَهْجَات فِلَسْطِنِيَّة",
 "palestra": "باليسترا (مكان عام في اليونان القديمة أو روما مخصص لتدريب المصارعين والرياضيين الآخرين)",
 "paletiology": "علم الأسباب القديمة (تفسير الأحداث الماضية من حيث الأسباب العلمية (كالأسباب الجيولوجية))",
 "palette": "باليتة, لوحة ألوان (لوح يوفر سطحاً مستوياً يخلط عليه الفنانون الطلاء ومجموعة الألوان المستخدمة) / واقي الإبط (واحدة من الصفائح الدرعية المستديرة عند الإبطين في بدلة الدرع) / لوحة ألوان (نطاق الألوان المميز لفنان معين أو لوحة أو مدرسة فنية)",
 "palette knife": "سكين الرسم, سكين لوحة الألوان (ملعقة مسطحة يستخدمها الفنانون لخلط أو تطبيق أو كشط الدهانات الزيتية)",
 "palfrey": "برذون (حصان ركوب خفيف خاصة للمرأة)",
 "pali": "لغة بالي (لغة براكريتية قديمة (مشتقة من السنسكريتية) وهي اللغة الكتابية والطقسية لبوذية التيرافادا)",
 "pali language": "لغة بالي (لغة براكريتية قديمة (مشتقة من السنسكريتية) وهي اللغة الكتابية والطقسية لبوذية التيرافادا)",
 "palilalia": "تكرار الكلام اللاإرادي (حالة مرضية يتم فيها تكرار الكلمة بسرعة وبشكل لا إرادي)",
 "palimony": "نفقة الشريك (دعم يدفعه أحد طرفي شراكة غير زوجية بعد انتهاء العلاقة)",
 "palimpsest": "طِرْس (مَحَا أو أَزَالَ الكتابة من شيء؛ كَتَبَ فوق شيء ممحو أو مطموس)",
 "palindrome": "قَلْب مُسْتَوٍ",
 "paling": "سياج وتدي (سياج مصنوع من أوتاد عمودية)",
 "palingenesis": "استعادة, تجدد (ظهور خصائص أو هياكل مختلفة أثناء التطور الجنيني كانت قد ظهرت خلال التاريخ التطوري للسلالة أو النوع)",
 "palingenetic": "انبعاثي, تجددي (من أو متعلق بالتجدد أو الانبعاث)",
 "palisade": "سياج تحصيني (تحصين يتكون من سياج قوي مصنوع من أوتاد مدفونة في الأرض)",
 "palish": "مَائِل إِلَى الشُّحُوب (شاحب نوعاً ما؛ يميل إلى البهتان)",
 "paliurus spina-christi": "باليورس, شوك المسيح (شجيرة أوراسية شائكة بثمار مجنحة خشبية جافة)",
 "pall": "ستارة, سِتر (قماش معلق يستخدم كحاجز (خاصة للنافذة)) / كفن (رداء الدفن الذي تُلف فيه الجثة) / انقباض, وجوم (رهبة مفاجئة تسبب الشلل)",
 "pall-mall": "الكرة والمضرب, بال-مال (لعبة من القرن السابع عشر؛ كانت تُضرب فيها كرة خشبية بمطرقة على طول ممر)",
 "palladian": "بالادي (يشير إلى أو يتعلق بـ أو يمتلك نمط العمارة الذي ابتكره أندريا بالاديو)\nمثال: تراكيب القوس والعمود المقلدة كثيرًا والمعروفة باسم الزخرفة البالادية",
 "palladianism": "البالادية, العمارة البالادية (طراز معماري يستند إلى كتابات ومباني المعماري والمنظر الإنساني أندريا بالاديو من فيتشنزا)\nمثال: كان ريتشارد بويل، إيرل بيرلينجتون الثالث، مهندسًا معماريًا ومروجًا متحمسًا للبالادية وكان مؤثرًا في ترسيخها كنمط وطني جديد",
 "palladium": "بَلَادِيُوم, بَالَادِيُوم",
 "pallas": "بَالَاس",
 "pallas's cat": "قط بالاس, مانول (قط بري صغير يعيش في جبال سيبيريا والتبت ومنغوليا)",
 "pallas's sandgrouse": "قطا بالاس (قطا أوراسي ذو رقعة سوداء على البطن)",
 "pallasite": "بَالَاسِيت (حجر نيزكي يتكون أساساً من الزبرجد الزيتوني والحديد المعدني)",
 "pallbearer": "حامِل النَّعْش (أحد المشيعين الذين يحملون النعش في الجنازة)",
 "pallet": "باليتة, لوحة ألوان (لوح يوفر سطحاً مستوياً يخلط عليه الفنانون الطلاء ومجموعة الألوان المستخدمة) / فرشة بسيطة, مفرش نوم (مرتبة مملوءة بالقش أو وسادة مصنوعة من الألحفة؛ تستخدم كسرير) / أداة تشكيل الفخار, لوح الخزّاف (أداة يدوية ذات شفرة مسطحة يستخدمها الخزافون لخلط وتشكيل الطين) / طبلية, منصة نقالة (منصة محمولة لتخزين أو نقل البضائع المكدسة عليها)",
 "pallette": "واقي الإبط (واحدة من الصفائح الدرعية المستديرة عند الإبطين في بدلة الدرع)",
 "palliasse": "فرشة قش (مرتبة تتكون من وسادة رقيقة مملوءة بالقش أو نشارة الخشب)",
 "palliation": "تخفيف, تلطيف (التصرف بطريقة تجعل الجريمة تبدو أقل خطورة) / تسكين (تخفيف حدة الألم أو المرض دون إزالة السبب)",
 "palliative": "مُلَطِّف, مُخَفِّف",
 "palliative care": "رِعَايَة تَلْطِيفِيَّة",
 "pallid": "بَاهِت, ذَابِل (خفيف اللون وضعيفه؛ يفتقر إلى الحيويّة) / بَاهِت, شَاحِب (ذو لون خفيف وضعيف يفتقر إلى العمق) / خَافِت, شَاحِب ((للضوء) ضعيف الشدة أو السطوع؛ خافت وباهت)",
 "pallid bat": "خفاش الكهف, خفاش شاحب (خفاش كبير الأذن مصفر باهت يعيش في الكهوف)",
 "pallidity": "شحوب (الافتقار إلى اللون)",
 "pallidly": "بشحوب, بضعف (بطريقة تفتقر إلى الاهتمام أو الحيوية)\nمثال: عرض مسلٍ بشحوب",
 "pallidness": "امتقاع, شحوب (نقص غير طبيعي في لون الجلد (بسبب كدمات أو مرض أو ضائقة عاطفية))",
 "pallidum": "الكرة الشاحبة, شاحبة (الجزء الداخلي الأصفر الشاحب من النواة العدسية)",
 "pallium": "باليوم, رداء روماني (عباءة أو رداء ارتداه الرجال في روما القديمة) / باليوم ((الكنيسة الكاثوليكية) رداء يتكون من شريط يحيط بالكتفين مع طرفين يتدليان من الأمام والخلف) / عباءة, غشاء ((علم الحيوان) طبقة واقية من البشرة في الرخويات أو عضديات الأرجل تفرز مادة تشكل الصدفة) / قشرة مخية (طبقة الخلايا العصبية غير الميالينية (المادة الرمادية) التي تشكل قشرة المخ)",
 "pallone": "بالوني (لعبة إيطالية تشبه التنس)",
 "pallor": "امتقاع, شحوب (نقص غير طبيعي في لون الجلد (بسبب كدمات أو مرض أو ضائقة عاطفية))",
 "pally": "حَمِيم, صَدِيق حَمِيم ((غَيْر رَسْمِيّ) لَهُ عَلَاقَة صَدَاقَة أَوْ رِفَاقَة)",
 "palm": "رَاحَة, كَفّ",
 "palm cat": "زباد النخيل, قط النخيل (زباد شجري مرقط أو مخطط من جنوب شرق آسيا وجزر الهند الشرقية)",
 "palm civet": "زباد النخيل, قط النخيل (زباد شجري مرقط أو مخطط من جنوب شرق آسيا وجزر الهند الشرقية)",
 "palm kernel": "جوز النخيل (بذرة أي نخيل زيت)",
 "palm nut": "جوز النخيل (بذرة أي نخيل زيت)",
 "palm oil": "زَيْت النَّخْلِ (ما يعصر من الزَيْتُون؛ كل سائل لزج يستخرد من النبات يستخدم كما يستخدم السمن)\nمثال: خبأن ذلك الزيت.",
 "palm reading": "قراءة الكف (قراءة البخت عن طريق الخطوط الموجودة على راحة اليد)",
 "palm sunday": "أحد الشعانين (الأحد الذي يسبق عيد الفصح)",
 "palm tree": "نَخْلَة",
 "palm wine": "لاقبي",
 "palm-shaped": "رَاحِيّ, كَفِّيّ ((عن شكل الورقة) ذو وريقات أو فُصوص تتشعَّب من نقطة مُشتركة)",
 "palma christ": "خروع, نبات الخروع (شجيرة كبيرة من إفريقيا الاستوائية وآسيا لها أوراق كفية كبيرة وكبسولات شائكة تحتوي على بذور هي مصدر زيت الخروع والريسين؛ تم توطينها على نطاق واسع في…)",
 "palma christi": "خروع, نبات الخروع (شجيرة كبيرة من إفريقيا الاستوائية وآسيا لها أوراق كفية كبيرة وكبسولات شائكة تحتوي على بذور هي مصدر زيت الخروع والريسين؛ تم توطينها على نطاق واسع في…)",
 "palmar": "راحي (متعلق براحة اليد أو باطن القدم)\nمثال: السطح الراحي",
 "palmate": "رَاحِيّ, كَفِّيّ ((عن شكل الورقة) ذو وريقات أو فُصوص تتشعَّب من نقطة مُشتركة) / رَاحِيّ, كَفِّيّ ((لِأَقْدَامِ الطُّيُورِ المَائِيَّةِ) لَهَا ثَلَاثُ أَصَابِعَ مُتَّصِلَةٌ بِطَيَّةٍ جِلْدِيَّةٍ رَقِيقَةٍ)",
 "palmate leaf": "ورقة راحية (ورقة تشبه اليد المفتوحة؛ لها فصوص تشع من نقطة مشتركة)",
 "palmately": "بشكل راحي (بطريقة راحية (تشبه راحة اليد))\nمثال: مشقوق بشكل راحي",
 "palmately-lobed": "رَاحِيّ الفُصُوص (ذو فصوص تشع من نقطة مركزية كأصابع اليد)",
 "palmatifid": "كَفِّيّ التَّفْصِيص ((عن شكل الورقة) مشقوق كفِّيًّا بدلاً من مُفصَّص)",
 "palmature": "التصاق الأصابع (شذوذ تكون فيه الأصابع ملتصقة)",
 "palmetto": "بالميتو, نخيل مروحي (أي من عدة أنواع من النخيل منخفض النمو ذو أوراق مروحية الشكل)",
 "palmier": "بالميي",
 "palmist": "قاريء الكف (عراف يتنبأ بمستقبلك من خلال الخطوط الموجودة على راحة يدك)",
 "palmister": "قاريء الكف (عراف يتنبأ بمستقبلك من خلال الخطوط الموجودة على راحة يدك)",
 "palmistry": "قِراءَةُ الْكَفّ",
 "palmitic acid": "حمض البالمتيك (حمض دهني مشبع يُعد الدهن الرئيسي في اللحوم ومنتجات الألبان)",
 "palmitin": "بالميتين (إستر من الجلسرين وحمض البالمتيك)",
 "palmlike": "شَبِيهٌ بِالنَّخْل, نَخْلِيّ (يُشْبِهُ شَجَرَةَ النَّخْل)",
 "palmy": "رَائِج, مُزْدَهِر (حيوي ومربح للغاية؛ في حالة ازدهار ونمو)",
 "palmyra": "تُدْمُر, تَدْمُر",
 "palmyra palm": "دوم, نخلة تدمر (نخيل مروحي طويل من أفريقيا والهند وماليزيا ينتج خشباً صلباً وعصارة حلوة تعد مصدراً لنبيذ النخيل والسكر؛ وتستخدم الأوراق للتسقيف والنسيج)",
 "palo santo": "بالو سانتو, خشب مقدس (شجرة أمريكية جنوبية في المناطق الداخلية الجافة من الأرجنتين وباراغواي ذات خشب قلب راتنجي يستخدم للبخور)",
 "palo verde": "بالو فيردي (شجرة شائكة كثيفة التفرع من جنوب غرب الولايات المتحدة ذات أزهار صفراء مبهرجة ولحاء أزرق مخضر؛ تصنف أحياناً في جنس سيرسيديوم)",
 "palometa": "بالوميتا, بومبانو كاليفورنيا (أصغر من بومبانو فلوريدا؛ شائعة في جزر الهند الغربية)",
 "palometa simillima": "بالوميتا, بومبانو كاليفورنيا (أصغر من بومبانو فلوريدا؛ شائعة في جزر الهند الغربية)",
 "palomino": "بالومينو (حصان لونه أسمر فاتح أو ذهبي مع عرف وذيل بلون الكريم أو الأبيض)",
 "palooka": "ملاكم فاشل (ملاكم محترف من الدرجة الثانية)",
 "paloverde": "بالوفيردي (شجيرة شائكة من جنس سيرسيديوم تنمو في الأجزاء الجافة من جنوب غرب الولايات المتحدة والمكسيك المجاورة؛ لها لحاء أخضر فاتح ناعم وعناقيد من الزهور الصفراء…)",
 "palpability": "مَلْمُوسِيَّة (صفة القابلية للإدراك باللمس)",
 "palpable": "مَحْسُوس, مَلْمُوس (شَدِيدٌ لِدَرَجَةٍ يَكَادُ يُلْمَسُ أَوْ يُحَسُّ بِه) / بَيِّن, جَلِيّ (مكشوف بوضوح للعقل أو الحواسّ أو الحكم) / محسوس, ملموس (يمكن إدراكه؛ وبشكل خاص يمكن لمسه أو التعامل معه أو الإحساس به) / مَحْسُوسٌ بِالجَسّ ((فِي الطِّبّ) يُمْكِنُ الشُّعُورُ بِهِ عَنْ طَرِيقِ الجَسّ)\nمثال: غبار بالكاد محسوس",
 "palpably": "بشكل ملموس, بوضوح (بحيث يكون ملموساً)\nمثال: كانت متوترة بشكل ملموس",
 "palpation": "جس (طريقة للفحص يشعر فيها الفاحص بحجم أو شكل أو صلابة أو موقع شيء ما (أو أجزاء الجسم عندما يكون الفاحص محترفاً صحياً))",
 "palpatory": "جسي (متعلق بـ أو يتضمن الجس (الفحص باللمس))",
 "palpebra": "جفن (إحدى طيتين من الجلد يمكن تحريكهما لتغطية العين أو فتحها)",
 "palpebra conjunctiva": "ملتحمة جفنية (جزء الملتحمة الذي يبطن السطح الخلفي للجفون؛ يتصل بالملتحمة البصلية)",
 "palpebrate": "ذو جفون (يمتلك جفوناً)",
 "palpebration": "رفيف الجفن (رمش متكرر (خاصة إذا كان غير منضبط ومستمر))",
 "palpitant": "خَافِق, نَابِض (يتحرك بارتعاش طفيف وسريع)",
 "palpitating": "خَافِق, نَابِض (يتحرك بارتعاش طفيف وسريع)",
 "palpitation": "خَفَقَان",
 "palsgrave": "كونت بلاط ((العصور الوسطى) سيد بلاط يمارس سلطات سيادية على أراضيه)",
 "palsied": "مُصَاب بِالشَّلَل الرِّعَاشِيّ (مصاب بالفالج أو برعشة لا يمكن السيطرة عليها)",
 "palsy": "شَلَل, كَسَح",
 "palsy-walsy": "حَمِيم, صَدِيق حَمِيم ((غَيْر رَسْمِيّ) لَهُ عَلَاقَة صَدَاقَة أَوْ رِفَاقَة)",
 "paltering": "كذبة بيضاء, مراوغة (فعل بسيط من الكذب أو عدم الوضوح المتعمد)",
 "paltriness": "بَخْس, تَفَاهَة (انعدام القيمة بسبب الضآلة)",
 "paltry": "بَخْس (بَخَسَ؛ بَخِسَ)\nمثال: بيع المنزل بثمن بخس.",
 "pamelor": "باميلور, نورتريبتيلين (دواء مضاد للاكتئاب ثلاثي الحلقات (الاسم التجاري باميلور) يستخدم مع العلاج النفسي لعلاج الاكتئاب الجزئي؛ قد يتفاعل بشكل خطير إذا تم تناوله مع أدوية…)",
 "pamlico": "لغة بامليكو (لغة ألغونكوية خاصة بشعب بامليكو) / بامليكو (فرد من شعب ألغونكي كان يعيش سابقاً في وادي نهر بامليكو في كارولينا الشمالية)",
 "pamlico language": "لغة بامليكو (لغة ألغونكوية خاصة بشعب بامليكو)",
 "pampas grass": "عشب البامباس (عشب معمر طويل من بامباس أمريكا الجنوبية له ريش فضي وينمو في كتل كثيفة كبيرة)",
 "pamper": "دَلَّلَ, دَلَّعَ (دلل: أَدَلَّ عَلَيْهِ وتَدَلَّلَ: انْبَسَطَ؛ قالَ ابْنُ دُرَيْدٍ: أَدَلَّ عَلَيْهِ وَثِق بِمَحَبَّتِهِ فأَفْرَط عَلَيْهِ)\nمثال: دلل سامي صديقته.",
 "pamperer": "مُدَلِّل (شخص يدلل أو يفسد بالتدليل المفرط)",
 "pampering": "انغماس, تدليل (فعل الانغماس أو إشباع رغبة)",
 "pamphlet": "مَنْشُور, كُرَّاسَة",
 "pamphleteer": "كاتب كراسات, كاتب منشورات (كاتب للمنشورات أو الكراسات (يتخذ عادة موقفاً حزبياً حول القضايا العامة))",
 "pampiniform": "مِحْلَاقِيّ",
 "pamplona": "بَنْبِلُونَة",
 "pan": "مِقْلَاة (وعاء قلي الطعام) / ينتقد بشدَة",
 "pan american day": "14 أبريل, يوم البلدان الأمريكية (يوم للاحتفال بالوحدة السياسية والاقتصادية بين الدول الأمريكية)",
 "pan american union": "اتحاد عموم أمريكا (الوكالة الإدارية لمنظمة الدول الأمريكية)",
 "pan gravy": "عصارة اللحم, مرق اللحم (العصائر المتبلة غير المكثفة التي تقطر من طهي اللحوم؛ يضاف إليها القليل من الماء غالباً)",
 "pan paniscus": "بونوبو, شمبانزي قزم (شمبانزي صغير يعيش في غابات المستنقعات في زائير؛ نوع مهدد بالانقراض)",
 "pan troglodytes": "شمبانزي (قرد ذكي يعيش جزئياً على الأشجار في الغابات الاستوائية الأفريقية)",
 "pan troglodytes schweinfurthii": "شمبانزي شرقي (شمبانزي طويل الشعر في شرق وسط أفريقيا؛ يرتبط ارتباطاً وثيقاً بالشمبانزي المركزي)",
 "pan troglodytes troglodytes": "شمبانزي مركزي (شمبانزي أسود الوجه في وسط أفريقيا؛ يرتبط ارتباطاً وثيقاً بالشمبانزي الشرقي)",
 "pan troglodytes verus": "شمبانزي غربي (شمبانزي مقنع أو شاحب الوجه في غرب أفريقيا؛ يرتبط بصلة بعيدة بالشمبانزي الشرقي والمركزي؛ ربما يكون نوعاً منفصلاً)",
 "pan-arabism": "وَحْدَة عَرَبِيَّة",
 "pan-europeanism": "جامعة أوروبية (اعتقاد معياري بشكل ما من أشكال الكيان الجيوسياسي أو الثقافي أو العرقي الأوروبي)",
 "pan-germanism": "جامعة جرمانية (حركة كان هدفها التوحيد السياسي لجميع الشعوب التي تتحدث الألمانية أو اللغات الجرمانية)",
 "pan-hellenic": "بان-هيليني, جامع للهيلينيين (من أو يتعلق بجميع اليونانيين)\nمثال: الألعاب الأولمبية كانت احتفالاً جامعاً للهيلينيين",
 "pan-slavism": "قَوْمِيَّة سِلَافِيَّة (ما يجمع أمة ذات تاريخ وأمانٍ مشتركة)\nمثال: اللغة اليابانية لغتي القومية.",
 "pan-turkism": "قَوْمِيَّة تُرْكِيَّة (ما يجمع أمة ذات تاريخ وأمانٍ مشتركة)\nمثال: اللغة اليابانية لغتي القومية.",
 "panacea": "تِرْيَاق (دواء مركب يدفع السموم؛ ما يضاد عمل السمّ)",
 "panache": "سُلطان الريش (ريش زينة على خوذة) / أُسْلُوب مُمَيَّز, تَأَلُّق (أناقة مميزة وعصرية)",
 "panadol": "أسيتامينوفين, باراسيتامول (مسكن للألم الخفيف ولكن ليس للالتهابات؛ يستخدم أيضاً كخافض للحرارة (تايلينول وبانادول وغيرها هي علامات تجارية لأقراص الأسيتامينوفين))",
 "panaitan": "بانايتان",
 "panama": "بَنَمَا",
 "panama canal": "قَنَاة بَنَمَا",
 "panama city": "مدينة بنما",
