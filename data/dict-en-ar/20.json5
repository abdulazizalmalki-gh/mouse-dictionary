 "pensionary": "أجير, مرتزق (شخص يعمل فقط من أجل المال) / صاحب معاش (المستفيد من صندوق المعاشات التقاعدية)",
 "pensioner": "مُتَقَاعِد",
 "pensive": "مُفَكِّر, مُتَأَمِّل (اسم فاعل للفعل فَكَّرَ؛ اصطلاحا: هو شَخْص له عِلْم وفِكْر ودراية يعتد بها وقادر على التَنْظِير والتَحْلِيل، غالبا ما يؤخذ رأيه في أمور العامة وغالبا ما يؤلف كتبا)\nمثال: \"مفكرة الموت\" هو واحد من أفضل عشرة مسلسلات تلفزيونية عندي.",
 "pensively": "باستغراق, بتأمل (بطريقة تأملية وحزينة أحياناً)\nمثال: حدق بتأمل في اللوحة",
 "pensiveness": "استغراق في التفكير, تأمل (تفكير عميق وجاد) / استغراق في التفكير, وجوم (تأمل مرضي مستمر في مشكلة ما)",
 "penstemon barbatus": "بنستيمون اللحية الذهبية (نبات في جنوب غرب الولايات المتحدة له عناقيد مفتوحة طويلة من الزهور القرمزية بشعيرات صفراء على الشفة السفلية)",
 "penstemon centranthifolius": "بنستيمون قرمزي, بوق قرمزي (نبات بأزهار أنبوبية حمراء زاهية في عناقيد ضيقة طويلة بالقرب من أطراف السيقان المنتصبة؛ السلاسل الساحلية من وسط كاليفورنيا جنوباً)",
 "penstemon cyananthus": "بنستيمون نهر بلات (نبات قائم بأزهار زرقاء بنفسجية في حلقات بالقرب من أطراف السيقان؛ أيداهو إلى يوتا ووايومنغ)",
 "penstemon davidsonii": "بنستيمون ديفيدسون (نبات يشكل حصيرة بأزهار زرقاء وخزامية متجمعة على سيقان قصيرة منتصبة؛ كولومبيا البريطانية إلى شمال كاليفورنيا)",
 "penstemon deustus": "بنستيمون الصخر الساخن (سيقان في كتل بأزهار قشدية اللون؛ يوجد من واشنطن إلى وايومنغ وجنوباً إلى كاليفورنيا ويوتا)",
 "penstemon dolius": "بنستيمون جونز (نبات منخفض بأزهار زرقاء فاتحة وبنفسجية في عناقيد قصيرة بالقرب من أطراف السيقان؛ نيفادا إلى يوتا)",
 "penstemon fruticosus": "بنستيمون شجيري (نبات كثيف منخفض بأزهار كبيرة مبهرجة خزامية باهتة أو زرقاء بنفسجية في عناقيد ضيقة عند نهايات السيقان)",
 "penstemon linarioides": "بنستيمون ضيق الأوراق (نبات له أوراق ضيقة صغيرة وأزهار زرقاء بنفسجية في عناقيد مفتوحة طويلة؛ يوتا وكولورادو إلى نيو مكسيكو وأريزونا)",
 "penstemon newberryi": "بنستيمون نيوبري, فخر الجبل (نبات يشكل حصيرة بأزهار وردية عميقة على سيقان ورقية قصيرة منتصبة؛ الأماكن الصخرية في المرتفعات العالية من أوريغون إلى كاليفورنيا)",
 "penstemon palmeri": "بنستيمون معطر, زهرة البالون (أزهار منتفخة عطرة بيضاء إلى وردية محمرة في عناقيد ضيقة طويلة على سيقان منتصبة؛ أريزونا إلى نيو مكسيكو ويوتا)",
 "penstemon parryi": "بنستيمون باري (سيقان منتصبة بأزهار وردية خزامية في عناقيد طويلة متقطعة؛ أريزونا)",
 "penstemon rupicola": "بنستيمون صخري (واحدة من أجمل الأزهار البرية في الغرب؛ أزهار كبيرة زاهية وردية أو زهرية في العديد من العثاكيل فوق حصائر سميكة من السيقان والأوراق؛ الحواف والمنحدرات…)",
 "penstemon rydbergii": "بنستيمون ريدبيرغ (نبات بدوامات من الزهور الزرقاء البنفسجية الداكنة الصغيرة؛ واشنطن إلى وايومنغ وجنوباً إلى كاليفورنيا وكولورادو)",
 "penstemon serrulatus": "بنستيمون الشلال (دوامات من الزهور الزرقاء العميقة إلى الأرجوانية الداكنة عند أطراف السيقان الورقية المنتصبة؛ الأماكن الرطبة من كولومبيا البريطانية إلى أوريغون)",
 "penstemon whippleanus": "بنستيمون ويبل (أزهار بلون النبيذ والخزامى إلى الأرجواني والأسود في عدة عناقيد على النصف العلوي من السيقان الورقية؛ مونتانا جنوباً عبر جبال الروكي إلى أريزونا ونيو…)",
 "penstock": "بربخ - أنبوب مفرِّغ",
 "pent": "مَحْبُوس, مُحْتَجَز (مَحْصُورٌ بِشِدَّةٍ فِي مَكَانٍ ضَيِّقٍ)",
 "pent-up": "مَحْبُوس, مَكْبُوت (يتسم بكبت الدوافع أو المشاعر أو يدل عليه)",
 "pentacle": "شكل خماسي, نجمة خماسية (نجمة لها 5 رؤوس؛ تتكون من 5 خطوط مستقيمة بين رؤوس مخمس وتحيط بمخمس آخر)",
 "pentad": "خَمْسَة, خُمَاسِيّ (العدد الأصلي الذي هو مجموع أربعة وواحد)",
 "pentaerythritol": "بنتا إريثريتول (موسع للأوعية التاجية (الاسم التجاري بيريتريت) يستخدم لعلاج الذبحة الصدرية)",
 "pentagon": "مُخَمَّس, خُمَاسِيّ أَضْلَاع",
 "pentagonal": "خماسي الزوايا, مخمس (متعلق بالمخمس أو يشبهه)",
 "pentagram": "شكل خماسي, نجمة خماسية (نجمة لها 5 رؤوس؛ تتكون من 5 خطوط مستقيمة بين رؤوس مخمس وتحيط بمخمس آخر)",
 "pentahedron": "خماسي السطوح (أي متعدد سطوح له خمسة أوجه مستوية)",
 "pentail": "زبابيات الشجر قلمية الذيل (زبابيات شجر بنية لها ذيل عارٍ محاط بشعر طويل صلب على الثلث الأقصى؛ تعيش في ماليزيا)",
 "pentalogy": "خُمَاسِيَّة",
 "pentamerous": "خُمَاسِيُّ الأَجْزَاء (مُقَسَّم إلى خَمْسَةِ أَجْزَاء؛ تَحْدِيدًا كُلُّ مَحِيطٍ زَهْرِيٍّ يَتَأَلَّفُ مِنْ خَمْسَةِ أَعْضَاء)",
 "pentameter": "خماسي التفعيلة (بيت شعر يحتوي على خمس تفعيلات عروضية)",
 "pentamethylenetetrazol": "بنتيلين تيترازول, ميترازول (دواء يستخدم كمنشط للدورة الدموية والجهاز التنفسي؛ الجرعات الكبيرة تسبب تشنجات في علاج الصدمة؛ ميترازول هو علامة تجارية)",
 "pentangle": "شكل خماسي, نجمة خماسية (نجمة لها 5 رؤوس؛ تتكون من 5 خطوط مستقيمة بين رؤوس مخمس وتحيط بمخمس آخر)",
 "pentangular": "خماسي الزوايا, مخمس (متعلق بالمخمس أو يشبهه)",
 "pentanoic acid": "حمض البنتانويك, حمض الفاليريك (حمض كربوكسيلي سائل شفاف يستخدم في العطور والأدوية)",
 "pentastomid": "دودة اللسان (مفصلي يشبه الدودة له زوجان من الخطافات على جانبي الفم؛ طفيلي في الجيوب الأنفية للثدييات)",
 "pentasyllabic": "خُمَاسِيُّ المَقَاطِع (يتألّف من خمسة مقاطع صوتيّة أو يتّسم بها)",
 "pentateuch": "تَوْرَاة",
 "pentathlete": "لاعب الخماسي (رياضي يتنافس في الخماسي الحديث)",
 "pentathlon": "الخماسي, مسابقة الخماسي (مسابقة رياضية تتكون من خمس فعاليات مختلفة)",
 "pentatone": "سلم خماسي (سلم ناقص مكون من خمس نغمات؛ عادة ما تُحذف النغمتان الرابعة والسابعة من السلم الدياتوني)",
 "pentatonic": "خماسي النغمات (يتعلق بالسلم الموسيقي الخماسي)",
 "pentatonic scale": "سلم خماسي (سلم ناقص مكون من خمس نغمات؛ عادة ما تُحذف النغمتان الرابعة والسابعة من السلم الدياتوني)",
 "pentavalent": "خماسي التكافؤ (لديه تكافؤ خمسة)",
 "pentazocine": "بنتازوسين, تالوين (دواء مسكن (الاسم التجاري تالوين) أقل تسبباً في الإدمان من المورفين)",
 "pentazole": "پنتازول",
 "pentecost": "شافوت, عيد الأسابيع ((اليهودية) يوم مقدس يهودي يُحتفل به في السادس من سيفان للاحتفال بتلقي موسى للوصايا العشر) / أحد العنصرة, عيد العنصرة (الأحد السابع بعد عيد الفصح؛ يحيي ذكرى حلول الروح القدس على الرسل؛ يوم ربع سنوي في اسكتلندا)",
 "pentecostal": "عنصري, متعلق بعيد العنصرة (من أو متعلق بـ أو يحدث في عيد العنصرة) / خمسيني (من أو متعلق أو مميز لأي من الهيئات الدينية الخمسينية أو أعضائها) / خمسيني (أي عضو في هيئة دينية خمسينية)",
 "pentecostal religion": "الخمسينية, الكنيسة الخمسينية (أي كنيسة بروتستانتية أصولية تستخدم أساليب إحيائية لتحقيق تجارب مماثلة لتجارب العنصرة للتلاميذ المسيحيين الأوائل)",
 "pentecostalism": "خمسينية (مبادئ وممارسات الجماعات الدينية الخمسينية؛ تتميز بالإثارة الدينية والتحدث بألسنة)",
 "pentecostalist": "خمسيني (أي عضو في هيئة دينية خمسينية)",
 "penthouse": "بنتهاوس, شقة سطح (شقة تقع في الطوابق العليا للمبنى)",
 "pentimento": "أثر التعديل, بنتيمينتو (ظهور صورة سفلية في اللوحة كانت قد طليت فوقها (عادة عندما تصبح اللوحة اللاحقة شفافة مع مرور الزمن))",
 "pentlandite": "بنتلانديت (معدن (كبريتيد الحديد والنيكل) وهو الخام الرئيسي للنيكل)",
 "pentobarbital": "بنتوباربيتال الصوديوم, نيمبوتال (باربيتورات (الاسم التجاري نيمبوتال) يستخدم كمهدئ ومنوم ومضاد للتشنج)",
 "pentobarbital sodium": "بنتوباربيتال الصوديوم, نيمبوتال (باربيتورات (الاسم التجاري نيمبوتال) يستخدم كمهدئ ومنوم ومضاد للتشنج)",
 "pentode": "بنتود, خماسي المساري (أنبوب حراري يحتوي على خمسة أقطاب كهربائية)",
 "pentose": "بنتوز, سكر خماسي (أي سكر أحادي يحتوي على خمس ذرات كربون في الجزيء)",
 "pentothal": "بنتوثال, ثيوبنتال (باربيتورات عبارة عن مسحوق استرطابي (الاسم التجاري بنتوثال) وهو باربيتورات قوي يعمل بسرعة؛ يحفز حالة استرخاء عند حقنه كمخدر عام)",
 "pentoxide": "خماسي أكسيد (أكسيد يحتوي على خمس ذرات من الأكسجين في الجزيء)",
 "pentoxifylline": "بنتوكسيفيلين, ترينتال (دواء (الاسم التجاري ترينتال) يستخدم لعلاج العرج؛ يُعتقد أنه يزيد من مرونة خلايا الدم الحمراء بحيث يمكنها التدفق عبر الأوعية الدموية إلى الساقين…)",
 "pentylenetetrazol": "بنتيلين تيترازول, ميترازول (دواء يستخدم كمنشط للدورة الدموية والجهاز التنفسي؛ الجرعات الكبيرة تسبب تشنجات في علاج الصدمة؛ ميترازول هو علامة تجارية)",
 "penuche": "بانوتشي, بينوتشي (فادج مصنوع من السكر البني والزبدة والحليب والمكسرات)",
 "penuchle": "بينوكل (لعبة ورق تُلعب بحزمة من ثمانية وأربعين ورقة (اثنتان من كل بدلة للأوراق العالية)؛ يشبه اللعب الويست)",
 "penult": "المقطع قبل الأخير (المقطع المجاور للأخير في الكلمة)",
 "penultima": "المقطع قبل الأخير (المقطع المجاور للأخير في الكلمة)",
 "penultimate": "قَبْلَ الأَخِير (الثَّانِي مِنَ النِّهَايَةِ؛ يَسْبِقُ الأَخِيرَ مُبَاشَرَةً) / المقطع قبل الأخير (المقطع المجاور للأخير في الكلمة)",
 "penumbra": "شِبْه ظِلّ",
 "penumbral": "شبه ظلي (مكون من أو يخص منطقة الظل الجزئي حول الظل التام)",
 "penurious": "شَدِيد البُخْل, مُقَتِّر جِدًّا (شديد الامتناع عن الإنفاق بصورة مفرطة) / مَضِيق, مُعْسِر (لا يملك ما يكفي من المال لسدّ الحاجات الأساسية)",
 "penuriously": "بإملاق, ببخل شديد (بطريقة شحيحة جداً)\nمثال: عاشوا بإملاق",
 "penuriousness": "شح (ميل للتقتير بالمال) / إفلاس, عدم امتلاك مال (حالة نقص المال)",
 "penury": "حاجة, ضيق ذات اليد (حالة من الفقر المدقع أو العدم)\nمثال: روعه عوزهم",
 "penutian": "اللغات البينوتية (عائلة من لغات الهنود الحمر يتم التحدث بها في الوادي الداخلي الكبير في كاليفورنيا) / بينوتيان (فرد من شعب هندي في أمريكا الشمالية يتحدث إحدى لغات بينوتيان)",
 "penwoman": "صحفية, كاتبة (مصطلحات غير رسمية للصحفيات الإناث)",
 "penza": "بِينْزَا",
 "peon": "كَادِح",
 "peonage": "استعباد بالدين (ممارسة جعل المدين يعمل لدى دائنه حتى سداد الدين) / سخرة (حالة العامل بالسخرة)",
 "peony": "عُود الصَّلِيب, فَاوَانِيَا (قطعة من الخشب كالعصا جمعه عيدان؛ ما يُتَبَخَّر به)\nمثال: أشعلت عود ثقاب.",
 "people": "نَاس, خَلْق (اسم للجمع من بني آدم واحده إِنْسَان أو إِنْس) / خَلْق, شَعْب (أَنْشَأَ، أَوْجَدَ) / أَهْل (أَهِلَ به يَأْهَلُ أَهَلاً: أنِس، فهو أَهِلٌ) / شَعْب (ما فوق القَبِيلَة ودون الأُمَّة؛ وهو أول طبقات الأنساب إلا أن البعض يضع فوقه الجَذْم والجُمْهُور؛ الناس الذين يسكنون دولة ما وإن لم يكن يربط بينهم نسب. . والعامة قد تقول شَعَب)\nمثال: ضحك الناس عليه.",
 "people in power": "أصحاب السلطة, الطبقة الحاكمة (فئة الناس التي تمارس السلطة أو الحكم)",
 "people of color": "ملونون (عرق ذو تصبغ جلدي مختلف عن العرق الأبيض (وخاصة السود))",
 "people of colour": "ملونون (عرق ذو تصبغ جلدي مختلف عن العرق الأبيض (وخاصة السود))",
 "people of the book": "أَهْل الْكِتَابِ (أَهِلَ به يَأْهَلُ أَهَلاً: أنِس، فهو أَهِلٌ)\nمثال: أهل أبدو أنيقا؟",
 "people's": "شَعْبِيّ",
 "people's democratic republic of algeria": "الْجُمْهُورِيَّة الْجَزَائِرِيَّة الدِّيمُقْرَاطِيَّة الشَّعْبِيَّة",
 "people's democratic republic of yemen": "جُمْهُورِيَّة اَلْيَمَن اَلدِّيمُقْرَاطِيَّة اَلشَّعْبِيَّة",
 "people's liberation army": "جَيْش التَحْرِير الشَعْبِيّ الصِينِيّ (الجُنْد السائرون لحرب أو غيرها. ويطلق أيضا على هؤلاء الجند وكل الهيئات التابعة لهم حتى وإن كانوا في السلم؛ الجمع الغفير من الناس)\nمثال: هل كان في الجيش.",
 "people's party": "حزب الشعب (حزّب القومَ:جعلهم أحزاباً ، قوّاهم ، جعلهم من حزبه؛ حَزَّبْتُ القُرْآنَ: جَعَلْتُه أَحْزَاباً)\nمثال: التحقت بذلك الحزب.",
 "people's republic": "الْجُمْهُورِيَّة الشَّعْبِيَّة",
 "people's republic of albania": "جُمْهُورِيَّة أَلْبَانِيَا الشَّعْبِيَّة",
 "people's republic of bangladesh": "جمهوريَة بنغلاديش الشعبيَة",
 "people's republic of china": "جُمْهُورِيَّةُ الصِّينِ الشَّعْبِيَّةُ",
 "people's socialist republic of albania": "جُمْهُورِيَّة أَلْبَانِيَا الشَّعْبِيَّة الاِشْتِرَاكِيَّة",
 "peopled": "مَأْهُولٌ بِالسُّكَّان (مزوّد بالسكان؛ يقطنه أناس)",
 "peoples": "أمم, شعوب (البشر الذين ينتمون إلى أمة أو مجتمع أو مجموعة عرقية معينة)\nمثال: الشعوب الأصلية في أستراليا",
 "pep": "نشاط, همة (حيوية وطاقة)\nمثال: هذا المنشط مضمون لإعطائك مزيداً من النشاط",
 "pep pill": "أمفيتامين, منشط (منشط للجهاز العصبي المركزي يزيد الطاقة ويقلل الشهية؛ يستخدم لعلاج التغفيق وبعض أشكال الاكتئاب)",
 "pep rally": "تَجَمُّع تَشْجِيعِيّ (تجمع (خاصة للطلاب) قبل مباراة رياضية)",
 "pep talk": "حديث تشجيعي (خطاب حثي يحاول بث الحماس والعزيمة في فريق أو طاقم عمل)",
 "pepcid": "بيبسيد, فاموتيدين (حاصر للهيستامين (الاسم التجاري بيبسيد) يستخدم لعلاج القرحة الهضمية والتهاب المعدة والارتجاع المريئي)",
 "peperomia": "بيبيروميا",
 "peperomia argyreia": "بيبروميا بطيخية (تزرع كنبات منزلي لأوراقها اللحمية المخططة بالفضة؛ أمريكا الجنوبية)",
 "peperomia sandersii": "بيبروميا بطيخية (تزرع كنبات منزلي لأوراقها اللحمية المخططة بالفضة؛ أمريكا الجنوبية)",
 "peplos": "بيبلس (رداء ارتدته النساء في اليونان القديمة؛ قماش مثبت عند الكتفين ويتدلى في طيات حتى الخصر)",
 "peplum": "بيبلس (رداء ارتدته النساء في اليونان القديمة؛ قماش مثبت عند الكتفين ويتدلى في طيات حتى الخصر) / بيبلوم, تنورة خصر (كشكشة واسعة متصلة بخصر الفستان أو السترة أو القميص)",
 "peplus": "بيبلس (رداء ارتدته النساء في اليونان القديمة؛ قماش مثبت عند الكتفين ويتدلى في طيات حتى الخصر)",
 "pepper": "فِلْفِل, فُلْفُل (حَبّ حريف يوضع في الطعام أو يطحن يستخدم كتابل. يكون منه أسود أو أبيض، حرارته متوسطة؛ فُلْفُل حَارّ: نبات ثمره حريف لونه أخضر وقد يحمرّ شديد الحرارة. يؤكل كما هو أو يجفف ويطحن ويستخدم كتابل)\nمثال: نحب الفلفل الحار.",
 "pepper box": "رجاجة فلفل, فلفلة (رجاجة ذات غطاء مثقوب لرش الفلفل المطحون)",
 "pepper bush": "ألدر أبيض, شجيرة الفلفل الحلوة (شجيرة من شرق وجنوب الولايات المتحدة الساحلية ذات عناقيد جميلة من الزهور البيضاء المعطرة برائحة التوابل)",
 "pepper grass": "رشاد الحديقة, رشاد مزروع (عشب حولي يستخدم كخضار للسلطة وللزينة)",
 "pepper grinder": "طاحونة فلفل (طاحونة لطحن الفلفل)",
 "pepper mill": "طاحونة فلفل (طاحونة لطحن الفلفل)",
 "pepper pot": "رجاجة فلفل, فلفلة (رجاجة ذات غطاء مثقوب لرش الفلفل المطحون) / بيبر بوت (حساء مصنوع من الخضروات والكرشة ومتبل بحبوب الفلفل؛ يحتوي غالباً على الزلابية)",
 "pepper root": "جذر مجعد, عشبة الأسنان (عشبة أمريكية شمالية بجذور حرشفية أو مسننة لاذعة)",
 "pepper sauce": "بويفراد, صلصة الفلفل (للحم الغزال: صلصة بنية مع خضروات مقلية وتتبيلة والكثير من الفلفل)",
 "pepper shaker": "رجاجة فلفل, فلفلة (رجاجة ذات غطاء مثقوب لرش الفلفل المطحون)",
 "pepper shrub": "شجيرة الفلفل (شجيرة دائمة الخضرة أو شجرة صغيرة أوراقها ملطخة بوضوح باللونين الأحمر والأصفر ولها ثمار سوداء صغيرة)",
 "pepper spray": "رشاش الفلفل (أي آلَة تَرُش المَاء؛ المِدْفَع الرَشَّاش: هو بين المِدْفَع والرَشَّاشَة لا يُحمَل باليد ويثبت على الأرض إلا أنه يَرُشّ الرصاص كالرشاشة)\nمثال: إني أطلق النار برشاش روسي.",
 "pepper steak": "ستيك بالفلفل (شرائح ستيك مشوحة مع الفلفل الأخضر والبصل) / ستيك أو بويفر, ستيك بالفلفل الأسود (ستيك مغطى بالفلفل الأسود المجروش ومقلي ويقدم مع صلصة البراندي والزبدة)",
 "pepper tree": "شجرة الفلفل, كيركيا (شجرة نفضية أفريقية صغيرة ذات تاج منتشر وأوراق متجمعة باتجاه نهايات الفروع وعناقيد من الزهور الكريمية تشبه الليلك) / شجرة الفلفل, شينوس مولي (نبات بيروفي دائم الخضرة صغير ذو رأس عريض مستدير وفروع متدلية رفيعة مع عناقيد جذابة من الزهور المخضرة تليها عناقيد من الثمار الوردية)",
 "pepper vine": "فلفل حقيقي, كرمة الفلفل (حَبّ حريف يوضع في الطعام أو يطحن يستخدم كتابل. يكون منه أسود أو أبيض، حرارته متوسطة؛ فُلْفُل حَارّ: نبات ثمره حريف لونه أخضر وقد يحمرّ شديد الحرارة. يؤكل كما هو أو يجفف ويطحن ويستخدم كتابل)\nمثال: نحب الفلفل الحار.",
 "pepper vodka": "فودكا الفلفل الأسود (مشروب كحولي قوي بنكهة الفلفل)",
 "pepper-and-salt": "قماش منقط (قماش منسوج ببقع من الضوء والظلام)",
 "peppercorn": "حبوب الفلفل, فلفل (تابل لاذع من ثمرة نبات الفلفل الشائع في الهند الشرقية؛ يستخدم كاملاً أو مطحوناً)",
 "peppercorn rent": "إيجار رمزي (إيجار منخفض جداً أو اسمي)",
 "peppered steak": "ستيك أو بويفر, ستيك بالفلفل الأسود (ستيك مغطى بالفلفل الأسود المجروش ومقلي ويقدم مع صلصة البراندي والزبدة)",
 "pepperidge": "صمغ أسود, صمغ حامض (شجرة عمودية من شرق أمريكا الشمالية لها أطراف أفقية وأوراق صغيرة تظهر متأخرة في الربيع وتكتسب لوناً رائعاً في أوائل الخريف)",
 "pepperiness": "حرارة, حرافة (تتبيل حار)",
 "peppermint": "نَعْنَاع فِلْفِلِيّ",
 "peppermint candy": "حلوى النعناع الفلفلي (حلوى منكهة بزيت النعناع الفلفلي)",
 "peppermint gum": "صمغ أحمر, كينا النعناع (شجرة صمغ أحمر من تسمانيا)",
 "peppermint oil": "زيت النعناع (زيت من نبات النعناع يستخدم للتنكيه)",
 "peppermint patty": "قرص نعناع (قرص حلوى بنكهة النعناع)",
 "pepperoni": "بِبَرُونِي",
 "pepperoni pizza": "بيتزا بيبيروني (بيتزا الطماطم والجبن مع البيبيروني)",
 "pepperwood": "آس أوريغون, غار كاليفورنيا (شجرة ساحل المحيط الهادئ ذات أوراق عطرية وزهور خيمية صغيرة تليها ثمار تشبه الزيتون؛ تنتج خشباً صلباً متيناً)",
 "pepperwort": "رشاد الحديقة, رشاد مزروع (عشب حولي يستخدم كخضار للسلطة وللزينة) / سرخس البرسيم, مارسيليا (أي من عدة سراخس مائية من جنس مارسيليا ذات أربع وريقات)",
 "peppery": "فُلْفُلِيّ (ذُو طَعْمٍ لَاذِعٍ حَارٍّ كَالفُلْفُل)",
 "peppiness": "نشاط, همة (حيوية وطاقة)\nمثال: هذا المنشط مضمون لإعطائك مزيداً من النشاط",
 "peppy": "حَيَوِيّ, مِقْدَام (يتميّز بالحركة النشطة والحيوية)",
 "pepsi": "بِيبْسِي",
 "pepsi cola": "بيبسي, بيبسي كولا (بيبسي كولا هي علامة تجارية للكولا)",
 "pepsin": "ببسين (إنزيم يُنتج في المعدة يقسم البروتينات إلى ببتونات)",
 "pepsinogen": "ببسينوجين (طليعة الببسين؛ يُخزن في جدران المعدة ويتحول إلى ببسين بواسطة حمض الهيدروكلوريك في المعدة)",
 "peptic": "بيبتيدي, هضمي (متعلق بالهضم أو معزز له)\nمثال: عصارات هضمية",
 "peptic ulcer": "قرحة هضمية",
 "peptic ulceration": "قرحة هضمية (قرحة في الغشاء المخاطي المبطن للقناة الهضمية)",
 "peptidase": "بروتياز (أي إنزيم يحفز انقسام البروتينات إلى أجزاء ببتيد أصغر وأحماض أمينية بعملية تعرف بالتحلل البروتيني)",
 "peptide": "ببتيد (أميد يجمع بين المجموعة الأمينية لحمض أميني ومجموعة الكربوكسيل لحمض آخر؛ يتم الحصول عليه عادة عن طريق التحلل المائي الجزئي للبروتين)",
 "peptide bond": "رابطة ببتيدية",
 "peptide linkage": "رابطة ببتيدية (الارتباط الأساسي لجميع تراكيب البروتين؛ الرابطة الكيميائية بين مجموعات الكربوكسيل ومجموعات الأمين التي توحد الببتيد)",
 "peptisation": "ببتدة, ترويق غروي",
 "peptization": "ببتدة, ترويق غروي",
 "pepto-bismol": "بيبتو بيسمول (نوع من مضادات الحموضة)",
 "peptone": "ببتون (أي من المركبات القابلة للذوبان في الماء التي تتكون عن طريق التحلل المائي أثناء هضم البروتينات إلى أحماض أمينية)",
 "per": "لِكُلّ / فِي كُلّ (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة) / بِنَاءً عَلَى, لِأَجْل (ضد هَدْم. ؛ المَبْنَى أو البِنَاية)\nمثال: جون في عمر أخي.",
 "per annum": "سَنَوِيًّا (في السنة؛ كل سنة (عادة مع الإشارة إلى مبلغ من المال يدفع أو يُستلم))\nمثال: كان يكسب 100,000 دولار سنوياً",
 "per capita": "لِلْفَرْد الوَاحِد (لكل شخص على حدة) / للفرد الواحد, للنسمة (لكل شخص؛ لكل فرد)\nمثال: ننفق 5000 دولار للفرد الواحد سنوياً للتعليم في هذه المنطقة",
 "per capita income": "نصيب الفرد من الدخل (إجمالي الدخل القومي مقسوماً على عدد السكان)",
 "per centum": "بِالمِائَة, نِسْبَة مِئَوِيَّة (نسبة بالنسبة للكل (وهي عادة المقدار لكل مائة)؛ عشرة بالمائة)",
 "per diem": "يَوْمِيًّا (واحد كل يوم) / بدل يومي, مياومة (بدل يومي لنفقات المعيشة (خاصة أثناء السفر فيما يتعلق بعملك))\nمثال: سنوفر 100 ساعة عمل يومياً",
 "per se": "بحد ذاته, جوهرياً (فيما يتعلق بطبيعته المتأصلة)\nمثال: هذا البيان مثير للاهتمام بحد ذاته",
 "per year": "سَنَوِيًّا (في السنة؛ كل سنة (عادة مع الإشارة إلى مبلغ من المال يدفع أو يُستلم))\nمثال: كان يكسب 100,000 دولار سنوياً",
 "peradventure": "رُبَّمَا, لَعَلَّ (عن طريق الصدفة (أو الاحتمال)) / احتمال, شك (شك أو عدم يقين فيما إذا كان الأمر كذلك)\nمثال: ربما ستتصل غداً",
 "perak": "بيراك",
 "perambulating": "مُتَجَوِّل, مُتَمَشٍّ (يَتَنَزَّهُ أَوْ يَمْشِي فِي أَرْجَاءِ المَكَان)",
 "perambulation": "تجوال, تنزة (مشي متمهل (عادة في مكان عام)) / طواف لتحديد الحدود (مشي حول إقليم (أبرشية أو قصر أو غابة وما إلى ذلك) لتأكيد وتسجيل حدوده رسمياً)",
 "perambulator": "عربة أطفال (مركبة صغيرة بأربع عجلات يدفع فيها الرضيع أو الطفل)",
 "perboric acid": "حمض البيربوريك (شكل من أشكال حمض البوريك)",
 "perca flavescens": "فرخ أصفر (فرخ أمريكا الشمالية)",
 "perca fluviatilis": "فرخ أوروبي (فرخ موطنه أوروبا)",
 "percale": "بيركال (قماش قطني ناعم محكم النسج)",
 "perceivable": "مَفْهُوم, وَاضِح (يمكن إدراكه وفهمه واستيعابه) / مَحْسُوس, مُدْرَك (يُمْكِنُ إِدْرَاكُهُ خَاصَّةً بِالبَصَرِ أَوِ السَّمْع)",
 "perceive": "أَدْرَكَ, وَعَى (وَصَلَ إلى الشَّيءِ، بَلَغَهُ (مَكَان، قِيمَة، حَال، هَدَف)؛ لَحِقَ الشيءَ بعد أن سَبَقَه)\nمثال: لم أدرك أبدا أنه يحبني.",
 "perceived": "مَحْسُوس, مُدْرَك (أُدرِك بواسطة الحواس) / مَحْسُوس, مُسْتَشْعَر (أُدرِك بالحدس أو الاستنتاج لا بإشارات حسّيّة واضحة)",
 "perceiver": "مراقب, مُدرِك (شخص يصبح واعياً (بالأشياء أو الأحداث) من خلال الحواس)",
 "percent": "فِي الْمِئَة, بِالْمِئَة (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "percent sign": "علامة النسبة المئوية (علامة ('%') تستخدم للإشارة إلى أن الرقم الذي يسبقها يجب أن يُفهم كنسبة مضروبة في 100)",
 "percentage": "النِّسْبَة الْمِئَوِيَّة",
 "percentage point": "نُقْطَة مِئَوِيَّة (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه)\nمثال: هذه هي نقطة ضعفه.",
 "percentage sign": "علامة النسبة المئوية (علامة ('%') تستخدم للإشارة إلى أن الرقم الذي يسبقها يجب أن يُفهم كنسبة مضروبة في 100)",
 "percentile": "رتبة مئينية, مئين ((إحصاء) أي من النقاط الـ 99 المرقمة التي تقسم مجموعة مرتبة من الدرجات إلى 100 جزء يحتوي كل منها على واحد بالمائة من المجموع)",
 "percept": "إدراك, مُدْرَك (تمثيل ما يتم إدراكه؛ مكون أساسي في تكوين المفهوم)",
 "perceptibility": "قابلية الإدراك (خاصية كون الشيء مدركاً بالعقل أو الحواس)",
 "perceptible": "مَحْسُوس, مَكْشُوف (يسهل رؤيته أو اكتشافه) / محسوس, مدرك (يمكن إدراكه بالعقل أو الحواس)\nمثال: عرج ملحوظ",
 "perceptibly": "بشكل ملحوظ, بوضوح (بطريقة ملحوظة)\nمثال: لقد تغير بشكل ملحوظ على مر السنين",
 "perception": "اِدْرََاك حَسِّيّ",
 "perceptive": "فطن, مدرك (لديه القدرة على الإدراك أو الفهم؛ حاد البصيرة) / إدراكي (متعلق بالإدراك الحسي)\nمثال: عين ثاقبة",
 "perceptively": "بإدراك, بفطنة (بطريقة مدركة وفطنة)",
 "perceptiveness": "سرعة بديهة, فطنة (صفة البصيرة والفهم المتعاطف) / بصيرة, فطانة (إدراك ما هو غامض) / بصيرة, تذوق (تمييز دقيق (خاصة للقيم الجمالية)) / بصيرة, فطنة (شعور بالفهم)\nمثال: ساهم الغرور ونقص الذوق في نجاحه السريع",
 "perceptivity": "بصيرة, فطنة (شعور بالفهم)",
 "perceptual": "إدراكي (من أو يتعلق بفعل الإدراك)\nمثال: محفز إدراكي",
 "perceptual constancy": "ثبات إدراكي ((علم النفس) الميل لإدراك الأشياء بطريقة متشابهة جداً على الرغم من التباينات الواسعة في ظروف الملاحظة)",
 "perceptual experience": "إدراك, مُدْرَك (تمثيل ما يتم إدراكه؛ مكون أساسي في تكوين المفهوم)",
 "perceptuality": "إدراكية (جودة الارتباط بتنظيم وتحديد وتفسير المعلومات الحسية)",
 "perceptually": "إدراكياً, من الناحية الإدراكية (فيما يتعلق بالإدراك)\nمثال: هذه المهمة صعبة جداً إدراكياً",
 "perch": "فرخ (أي من الأسماك العديدة شائكة الزعانف من فصائل مختلفة من رتبة الفرخيات) / فرخ (أسماك غذائية ورياضية شائكة الزعانف تعيش في المياه العذبة) / مجثم (دعامة تتكون من فرع أو قضيب يعمل كمكان للراحة (خاصة للطائر)) / سمك الفرخ, فرخ (أي من العديد من أسماك أمريكا وأوروبا)",
 "perchance": "رُبَّمَا, لَعَلَّ (عن طريق الصدفة (أو الاحتمال)) / ربما, صدفة (عن طريق الصدفة أو الاحتمال)\nمثال: ربما ستتصل غداً",
 "percher": "جَاثِم (شخص يجلس على مكان مرتفع (مجثم))",
 "percheron": "بيرشيرون (واحدة من سلالات خيول الجر الرمادية أو السوداء التي استخدمت أصلاً في فرنسا لجر العربات الثقيلة أو المدفعية)",
 "perchlorate": "بيركلورات (ملح لحمض البيركلوريك)",
 "perchloric acid": "حمض البيركلوريك (عامل مؤكسد قوي؛ يُكوّن البيركلورات)",
 "perchloride": "بيركلوريد (كلوريد يحتوي على نسبة عالية غير عادية من الكلور)",
 "perchloromethane": "رابع كلوريد الكربون (سائل عديم اللون غير قابل للاشتعال يستخدم كمذيب للدهون والزيوت؛ تراجع استخدامه كسائل تنظيف أو طفاية حريق بسبب سميته)",
 "percina tanasi": "سمكة الحلزون (فرخ صغير آكل للحلزون في نهر تينيسي)",
 "percipient": "ثَاقِب, نَافِذ البَصِيرَة (يَتَّسِم بِسُرْعَة الإِدْرَاك وَسُهُولَتِه) / مراقب, مُدرِك (شخص يصبح واعياً (بالأشياء أو الأحداث) من خلال الحواس)",
 "percoid": "سمك فرخي, فرخيات (أي من الأسماك العديدة شائكة الزعانف من رتبة الفرخيات)",
 "percoid fish": "سمك فرخي, فرخيات (أي من الأسماك العديدة شائكة الزعانف من رتبة الفرخيات)",
 "percoidean": "سمك فرخي, فرخيات (أي من الأسماك العديدة شائكة الزعانف من رتبة الفرخيات)",
 "percolate": "سائل مرشح, مستخلص بالترشيح (ناتج عملية التقطير (الترشيح))",
 "percolation": "ترشيح, نقع (ترشيح سائل للاستخلاص أو التنقية) / تقطير (فعل صنع القهوة في جهاز التقطير) / تخلل, ترشيح (المرور البطيء لسائل عبر وسط ترشيح)\nمثال: تخلل مياه الأمطار عبر التربة",
 "percolator": "إبريق ترشيح, رَكْوَة ترشيح (إبريق قهوة يصعد فيه الماء المغلي عبر أنبوب مركزي ويرشح مرة أخرى لأسفل عبر سلة من حبوب البن المطحونة)",
 "percussion": "آلَة إِيقَاعِيَّة (الفارسية: ماشين؛ الأوردية: مشين)\nمثال: نسى زيري الآلة.",
 "percussion cap": "كبسولة التفجير, كبسولة القدح (مفجر ينفجر عند طرقه)",
 "percussion instrument": "آلة إيقاعية (آلة موسيقية يتم فيها إنتاج الصوت عن طريق ضرب شيء بآخر)",
 "percussion section": "قسم الإيقاع (قسم الفرقة أو الأوركسترا الذي يعزف على آلات الإيقاع)",
 "percussionist": "عازف إيقاع (موسيقي يعزف على الآلات الإيقاعية)",
 "percussive": "إيقاعي, نقري (يتضمن النقر أو يتميز بآلات إيقاعية)\nمثال: موسيقى إيقاعية",
 "percussive instrument": "آلة إيقاعية (آلة موسيقية يتم فيها إنتاج الصوت عن طريق ضرب شيء بآخر)",
 "percussor": "مطرقة المنعكسات, مطرقة طبية ((طب) مطرقة صغيرة برأس مطاطي تستخدم في فحوصات الطرق على الصدر واختبار ردود الفعل)",
 "percutaneous": "عبر الجلد (عبر الجلد السليم؛ يشير إلى الأدوية التي توضع مباشرة على الجلد (كريمات أو مراهم) أو بأشكال ممتدة المفعول (لصقات جلدية))\nمثال: إستروجين عبر الجلد",
 "perdition": "الجحيم, الهاوية ((المسيحية) مسكن الشيطان وقوى الشر؛ حيث يعاني الخطاة من العقاب الأبدي)\nمثال: شيطان من أعماق الهاوية",
 "perdix perdix": "حجل رمادي (حجل أوروبي شائع)",
 "perdurability": "ديمومة قصوى (خاصية كونه متيناً للغاية)",
 "perdurable": "بَاقٍ, عَصِيّ عَلَى الفَنَاء (يدوم مدّة طويلة جدًّا)",
 "pere david's deer": "أيل الأب دافيد (أيل صيني كبير يعيش فقط في قطعان مستأنسة)",
 "peregrination": "ترحال (السفر أو التجوال حول الأماكن)",
 "peregrine": "شاهين (صقر واسع الانتشار كان يستخدم سابقاً في الصيد بالصقور) / بَدَوِيّ, رَحَّال (يتنقّل من مكان لآخر دون استقرار)",
 "peregrine falcon": "شَاهِين",
 "peremptorily": "بشكل آمر, بشكل حاسم (بطريقة آمرة وحاسمة)",
 "peremptory": "جَازِم, قَطْعِيّ (يضع حداً لكل نقاش أو إجراء) / آمِر, قَاطِع (لَا يَقْبَلُ الاعْتِرَاضَ أَوِ الرَّفْض) / مُتَجَبِّر, مُتَسَلِّط (مُعْتَدّ بِنَفْسِهِ بِشَكْلٍ مُسِيء أَوْ يُمَارِس سُلْطَةً غَيْر مُبَرَّرَة)",
 "perennation": "تعمير (عملية العيش لعدد من السنوات (كنبات معمر))",
 "perennial": "أَبَدِيّ, سَرْمَدِيّ / مُعَمِّر",
 "perennial pea": "بازلاء دائمة عريضة الأوراق, جلبان عريض الأوراق (نبات متسلق معمر من وسط وجنوب أوروبا له زهور أرجوانية أو وردية أو بيضاء؛ تم توطينه في أمريكا الشمالية)",
 "perennial ragweed": "دمسيسة غربية, رجيد معمر (رجيد معمر خشن ذو جذور زاحفة في الأراضي الجرداء الجافة بجنوب غرب الولايات المتحدة والمكسيك)",
 "perennial ryegrass": "زوان إنجليزي, زوان معمر (عشبة أوروبية معمرة تزرع على نطاق واسع للمراعي والتبن وكعشبة مروج)",
 "perennial salt marsh aster": "أستر المستنقعات المالحة المعمر",
 "perennially": "بِاسْتِمْرَار, بِشَكْل مُتَجَدِّد (بطريقة متجددة أو مستمرة لفترة طويلة؛ بشكل متكرر)\nمثال: نريد أن نعرف ما هو الجديد باستمرار في هذا العالم",
 "pereskia aculeata": "بيرسكية شائكة, عنب الثعلب البربادوسي (متسلق خشبي من جزر الهند الغربية ذو سيقان شائكة والعديد من الزهور البيضاء العطرة في نورات عنقودية تليها ثمار صفراء إلى برتقالية صغيرة)",
 "perestroika": "بِيرِيسْتْرُويْكَا",
 "perfect": "كَامِل / أَتْقَنَ ((أَتْقَنَه): أحكمه)",
 "perfect game": "مباراة مثالية (مباراة لا يسمح فيها الرامي لأي لاعب منافس بالوصول إلى القاعدة)",
 "perfect gas": "غاز مثالي (غاز افتراضي ذو جزيئات مهملة الحجم لا تمارس أي قوى بين الجزيئات)",
 "perfect participle": "اسم المفعول (صيغة فعلية تعبر عن عمل مكتمل)",
 "perfect pitch": "سمع مطلق, طبقة صوتية مطلقة (القدرة على تحديد طبقة النغمة)",
 "perfect tense": "تام (زمن للأفعال يُستخدم في وصف حدث قد اكتمل)",
 "perfecta": "إكزاكتا (رهان على اختيار الفائزين بالمركزين الأول والثاني بالترتيب الصحيح)",
 "perfected": "مُتْقَن, مُكْتَمِل ((عن الخطط والأفكار) مُشكَّل بصورة كاملة ومتقنة)",
 "perfecter": "مُتْقِن, مُحَسِّن (عامل ماهر يتقن صنع شيء ما أو يوصله لدرجة الكمال)\nمثال: على الرغم من أنه ليس المخترع، إلا أنه يجب الاعتراف به كمتقن لهذه التقنية",
 "perfectibility": "قابلية الكمال (القدرة على أن يصبح الشيء كاملاً)\nمثال: يؤمن بقابلية الإنسان للكمال النهائي",
 "perfectible": "قَابِل لِلتَّكْمِيل, قَابِل لِلْإِتْقَان (قابل لأن يُصبح أو يُجعَل كاملًا)",
 "perfection": "كَمَال, إتقان",
 "perfectionism": "كَمَالِيَّة",
 "perfectionist": "كَمَالِيّ",
 "perfective": "هَيْئَة التَّمَام (جهة الفعل التي تعبر عن حدث مكتمل) / تام (زمن للأفعال يُستخدم في وصف حدث قد اكتمل)",
 "perfective aspect": "هَيْئَة التَّمَام (جهة الفعل التي تعبر عن حدث مكتمل)",
 "perfective tense": "تام (زمن للأفعال يُستخدم في وصف حدث قد اكتمل)",
 "perfective verb": "فعل تام (صيغة فعل تعبر عن الحدث كشيء مكتمل أو تتضمن معنى الاكتمال أو النتيجة)",
 "perfectly": "بِإِتْقَان, تَمَامًا",
 "perfectly elastic demand": "طلب لانهائي المرونة (حالة سوقية يختفي فيها الطلب على سلعة ما إذا ارتفع سعرها، وعلى العكس، إذا انخفض سعر السلعة، يصبح الطلب لا نهائياً)",
 "perfectly elastic supply": "عرض لانهائي المرونة (حالة سوقية يؤدي فيها انخفاض ضئيل في سعر سلعة أو خدمة إلى انخفاض المعروض من السلعة أو الخدمة إلى الصفر)",
 "perfectly inelastic demand": "طلب عديم المرونة تماماً (حالة سوقية يكون فيها الطلب على سلعة ما ثابتاً بغض النظر عن حركة سعرها)",
 "perfervid": "حَمَاسِيّ, مُتَحَمِّس (يَتَّسِمُ بِعَاطِفَةٍ شَدِيدَة)",
 "perfidious": "خَؤُون, غَادِر (يَمِيل إِلَى الخِيَانَة؛ خَاصَّةً ذُو طَبِيعَة غَادِرَة)",
 "perfidiously": "بخيانة, بغدر (بطريقة غادرة)\nمثال: كان يلعب بغدر بين الطرفين ضد بعضهما البعض",
 "perfidiousness": "خِيَانَة, غَدْر (خيانة الأمانة)",
 "perfidy": "خيانة, غدر (فعل خيانة متعمد) / خِيَانَة, غَدْر (خيانة الأمانة)",
 "perfluorocarbon": "بيرفلوروكربون (غاز دفيئة قوي ينبعث أثناء إنتاج الألومنيوم)",
 "perfoliate": "مُحِيطِيّ الوَرَقَة ((عن الورقة) قاعدتها مُحيطة بالساق وتبدو كأنّ الساق يخترقها)",
 "perfoliate leaf": "ورقة محيطة بالساق (ورقة تتحد قاعدتها حول الساق - وتبدو كأن الساق تخترقها)",
 "perforate": "مَثْقُوب, مَخْرُوق (به ثقب مقطوع فيه)",
 "perforated": "مُثَقَّب (به عدد أو سلسلة من الثقوب) / مَثْقُوب, مَخْرُوق (به ثقب مقطوع فيه)",
 "perforated eardrum": "طبلة أذن مثقوبة (طبلة أذن بها ثقب أو تمزق؛ يمكن أن تتداخل مع السمع الطبيعي وتسبب مشاكل أخرى في الأذن)",
 "perforating vein": "وريد ثاقب (أوردة ترافق الشرايين الثاقبة؛ تصرف عضلات الساق؛ تصب في الوريد الفخذي العميق)",
 "perforation": "تثقيب, تخريم (فعل ثقب حفرة (خاصة صف من الثقوب لسهولة الفصل)) / تثقيب, خط ثقوب (خط من الثقوب الصغيرة للتمزيق في مكان معين) / تثقيب, خرق (ثقب مصنوع في شيء ما)\nمثال: ثقب في طبلة الأذن",
 "perforce": "اضْطِرَارًا, بِالضَّرُورَة (عن طريق الضرورة؛ بحكم الظروف)",
 "perform": "أَدَّى",
 "performance": "أَدَاء / مَسْرَحِيَّة",
 "performance bond": "سند حسن التنفيذ, ضمان الأداء (سند يُعطى لحماية المستلم من الخسارة في حال عدم الوفاء بشروط العقد؛ تتحمل شركة الضمان المسؤولية عن عدم الأداء)",
 "performance capability": "قدرة الأداء, قدرة تشغيلية (قدرة النظام التكنولوجي على الأداء كما هو مقصود)",
 "performative verb": "فعل أدائي, فعل إنجازي (فعل ينقل صراحة نوع العمل الكلامي الذي يتم تأديته)\nمثال: لهذا السبب يسمى 'أعتذر' فعلاً إنجازياً، لأنه يصف ويعبر عن الفعل الكلامي في آن واحد",
 "performer": "عَازِف",
 "performing": "أداء, تمثيل (أداء دور في عمل درامي)",
 "performing artist": "فنان استعراضي, مؤدٍ (فنان ترفيهي يؤدي عملاً درامياً أو موسيقياً لجمهور)",
 "performing arts": "فنون أدائية (فنون أو مهارات تتطلب أداءً عاماً)",
 "perfume": "أَرِيج, عَبِير / عَطَّرَ (جعل شيئًا مُعَطَّرًا بإضافة العطر إليه؛ أضفى على شيء أو مكان شعورًا جميلًا أو انطباعًا مميزًا)\nمثال: هذا العطر يجعلني أشعر بالمرض.",
 "perfumed": "عَبِق, فَوَّاح (ذُو عُطْرٍ طَبِيعِيٍّ) / مُتَضَمِّخٌ بِالعِطْر, مُعَطَّر (مَمْلُوءٌ بِالعِطْرِ أَوْ مُشَبَّعٌ بِهِ)",
 "perfumer": "عَطَّار, عَطَّارَة",
 "perfumery": "عِطَارَة",
 "perfunctorily": "بِلَا اهْتِمَام, شَكْلِيًّا (بطريقة محددة دون اهتمام جاد؛ كإجراء شكلي)\nمثال: أجابوا على رسالتي شكلياً",
 "perfunctory": "سَطْحِيّ, عَابِر (مُسْتَعْجِل وبِدُون اهْتِمَام بِالتَّفَاصِيل؛ غَيْر شَامِل) / شَكْلِيّ, صُورِيّ (يُؤَدَّى أَوْ يُنْتَجُ كَإِجْرَاءٍ شَكْلِيٍّ فَحَسْبُ)",
 "perfusion": "إرواء, تروية (ضخ سائل في عضو أو نسيج (خاصة عن طريق الأوعية الدموية))",
 "pergola": "عريشة (هيكل يدعم النباتات المتسلقة)\nمثال: وفرت العريشة مكاناً ظليلاً للراحة في الحديقة",
 "perhaps": "رُبَّمَا / مِن اَلْمُمْكِن (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / لَعَلَّ (يفيد التوقع مع الترجي؛ يفيد التوقع مع الإشفاق والخوف)\nمثال: يا لها من جملة!",
 "peri": "بيري, حورية فارسية ((فلكلور فارسي) كائن خارق للطبيعة ينحدر من الملائكة الساقطين ومستبعد من الجنة حتى يتم التكفير) / حسناء, حورية (فتاة جميلة ورشيقة)",
 "peri-urban": "طَرِيق فَرْعِيّ (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من ٱلشَّارِعِ، سَبِيل)\nمثال: أسأل عن الطريق.",
 "periactin": "بيرياكتين, سيبروهيبتادين (مضاد للهيستامين (الاسم التجاري بيرياكتين) يستخدم لعلاج بعض تفاعلات الحساسية)",
 "perianal": "حول الشرجي (يقع حول فتحة الشرج)",
 "perianth": "غلاف زهري (مصطلح جماعي للأجزاء الخارجية للزهرة المكونة من الكأس والتويج وتحيط بالأسدية والمدقات)",
 "periapsis": "حضيض, نقطة الحضيض ((في الفلك) النقطة في المدار الأقرب إلى الجسم الذي يتم الدوران حوله)",
 "periarterial plexus": "ضفيرة حول الشريان (ضفيرة ذاتية ترافق الشريان)",
 "periarteritis": "التهاب حول الشريان (التهاب الغلاف الخارجي للشريان)",
 "periarteritis nodosa": "التهاب الشرايين العقدة (مرض تدريجي للأنسجة الضامة يتميز بوجود عقيدات على طول الشرايين)",
 "pericallis cruenta": "سينراريا (عشب من جزر الكناري يُزرع على نطاق واسع لزهوره الزرقاء أو الأرجوانية أو الحمراء أو المتنوعة التي تشبه الأقحوان)",
 "pericallis hybrida": "سينراريا هجينة (عشب مشتق من السينراريا ويُزرع على نطاق واسع بأشكال مزهرة بغزارة بألوان من الأبيض إلى الوردي إلى الأحمر أو الأرجواني أو البنفسجي أو الأزرق)",
 "pericardiac": "تاموري (يقع حول القلب أو متعلق بالتامور (غشاء القلب) أو يؤثر فيه)\nمثال: الحيز التاموري",
 "pericardial": "تَأْمُورِيّ",
 "pericardial cavity": "تجويف التامور (الحيز بين طبقات التامور الذي يحتوي على سائل يزيت أسطح الغشاء ويسمح بحركة القلب بسهولة)",
 "pericardial sac": "كيس التامور (الغشاء المحيط بالقلب)",
 "pericardial space": "تجويف التامور (الحيز بين طبقات التامور الذي يحتوي على سائل يزيت أسطح الغشاء ويسمح بحركة القلب بسهولة)",
 "pericardial vein": "وريد تاموري (عدة أوردة صغيرة من التامور)",
 "pericarditis": "اِلْتِهَاب التَّأْمُور",
 "pericardium": "تَأْمُور",
 "pericarp": "جِدَارُ الثَّمَرَة, غِلافُ الثَّمَرَة (الجدران الناضجة والمتحورة لمبيض النبات)",
 "pericementoclasia": "تحلل رباط السن (تكون جيب قيحي حول السن)",
 "periclase": "بيريكلاز, مغنيسيا (معدن صلب أبيض يوجد بشكل طبيعي كأكسيد مغنيسيوم؛ مصدر للمغنيسيوم)",
 "peridinian": "بيريدينيوم (سوطي له قشرة سميكة مكونة من صفائح)",
 "peridium": "صِوَان, غِلافُ الفِطْر (الطبقة الخارجية للعضو الحامل للأبواغ في العديد من الفطريات)",
 "peridot": "زَبَرْجَد",
 "peridotite": "بيريدوتيت (صخر ناري خشن الحبيبات داكن يتكون بشكل أساسي من الأوليفين)",
 "perigee": "حضيض أرضي (نقطة الحضيض في مدار حول الأرض؛ النقطة في مدار القمر الصناعي حيث يكون أقرب ما يكون إلى الأرض)",
 "perigon": "زاوية دائرية, زاوية كاملة (زاوية قياسها 360 درجة)",
 "perigonal": "كمي, محيطي بالزهرة (مكون من أو متعلق بالمحيط الزهري (الكم))",
 "perigone": "غلاف زهري (مصطلح جماعي للأجزاء الخارجية للزهرة المكونة من الكأس والتويج وتحيط بالأسدية والمدقات)",
 "perigonium": "غلاف زهري (مصطلح جماعي للأجزاء الخارجية للزهرة المكونة من الكأس والتويج وتحيط بالأسدية والمدقات)",
 "perihelion": "حضيض شمسي (نقطة الحضيض في المدار الشمسي؛ النقطة في مدار كوكب أو مذنب حيث يكون أقرب ما يكون إلى الشمس)",
 "perijove": "حضيض المشتري (نقطة الحضيض في المدار حول كوكب المشتري)",
 "peril": "خَطَر (خطر في مشيه: اهتز وتبختر؛ خطر بذنبه: رفعه مرة وخفضه أخرى، أو حركه يمينا وشمالا)\nمثال: أنا ذاهب للخطر.",
 "perilla frutescens crispa": "بريلا, نبات شريحة اللحم (نبات يزرع لأوراقه الحمراء أو الأرجوانية الزخرفية)",
 "perilous": "مخوف",
 "perilously": "بخطورة, بشكل خطير (بطريقة خطيرة)\nمثال: اقترب بشكل خطير من السقوط عن الحافة",
 "perilousness": "خطورة (حالة كونه خطيراً)",
 "perilune": "حضيض قمري (نقطة الحضيض في المدار حول القمر)",
 "perilymph": "لمف خارجي (السائل الجسدي الذي يملأ الفراغ بين التيه العظمي والتيه الغشائي للأذن الداخلية)",
 "perimeter": "مُحِيط (في : هو الخط المستدير الذي يُحيط بالشكل الهندسي؛ في : البَحْر المُحِيْط هو البحر الكبير الذي يحيط بالقارات. الاستخدام الحديث يحذف كلمة بَحْر؛ القَامُوْس)\nمثال: أسبح في المحيط.",
 "perimysium": "حول العضل, غمد الحزمة العضلية (غمد من النسيج الضام يغطي حزمة من الألياف العضلية)",
 "perinasal": "حول أنفي (يقع بالقرب من الأنف)",
 "perinatal": "حَوْل الوِلَادَة (يحدث خلال الفترة المحيطة بالولادة (5 أشهر قبل وشهر واحد بعد))\nمثال: وفيات الفترة المحيطة بالولادة",
 "perinatologist": "طبيب طب الفترة المحيطة بالولادة (طبيب توليد متخصص في طب الفترة المحيطة بالولادة)",
 "perinatology": "طب الفترة المحيطة بالولادة (فرع التوليد المعني بتشريح وفسيولوجيا وتشخيص وعلاج اضطرابات الأم والجنين أو الوليد خلال أواخر الحمل والولادة والنفاس)",
 "perineal": "عجاني (متعلق بالعجان (المنطقة بين الشرج والأعضاء التناسلية))\nمثال: آلام عجان",
 "perineal artery": "شريان عجاني (فرع من الشريان الفروجي الداخلي يغذي التراكيب السطحية للعجان)",
 "perineotomy": "بضع العجان (شق جراحي في منطقة العجان)",
 "perineum": "عِجَان",
 "perineurium": "حول العصب, غمد الحزمة العصبية (غمد من النسيج الضام يغطي حزمة من الألياف العصبية)",
 "period": "نُقْطَة, عَلَامَة فَصْلِيَّة (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه) / حِصَّةٌ / عَصْر (مصدر للفعل \"عَصَرَ\"؛ أي مدة زمنية، دهر من الوقت)\nمثال: هذه هي نقطة ضعفه.",
 "period of play": "فترة اللعب, لعب ((في الألعاب أو المسرحيات أو العروض الأخرى) الوقت الذي يستمر فيه اللعب)\nمثال: أوقف المطر اللعب في الشوط الرابع",
 "period of time": "فترة, فترة زمنية (مقدار من الزمن)\nمثال: فترة زمنية تمتد لثلاثين عاماً",
 "period piece": "عمل فني تاريخي (أي عمل فني تكمن قيمته الخاصة في استحضاره لفترة تاريخية)",
 "periodic": "دَوْرِيّ, عَرَضِيّ (يَتَكَرَّرُ أَوْ يَظْهَرُ مِنْ حِينٍ لِآخَر) / دوري (يحدث أو يتكرر على فترات منتظمة)\nمثال: الظهور الدوري للجراد ذي السبعة عشر عاماً",
 "periodic acid": "حمض البيريوديك (أي حمض لليود يحتوي على الأكسجين)",
 "periodic apnea of the newborn": "انقطاع النفس الدوري لحديثي الولادة (تنفس غير منتظم لحديثي الولادة؛ فترات من التنفس السريع يتبعها انقطاع النفس؛ يُعتقد أنه يرتبط بمتلازمة موت الرضيع المفاجئ)",
 "periodic breathing": "تنفس تشاين-ستوكس, تنفس دوري (تنفس غير طبيعي تتناوب فيه فترات من التنفس الضحل والعميق)",
 "periodic edema": "وذمة وعائية (مناطق محددة كبيرة متكررة من وذمة تحت الجلد؛ تبدأ فجأة وتختفي خلال 24 ساعة؛ تظهر بشكل رئيسي عند الشابات، غالباً كرد فعل تحسسي للطعام أو الأدوية)",
 "periodic event": "حدث دوري, حدث متكرر (حدث يتكرر على فترات زمنية)",
 "periodic law": "القانون الدوري, قانون مندليف ((كيمياء) المبدأ القائل بأن الخواص الكيميائية للعناصر هي دوال دورية لأعدادها الذرية)",
 "periodic motion": "حركة دورية (حركة تتكرر مراراً وتكراراً وتظل الفترة الزمنية المطلوبة لكل تكرار كما هي)",
 "periodic movement": "حركة دورية (حركة تتكرر مراراً وتكراراً وتظل الفترة الزمنية المطلوبة لكل تكرار كما هي)",
 "periodic sentence": "جملة دورية (جملة معقدة تأتي فيها الجملة الرئيسية أخيراً وتسبقها الجملة التابعة)",
 "periodic table": "الْجَدْوَلُ الدَّوْرِيّ",
 "periodical": "دوري (يحدث أو يتكرر على فترات منتظمة) / دورية (منشور يظهر في فترات زمنية محددة)\nمثال: الظهور الدوري للجراد ذي السبعة عشر عاماً",
 "periodical cicada": "زيز السبعة عشر عاماً (زيز من أمريكا الشمالية؛ يظهر بأعداد كبيرة على فترات متباعدة لأن الحوريات تستغرق 13 إلى 17 عاماً لتنضج)",
 "periodically": "بِشَكْل دَوْرِيّ",
 "periodicity": "دَوْرِيَّة (صفة التكرار على فترات منتظمة)",
 "periodontal": "لثوي, متعلق بدواعم الأسنان (متعلق بعلاج دواعم الأسنان (اللثة والعظام))\nمثال: مرض دواعم الأسنان",
 "periodontal disease": "التهاب اللثة, مرض دواعم السن (مرض يهاجم اللثة والعظام حول الأسنان)",
 "periodontia": "طب دواعم الأسنان, علاج اللثة (فرع طب الأسنان الذي يتعامل مع أمراض اللثة والهياكل الأخرى حول الأسنان)",
 "periodontic": "لثوي, متعلق بدواعم الأسنان (متعلق بعلاج دواعم الأسنان (اللثة والعظام))\nمثال: مرض دواعم الأسنان",
 "periodontics": "طب دواعم الأسنان, علاج اللثة (فرع طب الأسنان الذي يتعامل مع أمراض اللثة والهياكل الأخرى حول الأسنان)",
 "periodontist": "أخصائي دواعم الأسنان (طبيب أسنان متخصص في أمراض اللثة والهياكل المحيطة بالأسنان)",
 "periodontitis": "التهاب اللثة, مرض دواعم السن (مرض يهاجم اللثة والعظام حول الأسنان)",
 "perionyx": "قِنَاب",
 "periosteum": "سِمْحَاق",
 "peripatetic": "جَوَّاب, مُسَافِر (يسافر ويتنقّل خاصّة سيرًا على الأقدام) / أرسطي, مشائي (من أو يتعلق بأرسطو أو فلسفته) / أَرِسْطِيّ, مَشَّائِيّ (تابع لأرسطو أو معتنق للأرسطية) / متجول (شخص يمشي من مكان لآخر)\nمثال: منطق أرسطي",
 "peripateticism": "أرسطية, مشائية ((فلسفة) فلسفة أرسطو التي تتعامل مع المنطق والميتافيزيقيا والأخلاق والشعر والسياسة والعلوم الطبيعية)\nمثال: أثرت الأرسطية بشكل عميق في الفكر الغربي",
 "peripatus": "حاملات المخالب, دودة مخملية (أي من الحيوانات آكلة اللحوم العديدة التي تشبه الديدان ذات الجلد المخملي الشائعة في الغابات الاستوائية ولها خصائص كل من المفصليات والديدان الحلقية)",
 "peripeteia": "انقلاب الأحداث, تحول مفاجئ (تغير مفاجئ وغير متوقع في الحظ أو عكس للظروف (خاصة في عمل أدبي))\nمثال: الانقلاب المفاجئ يحول بسرعة تسلسل الأحداث الروتيني إلى قصة تستحق السرد",
 "peripetia": "انقلاب الأحداث, تحول مفاجئ (تغير مفاجئ وغير متوقع في الحظ أو عكس للظروف (خاصة في عمل أدبي))\nمثال: الانقلاب المفاجئ يحول بسرعة تسلسل الأحداث الروتيني إلى قصة تستحق السرد",
 "peripety": "انقلاب الأحداث, تحول مفاجئ (تغير مفاجئ وغير متوقع في الحظ أو عكس للظروف (خاصة في عمل أدبي))\nمثال: الانقلاب المفاجئ يحول بسرعة تسلسل الأحداث الروتيني إلى قصة تستحق السرد",
 "peripheral": "طَرَفِيّ, مُحِيطِيّ (على أو بالقرب من حافة أو يشكل حداً خارجياً؛ المنطقة الخارجية) / طَرَفِيّ, هَامِشِيّ (مرتبط بالقضية الرئيسية لكنّه ليس ذا أهمية محورية) / جهاز طرفي, ملحق حاسوبي (معدات إلكترونية خارجية عن لوحة الدائرة التي تحتوي على وحدة المعالجة المركزية للكمبيوتر)\nمثال: المقاطعات الطرفية لروسيا",
 "peripheral device": "جهاز طرفي, ملحق حاسوبي (معدات إلكترونية خارجية عن لوحة الدائرة التي تحتوي على وحدة المعالجة المركزية للكمبيوتر)\nمثال: محركات الأقراص والطابعات هي أجهزة طرفية مهمة",
 "peripheral nervous system": "الجهاز العصبي المحيطي (قسم الجهاز العصبي الذي يقع خارج الدماغ والحبل الشوكي)",
 "peripheral vision": "رؤية جانبية, رؤية محيطية (الرؤية عند حواف المجال البصري باستخدام محيط الشبكية فقط)",
 "peripherally": "طرفياً, محيطياً (في أو عند أو بالقرب من محيط أو وفقاً لدور أو وظيفة أو علاقة محيطية)",
 "periphery": "أطراف, حد خارجي (الحد الخارجي أو سطح شيء ما)",
 "periphrasis": "إطناب, لف ودوران (أسلوب يتضمن طرقاً غير مباشرة للتعبير عن الأشياء)",
 "periphrastic": "إِطْنَابِيّ, مُسْهِب (مُوَارِب وَمُطْنِب بِلَا دَاعٍ)",
 "periplaneta americana": "صرصور أمريكي (صرصور كبير بني محمر حر الطيران أصله من جنوب الولايات المتحدة ولكنه الآن واسع الانتشار)",
 "periplaneta australasiae": "صرصور أسترالي (واسع الانتشار في البلدان الدافئة)",
 "periploca graeca": "بيريبلوكا, كرمة الحرير (متسلق متساقط الأوراق للأقواس والأسوار له أزهار مثيرة للاهتمام ولكن كريهة الرائحة وثمار صفراء سامة؛ يزرع لأوراقه اللامعة الداكنة؛ جنوب شرق أوروبا إلى…)",
 "peripteral": "مُحِيطِيّ الأَعْمِدَة (له أعمدة على جميع الجوانب)",
 "perirhinal": "حول أنفي (يقع بالقرب من الأنف)",
 "periscope": "بيريسكوب, منظار الأفق (أداة بصرية توفر رؤية لمجال محجوب)",
 "periselene": "حضيض قمري (نقطة الحضيض في المدار حول القمر)",
 "perishability": "زَوَال, قَابِلِيَّة التَّلَف (عدم الإرضاء بحكم كون الشيء عرضة للتلف أو الفساد أو الدمار)",
 "perishable": "فان, قابل للتلف (عرضة للهلاك؛ خاضع للدمار أو الموت أو التحلل) / طعام قابل للتلف (طعام سيفسد بسرعة إذا لم يبرد)\nمثال: هذا الكوكب الدقيق والفاني",
 "perishableness": "زَوَال, قَابِلِيَّة التَّلَف (عدم الإرضاء بحكم كون الشيء عرضة للتلف أو الفساد أو الدمار)",
 "perisher": "شقي, وغد (شخص دنيء أو سيء السلوك)",
 "perisoreus canadensis": "قيق كندي (قيق من شمال أمريكا الشمالية ذو رأس أسود القبعة وبدون عرف؛ يشتهر بجرأته في السرقة)",
 "perisoreus canadensis capitalis": "قيق جبال روكي (قيق كندي ذو رأس أبيض؛ واسع الانتشار من مونتانا إلى أريزونا)",
 "perisperm": "بيريسبرم, محيط السويداء (النسيج المغذي خارج الكيس المحتوي على الجنين في بعض البذور)",
 "perissodactyl": "حيوان مفرد الأصابع, مفردات الأصابع (ثدييات مشيمية لها حوافر بعدد فردي من الأصابع في كل قدم)",
 "perissodactyl mammal": "حيوان مفرد الأصابع, مفردات الأصابع (ثدييات مشيمية لها حوافر بعدد فردي من الأصابع في كل قدم)",
 "peristalsis": "تَمَعُّج",
 "peristedion miniatum": "روبن البحر المدرع (روبن بحر له حراشف عظمية على الجسم وشعيرات على الذقن؛ يوجد غالباً على المنحدر القاري)",
 "peristome": "مُحِيط الفَم (المنطقة المحيطة بالفم في مختلف اللافقاريات) / فم العلبة, محيط الفم ((في علم النبات) طوق من الزوائد التي تشبه الأسنان تحيط بفم علبة الحزاز)",
 "peristylar": "مُحِيطِيّ الأَعْمِدَة (ذو أعمدة تحيط بالبناء من جميع الجهات)",
 "peristyle": "رواق محيط, فناء معمد (صف أعمدة يحيط بمبنى أو يطوق فناءً)",
 "perithecium": "ثمرة دورقية (ثمرة زقية قارورية الشكل)",
 "perithelial": "حول ظهاري (مكون من أو متعلق بطبقة الأنسجة حول الأوعية الدموية الصغيرة)",
 "perithelium": "محيط الشعيرات (طبقة نسيجية حول الأوعية الدموية الصغيرة)",
 "peritoneal": "بريتوني, صفاقي (من أو يتعلق بالصفاق (البريتوان) أو يؤثر عليه)\nمثال: سرطان الصفاق",
 "peritoneal cavity": "تجويف بريتوني, كيس صفاقي أكبر (الجزء الداخلي من الصفاق؛ حيز محتمل بين طبقات الصفاق)",
 "peritoneal inflammation": "التهاب البريتوان, التهاب الصفاق (التهاب الصفاق (الغشاء البريتوني))",
 "peritoneum": "صِفَاق",
 "peritonitis": "التهاب البريتوان, التهاب الصفاق (التهاب الصفاق (الغشاء البريتوني))",
 "peritonsillar abscess": "خراج حول اللوزة, خناق (التهاب مؤلم مليء بالقيح في اللوزتين والأنسجة المحيطة بهما؛ عادة ما يكون من مضاعفات التهاب اللوزتين)",
 "peritrate": "بنتا إريثريتول (موسع للأوعية التاجية (الاسم التجاري بيريتريت) يستخدم لعلاج الذبحة الصدرية)",
 "peritrichous": "مُحَاط بِالأَسْوَاط (مُغَطًّى بالكامل بأسواط موزعة بشكل منتظم)",
 "periwig": "باروكة قديمة (شعر مستعار للرجال كان شائعاً في القرنين السابع عشر والثامن عشر)",
 "periwigged": "مُرْتَدٍ بَارُوكَة (يرتدي باروكة من الطراز الشائع لدى الرجال في القرنين السابع عشر والثامن عشر)",
 "periwinkle": "برونكل (بطني قدم بحري صالح للأكل) / بروينكل, حلزون بحري (حلزون بحري صغير صالح للأكل؛ يطهى بالبخار في النبيذ أو يخبز) / عناقية, عين البزون (عشب خشبي من العالم القديم يزرع عادة وله أزهار كبيرة وردية إلى حمراء) / عناقية, فنكا (نباتات سامة زاحفة بشكل رئيسي بزهور زرقاء)",
 "periwinkle plant derivative": "مشتق نبات العناقية (دواء مضاد للأورام يستخدم لعلاج بعض أشكال السرطان عن طريق تعطيل انقسام الخلايا)",
 "perjurer": "حانث باليمين, شاهد زور (شخص يدلي بشهادة كاذبة عمداً)",
 "perjury": "شَهَادَة زُور",
 "perk": "امتياز وظيفي, ميزة إضافية (ميزة عرضية تُمنح لأنواع معينة من التوظيف (خاصة إذا كانت تُعتبر حقاً))\nمثال: سيارة الليموزين هي إحدى الامتيازات الإضافية للوظيفة",
 "perked up": "مُبْتَهِج, مُنْتَعِش (أصبح أكثر بهجة ونشاطًا وحيويّة)",
 "perkily": "بزهو, بمرح (بطريقة مرحة ونشطة)\nمثال: ملتصق بزهو، مثل نتوء على تنورة امرأة",
 "perkiness": "تطاول, وقاحة (مرح غير لائق) / تفاؤل, خفة روح (البهجة التي تطفو على السطح)",
 "perky": "حَيَوِيّ, نَشِيط (يتّسم بالحيويّة وخفّة الروح)",
 "perleche": "التهاب الشفة الزاوي, تشقق الشفاه (اضطراب في الشفاه يتميز بتقشر وشقوق في زوايا الفم؛ ناتج عن نقص في الريبوفلافين)",
 "perlis": "برليس",
 "perm": "بِيرْم",
 "permafrost": "تُربَةُ صَقِيعِيّة",
 "permalloy": "بيرمالوي (سبيكة بنسبة 80/20 من النيكل والحديد؛ تتمغنط وتزول مغنطتها بسهولة)",
 "permanence": "دَوَام (دَوَام)\nمثال: أنا أعمل بدوام جزئي.",
 "permanency": "بقاء, ديمومة (خاصية القدرة على الوجود لمدة غير محددة)",
 "permanent": "دَائِم",
 "permanent injunction": "أمر قضائي دائم (أمر قضائي يصدر عند الانتهاء من المحاكمة)",
 "permanent magnet": "مغناطيس دائم (مغناطيس يحتفظ بمغنطته بعد إزالته من المجال المغناطيسي)",
 "permanent press": "قماش مقاوم للتجعد (قماش تمت معالجته كيميائياً لمقاومة التجاعيد والحفاظ على شكله)",
 "permanent tooth": "سن دائمة (أي من الأسنان الـ 32 التي تحل محل الأسنان اللبنية في مرحلة الطفولة المبكرة ويمكن أن تستمر حتى الشيخوخة)",
 "permanent wave": "بَيْرِم, تَمْوِيج دَائِم (سلسلة من التموجات في الشعر تصنع بتطبيق الحرارة والمواد الكيميائية)",
 "permanent-press": "لَا يَحْتَاج كَيًّا (يُستخدم للأقمشة التي لا تحتاج إلى كيّ)",
 "permanently": "إلى الأبد, بشكل دائم (لفترة طويلة دون تغيير جوهري)\nمثال: هو معاق بشكل دائم",
 "permanganate": "برمنغنات (ملح أرجواني غامق لحمض البرمنغنيك؛ يستخدم في المحلول المائي كمطهر ومعقم)",
 "permanganate of potash": "برمنغنات البوتاسيوم (ملح سام يشكل بلورات أرجوانية داكنة ويكون لونه أحمر أرجواني عند ذوبانه في الماء؛ يستخدم كعامل مؤكسد ومبيض وكمطهر ومعقم)",
 "permanganic acid": "حمض البرمنغنيك (أصبح حامضًا، تغير الطعم إلى الحموضة؛ ارتفعت نسبة الحموضة في شيء ما، كما في الطعام أو السوائل)\nمثال: رمى ياني الحمض على وجه سكورة.",
 "permeability": "نفاذية (خاصية الشيء الذي يمكن للسائل أن يتخلله (كما في التناضح أو الانتشار))",
 "permeable": "مسامي, نفاذ (يسمح للسوائل أو الغازات بالمرور أو الانتشار من خلاله)\nمثال: أغشية نفاذة",
 "permeableness": "نفاذية (خاصية الشيء الذي يمكن للسائل أن يتخلله (كما في التناضح أو الانتشار))",
 "permeant": "سَارٍ, مُتَغَلْغِل (ينتشر أو منتشر في كل مكان)",
 "permeating": "سَارٍ, مُتَغَلْغِل (ينتشر أو منتشر في كل مكان)",
 "permeation": "تداخل, تغلغل متبادل (اختراق متبادل؛ انتشار كل طرف خلال الآخر) / تشرب, تغلغل (عملية تغلغل مادة في شيء ما أو تشبعه بها)",
 "permeative": "سَارٍ, مُتَغَلْغِل (ينتشر أو منتشر في كل مكان)",
 "permed": "مُمَوَّجٌ صِنَاعِيًّا ((عَنِ الشَّعْرِ) مُصَفَّفٌ بِتَمْوِيجٍ دَائِمٍ)",
 "permic": "اللغات البيرمية (مجموعة من اللغات الفينية يتم التحدث بها في شمال غرب جبال الأورال)",
 "permille": "فِي الْأَلْف, بِالْأَلْف (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "permissibility": "إِبَاحَة, جَوَاز (الجواز كنتيجة لكون الشيء مسموحاً به)",
 "permissible": "جَائِز",
 "permissibly": "بشكل مسموح به (بطريقة مسموح بها)",
 "permission": "تَصْرِيح, سَمَاح",
 "permissive": "إباحي, متساهل (يمنح أو يميل أو قادر على منح الإذن؛ غير صارم في الانضباط) / تجويزي, سماحي (ليس مانعاً)\nمثال: التشريع الأساسي المباشر هو تساهلي إلى حد كبير بدلاً من أن يكون ملزماً",
 "permissive waste": "إضرار بالمال, تبديد الممتلكات ((قانون) انخفاض في قيمة العقار ناتج عن فعل أو إهمال)",
 "permissively": "بتساهل (بطريقة متساهلة)",
 "permissiveness": "تسامح, تساهل (الميل للسماح بحرية الاختيار والسلوك)",
 "permissivism": "إباحية, تساهل (التساهل تجاه مجموعة واسعة من السلوكيات الاجتماعية أو التسامح معها)",
 "permit": "أَذِنَ, سَمَحَ (أَذَن؛ أَذَنَ: ( فعل ) أَذَنَ أَذْناً) / رُخْصَة / رُخُصَة\nمثال: من أذن لتوم باستعارة سيارتي?",
 "permutability": "تَبْدِيلِيَّة, قَابِلِيَّة لِلتَّبْدِيل (القدرة على تغيير الترتيب التسلسلي)",
 "permutable": "قَابِل لِلتَّبْدِيل, قَابِل لِلتَّقْلِيب (يمكن تغيير ترتيبه أو تسلسله)",
 "permutableness": "تَبْدِيلِيَّة, قَابِلِيَّة لِلتَّبْدِيل (القدرة على تغيير الترتيب التسلسلي)",
 "permutation": "تَبْدِيل",
 "pernambuco": "بِيرْنَامْبُوكُو",
 "pernambuco wood": "خشب البرازيل, خشب الخوخ (شجرة استوائية ذات جذع شائك؛ ينتج خشبها الأحمر الثقيل صبغة حمراء ويستخدم في صناعة الخزائن)",
 "pernicious": "خَبيث, فَتّاك (يُلحِق ضَرَرًا تَدْريجِيًّا خَفِيًّا ولكِنَّه بالِغ) / فَتَّاك, مُهْلِك (بالغ الضرر إلى أقصى حدّ)",
 "pernicious anaemia": "فقر الدم الخبيث, فقر الدم الوبيل (فقر دم مزمن ومترقٍ يصيب كبار السن؛ يُعتقد أنه ناتج عن نقص في العامل الداخلي (مادة تفرزها المعدة مسؤولة عن امتصاص فيتامين ب12))",
 "pernicious anemia": "فقر الدم الخبيث, فقر الدم الوبيل (فقر دم مزمن ومترقٍ يصيب كبار السن؛ يُعتقد أنه ناتج عن نقص في العامل الداخلي (مادة تفرزها المعدة مسؤولة عن امتصاص فيتامين ب12))",
 "perniciously": "بِضَرَر بَالِغ, بِوَبَال (بطريقة ضارة ومؤذية) / بشكل خبيث, بمكر (بطريقة ماكرة وضارة بشكل خفي)\nمثال: هذا المناخ المسموم بشكل ضار",
 "perniciousness": "خُبْث, سُمِّيَّة (ضرر جسيم أو فتك)",
 "pernickety": "مُبَالِغ فِي الدِّقَّة (يَتَّسِم بِدِقَّة مُفْرِطَة وَاهْتِمَام بِالتَّفَاصِيل التَّافِهَة)",
 "pernio": "تورم بردي, شرى البرد (التهاب اليدين والقدمين الناتج عن التعرض للبرد والرطوبة)",
 "pernis apivorus": "حوام النحل (صقر من العالم القديم يتغذى على يرقات النحل والقوارض الصغيرة والزواحف)",
 "pernod": "بيرنو ((علامة تجارية مسجلة) ليكير منكه باليانسون)",
 "pernyi moth": "عثة بيرني (عثة صينية تنتج حريراً بنياً)",
 "perodicticus potto": "بوتو (نوع من الليمور الرمادي البني)",
 "perognathus flavescens": "فأر جيبي للسهول (قارض صغير يعيش في المناطق المفتوحة لولايات السهول الأمريكية)",
 "perognathus flavus": "فأر جيبي حريري (قارض صغير ناعم الفراء مصفر شاحب يعيش في جنوب غرب الولايات المتحدة والمكسيك)",
 "perognathus hispidus": "فأر جيبي خشن الشعر (قارض كبير خشن الشعر يعيش في براري الأعشاب القصيرة في الولايات المتحدة)",
 "peromyscus eremicus": "فأر الصبار (فأر حفار من المناطق الصحراوية في جنوب غرب الولايات المتحدة)",
 "peromyscus gossypinus": "فأر القطن (فأر داكن كبير من جنوب شرق الولايات المتحدة)",
 "peromyscus leucopus": "فأر أبيض القدمين (فأر غابات أمريكي ذو أقدام وأجزاء سفلية بيضاء)",
 "peromyscus maniculatus": "فأر الغزلان (فأر بني من العالم الجديد؛ العضو الأكثر انتشاراً في الجنس)",
 "peroneal": "شظوي (متعلق بعظم الشظية أو الجزء الخارجي من الساق تحت الركبة)",
 "peroneal vein": "وريد شظوي (ترافق الشرايين الشظوية؛ تنشأ في الكعب وتمتد صعوداً خلف الساق لتنضم إلى الأوردة الظنبوبية الخلفية للوريد المأبضي)",
 "peroneus": "عضلة شظوية (عضلة الساق السفلية المشاركة في تحريك القدم)",
 "peronospora destructor": "بياض البصل (فطر يسبب بياضاً زغبياً على البصل)",
 "peronospora hyoscyami": "بياض التبغ (فطر يسبب بياضاً زغبياً على التبغ النامي)",
 "peronospora tabacina": "فطر العفن الأزرق (فطر يسبب مرضاً خطيراً في نباتات التبغ يتميز ببياض رمادي مزرق على الجانب السفلي للأوراق)",
 "peroration": "خاتمة الخطاب, خلاصة ((في البلاغة) القسم الختامي لخطبة) / خاتمة الخطبة (خطبة منمقة وبلاغية للغاية)\nمثال: لخص نقاطه الرئيسية في خاتمة الخطاب",
 "peroxidase": "بيروكسيداز (أي من مجموعة الإنزيمات (التي تحدث خاصة في الخلايا النباتية) التي تحفز أكسدة مركب بواسطة بيروكسيد)",
 "peroxide": "بيروكسيد, بيروكسيد الهيدروجين (سائل لزج ذو خصائص أكسدة قوية؛ عامل تبييض قوي؛ يستخدم أيضاً (في المحاليل المائية) كمطهر خفيف، وفي (التركيزات القوية) كمؤكسد في وقود الصواريخ) / بيروكسيد",
 "peroxide blond": "أشقر مصبوغ (شخص أشقر تم تبييض شعره بالبيروكسيد)",
 "peroxide blonde": "أشقر مصبوغ (شخص أشقر تم تبييض شعره بالبيروكسيد)",
 "perpendicular": "عَمُودِيّ, رَأْسِيّ",
 "perpendicular style": "الطراز العمودي, القوطية الإنجليزية (طراز قوطي ساد في إنجلترا في القرنين الرابع عشر والخامس عشر؛ يتميز بالخطوط الرأسية والقوس تيودور (أربعة مراكز) والقبو المروحي)",
 "perpendicularity": "تعامد (صفة التواجد بزوايا قائمة بالنسبة لخط أو مستوى معين (خاصة مستوى الأفق)) / تَعَامُد (علاقة التقابل بين الأشياء بزوايا قائمة)",
 "perpendicularly": "عمودياً (بطريقة متعامدة) / بشكل رأسي, عمودياً (بشكل مستقيم للأعلى أو للأسفل دون انقطاع)\nمثال: هذا الخط الأحمر يمتد عمودياً على الخط الأخضر",
 "perpetration": "ارتكاب, اقتراف (فعل ارتكاب جريمة)",
 "perpetrator": "مذنب, مرتكب الجريمة (شخص يرتكب مخالفة)",
 "perpetual": "دَائِم, لَا يَنْقَطِع (غَيْرُ مُنْقَطِعٍ فِي الزَّمَنِ وَمُسْتَمِرٌّ إِلَى أَجَلٍ غَيْرِ مُسَمًّى) / أَبَدِيّ, أَزَلِيّ (مستمرّ إلى الأبد أو إلى أجل غير مُسمًّى)",
 "perpetual calendar": "تقويم دائم (مخطط أو جهاز ميكانيكي يشير إلى أيام الأسبوع المقابلة لأي تاريخ معين على مدى فترة طويلة من السنوات)",
 "perpetual motion": "حركة أبدية (حركة تستمر إلى أجل غير مسمى دون أي مصدر خارجي للطاقة؛ مستحيلة عملياً بسبب الاحتكاك)",
 "perpetual motion machine": "آلة الحركة الدائمة (آلة يمكنها الاستمرار في العمل إلى ما لا نهاية دون سحب طاقة من مصدر خارجي؛ مستحيلة بموجب قانون حفظ الطاقة)",
 "perpetual warrant": "مذكرة دائمة (مذكرة اكتتاب ليس لها تاريخ انتهاء صلاحية)",
 "perpetually": "باستمرار, بشكل متواصل (بشكل ثابت لا يتغير) / بِشَكْل دَائِم, بِشَكْل مُسْتَمِرّ (بشكل دائم ومستمر لا ينقطع)\nمثال: العالم يتغير باستمرار",
 "perpetuate": "أَبَّدَ (الأبَد : الدَّهْرُ وَيُقَالُ الدَّهْرُ الطَّوِيلُ الَّذِي لَيْسَ بِمَحْدُودٍ؛ ما يَنْفُر القَلْب عن تقدير نهايته) / أَدَامَ / خَلَّدَ (الثَبَات المَدِيد والبَقَاء لفترة طويلة؛ دَوَام البَقَاء، يختلف عن السَرْمَد في أن السرمد مختص بالزمان تحديدا والخلد في غير ذلك)\nمثال: سأحبك إلى الأبد.",
 "perpetuation": "إطالة, تمديد (فعل إطالة مدة شيء ما)\nمثال: كان هناك تمديد غير محدد لمحادثات السلام",
 "perpetuity": "خُلْد (الثَبَات المَدِيد والبَقَاء لفترة طويلة؛ دَوَام البَقَاء، يختلف عن السَرْمَد في أن السرمد مختص بالزمان تحديدا والخلد في غير ذلك)\nمثال: خلد ياني إلى النوم.",
 "perphenazine": "بيرفينازين, تريافيل (مهدئ ومضاد للاكتئاب (الاسم التجاري تريافيل) يستخدم أحياناً كمضاد للقيء للبالغين)",
 "perpignan": "بِيرْبِينْيَا",
 "perplexed": "متحير, محتار (مليء بالصعوبة أو الارتباك أو الحيرة)\nمثال: لغة محيرة",
 "perplexedly": "بارتباك, بحيرة (بطريقة محتارة)\nمثال: نظر إلى أستاذه بحيرة",
 "perplexing": "مُحَيِّر, مُرْبِك (يفتقر إلى وضوح المعنى ويُسبّب الحيرة والارتباك)"
}
