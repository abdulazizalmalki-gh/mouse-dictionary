 "orthodox catholic church": "الكنيسة الأرثوذكسية, الكنيسة الأرثوذكسية الشرقية (مشتقة من الكنيسة البيزنطية وتلتزم بالطقوس البيزنطية)",
 "orthodox church": "الْكَنِيسَة الأُرْثُوذُكْسِيَّة",
 "orthodox jew": "يهودي أرثوذكسي (يهودي يمارس التزاماً صارماً بالشريعة الموسوية)",
 "orthodox judaism": "يهودية أرثوذكسية (معتقدات وممارسات طائفة يهودية تلتزم بصرامة بالشريعة الموسوية) / اليهودية الأرثوذكسية (اليهود الذين يلتزمون بصرامة بالشريعة الموسوية كما فسرها التلمود)",
 "orthodox sleep": "نوم حركة العين غير السريعة, نوم غير حالم (حالة نوم متكررة لا تحدث خلالها حركات العين السريعة ولا تحدث الأحلام؛ تمثل حوالي 75% من وقت النوم الطبيعي)",
 "orthodoxy": "أُرْثُوذُكْسِيَّة (أرثوذكسيَّة)",
 "orthoepist": "عالم النطق الصحيح (ممارس لعلم النطق الصحيح (خاصة أحد علماء القرنين السابع عشر والثامن عشر الذين اقترحوا إصلاح الهجاء الإنجليزي ليعكس النطق بشكل أقرب))",
 "orthoepy": "علم صحة النطق (مصطلح كان يستخدم سابقاً لجزء من علم الأصوات الذي يتعامل مع النطق 'الصحيح' للكلمات وعلاقته بالإملاء 'الصحيح') / لفظ, نطق (الطريقة التي تُنطق بها الكلمة أو اللغة عادة)\nمثال: نطق الصينية صعب على الأجانب",
 "orthogonal": "قَائِمُ الزَّوَايَا, مُتَعَامِد (لَهُ مَجْمُوعَةُ مَحَاوِرَ مُتَعَامِدَة؛ يَلْتَقِي بِزَوَايَا قَائِمَة) / مُتَعَامِدٌ إِحْصَائِيًّا (غير مرتبط إحصائياً) / خَارِجِيّ, غَيْرُ جَوْهَرِيّ (لا يتعلق بالمسألة قيد البحث)",
 "orthogonal opposition": "تَعَامُد (علاقة التقابل بين الأشياء بزوايا قائمة)",
 "orthogonality": "تعامد (صفة الوقوع أو التقاطع بزوايا قائمة) / تَعَامُد (علاقة التقابل بين الأشياء بزوايا قائمة)",
 "orthographic": "إِمْلَائِيّ",
 "orthography": "إِمْلَاء (الاسم من قراءة الشيء على أحد ما حتى يكتبه كما قُرِأ؛ الأمر بأشياء بدون السماح للمأمور بالمخالفة كأنه يُمْلِي عليه شيئا ليكتب) / عِلْم الْإِمْلَاء, هِجَاء (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "orthomolecular": "جُزَيْئِيّ تَقْويمِيّ (يَتَعَلَّق بِالطِّبّ الجُزَيْئِيّ التَّقْويمِيّ لِلحِفاظ عَلى الصِّحَّة)",
 "orthomorphic projection": "إسقاط متشاكل, إسقاط مطابق (إسقاط خرائطي يتم فيه رسم منطقة صغيرة بشكلها الحقيقي)",
 "orthomyxovirus": "أورثوميكسوفيروس, فيروس مخاطي قويم (مجموعة من الفيروسات تشمل تلك المسببة للإنفلونزا)",
 "orthopaedic": "أرثوبيدي, تقويمي (من أو متعلق بجراحة العظام والتقويم)\nمثال: أحذية تقويمية",
 "orthopaedics": "جراحة العظام, طب العظام (فرع العلوم الطبية المعني باضطرابات أو تشوهات العمود الفقري والمفاصل)",
 "orthopaedist": "أخصائي عظام, جبار (أخصائي في تصحيح تشوهات الجهاز الهيكلي (خاصة عند الأطفال))",
 "orthopedic": "أرثوبيدي, تقويمي (من أو متعلق بجراحة العظام والتقويم)\nمثال: أحذية تقويمية",
 "orthopedic foot insole": "نعل تقويم العظام, نعل طبي (نعل حذاء خاص يستخدم لتوفير دعم أفضل للقدمين، مما يخفف الألم)",
 "orthopedic insole": "نعل تقويم العظام, نعل طبي (نعل حذاء خاص يستخدم لتوفير دعم أفضل للقدمين، مما يخفف الألم)",
 "orthopedical": "أرثوبيدي, تقويمي (من أو متعلق بجراحة العظام والتقويم)\nمثال: أحذية تقويمية",
 "orthopedics": "جراحة العظام, طب العظام (فرع العلوم الطبية المعني باضطرابات أو تشوهات العمود الفقري والمفاصل)",
 "orthopedist": "أخصائي عظام, جبار (أخصائي في تصحيح تشوهات الجهاز الهيكلي (خاصة عند الأطفال))",
 "orthophosphate": "فوسفات (ملح لحمض الفوسفوريك)",
 "orthophosphoric acid": "حمض الفوسفوريك (أصبح حامضًا، تغير الطعم إلى الحموضة؛ ارتفعت نسبة الحموضة في شيء ما، كما في الطعام أو السوائل)\nمثال: رمى ياني الحمض على وجه سكورة.",
 "orthophosphorous acid": "حمض الهيبوفوسفوروز (أصبح حامضًا، تغير الطعم إلى الحموضة؛ ارتفعت نسبة الحموضة في شيء ما، كما في الطعام أو السوائل)\nمثال: رمى ياني الحمض على وجه سكورة.",
 "orthopnea": "ضيق النفس الاضطجاعي (شكل من أشكال ضيق التنفس حيث لا يستطيع الشخص التنفس براحة إلا عند الوقوف أو الجلوس بشكل مستقيم؛ يرتبط بالربو وانتفاخ الرئة والذبحة الصدرية)",
 "orthopristis chrysopterus": "سمكة الخنزير (توجد من لونغ آيلاند جنوباً)",
 "orthopter": "أورنيثوبتر, طائرة رفرافة (مركبة أثقل من الهواء يتم دفعها عن طريق رفرفة الأجنحة)",
 "orthopteran": "مستقيمات الأجنحة (أي من الحشرات المختلفة التي لها أجنحة أمامية جلدية وأجنحة خلفية غشائية وأجزاء فم ماضغة)",
 "orthopteron": "مستقيمات الأجنحة (أي من الحشرات المختلفة التي لها أجنحة أمامية جلدية وأجنحة خلفية غشائية وأجزاء فم ماضغة)",
 "orthopterous insect": "مستقيمات الأجنحة (أي من الحشرات المختلفة التي لها أجنحة أمامية جلدية وأجنحة خلفية غشائية وأجزاء فم ماضغة)",
 "orthoptic": "تقويمي للبصر (من أو متعلق بالرؤية بالعينين الطبيعية (تقويم البصر))",
