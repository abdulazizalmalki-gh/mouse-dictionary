 "passing shot": "ضربة عابرة (رد تنس يمر بجانب الخصم الذي اقترب من الشبكة)",
 "passing tone": "نغمة عابرة (نوتة غير هارمونية تُدرج للانتقال بين النوتات الهارمونية)",
 "passing water": "تبول (تعبير مخفف للتبول)",
 "passion": "عَاطِفَة, شَغْف / عَزْم / شَغَف (المرضُ فلانًا: وصل المرض شِغاف قلبه فالقلب عليل فيه مرض؛ الحبُّ فلانًا: وصل إلى شِغَاف قلبه. وقيل: دخل الحب تحت الشغاف. وقيل: غشى القلب تماما)\nمثال: قبل توم ماري بشغف.",
 "passion fruit": "ثَمَرَة زَهْرَة اَلْآلَام, فَاكِهَة زَهْرَة اَلْآلَام",
 "passion of christ": "آلام المسيح (معاناة يسوع عند الصلب)",
 "passion play": "مسرحية الآلام (مسرحية تمثل آلام المسيح)",
 "passion sunday": "أحد الآلام (ثاني أحد قبل عيد الفصح)",
 "passion week": "أسبوع الآلام, الأسبوع المقدس (الأسبوع الذي يسبق عيد الفصح)",
 "passionate": "شَغُوف, مُتَحَمِّس",
 "passionately": "باضطراب, بشغف (بطريقة عاصفة أو عنيفة) / بشغف, بعاطفة جياشة\nمثال: قبلته بشغف",
 "passionateness": "شغف, عاطفة جياشة (شعور أو عاطفة قوية)",
 "passionflower": "باسيفلورا, زهرة الآلام (أي من الكروم الأمريكية الاستوائية المتنوعة التي يحمل بعضها ثماراً صالحة للأكل)",
 "passionflower vine": "باسيفلورا, زهرة الآلام (أي من الكروم الأمريكية الاستوائية المتنوعة التي يحمل بعضها ثماراً صالحة للأكل)",
 "passionless": "بِلَا عَاطِفَة, خَالٍ مِنَ المَشَاعِر (لا تُحرِّكه المشاعر أو العواطف) / بارد المشاعر, بلا شغف (غير عاطفي)\nمثال: مراقبة باردة للطبيعة البشرية",
 "passive": "مَبْنِيٌّ لِلْمَجْهُول",
 "passive aggression": "عدوانية سلبية (تعبير غير مباشر عن العداء، مثل المماطلة، أو العناد، أو التجهم، أو الفشل المتعمد أو المتكرر في إنجاز المهام المطلوبة التي يكون الشخص مسؤولاً عنها)",
 "passive air defense": "دفاع جوي سلبي (دفاع جوي باستخدام الخداع أو التشتيت أو البناء الوقائي)",
 "passive electrolocation": "تحديد الموقع الكهربائي السلبي (عملية يمكن لبعض أنواع الأسماك فيها اكتشاف المجالات الكهربائية باستخدام مستقبلات كهربائية متخصصة لتحديد مصدر مجال كهربائي خارجي)",
 "passive immunity": "مناعة سلبية (شكل غير دائم من المناعة المكتسبة يتم فيه اكتساب الأجسام المضادة للمرض بشكل طبيعي (كما عبر المشيمة للجنين) أو اصطناعياً (كحقن المصل))",
 "passive matrix display": "شاشة المصفوفة السلبية (نوع من شاشات الكريستال السائل المستخدمة لبعض أجهزة الكمبيوتر المحمولة)\nمثال: شاشات المصفوفة السلبية عموماً أقل جودة من شاشات المصفوفة النشطة",
 "passive resistance": "لَا عُنْف, مُقَاوَمَة سَلْبِيَّة (مقاومة سلمية للحكومة عن طريق الصيام أو رفض التعاون)",
 "passive resister": "مُقاوِم سِلْمِيّ (مصلح يؤمن بالمقاومة السلبية (اللاعنف))",
 "passive source": "مصدر سلبي (مخبر غير مكلف بالحصول على استخبارات محددة ولكنه يمرر بشكل روتيني أي معلومات لديه)",
 "passive subwoofer": "مضخم صوت سلبي (مضخم صوت يحتوي على مشغل وصندوق، ويتم تشغيله بواسطة مكبر صوت خارجي)",
 "passive transport": "نقل سلبي (نقل مادة عبر غشاء الخلية عن طريق الانتشار؛ ولا يتطلب استهلاكاً للطاقة)",
 "passive trust": "ائتمان سلبي (ائتمان لا يؤدي فيه الأمين أي واجبات نشطة)",
 "passive voice": "صِيغَة مَجْهُول / مَبْنِي مَجْهُول",
 "passively": "بدون مقاومة, بشكل سلبي (بطريقة سلبية)\nمثال: استمع بشكل سلبي",
 "passiveness": "سلبية (سمة البقاء غير نشط؛ نقص في المبادرة) / استسلام, سلبية (الخضوع للآخرين أو للمؤثرات الخارجية)",
 "passivism": "سلمية (المذهب القائل بأن كل عنف غير مبرر)",
 "passivity": "سلبية (سمة البقاء غير نشط؛ نقص في المبادرة) / استسلام, سلبية (الخضوع للآخرين أو للمؤثرات الخارجية)",
 "passkey": "ماستر كي, مفتاح رئيسي (مفتاح يؤمن الدخول في كل مكان)",
 "passover": "الفَاسِخ, عِيد اَلْفِصْح",
 "passover supper": "سيدر, عشاء الفصح ((اليهودية) العشاء الاحتفالي في الليلة الأولى (أو الليلتين) من عيد الفصح)",
 "passport": "جَوَاز سَفَر, إِجَازَة مُرُور",
 "password": "كَلِمَةُ سِرّ, كَلِمَةُ مُرُور (الكلِمَةُ : اللفظةُ الدَّالةُ على معنًى مُفْرَد بالوضع، وتكون؛ الكلِمَةُ: الكلامُ المؤلَّفُ المطوَّل، قصيدةً، أَو خُطْبَةً، أَو مقالةً، أَو رسالة)\nمثال: كلمة السر طويلة.",
 "past": "مَاضٍ, الْمَاضِي ((في النحو) زمن نحوي يدل على حدث قد وقع، أو وُجِد قبل الآن بوقت ما) / بَعْدَ (يدل على اللحاق في الزمان؛ يكون مضافا، وينصب أو يجر)\nمثال: و بعد قليل أتى.",
 "past master": "خبير مخضرم (شخص لديه خبرة طويلة وشاملة في نشاط معين) / معلِّم سابق (شخص كان معلماً أو سيداً للحرفة في السابق)",
 "past participle": "اسم المفعول (صيغة فعلية تعبر عن عمل مكتمل)",
 "past perfect": "ماضي تام (زمن تام يُستخدم للتعبير عن حدث اكتمل في الماضي)",
 "past perfect tense": "ماضي تام (زمن تام يُستخدم للتعبير عن حدث اكتمل في الماضي)",
 "past progressive": "ماضي مستمر (زمن مستمر يُستخدم لوصف حدث كان مستمراً في الماضي)",
 "past progressive tense": "ماضي مستمر (زمن مستمر يُستخدم لوصف حدث كان مستمراً في الماضي)",
 "past simple": "الماضي البسيط (صيغة فعل تُستخدم لوصف حدث وقع قبل الوقت الحالي ولم يعد يحدث)",
 "past tense": "مَاضٍ, الْمَاضِي ((في النحو) زمن نحوي يدل على حدث قد وقع، أو وُجِد قبل الآن بوقت ما)",
 "past times": "ماضي (الزمن الذي انقضى)\nمثال: انس الماضي",
 "past-tense morpheme": "لاحقة الماضي, مورفيم الزمن الماضي (مورفيم يدل على الزمن الماضي للفعل)",
 "pasta": "مقرونية",
 "pasta e fagioli": "بَاسْتَا الحُبُوب, بَاسْتَا بِالفَاصُولِيَا (ضرب من الطعام يصنع من دَقِيْق القَمْح أو السَمِيْد بأشكال صلبة أو شريطية مختلفة مختلفة لكل شكل اسمه؛ ما طبخ من الطعام المذكور سابقا، كل شكل له اسم)\nمثال: طعام سامي المفضل هو الباستا.",
