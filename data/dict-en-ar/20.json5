 "oyster-fish": "سمكة المحار (نوع من سمك العلجوم)",
 "oystercatcher": "صائد المحار",
 "oysterfish": "سمكة المحار (نوع من سمك العلجوم)",
 "oysters rockefeller": "محار روكفلر (محار يغطى بالزبدة والسبانخ والتوابل ويخبز على نصف صدفة)",
 "oz.": "أوقية (وحدة وزن تساوي واحد من ستة عشر من الرطل أو 16 درهمًا أو 28.349 غرامًا)",
 "ozaena": "أوزينا, نتن الأنف (مرض مزمن في الأنف يتميز بإفرازات أنفية كريهة الرائحة وضمور في هياكل الأنف)",
 "ozark chinkapin": "شينكابين أوزارك (شجرة شجيرية وثيقة الصلة بالكستناء القزمية ولكن بأوراق أكبر؛ جنوب وسط غرب الولايات المتحدة)",
 "ozark chinquapin": "شينكابين أوزارك (شجرة شجيرية وثيقة الصلة بالكستناء القزمية ولكن بأوراق أكبر؛ جنوب وسط غرب الولايات المتحدة)",
 "ozark sundrops": "زهرة الربيع الميسورية (زهرة ربيع مسائية تفتح مساءً من جنوب وسط الولايات المتحدة)",
 "ozena": "أوزينا, نتن الأنف (مرض مزمن في الأنف يتميز بإفرازات أنفية كريهة الرائحة وضمور في هياكل الأنف)",
 "ozocerite": "أوزوكريت, شمع معدني (معدن شمعي عبارة عن خليط من الهيدروكربونات ويوجد مصاحباً للنفط؛ تستخدم بعض أنواعه في صنع السيريسين والشموع)",
 "ozokerite": "أوزوكريت, شمع معدني (معدن شمعي عبارة عن خليط من الهيدروكربونات ويوجد مصاحباً للنفط؛ تستخدم بعض أنواعه في صنع السيريسين والشموع)",
 "ozone": "أُوزُون",
 "ozone hole": "ثقب الأوزون (منطقة من طبقة الأوزون (بالقرب من القطبين) ينفد منها الأوزون موسمياً)",
 "ozone layer": "طَبَقَة اَلْأُوزُون",
 "ozone sickness": "داء الأوزون (مرض يمكن أن يصيب الأشخاص المعرضين للأوزون في الطائرات عالية الارتفاع؛ يتميز بالنعاس والصداع وآلام الصدر والحكة)",
 "ozonide": "أوزونيد (أي من فئة المركبات الكيميائية غير المستقرة الناتجة عن إضافة الأوزون إلى رابطة مزدوجة في مركب غير مشبع)",
 "ozonosphere": "طبقة الأوزون, غلاف الأوزون (طبقة في الستراتوسفير (على ارتفاع 20 ميلاً تقريباً) تحتوي على تركيز من الأوزون يكفي لحجب معظم الأشعة فوق البنفسجية القادمة من الشمس)",
 "ozothamnus secundiflorus": "أوزوثامنوس",
 "oświęcim": "أوشڤيينتشيم, أوشفينتشيم",
 "p": "فوسفور (عنصر لافلزي متعدد التكافؤ من عائلة النيتروجين يحدث عادة في صخور الفوسفات غير العضوية وكفوسفات عضوية في جميع الخلايا الحية)",
 "p-n junction": "وصلة م-س, وصلة موجب-سالب",
 "p.a.": "سَنَوِيًّا (في السنة؛ كل سنة (عادة مع الإشارة إلى مبلغ من المال يدفع أو يُستلم)) / مكبرات صوت عامة, نظام مخاطبة الجمهور (نظام تضخيم إلكتروني يستخدم كنظام اتصال في الأماكن العامة)\nمثال: كان يكسب 100,000 دولار سنوياً",
 "p.a. system": "مكبرات صوت عامة, نظام مخاطبة الجمهور (نظام تضخيم إلكتروني يستخدم كنظام اتصال في الأماكن العامة)",
 "p.e.": "طاقة الوضع, طاقة كامنة (الطاقة الميكانيكية التي يمتلكها جسم بحكم موضعه؛ طاقة مخزنة)",
 "p.m.": "م, مَسَاءً",
 "p.o.": "ضابط صف بحري (ضابط صف في البحرية أو خفر السواحل برتبة تعادل رقيب في الجيش)",
 "p/e ratio": "مُضَاعِف الرِّبْحِيَّة, نِسْبَة السِّعْر إِلَى الأَرْبَاح ((سوق الأسهم) سعر السهم مقسوماً على أرباحه)",
 "pa": "مكبرات صوت عامة, نظام مخاطبة الجمهور (نظام تضخيم إلكتروني يستخدم كنظام اتصال في الأماكن العامة) / أبي, بابا (مصطلح غير رسمي للأب؛ مشتق غالباً من لغة الأطفال) / باسكال (وحدة ضغط تساوي نيوتن واحد لكل متر مربع) / بروتكتينيوم (عنصر فلزي مشع قصير العمر يتكون من اليورانيوم ويتحلل إلى أكتينيوم ثم إلى رصاص)",
 "pa system": "مكبرات صوت عامة, نظام مخاطبة الجمهور (نظام تضخيم إلكتروني يستخدم كنظام اتصال في الأماكن العامة)",
 "pa'anga": "بانغا (وحدة المال الأساسية في تونغا)",
 "paba": "بابا, حمض بارا أمينوبنزويك (حمض استقلابي يوجد في خلايا الخميرة والكبد؛ يستخدم لصنع الأصباغ والأدوية وواقيات الشمس)",
 "pabir": "بورا (لغة تشادية يتم التحدث بها جنوب بحيرة تشاد، وخاصة في ولاية بورنو)",
 "pabir language": "بورا (لغة تشادية يتم التحدث بها جنوب بحيرة تشاد، وخاصة في ولاية بورنو)",
 "pablum": "أَفْكَار مُبَسَّطَة, كَلَام سَطْحِيّ (أفكار لا قيمة لها أو مبسطة للغاية) / بابلوم (شكل ناعم من الحبوب للرضع)",
 "pabna district": "ضِلْع فَابْنَا",
 "pabulum": "غذاء فكري تافه, كلام فارغ (غذاء فكري تافه أو ممل) / طعام, مأكولات (أي مادة يمكن استخدامها كطعام)",
 "pac": "لجنة العمل السياسي (لجنة تشكلها مجموعة مصالح خاصة لجمع الأموال لمرشحيها السياسيين المفضلين)",
 "pac-man strategy": "استراتيجية باك مان (استراتيجية دفاعية حيث تهدد الشركة المستهدفة بالاستحواذ على الشركة التي تحاول الاستحواذ عليها)",
 "paca": "باكا (قارض كبير يحفر الجحور في أمريكا الجنوبية والوسطى؛ يحظى بتقدير كبير كطعام)",
 "pace": "خطوة, خطوة واسعة (خطوة في المشي أو الجري) / معدل, وتيرة (السرعة النسبية للتقدم أو التغيير) / ياردة (وحدة للطول تساوي 3 أقدام؛ محددة بـ 91.44 سنتيمتر) / خطوة (المسافة التي تغطيها خطوة)\nمثال: عاش بوتيرة سريعة",
 "pace car": "سيارة الأمان (سيارة عالية الأداء تقود موكب السيارات المتنافسة خلال لفة الإحماء ثم تخرج من المسار)",
 "pace lap": "دورة الإحماء (الدورة الأولى لسباق السيارات التي تهيئ السيارات لبداية سريعة)",
 "pacemaker": "ضابط الإيقاع (حصان يستخدم لضبط سرعة السباق) / منظم ضربات القلب, ناظمة قلبية (جهاز إلكتروني مزروع يتولى وظيفة ناظمة القلب الطبيعية) / عقدة جيبية أذينية, ناظمة قلبية (قطعة متخصصة من نسيج القلب تتحكم في ضربات القلب) / رائد, محدد الوتيرة (حالة رائدة في مجالها)\nمثال: ستكون السياسة الجديدة رائدة في العلاقات المجتمعية",
 "pacer": "حصان الرهو (حصان مدرب على مشية خاصة تغادر فيها كلتا القدمين على جانب واحد الأرض معاً) / ضابط الإيقاع (حصان يستخدم لضبط سرعة السباق)",
 "pacesetter": "ضابط الإيقاع (حصان يستخدم لضبط سرعة السباق) / رائد, محدد الوتيرة (حالة رائدة في مجالها)\nمثال: ستكون السياسة الجديدة رائدة في العلاقات المجتمعية",
 "pacha": "باشا (سلطة مدنية أو عسكرية في تركيا أو مصر)",
 "pachinko": "باتشينكو (لعبة بينبول يابانية تُلعب على لوحة عمودية)",
 "pachisi": "باتشيسي (لعبة لوحية قديمة تشبه الطاولة؛ تُلعب على لوحة صليبية الشكل)",
 "pachouli": "باتشولي, عطر الباتشولي (عطر قوي يُصنع من نبات الباتشولي) / باتشولي, بتشول (نعناع شجيري صغير من جزر الهند الشرقية؛ يستخدم الزيت العطري المستخرج من أوراقه في العطور)",
 "pachuco": "باتشوكو (مراهق مكسيكي أمريكي ينتمي إلى عصابة الحي ويرتدي ملابس مبهرجة)",
 "pachycephalosaur": "باكيسيفالوصور (ديناصور عاشب ثنائي الأرجل يمتلك 10 بوصات من العظم فوق رأسه؛ أكبر ديناصور عظمي الرأس تم العثور عليه)",
 "pachycephalosaurus": "باكيسيفالوصور (ديناصور عاشب ثنائي الأرجل يمتلك 10 بوصات من العظم فوق رأسه؛ أكبر ديناصور عظمي الرأس تم العثور عليه)",
 "pachycheilia": "غلظ الشفاه (سماكة غير طبيعية للشفاه)",
 "pachyderm": "حيوان ثخين الجلد (أي من الثدييات ذات الحوافر غير المجترة المتنوعة ذات الجلد السميك جداً: الفيل، وحيد القرن، فرس النهر)",
 "pachyderma": "داء الفيل الوحمي (سماكة الجلد (عادة من جانب واحد في طرف) ناتجة عن تضخم خلقي في الأوعية الليمفاوية وانسداد الأوعية الليمفاوية)",
 "pachydermal": "ثخين الجلد (مكون من أو متعلق بـ أو مميز لحيوانات ثخينة الجلد (مثل الفيل))",
 "pachydermatous": "قَاسٍ, مُتَحَجِّر المَشَاعِر (متصلّب عاطفيًّا؛ فاقد للرقّة الإنسانية) / ثخين الجلد (مكون من أو متعلق بـ أو مميز لحيوانات ثخينة الجلد (مثل الفيل))",
 "pachydermic": "ثخين الجلد (مكون من أو متعلق بـ أو مميز لحيوانات ثخينة الجلد (مثل الفيل))",
 "pachydermous": "ثخين الجلد (مكون من أو متعلق بـ أو مميز لحيوانات ثخينة الجلد (مثل الفيل))",
 "pachyrhizus erosus": "فاصوليا اليام, هيكاما (نبات ملتف من أمريكا الوسطى بجذور وقرون صالحة للأكل؛ تؤكل الدرنات الكبيرة نيئة أو مطبوخة خاصة عندما تكون صغيرة ويجب طهي القرون الصغيرة جيداً؛ تنتج…)",
 "pachyrhizus tuberosus": "فاصوليا البطاطس, فاصوليا اليام (نبات ملتف في حوض الأمازون له جذور كبيرة صالحة للأكل)",
 "pachysandra": "باكيساندرا (أي نبات من جنس باكيساندرا؛ أعشاب دائمة الخضرة منخفضة النمو أو شجيرات صغيرة ذات أوراق مسننة وتستخدم كغطاء أرضي)",
 "pachysandra procumbens": "فربيون أليغني (عشب معمر منخفض شبه دائم الخضرة له سنابل صغيرة من الزهور البيضاء أو الوردية؛ موطنه جنوب الولايات المتحدة ولكنه يزرع في أماكن أخرى)",
 "pachysandra terminalis": "فربيون ياباني (شجيرة يابانية دائمة الخضرة بطيئة النمو لها سنابل طرفية من الزهور البيضاء؛ تزرع كغطاء أرضي)",
 "pachytene": "باكيتين, طور ضامة (المرحلة الثالثة من الطور التمهيدي للانقسام المنصف)",
 "pacific": "سِلْمِيّ, مُسَالِم (يُعَزِّز السَّلَام) / مَيَّالٌ لِلسَّلَام, مُسَالِم (يَمِيلُ إِلَى السَّلَامِ أَوْ ذُو طَبِيعَةٍ سِلْمِيَّة) / باسيفيكي, هادئ (يتعلق بالمحيط الهادئ أو يقع على حدوده)\nمثال: جزر المحيط الهادئ",
 "pacific bonito": "بونيتو المحيط الهادئ, بونيتو تشيلي (بونيتو شائع في ساحل المحيط الهادئ للأمريكتين؛ لحمه الزيتي الداكن يُعلب جيداً)",
 "pacific bottlenose dolphin": "دلفين قاروري الأنف الهادئ (دلفين قاروري الأنف يوجد في المحيط الهادئ)",
 "pacific cod": "قد المحيط الهادئ (يرتبط ارتباطاً وثيقاً بالقد الأطلسي)",
 "pacific giant salamander": "سمندل المحيط الهادئ العملاق (سمندل كبير (يصل إلى 7 بوصات) من غرب أمريكا الشمالية)",
 "pacific halibut": "هلبوت المحيط الهادئ (سمكة مفلطحة يمينية العيون توجد في المحيط الهادئ)",
 "pacific hemlock": "تسوغا غربية (شجرة دائمة الخضرة طويلة من غرب أمريكا الشمالية؛ شجرة خشب مهمة تجارياً)",
 "pacific herring": "رنجة المحيط الهادئ (سمكة طعام مهمة في شمال المحيط الهادئ)",
 "pacific newt": "سمندل المحيط الهادئ (أي من السمندل خشن الجلد المتعدد الموجود في غرب أمريكا الشمالية)",
 "pacific ocean": "الْمُحِيط الْهَادِئ",
 "pacific plum": "برقوق سييرا (شجيرة من ساحل المحيط الهادئ للولايات المتحدة تحمل فاكهة حمراء صغيرة عديمة الطعم)",
 "pacific ridley": "لجأة المحيط الهادئ, لجأة زيتونية (سلحفاة بحرية زيتونية اللون تعيش في المحيط الهادئ الاستوائي والمحيط الهندي وجنوب المحيط الأطلسي)",
 "pacific sardine": "سردين المحيط الهادئ (سردين صغير شائع قبالة ساحل المحيط الهادئ لأمريكا الشمالية)",
 "pacific silver fir": "شوح بهي, شوح فضي باسيفيكي (شوح متوسط إلى طويل من غرب أمريكا الشمالية له تاج مخروطي وفروع في طبقات؛ الأوراق تفوح منها رائحة البرتقال عند سحقها)",
 "pacific spiny dogfish": "كلب البحر الشائك الهادئ (كلب بحر يعيش في ساحل المحيط الهادئ لأمريكا الشمالية)",
 "pacific standard time": "توقيت المحيط الهادئ (التوقيت القياسي في المنطقة الزمنية الثامنة غرب غرينتش، يحسب عند خط الطول 120 غرباً؛ يستخدم في الولايات الغربية البعيدة بالولايات المتحدة)",
 "pacific sturgeon": "حفش أبيض, حفش المحيط الهادئ (سمكة غذائية ورياضية في المياه البحرية والعذبة للساحل الشمالي الغربي لأمريكا الشمالية)",
 "pacific time": "توقيت المحيط الهادئ (التوقيت القياسي في المنطقة الزمنية الثامنة غرب غرينتش، يحسب عند خط الطول 120 غرباً؛ يستخدم في الولايات الغربية البعيدة بالولايات المتحدة)",
 "pacific tree toad": "علجوم الشجر الباسيفيكي (الضفدع الأكثر سماعاً على ساحل المحيط الهادئ لأمريكا)",
 "pacific tripletail": "ثلاثية الذيل الهادئة (سمكة ثلاثية الذيل توجد في المحيط الهادئ)",
 "pacific walrus": "فظ المحيط الهادئ (فظ من بحر بيرينغ وشمال المحيط الهادئ)",
 "pacific yew": "طقسوس المحيط الهادئ (شجرة صغيرة أو متوسطة غير منتظمة التفرع من ساحل المحيط الهادئ لأمريكا الشمالية؛ تنتج خشباً ناعماً صلباً متقارب الحبيبات)",
 "pacifically": "بسلام, سلمياً (بطريقة سلمية)\nمثال: يجب على المستأجر الذي يدفع الإيجار المحجوز بموجب هذا ويؤدي العهود المتعددة الواردة هنا من جانبه أن يشغل ويتمتع بالمباني المؤجرة بسلام",
 "pacification": "تَهْدِئَة, مُكَافَحَة التَمَرُّد (إجراءات تتخذها الحكومة لهزيمة التمرد) / تسكين, تهدئة (فعل استرضاء شخص ما أو جعله أكثر ميلاً للموافقة) / سلام, معاهدة سلام (معاهدة لوقف الأعمال العدائية)\nمثال: حل السلام في 11 نوفمبر",
