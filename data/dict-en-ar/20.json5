 "pansa": "بوشا (الشهر العاشر من التقويم الهندوسي)",
 "pansexual": "بان سيكشوال, شامل الجنس (شخص يشارك في (أو منفتح على) أنشطة جنسية من أنواع متعددة)",
 "pansexuality": "شُمُولِيَّة جِنْسِيّة",
 "pansinusitis": "التهاب الجيوب الشامل (التهاب جميع الجيوب الأنفية)",
 "panspermia": "التبذر الشامل (الفرضية القائلة بأن الكائنات الحية الدقيقة قد تنقل الحياة من الفضاء الخارجي إلى الأجرام الصالحة للسكن)",
 "pansy": "شاذ (مصطلح مهين لرجل مثلي الجنس) / جبان, مخنث (رجل أو صبي خجول يعتبر طفولياً أو غير حازم) / بانسي, زهرة الثالوث (نبات حديقة كبير الزهر مشتق أساساً من البانسي البري في أوروبا وله بتلات مخملية بألوان مختلفة)",
 "pansy orchid": "أوركيد البنفسج (أي من بساتين الفاكهة المختلفة من جنس ميلتونيا ذات زهور وحيدة أو عنقودية فضفاضة مبهرجة واسعة الانتشار)",
 "pansy violet": "بنفسج قدم الطائر (بنفسج شائع في شرق الولايات المتحدة بزهور زرقاء شاحبة أو أرجوانية كبيرة تشبه زهور الثالوث)",
 "pant": "شهقة, لهاث (سحب قصير ومجهد للنفس مع فتح الفم) / بنطال, سروال ((عادة بصيغة الجمع) رداء يمتد من الخصر إلى الركبة أو الكاحل، ويغطي كل ساق على حدة) / لهث, نفث (الضجيج الناتج عن نفثة قصيرة من البخار (كما من محرك))\nمثال: أطلقت شهقة وأغمي عليها",
 "pant leg": "رجل السروال (ساق زوج من السراويل)",
 "pantaloon": "بانتالون (سراويل كانت تلبس في العصور السابقة) / بانتالون (مهرج في التمثيل الإيمائي الحديث؛ هدف للنكات)",
 "pantalooned": "مُرْتَدٍ سِرْوَالاً (يرتدي سروالاً)",
 "pantechnicon": "شاحنة نقل أثاث كبيرة (شاحنة نقل كبيرة (خاصة تلك المستخدمة لنقل الأثاث))",
 "pantelleria": "بَانْتِلِيرِيَا",
 "pantheism": "وَحْدَة اَلْوُجُود",
 "pantheist": "حلولي, وحدة الوجود (من أو يتعلق بمذهب وحدة الوجود) / مؤمن بوحدة الوجود (شخص يعتقد أن الله والكون هما الشيء نفسه)",
 "pantheistic": "حلولي, وحدة الوجود (من أو يتعلق بمذهب وحدة الوجود)",
 "pantheon": "بَانْثِيُون",
 "panther": "نَمِر, نِمْر (النّمر: حيوان مرقّط يُشبه الأَسَد؛ النّمر: لونه أنمر، وفيه نُمر حمراء أو بيضاء وسوداء)\nمثال: دخل نمر مخيمنا.",
 "panther cat": "أصلوت (قط بري ليلي يعيش في أمريكا الوسطى والجنوبية ذو معطف بني مصفر مرقط بالداكن)",
 "panther lily": "زنبق النمر (زنبق من غرب الولايات المتحدة له زهور برتقالية حمراء إلى قرمزية منقطة بالمارون)",
 "panthera leo": "أسد, ملك الغابة (سنوري مفترس اجتماعي كبير من أفريقيا والهند ذو معطف أسمر ولبدة شعثاء لدى الذكر)",
 "panthera onca": "نمر أمريكي, يغور (سنوري مرقط كبير من أمريكا الاستوائية يشبه النمر؛ يُعتبر في بعض التصنيفات عضواً في جنس فيليس)",
 "panthera pardus": "نمر (سنوري كبير من الغابات الأفريقية والآسيوية عادة ما يكون له معطف أسمر مع بقع سوداء)",
 "panthera tigris": "ببر (سنوري كبير من الغابات في معظم أنحاء آسيا ذو معطف أسمر مع خطوط سوداء؛ مهدد بالانقراض)",
 "panthera uncia": "نمر الثلوج (سنوري كبير من مرتفعات وسط آسيا ذو فرو أبيض كثيف طويل)",
 "pantie": "سروال داخلي نسائي (سراويل داخلية قصيرة للنساء أو الأطفال)",
 "panties": "كِيلُوت",
 "pantile": "قرميد مقوس",
 "pantin": "بانتان",
 "panting": "لهاث (التنفس بصعوبة وثقل (كما يحدث بعد المجهود)) / قماش البناطيل (أي قماش يستخدم لصنع السراويل)",
 "panto": "بانتو (اختصار للبانتوميم (التمثيل الصامت))",
 "pantograph": "مِنْسَاخ / سَنْجَة تَوْصِيل",
 "pantomime": "بانتوميم, تمثيل صامت (أداء يستخدم الإيماءات وحركات الجسم بدون كلمات)",
 "pantomimer": "إيمائي, ممثل صامت (ممثل يتواصل كلياً عن طريق الإيماءات وتعابير الوجه)",
 "pantomimist": "إيمائي, ممثل صامت (ممثل يتواصل كلياً عن طريق الإيماءات وتعابير الوجه)",
 "pantothen": "حمض البانتوثنيك (فيتامين من مجموعة فيتامين ب يؤدي دوراً مهماً في أكسدة الدهون والكربوهيدرات وبعض الأحماض الأمينية؛ يوجد في العديد من الأطعمة)",
 "pantothenic acid": "حمض البانتوثنيك (فيتامين من مجموعة فيتامين ب يؤدي دوراً مهماً في أكسدة الدهون والكربوهيدرات وبعض الأحماض الأمينية؛ يوجد في العديد من الأطعمة)",
 "pantropic": "شَامِل المَدَارَيْن (منتشر في جميع أنحاء المنطقة المدارية)",
 "pantropical": "شَامِل المَدَارَيْن (منتشر في جميع أنحاء المنطقة المدارية)",
 "pantry": "خزانة طعام, مخزن المؤن (مخزن صغير لتخزين الأطعمة أو المشروبات)",
 "pantryman": "خادم المائدة, مسؤول المؤونة (خادم ذكر (عادة رئيس الخدم في المنزل) مسؤول عن المشروبات والمائدة)",
 "pantrywoman": "خادمة مائدة (خادمة أنثى (عادة رئيسة الخدم في المنزل) مسؤولة عن المشروبات والمائدة)",
 "pants": "بِنْطَال, سِرْوَال (البِنْطَال : ضرب من الألبسة حديث يلبس في النصف الأسفل من الجسم يتكون من ساقين مثل السَرَاويِل إلا أنها أضيق…) / سِرْوَال اَلسُّنَة (ضرب تقليدي أو قديم من الملابس يرتدى في الجزء السفلي من الجسم يكون واسعا ويربط بالخصر والكاحلين بشرائط من القماش، يفصل كل ساق عن الأخرى…؛ لباس يُغَطِّي الجسم مِن السرة إلى الركبة. —مجلة العربي - الكويت)\nمثال: هذا السروال يناسبني.",
 "pants presser": "ضاغطة بناطيل, مكبس سراويل (جهاز منزلي تُعلق فيه السراويل لإزالة التجاعيد بالضغط)",
 "pants suit": "بدلة بنطال (زوج من السراويل وسترة مطابقة ترتديها النساء)",
 "pantsuit": "بدلة بنطال (زوج من السراويل وسترة مطابقة ترتديها النساء)",
 "panty": "سروال داخلي نسائي (سراويل داخلية قصيرة للنساء أو الأطفال)",
 "panty girdle": "مشد سفلي (رداء داخلي نسائي يجمع بين المشد والسروال الداخلي)",
 "pantyhose": "كولون نسائي (جوارب نسائية طويلة تتكون من سروال داخلي وجوارب متصلة)",
 "pantywaist": "جبان, مخنث (رجل أو صبي خجول يعتبر طفولياً أو غير حازم)",
 "panzer": "بانزر (مركبة مدرعة أو دبابة)",
 "pap": "حلمة (النتوء الصغير للغدة الثديية) / أَفْكَار مُبَسَّطَة, كَلَام سَطْحِيّ (أفكار لا قيمة لها أو مبسطة للغاية) / حمية لينة, طعام لين (نظام غذائي لا يتطلب المضغ؛ ينصح به لمن يعانون من اضطرابات معوية)",
 "pap smear": "اِخْتِبَارُ بَاب, مَسْحَةُ عُنُقِ الرَّحِم (عينة من إفرازات وخلايا سطحية لعنق الرحم والرحم؛ تفحص بالمجهر للكشف عن أي خلايا غير طبيعية)",
 "pap test": "اختبار باب, لطخة عنق الرحم (طريقة لفحص الخلايا المصبوغة في مسحة عنق الرحم للتشخيص المبكر لسرطان الرحم)",
 "papa": "أبي, بابا (مصطلح غير رسمي للأب؛ مشتق غالباً من لغة الأطفال)",
 "papacy": "البابوية (حكومة الكنيسة الرومانية الكاثوليكية)",
 "papaia": "بابايا, ببايا (شجيرة أو شجرة صغيرة استوائية أمريكية لها أوراق ضخمة مفصصة بعمق وفاكهة صفراء مستطيلة كبيرة)",
 "papain": "باباين (إنزيم محلل للبروتين يتم الحصول عليه من البابايا غير الناضجة؛ يُستخدم كملين للحوم)",
 "papal": "بابوي, رسولي (صادر عن البابا أو بأمر منه أو خاضع له، أو للبابوية بصفتها خليفة الرسل)\nمثال: إعفاء بابوي",
 "papal bull": "براءة بابوية, مرسوم بابوي (إعلان رسمي صادر عن البابا (يكتب عادة بأحرف قديمة ويختم بختم رصاصي))",
 "papal chamberlain": "حاجب بابوي (لقب بلاط كان يُمنح قبل عام 1968 من قبل البابا لرجال الدين رفيعي المستوى وكذلك للعلمانيين)",
 "papal cross": "صليب بابوي (صليب بثلاث عوارض)",
 "papal infallibility": "عصمة البابا (معتقد الكنيسة الكاثوليكية بأن الله يحمي البابا من الخطأ عندما يتحدث عن العقيدة أو الأخلاق)",
 "papal nuncio": "سفير بابوي ((الكنيسة الكاثوليكية) ممثل دبلوماسي للبابا يتمتع بوضع السفير)",
 "papal states": "دَوْلَة الْكَنِيسَة, الدَّوْلَة الْبَابَوِيَّة (بَلَد يتميز بحُدُود معروفة وشَعْب وحُكُومَة ومُؤَسَسَات مُنَظَّمَة؛ مجموعة من الناس مستقلين متحدين معا لتكوين مجتمع لحماية حقوقهم و وضع قوانينهم الخاصة)\nمثال: لبنان دولة صغيرة.",
 "papanicolaou smear": "اِخْتِبَارُ بَاب, مَسْحَةُ عُنُقِ الرَّحِم (عينة من إفرازات وخلايا سطحية لعنق الرحم والرحم؛ تفحص بالمجهر للكشف عن أي خلايا غير طبيعية)",
 "papanicolaou test": "اختبار باب, لطخة عنق الرحم (طريقة لفحص الخلايا المصبوغة في مسحة عنق الرحم للتشخيص المبكر لسرطان الرحم)",
 "paparazzo": "بَابَارَاتْزِي",
 "papaver alpinum": "خشخاش آيسلندا, خشخاش ألبي (خشخاش ألبي من العالم القديم بزهور بيضاء أو صفراء إلى برتقالية)",
 "papaver argemone": "خشخاش شائك (خشخاش سنوي من العالم القديم بزهور برتقالية حمراء وثمار شائكة)",
 "papaver californicum": "خشخاش غربي, خشخاش كاليفورنيا (نبات سنوي مبهرج في كاليفورنيا بزهور حمراء)",
 "papaver heterophyllum": "خشخاش الرياح, خشخاش ملتهب (خشخاش بري في كاليفورنيا بزهور حمراء زاهية)",
 "papaver nudicaule": "خشخاش آيسلندا, خشخاش قطبي (خشخاش معمر شبه قطبي في نصفي الكرة الأرضية ذو زهور عطرة بيضاء أو صفراء إلى برتقالية أو خوخية)",
 "papaver orientale": "خشخاش مشرقي (خشخاش آسيوي معمر يزرع عادة ذو أوراق صلبة كثيفة الشعر وزهور قرمزية زاهية أو وردية إلى برتقالية)",
 "papaver rhoeas": "خشخاش الحقول, خشخاش الذرة (خشخاش أوروبي سنوي شائع في حقول الحبوب ويزرع غالباً)",
 "papaver somniferum": "أبو النوم, خشخاش منوم (عشبة من جنوب غرب آسيا بأوراق رمادية وزهور بيضاء أو محمرة؛ مصدر الأفيون)",
 "papaverine": "بابافيرين (دواء قلويد (الاسم التجاري كافرين) يُستخرج من الأفيون؛ يستخدم لإرخاء العضلات الملساء؛ وهو غير مسبب للإدمان)",
 "papaw": "أسيمينة, بوبو (فاكهة ذات لحم أصفر؛ مرتبطة بالقشطة) / باباو (شجرة صغيرة موطنها شرق الولايات المتحدة لها أوراق مستطيلة وفاكهة لحمية)",
 "papaw tree": "باباو (شجرة صغيرة موطنها شرق الولايات المتحدة لها أوراق مستطيلة وفاكهة لحمية)",
 "papaya": "بَابَايَا",
 "papaya juice": "عصير البابايا (عصير من البابايا)",
 "papaya tree": "بابايا, ببايا (شجيرة أو شجرة صغيرة استوائية أمريكية لها أوراق ضخمة مفصصة بعمق وفاكهة صفراء مستطيلة كبيرة)",
 "papenburg": "بَابِنْبُورْغ",
 "paper": "وَرَق, قِرْطَاس (ما ينمو على النبات من الأعلى والجوانب بشكل صفائح ذات لون أخضر أو مائل إلى الخضرة. انظر الصورة؛ جلود رقاق يُكتَبُ عليها) / وَرَقَة / وَرَقِيّ\nمثال: هات ورقة بيضاء.",
 "paper airplane": "طَائِرَة وَرَقِيَّة (مَرْكَبَة كبيرة لها جناحان وتنقل الرُكَّاب والبَضَائِع بالجَوّ. ؛ كل من تَطِير، مؤنث طائر)\nمثال: لقد وصلت الطائرة.",
 "paper bag": "كيس, كيس ورقي (كيس مصنوع من الورق أو البلاستيك لحمل مشتريات الزبائن)",
 "paper birch": "بتولا بيضاء أمريكية, بتولا ورقية (بتولا أمريكية صغيرة بلحاء أبيض مقشر يُشكل غالباً في سلال أو قوارب لعبة)",
 "paper chain": "سلسلة ورقية (سلسلة مصنوعة من حلقات من الورق الملون؛ تستخدم لتزيين الغرفة)",
 "paper chase": "مطاردة الورق (لعبة خارجية؛ تنطلق مجموعة من اللاعبين (الأرانب) في ركض طويل مبعثرين قصاصات من الورق (الرائحة) ويحاول المطاردون (الكلاب) الإمساك بهم قبل وصولهم إلى…)",
 "paper chromatography": "استشراب ورقي, كروماتوغرافيا الورق (كروماتوغرافيا تستخدم الامتزاز الانتقائي على شريط من الورق)",
 "paper clip": "مِشْبَك وَرَق",
 "paper cup": "كُوب وَرَقِيّ (إناء للشرب لا عروة له؛ كل إناء للشرب. (تعميم)(غير معياري))\nمثال: الكوب مليء بالحليب.",
 "paper currency": "بنكنوت, نقود ورقية (عملة تصدرها حكومة أو بنك مركزي وتتكون من ورق مطبوع يمكن تداوله كبديل للنقود المعدنية)",
 "paper cutter": "قطاعة الورق, مقص الورق (أداة قطع لقطع أوراق الورق للحجم المطلوب)",
 "paper doll": "دمية ورقية (قطعة من الورق مقصوصة أو مطوية على شكل إنسان)",
 "paper electrophoresis": "رحلان كهربائي ورقي (رحلان كهربائي يتم إجراؤه على ورق الترشيح)",
 "paper fastener": "مشبك ورق (مثبت لتثبيت ورقة في مكانها)",
 "paper feed": "جهاز تغذية الورق, ملقم الورق (جهاز لإدخال أوراق في طابعة أو آلة كاتبة)\nمثال: تأخرت المهمة بسبب انسداد ملقم الورق",
 "paper flower": "جهنمية ملساء, زهرة الورق (كرمة برازيلية تميل للإزهار بشكل مستمر)",
 "paper gold": "الذهب الورقي, حقوق السحب الخاصة (أصول احتياطية في صندوق النقد الدولي؛ مصممة لتكملة احتياطيات الذهب والعملات القابلة للتحويل المستخدمة للحفاظ على الاستقرار في سوق الصرف الأجنبي)",
 "paper jogger": "هزاز ورق (آلة تستخدم لمحاذاة أكوام الورق غير المستوية)",
 "paper knife": "سكين ورق, فتاحة رسائل (سكين غير حاد يستخدم لفتح الأظرف التي تُرسل فيها الرسائل أو لشق صفحات الكتب غير المقطوعة)",
 "paper loss": "خسارة غير محققة, خسارة ورقية (خسارة غير محققة في استثمار محسوبة بطرح سعر السوق الحالي من تكلفة المستثمر)",
 "paper mill": "مصنع ورق (طاحونة يتم فيها تصنيع الورق)",
 "paper money": "بنكنوت, نقود ورقية (عملة تصدرها حكومة أو بنك مركزي وتتكون من ورق مطبوع يمكن تداوله كبديل للنقود المعدنية)",
 "paper mulberry": "توت الورق (شجرة شجيرية آسيوية لها لحاء (تابا) يشبه القماش؛ تزرع كشجرة ظل في أوروبا وأمريكا؛ الزهور الذكرية هي نورات هرية متدلية والأنثوية جرة الشكل تليها ثمار…)",
 "paper nautilus": "نوتي ورقي (رخوي رأسي الأرجل من البحار الدافئة تمتلك إناثه أصدافاً حلزونية ورقية رقيقة)",
 "paper plant": "بردي, ورق البردي (سعد طويل من وادي النيل ينتج أليافاً خدمت أغراضاً عديدة في العصور التاريخية)",
 "paper plate": "طبق ورقي (طبق مصنوع من الورق المقوى يستخدم لمرة واحدة)",
 "paper profit": "ربح غير محقق, ربح ورقي (ربح غير محقق في استثمار محسوب بطرح تكلفة المستثمر من سعر السوق الحالي)",
