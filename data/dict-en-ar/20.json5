 "peepul": "بيبال, تين مقدس (شجرة تين من الهند تشتهر بحجمها الكبير وطول عمرها؛ تفتقر إلى الجذور الداعمة للبانيان؛ تعتبر مقدسة لدى البوذيين)",
 "peer": "تِرْب, قَرِين (أصبح في حالة تربٍ، أي وضع في التراب أو اشتمل عليه؛ في : يُقال \"تَرَبَ\" على سبيل الاستعارة للمجيء بالراحة أو الهدوء بعد تعب)",
 "peer group": "مجموعة الأقران (المعاصرون من نفس الوضع الاجتماعي)",
 "peer of the realm": "نبيل المملكة (نبيل يحق له الجلوس في مجلس اللوردات)",
 "peer-to-peer": "نِدّ لِنِد",
 "peerage": "اللوردات, النبلاء (أقران المملكة (اللوردات) يُعتبرون كمجموعة)",
 "peeress": "سيدة نبيلة, ليدي (امرأة من طبقة النبلاء في بريطانيا)",
 "peerless": "لَا مَثِيلَ لَهُ, لَا نَظِيرَ لَهُ (بارز يفوق أيّ مقارنة؛ فريد لا يُضاهى)",
 "peerlessness": "تَفَرُّد, عَدَم وُجُود نَظِير (حالة أو شرط كون الشيء فريداً ولا مثيل له)",
 "peeve": "انزعاج, تكدير (مزاج منزعج أو متهيج)",
 "peeved": "مُتَضَايِق, مُنْزَعِج (أُثير فيه نفاد الصبر أو الغضب)",
 "peevish": "سَرِيع التَّأَفُّف, عَصَبِيّ (يتهيج أو ينزعج بسهولة)",
 "peevishly": "بحدة طبع, بنزق (بطريقة نزقة)",
 "peevishness": "حدة المزاج, سرعة الغضب (الميل لإظهار غضب غير منضبط) / تهيج, سرعة الغضب (شعور بالتهيج والنزق)\nمثال: كانت حدة مزاجه معروفة لجميع موظفيه",
 "peewee": "بيوي (صائد ذباب صغير زيتوني اللون يعيش في غابات شرق أمريكا الشمالية) / ضئيل الجسم, قزم (مصطلحات مهينة للأشخاص صغار الحجم)",
 "peewit": "بيوي (صائد ذباب صغير زيتوني اللون يعيش في غابات شرق أمريكا الشمالية) / أبو طيط, زقزاق شامي (زقزاق متوج كبير من العالم القديم له دلايات ومهاميز)",
 "peg": "وَتَد (العصا تثبت في الأرض لتثبيت شيء ما بربطه إليها)",
 "peg top": "بلبل وتدي (بلبل على شكل كمثرى مصنوع من الخشب مع دبوس مركزي معدني)",
 "pegasus": "حِصَان مُجَنِّح (الواحد الذكر من الخَيْل؛ يطلق مجازًا على الواحد من الخيل الذي لا يُعرف ذكر كان أم أنثى) / بِيغَاسُوس\nمثال: لم يشفى الحصان.",
 "pegboard": "لوحة أوتاد (لوحة مثقبة بانتظام يمكن تثبيت الأوتاد فيها)",
 "pegged exchange rate": "سعر صرف مربوط (نطاق من أسعار الصرف لعملة حيث قررت الحكومة ربط القيمة بعملة أخرى أو سلة عملات؛ ويتم مراجعته وتعديله بانتظام)",
 "pegged-down": "مُثَبَّت بِأَوْتَاد (مربوط أو مثبّت بالأوتاد)",
 "pegleg": "ساق خشبية (طرف صناعي يحل محل ساق مفقودة)",
 "pegmatite": "بيجماتيت (شكل من الصخور النارية يتكون من جرانيت خشن للغاية ناتج عن تبلور الماجما الغنية بالعناصر النادرة)",
 "pehlevi": "البهلوية (اللغة الإيرانية للأدب الزرادشتي من القرن الثالث إلى العاشر)",
 "pehlevi language": "البهلوية (اللغة الإيرانية للأدب الزرادشتي من القرن الثالث إلى العاشر)",
 "peignoir": "بَنْوَار",
 "pejorative": "تَحْقِيرِيّ, ذَمِّيّ (يُعَبِّر عن الاستهجان أو الرفض)",
 "pejoratively": "بانتقاص, بقدح (بطريقة ازدرائية)\nمثال: أنا لا استخدم الكلمة بقدح",
 "pekan": "دلق الصياد, فيشر (ثديي لاحم شجري كبير بني داكن من أمريكا الشمالية)",
 "peke": "بكينيز (سلالة صينية من الكلاب الصغيرة قصيرة الأرجل ذات معطف حريري طويل وخطم عريض مسطح)",
 "pekinese": "بكينيز (سلالة صينية من الكلاب الصغيرة قصيرة الأرجل ذات معطف حريري طويل وخطم عريض مسطح)",
 "peking man": "إنسان بكين (أحافير عُثر عليها بالقرب من بكين، الصين؛ فُقدت خلال الحرب العالمية الثانية)",
 "pekingese": "بكينيز (سلالة صينية من الكلاب الصغيرة قصيرة الأرجل ذات معطف حريري طويل وخطم عريض مسطح)",
 "pekoe": "بيكو, بيكو برتقالي (درجة ممتازة من الشاي الأسود؛ يزرع في الهند وسريلانكا وجاوة)",
 "pel": "بكسل, عنصر صورة ((علم الحاسوب) أصغر مكون منفصل لصورة على الشاشة (عادة نقطة ملونة))\nمثال: كلما زاد عدد البكسلات في البوصة، زادت الدقة",
 "pelage": "فِرَاء, كِسْوَة شَعْر (نمو الشعر أو الصوف أو الفراء الذي يغطي جسم الحيوان)",
 "pelagianism": "بيلاجيانية (العقيدة اللاهوتية التي طرحها بيلاجيوس والتي أنكرت الخطيئة الأصلية وأكدت قدرة البشر على أن يكونوا صالحين؛ أدينت بالهرطقة في مجمع أفسس عام 431)",
 "pelagic": "لجي, محيطي (متعلق بالمحيط المفتوح أو يحدث أو يعيش فيه)\nمثال: جزر محيطية مثل برمودا",
 "pelagic bird": "طائر محيطي (طائر البحار المفتوحة)",
 "pelargonium graveolens": "غرنوقي الورد, لقلقي نفاذ (أي من عدة نباتات غرنوقي من جنوب إفريقيا لها أوراق عطرية ثلاثية إلى خماسية الفصوص وزهور وردية)",
 "pelargonium hortorum": "غرنوقي الحدائق, لقلقي منطق (غرنوقي منتصب له أوراق صدفيّة ذات منطقة ملونة عريضة داخل الحافة وزهور بيضاء أو وردية أو حمراء)",
 "pelargonium limoneum": "غرنوقي الليمون, لقلقي ليموني (غرنوقي حديقة شائع بأوراق معطرة برائحة الليمون)",
 "pelargonium odoratissimum": "غرنوقي التفاح, لقلقي شديد الرائحة (غرنوقي بأوراق مستديرة عطرة وزهور بيضاء صغيرة)",
 "pelargonium peltatum": "غرنوقي لبلابي, لقلقي ترسي (نبات متسلق من أمريكا الجنوبية يزرع عادةً، له أوراق ترسية وزهور وردية)",
 "pelecaniform seabird": "بجعيات (طائر بحري كبير آكل للأسماك ذو أقدام مكففة بأربعة أصابع)",
 "pelecanus erythrorhynchos": "بجع أبيض (بجع أمريكي كبير؛ أبيض مع ريش جناح أسود)",
 "pelecanus onocrotalus": "بجع أبيض كبير (يشبه البجع الأبيض الأمريكي)",
 "pelecypod": "ذوات الصدفتين (رخويات بحرية أو مياه عذبة لها جسم رخو مع خياشيم تشبه الصفائح محاطة بصدفتين مفصليتين معاً) / صَفَائِحِيُّ الخَيَاشِيم (ثُنَائِيُّ الصَّدَفَة؛ مِنَ الرَّخَوِيَّاتِ ذَاتِ الصَّدَفَتَيْن)",
 "pelecypodous": "صَفَائِحِيُّ الخَيَاشِيم (ثُنَائِيُّ الصَّدَفَة؛ مِنَ الرَّخَوِيَّاتِ ذَاتِ الصَّدَفَتَيْن)",
 "peleg": "فَالِج, فَالِخ",
 "pelf": "فلوس, نقود (مصطلحات غير رسمية للمال)",
 "pelham": "بيلهام (لجام بقطعة فم قضيبية مصممة للجمع بين الكبح واللجام المفصلي)",
 "pelican": "بَجَع",
 "pelican crossing": "معبر مشاة محكوم بإشارة (معبر للمشاة مزود بإشارات مرور يتحكم فيها المشاة)",
 "peliosis": "فرفرية (أي من عدة أمراض دموية تسبب نزيفاً تحت الجلد)",
 "pelisse": "بيليس (رداء بلا أكمام مبطن أو مزين بالفراء)",
 "pell-mell": "باندفاع, بتهور (بطريقة برية أو متهورة) / فَوْضَوِيّ, مُرْتَبِك (بعجلة مُفرطة وفوضى)\nمثال: يندفع بتهور في كل مكان",
 "pellaea andromedifolia": "سرخس القهوة (سرخس دائم الخضرة في كاليفورنيا وباها كاليفورنيا)",
 "pellaea atropurpurea": "سرخس الجرف الأرجواني (سرخس أمريكي شمالي زاحف ضحل قصير جداً ينمو عادة على المنحدرات أو الجدران وله محاور أوراق لامعة داكنة)",
 "pellaea mucronata": "سرخس قدم الطائر (سرخس جرف في كاليفورنيا وباها كاليفورنيا بسويقات أوراق بنية أرجوانية)",
 "pellaea ornithopus": "سرخس قدم الطائر (سرخس جرف في كاليفورنيا وباها كاليفورنيا بسويقات أوراق بنية أرجوانية)",
 "pellaea rotundifolia": "سرخس الزر (سرخس من نيوزيلندا وأستراليا له سعف متدلٍ بوريقات خضراء داكنة تشبه الأزرار)",
 "pellagra": "بلاغرا (مرض ناتج عن نقص النياسين أو التريبتوفان (أو عن خلل في التحويل الأيضي للتريبتوفان إلى نياسين)؛ يتميز باضطرابات الجهاز الهضمي والحمامي واضطرابات عصبية…)",
 "pellet": "خرطوش, طلقة (قذيفة صلبة تطلق من سلاح ناري) / حبة, كرية (كتلة مستديرة صغيرة من مادة ما)\nمثال: أزت الطلقة بجانب أذنه",
 "pellicle": "قُشَيْرَة (غشاء واقٍ رقيق في بعض الأوليات)",
 "pellicularia filamentosa": "فطر البطاطس (فطر يسبب مرضاً في البطاطس يتميز ببقع قشرية سوداء على الدرنات)",
 "pellicularia koleroga": "فطر القهوة (فطر يسبب مرضاً في القهوة وبعض النباتات الاستوائية الأخرى)",
 "pellitory": "عاقر قرحا, قحوان إسباني (نبات متوسطي صغير يحتوي على زيت طيار كان يستخدم سابقاً لتخفيف وجع الأسنان) / جدارية, حشيشة الزجاج (عشب ينمو في الشقوق له أوراق ضيقة طويلة وأزهار وردية صغيرة عديمة البتلات)",
 "pellitory-of-spain": "عاقر قرحا, قحوان إسباني (نبات متوسطي صغير يحتوي على زيت طيار كان يستخدم سابقاً لتخفيف وجع الأسنان)",
 "pellitory-of-the-wall": "جدارية, حشيشة الزجاج (عشب ينمو في الشقوق له أوراق ضيقة طويلة وأزهار وردية صغيرة عديمة البتلات)",
 "pellucid": "رَائِق, سَلِس (واضح وشفّاف في اللغة؛ سهل الفهم) / بِلَّوْرِيّ, رَائِق (ينقل الضوء ويمكن الرؤية من خلاله بوضوح)",
 "pellucidity": "شَفَّافِيَّة تَامَّة, صَفَاء (مرور الضوء دون تشتت أو تشويه) / جَلَاء, صَفَاء (الخلو من الغموض وسهولة الفهم؛ قابلية التعبير الواضح للفهم)",
 "pellucidly": "بجلاء, بوضوح (بطريقة واضحة وجلية)\nمثال: هذا كتاب مكتوب بوضوح",
 "pellucidness": "شَفَّافِيَّة تَامَّة, صَفَاء (مرور الضوء دون تشتت أو تشويه)",
 "pelmet": "ستارة, كورنيش (هيكل زخرفي لإخفاء تركيبات الستائر في الجزء العلوي من غلاف النافذة)",
 "peloponnese": "بِيلُوبُونِيز",
 "peloponnesian": "بيلوبونيزي (متعلق بشبه جزيرة بيلوبونيز)\nمثال: الحرب البيلوبونيزية",
 "pelota": "جاي ألاي (لعبة باسكية أو إسبانية تُلعب في ملعب بكرة ومضرب من الخوص)",
 "pelt": "فَرْو, شَعَر / حَذَفَ (حَذَفَ الشّيء:قطعه وأَسْقَطَه. حَذَفَ الْمُرَاجِعُ عِبَارَةً منَ الْخِطَابِ؛ حَذَفَهُ بِالعَصَا: ضَرَبَهُ ، ورَمَاهُ بِها)\nمثال: حذف ياني حسابه.",
 "peltandra virginica": "لوف السهم الأخضر (عشبة معمرة في شرق الولايات المتحدة ذات أوراق على شكل رأس السهم وقنابة مدببة ممدودة وتوت أخضر)",
 "peltate": "تُرْسِيّ الشَّكْل ((عن شكل الورقة) مُستدير مع اتّصال الساق قرب مركز السطح السُّفليّ)",
 "peltate leaf": "ورقة درعية (ورقة على شكل درع؛ كورقة السلبوت)",
 "pelter": "راشق (رامي المقذوفات) / طوفان, هطول غزير (مطر غزير)\nمثال: كانت الشرطة مشغولة جداً عن مطاردة الراشقين",
 "pelting": "انهمار, وابل (أي شيء يحدث بسرعة أو في تتابع سريع)\nمثال: وابل من الرصاص",
 "peltiphyllum peltatum": "راوند هندي, نبات المظلة (عشب معمر جذموري بأوراق درعية درامية كبيرة وأزهار بيضاء إلى وردية زاهية في رؤوس مستديرة على سيقان خالية من الأوراق؛ يستعمر ضفاف الأنهار في سييرا…)",
 "peludo": "بيلودو, مدرع مشعر (مدرع أرجنتيني له ستة أشرطة متحركة وأجزاء سفلية مشعرة)",
 "pelvic": "حوضي (متعلق بالحوض)\nمثال: فحص حوضي",
 "pelvic arch": "حزام حوضي, حوض (بنية الهيكل العظمي للفقاريات التي تدعم الأطراف السفلية في البشر والأطراف الخلفية أو الأجزاء المماثلة في الفقاريات الأخرى)",
 "pelvic cavity": "تجويف حوضي (الحيز المحدود بعظام الحوض ويحتوي على أحشاء الحوض)",
 "pelvic fin": "زعنفة بطنية, زعنفة حوضية (إحدى زوج من الزعانف المتصلة بحزام الحوض في الأسماك تساعد في التحكم في اتجاه الحركة؛ تقابل الأطراف الخلفية للفقاريات البرية)",
 "pelvic girdle": "حزام حوضي, حوض (بنية الهيكل العظمي للفقاريات التي تدعم الأطراف السفلية في البشر والأطراف الخلفية أو الأجزاء المماثلة في الفقاريات الأخرى)",
 "pelvic inflammatory disease": "مرض التهاب الحوض (التهاب أعضاء الحوض الأنثوية)",
 "pelvimeter": "مقياس الحوض (أداة قياس لإجراء قياس الحوض)",
 "pelvimetry": "قياس الحوض (قياس أبعاد قناة الولادة العظمية (لتحديد ما إذا كانت الولادة المهبلية ممكنة))",
 "pelvis": "حَوْض (حَوَّضَ: عمِل حوضًا؛ حَوَّضَ (الماءَ): حاضَه)\nمثال: ملأت الحوض ماءا.",
 "pelycosaur": "بيليكوصور (زاحف بدائي كبير له شراع شوكي طويل؛ من العصر البرمي أو أواخر العصر القديم في أوروبا وأمريكا الشمالية)",
 "pembroke": "بيمبروك, بيمبروك ويلش كورجي (النوع الأصغر ومستقيم الأرجل من الكورجي له آذان مدببة وذيل قصير)",
 "pembroke welsh corgi": "بيمبروك, بيمبروك ويلش كورجي (النوع الأصغر ومستقيم الأرجل من الكورجي له آذان مدببة وذيل قصير)",
 "pemican": "بيميكان (لحم مجفف قليل الدهن مدقوق ناعماً ومخلوط بالدهن المذاب؛ استخدمه الهنود الأمريكيون الشماليون خاصة)",
 "pemmican": "بيميكان (لحم مجفف قليل الدهن مدقوق ناعماً ومخلوط بالدهن المذاب؛ استخدمه الهنود الأمريكيون الشماليون خاصة)",
 "pemphigous": "فقاعي (مكون من أو متعلق بـ أو يظهر الفقاع (مرض جلدي))",
 "pemphigus": "فُقَاع (هو الخَمْر إذا أخرج فُقَاعَات)\nمثال: مجرد فقاعة صابون.",
 "pen": "زَرِيبَة, حَظِيرَة / قَلَم, قَلَم حِبْر (قَطَعَ جزءا من شيء لتزيينه وتحسينه)\nمثال: ارسم بقلم رصاص.",
 "pen mouse": "فأرة القلم, ماوس قلمي (فأرة حاسوب لاسلكية مصممة على شكل قلم)",
 "pen name": "اسم أدبي, اسم شهرة (الاسم المستعار لمؤلف)",
 "pen nib": "ريشة, سن القلم (نقطة الكتابة في القلم)",
 "pen pal": "صَدِيق بِالْمُرَاسَلَة (هو الصَاحِب والخّل الذي بينك وبينه صَدَاقَة)\nمثال: ليس لديه صديقة.",
 "pen-and-ink": "رسم بالحبر (رسم منفذ بالقلم والحبر)",
 "pen-friend": "صديق مراسلة (شخص تتعرف عليه من خلال المراسلة الودية المتكررة)",
 "pen-tail": "زبابيات الشجر قلمية الذيل (زبابيات شجر بنية لها ذيل عارٍ محاط بشعر طويل صلب على الثلث الأقصى؛ تعيش في ماليزيا)",
 "pen-tailed tree shrew": "زبابيات الشجر قلمية الذيل (زبابيات شجر بنية لها ذيل عارٍ محاط بشعر طويل صلب على الثلث الأقصى؛ تعيش في ماليزيا)",
