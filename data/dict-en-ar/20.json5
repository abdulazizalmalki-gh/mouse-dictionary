 "oryzopsis miliacea": "سميلو (أرز جبلي معمر موطنه منطقة البحر الأبيض المتوسط وأدخل إلى أمريكا الشمالية)",
 "orzo": "أورزو, لسان العصفور (مكرونة مشكلة مثل حبوب الشعير؛ تحضر كثيراً مع الضأن في المطبخ اليوناني)",
 "os": "عظم (نسيج ضام صلب يشكل الهيكل العظمي للفقاريات) / فويهة (فم أو فتحة تشبه الفم) / عين يسرى (العين اليسرى) / نظام تشغيل ((علم الحاسوب) برمجيات تتحكم في تنفيذ برامج الحاسوب وقد توفر خدمات متنوعة)",
 "os breve": "عظم قصير (عظم ذو أبعاد متساوية تقريباً في جميع الاتجاهات)",
 "os capitatum": "عظم كبير (عظم الرسغ ذو الرأس المستدير الذي يتمفصل مع العظم السنعي الثالث)",
 "os frontale": "عظم جبهي (عظم قحفي كبير يشكل الجزء الأمامي من القحف: يشمل الجزء العلوي من محاجر العين)",
 "os hamatum": "عظم كلابي (عظم الرسغ المحاذي للإصبعين الرابع والخامس)",
 "os hyoideum": "عظم لامي",
 "os ischii": "إسك, عظم الإسك (أحد الأقسام الثلاثة لعظم الورك؛ يقع أسفل الحرقفة)",
 "os longum": "عظم طويل (في أطراف الفقاريات: عظم أسطواني طويل يحتوي على نخاع)",
 "os lunatum": "عظم هلالي (أحد عظام الرسغ الصغيرة الثمانية)",
 "os nasale": "عظم أنفي (عظم مستطيل الشكل يشكل جسر الأنف)",
 "os palatinum": "عظم حنكي (أي من عظمين غير منتظمي الشكل يشكلان مؤخرة الحنك الصلب ويساعدان في تكوين التجويف الأنفي وأرضية محاجر العين)",
 "os pisiforme": "عظم حمصي (عظم رسغي صغير يتمفصل فقط مع العظم المثلثي)",
 "os pubis": "عظم العانة (أحد الأقسام الثلاثة لعظم الورك؛ يشكل هذان العظمان معاً مقدمة الحوض)",
 "os scaphoideum": "عظم زورقي (أكبر عظام الرسغ على جانب الإبهام)",
 "os sesamoideum": "عظم سمسمي (أي من عدة عظام مستديرة صغيرة تتشكل في الوتر حيث يمر فوق مفصل)",
 "os sphenoidale": "عظم وتدي (عظم على شكل فراشة عند قاعدة الجمجمة)",
 "os tarsi fibulare": "عظم العقب, عظم الكعب (أكبر عظام الرصغ؛ يشكل كعب الإنسان)",
 "os temporale": "عظم صدغي (عظم سميك يشكل جانب القحف البشري ويغلف الأذن الداخلية)",
 "os trapezium": "عظم مربعي (عظم الرسغ على جانب الإبهام من اليد الذي يتمفصل مع العظم السنعي الأول والثاني)",
 "os trapezoideum": "عظم منحرف (عظم الرسغ الواقع بين العظم المربعي والعظم الكبير)",
