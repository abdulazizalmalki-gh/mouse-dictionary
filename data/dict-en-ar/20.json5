 "osmaniye": "عُثْمَانِيَّة",
 "osmanli": "تركي عثماني, عثماني (تركي (خاصة التركي الذي هو عضو في قبيلة عثمان الأول))",
 "osmanthus americanus": "خشب الشيطان, زيتون أمريكي (شجرة صغيرة من جنوب الولايات المتحدة ذات عناقيد من الزهور البيضاء الباهتة تليها ثمار أرجوانية داكنة)",
 "osmerus eperlanus": "هف أوروبي (الهف الشائع في أوروبا)",
 "osmerus mordax": "هف قوس قزح (سمكة غذائية بحرية وحبيسة مهمة في شرق أمريكا الشمالية وألاسكا)",
 "osmiridium": "أوزميريديوم (معدن صلب ومقاوم للتآكل وهو سبيكة طبيعية من الأوزميوم والإيريديوم (يحتوي عادة على كميات صغيرة من الروديوم والبلاتين)؛ يستخدم في الإبر وسنون الأقلام…)",
 "osmitrol": "مانيتول (مدر للبول (الاسم التجاري أوزميترول) يستخدم لتعزيز إخراج البول)",
 "osmium": "أُسْمِيُوم / أُوزْمِيُوم",
 "osmoreceptor": "مستقبل تناضحي (عضو نهائي حسي يستجيب للتغيرات في الضغط التناضحي)",
 "osmosis": "خَاصِّيَّة أُسْمُوزِيَّة, تَنَاضُح",
 "osmotic": "أُسْمُوزِيّ, أُسْمُوزِيَّة",
 "osmotic pressure": "ضغط أسموزي, ضغط تناضحي ((في الكيمياء الفيزيائية) الضغط الذي يمارسه محلول واللازم لمنع التناضح إلى ذلك المحلول عندما يتم فصله عن المذيب النقي بواسطة غشاء شبه منفذ)",
 "osmotically": "أسموزياً, بالتناضح (بواسطة الأسموزية (التناضح))",
 "osmund": "أوسمندا, سرخس مزهر (أي سرخس من جنس أوسمندا: سراخس كبيرة بجذور زاحفة؛ توجد أكياس الأبواغ العارية على سعف معدلة تشبه عناقيد الزهور)",
 "osmunda cinnamonea": "أسمندة قرفية, سرخس القرفة (سرخس من العالم الجديد ذو سعف صوفي بلون القرفة يحمل الأبواغ في أوائل الربيع محاطاً لاحقاً بسعف أخضر؛ السعف المبكر غير الملتف صالح للأكل)",
 "osmunda clatonia": "أسمندة كلايتونية, سرخس متقطع (سرخس أمريكي شمالي ذو سعف ريشي منتصب طويل وعدد قليل من الوريقات المنتجة للأبواغ في أو بالقرب من مركز السعف الخصب)",
 "osmunda regalis": "أسمندة ملكية, سرخس ملكي (سرخس كبير عميق الجذور واسع الانتشار عالمياً بسعف مركب ثنائي الريش منتصب)",
 "osona": "أوسونا",
 "osprey": "عُقَاب نُسَارِيّ, عُقَاب نُسَارِيَّة (طَيْر من الجَوَارِح، أكبر التي تصيد منها يكنى بأبي الهَيْثَم ومعروف بحِدَّة البصر؛ حَجَر ناتئ في جَوْف البِئْر يخرق الدَلُو. ونادر)\nمثال: هو من تلقى العقاب الأكبر.",
 "osseous": "عَظْمِيّ",
 "osseous labyrinth": "تِيه عَظْمِيّ (تجويف في الجزء الصخري من العظم الصدغي يحتوي على التيه الغشائي)",
 "osseous tissue": "عظم, نسيج عظمي (المادة المتكلسة المسامية التي تتكون منها العظام)",
 "ossete": "الأوسيتية (لغة إيرانية شمالية شرقية يتم التحدث بها في روسيا)",
 "ossete language": "الأوسيتية (لغة إيرانية شمالية شرقية يتم التحدث بها في روسيا)",
 "ossetia": "أُوسِيتْيَا",
 "ossianism": "الأوشيانية (الكتابة بأسلوب أوشيان وتحديداً الكتابة في الوريد الملحمي أو الأسطوري الذي ينتمي لفترة حديثة ولكنه يدعي الانتماء إلى العصور القديمة)\nمثال: يمكن اعتبار عمل سكوت حلقة وصل بين أوشيانية إحياء رونسيمان السلتي الأول والإحياء السلتي الأكثر تطوراً في أواخر القرن التاسع عشر",
 "ossicle": "عظم صغير, عظيم (عظم صغير؛ خاصة في الأذن الوسطى)",
 "ossicular": "عظيمي (متعلق بالعظيمات في الأذن الوسطى)",
 "ossiculate": "عظيمي (متعلق بالعظيمات في الأذن الوسطى)",
 "ossiculum": "عظم صغير, عظيم (عظم صغير؛ خاصة في الأذن الوسطى)",
 "ossiferous": "حامل للعظام (يحتوي على عظام (خاصة عظام أحفورية))\nمثال: كهوف حاملة للعظام",
 "ossification": "تَعَظُّم",
 "ossified": "مُتَحَجِّر, مُتَكَلِّس (مُسْتَقِرٌّ عَلَى نَمَطٍ جَامِدٍ مِنَ السُّلُوكِ أَوِ العَادَاتِ أَوِ المُعْتَقَدَاتِ)",
 "osso buco": "أُوسُّو بُوكُو",
 "ossuary": "مستودع عظام, معظمة (أي وعاء لدفن عظام البشر)",
 "ostariophysi": "أوستاريوفيسي (تُعتبر في بعض التصنيفات رتبة عليا تضم الشبوطيات والسلوريات)",
 "osteal": "عظمي (مكون من أو يحتوي على عظم) / عظمي (متعلق بالعظم أو بالهيكل العظمي)\nمثال: نسيج عظمي",
 "osteitis": "التهاب العظم (التهاب العظم نتيجة لعدوى أو صدمة أو تنكس)",
 "osteitis deformans": "التهاب العظم المشوه, داء باجيت (مرض يصيب العظام ويحدث في منتصف العمر وكبار السن؛ تدمير مفرط للعظام يؤدي أحياناً إلى آلام العظام والكسور وتشوهات الهيكل العظمي)",
 "ostensibility": "صورية, ظاهرية (صفة كون الشيء معلناً أو مفترضاً بدلاً من كونه حقيقياً أو واقعياً بشكل مؤكد)\nمثال: يكشفون عن ظاهرية هذا النظام المنهجي، أو يشيرون إلى أنه في الواقع مؤقت فقط ويوجد على أساس عدم استقرار أكثر جوهرية",
 "ostensible": "ظَاهِرِيّ, مَزْعُوم (يبدو كذلك في الظاهر؛ مُدَّعى أو مُتظاهَر به) / بَادٍ, ظَاهِرِيّ (يبدو كذلك لكن ليس بالضرورة حقيقيًّا)",
 "ostensibly": "فِي مَا يَبْدُو, عَلَى مَا يَبْدُو (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "ostensive": "ظَاهِرِيّ, مَزْعُوم (يبدو كذلك في الظاهر؛ مُدَّعى أو مُتظاهَر به) / إِشَارِيّ, بُرْهَانِيّ (بيّن وواضح بشكل جلي)",
 "ostensive definition": "تعريف بالإشارة (تعريف يشير إلى أو يعرض أمثلة للمصطلح المعرف)",
 "ostensorium": "إحقاق, وعاء القربان ((الكنيسة الرومانية الكاثوليكية) وعاء (عادة من الذهب أو الفضة) يُعرض فيه القربان المقدس للتعبد)",
 "ostentation": "اسْتِعْرَاض, مُبَاهَاة (عرض مدعٍ أو مبهرج أو مبتذل) / انْتِفَاخ, تَبَاهِي (انعدام الأناقة نتيجة التفاخر والغرور وانتفاخ الذات) / بهرجة, تباهي (عرض خارجي مبهرج)",
 "ostentatious": "استعراضي, متباه (يهدف إلى جذب الانتباه وإبهار الآخرين) / اسْتِعْرَاضِيّ, مُتَبَاهٍ ((لِلعَرْضِ) مُبْتَذَلٌ أَوْ سُوقِيّ)\nمثال: معطف سمور استعراضي",
 "ostentatiously": "باستعراض, بتباهٍ (مع التباهي؛ بطريقة استعراضية)\nمثال: تودد خروتشوف وعانق كاسترو بتباهٍ في الجمعية العامة للأمم المتحدة",
 "ostentatiousness": "انْتِفَاخ, تَبَاهِي (انعدام الأناقة نتيجة التفاخر والغرور وانتفاخ الذات)",
 "osteoarthritis": "فُصَال عَظْمِيّ",
 "osteoblast": "أرومة عظمية, خلية بانية للعظم (خلية يتطور منها العظم)",
 "osteoblastoma": "ورم أرومي عظمي (ورم حميد في العظام والأنسجة الليفية؛ يحدث في الفقرات أو عظم الفخذ أو الساق أو عظام الذراع (خاصة عند الشباب))",
 "osteochondroma": "ورم عظمي غضروفي (ورم حميد يحتوي على كل من العظام والغضاريف؛ يحدث عادة بالقرب من نهاية العظام الطويلة)",
 "osteoclasis": "كسر العظم العلاجي (علاج تشوه هيكلي عن طريق كسر العظم عمداً)",
 "osteoclast": "خلية هادمة للعظم, ناقضة العظم (خلية تعمل على تكسير وامتصاص النسيج العظمي)",
 "osteocyte": "خلية عظمية (خلية عظمية ناضجة)",
 "osteodystrophy": "حثل العظام, حثل عظمي (نمو العظام المعيب؛ يُعزى عادةً إلى مرض كلوي أو اضطرابات في استقلاب الكالسيوم والفوسفور)",
 "osteogenesis imperfecta": "تكون العظم الناقص, عظم زجاجي (اضطراب وراثي سائد في النسيج الضام يتميز بعظام هشة تنكسر بسهولة)",
 "osteogenic sarcoma": "ساركومة عظمية (ورم عظمي خبيث؛ أكثر شيوعًا عند الأطفال والشباب حيث يميل إلى التأثير على عظم الفخذ)",
 "osteologer": "أخصائي علم العظام, عالم عظام (عالم تشريح ماهر في علم العظام)",
 "osteologist": "أخصائي علم العظام, عالم عظام (عالم تشريح ماهر في علم العظام)",
 "osteology": "علم العظام (فرع التشريح الذي يدرس عظام الهيكل العظمي الفقاري)",
 "osteolysis": "تحلل العظم (تحلل العظم الناتج عن مرض أو عدوى أو نقص في إمدادات الدم)",
 "osteoma": "ورم عظمي (ورم حميد بطيء النمو يتكون من نسيج عظمي؛ عادة على الجمجمة أو الفك السفلي)",
 "osteomalacia": "لين العظام (تلين غير طبيعي للعظام بسبب نقص الفوسفور أو الكالسيوم أو فيتامين د)",
 "osteomyelitis": "اِلْتِهَاب العَظْم والنَّقِيّ",
 "osteopath": "مقوم العظام (معالج يعالج الهيكل العظمي والعضلات)",
 "osteopathist": "مقوم العظام (معالج يعالج الهيكل العظمي والعضلات)",
 "osteopathy": "أستيوباثي, علاج العظام (علاج يعتمد على افتراض أن استعادة الصحة تتحقق بشكل أفضل عن طريق التلاعب بالهيكل العظمي والعضلات)",
 "osteopetrosis": "تصخر العظم, مرض العظم الرخامي (اضطراب وراثي يتميز بزيادة كثافة العظام)",
 "osteophyte": "نابتة عظمية (نتوء عظمي غير طبيعي صغير)",
 "osteoporosis": "هَشَاشَةُ العِظَام",
 "osteosarcoma": "ساركومة عظمية (ورم عظمي خبيث؛ أكثر شيوعًا عند الأطفال والشباب حيث يميل إلى التأثير على عظم الفخذ)",
 "osteosclerosis": "تصلب العظم (تصلب غير طبيعي للعظام)",
 "osteosclerosis congenita": "الودانة, لاتصنع غضروفي (اضطراب هيكلي وراثي يبدأ قبل الولادة حيث يتحول الغضروف إلى عظم مما يؤدي إلى التقزم)",
 "osteostracan": "عظميات الدرقة (سمكة منقرضة عديمة الفك من العصر الديفوني برأس مدرع)",
 "osteotomy": "قطع العظم (قطع جراحي للعظم)",
 "ostiarius": "بواب (أدنى الرتب الصغرى المقدسة في الكنيسة الغربية غير المصلحة ولكن تم إلغاؤها الآن من قبل الكنيسة الكاثوليكية الرومانية)",
 "ostiary": "بَوَّاب, حارِس الباب (شخص يحرس مدخلاً) / بواب (أدنى الرتب الصغرى المقدسة في الكنيسة الغربية غير المصلحة ولكن تم إلغاؤها الآن من قبل الكنيسة الكاثوليكية الرومانية)",
 "ostinato": "أوستيناتو, لازمة متكررة (جملة موسيقية تتكرر مراراً وتكراراً خلال التكوين)",
 "ostiole": "فوهة (مسام صغير خاصة في الأجسام التكاثرية لبعض الطحالب والفطريات تمر عبرها الأبواغ)",
 "ostler": "سايس (شخص يعمل في إسطبل للعناية بالخيول)",
 "ostomy": "فغر (إجراء جراحي يخلق فتحة اصطناعية للتخلص من فضلات الجسم)",
 "ostracism": "إقصاء, نبذ اجتماعي (فعل استبعاد شخص من المجتمع بإجماع عام) / إبعاد, نبذ (حالة النفي أو النبذ (الاستبعاد من المجتمع بموافقة عامة))\nمثال: يجب على الجمعية التخلص من أعضائها المسنين - ليس عن طريق القتل الرحيم بالطبع، ولكن عن طريق النبذ",
 "ostracod": "صدفيات (قشريات بحرية ومياه عذبة صغيرة بجسم يشبه الروبيان محاط بصدفة ذات مصراعين)",
 "ostracoderm": "مدرعات الأدمة (فقاري منقرض يشبه السمكة عديم الفك له جسم مدرع بشدة؛ من العصر القديم)",
 "ostrea gigas": "محار ياباني (محار كبير موطنه اليابان وأدخل على طول ساحل المحيط الهادئ للولايات المتحدة؛ مرشح للإدخال في خليج تشيسابيك)",
 "ostrich": "نَعَامَة / ظَلِيم",
 "ostrich fern": "رأس الكمان, سرخس النعامة (سرخس طويل من المناطق المعتدلة الشمالية له سعف مقوس رشيق وأبواغ تشبه ريش النعام)",
 "ostrogoth": "قوطي شرقي (فرد من المجموعة الشرقية للقوط الذين أسسوا مملكة في شمال إيطاليا حوالي 500 م)",
 "ostrya carpinifolia": "ممران شجرة الجنجل (ممران شجرة الجنجل متوسط الحجم من جنوب أوروبا وآسيا الصغرى)",
 "ostrya virginiana": "خشب الحديد, ممران شجرة الجنجل الشرقي (ممران شجرة الجنجل متوسط الحجم من شرق أمريكا الشمالية)",
 "ostwald's theory of indicators": "نظرية المؤشرات ((كيمياء) النظرية القائلة بأن جميع المؤشرات هي إما أحماض ضعيفة أو قواعد ضعيفة يختلف فيها لون الشكل المتأين عن اللون قبل التفكك)",
 "ostyak": "الأوستياك, الخانتي (لغة أوغرية (مرتبطة بالمجرية) يتحدث بها الأوستياك) / أوستياك, خانتي (عضو من الشعب الأوغري البدوي الذي يعيش في شمال غرب سيبيريا (شرق الأورال))",
 "ostyak language": "الأوستياك, الخانتي (لغة أوغرية (مرتبطة بالمجرية) يتحدث بها الأوستياك)",
 "ostyak-samoyed": "سيلكوب (اللغة الأورالية التي يتحدث بها أوستياك-ساموييد) / سيلكوب (واحد من شعب ذي أصل مختلط من الأوستياك والسامويد في سيبيريا)",
 "ostyak-samoyed language": "سيلكوب (اللغة الأورالية التي يتحدث بها أوستياك-ساموييد)",
 "oswego tea": "شاي أوسويغو, مونردة مزدوجة (عشب عطري معمر من شرق أمريكا الشمالية له زهور أنبوبية بألوان مختلفة في رؤوس بارزة كثيفة)",
 "otaheite arrowroot": "أروروت أوتاهيتي (نشا يتم الحصول عليه من جذر البيك)",
 "otaheite arrowroot starch": "أروروت أوتاهيتي (نشا يتم الحصول عليه من جذر البيك)",
 "otaku": "أُوتَاكُو, عُطَاكُو",
 "otalgia": "ألم الأذن (وجع موضعي في الأذن الوسطى أو الداخلية)",
 "otaria byronia": "أسد البحر الجنوبي (يعيش في الساحل الجنوبي لأمريكا الجنوبية)",
 "otc": "خَارِج البُورْصَة ((في الأوراق المالية) لا يُتَداوَل في سوق الأَوْراق المالِيَّة الرَّسْمِيّ)",
 "otc derivative": "مشتقات خارج المقصورة, مشتقات غير مدرجة (عقود يتم تداولها (والتفاوض عليها بشكل خاص) مباشرة بين طرفين، دون المرور عبر بورصة أو وسيط آخر)\nمثال: سوق المشتقات خارج المقصورة هو أكبر سوق للمشتقات",
 "otc market": "سوق التداول المباشر, سوق خارج البورصة (بورصة أسهم تتم فيها معاملات الأوراق المالية عبر الهاتف والكمبيوتر بدلاً من قاعة البورصة)",
 "otc security": "ورقة مالية خارج المقصورة, ورقة مالية غير مدرجة (ورقة مالية يتم تداولها في السوق خارج المقصورة)",
 "otc stock": "سهم خارج المقصورة, سهم غير مدرج (سهم غير مدرج ومتداول في بورصة منظمة)",
 "other": "آخَر, أُخْرَى (ضد الأوَّل؛ وهو من يكون ترتيبه بعد الجميع؛ الشيء: مؤخرّه، الجزء الآخير منه) / مثال: أرني مثالا آخر.",
 "other than": "غَيْر (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "otherkin": "أَذَرْكِين",
 "otherness": "انْفِصَال, تَمَايُز (صفة عدم التشابه؛ كون الشيء متميزاً أو مختلفاً عما هو معروف أو مجرب)",
 "others": "آخَرُون",
 "otherwise": "خِلَافَ, خِلَافَ ذَلِك / وَإِلَّا / عَكْس ذٰلِك",
 "otherworld": "عالم آخر, عالم الغيب (عالم روحي مجرد يقع خارج حدود الواقع الدنيوي)",
 "otherworldliness": "روحانية (الاهتمام بأمور الروح)",
 "otherworldly": "مَا وَرَائِيّ, مُتَعَالٍ (يوجد خارج نطاق الطبيعة أو لا يتوافق معها)",
 "othonna": "أوثونا (نبات جنوب أفريقي من جنس أوثونا ذو أوراق ملساء غالباً ما تكون عصارية ورؤوس زهور صفراء)",
 "otic": "أذني (من أو يتعلق بالقرب من الأذن)",
 "otic ganglion": "عقدة أذنية (عقدة ذاتية تتوزع أليافها ما بعد العقدة إلى الغدة النكفية)",
 "otiose": "كَسُول, مُتَقَاعِس (غَيْر رَاغِب فِي العَمَل أَوِ الجُهْد) / عَبَثِيّ, عَقِيم (لَا يُنْتِجُ أَيَّ نَتِيجَةٍ أَوْ أَثَر) / عَبَثِيّ, لَا طَائِلَ مِنْه (لَا يَخْدِمُ أَيَّ غَرَضٍ مُفِيد؛ لَا مُبَرِّرَ لِوُجُودِه)",
 "otis tarda": "حبارى كبرى (أكبر طائر بري أوروبي)",
 "otitis": "التهاب الأذن (التهاب الأذن)",
 "otitis externa": "التهاب الأذن الخارجية (التهاب الأذن الخارجية (بما في ذلك الصيوان وقناة الأذن))",
 "otitis interna": "التهاب الأذن الداخلية, التهاب التيه (التهاب الأذن الداخلية؛ يمكن أن يسبب الدوار والقيء)",
 "otitis media": "اِلْتِهَاب الأُذُن الوُسْطَى",
 "oto": "لغة أوتو (لهجة من لغة تشيويري يتحدث بها شعب أوتو) / أوتو (فرد من الشعب السيوي يسكن وديان نهري بلات وميسوري في نبراسكا)",
 "otocolobus manul": "قط بالاس, مانول (قط بري صغير يعيش في جبال سيبيريا والتبت ومنغوليا)",
 "otoe": "لغة أوتو (لهجة من لغة تشيويري يتحدث بها شعب أوتو) / أوتو (فرد من الشعب السيوي يسكن وديان نهري بلات وميسوري في نبراسكا)",
 "otoganglion": "عقدة أذنية (عقدة ذاتية تتوزع أليافها ما بعد العقدة إلى الغدة النكفية)",
 "otolaryngologist": "طبيب أنف وأذن وحنجرة (أخصائي في اضطرابات الأذن أو الأنف أو الحنجرة)",
 "otolaryngology": "طب الأنف والأذن والحنجرة (التخصص الطبي الذي يتعامل مع أمراض الأذن والأنف والحنجرة)",
 "otolith organ": "عضو غبار التوازن (إما القريبة أو الكييس في الأذن الداخلية للفقاريات)",
 "otologist": "أخصائي أذن, طبيب أذن (طبيب متخصص في الأذن وأمراضها)",
 "otology": "طب الأذن (فرع الطب المعني بالأذن)",
 "otoplasty": "تجميل الأذن (جراحة ترميمية لصيوان الأذن الخارجية)",
 "otorhinolaryngologist": "طبيب أنف وأذن وحنجرة (أخصائي في اضطرابات الأذن أو الأنف أو الحنجرة)",
 "otorhinolaryngology": "طب الأنف والأذن والحنجرة (التخصص الطبي الذي يتعامل مع أمراض الأذن والأنف والحنجرة)",
 "otorrhea": "ثر أذني, سيلان الأذن (إفرازات من الأذن الخارجية)",
 "otosclerosis": "تصلب الأذن (اضطراب وراثي يسبب فيه تعظم تيه الأذن الداخلية طنيناً وصمماً في النهاية)",
 "otoscope": "منظار الأذن (أداة طبية تتكون من عدسة مكبرة وضوء؛ تستخدم لفحص الأذن الخارجية (القناة السمعية وخاصة طبلة الأذن))",
 "ototoxic": "سَامّ لِلْأُذُن (ذو تأثير سامّ على أعضاء السمع أو التوازن أو العصب السمعي)",
 "otranto": "أوترانتو",
 "otsu": "أُوتْسُو",
 "ottar": "عطر (زيت عطري أو عطر يتم الحصول عليه من الزهور)",
 "ottava rima": "أوتافا ريما, ثمانية القافية (مقطع من ثمانية أسطر من الشعر البطولي بنظام قافية أ-ب-أ-ب-أ-ب-ج-ج)",
 "ottawa": "أُوتَاوَا",
 "otter": "قُضَاعَة / ثَعْلَب الْمَاء (أي فصيلة من فصائل الكلبيّات القارتة (أكلة للحوم والنبات) الصغيرة الحجم، والبالغ عددها 27 نوعاً. يقصد العامّة من كلمة ثعلب في العادة الثعلب الأحمر…؛ شخص ماكر)\nمثال: أردى الصياد الثعلب.",
 "otter hound": "أوترهاوند, كلب صيد القضاعة (كلب صيد بريطاني قوي له آذان طويلة متدلية وفراء كثيف خشن أشعث مع طبقة تحتية زيتية؛ ربي لصيد ثعالب الماء (القضاعة))",
 "otter shrew": "زباب القضاعة (ثديي أفريقي برمائي آكل للحشرات يشبه القضاعة)",
 "otterhound": "أوترهاوند, كلب صيد القضاعة (كلب صيد بريطاني قوي له آذان طويلة متدلية وفراء كثيف خشن أشعث مع طبقة تحتية زيتية؛ ربي لصيد ثعالب الماء (القضاعة))",
 "ottoman": "عُثْمَانِيّ / عُثْمَانِيَّة",
 "ottoman dynasty": "السلالة العثمانية, عثمانيون (السلالة التركية التي حكمت الإمبراطورية العثمانية من القرن الثالث عشر حتى حلها بعد الحرب العالمية الأولى)",
 "ottoman empire": "الدَّوْلَةُ الْعُثْمَانِيَّةُ",
 "ottoman turk": "تركي عثماني, عثماني (تركي (خاصة التركي الذي هو عضو في قبيلة عثمان الأول))",
 "ottoman turkish": "الْعُثْمَانِيَّة, التُّرْكِيَّة الْعُثْمَانِيَّة",
 "otus asio": "بومة صياحة (بومة صغيرة من أمريكا الشمالية لها خصلات ريش تشبه القرون وصوتها يشبه الصفير المرتجف)",
 "otus scops": "بومة سكوبس الأوروبية (بومة سكوبس أوروبية)",
 "otus sunia": "بومة سكوبس الشرقية (بومة سكوبس آسيوية)",
 "ouagadougou": "وَاغَادُوغُو",
 "ouarzazate": "وَرْزَازَات",
 "oubliette": "جب, زنزانة سفلية (زنزانة مظلمة مدخلها ومخرجها الوحيد باب مسحور في السقف)",
 "ouch": "أَحّ, حِلْيَة",
 "oud": "عُود (قطعة من الخشب كالعصا جمعه عيدان؛ ما يُتَبَخَّر به)\nمثال: أشعلت عود ثقاب.",
 "ouguiya": "أُوقِيَّة",
 "ouija": "وْيْجَا",
 "ouija board": "لوحة الويجا (لوحة عليها الحروف الأبجدية؛ تستخدم مع مؤشر لتهجئة رسائل خارقة للطبيعة)",
 "ounce": "أُوقِيَّة / وِقِيَّة / أَوْنْس / أونصة / أونسة",
 "our": "ـنَا",
 "our lady": "سَيِّدَتُنَا",
 "our lady's bedstraw": "جويسئة السيدة العذراء, جويسئة صفراء (جويسئة معمرة شائعة ذات زهور صفراء؛ أمريكا الشمالية وأوروبا وآسيا)",
 "our lady's mild thistle": "حرشوف بري, خرفيش (شوك ثنائي الحول طويل من العالم القديم بأوراق كبيرة محيطة بالساق ومبقعة بالأبيض ورؤوس زهرية أرجوانية؛ مستوطن في كاليفورنيا وأمريكا الجنوبية)",
 "our lord's candle": "شمعة ربنا, يوكا ويبلي (يوكا من جنوب غرب الولايات المتحدة والمكسيك بسنبلة طويلة من الزهور البيضاء الكريمية)",
 "ouroboros": "أُورُبُورُوس",
 "ours": "لَنَا",
 "ourselves": "أَنْفُسَنَا",
 "ousel": "شحرور (سمنة أوروبية سوداء شائعة)",
 "oust": "طَرَدَ",
 "ouster": "إقالة, خلع (فعل طرد شخص ما أو إجباره على الخروج (من منصب)) / تجريد من الحيازة (تجريد غير مشروع من الحيازة) / طَارِد, مُقْصٍ (شخص يطرد شخصاً آخر أو يحل محله)",
 "ousting": "إقالة, خلع (فعل طرد شخص ما أو إجباره على الخروج (من منصب))",
 "out": "خَارِج",
 "out and away": "إلى حد بعيد, بكثير (بفارق كبير)\nمثال: كانت الطالبة الأذكى بمراحل",
 "out front": "في الصدارة, متقدماً (يتقدم أو يسبق في منافسة)\nمثال: كان الحصان متقدماً بثلاثة أطوال",
 "out loud": "بصوت عالٍ, جهراً (باستخدام الصوت؛ ليس صمتاً)\nمثال: يرجى قراءة المقطع بصوت عالٍ",
 "out of": "خَارِج / بِدَافِع",
 "out of bounds": "خط التماس, خط الجانب (خط يحدد الحدود الجانبية لملعب اللعب)",
 "out of breath": "لَاهِث",
 "out of control": "منفلت من عقاله",
 "out of doors": "بالخارج, في الخارج (خارج مبنى)\nمثال: في الصيف نلعب في الخارج",
 "out of fashion": "خَارِج المُوضَة, غَيْر عَصْرِيّ (غير رائج ويُعتبر غير جذاب أو قديم الطراز)",
 "out of hand": "خارج السيطرة (خرج عن نطاق السيطرة)\nمثال: خرجت أعمال الشغب عن السيطرة",
 "out of it": "خَارِج السِّيَاق, غَيْر مُلِمّ (غافل نتيجة عدم الاطلاع على المعلومات) / فَاقِدُ الإِحْسَاسِ, مُغْمًى عَلَيْهِ (لَا يَسْتَجِيبُ لِلتَّنْبِيهِ أَوِ المُؤَثِّرَاتِ) / مُسْتَبْعَد, مُهَمَّش (مُقصًى من نشاط أو مجموعة اجتماعية)",
 "out of nothing": "فجأة, من العدم (دون سابق إنذار)\nمثال: وصل ابن عمك من العدم",
 "out of order": "مُعَطَّل",
 "out of place": "فِي غَيْرِ مَحَلِّهِ (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "out of print": "غَيْرُ مُتَاح, نَافِدُ الطَّبْع ((عَنِ الكُتُب) لَمْ يَعُدِ النَّاشِرُ يَعْرِضُهُ لِلبَيْع)",
 "out of reach": "بمنأى عن",
 "out of sight": "فِي الخَفَاء, مُتَرَبِّصًا (بهدوء في الخفاء) / بعيداً عن الأنظار, خارج مدى الرؤية (لم يعد مرئياً) / مَحْجُوب, مَخْفِيّ (غَيْرُ مُتَاحٍ لِلنَّظَر)\nمثال: استلقى متربصاً",
 "out of the blue": "فَجْأَةً, عَلَى حِينِ غِرَّةٍ",
 "out of the frying pan, into the fire": "اِسْتَجَارَ مِنَ الرَّمْضَاءَ بِالنَّارِ",
 "out of the ordinary": "خَارِجٌ عَنِ المَعْهُود, غَيْرُ مَأْلُوف (استثنائيّ أو غير عاديّ أو جدير بالملاحظة) / اسْتِثْنَائِيّ, خَارِق لِلْعَادَة (جيد على نحو استثنائي أو غير معتاد)",
 "out of the question": "غَيْرُ وَارِد, مُسْتَحِيل (مُسْتَبْعَدٌ تَمَامًا؛ لَا يُمْكِنُ تَصَوُّرُه)",
 "out of the way": "بعيداً عن الطريق, جانباً (حتى لا يعرقل أو يعيق) / مقتول, مُزاح من الطريق (مقتول (للتخلص منه)) / بعيداً عن الطريق, في مكان ناءٍ (في موقع بعيد أو على مسافة من الطريق المعتاد) / خاطئ, غير لائق (غير لائق؛ معيب)\nمثال: ضع هذا الصندوق بعيداً عن الطريق حتى لا يتعثر به أحد",
 "out of thin air": "فجأة, من العدم (دون سابق إنذار)\nمثال: وصل ابن عمك من العدم",
 "out of this world": "اسْتِثْنَائِيّ, خَارِق لِلْعَادَة (جيد على نحو استثنائي أو غير معتاد)",
 "out of true": "غَيْر مَضْبُوط, مُنْحَرِف (غير مُرَكَّب بدقة؛ غير مستوٍ)",
 "out of view": "بعيداً عن الأنظار, خارج مدى الرؤية (لم يعد مرئياً)\nمثال: اختفت السفينة خلف الأفق وأصبحت بعيدة عن الأنظار",
 "out of wedlock": "بشكل غير شرعي, خارج إطار الزواج (من أبوين غير متزوجين) / بشكل غير شرعي, سفاحاً (من أبوين بيولوجيين غير متزوجين من بعضهما البعض)\nمثال: ولد خارج إطار الزواج",
 "out of whack": "مُخْتَلّ التَّوَازُن (غَيْر مُتَوَازِن أَوْ غَيْر مَضْبُوط)",
 "out of work": "بِلَا عَمَل, عَاطِل (لا يملك وظيفة)",
 "out-and-outer": "شخص فائق البراعة (شخص ممتاز في شيء ما)",
 "out-basket": "سلة الصادر (وعاء خشبي أو معدني يوضع على المكتب لحفظ المواد الصادرة)",
 "out-migration": "نزوح, هجرة خارجية (الهجرة من مكان (خاصة الهجرة من بلدك الأصلي للاستقرار في بلد آخر))",
 "out-of-body experience": "تجربة الخروج من الجسد (التجربة الانفصالية لمراقبة الذات من منظور خارجي كما لو أن العقل أو الروح قد غادر الجسد ويقوم بمراقبته)",
 "out-of-bounds": "خَارِج الحُدُود ((في البيسبول) خَارِج خُطُوط التَّمَاس)",
 "out-of-court settlement": "تسوية خارج المحكمة (حل نزاع قبل إصدار قرار نهائي من قبل المحكمة الابتدائية)",
 "out-of-date": "بَالٍ, عَفَا عَلَيْهِ الزَّمَن (قديم؛ لم يعد صالحاً أو مواكباً للعصر)",
 "out-of-door": "خارجي, في الهواء الطلق (يقع أو مناسب لـ أو يحدث في الهواء الطلق)\nمثال: ملابس خارجية",
 "out-of-doors": "خلاء, عراء (حيث يكون الهواء غير محصور)\nمثال: أراد الخروج للهواء الطلق قليلاً",
 "out-of-pocket": "مِنَ الجَيْب, نَقْدِيّ (يستلزم إنفاق مال نقديّ مباشر)",
 "out-of-school": "خَارِج المَدْرَسَة (غَيْر مُلْتَحِق بِالمَدْرَسَة وَبِالتَّالِي مُتَاح لِلْعَمَل)",
 "out-of-the-box thinking": "تفكير إبداعي, تفكير تباعدي (تفكير يتحرك في اتجاهات متباعدة ليشمل مجموعة متنوعة من الجوانب ويؤدي أحياناً إلى أفكار وحلول جديدة)",
 "out-of-the-way": "خَارِجٌ عَنِ المَعْهُود, غَيْرُ مَأْلُوف (استثنائيّ أو غير عاديّ أو جدير بالملاحظة) / تَمَّ التَّعَامُلُ مَعَهُ, مَفْرُوغ مِنْهُ (تَمَّ التَّعَامُلُ مَعَهُ وَالِانْتِهَاءُ مِنْهُ) / شَاذّ, مُسِيء (غير لائق أو حتى مُسيء)",
 "out-of-town": "مِنْ خَارِجِ المَدِينَة (يحدث في مدينة أخرى أو ينتمي إليها)",
 "out-tray": "سلة الصادر (وعاء خشبي أو معدني يوضع على المكتب لحفظ المواد الصادرة)",
 "outage": "انقطاع, توقف الخدمة (تعليق مؤقت للعمل (كما في أجهزة الكمبيوتر)) / فاقد, نقص (كمية شيء ما (مثل السوائل) المفقودة أثناء التخزين أو النقل)\nمثال: سيكون هناك انقطاع في الشبكة من الساعة 8 إلى 10 صباحاً",
 "outback": "المناطق النائية (منطقة الأدغال الداخلية في أستراليا)",
 "outbid": "زَايَدَ",
 "outboard": "خارجي (يقع بعيداً عن خط الوسط لسفينة أو طائرة) / محرك خارجي (محرك احتراق داخلي يركب في مؤخرة القارب الصغير) / قارب بمحرك خارجي (قارب آلي بمحرك خارجي)\nمثال: القسم الخارجي من الجناح",
 "outboard motor": "محرك خارجي (محرك احتراق داخلي يركب في مؤخرة القارب الصغير)",
 "outboard motorboat": "قارب بمحرك خارجي (قارب آلي بمحرك خارجي)",
 "outbound": "مُتَّجِه إِلَى الخَارِج, مُغَادِر (ذاهب أو مُتّجه إلى الخارج أو مُغادر)",
 "outbox": "صُنْدُوق الصَّادِر (وعاء كبيرة من الخشب غالبا وقد يكون حديدًا يستخدم لوضع الاشياء داخله، ويكون لها عادة جهة قابلة للفتح سواء بمفاصل او بالازالة الكاملة؛ صُنْدُوْقُ السَيَّارَة قمرة تشبه الصندوق في الجزء الخلفي من السيارة يستخدم كالصندوق) / صُنْدُوق الصَّادِر, عُلْبَة الصَّادِر (وعاء كبيرة من الخشب غالبا وقد يكون حديدًا يستخدم لوضع الاشياء داخله، ويكون لها عادة جهة قابلة للفتح سواء بمفاصل او بالازالة الكاملة؛ صُنْدُوْقُ السَيَّارَة قمرة تشبه الصندوق في الجزء الخلفي من السيارة يستخدم كالصندوق)\nمثال: أين صندوق البريد؟",
 "outbreak": "تَفَشٍّ",
