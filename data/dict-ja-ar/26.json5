 "フォールディングドア": "باب أكورديون, باب قابل للطي (باب داخلي يفتح عن طريق الطي للخلف في أقسام (بدلاً من التأرجح على مفصلات))",
 "フォールディング・ドア": "باب أكورديون, باب قابل للطي (باب داخلي يفتح عن طريق الطي للخلف في أقسام (بدلاً من التأرجح على مفصلات))",
 "フォールト": "خَطَأ (تعني ضدّ الصواب. يشمل ذلك الفعل، القول، والرأي. يُستخدم الفعل \"أخطأ\" للدلالة على عدم الإصابة…؛ قام بعمل بعيد عن الصواب أو مخالف للحق سواء كان ذلك في السلوك أو القول أو الكتابة) / صَدْع, فَالِق ((صَدَعَ) النباتُ الأرضَ يَصْدَعَ صَدْعًا: شَقَّها وظَهَرَ منها؛ (صَدَعَ) الزجاجَ ونحوه: كسره)\nمثال: كان خطأ حاسوبي.",
 "フォールド": "طي (عملية الطي) / طي (عملية جيولوجية تسبب انحناء في طبقة صخرية) / طي البروتين (العملية التي يتخذ فيها جزيء البروتين شكله المعقد ثلاثي الأبعاد)\nمثال: قام بطي المناديل طية مزدوجة / لفافة (ضمادة مغلفة) / غلاف, غلاف خارجي (الغطاء (عادة من الورق أو السلوفان) الذي يُلف فيه شيء ما)",
 "フォールバック": "انسحاب, فك الاشتباك (وقف عمل عسكري مع عدو)",
 "フォーレスト": "غَابَة, غابة (الغَابَةُ: الأَجَمَةُ ذاتُ الشَّجَرِ المُتَكَاثِف؛ لأَنَّها تُغَيِّبُ مَا فِيهَا. أو الأَجَمَةُ الَّتِي طالتْ، وَلَهَا أَطْراف مُرْتَفِعَةٌ باسِقَة؛ الغابةُ أَجَمة القَصَب، قَالَ: وَقَدْ جُعِلَتْ جماعةَ الشَّجَرِ، لأَنه مأْخوذ مِنَ الغَيابةِ)\nمثال: مشينا في الغابة",
 "フォーレターワード": "كلمة نابية, لفظ فاحش (أي من عدة كلمات قصيرة (غالباً ما تكون من 4 أحرف في الإنجليزية) تُعتبر عموماً بذيئة أو مسيئة)",
 "フォーン": "تَلْفَنَ",
 "フォーントルロイ": "طفل مدلل (صبي مهذب ومتأنق بشكل مفرط)",
 "フォーヴ": "فنان وحشي, وحشي (عضو في مجموعة من الرسامين الفرنسيين الذين اتبعوا المدرسة الوحشية)",
 "フォーヴィスム": "الوحشية (حركة فنية انطلقت عام 1905 تميزت أعمالها بألوان زاهية وغير طبيعية وأشكال بسيطة؛ أثرت على التعبيريين)",
 "フォー・レター・ワード": "كلمة نابية, لفظ فاحش (أي من عدة كلمات قصيرة (غالباً ما تكون من 4 أحرف في الإنجليزية) تُعتبر عموماً بذيئة أو مسيئة)",
 "フカ": "لُخْم / قِرْش / سَمَكَةُ الْقِرْش (مصطلح شمولي لأي حيوان فقاري مائي خيشومي التنفس) / ركان\nمثال: سمكة ميناد ماتت",
 "フカシ": "كذبة بيضاء, كذبة تافهة (كذبة تافهة)\nمثال: قال كذبة صغيرة حول أكل سبانخه",
 "フカフカ": "نَاعِم, لَيِّن (لطيف الملمس، غير خشن؛ رقيقٌ أو ملساء في الهيئة أو الصوت) / نَاعِم (لطيف الملمس، غير خشن؛ رقيقٌ أو ملساء في الهيئة أو الصوت)\nمثال: صوتها ناعم و واضح.",
 "フキサチーフ": "مثبت (ورنيش مذاب في الكحول ويرش على الصور لمنع التلطخ) / مثبت (مركب (مثل الإيثانول أو الفورمالديهايد) يثبت الأنسجة والخلايا للدراسة المجهرية)",
 "フクシア": "فُوشِيَة / أُرْجُوَانِيّ, فُوشِيّ",
 "フクシャ": "فُوشِيَة / أُرْجُوَانِيّ, فُوشِيّ",
 "フクシヤ": "فُوشِيَة / أُرْجُوَانِيّ, فُوشِيّ",
 "フクロアリクイ": "آكل النمل المخطط, نمبات (جرابي أسترالي صغير ذو خطم طويل ومخالب قوية للتغذى على النمل الأبيض؛ مهدد بالانقراض)",
 "フクロウ": "بُومَة",
 "フクロオオカミ": "ذئب تسماني, نمر تسماني (جرابي لاحم نادر يشبه الكلب من تسمانيا له خطوط على ظهره؛ ربما يكون منقرضاً)",
 "フクログマ": "كُوَالَا / شيطان تسمانيا ((في الأديان الإبراهيمية) الرُّوح الشِّرِّير الَّذِي يَرْمِي بِكَ لِلتَّهْلُكَةِ لِبُعْدِهِ عَنِ الْخَيْرِ وَطَرِيقِ الْحَقِّ؛ (استعمال مجازي) كُلّ وَلَدٍ مُشَاكِسٍ أَوْ مُتَمَرِّدٍ)\nمثال: العجلة من الشيطان.",
 "フクログモ": "لَمَّاجِيَّة",
 "フクロタケ": "فطر القش, فطر صيني (فطر صغير صالح للأكل استوائي وشبه استوائي له قبعة بيضاء وساق طويل؛ طعام شهي باهظ الثمن في الصين ودول آسيوية أخرى حيث يزرع تجارياً)",
 "フクロテナガザル": "سيامانج (جيبون أسود كبير يعيش في سومطرة يتميز بأن إصبعي القدم الثاني والثالث متصلان جزئياً بغشاء)",
 "フクロネコ": "دصيور",
 "フクロネズミ": "أُوبُسُوم",
 "フクロノリ": "طحالب بنية (طحالب يحجب الكلوروفيل فيها أصباغ بنية وصفراء)",
 "フグ": "فوغو (سمكة منتفخة تحظى بتقدير كبير كطعام شهي في اليابان ولكنها خطيرة جداً لأن الجلد والأعضاء سامة)",
 "フケ": "قِشْرَة الرَّأْس",
 "フケる": "هَرَبَ (الفِرارُ)\nمثال: هرب كأرنب خائف. / إغفال, حذف (خطأ ناتج عن الإهمال) / قفز خفيف, وثب (مشية تتبادل فيها الخطوات والقفزات)",
 "フサフサ": "شُجَيْرِيّ, كَثِيف (يُشْبِهُ الشُّجَيْرَةَ فِي كَثَافَةِ تَفَرُّعِهِ وَانْتِشَارِه) / أَشْعَث, كَثِيفُ الشَّعْر ((لِلشَّعْرِ) كَثِيفٌ وَسَيِّئُ التَّصْفِيف)",
 "フシ": "مُشْتَرَك / مِفْصَل / لَحْن (وضع الألحان أو التأليف الموسيقي؛ قرأ النص بلحن أو أداء صوتي مميز)\nمثال: أنا أحب هذا اللحن. / عُقْدَة / نُقْطَة (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه) / مَوْقِع (موضع الوُقُوع؛ الموضع الذي حَدَثَ أو يحدث فيه حادث) / أَشَارَ\nمثال: هذه هي نقطة ضعفه.",
 "フシめ": "نقطة تحوّل (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه)\nمثال: هذه هي نقطة ضعفه. / عُقْدَة / عَقَدَ (العَشْر من السَنَوَات؛ الاتِّفَاق والعَهْد بين طرفين)\nمثال: أمضى زيري العقد.",
 "フシ目": "نقطة تحوّل (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه)\nمثال: هذه هي نقطة ضعفه.",
 "フジ": "ستارية, ويستيريا / كرز فوجي (شجرة كرز يابانية شجيرية لها أزهار وردية شاحبة)",
 "フジツボ": "برنقيل البلوط (برنقيل يلتصق بالصخور خاصة في مناطق المد والجزر)",
 "フジバカマ": "جابر العظام, غافث مثقوب (عشب معمر في جنوب شرق الولايات المتحدة له رؤوس زهرية بيضاء الشعاع؛ كان يستخدم سابقاً في الطب الشعبي)",
 "フジマメ": "لَبْلَاب",
 "フタ": "غِطَاء / غِلَاف / غَطَّى",
 "フタつき": "ذو غطاء (لديه أو مغطى بغطاء أو أغطية؛ غالباً ما تستخدم في التركيبات) / ذُو غِطَاء (له غطاء أو غطاء علوي)\nمثال: يُترك الحليب في كوب كبير ذي غطاء",
 "フタを開ける": "نَجْمَة, اِبْتِدَاء / نَجْمَة / بَدَأَ (حَدَثَ ونَشَأَ وحَصَلَ؛ أَخَذَ، شَرَعَ)\nمثال: بدأ سامي يتكلم. / مَفْتُوح / فَتَحَ (ضد أغْلَقَ وسَدَّ؛ تركه بلا شيء يسده؛ الطريق: جعلها سالكة للطارقين) / فتح (ضد أغْلَقَ وسَدَّ؛ تركه بلا شيء يسده؛ الطريق: جعلها سالكة للطارقين) / حل (للعقدة: ضد عَقْدها؛ للجامد في السائل: إذابته) / اِنْفَتَحَ (فعل مطاوعة لفَتَحَ، فَتَحْتُهُ فانْفَتَح؛ يستخدم عوضا عن المبنى للمجهول فُتِحَ. )\nمثال: فتح الباب آليا.",
 "フタコブラクダ": "فَالِج, جَمَل ذُو سَنَامَيْن",
 "フタバガキ": "مجناح الثمر (شجرة من العائلة مجناحية الثمر)",
 "フタユビナマケモノ": "كسلان ثنائي الأصابع (كسلان صغير نسبياً وسريع الحركة يمتلك مخلبين طويلين في كل قدم أمامية) / كسلان هوفمان (كسلان من أمريكا الوسطى يمتلك مخلبين طويلين في كل قدم أمامية وثلاثة مخالب طويلة في كل قدم خلفية)",
 "フタルさん": "حمض الفثاليك (حمض عديم اللون يُستخدم لصنع الأصباغ والعطور)",
 "フタル酸": "حمض الفثاليك (حمض عديم اللون يُستخدم لصنع الأصباغ والعطور)",
 "フタ付き": "ذو غطاء (لديه أو مغطى بغطاء أو أغطية؛ غالباً ما تستخدم في التركيبات) / ذُو غِطَاء (له غطاء أو غطاء علوي)\nمثال: يُترك الحليب في كوب كبير ذي غطاء",
 "フダンソウ": "سلق, سلق سويسري (سيقان بيضاء طويلة عصارية ذات أوراق خضراء كبيرة) / سلق, سلق سويسري (شمندر يفتقر إلى الجذر المتضخم؛ يزرع كخضروات لأوراقه وسيقانه الصالحة للأكل)",
 "フチ": "جَدَّة (هي أم الأب أو أم الأم؛ مدينة في السُعُودِيَّة قرب مَكَّة، قيل أنها سميت هكذا لأن حواء دفنت فيها والله أعلم)\nمثال: كان لزيري جد و جدة.",
 "フチなし": "بلا إطار (يفتقر لإطار أو حافة)\nمثال: نظارات بلا إطار",
 "フチベニベンケイ": "زهرة الدراهم, لوناريا (نبات من جنوب شرق أوروبا يُزرع لأزهاره الأرجوانية العطرة وقرون بذوره الورقية الفضية البيضاء المستديرة المسطحة التي تستخدم للزينة الداخلية)",
 "フッ": "شاذ (مصطلح مهين لرجل مثلي الجنس) / حنق, غضبة (حالة من التهيج أو الانزعاج)",
 "フッか": "فلورة (إضافة الفلورايد إلى إمدادات المياه (لمنع تسوس الأسنان))",
 "フッかすいそ": "فلوريد الهيدروجين (سائل تآكلي سام عديم اللون ينتج عن تفاعل حمض الكبريتيك مع فلوريد الكالسيوم؛ ومحاليله المائية هي حمض الهيدروفلوريك)",
 "フッかぶつ": "فلوريد (ملح لحمض الهيدروفلوريك)",
 "フッさん": "حمض الهيدروفلوريك (حمض سائل سام ضعيف؛ يتكون من ذوبان فلوريد الهيدروجين في الماء)",
 "フッと": "فَجْأَةً",
 "フッカー": "خاطف الكرة / ضارب الكرة بانحراف لليسار (لاعب جولف تنحرف كراته عادة لليسار (بالنسبة للاعبين الذين يستخدمون اليد اليمنى)) / عاهرة شوارع (عاهرة تجذب الزبائن بالمشي في الشوارع) / شِيشَة, نَارْجِيلَة",
 "フッキソウ": "فربيون ياباني (شجيرة يابانية دائمة الخضرة بطيئة النمو لها سنابل طرفية من الزهور البيضاء؛ تزرع كغطاء أرضي)",
 "フッキング": "ضربة مقوسة لليسار (ضربة غولف تنحني لليسار للاعب الغولف الأيمن)\nمثال: أخذ دروساً لعلاج ضرباته المقوسة / البَرْق",
 "フック": "خَطَّاف / لَكْمَة خُطَّافِيَّة",
 "フックのほうそく": "قانون هوك ((فيزياء) المبدأ القائل بأن (ضمن حد المرونة) الضغط المطبق على مادة صلبة يتناسب مع الانفعال الناتج)",
 "フックの法則": "قانون هوك ((فيزياء) المبدأ القائل بأن (ضمن حد المرونة) الضغط المطبق على مادة صلبة يتناسب مع الانفعال الناتج)",
 "フッソ": "فُلُور",
 "フッタ": "حاشية سفلية (ملاحظة مطبوعة توضع أسفل النص في صفحة مطبوعة) / سائر, مُشاة (شخص يسافر سيرًا على الأقدام) / قدم ((تستخدم في التراكيب فقط) ارتفاع أو طول شيء ما بالأقدام)\nمثال: يخت يبلغ طوله 60 قدماً",
 "フッター": "حاشية سفلية (ملاحظة مطبوعة توضع أسفل النص في صفحة مطبوعة) / سائر, مُشاة (شخص يسافر سيرًا على الأقدام) / قدم ((تستخدم في التراكيب فقط) ارتفاع أو طول شيء ما بالأقدام)\nمثال: يخت يبلغ طوله 60 قدماً",
 "フッツリ": "فَجْأَةً",
 "フット": "رِجْل (العُضْو في جسد الإنسان يتكون من القَدَم والسَاق والفُخْذ. الجمع أرجُل، وقد تقول العامّة رِجْلين ورجْلينات؛ القَدَم من باب اطلاق اسم الكل على الجزء) / قَدَم (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى الرُّسْغَ؛ أنّ لهم سابقةً وفضلاً له عند فلان قَدَمٌ : معروف) / قدم (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى الرُّسْغَ؛ أنّ لهم سابقةً وفضلاً له عند فلان قَدَمٌ : معروف) / رجل (العُضْو في جسد الإنسان يتكون من القَدَم والسَاق والفُخْذ. الجمع أرجُل، وقد تقول العامّة رِجْلين ورجْلينات؛ القَدَم من باب اطلاق اسم الكل على الجزء) / ريل\nمثال: هذا الرجل تاجر.",
 "フットのネイル": "ظفر القدم (الظفر في نهاية إصبع القدم)",
 "フットサル": "كُرَةُ اْلصَالَةِ",
 "フットネイル": "ظفر القدم (الظفر في نهاية إصبع القدم)",
 "フットノート": "حاشية سفلية (ملاحظة مطبوعة توضع أسفل النص في صفحة مطبوعة)",
 "フットバス": "مغطس قدمين (حوض استحمام صغير لتدفئة أو غسل أو تطهير القدمين)",
 "フットファイル": "حجر خفاف, مبرد قدم (أداة تستخدم لفرك الجلد الميت من باطن القدمين)",
 "フットブレーキ": "فرامل القدم (مكبح هيدروليكي يتم تشغيله بالضغط على دواسة القدم)",
 "フットプリント": "أَثَر قَدَم (عَلَامَة؛ بَقِيَّة؛ رَسْم مُتَخَلَّف من شيء ما؛ تأثير؛ انطباع)\nمثال: اختفى فلم ير له أثر.",
 "フットボーラー": "لاعب كرة قدم أمريكية (رياضي يلعب كرة القدم الأمريكية)",
 "フットボール": "كُرَة اَلْقَدَم",
 "フットボールじょう": "ملعب كرة قدم أمريكية (ملعب اللعب الذي تُلعب عليه كرة القدم الأمريكية)",
 "フットボール場": "ملعب كرة قدم أمريكية (ملعب اللعب الذي تُلعب عليه كرة القدم الأمريكية)",
 "フットマン": "خادم (رجل يعمل كخادم في مؤسسة كبيرة (مثل قصر) لقضاء المهمات والقيام بالأعمال المنزلية)",
 "フットライト": "أضواء المسرح الأمامية (ضوء مسرح في مقدمة المسرح يضيء الديكور والممثلين)",
 "フットレスト": "كرسي قدم, مسند للقدمين (مقعد منخفض أو كرسي صغير لراحة قدمي الجالس)",
 "フットワーク": "خفة حركة, مناورة ذكية (مناورة أو تعامل ماهر) / حركة القدمين (طريقة استخدام القدمين)\nمثال: إنها بحاجة إلى بعض المناورة الذكية لتغطية كل تلك الأكاذيب / حَرَكِيَّة, قَابِلِيَّة الحَرَكَة (صفة القدرة على التحرك بحرية)",
