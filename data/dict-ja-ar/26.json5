 "ビラ": "فِيلَا, دَارَة / لَائِحَة (قانون مكتوب للإشارة إلى مواقف محددة وغرضه أن يمنع حدوث أمر معين أو يحث عليه؛ قانون وافق عليه الكونجرس (البرلمان الأمريكي)) / فَاتُورَة, حِسَاب / مِنْقَار\nمثال: من فضلك أضف اسمي إلى اللائحة.",
 "ビラはり": "ملصق إعلانات (شخص يلصق الفواتير أو اللافتات على الجدران أو اللوحات الإعلانية)",
 "ビラジュ": "قَرْيَة, كَفْر (الضَيْعَة والمِصْر والبَلَد، كل مكان اتصلت به الأبنية وجمع الناس؛ المَدِينَة التي لا سور لها. ونادر)\nمثال: هذه القرية مملة.",
 "ビラビラ": "خفقان, رفرفة (حركة الرفرفة صعوداً وهبوطاً) / الشفران الصغيران (الطيتان الداخليتان للفرج)",
 "ビラン": "مُوجِع, مُؤْلِم / سَعْفَة / فَسَاد",
 "ビランざい": "كَاوٍ, مُنَفِّط (يسبّب ظهور البثور والنفطات على الجلد) / عامل مسبب للبثور, مادة منفطة (عامل كيميائي يسبب التقرحات أو البثور (خاصة غاز الخردل))",
 "ビラン剤": "كَاوٍ, مُنَفِّط (يسبّب ظهور البثور والنفطات على الجلد) / عامل مسبب للبثور, مادة منفطة (عامل كيميائي يسبب التقرحات أو البثور (خاصة غاز الخردل))",
 "ビラージュ": "قَرْيَة, كَفْر (الضَيْعَة والمِصْر والبَلَد، كل مكان اتصلت به الأبنية وجمع الناس؛ المَدِينَة التي لا سور لها. ونادر)\nمثال: هذه القرية مملة.",
 "ビラ貼り": "ملصق إعلانات (شخص يلصق الفواتير أو اللافتات على الجدران أو اللوحات الإعلانية)",
 "ビリ": "آخِر (ضد الأوَّل؛ وهو من يكون ترتيبه بعد الجميع؛ الشيء: مؤخرّه، الجزء الآخير منه) / مَاضٍ, الْمَاضِي ((في النحو) زمن نحوي يدل على حدث قد وقع، أو وُجِد قبل الآن بوقت ما) / آخر (ضد الأوَّل؛ وهو من يكون ترتيبه بعد الجميع؛ الشيء: مؤخرّه، الجزء الآخير منه) / اِسْتَمَرَّ, دَامَ\nمثال: أرني مثالا آخر.",
 "ビリけつ": "آخِر (ضد الأوَّل؛ وهو من يكون ترتيبه بعد الجميع؛ الشيء: مؤخرّه، الجزء الآخير منه) / مَاضٍ, الْمَاضِي ((في النحو) زمن نحوي يدل على حدث قد وقع، أو وُجِد قبل الآن بوقت ما) / آخر (ضد الأوَّل؛ وهو من يكون ترتيبه بعد الجميع؛ الشيء: مؤخرّه، الجزء الآخير منه) / اِسْتَمَرَّ, دَامَ\nمثال: أرني مثالا آخر.",
 "ビリアード": "بِلْيَارْدُو",
 "ビリオネア": "مِلْيَارْدِير",
 "ビリオン": "مِلْيَار",
 "ビリケツ": "آخِر (ضد الأوَّل؛ وهو من يكون ترتيبه بعد الجميع؛ الشيء: مؤخرّه، الجزء الآخير منه) / مَاضٍ, الْمَاضِي ((في النحو) زمن نحوي يدل على حدث قد وقع، أو وُجِد قبل الآن بوقت ما) / آخر (ضد الأوَّل؛ وهو من يكون ترتيبه بعد الجميع؛ الشيء: مؤخرّه، الجزء الآخير منه) / اِسْتَمَرَّ, دَامَ\nمثال: أرني مثالا آخر.",
 "ビリッと": "شَاقّ, مُمَزِّق (يُشْبِه صَوْت تَمْزِيق عَنِيف كَصَوْت البَرْق المُشَقِّق لِلسَّمَاء) / رَفِيع, مُتَأَلِّق (جيد جدًا؛ من أرقى مستويات الجودة)",
 "ビリニュス": "فِيلْنْيُوس",
 "ビリビリ": "بصرف النظر, جانباً (غير مأخوذ في الاعتبار أو مستبعد) / إرباً, قطعاً (إلى أجزاء أو قطع) / بعيداً عن بعض, متباعدين (منفصلين أو على مسافة في المكان أو الزمان) / التمييز بينهما, عن بعضهما (واحداً عن الآخر)\nمثال: بصرف النظر عن هذه المشاكل، البلاد تبلي بلاءً حسناً / مُرْتَجِف, مُرْتَعِش (يهتز بشكل طفيف وغير منتظم كما من الخوف أو البرد) / ارتعاش, اهتزاز (حركة مهتزة)\nمثال: ارتعاش أصابعه وهو يشعل غليونه",
 "ビリヤニ": "بِرْيَانِي (طعام يصنع من الرز المطبوخ بأنواع مختلفة من البُهَار وغالبا ما يكون حارّا ويطبخ معه الدجَاج وقد يستخدم البعض اللَحْم)",
 "ビリヤード": "بِلْيَارْدُو",
 "ビリヤードじょう": "صالة بلياردو (غرفة تُلعب فيها البلياردو)",
 "ビリヤード場": "صالة بلياردو (غرفة تُلعب فيها البلياردو)",
 "ビリヤーニ": "بِرْيَانِي (طعام يصنع من الرز المطبوخ بأنواع مختلفة من البُهَار وغالبا ما يكون حارّا ويطبخ معه الدجَاج وقد يستخدم البعض اللَحْم)",
 "ビリルビン": "بيليروبين (خضاب برتقالي أصفر في العصارة الصفراوية يتشكل كناتج للهيموجلوبين؛ الكميات الزائدة منه في الدم تنتج المظهر الأصفر الملاحظ في اليرقان)",
 "ビリー": "تيس (ذكر الماعز) / هراوة الشرطي (هراوة قصيرة قوية يستخدمها رجال الشرطة بشكل أساسي)",
 "ビリーバー": "مُؤْمِن, مُؤْمِنَة (هو الشخص الذي يُؤْمِنُ بالشيء ويصدقه؛ من دخل في قلبه الإِيْمَان، وهو يطلق على من يدخل الإسلام)\nمثال: المؤمن لا يلدغ مرتين من جحر واحد.",
 "ビリ尻": "آخِر (ضد الأوَّل؛ وهو من يكون ترتيبه بعد الجميع؛ الشيء: مؤخرّه، الجزء الآخير منه) / مَاضٍ, الْمَاضِي ((في النحو) زمن نحوي يدل على حدث قد وقع، أو وُجِد قبل الآن بوقت ما) / آخر (ضد الأوَّل؛ وهو من يكون ترتيبه بعد الجميع؛ الشيء: مؤخرّه، الجزء الآخير منه) / اِسْتَمَرَّ, دَامَ\nمثال: أرني مثالا آخر.",
 "ビル": "لَائِحَة (قانون مكتوب للإشارة إلى مواقف محددة وغرضه أن يمنع حدوث أمر معين أو يحث عليه؛ قانون وافق عليه الكونجرس (البرلمان الأمريكي)) / فَاتُورَة, حِسَاب / مِنْقَار\nمثال: من فضلك أضف اسمي إلى اللائحة.",
