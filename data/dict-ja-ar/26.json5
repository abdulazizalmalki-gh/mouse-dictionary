 "ブラック": "أَسْوَد, سَوْدَاء (هو لَوْن مُظلم غَامِق لا يُبان منه. سميّ كذلك لأنه يسود على غيره من الألوان لظلامه؛ هو انعدام اللَوْن) / أَسْوَد (هو لَوْن مُظلم غَامِق لا يُبان منه. سميّ كذلك لأنه يسود على غيره من الألوان لظلامه؛ هو انعدام اللَوْن) / زِنْجِيّ, زَنْجِيّ / أَسْوَد, أسود (هو لَوْن مُظلم غَامِق لا يُبان منه. سميّ كذلك لأنه يسود على غيره من الألوان لظلامه؛ هو انعدام اللَوْن)\nمثال: لديه قميص أسود. / اِسْتِغْلَالِيّ (يميل إلى الاستغلال أو الانتفاع من الآخرين) / بولد, خط عريض (نمط خط ذو خطوط سميكة وثقيلة)",
 "ブラックアウト": "غَشْيَة / تَعْتِيم",
 "ブラックカラント": "كِشْمِش أَسْوَد, عِنَب الثَّعْلَب",
 "ブラックコメディ": "كوميديا سوداء (كوميديا تستخدم الفكاهة السوداء)",
 "ブラックコメディー": "كوميديا سوداء (كوميديا تستخدم الفكاهة السوداء)",
 "ブラックコーヒー": "قَهْوَة سَوْدَاء (مشروب يحضر بغلي مطحون البُنّ؛ المحل أو الدكان الذي تُقدَّم فيه القهوة وغيرها من المشروبات)\nمثال: لا أفضل القهوة.",
 "ブラックジャック": "بلاك جاك, واحد وعشرون (لعبة قمار تستخدم الأوراق؛ الهدف هو الحصول على أوراق ذات مجموع أعلى من أوراق المصرفي ولكن لا تتجاوز 21) / العلم الأسود, علم القراصنة (علم يحمل عادة جمجمة بيضاء وعظمتين متقاطعتين على خلفية سوداء؛ يشير إلى سفينة قراصنة) / عصا سوداء, هراوة قصيرة (قطعة من المعدن مغطاة بالجلد بمقبض مرن؛ تستخدم لضرب الناس) / سنديان ماريلاند (شجرة نفضية شجيرية شائعة في وسط وجنوب شرق الولايات المتحدة، لها لحاء داكن وأوراق عريضة ثلاثية الفصوص (على شكل هراوة)؛ وتميل لتشكيل غابات كثيفة)",
 "ブラックジョーク": "كوميديا سوداء (كوميديا تستخدم الفكاهة السوداء)",
 "ブラックスプロイテーション": "استغلال السود (استغلال السود (خاصة فيما يتعلق بالأدوار النمطية في الأفلام))",
 "ブラックスミス": "حَدَّاد, قَيْن",
 "ブラックスワン": "تَمّ أَسْوَد",
 "ブラックタイ": "ربطة عنق سوداء (ربطة عنق فراشة سوداء تلبس مع بدلة السهرة) / بدلة سهرة, توكسيدو (زي سهرة شبه رسمي للرجال)",
 "ブラックチョコレート": "شُوكُولَاتَةٌ سَوْدَاء",
 "ブラックティー": "شَاي أَسْوَد (شَجَرَة خَضْرَاء من فَصِيلَة الكَامِيلِيات لها أزْهَار بَيْضَاء، وتُعْطِي أوراقاً يصنع منها شَرَاب مُنَبِّه؛ أوراق الشجرة المجففة)\nمثال: صب الشاي لضيفك.",
 "ブラックバス": "باس أسود (أسماك رياضية أمريكية تعيش في المياه العذبة واسعة الانتشار وذات قيمة عالية (فصيلة سمكة الشمس)) / قاروص البحر الأسود (قاروص بحر مخطط باللون الأسود المزرق من ساحل المحيط الأطلسي للولايات المتحدة)",
 "ブラックバック": "ظبي أسود (ظبي هندي شائع ذو ظهر داكن وقرون لولبية)",
 "ブラックバード": "شُحْرُور",
