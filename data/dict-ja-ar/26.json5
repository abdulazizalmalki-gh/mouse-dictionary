 "ホリデーシーズン": "موسم العطلات (وقت يأخذ فيه الكثير من الناس إجازات)",
 "ホリデーハートしょうこうぐん": "وزارة الصحة والخدمات الإنسانية (الإدارة الفيدرالية الأمريكية التي تدير جميع البرامج الفيدرالية التي تتعامل مع الصحة والرفاهية؛ أنشئت عام 1979)",
 "ホリデーハート症候群": "وزارة الصحة والخدمات الإنسانية (الإدارة الفيدرالية الأمريكية التي تدير جميع البرامج الفيدرالية التي تتعامل مع الصحة والرفاهية؛ أنشئت عام 1979)",
 "ホリデー・シーズン": "موسم العطلات (وقت يأخذ فيه الكثير من الناس إجازات)",
 "ホリネズミ": "غوفر, غوفر جيبي (قارض حفار من فصيلة الغوفرية له جيوب خدية خارجية كبيرة؛ من أمريكا الوسطى وجنوب غرب أمريكا الشمالية)",
 "ホリホック": "ختمية (أي من نباتات طويلة متنوعة من جنس ألسيا؛ موطنها الشرق الأوسط ولكنها توطنت وزرعت على نطاق واسع لزهورها الكبيرة جداً والمتنوعة الألوان) / ألثيا, ختمية (أي من نباتات متنوعة من جنس ألثيا؛ تشبه ولكن بزهور أصغر من جنس ألسيا)",
 "ホリー": "مُقَدَّس",
 "ホリーホック": "ختمية (أي من نباتات طويلة متنوعة من جنس ألسيا؛ موطنها الشرق الأوسط ولكنها توطنت وزرعت على نطاق واسع لزهورها الكبيرة جداً والمتنوعة الألوان) / ألثيا, ختمية (أي من نباتات متنوعة من جنس ألثيا؛ تشبه ولكن بزهور أصغر من جنس ألسيا)",
 "ホルスタイン": "فريزيان, هولشتاين (سلالة من ماشية الحليب من شمال هولندا)",
 "ホルスタインしゅ": "فريزيان, هولشتاين (سلالة من ماشية الحليب من شمال هولندا)",
 "ホルスタイン種": "فريزيان, هولشتاين (سلالة من ماشية الحليب من شمال هولندا)",
 "ホルスター": "قِرابُ الْمُسَدََّّسِ",
 "ホルダ": "حامل (جهاز حمل) / حامل (الشخص الذي بحوزته شيك أو كمبيالة أو سند أو وثيقة ملكية مظهرة له أو لمن يحملها) / حائز, حامل (شخص يحمل أو يحوز شيئاً ما)\nمثال: حامل مناشف",
 "ホルダー": "حامل (جهاز حمل) / حامل (الشخص الذي بحوزته شيك أو كمبيالة أو سند أو وثيقة ملكية مظهرة له أو لمن يحملها) / حائز, حامل (شخص يحمل أو يحوز شيئاً ما)\nمثال: حامل مناشف",
 "ホルド": "حَشْد (حَشَد القَوْمَ: جَمَعَهم؛ حَشَد الزَّرْعُ: نَبَتَ كُلُّه)\nمثال: لمحته للحظة وسط الحشد",
 "ホルホル": "رضا عن الذات, غرور (الشعور الذي ينتابك عندما تكون راضياً عن نفسك)\nمثال: كان رضاه عن نفسه مثيراً للاشمئزاز تماماً",
 "ホルマリン": "فورمالين (محلول 10% من الفورمالديهايد في الماء؛ يستخدم كمطهر أو لحفظ العينات البيولوجية)",
 "ホルミウム": "هُلْمِيُوم / هُولْمِيُوم",
 "ホルム": "فورمالديهايد, ميثانال (غاز سام عديم اللون؛ يصنع عن طريق أكسدة الميثانول)",
 "ホルムアルデヒド": "فورمالديهايد, ميثانال (غاز سام عديم اللون؛ يصنع عن طريق أكسدة الميثانول)",
 "ホルムズかいきょう": "مَضِيق هُرْمُز (البَحْر حين يضيق لإقتراب البرَ من الجهتين)",
 "ホルムズ海峡": "مَضِيق هُرْمُز (البَحْر حين يضيق لإقتراب البرَ من الجهتين)",
 "ホルモン": "هُرْمُون / سقط, فضلات الذبيحة (الأحشاء والأجزاء المتبقية من الحيوان المذبوح التي غالباً ما تعتبر غير صالحة للأكل للبشر)",
 "ホルモンほじゅうりょうほう": "علاج بالهرمونات البديلة (إعطاء هرمونات (الإستروجين والبروجستين) للنساء بعد انقطاع الطمث؛ يُعتقد أنها تحميهن من أمراض القلب وهشاشة العظام)",
 "ホルモン補充療法": "علاج بالهرمونات البديلة (إعطاء هرمونات (الإستروجين والبروجستين) للنساء بعد انقطاع الطمث؛ يُعتقد أنها تحميهن من أمراض القلب وهشاشة العظام)",
 "ホルン": "بُوق (فَسَد؛ باق الرجل: كَذَب) / زَمْر, بُوق\nمثال: كان سامي ينبه بالبوق.",
 "ホルンフェルス": "حجر قرني, هورنفلس (صخر متحول ناعم الحبيبات تشكل بفعل الحرارة على الصخور الطينية)",
 "ホロ": "صورة ثلاثية الأبعاد, هولوغرام (الصورة الوسيطة (أو السجل الفوتوغرافي) التي تحتوي على معلومات لإعادة إنتاج صورة ثلاثية الأبعاد عن طريق التصوير المجسم)",
 "ホロにがい": "حُلْو وَمُرّ, حُلْوَة وَمُرَّة (متَّصِف بالحلاوة، وهي ذوق أساسي يُشعر به غالبًا عند تناول الأكلات الغنية بالسكر، ويرتبط بشكل عام باللذة، إلا عندما يتم التفريط به)\nمثال: الكعكة حلوة جدا",
 "ホログラフィ": "تصوير مجسم, هولوغرافيا (فرع البصريات الذي يتعامل مع استخدام الضوء المتماسك من الليزر لعمل صورة ثلاثية الأبعاد)",
 "ホログラフィック": "هُولُوغْرَافِيّ (مكتوب بالكامل بخطّ يد المُوَقِّع) / بخط اليد (مكتوب بالكامل بخط يد الشخص نفسه) / تجسيمي, هولوغرافي (من أو يتعلق بالهولوغرافيا أو الهولوغرام)\nمثال: وثيقة بخط اليد",
 "ホログラフィー": "تصوير مجسم, هولوغرافيا (فرع البصريات الذي يتعامل مع استخدام الضوء المتماسك من الليزر لعمل صورة ثلاثية الأبعاد)",
 "ホログラム": "صورة ثلاثية الأبعاد, هولوغرام (الصورة الوسيطة (أو السجل الفوتوغرافي) التي تحتوي على معلومات لإعادة إنتاج صورة ثلاثية الأبعاد عن طريق التصوير المجسم)",
 "ホロコースト": "مُحْرَقَة",
 "ホロスコープ": "خَرِيطَةُ الْبُرُوج, أَبْرَاج (الخَارِطَة، رسم عليه تضاريس الأرض وحدودها)\nمثال: انظر إلى الخريطة.",
 "ホロドモール": "هُولُودُومُور",
 "ホロムイイチゴ": "توت السحاب, توت الغيم (توت شوكي زاحف من المناطق المعتدلة الشمالية بتوت أصفر أو برتقالي)",
 "ホロー": "أَجْوَف",
 "ホロ苦い": "حُلْو وَمُرّ, حُلْوَة وَمُرَّة (متَّصِف بالحلاوة، وهي ذوق أساسي يُشعر به غالبًا عند تناول الأكلات الغنية بالسكر، ويرتبط بشكل عام باللذة، إلا عندما يتم التفريط به)\nمثال: الكعكة حلوة جدا",
 "ホワイ": "لِمَاذَا / لِمَ (جَمَعَ، ضَمَّ) / علاش / علاه\nمثال: لم يساعدني أحد.",
 "ホワイエ": "بَهْو",
 "ホワイティング": "بياض / نازلي فضي (يوجد قبالة ساحل المحيط الأطلسي لأمريكا الشمالية) / بياض (أي من عدة أسماك غذائية في المياه الساحلية لأمريكا الشمالية)",
 "ホワイト": "أَبْيَض, أبيض (اسم لون البَيَاض، أي ما كان لونه كالثلج النظيف أو حليب الجاموس. وهذا اللون يعتبر مجموع كل الألوان في الطيف الشمسيّ. انظر الصورة؛ صفة ما كان لونه أبيضًا) / قَوْقَازِيّ, يَافِثِيّ / أَبْيَض, بَيْضَاء (اسم لون البَيَاض، أي ما كان لونه كالثلج النظيف أو حليب الجاموس. وهذا اللون يعتبر مجموع كل الألوان في الطيف الشمسيّ. انظر الصورة؛ صفة ما كان لونه أبيضًا)\nمثال: هذا الكلب أبيض. / مُصَحِّح",
 "ホワイトアウト": "بياض شامل, تعتيم ثلجي (حالة جوية قطبية بوجود سحب فوق الثلج تنتج بياضاً موحداً وتصعب رؤية الأشياء؛ تحدث عندما يساوي الضوء المنعكس من الثلج الضوء القادم عبر السحب)",
 "ホワイトカラー": "إداري, ذو الياقات البيضاء (من أو يحدد العمل المهني أو الكتابي المأجور أو العمال)\nمثال: طمح ابن عامل المنجم إلى وظيفة مكتبية (ذوي الياقات البيضاء) كمحاسب",
 "ホワイトゴールド": "ذهب أبيض (سبيكة شاحبة اللون من الذهب عادة مع البلاتين أو النيكل أو البلاديوم)",
 "ホワイトシャツ": "قَمِيص (المَشِيْمَة؛ ثَوْب بكمين مخيط غير مفرج يلبس تحت الثياب ولا يكون إلا من القطن أو الكتان، يذكر غالبا وقد يؤنث)\nمثال: لديه قميص أسود.",
 "ホワイトソース": "صلصة البشاميل, صلصة بيضاء (حليب مكثف بمزيج من الزبدة والدقيق (رو))",
 "ホワイトタイ": "بدلة بذيول, بدلة رسمية كاملة (ملابس رسمية تتكون من زي سهرة كامل للرجال) / ربطة عنق بيضاء (ربطة عنق فراشة بيضاء تلبس كجزء من زي السهرة الرسمي للرجال)",
 "ホワイトチョコレート": "شوكولاتة بيضاء (مزيج من زبدة الكاكاو ومواد صلبة من الحليب والسكر والفانيليا؛ تستخدم في ألواح الحلوى والخبز والتغطيات؛ ليست شوكولاتة تقنياً لأنها لا تحتوي على سائل…)",
 "ホワイトニング": "تبييض, تفتيح (التغيير إلى لون أفتح)",
 "ホワイトノイズ": "ضوضاء بيضاء (ضوضاء ناتجة عن محفز يحتوي على جميع ترددات الاهتزاز المسموعة)\nمثال: الضوضاء البيضاء عامل حجب جيد",
 "ホワイトハウス": "الْبَيْت الْأَبْيَض / بَيْت أَبْيَض (بمعنى قضى الليل؛ الخَيْمَة من الشَعْر يَبِيت فيها البَدَوي أو المُسافر. الجمع بُيُوت)\nمثال: لنعد إلى البيت.",
 "ホワイトハッカー": "هَاكِر",
 "ホワイトハット": "هَاكِر",
 "ホワイトハットハッカー": "هَاكِر",
 "ホワイトバックラッシュ": "رد فعل البيض العنيف (رد فعل عنيف من قبل العنصريين البيض ضد تقدم الحقوق المدنية للسود)",
 "ホワイトペッパー": "فلفل أبيض (فلفل يطحن من حبوب الفلفل المقشرة) / فلفل, فلفل أسود (نبات متسلق يحمل توتاً أحمر داكناً (حبوب الفلفل) عند النضج الكامل؛ جنوب الهند وسريلانكا؛ تم توطينه في شمال بورما وآسام)",
 "ホワイトページ": "الصفحات البيضاء (دليل هاتف أو قسم من دليل (مطبوع عادة على ورق أبيض) حيث يتم سرد أسماء الأشخاص أبجدياً مع أرقام هواتفهم)",
 "ホワイトペーパー": "كتاب أبيض, ورقة بيضاء (تقرير حكومي؛ يغلف عادة بغلاف أبيض)",
 "ホワイトボード": "سَبُورَة بَيْضَاء",
 "ホワイトミート": "صدر, لحم أبيض (اللحم المقطع من صدر الطائر)",
 "ホワイトメタル": "معدن أبيض, معدن المحامل (سبيكة (غالباً ما تكون أساسها الرصاص أو القصدير) تستخدم للمحامل)",
 "ホワイトワイン": "نَبِيذ أَبْيَض, خَمْر أَبْيَض (نَبِيذ (صفة مفردة مذكرة، مؤنثها نَبِيْذَة، وجمعها السالم نَبِيْذُوْن، وجمعها المؤنث السالم نَبِيْذَات، وجمعها المكسر أَنْبِذَة)؛ نَبِيذ (لا يؤنث، وجمعه أَنْبِذَة))\nمثال: أنا شربت النبيذ.",
 "ホワイト・カラー": "إداري, ذو الياقات البيضاء (من أو يحدد العمل المهني أو الكتابي المأجور أو العمال)\nمثال: طمح ابن عامل المنجم إلى وظيفة مكتبية (ذوي الياقات البيضاء) كمحاسب",
