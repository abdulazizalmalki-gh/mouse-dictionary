 "ビルゼン": "بتول, بِكْر (المنقطعه عن الرجال)",
 "ビルダ": "بَنَّاء, بَنَّاءَة (ضد هَدْم. ؛ المَبْنَى أو البِنَاية)\nمثال: أنا وجدت البناء.",
 "ビルダー": "بَنَّاء, بَنَّاءَة (ضد هَدْم. ؛ المَبْنَى أو البِنَاية)\nمثال: أنا وجدت البناء.",
 "ビルダーリング": "بَنَّاء, بَنَّاءَة (ضد هَدْم. ؛ المَبْنَى أو البِنَاية)\nمثال: أنا وجدت البناء.",
 "ビルディング": "بِنَاء (ضد هَدْم. ؛ المَبْنَى أو البِنَاية) / مَبْنَى, بِنَاء (كل ما بُنِيَ؛ ما يُبْنى على أرضٍ محاطا بالجُدْرَان ومغطى بسَقْف. (تخصيص))",
 "ビルトイン": "مَبْنِيّ, مُدْمَج / مُضَمَّن",
 "ビルトインガレージ": "مَبْنِيّ, مُدْمَج / مُضَمَّن",
 "ビルトインスタビライザー": "مَبْنِيّ, مُدْمَج / مُضَمَّن",
 "ビルトイン・ガレージ": "مَبْنِيّ, مُدْمَج / مُضَمَّن",
 "ビルトイン・スタビライザー": "مَبْنِيّ, مُدْمَج / مُضَمَّن",
 "ビルトゥオーソ": "بارع, جهبذ (شخص يتمتع بمهارة مذهلة في أي مجال) / فيرتوزو, موسيقي بارع (موسيقي يمتلك إتقاناً فائقاً للتقنية والفن)",
 "ビルド": "بَنَى (أَقَامَ شيئا مثل الجدران و السفن باستخدام مواد مثل الخشب والطَّابُوق والحَجَر والآجَر والخَرَسَانَة وغيرها؛ جعل الشيء يحدث خطوة بعد خطوة كأنه بناء وإن لم يكن شيئا ملموسا)\nمثال: بنى سامي منزلا.",
 "ビルニュス": "فِيلْنْيُوس",
 "ビルベリー": "عنبية (توت أزرق مسود يشبه التوت الأزرق الأمريكي) / عنب الجبل (توت أزرق قائم من غرب الولايات المتحدة له زهور منفردة وتوت حامض نوعاً ما) / توت أزرق أوروبي, عنب الأحراش (توت أزرق أوروبي قائم له زهور منفردة وتوت أزرق مسود)",
 "ビルボード": "أَفِيش / لَوْحَة / لَافِتَة / يَافِطَة / لَوْحَة إعْلَانِيَّة / لَوْحَة إِعْلَانَات",
