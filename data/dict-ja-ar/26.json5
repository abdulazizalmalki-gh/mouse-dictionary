 "ベーパロック": "قفل بخاري (توقف في خط أنابيب ناجم عن فقاعات غاز (خاصة التوقف الذي يحدث في الطقس الحار في محرك الاحتراق الداخلي عندما يغلي الوقود في خط الغاز ويشكل فقاعات تمنع…)",
 "ベーパ・ロック": "قفل بخاري (توقف في خط أنابيب ناجم عن فقاعات غاز (خاصة التوقف الذي يحدث في الطقس الحار في محرك الاحتراق الداخلي عندما يغلي الوقود في خط الغاز ويشكل فقاعات تمنع…)",
 "ベーパーロック": "قفل بخاري (توقف في خط أنابيب ناجم عن فقاعات غاز (خاصة التوقف الذي يحدث في الطقس الحار في محرك الاحتراق الداخلي عندما يغلي الوقود في خط الغاز ويشكل فقاعات تمنع…)",
 "ベーパー・ロック": "قفل بخاري (توقف في خط أنابيب ناجم عن فقاعات غاز (خاصة التوقف الذي يحدث في الطقس الحار في محرك الاحتراق الداخلي عندما يغلي الوقود في خط الغاز ويشكل فقاعات تمنع…)",
 "ベービー": "حَبِيبِي (الحَبِيْب الذي يُنسب إلى المتكلم؛ كلمة يطلقها المُتَحَابِّيْن على بعضهم البعض) / حَبِيبِي, عَزِيزِي (الحَبِيْب الذي يُنسب إلى المتكلم؛ كلمة يطلقها المُتَحَابِّيْن على بعضهم البعض)\nمثال: ماذا تفعل حبيبي",
 "ベービーシッター": "حَاضِنَة, مُرَبِّيَة",
 "ベーラム": "باي رم, غسول الغار (سائل عطري كان يتم الحصول عليه في الأصل عن طريق تقطير أوراق شجرة التوت البري (الغار) مع الروم)",
 "ベーラムノキ": "شجرة الغار, غار (شجرة متوسطية صغيرة دائمة الخضرة ذات ثمار سوداء صغيرة وأوراق عطرية لامعة تستخدم للنكهة في الطهي؛ استخدمها الإغريق القدماء أيضاً لتتويج المنتصرين)",
 "ベール": "حِجَاب, خِمَار (الغطاء أو الساتر؛ يُطلق مجازا على لباس المرأة الذي يستر جميع جسمها)\nمثال: ارتدت أمها الحجاب.",
 "ベールゼブブ": "بَعْل زَبُوب, بَعْلْزَبُول (تزوجت المرأة، أو صار لها زوج؛ الرجل: شغف أو أحب زوجته كثيرًا)",
 "ベーン": "نَصْل الرِّيشَة (الجزء المسطح الشبيه بالشبكة من الريشة المكون من سلسلة من الأسلات على جانبي القصبة) / ريشة, شفرة (سطح مسطح يدور ويدفع ضد الهواء أو الماء) / ريشة توجيه, زعنفة (زعنفة مثبتة بذيل سهم أو قنبلة أو صاروخ لتثبيته أو توجيهه) / دوارة الرياح, ريشة الطقس (جهاز ميكانيكي مثبت على هيكل مرتفع؛ يدور بحرية لإظهار اتجاه الرياح)",
 "ベー・ラム": "باي رم, غسول الغار (سائل عطري كان يتم الحصول عليه في الأصل عن طريق تقطير أوراق شجرة التوت البري (الغار) مع الروم)",
 "ペア": "زَوْج (زَوَّجَ الأَشياءَ تَزْويجًا، وزَواجًا: قرن بعضَها ببعض؛ زَوَّجَ فلانًا امرأةً، وبها: جعله يتزوَجَها)\nمثال: زوجة ماري طبيبة.",
 "ペアをくむ": "حَبِيب, حَبِيبَة",
 "ペアを組む": "حَبِيب, حَبِيبَة",
 "ペアガラス": "زجاج مزدوج (نافذة بها لوحان من الزجاج ومساحة بينهما؛ تقلل انتقال الحرارة والضوضاء عبر النافذة)",
 "ペアリング": "اقتران, مزاوجة (فعل تجميع الأشياء أو الأشخاص في أزواج) / اقتران, تزاوج (عملية اقتران الذكر والأنثى لأغراض التكاثر)\nمثال: الاقتران العرضي للمراهقين",
 "ペアレンツ": "وَالِد (الذي قام بالولادة؛ هو الذكر الذي كان له دور مباشر وعضوي في تكوين الطفل في الجنين؛ الأب الطبيعي) / وَالِدَة (اسم فاعل مؤنث للفعل \"وَلَدَ\"؛ مرادف لـ\"أُمّ\") / وَالِدَان (الشكل المثنى من \"وَالِد\" في حالة الرفع)\nمثال: ألست والدة توم؟",
 "ペアレント": "وَالِد (الذي قام بالولادة؛ هو الذكر الذي كان له دور مباشر وعضوي في تكوين الطفل في الجنين؛ الأب الطبيعي) / وَالِدَة (اسم فاعل مؤنث للفعل \"وَلَدَ\"؛ مرادف لـ\"أُمّ\") / وَالِدَان (الشكل المثنى من \"وَالِد\" في حالة الرفع)\nمثال: ألست والدة توم؟",
 "ペアン": "ملقط مرقئ (أداة جراحية توقف النزيف عن طريق ضغط الأوعية الدموية)",
 "ペア・ガラス": "زجاج مزدوج (نافذة بها لوحان من الزجاج ومساحة بينهما؛ تقلل انتقال الحرارة والضوضاء عبر النافذة)",
 "ペアー": "زَوْج (زَوَّجَ الأَشياءَ تَزْويجًا، وزَواجًا: قرن بعضَها ببعض؛ زَوَّجَ فلانًا امرأةً، وبها: جعله يتزوَجَها)\nمثال: زوجة ماري طبيبة.",
 "ペイ": "دَفَعَ, خَلَّصَ (لزّه ونحاه وأبعده؛ صرفه قبل وروده، أي منعه وأبعده قبل مجيئه أو حدوثه، وعكسه أن يرفعه، اي أن يصرفه بعد حدوثه) / معاش, أجر\nمثال: دفع زيري الثمن. / هِيرُويْن",
 "ペイかん": "مُدْمِن, حَشَّاش",
 "ペイちゅう": "مدمن هيروين (شخص مدمن على الهيروين)",
 "ペイウォール": "جدار دفع (آلية تستخدم لتقييد الوصول للمستخدمين الذين يدفعون فقط)",
 "ペイオフ": "جزاء, عاقبة (تعويض عن أعمال جديرة بالتقدير أو عقاب على مخالفات) / حصيلة, عائد (الدخل أو الربح الناشئ عن معاملات مثل بيع الأراضي أو الممتلكات الأخرى) / رشوة (دفعة تُقدم لشخص في منصب ثقة لإفساد حكمه) / دفعة أخيرة, سداد نهائي (الدفع النهائي لدين)\nمثال: أجرة الخطيئة هي الموت",
 "ペイガニズム": "وَثَنِيَّة",
 "ペイシェンス": "صَبْر, تَحَمُّل ((صَبَرَ) يَصْبِرُ صَبْرًا: تجلَّد ولم يَجْزَع؛ (صَبَرَ): انتظر في هدوء واطمئنان)\nمثال: الصبر أم العلوم.",
 "ペイシェント": "صَبُور (الكثير الصبر أو الذي يصبر طويلا، من كانت صفته الصبر؛ الصَبُوْر: اسم من الأسماء الحسنى) / مَرِيض, مَرِيضَة (من به مَرَض، أي السَقِيْم المَعْلُوْل. يقال لما يصاب به الجَسَد والنَفَس والرُوْح أو أحدهم) / مَفْعُول (كناية عن الذي فُعِلَ به فاحشة اللواط. المَلُوطُ به)\nمثال: أظن أنها مريضة.",
 "ペイジャー": "بِيْجِر, مُنَادٍ",
 "ペイジング": "تَرْقِيم, تَرْقِيم الصَّفَحَات (نظام ترقيم الصفحات) / مناداة (النداء على اسم شخص (خاصة بواسطة نظام مكبر الصوت))\nمثال: استخدم نظام الخطابة في المستشفى للمناداة",
 "ペイストリー": "مُعَجَّنَات",
 "ペイズリー": "بيزلي (قماش صوفي ناعم بنمط ملون ملتوي من الأشكال المنحنية)",
 "ペイチン": "بِكِين / پِكِين",
 "ペイデイ": "يوم الدفع, يوم الراتب (اليوم الذي تتلقى فيه أجراً عن عملك)",
 "ペイデー": "يوم الدفع, يوم الراتب (اليوم الذي تتلقى فيه أجراً عن عملك)",
 "ペイトリオット": "وَطَنِيّ, وَطَنِيَّة",
 "ペイド": "مأجور, مدفوع (يتميز بتلقي أجر) / غَيْر تَرْفِيهِيّ, مَأْجُور (ينطوي على عمل مأجور فيما يُمارَس غالبًا كهواية) / مُجْزٍ, مُدِرّ لِلرِّبْح (يُدرّ ربحًا معقولاً)\nمثال: عمل مأجور",
 "ペイパー": "وَرَق, قِرْطَاس (ما ينمو على النبات من الأعلى والجوانب بشكل صفائح ذات لون أخضر أو مائل إلى الخضرة. انظر الصورة؛ جلود رقاق يُكتَبُ عليها) / وَرَقَة / وَرَقِيّ\nمثال: هات ورقة بيضاء.",
 "ペイメント": "دَفْع (لزّه ونحاه وأبعده؛ صرفه قبل وروده، أي منعه وأبعده قبل مجيئه أو حدوثه، وعكسه أن يرفعه، اي أن يصرفه بعد حدوثه)\nمثال: دفع زيري الثمن.",
 "ペイルエール": "بيل إيل, جعة شاحبة (جعة ذات لون كهرماني مخمرة مع شعير شاحب؛ تشبه الجعة المُرة لكنها أكثر جفافاً وأخف)",
 "ペイロード": "بضاعة منقولة, حمولة (بضائع تحملها مركبة كبيرة) / حمولة متفجرة, رأس حربي (الجزء الأمامي من صاروخ موجه أو قذيفة أو طوربيد يحمل الشحنة النووية أو المتفجرة أو العوامل الكيميائية أو البيولوجية)",
 "ペイロール": "إدارة الأجور, قسم الرواتب (القسم الذي يحدد مبالغ الأجور أو الرواتب المستحقة لكل موظف) / كشف الرواتب, مسير الرواتب (قائمة بالموظفين ورواتبهم) / إجمالي الأجور, كشف الرواتب (المبلغ الإجمالي للمال المدفوع في الأجور)\nمثال: كان لدى الشركة كشف رواتب طويل",
 "ペイン": "أسيد, حمض (اسم دارج لثنائي إيثيل أميد حمض الليسرجيك) / لوح زجاج النافذة, لوح زجاجي (زجاج مسطح مقطع بأشكال للنوافذ أو الأبواب) / ألواح تكسية, تلبيسة (لوحة أو قسم من الألواح في جدار أو باب) / أَلَمٌ (الوَجَع) / آلَمَ, يُؤْلِمُ (سبَّبَ أَلَمًا حسّيًّا أو وجعًا في الجسد؛ سَبَّبَ له الألَم)\nمثال: ألم أقل لك ذلك؟",
 "ペインタ": "رَسَّام, رَسَّامَة (الفَنَّان الذي يَصْنَعُ الرُّسُومَ) / دَهَّان, دَهَّانَة\nمثال: إنه رسام مشهور.",
 "ペインター": "رَسَّام, رَسَّامَة (الفَنَّان الذي يَصْنَعُ الرُّسُومَ) / دَهَّان, دَهَّانَة\nمثال: إنه رسام مشهور.",
 "ペインティング": "لَوْحَة, صُورَة / طِلَاء, دِهَان",
 "ペイント": "دِهَان / لَوَّنَ (صفة خارجة للشيء ترى بالعين فقط ولا تلمس أو تسمع أو تشم أو يمكن تذوقها؛ كناية عن النَوع أو الشكل أو مجموعة من الصفات المختلفة في جنس واحد)\nمثال: ما هو لون شعرك؟",
 "ペイントボール": "بينتبول, كرات الطلاء (لعبة تحاكي القتال العسكري؛ يحاول اللاعبون في فريق واحد القضاء على لاعبي الفريق المعارض عن طريق إطلاق كبسولات الطلاء عليهم) / كرة طلاء (كبسولة مملوءة بصبغة قابلة للذوبان في الماء تستخدم كقذيفة في لعبة كرات الطلاء)",
