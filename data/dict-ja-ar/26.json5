 "真成": "حَقٌّ (اسم من الأسماء الحسنى وهو من صفات الله. لا جمع له؛ ضد البَاطِل، العَدْل والحَقِيْقَة والوُجُوْد الثَابِت والصِدْق والذي لا جدال فيه. لا جمع له)\nمثال: الأستاذ على حق.",
 "真摯": "مُخْلِص (الشخص الذي يفي ولا يخون)\nمثال: الغيرة لا تجعل أحد مخلص",
 "真旦": "الصِّين (دولة في شرق آسيا؛ اسمها الرسمي جُمْهُورِيَّة الصِّين الشَّعْبِيَّة، وعاصمتها بِكِّين) / صِينِيَّة (نوع من آنية المطبخ تستخدم لوضع الآواني عليها حين تنقل تكون مسطحة وواسعة؛ القُصْعَة؛ آنية واسعة يُصَّب فيها طعام يكفي عصبة من الناس)\nمثال: الصين بلد عظيم.",
 "真昼の夢": "حُلْم يَقَظَة (رأى في نومه)\nمثال: هذا الحلم سيتحقق.",
 "真核生物": "حقيقيات النوى",
 "真横": "جَانِب / صَفْحَة",
 "真正": "أَصْلِيّ",
 "真正水平派": "حَفَّار",
 "真正直": "صَرِيح, مُسْتَقِيم",
 "真水": "مَاء عَذْب (السائل الشفاف المعروف الذي تنشأ به الحياة، عديم اللون والرائحة والطعم عندما يكون نقيا؛ علميا فِي : جزيئة متكونة من ذرتي هيدروجين مرتبطين بذرة واحدة من الأوكسيجين)\nمثال: أنا أشرب الماء.",
 "真猿": "سَعْدَان, قِرْد",
 "真猿類": "قِرْدِيَّاتُ الشَّكْلِ",
 "真率": "إِخْلَاص (وقيل: الإخلاص تصفية الأعمال من الكدورات؛ وقيل: الإخلاص: ستر بين العبد وبين الله تعالى لا يعلمه ملك فيكتبه، ولا شيطان فيفسده، ولا هوًى فيميله. والفرق بين الإخلاص والصدق: أن الصدق أصل…)",
 "真珠": "لُؤْلُؤَة / لُؤْلُؤ (نوع من المجوهرات الغالية التي تكون في البحر عميقًا؛ اسم شخصي معطًى ذو استخدامات تاريخية للذكور من العرب) / جَوْهَر (جَوْهَر)\nمثال: يريد شراء عقد لؤلؤ لزوجته.",
 "真珠層": "عِرْق اللُّؤْلُؤ, زِلْف (وريد أو شريان، مجرى الدَّم في الجسَد؛ جِنْس؛ سُلَالَة من النّاس يُصنَّفون بناء على التَّاريخ أو الجنسيّة أو التّوزيع الجغرافيّ المشترك)\nمثال: هذا القميص مبلل بالعرق.",
 "真珠母": "عِرْق اللُّؤْلُؤ, زِلْف (وريد أو شريان، مجرى الدَّم في الجسَد؛ جِنْس؛ سُلَالَة من النّاس يُصنَّفون بناء على التَّاريخ أو الجنسيّة أو التّوزيع الجغرافيّ المشترك)\nمثال: هذا القميص مبلل بالعرق.",
 "真珠質": "عِرْق اللُّؤْلُؤ, زِلْف (وريد أو شريان، مجرى الدَّم في الجسَد؛ جِنْس؛ سُلَالَة من النّاس يُصنَّفون بناء على التَّاريخ أو الجنسيّة أو التّوزيع الجغرافيّ المشترك)\nمثال: هذا القميص مبلل بالعرق.",
 "真理": "حَقِيقَة (الحَقّ، نقيض البَاطِل؛ نقيض المَجَاز)\nمثال: هي صديقة حقيقة.",
 "真田": "ضَفَّرَ, ضَفَرَ / جَدِيلَة, ضَفِيرَة",
 "真田紐": "ضَفَّرَ, ضَفَرَ / جَدِيلَة, ضَفِيرَة",
 "真白": "خَالٍ, اَلْخَالِي (بمعنى ظَنَّ، استخدام نادر والأغلب استخدام خَيْل أو مَخَالَة؛ أخو الأم. جمعه أخوال للمذكر وخالات للمؤنث)\nمثال: عندي ابنا خالة.",
 "真皮": "أَدَمة",
 "真直": "مُسْتَقِيم (ما جُعِلَ قَائِمًا غير مُنْحَنٍ؛ ما ليس به عِوَج) / عَلَى طُول (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: إرسم خط مستقيم. / صَرِيح, مُسْتَقِيم",
 "真直ぐ": "مُسْتَقِيم (ما جُعِلَ قَائِمًا غير مُنْحَنٍ؛ ما ليس به عِوَج) / عَلَى طُول (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: إرسم خط مستقيم. / صَرِيح, مُسْتَقِيم",
 "真相": "حَقِيقَة (الحَقّ، نقيض البَاطِل؛ نقيض المَجَاز)\nمثال: هي صديقة حقيقة.",
 "真相調査": "تقصي الحقائق",
 "真砂": "رَمْل (ذرات دقيقة من الصخور أو المعادن، تتكون طبيعياً بفعل الرياح أو الماء؛ تربة رخوة تتكوّن غالباً على الشاطئ أو في الصحارى)\nمثال: وصلت شاحنة الرمل.",
 "真神": "ذِئْب (حيوان مفترس من فصيلة الكلاب يعيش في جماعات وأكثر ما يصطاد في الليل؛ صفة تطلق على الرجل الذي يخدع النساء ليحصل على مراده منهن بالدهاء) / ديب / ذيب / اِلْتَهَمَ بِشَرَاهَة\nمثال: نظرة الذئب للشاة.",
 "真秀": "مُمْتَاز, فَاخِر / أَصْلِيّ / صَرِيح, مُسْتَقِيم",
 "真空": "خَلَاء, فَرَاغ (المكان الخالي من الناس، غالبا ما يقصد به الأماكن غير المزروعة والتي تركت طبيعية؛ المِرْحَاض، الغرفة التي تقضى فيها الحاجة)\nمثال: حبب إليه الخلاء.",
 "真空容器": "حُجْرَة فَرَاغِيَة (الغُرْفَة أو القَاعَة. تطلق على القَبْر والحَضِيرَة من باب التشبيه؛ ما يشبه الغرفة من الأرض، المكان المحمي أو المحاط بما يجعله شبيها بالمنعى الأول. استخدام مجازي وقديم)\nمثال: قعدنا في وسط الحجرة.",
 "真空掃除機": "مِكْنَسَة كَهْرَبَائِيَّة",
 "真筆": "تَوْقِيع, أُوتُوجْرَاف (أن يصيب المَطَر بعض الأَرْض ويخطيء بعضها؛ نوع من الخَطّ)\nمثال: أحتاج لتوقيع توم.",
 "真箇": "حَقِيقِيّ / وَاقِعِيّ / رِيَال (العُمْلَة الرسمية لدى)",
 "真経津の鏡": "مِرْآة, مراية (أداة لها القابلية على عكس الضوء بطريقة تحافظ على الكثير من صفاتهما الأصلية قبل ملامسة سطح المرآة)\nمثال: أنظر في المرآة!",
 "真苧": "قُنَّبُ سِيَام",
 "真菌": "فُطْر ( مَا تَفَطَّر مِنَ النَّبَاتِ، والفُطْر جِنْسٌ مِنَ الكَمْءِ أَبيض عِظَامٌ لأَن الأَرض تَنْفطر عَنْهُ؛  في هو اسم يطلق على طائفة من اللازهريات خالية من الكلوروفيل منها فصائل وأَجناس وأَنواع عديدة وتسمى أيضًا فُطْريّات، منها ما يُؤْكَلُ، وما هو سامٌ…)\nمثال: وجدت بعض الفطر.",
 "真菌学": "عَلْم الفَطْرِيَات (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "真裸": "عُرْي",
 "真誠": "حَقٌّ (اسم من الأسماء الحسنى وهو من صفات الله. لا جمع له؛ ضد البَاطِل، العَدْل والحَقِيْقَة والوُجُوْد الثَابِت والصِدْق والذي لا جدال فيه. لا جمع له)\nمثال: الأستاذ على حق.",
 "真諦": "جَوْهَر, مَاهِيَّة (جَوْهَر)\nمثال: الجمال في الجوهر لا المظهر",
 "真赤": "شطف (غسل أو نظف الشيء بالماء، غالبًا بمعنى التنظيف العميق؛ في بعض الاستخدامات، يمكن أن تعني إزالة ما علق بالشيء من أوساخ أو شوائب) / اِنْتَهَى, أَكْمَلَ (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات) / كَامِل / ذَرِيع\nمثال: انتهى أمر زيري.",
 "真鍮": "شَبَه / صُفْر (الخَالِي كأنه تَصْفِر فيه الرِيح. ويقال أيضا صَفْر وصُفْر؛ في : هي عَدَد قيمته لا شيء، أو خالية) / صُفَّر (الخَالِي كأنه تَصْفِر فيه الرِيح. ويقال أيضا صَفْر وصُفْر؛ في : هي عَدَد قيمته لا شيء، أو خالية)\nمثال: بدأ سامي من نقطة الصفر.",
