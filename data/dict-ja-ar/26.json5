 "フルニトラゼパム": "روهيبنول, فلونيترازيبام (مهدئ ومثبط (الاسم التجاري روهيبنول) يستخدم غالباً في ارتكاب الاعتداء الجنسي؛ متاح قانونياً في أوروبا والمكسيك وكولومبيا)",
 "フルネルソン": "نيلسون كامل (مسكة مصارعة يضع فيها الحامل كلا ذراعيه تحت ذراعي الخصم ويضغط على الرقبة)",
 "フルハウス": "بيت كامل, فل هاوس (يد بوكر تحتوي على ثلاث بطاقات من نوع واحد وزوج من نوع آخر)",
 "フルバック": "ظهير كامل, فُل باك ((كرة قدم أمريكية) مركز ظهير في فريق كرة القدم، عموماً أكبر حجماً من الظهير النصفي) / ظهير كامل ((في كرة القدم الأمريكية) الظهير الراكض الذي يلعب في مركز الظهير الكامل في الفريق الهجومي)",
 "フルファッション": "مُفَصَّل عَلَى الجَسَد (محاك ليُلائم شكل الجسد)",
 "フルフィル": "إشباع, تحقيق (فعل إتمام شيء ما (كرغبة أو وعد)) / إنجاز, تحقيق الذات (شعور بالرضا لتحقيق رغباتك)",
 "フルフィルメント": "إشباع, تحقيق (فعل إتمام شيء ما (كرغبة أو وعد)) / إنجاز, تحقيق الذات (شعور بالرضا لتحقيق رغباتك)",
 "フルフェイス": "مُوَاجِه, نَاظِر لِلأَمَام (ينظر ويتطلع إلى الأمام)",
 "フルフェイスマスク": "مُوَاجِه, نَاظِر لِلأَمَام (ينظر ويتطلع إلى الأمام)",
 "フルフェイス・マスク": "مُوَاجِه, نَاظِر لِلأَمَام (ينظر ويتطلع إلى الأمام)",
 "フルフラール": "فورفورال (ألديهيد سائل ذو رائحة نفاذة؛ يصنع من قشور النباتات وكوالح الذرة؛ يستخدم في صنع الفوران وكمذيب)",
 "フルフル": "بصوت خافت, بهدوء (بحجم صوت منخفض) / بخفة, برفق (بقليل من الوزن أو القوة) / بشكل خافت, بنعومة (توجيه في الموسيقى؛ للعزف بنعومة وهدوء نسبي) / برقة, بنعومة (بطريقة ترضي الحواس)\nمثال: تحدث بهدوء ولكن احمل عصا غليظة",
 "フルプライス": "السعر المعلن, سعر القائمة (سعر بيع شيء ما كما هو مذكور في كتالوج أو قائمة أسعار؛ غالباً ما يخضع للخصومات)\nمثال: حصلت عليه بخصم 30% من سعر القائمة",
 "フルページディスプレイ": "بِصَفْحَةٍ كَامِلَة (يشغل صفحة كاملة في كتاب أو جريدة)",
 "フルマラソン": "غَيْر مُختَصَر, كَامِل (كامل بلا حذف أو اختصار) / بِالطُّولِ الكَامِل (يمثّل أو يستوعب الطول بالكامل)",
 "フルムーン": "بَدْر (البَدْرُ : القَمَرُ إِذا امْتَلأَ، وإِنما سُمِّيَ بَدْراً لأَنه يُبَادِرُ بالغُرُوب طُلُوع الشَّمْسِ…؛ البَدْرُ الغلامُ المكتمل أو الممتلئ)",
 "フルメンバー": "اَلْجَمِيع, كُلّ شَخْص",
 "フルレングス": "غَيْر مُختَصَر, كَامِل (كامل بلا حذف أو اختصار) / بِالطُّولِ الكَامِل (يمثّل أو يستوعب الطول بالكامل)",
 "フルンケル": "خراج, دمل (قرحة مؤلمة ذات لب صلب مملوء بالقيح)",
 "フル・サイズ": "بِالحَجْم الطَّبِيعِيّ (بنفس حجم الأصل)",
 "フル・スカート": "تنورة واسعة (تنورة طويلة مزمومة عند الخصر)",
 "フル・ストップ": "نُقْطَة, عَلَامَة فَصْلِيَّة (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه)\nمثال: هذه هي نقطة ضعفه.",
 "フル・タイム": "بَدَوَام كَامِل (لعدد الساعات القياسي) / بدوام كامل (لكامل الوقت المناسب لنشاط ما)\nمثال: تعمل بدوام كامل",
 "フル・ネルソン": "نيلسون كامل (مسكة مصارعة يضع فيها الحامل كلا ذراعيه تحت ذراعي الخصم ويضغط على الرقبة)",
 "フル・ハウス": "بيت كامل, فل هاوس (يد بوكر تحتوي على ثلاث بطاقات من نوع واحد وزوج من نوع آخر)",
 "フル・プライス": "السعر المعلن, سعر القائمة (سعر بيع شيء ما كما هو مذكور في كتالوج أو قائمة أسعار؛ غالباً ما يخضع للخصومات)\nمثال: حصلت عليه بخصم 30% من سعر القائمة",
 "フル・ページ・ディスプレイ": "بِصَفْحَةٍ كَامِلَة (يشغل صفحة كاملة في كتاب أو جريدة)",
 "フル・マラソン": "غَيْر مُختَصَر, كَامِل (كامل بلا حذف أو اختصار) / بِالطُّولِ الكَامِل (يمثّل أو يستوعب الطول بالكامل)",
 "フル・ムーン": "بَدْر (البَدْرُ : القَمَرُ إِذا امْتَلأَ، وإِنما سُمِّيَ بَدْراً لأَنه يُبَادِرُ بالغُرُوب طُلُوع الشَّمْسِ…؛ البَدْرُ الغلامُ المكتمل أو الممتلئ)",
 "フル・メンバー": "اَلْجَمِيع, كُلّ شَخْص",
 "フルーツ": "فَاكِهَة (الثمار كلها؛ ما يتنعم بأكله رطبا كان أم يابسا كالتين واللوز والرمان ونحوها) / ثَمَرَة, شَاذّ جِنْسِيًّا / أَثْمَرَ (أثمر الشجر: صار فيه الثمر؛ أثمر الشجر: طلع ثمره قبل أن ينضج)\nمثال: التفاح فاكهة لذيذة.",
 "フルーツカクテル": "سلطة فواكه, كوكتيل فواكه (خليط من الفواكه المقطعة إلى شرائح أو مكعبات)",
 "フルーツケーキ": "كعكة الفواكه (كعكة غنية تحتوي على فواكه مجففة ومكسرات وقشر حمضيات وما إلى ذلك) / مَخْبُول, مَعْتُوه (شخص غريب الأطوار بشكل هزلي أو مجنون)",
 "フルーツサラダ": "سلطة فواكه (سلطة مكونة من الفواكه)",
 "フルーツジュース": "عصير الفاكهة (مشروب يتم إنتاجه عن طريق عصر أو سحق الفاكهة)",
 "フルーツポンチ": "بونش الفواكه (بونش مصنوع من عصائر الفاكهة الممزوجة بالماء أو ماء الصودا (مع أو بدون كحول))",
 "フルーツ・カクテル": "سلطة فواكه, كوكتيل فواكه (خليط من الفواكه المقطعة إلى شرائح أو مكعبات)",
 "フルーツ・サラダ": "سلطة فواكه (سلطة مكونة من الفواكه)",
