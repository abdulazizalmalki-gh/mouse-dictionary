 "ブラックパンサー": "الفهود السود (حزب سياسي أسود متشدد تأسس عام 1965 لإنهاء الهيمنة السياسية للبيض)",
 "ブラックフェイス": "مكياج الوجه الأسود (المكياج (عادة من الفلين المحروق) الذي يستخدمه المؤدي لتقليد ذوي البشرة السوداء)",
 "ブラックフライデー": "الْجُمُعَة السَّوْدَاء, الجُمُعَة الْبَيْضَاء",
 "ブラックベリ": "تُوت العُلَّيْق, بَاطُس",
 "ブラックベリー": "تُوت العُلَّيْق, بَاطُس",
 "ブラックペッパー": "فِلْفِل أَسْوَد (حَبّ حريف يوضع في الطعام أو يطحن يستخدم كتابل. يكون منه أسود أو أبيض، حرارته متوسطة؛ فُلْفُل حَارّ: نبات ثمره حريف لونه أخضر وقد يحمرّ شديد الحرارة. يؤكل كما هو أو يجفف ويطحن ويستخدم كتابل)\nمثال: نحب الفلفل الحار.",
 "ブラックホール": "ثُقْب أَسْوَد (فَجَّرَ أو خَرَقَ شيئًا بفتح فيه؛ نَفَذَ أو مرَّ عبر شيء)\nمثال: انه ثقب الاسود.",
 "ブラックボックス": "صُنْدُوق أَسْوَد (وعاء كبيرة من الخشب غالبا وقد يكون حديدًا يستخدم لوضع الاشياء داخله، ويكون لها عادة جهة قابلة للفتح سواء بمفاصل او بالازالة الكاملة؛ صُنْدُوْقُ السَيَّارَة قمرة تشبه الصندوق في الجزء الخلفي من السيارة يستخدم كالصندوق)\nمثال: أين صندوق البريد؟",
 "ブラックボード": "سَبُّورَة, لَوْح",
 "ブラックマジック": "سِحْر أَسْوَد (ألقى السحر على شخص أو شيء، بمعنى جعله تحت تأثير السحر؛ أدهش أو أبهر بجمال أو جاذبية غير عادية)\nمثال: هذا هو سحر الجزائر.",
 "ブラックマーケット": "سُوق سَوْدَاء (مكان للبيع والشراء؛ جمع ساق، قال الله تعالى: 《رُدُّوهَا عَلَيَّ فَطَفِقَ مَسْحًا بِالسُّوقِ وَالْأَعْنَاقِ》)\nمثال: ذهبت إلى السوق.",
 "ブラックミュージック": "الموسيقى السوداء, موسيقى الأمريكيين الأفارقة (موسيقى أنشأها موسيقيون أمريكيون من أصل أفريقي؛ كانت الأشكال المبكرة عبارة عن أغانٍ ذات خط لحني وإيقاع قوي مع لازمة متكررة)",
 "ブラックユーモア": "فكاهة سوداء, كوميديا سوداء (تجاور العناصر المرضية والهزلية (في الكتابة أو الدراما) لإعطاء تأثير مزعج)",
 "ブラックライト": "أشعة فوق بنفسجية (إشعاع يقع في النطاق فوق البنفسجي؛ أطوال موجية أقصر من الضوء ولكن أطول من الأشعة السينية)",
