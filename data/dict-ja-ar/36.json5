 "寒々": "شَتَوِيّ / قَاتِم, كَئِيب (لا يبعث على الأمل إلّا قليلاً أو لا يبعث عليه أبداً) / جَرْدَاء, قَاحِلَة (لا توفِّر مأوى ولا قوتاً) / قَارِص, كَئِيب (بارد ورطب بشكل مُزعج)",
 "寒々しい": "قَاتِم, كَئِيب (لا يبعث على الأمل إلّا قليلاً أو لا يبعث عليه أبداً) / جَرْدَاء, قَاحِلَة (لا توفِّر مأوى ولا قوتاً) / قَارِص, كَئِيب (بارد ورطب بشكل مُزعج)",
 "寒い": "بَارِد, برد (مُنْخَفِض الحَرارة أو حَرارتُه أقلّ من حَرارة جسْم الإنسان؛ غير حامٍ، أو متروك بلا حماوة، غير محميّ على النَّار) / بَرْدَان / بُرُودَة, بَرْد / زُكَام, رَشْح\nمثال: الماء بارد حقا. / مُمِلّ المُؤَسَّسَاتِيَّة (يتَّسم بطابع المؤسَّسة خاصَّة في الرتابة والجمود) / غير مثير للاهتمام, ممل (لا يثير أي اهتمام أو انتباه أو فضول أو إثارة)\nمثال: رواية غير مثيرة للاهتمام للغاية عن رحلتها",
 "寒からしめる": "برودة شديدة, صقيع (برودة ناتجة عن بيئة باردة) / رجفة, رعشة (إحساس بالخوف يكاد يكون ممتعاً) / انقباض, وجوم (رهبة مفاجئة تسبب الشلل) / رجفة, قشعريرة (إحساس بالبرد غالباً ما يشير إلى بداية عدوى وتطور حمى)\nمثال: سرت فيه رعشة مفاجئة",
 "寒さ": "بُرُودَة",
 "寒の戻り": "موجة برد (فترة من الطقس البارد)",
 "寒イボ": "قشعريرة, منعكس محرك للشعر (انتصاب انعكاسي لشعر الجلد استجابة للبرد أو الضغط العاطفي أو تهيج الجلد)",
 "寒冷": "بَارِد, برد (مُنْخَفِض الحَرارة أو حَرارتُه أقلّ من حَرارة جسْم الإنسان؛ غير حامٍ، أو متروك بلا حماوة، غير محميّ على النَّار) / بَرْدَان / بُرُودَة, بَرْد / زُكَام, رَشْح\nمثال: الماء بارد حقا.",
 "寒冷前線": "جبهة باردة (مقدمة كتلة هوائية باردة تتقدم)",
 "寒冷紗": "شاش, قماش الجبن (شاش قطني خشن فضفاض النسج؛ كان يستخدم في الأصل لتغليف الجبن)",
 "寒剤": "خليط تبريد (خليط من المواد (عادة الملح والثلج) للحصول على درجة حرارة أقل من نقطة تجمد الماء)",
 "寒天": "طقس بارد (فترة من الطقس البارد بشكل غير عادي) / أغار, أغار أغار (مستخلص غرواني من الطحالب؛ يستخدم خاصة في أوساط الاستنبات وكعامل تبلور في الأطعمة)",
 "寒天培地": "آغار, أجار مغذ (أي وسط استنبات يستخدم الآغار كعامل هلامي)",
 "寒寒": "شَتَوِيّ / قَاتِم, كَئِيب (لا يبعث على الأمل إلّا قليلاً أو لا يبعث عليه أبداً) / جَرْدَاء, قَاحِلَة (لا توفِّر مأوى ولا قوتاً) / قَارِص, كَئِيب (بارد ورطب بشكل مُزعج)",
 "寒寒しい": "قَاتِم, كَئِيب (لا يبعث على الأمل إلّا قليلاً أو لا يبعث عليه أبداً) / جَرْدَاء, قَاحِلَة (لا توفِّر مأوى ولا قوتاً) / قَارِص, كَئِيب (بارد ورطب بشكل مُزعج)",
 "寒帯": "المنطقة القطبية, المنطقة المتجمدة (جزء سطح الأرض الذي يشكل غطاء فوق القطب؛ ويتميز بمناخ متجمد)",
 "寒帯前線": "جبهة باردة (مقدمة كتلة هوائية باردة تتقدم)",
 "寒帯前線ジェット気流": "جبهة باردة (مقدمة كتلة هوائية باردة تتقدم)",
 "寒帯林": "تَايْغَا",
 "寒心": "مُؤْسِف, مُحْزِن (سيء ومؤسف؛ يبعث على الأسى) / مَذْمُوم, مُسْتَنْكَر (يستحقّ التوبيخ أو اللوم الشديد) / بَائِس, مُزْرٍ (رديء الجودة أو الحالة جدًا)",
 "寒昴": "الثُّرَيَّا",
 "寒暖": "دَرَجَةْ الْحَرَارَة / حُمَّى (حمَى الشيءُ فلانًا: منَعه ودفع عنه؛ حمى المريضَ: منعه ما يضره)\nمثال: ليس لديك أي حمى.",
 "寒暖計": "تِرْمُومِتْر, مِقْيَاسُ الْحَرَارَة",
 "寒松": "شجرة الصنوبر, صنوبر (شجرة صنوبرية)",
 "寒桜": "زهرة الربيع الصينية (زهرة ربيع آسيوية مزروعة)",
 "寒梅": "برقوق, خوخ (أي من عدة أشجار تنتج فاكهة بيضاوية صالحة للأكل ذات قشرة ناعمة ونواة صلبة واحدة)",
 "寒気": "برودة شديدة, صقيع (برودة ناتجة عن بيئة باردة) / رجفة, رعشة (إحساس بالخوف يكاد يكون ممتعاً) / انقباض, وجوم (رهبة مفاجئة تسبب الشلل) / رجفة, قشعريرة (إحساس بالبرد غالباً ما يشير إلى بداية عدوى وتطور حمى)\nمثال: سرت فيه رعشة مفاجئة / بَارِد, برد (مُنْخَفِض الحَرارة أو حَرارتُه أقلّ من حَرارة جسْم الإنسان؛ غير حامٍ، أو متروك بلا حماوة، غير محميّ على النَّار) / بَرْدَان / بُرُودَة, بَرْد / زُكَام, رَشْح\nمثال: الماء بارد حقا.",
 "寒水": "إِحْبَاط, تَثْبِيط (التقليل من شأن خطة أو أمل أو توقع)\nمثال: سكبت الماء البارد على فكرة الذهاب إلى أفريقيا بأكملها",
 "寒波": "مَوْجَةُ اْلبَرْدِ",
 "寒熱": "بردية, حمى الملاريا (مراحل متعاقبة من القشعريرة والحمى وهي عرض للملاريا)",
 "寒疣": "قُشَعْرِيرَة",
 "寒空": "طقس بارد (فترة من الطقس البارد بشكل غير عادي)",
 "寒緋桜": "كرز الشتاء, كرز القدس (شجيرة صغيرة من أمريكا الجنوبية تزرع كنبات منزلي لثمارها الحمراء أو الصفراء الزخرفية الوفيرة ولكن السامة بحجم الكرز) / فانوس صيني, كرز الشتاء (نبات معمر من العالم القديم يزرع لكأسه الورقي البرتقالي المحمر المنفوخ الزخرفي)",
 "寒鮒": "شبوط كروشي (شبوط أوروبي يشبه إلى حد كبير السمكة الذهبية البرية)",
 "寓する": "اِنْطَوَى",
 "寓喩": "تَمْثِيل",
 "寓意": "رَمْزِيَّة",
 "寓意劇": "مسرحية أخلاقية (مسرحية رمزية شاعت في القرنين الخامس عشر والسادس عشر؛ حيث تجسد الشخصيات الفضائل والرذائل)",
 "寓意小説": "تَمْثِيل",
 "寓意的": "تَمْثِيلِيّ, رَمْزِيّ (يُستخدم في الرمز أو يتميز به أو يحتوي عليه)",
 "寓言": "تَمْثِيل",
 "寓話": "خُرَافَة, أُسْطُورَة / خُرَافَة",
 "寛": "لَيِّن, مُتَسَاهِل (يتّسم بالتسامح والرحمة في التعامل) / لَيِّن, مُتَسَاهِل (غَيْرُ صَارِمٍ فِي تَطْبِيقِ القَوَاعِد) / لَيِّن, مُتَسَامِح (متسامح ورحيم في المعاملة) / مسترخٍ, هادئ (بدون إجهاد أو قلق)\nمثال: أعطى انطباعاً بأنه مسترخٍ تماماً",
 "寛ぎ": "استجمام, استرخاء (التحرر من النشاط (العمل أو الجهد أو المسؤولية)) / بَسَاطَة, سُهُولَة (التحرر من الصعوبة أو المشقة أو الجهد) / أَرِيحِيَّة, بَسَاطَة (التحرر من القيد أو الحرج) / تخفيف, راحة (حالة الارتياح أو التخفيف (خاصة بعد التخلص من الضيق))\nمثال: أخذ قسطاً من الراحة بجانب المسبح",
 "寛ぐ": "اِسْتَرْخَى",
 "寛げる": "فَضْفَاض, واسِع",
 "寛仁": "سَمْح, كَرِيم النَّفْس (سخي ومتفهم ومتسامح) / شَهْم, كَرِيم النَّفْس (نبيل وكريم في الروح والطبع)",
 "寛厚": "إِحْسَان",
 "寛大": "رَحْب الصَّدْر, مُتَسَامِح (يُظْهِر أَوْ يَتَّسِم بِسَعَة الأُفُق والتَّسَامُح) / حَلِيم, صَبُور (مُتَسَامِحٌ وَصَفُوحٌ عِنْدَ الِاسْتِفْزَازِ) / مُتَسَامِح, مُحْتَمِل (يُظْهِرُ قُدْرَةً عَلَى التَّحَمُّل) / مُتَحَمِّل, مُقَاوِم (قادر على تحمل الظروف البيئية أو الإجهاد الفسيولوجي)",
 "寛容": "تَحَمُّل / تَسَامُح",
 "寛恕": "شهامَة",
 "寛然": "رابط الجأش, رزين (يتمتع بضبط النفس والهدوء وخلو من الاضطراب خاصة في أوقات التوتر)\nمثال: بدت المؤدية رابطة الجأش تماماً وهي تصعد إلى المسرح",
 "寛解": "عَفْو, صَفْح",
 "寛闊": "كَرِيم (نبيل النفس عزيزها ذو الخلق العالي والخير الكثير والعطاء السخي. الكَرَم يشمل مجموعة من الأخلاق أهمها العطاء؛ الجَوَاد السخيّ تحديدا)\nمثال: يا لك من رجل كريم!",
 "寛骨": "عظم الحوض, عظم الورك (عظم كبير واسع يشكل نصف الحوض؛ يتكون من الحرقفة والإسك والعانة)",
 "寛骨臼": "تجويف حقي, حُق (التجويف الكأسي الشكل في عظم الورك الذي يستقبل رأس الفخذ لتشكيل مفصل كروي وحقي)",
 "寝": "نَامَ, رَقَدَ (الإنسان أو الحيوان: رَقَدَ وغَفَا؛ الإنسان أو الحيوان: رَقَدَ وإن لم يغفو) / نَوْم, سِنَة (بكافة معانيه) / نَوْمَة / غَمَص, رَمَص\nمثال: نام في الحافلة. / اِسْتَلْقَى (وَضَعَ ظَهْرَهُ عَلَى سَطْحٍ كَالسَّرِيرِ والأَرْضِ للنوم أو الاستراحة) / اِضْطَجَعَ\nمثال: استلقى على السرير.",
 "寝かしつける": "نَوَّمَ, أَنَامَ (بكافة معانيه)\nمثال: لم أستطع النوم.",
 "寝かし付ける": "نَوَّمَ, أَنَامَ (بكافة معانيه)\nمثال: لم أستطع النوم.",
 "寝ころぶ": "اِسْتَلْقَى (وَضَعَ ظَهْرَهُ عَلَى سَطْحٍ كَالسَّرِيرِ والأَرْضِ للنوم أو الاستراحة) / اِضْطَجَعَ\nمثال: استلقى على السرير.",
 "寝すぎる": "اِسْتَغْرَقَ فِي النَّوْم",
 "寝ずの番": "النوبة الليلية, نوبة آخر الليل (نوبة حراسة أثناء الليل (كما من منتصف الليل إلى 8 صباحاً))",
 "寝そべる": "انبطاح, تمدد (وضعية غير أنيقة مع تباعد الذراعين والساقين) / تكتل حضري, تمدد حضري (تجمع أو شبكة متصلة من المجتمعات الحضرية)",
 "寝たきり": "طَرِيح الْفِرَاش, مُلَازِم لِلسَّرِير (ملازم للفراش بسبب المرض)",
 "寝っころがる": "اِسْتَلْقَى (وَضَعَ ظَهْرَهُ عَلَى سَطْحٍ كَالسَّرِيرِ والأَرْضِ للنوم أو الاستراحة) / اِضْطَجَعَ\nمثال: استلقى على السرير.",
 "寝っ転がる": "اِسْتَلْقَى (وَضَعَ ظَهْرَهُ عَلَى سَطْحٍ كَالسَّرِيرِ والأَرْضِ للنوم أو الاستراحة) / اِضْطَجَعَ\nمثال: استلقى على السرير.",
 "寝てもさめても": "باستمرار, بشكل متواصل (بشكل ثابت لا يتغير) / باستمرار, دائماً (بدون تنوع أو تغيير، في كل حالة)\nمثال: العالم يتغير باستمرار",
 "寝ても覚めても": "باستمرار, بشكل متواصل (بشكل ثابت لا يتغير) / باستمرار, دائماً (بدون تنوع أو تغيير، في كل حالة)\nمثال: العالم يتغير باستمرار",
 "寝ぬ": "نَامَ, رَقَدَ (الإنسان أو الحيوان: رَقَدَ وغَفَا؛ الإنسان أو الحيوان: رَقَدَ وإن لم يغفو) / نَوْم, سِنَة (بكافة معانيه) / نَوْمَة / غَمَص, رَمَص\nمثال: نام في الحافلة. / تَقَاعَدَ / اِعْتَزَلَ",
 "寝ぼすけ": "نَؤُوم, نَعْسَان (شخص يشعر بالنعاس)",
 "寝る": "نَامَ, رَقَدَ (الإنسان أو الحيوان: رَقَدَ وغَفَا؛ الإنسان أو الحيوان: رَقَدَ وإن لم يغفو) / نَوْم, سِنَة (بكافة معانيه) / نَوْمَة / غَمَص, رَمَص\nمثال: نام في الحافلة. / اِسْتَلْقَى (وَضَعَ ظَهْرَهُ عَلَى سَطْحٍ كَالسَّرِيرِ والأَرْضِ للنوم أو الاستراحة) / اِضْطَجَعَ\nمثال: استلقى على السرير. / خَمَرَ (شَرَابُ الْعِنَبِ إِذَا اخْتَمَرَ؛ كُلُّ مُسْكِرٍ مُخَامِرٍ لِلْعَقْلِ، إِذَا كَانَ شَرَاباً كُحُولِيّاً أَوْ غَيْرَهُ)\nمثال: أنت تشرب الخمر.",
 "寝るほど楽はなかりけり": "هُنَاكَ, يُوجَدُ",
 "寝るほど楽は無かりけり": "هُنَاكَ, يُوجَدُ",
 "寝る時間": "وقت النوم (الوقت الذي تذهب فيه إلى الفراش)",
 "寝わら": "مِحَفَّة / بَعْثَرَ",
 "寝付く": "غَلَّبَ النُعَاس, نَامَ (قَهَرَ واِعْتَزَّ عليه واِمْتَنَع)",
 "寝入る": "غَلَّبَ النُعَاس, نَامَ (قَهَرَ واِعْتَزَّ عليه واِمْتَنَع)\nمثال: その赤ちゃんは泣き疲れて寝入った。 — بكى الطفل حتى نام.",
 "寝具": "أغطية السرير, مفروشات السرير (الأغطية التي تستخدم على السرير) / فَرْشَة, فِرَاش (مادة تُستخدم لتهيئة فراش أو مرقد للحيوانات)",
 "寝具類": "أغطية السرير, مفروشات السرير (الأغطية التي تستخدم على السرير) / فَرْشَة, فِرَاش (مادة تُستخدم لتهيئة فراش أو مرقد للحيوانات)",
 "寝刃を合わす": "مَكِيدَة",
 "寝取られ": "دياثة (فعل جنسي يمارس فيه شخص متزوج الجنس مع شخص آخر بينما يشاهد الزوج ذلك)",
 "寝台": "قَاع, حَوْض (أَرْض مستوية سهلة تنصب إِليها مياه الأمطار فتمسكها ثم تُنبت العشب؛ القَعْر) / مَشَارَة, حَوْض\nمثال: نمت في قاعة السينما.",
 "寝台列車": "عربة نوم (عربة ركاب تحتوي على أسرّة للنوم)",
 "寝台券": "تَذْكِرَة / تذكرة",
 "寝台虫": "بَقّ ((بَقَّ) الرجل بقا: أَكثر القَوْل فِي صَوَاب أَو خطأ؛ (بَقَّ) الْمَرْأَة: كثر وَلَدهَا)\nمثال: قد غزا بق الفراش فرنسا.",
 "寝台車": "عربة نوم (عربة ركاب تحتوي على أسرّة للنوم)",
 "寝坊": "اِسْتَغْرَقَ فِي النَّوْم / نَؤُوم, نَعْسَان (شخص يشعر بالنعاس)",
 "寝坊助": "نَؤُوم, نَعْسَان (شخص يشعر بالنعاس)",
 "寝室": "مَخْدَع, غُرْفَةُ نَوْم",
 "寝小便": "تبول في الفراش (سلس البول أثناء النوم؛ شائع بشكل خاص عند الأطفال (الذين عادة ما يتجاوزونه مع النمو))",
 "寝屋": "مَخْدَع, غُرْفَةُ نَوْم",
 "寝巻": "ملابس نوم (ملابس مصممة للارتداء في السرير)",
 "寝巻き": "ملابس نوم (ملابس مصممة للارتداء في السرير)",
 "寝床": "قَاع, حَوْض (أَرْض مستوية سهلة تنصب إِليها مياه الأمطار فتمسكها ثم تُنبت العشب؛ القَعْر) / مَشَارَة, حَوْض\nمثال: نمت في قاعة السينما.",
 "寝心地": "تحسس / شَعَرَ (العِلْم؛ في : هو كلام مُقَفَّى ومُوَازَن على أوزان معروفة يُقصد به إظهار الكلام بصيغة فنية) / شَعَرَ بِ (العِلْم؛ في : هو كلام مُقَفَّى ومُوَازَن على أوزان معروفة يُقصد به إظهار الكلام بصيغة فنية)\nمثال: شعر ماريا طويل.",
 "寝忘れる": "اِسْتَغْرَقَ فِي النَّوْم",
 "寝所": "مَخْدَع, غُرْفَةُ نَوْم / مَخْدَع, غُرْفَةُ نَوْم / مجثم (مجثم تستريح عليه أو تنام عليه الطيور الداجنة) / مَجثَم (مأوى به عوارض لجلوس الدواجن أو الطيور الأخرى)",
 "寝棺": "تَابُوت (تَّابُوت: هو الصُّنْدُوق الذي توضع به الجثة؛ صندوق خشبيّ يكون مستطيل)",
 "寝椅子": "أَرِيكَة, كَنَبَة (قطعة أثاث مُنَجَّدَة يُقْعَدُ عليها، مَقْعَد مُنَجَّد)\nمثال: إنها على الأريكة.",
 "寝汗": "فَرْط التَّعَرُّق اللَّيْلِيّ",
 "寝汚い": "شعث, غير مرتب (غير نظيف وغير منظم)\nمثال: مهملة وغير مرتبة في عاداتها الشخصية",
 "寝泊まり": "إِقَامَة",
 "寝泊り": "إِقَامَة",
 "寝物語": "حديث الوسادة (محادثة حميمة بين العشاق (تحدث عادة في السرير)) / قِصَّةٌ قَبْلَ النَوْمِ",
 "寝穢い": "شعث, غير مرتب (غير نظيف وغير منظم)\nمثال: مهملة وغير مرتبة في عاداتها الشخصية",
 "寝藁": "مِحَفَّة / بَعْثَرَ",
 "寝衣": "ملابس نوم (ملابس مصممة للارتداء في السرير)",
 "寝袋": "حَقِيبَةُ النَّوْم",
 "寝覚め": "أَيْقَظَ (نبَّهه، ضد نَوَّمَه؛ الغبارَ: أثاره) / اِسْتَيْقَظَ, أَفَاقَ (منع النَوْم)\nمثال: أيقظ زيري السائق",
 "寝覚める": "صَحَا, اِسْتَيْقَظَ (أَفَاقَ؛ اِسْتَيْقَظَ) / أَيْقَظَ (نبَّهه، ضد نَوَّمَه؛ الغبارَ: أثاره)\nمثال: أيقظ زيري السائق",
 "寝言": "حديث أثناء النوم (نطق الكلام أثناء النوم) / هُرَاء, لَغْو",
 "寝起き": "وَاعٍ, يَقِظ (يتسم بالوعي الكامل والانتباه) / صحو, يقظة (حالة البقاء مستيقظاً)\nمثال: أيام الخطر وليالي اليقظة / حَيّ (ضد المَيِّت، على قيد الحَيَاة؛ جمع حَيَاء) / مَعِيشَة, مَعَاش / حَيَاة, طَرِيقَة فِي حَيَاة (الحَياة: ضد الموت والحَيُّ: ضدُّ الميّت؛ والمَحْيا مَفْعَلٌ من الحياة. تقول: مَحْيَاي ومماتي. والجمع الحَحايي)\nمثال: ينبح كلب في الحي.",
 "寝転がる": "اِسْتَلْقَى (وَضَعَ ظَهْرَهُ عَلَى سَطْحٍ كَالسَّرِيرِ والأَرْضِ للنوم أو الاستراحة) / اِضْطَجَعَ\nمثال: استلقى على السرير.",
 "寝転ぶ": "اِسْتَلْقَى (وَضَعَ ظَهْرَهُ عَلَى سَطْحٍ كَالسَّرِيرِ والأَرْضِ للنوم أو الاستراحة) / اِضْطَجَعَ\nمثال: استلقى على السرير.",
 "寝込み": "نَائِم",
 "寝返り": "خيانة, غدر (فعل خيانة متعمد) / خِيَانَة (صفة مساعدة العدو)",
 "寝返りを打つ": "قَلَبَ / خانَ (النُزْل أو الفُنْدُق أو اِسْتِرَاحَة المسافرين؛ الحَانُوْت أو الدُكَّان)\nمثال: خان ياني سكورة.",
 "寝返る": "خانَ (النُزْل أو الفُنْدُق أو اِسْتِرَاحَة المسافرين؛ الحَانُوْت أو الدُكَّان)\nمثال: خان ياني سكورة. / قَلَبَ",
 "寝過ぎる": "اِسْتَغْرَقَ فِي النَّوْم",
 "寝過ごす": "اِسْتَغْرَقَ فِي النَّوْم",
 "寝道具": "أغطية السرير, مفروشات السرير (الأغطية التي تستخدم على السرير) / فَرْشَة, فِرَاش (مادة تُستخدم لتهيئة فراش أو مرقد للحيوانات)",
 "寝部屋": "مَخْدَع, غُرْفَةُ نَوْم",
 "寝酒": "المباراة الختامية (المباراة الأخيرة في سلسلة من مباراتين متتاليتين) / قبعة نوم (قبعة قماشية تلبس في السرير) / مشروب قبل النوم (مشروب كحولي يؤخذ عند وقت النوم)",
 "寝醒める": "صَحَا, اِسْتَيْقَظَ (أَفَاقَ؛ اِسْتَيْقَظَ) / أَيْقَظَ (نبَّهه، ضد نَوَّمَه؛ الغبارَ: أثاره)\nمثال: أيقظ زيري السائق",
 "寝間": "مَخْدَع, غُرْفَةُ نَوْم",
 "寝間着": "ملابس نوم (ملابس مصممة للارتداء في السرير)",
 "寝静まる": "غَلَّبَ النُعَاس, نَامَ (قَهَرَ واِعْتَزَّ عليه واِمْتَنَع)",
 "察": "شُرْطِيّ (أحد المنتسبين إلى الشُرْطَة)\nمثال: تبدو وكأنك شرطي.",
 "察し": "اهتمام, مراعاة (عمل ينم عن مراعاة وتفكير بالآخرين) / اهتمام بالآخرين, مراعاة (احترام ومراعاة لطيفة للآخرين) / اعتبار, نظر (عملية التفكير المتأني في شيء ما) / اعتبار, حالة (معلومات يجب وضعها في الاعتبار عند اتخاذ قرار)\nمثال: لم يظهر أي مراعاة لمشاعرها",
 "察す": "خَمَّنَ, حزر ((خَمَّنَ) الشَّيْء: خمنه فَهُوَ مخمن)\nمثال: خمن الصائب: \"إن كانوا من السراعيف، فنعم\".",
 "察する": "خَمَّنَ, حزر ((خَمَّنَ) الشَّيْء: خمنه فَهُوَ مخمن)\nمثال: خمن الصائب: \"إن كانوا من السراعيف، فنعم\".",
 "察するに": "الْمُفْتَرَض مِنْ",
 "察知": "حَاسَّة / إِحْسَاس, شُعُور / مَعْنَى, دَلَالَة / مَوْهِبَة, قُدْرَة طَبِيعِيَّة / حَسَّ (حسّه:أحرقه ، حسسْتُ الشّيء:أحسَسْتُه،حسَسْتُ اللحمَ:جعلته على الجمر،حسَسْتُ النّارَ:رددْتُها بالعصا على خُبْزِ المَلّةِ؛ حَسَّ فلاناً:قتله قتلاً ذريعاً مستأصلاً رأسه.(حسَسْتُ اليهوديََ لما أظهر عداوته لله ودينه))\nمثال: لديهم حس الفكاهة.",
 "寡": "أَرْمَلَة / أَقَلِّيَّة / أَرْمَلَة",
 "寡人": "أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى.",
 "寡占": "احتكار القلة",
 "寡夫": "أَرْمَل ((أَرْمَلَ) المكان: صار ذا رمل؛ (أَرْمَلَ) فلان: نفد زاده وافتقر)\nمثال: هي أصبحت أرملة.",
 "寡婦": "أَرْمَلَة",
 "寡少": "زَهِيد, شَحِيح (ناقص في الكمية أو الحجم) / ضَيِّق, كَاشِف لِلْجَسَد ((عن الملابس) يكشف الجسد ويُظهره) / سروال داخلي نسائي (سراويل داخلية قصيرة للنساء أو الأطفال)",
 "寡居": "ترمل (حالة كون المرأة أرملة لم تتزوج مرة أخرى) / ترمل (فترة حياة المرأة عندما تكون أرملة)",
 "寡慾": "إيثار, سخاء (التصرف بكرم وسخاء) / إيثار, نكران الذات (صفة عدم وضع النفس أولاً والاستعداد لبذل الوقت أو المال أو الجهد من أجل الآخرين)\nمثال: يظهر سكان الريف تفانياً ونكراناً للذات أكثر من أبناء عمومتهم في المناطق الحضرية",
 "寡欲": "إيثار, سخاء (التصرف بكرم وسخاء) / إيثار, نكران الذات (صفة عدم وضع النفس أولاً والاستعداد لبذل الوقت أو المال أو الجهد من أجل الآخرين)\nمثال: يظهر سكان الريف تفانياً ونكراناً للذات أكثر من أبناء عمومتهم في المناطق الحضرية",
 "寡男": "أَرْمَل ((أَرْمَلَ) المكان: صار ذا رمل؛ (أَرْمَلَ) فلان: نفد زاده وافتقر)\nمثال: هي أصبحت أرملة.",
 "寡言": "تحفظ, تكتم (سمة قلة التواصل؛ عدم التطوع بأي شيء أكثر من الضروري)",
 "寡頭": "أوليغارشي, حاكم أقلية (أحد الحكام في نظام حكم الأقلية)",
 "寡頭制": "أُولِيغَارْكِي",
 "寡頭政治": "أُولِيغَارْكِي",
 "寡黙": "قَلِيل الحَدِيث, مُتَكَتِّم (يميل بطبعه إلى عدم الكلام)",
 "寥々": "وَحِيد, مُوحِش / قَلِيل (ما كان عدده صغيرا؛ متبوعًا بمِنْ: عدد صغير أو كمية صغيرة من الشيء) / مثال: و بعد قليل أتى.",
 "寥寥": "وَحِيد, مُوحِش / قَلِيل (ما كان عدده صغيرا؛ متبوعًا بمِنْ: عدد صغير أو كمية صغيرة من الشيء) / مثال: و بعد قليل أتى.",
 "寧": "بِالْأَحْرَى\nمثال: 今日はむしろ外出したくない。 — أفضل ألا أخرج اليوم.",
 "寧ろ": "بِالْأَحْرَى\nمثال: 今日はむしろ外出したくない。 — أفضل ألا أخرج اليوم.",
 "寧んぞ": "كَيْف, ازاي / كَيْفَ, ازاي / كَمْ, يَا لَ",
 "寧波": "نِينْغْبُو",
 "寧静": "هَادِئ / طَمْأَنَ",
 "審らか": "مُفَصَّل",
 "審判": "تقييم, حكم (فعل الحكم على أو تقييم شخص أو موقف أو حدث) / حكم, قرار قضائي ((قانون) القرار الصادر عن محكمة مختصة بشأن المسائل المعروضة عليها) / تقدير, حكم (القدرة على تقييم المواقف أو الظروف بذكاء واستخلاص استنتاجات سليمة) / تمييز, حصافة (القدرة العقلية على الفهم والتمييز بين العلاقات)\nمثال: انتقدوا حكمي على المتسابقين / تحكيم (فعل التحكيم (في الرياضة))\nمثال: كان التحكيم ممتازاً / حَكَم (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ)\nمثال: حكم علي بالموت.",
 "審判の日": "يوم الحساب, يوم الدين (اليوم في نهاية الزمان الذي سيقضي فيه الله بمصير جميع البشر وفقاً لأعمالهم)",
 "審判員": "حَكَم (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ)\nمثال: حكم علي بالموت.",
 "審判官": "قانون إداري (مجموعة القواعد واللوائح والأوامر والقرارات التي تنشئها الوكالات الإدارية الحكومية)",
 "審判役": "حكم (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ)\nمثال: حكم علي بالموت.",
 "審判者": "قَاضٍ, قَاضِيَة / حَكَمَ (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ)\nمثال: حكم علي بالموت.",
 "審問": "مُحَاكَمَة (قرار المحكمة على الجاني؛ القضاء الجنائي على متهم)\nمثال: تمت محاكمة زيري.",
 "審問官": "مُحَقِّق, مُحَقِّقَة (من يُجري تحقيق وتحرِّيات للكشف عن ملابسات قضيَّة غامضة؛ قَاضِي التَّحْقِيقِ الَّذِي يُحَقِّقُ مَعَ الْمُتَّهَمِ فِي قَضِيَّةٍ لِلْكَشْفِ عَنْ مَجْرَيَاتِهَا)\nمثال: تحدث ياني مع محقق.",
 "審尋": "سَمِيع (سَميع: (اسم)؛ سميع: (اسم)) / سَمْع (أَدْرَكَ الصوت بأذنه؛ أَصْغَى، أَنْصَتَ. (يتعدى باللام وإلى)) / جَلْسَة\nمثال: سمع سامي صريرا.",
 "審査": "إصدار الحكم, حكم (العملية المعرفية للوصول إلى قرار أو استخلاص استنتاجات)",
 "審査員": "فاحص, مفتش (محقّق يراقب ويدقق بعناية) / مختبِر, ممتحِن (شخص يدير اختبارًا لتحديد مؤهلاتك)\nمثال: بحث الفاحص عن أدلة",
 "審査官": "فاحص, مفتش (محقّق يراقب ويدقق بعناية) / مختبِر, ممتحِن (شخص يدير اختبارًا لتحديد مؤهلاتك)\nمثال: بحث الفاحص عن أدلة",
 "審査権": "مراجعة قضائية (مراجعة من قبل محكمة قانونية لإجراءات مسؤول حكومي أو هيئة أو شخص أو هيئة أخرى معينة قانونياً أو مراجعة محكمة استئناف لقرار محكمة ابتدائية)",
 "審理": "مُحَاكَمَة (قرار المحكمة على الجاني؛ القضاء الجنائي على متهم)\nمثال: تمت محاكمة زيري.",
 "審級": "عينة, مثال (عنصر من المعلومات يعتبر نموذجياً لفئة أو مجموعة) / حالة, مثال (حدوث لشيء ما)\nمثال: يقدم هذا المريض مثالاً نموذجياً للمتلازمة",
 "審美": "عِلْم الْجَمَال, فَلْسَفَةُ الْجَمَال (أَدْرَكَ حقيقة الشيء)",
 "審美学": "عِلْم الْجَمَال, فَلْسَفَةُ الْجَمَال (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "審美歯科": "طب الأسنان التجميلي (فرع طب الأسنان الذي يتعامل مع مظهر الأسنان)",
 "審美的": "جَمَالِيّ, فَنِّيّ (يتعلق بـ أو يتميز بتقدير الجمال أو الذوق الرفيع) / جَمَالِيّ, فَنِّيّ (مُمْتِعٌ مِنَ النَّاحِيَةِ الجَمَالِيَّة) / استيطيقي, جمالي (يتعلق بموضوع علم الجمال (الاستيطيقا)) / جمالية ((فلسفة) نظرية فلسفية حول ماهية الجميل)\nمثال: الملكات الجمالية",
 "審訊": "سَمِيع (سَميع: (اسم)؛ سميع: (اسم)) / سَمْع (أَدْرَكَ الصوت بأذنه؛ أَصْغَى، أَنْصَتَ. (يتعدى باللام وإلى)) / جَلْسَة\nمثال: سمع سامي صريرا.",
 "審議": "تداول, تريث (سمة التفكير المتأني في العمل أو القرار) / بطء, تأنٍ (معدل يظهر غياب العجلة أو التسرع) / تداول, روية (تفكير متأنٍ وحذر) / تعمد, حساب (تخطيط شيء ما بعناية وعن قصد)\nمثال: كان رجلاً ذا تداول قضائي",
 "審議会": "مَجْلِس / مَجْمَع (اسم مفعول من جَمَّعَ؛ كُلِّيَّة، جَامِعَة)\nمثال: كان سامي يعيش في مجمع مسور.",
 "審議官": "عُضْو مَجْلِس, مُسْتَشار (عضو في مجلس (بلدي أو إداري))",
 "審議未了": "غَيْر مَحْلول, مُعَلَّق ((في المُوسيقى) لَمْ يُحَلّ إلى تَوافُق؛ يَظَلّ مُتَنافِرًا) / غَيْر مَحْسُوم, مَفْتُوح (لم يُبَتّ فيه بعد؛ قابل لمزيد من التفكير والنقاش) / عالق, غير محلول (لم يتم حله)\nمثال: العديد من الجرائم تبقى غير محلولة",
 "寮": "نُزُل, أُوتِيل (ضد صَعَدَ، اِنْحَدَرَ أو اِنْخَفَضَ؛ القوم: حَلُّوا في مكان ما)\nمثال: نزل علينا الخوف. / مَكْتَب (الموضع الذي يُكتَب عليه. بعكس المَكْتَب الذي يكتب فيه؛ مِنْضَدَة مخصصة للكتابة، سواء كانت للمَكَاتِب أم لغيرها)\nمثال: عاد إلى المكتب. / فِيلَا, دَارَة / مَهَمَّة / شَيْخ, قَائِد",
 "寮母": "مشرفة سكن (امرأة تعمل كمرافقة في سكن للشباب)",
 "寮父": "مشرف سكن (رجل مسؤول عن الأطفال في مؤسسة)",
 "寮生": "طالب داخلي (تلميذ يعيش في المدرسة خلال الفصل الدراسي) / مقتحم السفينة, مهاجم (شخص يشق طريقه بالقوة للصعود على متن سفينة) / ساكن, نزيل (مستأجر في منزل شخص آخر)\nمثال: استعدوا لصد المقتحمين",
 "寮監": "مشرف سكن طلابي (معلم مسؤول عن سكن داخلي مدرسي)",
 "寮舎": "مَهْجَع",
 "寳": "كَنْز",
 "寵": "مَعْرُوف / أَنْعَمَ",
 "寵児": "حَبِيب, حَبِيبَة",
 "寵幸": "مَعْرُوف / أَنْعَمَ",
 "寵愛": "مَعْرُوف / أَنْعَمَ",
 "寵物": "حَيَوَان مَنْزَلِيّ (بمعنى أصبح له حياة؛ الحَيَاة. والحَيَوَان أبلغ من الحَيَاة؛ جنس الحَيّ الذي يأكل وينمو ويتحرك بالإرادة وبه حِسّ بخلاف ما به حياة فقط دون الحس مثل النَبَات. بعض العامة تقول حَيْوَان وهو غلط) / حَيَوَان أَلِيف (بمعنى أصبح له حياة؛ الحَيَاة. والحَيَوَان أبلغ من الحَيَاة؛ جنس الحَيّ الذي يأكل وينمو ويتحرك بالإرادة وبه حِسّ بخلاف ما به حياة فقط دون الحس مثل النَبَات. بعض العامة تقول حَيْوَان وهو غلط)\nمثال: هذا حيوان أليف.",
 "寶": "كَنْز",
 "寸": "شَمْس, شمس (الشَّمْسُ: النَّجْمُ الرئيسُ الذي تدور حوله الْأَرْض، وسائر كواكب المجموعة الشمسية؛ الشَّمس: اسم سورة من سور القرآن الكريم، وهي السُّورة رقم 91 في ترتيب المصحف، مكِّيَّة، عدد آياتها خمس عشرة آية) / مثال: نحب غروب الشمس. / طُول (قُدرة؛ غنى أو فضل)\nمثال: قاس طول السرير. / قِصَر (ضد الطول؛ غير تام، غير كامل)\nمثال: لقد قصر الخطاب.",
 "寸が詰まる": "قَلَّصَ (جعل الشيء أصغر حجمًا أو أقل مقدارًا؛ اختصر أو قلل من شيء معين) / تَقَلَّصَ, أَحْجَمَ",
 "寸分たがわず": "بِالضَّبْط, تَمَامًا / بِالْضَبْط",
 "寸分たがわぬ": "أُحَادِيّ البُوَيْضَة, مُتَطَابِق ((للتوائم) مشتق من بيضة واحدة أو بويضة) / قَابِلٌ لِلتَّطَابُقِ, مُتَمَاثِل (يَتَطَابَقُ تَمَامًا عِنْدَ وَضْعِهِ فَوْقَ الآخَرِ) / مُتَمَاثِل (ذو خصائص بقيم موحّدة على طول جميع المحاور) / لَا يُمَيَّز, مُتَطَابِق (متماثل تمامًا؛ لا يمكن إدراك أيّ فرق بينهما)\nمثال: التوائم المتطابقة هي أحادية البويضة",
 "寸分の狂いもない": "مَضْبُوط / دَقِيق (ضد الغَلِيْظ، الرَفِيْع الرَقِيْق؛ صغير الحجم جدا)\nمثال: ساعتي غير دقيقة.",
 "寸分違わず": "بِالضَّبْط, تَمَامًا / بِالْضَبْط",
 "寸分違わぬ": "أُحَادِيّ البُوَيْضَة, مُتَطَابِق ((للتوائم) مشتق من بيضة واحدة أو بويضة) / قَابِلٌ لِلتَّطَابُقِ, مُتَمَاثِل (يَتَطَابَقُ تَمَامًا عِنْدَ وَضْعِهِ فَوْقَ الآخَرِ) / مُتَمَاثِل (ذو خصائص بقيم موحّدة على طول جميع المحاور) / لَا يُمَيَّز, مُتَطَابِق (متماثل تمامًا؛ لا يمكن إدراك أيّ فرق بينهما)\nمثال: التوائم المتطابقة هي أحادية البويضة",
 "寸刻": "عَزْم / لَحْظَة, دَقِيقَة",
 "寸劇": "سكتش, مشهد هزلي (حلقة مسرحية قصيرة)",
 "寸善尺魔": "هُنَاكَ, يُوجَدُ",
 "寸尺": "طُول (قُدرة؛ غنى أو فضل)\nمثال: قاس طول السرير.",
 "寸断": "قَطَعَ (قطع الشيء : جزه؛ قطع الشيء : فصل بعضه عن بعضه الآخر)",
 "寸時": "عَزْم / لَحْظَة, دَقِيقَة",
 "寸書": "رسالة قصيرة, ملاحظة (رسالة شخصية قصيرة)\nمثال: اكتب لي رسالة قصيرة عندما تصل هناك / حَرْف, حرف (طَرَف وَجَانِب وَحَدّ؛ رَمْز مخطوط أو مطبوع يقوم مقام صوت أو كلمة أو عبارة أو معنى) / رِسَالَة, مَكْتُوب\nمثال: ألف هو الحرف الأول للألف باء.",
 "寸楮": "رسالة قصيرة, ملاحظة (رسالة شخصية قصيرة)\nمثال: اكتب لي رسالة قصيرة عندما تصل هناك / حَرْف, حرف (طَرَف وَجَانِب وَحَدّ؛ رَمْز مخطوط أو مطبوع يقوم مقام صوت أو كلمة أو عبارة أو معنى) / رِسَالَة, مَكْتُوب\nمثال: ألف هو الحرف الأول للألف باء.",
 "寸毫": "أَقَلَّ"
}
