 "宣明": "إِعْلَان, بَيَان",
 "宣材": "إِعْلَان, تَرْوِيج (رسالة تصدر لصالح منتج أو قضية أو فكرة أو شخص أو مؤسسة)\nمثال: تغليف الأفكار الجديدة",
 "宣言": "إِعْلَان, بَيَان",
 "宣言型": "خَبَرِيّ",
 "宣言完結文": "جملة تقريرية, جملة خبرية (جملة (في صيغة الإخبار) تقوم بإعلان أو تصريح)",
 "宣言書": "إِعْلَان, بَيَان",
 "宣言発表": "إِعْلَان, بَيَان",
 "宣言的": "خَبَرِيّ",
 "宣言部分": "خَبَرِيّ",
 "宣誓": "قَسَم, حَلْف (فَرَّقَ أو قَسَّمَ الشَّيءَ إلى أجزاء أو أجزاء مختلفة؛ أَحْلَفَ، أَي جَعَلَ…)\nمثال: أنا أزين القسم.",
 "宣誓人": "شَاهِد بِقَسَم, مُقِرّ بِالْقَسَم (شخص يقدم إفادة خطية مشفوعة بيمين)",
 "宣誓供述書": "إقرار مشفوع بيمين, شهادة خطية بقسم (إعلان مكتوب تحت القسم؛ بيان مكتوب يقسم على صحته أمام شخص مخول قانوناً بإدارة…)",
 "宣誓書": "قَسَم, حَلْف (فَرَّقَ أو قَسَّمَ الشَّيءَ إلى أجزاء أو أجزاء مختلفة؛ أَحْلَفَ، أَي جَعَلَ…)\nمثال: أنا أزين القسم.",
 "室": "فَضاء (فَضَاء)\nمثال: الفضاء مليئ بالغموض. / زَوْجَة, اِمْرَأَة / غِمْد, غِلَاف / دَفِيئَة زِرَاعِيّة, دَفِيئَة",
 "室井": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "室伏": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "室内": "دَاخِلِيّ (داخل الأبواب؛ في باطن المبنى)",
 "室内履き": "خُفّ, نَعْل (قدم البعير والنعام وهو بمثابة الحافر لغيرهما. الجمع أخفاف ويجوز قول خفاف…)\nمثال: لا تخف من الغريب، خف من الذي تعرفه.",
 "室内楽": "موسيقى الحجرة (مُوسِيقى، فنُّ تأليف الألحان وتوزيعها وإيقاعها والغناء والتطريب بضروب المعازف…)\nمثال: أتعلم الموسيقى.",
