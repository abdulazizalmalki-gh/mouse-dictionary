 "奴婢": "عَبْد (خلاف الحُرّ، المَمْلُوْك، من له مالك يملكه. الجمع عبيد وأعبد وعِبدان وعُبدان…)\nمثال: ماذا أنجز عبد العزيز بوتفليقة؟",
 "奴田原": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "奴等": "هُمَا\nمثال: هن يحببن الجاز.",
 "奴賀": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "奴輩": "رَجُل (العُضْو في جسد الإنسان يتكون من القَدَم والسَاق والفُخْذ. الجمع أرجُل، وقد تقول…)\nمثال: هذا الرجل تاجر.",
 "奴隷": "عَبْد (خلاف الحُرّ، المَمْلُوْك، من له مالك يملكه. الجمع عبيد وأعبد وعِبدان وعُبدان…)\nمثال: ماذا أنجز عبد العزيز بوتفليقة؟ / عُبُودِيَّة, رِقّ",
 "奴隷制": "عُبُودِيَّة, رِقّ",
 "奴隷制度": "عُبُودِيَّة, رِقّ",
 "奴隷商人": "نَخَّاس",
 "奴隷船": "سفينة عبيد (سفينة تستخدم لنقل العبيد من ديارهم إلى أماكن الاستعباد)",
 "奴隷貿易": "تجارة الرقيق (الاتجار في العبيد؛ خاصة الأفارقة السود الذين تم نقلهم إلى أمريكا من القرن 16…)",
 "奸": "شِرِير (الكَثير الشَرّ بمعنى اسم جامع للرذائل، قد يستعمل كاسم فاعل؛ ضد الخَيِّر؛ يستخدم…)",
 "奸悪": "شر, فجور (سلوك مرفوض أخلاقياً)\nمثال: فاجأتنا بشاعة لغته",
 "奸智": "مَاكِر",
 "奸物": "عصا الراعي, محجن (عصا طويلة ذات طرف على شكل خطاف)\nمثال: منعطف في الطريق",
 "奸知": "مَاكِر",
