 "大好き": "مُحِبّ, وَدُود",
 "大好きになる": "وَقَعَ فِي حُبّ (الشيء: سَقَطَ، انحدر من مكان عال؛ الأمر: حَدَثَ، وأكثر ما يقال للأمر العظيم)\nمثال: توم وقع و أصيب.",
 "大姉": "أخت (الأُخْت : المرأة التي تشترك معك في الأب أو الأم؛ الأُخْت  لقب يطلقه الشخص على امرأة لا يعرفها تأدبا وإن كانت غريبة عنه)\nمثال: ماري هي أخت توم",
 "大威張り": "تبجح, تفاخر (حالة من الحديث المتباهي)\nمثال: تبجحه أسوأ من قتاله",
 "大嫌い": "كَرِهَ, أَبْغَضَ (لم يُحِبّ، لم يَسْتطِع تحمُّلَ شَخْص أو أمرٍ، لم يُطِقْه، مقَته وكان عنده نُفورٌ منه؛ كره الشّخص فعل السّوء)\nمثال: هتلر كره اليهود.",
 "大学": "جَامِعَة (مؤنث الجَامِع، اسم فاعل من جَمَعَ، التي تَجْمَع؛ الغُلّ يجمع اليدين إِلى العُنُق)\nمثال: هكذا دخل الجامعة.",
 "大学学長": "رَئِيس, رَئِيسَة",
 "大学生": "طالب جامعة, طالب كلية (طالب مسجل في كلية أو جامعة)",
 "大学祭": "يوم العمل الخيري (يوم يقيم فيه طلاب الجامعات أنشطة خيرية)",
 "大学者": "عَالِم (الذي يعلم؛ متخصص في عِلْم ما وباحث فيه)\nمثال: هو عالم أحيائي.",
 "大学院": "كلية الدراسات العليا (مدرسة في جامعة تقدم دراسة تؤدي إلى درجات علمية تتجاوز درجة البكالوريوس)",
 "大学院入学試験": "كلية الدراسات العليا (مدرسة في جامعة تقدم دراسة تؤدي إلى درجات علمية تتجاوز درجة البكالوريوس)",
 "大学院入試": "كلية الدراسات العليا (مدرسة في جامعة تقدم دراسة تؤدي إلى درجات علمية تتجاوز درجة البكالوريوس)",
 "大学院生": "طالب دراسات عليا (طالب يواصل دراسته بعد التخرج)",
 "大學": "جَامِعَة (مؤنث الجَامِع، اسم فاعل من جَمَعَ، التي تَجْمَع؛ الغُلّ يجمع اليدين إِلى العُنُق)\nمثال: هكذا دخل الجامعة.",
 "大宇宙": "العَالَم, الكَوْن (كل شيء موجود في أي مكان)\nمثال: يدرسون تطور الكون",
 "大宗": "إِنْشاء, إِشَادَة (مصدر للفعل \"أَنْشَأَ\") / أَسَاس, قَاعِدَة (مبدأ عام تعتمد عليه طائفة من الظواهر أو القضايا؛ مُرتكز البناء وقاعدته) / مُؤَسَّسَة / أَسَاس (مبدأ عام تعتمد عليه طائفة من الظواهر أو القضايا؛ مُرتكز البناء وقاعدته)\nمثال: إنشاء موقع إلكتروني بدون أي تكلفة؟",
 "大官": "عَالِيّ الرُتْبَة",
 "大宝": "بُودِيسَاتْفَا",
 "大室": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "大宮": "ضَرِيح / إِمْبِرَاطُورَة الأُمّ",
 "大宮人": "رجل حاشية (مرافق في بلاط الحاكم)",
 "大家": "مؤجر, مالك العقار (مالك أرض يقوم بتأجيرها للآخرين) / سَيِّد / أُصُولِيّ, أُصُولِيَّة / أحسن, أتقن ((أَحْسَنَ): فعل مَا هُوَ حسن؛ (أَحْسَنَ) الشَّيْء: أَجَاد صنعه وأتقنه)\nمثال: يبدو زيري أحسن. / قَصْر (ضد الطول؛ غير تام، غير كامل)\nمثال: لقد قصر الخطاب.",
 "大家さん": "مؤجر, مالك العقار (مالك أرض يقوم بتأجيرها للآخرين)",
 "大家族": "أسرة ممتدة (أسرة تتكون من الأسرة النووية وأقاربهم بالدم)",
 "大家族主義": "أسرة ممتدة (أسرة تتكون من الأسرة النووية وأقاربهم بالدم)",
 "大富豪": "مِلْيَارْدِير / لَعْبَة وَرَق (اللَعْبَة البَرْبَرية دواء عشبيّ)\nمثال: عنده لعبة يويو.",
 "大寒波": "موجة برد (فترة من الطقس البارد)",
 "大審院": "مَحْكَمَة عُلْيَا (مقام الحاكم. وغلبت على مقام الحاكم الشرعي أي القاضي)\nمثال: عاد إلى المحكمة.",
 "大寿林": "درسة القصب (طائر درسة أوروبي يسكن المناطق المستنقعية)",
 "大将": "عَامّ / عُمُومِيّ, عَامّ / جِنِرال, فريق أوّل / رَئِيس, رَئِيسَة / رَئِيس / اِتَّجَهَ / صَدِيق (هو الصَاحِب والخّل الذي بينك وبينه صَدَاقَة)\nمثال: ليس لديه صديقة.",
 "大将軍": "رَئِيس أَرْكَان",
 "大尉": "طَيَّار, قُبْطَان (اسم فاعل للمبالغة على وزن فَعَّال؛ الذي يقود الطَائِرَة سواء كانت مهنته أم لا) / نَقِيب, قُبْطَان / قَائِد, كَبْتِن\nمثال: لم توجه أبدا تهمة القيادة غير المسؤولة للطيار.",
 "大小": "مَقَاس, قِيَاس",
 "大尽": "ثري, غني (شخص يمتلك ثروة مادية كبيرة) / باذخ, منفق كبير (شخص ينفق ببذخ وتفاخر على الترفيه)\nمثال: آخر المنفقين الكبار",
 "大尽遊び": "مصروف الجيب (نقد للإنفاق اليومي على المصاريف العرضية)",
 "大尾": "نِهَايَة, غَايَة / غَايَة / اِنْتَهَى, أَنْهَى (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات)\nمثال: انتهى أمر زيري.",
 "大局的": "رَحْب الصَّدْر, مُتَسَامِح (يُظْهِر أَوْ يَتَّسِم بِسَعَة الأُفُق والتَّسَامُح) / صَرِيح, فَجّ (يفتقر إلى الدقّة والخفاء؛ واضح وسافر) / شَامِل, وَاسِعُ النِّطَاق (واسع في نطاقه أو محتواه؛ يغطّي مجالات عديدة) / عَرِيض, غَيْر مُفَصَّل (غير مفصل أو دقيق؛ يتناول الخطوط العامة فقط)",
 "大屋": "مؤجر, مالك العقار (مالك أرض يقوم بتأجيرها للآخرين)",
 "大屋さん": "مؤجر, مالك العقار (مالك أرض يقوم بتأجيرها للآخرين)",
 "大屋根": "سطح المنزل (سقف البيت)\nمثال: أعلنها من فوق أسطح المنازل",
 "大層": "جِدًّا (كلمة \"جدا\" لها معانٍ متعددة؛ يرتبط المعنى بالعطاء والكرم، سواء بالمنح أو طلبه)\nمثال: إنها غالية جدا! / الْأُقْصَى, الْأَبْعَد / شَدِيد / غَيْر اِعْتِيَادِيّ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به) / خَطِير / مُتَطَرِّف / أَخِير\nمثال: أنا غير متفاجئ. / بَاهِر, رَائِع (يتمتع بجمال وروعة عظيمين) / بَهِيّ, رَائِع (يتّسم بالعظمة والفخامة) / رَفِيع, مُتَأَلِّق (جيد جدًا؛ من أرقى مستويات الجودة) / مُضَخَّم, مُكَبَّر (مُكبَّر إلى درجة غير طبيعية) / مُبَالَغٌ فِيه (مُصَوَّرٌ عَلَى أَنَّهُ أَكْبَرُ مِمَّا هُوَ فِي الحَقِيقَة)",
 "大山": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "大山木": "ماغنوليا جنوبية, ماغنوليا كبيرة الأزهار (شجرة دائمة الخضرة في جنوب الولايات المتحدة ذات أوراق لامعة صلبة كبيرة وزهور بيضاء ضخمة حلوة الرائحة)",
 "大山猫": "وَشَق",
 "大岡裁き": "حكم, قرار قضائي ((قانون) القرار الصادر عن محكمة مختصة بشأن المسائل المعروضة عليها)",
 "大島": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "大崎": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "大嶋": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "大嶌": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "大川": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "大州": "قَارَّة",
 "大工": "نَجَّار (صاحب مهنة النِجَارَة أو العامل فيها)",
 "大工仕事": "نِجَارة (مؤنث نَجَّار، التي تعمل بالنجارة)",
 "大師範": "سَيِّد / أُصُولِيّ, أُصُولِيَّة / أحسن, أتقن ((أَحْسَنَ): فعل مَا هُوَ حسن؛ (أَحْسَنَ) الشَّيْء: أَجَاد صنعه وأتقنه)\nمثال: يبدو زيري أحسن.",
 "大幅": "كَبِير, كبير (ضد الصغير؛ العظيم الحَجْم؛ ضد الصغير؛ المتقدم في السِنّ)\nمثال: ذاك البيت كبير.",
 "大幅物": "قماش عريض (قماش حريري أو صناعي منسوج بإحكام مع تضليع عرضي ضيق) / جوخ, قماش عريض (قماش صوفي كثيف النسيج ذو مظهر لامع)",
 "大平": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "大年": "31 ديسمبر, ليلة رأس السنة (اليوم الأخير من السنة) / اَلْمُشْتَرِي (أحد كَوَاكِب المجموعة الشمسية السَّيَّارَة، وهو أكبرها) / يُوبِيتَر\nمثال: كوكب المشتري متكون من الغاز.",
 "大広間": "القاعة الكبرى (القاعة الرئيسية في قلعة أو قصر؛ يمكن استخدامها لتناول الطعام أو الترفيه)",
 "大序": "برولوج, فاتحة مسرحية (مقدمة لمسرحية)",
 "大店法": "وَاسِع النِّطَاق (كبير بشكل غير معتاد في النطاق) / كَبِير المِقْيَاس (مبنيّ أو مرسوم بمقياس كبير)",
 "大度": "شهامَة",
 "大庭": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "大建築": "بِنَاء, مَبْنَى (ضد هَدْم. ؛ المَبْنَى أو البِنَاية) / مَدْرَسَة (الموضع الذي تُدَرَّس فيه العلوم؛ البناء فيه عدة غرف تُدَرَّسُ فيها العلوم وتمنح شهادة رسمية بعد إكمال الدروس)\nمثال: أنا وجدت البناء.",
 "大廻り": "تحويلة, طريق التفافي (طريق غير مباشر (خاصة الذي يستخدم مؤقتاً أثناء إغلاق الطريق الرئيسي))",
 "大弓": "قَوْس, قوس / اَنْشُوطَة, فيونكة / اِنْحَنَى / اِنْحَنَى لِلتَّحِيَّة, اِنْحَنَى / اِنْحِنَاءَة, اِلْتِوَاءَة / قَيْدُوم",
 "大引き": "نجاح مفاجئ (عمل يحقق نجاحاً غير متوقع) / قوبيون نائم (سمكة استوائية تشبه القوبيون وتستقر بهدوء في القاع في المياه الضحلة) / أثاث للنوم (قطعة أثاث يمكن فتحها لتصبح سريراً) / بيجامة أطفال (بيجامة بأقدام؛ يرتديها الأطفال)\nمثال: كان ذلك الفيلم هو النجاح المفاجئ لهذا الصيف",
 "大引け": "إتمام, إكمال (إجراء ختامي أو نهائي) / إغلاق, إقفال (إنهاء العمليات) / اقتراب, تضييق المسافة (الاقتراب من وجهة معينة؛ تضييق الفجوة) / إغلاق (عملية إغلاق شيء ما)\nمثال: أسفوا لإغلاق مركز الرعاية النهارية / سعر الإغلاق ((سوق الأسهم) سعر آخر معاملة تمت خلال جلسة تداول اليوم)",
 "大強風": "عاصفة قوية (رياح تتحرك بسرعة 47-54 عقدة؛ 9 على مقياس بوفورت)",
 "大当たり": "بلوك باستر, عمل ضخم النجاح (نجاح غير عادي مع شعبية واسعة ومبيعات ضخمة (خاصة لفيلم أو مسرحية أو تسجيل أو رواية)) / الجَائِزَةُ الكُبْرَى",
 "大当り": "بلوك باستر, عمل ضخم النجاح (نجاح غير عادي مع شعبية واسعة ومبيعات ضخمة (خاصة لفيلم أو مسرحية أو تسجيل أو رواية)) / الجَائِزَةُ الكُبْرَى",
 "大形": "كَبِير, وَاسِع (ضد الصغير؛ العظيم الحَجْم؛ ضد الصغير؛ المتقدم في السِنّ)\nمثال: ذاك البيت كبير.",
 "大後頭孔": "الثقبة العظمى (الفتحة الكبيرة في قاعدة الجمجمة التي يمر من خلالها الحبل الشوكي)",
 "大得意": "مُمْتَاز, فَاخِر",
 "大御": "أَغُسْطُس, آب (الشهر الثامن في السنة الروميّة)\nمثال: غادر فاضل البلد في الثالث و العشرين من أغسطس.",
 "大御宝": "نَاس, خَلْق (اسم للجمع من بني آدم واحده إِنْسَان أو إِنْس) / خَلْق, شَعْب (أَنْشَأَ، أَوْجَدَ) / أَهْل (أَهِلَ به يَأْهَلُ أَهَلاً: أنِس، فهو أَهِلٌ) / شَعْب (ما فوق القَبِيلَة ودون الأُمَّة؛ وهو أول طبقات الأنساب إلا أن البعض يضع فوقه الجَذْم والجُمْهُور؛ الناس الذين يسكنون دولة ما وإن لم يكن يربط بينهم نسب. . والعامة قد تقول شَعَب)\nمثال: ضحك الناس عليه.",
 "大御所": "إمبراطور مالي, بارون (رجل أعمال ثري جداً أو قوي النفوذ) / مغولي (عضو في السلالة المسلمة التي حكمت الهند حتى عام 1857) / حدبة تزلج, موجول (نتوء أو حدبة في منحدر التزلج)\nمثال: بارون نفط",
 "大御神": "رَبّ (رَبَّ الولدَ يَرُبُّ رَبًّا: ولِيَه وتعهده بما يغذيه وينميه ويؤدّبه؛ الفاعل: رَابٌّ، والمفعول: مَرْبوبٌ، وربيبٌ)\nمثال: اعتني بي يا رب.",
 "大循環": "دَوْرَة دَمَوِيَّة كُبْرَى (في غرب العراق على نهر الفرات قرب الحدود السورية؛ حَيّ في جنوب بغداد تقع فيه محطة تكرير للنفط تسمّى بإسمه)\nمثال: خضع زيد لدورة مكثفة",
 "大徳": "كَاهِن, قِسِّيس / ثري, غني (شخص يمتلك ثروة مادية كبيرة)",
 "大志": "مَطْمَح",
 "大急ぎ": "اِنْدَفَعَ, أَسْرَعَ / سَمَار",
 "大恐慌": "الْكَسَاد الْعَظِيم",
 "大悟": "تَنْوِير",
 "大患": "مَخَاض",
 "大悪": "بِشَاعَة, قَسْوَة",
 "大悪人": "وَحْش (حَيْوَان غير مستأنس يعيش بعيدا عن الناس، وهي أصل الكلمة؛ حيوان مُفْتَرِس)\nمثال: ضرب زيري الوحش.",
 "大惑星": "كَوْكَب ((علم الفلك) أي من الأجرام السماوية الكبيرة التسعة في النظام الشمسي التي تدور حول الشمس وتلمع بضوء منعكس) / عِمْلَاق غَازِيّ, كَوْكَب غَازِيّ (أي من الكواكب الأربعة الخارجية في النظام الشمسي؛ أكبر بكثير من الأرض وغازي الطبيعة (مثل المشتري))",
 "大惚け": "مُغَفَّل, أَحْمَق",
 "大惨事": "كَارِثَة, فَاجِعَة / نَكْبَة, فَاجِعَة",
 "大意": "مُلَخَّص",
 "大慶": "دَاتْشِينْغ",
 "大憲章": "مَاجْنَا كَارْتَا",
 "大成": "إتمام, إكمال (إجراء ختامي أو نهائي) / تمريرة ناجحة ((كرة القدم الأمريكية) تمريرة أمامية ناجحة في كرة القدم)",
 "大戦": "اَلْحَرْب الْعُظْمَى / حَرْب عَالَمِيَّة, الْحَرْب الْعَالَمِيَّة (حَرَبَ (حربه) بالحربة حربا: طعنه بها؛ حَرَبَ (ه) حربا: سلبه جميع ما يملك)\nمثال: بوتين مجرم حرب.",
 "大戦争": "اَلْحَرْب الْعُظْمَى",
 "大戸": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "大所": "شخصية مؤثرة, شخصية هامة (شخص تؤثر أفعاله وآراؤه بقوة على مسار الأحداث)",
 "大手筋": "وَاسِع النِّطَاق (كبير بشكل غير معتاد في النطاق) / كَبِير المِقْيَاس (مبنيّ أو مرسوم بمقياس كبير)",
 "大手術": "جراحة كبرى (أي إجراء جراحي يتضمن التخدير أو المساعدة التنفسية)",
 "大抵": "إلى حد كبير, بشكل رئيسي (في جزء كبير؛ بشكل رئيسي أو أساسي) / بشكل عام, في الغالب (عادة؛ كقاعدة)\nمثال: هذه الحسابات غير نشطة إلى حد كبير / مِن اَلْمُحْتَمَل, رُبَّمَا (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة! / أَكْثَر, أَغْلَب / جِدًّا (كلمة \"جدا\" لها معانٍ متعددة؛ يرتبط المعنى بالعطاء والكرم، سواء بالمنح أو طلبه)\nمثال: إنها غالية جدا! / عَادِيّ, مَأْلُوف",
 "大括弧": "قوس مربع (إحدى علامتي الترقيم  المستخدمة لتطويق مادة نصية)",
 "大挙": "بالكامل (في إشارة إلى كمية)\nمثال: دُفع المبلغ بالكامل / وَاسِع النِّطَاق (كبير بشكل غير معتاد في النطاق) / كَبِير المِقْيَاس (مبنيّ أو مرسوم بمقياس كبير)",
 "大捕り物": "تجميع المشتبه بهم, حملة اعتقالات (التجميع المنهجي للمشتبه بهم من قبل الشرطة) / تجميع الماشية (نشاط جمع الماشية معاً لعدها أو وسمها أو بيعها) / جولة ملخصة, حصاد (قائمة ملخصة؛ كما في 'حصاد الأخبار')\nمثال: حملة اعتقالات جماعية للمشتبه بهم",
 "大捕物": "تجميع المشتبه بهم, حملة اعتقالات (التجميع المنهجي للمشتبه بهم من قبل الشرطة) / تجميع الماشية (نشاط جمع الماشية معاً لعدها أو وسمها أو بيعها) / جولة ملخصة, حصاد (قائمة ملخصة؛ كما في 'حصاد الأخبار')\nمثال: حملة اعتقالات جماعية للمشتبه بهم",
 "大掛かり": "وَاسِع النِّطَاق (كبير بشكل غير معتاد في النطاق) / كَبِير المِقْيَاس (مبنيّ أو مرسوم بمقياس كبير)",
 "大掴み": "خَشِن (صار خشناً أو غير ناعم؛ أصبح صلباً أو غليظ الملمس)\nمثال: زيري خشن الخلق.",
 "大揺れ": "اِضْطِرَاب",
 "大教室": "صَالَة مُحَاضَرَات (مكان فسيح في وسط المسكن يُوصِلُ إلى سائر الحجرات، الرُدْهَة؛ غُرْفَةُ المَعِيْشَة سواء كانت توصل إلى سائر الحجرات أم لا وسواء كانت فسيحة أم لا)\nمثال: حجزت الصالة يوم الخميس.",
 "大数の法則": "قانون الأعداد الكبيرة ((إحصاء) قانون ينص على أن عددًا كبيرًا من العناصر المأخوذة عشوائيًا من مجتمع إحصائي سيكون له (في المتوسط) إحصائيات المجتمع)",
 "大敵": "عَدُوّ لَدُود (ركض أو جري)\nمثال: عدو عدوي صديقي.",
 "大文字": "حَرْف كَبِير (طَرَف وَجَانِب وَحَدّ؛ رَمْز مخطوط أو مطبوع يقوم مقام صوت أو كلمة أو عبارة أو معنى)\nمثال: ألف هو الحرف الأول للألف باء.",
 "大方": "غَالِبِيَّة, أَغْلَبِيّة / عَامَّة اَلنَّاس / إلى حد كبير, بشكل رئيسي (في جزء كبير؛ بشكل رئيسي أو أساسي) / بشكل عام, في الغالب (عادة؛ كقاعدة)\nمثال: هذه الحسابات غير نشطة إلى حد كبير / مِن اَلْمُحْتَمَل, رُبَّمَا (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "大旆": "رَايَة, عَلَم / لَافِتَة / مُلْصَق / إِعْلَان / مُمْتَاز",
 "大日本": "الْيَابَان (دولة جزرية في شرق قارة آسيا، عاصمتها طوكيو)\nمثال: أنا من اليابان.",
 "大日本豊秋津洲": "هُونْشُو / الْيَابَان (دولة جزرية في شرق قارة آسيا، عاصمتها طوكيو)\nمثال: أنا من اليابان.",
 "大旦那": "حَم (التنور أو الفرن أو الماء: سجر وسخن وأصبح حارّا؛ الأمر: قُضِيَ وتقدر من الله)\nمثال: أفضل لحم البقر. / رَبّ عَمَل, رَبَّة عَمَل (رَبَّ الولدَ يَرُبُّ رَبًّا: ولِيَه وتعهده بما يغذيه وينميه ويؤدّبه؛ الفاعل: رَابٌّ، والمفعول: مَرْبوبٌ، وربيبٌ)\nمثال: اعتني بي يا رب.",
 "大時代": "عَفَا عَلَيْه الزَّمَن, قَدِيم الطِّرَاز (خَارِج المُوضَة وَلَمْ يَعُدْ رَائِجًا)",
 "大晦": "31 ديسمبر, ليلة رأس السنة (اليوم الأخير من السنة)",
 "大晦日": "31 ديسمبر, ليلة رأس السنة (اليوم الأخير من السنة)",
 "大智": "حَكِيم, فَطِن (الذي يتصرف دوما بحكمة وتكون الحكمة من صفاته؛ في : هو الطَبِيب) / مَرْيَمِيَّة / شَاقِيَة\nمثال: هذه كلمات حكيمة.",
 "大暴れ": "عربدة, هيجان (سلوك عنيف غاضب ومدمر)",
 "大暴落": "غوص, هبوط حاد (هبوط حاد بمقدمة الطائرة للأسفل) / سقوط مدو, هبوط حاد (انخفاض حاد ومفاجئ أو تدهور سريع)\nمثال: شهد السهم هبوطاً حاداً",
 "大月": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "大有り": "سَخِيّ, غَزِير (يُوفِّر إمدادًا وافرًا وغزيرًا) / كَثِير, مُتَوَافِر (موجود بأعداد أو كمّيّات كبيرة) / غَزِير الإِنْتَاج, وَافِر (يُنْتِجُ بِوَفْرَة وَغَزَارَة)",
 "大望": "أَمَل ((أَمَّلَه): أَمَلَهُ يُقَال: فلَان بَحر المؤمل) / رَشْف (رشف الماء أو نحوه: مصه بشفتيه؛ رشف الإناء: شرب ما فيه ولم يترك فيه شيئا) / زَفْر (زفَر الشَّخصُ : أخرج نفَسه من رئتيه بعد مدِّه إيّاه؛ أظهر تعبيرًا عن الحزن أو الألم من خلال تنهد أو صوت عميق)\nمثال: أشعر بخيبة أمل.",
 "大木": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "大木戸": "حَاجِز, نُقْطَة تَفْتِيش",
 "大本": "إِنْشاء, إِشَادَة (مصدر للفعل \"أَنْشَأَ\") / أَسَاس, قَاعِدَة (مبدأ عام تعتمد عليه طائفة من الظواهر أو القضايا؛ مُرتكز البناء وقاعدته) / مُؤَسَّسَة / أَسَاس (مبدأ عام تعتمد عليه طائفة من الظواهر أو القضايا؛ مُرتكز البناء وقاعدته)\nمثال: إنشاء موقع إلكتروني بدون أي تكلفة؟ / جَذْر, جدر (جِذْرُ ٱلشَّيْءِ هُوَ: أَصْلُهُ؛ في : جذر العدد النوني هو عدد ما إذا رفعناه لقوة ما أعطانا العدد الأصلي) / جَذْر (جِذْرُ ٱلشَّيْءِ هُوَ: أَصْلُهُ؛ في : جذر العدد النوني هو عدد ما إذا رفعناه لقوة ما أعطانا العدد الأصلي) / أَصْل (جعله أصيلًا أو ثابت الجذور؛ أي عَمَّق وأحكم أصوله؛ نسب شيئًا إلى أصله أو وضّح جذوره)\nمثال: أحسب جذر خمسة بالآلة الحاسبة.",
 "大杉": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "大村": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "大林": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "大枝": "غُصْن",
 "大枠": "عُمُومًا / بِوَجْهٍ عَامّ",
 "大柄": "مُتَكَبِّر, مَغْرُور (شعب مُتكبِّر : مُتعجرف ، شامخ الرأس؛ مُتكَبِّر : فاعل من تَكَبَّر)\nمثال: هو متكبر للغاية.",
 "大根": "فِجْل (فَجَّلَ الشيءَ تعني عرَّضَهُ، أي جعله مكشوفًا أو ظاهرًا. يمكن استخدام الفعل للإشارة إلى تعريض شيء ما للآخرين أو جعله واضحًا؛ فجل - يفجل، فجلا، الكلمة مرتبطة بتغيير شكل الشيء ليصبح أوسع أو أكثر استرخاءً وغلظة) / دَايْكُون / ممثل مبالغ, ممثل متصنع (ممثل غير ماهر يبالغ في الأداء التمثيلي) / جَذْر, جدر (جِذْرُ ٱلشَّيْءِ هُوَ: أَصْلُهُ؛ في : جذر العدد النوني هو عدد ما إذا رفعناه لقوة ما أعطانا العدد الأصلي) / جَذْر (جِذْرُ ٱلشَّيْءِ هُوَ: أَصْلُهُ؛ في : جذر العدد النوني هو عدد ما إذا رفعناه لقوة ما أعطانا العدد الأصلي) / أَصْل (جعله أصيلًا أو ثابت الجذور؛ أي عَمَّق وأحكم أصوله؛ نسب شيئًا إلى أصله أو وضّح جذوره)\nمثال: أحسب جذر خمسة بالآلة الحاسبة.",
 "大根役者": "ممثل مبالغ, ممثل متصنع (ممثل غير ماهر يبالغ في الأداء التمثيلي)",
 "大棗": "عُنَّاب",
 "大棟": "سلسلة جبال",
 "大森": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "大業物": "بشكل ممتاز, على ما يرام (بشكل جيد جداً) / فَائِق, مُمْتَاز (من أعلى مستويات الجودة)\nمثال: إنها لا تشعر أنها على ما يرام اليوم",
 "大概": "عُمُومًا / بِوَجْهٍ عَامّ / أَكْثَر, أَغْلَب / جِدًّا (كلمة \"جدا\" لها معانٍ متعددة؛ يرتبط المعنى بالعطاء والكرم، سواء بالمنح أو طلبه)\nمثال: إنها غالية جدا! / لُبّ / مِن اَلْمُحْتَمَل, رُبَّمَا (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "大様": "خَيِّر, طَيِّب القَلْب (يُظهر التعاطف والتفهّم والسخاء أو مدفوع بها) / هادئ, ساكن",
 "大槻": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "大権": "حَكَم, فيصل (شخص لديه السلطة لتسوية الأمور حسب إرادته)\nمثال: كانت هي الحكم النهائي في جميع مسائل الموضة",
 "大樹": "سيكويا عملاقة (شجرة دائمة الخضرة شاهقة الارتفاع في الطرف الجنوبي من التلال الغربية لسييرا نيفادا في كاليفورنيا؛ أكبر كائن حي)",
 "大樺斑": "فراشة الصقلاب, فراشة الملك (فراشة أمريكية مهاجرة كبيرة لها أجنحة برتقالية عميقة بعلامات سوداء وبيضاء؛ تتغذى اليرقات على الصقلاب)",
 "大樽": "برميل كبير (برميل كبير خاصة واحد بسعة 63 جالون) / هوغسهيد (وحدة سعة بريطانية للمشروبات الكحولية)",
 "大橋": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "大檀那": "حَم (التنور أو الفرن أو الماء: سجر وسخن وأصبح حارّا؛ الأمر: قُضِيَ وتقدر من الله)\nمثال: أفضل لحم البقر. / رَبّ عَمَل, رَبَّة عَمَل (رَبَّ الولدَ يَرُبُّ رَبًّا: ولِيَه وتعهده بما يغذيه وينميه ويؤدّبه؛ الفاعل: رَابٌّ، والمفعول: مَرْبوبٌ، وربيبٌ)\nمثال: اعتني بي يا رب.",
 "大欲": "طَمَع, شُحُّ",
 "大正エビ": "أبيض الزنك, أبيض صيني (خضاب أبيض يستخدم في دهانات المنازل؛ يتكون من أكسيد الزنك)",
 "大正海老": "أبيض الزنك, أبيض صيني (خضاب أبيض يستخدم في دهانات المنازل؛ يتكون من أكسيد الزنك)",
 "大歳": "اَلْمُشْتَرِي (أحد كَوَاكِب المجموعة الشمسية السَّيَّارَة، وهو أكبرها) / يُوبِيتَر\nمثال: كوكب المشتري متكون من الغاز. / 31 ديسمبر, ليلة رأس السنة (اليوم الأخير من السنة) / اَلْمُشْتَرِي (أحد كَوَاكِب المجموعة الشمسية السَّيَّارَة، وهو أكبرها) / يُوبِيتَر\nمثال: كوكب المشتري متكون من الغاز.",
 "大殿": "قِسِّيس, دَاعِيَة (الذي يُقَسِّس الإبل أو الماشية أو الغنم، أي يحسن رعايتها، الراعي؛ عند المَسِيْحِيِّيْن هو لقب فوق الشَمَّاس ودون الأُسْقُف وهو القَسّ) / وَزِير, وَزِيرَة",
 "大殿筋": "ألوية كبرى (أقصى العضلات الألوية الثلاث)",
 "大母": "جَدَّة (هي أم الأب أو أم الأم؛ مدينة في السُعُودِيَّة قرب مَكَّة، قيل أنها سميت هكذا لأن حواء دفنت فيها والله أعلم)\nمثال: كان لزيري جد و جدة.",
 "大毛蓼": "بطباط شرقي, ريشة الأمير (نبات حولي بأوراق بيضاوية عريضة وسنابل متدلية رفيعة من الزهور القرمزية؛ جنوب شرق آسيا وأستراليا؛ توطن في أمريكا الشمالية)",
 "大気": "جَو, غِلَاف جَوِّيّ / جَو / سَمْح, كَرِيم النَّفْس (سخي ومتفهم ومتسامح) / شَهْم, كَرِيم النَّفْس (نبيل وكريم في الروح والطبع)",
 "大気圏": "جَو, غِلَاف جَوِّيّ / جَو",
 "大気圏外": "فَضَاء خَارِجِيّ (فَضَاء)\nمثال: الفضاء مليئ بالغموض.",
 "大気圧": "ضغط جوي",
 "大気汚染": "تَلَوُّث الْهَوَاء, تَلَوُّث هَوَائِيّ (تَلَطُّخ، تَكَدُّر، قذارة ودنس يصيبان الجو أو الماء أو البيئة ويؤديان إلى تسمم أو أمراض؛ تَشَوُّه)\nمثال: التلوث يضر كوكبنا.",
 "大気汚染防止法": "تَلَوُّث الْهَوَاء, تَلَوُّث هَوَائِيّ (تَلَطُّخ، تَكَدُّر، قذارة ودنس يصيبان الجو أو الماء أو البيئة ويؤديان إلى تسمم أو أمراض؛ تَشَوُّه)\nمثال: التلوث يضر كوكبنا.",
 "大水": "طُوفَان, فَيَضَان (عاصفة)",
 "大水青": "عثة الإمبراطور (عثة كبيرة من الغابات المعتدلة في أوراسيا ذات أجنحة شفافة كثيفة القشور)",
 "大汗": "الكثير, قدراً كبيراً (إلى درجة أو مدى كبير جداً) / غالباً, كثيراً (بشكل متكرر أو بكميات كبيرة)\nمثال: أشعر بتحسن كبير",
 "大江": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "大沢": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "大河": "مَلْحَمَة / مَلْحَمِيّ (متعلق بالكتب، أو الأفلام، أو الأشعار، أو بغيرها من الوسائط التي تصور دراما إنسانية على نطاق واسع، وتُعرف باسم الملحمات أو الملحميات)",
 "大河内": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "大沼": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "大法": "دستور, قانون أساسي (قانون يحدد المبادئ السياسية الأساسية للحكومة)",
 "大法官": "السيد المستشار, اللورد المستشار (أعلى ضابط للتاج يرأس القضاء ويترأس مجلس اللوردات)",
 "大法螺": "شيء ضخم, شيء هائل (شيء كبير أو مثير للإعجاب بشكل خاص من نوعه) / فرية, كذبة كبيرة (كذبة فادحة؛ كذبة صارخة)",
 "大法螺吹き": "متباهٍ, متفاخر (شخص كثير التفاخر والحديث عن نفسه)",
 "大法院": "مَحْكَمَة عُلْيَا (مقام الحاكم. وغلبت على مقام الحاكم الشرعي أي القاضي)\nمثال: عاد إلى المحكمة.",
 "大波": "تلاطم, موجة عارمة (موجة بحرية كبيرة)",
 "大泣き": "صراخ, عويل (صرخات عالية أثناء البكاء) / عَوِيل, نَائِح (يعبّر بصوته عن الحزن والأسى أو يشبه هذا التعبير)",
 "大注目": "الكثير, قدراً كبيراً (إلى درجة أو مدى كبير جداً) / غالباً, كثيراً (بشكل متكرر أو بكميات كبيرة)\nمثال: أشعر بتحسن كبير",
 "大洋": "مُحِيط, قَامُوس (في : هو الخط المستدير الذي يُحيط بالشكل الهندسي؛ في : البَحْر المُحِيْط هو البحر الكبير الذي يحيط بالقارات. الاستخدام الحديث يحذف كلمة بَحْر؛ القَامُوْس)\nمثال: أسبح في المحيط.",
 "大洋州": "أُوقِيَانُوسِيَا",
 "大津": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "大洪水": "طُوفَان (عاصفة)",
 "大洲": "قَارَّة",
 "大流行": "ذراع التطويل, عوارضة (أي من الصواري أو الأعمدة الأفقية المتنوعة المستخدمة لتمديد أسفل الشراع أو لمناولة البضائع أو في الإرساء) / بوم, ذراع الميكروفون (عمود يحمل ميكروفوناً علوياً مسلطاً فوق موقع تصوير فيلم أو تلفزيون) / دوي, رعد (ضجيج عميق طويل وعالٍ) / رزق ساقه الله, رواج (حدث مفاجئ يجلب الحظ السعيد (مثل فرصة مفاجئة لكسب المال))\nمثال: خلق الطلب على الاختبار طفرة لتلك المختبرات غير الخاضعة للتنظيم",
 "大流行り": "ذراع التطويل, عوارضة (أي من الصواري أو الأعمدة الأفقية المتنوعة المستخدمة لتمديد أسفل الشراع أو لمناولة البضائع أو في الإرساء) / بوم, ذراع الميكروفون (عمود يحمل ميكروفوناً علوياً مسلطاً فوق موقع تصوير فيلم أو تلفزيون) / دوي, رعد (ضجيج عميق طويل وعالٍ) / رزق ساقه الله, رواج (حدث مفاجئ يجلب الحظ السعيد (مثل فرصة مفاجئة لكسب المال))\nمثال: خلق الطلب على الاختبار طفرة لتلك المختبرات غير الخاضعة للتنظيم",
 "大浚": "وَاسِع النِّطَاق (كبير بشكل غير معتاد في النطاق) / كَبِير المِقْيَاس (مبنيّ أو مرسوم بمقياس كبير)",
 "大浚い": "وَاسِع النِّطَاق (كبير بشكل غير معتاد في النطاق) / كَبِير المِقْيَاس (مبنيّ أو مرسوم بمقياس كبير)",
 "大浦": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "大海": "مُحِيط, قَامُوس (في : هو الخط المستدير الذي يُحيط بالشكل الهندسي؛ في : البَحْر المُحِيْط هو البحر الكبير الذي يحيط بالقارات. الاستخدام الحديث يحذف كلمة بَحْر؛ القَامُوْس)\nمثال: أسبح في المحيط.",
 "大海一滴": "غيض من فيض, نقطة في بحر (جهد أو فعل له تأثير ضئيل جداً بشكل عام، خاصة بالمقارنة مع مشكلة ضخمة)\nمثال: إن التبرع بمبلغ 100 دولار من فرد هو أمر كريم، لكنه نقطة في بحر مقارنة بهدف جمع التبرعات البالغ 500,000 دولار",
 "大海原": "مُحِيط, قَامُوس (في : هو الخط المستدير الذي يُحيط بالشكل الهندسي؛ في : البَحْر المُحِيْط هو البحر الكبير الذي يحيط بالقارات. الاستخدام الحديث يحذف كلمة بَحْر؛ القَامُوْس)\nمثال: أسبح في المحيط.",
 "大海烏": "أوك عظيم (طائر أوك كبير لا يطير من الجزر الصخرية قبالة سواحل شمال الأطلسي؛ منقرض)",
 "大海老": "كَرْكَنْد",
 "大混乱": "فَوْضَى",
 "大清帝国": "تشينغ, سلالة تشينغ (آخر سلالة إمبراطورية للصين (من 1644 إلى 1912) والتي أطاح بها الثوار؛ خلال سلالة تشينغ حكم المانشو الصين)",
 "大湾": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "大滝": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "大演習": "وَاسِع النِّطَاق (كبير بشكل غير معتاد في النطاق) / كَبِير المِقْيَاس (مبنيّ أو مرسوم بمقياس كبير)",
 "大演説": "خطبة عصماء, صياح (خطبة رنانة عالية الصوت تعبر عن مشاعر قوية)",
 "大火災": "حَرِيق (النَار المشتعلة في شيء كالدَار او الغَابَة)",
 "大災難": "وَاسِع النِّطَاق (كبير بشكل غير معتاد في النطاق) / كَبِير المِقْيَاس (مبنيّ أو مرسوم بمقياس كبير)",
 "大烏": "غُرَاب / غراب",
 "大無人": "وَاحِد, وَاحِدَة (في وَ: العدد واحد العدد الاول) / اَلْمَرْء",
 "大熊": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "大熊座": "الدُّب الْأَكْبَر, بَنَات نَعْش الكُبْرَى",
 "大燥ぎ": "ابتهاج, زهو (شعور بالفرح والفخر)",
 "大物": "شخصية مؤثرة, شخصية هامة (شخص تؤثر أفعاله وآراؤه بقوة على مسار الأحداث) / طرائد كبيرة (حيوانات كبيرة يتم اصطيادها للرياضة)",
 "大犬の陰嚢": "بَانُورَامِيّ, مِنْ عَلُوّ (كما يُرى من ارتفاع أو مسافة بعيدة)",
 "大犬陰嚢": "بَانُورَامِيّ, مِنْ عَلُوّ (كما يُرى من ارتفاع أو مسافة بعيدة)",
 "大猟獣": "طرائد كبيرة (حيوانات كبيرة يتم اصطيادها للرياضة)",
 "大猩々": "غُورِيلَا",
 "大猩猩": "غُورِيلَا",
 "大獄": "تجميع المشتبه بهم, حملة اعتقالات (التجميع المنهجي للمشتبه بهم من قبل الشرطة) / تجميع الماشية (نشاط جمع الماشية معاً لعدها أو وسمها أو بيعها) / جولة ملخصة, حصاد (قائمة ملخصة؛ كما في 'حصاد الأخبار')\nمثال: حملة اعتقالات جماعية للمشتبه بهم",
 "大王": "قَيْصَر, إِمْبْرَاطُور / أَمِير",
 "大王松": "صنوبر أصفر جنوبي, صنوبر طويل الأوراق (صنوبر كبير ثلاثي الإبر من جنوب شرق الولايات المتحدة له إبر طويلة جداً وأطراف ملتوية معقدة؛ اللحاء بني محمر مخدد بعمق؛ شجرة خشب مهمة)",
 "大王椰子": "نخيل ملكي (نخيل ريشي طويل من جنوب فلوريدا وكوبا)",
 "大王烏賊": "حبار عملاق (أكبر رخوي معروف عنه ولكن لم يُرَ قط (يصل طوله إلى 60 قدماً))",
 "大理石": "رُخَام / بِلْيَة",
 "大瑠璃草": "لسان الكلب المخزني (شجيرة ثنائية الحول في أوروبا وغرب آسيا لها أوراق خشنة على شكل لسان وأزهار حمراء أرجوانية داكنة) / لسان الكلب الفرجيني (شجيرة معمرة في أمريكا الشمالية لها أوراق خشنة على شكل لسان وأزهار زرقاء شاحبة إلى أرجوانية)",
 "大甘": "لَيِّن, مُتَسَاهِل (يتّسم بالتسامح والرحمة في التعامل) / لَيِّن, مُتَسَاهِل (غَيْرُ صَارِمٍ فِي تَطْبِيقِ القَوَاعِد) / لَيِّن, مُتَسَامِح (متسامح ورحيم في المعاملة)",
 "大用": "بِرَاز, سَلْح",
 "大田": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "大田原": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "大男": "عِمْلَاق",
 "大畑": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "大略": "لَخَّصَ, اِخْتَصَرَ / تقريباً, حوالي ((للكميات) غير دقيق ولكنه قريب جداً من الصواب) / بخشونة, بعنف (بحركة خشنة كما لو كان فوق سطح خشن) / بخشونة, بعنف (بخشونة أو عنف)\nمثال: استمر حوالي ساعة",
 "大発作": "صرع كبير, نوبة معممة (نوبة يصبح خلالها المريض فاقداً للوعي ويعاني من تشنجات في جميع أنحاء الجسم) / صرع كبير, نوبة توترية رمعية (صرع تتضمن نوباته فقدان الوعي وتشنجات توترية في العضلات يتبعها ارتعاش عام)",
 "大発見": "اِخْتِرَاق (اختراق الرياح مرورها؛ اخترقت الخيل ما بين القرى والشجر:تخلّلتها)",
 "大白鳥": "تم ناعق (بجعة شائعة في العالم القديم تشتهر بندائها الناعق)",
 "大百舌": "صرد شمالي (طائر صرد من شمال أمريكا الشمالية)",
 "大皿": "أسطوانة, أسطوانة فونوغراف (تسجيل صوتي يتكون من قرص به أخدود مستمر؛ يستخدم لإعادة إنتاج الموسيقى عن طريق الدوران بينما تتبع إبرة الفونوغراف الأخدود) / طبق تقديم كبير (طبق كبير ضحل يستخدم لتقديم الطعام)",
 "大盛況": "مَشْغُول",
 "大目": "شهامَة",
 "大目に見る": "صَفَحَ (الصَّفْحُ : العفو؛ صَفْحُ الإِنْسَانِ : جَنْبُهُ)\nمثال: كل صفحة مغامرة.",
 "大目白鮫": "قرش الثور (أكثر أنواع القرش شيوعاً في المياه الساحلية المعتدلة والاستوائية حول العالم؛ ضخم الجسم وخطير)",
 "大相場": "ذراع التطويل, عوارضة (أي من الصواري أو الأعمدة الأفقية المتنوعة المستخدمة لتمديد أسفل الشراع أو لمناولة البضائع أو في الإرساء) / بوم, ذراع الميكروفون (عمود يحمل ميكروفوناً علوياً مسلطاً فوق موقع تصوير فيلم أو تلفزيون) / دوي, رعد (ضجيج عميق طويل وعالٍ) / رزق ساقه الله, رواج (حدث مفاجئ يجلب الحظ السعيد (مثل فرصة مفاجئة لكسب المال))\nمثال: خلق الطلب على الاختبار طفرة لتلك المختبرات غير الخاضعة للتنظيم",
 "大看板": "أَفِيش / لَوْحَة / لَافِتَة / يَافِطَة / لَوْحَة إعْلَانِيَّة / لَوْحَة إِعْلَانَات / بشكل ممتاز, على ما يرام (بشكل جيد جداً) / فَائِق, مُمْتَاز (من أعلى مستويات الجودة)\nمثال: إنها لا تشعر أنها على ما يرام اليوم",
 "大矢": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "大知": "حَكِيم, فَطِن (الذي يتصرف دوما بحكمة وتكون الحكمة من صفاته؛ في : هو الطَبِيب) / مَرْيَمِيَّة / شَاقِيَة\nمثال: هذه كلمات حكيمة.",
 "大石": "جُلْمُود, صَخْرَة كَبِيرَة (كتلة صخرية كبيرة ملساء منفصلة عن مكان نشأتها) / تِنِّين",
 "大砲": "مُسَدَّس, طَبَنْجَة (اسم مفعول من سَدَّسَ؛ في : شَكْل هندسي مُسَطَّح له سِتَّة أضلاع متساوية فإن لم تكن متساوية سميّ بالسُدَاسِيّ) / مِدْفَع (آلة حربية تَقْذِف الكتل الحَدِيدِيَّة أو النَارِيَّة مثل المَنْجَنِيق. بعض العامة تقول مَدْفَع وهذا خطأ. يُجمع جَمْع تَكْسِير على مَدَافِع)\nمثال: كان عند زيري مسدس.",
 "大破": "جلد, ضرب (فعل إيقاع العقاب البدني بضربات متكررة) / سحق, هزيمة نكراء (هزيمة قوية)",
 "大礼服": "زي تشريفات كامل (الزي البحري أو العسكري المحدد باللوائح للارتداء في المناسبات الاحتفالية)",
 "大祖": "مُؤَسِّس, مُؤَسِّسَة",
 "大祖国戦争": "الْحَرْب الْوَطَنِيَّة الْعُظْمَى",
 "大神": "رَبّ (رَبَّ الولدَ يَرُبُّ رَبًّا: ولِيَه وتعهده بما يغذيه وينميه ويؤدّبه؛ الفاعل: رَابٌّ، والمفعول: مَرْبوبٌ، وربيبٌ)\nمثال: اعتني بي يا رب.",
 "大神楽": "جابونيكا, كاميليا يابانية (شجيرة دفيئة ذات أوراق خضراء لامعة وزهور مبهرجة عطرة تشبه الورد؛ تزرع في العديد من الأصناف)",
 "大神田": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "大祭司": "حبر, رئيس كهنة (رجل دين كبير وشخصية رفيعة المستوى) / زعيم روحي, كاهن أعظم (سلطة بارزة أو مؤيد رئيسي لحركة أو مذهب ما)\nمثال: إنه الكاهن الأعظم لموسيقى الجاز المعاصرة",
 "大禍時": "شَفَق ((شَفِقَ) منه، وعليه يَشْفَقَ شَفَقًا: خاف وحَذِرَ، فهو شَفِقٌ؛ (شَفِقَ) عليه: رَقَّ له وعطف عليه؛ فهو شَفِيقٌ)\nمثال: أثارت تلك السلحفاة شفقة زيري.",
 "大福": "بِالتَّوْفِيق!, حَظًّا سَعِيدًا!",
 "大福帳": "دَفْتَر حِسَابَات",
 "大穴": "مُمِيت, قَاتِل / قَتْل (تعمّد جعله يَمُوتُ، أزهق روحه، أمَاتَه متعمدا؛ الوقتَ: ضيعه بشيء غير ذي فائدة وهو ينتظر أمرا آخر)\nمثال: قتل الصياد دبا.",
 "大空": "حَزِين / أَزْرَق, زرق (أحد الأَلْوَان الرئيسية (الأَحْمَر والأَزْرَق والأَصْفَر) وهو لون السَمَاء نهارا حين تكون صافية. انظر الصورة؛ صفة ما كان لونه أزرقًا)\nمثال: هذا البناء أزرق.",
 "大空襲": "حرب خاطفة, هجوم خاطف (هجوم عسكري سريع وعنيف بقصف جوي مكثف) / بليتز, هجوم خاطف ((كرة القدم الأمريكية) محاولة اللاعبين المدافعين اختراق الخط الهجومي)",
 "大立ち回り": "عَارَكَ, قَاتَلَ / تَعَارَكَ, تَقَاتَلَ / نَاضَلَ, كَافَحَ / قِتَال (من قَتَلَ: كثير القَتْل) / مَعْرَكَة\nمثال: لن يحل القتال أي شيء.",
 "大立て者": "زعيم, شخصية محورية (أهم شخص في مجموعة أو مشروع)",
 "大立者": "زعيم, شخصية محورية (أهم شخص في مجموعة أو مشروع)",
 "大竹": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "大筋": "لَخَّصَ, اِخْتَصَرَ",
 "大筒": "مِدْفَع (آلة حربية تَقْذِف الكتل الحَدِيدِيَّة أو النَارِيَّة مثل المَنْجَنِيق. بعض العامة تقول مَدْفَع وهذا خطأ. يُجمع جَمْع تَكْسِير على مَدَافِع)",
 "大箱": "خَزِينَة / كُمُودِينُو, أَدْرَاجِيَّة / صَدْر (الأمر: حدث ووقع وتقرّر؛ عن المكان: رجع وانصرف)\nمثال: تلقى ياني طلقة في الصدر.",
 "大篝火": "مَشْعَل",
 "大粟反": "تِيمُوثَاوُس",
 "大系": "لَخَّصَ, اِخْتَصَرَ",
 "大納言": "خَشِنُ الْحُبَيْبَاتِ (ليس ذا قوام ناعم؛ كبير الحبيبات)",
 "大組み": "تبرج, مكياج (مستحضرات تجميل توضع على الوجه لتحسين أو تغيير المظهر) / بنية, تركيب (الطريقة التي يتكون بها شخص أو شيء ما) / اختبار تعويضي, حدث تعويضي (حدث يتم استبداله بحدث تم إلغاؤه مسبقاً)\nمثال: فاتته الاختبار واضطر لإجراء اختبار تعويضي",
 "大統領": "رَئِيس, رَئِيسَة",
 "大統領令": "أَمْرٌ تَنْفِيذِيٌّ (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة)\nمثال: إنه أمر مختلف .",
 "大統領夫人": "السيدة الأولى (زوجة الرئيس التنفيذي) / سيدة أولى (المرأة الرائدة في فن أو مهنة)",
 "大統領府": "السلطة التنفيذية, المكتب التنفيذي للرئيس (فرع حكومة الولايات المتحدة المسؤول عن تنفيذ القوانين)",
 "大統領首席補佐官": "رئيس أركان الجيش",
 "大綱": "أساسيات, مبادئ أساسية (مبادئ يمكن استنتاج حقائق أخرى منها)\nمثال: أولاً يجب أن تتعلم الأساسيات / لَخَّصَ, اِخْتَصَرَ",
 "大網": "ثرب كبير (جزء من الصفاق متصل بالمعدة والقولون ويغطي الأمعاء)",
 "大網膜": "برقع, غشاء جنيني (الغشاء الداخلي للأجنة في الفقاريات العليا (خاصة عندما يغطي الرأس عند الولادة)) / ثرب كبير (جزء من الصفاق متصل بالمعدة والقولون ويغطي الأمعاء)",
 "大総統": "رَئِيس, رَئِيسَة",
 "大罪": "خطيئة مميتة, كبيرة من الكبائر (خطيئة لا تغتفر تستوجب فقدان النعمة الإلهية تماماً)\nمثال: يدرج اللاهوتيون سبع خطايا مميتة",
 "大義": "عَدْل, إِنْصَاف (عَدْل) / عَدْل, عَدَالَة (عَدْل) / عَدْل (عَدْل)\nمثال: هل يعاملون بالعدل",
 "大義名分": "ذَرِيعَة, عُذْر / وَاجِب, وَظِيفَة (اسم لما يُوجَبُ فعله؛ اسم لما صار حدوثه أكيد) / رَسْم (سَم الشَّيءَ :خطّه رسَم مُربَّعًا/ صورةً/ شكلاً؛ رسَم : كَتَبَ)\nمثال: لا شكر على واجب.",
 "大羽": "رِيشَة مُحِيطِيَّة (ريش يغطي جسم الطائر البالغ ويحدد شكله)",
 "大耳狐": "لَوْشَب",
 "大聖": "بُوذَا, بُدّ",
 "大聖堂": "كَاتِدْرَائِيَّة",
 "大股": "اِمْتَطَى",
 "大胆": "جَرِيء, جَسُور",
 "大胆不敵": "جَرِيء, جَسُور",
 "大胞子": "بوغ كبير (أكبر نوعي الأبواغ المنتجة في النباتات متباينة الأبواغ؛ يتطور في البويضة إلى نبات مشيجي أنثوي)",
 "大胞子嚢": "محفظة بوغية كبيرة (بنية نباتية تنتج أبواغاً كبيرة)",
 "大胸筋": "صدرية كبرى (عضلة هيكلية تقرب الذراع وتديرها)",
 "大脳": "مخ (الجزء الأمامي من الدماغ يتكون من نصفي كرة؛ الجزء المهيمن من الدماغ في البشر)",
 "大脳半球": "نصف كرة مخية (أي من نصفي المخ)",
 "大脳新皮質": "قشرة حديثة (الجزء القشري من الدماغ الحديث)",
 "大脳皮質": "قشرة مخية",
 "大脳脚": "سويقة, سويقة مخية (حزمة من العصبونات المغلفة بالمايلين تربط أجزاء مختلفة من الدماغ)",
 "大脳辺縁系": "جهاز حوفي (نظام من الهياكل العصبية المرتبطة وظيفياً في الدماغ والتي تشارك في السلوك العاطفي)",
 "大腸": "أَمْعَاء غَلِيظَة, مِعًى غَلِيظ",
