 "定期": "عَادِيّ / عقد مستقبلي, عقود آجلة (اتفاقية لشراء أو بيع كمية محددة من سلعة أو أداة مالية بسعر معين في تاريخ…)",
 "定期乗車券": "تذكرة اشتراك, تذكرة موسمية (تذكرة صالحة لعدة رحلات أو لحضور موسم من الفعاليات الترفيهية؛ تباع بسعر مخفض)",
 "定期保全": "صيانة دورية, صيانة مجدولة (صيانة في وقت محدد بانتظام)",
 "定期保守": "صيانة دورية, صيانة مجدولة (صيانة في وقت محدد بانتظام)",
 "定期保険": "تأمين مؤقت (تأمين منخفض التكلفة صالح فقط لفترة زمنية محددة وليس له قيمة استرداد نقدي أو…)",
 "定期刊行物": "دوري (يحدث أو يتكرر على فترات منتظمة)\nمثال: الظهور الدوري للجراد ذي السبعة عشر عاماً",
 "定期券": "تذكرة اشتراك, تذكرة موسمية (تذكرة صالحة لعدة رحلات أو لحضور موسم من الفعاليات الترفيهية؛ تباع بسعر مخفض)",
 "定期取引": "عقد مستقبلي, عقود آجلة (اتفاقية لشراء أو بيع كمية محددة من سلعة أو أداة مالية بسعر معين في تاريخ…)",
 "定期的": "دَوْرِيّ, عَرَضِيّ (يَتَكَرَّرُ أَوْ يَظْهَرُ مِنْ حِينٍ لِآخَر)\nمثال: الظهور الدوري للجراد ذي السبعة عشر عاماً",
 "定期船": "ضربة خطية, لاين درايف ((بيسبول) ضربة تطير بشكل مستقيم من الضارب)\nمثال: ضرب الضارب كرة خطية إلى الشورت ستوب",
 "定期購読": "اِشْتِرَاك",
 "定期預金": "وديعة لأجل (شهادة إيداع لا يمكن السحب منها إلا بعد إشعار مسبق أو في تاريخ مستقبلي محدد)",
 "定木": "مِسْطَرَة (أداة تستخدم لقياس الأطوال أو رسم الخطوط المستقيمة؛ خط مستقيم تحدده مِسطَرة أو…)\nمثال: استعارت المسطرة.",
 "定植": "زراعة, غرس (وضع البذور أو النباتات الصغيرة في الأرض لتنمو)\nمثال: زراعة الذرة عمل شاق",
 "定款": "النظام الأساسي للشركة, عقد التأسيس (وثيقة قانونية تنشئ شركة؛ يتم تقديمها إلى الولاية من قبل مؤسسي الشركة وتحكمها…)",
 "定比例の法則": "قانون النسب الثابتة ((كيمياء) قانون ينص على أن كل مادة نقية تحتوي دائمًا على نفس العناصر مجتمعة بنفس…)",
 "定温動物": "ذوات الدم الحار, كائن ثابت الحرارة (حيوان لديه درجة حرارة جسم ثابتة نسبياً ومستقلة عن درجة حرارة البيئة)",
 "定火消": "إِطْفَائِيّ",
 "定火消し": "إِطْفَائِيّ",
 "定理": "مُبَرْهَنَة",
 "定番": "تَقْلِيدِيّ, كُلَاسِيكِيّ (يتعلق بالفترة المهمة الأولى لحضارة أو ثقافة أو مجال دراسة، إلخ)\nمثال: فخار صيني كلاسيكي / حَارِس",
 "定着": "غُصَيْن\nمثال: لا تمسك العصا من الوسط. / إمساك, قبض (فعل الإمساك بشيء بإحكام باليدين) / تثبيت ((علم الأنسجة) حفظ عينة الأنسجة وتصلبها للاحتفاظ بنفس العلاقات التي كانت لها في…)",
 "定着剤": "عامل تثبيت, مثبت (مركب كيميائي يقوم بتثبيت شيء ما (مثل الصبغة أو الصورة الفوتوغرافية))",
 "定着化": "تَأْسِيس",
 "定着液": "مثبت (ورنيش مذاب في الكحول ويرش على الصور لمنع التلطخ)",
 "定石": "صِيغَة",
 "定祐": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "定積分": "تكامل محدود (تكامل دالة على فترة محددة)",
 "定立": "أُطْرُوحَة",
 "定置": "إصلاح, ترميم (فعل إعادة الشيء إلى حالة العمل)\nمثال: أخذوه إلى الطبيب البيطري للإخصاء / ثَابِت, مُجَمَّد (لا يمكن تغييره أو تحريكه أو التراجع عنه)\nمثال: قطعة خشب مثبتة",
 "定義": "تَعْرِيف (الإعلام؛ الشيء أو الكلمة: التوضيح بالمعنى بصورة مختصرة ليعرف الناس ما هي)\nمثال: هل لديه بطاقة شخصية (هوية شخصية - بطاقة تعريف)",
 "定義可能": "قَابِلٌ لِلتَّعْرِيف (يُمْكِنُ تَعْرِيفُهُ أَوْ تَحْدِيدُهُ أَوْ شَرْحُه)",
 "定義域": "مَجَال إِنْتَرْنَت\nمثال: هل تمثل الزراعة على نطاق واسع النظام البيئي في الجزائر؟",
 "定義済み": "مَبْنِيّ, مُدْمَج",
 "定義済み変数": "مَبْنِيّ, مُدْمَج",
 "定職": "وَظِيفَة, مِهْنَة (ما يُقَدَّر من الشيء في زمن مُعَيَّن؛ مَنْصِب)\nمثال: ما وظيفة زوجتك؟",
 "定規": "مِسْطَرَة (أداة تستخدم لقياس الأطوال أو رسم الخطوط المستقيمة؛ خط مستقيم تحدده مِسطَرة أو…)\nمثال: استعارت المسطرة.",
 "定規座": "قَانُون, قَاعِدَة (مقياس كل شيء وطريقه؛ أمر كليّ ينطبق على جميع جزئياته التي تعرف أحكامها منه)\nمثال: ذكرني بالقانون.",
 "定言命法": "أَمْر مُطْلَق, وَاجِب قَطْعِيّ (المبدأ الأخلاقي القائل بأن السلوك يجب أن يتحدد بالواجب)",
 "定言的": "غَيْرُ مَشْرُوط, قَاطِع (غير مقيّد بتحفّظات أو استثناءات)",
 "定言的命令": "أَمْر مُطْلَق, وَاجِب قَطْعِيّ (المبدأ الأخلاقي القائل بأن السلوك يجب أن يتحدد بالواجب)",
 "定言的命法": "أَمْر مُطْلَق, وَاجِب قَطْعِيّ (المبدأ الأخلاقي القائل بأن السلوك يجب أن يتحدد بالواجب)",
 "定足数": "نِصَاب",
 "定量分析": "تحليل كمي, تحليل كيميائي كمي (تحليل كيميائي لتحديد كميات كل عنصر في المادة)",
 "定量的": "كمي (يمكن التعبير عنه ككمية أو يتعلق بـ أو قابل للقياس)\nمثال: تصدير القمح دون قيود كمية",
 "定項": "ثَابِت (اسم فاعل من ثَبَتَ؛ المُسْتَقِرّ الذي لا يتحرك، ضد المُتَحَرِّك)\nمثال: الشاحنة غير ثابتة.",
 "定食": "خَاصّ, خُصُوصِيّ (قلَّ أو أصبح أقل؛ خَاصَ العَطَاءَ خَاصَ خَوْصًا: قلَّله)\nمثال: كل الخضار الخاص بك.",
 "宛": "هَدَف (جاء إلى الهَدَف؛ ارتفع عن الأرض)\nمثال: لقد أخطأ الهدف. / أفق, استشراف (اعتقاد بشأن المستقبل (أو تصور ذهني له)) / وِسَادَة (الجانب السفلي اللحمي الشبيه بالوسادة لقدم الحيوان أو إصبع الإنسان) / نَفَخَ (أَطْلَقَ الريح من فمه؛ زَفَرَ أو هَبَّ بشدة)\nمثال: يداك أوكتا وفوك نفخ",
 "宛い": "تخصيص, تقسيم (فعل التوزيع عن طريق التخصيص أو التقسيم؛ التوزيع وفقاً لخطة)\nمثال: يعتمد توزيع المقاعد في مجلس النواب على الكثافة السكانية لكل ولاية",
 "宛がう": "خَصَّصَ (خَصَّصَ الشيءَ: جعله خاصًّا؛ خَصَّصَ فلانًا بالشيءِ: خَصَّهُ به)\nمثال: حاول توفير بعض المال من ما خصص للسفر. / أَعْطَى, وَهَبَ (مَنَحَ، نَوَّلَ)\nمثال: أعطى بلده حياته.",
 "宛て": "هَدَف (جاء إلى الهَدَف؛ ارتفع عن الأرض)\nمثال: لقد أخطأ الهدف. / أفق, استشراف (اعتقاد بشأن المستقبل (أو تصور ذهني له)) / وِسَادَة (الجانب السفلي اللحمي الشبيه بالوسادة لقدم الحيوان أو إصبع الإنسان) / نَفَخَ (أَطْلَقَ الريح من فمه؛ زَفَرَ أو هَبَّ بشدة)\nمثال: يداك أوكتا وفوك نفخ",
 "宛てがう": "خَصَّصَ (خَصَّصَ الشيءَ: جعله خاصًّا؛ خَصَّصَ فلانًا بالشيءِ: خَصَّهُ به)\nمثال: حاول توفير بعض المال من ما خصص للسفر. / أَعْطَى, وَهَبَ (مَنَحَ، نَوَّلَ)\nمثال: أعطى بلده حياته.",
 "宛てのない": "تَائِه, هَائِم (يسير بلا وجهة ولا اتّجاه محدّد)",
 "宛てる": "خُطْبَة, نِدَاء\nمثال: نسيت عنوان توم.",
 "宛て先": "خُطْبَة, نِدَاء\nمثال: نسيت عنوان توم.",
 "宛て先変更": "تَحْوِيل",
 "宛て名": "عُنْوَان, وُجْهَة (توجيهات مكتوبة للعثور على موقع ما؛ تكتب على الرسائل أو الطرود التي سيتم تسليمها…)",
 "宛て所": "خُطْبَة, نِدَاء\nمثال: نسيت عنوان توم.",
 "宛て書き": "عنوان بريدي (العنوان الذي يمكن التواصل من خلاله مع شخص أو منظمة)",
 "宛のない": "تَائِه, هَائِم (يسير بلا وجهة ولا اتّجاه محدّد)",
 "宛先": "خُطْبَة, نِدَاء\nمثال: نسيت عنوان توم.",
 "宛先変更": "تَحْوِيل",
 "宛名": "عُنْوَان, وُجْهَة (توجيهات مكتوبة للعثور على موقع ما؛ تكتب على الرسائل أو الطرود التي سيتم تسليمها…)",
 "宛名書き": "خُطْبَة, نِدَاء\nمثال: نسيت عنوان توم.",
 "宛所": "خُطْبَة, نِدَاء\nمثال: نسيت عنوان توم.",
 "宛書": "عنوان بريدي (العنوان الذي يمكن التواصل من خلاله مع شخص أو منظمة)",
 "宛書き": "عنوان بريدي (العنوان الذي يمكن التواصل من خلاله مع شخص أو منظمة)",
 "宛然": "كَأَنَّ, كَأَنَّمَا (يفيد التشبيه)\nمثال: كأن هذه السيارة له.",
 "宛転": "فَصِيح, فُصْحَى / حَسَن (جَمِيل؛ مُبْهِج)\nمثال: إيمي فتاة حسنة.",
 "宜": "بصدق, حقاً (وفقاً للحقيقة أو الواقع)\nمثال: أصبحت الآن أمريكية حقاً",
 "宜う": "وَافَقَ (صَادَفَ؛ صَادَقَ)\nمثال: وافق ماثيو بتردد.",
 "宜う候": "مَفْهُوم",
 "宜しい": "حَسَن, جَيِّد (جَمِيل؛ مُبْهِج)\nمثال: إيمي فتاة حسنة.",
 "宜しく": "حَسَنًا, بِخَيْر (تقال عند استحسان الفعل أو القول، هَذَا حَسَن)\nمثال: حسنا. أنا موافق. / مَعَ أَطْيَب التَحْيَات (يفيد الاجتماع والمصاحبة؛ مكان الاجتماع)\nمثال: جئت مع أصدقائي. / كَمَا لَو, كَأَنَّ / بكل الوسائل, بكل تأكيد (بالتأكيد أو يقيناً)\nمثال: زرنا بكل تأكيد",
 "宜しくお願いします": "سَاعِدُونِي, سَاعِدْنِي",
 "宜しくお願い致します": "سَاعِدُونِي, سَاعِدْنِي",
 "宜しゅう": "مَعَ أَطْيَب التَحْيَات (يفيد الاجتماع والمصاحبة؛ مكان الاجتماع)\nمثال: جئت مع أصدقائي.",
 "宜なるかな": "بالفعل, حقاً ((تستخدم كصيغة تعجب) تعبير عن الدهشة أو الشك أو السخرية وما إلى ذلك)\nمثال: يريد الزواج من رئيس الخدم؟ حقاً!",
 "宜候": "مَفْهُوم",
 "宝": "كَنْز",
 "宝くじ": "يَانَصِيب",
 "宝さかって入る時はさかって出る": "حَرَام, غَيْر مَشْرُوع (مُكْتَسَب بِطُرُق غَيْر مَشْروعَة أَوْ غَيْر نَزيهَة)",
 "宝さがし": "البحث عن الكنز (لعبة يحاول فيها اللاعبون العثور على أغراض مخفية باستخدام سلسلة من الأدلة) / اختيار عشوائي (اختيار أو قرار عشوائي بحت)\nمثال: بدا نظام توظيفهم للأشخاص وكأنه نوع من الاختيار العشوائي",
 "宝の山": "منجم ذهب (منجم يُعثر فيه على خام الذهب)",
 "宝典": "دَلِيل, كُتَيِّب",
 "宝冠": "ديادم",
 "宝号": "اِسْم, أَسْمَاء (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه…)\nمثال: ما اسم حصان توم؟",
 "宝山": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "宝庫": "خَزِينَة\nمثال: インターネットはこの上なく貴重な情報の宝庫だ。 — الإنترنت مصدرُ معلوماتٍ لا يقدر بثمن. / كنز مكتشف (أي مجموعة من الأشياء الثمينة التي يتم اكتشافها)\nمثال: كان كتابها كنزاً من الأفكار الجديدة",
 "宝捜し": "البحث عن الكنز (لعبة يحاول فيها اللاعبون العثور على أغراض مخفية باستخدام سلسلة من الأدلة) / اختيار عشوائي (اختيار أو قرار عشوائي بحت)\nمثال: بدا نظام توظيفهم للأشخاص وكأنه نوع من الاختيار العشوائي",
 "宝探し": "البحث عن الكنز (لعبة يحاول فيها اللاعبون العثور على أغراض مخفية باستخدام سلسلة من الأدلة) / اختيار عشوائي (اختيار أو قرار عشوائي بحت)\nمثال: بدا نظام توظيفهم للأشخاص وكأنه نوع من الاختيار العشوائي",
 "宝殿": "قدس الأقداس, منطقة المذبح (المنطقة المحيطة بمذبح الكنيسة لرجال الدين والجوقة؛ غالباً ما تكون محاطة بسياج…)",
 "宝物": "كَنْز",
 "宝物庫": "بيت الكنز (مستودع للكنوز)",
 "宝物殿": "قدس الأقداس, منطقة المذبح (المنطقة المحيطة بمذبح الكنيسة لرجال الدين والجوقة؛ غالباً ما تكون محاطة بسياج…)",
 "宝玉": "جَوْهَر, جَوْهَرَة (جَوْهَر)\nمثال: الجمال في الجوهر لا المظهر",
 "宝瓶": "زَهْرِيَّة",
 "宝瓶宮": "بُرْج اَلدَّلْو, الدَّلْو (ظهر وارتفع)\nمثال: وصل كارل إلى برج آخر.",
 "宝田": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "宝石": "جَوْهَر, جَوْهَرَة (جَوْهَر)\nمثال: الجمال في الجوهر لا المظهر",
 "宝石商": "صَائِغ, صَائِغَة",
 "宝石店": "تاجر مجوهرات, متجر مجوهرات (شركة تبيع وتشتري المجوهرات)",
 "宝石箱": "صندوق مجوهرات (صندوق صغير ومزخرف غالباً لحفظ المجوهرات أو الأشياء الثمينة الأخرى)",
 "宝箱": "صندوق كنز (صندوق مملوء بالأشياء الثمينة)",
 "宝船": "سفينة كنز (سفينة من القرن السادس عشر محملة بالكنوز)",
 "宝蔵": "بيت الكنز (مستودع للكنوز)",
 "宝貝": "ودع",
 "宝迫": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "宝鑑": "دَلِيل, كُتَيِّب",
 "宝飾": "حلي, مجوهرات (زينة (كالسوار أو الخاتم أو العقد) مصنوعة من معادن ثمينة ومرصعة بالأحجار الكريمة…)",
 "宝飾品": "حلي, مجوهرات (زينة (كالسوار أو الخاتم أو العقد) مصنوعة من معادن ثمينة ومرصعة بالأحجار الكريمة…)",
 "宝飾店": "جوهرجي, صائغ (شخص يعمل في مجال بيع المجوهرات)",
 "実": "حَقِيقَة (الحَقّ، نقيض البَاطِل؛ نقيض المَجَاز)\nمثال: هي صديقة حقيقة. / إِخْلَاص (وقيل: الإخلاص تصفية الأعمال من الكدورات؛ وقيل: الإخلاص: ستر بين العبد وبين الله…) / رَاضٍ, مُرْتَاح (رَاضَ (راضه)روضا ورياضا ورياضة: ذلله. يقال راض المهر وراض نفسه بالتقوى وراض…)\nمثال: سامي غير راض بوظيفته. / تَسَبَّب / فَاكِهَة (الثمار كلها؛ ما يتنعم بأكله رطبا كان أم يابسا كالتين واللوز والرمان ونحوها)\nمثال: التفاح فاكهة لذيذة. / بِذْرَة, زَرِّيعَة / رَاضٍ, مُرْتَاح (رَاضَ (راضه)روضا ورياضا ورياضة: ذلله. يقال راض المهر وراض نفسه بالتقوى وراض…)\nمثال: سامي غير راض بوظيفته. / حَقِيقَة (الحَقّ، نقيض البَاطِل؛ نقيض المَجَاز)\nمثال: هي صديقة حقيقة. / إِخْلَاص (وقيل: الإخلاص تصفية الأعمال من الكدورات؛ وقيل: الإخلاص: ستر بين العبد وبين الله…) / بالفعل, حقاً ((تستخدم كصيغة تعجب) تعبير عن الدهشة أو الشك أو السخرية وما إلى ذلك)\nمثال: يريد الزواج من رئيس الخدم؟ حقاً! / بِذْرَة, زَرِّيعَة / لِسَان (فِي : جسم لحميّ مستطيل متحرك، يكون في الفم، ويصلح للتّذوُّق والبلع، وللنطق…)\nمثال: ماري لها فم ليس لها لسان. / بَظْر / نِوَاة / الشَّيْء الأَصْلِيّ (استخدام غير رسمي ينسب الأصالة)",
 "実が入る": "يَنَعَ, نَضَجَ (أَيْنَعَ؛ نَضَجَ)",
 "実しやか": "قابل للتصديق, معقول (يبدو معقولاً وموثوقاً، وبالتالي مقنعاً)\nمثال: عذر وجيه",
 "実しやかに": "كَأَنَّ, كَأَنَّمَا (يفيد التشبيه)",
