 "宇宙発生論": "علم الكون, نشأة الكون (فرع الفيزياء الفلكية الذي يدرس أصل وتطور وبنية الكون)",
 "宇宙空間": "فَرَاغ, مَكَان / فَضَاء (فَضَاء) / مَسَافَة\nمثال: الفضاء مليئ بالغموض.",
 "宇宙線": "أشعة كونية (إشعاع مؤين عالي الاختراق من أصل خارج الأرض؛ يتكون بشكل رئيسي من بروتونات وجسيمات ألفا؛ الاصطدام بجسيمات الغلاف الجوي ينتج عنه أشعة وجسيمات من أنواع…)",
 "宇宙線シャワー": "أشعة كونية (إشعاع مؤين عالي الاختراق من أصل خارج الأرض؛ يتكون بشكل رئيسي من بروتونات وجسيمات ألفا؛ الاصطدام بجسيمات الغلاف الجوي ينتج عنه أشعة وجسيمات من أنواع…)",
 "宇宙線嵐": "أشعة كونية (إشعاع مؤين عالي الاختراق من أصل خارج الأرض؛ يتكون بشكل رئيسي من بروتونات وجسيمات ألفا؛ الاصطدام بجسيمات الغلاف الجوي ينتج عنه أشعة وجسيمات من أنواع…)",
 "宇宙背景放射": "إشعاع الخلفية الكونية ((في علم الكونيات) البقايا المبردة للانفجار العظيم الحار التي تملأ الكون بأسره ويمكن رصدها اليوم بمتوسط درجة حرارة حوالي 2.725 كلفن)",
 "宇宙船": "سَفِينَةٌ فَضَائِيَّة, مَرْكَبَةٌ فَضَائِيَّة (مَرْكَبٌ بَحْرِيٌّ لِنَقْلِ الْمُسَافِرِينَ وَالبَضَائِعِ)\nمثال: غادروا السفينة.",
 "宇宙船基地": "كُوسْمُودْرُوم",
 "宇宙計画": "برنامج فضاء (برنامج تكنولوجي يهدف إلى استكشاف الفضاء الخارجي)",
 "宇宙論": "عِلْم الكَوْن الفِيزِيَائِيّ (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "宇宙速度": "سرعة الإفلات",
 "宇宙進化論": "علم الكون, نشأة الكون (فرع الفيزياء الفلكية الذي يدرس أصل وتطور وبنية الكون)",
 "宇宙遊泳": "سير في الفضاء (أي نوع من النشاط البدني خارج المركبة الفضائية يقوم به أحد أفراد الطاقم)",
 "宇宙飛行": "رِحْلَةٌ فَضَائِيَّة",
 "宇宙飛行士": "رَجُل فَضَاء (العُضْو في جسد الإنسان يتكون من القَدَم والسَاق والفُخْذ. الجمع أرجُل، وقد تقول العامّة رِجْلين ورجْلينات؛ القَدَم من باب اطلاق اسم الكل على الجزء) / رَائِد فَضَاء / مَلَّاح فَضَائِيّ\nمثال: هذا الرجل تاجر.",
 "宇治": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "宇津井": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "宇津木": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "宇田": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "宇田川": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "宇都宮": "أُوتْسُونُومِيَا",
 "宇野": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "宇高": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "守": "مجالسة الأطفال (عمل جليس الأطفال؛ رعاية الأطفال عندما لا يكون والداهم في المنزل) / حَمَى (حمَى الشيءُ فلانًا: منَعه ودفع عنه؛ حمى المريضَ: منعه ما يضره)\nمثال: ليس لديك أي حمى. / حِمَايَة / بروفيدنس / تَمِيمَة, أُخْذَة / مُدِير, مُدِيرَة (الشخص الذي أدار، جمعه مُدِيرُون ومُدِيرِين؛ مهنة يتولى صاحبها إدَارَة شؤون جهة ما. جمعه مُدَرَاء)\nمثال: زيري هو المدير.",
 "守り": "مجالسة الأطفال (عمل جليس الأطفال؛ رعاية الأطفال عندما لا يكون والداهم في المنزل) / حَمَى (حمَى الشيءُ فلانًا: منَعه ودفع عنه؛ حمى المريضَ: منعه ما يضره)\nمثال: ليس لديك أي حمى. / حِمَايَة / بروفيدنس / تَمِيمَة, أُخْذَة",
 "守り人": "حَارِس / حَرَسَ (حَفِظَ الشيء أو الشخص أو مكاناً من المخاطر أو الأضرار؛ راقب شيئاً أو شخصاً بعناية لضمان الأمان)\nمثال: كان لدى سامي حرس شخصي.",
 "守り手": "وَلِي أَمْر, حَافِظ (مَلَكَ الأمر وقَامَ به وسيطر عليه وولي عليه ولايةَ) / حَارِس\nمثال: ولي العهد هو من يرث العرش. / سَاعَة (ثُلْث ثُمْن اليَوْم بمعنى مجموع النَهَار واللَيْل، أي جزء من أربعة وعشرين جزءا من مجموع النهار والليل وتتكون من ستين دَقِيقَة؛ الوَقْت الحاضر، الآن) / حَارِس / رَصَدَ (الرَّصْد : المُراقبة؛ الرَّصد الجوّي: دراسة الأَحوال الجوّيَّة لمعرفة تقلُّبات الطقس) / حَذِرَ (حذِر الشّخصُ: تيقّظ واستعدّ وتأهّب وتنبّه؛ حذِر الأمرَ: كَتَمَه وأخفاه) / حَرَسَ (حَفِظَ الشيء أو الشخص أو مكاناً من المخاطر أو الأضرار؛ راقب شيئاً أو شخصاً بعناية لضمان الأمان)\nمثال: درست لمدة ساعة.",
 "守り札": "طِلَسْم, طِلَّسْم",
 "守り立てる": "دَعَمَ, دَعَّمَ (• دَعَمَهُ، كمنَعهُ: مالَ فأقامَهُ) / أَيَّدَ, دَعَمَ ((أَيَّدَه): قوّاه بالإياد) / تَأْيِيد, دَعْم\nمثال: ياني هنا لدعم ريمة. / أَحْيَا / رَفَعَ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ)\nمثال: رفع سامي نظارته.",
 "守る": "حَمَى (حمَى الشيءُ فلانًا: منَعه ودفع عنه؛ حمى المريضَ: منعه ما يضره)\nمثال: ليس لديك أي حمى. / اِحْتَفَظَ, أَبْقَى",
 "守備": "دِفَاع, حِمَايَة / دِفاع / دفاع, لعب ميداني ((بيسبول) التعامل مع الكرة أثناء اللعب في الملعب)",
 "守備兵": "حَارِس / حَرَسَ (حَفِظَ الشيء أو الشخص أو مكاناً من المخاطر أو الأضرار؛ راقب شيئاً أو شخصاً بعناية لضمان الأمان)\nمثال: كان لدى سامي حرس شخصي.",
 "守備的": "دفاعي (مخصص أو مناسب للدفاع ضد العدوان أو الهجوم أو لردعه) / تَبْرِيرِيّ, دِفَاعِيّ (يسعى إلى التبرير أو الدفاع قولاً أو كتابةً) / موقف دفاعي (موقف يتسم بالدفاع عن النفس)\nمثال: أسلحة دفاعية",
 "守備範囲": "حَقْل (ذهب أو حدث بسرعة أو دون توقف؛ في بعض اللهجات: تعني تحرك سريعاً أو اهتزّ) / سَاحَة, سَاحَة الْمَعْرَكَة / مَجَال\nمثال: يعمل الفلاحون في الحقل.",
 "守備隊": "حَامِيَة",
 "守兵": "حَارِس / حَرَسَ (حَفِظَ الشيء أو الشخص أو مكاناً من المخاطر أو الأضرار؛ راقب شيئاً أو شخصاً بعناية لضمان الأمان)\nمثال: كان لدى سامي حرس شخصي.",
 "守則": "دُسْتُور, دَسْتُور (قَاعِدَة) / اِصْطِلَاح / تَرْمِيز, شِفْرَة / كود, شِفْرَة\nمثال: العدالة مضمونة في الدستور.",
 "守勢": "دفاعي (مخصص أو مناسب للدفاع ضد العدوان أو الهجوم أو لردعه) / تَبْرِيرِيّ, دِفَاعِيّ (يسعى إلى التبرير أو الدفاع قولاً أو كتابةً) / موقف دفاعي (موقف يتسم بالدفاع عن النفس)\nمثال: أسلحة دفاعية",
 "守口": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "守宮": "وَزَغَة",
 "守屋": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "守岡": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "守役": "مُمَرِّض / مُمَرِّضَة / ممرض / أَرْضَعَ ((أَرْضَعَت) الْأُم: كَانَ لَهَا ولد تُرْضِعه؛ (أَرْضَعَت) الْولد: جعلته يرضع فَهِيَ مرضع ومرضعة (ج) مراضع) / مَرَّضَ (أصابه مرضٌ أو علّة أو سَقَم)\nمثال: هذا المرض قلبي.",
 "守戍": "حرس الحدود (مجموعة من الضباط الذين يقومون بدوريات على حدود الدولة)",
 "守旧": "سِيَاسَة مُحَافِظَة, فِكْر مُحَافِظ (بمعنى رعى الغنم وقادها؛ بمعنى قاد الناس وحَكَمَهم باللين والحكمة لا بالغصب والقهر)\nمثال: عاد إلى السياسة.",
 "守旧派": "مُحَافِظ",
 "守本": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "守札": "طِلَسْم, طِلَّسْم",
 "守株": "غَبَاء, غَبَاوَة (بمعنى أن يخفى الأمر، يقال أيضا غَبَاءَة وغَبَاوَة والغباء أعمّ؛ بمعنى ضد الفِطْنة والذَكاء، يقال أيضا غَبَاوة)\nمثال: ما تقترحه غباء.",
 "守田": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "守禦": "دِفَاع, حِمَايَة / دِفاع",
 "守秘": "سِرِّيَّة",
 "守立てる": "دَعَمَ, دَعَّمَ (• دَعَمَهُ، كمنَعهُ: مالَ فأقامَهُ) / أَيَّدَ, دَعَمَ ((أَيَّدَه): قوّاه بالإياد) / تَأْيِيد, دَعْم\nمثال: ياني هنا لدعم ريمة. / أَحْيَا / رَفَعَ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ)\nمثال: رفع سامي نظارته.",
 "守衛": "حَارِس / حَرَسَ (حَفِظَ الشيء أو الشخص أو مكاناً من المخاطر أو الأضرار؛ راقب شيئاً أو شخصاً بعناية لضمان الأمان)\nمثال: كان لدى سامي حرس شخصي.",
 "守護": "حِمَايَة",
 "守護人": "حَارِس / حَرَسَ (حَفِظَ الشيء أو الشخص أو مكاناً من المخاطر أو الأضرار؛ راقب شيئاً أو شخصاً بعناية لضمان الأمان)\nمثال: كان لدى سامي حرس شخصي.",
 "守護天使": "مَلَاك حَارِس",
 "守護神": "أقرب ((صيغة المقارنة لـ قريب) ضمن مسافة أقصر) / الغالق, رامٍ منهي للمباراة ((في البيسبول) رامٍ بديل يمكنه حماية التقدم في الشوط الأخير أو الشوطين الأخيرين من المباراة) / مُغْلِق (شخص يغلق شيئاً ما)",
 "守護者": "وَلِي أَمْر, حَافِظ (مَلَكَ الأمر وقَامَ به وسيطر عليه وولي عليه ولايةَ) / حَارِس\nمثال: ولي العهد هو من يرث العرش.",
 "守護聖人": "قِدِّيس شَفِيع (قديس يعتبر مدافعاً عن جماعة أو أمة معينة)",
 "守護霊": "الروح الحارسة, الملاك الحارس (ملاك يُعتقد أن لديه عاطفة خاصة تجاه فرد معين)",
 "守銭奴": "بَخِيل, بَخِيلَة (الجمع : بُخَلاءُ ، المؤنث : بخيلة ، و الجمع للمؤنث : بخيلات و بُخَلاءُ؛ شَحِيْح، مُقْتِر)\nمثال: بئس الرجل البخيل.",
 "安": "رَخِيص / طَفْح, طَفْح جِلْدِيّ",
 "安々": "بهدوء (برباطة جأش (خاصة في أوقات التوتر)) / برزانة, بهدوء ووقار (بطريقة رزينة وهادئة)\nمثال: تحدث بهدوء للطلاب المشاغبين",
 "安い": "رَخِيص / هَادِئ / طَمْأَنَ",
 "安き": "رَاحَة, اِسْتِرَاحَة / اِسْتَرَاحَ (اِرْتَاح؛ طلب الرَاحَة) / بَاقِيَّة / أَثَارَة\nمثال: عليك أخذ استراحة.",
 "安く": "بِثَمَن بَخْس, بِرُخْص (مع القليل من إنفاق المال) / بتكلفة زهيدة, بشكل رخيص (بطريقة رخيصة أو مبتذلة)\nمثال: اشتريت هذه السيارة بثمن بخس جداً",
 "安っぽい": "رَدِيء الصُّنْع, مُبْتَذَل (مصنوع بحرفية ومواد رديئة) / صَارِخ, مُبَهْرَج (بَرَّاقٌ وَلَافِتٌ بِطَرِيقَةٍ تَفْتَقِرُ إِلَى الذَّوْق)",
 "安ぴか": "حلي رخيصة, حلية مبهرجة (مجوهرات رخيصة ومبهرجة أو زينة على الملابس) / صولجان المهرج (صولجان ساخر يحمله مهرج البلاط)",
 "安まる": "استجمام, استرخاء (التحرر من النشاط (العمل أو الجهد أو المسؤولية)) / سكينة, طمأنينة (طبع خالٍ من التوتر أو الانفعال) / راحة بال, سلام (غياب التوتر العقلي أو القلق)\nمثال: أخذ قسطاً من الراحة بجانب المسبح",
 "安らい": "رَاحَة, اِسْتِرَاحَة / اِسْتَرَاحَ (اِرْتَاح؛ طلب الرَاحَة) / بَاقِيَّة / أَثَارَة\nمثال: عليك أخذ استراحة. / مُتَحَيِّر, مُتَرَدِّد (يفتقر إلى حسم الشخصية؛ عاجز عن الفعل أو القرار بسرعة أو حزم)",
 "安らう": "رَاحَة, اِسْتِرَاحَة / اِسْتَرَاحَ (اِرْتَاح؛ طلب الرَاحَة) / بَاقِيَّة / أَثَارَة\nمثال: عليك أخذ استراحة.",
 "安らか": "سِلْمِيّ / مُسَالِم",
 "安らかにお眠りください": "اُرْقُد فِي سَلَام, اُرْقُد بِسَلَام",
 "安らかにお眠り下さい": "اُرْقُد فِي سَلَام, اُرْقُد بِسَلَام",
 "安らかに眠る": "اُرْقُد فِي سَلَام, اُرْقُد بِسَلَام",
 "安らかに眠れ": "اُرْقُد فِي سَلَام, اُرْقُد بِسَلَام",
 "安らぎ": "سَلَام, هُدُوء (أمان، سِلم، صُلْح؛ السلامةُ والبراءة من العيوبِ) / سَلَام (أمان، سِلم، صُلْح؛ السلامةُ والبراءة من العيوبِ)\nمثال: هن يردن السلام.",
 "安んぞ": "كَيْف, ازاي / كَيْفَ, ازاي / كَمْ, يَا لَ",
 "安ピン": "دَبُّوس مِشْبَك, دَبُّوس أَمَان",
 "安上がり": "رَخِيص",
 "安上り": "رَخِيص",
 "安井": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "安住": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "安佚": "استجمام, استرخاء (التحرر من النشاط (العمل أو الجهد أو المسؤولية)) / بَسَاطَة, سُهُولَة (التحرر من الصعوبة أو المشقة أو الجهد) / أَرِيحِيَّة, بَسَاطَة (التحرر من القيد أو الحرج) / تخفيف, راحة (حالة الارتياح أو التخفيف (خاصة بعد التخلص من الضيق))\nمثال: أخذ قسطاً من الراحة بجانب المسبح",
 "安価": "فِي المُتَنَاوَل, مَيْسُور التَّكْلِفَة (يمكن تحمل تكلفته مالياً) / ضَحِل",
 "安保": "أَمْن, أَمَان (وَثِقَ به وأرْكَنَ إليه) / حِمَايَة / ضَمَانَة, كَفَالَة (وَثِيقَةٌ يَضْمَنُ بِهَا شَخْصٌ شَخْصاً آخَرَ فِي غَرَضٍ مِنْ أَغْرَاضِ البَيْعِ وَقَضَايَا التَّعَامُلِ؛ وَثِيقَةٌ يَضْمَنُ بِهَا ٱلْبَائِعُ سَلاَمَةَ الْمَبِيعِ مِنْ كُلِّ عَيْبٍ وَبَقَاءَهُ صَالِحاً لِلاِسْتِعْمَالِ مُدَّةً مُعَيَّنَةً حَسَبَ…)\nمثال: اتصل زيري بالأمن.",
 "安保理": "مَجْلِس الْأَمْن الْأُمَم الْمُتَّحِدَة",
 "安保理事会": "مَجْلِس الْأَمْن الْأُمَم الْمُتَّحِدَة",
 "安保理決議": "الْأُمَم الْمُتَّحِدَة",
 "安倍": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "安全": "أَمْن, أَمَان (وَثِقَ به وأرْكَنَ إليه)\nمثال: اتصل زيري بالأمن.",
 "安全かみそり": "ماكينة حلاقة آمنة (ماكينة حلاقة مزودة بواقٍ لمنع الجروح العميقة في الجلد)",
 "安全カミソリ": "ماكينة حلاقة آمنة (ماكينة حلاقة مزودة بواقٍ لمنع الجروح العميقة في الجلد)",
 "安全ガラス": "زجاج أمان, زجاج مصفح (زجاج مصنوع بوضع ألواح من البلاستيك أو الراتنج بين لوحين من الزجاج لمنع التحطم)",
 "安全ピン": "دَبُّوس مِشْبَك, دَبُّوس أَمَان",
 "安全ベルト": "حزام أمان, حزام نجاة (حزام يربطك بشيء ما كقيد لمنعك من التعرض للأذى)",
 "安全マッチ": "دفتر كبريت, عواد ثقاب الأمان (عود ثقاب ورقي يشتعل فقط على سطح معد خصيصاً)",
 "安全係数": "عَامِل الأَمَان, عَامِل السَّلَامَة (نسبة إجهاد الكسر للهيكل إلى أقصى إجهاد مقدر في الاستخدام العادي)",
 "安全保護": "أَمْن, أَمَان (وَثِقَ به وأرْكَنَ إليه) / حِمَايَة / ضَمَانَة, كَفَالَة (وَثِيقَةٌ يَضْمَنُ بِهَا شَخْصٌ شَخْصاً آخَرَ فِي غَرَضٍ مِنْ أَغْرَاضِ البَيْعِ وَقَضَايَا التَّعَامُلِ؛ وَثِيقَةٌ يَضْمَنُ بِهَا ٱلْبَائِعُ سَلاَمَةَ الْمَبِيعِ مِنْ كُلِّ عَيْبٍ وَبَقَاءَهُ صَالِحاً لِلاِسْتِعْمَالِ مُدَّةً مُعَيَّنَةً حَسَبَ…)\nمثال: اتصل زيري بالأمن.",
 "安全保護サービス": "إم آي 5, جهاز الأمن (الوكالة الحكومية في المملكة المتحدة المسؤولة عن الأمن الداخلي والاستخبارات المضادة على الأراضي البريطانية)",
 "安全保護付きアクセス管理": "ترجمة آلية (استخدام الحواسيب للترجمة من لغة إلى أخرى) / طن, طن متري (وحدة وزن تعادل 1000 كيلوغرام) / مايتنريوم (عنصر مشع ما بعد اليورانيوم، عدده الذري 109)",
 "安全保障": "أَمْن, أَمَان (وَثِقَ به وأرْكَنَ إليه) / حِمَايَة / ضَمَانَة, كَفَالَة (وَثِيقَةٌ يَضْمَنُ بِهَا شَخْصٌ شَخْصاً آخَرَ فِي غَرَضٍ مِنْ أَغْرَاضِ البَيْعِ وَقَضَايَا التَّعَامُلِ؛ وَثِيقَةٌ يَضْمَنُ بِهَا ٱلْبَائِعُ سَلاَمَةَ الْمَبِيعِ مِنْ كُلِّ عَيْبٍ وَبَقَاءَهُ صَالِحاً لِلاِسْتِعْمَالِ مُدَّةً مُعَيَّنَةً حَسَبَ…)\nمثال: اتصل زيري بالأمن.",
 "安全保障会議": "مجلس الأمن (مجلس دائم للأمم المتحدة؛ مسؤول عن حفظ السلام العالمي)",
 "安全保障理事会": "مَجْلِس الْأَمْن الْأُمَم الْمُتَّحِدَة",
 "安全剃刀": "ماكينة حلاقة آمنة (ماكينة حلاقة مزودة بواقٍ لمنع الجروح العميقة في الجلد)",
 "安全器": "جهاز أمان, واقي (جهاز مصمم لمنع الإصابة أو الحوادث)",
 "安全圏": "جزيرة مرورية (منطقة محددة في الطريق يُمنع مرور السيارات فيها؛ توفر منطقة آمنة للمشاة)",
 "安全地帯": "جزيرة مرورية (منطقة محددة في الطريق يُمنع مرور السيارات فيها؛ توفر منطقة آمنة للمشاة)",
 "安全域": "هامش الأمان, هامش الخطأ (الهامش المطلوب لضمان السلامة)\nمثال: في الهندسة، هامش الأمان هو قوة المادة مطروحاً منها الإجهاد المتوقع",
 "安全帯": "حزام أمان, حزام نجاة (حزام يربطك بشيء ما كقيد لمنعك من التعرض للأذى)",
 "安全帽": "خوذة التصادم, خوذة واقية (خوذة مبطنة يرتديها راكبو الدراجات أو الدراجات النارية؛ تحمي الرأس في حالة الحوادث)",
 "安全弁": "صمام أمان (الصِّمَامُ : السِّدَادُ؛ الصِّمام : جهاز لضبط السوائل والغازات في أَوعيتها وتنظيم انسيابها في اتِّجاه دون آخر)\nمثال: فتح سامر صمام المياه.",
 "安全性": "أَمْن, أَمَان (وَثِقَ به وأرْكَنَ إليه)\nمثال: اتصل زيري بالأمن.",
 "安全期": "فترة الأمان (الوقت خلال الدورة الشهرية للمرأة الذي يكون فيه الحمل أقل احتمالًا للحدوث (عادةً قبل أو بعد الحيض مباشرة))",
 "安全港規定": "ملاذ آمن (استراتيجية دفاعية حيث تستحوذ الشركة المستهدفة على شركة منظمة بشكل صارم مما يجعل الهدف أقل جاذبية)",
 "安全灯": "مصباح الأمان, مصباح ديفي (مصباح زيت لا يشعل الغازات القابلة للاشتعال (الميثان))",
 "安全率": "عَامِل الأَمَان, عَامِل السَّلَامَة (نسبة إجهاد الكسر للهيكل إلى أقصى إجهاد مقدر في الاستخدام العادي)",
 "安全瓣": "صمام أمان (الصِّمَامُ : السِّدَادُ؛ الصِّمام : جهاز لضبط السوائل والغازات في أَوعيتها وتنظيم انسيابها في اتِّجاه دون آخر)\nمثال: فتح سامر صمام المياه.",
 "安全策": "احتراز, تدبير وقائي (إجراء وقائي لدرء خطر وشيك أو ضرر أو إصابة) / احتراز, وقاية (سمة ممارسة الحذر مسبقاً) / احتراس, تروي (التعقل في تجنب الضرر أو الخطر)\nمثال: وضع كيس ثلج على الإصابة كإجراء وقائي",
 "安全網": "شبكة أمان (شبكة قوية كبيرة لالتقاط لاعبي سيرك الأكروبات الذين يسقطون أو يقفزون من الأرجوحة) / شَبَكَة أَمَان (ضمان للأمن المهني أو المالي)",
 "安全装置": "جهاز أمان, واقي (جهاز مصمم لمنع الإصابة أو الحوادث)",
 "安全通行証": "جَوَاز سَفَر, إِجَازَة مُرُور",
 "安南語": "اللغة الفيتنامية (لغة مون-خمير التي يتم التحدث بها في فيتنام) / فيتنامي (مواطن أو ساكن في فيتنام)",
 "安危": "قِسْمَة, مَصِير (في : هو أن أحد العمليات الحسابية الرئيسية، ضد الضَرْب)\nمثال: الزواج قسمة و نصيب.",
 "安原": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "安否": "أَمْن, أَمَان (وَثِقَ به وأرْكَنَ إليه)\nمثال: اتصل زيري بالأمن.",
 "安固": "آمن, مرتاح البال (خالٍ من الخوف أو الشك؛ مرتاح البال) / آمن, محصن (خالٍ من الخطر أو المجازفة) / ثابت, متين (ليس من المحتمل أن يفشل أو ينهار) / آمِن, مَضْمُون (آمن ماليًّا ويمكن الاعتماد عليه)\nمثال: كان مطمئناً بأنه لن يُحاسب على أي شيء",
 "安城": "الحي المالي, السيتي (يستخدم للإشارة إلى صناعة الأوراق المالية في بريطانيا العظمى)",
 "安堵": "رَاحَة, تَخْفِيف / نَقْش نَافِر (لوّن بلونين أو أكثر؛ زيَّن بأشكال أو ألوان)",
 "安孫子": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "安安": "بهدوء (برباطة جأش (خاصة في أوقات التوتر)) / برزانة, بهدوء ووقار (بطريقة رزينة وهادئة)\nمثال: تحدث بهدوء للطلاب المشاغبين",
 "安定": "اِسْتِقْرَار / حَظِيرَة, اِسْطَبْل / زَرِيبَة / ثَابِت (اسم فاعل من ثَبَتَ؛ المُسْتَقِرّ الذي لا يتحرك، ضد المُتَحَرِّك)\nمثال: الشاحنة غير ثابتة.",
 "安定した": "ثابت (اسم فاعل من ثَبَتَ؛ المُسْتَقِرّ الذي لا يتحرك، ضد المُتَحَرِّك)\nمثال: الشاحنة غير ثابتة.",
 "安定剤": "مثبت, موازن (جهاز لجعل شيء ما مستقراً) / مثبت (سطح انسيابي يتكون من جهاز لتثبيت الطائرة) / مادة مثبتة, مثبت (مادة كيميائية تضاف إلى محلول أو خليط أو معلق للحفاظ عليه في حالة مستقرة أو غير متغيرة)",
 "安定化": "استقرار, تثبيت (فعل جعل الشيء مستقراً أو أكثر استقراراً) / تثبيت, موازنة (فعل جعل شيء ما (كسفينة أو طائرة) أقل عرضة للانقلاب)",
 "安定器": "مثبت, موازن (جهاز لجعل شيء ما مستقراً) / مثبت (سطح انسيابي يتكون من جهاز لتثبيت الطائرة) / مادة مثبتة, مثبت (مادة كيميائية تضاف إلى محلول أو خليط أو معلق للحفاظ عليه في حالة مستقرة أو غير متغيرة)",
 "安定大陸": "مِنَصَّة / رَصِيف, مِنَصَّة",
 "安定性": "اِسْتِقْرَار",
 "安定液": "ردغة, ملاط (معلق من جزيئات غير قابلة للذوبان (مثل جبس باريس أو الجير أو الطين وما إلى ذلك) عادة في الماء)",
 "安定的": "حَظِيرَة, اِسْطَبْل / زَرِيبَة / ثَابِت (اسم فاعل من ثَبَتَ؛ المُسْتَقِرّ الذي لا يتحرك، ضد المُتَحَرِّك)\nمثال: الشاحنة غير ثابتة.",
 "安寧": "سَلَام, هُدُوء (أمان، سِلم، صُلْح؛ السلامةُ والبراءة من العيوبِ) / سَلَام (أمان، سِلم، صُلْح؛ السلامةُ والبراءة من العيوبِ)\nمثال: هن يردن السلام.",
 "安居": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "安山岩": "أنديزيت (صخر بركاني رمادي داكن)",
 "安座間": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "安廣": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "安徽": "آنْهُوي, آنْخْوي",
 "安心": "سَكِينَة, طُمَأْنِينَة",
 "安心タオル": "بطانية الأمان (بطانية (أو لعبة) يحملها الطفل معه لتقليل القلق) / مصدر أمان, ملاذ نفسي (أي شيء يستخدمه الشخص البالغ للحد من القلق والتوتر)",
 "安心毛布": "بطانية الأمان (بطانية (أو لعبة) يحملها الطفل معه لتقليل القلق) / مصدر أمان, ملاذ نفسي (أي شيء يستخدمه الشخص البالغ للحد من القلق والتوتر)",
 "安心院": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "安息": "رَاحَة, اِسْتِرَاحَة / اِسْتَرَاحَ (اِرْتَاح؛ طلب الرَاحَة) / بَاقِيَّة / أَثَارَة\nمثال: عليك أخذ استراحة.",
