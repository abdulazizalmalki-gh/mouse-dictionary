 "大島": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "大崎": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "大嶋": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "大嶌": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "大川": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "大州": "قَارَّة",
 "大工": "نَجَّار (صاحب مهنة النِجَارَة أو العامل فيها)",
 "大工仕事": "نِجَارة (مؤنث نَجَّار، التي تعمل بالنجارة)",
 "大師範": "سَيِّد\nمثال: يبدو زيري أحسن.",
 "大幅": "كَبِير, كبير (ضد الصغير؛ العظيم الحَجْم؛ ضد الصغير؛ المتقدم في السِنّ)\nمثال: ذاك البيت كبير.",
 "大幅物": "قماش عريض (قماش حريري أو صناعي منسوج بإحكام مع تضليع عرضي ضيق)",
 "大平": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "大年": "31 ديسمبر, ليلة رأس السنة (اليوم الأخير من السنة) / اَلْمُشْتَرِي (أحد كَوَاكِب المجموعة الشمسية السَّيَّارَة، وهو أكبرها)\nمثال: كوكب المشتري متكون من الغاز.",
 "大広間": "القاعة الكبرى (القاعة الرئيسية في قلعة أو قصر؛ يمكن استخدامها لتناول الطعام أو الترفيه)",
 "大序": "برولوج, فاتحة مسرحية (مقدمة لمسرحية)",
 "大店法": "وَاسِع النِّطَاق (كبير بشكل غير معتاد في النطاق)",
 "大度": "شهامَة",
 "大庭": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "大建築": "بِنَاء, مَبْنَى (ضد هَدْم. ؛ المَبْنَى أو البِنَاية)\nمثال: أنا وجدت البناء.",
 "大廻り": "تحويلة, طريق التفافي (طريق غير مباشر (خاصة الذي يستخدم مؤقتاً أثناء إغلاق الطريق الرئيسي))",
 "大弓": "قَوْس, قوس",
 "大引き": "نجاح مفاجئ (عمل يحقق نجاحاً غير متوقع)\nمثال: كان ذلك الفيلم هو النجاح المفاجئ لهذا الصيف",
 "大引け": "إتمام, إكمال (إجراء ختامي أو نهائي)\nمثال: أسفوا لإغلاق مركز الرعاية النهارية / سعر الإغلاق ((سوق الأسهم) سعر آخر معاملة تمت خلال جلسة تداول اليوم)",
 "大強風": "عاصفة قوية (رياح تتحرك بسرعة 47-54 عقدة؛ 9 على مقياس بوفورت)",
 "大当たり": "بلوك باستر, عمل ضخم النجاح (نجاح غير عادي مع شعبية واسعة ومبيعات ضخمة (خاصة لفيلم أو مسرحية أو تسجيل أو…) / الجَائِزَةُ الكُبْرَى",
 "大当り": "بلوك باستر, عمل ضخم النجاح (نجاح غير عادي مع شعبية واسعة ومبيعات ضخمة (خاصة لفيلم أو مسرحية أو تسجيل أو…) / الجَائِزَةُ الكُبْرَى",
 "大形": "كَبِير, وَاسِع (ضد الصغير؛ العظيم الحَجْم؛ ضد الصغير؛ المتقدم في السِنّ)\nمثال: ذاك البيت كبير.",
 "大後頭孔": "الثقبة العظمى (الفتحة الكبيرة في قاعدة الجمجمة التي يمر من خلالها الحبل الشوكي)",
 "大得意": "مُمْتَاز, فَاخِر",
 "大御": "أَغُسْطُس, آب (الشهر الثامن في السنة الروميّة)\nمثال: غادر فاضل البلد في الثالث و العشرين من أغسطس.",
 "大御宝": "نَاس, خَلْق (اسم للجمع من بني آدم واحده إِنْسَان أو إِنْس)\nمثال: ضحك الناس عليه.",
 "大御所": "إمبراطور مالي, بارون (رجل أعمال ثري جداً أو قوي النفوذ)\nمثال: بارون نفط",
 "大御神": "رَبّ (رَبَّ الولدَ يَرُبُّ رَبًّا: ولِيَه وتعهده بما يغذيه وينميه ويؤدّبه؛ الفاعل:…)\nمثال: اعتني بي يا رب.",
 "大循環": "دَوْرَة دَمَوِيَّة كُبْرَى (في غرب العراق على نهر الفرات قرب الحدود السورية؛ حَيّ في جنوب بغداد تقع فيه…)\nمثال: خضع زيد لدورة مكثفة",
 "大徳": "كَاهِن, قِسِّيس / ثري, غني (شخص يمتلك ثروة مادية كبيرة)",
 "大志": "مَطْمَح",
 "大急ぎ": "اِنْدَفَعَ, أَسْرَعَ",
 "大恐慌": "الْكَسَاد الْعَظِيم",
 "大悟": "تَنْوِير",
 "大患": "مَخَاض",
 "大悪": "بِشَاعَة, قَسْوَة",
 "大悪人": "وَحْش (حَيْوَان غير مستأنس يعيش بعيدا عن الناس، وهي أصل الكلمة؛ حيوان مُفْتَرِس)\nمثال: ضرب زيري الوحش.",
 "大惑星": "كَوْكَب ((علم الفلك) أي من الأجرام السماوية الكبيرة التسعة في النظام الشمسي التي تدور…) / عِمْلَاق غَازِيّ, كَوْكَب غَازِيّ (أي من الكواكب الأربعة الخارجية في النظام الشمسي؛ أكبر بكثير من الأرض وغازي…)",
 "大惚け": "مُغَفَّل, أَحْمَق",
 "大惨事": "كَارِثَة, فَاجِعَة",
 "大意": "مُلَخَّص",
 "大慶": "دَاتْشِينْغ",
 "大憲章": "مَاجْنَا كَارْتَا",
 "大成": "إتمام, إكمال (إجراء ختامي أو نهائي)",
 "大戦": "اَلْحَرْب الْعُظْمَى / حَرْب عَالَمِيَّة, الْحَرْب الْعَالَمِيَّة (حَرَبَ (حربه) بالحربة حربا: طعنه بها؛ حَرَبَ (ه) حربا: سلبه جميع ما يملك)\nمثال: بوتين مجرم حرب.",
 "大戦争": "اَلْحَرْب الْعُظْمَى",
 "大戸": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "大所": "شخصية مؤثرة, شخصية هامة (شخص تؤثر أفعاله وآراؤه بقوة على مسار الأحداث)",
 "大手筋": "وَاسِع النِّطَاق (كبير بشكل غير معتاد في النطاق)",
 "大手術": "جراحة كبرى (أي إجراء جراحي يتضمن التخدير أو المساعدة التنفسية)",
 "大抵": "إلى حد كبير, بشكل رئيسي (في جزء كبير؛ بشكل رئيسي أو أساسي)\nمثال: هذه الحسابات غير نشطة إلى حد كبير / مِن اَلْمُحْتَمَل, رُبَّمَا (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة! / أَكْثَر, أَغْلَب\nمثال: إنها غالية جدا! / عَادِيّ, مَأْلُوف",
 "大括弧": "قوس مربع (إحدى علامتي الترقيم  المستخدمة لتطويق مادة نصية)",
 "大挙": "بالكامل (في إشارة إلى كمية)\nمثال: دُفع المبلغ بالكامل / وَاسِع النِّطَاق (كبير بشكل غير معتاد في النطاق)",
 "大捕り物": "تجميع المشتبه بهم, حملة اعتقالات (التجميع المنهجي للمشتبه بهم من قبل الشرطة)\nمثال: حملة اعتقالات جماعية للمشتبه بهم",
 "大捕物": "تجميع المشتبه بهم, حملة اعتقالات (التجميع المنهجي للمشتبه بهم من قبل الشرطة)\nمثال: حملة اعتقالات جماعية للمشتبه بهم",
 "大掛かり": "وَاسِع النِّطَاق (كبير بشكل غير معتاد في النطاق)",
 "大掴み": "خَشِن (صار خشناً أو غير ناعم؛ أصبح صلباً أو غليظ الملمس)\nمثال: زيري خشن الخلق.",
 "大揺れ": "اِضْطِرَاب",
 "大教室": "صَالَة مُحَاضَرَات (مكان فسيح في وسط المسكن يُوصِلُ إلى سائر الحجرات، الرُدْهَة؛ غُرْفَةُ…)\nمثال: حجزت الصالة يوم الخميس.",
 "大数の法則": "قانون الأعداد الكبيرة ((إحصاء) قانون ينص على أن عددًا كبيرًا من العناصر المأخوذة عشوائيًا من مجتمع…)",
 "大敵": "عَدُوّ لَدُود (ركض أو جري)\nمثال: عدو عدوي صديقي.",
 "大文字": "حَرْف كَبِير (طَرَف وَجَانِب وَحَدّ؛ رَمْز مخطوط أو مطبوع يقوم مقام صوت أو كلمة أو عبارة أو…)\nمثال: ألف هو الحرف الأول للألف باء.",
 "大方": "غَالِبِيَّة, أَغْلَبِيّة / عَامَّة اَلنَّاس / إلى حد كبير, بشكل رئيسي (في جزء كبير؛ بشكل رئيسي أو أساسي)\nمثال: هذه الحسابات غير نشطة إلى حد كبير / مِن اَلْمُحْتَمَل, رُبَّمَا (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "大旆": "رَايَة, عَلَم",
 "大日本": "الْيَابَان (دولة جزرية في شرق قارة آسيا، عاصمتها طوكيو)\nمثال: أنا من اليابان.",
 "大日本豊秋津洲": "هُونْشُو / الْيَابَان (دولة جزرية في شرق قارة آسيا، عاصمتها طوكيو)\nمثال: أنا من اليابان.",
 "大旦那": "حَم (التنور أو الفرن أو الماء: سجر وسخن وأصبح حارّا؛ الأمر: قُضِيَ وتقدر من الله)\nمثال: أفضل لحم البقر. / رَبّ عَمَل, رَبَّة عَمَل (رَبَّ الولدَ يَرُبُّ رَبًّا: ولِيَه وتعهده بما يغذيه وينميه ويؤدّبه؛ الفاعل:…)\nمثال: اعتني بي يا رب.",
 "大時代": "عَفَا عَلَيْه الزَّمَن, قَدِيم الطِّرَاز (خَارِج المُوضَة وَلَمْ يَعُدْ رَائِجًا)",
 "大晦": "31 ديسمبر, ليلة رأس السنة (اليوم الأخير من السنة)",
 "大晦日": "31 ديسمبر, ليلة رأس السنة (اليوم الأخير من السنة)",
 "大智": "حَكِيم, فَطِن (الذي يتصرف دوما بحكمة وتكون الحكمة من صفاته؛ في : هو الطَبِيب)\nمثال: هذه كلمات حكيمة.",
 "大暴れ": "عربدة, هيجان (سلوك عنيف غاضب ومدمر)",
 "大暴落": "غوص, هبوط حاد (هبوط حاد بمقدمة الطائرة للأسفل)\nمثال: شهد السهم هبوطاً حاداً",
 "大月": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
