 "子癇": "ارتعاج, تشنج الحمل (حالة سامة تتميز بتشنجات وربما غيبوبة أثناء الحمل أو بعده مباشرة)",
 "子癇前症": "تسمّم الحمل",
 "子種": "وَلَد, اِبْن (الرجلُ و المرأةُ ومثلهما الانسان: أنجب؛ الرجلُ و المرأةُ وَلَدًا: أنجبه)\nمثال: أعرف ذلك الولد. / نُطْفَة, حَيَوَان مَنَوِيّ (نُطَفْة:خليّة جنسيّة ذكريّة موجودة في المَنيّ، وهي متعددة الأشكال؛ الجمع: نُطْفَ) / نُطْفَة, مَنْي (نُطَفْة:خليّة جنسيّة ذكريّة موجودة في المَنيّ، وهي متعددة الأشكال؛ الجمع: نُطْفَ)",
 "子細": "عَقْل (أمسك بأطرافه وربطه، أصلها للشاة والإبل حيث تربط قوائمها كي تبقى باركة فلا تقوم؛ بلغ العَقْل، أصبح عاقلا فاهما راشدا)\nمثال: هي فتاة تسحر العقل. / تفاصيل, معلومات داخلية (معلومات سرية حقيقية)\nمثال: بعد المحاكمة أعطانا التفاصيل الحقيقية / إعاقة, عرقلة (فعل الإعاقة أو العرقلة أو المنع) / عائق, مانع (أي عائق يعرقل أو يكون مرهقاً) / عائق, عقبة (شيء غير مادي يتداخل مع أو يؤخر العمل أو التقدم)",
 "子細に": "بِالتَّفْصِيل, تَفْصِيلًا",
 "子細に及ばず": "هُنَاكَ, يُوجَدُ",
 "子羊": "حَمَل, خَرُوف (رَفَعَ، أَقَلَّ) / لَحْم اَلضَّأْن, خَرُوف (ما يبقى من جسم الحيوان أو الإنسان بعد إزالة الجلد الأحشاء والعظم والشحم والدم والأعصاب. يتكون أساسا من العَضَلَات؛ ما يؤكل من لحم من الحيوان والطير والسمك عامة)\nمثال: حمل سامي سلاحه.",
 "子育て": "وَالِد (الذي قام بالولادة؛ هو الذكر الذي كان له دور مباشر وعضوي في تكوين الطفل في الجنين؛ الأب الطبيعي) / وَالِدَة (اسم فاعل مؤنث للفعل \"وَلَدَ\"؛ مرادف لـ\"أُمّ\") / وَالِدَان (الشكل المثنى من \"وَالِد\" في حالة الرفع)\nمثال: ألست والدة توم؟",
 "子葉": "فلقة (ورقة جنينية في النباتات البذرية)",
 "子袋": "رَحِم, بَيْت الْوَلِد (رَحِم: عضو تناسلي أنثوي داخلي مستجيب للهرمون الأنثوي في الجهاز التناسلي لدى البشر ومعظم الثدييات الأخرى؛ الجمع: أرحام) / مَنشَأ, رَحِم\nمثال: رحمة الله عليه.",
 "子見出し": "مدخل فرعي (مدخل، مثل مدخل في حساب أو مرجع، يتم تضمينه ضمن مدخل رئيسي)\nمثال: يتم إعطاء الجذر الأوسط لمعظم الأفعال المتعدية كمدخل فرعي (بخط مائل) تحت مدخل الفعل المتعدي (بخط غامق)",
 "子豚": "خِنَّوْص",
 "子音": "صَامِت / حَرْف (طَرَف وَجَانِب وَحَدّ؛ رَمْز مخطوط أو مطبوع يقوم مقام صوت أو كلمة أو عبارة أو معنى)\nمثال: ألف هو الحرف الأول للألف باء.",
 "子音字": "صَامِت / حَرْف (طَرَف وَجَانِب وَحَدّ؛ رَمْز مخطوط أو مطبوع يقوم مقام صوت أو كلمة أو عبارة أو معنى)",
 "子音性": "ساكن, صامت (كونه أو يتميز بـ أو يحتوي على أو يعمل كحرف ساكن) / سكوني, صامت (يتعلق بـ أو له طبيعة الحرف الصامت (الساكن))\nمثال: أصوات ساكنة",
 "子音文字": "أَبْجَد (فِي : نظام ترتيب الأحرف العربي القديم قبل تحويله إلى نظام هجائي. يبدأ بحرف الألف وينتهي بحرف الغين…)",
 "子音群": "اِجْتِمَاع السَّاكِنِين, التَّقَاء السَّاكِنِين (جمعوا انفسهم؛ اسم يطلق على عملية جَمْع بعض الناس في مكان واحد ليتباحثوا أمرا)\nمثال: هذا اجتماع مهم.",
 "子項目": "مدخل فرعي (مدخل، مثل مدخل في حساب أو مرجع، يتم تضمينه ضمن مدخل رئيسي)\nمثال: يتم إعطاء الجذر الأوسط لمعظم الأفعال المتعدية كمدخل فرعي (بخط مائل) تحت مدخل الفعل المتعدي (بخط غامق)",
 "子馬": "فَرَس قَزَم (أقوام تسكن شرق العِرَاق، يقال أنهم أقوام آرِيَّة)\nمثال: الفرس هي أنثى الحصان / مُهْر, فِلْو",
 "子鳩": "زُغْلُول, جَوْزَل",
 "子鴨": "فرخ البط (بطة صغيرة) / لحم بط صغير (لحم صغار البط الداجن)",
 "子鹿": "شَادِن, رِيم / تَزَلَّفَ, تَمَلَّقَ",
 "孑孑": "يرقة البعوض (يرقة البعوض) / كَثِير الْحَرَكَة, مُتَمَلْمِل (شخص لا يستطيع البقاء ساكناً (خاصة الطفل))",
 "孑然": "مَعْزُول, مُنْعَزِل (بَعِيدٌ وَمُنْفَصِلٌ مَادِّيًّا أَوِ اجْتِمَاعِيًّا) / شَارِد, مُنْعَزِل (غَيْرُ مُتَقَارِبٍ فِي الزَّمَن) / مَحْجُور, مَعْزُول (خاضع للعزل الإجباري لا سيما لأسباب صحية) / مُنْعَزِل, مُنْفَرِد (بعيد أو منفصل عن الآخرين؛ يشعر بالانفصال عنهم)",
 "孔": "ثَقْب, حُفْرة (فَجَّرَ أو خَرَقَ شيئًا بفتح فيه؛ نَفَذَ أو مرَّ عبر شيء) / تقب\nمثال: انه ثقب الاسود. / حُفْرَة / جُحْر, سَرَب (معنى الفعل \"جَحَرَ\" متعدد: يدل على دخول الجحر (للضب مثلاً)، أو تأخر وتخلّف (للخير أو الحيوان أو العام -بمعنى قلة مطره-)…؛ يُشيرُ الفعل معانٍ مُتعدِّدة بحسب سياقه، منها: الدخول في شيء (مثل دخول الضبّ جُحْره)، وإدخال شيء في شيء آخر، والارتفاع (كارتفاع الشمس)…)\nمثال: ادخل إلى ذلك الجحر. / عَجْز",
 "孔夫子": "كُونْفُوشِيُوس",
 "孔子": "كُونْفُوشِيُوس",
 "孔教": "كُونْفُوشِيَّة, كُونْفُشْيُوسِيَة",
 "孔版": "آلة سحب, ميميوغراف (ناسخة دوارة تستخدم استنسل يتم ضغط الحبر من خلاله)",
 "孔隙率": "مَسَامِّيَّة",
 "孔雀": "طَاوُوس",
 "孔雀座": "طَاوُوس",
 "孔雀石": "دَهْنَج",
 "孔雀草": "آذَرْيُون, كَحْلَاء / قَطِيفَة, آذَرْيُون",
 "孔雀蝶": "فراشة الطاووس (فراشة أوروبية لها أجنحة بنية محمرة كل منها معلم ببقعة عينية أرجوانية)",
 "孕ませ": "تَلْقِيح",
 "孕み": "حَبَل, حَمْل ((حَبَلَه): شَدّه بالحبْل؛ (حَبَلَه) الصَّيْدَ: نَصَب لَهُ الحِبَالةَ وصاده بهَا. وَيُقَال: حَبَلَت فُلَانَةُ فلَانًا: أوقعَتْه فِي شِباك حُبّها وسحَرته)\nمثال: حبل الكذب قصير.",
 "孕む": "حَبِلَ ((حَبَلَه): شَدّه بالحبْل؛ (حَبَلَه) الصَّيْدَ: نَصَب لَهُ الحِبَالةَ وصاده بهَا. وَيُقَال: حَبَلَت فُلَانَةُ فلَانًا: أوقعَتْه فِي شِباك حُبّها وسحَرته) / خَرَجَ بِ (اِنْتَقَلَ إلى خارج المكان)\nمثال: حبل الكذب قصير. / اِحْتَوَى, تَضَمَّنَ / اِحْتَوَى",
 "字": "شَخْصِيَّة / خُلْق (أَنْشَأَ، أَوْجَدَ) / حَرْف, رَمْز (طَرَف وَجَانِب وَحَدّ؛ رَمْز مخطوط أو مطبوع يقوم مقام صوت أو كلمة أو عبارة أو معنى) / مِحْرَف\nمثال: زيري سيء الخلق. / خَطّ يَد, خَطّ (كِتَابَة؛ ما يَصِل نقطتين أو أكثر)\nمثال: إرسم خط مستقيم. / لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الدَّلَع (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)\nمثال: في حقيقة الأمر، كان زيري يعرف لقب ريمة.",
 "字下げ": "تحزيز, تسنين (عملية القطع في حافة بشقوق تشبه الأسنان أو شقوق زاوية) / مسافة بادئة (المسافة المتروكة بين الهامش وبداية سطر تمت إزاحته) / تخشّن, تنقر (تشكل نقر صغيرة في سطح ما نتيجة للتآكل) / انبعاج, ثلمة (قطع مقعر في سطح أو حافة (كما في الخط الساحلي))",
 "字体": "نَوْع, نَمَط (صِنْف؛ في : وحدة تصنيفية أقل من الجنس) / طَبَعَ (طَبَعَ الله الخلقَ : أَنشأَهُ؛ طبَعَت الدَّوْلةُ النَّقْد : صاغتْه ونقشته)\nمثال: انه نوع من الفطر.",
 "字句": "ألفاظ, صياغة (الطريقة التي يتم بها التعبير عن شيء ما بالكلمات)",
 "字号": "نُقْطَة (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه) / مَوْقِع (موضع الوُقُوع؛ الموضع الذي حَدَثَ أو يحدث فيه حادث) / أَشَارَ\nمثال: هذه هي نقطة ضعفه.",
 "字幕": "عَنَاوِين فَرْعِيَّة, عُنْوَان فَرْعِيّ / تَرْجَمَة, سَتْرَجَة (شرح الكِتَاب أو توضيحه؛ تحويل الكلام من لغة إلى أخرى كي يفهمه قوم آخرون) / مثال: أنا مدرس للترجمة.",
 "字幕スーパー": "عَنَاوِين فَرْعِيَّة, عُنْوَان فَرْعِيّ / تَرْجَمَة, سَتْرَجَة (شرح الكِتَاب أو توضيحه؛ تحويل الكلام من لغة إلى أخرى كي يفهمه قوم آخرون) / مثال: أنا مدرس للترجمة.",
 "字幕付き": "عَنَاوِين فَرْعِيَّة, عُنْوَان فَرْعِيّ / تَرْجَمَة, سَتْرَجَة (شرح الكِتَاب أو توضيحه؛ تحويل الكلام من لغة إلى أخرى كي يفهمه قوم آخرون) / مثال: أنا مدرس للترجمة.",
 "字引": "قَامُوس (اَلْبَحْر ٱلْعَظِيم، البحْرُ ٱلْكَبِير، ٱلْمُحِيط؛ قَعْر البَحْرِ أو أَعْمَق نقطَة فيه) / مُعْجَم (المُنَقَّط بالسواد؛ أن تلوكه للأكل أو للخبرة) / قاموس (اَلْبَحْر ٱلْعَظِيم، البحْرُ ٱلْكَبِير، ٱلْمُحِيط؛ قَعْر البَحْرِ أو أَعْمَق نقطَة فيه)\nمثال: أي قاموس تعنيه؟",
 "字引き": "قَامُوس (اَلْبَحْر ٱلْعَظِيم، البحْرُ ٱلْكَبِير، ٱلْمُحِيط؛ قَعْر البَحْرِ أو أَعْمَق نقطَة فيه) / مُعْجَم (المُنَقَّط بالسواد؛ أن تلوكه للأكل أو للخبرة) / قاموس (اَلْبَحْر ٱلْعَظِيم، البحْرُ ٱلْكَبِير، ٱلْمُحِيط؛ قَعْر البَحْرِ أو أَعْمَق نقطَة فيه)\nمثال: أي قاموس تعنيه؟",
 "字彙": "قَامُوس (اَلْبَحْر ٱلْعَظِيم، البحْرُ ٱلْكَبِير، ٱلْمُحِيط؛ قَعْر البَحْرِ أو أَعْمَق نقطَة فيه) / مُعْجَم (المُنَقَّط بالسواد؛ أن تلوكه للأكل أو للخبرة) / قاموس (اَلْبَحْر ٱلْعَظِيم، البحْرُ ٱلْكَبِير، ٱلْمُحِيط؛ قَعْر البَحْرِ أو أَعْمَق نقطَة فيه)",
 "字書": "قَامُوس (اَلْبَحْر ٱلْعَظِيم، البحْرُ ٱلْكَبِير، ٱلْمُحِيط؛ قَعْر البَحْرِ أو أَعْمَق نقطَة فيه) / مُعْجَم (المُنَقَّط بالسواد؛ أن تلوكه للأكل أو للخبرة) / قاموس (اَلْبَحْر ٱلْعَظِيم، البحْرُ ٱلْكَبِير، ٱلْمُحِيط؛ قَعْر البَحْرِ أو أَعْمَق نقطَة فيه)\nمثال: أي قاموس تعنيه؟",
 "字林": "حَرْف صِينِيّ, طَابِع صِينِيّ (طَرَف وَجَانِب وَحَدّ؛ رَمْز مخطوط أو مطبوع يقوم مقام صوت أو كلمة أو عبارة أو معنى)",
 "字母": "حَرْف, حرف (طَرَف وَجَانِب وَحَدّ؛ رَمْز مخطوط أو مطبوع يقوم مقام صوت أو كلمة أو عبارة أو معنى) / رِسَالَة, مَكْتُوب\nمثال: ألف هو الحرف الأول للألف باء. / مَصْفُوفَة",
 "字消し": "مِمْحَاة",
 "字源": "حَرْف صِينِيّ, طَابِع صِينِيّ (طَرَف وَجَانِب وَحَدّ؛ رَمْز مخطوط أو مطبوع يقوم مقام صوت أو كلمة أو عبارة أو معنى)\nمثال: ألف هو الحرف الأول للألف باء.",
 "字画": "سكتة دِمَاغِيَّة / لَاطَفَ / مَلَّسَ",
 "字素": "حرف, رمز كتابي (رمز مكتوب يُستخدم لتمثيل الكلام)",
 "字義どおり": "لَفْظِيّ, حَرْفِيّ",
 "字義通り": "لَفْظِيّ, حَرْفِيّ",
 "字華": "لعبة حظ, لعبة قمار (لعبة تنطوي على المقامرة)",
 "字訳": "نَقْحَرَة, كَرْشَنَة (مصدر للفعل \"نَقْحَرَ\"؛ (في اللسانيات) كتابة لغة ما بحروفٍ تُستعمل لكتابة غيرها)",
 "字送り": "عودة الحاملة (العملية التي تمهد لطباعة أو عرض الحرف التالي كأول حرف في السطر)",
 "字面": "وَجْه, مُحَيًّا (الإِنْسَان: هو مقدم رأسه الذي يُوَجِهَهُ إلى الناس؛ ضد الظَهْر، ما يقع في المقدمة أو ما يوَجَه إلى الناس) / مَظْهَر (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / وَاجَهَ (تَقَابَلَ معه وَجها لوجه؛ الجندي العدو: استقبله مواجهة ليقاتله أو يناضل ضده)\nمثال: تبدو شاحب الوجه.",
 "存じ": "مُطَّلِع, وَاسِعُ الثَّقَافَة (على درجة عالية من التعليم؛ ذو معلومات أو فهم واسع) / خَبِير, عَارِف (يدل على امتلاك معلومات داخلية أو سرية) / مُدْرِك, وَاسِعُ الِاطِّلَاع (يقظ ومُلِمّ إلمامًا تامًّا) / مَقْصُود, مُتَعَمَّد (يتّسم بالتصميم الواعي والغرض المحدد)",
 "存じあげる": "عَلِمَ, عَرَفَ (أَدْرَكَ حقيقة الشيء) / دَرَى, عَرَفَ (عَلِمَ وعَرَفَ)\nمثال: أدرس علم النفس. / فَكَرَ, فَكَّرَ (أَعْمَلَ عقله ليصل إلى شيءٍ، ليحل مشكلةً. (يتعدى تعدية عامة بفي)) / فَكَّرَ (أَعْمَلَ عقله ليصل إلى شيءٍ، ليحل مشكلةً. (يتعدى تعدية عامة بفي)) / ظَنَّ (عَلِمَ بغير يقين؛ عَلِمَ بيقين)\nمثال: إنها فكرة جيدة.",
 "存じる": "عَلِمَ, عَرَفَ (أَدْرَكَ حقيقة الشيء) / دَرَى, عَرَفَ (عَلِمَ وعَرَفَ)\nمثال: أدرس علم النفس. / فَكَرَ, فَكَّرَ (أَعْمَلَ عقله ليصل إلى شيءٍ، ليحل مشكلةً. (يتعدى تعدية عامة بفي)) / فَكَّرَ (أَعْمَلَ عقله ليصل إلى شيءٍ، ليحل مشكلةً. (يتعدى تعدية عامة بفي)) / ظَنَّ (عَلِمَ بغير يقين؛ عَلِمَ بيقين)\nمثال: إنها فكرة جيدة.",
 "存じ上げる": "عَلِمَ, عَرَفَ (أَدْرَكَ حقيقة الشيء) / دَرَى, عَرَفَ (عَلِمَ وعَرَفَ)\nمثال: أدرس علم النفس. / فَكَرَ, فَكَّرَ (أَعْمَلَ عقله ليصل إلى شيءٍ، ليحل مشكلةً. (يتعدى تعدية عامة بفي)) / فَكَّرَ (أَعْمَلَ عقله ليصل إلى شيءٍ، ليحل مشكلةً. (يتعدى تعدية عامة بفي)) / ظَنَّ (عَلِمَ بغير يقين؛ عَلِمَ بيقين)\nمثال: إنها فكرة جيدة.",
 "存する": "وُجِدَ (أَدْرَكَ المطلوب، أَدْرَكَ الشيء الذي أَرَادَهُ وبَحَثَ عنه؛ غَضِبَ عليه. (يتعدى بعلى))\nمثال: وجد ياني هاتفه. / تَكَوَّنَ / تَأَلَّفَ (فعل مطاوعة من ألَّفَ؛ من كذا: تكّون من هذه الأجزاء، يستخدم للأجزاء الغير منفصلة والتي يكون مجموعها هو الشيء المتألف) / أَبْقَى / أَدَامَ / بَقَّى / حَفِظَ (الحِفْظُ نَقِيضُ النِّسْيَان، وهو التَّعَاهُدُ وقِلَّةُ الغَفْلَةِ؛ قِلَّةُ الغَفْلَةِ) / رَعَى / صانَ\nمثال: حفظ رقم هاتفها.",
 "存ずる": "عَلِمَ, عَرَفَ (أَدْرَكَ حقيقة الشيء) / دَرَى, عَرَفَ (عَلِمَ وعَرَفَ)\nمثال: أدرس علم النفس. / فَكَرَ, فَكَّرَ (أَعْمَلَ عقله ليصل إلى شيءٍ، ليحل مشكلةً. (يتعدى تعدية عامة بفي)) / فَكَّرَ (أَعْمَلَ عقله ليصل إلى شيءٍ، ليحل مشكلةً. (يتعدى تعدية عامة بفي)) / ظَنَّ (عَلِمَ بغير يقين؛ عَلِمَ بيقين)\nمثال: إنها فكرة جيدة.",
 "存亡": "وُجُود, كَيْنُونَة (خِلاف العَدَم، وهي الحالة التي يكون الشيء أو الأمر أو الشخص فيها كَائِن ومَوْجُوْد؛ الوجود يقصد به كل ما هو كائن وموجود في الكَوْن)\nمثال: لا وجود للصدف !",
 "存亡の危機": "حَيَاتِيّ, مَصِيرِيّ (بالغ الأهمية على نحو حيوي)",
 "存分": "بحرية (بطريقة حرة)\nمثال: تتميز اللوحة بضربات فرشاة حرة",
 "存分に": "بحرية (بطريقة حرة)\nمثال: تتميز اللوحة بضربات فرشاة حرة",
 "存在": "وُجُود, كَيْنُونَة (خِلاف العَدَم، وهي الحالة التي يكون الشيء أو الأمر أو الشخص فيها كَائِن ومَوْجُوْد؛ الوجود يقصد به كل ما هو كائن وموجود في الكَوْن)\nمثال: لا وجود للصدف !",
 "存在価値": "سَبَب الْوُجُود ((سَبَّبَه): أَكثر سَبَّه؛ (سَبَّبَ) الأسبَاب: أوجدها)\nمثال: سامي كان السبب.",
 "存在意義": "سَبَب الْوُجُود ((سَبَّبَه): أَكثر سَبَّه؛ (سَبَّبَ) الأسبَاب: أوجدها)\nمثال: سامي كان السبب.",
 "存在感": "حُضُور (حُضُور)\nمثال: الحضور هام جدا.",
 "存在理由": "سَبَب الْوُجُود ((سَبَّبَه): أَكثر سَبَّه؛ (سَبَّبَ) الأسبَاب: أوجدها)\nمثال: سامي كان السبب.",
 "存在者": "إِن (يفيد التوكيد)\nمثال: إن شاء الله ؛",
 "存在論": "أُنْطُولُوجِيَّا, عِلْم الْوُجُود",
 "存在量": "كَثْرَة, غَزَارَة / جَرْد, خَزِين (جَرَدَ الشيءَ: أحصى ما فيه، ضبط قيمته؛ جَرَدَ البطاطسَ: قشّرها وأزال ما عليها) / مَخْزُون / مَرَقَة, حَسَاء (الطَعَام السائل الخفيف فيه ماء اللحم وقد يكون فيه خضار أو غير ذلك. يؤكل عادة مع الرز أو الخبز. يجوز قول مَرَق، والمَرَقَة أخص من المرَق) / مَنْثُور / قَنْدَاق\nمثال: كان سامي جرد طفل.",
 "存外": "بالصدفة, عرضياً (بدون تخطيط مسبق) / بشكل غير متوقع, فجأة (بطريقة لم تكن متوقعة)\nمثال: التقيا بالصدفة",
 "存廃": "وُجُود, كَيْنُونَة (خِلاف العَدَم، وهي الحالة التي يكون الشيء أو الأمر أو الشخص فيها كَائِن ومَوْجُوْد؛ الوجود يقصد به كل ما هو كائن وموجود في الكَوْن)\nمثال: لا وجود للصدف !",
 "存念": "رَأْي, نَظَر",
 "存意": "فِكْر, فِكْرَة (أَعْمَلَ عقله ليصل إلى شيءٍ، ليحل مشكلةً. (يتعدى تعدية عامة بفي)) / فِكْر, تَفْكِير (أَعْمَلَ عقله ليصل إلى شيءٍ، ليحل مشكلةً. (يتعدى تعدية عامة بفي))\nمثال: إنها فكرة جيدة.",
 "存知": "مُطَّلِع, وَاسِعُ الثَّقَافَة (على درجة عالية من التعليم؛ ذو معلومات أو فهم واسع) / خَبِير, عَارِف (يدل على امتلاك معلومات داخلية أو سرية) / مُدْرِك, وَاسِعُ الِاطِّلَاع (يقظ ومُلِمّ إلمامًا تامًّا) / مَقْصُود, مُتَعَمَّد (يتّسم بالتصميم الواعي والغرض المحدد)",
 "存立": "وُجُود, كَيْنُونَة (خِلاف العَدَم، وهي الحالة التي يكون الشيء أو الأمر أو الشخص فيها كَائِن ومَوْجُوْد؛ الوجود يقصد به كل ما هو كائن وموجود في الكَوْن)\nمثال: لا وجود للصدف !",
 "存続": "استمرار, مواصلة (فعل الاستمرار في نشاط ما دون انقطاع) / استمرار, مدة (خاصية البقاء أو الاستمرار في الزمن) / استمرارية, فترة بقاء (الفترة الزمنية التي يستمر خلالها شيء ما)",
 "存置": "حَافَظَ",
 "孜々": "بِدَأْب, بِمُوَاظَبَة (بعناية ومثابرة)\nمثال: عملت بمواظبة على أطروحة التخرج",
 "孜々として": "بِدَأْب, بِمُوَاظَبَة (بعناية ومثابرة)\nمثال: عملت بمواظبة على أطروحة التخرج",
 "孜々営々": "بِدَأْب, بِمُوَاظَبَة (بعناية ومثابرة)\nمثال: عملت بمواظبة على أطروحة التخرج",
 "孜孜": "بِدَأْب, بِمُوَاظَبَة (بعناية ومثابرة)\nمثال: عملت بمواظبة على أطروحة التخرج",
 "孜孜として": "بِدَأْب, بِمُوَاظَبَة (بعناية ومثابرة)\nمثال: عملت بمواظبة على أطروحة التخرج",
 "孜孜営営": "بِدَأْب, بِمُوَاظَبَة (بعناية ومثابرة)\nمثال: عملت بمواظبة على أطروحة التخرج",
 "孝": "بِرّ اَلْوَالِدَيْن (أحسن إلى والديه أو إلى غيره بالخير والاحترام؛ صدق أو وفى بوعد أو عهد)\nمثال: دخل زيري إلى منطقة ببر.",
 "孝弟": "بِرّ اَلْوَالِدَيْن (أحسن إلى والديه أو إلى غيره بالخير والاحترام؛ صدق أو وفى بوعد أو عهد)\nمثال: دخل زيري إلى منطقة ببر.",
 "孝悌": "بِرّ اَلْوَالِدَيْن (أحسن إلى والديه أو إلى غيره بالخير والاحترام؛ صدق أو وفى بوعد أو عهد)\nمثال: دخل زيري إلى منطقة ببر.",
 "孝敬": "بِرّ اَلْوَالِدَيْن (أحسن إلى والديه أو إلى غيره بالخير والاحترام؛ صدق أو وفى بوعد أو عهد)\nمثال: دخل زيري إلى منطقة ببر.",
 "孝行": "بِرّ اَلْوَالِدَيْن (أحسن إلى والديه أو إلى غيره بالخير والاحترام؛ صدق أو وفى بوعد أو عهد)\nمثال: دخل زيري إلى منطقة ببر.",
 "孝行芋": "بَطَاطَا حُلْوَة",
 "孝道": "بِرّ اَلْوَالِدَيْن (أحسن إلى والديه أو إلى غيره بالخير والاحترام؛ صدق أو وفى بوعد أو عهد)\nمثال: دخل زيري إلى منطقة ببر.",
 "孝順": "طَاعَة, إِطَاعَة",
 "孝養": "بر الوالدين, واجب الأبناء (واجب الطفل تجاه والديه)",
 "孟浪": "غَيْر مُبَالِي (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "季": "مَوْسِم / مَوْسِم, جُزْء / صَفّ (سَطْر مستقيم؛ مستوى تعليمي)\nمثال: صف كليتي وقلبي‎.",
 "季候": "مَوْسِم / مَوْسِم, جُزْء",
 "季刊誌": "ربع سنوياً, كل ثلاثة أشهر (في فترات كل ثلاثة أشهر) / في أرباع الشعار (في أرباع متقابلة قطرياً من الشعار (في علم الشعارات)) / ربع سنوي (من أو يتعلق بربع (فترة زمنية) أو يتكون منه) / ربع سنوية, فصلية (دورية تصدر كل ربع سنة (أو أربعة أعداد في السنة))\nمثال: الفائدة مركبة ربع سنوياً",
 "季刊雑誌": "ربع سنوياً, كل ثلاثة أشهر (في فترات كل ثلاثة أشهر) / في أرباع الشعار (في أرباع متقابلة قطرياً من الشعار (في علم الشعارات)) / ربع سنوي (من أو يتعلق بربع (فترة زمنية) أو يتكون منه) / ربع سنوية, فصلية (دورية تصدر كل ربع سنة (أو أربعة أعداد في السنة))\nمثال: الفائدة مركبة ربع سنوياً",
 "季房": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "季節": "مَوْسِم / مَوْسِم, جُزْء",
 "季節はずれ": "في غير موسمه (لا يتماشى مع (وعادة ما يكون غير مرغوب فيه لـ) الموسم) / سَيِّئ التَّوْقِيت, فِي غَيْر أَوَانِه (ذو توقيت سيئ أو غير ملائم)\nمثال: عاصفة ثلجية مفاجئة في غير موسمها",
 "季節外れ": "في غير موسمه (لا يتماشى مع (وعادة ما يكون غير مرغوب فيه لـ) الموسم) / سَيِّئ التَّوْقِيت, فِي غَيْر أَوَانِه (ذو توقيت سيئ أو غير ملائم)\nمثال: عاصفة ثلجية مفاجئة في غير موسمها",
 "季節性": "موسمي (يحدث في أو يعتمد على موسم معين) / عامل موسمي (عامل يجد عملاً فقط في مواسم معينة)\nمثال: عمالة موسمية",
 "季節性情動障害": "حَزِين, زعلان / مُحْزِنٌ",
 "季節性感情障害": "حَزِين, زعلان / مُحْزِنٌ",
 "季節性気分障害": "حَزِين, زعلان / مُحْزِنٌ",
 "季節的": "موسمي (يحدث في أو يعتمد على موسم معين) / عامل موسمي (عامل يجد عملاً فقط في مواسم معينة)\nمثال: عمالة موسمية",
 "季節調整": "تعديل موسمي (تعديل إحصائي يتم لاستيعاب التقلبات المتوقعة كدالة لموسم السنة)\nمثال: يجب إجراء التعديلات الموسمية لبدايات الإسكان في منتصف الشتاء",
 "孤": "يَتِيم / يَتِيمَة / عُزْلَة / يَتِيم / يَتِيمَة",
 "孤児": "يَتِيم / يَتِيمَة",
 "孤児院": "دَار الْأَيْتَام, مَيْتَم (المحل يجمع البِنَاء والعَرَصَة. قيل سمي كذلك لدوران الناس به وعليه وحوله. يجمع على دُور؛ المنزل المَبْني. يجمع على دُور)\nمثال: إذهب إلى الدار.",
 "孤独": "عُزْلَة",
 "孤独感": "اِنْفِرَاد / عُزْلَة / وَحْدَة",
 "孤立": "تَوَحُّد",
 "孤立主義": "اِنْعِزَالِيَّة",
 "孤立化": "تَوَحُّد",
 "孤立感": "تَوَحُّد",
 "孤立概念": "عَزَلَ (فَصَلَ، فرَز، أَبْعَدَ؛ أَبْعَدَ، نَحَّى)\nمثال: جو بايدن طالب الكونغرس بعزل ترامب.",
 "孤立波": "سوليتون, موجة منعزلة ((في الفيزياء) كم من الطاقة أو شبه جسيم يمكن نشره كموجة متنقلة في الأنظمة غير الخطية ولا يسبقه أو يتبعه اضطراب آخر؛ لا يطيع مبدأ التراكب ولا يتبدد)",
 "孤高": "بَعِيدًا عَنّ, بِمَعْزِل عَن",
 "学": "تَعَلُّم (اكتسب معرفة أو خبرة أو مهارة) / دَرْس ((متعدٍّ بنفسه) عَلَّمَ، لَقَّنَ؛ اِمْتَهَنَ التَّعْلِيم)\nمثال: هو سريع التعلم. / ـِيَّات",
