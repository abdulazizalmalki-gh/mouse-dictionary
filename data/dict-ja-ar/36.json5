 "大貫": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "大賀": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "大資本": "كبير رأس المال (لأسهم الشركات التي تبلغ قيمتها السوقية خمسة مليارات دولار أو أكثر)",
 "大赦": "عَفْو",
 "大路": "جَادَّة (الجادّة : وَسَطُ الطَرِيق —حديث؛ جادة : شارع أو طَرِيق رئيس أو الطريق الأعظم الذي يجمع الطُّرق أو الطريق الكبير الذي يجمع كل الطريق)\nمثال: كانت ماري جادة.",
 "大車": "رَاسَن, عِرْق الْجَنَاح",
 "大車輪": "شَامِل, كَامِلُ النِّطَاق (يستخدم جميع الموارد المتاحة)",
 "大軍": "اَلْحَرْب الْعُظْمَى",
 "大転換": "تغير البحر (صَارَ غير ما كان)\nمثال: هل تغير أي شيء؟",
 "大輔": "وكيل وزارة (وزير يتبع مباشرة رئيس قسم حكومي)",
 "大辞典": "قاموس شامل, قاموس غير موجز (قاموس لم يتم تقصيره بحذف المصطلحات أو التعريفات؛ قاموس شامل)",
 "大辟": "إِعْدَام, عُقُوبَة الْإِعْدَام (في القانون: هي عقوبة يحددها القضاء على جريمة كبرى اقترفها المتهم وتؤدي إلى قتل المتهم غالبا بالشنق)\nمثال: محكم عليه بالإعدام.",
 "大農": "وَاسِع النِّطَاق (كبير بشكل غير معتاد في النطاق) / كَبِير المِقْيَاس (مبنيّ أو مرسوم بمقياس كبير)",
 "大農園": "ضيعة, هاديندا (المنزل الرئيسي في مزرعة أو عزبة كبيرة) / ضيعة, هاسيندا (ضيعة كبيرة في البلدان الناطقة بالإسبانية)",
 "大農場": "مزرعة مواشي (مزرعة تتكون من مساحة كبيرة من الأرض مع المرافق اللازمة لتربية الماشية (وخاصة الأبقار))",
 "大迫": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "大迷惑": "الكثير, دفعة (عدد كبير أو كمية أو مدى كبير (وغالباً ما تتبعها كلمة 'من'))\nمثال: دفعة من الرسائل",
 "大逆": "خِيَانَة عُظْمَى",
 "大逆事件": "خِيَانَة عُظْمَى",
 "大逆無道": "شَنِيع, فَاحِش (بَالِغُ الشَّرِّ؛ إِجْرَامِيٌّ فِي أَعْمَاقِه)",
 "大逆罪": "خِيَانَة عُظْمَى",
 "大逆非道": "شَنِيع, فَاحِش (بَالِغُ الشَّرِّ؛ إِجْرَامِيٌّ فِي أَعْمَاقِه)",
 "大通": "جَادَّة (الجادّة : وَسَطُ الطَرِيق —حديث؛ جادة : شارع أو طَرِيق رئيس أو الطريق الأعظم الذي يجمع الطُّرق أو الطريق الكبير الذي يجمع كل الطريق)\nمثال: كانت ماري جادة.",
 "大通り": "جَادَّة (الجادّة : وَسَطُ الطَرِيق —حديث؛ جادة : شارع أو طَرِيق رئيس أو الطريق الأعظم الذي يجمع الطُّرق أو الطريق الكبير الذي يجمع كل الطريق)\nمثال: كانت ماري جادة.",
 "大連": "دَالْيَان",
 "大運動会": "رحلة خلوية, نزهة خلوية (يوم مخصص لتجمع اجتماعي في الهواء الطلق) / يوم حافل, يوم ممتع (وقت من المتعة والنجاح غير المعتاد) / يوم رياضي (يوم للمنافسات الرياضية الخارجية) / يوم مناورات ((عسكرية) يوم للتدريبات والعروض العسكرية)",
 "大過去": "ماضي تام (زمن تام يُستخدم للتعبير عن حدث اكتمل في الماضي)",
 "大道": "جَادَّة (الجادّة : وَسَطُ الطَرِيق —حديث؛ جادة : شارع أو طَرِيق رئيس أو الطريق الأعظم الذي يجمع الطُّرق أو الطريق الكبير الذي يجمع كل الطريق)\nمثال: كانت ماري جادة.",
 "大道具": "إعداد المسرح, ديكور المسرح (ترتيب المناظر والممتلكات لتمثيل المكان الذي تُمثل فيه مسرحية أو فيلم) / عامل مسرح (موظف في المسرح يؤدي الأعمال المتعلقة بإقامة عرض مسرحي)",
 "大道具方": "عامل مسرح (موظف في المسرح يؤدي الأعمال المتعلقة بإقامة عرض مسرحي)",
 "大道商人": "جَوَّال, بَائِع مُتَجَوِّل (صيغة مبالغة على وزن فَعَّال من الفعل جَالَ؛ كثير التجوّل، دائم التنقُّل من مكان لآخر)\nمثال: اشتريت جوال مستعمل.",
 "大選挙区制": "نظام التصويت, نظام انتخابي (نظام قانوني لاتخاذ خيارات ديمقراطية)",
 "大邦": "قوة عالمية, قوة عظمى (دولة قوية بما يكفي للتأثير على الأحداث في جميع أنحاء العالم)",
 "大邱": "دَايْغُو",
 "大邸宅": "قَصْر (ضد الطول؛ غير تام، غير كامل)\nمثال: لقد قصر الخطاب.",
 "大部": "مُتَطَاوِل, مُطَوَّل (طَويل نِسْبِيًّا في المُدَّة؛ مُمْتَدّ بِشَكْل مُمِلّ) / أَكْثَر, أَغْلَب / جِدًّا (كلمة \"جدا\" لها معانٍ متعددة؛ يرتبط المعنى بالعطاء والكرم، سواء بالمنح أو طلبه)\nمثال: إنها غالية جدا!",
 "大部分": "غَالِبِيَّة, أَغْلَبِيّة",
 "大部屋": "غُرْفَةُ الاِنْتِظَار (اسم مفعول لما غُرِفَ من الماء وغيره باليد، الجمع غِرَاف؛ اسم؛ المكان في الدار أو المبنى محاط بأربع جدران وسقف، حُجْرَة، عِلِّيَّة. الجمع وغُرَف وغُرُفَات)\nمثال: الأب في الغرفة. / جناح, عنبر (مبنى يشكل قسماً من مستشفى (أو مجموعة من الغرف) يشترك فيه المرضى الذين يحتاجون إلى نوع مماثل من الرعاية)\nمثال: وضعوها في جناح بأربعة أسرة / إدارَة المشاريع (هو عملية تولي تَصْرِيف شؤون العَمَل. لا جمع له؛ مجموع الناس الذين يقومون بإدارة شؤون الجهة، حكومية كانت أم خاصة)\nمثال: والدتي تنتظرني في الإدارة.",
 "大部隊": "كَتِيبَة (الجيش أو القطعة منه مجتمعة؛ جماعة الخيل إذا أغارت من المائة إلى الأَلف)",
 "大都": "حَاضِرَة (خلاف البَادِيَة، وهي الأرض التي فيها عمران وزرع مثل المدن والقرى والضياع؛ المَدِينَة الكبيرة، العَاصِمَة أو المِصْر. أكثر الاستخدامات شيوعا)\nمثال: الصين حاضرة في إفريقيا.",
 "大都会": "حَاضِرَة (خلاف البَادِيَة، وهي الأرض التي فيها عمران وزرع مثل المدن والقرى والضياع؛ المَدِينَة الكبيرة، العَاصِمَة أو المِصْر. أكثر الاستخدامات شيوعا)\nمثال: الصين حاضرة في إفريقيا.",
 "大都市": "حَاضِرَة (خلاف البَادِيَة، وهي الأرض التي فيها عمران وزرع مثل المدن والقرى والضياع؛ المَدِينَة الكبيرة، العَاصِمَة أو المِصْر. أكثر الاستخدامات شيوعا)\nمثال: الصين حاضرة في إفريقيا.",
 "大都市圏": "مَديِنَةٌ ضَخْمَةٌ",
 "大酒": "خمر مقطر, مشروب روحي (مشروب كحولي يتم تقطيره بدلاً من تخميره)",
 "大酒家": "سكير, شارب الخمر (شخص يشرب المشروبات الكحولية (خاصة بإفراط))",
 "大野": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "大野貝": "محار ناعم الصدفة (محار صالح للأكل بصدفة رقيقة بيضاوية الشكل يوجد في المناطق الساحلية للولايات المتحدة وأوروبا)",
 "大量": "ضَخْم, هائِل الكُتْلَة (ذو كُتْلَة كَبيرَة؛ يَحْتَوي عَلى كَمِّيَّة هائِلَة مِن المادَّة) / صَرْحِيّ, ضَخْم (مهيب في الحجم أو الكتلة أو الصلابة) / هَائِل, وَاسِع (مهيب في النطاق أو المدى أو الدرجة أو القوة) / مُتَجَانِس, مُصْمَت (مؤلَّف من المادّة نفسها في جميع أجزائه)",
 "大量出血": "نَزِيف, نَزْف",
 "大量死": "جموع, حشد (كمية كبيرة غير محددة)\nمثال: حشد من النمل",
 "大量殺人": "قَتْل جَمَاعِيّ (تعمّد جعله يَمُوتُ، أزهق روحه، أمَاتَه متعمدا؛ الوقتَ: ضيعه بشيء غير ذي فائدة وهو ينتظر أمرا آخر)\nمثال: قتل الصياد دبا.",
 "大量殺人者": "قاتل جماعي (شخص مسؤول عن وفاة العديد من الضحايا في حادث واحد)",
 "大量殺害": "مَذْبَحَة, حَمَّام دَمّ (الحَادِثَة أو المَعْرَكَة التي يقتل فيها ناس كثيرون)",
 "大量注文": "مطلب صعب, مهمة شاقة (مهمة أو متطلب هائل)\nمثال: كان الانتهاء في الوقت المحدد مطلباً صعباً لكننا فعلنا ذلك",
 "大量生産": "إنتاج بالجملة, إنتاج ضخم (إنتاج كميات كبيرة من مادة موحدة (غالباً باستخدام تقنيات خط التجميع))",
 "大量発行": "وَاسِع النِّطَاق (كبير بشكل غير معتاد في النطاق) / كَبِير المِقْيَاس (مبنيّ أو مرسوم بمقياس كبير)",
 "大量破壊兵器": "سِلَاح دَمَار شَامِل",
 "大量虐殺": "مَذْبَحَة, مَجْزَرَة (الحَادِثَة أو المَعْرَكَة التي يقتل فيها ناس كثيرون) / قَتَّلَ, ذَبَّحَ (تعمّد جعله يَمُوتُ، أزهق روحه، أمَاتَه متعمدا؛ الوقتَ: ضيعه بشيء غير ذي فائدة وهو ينتظر أمرا آخر)\nمثال: قتل الصياد دبا.",
 "大量送信": "بريد بالجملة (بريد يتكون من أعداد كبيرة من العناصر المتطابقة (منشورات أو إعلانات) ترسل إلى عناوين فردية بأسعار أقل من الدرجة الأولى وتدفع في دفعة واحدة)",
 "大金星": "مُسْتَاء, مُمْتَعِض / إخْلَال / أَسْخَطَ ((أأَسْخَطَه): أغضَبَهُ) / أَخَلَّ ((أَخَلَّ): رعت إبله الخلة؛ (أَخَلَّ) بالمكان وبمركزه وغيره: غاب عنه وتركه)",
 "大金鶏菊": "أشرفية, بذر القراد",
 "大釘": "سنبلة",
 "大釜": "قِدْر (قضاء الله وحكمه وما قَدَّرَه؛ مبلغ الشيء وكميتّه، بنفس معنى قَدْر)\nمثال: خذ قدر ما تريد.",
 "大鋸屑": "نُشَارَة",
 "大鍋": "قِدْر (قضاء الله وحكمه وما قَدَّرَه؛ مبلغ الشيء وكميتّه، بنفس معنى قَدْر)\nمثال: خذ قدر ما تريد.",
 "大鎌": "مِنْجَل, مِقْضَب",
 "大鎧": "شَبِيهٌ بِالصُّنْدُوقِ, صُنْدُوقِيّ (يشبه الصندوق في استطالته)",
 "大鑑": "مَوْسُوعَة, دَائِرَة مَعَارِف (مُعْجَمٌ ضَخْمٌ يَضُمُّ مَعْلُومَاتٍ وَافِيَةً ومُرَكَّزَةً عَنِ الْمَعَارِفِ الإِنْسَانِيَّةِ مُرَتَّبَةً تَرْتِيباً أَبَجَدِيّاً أَوْ حَسَبَ…)\nمثال: موسوعة رحلات العرب والمسلمين.",
 "大間違い": "خطأ فادح, زلة (خطأ محرج)",
 "大関": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "大阪": "أُوسَاكَا",
 "大阪民国": "أُوسَاكَا",
 "大降り": "عَاصِفَة / طُوفَان (عاصفة) / عَاصْفة",
 "大陪審": "هيئة محلفين كبرى (هيئة محلفين للتحقيق في اتهامات الجريمة وتقييم الأسس لتوجيه الاتهامات)",
 "大陰唇": "الشفران الكبيران (الطيتان الخارجيتان للفرج)",
 "大陸": "قَارَّة",
 "大陸会議": "الكُونْغَرِس القَارِّيّ (الجمعية التشريعية المكونة من مندوبين من المستعمرات المتمردة الذين اجتمعوا خلال وبعد الثورة الأمريكية؛ أصدروا إعلان الاستقلال وصاغوا مواد الكونفدرالية)",
 "大陸塊": "كراتون, كُتْلَة قَارِّيَّة (الجزء المستقر من القارة الذي يشكل الكتلة المركزية لها؛ عادة من عصر ما قبل الكمبري)",
 "大陸性": "قَارِّيّ",
 "大陸棚": "رصيف قاري (قاع البحر الضحل نسبياً (حتى 200 متر) المحيط بالقارة)",
 "大陸横断": "عَابِر لِلْقَارَّة (يمتد عبر القارة أو يعبرها أو يقع على الجانب الآخر منها)",
 "大陸法": "قَانُون مَدَنِيّ (مقياس كل شيء وطريقه؛ أمر كليّ ينطبق على جميع جزئياته التي تعرف أحكامها منه)\nمثال: ذكرني بالقانون.",
 "大陸狼": "ذئب الغياض, ذئب رمادي (ذئب ذو معطف رمادي مبقع يعيش في المناطق الشمالية المشجرة في أمريكا الشمالية)",
 "大陸的": "قَارِّيّ / هَادِئ / طَمْأَنَ",
 "大陸間弾道ミサイル": "صاروخ باليستي عابر للقارات (صاروخ باليستي قادر على السفر من قارة إلى أخرى)",
 "大陸間弾道弾": "صاروخ باليستي عابر للقارات (صاروخ باليستي قادر على السفر من قارة إلى أخرى)",
 "大隈": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "大隊": "كَتِيبَة (الجيش أو القطعة منه مجتمعة؛ جماعة الخيل إذا أغارت من المائة إلى الأَلف)",
 "大雑把": "خَشِن (صار خشناً أو غير ناعم؛ أصبح صلباً أو غليظ الملمس)\nمثال: زيري خشن الخلق. / غَيْر مُبَالِي (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "大難": "بَلَاء, بُؤْس",
 "大雨": "وَابِل, مَطَر غَزِير",
 "大静脈": "وريد أجوف (أي من وريدين كبيرين يعيدان الدم المستنفد للأكسجين إلى الأذين الأيمن للقلب)",
 "大韓民国": "جُمْهُورِيَة كُورِيَا",
 "大韓民国国軍": "جُمْهُورِيَة كُورِيَا",
 "大領": "رقعة, وصلة تقوية (قطعة من المادة تستخدم لتقوية أو توسيع الثوب) / صفيحة تقوية (صفيحة معدنية تستخدم لتقوية الرافدة) / رقعة زردية, وصلة درعية (قطعة من الزرد تغطي مكاناً غير محمي بالدرع الصفائحي)",
 "大頭": "طائر النفخة (طائر أمريكي استوائي بني اللون له رأس كبير بريش منفوش)",
 "大願": "مَطْمَح",
 "大風": "ريح عاتية, عاصفة (رياح قوية تتحرك بسرعة 45-90 عقدة؛ قوة 7 إلى 10 على مقياس بوفورت) / مُتَكَبِّر, مَغْرُور (شعب مُتكبِّر : مُتعجرف ، شامخ الرأس؛ مُتكَبِّر : فاعل من تَكَبَّر)\nمثال: هو متكبر للغاية. / هَادِئ / طَمْأَنَ",
 "大風呂敷": "عجرفة, غطرسة (تفاخر فارغ ومغرور)",
 "大食": "نَهَم, شَرَه",
 "大食い": "نَهَم, شَرَه / أكول, نهم (شخص ذكر مكرس للأكل والشرب بإفراط)",
 "大食らい": "أَكَّال, شَرَه",
 "大食家": "أكول, نهم (شخص ذكر مكرس للأكل والشرب بإفراط)",
 "大食漢": "أَكَّال, شَرَه",
 "大食細胞": "بَالِعَة, مَاكْرُوفَاج",
 "大騒ぎ": "جلبة, صخب (صيحات عالية ومستمرة من العديد من الناس)\nمثال: تجاهل صخب الحشد",
 "大騒動": "مَعْمَعَة",
 "大高": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "大魚": "رأس كبير, شخصية كبيرة (شخص مؤثر وهام)",
 "大鮃": "هَلْبُوت",
 "大鴉": "غُرَاب / غراب",
 "大鷭": "غُرَّة (بياض في جبهة الفرس فوق العينين أو بينهما وتحت الأذنين. انظر الصورة؛ أول يوم في الشهر، أو ليلة اِسْتِهْلَال القمر)",
 "大鷹": "باز شمالي / صَقَارَة",
 "大鷹狩": "صَقَارَة",
 "大鷹狩り": "صَقَارَة",
 "大鹿": "مُوظ",
 "大麦": "شَعِير",
 "大麦若葉": "شعير الحائط (عشب حولي أوروبي يوجد غالباً كعشبة ضارة في الأراضي المهملة خاصة على طول جوانب الطرق والأسيجة)",
 "大麻": "قِنَّب / قِنَّب هِنْدِيّ",
 "大麻樹脂": "راتنج القنب, قنبين (راتنج يتم الحصول عليه من نبات القنب؛ يعتقد أنه العامل المخدر النشط في الماريجوانا)",
 "大麻草": "قِنَّب",
 "大麻蝿": "ذبابة اللحم (ذبابة تتغذى يرقاتها على الجيف أو لحم الحيوانات الحية)",
 "大麻蠅": "ذبابة اللحم (ذبابة تتغذى يرقاتها على الجيف أو لحم الحيوانات الحية)",
 "大黄": "راوند صيني, راوند كفي (يستخدم منذ فترة طويلة لخصائصه الملينة)",
 "大黒慈姑": "كستناء الماء, كستناء الماء الصينية (سعد صيني ينتج درنات صالحة للأكل على شكل بصيلة)",
 "大黒柱": "الحبل الرئيسي للسارية (الحبل الأمامي الذي يثبت الصاري الرئيسي) / دعامة أساسية, ركيزة (مصدر دعم واستقرار مركزي ومتماسك) / دعامة, ركن أساسي (مؤيد بارز)\nمثال: الإيمان هو ركيزته",
 "天": "سَمَاء, سما / سَمَاء, سَمَاوَات / سَمَاوَات\nمثال: 彼は天を仰いだ。 — نظر إلى السماء. / رَبّ (رَبَّ الولدَ يَرُبُّ رَبًّا: ولِيَه وتعهده بما يغذيه وينميه ويؤدّبه؛ الفاعل: رَابٌّ، والمفعول: مَرْبوبٌ، وربيبٌ)\nمثال: اعتني بي يا رب. / قِمَّة / وَحِيد / عَزْب / أَخْمُص, بَاطِن القَدَم / نَعْل / سَمَك مُوسَى (سَمَك جمع سَمَكَة، كما تجمع سمكة أسماك)\nمثال: سمكة ميناد ماتت",
 "天から降ったか地から湧いたか": "كَأَنَّ, كَأَنَّمَا (يفيد التشبيه)\nمثال: كأن هذه السيارة له.",
 "天が下": "عَلَنِيّ, عَامّ / عُمُومِيّ / عَامَّة, جُمْهُور",
 "天が抜ける": "أَمْطَرَ بِغَزَارَة",
 "天つ": "سَمَاوِيّ",
 "天にも昇る気持ち": "اِبْتِهَاج, نَشْوَة (البَهْجَةُ: الحُسْنُ يُقَال: رَجُلٌ ذُو بَهْجَةٍ؛ وَيُقَال: هُوَ حُسْنُ لَونِ الشيْءِ ونَضَارَتُه، وَقيل: هُوَ فِي النّباتِ النضَارَةُ…؛ (بَهُجَ، ككَرُمَ) بَهْجَةً و (بَهاجَةً) وبَهَجَاناً (فَهُوَ بَهِيجٌ، و) امرأَةٌ بَهِجَةٌ: مُبْتَهِجَةٌ، وَقد بَهُجَتْ بَهْجَةً، و (هِيَ مِبْهَاجٌ)…)",
 "天に召される": "مَاتَ (للحَيّ: فقد الحَيَاة. مصدره مَوتَا ومِيتَة؛ للأرض: ليس فيها شيء حَيّ من النبات أو الحيوان أو الإنسان. مصدره مَوَات) / تُوُفِّيَ / زَهْر اَلطَّاوِلَة, زَهْر اَلنَّرْد ((زَهَرَ) الوجهُ والسراجُ والقمرُ يَزْهُرُ زَهْرًا، وزُهُوراً: تلألأ وأشْرق؛ (زَهَرَ) الشيءُ: صَفا لونُه)\nمثال: إعتقدت أنه مات.",
 "天に向かって唾を吐く": "مَنْ حَفَرَ حُفْرَةً لِأَخِيهِ وَقَعَ فِيهَا (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "天に唾する": "مَنْ حَفَرَ حُفْرَةً لِأَخِيهِ وَقَعَ فِيهَا (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "天の": "سَمَاوِيّ",
 "天の下": "عَلَنِيّ, عَامّ / عُمُومِيّ / عَامَّة, جُمْهُور",
 "天の使い": "مَلَاك / مَلْأَك / مَلَك (لغة في المَالِك، وهو الذي يَمْلِكُ؛ السُلْطَان الحَاكِم الذي يملك الأَرْض والبِلاد)\nمثال: زيري ملك لنفسه.",
 "天の助け": "ضَرْبَة حَظّ (المرة الواحدة من الضَرْب؛ اللطمو أو الدقة أو الصكّة؛ ضربة طبل: دقة واحدة منه) / مُصَادَفَة سَعِيدَة / مِنْحَة إِلٰهِيَّة\nمثال: تلقى مناد ضربة.",
 "天の原": "سَمَاء, سما / سَمَاء, سَمَاوَات / سَمَاوَات",
 "天の声": "بشكل غير رسمي, ليس للنشر (ليس للاقتباس)\nمثال: تحدث للصحفي ليس للنشر",
 "天の川": "دَرْب اَلتَّبَّانَة (الدَّرْبُ: كُلُّ طريقٍ يصلُ بين مكانَيْن. يقال: مَنْ سار على الدَّرب وصل : معناه أنّ المهارة تكتسبُ بالمِران؛ الدَّرْبُ: المَضيقُ في الجبال الْمَضْيَقُ فِي الجَبَلِ)\nمثال: درب على يد خبير.",
 "天の川銀河": "درب التبانة, مجرة درب التبانة (المجرة التي تحتوي على النظام الشمسي؛ تتكون من ملايين النجوم التي يمكن رؤيتها كشريط منتشر من الضوء يمتد عبر سماء الليل)",
 "天の恵": "فضل إلهي, نعمة ((اللاهوت المسيحي) الفضل المجاني وغير المستحق من الله)\nمثال: تتجلى نعمة الله في خلاص الخطاة",
 "天の恵み": "فضل إلهي, نعمة ((اللاهوت المسيحي) الفضل المجاني وغير المستحق من الله)\nمثال: تتجلى نعمة الله في خلاص الخطاة",
 "天の河": "دَرْب اَلتَّبَّانَة (الدَّرْبُ: كُلُّ طريقٍ يصلُ بين مكانَيْن. يقال: مَنْ سار على الدَّرب وصل : معناه أنّ المهارة تكتسبُ بالمِران؛ الدَّرْبُ: المَضيقُ في الجبال الْمَضْيَقُ فِي الجَبَلِ)\nمثال: درب على يد خبير.",
 "天の益人": "نَاس, خَلْق (اسم للجمع من بني آدم واحده إِنْسَان أو إِنْس) / خَلْق, شَعْب (أَنْشَأَ، أَوْجَدَ) / أَهْل (أَهِلَ به يَأْهَلُ أَهَلاً: أنِس، فهو أَهِلٌ) / شَعْب (ما فوق القَبِيلَة ودون الأُمَّة؛ وهو أول طبقات الأنساب إلا أن البعض يضع فوقه الجَذْم والجُمْهُور؛ الناس الذين يسكنون دولة ما وإن لم يكن يربط بينهم نسب. . والعامة قد تقول شَعَب)\nمثال: ضحك الناس عليه.",
 "天の美禄": "كُحُول, مَشْرُوب كُحُولِيّ (سَائِلٌ لاَ لَوْنَ لَهُ، لاَذِعُ الطَّعْمِ، يُسْتَخْرَجُ مِنْ تَخْمِيرِ بَعْضِ الْمَوَادِّ، يُمْزَجُ بِالْمَشْرُوبَاتِ الرُّوحِيَّةِ…)\nمثال: أكره ذوق الكحول.",
 "天の赤道": "الدائرة الاعتدالية, خط الاستواء السماوي (الدائرة العظمى على الكرة السماوية في منتصف المسافة بين القطبين السماويين)",
 "天の邪鬼": "انحراف, شذوذ (الانحراف المتعمد عما هو خير وصواب) / عناد, مخالفة (تمرد متعمد وعنيد ومقاومة للتوجيه أو الانضباط)\nمثال: سيكون هناك دائمًا قلة من الناس يجدون متعة في التنمر والإرهاب بدافع الانحراف",
 "天は自ら助くるものを助く": "اسعى يا عبدي وأنا أسعى معاك",
 "天は自ら助くる者を助く": "اسعى يا عبدي وأنا أسعى معاك",
 "天を仰ぎて唾す": "مَنْ حَفَرَ حُفْرَةً لِأَخِيهِ وَقَعَ فِيهَا (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "天を突く": "فَيَضَان / فَاضَ",
 "天を衝く": "فَيَضَان / فَاضَ",
 "天ん邪鬼": "انحراف, شذوذ (الانحراف المتعمد عما هو خير وصواب) / عناد, مخالفة (تمرد متعمد وعنيد ومقاومة للتوجيه أو الانضباط)\nمثال: سيكون هناك دائمًا قلة من الناس يجدون متعة في التنمر والإرهاب بدافع الانحراف",
 "天パン": "صينية بسكويت, صينية خبز (أداة طهي تتكون من صفيحة معدنية مستطيلة مسطحة تستخدم لخبز البسكويت أو الكعك)",
 "天上": "سَمَاوَات / مَوْت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي) / وَفَاة / هَلَاك / مَنِيَّة / حِمَام (قضاء الموت وقدره؛ جمع حُمَّة وهو قدر الفراق) / موت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي)\nمثال: لا اخاف الموت .",
 "天下": "مُجْتَمَع, جَمَاعَة (قد يقصد به المكان الذي يجتمع فيه الناس؛ مجموعة من الناس من طبقة اجتماعية واحدة تختلط ببعضها ولها ما يميزها عن غيرها من المجموعات البشرية) / جَمْعِيَّة (هَيْئَة أو جهة معينة يجتمع فيها الناس لغَايَة أو هَدَف مشترك لا يستهدف الرِبْح المَادِيّ؛ مؤسسة رِبْحِيَّة إلا أن لها أهداف أخرى في مصلحة المُجْتَمَع) / اِجْتِمَاعِيَّة\nمثال: سامي خطر للمجتمع. / لَا مَثِيلَ لَهُ, لَا نَظِيرَ لَهُ (بارز يفوق أيّ مقارنة؛ فريد لا يُضاهى) / شُوغُون",
 "天下ご免": "مُرَخَّص, مُعْتَمَد (حاصل على موافقة رسمية للعمل)",
 "天下の宝刀": "ورقة حكم, ورقة رابحة (ورقة لعب من النقش الذي تم إعلانه كحكم)\nمثال: آس الحكم هو فائز مؤكد",
 "天下り": "أَمْر (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة) / أَمَرَ (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة)\nمثال: إنه أمر مختلف .",
 "天下一品": "لَا مَثِيلَ لَهُ, لَا نَظِيرَ لَهُ (بارز يفوق أيّ مقارنة؛ فريد لا يُضاهى)",
 "天下分け目": "حَاسِم, مَصِيرِيّ",
 "天下周知": "أمر معروف للجميع, معلومات عامة (أي شيء معروف عموماً للجميع)",
 "天下太平": "مُرْتَاحُ اَلْبَالِ, خَالِي اَلْقَلْبِ",
 "天下御免": "مُرَخَّص, مُعْتَمَد (حاصل على موافقة رسمية للعمل)",
 "天下晴れて": "قَانُونِيّ",
 "天下泰平": "مُرْتَاحُ اَلْبَالِ, خَالِي اَلْقَلْبِ",
 "天下無双": "لَا مَثِيلَ لَهُ, لَا نَظِيرَ لَهُ (بارز يفوق أيّ مقارنة؛ فريد لا يُضاهى)",
 "天下無敵": "لَا مَثِيلَ لَهُ, لَا نَظِيرَ لَهُ (بارز يفوق أيّ مقارنة؛ فريد لا يُضاهى)",
 "天下無比": "لَا مَثِيلَ لَهُ, لَا نَظِيرَ لَهُ (بارز يفوق أيّ مقارنة؛ فريد لا يُضاهى)",
 "天下第一": "بِامْتِيَاز (بدرجة من التميز)\nمثال: هو السياسي النزيه بامتياز",
 "天与": "ضَرْبَة حَظّ (المرة الواحدة من الضَرْب؛ اللطمو أو الدقة أو الصكّة؛ ضربة طبل: دقة واحدة منه) / مُصَادَفَة سَعِيدَة / مِنْحَة إِلٰهِيَّة\nمثال: تلقى مناد ضربة.",
 "天与の資": "ملكة, موهبة (قدرات أو صفات طبيعية)",
 "天主": "رَبّ (رَبَّ الولدَ يَرُبُّ رَبًّا: ولِيَه وتعهده بما يغذيه وينميه ويؤدّبه؛ الفاعل: رَابٌّ، والمفعول: مَرْبوبٌ، وربيبٌ)\nمثال: اعتني بي يا رب.",
 "天主堂": "كَنِيسَة, كَنَائِس (محلّ العبادة عند المسيحيين؛ جماعة المؤمنين بدين المسيح)\nمثال: أين أقرب كنيسة ؟",
 "天主教": "كَاثُولِيكِيَّة, جَاثَلِيقِيَّة",
 "天乃": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "天井": "سَقْف ((سَقَفَ) البيت ونحوه سقفا: عمل له سقفا)\nمثال: نظرت إلى السقف.",
 "天井抜け": "شمروخ, صاروخ ألعاب نارية (يرسل عرضًا للألعاب النارية عاليًا في السماء) / شمروخ, صاروخ (يدفع ضوءاً ساطعاً عالياً في السماء، أو يُستخدم لدفع حبل إنقاذ أو حربة)",
 "天井桟敷": "مَعْرِض, صَالَةُ عَرْض",
 "天井棧敷": "مَعْرِض, صَالَةُ عَرْض",
 "天井知らず": "شمروخ, صاروخ ألعاب نارية (يرسل عرضًا للألعاب النارية عاليًا في السماء) / شمروخ, صاروخ (يدفع ضوءاً ساطعاً عالياً في السماء، أو يُستخدم لدفع حبل إنقاذ أو حربة)",
 "天井裏": "عِلِّيَّة (الغُرْفَة إذا كانت في الطابق الأعلى. استخدام قديم؛ غُرْفَة في أعلى المَنْزِل غالبا ما يكون سقفها منخفضا وتشرف على السَطْح)",
 "天体": "جِرْم سَمَاوِيّ, جِرْم فَلَكِيّ (جَرَم الشَّخْصُ: أَذْنَبَ وَاكتَسَبَ الإِثْمَ؛ جَرَم نفسَه / جَرَم قومَه / جَرَم على / جَرَم على قومه: جَنَى جَنَايَةً)\nمثال: الإهمال هو نوع من الضرر أو الجرم",
 "天体力学": "ميكانيكا سماوية",
 "天体崇拝": "تنجيم, عبادة الكواكب (عبادة الكواكب أو النجوم)",
 "天体暦": "تقويم فلكي, زيج (منشور سنوي يحتوي على جداول فلكية تعطي مواقع الأجرام السماوية على مدار العام)\nمثال: اليوم تقوم أجهزة الكمبيوتر بحساب التقاويم الفلكية",
 "天体望遠鏡": "تلسكوب فلكي, مقرب فلكي (أي تلسكوب مصمم لجمع وتسجيل الإشعاع الكهرومغناطيسي من المصادر الكونية)",
 "天体物理学": "فِزِيَاء الفَلَكِيَّة",
 "天体観測": "تحديق في النجوم (مراقبة النجوم)",
 "天使": "مَلَاك / مَلْأَك / مَلَك (لغة في المَالِك، وهو الذي يَمْلِكُ؛ السُلْطَان الحَاكِم الذي يملك الأَرْض والبِلاد)\nمثال: زيري ملك لنفسه.",
 "天使の輪": "هَالَة",
 "天候": "طَقْس, جَوّ",
 "天候不順": "طقس سيء, قسوة الطقس (طقس غير مناسب للأنشطة الخارجية)",
 "天分": "مَوْهِبَة",
 "天刑病": "جذام, مرض هانسن (مرض حبيبي مزمن وسار يحدث في المناطق الاستوائية وشبه الاستوائية؛ يتميز بعقيدات ملتهبة تحت الجلد وهزال أجزاء الجسم؛ تسببه عصيات المتفطرة الجذامية)",
 "天則": "شريعة, قانون (قاعدة أو مجموعة قواعد للسلوك متأصلة في الطبيعة البشرية وضرورية أو ملزمة للمجتمع البشري)",
 "天動説": "نموذج مركزية الأرض (اعتقاد بأن الأرض هي مركز الكون ولا تتحرك)",
 "天南": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "天南星": "قلقاس هندي, لوف مبقع (لوف أوروبي شائع ذو قنابة سنانية الشكل وطلع أرجواني قصير؛ يظهر في أوائل الربيع؛ مصدر لنشا يسمى اللوف) / أريسيما, لفت هندي (عشبة غابات أمريكية شائعة تزهر في الربيع ذات أوراق غمدية وطلع منتصب يشبه الهراوة مع قنابة خضراء وأرجوانية متقوسة تنتج توتاً قرمزياً)",
 "天命": "إرادة إلهية, مشيئة الله (القدرة المطلقة لكائن إلهي)",
 "天啓": "وَحْي, تَنْزِيل (الإعلام في الخفاء، وهذا أصل الكلمة؛ الإلهام، سواء كان غريزيّ أو فطريّ أو فنيّ أو غيره وسواء كان من الله أو من غيره)\nمثال: يا رسول الله، كيف يأتيك الوحي ؟",
 "天国": "جَنَّة (أرض محاطة بسُور فيها نخل وشجر وكروم، البُسْتَان؛ الحَدِيقَة أو الحَائِط) / سَمَاوَات / فِرْدَوْس (فردوس)\nمثال: هواوي جنة على الأرض.",
 "天地": "كَوْن, الْكَوْن / بَرّ, أَرْض (أحسن إلى والديه أو إلى غيره بالخير والاحترام؛ صدق أو وفى بوعد أو عهد) / بِلَاد, أَرْض / هَبَطَ\nمثال: دخل زيري إلى منطقة ببر.",
 "天地創造": "خِلْقَة, خَلْق / اِبْتِكَار, خَلْق / خَلْق (أَنْشَأَ، أَوْجَدَ)\nمثال: زيري سيء الخلق.",
 "天地否": "بِي, پِي / ط, بَاي (الحرف السادس عشر في الترتيب الهجائي العربي والتاسع في ترتيب الأبجدية العربية؛ يسبقه \"ض\" ويتبعه \"ظ\"؛ عدد غير نسبي يمثل محيط الدائرة إلى قُطْرِهَا)",
 "天城": "اسم مكان (الاسم الذي يُعرف به مكان جغرافي) / لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "天埜": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "天堂": "جَنَّة (أرض محاطة بسُور فيها نخل وشجر وكروم، البُسْتَان؛ الحَدِيقَة أو الحَائِط) / سَمَاوَات / فِرْدَوْس (فردوس)\nمثال: هواوي جنة على الأرض.",
 "天変地夭": "كارثة طبيعية",
 "天変地妖": "كارثة طبيعية",
 "天変地異": "كارثة طبيعية",
 "天女目": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "天子": "قَيْصَر, إِمْبْرَاطُور",
 "天孫": "قَيْصَر, إِمْبْرَاطُور",
 "天守閣": "اِحْتَفَظَ, أَبْقَى",
 "天宮": "سَمَاء, سما / سَمَاء, سَمَاوَات / سَمَاوَات",
 "天宮図": "خَرِيطَةُ الْبُرُوج, أَبْرَاج (الخَارِطَة، رسم عليه تضاريس الأرض وحدودها)\nمثال: انظر إلى الخريطة.",
 "天山": "بشكل كبير",
 "天山遯": "أَسْمَر رَمَادِيّ (بلون بني رمادي باهت إلى رمادي مائل للبني) / حصان أشهب (حصان ذو لون رمادي بني باهت) / أشهب, بني رمادي (لون أو صبغة تتراوح حول لون بني رمادي فاتح)\nمثال: ارتدت لوناً أشهب",
 "天川": "مَاكَاوْ, أَوْمِين",
 "天帝": "رَبّ (رَبَّ الولدَ يَرُبُّ رَبًّا: ولِيَه وتعهده بما يغذيه وينميه ويؤدّبه؛ الفاعل: رَابٌّ، والمفعول: مَرْبوبٌ، وربيبٌ)\nمثال: اعتني بي يا رب.",
 "天帝星": "الجُدَيّ, نَجْم الشَمَال",
 "天幕": "خَيْمَة (هو البَيْت الذي يقام من أعواد الشَجَر يُلقى عليه نَبَات يستطل به في الحَرّ ويكون مُؤَقَّتا؛ البيت الذي يتخذ من صوف أو قطن أو غيره من النسيج يقوم على عِمَاد أو أكثر. يطلق على الخِبَاء أيضا)\nمثال: سرقت خيمة كارل.",
 "天幕製造人": "صانع خيام (شخص يصنع أو يصلح الخيام)",
 "天幕造り": "صانع خيام (شخص يصنع أو يصلح الخيام)",
 "天底": "نَظِير",
 "天府": "رقاص الساعة, عجلة التوازن (عجلة تنظم معدل الحركة في الآلة؛ وخاصة عجلة تتذبذب مقابل النابض الشعري في الساعة لتنظيم دقاتها)",
 "天心": "سَمْت, ذُرْوَة ((سَمَتَ) سمتا: حسن سمته؛ (سَمَتَ): سار على الطريق بالظن)\nمثال: سمت ابنتها ماري. / بروفيدنس",
 "天性": "طَبِيعَة, طبيعة",
 "天恵": "موارد طبيعية (موارد (فعلية ومحتملة) توفرها الطبيعة)",
 "天意": "بروفيدنس",
 "天成": "طَبِيعَة, طبيعة",
 "天才": "عَبْقَرِيّ, نَابِغَة / عَبْقَرِيَّة",
 "天才児": "طفل عبقري (الصَغِير السِنّ من الحَيْوَان أو الإنْسَان، وَلَد الإنسان أو الحيوان؛ الإنسان منذ أن تلده أمه حتى يَبْلُغ)\nمثال: هو طفل العائلة.",
 "天才的": "موهوب (وهبه الله موهبة أو مواهب)\nمثال: كاتب موهوب",
 "天文": "فَلَك, عِلْم الْفَلَك (التَلّ المستدير من الرَمْل حوله فَضَاء؛ المَدَار يسبح فيه الجُرْم السماويّ)\nمثال: أصبح زيري عالم فلك.",
 "天文単位": "وَحْدَة فَلَكِيَّة",
 "天文台": "مَرْصَد",
 "天文学": "فَلَك, عِلْم الْفَلَك (التَلّ المستدير من الرَمْل حوله فَضَاء؛ المَدَار يسبح فيه الجُرْم السماويّ)\nمثال: أصبح زيري عالم فلك.",
 "天文学的": "فَلَكِيّ",
 "天文学者": "عَالِم فَلَك, فَلَكِي (الذي يعلم؛ متخصص في عِلْم ما وباحث فيه)\nمثال: هو عالم أحيائي.",
 "天文家": "عَالِم فَلَك, فَلَكِي (الذي يعلم؛ متخصص في عِلْم ما وباحث فيه)\nمثال: هو عالم أحيائي.",
 "天文航法": "ملاحة فلكية (الملاحة وفقًا لمواقع النجوم)",
 "天文館": "القبة السماوية, نموذج النظام الشمسي (جهاز أو نموذج لتمثيل الأنظمة الشمسية) / قبة فلكية (جهاز بصري لعرض صور الأجرام السماوية والظواهر الفلكية الأخرى على السطح الداخلي لقبة نصف كروية) / بلانيتاريوم, قبة فلكية (مبنى يضم أداة لعرض مواقع الكواكب على سقف مقبب)",
 "天日": "شَمْس, شمس (الشَّمْسُ: النَّجْمُ الرئيسُ الذي تدور حوله الْأَرْض، وسائر كواكب المجموعة الشمسية؛ الشَّمس: اسم سورة من سور القرآن الكريم، وهي السُّورة رقم 91 في ترتيب المصحف، مكِّيَّة، عدد آياتها خمس عشرة آية) / مثال: نحب غروب الشمس.",
 "天日塩": "مُجَفَّف بِالشَّمْس (مُجَفَّف طَبِيعِيًّا بِأَشِعَّة الشَّمْس)",
 "天日瓦": "مُجَفَّف بِالشَّمْس (مُجَفَّف طَبِيعِيًّا بِأَشِعَّة الشَّمْس)",
 "天明": "فَجْر (هو آخر اللَيْل أو أول النَهَار حين تنصدع الظُلْمَة من النُور) / فَجْر, فَلَق (هو آخر اللَيْل أو أول النَهَار حين تنصدع الظُلْمَة من النُور) / شُرُوق (البُزُوغ، الطُلُوع؛ الوَقْت الذي تَشْرُق فيه الشَمْس) / شُرُوق, مَشْرِق (البُزُوغ، الطُلُوع؛ الوَقْت الذي تَشْرُق فيه الشَمْس)\nمثال: فجر توم البالونة.",
 "天星": "جِرْم سَمَاوِيّ, جِرْم فَلَكِيّ (جَرَم الشَّخْصُ: أَذْنَبَ وَاكتَسَبَ الإِثْمَ؛ جَرَم نفسَه / جَرَم قومَه / جَرَم على / جَرَم على قومه: جَنَى جَنَايَةً)",
 "天本": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "天来": "سَمَاوِيّ",
 "天板": "قِمَّة / صينية بسكويت, صينية خبز (أداة طهي تتكون من صفيحة معدنية مستطيلة مسطحة تستخدم لخبز البسكويت أو الكعك)",
 "天桴": "رقاص الساعة, عجلة التوازن (عجلة تنظم معدل الحركة في الآلة؛ وخاصة عجلة تتذبذب مقابل النابض الشعري في الساعة لتنظيم دقاتها)",
 "天極": "قطب, قطب سماوي (إحدى نقطتي تقاطع محور الأرض والكرة السماوية)",
 "天機": "تخلص, تصريف (فعل أو وسيلة التخلص من شيء ما) / طبع, مزاج (الحالة المزاجية المعتادة) / استعداد, ميل (عادة طبيعية أو مكتسبة أو ميل مميز في شخص أو شيء) / استعداد, ميل (موقف ذهني يميل لتفضيل بديل على آخر)\nمثال: لديه مزاج سعيد",
 "天気": "طَقْس, جَوّ / إشراق, طقس صحو (طقس معتدل؛ مناسب للأنشطة الخارجية)",
 "天気予報": "تَوَقُّع جَوِّيّ, تَوَقُّع طَقْس",
 "天気具合": "أحوال جوية, طقس (الظروف الجوية التي تشكل حالة الغلاف الجوي من حيث درجة الحرارة والرياح والسحب والهطول)\nمثال: كانوا يأملون في طقس جيد",
 "天気図": "خريطة الطقس ((الأرصاد الجوية) خريطة تظهر عناصر الأرصاد الجوية الرئيسية في وقت معين وعلى منطقة ممتدة)",
 "天気模様": "أحوال جوية, طقس (الظروف الجوية التي تشكل حالة الغلاف الجوي من حيث درجة الحرارة والرياح والسحب والهطول)\nمثال: كانوا يأملون في طقس جيد",
 "天気相談所": "مكتب الأرصاد الجوية (وحدة إدارية مسؤولة عن جمع وتفسير بيانات الأرصاد الجوية لدراسة الطقس والتنبؤات)",
 "天気運": "أحوال جوية, طقس (الظروف الجوية التي تشكل حالة الغلاف الجوي من حيث درجة الحرارة والرياح والسحب والهطول)\nمثال: كانوا يأملون في طقس جيد",
 "天気都合": "أحوال جوية, طقس (الظروف الجوية التي تشكل حالة الغلاف الجوي من حيث درجة الحرارة والرياح والسحب والهطول)\nمثال: كانوا يأملون في طقس جيد",
 "天水桶": "برميل مياه الأمطار (برميل يستخدم كصهريج لحفظ مياه الأمطار)",
 "天水訟": "أُغْنِيَّة, أُغْنِيَة (الجمع : أُغْنِيَات و أغانٍ؛ الأُغنيَة المقتسمة : ( الموسيقى ) قطعة موسيقيَّة ذات لفظ مجانس متعلِّق بالكورال في القرن التَّاسع عشر) / غِنَاء (مصدر للفعل \"غَنَّى\"؛ استعمال الصوت البشري لصنع أصوات موسيقية)\nمثال: أنا أغني أغنية.",
 "天河": "دَرْب اَلتَّبَّانَة (الدَّرْبُ: كُلُّ طريقٍ يصلُ بين مكانَيْن. يقال: مَنْ سار على الدَّرب وصل : معناه أنّ المهارة تكتسبُ بالمِران؛ الدَّرْبُ: المَضيقُ في الجبال الْمَضْيَقُ فِي الجَبَلِ)\nمثال: درب على يد خبير.",
 "天津": "تْيَانْجِين",
 "天津御姉": "قَيْصَر, إِمْبْرَاطُور",
 "天津甘栗": "أبو فروة, كستناء أوروبية (برية أو مزروعة في جميع أنحاء جنوب أوروبا وشمال غرب أفريقيا وجنوب غرب آسيا)",
 "天海": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "天涯": "أُفُق ((أَفِقَ) أفَقَاً: بلغ النِّهَايَة فِي الْكَرم وَالْعلم فَهُوَ أفق وأفيق)\nمثال: طلعت الشمس فوق الأفق.",
 "天測航法": "ملاحة فلكية (الملاحة وفقًا لمواقع النجوم)",
 "天漢": "دَرْب اَلتَّبَّانَة (الدَّرْبُ: كُلُّ طريقٍ يصلُ بين مكانَيْن. يقال: مَنْ سار على الدَّرب وصل : معناه أنّ المهارة تكتسبُ بالمِران؛ الدَّرْبُ: المَضيقُ في الجبال الْمَضْيَقُ فِي الجَبَلِ)\nمثال: درب على يد خبير.",
 "天火": "فُرْن, تَنُّور",
 "天災": "كارثة طبيعية",
 "天災地変": "كارثة طبيعية",
 "天為": "رَبَّانِيّ, مِنْ عِنَايَةِ السَّمَاء (مُنَاسِبٌ أَوْ مَحْظُوظٌ بِشَكْلٍ اسْتِثْنَائِيٍّ كَأَنَّمَا بِتَدَخُّلٍ إِلَهِيٍّ) / بِتَدْبير إلَهِيّ, رَبّانِيّ (ناتِج عَن العِنايَة الإلَهِيَّة والتَّدْبير الرَّبّانِيّ) / عنايتي, قدري (يتعلق بالعناية الإلهية أو يميزها)\nمثال: الافتراض بأن الطبيعة تعمل فقط وفقاً لخطة عناية إلهية",
 "天無人": "اِثْنَانِ, اِثْنَتَانِ (في اِثْنان هو رقم مرتبته بين الواحد والثلاثة)",
 "天然": "طَبِيعَة, طبيعة",
 "天然に": "بالطبع, بطبيعة الحال (كما هو متوقع) / طبيعياً (وفقاً للطبيعة؛ بوسائل طبيعية؛ دون مساعدة اصطناعية) / بشكل طبيعي, بطبيعية (بطريقة طبيعية أو عادية) / بالفطرة, بطبعه (من خلال الطبيعة المتأصلة)\nمثال: بطبيعة الحال، أرسل لنا المحامي فاتورة ضخمة",
 "天然ガス": "غَاز طَبِيعِيّ",
 "天然ガラス": "زجاج طبيعي (صهارة بركانية بردت بسرعة كبيرة جداً)",
 "天然ゴム": "مطاط, مطاط طبيعي (مادة مرنة يتم الحصول عليها من عصارة اللاتكس للأشجار (خاصة أشجار جنس الهيفيا والفيكس) والتي يمكن معالجتها بالكبريت وتشطيبها في مجموعة متنوعة من…)",
 "天然型": "طَبِيعِيّ الوُجُود, مَوْجُود بِالطَّبِيعَة (موجود بالطبيعة ودون تدخّل اصطناعي)",
 "天然樹脂": "راتنج طبيعي (إفرازات نباتية)",
 "天然水": "مياه الينابيع (مياه من نبع طبيعي) / مياه جوفية (مياه تحت الأرض محتجزة في التربة وفي الصخور المنفذة)",
 "天然由来": "طَبِيعِيّ الوُجُود, مَوْجُود بِالطَّبِيعَة (موجود بالطبيعة ودون تدخّل اصطناعي)",
 "天然痘": "جُدَرِيّ\nمثال: 今ではみんな天然痘には免疫になっている。 — عند كل الناس مناعةٌ من الجدري اليوم.",
 "天然硝子": "زجاج طبيعي (صهارة بركانية بردت بسرعة كبيرة جداً)",
 "天然繊維": "ألياف طبيعية (ألياف مشتقة من النباتات أو الحيوانات)",
 "天然自然": "طَبِيعِيّ / بالطبع, بطبيعة الحال (كما هو متوقع) / طبيعياً (وفقاً للطبيعة؛ بوسائل طبيعية؛ دون مساعدة اصطناعية) / بشكل طبيعي, بطبيعية (بطريقة طبيعية أو عادية) / بالفطرة, بطبعه (من خلال الطبيعة المتأصلة)\nمثال: بطبيعة الحال، أرسل لنا المحامي فاتورة ضخمة",
 "天然色": "تكنيكولور (طريقة ذات علامة تجارية لصنع صور متحركة ملونة)",
 "天然資源": "موارد طبيعية (موارد (فعلية ومحتملة) توفرها الطبيعة)",
 "天然資源保護論者": "بِيئِيّ, مُدافِع عَن البِيئَة (شخص يعمل لحماية البيئة من الدمار أو التلوث)",
 "天照": "أَمَاتِيرَاسُو",
 "天父": "رَبّ (رَبَّ الولدَ يَرُبُّ رَبًّا: ولِيَه وتعهده بما يغذيه وينميه ويؤدّبه؛ الفاعل: رَابٌّ، والمفعول: مَرْبوبٌ، وربيبٌ)\nمثال: اعتني بي يا رب.",
 "天牛": "خنفساء طويلة القرون (خنفساء طويلة الجسم لها قرون استشعار طويلة جداً)",
 "天狗": "مُتَوَرِّد, مُحْمَرّ ((خاصة للوجه) محمر أو مشبع بالدم من الانفعال أو المجهود) / خَجُول, مُحْمَرُّ الوَجْه (محمرّ الوجه من الحرج أو الخجل أو الانفعال) / تبجح, تفاخر (حالة من الحديث المتباهي)\nمثال: تبجحه أسوأ من قتاله",
 "天狗フルーツ蝙蝠": "خفاش أنبوبي الأنف (أي من خفافيش الفاكهة المتنوعة التي تتميز بفتحات أنف ممتدة إلى أنابيب متباعدة)",
 "天狗俳諧": "لعبة صالون (لعبة مناسبة للعب في الصالون)",
 "天狗巣病": "مكنسة الساحرة (نمو غير طبيعي كثيف (متكتل) للأغصان الصغيرة على شجرة أو شجيرة ناتج عن فطريات أو حشرات أو اضطرابات فسيولوجية أخرى)",
 "天狗猿": "قرد الململة, قرد ذو خرطوم (قرد من بورنيو له أنف بصلي طويل)",
 "天狼": "اَلشِّعْرَى, الشِّعْرَى الْيَمَانِيَّة",
 "天狼星": "اَلشِّعْرَى, الشِّعْرَى الْيَمَانِيَّة",
 "天王山": "حدث مفصلي, علامة بارزة (حدث يمثل تغييراً تاريخياً فريداً أو مهماً في المسار أو تعتمد عليه تطورات مهمة) / حوض النهر, مستجمع مائي (المنطقة الجغرافية الكاملة التي يصرفها النهر وروافده؛ منطقة تتميز بتدفق جميع مياه الجريان السطحي إلى نفس المخرج) / خط تقسيم المياه, مستجمع مائي (حيد من الأرض يفصل بين نظامين نهريين متجاورين)\nمثال: كانت الاتفاقية نقطة تحول في تاريخ كلتا الدولتين",
 "天王星": "أُورَانُوس",
 "天球": "قُبَّة سَمَاوِيَّةٍ",
 "天球儀": "كرة سماوية, مجسم الكرة السماوية (كرة تعد نموذجاً كروياً للسماوات)",
 "天球図": "خَرِيطَةُ الْبُرُوج, أَبْرَاج (الخَارِطَة، رسم عليه تضاريس الأرض وحدودها)\nمثال: انظر إلى الخريطة.",
 "天理": "شريعة, قانون (قاعدة أو مجموعة قواعد للسلوك متأصلة في الطبيعة البشرية وضرورية أو ملزمة للمجتمع البشري)",
 "天瓜粉": "بودرة التلك, تلك (بودرة تجميل مصنوعة من التلك المنقى وعادة ما تكون معطرة؛ تمتص الرطوبة الزائدة)",
 "天生": "طَبِيعِيّ الوُجُود, مَوْجُود بِالطَّبِيعَة (موجود بالطبيعة ودون تدخّل اصطناعي)",
 "天界": "سَمَاوَات",
 "天疱瘡": "فُقَاع (هو الخَمْر إذا أخرج فُقَاعَات)\nمثال: مجرد فقاعة صابون.",
 "天盤": "سَقْف, سَطْح ((سَقَفَ) البيت ونحوه سقفا: عمل له سقفا)\nمثال: نظرت إلى السقف.",
 "天真": "بَسَاطَة, سَذَاجَة (نقص في التطور أو الخبرة الدنيوية)",
 "天真爛漫": "بَرِيء, بَرِيئَة / بَرِيء",
 "天眼通": "إدراك خارج الحواس, استبصار (قوة ظاهرية لإدراك أشياء غير موجودة للحواس)",
 "天眼鏡": "عَدَسَةٌ مُكَبِّرَة",
 "天神髭": "عُثْنُون",
 "天秤": "مِيزَان (آلة تُوزن بها الأشياء ويُعْرف مِقْدارها؛ عَدْل)",
 "天秤にかける": "وَزَنَ",
 "天秤に掛ける": "وَزَنَ",
 "天秤ばかり": "رَصِيد",
 "天秤宮": "بُرْج اَلْمِيزَان, اَلْمِيزَان (ظهر وارتفع)\nمثال: وصل كارل إلى برج آخر.",
 "天秤座": "بُرْج اَلْمِيزَان, اَلْمِيزَان (ظهر وارتفع)\nمثال: وصل كارل إلى برج آخر.",
 "天秤秤": "رَصِيد",
 "天空": "سَمَاء, سما / سَمَاء, سَمَاوَات / سَمَاوَات",
 "天空海濶": "سَمْح, كَرِيم النَّفْس (سخي ومتفهم ومتسامح) / شَهْم, كَرِيم النَّفْس (نبيل وكريم في الروح والطبع)",
 "天空海闊": "سَمْح, كَرِيم النَّفْس (سخي ومتفهم ومتسامح) / شَهْم, كَرِيم النَّفْس (نبيل وكريم في الروح والطبع)",
 "天窓": "فتحة سقف, منور (نافذة في السقف للسماح بدخول ضوء النهار) / رَئِيس, رَئِيسَة / رَئِيس / اِتَّجَهَ",
 "天童": "كَارُوبِيم, شِيرُوبِيم",
 "天竺": "الْهِنْد, الهند (في جنوب قارة آسيا؛ اسمها الرسمي جمهورية الهند، وعاصمتها نيودلهي)\nمثال: يبدو أنك من الهند. / أَجْنَبِيّ / غَرِيب, أَجْنَبِيّ",
 "天竺牡丹": "دَالِيَّا",
 "天竺葵": "غُرْنُوق / جِيرَانِيُوم",
 "天竺鼠": "خِنْزِير غِينِيَّا",
 "天罰": "بلاء, لعنة (شيء يسبب البؤس أو الموت)\nمثال: لعنة حياتي / جزاء عادل, قصاص (نتيجة (جيدة أو سيئة) مستحقة ومناسبة)",
 "天翔ける": "تحليق لأعلى, صعود سريع (فعل الارتفاع لأعلى في الهواء)",
 "天翔る": "تحليق لأعلى, صعود سريع (فعل الارتفاع لأعلى في الهواء)",
 "天職": "رِسَالَة, نداء / حِرْفَة, مِهْنَة",
 "天色": "طَقْس, جَوّ",
 "天花": "ثَلْج (ثلَجتنا السماء: مطَرَتنا، ألقت علينا الثلج؛ ثلَجت نفسي: اشتَفَت به، واطمأنت إليه) / تلج / ثلج (ثلَجتنا السماء: مطَرَتنا، ألقت علينا الثلج؛ ثلَجت نفسي: اشتَفَت به، واطمأنت إليه) / أَثْلَجَ (أثلج يومُنا: دخل في الثلج؛ أثلجت الأرض: أصابها الثلج)\nمثال: سامي يحب الثلج.",
 "天花粉": "بودرة التلك, تلك (بودرة تجميل مصنوعة من التلك المنقى وعادة ما تكون معطرة؛ تمتص الرطوبة الزائدة)",
 "天草": "أغار, أغار أغار (مستخلص غرواني من الطحالب؛ يستخدم خاصة في أوساط الاستنبات وكعامل تبلور في الأطعمة) / آغار, أجار مغذ (أي وسط استنبات يستخدم الآغار كعامل هلامي)",
 "天華": "ثَلْج (ثلَجتنا السماء: مطَرَتنا، ألقت علينا الثلج؛ ثلَجت نفسي: اشتَفَت به، واطمأنت إليه) / تلج / ثلج (ثلَجتنا السماء: مطَرَتنا، ألقت علينا الثلج؛ ثلَجت نفسي: اشتَفَت به، واطمأنت إليه) / أَثْلَجَ (أثلج يومُنا: دخل في الثلج؛ أثلجت الأرض: أصابها الثلج)\nمثال: سامي يحب الثلج.",
 "天蓋": "سقفية, ظلة (غطاء (عادة من القماش) يعمل كسقف لحماية منطقة ما من الطقس) / مظلة (الجزء الذي يشبه المظلة في الباراشوت والذي يمتلئ بالهواء) / قبة الطائرة (الغطاء الشفاف لمقصورة الطائرة)",
 "天蓋つき": "ذُو مِظَلَّة, مُظَلَّل (مغطى بمظلة أو ما يشبهها)",
 "天蓋付き": "ذُو مِظَلَّة, مُظَلَّل (مغطى بمظلة أو ما يشبهها)",
 "天蚕": "بلوط ياباني (شجرة صغيرة دائمة الخضرة من الصين والياباني) / بلوط منغولي, بلوط ياباني (بلوط بخشب ناعم الحبيبات خفيف معتدلاً؛ اليابان)",
 "天蛾": "عثة الصقر (أي من العث المتنوع ذو أجنحة أمامية ضيقة طويلة قادرة على الطيران القوي والتحويم فوق الزهور للتغذية)",
 "天蝎宮": "بُرْج اَلْعَقْرَب, اَلْعَقْرَب (ظهر وارتفع)\nمثال: وصل كارل إلى برج آخر.",
 "天蠍宮": "بُرْج اَلْعَقْرَب, اَلْعَقْرَب (ظهر وارتفع)\nمثال: وصل كارل إلى برج آخر.",
 "天衣無縫": "بِلَا عَيْب, خَالٍ مِنَ العُيُوب (خالٍ من أيّ عيب أو شائبة)",
 "天袋": "مساحة تخزين (المنطقة في أي هيكل توفر مساحة للتخزين)",
 "天警": "رَبَّانِيّ, مِنْ عِنَايَةِ السَّمَاء (مُنَاسِبٌ أَوْ مَحْظُوظٌ بِشَكْلٍ اسْتِثْنَائِيٍّ كَأَنَّمَا بِتَدَخُّلٍ إِلَهِيٍّ)",
 "天象": "طَقْس, جَوّ",
 "天象儀": "القبة السماوية, نموذج النظام الشمسي (جهاز أو نموذج لتمثيل الأنظمة الشمسية) / قبة فلكية (جهاز بصري لعرض صور الأجرام السماوية والظواهر الفلكية الأخرى على السطح الداخلي لقبة نصف كروية) / بلانيتاريوم, قبة فلكية (مبنى يضم أداة لعرض مواقع الكواكب على سقف مقبب)",
 "天資": "طَبِيعَة, طبيعة",
 "天賦": "طَبِيعِيّ",
 "天辺": "قِمَّة / فَرْوَة اَلرَّأْس",
 "天運": "قدر, مصير (حدث (أو مسار أحداث) سيحدث حتماً في المستقبل) / قضاء, قَدَر (القوة النهائية التي يُنظر إليها على أنها تحدد مسار الأحداث مسبقاً) / حظ, قدر (ظروفك العامة أو حالتك في الحياة (بما في ذلك كل ما يحدث لك))\nمثال: نحن عاجزون أمام القدر",
 "天道": "شَمْس, شمس (الشَّمْسُ: النَّجْمُ الرئيسُ الذي تدور حوله الْأَرْض، وسائر كواكب المجموعة الشمسية؛ الشَّمس: اسم سورة من سور القرآن الكريم، وهي السُّورة رقم 91 في ترتيب المصحف، مكِّيَّة، عدد آياتها خمس عشرة آية) / مثال: نحب غروب الشمس.",
 "天道乾": "مُجَفَّف بِالشَّمْس (مُجَفَّف طَبِيعِيًّا بِأَشِعَّة الشَّمْس)",
 "天道干し": "مُجَفَّف بِالشَّمْس (مُجَفَّف طَبِيعِيًّا بِأَشِعَّة الشَّمْس)",
 "天道様": "شَمْس, شمس (الشَّمْسُ: النَّجْمُ الرئيسُ الذي تدور حوله الْأَرْض، وسائر كواكب المجموعة الشمسية؛ الشَّمس: اسم سورة من سور القرآن الكريم، وهي السُّورة رقم 91 في ترتيب المصحف، مكِّيَّة، عدد آياتها خمس عشرة آية) / مثال: نحب غروب الشمس.",
 "天道虫": "خنفساء أبو العيد, دعسوقة (خنفساء صغيرة مستديرة زاهية الألوان ومرقطة تتغذى عادة على المن والآفات الحشرية الأخرى)",
 "天邪鬼": "انحراف, شذوذ (الانحراف المتعمد عما هو خير وصواب) / عناد, مخالفة (تمرد متعمد وعنيد ومقاومة للتوجيه أو الانضباط)\nمثال: سيكون هناك دائمًا قلة من الناس يجدون متعة في التنمر والإرهاب بدافع الانحراف",
 "天野": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "天際": "أُفُق ((أَفِقَ) أفَقَاً: بلغ النِّهَايَة فِي الْكَرم وَالْعلم فَهُوَ أفق وأفيق)\nمثال: طلعت الشمس فوق الأفق.",
 "天雷": "رَعْد, رعد (الصَوْت الذي يصدر حين تفرغ الغَيْمَة شحنة كَهْرَبَائيَّة إلى غَيْمَة أخرى أو إلى الأرْض، ويكون معه بَرْق، وغالبا ما يكون مُصَاحَبا بالمَطَر) / رَعَدَ (الصَوْت الذي يصدر حين تفرغ الغَيْمَة شحنة كَهْرَبَائيَّة إلى غَيْمَة أخرى أو إلى الأرْض، ويكون معه بَرْق، وغالبا ما يكون مُصَاحَبا بالمَطَر)\nمثال: البرق يسبق الرعد",
 "天青石": "سلستيت (معدن يتكون من كبريتات السترونشيوم)",
 "天面": "سطح علوي (الجانب الذي يكون في الأعلى)",
 "天頂": "سَمْت, ذُرْوَة ((سَمَتَ) سمتا: حسن سمته؛ (سَمَتَ): سار على الطريق بالظن)\nمثال: سمت ابنتها ماري.",
 "天頂点": "سَمْت, ذُرْوَة ((سَمَتَ) سمتا: حسن سمته؛ (سَمَتَ): سار على الطريق بالظن)\nمثال: سمت ابنتها ماري.",
 "天香国色": "عُود الصَّلِيب, فَاوَانِيَا (قطعة من الخشب كالعصا جمعه عيدان؛ ما يُتَبَخَّر به)",
 "天馬": "حِصَان مُجَنِّح (الواحد الذكر من الخَيْل؛ يطلق مجازًا على الواحد من الخيل الذي لا يُعرف ذكر كان أم أنثى) / بِيغَاسُوس\nمثال: لم يشفى الحصان.",
 "天馬座": "حِصَان مُجَنِّح (الواحد الذكر من الخَيْل؛ يطلق مجازًا على الواحد من الخيل الذي لا يُعرف ذكر كان أم أنثى) / بِيغَاسُوس\nمثال: لم يشفى الحصان.",
 "天駆ける": "تحليق لأعلى, صعود سريع (فعل الارتفاع لأعلى في الهواء)",
 "天鵝絨": "مُخْمَل, قَطِيفَة",
 "天鵞": "تَمّ, قُقْنُس",
 "天鵞絨": "مُخْمَل, قَطِيفَة",
 "天鼠": "وَطْوَاط, خُفَّاش / مِضْرَب, عَصًا",
 "太": "سَمِين, بَدِين / دُهْن (طلى الشيء بالدهن أو الزيت أو الطيب؛ ضرب بالرفق) / شَحْم\nمثال: توم بدهن غرفته. / جَلِيل, فَخْم (يُوصَف بِهِ مَظْهَر الشَّخْص أَوْ سُلُوكه؛ يَلِيق بِشَخْصٍ بَارِز) / فَخْم, كَبِير (الأكثر أهمّيّة وفخامة في الزخرفة) / طَمُوح, وَاسِع النِّطَاق (من السلوك المُثير للإعجاب والطموح في الحجم أو النطاق) / عَظِيم, فَخْم (كبير ومثير للإعجاب في الحجم المادي أو الامتداد)",
 "太々": "زَوْجَة, اِمْرَأَة",
 "太い": "سَمِين, بَدِين / دُهْن (طلى الشيء بالدهن أو الزيت أو الطيب؛ ضرب بالرفق) / شَحْم\nمثال: توم بدهن غرفته. / عَمِيق, غَوِيط / جَرِيء, جَسُور",
 "太った": "سمين",
 "太っちょ": "دسم, دهني (يحتوي على أو يتكون من الدهون) / بدين, سمين (شخص مستدير الجسم)\nمثال: طعام دسم",
 "太っ腹": "كَرِيم (نبيل النفس عزيزها ذو الخلق العالي والخير الكثير والعطاء السخي. الكَرَم يشمل مجموعة من الأخلاق أهمها العطاء؛ الجَوَاد السخيّ تحديدا)\nمثال: يا لك من رجل كريم!",
 "太ましい": "بَدِين بِلُطْف, مُمْتَلِئ (سَمِين بِمَا يَكْفِي لِيَكُون مُمْتَلِئًا بِشَكْلٍ مُحَبَّب)",
 "太め": "سمين",
 "太もも": "فَخِذ, فَخْذ / أرداف, ألية (الجزء اللحمي من جسم الإنسان الذي يجلس عليه)\nمثال: يستحق ركلة جيدة في مؤخرته",
 "太りぎみ": "سمين",
 "太りじし": "بَدِين جِدًّا, سَمِين مُفْرِطًا (مُفْرِط فِي السِّمْنَة والبَدَانَة)",
 "太りすぎ": "زَائِد الوَزْن, ضَخْم البِنْيَة (يَصِف عَادَةً شَخْصًا كَبِيرًا بَدِينًا لَكِنْ لَه هَيْكَل كَبِير يَحْمِل وَزْنَه) / بدانة, وزن زائد (خاصية السمنة المفرطة)",
 "太り気味": "سمين",
 "太り肉": "بَدِين جِدًّا, سَمِين مُفْرِطًا (مُفْرِط فِي السِّمْنَة والبَدَانَة)",
 "太り過ぎ": "زَائِد الوَزْن, ضَخْم البِنْيَة (يَصِف عَادَةً شَخْصًا كَبِيرًا بَدِينًا لَكِنْ لَه هَيْكَل كَبِير يَحْمِل وَزْنَه) / بدانة, وزن زائد (خاصية السمنة المفرطة)",
 "太る": "اِزْدَادَ وَزْنًا, اِكْتَسَبَ وَزْنًا",
 "太公望": "سمكة الصنارة, سمكة الصياد (أسماك لها أفواه كبيرة مع خيط يشبه الدودة متصل بها لجذب الفريسة) / صياد بالسنارة (صياد يستخدم الخطاف والخيط) / صياد الفرص, مخادع (شخص متآمر؛ شخص يخطط للحصول على ميزة)",
 "太刀": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "太刀さばき": "مبارزة (فعل استخدام السيف (أو سلاح آخر) بقوة ومهارة)",
 "太刀取り": "جَلَّاد",
 "太刀捌き": "مبارزة (فعل استخدام السيف (أو سلاح آخر) بقوة ومهارة)",
 "太刀筋": "مبارزة, مهارة استخدام السيف (المهارة في المبارزة)",
 "太原": "تاي يونا, تاييونا",
 "太后": "إِمْبِرَاطُورَة الأُمّ",
 "太太": "زَوْجَة, اِمْرَأَة",
 "太夫": "عَالِيّ الرُتْبَة",
 "太夫元": "مُدِير, مُدِيرَة (الشخص الذي أدار، جمعه مُدِيرُون ومُدِيرِين؛ مهنة يتولى صاحبها إدَارَة شؤون جهة ما. جمعه مُدَرَاء)\nمثال: زيري هو المدير.",
 "太子": "وَلِيّ عَهْد (مَلَكَ الأمر وقَامَ به وسيطر عليه وولي عليه ولايةَ)\nمثال: ولي العهد هو من يرث العرش.",
 "太字": "بولد, خط عريض (نمط خط ذو خطوط سميكة وثقيلة)",
 "太守": "نَائِب",
 "太安": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "太客": "باذخ, منفق كبير (شخص ينفق ببذخ وتفاخر على الترفيه)\nمثال: آخر المنفقين الكبار",
 "太平": "سَلَام, هُدُوء (أمان، سِلم، صُلْح؛ السلامةُ والبراءة من العيوبِ) / سَلَام (أمان، سِلم، صُلْح؛ السلامةُ والبراءة من العيوبِ)\nمثال: هن يردن السلام. / طَائِش, لَا مُبَالٍ (غير مسؤول بمرح وخِفّة)",
 "太平州": "أُوقِيَانُوسِيَا",
 "太平楽": "طَائِش, لَا مُبَالٍ (غير مسؤول بمرح وخِفّة)",
 "太平洋": "الْمُحِيط الْهَادِئ",
 "太平洋時間": "توقيت المحيط الهادئ (التوقيت القياسي في المنطقة الزمنية الثامنة غرب غرينتش، يحسب عند خط الطول 120 غرباً؛ يستخدم في الولايات الغربية البعيدة بالولايات المتحدة)",
 "太平洋標準時": "توقيت المحيط الهادئ (التوقيت القياسي في المنطقة الزمنية الثامنة غرب غرينتش، يحسب عند خط الطول 120 غرباً؛ يستخدم في الولايات الغربية البعيدة بالولايات المتحدة)",
 "太平洋認定機関協力機構": "لجنة العمل السياسي (لجنة تشكلها مجموعة مصالح خاصة لجمع الأموال لمرشحيها السياسيين المفضلين)",
 "太政官": "وزارة الخارجية, وزارة الخارجية الأمريكية (الإدارة الفيدرالية في الولايات المتحدة التي تضع وتحافظ على السياسات الخارجية)\nمثال: تأسست وزارة الخارجية عام 1789",
 "太文字": "بولد, خط عريض (نمط خط ذو خطوط سميكة وثقيلة)",
 "太朝": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "太木": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "太枘": "مسمار خشبي, وتد (مثبت يتم إدخاله في ثقوب في قطعتين متجاورتين لتثبيتهما معاً)",
 "太極図": "يِين وَيَانْغ",
 "太極拳": "تاي تشي (نظام صيني للتمارين البدنية التأملية البطيئة المصممة للاسترخاء والتوازن والصحة)",
 "太極旗": "علم وطني (شعار يُرفع كرمز للجنسية)",
 "太歳": "اَلْمُشْتَرِي (أحد كَوَاكِب المجموعة الشمسية السَّيَّارَة، وهو أكبرها) / يُوبِيتَر\nمثال: كوكب المشتري متكون من الغاز.",
 "太母": "جَدَّة (هي أم الأب أو أم الأم؛ مدينة في السُعُودِيَّة قرب مَكَّة، قيل أنها سميت هكذا لأن حواء دفنت فيها والله أعلم)\nمثال: كان لزيري جد و جدة.",
 "太物": "ستارة, سِتر (قماش معلق يستخدم كحاجز (خاصة للنافذة)) / قماش الستائر (قماش يتدلى برشاقة ومرتب في طيات فضفاضة)",
 "太田": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "太白": "الزُّهَرَة, فينوس (اسم للكوكب الثاني قربًا من الشَّمْس، وهو كوكب صخريّ يَملك غلافاً جوياً وغيوماً هائلة السّماكة تَمنع أي أشعة ضوء من سطحه من النفاذ وتتسبب بظاهرة…) / فِينُوس\nمثال: أقطف الزهرة بنفسي. / سكر (كربوهيدرات بلورية بيضاء تستخدم كمحلي ومادة حافظة) / أرز أبيض (أرز تمت إزالة القشرة أو الطبقات البنية الخارجية منه)",
 "太白星": "الزُّهَرَة, فينوس (اسم للكوكب الثاني قربًا من الشَّمْس، وهو كوكب صخريّ يَملك غلافاً جوياً وغيوماً هائلة السّماكة تَمنع أي أشعة ضوء من سطحه من النفاذ وتتسبب بظاهرة…) / فِينُوس\nمثال: أقطف الزهرة بنفسي.",
 "太白砂糖": "سكر (كربوهيدرات بلورية بيضاء تستخدم كمحلي ومادة حافظة)",
 "太白飴": "أرز أبيض (أرز تمت إزالة القشرة أو الطبقات البنية الخارجية منه)",
 "太監": "خَصِيّ, مَخْصِيّ",
 "太祖": "مُؤَسِّس, مُؤَسِّسَة",
 "太神楽": "جابونيكا, كاميليا يابانية (شجيرة دفيئة ذات أوراق خضراء لامعة وزهور مبهرجة عطرة تشبه الورد؛ تزرع في العديد من الأصناف)",
 "太線": "تسطير, خط تحتي (خط مرسوم بالأسفل (خاصة تحت مادة مكتوبة))",
 "太股": "فَخِذ, فَخْذ / أرداف, ألية (الجزء اللحمي من جسم الإنسان الذي يجلس عليه)\nمثال: يستحق ركلة جيدة في مؤخرته",
 "太腹": "بَطْن (خلاف الظهر؛ الجزء الباطن من الشيء غير الظاهر؛ الجزء الداخلي من الشيء)\nمثال: عندي بطن الجعة.",
 "太腿": "فَخِذ, فَخْذ / أرداف, ألية (الجزء اللحمي من جسم الإنسان الذي يجلس عليه)\nمثال: يستحق ركلة جيدة في مؤخرته",
 "太蘭鳥": "صائد الذباب (طيور أمريكية كبيرة تصطاد الحشرات عادة أثناء الطيران)",
 "太虚": "سَمَاء, سما / سَمَاء, سَمَاوَات / سَمَاوَات",
 "太記": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "太閤": "وَصِيّ العَرْش (في : في حال وفاة أحد الوالدين، يتم تعيين الوصي بالإتفاق أو بموجب القانون ليكون مسؤولا عن قاصر أو عن إنسان عاجز غير كفء…؛ في : المؤسسة أو الشخص الذي تَثِقُ فيه وَتُأَمِّنُهُ على أموالك وممتلكاتك، وهو الذي يدير أموال الوصية بعد الوفاة)",
 "太陰": "قَمَر, قمر (الكَوْكَب الذي يدور حول الأرْض ويظهر غالبا في الليل ويعكس ضوء الشَمْس. مذكر لا يؤنث؛ أي كوكب يدور حول كوكب آخر، لا يشمل ذلك الكواكب التي تدور حول شُمُوس. مذكر لا يؤنث)\nمثال: ضوء القمر ضعيف.",
 "太陰太陽暦": "تقويم قمري شمسي (تقويم يعتمد على كل من الدورات القمرية والشمسية)",
 "太陰暦": "تقويم قمري شمسي (تقويم يعتمد على كل من الدورات القمرية والشمسية)",
 "太陰月": "شهر قمري (الفترة بين قمرين جديدين متتاليين (29.531 يوماً))\nمثال: 太陰月はカレンダーのひと月より短い。 — الشهر القمري أقصر من الشهر الشمسي.",
 "太陽": "شَمْس, شمس (الشَّمْسُ: النَّجْمُ الرئيسُ الذي تدور حوله الْأَرْض، وسائر كواكب المجموعة الشمسية؛ الشَّمس: اسم سورة من سور القرآن الكريم، وهي السُّورة رقم 91 في ترتيب المصحف، مكِّيَّة، عدد آياتها خمس عشرة آية) / مثال: نحب غروب الشمس.",
 "太陽エネルギー": "طاقة شمسية, قدرة شمسية (طاقة من الشمس يتم تحويلها إلى طاقة حرارية أو كهربائية)\nمثال: يتم تحديد كمية الطاقة الساقطة على الأرض بواسطة الثابت الشمسي، ولكن لم يتم الاستفادة إلا قليلاً جداً من الطاقة الشمسية",
 "太陽フレア": "اِنْفِجَار شَمْسِيّ",
 "太陽儀": "مقياس الشمس (أداة تستخدم لقياس الفصل الزاوي بين نجمين متباعدين جداً بحيث لا يمكن تضمينهما في مجال رؤية تلسكوب عادي)",
 "太陽光": "ضَوْء شَمْس, نُور شَمْس (النُّور؛ مصدر ضَاء)\nمثال: ضوء القمر ضعيف.",
 "太陽光パネル": "بطارية شمسية, مصفوفة شمسية (جهاز كهربائي يتكون من مصفوفة كبيرة من الخلايا الشمسية المتصلة)",
 "太陽光発電": "طاقة شمسية, قدرة شمسية (طاقة من الشمس يتم تحويلها إلى طاقة حرارية أو كهربائية)\nمثال: يتم تحديد كمية الطاقة الساقطة على الأرض بواسطة الثابت الشمسي، ولكن لم يتم الاستفادة إلا قليلاً جداً من الطاقة الشمسية",
 "太陽光線": "ضَوْء شَمْس, نُور شَمْس (النُّور؛ مصدر ضَاء)\nمثال: ضوء القمر ضعيف.",
 "太陽圏": "غلاف شمسي",
 "太陽年": "سنة شمسية, سنة فلكية (الوقت اللازم للأرض لعمل دورة واحدة حول الشمس، مقاسة بين اعتدالين ربيعيين)",
 "太陽放射": "إشعاع شمسي (إشعاع صادر من الشمس)",
 "太陽日": "أربع وعشرون ساعة, يوم (الوقت الذي تستغرقه الأرض للقيام بدورة كاملة حول محورها)\nمثال: غادروا بعد يومين",
 "太陽時": "توقيت شمسي (حساب لمرور الوقت بناءً على موقع الشمس في السماء)",
 "太陽暦": "تقويم شمسي (تقويم يعتمد على الدورات الشمسية)",
 "太陽望遠鏡": "تلسكوب شمسي (تلسكوب مصمم لرصد الشمس)",
 "太陽歯車": "ترس شمسي (الترس المركزي في مجموعة التروس التداويرية)",
 "太陽灯": "مصباح شمسي (مصباح بخار الزئبق يستخدم في العلاجات الطبية أو التجميلية)",
 "太陽炉": "طبق شمسي, مجمع شمسي (مرآة مقعرة تركز أشعة الشمس؛ يمكن أن تنتج درجات حرارة عالية)",
 "太陽神": "إله الشمس (إله يجسد الشمس أو يرتبط بها بشكل ما)",
 "太陽神経叢": "ضفيرة زلاقية, ضفيرة شمسية (ضفيرة كبيرة من الأعصاب الودية في البطن خلف المعدة)",
 "太陽系": "منظومة شمسية",
 "太陽系儀": "أُورُرِي, أُورُورِي",
 "太陽系外惑星": "كَوْكَب خَارِج الْمَجْمُوعَة الشَّمْسِيَّة ((قديمًا) جرم سماوي من البلازما مضيئ بذاته متماسك بفعل الجاذبية؛ جرم سماوي يدور حول الشمس)\nمثال: كوكب الأرض جميل.",
 "太陽虫": "حيوان شمسي (أوالي ذات أجسام كروية وأقدام كاذبة شعاعية صلبة)",
 "太陽輻射": "إشعاع شمسي (إشعاع صادر من الشمس)",
 "太陽電池": "خلية شمسية, خلية كهروضوئية (خلية تحول الطاقة الشمسية إلى طاقة كهربائية)",
 "太陽電池パネル": "بطارية شمسية, مصفوفة شمسية (جهاز كهربائي يتكون من مصفوفة كبيرة من الخلايا الشمسية المتصلة)",
 "太陽風": "رِيح شَمْسِيَّة",
 "太陽黒点": "بقعة شمسية, كلف الشمس (بقعة داكنة أكثر برودة تظهر بشكل دوري على الغلاف الضوئي للشمس؛ مرتبطة بمجال مغناطيسي قوي)",
 "太鼓": "طَبْل (الضَرْب على الطَبْل؛ آلة موسيقية تشبه الإسطوانة المغطاة فتحتها بالجلد تستخدم بأن يضرب وجهها إما باليد أو بعصا) / طَبْلَة",
 "太鼓判": "خاتم الموافقة, ختم (مؤشر على الحالة المعتمدة أو المتفوقة)",
 "太鼓持": "كُومِيدْيَان / مُتَمَلِّق, مُداهِن (شخص يستخدم الإطراء والتملق)",
 "太鼓持ち": "كُومِيدْيَان / مُتَمَلِّق, مُداهِن (شخص يستخدم الإطراء والتملق)",
 "太鼓腹": "مدفأة كرشية, موقد منتفخ (موقد منتفخ الشكل يتم فيه حرق الحطب أو الفحم) / كرش (مصطلحات عامية للكرش أو البطن البارز)",
 "太鼓鋲": "دبوس رسم, دبوس ضغط (دبوس لتثبيت الأوراق على لوحة إعلانات أو لوحة رسم)",
 "夫": "زَوْج, بَعْل (زَوَّجَ الأَشياءَ تَزْويجًا، وزَواجًا: قرن بعضَها ببعض؛ زَوَّجَ فلانًا امرأةً، وبها: جعله يتزوَجَها) / مثال: زوجة ماري طبيبة. / ذَكَرِيّ / ذَكَر, ذكر (ذَكَرَ الشيءَ: نطق به أو أشار إليه بالكلام؛ ذَكَرَ شخصًا: استحضره في الذاكرة)\nمثال: قتله ذكر زرافة. / رُجُولِيّ / أَكْبَر (كبير نسبةً إلى شيء آخر) / إِنْسَان, نَاس (كَائِن بَشَرِيّ؛ سَوَاد العَيْن) / زود بالجند (زَوَّدَ (زوده): أزاده. ويقال زودته كتابا إلى فلان؛ زَوَّدَ(هـ) بكذا: أمده به)\nمثال: أنا إنسان صادق. / لِكَيْ, أَنْ / ذٰلِكَ, ذَاكَ / تِلْكَ / اَلَّذِي / اَلَّتِي / اَلَّذِينَ / هُوَ / عَزِيز, عَزِيْزَة (القوي المنيع، ضد الذليل؛ القليل النادر العالي القيمة) / غَالِي, غَالِيَّة\nمثال: هذه رسالة من شخص عزيز.",
 "夫の命": "مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة!",
 "夫人": "زَوْجَة, اِمْرَأَة",
 "夫君": "زَوْج, بَعْل (زَوَّجَ الأَشياءَ تَزْويجًا، وزَواجًا: قرن بعضَها ببعض؛ زَوَّجَ فلانًا امرأةً، وبها: جعله يتزوَجَها) / مثال: زوجة ماري طبيبة.",
 "夫妻": "زَوْجَانِ",
 "夫婦": "رجل وزوجته, زواج (شخصان متزوجان من بعضهما البعض)\nمثال: كان زواجه الثاني أكثر سعادة من الأول / رجل وزوجته, زواج (شخصان متزوجان من بعضهما البعض)\nمثال: كان زواجه الثاني أكثر سعادة من الأول / زَوْج (زَوَّجَ الأَشياءَ تَزْويجًا، وزَواجًا: قرن بعضَها ببعض؛ زَوَّجَ فلانًا امرأةً، وبها: جعله يتزوَجَها)\nمثال: زوجة ماري طبيبة.",
 "夫婦共働き": "زَوْجَانِ",
 "夫婦共稼ぎ": "زَوْجَانِ",
 "夫婦別れ": "طَلَاق, تَطْلِيق / طَلَّقَ (فعل؛ تحرر من القَيْد ونحوه بمعنى حَرْفيّ؛ فعل؛ تحرك بحرية بدون قيد معنى مَجَازيّ) / أَطْلَقَ\nمثال: طلق زيري زوجته.",
 "夫婦別姓": "زَوْجَانِ",
 "夫婦墓": "زَوْجَانِ",
 "夫婦生活": "ممارسة جنسية, نشاط جنسي (الأنشطة المرتبطة بالجماع الجنسي)\nمثال: مارسوا الجنس في المقعد الخلفي",
 "夫婦約束": "خِطْبَة, خُطُوبَة",
 "夫婦連れ": "زَوْجَانِ",
 "夫婦間": "زوجي (متعلق بالزواج أو بالعلاقة بين الزوج والزوجة)\nمثال: هناء زوجي",
 "夫婦関係": "عَلَاقَة زَوْجِيَّة (العلاقة بين الزوجة والزوج)",
 "夫婦養子": "رجل وزوجته, زواج (شخصان متزوجان من بعضهما البعض)\nمثال: كان زواجه الثاني أكثر سعادة من الأول",
 "夫子": "مُعَلِّم, مُعَلِّمَة (من يمتهن التعليم، مُدَرِّس)\nمثال: هي أصبحت معلمة. / كُونْفُوشِيُوس / مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة! / حَبِيب, حَبِيبَة / رَفِيق, رَفِيقَة",
 "央": "مُنْتَصَف, وَسَط / وَسَط, مُتَوَسْط",
 "央州": "أُورِيغُون",
 "失": "خَسَارَة, فِقْدَان / ضَرَر / خَسَارَة / أَسَاء اَلْفَهْم, أَخْطَأَ / خَطَأ, غَلْطَة (تعني ضدّ الصواب. يشمل ذلك الفعل، القول، والرأي. يُستخدم الفعل \"أخطأ\" للدلالة على عدم الإصابة…؛ قام بعمل بعيد عن الصواب أو مخالف للحق سواء كان ذلك في السلوك أو القول أو الكتابة)\nمثال: كان خطأ حاسوبي. / عَيْبٌ / خَطَأ (تعني ضدّ الصواب. يشمل ذلك الفعل، القول، والرأي. يُستخدم الفعل \"أخطأ\" للدلالة على عدم الإصابة…؛ قام بعمل بعيد عن الصواب أو مخالف للحق سواء كان ذلك في السلوك أو القول أو الكتابة) / غَلْطَة / غَلَط\nمثال: كان خطأ حاسوبي.",
 "失う": "فَقَدَ / خَسِرَ (كلمة \"خسر\" تعني فقدان شيء ما، سواء كان مالا أو شيئا آخر. وتشمل معانيها: فقد المال، الهلاك، الضياع…؛ فعل متعدٍّ ومُتعدٍّ لِمَعْنَى، ومعناها الأساسي فقدان شيء ما. وتتعدد معانيه لتشمل)\nمثال: خسر توم وظيفته. / أَخْطَأَ ((أخْطَأَ): خَطِئَ؛ (أخْطَأَ) غَلِظَ (حاد عن الصواب)) / فَاتَ / اِفْتَقَدَ, اِشْتَاقَ / آنِسَة\nمثال: اعترف أنه أخطأ.",
 "失す": "اِخْتَفَى (تعمّد وتكلف إخفاء نفسه عنه الأنظار فلا يُرى؛ خَفِيَ بعد أن كان مرئيًّا) / أَخْفَى\nمثال: لقد اختفى فاضل. / ذَهَبَ, رَاحَ (في : التِبْر، مَعْدِن ثَمِين أصْفَر اللَّوْنِ، هُوَ أَسَاسُ التَعَامُلِ المَالِيّ وَيُسْتَخْدَمُ أَيْضاً فِي صِنَاعَةِ الْحُلِيّ وَالْمُجَوْهَرَات؛ هَذَا رَجُل ذَهَبا: أَيْ رَجُلٌ يُسَاوِي ذَهَباً فِي قِيمَتِهِ وَقدره) / ذَهَبَ, زَالَ (في : التِبْر، مَعْدِن ثَمِين أصْفَر اللَّوْنِ، هُوَ أَسَاسُ التَعَامُلِ المَالِيّ وَيُسْتَخْدَمُ أَيْضاً فِي صِنَاعَةِ الْحُلِيّ وَالْمُجَوْهَرَات؛ هَذَا رَجُل ذَهَبا: أَيْ رَجُلٌ يُسَاوِي ذَهَباً فِي قِيمَتِهِ وَقدره) / غُو\nمثال: ذهب إلى الدكان. / مَاتَ (للحَيّ: فقد الحَيَاة. مصدره مَوتَا ومِيتَة؛ للأرض: ليس فيها شيء حَيّ من النبات أو الحيوان أو الإنسان. مصدره مَوَات) / تُوُفِّيَ / زَهْر اَلطَّاوِلَة, زَهْر اَلنَّرْد ((زَهَرَ) الوجهُ والسراجُ والقمرُ يَزْهُرُ زَهْرًا، وزُهُوراً: تلألأ وأشْرق؛ (زَهَرَ) الشيءُ: صَفا لونُه)\nمثال: إعتقدت أنه مات.",
 "失する": "فَقَدَ / خَسِرَ (كلمة \"خسر\" تعني فقدان شيء ما، سواء كان مالا أو شيئا آخر. وتشمل معانيها: فقد المال، الهلاك، الضياع…؛ فعل متعدٍّ ومُتعدٍّ لِمَعْنَى، ومعناها الأساسي فقدان شيء ما. وتتعدد معانيه لتشمل)\nمثال: خسر توم وظيفته.",
 "失せる": "اِخْتَفَى (تعمّد وتكلف إخفاء نفسه عنه الأنظار فلا يُرى؛ خَفِيَ بعد أن كان مرئيًّا) / أَخْفَى\nمثال: لقد اختفى فاضل. / ذَهَبَ, رَاحَ (في : التِبْر، مَعْدِن ثَمِين أصْفَر اللَّوْنِ، هُوَ أَسَاسُ التَعَامُلِ المَالِيّ وَيُسْتَخْدَمُ أَيْضاً فِي صِنَاعَةِ الْحُلِيّ وَالْمُجَوْهَرَات؛ هَذَا رَجُل ذَهَبا: أَيْ رَجُلٌ يُسَاوِي ذَهَباً فِي قِيمَتِهِ وَقدره) / ذَهَبَ, زَالَ (في : التِبْر، مَعْدِن ثَمِين أصْفَر اللَّوْنِ، هُوَ أَسَاسُ التَعَامُلِ المَالِيّ وَيُسْتَخْدَمُ أَيْضاً فِي صِنَاعَةِ الْحُلِيّ وَالْمُجَوْهَرَات؛ هَذَا رَجُل ذَهَبا: أَيْ رَجُلٌ يُسَاوِي ذَهَباً فِي قِيمَتِهِ وَقدره) / غُو\nمثال: ذهب إلى الدكان. / مَاتَ (للحَيّ: فقد الحَيَاة. مصدره مَوتَا ومِيتَة؛ للأرض: ليس فيها شيء حَيّ من النبات أو الحيوان أو الإنسان. مصدره مَوَات) / تُوُفِّيَ / زَهْر اَلطَّاوِلَة, زَهْر اَلنَّرْد ((زَهَرَ) الوجهُ والسراجُ والقمرُ يَزْهُرُ زَهْرًا، وزُهُوراً: تلألأ وأشْرق؛ (زَهَرَ) الشيءُ: صَفا لونُه)\nمثال: إعتقدت أنه مات.",
 "失せ去る": "اِخْتَفَى (تعمّد وتكلف إخفاء نفسه عنه الأنظار فلا يُرى؛ خَفِيَ بعد أن كان مرئيًّا) / أَخْفَى\nمثال: لقد اختفى فاضل.",
 "失われた環": "الحلقة المفقودة, الرجل القرد (كائن افتراضي كان يُعتقد سابقاً أنه حلقة وصل بين القردة والبشر)",
 "失われた鎖": "الحلقة المفقودة, الرجل القرد (كائن افتراضي كان يُعتقد سابقاً أنه حلقة وصل بين القردة والبشر)",
 "失効": "انتكاس, تراجع (فشل في الحفاظ على حالة أعلى) / سهو, غفلة (خطأ ناتج عن عدم الانتباه) / انقضاء, فترة انقطاع (استراحة أو توقف في حدوث شيء ما)\nمثال: فترة انقطاع لمدة ثلاثة أسابيع بين الرسائل",
 "失効日": "تاريخ انهاء الصلاحية (جملة الأَحوال والأحداث التي يمر بها كائن ما، ويَصْدق على الفرد والمجتمع، كما يَصْدق على الظواهر الطبيعية والإنسانية؛ هو تحديد الزمن باليَوْم والشَهْر والسَنَة أو ببعضهما. الأجَل أو الوَقْت)\nمثال: ما تاريخ اليوم؟",
 "失効日時表示": "تاريخ انهاء الصلاحية (جملة الأَحوال والأحداث التي يمر بها كائن ما، ويَصْدق على الفرد والمجتمع، كما يَصْدق على الظواهر الطبيعية والإنسانية؛ هو تحديد الزمن باليَوْم والشَهْر والسَنَة أو ببعضهما. الأجَل أو الوَقْت)\nمثال: ما تاريخ اليوم؟",
 "失命": "مُحْتَضَر, يَمُوت (في عملية الانتقال من الحياة أو التوقف عن الوجود) / اندثار, زوال (الوقت الذي ينتهي فيه شيء ما)\nمثال: رجل يحتضر",
 "失墜": "ذُلّ (ذَلَّ الرَّجُلُ: ضَعُفَ، هَانَ، حَقُرَ؛ ذَلَّتِ الدَّابَّةُ: سَهُلَتْ، إِنْقَادَتْ)\nمثال: بذل زيري قصارى جهده.",
 "失声症": "بحة, خرس (اضطراب في أعضاء الصوت يؤدي إلى فقدان الصوت)",
 "失当": "ظُلْم, جَوْر (الثَلَاثُ الظُلَم: الليلة التاسعة عشر، والعشرون، والحادية والعشرون من كل شهر قمري، وسميت بذلك لظلمتها. يسبقها الثلاث الدُرَع ويليها الثلاث الحنادس)\nمثال: نحن نرفض الظلم.",
 "失恋": "انكسار القلب (أسى ويأس مدمر)\nمثال: إنه يتعافى من انكسار القلب",
 "失意": "خَيْبَة أَمَل",
 "失感情症": "أَلِكْسِيثَيْمِيَا, لَامُفْرَدَاتِيّة",
 "失態": "خطأ فادح, زلة (خطأ محرج)",
 "失政": "سوء الإدارة, سوء الحكم (حكومة غير فعالة أو غير نزيهة)",
 "失敗": "فَشَل, قُصُور (فَشَلَ الطالبُ في الامتحان: لم ينجح في الاختبار ولم يحقق النتيجة المطلوبة؛ فَشَلَ الشيءُ: انهار أو انكسر أو توقف عن العمل) / فَشَل (فَشَلَ الطالبُ في الامتحان: لم ينجح في الاختبار ولم يحقق النتيجة المطلوبة؛ فَشَلَ الشيءُ: انهار أو انكسر أو توقف عن العمل) / عُطْل (أوقف أو جعل شيء غير فعال لفترة معينة؛ إيقاف شيء عن العمل أو تركه بدون استخدام أو اهتمام)\nمثال: فشل ياني مجددا.",
 "失敗作": "فَشَل, قُصُور (فَشَلَ الطالبُ في الامتحان: لم ينجح في الاختبار ولم يحقق النتيجة المطلوبة؛ فَشَلَ الشيءُ: انهار أو انكسر أو توقف عن العمل) / فَشَل (فَشَلَ الطالبُ في الامتحان: لم ينجح في الاختبار ولم يحقق النتيجة المطلوبة؛ فَشَلَ الشيءُ: انهار أو انكسر أو توقف عن العمل) / عُطْل (أوقف أو جعل شيء غير فعال لفترة معينة؛ إيقاف شيء عن العمل أو تركه بدون استخدام أو اهتمام)\nمثال: فشل ياني مجددا.",
 "失敗例": "فَشَل, قُصُور (فَشَلَ الطالبُ في الامتحان: لم ينجح في الاختبار ولم يحقق النتيجة المطلوبة؛ فَشَلَ الشيءُ: انهار أو انكسر أو توقف عن العمل) / فَشَل (فَشَلَ الطالبُ في الامتحان: لم ينجح في الاختبار ولم يحقق النتيجة المطلوبة؛ فَشَلَ الشيءُ: انهار أو انكسر أو توقف عن العمل) / عُطْل (أوقف أو جعل شيء غير فعال لفترة معينة؛ إيقاف شيء عن العمل أو تركه بدون استخدام أو اهتمام)\nمثال: فشل ياني مجددا.",
 "失敗者": "خَاسِر / فَاشِل",
 "失敗隠し": "تستر (إخفاء يحاول منع شيء فاضح من أن يصبح علنياً)",
 "失敬": "فجاجة, قلة أدب (أسلوب وقح ومهين) / بدائية, خشونة (حالة برية أو غير مهذبة) / ذهاب, رحيل (فعل المغادرة) / سرقة, لصوصية (فعل أخذ شيء من شخص ما بشكل غير قانوني) / تسلل, خلسة (تجنب الكشف عن طريق التحرك بحذر)\nمثال: اللصوصية فظيعة في مطار كينيدي الدولي / إِلَى اللِّقَاء, مَعَ السَّلَامَة (عبارة وداع)\nمثال: تبادلوا عبارات الوداع",
 "失明": "عَمًى",
 "失明者": "مَكْفوف",
 "失望": "خَيْبَة أَمَل",
 "失格": "إِقْصَاء",
 "失業": "بِطَالَة, بَطَالَة",
 "失業率": "مُعَدَّل البَطَالَة (النسبة المئوية للقوى العاملة العاطلة عن العمل في أي تاريخ معين)",
 "失業者": "عاطل عن العمل (شخص بلا وظيفة)",
 "失権": "حرمان من الحقوق (فعل سحب التوثيق أو إنهاء الامتياز)",
 "失活": "إبطال مفعول, تعطيل (فعل التعطيل أو جعل الشيء غير فعال (مثل القنبلة)) / تعطيل, حل الوحدة (تفكيك وحدة عسكرية (عن طريق النقل أو التسريح))",
 "失火": "إخفاق, طيش (الفشل في إصابة الهدف (أو المقابلة أو الإيجاد، إلخ)) / فشل الاشتعال, كبوة (انفجار يفشل في الحدوث)",
 "失点": "خطأ فادح, زلة (خطأ محرج)",
 "失着": "أَسَاء اَلْفَهْم, أَخْطَأَ / خَطَأ, غَلْطَة (تعني ضدّ الصواب. يشمل ذلك الفعل، القول، والرأي. يُستخدم الفعل \"أخطأ\" للدلالة على عدم الإصابة…؛ قام بعمل بعيد عن الصواب أو مخالف للحق سواء كان ذلك في السلوك أو القول أو الكتابة)\nمثال: كان خطأ حاسوبي.",
 "失礼": "إساءة, فظاظة (نقص في التهذيب؛ الفشل في إظهار الاحترام للآخرين؛ جرح مشاعر الآخرين) / فجاجة, قلة أدب (أسلوب وقح ومهين) / قِلَّة احْتِرَام, وَقَاحَة (تعبير عن عدم الاحترام) / عَفْوًا!, مَاذَا قُلْتَ؟ / تَرَكَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض) / تَرَكَ, غَادَرَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض) / إِجَازَة, عُطْلَة\nمثال: لقد ترك لك هذا.",
 "失礼しました": "أَنَا آسِف, أَنَا آسِفَة",
 "失礼します": "عَفْوًا!, مَاذَا قُلْتَ؟",
 "失礼をば": "أَنَا آسِف, أَنَا آسِفَة",
 "失礼至極": "سَلِيط, صَفِيق (جريء ومتطاول بشكل غير لائق) / خَارِجِيّ, غَيْرُ جَوْهَرِيّ (لا يتعلق بالمسألة قيد البحث) / جَرِيءُ اللِّسَان, وَقِح (يتّسم بخفّة وقحة ومرح طافح)",
 "失神": "إِغْمَاء / أُغْمِيَ, غُشِيَ",
 "失禁": "سَلَس ((سَلُسَ) يَسْلُسُ سَلاسَةً: لانَ وسَهُلَ وانقادَ، فهو سَلِيسٌ)",
 "失笑": "ضحكة ساخرة (ضحكة غير محترمة)",
 "失策": "خطأ فادح, زلة (خطأ محرج) / خَطَأ (تعني ضدّ الصواب. يشمل ذلك الفعل، القول، والرأي. يُستخدم الفعل \"أخطأ\" للدلالة على عدم الإصابة…؛ قام بعمل بعيد عن الصواب أو مخالف للحق سواء كان ذلك في السلوك أو القول أو الكتابة) / غَلْطَة / غَلَط\nمثال: كان خطأ حاسوبي.",
 "失考": "سُوء فَهْم",
 "失職者": "عاطل عن العمل (شخص بلا وظيفة)",
 "失脚": "دمار, سقوط (فشل يؤدي إلى فقدان المنصب أو السمعة) / انهيار, سقوط (تراجع مفاجئ في القوة أو العدد أو الأهمية) / سقوط, هطول (سقوط أي شكل من أشكال الماء على الأرض (مطر أو ثلج أو برد أو صقيع أو رذاذ))\nمثال: سقوط آل هابسبورغ",
 "失行": "أَسَاء اَلْفَهْم, أَخْطَأَ / خَطَأ, غَلْطَة (تعني ضدّ الصواب. يشمل ذلك الفعل، القول، والرأي. يُستخدم الفعل \"أخطأ\" للدلالة على عدم الإصابة…؛ قام بعمل بعيد عن الصواب أو مخالف للحق سواء كان ذلك في السلوك أو القول أو الكتابة)\nمثال: كان خطأ حاسوبي. / أبراكسيا, تعذر الأداء (عدم القدرة على القيام بحركات هادفة)",
 "失見当": "توهان, ضياع (ارتباك (عادة ما يكون عابراً) حول مكان وجودك وكيفية المضي قدماً؛ عدم اليقين بشأن الاتجاه) / فقدان التوجيه, هذيان (وهم جامح (خاصة الناتج عن عقار مهلوس))\nمثال: كان توهانه نتيجة لعدم الانتباه",
 "失言": "زلة لسان (خطأ عرضي وتافه عادة في التحدث)",
 "失認": "عمه, فقدان المعرفة (عدم القدرة على التعرف على الأشياء باستخدام الحواس)",
 "失認症": "عمه, فقدان المعرفة (عدم القدرة على التعرف على الأشياء باستخدام الحواس)",
 "失語症": "حبسة, فقدان القدرة على الكلام (عدم القدرة على استخدام أو فهم اللغة (المنطوقة أو المكتوبة) بسبب آفة دماغية)",
 "失読症": "عُسْرُ ٱلْقِرَاءَة (جعَل شيئًا صعبًا أو أكثر تعقيدًا؛ وضع عوائق أو صعوبات أمام أمرٍ ما)\nمثال: إن مع العسر يسرا.",
 "失調": "خلل وظيفي, عطل (فشل في العمل بشكل طبيعي) / رَنَح ((رَنَّحَ) فلان: تمايل من السكر وغيره؛ (رَنَّحَ) الشراب فلانا: جعله يرنح)",
 "失費": "صَرْف, مَصْرُوف (بمعنى أبْعَدَ عن القَصْد أو الغَايَة أو محل الاهتمام؛ بمعنى اَنْفَقَ المَال وبمعنى الرَدّ والمَنْع)\nمثال: أيمكنك صرف خمسين؟",
 "失跡": "اِخْتِفَاء",
 "失踪": "اِخْتِفَاء",
 "失踪者": "آبِق",
 "失速": "مَعْلِف, مُرَاح / بَسْطة / تراجع, ركود (تدهور في النشاط التجاري أو الاقتصادي)\nمثال: شهد السوق ركوداً",
 "失陥": "اِسْتَسْلَمَ / اِسْتَسْلَام",
 "夷": "إقليمي, ريفي (من خصائص الأقاليم (الريف) أو سكانها) / إقليمي, ريفي (مكون من أو مرتبط بمقاطعة أو إقليم) / فلاح, قروي (شخص من الريف) / رئيس إقليمي ((الكنيسة الكاثوليكية) مسؤول مسؤول عن مقاطعة كنسية يعمل تحت الرئيس العام للرهبنة)\nمثال: ريفي ومساير للأعراف بعمق / أَجْنَبِيّ, أَجْنَبِيَّة / هَمَجِيّ, مُتَوَحِّش / هَمَجِيّ, بَرْبَرِيّ",
 "夷人": "هَمَجِيّ, مُتَوَحِّش / هَمَجِيّ, بَرْبَرِيّ / أَجْنَبِيّ, أَجْنَبِيَّة",
 "夷狄": "هَمَجِيّ, مُتَوَحِّش / هَمَجِيّ, بَرْبَرِيّ",
 "夷草": "أرابيس كندي, قرن المنجل (رشاد صخري أمريكي شمالي ذو قرون منحنية طويلة جداً) / سنا منفرجة الأوراق, قرن المنجل (عشب استوائي عالمي أو شجيرة صغيرة بزهور صفراء وقرون منحنية رفيعة؛ عشب ضار؛ يصنف أحياناً في جنس كاسيا)",
 "夾竹桃": "دِفْلَى",
 "夾輔": "تمريرة حاسمة, مساعدة ((رياضة) فعل تمكين لاعب آخر من القيام بلعبة جيدة) / إعانة, عون (نشاط المساهمة في تلبية حاجة أو تعزيز جهد أو غرض ما)",
 "夾雑物": "شوائب, عدم نقاء (حالة كونه غير نقي) / خبث, شائب (مادة عديمة القيمة أو خطرة يجب إزالتها)\nمثال: كانت هناك شوائب في الماء",
 "奄々": "شهقة, لهاث (سحب قصير ومجهد للنفس مع فتح الفم)\nمثال: أطلقت شهقة وأغمي عليها",
 "奄奄": "شهقة, لهاث (سحب قصير ومجهد للنفس مع فتح الفم)\nمثال: أطلقت شهقة وأغمي عليها",
 "奄羅": "مَنْجُو, مَنْجَا",
 "奇": "غَرِيب, عَجِيب / أَجْنَبِيّ, غَرِيب / فَرْدِيّ",
 "奇々怪々": "شَاذّ, عَجِيب (غَيْرُ تَقْلِيدِيٍّ أَوْ غَيْرُ مَأْلُوفٍ بِشَكْلٍ لَافِتٍ لِلنَّظَر)",
 "奇し": "صُوفِيّ, غَامِض (له مدلول لا تُدرِكه الحواسّ ولا يتّضح للعقل؛ يتجاوز الفهم العادي) / صوفي, عرفاني (متعلق بالتصوف أو مميز له) / صوفي, غامض (متعلق بالتصوف أو يشبهه)",
 "奇しき": "غَرِيب, عَجِيب / أَجْنَبِيّ, غَرِيب",
 "奇しくも": "بشكل عجيب, بغرابة (بطريقة غريبة)\nمثال: ورقة مكتوبة بغرابة",
 "奇っ怪": "غَرِيب, عَجِيب / أَجْنَبِيّ, غَرِيب",
 "奇なる": "فَرْدِيّ",
 "奇人": "غَرِيب الْأَطْوَار (شخص يعتبر غريب الأطوار أو مجنوناً ويبرز عن المجموعة)",
 "奇体": "غَرِيب, عَجِيب / أَجْنَبِيّ, غَرِيب",
 "奇偶性": "تَكَافُؤ, تَمَاثُل (مساواة وظيفية) / تكافؤ, حفظ التكافؤ ((فيزياء) التكافؤ محفوظ في كون تكون فيه قوانين الفيزياء هي نفسها في نظام إحداثيات يمني كما في نظام يساري) / بت التدقيق, بت التكافؤ ((علم الحاسوب) بت يُستخدم في إجراء كشف الأخطاء حيث يُضاف 0 أو 1 إلى كل مجموعة من البتات ليكون مجموع الآحاد فرديًا أو زوجيًا) / تَمَاثُل, زَوْجِيَّة ((الرياضيات) علاقة بين زوج من الأعداد الصحيحة: إذا كان كلاهما فردياً أو كلاهما زوجياً فلهما نفس الزوجية)",
 "奇偶検査": "فحص التكافؤ (نظام للتحقق من الأخطاء في عمل الكمبيوتر)",
 "奇偶検査ビット": "بت التدقيق, بت التكافؤ ((علم الحاسوب) بت يُستخدم في إجراء كشف الأخطاء حيث يُضاف 0 أو 1 إلى كل مجموعة من البتات ليكون مجموع الآحاد فرديًا أو زوجيًا)",
 "奇兵": "كوماندوز, مغاوير (وحدة عسكرية برمائية مدربة للقيام بغارات داخل أراضي العدو) / جندي صاعقة, فدائي (عضو في وحدة عسكرية مدربة كقوات اقتحام لشن غارات خاطفة)",
 "奇勝": "حسنة, شامة اصطناعية (نقطة توضع على وجه السيدة للزينة)",
 "奇奇怪怪": "شَاذّ, عَجِيب (غَيْرُ تَقْلِيدِيٍّ أَوْ غَيْرُ مَأْلُوفٍ بِشَكْلٍ لَافِتٍ لِلنَّظَر)",
 "奇妙": "غَرِيب, عَجِيب / أَجْنَبِيّ, غَرِيب",
 "奇峭": "حاد الانحدار, شديد الانحدار (ذو ميل حاد) / حَادّ, شَدِيد الانْحِدَار (للمنحدر؛ مضبوط بزاوية عالية) / بَاهِظ, فَاحِش (يَتَجَاوَزُ حُدُودَ المَعْقُولِ وَالاعْتِدَالِ بِكَثِير) / منحدر حاد (مكان شديد الانحدار (كما في التل))\nمثال: سلالم العلية شديدة الانحدار / خَشِن, قَاسٍ (كريه بشكل حادّ وصارم) / صارِم, قاسٍ (شَديد القَسْوَة (عَن العُقوبَة أو الحُكْم)) / خَشِن, غَلِيظ (قاسٍ أو وقح أو غير مهذّب) / خَشِن, قَاسٍ (صارم بشكل غير سارّ)",
 "奇幻": "غَرِيب, عَجِيب / أَجْنَبِيّ, غَرِيب",
 "奇形": "تَشَوُّه شَكْلِيّ",
 "奇形学": "علم المسوخ (فرع علم الأحياء المعني بتطور التشوهات أو الانحرافات الخطيرة عن النوع الطبيعي للكائن الحي)",
 "奇形腫": "ورم مسخي (ورم يتكون من خليط من الأنسجة غير الموجودة عادة في ذلك الموقع)",
 "奇怪": "غَرِيب, عَجِيب / أَجْنَبِيّ, غَرِيب",
 "奇怪千万": "شَاذّ, عَجِيب (غَيْرُ تَقْلِيدِيٍّ أَوْ غَيْرُ مَأْلُوفٍ بِشَكْلٍ لَافِتٍ لِلنَّظَر)",
 "奇想天外": "رَائِع",
 "奇想曲": "كابريتشيو (مقطوعة آلية لا تلتزم بقواعد أي شكل موسيقي محدد وتُعزف بارتجال)",
 "奇態": "غَرِيب, عَجِيب / أَجْنَبِيّ, غَرِيب",
 "奇抜": "غَيْر مَأْلُوف (لا يُصادف عادة) / استثنائي, غير عادي (غير معتاد أو غير شائع أو غير عادي) / شاذ, عجيب (خارج عن المألوف وغير متوقع بشكل قاطع؛ غريب قليلاً أو حتى شاذ)\nمثال: مشهد ذو جمال غير عادي",
 "奇数": "عَدَد فَرْدِيّ (مِقْدَار مَا يُعَدّ)\nمثال: كم عدد سكان الجزائر؟",
 "奇数羽状複葉": "فَرْدِيّ التَّرِيُّش ((عن شكل الورقة) ريشيّ بوريقة مُنفردة عند القمّة)",
 "奇特": "مُحَمَّد (مُفَعَّل من حَمَّدَ؛ الذي يُحْمَدُ كثيرا)\nمثال: محمد رسول الله. / غَرِيب, عَجِيب / أَجْنَبِيّ, غَرِيب",
 "奇異": "فَرْدِيّ",
 "奇矯": "لامتراكز, منحرف المركز (ليس له مركز مشترك؛ غير متحد المركز) / شَاذّ, عَجِيب (غَيْرُ تَقْلِيدِيٍّ أَوْ غَيْرُ مَأْلُوفٍ بِشَكْلٍ لَافِتٍ لِلنَّظَر) / شخصية, غريب الأطوار (شخص من نوع محدد (عادة ما يكون لديه العديد من الغرابة)) / غَرِيب الْأَطْوَار (شخص ذو شخصية غير عادية أو غريبة)\nمثال: دوائر لامتراكزة",
 "奇絶": "بَدِيع, رَائِع (بالغ الجمال؛ فائق الحُسن) / أَنِيق, بَدِيع (ذُو جَمَالٍ رَقِيقٍ وَدَقِيق) / بَالِغُ الأَنَاقَة, رَائِع (أنيق ومصقول بشكل بالغ) / حَادّ, لَاذِع (شَدِيدُ الحِدَّةِ وَالوَطْأَة)",
 "奇胎": "خَال, شَامَة (بمعنى ظَنَّ، استخدام نادر والأغلب استخدام خَيْل أو مَخَالَة؛ أخو الأم. جمعه أخوال للمذكر وخالات للمؤنث) / طَوْبِين, طُوبِين / مُول\nمثال: عندي ابنا خالة.",
 "奇薬": "إِكْسِير",
 "奇行": "غَرَابَة الأَطْوَار (سلوك غريب وغير تقليدي) / لا مركزية (دائرية لها مركز مختلف أو تنحرف عن مسار دائري) / اِخْتِلَاف مَرْكَزِيّ, لَا مَرْكَزِيَّة ((الهندسة) نسبة تصف شكل القطع المخروطي؛ نسبة المسافة بين البؤرتين إلى طول المحور الأكبر)\nمثال: الدائرة هي قطع ناقص ذو اختلاف مركزي صفري",
 "奇術": "سِحْر (ألقى السحر على شخص أو شيء، بمعنى جعله تحت تأثير السحر؛ أدهش أو أبهر بجمال أو جاذبية غير عادية) / سِحْرِيّ\nمثال: هذا هو سحر الجزائر.",
 "奇術師": "مشعوذ, مُحَضّر أرواح (طبيب ساحر يمارس استحضار الأرواح) / ساحر, لاعب خفة (شخص يقوم بألعاب سحرية لإمتاع الجمهور)",
 "奇襲": "مباغتة, هجوم مفاجئ (هجوم دون سابق إنذار)",
 "奇襲攻撃": "مباغتة, هجوم مفاجئ (هجوم دون سابق إنذار)",
 "奇警": "بَلِيغ الدُّعَابَة, حَاضِر البَدِيهَة (يجمع بين الفكرة الذكيّة والتعبير الطريف)",
 "奇貨": "فُضُول",
 "奇跡": "مُعْجِزَة, أُعْجُوبَة",
 "奇跡劇": "مسرحية المعجزات (مسرحية من القرون الوسطى تمثل حلقات من حياة قديس أو شهيد)",
 "奇跡的": "خَارِق, مُعْجِز (الشيء)\nمثال: ذلك خارق للعادة.",
 "奇蹄類": "حيوان مفرد الأصابع, مفردات الأصابع (ثدييات مشيمية لها حوافر بعدد فردي من الأصابع في كل قدم)",
 "奇蹟": "مُعْجِزَة, أُعْجُوبَة",
 "奇遇": "صُدْفَة, مُصَادَفَة (الصدفة. جمع: صُدُفات و صُدْفات و صُدَف٬ هي تزامن غير متوقع لحدوث فعلين بدون تخطيط مسبق، رآه صُدْفةً…)\nمثال: لا تدعها للصدفة.",
 "奇静脈": "وَرِيد فَرْد",
 "奇骨": "لامتراكز, منحرف المركز (ليس له مركز مشترك؛ غير متحد المركز) / شَاذّ, عَجِيب (غَيْرُ تَقْلِيدِيٍّ أَوْ غَيْرُ مَأْلُوفٍ بِشَكْلٍ لَافِتٍ لِلنَّظَر) / شخصية, غريب الأطوار (شخص من نوع محدد (عادة ما يكون لديه العديد من الغرابة)) / غَرِيب الْأَطْوَار (شخص ذو شخصية غير عادية أو غريبة)\nمثال: دوائر لامتراكزة",
 "奇麗": "جَمِيل, لَطِيف (حَسَن)\nمثال: طقس اليوم جميل. / نَظِيف / نضيف / نَظَّفَ / تَمَامًا",
 "奇麗事": "تستر, تلميع (تبرئة مخادعة تحاول التغطية على الإخفاقات والعيوب) / جير, طلاء جيري (غسول يتكون من الجير والغراء في الماء؛ يستخدم لتبييض الجدران والأسطح الأخرى) / هزيمة نظيفة (هزيمة يفشل فيها الشخص أو الفريق الخاسر في التسجيل)",
 "奈良": "نَارَا",
 "奈良原": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "奈良崎": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "奈落": "جَهَنَّم, جَحِيم / جَحِيم, جَهَنَّم / النِهاية",
 "奈落の底": "هَاوِيَة (مؤنث هاوٍ، الساقطة أو الواقعة؛ مؤنث هَاوٍ، المحبّة) / هَاوِيَة, هُوَّة (مؤنث هاوٍ، الساقطة أو الواقعة؛ مؤنث هَاوٍ، المحبّة)\nمثال: وصل سامي إلى قاع الهاوية ماليا.",
 "奈辺": "أَيْن, فين / حَيْثُ",
 "奉じる": "حَالِيّ, حَاضِر / مَوْجُود, حَاضِر (الذي له وجود) / الزَّمَان, الْحَال / قَدَّمَ, طَرَحَ (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى الرُّسْغَ؛ أنّ لهم سابقةً وفضلاً له عند فلان قَدَمٌ : معروف)\nمثال: أنا موجود لوحدي / أَطَاعَ",
 "奉ずる": "حَالِيّ, حَاضِر / مَوْجُود, حَاضِر (الذي له وجود) / الزَّمَان, الْحَال / قَدَّمَ, طَرَحَ (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى الرُّسْغَ؛ أنّ لهم سابقةً وفضلاً له عند فلان قَدَمٌ : معروف)\nمثال: أنا موجود لوحدي / أَطَاعَ",
 "奉る": "اِقْتِرَاح / اِقْتَرَحَ, قَدَّمَ (اِبْتَدَعَ ٱلشَّيْءَ مِنْ ذَاتِ نَفْسِهِ مِنْ غَيْرِ أَنْ يَسْمَعَهُ؛ اِخْتَارَ) / قَدَّمَ (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى الرُّسْغَ؛ أنّ لهم سابقةً وفضلاً له عند فلان قَدَمٌ : معروف)\nمثال: اقترح سامي المساعدة.",
 "奉仕": "خِدْمَة",
 "奉仕団体": "نادي الخدمة العسكرية (مركز ترفيهي لرجال الخدمة العسكرية) / نادي خدمة (نادي من المهنيين أو رجال الأعمال منظم لتنسيقهم ونشط في الخدمات العامة)",
 "奉仕女": "شماسة (امرأة برتبة شماس)",
 "奉仕料": "رسم الخدمة (نسبة مئوية من الفاتورة (كما في فندق أو مطعم) تضاف كدفع للخدمة) / رسوم الخدمات (رسم يُدفع لمالك مبنى سكني مقابل الكهرباء والمصاعد والصيانة وما إلى ذلك)",
 "奉仕活動": "عمل تطوعي محبب (عمل منتج يتم إنجازه طوعاً دون مكافأة مادية أو تعويض)",
 "奉仕者": "خَادِم, خَادِمَة / قِسِّيس, دَاعِيَة (الذي يُقَسِّس الإبل أو الماشية أو الغنم، أي يحسن رعايتها، الراعي؛ عند المَسِيْحِيِّيْن هو لقب فوق الشَمَّاس ودون الأُسْقُف وهو القَسّ) / وَزِير, وَزِيرَة",
 "奉体": "أداء, تنفيذ (فعل الأداء؛ القيام بشيء بنجاح؛ استخدام المعرفة بدلاً من مجرد امتلاكها) / تطبيق, تنفيذ (عملية إنجاز هدف ما أو تنفيذ أمر ما)\nمثال: انتقدوا أداءه كرئيس للبلدية",
 "奉侍": "إعلان قضائي, تبليغ (عملية تسليم أمر قضائي أو استدعاء لشخص ما) / حصة, مقدار (كمية فردية من الطعام أو الشراب يتم تناولها كجزء من وجبة)\nمثال: قبل تبليغ الاستدعاء",
 "奉公": "خدمة عامة, وظيفة حكومية (التوظيف ضمن نظام حكومي (خاصة في الخدمة المدنية)) / خدمة عامة, خدمة مجتمعية (خدمة يتم أداؤها لصالح الجمهور أو مؤسساته)",
 "奉公人": "خَادِم, خَادِمَة",
 "奉加": "تَبَرُّع, هِبَة",
 "奉呈": "إِرَاءَة / إِهْدَاء, مَنْح",
 "奉唱": "غِنَاء (مصدر للفعل \"غَنَّى\"؛ استعمال الصوت البشري لصنع أصوات موسيقية)\nمثال: عادت إلى الغناء.",
 "奉拝": "عِبَادَة / عَبَدَ, سَجَدَ (خلاف الحُرّ، المَمْلُوْك، من له مالك يملكه. الجمع عبيد وأعبد وعِبدان وعُبدان؛ الإنسان حرا كان أم لا مؤمنا كان أن ملحدا من حيث أنه مملوك لله) / سَجَدَ (وَضَعَ جَبْهَتَهُ عَلَى ٱلْأَرْضِ)\nمثال: ماذا أنجز عبد العزيز بوتفليقة؟",
 "奉持": "رمان بلي, كرسي تحميل (دعامة دوارة توضع بين الأجزاء المتحركة للسماح لها بالحركة بسهولة) / رسم شعار النبالة, شحنة (شعار النبالة المتمثل في تصميم أو صورة مرسومة على درع) / سلوك, هيئة (أسلوب أو سلوك وقور) / قوام, هيئة (طريقة مميزة لحمل الجسم)\nمثال: وقف بوضعية جيدة",
 "奉教人": "مَسِيحِيّ, مَسِيحِيَّة (المنسوب إلى المَسِيْح عليه السلام؛ المنسوب إلى الدين المسيحي، النَصْرَانِي)",
 "奉献": "تَفَانٍ / إِهْدَاء",
 "奉献頌": "طقس التقدمة (جزء من القداس يتم فيه تقديم الخبز والنبيذ لله) / جمع التبرعات, عطاء المصلين (تقدمات المصلين في خدمة دينية)",
 "奉祝": "اِحْتِفَال (إقامة مراسم أو فعاليات تعبيرًا عن مناسبة معينة) / اِحْتِفَال, مِهْرَجَان (إقامة مراسم أو فعاليات تعبيرًا عن مناسبة معينة)\nمثال: لم يحضر الاحتفال.",
 "奉納": "تَفَانٍ / إِهْدَاء",
 "奉行": "حاكم, قاضي صلح (قاضٍ غير محترف أو سلطة مدنية تدير القانون (خاصة من يدير محكمة تتعامل مع المخالفات البسيطة))",
 "奉迎": "أَهْلًا وَسَهْلًا, مَرْحَبًا (تحية ترحيب بالضيف؛ تحية عند اللقاء أو لبدء المحادثة) / تَرْحِيب / رَحَّبَ, اِسْتَقْبِل (بنو رَحَب: اسم؛ بطن من همذان)\nمثال: أهلا يا أصدقاء.",
 "奉還": "إعادة, استرداد (استعادة الشيء مرة أخرى) / إعادة تأهيل, استعادة (فعل إعادة شيء أو شخص إلى حالة مرضية) / نموذج استعادة, نموذج ترميم (نموذج يمثل المشهد الطبيعي لعصر جيولوجي سابق أو يمثل حيواناً منقرضاً وما إلى ذلك) / عمل مرمم, قطعة مرممة (قطعة أثرية أو فنية تم ترميمها أو إعادة بنائها)",
 "奏す": "لَعِبَ, لعب (فعل شيئا للتسلية والترفيه، شَارَكَ في لعبة) / عَزَفَ, شَغَّلَ (والمعزف :الملاهي واحدها معزف ومعزفة) / دَوْر (جَعَله يَدُور؛ جَعَلَه مُدَوَّر) / مَسْرَحِيَّة / مَسْرَح, مَسْرَحِيَّة\nمثال: لعب زيري التنس. / أَدَّى",
 "奏する": "لَعِبَ, لعب (فعل شيئا للتسلية والترفيه، شَارَكَ في لعبة) / عَزَفَ, شَغَّلَ (والمعزف :الملاهي واحدها معزف ومعزفة) / دَوْر (جَعَله يَدُور؛ جَعَلَه مُدَوَّر) / مَسْرَحِيَّة / مَسْرَح, مَسْرَحِيَّة\nمثال: لعب زيري التنس. / أَدَّى",
 "奏でる": "رَقْص (حركة الجسم بتنسيق موسيقي أو لحن، حيث يتحرك الشخص بشكل إيقاعي أو متناسق مع الموسيقى أو أنغام معينة؛ نشاط جسدي يتم على عادة أو تقليد، حيث يشارك الأفراد في الاحتفالات أو الفعاليات الاجتماعية) / رقص (حركة الجسم بتنسيق موسيقي أو لحن، حيث يتحرك الشخص بشكل إيقاعي أو متناسق مع الموسيقى أو أنغام معينة؛ نشاط جسدي يتم على عادة أو تقليد، حيث يشارك الأفراد في الاحتفالات أو الفعاليات الاجتماعية) / شطيح / رَقَصَ, رقص (حركة الجسم بتنسيق موسيقي أو لحن، حيث يتحرك الشخص بشكل إيقاعي أو متناسق مع الموسيقى أو أنغام معينة؛ نشاط جسدي يتم على عادة أو تقليد، حيث يشارك الأفراد في الاحتفالات أو الفعاليات الاجتماعية)\nمثال: كنت تجيد الرقص.",
 "奏で合う": "مُبَارَاة / شَحّاطَة, شَخَّاطَة",
 "奏功": "نَجَاح",
 "奏効": "فعالية, نجاعة (القدرة أو القوة لإنتاج تأثير مرغوب)\nمثال: قلق بشأن سلامة وفعالية اللقاح",
 "奏曲": "سوناتا (تأليف موسيقي من 3 أو 4 حركات ذات أشكال متباينة)",
 "奏楽": "أداء موسيقي (فعل أداء الموسيقى)",
 "奏者": "عازف, موسيقي (شخص يعزف الموسيقى كمهنة)",
 "奏鳴曲": "سوناتا (تأليف موسيقي من 3 أو 4 حركات ذات أشكال متباينة)",
 "契り": "تَعَهَّدَ / ضَمَان (مَصْدَرُ ضَمِنَ؛ كَفَالَة) / تَعَهُّد\nمثال: لا أستطيع ضمان أي شيء. / قدر, مصير (حدث (أو مسار أحداث) سيحدث حتماً في المستقبل) / قضاء, قَدَر (القوة النهائية التي يُنظر إليها على أنها تحدد مسار الأحداث مسبقاً) / حظ, قدر (ظروفك العامة أو حالتك في الحياة (بما في ذلك كل ما يحدث لك))\nمثال: نحن عاجزون أمام القدر",
 "契る": "تَعَهَّدَ / ضَمَان (مَصْدَرُ ضَمِنَ؛ كَفَالَة) / تَعَهُّد\nمثال: لا أستطيع ضمان أي شيء.",
 "契印": "ركضة, نقطة (نقطة في البيسبول يسجلها العداء بلمس جميع القواعد الأربع بأمان) / إحصاء, عد (فعل العد؛ تلاوة الأرقام بترتيب تصاعدي) / حساب, كشف الحساب (فاتورة بمبلغ مستحق)\nمثال: سجل فريق اليانكيز 3 ركضات في النصف الثاني من الشوط التاسع",
 "契合": "اِتِّفَاق, تَوَافُق / إِقْرَار / اِتِّفَاق, اِتِّفَاقِيَّة",
 "契情": "جَمَال, زَيْن / حَسْنَاء, جَمِيلَة / مَحْظِيّة",
 "契機": "فُرْصَة / زِنَاد",
 "契約": "عَقْد, مُعَاهَدَة (العَشْر من السَنَوَات؛ الاتِّفَاق والعَهْد بين طرفين) / أَغْدَمَ, اِدَّغَمَ\nمثال: أمضى زيري العقد.",
 "契約の箱": "تَابُوت اَلْعَهْد (تَّابُوت: هو الصُّنْدُوق الذي توضع به الجثة؛ صندوق خشبيّ يكون مستطيل)",
 "契約不履行": "خرق العقد (شَقَّ الثوب والقماش وما أشبه)\nمثال: لقد قام بخرق الاتفاق.",
 "契約書": "عَقْد, مُعَاهَدَة (العَشْر من السَنَوَات؛ الاتِّفَاق والعَهْد بين طرفين) / أَغْدَمَ, اِدَّغَمَ\nمثال: أمضى زيري العقد.",
 "契約法": "قانون العقود (فرع الفقه الذي يدرس حقوق والتزامات الأطراف الداخلة في عقود)",
 "契約者": "متبرع, مساهم (شخص يساهم (أو يعد بالمساهمة) بمبلغ من المال) / قارئ, مشترك (شخص يتعاقد لاستلام ودفع مقابل خدمة أو عدد معين من إصدارات مطبوعة) / مؤيد, مصادق (شخص يعبر عن موافقة قوية)",
 "契約者回線": "خط هاتف, خط هاتفي (وصلة هاتفية)",
 "契約違反": "خرق العقد (شَقَّ الثوب والقماش وما أشبه)\nمثال: لقد قام بخرق الاتفاق.",
 "契約金": "دفعة أولى, عربون (دفعة جزئية تُدفع وقت الشراء؛ والباقي يُدفع لاحقاً)",
 "奔放": "مُتَوَحِّش / بَرِّيّ",
 "奔放自在": "طَائِش, لَا مُبَالٍ (غير مسؤول بمرح وخِفّة) / حُرّ, مُنْطَلِق (خالٍ من القيود أو القواعد)",
 "奔流": "تيار جارف, سيل (تيار مائي سريع وعنيف (أو سائل آخر)) / طوفان, هطول غزير (مطر غزير) / سيل, طوفان (عدد أو كمية هائلة)\nمثال: جرفت المنازل في السيل",
 "奔竄": "هَرَبَ (الفِرارُ) / فِرَار, هُرُوب",
 "奔逸": "هَرَبَ, فَرَّ (الفِرارُ)\nمثال: هرب كأرنب خائف.",
 "奔騰": "تحليق لأعلى, صعود سريع (فعل الارتفاع لأعلى في الهواء)",
 "奕々": "باهِر / كَبِير, وَاسِع (ضد الصغير؛ العظيم الحَجْم؛ ضد الصغير؛ المتقدم في السِنّ)\nمثال: ذاك البيت كبير.",
 "奕奕": "باهِر / كَبِير, وَاسِع (ضد الصغير؛ العظيم الحَجْم؛ ضد الصغير؛ المتقدم في السِنّ)\nمثال: ذاك البيت كبير.",
 "奚んぞ": "كَيْف, ازاي / كَيْفَ, ازاي / كَمْ, يَا لَ",
 "奢り": "رَفَاهِيَّة, تَرَف / تَرَف (تَرِفَ النَّبَاتُ، كفَرِح: تَرَوَّى؛ تَرِفَ النَّبَات تَرَفَا: كَثُرَ مَاؤُهُ ونَضُر) / كَمَالِيّ / عَالَجَ",
 "奢る": "اِشْتَرَى (أَخَذَ الشيءَ بِثَمَن؛ اشترى الشخصَ (الحرّ) أو رضاه: أراد إرضائه ومحبته بغض النظر عن الكلفة)\nمثال: اشترى زيري ذلك.",
 "奢侈": "رَفَاهِيَّة, تَرَف / تَرَف (تَرِفَ النَّبَاتُ، كفَرِح: تَرَوَّى؛ تَرِفَ النَّبَات تَرَفَا: كَثُرَ مَاؤُهُ ونَضُر) / كَمَالِيّ",
 "奥": "جَوْفِيّ, دَاخِلِيّ (من وسط المنطقة أو البلاد أو قادم منه) / جَوَّانِيّ, دَاخِلِيّ (في الداخل وباتجاه المركز) / بَاطِنِيّ, دَاخِلِيّ (يقع في الداخل ويتعلق بالعالم النفسي والعقلي) / داخلي (يقع في أو مناسب لداخل مبنى)\nمثال: مشهد داخلي / أماكن معيشة, مساكن (سكن متاح للناس للعيش فيه)\nمثال: وجد مسكناً لعائلته / رَدْب / زَوْجَة, اِمْرَأَة",
 "奥がふかい": "سَحِيق, غَوْر (يَقَعُ فِي عُمْقٍ كَبِيرٍ أَوْ يَمْتَدُّ إِلَيْهِ؛ أَعْمَقُ مِنْ أَنْ يُسْبَرَ) / ثَقِيل, عَمِيق ((عَنِ النَّوْمِ) عَمِيقٌ وَتَامّ) / عَمِيقٌ مِنَ الأَعْمَاق (نَابِعٌ مِنْ أَعْمَاقِ النَّفْس) / بَالِغُ العُمْق, عَمِيقٌ جِدًّا (مِنْ أَشَدِّ دَرَجَاتِ الحِدَّةِ؛ تَامّ)",
 "奥が深い": "سَحِيق, غَوْر (يَقَعُ فِي عُمْقٍ كَبِيرٍ أَوْ يَمْتَدُّ إِلَيْهِ؛ أَعْمَقُ مِنْ أَنْ يُسْبَرَ) / ثَقِيل, عَمِيق ((عَنِ النَّوْمِ) عَمِيقٌ وَتَامّ) / عَمِيقٌ مِنَ الأَعْمَاق (نَابِعٌ مِنْ أَعْمَاقِ النَّفْس) / بَالِغُ العُمْق, عَمِيقٌ جِدًّا (مِنْ أَشَدِّ دَرَجَاتِ الحِدَّةِ؛ تَامّ)",
 "奥さま": "زَوْجَة, اِمْرَأَة",
 "奥さん": "زَوْجَة, اِمْرَأَة",
 "奥つ城": "قَبْر, ضَرِيح (مَدْفَنُ الإِنسان، وَجَمْعُهُ قُبُور، والمَقْبَرُ الْمَصْدَرُ)\nمثال: زار توم قبر ماري.",
 "奥つ城所": "مَقْبَرَة, مَقْبُرَة",
 "奥の手": "ورقة حكم, ورقة رابحة (ورقة لعب من النقش الذي تم إعلانه كحكم)\nمثال: آس الحكم هو فائز مؤكد / سِرّ, خَفِيَّة (شَعَرَ بِالسُّرُورِ) / سِرِّيّ\nمثال: السر سيبقى سرا. / شِمَال, يُسْرَى (الْجِهَةُ الْمُقَابِلَةُ لِلجَنُوب؛ رَأْسُ الْبَوْصَلَةِ الْمُقَابِلُ لِلجَنُوب)\nمثال: أعيش في شمال السويد.",
 "奥の深い": "عَمِيق, غَوِيط",
 "奥の院": "قدس الأقداس ((اليهودية) مزار مقدس يتكون من الغرفة الداخلية للمسكن في هيكل سليمان حيث كان يُحفظ تابوت العهد) / خلوة, قدس الأقداس (مكان ذو خصوصية لا تُنتهك)\nمثال: انسحب إلى خلوته حيث لا يمكن للأطفال الذهاب أبداً",
 "奥まって": "مُنْتَبِذ, مُنْعَزِل (يُوفِّر الخصوصية أو العزلة) / خَفِيّ, مَسْتُور (مُخبَّأ عن الأنظار العامّة أو الاستخدام العامّ)",
 "奥ゆかしい": "رَاقٍ, مُهَذَّب (يوحي بالذوق الرفيع واليسر والثراء) / مُحَسَّن, مُنَقَّح (دقيق إلى درجة رفيعة من الإحكام) / راق, مصقول ((للأشخاص وسلوكهم) مثقف ومهذب) / مكرر, منقى (منقى من الشوائب عن طريق المعالجة)\nمثال: كانت رقيقة ومهذبة وغير معتادة على المشقة / مُتْوَاضِع / مُحْتَشِم",
 "奥之院": "قدس الأقداس ((اليهودية) مزار مقدس يتكون من الغرفة الداخلية للمسكن في هيكل سليمان حيث كان يُحفظ تابوت العهد) / خلوة, قدس الأقداس (مكان ذو خصوصية لا تُنتهك)\nمثال: انسحب إلى خلوته حيث لا يمكن للأطفال الذهاب أبداً",
 "奥井": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "奥付": "علامة الناشر, كولوفون (شعار الناشر المطبوع في كتاب (عادة في صفحة العنوان))",
 "奥付け": "علامة الناشر, كولوفون (شعار الناشر المطبوع في كتاب (عادة في صفحة العنوان))",
 "奥儀": "جَوْهَر, مَاهِيَّة (جَوْهَر)\nمثال: الجمال في الجوهر لا المظهر",
 "奥原": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "奥向き": "أمور شخصية, شأن خاص (مسائل ذات اهتمام شخصي)\nمثال: رتب أموره الشخصية",
 "奥地": "جَوْفِيّ, دَاخِلِيّ (من وسط المنطقة أو البلاد أو قادم منه) / جَوَّانِيّ, دَاخِلِيّ (في الداخل وباتجاه المركز) / بَاطِنِيّ, دَاخِلِيّ (يقع في الداخل ويتعلق بالعالم النفسي والعقلي) / داخلي (يقع في أو مناسب لداخل مبنى)\nمثال: مشهد داخلي",
 "奥妙": "سِرّ, خَفِيَّة (شَعَرَ بِالسُّرُورِ) / سِرِّيّ\nمثال: السر سيبقى سرا.",
 "奥山": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "奥平": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "奥底": "أعماق, أغوار ((الجمع) الجزء الأعمق والأكثر بعداً)\nمثال: من أعماق أفريقيا المظلمة / قَاع (أَرْض مستوية سهلة تنصب إِليها مياه الأمطار فتمسكها ثم تُنبت العشب؛ القَعْر) / قَعْر / سَالِب\nمثال: نمت في قاعة السينما.",
 "奥座敷": "صَالُون, صَالَة (مجلسٌ يجتمع فيه بعض أعيان المجتمع عند أحدهم يناقشون فيه أمور الأدب والفنّ؛ هو المَجْلِس في البيت الذي يستقبلون فيه الضيوف، يسمه البعض غرفة الضيوف أو غرفة الاستقبال أو غرفة الخطار. )\nمثال: لدى زيري صالون حلاقة.",
 "奥手": "مُتَأَخِّر النُّضْج (من النباتات التي تنضج في الخريف)",
 "奥抜": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "奥方": "رَبَّة, رَبَّةْ اَلْبَيْت / خَاتُون, سَيِّدَة / لِيدِي",
 "奥書": "إضافة, ملحق (مادة نصية تضاف إلى منشور؛ عادة في النهاية) / تذييل, ملاحظة لاحقة (ملاحظة تضاف إلى رسالة بعد التوقيع)",
 "奥書き": "إضافة, ملحق (مادة نصية تضاف إلى منشور؛ عادة في النهاية) / تذييل, ملاحظة لاحقة (ملاحظة تضاف إلى رسالة بعد التوقيع)",
 "奥村": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "奥様": "زَوْجَة, اِمْرَأَة",
 "奥歯": "سن خلفية (سن تقع في مؤخرة الفم)",
 "奥歯にものが挟まる": "لَفَّ وَدَارَ",
 "奥歯に物が挟まる": "لَفَّ وَدَارَ",
 "奥津城": "قَبْر, ضَرِيح (مَدْفَنُ الإِنسان، وَجَمْعُهُ قُبُور، والمَقْبَرُ الْمَصْدَرُ)\nمثال: زار توم قبر ماري.",
 "奥深い": "سَحِيق, غَوْر (يَقَعُ فِي عُمْقٍ كَبِيرٍ أَوْ يَمْتَدُّ إِلَيْهِ؛ أَعْمَقُ مِنْ أَنْ يُسْبَرَ) / ثَقِيل, عَمِيق ((عَنِ النَّوْمِ) عَمِيقٌ وَتَامّ) / عَمِيقٌ مِنَ الأَعْمَاق (نَابِعٌ مِنْ أَعْمَاقِ النَّفْس) / بَالِغُ العُمْق, عَمِيقٌ جِدًّا (مِنْ أَشَدِّ دَرَجَاتِ الحِدَّةِ؛ تَامّ) / عَمِيق, غَوِيط",
 "奥深さ": "عَمْق",
 "奥田": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "奥義": "جَوْهَر, مَاهِيَّة (جَوْهَر)\nمثال: الجمال في الجوهر لا المظهر",
 "奥義秘伝": "سِرّ, خَفِيَّة (شَعَرَ بِالسُّرُورِ) / سِرِّيّ\nمثال: السر سيبقى سرا.",
 "奥行": "عَمْق",
