 "大辞典": "قاموس شامل, قاموس غير موجز (قاموس لم يتم تقصيره بحذف المصطلحات أو التعريفات؛ قاموس شامل)",
 "大辟": "إِعْدَام, عُقُوبَة الْإِعْدَام (في القانون: هي عقوبة يحددها القضاء على جريمة كبرى اقترفها المتهم وتؤدي إلى قتل…)\nمثال: محكم عليه بالإعدام.",
 "大農": "وَاسِع النِّطَاق (كبير بشكل غير معتاد في النطاق)",
 "大農園": "ضيعة, هاديندا (المنزل الرئيسي في مزرعة أو عزبة كبيرة)",
 "大農場": "مزرعة مواشي (مزرعة تتكون من مساحة كبيرة من الأرض مع المرافق اللازمة لتربية الماشية (وخاصة…)",
 "大迫": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "大迷惑": "الكثير, دفعة (عدد كبير أو كمية أو مدى كبير (وغالباً ما تتبعها كلمة 'من'))\nمثال: دفعة من الرسائل",
 "大逆": "خِيَانَة عُظْمَى",
 "大逆事件": "خِيَانَة عُظْمَى",
 "大逆無道": "شَنِيع, فَاحِش (بَالِغُ الشَّرِّ؛ إِجْرَامِيٌّ فِي أَعْمَاقِه)",
 "大逆罪": "خِيَانَة عُظْمَى",
 "大逆非道": "شَنِيع, فَاحِش (بَالِغُ الشَّرِّ؛ إِجْرَامِيٌّ فِي أَعْمَاقِه)",
 "大通": "جَادَّة (الجادّة : وَسَطُ الطَرِيق —حديث؛ جادة : شارع أو طَرِيق رئيس أو الطريق الأعظم…)\nمثال: كانت ماري جادة.",
 "大通り": "جَادَّة (الجادّة : وَسَطُ الطَرِيق —حديث؛ جادة : شارع أو طَرِيق رئيس أو الطريق الأعظم…)\nمثال: كانت ماري جادة.",
 "大連": "دَالْيَان",
 "大運動会": "رحلة خلوية, نزهة خلوية (يوم مخصص لتجمع اجتماعي في الهواء الطلق)",
 "大過去": "ماضي تام (زمن تام يُستخدم للتعبير عن حدث اكتمل في الماضي)",
 "大道": "جَادَّة (الجادّة : وَسَطُ الطَرِيق —حديث؛ جادة : شارع أو طَرِيق رئيس أو الطريق الأعظم…)\nمثال: كانت ماري جادة.",
 "大道具": "إعداد المسرح, ديكور المسرح (ترتيب المناظر والممتلكات لتمثيل المكان الذي تُمثل فيه مسرحية أو فيلم) / عامل مسرح (موظف في المسرح يؤدي الأعمال المتعلقة بإقامة عرض مسرحي)",
 "大道具方": "عامل مسرح (موظف في المسرح يؤدي الأعمال المتعلقة بإقامة عرض مسرحي)",
 "大道商人": "جَوَّال, بَائِع مُتَجَوِّل (صيغة مبالغة على وزن فَعَّال من الفعل جَالَ؛ كثير التجوّل، دائم التنقُّل من مكان…)\nمثال: اشتريت جوال مستعمل.",
 "大選挙区制": "نظام التصويت, نظام انتخابي (نظام قانوني لاتخاذ خيارات ديمقراطية)",
 "大邦": "قوة عالمية, قوة عظمى (دولة قوية بما يكفي للتأثير على الأحداث في جميع أنحاء العالم)",
 "大邱": "دَايْغُو",
 "大邸宅": "قَصْر (ضد الطول؛ غير تام، غير كامل)\nمثال: لقد قصر الخطاب.",
 "大部": "مُتَطَاوِل, مُطَوَّل (طَويل نِسْبِيًّا في المُدَّة؛ مُمْتَدّ بِشَكْل مُمِلّ) / أَكْثَر, أَغْلَب\nمثال: إنها غالية جدا!",
 "大部分": "غَالِبِيَّة, أَغْلَبِيّة",
 "大部屋": "غُرْفَةُ الاِنْتِظَار (اسم مفعول لما غُرِفَ من الماء وغيره باليد، الجمع غِرَاف؛ اسم؛ المكان في الدار…)\nمثال: الأب في الغرفة. / جناح, عنبر (مبنى يشكل قسماً من مستشفى (أو مجموعة من الغرف) يشترك فيه المرضى الذين يحتاجون…)\nمثال: وضعوها في جناح بأربعة أسرة / إدارَة المشاريع (هو عملية تولي تَصْرِيف شؤون العَمَل. لا جمع له؛ مجموع الناس الذين يقومون بإدارة…)\nمثال: والدتي تنتظرني في الإدارة.",
 "大部隊": "كَتِيبَة (الجيش أو القطعة منه مجتمعة؛ جماعة الخيل إذا أغارت من المائة إلى الأَلف)",
 "大都": "حَاضِرَة (خلاف البَادِيَة، وهي الأرض التي فيها عمران وزرع مثل المدن والقرى والضياع…)\nمثال: الصين حاضرة في إفريقيا.",
 "大都会": "حَاضِرَة (خلاف البَادِيَة، وهي الأرض التي فيها عمران وزرع مثل المدن والقرى والضياع…)\nمثال: الصين حاضرة في إفريقيا.",
 "大都市": "حَاضِرَة (خلاف البَادِيَة، وهي الأرض التي فيها عمران وزرع مثل المدن والقرى والضياع…)\nمثال: الصين حاضرة في إفريقيا.",
 "大都市圏": "مَديِنَةٌ ضَخْمَةٌ",
 "大酒": "خمر مقطر, مشروب روحي (مشروب كحولي يتم تقطيره بدلاً من تخميره)",
 "大酒家": "سكير, شارب الخمر (شخص يشرب المشروبات الكحولية (خاصة بإفراط))",
 "大野": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "大野貝": "محار ناعم الصدفة (محار صالح للأكل بصدفة رقيقة بيضاوية الشكل يوجد في المناطق الساحلية للولايات…)",
 "大量": "ضَخْم, هائِل الكُتْلَة (ذو كُتْلَة كَبيرَة؛ يَحْتَوي عَلى كَمِّيَّة هائِلَة مِن المادَّة)",
 "大量出血": "نَزِيف, نَزْف",
 "大量死": "جموع, حشد (كمية كبيرة غير محددة)\nمثال: حشد من النمل",
 "大量殺人": "قَتْل جَمَاعِيّ (تعمّد جعله يَمُوتُ، أزهق روحه، أمَاتَه متعمدا؛ الوقتَ: ضيعه بشيء غير ذي فائدة…)\nمثال: قتل الصياد دبا.",
 "大量殺人者": "قاتل جماعي (شخص مسؤول عن وفاة العديد من الضحايا في حادث واحد)",
 "大量殺害": "مَذْبَحَة, حَمَّام دَمّ (الحَادِثَة أو المَعْرَكَة التي يقتل فيها ناس كثيرون)",
 "大量注文": "مطلب صعب, مهمة شاقة (مهمة أو متطلب هائل)\nمثال: كان الانتهاء في الوقت المحدد مطلباً صعباً لكننا فعلنا ذلك",
 "大量生産": "إنتاج بالجملة, إنتاج ضخم (إنتاج كميات كبيرة من مادة موحدة (غالباً باستخدام تقنيات خط التجميع))",
 "大量発行": "وَاسِع النِّطَاق (كبير بشكل غير معتاد في النطاق)",
 "大量破壊兵器": "سِلَاح دَمَار شَامِل",
 "大量虐殺": "مَذْبَحَة, مَجْزَرَة (الحَادِثَة أو المَعْرَكَة التي يقتل فيها ناس كثيرون)\nمثال: قتل الصياد دبا.",
 "大量送信": "بريد بالجملة (بريد يتكون من أعداد كبيرة من العناصر المتطابقة (منشورات أو إعلانات) ترسل إلى…)",
 "大金星": "مُسْتَاء, مُمْتَعِض",
 "大金鶏菊": "أشرفية, بذر القراد",
 "大釘": "سنبلة",
 "大釜": "قِدْر (قضاء الله وحكمه وما قَدَّرَه؛ مبلغ الشيء وكميتّه، بنفس معنى قَدْر)\nمثال: خذ قدر ما تريد.",
 "大鋸屑": "نُشَارَة",
 "大鍋": "قِدْر (قضاء الله وحكمه وما قَدَّرَه؛ مبلغ الشيء وكميتّه، بنفس معنى قَدْر)\nمثال: خذ قدر ما تريد.",
 "大鎌": "مِنْجَل, مِقْضَب",
 "大鎧": "شَبِيهٌ بِالصُّنْدُوقِ, صُنْدُوقِيّ (يشبه الصندوق في استطالته)",
 "大鑑": "مَوْسُوعَة, دَائِرَة مَعَارِف (مُعْجَمٌ ضَخْمٌ يَضُمُّ مَعْلُومَاتٍ وَافِيَةً ومُرَكَّزَةً عَنِ الْمَعَارِفِ…)\nمثال: موسوعة رحلات العرب والمسلمين.",
 "大間違い": "خطأ فادح, زلة (خطأ محرج)",
 "大関": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "大阪": "أُوسَاكَا",
 "大阪民国": "أُوسَاكَا",
 "大降り": "عَاصِفَة",
 "大陪審": "هيئة محلفين كبرى (هيئة محلفين للتحقيق في اتهامات الجريمة وتقييم الأسس لتوجيه الاتهامات)",
 "大陰唇": "الشفران الكبيران (الطيتان الخارجيتان للفرج)",
 "大陸": "قَارَّة",
 "大陸会議": "الكُونْغَرِس القَارِّيّ (الجمعية التشريعية المكونة من مندوبين من المستعمرات المتمردة الذين اجتمعوا خلال…)",
 "大陸塊": "كراتون, كُتْلَة قَارِّيَّة (الجزء المستقر من القارة الذي يشكل الكتلة المركزية لها؛ عادة من عصر ما قبل…)",
 "大陸性": "قَارِّيّ",
 "大陸棚": "رصيف قاري (قاع البحر الضحل نسبياً (حتى 200 متر) المحيط بالقارة)",
 "大陸横断": "عَابِر لِلْقَارَّة (يمتد عبر القارة أو يعبرها أو يقع على الجانب الآخر منها)",
 "大陸法": "قَانُون مَدَنِيّ (مقياس كل شيء وطريقه؛ أمر كليّ ينطبق على جميع جزئياته التي تعرف أحكامها منه)\nمثال: ذكرني بالقانون.",
 "大陸狼": "ذئب الغياض, ذئب رمادي (ذئب ذو معطف رمادي مبقع يعيش في المناطق الشمالية المشجرة في أمريكا الشمالية)",
 "大陸的": "قَارِّيّ / هَادِئ",
 "大陸間弾道ミサイル": "صاروخ باليستي عابر للقارات (صاروخ باليستي قادر على السفر من قارة إلى أخرى)",
 "大陸間弾道弾": "صاروخ باليستي عابر للقارات (صاروخ باليستي قادر على السفر من قارة إلى أخرى)",
 "大隈": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "大隊": "كَتِيبَة (الجيش أو القطعة منه مجتمعة؛ جماعة الخيل إذا أغارت من المائة إلى الأَلف)",
 "大雑把": "خَشِن (صار خشناً أو غير ناعم؛ أصبح صلباً أو غليظ الملمس)\nمثال: زيري خشن الخلق. / غَيْر مُبَالِي (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "大難": "بَلَاء, بُؤْس",
 "大雨": "وَابِل, مَطَر غَزِير",
 "大静脈": "وريد أجوف (أي من وريدين كبيرين يعيدان الدم المستنفد للأكسجين إلى الأذين الأيمن للقلب)",
 "大韓民国": "جُمْهُورِيَة كُورِيَا",
 "大韓民国国軍": "جُمْهُورِيَة كُورِيَا",
 "大領": "رقعة, وصلة تقوية (قطعة من المادة تستخدم لتقوية أو توسيع الثوب)",
 "大頭": "طائر النفخة (طائر أمريكي استوائي بني اللون له رأس كبير بريش منفوش)",
 "大願": "مَطْمَح",
 "大風": "ريح عاتية, عاصفة (رياح قوية تتحرك بسرعة 45-90 عقدة؛ قوة 7 إلى 10 على مقياس بوفورت) / مُتَكَبِّر, مَغْرُور (شعب مُتكبِّر : مُتعجرف ، شامخ الرأس؛ مُتكَبِّر : فاعل من تَكَبَّر)\nمثال: هو متكبر للغاية. / هَادِئ",
 "大風呂敷": "عجرفة, غطرسة (تفاخر فارغ ومغرور)",
 "大食": "نَهَم, شَرَه",
 "大食い": "نَهَم, شَرَه / أكول, نهم (شخص ذكر مكرس للأكل والشرب بإفراط)",
 "大食らい": "أَكَّال, شَرَه",
 "大食家": "أكول, نهم (شخص ذكر مكرس للأكل والشرب بإفراط)",
 "大食漢": "أَكَّال, شَرَه",
 "大食細胞": "بَالِعَة, مَاكْرُوفَاج",
 "大騒ぎ": "جلبة, صخب (صيحات عالية ومستمرة من العديد من الناس)\nمثال: تجاهل صخب الحشد",
 "大騒動": "مَعْمَعَة",
 "大高": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "大魚": "رأس كبير, شخصية كبيرة (شخص مؤثر وهام)",
 "大鮃": "هَلْبُوت",
 "大鴉": "غُرَاب",
 "大鷭": "غُرَّة (بياض في جبهة الفرس فوق العينين أو بينهما وتحت الأذنين. انظر الصورة؛ أول يوم في…)",
 "大鷹": "باز شمالي / صَقَارَة",
 "大鷹狩": "صَقَارَة",
 "大鷹狩り": "صَقَارَة",
 "大鹿": "مُوظ",
 "大麦": "شَعِير",
 "大麦若葉": "شعير الحائط (عشب حولي أوروبي يوجد غالباً كعشبة ضارة في الأراضي المهملة خاصة على طول جوانب…)",
 "大麻": "قِنَّب / قِنَّب هِنْدِيّ",
 "大麻樹脂": "راتنج القنب, قنبين (راتنج يتم الحصول عليه من نبات القنب؛ يعتقد أنه العامل المخدر النشط في…)",
 "大麻草": "قِنَّب",
 "大麻蝿": "ذبابة اللحم (ذبابة تتغذى يرقاتها على الجيف أو لحم الحيوانات الحية)",
 "大麻蠅": "ذبابة اللحم (ذبابة تتغذى يرقاتها على الجيف أو لحم الحيوانات الحية)",
 "大黄": "راوند صيني, راوند كفي (يستخدم منذ فترة طويلة لخصائصه الملينة)",
 "大黒慈姑": "كستناء الماء, كستناء الماء الصينية (سعد صيني ينتج درنات صالحة للأكل على شكل بصيلة)",
 "大黒柱": "الحبل الرئيسي للسارية (الحبل الأمامي الذي يثبت الصاري الرئيسي)\nمثال: الإيمان هو ركيزته",
 "天": "سَمَاء, سما\nمثال: 彼は天を仰いだ。 — نظر إلى السماء. / رَبّ (رَبَّ الولدَ يَرُبُّ رَبًّا: ولِيَه وتعهده بما يغذيه وينميه ويؤدّبه؛ الفاعل:…)\nمثال: اعتني بي يا رب. / قِمَّة / وَحِيد\nمثال: سمكة ميناد ماتت",
 "天から降ったか地から湧いたか": "كَأَنَّ, كَأَنَّمَا (يفيد التشبيه)\nمثال: كأن هذه السيارة له.",
 "天が下": "عَلَنِيّ, عَامّ",
 "天が抜ける": "أَمْطَرَ بِغَزَارَة",
 "天つ": "سَمَاوِيّ",
 "天にも昇る気持ち": "اِبْتِهَاج, نَشْوَة (البَهْجَةُ: الحُسْنُ يُقَال: رَجُلٌ ذُو بَهْجَةٍ؛ وَيُقَال: هُوَ حُسْنُ لَونِ…)",
 "天に召される": "مَاتَ (للحَيّ: فقد الحَيَاة. مصدره مَوتَا ومِيتَة؛ للأرض: ليس فيها شيء حَيّ من النبات…)\nمثال: إعتقدت أنه مات.",
 "天に向かって唾を吐く": "مَنْ حَفَرَ حُفْرَةً لِأَخِيهِ وَقَعَ فِيهَا (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "天に唾する": "مَنْ حَفَرَ حُفْرَةً لِأَخِيهِ وَقَعَ فِيهَا (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "天の": "سَمَاوِيّ",
 "天の下": "عَلَنِيّ, عَامّ",
 "天の使い": "مَلَاك\nمثال: زيري ملك لنفسه.",
 "天の助け": "ضَرْبَة حَظّ (المرة الواحدة من الضَرْب؛ اللطمو أو الدقة أو الصكّة؛ ضربة طبل: دقة واحدة منه)\nمثال: تلقى مناد ضربة.",
 "天の原": "سَمَاء, سما",
 "天の声": "بشكل غير رسمي, ليس للنشر (ليس للاقتباس)\nمثال: تحدث للصحفي ليس للنشر",
 "天の川": "دَرْب اَلتَّبَّانَة (الدَّرْبُ: كُلُّ طريقٍ يصلُ بين مكانَيْن. يقال: مَنْ سار على الدَّرب وصل :…)\nمثال: درب على يد خبير.",
 "天の川銀河": "درب التبانة, مجرة درب التبانة (المجرة التي تحتوي على النظام الشمسي؛ تتكون من ملايين النجوم التي يمكن رؤيتها…)",
 "天の恵": "فضل إلهي, نعمة ((اللاهوت المسيحي) الفضل المجاني وغير المستحق من الله)\nمثال: تتجلى نعمة الله في خلاص الخطاة",
 "天の恵み": "فضل إلهي, نعمة ((اللاهوت المسيحي) الفضل المجاني وغير المستحق من الله)\nمثال: تتجلى نعمة الله في خلاص الخطاة",
 "天の河": "دَرْب اَلتَّبَّانَة (الدَّرْبُ: كُلُّ طريقٍ يصلُ بين مكانَيْن. يقال: مَنْ سار على الدَّرب وصل :…)\nمثال: درب على يد خبير.",
 "天の益人": "نَاس, خَلْق (اسم للجمع من بني آدم واحده إِنْسَان أو إِنْس)\nمثال: ضحك الناس عليه.",
 "天の美禄": "كُحُول, مَشْرُوب كُحُولِيّ (سَائِلٌ لاَ لَوْنَ لَهُ، لاَذِعُ الطَّعْمِ، يُسْتَخْرَجُ مِنْ تَخْمِيرِ بَعْضِ…)\nمثال: أكره ذوق الكحول.",
 "天の赤道": "الدائرة الاعتدالية, خط الاستواء السماوي (الدائرة العظمى على الكرة السماوية في منتصف المسافة بين القطبين السماويين)",
 "天の邪鬼": "انحراف, شذوذ (الانحراف المتعمد عما هو خير وصواب)\nمثال: سيكون هناك دائمًا قلة من الناس يجدون متعة في التنمر والإرهاب بدافع الانحراف",
 "天は自ら助くるものを助く": "اسعى يا عبدي وأنا أسعى معاك",
 "天は自ら助くる者を助く": "اسعى يا عبدي وأنا أسعى معاك",
 "天を仰ぎて唾す": "مَنْ حَفَرَ حُفْرَةً لِأَخِيهِ وَقَعَ فِيهَا (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "天を突く": "فَيَضَان",
 "天を衝く": "فَيَضَان",
 "天ん邪鬼": "انحراف, شذوذ (الانحراف المتعمد عما هو خير وصواب)\nمثال: سيكون هناك دائمًا قلة من الناس يجدون متعة في التنمر والإرهاب بدافع الانحراف",
 "天パン": "صينية بسكويت, صينية خبز (أداة طهي تتكون من صفيحة معدنية مستطيلة مسطحة تستخدم لخبز البسكويت أو الكعك)",
 "天上": "سَمَاوَات / مَوْت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي)\nمثال: لا اخاف الموت .",
 "天下": "مُجْتَمَع, جَمَاعَة (قد يقصد به المكان الذي يجتمع فيه الناس؛ مجموعة من الناس من طبقة اجتماعية واحدة…)\nمثال: سامي خطر للمجتمع. / لَا مَثِيلَ لَهُ, لَا نَظِيرَ لَهُ (بارز يفوق أيّ مقارنة؛ فريد لا يُضاهى) / شُوغُون",
 "天下ご免": "مُرَخَّص, مُعْتَمَد (حاصل على موافقة رسمية للعمل)",
 "天下の宝刀": "ورقة حكم, ورقة رابحة (ورقة لعب من النقش الذي تم إعلانه كحكم)\nمثال: آس الحكم هو فائز مؤكد",
 "天下り": "أَمْر (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة)\nمثال: إنه أمر مختلف .",
 "天下一品": "لَا مَثِيلَ لَهُ, لَا نَظِيرَ لَهُ (بارز يفوق أيّ مقارنة؛ فريد لا يُضاهى)",
 "天下分け目": "حَاسِم, مَصِيرِيّ",
 "天下周知": "أمر معروف للجميع, معلومات عامة (أي شيء معروف عموماً للجميع)",
 "天下太平": "مُرْتَاحُ اَلْبَالِ, خَالِي اَلْقَلْبِ",
 "天下御免": "مُرَخَّص, مُعْتَمَد (حاصل على موافقة رسمية للعمل)",
 "天下晴れて": "قَانُونِيّ",
 "天下泰平": "مُرْتَاحُ اَلْبَالِ, خَالِي اَلْقَلْبِ",
 "天下無双": "لَا مَثِيلَ لَهُ, لَا نَظِيرَ لَهُ (بارز يفوق أيّ مقارنة؛ فريد لا يُضاهى)",
 "天下無敵": "لَا مَثِيلَ لَهُ, لَا نَظِيرَ لَهُ (بارز يفوق أيّ مقارنة؛ فريد لا يُضاهى)",
 "天下無比": "لَا مَثِيلَ لَهُ, لَا نَظِيرَ لَهُ (بارز يفوق أيّ مقارنة؛ فريد لا يُضاهى)",
 "天下第一": "بِامْتِيَاز (بدرجة من التميز)\nمثال: هو السياسي النزيه بامتياز",
 "天与": "ضَرْبَة حَظّ (المرة الواحدة من الضَرْب؛ اللطمو أو الدقة أو الصكّة؛ ضربة طبل: دقة واحدة منه)\nمثال: تلقى مناد ضربة.",
 "天与の資": "ملكة, موهبة (قدرات أو صفات طبيعية)",
 "天主": "رَبّ (رَبَّ الولدَ يَرُبُّ رَبًّا: ولِيَه وتعهده بما يغذيه وينميه ويؤدّبه؛ الفاعل:…)\nمثال: اعتني بي يا رب.",
 "天主堂": "كَنِيسَة, كَنَائِس (محلّ العبادة عند المسيحيين؛ جماعة المؤمنين بدين المسيح)\nمثال: أين أقرب كنيسة ؟",
 "天主教": "كَاثُولِيكِيَّة, جَاثَلِيقِيَّة",
 "天乃": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "天井": "سَقْف ((سَقَفَ) البيت ونحوه سقفا: عمل له سقفا)\nمثال: نظرت إلى السقف.",
 "天井抜け": "شمروخ, صاروخ ألعاب نارية (يرسل عرضًا للألعاب النارية عاليًا في السماء)",
 "天井桟敷": "مَعْرِض, صَالَةُ عَرْض",
 "天井棧敷": "مَعْرِض, صَالَةُ عَرْض",
 "天井知らず": "شمروخ, صاروخ ألعاب نارية (يرسل عرضًا للألعاب النارية عاليًا في السماء)",
 "天井裏": "عِلِّيَّة (الغُرْفَة إذا كانت في الطابق الأعلى. استخدام قديم؛ غُرْفَة في أعلى المَنْزِل…)",
 "天体": "جِرْم سَمَاوِيّ, جِرْم فَلَكِيّ (جَرَم الشَّخْصُ: أَذْنَبَ وَاكتَسَبَ الإِثْمَ؛ جَرَم نفسَه\nمثال: الإهمال هو نوع من الضرر أو الجرم",
 "天体力学": "ميكانيكا سماوية",
 "天体崇拝": "تنجيم, عبادة الكواكب (عبادة الكواكب أو النجوم)",
 "天体暦": "تقويم فلكي, زيج (منشور سنوي يحتوي على جداول فلكية تعطي مواقع الأجرام السماوية على مدار العام)\nمثال: اليوم تقوم أجهزة الكمبيوتر بحساب التقاويم الفلكية",
 "天体望遠鏡": "تلسكوب فلكي, مقرب فلكي (أي تلسكوب مصمم لجمع وتسجيل الإشعاع الكهرومغناطيسي من المصادر الكونية)",
 "天体物理学": "فِزِيَاء الفَلَكِيَّة",
 "天体観測": "تحديق في النجوم (مراقبة النجوم)",
 "天使": "مَلَاك\nمثال: زيري ملك لنفسه.",
 "天使の輪": "هَالَة",
 "天候": "طَقْس, جَوّ",
 "天候不順": "طقس سيء, قسوة الطقس (طقس غير مناسب للأنشطة الخارجية)",
 "天分": "مَوْهِبَة",
 "天刑病": "جذام, مرض هانسن (مرض حبيبي مزمن وسار يحدث في المناطق الاستوائية وشبه الاستوائية؛ يتميز بعقيدات…)",
 "天則": "شريعة, قانون (قاعدة أو مجموعة قواعد للسلوك متأصلة في الطبيعة البشرية وضرورية أو ملزمة للمجتمع…)",
 "天動説": "نموذج مركزية الأرض (اعتقاد بأن الأرض هي مركز الكون ولا تتحرك)",
 "天南": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "天南星": "قلقاس هندي, لوف مبقع (لوف أوروبي شائع ذو قنابة سنانية الشكل وطلع أرجواني قصير؛ يظهر في أوائل الربيع…)",
 "天命": "إرادة إلهية, مشيئة الله (القدرة المطلقة لكائن إلهي)",
 "天啓": "وَحْي, تَنْزِيل (الإعلام في الخفاء، وهذا أصل الكلمة؛ الإلهام، سواء كان غريزيّ أو فطريّ أو فنيّ…)\nمثال: يا رسول الله، كيف يأتيك الوحي ؟",
 "天国": "جَنَّة (أرض محاطة بسُور فيها نخل وشجر وكروم، البُسْتَان؛ الحَدِيقَة أو الحَائِط)\nمثال: هواوي جنة على الأرض.",
 "天地": "كَوْن, الْكَوْن / بَرّ, أَرْض (أحسن إلى والديه أو إلى غيره بالخير والاحترام؛ صدق أو وفى بوعد أو عهد)\nمثال: دخل زيري إلى منطقة ببر.",
 "天地創造": "خِلْقَة, خَلْق\nمثال: زيري سيء الخلق.",
 "天地否": "بِي, پِي",
 "天城": "اسم مكان (الاسم الذي يُعرف به مكان جغرافي) / لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "天埜": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "天堂": "جَنَّة (أرض محاطة بسُور فيها نخل وشجر وكروم، البُسْتَان؛ الحَدِيقَة أو الحَائِط)\nمثال: هواوي جنة على الأرض.",
 "天変地夭": "كارثة طبيعية",
 "天変地妖": "كارثة طبيعية",
 "天変地異": "كارثة طبيعية",
 "天女目": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "天子": "قَيْصَر, إِمْبْرَاطُور",
 "天孫": "قَيْصَر, إِمْبْرَاطُور",
 "天守閣": "اِحْتَفَظَ, أَبْقَى",
 "天宮": "سَمَاء, سما",
 "天宮図": "خَرِيطَةُ الْبُرُوج, أَبْرَاج (الخَارِطَة، رسم عليه تضاريس الأرض وحدودها)\nمثال: انظر إلى الخريطة.",
 "天山": "بشكل كبير",
 "天山遯": "أَسْمَر رَمَادِيّ (بلون بني رمادي باهت إلى رمادي مائل للبني)\nمثال: ارتدت لوناً أشهب",
 "天川": "مَاكَاوْ, أَوْمِين",
 "天帝": "رَبّ (رَبَّ الولدَ يَرُبُّ رَبًّا: ولِيَه وتعهده بما يغذيه وينميه ويؤدّبه؛ الفاعل:…)\nمثال: اعتني بي يا رب.",
 "天帝星": "الجُدَيّ, نَجْم الشَمَال",
 "天幕": "خَيْمَة (هو البَيْت الذي يقام من أعواد الشَجَر يُلقى عليه نَبَات يستطل به في الحَرّ…)\nمثال: سرقت خيمة كارل.",
 "天幕製造人": "صانع خيام (شخص يصنع أو يصلح الخيام)",
 "天幕造り": "صانع خيام (شخص يصنع أو يصلح الخيام)",
 "天底": "نَظِير",
 "天府": "رقاص الساعة, عجلة التوازن (عجلة تنظم معدل الحركة في الآلة؛ وخاصة عجلة تتذبذب مقابل النابض الشعري في الساعة…)",
 "天心": "سَمْت, ذُرْوَة ((سَمَتَ) سمتا: حسن سمته؛ (سَمَتَ): سار على الطريق بالظن)\nمثال: سمت ابنتها ماري. / بروفيدنس",
 "天性": "طَبِيعَة, طبيعة",
 "天恵": "موارد طبيعية (موارد (فعلية ومحتملة) توفرها الطبيعة)",
 "天意": "بروفيدنس",
 "天成": "طَبِيعَة, طبيعة",
 "天才": "عَبْقَرِيّ, نَابِغَة",
 "天才児": "طفل عبقري (الصَغِير السِنّ من الحَيْوَان أو الإنْسَان، وَلَد الإنسان أو الحيوان؛ الإنسان…)\nمثال: هو طفل العائلة.",
 "天才的": "موهوب (وهبه الله موهبة أو مواهب)\nمثال: كاتب موهوب",
 "天文": "فَلَك, عِلْم الْفَلَك (التَلّ المستدير من الرَمْل حوله فَضَاء؛ المَدَار يسبح فيه الجُرْم السماويّ)\nمثال: أصبح زيري عالم فلك.",
 "天文単位": "وَحْدَة فَلَكِيَّة",
 "天文台": "مَرْصَد",
 "天文学": "فَلَك, عِلْم الْفَلَك (التَلّ المستدير من الرَمْل حوله فَضَاء؛ المَدَار يسبح فيه الجُرْم السماويّ)\nمثال: أصبح زيري عالم فلك.",
 "天文学的": "فَلَكِيّ",
 "天文学者": "عَالِم فَلَك, فَلَكِي (الذي يعلم؛ متخصص في عِلْم ما وباحث فيه)\nمثال: هو عالم أحيائي.",
 "天文家": "عَالِم فَلَك, فَلَكِي (الذي يعلم؛ متخصص في عِلْم ما وباحث فيه)\nمثال: هو عالم أحيائي.",
 "天文航法": "ملاحة فلكية (الملاحة وفقًا لمواقع النجوم)",
 "天文館": "القبة السماوية, نموذج النظام الشمسي (جهاز أو نموذج لتمثيل الأنظمة الشمسية)",
 "天日": "شَمْس, شمس (الشَّمْسُ: النَّجْمُ الرئيسُ الذي تدور حوله الْأَرْض، وسائر كواكب المجموعة…)",
 "天日塩": "مُجَفَّف بِالشَّمْس (مُجَفَّف طَبِيعِيًّا بِأَشِعَّة الشَّمْس)",
 "天日瓦": "مُجَفَّف بِالشَّمْس (مُجَفَّف طَبِيعِيًّا بِأَشِعَّة الشَّمْس)",
 "天明": "فَجْر (هو آخر اللَيْل أو أول النَهَار حين تنصدع الظُلْمَة من النُور)\nمثال: فجر توم البالونة.",
 "天星": "جِرْم سَمَاوِيّ, جِرْم فَلَكِيّ (جَرَم الشَّخْصُ: أَذْنَبَ وَاكتَسَبَ الإِثْمَ؛ جَرَم نفسَه",
 "天本": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "天来": "سَمَاوِيّ",
 "天板": "قِمَّة / صينية بسكويت, صينية خبز (أداة طهي تتكون من صفيحة معدنية مستطيلة مسطحة تستخدم لخبز البسكويت أو الكعك)",
 "天桴": "رقاص الساعة, عجلة التوازن (عجلة تنظم معدل الحركة في الآلة؛ وخاصة عجلة تتذبذب مقابل النابض الشعري في الساعة…)",
 "天極": "قطب, قطب سماوي (إحدى نقطتي تقاطع محور الأرض والكرة السماوية)",
 "天機": "تخلص, تصريف (فعل أو وسيلة التخلص من شيء ما)\nمثال: لديه مزاج سعيد",
 "天気": "طَقْس, جَوّ / إشراق, طقس صحو (طقس معتدل؛ مناسب للأنشطة الخارجية)",
 "天気予報": "تَوَقُّع جَوِّيّ, تَوَقُّع طَقْس",
 "天気具合": "أحوال جوية, طقس (الظروف الجوية التي تشكل حالة الغلاف الجوي من حيث درجة الحرارة والرياح والسحب…)\nمثال: كانوا يأملون في طقس جيد",
 "天気図": "خريطة الطقس ((الأرصاد الجوية) خريطة تظهر عناصر الأرصاد الجوية الرئيسية في وقت معين وعلى…)",
 "天気模様": "أحوال جوية, طقس (الظروف الجوية التي تشكل حالة الغلاف الجوي من حيث درجة الحرارة والرياح والسحب…)\nمثال: كانوا يأملون في طقس جيد",
 "天気相談所": "مكتب الأرصاد الجوية (وحدة إدارية مسؤولة عن جمع وتفسير بيانات الأرصاد الجوية لدراسة الطقس والتنبؤات)",
 "天気運": "أحوال جوية, طقس (الظروف الجوية التي تشكل حالة الغلاف الجوي من حيث درجة الحرارة والرياح والسحب…)\nمثال: كانوا يأملون في طقس جيد",
 "天気都合": "أحوال جوية, طقس (الظروف الجوية التي تشكل حالة الغلاف الجوي من حيث درجة الحرارة والرياح والسحب…)\nمثال: كانوا يأملون في طقس جيد",
 "天水桶": "برميل مياه الأمطار (برميل يستخدم كصهريج لحفظ مياه الأمطار)",
 "天水訟": "أُغْنِيَّة, أُغْنِيَة (الجمع : أُغْنِيَات و أغانٍ؛ الأُغنيَة المقتسمة : ( الموسيقى ) قطعة موسيقيَّة…)\nمثال: أنا أغني أغنية.",
 "天河": "دَرْب اَلتَّبَّانَة (الدَّرْبُ: كُلُّ طريقٍ يصلُ بين مكانَيْن. يقال: مَنْ سار على الدَّرب وصل :…)\nمثال: درب على يد خبير.",
 "天津": "تْيَانْجِين",
 "天津御姉": "قَيْصَر, إِمْبْرَاطُور",
 "天津甘栗": "أبو فروة, كستناء أوروبية (برية أو مزروعة في جميع أنحاء جنوب أوروبا وشمال غرب أفريقيا وجنوب غرب آسيا)",
 "天海": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "天涯": "أُفُق ((أَفِقَ) أفَقَاً: بلغ النِّهَايَة فِي الْكَرم وَالْعلم فَهُوَ أفق وأفيق)\nمثال: طلعت الشمس فوق الأفق.",
 "天測航法": "ملاحة فلكية (الملاحة وفقًا لمواقع النجوم)",
 "天漢": "دَرْب اَلتَّبَّانَة (الدَّرْبُ: كُلُّ طريقٍ يصلُ بين مكانَيْن. يقال: مَنْ سار على الدَّرب وصل :…)\nمثال: درب على يد خبير.",
 "天火": "فُرْن, تَنُّور",
 "天災": "كارثة طبيعية",
 "天災地変": "كارثة طبيعية",
 "天為": "رَبَّانِيّ, مِنْ عِنَايَةِ السَّمَاء (مُنَاسِبٌ أَوْ مَحْظُوظٌ بِشَكْلٍ اسْتِثْنَائِيٍّ كَأَنَّمَا بِتَدَخُّلٍ…)\nمثال: الافتراض بأن الطبيعة تعمل فقط وفقاً لخطة عناية إلهية",
 "天無人": "اِثْنَانِ, اِثْنَتَانِ (في اِثْنان هو رقم مرتبته بين الواحد والثلاثة)",
 "天然": "طَبِيعَة, طبيعة",
 "天然に": "بالطبع, بطبيعة الحال (كما هو متوقع)\nمثال: بطبيعة الحال، أرسل لنا المحامي فاتورة ضخمة",
 "天然ガス": "غَاز طَبِيعِيّ",
 "天然ガラス": "زجاج طبيعي (صهارة بركانية بردت بسرعة كبيرة جداً)",
 "天然ゴム": "مطاط, مطاط طبيعي (مادة مرنة يتم الحصول عليها من عصارة اللاتكس للأشجار (خاصة أشجار جنس الهيفيا…)",
 "天然型": "طَبِيعِيّ الوُجُود, مَوْجُود بِالطَّبِيعَة (موجود بالطبيعة ودون تدخّل اصطناعي)",
 "天然樹脂": "راتنج طبيعي (إفرازات نباتية)",
 "天然水": "مياه الينابيع (مياه من نبع طبيعي)",
 "天然由来": "طَبِيعِيّ الوُجُود, مَوْجُود بِالطَّبِيعَة (موجود بالطبيعة ودون تدخّل اصطناعي)",
 "天然痘": "جُدَرِيّ\nمثال: 今ではみんな天然痘には免疫になっている。 — عند كل الناس مناعةٌ من الجدري اليوم.",
 "天然硝子": "زجاج طبيعي (صهارة بركانية بردت بسرعة كبيرة جداً)",
 "天然繊維": "ألياف طبيعية (ألياف مشتقة من النباتات أو الحيوانات)",
 "天然自然": "طَبِيعِيّ / بالطبع, بطبيعة الحال (كما هو متوقع)\nمثال: بطبيعة الحال، أرسل لنا المحامي فاتورة ضخمة",
 "天然色": "تكنيكولور (طريقة ذات علامة تجارية لصنع صور متحركة ملونة)",
 "天然資源": "موارد طبيعية (موارد (فعلية ومحتملة) توفرها الطبيعة)",
 "天然資源保護論者": "بِيئِيّ, مُدافِع عَن البِيئَة (شخص يعمل لحماية البيئة من الدمار أو التلوث)",
 "天照": "أَمَاتِيرَاسُو",
 "天父": "رَبّ (رَبَّ الولدَ يَرُبُّ رَبًّا: ولِيَه وتعهده بما يغذيه وينميه ويؤدّبه؛ الفاعل:…)\nمثال: اعتني بي يا رب.",
 "天牛": "خنفساء طويلة القرون (خنفساء طويلة الجسم لها قرون استشعار طويلة جداً)",
 "天狗": "مُتَوَرِّد, مُحْمَرّ ((خاصة للوجه) محمر أو مشبع بالدم من الانفعال أو المجهود) / تبجح, تفاخر (حالة من الحديث المتباهي)\nمثال: تبجحه أسوأ من قتاله",
 "天狗フルーツ蝙蝠": "خفاش أنبوبي الأنف (أي من خفافيش الفاكهة المتنوعة التي تتميز بفتحات أنف ممتدة إلى أنابيب متباعدة)",
 "天狗俳諧": "لعبة صالون (لعبة مناسبة للعب في الصالون)",
 "天狗巣病": "مكنسة الساحرة (نمو غير طبيعي كثيف (متكتل) للأغصان الصغيرة على شجرة أو شجيرة ناتج عن فطريات أو…)",
 "天狗猿": "قرد الململة, قرد ذو خرطوم (قرد من بورنيو له أنف بصلي طويل)",
 "天狼": "اَلشِّعْرَى, الشِّعْرَى الْيَمَانِيَّة",
 "天狼星": "اَلشِّعْرَى, الشِّعْرَى الْيَمَانِيَّة",
 "天王山": "حدث مفصلي, علامة بارزة (حدث يمثل تغييراً تاريخياً فريداً أو مهماً في المسار أو تعتمد عليه تطورات مهمة)\nمثال: كانت الاتفاقية نقطة تحول في تاريخ كلتا الدولتين",
 "天王星": "أُورَانُوس",
 "天球": "قُبَّة سَمَاوِيَّةٍ",
 "天球儀": "كرة سماوية, مجسم الكرة السماوية (كرة تعد نموذجاً كروياً للسماوات)",
 "天球図": "خَرِيطَةُ الْبُرُوج, أَبْرَاج (الخَارِطَة، رسم عليه تضاريس الأرض وحدودها)\nمثال: انظر إلى الخريطة.",
 "天理": "شريعة, قانون (قاعدة أو مجموعة قواعد للسلوك متأصلة في الطبيعة البشرية وضرورية أو ملزمة للمجتمع…)",
 "天瓜粉": "بودرة التلك, تلك (بودرة تجميل مصنوعة من التلك المنقى وعادة ما تكون معطرة؛ تمتص الرطوبة الزائدة)",
 "天生": "طَبِيعِيّ الوُجُود, مَوْجُود بِالطَّبِيعَة (موجود بالطبيعة ودون تدخّل اصطناعي)",
 "天界": "سَمَاوَات",
 "天疱瘡": "فُقَاع (هو الخَمْر إذا أخرج فُقَاعَات)\nمثال: مجرد فقاعة صابون.",
 "天盤": "سَقْف, سَطْح ((سَقَفَ) البيت ونحوه سقفا: عمل له سقفا)\nمثال: نظرت إلى السقف.",
 "天真": "بَسَاطَة, سَذَاجَة (نقص في التطور أو الخبرة الدنيوية)",
 "天真爛漫": "بَرِيء, بَرِيئَة",
 "天眼通": "إدراك خارج الحواس, استبصار (قوة ظاهرية لإدراك أشياء غير موجودة للحواس)",
 "天眼鏡": "عَدَسَةٌ مُكَبِّرَة",
 "天神髭": "عُثْنُون",
 "天秤": "مِيزَان (آلة تُوزن بها الأشياء ويُعْرف مِقْدارها؛ عَدْل)",
 "天秤にかける": "وَزَنَ",
 "天秤に掛ける": "وَزَنَ",
 "天秤ばかり": "رَصِيد",
 "天秤宮": "بُرْج اَلْمِيزَان, اَلْمِيزَان (ظهر وارتفع)\nمثال: وصل كارل إلى برج آخر.",
 "天秤座": "بُرْج اَلْمِيزَان, اَلْمِيزَان (ظهر وارتفع)\nمثال: وصل كارل إلى برج آخر.",
 "天秤秤": "رَصِيد",
 "天空": "سَمَاء, سما",
 "天空海濶": "سَمْح, كَرِيم النَّفْس (سخي ومتفهم ومتسامح)",
 "天空海闊": "سَمْح, كَرِيم النَّفْس (سخي ومتفهم ومتسامح)",
 "天窓": "فتحة سقف, منور (نافذة في السقف للسماح بدخول ضوء النهار) / رَئِيس, رَئِيسَة",
 "天童": "كَارُوبِيم, شِيرُوبِيم",
 "天竺": "الْهِنْد, الهند (في جنوب قارة آسيا؛ اسمها الرسمي جمهورية الهند، وعاصمتها نيودلهي)\nمثال: يبدو أنك من الهند. / أَجْنَبِيّ",
 "天竺牡丹": "دَالِيَّا",
 "天竺葵": "غُرْنُوق",
 "天竺鼠": "خِنْزِير غِينِيَّا",
 "天罰": "بلاء, لعنة (شيء يسبب البؤس أو الموت)\nمثال: لعنة حياتي / جزاء عادل, قصاص (نتيجة (جيدة أو سيئة) مستحقة ومناسبة)",
 "天翔ける": "تحليق لأعلى, صعود سريع (فعل الارتفاع لأعلى في الهواء)",
 "天翔る": "تحليق لأعلى, صعود سريع (فعل الارتفاع لأعلى في الهواء)",
 "天職": "رِسَالَة, نداء",
 "天色": "طَقْس, جَوّ",
 "天花": "ثَلْج (ثلَجتنا السماء: مطَرَتنا، ألقت علينا الثلج؛ ثلَجت نفسي: اشتَفَت به، واطمأنت إليه)\nمثال: سامي يحب الثلج.",
 "天花粉": "بودرة التلك, تلك (بودرة تجميل مصنوعة من التلك المنقى وعادة ما تكون معطرة؛ تمتص الرطوبة الزائدة)",
 "天草": "أغار, أغار أغار (مستخلص غرواني من الطحالب؛ يستخدم خاصة في أوساط الاستنبات وكعامل تبلور في الأطعمة)",
 "天華": "ثَلْج (ثلَجتنا السماء: مطَرَتنا، ألقت علينا الثلج؛ ثلَجت نفسي: اشتَفَت به، واطمأنت إليه)\nمثال: سامي يحب الثلج.",
 "天蓋": "سقفية, ظلة (غطاء (عادة من القماش) يعمل كسقف لحماية منطقة ما من الطقس)",
 "天蓋つき": "ذُو مِظَلَّة, مُظَلَّل (مغطى بمظلة أو ما يشبهها)",
 "天蓋付き": "ذُو مِظَلَّة, مُظَلَّل (مغطى بمظلة أو ما يشبهها)",
 "天蚕": "بلوط ياباني (شجرة صغيرة دائمة الخضرة من الصين والياباني)",
 "天蛾": "عثة الصقر (أي من العث المتنوع ذو أجنحة أمامية ضيقة طويلة قادرة على الطيران القوي والتحويم…)",
 "天蝎宮": "بُرْج اَلْعَقْرَب, اَلْعَقْرَب (ظهر وارتفع)\nمثال: وصل كارل إلى برج آخر.",
 "天蠍宮": "بُرْج اَلْعَقْرَب, اَلْعَقْرَب (ظهر وارتفع)\nمثال: وصل كارل إلى برج آخر.",
 "天衣無縫": "بِلَا عَيْب, خَالٍ مِنَ العُيُوب (خالٍ من أيّ عيب أو شائبة)",
 "天袋": "مساحة تخزين (المنطقة في أي هيكل توفر مساحة للتخزين)",
 "天警": "رَبَّانِيّ, مِنْ عِنَايَةِ السَّمَاء (مُنَاسِبٌ أَوْ مَحْظُوظٌ بِشَكْلٍ اسْتِثْنَائِيٍّ كَأَنَّمَا بِتَدَخُّلٍ…)",
 "天象": "طَقْس, جَوّ",
 "天象儀": "القبة السماوية, نموذج النظام الشمسي (جهاز أو نموذج لتمثيل الأنظمة الشمسية)",
 "天資": "طَبِيعَة, طبيعة",
 "天賦": "طَبِيعِيّ",
 "天辺": "قِمَّة / فَرْوَة اَلرَّأْس",
 "天運": "قدر, مصير (حدث (أو مسار أحداث) سيحدث حتماً في المستقبل)\nمثال: نحن عاجزون أمام القدر",
 "天道": "شَمْس, شمس (الشَّمْسُ: النَّجْمُ الرئيسُ الذي تدور حوله الْأَرْض، وسائر كواكب المجموعة…)",
 "天道乾": "مُجَفَّف بِالشَّمْس (مُجَفَّف طَبِيعِيًّا بِأَشِعَّة الشَّمْس)",
 "天道干し": "مُجَفَّف بِالشَّمْس (مُجَفَّف طَبِيعِيًّا بِأَشِعَّة الشَّمْس)",
 "天道様": "شَمْس, شمس (الشَّمْسُ: النَّجْمُ الرئيسُ الذي تدور حوله الْأَرْض، وسائر كواكب المجموعة…)",
 "天道虫": "خنفساء أبو العيد, دعسوقة (خنفساء صغيرة مستديرة زاهية الألوان ومرقطة تتغذى عادة على المن والآفات الحشرية…)",
 "天邪鬼": "انحراف, شذوذ (الانحراف المتعمد عما هو خير وصواب)\nمثال: سيكون هناك دائمًا قلة من الناس يجدون متعة في التنمر والإرهاب بدافع الانحراف",
 "天野": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "天際": "أُفُق ((أَفِقَ) أفَقَاً: بلغ النِّهَايَة فِي الْكَرم وَالْعلم فَهُوَ أفق وأفيق)\nمثال: طلعت الشمس فوق الأفق.",
 "天雷": "رَعْد, رعد (الصَوْت الذي يصدر حين تفرغ الغَيْمَة شحنة كَهْرَبَائيَّة إلى غَيْمَة أخرى أو…)\nمثال: البرق يسبق الرعد",
 "天青石": "سلستيت (معدن يتكون من كبريتات السترونشيوم)",
 "天面": "سطح علوي (الجانب الذي يكون في الأعلى)",
 "天頂": "سَمْت, ذُرْوَة ((سَمَتَ) سمتا: حسن سمته؛ (سَمَتَ): سار على الطريق بالظن)\nمثال: سمت ابنتها ماري.",
 "天頂点": "سَمْت, ذُرْوَة ((سَمَتَ) سمتا: حسن سمته؛ (سَمَتَ): سار على الطريق بالظن)\nمثال: سمت ابنتها ماري.",
 "天香国色": "عُود الصَّلِيب, فَاوَانِيَا (قطعة من الخشب كالعصا جمعه عيدان؛ ما يُتَبَخَّر به)",
 "天馬": "حِصَان مُجَنِّح (الواحد الذكر من الخَيْل؛ يطلق مجازًا على الواحد من الخيل الذي لا يُعرف ذكر كان…)\nمثال: لم يشفى الحصان.",
 "天馬座": "حِصَان مُجَنِّح (الواحد الذكر من الخَيْل؛ يطلق مجازًا على الواحد من الخيل الذي لا يُعرف ذكر كان…)\nمثال: لم يشفى الحصان.",
 "天駆ける": "تحليق لأعلى, صعود سريع (فعل الارتفاع لأعلى في الهواء)",
 "天鵝絨": "مُخْمَل, قَطِيفَة",
 "天鵞": "تَمّ, قُقْنُس",
 "天鵞絨": "مُخْمَل, قَطِيفَة",
 "天鼠": "وَطْوَاط, خُفَّاش",
 "太": "سَمِين, بَدِين\nمثال: توم بدهن غرفته. / جَلِيل, فَخْم (يُوصَف بِهِ مَظْهَر الشَّخْص أَوْ سُلُوكه؛ يَلِيق بِشَخْصٍ بَارِز)",
 "太々": "زَوْجَة, اِمْرَأَة",
 "太い": "سَمِين, بَدِين\nمثال: توم بدهن غرفته. / عَمِيق, غَوِيط / جَرِيء, جَسُور",
 "太った": "سمين",
 "太っちょ": "دسم, دهني (يحتوي على أو يتكون من الدهون)\nمثال: طعام دسم",
 "太っ腹": "كَرِيم (نبيل النفس عزيزها ذو الخلق العالي والخير الكثير والعطاء السخي. الكَرَم يشمل…)\nمثال: يا لك من رجل كريم!",
 "太ましい": "بَدِين بِلُطْف, مُمْتَلِئ (سَمِين بِمَا يَكْفِي لِيَكُون مُمْتَلِئًا بِشَكْلٍ مُحَبَّب)",
 "太め": "سمين",
 "太もも": "فَخِذ, فَخْذ / أرداف, ألية (الجزء اللحمي من جسم الإنسان الذي يجلس عليه)\nمثال: يستحق ركلة جيدة في مؤخرته",
 "太りぎみ": "سمين",
