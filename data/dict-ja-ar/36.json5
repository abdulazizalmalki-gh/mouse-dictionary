 "大望": "أَمَل ((أَمَّلَه): أَمَلَهُ يُقَال: فلَان بَحر المؤمل)\nمثال: أشعر بخيبة أمل.",
 "大木": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "大木戸": "حَاجِز, نُقْطَة تَفْتِيش",
 "大本": "إِنْشاء, إِشَادَة (مصدر للفعل \"أَنْشَأَ\")\nمثال: إنشاء موقع إلكتروني بدون أي تكلفة؟ / جَذْر, جدر (جِذْرُ ٱلشَّيْءِ هُوَ: أَصْلُهُ؛ في : جذر العدد النوني هو عدد ما إذا رفعناه…)\nمثال: أحسب جذر خمسة بالآلة الحاسبة.",
 "大杉": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "大村": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "大林": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "大枝": "غُصْن",
 "大枠": "عُمُومًا",
 "大柄": "مُتَكَبِّر, مَغْرُور (شعب مُتكبِّر : مُتعجرف ، شامخ الرأس؛ مُتكَبِّر : فاعل من تَكَبَّر)\nمثال: هو متكبر للغاية.",
 "大根": "فِجْل (فَجَّلَ الشيءَ تعني عرَّضَهُ، أي جعله مكشوفًا أو ظاهرًا. يمكن استخدام الفعل…) / ممثل مبالغ, ممثل متصنع (ممثل غير ماهر يبالغ في الأداء التمثيلي) / جَذْر, جدر (جِذْرُ ٱلشَّيْءِ هُوَ: أَصْلُهُ؛ في : جذر العدد النوني هو عدد ما إذا رفعناه…)\nمثال: أحسب جذر خمسة بالآلة الحاسبة.",
 "大根役者": "ممثل مبالغ, ممثل متصنع (ممثل غير ماهر يبالغ في الأداء التمثيلي)",
 "大棗": "عُنَّاب",
 "大棟": "سلسلة جبال",
 "大森": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "大業物": "بشكل ممتاز, على ما يرام (بشكل جيد جداً)\nمثال: إنها لا تشعر أنها على ما يرام اليوم",
 "大概": "عُمُومًا / أَكْثَر, أَغْلَب\nمثال: إنها غالية جدا! / لُبّ / مِن اَلْمُحْتَمَل, رُبَّمَا (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "大様": "خَيِّر, طَيِّب القَلْب (يُظهر التعاطف والتفهّم والسخاء أو مدفوع بها) / هادئ, ساكن",
 "大槻": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "大権": "حَكَم, فيصل (شخص لديه السلطة لتسوية الأمور حسب إرادته)\nمثال: كانت هي الحكم النهائي في جميع مسائل الموضة",
 "大樹": "سيكويا عملاقة (شجرة دائمة الخضرة شاهقة الارتفاع في الطرف الجنوبي من التلال الغربية لسييرا…)",
 "大樺斑": "فراشة الصقلاب, فراشة الملك (فراشة أمريكية مهاجرة كبيرة لها أجنحة برتقالية عميقة بعلامات سوداء وبيضاء؛ تتغذى…)",
 "大樽": "برميل كبير (برميل كبير خاصة واحد بسعة 63 جالون)",
 "大橋": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "大檀那": "حَم (التنور أو الفرن أو الماء: سجر وسخن وأصبح حارّا؛ الأمر: قُضِيَ وتقدر من الله)\nمثال: أفضل لحم البقر. / رَبّ عَمَل, رَبَّة عَمَل (رَبَّ الولدَ يَرُبُّ رَبًّا: ولِيَه وتعهده بما يغذيه وينميه ويؤدّبه؛ الفاعل:…)\nمثال: اعتني بي يا رب.",
 "大欲": "طَمَع, شُحُّ",
 "大正エビ": "أبيض الزنك, أبيض صيني (خضاب أبيض يستخدم في دهانات المنازل؛ يتكون من أكسيد الزنك)",
 "大正海老": "أبيض الزنك, أبيض صيني (خضاب أبيض يستخدم في دهانات المنازل؛ يتكون من أكسيد الزنك)",
 "大歳": "اَلْمُشْتَرِي (أحد كَوَاكِب المجموعة الشمسية السَّيَّارَة، وهو أكبرها)\nمثال: كوكب المشتري متكون من الغاز. / 31 ديسمبر, ليلة رأس السنة (اليوم الأخير من السنة) / اَلْمُشْتَرِي (أحد كَوَاكِب المجموعة الشمسية السَّيَّارَة، وهو أكبرها)\nمثال: كوكب المشتري متكون من الغاز.",
 "大殿": "قِسِّيس, دَاعِيَة (الذي يُقَسِّس الإبل أو الماشية أو الغنم، أي يحسن رعايتها، الراعي؛ عند…)",
 "大殿筋": "ألوية كبرى (أقصى العضلات الألوية الثلاث)",
 "大母": "جَدَّة (هي أم الأب أو أم الأم؛ مدينة في السُعُودِيَّة قرب مَكَّة، قيل أنها سميت هكذا…)\nمثال: كان لزيري جد و جدة.",
 "大毛蓼": "بطباط شرقي, ريشة الأمير (نبات حولي بأوراق بيضاوية عريضة وسنابل متدلية رفيعة من الزهور القرمزية؛ جنوب شرق…)",
 "大気": "جَو, غِلَاف جَوِّيّ / سَمْح, كَرِيم النَّفْس (سخي ومتفهم ومتسامح)",
 "大気圏": "جَو, غِلَاف جَوِّيّ",
 "大気圏外": "فَضَاء خَارِجِيّ (فَضَاء)\nمثال: الفضاء مليئ بالغموض.",
 "大気圧": "ضغط جوي",
 "大気汚染": "تَلَوُّث الْهَوَاء, تَلَوُّث هَوَائِيّ (تَلَطُّخ، تَكَدُّر، قذارة ودنس يصيبان الجو أو الماء أو البيئة ويؤديان إلى تسمم…)\nمثال: التلوث يضر كوكبنا.",
 "大気汚染防止法": "تَلَوُّث الْهَوَاء, تَلَوُّث هَوَائِيّ (تَلَطُّخ، تَكَدُّر، قذارة ودنس يصيبان الجو أو الماء أو البيئة ويؤديان إلى تسمم…)\nمثال: التلوث يضر كوكبنا.",
 "大水": "طُوفَان, فَيَضَان (عاصفة)",
 "大水青": "عثة الإمبراطور (عثة كبيرة من الغابات المعتدلة في أوراسيا ذات أجنحة شفافة كثيفة القشور)",
 "大汗": "الكثير, قدراً كبيراً (إلى درجة أو مدى كبير جداً)\nمثال: أشعر بتحسن كبير",
 "大江": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "大沢": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "大河": "مَلْحَمَة",
 "大河内": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "大沼": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "大法": "دستور, قانون أساسي (قانون يحدد المبادئ السياسية الأساسية للحكومة)",
 "大法官": "السيد المستشار, اللورد المستشار (أعلى ضابط للتاج يرأس القضاء ويترأس مجلس اللوردات)",
 "大法螺": "شيء ضخم, شيء هائل (شيء كبير أو مثير للإعجاب بشكل خاص من نوعه)",
 "大法螺吹き": "متباهٍ, متفاخر (شخص كثير التفاخر والحديث عن نفسه)",
 "大法院": "مَحْكَمَة عُلْيَا (مقام الحاكم. وغلبت على مقام الحاكم الشرعي أي القاضي)\nمثال: عاد إلى المحكمة.",
 "大波": "تلاطم, موجة عارمة (موجة بحرية كبيرة)",
 "大泣き": "صراخ, عويل (صرخات عالية أثناء البكاء)",
 "大注目": "الكثير, قدراً كبيراً (إلى درجة أو مدى كبير جداً)\nمثال: أشعر بتحسن كبير",
 "大洋": "مُحِيط, قَامُوس (في : هو الخط المستدير الذي يُحيط بالشكل الهندسي؛ في : البَحْر المُحِيْط هو…)\nمثال: أسبح في المحيط.",
 "大洋州": "أُوقِيَانُوسِيَا",
 "大津": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "大洪水": "طُوفَان (عاصفة)",
 "大洲": "قَارَّة",
 "大流行": "ذراع التطويل, عوارضة (أي من الصواري أو الأعمدة الأفقية المتنوعة المستخدمة لتمديد أسفل الشراع أو…)\nمثال: خلق الطلب على الاختبار طفرة لتلك المختبرات غير الخاضعة للتنظيم",
 "大流行り": "ذراع التطويل, عوارضة (أي من الصواري أو الأعمدة الأفقية المتنوعة المستخدمة لتمديد أسفل الشراع أو…)\nمثال: خلق الطلب على الاختبار طفرة لتلك المختبرات غير الخاضعة للتنظيم",
 "大浚": "وَاسِع النِّطَاق (كبير بشكل غير معتاد في النطاق)",
 "大浚い": "وَاسِع النِّطَاق (كبير بشكل غير معتاد في النطاق)",
 "大浦": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "大海": "مُحِيط, قَامُوس (في : هو الخط المستدير الذي يُحيط بالشكل الهندسي؛ في : البَحْر المُحِيْط هو…)\nمثال: أسبح في المحيط.",
 "大海一滴": "غيض من فيض, نقطة في بحر (جهد أو فعل له تأثير ضئيل جداً بشكل عام، خاصة بالمقارنة مع مشكلة ضخمة)\nمثال: إن التبرع بمبلغ 100 دولار من فرد هو أمر كريم، لكنه نقطة في بحر مقارنة بهدف جمع التبرعات البالغ 500,000 دولار",
 "大海原": "مُحِيط, قَامُوس (في : هو الخط المستدير الذي يُحيط بالشكل الهندسي؛ في : البَحْر المُحِيْط هو…)\nمثال: أسبح في المحيط.",
 "大海烏": "أوك عظيم (طائر أوك كبير لا يطير من الجزر الصخرية قبالة سواحل شمال الأطلسي؛ منقرض)",
 "大海老": "كَرْكَنْد",
 "大混乱": "فَوْضَى",
 "大清帝国": "تشينغ, سلالة تشينغ (آخر سلالة إمبراطورية للصين (من 1644 إلى 1912) والتي أطاح بها الثوار؛ خلال سلالة…)",
 "大湾": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "大滝": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "大演習": "وَاسِع النِّطَاق (كبير بشكل غير معتاد في النطاق)",
 "大演説": "خطبة عصماء, صياح (خطبة رنانة عالية الصوت تعبر عن مشاعر قوية)",
 "大火災": "حَرِيق (النَار المشتعلة في شيء كالدَار او الغَابَة)",
 "大災難": "وَاسِع النِّطَاق (كبير بشكل غير معتاد في النطاق)",
 "大烏": "غُرَاب",
 "大無人": "وَاحِد, وَاحِدَة (في وَ: العدد واحد العدد الاول)",
 "大熊": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "大熊座": "الدُّب الْأَكْبَر, بَنَات نَعْش الكُبْرَى",
 "大燥ぎ": "ابتهاج, زهو (شعور بالفرح والفخر)",
 "大物": "شخصية مؤثرة, شخصية هامة (شخص تؤثر أفعاله وآراؤه بقوة على مسار الأحداث) / طرائد كبيرة (حيوانات كبيرة يتم اصطيادها للرياضة)",
 "大犬の陰嚢": "بَانُورَامِيّ, مِنْ عَلُوّ (كما يُرى من ارتفاع أو مسافة بعيدة)",
 "大犬陰嚢": "بَانُورَامِيّ, مِنْ عَلُوّ (كما يُرى من ارتفاع أو مسافة بعيدة)",
 "大猟獣": "طرائد كبيرة (حيوانات كبيرة يتم اصطيادها للرياضة)",
 "大猩々": "غُورِيلَا",
 "大猩猩": "غُورِيلَا",
 "大獄": "تجميع المشتبه بهم, حملة اعتقالات (التجميع المنهجي للمشتبه بهم من قبل الشرطة)\nمثال: حملة اعتقالات جماعية للمشتبه بهم",
 "大王": "قَيْصَر, إِمْبْرَاطُور / أَمِير",
 "大王松": "صنوبر أصفر جنوبي, صنوبر طويل الأوراق (صنوبر كبير ثلاثي الإبر من جنوب شرق الولايات المتحدة له إبر طويلة جداً وأطراف…)",
 "大王椰子": "نخيل ملكي (نخيل ريشي طويل من جنوب فلوريدا وكوبا)",
 "大王烏賊": "حبار عملاق (أكبر رخوي معروف عنه ولكن لم يُرَ قط (يصل طوله إلى 60 قدماً))",
 "大理石": "رُخَام",
 "大瑠璃草": "لسان الكلب المخزني (شجيرة ثنائية الحول في أوروبا وغرب آسيا لها أوراق خشنة على شكل لسان وأزهار حمراء…)",
 "大甘": "لَيِّن, مُتَسَاهِل (يتّسم بالتسامح والرحمة في التعامل)",
 "大用": "بِرَاز, سَلْح",
 "大田": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "大田原": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "大男": "عِمْلَاق",
 "大畑": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "大略": "لَخَّصَ, اِخْتَصَرَ / تقريباً, حوالي ((للكميات) غير دقيق ولكنه قريب جداً من الصواب)\nمثال: استمر حوالي ساعة",
 "大発作": "صرع كبير, نوبة معممة (نوبة يصبح خلالها المريض فاقداً للوعي ويعاني من تشنجات في جميع أنحاء الجسم)",
 "大発見": "اِخْتِرَاق (اختراق الرياح مرورها؛ اخترقت الخيل ما بين القرى والشجر:تخلّلتها)",
 "大白鳥": "تم ناعق (بجعة شائعة في العالم القديم تشتهر بندائها الناعق)",
 "大百舌": "صرد شمالي (طائر صرد من شمال أمريكا الشمالية)",
 "大皿": "أسطوانة, أسطوانة فونوغراف (تسجيل صوتي يتكون من قرص به أخدود مستمر؛ يستخدم لإعادة إنتاج الموسيقى عن طريق…)",
 "大盛況": "مَشْغُول",
 "大目": "شهامَة",
 "大目に見る": "صَفَحَ (الصَّفْحُ : العفو؛ صَفْحُ الإِنْسَانِ : جَنْبُهُ)\nمثال: كل صفحة مغامرة.",
 "大目白鮫": "قرش الثور (أكثر أنواع القرش شيوعاً في المياه الساحلية المعتدلة والاستوائية حول العالم؛ ضخم…)",
 "大相場": "ذراع التطويل, عوارضة (أي من الصواري أو الأعمدة الأفقية المتنوعة المستخدمة لتمديد أسفل الشراع أو…)\nمثال: خلق الطلب على الاختبار طفرة لتلك المختبرات غير الخاضعة للتنظيم",
 "大看板": "أَفِيش / بشكل ممتاز, على ما يرام (بشكل جيد جداً)\nمثال: إنها لا تشعر أنها على ما يرام اليوم",
 "大矢": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "大知": "حَكِيم, فَطِن (الذي يتصرف دوما بحكمة وتكون الحكمة من صفاته؛ في : هو الطَبِيب)\nمثال: هذه كلمات حكيمة.",
 "大石": "جُلْمُود, صَخْرَة كَبِيرَة (كتلة صخرية كبيرة ملساء منفصلة عن مكان نشأتها) / تِنِّين",
 "大砲": "مُسَدَّس, طَبَنْجَة (اسم مفعول من سَدَّسَ؛ في : شَكْل هندسي مُسَطَّح له سِتَّة أضلاع متساوية فإن لم…)\nمثال: كان عند زيري مسدس.",
 "大破": "جلد, ضرب (فعل إيقاع العقاب البدني بضربات متكررة)",
 "大礼服": "زي تشريفات كامل (الزي البحري أو العسكري المحدد باللوائح للارتداء في المناسبات الاحتفالية)",
 "大祖": "مُؤَسِّس, مُؤَسِّسَة",
 "大祖国戦争": "الْحَرْب الْوَطَنِيَّة الْعُظْمَى",
 "大神": "رَبّ (رَبَّ الولدَ يَرُبُّ رَبًّا: ولِيَه وتعهده بما يغذيه وينميه ويؤدّبه؛ الفاعل:…)\nمثال: اعتني بي يا رب.",
 "大神楽": "جابونيكا, كاميليا يابانية (شجيرة دفيئة ذات أوراق خضراء لامعة وزهور مبهرجة عطرة تشبه الورد؛ تزرع في العديد…)",
 "大神田": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
