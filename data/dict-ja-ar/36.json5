 "奈辺": "أَيْن, فين",
 "奉じる": "حَالِيّ, حَاضِر\nمثال: أنا موجود لوحدي / أَطَاعَ",
 "奉ずる": "حَالِيّ, حَاضِر\nمثال: أنا موجود لوحدي / أَطَاعَ",
 "奉る": "اِقْتِرَاح\nمثال: اقترح سامي المساعدة.",
 "奉仕": "خِدْمَة",
 "奉仕団体": "نادي الخدمة العسكرية (مركز ترفيهي لرجال الخدمة العسكرية)",
 "奉仕女": "شماسة (امرأة برتبة شماس)",
 "奉仕料": "رسم الخدمة (نسبة مئوية من الفاتورة (كما في فندق أو مطعم) تضاف كدفع للخدمة)",
 "奉仕活動": "عمل تطوعي محبب (عمل منتج يتم إنجازه طوعاً دون مكافأة مادية أو تعويض)",
 "奉仕者": "خَادِم, خَادِمَة / قِسِّيس, دَاعِيَة (الذي يُقَسِّس الإبل أو الماشية أو الغنم، أي يحسن رعايتها، الراعي؛ عند…)",
 "奉体": "أداء, تنفيذ (فعل الأداء؛ القيام بشيء بنجاح؛ استخدام المعرفة بدلاً من مجرد امتلاكها)\nمثال: انتقدوا أداءه كرئيس للبلدية",
 "奉侍": "إعلان قضائي, تبليغ (عملية تسليم أمر قضائي أو استدعاء لشخص ما)\nمثال: قبل تبليغ الاستدعاء",
 "奉公": "خدمة عامة, وظيفة حكومية (التوظيف ضمن نظام حكومي (خاصة في الخدمة المدنية))",
 "奉公人": "خَادِم, خَادِمَة",
 "奉加": "تَبَرُّع, هِبَة",
 "奉呈": "إِرَاءَة",
 "奉唱": "غِنَاء (مصدر للفعل \"غَنَّى\"؛ استعمال الصوت البشري لصنع أصوات موسيقية)\nمثال: عادت إلى الغناء.",
 "奉拝": "عِبَادَة\nمثال: ماذا أنجز عبد العزيز بوتفليقة؟",
 "奉持": "رمان بلي, كرسي تحميل (دعامة دوارة توضع بين الأجزاء المتحركة للسماح لها بالحركة بسهولة)\nمثال: وقف بوضعية جيدة",
 "奉教人": "مَسِيحِيّ, مَسِيحِيَّة (المنسوب إلى المَسِيْح عليه السلام؛ المنسوب إلى الدين المسيحي، النَصْرَانِي)",
 "奉献": "تَفَانٍ",
