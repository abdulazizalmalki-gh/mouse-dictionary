 "大宗": "إِنْشاء, إِشَادَة (مصدر للفعل \"أَنْشَأَ\")\nمثال: إنشاء موقع إلكتروني بدون أي تكلفة؟",
 "大官": "عَالِيّ الرُتْبَة",
 "大宝": "بُودِيسَاتْفَا",
 "大室": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "大宮": "ضَرِيح / إِمْبِرَاطُورَة الأُمّ",
 "大宮人": "رجل حاشية (مرافق في بلاط الحاكم)",
 "大家": "مؤجر, مالك العقار (مالك أرض يقوم بتأجيرها للآخرين) / سَيِّد\nمثال: يبدو زيري أحسن. / قَصْر (ضد الطول؛ غير تام، غير كامل)\nمثال: لقد قصر الخطاب.",
 "大家さん": "مؤجر, مالك العقار (مالك أرض يقوم بتأجيرها للآخرين)",
 "大家族": "أسرة ممتدة (أسرة تتكون من الأسرة النووية وأقاربهم بالدم)",
 "大家族主義": "أسرة ممتدة (أسرة تتكون من الأسرة النووية وأقاربهم بالدم)",
 "大富豪": "مِلْيَارْدِير / لَعْبَة وَرَق (اللَعْبَة البَرْبَرية دواء عشبيّ)\nمثال: عنده لعبة يويو.",
 "大寒波": "موجة برد (فترة من الطقس البارد)",
 "大審院": "مَحْكَمَة عُلْيَا (مقام الحاكم. وغلبت على مقام الحاكم الشرعي أي القاضي)\nمثال: عاد إلى المحكمة.",
 "大寿林": "درسة القصب (طائر درسة أوروبي يسكن المناطق المستنقعية)",
 "大将": "عَامّ / رَئِيس, رَئِيسَة / صَدِيق (هو الصَاحِب والخّل الذي بينك وبينه صَدَاقَة)\nمثال: ليس لديه صديقة.",
 "大将軍": "رَئِيس أَرْكَان",
 "大尉": "طَيَّار, قُبْطَان (اسم فاعل للمبالغة على وزن فَعَّال؛ الذي يقود الطَائِرَة سواء كانت مهنته أم لا)\nمثال: لم توجه أبدا تهمة القيادة غير المسؤولة للطيار.",
 "大小": "مَقَاس, قِيَاس",
 "大尽": "ثري, غني (شخص يمتلك ثروة مادية كبيرة) / باذخ, منفق كبير (شخص ينفق ببذخ وتفاخر على الترفيه)\nمثال: آخر المنفقين الكبار",
 "大尽遊び": "مصروف الجيب (نقد للإنفاق اليومي على المصاريف العرضية)",
 "大尾": "نِهَايَة, غَايَة\nمثال: انتهى أمر زيري.",
 "大局的": "رَحْب الصَّدْر, مُتَسَامِح (يُظْهِر أَوْ يَتَّسِم بِسَعَة الأُفُق والتَّسَامُح)",
 "大屋": "مؤجر, مالك العقار (مالك أرض يقوم بتأجيرها للآخرين)",
 "大屋さん": "مؤجر, مالك العقار (مالك أرض يقوم بتأجيرها للآخرين)",
 "大屋根": "سطح المنزل (سقف البيت)\nمثال: أعلنها من فوق أسطح المنازل",
 "大層": "جِدًّا (كلمة \"جدا\" لها معانٍ متعددة؛ يرتبط المعنى بالعطاء والكرم، سواء بالمنح أو طلبه)\nمثال: إنها غالية جدا! / الْأُقْصَى, الْأَبْعَد\nمثال: أنا غير متفاجئ. / بَاهِر, رَائِع (يتمتع بجمال وروعة عظيمين) / مُضَخَّم, مُكَبَّر (مُكبَّر إلى درجة غير طبيعية)",
 "大山": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "大山木": "ماغنوليا جنوبية, ماغنوليا كبيرة الأزهار (شجرة دائمة الخضرة في جنوب الولايات المتحدة ذات أوراق لامعة صلبة كبيرة وزهور…)",
 "大山猫": "وَشَق",
