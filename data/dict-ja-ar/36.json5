 "寅": "نِمْر (النّمر: حيوان مرقّط يُشبه الأَسَد؛ النّمر: لونه أنمر، وفيه نُمر حمراء أو بيضاء وسوداء) / بَبْر (حيوان ضخم مخطط من السّنوريّات. والببر يَختلف عن النَمِر، فالببر مخطط والنمر مرقّط) / نمر (النّمر: حيوان مرقّط يُشبه الأَسَد؛ النّمر: لونه أنمر، وفيه نُمر حمراء أو بيضاء وسوداء)\nمثال: دخل نمر مخيمنا.",
 "密": "كَثِيف, غَلِيظ / أَغْلَقَ, سَكَّر (ضد فَتَحَ؛ سَدَّ وسَكَّرَ؛ قد تستخدم بمعنى أَقْفَلَ؛ أغلقه بحيث لا يفتح إلا بمفتاح) / قَرِيب\nمثال: أغلق الباب بغضب / دَقِيقَة, دِقيقة (وِحْدَة زَمَنِيَّة تساوي ستين ثَانِيَة، وجزءًا من ستّين جزءًا من السَّاعَة؛ في : وحدة لقياس خطوط الطول والعرض) / لَحْظَة / دَقِيقٌ, تَافِهٌ (ضد الغَلِيْظ، الرَفِيْع الرَقِيْق؛ صغير الحجم جدا)\nمثال: استأذنت لدقيقة. / سِرّ, خَفِيَّة (شَعَرَ بِالسُّرُورِ) / سِرِّيّ\nمثال: السر سيبقى سرا.",
 "密々": "سِرًّا ((سَرَا) فلان سروا وسراوة: شرف وسخا في مروءة؛ (سَرَا) الشيء عنه سروا: نزعه وألقاه. يقال سرا عنه ثوبه ودرعه)\nمثال: أبقو حبهما سرا.",
 "密か": "سِرّ, خَفِيَّة (شَعَرَ بِالسُّرُورِ) / سِرِّيّ\nمثال: السر سيبقى سرا.",
 "密か事": "سِرّ, خَفِيَّة (شَعَرَ بِالسُّرُورِ) / سِرِّيّ\nمثال: السر سيبقى سرا. / وَصْل (ضَمَّ وَلَأَمَ. (مصدره وَصْل وصِلَة)؛ بَلَغَ الشيءَ، أَدْرَكَه. (يتعدى بإلى) (مصدره وُصُول))\nمثال: وصل السيد باكر.",
 "密やか": "صَامِت, هَادِئ",
 "密事": "سِرّ, خَفِيَّة (شَعَرَ بِالسُّرُورِ) / سِرِّيّ\nمثال: السر سيبقى سرا. / سِرّ, خَفِيَّة (شَعَرَ بِالسُّرُورِ) / سِرِّيّ\nمثال: السر سيبقى سرا. / وَصْل (ضَمَّ وَلَأَمَ. (مصدره وَصْل وصِلَة)؛ بَلَغَ الشيءَ، أَدْرَكَه. (يتعدى بإلى) (مصدره وُصُول))\nمثال: وصل السيد باكر.",
 "密偵": "جَاسُوس / تَجَسَّسَ / اكتشاف, رصد (فعل اكتشاف شيء ما؛ أو ملاحظة شيء ما) / تجسس, عمل سري (فعل المراقبة السرية لأغراض استخباراتية) / تجسس (الحفاظ على مراقبة سرية أو خفية)",
 "密儀": "سِرّ, خَفِيَّة (شَعَرَ بِالسُّرُورِ) / سِرِّيّ\nمثال: السر سيبقى سرا.",
 "密告": "مَعْلُومَات, مَعْلُومَة",
 "密告者": "مخبر, واشٍ (من يكشف معلومات سرية للشرطة أو سلطة أخرى)",
 "密売": "تَهْرِيب",
 "密売人": "مُهَرِّب",
 "密売品": "تَهْرِيب",
 "密売買": "تَهْرِيب",
 "密夫": "عَاشِق, عَاشِقَة / مُغْرَم",
 "密宗": "تانترا, تانتريّة (عقيدة التنوير كإدراك لوحدانية الذات والعالم المرئي؛ تجمع بين عناصر الهندوسية والوثنية بما في ذلك العناصر السحرية والصوفية مثل المنترا والمودرا…) / تانترا, تانتريزم (حركة داخل البوذية تجمع بين عناصر الهندوسية والوثنية)",
 "密室の暴力": "عُنْف مَنْزَلِيّ, عُنْف أُسْرِيّ",
 "密密": "سِرًّا ((سَرَا) فلان سروا وسراوة: شرف وسخا في مروءة؛ (سَرَا) الشيء عنه سروا: نزعه وألقاه. يقال سرا عنه ثوبه ودرعه)\nمثال: أبقو حبهما سرا.",
 "密封": "عزل الماء (فعل معالجة شيء ما لجعله طاردا للماء)",
 "密度": "كَثَافَة (مصدر لكَثَفَ؛ اللغلظ والثخانة)\nمثال: هذه منطقة من الغابة أقل كثافة",
 "密接": "أَغْلَقَ, سَكَّر (ضد فَتَحَ؛ سَدَّ وسَكَّرَ؛ قد تستخدم بمعنى أَقْفَلَ؛ أغلقه بحيث لا يفتح إلا بمفتاح) / قَرِيب\nمثال: أغلق الباب بغضب",
 "密林": "أَجَمَة, أَدْغَال / نَهْر الأمازون, الأَمَزونْ (صَارَ عَصَبِيًّا وغَضِبَ؛ أَصَابَ الشَّيْءَ أو الكَائِنَ بِغَضَبٍ أو صَارَ يَأْمُرُهُ)\nمثال: عبر جوناس النهر.",
 "密漁": "صَيْد جَائِر",
