 "好餌": "طُعْم (ذَاقَ)\nمثال: أحب طعم البطيخ. / مَاصّ",
 "如": "حَبَّ (الزرع، كبيرا كان أم صغيرا؛ بَذْرُ الزرع)\nمثال: زيري بحب المال.",
 "如き": "حَبَّ (الزرع، كبيرا كان أم صغيرا؛ بَذْرُ الزرع)\nمثال: زيري بحب المال.",
 "如く": "حَبَّ (الزرع، كبيرا كان أم صغيرا؛ بَذْرُ الزرع)\nمثال: زيري بحب المال. / مُبَارَاة / سَبَقَ (سَبَقَهُ إِلَى الشيءِ يَسْبِقَهُ سَبْقًا: تقدَّمَهُ؛ يقال سَبَقَ الفرسُ في…)\nمثال: سبق و رأيت ذلك.",
 "如くは無し": "لَا مَثِيلَ لَهُ, لَا نَظِيرَ لَهُ (بارز يفوق أيّ مقارنة؛ فريد لا يُضاهى)",
 "如し": "حَبَّ (الزرع، كبيرا كان أم صغيرا؛ بَذْرُ الزرع)\nمثال: زيري بحب المال.",
 "如す": "كَـ",
 "如上": "الْمَذْكُورُ آنِفًا, السًّابِقُ ذِكْرُهُ",
 "如何": "كَيْف, ازاي / كَيْف, ازاي / قَابِلٌ لِلتَّفْنِيد, قَابِلٌ لِلدَّحْض (يُمْكِنُ دَحْضُهُ أَوْ تَفْنِيدُهُ)\nمثال: دوافع مشكوك فيها",
 "如何こう言う": "تَذَمَّرَ, اِشْتَكَى",
 "如何した": "بشكل ما, بطريقة أو بأخرى (بطريقة أو أسلوب غير محدد؛ أو بوسيلة غير محددة)\nمثال: لقد تدبروا الأمر بطريقة ما",
 "如何せん": "بكل أسف, لسوء الحظ (بسبب سوء الحظ)\nمثال: لسوء الحظ أمطرت طوال اليوم",
 "如何で": "كَيْف, ازاي",
 "如何な": "مَهْمَا",
 "如何なる": "يَا لَ (يستعمل لنِدَاء البعيد والقريب)\nمثال: يا لها من جملة! / مَهْمَا",
 "如何なる場合でも": "عَلَى أَيِّ حَالٍ (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال.",
 "如何に": "كَيْف, ازاي / بِأَيَّةِ طَرِيقَة, عَلَى كُلِّ حَال / يَاه, اسمع",
 "如何にかかわらず": "بِغَضِّ ٱلنَّظَر عَن, دُونَ الاِهْتِمَام بِـ (البُغْض ضدّ الحبّ ، بغَض جَدُّك:كتعس جدّك،ونعِمَ الله بك عيناً وبغَض بعدوّك…)\nمثال: سأذهب بغض النظر عن مجيئه.",
 "如何にして": "كَيْف, ازاي",
 "如何にも": "بالفعل, حقاً ((تستخدم كصيغة تعجب) تعبير عن الدهشة أو الشك أو السخرية وما إلى ذلك)\nمثال: يريد الزواج من رئيس الخدم؟ حقاً! / جِدًّا (كلمة \"جدا\" لها معانٍ متعددة؛ يرتبط المعنى بالعطاء والكرم، سواء بالمنح أو طلبه)\nمثال: إنها غالية جدا! / مطلقا, على الإطلاق / أبداً / بشكل رهيب, جداً (تستخدم للتوكيد)\nمثال: مثير للاهتمام جداً",
 "如何によらず": "بِغَضِّ ٱلنَّظَر عَن, دُونَ الاِهْتِمَام بِـ (البُغْض ضدّ الحبّ ، بغَض جَدُّك:كتعس جدّك،ونعِمَ الله بك عيناً وبغَض بعدوّك…)\nمثال: سأذهب بغض النظر عن مجيئه.",
 "如何に関わらず": "بِغَضِّ ٱلنَّظَر عَن, دُونَ الاِهْتِمَام بِـ (البُغْض ضدّ الحبّ ، بغَض جَدُّك:كتعس جدّك،ونعِمَ الله بك عيناً وبغَض بعدوّك…)\nمثال: سأذهب بغض النظر عن مجيئه.",
 "如何ばかり": "كَمْ",
 "如何ほど": "كَمْ",
 "如何わしい": "مُريب, مَشبوه / بذيء, غير لائق (مسيء للذوق العام خاصة في المسائل الجنسية)\nمثال: قصة واقعية لكنها ليست فاحشة",
 "如何を問わず": "بِغَضِّ ٱلنَّظَر عَن, دُونَ الاِهْتِمَام بِـ (البُغْض ضدّ الحبّ ، بغَض جَدُّك:كتعس جدّك،ونعِمَ الله بك عيناً وبغَض بعدوّك…)\nمثال: سأذهب بغض النظر عن مجيئه.",
 "如何様": "غِشّ, اِحْتِيال / بِالتَّأْكِيد",
