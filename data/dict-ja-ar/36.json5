 "学びの園": "مُؤَسَّسَة تَعْلِيمِيَّة",
 "学びの庭": "مُؤَسَّسَة تَعْلِيمِيَّة",
 "学び舎": "مَدْرَسَة, مَكْتَب (الموضع الذي تُدَرَّس فيه العلوم؛ البناء فيه عدة غرف تُدَرَّسُ فيها العلوم وتمنح شهادة رسمية بعد إكمال الدروس) / كُلِّيَّة, جَامِعَة (مصدر صناعيّ من كُلّ؛ شمول، مجموع من الأوّل إلى الآخر) / قِسِم (فَرَّقَ أو قَسَّمَ الشَّيءَ إلى أجزاء أو أجزاء مختلفة؛ أَحْلَفَ، أَي جَعَلَ يَحْلِفُ على أمرٍ ما) / مَدْرَسَة (الموضع الذي تُدَرَّس فيه العلوم؛ البناء فيه عدة غرف تُدَرَّسُ فيها العلوم وتمنح شهادة رسمية بعد إكمال الدروس)\nمثال: لا أحب المدرسة.",
 "学ぶ": "تَعَلَّمَ (اكتسب معرفة أو خبرة أو مهارة) / اِعْتَبَرَ, اِتَّعَظَ (الشيءَ: اختبره وامتحنه ونظر فيه؛ الشيءَ شيءًا: عَدُّه كذلك وتصرف على ذلك الأساس. بمفعولين)\nمثال: هو سريع التعلم.",
 "学会": "مَجْمَع, جَامِعَة (اسم مفعول من جَمَّعَ؛ كُلِّيَّة، جَامِعَة) / مَجْمَع, أَكَادِيمِيَّة (اسم مفعول من جَمَّعَ؛ كُلِّيَّة، جَامِعَة)\nمثال: كان سامي يعيش في مجمع مسور.",
 "学位": "دَرَجَة",
 "学位記": "شَهَادَة, دِبْلُوم",
 "学位論文": "أُطْرُوحَة",
 "学修": "ذَاكَرَ, دَرَسَ / دَرَسَ ((متعدٍّ بنفسه) عَلَّمَ، لَقَّنَ؛ اِمْتَهَنَ التَّعْلِيم) / دَرَسَ, تَعَلَّمَ ((متعدٍّ بنفسه) عَلَّمَ، لَقَّنَ؛ اِمْتَهَنَ التَّعْلِيم) / تَعَلُّم, دِرَاسَة (اكتسب معرفة أو خبرة أو مهارة) / مَكْتَب (الموضع الذي يُكتَب عليه. بعكس المَكْتَب الذي يكتب فيه؛ مِنْضَدَة مخصصة للكتابة، سواء كانت للمَكَاتِب أم لغيرها)\nمثال: أراك بعد الدرس.",
 "学力": "مِنْحَة دِرَاسِيَّة, إِعَانَة دِرَاسِيَّة",
 "学匠": "عَالِم (الذي يعلم؛ متخصص في عِلْم ما وباحث فيه)\nمثال: هو عالم أحيائي.",
 "学区": "منطقة تعليمية (منطقة تدار مدارسها العامة معاً)",
 "学区制": "منطقة تعليمية (منطقة تدار مدارسها العامة معاً)",
 "学名": "اِسْم عِلْمِيّ (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)\nمثال: ما اسم حصان توم؟",
 "学問": "ذَاكَرَ, دَرَسَ / دَرَسَ ((متعدٍّ بنفسه) عَلَّمَ، لَقَّنَ؛ اِمْتَهَنَ التَّعْلِيم) / دَرَسَ, تَعَلَّمَ ((متعدٍّ بنفسه) عَلَّمَ، لَقَّنَ؛ اِمْتَهَنَ التَّعْلِيم) / تَعَلُّم, دِرَاسَة (اكتسب معرفة أو خبرة أو مهارة) / مَكْتَب (الموضع الذي يُكتَب عليه. بعكس المَكْتَب الذي يكتب فيه؛ مِنْضَدَة مخصصة للكتابة، سواء كانت للمَكَاتِب أم لغيرها)\nمثال: أراك بعد الدرس. / تَرْتِيب, اِنْضِبَاط (تنظيم الأشياء أو الأحداث في تسلسل معين أو وضعها في نظام؛ إعداد أو تجهيز شيء لتحقيق غاية معينة) / نِظَام (مَنْهَج، طَرِيقَة؛ تَرْتِيب واتِّسَاق)\nمثال: أعاد زيري ترتيب المطبخ كلية.",
 "学問に王道なし": "هُنَاك, يُوجَد",
 "学問の徒": "عَالِم (الذي يعلم؛ متخصص في عِلْم ما وباحث فيه)\nمثال: هو عالم أحيائي.",
 "学問所": "مَدْرَسَة, مَكْتَب (الموضع الذي تُدَرَّس فيه العلوم؛ البناء فيه عدة غرف تُدَرَّسُ فيها العلوم وتمنح شهادة رسمية بعد إكمال الدروس) / كُلِّيَّة, جَامِعَة (مصدر صناعيّ من كُلّ؛ شمول، مجموع من الأوّل إلى الآخر) / قِسِم (فَرَّقَ أو قَسَّمَ الشَّيءَ إلى أجزاء أو أجزاء مختلفة؛ أَحْلَفَ، أَي جَعَلَ يَحْلِفُ على أمرٍ ما) / مَدْرَسَة (الموضع الذي تُدَرَّس فيه العلوم؛ البناء فيه عدة غرف تُدَرَّسُ فيها العلوم وتمنح شهادة رسمية بعد إكمال الدروس)\nمثال: لا أحب المدرسة.",
 "学問的": "أكاديمي, بحثي (من سمات العلماء أو البحث العلمي)\nمثال: أعمال بحثية",
 "学園": "مُؤَسَّسَة تَعْلِيمِيَّة",
 "学園長": "مُدِير (الشخص الذي أدار، جمعه مُدِيرُون ومُدِيرِين؛ مهنة يتولى صاحبها إدَارَة شؤون جهة ما. جمعه مُدَرَاء)\nمثال: زيري هو المدير.",
 "学堂": "مَدْرَسَة, مَكْتَب (الموضع الذي تُدَرَّس فيه العلوم؛ البناء فيه عدة غرف تُدَرَّسُ فيها العلوم وتمنح شهادة رسمية بعد إكمال الدروس) / كُلِّيَّة, جَامِعَة (مصدر صناعيّ من كُلّ؛ شمول، مجموع من الأوّل إلى الآخر) / قِسِم (فَرَّقَ أو قَسَّمَ الشَّيءَ إلى أجزاء أو أجزاء مختلفة؛ أَحْلَفَ، أَي جَعَلَ يَحْلِفُ على أمرٍ ما) / مَدْرَسَة (الموضع الذي تُدَرَّس فيه العلوم؛ البناء فيه عدة غرف تُدَرَّسُ فيها العلوم وتمنح شهادة رسمية بعد إكمال الدروس)",
 "学士": "أَعْزَب, عَازِب / بَكَالُورِيَا",
 "学士号": "بَكَالُورِيَا",
 "学士院": "مَجْمَع, جَامِعَة (اسم مفعول من جَمَّعَ؛ كُلِّيَّة، جَامِعَة) / مَجْمَع, أَكَادِيمِيَّة (اسم مفعول من جَمَّعَ؛ كُلِّيَّة، جَامِعَة)\nمثال: كان سامي يعيش في مجمع مسور.",
 "学寮": "قاعة إقامة (سكن جامعي) / مدرسة بنات, مدرسة خاصة (مكان خاص لتعليم الصغار) / كلية لاهوت, معهد لاهوتي (مدرسة لاهوتية لتدريب القساوسة أو الكهنة أو الحاخامات) / مَعْهَد, كُلِّيَّة (محضر ا لناس ومشهدهم؛ المَوْضِع أو الدَار المعهود بهِ الشيءُ والذي لا يزال القوم إذا انتأَوا عنهُ رجعوا إليه. الجمع مَعَاهِد. استخدام قديم) / كُلِّيَّة (مصدر صناعيّ من كُلّ؛ شمول، مجموع من الأوّل إلى الآخر)\nمثال: ويعد هذا المعهد من أفضل المعاهد دوليا",
 "学年": "سنة دراسية, عام أكاديمي (الفترة الزمنية من كل عام التي تكون فيها المدرسة مفتوحة والناس يدرسون)",
 "学年度": "سنة دراسية, عام أكاديمي (الفترة الزمنية من كل عام التي تكون فيها المدرسة مفتوحة والناس يدرسون)",
 "学年暦": "سنة دراسية, عام أكاديمي (الفترة الزمنية من كل عام التي تكون فيها المدرسة مفتوحة والناس يدرسون)",
 "学府": "مُؤَسَّسَة تَعْلِيمِيَّة",
 "学徒": "طَالِب, طَالِبَة",
 "学期": "فترة دراسية, فصل دراسي (الوقت الذي تعقد فيه المدرسة الفصول الدراسية)\nمثال: اضطروا لتقصير الفصل الدراسي",
 "学校": "مَدْرَسَة, مَكْتَب (الموضع الذي تُدَرَّس فيه العلوم؛ البناء فيه عدة غرف تُدَرَّسُ فيها العلوم وتمنح شهادة رسمية بعد إكمال الدروس) / كُلِّيَّة, جَامِعَة (مصدر صناعيّ من كُلّ؛ شمول، مجموع من الأوّل إلى الآخر) / قِسِم (فَرَّقَ أو قَسَّمَ الشَّيءَ إلى أجزاء أو أجزاء مختلفة؛ أَحْلَفَ، أَي جَعَلَ يَحْلِفُ على أمرٍ ما) / مَدْرَسَة (الموضع الذي تُدَرَّس فيه العلوم؛ البناء فيه عدة غرف تُدَرَّسُ فيها العلوم وتمنح شهادة رسمية بعد إكمال الدروس)\nمثال: لا أحب المدرسة.",
 "学校制度": "نظام مدرسي (مؤسسة تشمل المنشآت والمعدات لتوفير التعليم من رياض الأطفال حتى المدرسة الثانوية)",
 "学校帰り": "فِي الطَّرِيق (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "学校新聞": "صحيفة مدرسية (صحيفة يكتبها وينشرها طلاب في مدرسة)",
 "学校長": "مدير مدرسة (المربي الذي لديه سلطة تنفيذية لمدرسة)\nمثال: أرسلت التلاميذ المشاغبين لرؤية المدير",
 "学業": "ذَاكَرَ, دَرَسَ / دَرَسَ ((متعدٍّ بنفسه) عَلَّمَ، لَقَّنَ؛ اِمْتَهَنَ التَّعْلِيم) / دَرَسَ, تَعَلَّمَ ((متعدٍّ بنفسه) عَلَّمَ، لَقَّنَ؛ اِمْتَهَنَ التَّعْلِيم) / تَعَلُّم, دِرَاسَة (اكتسب معرفة أو خبرة أو مهارة) / مَكْتَب (الموضع الذي يُكتَب عليه. بعكس المَكْتَب الذي يكتب فيه؛ مِنْضَدَة مخصصة للكتابة، سواء كانت للمَكَاتِب أم لغيرها)\nمثال: أراك بعد الدرس.",
 "学業不振": "أداء دون المستوى, تقصير (أداء أضعف من المتوقع (أقل مما كان يمكن التنبؤ به من اختبارات الذكاء))",
 "学殖": "مِنْحَة دِرَاسِيَّة, إِعَانَة دِرَاسِيَّة",
 "学派": "مَدْرَسَة, مَكْتَب (الموضع الذي تُدَرَّس فيه العلوم؛ البناء فيه عدة غرف تُدَرَّسُ فيها العلوم وتمنح شهادة رسمية بعد إكمال الدروس) / كُلِّيَّة, جَامِعَة (مصدر صناعيّ من كُلّ؛ شمول، مجموع من الأوّل إلى الآخر) / قِسِم (فَرَّقَ أو قَسَّمَ الشَّيءَ إلى أجزاء أو أجزاء مختلفة؛ أَحْلَفَ، أَي جَعَلَ يَحْلِفُ على أمرٍ ما) / مَدْرَسَة (الموضع الذي تُدَرَّس فيه العلوم؛ البناء فيه عدة غرف تُدَرَّسُ فيها العلوم وتمنح شهادة رسمية بعد إكمال الدروس)\nمثال: لا أحب المدرسة.",
 "学生": "طَالِب, طَالِبَة / تَعَلُّم (اكتسب معرفة أو خبرة أو مهارة) / دَرْس ((متعدٍّ بنفسه) عَلَّمَ، لَقَّنَ؛ اِمْتَهَنَ التَّعْلِيم)\nمثال: هو سريع التعلم.",
 "学生会館": "اتحاد الطلاب (مبنى في الحرم الجامعي مخصص للأنشطة الاجتماعية والتنظيمية للطلاب)",
 "学生服": "زِي مَدْرَسِيّ",
 "学生鞄": "حقيبة مدرسية (حقيبة لحمل الكتب والأدوات المدرسية)\nمثال: وجد القاموس المناسب تماماً لوضعه في حقيبته المدرسية",
 "学界": "الأوساط الأكاديمية, المجتمع الأكاديمي (العالم الأكاديمي)",
 "学的": "أكاديمي, بحثي (من سمات العلماء أو البحث العلمي)\nمثال: أعمال بحثية",
 "学監": "عميد (إداري مسؤول عن قسم في جامعة أو كلية) / عميد مجمع الكرادلة ((الكنيسة الكاثوليكية الرومانية) رئيس مجمع الكرادلة) / عَمِيد (رجل هو العضو الأقدم في مجموعة ما)\nمثال: هو عميد المراسلين الأجانب",
 "学科": "فَاعِل, مُبْتَدَأ (الشيء :فعله) / مَوْضُوع / دَوْرَة, مَادَّة (في غرب العراق على نهر الفرات قرب الحدود السورية؛ حَيّ في جنوب بغداد تقع فيه محطة تكرير للنفط تسمّى بإسمه) / رَعِيَّة\nمثال: تظن الشرطة أن سامي يعلم من الفاعل. / قِسْم (فَرَّقَ أو قَسَّمَ الشَّيءَ إلى أجزاء أو أجزاء مختلفة؛ أَحْلَفَ، أَي جَعَلَ يَحْلِفُ على أمرٍ ما)\nمثال: أنا أزين القسم.",
 "学究": "عَالِم (الذي يعلم؛ متخصص في عِلْم ما وباحث فيه)\nمثال: هو عالم أحيائي.",
 "学究的": "دراسي, مدرسي (مكون من أو متعلق بالمدارس) / سكولاستي, مدرسي (مكون من أو متعلق بالمذهب الفلسفي للمدرسية (السكولاستية)) / متحذلق, متفيهق (شخص يولي اهتماماً مفرطاً للقواعد الرسمية والمعرفة الكتبية أكثر مما تستحق) / سكولاستي, مدرسي (فيلسوف أو لاهوتي مدرسي (سكولاستي))\nمثال: سنة دراسية",
 "学窓": "مَدْرَسَة, مَكْتَب (الموضع الذي تُدَرَّس فيه العلوم؛ البناء فيه عدة غرف تُدَرَّسُ فيها العلوم وتمنح شهادة رسمية بعد إكمال الدروس) / كُلِّيَّة, جَامِعَة (مصدر صناعيّ من كُلّ؛ شمول، مجموع من الأوّل إلى الآخر) / قِسِم (فَرَّقَ أو قَسَّمَ الشَّيءَ إلى أجزاء أو أجزاء مختلفة؛ أَحْلَفَ، أَي جَعَلَ يَحْلِفُ على أمرٍ ما) / مَدْرَسَة (الموضع الذي تُدَرَّس فيه العلوم؛ البناء فيه عدة غرف تُدَرَّسُ فيها العلوم وتمنح شهادة رسمية بعد إكمال الدروس)\nمثال: لا أحب المدرسة.",
 "学童": "تِلْمِيذ, تِلْمِيذَة",
 "学級": "صِنْف, صَنْف / طَبَقَة / فَصْل, صَفّ (التقطيع؛ تقسيم الشيء أجزاءً؛ جزء، باب في كِتَاب أو ماشابهه) / طَائِفَة (مؤنث طَائِف؛ التي تطوفُ؛ القطعة أو الجزء من الشيء أو الواحدة منه)\nمثال: اقرأ هذا الفصل.",
 "学績": "إِنْجَاز",
 "学群": "مَدْرَسَة, مَكْتَب (الموضع الذي تُدَرَّس فيه العلوم؛ البناء فيه عدة غرف تُدَرَّسُ فيها العلوم وتمنح شهادة رسمية بعد إكمال الدروس) / كُلِّيَّة, جَامِعَة (مصدر صناعيّ من كُلّ؛ شمول، مجموع من الأوّل إلى الآخر) / قِسِم (فَرَّقَ أو قَسَّمَ الشَّيءَ إلى أجزاء أو أجزاء مختلفة؛ أَحْلَفَ، أَي جَعَلَ يَحْلِفُ على أمرٍ ما) / مَدْرَسَة (الموضع الذي تُدَرَّس فيه العلوم؛ البناء فيه عدة غرف تُدَرَّسُ فيها العلوم وتمنح شهادة رسمية بعد إكمال الدروس)\nمثال: لا أحب المدرسة.",
 "学習": "تَعَلُّم (اكتسب معرفة أو خبرة أو مهارة) / دَرْس ((متعدٍّ بنفسه) عَلَّمَ، لَقَّنَ؛ اِمْتَهَنَ التَّعْلِيم)\nمثال: هو سريع التعلم.",
 "学習困難": "اضطراب التعلم, صعوبات التعلم (اضطراب يوجد لدى الأطفال ذوي الذكاء الطبيعي الذين يواجهون صعوبات في تعلم مهارات محددة)",
 "学習室": "قاعة المطالعة (فصل دراسي مخصص للدراسة) / حصة دراسة حرة, قاعة استذكار (فترة زمنية خلال اليوم الدراسي تخصص للدراسة والمذاكرة)",
 "学習帳": "كراسة تمارين, كراسة عمل (كتاب أو كتيب للطالب يحتوي على مسائل مع مساحات لحلها)",
 "学習性無力感": "عَجْز مُتَعَلِّم, عَجْز مُكْتَسَب",
 "学習曲線": "منحنى التعلم (رسم بياني يوضح معدل التعلم (خاصة الرسم البياني الذي يوضح المقدار الذي تم تذكره كدالة لعدد محاولات التذكر))",
 "学習机": "طاولة كتابة, مكتب (مكتب للكتابة (عادة بسطح مائل)) / حقيبة مكتب متنقل (حقيبة محمولة تحتوي على أدوات الكتابة ولها سطح للكتابة)",
 "学習用": "ذَاكَرَ, دَرَسَ / دَرَسَ ((متعدٍّ بنفسه) عَلَّمَ، لَقَّنَ؛ اِمْتَهَنَ التَّعْلِيم) / دَرَسَ, تَعَلَّمَ ((متعدٍّ بنفسه) عَلَّمَ، لَقَّنَ؛ اِمْتَهَنَ التَّعْلِيم) / تَعَلُّم, دِرَاسَة (اكتسب معرفة أو خبرة أو مهارة) / مَكْتَب (الموضع الذي يُكتَب عليه. بعكس المَكْتَب الذي يكتب فيه؛ مِنْضَدَة مخصصة للكتابة، سواء كانت للمَكَاتِب أم لغيرها)\nمثال: أراك بعد الدرس.",
 "学習者": "صبيّ, متدرب مهني (يعمل لدى خبير لتعلم مهنة) / تلميذ, طالب (شخص (خاصة طفل) يتعلم (كما من معلم) أو يكتسب المعرفة أو المعتقدات)",
 "学習能力": "ذكاء, عقل (القدرة العقلية)\nمثال: لديه الكثير من الذكاء ولكنه يفتقر للحس السليم",
 "学習辞典": "قاموس المتعلم (قاموس مكتوب خصيصاً لمن يتعلمون لغة أجنبية)",
 "学習障害": "اضطراب التعلم, صعوبات التعلم (اضطراب يوجد لدى الأطفال ذوي الذكاء الطبيعي الذين يواجهون صعوبات في تعلم مهارات محددة)",
 "学者": "عَالِم (الذي يعلم؛ متخصص في عِلْم ما وباحث فيه)\nمثال: هو عالم أحيائي. / ضليع, عالم (شخص تم قبوله كعضو في مجال علمي أو معرفي)",
 "学舎": "مَدْرَسَة, مَكْتَب (الموضع الذي تُدَرَّس فيه العلوم؛ البناء فيه عدة غرف تُدَرَّسُ فيها العلوم وتمنح شهادة رسمية بعد إكمال الدروس) / كُلِّيَّة, جَامِعَة (مصدر صناعيّ من كُلّ؛ شمول، مجموع من الأوّل إلى الآخر) / قِسِم (فَرَّقَ أو قَسَّمَ الشَّيءَ إلى أجزاء أو أجزاء مختلفة؛ أَحْلَفَ، أَي جَعَلَ يَحْلِفُ على أمرٍ ما) / مَدْرَسَة (الموضع الذي تُدَرَّس فيه العلوم؛ البناء فيه عدة غرف تُدَرَّسُ فيها العلوم وتمنح شهادة رسمية بعد إكمال الدروس)\nمثال: لا أحب المدرسة.",
 "学芸": "إنسانيات, علوم إنسانية (دراسات تهدف إلى توفير معرفة عامة ومهارات فكرية (بدلاً من المهارات المهنية أو الوظيفية))\nمثال: كلية الآداب والعلوم",
 "学芸員": "منظم معارض",
 "学芸大学": "إنسانيات, علوم إنسانية (دراسات تهدف إلى توفير معرفة عامة ومهارات فكرية (بدلاً من المهارات المهنية أو الوظيفية))\nمثال: كلية الآداب والعلوم",
 "学術": "عِلْم, مَعْرِفَة (أَدْرَكَ حقيقة الشيء) / عِلْم (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
