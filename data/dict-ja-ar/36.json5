 "妾腹": "غَيْر مَشْرُوع, مُحَرَّم (مُخالِف لِلقانون؛ لا يُجيزُهُ القانون)",
 "姉": "الْأُخْت الْكُبْرَى, الشَّقِيقَة الْكُبْرَى",
 "姉さま": "الْأُخْت الْكُبْرَى, الشَّقِيقَة الْكُبْرَى / الْأُخْت الْكُبْرَى, الشَّقِيقَة الْكُبْرَى / آنسة, شابة (أنثى شابة)\nمثال: شابة في الثامنة عشرة من عمرها / دمية ورقية (قطعة من الورق مقصوصة أو مطوية على شكل إنسان)",
 "姉さん": "الْأُخْت الْكُبْرَى, الشَّقِيقَة الْكُبْرَى / آنسة, شابة (أنثى شابة)\nمثال: شابة في الثامنة عشرة من عمرها / أَخْطَأَ ((أخْطَأَ): خَطِئَ؛ (أخْطَأَ) غَلِظَ (حاد عن الصواب))\nمثال: اعترف أنه أخطأ. / سيدة (امرأة راقية)\nمثال: فتح السائق باب الليموزين للسيدة الكبيرة",
 "姉ちゃん": "الْأُخْت الْكُبْرَى, الشَّقِيقَة الْكُبْرَى / بِنْت\nمثال: أنا أري الفتاة.",
 "姉や": "آنسة, شابة (أنثى شابة)\nمثال: شابة في الثامنة عشرة من عمرها",
 "姉上": "الْأُخْت الْكُبْرَى, الشَّقِيقَة الْكُبْرَى",
 "姉君": "أخت (الأُخْت : المرأة التي تشترك معك في الأب أو الأم؛ الأُخْت  لقب يطلقه الشخص على…)\nمثال: ماري هي أخت توم",
 "姉妹": "أخت (الأُخْت : المرأة التي تشترك معك في الأب أو الأم؛ الأُخْت  لقب يطلقه الشخص على…)\nمثال: ماري هي أخت توم",
 "姉妹編": "تكملة, جزء تالٍ (جزء يضاف إلى كتاب أو مسرحية يكملها ويوسعها)",
 "姉妹船": "سفينة شقيقة (سفينة هي واحدة من سفينتين أو أكثر متشابهة تم بناؤها في نفس الوقت)",
 "姉妹艦": "سفينة شقيقة (سفينة هي واحدة من سفينتين أو أكثر متشابهة تم بناؤها في نفس الوقت)",
 "姉妹語": "ذُو رَحِمٍ, مِنْ نَفْسِ الدَّمِ (مرتبط بصلة الدم)",
 "姉弟": "الْأُخْت الْكُبْرَى, الشَّقِيقَة الْكُبْرَى",
 "姉様": "الْأُخْت الْكُبْرَى, الشَّقِيقَة الْكُبْرَى / الْأُخْت الْكُبْرَى, الشَّقِيقَة الْكُبْرَى / آنسة, شابة (أنثى شابة)\nمثال: شابة في الثامنة عشرة من عمرها / دمية ورقية (قطعة من الورق مقصوصة أو مطوية على شكل إنسان)",
 "姉様人形": "دمية ورقية (قطعة من الورق مقصوصة أو مطوية على شكل إنسان)",
 "始まり": "مَنْشَأ",
 "始まる": "بَدَأَ, اِبْتَدَأَ (حَدَثَ ونَشَأَ وحَصَلَ؛ أَخَذَ، شَرَعَ)\nمثال: بدأ سامي يتكلم. / حَدَثَ, جَرَى (وَقَعَ الأمر؛ نقيض قَدُمَ، كان حَدِيثا)\nمثال: لا أصدق ما حدث. / حتّى الآن (يفيد انتهاء الغاية؛ يفيد الغاية)\nمثال: انتظر حتى أجلس.",
 "始む": "نَجْمَة, اِبْتِدَاء\nمثال: بدأ سامي يتكلم.",
 "始め": "بِدَايَة (في بِدَايَة الأمْرِ كانَ مُهَذَّباً : فِي أوّلِهِ؛ البِدَايَة والنِّهاية:…)\nمثال: هذه بداية جيدة. / أَوَّل, أُولَى (الذي يكون ترتيبه وَاحِد، الذي كان قبل الآخرين؛ الأوَّل اسم من الأسماء الحسنى) / مَنْشَأ / نَاهِيكَ عَن, هٰذَا عَدَا عَنْ",
 "始めて": "أَوَّل, أُولَى (الذي يكون ترتيبه وَاحِد، الذي كان قبل الآخرين؛ الأوَّل اسم من الأسماء الحسنى)",
 "始めに": "أَوَّل, أُولَى (الذي يكون ترتيبه وَاحِد، الذي كان قبل الآخرين؛ الأوَّل اسم من الأسماء الحسنى) / مُقَدَّمَة\nمثال: هل لديه بطاقة شخصية (هوية شخصية - بطاقة تعريف)",
 "始めに言葉ありき": "أصلاً, في المقام الأول (قبل الآن)\nمثال: لماذا لم تخبرني في المقام الأول؟",
 "始めのうち": "أول الأمر, في البداية (في البدء)\nمثال: في البداية لم يلاحظ أي شيء غريب",
 "始めの内": "أول الأمر, في البداية (في البدء)\nمثال: في البداية لم يلاحظ أي شيء غريب",
 "始めは": "أول الأمر, في البداية (في البدء)\nمثال: في البداية لم يلاحظ أي شيء غريب",
 "始める": "نَجْمَة, اِبْتِدَاء\nمثال: بدأ سامي يتكلم. / مَفْتُوح\nمثال: فتح الباب آليا.",
 "始動": "بدء, مشاركة أساسية (دور للبدء (في لعبة في البداية))\nمثال: حصل على بدايته لأن أحد الرماة الأساسيين كان في المستشفى",
 "始原": "نَجْمَة, اِبْتِدَاء\nمثال: بدأ سامي يتكلم.",
 "始域": "مَجَال إِنْتَرْنَت\nمثال: هل تمثل الزراعة على نطاق واسع النظام البيئي في الجزائر؟",
 "始末": "إِدَارَة (هو عملية تولي تَصْرِيف شؤون العَمَل. لا جمع له؛ مجموع الناس الذين يقومون بإدارة…)\nمثال: والدتي تنتظرني في الإدارة. / أحوال مالية, ظروف مادية (الوضع المالي للشخص (جيداً كان أو سيئاً))\nمثال: وجد نفسه في ظروف مالية صعبة / نَتِيجَة / اِقْتَصَدَ, اِدَّخَرَ",
 "始末が悪い": "صَعْب",
 "始末におえない": "بإفراط, كثيراً جداً (أكثر مما يلزم)\nمثال: إنها تأكل كثيراً جداً",
 "始末に負えない": "بإفراط, كثيراً جداً (أكثر مما يلزم)\nمثال: إنها تأكل كثيراً جداً",
 "始業": "فاتِحَة (لفَاتِح؛ سُوْرَة الْفَاتِحَة : أعظم سورة في القرآن الكريم وسميت بذلك لأنها…)\nمثال: لدى نبات الخلنج هذا أزهار وردية فاتحة.",
 "始業時間": "استهلال, انطلاق (الوقت الذي يفترض أن يبدأ فيه شيء ما)\nمثال: بدأوا بداية مبكرة",
 "始点": "منصة انطلاق, نقطة انطلاق (بداية ينطلق منها مشروع)\nمثال: يستخدم أفكار الآخرين كنقطة انطلاق لأفكاره الخاصة",
 "始祖": "مُؤَسِّس, مُؤَسِّسَة",
 "始祖鳥": "أركيوبتركس (طائر بدائي مسنن منقرض من العصر الجوراسي له ذيل طويل مكسو بالريش وعظام مجوفة…)",
 "始端部": "قَائِد, زَعِيم",
 "始終": "باستمرار",
 "姐": "الْأُخْت الْكُبْرَى, الشَّقِيقَة الْكُبْرَى",
 "姐さん": "الْأُخْت الْكُبْرَى, الشَّقِيقَة الْكُبْرَى / آنسة, شابة (أنثى شابة)\nمثال: شابة في الثامنة عشرة من عمرها / أَخْطَأَ ((أخْطَأَ): خَطِئَ؛ (أخْطَأَ) غَلِظَ (حاد عن الصواب))\nمثال: اعترف أنه أخطأ. / سيدة (امرأة راقية)\nمثال: فتح السائق باب الليموزين للسيدة الكبيرة",
 "姐や": "آنسة, شابة (أنثى شابة)\nمثال: شابة في الثامنة عشرة من عمرها",
 "姑": "حَمَاة",
 "姑娘": "بِنْت\nمثال: أنا أري الفتاة.",
 "姑息": "مُتَسَلِّل, مُحْتَال (يتسم بالخداع والمراوغة)\nمثال: رمية من أسفل الذراع / بديل مؤقت, حل مؤقت (شيء يتم تدبيره لتلبية حاجة ملحة أو طارئة)",
 "姑息的治療": "رِعَايَة تَلْطِيفِيَّة",
 "姓": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)\nمثال: في حقيقة الأمر، كان زيري يعرف لقب ريمة. / عَشِيرَة (مؤنث العَشِيْر؛ التي تعاشرها. الجمع عَشِيرَات؛ إحدى طبقات الأنساب دون الفخذ…)",
 "姓名": "اِسْم, أَسْمَاء (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه…)\nمثال: ما اسم حصان توم؟",
 "姓名不詳": "غَيْر مُعَرَّف, مَجْهُول الهُوِيَّة (ذو مصدر مجهول أو غير مُسمَّى)",
 "姓氏": "اسم العائلة, لقب (الاسم المستخدم لتعريف أفراد الأسرة (لتمييزه عن الاسم الأول لكل فرد)) / عَشِيرَة (مؤنث العَشِيْر؛ التي تعاشرها. الجمع عَشِيرَات؛ إحدى طبقات الأنساب دون الفخذ…)",
 "委": "لَجْنَة",
 "委しい": "مُفَصَّل / عَارِف\nمثال: هو عالم أحيائي.",
 "委付": "هِجْرَان, هُجْرَان",
 "委任": "تُهْمَة\nمثال: أقوم بشحن هاتفي",
 "委任状": "عُمُولَة",
 "委任統治": "اِنْتِدَاب, حُكْم",
 "委員": "عُضْو لَجْنَة (عضو في لجنة)",
 "委員会": "لَجْنَة",
 "委員部": "إمدادات غذائية, تموين (مخزون أو إمدادات من الأطعمة)",
 "委員長": "رَئِيس, رَئِيسَة",
 "委嘱": "تفويض, تكليف (فعل منح السلطة للقيام بوظائف معينة)",
 "委曲": "تفاصيل, معلومات داخلية (معلومات سرية حقيقية)\nمثال: بعد المحاكمة أعطانا التفاصيل الحقيقية",
 "委棄": "تَنَازُل, وَثِيقَةُ تَنَازُل / هِجْرَان, هُجْرَان",
 "委細": "تفاصيل, معلومات داخلية (معلومات سرية حقيقية)\nمثال: بعد المحاكمة أعطانا التفاصيل الحقيقية / كُلّ شَيْء",
 "委細承知": "مَفْهُوم",
 "委縮": "مُبِيد, مُدَمِّر (يَتَسَبَّبُ أَوْ يَقْدِرُ عَلَى التَّدْمِيرِ الكَامِلِ) / انكماش, تقلص (عملية إنقاص (شيء ما) في الحجم أو الكثافة أو الكمية أو النطاق)\nمثال: تقلص الغاز عند التبريد",
 "委蛇": "تدوير, ملء (عملية التدوير أو اللف)\nمثال: وضع المفتاح في الساعة القديمة وأعطاها تدويراً جيداً",
