 "成語": "تعبير اصطلاحي, مصطلح (تعبير لا يمكن استنتاج معانيه من معاني الكلمات التي يتكون منها)",
 "成賀": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "成跡": "إِنْجَاز",
 "成都": "شِينْغْدُو, تْشِينْغْدُو",
 "成金": "كيب, نهوض بالركل (تمرين جمباز يبدأ من وضع تكون فيه الساقان فوق الجزء العلوي من الجسم والتحرك إلى…)",
 "成長": "تَنْمِيَة, نُمُو (الزيادة؛ النماء)\nمثال: الجزائر راغبة في تنمية اقتصادها.",
 "成長ホルモン": "سوماتروبين, هرمون النمو (هرمون تنتجه الغدة النخامية الأمامية؛ يعزز النمو عند البشر)",
 "成長因子": "عامل نمو (بروتين يشارك في تمايز الخلايا ونموها)",
 "成長期": "موسم النمو (الموسم الذي ينمو فيه المحصول بشكل أفضل)",
 "成長株": "أسهم نمو (أسهم شركة حققت مكاسب أسرع من المتوسط في الأرباح ومن المتوقع أن تستمر في ذلك)",
 "成長率": "مُعَدَّل النُّمُوّ (معدل الزيادة في الحجم لكل وحدة زمنية)",
 "成長産業": "صناعة نامية (صناعة تنمو بسرعة)",
 "成長痛": "صعوبات البداية, مشاكل النمو (المشاكل التي تنشأ عند توسيع مؤسسة (خاصة في المراحل المبكرة))",
 "我": "أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك…)\nمثال: لم تقصد أي أذى. / نَفْس (النَّفْسُ : الرُّوحُ؛ النَّفْسُ :الدَّمُ، فشاهده قول السموأَل: تَسِيلُ على…)\nمثال: هم في نفس السن. / مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة! / ـِي, ـي / عِنَاد / نَفْس (النَّفْسُ : الرُّوحُ؛ النَّفْسُ :الدَّمُ، فشاهده قول السموأَل: تَسِيلُ على…)\nمثال: هم في نفس السن.",
 "我々": "نحن (ضَمِيرُ رَفْعٍ مُنْفَصِلٌ لِلْمُثَنَّى وَالْجَمْعِ ( مُذَكَّراً وَمُؤَنَّثاً )…)\nمثال: نحن مهتمون جدا.",
 "我が": "ـِي, ـي",
 "我がちに": "تَهَافَتَ",
 "我がまま": "أَنَانِيّ / مُتَسَاهِل مَعَ النَّفْس (يُلبّي شهواته ورغباته الخاصّة)",
 "我がままを言う": "أنين, تباكي (شكوى يتم التلفظ بها بطريقة شاكية وحزينة)",
 "我がもの": "مَسّ, تَلَبُّس",
 "我が世の春": "أوج, إبان (فترة الازدهار أو الإنتاجية القصوى)",
 "我が侭": "أَنَانِيّ / مُتَسَاهِل مَعَ النَّفْس (يُلبّي شهواته ورغباته الخاصّة)",
 "我が侭を言う": "أنين, تباكي (شكوى يتم التلفظ بها بطريقة شاكية وحزينة)",
 "我が儘": "أَنَانِيّ / مُتَسَاهِل مَعَ النَّفْس (يُلبّي شهواته ورغباته الخاصّة)",
 "我が儘を言う": "أنين, تباكي (شكوى يتم التلفظ بها بطريقة شاكية وحزينة)",
 "我が党": "أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك…)\nمثال: لم تقصد أي أذى. / مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "我が君": "مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "我が国": "الْيَابَان (دولة جزرية في شرق قارة آسيا، عاصمتها طوكيو)",
 "我が強い": "عَنِيد",
 "我が方": "نحن (ضَمِيرُ رَفْعٍ مُنْفَصِلٌ لِلْمُثَنَّى وَالْجَمْعِ ( مُذَكَّراً وَمُؤَنَّثاً )…)\nمثال: نحن مهتمون جدا.",
 "我が物": "مَسّ, تَلَبُّس",
 "我が身": "نَفْسِي / أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك…)\nمثال: لم تقصد أي أذى. / مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "我が輩": "أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك…)\nمثال: لم تقصد أي أذى. / نحن (ضَمِيرُ رَفْعٍ مُنْفَصِلٌ لِلْمُثَنَّى وَالْجَمْعِ ( مُذَكَّراً وَمُؤَنَّثاً )…)\nمثال: نحن مهتمون جدا.",
 "我こそは": "أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك…)\nمثال: لم تقصد أي أذى.",
 "我と": "لوحد / بالطبع, بطبيعة الحال (كما هو متوقع)\nمثال: بطبيعة الحال، أرسل لنا المحامي فاتورة ضخمة",
 "我と我が身": "نَفْسِي",
 "我にもあらず": "بذهول, بشرود (بطريقة شاردة الذهن أو مشغولة البال)\nمثال: قرأ الرسالة بشرود",
 "我にもなく": "بذهول, بشرود (بطريقة شاردة الذهن أو مشغولة البال)\nمثال: قرأ الرسالة بشرود",
 "我にも無く": "بذهول, بشرود (بطريقة شاردة الذهن أو مشغولة البال)\nمثال: قرأ الرسالة بشرود",
 "我にも非ず": "بذهول, بشرود (بطريقة شاردة الذهن أو مشغولة البال)\nمثال: قرأ الرسالة بشرود",
 "我に返る": "أَهْدَأَ, هَدَّأَ",
 "我の強い": "عَنِيد",
 "我ら": "نحن (ضَمِيرُ رَفْعٍ مُنْفَصِلٌ لِلْمُثَنَّى وَالْجَمْعِ ( مُذَكَّراً وَمُؤَنَّثاً )…)\nمثال: نحن مهتمون جدا. / أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك…)\nمثال: لم تقصد أي أذى. / مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "我らが": "ـنَا",
 "我を折る": "أَجْزَأَ (أَجْزَأَ القومُ: جَزَأَتْ إِبِلُهُمْ؛ أَجْزَأَ المرأَةُ: ولدت الإِنَاث)\nمثال: لا أدر لماذا بكيت هذا القدر كله.",
 "我主": "مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "我事": "زَوْجَة, اِمْرَأَة",
 "我人": "مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "我人ども": "مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "我侭": "أَنَانِيّ / مُتَسَاهِل مَعَ النَّفْس (يُلبّي شهواته ورغباته الخاصّة)",
 "我侭を言う": "أنين, تباكي (شكوى يتم التلفظ بها بطريقة شاكية وحزينة)",
 "我僧": "رَاهِب, نَاسِك (اسم فاعل للفعل رَهَبَ؛ عند المَسِيحِيّين هو من تَبَتَّلَ لله واعْتَزَلَ الناس…)",
 "我儕": "أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك…)\nمثال: لم تقصد أي أذى. / مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "我儘": "أَنَانِيّ / مُتَسَاهِل مَعَ النَّفْس (يُلبّي شهواته ورغباته الخاصّة)",
 "我儘を言う": "أنين, تباكي (شكوى يتم التلفظ بها بطريقة شاكية وحزينة)",
 "我儘者": "أناني (شخص يتصف بأنانية مفرطة وغير عادية)",
 "我党": "أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك…)\nمثال: لم تقصد أي أذى. / مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "我勝ちに": "تَهَافَتَ",
 "我執": "أنانية, حب الذات (رأي مبالغ فيه حول أهمية الذات)",
 "我妹": "حَبِيب, حَبِيبَة",
 "我妹子": "حَبِيب, حَبِيبَة",
 "我孫子": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "我御寮": "مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "我御料": "مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "我思うゆえに我あり": "أُفَكِّر، إِذَن أَنَا مَوْجُود, أُفَكِّر، إِذَن أُوجَد",
 "我思う故に我あり": "أُفَكِّر، إِذَن أَنَا مَوْجُود, أُفَكِّر، إِذَن أُوجَد",
 "我思う故に我在り": "أُفَكِّر، إِذَن أَنَا مَوْجُود, أُفَكِّر، إِذَن أُوجَد",
 "我情": "أَنَانِيَّة",
 "我意": "ضبط النفس (سمة التحكم الحازم في سلوك المرء)",
 "我慢": "تحمل, جلد (القدرة على تحمل المشقة أو التوتر)\nمثال: يختبر الماراثون قدرة تحمل العداء / إنكار الذات, ضبط النفس (فعل إنكار الذات؛ السيطرة على الدوافع)",
 "我慢くらべ": "ماراثون, مسابقة التحمل (أي مشروع طويل وشاق)",
 "我慢ならない": "غير محتمل, لا يطاق (لا يمكن تحمله أو الصبر عليه)\nمثال: درجة لا تطاق من العاطفية",
 "我慢の限界": "القشة الأخيرة, القشة التي قصمت ظهر البعير (الإزعاج الأخير الذي يمدد صبرك إلى ما بعد الحد)",
 "我慢強い": "صَبُور (الكثير الصبر أو الذي يصبر طويلا، من كانت صفته الصبر؛ الصَبُوْر: اسم من الأسماء…)\nمثال: أظن أنها مريضة.",
 "我慢比べ": "ماراثون, مسابقة التحمل (أي مشروع طويل وشاق)",
 "我慢汁": "مَذْي",
 "我慢競べ": "ماراثون, مسابقة التحمل (أي مشروع طويل وشاق)",
 "我楽多市": "سوق البضائع المستعملة, سوق خيري (بيع المواد المتبرع بها)",
 "我欲": "أَنَانِيَّة",
 "我武者": "جَرِيء, مُجَازِف (مُستعد لخوض المخاطر والمجازفة)",
 "我武者羅": "مُتَهَوِّر",
 "我殿": "مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "我物": "مَسّ, تَلَبُّس",
 "我知らず": "رَغْمًا عَنْه, قَسْرًا (ضد إرادة المرء أو دون تفكير واعي)\nمثال: احتجز قسراً رغماً عنه",
 "我等": "نحن (ضَمِيرُ رَفْعٍ مُنْفَصِلٌ لِلْمُثَنَّى وَالْجَمْعِ ( مُذَكَّراً وَمُؤَنَّثاً )…)\nمثال: نحن مهتمون جدا. / أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك…)\nمثال: لم تقصد أي أذى. / مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "我等が": "ـنَا",
 "我褒め": "تباهي, تفاخر (الحديث عن النفس بصيغ التفخيم)",
 "我身": "نَفْسِي / أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك…)\nمثال: لم تقصد أي أذى. / مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "我輩": "أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك…)\nمثال: لم تقصد أي أذى. / نحن (ضَمِيرُ رَفْعٍ مُنْفَصِلٌ لِلْمُثَنَّى وَالْجَمْعِ ( مُذَكَّراً وَمُؤَنَّثاً )…)\nمثال: نحن مهتمون جدا.",
 "我郎": "فَتًى, غُلَام (شَابٌّ أوَّلَ شبابه بين المراهقة والرُّجولة؛ عبد، خادم)\nمثال: ترى الفتاة الفتى. / اِبْن زِنًى, بِنْت زِنًى (الولد الذكر)\nمثال: هو له ابن صغير. / مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "我鳴り立てる": "صَاحَ (صاتَ بأقصى طاقته وأعلى صوته، يستخدم للحيّ ولا يقال صاح للجماد؛ عليه: ناداه)\nمثال: سأساعدك يا صاح.",
 "戒": "تَحْذِير, تَنْبِيه (نصيحة تحذيرية حول شيء وشيك (خاصة خطر وشيك أو أمر غير سار))\nمثال: خطاب تحذير حول مخاطر الفسق",
 "戒め": "حَذَر, حِيطَة (حذِر الشّخصُ: تيقّظ واستعدّ وتأهّب وتنبّه؛ حذِر الأمرَ: كَتَمَه وأخفاه)\nمثال: قد بحذر من فضلك. / حَظْر, مَنْع ((حَظَّرَ): بالغ في الحظر)\nمثال: حظر تويتر توم لمدة خمسة عشرة يوما. / عِقَاب, جَزَاء (طَيْر من الجَوَارِح، أكبر التي تصيد منها يكنى بأبي الهَيْثَم ومعروف بحِدَّة…)\nمثال: هو من تلقى العقاب الأكبر.",
 "戒める": "حَذَّرَ (حذِر الشّخصُ: تيقّظ واستعدّ وتأهّب وتنبّه؛ حذِر الأمرَ: كَتَمَه وأخفاه)\nمثال: قد بحذر من فضلك. / مَنَعَ (حَرَمَ، ضد أَعْطَى؛ كَفَّ عنه وحَمَاه)\nمثال: تساهم جذور أشجار المنغروف في منع حدوث انجراف التربة. / عَاقَبَ, قَاصَصَ",
 "戒厳": "حُكْم عُرْفِيّ (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام…)\nمثال: حكم علي بالموت.",
 "戒厳令": "حُكْم عُرْفِيّ (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام…)\nمثال: حكم علي بالموت.",
 "戒告": "تَحْذِير, تَنْبِيه (نصيحة تحذيرية حول شيء وشيك (خاصة خطر وشيك أو أمر غير سار))\nمثال: خطاب تحذير حول مخاطر الفسق",
 "戒律": "مَبْدَأ (أَسَاس، أَصْل؛ مُسَلَّمَة، اِفْتِرَاض، ما يسلّم به لوضوحه)",
 "戒心": "حَذَر, حِيطَة (حذِر الشّخصُ: تيقّظ واستعدّ وتأهّب وتنبّه؛ حذِر الأمرَ: كَتَمَه وأخفاه)\nمثال: قد بحذر من فضلك.",
 "戒慎": "حَذَر, حِيطَة (حذِر الشّخصُ: تيقّظ واستعدّ وتأهّب وتنبّه؛ حذِر الأمرَ: كَتَمَه وأخفاه)\nمثال: قد بحذر من فضلك.",
 "戒飭": "إِنْذَار, تَحْذِير (توبيخ حازم)",
 "或いは": "أَو, أَم (يفيد الشك؛ يفيد التقسيم)\nمثال: أكون أو لا أكون؟ / رُبَّمَا, مِن اَلْمُمْكِن",
 "或は": "أَو, أَم (يفيد الشك؛ يفيد التقسيم)\nمثال: أكون أو لا أكون؟",
 "或る日": "مَرَّةً, يَوْمًا (مؤنث مُرّ، صفة ما كان بها مرارة)\nمثال: كم من مرة ذهبت؟",
 "或る時": "مَرَّةً, مَرَّةً وَاحِدَةً (مؤنث مُرّ، صفة ما كان بها مرارة)\nمثال: كم من مرة ذهبت؟",
 "或る種": "أَكِيد\nمثال: لديك بعض الكتب.",
 "或日": "مَرَّةً, يَوْمًا (مؤنث مُرّ، صفة ما كان بها مرارة)\nمثال: كم من مرة ذهبت؟",
 "戛々": "نَقْرَة",
 "戛戛": "نَقْرَة",
 "戞々": "نَقْرَة",
 "戞戞": "نَقْرَة",
 "戟": "ذُو مِقْبَض طَوِيل (لَهُ مِقْبَض أَوْ يَد طَويلَة) / سِلَاح, أَسْلِحَة",
 "戦": "حَرْب (حَرَبَ (حربه) بالحربة حربا: طعنه بها؛ حَرَبَ (ه) حربا: سلبه جميع ما يملك)\nمثال: بوتين مجرم حرب. / قُوَّات, عَسْكَرِيَّة / حَرْب (حَرَبَ (حربه) بالحربة حربا: طعنه بها؛ حَرَبَ (ه) حربا: سلبه جميع ما يملك)\nمثال: بوتين مجرم حرب. / مُبَارَاة",
 "戦々恐々": "بتوتر, بقلق (بطريقة عصبية وقلقة)\nمثال: راقبنا سوق الأسهم بتوتر",
 "戦い": "مَعْرَكَة / عَارَكَ, قَاتَلَ\nمثال: لن يحل القتال أي شيء. / مُسَابَقَة",
 "戦いの庭": "سَاحَة حَرْب, سَاحَة مَعْرَكَة",
 "戦う": "عَارَكَ, قَاتَلَ\nمثال: لن يحل القتال أي شيء. / تَنَافَسَ, تَبَارَى / كِفَاح, نِضَال",
 "戦き": "ارتجاف, رعشة (اهتزاز لا إرادي (كما لو كان بسبب المرض أو الخوف))\nمثال: سرت فيه رعشة مفاجئة",
 "戦く": "هَزَّ / اِخْتَلَجَ, اِرْتَجَفَ",
 "戦わす": "تَنَافَسَ, تَبَارَى / مُنَاظَرَة, مُنَاقَشَة (مصدر من ناظَرَ)",
 "戦中": "زَمَن الْحَرْب, وَقْت الْحَرْب",
 "戦乙女": "فَالْكِيرِي",
 "戦乱": "حرب, قتال (شن صراع مسلح ضد عدو)\nمثال: قُتل آلاف الأشخاص في الحرب",
 "戦争": "حَرْب (حَرَبَ (حربه) بالحربة حربا: طعنه بها؛ حَرَبَ (ه) حربا: سلبه جميع ما يملك)\nمثال: بوتين مجرم حرب. / صِرَاع",
 "戦争屋": "مُحَرِّض حَرْب, مُحَرِّضَة حَرْب",
 "戦争挑発": "عُدْوَان",
 "戦争未亡人": "أرملة الحرب (امرأة توفي زوجها في الحرب)",
 "戦争犯罪": "جَرِيمَةْ حَرْب",
 "戦争犯罪人": "مُجْرِم حَرْب, مُجْرِمَة حَرْب",
 "戦争犯罪者": "مُجْرِم حَرْب, مُجْرِمَة حَرْب",
 "戦争状態": "حالة حرب, حرب (حالة قانونية تنشأ بإعلان الحرب وتنتهي بإعلان رسمي تسري خلالها القواعد الدولية…)\nمثال: أعلنت الحرب في نوفمبر لكن القتال الفعلي لم يبدأ حتى الربيع التالي",
 "戦争画": "تبرج, مكياج (مستحضرات تجميل توضع على الوجه لتحسين أو تغيير المظهر)",
 "戦争神経症": "إرهاق المعركة, صدمة القصف (اضطراب عقلي ناتج عن إجهاد الحرب النشطة)",
 "戦人": "مُحَارِب, مُقَاتِل",
 "戦列": "خط القتال (خط تشكله القوات أو السفن المستعدة لشن هجوم أو تلقيه)",
 "戦列復帰": "رجوع, عودة (حدوث تغيير في الاتجاه للرجوع في الاتجاه المعاكس)",
 "戦列艦": "سفينة حربية (سفينة حربية مخصصة للقتال)",
 "戦利品": "سورة الأنفال / شِرَاء, اِشْتِرَاء\nمثال: اشترى زيري ذلك.",
 "戦力": "قدرة عسكرية, قوة عسكرية (القدرة من حيث الأفراد والمعدات التي تؤثر على القدرة على خوض الحرب)\nمثال: واجهنا جيشًا ذا قوة كبيرة / قُدْرَة, مَقْدِرَة",
 "戦務": "خِدْمَة",
 "戦勝": "اِنْتِصَار, نَصْر",
 "戦勝者": "غالب, منتصر (مقاتل قادر على هزيمة المنافسين)",
 "戦区": "مَسْرَح حَرْب",
 "戦地": "جَبْهَة",
 "戦域": "سَاحَة حَرْب, سَاحَة مَعْرَكَة",
 "戦場": "سَاحَة حَرْب, سَاحَة مَعْرَكَة",
 "戦士": "جُنْدِيّ, عَسْكَرِيّ (لقب عسكري يُطلق على من يلتحق بالجَيْش ويعمل فيه، مقاتل، محارب، عسكري؛ (في…)\nمثال: غادر ذلك الجندي.",
 "戦役": "حملة, حملة عسكرية (عدة عمليات مترابطة تهدف إلى تحقيق هدف معين (عادة ضمن قيود جغرافية وزمنية))",
 "戦意": "رُوح مَعْنَوِيَّة (رَوَّحَ عليه بالمِرْوحَة: حَرَّكَها ليجلبَ إِليه نسيمَ الهواء؛ رَوَّحَ بالقوم:…)\nمثال: كان سامي هو روح الحفلة.",
 "戦慄": "ارتجاف, رعشة (اهتزاز لا إرادي (كما لو كان بسبب المرض أو الخوف))\nمثال: سرت فيه رعشة مفاجئة",
 "戦慄く": "اِخْتَلَجَ, اِرْتَجَفَ",
 "戦旗": "راية المعركة (علم يقود القوات إلى المعركة)",
 "戦時": "زَمَن الْحَرْب, وَقْت الْحَرْب",
 "戦時下": "زَمَن الْحَرْب, وَقْت الْحَرْب",
 "戦時共産主義": "شُيُوعِيَّةُ الْحَرْب",
 "戦時国際法": "قَانُون دُوَلِيّ (مقياس كل شيء وطريقه؛ أمر كليّ ينطبق على جميع جزئياته التي تعرف أحكامها منه)\nمثال: ذكرني بالقانون.",
 "戦時犯罪": "جَرِيمَةْ حَرْب",
 "戦機": "إِسْتْرَاتِيجِيَّة (الإستراتيجية فن وعلم وضع خُطط الحرب وإدارة العمليَّات الحربيَّة: إستراتيجيَّة…)\nمثال: ستحمي روسيا مصالحها الإستراتيجية كما تفعل الولايات المتحدة.",
 "戦歴": "خِدْمَةٌ عَسْكَرِيَّة",
 "戦没者追悼記念日": "يوم الذكرى (عطلة قانونية في الولايات المتحدة، آخر يوم اثنين في مايو؛ يحيي ذكرى أعضاء القوات…)",
 "戦法": "تَكْتِيك (فن وضع خطط حربية؛ وسائل وخطط وطرق تنفيذية تتخد للنجاح في أمر ما. مثال: تكتيك…)",
 "戦火": "حَرْب (حَرَبَ (حربه) بالحربة حربا: طعنه بها؛ حَرَبَ (ه) حربا: سلبه جميع ما يملك)\nمثال: بوتين مجرم حرب.",
 "戦犯": "مُجْرِم حَرْب, مُجْرِمَة حَرْب",
 "戦略": "إِسْتْرَاتِيجِيَّة (الإستراتيجية فن وعلم وضع خُطط الحرب وإدارة العمليَّات الحربيَّة: إستراتيجيَّة…)\nمثال: ستحمي روسيا مصالحها الإستراتيجية كما تفعل الولايات المتحدة.",
