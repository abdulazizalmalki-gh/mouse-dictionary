 "指揮所演習": "المقر العام, مركز القيادة (مقر عسكري يسيطر منه القائد العسكري وينظم القوات)",
 "指揮棒": "هِرَاوَة\nمثال: لا تمسك العصا من الوسط.",
 "指揮者": "قَائِدُ فِرْقَاتٍ مُوسِيقِيَّةٍ / آمِر, مُقَدَّم",
 "指揮車": "رَئِيس الإِطْفاء, مَأْمُور الإِطْفاء (رئيس إدارة الإطفاء)",
 "指揮隊車": "رَئِيس الإِطْفاء, مَأْمُور الإِطْفاء (رئيس إدارة الإطفاء)",
 "指摘": "إشارة, تبيان (دلالة عن طريق العرض أو التوضيح)",
 "指数": "دَلِيل, فِهْرِس / أُسّ",
 "指数化": "ربط بمؤشر, مقايسة (نظام للتنظيم الاقتصادي: يتم ربط الأجور والفائدة بمؤشر تكلفة المعيشة لتقليل آثار…)",
 "指数化方式": "ربط بمؤشر, مقايسة (نظام للتنظيم الاقتصادي: يتم ربط الأجور والفائدة بمؤشر تكلفة المعيشة لتقليل آثار…)",
 "指数的": "أُسِّيّ",
 "指数部": "صِفَة (صُفَّة المَسْجِد هي موضع مُظَلَّل منه بين جدران ثلاثة؛ هي غُرْفَة ذات ثلاث…)\nمثال: محاسبة النفس صفة حميدة.",
 "指数関数": "دَالَّة أُسِّيَّة (دالة يظهر فيها متغير مستقل كأس)",
 "指数関数的": "أُسِّيّ",
 "指文字": "تهجئة بالأصابع (أبجدية من الإشارات اليدوية)",
 "指板": "لوحة الأصابع (شريط ضيق من الخشب على عنق بعض الآلات الوترية (كالكمان أو التشيلو أو الجيتار…) / لوحة حماية الباب (غطاء واقٍ مسطح (على باب أو حائط إلخ) لمنع الاتساخ بالأصابع المتسخة)",
 "指標": "دَلِيل, فِهْرِس",
 "指標レジスタ": "سجل الفهرس ((في علم الحاسوب) سجل يستخدم لتحديد عنوان المعامل)",
 "指物": "أعمال الموبيليا, صناعة الخزائن (حرفة صنع الأثاث (خاصة الأثاث عالي الجودة)) / دَبُّوس / علم الدولة (علم يظهر جنسيته)\nمثال: أعلنت ربطة عنقه عن ألوان مدرسته",
 "指物師": "صانع الأثاث, صانع الخزائن (نجار متخصص في صنع الأثاث)",
 "指猿": "آيْآي",
 "指環": "حَلْقَة",
 "指甲花": "حِنَّاء (الحِنَّاءُ : نَبَات من الفصيلة الخثرية التي تتبع رتبة الآسيّات، وَرَقُهُ كورق…)\nمثال: طائر ابو الحناء هو من اشهر الطيور المغردة التي تعيش في انكلترا .",
 "指矩": "زاوية النجار (زاوية فولاذية يستخدمها النجارون؛ أكبر من الزاوية القائمة العادية)",
 "指示": "قراءة, قراءة العداد (بيان حول حالة فيزيائية معينة يتم تقديمه للمستخدم بواسطة عداد أو أداة مماثلة)\nمثال: لم يصدق قراءة العداد / دليل التعليمات, كتيب التعليمات (دليل يرافق عادة جهازاً تقنياً ويشرح كيفية تثبيته أو تشغيله)",
 "指示す": "دَلَّ عَلَى, رَمَزَ إِلَى (مَعِدَة، بَطْن؛ قَلْب)\nمثال: بدل سامي ملابسه.",
 "指示代名詞": "اسم إشارة, ضمير إشارة (ضمير يشير إلى مرجع مقصود)",
 "指示先": "دَرِيئَة, نِيشَان\nمثال: لقد أخطأ الهدف.",
 "指示器": "مُؤَشِّر",
 "指示器を出す": "إِشَارَة",
 "指示子": "مُؤَشِّر",
 "指示板": "لَافِتَة, لَوْحَة",
 "指示棒": "مُؤَشِّر",
 "指示薬": "مُؤَشِّر",
 "指示詞": "عاطفي, معبر عن المشاعر (يميل إلى أو يتميز بالتعبير الصريح عن العاطفة)\nمثال: عائلة حنونة ومعبرة عن مشاعرها",
 "指示語": "عاطفي, معبر عن المشاعر (يميل إلى أو يتميز بالتعبير الصريح عن العاطفة)\nمثال: عائلة حنونة ومعبرة عن مشاعرها",
 "指穴": "ثقب الإصبع (ثقب لإدخال الإصبع)",
 "指紋": "بَصْمَة",
 "指紋押捺": "أخذ البصمات (إجراء أخذ انطباعات بالحبر لبصمات أصابع الشخص لغرض تحديد الهوية)",
 "指結び": "أبوسوم (جرابي شجري ليلي له ذيل قابض عارٍ يوجد من جنوب أمريكا الشمالية إلى شمال أمريكا…)",
 "指縄": "دبوس التوازن (أي من الأجنحة الخلفية الضامرة للحشرات ثنائية الأجنحة؛ تستخدم للحفاظ على التوازن…)",
 "指行性": "إصبعي السير, مترجل على الأصابع ((عن الثدييات) السير على أصابع القدمين مع رفع الجزء الخلفي من القدم (كما تفعل…)",
 "指触り": "لَمَسَ (اتصل بشيء أو شخص بشكل مباشر بواسطة جزء من الجسم مثل اليد، التواصل الحسي أو…)\nمثال: إياك ولمس شطيرتي!",
 "指話法": "لغة الإشارة (لغة يتم التعبير عنها بإيماءات اليد المرئية)",
 "指貫": "كُشْتُبَان, كُسْتِبَان",
 "指貫き": "كُشْتُبَان, كُسْتِبَان",
 "指輪": "حَلْقَة",
 "指遣い": "تلمس, لمس بالأصابع (لمس شيء ما بالأصابع)",
 "指金": "حَلْقَة",
 "指針": "إِبْرَة, مِخْيَط / تَوْجِيهَات",
 "指関節": "مفصل بين السلاميات (أي من المفاصل بين سلاميات أصابع اليد أو القدم)",
 "指頭": "بَنَان, أُنْمُلَة (أَطْرَافُ الأَصَابِعِ)\nمثال: لبنان دولة صغيرة.",
 "指骨": "سُلَامَى, سُلَامِيَّة",
 "按じる": "وصية عقارية ((قانون) هبة لممتلكات عقارية بموجب وصية) / سكتة دِمَاغِيَّة",
 "按ずる": "وصية عقارية ((قانون) هبة لممتلكات عقارية بموجب وصية) / سكتة دِمَاغِيَّة",
 "按司": "رئيس, زعيم (قائد مجموعة من الناس)\nمثال: من أقطاب الصناعة",
 "按手": "رِسامة",
 "按手礼": "وضع اليد (وضع الأيدي على رأس الشخص لطلب البركة الروحية في الرسامة المسيحية)",
 "按摩": "تَدْلِيك, تَمْسِيد / مُدَلِّك / مَكْفوف",
 "按摩さん": "مُدَلِّكَة",
 "按摩師": "مُدَلِّكَة",
 "按配": "بَهَار, تَابِل / شَرْط (شَرِطَ فلانٌ يَشْرِطِ شَرْطًا: وقع في أَمر عظيمٍ)\nمثال: صرخ ليون: \"شرطة!\" / صِحَّة, عَافِيَة (سَلَامَة؛ سَلَامَة الْجِسْم)\nمثال: أشك في صحة ذلك. / تَرْتِيب (تنظيم الأشياء أو الأحداث في تسلسل معين أو وضعها في نظام؛ إعداد أو تجهيز شيء…)\nمثال: أعاد زيري ترتيب المطبخ كلية.",
 "按針": "طَيَّار, طَيَّارَة (اسم فاعل للمبالغة على وزن فَعَّال؛ الذي يقود الطَائِرَة سواء كانت مهنته أم لا)\nمثال: لم توجه أبدا تهمة القيادة غير المسؤولة للطيار.",
 "挌技": "شخصاً لشخص, فرداً لفرد ((لشخصين) في لقاء مباشر)\nمثال: فضل تسوية الأمر فرداً لفرد",
 "挑む": "عَالَجَ",
 "挑戦": "تَحَدٍّ, التَّحَدِّي",
 "挑戦状": "تَحَدٍّ, التَّحَدِّي",
 "挑戦的": "تَحَدٍّ, طَمُوح (يَتَطَلَّب اسْتِخْدَام كَامِل القُدُرَات أَوِ المَوَارِد)",
 "挑戦者": "خصم, غريم (المتسابق الذي تأمل في هزيمته)\nمثال: كان يحترم خصومه",
 "挑発": "إِثَارَة, اِسْتِفْزَاز (إِثَارَة: يُجمع على إثارات)\nمثال: كف عن إثارة غضبي.",
 "挑発的": "مُسْتَفِز / إِيحَائِيّ, مُوحٍ (يميل إلى الإيحاء بشيء غير لائق أو فاحش)",
 "挘る": "قَطَفَ (قطفت الدّابّة قِطَافاً: أَبْطَأَتْ، في أمثالهم: (أَقْطَفُ من أرنب)؛ قَطَفَ…)\nمثال: أحب قطف الورود.",
 "挙": "عَمَل (فِعْل، صُنْع؛ وسيلة للكسب، مِهْنَة، حِرْفَة)\nمثال: المهم هو العمل. / تَوْصِيَة",
 "挙げた": "مَاضٍ, الْمَاضِي ((في النحو) زمن نحوي يدل على حدث قد وقع، أو وُجِد قبل الآن بوقت ما)",
 "挙げて": "كُلّ, جَمِيع",
 "挙げる": "أَعْطَى, وَهَبَ (مَنَحَ، نَوَّلَ)\nمثال: أعطى بلده حياته. / جَمَعَ (ضَمَّ، لَمَّ، حَشَدَ؛ في : أَضَافَ أعدادا إلى غيرها)\nمثال: جمع خيل هو خيول. / تَوْقِيف, اِعْتِقَال\nمثال: اعتقل لقيادته و هو سكران. / رَشَّحَ, عَيَّنَ (اقتَرَح شخصًا أو جهةً ليكون مرشَّحًا لمنصب أو مهمة؛ جعَل شيئًا يرشُح أو يُصفّى)",
 "挙げ句の果て": "أخيراً, في الختام (كنتيجة نهائية لتتابع أو عملية)",
 "挙って": "كُلّ, جَمِيع",
 "挙上": "منسوب",
 "挙例": "رسم توضيحي (تمثيل مرئي (صورة أو مخطط) يستخدم لجعل موضوع ما أكثر متعة أو أسهل للفهم)\nمثال: يقدم هذا المريض مثالاً نموذجياً للمتلازمة",
 "挙動": "تصرف, سلوك (طريقة التصرف أو التحكم بالنفس)",
 "挙句": "بعد (يدل على اللحاق في الزمان؛ يكون مضافا، وينصب أو يجر)\nمثال: و بعد قليل أتى.",
 "挙句の果て": "أَخِيراً",
 "挙尾虫": "شَوَّالَة",
 "挙式": "زفاف, عقد قران (الحدث الاجتماعي الذي تُجرى فيه مراسم الزواج)",
 "挙手": "تَحِيَّة (فعل التحية بكلمات وإيماءات ودية مثل الانحناء أو رفع القبعة)\nمثال: تحية موسيقية للملحن في عيد ميلاده",
 "挙措": "سُلُوك, تَصَرُّف",
 "挙措進退": "سُلُوك, تَصَرُّف",
 "挙止": "رمان بلي, كرسي تحميل (دعامة دوارة توضع بين الأجزاء المتحركة للسماح لها بالحركة بسهولة)\nمثال: وقف بوضعية جيدة",
 "挙用": "مَوْعِد, مِيعَاد (مَوْعِد الإفطار،أي وقت الإفطار؛ لديه مَوْعِد مع صديق)\nمثال: مناد عنده موعد.",
 "挙示": "حَالِيّ, حَاضِر\nمثال: أنا موجود لوحدي",
 "挙筋": "عضلة رافعة (عضلة تعمل على رفع جزء من الجسم (مثل الجفن أو الشفة))",
 "挙績": "إجمالي الإيرادات, إجمالي المبيعات (الدخل (بقيم الفواتير) المستلم للبضائع والخدمات خلال فترة معينة)",
 "挙行": "اِحْتِفَال (إقامة مراسم أو فعاليات تعبيرًا عن مناسبة معينة)\nمثال: لم يحضر الاحتفال.",
 "挙証": "بُرْهَان, دَلِيل",
 "挙証責任": "عِبْء الإثْبات, عِبْء البَيِّنة (عِبْء: اسم؛ الحمل الثقيل. \"يحمل على كاهله عبأً\")",
 "挟み": "مِشْبَك / كلاب, مخلب (هيكل للإمساك على طرف القشريات أو مفصليات الأرجل الأخرى)",
 "挟み上げる": "قَطَفَ (قطفت الدّابّة قِطَافاً: أَبْطَأَتْ، في أمثالهم: (أَقْطَفُ من أرنب)؛ قَطَفَ…)\nمثال: أحب قطف الورود.",
 "挟み付け": "مَشْبَك",
 "挟み切る": "قصاصة, قُصاصة (عملية القص أو القصقصة)",
 "挟み虫": "أَبُو مِقَصّ",
 "挟み込む": "أَدْخَلَ",
 "挟む": "مَقْبِض / أَدْخَلَ / لُقْطَة\nمثال: كنت أمسك بالكرة. / مرفأ, ملاذ (مكان للملجأ والراحة والأمان) / أَدْخَلَ / قَاطَعَ / مَرْفَأ, مَرْسَى",
 "挟殺": "بيان ختامي, خلاصة نهائية (ملخص ختامي (كما في عرض قضية أمام محكمة قانونية))",
 "挨拶": "تَحِيَّة (مصدر للفعل \"حَيَّا\"؛ عبارة لفظية أو جسدية تُبدأ بها الرسالة أو المحادثة غرضها…)\nمثال: ألقى زيري تحية. / حَدِيث, خُطْبَة (جَدِيد؛ الخبر عن ما حدث)\nمثال: توقف عن الحديث. / أَجَابَ, رَدَّ (رَدَّ على سُؤالٍ أو طلبٍ؛ أَمْتَثَلَ لِمُطَالَبَةٍ أو دعوةٍ)\nمثال: أجاب ياني فورا. / ثَأْر, اِنْتِقَام ((ثَأَرَ) الْقَتِيلَ وَبِالْقَتِيلِ: أَيْ قَتَلَ قَاتِلَهُ)\nمثال: كل ما فعل سامي كان بداعي الثأر.",
 "挨拶文": "استهلال, تحية الافتتاح (كلمة تحية تستخدم لبدء رسالة)\nمثال: تحية موسيقية للملحن في عيد ميلاده",
 "挨拶状": "بطاقة تهنئة, بطاقة معايدة (بطاقة تُرسل للتعبير عن تحيات شخصية)",
 "挫き": "اِلْتِوَاء",
 "挫く": "اِلْتِوَاء",
 "挫ける": "يَئِسَ, أُحْبِطَ",
 "挫傷": "اِلْتِوَاء",
 "挫創": "رَضّ (رَضَّ يَرُضُّ: رَضًّا؛ رَضَّ الشيء: دقه وطحنه طحنا خشنا)",
 "挫折": "نَكْسَة",
 "挫滅": "سَاحِق, مُدَمِّر (مُدَمِّرٌ مَادِّيًّا أَوْ مَعْنَوِيًّا؛ يُسْتَخْدَمُ غَالِبًا فِي…)\nمثال: قمع الهرطقة",
 "振う": "تَأَرْجَحَ / تَمْرِين, تَدْرِيب / جذل, فانفار ((موسيقى) لحن حيوي قصير يُعزف على الآلات النحاسية)\nمثال: دخل على وقع نغمة احتفالية من الأبواق",
 "振とう": "صَدْمَة",
 "振り": "تَأَرْجَحَ / ظُهُور (عِيْدُ الظُّهُوْر: عيد للنَصَارَى يُسَمَّى أيضا عيد التَجَلِّي)\nمثال: لا أحد لاحظ ظهور الدب. / ادعاء, تصنع (فعل إعطاء مظهر زائف)\nمثال: كان امتثاله مجرد تظاهر / وَضْعِيَّة / طَرِيق, سَبِيل (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من…)\nمثال: أسأل عن الطريق. / مَبْلَغ, مِقْدَار / لَحْن (وضع الألحان أو التأليف الموسيقي؛ قرأ النص بلحن أو أداء صوتي مميز)\nمثال: أنا أحب هذا اللحن.",
 "振りかえる": "تَغَيَّرَƒ\nمثال: أنا غير متفاجئ.",
 "振りかざす": "رَفَعَ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ)\nمثال: رفع سامي نظارته. / مَارَسَ (ومَرِسَ؛ إله الحرب في الأساطير الرُومِيَّة، وهو المَرِيِّخ، لا يؤنث ولا يجمع)\nمثال: مارس الأمازيغية.",
 "振りかぶる": "إشهار, تلويح (فعل التلويح)",
 "振りたてる": "تمرير, رمي ((رياضة) فعل رمي الكرة لعضو آخر في فريقك)\nمثال: تم إهدار التمريرة",
 "振りまく": "نَثَرَ, تَفَرَّقَ / بَاذِخ, مُسْرِف فِي العَطَاء (بالغ السخاء؛ يُعطي بإسراف ودون حساب)",
 "振りをする": "اِدَّعَى\nمثال: تظاهر بأنه طبيب.",
 "振り上げる": "رَفَعَ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ)\nمثال: رفع سامي نظارته.",
 "振り付け": "تَصْمِم الرَّقْص",
