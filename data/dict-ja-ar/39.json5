 "水域": "سائل أمينوسي, سائل سلوي (السائل المصلي الذي يعلق فيه الجنين داخل السلى)",
 "水場": "حمامات معدنية, منتجع صحي (منتجع صحي يقع بالقرب من نبع أو عند شاطئ البحر)",
 "水増し": "تَخْفِيف / تَضَخُّم (الزِّيادة المُفرِطة في الحجم؛ الزِّيادة المُفرِطة في الوسائل والأَشخاص) / تَضَخُّم, زِيَادَة (الزِّيادة المُفرِطة في الحجم؛ الزِّيادة المُفرِطة في الوسائل والأَشخاص)\nمثال: الجزائر تعاني من التضخم.",
 "水増し株": "أسهم مخففة, أسهم وهمية (أسهم تمثل ملكية أصول مبالغ في قيمتها؛ أسهم شركة تكون قيمتها الإجمالية أقل من رأس مالها المستثمر)",
 "水壕": "قفزة مائية (بركة أو تيار مائي في سباق الحواجز أو مسابقة مماثلة) / خَنْدَق",
 "水大砲": "مِدْفَع مَاء (آلة حربية تَقْذِف الكتل الحَدِيدِيَّة أو النَارِيَّة مثل المَنْجَنِيق. بعض العامة تقول مَدْفَع وهذا خطأ. يُجمع جَمْع تَكْسِير على مَدَافِع)",
 "水太り": "مُتَرَهِّل",
 "水夫": "بَحَّار (صيغة مبالغة من بَحَرَ بمعنى الذي يبحر كثيرا؛ الرجل الذي يتخذ من الملاحة أي ركوب البحر عملا له) / بَحْرِيّ / مَلَّاح / نُوتِيّ / نَوْتِيّ\nمثال: هى متزوجة من بحار.",
 "水夫長": "رئيس البحارة (ضابط صف على سفينة تجارية يراقب عمل البحارة الآخرين)",
 "水密": "رَاسِخ, مَنِيع (خَالٍ مِنَ الثَّغَرَاتِ أَوِ العُيُوب) / مَانِع لِلْمَاء (لا يسمح بمرور الماء دخولاً أو خروجاً)",
 "水尾": "مَمَرّ مَائِيّ (على مَمَرّ العصور: على طولها ومداها؛ على مَمَرّ الفصول: على تواليها وتعاقبها)\nمثال: الباب في نهاية الممر. / أَيْقَظَ (نبَّهه، ضد نَوَّمَه؛ الغبارَ: أثاره)\nمثال: أيقظ زيري السائق",
 "水屋": "مَطْبَخ (المكان الذي يُطْبَخُ فيه، غُرْفَة أو مساحة في البناء مخصصة للطبخ؛ في : هو المَطْعَم)\nمثال: سامي في المطبخ. / خِزَانَة (مكان الخَزْن؛ قطعة أثاث للخَزْن)\nمثال: اقترب من الخزانة.",
 "水差": "إِبْرِيق, زِير",
 "水差し": "إِبْرِيق, زِير",
 "水平": "أُفُقِيّ",
 "水平器": "مُسْتَوًى / مَرْحَلَة",
 "水平尾翼": "ذيل الطائرة, مثبت أفقي (السطح الانسيابي الأفقي لمجموعة ذيل الطائرة الذي يكون ثابتاً ويتم تعليق الرافع عليه)",
 "水平展開": "شَعْبِيّ قَاعِدِيّ (يتعلق بعامة الناس بوصفهم جماعة سياسية واقتصادية أساسية) / شَعْبِيّ, قَاعِدِيّ (أساسيّ نابع من القاعدة الشعبية)",
 "水平思考": "تفكير جانبي (نهج استكشافي لحل المشكلات؛ حيث تحاول النظر إلى المشكلة من زوايا عديدة بدلاً من معالجتها بشكل مباشر)",
 "水平線": "أُفُق ((أَفِقَ) أفَقَاً: بلغ النِّهَايَة فِي الْكَرم وَالْعلم فَهُوَ أفق وأفيق)\nمثال: طلعت الشمس فوق الأفق.",
 "水底": "قاع النهر (قناة يشغلها (أو كان يشغلها) نهر)",
 "水彩画家": "رسام ألوان مائية (رسام يرسم بالألوان المائية)",
 "水彩絵の具": "ألوان مائية (فن أو تقنية الرسم بالألوان المائية) / لوحة مائية (لوحة منتجة بالألوان المائية) / ألوان مائية (طلاء مائي (بأصباغ قابلة للذوبان في الماء)؛ يستخدمه الفنانون) / لون مائي (خضاب قابل للذوبان في الماء)",
 "水彩絵具": "ألوان مائية (فن أو تقنية الرسم بالألوان المائية) / لوحة مائية (لوحة منتجة بالألوان المائية) / ألوان مائية (طلاء مائي (بأصباغ قابلة للذوبان في الماء)؛ يستخدمه الفنانون) / لون مائي (خضاب قابل للذوبان في الماء)",
 "水彩色鉛筆": "ذَوَّابٌ فِي المَاء (قابل للذوبان في الماء)",
 "水性": "مَائِيّ / ذَوَّابٌ فِي المَاء (قابل للذوبان في الماء) / انْسِيَابِيَّة, سُيُولَة (صفة متغيرة) / سيولة (خاصية التدفق بسهولة)\nمثال: انسيابية شرقية ساحرة في الأسلوب",
 "水性ペンキ": "مُسْتَحْلَب",
 "水性塗料": "مُسْتَحْلَب",
 "水恐怖症": "رهاب الغرق, رهاب الماء (خوف مرضي من الغرق)",
 "水成論": "نبتونية (النظرية القديمة القائلة بأن جميع صخور القشرة الأرضية تشكلت بفعل الماء)",
 "水戸": "مِيتُو",
 "水手": "بَحَّار (صيغة مبالغة من بَحَرَ بمعنى الذي يبحر كثيرا؛ الرجل الذي يتخذ من الملاحة أي ركوب البحر عملا له) / بَحْرِيّ / مَلَّاح / نُوتِيّ / نَوْتِيّ\nمثال: هى متزوجة من بحار.",
 "水抜き": "مُرْهِق, مُنْهِك (له أثر مُوهِن ومُنهِك للقوى) / بَالُوعَة",
 "水指": "إِبْرِيق, زِير",
 "水指し": "إِبْرِيق, زِير",
 "水捌け": "تَصْرِيف",
 "水掻き": "ويب / مِضْرَب / جَدَّفَ (معنى الفعل في سياقات متعددة تتراوح بين الطيران والسير، وحتى في الدلالات المجازية كالرمي والقطع؛ الفعل له معانٍ متعددة: رمي (كالسماء بالبرد)، الإسراع في المشي، كفر بالنعم وعدم الرضا بها، ودفع السفينة بالمجاديف)",
 "水揚げ": "هُبُوط / بَسْطَة / لُقْطَة / أَمْسَكَ (حَبَسَ الشيءَ، قَبَضَ عَلَيْهِ. و (يتعدى بالباء)؛ اِمْتَنَعَ بالشيءِ، اِعْتَصَمَ بِه. (يتعدى بالباء)) / مَسَكَ\nمثال: كنت أمسك بالكرة. / إجمالي الإيرادات, إجمالي المبيعات (الدخل (بقيم الفواتير) المستلم للبضائع والخدمات خلال فترة معينة) / تَصَرُّف",
 "水撃": "طرق مائي (صوت طرق البخار في الأنابيب)",
 "水撒き": "ري, سقي (التبليل بالماء) / إدماع, تدميع (ذرف الدموع)\nمثال: العشب يحتاج إلى الكثير من الري",
 "水文学": "عِلْم المِيَاهِيَّات (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "水族館": "حَوْض اَلسَّمَك, أَكْوَارِيُوم (حَوَّضَ: عمِل حوضًا؛ حَوَّضَ (الماءَ): حاضَه) / حَوْض اَلسَّمَك, مَعْرِضُ الْأَحْيَاءِ الْمَائِيَّةِ (حَوَّضَ: عمِل حوضًا؛ حَوَّضَ (الماءَ): حاضَه)\nمثال: ملأت الحوض ماءا.",
 "水星": "زِئْبَق, زَاؤُوق / حُلْبُوب",
 "水時計": "سَاعَةٌ مَائِيَّة (ثُلْث ثُمْن اليَوْم بمعنى مجموع النَهَار واللَيْل، أي جزء من أربعة وعشرين جزءا من مجموع النهار والليل وتتكون من ستين دَقِيقَة؛ الوَقْت الحاضر، الآن)\nمثال: درست لمدة ساعة.",
 "水晶": "قَرِيس, قَرِيت",
 "水晶体": "عدسة, عدسة العين (جسم شفاف محدب الوجهين يقع خلف القزحية في العين؛ دورها (جنباً إلى جنب مع القرنية) هو تركيز الضوء على الشبكية)",
 "水晶振動子": "مذبذب بلوري, مذبذب كوارتز (مذبذب ينتج ذبذبات كهربائية بتردد تحدده الخصائص الفيزيائية لبلورة كوارتز كهرضغطية)",
 "水晶玉": "كُرَة بِلَّوْرِيَّة",
 "水晶球": "كُرَة بِلَّوْرِيَّة",
 "水曜": "الْأَرْبِعَاء, يَوْم الْأَرْبِعَاء",
 "水曜日": "الْأَرْبِعَاء, يَوْم الْأَرْبِعَاء",
 "水月": "ضفيرة زلاقية, ضفيرة شمسية (ضفيرة كبيرة من الأعصاب الودية في البطن خلف المعدة)",
 "水木": "شجرة القرانيا, قرانيا (شجرة أو شجيرة من جنس قرانيا غالباً ما يكون لها قنابات مبهرجة تشبه الزهور) / خشب القرانيا (خشب صلب قوي لأي قرانيا من جنس كورنوس؛ يشبه خشب البقس)",
 "水枯れ": "جَفَاف",
 "水栓": "حَنَفِيَّة, صُنْبُور",
 "水栽培": "زراعة مائية (تقنية زراعة النباتات (بدون تربة) في ماء يحتوي على مغذيات مذابة)",
 "水桶": "دلو, سطل (وعاء أسطواني الشكل مفتوح من الأعلى) / ملء دلو (الكمية المحتواة في دلو) / صِهْرِيج, فِنْطَاس (حوض تجتمع فيه الماء؛ وسيلة النقل التي تنقل الماء)\nمثال: الصهريج مملوء بالماء.",
 "水棲": "مَائِيّ",
 "水様": "رَقِيق, مَائِيّ (مُخَفَّف أَكْثَر مِنَ اللَّازِم؛ ضَعِيف وَبِلَا طَعْم) / مَائِيّ (متعلّق بالماء أو شبيه به أو مؤلَّف منه) / دَامِع, رَاشِح (مبلَّل بإفرازات رطبة كالعَرَق أو الدموع) / مَمْلُوء بِالْمَاء (مملوء بالماء)",
 "水様液": "خلط مائي, سائل مائي (السائل الصافي داخل مقلة العين بين القرنية والعدسة)",
 "水槽": "خزان المرحاض, سيفون (خزان يحمل الماء المستخدم في شطف المرحاض) / حَوْض سَمَك (حَوَّضَ: عمِل حوضًا؛ حَوَّضَ (الماءَ): حاضَه)\nمثال: ملأت الحوض ماءا.",
 "水槽車": "شاحنة صهريج (مركبة آلية مصممة لحمل حمولات سائلة أو بضائع سائبة جافة أو غازات على الطرق)",
 "水歯磨": "غَسُولُ فَمّ",
 "水歯磨き": "غَسُولُ فَمّ",
 "水母": "قِنْدِيل الْبَحْر (مصباح فيه فتيل يُضاء بالزيت) / قِنْدِيل (مصباح فيه فتيل يُضاء بالزيت)",
 "水気": "رُطُوبَة / بُخَار مَاء (كلُّ رَائِحَةٍ سَطَعَتْ مِنْ نَتْنٍ أَو غَيْرِهِ؛ كل مَا يصعد كالدخان من السوائل الحارة والرائحة)\nمثال: السحابة هي كتلة بخار في السماء. / اِسْتِسْقَاء",
 "水氷": "جَلِيد, ثَلْج",
 "水没": "انغمار, غمر (الغرق حتى التغطية بالماء تماماً)",
 "水沫": "رَغْوَة / زَبَد (هو السَمْن الموجود في الحَلِيب يستخرج بأن يُخَضّ الحليب خَضا مستمرا حتى يتكتل بداخله) / زَبَد البَحْر (هو السَمْن الموجود في الحَلِيب يستخرج بأن يُخَضّ الحليب خَضا مستمرا حتى يتكتل بداخله)\nمثال: اشترت رطلي زبدة. / لَا شَيْء (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: لا أحب المدرسة.",
 "水油": "زيت شعر, مستحضر للشعر (مستحضر تجميلي للعناية بالشعر) / كِيرُوسِين",
 "水治療法": "علاج مائي (الاستخدام الداخلي والخارجي للماء في علاج المرض)",
 "水泡": "رَغْوَة / زَبَد (هو السَمْن الموجود في الحَلِيب يستخرج بأن يُخَضّ الحليب خَضا مستمرا حتى يتكتل بداخله) / زَبَد البَحْر (هو السَمْن الموجود في الحَلِيب يستخرج بأن يُخَضّ الحليب خَضا مستمرا حتى يتكتل بداخله)\nمثال: اشترت رطلي زبدة. / لَا شَيْء (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: لا أحب المدرسة.",
 "水泳": "سِبَاحَة",
 "水泳プール": "مَسْبَح, حَمَّام سِبَاحَة",
 "水泳大会": "بطولة سباحة, ملتقى سباحة (مسابقة سباحة بين فريقين أو أكثر)",
 "水泳着": "مايوه, ملابس سباحة (رداء ضيق يلبس للسباحة)",
 "水泳競技": "رياضة مائية (الرياضات التي تشمل المسطحات المائية)",
 "水泳者": "سَبَّاح, عَوَّام",
 "水洗": "شطف (إزالة الصابون بالماء النظيف في المرحلة النهائية من الغسيل)",
 "水洗トイレ": "مرحاض دافق (مرحاض يتم تنظيفه من الفضلات عن طريق تدفق المياه عبره)",
 "水洗便所": "مرحاض دافق (مرحاض يتم تنظيفه من الفضلات عن طريق تدفق المياه عبره)",
 "水洗式トイレ": "مرحاض دافق (مرحاض يتم تنظيفه من الفضلات عن طريق تدفق المياه عبره)",
 "水洗式便所": "مرحاض دافق (مرحاض يتم تنظيفه من الفضلات عن طريق تدفق المياه عبره)",
 "水洟": "رَشْح (اقتَرَح شخصًا أو جهةً ليكون مرشَّحًا لمنصب أو مهمة؛ جعَل شيئًا يرشُح أو يُصفّى)",
 "水流ポンプ": "شَفَّاطة, رُشَافَة",
 "水浅葱": "أَزْرَق فَاتِح (بدرجة فاتحة من الأزرق)",
 "水浴": "حَمَّام, مُغْسَل (قضاء الموت وقدره؛ جمع حُمَّة وهو قدر الفراق) / حَمَّام, مُغْتَسَل (قضاء الموت وقدره؛ جمع حُمَّة وهو قدر الفراق) / اِسْتِحْمَام, اِغْتِسَال\nمثال: هل الحمام جاهز؟",
 "水浴び": "استحمام, اغتسال (فعل غسل النفس (أو شخص آخر)) / استجمام, اغتسال (غمر الجسم في الماء أو تعريضه للشمس بغرض الاستجمام) / سِبَاحَة",
 "水浸し": "تغطيس, غمر (فعل تبليل شيء بغمره) / انغمار, غمر (الغرق حتى التغطية بالماء تماماً)",
 "水涸れ": "جَفَاف",
 "水深計": "مقياس العمق (مقياس لقياس عمق الأخاديد أو الثقوب أو التجاويف الأخرى)",
 "水添": "هدرجة (عملية كيميائية تضيف ذرات الهيدروجين إلى زيت غير مشبع)\nمثال: يستخدم منتجو الأغذية الهدرجة لمنع الدهون من التعفن",
 "水源": "مصدر غني, منبع (مصدر وفير) / مصدر رئيسي, منبع (مصدر المياه الذي ينشأ منه الجدول أو النهر)\nمثال: كانت نبعاً من المعلومات",
 "水源地": "مَصْدَر, مَصَادِر (مَصْدَر) / عَيْن (المُعَايَنَة والمشاهدة؛ العين : حاسة البصر والرؤية - مؤنث - تكون للإنسان وغيره من الحيوان . قال ابن السكيت : العين التي يبصر بها الناظر…) / مَصْدَر (مَصْدَر)\nمثال: ما مصدر هذا الخوف؟",
 "水準": "مُسْتَوًى / مَرْحَلَة / مقياس مستوى الماء, ميزان ماء / مَنْسُوب المِيَاه, مُسْتَوَى المَاء (مستوى سطح جسم مائي) / خط الماء (خط يقابل سطح الماء عندما تكون السفينة طافية بتوازن؛ غالباً ما يُرسم على بدن السفينة) / مستوى الماء, منسوب المياه الجوفية (السطح تحت الأرضي الذي تكون الأرض تحته مشبعة بالكامل بالماء)\nمثال: أمطار الربيع رفعت منسوب المياه الجوفية",
 "水準儀": "ميزان المساح (أداة مسح تتكون أساساً من تلسكوب صغير مع ميزان كحولي ملحق يدور حول محور عمودي؛ لقياس الارتفاعات النسبية للأرض)",
 "水準器": "مِيزَانُ مَاء (آلة تُوزن بها الأشياء ويُعْرف مِقْدارها؛ عَدْل)",
 "水準測量": "تسوية, مساواة (فعل جعل الأشياء متساوية أو موحدة) / تسوية بالأرض, دك (التدمير الكامل لمبنى) / تسوية الأرض, تمهيد (تغيير مستوى الأرض إلى سطح أفقي أملس أو منحدر بلطف)",
 "水準点": "علامة مرجعية, نقطة إسناد (علامة مسّاح على جسم دائم ذي موضع وارتفاع محددين مسبقاً تُستخدم كنقطة مرجعية) / علامة مرجعية, معيار مرجعي (معيار يمكن من خلاله قياس شيء ما أو الحكم عليه)\nمثال: لوحته تضع المعيار للجودة",
 "水溜まり": "غَدِير, بِرْكَة",
 "水溜り": "غَدِير, بِرْكَة",
 "水溶性": "ذَوَّابٌ فِي المَاء (قابل للذوبان في الماء)",
 "水溶液": "محلول مائي (محلول في الماء)",
 "水漉し": "مرشح مياه (مرشح لإزالة الشوائب من إمدادات المياه)",
 "水漏": "تَسَرُّب / تَسْرِيب / سَرَّبَ ((سَرِبَ) المَاء سَرَباً: سَالَ فَهُوَ سَرِب)\nمثال: سرب الطيور ذلك جميل جدا.",
 "水漏り": "تَسَرُّب / تَسْرِيب / سَرَّبَ ((سَرِبَ) المَاء سَرَباً: سَالَ فَهُوَ سَرِب)\nمثال: سرب الطيور ذلك جميل جدا.",
 "水漏れ": "تَسَرُّب / تَسْرِيب / سَرَّبَ ((سَرِبَ) المَاء سَرَباً: سَالَ فَهُوَ سَرِب)\nمثال: سرب الطيور ذلك جميل جدا.",
 "水澄": "دُوَّامَة, جِرِنُوسِيَّة / بق الماء المتزحلق (بق طويل الأرجل ينزلق على سطح الماء)",
 "水澄し": "دُوَّامَة, جِرِنُوسِيَّة / بق الماء المتزحلق (بق طويل الأرجل ينزلق على سطح الماء)",
 "水澄まし": "دُوَّامَة, جِرِنُوسِيَّة / بق الماء المتزحلق (بق طويل الأرجل ينزلق على سطح الماء)",
 "水濠": "قفزة مائية (بركة أو تيار مائي في سباق الحواجز أو مسابقة مماثلة) / خَنْدَق",
