 "掛け声": "صَيح, صِيَاح (مبالغة في الصياح، صاح كثيرا؛ في : صرخ)\nمثال: صرخ طالبا النجدة.",
 "掛け売り代金": "حساب ائتماني, حساب جاري مدين (ائتمان تمنحه شركة لعميل)",
 "掛け変え": "استبدال (عملية توفير شخص أو شيء مكافئ مكان آخر)\nمثال: استبدال النجم لن يكون سهلاً",
 "掛け小屋": "سقيفة مائلة (مأوى بسيط له سقف منحدر واحد فقط)",
 "掛け布": "غطاء قماشي (غطاء مصنوع من القماش)",
 "掛け布団": "لِحَاف",
 "掛け心地": "رَاحَة",
 "掛け時計": "ساعة حائط (ساعة مثبتة على الحائط)",
 "掛け替え": "استبدال (عملية توفير شخص أو شيء مكافئ مكان آخر)\nمثال: استبدال النجم لن يكون سهلاً",
 "掛け替えのない": "لا يستبدل, لا يعوض (مستحيل استبداله)\nمثال: تحف لا تعوض",
 "掛け替える": "اِسْتَبْدَلَ, بَدَّلَ (اتخذ شيئا بدلا من شيء)\nمثال: استبدل ياني حنفية المطبخ.",
 "掛け札": "لافِتَة\nمثال: توم وقع و أصيب.",
 "掛け構い": "قَلِقَ (شاعر بالقَلَق؛ تَحَرّك/اهتزاز/اضطراب في الوضع الطبيعي للشيء)\nمثال: ليلى قلقة بشأنك. / عَلَاقَة, مُنَاسَبَة",
 "掛け橋": "جِسْر (شَجُعَ، جرُؤ؛ أقدم على الخطر واجترأ)\nمثال: اذهب إلى الجسر. / ممشى (مسار مخصص للمشي)\nمثال: بعد العاصفة الثلجية جرف الثلج من الممشى الأمامي",
 "掛け汁": "مَرَق, مَرَقَة (الطَعَام سائل الخفيف فيه ماء اللحم وقد يكون فيه خضار أو غير ذلك. يؤكل عادة مع…)",
 "掛け湯": "مشكلة عويصة, ورطة (مأزق خطير أو مؤلم)\nمثال: آراؤه حول العرق أوقعته في ورطة سياسية",
 "掛け物": "كاكيمونو (معلقة حائطية يابانية (من الورق أو الحرير)؛ عادة ما تكون ضيقة وعليها صورة أو…) / غطاء سرير, مفرش سرير (غطاء مزخرف للسرير)",
 "掛け目": "وَزْن\nمثال: ان ثقل ما تحمل، فضع بعضا منه.",
 "掛け矢": "مدقة, مطرقة خشبية (أداة تشبه المطرقة ولكن برأس كبير (عادة خشبي)؛ تستخدم لدق الأوتاد أو رصف أحجار…)",
 "掛け算": "ضَرْب (معروف، وهو اللطم أو الدق أو الصكّ و ما أشبه؛ النَوْع أو الصنف أو المثال)\nمثال: ضرب سامي زوجته.",
 "掛け紙": "وَرَق تَغْلِيف (ما ينمو على النبات من الأعلى والجوانب بشكل صفائح ذات لون أخضر أو مائل إلى…)\nمثال: هات ورقة بيضاء.",
 "掛け言葉": "لُعْبَة اَلْكَلِمَات, جِنَاس (اللَعْبَة البَرْبَرية دواء عشبيّ)\nمثال: عنده لعبة يويو.",
 "掛け詞": "لُعْبَة اَلْكَلِمَات, جِنَاس (اللَعْبَة البَرْبَرية دواء عشبيّ)\nمثال: عنده لعبة يويو.",
 "掛け違い": "تَبَايُن, تَضَارُب (اختلاف بين حقائق أو ادعاءات أو آراء متعارضة)\nمثال: تباين متزايد في الآراء",
 "掛け違う": "اِخْتَلَفَ (ضد اِتَّفَقَ، كانوا على خِلاف مع بعض أو ذوو آراء مُخْتَلِفَة؛ إلى المكان: كرر…)\nمثال: أنا اختلف معك في الرأي.",
 "掛け金": "قِسْط (عَدْل؛ حِصَّة عادلة)\nمثال: سامي بحاجة إلى قسط من الراحة. / زِلاَج, ضَبَّة",
 "掛け釘": "وَتَد (العصا تثبت في الأرض لتثبيت شيء ما بربطه إليها)",
 "掛り": "بدء, مشاركة أساسية (دور للبدء (في لعبة في البداية))\nمثال: حصل على بدايته لأن أحد الرماة الأساسيين كان في المستشفى / صَرْف, مَصْرُوف (بمعنى أبْعَدَ عن القَصْد أو الغَايَة أو محل الاهتمام؛ بمعنى اَنْفَقَ المَال…)\nمثال: أيمكنك صرف خمسين؟ / حَمْلَة / سفيف الريشة (واحدة من الشعيرات المتوازية التي تبرز من العمود الرئيسي للريشة)\nمثال: كانت كلمته الأخيرة 'اذهب للجحيم' / فِي المُنْتَصَف تَمَامًا (الجزء أو النقطة الوسطى أو المركزية)\nمثال: في وسط الغابة",
 "掛り合い": "عَلَاقَة, مُنَاسَبَة",
 "掛る": "أَخَذَ (تَنَاوَلَ الشيء بيده، تملكه أو تحكم فيه، بالقوة أو بدونها؛ أمْسَكَ بِالشيء…)\nمثال: أخذ الولد يبكي. / عَلِقَ, عِلِق\nمثال: شنق زيري نفسه فوق شجرة. / وَصَلَ (ضَمَّ وَلَأَمَ. (مصدره وَصْل وصِلَة)؛ بَلَغَ الشيءَ، أَدْرَكَه. (يتعدى بإلى)…)\nمثال: وصل السيد باكر. / نَجْمَة, اِبْتِدَاء\nمثال: بدأ سامي يتكلم.",
 "掛値": "زيادة في السعر, سعر مبالغ فيه (سعر مرتفع جداً) / مُبَالَغَة (بصيغة المؤنث؛ الزيادة حتى يبلغ أقصى الشيء أو الأمر)\nمثال: توم يحب المبالغة.",
 "掛声": "صَيح, صِيَاح (مبالغة في الصياح، صاح كثيرا؛ في : صرخ)\nمثال: صرخ طالبا النجدة.",
 "掛小屋": "سقيفة مائلة (مأوى بسيط له سقف منحدر واحد فقط)",
 "掛布団": "لِحَاف",
 "掛時計": "ساعة حائط (ساعة مثبتة على الحائط)",
 "掛構い": "قَلِقَ (شاعر بالقَلَق؛ تَحَرّك/اهتزاز/اضطراب في الوضع الطبيعي للشيء)\nمثال: ليلى قلقة بشأنك. / عَلَاقَة, مُنَاسَبَة",
 "掛橋": "جِسْر (شَجُعَ، جرُؤ؛ أقدم على الخطر واجترأ)\nمثال: اذهب إلى الجسر. / ممشى (مسار مخصص للمشي)\nمثال: بعد العاصفة الثلجية جرف الثلج من الممشى الأمامي",
 "掛物": "كاكيمونو (معلقة حائطية يابانية (من الورق أو الحرير)؛ عادة ما تكون ضيقة وعليها صورة أو…) / غطاء سرير, مفرش سرير (غطاء مزخرف للسرير)",
 "掛目": "وَزْن\nمثال: ان ثقل ما تحمل، فضع بعضا منه.",
 "掛矢": "مدقة, مطرقة خشبية (أداة تشبه المطرقة ولكن برأس كبير (عادة خشبي)؛ تستخدم لدق الأوتاد أو رصف أحجار…)",
 "掛算": "ضَرْب (معروف، وهو اللطم أو الدق أو الصكّ و ما أشبه؛ النَوْع أو الصنف أو المثال)\nمثال: ضرب سامي زوجته.",
 "掛紙": "وَرَق تَغْلِيف (ما ينمو على النبات من الأعلى والجوانب بشكل صفائح ذات لون أخضر أو مائل إلى…)\nمثال: هات ورقة بيضاء.",
 "掛詞": "لُعْبَة اَلْكَلِمَات, جِنَاس (اللَعْبَة البَرْبَرية دواء عشبيّ)\nمثال: عنده لعبة يويو.",
 "掛谷": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "掛違い": "تَبَايُن, تَضَارُب (اختلاف بين حقائق أو ادعاءات أو آراء متعارضة)\nمثال: تباين متزايد في الآراء",
 "掛違う": "اِخْتَلَفَ (ضد اِتَّفَقَ، كانوا على خِلاف مع بعض أو ذوو آراء مُخْتَلِفَة؛ إلى المكان: كرر…)\nمثال: أنا اختلف معك في الرأي.",
 "掛金": "قِسْط (عَدْل؛ حِصَّة عادلة)\nمثال: سامي بحاجة إلى قسط من الراحة. / زِلاَج, ضَبَّة",
 "掟": "قَانُون, حُقُوق (مقياس كل شيء وطريقه؛ أمر كليّ ينطبق على جميع جزئياته التي تعرف أحكامها منه)\nمثال: ذكرني بالقانون.",
 "掟破り": "غَيْر قَانُونِيٍّ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ. / غَيْر مَأْلُوف (لا يُصادف عادة)\nمثال: مشهد ذو جمال غير عادي",
 "掠う": "إمساك, التقاط (فعل التقاط شيء باليدين)\nمثال: أمسك ميس بالكرة وظهره للوحة / اِحْتَكَرَ",
 "掠める": "سَرَقَ (أخذ ما كان لغيره خفية وبدون علم أحد)\nمثال: من سرق التفاحة؟ / خَدَعَ, غَشَّ (غَشَّ، مَكَرَ؛ خَادَعَ شخصًا: خدعه بشكل مستمر أو بطريقة خفية)\nمثال: هذه خدعة قديمة. / سَحَج (سَحَجَهُ يَسْحَجَ سَحْجًا: خَدَشهُ وقَشَرَهُ؛ فهو مَسحُوجٌ، وسَحِيجٌ) / انتقال خفي, هروب سري (انتقال سري (لتجنب دفع الديون))\nمثال: قاموا بهروب سري ليلي",
 "掠め取る": "إمساك, التقاط (فعل التقاط شيء باليدين)\nمثال: أمسك ميس بالكرة وظهره للوحة",
 "掠め奪う": "سَلَبَ, نَهَبَ ((سَلَبَ) الشيء سلبا: انتزعه قهرا؛ (سَلَبَ) ت فلانة فؤاده أو عقله: استهوته…)\nمثال: لقد سلب مني كل شيء.",
 "掠り": "احتكاك, كشط (فعل الاحتكاك بشيء أثناء المرور) / اعتصار, عصر (فعل الإمساك والضغط بقوة)\nمثال: عصر خدها بمرح",
 "掠り傷": "خَرْبَشَ",
 "掠る": "سَحَج (سَحَجَهُ يَسْحَجَ سَحْجًا: خَدَشهُ وقَشَرَهُ؛ فهو مَسحُوجٌ، وسَحِيجٌ) / مَأْثُرَة",
 "掠れる": "سَحَج (سَحَجَهُ يَسْحَجَ سَحْجًا: خَدَشهُ وقَشَرَهُ؛ فهو مَسحُوجٌ، وسَحِيجٌ)",
 "掠れ傷": "خَرْبَشَ",
 "掠奪": "غَزَاوَة",
 "採る": "تَبَنَّى / مِعْوَل, فَأْس (الفأس الكبيرة العظيمة، تستخدم في الزراعة والصناعة) / مُقْتَطَف / اِفْتَرَضَ",
 "採るべき道": "مسار عمل, نهج (طريقة للعمل أو التصرف)\nمثال: إذا استمررت في هذا المسار فستفشل بالتأكيد",
 "採れたて": "طَازَج, طَازَة",
 "採れ立て": "طَازَج, طَازَة",
 "採光": "إِضَاءَة",
 "採光窓": "فتحة سقف, منور (نافذة في السقف للسماح بدخول ضوء النهار)",
 "採卵鶏": "طَبَقَة",
 "採取": "جني, قطف (فعل قطف (المحاصيل أو الفاكهة أو القفزات، إلخ))\nمثال: أرسل أول قطاف من التوت إلى السوق / استخراج, خلع (عملية إخراج شيء ما (خاصة باستخدام الجهد أو القوة))\nمثال: أعطاها طبيب الأسنان تخديراً موضعياً قبل الخلع",
 "採択": "تَبَنٍّ (تبَنَ الدابة: عَلَفها تبنًا)\nمثال: لم تبن روما في يوم.",
 "採捕": "تجميع, جمع (فعل جمع شيء ما معاً)",
 "採掘": "تعدين",
 "採掘場": "مَقْلَع",
 "採掘者": "عامل منجم (عامل يعمل في منجم)",
 "採決": "تَصْوِيت, اِقْتِرَاع\nمثال: اقرأ بصوت عالي.",
 "採炭": "منجم فحم (منجم يُستخرج منه الفحم من الأرض)",
 "採炭所": "منجم فحم (منجم يُستخرج منه الفحم من الأرض)",
 "採点": "تعليم, وضع علامات (فعل عمل علامة مرئية على سطح)\nمثال: ما كرهه في التدريس هو كل التصحيح الذي كان عليه القيام به",
 "採点官": "علامة, مؤشر (جسم بارز يُستخدم لتمييز أو تحديد شيء ما)\nمثال: كانت العوامات علامات للقناة المائية",
 "採点者": "علامة, مؤشر (جسم بارز يُستخدم لتمييز أو تحديد شيء ما)\nمثال: كانت العوامات علامات للقناة المائية",
 "採用": "اِسْتِعْمَال, اِسْتِخْدَام (اِسْتِعْمَال)\nمثال: أيمكنني استعمال هاتفك؟ / مَوْعِد, مِيعَاد (مَوْعِد الإفطار،أي وقت الإفطار؛ لديه مَوْعِد مع صديق)\nمثال: مناد عنده موعد.",
 "採番": "تَرْقِيم",
 "採石": "تحجير (استخراج حجر البناء أو الأردواز من مقلع سطحي مفتوح)",
 "採石場": "مَقْلَع",
 "採礦": "تعدين",
 "採算": "رِبْح, مَكْسَب (رَبَحَ التَّاجِرُ: نَالَ فَائِدَةً مَالِيَّةً فِي تِجَارَتِهِ؛ رَبَحَ…)\nمثال: ربح زيري المال.",
 "採算がとれる": "دَفَعَ, خَلَّصَ (لزّه ونحاه وأبعده؛ صرفه قبل وروده، أي منعه وأبعده قبل مجيئه أو حدوثه، وعكسه أن…)\nمثال: دفع زيري الثمن.",
 "採算が取れる": "دَفَعَ, خَلَّصَ (لزّه ونحاه وأبعده؛ صرفه قبل وروده، أي منعه وأبعده قبل مجيئه أو حدوثه، وعكسه أن…)\nمثال: دفع زيري الثمن.",
 "採算性": "مَرْدُودِيَّة",
 "採算株": "عَالِي الإِنْتَاجِيَّة (يُنْتِجُ كَمِّيَّة كَبِيرَة مِنَ المُنْتَجَات الزِّرَاعِيَّة أَوِ الصِّنَاعِيَّة)",
 "採納": "تَبَنٍّ (تبَنَ الدابة: عَلَفها تبنًا)\nمثال: لم تبن روما في يوم.",
 "採譜": "كَرْشَنَة, نَقْصَوَة",
 "採金": "منجم ذهب (منجم يُعثر فيه على خام الذهب)",
 "採金地": "حقل ذهب, منجم ذهب (منطقة يتم فيها تعدين الذهب)",
 "採金者": "منقب عن الذهب (عامل منجم يحفر أو يغسل التربة بحثاً عن الذهب في حقل ذهب)",
 "採鉱": "تعدين",
 "採録": "تَسْجِيل",
 "採集": "تجميع, جمع (فعل جمع شيء ما معاً)",
 "採集狩猟民": "صياد وجامع ثمار (عضو في مجتمع يعتمد على الصيد وجمع الثمار)",
 "採食": "بحث عن الطعام (فعل البحث عن الطعام والمؤن)",
 "採餌": "إِطْعَام",
 "探し": "طَلَب, بَحْث (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى…)",
 "探しに": "فِي حَالَةِ اسْتِعْدَاد (في وضع سليم من الجاهزية والترتيب)",
 "探し当てる": "وَجَدَ, لَقِيَ (أَدْرَكَ المطلوب، أَدْرَكَ الشيء الذي أَرَادَهُ وبَحَثَ عنه؛ غَضِبَ عليه…)\nمثال: وجد ياني هاتفه.",
 "探し求める": "بَحَثَ, فَتَّشَ (طَلَب الشيء في التُرَاب؛ طلب الشيء في أي مكان والتَفْتِيش والتَقَصِّي عنه)\nمثال: بدأ زيري البحث.",
 "探す": "بَحَثَ, فَتَّشَ (طَلَب الشيء في التُرَاب؛ طلب الشيء في أي مكان والتَفْتِيش والتَقَصِّي عنه)\nمثال: بدأ زيري البحث. / طَلَب, بَحْث (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى…)\nمثال: طلب زيري ورودا.",
 "探り": "ذُو صَوْت, مُصَوِّت (يُصدر صوتاً أو ذو صوت محدد؛ يُستخدم كلاحقة تركيبية)",
 "探りを入れる": "مِسْبَار",
 "探り出す": "يَشُمّ, يَكْتَشِف",
 "探り回る": "إفلات الكرة ((رياضة) إسقاط الكرة)",
 "探る": "اِسْتَكْشَفَ",
