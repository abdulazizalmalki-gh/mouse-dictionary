 "折り畳み式": "قَابِل لِلطَّيّ (يمكن طيّه وتخزينه)",
 "折り畳み機": "مِلَفّ, مُجَلَّد",
 "折り畳む": "اِنْهَار\nمثال: يوشك الجسر على الانهيار.",
 "折り目": "طَوَى / آداب, أخلاق (السلوك الاجتماعي)\nمثال: أخلاقه أخلاق خنازير",
