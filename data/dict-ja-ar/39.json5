 "扁青石": "لَازَوَرْد",
 "扇": "مِرْوَحَة, مروحة / مِرْوَحَة, هَوَّايَة / مُشَجِّع, مُشَجِّعَة",
 "扇ぎ立てる": "حَرَّضَ, دَفَعَ (حرّضه على الأمر: حضّه ، شدّد الرّغبة فيه؛ حَرَّضَهُ تَحْرِيضاً: حَثَّه على القِتَالِ وأَحْمَاهُ عَلَيْه)\nمثال: هو حرض على الشغب.",
 "扇ぐ": "مِرْوَحَة, مروحة / مِرْوَحَة, هَوَّايَة / مُشَجِّع, مُشَجِّعَة / حَرَّضَ, حَضَّ (حرّضه على الأمر: حضّه ، شدّد الرّغبة فيه؛ حَرَّضَهُ تَحْرِيضاً: حَثَّه على القِتَالِ وأَحْمَاهُ عَلَيْه)\nمثال: هو حرض على الشغب.",
 "扇動": "تَحْرِيض",
 "扇動家": "زَعِيم الدهماء, دَهْمَاوِيّ",
 "扇動者": "مثير للفتن, محرض (شخص يقوم بالتحريض؛ مثير للقلاقل السياسية)",
 "扇子腹": "إِعْدَام, عُقُوبَة الْإِعْدَام (في القانون: هي عقوبة يحددها القضاء على جريمة كبرى اقترفها المتهم وتؤدي إلى قتل المتهم غالبا بالشنق)\nمثال: محكم عليه بالإعدام.",
 "扇形": "قِطَاع",
 "扇情": "تجريبية, حسية ((فلسفة) المذهب القائل بأن المعرفة تُستمد من التجربة) / حسية ((فلسفة) المذهب الأخلاقي القائل بأن الشعور هو المعيار الوحيد لما هو جيد) / إثارة, تهويل (الاستخدام الصحفي لموضوع يروق للأذواق المبتذلة) / إِثَارَة, صِحَافَة الْإِثَارَة (موضوع مصمم لإثارة وإرضاء الأذواق المبتذلة) / اضطراب, هياج (اضطراب عادة ما يكون احتجاجاً) / إثارة, تهيج (شيء يسبب الاضطراب والإثارة) / إثارة, انتعاش (الشعور بفرح حيوي ومبهج) / إثارة, انفعال (حالة الاستثارة العاطفية والانفعال)\nمثال: تطلع إلى إثارة اليوم",
 "扇情的": "لَافِت, مُثِير لِلانْتِبَاه (يستحوذ على الانتباه ويأسره) / ضجة, مثير (يسبب اهتمامًا شديدًا أو فضولًا أو عاطفة قوية) / حسي (متعلق بـ أو معني بالإحساس)\nمثال: القشرة الحسية / إِيحَائِيّ, مُوحٍ (يميل إلى الإيحاء بشيء غير لائق أو فاحش) / إِيحَائِيّ, تَلْمِيحِيّ (يَمِيلُ إِلَى التَّلْمِيحِ أَوِ الإِيحَاء) / دَالّ, كَاشِف (يشير بوضوح أو يكشف؛ يُستخدَم عادة مع 'على')",
 "扇椰子": "دوم, نخلة تدمر (نخيل مروحي طويل من أفريقيا والهند وماليزيا ينتج خشباً صلباً وعصارة حلوة تعد مصدراً لنبيذ النخيل والسكر؛ وتستخدم الأوراق للتسقيف والنسيج)",
 "扇状地": "مخروط طميي, مروحة رسوبية (رواسب على شكل مروحة حيث يستوي مجرى مائي سريع التدفق)",
 "扇腹": "إِعْدَام, عُقُوبَة الْإِعْدَام (في القانون: هي عقوبة يحددها القضاء على جريمة كبرى اقترفها المتهم وتؤدي إلى قتل المتهم غالبا بالشنق)\nمثال: محكم عليه بالإعدام.",
 "扇芭蕉": "رافينالا, شجرة المسافر (نبات عملاق يشبه الشجرة له جوز صالح للأكل وأعناق أوراق تنتج مشروباً منعشاً من عصارة مائية صافية؛ يشاع أنه مصدر طوارئ للمياه للمسافرين)",
 "扇貝": "محار عملاق (محار كبير يسكن الشعاب المرجانية في جنوب المحيط الهادئ ويزن ما يصل إلى 500 رطل)",
 "扇風機": "مروحة كهربائية (مروحة تعمل بمحرك كهربائي)",
 "扈従": "حُضُور (فعل التواجد (في اجتماع أو حدث إلخ)) / حضور (عدد الأشخاص الموجودين) / حُضُور, مُوَاظَبَة (تواتر وجود الشخص في مكان ما)\nمثال: زاد الحضور بنسبة 50 في المائة",
 "扉": "أَبْوَاب, بَاب / صفحة العنوان (صفحة في كتاب تعرض العنوان والمؤلف والناشر)",
 "扉口": "باب, فتحة الباب (المدخل (الحيز في الجدار) الذي تدخل أو تخرج منه من غرفة أو مبنى؛ الحيز الذي يمكن للباب إغلاقه)\nمثال: أطل برأسه من فتحة الباب",
 "扉絵": "صفحة العنوان المقابلة (رسم توضيحي أمامي يواجه صفحة العنوان في كتاب) / واجهة مزخرفة (واجهة مبنى مزخرفة)",
 "手": "يَد, إيد (عُضْو من أعضاء الجَسَد، من المَنْكِب إلى أطراف الأصابع؛ مَقْبَض) / عَقْرَب / عَامِل (الذي يَعْمَل أو الذي عَمِلَ؛ هو الذي وَلاه السُلْطَان على أمر من أمور الدولة. الجمع عمَال)\nمثال: ليس باليد حيلة. / كف أمامي (الكف الأمامي؛ مناظر لليد البشرية) / مِقْبَض / مُشْكِلَة, مَتاعِب",
 "手々": "يَد, إيد (عُضْو من أعضاء الجَسَد، من المَنْكِب إلى أطراف الأصابع؛ مَقْبَض) / عَقْرَب / عَامِل (الذي يَعْمَل أو الذي عَمِلَ؛ هو الذي وَلاه السُلْطَان على أمر من أمور الدولة. الجمع عمَال)\nمثال: ليس باليد حيلة.",
 "手あかのついた": "بَالٍ",
 "手あかの付いた": "بَالٍ",
 "手あそび": "ألعوبة, لعبة (شيء مصنوع مصمم للعب به) / قِمَار, مُقَامَرَة",
 "手あたりしだい": "بشكل عشوائي, دون تمييز (بطريقة عشوائية) / جزافاً, خبط عشواء (بدون عناية؛ بطريقة مرتجلة وسريعة)\nمثال: كانت المنازل مبعثرة عشوائياً",
 "手あたり次第": "بشكل عشوائي, دون تمييز (بطريقة عشوائية) / جزافاً, خبط عشواء (بدون عناية؛ بطريقة مرتجلة وسريعة)\nمثال: كانت المنازل مبعثرة عشوائياً",
 "手あみ": "تريكو, حياكة (صنع الملابس المحاكة) / تريكو, حياكة (أشغال إبرة يتم إنشاؤها عن طريق تشابك الغزل في سلسلة من الحلقات المتصلة باستخدام إبر مستقيمة بلا عيون أو بواسطة آلة)",
 "手おけ": "دلو, سطل (وعاء أسطواني الشكل مفتوح من الأعلى) / ملء دلو (الكمية المحتواة في دلو)",
 "手おの": "بلطة, فأس صغيرة (فأس صغيرة بمقبض قصير تستخدم بيد واحدة (عادة لقطع الحطب)) / توماهوك, فأس صغيرة (سلاح يتكون من فأس قتال؛ استخدمه هنود أمريكا الشمالية) / قَدُوم (قُدُوْم؛ قَدُوْم)\nمثال: بإمكانك القدوم معي.",
 "手かご": "سلة (حاوية عادة ما تكون منسوجة ولها مقابض)",
 "手かせ": "أَصْفَاد, أَغْلَال / تَقْيِيد, اِقْتِصَار / قَيْد",
 "手がかり": "خيط دليل, قرينة (دليل يساعد على حل مشكلة) / تلميح, دليل (إشارة طفيفة) / مقبض, موطئ يد (ملحق للإمساك به)",
 "手がける": "مِقْبَض / خَلْفِيّ",
 "手がつけられない": "منفلت من عقاله",
 "手がはなせない": "مَشْغُول",
 "手が付けられない": "منفلت من عقاله",
 "手が出る": "لَكْمَة أَمَامِيَّة",
 "手が悪い": "فَقِير / مِسْكِين / فُقَرَاء / عديم الضمير, متجرد من المبادئ (بلا وازع أو مبادئ أخلاقية)\nمثال: السياسيون عديمو الضمير الذين يسعدهم بيع بلادهم من أجل السلطة",
 "手が放せない": "مَشْغُول",
 "手が離せない": "مَشْغُول",
 "手きびしい": "خَشِن, قَاسٍ (كريه بشكل حادّ وصارم) / صارِم, قاسٍ (شَديد القَسْوَة (عَن العُقوبَة أو الحُكْم)) / خَشِن, غَلِيظ (قاسٍ أو وقح أو غير مهذّب) / خَشِن, قَاسٍ (صارم بشكل غير سارّ)",
 "手ぎわ": "مَهَارَة / أَدَاء / مَسْرَحِيَّة",
 "手ぎわよく": "بِفَعَّالِيَّة, بِكَفَاءَة (مع الكفاءة؛ بطريقة فعالة)\nمثال: يعمل بكفاءة",
 "手こぎ": "تَجْدِيف",
 "手こぎボート": "زَوْرَق",
 "手こね": "اِعْتِجَان",
 "手ごたえ": "مُقَاوَمَة / استجابة, رد فعل (عملية جسدية تحدث نتيجة تأثير منبه أو عامل سابق) / استجابة (الطريقة التي يستجيب بها جهاز كهربائي أو ميكانيكي لإشارة دخل أو نطاق من إشارات الدخل) / استجابة (عبارة يتلوها أو يغنيها المصلون بعد آية من الكاهن أو القس) / اسْتِقْبَال, تَلَقِّي (الطريقة التي يتم بها استقبال شخص أو شيء ما)\nمثال: رد فعل سيء للدواء",
 "手ごね": "اِعْتِجَان",
 "手ごろ": "فِي مُتَنَاوَل اليَد, قَرِيب (سهل الوصول إليه وقريب) / صَنَاعِيّ, مَاهِر اليَدَيْن (ماهر في العمل اليدوي) / عَمَلِيّ, مُفِيدٌ وَمُلَائِم (مُفِيدٌ وَمُرِيح) / مُنَاسِب, مُلَائِم",
 "手ごわい": "صَعْب",
 "手さぐり": "أَخْرَق, غَيْرُ كُفْء (يُظهر افتقارًا إلى المهارة أو الكفاءة)",
 "手さげ": "حَقِيبَةُ يَد, مَثْبَنَة",
 "手さげバッグ": "حَقِيبَةُ يَد, مَثْبَنَة",
 "手さばき": "تداول باليد, معالجة (فعل اللمس باليدين (أو الاستخدام الماهر لليدين) أو باستخدام وسائل ميكانيكية) / مناولة (الحمل أو النقل أو التسليم اليدوي (أو الميكانيكي) أو العمل مع شيء ما) / تعامل, معالجة (إدارة شخص ما أو شيء ما)\nمثال: التعامل مع السجناء",
 "手じまい": "تَصْفِية",
 "手すき": "حُرّ, غَيْر مَخْطُوب (لم يُعطِ وعدًا بالزواج؛ غير مرتبط) / غَيْر مَشْغُول, فَارِغ (غَيْر مُنْشَغِل؛ حُرّ ومُتَاح) / خُلُو مِن اَلْعَمَل / رَاحَة, خُلُو مِن اَلْعَمَل",
 "手すさび": "انحراف, تحويل (التحول جانباً (عن مسارك أو انتباهك أو اهتمامك)) / استجمام, ترفيه (نشاط يسلّي أو يمتع أو ينشّط) / تمويه, هجوم تضليلي (هجوم محسوب لجذب دفاع العدو بعيداً عن نقطة الهجوم الرئيسي)\nمثال: تحويل عن الطريق السريع الرئيسي",
 "手すり": "دَرَابْزُون",
 "手すり子": "درابزين, عمود درابزين (واحد من عدد من الدعامات المتقاربة لسور)",
 "手ずから": "بالذات, شخصياً (بالحضور الجسدي المباشر؛ دون وسيط)\nمثال: ذهبت إلى هناك شخصياً",
 "手だて": "طريقة, واسطة (امتلاك القدرة على إنتاج تأثير معين أو تحقيق غاية) / أَدَاة, وَسِيلَة (مصنوعة تُستخدَم وسيلة لإنجاز غاية ما) / ثراء, سعة (رأس مال كبير (ثروة أو دخل))\nمثال: وسيلة للسيطرة",
 "手だれ": "إخضاع, سيادة (فعل السيطرة على شخص ما أو إخضاعه) / إتقان, تمكن (مهارة ومعرفة كبيرة بموضوع أو نشاط ما) / تفوق, سيادة (القدرة على الهيمنة أو الفوز)\nمثال: تمكن جيد من الفرنسية",
 "手っ取り早い": "سَرِيع / سَرِيعٌ / حَيٌّ (ضد المَيِّت، على قيد الحَيَاة؛ جمع حَيَاء) / جَارٍ (له استخدامات متعددة، تتراوح بين وصف المكان والعلاقة بين الناس، وبين وصف فعل الظلم أو الميل عن الطريق الصحيح؛ \"جار\" كلمةٌ مُشْعِبَةُ المعنى، تشيرُ إلى المكانِ، والعلاقة، والظلم) / سَرِيعًا, بِسُرْعَةٍ\nمثال: ينبح كلب في الحي. / أَبْلَه (أَحْمَق؛ غَبِيّ)\nمثال: لا تضحك على الأبله و المعوق.",
 "手つかず": "غَيْر مُتَأَثِّر, غَيْر مُنْقَاد (لم يتأثر أو لم ينقد لتأثير خارجي) / غَيْر مَمْسُوس, كَامِل (لَا يَزَالُ مَمْلُوءًا وَلَمْ يُمَسّ) / جامد المشاعر, غير مبال (غير منفعل عاطفياً) / بكر, غير ملموس (لم يحدث بينه وبين شيء آخر تلامس)\nمثال: بدا دائماً غير متأثر تماماً ورابط الجأش",
 "手つだう": "مُسَاعَدَة, مَعُونَة / مُسَاعِد, مُسَاعِدَة (مُعَاوِن، مُسَانِد، من يقوم بالمُسَاعَدَة؛ بمعنى مُفِيد، يقال هذا عامل مساعد وهذه مادة مساعدة) / سَاعَدَ, عَاوَنَ (عَاوَنَ، أَعَانَ) / مُسَاعَدَة, النَّجْدَة\nمثال: علي مساعدة ماري.",
 "手づかみ": "جَشِع, حَرِيص (شديد الرغبة بشكل مفرط في اكتساب الثروة وغيرها) / إمساك, قبض (فعل الإمساك بشيء بإحكام باليدين) / محاولة الفهم (الفهم بصعوبة)\nمثال: كانت المحاضرة تتجاوز أقصى محاولاته للفهم",
 "手づくね": "حرفة يدوية, شغل يدوي (عمل منتج بالعمل اليدوي)",
 "手づくり": "مشغول يدوياً, يدوي الصنع (مصنوع باليد أو بعملية يدوية)\nمثال: فساتين أطفال دقيقة يدوية الصنع",
 "手づよい": "قَوِيّ (اسم من أسماء الله الحسنى؛ الشَدِيْد ذو الحَوْل) / مَنِيع, مَتِيْن / قَوِيّ, راسِخ (اسم من أسماء الله الحسنى؛ الشَدِيْد ذو الحَوْل) / شَدِيْد, قَوْيّ / شَدِيْد / حَادّ, ثَقِيْل (مَالَ وَانْحَرَفَ عَنِ الطَّرِيقِ؛ تَجَنَّبَ شَيْئًا أَوِ الْاِلْتِزَامَ بِمَسَارٍ مَعَيَّنٍ) / بِقُوَّة\nمثال: كانت صدمة قوية.",
 "手づる": "صِلَة, صُلَة / عَلَاقَة, صِلَة",
 "手とり足とり": "بانتباه (مع اهتمام)\nمثال: استمع بانتباه",
 "手なし": "أَخْرَق اليَدَيْن, ثَقِيل اليَد (يفتقر إلى مهارات الحركة الجسدية وخاصة في استخدام اليدين) / أبتر اليدين, بلا يد (بدون يد أو أيدي)\nمثال: محارب قديم بلا يدين / حَيْض, طَمْث (الحَيْضُ : الدورة التي ينزل فيها الدم من رَحِم المرأة البالغة في أَيَّامٍ معلومةٍ كلَّ شهر؛ أعراض ما قبل الحيض (في ): أعراض تشمل انتفاخ البطن وألم الصدر والصداع والشعور بالتّعب وحدَّة الطبع والتهيّج العصبيّ والاكتئاب…)",
 "手なずける": "أَلِيف / رَوَّضَ, آلَفَ (رَوَّضَ المكانُ: أرَاضَ؛ رَوَّضَ فلانٌ: لَزِمَ الرِّياضَ)\nمثال: إلى أية روضة ذهبت؟",
 "手なべ": "مِقْلَاة (وعاء قلي الطعام) / ينتقد بشدَة",
 "手におえない": "بإفراط, كثيراً جداً (أكثر مما يلزم)\nمثال: إنها تأكل كثيراً جداً",
 "手にかける": "مِقْبَض",
 "手にする": "مَسَكَ, مسك / مِلْك, نَفْس (لغة في المَالِك، وهو الذي يَمْلِكُ؛ السُلْطَان الحَاكِم الذي يملك الأَرْض والبِلاد) / مَلَكَ (لغة في المَالِك، وهو الذي يَمْلِكُ؛ السُلْطَان الحَاكِم الذي يملك الأَرْض والبِلاد)\nمثال: زيري ملك لنفسه.",
 "手にとる": "قَطَفَ (قطفت الدّابّة قِطَافاً: أَبْطَأَتْ، في أمثالهم: (أَقْطَفُ من أرنب)؛ قَطَفَ الزّهرةَ: قطعها، قَطَفَ الثّمرَ: جناه وجمعه)\nمثال: أحب قطف الورود.",
 "手にとるように": "بوضوح (بدون شك أو تساؤل) / بشكل متميز, بوضوح (واضح للعقل؛ بتمييز عقلي واضح) / بشكل مفهوم, بوضوح (بطريقة يمكن فهمها) / بِوُضُوح (بطريقة يسهل إدراكها)\nمثال: كانوا تائهين بوضوح",
 "手に入る": "حَصَلَ (الشيء: حَصَلَ عليه؛ العلم: أخَذَه وحَازَه)\nمثال: متى حصل الحادث؟",
 "手に入れる": "حَصَلَ (الشيء: حَصَلَ عليه؛ العلم: أخَذَه وحَازَه)\nمثال: متى حصل الحادث؟",
 "手に取る": "قَطَفَ (قطفت الدّابّة قِطَافاً: أَبْطَأَتْ، في أمثالهم: (أَقْطَفُ من أرنب)؛ قَطَفَ الزّهرةَ: قطعها، قَطَفَ الثّمرَ: جناه وجمعه)\nمثال: أحب قطف الورود.",
 "手に取るように": "بوضوح (بدون شك أو تساؤل) / بشكل متميز, بوضوح (واضح للعقل؛ بتمييز عقلي واضح) / بشكل مفهوم, بوضوح (بطريقة يمكن فهمها) / بِوُضُوح (بطريقة يسهل إدراكها)\nمثال: كانوا تائهين بوضوح",
 "手に手に": "كُلّ",
 "手に掛ける": "مِقْبَض",
 "手に負えない": "بإفراط, كثيراً جداً (أكثر مما يلزم)\nمثال: إنها تأكل كثيراً جداً",
 "手ぬぐい": "مِنْشَفَة",
 "手ぬるい": "رَخْو, مُرْتَخٍ (يُفَرَّغ بسهولة أو بإفراط) / مُتَرَاخٍ, مُتَسَاهِل (يَفْتَقِر إِلَى الصَّرَامَة أَوِ الدِّقَّة) / رخو, مرتخٍ (يفتقر إلى الحزم أو الشد؛ غير مشدود) / رخو (صوتياً) (يُنطق بعضلات لسان وفك مرتخية نسبيًا) / بَطِيء / أَبْطَأَ, بَطَّأَ",
 "手のうち": "رَاحَة, كَفّ / مَهَارَة / مَقْبِض",
 "手のかかる": "مُتْعِب, مُزْعِج (يُسَبِّب صُعُوبَةً أَوْ إِزْعَاجًا)",
 "手のつけられない": "منفلت من عقاله",
 "手のひら": "رَاحَة, كَفّ",
 "手のひらを返す": "شقلبة خلفية (شقلبة هوائية للخلف) / دائرة قلابة, قلاب (دائرة إلكترونية يمكن أن تتخذ إحدى حالتين مستقرتين) / شبشب بإصبع (صندل بدون ظهر يثبت في القدم بواسطة شريط بين إصبع القدم الكبير والإصبع الثاني) / انقلاب, تراجع (قرار بعكس قرار سابق)",
 "手のひら返し": "انقلاب في الموقف, تحول تام (تغيير كبير في الموقف أو المبدأ أو وجهة النظر) / دوران للخلف (فعل الدوران 180 درجة، خاصة في التشكيل العسكري)\nمثال: تحول تام في السياسة الخارجية",
 "手の付けられない": "منفلت من عقاله",
 "手の内": "رَاحَة, كَفّ / مَهَارَة / مَقْبِض",
 "手の平": "رَاحَة, كَفّ",
 "手の平を返す": "شقلبة خلفية (شقلبة هوائية للخلف) / دائرة قلابة, قلاب (دائرة إلكترونية يمكن أن تتخذ إحدى حالتين مستقرتين) / شبشب بإصبع (صندل بدون ظهر يثبت في القدم بواسطة شريط بين إصبع القدم الكبير والإصبع الثاني) / انقلاب, تراجع (قرار بعكس قرار سابق)",
 "手の平返し": "انقلاب في الموقف, تحول تام (تغيير كبير في الموقف أو المبدأ أو وجهة النظر) / دوران للخلف (فعل الدوران 180 درجة، خاصة في التشكيل العسكري)\nمثال: تحول تام في السياسة الخارجية",
 "手の指": "إِصْبَع (عضو مستطيل ينشعِب من طرف الكفّ أو القدم) / بَنَان (أَطْرَافُ الأَصَابِعِ) / صَبَّعَ ((صَبَعَ) به، وصَبَعَ عليه يَصْبَعُ صَبْعًا: أشار نحوه بِإِصبَعِهِ سخريةً؛ (صَبَعَ) في الشيءِ: أَدخل إصبَعَه فيه)\nمثال: كان أول ما لفت انتباهه هي بصمة الإصبع على الزجاج.",
 "手の掛かる": "مُتْعِب, مُزْعِج (يُسَبِّب صُعُوبَةً أَوْ إِزْعَاجًا)",
 "手の早い": "عميق / بِسُرْعَة, عَاجِلًا / صَامَ ((لَازِمٌ) اِمْتَنَعَ عن الطَّعَام والشَّرَاب؛ (مُتَعدٍّ بِعَنْ) امتنع عنه)\nمثال: صام ياني رمضان.",
 "手の腹": "رَاحَة, كَفّ",
 "手の込んだ": "دَقِيق, مُتْقَن (ذُو عَنَاصِرَ كَثِيرَة مُرَتَّبَة بِشَكْل مُعَقَّد؛ مُفَصَّل)",
 "手はず": "تَرْتِيب (تنظيم الأشياء أو الأحداث في تسلسل معين أو وضعها في نظام؛ إعداد أو تجهيز شيء لتحقيق غاية معينة)\nمثال: أعاد زيري ترتيب المطبخ كلية.",
 "手ばしこい": "سَرِيع / سَرِيعٌ / حَيٌّ (ضد المَيِّت، على قيد الحَيَاة؛ جمع حَيَاء) / جَارٍ (له استخدامات متعددة، تتراوح بين وصف المكان والعلاقة بين الناس، وبين وصف فعل الظلم أو الميل عن الطريق الصحيح؛ \"جار\" كلمةٌ مُشْعِبَةُ المعنى، تشيرُ إلى المكانِ، والعلاقة، والظلم) / سَرِيعًا, بِسُرْعَةٍ\nمثال: ينبح كلب في الحي.",
 "手ばなす": "أَطْلَقَ سَرَاح, حَرَّرَ / رَحِمَ (رَحِم: عضو تناسلي أنثوي داخلي مستجيب للهرمون الأنثوي في الجهاز التناسلي لدى البشر ومعظم الثدييات الأخرى؛ الجمع: أرحام)\nمثال: رحمة الله عليه.",
 "手ばやい": "خَفِيف الحَرَكَة, رَشِيق (يتحرّك بسرعة وخفّة) / رَشِيق الذِّهْن, سَرِيعُ الْبَدِيهَة (سريع الفهم والاستيعاب ذهنيًّا)",
 "手ひどい": "جَسِيم, خَطِير (يُثير الخوف أو القلق بتهديده بأذى عظيم) / حَادّ, وَخِيم (سيء جداً في درجته أو مداه) / إسْبَرْطِيّ, شَدِيد (لا يرحم ولا يتهاون في الانضباط أو الحكم) / فَظِيع, وَخِيم (بَالِغُ السُّوءِ أَوِ الفَظَاعَةِ فِي الدَّرَجَةِ أَوِ النَّوْع)",
 "手びねり": "حرفة يدوية, شغل يدوي (عمل منتج بالعمل اليدوي)",
 "手ふき": "مِنْشَفَة",
 "手ぶくろ": "قُفَّاز, كَفّ",
 "手ぶら": "فَارِغ اليَدَيْن (لَا يَحْمِلُ شَيْئًا فِي يَدَيْه) / خَالِي الوِفَاض, صِفْر اليَدَيْن (لم يكتسب أو يحصل على شيء)",
 "手ぶり": "لَفْتَة, إِشَارَة",
 "手ほどき": "إطلاق, استحثاث (فعل يحرك سلسلة من الأحداث) / إنشاء, ابتداء (فعل بدء شيء ما لأول مرة؛ تقديم شيء جديد) / اطلاع, دراية (الحكمة كما تتضح من امتلاك المعرفة) / انضمام, تعيين (الدخول الرسمي في منظمة أو منصب أو وظيفة)\nمثال: تطلعت إلى بدايتها كشخص بالغ",
 "手まね": "لَفْتَة, إِشَارَة",
 "手まめ": "مُجْتَهِد (مشتق من إجتهد)\nمثال: لعل المجتهد ينجح.",
 "手まん": "تلمس, لمس بالأصابع (لمس شيء ما بالأصابع) / ترقيم الأصابع (وضع الأصابع لعزف نغمات مختلفة على آلة موسيقية)",
 "手みやげ": "حَالِيّ, حَاضِر / مَوْجُود, حَاضِر (الذي له وجود) / الزَّمَان, الْحَال / قَدَّمَ, طَرَحَ (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى الرُّسْغَ؛ أنّ لهم سابقةً وفضلاً له عند فلان قَدَمٌ : معروف)\nمثال: أنا موجود لوحدي",
 "手もと": "بالقرب, في مكان قريب (ليس بعيداً بالمصطلحات النسبية) / قَرِيب, مُجَاوِر (على مقربة؛ في متناول اليد)\nمثال: هي تعمل في مكان قريب / مَهَارَة / مَصْرُوف جَيْب, مَصْرُوف / مَقْبِض",
 "手もなく": "بِسُهُولَة",
 "手も無く": "بِسُهُولَة",
 "手わざ": "حرفة يدوية, شغل يدوي (عمل منتج بالعمل اليدوي)",
 "手をあげる": "اِسْتَسْلَمَ / اِسْتَسْلَام / حَسَّنَ (جَمِيل؛ مُبْهِج) / تَحَسَّنَ\nمثال: إيمي فتاة حسنة. / مُتَطَوِّع, مُتَطَوِّعَة / مُتَطَوِّع",
 "手をかける": "لَمَسَ (اتصل بشيء أو شخص بشكل مباشر بواسطة جزء من الجسم مثل اليد، التواصل الحسي أو المعنوي مع شيء ما؛ يدل على التواصل، سواء كان ماديًا أو معنويًا، مع شيء ما) / لَمْسَة, مُلَامَسَة / لَمْس (اتصل بشيء أو شخص بشكل مباشر بواسطة جزء من الجسم مثل اليد، التواصل الحسي أو المعنوي مع شيء ما؛ يدل على التواصل، سواء كان ماديًا أو معنويًا، مع شيء ما)\nمثال: إياك ولمس شطيرتي! / اِهْتَمَّ, اِعْتَنَى / سَرَقَ (أخذ ما كان لغيره خفية وبدون علم أحد) / اِسْتَرَقَ\nمثال: من سرق التفاحة؟",
 "手をくむ": "تَعَاوَنَ / تَعاوَنُ مَعَ العَدُوّ",
 "手をたずさえて": "مَعًا, سَوِيًّا",
 "手をたたく": "تَصْفِيق / صَفَّق / صَفَّقَ",
 "手をつける": "غَلَّ, اِخْتَلَسَ",
 "手をのべる": "مد يد العون (جذب ومطل حتى يصبح أطول او اوسع؛ بسط ووسع)\nمثال: مد سامي يده لليلى.",
 "手をやる": "لَمَسَ (اتصل بشيء أو شخص بشكل مباشر بواسطة جزء من الجسم مثل اليد، التواصل الحسي أو المعنوي مع شيء ما؛ يدل على التواصل، سواء كان ماديًا أو معنويًا، مع شيء ما) / لَمْسَة, مُلَامَسَة / لَمْس (اتصل بشيء أو شخص بشكل مباشر بواسطة جزء من الجسم مثل اليد، التواصل الحسي أو المعنوي مع شيء ما؛ يدل على التواصل، سواء كان ماديًا أو معنويًا، مع شيء ما)\nمثال: إياك ولمس شطيرتي!",
 "手を上げる": "اِسْتَسْلَمَ / اِسْتَسْلَام / حَسَّنَ (جَمِيل؛ مُبْهِج) / تَحَسَّنَ\nمثال: إيمي فتاة حسنة. / مُتَطَوِّع, مُتَطَوِّعَة / مُتَطَوِّع",
 "手を付ける": "غَلَّ, اِخْتَلَسَ",
 "手を休める": "رَاحَة, اِسْتِرَاحَة / اِسْتَرَاحَ (اِرْتَاح؛ طلب الرَاحَة) / بَاقِيَّة / أَثَارَة\nمثال: عليك أخذ استراحة.",
 "手を伸ばす": "بَلَغَ",
 "手を伸べる": "مد يد العون (جذب ومطل حتى يصبح أطول او اوسع؛ بسط ووسع)\nمثال: مد سامي يده لليلى.",
 "手を入れる": "صَحِيح, صَوَاب / صَحَّحَ (جعل الشيء صحيحًا أو خاليًا من الأخطاء؛ أظهر صحة معلومة أو حقيقة)\nمثال: صحح نطقي من فضلك.",
 "手を出す": "أَخَذَ (تَنَاوَلَ الشيء بيده، تملكه أو تحكم فيه، بالقوة أو بدونها؛ أمْسَكَ بِالشيء. (يتعدى بالباء)) / أَخَذَ بِـ (تَنَاوَلَ الشيء بيده، تملكه أو تحكم فيه، بالقوة أو بدونها؛ أمْسَكَ بِالشيء. (يتعدى بالباء)) / اِتَّخَذَ / اِسْتَغْرَقَ / اِلْتَقَطَ\nمثال: أخذ الولد يبكي.",
 "手を加える": "تنقيح, مراجعة (فعل إعادة كتابة شيء ما)",
 "手を取り合う": "تَعَاوَنَ",
 "手を叩く": "تَصْفِيق / صَفَّق / صَفَّقَ",
 "手を変え品を変え": "بأي طريقة كانت, بأي وسيلة (بأي طريقة ضرورية؛ بأي وسيلة ممكنة)\nمثال: سأجتاز هذا المقرر بأي وسيلة",
 "手を差し伸べる": "مد يد العون (جذب ومطل حتى يصبح أطول او اوسع؛ بسط ووسع)\nمثال: مد سامي يده لليلى.",
 "手を延べる": "مد يد العون (جذب ومطل حتى يصبح أطول او اوسع؛ بسط ووسع)\nمثال: مد سامي يده لليلى.",
 "手を打つ": "تَصْفِيق / صَفَّق / صَفَّقَ",
 "手を挙げる": "اِسْتَسْلَمَ / اِسْتَسْلَام / حَسَّنَ (جَمِيل؛ مُبْهِج) / تَحَسَّنَ\nمثال: إيمي فتاة حسنة. / مُتَطَوِّع, مُتَطَوِّعَة / مُتَطَوِّع",
 "手を掛ける": "لَمَسَ (اتصل بشيء أو شخص بشكل مباشر بواسطة جزء من الجسم مثل اليد، التواصل الحسي أو المعنوي مع شيء ما؛ يدل على التواصل، سواء كان ماديًا أو معنويًا، مع شيء ما) / لَمْسَة, مُلَامَسَة / لَمْس (اتصل بشيء أو شخص بشكل مباشر بواسطة جزء من الجسم مثل اليد، التواصل الحسي أو المعنوي مع شيء ما؛ يدل على التواصل، سواء كان ماديًا أو معنويًا، مع شيء ما)\nمثال: إياك ولمس شطيرتي! / اِهْتَمَّ, اِعْتَنَى / سَرَقَ (أخذ ما كان لغيره خفية وبدون علم أحد) / اِسْتَرَقَ\nمثال: من سرق التفاحة؟",
 "手を携えて": "مَعًا, سَوِيًّا",
 "手を替え品を替え": "بأي طريقة كانت, بأي وسيلة (بأي طريقة ضرورية؛ بأي وسيلة ممكنة)\nمثال: سأجتاز هذا المقرر بأي وسيلة",
 "手を染める": "بَدَأَ, اِبْتَدَأَ (حَدَثَ ونَشَأَ وحَصَلَ؛ أَخَذَ، شَرَعَ)\nمثال: بدأ سامي يتكلم.",
 "手を焼かせる": "أزْعَجَ / يَزْعَجْ, يُضَايِقْ",
 "手を着ける": "غَلَّ, اِخْتَلَسَ",
 "手を組む": "تَعَاوَنَ / تَعاوَنُ مَعَ العَدُوّ",
 "手を貸す": "مد يد العون (جذب ومطل حتى يصبح أطول او اوسع؛ بسط ووسع)\nمثال: مد سامي يده لليلى.",
 "手を通す": "لَبِسَ, اِرْتَدَى (خَلَطَ بحيث يصعب التمييز والفصل؛ الأمر: خلطه فاشتبه واضطرب)\nمثال: لبس سروالا نظيفا.",
 "手コキ": "استمناء, جلك (مصطلحات عامية للاستمناء)",
 "手マン": "تلمس, لمس بالأصابع (لمس شيء ما بالأصابع) / ترقيم الأصابع (وضع الأصابع لعزف نغمات مختلفة على آلة موسيقية)",
 "手上げ": "جَمِيع أَنْحَاء, كُلّ",
 "手下": "تابعة, فرعية ((عن الجملة النحوية) غير قادرة على الوقوف وحدها نحوياً كجملة تامة) / تابع, مرؤوس (أدنى في الرتبة أو الأهمية) / تابع, خاضع (خاضع أو مستسلم للسلطة أو لسيطرة شخص آخر) / اسم مندرج, لفظ أخص (كلمة أكثر تحديداً وخصوصية من كلمة أخرى)\nمثال: الجملة التابعة (أو الفرعية) تعمل كاسم أو صفة أو ظرف داخل الجملة",
 "手不足": "اخْتِزَالِيّ, مُخْتَزَل (مكتوب بشكل مختصر أو رمزيّ) / اختزال, كتابة مختزلة (طريقة للكتابة بسرعة باستخدام نظام رمزي مختصر)",
 "手並": "مَهَارَة",
 "手並み": "مَهَارَة",
 "手中にする": "إِسْتَوْلَى عَلَى",
 "手事": "حيلة, خديعة (استخدام الحيل لخداع شخص ما (عادة لانتزاع المال منه))",
 "手交": "تسليم, تمرير (عملية تمرير شيء ما لشخص آخر)",
 "手仕事": "حرفة يدوية, شغل يدوي (عمل منتج بالعمل اليدوي)",
 "手仕舞": "تَصْفِية",
 "手仕舞い": "تَصْفِية",
 "手付": "وَدِيعَة / أَوْدَعَ (الثَوْب أو ما أشبه: صانه بأن وضعه في صِوَان أو مكان لا يؤْذَى فيه؛ فلانًا مالًا: دفعه إليه ليكون عنده وديعة. ويكون أيضا بمعنى قبل الوديعة)\nمثال: غادرت المنزل دون أن أودع أهلي.",
 "手付かず": "غَيْر مُتَأَثِّر, غَيْر مُنْقَاد (لم يتأثر أو لم ينقد لتأثير خارجي) / غَيْر مَمْسُوس, كَامِل (لَا يَزَالُ مَمْلُوءًا وَلَمْ يُمَسّ) / جامد المشاعر, غير مبال (غير منفعل عاطفياً) / بكر, غير ملموس (لم يحدث بينه وبين شيء آخر تلامس)\nمثال: بدا دائماً غير متأثر تماماً ورابط الجأش",
 "手付け": "وَدِيعَة / أَوْدَعَ (الثَوْب أو ما أشبه: صانه بأن وضعه في صِوَان أو مكان لا يؤْذَى فيه؛ فلانًا مالًا: دفعه إليه ليكون عنده وديعة. ويكون أيضا بمعنى قبل الوديعة)\nمثال: غادرت المنزل دون أن أودع أهلي.",
 "手付け金": "وَدِيعَة / أَوْدَعَ (الثَوْب أو ما أشبه: صانه بأن وضعه في صِوَان أو مكان لا يؤْذَى فيه؛ فلانًا مالًا: دفعه إليه ليكون عنده وديعة. ويكون أيضا بمعنى قبل الوديعة)\nمثال: غادرت المنزل دون أن أودع أهلي.",
 "手付金": "وَدِيعَة / أَوْدَعَ (الثَوْب أو ما أشبه: صانه بأن وضعه في صِوَان أو مكان لا يؤْذَى فيه؛ فلانًا مالًا: دفعه إليه ليكون عنده وديعة. ويكون أيضا بمعنى قبل الوديعة)\nمثال: غادرت المنزل دون أن أودع أهلي.",
 "手代": "بَائِع, بَائِعَة",
 "手代木": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "手伝い": "مُسَاعِد, مُسَاعِدَة (مُعَاوِن، مُسَانِد، من يقوم بالمُسَاعَدَة؛ بمعنى مُفِيد، يقال هذا عامل مساعد وهذه مادة مساعدة)\nمثال: علي مساعدة ماري. / مُسَاعَدَة, مَعُونَة / مُسَاعِد, مُسَاعِدَة (مُعَاوِن، مُسَانِد، من يقوم بالمُسَاعَدَة؛ بمعنى مُفِيد، يقال هذا عامل مساعد وهذه مادة مساعدة) / سَاعَدَ, عَاوَنَ (عَاوَنَ، أَعَانَ) / مُسَاعَدَة, النَّجْدَة\nمثال: علي مساعدة ماري.",
 "手伝い手": "مُسَاعِد, مُسَاعِدَة (مُعَاوِن، مُسَانِد، من يقوم بالمُسَاعَدَة؛ بمعنى مُفِيد، يقال هذا عامل مساعد وهذه مادة مساعدة)\nمثال: علي مساعدة ماري.",
 "手伝う": "مُسَاعَدَة, مَعُونَة / مُسَاعِد, مُسَاعِدَة (مُعَاوِن، مُسَانِد، من يقوم بالمُسَاعَدَة؛ بمعنى مُفِيد، يقال هذا عامل مساعد وهذه مادة مساعدة) / سَاعَدَ, عَاوَنَ (عَاوَنَ، أَعَانَ) / مُسَاعَدَة, النَّجْدَة\nمثال: علي مساعدة ماري.",
 "手作り": "مشغول يدوياً, يدوي الصنع (مصنوع باليد أو بعملية يدوية)\nمثال: فساتين أطفال دقيقة يدوية الصنع",
 "手作り品": "حِرْفَة يَدَوِيَّة",
 "手作業": "عمل يدوي (العمل المنجز بالأيدي)",
 "手信号": "إشارة العلم, الإشارة بالأعلام (أي من الطرق المتنوعة لاستخدام الأعلام أو الرايات لإرسال الإشارات)\nمثال: سمحت إشارات العلم بالاتصال عن بعد قبل اختراع الراديو وما زالت تستخدم خاصة فيما يتعلق بالسفن",
 "手信語": "إشارة العلم, الإشارة بالأعلام (أي من الطرق المتنوعة لاستخدام الأعلام أو الرايات لإرسال الإشارات)\nمثال: سمحت إشارات العلم بالاتصال عن بعد قبل اختراع الراديو وما زالت تستخدم خاصة فيما يتعلق بالسفن",
 "手傷": "جُرْح, جِرَاحَة (كَلَمَ، شَقَّ اللَحْم وأسَالَ الدَمّ؛ صَادَ أو اكْتَسَبَ) / جَرَحَ (كَلَمَ، شَقَّ اللَحْم وأسَالَ الدَمّ؛ صَادَ أو اكْتَسَبَ)\nمثال: ذلك سيهيج الجرح.",
 "手元": "بالقرب, في مكان قريب (ليس بعيداً بالمصطلحات النسبية) / قَرِيب, مُجَاوِر (على مقربة؛ في متناول اليد)\nمثال: هي تعمل في مكان قريب / مَهَارَة / مَصْرُوف جَيْب, مَصْرُوف / مَقْبِض",
 "手元に届く": "وَصَلَ (ضَمَّ وَلَأَمَ. (مصدره وَصْل وصِلَة)؛ بَلَغَ الشيءَ، أَدْرَكَه. (يتعدى بإلى) (مصدره وُصُول))\nمثال: وصل السيد باكر.",
 "手元金": "سيولة فورية, نقد جاهز (المال في شكل نقد متاح بسهولة)\nمثال: كانت زوجته دائماً مصدراً جيداً للنقد الجاهز",
 "手先": "إِصْبَع (عضو مستطيل ينشعِب من طرف الكفّ أو القدم) / بَنَان (أَطْرَافُ الأَصَابِعِ) / صَبَّعَ ((صَبَعَ) به، وصَبَعَ عليه يَصْبَعُ صَبْعًا: أشار نحوه بِإِصبَعِهِ سخريةً؛ (صَبَعَ) في الشيءِ: أَدخل إصبَعَه فيه)\nمثال: كان أول ما لفت انتباهه هي بصمة الإصبع على الزجاج. / تابع, مرؤوس (مساعد خاضع لسلطة أو سيطرة آخر)",
 "手入らず": "غَيْر مُتَأَثِّر, غَيْر مُنْقَاد (لم يتأثر أو لم ينقد لتأثير خارجي) / غَيْر مَمْسُوس, كَامِل (لَا يَزَالُ مَمْلُوءًا وَلَمْ يُمَسّ) / جامد المشاعر, غير مبال (غير منفعل عاطفياً) / بكر, غير ملموس (لم يحدث بينه وبين شيء آخر تلامس)\nمثال: بدا دائماً غير متأثر تماماً ورابط الجأش",
 "手入れ": "اِهْتِمَام / عِنَايَة, رِعَايَة / اِهْتَمَّ بِـ / مُدَاهَمَة / غَارَة, غَزْوَة / أَغَارَ, اِقْتَحَمَ / أَغَارَ",
 "手八丁": "بَلَاغَة, فَصَاحَة (مطابَقةُ الكلام لمقتضى الحال أو حُسْن البَيَانِ وقوَّةُ التأثير؛ قُدرة المتكلِّم على البيان والتأثير)",
 "手冊": "دَفْتَر, مُذَكِّرَة / كَمْبْيُوتَر مَحْمُول, حَاسُوب مَحْمُول",
 "手出し": "تدخل, تلاعب (فعل تغيير شيء ما سراً أو بشكل غير لائق) / فُضُولِيّ, مُتَدَخِّل (يتدخل في شؤون الآخرين بطريقة مزعجة)",
 "手切れ金": "مُسْتَعْمَرَة, مُسْتَوْطَنَة",
 "手利き": "مَهَارَة",
 "手前": "أماماً, في المقدمة (في أو في المقدمة)\nمثال: أرى أضواء مدينة أمامنا / بعض الشيء, قليلاً (بدرجة صغيرة؛ نوعاً ما)\nمثال: الجو دافئ قليلاً / وَجْه, مُحَيًّا (الإِنْسَان: هو مقدم رأسه الذي يُوَجِهَهُ إلى الناس؛ ضد الظَهْر، ما يقع في المقدمة أو ما يوَجَه إلى الناس) / مَظْهَر (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / وَاجَهَ (تَقَابَلَ معه وَجها لوجه؛ الجندي العدو: استقبله مواجهة ليقاتله أو يناضل ضده)\nمثال: تبدو شاحب الوجه. / مَهَارَة / مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة! / أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى.",
 "手前ども": "نحن (ضَمِيرُ رَفْعٍ مُنْفَصِلٌ لِلْمُثَنَّى وَالْجَمْعِ ( مُذَكَّراً وَمُؤَنَّثاً )؛ ضَمِيرُ رَفْعٍ مُنْفَصِلٌ لِلْمُتَكَلِّمِ فِي حَالَةِ التَّعْظِيمِ)\nمثال: نحن مهتمون جدا.",
 "手前共": "نحن (ضَمِيرُ رَفْعٍ مُنْفَصِلٌ لِلْمُثَنَّى وَالْجَمْعِ ( مُذَكَّراً وَمُؤَنَّثاً )؛ ضَمِيرُ رَفْعٍ مُنْفَصِلٌ لِلْمُتَكَلِّمِ فِي حَالَةِ التَّعْظِيمِ)\nمثال: نحن مهتمون جدا.",
 "手前勝手": "أناني, متمركز حول الذات (يهتم بشكل رئيسي أو حصري بنفسه ومصلحته مع استبعاد الآخرين)\nمثال: رجال أنانيون كانوا يحاولون تحقيق مكاسب لأنفسهم من قضية الحقوق المدنية المقدسة",
 "手前定規": "أناني, متمركز حول الذات (يهتم بشكل رئيسي أو حصري بنفسه ومصلحته مع استبعاد الآخرين)\nمثال: رجال أنانيون كانوا يحاولون تحقيق مكاسب لأنفسهم من قضية الحقوق المدنية المقدسة",
 "手加減": "براعة, مهارة خاصة (طريقة خاصة أو مهارة فطرية للقيام بشيء ما)\nمثال: كان لديه ميل لذلك",
 "手助け": "مُسَاعَدَة, مَعُونَة / مُسَاعِد, مُسَاعِدَة (مُعَاوِن، مُسَانِد، من يقوم بالمُسَاعَدَة؛ بمعنى مُفِيد، يقال هذا عامل مساعد وهذه مادة مساعدة) / سَاعَدَ, عَاوَنَ (عَاوَنَ، أَعَانَ) / مُسَاعَدَة, النَّجْدَة\nمثال: علي مساعدة ماري.",
 "手動": "كُتَيِّب, كُتَيِّب التَّشْغِيل (كِتَاب صَغِير؛ دَلِيل) / يَدَوِيّ",
 "手動による": "كُتَيِّب, كُتَيِّب التَّشْغِيل (كِتَاب صَغِير؛ دَلِيل) / يَدَوِيّ",
 "手厚い": "دَافِئ / دَفِيء",
 "手厳しい": "خَشِن, قَاسٍ (كريه بشكل حادّ وصارم) / صارِم, قاسٍ (شَديد القَسْوَة (عَن العُقوبَة أو الحُكْم)) / خَشِن, غَلِيظ (قاسٍ أو وقح أو غير مهذّب) / خَشِن, قَاسٍ (صارم بشكل غير سارّ)",
 "手取り": "أرباح, صافي الدخل (فائض الإيرادات عن المصروفات في فترة زمنية معينة (بما في ذلك الإهلاك والمصروفات غير النقدية الأخرى))",
 "手取り足取り": "بانتباه (مع اهتمام)\nمثال: استمع بانتباه",
 "手取り額": "أرباح, صافي الدخل (فائض الإيرادات عن المصروفات في فترة زمنية معينة (بما في ذلك الإهلاك والمصروفات غير النقدية الأخرى))",
 "手口": "روتين, طريقة عمل (طريقة أو إجراء ثابت أو معتاد)",
 "手合": "مُنَافَسَة, مُبَارَاة / مُنَافَسَة, مُسَابَقَة",
 "手合い": "مُنَافَسَة, مُبَارَاة / مُنَافَسَة, مُسَابَقَة",
 "手合い割": "تَكَافُؤ الفُرَص, مِيزَة تَعْوِيضِيَّة (أفضلية تُمنح لمنافس لمساواة فرص الفوز) / عائق, عقبة (شيء غير مادي يتداخل مع أو يؤخر العمل أو التقدم) / إعاقة, عجز (حالة عدم القدرة على الأداء نتيجة لعدم اللياقة البدنية أو العقلية)\nمثال: إعاقة القراءة",
 "手合い割り": "تَكَافُؤ الفُرَص, مِيزَة تَعْوِيضِيَّة (أفضلية تُمنح لمنافس لمساواة فرص الفوز) / عائق, عقبة (شيء غير مادي يتداخل مع أو يؤخر العمل أو التقدم) / إعاقة, عجز (حالة عدم القدرة على الأداء نتيجة لعدم اللياقة البدنية أو العقلية)\nمثال: إعاقة القراءة",
 "手合わせ": "لَعْب, لَعْبَة (فعل شيئا للتسلية والترفيه، شَارَكَ في لعبة) / لَعْب (فعل شيئا للتسلية والترفيه، شَارَكَ في لعبة) / طَرِيدَة\nمثال: لعب زيري التنس.",
 "手合割": "تَكَافُؤ الفُرَص, مِيزَة تَعْوِيضِيَّة (أفضلية تُمنح لمنافس لمساواة فرص الفوز) / عائق, عقبة (شيء غير مادي يتداخل مع أو يؤخر العمل أو التقدم) / إعاقة, عجز (حالة عدم القدرة على الأداء نتيجة لعدم اللياقة البدنية أو العقلية)\nمثال: إعاقة القراءة",
 "手合割り": "تَكَافُؤ الفُرَص, مِيزَة تَعْوِيضِيَّة (أفضلية تُمنح لمنافس لمساواة فرص الفوز) / عائق, عقبة (شيء غير مادي يتداخل مع أو يؤخر العمل أو التقدم) / إعاقة, عجز (حالة عدم القدرة على الأداء نتيجة لعدم اللياقة البدنية أو العقلية)\nمثال: إعاقة القراءة",
 "手向い": "مُقَاوَمَة",
 "手向かい": "مُقَاوَمَة",
 "手向かう": "قَاوَمَ (ظَلَّ يقوم ضد الشيء، استمر في القيام)\nمثال: قاوم حتى النهاية!",
 "手向ける": "اِقْتِرَاح / اِقْتَرَحَ, قَدَّمَ (اِبْتَدَعَ ٱلشَّيْءَ مِنْ ذَاتِ نَفْسِهِ مِنْ غَيْرِ أَنْ يَسْمَعَهُ؛ اِخْتَارَ) / قَدَّمَ (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى الرُّسْغَ؛ أنّ لهم سابقةً وفضلاً له عند فلان قَدَمٌ : معروف)\nمثال: اقترح سامي المساعدة.",
 "手品": "سِحْر (ألقى السحر على شخص أو شيء، بمعنى جعله تحت تأثير السحر؛ أدهش أو أبهر بجمال أو جاذبية غير عادية) / سِحْرِيّ\nمثال: هذا هو سحر الجزائر.",
 "手品師": "سَاحِر",
 "手回し": "تَحْضِير, إِعْدَاد",
 "手回しオルガン": "أُرْغُن يَدَوِيّ ((أَرْغَنَ): أطاع؛ (أَرْغَنَ) إليه: رغن)\nمثال: لا أستطيع أن أعزف الأرغن.",
 "手回り": "أغراض شخصية, متعلقات شخصية (ممتلكات ذات طابع شخصي قابلة للحمل ولا تستخدم في الأعمال التجارية)\nمثال: تركت بعض متعلقاتها الشخصية في المنزل",
 "手回り品": "أغراض شخصية, متعلقات شخصية (ممتلكات ذات طابع شخصي قابلة للحمل ولا تستخدم في الأعمال التجارية)\nمثال: تركت بعض متعلقاتها الشخصية في المنزل",
 "手土産": "حَالِيّ, حَاضِر / مَوْجُود, حَاضِر (الذي له وجود) / الزَّمَان, الْحَال / قَدَّمَ, طَرَحَ (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى الرُّسْغَ؛ أنّ لهم سابقةً وفضلاً له عند فلان قَدَمٌ : معروف)\nمثال: أنا موجود لوحدي",
 "手型千鳥": "أوركيد عطري (أوركيد أوروبي ذو سنابل كثيفة من زهور وردية أو ليلكية أو حمراء عطرة بمهاميز بارزة)",
 "手垢": "أثر إصبع, بصمة إصبع (لطخة يتركها إصبع (متسخ))",
 "手垢のついた": "بَالٍ",
 "手垢の付いた": "بَالٍ",
 "手堅い": "سليم / صَوْت, صوت (أكثر من إحداث الصوت؛ بالغ في إحداث الصوت؛ في : صاح نوحا أو استغاثة) / صَوَّتَ, طَلَّع صوت (أكثر من إحداث الصوت؛ بالغ في إحداث الصوت؛ في : صاح نوحا أو استغاثة)\nمثال: اقرأ بصوت عالي. / ثابت (اسم فاعل من ثَبَتَ؛ المُسْتَقِرّ الذي لا يتحرك، ضد المُتَحَرِّك)\nمثال: الشاحنة غير ثابتة.",
 "手塚": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "手塩": "ملح, ملح الطعام (شكل بلوري أبيض لكلوريد الصوديوم خاصة يستخدم لتتبيل وحفظ الطعام)",
 "手妻": "خفة اليد (براعة يدوية في تنفيذ الحيل)",
 "手始め": "استهلال, انطلاق (الوقت الذي يفترض أن يبدأ فيه شيء ما)\nمثال: بدأوا بداية مبكرة",
 "手始めに": "أول الأمر, في البداية (في البدء)\nمثال: في البداية لم يلاحظ أي شيء غريب",
 "手島": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "手嶋": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "手工": "حِرْفَة يَدَوِيَّة",
 "手工業者": "صَانِع (كل من يَصْنَعُ شيئا؛ من يَمْتَهِنُ الصِّنَاعَة) / حِرَفِيّ / حِرْفِيّ\nمثال: أحب أن أكون صانع محتوى.",
 "手工芸": "حِرْفَة يَدَوِيَّة",
 "手巾": "مِنْشَفَة / مِنْدِيل, مَحْرَمَة",
 "手帖": "دَفْتَر, مُذَكِّرَة / كَمْبْيُوتَر مَحْمُول, حَاسُوب مَحْمُول / شَهَادَة",
 "手帳": "دَفْتَر, مُذَكِّرَة / كَمْبْيُوتَر مَحْمُول, حَاسُوب مَحْمُول / شَهَادَة",
 "手広い": "وَاسِع, رَحْب (واسِع: (اسم)؛ واسع: (اسم))\nمثال: أرض الله واسعة. / شَامِل, وَاسِعُ النِّطَاق (واسع في نطاقه أو محتواه؛ يغطّي مجالات عديدة) / مُمْتَدّ, وَاسِع النِّطَاق (كبير في الامتداد المكاني أو النطاق أو الكمية) / توسعي, واسع النطاق (للزراعة؛ زيادة الإنتاجية باستخدام مناطق واسعة بحد أدنى من النفقات والعمالة)\nمثال: إنتاج القمح في ظل ظروف واسعة النطاق",
 "手広く": "بعيداً, على نطاق واسع (إلى أو على مدى أو نطاق كبير؛ بعيداً) / بتباعد (بحيث تترك مساحة كبيرة أو مسافة بين الأشياء)\nمثال: تجول بعيداً عبر العديد من الأراضي",
 "手底": "رَاحَة, كَفّ",
 "手引": "إِرْشَاد, هِدَايَة / هِدَايَة, إِرْشَاد / مُقَدَّمَة / تَعْرِيف (الإعلام؛ الشيء أو الكلمة: التوضيح بالمعنى بصورة مختصرة ليعرف الناس ما هي) / مُقَدَّمَة, مَدْخَل\nمثال: هل لديه بطاقة شخصية (هوية شخصية - بطاقة تعريف) / مُرْشِد, مُرْشِد سِيَاحِيّ (المُرْشِد : من يقوم بدور التَّوجيه والإرشاد؛ من يُساعد السُّفن بتعليماته لاجتياز القنوات أو للإرساء في المرافئ) / دَلِيل / دَلَّ, هَدَى (مَعِدَة، بَطْن؛ قَلْب)\nمثال: كيف استطيع الحصول على مرشد سياحي.",
 "手引き": "إِرْشَاد, هِدَايَة / هِدَايَة, إِرْشَاد / مُقَدَّمَة / تَعْرِيف (الإعلام؛ الشيء أو الكلمة: التوضيح بالمعنى بصورة مختصرة ليعرف الناس ما هي) / مُقَدَّمَة, مَدْخَل\nمثال: هل لديه بطاقة شخصية (هوية شخصية - بطاقة تعريف) / مُرْشِد, مُرْشِد سِيَاحِيّ (المُرْشِد : من يقوم بدور التَّوجيه والإرشاد؛ من يُساعد السُّفن بتعليماته لاجتياز القنوات أو للإرساء في المرافئ) / دَلِيل / دَلَّ, هَدَى (مَعِدَة، بَطْن؛ قَلْب)\nمثال: كيف استطيع الحصول على مرشد سياحي.",
 "手引き書": "دَلِيل, كُتَيِّب",
 "手引書": "دَلِيل, كُتَيِّب",
 "手弱女": "دَاعِرَة, بَغِيَّة / دَعِرَ, بَغَى (دَعِرَ الْعود دعرا دخن وَلم يتقد)",
 "手強い": "صَعْب / قَوِيّ (اسم من أسماء الله الحسنى؛ الشَدِيْد ذو الحَوْل) / مَنِيع, مَتِيْن / قَوِيّ, راسِخ (اسم من أسماء الله الحسنى؛ الشَدِيْد ذو الحَوْل) / شَدِيْد, قَوْيّ / شَدِيْد / حَادّ, ثَقِيْل (مَالَ وَانْحَرَفَ عَنِ الطَّرِيقِ؛ تَجَنَّبَ شَيْئًا أَوِ الْاِلْتِزَامَ بِمَسَارٍ مَعَيَّنٍ) / بِقُوَّة\nمثال: كانت صدمة قوية.",
 "手当": "رَاتِب, أَجْر / رعاية طبية, عناية طبية (علاج احترافي للمرض أو الإصابة)",
 "手当たりしだい": "بشكل عشوائي, دون تمييز (بطريقة عشوائية) / جزافاً, خبط عشواء (بدون عناية؛ بطريقة مرتجلة وسريعة)\nمثال: كانت المنازل مبعثرة عشوائياً",
 "手当たり次第": "بشكل عشوائي, دون تمييز (بطريقة عشوائية) / جزافاً, خبط عشواء (بدون عناية؛ بطريقة مرتجلة وسريعة)\nمثال: كانت المنازل مبعثرة عشوائياً",
 "手当て": "رَاتِب, أَجْر / رعاية طبية, عناية طبية (علاج احترافي للمرض أو الإصابة)",
 "手当りしだい": "بشكل عشوائي, دون تمييز (بطريقة عشوائية) / جزافاً, خبط عشواء (بدون عناية؛ بطريقة مرتجلة وسريعة)\nمثال: كانت المنازل مبعثرة عشوائياً",
 "手当り次第": "بشكل عشوائي, دون تمييز (بطريقة عشوائية) / جزافاً, خبط عشواء (بدون عناية؛ بطريقة مرتجلة وسريعة)\nمثال: كانت المنازل مبعثرة عشوائياً",
 "手形": "مُسْوَدَّة / تَجْنِيد / سَوَّدَ / جَنَّدَ (جَنَّدَ الجنودَ: جَمَعَهَا؛ جَنَّدَ فلانًا: صيَّره جنديّاً) / أَذِنَ, سَمَحَ (أَذَن؛ أَذَنَ: ( فعل ) أَذَنَ أَذْناً) / رُخْصَة / رُخُصَة\nمثال: من أذن لتوم باستعارة سيارتي?",
 "手形交換所": "غرفة المقاصة (مكان مركزي للتجميع حيث تتبادل البنوك الشيكات أو الحوالات؛ ويحتفظ المشاركون بحساب يتم فيه تسجيل الدائن والمدين)",
 "手形千鳥": "أوركيد عطري (أوركيد أوروبي ذو سنابل كثيفة من زهور وردية أو ليلكية أو حمراء عطرة بمهاميز بارزة)",
 "手心": "حسن تقدير, فطنة (سمة الحكم بحكمة وموضوعية) / تقدير, حرية الإرادة (القدرة على اتخاذ خيارات حرة دون قيود خارجية) / تحفظ, تكتم (معرفة كيفية تجنب الإحراج أو الضيق) / رقة, كياسة (ذوق رفيع؛ لباقة في التصرف)\nمثال: رجل ذو فطنة",
 "手心を加える": "أخذ بعين الاعتبار (تَنَاوَلَ الشيء بيده، تملكه أو تحكم فيه، بالقوة أو بدونها؛ أمْسَكَ بِالشيء. (يتعدى بالباء))\nمثال: أخذ الولد يبكي.",
 "手応え": "مُقَاوَمَة / استجابة, رد فعل (عملية جسدية تحدث نتيجة تأثير منبه أو عامل سابق) / استجابة (الطريقة التي يستجيب بها جهاز كهربائي أو ميكانيكي لإشارة دخل أو نطاق من إشارات الدخل) / استجابة (عبارة يتلوها أو يغنيها المصلون بعد آية من الكاهن أو القس) / اسْتِقْبَال, تَلَقِّي (الطريقة التي يتم بها استقبال شخص أو شيء ما)\nمثال: رد فعل سيء للدواء",
 "手忠実": "مُجْتَهِد (مشتق من إجتهد)\nمثال: لعل المجتهد ينجح.",
 "手慣らし": "تَدْرِيب (تزويدُ الدَّارسين بالدّراسات العلميَّة والعمليّة التي تؤدِّي إلى رفع درجة المهارة عندهم في أداء واجبات الوظيفة؛ إعداد شخص أو مجموعة لتأدية مهمة أو وظيفة معينة) / مُمَارَسَة\nمثال: واصل زيري التدريب.",
 "手慣れた": "مُتَدَرِّب, مُتَمَرِّن (بارع بعد تمرين وممارسة كثيرة) / بَارِع, حَاذِق (يمتلك معرفة ومهارة وكفاءة ويُظهرها)",
 "手慰み": "انحراف, تحويل (التحول جانباً (عن مسارك أو انتباهك أو اهتمامك)) / استجمام, ترفيه (نشاط يسلّي أو يمتع أو ينشّط) / تمويه, هجوم تضليلي (هجوم محسوب لجذب دفاع العدو بعيداً عن نقطة الهجوم الرئيسي)\nمثال: تحويل عن الطريق السريع الرئيسي / قِمَار, مُقَامَرَة",
 "手懐ける": "أَلِيف / رَوَّضَ, آلَفَ (رَوَّضَ المكانُ: أرَاضَ؛ رَوَّضَ فلانٌ: لَزِمَ الرِّياضَ)\nمثال: إلى أية روضة ذهبت؟",
 "手懸": "مِقْبَض / سَيِّدَة / خَلِيلَة, عَشِيقَة",
 "手懸け": "مِقْبَض / سَيِّدَة / خَلِيلَة, عَشِيقَة",
 "手懸女": "سَيِّدَة / خَلِيلَة, عَشِيقَة",
 "手戻り": "رَاجِع, عَائِد (يميل إلى العودة إلى حالة سابقة)",
 "手手": "يَد, إيد (عُضْو من أعضاء الجَسَد، من المَنْكِب إلى أطراف الأصابع؛ مَقْبَض) / عَقْرَب / عَامِل (الذي يَعْمَل أو الذي عَمِلَ؛ هو الذي وَلاه السُلْطَان على أمر من أمور الدولة. الجمع عمَال)\nمثال: ليس باليد حيلة.",
 "手打": "صُلْح, مُصَالَحَة / طباعة, كتابة على الآلة الكاتبة (الكتابة التي تتم باستخدام آلة كاتبة)",
 "手打ち": "صُلْح, مُصَالَحَة / طباعة, كتابة على الآلة الكاتبة (الكتابة التي تتم باستخدام آلة كاتبة)",
 "手技": "حِرْفَة, صَنْعَة",
 "手抄": "مختارات, مقتبس (مقطع مختار من عمل أكبر) / استخلاص, اقتباس (فعل الاقتباس أو الاختيار من عمل أكبر)\nمثال: قدم مقتطفات من كتابات ويليام جيمس الفلسفية",
 "手投げ弾": "قنبلة يدوية (قنبلة مصممة لرميها باليد)",
 "手折る": "قَطَفَ (قطفت الدّابّة قِطَافاً: أَبْطَأَتْ، في أمثالهم: (أَقْطَفُ من أرنب)؛ قَطَفَ الزّهرةَ: قطعها، قَطَفَ الثّمرَ: جناه وجمعه)\nمثال: أحب قطف الورود.",
 "手抜かり": "سهو, غفلة (خطأ ناتج عن عدم الانتباه) / إشراف, رقابة (الإدارة من خلال الإشراف على أداء أو تشغيل شخص أو مجموعة) / سهو, غفلة غير مقصودة (إغفال غير مقصود ناتج عن الفشل في ملاحظة شيء ما)",
 "手押し車": "عربة دفع, عربة يدوية (مركبة بعجلات يمكن دفعها بواسطة شخص؛ قد يكون لها عجلة واحدة أو عجلتان أو أربع عجلات)\nمثال: استخدم عربة يدوية لنقل الصخور بعيداً",
 "手招き": "أَشَارَ, أَوْمَأَ",
 "手招く": "أَشَارَ, أَوْمَأَ",
 "手拭": "مِنْشَفَة",
 "手拭い": "مِنْشَفَة",
 "手拭き": "مِنْشَفَة",
 "手持": "تحت السيطرة (مسسيطراً عليه)\nمثال: كانت أعمال الشغب تحت السيطرة / محمول باليد (صغير وخفيف بما يكفي لتشغيله وأنت تمسكه بيديك)\nمثال: كمبيوتر محمول باليد",
 "手持ち": "تحت السيطرة (مسسيطراً عليه)\nمثال: كانت أعمال الشغب تحت السيطرة / محمول باليد (صغير وخفيف بما يكفي لتشغيله وأنت تمسكه بيديك)\nمثال: كمبيوتر محمول باليد",
 "手持ち現金": "سيولة فورية, نقد جاهز (المال في شكل نقد متاح بسهولة)\nمثال: كانت زوجته دائماً مصدراً جيداً للنقد الجاهز",
 "手指": "إِصْبَع (عضو مستطيل ينشعِب من طرف الكفّ أو القدم) / بَنَان (أَطْرَافُ الأَصَابِعِ) / صَبَّعَ ((صَبَعَ) به، وصَبَعَ عليه يَصْبَعُ صَبْعًا: أشار نحوه بِإِصبَعِهِ سخريةً؛ (صَبَعَ) في الشيءِ: أَدخل إصبَعَه فيه)\nمثال: كان أول ما لفت انتباهه هي بصمة الإصبع على الزجاج. / حضانة, عهدة ((مع 'في') الوصاية على؛ في قضايا الطلاق هو الحق في إيواء ورعاية وتأديب الطفل) / أيدي عاملة, قوة عاملة (قوة العمال المتاحة)\nمثال: مصيري بين يديك",
 "手振り": "لَفْتَة, إِشَارَة",
 "手捉み": "جَشِع, حَرِيص (شديد الرغبة بشكل مفرط في اكتساب الثروة وغيرها) / إمساك, قبض (فعل الإمساك بشيء بإحكام باليدين) / محاولة الفهم (الفهم بصعوبة)\nمثال: كانت المحاضرة تتجاوز أقصى محاولاته للفهم",
 "手捌き": "تداول باليد, معالجة (فعل اللمس باليدين (أو الاستخدام الماهر لليدين) أو باستخدام وسائل ميكانيكية) / مناولة (الحمل أو النقل أو التسليم اليدوي (أو الميكانيكي) أو العمل مع شيء ما) / تعامل, معالجة (إدارة شخص ما أو شيء ما)\nمثال: التعامل مع السجناء",
 "手捏ね": "حرفة يدوية, شغل يدوي (عمل منتج بالعمل اليدوي) / اِعْتِجَان",
 "手捕り": "حجز, مصادرة (الاستيلاء على شيء عن طريق الإجراءات القانونية) / أسر, سيطرة (فعل نزع ملكية المالك بالقوة) / أسر, احتجاز (فعل أخذ شخص بالقوة) / نوبة مرضية (حدوث مفاجئ (أو تكرار) لمرض)\nمثال: عانى من نوبة صرع",
 "手捷い": "سَرِيع / سَرِيعٌ / حَيٌّ (ضد المَيِّت، على قيد الحَيَاة؛ جمع حَيَاء) / جَارٍ (له استخدامات متعددة، تتراوح بين وصف المكان والعلاقة بين الناس، وبين وصف فعل الظلم أو الميل عن الطريق الصحيح؛ \"جار\" كلمةٌ مُشْعِبَةُ المعنى، تشيرُ إلى المكانِ، والعلاقة، والظلم) / سَرِيعًا, بِسُرْعَةٍ\nمثال: ينبح كلب في الحي.",
 "手捻り": "حرفة يدوية, شغل يدوي (عمل منتج بالعمل اليدوي)",
 "手掌": "رَاحَة, كَفّ",
 "手掛": "مِقْبَض / سَيِّدَة / خَلِيلَة, عَشِيقَة",
 "手掛かり": "خيط دليل, قرينة (دليل يساعد على حل مشكلة) / تلميح, دليل (إشارة طفيفة) / مقبض, موطئ يد (ملحق للإمساك به)",
 "手掛け": "مِقْبَض / سَيِّدَة / خَلِيلَة, عَشِيقَة",
 "手掛ける": "مِقْبَض / خَلْفِيّ",
 "手掛け女": "سَيِّدَة / خَلِيلَة, عَشِيقَة",
 "手掛女": "سَيِّدَة / خَلِيلَة, عَشِيقَة",
 "手探り": "أَخْرَق, غَيْرُ كُفْء (يُظهر افتقارًا إلى المهارة أو الكفاءة)",
 "手控え": "مُلَاحَظَة, مَلْحُوظَة / مُذَكَّرَة / دَرَجَة",
 "手控える": "اِمْتَنَعَ (مَنَعَ نفسه؛ كان مَنِيْعًا يصعب الوصول إليه) / لَازِمَة, قَرَار",
