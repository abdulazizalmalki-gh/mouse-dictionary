 "掩蓋": "غِطَاء / غِلَاف / غَطَّى",
 "掩蔽": "غِطَاء / غِلَاف / غَطَّى / احْتِجَاب / الغَيْبَة",
 "掩蔽壕": "مَخْبَأ, قَبْو",
 "措いて": "اِسْتَثْنَى (أن يشمل الكُلّ إلا جزء، ولا يكون إلا إذا كان الجزءُ جزءًا من الكل) / إِلَّا, بِاسْتِثْنَاء (حرف استثناء؛ في : للسؤال المنفي، مرادف لبَلَى في الفصحى) / مثال: لا أعرف إلا هذا.",
 "措く": "وَقَفَ, تَوَقَّفَ (قَامَ، اِنْتَصَبَ، نَهَضَ؛ ثَبَتَ) / أَوْقَفَ, وَقَفَ / تَوَقَّفَ, وَقَّف / مَوْقِف / وَقْفَة\nمثال: وقف وراء الباب. / اِسْتَثْنَى (أن يشمل الكُلّ إلا جزء، ولا يكون إلا إذا كان الجزءُ جزءًا من الكل) / إِلَّا, بِاسْتِثْنَاء (حرف استثناء؛ في : للسؤال المنفي، مرادف لبَلَى في الفصحى) / مثال: لا أعرف إلا هذا.",
 "措定": "افتراض, تولي (فعل حيازة أو تولي السلطة على شيء ما) / افتراض (فعل الافتراض أو التسليم بجدلية أمر ما) / افتئات, تطاول (سلوك جريء (حتى متعجرف) ليس من حقك) / افتراض (فرضية تؤخذ كأمر مسلم به)\nمثال: تزامنت توليه المنصب مع الاضطرابات في كوبا",
 "措置": "قِيَاس / فَاصِلَة / إِجْرَاء / قَاسَ (شديد وصلب، غير لين؛ جافٍ أو يابس في الملمس أو التعامل)\nمثال: قاس طول السرير.",
 "措辞": "ألفاظ, صياغة (الطريقة التي يتم بها التعبير عن شيء ما بالكلمات)",
 "措辞法": "بِنَاء جُمْلَة, نَحْو (ضد هَدْم. ؛ المَبْنَى أو البِنَاية)\nمثال: أنا وجدت البناء.",
 "掬い": "مِغْرَفَة",
 "掬い出す": "كَفَالَة",
 "掬う": "مِغْرَفَة",
 "掬する": "أخذ بعين الاعتبار (تَنَاوَلَ الشيء بيده، تملكه أو تحكم فيه، بالقوة أو بدونها؛ أمْسَكَ بِالشيء. (يتعدى بالباء))\nمثال: أخذ الولد يبكي.",
 "掲げる": "تَسَكَّعَ / مُخبر المراهنات (شخص يبيع النصائح حول المقامرة أو المضاربة (خاصة في سباق الخيل)) / دلال, سمسار (شخص يعلن للزبائن بطريقة وقحة بشكل خاص) / بائع تذاكر في السوق السوداء (شخص يشتري تذاكر لحدث ما لإعادة بيعها بربح) / نَشَرَ, أَصْدَرَ (بَسَطَ، فَرَّقَ، نَشَرَ الشيءَ: جعله منتشراً، مثل نشر الأخبار أو نشر كتاب؛ نَشَرَ: وزع أو عمم شيئًا بين الناس، مثل نشر المقالات)\nمثال: نشر توم الغسيل. / مِرْوَحَة, مروحة / مِرْوَحَة, هَوَّايَة / مُشَجِّع, مُشَجِّعَة",
 "掲出": "إرسال بالبريد (إرسال رسالة عبر البريد) / قيد محاسبي ((مسك الدفاتر) إدراج في سجلات الشركة) / إعلان ورقي, ملصق (لافتة منشورة في مكان عام كإعلان)\nمثال: يشير ختم البريد إلى وقت الإرسال",
 "掲揚": "رَفَعَ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ) / رَافِعَة\nمثال: رفع سامي نظارته.",
 "掲示": "لَاحَظَ / لَاحَظَ, اِنْتَبَهَ",
 "掲示板": "لَوْحَة إِعْلَانَات / نظام لوحة الإعلانات الإلكترونية (حاسوب يشغل برنامجاً يسمح للمستخدمين بترك رسائل والوصول إلى معلومات ذات اهتمام عام)",
 "掲示板システム": "نظام لوحة الإعلانات الإلكترونية (حاسوب يشغل برنامجاً يسمح للمستخدمين بترك رسائل والوصول إلى معلومات ذات اهتمام عام)",
 "掲載": "نَشْر (بَسَطَ، فَرَّقَ، نَشَرَ الشيءَ: جعله منتشراً، مثل نشر الأخبار أو نشر كتاب؛ نَشَرَ: وزع أو عمم شيئًا بين الناس، مثل نشر المقالات) / مَنْشُور\nمثال: نشر توم الغسيل.",
 "掲題": "فَاعِل, مُبْتَدَأ (الشيء :فعله) / مَوْضُوع / دَوْرَة, مَادَّة (في غرب العراق على نهر الفرات قرب الحدود السورية؛ حَيّ في جنوب بغداد تقع فيه محطة تكرير للنفط تسمّى بإسمه) / رَعِيَّة\nمثال: تظن الشرطة أن سامي يعلم من الفاعل.",
 "掴まえる": "لُقْطَة / أَمْسَكَ (حَبَسَ الشيءَ، قَبَضَ عَلَيْهِ. و (يتعدى بالباء)؛ اِمْتَنَعَ بالشيءِ، اِعْتَصَمَ بِه. (يتعدى بالباء)) / مَسَكَ\nمثال: كنت أمسك بالكرة. / مَسَكَ / قَبَضَ (أَخَذَ الشيءَ بِيَدِه؛ أَمْسَكَ الشيءَ) / مَسْك, قَبْض\nمثال: لقد قبض على توم. / وَقَفَ, تَوَقَّفَ (قَامَ، اِنْتَصَبَ، نَهَضَ؛ ثَبَتَ) / أَوْقَفَ, وَقَفَ / تَوَقَّفَ, وَقَّف / مَوْقِف / وَقْفَة\nمثال: وقف وراء الباب. / نَحْوَ, صَوْبَ / نَحُو / لِأَجْل / بِقُرْب",
 "掴ませる": "رَشْوَة, رِشْوَة / رَشَا (رَشا الفرخُ رَشا رَشواً، مَدَّ رأْسَهُ إِلى أُمِّهِ لتَزُقَّهُ؛ رَشا فلاناً: أَعطاه رشوة)\nمثال: عندي برشا أسئلة على الكتاب هذا.",
 "掴まる": "قَبْضَة / وَجَدَ, لَقِيَ (أَدْرَكَ المطلوب، أَدْرَكَ الشيء الذي أَرَادَهُ وبَحَثَ عنه؛ غَضِبَ عليه. (يتعدى بعلى)) / لَقِيَّة\nمثال: وجد ياني هاتفه.",
 "掴み": "مَقْبِض",
 "掴みあう": "عراك, مصارعة (فعل الانخراط في قتال يدوي وثيق) / غارفة محارية (دلو جرف بمفاصل تشبه صدفة المحار) / خُطَّاف إرساء, مرساة خطافية (أداة تتكون من عدة خطافات للإمساك والتشبث؛ غالباً ما تُرمى بحبل)\nمثال: كان بينهما مصارعة عنيفة",
 "掴みどころ": "نُقْطَة (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه) / مَوْقِع (موضع الوُقُوع؛ الموضع الذي حَدَثَ أو يحدث فيه حادث) / أَشَارَ\nمثال: هذه هي نقطة ضعفه. / مَسَكَ, مسك",
 "掴み出す": "أَخْرَجَ",
 "掴み取る": "قَبْضَة",
 "掴み合う": "عراك, مصارعة (فعل الانخراط في قتال يدوي وثيق) / غارفة محارية (دلو جرف بمفاصل تشبه صدفة المحار) / خُطَّاف إرساء, مرساة خطافية (أداة تتكون من عدة خطافات للإمساك والتشبث؛ غالباً ما تُرمى بحبل)\nمثال: كان بينهما مصارعة عنيفة",
 "掴み所": "نُقْطَة (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه) / مَوْقِع (موضع الوُقُوع؛ الموضع الذي حَدَثَ أو يحدث فيه حادث) / أَشَارَ\nمثال: هذه هي نقطة ضعفه. / مَسَكَ, مسك",
 "掴み所がない": "غَامِض, مُبْهَم (غير واضح التعبير أو المعنى) / غامض, غير محدد (غير محدود أو مقرر أو مميز بدقة) / بَاهِت, خَافِت (يَفْتَقِر إِلَى الوُضُوح أَوِ التَّمَيُّز)\nمثال: مصطلح غير محدد (مبهم)",
 "掴み所のない": "غَامِض, مُبْهَم (غير واضح التعبير أو المعنى) / غامض, غير محدد (غير محدود أو مقرر أو مميز بدقة) / بَاهِت, خَافِت (يَفْتَقِر إِلَى الوُضُوح أَوِ التَّمَيُّز)\nمثال: مصطلح غير محدد (مبهم)",
 "掴む": "إِسْتَوْلَى عَلَى / حَصَلَ (الشيء: حَصَلَ عليه؛ العلم: أخَذَه وحَازَه)\nمثال: متى حصل الحادث؟ / فَهِمَ (فهم الأمر أو الكلام أو نحو ذلك، أدركه، علمه، أحسن تصوّره، استوعبه)\nمثال: لقد أسئت الفهم.",
 "掵": "جُرْف (أخذ شيئًا وجرفه بعيدًا، أو سحب شيئًا بقوة؛ في : في بعض الحالات، قد تستخدم للإشارة إلى إزالة أو جرف شيء نحو مكان آخر)",
 "掻い摘む": "لَخَّصَ, اِخْتَصَرَ",
 "掻い撫で": "سَطْحِيّ",
 "掻い暮れ": "أبداً",
 "掻き": "سكتة دِمَاغِيَّة / لَاطَفَ / مَلَّسَ",
 "掻きくどく": "حَثَّ (حثّ الشّخصَ:أعجله ، حثّه على الشّيء:حضّه عليه ، شجّعه؛ حثَّه علَيْه :حَضَّهُ عَلَيْهِ، ونَدَبَه لَهُ وإِليه)\nمثال: بحث عن المفتاح.",
 "掻きむしる": "قَطَفَ (قطفت الدّابّة قِطَافاً: أَبْطَأَتْ، في أمثالهم: (أَقْطَفُ من أرنب)؛ قَطَفَ الزّهرةَ: قطعها، قَطَفَ الثّمرَ: جناه وجمعه)\nمثال: أحب قطف الورود.",
 "掻き乱す": "مُسْتَاء, مُمْتَعِض / إخْلَال / أَسْخَطَ ((أأَسْخَطَه): أغضَبَهُ) / أَخَلَّ ((أَخَلَّ): رعت إبله الخلة؛ (أَخَلَّ) بالمكان وبمركزه وغيره: غاب عنه وتركه)",
 "掻き傷": "خَرْبَشَ",
 "掻き切る": "جَرَحَ (كَلَمَ، شَقَّ اللَحْم وأسَالَ الدَمّ؛ صَادَ أو اكْتَسَبَ) / قَصَّ\nمثال: ذلك سيهيج الجرح.",
 "掻き口説く": "حَثَّ (حثّ الشّخصَ:أعجله ، حثّه على الشّيء:حضّه عليه ، شجّعه؛ حثَّه علَيْه :حَضَّهُ عَلَيْهِ، ونَدَبَه لَهُ وإِليه)\nمثال: بحث عن المفتاح.",
 "掻き合わせる": "رَتَّبَ (رتَّبْته ترتيباً:ثَبَّتَه؛ رتّب الشّيء:نَسَّقَه ونَظَّمَه ووضعه في موضعه)\nمثال: رتب فاضل غرفتة.",
 "掻き回す": "تَحَرَّكَ (حَرُكَ)\nمثال: لا أستطيع التحرك.",
 "掻き均す": "مِدَمَّة, مُشْط / يجمع الحشائش / قذائف مكثفَة / يسرح الشعر\\الحشائش",
 "掻き平す": "مِدَمَّة, مُشْط / يجمع الحشائش / قذائف مكثفَة / يسرح الشعر\\الحشائش",
 "掻き抱く": "اِحْتِضَان, حَضْن / عَانَقَ, اِحْتَضَنَ",
 "掻き撫でる": "سكتة دِمَاغِيَّة / لَاطَفَ / مَلَّسَ / دندنة, عزف (صوت العزف على الأوتار)\nمثال: عزف الغيتار",
 "掻き毟る": "قَطَفَ (قطفت الدّابّة قِطَافاً: أَبْطَأَتْ، في أمثالهم: (أَقْطَفُ من أرنب)؛ قَطَفَ الزّهرةَ: قطعها، قَطَفَ الثّمرَ: جناه وجمعه)\nمثال: أحب قطف الورود.",
 "掻き消える": "اِخْتَفَى (تعمّد وتكلف إخفاء نفسه عنه الأنظار فلا يُرى؛ خَفِيَ بعد أن كان مرئيًّا) / أَخْفَى\nمثال: لقد اختفى فاضل.",
 "掻き消す": "مَحَا, مَحَى / اِمَّحَى, اِنْمَحَى",
 "掻き混ぜる": "خَلَطَ, مَزَجَ (اختلط)\nمثال: خلط توم بين السكر و الملح.",
 "掻き立てる": "خَزَّ (\"خَزَّهُ بسكِّينٍ\" : طَعَنَهُ بِهِ؛ \"خَزَّهُ بِبَصَرِهِ\" : أَصَابَتْهُ عَيْنُه)\nمثال: إذا كنت وخز لنا، هل نحن لا ينزف؟ / تَحَرَّكَ (حَرُكَ)\nمثال: لا أستطيع التحرك.",
 "掻き込む": "مِجْرَفَة, مِجْرَاف / مجرفة",
 "掻き集める": "مِدَمَّة, مُشْط / يجمع الحشائش / قذائف مكثفَة / يسرح الشعر\\الحشائش",
 "掻き鳴らす": "دندنة, عزف (صوت العزف على الأوتار)\nمثال: عزف الغيتار",
 "掻く": "خَرْبَشَ / مِجْرَفَة, مِجْرَاف / مجرفة",
 "掻っ切る": "جَرَحَ (كَلَمَ، شَقَّ اللَحْم وأسَالَ الدَمّ؛ صَادَ أو اكْتَسَبَ) / قَصَّ\nمثال: ذلك سيهيج الجرح.",
 "掻っ払い": "إمساك, التقاط (فعل التقاط شيء باليدين) / خطف (رفعة أوزان يتم فيها رفع البار فوق الرأس في حركة واحدة سريعة) / اختطاف, خطف ((قانون) العمل غير القانوني المتمثل في القبض على شخص وحمله بعيداً رغماً عنه واحتجازه في سجن زائف) / فرج (مصطلحات بذيئة للأعضاء التناسلية الأنثوية)\nمثال: أمسك ميس بالكرة وظهره للوحة / لص متسلل (لص يسرق دون استخدام العنف)",
 "掻っ払う": "ضربة قوية عشوائية (ضربة كاسحة أو عنيفة)",
 "掻っ捌く": "جَرَحَ (كَلَمَ، شَقَّ اللَحْم وأسَالَ الدَمّ؛ صَادَ أو اكْتَسَبَ) / قَصَّ\nمثال: ذلك سيهيج الجرح.",
 "掻っ攫う": "إمساك, التقاط (فعل التقاط شيء باليدين) / خطف (رفعة أوزان يتم فيها رفع البار فوق الرأس في حركة واحدة سريعة) / اختطاف, خطف ((قانون) العمل غير القانوني المتمثل في القبض على شخص وحمله بعيداً رغماً عنه واحتجازه في سجن زائف) / فرج (مصطلحات بذيئة للأعضاء التناسلية الأنثوية)\nمثال: أمسك ميس بالكرة وظهره للوحة",
 "掻っ穿る": "مِعْوَل, فَأْس (الفأس الكبيرة العظيمة، تستخدم في الزراعة والصناعة)",
 "掻っ込む": "مِجْرَفَة, مِجْرَاف / مجرفة",
 "掻器": "مِكْشَطة (أي من الأدوات اليدوية المختلفة للكشط)",
 "掻払い": "إمساك, التقاط (فعل التقاط شيء باليدين) / خطف (رفعة أوزان يتم فيها رفع البار فوق الرأس في حركة واحدة سريعة) / اختطاف, خطف ((قانون) العمل غير القانوني المتمثل في القبض على شخص وحمله بعيداً رغماً عنه واحتجازه في سجن زائف) / فرج (مصطلحات بذيئة للأعضاء التناسلية الأنثوية)\nمثال: أمسك ميس بالكرة وظهره للوحة / لص متسلل (لص يسرق دون استخدام العنف)",
 "掻払う": "ضربة قوية عشوائية (ضربة كاسحة أو عنيفة)",
 "掻爬": "كشط (جراحة لإزالة الأنسجة أو الزوائد من تجويف الجسم (كالرحم) عن طريق الكشط بأداة المكشطة)",
 "掻痒": "حِكَّة / أَحَكَّ (أَحَكَّ (فلانًا جسمَه): حكَّه؛ ويقال: أَحَكَّ الأمرَ في صدره: حكَّه)",
 "掻痒感": "حكة, هرش (إحساس جلدي مزعج يولد الرغبة في الحك)",
 "掻痒症": "حكاك, حكة مرضية (إحساس حكة شديد يمكن أن يكون له أسباب مختلفة (مثل الحساسية أو العدوى أو اليرقان، إلخ))",
 "揃い": "وَضَع (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه) / غَرَبَ (الجِهَة التي تغرب نحوها الشَمس؛ ضد الشَرْق؛ الأَرَاضِي والبِلَاد التي تقع جهة الغرب في العَالم) / مَجْمُوعَة, طَقْم (مؤنث مَجْمُوع وهو اسم مفعول من جَمَعَ؛ الطَائِفَة أو الجَمَاعَة من الناس) / مَجْمُوعَة (مؤنث مَجْمُوع وهو اسم مفعول من جَمَعَ؛ الطَائِفَة أو الجَمَاعَة من الناس)\nمثال: لقد أزمت الوضع. / بالكامل, بشكل تام (إلى درجة كاملة أو إلى الحد الأقصى؛ بالكامل) / حصرياً, فقط (دون تضمين أو إشراك أي آخرين)\nمثال: كان مقتنعاً كلياً",
 "揃い踏み": "تَشْكِيلَة",
 "揃う": "مُبَارَاة / شَحّاطَة, شَخَّاطَة / جَمَعَ (ضَمَّ، لَمَّ، حَشَدَ؛ في : أَضَافَ أعدادا إلى غيرها)\nمثال: جمع خيل هو خيول.",
 "揃え": "محاذاة, موازاة (فعل تعديل أو محاذاة أجزاء جهاز بالنسبة لبعضها البعض) / اِصْطِفَاف, مُحَاذَاة (الخاصية المكانية التي يمتلكها ترتيب أو وضع الأشياء في خط مستقيم أو في خطوط متوازية) / اقتران, محاذاة ((في علم الفلك) التقاء ظاهري أو مرور لجرمين سماويين أو أكثر في نفس الدرجة من البروج) / ائتلاف, تحالف (منظمة من الأشخاص (أو البلدان) المشاركين في ميثاق أو معاهدة)",
 "揃える": "جَمَعَ (ضَمَّ، لَمَّ، حَشَدَ؛ في : أَضَافَ أعدادا إلى غيرها)\nمثال: جمع خيل هو خيول. / رَتَّبَ (رتَّبْته ترتيباً:ثَبَّتَه؛ رتّب الشّيء:نَسَّقَه ونَظَّمَه ووضعه في موضعه)\nمثال: رتب فاضل غرفتة. / مُبَارَاة / شَحّاطَة, شَخَّاطَة",
 "揃って": "كلهم معاً, معاً جميعاً (تستخدم لمجموعة تصرف أعضاؤها أو تم التصرف معهم بشكل جماعي) / في آن واحد, معاً (الجميع في نفس الوقت)\nمثال: تم تجميعهم كلهم معاً",
 "揃わない": "غَيْر كَافٍ, غَيْر مُلَائِم (لفتقار إلى الصفات أو الموارد اللازمة لتلبية مهمة ما) / غير متساوٍ, متفاوت (سيء التوازن أو التوافق في الكمية أو القيمة أو القياس)\nمثال: تدريب غير كافٍ",
 "揆": "طَرِيق, سَبِيل (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من ٱلشَّارِعِ، سَبِيل)\nمثال: أسأل عن الطريق.",
 "揉みくしゃ": "تدافع, زحام (فعل التدافع (شق طريقك عن طريق الدفع))",
 "揉みくた": "تدافع, زحام (فعل التدافع (شق طريقك عن طريق الدفع))",
 "揉みくちゃ": "تدافع, زحام (فعل التدافع (شق طريقك عن طريق الدفع))",
 "揉みしだく": "جَعْدَة / تَجَعُّد, جَعْدَة / تَدْلِيك, تَمْسِيد / دَلَّكَ, مَسَّدَ (دَلَكَ جِسْمَهُ: حَكَّهُ؛ يَدْلُكُ وَجْهَهُ بِالطِّيبِ: يَطْليهِ، يُضَمِّخُهُ)",
 "揉みほぐす": "تَدْلِيك, تَمْسِيد / دَلَّكَ, مَسَّدَ (دَلَكَ جِسْمَهُ: حَكَّهُ؛ يَدْلُكُ وَجْهَهُ بِالطِّيبِ: يَطْليهِ، يُضَمِّخُهُ)",
 "揉み上げ": "سَوَالِف, سَالِف اَلشَّعْر",
 "揉み合い": "تدافع, زحام (فعل التدافع (شق طريقك عن طريق الدفع))",
 "揉み合う": "تدافع, زحام (فعل التدافع (شق طريقك عن طريق الدفع))",
 "揉み揉み": "تَدْلِيك, تَمْسِيد / دَلَّكَ, مَسَّدَ (دَلَكَ جِسْمَهُ: حَكَّهُ؛ يَدْلُكُ وَجْهَهُ بِالطِّيبِ: يَطْليهِ، يُضَمِّخُهُ) / اعتصار, عصر (فعل الإمساك والضغط بقوة)\nمثال: عصر خدها بمرح",
 "揉み消し": "تستر (إخفاء يحاول منع شيء فاضح من أن يصبح علنياً)",
 "揉み消す": "أَطْفَأَ (أطفأ بالسحق أو الضغط)\nمثال: أطفئ سيجارتك الآن / خنق, مفصل الركبة (المفصل بين عظم الفخذ والساق في ذوات الأربع؛ يقابل الركبة البشرية)",
 "揉み療治": "تَدْلِيك, تَمْسِيد / دَلَّكَ, مَسَّدَ (دَلَكَ جِسْمَهُ: حَكَّهُ؛ يَدْلُكُ وَجْهَهُ بِالطِّيبِ: يَطْليهِ، يُضَمِّخُهُ)",
 "揉み皮": "جِلْدِيّ اللَّوْن (بلون البيج المائل إلى الاصفرار كالجلد المدبوغ) / أداة تلميع, صاقلة (أداة تتكون من مادة ناعمة مثبتة على كتلة؛ تستخدم للتلميع (كما في تجميل الأظافر)) / بني مصفر, كراميل (لون أسمر متوسط إلى داكن) / جِلْد عَارٍ, عُرْي (الجلد العاري)\nمثال: السباحة في العراء تعني السباحة عارياً",
 "揉み立てる": "اِنْهَار / اِنْهِيَار (سقوط شيء أو تهاويه بشكل مفاجئ نتيجة ضعف أو خلل؛ تدهور نفسي أو عاطفي يؤدي إلى فقدان القدرة على التحمل)\nمثال: يوشك الجسر على الانهيار. / آلَةُ طِبَاعَة, آلَةُ الطِّبَاعَة (الفارسية: ماشين؛ الأوردية: مشين) / صِحَافَة, صَحَافَة (هي مهنة من يكتب في الصُحُف والمَجَلات وغيرها من الدَوْريَّات؛ هي مجموعة المؤسسات التي تصدر أو تنشر الصُحُف والمَجَلات وغيرها من الدَوْريَّات) / ضَغَطَ\nمثال: نسى زيري الآلة.",
 "揉み解す": "تَدْلِيك, تَمْسِيد / دَلَّكَ, مَسَّدَ (دَلَكَ جِسْمَهُ: حَكَّهُ؛ يَدْلُكُ وَجْهَهُ بِالطِّيبِ: يَطْليهِ، يُضَمِّخُهُ)",
 "揉み込む": "عَلَّمَ (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "揉み革": "جِلْدِيّ اللَّوْن (بلون البيج المائل إلى الاصفرار كالجلد المدبوغ) / أداة تلميع, صاقلة (أداة تتكون من مادة ناعمة مثبتة على كتلة؛ تستخدم للتلميع (كما في تجميل الأظافر)) / بني مصفر, كراميل (لون أسمر متوسط إلى داكن) / جِلْد عَارٍ, عُرْي (الجلد العاري)\nمثال: السباحة في العراء تعني السباحة عارياً",
 "揉む": "حَكَّ, فَرَكَ (مَرَّرَ شَيْئًا عَلَى شَيْءٍ آخَرَ بِقُوَّةٍ لِيُزِيلَ مَا عَلَيْهِ؛ حَكَّ جلدَه : فركه بأظفاره)\nمثال: لقد حك سامي كعبه حتى بدأ ينزف. / تَدْلِيك, تَمْسِيد / دَلَّكَ, مَسَّدَ (دَلَكَ جِسْمَهُ: حَكَّهُ؛ يَدْلُكُ وَجْهَهُ بِالطِّيبِ: يَطْليهِ، يُضَمِّخُهُ) / جَادَلَ, حَاجَّ (حَاوَرَ، نَاقَشَ؛ خَاصَمَ) / ذَيْل (ذَيَّلَ (ذيله): جعل له ذيلا؛ (ذَيَّلَ) أطال ذيله وطوله. ويقال ذيل كتابه أو كلامه: أردفه بكلام كالتتمة له) / قَافِلَة (مؤنث القافل؛ الراجعة؛ جماعة من الناس تسير معًا مع أمتعتها وركوبها في سفر قافلين كانوا أو خارجين. سميّت كذلك تفائلا برجوعها) / تَدَرَّبَ, تَمَرَّنَ / دَرَّبَ, درب (الدَّرْبُ: كُلُّ طريقٍ يصلُ بين مكانَيْن. يقال: مَنْ سار على الدَّرب وصل : معناه أنّ المهارة تكتسبُ بالمِران؛ الدَّرْبُ: المَضيقُ في الجبال الْمَضْيَقُ فِي الجَبَلِ) / درب, أهل (الدَّرْبُ: كُلُّ طريقٍ يصلُ بين مكانَيْن. يقال: مَنْ سار على الدَّرب وصل : معناه أنّ المهارة تكتسبُ بالمِران؛ الدَّرْبُ: المَضيقُ في الجبال الْمَضْيَقُ فِي الجَبَلِ)\nمثال: للبقرة ذيل طويل.",
 "揉め": "نِزَاع, شِجَار (حالة المريض المشرف على الموت؛ خُصُومَة بين أفراد أو جماعات قد تقتصر على تبادل الشتائم وقد تمتدّ إلى التماسك بالأيدي أو استخدام أداة ما في المشاجرة أو تُفضي إلى الحرب بين الدول) / تَشَاجَرَ\nمثال: شمال مالي منطقة نزاع.",
 "揉める": "نِزَاع, شِجَار (حالة المريض المشرف على الموت؛ خُصُومَة بين أفراد أو جماعات قد تقتصر على تبادل الشتائم وقد تمتدّ إلى التماسك بالأيدي أو استخدام أداة ما في المشاجرة أو تُفضي إلى الحرب بين الدول)\nمثال: شمال مالي منطقة نزاع.",
 "揉め事": "نِزَاع, شِجَار (حالة المريض المشرف على الموت؛ خُصُومَة بين أفراد أو جماعات قد تقتصر على تبادل الشتائم وقد تمتدّ إلى التماسك بالأيدي أو استخدام أداة ما في المشاجرة أو تُفضي إلى الحرب بين الدول) / تَشَاجَرَ\nمثال: شمال مالي منطقة نزاع.",
 "揉消す": "أَطْفَأَ (أطفأ بالسحق أو الضغط)\nمثال: أطفئ سيجارتك الآن / خنق, مفصل الركبة (المفصل بين عظم الفخذ والساق في ذوات الأربع؛ يقابل الركبة البشرية)",
 "揉療治": "تَدْلِيك, تَمْسِيد / دَلَّكَ, مَسَّدَ (دَلَكَ جِسْمَهُ: حَكَّهُ؛ يَدْلُكُ وَجْهَهُ بِالطِّيبِ: يَطْليهِ، يُضَمِّخُهُ)",
 "揉解す": "تَدْلِيك, تَمْسِيد / دَلَّكَ, مَسَّدَ (دَلَكَ جِسْمَهُ: حَكَّهُ؛ يَدْلُكُ وَجْهَهُ بِالطِّيبِ: يَطْليهِ، يُضَمِّخُهُ)",
 "描いた": "مَاضٍ, الْمَاضِي ((في النحو) زمن نحوي يدل على حدث قد وقع، أو وُجِد قبل الآن بوقت ما)",
 "描きだす": "محدد, ممثل (تم تمثيله بدقة أو تحديده)",
 "描き上げる": "اِنْتَهَى, أَكْمَلَ (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات) / كَامِل / ذَرِيع\nمثال: انتهى أمر زيري.",
 "描き下ろす": "دَلَجَ, غَرَفَ / رَسَمَ (سَم الشَّيءَ :خطّه رسَم مُربَّعًا/ صورةً/ شكلاً؛ رسَم : كَتَبَ) / قُرْعَة\nمثال: واصل زيري الرسم.",
 "描き出す": "محدد, ممثل (تم تمثيله بدقة أو تحديده)",
 "描き分ける": "دَلَجَ, غَرَفَ / رَسَمَ (سَم الشَّيءَ :خطّه رسَم مُربَّعًا/ صورةً/ شكلاً؛ رسَم : كَتَبَ) / قُرْعَة\nمثال: واصل زيري الرسم.",
 "描き手": "فَنَّان, فَنَّانَة (من يصنع الفَنَّ، من يمتهنه؛ مَوْهُوب)\nمثال: إنه فنان مشهور.",
 "描き起こし": "كَرْشَنَة, نَقْصَوَة",
 "描き起し": "كَرْشَنَة, نَقْصَوَة",
 "描く": "دَلَجَ, غَرَفَ / رَسَمَ (سَم الشَّيءَ :خطّه رسَم مُربَّعًا/ صورةً/ شكلاً؛ رسَم : كَتَبَ) / قُرْعَة\nمثال: واصل زيري الرسم. / وَصَفَ / تَخَيَّلَ, تَصَوَّرَ",
 "描像": "وَصْف, تَوْصِيف",
 "描写": "تصوير, رسم (التمثيل عن طريق الرسم أو التلوين وما إلى ذلك) / تخطيط, رسم خطي (رسم لخطوط خارجية لأشكال أو أشياء) / تصوير, تمثيل (تمثيل عن طريق الصورة أو الرسم) / تشخيص, تصوير (وصف لفظي بياني أو حيوي)\nمثال: في كثير من الأحيان كانت الرواية تُقاطع بصور لفظية طويلة",
 "描出": "وَصْف, تَوْصِيف",
 "描寫": "تصوير, رسم (التمثيل عن طريق الرسم أو التلوين وما إلى ذلك) / تخطيط, رسم خطي (رسم لخطوط خارجية لأشكال أو أشياء) / تصوير, تمثيل (تمثيل عن طريق الصورة أو الرسم) / تشخيص, تصوير (وصف لفظي بياني أو حيوي)\nمثال: في كثير من الأحيان كانت الرواية تُقاطع بصور لفظية طويلة",
 "描画": "رَسْم (سَم الشَّيءَ :خطّه رسَم مُربَّعًا/ صورةً/ شكلاً؛ رسَم : كَتَبَ)\nمثال: واصل زيري الرسم.",
 "描画像": "صُورَة / اِنْطِبَاع, سُمْعَة",
 "描線": "خَطّ (كِتَابَة؛ ما يَصِل نقطتين أو أكثر)\nمثال: إرسم خط مستقيم.",
 "提げ": "إنزال, خفْض (عملية التسبب في تحرك شيء ما إلى مستوى أدنى) / تنزيل, خفض (عملية التسبب في أن يصبح الشيء أقل) / مُتَجَهِّم, مُكْفَهِرّ (مُعتم بالغيوم مع إيحاء بالتهديد) / إهلاك, انخفاض القيمة (انخفاض في السعر أو القيمة) / اسْتِخْفَاف, انْتِقَاص (تواصل يقلل من شأن شخص أو شيء ما) / إهلاك, استهلاك (انخفاض في قيمة أصل ما بسبب التقادم أو الاستخدام)\nمثال: انخفاض قيمة الدولار مقابل الين / نُكْتَة",
 "提げる": "عَلِقَ, عِلِق / عَلَّقَ, عَلَّق / شَنَقَ, شَنَق (قتله بربط حبل حول رقبته وإسقاطه)\nمثال: شنق زيري نفسه فوق شجرة. / رَصَاص / قَادَ / أَرْشَدَ, هَدَى (أَرشَدَهُ: هدَاه ودَلَّهُ؛ يقال: أَرشَدَهُ الله، وأَرشدَهُ إِلى الأَمر، وله، وعليه) / حَالِيّ, حَاضِر / مَوْجُود, حَاضِر (الذي له وجود) / الزَّمَان, الْحَال / قَدَّمَ, طَرَحَ (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى الرُّسْغَ؛ أنّ لهم سابقةً وفضلاً له عند فلان قَدَمٌ : معروف)\nمثال: أنا موجود لوحدي",
 "提供": "اِقْتِرَاح / اِقْتَرَحَ, قَدَّمَ (اِبْتَدَعَ ٱلشَّيْءَ مِنْ ذَاتِ نَفْسِهِ مِنْ غَيْرِ أَنْ يَسْمَعَهُ؛ اِخْتَارَ) / قَدَّمَ (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى الرُّسْغَ؛ أنّ لهم سابقةً وفضلاً له عند فلان قَدَمٌ : معروف)\nمثال: اقترح سامي المساعدة. / رَاعٍ ((رَاعَ) يَرُوعُ رَوْعًا: فَزِعَ؛ يُقال: (راع) منه)\nمثال: سلم إيغور القطيع لراع آخر.",
 "提供側": "مُرْسِل, مُرْسِلَة",
 "提供元": "موفر, مُعِيل (شخص يوفر سبل العيش) / مُزوّد, مُورّد (شخص عمله هو توريد خدمة أو سلعة معينة)",
 "提供者": "مُتَبَرِّع",
 "提出": "إِرَاءَة / إِهْدَاء, مَنْح",
 "提出日": "مَوْعِد (مَوْعِد الإفطار،أي وقت الإفطار؛ لديه مَوْعِد مع صديق)\nمثال: مناد عنده موعد.",
 "提出期限": "أَجَل, مُهْلَة (مُدَّة الشيء، وَقْت أو مَوْعِد انتهاء الشيء أو حلوله)\nمثال: اقترب أجل زيري.",
 "提出者": "مانح, متبرع (شخص يقدم هدية أو هبة من ممتلكاته) / راعٍ, مُقدِّم (مدافع يقدم شخصًا (كما في جائزة أو درجة علمية أو مقدمة إلخ)) / مقدّم (شخص يقدم رسالة من نوع ما (مثل عريضة أو خطاب أو شيك أو نصب تذكاري إلخ))",
 "提唱": "محاماة / تَأْييد / مُنَاصَرَة",
 "提唱者": "دَاعِم, مُؤَيِّد",
 "提喩": "مجاز مرسل (استبدال مصطلح أكثر شمولاً بآخر أقل شمولاً أو العكس)",
 "提喩法": "مجاز مرسل (استبدال مصطلح أكثر شمولاً بآخر أقل شمولاً أو العكس)",
 "提挈": "تَعَاوُن",
 "提携": "تَعَاوُن",
 "提携交渉": "توقف, جمود (انقطاع النشاط الطبيعي) / ارتباط, انتساب (علاقة اجتماعية أو تجارية)\nمثال: انتساب مالي قيم",
 "提案": "طَلَب الزَّوَاج (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى))\nمثال: طلب زيري ورودا.",
 "提案書": "طَلَب الزَّوَاج (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى))\nمثال: طلب زيري ورودا.",
 "提案者": "دَاعِم, مُؤَيِّد",
 "提灯": "فانوس صيني (فانوس ورقي قابل للطي بألوان زاهية؛ يستخدم لأغراض الزينة)",
 "提灯持": "مُتَمَلِّق, مُداهِن (شخص يستخدم الإطراء والتملق)",
 "提灯持ち": "مُتَمَلِّق, مُداهِن (شخص يستخدم الإطراء والتملق)",
 "提燈": "فانوس صيني (فانوس ورقي قابل للطي بألوان زاهية؛ يستخدم لأغراض الزينة)"
}
