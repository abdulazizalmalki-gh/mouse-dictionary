 "抽冬": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "抽出": "استخراج, خلع (عملية إخراج شيء ما (خاصة باستخدام الجهد أو القوة))\nمثال: أعطاها طبيب الأسنان تخديراً موضعياً قبل الخلع / اختيار, انتقاء (فعل الاختيار أو الانتقاء)\nمثال: كان اختيارك للألوان غير موفق",
 "抽出法": "أخذ عينات, معاينة ((إحصاء) اختيار عينة مناسبة للدراسة)",
 "抽出物": "مُقْتَطَف",
 "抽挿": "مِدَكّ",
 "抽筒子": "مستخرج الخرطوش (آلية في سلاح ناري تسحب غلاف القذيفة الفارغ من الغرفة وتمرره إلى اللافظ)",
 "抽苔": "مِصْمَال",
 "抽象": "تَجْرِيد, كِيَان مُجَرَّد (مفهوم عامّ يُستخلَص بانتزاع السمات المشتركة من أمثلة محدّدة)",
 "抽象主義": "تجريدية, فن تجريدي (نوع تجريدي من الفن؛ يعتمد المحتوى الفني على الشكل الداخلي بدلاً من التمثيل…)",
 "抽象化": "تَجْرِيد, كِيَان مُجَرَّد (مفهوم عامّ يُستخلَص بانتزاع السمات المشتركة من أمثلة محدّدة)",
 "抽象名詞": "اِسْم مَعْنًى (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه…)\nمثال: ما اسم حصان توم؟",
 "抽象性": "تَجْرِيد, مَعْنَوِيَّة (صفة النظر إلى الشيء بمعزل عن مثال أو كائن محدد)",
 "抽象概念": "تَجْرِيد, كِيَان مُجَرَّد (مفهوم عامّ يُستخلَص بانتزاع السمات المشتركة من أمثلة محدّدة)",
 "抽象的": "مُلَخَّص, حاصِل",
 "抽象絵画": "تجريدية, فن تجريدي (نوع تجريدي من الفن؛ يعتمد المحتوى الفني على الشكل الداخلي بدلاً من التمثيل…)",
 "抽象美術": "تجريدية, فن تجريدي (نوع تجريدي من الفن؛ يعتمد المحتوى الفني على الشكل الداخلي بدلاً من التمثيل…)",
 "抽象芸術": "تجريدية, فن تجريدي (نوع تجريدي من الفن؛ يعتمد المحتوى الفني على الشكل الداخلي بدلاً من التمثيل…)",
 "抽象表現主義": "تعبيرية تجريدية, رسم حركي (مدرسة رسم في نيويورك تتميز بالتجريدات التي تم إنشاؤها بحرية؛ أول مدرسة مهمة…)",
 "抽送": "مِدَكّ",
 "抽選": "يَانَصِيب",
 "抽選会": "يَانَصِيب",
 "担い": "حَمَلَ (رَفَعَ، أَقَلَّ)\nمثال: حمل سامي سلاحه.",
 "担い手": "حامل, ناقل (شخص تتضمن وظيفته حمل شيء ما)\nمثال: نُقلت السندات بواسطة حامل / داعم رياضي (داعم للأعضاء التناسلية يرتديه الرجال الذين يمارسون تمارين شاقة)\nمثال: مساعدي الذي لا يقدر بثمن",
 "担う": "كَتِف, كِتْف / دُبّ",
 "担ぎ": "نَاقِل\nمثال: يبدو أنني حامل.",
 "担ぎだす": "رَفَعَ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ)\nمثال: رفع سامي نظارته.",
 "担ぎ上げる": "رَفَعَ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ)\nمثال: رفع سامي نظارته.",
 "担ぎ出す": "رَفَعَ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ)\nمثال: رفع سامي نظارته.",
 "担ぎ屋": "صاحب مقالب, مخادع مازح (شخص يقوم بتدبير المقالب والمزاح العملي ضد الآخرين) / جَوَّال, بَائِع مُتَجَوِّل (صيغة مبالغة على وزن فَعَّال من الفعل جَالَ؛ كثير التجوّل، دائم التنقُّل من مكان…)\nمثال: اشتريت جوال مستعمل.",
 "担ぐ": "كَتِف, كِتْف / خَدَعَ, غَشَّ (غَشَّ، مَكَرَ؛ خَادَعَ شخصًا: خدعه بشكل مستمر أو بطريقة خفية)\nمثال: هذه خدعة قديمة.",
 "担任の先生": "غرفة الصف الرئيسي (فصل دراسي يجتمع فيه جميع الطلاب في صف معين (أو في قسم من صف) في أوقات معينة تحت…)",
 "担体": "نَاقِل\nمثال: يبدو أنني حامل.",
 "担保": "أَمْن, أَمَان (وَثِقَ به وأرْكَنَ إليه)\nمثال: اتصل زيري بالأمن. / ضَمَان, ضَمَانَة (مَصْدَرُ ضَمِنَ؛ كَفَالَة)\nمثال: لا أستطيع ضمان أي شيء.",
 "担保権": "حق الضمان, مصلحة الضمان (أي مصلحة في ممتلكات تضمن سداد التزام)",
 "担保物件": "مُتَرَتِّب, مُصَاحِب (يحدث بالتزامن مع شيء آخر أو نتيجةً له)\nمثال: أبناء العمومة هم أقارب جانبيون",
 "担保責任": "ضَمَان, ضَمَانَة (مَصْدَرُ ضَمِنَ؛ كَفَالَة)\nمثال: لا أستطيع ضمان أي شيء.",
 "担子器": "دعامة (بنية صغيرة على شكل هراوة تحمل عادةً أربعة أبواغ دعامية في نهايات نتوءات دقيقة…)",
 "担子菌": "دِعَامِيّ",
 "担子菌類": "دِعَامِيّ",
 "担当大臣": "منصب وزاري, وزير في الحكومة (وظيفة وزير كبير يكون عضواً في مجلس الوزراء)",
 "担当官": "ضابط حالة (عميل يعمل أيضًا كموظف رسمي في جهاز استخبارات)",
 "担当者": "مُلَامَسَة, لَمْسَة",
 "担当部長": "مُدِير, مُدِيرَة (الشخص الذي أدار، جمعه مُدِيرُون ومُدِيرِين؛ مهنة يتولى صاحبها إدَارَة شؤون جهة…)\nمثال: زيري هو المدير.",
 "担持": "دَعَمَ, دَعَّمَ (• دَعَمَهُ، كمنَعهُ: مالَ فأقامَهُ)\nمثال: ياني هنا لدعم ريمة.",
 "担架": "نَقَّالَة, مِحَفَّة",
 "担送車": "نَقَّالَة, مِحَفَّة",
 "拇印": "بصمة الإبهام (بصمة إصبع مأخوذة من الإبهام (خاصة من باطن الإبهام))",
 "拇指": "إِبْهَام (الإِصْبَعُ الغليظةُ الخامسةُ من أَصابع اليد والرِّجل، وهي ذات سُلامَيَيْن…)",
 "拇趾": "إبهام القدم (الإصبع الأول الأكبر والأكثر تداخلًا في القدم)",
 "拈くる": "برم, دوران سريع (عملية الدوران بسرعة)\nمثال: أدار الكرنك بقوة / تَغَيَّرَƒ\nمثال: أنا غير متفاجئ.",
 "拈華微笑": "صَرِيح, مُبَاشِر (صريح ومباشر بلا تحفظ أو مواربة)\nمثال: أخذني جانباً لحديث من القلب للقلب",
 "拉ぐ": "هَرَسَ (سَحَقَ أو دَكَّ شيئًا بقوة حتى يتفتت؛ طَحَنَ أو فَتَّتَ شيئًا) / اِسْتَبَدَّ (حزم ولم يتردد في اتخاذ القرار وتنفيذه؛ (في السياسة) حكم بنظام استبدادي)",
 "拉致": "اِخْتِطَاف",
 "拉致る": "اِخْتَطَفَ (أخذ شخصا بالغَصْب وقاده إلى مكان وحَبَسَه عن الرجوع)\nمثال: من اختطف دميتري؟ / جَرَّ (جَرَّ الحيوانَ وغيرَه: جذبه وسحبه؛ جَرَّ أذيالَه: تبختر، زها بنفسه، اختال)\nمثال: اضطررت إلى جر سامي.",
 "拉薩": "لَاسَا",
 "拍": "نَبْض\nمثال: ضرب سامي زوجته.",
 "拍出": "إخراج, طرد (فعل الطرد أو القذف أو الإخراج)\nمثال: طرد مثيري الشغب من قبل الشرطة",
 "拍動": "نَبْض, نَبْضُ القَلْب",
 "拍子": "وَقْت (\"بَقِيَ وَقْتاً عِنْدَهُ \" : أَيْ مِقْدَاراً مِنَ الزَّمَنِ؛ \"جَاءَ فِي…)\nمثال: حان وقت الذهاب. / نَبْض\nمثال: ضرب سامي زوجته. / عَزْم",
 "拍子抜け": "انحدار في الأسلوب, هبوط مفاجئ (تغيير من موضوع جاد إلى موضوع مخيب للآمال)\nمثال: النهاية المخيبة لمهنة رائعة",
 "拍子記号": "الميزان الموسيقي, توقيع الوقت (تدوين موسيقي يشير إلى عدد النبضات في المقياس ونوع النوتة التي تأخذ نبضة)",
 "拍手": "تَصْفِيق",
 "拍手を送る": "صَفَّقَ",
 "拍手喝采": "تَصْفِيق",
 "拍板": "آلة إيقاعية (آلة موسيقية يتم فيها إنتاج الصوت عن طريق ضرب شيء بآخر)",
 "拍節": "نَبْض, نَبْضَة",
 "拍車": "مِهْمَاز / تَسَارُع (عَجَلَة، تزايُد السرعة بالنسبة إلى الزمن في جسم من الأَجسام المتحرِّكة…)\nمثال: تسارع السائق بسيارته.",
 "拍車がかかる": "شَجَّعَ (حفَّز شخصًا أو دعمه لتحقيق هدف أو القيام بعمل؛ بثَّ الحماس أو الثقة في نفس شخص)\nمثال: شجع سامي ليلى لتفعل ذلك.",
 "拍車が掛かる": "شَجَّعَ (حفَّز شخصًا أو دعمه لتحقيق هدف أو القيام بعمل؛ بثَّ الحماس أو الثقة في نفس شخص)\nمثال: شجع سامي ليلى لتفعل ذلك.",
 "拍車をかける": "مِهْمَاز",
 "拍車を掛ける": "مِهْمَاز",
 "拐かす": "اِخْتَطَفَ (أخذ شخصا بالغَصْب وقاده إلى مكان وحَبَسَه عن الرجوع)\nمثال: من اختطف دميتري؟",
 "拐取": "اِخْتِطَاف",
 "拐引": "اِخْتَطَفَ (أخذ شخصا بالغَصْب وقاده إلى مكان وحَبَسَه عن الرجوع)\nمثال: من اختطف دميتري؟",
 "拒ぎ": "دِفَاع, حِمَايَة",
 "拒む": "رَفَضَ (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟ / مَنَعَ (حَرَمَ، ضد أَعْطَى؛ كَفَّ عنه وحَمَاه)\nمثال: تساهم جذور أشجار المنغروف في منع حدوث انجراف التربة.",
 "拒否": "إِنْكَار, رَفْض",
 "拒否る": "رَفَضَ (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟",
 "拒否処分": "رَدّ (صَرَفَ، أَرْجَعَ؛ أَعَادَ، أَرْجَعَ. (يتعدى بإلى))\nمثال: اليوم هناك برد.",
 "拒否反応": "رَفْض, إِبَاء (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟",
 "拒否権": "نَقْضْ (هَدَمَ أو أَبْطَلَ؛ خَالَفَ أو تَرَاجَعَ في الوعد أو العهد)",
 "拒否者": "محتج, معارض (شخص يعارض سياسة راسخة)",
 "拒止": "إِنْكَار, رَفْض",
 "拒絶": "إِنْكَار, رَفْض",
 "拒絶反応": "رَفْض, إِبَاء (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟",
 "拒食症": "قَهَم",
 "拓く": "مَفْتُوح\nمثال: فتح الباب آليا.",
 "拓本": "احتكاك, فرك (الجهد المبذول في تحريك جسم فوق آخر مع الضغط)",
 "拓植": "اِسْتِعْمَار",
 "拓殖": "اِسْتِعْمَار",
 "拗ける": "منحنى",
 "拗じくれる": "منحنى",
 "拗ねる": "بوز, حرد (مزاج أو إظهار للترفع العبوس أو الانسحاب)\nمثال: بقي في المنزل في حالة حرد",
 "拗ね者": "كَلْبِيّ",
 "拗らす": "تَعَقَّدَ, عَقَّدَ",
 "拗らせる": "تَعَقَّدَ, عَقَّدَ",
 "拗れ": "تَعْقِيد",
 "拘う": "شَارَكَ, سَاهَمَ",
 "拘らう": "شَارَكَ, سَاهَمَ",
 "拘らず": "رَغْم أَنَّ, رُغْم أَنَّ ((رَغَمَ) رَغْمًا، ومَرْغَمًا، ومَرْغَمَةً: ذَلَّ؛ (رَغَمَ) ذل عن كَرْه. يقال…)\nمثال: إنه سعيد رغم فقره. / بِغَضِّ ٱلنَّظَر عَن, دُونَ الاِهْتِمَام بِـ (البُغْض ضدّ الحبّ ، بغَض جَدُّك:كتعس جدّك،ونعِمَ الله بك عيناً وبغَض بعدوّك…)\nمثال: سأذهب بغض النظر عن مجيئه.",
 "拘り": "هَوَس / تَذَمَّرَ, اِشْتَكَى / اختصاص, تخصص (مجال العمل الخاص الذي اتخذته كمسار مهني)\nمثال: تخصصه هو أمراض الجهاز الهضمي",
 "拘り合う": "شَارَكَ, سَاهَمَ",
 "拘る": "صخب, ضجة (اضطراب نشط وسريع)\nمثال: لم يرد إثارة جلبة / أَصَرَّ (لواه وشدّه وربطه؛ أَصَرَ الشيءَ: كَسَرَهُ وعَطَفه)\nمثال: أصر على الأفضل. / شَارَكَ, سَاهَمَ / خَصَّ (رمى شيئًا صغيرًا، مثل الحصى، بدقة وبسرعة؛ قذف شيئًا بعيدًا بحركة سريعة)\nمثال: لخص التقرير في صفحة. / غُصَيْن\nمثال: لا تمسك العصا من الوسط.",
 "拘わらず": "رَغْم أَنَّ, رُغْم أَنَّ ((رَغَمَ) رَغْمًا، ومَرْغَمًا، ومَرْغَمَةً: ذَلَّ؛ (رَغَمَ) ذل عن كَرْه. يقال…)\nمثال: إنه سعيد رغم فقره. / بِغَضِّ ٱلنَّظَر عَن, دُونَ الاِهْتِمَام بِـ (البُغْض ضدّ الحبّ ، بغَض جَدُّك:كتعس جدّك،ونعِمَ الله بك عيناً وبغَض بعدوّك…)\nمثال: سأذهب بغض النظر عن مجيئه.",
 "拘わる": "صخب, ضجة (اضطراب نشط وسريع)\nمثال: لم يرد إثارة جلبة / أَصَرَّ (لواه وشدّه وربطه؛ أَصَرَ الشيءَ: كَسَرَهُ وعَطَفه)\nمثال: أصر على الأفضل.",
 "拘引": "تَوْقِيف, اِعْتِقَال\nمثال: اعتقل لقيادته و هو سكران.",
 "拘引状": "اِسْتِدْعَاء (دَعْوَةً؛ طَلَب الْمُثُولِ)\nمثال: أراد توم استدعاء الشرطة، ولكن ماري لم تسمح له.",
 "拘束": "تَقْيِيد, اِقْتِصَار",
 "拘束具": "سبت, سلة بغطاء (سلة عادة ما يكون لها غطاء)",
 "拘束名簿式比例代表制": "تَمْثِيل نِسْبِيّ (تمثيل جميع الأحزاب بما يتناسب مع تصويتهم الشعبي)",
 "拘束衣": "سترة تقييد, قميص المجانين (رداء يشبه السترة يستخدم لربط الذراعين بإحكام ضد الجسم كوسيلة لتقييد شخص عنيف)\nمثال: انشقوا لأن الرقص الروسي كان في قيد صارم",
 "拘留": "حَبْس (مَنَعَ الشيءَ عن الفعلِ؛ أَمْسَكَ الشيءَ، قَبَضَ عَلَيْهِ)\nمثال: هو,البارحة حرر من الحبس.",
 "拘禁": "تَوْقِيف",
 "拘禁刑": "حَبْس, سَجْن (مَنَعَ الشيءَ عن الفعلِ؛ أَمْسَكَ الشيءَ، قَبَضَ عَلَيْهِ)\nمثال: هو,البارحة حرر من الحبس.",
 "拘禁者": "أسير, أسيرة (اَلْأَسِيرُ هُوَ مَنْ أُسِرَ فِي مَعْرَكَةٍ حَيّّا فَسُجِنَ إِلَى حِينٍ…)\nمثال: أنا بريء وأسير حرب.",
 "拘縮": "تقلص (انقباض غير طبيعي ودائم عادة للعضلة)",
 "拘置": "تَوْقِيف",
 "拘置所": "سِجْن (وضع شخصًا أو شيئًا في السجن أو الحبس؛ قيّد حرية شخص أو حركة شيء)\nمثال: دخل سامي السجن.",
 "拙": "فَقِير / أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك…)\nمثال: لم تقصد أي أذى.",
