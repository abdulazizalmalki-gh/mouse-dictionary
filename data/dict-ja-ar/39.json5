 "指": "إِصْبَع (عضو مستطيل ينشعِب من طرف الكفّ أو القدم) / بَنَان (أَطْرَافُ الأَصَابِعِ) / صَبَّعَ ((صَبَعَ) به، وصَبَعَ عليه يَصْبَعُ صَبْعًا: أشار نحوه بِإِصبَعِهِ سخريةً؛ (صَبَعَ) في الشيءِ: أَدخل إصبَعَه فيه)\nمثال: كان أول ما لفت انتباهه هي بصمة الإصبع على الزجاج. / بَيْنَ (ظرف مكان بمعنى وَسْط)\nمثال: مصيري بين يديك. / إعاقة, عرقلة (فعل الإعاقة أو العرقلة أو المنع) / عائق, مانع (أي عائق يعرقل أو يكون مرهقاً) / عائق, عقبة (شيء غير مادي يتداخل مع أو يؤخر العمل أو التقدم)",
 "指さし": "نُقْطَة (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه) / مَوْقِع (موضع الوُقُوع؛ الموضع الذي حَدَثَ أو يحدث فيه حادث) / أَشَارَ\nمثال: هذه هي نقطة ضعفه.",
 "指ざわり": "لَمَسَ (اتصل بشيء أو شخص بشكل مباشر بواسطة جزء من الجسم مثل اليد، التواصل الحسي أو المعنوي مع شيء ما؛ يدل على التواصل، سواء كان ماديًا أو معنويًا، مع شيء ما) / لَمْسَة, مُلَامَسَة / لَمْس (اتصل بشيء أو شخص بشكل مباشر بواسطة جزء من الجسم مثل اليد، التواصل الحسي أو المعنوي مع شيء ما؛ يدل على التواصل، سواء كان ماديًا أو معنويًا، مع شيء ما)\nمثال: إياك ولمس شطيرتي!",
 "指し": "بَيْنَ (ظرف مكان بمعنى وَسْط)\nمثال: مصيري بين يديك. / إعاقة, عرقلة (فعل الإعاقة أو العرقلة أو المنع) / عائق, مانع (أي عائق يعرقل أو يكون مرهقاً) / عائق, عقبة (شيء غير مادي يتداخل مع أو يؤخر العمل أو التقدم) / مِسْطَرَة (أداة تستخدم لقياس الأطوال أو رسم الخطوط المستقيمة؛ خط مستقيم تحدده مِسطَرة أو بُعد محدد) / حَاكِم (حَاكَمَ القاضي فلانا: أقام عليه محكمة ليرى ما إذا كان مجرما أم لا؛ حَاكَمَ فلانٌ فلانا: رفع عليه قضية؛ اشتكى عليه عند القضاء فأقاموا محكمة للحكم في الأمر)\nمثال: استعارت المسطرة.",
 "指し手": "حَرُكَ, تَحَرَّكَ (غَيَّرَ مَوْضِعَهُ أو مَكَانَهُ أو حَالَه؛ حَرُكَ الوَلَدُ : تَحَرَّكَ، أَوْ خَرَجَ عَنْ سُكُونِهِ) / اِنْتَقَلَ, تَحَلْحَلَ\nمثال: لقد أوقفنا حركة المرور.",
 "指し棒": "مُؤَشِّر",
 "指し物": "أعمال الموبيليا, صناعة الخزائن (حرفة صنع الأثاث (خاصة الأثاث عالي الجودة)) / صناعة الخزائن (أعمال خشبية منتهية يدوياً بواسطة صانع خزائن) / دَبُّوس / علم الدولة (علم يظهر جنسيته) / ألوان (شعار مميز)\nمثال: أعلنت ربطة عنقه عن ألوان مدرسته",
 "指し物師": "صانع الأثاث, صانع الخزائن (نجار متخصص في صنع الأثاث)",
 "指し示す": "دَلَّ عَلَى, رَمَزَ إِلَى (مَعِدَة، بَطْن؛ قَلْب)\nمثال: بدل سامي ملابسه.",
 "指し縄": "دبوس التوازن (أي من الأجنحة الخلفية الضامرة للحشرات ثنائية الأجنحة؛ تستخدم للحفاظ على التوازن أثناء الطيران) / بلوزة برباط عنق, هالتر توب (توب نسائي يربط خلف الظهر والرقبة ويترك الظهر والذراعين مكشوفين) / رسن, مقود (غطاء رأس من الحبل أو القماش للحصان، مع حبل للقيادة) / حبل المشنقة (حبل يستخدمه الجلاد لإعدام الأشخاص المحكوم عليهم بالموت شنقاً)",
 "指す": "نُقْطَة (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه) / مَوْقِع (موضع الوُقُوع؛ الموضع الذي حَدَثَ أو يحدث فيه حادث) / أَشَارَ\nمثال: هذه هي نقطة ضعفه. / رَشَّحَ, عَيَّنَ (اقتَرَح شخصًا أو جهةً ليكون مرشَّحًا لمنصب أو مهمة؛ جعَل شيئًا يرشُح أو يُصفّى) / دَلَّ عَلَى, رَمَزَ إِلَى (مَعِدَة، بَطْن؛ قَلْب)\nمثال: بدل سامي ملابسه. / لَعِبَ, لعب (فعل شيئا للتسلية والترفيه، شَارَكَ في لعبة) / عَزَفَ, شَغَّلَ (والمعزف :الملاهي واحدها معزف ومعزفة) / دَوْر (جَعَله يَدُور؛ جَعَلَه مُدَوَّر) / مَسْرَحِيَّة / مَسْرَح, مَسْرَحِيَّة\nمثال: لعب زيري التنس.",
 "指ぬき": "كُشْتُبَان, كُسْتِبَان",
 "指の節": "بُرْجُمَة, مَفْصِل",
 "指をさす": "اِغْتَابَ, أَبَرَ",
 "指を差す": "اِغْتَابَ, أَبَرَ",
 "指を指す": "اِغْتَابَ, أَبَرَ",
 "指サック": "غطاء الإصبع, كشتبان واقٍ (غلاف يلبس لحماية الإصبع)",
 "指了図": "نهاية اللعبة (المراحل النهائية من لعبة الشطرنج بعد إزالة معظم القطع من الرقعة) / مرحلة نهائية, نهاية اللعبة (المراحل النهائية لعملية تفاوض ممتدة)\nمثال: المرحلة النهائية الدبلوماسية",
 "指事": "رمز لفظي, لوغوغراف (رمز مكتوب واحد يمثل كلمة أو عبارة كاملة دون الإشارة إلى نطقها)",
 "指令": "تَرْتِيب, نِظَام (تنظيم الأشياء أو الأحداث في تسلسل معين أو وضعها في نظام؛ إعداد أو تجهيز شيء لتحقيق غاية معينة) / أَمْر, حُكْم (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة) / طَلَب (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى)) / جَمَاعَة (العَدَد الكثير من النَاس أو الحَيْوَان أو النَبَات أو غيره. المَجْمُوعَة؛ طَائِفَة من الناس التي يجمعها مكان و بيئة واحدة أو تتشارك اهداف و غايات واحدة) / وِسَام / رُتْبَة (رُتْبَة، بضم الراء؛ رَتْبَة، بفتح الراء) / أَمَرَ (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة) / طَلَبَ, حَجَزَ (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى))\nمثال: أعاد زيري ترتيب المطبخ كلية.",
 "指令言語": "لغة الأوامر, لغة الاستعلام (لغة مصدر تتكون من مشغلات إجرائية تستدعي وظائف ليتم تنفيذها)",
 "指使い": "تلمس, لمس بالأصابع (لمس شيء ما بالأصابع) / ترقيم الأصابع (وضع الأصابع لعزف نغمات مختلفة على آلة موسيقية)",
 "指先": "بَنَان, أُنْمُلَة (أَطْرَافُ الأَصَابِعِ)\nمثال: لبنان دولة صغيرة. / إِصْبَع (عضو مستطيل ينشعِب من طرف الكفّ أو القدم) / إِصْبَع اَلْقَدَم (عضو مستطيل ينشعِب من طرف الكفّ أو القدم)\nمثال: كان أول ما لفت انتباهه هي بصمة الإصبع على الزجاج.",
 "指入れ": "تلمس, لمس بالأصابع (لمس شيء ما بالأصابع) / ترقيم الأصابع (وضع الأصابع لعزف نغمات مختلفة على آلة موسيقية)",
 "指南": "تَعْلِيم (الأوامر والنواهي التي يحددها دِين ما أو مَذْهَب ما. يُجمع جَمْع تَكْسِير على تَعَالِيم؛ ما دون الأمْر المُلْزِم والمستدعي للعقوبة وفوق الطَلَب الإختياري. أكثر ما يستخدم بصيغة الجمع تَعْلِيمَات) / أَمْر (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة)\nمثال: هو بارع في التعليم.",
 "指南役": "مُعَلِّم, مُعَلِّمَة (من يمتهن التعليم، مُدَرِّس)\nمثال: هي أصبحت معلمة.",
 "指南所": "مَدْرَسَة, مَكْتَب (الموضع الذي تُدَرَّس فيه العلوم؛ البناء فيه عدة غرف تُدَرَّسُ فيها العلوم وتمنح شهادة رسمية بعد إكمال الدروس) / كُلِّيَّة, جَامِعَة (مصدر صناعيّ من كُلّ؛ شمول، مجموع من الأوّل إلى الآخر) / قِسِم (فَرَّقَ أو قَسَّمَ الشَّيءَ إلى أجزاء أو أجزاء مختلفة؛ أَحْلَفَ، أَي جَعَلَ يَحْلِفُ على أمرٍ ما) / مَدْرَسَة (الموضع الذي تُدَرَّس فيه العلوم؛ البناء فيه عدة غرف تُدَرَّسُ فيها العلوم وتمنح شهادة رسمية بعد إكمال الدروس)\nمثال: لا أحب المدرسة.",
 "指南書": "دَلِيل, كُتَيِّب",
 "指南番": "مُعَلِّم, مُعَلِّمَة (من يمتهن التعليم، مُدَرِّس)\nمثال: هي أصبحت معلمة.",
 "指原": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "指名": "تسمية, تعيين (فعل وضع شخص في منصب غير انتخابي) / تسمية (الفعل اللفظي للتسمية)\nمثال: كان يجب الموافقة على التعيين من قبل اللجنة بأكملها / طَلَبَ (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى)) / طَلَب, مَسْأَلَة (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى))\nمثال: طلب زيري ورودا.",
 "指名ドライバー": "سائق مُعَيَّن, سائق مُكَلَّف (عضو في مجموعة يتم تعيينه للامتناع عن الكحول ليكون رصيناً عندما يحين وقت القيادة إلى المنزل)",
 "指名手配": "إعلان مطلوبين, ملصق مطلوبين (إعلان عام من قبل وكالة إنفاذ القانون برغبتهم في استجواب أو اعتقال شخص ما)",
 "指名打者": "ضارب مخصص (لاعب كرة يتم تعيينه للضرب بالمضرب بدلاً من رامي الكرة)",
 "指名投票": "تَفَقُّدٌ / تَفَقُّدات",
 "指名通話": "شخصاً لشخص, فرداً لفرد ((لشخصين) في لقاء مباشر) / مُبَاشِر, مِنْ شَخْصٍ لِآخَر (ينطوي على تواصل أو اتّصال مباشر بين الأشخاص)\nمثال: فضل تسوية الأمر فرداً لفرد",
 "指名運転者": "سائق مُعَيَّن, سائق مُكَلَّف (عضو في مجموعة يتم تعيينه للامتناع عن الكحول ليكون رصيناً عندما يحين وقت القيادة إلى المنزل)",
 "指向": "نُقْطَة (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه) / مَوْقِع (موضع الوُقُوع؛ الموضع الذي حَدَثَ أو يحدث فيه حادث) / أَشَارَ\nمثال: هذه هي نقطة ضعفه. / إِرْشَادِيّ, تَوْجِيهِيّ (يُظهر الطريق بالقيادة والتوجيه؛ يفرض اتجاهاً) / اتجاهي (متعلق بـ أو يشير إلى الاتجاهات في الفضاء) / توجيهي (متعلق بالاتجاه نحو هدف (غير مكاني))\nمثال: ميكروفون اتجاهي",
 "指向性": "اتجاهية, توجيهية (خاصية الميكروفون أو الهوائي بكونه أكثر حساسية في اتجاه واحد من الآخر) / توجيهية (صفة التوجيه أو القدرة على التوجيه)\nمثال: تلقى الهوائي إشارات دون توجيهية / عمد, قصدية (معبر عن النوايا)",
 "指向性アンテナ": "هوائي توجيهي (هوائي يرسل أو يستقبل الإشارات فقط في زاوية ضيقة)",
 "指呼": "أَشَارَ, أَوْمَأَ",
 "指嗾": "إثارة, تحريض (الإشعال المتعمد والمقصود (للمشاكل أو الفتنة)) / تحريض, حث (الفعل اللفظي للحث)",
 "指図": "إرشادات\nمثال: 俺は人事課の馬鹿野郎にあごで指図されるつもりはない。 — لن يحكمني غبي من قسم الموارد البشرية.",
 "指図人": "مُدِير, مُدِيرَة (الشخص الذي أدار، جمعه مُدِيرُون ومُدِيرِين؛ مهنة يتولى صاحبها إدَارَة شؤون جهة ما. جمعه مُدَرَاء)\nمثال: زيري هو المدير. / تَرْتِيب, نِظَام (تنظيم الأشياء أو الأحداث في تسلسل معين أو وضعها في نظام؛ إعداد أو تجهيز شيء لتحقيق غاية معينة) / أَمْر, حُكْم (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة) / طَلَب (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى)) / جَمَاعَة (العَدَد الكثير من النَاس أو الحَيْوَان أو النَبَات أو غيره. المَجْمُوعَة؛ طَائِفَة من الناس التي يجمعها مكان و بيئة واحدة أو تتشارك اهداف و غايات واحدة) / وِسَام / رُتْبَة (رُتْبَة، بضم الراء؛ رَتْبَة، بفتح الراء) / أَمَرَ (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة) / طَلَبَ, حَجَزَ (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى))\nمثال: أعاد زيري ترتيب المطبخ كلية.",
 "指圧": "شياتسو, ضغط بالإبر (علاج الأعراض عن طريق تطبيق الضغط بالأصابع على نقاط ضغط محددة في الجسم)",
 "指孔": "ثقب الإصبع (ثقب لإدخال الإصبع) / ثقب العزف (واحد من سلسلة ثقوب في آلة النفخ الخشبية؛ تتغير درجة الصوت عندما يغطيها الإصبع)",
 "指定": "تحديد الهوية, تعيين (فعل تعيين أو تحديد هوية شيء ما) / تسمية, تعيين (فعل وضع شخص في منصب غير انتخابي) / تسمية, لقب (كلمة أو كلمات تعريفية يُدعى بها شخص أو شيء ويُصنف أو يتميز بها عن الآخرين)\nمثال: كان يجب الموافقة على التعيين من قبل اللجنة بأكملها",
 "指定券": "تَذْكِرَة / تذكرة",
 "指定子": "كلمة دالة, واصف (معلومة مخزنة تُستخدم لتحديد عنصر في نظام تخزين واسترجاع المعلومات) / شكل الكلمة, صيغة (المظهر الصوتي أو الكتابي للكلمة الذي يمكن استخدامه لوصف أو تحديد شيء ما)",
 "指定詞": "رَابِطَة, رَابِط",
 "指導": "إِرْشَاد, هِدَايَة / هِدَايَة, إِرْشَاد",
 "指導医": "معلم جامعي (معلم في جامعة أو كلية (خاصة في كامبريدج أو أكسفورد))",
 "指導員": "مُعَلِّم, مُعَلِّمَة (من يمتهن التعليم، مُدَرِّس)\nمثال: هي أصبحت معلمة.",
 "指導方針": "تَوْجِيهَات",
 "指導標": "عمود إرشادي (عمود يحمل لافتة تعطي الاتجاهات أو تظهر الطريق)",
 "指導的": "رَائِد, قِيَادِيّ (يذهب أو يتقدم في المقدمة؛ يظهر الطريق) / قيادة (نشاط القيادة) / فِي المُقَدِّمَة, مُتَصَدِّر (يَحْتَلُّ المَرْكَزَ الأَوَّلَ أَوْ لَدَيْهِ النَّتِيجَةُ الأَعْلَى فِي مُنَافَسَة) / شريحة رصاص, فاصد (شريط رفيع من المعدن يستخدم لفصل خطوط الحروف في الطباعة)\nمثال: ركبنا في السيارة المتقدمة",
 "指導者": "قَائِد, زَعِيم",
 "指導要領": "تَوْجِيهَات",
 "指導部": "قِيَادَة",
 "指小辞": "ضَئِيل / تَصْغِيرِيّ",
 "指差": "نُقْطَة (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه) / مَوْقِع (موضع الوُقُوع؛ الموضع الذي حَدَثَ أو يحدث فيه حادث) / أَشَارَ\nمثال: هذه هي نقطة ضعفه.",
 "指差し": "نُقْطَة (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه) / مَوْقِع (موضع الوُقُوع؛ الموضع الذي حَدَثَ أو يحدث فيه حادث) / أَشَارَ\nمثال: هذه هي نقطة ضعفه.",
 "指差す": "نُقْطَة (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه) / مَوْقِع (موضع الوُقُوع؛ الموضع الذي حَدَثَ أو يحدث فيه حادث) / أَشَارَ",
 "指弾": "نَقْد, اِنْتِقَاد / فيلم, فيلم سينمائي (شكل من أشكال الترفيه يجسد قصة بالصوت وتسلسل من الصور يعطي وهماً بالحركة المستمرة) / شطبة سريعة, نقر (خط قصير وسريع) / ضربة خفيفة, نقرة (تلامس خفيف وحاد (عادة بشيء مرن))\nمثال: ذهبوا لمشاهدة فيلم كل ليلة سبت",
 "指折": "رَائِد, قِيَادِيّ (يذهب أو يتقدم في المقدمة؛ يظهر الطريق) / قيادة (نشاط القيادة) / فِي المُقَدِّمَة, مُتَصَدِّر (يَحْتَلُّ المَرْكَزَ الأَوَّلَ أَوْ لَدَيْهِ النَّتِيجَةُ الأَعْلَى فِي مُنَافَسَة) / شريحة رصاص, فاصد (شريط رفيع من المعدن يستخدم لفصل خطوط الحروف في الطباعة)\nمثال: ركبنا في السيارة المتقدمة",
 "指折り": "رَائِد, قِيَادِيّ (يذهب أو يتقدم في المقدمة؛ يظهر الطريق) / قيادة (نشاط القيادة) / فِي المُقَدِّمَة, مُتَصَدِّر (يَحْتَلُّ المَرْكَزَ الأَوَّلَ أَوْ لَدَيْهِ النَّتِيجَةُ الأَعْلَى فِي مُنَافَسَة) / شريحة رصاص, فاصد (شريط رفيع من المعدن يستخدم لفصل خطوط الحروف في الطباعة)\nمثال: ركبنا في السيارة المتقدمة",
 "指揮": "أَمْر (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة) / أَمَرَ (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة)\nمثال: إنه أمر مختلف . / قيادة موسيقية (توجيه فرقة موسيقية أو جوقة) / إدارة (طريقة إدارة الأعمال التجارية)",
 "指揮官": "آمِر, مُقَدَّم",
 "指揮所": "المقر العام, مركز القيادة (مقر عسكري يسيطر منه القائد العسكري وينظم القوات)",
 "指揮所演習": "المقر العام, مركز القيادة (مقر عسكري يسيطر منه القائد العسكري وينظم القوات)",
 "指揮棒": "هِرَاوَة / عَصًا (ما يتخذ من خَشَب للتوكؤ أو الضرب؛ تطلق مجازا على عَظْم السَاق وعلى اللِسَان)\nمثال: لا تمسك العصا من الوسط.",
 "指揮者": "قَائِدُ فِرْقَاتٍ مُوسِيقِيَّةٍ / كُمْسَرِيّ, كُمْسَارِيّ / مُوَصِّل كَهْرَبَائِيّ, مُوَصِّل / آمِر, مُقَدَّم",
 "指揮車": "رَئِيس الإِطْفاء, مَأْمُور الإِطْفاء (رئيس إدارة الإطفاء)",
 "指揮隊車": "رَئِيس الإِطْفاء, مَأْمُور الإِطْفاء (رئيس إدارة الإطفاء)",
 "指摘": "إشارة, تبيان (دلالة عن طريق العرض أو التوضيح)",
 "指数": "دَلِيل, فِهْرِس / فِهْرِس (كِتَاب تجمع فيه أسماء الكتب بترتيب يسهل منه إجاد العنوان المراد البحث عنه؛ فَصْل أو بَاب في أول أو آخر الكتاب ترتب فيه الأبواب والفصول ومواضعها ليسهل منه إيجاد المطلوب) / أُسّ",
 "指数化": "ربط بمؤشر, مقايسة (نظام للتنظيم الاقتصادي: يتم ربط الأجور والفائدة بمؤشر تكلفة المعيشة لتقليل آثار التضخم)",
 "指数化方式": "ربط بمؤشر, مقايسة (نظام للتنظيم الاقتصادي: يتم ربط الأجور والفائدة بمؤشر تكلفة المعيشة لتقليل آثار التضخم)",
 "指数的": "أُسِّيّ",
 "指数部": "صِفَة (صُفَّة المَسْجِد هي موضع مُظَلَّل منه بين جدران ثلاثة؛ هي غُرْفَة ذات ثلاث جُدْرَان وسَقْف والإتجاه الرابع مَفْتُوح بلا بِنَاء. تستخدم غالبا للجلوس وتواجه صَحْن البَيْت)\nمثال: محاسبة النفس صفة حميدة.",
 "指数関数": "دَالَّة أُسِّيَّة (دالة يظهر فيها متغير مستقل كأس)",
 "指数関数的": "أُسِّيّ",
 "指文字": "تهجئة بالأصابع (أبجدية من الإشارات اليدوية)",
 "指板": "لوحة الأصابع (شريط ضيق من الخشب على عنق بعض الآلات الوترية (كالكمان أو التشيلو أو الجيتار وغيرها) حيث يتم الضغط على الأوتار ضد الخشب بالأصابع) / لوحة مفاتيح بيانو (مجموعة من المفاتيح على آلة موسيقية) / لوحة أصبعية (عمود إرشادي يشبه اليد بإصبع سبابة يشير للاتجاه) / لوحة حماية الباب (غطاء واقٍ مسطح (على باب أو حائط إلخ) لمنع الاتساخ بالأصابع المتسخة)",
 "指標": "دَلِيل, فِهْرِس / فِهْرِس (كِتَاب تجمع فيه أسماء الكتب بترتيب يسهل منه إجاد العنوان المراد البحث عنه؛ فَصْل أو بَاب في أول أو آخر الكتاب ترتب فيه الأبواب والفصول ومواضعها ليسهل منه إيجاد المطلوب)",
 "指標レジスタ": "سجل الفهرس ((في علم الحاسوب) سجل يستخدم لتحديد عنوان المعامل)",
 "指物": "أعمال الموبيليا, صناعة الخزائن (حرفة صنع الأثاث (خاصة الأثاث عالي الجودة)) / صناعة الخزائن (أعمال خشبية منتهية يدوياً بواسطة صانع خزائن) / دَبُّوس / علم الدولة (علم يظهر جنسيته) / ألوان (شعار مميز)\nمثال: أعلنت ربطة عنقه عن ألوان مدرسته",
 "指物師": "صانع الأثاث, صانع الخزائن (نجار متخصص في صنع الأثاث)",
 "指猿": "آيْآي",
 "指環": "حَلْقَة / خَاتَم, خَاتِم / دَقَّ, رَنَّ (الشيءَ: ضربه وأصدر صوتًا عند الدق؛ البابَ: طرقه) / رَنَّ ((رَنَّ) رنينا: صَوَّت وَصَاح؛ (رَنَّ) إِلَيْهِ: أصغى) / تَلْفَنَ, رَنَّ / مثال: واصل زيري دق الجرس.",
 "指甲花": "حِنَّاء (الحِنَّاءُ : نَبَات من الفصيلة الخثرية التي تتبع رتبة الآسيّات، وَرَقُهُ كورق الرُّمان وعيدانه كعيدانه، له زهر أبيضَ كالعناقيد، وَرَقُهُ أخْضَرُ…؛ خضاب أحمر يُؤخذ من ورق شجرة الحِنَّاء)\nمثال: طائر ابو الحناء هو من اشهر الطيور المغردة التي تعيش في انكلترا .",
 "指矩": "زاوية النجار (زاوية فولاذية يستخدمها النجارون؛ أكبر من الزاوية القائمة العادية)",
 "指示": "قراءة, قراءة العداد (بيان حول حالة فيزيائية معينة يتم تقديمه للمستخدم بواسطة عداد أو أداة مماثلة) / دَلَالَة, مُؤَشِّر (شيء (كمسار عمل) يشار إليه على أنه مناسب أو ضروري) / دلالة, علامة (شيء يخدم للدلالة أو الإيحاء) / استطباب, دعي الاستعمال ((طب) سبب لوصف دواء أو إجراء عملية)\nمثال: لم يصدق قراءة العداد / دليل التعليمات, كتيب التعليمات (دليل يرافق عادة جهازاً تقنياً ويشرح كيفية تثبيته أو تشغيله)",
 "指示す": "دَلَّ عَلَى, رَمَزَ إِلَى (مَعِدَة، بَطْن؛ قَلْب)\nمثال: بدل سامي ملابسه.",
 "指示代名詞": "اسم إشارة, ضمير إشارة (ضمير يشير إلى مرجع مقصود)",
 "指示先": "دَرِيئَة, نِيشَان / هَدَف, مَرْمًى (جاء إلى الهَدَف؛ ارتفع عن الأرض) / يَسْتَهْدِفُ\nمثال: لقد أخطأ الهدف.",
 "指示器": "مُؤَشِّر",
 "指示器を出す": "إِشَارَة",
 "指示子": "مُؤَشِّر",
 "指示板": "لَافِتَة, لَوْحَة",
 "指示棒": "مُؤَشِّر",
 "指示薬": "مُؤَشِّر",
 "指示詞": "عاطفي, معبر عن المشاعر (يميل إلى أو يتميز بالتعبير الصريح عن العاطفة) / إِيضَاحِيّ, بَيَانِيّ (يخدم غرض العرض والتوضيح) / اسم إشارة, ضمير إشارة (ضمير يشير إلى مرجع مقصود)\nمثال: عائلة حنونة ومعبرة عن مشاعرها",
 "指示語": "عاطفي, معبر عن المشاعر (يميل إلى أو يتميز بالتعبير الصريح عن العاطفة) / إِيضَاحِيّ, بَيَانِيّ (يخدم غرض العرض والتوضيح) / اسم إشارة, ضمير إشارة (ضمير يشير إلى مرجع مقصود)\nمثال: عائلة حنونة ومعبرة عن مشاعرها",
 "指穴": "ثقب الإصبع (ثقب لإدخال الإصبع) / ثقب العزف (واحد من سلسلة ثقوب في آلة النفخ الخشبية؛ تتغير درجة الصوت عندما يغطيها الإصبع)",
 "指紋": "بَصْمَة",
 "指紋押捺": "أخذ البصمات (إجراء أخذ انطباعات بالحبر لبصمات أصابع الشخص لغرض تحديد الهوية)",
 "指結び": "أبوسوم (جرابي شجري ليلي له ذيل قابض عارٍ يوجد من جنوب أمريكا الشمالية إلى شمال أمريكا الجنوبية) / أبوسوم, فلنجر (جرابيات شجرية أسترالية صغيرة ذات فراء ولها ذيول طويلة قابضة عادة)",
 "指縄": "دبوس التوازن (أي من الأجنحة الخلفية الضامرة للحشرات ثنائية الأجنحة؛ تستخدم للحفاظ على التوازن أثناء الطيران) / بلوزة برباط عنق, هالتر توب (توب نسائي يربط خلف الظهر والرقبة ويترك الظهر والذراعين مكشوفين) / رسن, مقود (غطاء رأس من الحبل أو القماش للحصان، مع حبل للقيادة) / حبل المشنقة (حبل يستخدمه الجلاد لإعدام الأشخاص المحكوم عليهم بالموت شنقاً)",
 "指行性": "إصبعي السير, مترجل على الأصابع ((عن الثدييات) السير على أصابع القدمين مع رفع الجزء الخلفي من القدم (كما تفعل القطط والكلاب والخيول)) / حيوان إصبعي السير (حيوان يمشي بحيث تلامس أصابع القدم فقط الأرض مثل الكلاب والقطط والخيول)",
 "指触り": "لَمَسَ (اتصل بشيء أو شخص بشكل مباشر بواسطة جزء من الجسم مثل اليد، التواصل الحسي أو المعنوي مع شيء ما؛ يدل على التواصل، سواء كان ماديًا أو معنويًا، مع شيء ما) / لَمْسَة, مُلَامَسَة / لَمْس (اتصل بشيء أو شخص بشكل مباشر بواسطة جزء من الجسم مثل اليد، التواصل الحسي أو المعنوي مع شيء ما؛ يدل على التواصل، سواء كان ماديًا أو معنويًا، مع شيء ما)\nمثال: إياك ولمس شطيرتي!",
 "指話法": "لغة الإشارة (لغة يتم التعبير عنها بإيماءات اليد المرئية)",
 "指貫": "كُشْتُبَان, كُسْتِبَان",
 "指貫き": "كُشْتُبَان, كُسْتِبَان",
 "指輪": "حَلْقَة / خَاتَم, خَاتِم / دَقَّ, رَنَّ (الشيءَ: ضربه وأصدر صوتًا عند الدق؛ البابَ: طرقه) / رَنَّ ((رَنَّ) رنينا: صَوَّت وَصَاح؛ (رَنَّ) إِلَيْهِ: أصغى) / تَلْفَنَ, رَنَّ / مثال: واصل زيري دق الجرس.",
 "指遣い": "تلمس, لمس بالأصابع (لمس شيء ما بالأصابع) / ترقيم الأصابع (وضع الأصابع لعزف نغمات مختلفة على آلة موسيقية)",
 "指金": "حَلْقَة / خَاتَم, خَاتِم / دَقَّ, رَنَّ (الشيءَ: ضربه وأصدر صوتًا عند الدق؛ البابَ: طرقه) / رَنَّ ((رَنَّ) رنينا: صَوَّت وَصَاح؛ (رَنَّ) إِلَيْهِ: أصغى) / تَلْفَنَ, رَنَّ / مثال: واصل زيري دق الجرس.",
 "指針": "إِبْرَة, مِخْيَط / تَوْجِيهَات",
 "指関節": "مفصل بين السلاميات (أي من المفاصل بين سلاميات أصابع اليد أو القدم)",
 "指頭": "بَنَان, أُنْمُلَة (أَطْرَافُ الأَصَابِعِ)\nمثال: لبنان دولة صغيرة.",
 "指骨": "سُلَامَى, سُلَامِيَّة",
 "按じる": "وصية عقارية ((قانون) هبة لممتلكات عقارية بموجب وصية) / وصية عقارية (وصية للتصرف في الممتلكات العقارية) / سكتة دِمَاغِيَّة / لَاطَفَ / مَلَّسَ",
 "按ずる": "وصية عقارية ((قانون) هبة لممتلكات عقارية بموجب وصية) / وصية عقارية (وصية للتصرف في الممتلكات العقارية) / سكتة دِمَاغِيَّة / لَاطَفَ / مَلَّسَ",
 "按司": "رئيس, زعيم (قائد مجموعة من الناس) / زعيم قبيلة, شيخ قبيلة (رئيس قبيلة أو عشيرة)\nمثال: من أقطاب الصناعة",
 "按手": "رِسامة",
 "按手礼": "وضع اليد (وضع الأيدي على رأس الشخص لطلب البركة الروحية في الرسامة المسيحية) / وضع الأيدي (تطبيق يدي المعالج بالإيمان على جسم المريض)",
 "按摩": "تَدْلِيك, تَمْسِيد / دَلَّكَ, مَسَّدَ (دَلَكَ جِسْمَهُ: حَكَّهُ؛ يَدْلُكُ وَجْهَهُ بِالطِّيبِ: يَطْليهِ، يُضَمِّخُهُ) / مُدَلِّك / مَكْفوف",
 "按摩さん": "مُدَلِّكَة",
 "按摩師": "مُدَلِّكَة",
 "按配": "بَهَار, تَابِل / شَرْط (شَرِطَ فلانٌ يَشْرِطِ شَرْطًا: وقع في أَمر عظيمٍ)\nمثال: صرخ ليون: \"شرطة!\" / صِحَّة, عَافِيَة (سَلَامَة؛ سَلَامَة الْجِسْم)\nمثال: أشك في صحة ذلك. / تَرْتِيب (تنظيم الأشياء أو الأحداث في تسلسل معين أو وضعها في نظام؛ إعداد أو تجهيز شيء لتحقيق غاية معينة)\nمثال: أعاد زيري ترتيب المطبخ كلية.",
 "按針": "طَيَّار, طَيَّارَة (اسم فاعل للمبالغة على وزن فَعَّال؛ الذي يقود الطَائِرَة سواء كانت مهنته أم لا)\nمثال: لم توجه أبدا تهمة القيادة غير المسؤولة للطيار.",
 "挌技": "شخصاً لشخص, فرداً لفرد ((لشخصين) في لقاء مباشر) / رَجُلٌ لِرَجُل, فَرْدِيّ (نظام لعب يراقب فيه كل لاعب دفاعيّ لاعبًا هجوميًّا بعينه) / فَرْدِيّ, وَجْهًا لِوَجْه (بين شخصين مباشرةً)\nمثال: فضل تسوية الأمر فرداً لفرد",
 "挑む": "عَالَجَ",
 "挑戦": "تَحَدٍّ, التَّحَدِّي",
 "挑戦状": "تَحَدٍّ, التَّحَدِّي",
 "挑戦的": "تَحَدٍّ, طَمُوح (يَتَطَلَّب اسْتِخْدَام كَامِل القُدُرَات أَوِ المَوَارِد) / مُثِير لِلاِهْتِمَام, مُلْفِت (مستفزّ بطريقة مُقْلِقة ومُحَيِّرة) / مُثِير لِلاهْتِمَام, مُحَفِّز لِلتَّفْكِير (يحفز الاهتمام أو التفكير العميق)",
 "挑戦者": "خصم, غريم (المتسابق الذي تأمل في هزيمته)\nمثال: كان يحترم خصومه",
 "挑発": "إِثَارَة, اِسْتِفْزَاز (إِثَارَة: يُجمع على إثارات)\nمثال: كف عن إثارة غضبي.",
 "挑発的": "مُسْتَفِز / إِيحَائِيّ, مُوحٍ (يميل إلى الإيحاء بشيء غير لائق أو فاحش) / إِيحَائِيّ, تَلْمِيحِيّ (يَمِيلُ إِلَى التَّلْمِيحِ أَوِ الإِيحَاء) / دَالّ, كَاشِف (يشير بوضوح أو يكشف؛ يُستخدَم عادة مع 'على')",
 "挘る": "قَطَفَ (قطفت الدّابّة قِطَافاً: أَبْطَأَتْ، في أمثالهم: (أَقْطَفُ من أرنب)؛ قَطَفَ الزّهرةَ: قطعها، قَطَفَ الثّمرَ: جناه وجمعه)\nمثال: أحب قطف الورود.",
 "挙": "عَمَل (فِعْل، صُنْع؛ وسيلة للكسب، مِهْنَة، حِرْفَة)\nمثال: المهم هو العمل. / تَوْصِيَة",
 "挙げた": "مَاضٍ, الْمَاضِي ((في النحو) زمن نحوي يدل على حدث قد وقع، أو وُجِد قبل الآن بوقت ما)",
 "挙げて": "كُلّ, جَمِيع",
 "挙げる": "أَعْطَى, وَهَبَ (مَنَحَ، نَوَّلَ)\nمثال: أعطى بلده حياته. / جَمَعَ (ضَمَّ، لَمَّ، حَشَدَ؛ في : أَضَافَ أعدادا إلى غيرها)\nمثال: جمع خيل هو خيول. / تَوْقِيف, اِعْتِقَال / اِعْتَقَلَ, قَبَضَ (أمسك الأطراف وربطها، بمعنى عَقَلَ؛ أمسك ووضع في السجن أو المَعْقَل)\nمثال: اعتقل لقيادته و هو سكران. / رَشَّحَ, عَيَّنَ (اقتَرَح شخصًا أو جهةً ليكون مرشَّحًا لمنصب أو مهمة؛ جعَل شيئًا يرشُح أو يُصفّى)",
 "挙げ句の果て": "أخيراً, في الختام (كنتيجة نهائية لتتابع أو عملية) / في النهاية (في نهاية المطاف أو بعد فترة طويلة)",
 "挙って": "كُلّ, جَمِيع",
 "挙上": "منسوب",
 "挙例": "رسم توضيحي (تمثيل مرئي (صورة أو مخطط) يستخدم لجعل موضوع ما أكثر متعة أو أسهل للفهم) / عينة, مثال (عنصر من المعلومات يعتبر نموذجياً لفئة أو مجموعة) / تمثيل, توضيح بالمثال (الإظهار عن طريق المثال) / رسم توضيحي (عمل فني يساعد على جعل شيء ما واضحاً أو جذاباً)\nمثال: يقدم هذا المريض مثالاً نموذجياً للمتلازمة",
 "挙動": "تصرف, سلوك (طريقة التصرف أو التحكم بالنفس) / تصرف, سلوك ((السمات السلوكية) الطريقة التي يتصرف بها الشخص تجاه الآخرين)",
 "挙句": "بعد (يدل على اللحاق في الزمان؛ يكون مضافا، وينصب أو يجر) / خَلْفَ, وَرَاء (بَدَلَ، أَعْقَبَ؛ أَتَى بعده أو جاء مكانه) / بَعْدَمَا\nمثال: و بعد قليل أتى.",
 "挙句の果て": "أَخِيراً",
 "挙尾虫": "شَوَّالَة",
 "挙式": "زفاف, عقد قران (الحدث الاجتماعي الذي تُجرى فيه مراسم الزواج)",
 "挙手": "تَحِيَّة (فعل التحية بكلمات وإيماءات ودية مثل الانحناء أو رفع القبعة) / تَحِيَّة عَسْكَرِيَّة (إيماءة عسكرية رسمية للاحترام) / تحية, سلام (فعل تكريم أو اعتراف مهذب)\nمثال: تحية موسيقية للملحن في عيد ميلاده",
 "挙措": "سُلُوك, تَصَرُّف",
 "挙措進退": "سُلُوك, تَصَرُّف",
 "挙止": "رمان بلي, كرسي تحميل (دعامة دوارة توضع بين الأجزاء المتحركة للسماح لها بالحركة بسهولة) / رسم شعار النبالة, شحنة (شعار النبالة المتمثل في تصميم أو صورة مرسومة على درع) / سلوك, هيئة (أسلوب أو سلوك وقور) / قوام, هيئة (طريقة مميزة لحمل الجسم)\nمثال: وقف بوضعية جيدة",
 "挙用": "مَوْعِد, مِيعَاد (مَوْعِد الإفطار،أي وقت الإفطار؛ لديه مَوْعِد مع صديق)\nمثال: مناد عنده موعد.",
 "挙示": "حَالِيّ, حَاضِر / مَوْجُود, حَاضِر (الذي له وجود) / الزَّمَان, الْحَال / قَدَّمَ, طَرَحَ (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى الرُّسْغَ؛ أنّ لهم سابقةً وفضلاً له عند فلان قَدَمٌ : معروف)\nمثال: أنا موجود لوحدي",
 "挙筋": "عضلة رافعة (عضلة تعمل على رفع جزء من الجسم (مثل الجفن أو الشفة))",
 "挙績": "إجمالي الإيرادات, إجمالي المبيعات (الدخل (بقيم الفواتير) المستلم للبضائع والخدمات خلال فترة معينة)",
 "挙行": "اِحْتِفَال (إقامة مراسم أو فعاليات تعبيرًا عن مناسبة معينة) / اِحْتِفَال, مِهْرَجَان (إقامة مراسم أو فعاليات تعبيرًا عن مناسبة معينة)\nمثال: لم يحضر الاحتفال.",
 "挙証": "بُرْهَان, دَلِيل",
 "挙証責任": "عِبْء الإثْبات, عِبْء البَيِّنة (عِبْء: اسم؛ الحمل الثقيل. \"يحمل على كاهله عبأً\") / التزام بتقديم الدليل, التزامات بتقديم الدليل",
 "挟み": "مِشْبَك / كْلِيبْ / كلاب, مخلب (هيكل للإمساك على طرف القشريات أو مفصليات الأرجل الأخرى) / كماشة, ملقط (أداة يدوية للإمساك تتكون من رافعة مركبة للقبض)",
 "挟み上げる": "قَطَفَ (قطفت الدّابّة قِطَافاً: أَبْطَأَتْ، في أمثالهم: (أَقْطَفُ من أرنب)؛ قَطَفَ الزّهرةَ: قطعها، قَطَفَ الثّمرَ: جناه وجمعه)\nمثال: أحب قطف الورود.",
 "挟み付け": "مَشْبَك",
 "挟み切る": "قصاصة, قُصاصة (عملية القص أو القصقصة) / قُصاصة, نتفة (قطعة صغيرة من أي شيء (خاصة قطعة تم قصها))",
 "挟み虫": "أَبُو مِقَصّ",
 "挟み込む": "أَدْخَلَ",
 "挟む": "مَقْبِض / أَدْخَلَ / لُقْطَة / أَمْسَكَ (حَبَسَ الشيءَ، قَبَضَ عَلَيْهِ. و (يتعدى بالباء)؛ اِمْتَنَعَ بالشيءِ، اِعْتَصَمَ بِه. (يتعدى بالباء)) / مَسَكَ\nمثال: كنت أمسك بالكرة. / مرفأ, ملاذ (مكان للملجأ والراحة والأمان) / مرفأ, ميناء بحري (ميناء محمي حيث يمكن للسفن شحن أو تفريغ البضائع) / أَدْخَلَ / قَاطَعَ / مَرْفَأ, مَرْسَى",
 "挟殺": "بيان ختامي, خلاصة نهائية (ملخص ختامي (كما في عرض قضية أمام محكمة قانونية))",
 "挨拶": "تَحِيَّة (مصدر للفعل \"حَيَّا\"؛ عبارة لفظية أو جسدية تُبدأ بها الرسالة أو المحادثة غرضها التعريف عن وجود قائلها)\nمثال: ألقى زيري تحية. / حَدِيث, خُطْبَة (جَدِيد؛ الخبر عن ما حدث)\nمثال: توقف عن الحديث. / أَجَابَ, رَدَّ (رَدَّ على سُؤالٍ أو طلبٍ؛ أَمْتَثَلَ لِمُطَالَبَةٍ أو دعوةٍ) / إِجَابَة, جَوَاب\nمثال: أجاب ياني فورا. / ثَأْر, اِنْتِقَام ((ثَأَرَ) الْقَتِيلَ وَبِالْقَتِيلِ: أَيْ قَتَلَ قَاتِلَهُ) / اِنْتَقَمَ\nمثال: كل ما فعل سامي كان بداعي الثأر.",
 "挨拶文": "استهلال, تحية الافتتاح (كلمة تحية تستخدم لبدء رسالة) / تَحِيَّة, تَرْحِيب (إقرار أو تعبير عن حسن النية (خاصة عند اللقاء)) / تحية, سلام (فعل تكريم أو اعتراف مهذب)\nمثال: تحية موسيقية للملحن في عيد ميلاده",
 "挨拶状": "بطاقة تهنئة, بطاقة معايدة (بطاقة تُرسل للتعبير عن تحيات شخصية)",
 "挫き": "اِلْتِوَاء",
 "挫く": "اِلْتِوَاء",
 "挫ける": "يَئِسَ, أُحْبِطَ",
 "挫傷": "اِلْتِوَاء",
 "挫創": "رَضّ (رَضَّ يَرُضُّ: رَضًّا؛ رَضَّ الشيء: دقه وطحنه طحنا خشنا)",
 "挫折": "نَكْسَة",
 "挫滅": "سَاحِق, مُدَمِّر (مُدَمِّرٌ مَادِّيًّا أَوْ مَعْنَوِيًّا؛ يُسْتَخْدَمُ غَالِبًا فِي التَّرْكِيبَاتِ) / إخماد, قمع (منع بالقوة؛ القضاء على الشيء بالسلطة أو القوة)\nمثال: قمع الهرطقة",
 "振う": "تَأَرْجَحَ / أُرْجُوحَة, مُرْجِيحَة / تَمْرِين, تَدْرِيب / تَمَرَّنَ / جذل, فانفار ((موسيقى) لحن حيوي قصير يُعزف على الآلات النحاسية) / إشهار, تلويح (فعل التلويح) / زخرفة لفظية (عرض للكلام أو اللغة المنمقة) / حركة استعراضية (إيماءة مبهرجة)\nمثال: دخل على وقع نغمة احتفالية من الأبواق",
 "振とう": "صَدْمَة / صَعْقَة / صَعَقَ",
 "振り": "تَأَرْجَحَ / أُرْجُوحَة, مُرْجِيحَة / ظُهُور (عِيْدُ الظُّهُوْر: عيد للنَصَارَى يُسَمَّى أيضا عيد التَجَلِّي) / مَظْهَر (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / مَظْهَر, شَكْل (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / شَكْل ((شَكَلَ) الأمْرُ يَشْكُلُ شُكُولاً: الْتَبَسَ؛ (شَكَلَ) المريضُ: تماثَلَ)\nمثال: لا أحد لاحظ ظهور الدب. / ادعاء, تصنع (فعل إعطاء مظهر زائف) / حجة, ذريعة (مظهر مصطنع أو مقلد) / ادِّعَاء, تَظَاهُر (صفة زائفة أو لا يمكن دعمها) / تظاهر, لعب تخيلي (لعب فكري خيالي)\nمثال: كان امتثاله مجرد تظاهر / وَضْعِيَّة / طَرِيق, سَبِيل (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من ٱلشَّارِعِ، سَبِيل)\nمثال: أسأل عن الطريق. / مَبْلَغ, مِقْدَار / بَلَغَ / لَحْن (وضع الألحان أو التأليف الموسيقي؛ قرأ النص بلحن أو أداء صوتي مميز)\nمثال: أنا أحب هذا اللحن.",
 "振りかえる": "تَغَيَّرَƒ / غَيَّرَ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به) / تَغْيِير, تَبْدِيل / فَكَّة / بَاقٍ (باقٍ ، الباقِيٌ جمع باقون ( للعاقل ) وبَواقٍ ، مؤ باقية ، جمع مؤ باقيات وبَواقٍ؛ باقٍ إلَى الأبَدِ : خالِدٌ) / تَغْيِير\nمثال: أنا غير متفاجئ.",
 "振りかざす": "رَفَعَ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ)\nمثال: رفع سامي نظارته. / مَارَسَ (ومَرِسَ؛ إله الحرب في الأساطير الرُومِيَّة، وهو المَرِيِّخ، لا يؤنث ولا يجمع)\nمثال: مارس الأمازيغية.",
 "振りかぶる": "إشهار, تلويح (فعل التلويح)",
 "振りたてる": "تمرير, رمي ((رياضة) فعل رمي الكرة لعضو آخر في فريقك) / رمي, هز (حركة مفاجئة) / رمي العملة, قرعة (فعل تقليب العملة)\nمثال: تم إهدار التمريرة",
 "振りまく": "نَثَرَ, تَفَرَّقَ / بَاذِخ, مُسْرِف فِي العَطَاء (بالغ السخاء؛ يُعطي بإسراف ودون حساب) / بَاذِخ, سَخِيّ (يتميّز بالإسراف والوفرة)",
 "振りをする": "اِدَّعَى / زَعَمَ / تَظَاهَرَ (فعل مطاوعة لظَاهَرَ، ظاهرته فتظاهر، يكون بمعنى تعاون فكان كل طرف كظهر الآخر؛ القوم: ولّى كل منهم ظهره للآخر)\nمثال: تظاهر بأنه طبيب.",
 "振り上げる": "رَفَعَ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ)\nمثال: رفع سامي نظارته.",
 "振り付け": "تَصْمِم الرَّقْص",
 "振り付け師": "مُصَمِّمُ رَقْصٍ, مُصَمِّمَةُ رَقْصٍ",
 "振り仮名": "فُورِيغَانَا",
 "振り仰ぐ": "بَحَثَ (طَلَب الشيء في التُرَاب؛ طلب الشيء في أي مكان والتَفْتِيش والتَقَصِّي عنه)\nمثال: بدأ زيري البحث.",
 "振り出": "نقطة البداية (أقرب نقطة حدية) / رَسْم (سَم الشَّيءَ :خطّه رسَم مُربَّعًا/ صورةً/ شكلاً؛ رسَم : كَتَبَ)\nمثال: واصل زيري الرسم. / رَمَى, صَبَّ ((مُتَعَدٍّ بِنَفْسِهِ) جَعَلَهُ يَتَحَرَّكُ فِي الهَوَاءِ)\nمثال: رمى تلك الموزة. / بث, حقن (فعل غرس أو إدخال عنصر أو صفة معدلة معينة) / تسريب ((طب) الإدخال السلبي لمادة (سائل أو دواء أو إلكتروليت) في وريد أو بين الأنسجة (كما عن طريق قوة الجاذبية)) / منقوع, نقع (عملية استخلاص خصائص فعالة معينة (كدواء من نبات) عن طريق النقع أو الغمر (عادة في الماء)) / مستخلص, منقوع (محلول يتم الحصول عليه عن طريق نقع مادة (عادة في الماء))\nمثال: يُعزى النجاح المستمر للفريق إلى الضخ المستمر للمواهب الجديدة",
 "振り出し": "نقطة البداية (أقرب نقطة حدية) / رَسْم (سَم الشَّيءَ :خطّه رسَم مُربَّعًا/ صورةً/ شكلاً؛ رسَم : كَتَبَ)\nمثال: واصل زيري الرسم. / رَمَى, صَبَّ ((مُتَعَدٍّ بِنَفْسِهِ) جَعَلَهُ يَتَحَرَّكُ فِي الهَوَاءِ)\nمثال: رمى تلك الموزة. / بث, حقن (فعل غرس أو إدخال عنصر أو صفة معدلة معينة) / تسريب ((طب) الإدخال السلبي لمادة (سائل أو دواء أو إلكتروليت) في وريد أو بين الأنسجة (كما عن طريق قوة الجاذبية)) / منقوع, نقع (عملية استخلاص خصائص فعالة معينة (كدواء من نبات) عن طريق النقع أو الغمر (عادة في الماء)) / مستخلص, منقوع (محلول يتم الحصول عليه عن طريق نقع مادة (عادة في الماء))\nمثال: يُعزى النجاح المستمر للفريق إلى الضخ المستمر للمواهب الجديدة",
 "振り出し薬": "بث, حقن (فعل غرس أو إدخال عنصر أو صفة معدلة معينة) / تسريب ((طب) الإدخال السلبي لمادة (سائل أو دواء أو إلكتروليت) في وريد أو بين الأنسجة (كما عن طريق قوة الجاذبية)) / منقوع, نقع (عملية استخلاص خصائص فعالة معينة (كدواء من نبات) عن طريق النقع أو الغمر (عادة في الماء)) / مستخلص, منقوع (محلول يتم الحصول عليه عن طريق نقع مادة (عادة في الماء))\nمثال: يُعزى النجاح المستمر للفريق إلى الضخ المستمر للمواهب الجديدة",
 "振り出す": "عَدَد (مِقْدَار مَا يُعَدّ) / مُشْكِل, مَسْأَلَة\nمثال: كم عدد سكان الجزائر؟",
 "振り分け": "قَسَّمَ (فَرَّقَ أو قَسَّمَ الشَّيءَ إلى أجزاء أو أجزاء مختلفة؛ أَحْلَفَ، أَي جَعَلَ يَحْلِفُ على أمرٍ ما)\nمثال: أنا أزين القسم.",
 "振り分ける": "قَسَّمَ (فَرَّقَ أو قَسَّمَ الشَّيءَ إلى أجزاء أو أجزاء مختلفة؛ أَحْلَفَ، أَي جَعَلَ يَحْلِفُ على أمرٍ ما)\nمثال: أنا أزين القسم.",
 "振り切る": "اِنْتَفَضَ / رَفَضَ (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟",
 "振り動かす": "هَزَّ",
 "振り合い": "اهتمام, مراعاة (عمل ينم عن مراعاة وتفكير بالآخرين) / اهتمام بالآخرين, مراعاة (احترام ومراعاة لطيفة للآخرين) / اعتبار, نظر (عملية التفكير المتأني في شيء ما) / اعتبار, حالة (معلومات يجب وضعها في الاعتبار عند اتخاذ قرار)\nمثال: لم يظهر أي مراعاة لمشاعرها / أحوال مالية, ظروف مادية (الوضع المالي للشخص (جيداً كان أو سيئاً)) / حظ, قدر (ظروفك العامة أو حالتك في الحياة (بما في ذلك كل ما يحدث لك))\nمثال: وجد نفسه في ظروف مالية صعبة",
 "振り向く": "اِلْتَفَتَ, اِسْتَدَارَ",
 "振り向ける": "دَارَ, أَدَارَ (المحل يجمع البِنَاء والعَرَصَة. قيل سمي كذلك لدوران الناس به وعليه وحوله. يجمع على دُور؛ المنزل المَبْني. يجمع على دُور) / لَفَّ / قَلَبَ / اِنْقَلَبَ, صَارَ / اِنْعِطَاف / دَوْر, نَوْبَة (جَعَله يَدُور؛ جَعَلَه مُدَوَّر)\nمثال: إذهب إلى الدار. / مُنَاسِب / لَائِق",
 "振り回す": "مَارَسَ (ومَرِسَ؛ إله الحرب في الأساطير الرُومِيَّة، وهو المَرِيِّخ، لا يؤنث ولا يجمع)\nمثال: مارس الأمازيغية. / إِظْهَار, عَرْض / شَاشَة / تَعَسُّف, طُغْيَان / مَسَبَّة, شَتِيمَة / إِيذَاء جَسَدِيّ / اِنْتِهَاك جَسَدِيّ / أَسَاءَ اِسْتِعْمَالَ / آذَى / أَهَانَ, سَبَّ (شخص يكون لئيم لآخر بالكلام) / اِغْتَصَبَ, اِنْتَهَكَ (غَصَبَ؛ زَنَى (بِفُلَانَةٍ) قَهْرًا/غَصْبًا) / خَدَعَ, غَشَّ (غَشَّ، مَكَرَ؛ خَادَعَ شخصًا: خدعه بشكل مستمر أو بطريقة خفية)\nمثال: أهان سامي ليلى بقص شعرها.",
 "振り回る": "تمايل, رفرفة (فعل التحرك ذهاباً وإياباً) / تردد, تلكؤ (فعل التوقف بشكل غير مؤكد) / ملوِّح (شخص يتواصل عن طريق التلويح)\nمثال: كان هناك تردد في كلامه",
 "振り売り": "بازيار, صقار (شخص يربي ويدرب الصقور ويمارس رياضة الصيد بالصقور) / بائع متجول (شخص يتجول لبيع بضائعه (كما في الشوارع أو الكرنفالات))",
 "振り子": "نُوَاس / رَقَّاص / بَنْدُول",
 "振り子時計": "ساعة بندولية (ساعة يتم تنظيمها بواسطة بندول)",
 "振り幅": "سعة, مدى (عِظَم المقدار) / جود, سعة (خاصية الوفرة الغزيرة) / سعة ((في الفيزياء) أقصى إزاحة لموجة دورية) / تَقَلُّب, عَدَم اسْتِقْرَار (الصفة أو الخاصية المتمثلة في كون الشيء غير مستقر ومتردد) / عدم استقرار (عدم موثوقية ناتجة عن كون الشيء غير مستقر) / عدم استقرار (نظام غير مستقر) / اختلال, عدم استقرار (نقص التوازن أو حالة اختلال التوازن)\nمثال: اختلال هرموني",
 "振り当てる": "تعيين شخص لعمل ما",
 "振り払う": "اِنْتَفَضَ",
 "振り捨てる": "اِنْتَفَضَ",
 "振り撒く": "نَثَرَ, تَفَرَّقَ / بَاذِخ, مُسْرِف فِي العَطَاء (بالغ السخاء؛ يُعطي بإسراف ودون حساب) / بَاذِخ, سَخِيّ (يتميّز بالإسراف والوفرة)",
 "振り替": "حَوَّلَ (جَعَلَ الشيءَ غير ما كان؛ نقل الشيء من موضع إلى آخر) / اِنْتِقَال\nمثال: رقصنا حول النار.",
 "振り替え": "حَوَّلَ (جَعَلَ الشيءَ غير ما كان؛ نقل الشيء من موضع إلى آخر) / اِنْتِقَال\nمثال: رقصنا حول النار.",
 "振り替える": "تَغَيَّرَƒ / غَيَّرَ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به) / تَغْيِير, تَبْدِيل / فَكَّة / بَاقٍ (باقٍ ، الباقِيٌ جمع باقون ( للعاقل ) وبَواقٍ ، مؤ باقية ، جمع مؤ باقيات وبَواقٍ؛ باقٍ إلَى الأبَدِ : خالِدٌ) / تَغْيِير\nمثال: أنا غير متفاجئ.",
 "振り替え休日": "يَوْم عُطْلَة (فترة من الزمان تبدأ عند غُرُوب الشمس وتنتهي عند غُرُوب شمس النهار التالي ويشمل اللَيْلَة ونَهَارا. طوله أربع وعشرين سَاعَة؛ النَهَار، يبدأ من طلوع الفَجْر إلى غُرُوب الشَمس، على المجاز)\nمثال: طقس اليوم جميل.",
 "振り混ぜる": "هَزَّ",
 "振り立てる": "تمرير, رمي ((رياضة) فعل رمي الكرة لعضو آخر في فريقك) / رمي, هز (حركة مفاجئة) / رمي العملة, قرعة (فعل تقليب العملة)\nمثال: تم إهدار التمريرة",
 "振り落とす": "اِنْتَفَضَ",
 "振り被る": "إشهار, تلويح (فعل التلويح)",
 "振り込む": "وَدِيعَة / أَوْدَعَ (الثَوْب أو ما أشبه: صانه بأن وضعه في صِوَان أو مكان لا يؤْذَى فيه؛ فلانًا مالًا: دفعه إليه ليكون عنده وديعة. ويكون أيضا بمعنى قبل الوديعة)",
 "振り返る": "اِلْتَفَتَ, اِسْتَدَارَ",
 "振り飛ばす": "اِنْتَفَضَ",
 "振る": "لَوَّحَ, رَفْرَفَ / مَوْج, مَوْجَة / رش, نثر (فعل رش أو طرطشة الماء) / رشراش, زخات خفيفة متفرقة (زخة خفيفة تسقط في بعض المواقع دون غيرها القريبة) / صَبَّ, رَمَى (سَكَبَ، الفرق بين صَبَّ وسَكَب أن الصَبّ يكون متعمدا والسكب قد يكون متعمدا أو خطأ؛ صَبَّ الطعام، أي سكبه في الإناء أو الصحون) / ضِمَاد مِنَ الْجِبْس\nمثال: صب الشاي لضيفك. / رَفَضَ (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟",
 "振るい落す": "اِنْتَفَضَ",
 "振るい落とす": "اِنْتَفَضَ",
 "振るう": "تَأَرْجَحَ / أُرْجُوحَة, مُرْجِيحَة / تَمْرِين, تَدْرِيب / تَمَرَّنَ / جذل, فانفار ((موسيقى) لحن حيوي قصير يُعزف على الآلات النحاسية) / إشهار, تلويح (فعل التلويح) / زخرفة لفظية (عرض للكلام أو اللغة المنمقة) / حركة استعراضية (إيماءة مبهرجة)\nمثال: دخل على وقع نغمة احتفالية من الأبواق",
 "振るった": "مُخْتَلِف / آٰخَر (ضد الأوَّل؛ وهو من يكون ترتيبه بعد الجميع؛ الشيء: مؤخرّه، الجزء الآخير منه)\nمثال: أرني مثالا آخر.",
 "振るまい": "سُلُوك, تَصَرُّف / تَرْفِيه, تَسْلِيَة",
 "振るわない": "كَلِيل",
 "振る舞い": "سُلُوك, تَصَرُّف / تَرْفِيه, تَسْلِيَة",
 "振る舞う": "تَصَرَّفَ / تَصَرَّفَ بِشَكْل, مُؤَدَّب",
 "振れる": "تَأَرْجَحَ / أُرْجُوحَة, مُرْجِيحَة",
 "振れ取り": "حَقٌّ (اسم من الأسماء الحسنى وهو من صفات الله. لا جمع له؛ ضد البَاطِل، العَدْل والحَقِيْقَة والوُجُوْد الثَابِت والصِدْق والذي لا جدال فيه. لا جمع له)\nمثال: الأستاذ على حق.",
 "振れ幅": "سعة, مدى (عِظَم المقدار) / جود, سعة (خاصية الوفرة الغزيرة) / سعة ((في الفيزياء) أقصى إزاحة لموجة دورية) / تَقَلُّب, عَدَم اسْتِقْرَار (الصفة أو الخاصية المتمثلة في كون الشيء غير مستقر ومتردد) / عدم استقرار (عدم موثوقية ناتجة عن كون الشيء غير مستقر) / عدم استقرار (نظام غير مستقر) / اختلال, عدم استقرار (نقص التوازن أو حالة اختلال التوازن)\nمثال: اختلال هرموني",
 "振付": "تَصْمِم الرَّقْص",
 "振付け": "تَصْمِم الرَّقْص",
 "振付け師": "مُصَمِّمُ رَقْصٍ, مُصَمِّمَةُ رَقْصٍ",
 "振付家": "مُصَمِّمُ رَقْصٍ, مُصَمِّمَةُ رَقْصٍ",
 "振付師": "مُصَمِّمُ رَقْصٍ, مُصَمِّمَةُ رَقْصٍ",
 "振仮名": "فُورِيغَانَا",
 "振仰ぐ": "بَحَثَ (طَلَب الشيء في التُرَاب؛ طلب الشيء في أي مكان والتَفْتِيش والتَقَصِّي عنه)\nمثال: بدأ زيري البحث.",
 "振休": "يَوْم عُطْلَة (فترة من الزمان تبدأ عند غُرُوب الشمس وتنتهي عند غُرُوب شمس النهار التالي ويشمل اللَيْلَة ونَهَارا. طوله أربع وعشرين سَاعَة؛ النَهَار، يبدأ من طلوع الفَجْر إلى غُرُوب الشَمس، على المجاز)\nمثال: طقس اليوم جميل.",
 "振作": "اِزْدِهَار, رَخَاء",
 "振出": "نقطة البداية (أقرب نقطة حدية) / رَسْم (سَم الشَّيءَ :خطّه رسَم مُربَّعًا/ صورةً/ شكلاً؛ رسَم : كَتَبَ)\nمثال: واصل زيري الرسم. / رَمَى, صَبَّ ((مُتَعَدٍّ بِنَفْسِهِ) جَعَلَهُ يَتَحَرَّكُ فِي الهَوَاءِ)\nمثال: رمى تلك الموزة. / بث, حقن (فعل غرس أو إدخال عنصر أو صفة معدلة معينة) / تسريب ((طب) الإدخال السلبي لمادة (سائل أو دواء أو إلكتروليت) في وريد أو بين الأنسجة (كما عن طريق قوة الجاذبية)) / منقوع, نقع (عملية استخلاص خصائص فعالة معينة (كدواء من نبات) عن طريق النقع أو الغمر (عادة في الماء)) / مستخلص, منقوع (محلول يتم الحصول عليه عن طريق نقع مادة (عادة في الماء))\nمثال: يُعزى النجاح المستمر للفريق إلى الضخ المستمر للمواهب الجديدة",
 "振出し": "نقطة البداية (أقرب نقطة حدية) / رَسْم (سَم الشَّيءَ :خطّه رسَم مُربَّعًا/ صورةً/ شكلاً؛ رسَم : كَتَبَ)\nمثال: واصل زيري الرسم. / رَمَى, صَبَّ ((مُتَعَدٍّ بِنَفْسِهِ) جَعَلَهُ يَتَحَرَّكُ فِي الهَوَاءِ)\nمثال: رمى تلك الموزة. / بث, حقن (فعل غرس أو إدخال عنصر أو صفة معدلة معينة) / تسريب ((طب) الإدخال السلبي لمادة (سائل أو دواء أو إلكتروليت) في وريد أو بين الأنسجة (كما عن طريق قوة الجاذبية)) / منقوع, نقع (عملية استخلاص خصائص فعالة معينة (كدواء من نبات) عن طريق النقع أو الغمر (عادة في الماء)) / مستخلص, منقوع (محلول يتم الحصول عليه عن طريق نقع مادة (عادة في الماء))\nمثال: يُعزى النجاح المستمر للفريق إلى الضخ المستمر للمواهب الجديدة",
 "振出し薬": "بث, حقن (فعل غرس أو إدخال عنصر أو صفة معدلة معينة) / تسريب ((طب) الإدخال السلبي لمادة (سائل أو دواء أو إلكتروليت) في وريد أو بين الأنسجة (كما عن طريق قوة الجاذبية)) / منقوع, نقع (عملية استخلاص خصائص فعالة معينة (كدواء من نبات) عن طريق النقع أو الغمر (عادة في الماء)) / مستخلص, منقوع (محلول يتم الحصول عليه عن طريق نقع مادة (عادة في الماء))\nمثال: يُعزى النجاح المستمر للفريق إلى الضخ المستمر للمواهب الجديدة",
 "振出す": "عَدَد (مِقْدَار مَا يُعَدّ) / مُشْكِل, مَسْأَلَة\nمثال: كم عدد سكان الجزائر؟",
 "振分け": "قَسَّمَ (فَرَّقَ أو قَسَّمَ الشَّيءَ إلى أجزاء أو أجزاء مختلفة؛ أَحْلَفَ، أَي جَعَلَ يَحْلِفُ على أمرٍ ما)\nمثال: أنا أزين القسم.",
 "振切る": "اِنْتَفَضَ / رَفَضَ (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟",
 "振動": "تَذَبْذُب",
 "振動子": "مذبذب (مولد ينتج ذبذبات صوتية أو تياراً متردداً)",
 "振動数": "تَرَدُّد (الذهاب إلى المكان مرة أخرى إلى نفس المكان بصورة متكررة؛ عدم الاستقرار على رأي معين)\nمثال: قبل ماثيو بتردد.",
 "振動板": "حِجَاب حَاجِز (الغطاء أو الساتر؛ يُطلق مجازا على لباس المرأة الذي يستر جميع جسمها)\nمثال: ارتدت أمها الحجاب. / مرتجف (من يرتجف ويهتز خوفاً)",
 "振合い": "اهتمام, مراعاة (عمل ينم عن مراعاة وتفكير بالآخرين) / اهتمام بالآخرين, مراعاة (احترام ومراعاة لطيفة للآخرين) / اعتبار, نظر (عملية التفكير المتأني في شيء ما) / اعتبار, حالة (معلومات يجب وضعها في الاعتبار عند اتخاذ قرار)\nمثال: لم يظهر أي مراعاة لمشاعرها / أحوال مالية, ظروف مادية (الوضع المالي للشخص (جيداً كان أو سيئاً)) / حظ, قدر (ظروفك العامة أو حالتك في الحياة (بما في ذلك كل ما يحدث لك))\nمثال: وجد نفسه في ظروف مالية صعبة",
 "振向ける": "دَارَ, أَدَارَ (المحل يجمع البِنَاء والعَرَصَة. قيل سمي كذلك لدوران الناس به وعليه وحوله. يجمع على دُور؛ المنزل المَبْني. يجمع على دُور) / لَفَّ / قَلَبَ / اِنْقَلَبَ, صَارَ / اِنْعِطَاف / دَوْر, نَوْبَة (جَعَله يَدُور؛ جَعَلَه مُدَوَّر)\nمثال: إذهب إلى الدار. / مُنَاسِب / لَائِق",
 "振売": "بازيار, صقار (شخص يربي ويدرب الصقور ويمارس رياضة الصيد بالصقور) / بائع متجول (شخص يتجول لبيع بضائعه (كما في الشوارع أو الكرنفالات))",
 "振売り": "بازيار, صقار (شخص يربي ويدرب الصقور ويمارس رياضة الصيد بالصقور) / بائع متجول (شخص يتجول لبيع بضائعه (كما في الشوارع أو الكرنفالات))",
