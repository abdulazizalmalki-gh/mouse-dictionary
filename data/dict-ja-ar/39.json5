 "手付": "وَدِيعَة\nمثال: غادرت المنزل دون أن أودع أهلي.",
 "手付かず": "غَيْر مُتَأَثِّر, غَيْر مُنْقَاد (لم يتأثر أو لم ينقد لتأثير خارجي)\nمثال: بدا دائماً غير متأثر تماماً ورابط الجأش",
 "手付け": "وَدِيعَة\nمثال: غادرت المنزل دون أن أودع أهلي.",
 "手付け金": "وَدِيعَة\nمثال: غادرت المنزل دون أن أودع أهلي.",
 "手付金": "وَدِيعَة\nمثال: غادرت المنزل دون أن أودع أهلي.",
 "手代": "بَائِع, بَائِعَة",
 "手代木": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "手伝い": "مُسَاعِد, مُسَاعِدَة (مُعَاوِن، مُسَانِد، من يقوم بالمُسَاعَدَة؛ بمعنى مُفِيد، يقال هذا عامل مساعد…)\nمثال: علي مساعدة ماري. / مُسَاعَدَة, مَعُونَة\nمثال: علي مساعدة ماري.",
 "手伝い手": "مُسَاعِد, مُسَاعِدَة (مُعَاوِن، مُسَانِد، من يقوم بالمُسَاعَدَة؛ بمعنى مُفِيد، يقال هذا عامل مساعد…)\nمثال: علي مساعدة ماري.",
 "手伝う": "مُسَاعَدَة, مَعُونَة\nمثال: علي مساعدة ماري.",
 "手作り": "مشغول يدوياً, يدوي الصنع (مصنوع باليد أو بعملية يدوية)\nمثال: فساتين أطفال دقيقة يدوية الصنع",
 "手作り品": "حِرْفَة يَدَوِيَّة",
 "手作業": "عمل يدوي (العمل المنجز بالأيدي)",
 "手信号": "إشارة العلم, الإشارة بالأعلام (أي من الطرق المتنوعة لاستخدام الأعلام أو الرايات لإرسال الإشارات)\nمثال: سمحت إشارات العلم بالاتصال عن بعد قبل اختراع الراديو وما زالت تستخدم خاصة فيما يتعلق بالسفن",
 "手信語": "إشارة العلم, الإشارة بالأعلام (أي من الطرق المتنوعة لاستخدام الأعلام أو الرايات لإرسال الإشارات)\nمثال: سمحت إشارات العلم بالاتصال عن بعد قبل اختراع الراديو وما زالت تستخدم خاصة فيما يتعلق بالسفن",
 "手傷": "جُرْح, جِرَاحَة (كَلَمَ، شَقَّ اللَحْم وأسَالَ الدَمّ؛ صَادَ أو اكْتَسَبَ)\nمثال: ذلك سيهيج الجرح.",
 "手元": "بالقرب, في مكان قريب (ليس بعيداً بالمصطلحات النسبية)\nمثال: هي تعمل في مكان قريب / مَهَارَة / مَصْرُوف جَيْب, مَصْرُوف / مَقْبِض",
 "手元に届く": "وَصَلَ (ضَمَّ وَلَأَمَ. (مصدره وَصْل وصِلَة)؛ بَلَغَ الشيءَ، أَدْرَكَه. (يتعدى بإلى)…)\nمثال: وصل السيد باكر.",
 "手元金": "سيولة فورية, نقد جاهز (المال في شكل نقد متاح بسهولة)\nمثال: كانت زوجته دائماً مصدراً جيداً للنقد الجاهز",
 "手先": "إِصْبَع (عضو مستطيل ينشعِب من طرف الكفّ أو القدم)\nمثال: كان أول ما لفت انتباهه هي بصمة الإصبع على الزجاج. / تابع, مرؤوس (مساعد خاضع لسلطة أو سيطرة آخر)",
 "手入らず": "غَيْر مُتَأَثِّر, غَيْر مُنْقَاد (لم يتأثر أو لم ينقد لتأثير خارجي)\nمثال: بدا دائماً غير متأثر تماماً ورابط الجأش",
 "手入れ": "اِهْتِمَام / مُدَاهَمَة",
 "手八丁": "بَلَاغَة, فَصَاحَة (مطابَقةُ الكلام لمقتضى الحال أو حُسْن البَيَانِ وقوَّةُ التأثير؛ قُدرة…)",
 "手冊": "دَفْتَر, مُذَكِّرَة",
 "手出し": "تدخل, تلاعب (فعل تغيير شيء ما سراً أو بشكل غير لائق)",
 "手切れ金": "مُسْتَعْمَرَة, مُسْتَوْطَنَة",
 "手利き": "مَهَارَة",
 "手前": "أماماً, في المقدمة (في أو في المقدمة)\nمثال: أرى أضواء مدينة أمامنا / بعض الشيء, قليلاً (بدرجة صغيرة؛ نوعاً ما)\nمثال: الجو دافئ قليلاً / وَجْه, مُحَيًّا (الإِنْسَان: هو مقدم رأسه الذي يُوَجِهَهُ إلى الناس؛ ضد الظَهْر، ما يقع في…)\nمثال: تبدو شاحب الوجه. / مَهَارَة / مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة! / أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك…)\nمثال: لم تقصد أي أذى.",
 "手前ども": "نحن (ضَمِيرُ رَفْعٍ مُنْفَصِلٌ لِلْمُثَنَّى وَالْجَمْعِ ( مُذَكَّراً وَمُؤَنَّثاً )…)\nمثال: نحن مهتمون جدا.",
 "手前共": "نحن (ضَمِيرُ رَفْعٍ مُنْفَصِلٌ لِلْمُثَنَّى وَالْجَمْعِ ( مُذَكَّراً وَمُؤَنَّثاً )…)\nمثال: نحن مهتمون جدا.",
 "手前勝手": "أناني, متمركز حول الذات (يهتم بشكل رئيسي أو حصري بنفسه ومصلحته مع استبعاد الآخرين)\nمثال: رجال أنانيون كانوا يحاولون تحقيق مكاسب لأنفسهم من قضية الحقوق المدنية المقدسة",
 "手前定規": "أناني, متمركز حول الذات (يهتم بشكل رئيسي أو حصري بنفسه ومصلحته مع استبعاد الآخرين)\nمثال: رجال أنانيون كانوا يحاولون تحقيق مكاسب لأنفسهم من قضية الحقوق المدنية المقدسة",
 "手加減": "براعة, مهارة خاصة (طريقة خاصة أو مهارة فطرية للقيام بشيء ما)\nمثال: كان لديه ميل لذلك",
