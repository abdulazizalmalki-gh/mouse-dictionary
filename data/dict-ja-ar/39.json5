{
 "愚痴を零す": "تذمر دائم (شكوى مزعجة ومستمرة) / دائم الشكوى ((اليديشية) شخص يشتكي باستمرار)",
 "愚痴愚痴": "مجمجة, مضغ بلا أسنان (مضغ غير فعال (كما لو كان بدون أسنان)) / تمتمة, نطق غير واضح (بيان غير واضح للكلام)",
 "愚癡": "قَمْقَمَ",
 "愚癡っぽい": "سَرِيع التَّأَفُّف, عَصَبِيّ (يتهيج أو ينزعج بسهولة)",
 "愚禿": "أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى.",
 "愚策": "خِطَّة, خُطَّة / خَطَّطَ (وضع خطة مُحكَمة لتحقيق هدف معين؛ رسم خطوط أو تقسيم مساحة بخطوط) / نَوَى, بلاني\nمثال: خطط زيري لهجومه.",
 "愚老": "أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى.",
 "愚考": "فِكْر, فِكْرَة (أَعْمَلَ عقله ليصل إلى شيءٍ، ليحل مشكلةً. (يتعدى تعدية عامة بفي)) / فِكْر, تَفْكِير (أَعْمَلَ عقله ليصل إلى شيءٍ، ليحل مشكلةً. (يتعدى تعدية عامة بفي))\nمثال: إنها فكرة جيدة.",
 "愚者": "مُغَفَّل, أَحْمَق",
 "愚臣": "أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى.",
 "愚蒙": "غَبِيّ / غَبِيّ, أَحْمَق",
 "愚蠢": "أَحْمَق, غَبِيّ (مُغَفَّل، أَبْلَه، طَائِش)\nمثال: قبلني ايها الأحمق.",
 "愚行": "حماقة, طيش (سلوك أحمق أو لا معنى له) / حماقة, غباء (خطأ سخيف) / حماقة (سمة التصرف بغباء أو تهور) / جنون, حماقة (صفة التهور والحماقة)\nمثال: محاولة القيادة خلال عاصفة ثلجية هي قمة الحماقة",
 "愚計": "خِطَّة, خُطَّة / خَطَّطَ (وضع خطة مُحكَمة لتحقيق هدف معين؛ رسم خطوط أو تقسيم مساحة بخطوط) / نَوَى, بلاني\nمثال: خطط زيري لهجومه.",
 "愚鈍": "غَبِيّ / غَبِيّ, أَحْمَق",
 "愚闇": "حَمَاقَة (خطأ سخيف)",
 "愛": "حَبِيب, حَبِيبَة / أَحَبَّ, حب (مَالَ إلى الشيء أو الشخص، وَدَّه؛ للزَّرع: بَدا حَبُّه) / أَحَبَّ (مَالَ إلى الشيء أو الشخص، وَدَّه؛ للزَّرع: بَدا حَبُّه)\nمثال: لا أحب المدرسة. / مَوَدَّة / مُلْحَق / مُرْفَق (مَا يُتَّكَأُ عَلَيْهِ)\nمثال: يؤلمني ذراعي من الكتف إلى المرفق. / أغابي, وليمة المحبة (وجبة دينية مشتركة كعلامة على الحب والزمالة) / حب غير مشروط, محبة روحية (حب غير أناني لشخص آخر دون دلالات جنسية (خاصة الحب ذو الطبيعة الروحية)) / محبة إلهية ((في اللاهوت المسيحي) محبة الله أو المسيح للبشرية) / مَحْبُوب / حَبِيب",
 "愛々しい": "جَمِيل, مَحْبُوب (يخاطب العواطف والعين معاً) / جَذَّاب, فَاتِن (محبوب خاصة بطريقة طفولية أو ساذجة) / فتاة الغلاف (فتاة جميلة جداً تعمل كعارضة للمصورين)",
 "愛い": "غَرَامَة / غَرَّمَ (التزم بدفع شيء مقابل عمل أو خطأ أو ضرر؛ تحمل مسؤولية أو عقوبة نتيجة لفعل)",
 "愛おしい": "جَمِيل, مَحْبُوب (يخاطب العواطف والعين معاً) / جَذَّاب, فَاتِن (محبوب خاصة بطريقة طفولية أو ساذجة) / فتاة الغلاف (فتاة جميلة جداً تعمل كعارضة للمصورين) / مُثِير لِلشَّفَقَة, مُزْرٍ (يُثِير مَزيجاً مِن الاحتقار والشَّفَقة) / بَائِس, مُثِيرٌ لِلشَّفَقَة (يَسْتَحِقُّ الشَّفَقَةَ أَوْ يَسْتَدْعِيهَا)",
 "愛おしがる": "شَفَقَة (وشَفِقَ على؛ الرحمة والعَطْف والحَنَان والحُنُوّ) / شَفِقَ ((شَفِقَ) منه، وعليه يَشْفَقَ شَفَقًا: خاف وحَذِرَ، فهو شَفِقٌ؛ (شَفِقَ) عليه: رَقَّ له وعطف عليه؛ فهو شَفِيقٌ)\nمثال: زيري مثير للشفقة.",
 "愛おしむ": "حَبِيب, حَبِيبَة / أَحَبَّ, حب (مَالَ إلى الشيء أو الشخص، وَدَّه؛ للزَّرع: بَدا حَبُّه) / أَحَبَّ (مَالَ إلى الشيء أو الشخص، وَدَّه؛ للزَّرع: بَدا حَبُّه)\nمثال: لا أحب المدرسة.",
 "愛くるしい": "جَمِيل, مَحْبُوب (يخاطب العواطف والعين معاً) / جَذَّاب, فَاتِن (محبوب خاصة بطريقة طفولية أو ساذجة) / فتاة الغلاف (فتاة جميلة جداً تعمل كعارضة للمصورين)",
 "愛くろし": "جَمِيل, مَحْبُوب (يخاطب العواطف والعين معاً) / جَذَّاب, فَاتِن (محبوب خاصة بطريقة طفولية أو ساذجة) / فتاة الغلاف (فتاة جميلة جداً تعمل كعارضة للمصورين)",
 "愛された": "مَاضٍ, الْمَاضِي ((في النحو) زمن نحوي يدل على حدث قد وقع، أو وُجِد قبل الآن بوقت ما)",
 "愛し": "جَمِيل, مَحْبُوب (يخاطب العواطف والعين معاً) / جَذَّاب, فَاتِن (محبوب خاصة بطريقة طفولية أو ساذجة) / فتاة الغلاف (فتاة جميلة جداً تعمل كعارضة للمصورين)",
 "愛しあう": "ضَاجَعَ, جَامَعَ",
 "愛しい": "جَمِيل, مَحْبُوب (يخاطب العواطف والعين معاً) / جَذَّاب, فَاتِن (محبوب خاصة بطريقة طفولية أو ساذجة) / فتاة الغلاف (فتاة جميلة جداً تعمل كعارضة للمصورين) / مُثِير لِلشَّفَقَة, مُزْرٍ (يُثِير مَزيجاً مِن الاحتقار والشَّفَقة) / بَائِس, مُثِيرٌ لِلشَّفَقَة (يَسْتَحِقُّ الشَّفَقَةَ أَوْ يَسْتَدْعِيهَا)",
 "愛しがる": "شَفَقَة (وشَفِقَ على؛ الرحمة والعَطْف والحَنَان والحُنُوّ) / شَفِقَ ((شَفِقَ) منه، وعليه يَشْفَقَ شَفَقًا: خاف وحَذِرَ، فهو شَفِقٌ؛ (شَفِقَ) عليه: رَقَّ له وعطف عليه؛ فهو شَفِيقٌ)\nمثال: زيري مثير للشفقة.",
 "愛しき": "عَزِيز, عَزِيْزَة (القوي المنيع، ضد الذليل؛ القليل النادر العالي القيمة) / غَالِي, غَالِيَّة\nمثال: هذه رسالة من شخص عزيز.",
 "愛した": "مَاضٍ, الْمَاضِي ((في النحو) زمن نحوي يدل على حدث قد وقع، أو وُجِد قبل الآن بوقت ما)",
 "愛しの": "عَزِيز, عَزِيْزَة (القوي المنيع، ضد الذليل؛ القليل النادر العالي القيمة) / غَالِي, غَالِيَّة\nمثال: هذه رسالة من شخص عزيز.",
 "愛しみ": "حُزْن (يقالُ: أَصابَهُ حَزَنٌ شَديدٌ وحُزْنٌ شَديدٌ:(الهَمُّ)؛ حَزِنَ الرّجل : اغْتَمَّ ، حزِنت المرأة:لبست السّواد)\nمثال: شعر توم بالحزن. / عاطفة, محبة (شعور إيجابي بالإعجاب)\nمثال: وجد صعوبة في التعبير عن المودة التي شعر بها",
 "愛しむ": "حَبِيب, حَبِيبَة / أَحَبَّ, حب (مَالَ إلى الشيء أو الشخص، وَدَّه؛ للزَّرع: بَدا حَبُّه) / أَحَبَّ (مَالَ إلى الشيء أو الشخص، وَدَّه؛ للزَّرع: بَدا حَبُّه)\nمثال: لا أحب المدرسة.",
 "愛し合う": "ضَاجَعَ, جَامَعَ",
 "愛す": "حَبِيب, حَبِيبَة / أَحَبَّ, حب (مَالَ إلى الشيء أو الشخص، وَدَّه؛ للزَّرع: بَدا حَبُّه) / أَحَبَّ (مَالَ إلى الشيء أو الشخص، وَدَّه؛ للزَّرع: بَدا حَبُّه)\nمثال: لا أحب المدرسة.",
 "愛すべき": "محبوب (يمتلك خصائص تجذب الحب أو العاطفة)\nمثال: طفل شقي ولكن محبوب",
 "愛する": "حَبِيب, حَبِيبَة / أَحَبَّ, حب (مَالَ إلى الشيء أو الشخص، وَدَّه؛ للزَّرع: بَدا حَبُّه) / أَحَبَّ (مَالَ إلى الشيء أو الشخص، وَدَّه؛ للزَّرع: بَدا حَبُّه)\nمثال: لا أحب المدرسة.",
 "愛でたい": "سَعِيد / فَرِح (سُرُور؛ اسم يطلق على الإناث) / مَحْظُوظ\nمثال: فرح فاضل كثيرا. / سَاذَج",
 "愛でたし": "سَعِيد / فَرِح (سُرُور؛ اسم يطلق على الإناث) / مَحْظُوظ\nمثال: فرح فاضل كثيرا.",
 "愛でる": "حَبِيب, حَبِيبَة / أَحَبَّ, حب (مَالَ إلى الشيء أو الشخص، وَدَّه؛ للزَّرع: بَدا حَبُّه) / أَحَبَّ (مَالَ إلى الشيء أو الشخص، وَدَّه؛ للزَّرع: بَدا حَبُّه)\nمثال: لا أحب المدرسة. / عَجَبَ",
 "愛の神": "إِيرُوس",
 "愛らしい": "جَمِيل, لَطِيف (حَسَن)\nمثال: طقس اليوم جميل.",
 "愛乃谷": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "愛之谷": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "愛人": "عَاشِق, عَاشِقَة / مُغْرَم",
 "愛他主義": "إِيثَار, غَيْرِيَّة",
 "愛他主義者": "فاعل خير, محب للبشر (شخص يقدم تبرعات خيرية تهدف إلى زيادة رفاهية الإنسان)",
 "愛内": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "愛原": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "愛及屋烏": "معشوق, مفتون به (موضوع لشغف مفرط وقصير الأمد) / افتتان, ولع (شغف أو حب أو إعجاب أحمق وعادة ما يكون مفرطاً) / إعجاب عابر, حب المراهقة (حب مؤقت لمراهق)",
 "愛国": "وَطَنِيَّة, مَحَبَّةْ وَطَن",
 "愛国主義": "قَوْمِيَّة (ما يجمع أمة ذات تاريخ وأمانٍ مشتركة)\nمثال: اللغة اليابانية لغتي القومية.",
 "愛国心": "وَطَنِيَّة, مَحَبَّةْ وَطَن",
 "愛国的": "وَطَنِيّ",
 "愛国者": "وَطَنِيّ, وَطَنِيَّة",
 "愛執": "مَوَدَّة / مُلْحَق / مُرْفَق (مَا يُتَّكَأُ عَلَيْهِ)\nمثال: يؤلمني ذراعي من الكتف إلى المرفق.",
 "愛好": "حَبِيب, حَبِيبَة / أَحَبَّ, حب (مَالَ إلى الشيء أو الشخص، وَدَّه؛ للزَّرع: بَدا حَبُّه) / أَحَبَّ (مَالَ إلى الشيء أو الشخص، وَدَّه؛ للزَّرع: بَدا حَبُّه)\nمثال: لا أحب المدرسة.",
 "愛好会": "عَصًا (ما يتخذ من خَشَب للتوكؤ أو الضرب؛ تطلق مجازا على عَظْم السَاق وعلى اللِسَان) / نَادٍ لَيْلِيّ, اَلنَّادِي اَللَّيْلِيّ / سِبَاتِي\nمثال: لا تمسك العصا من الوسط.",
 "愛好家": "متحمس, نصير (مؤيد قوي ومتحمس لشخص أو نشاط ما) / مولع, هاوٍ (شخص لديه إعجاب قوي بشيء ما)",
 "愛好者": "متحمس, نصير (مؤيد قوي ومتحمس لشخص أو نشاط ما) / مولع, هاوٍ (شخص لديه إعجاب قوي بشيء ما)",
 "愛媛": "إِهِيمِه",
 "愛嬌": "تميمة الحظ, جالب للحظ (شيء يُعتقد أنه يجلب الحظ السعيد) / جاذبية, سحر (الجاذبية التي تثير الاهتمام أو تسعد أو تحفز) / كوارك ساحر, نكهة السحر ((فيزياء) إحدى نكهات الكوارك الست، وهو الثالث من حيث الكتلة بين جميع الكواركات) / تعويذة, رقى (صيغة لفظية يُعتقد أن لها قوة سحرية)\nمثال: كانت ابتسامته جزءاً من جاذبيته لها / أَدَب, مَجَامَلَة (هو الظُرْف وحسن التَنَاوُل أو التَصَرُّف، أو هو مَلَكَة تعصم من كانت به عما يشينه؛ تطلق على المُسْتَظْرف من المعارف والعلوم)\nمثال: زيري يحب الأدب. / تَرْفِيه, تَسْلِيَة",
 "愛嬌ぼくろ": "حسنة, شامة اصطناعية (نقطة توضع على وجه السيدة للزينة)",
 "愛宕": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "愛寵": "مَعْرُوف / أَنْعَمَ",
 "愛嶋": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "愛川": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "愛弟子": "تلميذ المعلم المدلل (الطالب المفضل لدى المعلم)",
 "愛徳": "مُنَظَّمَة خَيْرِيَّة / صَدَقَة / إِحْسَان",
 "愛心": "حَبِيب, حَبِيبَة / أَحَبَّ, حب (مَالَ إلى الشيء أو الشخص، وَدَّه؛ للزَّرع: بَدا حَبُّه) / أَحَبَّ (مَالَ إلى الشيء أو الشخص، وَدَّه؛ للزَّرع: بَدا حَبُّه)\nمثال: لا أحب المدرسة.",
 "愛念": "عاطفة, محبة (شعور إيجابي بالإعجاب)\nمثال: وجد صعوبة في التعبير عن المودة التي شعر بها",
 "愛情": "حَبِيب, حَبِيبَة / أَحَبَّ, حب (مَالَ إلى الشيء أو الشخص، وَدَّه؛ للزَّرع: بَدا حَبُّه) / أَحَبَّ (مَالَ إلى الشيء أو الشخص، وَدَّه؛ للزَّرع: بَدا حَبُّه)\nمثال: لا أحب المدرسة.",
 "愛情深い": "مُحِبّ, وَدُود",
 "愛想": "بشاشة, دماثة (الميل لكون المرء ودوداً ويسهل التعامل معه) / انشراح, روقان (مزاج مبتهج ومقبول) / دفء عاطفي, محبة (صفة نابعة من مشاعر المودة أو الحب) / هوى, ولع (استعداد للإعجاب بشيء ما) / عاطفة, محبة (شعور إيجابي بالإعجاب)\nمثال: كان لديه ولع بالويسكي / تَحِيَّات, تَمَنِّيَات (تعبير مهذب عن الرغبة في رفاهية شخص ما)\nمثال: أبلغه تحياتي الطيبة / كَرَم, إِكْرَام / ضِيَافَة",
 "愛想がいい": "بَشُوش, لَطِيف (يَنْشُرُ الدِّفْء وَالوُدّ مِنْ حَوْلِه)",
 "愛想がよい": "بَشُوش, لَطِيف (يَنْشُرُ الدِّفْء وَالوُدّ مِنْ حَوْلِه)",
 "愛想が良い": "بَشُوش, لَطِيف (يَنْشُرُ الدِّفْء وَالوُدّ مِنْ حَوْلِه)",
 "愛想づかし": "لم يعد (ليس الآن)\nمثال: لم تعد موجودة",
 "愛想のいい": "بَشُوش, لَطِيف (يَنْشُرُ الدِّفْء وَالوُدّ مِنْ حَوْلِه)",
 "愛想のよい": "بَشُوش, لَطِيف (يَنْشُرُ الدِّفْء وَالوُدّ مِنْ حَوْلِه)",
 "愛想の良い": "بَشُوش, لَطِيف (يَنْشُرُ الدِّفْء وَالوُدّ مِنْ حَوْلِه)",
 "愛想よく": "بِأَسْر, بِجَاذِبِيَّة (بطريقة جذابة وآسرة)\nمثال: لعبت الدور بجاذبية",
 "愛想尽かし": "لم يعد (ليس الآن)\nمثال: لم تعد موجودة",
 "愛想良く": "بِأَسْر, بِجَاذِبِيَّة (بطريقة جذابة وآسرة)\nمثال: لعبت الدور بجاذبية",
 "愛愛しい": "جَمِيل, مَحْبُوب (يخاطب العواطف والعين معاً) / جَذَّاب, فَاتِن (محبوب خاصة بطريقة طفولية أو ساذجة) / فتاة الغلاف (فتاة جميلة جداً تعمل كعارضة للمصورين)",
 "愛慕": "حَبِيب, حَبِيبَة / أَحَبَّ, حب (مَالَ إلى الشيء أو الشخص، وَدَّه؛ للزَّرع: بَدا حَبُّه) / أَحَبَّ (مَالَ إلى الشيء أو الشخص، وَدَّه؛ للزَّرع: بَدا حَبُّه)\nمثال: لا أحب المدرسة.",
 "愛慾": "عَاطِفَة, شَغْف / عَزْم / شَغَف (المرضُ فلانًا: وصل المرض شِغاف قلبه فالقلب عليل فيه مرض؛ الحبُّ فلانًا: وصل إلى شِغَاف قلبه. وقيل: دخل الحب تحت الشغاف. وقيل: غشى القلب تماما)\nمثال: قبل توم ماري بشغف. / مَوَدَّة / مُلْحَق / مُرْفَق (مَا يُتَّكَأُ عَلَيْهِ)\nمثال: يؤلمني ذراعي من الكتف إلى المرفق.",
 "愛憎併存": "ازدواجية المشاعر, تناقض وجداني (مشاعر أو عواطف مختلطة)",
 "愛憐": "تَعَاطُف / عَطْف (عِطْف: عُنُق، رَقبة؛ الجمع: أَعْطَافٌ، و عِطَافٌ، و عُطُوفٌ) / حُنُو",
 "愛撫": "تقبيل, عناق (اللعب العاطفي (أو المداعبة دون ملامسة الأعضاء التناسلية))",
 "愛敬": "تميمة الحظ, جالب للحظ (شيء يُعتقد أنه يجلب الحظ السعيد) / جاذبية, سحر (الجاذبية التي تثير الاهتمام أو تسعد أو تحفز) / كوارك ساحر, نكهة السحر ((فيزياء) إحدى نكهات الكوارك الست، وهو الثالث من حيث الكتلة بين جميع الكواركات) / تعويذة, رقى (صيغة لفظية يُعتقد أن لها قوة سحرية)\nمثال: كانت ابتسامته جزءاً من جاذبيته لها / أَدَب, مَجَامَلَة (هو الظُرْف وحسن التَنَاوُل أو التَصَرُّف، أو هو مَلَكَة تعصم من كانت به عما يشينه؛ تطلق على المُسْتَظْرف من المعارف والعلوم)\nمثال: زيري يحب الأدب. / تَرْفِيه, تَسْلِيَة",
 "愛敬ぼくろ": "حسنة, شامة اصطناعية (نقطة توضع على وجه السيدة للزينة)",
 "愛敬らしい": "جَمِيل, مَحْبُوب (يخاطب العواطف والعين معاً) / جَذَّاب, فَاتِن (محبوب خاصة بطريقة طفولية أو ساذجة) / فتاة الغلاف (فتاة جميلة جداً تعمل كعارضة للمصورين)",
 "愛書家": "محب للكتب, مولع بالكتب (شخص يحب الكتب (ويجمعها عادة))",
 "愛楽": "غَائِب, مَفْقُود (غير موجود أو مفتقد) / مُحِبّ, وَدُود",
 "愛様": "اِبْنَة, بِنْت",
 "愛橋": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "愛欲": "عَاطِفَة, شَغْف / عَزْم / شَغَف (المرضُ فلانًا: وصل المرض شِغاف قلبه فالقلب عليل فيه مرض؛ الحبُّ فلانًا: وصل إلى شِغَاف قلبه. وقيل: دخل الحب تحت الشغاف. وقيل: غشى القلب تماما)\nمثال: قبل توم ماري بشغف. / مَوَدَّة / مُلْحَق / مُرْفَق (مَا يُتَّكَأُ عَلَيْهِ)\nمثال: يؤلمني ذراعي من الكتف إلى المرفق.",
 "愛沢": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "愛河": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "愛液": "مَنِيّ",
 "愛煙家": "مُدَخِّن, مُدَخِّنَة",
 "愛玩": "سَلِيبَة / غَنِيمَة / جَائِزَة, مُكَافَأَة",
 "愛玩動物": "حَيَوَان مَنْزَلِيّ (بمعنى أصبح له حياة؛ الحَيَاة. والحَيَوَان أبلغ من الحَيَاة؛ جنس الحَيّ الذي يأكل وينمو ويتحرك بالإرادة وبه حِسّ بخلاف ما به حياة فقط دون الحس مثل النَبَات. بعض العامة تقول حَيْوَان وهو غلط) / حَيَوَان أَلِيف (بمعنى أصبح له حياة؛ الحَيَاة. والحَيَوَان أبلغ من الحَيَاة؛ جنس الحَيّ الذي يأكل وينمو ويتحرك بالإرادة وبه حِسّ بخلاف ما به حياة فقط دون الحس مثل النَبَات. بعض العامة تقول حَيْوَان وهو غلط)\nمثال: هذا حيوان أليف.",
 "愛用": "مَحْبُوب, مُفَضَّل (يروق لعامة الناس ويستهويهم) / مفضل (شيء يحظى بتفضيل أو إعجاب خاص) / حبيب, مفضل (شخص محبوب مميز) / مرشح للفوز, مفضل (منافس يُعتقد أنه من المرجح أن يفوز)\nمثال: هذا الكتاب هو أحد مفضلاتي",
 "愛甲": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "愛着": "مَوَدَّة / مُلْحَق / مُرْفَق (مَا يُتَّكَأُ عَلَيْهِ)\nمثال: يؤلمني ذراعي من الكتف إلى المرفق. / مَوَدَّة / مُلْحَق / مُرْفَق (مَا يُتَّكَأُ عَلَيْهِ)\nمثال: يؤلمني ذراعي من الكتف إلى المرفق. / إِدْمَان",
 "愛知": "آيْتْشِي",
 "愛称": "اسم تدليل (اسم للتودد (خاصة الذي يستخدم لاحقة تصغير))\nمثال: 私たちは彼女を「アン」という愛称で呼んだ。 — لقبناها بآن.",
 "愛著": "مَوَدَّة / مُلْحَق / مُرْفَق (مَا يُتَّكَأُ عَلَيْهِ)\nمثال: يؤلمني ذراعي من الكتف إلى المرفق. / إِدْمَان",
 "愛蔵": "ثَمِين, غَالٍ (يتسم بالمودة الحانية والتقدير العميق)",
 "愛読者": "متبرع, مساهم (شخص يساهم (أو يعد بالمساهمة) بمبلغ من المال) / قارئ, مشترك (شخص يتعاقد لاستلام ودفع مقابل خدمة أو عدد معين من إصدارات مطبوعة) / مؤيد, مصادق (شخص يعبر عن موافقة قوية)",
 "愛護": "حِمَايَة",
 "愛車": "عَجَلَة / عجلة / رويضة",
 "愛迷": "انشقاق, صدع (انفصال شخصي أو اجتماعي (كما بين الفصائل المتعارضة))\nمثال: كانوا يأملون في تجنب قطيعة في العلاقات",
 "愛酒": "شَارِب",
 "愛野": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "愛野谷": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "愛顧": "إقبال الزبائن, تجارة (الأعمال التي يقدمها العملاء لمؤسسة تجارية) / رعاية, نظام المحسوبية ((سياسة) منح خدمات أو إعطاء عقود أو إجراء تعيينات في مناصب مقابل الدعم السياسي) / دعم, مؤازرة (فعل تقديم الموافقة والدعم) / ازْدِرَاء, تَعَالٍ (تواصل يشير إلى عدم الاحترام من خلال معاملة المتلقي بفوقية)\nمثال: حتى قبل الظهر كان هناك إقبال كبير",
 "愛飲者": "شَارِب",
 "愛餐": "أغابي, وليمة المحبة (وجبة دينية مشتركة كعلامة على الحب والزمالة) / وليمة المحبة (تجمع اجتماعي يهدف إلى خلق النوايا الحسنة بين المشاركين)",
 "愛餐会": "أغابي, وليمة المحبة (وجبة دينية مشتركة كعلامة على الحب والزمالة) / وليمة المحبة (تجمع اجتماعي يهدف إلى خلق النوايا الحسنة بين المشاركين)",
 "感": "شُعُور, إِحْسَاس / عَاطِفَة, إِحْسَاس / تَجْرِيبِيّ, مُؤَقَّت (بِمُوجِبِ شُرُوطٍ لَمْ تُسْتَكْمَلْ أَوْ لَمْ يُتَّفَقْ عَلَيْهَا نِهَائِيًّا) / مُبْدَئِيّ, مُتَرَدِّد (غير مستقرّ في الرأي؛ مُتذبذب) / حَرْف نِدَاء (طَرَف وَجَانِب وَحَدّ؛ رَمْز مخطوط أو مطبوع يقوم مقام صوت أو كلمة أو عبارة أو معنى)\nمثال: ألف هو الحرف الأول للألف باء.",
 "感じ": "شُعُور, إِحْسَاس / عَاطِفَة, إِحْسَاس",
 "感じとる": "أَدْرَكَ, وَعَى (وَصَلَ إلى الشَّيءِ، بَلَغَهُ (مَكَان، قِيمَة، حَال، هَدَف)؛ لَحِقَ الشيءَ بعد أن سَبَقَه)\nمثال: لم أدرك أبدا أنه يحبني.",
 "感じやすい": "ذُو إِحْسَاس (أحد الأسماء الستة، لا يأتي إلا مُضَافًا، بمعنى صاحب) / حَسَّاس\nمثال: كان رجل ذو قامة طويله.",
 "感じる": "تحسس / شَعَرَ (العِلْم؛ في : هو كلام مُقَفَّى ومُوَازَن على أوزان معروفة يُقصد به إظهار الكلام بصيغة فنية) / شَعَرَ بِ (العِلْم؛ في : هو كلام مُقَفَّى ومُوَازَن على أوزان معروفة يُقصد به إظهار الكلام بصيغة فنية)\nمثال: شعر ماريا طويل. / أَجَابَ (رَدَّ على سُؤالٍ أو طلبٍ؛ أَمْتَثَلَ لِمُطَالَبَةٍ أو دعوةٍ)\nمثال: أجاب ياني فورا. / لُقْطَة / أَمْسَكَ (حَبَسَ الشيءَ، قَبَضَ عَلَيْهِ. و (يتعدى بالباء)؛ اِمْتَنَعَ بالشيءِ، اِعْتَصَمَ بِه. (يتعدى بالباء)) / مَسَكَ\nمثال: كنت أمسك بالكرة.",
 "感じ取る": "أَدْرَكَ, وَعَى (وَصَلَ إلى الشَّيءِ، بَلَغَهُ (مَكَان، قِيمَة، حَال، هَدَف)؛ لَحِقَ الشيءَ بعد أن سَبَقَه)\nمثال: لم أدرك أبدا أنه يحبني.",
 "感じ悪い": "سَيِّئ, وحش",
 "感じ易い": "ذُو إِحْسَاس (أحد الأسماء الستة، لا يأتي إلا مُضَافًا، بمعنى صاحب) / حَسَّاس\nمثال: كان رجل ذو قامة طويله.",
 "感ずる": "تحسس / شَعَرَ (العِلْم؛ في : هو كلام مُقَفَّى ومُوَازَن على أوزان معروفة يُقصد به إظهار الكلام بصيغة فنية) / شَعَرَ بِ (العِلْم؛ في : هو كلام مُقَفَّى ومُوَازَن على أوزان معروفة يُقصد به إظهار الكلام بصيغة فنية)\nمثال: شعر ماريا طويل. / أَجَابَ (رَدَّ على سُؤالٍ أو طلبٍ؛ أَمْتَثَلَ لِمُطَالَبَةٍ أو دعوةٍ)\nمثال: أجاب ياني فورا. / لُقْطَة / أَمْسَكَ (حَبَسَ الشيءَ، قَبَضَ عَلَيْهِ. و (يتعدى بالباء)؛ اِمْتَنَعَ بالشيءِ، اِعْتَصَمَ بِه. (يتعدى بالباء)) / مَسَكَ\nمثال: كنت أمسك بالكرة.",
 "感づく": "حَاسَّة / إِحْسَاس, شُعُور / مَعْنَى, دَلَالَة / مَوْهِبَة, قُدْرَة طَبِيعِيَّة / حَسَّ (حسّه:أحرقه ، حسسْتُ الشّيء:أحسَسْتُه،حسَسْتُ اللحمَ:جعلته على الجمر،حسَسْتُ النّارَ:رددْتُها بالعصا على خُبْزِ المَلّةِ؛ حَسَّ فلاناً:قتله قتلاً ذريعاً مستأصلاً رأسه.(حسَسْتُ اليهوديََ لما أظهر عداوته لله ودينه))\nمثال: لديهم حس الفكاهة.",
 "感付く": "حَاسَّة / إِحْسَاس, شُعُور / مَعْنَى, دَلَالَة / مَوْهِبَة, قُدْرَة طَبِيعِيَّة / حَسَّ (حسّه:أحرقه ، حسسْتُ الشّيء:أحسَسْتُه،حسَسْتُ اللحمَ:جعلته على الجمر،حسَسْتُ النّارَ:رددْتُها بالعصا على خُبْزِ المَلّةِ؛ حَسَّ فلاناً:قتله قتلاً ذريعاً مستأصلاً رأسه.(حسَسْتُ اليهوديََ لما أظهر عداوته لله ودينه))\nمثال: لديهم حس الفكاهة.",
 "感作": "تحسيس (جعل كائن حي حساسًا لمصل عن طريق سلسلة من الحقن) / تحسيس, توعية ((في علم النفس) عملية أن يصبح الشخص حساساً للغاية تجاه أحداث أو مواقف معينة (خاصة الأحداث أو المواقف العاطفية)) / تحسس (حالة الحساسية (كما في المستضدات))",
 "感傷": "عَاطِفَة",
 "感傷主義": "نزعة عاطفية (ميل للعاطفية) / عاطفية مفرطة (التعبير المفرط عن المشاعر الرقيقة أو الحنين أو الحزن بأي شكل من الأشكال)",
 "感傷主義者": "عَاطِفِيّ مُفْرِط, وِجْدَانِيّ (شخص ينغمس في العاطفة المفرطة)",
 "感傷家": "عَاطِفِيّ مُفْرِط, وِجْدَانِيّ (شخص ينغمس في العاطفة المفرطة)",
 "感傷的": "رَكِيكُ الحِسّ, مُبْتَذَلُ العَاطِفَة (مُفرِط في العاطفة بشكل مُتصنَّع أو غير صادق) / عَاطِفِيّ, وِجْدَانِيّ (يميل إلى العاطفة أو يتسم بها)",
 "感光": "تعريض (فعل تعريض شخص ما لتجربة مؤثرة) / ترك في العراء, نبذ (التخلي دون مأوى أو حماية (مثل ترك رضيع في العراء)) / إظهار, كشف (العرض للمشاهدة بطريقة علنية أو عامة) / تعريض (فعل تعريض الفيلم للضوء)\nمثال: نددت بتعريض الأطفال للمواد الإباحية",
 "感光性": "حساسية إشعاعية, حساسية للضوء (الحساسية لتأثير الطاقة المشعة)",
 "感光計": "مقياس الحساسية (أداة قياس لقياس حساسية الفيلم للضوء عبر مجموعة من التعريضات) / أكتينومتر, مقياس الإشعاع الكيميائي (أداة لقياس شدة الإشعاع الكهرومغناطيسي (عادة عن طريق التأثير الكيميائي الضوئي))",
 "感冒": "بَارِد, برد (مُنْخَفِض الحَرارة أو حَرارتُه أقلّ من حَرارة جسْم الإنسان؛ غير حامٍ، أو متروك بلا حماوة، غير محميّ على النَّار) / بَرْدَان / بُرُودَة, بَرْد / زُكَام, رَشْح\nمثال: الماء بارد حقا.",
 "感動": "اضطراب, هياج (اضطراب عادة ما يكون احتجاجاً) / إثارة, تهيج (شيء يسبب الاضطراب والإثارة) / إثارة, انتعاش (الشعور بفرح حيوي ومبهج) / إثارة, انفعال (حالة الاستثارة العاطفية والانفعال)\nمثال: تطلع إلى إثارة اليوم",
 "感動文": "صِيَاح, صُرَاخ (مصدر الفعل صَاحَ؛ صوت الكائن الحي القوي)\nمثال: بدأنا في الصياح.",
 "感動的": "مُتَحَرِّك / مُؤَثِّر",
 "感動詞": "حَرْف نِدَاء (طَرَف وَجَانِب وَحَدّ؛ رَمْز مخطوط أو مطبوع يقوم مقام صوت أو كلمة أو عبارة أو معنى)\nمثال: ألف هو الحرف الأول للألف باء.",
 "感化": "نَفُوذ, تَأْثِير / تَأْثِير / أَثَّرَ (عَلَامَة؛ بَقِيَّة؛ رَسْم مُتَخَلَّف من شيء ما؛ تأثير؛ انطباع)\nمثال: اختفى فلم ير له أثر.",
 "感化院": "إصْلاحِيّ, تَهْذيبِيّ (يَهْدِف إلى الإصْلاح والتَّهْذيب) / إصلاحية, دار رعاية الأحداث (مؤسسة إصلاحية لاحتجاز وتأديب وتدريب الأحداث أو المجرمين لأول مرة)",
 "感取": "شُعُور, إِحْسَاس / عَاطِفَة, إِحْسَاس",
 "感受": "إحساس, إدراك (إدراك شيء ما عبر الحواس) / استشعار, رصد (الإدراك بأن شيئاً ما قد حدث أو أن حالة ما موجودة)\nمثال: الكشف المبكر يمكن أن يؤدي غالباً إلى الشفاء / اِسْتَقْبَلَ, اِسْتَلَمَ (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه) / اِسْتَقْبَلَ, يَسْتَقْبِل (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه)\nمثال: استقبل توم الضيوف.",
 "感受性": "تأثر, حساسية (القدرة على الاستجابة للتغيرات الوجدانية في البيئة الشخصية) / حساسية (القدرة على الاستجابة للمحفزات الفيزيائية أو تسجيل كميات فيزيائية صغيرة أو فروق) / تحسس, حساسية ((علم وظائف الأعضاء) الاستجابة للمحفزات الخارجية؛ ملكة الإحساس) / حساسية (الحساسية للمشاعر العاطفية (للذات وللآخرين))\nمثال: جلفانومتر ذو حساسية شديدة",
 "感嘆": "إِعْجَاب",
 "感嘆文": "صِيَاح, صُرَاخ (مصدر الفعل صَاحَ؛ صوت الكائن الحي القوي)\nمثال: بدأنا في الصياح.",
 "感嘆符": "علامة تعجب (علامة ترقيم ('!') تستخدم بعد التعجب)",
 "感嘆詞": "حَرْف نِدَاء (طَرَف وَجَانِب وَحَدّ؛ رَمْز مخطوط أو مطبوع يقوم مقام صوت أو كلمة أو عبارة أو معنى)\nمثال: ألف هو الحرف الأول للألف باء. / صِيَاح, صُرَاخ (مصدر الفعل صَاحَ؛ صوت الكائن الحي القوي)\nمثال: بدأنا في الصياح.",
 "感奮": "مُتَأَثِّر, مُسْتَثَار (مُثَار عاطفياً ووجدانياً)",
 "感官": "عضو حسي (عضو به نهايات عصبية (في الجلد أو الأحشاء أو العين أو الأذن أو الأنف أو الفم) تستجيب للتحفيز)",
 "感度": "تأثر, حساسية (القدرة على الاستجابة للتغيرات الوجدانية في البيئة الشخصية) / حساسية (القدرة على الاستجابة للمحفزات الفيزيائية أو تسجيل كميات فيزيائية صغيرة أو فروق) / تحسس, حساسية ((علم وظائف الأعضاء) الاستجابة للمحفزات الخارجية؛ ملكة الإحساس) / حساسية (الحساسية للمشاعر العاطفية (للذات وللآخرين))\nمثال: جلفانومتر ذو حساسية شديدة",
 "感得": "تَحْقِيق",
 "感心": "إِعْجَاب\nمثال: 我々は彼女の勇気に感心する。 — نحب شجاعتها. / جَدِير بِالْإِعْجَاب / ذُهُول, دَهْشَة",
 "感応": "استجابة, تجاوب (صفة الاستجابة أو التفاعل بسرعة؛ بالنسبة للأشخاص، تتضمن التجاوب العاطفي مع الناس والأحداث) / استجابة, تفاعلية (الاستجابة للتحفيز) / إطلاق, استحثاث (فعل يحرك سلسلة من الأحداث) / استحثاث, تحريض (فعل التسبب في حدوث شيء ما (خاصة في وقت مبكر)) / استدلال استقرائي, استقراء (الاستدلال من الحقائق التفصيلية إلى المبادئ العامة) / استثارة, استحثاث (تحفيز يستدعي (يستخرج) فئة معينة من السلوكيات)\nمثال: استحثاث حالة التخدير",
 "感応作用": "إطلاق, استحثاث (فعل يحرك سلسلة من الأحداث) / استحثاث, تحريض (فعل التسبب في حدوث شيء ما (خاصة في وقت مبكر)) / استدلال استقرائي, استقراء (الاستدلال من الحقائق التفصيلية إلى المبادئ العامة) / استثارة, استحثاث (تحفيز يستدعي (يستخرج) فئة معينة من السلوكيات)\nمثال: استحثاث حالة التخدير",
 "感応性": "استجابة, تجاوب (صفة الاستجابة أو التفاعل بسرعة؛ بالنسبة للأشخاص، تتضمن التجاوب العاطفي مع الناس والأحداث) / استجابة, تفاعلية (الاستجابة للتحفيز)",
 "感性": "تأثر, حساسية (القدرة على الاستجابة للتغيرات الوجدانية في البيئة الشخصية) / حساسية (القدرة على الاستجابة للمحفزات الفيزيائية أو تسجيل كميات فيزيائية صغيرة أو فروق) / تحسس, حساسية ((علم وظائف الأعضاء) الاستجابة للمحفزات الخارجية؛ ملكة الإحساس) / حساسية (الحساسية للمشاعر العاطفية (للذات وللآخرين))\nمثال: جلفانومتر ذو حساسية شديدة",
 "感性論": "عِلْم الْجَمَال, فَلْسَفَةُ الْجَمَال (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "感恩": "شُكْر, اِمْتِنَان ((شَكِرَت) الشَّجرة تَشْكَرُ شَكَرًا: خرج منها الشَّكِيرُ؛ (شَكِرَت) الضَّرْعُ: امتلأ باللبن)\nمثال: شكر ياني أسرته.",
 "感情": "عَاطِفَة, عَوَاطِف",
 "感情むきだし": "اندفاع في الكلام, فيض عاطفي (سمة ودية منفتحة لشخص ثرثار)",
 "感情むき出し": "اندفاع في الكلام, فيض عاطفي (سمة ودية منفتحة لشخص ثرثار)",
 "感情剝き出し": "اندفاع في الكلام, فيض عاطفي (سمة ودية منفتحة لشخص ثرثار)",
 "感情剥き出し": "اندفاع في الكلام, فيض عاطفي (سمة ودية منفتحة لشخص ثرثار)",
 "感情家": "إِنْسَان انْفِعَالِيّ, شَخْص عَاطِفِيّ (شخص يخضع لحالات عاطفية قوية)",
 "感情的": "مُثَار عَاطِفِيًّا, مُنْفَعِل ((للأشخاص) متأثر بشكل مفرط بالعاطفة) / عاطفي (ذو عاطفة أكثر من المعتاد) / انفعالي, عاطفي (محدد أو مدفوع بالعاطفة بدلاً من العقل) / انفعالي, عاطفي (من أو يتعلق بالعاطفة)\nمثال: كان سلوكه عاطفياً للغاية",
 "感情移入": "تَعَاطُف",
 "感情障害": "اضطراب عاطفي, اضطراب وجداني (أي اضطراب عقلي لا تسببه تشوهات عضوية قابلة للكشف في الدماغ ويكون فيه الاضطراب الرئيسي في العواطف سائداً)",
 "感想": "اِنْطِبَاع, أَثَر / تَقْلِيد",
 "感慨深い": "مُتَحَرِّك / مُؤَثِّر",
 "感懐": "اِنْطِبَاع, أَثَر / تَقْلِيد",
 "感服": "إِعْجَاب\nمثال: 君の勇気には全く感服する。 — يعجبني فيك شجاعتك.",
 "感染": "عَدْوَى",
 "感染す": "أَعْدَى",
 "感染リスク": "خطر العدوى, مخاطرة (احتمال الإصابة بالعدوى بعد حدوث التعرض لعامل معد)",
 "感染病": "مَرَض مُعْدٍ (أصابه مرضٌ أو علّة أو سَقَم)\nمثال: هذا المرض قلبي.",
 "感染症": "مَرَض مُعْدٍ (أصابه مرضٌ أو علّة أو سَقَم)\nمثال: هذا المرض قلبي.",
 "感染症法": "مَرَض مُعْدٍ (أصابه مرضٌ أو علّة أو سَقَم)\nمثال: هذا المرض قلبي.",
 "感染者": "نَاقِل / مَوْجَة حامِلة / حَامِل, حَمَلَة (اسم فاعل من حَمَلَ، أي الذي يحمل شيئا؛ امرأة حَامِل: حُبْلَى، في بطنها جَنْيِن، وإذا أريد اسم الفاعل يقال للمرأة حَامِلَة)\nمثال: يبدو أنني حامل.",
 "感歎符": "علامة تعجب (علامة ترقيم ('!') تستخدم بعد التعجب)",
 "感歎詞": "حَرْف نِدَاء (طَرَف وَجَانِب وَحَدّ؛ رَمْز مخطوط أو مطبوع يقوم مقام صوت أو كلمة أو عبارة أو معنى)\nمثال: ألف هو الحرف الأول للألف باء. / صِيَاح, صُرَاخ (مصدر الفعل صَاحَ؛ صوت الكائن الحي القوي)\nمثال: بدأنا في الصياح.",
 "感涙": "بكاء, نحيب (عملية ذرف الدموع (عادة ما تكون مصحوبة بنشيج أو أصوات أخرى غير مفصلة))\nمثال: أكره سماع بكاء طفل",
 "感潮域": "مَصَبّ, فُغْرَة",
 "感潮河川": "نهر مدّي (مجرى مائي تمتد فيه تأثيرات المد والجزر لمسافة بعيدة باتجاه المنبع)",
 "感激": "اِنْطِبَاع, أَثَر / تَقْلِيد",
 "感熱プリンタ": "طابعة حرارية (طابعة تنتج أحرفاً عن طريق تطبيق الحرارة على ورق خاص حساس للحرارة)",
 "感熱印字装置": "طابعة حرارية (طابعة تنتج أحرفاً عن طريق تطبيق الحرارة على ورق خاص حساس للحرارة)",
 "感熱式プリンタ": "طابعة حرارية (طابعة تنتج أحرفاً عن طريق تطبيق الحرارة على ورق خاص حساس للحرارة)",
 "感熱式プリンター": "طابعة حرارية (طابعة تنتج أحرفاً عن طريق تطبيق الحرارة على ورق خاص حساس للحرارة)",
 "感知": "اِدْرََاك حَسِّيّ",
 "感知器": "حَسَّاس, جِهَازُ اِسْتِشْعَار",
 "感興": "فَائِدَة",
 "感覚": "حَاسَّة / إِحْسَاس, شُعُور / مَعْنَى, دَلَالَة / مَوْهِبَة, قُدْرَة طَبِيعِيَّة / حَسَّ (حسّه:أحرقه ، حسسْتُ الشّيء:أحسَسْتُه،حسَسْتُ اللحمَ:جعلته على الجمر،حسَسْتُ النّارَ:رددْتُها بالعصا على خُبْزِ المَلّةِ؛ حَسَّ فلاناً:قتله قتلاً ذريعاً مستأصلاً رأسه.(حسَسْتُ اليهوديََ لما أظهر عداوته لله ودينه))\nمثال: لديهم حس الفكاهة.",
 "感覚ニューロン": "عصبون حسي (عصبون ينقل النبضات نحو الدماغ أو الحبل الشوكي)",
 "感覚上皮": "ظهارة عصبية (ظهارة مرتبطة بأعضاء الحس الخاصة وتحتوي على نهايات عصبية حسية)",
 "感覚器": "عضو حسي (عضو به نهايات عصبية (في الجلد أو الأحشاء أو العين أو الأذن أو الأنف أو الفم) تستجيب للتحفيز)",
 "感覚器官": "عضو حسي (عضو به نهايات عصبية (في الجلد أو الأحشاء أو العين أو الأذن أو الأنف أو الفم) تستجيب للتحفيز)",
 "感覚毛": "شارب, شعرة حسية (شعرة صلبة طويلة تنمو من خطم أو حاجب معظم الثدييات مثل القطط)",
 "感覚的": "حَسَّاس, فَطِن (مدرك بشكل حدسي أو فكري لشيء محسوس) / مَحْسُوس, مَلْمُوس (يُدْرَكُ بِالحَوَاسِّ بِسُهُولَة) / عاقل, معقول (يظهر العقل أو الحكم الصائب) / حسي, شاعر (قادر على الشعور أو الإدراك)\nمثال: خيار معقول",
 "感覚神経": "عصب حسي, عصب وارد (عصب ينقل النبضات من المستقبلات باتجاه أو إلى الجهاز العصبي المركزي)",
 "感覚論": "تجريبية, حسية ((فلسفة) المذهب القائل بأن المعرفة تُستمد من التجربة) / حسية ((فلسفة) المذهب الأخلاقي القائل بأن الشعور هو المعيار الوحيد لما هو جيد) / إثارة, تهويل (الاستخدام الصحفي لموضوع يروق للأذواق المبتذلة) / إِثَارَة, صِحَافَة الْإِثَارَة (موضوع مصمم لإثارة وإرضاء الأذواق المبتذلة)",
 "感覚過敏症": "فرط حساسية (حساسية مفرطة) / فرط الحساسية (حساسية مرضية)",
 "感覚遮断": "حرمان حسي (شكل من أشكال التعذيب النفسي يتم عن طريق حرمان الضحية من جميع المدخلات الحسية)",
 "感覚鈍麻": "نقص الحس (ضعف الحساسية اللمسية)",
 "感触": "تحسس / شَعَرَ (العِلْم؛ في : هو كلام مُقَفَّى ومُوَازَن على أوزان معروفة يُقصد به إظهار الكلام بصيغة فنية) / شَعَرَ بِ (العِلْم؛ في : هو كلام مُقَفَّى ومُوَازَن على أوزان معروفة يُقصد به إظهار الكلام بصيغة فنية)\nمثال: شعر ماريا طويل. / شُعُور, إِحْسَاس / عَاطِفَة, إِحْسَاس",
 "感謝": "شُكْرًا\nمثال: ご協力に感謝します。 — أقدر تعاونك معنا.",
 "感謝知らず": "جاحد, غير ممتن (لا يشعر أو لا يظهر الامتنان) / ثَقِيل, غَيْر مُسْتَسَاغ (غير مقبول أو غير مستساغ)\nمثال: ورثة جاحدون",
 "感謝祭": "عِيد اَلشُّكْر / شُكْرًا, تِسْلَم",
 "感銘深い": "جَدِيرٌ بِالتَّذَكُّر, لَافِت (يَسْتَحِقُّ أَنْ يُتَذَكَّرَ)",
 "感電": "صَدْمَة كَهْرَبَائِيَّة",
 "感電死": "صعق كهربائي (القتل بصدمة كهربائية) / صعق كهربائي (الإعدام بالكهرباء)",
 "感音性難聴": "فقدان السمع الحسي العصبي (فقدان السمع بسبب فشل العصب السمعي)",
 "感音難聴": "فقدان السمع الحسي العصبي (فقدان السمع بسبب فشل العصب السمعي)",
 "慄き": "ارتجاف, رعشة (اهتزاز لا إرادي (كما لو كان بسبب المرض أو الخوف)) / رجفة, رعشة (إحساس بالخوف يكاد يكون ممتعاً)\nمثال: سرت فيه رعشة مفاجئة",
 "慄く": "هَزَّ",
 "慄然": "مَذْعُور, مُرْتَعِب (أصابه ذعر شديد أو يأس غامر)",
 "慇懃": "أَدِيب, مُؤَدَّب / صَدَاقَة (المَحَبَّة بالصِّدْق. هي العِلاقَة بين شخصين أو أكثر قائِمَة على المحبة والصدق فكل منهم يحب الآخر ويَصْدُقه ويُصَدِّقه، كل منهم هو صَدِيق للآخر)\nمثال: الغيرة عدوة الصداقة.",
 "慈しみ": "عاطفة, محبة (شعور إيجابي بالإعجاب)\nمثال: وجد صعوبة في التعبير عن المودة التي شعر بها",
 "慈しむ": "حَبِيب, حَبِيبَة / أَحَبَّ, حب (مَالَ إلى الشيء أو الشخص، وَدَّه؛ للزَّرع: بَدا حَبُّه) / أَحَبَّ (مَالَ إلى الشيء أو الشخص، وَدَّه؛ للزَّرع: بَدا حَبُّه)\nمثال: لا أحب المدرسة.",
 "慈善": "مُنَظَّمَة خَيْرِيَّة / صَدَقَة / إِحْسَان",
 "慈善団体": "جَمْعِيَّة خَيْرِيَّة (هَيْئَة أو جهة معينة يجتمع فيها الناس لغَايَة أو هَدَف مشترك لا يستهدف الرِبْح المَادِيّ؛ مؤسسة رِبْحِيَّة إلا أن لها أهداف أخرى في مصلحة المُجْتَمَع)\nمثال: أنشؤوا جمعية سينمائية.",
 "慈善家": "سَخِيّ ((سَخِيَ) سَخاً: كَانَ جوادًا كَرِيمًا؛ (سَخِيَت) نَفسه عَن الشَّيْء: تركته)\nمثال: هو سخي بأمواله.",
 "慈善心": "النزعَة إلى الخير",
 "慈心": "النزعَة إلى الخير",
 "慈悲": "رَحْمَة, رَأْفَة / رَحْمَة, شَفَقَة",
 "慈悲心": "رَحْمَة / شَفَقَة (وشَفِقَ على؛ الرحمة والعَطْف والحَنَان والحُنُوّ)\nمثال: زيري مثير للشفقة.",
 "慈悲殺": "قتل رحيم (فعل قتل شخص ما دون ألم (خاصة من يعاني من مرض عضال))",
 "慈悲深い": "شَفَقَة (وشَفِقَ على؛ الرحمة والعَطْف والحَنَان والحُنُوّ)\nمثال: زيري مثير للشفقة.",
 "慈愛": "عاطفة, محبة (شعور إيجابي بالإعجاب)\nمثال: وجد صعوبة في التعبير عن المودة التي شعر بها",
 "慈鳥": "غُرَاب, زَاغ / صَاحَ (صاتَ بأقصى طاقته وأعلى صوته، يستخدم للحيّ ولا يقال صاح للجماد؛ عليه: ناداه)\nمثال: سأساعدك يا صاح.",
 "慊りない": "غير مُرضٍ (لا يبعث على الرضا)\nمثال: يجب أن تسترجع المتاجر البضائع غير المرضية",
 "態": "ظُهُور (عِيْدُ الظُّهُوْر: عيد للنَصَارَى يُسَمَّى أيضا عيد التَجَلِّي) / مَظْهَر (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / مَظْهَر, شَكْل (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / شَكْل ((شَكَلَ) الأمْرُ يَشْكُلُ شُكُولاً: الْتَبَسَ؛ (شَكَلَ) المريضُ: تماثَلَ)\nمثال: لا أحد لاحظ ظهور الدب. / فَوْضَى, اِخْتِلَاط / ـًا، ـاً, لـ (الْأَلِفُ بِدُونِ هَمْزَةٍ ؛ تُسْتَخْدَمُ فِي آخِرِ أَوْ وَسَطِ الكلام لمد الصوت بحركة الفتحة؛ تبتدئ بها بعض الأسماء في اللغة العربية وهي) / أُسْلُوب (الطَرِيْق والفنّ من القول؛ الطريقة بصورة عامة سواء كانت من القول أو الفعل أو الفكر)\nمثال: هو يحب أسلوب معطوب. / لَبِسَ (خَلَطَ بحيث يصعب التمييز والفصل؛ الأمر: خلطه فاشتبه واضطرب) / ثَوْب, لِبَاس (ما يُلْبَسُ من اللِبَاس، أي جزء ويطلق للرجال والنساء؛ الجزء الرئيس من الملابس، غالبا ما يكون طويلا وواسعا وذو أكمام، تحته الملابس الداخلية وفوقه الخارجية. يستخدم للرجال والنساء) / كَسْوَة, مَلْبَس\nمثال: لبس سروالا نظيفا. / شَرْط (شَرِطَ فلانٌ يَشْرِطِ شَرْطًا: وقع في أَمر عظيمٍ)\nمثال: صرخ ليون: \"شرطة!\" / صَوْت, صوت (أكثر من إحداث الصوت؛ بالغ في إحداث الصوت؛ في : صاح نوحا أو استغاثة) / صَوَّت (أكثر من إحداث الصوت؛ بالغ في إحداث الصوت؛ في : صاح نوحا أو استغاثة)\nمثال: اقرأ بصوت عالي.",
 "態勢": "مَوْقِف, سُلُوك",
 "態度": "مَوْقِف, سُلُوك",
 "態度が大きい": "مُتَكَبِّر, مَغْرُور (شعب مُتكبِّر : مُتعجرف ، شامخ الرأس؛ مُتكَبِّر : فاعل من تَكَبَّر)\nمثال: هو متكبر للغاية.",
 "態様": "وَضْع (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه) / دَوْلَة (بَلَد يتميز بحُدُود معروفة وشَعْب وحُكُومَة ومُؤَسَسَات مُنَظَّمَة؛ مجموعة من الناس مستقلين متحدين معا لتكوين مجتمع لحماية حقوقهم و وضع قوانينهم الخاصة) / وِلَايَة (منطقة إدارية لها استقلالها الإداري والمعنوي؛ ويختلف المعنى من بلد لآخر كما يختلف من فترة زمنية لأخرى) / يُبْدِي\nمثال: لقد أزمت الوضع.",
 "慌しい": "مَشْغُول / سَرِيع",
 "慌ただしい": "مَشْغُول / سَرِيع",
 "慌てふためく": "ذُعْر, رُعْب ((ذَعَرَه) ذعرا: خَوّفه وأفزعه)\nمثال: أصيب سامي بالذعر.",
 "慌てる": "ذُعْر, رُعْب ((ذَعَرَه) ذعرا: خَوّفه وأفزعه)\nمثال: أصيب سامي بالذعر. / عَجَلَة / أَسْرَعَ, اِنْدَفَعَ (أَسْرَعَ: ( فعل )؛ أَسْرَعُ)\nمثال: أسرع و إلا تأخرت.",
 "慌てる乞食はもらいが少ない": "هُنَاكَ, يُوجَدُ",
 "慌てる乞食は貰いが少ない": "هُنَاكَ, يُوجَدُ",
 "慌て者": "طائش, مشتت الذهن (شخص طائش وغير منظم)",
 "慎しみ": "تَوَاضُع / حِشْمَة",
 "慎ましい": "مُتْوَاضِع / مُحْتَشِم / زَاهِد, مُقْتَصِد (يَتَجَنَّبُ الإِسْرَافَ وَالهَدْر)",
 "慎ましやか": "مُتْوَاضِع / مُحْتَشِم",
 "慎み": "تَوَاضُع / حِشْمَة",
 "慎み深い": "مُتْوَاضِع / مُحْتَشِم",
 "慎む": "اِمْتَنَعَ (مَنَعَ نفسه؛ كان مَنِيْعًا يصعب الوصول إليه) / لَازِمَة, قَرَار",
 "慎重": "حَذِر (حذِر الشّخصُ: تيقّظ واستعدّ وتأهّب وتنبّه؛ حذِر الأمرَ: كَتَمَه وأخفاه) / دَقِيق (ضد الغَلِيْظ، الرَفِيْع الرَقِيْق؛ صغير الحجم جدا)\nمثال: قد بحذر من فضلك.",
 "慎重吟味": "تَدْقِيق",
 "慓悍": "عَاصِف, مُضْطَرِب (شَدِيد الهَيَجَان والاضْطِرَاب) / شَرِس, ضَارٍ (عَدِيمُ الرَّحْمَةِ فِي المُنَافَسَة) / جَامِح, حَادّ (يَتَّسِمُ بِشِدَّةٍ مُتَطَرِّفَةٍ فِي المَشَاعِرِ أَوِ القَنَاعَات؛ يَمِيلُ إِلَى رَدِّ الفِعْلِ العَنِيف) / شَرِس, ضَارٍ (يَتَّسِمُ بِطَاقَةٍ بَالِغَةِ العُنْفِ وَالشِّدَّة)",
 "慕う": "اِشْتَاقَ / تَبِعَ, اِتَّبَعَ (تبِع الشيءَ: سار في إثرِه، تلاه؛ تبِعه تبَعًا: مرَّ به فمضى معه) / اِتَّبَعَ (تَكَلَّفَ وبذل الجُهْد في أن يَتْبَع) / تَابَعَ, تَتَبَّعَ / تَابَعَ\nمثال: تبع المشتبه محققان. / أَلَه (أَلِهَ فلانٌ يَأْلَهُ إِلاَهَةً، وأُلُوهَةً، وألوهِيّةً: تحيَّر؛ أَلِهَ أَلَهًا: تَحيَّرَ)",
 "慕わしい": "عَزِيز, عَزِيْزَة (القوي المنيع، ضد الذليل؛ القليل النادر العالي القيمة) / غَالِي, غَالِيَّة\nمثال: هذه رسالة من شخص عزيز.",
 "慕情": "شَوْق (نزوعُ النَّفْس إِلى الشيء، أو تَعَلُّقها به؛ مصدر الفعل شَاقَ)\nمثال: سأشعر بالشوق إليك.",
 "慙愧": "خَجَل, عَيْب (كلمة \"خَجِلَ\" تتراوح معانيها بين الحرج الشخصي والتأثر بالحمل أو البيئة، وتُستخدم في العديد من السياقات التي تعبر عن الاستحياء أو الحيرة؛ شعر بالخجل أو الحياء نتيجة لموقف محرج أو بسبب تصرف غير لائق) / عَار\nمثال: توم لص بلا خجل.",
 "慚愧": "خَجَل, عَيْب (كلمة \"خَجِلَ\" تتراوح معانيها بين الحرج الشخصي والتأثر بالحمل أو البيئة، وتُستخدم في العديد من السياقات التي تعبر عن الاستحياء أو الحيرة؛ شعر بالخجل أو الحياء نتيجة لموقف محرج أو بسبب تصرف غير لائق) / عَار\nمثال: توم لص بلا خجل.",
 "慚無い": "مُثِير لِلشَّفَقَة, مُزْرٍ (يُثِير مَزيجاً مِن الاحتقار والشَّفَقة) / بَائِس, مُثِيرٌ لِلشَّفَقَة (يَسْتَحِقُّ الشَّفَقَةَ أَوْ يَسْتَدْعِيهَا) / مُؤْسِف, مُحْزِن (سيء ومؤسف؛ يبعث على الأسى)",
 "慟哭": "صراخ, عويل (صرخات عالية أثناء البكاء) / عَوِيل, نَائِح (يعبّر بصوته عن الحزن والأسى أو يشبه هذا التعبير)",
 "慠然": "فَخُور",
 "慢心": "فَخْر (اعتزَّ أو تباهى بشيء يملكه أو بعمل قام به؛ زها على الآخرين وأبدى شعوره بالتفوق) / زُمْرَة\nمثال: أنا شديدة الفخر بأبي.",
 "慢性": "عَوِيص / مُزْمِن",
 "慢性気管支炎": "التهاب الشعب الهوائية المزمن (شكل من أشكال التهاب الشعب الهوائية يتميز بإنتاج مفرط للبلغم مما يؤدي إلى سعال مزمن وانسداد تدفق الهواء)",
 "慢性消耗病": "مرض الهزال المزمن (مرض يصيب الحياة البرية (شبيه بمرض جنون البقر) ويؤثر على الغزلان والأيائل)",
 "慢性甲状腺炎": "داء هاشيموتو (اضطراب مناعي ذاتي في الغدة الدرقية)",
 "慢性疲労症候群": "قارن (انظر للمقارنة) / تليف كيسي (أكثر الأمراض الوراثية شيوعاً؛ تنسد رئتا الطفل وأمعاؤه وبنكرياسه بمخاط سميك؛ يسببه خلل في جين واحد؛ لا يوجد علاج معروف) / كاليفورنيوم (عنصر مشع ما بعد اليورانيوم؛ اكتشف بقصف الكوريوم بجسيمات ألفا)",
 "慢性的": "عَوِيص / مُزْمِن",
 "慢性閉塞性肺疾患": "دَاء الاِنْسِدَاد الرِئَوِيّ المُزْمِن",
 "慢性関節リウマチ": "الدَّاء الرَثَيَانِيّ, اِلْتِهَاب المَفَاصِل الرُّومَاتُويِدِيّ",
 "慢慢的": "بَطِيء / أَبْطَأَ, بَطَّأَ",
 "慣らす": "ذَيْل (ذَيَّلَ (ذيله): جعل له ذيلا؛ (ذَيَّلَ) أطال ذيله وطوله. ويقال ذيل كتابه أو كلامه: أردفه بكلام كالتتمة له) / قَافِلَة (مؤنث القافل؛ الراجعة؛ جماعة من الناس تسير معًا مع أمتعتها وركوبها في سفر قافلين كانوا أو خارجين. سميّت كذلك تفائلا برجوعها) / تَدَرَّبَ, تَمَرَّنَ / دَرَّبَ, درب (الدَّرْبُ: كُلُّ طريقٍ يصلُ بين مكانَيْن. يقال: مَنْ سار على الدَّرب وصل : معناه أنّ المهارة تكتسبُ بالمِران؛ الدَّرْبُ: المَضيقُ في الجبال الْمَضْيَقُ فِي الجَبَلِ) / درب, أهل (الدَّرْبُ: كُلُّ طريقٍ يصلُ بين مكانَيْن. يقال: مَنْ سار على الدَّرب وصل : معناه أنّ المهارة تكتسبُ بالمِران؛ الدَّرْبُ: المَضيقُ في الجبال الْمَضْيَقُ فِي الجَبَلِ)\nمثال: للبقرة ذيل طويل. / أَلِيف / رَوَّضَ, آلَفَ (رَوَّضَ المكانُ: أرَاضَ؛ رَوَّضَ فلانٌ: لَزِمَ الرِّياضَ)\nمثال: إلى أية روضة ذهبت؟",
 "慣れ": "تَدْرِيب (تزويدُ الدَّارسين بالدّراسات العلميَّة والعمليّة التي تؤدِّي إلى رفع درجة المهارة عندهم في أداء واجبات الوظيفة؛ إعداد شخص أو مجموعة لتأدية مهمة أو وظيفة معينة) / مُمَارَسَة\nمثال: واصل زيري التدريب.",
 "慣れた": "خبير, ذو خبرة (لديه خبرة؛ لديه معرفة أو مهارة من الملاحظة أو المشاركة)",
 "慣わし": "عَادَة, عُرْف",
 "慣例": "عَادَة, عُرْف",
 "慣例的": "مَأْلُوف, مُعْتَاد (شائع الاستخدام أو الممارسة؛ اعتيادي) / عُرْفِيّ, مَأْلُوف (وَفْقًا لِلعُرْفِ أَوِ العَادَة)",
 "慣性": "عَطَالَة",
 "慣性モーメント": "عزم القصور الذاتي (ميل الجسم لمقاومة التسارع الزاوي)",
 "慣性系": "إطار مرجعي قصوري (نظام إحداثيات يكون فيه قانون نيوتن الأول للحركة سارياً)",
 "慣性航法": "ملاحة بالقصور الذاتي, نظام توجيه بالقصور الذاتي (نظام للتحكم في طائرة أو مركبة فضائية؛ يستخدم قوى القصور الذاتي)",
 "慣性誘導": "توجيه بالقصور الذاتي (طريقة للتحكم في طيران صاروخ بواسطة أجهزة تستجيب لقوى القصور الذاتي)",
 "慣熟": "إِمْكَان",
 "慣用句": "اِصْطِلَاح, مُصْطَلَح",
 "慣用法": "اِسْتِخْدَام",
 "慣用的": "مَأْلُوف, مُعْتَاد (شائع الاستخدام أو الممارسة؛ اعتيادي) / عُرْفِيّ, مَأْلُوف (وَفْقًا لِلعُرْفِ أَوِ العَادَة)",
 "慣用表現": "تعبير اصطلاحي, مصطلح (تعبير لا يمكن استنتاج معانيه من معاني الكلمات التي يتكون منها)",
 "慣用語": "اِصْطِلَاح, مُصْطَلَح",
 "慣用語句": "اِصْطِلَاح, مُصْطَلَح",
 "慣習": "عَادَة, عُرْف",
 "慣習法": "سابقة قضائية, قانون السوابق القضائية ((القانون المدني) قانون تم إنشاؤه من خلال اتباع قرارات قضائية سابقة) / قانون عام, قانون عرفي (نظام فقهي يعتمد على السوابق القضائية بدلاً من القوانين التشريعية)\nمثال: نشأ القانون العام في القوانين غير المكتوبة في إنجلترا وتم تطبيقه لاحقاً في الولايات المتحدة",
 "慣習的": "مَأْلُوف, مُعْتَاد (شائع الاستخدام أو الممارسة؛ اعتيادي) / عُرْفِيّ, مَأْلُوف (وَفْقًا لِلعُرْفِ أَوِ العَادَة)",
 "慣行": "عَادَة",
 "慣行犯": "عائد للإجرام (شخص يُعتقل بشكل متكرر بسبب سلوك إجرامي (خاصة لنفس السلوك الإجرامي)) / عَوْد (قطعة من الخشب كالعصا جمعه عيدان؛ ما يُتَبَخَّر به)\nمثال: أشعلت عود ثقاب.",
 "慧": "حِكْمَة (مؤنث حَكَم)\nمثال: خذ الحكمة من أي وعاء خرجت.",
 "慧敏": "ذَكِيّ (ذَكِيَ: صار شديد الفطنة وسريع البديهة؛ ذكِيَ التلميذ في مهارات الحساب الدهني)\nمثال: إنه وسيم و ذكي.",
 "慧極": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "慧眼": "ثاقب النظر, فطن (يمتلك أو يكشف عن بصيرة حادة وحكم جيد) / حَاذِق, مُمَيِّز (قَادِر عَلَى إِدْرَاك الفُرُوقَات الدَّقِيقَة؛ حَسَّاس) / سَرِيعُ الفَهْم, فَطِن (سَرِيعُ الإِدْرَاكِ وَالاسْتِيعَاب) / حَصِيف, فَطِن (ذو إدراك خفي ومتعاطف)",
 "慨する": "نَدِمَ / تَأَسَّفَ (تأسُّف) / أَسَف (مصدر أسِفَ على / أسِفَ لـ / أسِفَ من؛ أَسَفِي شَدِيدٌ على ما بَدَرَ مِنِّي : نَدَمِي) / تَأَسُّف (تأسُّف)\nمثال: للأسف ذلك صحيح.",
 "慨嘆": "حداد, ندب (النشاط العاطفي والظاهر للتعبير عن الحزن) / رثاء, عويل (صرخة حزن وأسى)\nمثال: يمكن سماع نواحهم المثير للشفقة في جميع أنحاء الجناح",
 "慨然": "ساخط, ساخطة / ثابت (اسم فاعل من ثَبَتَ؛ المُسْتَقِرّ الذي لا يتحرك، ضد المُتَحَرِّك)\nمثال: الشاحنة غير ثابتة.",
 "慫慂": "نَصِيحَة, مَشُورَة",
 "慮り": "فِكْر, فِكْرَة (أَعْمَلَ عقله ليصل إلى شيءٍ، ليحل مشكلةً. (يتعدى تعدية عامة بفي)) / فِكْر, تَفْكِير (أَعْمَلَ عقله ليصل إلى شيءٍ، ليحل مشكلةً. (يتعدى تعدية عامة بفي))\nمثال: إنها فكرة جيدة.",
 "慮外": "مُفَاجِئ / فَظّ",
 "慰み": "تَسْلِيَة",
 "慰みもの": "ألعوبة, لعبة (شيء مصنوع مصمم للعب به)",
 "慰み半分": "مُتَقَلِّب",
 "慰み物": "ألعوبة, لعبة (شيء مصنوع مصمم للعب به)",
 "慰み者": "ألعوبة, لعبة (شيء مصنوع مصمم للعب به)",
 "慰め": "رَاحَة / جابر / وَاسَى, عَزَّى",
 "慰める": "رَاحَة / جابر / وَاسَى, عَزَّى",
 "慰労金": "عِلَاوَة",
 "慰安": "سلوى, عزاء (فعل المواساة؛ تقديم الراحة وتخفيف الحزن أو البلاء) / سلوان, عزاء (الراحة التي تشعر بها عند المواساة في أوقات خيبة الأمل) / سلوى, عزاء (راحة في خيبة الأمل أو البؤس)\nمثال: كان وجوده مواساة لها",
 "慰安婦": "إِمْرَأَة مِتْعَة, نِسَاء مِتْعَة",
 "慰安旅行": "رحلة ترفيهية, نزهة (رحلة تُتخذ للمتعة)\nمثال: العديد من النزهات الصيفية إلى الشاطئ",
 "慰撫": "تَهْدِئَة, مُكَافَحَة التَمَرُّد (إجراءات تتخذها الحكومة لهزيمة التمرد) / تسكين, تهدئة (فعل استرضاء شخص ما أو جعله أكثر ميلاً للموافقة) / سلام, معاهدة سلام (معاهدة لوقف الأعمال العدائية)\nمثال: حل السلام في 11 نوفمبر",
 "慰留": "إقناع بالعدول, ثني (الإقناع بعدم القيام بشيء أو عدم تصديقه؛ إقناع شخص بالعدول عن معتقد أو مسار عمل مقصود) / إِثْنَاء, نُصْح بِالْعُدُول (تواصل يثنيك عن فعل شيء)",
 "慰藉": "مُوَاسَاة",
 "慰謝": "مُوَاسَاة",
 "慰謝料": "إصلاح الضرر, تعويض (شيء يتم فعله أو دفعه تكفيراً عن خطأ) / إصلاح, ترميم (فعل إعادة الشيء إلى حالة العمل) / تعويضات الحرب ((عادة بصيغة الجمع) تعويض يفرضه المنتصرون على دولة مهزومة) / إصلاح, جبر الضرر (تعويض (مُعطى أو مُستلم) عن إهانة أو إصابة)\nمثال: كيف يمكنني التكفير عن خطئي",
 "慰霊碑": "الْقُبْر الْأُجُوف",
 "慴伏": "سُجُود",
 "慶び事": "اِحْتِفَال (إقامة مراسم أو فعاليات تعبيرًا عن مناسبة معينة) / اِحْتِفَال, مِهْرَجَان (إقامة مراسم أو فعاليات تعبيرًا عن مناسبة معينة)\nمثال: لم يحضر الاحتفال.",
 "慶事": "حدث سعيد (الولادة الحية لطفل)",
 "慶安": "حلقة وصل, وسيط (مفاوض يعمل كحلقة وصل بين الأطراف) / تملق, نفاق (ثناء مفرط أو غير صادق)",
 "慶庵": "حلقة وصل, وسيط (مفاوض يعمل كحلقة وصل بين الأطراف) / تملق, نفاق (ثناء مفرط أو غير صادق)",
 "慶春": "كُلُّ عَامٍ وَأَنْتُمْ بِخَيْرٍ, سَنَة جَدِيدَة سَعِيدَة",
 "慶祝": "تَهْنِئَة",
 "慶福": "حدث سعيد (الولادة الحية لطفل)",
 "慶賀": "اِحْتِفَال (إقامة مراسم أو فعاليات تعبيرًا عن مناسبة معينة) / اِحْتِفَال, مِهْرَجَان (إقامة مراسم أو فعاليات تعبيرًا عن مناسبة معينة)\nمثال: لم يحضر الاحتفال.",
 "憂い": "لَعُوق / حُزْن (يقالُ: أَصابَهُ حَزَنٌ شَديدٌ وحُزْنٌ شَديدٌ:(الهَمُّ)؛ حَزِنَ الرّجل : اغْتَمَّ ، حزِنت المرأة:لبست السّواد)\nمثال: شعر توم بالحزن. / قَلَق (شاعر بالقَلَق؛ تَحَرّك/اهتزاز/اضطراب في الوضع الطبيعي للشيء) / قَلَق, اِضْطِرَاب الْقَلَق (شاعر بالقَلَق؛ تَحَرّك/اهتزاز/اضطراب في الوضع الطبيعي للشيء)\nمثال: ليلى قلقة بشأنك.",
 "憂いる": "عَوِيل, رَثَاء / مَرْثِيَة / بَكَى, نَاحَ (دَمَعَتْ عَيناهُ حزنا؛ بكى الْمَيِّت: رثاه) / بَكَى, رَثَى (دَمَعَتْ عَيناهُ حزنا؛ بكى الْمَيِّت: رثاه)\nمثال: بكى زيري كثيرا.",
 "憂い事": "شَقَاوَة, تَعَاسَة",
 "憂う": "عَوِيل, رَثَاء / مَرْثِيَة / بَكَى, نَاحَ (دَمَعَتْ عَيناهُ حزنا؛ بكى الْمَيِّت: رثاه) / بَكَى, رَثَى (دَمَعَتْ عَيناهُ حزنا؛ بكى الْمَيِّت: رثاه)\nمثال: بكى زيري كثيرا.",
 "憂うべき": "مُخِيف, مُقْلِق (مخيف بسبب الوعي بالخطر)",
 "憂え": "حداد, ندب (النشاط العاطفي والظاهر للتعبير عن الحزن) / رثاء, عويل (صرخة حزن وأسى)\nمثال: يمكن سماع نواحهم المثير للشفقة في جميع أنحاء الجناح / غَمّ, حُزْن / قَلَق (شاعر بالقَلَق؛ تَحَرّك/اهتزاز/اضطراب في الوضع الطبيعي للشيء) / قَلَق, اِضْطِرَاب الْقَلَق (شاعر بالقَلَق؛ تَحَرّك/اهتزاز/اضطراب في الوضع الطبيعي للشيء)\nمثال: ليلى قلقة بشأنك. / مَرَض, دَاء (أصابه مرضٌ أو علّة أو سَقَم)\nمثال: هذا المرض قلبي.",
 "憂えた": "مَاضٍ, الْمَاضِي ((في النحو) زمن نحوي يدل على حدث قد وقع، أو وُجِد قبل الآن بوقت ما)",
 "憂える": "عَوِيل, رَثَاء / مَرْثِيَة / بَكَى, نَاحَ (دَمَعَتْ عَيناهُ حزنا؛ بكى الْمَيِّت: رثاه) / بَكَى, رَثَى (دَمَعَتْ عَيناهُ حزنا؛ بكى الْمَيِّت: رثاه)\nمثال: بكى زيري كثيرا.",
 "憂き": "لَعُوق",
 "憂き世": "ضَوْء أَحْمَر (النُّور؛ مصدر ضَاء)\nمثال: ضوء القمر ضعيف.",
 "憂き目": "شَقَاوَة, تَعَاسَة",
 "憂さ": "قتامة, كآبة (شعور بتوجس كئيب) / عتمة, قتامة (حالة من الظلام الجزئي أو الكلي) / تجهم, قتامة (جو من الاكتئاب والحزن)\nمثال: أشعل عود ثقاب ليبدد العتمة",
 "憂さ晴らし": "انحراف, تحويل (التحول جانباً (عن مسارك أو انتباهك أو اهتمامك)) / استجمام, ترفيه (نشاط يسلّي أو يمتع أو ينشّط) / تمويه, هجوم تضليلي (هجوم محسوب لجذب دفاع العدو بعيداً عن نقطة الهجوم الرئيسي)\nمثال: تحويل عن الطريق السريع الرئيسي",
 "憂ふ": "عَوِيل, رَثَاء / مَرْثِيَة / بَكَى, نَاحَ (دَمَعَتْ عَيناهُ حزنا؛ بكى الْمَيِّت: رثاه) / بَكَى, رَثَى (دَمَعَتْ عَيناهُ حزنا؛ بكى الْمَيِّت: رثاه)\nمثال: بكى زيري كثيرا.",
 "憂わしい": "بَائِس, تَعِيس (يتسم بالبؤس الجسدي) / بَائِس, مُثِيرٌ لِلشَّفَقَة (يَسْتَحِقُّ الشَّفَقَةَ أَوْ يَسْتَدْعِيهَا) / حَقِير, دَنِيء (مستنكَر أخلاقياً؛ يستحق الاحتقار) / بَائِس, مُعَذَّب (شَديد التَّعاسَة؛ مَليء بالبُؤس والشَّقاء)",
 "憂事": "شَقَاوَة, تَعَاسَة",
 "憂哭": "شهيق البكاء, نشيج (شهقة تشنجية تحدث أثناء البكاء)",
 "憂思": "ثَاكِل, مَفْجُوع (حزين بسبب فقدان أو حرمان)",
 "憂患": "حُزْن (يقالُ: أَصابَهُ حَزَنٌ شَديدٌ وحُزْنٌ شَديدٌ:(الهَمُّ)؛ حَزِنَ الرّجل : اغْتَمَّ ، حزِنت المرأة:لبست السّواد)\nمثال: شعر توم بالحزن.",
 "憂悶": "عذاب, غم (ضيق عقلي شديد) / ألم شديد, كمد (ضيق شديد في الجسم أو العقل)",
 "憂愁": "سَوْدَاوِيَّة",
 "憂慮": "قَلَق (شاعر بالقَلَق؛ تَحَرّك/اهتزاز/اضطراب في الوضع الطبيعي للشيء) / قَلَق, اِضْطِرَاب الْقَلَق (شاعر بالقَلَق؛ تَحَرّك/اهتزاز/اضطراب في الوضع الطبيعي للشيء)\nمثال: ليلى قلقة بشأنك.",
 "憂慼": "غَمّ, حُزْن",
 "憂懼": "خَوْف, وَهَل / خَافَ, خَشِيَ (ضد أَمِنَ، خَشِي على نفسه أو ماله؛ فَزَعَ وخَشِيَ) / خَافَ عَلَى, خَشِيَ عَلَى (ضد أَمِنَ، خَشِي على نفسه أو ماله؛ فَزَعَ وخَشِيَ)\nمثال: خاف زيري نوعا ما.",
 "憂戚": "غَمّ, حُزْن",
 "憂欝症": "سَوْدَاوِيَّة",
 "憂色": "قتامة, كآبة (شعور بتوجس كئيب) / عتمة, قتامة (حالة من الظلام الجزئي أو الكلي) / تجهم, قتامة (جو من الاكتئاب والحزن)\nمثال: أشعل عود ثقاب ليبدد العتمة",
 "憂苦": "مُشْكِلَة, مَتاعِب",
 "憂虞": "قَلَق (شاعر بالقَلَق؛ تَحَرّك/اهتزاز/اضطراب في الوضع الطبيعي للشيء) / قَلَق, اِضْطِرَاب الْقَلَق (شاعر بالقَلَق؛ تَحَرّك/اهتزاز/اضطراب في الوضع الطبيعي للشيء)\nمثال: ليلى قلقة بشأنك.",
 "憂鬱": "مُنْخَفَض",
