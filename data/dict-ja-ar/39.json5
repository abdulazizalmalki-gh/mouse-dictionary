 "手継": "إرث عائلي, تحفة متوارثة (شيء كان موجوداً في العائلة لأجيال) / إرث عائلي, تحفة متوارثة ((قانون) أي ممتلكات يعتبرها القانون أو العرف غير قابلة للفصل عن الميراث وتورث معه)",
 "手続": "اِجْرَاء",
 "手続き": "اِجْرَاء",
 "手続き上": "إِجْرَائِيّ, شَكْلِيّ (يتعلق بممارسة المحكمة والإجراءات بدلاً من مبادئ القانون) / إجرائي (من أو متعلق بالإجراءات)\nمثال: القانون الإجرائي",
 "手続き法": "قَانُون إِجْرَائِيّ (مقياس كل شيء وطريقه؛ أمر كليّ ينطبق على جميع جزئياته التي تعرف أحكامها منه)\nمثال: ذكرني بالقانون.",
 "手続き的": "إِجْرَائِيّ, شَكْلِيّ (يتعلق بممارسة المحكمة والإجراءات بدلاً من مبادئ القانون) / إجرائي (من أو متعلق بالإجراءات)\nمثال: القانون الإجرائي",
 "手続法": "قَانُون إِجْرَائِيّ (مقياس كل شيء وطريقه؛ أمر كليّ ينطبق على جميع جزئياته التي تعرف أحكامها منه)\nمثال: ذكرني بالقانون.",
 "手綱": "زِمَام, عِنَان / سَيْطَرَ / تَحَكُّم, مُرَاقَبَة (\"تَحَكَّمَ فِي أُمُورِهِ الشَّخْصِيَّةِ\" : ضَبَطَهَا وَأَحْكَمَهَا؛ \"يَتَحَكَّمُ فِي أُمُورِ غَيْرِهِ\" : يَتَصَرَّفُ فِيهَا كَمَا يَشَاءُ وَيُرِيدُ)\nمثال: من أنت لتحكم علي؟",
 "手編み": "تريكو, حياكة (صنع الملابس المحاكة) / تريكو, حياكة (أشغال إبرة يتم إنشاؤها عن طريق تشابك الغزل في سلسلة من الحلقات المتصلة باستخدام إبر مستقيمة بلا عيون أو بواسطة آلة)",
 "手緩い": "رَخْو, مُرْتَخٍ (يُفَرَّغ بسهولة أو بإفراط) / مُتَرَاخٍ, مُتَسَاهِل (يَفْتَقِر إِلَى الصَّرَامَة أَوِ الدِّقَّة) / رخو, مرتخٍ (يفتقر إلى الحزم أو الشد؛ غير مشدود) / رخو (صوتياً) (يُنطق بعضلات لسان وفك مرتخية نسبيًا) / بَطِيء / أَبْطَأَ, بَطَّأَ",
 "手練": "مَهَارَة / إخضاع, سيادة (فعل السيطرة على شخص ما أو إخضاعه) / إتقان, تمكن (مهارة ومعرفة كبيرة بموضوع أو نشاط ما) / تفوق, سيادة (القدرة على الهيمنة أو الفوز)\nمثال: تمكن جيد من الفرنسية",
 "手練れ": "إخضاع, سيادة (فعل السيطرة على شخص ما أو إخضاعه) / إتقان, تمكن (مهارة ومعرفة كبيرة بموضوع أو نشاط ما) / تفوق, سيادة (القدرة على الهيمنة أو الفوز)\nمثال: تمكن جيد من الفرنسية",
 "手練手管": "حيلة, خديعة (استخدام الحيل لخداع شخص ما (عادة لانتزاع المال منه))",
 "手織": "مَنْسُوجٌ يَدَوِيًّا (منسوج على نول يدوي)",
 "手織り": "مَنْسُوجٌ يَدَوِيًّا (منسوج على نول يدوي)",
 "手繰り": "تَرْتِيب (تنظيم الأشياء أو الأحداث في تسلسل معين أو وضعها في نظام؛ إعداد أو تجهيز شيء لتحقيق غاية معينة)\nمثال: أعاد زيري ترتيب المطبخ كلية. / شبكة",
 "手繰り出す": "أَثَر (عَلَامَة؛ بَقِيَّة؛ رَسْم مُتَخَلَّف من شيء ما؛ تأثير؛ انطباع) / لِوْحَة دَارَاتُ مَطَبُوعَة\nمثال: اختفى فلم ير له أثر.",
 "手繰り寄せる": "اِجْتَذَبَ, جَذَبَ",
 "手繰り網": "شبكة",
 "手繰る": "أَثَر (عَلَامَة؛ بَقِيَّة؛ رَسْم مُتَخَلَّف من شيء ما؛ تأثير؛ انطباع) / لِوْحَة دَارَاتُ مَطَبُوعَة\nمثال: اختفى فلم ير له أثر.",
 "手纏": "سِوَار / مشروب مقوي, منشط (مقوي أو منشط (خاصة مشروب كحولي)) / حامي الساعد, واقي الذراع (غطاء واقٍ للمعصم أو الذراع يستخدم في الرماية والمبارزة ورياضات أخرى)",
 "手羽": "جناح دجاجة (جناح الدجاجة)",
 "手羽先": "جناح دجاجة (جناح الدجاجة)",
 "手羽肉": "جناح دجاجة (جناح الدجاجة)",
 "手習": "ذَاكَرَ, دَرَسَ / دَرَسَ ((متعدٍّ بنفسه) عَلَّمَ، لَقَّنَ؛ اِمْتَهَنَ التَّعْلِيم) / دَرَسَ, تَعَلَّمَ ((متعدٍّ بنفسه) عَلَّمَ، لَقَّنَ؛ اِمْتَهَنَ التَّعْلِيم) / تَعَلُّم, دِرَاسَة (اكتسب معرفة أو خبرة أو مهارة) / مَكْتَب (الموضع الذي يُكتَب عليه. بعكس المَكْتَب الذي يكتب فيه؛ مِنْضَدَة مخصصة للكتابة، سواء كانت للمَكَاتِب أم لغيرها)\nمثال: أراك بعد الدرس.",
 "手習い": "ذَاكَرَ, دَرَسَ / دَرَسَ ((متعدٍّ بنفسه) عَلَّمَ، لَقَّنَ؛ اِمْتَهَنَ التَّعْلِيم) / دَرَسَ, تَعَلَّمَ ((متعدٍّ بنفسه) عَلَّمَ، لَقَّنَ؛ اِمْتَهَنَ التَّعْلِيم) / تَعَلُّم, دِرَاسَة (اكتسب معرفة أو خبرة أو مهارة) / مَكْتَب (الموضع الذي يُكتَب عليه. بعكس المَكْتَب الذي يكتب فيه؛ مِنْضَدَة مخصصة للكتابة، سواء كانت للمَكَاتِب أم لغيرها)\nمثال: أراك بعد الدرس.",
 "手翰": "حَرْف, حرف (طَرَف وَجَانِب وَحَدّ؛ رَمْز مخطوط أو مطبوع يقوم مقام صوت أو كلمة أو عبارة أو معنى) / رِسَالَة, مَكْتُوب\nمثال: ألف هو الحرف الأول للألف باء.",
 "手職": "حِرْفَة يَدَوِيَّة",
 "手腕": "قُدْرَة, مَقْدِرَة / مَوْهِبَة",
 "手芸": "حِرْفَة يَدَوِيَّة",
 "手芸品": "حِرْفَة يَدَوِيَّة",
 "手荒": "عَنِيف",
 "手荒い": "عَنِيف",
 "手荷物": "أمتعة يدوية, حقائب يد (الأمتعة الخفيفة بما يكفي لحملها باليد)",
 "手荷物一時預かり所": "قَصِير الأَمَد (مُتَعَلِّق بِفَتْرَة زَمَنِيَّة مَحْدودَة أَوْ مُمْتَدّ عَلَيْها)",
 "手荷物棚": "رف أمتعة, رف سقف (حامل لحمل الأمتعة فوق مقاعد القطار أو فوق السيارة)",
 "手荷物検査": "حقيبة محمولة باليد (في الطائرة) (الأمتعة أو الحقائب التي تؤخذ إلى داخل الطائرة مع الراكب، بدلاً من شحنها)",
 "手落ち": "سهو, غفلة (خطأ ناتج عن عدم الانتباه) / إشراف, رقابة (الإدارة من خلال الإشراف على أداء أو تشغيل شخص أو مجموعة) / سهو, غفلة غير مقصودة (إغفال غير مقصود ناتج عن الفشل في ملاحظة شيء ما)",
 "手蔓": "صِلَة, صُلَة / عَلَاقَة, صِلَة",
 "手蔓縺": "نجم السلة (أي حيوان يشبه نجم البحر له أذرع نحيلة متفرعة بشكل معقد ومتشابكة تشع من قرص مركزي)",
 "手蔓藻蔓": "نجم السلة (أي حيوان يشبه نجم البحر له أذرع نحيلة متفرعة بشكل معقد ومتشابكة تشع من قرص مركزي)",
 "手薄": "اخْتِزَالِيّ, مُخْتَزَل (مكتوب بشكل مختصر أو رمزيّ) / اختزال, كتابة مختزلة (طريقة للكتابة بسرعة باستخدام نظام رمزي مختصر) / غير كافٍ, قاصر (كمية غير قادرة على تلبية حاجة أو متطلب)\nمثال: أموال غير كافية",
 "手術": "عَمَلِيَّة جِرَاحِيَّة, جِرَاحَة / جِرَاحَة / خفة اليد (براعة يدوية في تنفيذ الحيل)",
 "手術台": "طاولة العمليات (طاولة يستلقي عليه المريض أثناء العملية الجراحية)",
 "手術器具": "أداة جراحية (أداة طبية تستخدم في الجراحة)",
 "手術室": "غرفة عمليات (غرفة في مستشفى مجهزة لإجراء العمليات الجراحية)\nمثال: يتم توخي الحذر الشديد للحفاظ على تعقيم غرف العمليات",
 "手術衣": "رداء جراحي (رداء واقٍ يرتديه الجراحون أثناء العمليات)",
 "手袋": "قُفَّاز, كَفّ",
 "手裏剣": "شُورِيكِن, شُورِيكِين",
 "手製": "مشغول يدوياً, يدوي الصنع (مصنوع باليد أو بعملية يدوية)\nمثال: فساتين أطفال دقيقة يدوية الصنع",
 "手製爆弾": "عبوة ناسفة مرتجلة (جهاز متفجر يتم ارتجاله)",
 "手解き": "إطلاق, استحثاث (فعل يحرك سلسلة من الأحداث) / إنشاء, ابتداء (فعل بدء شيء ما لأول مرة؛ تقديم شيء جديد) / اطلاع, دراية (الحكمة كما تتضح من امتلاك المعرفة) / انضمام, تعيين (الدخول الرسمي في منظمة أو منصب أو وظيفة)\nمثال: تطلعت إلى بدايتها كشخص بالغ",
 "手触り": "تحسس / شَعَرَ (العِلْم؛ في : هو كلام مُقَفَّى ومُوَازَن على أوزان معروفة يُقصد به إظهار الكلام بصيغة فنية) / شَعَرَ بِ (العِلْم؛ في : هو كلام مُقَفَّى ومُوَازَن على أوزان معروفة يُقصد به إظهار الكلام بصيغة فنية)\nمثال: شعر ماريا طويل.",
 "手記": "مُلَاحَظَة, مَلْحُوظَة / مُذَكَّرَة / دَرَجَة / مُذَكَّرَات, مُذَكِّرَات",
 "手許": "بالقرب, في مكان قريب (ليس بعيداً بالمصطلحات النسبية) / قَرِيب, مُجَاوِر (على مقربة؛ في متناول اليد)\nمثال: هي تعمل في مكان قريب / مَهَارَة / مَصْرُوف جَيْب, مَصْرُوف / مَقْبِض",
 "手許金": "سيولة فورية, نقد جاهز (المال في شكل نقد متاح بسهولة)\nمثال: كانت زوجته دائماً مصدراً جيداً للنقد الجاهز",
 "手詰まり": "جمود, طريق مسدود (وضع لا يمكن فيه إحراز تقدم أو لا يمكن فيه أي تقدم)\nمثال: وصلوا إلى طريق مسدود في المفاوضات",
 "手詰め": "ضغط, كبس (فعل الضغط؛ بذل الضغط) / عَاجِل, مُلِحّ (يَسْتَوْجِبُ إِجْرَاءً فَوْرِيًّا) / قطعة مضغوطة (جزء معدني أو بلاستيكي مصنوع بواسطة مكبس ميكانيكي)\nمثال: ضغط على الزر",
 "手話": "لُغَةُ إِشَارَة (هِيَ مجموعة من الأصوات التي يصدرها الإنسان على شكل كلمات منظمة بقواعد، ليتواصل به الناس وينقلون به الافكار والمعاني، اللسان؛ يقصد بها أحيانا اللهجة)\nمثال: الأمازيغية لغة.",
 "手話法": "لُغَةُ إِشَارَة (هِيَ مجموعة من الأصوات التي يصدرها الإنسان على شكل كلمات منظمة بقواعد، ليتواصل به الناس وينقلون به الافكار والمعاني، اللسان؛ يقصد بها أحيانا اللهجة)\nمثال: الأمازيغية لغة.",
 "手話言語": "لُغَةُ إِشَارَة (هِيَ مجموعة من الأصوات التي يصدرها الإنسان على شكل كلمات منظمة بقواعد، ليتواصل به الناس وينقلون به الافكار والمعاني، اللسان؛ يقصد بها أحيانا اللهجة)\nمثال: الأمازيغية لغة.",
 "手談": "ذَهَبَ, رَاحَ (في : التِبْر، مَعْدِن ثَمِين أصْفَر اللَّوْنِ، هُوَ أَسَاسُ التَعَامُلِ المَالِيّ وَيُسْتَخْدَمُ أَيْضاً فِي صِنَاعَةِ الْحُلِيّ وَالْمُجَوْهَرَات؛ هَذَا رَجُل ذَهَبا: أَيْ رَجُلٌ يُسَاوِي ذَهَباً فِي قِيمَتِهِ وَقدره) / ذَهَبَ, زَالَ (في : التِبْر، مَعْدِن ثَمِين أصْفَر اللَّوْنِ، هُوَ أَسَاسُ التَعَامُلِ المَالِيّ وَيُسْتَخْدَمُ أَيْضاً فِي صِنَاعَةِ الْحُلِيّ وَالْمُجَوْهَرَات؛ هَذَا رَجُل ذَهَبا: أَيْ رَجُلٌ يُسَاوِي ذَهَباً فِي قِيمَتِهِ وَقدره) / غُو\nمثال: ذهب إلى الدكان.",
 "手負い": "جَرِيح / مَجْرُوح",
 "手足": "طَرَف, عُضْو\nمثال: 手足がむくんでいます。 — تورمت قدميّ و يديّ.",
 "手足れ": "إخضاع, سيادة (فعل السيطرة على شخص ما أو إخضاعه) / إتقان, تمكن (مهارة ومعرفة كبيرة بموضوع أو نشاط ما) / تفوق, سيادة (القدرة على الهيمنة أو الفوز)\nمثال: تمكن جيد من الفرنسية",
 "手足を伸ばす": "مَدَّدَ / اِمْتَدَّ",
 "手跡": "خَطّ يَد, خَطّ (كِتَابَة؛ ما يَصِل نقطتين أو أكثر)\nمثال: إرسم خط مستقيم. / صورة ثلاثية الأبعاد, هولوغرام (الصورة الوسيطة (أو السجل الفوتوغرافي) التي تحتوي على معلومات لإعادة إنتاج صورة ثلاثية الأبعاد عن طريق التصوير المجسم) / مخطوطة (كتاب أو وثيقة مكتوبة بخط اليد)",
 "手蹟": "خَطّ يَد, خَطّ (كِتَابَة؛ ما يَصِل نقطتين أو أكثر)\nمثال: إرسم خط مستقيم. / صورة ثلاثية الأبعاد, هولوغرام (الصورة الوسيطة (أو السجل الفوتوغرافي) التي تحتوي على معلومات لإعادة إنتاج صورة ثلاثية الأبعاد عن طريق التصوير المجسم) / مخطوطة (كتاب أو وثيقة مكتوبة بخط اليد)",
 "手車": "عربة دفع, عربة يدوية (مركبة بعجلات يمكن دفعها بواسطة شخص؛ قد يكون لها عجلة واحدة أو عجلتان أو أربع عجلات)\nمثال: استخدم عربة يدوية لنقل الصخور بعيداً",
 "手軽": "سَهْل (ضد الصَعْب، اليَسِير. لا جمع له؛ الشيء المُمَهَّد اللَيِّن. لا جمع له)\nمثال: هذا الشعور سهل.",
 "手軽い": "سَهْل (ضد الصَعْب، اليَسِير. لا جمع له؛ الشيء المُمَهَّد اللَيِّن. لا جمع له)\nمثال: هذا الشعور سهل.",
 "手込め": "اِغْتِصَاب (أَخْذُ الشيء قَهْراً وَظُلْماً؛ اِسْتِخْدَامُ العُنْفِ مَعَ النساء لِنَيْلِ الحَاجَةِ مِنْهَن بِالرَّغْمِ عَنْهَن) / اِغْتَصَبَ, غَصَبَ (غَصَبَ؛ زَنَى (بِفُلَانَةٍ) قَهْرًا/غَصْبًا)\nمثال: تعرض زيري للاغتصاب.",
 "手近": "قَرِيب / قَرِيبًا / بِٱلْقُرْب مِنَ, عِنْدَ / قَرُبَ (أَدْنَى؛ قدَّرَ)\nمثال: جلست بالقرب منها. / مَأْلُوف",
 "手近か": "قَرِيب / قَرِيبًا / بِٱلْقُرْب مِنَ, عِنْدَ / قَرُبَ (أَدْنَى؛ قدَّرَ)\nمثال: جلست بالقرب منها. / مَأْلُوف",
 "手透き": "حُرّ, غَيْر مَخْطُوب (لم يُعطِ وعدًا بالزواج؛ غير مرتبط) / غَيْر مَشْغُول, فَارِغ (غَيْر مُنْشَغِل؛ حُرّ ومُتَاح) / خُلُو مِن اَلْعَمَل / رَاحَة, خُلُو مِن اَلْعَمَل",
 "手造り": "مشغول يدوياً, يدوي الصنع (مصنوع باليد أو بعملية يدوية)\nمثال: فساتين أطفال دقيقة يدوية الصنع",
 "手造り品": "حِرْفَة يَدَوِيَّة",
 "手遊び": "ألعوبة, لعبة (شيء مصنوع مصمم للعب به) / قِمَار, مُقَامَرَة / انحراف, تحويل (التحول جانباً (عن مسارك أو انتباهك أو اهتمامك)) / استجمام, ترفيه (نشاط يسلّي أو يمتع أو ينشّط) / تمويه, هجوم تضليلي (هجوم محسوب لجذب دفاع العدو بعيداً عن نقطة الهجوم الرئيسي)\nمثال: تحويل عن الطريق السريع الرئيسي",
 "手違い": "أَسَاء اَلْفَهْم, أَخْطَأَ / خَطَأ, غَلْطَة (تعني ضدّ الصواب. يشمل ذلك الفعل، القول، والرأي. يُستخدم الفعل \"أخطأ\" للدلالة على عدم الإصابة…؛ قام بعمل بعيد عن الصواب أو مخالف للحق سواء كان ذلك في السلوك أو القول أو الكتابة)\nمثال: كان خطأ حاسوبي.",
 "手配": "تَرْتِيب (تنظيم الأشياء أو الأحداث في تسلسل معين أو وضعها في نظام؛ إعداد أو تجهيز شيء لتحقيق غاية معينة)\nمثال: أعاد زيري ترتيب المطبخ كلية. / طَلَب, بَحْث (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى)) / بَحَثَ, فَتَّشَ (طَلَب الشيء في التُرَاب؛ طلب الشيء في أي مكان والتَفْتِيش والتَقَصِّي عنه) / بَحَثَ عَنْ (طَلَب الشيء في التُرَاب؛ طلب الشيء في أي مكان والتَفْتِيش والتَقَصِّي عنه)\nمثال: طلب زيري ورودا.",
 "手配り": "تَرْتِيب (تنظيم الأشياء أو الأحداث في تسلسل معين أو وضعها في نظام؛ إعداد أو تجهيز شيء لتحقيق غاية معينة)\nمثال: أعاد زيري ترتيب المطبخ كلية.",
 "手配ミス": "خطأ فادح, زلة (خطأ محرج)",
 "手配写真": "صورة جنائية (صورة لوجه شخص ما (خاصة تلك التي تؤخذ لسجلات الشرطة))",
 "手配書": "إعلان مطلوبين, ملصق مطلوبين (إعلان عام من قبل وكالة إنفاذ القانون برغبتهم في استجواب أو اعتقال شخص ما)",
 "手酷い": "جَسِيم, خَطِير (يُثير الخوف أو القلق بتهديده بأذى عظيم) / حَادّ, وَخِيم (سيء جداً في درجته أو مداه) / إسْبَرْطِيّ, شَدِيد (لا يرحم ولا يتهاون في الانضباط أو الحكم) / فَظِيع, وَخِيم (بَالِغُ السُّوءِ أَوِ الفَظَاعَةِ فِي الدَّرَجَةِ أَوِ النَّوْع)",
 "手金": "وَدِيعَة / أَوْدَعَ (الثَوْب أو ما أشبه: صانه بأن وضعه في صِوَان أو مكان لا يؤْذَى فيه؛ فلانًا مالًا: دفعه إليه ليكون عنده وديعة. ويكون أيضا بمعنى قبل الوديعة)\nمثال: غادرت المنزل دون أن أودع أهلي.",
 "手釣": "خيط صيد يدوي (خيط صيد يُدار بشكل أساسي باليد) / حبل يدوي ((في التسلق) حبل يمكن التمسك به باليدين أثناء الصعود أو النزول في قسم شديد الانحدار أو زلق لتوفير حماية محدودة)",
 "手釣り": "خيط صيد يدوي (خيط صيد يُدار بشكل أساسي باليد) / حبل يدوي ((في التسلق) حبل يمكن التمسك به باليدين أثناء الصعود أو النزول في قسم شديد الانحدار أو زلق لتوفير حماية محدودة)",
 "手錠": "أَصْفَاد, أَغْلَال",
 "手鍋": "مِقْلَاة (وعاء قلي الطعام) / ينتقد بشدَة",
 "手鍋提げても": "بكل الوسائل, بكل تأكيد (بالتأكيد أو يقيناً)\nمثال: زرنا بكل تأكيد",
 "手鑑": "نَمُوذَج / نَمُوذَج مُصَغَّر / قَدْوَة (من يُقتدى به)",
 "手長": "طَوِيل الذِّرَاعَيْن (ذو ذراعين طويلتين نسبيًّا)",
 "手長猿": "غِيبُون, جِبَّوْن",
 "手長蛸": "طَوِيل الذِّرَاعَيْن (ذو ذراعين طويلتين نسبيًّا)",
 "手間": "وَقْت (\"بَقِيَ وَقْتاً عِنْدَهُ \" : أَيْ مِقْدَاراً مِنَ الزَّمَنِ؛ \"جَاءَ فِي الوَقْتِ الْمُنَاسِبِ \" : فِي اللَّحْظَةِ الْمُنَاسِبَةِ) / مَرَّة, مرة (مؤنث مُرّ، صفة ما كان بها مرارة) / حِين, وَقْت ((حَيَّنَه): جعل لَهُ حينا؛ (حَيَّنَ) الله فلَانا: لم يوفقه للرشاد)\nمثال: حان وقت الذهاب. / دَفْع (لزّه ونحاه وأبعده؛ صرفه قبل وروده، أي منعه وأبعده قبل مجيئه أو حدوثه، وعكسه أن يرفعه، اي أن يصرفه بعد حدوثه)\nمثال: دفع زيري الثمن. / مُسْتَغْرِق وَقْتًا طَوِيلًا",
 "手間ひま": "مُشْكِلَة, مَتاعِب",
 "手間仕事": "مُسْتَغْرِق وَقْتًا طَوِيلًا",
 "手間代": "دَفْع (لزّه ونحاه وأبعده؛ صرفه قبل وروده، أي منعه وأبعده قبل مجيئه أو حدوثه، وعكسه أن يرفعه، اي أن يصرفه بعد حدوثه)\nمثال: دفع زيري الثمن.",
 "手間損": "مضيعة للوقت, هدر الوقت (تكريس الوقت لنشاط غير مجد)\nمثال: قد يكون هدر الوقت قاتلاً",
 "手間暇": "مُشْكِلَة, مَتاعِب",
 "手間潰し": "مضيعة للوقت, هدر الوقت (تكريس الوقت لنشاط غير مجد)\nمثال: قد يكون هدر الوقت قاتلاً",
 "手間賃": "دَفْع (لزّه ونحاه وأبعده؛ صرفه قبل وروده، أي منعه وأبعده قبل مجيئه أو حدوثه، وعكسه أن يرفعه، اي أن يصرفه بعد حدوثه)\nمثال: دفع زيري الثمن.",
 "手間隙": "مُشْكِلَة, مَتاعِب",
 "手隙": "حُرّ, غَيْر مَخْطُوب (لم يُعطِ وعدًا بالزواج؛ غير مرتبط) / غَيْر مَشْغُول, فَارِغ (غَيْر مُنْشَغِل؛ حُرّ ومُتَاح) / خُلُو مِن اَلْعَمَل / رَاحَة, خُلُو مِن اَلْعَمَل",
 "手際": "مَهَارَة / أَدَاء / مَسْرَحِيَّة",
 "手際よく": "بِفَعَّالِيَّة, بِكَفَاءَة (مع الكفاءة؛ بطريقة فعالة)\nمثال: يعمل بكفاءة",
 "手際良く": "بِفَعَّالِيَّة, بِكَفَاءَة (مع الكفاءة؛ بطريقة فعالة)\nمثال: يعمل بكفاءة",
 "手離し": "بشكل علني, بصراحة (بطريقة مفتوحة)\nمثال: تباهى علانية بعاطفته تجاه أخته",
 "手離す": "أَطْلَقَ سَرَاح, حَرَّرَ / رَحِمَ (رَحِم: عضو تناسلي أنثوي داخلي مستجيب للهرمون الأنثوي في الجهاز التناسلي لدى البشر ومعظم الثدييات الأخرى؛ الجمع: أرحام)\nمثال: رحمة الله عليه.",
 "手頃": "فِي مُتَنَاوَل اليَد, قَرِيب (سهل الوصول إليه وقريب) / صَنَاعِيّ, مَاهِر اليَدَيْن (ماهر في العمل اليدوي) / عَمَلِيّ, مُفِيدٌ وَمُلَائِم (مُفِيدٌ وَمُرِيح) / مُنَاسِب, مُلَائِم",
 "手順": "عَمَلِيَّة / عِلْمِيَّة, مُعَالَجَة / جَهَّزَ (جَهاز العَرُوس وَالْمَيِّتِ وجِهازهما: مَا يَحْتَاجَانِ إِليه؛ جَهَّزَه فَتَجَهَّز وجَهَّزْتُ العروسَ تَجْهِيزاً، وَكَذَلِكَ جَهَّزت الْجَيْشَ)\nمثال: جهز زيري حقائبه.",
 "手風琴": "أَكُورْدِيُون",
 "手首": "مِعْصَم, رُسْغ",
 "手馴らし": "تَدْرِيب (تزويدُ الدَّارسين بالدّراسات العلميَّة والعمليّة التي تؤدِّي إلى رفع درجة المهارة عندهم في أداء واجبات الوظيفة؛ إعداد شخص أو مجموعة لتأدية مهمة أو وظيفة معينة) / مُمَارَسَة\nمثال: واصل زيري التدريب.",
 "才": "قُدْرَة, مَقْدِرَة / مَوْهِبَة",
 "才六": "طِفْل (الصَغِير السِنّ من الحَيْوَان أو الإنْسَان، وَلَد الإنسان أو الحيوان؛ الإنسان منذ أن تلده أمه حتى يَبْلُغ) / جَدْي\nمثال: هو طفل العائلة.",
 "才分": "تخلص, تصريف (فعل أو وسيلة التخلص من شيء ما) / طبع, مزاج (الحالة المزاجية المعتادة) / استعداد, ميل (عادة طبيعية أو مكتسبة أو ميل مميز في شخص أو شيء) / استعداد, ميل (موقف ذهني يميل لتفضيل بديل على آخر)\nمثال: لديه مزاج سعيد",
 "才力": "قُدْرَة, مَقْدِرَة / مَوْهِبَة",
 "才取り": "سِمْسَار, وَسِيط",
 "才取り会員": "بُورْصَة, سُوقُ الْأَوْرَاقِ الْمَالِيَّةِ",
 "才取会員": "بُورْصَة, سُوقُ الْأَوْرَاقِ الْمَالِيَّةِ",
 "才名": "شُهْرَة",
 "才器": "مَوْهِبَة",
 "才幹": "قُدْرَة, مَقْدِرَة / مَوْهِبَة",
 "才未満": "أَصْغَر مِن, صُغْرَى مِن",
 "才気": "حِكْمَة (مؤنث حَكَم)\nمثال: خذ الحكمة من أي وعاء خرجت.",
 "才気煥発": "سَرِيع البَدِيهَة (ذكي وسريع الحيلة ذهنياً)",
 "才能": "مَوْهِبَة",
 "才腕": "مَهَارَة",
 "才華": "مَوْهِبَة",
 "才覚": "حُسْن التَّصَرُّف, دَهَاء (صفة القدرة على التعامل مع المواقف الصعبة) / دهاء, سعة الحيلة (القدرة على التعامل بدهاء مع المشاكل غير العادية)\nمثال: رجل ذو دهاء عظيم / تربية, تنشئة (مساعدة شخص ما على النمو ليكون عضواً مقبولاً في المجتمع) / مُتَزَايِد, مُرْتَفِع (يزداد في الكمّيّة أو القيمة) / تنشئة, رعاية (الخصائص المكتسبة نتيجة للطريقة التي عوملت بها كطفل) / ارتفاع, رفع (حدث رفع شيء ما إلى الأعلى)\nمثال: ارتفاع في درجة الحرارة بعد الظهر",
 "才覚者": "سَرِيع البَدِيهَة (ذكي وسريع الحيلة ذهنياً)",
 "才量": "قياس (فعل أو عملية تعيين أرقام للظواهر وفقًا لقاعدة)\nمثال: تمت القياسات بعناية",
 "打": "ضرب الكرة ((بيسبول) محاولة الضارب للوصول إلى القاعدة) / حشوة قطنية, لباد (حشو مصنوع من لفات أو صفائح من الصوف القطني أو الألياف الصناعية)",
 "打々": "مُتَصَادِم, مُتَنَافِر (متنافر بشكل حادّ وقاسٍ)",
 "打けん": "ضربة مفتاح (ضربة مفتاح؛ ضغطة واحدة على مفتاح في لوحة المفاتيح)\nمثال: تم استخدام عدد ضربات المفاتيح كمقياس للعمل",
 "打たれ強い": "مَرِن",
 "打ちこわし": "تَدْمِير, هَدْم",
 "打ちしおれる": "تدلي, ترهل (شكل يتدلى أو يهبط للأسفل)\nمثال: كان هناك هبوط في مقعد الكرسي",
 "打ちそこなう": "أَخْطَأَ ((أخْطَأَ): خَطِئَ؛ (أخْطَأَ) غَلِظَ (حاد عن الصواب)) / فَاتَ / اِفْتَقَدَ, اِشْتَاقَ / آنِسَة\nمثال: اعترف أنه أخطأ.",
 "打ちだし": "دك, طرق (فعل الطرق (توجيه ضربات ثقيلة متكررة))\nمثال: فاجأه طرق القبضات المفاجئ / عَبَدَ (خلاف الحُرّ، المَمْلُوْك، من له مالك يملكه. الجمع عبيد وأعبد وعِبدان وعُبدان؛ الإنسان حرا كان أم لا مؤمنا كان أن ملحدا من حيث أنه مملوك لله) / خَدَمَ (عَمِلَ أو سَاعَدَ شخصًا أو جهة؛ أَدَارَ خدمة أو مهمة) / قَدَّمَ (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى الرُّسْغَ؛ أنّ لهم سابقةً وفضلاً له عند فلان قَدَمٌ : معروف) / أَرْسَلَ (بَعَثَ؛ أَطْلَقَ) / إِرْسَال (الإرْسال : الإطلاق؛ النقل والبَعْث من مكان إلى آخر)\nمثال: ماذا أنجز عبد العزيز بوتفليقة؟ / مطبوعة, نسخة مطبوعة (مخرجات الكمبيوتر في شكل مطبوع)",
 "打ちだす": "طَبَعَ (طَبَعَ الله الخلقَ : أَنشأَهُ؛ طبَعَت الدَّوْلةُ النَّقْد : صاغتْه ونقشته)\nمثال: بالطبع هي مزحة! / ضَرَبَ (معروف، وهو اللطم أو الدق أو الصكّ و ما أشبه؛ النَوْع أو الصنف أو المثال) / إِضْرَاب\nمثال: ضرب سامي زوجته.",
 "打ちっぱなし": "ميدان غولف (ميدان تدريب للتدرب على ضربات الغولف)",
 "打ちっ放し": "ميدان غولف (ميدان تدريب للتدرب على ضربات الغولف)",
 "打ちつける": "ظُفْر, ضفر (الجزء المتقرن الميت على طرف الأصبع من الإنْسَان وبعض الحَيْوَانَات) / مِسْمَار, مسمار (وتد صغير من حَدِيد أحد طرفيه مسنون والآخر له رأس يدق في الخشب والجدران وغيرها للتثبيت؛ غِلْظ صغير مخروطي الشكل قد يحدث في أصابع القدم أو في أخْمَص القدم)\nمثال: نبت ظفر أصبع رجلي الكبير. / فَرْقَعَة / رَمَى, صَبَّ ((مُتَعَدٍّ بِنَفْسِهِ) جَعَلَهُ يَتَحَرَّكُ فِي الهَوَاءِ)\nمثال: رمى تلك الموزة.",
 "打ちどころ": "بُقْعَة",
 "打ちのめす": "أَرْضِيَّة, أَرْض (ما يقابل السَقْف من الغرفة؛ قاع الشيء) / طَابِق\nمثال: انهارت الأرضية. / هَرَسَ (سَحَقَ أو دَكَّ شيئًا بقوة حتى يتفتت؛ طَحَنَ أو فَتَّتَ شيئًا)",
 "打ちひしぐ": "هَرَسَ (سَحَقَ أو دَكَّ شيئًا بقوة حتى يتفتت؛ طَحَنَ أو فَتَّتَ شيئًا)",
 "打ち上げ": "أَطْلَقَ, قَذَفَ / نِهَايَة, غَايَة / غَايَة / اِنْتَهَى, أَنْهَى (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات)\nمثال: انتهى أمر زيري.",
 "打ち上げる": "أَطْلَقَ, قَذَفَ / شَحْطَة / شَرْطَة / فَرَغَ, أَنْهَى / اِنْتَهَى (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات)\nمثال: انتهى أمر زيري. / وَصَفَ, أَبْلَغَ / أَبْلَغَ (أَكْثَرُ بَلَاغَة) / تَقْرِير, بَلَاغ\nمثال: أبلغ توم تحياتي.",
 "打ち上げ花火": "شمروخ, صاروخ ألعاب نارية (يرسل عرضًا للألعاب النارية عاليًا في السماء) / شمروخ, صاروخ (يدفع ضوءاً ساطعاً عالياً في السماء، أو يُستخدم لدفع حبل إنقاذ أو حربة)",
 "打ち下ろし": "مُنْحَدِرًا, نَحْو الأَسْفَل (باتجاه أسفل التل) / فِي انْحِدَار, نَحْو الأَسْوَأ (نحو حالة أدنى أو أسوأ) / مُنْحَدِر, هَابِطٌ بِشِدَّة (يَنْحَدِرُ نَحْوَ الأَسْفَلِ بِحِدَّة) / تزلج الانحدار, سباق الانحدار (سباق تزلج أسفل منحدر)\nمثال: عند الجري نحو الأسفل، اكتسب الكثير من السرعة",
 "打ち付ける": "ظُفْر, ضفر (الجزء المتقرن الميت على طرف الأصبع من الإنْسَان وبعض الحَيْوَانَات) / مِسْمَار, مسمار (وتد صغير من حَدِيد أحد طرفيه مسنون والآخر له رأس يدق في الخشب والجدران وغيرها للتثبيت؛ غِلْظ صغير مخروطي الشكل قد يحدث في أصابع القدم أو في أخْمَص القدم)\nمثال: نبت ظفر أصبع رجلي الكبير. / فَرْقَعَة / رَمَى, صَبَّ ((مُتَعَدٍّ بِنَفْسِهِ) جَعَلَهُ يَتَحَرَّكُ فِي الهَوَاءِ)\nمثال: رمى تلك الموزة.",
 "打ち伏す": "اِسْتَلْقَى (وَضَعَ ظَهْرَهُ عَلَى سَطْحٍ كَالسَّرِيرِ والأَرْضِ للنوم أو الاستراحة) / اِضْطَجَعَ\nمثال: استلقى على السرير.",
 "打ち倒す": "صَرَعَ (طَرَحَه على الأرض؛ أَرْدَاهُ قَتِيلاً وأَهْلَكَهُ)",
 "打ち傷": "كَدَمَ / كَدْمَة, رَضّ",
 "打ち克つ": "هَزَمَ, غَلَبَ",
 "打ち出し": "دك, طرق (فعل الطرق (توجيه ضربات ثقيلة متكررة))\nمثال: فاجأه طرق القبضات المفاجئ / عَبَدَ (خلاف الحُرّ، المَمْلُوْك، من له مالك يملكه. الجمع عبيد وأعبد وعِبدان وعُبدان؛ الإنسان حرا كان أم لا مؤمنا كان أن ملحدا من حيث أنه مملوك لله) / خَدَمَ (عَمِلَ أو سَاعَدَ شخصًا أو جهة؛ أَدَارَ خدمة أو مهمة) / قَدَّمَ (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى الرُّسْغَ؛ أنّ لهم سابقةً وفضلاً له عند فلان قَدَمٌ : معروف) / أَرْسَلَ (بَعَثَ؛ أَطْلَقَ) / إِرْسَال (الإرْسال : الإطلاق؛ النقل والبَعْث من مكان إلى آخر)\nمثال: ماذا أنجز عبد العزيز بوتفليقة؟ / مطبوعة, نسخة مطبوعة (مخرجات الكمبيوتر في شكل مطبوع)",
 "打ち出す": "طَبَعَ (طَبَعَ الله الخلقَ : أَنشأَهُ؛ طبَعَت الدَّوْلةُ النَّقْد : صاغتْه ونقشته)\nمثال: بالطبع هي مزحة! / ضَرَبَ (معروف، وهو اللطم أو الدق أو الصكّ و ما أشبه؛ النَوْع أو الصنف أو المثال) / إِضْرَاب\nمثال: ضرب سامي زوجته.",
 "打ち切り": "نِهَايَة, غَايَة / غَايَة / اِنْتَهَى, أَنْهَى (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات)\nمثال: انتهى أمر زيري.",
 "打ち切り誤差": "خطأ البتر ((رياضيات) خطأ في الحساب ينتج عن قطع عملية حسابية رقمية قبل انتهائها)",
 "打ち切る": "وَقَفَ, تَوَقَّفَ (قَامَ، اِنْتَصَبَ، نَهَضَ؛ ثَبَتَ) / أَوْقَفَ, وَقَفَ / تَوَقَّفَ, وَقَّف / مَوْقِف / وَقْفَة\nمثال: وقف وراء الباب.",
 "打ち割る": "انفصل",
 "打ち勝つ": "قَهَرَ, اِنْتَصَرَ (غَلَبَ وانْتَصَرَ ولم يقدر عليه أحد) / هَزَمَ, غَلَبَ",
 "打ち取る": "قَتَلَ, قتل (تعمّد جعله يَمُوتُ، أزهق روحه، أمَاتَه متعمدا؛ الوقتَ: ضيعه بشيء غير ذي فائدة وهو ينتظر أمرا آخر) / قَتْلَة\nمثال: قتل الصياد دبا. / غَلَبَ, هَزَمَ (قَهَرَ واِعْتَزَّ عليه واِمْتَنَع) / هَزِيمَة, مَغْلُوبِيَّة",
 "打ち合う": "عَارَكَ, قَاتَلَ / تَعَارَكَ, تَقَاتَلَ / نَاضَلَ, كَافَحَ / قِتَال (من قَتَلَ: كثير القَتْل) / مَعْرَكَة\nمثال: لن يحل القتال أي شيء.",
 "打ち合わせ": "اِجْتِمَاع, مَجْلِس (جمعوا انفسهم؛ اسم يطلق على عملية جَمْع بعض الناس في مكان واحد ليتباحثوا أمرا) / مُلَاقَاة, مُقَابَلَة (لِقَاء) / مُلَاقَاة, لِقَاء (لِقَاء)\nمثال: هذا اجتماع مهم. / تراكب, طية (لسان يقع فوق جزء آخر) / تداخل (خاصية التصادف الجزئي في الوقت) / التقاء, تداخل (تمثيل للأرضية المشتركة بين النظريات أو الظواهر)\nمثال: يجب أن يكون تراكب القرميد عشر بوصات على الأقل",
 "打ち合わせる": "تَصَادُم / يتصادم / رَتَّبَ (رتَّبْته ترتيباً:ثَبَّتَه؛ رتّب الشّيء:نَسَّقَه ونَظَّمَه ووضعه في موضعه)\nمثال: رتب فاضل غرفتة.",
 "打ち壊し": "تَدْمِير, هَدْم / تَدْمِير, هَدْم / إفساد, تخريب (فعل إفساد الشيء عن طريق إلحاق الضرر به) / تلف, فساد (عملية التحول إلى شيء تالف أو فاسد)\nمثال: كان إفسادها لثوبي متعمداً",
 "打ち壊す": "دَمَّرَ / خَرَاب, خَرَابَة",
 "打ち始める": "بَدَأَ, اِبْتَدَأَ (حَدَثَ ونَشَأَ وحَصَلَ؛ أَخَذَ، شَرَعَ)\nمثال: بدأ سامي يتكلم.",
 "打ち子": "للسان الجرس, مصفق (مطرقة معدنية تتدلى داخل الجرس وتصدر صوتاً بضرب الجانب) / لسان (كتلة متحركة من الأنسجة العضلية مغطاة بغشاء مخاطي وتقع في التجويف الفموي) / مصفق (شخص يصفق)",
 "打ち寄せる": "حَمْلَة / هَاجَمَ",
 "打ち崩す": "غَلَبَ, هَزَمَ (قَهَرَ واِعْتَزَّ عليه واِمْتَنَع) / هَزِيمَة, مَغْلُوبِيَّة / اِنْكَسَرَ (فعل مطاوعة لكَسَرَ، قام أحدهم بكَسْره أو قام هو بكَسْر نفسه؛ التاجر: خَسِرَ المال ونَقَصَ عنده المال، أفْلَسَ) / كَسَرَ / اِسْتِرَاحَة (مبنى خارج المدن يتوقف فيه المسافرون للراحة والتَزَوُّد يُجمع على اِسْتِرَاحَات)\nمثال: عليك أخذ استراحة.",
 "打ち所": "بُقْعَة",
 "打ち手": "رَامٍ ((رَامَ) الجُرحُ يَرِيمُ رَيْمًا، ورَيَمَانًا: انْضَمَّ فَمُهُ للبُرْءِ؛ (رَامَ) الحِمْلُ: مالَ) / رَامِيَة / مُلقح (ممارس طبي يلقح الناس ضد الأمراض) / طبال (شخص يعزف على الطبل)",
 "打ち払う": "دَفَعَ, صَدَّ (لزّه ونحاه وأبعده؛ صرفه قبل وروده، أي منعه وأبعده قبل مجيئه أو حدوثه، وعكسه أن يرفعه، اي أن يصرفه بعد حدوثه)\nمثال: دفع زيري الثمن.",
 "打ち抜き": "لَكْمَة / لَكَمَ (معناه: ضرب بقبضة اليد أو اللكم؛ معنى آخر: الضرب بشدة) / خَرَّامَة\nمثال: لكم اشتقت إليك! / بِئْرٌ إِرْتِوَازِيَّة, بِئْرٌ إِرْتِوَازِيّ",
 "打ち抜く": "اِخْتَرَقَ / لَكْمَة / لَكَمَ (معناه: ضرب بقبضة اليد أو اللكم؛ معنى آخر: الضرب بشدة) / خَرَّامَة\nمثال: لكم اشتقت إليك! / نَقَلَ / أَزَالَ (أَزَاحَ ونَحَّى وأَبْعَدَ؛ خَلَعَ) / أَخْرَجَ / جَذَبَ (شَدَّ الشيءَ نحوه بقوة؛ لفَتَ الانتباه أو أثارَ الاهتمام)\nمثال: لا أزال عطشانا. / شَغَّلَ, نَفَّذَ ((شَغَلَ) الدارَ يَشْغَلَ شَغْلًا: سكنها؛ شَغَلَ فلانًا عن الشيء: لَهَّاهُ وصرَفَه)\nمثال: شغل بيل التلفاز.",
 "打ち拉ぐ": "هَرَسَ (سَحَقَ أو دَكَّ شيئًا بقوة حتى يتفتت؛ طَحَنَ أو فَتَّتَ شيئًا)",
 "打ち振る": "إشهار, تلويح (فعل التلويح)",
 "打ち捨てる": "طَرَحَ (طَرَحَ الشَّيْءَ: أَلْقَاهُ؛ طَرَحَ فُلَاناً أَرْضاً: أَوْقَعَهُ)\nمثال: طرح زيري سؤالا.",
 "打ち据える": "صَرَعَ (طَرَحَه على الأرض؛ أَرْدَاهُ قَتِيلاً وأَهْلَكَهُ)",
 "打ち掛かる": "ضَرَبَ (معروف، وهو اللطم أو الدق أو الصكّ و ما أشبه؛ النَوْع أو الصنف أو المثال) / إِضْرَاب\nمثال: ضرب سامي زوجته.",
 "打ち損なう": "أَخْطَأَ ((أخْطَأَ): خَطِئَ؛ (أخْطَأَ) غَلِظَ (حاد عن الصواب)) / فَاتَ / اِفْتَقَدَ, اِشْتَاقَ / آنِسَة\nمثال: اعترف أنه أخطأ.",
 "打ち放し": "ميدان غولف (ميدان تدريب للتدرب على ضربات الغولف)",
 "打ち放す": "نَار, نار (نارَتِ النارُ: أضاءَت؛ نَارَ النَّارَ مَنْ بَعِيدٍ : أَبْصَرَهَا، نَظَرَ إِلَيْهَا، تَأَمَّلَهَا) / حَرِيق, حريجة (النَار المشتعلة في شيء كالدَار او الغَابَة) / طَرَدَ\nمثال: سمعن طلقات نار.",
 "打ち明ける": "نَاجَى / فَارِغ / فَرَغَ",
 "打ち明け話": "إِقْرَار, اِعْتِرَاف / طَائِفَة (مؤنث طَائِف؛ التي تطوفُ؛ القطعة أو الجزء من الشيء أو الواحدة منه)",
 "打ち果たす": "قَتَلَ, أَزْهَقَ رُوحَهُ (تعمّد جعله يَمُوتُ، أزهق روحه، أمَاتَه متعمدا؛ الوقتَ: ضيعه بشيء غير ذي فائدة وهو ينتظر أمرا آخر)\nمثال: قتل الصياد دبا.",
 "打ち棒": "مِرْقَاق, فَرَّادَة / تَهْرِيجِيّ (يتّسم بالمُشاغبة والحركة البدنيّة في الكوميديا) / عصا التصفيق (جهاز صوتي يتكون من مضربين مفصليين معاً؛ يستخدمه الممثل لإحداث ضوضاء عالية دون التسبب في إصابة عند ضرب شخص ما) / تهريج, سلابستيك (كوميديا صاخبة تتضمن مطاردات واصطدامات ومقالب)",
 "打ち止め": "نِهَايَة, غَايَة / غَايَة / اِنْتَهَى, أَنْهَى (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات)\nمثال: انتهى أمر زيري.",
 "打ち止める": "نِهَايَة, غَايَة / غَايَة / اِنْتَهَى, أَنْهَى (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات)\nمثال: انتهى أمر زيري. / قَتَلَ, قتل (تعمّد جعله يَمُوتُ، أزهق روحه، أمَاتَه متعمدا؛ الوقتَ: ضيعه بشيء غير ذي فائدة وهو ينتظر أمرا آخر) / قَتْلَة\nمثال: قتل الصياد دبا.",
 "打ち歩": "إصدار مُكَلف / فاخر",
 "打ち消し": "نَفْي / إِنْكَار",
 "打ち消す": "نَفَى / رَفَضَ (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟",
 "打ち滅ぼす": "دَمَّرَ",
 "打ち物": "آلة إيقاعية (آلة موسيقية يتم فيها إنتاج الصوت عن طريق ضرب شيء بآخر)",
 "打ち物師": "حَدَّاد, قَيْن / سَيَّاف, سَلَّال",
 "打ち留める": "نِهَايَة, غَايَة / غَايَة / اِنْتَهَى, أَنْهَى (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات)\nمثال: انتهى أمر زيري. / قَتَلَ, قتل (تعمّد جعله يَمُوتُ، أزهق روحه، أمَاتَه متعمدا؛ الوقتَ: ضيعه بشيء غير ذي فائدة وهو ينتظر أمرا آخر) / قَتْلَة\nمثال: قتل الصياد دبا.",
 "打ち着": "مَلَابِس دَاخِلِيَّة, لِبَاس دَاخِلِيّ",
 "打ち砕く": "كَسَّرَ / تَكَسَّرَ",
 "打ち破る": "اِنْكَسَرَ (فعل مطاوعة لكَسَرَ، قام أحدهم بكَسْره أو قام هو بكَسْر نفسه؛ التاجر: خَسِرَ المال ونَقَصَ عنده المال، أفْلَسَ) / كَسَرَ / اِسْتِرَاحَة (مبنى خارج المدن يتوقف فيه المسافرون للراحة والتَزَوُّد يُجمع على اِسْتِرَاحَات)\nمثال: عليك أخذ استراحة.",
 "打ち粉": "طَحِين, دَقِيق / بُودْرَة",
 "打ち臥す": "اِسْتَلْقَى (وَضَعَ ظَهْرَهُ عَلَى سَطْحٍ كَالسَّرِيرِ والأَرْضِ للنوم أو الاستراحة) / اِضْطَجَعَ\nمثال: استلقى على السرير.",
 "打ち萎れる": "تدلي, ترهل (شكل يتدلى أو يهبط للأسفل)\nمثال: كان هناك هبوط في مقعد الكرسي",
 "打ち落す": "صَرَعَ (طَرَحَه على الأرض؛ أَرْدَاهُ قَتِيلاً وأَهْلَكَهُ)",
 "打ち落とす": "صَرَعَ (طَرَحَه على الأرض؛ أَرْدَاهُ قَتِيلاً وأَهْلَكَهُ)",
 "打ち見る": "نَظَرَ (اِسْتَعْمَلَ عينه ليَرَى الشيءَ، ليُدْرِكَه ويُبْصِرَه. (مَصْدَرُهُ نَظَر)؛ (يتعدى تعدية عامة بإلى))\nمثال: نظر إلى السماء.",
 "打ち負かす": "غَلَبَ, هَزَمَ (قَهَرَ واِعْتَزَّ عليه واِمْتَنَع) / هَزِيمَة, مَغْلُوبِيَّة",
 "打ち跨る": "رَكِبَ (عَلَى أو أعْتَلَى شيئا؛ السَيَّارَة أو وسيلة نقل أخرى، استخدمها في تنقله بدلا من الدواب)\nمثال: ركب ياني سفينة.",
 "打ち身": "كَدَمَ / كَدْمَة, رَضّ",
 "打ち込み": "سِيَاقَة, قِيَادَة",
 "打ち込む": "أَصَابَ / ضَرْبَة (المرة الواحدة من الضَرْب؛ اللطمو أو الدقة أو الصكّة؛ ضربة طبل: دقة واحدة منه)\nمثال: تلقى مناد ضربة. / مُدْخَل",
 "打ち金": "مِطْرَقَة, شَاكُوش (أداة رأسها من حَدِيد ولها ذراع غالبا ما تكون من خَشَب تستخدم لضرب المِسْمَار في الخشب أو الحائط أو نحوه؛ أدَاة من حديد يطرق بها الحديد لتطويعه) / مِطْرَقَة (أداة رأسها من حَدِيد ولها ذراع غالبا ما تكون من خَشَب تستخدم لضرب المِسْمَار في الخشب أو الحائط أو نحوه؛ أدَاة من حديد يطرق بها الحديد لتطويعه)\nمثال: سأشتري له مطرقة.",
 "打ち開ける": "فَارِغ / فَرَغَ",
 "打ち間違い": "خَطَأ مَطْبَعِيّ (تعني ضدّ الصواب. يشمل ذلك الفعل، القول، والرأي. يُستخدم الفعل \"أخطأ\" للدلالة على عدم الإصابة…؛ قام بعمل بعيد عن الصواب أو مخالف للحق سواء كان ذلك في السلوك أو القول أو الكتابة)\nمثال: كان خطأ حاسوبي.",
 "打ち震える": "اِخْتَلَجَ, اِرْتَجَفَ / رَجْفَة (المرّة الواحدة من الرَجْف؛ الزَلْزَلَة)",
 "打ち首": "قَطْعُ الرَّأَس (قطع الشيء : جزه؛ قطع الشيء : فصل بعضه عن بعضه الآخر)\nمثال: قطع زيري العشب.",
 "打ち鳴らす": "حَلْقَة / خَاتَم, خَاتِم / دَقَّ, رَنَّ (الشيءَ: ضربه وأصدر صوتًا عند الدق؛ البابَ: طرقه) / رَنَّ ((رَنَّ) رنينا: صَوَّت وَصَاح؛ (رَنَّ) إِلَيْهِ: أصغى) / تَلْفَنَ, رَنَّ / مثال: واصل زيري دق الجرس.",
 "打っちゃる": "تخلص, رمي (التخلص من شيء يعتبر عديم الفائدة أو غير مرغوب فيه) / إلقاء الورق, طرح الورق ((في أوراق اللعب) فعل رمي بطاقة عديمة الفائدة) / شيء متروك, مُهملات (أي شيء يتم طرحه جانباً أو التخلص منه) / أَهْمَلَ / إِهْمَال",
 "打ってつけ": "مِثَالِيّ",
 "打って付け": "مِثَالِيّ",
 "打って掛かる": "حَمْلَة / هَاجَمَ",
 "打って替え": "تَغَيَّرَƒ / غَيَّرَ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به) / تَغْيِير, تَبْدِيل / فَكَّة / بَاقٍ (باقٍ ، الباقِيٌ جمع باقون ( للعاقل ) وبَواقٍ ، مؤ باقية ، جمع مؤ باقيات وبَواقٍ؛ باقٍ إلَى الأبَدِ : خالِدٌ) / تَغْيِير\nمثال: أنا غير متفاجئ.",
 "打っ掛け": "رش, طرطشة (فعل نثر الماء بشكل عشوائي) / رش, طرطشة (فعل رش مادة (سائلة) على سطح) / بُوكَاكِيه",
 "打っ裂く": "تمزيق, شق (عملية شق أو تمزيق شيء ما) / تيار ساحب, تيار عنيف (امتداد من المياه المضطربة في نهر أو في البحر ناتج عن تدفق تيار في تيار آخر أو عبره) / تمزق, شرم (فتحة أحدثت بالقوة عن طريق الشد) / فاسق (رجل منحل في المجتمع الراقي)\nمثال: قام بتمزيق الظرف بقوة",
 "打つ": "أَصَابَ / ضَرْبَة (المرة الواحدة من الضَرْب؛ اللطمو أو الدقة أو الصكّة؛ ضربة طبل: دقة واحدة منه)\nمثال: تلقى مناد ضربة. / ضَرَبَ (معروف، وهو اللطم أو الدق أو الصكّ و ما أشبه؛ النَوْع أو الصنف أو المثال) / إِضْرَاب\nمثال: ضرب سامي زوجته. / نَبْض / ضَرَبَ, دَقَّ (معروف، وهو اللطم أو الدق أو الصكّ و ما أشبه؛ النَوْع أو الصنف أو المثال) / وَجَفَ / هَزَمَ, غَلَبَ / خَفَقَ (الجذر يعبر عن الحركة والاضطراب الخفيف الذي ينشأ عن الرياح أو القلوب أو الرايات، ويستخدم لوصف الطبيعة والأحاسيس والجوانب الحسية المختلفة؛ عبّر عن حركة سريعة، سواء كانت اضطراباً أو ضرباً خفيفاً أو صوتاً، بالإضافة إلى صفةٍ تُوصف بها الخيل)\nمثال: ضرب سامي زوجته. / حَرُكَ, تَحَرَّكَ (غَيَّرَ مَوْضِعَهُ أو مَكَانَهُ أو حَالَه؛ حَرُكَ الوَلَدُ : تَحَرَّكَ، أَوْ خَرَجَ عَنْ سُكُونِهِ) / اِنْتَقَلَ, تَحَلْحَلَ\nمثال: لقد أوقفنا حركة المرور. / أَصَابَ / ضَرْبَة (المرة الواحدة من الضَرْب؛ اللطمو أو الدقة أو الصكّة؛ ضربة طبل: دقة واحدة منه)\nمثال: تلقى مناد ضربة. / فَعَلَ, صَنَعَ (عَمِلَ وصَنَعَ، بعلم أو بدون علم، عن قصد أو دون قصد) / جَعَلَ (صَيَّرَ؛ أَنْشَأَ)\nمثال: ماذا فعل للحمي؟ / قِمَار / قَامَرَ",
 "打つかり": "تَصَادُّم, اِصْطِدَام / وَجْهًا لِوَجْه",
 "打つかり合う": "اِصْطَدَمَ",
 "打つかり稽古": "وَجْهًا لِوَجْه",
 "打ん投げる": "رَمَى, صَبَّ ((مُتَعَدٍّ بِنَفْسِهِ) جَعَلَهُ يَتَحَرَّكُ فِي الهَوَاءِ)\nمثال: رمى تلك الموزة.",
 "打上げ": "أَطْلَقَ, قَذَفَ / نِهَايَة, غَايَة / غَايَة / اِنْتَهَى, أَنْهَى (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات)\nمثال: انتهى أمر زيري.",
 "打付ける": "ظُفْر, ضفر (الجزء المتقرن الميت على طرف الأصبع من الإنْسَان وبعض الحَيْوَانَات) / مِسْمَار, مسمار (وتد صغير من حَدِيد أحد طرفيه مسنون والآخر له رأس يدق في الخشب والجدران وغيرها للتثبيت؛ غِلْظ صغير مخروطي الشكل قد يحدث في أصابع القدم أو في أخْمَص القدم)\nمثال: نبت ظفر أصبع رجلي الكبير. / فَرْقَعَة / رَمَى, صَبَّ ((مُتَعَدٍّ بِنَفْسِهِ) جَعَلَهُ يَتَحَرَّكُ فِي الهَوَاءِ)\nمثال: رمى تلك الموزة.",
 "打伏す": "اِسْتَلْقَى (وَضَعَ ظَهْرَهُ عَلَى سَطْحٍ كَالسَّرِيرِ والأَرْضِ للنوم أو الاستراحة) / اِضْطَجَعَ\nمثال: استلقى على السرير.",
 "打倒": "أَطَاحَ\nمثال: その過激派が政府打倒の陰謀を企てているという噂が立ってる。 — ثمّة شائعةٌ تقول أن الأصوليين يرسمون خطة مضادة للحكومة.",
 "打傷": "كَدَمَ / كَدْمَة, رَضّ",
 "打克つ": "هَزَمَ, غَلَبَ",
 "打出し": "دك, طرق (فعل الطرق (توجيه ضربات ثقيلة متكررة))\nمثال: فاجأه طرق القبضات المفاجئ / عَبَدَ (خلاف الحُرّ، المَمْلُوْك، من له مالك يملكه. الجمع عبيد وأعبد وعِبدان وعُبدان؛ الإنسان حرا كان أم لا مؤمنا كان أن ملحدا من حيث أنه مملوك لله) / خَدَمَ (عَمِلَ أو سَاعَدَ شخصًا أو جهة؛ أَدَارَ خدمة أو مهمة) / قَدَّمَ (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى الرُّسْغَ؛ أنّ لهم سابقةً وفضلاً له عند فلان قَدَمٌ : معروف) / أَرْسَلَ (بَعَثَ؛ أَطْلَقَ) / إِرْسَال (الإرْسال : الإطلاق؛ النقل والبَعْث من مكان إلى آخر)\nمثال: ماذا أنجز عبد العزيز بوتفليقة؟ / مطبوعة, نسخة مطبوعة (مخرجات الكمبيوتر في شكل مطبوع)",
 "打出す": "طَبَعَ (طَبَعَ الله الخلقَ : أَنشأَهُ؛ طبَعَت الدَّوْلةُ النَّقْد : صاغتْه ونقشته)\nمثال: بالطبع هي مزحة! / ضَرَبَ (معروف، وهو اللطم أو الدق أو الصكّ و ما أشبه؛ النَوْع أو الصنف أو المثال) / إِضْرَاب\nمثال: ضرب سامي زوجته.",
 "打切り": "نِهَايَة, غَايَة / غَايَة / اِنْتَهَى, أَنْهَى (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات)\nمثال: انتهى أمر زيري.",
 "打切り誤差": "خطأ البتر ((رياضيات) خطأ في الحساب ينتج عن قطع عملية حسابية رقمية قبل انتهائها)",
 "打切る": "وَقَفَ, تَوَقَّفَ (قَامَ، اِنْتَصَبَ، نَهَضَ؛ ثَبَتَ) / أَوْقَفَ, وَقَفَ / تَوَقَّفَ, وَقَّف / مَوْقِف / وَقْفَة\nمثال: وقف وراء الباب.",
 "打刻": "نَقْشْ (لوّن بلونين أو أكثر؛ زيَّن بأشكال أو ألوان) / لَكْمَة / لَكَمَ (معناه: ضرب بقبضة اليد أو اللكم؛ معنى آخر: الضرب بشدة) / خَرَّامَة\nمثال: لكم اشتقت إليك!",
 "打割る": "انفصل",
 "打勝つ": "قَهَرَ, اِنْتَصَرَ (غَلَبَ وانْتَصَرَ ولم يقدر عليه أحد) / هَزَمَ, غَلَبَ",
 "打合う": "عَارَكَ, قَاتَلَ / تَعَارَكَ, تَقَاتَلَ / نَاضَلَ, كَافَحَ / قِتَال (من قَتَلَ: كثير القَتْل) / مَعْرَكَة\nمثال: لن يحل القتال أي شيء.",
 "打合せ": "اِجْتِمَاع, مَجْلِس (جمعوا انفسهم؛ اسم يطلق على عملية جَمْع بعض الناس في مكان واحد ليتباحثوا أمرا) / مُلَاقَاة, مُقَابَلَة (لِقَاء) / مُلَاقَاة, لِقَاء (لِقَاء)\nمثال: هذا اجتماع مهم. / تراكب, طية (لسان يقع فوق جزء آخر) / تداخل (خاصية التصادف الجزئي في الوقت) / التقاء, تداخل (تمثيل للأرضية المشتركة بين النظريات أو الظواهر)\nمثال: يجب أن يكون تراكب القرميد عشر بوصات على الأقل",
 "打席": "مربع الضارب (منطقة في ملعب البيسبول (على جانبي القاعدة الرئيسية) محددة بخطوط يجب أن يقف داخلها الضارب عند اللعب)",
 "打手": "رَامٍ ((رَامَ) الجُرحُ يَرِيمُ رَيْمًا، ورَيَمَانًا: انْضَمَّ فَمُهُ للبُرْءِ؛ (رَامَ) الحِمْلُ: مالَ) / رَامِيَة / مُلقح (ممارس طبي يلقح الناس ضد الأمراض) / طبال (شخص يعزف على الطبل)",
 "打打": "مُتَصَادِم, مُتَنَافِر (متنافر بشكل حادّ وقاسٍ)",
 "打払う": "دَفَعَ, صَدَّ (لزّه ونحاه وأبعده؛ صرفه قبل وروده، أي منعه وأبعده قبل مجيئه أو حدوثه، وعكسه أن يرفعه، اي أن يصرفه بعد حدوثه)\nمثال: دفع زيري الثمن.",
 "打抜き": "لَكْمَة / لَكَمَ (معناه: ضرب بقبضة اليد أو اللكم؛ معنى آخر: الضرب بشدة) / خَرَّامَة\nمثال: لكم اشتقت إليك! / بِئْرٌ إِرْتِوَازِيَّة, بِئْرٌ إِرْتِوَازِيّ",
 "打振る": "إشهار, تلويح (فعل التلويح)",
 "打撃": "نَفَخَ (أَطْلَقَ الريح من فمه؛ زَفَرَ أو هَبَّ بشدة) / ضَرْبَة (المرة الواحدة من الضَرْب؛ اللطمو أو الدقة أو الصكّة؛ ضربة طبل: دقة واحدة منه)\nمثال: يداك أوكتا وفوك نفخ / ضرب الكرة ((بيسبول) محاولة الضارب للوصول إلى القاعدة) / حشوة قطنية, لباد (حشو مصنوع من لفات أو صفائح من الصوف القطني أو الألياف الصناعية)",
 "打撃率": "مُعَدَّل الضَّرْب ((البيسبول) مقياس لأداء الضارب؛ عدد الضربات القاعدية مقسوماً على عدد المرات الرسمية في المضرب) / مُعَدَّل النَّجَاح ((امتداد لمصطلح البيسبول) نسبة المرات التي ينجح فيها جهد ما)\nمثال: كان لدى تيد ويليامز ذات مرة معدل ضرب أعلى من .400",
 "打撲": "نَفَخَ (أَطْلَقَ الريح من فمه؛ زَفَرَ أو هَبَّ بشدة) / ضَرْبَة (المرة الواحدة من الضَرْب؛ اللطمو أو الدقة أو الصكّة؛ ضربة طبل: دقة واحدة منه)\nمثال: يداك أوكتا وفوك نفخ",
 "打撲傷": "كَدَمَ / كَدْمَة, رَضّ",
 "打擲": "جلد, ضرب (فعل إيقاع العقاب البدني بضربات متكررة) / سحق, هزيمة نكراء (هزيمة قوية)",
 "打放し": "ميدان غولف (ميدان تدريب للتدرب على ضربات الغولف)",
 "打明ける": "نَاجَى",
 "打明け話": "إِقْرَار, اِعْتِرَاف / طَائِفَة (مؤنث طَائِف؛ التي تطوفُ؛ القطعة أو الجزء من الشيء أو الواحدة منه)",
 "打棒": "وَطْوَاط, خُفَّاش / مِضْرَب, عَصًا / مِرْقَاق, فَرَّادَة / تَهْرِيجِيّ (يتّسم بالمُشاغبة والحركة البدنيّة في الكوميديا) / عصا التصفيق (جهاز صوتي يتكون من مضربين مفصليين معاً؛ يستخدمه الممثل لإحداث ضوضاء عالية دون التسبب في إصابة عند ضرب شخص ما) / تهريج, سلابستيك (كوميديا صاخبة تتضمن مطاردات واصطدامات ومقالب)",
 "打楽器": "آلة إيقاعية (آلة موسيقية يتم فيها إنتاج الصوت عن طريق ضرب شيء بآخر)",
 "打止める": "نِهَايَة, غَايَة / غَايَة / اِنْتَهَى, أَنْهَى (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات)\nمثال: انتهى أمر زيري. / قَتَلَ, قتل (تعمّد جعله يَمُوتُ، أزهق روحه، أمَاتَه متعمدا؛ الوقتَ: ضيعه بشيء غير ذي فائدة وهو ينتظر أمرا آخر) / قَتْلَة\nمثال: قتل الصياد دبا.",
 "打歩": "إصدار مُكَلف / فاخر",
 "打法": "تَأَرْجَحَ / أُرْجُوحَة, مُرْجِيحَة",
 "打消": "نَفْي / إِنْكَار",
 "打消し": "نَفْي / إِنْكَار",
 "打消す": "نَفَى / رَفَضَ (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟",
 "打点": "ركضة مدفوعة بضربة (ركضة تكون نتيجة لأداء الضارب)\nمثال: كان لديه أكثر من 100 ركضة مدفوعة بضربة في الموسم الماضي",
 "打物": "آلة إيقاعية (آلة موسيقية يتم فيها إنتاج الصوت عن طريق ضرب شيء بآخر)",
 "打物師": "حَدَّاد, قَيْن / سَيَّاف, سَلَّال",
 "打率": "مُعَدَّل الضَّرْب ((البيسبول) مقياس لأداء الضارب؛ عدد الضربات القاعدية مقسوماً على عدد المرات الرسمية في المضرب) / مُعَدَّل النَّجَاح ((امتداد لمصطلح البيسبول) نسبة المرات التي ينجح فيها جهد ما)\nمثال: كان لدى تيد ويليامز ذات مرة معدل ضرب أعلى من .400",
 "打球": "صدم, ضرب (فعل ملامسة شيء لآخر)\nمثال: أدى الضرب المتكرر إلى ظهور كدمة كبيرة",
 "打留める": "نِهَايَة, غَايَة / غَايَة / اِنْتَهَى, أَنْهَى (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات)\nمثال: انتهى أمر زيري. / قَتَلَ, قتل (تعمّد جعله يَمُوتُ، أزهق روحه، أمَاتَه متعمدا؛ الوقتَ: ضيعه بشيء غير ذي فائدة وهو ينتظر أمرا آخر) / قَتْلَة\nمثال: قتل الصياد دبا.",
 "打破": "غَلَبَ, هَزَمَ (قَهَرَ واِعْتَزَّ عليه واِمْتَنَع) / هَزِيمَة, مَغْلُوبِيَّة",
 "打破る": "اِنْكَسَرَ (فعل مطاوعة لكَسَرَ، قام أحدهم بكَسْره أو قام هو بكَسْر نفسه؛ التاجر: خَسِرَ المال ونَقَصَ عنده المال، أفْلَسَ) / كَسَرَ / اِسْتِرَاحَة (مبنى خارج المدن يتوقف فيه المسافرون للراحة والتَزَوُّد يُجمع على اِسْتِرَاحَات)\nمثال: عليك أخذ استراحة.",
 "打突": "ضَرَبَ (معروف، وهو اللطم أو الدق أو الصكّ و ما أشبه؛ النَوْع أو الصنف أو المثال) / إِضْرَاب\nمثال: ضرب سامي زوجته.",
 "打算": "حَسْب, مُحَاسَبَة (عَدَّ مع الجَمْع والطَرْح وغيرها من العمليات الحِسَابية؛ عند أكثر العامة: هو العَدّ مطلقا)\nمثال: حسب سامي المال.",
 "打算的": "داهِيَة, مُتَآمِر (حاذِق في التَّدْبير والتَّخْطيط بِمَكْر وحِيلَة)",
 "打粉": "طَحِين, دَقِيق / بُودْرَة",
 "打線": "ترتيب الضاربين ((بيسبول) قائمة بالضاربين بالترتيب الذي سيضربون به)\nمثال: قدم المديرون بطاقاتهم للحكم عند اللوحة الرئيسية",
 "打者": "عجين سائل (خليط سائل أو شبه سائل، مثل الدقيق والبيض والحليب، يستخدم في الطهي) / ضارب, ضارب الكرة ((في البيسبول) لاعب الكرة الذي يقوم بضرب الكرة بالمضرب)",
 "打落す": "صَرَعَ (طَرَحَه على الأرض؛ أَرْدَاهُ قَتِيلاً وأَهْلَكَهُ)",
 "打見る": "نَظَرَ (اِسْتَعْمَلَ عينه ليَرَى الشيءَ، ليُدْرِكَه ويُبْصِرَه. (مَصْدَرُهُ نَظَر)؛ (يتعدى تعدية عامة بإلى))\nمثال: نظر إلى السماء.",
 "打設": "مُتَدَفِّق, مُنْهَمِر (يسيل بغزارة)",
 "打診": "آلَة إِيقَاعِيَّة (الفارسية: ماشين؛ الأوردية: مشين)\nمثال: نسى زيري الآلة.",
 "打診器": "مطرقة المنعكسات, مطرقة طبية ((طب) مطرقة صغيرة برأس مطاطي تستخدم في فحوصات الطرق على الصدر واختبار ردود الفعل)",
 "打診槌": "مطرقة المنعكسات, مطرقة طبية ((طب) مطرقة صغيرة برأس مطاطي تستخدم في فحوصات الطرق على الصدر واختبار ردود الفعل)",
 "打負かす": "غَلَبَ, هَزَمَ (قَهَرَ واِعْتَزَّ عليه واِمْتَنَع) / هَزِيمَة, مَغْلُوبِيَّة",
 "打身": "كَدَمَ / كَدْمَة, رَضّ",
 "打鍵": "ضربة مفتاح (ضربة مفتاح؛ ضغطة واحدة على مفتاح في لوحة المفاتيح)\nمثال: تم استخدام عدد ضربات المفاتيح كمقياس للعمل",
 "打開": "اِخْتِرَاق (اختراق الرياح مرورها؛ اخترقت الخيل ما بين القرى والشجر:تخلّلتها)",
 "打電": "تِلِغْرَاف, بَرْقِيَّة",
 "打順": "ترتيب الضاربين ((بيسبول) قائمة بالضاربين بالترتيب الذي سيضربون به)\nمثال: قدم المديرون بطاقاتهم للحكم عند اللوحة الرئيسية",
 "打首": "قَطْعُ الرَّأَس (قطع الشيء : جزه؛ قطع الشيء : فصل بعضه عن بعضه الآخر)\nمثال: قطع زيري العشب.",
 "打麦場": "جُرْن, جَرِين (تَعَوَّدَ أَمْرًا وَمَرَنَ عَلَيْهِ؛ جَرَنَ الثَّوْبُ وَالدِّرْعُ وَالأَدِيمُ: لَانَ وَانْسَحَقَ)",
 "払い": "دَفْع (لزّه ونحاه وأبعده؛ صرفه قبل وروده، أي منعه وأبعده قبل مجيئه أو حدوثه، وعكسه أن يرفعه، اي أن يصرفه بعد حدوثه)\nمثال: دفع زيري الثمن. / كنس (فعل التنظيف بالمكنسة) / شَامِل, عَشْوَائِيّ (يَتَجَاهَل الفُرُوقَات وَالتَّمَايُزَات) / شَامِل, وَاسِع النِّطَاق (يشمل مساحة واسعة أو يتحرّك عبرها)",
 "払いすぎ": "دفع زائد (فعل دفع أكثر من اللازم) / دفعة زائدة (دفعة أكبر مما هو مطلوب أو متوقع)",
 "払いのける": "يَدْرَأ",
 "払い下げ": "بَيْع / تخفيض (تَنْقِيص ، حَسْم ،تَقْلِيل؛ تَنْزِيل) / مُزَايَدَة\nمثال: هل يمكن ان تعطيني تخفيض",
 "払い出し": "إصدار, إطلاق (فعل توفير عنصر للاستخدام العام أو لأغراض رسمية (عادة بكميات))\nمثال: إصدار جديد من الطوابع",
 "払い出す": "دَفَعَ, خَلَّصَ (لزّه ونحاه وأبعده؛ صرفه قبل وروده، أي منعه وأبعده قبل مجيئه أو حدوثه، وعكسه أن يرفعه، اي أن يصرفه بعد حدوثه) / معاش, أجر\nمثال: دفع زيري الثمن.",
 "払い戻し": "استرداد, سداد (عملية إعادة الأموال المستلمة سابقاً) / إبراء ذمة, تسديد (دفع دين أو التزام)",
 "払い戻し金": "إِعَادَة مَال",
 "払い戻す": "جَازَى",
 "払い残し": "متأخرات (دين غير مدفوع تجاوز موعد استحقاقه) / متأخرات (حالة التأخر في الدفع)\nمثال: حساب عليه متأخرات",
 "払い残り": "متأخرات (دين غير مدفوع تجاوز موعد استحقاقه) / متأخرات (حالة التأخر في الدفع)\nمثال: حساب عليه متأخرات",
 "払い清める": "صَفَّى",
 "払い渡す": "دَفَعَ, خَلَّصَ (لزّه ونحاه وأبعده؛ صرفه قبل وروده، أي منعه وأبعده قبل مجيئه أو حدوثه، وعكسه أن يرفعه، اي أن يصرفه بعد حدوثه) / معاش, أجر\nمثال: دفع زيري الثمن.",
 "払い落とす": "اِنْتَفَضَ",
 "払い込み": "دَفْع (لزّه ونحاه وأبعده؛ صرفه قبل وروده، أي منعه وأبعده قبل مجيئه أو حدوثه، وعكسه أن يرفعه، اي أن يصرفه بعد حدوثه)\nمثال: دفع زيري الثمن.",
 "払い込む": "وَدِيعَة / أَوْدَعَ (الثَوْب أو ما أشبه: صانه بأن وضعه في صِوَان أو مكان لا يؤْذَى فيه؛ فلانًا مالًا: دفعه إليه ليكون عنده وديعة. ويكون أيضا بمعنى قبل الوديعة)\nمثال: غادرت المنزل دون أن أودع أهلي.",
 "払い過ぎ": "دفع زائد (فعل دفع أكثر من اللازم) / دفعة زائدة (دفعة أكبر مما هو مطلوب أو متوقع)",
 "払い除ける": "يَدْرَأ",
 "払う": "دَفَعَ, خَلَّصَ (لزّه ونحاه وأبعده؛ صرفه قبل وروده، أي منعه وأبعده قبل مجيئه أو حدوثه، وعكسه أن يرفعه، اي أن يصرفه بعد حدوثه) / معاش, أجر\nمثال: دفع زيري الثمن. / طَرَدَ / فَعَلَ, صَنَعَ (عَمِلَ وصَنَعَ، بعلم أو بدون علم، عن قصد أو دون قصد) / جَعَلَ (صَيَّرَ؛ أَنْشَأَ)\nمثال: ماذا فعل للحمي؟ / أخْلَا / تَرَكَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض) / أبْطَلَ, نَحّى\nمثال: لقد ترك لك هذا.",
 "払出し": "إصدار, إطلاق (فعل توفير عنصر للاستخدام العام أو لأغراض رسمية (عادة بكميات))\nمثال: إصدار جديد من الطوابع",
 "払出す": "دَفَعَ, خَلَّصَ (لزّه ونحاه وأبعده؛ صرفه قبل وروده، أي منعه وأبعده قبل مجيئه أو حدوثه، وعكسه أن يرفعه، اي أن يصرفه بعد حدوثه) / معاش, أجر\nمثال: دفع زيري الثمن.",
 "払底": "عَجْز, نَقْص",
 "払戻し": "استرداد, سداد (عملية إعادة الأموال المستلمة سابقاً) / إبراء ذمة, تسديد (دفع دين أو التزام)",
 "払戻す": "جَازَى",
 "払戻金": "إِعَادَة مَال",
 "払暁": "فَجْر (هو آخر اللَيْل أو أول النَهَار حين تنصدع الظُلْمَة من النُور) / فَجْر, فَلَق (هو آخر اللَيْل أو أول النَهَار حين تنصدع الظُلْمَة من النُور) / شُرُوق (البُزُوغ، الطُلُوع؛ الوَقْت الذي تَشْرُق فيه الشَمْس) / شُرُوق, مَشْرِق (البُزُوغ، الطُلُوع؛ الوَقْت الذي تَشْرُق فيه الشَمْس)\nمثال: فجر توم البالونة.",
 "払込": "دَفْع (لزّه ونحاه وأبعده؛ صرفه قبل وروده، أي منعه وأبعده قبل مجيئه أو حدوثه، وعكسه أن يرفعه، اي أن يصرفه بعد حدوثه)\nمثال: دفع زيري الثمن.",
 "払込み": "دَفْع (لزّه ونحاه وأبعده؛ صرفه قبل وروده، أي منعه وأبعده قبل مجيئه أو حدوثه، وعكسه أن يرفعه، اي أن يصرفه بعد حدوثه)\nمثال: دفع زيري الثمن.",
 "托する": "أَرْسَلَ, بَعَثَ (بَعَثَ؛ أَطْلَقَ)\nمثال: هو أرسل لي هدية.",
 "托子": "صُحَيْفَة, طَبَق فِنْجَان",
 "托葉": "أذينة (نمو ورقي صغير عند قاعدة ورقة أو ساقها؛ عادة ما يحدث في أزواج ويسقط قريباً)",
 "扣え": "اِحْتِيَاط / ذَخِيرَة / حَجَزَ (حجَزهُ: مَنَعَهُ)\nمثال: حجز مناد موعدا. / مُلَاحَظَة, مَلْحُوظَة / مُذَكَّرَة / دَرَجَة / تَوْأَمِيّ, مُتَمَاثِل (يكون اثنين متطابقين) / مُسْتَنْسَخ, مُكَرَّر (منسوخ بشكل مطابق عن الأصل) / تكرار, نسخة طبق الأصل (نسخة تتوافق مع الأصل تماماً) / بديل احتياطي, نسخة إضافية (شيء إضافي من نفس النوع)\nمثال: صنع نسخة للملفات",
 "扨も": "عَجَبًا / سُبْحَانَ الله (مصدر للفعل سَبَحَ؛ تُقال حصرًا للَّٰه، كما في العبارة \"سُبْحَانَ اللَّٰهِ\")\nمثال: سبحان الله عما يشركون.",
 "扮装": "تبرج, مكياج (مستحضرات تجميل توضع على الوجه لتحسين أو تغيير المظهر) / بنية, تركيب (الطريقة التي يتكون بها شخص أو شيء ما) / اختبار تعويضي, حدث تعويضي (حدث يتم استبداله بحدث تم إلغاؤه مسبقاً)\nمثال: فاتته الاختبار واضطر لإجراء اختبار تعويضي",
 "扱い": "مُعَامَلَة (كيفية التَصَرُّف مع الآخرين ومدى احترامهم أو خلافه؛ عند الفقهاء: العَقْد على العَمَل ببعض الخارج مع سائِر شرائِط جوازها. وتُطَلق المعاملات على الأحكام الشرعية المتعلّقة بأمر الدنيا باعتبار بقاءِ الشخص…) / عِلَاج, مُعَالَجَة\nمثال: أساء توم معاملة ماري. / تداول باليد, معالجة (فعل اللمس باليدين (أو الاستخدام الماهر لليدين) أو باستخدام وسائل ميكانيكية) / مناولة (الحمل أو النقل أو التسليم اليدوي (أو الميكانيكي) أو العمل مع شيء ما) / تعامل, معالجة (إدارة شخص ما أو شيء ما)\nمثال: التعامل مع السجناء",
 "扱いやすい": "طيع, قابل للإدارة (يمكن إدارته أو التحكم فيه) / قَابِل لِلتَّحْقِيق, قَابِل لِلْإِنْجَاز (يمكن تحقيقه أو إنجازه؛ في حيّز الإمكان)",
 "扱い易い": "طيع, قابل للإدارة (يمكن إدارته أو التحكم فيه) / قَابِل لِلتَّحْقِيق, قَابِل لِلْإِنْجَاز (يمكن تحقيقه أو إنجازه؛ في حيّز الإمكان)",
 "扱う": "عَالَجَ / مِقْبَض / شَغَّلَ ((شَغَلَ) الدارَ يَشْغَلَ شَغْلًا: سكنها؛ شَغَلَ فلانًا عن الشيء: لَهَّاهُ وصرَفَه)\nمثال: شغل بيل التلفاز. / بَاعَ (أَعْطَى الشيءَ بِثَمَن؛ اِشْتَرَى) / اِنْبَاعَ, بِيعَ\nمثال: باع زيري منزله.",
 "扱き": "ذُلّ (ذَلَّ الرَّجُلُ: ضَعُفَ، هَانَ، حَقُرَ؛ ذَلَّتِ الدَّابَّةُ: سَهُلَتْ، إِنْقَادَتْ)\nمثال: بذل زيري قصارى جهده. / تِكَّة, حِزَام (في و: هو الشُقَف)",
 "扱き下ろす": "وَشَى",
 "扱き交ぜる": "تَحَرَّكَ (حَرُكَ)\nمثال: لا أستطيع التحرك.",
 "扱き混ぜる": "تَحَرَّكَ (حَرُكَ)\nمثال: لا أستطيع التحرك.",
 "扱き落とす": "دَرَسَ ((متعدٍّ بنفسه) عَلَّمَ، لَقَّنَ؛ اِمْتَهَنَ التَّعْلِيم)\nمثال: أراك بعد الدرس.",
 "扱き雑ぜる": "تَحَرَّكَ (حَرُكَ)\nمثال: لا أستطيع التحرك.",
 "扱く": "سكتة دِمَاغِيَّة / لَاطَفَ / مَلَّسَ / اِسْتَمْنَى / مَارَسَ الْعَادَة السِّرِّيَّة (ومَرِسَ؛ إله الحرب في الأساطير الرُومِيَّة، وهو المَرِيِّخ، لا يؤنث ولا يجمع)\nمثال: مارس الأمازيغية. / دَرَسَ ((متعدٍّ بنفسه) عَلَّمَ، لَقَّنَ؛ اِمْتَهَنَ التَّعْلِيم)\nمثال: أراك بعد الدرس.",
 "扱混ぜる": "تَحَرَّكَ (حَرُكَ)\nمثال: لا أستطيع التحرك.",
 "扶く": "مُسَاعَدَة, مَعُونَة / مُسَاعِد, مُسَاعِدَة (مُعَاوِن، مُسَانِد، من يقوم بالمُسَاعَدَة؛ بمعنى مُفِيد، يقال هذا عامل مساعد وهذه مادة مساعدة) / سَاعَدَ, عَاوَنَ (عَاوَنَ، أَعَانَ) / مُسَاعَدَة, النَّجْدَة\nمثال: علي مساعدة ماري.",
 "扶助": "مُسَاعَدَة",
 "扶助料": "إِعَانَة مَالِيَّة",
 "扶壁": "حاجز صد, ساتر (تحصين يتكون من جدار منخفض) / تصوينة, درابزين سور (جدار منخفض على طول حافة السطح أو الشرفة) / دعامة ساندة (دعامة عادة من الحجر أو الطوب؛ تدعم جدار المبنى)",
 "扶持": "رَاتِب, أَجْر",
 "扶桑": "الْيَابَان (دولة جزرية في شرق قارة آسيا، عاصمتها طوكيو)\nمثال: أنا من اليابان. / كركديه صيني, ورد صيني (شجيرة آسيوية كبيرة مبهرجة أو شجرة صغيرة ذات زهور حمراء إلى حمراء داكنة كبيرة مفردة أو مزدوجة)",
 "扶桑国": "الْيَابَان (دولة جزرية في شرق قارة آسيا، عاصمتها طوكيو)\nمثال: أنا من اليابان.",
 "扶桑國": "الْيَابَان (دولة جزرية في شرق قارة آسيا، عاصمتها طوكيو)\nمثال: أنا من اليابان.",
 "扶植": "زرع, غرس (إجراء جراحي يضع شيئاً ما في جسم الإنسان) / غرس (فعل الغرس أو الوضع في الأرض) / انغراس, تعشيش ((علم الأجنة) العملية العضوية التي تنغرس فيها البويضة المخصبة في بطانة الرحم لدى الثدييات المشيمية)\nمثال: زرع كريات مشعة في غدة البروستاتا / دَعَمَ, دَعَّمَ (• دَعَمَهُ، كمنَعهُ: مالَ فأقامَهُ) / أَيَّدَ, دَعَمَ ((أَيَّدَه): قوّاه بالإياد) / تَأْيِيد, دَعْم\nمثال: ياني هنا لدعم ريمة.",
 "扶翼": "مُسَاعَدَة, مَعُونَة / مُسَاعِد, مُسَاعِدَة (مُعَاوِن، مُسَانِد، من يقوم بالمُسَاعَدَة؛ بمعنى مُفِيد، يقال هذا عامل مساعد وهذه مادة مساعدة) / سَاعَدَ, عَاوَنَ (عَاوَنَ، أَعَانَ) / مُسَاعَدَة, النَّجْدَة\nمثال: علي مساعدة ماري.",
 "扶育": "تربية, تنشئة (مساعدة شخص ما على النمو ليكون عضواً مقبولاً في المجتمع)",
 "扶養": "دَعَمَ, دَعَّمَ (• دَعَمَهُ، كمنَعهُ: مالَ فأقامَهُ) / أَيَّدَ, دَعَمَ ((أَيَّدَه): قوّاه بالإياد) / تَأْيِيد, دَعْم\nمثال: ياني هنا لدعم ريمة.",
 "扶養料": "نَفَقَة",
 "扶養者": "داعم رياضي (داعم للأعضاء التناسلية يرتديه الرجال الذين يمارسون تمارين شاقة) / رباط جورب, مشد (شريط (عادة مطاطي) يرتدى حول الساق لتثبيت الجورب (أو حول الذراع لتثبيت الكم)) / مساعد, معين (شخص يساهم في تلبية حاجة أو تعزيز جهد أو غرض) / داعم, راعٍ (شخص يدعم أو يناصر شيئاً ما)\nمثال: مساعدي الذي لا يقدر بثمن",
 "批准": "إبرام, تصديق (جعل الشيء ساري المفعول عن طريق التصديق عليه أو تأكيده رسميًا)\nمثال: المصادقة على المعاهدة",
 "批判": "نَقْد, اِنْتِقَاد",
 "批判力": "تَفْكِير نَقْدِيّ (عملية عقلية يتم من خلالها تحليل الأفكار أو المعلومات للوصول إلى فهم أو قرار؛ إعمال العقل في تأمل أو تخطيط لأمر معين)\nمثال: ابدأ في التفكير.",
 "批判的": "النقد",
 "批判的思考": "تَفْكِير نَقْدِيّ (عملية عقلية يتم من خلالها تحليل الأفكار أو المعلومات للوصول إلى فهم أو قرار؛ إعمال العقل في تأمل أو تخطيط لأمر معين)\nمثال: ابدأ في التفكير.",
 "批判者": "نَقَّاد, نَاقِد / ناقد",
 "批評": "نَقْد, اِنْتِقَاد",
 "批評家": "نَقَّاد, نَاقِد / ناقد",
 "批議": "لَوْم, مَلَامَة",
 "批難": "نَقْد, اِنْتِقَاد",
 "批難を浴びせる": "ضربة قوية (كرة طائرة طويلة جداً) / انْتِقَاد شَدِيد, هُجُوم (نقد سلبي مكثف) / متعة, وقت ممتع (تجربة ممتعة أو مثيرة للغاية) / انفجار, دوي (ضجيج عالٍ جداً ومفاجئ)\nمثال: وجه كلينتون هجومه إلى الحزب الجمهوري",
 "扼す": "أَمْر (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة) / أَمَرَ (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة)\nمثال: إنه أمر مختلف . / مَنَعَ (حَرَمَ، ضد أَعْطَى؛ كَفَّ عنه وحَمَاه)\nمثال: تساهم جذور أشجار المنغروف في منع حدوث انجراف التربة. / مَقْبِض",
 "扼する": "أَمْر (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة) / أَمَرَ (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة)\nمثال: إنه أمر مختلف . / مَنَعَ (حَرَمَ، ضد أَعْطَى؛ كَفَّ عنه وحَمَاه)\nمثال: تساهم جذور أشجار المنغروف في منع حدوث انجراف التربة. / مَقْبِض",
 "扼殺": "خنق (فعل خنق (شخص ما) عن طريق الضغط على القصبة الهوائية) / اختناق, انحباس ((علم الأمراض) انقباض جزء من الجسم بحيث يقطع تدفق الدم أو السوائل الأخرى) / اختناق, خنق (حالة توقف التنفس عن طريق ضغط ممر الهواء)\nمثال: لا يوجد دليل على أن الخنق تم بواسطة المتهم",
 "承": "رَضِيَ, وَافَقَ (قَبِلَ؛ سلَّم واقتنع) / رِضًا (مصدر الفعل \"رَضِيَ\")",
 "承く": "اِسْتَقْبَلَ, اِسْتَلَمَ (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه) / اِسْتَقْبَلَ, يَسْتَقْبِل (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه)\nمثال: استقبل توم الضيوف.",
 "承け": "شَعْبِيَّة / دِفَاع, حِمَايَة / دِفاع / اِتِّفَاق, تَوَافُق / إِقْرَار / اِتِّفَاق, اِتِّفَاقِيَّة / قَاع (أَرْض مستوية سهلة تنصب إِليها مياه الأمطار فتمسكها ثم تُنبت العشب؛ القَعْر) / قَعْر / سَالِب\nمثال: نمت في قاعة السينما.",
 "承ける": "اِسْتَقْبَلَ, اِسْتَلَمَ (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه) / اِسْتَقْبَلَ, يَسْتَقْبِل (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه)\nمثال: استقبل توم الضيوف. / لُقْطَة / أَمْسَكَ (حَبَسَ الشيءَ، قَبَضَ عَلَيْهِ. و (يتعدى بالباء)؛ اِمْتَنَعَ بالشيءِ، اِعْتَصَمَ بِه. (يتعدى بالباء)) / مَسَكَ\nمثال: كنت أمسك بالكرة. / أَبْقَى / عَالَ, يَعُولُ (افتقر واحتاج إلى مساعدة غيره المادية؛ عاله الشيء: اعوزه واحتاجه)\nمثال: بدأ يبكي بصوت عال / أَخَذَ (تَنَاوَلَ الشيء بيده، تملكه أو تحكم فيه، بالقوة أو بدونها؛ أمْسَكَ بِالشيء. (يتعدى بالباء)) / أَخَذَ بِـ (تَنَاوَلَ الشيء بيده، تملكه أو تحكم فيه، بالقوة أو بدونها؛ أمْسَكَ بِالشيء. (يتعدى بالباء)) / اِتَّخَذَ / اِسْتَغْرَقَ / اِلْتَقَطَ\nمثال: أخذ الولد يبكي.",
 "承り及ぶ": "سَمِعَ بِـ (أَدْرَكَ الصوت بأذنه؛ أَصْغَى، أَنْصَتَ. (يتعدى باللام وإلى))\nمثال: سمع سامي صريرا.",
 "承る": "سَمِع (أَدْرَكَ الصوت بأذنه؛ أَصْغَى، أَنْصَتَ. (يتعدى باللام وإلى))\nمثال: سمع سامي صريرا. / اِسْتَقْبَلَ, اِسْتَلَمَ (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه) / اِسْتَقْبَلَ, يَسْتَقْبِل (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه)\nمثال: استقبل توم الضيوف.",
 "承伏": "مُتَقَبِّل",
 "承允": "رَضِيَ, وَافَقَ (قَبِلَ؛ سلَّم واقتنع) / رِضًا (مصدر الفعل \"رَضِيَ\")\nمثال: السكوت علامة الرضا.",
 "承前": "متواصل, مستمر (بدون توقف أو انقطاع)\nمثال: لضمان النجاح المتواصل للحرب",
 "承口": "مَقْبِس",
 "承引": "رَضِيَ, وَافَقَ (قَبِلَ؛ سلَّم واقتنع) / رِضًا (مصدر الفعل \"رَضِيَ\")\nمثال: السكوت علامة الرضا.",
 "承接": "مُتَتَالِيَة, مُتَوَالِيَة",
 "承服": "مُتَقَبِّل",
 "承知": "عِلْم, مَعْرِفَة (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس. / قَبُول, قُبُول (القبول: الرِّضَا بالشيء وميل النفس إليه والحسن والشارة وريح الصبا؛ (المعجم الوسيط)؛ ريح شرقية)\nمثال: أميل إلى قبول العرض. / غَفُور (غَفُور: ( اسم )؛ غَفور: ( اسم ))",
 "承知の上で": "عَمْدًا",
 "承知の助": "حَسَنًا, أُوكِي (تقال عند استحسان الفعل أو القول، هَذَا حَسَن)\nمثال: حسنا. أنا موافق.",
 "承知の幕": "اِتِّفَاق, تَوَافُق / إِقْرَار / اِتِّفَاق, اِتِّفَاقِيَّة",
 "承知之助": "حَسَنًا, أُوكِي (تقال عند استحسان الفعل أو القول، هَذَا حَسَن)\nمثال: حسنا. أنا موافق.",
 "承継": "تولي, خلافة (اكتساب الممتلكات عن طريق النسب أو الوصية) / تتابع, تسلسل (فعل التتابع بالترتيب) / تسلسل, تعاقب (تتابع شيء بعد آخر في الوقت) / تتابع, تعاقب (مجموعة من الأشخاص أو الأشياء مرتبة أو متتابعة بالترتيب)\nمثال: لعب الأوراق الرابحة بالتسلسل",
 "承認": "إذن بالكلام (تعيين من قبل رئيس الجلسة يمنح الشخص الحق في التحدث في هيئة تداولية) / تحديد الهوية, تعرف (عملية التعرف على شيء ما أو شخص ما عن طريق التذكر) / إدراك, اعتراف (الوصول إلى فهم شيء ما بوضوح وتميز) / إقرار, اعتراف (قبول (مثل قبول ادعاء) على أنه حقيقي وصالح)\nمثال: لم يتمكن من تقديم اقتراحه لأنه لم يحصل على إذن بالكلام من الرئيس",
 "承認印": "خاتم الموافقة, ختم (مؤشر على الحالة المعتمدة أو المتفوقة)",
 "承認者": "مُعتمِد, مُوافق (سلطة لديها القدرة على الموافقة)",
 "承認証": "خاتم الموافقة, ختم (مؤشر على الحالة المعتمدة أو المتفوقة)",
 "承諾": "رَضِيَ, وَافَقَ (قَبِلَ؛ سلَّم واقتنع) / رِضًا (مصدر الفعل \"رَضِيَ\")\nمثال: السكوت علامة الرضا.",
 "承諾年齢": "سن الرشد القانوني, سن الموافقة (الحد الأدنى للسن للزواج دون موافقة الوالدين أو الحد الأدنى للسن للعلاقات الجنسية بالتراضي)",
 "技": "أُسْلُوب, تِقْنِيَة (الطَرِيْق والفنّ من القول؛ الطريقة بصورة عامة سواء كانت من القول أو الفعل أو الفكر)\nمثال: هو يحب أسلوب معطوب.",
 "技倒": "ضربة قاضية فنية (ضربة قاضية يعلنها الحكم الذي يقرر أن أحد الملاكمين غير قادر على الاستمرار)",
 "技士": "تِقْنِيّ, فَنِّيّ",
 "技工": "حِرْفَة, صَنْعَة / صَانِع (كل من يَصْنَعُ شيئا؛ من يَمْتَهِنُ الصِّنَاعَة) / حِرَفِيّ / حِرْفِيّ\nمثال: أحب أن أكون صانع محتوى.",
 "技巧": "أُسْلُوب, تِقْنِيَة (الطَرِيْق والفنّ من القول؛ الطريقة بصورة عامة سواء كانت من القول أو الفعل أو الفكر)\nمثال: هو يحب أسلوب معطوب.",
 "技巧的": "فَنِّيّ (ناتج عن عوامل السوق وليس عن الاعتبارات الاقتصادية الأساسية) / خطأ فني ((كرة السلة) خطأ يمكن احتسابه على لاعب أو مدرب أو فريق لسلوك غير رياضي؛ لا ينطوي عادة على احتكاك جسدي أثناء اللعب) / تقني, فني (يميز أو يظهر مهارة في أو معرفة متخصصة بالفنون والعلوم التطبيقية) / تَخَصُّصِيّ, تَقْنِيّ (يتعلّق بمعرفة متخصصة أو يتطلّبها للفهم)\nمثال: مشكلة فنية",
 "技師": "مُهَنْدِس, مُهَنْدِسَة (الذي يمارس مهنة الهَنْدَسَة)\nمثال: أبي مهندس مدني.",
 "技手": "داهية, محتال ذكي (شخص ذكي أو عديم المبادئ يعرف كيفية التحايل على الصعوبات لتحقيق أهدافه) / عامل تشغيل, مُشَغِّل (وكيل يقوم بتشغيل جهاز أو آلة) / مُشغِّل (شخص يمتلك أو يدير عملاً تجارياً) / مشغل, مضارب محترف (مضارب يتداول بقوة في أسواق الأسهم أو السلع)\nمثال: مشغل لوحة المفاتيح",
 "技法": "أُسْلُوب, تِقْنِيَة (الطَرِيْق والفنّ من القول؛ الطريقة بصورة عامة سواء كانت من القول أو الفعل أو الفكر)\nمثال: هو يحب أسلوب معطوب.",
 "技能": "قُدْرَة, مَقْدِرَة / مَوْهِبَة",
 "技能者": "تِقْنِيّ, فَنِّيّ",
 "技芸": "إنسانيات, علوم إنسانية (دراسات تهدف إلى توفير معرفة عامة ومهارات فكرية (بدلاً من المهارات المهنية أو الوظيفية))\nمثال: كلية الآداب والعلوم",
 "技術": "تِكْنُولُوجْيَا, تِقَانَة\nمثال: 私は彼の運転の技術は素晴らしいと思う。 — أنا معجبةٌ بمهارته في القيادة. / أُسْلُوب, تِقْنِيَة (الطَرِيْق والفنّ من القول؛ الطريقة بصورة عامة سواء كانت من القول أو الفعل أو الفكر)\nمثال: هو يحب أسلوب معطوب. / فَنّ, فُنُون (نوع، صنف؛ كل عمل جميل يؤثر في المشاعر والعواطف)\nمثال: هذا مدرسنا في الفن.",
 "技術員": "تِقْنِيّ, فَنِّيّ",
 "技術屋": "مُهَنْدِس, مُهَنْدِسَة (الذي يمارس مهنة الهَنْدَسَة)\nمثال: أبي مهندس مدني.",
 "技術情報": "دِرَايَة, بَرَاعَة",
 "技術水準": "بِأَحْدَث التِّقْنِيَّات (على أعلى مستوى من التطوّر في وقت معيّن (خاصة الوقت الحالي))",
 "技術的": "فَنِّيّ (ناتج عن عوامل السوق وليس عن الاعتبارات الاقتصادية الأساسية) / خطأ فني ((كرة السلة) خطأ يمكن احتسابه على لاعب أو مدرب أو فريق لسلوك غير رياضي؛ لا ينطوي عادة على احتكاك جسدي أثناء اللعب) / تقني, فني (يميز أو يظهر مهارة في أو معرفة متخصصة بالفنون والعلوم التطبيقية) / تَخَصُّصِيّ, تَقْنِيّ (يتعلّق بمعرفة متخصصة أو يتطلّبها للفهم)\nمثال: مشكلة فنية / تَطْبِيقِيّ / عَمَلِيّ",
 "技術的特異点": "تميز, فرادة (صفة كون الشيء فريداً من نوعه) / تَفَرُّد, غَرَابَة (الغرابة بحكم كون الشيء لافتاً أو غير عادي)\nمثال: ميزه ذلك التفرد عن جميع رفاقه",
 "技術者": "مُهَنْدِس, مُهَنْدِسَة (الذي يمارس مهنة الهَنْدَسَة)\nمثال: أبي مهندس مدني.",
 "技量": "قُدْرَة, مَقْدِرَة / مَوْهِبَة",
 "抄": "نبذة – مقتطفات من / تذييل, تعليق (عملية إضافة ملاحظات) / حاشية, ملاحظة (تعليق أو تعليمات (تضاف عادة))\nمثال: أضيفت ملاحظاته في نهاية المقال",
 "抄い": "مِغْرَفَة",
 "抄き": "صناعة الورق (حرفة صنع الورق)",
 "抄き返す": "إعادة إنتاج, نسخة جديدة (إبداع تم إنشاؤه مرة أخرى أو من جديد)\nمثال: إنه إعادة إنتاج لفيلم قديم",
 "抄出": "استخراج, خلع (عملية إخراج شيء ما (خاصة باستخدام الجهد أو القوة)) / أصل, منشأ (الخصائص المنسوبة لأسلافك) / استخراج, استخلاص (عملية الحصول على شيء من خليط أو مركب بوسائل كيميائية أو فيزيائية أو ميكانيكية)\nمثال: أعطاها طبيب الأسنان تخديراً موضعياً قبل الخلع",
 "抄本": "نبذة – مقتطفات من",
 "抄紙": "صناعة الورق (حرفة صنع الورق)",
 "抄造": "صناعة الورق (حرفة صنع الورق)",
 "抄録": "اقتباس (ممارسة الاقتباس من الكتب أو المسرحيات وغيرها) / اقتباس (مقطع أو تعبير مقتبس أو مستشهد به) / تسعيرة, سعر السوق (بيان لسعر السوق الحالي لورقة مالية أو سلعة) / إشارة مرجعية, استشهاد (ملاحظة قصيرة تعترف بمصدر المعلومات أو فقرة مقتبسة)\nمثال: بما أنه يفتقر إلى الأصالة، يجب عليه الاعتماد على الاقتباس",
 "抉じる": "عتلة, مِخْل (رافعة حديدية ثقيلة أحد طرفيها مُشَكَّل كإسفين)",
 "抉り出す": "مَقْصُوص, مُقْتَطَع (تم قصه واستخراجه) / كَشَفَ (كشَّف الأمرَ بالغ في كشْفِه وتوضيحه؛ أزال الغطاء أو جعل الشيء مكشوفًا) / أَوْحَى, أَنْزَلَ (بمعنى وَحَى، أَشَارَ؛ ألهم، يستخدم في الخير والشر، من الله أو من غيره)\nمثال: كشف كارل المزيد.",
 "抉り取る": "تَجَوَّفَ",
 "抉る": "تجويف, نقر (فعل النقر أو التجويف بأداة) / إزميل مقعر, مِنْقَار (أداة ذات حد بشفرة تشبه الميزاب لقطع القنوات أو الأخاديد) / انبعاج, حز (أثر غائر في سطح (كما ينتج عن ضربة)) / تَجَوَّفَ / مِغْرَفَة / رَعَشَة / يرتعش / يهز / عتلة, مِخْل (رافعة حديدية ثقيلة أحد طرفيها مُشَكَّل كإسفين) / مِعْوَل, فَأْس (الفأس الكبيرة العظيمة، تستخدم في الزراعة والصناعة)",
 "把": "إِبَالَة, حُزْمَة",
 "把っ手": "مِقْبَض",
 "把手": "مِقْبَض",
 "把持": "قَبْضَة",
 "把捉": "جَشِع, حَرِيص (شديد الرغبة بشكل مفرط في اكتساب الثروة وغيرها) / إمساك, قبض (فعل الإمساك بشيء بإحكام باليدين) / محاولة الفهم (الفهم بصعوبة)\nمثال: كانت المحاضرة تتجاوز أقصى محاولاته للفهم",
 "把握": "قَبْضَة",
 "抑": "فِي النِّهَايَة (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "抑々揚格": "تفعيلة أنابيستية, تفعيلة قصيرة-قصيرة-طويلة (وحدة مترية بمقاطع غير مشددة-غير مشددة-مشددة)",
 "抑うつ": "إحباط, انقباض (حالة من الاكتئاب السوداوي) / براز, غائط (منتج إخراجي صلب يفرغ من الأمعاء)",
 "抑うつ症": "اضطراب اكتئابي, اكتئاب سريري (حالة من الاكتئاب وانعدام التلذذ شديدة لدرجة تتطلب تدخلاً سريرياً)",
 "抑うつ症群": "اضطراب اكتئابي, اكتئاب سريري (حالة من الاكتئاب وانعدام التلذذ شديدة لدرجة تتطلب تدخلاً سريرياً)",
 "抑うつ障害群": "اضطراب اكتئابي, اكتئاب سريري (حالة من الاكتئاب وانعدام التلذذ شديدة لدرجة تتطلب تدخلاً سريرياً)",
 "抑え": "وَزْن / ثِقْل (ثَقَلَ الشيءَ يَثْقُلُه بِيَدِهِ ثَقْلًا: رَازَ ثِقَلَه؛ ثَقَلَ الشَّيْء بِيَدِهِ ثقلا قدّر ثِقْلَه)\nمثال: ان ثقل ما تحمل، فضع بعضا منه. / دِفَاع, حِمَايَة / دِفاع",
 "抑えがたい": "جَامِح, لَا يُمْكِنُ كَبْحُهُ (يَسْتَحِيلُ قَمْعُهُ أَوِ السَّيْطَرَةُ عَلَيْه) / لَا يُمْكِنُ السَّيْطَرَةُ عَلَيْه, مُسْتَعْصٍ (غَيْرُ قَابِلٍ لِلسَّيْطَرَةِ أَوِ الإِدَارَة) / جَامِح, مُتَمَرِّد (لا يمكن السيطرة عليه أو إخضاعه) / عَصِيّ عَلَى الحَلّ, لَا يُمْكِن السَّيْطَرَة عَلَيْه (صعب الحل أو التخفيف منه)",
 "抑えきれない": "جَامِح, لَا يُمْكِنُ كَبْحُهُ (يَسْتَحِيلُ قَمْعُهُ أَوِ السَّيْطَرَةُ عَلَيْه)",
 "抑える": "سَيْطَرَ / تَحَكُّم, مُرَاقَبَة (\"تَحَكَّمَ فِي أُمُورِهِ الشَّخْصِيَّةِ\" : ضَبَطَهَا وَأَحْكَمَهَا؛ \"يَتَحَكَّمُ فِي أُمُورِ غَيْرِهِ\" : يَتَصَرَّفُ فِيهَا كَمَا يَشَاءُ وَيُرِيدُ)\nمثال: من أنت لتحكم علي؟ / تَفَقُّد / كِشّ مَلِك / فَاتُورَة, حِسَاب / اِسْتَأْنَى, دَقَّقَ ((مُتَعَدٍّ بِالْبَاءِ أَوْ بِـ\"فِي\" أو بِدُونِهِمَا) تَأَنَّى، انْتَظَرَ) / كَشَّ",
 "抑え切れない": "جَامِح, لَا يُمْكِنُ كَبْحُهُ (يَسْتَحِيلُ قَمْعُهُ أَوِ السَّيْطَرَةُ عَلَيْه)",
 "抑え込み": "تعطيل, شل الحركة (فعل الحد من الحركة أو جعل الشيء غير قادر على الحركة)\nمثال: تسببت العاصفة في شلل تام لفريق الإنقاذ",
 "抑え込む": "سَيْطَرَ / تَحَكُّم, مُرَاقَبَة (\"تَحَكَّمَ فِي أُمُورِهِ الشَّخْصِيَّةِ\" : ضَبَطَهَا وَأَحْكَمَهَا؛ \"يَتَحَكَّمُ فِي أُمُورِ غَيْرِهِ\" : يَتَصَرَّفُ فِيهَا كَمَا يَشَاءُ وَيُرِيدُ)\nمثال: من أنت لتحكم علي؟",
 "抑え難い": "جَامِح, لَا يُمْكِنُ كَبْحُهُ (يَسْتَحِيلُ قَمْعُهُ أَوِ السَّيْطَرَةُ عَلَيْه) / لَا يُمْكِنُ السَّيْطَرَةُ عَلَيْه, مُسْتَعْصٍ (غَيْرُ قَابِلٍ لِلسَّيْطَرَةِ أَوِ الإِدَارَة) / جَامِح, مُتَمَرِّد (لا يمكن السيطرة عليه أو إخضاعه) / عَصِيّ عَلَى الحَلّ, لَا يُمْكِن السَّيْطَرَة عَلَيْه (صعب الحل أو التخفيف منه)",
 "抑制": "سَيْطَرَ / تَحَكُّم, مُرَاقَبَة (\"تَحَكَّمَ فِي أُمُورِهِ الشَّخْصِيَّةِ\" : ضَبَطَهَا وَأَحْكَمَهَا؛ \"يَتَحَكَّمُ فِي أُمُورِ غَيْرِهِ\" : يَتَصَرَّفُ فِيهَا كَمَا يَشَاءُ وَيُرِيدُ)\nمثال: من أنت لتحكم علي؟",
 "抑制剤": "مانع, مثبط (مادة تؤخر أو توقف نشاطاً ما)",
 "抑制性": "قَمْعِيّ, كَبْتِيّ (يُقيِّد الفعل أو يكبته)",
 "抑圧": "تَفَقُّد / كِشّ مَلِك / فَاتُورَة, حِسَاب / اِسْتَأْنَى, دَقَّقَ ((مُتَعَدٍّ بِالْبَاءِ أَوْ بِـ\"فِي\" أو بِدُونِهِمَا) تَأَنَّى، انْتَظَرَ) / كَشَّ / قَمْع, كَبْت",
 "抑揚": "تَجْوِيد, تَرْتِيل (جوّد القارئ:أتى بـ التّلاوة على وجهها الحقّ وراعى أحكام التّجويد في القرآن (قرأ القرآن مُجوّداً):رتّله ترتيلاً؛ تجوّد في العمل:تأنّق فيه،والشيء:تخيّره وطلب أن يكون جيّداً)",
 "抑揚のない": "مُمِلّ (ما يسبب الضجر والضيقة، غير مثير للاهتمام)\nمثال: نهار اليوم ممل!",
 "抑揚の無い": "مُمِلّ (ما يسبب الضجر والضيقة، غير مثير للاهتمام)\nمثال: نهار اليوم ممل!",
 "抑揚格": "تفعيلة إيامبية, تفعيلة قصيرة-طويلة (وحدة مترية بمقاطع غير مشددة-مشددة)",
 "抑止": "رَدْع (رَدَعَه عنه: كَفَّهُ ورَدَّهُ، فارْتَدَعَ؛ رَدَعَ جَيْبَه عنه: فَرَجَه)\nمثال: بما أن إسرائيل خسرت حربا في لبنان عام 2006، شنت العديد من حملات قصف كبيرة في غزة كي تسترجع قدرتها على الردع.",
 "抑止力": "رَدْع (رَدَعَه عنه: كَفَّهُ ورَدَّهُ، فارْتَدَعَ؛ رَدَعَ جَيْبَه عنه: فَرَجَه)\nمثال: بما أن إسرائيل خسرت حربا في لبنان عام 2006، شنت العديد من حملات قصف كبيرة في غزة كي تسترجع قدرتها على الردع.",
 "抑留": "اِحْتِجَاز, حَجْز",
 "抑留者": "أسير, أسيرة (اَلْأَسِيرُ هُوَ مَنْ أُسِرَ فِي مَعْرَكَةٍ حَيّّا فَسُجِنَ إِلَى حِينٍ؛ الأَسيرُ: الأَخِيذُ)\nمثال: أنا بريء وأسير حرب.",
 "抑鬱": "إحباط, انقباض (حالة من الاكتئاب السوداوي) / براز, غائط (منتج إخراجي صلب يفرغ من الأمعاء)",
 "抒情": "شاعريّة, عاطفة جياشة (حماس مفرط وغير مقيد) / شاعرية, غنائية (خاصية الملاءمة للغناء)",
 "抒情的": "غِنَائِيّ, وِجْدَانِيّ (يعبّر عن عاطفة عميقة) / غِنَائِيّ, وِجْدَانِيّ (مُنَاسِبٌ لِلْغِنَاءِ أَوْ يُوحِي بِه)",
 "抒情詩": "غِنَائِيّ, وِجْدَانِيّ (يعبّر عن عاطفة عميقة) / غنائي (تستخدم لمغنٍ أو صوت غنائي خفيف الحجم ومتواضع النطاق) / غنائي, وجداني (متعلق بفئة من الشعر تعبر عن العاطفة (غالباً بطريقة شبيهة بالأغنية)) / أوبرالي, غنائي (متعلق بالدراما الموسيقية)\nمثال: سوبرانو غنائي",
 "抓み": "عُقدة, مقبض دائري (مقبض مستدير الشكل) / عقدة, مقبض (نتوء أو بروز دائري مستدير) / مقبض مزخرف (زخرفة على شكل كرة على مقبض السيف أو الخنجر) / تغلظ, عقدة (أي تضخم سميك) / وَجْبَة خَفِيفَة, لُمْجَة (الحصة التي صارت واجبة؛ الحصة الواحدة من الطعام توجب في موعد محدد)\nمثال: التهم زيري الوجبة. / قَرَصَ / قَرْصَة / مِقْبَض",
 "抓む": "مِعْوَل, فَأْس (الفأس الكبيرة العظيمة، تستخدم في الزراعة والصناعة)",
 "抓める": "قَرَصَ / قَرْصَة",
 "抓る": "قَرَصَ / قَرْصَة",
 "投": "زِفْت",
 "投げ": "رَمَى, صَبَّ ((مُتَعَدٍّ بِنَفْسِهِ) جَعَلَهُ يَتَحَرَّكُ فِي الهَوَاءِ)\nمثال: رمى تلك الموزة. / اِسْتَقَالَ / غربلة, هزة (اقتصادية) (حالة اقتصادية تؤدي إلى إقصاء المشاركين الممولين بشكل هامشي في صناعة ما)\nمثال: أغرقوا السوق من أجل إحداث هزة لمنافسيهم",
 "投げかける": "دَارَ, أَدَارَ (المحل يجمع البِنَاء والعَرَصَة. قيل سمي كذلك لدوران الناس به وعليه وحوله. يجمع على دُور؛ المنزل المَبْني. يجمع على دُور) / لَفَّ / قَلَبَ / اِنْقَلَبَ, صَارَ / اِنْعِطَاف / دَوْر, نَوْبَة (جَعَله يَدُور؛ جَعَلَه مُدَوَّر)\nمثال: إذهب إلى الدار.",
 "投げやり": "متهاون, مقصّر (يتميز بالإهمال وعدم الاكتراث غير المبرر)\nمثال: آباء مهملون",
 "投げる": "رَمَى, صَبَّ ((مُتَعَدٍّ بِنَفْسِهِ) جَعَلَهُ يَتَحَرَّكُ فِي الهَوَاءِ)\nمثال: رمى تلك الموزة. / تَنَازَلَ / تَخَلَّى / اِسْتَسْلَمَ / صَبَّ, رَمَى (سَكَبَ، الفرق بين صَبَّ وسَكَب أن الصَبّ يكون متعمدا والسكب قد يكون متعمدا أو خطأ؛ صَبَّ الطعام، أي سكبه في الإناء أو الصحون) / ضِمَاد مِنَ الْجِبْس\nمثال: صب الشاي لضيفك.",
 "投げ下ろす": "مَزْبَلَة, نُفَايَة (موضع تجميع الأَزْبَال والتِفَايَات لحين نقلها؛ حَاوِيَة نفايات؛ موضع خارج المدينة توضع فيه الأزبال والنفايات)\nمثال: وضع فاضل جثة دانية في مزبلة.",
 "投げ出す": "مَدَّدَ / اِمْتَدَّ / اِنْصَرَفَ, يَنْصَرِفُ (فعل مطاوعة لصَرَفَ: صَرَفْتُهُ فَاَنْصَرَف؛ ذهب إلى مكان آخر) / تَرَكَ, يترك (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض)\nمثال: انصرف من ملكيتنا! / تَضْحِيَة, قُرْبَان / ضَحَّى",
 "投げ売り": "إغراق (بيع البضائع في الخارج بسعر أقل من السعر المفروض في السوق المحلية)",
 "投げ打つ": "طَرَحَ (طَرَحَ الشَّيْءَ: أَلْقَاهُ؛ طَرَحَ فُلَاناً أَرْضاً: أَوْقَعَهُ)\nمثال: طرح زيري سؤالا.",
 "投げ技": "رَمَى, صَبَّ ((مُتَعَدٍّ بِنَفْسِهِ) جَعَلَهُ يَتَحَرَّكُ فِي الهَوَاءِ)\nمثال: رمى تلك الموزة.",
 "投げ捨てる": "طَرَحَ (طَرَحَ الشَّيْءَ: أَلْقَاهُ؛ طَرَحَ فُلَاناً أَرْضاً: أَوْقَعَهُ)\nمثال: طرح زيري سؤالا.",
 "投げ掛ける": "دَارَ, أَدَارَ (المحل يجمع البِنَاء والعَرَصَة. قيل سمي كذلك لدوران الناس به وعليه وحوله. يجمع على دُور؛ المنزل المَبْني. يجمع على دُور) / لَفَّ / قَلَبَ / اِنْقَلَبَ, صَارَ / اِنْعِطَاف / دَوْر, نَوْبَة (جَعَله يَدُور؛ جَعَلَه مُدَوَّر)\nمثال: إذهب إلى الدار.",
 "投げ棄てる": "طَرَحَ (طَرَحَ الشَّيْءَ: أَلْقَاهُ؛ طَرَحَ فُلَاناً أَرْضاً: أَوْقَعَهُ)\nمثال: طرح زيري سؤالا.",
 "投げ槍": "مِزْرَاق",
 "投げ渡す": "تمرير, رمي ((رياضة) فعل رمي الكرة لعضو آخر في فريقك) / رمي, هز (حركة مفاجئة) / رمي العملة, قرعة (فعل تقليب العملة)\nمثال: تم إهدار التمريرة / اِسْتَسْلَمَ / اِسْتَسْلَام",
 "投げ物": "تَصْفِية",
 "投げ綱": "حبل الرمي (حبل خفيف الوزن مزود بوزن في نهايته، يُلقى بين سفينتين أو بين سفينة والشاطئ لسحب حبل أثقل)\nمثال: غالباً ما تُستخدم عقدة قبضة القرد كوزن في حبل الرمي",
 "投げ網": "شَبَكَة",
 "投げ縄": "أنشوطة, وهق (حبل طويل ذو عقدة منزلقة يستخدم لصيد الحيوانات)",
 "投げ荷": "حطام عائم (حطام سفينة يطفو على الماء) / حمولة مطروحة (جزء من معدات السفينة أو حمولتها يُرمى في البحر لتخفيف الحمل أثناء العاصفة)",
 "投げ込み": "أَدْخَلَ",
 "投げ遣り": "متهاون, مقصّر (يتميز بالإهمال وعدم الاكتراث غير المبرر)\nمثال: آباء مهملون",
 "投げ釣り": "صيد الأمواج (رمي طعم (صناعي) بعيداً في المحيط (حتى 200 ياردة) مع تكسر الأمواج حولك)",
 "投げ銭": "طَرَف / بَقْشِيش / بَقْشِيش, بَخْشِيش / إِخْبَارِيَّة / نَصِيحَة",
 "投げ飛ばす": "عَلَاقَة سَرِيعَة, علاقة طيارى / صَبَّ, رَمَّى (سَكَبَ، الفرق بين صَبَّ وسَكَب أن الصَبّ يكون متعمدا والسكب قد يكون متعمدا أو خطأ؛ صَبَّ الطعام، أي سكبه في الإناء أو الصحون)\nمثال: صب الشاي لضيفك.",
 "投じる": "رَمَى, صَبَّ ((مُتَعَدٍّ بِنَفْسِهِ) جَعَلَهُ يَتَحَرَّكُ فِي الهَوَاءِ)\nمثال: رمى تلك الموزة. / اِسْتَثْمَرَ / أَعْطَى, وَهَبَ (مَنَحَ، نَوَّلَ)\nمثال: أعطى بلده حياته. / اِنْصَرَفَ, يَنْصَرِفُ (فعل مطاوعة لصَرَفَ: صَرَفْتُهُ فَاَنْصَرَف؛ ذهب إلى مكان آخر) / تَرَكَ, يترك (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض)\nمثال: انصرف من ملكيتنا!",
 "投ずる": "رَمَى, صَبَّ ((مُتَعَدٍّ بِنَفْسِهِ) جَعَلَهُ يَتَحَرَّكُ فِي الهَوَاءِ)\nمثال: رمى تلك الموزة. / اِسْتَثْمَرَ / أَعْطَى, وَهَبَ (مَنَحَ، نَوَّلَ)\nمثال: أعطى بلده حياته. / اِسْتَسْلَمَ / اِسْتَسْلَام",
 "投てき": "رَمَى, صَبَّ ((مُتَعَدٍّ بِنَفْسِهِ) جَعَلَهُ يَتَحَرَّكُ فِي الهَوَاءِ)\nمثال: رمى تلك الموزة.",
 "投下": "سَاقِط, مُتَسَاقِط (يَنْزِلُ بِحُرِّيَّةٍ تَحْتَ تَأْثِيرِ الجَاذِبِيَّة) / اِسْتِثْمَار",
 "投下ろす": "مَزْبَلَة, نُفَايَة (موضع تجميع الأَزْبَال والتِفَايَات لحين نقلها؛ حَاوِيَة نفايات؛ موضع خارج المدينة توضع فيه الأزبال والنفايات)\nمثال: وضع فاضل جثة دانية في مزبلة.",
 "投与": "إِدَارَة, مُرَاقَبَة (هو عملية تولي تَصْرِيف شؤون العَمَل. لا جمع له؛ مجموع الناس الذين يقومون بإدارة شؤون الجهة، حكومية كانت أم خاصة) / إِدَارَة تَنْفِيذِيَّة (هو عملية تولي تَصْرِيف شؤون العَمَل. لا جمع له؛ مجموع الناس الذين يقومون بإدارة شؤون الجهة، حكومية كانت أم خاصة)\nمثال: والدتي تنتظرني في الإدارة.",
 "投与量": "جُرْعَة",
 "投了": "اِسْتِقَالَة, اِسْتِعْفَاء",
 "投企": "إِسْقَاط / مَسْقَط (اسم مكان من السقوط؛ موضع السقوط عامّة؛ رأسه: عن المكان الذي وُلِد فيه. يُقصد بها الدولة أو المدينة لا المبنى)\nمثال: دفنت في مسقط رأسها.",
 "投信": "شركة استثمار, صندوق استثمار (مؤسسة مالية تبيع الأسهم للأفراد وتستثمر في الأوراق المالية الصادرة عن شركات أخرى)",
 "投光器": "كشاف ضوئي, مصباح غامر (ضوء يعد مصدراً للإضاءة الاصطناعية ذات شعاع عريض؛ يستخدم في التصوير الفوتوغرافي)",
 "投光機": "كشاف ضوئي, مصباح غامر (ضوء يعد مصدراً للإضاءة الاصطناعية ذات شعاع عريض؛ يستخدم في التصوير الفوتوغرافي)",
 "投光照明": "كشاف ضوئي, مصباح غامر (ضوء يعد مصدراً للإضاءة الاصطناعية ذات شعاع عريض؛ يستخدم في التصوير الفوتوغرافي)",
 "投光照明器": "كشاف ضوئي, مصباح غامر (ضوء يعد مصدراً للإضاءة الاصطناعية ذات شعاع عريض؛ يستخدم في التصوير الفوتوغرافي)",
 "投入": "أَدْخَلَ / اِسْتِثْمَار / إطلاق, قذف (فعل الدفع بقوة) / إطلاق سفينة, تدشين (فعل تحريك سفينة مبنية حديثاً إلى الماء لأول مرة) / إطلاق, تدشين (فعل البدء بشيء جديد)\nمثال: تطلعوا إلى الظهور الأول لخط إنتاجهم الجديد / إصدار, إطلاق (فعل توفير عنصر للاستخدام العام أو لأغراض رسمية (عادة بكميات))\nمثال: إصدار جديد من الطوابع",
 "投写": "إِسْقَاط / مَسْقَط (اسم مكان من السقوط؛ موضع السقوط عامّة؛ رأسه: عن المكان الذي وُلِد فيه. يُقصد بها الدولة أو المدينة لا المبنى)\nمثال: دفنت في مسقط رأسها.",
 "投出": "إِسْقَاط / مَسْقَط (اسم مكان من السقوط؛ موضع السقوط عامّة؛ رأسه: عن المكان الذي وُلِد فيه. يُقصد بها الدولة أو المدينة لا المبنى)\nمثال: دفنت في مسقط رأسها.",
 "投函": "إرسال بالبريد (إرسال رسالة عبر البريد) / إرسالية بريدية (بريد يرسله المرسل في وقت واحد)\nمثال: يشير ختم البريد إلى وقت الإرسال",
 "投合": "اِتِّفَاق, تَوَافُق / إِقْرَار / اِتِّفَاق, اِتِّفَاقِيَّة",
 "投売り": "إغراق (بيع البضائع في الخارج بسعر أقل من السعر المفروض في السوق المحلية)",
 "投宿": "إِقَامَة",
 "投射": "إِسْقَاط / مَسْقَط (اسم مكان من السقوط؛ موضع السقوط عامّة؛ رأسه: عن المكان الذي وُلِد فيه. يُقصد بها الدولة أو المدينة لا المبنى)\nمثال: دفنت في مسقط رأسها.",
 "投射物": "قَذْفِيّ, مَقْذُوف (يدفع أو يُدفَع إلى الأمام) / قذيفة, مقذوف (سلاح يُرمى أو يُقذف بقوة على الأهداف ولكنه ليس ذاتي الدفع) / صاروخ, مركبة صاروخية (أي مركبة ذاتية الدفع بواسطة محرك صاروخي)",
 "投弾帯": "مِقْلَاع / حَمَّالَة",
 "投影": "إِسْقَاط / مَسْقَط (اسم مكان من السقوط؛ موضع السقوط عامّة؛ رأسه: عن المكان الذي وُلِد فيه. يُقصد بها الدولة أو المدينة لا المبنى)\nمثال: دفنت في مسقط رأسها. / اِنْعِكَاس, عَكْس",
 "投影図": "إِسْقَاط / مَسْقَط (اسم مكان من السقوط؛ موضع السقوط عامّة؛ رأسه: عن المكان الذي وُلِد فيه. يُقصد بها الدولة أو المدينة لا المبنى)\nمثال: دفنت في مسقط رأسها.",
 "投影図法": "إِسْقَاط / مَسْقَط (اسم مكان من السقوط؛ موضع السقوط عامّة؛ رأسه: عن المكان الذي وُلِد فيه. يُقصد بها الدولة أو المدينة لا المبنى)\nمثال: دفنت في مسقط رأسها.",
 "投影式": "إِسْقَاط / مَسْقَط (اسم مكان من السقوط؛ موضع السقوط عامّة؛ رأسه: عن المكان الذي وُلِد فيه. يُقصد بها الدولة أو المدينة لا المبنى)",
 "投影機": "جِهَاز إِسْقَاط",
 "投影法": "إِسْقَاط / مَسْقَط (اسم مكان من السقوط؛ موضع السقوط عامّة؛ رأسه: عن المكان الذي وُلِد فيه. يُقصد بها الدولة أو المدينة لا المبنى)\nمثال: دفنت في مسقط رأسها. / اختبار إسقاطي (أي اختبار شخصية مصمم لتقديم معلومات حول شخصية شخص ما بناءً على استجابته غير المقيدة لأشياء أو مواقف غامضة)",
 "投手": "إِبْرِيق, زِير",
 "投捨てる": "طَرَحَ (طَرَحَ الشَّيْءَ: أَلْقَاهُ؛ طَرَحَ فُلَاناً أَرْضاً: أَوْقَعَهُ)\nمثال: طرح زيري سؤالا.",
 "投擲": "رَمَى, صَبَّ ((مُتَعَدٍّ بِنَفْسِهِ) جَعَلَهُ يَتَحَرَّكُ فِي الهَوَاءِ)\nمثال: رمى تلك الموزة.",
 "投擲槍": "مِزْرَاق",
 "投映": "بَارِز, مُمْتَدّ (يمتد للخارج فوق سطح أو حدّ أو ما وراءهما)",
 "投書": "حَرْف, حرف (طَرَف وَجَانِب وَحَدّ؛ رَمْز مخطوط أو مطبوع يقوم مقام صوت أو كلمة أو عبارة أو معنى) / رِسَالَة, مَكْتُوب\nمثال: ألف هو الحرف الأول للألف باء. / مُسَاهَمَة (المُساهَمَة : المُشاركة والاشتراك في الشيء)\nمثال: ويستطيع الجميع المساهمة.",
 "投書家": "كاتب مساهم, مساهم (كاتب يُنشر عمله في صحيفة أو مجلة أو كجزء من كتاب) / متبرع, مساهم (شخص يساهم (أو يعد بالمساهمة) بمبلغ من المال)",
 "投棄": "هِجْرَان, هُجْرَان",
 "投槍": "مِزْرَاق",
 "投槍器": "عصا رمي, قاذفة رماح (جهاز يشبه المقلاع يستخدم في مجتمعات بدائية مختلفة لدفع سهم أو رمح)",
 "投機": "تَكَهُّنٌ / مُضَارَبَة",
 "投機家": "مُضَارِب",
 "投機師": "مُغَامِر, مُغَامِرَة",
 "投機的": "اسْتِفْهَامِيّ, مُتَسَائِل (يُظهِر الفضول والتساؤل) / تَصَوُّرِيّ, نَظَرِيّ (غير مبنيّ على حقائق أو تحقيق فعلي) / خَطِر, مُحْفُوفٌ بِالمَخَاطِر (غير آمن ماليًّا؛ ينطوي على مضاربة ومخاطرة عالية)",
 "投機筋": "مُضَارِب",
 "投物": "تَصْفِية",
 "投獄": "حَبْس, سَجْن (مَنَعَ الشيءَ عن الفعلِ؛ أَمْسَكَ الشيءَ، قَبَضَ عَلَيْهِ)\nمثال: هو,البارحة حرر من الحبس.",
 "投球": "رمي ((في البيسبول) اللعب في مركز الرامي) / تأرجح رأسي, ترنح (حركة صعود وهبوط مفاجئة (كما تسببها سفينة أو وسيلة نقل أخرى))\nمثال: كان التأرجح والتقلب مثيراً للغاية",
 "投球動作": "إتمام, إكمال (إجراء ختامي أو نهائي)",
 "投石": "حَجَر, حجر (حَجَرَ عليه الأمرَ:مَنَعَه منه ، حجر الشّيء على نفسه:خَصَّها به وقصره عليها؛ الحجْرُ: المَنْعُ مِن التَّصَرُّفِ ، وحَجَرَ عَلَيْهِ القاضِي يَحْجُرُ حَجْراً، إِذا مَنَعَه مِن التَّصَرُّفِ فِي مالِه) / حجر, حصى (حَجَرَ عليه الأمرَ:مَنَعَه منه ، حجر الشّيء على نفسه:خَصَّها به وقصره عليها؛ الحجْرُ: المَنْعُ مِن التَّصَرُّفِ ، وحَجَرَ عَلَيْهِ القاضِي يَحْجُرُ حَجْراً، إِذا مَنَعَه مِن التَّصَرُّفِ فِي مالِه) / نواة, عضم / رَجَمَ (رَجَمَ:تكلّم بالظنّ ويُقال:رجم بـ الغيب تكلّم بما لا يعلم ،والقبر :وضع عليه الرّجام،رجمه رَجْماً:رماه بالحجارة وقتله بها…؛ رجم الشخص:رماه بالحجارة ، أو قتله بها (رجم الشّعبُ القتلةَ)،رجمه بالقول:قذفه وشتمه،رجم بالغيب:تكلّم بما لا يعلم)\nمثال: عوقب زيري بالحجر.",
 "投石器": "مَنْجَنِيق, مِرْجَام / مِقْلَاع / حَمَّالَة",
 "投石機": "مَنْجَنِيق, مِرْجَام",
 "投石紐": "مِقْلَاع / حَمَّالَة",
 "投票": "تَصْوِيت",
 "投票制度": "نظام التصويت, نظام انتخابي (نظام قانوني لاتخاذ خيارات ديمقراطية)",
 "投票所": "مركز اقتراع (مكان يذهب إليه الناخبون للإدلاء بأصواتهم في الانتخابات)",
 "投票日": "يوم الاقتراع, يوم الانتخابات (اليوم المحدد للانتخابات؛ في الولايات المتحدة هو أول ثلاثاء بعد أول اثنين في نوفمبر)",
 "投票権": "حق التصويت (الحق في التصويت؛ وخاصة حق المساهم العادي في التصويت شخصيًا أو بالوكالة في شؤون الشركة)",
 "投票機": "آلة تصويت (جهاز ميكانيكي لتسجيل وعد الأصوات آلياً)",
 "投票率": "أصوات المقترعين, نسبة المشاركة (العدد الإجمالي للناخبين الذين شاركوا)\nمثال: يتوقعون عددًا كبيرًا من الأصوات",
 "投票用紙": "وَرَقَةُ اِقْتِرَاع",
 "投票管理者": "رئيس الجلسة, ضابط الجلسة (قائد اجتماع لمجموعة ما)",
 "投票箱": "صندوق الاقتراع (صندوق يودع فيه الناخبون أوراق اقتراعهم)",
 "投票者": "مُصَوِّت, نَاخِب",
 "投稿": "مُسَاهَمَة (المُساهَمَة : المُشاركة والاشتراك في الشيء)\nمثال: ويستطيع الجميع المساهمة.",
 "投稿文": "اِسْتِسْلَام, خُضُوع (فعل الخضوع؛ عادة تسليم السلطة لآخر) / رأي قانوني, طرح ((قانون) حجة يقدمها محامٍ لقاضٍ أو هيئة محلفين كجزء من القضية التي يرافعون فيها) / إحالة للتحكيم, خضوع للتحكيم (اتفاق بين أطراف النزاع للالتزام بقرار المحكم) / اتفاق تحكيم (وثيقة قانونية تلخص اتفاقاً بين أطراف في نزاع للالتزام بقرار محكم)",
 "投稿者": "كاتب مساهم, مساهم (كاتب يُنشر عمله في صحيفة أو مجلة أو كجزء من كتاب) / متبرع, مساهم (شخص يساهم (أو يعد بالمساهمة) بمبلغ من المال)",
 "投網": "شَبَكَة",
 "投縄": "أنشوطة, وهق (حبل طويل ذو عقدة منزلقة يستخدم لصيد الحيوانات)",
 "投薬": "إِدَارَة, مُرَاقَبَة (هو عملية تولي تَصْرِيف شؤون العَمَل. لا جمع له؛ مجموع الناس الذين يقومون بإدارة شؤون الجهة، حكومية كانت أم خاصة) / إِدَارَة تَنْفِيذِيَّة (هو عملية تولي تَصْرِيف شؤون العَمَل. لا جمع له؛ مجموع الناس الذين يقومون بإدارة شؤون الجهة، حكومية كانت أم خاصة)\nمثال: والدتي تنتظرني في الإدارة.",
