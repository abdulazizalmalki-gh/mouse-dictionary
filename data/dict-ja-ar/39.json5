 "採食": "بحث عن الطعام (فعل البحث عن الطعام والمؤن)",
 "採餌": "إِطْعَام",
 "探し": "طَلَب, بَحْث (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى)) / بَحَثَ, فَتَّشَ (طَلَب الشيء في التُرَاب؛ طلب الشيء في أي مكان والتَفْتِيش والتَقَصِّي عنه) / بَحَثَ عَنْ (طَلَب الشيء في التُرَاب؛ طلب الشيء في أي مكان والتَفْتِيش والتَقَصِّي عنه)",
 "探しに": "فِي حَالَةِ اسْتِعْدَاد (في وضع سليم من الجاهزية والترتيب)",
 "探し当てる": "وَجَدَ, لَقِيَ (أَدْرَكَ المطلوب، أَدْرَكَ الشيء الذي أَرَادَهُ وبَحَثَ عنه؛ غَضِبَ عليه. (يتعدى بعلى)) / لَقِيَّة\nمثال: وجد ياني هاتفه.",
 "探し求める": "بَحَثَ, فَتَّشَ (طَلَب الشيء في التُرَاب؛ طلب الشيء في أي مكان والتَفْتِيش والتَقَصِّي عنه)\nمثال: بدأ زيري البحث.",
 "探す": "بَحَثَ, فَتَّشَ (طَلَب الشيء في التُرَاب؛ طلب الشيء في أي مكان والتَفْتِيش والتَقَصِّي عنه)\nمثال: بدأ زيري البحث. / طَلَب, بَحْث (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى)) / بَحَثَ, فَتَّشَ (طَلَب الشيء في التُرَاب؛ طلب الشيء في أي مكان والتَفْتِيش والتَقَصِّي عنه) / بَحَثَ عَنْ (طَلَب الشيء في التُرَاب؛ طلب الشيء في أي مكان والتَفْتِيش والتَقَصِّي عنه)\nمثال: طلب زيري ورودا.",
 "探り": "ذُو صَوْت, مُصَوِّت (يُصدر صوتاً أو ذو صوت محدد؛ يُستخدم كلاحقة تركيبية) / سبر الغور (فعل قياس عمق الماء (عادة باستخدام حبل السبر)) / رَنَّان, مُصَوِّت (ذو حجم صوتي أو عمق) / ذُو صَوْت, ذُو مَظْهَر (يبدو كما يُوصَف؛ يُستخدَم عادةً في التراكيب المركّبة)",
 "探りを入れる": "مِسْبَار",
 "探り出す": "يَشُمّ, يَكْتَشِف",
 "探り回る": "إفلات الكرة ((رياضة) إسقاط الكرة)",
 "探る": "اِسْتَكْشَفَ",
 "探信": "أزيز, رنين (صوت رنان حاد عالي النبرة (كما في صدى السونار أو رصاصة تضرب المعدن))",
 "探信儀": "سُونار",
 "探偵": "مُحَقِّق (من يُجري تحقيق وتحرِّيات للكشف عن ملابسات قضيَّة غامضة؛ قَاضِي التَّحْقِيقِ الَّذِي يُحَقِّقُ مَعَ الْمُتَّهَمِ فِي قَضِيَّةٍ لِلْكَشْفِ عَنْ مَجْرَيَاتِهَا)\nمثال: تحدث ياني مع محقق. / تحري, كشف الجرائم (تحقيق للشرطة لتحديد الجاني)\nمثال: التحري صعب على القدمين (يتطلب مشياً كثيراً)",
 "探偵事務所": "مكتب تحقيقات خاص, وكالة تحريات (وكالة تقوم بإجراء استفسارات لعملائها)",
 "探偵団": "عَصًا (ما يتخذ من خَشَب للتوكؤ أو الضرب؛ تطلق مجازا على عَظْم السَاق وعلى اللِسَان) / نَادٍ لَيْلِيّ, اَلنَّادِي اَللَّيْلِيّ / سِبَاتِي\nمثال: لا تمسك العصا من الوسط.",
 "探偵小説": "قصة بوليسية (سرد عن شخص يحقق في الجرائم ويحصل على أدلة تؤدي إلى حلها)",
 "探偵業": "تحري, كشف الجرائم (تحقيق للشرطة لتحديد الجاني)\nمثال: التحري صعب على القدمين (يتطلب مشياً كثيراً)",
 "探偵社": "مكتب تحقيقات خاص, وكالة تحريات (وكالة تقوم بإجراء استفسارات لعملائها)",
 "探勝": "زِيَارَة مَعَالِم اَلْمَدِينَة, سِيَاحَة",
 "探掘": "توقع, احتمال / تَنْقِيْب (نقّب إذا سار في البلاد طلباً للمهرب ، نقّب عن الأخبار وغيرها:بحث عنها،هو البحث عن كلّ شيء والتّفتيش مطلقاً؛ نقّب مبالغة في نَقَب ، نقّب عن الشيء :فحص عنه فحصاً بليغاً)",
 "探査": "مِسْبَار",
 "探査機": "مِسْبَار",
 "探検": "اِسْتِكْشَاف",
 "探検家": "مُسْتَكْشِف",
 "探検者": "مُسْتَكْشِف",
 "探求": "طَلَب, بَحْث (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى)) / بَحَثَ, فَتَّشَ (طَلَب الشيء في التُرَاب؛ طلب الشيء في أي مكان والتَفْتِيش والتَقَصِّي عنه) / بَحَثَ عَنْ (طَلَب الشيء في التُرَاب؛ طلب الشيء في أي مكان والتَفْتِيش والتَقَصِّي عنه)\nمثال: طلب زيري ورودا.",
 "探求者": "خنفساء البحث (خنفساء كبيرة زرقاء مخضرة معدنية تفترس اليرقات؛ توجد في أمريكا الشمالية) / مفتش جمارك (مسؤول جمارك وظيفته تفتيش الأمتعة أو البضائع أو المركبات بحثاً عن المهربات أو المواد الخاضعة للرسوم) / باحث, طالب (شخص يقوم بالبحث أو الاستفسار)\nمثال: إنهم باحثون عن الحقيقة",
 "探海灯": "كشاف ضوئي (مصدر ضوء بعاكسات يسقط شعاعاً من الضوء في اتجاه معين)",
 "探測": "سَبَّار, مُتَعَمِّق (دقيق وشامل في البحث أو التحقيق)",
 "探照灯": "كشاف ضوئي (مصدر ضوء بعاكسات يسقط شعاعاً من الضوء في اتجاه معين)",
 "探知": "اكتشاف, رصد (فعل اكتشاف شيء ما؛ أو ملاحظة شيء ما) / تحري, كشف الجرائم (تحقيق للشرطة لتحديد الجاني) / استشعار, رصد (الإدراك بأن شيئاً ما قد حدث أو أن حالة ما موجودة) / كشف الإشارة (الكشف عن استقبال إشارة)\nمثال: التحري صعب على القدمين (يتطلب مشياً كثيراً)",
 "探知器": "حساس, كاشف (أي جهاز يستقبل إشارة أو محفزاً (مثل الحرارة أو الضغط أو الضوء أو الحركة) ويستجيب له بطريقة مميزة) / كاشف (معدات إلكترونية تكشف عن وجود إشارات راديو أو نشاط إشعاعي) / كاشف, مزيل التعديل (مقوم يستخرج التعديل من موجة حاملة لاسلكية)",
 "探知機": "حساس, كاشف (أي جهاز يستقبل إشارة أو محفزاً (مثل الحرارة أو الضغط أو الضوء أو الحركة) ويستجيب له بطريقة مميزة) / كاشف (معدات إلكترونية تكشف عن وجود إشارات راديو أو نشاط إشعاعي) / كاشف, مزيل التعديل (مقوم يستخرج التعديل من موجة حاملة لاسلكية)",
 "探究": "بَحْث, تَحْقِيق (طَلَب الشيء في التُرَاب؛ طلب الشيء في أي مكان والتَفْتِيش والتَقَصِّي عنه) / بَحَثَ (طَلَب الشيء في التُرَاب؛ طلب الشيء في أي مكان والتَفْتِيش والتَقَصِّي عنه)\nمثال: بدأ زيري البحث.",
 "探究者": "مُحَقِّق, مُحَقِّقَة (من يُجري تحقيق وتحرِّيات للكشف عن ملابسات قضيَّة غامضة؛ قَاضِي التَّحْقِيقِ الَّذِي يُحَقِّقُ مَعَ الْمُتَّهَمِ فِي قَضِيَّةٍ لِلْكَشْفِ عَنْ مَجْرَيَاتِهَا)\nمثال: تحدث ياني مع محقق.",
 "探索": "طَلَب, بَحْث (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى)) / بَحَثَ, فَتَّشَ (طَلَب الشيء في التُرَاب؛ طلب الشيء في أي مكان والتَفْتِيش والتَقَصِّي عنه) / بَحَثَ عَنْ (طَلَب الشيء في التُرَاب؛ طلب الشيء في أي مكان والتَفْتِيش والتَقَصِّي عنه)\nمثال: طلب زيري ورودا.",
 "探索反射": "منعكس البحث عن الثدي, منعكس التجذير (منعكس يتكون من إدارة الرأس وحركات المص التي تثار عند الرضيع الطبيعي عن طريق لمس جانب الفم أو الخد برفق)",
 "探索者": "مُحَقِّق, مُحَقِّقَة (من يُجري تحقيق وتحرِّيات للكشف عن ملابسات قضيَّة غامضة؛ قَاضِي التَّحْقِيقِ الَّذِي يُحَقِّقُ مَعَ الْمُتَّهَمِ فِي قَضِيَّةٍ لِلْكَشْفِ عَنْ مَجْرَيَاتِهَا)\nمثال: تحدث ياني مع محقق.",
 "探訪": "بَحْثِيّ, فَاحِص (يستكشف بشكل معمّق وشامل) / سَبَّار, مُتَعَمِّق (دقيق وشامل في البحث أو التحقيق) / ثَاقِب, نَافِذ (ذو حدة ونفاذ في الفكر أو التعبير)",
 "探針": "مِسْبَار",
 "探鉱": "توقع, احتمال / تَنْقِيْب (نقّب إذا سار في البلاد طلباً للمهرب ، نقّب عن الأخبار وغيرها:بحث عنها،هو البحث عن كلّ شيء والتّفتيش مطلقاً؛ نقّب مبالغة في نَقَب ، نقّب عن الشيء :فحص عنه فحصاً بليغاً)",
 "探険": "اِسْتِكْشَاف",
 "探険家": "مُسْتَكْشِف",
 "探険者": "مُسْتَكْشِف",
 "探餌": "بحث عن الطعام (فعل البحث عن الطعام والمؤن)",
 "掣肘": "تقييد, كبح (فعل السيطرة عن طريق تقييد شخص ما أو شيء ما) / رادع, قيد (جهاز يؤخر حركة شيء ما) / بساطة, تقشف فني (الخلو من الزخرفة) / تحفظ, كبح (الانضباط في الأنشطة الشخصية والاجتماعية)\nمثال: التقييد غير القانوني للتجارة",
 "接ぎ": "مُصَحِّح / رَقَّعَ ((رَقَعَ) الشيخُ ونحوُه رَقْعًا: اعْتَمَد على راحَتَيْه عند القيام؛ (رَقَعَ) في سَيْرِه: أسْرَع) / وَصَلَ (ضَمَّ وَلَأَمَ. (مصدره وَصْل وصِلَة)؛ بَلَغَ الشيءَ، أَدْرَكَه. (يتعدى بإلى) (مصدره وُصُول)) / اِتَّصَلَ / اِلْتَحَقَ بِـ, اِنْضَمَّ إِلَى\nمثال: وصل السيد باكر. / خَلِيف / وَارِث, وَارِثَة (اسم فاعل من الفعل وَرَثَ؛ الوَارِث: اسم من الأسماء الحسنى) / صِلَة, صُلَة / عَلَاقَة, صِلَة",
 "接ぎ台": "مِقْعَد (كل ما يُقْعَدُ ويُجْلَسُ عليه؛ مَكَان القُعُود) / مَقْعَدَة / بِرَاز\nمثال: نام ياني على مقعد. / جَرْد, خَزِين (جَرَدَ الشيءَ: أحصى ما فيه، ضبط قيمته؛ جَرَدَ البطاطسَ: قشّرها وأزال ما عليها) / مَخْزُون / مَرَقَة, حَسَاء (الطَعَام السائل الخفيف فيه ماء اللحم وقد يكون فيه خضار أو غير ذلك. يؤكل عادة مع الرز أو الخبز. يجوز قول مَرَق، والمَرَقَة أخص من المرَق) / مَنْثُور / قَنْدَاق\nمثال: كان سامي جرد طفل.",
 "接ぎ木": "تَطْعِيم (زرع غصن من نوع من الشجر على غصن من نوع آخر، مثلا زرع غصن من البرتقال في شجرة ليمون لتكون النتيجة أن شجرة الليمون تنتج ليمونا وبرتقالا؛ علاج طبي يستهدف إلى منع الأمراض التي تتسبب من الجراثيم أو الفيروسات. استخدام حديث)",
 "接ぎ目": "دَرْز (درز:درزا تمكن من درز الدُّنْيَا؛ دَرِزَ الرجلُ، كفَرِح، وَكَذَلِكَ ذَرِزَ، بالدّالِ والذّالِ، إِذا تمَكَّن مِنْهَا أَي من نَعيمِها)",
 "接ぎ穂": "سليل (حفيد أو وريث)\nمثال: سليل أصل ملكي",
 "接ぐ": "وَصَلَ (ضَمَّ وَلَأَمَ. (مصدره وَصْل وصِلَة)؛ بَلَغَ الشيءَ، أَدْرَكَه. (يتعدى بإلى) (مصدره وُصُول)) / اِتَّصَلَ / اِلْتَحَقَ بِـ, اِنْضَمَّ إِلَى\nمثال: وصل السيد باكر. / طُعْم (ذَاقَ)\nمثال: أحب طعم البطيخ.",
 "接しる": "لَمَسَ (اتصل بشيء أو شخص بشكل مباشر بواسطة جزء من الجسم مثل اليد، التواصل الحسي أو المعنوي مع شيء ما؛ يدل على التواصل، سواء كان ماديًا أو معنويًا، مع شيء ما) / لَمْسَة, مُلَامَسَة / لَمْس (اتصل بشيء أو شخص بشكل مباشر بواسطة جزء من الجسم مثل اليد، التواصل الحسي أو المعنوي مع شيء ما؛ يدل على التواصل، سواء كان ماديًا أو معنويًا، مع شيء ما)\nمثال: إياك ولمس شطيرتي! / اِسْتَقْبَلَ, اِسْتَلَمَ (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه) / اِسْتَقْبَلَ, يَسْتَقْبِل (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه)\nمثال: استقبل توم الضيوف. / صَادَفَ, لَاقَى (لَقِيَ، وَافَقَ، وَجَدَ؛ وَاجَهَ، لَاقَى، وَجَدَ) / مُلَاقَاة, مُقَابَلَة (لِقَاء)\nمثال: صادف مشكلا صعبا.",
 "接し方": "مَوْقِف, سُلُوك",
 "接する": "لَمَسَ (اتصل بشيء أو شخص بشكل مباشر بواسطة جزء من الجسم مثل اليد، التواصل الحسي أو المعنوي مع شيء ما؛ يدل على التواصل، سواء كان ماديًا أو معنويًا، مع شيء ما) / لَمْسَة, مُلَامَسَة / لَمْس (اتصل بشيء أو شخص بشكل مباشر بواسطة جزء من الجسم مثل اليد، التواصل الحسي أو المعنوي مع شيء ما؛ يدل على التواصل، سواء كان ماديًا أو معنويًا، مع شيء ما)\nمثال: إياك ولمس شطيرتي! / اِسْتَقْبَلَ, اِسْتَلَمَ (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه) / اِسْتَقْبَلَ, يَسْتَقْبِل (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه)\nمثال: استقبل توم الضيوف. / صَادَفَ, لَاقَى (لَقِيَ، وَافَقَ، وَجَدَ؛ وَاجَهَ، لَاقَى، وَجَدَ) / مُلَاقَاة, مُقَابَلَة (لِقَاء)\nمثال: صادف مشكلا صعبا.",
 "接中語": "حشو, داخلة (زائدة يتم إدخالها داخل الكلمة)",
 "接中辞": "حشو, داخلة (زائدة يتم إدخالها داخل الكلمة)",
 "接写": "لقطة مقربة (صورة فوتوغرافية (أو غيرها) يظهر فيها الموضوع بمقياس كبير نسبياً، ويشغل معظم أو كل الإطار)",
 "接写リング": "لقطة مقربة (صورة فوتوغرافية (أو غيرها) يظهر فيها الموضوع بمقياس كبير نسبياً، ويشغل معظم أو كل الإطار)",
