 "毒害": "سُمّ, سَمّ (في : حرف جواب بمعنى مُرْ يأتي بعد النداء فقط) / سَمَّمَ, سَمَّ\nمثال: تناول سامي السم.",
 "毒性": "خُبْث, سُمِّيَّة (ضرر جسيم أو فتك) / سُمِّيَّة (الدرجة التي يكون بها شيء ما ساماً) / سَامّ",
 "毒性学": "عِلْم السُّمُوم (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "毒殺": "تَسْمِيم / تَسَمُّم",
 "毒毒しい": "سَامّ / بغيض, كريه (يثير أو يستحق الكراهية) / حَقُود, خَبِيث (يتسم بالحقد والخبث)\nمثال: لا توجد رذيلة بغيضة عالمياً مثل الجحود / صَارِخ, مُبَهْرَج (ذو ألوان صارخة وبرّاقة تجذب الانتباه بشكل مفرط) / صَارِخ, مُبَهْرَج (بَرَّاقٌ وَلَافِتٌ بِطَرِيقَةٍ تَفْتَقِرُ إِلَى الذَّوْق) / وليمة احتفالية ((في بريطانيا) وليمة احتفالية أو ترفيهية تقام في الكلية)",
 "毒気": "خُبْث, سُمِّيَّة (ضرر جسيم أو فتك) / سُمِّيَّة (الدرجة التي يكون بها شيء ما ساماً) / حِقْد (حقد:أَمْسَكَ عَداوتَهُ فِي قَلْبهِ وتَرَبَّصَ لفُرْصَتِها؛ حقد على فلان:أَضْمَرَ له العداوة وتربّص فرصة الإيقاع به ، كَرِهَه وبَغِضَه)\nمثال: احس سامي بالحقد.",
 "毒消し": "تِرْيَاق (دواء مركب يدفع السموم؛ ما يضاد عمل السمّ)",
 "毒液": "سُمّ (في : حرف جواب بمعنى مُرْ يأتي بعد النداء فقط)\nمثال: تناول سامي السم.",
 "毒牙": "إمساك, قبضة (فعل الإمساك)\nمثال: أرخى قبضته عن ذراعي",
 "毒牙にかかる": "وَقَعَ ضَحِيَّة, سَقَطَ ضَحِيَّة (الشيء: سَقَطَ، انحدر من مكان عال؛ الأمر: حَدَثَ، وأكثر ما يقال للأمر العظيم)\nمثال: توم وقع و أصيب.",
 "毒物": "سم, مادة سامة (أي مادة تسبب إصابة أو مرض أو موت كائن حي)",
 "毒物学": "عِلْم السُّمُوم (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "毒男": "خَاسِر / فَاشِل",
 "毒科学": "عِلْم السُّمُوم (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "毒突く": "لَعْنَة (أي رغبة صريحة في أن تصيب المحن أو أي شكل من أشكال سوء الحظ كيانًا ما، سواء كان شخصًا، أو مكانًا، أو كائنًا) / نِقْمَة / لَعَنَ ((في الدين) طَرَدَهُ اللَّٰهُ مِنْ رَحْمَتِهِ؛ سَبَّ، شَتَمَ) / شَتَمَ, سَبَّ\nمثال: اللعنة حولها ومعرفة",
 "毒素": "توكسين, ذيفان (مادة سامة تنتج أثناء التمثيل الغذائي ونمو كائنات دقيقة معينة وبعض الأنواع النباتية والحيوانية)",
 "毒舌": "لسان حاد, لسان سليط (طريقة مريرة أو نقدية في التحدث)",
 "毒茸": "فطر سام (اسم شائع للغاريقون غير الصالح للأكل أو السام (على عكس الفطر الصالح للأكل))",
 "毒草": "نبات سام (نبات يمكن أن يكون ضاراً أو مميتاً للكائن الحي عند لمسه أو تناوله بكمية كافية)",
 "毒薬": "سُمّ, سَمّ (في : حرف جواب بمعنى مُرْ يأتي بعد النداء فقط) / سَمَّمَ, سَمَّ\nمثال: تناول سامي السم.",
 "毒薬条項": "حبة سامة (استراتيجية دفاعية تجعل أسهم الشركة المستهدفة أقل جاذبية للمستحوذ)",
 "毒蜘蛛": "عَنْكَبُوت ذِئْبِيّ",
 "毒血症": "انسمام الدم, تسمم الدم (تسمم الدم الناتج عن المواد السامة البكتيرية في الدم) / تسمم الحمل (حالة غير طبيعية أثناء الحمل تتميز بارتفاع ضغط الدم والوذمة والبروتين في البول)",
 "毒質": "خُبْث, سُمِّيَّة (ضرر جسيم أو فتك) / سُمِّيَّة (الدرجة التي يكون بها شيء ما ساماً)",
 "毒針": "لَسَعَ",
 "毒魳": "باراكودا كبيرة (باراكودا رمادية بنية كبيرة (تصل إلى 6 أقدام) تحظى بتقدير كبير كسمكة غذائية ورياضية؛ قد تكون خطرة على السباحين)",
 "毒鶴茸": "أمانيت فالوسي, قبعة الموت (فطر سام للغاية عادة ما يكون أبيض اللون بقاعدة بارزة تشبه الكأس؛ يختلف عن الغاريقون الصالح للأكل فقط في خياشيمه البيضاء) / أمانيت ربيعي, الملاك المدمر (فطر مشابه للأمانيت الفالوسي)",
 "毒麦": "زوان سام, شيلم (عشبة سنوية ضارة توجد غالباً في حقول الحبوب والأراضي المزروعة الأخرى؛ تعتبر البذور سامة أحياناً)",
 "比": "نِسْبَة (مصدر للفعل \"نَسَبَ\"؛ (في النحو) صفة أُضيفت إليها يَاءُ النَّسَبِ، غرضها نسب المنسوب إلى المنسوب إليه)\nمثال: بالنسبة لي، إنه مهم. / مُبَارَاة / شَحّاطَة, شَخَّاطَة / الْفِلِبِّين (دولة في جنوب شرق آسيا؛ اسمها الرسمي جمهورية الفلبين، وعاصمتها مانيلا؛ جزر الفلبين، أرخبيل في جنوب شرق قارة آسيا يمثل أساس جمهورية الفلبين)\nمثال: الفلبين بلد كاثوليكي أساسا. / وَقْت (\"بَقِيَ وَقْتاً عِنْدَهُ \" : أَيْ مِقْدَاراً مِنَ الزَّمَنِ؛ \"جَاءَ فِي الوَقْتِ الْمُنَاسِبِ \" : فِي اللَّحْظَةِ الْمُنَاسِبَةِ) / مَرَّة, مرة (مؤنث مُرّ، صفة ما كان بها مرارة) / حِين, وَقْت ((حَيَّنَه): جعل لَهُ حينا؛ (حَيَّنَ) الله فلَانا: لم يوفقه للرشاد)\nمثال: حان وقت الذهاب. / فصل, موسم (إحدى الفترات الطبيعية التي تنقسم إليها السنة)\nمثال: التتابع المنتظم للفصول",
 "比々": "كُلّ, جَمِيع",
 "比える": "قَارَنَ / شَبَّهَ",
 "比おい": "وَقْت (\"بَقِيَ وَقْتاً عِنْدَهُ \" : أَيْ مِقْدَاراً مِنَ الزَّمَنِ؛ \"جَاءَ فِي الوَقْتِ الْمُنَاسِبِ \" : فِي اللَّحْظَةِ الْمُنَاسِبَةِ) / مَرَّة, مرة (مؤنث مُرّ، صفة ما كان بها مرارة) / حِين, وَقْت ((حَيَّنَه): جعل لَهُ حينا؛ (حَيَّنَ) الله فلَانا: لم يوفقه للرشاد)\nمثال: حان وقت الذهاب.",
 "比する": "قَارَنَ / شَبَّهَ",
 "比べ": "مُسَابَقَة",
 "比べもの": "مُقَارَنَة / مُقَابَلَة / تَشْبِيه / مُقَايَسَة",
 "比べる": "قَارَنَ / شَبَّهَ / تَنَافَسَ, تَبَارَى",
 "比べ物": "مُقَارَنَة / مُقَابَلَة / تَشْبِيه / مُقَايَسَة",
 "比を見ない": "فَرِيد, فَذّ",
 "比例": "تَنَاسُب, تَوَازُن (ترتيب أو علاقة متناغمة للأجزاء أو العناصر داخل كلٍّ (كما في التصميم)) / أبعاد, بُعْد (المقدار أو المدى) / تَنَاسُب, نِسْبَة (العلاقة بين الأشياء (أو أجزاء الأشياء) فيما يتعلق بكميتها المقارنة أو مقدارها أو درجتها) / تَنَاسُب, نِسْبَة (خارج القسمة الناتج عن قسمة مقدار جزء على مقدار الكل)\nمثال: في جميع الأشياء الجميلة تماماً يوجد تقابل بين جزء وآخر وتوازن متبادل",
 "比例に応じて": "تَنَاسُبِيّ, نِسْبِيّ (مرتبط بشكل صحيح في الحجم أو الدرجة؛ عادة متبوع بـ «إلى») / ذُو نِسْبَة ثَابِتَة, طَرْدِيّ (ذو نسبة ثابتة) / حد التناسب, متناسب (إحدى الكميات في تناسب رياضي)",
 "比例代表": "تَمْثِيل نِسْبِيّ (تمثيل جميع الأحزاب بما يتناسب مع تصويتهم الشعبي)",
 "比例代表制": "تَمْثِيل نِسْبِيّ (تمثيل جميع الأحزاب بما يتناسب مع تصويتهم الشعبي)",
 "比例定数": "ثَابِت التَّنَاسُب, عَامِل التَّنَاسُب (القيمة الثابتة لنسبة كميتين متناسبتين س وص؛ تكتب عادة ص = ك*س، حيث ك هو عامل التناسب)",
 "比例性": "تَنَاسُب, تَوَازُن (ترتيب أو علاقة متناغمة للأجزاء أو العناصر داخل كلٍّ (كما في التصميم)) / تَنَاسُبِيَّة (نسبة كميتين تكون ثابتة)\nمثال: في جميع الأشياء الجميلة تماماً يوجد تقابل بين جزء وآخر وتوازن متبادل",
 "比例税": "ضريبة تناسبية (أي ضريبة يكون معدلها ثابتاً مع زيادة المبلغ الخاضع للضريبة)",
 "比価": "تَكَافُؤ, تَمَاثُل (مساواة وظيفية) / تكافؤ, حفظ التكافؤ ((فيزياء) التكافؤ محفوظ في كون تكون فيه قوانين الفيزياء هي نفسها في نظام إحداثيات يمني كما في نظام يساري) / بت التدقيق, بت التكافؤ ((علم الحاسوب) بت يُستخدم في إجراء كشف الأخطاء حيث يُضاف 0 أو 1 إلى كل مجموعة من البتات ليكون مجموع الآحاد فرديًا أو زوجيًا) / تَمَاثُل, زَوْجِيَّة ((الرياضيات) علاقة بين زوج من الأعداد الصحيحة: إذا كان كلاهما فردياً أو كلاهما زوجياً فلهما نفس الزوجية)",
 "比倫": "تِرْب, قَرِين (أصبح في حالة تربٍ، أي وضع في التراب أو اشتمل عليه؛ في : يُقال \"تَرَبَ\" على سبيل الاستعارة للمجيء بالراحة أو الهدوء بعد تعب)",
 "比喩": "تَشْبِيه",
 "比喩的": "اِسْتِعَارِيّ, مَجَازِيّ",
 "比売神": "إِلَاهَة, إِلٰهَة / مَعْبُودَة",
 "比定": "فَرْضِيَّة (مؤنث الفَرَضِيّ، وهو المنسوب إلى الفَرَض؛ الفَرَض، ما يُفْتَرَض من الأمور، خلاف الحَقِيقَة. كلمة حديثة)\nمثال: الحقائق تؤكد هذه الفرضية.",
 "比島": "الْفِلِبِّين (دولة في جنوب شرق آسيا؛ اسمها الرسمي جمهورية الفلبين، وعاصمتها مانيلا؛ جزر الفلبين، أرخبيل في جنوب شرق قارة آسيا يمثل أساس جمهورية الفلبين)\nمثال: الفلبين بلد كاثوليكي أساسا.",
 "比抵抗": "مقاومة, مقاومة كهربائية (ممانعة المادة لتدفق التيار الكهربائي؛ تقاس بالأوم)",
 "比比": "كُلّ, جَمِيع",
 "比況": "مُقَارَنَة / مُقَابَلَة / تَشْبِيه / مُقَايَسَة",
 "比熱": "حرارة نوعية (الحرارة اللازمة لرفع درجة حرارة جرام واحد من مادة ما درجة مئوية واحدة)",
 "比率": "نِسْبَة (مصدر للفعل \"نَسَبَ\"؛ (في النحو) صفة أُضيفت إليها يَاءُ النَّسَبِ، غرضها نسب المنسوب إلى المنسوب إليه)\nمثال: بالنسبة لي، إنه مهم.",
 "比興": "مُشَوِّق, ممتع / غَيْرُ مَعْقُول, مُفْرِط (يَتَجَاوَزُ الحُدُودَ الطَّبِيعِيَّة) / غير معقول, غير منطقي (غير معقول؛ لا يظهر حكماً صائباً) / مُتَوَاضِع الأَصْل, وَضِيع (من أصل متواضع أو مكانة دنيا) / ثَانَوِيّ, وَضِيع الرُّتْبَة (أدنى في الرتبة أو المكانة) / مُتَوَاضِع, وَضِيع (يُوصَف به العمل غير الماهر خاصّة الأعمال المنزلية) / مُتَوَاضِع, وَضِيع (منخفض أو متدنٍّ في المكانة أو الجودة) / جَبَان (شديد الخوف ممتنع عن الإقدام؛ ضد الشجاع)\nمثال: إيدير مجرد جبان.",
 "比色分析": "تحليل لوني, قياس اللون (التحليل الكيميائي الكمي عن طريق اللون باستخدام مقياس اللون)",
 "比色定量": "تحليل لوني, قياس اللون (التحليل الكيميائي الكمي عن طريق اللون باستخدام مقياس اللون)",
 "比色計": "مقياس الألوان (أداة قياس تستخدم في التحليل اللوني لتحديد كمية مادة ما من اللون الذي تنتجه مع كواشف محددة)",
 "比較": "مُقَارَنَة / مُقَابَلَة / تَشْبِيه / مُقَايَسَة",
 "比較にならない": "غير قابل للمقارنة, لا يضاهى (بحيث تكون المقارنة مستحيلة؛ غير مناسب للمقارنة أو يفتقر للميزات التي يمكن مقارنتها)\nمثال: أسبوع لا يضاهى من الراحة والمتعة",
 "比較可能": "قابل للمقارنة, مماثل (يمكن مقارنته أو يستحق المقارنة) / مُطَابِق, مُمَاثِل (مُتَوافِق من كلّ وجه)",
 "比較文化": "عبر الثقافات (يتعامل مع ثقافتين أو أكثر أو يقارن بينهما)\nمثال: مسح عبر الثقافات",
 "比較文学": "أدب مقارن (دراسة الأعمال الأدبية من ثقافات مختلفة (غالباً مترجمة))",
 "比較演算子": "عَلَاقَة",
 "比較的": "نِسْبِيّاً",
 "比較級": "دَرَجَة نِسْبِيَّة",
 "比較行動学": "علم سلوك الحيوان (فرع علم الحيوان الذي يدرس سلوك الحيوانات في بيئاتها الطبيعية)",
 "比較解剖学": "تشريح مقارن (دراسة السمات التشريحية للحيوانات من أنواع مختلفة)",
 "比重": "ثقل نوعي (كثافة مادة بالنسبة لكثافة الماء) / وَزْن / ثِقْل (ثَقَلَ الشيءَ يَثْقُلُه بِيَدِهِ ثَقْلًا: رَازَ ثِقَلَه؛ ثَقَلَ الشَّيْء بِيَدِهِ ثقلا قدّر ثِقْلَه)\nمثال: ان ثقل ما تحمل، فضع بعضا منه.",
 "比重計": "مقياس الكثافة (أداة قياس لتحديد الكثافة أو الثقل النوعي)",
 "比量": "مُقَارَنَة / مُقَابَلَة / تَشْبِيه / مُقَايَسَة / إِبِسْتِمُولُوجِيَّا, نَظَرِيَّةْ اَلمَعْرِفَة",
 "比量的": "عاطفي, معبر عن المشاعر (يميل إلى أو يتميز بالتعبير الصريح عن العاطفة) / إِيضَاحِيّ, بَيَانِيّ (يخدم غرض العرض والتوضيح) / اسم إشارة, ضمير إشارة (ضمير يشير إلى مرجع مقصود)\nمثال: عائلة حنونة ومعبرة عن مشاعرها",
 "比隣": "بالقرب, في مكان قريب (ليس بعيداً بالمصطلحات النسبية) / قَرِيب, مُجَاوِر (على مقربة؛ في متناول اليد)\nمثال: هي تعمل في مكان قريب",
 "比類": "مُوَازٍ / مُتَوَازٍ",
 "比類ない": "لَا مَثِيلَ لَهُ, لَا نَظِيرَ لَهُ (بارز يفوق أيّ مقارنة؛ فريد لا يُضاهى)",
 "比類のない": "فَرِيدٌ مِنْ نَوْعِه, لَا يُضَاهَى (مُتميّز جذريًّا وليس له مثيل أو نظير)",
 "比類の無い": "فَرِيدٌ مِنْ نَوْعِه, لَا يُضَاهَى (مُتميّز جذريًّا وليس له مثيل أو نظير)",
 "比類無い": "لَا مَثِيلَ لَهُ, لَا نَظِيرَ لَهُ (بارز يفوق أيّ مقارنة؛ فريد لا يُضاهى)",
 "毛": "شَعْرَة / شَعْر, شَعْرَة (العِلْم؛ في : هو كلام مُقَفَّى ومُوَازَن على أوزان معروفة يُقصد به إظهار الكلام بصيغة فنية)\nمثال: شعر ماريا طويل. / فَرْو / مِعْطَف, ثَوْبٌ مُفَرًّى / فَرَّى / تَحْتَ, تَحْت (أَقَلَّ) / حَتَى, إِلَى (يفيد انتهاء الغاية؛ يفيد الغاية) / سقط (تَحَرَّكَ من أعلى إلى أسفل بتأثير الجاذبية، وَقَعَ؛ في كلامه: أخْطَأَ، أو قال قولا لا ينبغي أو لا يريد قوله) / زَغَب\nمثال: أنا تحت الشجرة. / جُزْء مِن أَلْف, وَاحِد بِالأَلْف (جزء واحد من ألف جزء متساوي)",
