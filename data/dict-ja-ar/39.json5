 "拮抗": "تَنَافُس, مُنَافَسَة (فعل التنافس من أجل الربح أو الجائزة)\nمثال: كانت الفرق في تنافس شرس على المركز الأول",
 "拮抗作用": "تضاد حيوي ((كيمياء حيوية) تداخل في أو تثبيط العمل الفسيولوجي لمادة كيميائية بواسطة أخرى لها بنية مماثلة) / تضاد, عداء (شعور معبر عنه بوضوح بالكراهية والعداء) / تَضَادّ, تَنَافُر (العلاقة بين مبادئ أو قوى أو عوامل متعارضة) / بغضاء, خصومة (حالة من الضغينة العميقة)\nمثال: التنافر المتأصل بين الرأسمالية والاشتراكية",
 "拮抗筋": "خَصْم, عَدُوّ (الخَصْمُ :مُجَادِل، مُنَازِع، مُخَاصِم، عكسه حَلِيف أو صَدِيْق، وقد يستوي فيه المفرد والمثنى والجمع؛ والخَصْمُ (في ) : حَطِيطَة) / غَرِيم, خَصْم",
 "拮抗薬": "خَصْم, عَدُوّ (الخَصْمُ :مُجَادِل، مُنَازِع، مُخَاصِم، عكسه حَلِيف أو صَدِيْق، وقد يستوي فيه المفرد والمثنى والجمع؛ والخَصْمُ (في ) : حَطِيطَة) / غَرِيم, خَصْم",
 "拮据": "اِجْتِهَاد",
 "拱門": "قنطرة, قوس (ممر يقع تحت بناء حجري مقوس)\nمثال: بنوا قوس نصر لتخليد ذكرى انتصارهم",
 "拳": "قَبْضَة",
 "拳々": "بِاحْتِرَام (بطريقة محترمة)\nمثال: هل لي أن أقترح باحترام على مجلس المدينة أن يتبنوا سياسة عدم النشاط المتقن؟",
 "拳固": "قَبْضَة",
 "拳拳": "بِاحْتِرَام (بطريقة محترمة)\nمثال: هل لي أن أقترح باحترام على مجلس المدينة أن يتبنوا سياسة عدم النشاط المتقن؟",
 "拳法": "كُونْج فُو",
 "拳銃": "مُسَدَّس (اسم مفعول من سَدَّسَ؛ في : شَكْل هندسي مُسَطَّح له سِتَّة أضلاع متساوية فإن لم تكن متساوية سميّ بالسُدَاسِيّ) / فَرْد / طَبَنْجَة / غَدَّارَة\nمثال: كان عند زيري مسدس.",
 "拳闘": "مُلَاكَمَة",
 "拳闘家": "مُلَاكِم",
 "拳闘家痴呆": "مُتَرَنِّح, مُخْتَلّ التَّوَازُن (مُشوَّش كأنّه تلقّى ضربات متكرّرة)",
 "拳闘術": "مُلَاكَمَة",
 "拳闘選手": "مُلَاكِم",
 "拳骨": "قَبْضَة",
 "拵え": "فَعَلَ, صَنَعَ (عَمِلَ وصَنَعَ، بعلم أو بدون علم، عن قصد أو دون قصد) / جَعَلَ (صَيَّرَ؛ أَنْشَأَ)\nمثال: ماذا فعل للحمي؟",
 "拵える": "فَعَلَ, صَنَعَ (عَمِلَ وصَنَعَ، بعلم أو بدون علم، عن قصد أو دون قصد) / جَعَلَ (صَيَّرَ؛ أَنْشَأَ)\nمثال: ماذا فعل للحمي؟ / بَنَى (أَقَامَ شيئا مثل الجدران و السفن باستخدام مواد مثل الخشب والطَّابُوق والحَجَر والآجَر والخَرَسَانَة وغيرها؛ جعل الشيء يحدث خطوة بعد خطوة كأنه بناء وإن لم يكن شيئا ملموسا)\nمثال: بنى سامي منزلا. / جَهَّزَ, حَضَّرَ (جَهاز العَرُوس وَالْمَيِّتِ وجِهازهما: مَا يَحْتَاجَانِ إِليه؛ جَهَّزَه فَتَجَهَّز وجَهَّزْتُ العروسَ تَجْهِيزاً، وَكَذَلِكَ جَهَّزت الْجَيْشَ) / اِسْتَعَدَّ, تَأَهَّبَ (اِسْتَعَدَّ للامْتِحانِ بِجِدٍّ: حَضَّرَ لَه؛ يَسْتَعِدُّ لِلْمُبَارَاةِ: يَتَهَيَّأُ لَهَا)\nمثال: جهز زيري حقائبه. / لَبِسَ (خَلَطَ بحيث يصعب التمييز والفصل؛ الأمر: خلطه فاشتبه واضطرب) / ثَوْب, لِبَاس (ما يُلْبَسُ من اللِبَاس، أي جزء ويطلق للرجال والنساء؛ الجزء الرئيس من الملابس، غالبا ما يكون طويلا وواسعا وذو أكمام، تحته الملابس الداخلية وفوقه الخارجية. يستخدم للرجال والنساء) / كَسْوَة, مَلْبَس\nمثال: لبس سروالا نظيفا.",
 "拵え事": "فَبْرَكَة",
 "拵え物": "مُزَيَّف",
 "拷問": "تَعْذِيب / عَذَاب / عَذَّبَ",
 "拷問具": "أداة تعذيب (أداة عقاب مصممة ومستخدمة لإلحاق التعذيب بالشخص المحكوم عليه)",
 "拷問台": "مَكْتَبَة شَخْصِيَّة",
 "拷問禁止条約": "الْأُمَم الْمُتَّحِدَة",
 "拷問等禁止条約": "الْأُمَم الْمُتَّحِدَة",
 "拷訊": "تَعْذِيب / عَذَاب / عَذَّبَ",
 "拷責": "تَعْذِيب / عَذَاب / عَذَّبَ",
 "拼音": "بِينْيِن",
 "拾": "عَشَرَة, عَشْرَة",
 "拾い": "جمع, حصد (فعل جمع شيء ما) / اِحْتِشَاد, تَجَمُّع (الفعل الاجتماعي المتمثل في التجمع) / زم, كشكشة (خياطة تتكون من طيات صغيرة أو تجاعيد مصنوعة بسحب خيط بإحكام في خط خياطة) / تجمع, تجمهر (مجموعة من الأشخاص مجتمعين معاً في مكان واحد)\nمثال: طالبوا بالحق في التجمع / مُتَجَسِّد / مَشْي (السَيْر على رجلين؛ السير عامّة)\nمثال: مشي توم مع ماري.",
 "拾いあげる": "قَطَفَ (قطفت الدّابّة قِطَافاً: أَبْطَأَتْ، في أمثالهم: (أَقْطَفُ من أرنب)؛ قَطَفَ الزّهرةَ: قطعها، قَطَفَ الثّمرَ: جناه وجمعه)\nمثال: أحب قطف الورود. / أَشَارَ",
 "拾い上げる": "قَطَفَ (قطفت الدّابّة قِطَافاً: أَبْطَأَتْ، في أمثالهم: (أَقْطَفُ من أرنب)؛ قَطَفَ الزّهرةَ: قطعها، قَطَفَ الثّمرَ: جناه وجمعه)\nمثال: أحب قطف الورود. / أَشَارَ",
 "拾い主": "محدد منظر (جهاز بصري يساعد المستخدم في العثور على الهدف المطلوب) / راصد, مكتشف (شخص يكون أول من يلاحظ شيئاً) / مكتشف, واجد (شخص يعثر على شيء بعد البحث)",
 "拾い出す": "اِخْتَارَ",
 "拾い子": "لَقِيط, مَلْقُوط",
 "拾い歩き": "تَجَوَّلَ",
 "拾い物": "وَجَدَ, لَقِيَ (أَدْرَكَ المطلوب، أَدْرَكَ الشيء الذي أَرَادَهُ وبَحَثَ عنه؛ غَضِبَ عليه. (يتعدى بعلى)) / لَقِيَّة\nمثال: وجد ياني هاتفه.",
 "拾い読み": "رعي, قضم الأوراق (فعل التغذية عن طريق القضم المستمر) / تصفح (القراءة بشكل سطحي أو عشوائي)",
 "拾い集める": "جَمَعَ (ضَمَّ، لَمَّ، حَشَدَ؛ في : أَضَافَ أعدادا إلى غيرها)\nمثال: جمع خيل هو خيول.",
 "拾う": "قَطَفَ (قطفت الدّابّة قِطَافاً: أَبْطَأَتْ، في أمثالهم: (أَقْطَفُ من أرنب)؛ قَطَفَ الزّهرةَ: قطعها، قَطَفَ الثّمرَ: جناه وجمعه)\nمثال: أحب قطف الورود. / وَجَدَ, لَقِيَ (أَدْرَكَ المطلوب، أَدْرَكَ الشيء الذي أَرَادَهُ وبَحَثَ عنه؛ غَضِبَ عليه. (يتعدى بعلى)) / لَقِيَّة\nمثال: وجد ياني هاتفه. / اِخْتَارَ / اِسْتَقْبَلَ (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه) / أَصْبَحَ (دَخَلَ فِي الصَّبَاح؛ صَارَ)\nمثال: استقبل توم الضيوف.",
 "拾万": "مِائَة أَلْف",
 "拾得": "استخلاص, تحديد (فعل تحديد خصائص شيء ما، عادة عن طريق البحث أو الحساب) / استنتاج, نتيجة (قرار المحكمة بشأن قضايا الواقع أو القانون) / لُقطة, مُكتشف (شيء تم العثور عليه)\nمثال: تحديد الهياكل الجزيئية",
 "拾得者": "محدد منظر (جهاز بصري يساعد المستخدم في العثور على الهدف المطلوب) / راصد, مكتشف (شخص يكون أول من يلاحظ شيئاً) / مكتشف, واجد (شخص يعثر على شيء بعد البحث)",
 "拾萬": "مِائَة أَلْف",
 "拿捕": "أَسْر (الأَسْر : شدة الخَلْق؛ الأَسْر : القيدُ) / أَسَرَ (الأَسْر : شدة الخَلْق؛ الأَسْر : القيدُ)\nمثال: إن توم لا يملك أسرة.",
 "持": "دَلَجَ, غَرَفَ / رَسَمَ (سَم الشَّيءَ :خطّه رسَم مُربَّعًا/ صورةً/ شكلاً؛ رسَم : كَتَبَ) / قُرْعَة\nمثال: واصل زيري الرسم.",
 "持する": "مَسَكَ, مسك",
 "持たざる": "فَقِير, مُعْدَم (شخص لديه القليل من الممتلكات أو لا يملك شيئاً)",
 "持たざる者": "فَقِير, مُعْدَم (شخص لديه القليل من الممتلكات أو لا يملك شيئاً)",
 "持たせる": "أَعْطَى, وَهَبَ (مَنَحَ، نَوَّلَ)\nمثال: أعطى بلده حياته. / اِحْتَفَظَ, أَبْقَى",
 "持ち": "مَلَكَ, اِمْتَلَكَ (لغة في المَالِك، وهو الذي يَمْلِكُ؛ السُلْطَان الحَاكِم الذي يملك الأَرْض والبِلاد) / تَنَاوَلَ (فعل مطاوعة من نَاوَلَ، ناولته فتناول؛ أخذ الشيء الذي ناولته إياه؛ الطعام والدواء: أكَلَه)\nمثال: زيري ملك لنفسه. / لَبِسَ (خَلَطَ بحيث يصعب التمييز والفصل؛ الأمر: خلطه فاشتبه واضطرب) / اِرْتَدَى / اِهْتِراء\nمثال: لبس سروالا نظيفا. / كَتِف, كِتْف / دَلَجَ, غَرَفَ / رَسَمَ (سَم الشَّيءَ :خطّه رسَم مُربَّعًا/ صورةً/ شكلاً؛ رسَم : كَتَبَ) / قُرْعَة\nمثال: واصل زيري الرسم.",
 "持ちあわせる": "حَمَلَ (رَفَعَ، أَقَلَّ)\nمثال: حمل سامي سلاحه.",
 "持ちかえる": "تَبْدِيل, تَبَادُل / بُورْصَة, تَدَاوُل / تَبَادَلَ, صَرَفَ",
 "持ちかける": "اِقْتِرَاح / اِقْتَرَحَ, قَدَّمَ (اِبْتَدَعَ ٱلشَّيْءَ مِنْ ذَاتِ نَفْسِهِ مِنْ غَيْرِ أَنْ يَسْمَعَهُ؛ اِخْتَارَ) / قَدَّمَ (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى الرُّسْغَ؛ أنّ لهم سابقةً وفضلاً له عند فلان قَدَمٌ : معروف)\nمثال: اقترح سامي المساعدة.",
 "持ちがいい": "دَائِم طَوِيْلًا",
 "持ちがよい": "دَائِم طَوِيْلًا",
 "持ちが良い": "دَائِم طَوِيْلًا",
 "持ちきり": "حديث, حديث المدينة (ثرثرة فارغة أو شائعة)\nمثال: كان هناك حديث عنك مؤخراً",
 "持ちこたえる": "قَاوَمَ (ظَلَّ يقوم ضد الشيء، استمر في القيام)\nمثال: قاوم حتى النهاية!",
 "持ちこむ": "أَحْضَرَ, جَاءَ بِـ (أَتَى بالشيء، جَاءَ به)\nمثال: أحضر سامي كلبه.",
 "持ちのいい": "دَائِم طَوِيْلًا",
 "持ちのよい": "دَائِم طَوِيْلًا",
 "持ちの良い": "دَائِم طَوِيْلًا",
 "持ち上がる": "نَهَضَ, اِرْتَفْعَ (قَامَ) / أَشْرَقَ, شَرَقَ ((أَشْرَقَتِ) الشمسُ: طلعت وأضاءَت على الأرضِ؛ يقال: أَشرقتِ الأَرضِ: أنارت بإشراقِ الشمس)\nمثال: نهض توم على قدميه. / حَدَثَ, وَقَعَ (وَقَعَ الأمر؛ نقيض قَدُمَ، كان حَدِيثا)\nمثال: لا أصدق ما حدث.",
 "持ち上げる": "رفع (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ)\nمثال: رفع سامي نظارته. / تَمَلَّقَ, تَبَصْبَصَ",
 "持ち主": "مَالِك, مَالِكَة (اسم شخصي معطًى للذكور من العرب)\nمثال: من مالك هذا البيت؟",
 "持ち出し": "أداء, تنفيذ (فعل الأداء؛ القيام بشيء بنجاح؛ استخدام المعرفة بدلاً من مجرد امتلاكها) / تطبيق, تنفيذ (عملية إنجاز هدف ما أو تنفيذ أمر ما)\nمثال: انتقدوا أداءه كرئيس للبلدية / طنف, كابول ((في العمارة) دعامة مثلثة من الطوب أو الحجر (عادة ما تكون ذات امتداد بسيط))",
 "持ち出す": "أَخْرَجَ / رَفَعَ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ)\nمثال: رفع سامي نظارته.",
 "持ち分": "نَصِيب, حِصَّة / سَهْم (سَهَمَ؛ سَهَّمَ) / شَارَكَ\nمثال: لم يصب السهم توم.",
 "持ち切り": "حديث, حديث المدينة (ثرثرة فارغة أو شائعة)\nمثال: كان هناك حديث عنك مؤخراً",
 "持ち前": "طَبِيعِيّ",
 "持ち去る": "أَخَذَ (تَنَاوَلَ الشيء بيده، تملكه أو تحكم فيه، بالقوة أو بدونها؛ أمْسَكَ بِالشيء. (يتعدى بالباء)) / أَخَذَ بِـ (تَنَاوَلَ الشيء بيده، تملكه أو تحكم فيه، بالقوة أو بدونها؛ أمْسَكَ بِالشيء. (يتعدى بالباء)) / اِتَّخَذَ / اِسْتَغْرَقَ / اِلْتَقَطَ",
 "持ち合い": "وَحْدَة, اِتِّحَاد / انْتِظَام, ثَبَات (صفة كون الشيء ثابتاً - منتظماً وغير متغير) / ثَبَات, رُسُوخ (صفة كون الشيء ثابتاً أو مثبتاً بأمان ولا يتحرك في مكانه) / ثبات, رسوخ (الخلو من التردد؛ ثبات العزم أو السلوك)\nمثال: وثق بثباتها الواضح في أنها ستفعل ما قالت",
 "持ち合う": "رَصِيد / نَصِيب, حِصَّة / سَهْم (سَهَمَ؛ سَهَّمَ) / شَارَكَ\nمثال: لم يصب السهم توم.",
 "持ち合せる": "حَمَلَ (رَفَعَ، أَقَلَّ)\nمثال: حمل سامي سلاحه.",
 "持ち合わす": "حَمَلَ (رَفَعَ، أَقَلَّ)\nمثال: حمل سامي سلاحه.",
 "持ち合わせる": "حَمَلَ (رَفَعَ، أَقَلَّ)\nمثال: حمل سامي سلاحه.",
 "持ち回り": "دَوْرَة (في غرب العراق على نهر الفرات قرب الحدود السورية؛ حَيّ في جنوب بغداد تقع فيه محطة تكرير للنفط تسمّى بإسمه)\nمثال: خضع زيد لدورة مكثفة",
 "持ち堪える": "قَاوَمَ (ظَلَّ يقوم ضد الشيء، استمر في القيام)\nمثال: قاوم حتى النهاية!",
 "持ち変える": "تَبْدِيل, تَبَادُل / بُورْصَة, تَدَاوُل / تَبَادَلَ, صَرَفَ",
 "持ち寄り": "عشاء مشترك, وليمة مساهمة (ما يتوفر من طعام خاصة عند تقديمه لضيف غير متوقع أو عندما يحضره الضيوف ويتشاركون فيه جميعاً)\nمثال: عشاء مساهمة (كل ضيف يحضر طبقاً)",
 "持ち寄る": "جَمَعَ (ضَمَّ، لَمَّ، حَشَدَ؛ في : أَضَافَ أعدادا إلى غيرها)\nمثال: جمع خيل هو خيول.",
 "持ち帰り": "سَفَريّ",
 "持ち帰る": "أَخْرَجَ",
 "持ち手": "مِقْبَض / حامل (جهاز حمل) / حامل (الشخص الذي بحوزته شيك أو كمبيالة أو سند أو وثيقة ملكية مظهرة له أو لمن يحملها) / حائز, حامل (شخص يحمل أو يحوز شيئاً ما)\nمثال: حامل مناشف",
 "持ち扱う": "مِقْبَض",
 "持ち掛ける": "اِقْتِرَاح / اِقْتَرَحَ, قَدَّمَ (اِبْتَدَعَ ٱلشَّيْءَ مِنْ ذَاتِ نَفْسِهِ مِنْ غَيْرِ أَنْ يَسْمَعَهُ؛ اِخْتَارَ) / قَدَّمَ (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى الرُّسْغَ؛ أنّ لهم سابقةً وفضلاً له عند فلان قَدَمٌ : معروف)\nمثال: اقترح سامي المساعدة.",
