 "拭きおとす": "مَسَحَ (مَرَّ عليه بكفه وهو يلامسه؛ مَحَا، مرَّ عليه بكفه حتى يُزيله) / مَحَى, عَفَا\nمثال: مسح توم الطاولة.",
 "拭き取る": "مَسَحَ (مَرَّ عليه بكفه وهو يلامسه؛ مَحَا، مرَّ عليه بكفه حتى يُزيله) / مَحَى, عَفَا\nمثال: مسح توم الطاولة.",
 "拭き拭き": "مَسَحَ (مَرَّ عليه بكفه وهو يلامسه؛ مَحَا، مرَّ عليه بكفه حتى يُزيله)\nمثال: مسح توم الطاولة.",
 "拭き掃除": "تَنْظِيف",
 "拭き消す": "مَحَا, مَحَى / اِمَّحَى, اِنْمَحَى",
 "拭き落す": "مَسَحَ (مَرَّ عليه بكفه وهو يلامسه؛ مَحَا، مرَّ عليه بكفه حتى يُزيله) / مَحَى, عَفَا\nمثال: مسح توم الطاولة.",
 "拭き落とす": "مَسَحَ (مَرَّ عليه بكفه وهو يلامسه؛ مَحَا، مرَّ عليه بكفه حتى يُزيله) / مَحَى, عَفَا\nمثال: مسح توم الطاولة.",
 "拭く": "مَسَحَ (مَرَّ عليه بكفه وهو يلامسه؛ مَحَا، مرَّ عليه بكفه حتى يُزيله)\nمثال: مسح توم الطاولة.",
