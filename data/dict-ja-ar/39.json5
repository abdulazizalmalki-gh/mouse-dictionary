 "懐胎": "حَبَل, حَمْل ((حَبَلَه): شَدّه بالحبْل؛ (حَبَلَه) الصَّيْدَ: نَصَب لَهُ الحِبَالةَ وصاده…)\nمثال: حبل الكذب قصير.",
 "懐郷": "حَنِين, اِشْتِيَاق",
 "懐郷病": "حَنِين, اِشْتِيَاق",
 "懐銭": "مَصْرُوف جَيْب, مَصْرُوف",
 "懐香": "شَمَر ((شَمَرَ) يَشْمُرُ شَمْرًا: مَرَّ جادًّا؛ (شَمَرَ): مَشَى مُخْتالاً)",
 "懦夫": "جَبَان (شديد الخوف ممتنع عن الإقدام؛ ضد الشجاع)\nمثال: إيدير مجرد جبان.",
 "懦弱": "لَا مُبَالٍ (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر…)\nمثال: لا أحب المدرسة. / ضَعِيف",
 "懲らしめ": "تأنيب, توبيخ (عقاب لفظي)",
 "懲らしめる": "عَاقَبَ, قَاصَصَ",
 "懲らす": "عَاقَبَ, قَاصَصَ",
 "懲りない": "مُتَعَنِّت, عَنِيد",
 "懲り懲り": "اِكتَفَى, مُكتَفٍ",
 "懲役刑": "حَبْس, سَجْن (مَنَعَ الشيءَ عن الفعلِ؛ أَمْسَكَ الشيءَ، قَبَضَ عَلَيْهِ)\nمثال: هو,البارحة حرر من الحبس.",
 "懲戒": "تَرْتِيب, اِنْضِبَاط (تنظيم الأشياء أو الأحداث في تسلسل معين أو وضعها في نظام؛ إعداد أو تجهيز شيء…)\nمثال: أعاد زيري ترتيب المطبخ كلية.",
 "懲戒処分": "عِقَاب, إِسْتِحْسَان (طَيْر من الجَوَارِح، أكبر التي تصيد منها يكنى بأبي الهَيْثَم ومعروف بحِدَّة…)\nمثال: هو من تلقى العقاب الأكبر.",
 "懲治監": "إصْلاحِيّ, تَهْذيبِيّ (يَهْدِف إلى الإصْلاح والتَّهْذيب)",
 "懲罰": "تَرْتِيب, اِنْضِبَاط (تنظيم الأشياء أو الأحداث في تسلسل معين أو وضعها في نظام؛ إعداد أو تجهيز شيء…)\nمثال: أعاد زيري ترتيب المطبخ كلية.",
 "懲罰房": "حَبْس اِنْفِرَادِيّ (مَنَعَ الشيءَ عن الفعلِ؛ أَمْسَكَ الشيءَ، قَبَضَ عَلَيْهِ)\nمثال: هو,البارحة حرر من الحبس.",
 "懲罰的": "تأديبي, عقابي (يفرض عقوبة)\nمثال: عدالة عقابية",
 "懲罰的損害賠償": "تعويضات رادعة, تعويضات عقابية ((قانون) تعويض يزيد عن الأضرار الفعلية (شكل من أشكال العقاب الممنوح في حالات سوء…)",
 "懶い": "خَامِلُ الهِمَّة, فَاتِر (يفتقر إلى الحيوية أو النشاط) / مُتْعِب, مُزْعِج (يُسَبِّب صُعُوبَةً أَوْ إِزْعَاجًا)",
 "懶惰": "بُطْء",
 "懶熊": "دب الكسلان (دب شائع خشن الشعر طويل الخطم من جنوب وسط آسيا)",
 "懸": "اِئْتِمَان / لَائِحَة (قانون مكتوب للإشارة إلى مواقف محددة وغرضه أن يمنع حدوث أمر معين أو يحث عليه…)\nمثال: من فضلك أضف اسمي إلى اللائحة. / علاقة (أي شيء يمكن تعليق شيء منه) / تقريباً, حوالي ((للكميات) غير دقيق ولكنه قريب جداً من الصواب)\nمثال: استمر حوالي ساعة / بَيْن (ظرف مكان بمعنى وَسْط)\nمثال: مصيري بين يديك. / عَاشِر\nمثال: لدي عشرة أقلام. / فِي (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "懸かり": "بدء, مشاركة أساسية (دور للبدء (في لعبة في البداية))\nمثال: حصل على بدايته لأن أحد الرماة الأساسيين كان في المستشفى / حَمْلَة / سفيف الريشة (واحدة من الشعيرات المتوازية التي تبرز من العمود الرئيسي للريشة)\nمثال: كانت كلمته الأخيرة 'اذهب للجحيم'",
 "懸け": "اِئْتِمَان / لَائِحَة (قانون مكتوب للإشارة إلى مواقف محددة وغرضه أن يمنع حدوث أمر معين أو يحث عليه…)\nمثال: من فضلك أضف اسمي إلى اللائحة. / علاقة (أي شيء يمكن تعليق شيء منه) / تقريباً, حوالي ((للكميات) غير دقيق ولكنه قريب جداً من الصواب)\nمثال: استمر حوالي ساعة / بَيْن (ظرف مكان بمعنى وَسْط)\nمثال: مصيري بين يديك. / عَاشِر\nمثال: لدي عشرة أقلام. / فِي (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "懸ける": "عَلَّقَ\nمثال: أغلق الباب بغضب / لَبِسَ, اِرْتَدَى (خَلَطَ بحيث يصعب التمييز والفصل؛ الأمر: خلطه فاشتبه واضطرب)\nمثال: لبس سروالا نظيفا. / فَعَلَ, صَنَعَ (عَمِلَ وصَنَعَ، بعلم أو بدون علم، عن قصد أو دون قصد)\nمثال: ماذا فعل للحمي؟ / أَنْفَقَ, صَرَفَ",
 "懸け樋": "أنبوب, قناة (ممر (أنبوب أو نفق) يمكن أن تمر عبره المياه أو الأسلاك الكهربائية)\nمثال: تم توصيل الحواسيب من خلال نظام من القنوات",
 "懸け橋": "جِسْر (شَجُعَ، جرُؤ؛ أقدم على الخطر واجترأ)\nمثال: اذهب إلى الجسر. / ممشى (مسار مخصص للمشي)\nمثال: بعد العاصفة الثلجية جرف الثلج من الممشى الأمامي",
 "懸け物": "رِهَان, مُرَاهَنَة",
 "懸け紙": "وَرَق تَغْلِيف (ما ينمو على النبات من الأعلى والجوانب بشكل صفائح ذات لون أخضر أو مائل إلى…)\nمثال: هات ورقة بيضاء.",
 "懸け詞": "لُعْبَة اَلْكَلِمَات, جِنَاس (اللَعْبَة البَرْبَرية دواء عشبيّ)\nمثال: عنده لعبة يويو.",
 "懸り": "بدء, مشاركة أساسية (دور للبدء (في لعبة في البداية))\nمثال: حصل على بدايته لأن أحد الرماة الأساسيين كان في المستشفى / حَمْلَة / سفيف الريشة (واحدة من الشعيرات المتوازية التي تبرز من العمود الرئيسي للريشة)\nمثال: كانت كلمته الأخيرة 'اذهب للجحيم'",
 "懸吊": "يُعَلِّق",
 "懸命": "مُشْتَاق",
 "懸垂": "تمرين العقلة (تمرين للذراع يتم بسحب النفس للأعلى على قضيب أفقي حتى يصبح الذقن بمستوى القضيب) / يُعَلِّق",
 "懸垂下降": "هبوط بالحبال ((تسلق الجبال) هبوط جرف عمودي أو جدار باستخدام حبل مزدوج مثبت في نقطة أعلى…)",
 "懸垂分詞": "اسم فاعل معلق (اسم فاعل (عادة في بداية الجملة) يبدو وكأنه يعدل كلمة غير تلك المقصودة)",
 "懸垂線": "سِلْك (السِّلْكُ : الخيطُ الذي ينظَم فيه الخرز ونحوه، أَو الذي يخاط به؛ السِّلْكُ :…)\nمثال: هذا السلك ساخن.",
 "懸壅垂": "لَهَاة",
 "懸崖": "جُرْف (أخذ شيئًا وجرفه بعيدًا، أو سحب شيئًا بقوة؛ في : في بعض الحالات، قد تستخدم…)",
 "懸念": "قَلِقَ (شاعر بالقَلَق؛ تَحَرّك/اهتزاز/اضطراب في الوضع الطبيعي للشيء)\nمثال: ليلى قلقة بشأنك.",
 "懸想": "مَوَدَّة\nمثال: يؤلمني ذراعي من الكتف إلى المرفق.",
 "懸想文": "رِسَالَةُ حُبٍّ",
 "懸架": "يُعَلِّق",
 "懸樋": "أنبوب, قناة (ممر (أنبوب أو نفق) يمكن أن تمر عبره المياه أو الأسلاك الكهربائية)\nمثال: تم توصيل الحواسيب من خلال نظام من القنوات",
 "懸橋": "جِسْر (شَجُعَ، جرُؤ؛ أقدم على الخطر واجترأ)\nمثال: اذهب إلى الجسر. / ممشى (مسار مخصص للمشي)\nمثال: بعد العاصفة الثلجية جرف الثلج من الممشى الأمامي",
 "懸濁": "يُعَلِّق",
 "懸濁液": "يُعَلِّق",
 "懸物": "رِهَان, مُرَاهَنَة",
 "懸紙": "وَرَق تَغْلِيف (ما ينمو على النبات من الأعلى والجوانب بشكل صفائح ذات لون أخضر أو مائل إلى…)\nمثال: هات ورقة بيضاء.",
 "懸詞": "لُعْبَة اَلْكَلِمَات, جِنَاس (اللَعْبَة البَرْبَرية دواء عشبيّ)\nمثال: عنده لعبة يويو.",
 "懸賞": "سَلِيبَة",
 "懸賞金": "جائزة مالية (أي أموال تُعطى كجائزة)",
 "懸軍万里": "بعثة, حملة عسكرية (حملة عسكرية مصممة لتحقيق هدف محدد في بلد أجنبي)",
 "懸軍長駆": "بعثة, حملة عسكرية (حملة عسكرية مصممة لتحقيق هدف محدد في بلد أجنبي)",
 "懸鉤子": "فْرَامْبْوَاز",
 "懸隔": "فَرْق, اِخْتِلَاف",
 "懺悔": "تَوْبَة",
 "懺悔室": "كرسي الاعتراف, كشك الاعتراف (كشك يجلس فيه الكاهن لسماع الاعترافات)",
 "懺悔録": "إِقْرَار, اِعْتِرَاف",
 "懺法": "إِقْرَار, اِعْتِرَاف",
 "懼る": "خَوْف, وَهَل\nمثال: خاف زيري نوعا ما.",
 "懾伏": "سُجُود",
 "懾服": "سُجُود",
 "戀": "حَبِيب, حَبِيبَة\nمثال: لا أحب المدرسة.",
 "戈": "ذُو مِقْبَض طَوِيل (لَهُ مِقْبَض أَوْ يَد طَويلَة) / سِلَاح, أَسْلِحَة / جرمانيوم (عنصر بلوري رمادي هش وهو شبه فلز شبه موصل (يشبه السيليكون) يستخدم في…)",
 "戈を収める": "دَفَنَ الأَحْقَادَ (دَفَنَهُ يَدْفِنُهُ: سَتَرَهُ، وواراه)\nمثال: دفن القط فضلاته.",
 "戌": "كَلْب, كلب (بمعنى ضربهُ بالكُلاب أو جعل لها كَلْبًا؛ سَيْر أحمر يُجعَل بين طرفي الأديم إذا…)\nمثال: كان الكلب ميتا.",
 "戌亥": "باتجاه الشمال الغربي (إلى أو باتجاه أو في الشمال الغربي)",
 "戍卒": "حَامِيَة",
 "戎": "إقليمي, ريفي (من خصائص الأقاليم (الريف) أو سكانها)\nمثال: ريفي ومساير للأعراف بعمق / أَجْنَبِيّ, أَجْنَبِيَّة",
 "戎克": "جُنْك",
 "戎器": "درع النبالة, شعار النبالة (الرموز الرسمية لعائلة أو دولة، إلخ)",
 "戎葵": "ختمية (أي من نباتات طويلة متنوعة من جنس ألسيا؛ موطنها الشرق الأوسط ولكنها توطنت وزرعت…)",
 "戎馬": "حصان حرب (حصان يستخدم في الحرب)",
 "成さしめる": "أَكْرَهَ, أَجْبَرَ",
 "成し得る": "قَابِل لِلتَّحْقِيق, قَابِل لِلْإِنْجَاز (يمكن تحقيقه أو إنجازه؛ في حيّز الإمكان)",
 "成し遂げる": "أَدَّى",
 "成す": "صُورَة, شَكْل\nمثال: اجلس بشكل مريح. / خَلَقَ (أَنْشَأَ، أَوْجَدَ)\nمثال: زيري سيء الخلق. / أَدَّى / تَغَيَّرَƒ\nمثال: أنا غير متفاجئ.",
 "成す術もない": "بِخَسَارَة (أقل من التكلفة)\nمثال: باع السيارة بخسارة",
 "成っていない": "غَيْر مَقْبُول, مَرْفُوض (غير مقبول؛ غير مرحب به)\nمثال: كلمة غير مقبولة في المجتمع المهذب",
 "成ってない": "غَيْر مَقْبُول, مَرْفُوض (غير مقبول؛ غير مرحب به)\nمثال: كلمة غير مقبولة في المجتمع المهذب",
 "成らず者": "بلطجي, فتوة (رجل قاسٍ ووحشي)",
 "成り": "رَقَّى ((رَقَى) المريضَ ونحوَهُ يَرْقِي رَقْيًا، ورُقِيًّا، ورُقْيَةً (بضم الراء…)",
 "成りすまし": "تَنَكَّرَ / بَارُودِيَا, مُحَاكَاة سَاخِرَة (تكوين يقلد أو يحرف أسلوب شخص ما، عادة بطريقة فكاهية)",
 "成りすます": "اِنْتَحَلَ",
 "成り上がり": "كيب, نهوض بالركل (تمرين جمباز يبدأ من وضع تكون فيه الساقان فوق الجزء العلوي من الجسم والتحرك إلى…)",
 "成り上がり者": "كيب, نهوض بالركل (تمرين جمباز يبدأ من وضع تكون فيه الساقان فوق الجزء العلوي من الجسم والتحرك إلى…)",
 "成り代わる": "اِسْتَبْدَلَ, بَدَّلَ (اتخذ شيئا بدلا من شيء)\nمثال: استبدل ياني حنفية المطبخ.",
 "成り変わる": "تَغَيَّرَƒ\nمثال: أنا غير متفاجئ.",
 "成り済まし": "تَنَكَّرَ / بَارُودِيَا, مُحَاكَاة سَاخِرَة (تكوين يقلد أو يحرف أسلوب شخص ما، عادة بطريقة فكاهية)",
 "成り済ます": "اِنْتَحَلَ",
 "成り立ち": "مَنْشَأ / هَيْكَل",
 "成り行き": "طَبَق, وَجْبَة (جَعَلَ شيئًا يغطي شيئًا آخر بشكل كامل؛ نفَّذَ أمرًا أو خطةً عمليةً)\nمثال: هذا الطبق لذيذ. / أمر بسعر السوق (أمر لوسيط ببيع أو شراء أسهم أو سلع بسعر السوق السائد)",
 "成り行き任せ": "انجراف, تسكع (تجوال بلا هدف من مكان لآخر)",
 "成り行き注文": "أمر بسعر السوق (أمر لوسيط ببيع أو شراء أسهم أو سلع بسعر السوق السائد)",
 "成り込む": "دَمَجَ (دمج الأشياء: جمعها وخلطها معًا؛ دمجهُ:جعله جزءًا من شيء أكبر منه)\nمثال: دمج فكرتين في فكرة.",
 "成り金": "كيب, نهوض بالركل (تمرين جمباز يبدأ من وضع تكون فيه الساقان فوق الجزء العلوي من الجسم والتحرك إلى…)",
 "成る": "صَارَ, أَصْبَحَ (انتقل من حال إلى أخرى. (فعل ناقص))\nمثال: صار \"توم\" منعزلا تماما. / بَرْهَنَ, أَثْبَتَ / نَجَحَ / تَغَيَّرَƒ\nمثال: أنا غير متفاجئ.",
 "成るべくなら": "بالأحرى, يفضل (بشكل أكثر استعداداً أو رغبة)\nمثال: نظفه جيداً، يفضل بالماء الدافئ",
 "成るべく早く": "فِي أَقْرَب وَقْت مُمْكِن, فِي أَسْرَع وَقْت مُمْكِن (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "成る程": "بالفعل, حقاً ((تستخدم كصيغة تعجب) تعبير عن الدهشة أو الشك أو السخرية وما إلى ذلك)\nمثال: يريد الزواج من رئيس الخدم؟ حقاً!",
 "成上り": "كيب, نهوض بالركل (تمرين جمباز يبدأ من وضع تكون فيه الساقان فوق الجزء العلوي من الجسم والتحرك إلى…)",
 "成人": "بَالِغ, رَاشِد\nمثال: その映画は成人しかみられない。 — هذا الفيلم للكبار فقط.",
 "成人向け": "بَالِغ, رَاشِد",
 "成人女性": "أنثى بالغة, امرأة (شخص بالغ أنثى (مقابل الرجل))\nمثال: كانت المرأة تدير المنزل بينما كان الرجل يصطاد",
 "成人年齢": "سِنّ الرُّشْد ((سَنَّ) السِّكِّينَ و نحْوَهُ يَسُنُّ سَنًّا: أَحَدَّهُ؛ فهو مسنون وسَنِين)\nمثال: هم في نفس السن.",
 "成人教育": "تعليم الكبار (دورة (عبر محاضرات أو بالمراسلة) للبالغين غير المنخرطين في دراسة رسمية)",
 "成人教育協会": "تعليم الكبار (دورة (عبر محاضرات أو بالمراسلة) للبالغين غير المنخرطين في دراسة رسمية)",
 "成人期": "بلوغ, سن الرشد (حالة (ومسؤوليات) الشخص الذي بلغ النضج)",
 "成人男子": "ذكر بالغ, رجل (شخص بالغ ذكر (مقابل المرأة))\nمثال: كان هناك امرأتان وستة رجال في الحافلة",
 "成人男性": "ذكر بالغ, رجل (شخص بالغ ذكر (مقابل المرأة))\nمثال: كان هناك امرأتان وستة رجال في الحافلة",
 "成仏": "مُحْتَضَر, يَمُوت (في عملية الانتقال من الحياة أو التوقف عن الوجود)\nمثال: رجل يحتضر",
 "成体": "بَالِغ, رَاشِد",
 "成分": "مُقَوِّم",
 "成分調整牛乳": "حليب متجانس (حليب تم تكسير جزيئات الدهون فيه وتوزيعها بانتظام حتى لا تطفو القشدة على السطح)",
 "成功": "نَجَاح / نَجَحَ",
 "成功報酬": "أتعاب مشروطة (أتعاب تُدفع فقط إذا كانت النتيجة ناجحة (كما هو الحال بالنسبة لخدمات المحامي))",
 "成功者": "نَجَاح",
 "成功裏": "نَجَاح",
 "成功裡": "نَجَاح",
 "成句": "اِصْطِلَاح, مُصْطَلَح / مَثَل, حِكْمَة (الشَبَه؛ النَظِير)\nمثال: قصدته مثل نكتة.",
 "成否": "نَتِيجَة",
 "成員": "عُضْو, عِضْو (جُزْء من الجَسَد؛ مُشْتَرِك فِي جَمْعِيَّة أو شَرِكَة أو حِزْب أو نَادٍ)\nمثال: اذكر كل عضو باسمه.",
 "成因": "مَنْشَأ",
 "成型": "صُورَة, شَكْل\nمثال: اجلس بشكل مريح. / اختيار الممثلين, توزيع الأدوار (اختيار الممثلين للعب أدوار معينة في مسرحية أو فيلم)",
 "成型炭": "قالب فحم (كتلة مصنوعة من الفحم النباتي أو غبار الفحم وتحرق كوقود)",
 "成婚": "زَوَاج, نِكَاح",
 "成宮": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "成家": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "成就": "إشباع, تحقيق (فعل إتمام شيء ما (كرغبة أو وعد))",
 "成層": "تنضيد (وضع البذور في رمل رطب أو نشارة خشب لحفظها أو تعزيز الإنبات)",
 "成層圏": "سْتْرَاتُوسْفِير",
 "成島": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "成嶋": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "成年": "غَالِبِيَّة, أَغْلَبِيّة",
 "成年年齢": "سِنّ الرُّشْد ((سَنَّ) السِّكِّينَ و نحْوَهُ يَسُنُّ سَنًّا: أَحَدَّهُ؛ فهو مسنون وسَنِين)\nمثال: هم في نفس السن.",
 "成年者": "بَالِغ, رَاشِد",
 "成形": "صُورَة, شَكْل\nمثال: اجلس بشكل مريح. / اختيار الممثلين, توزيع الأدوار (اختيار الممثلين للعب أدوار معينة في مسرحية أو فيلم)",
 "成形手術": "جِرَاحَةْ تَجْمِيل",
 "成形炭": "قالب فحم (كتلة مصنوعة من الفحم النباتي أو غبار الفحم وتحرق كوقود)",
 "成敗": "عِقَاب, جَزَاء (طَيْر من الجَوَارِح، أكبر التي تصيد منها يكنى بأبي الهَيْثَم ومعروف بحِدَّة…)\nمثال: هو من تلقى العقاب الأكبر. / قَطْعُ الرَّأَس (قطع الشيء : جزه؛ قطع الشيء : فصل بعضه عن بعضه الآخر)\nمثال: قطع زيري العشب.",
 "成文": "كِتَابَة (الخَطّ أو ما كُتِبَ؛ ما يُكْتَبُ عموما)\nمثال: تعبت من الكتابة.",
 "成文化": "تصنيف, تقنين (فعل التقنين؛ الترتيب في نظام منهجي)",
 "成文律": "تشريع, قانون تشريعي (قانون تم سنه من قبل هيئة تشريعية)",
 "成文法": "قانون تشريعي (مجموعة القوانين التي تنشئها التشريعات البرلمانية)",
 "成書": "كِتَاب, سِفْر (موضع تعليم الكتابة. الاستخدام الأصلي؛ مدرسة شبه رسمية لتعليم الأطفال الكِتَابَة…)\nمثال: هذا الكتاب جديد",
 "成木": "بَالِغ, مُكْتَمِلُ النُّمُوّ ((للحيوانات) مكتمل النمو والتطور)",
 "成果": "تَسَبَّب",
 "成果物": "جاهز للتسليم, قابل للتسليم (مناسب أو جاهز للتسليم)\nمثال: بموجب هذا العقد تشمل التسليمات كلاً من البرامج والأجهزة",
 "成果給": "عُمُولَة",
 "成極": "استقطاب (الظاهرة التي يتم فيها تقييد اتجاه اهتزاز موجات الضوء أو غيرها من الإشعاعات)",
 "成歯": "سن دائمة (أي من الأسنان الـ 32 التي تحل محل الأسنان اللبنية في مرحلة الطفولة المبكرة…)",
 "成瀬": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "成熟": "نَضْج",
 "成熟分裂": "إثبات بالنفي, تورية (تهوين للتأثير البلاغي (خاصة عند التعبير عن الإيجاب بنفي ضده))\nمثال: قول 'لم أكن منزعجاً قليلاً' عندما تقصد 'كنت منزعجاً جداً' هو مثال على الإثبات بالنفي",
 "成熟度": "نَضْج",
 "成熟期": "مُرَاهَقَة",
 "成田": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "成程": "قَدْر اَلْمُسْتَطَاع, قَدْر اَلْإِمْكَان (قضاء الله وحكمه وما قَدَّرَه؛ مبلغ الشيء وكميتّه، بنفس معنى قَدْر)",
 "成立": "تَشَكُّل / نَتِيجَة / إبقاء, احتفاظ (فعل الاحتفاظ بشيء ما)\nمثال: تلك القبعة ملكي",
