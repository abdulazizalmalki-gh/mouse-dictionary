 "折りたたみナイフ": "مِطْواة",
 "折りたたみ印刷物": "شرفة, وريقة (سديلة مثلثة رقيقة لصمام القلب) / كتيب, كراسة (كتاب صغير عادة ما يكون له غطاء ورقي) / وريقة (جزء من ورقة مركبة)",
 "折りたたみ式": "قَابِل لِلطَّيّ (يمكن طيّه وتخزينه)",
 "折りたたむ": "اِنْهَار / اِنْهِيَار (سقوط شيء أو تهاويه بشكل مفاجئ نتيجة ضعف أو خلل؛ تدهور نفسي أو عاطفي يؤدي إلى فقدان القدرة على التحمل)\nمثال: يوشك الجسر على الانهيار.",
 "折りもあろうに": "أبداً, على الإطلاق (في أي وقت)\nمثال: هل دخنت من قبل؟",
 "折りよく": "لِحُسْن اَلْحَظّ",
 "折り丁": "رَزْمَة صَغِيرَة, مَلْزَمَة وَرَق (كمية من الورق؛ 24 أو 25 ورقة)",
 "折り上げ": "جون, خليج صغير (مدخل مائي صغير) / تجويف صخري, كهف صغير (كهف صغير أو ضيق في جانب جرف أو جبل)",
 "折り入って": "بجدية (بطريقة جادة)\nمثال: تحدث بجدية مع ابنه",
 "折り句": "قصيدة استهلالية, قصيدة الحروف الأوائل (شعر تشكل فيه أحرف معينة، مثل الحرف الأول في كل سطر، كلمة أو رسالة) / مُرَبَّع الْكَلِمَات (لغز حيث تملأ شبكة مربعة بكلمات تقرأ نفس الشيء رأسياً وأفقياً)",
 "折り合い": "اِتِّفَاق, تَوَافُق / إِقْرَار / اِتِّفَاق, اِتِّفَاقِيَّة / عَلَاقَة, مُنَاسَبَة / صِلَة, عَلَاقَة",
 "折り合う": "حَل وَسَط, تَسْوِيَة (للعقدة: ضد عَقْدها؛ للجامد في السائل: إذابته) / يخترق\nمثال: حل زيري المشكل.",
 "折り好く": "لِحُسْن اَلْحَظّ",
 "折り悪く": "لِلْأَسَف, لِسُوءِ الْحَظِّ",
 "折り悪しく": "لِلْأَسَف, لِسُوءِ الْحَظِّ",
 "折り戸": "باب أكورديون, باب قابل للطي (باب داخلي يفتح عن طريق الطي للخلف في أقسام (بدلاً من التأرجح على مفصلات))",
 "折り敷き": "جثو, ركوع (دعم نفسك على ركبتيك)",
 "折り敷く": "رَكَعَ, جَثَا ((رَكَعَ) رَكْعًا، ورُكوعًا: انحنى، سواءٌ؛ مَسّتْ ركبتاه الأرض أم لا)",
 "折り曲げる": "ثَنَى (طوى شيئًا وجعله على شكل مزدوج؛ أعاد النظر أو غير مسار قراره أو تصرفه)",
 "折り畳み": "طي (عملية الطي) / طي (عملية جيولوجية تسبب انحناء في طبقة صخرية) / طي البروتين (العملية التي يتخذ فيها جزيء البروتين شكله المعقد ثلاثي الأبعاد)\nمثال: قام بطي المناديل طية مزدوجة",
 "折り畳みナイフ": "مِطْواة",
 "折り畳み印刷物": "شرفة, وريقة (سديلة مثلثة رقيقة لصمام القلب) / كتيب, كراسة (كتاب صغير عادة ما يكون له غطاء ورقي) / وريقة (جزء من ورقة مركبة)",
 "折り畳み式": "قَابِل لِلطَّيّ (يمكن طيّه وتخزينه)",
 "折り畳み機": "مِلَفّ, مُجَلَّد / مُجَلَّد",
 "折り畳む": "اِنْهَار / اِنْهِيَار (سقوط شيء أو تهاويه بشكل مفاجئ نتيجة ضعف أو خلل؛ تدهور نفسي أو عاطفي يؤدي إلى فقدان القدرة على التحمل)\nمثال: يوشك الجسر على الانهيار.",
 "折り目": "طَوَى / طَيَّة / آداب, أخلاق (السلوك الاجتماعي)\nمثال: أخلاقه أخلاق خنازير",
 "折り目正しい": "حَسَنُ الأَخْلَاقِ, مُؤَدَّب (صحيح السلوك اجتماعياً) / حَسَنُ التَّرْبِيَةِ, مُؤَدَّبٌ (ذو تربية حسنة وتنشئة راقية)",
 "折り節": "أَحْيَانًا",
 "折り紙": "أُورِيغَامِي, طَيّ اَلْوَرَق / بصمة, سمة فارقة (سمة أو صفة مميزة لشخص أو شيء ما) / دمغة, علامة جودة (علامة على سلعة تجارية للإشارة إلى منشئها وأصالتها)",
 "折り紙つき": "ضَمَان, ضَمَانَة (مَصْدَرُ ضَمِنَ؛ كَفَالَة) / ضَمِنَ\nمثال: لا أستطيع ضمان أي شيء.",
 "折り紙を付ける": "ضَمَان, ضَمَانَة (مَصْدَرُ ضَمِنَ؛ كَفَالَة) / ضَمِنَ\nمثال: لا أستطيع ضمان أي شيء.",
 "折り紙付": "ضَمَان, ضَمَانَة (مَصْدَرُ ضَمِنَ؛ كَفَالَة) / ضَمِنَ\nمثال: لا أستطيع ضمان أي شيء.",
 "折り紙付き": "ضَمَان, ضَمَانَة (مَصْدَرُ ضَمِنَ؛ كَفَالَة) / ضَمِنَ\nمثال: لا أستطيع ضمان أي شيء.",
 "折り罫": "خنجر الكريس (خنجر ماليزي ذو نصل متموج) / تجعد, ثنية (انخفاض أو طية طفيفة في نعومة السطح) / انثناء, ثنية (شكل زاوي أو مستدير ناتج عن الطي)\nمثال: يحتوي وجهه على العديد من الخطوط",
 "折り襟": "طَيَّة",
 "折り込み": "أَدْخَلَ",
 "折り込む": "أَدْخَلَ / يحساب حساب",
 "折り返し": "طَيَّة / رَاجِع, عَائِد (يميل إلى العودة إلى حالة سابقة) / كَوْرَس, كُورَس / لَازِمَة, قَرَار / المَعْرُوف بِـ, بِاسْم مُسْتَعَار (كما هو معروف أو مسمى في وقت أو مكان آخر) / اسم مستعار (اسم تم انتحاله)\nمثال: السيد سميث، المعروف بالسيد لافاييت",
 "折り返し地点": "نقطة تحوّل (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه)\nمثال: هذه هي نقطة ضعفه.",
 "折り返し点": "نقطة تحوّل (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه)\nمثال: هذه هي نقطة ضعفه.",
 "折り返す": "رَجَعَ, عَادَ (جَاءَ بعدما ذَهَبَ) / أَرْجَعَ, أَعَادَ (أَعَادَ، رَدَّ؛ صَرَفَ، رَدَّ) / عَوْدَة\nمثال: إياك والتحرك حتى أرجع.",
 "折り鞄": "حَقِيبَة, مِحْفَظَة",
 "折る": "اِنْكَسَرَ (فعل مطاوعة لكَسَرَ، قام أحدهم بكَسْره أو قام هو بكَسْر نفسه؛ التاجر: خَسِرَ المال ونَقَصَ عنده المال، أفْلَسَ) / كَسَرَ / اِسْتِرَاحَة (مبنى خارج المدن يتوقف فيه المسافرون للراحة والتَزَوُّد يُجمع على اِسْتِرَاحَات)\nمثال: عليك أخذ استراحة. / طَوَى / طَيَّة / فَعَلَ, صَنَعَ (عَمِلَ وصَنَعَ، بعلم أو بدون علم، عن قصد أو دون قصد) / جَعَلَ (صَيَّرَ؛ أَنْشَأَ)\nمثال: ماذا فعل للحمي؟ / قَاطَعَ",
 "折れ": "طَوَى / طَيَّة",
 "折れる": "اِنْكَسَرَ (فعل مطاوعة لكَسَرَ، قام أحدهم بكَسْره أو قام هو بكَسْر نفسه؛ التاجر: خَسِرَ المال ونَقَصَ عنده المال، أفْلَسَ) / كَسَرَ / اِسْتِرَاحَة (مبنى خارج المدن يتوقف فيه المسافرون للراحة والتَزَوُّد يُجمع على اِسْتِرَاحَات)\nمثال: عليك أخذ استراحة. / أَذْعَنَ ((أَذْعَنَ): انْقَادَ وسلس وَيُقَال: أذعن بِالْحَقِّ: أقرّ بِهِ) / دَارَ, أَدَارَ (المحل يجمع البِنَاء والعَرَصَة. قيل سمي كذلك لدوران الناس به وعليه وحوله. يجمع على دُور؛ المنزل المَبْني. يجمع على دُور) / لَفَّ / قَلَبَ / اِنْقَلَبَ, صَارَ / اِنْعِطَاف / دَوْر, نَوْبَة (جَعَله يَدُور؛ جَعَلَه مُدَوَّر)\nمثال: إذهب إلى الدار.",
 "折れ口": "اِنْكَسَرَ (فعل مطاوعة لكَسَرَ، قام أحدهم بكَسْره أو قام هو بكَسْر نفسه؛ التاجر: خَسِرَ المال ونَقَصَ عنده المال، أفْلَسَ) / كَسَرَ / اِسْتِرَاحَة (مبنى خارج المدن يتوقف فيه المسافرون للراحة والتَزَوُّد يُجمع على اِسْتِرَاحَات)\nمثال: عليك أخذ استراحة.",
 "折れ合う": "حَل وَسَط, تَسْوِيَة (للعقدة: ضد عَقْدها؛ للجامد في السائل: إذابته) / يخترق\nمثال: حل زيري المشكل.",
 "折れ曲がる": "ثَنَى (طوى شيئًا وجعله على شكل مزدوج؛ أعاد النظر أو غير مسار قراره أو تصرفه)",
 "折れ目": "طَوَى / طَيَّة",
 "折れ線": "بشكل متعرج (في مسار متعرج أو على طريق متعرج) / زِيكْزَاكِيّ, مُتَعَرِّج (ذو منعطفات حادة وقصيرة أو زوايا متتالية) / زجزاج, متعرج (شكل زاوي يتميز بمنعطفات حادة في اتجاهات متبادلة)\nمثال: طارت الطيور بشكل متعرج عبر السماء الزرقاء",
 "折れ返る": "كَرَّرَ, أَعَادَ (أَعَادَ)\nمثال: كرر الشهادة بعدي.",
 "折丁": "رَزْمَة صَغِيرَة, مَلْزَمَة وَرَق (كمية من الورق؛ 24 أو 25 ورقة)",
 "折上": "جون, خليج صغير (مدخل مائي صغير) / تجويف صخري, كهف صغير (كهف صغير أو ضيق في جانب جرف أو جبل)",
 "折中": "حَل وَسَط, تَسْوِيَة (للعقدة: ضد عَقْدها؛ للجامد في السائل: إذابته) / يخترق\nمثال: حل زيري المشكل.",
 "折半": "نِصْف, نُصْف",
 "折句": "قصيدة استهلالية, قصيدة الحروف الأوائل (شعر تشكل فيه أحرف معينة، مثل الحرف الأول في كل سطر، كلمة أو رسالة) / مُرَبَّع الْكَلِمَات (لغز حيث تملأ شبكة مربعة بكلمات تقرأ نفس الشيء رأسياً وأفقياً)",
 "折合い": "اِتِّفَاق, تَوَافُق / إِقْرَار / اِتِّفَاق, اِتِّفَاقِيَّة / عَلَاقَة, مُنَاسَبَة / صِلَة, عَلَاقَة",
 "折合う": "حَل وَسَط, تَسْوِيَة (للعقدة: ضد عَقْدها؛ للجامد في السائل: إذابته) / يخترق\nمثال: حل زيري المشكل.",
 "折好く": "لِحُسْن اَلْحَظّ",
 "折悪しく": "لِلْأَسَف, لِسُوءِ الْحَظِّ",
 "折戸": "باب أكورديون, باب قابل للطي (باب داخلي يفتح عن طريق الطي للخلف في أقسام (بدلاً من التأرجح على مفصلات))",
 "折折": "أَحْيَانًا",
 "折損": "تحطيم, كسر (عملية كسر شيء ما)\nمثال: كان الكسر لا مفر منه",
 "折敷く": "رَكَعَ, جَثَا ((رَكَعَ) رَكْعًا، ورُكوعًا: انحنى، سواءٌ؛ مَسّتْ ركبتاه الأرض أم لا)",
 "折曲げる": "ثَنَى (طوى شيئًا وجعله على شكل مزدوج؛ أعاد النظر أو غير مسار قراره أو تصرفه)",
 "折板": "جبيرة (جهاز ميكانيكي لتقويم العظام يستخدم لتثبيت وحماية جزء من الجسم (مثل الساق المكسورة)) / شَظِيَّة خشبية, شُقَاقَة (شظية رفيعة من الخشب)\nمثال: أشعل النار باستخدام شظية خشبية مشتعلة",
 "折柄": "عندئذ, في تلك اللحظة (في وقت معين في الماضي)\nمثال: عندئذ انطلق البوق / فِي ذَلِك, فِي ذَلِك المَكَان ((رسمي) في أو داخل ذلك الشيء أو المكان)\nمثال: يمكنهم أن يقرؤوا في ذلك ما هي خططنا",
 "折檻": "ضَرْب (معروف، وهو اللطم أو الدق أو الصكّ و ما أشبه؛ النَوْع أو الصنف أو المثال)\nمثال: ضرب سامي زوجته. / تأنيب, توبيخ (عقاب لفظي) / تَأْدِيب, تَقْوِيم (توبيخ لارتكاب خطأ)",
 "折畳み": "طي (عملية الطي) / طي (عملية جيولوجية تسبب انحناء في طبقة صخرية) / طي البروتين (العملية التي يتخذ فيها جزيء البروتين شكله المعقد ثلاثي الأبعاد)\nمثال: قام بطي المناديل طية مزدوجة",
 "折畳み式": "قَابِل لِلطَّيّ (يمكن طيّه وتخزينه)",
 "折畳印刷物": "شرفة, وريقة (سديلة مثلثة رقيقة لصمام القلب) / كتيب, كراسة (كتاب صغير عادة ما يكون له غطاء ورقي) / وريقة (جزء من ورقة مركبة)",
 "折目": "طَوَى / طَيَّة / آداب, أخلاق (السلوك الاجتماعي)\nمثال: أخلاقه أخلاق خنازير",
 "折目正しい": "حَسَنُ الأَخْلَاقِ, مُؤَدَّب (صحيح السلوك اجتماعياً) / حَسَنُ التَّرْبِيَةِ, مُؤَدَّبٌ (ذو تربية حسنة وتنشئة راقية)",
 "折笠": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "折節": "أَحْيَانًا",
 "折紙": "أُورِيغَامِي, طَيّ اَلْوَرَق / بصمة, سمة فارقة (سمة أو صفة مميزة لشخص أو شيء ما) / دمغة, علامة جودة (علامة على سلعة تجارية للإشارة إلى منشئها وأصالتها)",
 "折紙を付ける": "ضَمَان, ضَمَانَة (مَصْدَرُ ضَمِنَ؛ كَفَالَة) / ضَمِنَ\nمثال: لا أستطيع ضمان أي شيء.",
 "折罫": "خنجر الكريس (خنجر ماليزي ذو نصل متموج) / تجعد, ثنية (انخفاض أو طية طفيفة في نعومة السطح) / انثناء, ثنية (شكل زاوي أو مستدير ناتج عن الطي)\nمثال: يحتوي وجهه على العديد من الخطوط",
 "折良く": "لِحُسْن اَلْحَظّ",
 "折衝": "مُفَاوَضَات, مُذَاكَرَات",
 "折衷": "حَل وَسَط, تَسْوِيَة (للعقدة: ضد عَقْدها؛ للجامد في السائل: إذابته) / يخترق\nمثال: حل زيري المشكل.",
 "折衷主義": "انتقائية (اتخاذ القرارات بناءً على ما يبدو أفضل بدلاً من اتباع مذهب أو أسلوب واحد)",
 "折襟": "طَيَّة",
 "折角": "نَادِر / نوع (صِنْف؛ في : وحدة تصنيفية أقل من الجنس) / حَنُون, لَطِيف\nمثال: انه نوع من الفطر.",
 "折込": "أَدْخَلَ",
 "折込み": "أَدْخَلَ",
 "折込む": "أَدْخَلَ / يحساب حساب",
 "折返し": "طَيَّة / رَاجِع, عَائِد (يميل إلى العودة إلى حالة سابقة) / كَوْرَس, كُورَس / لَازِمَة, قَرَار / المَعْرُوف بِـ, بِاسْم مُسْتَعَار (كما هو معروف أو مسمى في وقت أو مكان آخر) / اسم مستعار (اسم تم انتحاله)\nمثال: السيد سميث، المعروف بالسيد لافاييت",
 "折返る": "كَرَّرَ, أَعَادَ (أَعَادَ)\nمثال: كرر الشهادة بعدي.",
 "折鶴蘭": "زهرة العنكبوت (موطنها أمريكا الجنوبية ولكنها متوطنة في الأجزاء الدافئة من الولايات المتحدة؛ تزرع لأزهارها طويلة الأمد التي تشبه العنكبوت بيضاء إلى وردية أرجوانية)",
 "抛擲": "اِنْصَرَفَ, يَنْصَرِفُ (فعل مطاوعة لصَرَفَ: صَرَفْتُهُ فَاَنْصَرَف؛ ذهب إلى مكان آخر) / تَرَكَ, يترك (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض)\nمثال: انصرف من ملكيتنا!",
 "抛物面": "مجسم قطع مكافئ (سطح له مقاطع مكافئة موازية لمحور إحداثي واحد ومقاطع بيضاوية متعامدة مع ذلك المحور)",
 "抜かす": "إغفال, حذف (خطأ ناتج عن الإهمال) / قفز خفيف, وثب (مشية تتبادل فيها الخطوات والقفزات) / سَبَقَ (سَبَقَهُ إِلَى الشيءِ يَسْبِقَهُ سَبْقًا: تقدَّمَهُ؛ يقال سَبَقَ الفرسُ في الحَلْبةِ: جاءَ قبل الأَفراسِ)\nمثال: سبق و رأيت ذلك. / قَالَ, قال (نَطَقَ بالكلام) / يَتْلُو / قَالَ, يَقُول (نَطَقَ بالكلام)\nمثال: قال زيري وداعا.",
 "抜かせ": "أَعْطِنِي",
 "抜かり": "خطأ فادح, زلة (خطأ محرج)",
 "抜かる": "أَخْطَأَ ((أخْطَأَ): خَطِئَ؛ (أخْطَأَ) غَلِظَ (حاد عن الصواب))\nمثال: اعترف أنه أخطأ.",
 "抜きがたい": "رَاسِخ, عَمِيق الجُذُور ((يستخدم خاصة للأفكار أو المبادئ) عميق الجذور؛ ثابت ومتمكّن بقوّة)",
 "抜きさる": "مَرَّرَ, مَرَّ / اِحْتَازَ (بنفس معنى حَازَ، إلا أن احتاز تميل إلى أن الفاعل أراد الحوز) / اِنْقَضَى, مَرَّ / أَهمَلَ / تَغَاضَى / تَخَلَّى / طَريق (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من ٱلشَّارِعِ، سَبِيل) / جَوَاز\nمثال: أسأل عن الطريق. / عَزَلَ (فَصَلَ، فرَز، أَبْعَدَ؛ أَبْعَدَ، نَحَّى)\nمثال: جو بايدن طالب الكونغرس بعزل ترامب.",
 "抜きしろ": "مُسْوَدَّة / تَجْنِيد / سَوَّدَ / جَنَّدَ (جَنَّدَ الجنودَ: جَمَعَهَا؛ جَنَّدَ فلانًا: صيَّره جنديّاً)",
 "抜きんでる": "فَاقَ, تَجَاوَزَ",
 "抜きん出る": "فَاقَ, تَجَاوَزَ",
 "抜きネタ": "مِغْرَفَة",
 "抜き出す": "اِخْتَارَ / مُقْتَطَف / خلاصة",
 "抜き出る": "فَاقَ, تَجَاوَزَ",
 "抜き刷": "طبعة منفصلة, مُستَلّة (مقال مطبوع بشكل منفصل ظهر أصلاً في منشور أكبر)",
 "抜き刷り": "طبعة منفصلة, مُستَلّة (مقال مطبوع بشكل منفصل ظهر أصلاً في منشور أكبر)",
 "抜き去る": "مَرَّرَ, مَرَّ / اِحْتَازَ (بنفس معنى حَازَ، إلا أن احتاز تميل إلى أن الفاعل أراد الحوز) / اِنْقَضَى, مَرَّ / أَهمَلَ / تَغَاضَى / تَخَلَّى / طَريق (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من ٱلشَّارِعِ، سَبِيل) / جَوَاز\nمثال: أسأل عن الطريق. / عَزَلَ (فَصَلَ، فرَز، أَبْعَدَ؛ أَبْعَدَ، نَحَّى)\nمثال: جو بايدن طالب الكونغرس بعزل ترامب.",
 "抜き取る": "عَزَلَ (فَصَلَ، فرَز، أَبْعَدَ؛ أَبْعَدَ، نَحَّى)\nمثال: جو بايدن طالب الكونغرس بعزل ترامب. / أَخَذَ (تَنَاوَلَ الشيء بيده، تملكه أو تحكم فيه، بالقوة أو بدونها؛ أمْسَكَ بِالشيء. (يتعدى بالباء)) / أَخَذَ بِـ (تَنَاوَلَ الشيء بيده، تملكه أو تحكم فيه، بالقوة أو بدونها؛ أمْسَكَ بِالشيء. (يتعدى بالباء)) / اِتَّخَذَ / اِسْتَغْرَقَ / اِلْتَقَطَ\nمثال: أخذ الولد يبكي. / سَرَقَ (أخذ ما كان لغيره خفية وبدون علم أحد) / اِسْتَرَقَ\nمثال: من سرق التفاحة؟",
 "抜き型": "أداة قطع, قاطعة (أداة للقطع) / قارب قاطع, كتر (سفينة شراعية بصارية واحدة مثبتة في الخلف أكثر من صارية السلوب) / قارب توصيل, قارب خدمات (قارب للتواصل بين السفينة والشاطئ) / قاطع, قصاص (شخص عمله القص (مثل قص القماش للملابس))",
 "抜き差し": "أَدَارَ (دَارَ نصف دورة فقط؛ الشيء: جعله يدور؛ فعل تعدّي من دَارَ)\nمثال: أدار فاضل مقبض الباب بهدوء و دخل إلى المنزل.",
 "抜き差しならぬ": "دَبِق, صَمْغِيّ (له خصائص اللصق اللزجة كالمواد اللاصقة) / لَاصِق, لَزِق (مُغطّى بمادّة لاصقة) / حَرِج, مُحْرِج (صَعْب التَّعَامُل مَعَهُ؛ يُسَبِّب أَلَمًا أَوْ إِحْرَاجًا) / حَارّ وَرَطْب, خَانِق (حارّ أو دافئ ورطب بشكل مزعج)",
 "抜き打ち検査": "تفتيش عشوائي, فحص مفاجئ (فحص لأداء العمل أو جودة المنتج يتم في أوقات عشوائية دون سابق إنذار)\nمثال: تضمن الفحوصات المفاجئة مستوى عالياً من الأداء من قبل الموظفين",
 "抜き打ち調査": "تفتيش عشوائي, فحص مفاجئ (فحص لأداء العمل أو جودة المنتج يتم في أوقات عشوائية دون سابق إنذار)\nمثال: تضمن الفحوصات المفاجئة مستوى عالياً من الأداء من قبل الموظفين",
 "抜き放つ": "اِسْتَلّ, شَهَرَ",
 "抜き書き": "مُقْتَطَف / خلاصة",
 "抜き足で": "بتسلل, خلسة (بطريقة خفية)\nمثال: تقدموا خلسة عكس التيار",
 "抜き難い": "رَاسِخ, عَمِيق الجُذُور ((يستخدم خاصة للأفكار أو المبادئ) عميق الجذور؛ ثابت ومتمكّن بقوّة)",
 "抜く": "عَزَلَ (فَصَلَ، فرَز، أَبْعَدَ؛ أَبْعَدَ، نَحَّى)\nمثال: جو بايدن طالب الكونغرس بعزل ترامب. / إغفال, حذف (خطأ ناتج عن الإهمال) / قفز خفيف, وثب (مشية تتبادل فيها الخطوات والقفزات) / بَالُوعَة / اِخْتَارَ",
 "抜くべからざる": "رَاسِخ, عَمِيق الجُذُور ((يستخدم خاصة للأفكار أو المبادئ) عميق الجذور؛ ثابت ومتمكّن بقوّة)",
 "抜け": "إِغْفَال / تَعْرِيف (الإعلام؛ الشيء أو الكلمة: التوضيح بالمعنى بصورة مختصرة ليعرف الناس ما هي)\nمثال: هل لديه بطاقة شخصية (هوية شخصية - بطاقة تعريف)",
 "抜けかわる": "سَقِيفَة",
 "抜けもれ": "سهو, غفلة (خطأ ناتج عن عدم الانتباه) / إشراف, رقابة (الإدارة من خلال الإشراف على أداء أو تشغيل شخص أو مجموعة) / سهو, غفلة غير مقصودة (إغفال غير مقصود ناتج عن الفشل في ملاحظة شيء ما)",
 "抜ける": "خَرَجَ (اِنْتَقَلَ إلى خارج المكان) / غَادَرَ (تَرَكَ)\nمثال: خرج سامي ليحتفل. / اختفاء, تلاشٍ (التوقف التدريجي عن الظهور) / ضربة مقوسة لليمين (ضربة غولف تنحني لليمين للاعب الغولف الأيمن)\nمثال: أخذ دروساً لعلاج ضرباته المقوسة / تَرَكَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض) / تَرَكَ, غَادَرَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض) / إِجَازَة, عُطْلَة\nمثال: لقد ترك لك هذا. / خُرُوج / مَخْرَج / خَرَجَ (اِنْتَقَلَ إلى خارج المكان)\nمثال: خرج سامي ليحتفل.",
 "抜け代る": "سَقِيفَة",
 "抜け代わる": "سَقِيفَة",
 "抜け作": "مُغَفَّل, أَحْمَق",
 "抜け出す": "انْسَلَّ, تَسَلَّلَ خارجاً (المغادرة خلسة وسراً)\nمثال: كانت المحاضرة مملة وانسل العديد من الطلاب خارجاً / اِنْدَلَعَ",
 "抜け出る": "انْسَلَّ, تَسَلَّلَ خارجاً (المغادرة خلسة وسراً)\nمثال: كانت المحاضرة مملة وانسل العديد من الطلاب خارجاً / تَفَوَّقَ, بَزَّ / بَرَعَ (تفوق أو تميز في مجال معين أو عمل معين؛ أجاد وأتقن أداء مهمة أو عمل)",
 "抜け変る": "سَقِيفَة",
 "抜け変わる": "سَقِيفَة",
 "抜け抜け": "بجرأة, بوقاحة (بطريقة وقحة)\nمثال: تحدث بوقاحة / بغباء (بطريقة غبية)\nمثال: اشترى تذكرة ذهاب فقط بغباء",
 "抜け替る": "سَقِيفَة",
 "抜け替わる": "سَقِيفَة",
 "抜け殻": "قِشْرَة",
 "抜け毛": "تسريح, تمشيط (فعل تمرير المشط خلال الشعر)\nمثال: كان شعره بحاجة إلى تمشيط",
 "抜け漏れ": "سهو, غفلة (خطأ ناتج عن عدم الانتباه) / إشراف, رقابة (الإدارة من خلال الإشراف على أداء أو تشغيل شخص أو مجموعة) / سهو, غفلة غير مقصودة (إغفال غير مقصود ناتج عن الفشل في ملاحظة شيء ما)",
 "抜け目": "حماقة, سفاهة (نقص الحذر في الشؤون العملية)",
 "抜け目がない": "حَاذِق (اسم فاعل للفعل حَذِقَ أي المَاهِرِ المُتقِنِ لعَمَلِهِ) / نَاصِح, نَبِيه\nمثال: إنها حاذقة الذكاء.",
 "抜け目ない": "حَاذِق (اسم فاعل للفعل حَذِقَ أي المَاهِرِ المُتقِنِ لعَمَلِهِ) / نَاصِح, نَبِيه\nمثال: إنها حاذقة الذكاء.",
 "抜け目のない": "حَاذِق (اسم فاعل للفعل حَذِقَ أي المَاهِرِ المُتقِنِ لعَمَلِهِ) / نَاصِح, نَبِيه\nمثال: إنها حاذقة الذكاء.",
 "抜け目無い": "حَاذِق (اسم فاعل للفعل حَذِقَ أي المَاهِرِ المُتقِنِ لعَمَلِهِ) / نَاصِح, نَبِيه\nمثال: إنها حاذقة الذكاء.",
 "抜け穴": "فتحة الرمي, مزغل (ثقب صغير في جدار محصن؛ للمراقبة أو إطلاق الأسلحة) / ثغرة (غموض (خاصة في نص قانون أو عقد) يجعل من الممكن التهرب من صعوبة أو التزام) / حركة افتتاحية, خطوة أولى (الأولى في سلسلة من الإجراءات) / فتح (عملية فتح شيء ما) / فتح (أن يصبح الشيء مفتوحاً أو يتم فتحه) / افتتاحية, افتتاحية الشطرنج (تسلسل معترف به من النقلات في بداية لعبة الشطرنج)\nمثال: كشف شعاع الضوء عن فتحه الحذر للباب",
 "抜け荷": "تَهْرِيب",
 "抜け落ちる": "خَرَجَ (اِنْتَقَلَ إلى خارج المكان) / غَادَرَ (تَرَكَ)\nمثال: خرج سامي ليحتفل.",
 "抜け裏": "طريق جانبي, طريق فرعي (طريق جانبي قليل الاستخدام (كما في الريف))",
 "抜け道": "طريق جانبي, طريق فرعي (طريق جانبي قليل الاستخدام (كما في الريف)) / فتحة الرمي, مزغل (ثقب صغير في جدار محصن؛ للمراقبة أو إطلاق الأسلحة) / ثغرة (غموض (خاصة في نص قانون أو عقد) يجعل من الممكن التهرب من صعوبة أو التزام)",
 "抜てき": "اختيار, انتقاء (فعل الاختيار أو الانتقاء) / اختيار, خيار (الشخص أو الشيء الذي تم اختياره أو انتقاؤه) / مختارات, مقتبس (مقطع مختار من عمل أكبر) / تشكيلة مختارة, خيار (مجموعة متنوعة من الأشياء التي يمكن الاختيار منها)\nمثال: كان اختيارك للألوان غير موفق",
 "抜作": "مُغَفَّل, أَحْمَق",
 "抜出る": "فَاقَ, تَجَاوَزَ",
 "抜刷": "طبعة منفصلة, مُستَلّة (مقال مطبوع بشكل منفصل ظهر أصلاً في منشور أكبر)",
 "抜刷り": "طبعة منفصلة, مُستَلّة (مقال مطبوع بشكل منفصل ظهر أصلاً في منشور أكبر)",
 "抜去": "استخراج, خلع (عملية إخراج شيء ما (خاصة باستخدام الجهد أو القوة)) / أصل, منشأ (الخصائص المنسوبة لأسلافك) / استخراج, استخلاص (عملية الحصول على شيء من خليط أو مركب بوسائل كيميائية أو فيزيائية أو ميكانيكية)\nمثال: أعطاها طبيب الأسنان تخديراً موضعياً قبل الخلع",
 "抜去る": "مَرَّرَ, مَرَّ / اِحْتَازَ (بنفس معنى حَازَ، إلا أن احتاز تميل إلى أن الفاعل أراد الحوز) / اِنْقَضَى, مَرَّ / أَهمَلَ / تَغَاضَى / تَخَلَّى / طَريق (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من ٱلشَّارِعِ، سَبِيل) / جَوَاز\nمثال: أسأل عن الطريق. / عَزَلَ (فَصَلَ، فرَز، أَبْعَدَ؛ أَبْعَدَ، نَحَّى)\nمثال: جو بايدن طالب الكونغرس بعزل ترامب.",
 "抜型": "أداة قطع, قاطعة (أداة للقطع) / قارب قاطع, كتر (سفينة شراعية بصارية واحدة مثبتة في الخلف أكثر من صارية السلوب) / قارب توصيل, قارب خدمات (قارب للتواصل بين السفينة والشاطئ) / قاطع, قصاص (شخص عمله القص (مثل قص القماش للملابس))",
 "抜擢": "اختيار, انتقاء (فعل الاختيار أو الانتقاء) / اختيار, خيار (الشخص أو الشيء الذي تم اختياره أو انتقاؤه) / مختارات, مقتبس (مقطع مختار من عمل أكبر) / تشكيلة مختارة, خيار (مجموعة متنوعة من الأشياء التي يمكن الاختيار منها)\nمثال: كان اختيارك للألوان غير موفق",
 "抜書": "مُقْتَطَف / خلاصة",
 "抜書き": "مُقْتَطَف / خلاصة",
 "抜本": "استئصال, طمس (التدمير الكامل لكل أثر لشيء ما) / جَذْرِيّ, صَارِم (قويّ وحازم وصارم) / نبذة – مقتطفات من",
 "抜本的": "جَذْرِيّ, صَارِم (قويّ وحازم وصارم)",
 "抜根機": "مشجع رياضي (مؤيد متحمس للرياضة)",
 "抜殻": "قِشْرَة",
 "抜毛": "الجماع المقطوع, العزل (طريقة لتحديد النسل يتم فيها بدء الجماع ولكن يتم سحب القضيب عمداً قبل القذف)",
 "抜毛症": "هوس نتف الشعر",
 "抜毛癖": "هوس نتف الشعر",
 "抜爪": "قلع الأظافر (شكل من أشكال التعذيب يتم فيه نزع أظافر اليدين أو القدمين)",
 "抜目": "حماقة, سفاهة (نقص الحذر في الشؤون العملية)",
 "抜穴": "فتحة الرمي, مزغل (ثقب صغير في جدار محصن؛ للمراقبة أو إطلاق الأسلحة) / ثغرة (غموض (خاصة في نص قانون أو عقد) يجعل من الممكن التهرب من صعوبة أو التزام) / حركة افتتاحية, خطوة أولى (الأولى في سلسلة من الإجراءات) / فتح (عملية فتح شيء ما) / فتح (أن يصبح الشيء مفتوحاً أو يتم فتحه) / افتتاحية, افتتاحية الشطرنج (تسلسل معترف به من النقلات في بداية لعبة الشطرنج)\nمثال: كشف شعاع الضوء عن فتحه الحذر للباب",
 "抜粋": "مُقْتَطَف / خلاصة",
 "抜線": "فَجْوَة عَمِيقَة, هُوَّة (تفاوت لا يمكن جسره (بسبب فشل في الفهم مثلاً))\nمثال: شعر بهوة بينه وبين أصدقائه السابقين",
 "抜群": "لَافِت, مُلْفِتٌ لِلنَّظَرِ (لَهُ صِفَةٌ تَفْرِضُ نَفْسَهَا عَلَى الِانْتِبَاهِ) / بَارِز, عَظِيم (ذو أهمّيّة أو دلالة كُبرى) / غَيْرُ مُسَدَّد, مُسْتَحَقّ (مُسْتَحَقٌّ كَدَيْن) / بَارِع, مُتَمَيِّز (يتميز عن غيره بالتفوق)",
 "抜難い": "رَاسِخ, عَمِيق الجُذُور ((يستخدم خاصة للأفكار أو المبادئ) عميق الجذور؛ ثابت ومتمكّن بقوّة)",
 "択び": "اِخْتَارَ",
 "択り": "اِخْتَارَ",
 "択る": "اِخْتَارَ",
 "択一問題": "متعدد الخيارات (يقدم عدة إجابات بديلة يجب اختيار الإجابة الصحيحة منها)\nمثال: أسئلة متعددة الخيارات",
 "択一的": "بَدِيلِيّ, تَخْيِيرِيّ (يَسْتَلْزِمُ الِاخْتِيَارَ بَيْنَ احْتِمَالَاتٍ مُتَنَافِيَةٍ) / بَدِيل (يَتَعَلَّقُ بِخِيَارَاتٍ غَيْرِ تَقْلِيدِيَّة) / بَدِيل (يُستخدَم أو يَخدُم مكان شيء آخر) / بديل, خيار (واحد من عدد من الأشياء التي يمكن اختيار واحد منها فقط)\nمثال: ما الخيار الذي كان لدي؟",
 "披く": "مَفْتُوح / فَتَحَ (ضد أغْلَقَ وسَدَّ؛ تركه بلا شيء يسده؛ الطريق: جعلها سالكة للطارقين) / فتح (ضد أغْلَقَ وسَدَّ؛ تركه بلا شيء يسده؛ الطريق: جعلها سالكة للطارقين) / حل (للعقدة: ضد عَقْدها؛ للجامد في السائل: إذابته) / اِنْفَتَحَ (فعل مطاوعة لفَتَحَ، فَتَحْتُهُ فانْفَتَح؛ يستخدم عوضا عن المبنى للمجهول فُتِحَ. )\nمثال: فتح الباب آليا.",
 "披瀝": "إخبار, إعلام (فعل كلامي ينقل معلومات)",
 "披裂軟骨": "غضروف طرجهالي (أحد غضروفين صغيرين في مؤخرة الحنجرة تتصل بهما الحبال الصوتية)",
 "披見": "قِرَاءَة",
 "披針形": "رُمْحِيّ ((عن شكل الورقة) كرأس الرمح؛ ضيّق يتدرَّج إلى قمّة مُدبَّبة)",
 "披露": "إِعْلَان, بَلَاغ",
 "披露宴": "اِسْتِقْبَال / اِسْتِقْبَال, حَفْلَة اِسْتِقْبَال",
 "抱え": "حِضن, ملء الذراعين (الكمية التي يمكن احتواؤها بين الذراعين) / مُوَظَّف, مُوَظَّفَة",
 "抱えあげる": "رَفَعَ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ) / رفع (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ) / شال (قطعة مربعة كبيرة من القماش الصوفي يستخدمه الرجال كغطاء للرأس يكون عادة غير منقوش ولا مطرز؛ قطعة مستطيلة أو ممثلثة من القماش سواء كان خفيفا أم سميكا من الصوف أو القطن أو الحرير يكون عادة مطرز أو مشغول تضعه النساء على أكتافها) / مِصْعَد, أَصَنْصِير\nمثال: رفع سامي نظارته.",
 "抱えこむ": "اِحْتَضَنَ, عَانَقَ / اِحْتِضَان, عِنَاق",
 "抱える": "مَلَكَ, اِمْتَلَكَ (لغة في المَالِك، وهو الذي يَمْلِكُ؛ السُلْطَان الحَاكِم الذي يملك الأَرْض والبِلاد) / تَنَاوَلَ (فعل مطاوعة من نَاوَلَ، ناولته فتناول؛ أخذ الشيء الذي ناولته إياه؛ الطعام والدواء: أكَلَه)\nمثال: زيري ملك لنفسه. / وَظَّفَ",
 "抱え上げる": "رَفَعَ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ) / رفع (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ) / شال (قطعة مربعة كبيرة من القماش الصوفي يستخدمه الرجال كغطاء للرأس يكون عادة غير منقوش ولا مطرز؛ قطعة مستطيلة أو ممثلثة من القماش سواء كان خفيفا أم سميكا من الصوف أو القطن أو الحرير يكون عادة مطرز أو مشغول تضعه النساء على أكتافها) / مِصْعَد, أَصَنْصِير\nمثال: رفع سامي نظارته.",
 "抱え主": "رَبّ عَمَل, رَبَّة عَمَل (رَبَّ الولدَ يَرُبُّ رَبًّا: ولِيَه وتعهده بما يغذيه وينميه ويؤدّبه؛ الفاعل: رَابٌّ، والمفعول: مَرْبوبٌ، وربيبٌ)\nمثال: اعتني بي يا رب.",
 "抱え手": "رَبّ عَمَل, رَبَّة عَمَل (رَبَّ الولدَ يَرُبُّ رَبًّا: ولِيَه وتعهده بما يغذيه وينميه ويؤدّبه؛ الفاعل: رَابٌّ، والمفعول: مَرْبوبٌ، وربيبٌ)\nمثال: اعتني بي يا رب.",
 "抱え込む": "اِحْتَضَنَ, عَانَقَ / اِحْتِضَان, عِنَاق",
 "抱きかかえる": "مَسَكَ, مسك",
 "抱きしめる": "اِحْتَضَنَ, عَانَقَ / اِحْتِضَان, عِنَاق",
 "抱きつく": "اِحْتَضَنَ, عَانَقَ / اِحْتِضَان, عِنَاق",
 "抱き付く": "اِحْتَضَنَ, عَانَقَ / اِحْتِضَان, عِنَاق",
 "抱き合せる": "ضَمَّ, جَمَعَ (جَمَعَ، لَمَّ؛ وَصَلَ الشيءَ بالشيءِ)\nمثال: ضم سامي رأس ليلى إلى صدره.",
 "抱き合せ販売": "رابط, وصلة (مثبت يعمل على ضم أو توصيل الأشياء)\nمثال: الجدران متماسكة بروابط معدنية توضع في الملاط الرطب أثناء البناء",
 "抱き合わせ": "رابط, وصلة (مثبت يعمل على ضم أو توصيل الأشياء)\nمثال: الجدران متماسكة بروابط معدنية توضع في الملاط الرطب أثناء البناء",
 "抱き合わせる": "ضَمَّ, جَمَعَ (جَمَعَ، لَمَّ؛ وَصَلَ الشيءَ بالشيءِ)\nمثال: ضم سامي رأس ليلى إلى صدره.",
 "抱き合わせ販売": "رابط, وصلة (مثبت يعمل على ضم أو توصيل الأشياء)\nمثال: الجدران متماسكة بروابط معدنية توضع في الملاط الرطب أثناء البناء",
 "抱き寄せる": "اِحْتَضَنَ, عَانَقَ / اِحْتِضَان, عِنَاق",
 "抱き抱える": "مَسَكَ, مسك",
 "抱き犬": "كلب حضن (كلب صغير وأليف بما يكفي ليحمل في الحضن)",
 "抱き着く": "اِحْتَضَنَ, عَانَقَ / اِحْتِضَان, عِنَاق",
 "抱き締める": "اِحْتَضَنَ, عَانَقَ / اِحْتِضَان, عِنَاق",
 "抱く": "اِحْتَضَنَ, عَانَقَ / اِحْتِضَان, عِنَاق\nمثال: その子供は母親の腕の中に抱かれて安心した。 — أحس الطفل بالأمان بين ذراعي أمه. / مَلَكَ, اِمْتَلَكَ (لغة في المَالِك، وهو الذي يَمْلِكُ؛ السُلْطَان الحَاكِم الذي يملك الأَرْض والبِلاد) / تَنَاوَلَ (فعل مطاوعة من نَاوَلَ، ناولته فتناول؛ أخذ الشيء الذي ناولته إياه؛ الطعام والدواء: أكَلَه)\nمثال: زيري ملك لنفسه. / اِحْتَضَنَ, عَانَقَ / اِحْتِضَان, عِنَاق / حِضْنَة, صغار (صغار حيوان يتم رعايتهم في وقت واحد)",
 "抱っこ": "إبقاء, احتفاظ (فعل الاحتفاظ بشيء ما) / أملاك, مقتنيات (شيء مملوك؛ أي حيازة ملموسة أو غير ملموسة يمتلكها شخص ما)\nمثال: تلك القبعة ملكي",
 "抱主": "رَبّ عَمَل, رَبَّة عَمَل (رَبَّ الولدَ يَرُبُّ رَبًّا: ولِيَه وتعهده بما يغذيه وينميه ويؤدّبه؛ الفاعل: رَابٌّ، والمفعول: مَرْبوبٌ، وربيبٌ)\nمثال: اعتني بي يا رب.",
 "抱卵": "حِضَانَة, تَفْرِيخ",
 "抱合": "تَصْرِيف, تَصْرِيف فِعْل / اِقْتِرَان, تَصْرِيف فِعْل / اِحْتَضَنَ, عَانَقَ / اِحْتِضَان, عِنَاق",
 "抱合せ": "رابط, وصلة (مثبت يعمل على ضم أو توصيل الأشياء)\nمثال: الجدران متماسكة بروابط معدنية توضع في الملاط الرطب أثناء البناء",
 "抱合せる": "ضَمَّ, جَمَعَ (جَمَعَ، لَمَّ؛ وَصَلَ الشيءَ بالشيءِ)\nمثال: ضم سامي رأس ليلى إلى صدره.",
 "抱合せ販売": "رابط, وصلة (مثبت يعمل على ضم أو توصيل الأشياء)\nمثال: الجدران متماسكة بروابط معدنية توضع في الملاط الرطب أثناء البناء",
 "抱合わせる": "ضَمَّ, جَمَعَ (جَمَعَ، لَمَّ؛ وَصَلَ الشيءَ بالشيءِ)\nمثال: ضم سامي رأس ليلى إلى صدره.",
 "抱合体": "مَقْرُون, مُتَرَافِق ((فِي الكِيمِيَاء العُضْوِيَّة) يَحْتَوِي عَلَى رَابِطَتَيْن مُزْدَوِجَتَيْن أَوْ أَكْثَر يَفْصِلُ بَيْنَهُمَا رَابِطَة أُحَادِيَّة) / مُتَّحِد, مُقْتَرِن (مُتَكَوِّن مِنِ اتِّحَاد مُرَكَّبَيْن) / مُقْتَرِن ((عن الوريقة الريشيّة) ذو زوج واحد فقط من الوريقات) / مُزْدَوِج, مُقْتَرِن (مُتَّصل ببعضه خاصة في أزواج)",
 "抱懐": "مَرْفَأ, مَرْسَى",
 "抱手": "رَبّ عَمَل, رَبَّة عَمَل (رَبَّ الولدَ يَرُبُّ رَبًّا: ولِيَه وتعهده بما يغذيه وينميه ويؤدّبه؛ الفاعل: رَابٌّ، والمفعول: مَرْبوبٌ، وربيبٌ)\nمثال: اعتني بي يا رب.",
 "抱擁": "اِحْتَضَنَ, عَانَقَ / اِحْتِضَان, عِنَاق",
 "抱水": "هَايْدْرَات",
 "抱水クロラール": "هيدرات الكلورال (دواء بلوري عديم اللون يستخدم كمهدئ؛ يهيج المعدة ويمكن أن يسبب الإدمان)",
 "抱負": "أَمَل ((أَمَّلَه): أَمَلَهُ يُقَال: فلَان بَحر المؤمل) / رَشْف (رشف الماء أو نحوه: مصه بشفتيه؛ رشف الإناء: شرب ما فيه ولم يترك فيه شيئا) / زَفْر (زفَر الشَّخصُ : أخرج نفَسه من رئتيه بعد مدِّه إيّاه؛ أظهر تعبيرًا عن الحزن أو الألم من خلال تنهد أو صوت عميق)\nمثال: أشعر بخيبة أمل.",
 "抵当": "رَهْن, رَهْن عَقَارِيّ ((رَهَنَ) الشيءُ يَرْهَنُ رهْنًا، ورُهُونا: ثَبَت ودامَ؛ يقال (رَهَنَ) بالمكان: أقامَ)\nمثال: رهن فاضل الحلي.",
 "抵当権": "رَهْن, رَهْن عَقَارِيّ ((رَهَنَ) الشيءُ يَرْهَنُ رهْنًا، ورُهُونا: ثَبَت ودامَ؛ يقال (رَهَنَ) بالمكان: أقامَ)\nمثال: رهن فاضل الحلي.",
 "抵当権者": "حامل الرهن, دائن مرتهن (الشخص الذي يقبل الرهن العقاري)\nمثال: أصبح البنك هو الدائن المرتهن عندما قبل رهن منزلنا الجديد",
 "抵当権設定者": "راهن (الشخص الذي يعطي رهناً عقارياً مقابل المال الذي سيتم سداده)\nمثال: أصبحنا راهنين عندما قبل البنك رهننا وأقرضنا المال لشراء منزلنا الجديد",
 "抵当流れ": "حجز الرهن (الإجراءات القانونية التي يبدأها الدائن لاستعادة الضمان لقرض متخلف عن السداد)",
 "抵当貸付け": "رهن عقاري, قرض عقاري (قرض عقاري عادة ما يكون مضموناً برهن)",
 "抵抗": "مُقَاوَمَة\nمثال: 無駄な抵抗はやめなさい。 — لن تستفيد من المقاومة فلا تحاول. / تثاقل, تردد (درجة معينة من عدم الرغبة) / ممانعة مغناطيسية ((في الفيزياء) ممانعة للفيض المغناطيسي (مناظرة للمقاومة الكهربائية))\nمثال: ممانعة في إلزام نفسه / مُقَاوَمَة / مقاومة (جهاز كهربائي يقاوم تدفق التيار الكهربائي)",
 "抵抗力": "مُقَاوَمَة",
 "抵抗器": "مقاومة (جهاز كهربائي يقاوم تدفق التيار الكهربائي)",
 "抵抗性": "مُقَاوَمَة",
 "抵抗感": "مشاعر مناهضة",
 "抵抗率": "مقاومة, مقاومة كهربائية (ممانعة المادة لتدفق التيار الكهربائي؛ تقاس بالأوم)",
 "抵梧": "تَبَايُن, تَضَارُب (اختلاف بين حقائق أو ادعاءات أو آراء متعارضة) / خلاف, عدم اتفاق (الفعل الكلامي المتمثل في الاختلاف أو الجدال أو النزاع) / تنافر, خلاف (صراع في آراء الناس أو أفعالهم أو طباعهم)\nمثال: تباين متزايد في الآراء",
 "抵牾く": "لَامَ, اِسْتَنْكَرَ (لامَ يَلوم ، لُمْ ، لَوْمًا ، فهو لائم والجمع : لُوَّمٌ ، ولُيَّمٌ وهو أَيضاً لَوَّامٌ ، ولَوَّامةٌ ، ولْوَمةٌ وذاك مَلُومٌ ، ومَلِيمٌ…)\nمثال: لام سامي معلمه على فشله هو. / قَلَّدَ",
 "抵触": "مِسَاس / صِرَاع, نِزَاع / تَصَادُّم, اِصْطِدَام",
 "抹殺": "حذف (حَذَفَ الشّيء:قطعه وأَسْقَطَه. حَذَفَ الْمُرَاجِعُ عِبَارَةً منَ الْخِطَابِ؛ حَذَفَهُ بِالعَصَا: ضَرَبَهُ ، ورَمَاهُ بِها)\nمثال: حذف ياني حسابه. / رَدّ (صَرَفَ، أَرْجَعَ؛ أَعَادَ، أَرْجَعَ. (يتعدى بإلى)) / نَفْي / إِنْكَار, رَفْض\nمثال: اليوم هناك برد. / شطب, محو (الحذف عن طريق الشطب أو المسح) / كشط, محو (منطقة سطح تم محو شيء منها) / شطب, محو (تصحيح يتم عن طريق المسح)\nمثال: تمت كتابة كلمة أخرى فوق المحو",
 "抹消": "شطب, محو (الحذف عن طريق الشطب أو المسح) / كشط, محو (منطقة سطح تم محو شيء منها) / شطب, محو (تصحيح يتم عن طريق المسح)\nمثال: تمت كتابة كلمة أخرى فوق المحو",
 "抹茶": "مَاتْشَا",
 "抹茶アイスクリーム": "شَايْ أَخْضَر (شَجَرَة خَضْرَاء من فَصِيلَة الكَامِيلِيات لها أزْهَار بَيْضَاء، وتُعْطِي أوراقاً يصنع منها شَرَاب مُنَبِّه؛ أوراق الشجرة المجففة)\nمثال: صب الشاي لضيفك.",
 "抹香": "بَخُور (البَخُور : ما يتبخَّر به من عُودٍ ونحوه؛ الدخان أو الرائحة الناتجة من احتراق مادة عطرية) / بُخُور (البَخُور : ما يتبخَّر به من عُودٍ ونحوه؛ الدخان أو الرائحة الناتجة من احتراق مادة عطرية)",
 "抹香鯨": "حُوتُ الْعَنْبَر (سمكة صَغيرة كانت أو كبيرة؛ حوت كبير: صاحب مال وسَطْوَة ونفوذ)\nمثال: هل الحوت من الثدييات؟",
 "押え": "وَزْن / ثِقْل (ثَقَلَ الشيءَ يَثْقُلُه بِيَدِهِ ثَقْلًا: رَازَ ثِقَلَه؛ ثَقَلَ الشَّيْء بِيَدِهِ ثقلا قدّر ثِقْلَه)\nمثال: ان ثقل ما تحمل، فضع بعضا منه. / دِفَاع, حِمَايَة / دِفاع",
 "押える": "غِطَاء / غِلَاف / غَطَّى / حَصَلَ (الشيء: حَصَلَ عليه؛ العلم: أخَذَه وحَازَه)\nمثال: متى حصل الحادث؟ / قَبْضَة / اِحْتِيَاط / ذَخِيرَة / حَجَزَ (حجَزهُ: مَنَعَهُ)\nمثال: حجز مناد موعدا.",
 "押さえ": "وَزْن / ثِقْل (ثَقَلَ الشيءَ يَثْقُلُه بِيَدِهِ ثَقْلًا: رَازَ ثِقَلَه؛ ثَقَلَ الشَّيْء بِيَدِهِ ثقلا قدّر ثِقْلَه)\nمثال: ان ثقل ما تحمل، فضع بعضا منه. / دِفَاع, حِمَايَة / دِفاع",
 "押さえる": "غِطَاء / غِلَاف / غَطَّى / حَصَلَ (الشيء: حَصَلَ عليه؛ العلم: أخَذَه وحَازَه)\nمثال: متى حصل الحادث؟ / قَبْضَة / اِحْتِيَاط / ذَخِيرَة / حَجَزَ (حجَزهُ: مَنَعَهُ)\nمثال: حجز مناد موعدا.",
 "押さえ込み": "تعطيل, شل الحركة (فعل الحد من الحركة أو جعل الشيء غير قادر على الحركة)\nمثال: تسببت العاصفة في شلل تام لفريق الإنقاذ",
 "押さえ込む": "سَيْطَرَ / تَحَكُّم, مُرَاقَبَة (\"تَحَكَّمَ فِي أُمُورِهِ الشَّخْصِيَّةِ\" : ضَبَطَهَا وَأَحْكَمَهَا؛ \"يَتَحَكَّمُ فِي أُمُورِ غَيْرِهِ\" : يَتَصَرَّفُ فِيهَا كَمَا يَشَاءُ وَيُرِيدُ)\nمثال: من أنت لتحكم علي؟",
 "押し": "دَفَعَ, زق (لزّه ونحاه وأبعده؛ صرفه قبل وروده، أي منعه وأبعده قبل مجيئه أو حدوثه، وعكسه أن يرفعه، اي أن يصرفه بعد حدوثه) / دَفْعَة\nمثال: دفع زيري الثمن. / وَزْن / ثِقْل (ثَقَلَ الشيءَ يَثْقُلُه بِيَدِهِ ثَقْلًا: رَازَ ثِقَلَه؛ ثَقَلَ الشَّيْء بِيَدِهِ ثقلا قدّر ثِقْلَه)\nمثال: ان ثقل ما تحمل، فضع بعضا منه. / سُلْطَة (هو طعام يصنع من الخُضَار الطَازَجَة تقطع وتخلط ويضاف إليها المِلْح وقد يضاف عصير اللَيْمُون أو الخَلّ أو الزَيْت. لا يطبخ)\nمثال: هو متعطش للسلطة.",
 "押しあう": "تدافع, زحام (فعل التدافع (شق طريقك عن طريق الدفع))",
 "押しあげる": "تشجيع, دعم (فعل إعطاء الأمل أو الدعم لشخص ما) / دفعة مساعدة, رفع (فعل إعطاء دفعة) / ارتفاع, زيادة (زيادة في التكلفة)\nمثال: ساعدها بدفعة لتجاوز السياج",
 "押しかけ": "غَيْرُ مَدْعُوّ ((عن الشخص) لم تُوجَّه إليه دعوة) / غَيْرُ مَرْغُوب فِيه, لَا إِرَادِيّ ((عن فكرة أو فعل) غير مرحَّب به أو لا إراديّ)",
 "押しかぶせ断層": "صدع الدسر, صدع عكسي (صدع جيولوجي يبدو فيه أن الجانب العلوي قد تم دفعه للأعلى بفعل الضغط)",
 "押しきる": "هَزَمَ, غَلَبَ",
 "押したおす": "صَرَعَ (طَرَحَه على الأرض؛ أَرْدَاهُ قَتِيلاً وأَهْلَكَهُ)",
 "押したてる": "رَفَعَ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ)\nمثال: رفع سامي نظارته. / رَشَّحَ, عَيَّنَ (اقتَرَح شخصًا أو جهةً ليكون مرشَّحًا لمنصب أو مهمة؛ جعَل شيئًا يرشُح أو يُصفّى) / دَفَعَ, زق (لزّه ونحاه وأبعده؛ صرفه قبل وروده، أي منعه وأبعده قبل مجيئه أو حدوثه، وعكسه أن يرفعه، اي أن يصرفه بعد حدوثه) / دَفْعَة\nمثال: دفع زيري الثمن.",
 "押しつけ": "فَرْض",
 "押しつけがましい": "اِنْتِهَازِيّ, مُلِحّ (يتسم بطموح عدواني ونشاط ومبادرة)",
 "押しつつむ": "لِحَاف, بَطَّانِيَّة",
 "押しつぶす": "هَرَسَ (سَحَقَ أو دَكَّ شيئًا بقوة حتى يتفتت؛ طَحَنَ أو فَتَّتَ شيئًا)",
 "押して": "بالإكراه, بالقوة (بطريقة تتضمن استخدام القوة)\nمثال: تذكر مخاطر فرض قيمنا وتحيزاتنا بالقوة / رَغْمَ, بِالرَّغْمِ مِن ((رَغَمَ) رَغْمًا، ومَرْغَمًا، ومَرْغَمَةً: ذَلَّ؛ (رَغَمَ) ذل عن كَرْه. يقال (رغَمَ) أَنْفُه)\nمثال: إنه سعيد رغم فقره.",
 "押していく": "مَشَى, تَمَشَّى (اِنْتَقَلَ من مكان إلى آخر؛ اِنْتَقَلَ من مكان إلى آخر على الأقدام. (تخصيص)) / تمشّى / مَسِير, سِيرَة / مِشْيَة\nمثال: مشى ياني مع سكورا.",
 "押して行く": "مَشَى, تَمَشَّى (اِنْتَقَلَ من مكان إلى آخر؛ اِنْتَقَلَ من مكان إلى آخر على الأقدام. (تخصيص)) / تمشّى / مَسِير, سِيرَة / مِشْيَة\nمثال: مشى ياني مع سكورا.",
 "押しとどめる": "تَفَقُّد / كِشّ مَلِك / فَاتُورَة, حِسَاب / اِسْتَأْنَى, دَقَّقَ ((مُتَعَدٍّ بِالْبَاءِ أَوْ بِـ\"فِي\" أو بِدُونِهِمَا) تَأَنَّى، انْتَظَرَ) / كَشَّ",
 "押しなべて": "بشكل عام, عموماً (دون تمييز واحد عن الآخرين)\nمثال: هو مهتم بالثعابين بشكل عام",
 "押しに弱い": "أمر سهل, لعب أطفال (أي مشروع يسهل القيام به) / سَهْل الاِنْقِياد, ضَعِيف الشَّخْصِيَّة (شخص يسهل استغلاله أو التغلب عليه)\nمثال: تسويق هذا المنتج لن يكون نزهة",
 "押しのけ容積": "إِزَاحَة, نُزُوح / إِزَاحَة",
 "押しの強い": "عُدْوَانِيّ / هُجُومِيّ",
 "押しも押されぬ": "مَقْبُول, مُعْتَرَف بِه (حائز على القبول العامّ أو يفرض الاعتراف) / ذُو سُمْعَة, مُعْتَرَف بِه (يتمتّع بسمعة راسخة ومعترف بها)",
 "押しも押されもしない": "مَقْبُول, مُعْتَرَف بِه (حائز على القبول العامّ أو يفرض الاعتراف) / ذُو سُمْعَة, مُعْتَرَف بِه (يتمتّع بسمعة راسخة ومعترف بها)",
 "押しも押されもせぬ": "مَقْبُول, مُعْتَرَف بِه (حائز على القبول العامّ أو يفرض الاعتراف) / ذُو سُمْعَة, مُعْتَرَف بِه (يتمتّع بسمعة راسخة ومعترف بها)",
 "押しやる": "دفع عنيف (فعل الدفع بقوة (دفع شخص أو شيء))\nمثال: أعطى الباب دفعة قوية",
 "押しピン": "دبوس رسم, دبوس ضغط (دبوس لتثبيت الأوراق على لوحة إعلانات أو لوحة رسم)",
 "押しボタン": "زر, زر ضغط (مفتاح كهربائي يعمل بالضغط)\nمثال: كان المصعد يعمل بأزرار ضغط",
 "押しボタン式": "معبر مشاة محكوم بإشارة (معبر للمشاة مزود بإشارات مرور يتحكم فيها المشاة)",
 "押し上げ": "اِضْطِرَاب",
 "押し上げる": "تشجيع, دعم (فعل إعطاء الأمل أو الدعم لشخص ما) / دفعة مساعدة, رفع (فعل إعطاء دفعة) / ارتفاع, زيادة (زيادة في التكلفة)\nمثال: ساعدها بدفعة لتجاوز السياج",
 "押し上げポンプ": "مضخة ضغط (مضخة تستخدم لدفع السائل لأعلى وطرده تحت الضغط)",
 "押し並べて": "بشكل عام, عموماً (دون تمييز واحد عن الآخرين)\nمثال: هو مهتم بالثعابين بشكل عام",
 "押し付け": "فَرْض",
 "押し付けがましい": "اِنْتِهَازِيّ, مُلِحّ (يتسم بطموح عدواني ونشاط ومبادرة)",
 "押し倒す": "صَرَعَ (طَرَحَه على الأرض؛ أَرْدَاهُ قَتِيلاً وأَهْلَكَهُ)",
 "押し傷": "كَدَمَ / كَدْمَة, رَضّ",
 "押し入り": "لص منازل (لص يدخل مبنى بقصد السرقة)",
 "押し入る": "تَطَفَّلَ, تَدَخَّلَ",
 "押し入れ": "عَرِين, حُجْرَة (اِسْمٌ لِمَاْوَى الأَسَد) / خِزَانَة (مكان الخَزْن؛ قطعة أثاث للخَزْن)\nمثال: اقترب من الخزانة.",
 "押し出し": "بثق, طرد (الإخراج عن طريق تطبيق الضغط) / انتفاخ, بروز (شيء ينتفخ للخارج أو يبرز عن محيطه)\nمثال: خروج غير متوقع لمعجون الأسنان من قاع الأنبوب / حُضُور (حُضُور)\nمثال: الحضور هام جدا.",
 "押し出す": "إبراز ضوئي, منطقة مضيئة (منطقة من السطوع في الصورة) / الجزء الأبرز, علامة مميزة (الجزء الأكثر إثارة للاهتمام أو الذي لا يُنسى)\nمثال: كان الجزء الأبرز في الجولة زيارتنا للفاتيكان",
 "押し切る": "هَزَمَ, غَلَبَ",
 "押し包む": "لِحَاف, بَطَّانِيَّة",
 "押し合い": "تدافع, زحام (فعل التدافع (شق طريقك عن طريق الدفع))",
 "押し合いへし合い": "تدافع, زحام (فعل التدافع (شق طريقك عن طريق الدفع))",
 "押し合い圧し合い": "تدافع, زحام (فعل التدافع (شق طريقك عن طريق الدفع))",
 "押し合う": "تدافع, زحام (فعل التدافع (شق طريقك عن طريق الدفع))",
 "押し売り": "ضَاغِط, عَنِيف الإِقْنَاع (مُقنِع بإلحاح وعدوانية)",
 "押し子": "مِكْبَس غَطَّاس",
 "押し屋": "قطار الركاب اليومي, قطار الضواحي (قطار ركاب يستخدمه في المقام الأول الركاب الذين يسافرون بانتظام (يومياً) من مكان إلى آخر)",
 "押し広げる": "تَوَسَّعَ",
 "押し広める": "نَشَرَ (بَسَطَ، فَرَّقَ، نَشَرَ الشيءَ: جعله منتشراً، مثل نشر الأخبار أو نشر كتاب؛ نَشَرَ: وزع أو عمم شيئًا بين الناس، مثل نشر المقالات) / اِنْتِشَار (مصدر الفعل \"انْتَشَرَ\"؛ (في الفيزياء) عملية توزيع جزيئات أو ذرات أو حبيبات بشكل متساوٍ في فراغ أو في حيز متاح أو تخللها خلال حاجز غشائي)\nمثال: نشر توم الغسيل.",
 "押し引き": "مساومة حادة, مماحكة (حالة من الجدل الشديد (كما في المساومة))",
 "押し戻す": "دحر, رد العدو (فعل إجبار العدو على الانسحاب)",
 "押し手": "فُقْمَة / خَتْم (أنهى الشيءَ وأتمّه؛ طبع بخاتم أو ختم رسميّ)\nمثال: ختم سامي القرآن في شهر رمضان. / شِمَال, يُسْرَى (الْجِهَةُ الْمُقَابِلَةُ لِلجَنُوب؛ رَأْسُ الْبَوْصَلَةِ الْمُقَابِلُ لِلجَنُوب)\nمثال: أعيش في شمال السويد. / عِنَاد",
 "押し掛け": "غَيْرُ مَدْعُوّ ((عن الشخص) لم تُوجَّه إليه دعوة) / غَيْرُ مَرْغُوب فِيه, لَا إِرَادِيّ ((عن فكرة أو فعل) غير مرحَّب به أو لا إراديّ)",
 "押し止める": "تَفَقُّد / كِشّ مَلِك / فَاتُورَة, حِسَاب / اِسْتَأْنَى, دَقَّقَ ((مُتَعَدٍّ بِالْبَاءِ أَوْ بِـ\"فِي\" أو بِدُونِهِمَا) تَأَنَّى، انْتَظَرَ) / كَشَّ",
 "押し殺す": "خنق, مفصل الركبة (المفصل بين عظم الفخذ والساق في ذوات الأربع؛ يقابل الركبة البشرية)",
 "押し潰す": "هَرَسَ (سَحَقَ أو دَكَّ شيئًا بقوة حتى يتفتت؛ طَحَنَ أو فَتَّتَ شيئًا)",
 "押し留める": "تَفَقُّد / كِشّ مَلِك / فَاتُورَة, حِسَاب / اِسْتَأْنَى, دَقَّقَ ((مُتَعَدٍّ بِالْبَاءِ أَوْ بِـ\"فِي\" أو بِدُونِهِمَا) تَأَنَّى، انْتَظَرَ) / كَشَّ",
 "押し目": "ضَعْف",
 "押し立てる": "رَفَعَ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ)\nمثال: رفع سامي نظارته. / رَشَّحَ, عَيَّنَ (اقتَرَح شخصًا أو جهةً ليكون مرشَّحًا لمنصب أو مهمة؛ جعَل شيئًا يرشُح أو يُصفّى) / دَفَعَ, زق (لزّه ونحاه وأبعده؛ صرفه قبل وروده، أي منعه وأبعده قبل مجيئه أو حدوثه، وعكسه أن يرفعه، اي أن يصرفه بعد حدوثه) / دَفْعَة\nمثال: دفع زيري الثمن.",
 "押し紙": "ورق نشاف (ورق ماص يستخدم لتجفيف الحبر)",
 "押し縮める": "عَصَرَ (مصدر للفعل \"عَصَرَ\"؛ أي مدة زمنية، دهر من الوقت)\nمثال: صلى زيري العصر.",
 "押し船": "سفينة قطر, قاطرة (قارب صغير قوي مصمم لسحب أو دفع السفن الأكبر)",
 "押し被せ断層": "صدع الدسر, صدع عكسي (صدع جيولوجي يبدو فيه أن الجانب العلوي قد تم دفعه للأعلى بفعل الضغط)",
 "押し詰める": "حُزْمَة, عُبُوَّة / وَضَّبَ / حَزَمَ (جَمَعَ، رَتَّبَ؛ في اللغة: شدّ الأشياء معًا بشكل محكم)\nمثال: حزم ياني أمتعته.",
 "押し込み": "سَطْو / لُصُوصِيَّة / عَرِين, حُجْرَة (اِسْمٌ لِمَاْوَى الأَسَد) / خِزَانَة (مكان الخَزْن؛ قطعة أثاث للخَزْن)\nمثال: اقترب من الخزانة.",
 "押し込み強盗": "سارق منازل (لص يقتحم ويدخل منزل شخص آخر بشكل غير قانوني) / هادم المنازل (هادم للمنازل)",
 "押し込める": "كَمَّمَ الفَمَ / صَه, اُسْكُت (صَهْ اسم فعل أمر بمعنى اسكتْ، وهو بلفظ واحد للمفرد و الجمع و المذكر و المؤنث; يقال صَهٍ بالتنوين بمعنى اسكت سكوتاً ما في وقتٍ ما)",
 "押し返す": "دحر, رد العدو (فعل إجبار العدو على الانسحاب)",
 "押し迫る": "اِقْتَرَبَ / اِقْتِرَاب, مُقَارَبَة (اقتراب) / كَيْفِيَّة, طَرِيقَة\nمثال: هو واصل الاقتراب مني.",
 "押し通す": "شَغَّلَ, نَفَّذَ ((شَغَلَ) الدارَ يَشْغَلَ شَغْلًا: سكنها؛ شَغَلَ فلانًا عن الشيء: لَهَّاهُ وصرَفَه)\nمثال: شغل بيل التلفاز.",
 "押し遣る": "دفع عنيف (فعل الدفع بقوة (دفع شخص أو شيء))\nمثال: أعطى الباب دفعة قوية",
 "押し釦": "زر, زر ضغط (مفتاح كهربائي يعمل بالضغط)\nمثال: كان المصعد يعمل بأزرار ضغط",
 "押し鉄": "محطة سكة حديد, محطة قطار (محطة طرفية حيث تقوم القطارات بتحميل أو تفريغ الركاب أو البضائع)",
 "押し隠す": "أَخْفَى, خَبَأَ / اِخْتَبَأَ (فعل مطاوعة لأَخْبَأَ، أخبأْتُهُ فأخْتَبَأ؛ خَبَّأ نفسه متعمدًا، أي أخْفَى نفسه عن الناس فلا يعلمون مكانه) / إِهَاب, جِلْد\nمثال: أين اختبأ ياني؟",
 "押し麦": "دقيق الشوفان, شوفان (دقيق مصنوع من الشوفان الملفوف أو المطحون)",
 "押す": "دَفَعَ, زق (لزّه ونحاه وأبعده؛ صرفه قبل وروده، أي منعه وأبعده قبل مجيئه أو حدوثه، وعكسه أن يرفعه، اي أن يصرفه بعد حدوثه) / دَفْعَة\nمثال: دفع زيري الثمن. / آلَةُ طِبَاعَة, آلَةُ الطِّبَاعَة (الفارسية: ماشين؛ الأوردية: مشين) / صِحَافَة, صَحَافَة (هي مهنة من يكتب في الصُحُف والمَجَلات وغيرها من الدَوْريَّات؛ هي مجموعة المؤسسات التي تصدر أو تنشر الصُحُف والمَجَلات وغيرها من الدَوْريَّات) / ضَغَطَ\nمثال: نسى زيري الآلة. / خَتْم (أنهى الشيءَ وأتمّه؛ طبع بخاتم أو ختم رسميّ) / طَابَع\nمثال: ختم سامي القرآن في شهر رمضان. / أَفِكْس",
 "押すな押すな": "مُزْدَحِم",
 "押っ始める": "نَجْمَة, اِبْتِدَاء / نَجْمَة / بَدَأَ (حَدَثَ ونَشَأَ وحَصَلَ؛ أَخَذَ، شَرَعَ)\nمثال: بدأ سامي يتكلم.",
 "押っ放り出す": "نَار, نار (نارَتِ النارُ: أضاءَت؛ نَارَ النَّارَ مَنْ بَعِيدٍ : أَبْصَرَهَا، نَظَرَ إِلَيْهَا، تَأَمَّلَهَا) / حَرِيق, حريجة (النَار المشتعلة في شيء كالدَار او الغَابَة) / طَرَدَ\nمثال: سمعن طلقات نار.",
 "押っ立てる": "رَفَعَ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ)\nمثال: رفع سامي نظارته.",
 "押っ被さる": "غِطَاء / غِلَاف / غَطَّى",
 "押っ被せる": "غِطَاء / غِلَاف / غَطَّى",
 "押なつ": "خَتْم (أنهى الشيءَ وأتمّه؛ طبع بخاتم أو ختم رسميّ) / طَابَع\nمثال: ختم سامي القرآن في شهر رمضان.",
 "押ボタン": "زر, زر ضغط (مفتاح كهربائي يعمل بالضغط)\nمثال: كان المصعد يعمل بأزرار ضغط",
 "押ボタン式": "معبر مشاة محكوم بإشارة (معبر للمشاة مزود بإشارات مرور يتحكم فيها المشاة)",
 "押丁": "حارِس سِجْن, سَجَّان (شخص يحرس السجناء)",
 "押上げ": "اِضْطِرَاب",
 "押上げる": "تشجيع, دعم (فعل إعطاء الأمل أو الدعم لشخص ما) / دفعة مساعدة, رفع (فعل إعطاء دفعة) / ارتفاع, زيادة (زيادة في التكلفة)\nمثال: ساعدها بدفعة لتجاوز السياج",
 "押上げポンプ": "مضخة ضغط (مضخة تستخدم لدفع السائل لأعلى وطرده تحت الضغط)",
 "押下": "كَئِيب, كَنُود (يسبب مشاعر حزينة من الكآبة وعدم الكفاءة)\nمثال: التوقعات الاقتصادية محبطة",
 "押倒す": "صَرَعَ (طَرَحَه على الأرض؛ أَرْدَاهُ قَتِيلاً وأَهْلَكَهُ)",
 "押傷": "كَدَمَ / كَدْمَة, رَضّ",
 "押入": "عَرِين, حُجْرَة (اِسْمٌ لِمَاْوَى الأَسَد) / خِزَانَة (مكان الخَزْن؛ قطعة أثاث للخَزْن)\nمثال: اقترب من الخزانة.",
 "押入り": "لص منازل (لص يدخل مبنى بقصد السرقة)",
 "押入れ": "عَرِين, حُجْرَة (اِسْمٌ لِمَاْوَى الأَسَد) / خِزَانَة (مكان الخَزْن؛ قطعة أثاث للخَزْن)\nمثال: اقترب من الخزانة.",
 "押出し": "بثق, طرد (الإخراج عن طريق تطبيق الضغط) / انتفاخ, بروز (شيء ينتفخ للخارج أو يبرز عن محيطه)\nمثال: خروج غير متوقع لمعجون الأسنان من قاع الأنبوب / حُضُور (حُضُور)\nمثال: الحضور هام جدا.",
 "押出す": "إبراز ضوئي, منطقة مضيئة (منطقة من السطوع في الصورة) / الجزء الأبرز, علامة مميزة (الجزء الأكثر إثارة للاهتمام أو الذي لا يُنسى)\nمثال: كان الجزء الأبرز في الجولة زيارتنا للفاتيكان",
 "押切る": "هَزَمَ, غَلَبَ",
 "押包む": "لِحَاف, بَطَّانِيَّة",
 "押収": "حجز, مصادرة (الاستيلاء على شيء عن طريق الإجراءات القانونية) / أسر, سيطرة (فعل نزع ملكية المالك بالقوة) / أسر, احتجاز (فعل أخذ شخص بالقوة) / نوبة مرضية (حدوث مفاجئ (أو تكرار) لمرض)\nمثال: عانى من نوبة صرع",
 "押合い": "تدافع, زحام (فعل التدافع (شق طريقك عن طريق الدفع))",
 "押合う": "تدافع, زحام (فعل التدافع (شق طريقك عن طريق الدفع))",
 "押売": "ضَاغِط, عَنِيف الإِقْنَاع (مُقنِع بإلحاح وعدوانية)",
 "押売り": "ضَاغِط, عَنِيف الإِقْنَاع (مُقنِع بإلحاح وعدوانية)",
 "押子": "مِكْبَس غَطَّاس",
 "押手": "فُقْمَة / خَتْم (أنهى الشيءَ وأتمّه؛ طبع بخاتم أو ختم رسميّ)\nمثال: ختم سامي القرآن في شهر رمضان. / شِمَال, يُسْرَى (الْجِهَةُ الْمُقَابِلَةُ لِلجَنُوب؛ رَأْسُ الْبَوْصَلَةِ الْمُقَابِلُ لِلجَنُوب)\nمثال: أعيش في شمال السويد. / عِنَاد",
 "押捺": "خَتْم (أنهى الشيءَ وأتمّه؛ طبع بخاتم أو ختم رسميّ) / طَابَع\nمثال: ختم سامي القرآن في شهر رمضان.",
 "押放り出す": "نَار, نار (نارَتِ النارُ: أضاءَت؛ نَارَ النَّارَ مَنْ بَعِيدٍ : أَبْصَرَهَا، نَظَرَ إِلَيْهَا، تَأَمَّلَهَا) / حَرِيق, حريجة (النَار المشتعلة في شيء كالدَار او الغَابَة) / طَرَدَ\nمثال: سمعن طلقات نار.",
 "押立てる": "رَفَعَ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ)\nمثال: رفع سامي نظارته. / رَشَّحَ, عَيَّنَ (اقتَرَح شخصًا أو جهةً ليكون مرشَّحًا لمنصب أو مهمة؛ جعَل شيئًا يرشُح أو يُصفّى) / دَفَعَ, زق (لزّه ونحاه وأبعده؛ صرفه قبل وروده، أي منعه وأبعده قبل مجيئه أو حدوثه، وعكسه أن يرفعه، اي أن يصرفه بعد حدوثه) / دَفْعَة\nمثال: دفع زيري الثمن.",
 "押紙": "ورق نشاف (ورق ماص يستخدم لتجفيف الحبر)",
 "押船": "سفينة قطر, قاطرة (قارب صغير قوي مصمم لسحب أو دفع السفن الأكبر)",
 "押込み": "سَطْو / لُصُوصِيَّة / عَرِين, حُجْرَة (اِسْمٌ لِمَاْوَى الأَسَد) / خِزَانَة (مكان الخَزْن؛ قطعة أثاث للخَزْن)\nمثال: اقترب من الخزانة.",
 "押込み強盗": "سارق منازل (لص يقتحم ويدخل منزل شخص آخر بشكل غير قانوني) / هادم المنازل (هادم للمنازل)",
 "押込める": "كَمَّمَ الفَمَ / صَه, اُسْكُت (صَهْ اسم فعل أمر بمعنى اسكتْ، وهو بلفظ واحد للمفرد و الجمع و المذكر و المؤنث; يقال صَهٍ بالتنوين بمعنى اسكت سكوتاً ما في وقتٍ ما)",
 "押返す": "دحر, رد العدو (فعل إجبار العدو على الانسحاب)",
 "押送": "مُرَافَقَة",
 "押釦": "زر, زر ضغط (مفتاح كهربائي يعمل بالضغط)\nمثال: كان المصعد يعمل بأزرار ضغط",
 "押韻": "مسجوع, مقفى (له أصوات متطابقة خاصة الأصوات النهائية)\nمثال: شعر مقفى",
 "押麦": "دقيق الشوفان, شوفان (دقيق مصنوع من الشوفان الملفوف أو المطحون)",
 "抽だい": "مِصْمَال",
 "抽冬": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "抽出": "استخراج, خلع (عملية إخراج شيء ما (خاصة باستخدام الجهد أو القوة)) / أصل, منشأ (الخصائص المنسوبة لأسلافك) / استخراج, استخلاص (عملية الحصول على شيء من خليط أو مركب بوسائل كيميائية أو فيزيائية أو ميكانيكية)\nمثال: أعطاها طبيب الأسنان تخديراً موضعياً قبل الخلع / اختيار, انتقاء (فعل الاختيار أو الانتقاء) / اختيار, خيار (الشخص أو الشيء الذي تم اختياره أو انتقاؤه) / مختارات, مقتبس (مقطع مختار من عمل أكبر) / تشكيلة مختارة, خيار (مجموعة متنوعة من الأشياء التي يمكن الاختيار منها)\nمثال: كان اختيارك للألوان غير موفق",
 "抽出法": "أخذ عينات, معاينة ((إحصاء) اختيار عينة مناسبة للدراسة) / أخذ العينات (قياس سعة شكل موجة متغير على فترات منتظمة (لتحويلها إلى شكل رقمي)) / توزيع العينة, عينة (عناصر مختارة عشوائياً من مجتمع إحصائي وتستخدم لاختبار الفرضيات حول المجتمع)",
 "抽出物": "مُقْتَطَف / خلاصة",
 "抽挿": "مِدَكّ",
 "抽筒子": "مستخرج الخرطوش (آلية في سلاح ناري تسحب غلاف القذيفة الفارغ من الغرفة وتمرره إلى اللافظ) / جهاز طرد مركزي, فراز (جهاز يستخدم قوة الطرد المركزي لفصل الجزيئات عن المعلق) / أداة استخراج (أداة لاستخراج المكونات المحكمة التثبيت)",
 "抽苔": "مِصْمَال",
 "抽象": "تَجْرِيد, كِيَان مُجَرَّد (مفهوم عامّ يُستخلَص بانتزاع السمات المشتركة من أمثلة محدّدة) / انتزاع, سحب (عملية سحب أو إزالة شيء ما) / لوحة تجريدية (لوحة فنية تجريدية) / انشغال بال, ذهول (الانشغال بشيء ما واستبعاد كل شيء آخر)",
 "抽象主義": "تجريدية, فن تجريدي (نوع تجريدي من الفن؛ يعتمد المحتوى الفني على الشكل الداخلي بدلاً من التمثيل التصويري) / تجريدية, لا واقعية (تمثيل لا يشير إلى كائنات ملموسة أو أمثلة محددة)",
 "抽象化": "تَجْرِيد, كِيَان مُجَرَّد (مفهوم عامّ يُستخلَص بانتزاع السمات المشتركة من أمثلة محدّدة) / انتزاع, سحب (عملية سحب أو إزالة شيء ما) / لوحة تجريدية (لوحة فنية تجريدية) / انشغال بال, ذهول (الانشغال بشيء ما واستبعاد كل شيء آخر)",
 "抽象名詞": "اِسْم مَعْنًى (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)\nمثال: ما اسم حصان توم؟",
 "抽象性": "تَجْرِيد, مَعْنَوِيَّة (صفة النظر إلى الشيء بمعزل عن مثال أو كائن محدد)",
 "抽象概念": "تَجْرِيد, كِيَان مُجَرَّد (مفهوم عامّ يُستخلَص بانتزاع السمات المشتركة من أمثلة محدّدة) / انتزاع, سحب (عملية سحب أو إزالة شيء ما) / لوحة تجريدية (لوحة فنية تجريدية) / انشغال بال, ذهول (الانشغال بشيء ما واستبعاد كل شيء آخر)",
 "抽象的": "مُلَخَّص, حاصِل / مَعْنَوِيّ, تَجْرِيدِيّ",
 "抽象絵画": "تجريدية, فن تجريدي (نوع تجريدي من الفن؛ يعتمد المحتوى الفني على الشكل الداخلي بدلاً من التمثيل التصويري)",
 "抽象美術": "تجريدية, فن تجريدي (نوع تجريدي من الفن؛ يعتمد المحتوى الفني على الشكل الداخلي بدلاً من التمثيل التصويري)",
 "抽象芸術": "تجريدية, فن تجريدي (نوع تجريدي من الفن؛ يعتمد المحتوى الفني على الشكل الداخلي بدلاً من التمثيل التصويري)",
 "抽象表現主義": "تعبيرية تجريدية, رسم حركي (مدرسة رسم في نيويورك تتميز بالتجريدات التي تم إنشاؤها بحرية؛ أول مدرسة مهمة للرسم الأمريكي تتطور بشكل مستقل عن الأساليب الأوروبية)",
 "抽送": "مِدَكّ",
 "抽選": "يَانَصِيب",
 "抽選会": "يَانَصِيب",
 "担い": "حَمَلَ (رَفَعَ، أَقَلَّ)\nمثال: حمل سامي سلاحه.",
 "担い手": "حامل, ناقل (شخص تتضمن وظيفته حمل شيء ما) / حامل (الشخص الذي بحوزته شيك أو كمبيالة أو سند أو وثيقة ملكية مظهرة له أو لمن يحملها) / حامل (رسول يحمل أو يقدم شيئاً) / حامِل النَّعْش (أحد المشيعين الذين يحملون النعش في الجنازة)\nمثال: نُقلت السندات بواسطة حامل / داعم رياضي (داعم للأعضاء التناسلية يرتديه الرجال الذين يمارسون تمارين شاقة) / رباط جورب, مشد (شريط (عادة مطاطي) يرتدى حول الساق لتثبيت الجورب (أو حول الذراع لتثبيت الكم)) / مساعد, معين (شخص يساهم في تلبية حاجة أو تعزيز جهد أو غرض) / داعم, راعٍ (شخص يدعم أو يناصر شيئاً ما)\nمثال: مساعدي الذي لا يقدر بثمن",
 "担う": "كَتِف, كِتْف / دُبّ / دُبَّة / اِحْتَمَلَ",
 "担ぎ": "نَاقِل / مَوْجَة حامِلة / حَامِل, حَمَلَة (اسم فاعل من حَمَلَ، أي الذي يحمل شيئا؛ امرأة حَامِل: حُبْلَى، في بطنها جَنْيِن، وإذا أريد اسم الفاعل يقال للمرأة حَامِلَة)\nمثال: يبدو أنني حامل.",
 "担ぎだす": "رَفَعَ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ)\nمثال: رفع سامي نظارته.",
 "担ぎ上げる": "رَفَعَ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ)\nمثال: رفع سامي نظارته.",
 "担ぎ出す": "رَفَعَ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ)\nمثال: رفع سامي نظارته.",
 "担ぎ屋": "صاحب مقالب, مخادع مازح (شخص يقوم بتدبير المقالب والمزاح العملي ضد الآخرين) / جَوَّال, بَائِع مُتَجَوِّل (صيغة مبالغة على وزن فَعَّال من الفعل جَالَ؛ كثير التجوّل، دائم التنقُّل من مكان لآخر)\nمثال: اشتريت جوال مستعمل.",
 "担ぐ": "كَتِف, كِتْف / خَدَعَ, غَشَّ (غَشَّ، مَكَرَ؛ خَادَعَ شخصًا: خدعه بشكل مستمر أو بطريقة خفية)\nمثال: هذه خدعة قديمة.",
 "担任の先生": "غرفة الصف الرئيسي (فصل دراسي يجتمع فيه جميع الطلاب في صف معين (أو في قسم من صف) في أوقات معينة تحت إشراف معلم يأخذ الحضور ويقوم بأعمال إدارية أخرى)",
 "担体": "نَاقِل / مَوْجَة حامِلة / حَامِل, حَمَلَة (اسم فاعل من حَمَلَ، أي الذي يحمل شيئا؛ امرأة حَامِل: حُبْلَى، في بطنها جَنْيِن، وإذا أريد اسم الفاعل يقال للمرأة حَامِلَة)\nمثال: يبدو أنني حامل.",
 "担保": "أَمْن, أَمَان (وَثِقَ به وأرْكَنَ إليه) / حِمَايَة / ضَمَانَة, كَفَالَة (وَثِيقَةٌ يَضْمَنُ بِهَا شَخْصٌ شَخْصاً آخَرَ فِي غَرَضٍ مِنْ أَغْرَاضِ البَيْعِ وَقَضَايَا التَّعَامُلِ؛ وَثِيقَةٌ يَضْمَنُ بِهَا ٱلْبَائِعُ سَلاَمَةَ الْمَبِيعِ مِنْ كُلِّ عَيْبٍ وَبَقَاءَهُ صَالِحاً لِلاِسْتِعْمَالِ مُدَّةً مُعَيَّنَةً حَسَبَ…)\nمثال: اتصل زيري بالأمن. / ضَمَان, ضَمَانَة (مَصْدَرُ ضَمِنَ؛ كَفَالَة) / ضَمِنَ\nمثال: لا أستطيع ضمان أي شيء.",
 "担保権": "حق الضمان, مصلحة الضمان (أي مصلحة في ممتلكات تضمن سداد التزام)",
 "担保物件": "مُتَرَتِّب, مُصَاحِب (يحدث بالتزامن مع شيء آخر أو نتيجةً له) / جانبي, غير مباشر (منحدر من جد مشترك ولكن عبر خطوط مختلفة) / مُتَجَاوِر, مُتَوَازٍ جَنْبًا إِلَى جَنْب (يَقَعُ أَوْ يَمْتَدُّ جَنْبًا إِلَى جَنْب) / إِضَافِيّ ثَانَوِيّ, مُلْحَق (إضافيّ لكنّه ثانويّ؛ مساعد)\nمثال: أبناء العمومة هم أقارب جانبيون",
 "担保責任": "ضَمَان, ضَمَانَة (مَصْدَرُ ضَمِنَ؛ كَفَالَة) / ضَمَان (مَصْدَرُ ضَمِنَ؛ كَفَالَة)\nمثال: لا أستطيع ضمان أي شيء.",
 "担子器": "دعامة (بنية صغيرة على شكل هراوة تحمل عادةً أربعة أبواغ دعامية في نهايات نتوءات دقيقة؛ تنفرد بها الفطريات الدعامية)",
 "担子菌": "دِعَامِيّ",
 "担子菌類": "دِعَامِيّ",
 "担当大臣": "منصب وزاري, وزير في الحكومة (وظيفة وزير كبير يكون عضواً في مجلس الوزراء) / وزير في الحكومة (شخص عضو في مجلس الوزراء)",
 "担当官": "ضابط حالة (عميل يعمل أيضًا كموظف رسمي في جهاز استخبارات)",
 "担当者": "مُلَامَسَة, لَمْسَة / اِتِّصَال, عَلَاقَة / اِتَّصَلَ",
 "担当部長": "مُدِير, مُدِيرَة (الشخص الذي أدار، جمعه مُدِيرُون ومُدِيرِين؛ مهنة يتولى صاحبها إدَارَة شؤون جهة ما. جمعه مُدَرَاء)\nمثال: زيري هو المدير.",
 "担持": "دَعَمَ, دَعَّمَ (• دَعَمَهُ، كمنَعهُ: مالَ فأقامَهُ) / أَيَّدَ, دَعَمَ ((أَيَّدَه): قوّاه بالإياد) / تَأْيِيد, دَعْم\nمثال: ياني هنا لدعم ريمة.",
 "担架": "نَقَّالَة, مِحَفَّة",
 "担送車": "نَقَّالَة, مِحَفَّة",
 "拇印": "بصمة الإبهام (بصمة إصبع مأخوذة من الإبهام (خاصة من باطن الإبهام))",
 "拇指": "إِبْهَام (الإِصْبَعُ الغليظةُ الخامسةُ من أَصابع اليد والرِّجل، وهي ذات سُلامَيَيْن (مؤنثة وقد تذكَّر) والجمع: أباهيم، وإبهامات)",
 "拇趾": "إبهام القدم (الإصبع الأول الأكبر والأكثر تداخلًا في القدم)",
 "拈くる": "برم, دوران سريع (عملية الدوران بسرعة) / التواء, عقدة (انحناء حاد في خط ناتج عن سحب خط به حلقة بقوة)\nمثال: أدار الكرنك بقوة / تَغَيَّرَƒ / غَيَّرَ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به) / تَغْيِير, تَبْدِيل / فَكَّة / بَاقٍ (باقٍ ، الباقِيٌ جمع باقون ( للعاقل ) وبَواقٍ ، مؤ باقية ، جمع مؤ باقيات وبَواقٍ؛ باقٍ إلَى الأبَدِ : خالِدٌ) / تَغْيِير\nمثال: أنا غير متفاجئ.",
 "拈華微笑": "صَرِيح, مُبَاشِر (صريح ومباشر بلا تحفظ أو مواربة) / حديث من القلب للقلب, مصارحة (حديث حميم على انفراد)\nمثال: أخذني جانباً لحديث من القلب للقلب",
 "拉ぐ": "هَرَسَ (سَحَقَ أو دَكَّ شيئًا بقوة حتى يتفتت؛ طَحَنَ أو فَتَّتَ شيئًا) / اِسْتَبَدَّ (حزم ولم يتردد في اتخاذ القرار وتنفيذه؛ (في السياسة) حكم بنظام استبدادي)",
 "拉致": "اِخْتِطَاف",
 "拉致る": "اِخْتَطَفَ (أخذ شخصا بالغَصْب وقاده إلى مكان وحَبَسَه عن الرجوع)\nمثال: من اختطف دميتري؟ / جَرَّ (جَرَّ الحيوانَ وغيرَه: جذبه وسحبه؛ جَرَّ أذيالَه: تبختر، زها بنفسه، اختال)\nمثال: اضطررت إلى جر سامي.",
 "拉薩": "لَاسَا",
 "拍": "نَبْض / ضَرَبَ, دَقَّ (معروف، وهو اللطم أو الدق أو الصكّ و ما أشبه؛ النَوْع أو الصنف أو المثال) / وَجَفَ / هَزَمَ, غَلَبَ / خَفَقَ (الجذر يعبر عن الحركة والاضطراب الخفيف الذي ينشأ عن الرياح أو القلوب أو الرايات، ويستخدم لوصف الطبيعة والأحاسيس والجوانب الحسية المختلفة؛ عبّر عن حركة سريعة، سواء كانت اضطراباً أو ضرباً خفيفاً أو صوتاً، بالإضافة إلى صفةٍ تُوصف بها الخيل)\nمثال: ضرب سامي زوجته.",
 "拍出": "إخراج, طرد (فعل الطرد أو القذف أو الإخراج) / إخراج, إقصاء (فعل إجبار شخص أو شيء على الخروج)\nمثال: طرد مثيري الشغب من قبل الشرطة",
 "拍動": "نَبْض, نَبْضُ القَلْب",
 "拍子": "وَقْت (\"بَقِيَ وَقْتاً عِنْدَهُ \" : أَيْ مِقْدَاراً مِنَ الزَّمَنِ؛ \"جَاءَ فِي الوَقْتِ الْمُنَاسِبِ \" : فِي اللَّحْظَةِ الْمُنَاسِبَةِ) / مَرَّة, مرة (مؤنث مُرّ، صفة ما كان بها مرارة) / حِين, وَقْت ((حَيَّنَه): جعل لَهُ حينا؛ (حَيَّنَ) الله فلَانا: لم يوفقه للرشاد)\nمثال: حان وقت الذهاب. / نَبْض / ضَرَبَ, دَقَّ (معروف، وهو اللطم أو الدق أو الصكّ و ما أشبه؛ النَوْع أو الصنف أو المثال) / وَجَفَ / هَزَمَ, غَلَبَ / خَفَقَ (الجذر يعبر عن الحركة والاضطراب الخفيف الذي ينشأ عن الرياح أو القلوب أو الرايات، ويستخدم لوصف الطبيعة والأحاسيس والجوانب الحسية المختلفة؛ عبّر عن حركة سريعة، سواء كانت اضطراباً أو ضرباً خفيفاً أو صوتاً، بالإضافة إلى صفةٍ تُوصف بها الخيل)\nمثال: ضرب سامي زوجته. / عَزْم / لَحْظَة, دَقِيقَة",
 "拍子抜け": "انحدار في الأسلوب, هبوط مفاجئ (تغيير من موضوع جاد إلى موضوع مخيب للآمال) / تراجع مخيب, خيبة أمل (تراجع مخيب للآمال بعد ارتفاع سابق)\nمثال: النهاية المخيبة لمهنة رائعة",
 "拍子記号": "الميزان الموسيقي, توقيع الوقت (تدوين موسيقي يشير إلى عدد النبضات في المقياس ونوع النوتة التي تأخذ نبضة)",
 "拍手": "تَصْفِيق",
 "拍手を送る": "صَفَّقَ",
 "拍手喝采": "تَصْفِيق",
 "拍板": "آلة إيقاعية (آلة موسيقية يتم فيها إنتاج الصوت عن طريق ضرب شيء بآخر)",
 "拍節": "نَبْض, نَبْضَة",
 "拍車": "مِهْمَاز / تَسَارُع (عَجَلَة، تزايُد السرعة بالنسبة إلى الزمن في جسم من الأَجسام المتحرِّكة؛ إِسْرَاعٍ وَتَسَابُقٍ فِي الجَرْيِ)\nمثال: تسارع السائق بسيارته.",
 "拍車がかかる": "شَجَّعَ (حفَّز شخصًا أو دعمه لتحقيق هدف أو القيام بعمل؛ بثَّ الحماس أو الثقة في نفس شخص)\nمثال: شجع سامي ليلى لتفعل ذلك.",
 "拍車が掛かる": "شَجَّعَ (حفَّز شخصًا أو دعمه لتحقيق هدف أو القيام بعمل؛ بثَّ الحماس أو الثقة في نفس شخص)\nمثال: شجع سامي ليلى لتفعل ذلك.",
 "拍車をかける": "مِهْمَاز",
 "拍車を掛ける": "مِهْمَاز",
 "拐かす": "اِخْتَطَفَ (أخذ شخصا بالغَصْب وقاده إلى مكان وحَبَسَه عن الرجوع)\nمثال: من اختطف دميتري؟",
 "拐取": "اِخْتِطَاف",
 "拐引": "اِخْتَطَفَ (أخذ شخصا بالغَصْب وقاده إلى مكان وحَبَسَه عن الرجوع)\nمثال: من اختطف دميتري؟",
 "拒ぎ": "دِفَاع, حِمَايَة / دِفاع",
 "拒む": "رَفَضَ (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟ / مَنَعَ (حَرَمَ، ضد أَعْطَى؛ كَفَّ عنه وحَمَاه)\nمثال: تساهم جذور أشجار المنغروف في منع حدوث انجراف التربة.",
 "拒否": "إِنْكَار, رَفْض",
 "拒否る": "رَفَضَ (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟",
 "拒否処分": "رَدّ (صَرَفَ، أَرْجَعَ؛ أَعَادَ، أَرْجَعَ. (يتعدى بإلى)) / نَفْي / إِنْكَار, رَفْض\nمثال: اليوم هناك برد.",
 "拒否反応": "رَفْض, إِبَاء (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟",
 "拒否権": "نَقْضْ (هَدَمَ أو أَبْطَلَ؛ خَالَفَ أو تَرَاجَعَ في الوعد أو العهد)",
 "拒否者": "محتج, معارض (شخص يعارض سياسة راسخة)",
 "拒止": "إِنْكَار, رَفْض",
 "拒絶": "إِنْكَار, رَفْض",
 "拒絶反応": "رَفْض, إِبَاء (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟",
 "拒食症": "قَهَم",
 "拓く": "مَفْتُوح / فَتَحَ (ضد أغْلَقَ وسَدَّ؛ تركه بلا شيء يسده؛ الطريق: جعلها سالكة للطارقين) / فتح (ضد أغْلَقَ وسَدَّ؛ تركه بلا شيء يسده؛ الطريق: جعلها سالكة للطارقين) / حل (للعقدة: ضد عَقْدها؛ للجامد في السائل: إذابته) / اِنْفَتَحَ (فعل مطاوعة لفَتَحَ، فَتَحْتُهُ فانْفَتَح؛ يستخدم عوضا عن المبنى للمجهول فُتِحَ. )\nمثال: فتح الباب آليا.",
 "拓本": "احتكاك, فرك (الجهد المبذول في تحريك جسم فوق آخر مع الضغط) / طبع بالفرك (تمثيل يتكون من نسخة (كما لنقش) مصنوعة بوضع ورقة فوق شيء ما وفركها بالفحم) / احتكاك (المقاومة التي يتم مواجهتها عند تحريك جسم متلامس مع آخر)",
 "拓植": "اِسْتِعْمَار",
 "拓殖": "اِسْتِعْمَار",
 "拗ける": "منحنى",
 "拗じくれる": "منحنى",
 "拗ねる": "بوز, حرد (مزاج أو إظهار للترفع العبوس أو الانسحاب)\nمثال: بقي في المنزل في حالة حرد",
 "拗ね者": "كَلْبِيّ",
 "拗らす": "تَعَقَّدَ, عَقَّدَ",
 "拗らせる": "تَعَقَّدَ, عَقَّدَ",
 "拗れ": "تَعْقِيد / مُضَاعَفَة",
 "拘う": "شَارَكَ, سَاهَمَ",
 "拘らう": "شَارَكَ, سَاهَمَ",
 "拘らず": "رَغْم أَنَّ, رُغْم أَنَّ ((رَغَمَ) رَغْمًا، ومَرْغَمًا، ومَرْغَمَةً: ذَلَّ؛ (رَغَمَ) ذل عن كَرْه. يقال (رغَمَ) أَنْفُه)\nمثال: إنه سعيد رغم فقره. / بِغَضِّ ٱلنَّظَر عَن, دُونَ الاِهْتِمَام بِـ (البُغْض ضدّ الحبّ ، بغَض جَدُّك:كتعس جدّك،ونعِمَ الله بك عيناً وبغَض بعدوّك عيناً؛ بغَضَ فلانٌ الشّيءَ أو الشّخصَ:كَرِهَه ومَقَتَه وأعرض عنه)\nمثال: سأذهب بغض النظر عن مجيئه.",
 "拘り": "هَوَس / تَذَمَّرَ, اِشْتَكَى / شَكَا, اِشْتَكَى (تَأَلَّمَ مِنْ مَرَضٍ أو هَمٍّ وَنَحْوِهِ؛ أَظْهَرَ) / اختصاص, تخصص (مجال العمل الخاص الذي اتخذته كمسار مهني) / خاصية, سمة مميزة (سمة مميزة) / تَخَصُّص, مَوْطِن قُوَّة (ميزة ذات قيمة أو فائدة خاصة)\nمثال: تخصصه هو أمراض الجهاز الهضمي",
 "拘り合う": "شَارَكَ, سَاهَمَ",
 "拘る": "صخب, ضجة (اضطراب نشط وسريع) / مشاجرة تافهة, ملاحاة (شجار حول نقاط تافهة) / إزعاج, جلبة (اضطراب غاضب) / اضطراب, حيرة (حالة من الهياج المثار)\nمثال: لم يرد إثارة جلبة / أَصَرَّ (لواه وشدّه وربطه؛ أَصَرَ الشيءَ: كَسَرَهُ وعَطَفه) / أَلَحَّ\nمثال: أصر على الأفضل. / شَارَكَ, سَاهَمَ / خَصَّ (رمى شيئًا صغيرًا، مثل الحصى، بدقة وبسرعة؛ قذف شيئًا بعيدًا بحركة سريعة) / هَمَّ\nمثال: لخص التقرير في صفحة. / غُصَيْن / عَصًا (ما يتخذ من خَشَب للتوكؤ أو الضرب؛ تطلق مجازا على عَظْم السَاق وعلى اللِسَان) / لَصَّقَ, لَصِقَ\nمثال: لا تمسك العصا من الوسط.",
 "拘わらず": "رَغْم أَنَّ, رُغْم أَنَّ ((رَغَمَ) رَغْمًا، ومَرْغَمًا، ومَرْغَمَةً: ذَلَّ؛ (رَغَمَ) ذل عن كَرْه. يقال (رغَمَ) أَنْفُه)\nمثال: إنه سعيد رغم فقره. / بِغَضِّ ٱلنَّظَر عَن, دُونَ الاِهْتِمَام بِـ (البُغْض ضدّ الحبّ ، بغَض جَدُّك:كتعس جدّك،ونعِمَ الله بك عيناً وبغَض بعدوّك عيناً؛ بغَضَ فلانٌ الشّيءَ أو الشّخصَ:كَرِهَه ومَقَتَه وأعرض عنه)\nمثال: سأذهب بغض النظر عن مجيئه.",
 "拘わる": "صخب, ضجة (اضطراب نشط وسريع) / مشاجرة تافهة, ملاحاة (شجار حول نقاط تافهة) / إزعاج, جلبة (اضطراب غاضب) / اضطراب, حيرة (حالة من الهياج المثار)\nمثال: لم يرد إثارة جلبة / أَصَرَّ (لواه وشدّه وربطه؛ أَصَرَ الشيءَ: كَسَرَهُ وعَطَفه) / أَلَحَّ\nمثال: أصر على الأفضل.",
 "拘引": "تَوْقِيف, اِعْتِقَال / اِعْتَقَلَ, قَبَضَ (أمسك الأطراف وربطها، بمعنى عَقَلَ؛ أمسك ووضع في السجن أو المَعْقَل)\nمثال: اعتقل لقيادته و هو سكران.",
 "拘引状": "اِسْتِدْعَاء (دَعْوَةً؛ طَلَب الْمُثُولِ)\nمثال: أراد توم استدعاء الشرطة، ولكن ماري لم تسمح له.",
 "拘束": "تَقْيِيد, اِقْتِصَار / قَيْد",
 "拘束具": "سبت, سلة بغطاء (سلة عادة ما يكون لها غطاء) / صفد, قيد (قيد يحد أو يقيد الحرية (خاصة شيء يستخدم لربط أو تقييد سجين))",
 "拘束名簿式比例代表制": "تَمْثِيل نِسْبِيّ (تمثيل جميع الأحزاب بما يتناسب مع تصويتهم الشعبي)",
 "拘束衣": "سترة تقييد, قميص المجانين (رداء يشبه السترة يستخدم لربط الذراعين بإحكام ضد الجسم كوسيلة لتقييد شخص عنيف) / قميص المجانين, قيد صارم (أي شيء غير مادي يعيق أو يقيد بشدة)\nمثال: انشقوا لأن الرقص الروسي كان في قيد صارم",
 "拘留": "حَبْس (مَنَعَ الشيءَ عن الفعلِ؛ أَمْسَكَ الشيءَ، قَبَضَ عَلَيْهِ) / حِرَاسَة نَظَرِيَّة\nمثال: هو,البارحة حرر من الحبس.",
 "拘禁": "تَوْقِيف",
 "拘禁刑": "حَبْس, سَجْن (مَنَعَ الشيءَ عن الفعلِ؛ أَمْسَكَ الشيءَ، قَبَضَ عَلَيْهِ)\nمثال: هو,البارحة حرر من الحبس.",
 "拘禁者": "أسير, أسيرة (اَلْأَسِيرُ هُوَ مَنْ أُسِرَ فِي مَعْرَكَةٍ حَيّّا فَسُجِنَ إِلَى حِينٍ؛ الأَسيرُ: الأَخِيذُ)\nمثال: أنا بريء وأسير حرب.",
 "拘縮": "تقلص (انقباض غير طبيعي ودائم عادة للعضلة)",
 "拘置": "تَوْقِيف",
 "拘置所": "سِجْن (وضع شخصًا أو شيئًا في السجن أو الحبس؛ قيّد حرية شخص أو حركة شيء)\nمثال: دخل سامي السجن.",
 "拙": "فَقِير / مِسْكِين / فُقَرَاء / أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى.",
 "拙い": "لَا أَخْلَاقِيّ, وَضِيع (غَيْرُ أَخْلَاقِيٍّ أَوْ غَيْرُ نَزِيه) / رَدِيء الصُّنْع, مُبْتَذَل (مصنوع بحرفية ومواد رديئة) / صوف مُعاد (ألياف صوف مستصلحة) / رَدِيء, مُتَخَبِّط (منفَّذ بشكل سيّئ ورديء) / سَيِّئُ الطَّالِع, مَنْحُوس (يَتَّسِمُ بِسُوءِ الحَظِّ أَوْ يُنْذِرُ بِهِ) / سيء الحظ, نحس (لديه أو يجلب سوء الحظ)\nمثال: الجمعة الثالث عشر تاريخ منحوس",
 "拙劣": "أَخْرَق",
 "拙悪": "فَقِير / مِسْكِين / فُقَرَاء",
 "拙技": "مَهَارَة",
 "拙策": "خِطَّة, خُطَّة / خَطَّطَ (وضع خطة مُحكَمة لتحقيق هدف معين؛ رسم خطوط أو تقسيم مساحة بخطوط) / نَوَى, بلاني\nمثال: خطط زيري لهجومه.",
 "拙者": "أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى.",
 "拙著": "قَلِيلًا",
 "拙速": "عَمَلِيّ, فَعَّالٌ وَإِنْ بَسِيط (بسيط لكنّه فعّال للغرض المطلوب)",
 "拙速主義": "عَمَلِيّ, فَعَّالٌ وَإِنْ بَسِيط (بسيط لكنّه فعّال للغرض المطلوب)",
 "招き": "دَعْوَة, عزيمة / إِغْرَاء",
 "招きよせる": "أَشَارَ, أَوْمَأَ",
 "招き寄せる": "أَشَارَ, أَوْمَأَ",
 "招く": "دَعَا, عَزَمَ (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه)\nمثال: دعا ثلاميذه الاثني عشر / أَشَارَ, أَوْمَأَ / يَسْتَحْضِر, يَسْتَدْعِي / قَضِيَّة (الأمر أو الشيء المُعَقَّد؛ في : ما يقضي فيه القاضي) / سَبَّبَ ((سَبَّبَه): أَكثر سَبَّه؛ (سَبَّبَ) الأسبَاب: أوجدها)\nمثال: سأرفع عليك قضية.",
 "招じる": "دَعَا, عَزَمَ (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه)\nمثال: دعا ثلاميذه الاثني عشر",
 "招ずる": "دَعَا, عَزَمَ (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه)\nمثال: دعا ثلاميذه الاثني عشر",
 "招募": "تجنيد عام, نفير عام (فعل التجنيد في الخدمة العسكرية) / جباية, رسم مفروض (رسم يفرض ويحصل)",
 "招宴": "وَلِيمَة, مَأْدُبَة (طعام العُرْس؛ أي طعام صنع لدعوة ولجمع كبير من الناس)\nمثال: كانت الوليمة من أطيب ما ذقت.",
 "招待": "دَعْوَة, عزيمة / إِغْرَاء",
 "招待客": "ضيف, مدعو (زائر تقدم له الضيافة)",
 "招待状": "دَعْوَة, عزيمة / إِغْرَاء",
 "招来": "دَعْوَة, عزيمة / إِغْرَاء / إحداث, تسبيب (فعل التسبب في حدوث شيء ما)",
 "招福": "تميمة الحظ, جالب للحظ (شيء يُعتقد أنه يجلب الحظ السعيد)",
 "招聘": "دَعْوَة, عزيمة / إِغْرَاء",
 "招致": "دَعْوَة, عزيمة / إِغْرَاء",
 "招請": "دَعْوَة, عزيمة / إِغْرَاء",
 "招集": "دَعَا, نَادَى (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه) / اِتَّصَلَ بِـ / دَعَا, سَمَّى (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه) / اِتِّصَال, مُكَالَمَة / زِيَارَة\nمثال: دعا ثلاميذه الاثني عشر",
 "拜見": "بَصِير, مُبْصِر (بَصير؛ بَصُرَ: (فعل) بصُرَ / بصُرَ بـ يَبصُر ، بَصَرًا و بَصارَةً ، فهو بَصير ، والمفعول مبصور به) / رُؤْيَة\nمثال: パスポートを拝見できますか。 — هل لي أن أرى جواز سفرك؟",
 "拝": "عِبَادَة / عَبَدَ, سَجَدَ (خلاف الحُرّ، المَمْلُوْك، من له مالك يملكه. الجمع عبيد وأعبد وعِبدان وعُبدان؛ الإنسان حرا كان أم لا مؤمنا كان أن ملحدا من حيث أنه مملوك لله) / سَجَدَ (وَضَعَ جَبْهَتَهُ عَلَى ٱلْأَرْضِ)\nمثال: ماذا أنجز عبد العزيز بوتفليقة؟",
 "拝す": "قَوْس, قوس / اَنْشُوطَة, فيونكة / اِنْحَنَى / اِنْحَنَى لِلتَّحِيَّة, اِنْحَنَى / اِنْحِنَاءَة, اِلْتِوَاءَة / قَيْدُوم / اِسْتَقْبَلَ, اِسْتَلَمَ (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه) / اِسْتَقْبَلَ, يَسْتَقْبِل (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه)\nمثال: استقبل توم الضيوف. / رَأَى (أدرك أو لاحظ شيئًا أو شخصًا بالعينين؛ اعْتَقَدَ، تَأَمَّلَ) / عَايَنَ / شاف\nمثال: رأى ياني منزلا.",
 "拝する": "قَوْس, قوس / اَنْشُوطَة, فيونكة / اِنْحَنَى / اِنْحَنَى لِلتَّحِيَّة, اِنْحَنَى / اِنْحِنَاءَة, اِلْتِوَاءَة / قَيْدُوم / اِسْتَقْبَلَ, اِسْتَلَمَ (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه) / اِسْتَقْبَلَ, يَسْتَقْبِل (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه)\nمثال: استقبل توم الضيوف. / رَأَى (أدرك أو لاحظ شيئًا أو شخصًا بالعينين؛ اعْتَقَدَ، تَأَمَّلَ) / عَايَنَ / شاف\nمثال: رأى ياني منزلا.",
 "拝み倒す": "اِسْتَجْدَى, تَسَوَّلَ / تَسَوَّلَ, رَجَا / بيك",
 "拝む": "اِسْتَجْدَى, تَسَوَّلَ / تَسَوَّلَ, رَجَا / بيك / رَأَى (أدرك أو لاحظ شيئًا أو شخصًا بالعينين؛ اعْتَقَدَ، تَأَمَّلَ) / عَايَنَ / شاف\nمثال: رأى ياني منزلا.",
 "拝一神教": "تفريد العبادة (عبادة إله واحد دون الادعاء بأنه الإله الوحيد الموجود)",
 "拝伏": "سُجُود",
 "拝借": "استعارة, اقتباس (الاستيلاء (على الأفكار أو الكلمات، إلخ) من مصدر آخر) / اقتراض (الحصول على أموال من مقرض)\nمثال: كان اقتباس الزخارف القديمة واضحاً جداً",
 "拝受": "اِسْتَقْبَلَ, اِسْتَلَمَ (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه) / اِسْتَقْبَلَ, يَسْتَقْبِل (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه)\nمثال: استقبل توم الضيوف.",
 "拝呈": "حَالِيّ, حَاضِر / مَوْجُود, حَاضِر (الذي له وجود) / الزَّمَان, الْحَال / قَدَّمَ, طَرَحَ (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى الرُّسْغَ؛ أنّ لهم سابقةً وفضلاً له عند فلان قَدَمٌ : معروف)\nمثال: أنا موجود لوحدي / عَزِيز, عَزِيْزَة (القوي المنيع، ضد الذليل؛ القليل النادر العالي القيمة) / غَالِي, غَالِيَّة\nمثال: هذه رسالة من شخص عزيز.",
 "拝啓": "عَزِيز, عَزِيْزَة (القوي المنيع، ضد الذليل؛ القليل النادر العالي القيمة) / غَالِي, غَالِيَّة\nمثال: هذه رسالة من شخص عزيز.",
 "拝察": "افْتِرَاض, تَخْمِين (رسالة تعبر عن رأي يستند إلى أدلة غير كاملة)",
 "拝廊": "رواق الكنيسة, نارثكس (دهليز يؤدي إلى صحن الكنيسة) / الرواق الخارجي, رواق الكنيسة (رواق عند الطرف الغربي للكنيسة أو البازيليكا المسيحية المبكرة)",
 "拝所": "مَعْبَد",
 "拝承": "سَمِيع (سَميع: (اسم)؛ سميع: (اسم)) / سَمْع (أَدْرَكَ الصوت بأذنه؛ أَصْغَى، أَنْصَتَ. (يتعدى باللام وإلى)) / جَلْسَة\nمثال: سمع سامي صريرا.",
 "拝火教": "زرادشتِيَّة",
 "拝火教徒": "زَرَادُشْتِيّ, زَرَادَشْتِيّ",
 "拝物愛": "صنمية جنسية, فيتيشية (الإثارة الجنسية أو الإشباع الناتج عن التعامل مع صنم (أو جزء معين من الجسم غير الأعضاء التناسلية)) / تقديس الأشياء, فيتيشية (الاعتقاد بالقوة السحرية للأشياء المادية (أو عبادة التمائم))",
 "拝物教": "صنمية جنسية, فيتيشية (الإثارة الجنسية أو الإشباع الناتج عن التعامل مع صنم (أو جزء معين من الجسم غير الأعضاء التناسلية)) / تقديس الأشياء, فيتيشية (الاعتقاد بالقوة السحرية للأشياء المادية (أو عبادة التمائم))",
 "拝礼": "عِبَادَة / عَبَدَ, سَجَدَ (خلاف الحُرّ، المَمْلُوْك، من له مالك يملكه. الجمع عبيد وأعبد وعِبدان وعُبدان؛ الإنسان حرا كان أم لا مؤمنا كان أن ملحدا من حيث أنه مملوك لله) / سَجَدَ (وَضَعَ جَبْهَتَهُ عَلَى ٱلْأَرْضِ)\nمثال: ماذا أنجز عبد العزيز بوتفليقة؟",
 "拝答": "أَجَابَ, رَدَّ (رَدَّ على سُؤالٍ أو طلبٍ؛ أَمْتَثَلَ لِمُطَالَبَةٍ أو دعوةٍ) / إِجَابَة, جَوَاب\nمثال: أجاب ياني فورا.",
 "拝聞": "سَمِع (أَدْرَكَ الصوت بأذنه؛ أَصْغَى، أَنْصَتَ. (يتعدى باللام وإلى))\nمثال: سمع سامي صريرا.",
 "拝藤": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "拝見": "بَصِير, مُبْصِر (بَصير؛ بَصُرَ: (فعل) بصُرَ / بصُرَ بـ يَبصُر ، بَصَرًا و بَصارَةً ، فهو بَصير ، والمفعول مبصور به) / رُؤْيَة\nمثال: パスポートを拝見できますか。 — هل لي أن أرى جواز سفرك؟",
 "拝観": "رَأَى (أدرك أو لاحظ شيئًا أو شخصًا بالعينين؛ اعْتَقَدَ، تَأَمَّلَ) / عَايَنَ / شاف\nمثال: رأى ياني منزلا.",
 "拝観料": "تذكرة الدخول, رسم الدخول (الرسم المفروض للدخول)",
 "拝観者": "زَائِر / زَائِر, سَائِح",
 "拝読": "قِرَاءَة",
 "拝謁": "جُمْهُور, نَظَّارَة",
 "拝賀": "مُبَارَك, مَبْرُوك",
 "拝趨": "زَارَ (زيارة شخص ما، عادة لفترة قصيرة)",
 "拝辞": "اِسْتَقَالَ",
 "拝送": "مُرَافَقَة / إرسال, بعث (فعل التسبب في ذهاب شيء ما (خاصة الرسائل))",
 "拝領": "اِسْتَقْبَلَ, اِسْتَلَمَ (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه) / اِسْتَقْبَلَ, يَسْتَقْبِل (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه)\nمثال: استقبل توم الضيوف.",
 "拝顔": "اِجْتِمَاع, مَجْلِس (جمعوا انفسهم؛ اسم يطلق على عملية جَمْع بعض الناس في مكان واحد ليتباحثوا أمرا) / مُلَاقَاة, مُقَابَلَة (لِقَاء) / مُلَاقَاة, لِقَاء (لِقَاء)\nمثال: هذا اجتماع مهم.",
 "拠": "باحة, ساحة (الأرض المسيجة المحيطة بمنزل أو مبنى آخر) / أساس, بينة (أساس الاعتقاد أو عدم التصديق؛ المعرفة التي يبنى عليها الاعتقاد) / سبب, مبرر (مبرر لوجود أو حدوث شيء ما) / أرض, ساحة (قطعة أرض تم تنظيفها لأغراض خاصة (مثل الترفيه أو الدفن إلخ))\nمثال: كان منزلاً صغيراً بلا فناء تقريباً / دَعَمَ, دَعَّمَ (• دَعَمَهُ، كمنَعهُ: مالَ فأقامَهُ) / أَيَّدَ, دَعَمَ ((أَيَّدَه): قوّاه بالإياد) / تَأْيِيد, دَعْم\nمثال: ياني هنا لدعم ريمة.",
 "拠った": "مَاضٍ, الْمَاضِي ((في النحو) زمن نحوي يدل على حدث قد وقع، أو وُجِد قبل الآن بوقت ما)",
 "拠り所": "باحة, ساحة (الأرض المسيجة المحيطة بمنزل أو مبنى آخر) / أساس, بينة (أساس الاعتقاد أو عدم التصديق؛ المعرفة التي يبنى عليها الاعتقاد) / سبب, مبرر (مبرر لوجود أو حدوث شيء ما) / أرض, ساحة (قطعة أرض تم تنظيفها لأغراض خاصة (مثل الترفيه أو الدفن إلخ))\nمثال: كان منزلاً صغيراً بلا فناء تقريباً / دَعَمَ, دَعَّمَ (• دَعَمَهُ، كمنَعهُ: مالَ فأقامَهُ) / أَيَّدَ, دَعَمَ ((أَيَّدَه): قوّاه بالإياد) / تَأْيِيد, دَعْم\nمثال: ياني هنا لدعم ريمة.",
 "拠出金": "مُسَاهَمَة (المُساهَمَة : المُشاركة والاشتراك في الشيء)\nمثال: ويستطيع الجميع المساهمة.",
 "拠守": "دِفَاع, حِمَايَة / دِفاع",
 "拠点": "قَاعِدَة / قَاعِدَة, مَرْكَز / يُبْنَى عَلَى, يَسْتَنِدُ إِلَى / شائع / منخفض, فاسق / دنيء",
 "拠金": "اِشْتِرَاك",
 "拡がり": "نَشَرَ (بَسَطَ، فَرَّقَ، نَشَرَ الشيءَ: جعله منتشراً، مثل نشر الأخبار أو نشر كتاب؛ نَشَرَ: وزع أو عمم شيئًا بين الناس، مثل نشر المقالات) / اِنْتِشَار (مصدر الفعل \"انْتَشَرَ\"؛ (في الفيزياء) عملية توزيع جزيئات أو ذرات أو حبيبات بشكل متساوٍ في فراغ أو في حيز متاح أو تخللها خلال حاجز غشائي)\nمثال: نشر توم الغسيل.",
 "拡がる": "نَشَرَ (بَسَطَ، فَرَّقَ، نَشَرَ الشيءَ: جعله منتشراً، مثل نشر الأخبار أو نشر كتاب؛ نَشَرَ: وزع أو عمم شيئًا بين الناس، مثل نشر المقالات) / اِنْتِشَار (مصدر الفعل \"انْتَشَرَ\"؛ (في الفيزياء) عملية توزيع جزيئات أو ذرات أو حبيبات بشكل متساوٍ في فراغ أو في حيز متاح أو تخللها خلال حاجز غشائي)\nمثال: نشر توم الغسيل.",
 "拡げる": "نَشَرَ (بَسَطَ، فَرَّقَ، نَشَرَ الشيءَ: جعله منتشراً، مثل نشر الأخبار أو نشر كتاب؛ نَشَرَ: وزع أو عمم شيئًا بين الناس، مثل نشر المقالات) / اِنْتِشَار (مصدر الفعل \"انْتَشَرَ\"؛ (في الفيزياء) عملية توزيع جزيئات أو ذرات أو حبيبات بشكل متساوٍ في فراغ أو في حيز متاح أو تخللها خلال حاجز غشائي)\nمثال: نشر توم الغسيل. / مَفْتُوح / فَتَحَ (ضد أغْلَقَ وسَدَّ؛ تركه بلا شيء يسده؛ الطريق: جعلها سالكة للطارقين) / فتح (ضد أغْلَقَ وسَدَّ؛ تركه بلا شيء يسده؛ الطريق: جعلها سالكة للطارقين) / حل (للعقدة: ضد عَقْدها؛ للجامد في السائل: إذابته) / اِنْفَتَحَ (فعل مطاوعة لفَتَحَ، فَتَحْتُهُ فانْفَتَح؛ يستخدم عوضا عن المبنى للمجهول فُتِحَ. )\nمثال: فتح الباب آليا.",
 "拡充": "تَمَدُّد / تَوَسُّع",
 "拡声器": "مُكَبِّر صَوْت, بُوق",
 "拡声機": "مُكَبِّر صَوْت, بُوق",
 "拡声装置": "مكبرات صوت عامة, نظام مخاطبة الجمهور (نظام تضخيم إلكتروني يستخدم كنظام اتصال في الأماكن العامة)",
 "拡声設備": "مكبر صوت (محول كهروصوتي يحول الإشارات الكهربائية إلى أصوات عالية بما يكفي لسماعها من مسافة بعيدة)",
 "拡大": "تَمَدُّد / تَوَسُّع / تكبير (عملية توسيع شيء ما في الحجم الظاهري) / تكبير, صورة مكبرة (مطبوعة فوتوغرافية تم تكبيرها) / تهويل, مبالغة (جعل الشيء يبدو أكثر أهمية مما هو عليه في الواقع) / تَكْبِير (نسبة حجم الصورة إلى حجم الشيء) / تَصْعِيد",
 "拡大家族": "أسرة ممتدة (أسرة تتكون من الأسرة النووية وأقاربهم بالدم)",
 "拡大推計": "استقراء خارجي, تنبؤ استقرائي (استدلال حول المستقبل (أو حول موقف افتراضي) بناءً على حقائق وملاحظات معروفة) / إقحام خارجي, استقراء ((رياضيات) حساب قيمة دالة خارج نطاق القيم المعروفة)",
 "拡大管": "ناشر ضوء (جهاز بصري يوزع ضوء المصباح بالتساوي) / ناشر الصوت (حاجز يوزع الموجات الصوتية بالتساوي)",
 "拡大縮小": "تسلق (الصعود بواسطة سلم أو ما شابه) / تدريج, قياس (فعل القياس أو الترتيب أو التعديل وفقًا لمقياس) / تدرج, تصنيف (فعل الترتيب في سلسلة متدرجة)",
 "拡大解釈": "تفسير واسع, نشاط قضائي (تفسير للدستور الأمريكي يرى أن روح العصر واحتياجات الأمة يمكن أن تؤثر بشكل مشروع على القرارات القضائية)",
 "拡大鏡": "عَدَسَةٌ مُكَبِّرَة",
 "拡幅": "توسيع (عملية جعل الشيء أوسع) / توسعة جانبية, مفسح (جزء من الطريق تم توسيعه للسماح للسيارات بالمرور أو التوقف) / تعريض, توسيع (زيادة في العرض)",
 "拡張": "تَمَدُّد / تَوَسُّع / هَرَبَ (الفِرارُ) / فِرَار, هُرُوب\nمثال: هرب كأرنب خائف.",
 "拡張スロット": "شق, فتحة ((حاسوب) مقبس في الحاسوب المصغر يقبل لوحة دوائر إضافية)\nمثال: يحتوي الحاسوب على ثلاث فتحات لذاكرة إضافية",
 "拡張化": "تَوْسِيع",
 "拡張可能": "قابل للامتداد, قابل للتمدد (قادر على أن يبرز أو يتمدد أو ينبسط)\nمثال: لسان قابل للامتداد",
 "拡張家族": "أسرة ممتدة (أسرة تتكون من الأسرة النووية وأقاربهم بالدم)",
 "拡張性": "قَابِلِيَّة التَّوَسُّع, قَابِلِيَّة القِيَاس (صفة القابلية للتوسع أو تغيير الحجم)",
 "拡張期": "اِنْبِسَاط (أَرَى على وَجْهِهِ انْبِسَاطاً : اِنْشِراحاً؛ اِنْبِسَاطُ الذِّراعَيْنِ: اِمْتِدادُهُما قابِلِيَّةُ التَّمَدُّدِ وَالاِنْبِساطِ)",
 "拡張機能": "تَمَدُّد / تَوَسُّع",
 "拡張現実": "الواقع المعزز",
 "拡張部分": "تَمْدِيد",
 "拡散": "انتشار, نشر (عملية الامتداد على نطاق أوسع أو مساحة من المكان أو الزمان) / إذاعة, نشر (فتح موضوع لمناقشة واسعة وجدل) / انتشار, تفشي (عملية أو نتيجة التوزيع أو الامتداد على مساحة واسعة من الفضاء) / اِنْتِشَار (مصدر الفعل \"انْتَشَرَ\"؛ (في الفيزياء) عملية توزيع جزيئات أو ذرات أو حبيبات بشكل متساوٍ في فراغ أو في حيز متاح أو تخللها خلال حاجز غشائي)\nمثال: تساهم في انتشار الجهل والتضليل.",
 "拡散ポンプ": "مضخة انتشار, مضخة تكثيف (مضخة تفريغ تستخدم للحصول على فراغ عالي)",
 "拡散率": "هيالورونيداز (إنزيم يحلل حمض الهيالورونيك وبالتالي يقلل من لزوجته ويزيد من نفاذية النسيج الضام وامتصاص السوائل)",
 "括り": "عُقْدَة / عَقَدَ (العَشْر من السَنَوَات؛ الاتِّفَاق والعَهْد بين طرفين)\nمثال: أمضى زيري العقد. / إِبَالَة, حُزْمَة / نَتِيجَة",
 "括りつける": "تَعَادُل (تَسَاوَى؛ تَمَاثَلَ) / رَبَطَ, أَسَرَ (رَبَطَ الشيءَ يَرَبُطَ رَبْطًا: شَدَّهُ. فهو مربوط، ورَبيط؛ يقال: رَبَطَ نفسَه عن كذا: منعها)\nمثال: انتهت المباراة بالتعادل.",
 "括り付ける": "تَعَادُل (تَسَاوَى؛ تَمَاثَلَ) / رَبَطَ, أَسَرَ (رَبَطَ الشيءَ يَرَبُطَ رَبْطًا: شَدَّهُ. فهو مربوط، ورَبيط؛ يقال: رَبَطَ نفسَه عن كذا: منعها)\nمثال: انتهت المباراة بالتعادل.",
 "括る": "رَبَطَ (رَبَطَ الشيءَ يَرَبُطَ رَبْطًا: شَدَّهُ. فهو مربوط، ورَبيط؛ يقال: رَبَطَ نفسَه عن كذا: منعها)\nمثال: ربط يديه و قدميه. / عَلِقَ, عِلِق / عَلَّقَ, عَلَّق / شَنَقَ, شَنَق (قتله بربط حبل حول رقبته وإسقاطه)\nمثال: شنق زيري نفسه فوق شجرة. / لَخَّصَ, اِخْتَصَرَ / تثمين, تقدير (حكم على صفات شيء أو شخص ما) / تخمين, تقدير (حساب تقريبي للكمية أو الدرجة أو القيمة) / تقدير (الاحترام الذي يحظى به شخص ما) / تثمين, تقدير (وثيقة تقدر قيمة شيء ما (مثل التأمين أو الضرائب))\nمثال: في تقديري الصبي بريء",
 "括れ": "انقباض, تضيق (فعل أو عملية الضغط) / انقباض, ضيق (شعور بالضيق في جزء من الجسم) / تضيق, تضييق (ضغط ضيق أو محكم) / تضييق, عنق زجاجة (تضييق يقلل التدفق عبر قناة)\nمثال: شعر بانقباض في صدرها / خَصْر, وَسَط (خصره خصرا ضرب خاصرته)",
 "括れる": "شَدَّ, ضَيَّقَ",
 "括弧": "شَرِيحَة",
 "括弧つき": "مَا يُسَمَّى (انظر مَا)\nمثال: هلا! ما الجديد؟ / شَرِيحَة",
 "括弧付き": "مَا يُسَمَّى (انظر مَا)\nمثال: هلا! ما الجديد؟ / شَرِيحَة",
 "括弧内": "شَرِيحَة",
