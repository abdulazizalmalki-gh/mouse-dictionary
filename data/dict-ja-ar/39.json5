 "機能": "وَظِيفَة (ما يُقَدَّر من الشيء في زمن مُعَيَّن؛ مَنْصِب) / مَهَمَّة / دَالَّة, تَابِع / وَظِيفَة, دَالَّة (ما يُقَدَّر من الشيء في زمن مُعَيَّن؛ مَنْصِب)\nمثال: ما وظيفة زوجتك؟",
 "機能不全": "خلل وظيفي, قصور وظيفي (أي اضطراب في أداء عضو أو جزء من الجسم، أو اضطراب في عمل مجموعة اجتماعية)\nمثال: ضعف الانتصاب",
 "機能主義": "وظيفية (أي مذهب يركز على المنفعة أو الغرض) / وظيفية (علم نفس يقوم على افتراض أن جميع العمليات العقلية مفيدة للكائن الحي في التكيف مع البيئة)",
 "機能単一化文法": "جو خانق ((عامية بريطانية) جو كريه الرائحة ودخاني وعديم الهواء)",
 "機能性": "عَمَلِيَّة, وَظِيفِيَّة (القدرة على خدمة غرض ما بشكل جيد)\nمثال: برمجيات ذات وظيفية أكبر",
 "機能拡張": "تَمْدِيد",
 "機能的": "عملي, وظيفي (مصمم لـ أو قادر على أداء وظيفة أو استخدام معين) / شَغَّال, عَامِل ((عَنِ الآلَات مَثَلًا) يَعْمَلُ أَوْ قَادِر عَلَى العَمَل) / وظيفي (يتعلق بالوظيفة أو يؤثر عليها بدلاً من علم وظائف الأعضاء (الفسيولوجيا)) / وَظِيفِيّ (مصمم لوظيفة معينة أو مكيَّف لاستخدام محدد)\nمثال: أسلوب في الكتابة تكون فيه كل كلمة وظيفية",
 "機能語": "كَلِمَة وَظِيفِيَّة (الكلِمَةُ : اللفظةُ الدَّالةُ على معنًى مُفْرَد بالوضع، وتكون؛ الكلِمَةُ: الكلامُ المؤلَّفُ المطوَّل، قصيدةً، أَو خُطْبَةً، أَو مقالةً، أَو رسالة)\nمثال: كلمة السر طويلة.",
 "機能障害": "اضطراب وظيفي (اضطراب يظهر أعراضاً لا يمكن تحديد سبب فسيولوجي أو تشريحي لها)",
 "機転": "سرعة بديهة, سرعة ذهنية (الذكاء كما يكشف عنه القدرة على تقديم إجابات صحيحة دون تأخير)",
 "機軸": "مِحْوَر",
 "機運": "فُرْصَة / رَائِج, مُتَدَاوَل / يَرُوج, يُتَدَاوَل",
 "機銃": "رَشَاش, مِتْرالِيُوز (أي آلَة تَرُش المَاء؛ المِدْفَع الرَشَّاش: هو بين المِدْفَع والرَشَّاشَة لا يُحمَل باليد ويثبت على الأرض إلا أنه يَرُشّ الرصاص كالرشاشة)\nمثال: إني أطلق النار برشاش روسي.",
 "機鋒": "جُلّ, مُعْظَم",
 "機長": "طَيَّار, قُبْطَان (اسم فاعل للمبالغة على وزن فَعَّال؛ الذي يقود الطَائِرَة سواء كانت مهنته أم لا) / نَقِيب, قُبْطَان / قَائِد, كَبْتِن\nمثال: لم توجه أبدا تهمة القيادة غير المسؤولة للطيار.",
 "機関": "مُحَرِّك, مُوتُور (اسم فاعل من حَرَّكَ؛ اسم آلة)\nمثال: المحرك لا يعمل. / فَاعِلِيَّة / وِكَالَة / وَكَالَة / دَائِرَة (في : الشكل الهندسي الذي ليس له نقطة بداية ولا نهاية ويتكون من قَوْس مستمر؛ الهيئة أو الجهة التي تدير امرا ما)\nمثال: رجاء ضع دائرة حول الجواب الصحيح. / نِظَام (مَنْهَج، طَرِيقَة؛ تَرْتِيب واتِّسَاق) / جِهَاز\nمثال: ليس بنظام كامل.",
 "機関人形": "آلَة ذَاتِيَّة تَشْغِيل, أُوتُومَاتُون (الفارسية: ماشين؛ الأوردية: مشين)\nمثال: نسى زيري الآلة.",
 "機関士": "مُهَنْدِس, مُهَنْدِسَة (الذي يمارس مهنة الهَنْدَسَة)\nمثال: أبي مهندس مدني.",
 "機関室": "غرفة المحرك (غرفة (كما في السفينة) يوجد فيها المحرك)",
 "機関手": "سائق قطار, مهندس قطار (مشغل قاطرة السكك الحديدية)",
 "機関紙": "بيان, موجز (تقرير موجز (خاصة بيان رسمي يصدر للنشر أو البث الفوري))",
 "機関誌": "بيان, موجز (تقرير موجز (خاصة بيان رسمي يصدر للنشر أو البث الفوري))",
 "機関車": "قَاطِرَة",
 "機関銃": "رَشَاش, مِتْرالِيُوز (أي آلَة تَرُش المَاء؛ المِدْفَع الرَشَّاش: هو بين المِدْفَع والرَشَّاشَة لا يُحمَل باليد ويثبت على الأرض إلا أنه يَرُشّ الرصاص كالرشاشة)\nمثال: إني أطلق النار برشاش روسي.",
 "機雷": "لِي, لي / مَنْجَم, لَغَم / لَغْم, لَغَم / لَغَمَ",
 "機雷原": "حَقْلُ أَلْغَام (ذهب أو حدث بسرعة أو دون توقف؛ في بعض اللهجات: تعني تحرك سريعاً أو اهتزّ)\nمثال: يعمل الفلاحون في الحقل.",
 "機首": "أَنْف, خَشَم (أنف:اشْتَكَى أَنفه فَهُوَ مأنوف؛ أنف الشَّيْء: حدد طرفه)\nمثال: أنت لديك أنف كبير.",
 "橡": "بَلُّوط, بَلُّوطَة",
 "橡の実": "كَسْتَنَاء / أَشْقَر (هو لون الشُقْرَة، وأصله اللون الأحمر المائل إلى الصُفرة ثم أصبح يطلق على ما كان لونه أصفر أيضا؛ صفة ما كان لونه الشُقرة)\nمثال: أنا لديها شعر بني كستنائي, ولكن ماجدالينا لديها شعر أشقر.",
 "橿": "بلوط هولم, سنديان أخضر (بلوط دائم الخضرة من جنوب أوروبا له أوراق تشبه إلى حد ما أوراق البهشية؛ ينتج خشباً صلباً)",
 "檀家": "أبناء الرعية (عضو في رعية)",
 "檀林": "دَيْر (بيت يسكنه الرُهْبَان أو الرَاهِبَات ممن كان على دين المسيحية)\nمثال: سيداتي و سادتي ، رجاء قفوا للنشيد الوطني للاتحاد الروسي باداء جوقة دير سرتينسكي .",
 "檄": "اِلْتِمَاس, اِسْتِئْنَاف / اِسْتَأْنَفَ / تشجيع, دعم (فعل إعطاء الأمل أو الدعم لشخص ما) / تشجيع (التعبير عن الموافقة والدعم) / تشجيع (الشعور بالتشجيع)",
 "檄を飛ばす": "دَعْوَة / تَجَمُّع, مُظَاهَرَة (صيغة مطاوعة من جَمَّعَ، جَمَّعته فتجمّع؛ جُمِّعَ لوحده بدون أن يُجَمِّعه أحد)\nمثال: هي تجمع الحواسيب.",
 "檄文": "بَيَان (ما يتبيَّن به الشيء من الدلالة والفصاحة وغيرها، وقيل هو الإفصاح مع ذكاء؛ كل شيء كُشف لك وبان عليك، وقيل هو الكشف والتوضيح بمعنى الإثبات بالدليل)\nمثال: وأوضح البيان ذاته، أن الوزارة وجهت تعليمات من أجل تسخير كافة الإمكانيات البشرية والمادية للتسريع من وتيرة سير العملية.",
 "檐": "طُنْف",
 "檜扇": "زنبق التوت, زنبق النمر (نبات حديقة تكشف كبسولته عند النضج عن كتلة من البذور تشبه التوت الأسود) / زنبق الصنوبر, زنبق النمر (زنبق من جنوب شرق الولايات المتحدة له زهور كأسية الشكل ببتلات منحنية صفراء عميقة إلى قرمزية) / زنبق النمر (زنبق من غرب الولايات المتحدة له زهور برتقالية حمراء إلى قرمزية منقطة بالمارون)",
 "檜舞台": "ضوء الكلس (مصباح يتكون من لهب موجه إلى أسطوانة من الجير مع عدسة لتركيز الضوء؛ كان يستخدم سابقاً لإضاءة المسرح) / أضواء الشهرة, محط الأنظار (بؤرة اهتمام الجمهور)\nمثال: استمتع بكونه تحت الأضواء",
 "檝": "دَفَّة, سُكَّان / سُكَّان, دَفَّة",
 "檣": "صَارٍ (انتقل من حال إلى أخرى. (فعل ناقص))\nمثال: صار \"توم\" منعزلا تماما.",
 "檣楼": "قِمَّة",
 "檣頭": "رأس الصاري, قمة الصاري (رأس أو قمة الصاري) / ترويسة (عنوان صحيفة أو مجلة؛ عادة ما يُطبع على الصفحة الأولى وعلى الصفحة الافتتاحية) / ترويسة (قائمة مطبوعة في جميع أعداد صحيفة أو مجلة (عادة في الصفحة الافتتاحية) تعطي اسم المنشور وأسماء هيئة التحرير، إلخ)",
 "檳榔": "فوفل, نخيل التنبول (نخيل من جنوب شرق آسيا يحمل مكسرات التنبول (فاكهة قرمزية أو برتقالية وحيدة البذرة بقشرة ليفية)) / فَوْفَل",
 "檳榔子": "جوز الأريكا, جوز التنبول (بذرة نخيل التنبول؛ تمضغ مع أوراق فلفل التنبول والجير كمنشط هضمي ومخدر في جنوب شرق آسيا) / فَوْفَل",
 "檳榔樹": "فوفل, نخيل التنبول (نخيل من جنوب شرق آسيا يحمل مكسرات التنبول (فاكهة قرمزية أو برتقالية وحيدة البذرة بقشرة ليفية)) / فَوْفَل",
 "檻": "قَفَص",
 "櫂": "مِضْرَب / جَدَّفَ (معنى الفعل في سياقات متعددة تتراوح بين الطيران والسير، وحتى في الدلالات المجازية كالرمي والقطع؛ الفعل له معانٍ متعددة: رمي (كالسماء بالبرد)، الإسراع في المشي، كفر بالنعم وعدم الرضا بها، ودفع السفينة بالمجاديف)",
 "櫃": "خَزِينَة / كُمُودِينُو, أَدْرَاجِيَّة / صَدْر (الأمر: حدث ووقع وتقرّر؛ عن المكان: رجع وانصرف)\nمثال: تلقى ياني طلقة في الصدر.",
 "櫓": "برج حربي, برج مدفع (منصة أسلحة مستقلة تحتوي على مدافع وقابلة للدوران) / برج صغير, بريج (برج صغير يمتد فوق مبنى) / سِقَالَات, سِقَالَة / قَلْعَة, حِصْن (المرة الواحدة من القَلْع؛ حِصْن منيع غالبا يبنى على تلّ أو جبل أو مكان عالٍ منيع)\nمثال: هو يعيش في قلعة.",
 "櫛": "مُشْط (سرح الشعر باستخدام مشط؛ نظف أو مرر شيئًا باستخدام مشط أو أداة مشابهة) / مِشْط (سرح الشعر باستخدام مشط؛ نظف أو مرر شيئًا باستخدام مشط أو أداة مشابهة) / مِمْشَط / مشط (سرح الشعر باستخدام مشط؛ نظف أو مرر شيئًا باستخدام مشط أو أداة مشابهة) / مُشط (سرح الشعر باستخدام مشط؛ نظف أو مرر شيئًا باستخدام مشط أو أداة مشابهة) / مشطة / مَشَطَ, مَشَّطَ (سرح الشعر باستخدام مشط؛ نظف أو مرر شيئًا باستخدام مشط أو أداة مشابهة)\nمثال: مشط شعرك قبل أن تخرج.",
 "櫛比": "بِطَانَة",
 "櫛水母": "مشطيات, هلاميات مشطية (حيوانات بحرية خنثوية متناظرة ثنائياً تشبه قناديل البحر ولها ثمانية صفوف من الأهداب مرتبة مثل أسنان المشط للحركة)",
 "櫛水母類": "مشطيات, هلاميات مشطية (حيوانات بحرية خنثوية متناظرة ثنائياً تشبه قناديل البحر ولها ثمانية صفوف من الأهداب مرتبة مثل أسنان المشط للحركة)",
 "櫛溝": "زِعْنِفَة (أشواك عظمية مغطاة بالجلد أو أشعة تبرز من جسم السمكة، يستعملها السمك في التوزان وللاندفاع إلى الأمام)",
 "櫛目": "تسريح, تمشيط (فعل تمرير المشط خلال الشعر)\nمثال: كان شعره بحاجة إلى تمشيط",
 "櫛鰓": "خيشوم مشطي (هيكل تنفسي يشبه المشط يعمل كخيشوم لبعض الرخويات)",
 "櫟": "طقسوس ياباني (شجيرة دائمة الخضرة قوية من الصين واليابان لها أوراق خضراء داكنة لامعة؛ تزرع في شرق الولايات المتحدة)",
 "櫨蝋": "شمع نباتي (مادة شمعية يتم الحصول عليها من النباتات (خاصة من جذوع بعض أنواع النخيل))",
 "櫺子": "شبكة خشبية (هيكل يتكون من تصميم زخرفي مصنوع من شرائط من الخشب أو المعدن)",
 "欄": "قِسْم, جُزْء (فَرَّقَ أو قَسَّمَ الشَّيءَ إلى أجزاء أو أجزاء مختلفة؛ أَحْلَفَ، أَي جَعَلَ يَحْلِفُ على أمرٍ ما) / مَقْطَع\nمثال: أنا أزين القسم. / حَقْل (ذهب أو حدث بسرعة أو دون توقف؛ في بعض اللهجات: تعني تحرك سريعاً أو اهتزّ) / سَاحَة, سَاحَة الْمَعْرَكَة / مَجَال\nمثال: يعمل الفلاحون في الحقل. / دَرَابْزُون",
 "欄外": "هَامِش",
 "欄干": "درابزين, سياج (حاجز يتكون من قضيب أفقي ودعامات) / سياج, مادة الدرابزين (مادة لصنع القضبان أو الحواجز بشكل جماعي) / بتألق, بسطوع\nمثال: تألقت النجوم بسطوع / إِلى مَا لَا نِهَايَة, بِلَا نِهَايَة (الاستمرار للأبد دون توقف) / بِلَا انْقِطَاع, بِلَا تَوَقُّف (بعزيمة لا تكل) / إِلَى مَا لَا نِهَايَة (طوال الوقت؛ يبدو بلا توقف) / إلى ما لا نهاية, بلا نهاية ((بالمعنى المكاني) يبدو أنه ليس له حدود)\nمثال: هناك احتمالات لا حصر لها",
 "欄杆": "درابزين, سياج (حاجز يتكون من قضيب أفقي ودعامات) / سياج, مادة الدرابزين (مادة لصنع القضبان أو الحواجز بشكل جماعي)",
 "欄檻": "درابزين, سياج (حاجز يتكون من قضيب أفقي ودعامات) / سياج, مادة الدرابزين (مادة لصنع القضبان أو الحواجز بشكل جماعي)",
 "欄間": "رافدة, عارضة النافذة (قطعة عرضية أفقية عبر نافذة أو تفصل باباً عن نافذة فوقه) / نافذة العارضة (نافذة فوق الباب تكون عادة مفصلية بعارضة أفقية فوق الباب)",
 "欙": "حذاء ثلجي (جهاز يساعدك على المشي فوق الثلج العميق؛ إطار خفيف الوزن يشبه المضرب مقوى بقطع عرضية ويحتوي على شبكة من السيور؛ يلبس واحد في كل قدم)",
 "欛柄": "مَقْبَض / نُقْطَة (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه) / مَوْقِع (موضع الوُقُوع؛ الموضع الذي حَدَثَ أو يحدث فيه حادث) / أَشَارَ\nمثال: هذه هي نقطة ضعفه.",
 "欝": "مُنْخَفَض / زَاخِر, فَيَّاض (يُنتَج أو ينمو بوَفْرة بالغة) / أَبِيقُورِيّ, مُتَرَفّ (يعرض الترف ويُمتِّع الحواسّ) / مُتَقَن, مُفَصَّل (يتميز بتعقيد وثراء في التفاصيل)",
 "欝蒼": "سَمِيك, غَلِيظ / غَلِيظ",
 "欝血": "اِحْتِقَان",
 "欝金": "كُرْكُم",
 "欠": "نَقْص, عَدَم وُجُود / غِيَاب",
 "欠かさず": "بِجِدّ",
 "欠かす": "أَخْطَأَ ((أخْطَأَ): خَطِئَ؛ (أخْطَأَ) غَلِظَ (حاد عن الصواب)) / فَاتَ / اِفْتَقَدَ, اِشْتَاقَ / آنِسَة\nمثال: اعترف أنه أخطأ. / اِسْتَغْنَى",
 "欠かせない": "حَتْمِيّ, لَا مَفَرَّ مِنْه (لا يمكن تجنّبه أو الاستغناء عنه) / ضروري, لا غنى عنه (لا يمكن الاستغناء عنه؛ أساسي) / جَوْهَرِيّ, لَا غِنَى عَنْه (ضروري حتمًا؛ لازم لزومًا حيويًّا)\nمثال: أطعمة لا غنى عنها للتغذية الجيدة",
 "欠く": "تفتيت, شطف (عملية شطف جزء من شيء ما) / شيب, ضربة قصيرة منخفضة ((غولف) ضربة اقتراب منخفضة ومتدحرجة) / رقاقة, رقاقة دقيقة (معدات إلكترونية تتكون من بلورة صغيرة من شبه موصل السيليكون مصنعة لتنفيذ عدد من الوظائف الإلكترونية في دائرة متكاملة) / رقاقة بوكر, فيشة (عداد صغير على شكل قرص يستخدم لتمثيل المال عند المقامرة) / نَقْص, عَدَم وُجُود",
 "欠くことができない": "حَتْمِيّ, لَا مَفَرَّ مِنْه (لا يمكن تجنّبه أو الاستغناء عنه) / ضروري, لا غنى عنه (لا يمكن الاستغناء عنه؛ أساسي) / جَوْهَرِيّ, لَا غِنَى عَنْه (ضروري حتمًا؛ لازم لزومًا حيويًّا)\nمثال: أطعمة لا غنى عنها للتغذية الجيدة",
 "欠くことのできない": "حَتْمِيّ, لَا مَفَرَّ مِنْه (لا يمكن تجنّبه أو الاستغناء عنه) / ضروري, لا غنى عنه (لا يمكن الاستغناء عنه؛ أساسي) / جَوْهَرِيّ, لَا غِنَى عَنْه (ضروري حتمًا؛ لازم لزومًا حيويًّا)\nمثال: أطعمة لا غنى عنها للتغذية الجيدة",
 "欠くべからざる": "حَتْمِيّ, لَا مَفَرَّ مِنْه (لا يمكن تجنّبه أو الاستغناء عنه) / ضروري, لا غنى عنه (لا يمكن الاستغناء عنه؛ أساسي) / جَوْهَرِيّ, لَا غِنَى عَنْه (ضروري حتمًا؛ لازم لزومًا حيويًّا)\nمثال: أطعمة لا غنى عنها للتغذية الجيدة",
 "欠け": "قِطْعَة, شَقَفَة (القِطْعَةُ: الْجُزْءَ أو الحِصَّة من الشيءِ؛ القِطْعَةُ: فقرة قصيرة عادة من مقالٍ أو كتاب)\nمثال: يصنع قطعة أثاث خشبية. / انحسار, تضاؤل (انخفاض تدريجي (في الحجم أو القوة أو السلطة أو العدد))",
 "欠けら": "قِطْعَة, شَقَفَة (القِطْعَةُ: الْجُزْءَ أو الحِصَّة من الشيءِ؛ القِطْعَةُ: فقرة قصيرة عادة من مقالٍ أو كتاب)\nمثال: يصنع قطعة أثاث خشبية. / أُوقِيَّة / وِقِيَّة / أَوْنْس / أونصة / أونسة",
 "欠ける": "تفتيت, شطف (عملية شطف جزء من شيء ما) / شيب, ضربة قصيرة منخفضة ((غولف) ضربة اقتراب منخفضة ومتدحرجة) / رقاقة, رقاقة دقيقة (معدات إلكترونية تتكون من بلورة صغيرة من شبه موصل السيليكون مصنعة لتنفيذ عدد من الوظائف الإلكترونية في دائرة متكاملة) / رقاقة بوكر, فيشة (عداد صغير على شكل قرص يستخدم لتمثيل المال عند المقامرة) / انحسار, تضاؤل (انخفاض تدريجي (في الحجم أو القوة أو السلطة أو العدد))",
 "欠け目": "تفتيت, شطف (عملية شطف جزء من شيء ما) / شيب, ضربة قصيرة منخفضة ((غولف) ضربة اقتراب منخفضة ومتدحرجة) / رقاقة, رقاقة دقيقة (معدات إلكترونية تتكون من بلورة صغيرة من شبه موصل السيليكون مصنعة لتنفيذ عدد من الوظائف الإلكترونية في دائرة متكاملة) / رقاقة بوكر, فيشة (عداد صغير على شكل قرص يستخدم لتمثيل المال عند المقامرة)",
 "欠け眼": "تفتيت, شطف (عملية شطف جزء من شيء ما) / شيب, ضربة قصيرة منخفضة ((غولف) ضربة اقتراب منخفضة ومتدحرجة) / رقاقة, رقاقة دقيقة (معدات إلكترونية تتكون من بلورة صغيرة من شبه موصل السيليكون مصنعة لتنفيذ عدد من الوظائف الإلكترونية في دائرة متكاملة) / رقاقة بوكر, فيشة (عداد صغير على شكل قرص يستخدم لتمثيل المال عند المقامرة)",
 "欠乏": "عدم كفاية, قصور (الافتقار إلى كمية أو عدد كافٍ) / افتقار, عجز (حالة الحاجة إلى شيء غائب أو غير متاح)\nمثال: عدم كفاية إعانات البطالة",
 "欠乏症": "مرض عوزي (أي مرض يسببه نقص المغذيات الأساسية (مثل الفيتامينات أو المعادن))",
 "欠伸": "تَثَاءَبَ / تَثَاؤُب",
 "欠勤": "غِيَاب",
 "欠勤率": "مُعَدَّل الغِيَاب (النسبة المئوية للعمال الذين لا يحضرون للعمل)",
 "欠勤者": "غائب (شخص غائب أو غير مقيم)",
 "欠員": "شَاغِر, وَظِيفَة شَاغِرَة / غُرْفَة شَاغِرَة (اسم مفعول لما غُرِفَ من الماء وغيره باليد، الجمع غِرَاف؛ اسم؛ المكان في الدار أو المبنى محاط بأربع جدران وسقف، حُجْرَة، عِلِّيَّة. الجمع وغُرَف وغُرُفَات) / حَيِّز\nمثال: الأب في الغرفة.",
 "欠唇": "شفة أرنبية, شفة مشقوقة (شق خلقي في منتصف الشفة العليا)",
 "欠場": "غِيَاب",
 "欠失": "عدم كفاية, قصور (الافتقار إلى كمية أو عدد كافٍ) / افتقار, عجز (حالة الحاجة إلى شيء غائب أو غير متاح)\nمثال: عدم كفاية إعانات البطالة / حذف, شطب (عملية حذف شيء مكتوب أو مطبوع) / استئصال, حذف (الإسقاط الذي يحدث عندما يختصر التغيير التحريري مقطعاً مكتوباً) / حذف ((في علم الوراثة) فقدان أو غياب نيوكليوتيد واحد أو أكثر من الكروموسوم) / حذف (أي عملية يتم فيها ترك أصوات أو كلمات من الكلمات أو العبارات المنطوقة)\nمثال: حذوفات المحرر كثيراً ما تزعج المؤلفين الشباب",
 "欠如": "نَقْص, عَدَم وُجُود",
 "欠席": "غِيَاب",
 "欠席者": "غائب (شخص غائب أو غير مقيم)",
 "欠席裁判": "حكم غيابي (حكم يصدر لصالح المدعي عندما يتخلف المدعى عليه (يفشل في المثول أمام المحكمة))",
 "欠所": "انقطاع, توقف (فعل تأخير أو قطع الاستمرارية) / شق, فجوة (فتحة ضيقة) / فَارِق, فَجْوَة (تفاوت أو اختلاف واضح كما بين رقمين) / فجوة, هوة (اختلاف (خاصة اختلاف مؤسف) بين رأيين أو وجهتي نظر أو موقفين)\nمثال: تم عرضه بدون فواصل إعلانية",
 "欠指": "انعدام الأصابع (تشوه خلقي ينطوي على غياب بعض أصابع اليدين أو القدمين)",
 "欠損": "عَجْز",
 "欠損金": "عَجْز",
 "欠文": "جَوْبَة",
 "欠望": "خَيْبَة أَمَل",
 "欠格": "رَفْض, إِبَاء (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟",
 "欠測": "مَفْقُود",
 "欠点": "خَطَأ (تعني ضدّ الصواب. يشمل ذلك الفعل، القول، والرأي. يُستخدم الفعل \"أخطأ\" للدلالة على عدم الإصابة…؛ قام بعمل بعيد عن الصواب أو مخالف للحق سواء كان ذلك في السلوك أو القول أو الكتابة) / صَدْع, فَالِق ((صَدَعَ) النباتُ الأرضَ يَصْدَعَ صَدْعًا: شَقَّها وظَهَرَ منها؛ (صَدَعَ) الزجاجَ ونحوه: كسره)\nمثال: كان خطأ حاسوبي. / فَشَل, قُصُور (فَشَلَ الطالبُ في الامتحان: لم ينجح في الاختبار ولم يحقق النتيجة المطلوبة؛ فَشَلَ الشيءُ: انهار أو انكسر أو توقف عن العمل) / فَشَل (فَشَلَ الطالبُ في الامتحان: لم ينجح في الاختبار ولم يحقق النتيجة المطلوبة؛ فَشَلَ الشيءُ: انهار أو انكسر أو توقف عن العمل) / عُطْل (أوقف أو جعل شيء غير فعال لفترة معينة؛ إيقاف شيء عن العمل أو تركه بدون استخدام أو اهتمام)\nمثال: فشل ياني مجددا.",
 "欠片": "قِطْعَة, شَقَفَة (القِطْعَةُ: الْجُزْءَ أو الحِصَّة من الشيءِ؛ القِطْعَةُ: فقرة قصيرة عادة من مقالٍ أو كتاب)\nمثال: يصنع قطعة أثاث خشبية. / أُوقِيَّة / وِقِيَّة / أَوْنْس / أونصة / أونسة",
 "欠目": "تفتيت, شطف (عملية شطف جزء من شيء ما) / شيب, ضربة قصيرة منخفضة ((غولف) ضربة اقتراب منخفضة ومتدحرجة) / رقاقة, رقاقة دقيقة (معدات إلكترونية تتكون من بلورة صغيرة من شبه موصل السيليكون مصنعة لتنفيذ عدد من الوظائف الإلكترونية في دائرة متكاملة) / رقاقة بوكر, فيشة (عداد صغير على شكل قرص يستخدم لتمثيل المال عند المقامرة)",
 "欠神発作": "غيبة, نوبة غياب (حدوث فقدان مفاجئ وعابر أو ضعف في الوعي (لا يتم تذكره لاحقاً)، أحياناً مع ارتعاش خفيف أو رفرفة الجفون، وما إلى ذلك؛ شائع في الصرع الصغير)",
 "欠缺": "جَوْبَة",
 "欠航": "إلغاء (فعل الإلغاء؛ إلغاء ترتيب ما) / إبطال, إلغاء (الفعل الكلامي للإلغاء أو الفسخ أو الإبطال)",
 "欠落": "نَقْص, عَدَم وُجُود",
 "欠除": "تنحية, عزل (الفصل من منصب رسمي) / إزالة, نزع (عملية الإزالة)\nمثال: أجرى عملية جراحية لإزالة ورم خبيث / شَهْوَة",
 "欠陥": "خَلَل, عَيْب (أدخل شيئًا بين آخر؛ جعل شيئًا يتخلل شيئًا آخر)",
 "次": "قَادِم / تَالٍ ((تَالَ): عالَجَ التِّوَلةَ: (السِّحْر)؛ (تَالَ) بِه: دُهِيَ ومُنِيَ) / بِجَانِب (بجانب)\nمثال: زيري بجانب الحوض. / مَرْحَلَة / مُنَصَّة, مَسْرَح / قَادِم / تَالٍ ((تَالَ): عالَجَ التِّوَلةَ: (السِّحْر)؛ (تَالَ) بِه: دُهِيَ ومُنِيَ) / بِجَانِب (بجانب)\nمثال: زيري بجانب الحوض. / تَرْتِيب, نِظَام (تنظيم الأشياء أو الأحداث في تسلسل معين أو وضعها في نظام؛ إعداد أو تجهيز شيء لتحقيق غاية معينة) / أَمْر, حُكْم (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة) / طَلَب (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى)) / جَمَاعَة (العَدَد الكثير من النَاس أو الحَيْوَان أو النَبَات أو غيره. المَجْمُوعَة؛ طَائِفَة من الناس التي يجمعها مكان و بيئة واحدة أو تتشارك اهداف و غايات واحدة) / وِسَام / رُتْبَة (رُتْبَة، بضم الراء؛ رَتْبَة، بفتح الراء) / أَمَرَ (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة) / طَلَبَ, حَجَزَ (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى))\nمثال: أعاد زيري ترتيب المطبخ كلية.",
 "次々": "بِالتَّرْتِيب, فَرْدًا فَرْدًا\nمثال: 彼らは次々と出発した。 — بدأوا واحداً تلو الآخر.",
 "次々に": "بِالتَّرْتِيب, فَرْدًا فَرْدًا",
 "次々販売": "ضَاغِط, عَنِيف الإِقْنَاع (مُقنِع بإلحاح وعدوانية)",
 "次いで": "قَادِم / تَالٍ ((تَالَ): عالَجَ التِّوَلةَ: (السِّحْر)؛ (تَالَ) بِه: دُهِيَ ومُنِيَ) / بِجَانِب (بجانب)\nمثال: زيري بجانب الحوض.",
 "次から次と": "وَاحِدًا تِلْوَ الآخَرِ",
 "次から次に": "وَاحِدًا تِلْوَ الآخَرِ",
 "次から次へと": "وَاحِدًا تِلْوَ الآخَرِ",
 "次ぐ": "تَبِعَ, اِتَّبَعَ (تبِع الشيءَ: سار في إثرِه، تلاه؛ تبِعه تبَعًا: مرَّ به فمضى معه) / اِتَّبَعَ (تَكَلَّفَ وبذل الجُهْد في أن يَتْبَع) / تَابَعَ, تَتَبَّعَ / تَابَعَ\nمثال: تبع المشتبه محققان.",
 "次ぐ身": "وَارِث, وَرِيث (اسم فاعل من الفعل وَرَثَ؛ الوَارِث: اسم من الأسماء الحسنى)",
 "次なる": "قَادِم / تَالٍ ((تَالَ): عالَجَ التِّوَلةَ: (السِّحْر)؛ (تَالَ) بِه: دُهِيَ ومُنِيَ) / بِجَانِب (بجانب)\nمثال: زيري بجانب الحوض.",
 "次に": "قَادِم / تَالٍ ((تَالَ): عالَجَ التِّوَلةَ: (السِّحْر)؛ (تَالَ) بِه: دُهِيَ ومُنِيَ) / بِجَانِب (بجانب)\nمثال: زيري بجانب الحوض.",
 "次のように": "كَمَا يَلِي",
 "次の内閣": "حكومة الظل (مجموعة من كبار أعضاء الحزب السياسي الذي هو خارج السلطة؛ من المحتمل أن يتولى هؤلاء الأعضاء مناصب مقابلة كوزراء في مجلس الوزراء البريطاني إذا تم انتخاب…)",
 "次の間": "غُرْفَة الاِنْتِظَار (اسم مفعول لما غُرِفَ من الماء وغيره باليد، الجمع غِرَاف؛ اسم؛ المكان في الدار أو المبنى محاط بأربع جدران وسقف، حُجْرَة، عِلِّيَّة. الجمع وغُرَف وغُرُفَات)\nمثال: الأب في الغرفة.",
 "次中音": "تِينُور (قريب في المدى من أعلى صوت ذكوريّ طبيعيّ بالغ) / تِينُورِيّ ((لآلة موسيقيَّة) وسط بين الألتو والباريتون أو الباص) / تينور, صوت رجالي حاد (نطاق الطبقة الصوتية لأعلى صوت رجالي) / فحوى, مضمون (المعنى العام أو جوهر الكلام)\nمثال: على الرغم من أنني اختلفت معه، إلا أنني استطعت متابعة فحوى حجته",
 "次亜リン酸": "حمض الهيبوفوسفوروز (أصبح حامضًا، تغير الطعم إلى الحموضة؛ ارتفعت نسبة الحموضة في شيء ما، كما في الطعام أو السوائل)\nمثال: رمى ياني الحمض على وجه سكورة.",
 "次亜塩素酸": "حمض الهيبوكلوروز (حمض ضعيف غير مستقر يعرف فقط في المحلول وفي أملاحه؛ يستخدم كعامل تبييض ومؤكسد)",
 "次亜塩素酸ナトリウム": "هيبوكلوريت الصوديوم",
 "次亜塩素酸塩": "هيبوكلوريت (أي ملح أو إستر لحمض الهيبوكلوروز)",
 "次亜燐酸": "حمض الهيبوفوسفوروز (أصبح حامضًا، تغير الطعم إلى الحموضة؛ ارتفعت نسبة الحموضة في شيء ما، كما في الطعام أو السوائل)\nمثال: رمى ياني الحمض على وجه سكورة.",
 "次元": "بُعْد (يدل على اللحاق في الزمان؛ يكون مضافا، وينصب أو يجر)\nمثال: و بعد قليل أتى. / مَنْظُور, نَظْرَة",
 "次元数": "رُتْبَة (رُتْبَة، بضم الراء؛ رَتْبَة، بفتح الراء)",
 "次列": "ثَانَوِي (الثانويّ : المَنْسوب إلى الثاني ما يجيء بعدَ الأَوَّل؛ ما ليس له الأَهمّيَّة الأُُولى)\nمثال: ثانوية زيري ضخمة.",
