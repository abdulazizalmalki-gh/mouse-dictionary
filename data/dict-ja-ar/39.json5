 "棒付きキャンデー": "مصاصة",
 "棒先": "نِهَايَة, غَايَة / غَايَة / اِنْتَهَى, أَنْهَى (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات)\nمثال: انتهى أمر زيري.",
 "棒切": "غُصَيْن / عَصًا (ما يتخذ من خَشَب للتوكؤ أو الضرب؛ تطلق مجازا على عَظْم السَاق وعلى اللِسَان) / لَصَّقَ, لَصِقَ\nمثال: لا تمسك العصا من الوسط.",
 "棒切れ": "غُصَيْن / عَصًا (ما يتخذ من خَشَب للتوكؤ أو الضرب؛ تطلق مجازا على عَظْم السَاق وعلى اللِسَان) / لَصَّقَ, لَصِقَ\nمثال: لا تمسك العصا من الوسط.",
 "棒引き": "إلغاء (فعل الإلغاء؛ إلغاء ترتيب ما) / إبطال, إلغاء (الفعل الكلامي للإلغاء أو الفسخ أو الإبطال)",
 "棒振り": "قَائِدُ فِرْقَاتٍ مُوسِيقِيَّةٍ / كُمْسَرِيّ, كُمْسَارِيّ / مُوَصِّل كَهْرَبَائِيّ, مُوَصِّل",
 "棒杙": "وَتِد, خَازُوق (العصا تثبت في الأرض لتثبيت شيء ما بربطه إليها) / مِحْرَقَة / حِصَّة / رِهَان",
 "棒杭": "وَتِد, خَازُوق (العصا تثبت في الأرض لتثبيت شيء ما بربطه إليها) / مِحْرَقَة / حِصَّة / رِهَان",
 "棒砂糖": "قالب سكر (رغيف مخروطي كبير من السكر المكرر المركز)",
 "棒磁石": "قضيب مغناطيسي (مغناطيس على شكل قضيب بقطبين مغناطيسيين في كل طرف)",
 "棒立ち": "تربية, تنشئة (مساعدة شخص ما على النمو ليكون عضواً مقبولاً في المجتمع) / مُتَنَمِّر, نَاهِض (واقف على الرِّجل الخلفيَّة اليسرى مع رفع القوائم الأماميَّة والرأس جانبيّاً) / تنشئة, رعاية (الخصائص المكتسبة نتيجة للطريقة التي عوملت بها كطفل)",
 "棒紅": "أَحْمَر شِفَاه (أحد الألوان الرئيسية الثلاث (الأَحْمَر والأَصْفَر والأَزْرَق) وهو ما كان بلون الدَم أو النَار؛ صفة ما كان لونه أحمرا)\nمثال: أردت حذاء أحمر.",
 "棒組": "حبيب, صديق حميم (رجل هو عشيق لرجل أو امرأة) / رجل, رفيق (صبي أو رجل) / زَمِيل (شخص عضو في نفس مهنة أو طبقة الشخص الآخر) / رفيق, زميل (صديق يتواجد كثيراً بصحبة آخر)\nمثال: لو علمت أنه حبيبها لما سألت",
 "棒組み": "حبيب, صديق حميم (رجل هو عشيق لرجل أو امرأة) / رجل, رفيق (صبي أو رجل) / زَمِيل (شخص عضو في نفس مهنة أو طبقة الشخص الآخر) / رفيق, زميل (صديق يتواجد كثيراً بصحبة آخر)\nمثال: لو علمت أنه حبيبها لما سألت",
 "棒線": "خط مستقيم (خط ترسمه نقطة تتحرك في اتجاه ثابت؛ خط انحناؤه صفر)\nمثال: أقصر مسافة بين نقطتين هي خط مستقيم",
 "棒縞": "شارة الرتبة, شريط رتبة",
 "棒針": "إبرة حياكة, سنارة تريكو (إبرة تتكون من قضيب رفيع ذي نهايات مدببة؛ تستخدم عادة في أزواج)",
 "棒高跳び": "القفز بالزانة (مسابقة تتضمن القفز فوق عارضة عالية بمساعدة عصا طويلة)",
 "棕櫚の主日": "أحد الشعانين (الأحد الذي يسبق عيد الفصح)",
 "棕櫚竹": "نخيل السيدة النحيل (جمع نَخْلَة)\nمثال: زيري يغرس نخيل التمر.",
 "棗": "عُنَّاب",
 "棗椰子": "نَخْلَة",
 "棗球": "سهارة, ضوء ليلي (ضوء (مثل شمعة أو مصباح صغير) يضيء في غرفة النوم ليلاً (كما للأطفال أو المرضى))",
 "棘": "غليون الخلنج (غليون مصنوع من جذر شجيرة الخلنج) / خلنج, خلنج شجري (شجيرة متوسطية دائمة الخضرة تشبه الشجرة ذات زهور بيضاء عطرة في عناقيد طرفية كبيرة وجذور خشبية صلبة تستخدم لصنع غليون التبغ) / عشبة الثور, فصة مستديرة الأوراق (كرمة خشبية شائكة جداً في شرق الولايات المتحدة تنمو في كتل متشابكة ولها سيقان مستديرة قوية بأوراق جلدية لامعة وأزهار خضراء صغيرة تليها عناقيد من التوت…) / نسرين, ورد ياقوتي (ورد أوراسي ذو سيقان شائكة وأوراق عطرة وزهور وردية زاهية تليها ثمار قرمزية) / أَسَلَة / شَوْكَة (أداة لتناول الطعام تتكون عادةً من مقبض وعدة أسنان حادة، وتُستعمل لغرز الطعام وحمله إلى الفم)\nمثال: هناك شوكة ناقصة. / نقطة الالتقاء (نقطة تتشكل من قوسين متقاطعين (كما في القوس القوطي)) / حدبة الأسنان, شرفة (ارتفاع صغير على سطح طحن الأسنان) / شرفة, وريقة (سديلة مثلثة رقيقة لصمام القلب) / أَسَلَة / شَوْكَة (أداة لتناول الطعام تتكون عادةً من مقبض وعدة أسنان حادة، وتُستعمل لغرز الطعام وحمله إلى الفم)\nمثال: هناك شوكة ناقصة. / شَظِيَّة",
 "棘皮動物": "شوكيات الجلد (لافقاريات بحرية ذات أقدام أنبوبية وأجسام متناظرة شعاعياً خماسية الأجزاء)",
 "棘突起": "نتوء شوكي (نتوء يبرز من الفقرة يربط العضلات والأربطة)\nمثال: النتوءات الشوكية مبالغ فيها في بعض الحيوانات، مثل ديميترودون وسبينوصور المنقرضين، حيث تشكل شراع ظهر أو زعنفة ظهر",
 "棘魚": "سمك شائك الظهر (أسماك صغيرة (2-4 بوصات) عدوانية غالباً عديمة الحراشف وشائكة الظهر تعيش في المياه العذبة والساحلية الشمالية ولها طقوس تزاوج معقدة؛ موضوع لكثير من…)",
 "棚": "رَفّ (رَفَّتْ أَوْراقُ الشَّجَرِ: اِهْتَزَّتْ، تَحَرَّكَتْ؛ رَفَّتِ العَيْنُ: رَمَّشَتْ)\nمثال: وضع الكتاب على الرف. / تعريشة (شبكة خشبية تستخدم لدعم النباتات المتسلقة)",
 "棚ざらえ": "بيع تصفية, تصفية (بيع لتقليل المخزون)",
 "棚に上げる": "نَسِيَ (لَمْ يَتَذَكَّرْ؛ غَابَ عَنْ الذِهْن)\nمثال: لقد نسي صديقتك.",
 "棚ぼた": "ضَرْبَة حَظّ (المرة الواحدة من الضَرْب؛ اللطمو أو الدقة أو الصكّة؛ ضربة طبل: دقة واحدة منه) / مُصَادَفَة سَعِيدَة / مِنْحَة إِلٰهِيَّة\nمثال: تلقى مناد ضربة.",
 "棚ボタ": "ضَرْبَة حَظّ (المرة الواحدة من الضَرْب؛ اللطمو أو الدقة أو الصكّة؛ ضربة طبل: دقة واحدة منه) / مُصَادَفَة سَعِيدَة / مِنْحَة إِلٰهِيَّة\nمثال: تلقى مناد ضربة.",
 "棚上げ": "تجميع, تصنيف (نظام لتصنيف الأشياء إلى مجموعات)",
 "棚卸": "إحصاء المخزون, جرد (عمل قائمة مفصلة بالبضائع أو الإمدادات المتاحة) / تقييم الموقف, جرد (إعادة تقييم لوضع أو منصب أو نظرة مستقبلية)\nمثال: قد يكون الجرد ضرورياً لمعرفة ما إذا كان هناك شيء مفقود / عَيَّاب, مُتَصَيِّدٌ لِلْأَخْطَاءِ (يميل إلى إيجاد العيوب ولفت الانتباه إليها) / تَذَمُّر, تَصَيُّد الْأَخْطَاء (نقد تافه وغير مبرر ومستمر)",
 "棚卸し": "إحصاء المخزون, جرد (عمل قائمة مفصلة بالبضائع أو الإمدادات المتاحة) / تقييم الموقف, جرد (إعادة تقييم لوضع أو منصب أو نظرة مستقبلية)\nمثال: قد يكون الجرد ضرورياً لمعرفة ما إذا كان هناك شيء مفقود / عَيَّاب, مُتَصَيِّدٌ لِلْأَخْطَاءِ (يميل إلى إيجاد العيوب ولفت الانتباه إليها) / تَذَمُّر, تَصَيُّد الْأَخْطَاء (نقد تافه وغير مبرر ومستمر)",
 "棚卸し表": "جَرْد (جَرَدَ الشيءَ: أحصى ما فيه، ضبط قيمته؛ جَرَدَ البطاطسَ: قشّرها وأزال ما عليها)\nمثال: كان سامي جرد طفل.",
 "棚卸し資産": "جَرْد (جَرَدَ الشيءَ: أحصى ما فيه، ضبط قيمته؛ جَرَدَ البطاطسَ: قشّرها وأزال ما عليها)\nمثال: كان سامي جرد طفل.",
 "棚卸表": "جَرْد (جَرَدَ الشيءَ: أحصى ما فيه، ضبط قيمته؛ جَرَدَ البطاطسَ: قشّرها وأزال ما عليها)\nمثال: كان سامي جرد طفل.",
 "棚卸資産": "جَرْد (جَرَدَ الشيءَ: أحصى ما فيه، ضبط قيمته؛ جَرَدَ البطاطسَ: قشّرها وأزال ما عليها)\nمثال: كان سامي جرد طفل.",
 "棚受け": "دعامة الرف (دعامة لدعم رف)",
 "棚引く": "جَرَّ (جَرَّ الحيوانَ وغيرَه: جذبه وسحبه؛ جَرَّ أذيالَه: تبختر، زها بنفسه، اختال) / أَثَر (عَلَامَة؛ بَقِيَّة؛ رَسْم مُتَخَلَّف من شيء ما؛ تأثير؛ انطباع) / مَسْلَك (المَسْلَك: الطريقُ سلكنا مَسْلكًا لم يسلكه أحد من قبل ، - مسالك الجبال ، - هذا مَسْلك وعر؛ المَسْلَك: سلوك، تصرُّف)\nمثال: اضطررت إلى جر سامي.",
 "棚板": "رَفّ (رَفَّتْ أَوْراقُ الشَّجَرِ: اِهْتَزَّتْ، تَحَرَّكَتْ؛ رَفَّتِ العَيْنُ: رَمَّشَتْ)\nمثال: وضع الكتاب على الرف.",
 "棚機つ女": "اَلنَّسْر اَلْوَاقِع",
 "棚機津女": "اَلنَّسْر اَلْوَاقِع",
 "棚氷": "رف جليدي (جليد متصل باليابسة ولكنه يبرز في البحر)",
 "棟": "سلسلة جبال",
 "棟木": "عارضة القمة, قمة السقف (عارضة موضوعة على طول الحافة حيث يلتقي جانبان مائلان للسقف في الأعلى؛ توفر مرفقاً للنهايات العليا للعوارض الخشبية)",
 "棟梁": "عمود / شَيْخ, قَائِد",
 "棟瓦": "قرميد القمة (بلاط زخرفي منحني في المقطع العرضي؛ يستخدم لتغطية قمة السقف)",
 "棧橋": "رَصِيف",
 "森": "غَابَة, غابة (الغَابَةُ: الأَجَمَةُ ذاتُ الشَّجَرِ المُتَكَاثِف؛ لأَنَّها تُغَيِّبُ مَا فِيهَا. أو الأَجَمَةُ الَّتِي طالتْ، وَلَهَا أَطْراف مُرْتَفِعَةٌ باسِقَة؛ الغابةُ أَجَمة القَصَب، قَالَ: وَقَدْ جُعِلَتْ جماعةَ الشَّجَرِ، لأَنه مأْخوذ مِنَ الغَيابةِ)\nمثال: مشينا في الغابة",
 "森のバター": "أَفُوكَادُو",
 "森厳": "جَادّ, صَادِق (يتّسم بإيمان ثابت وجادّ بأهمية الشيء ذاته) / رَزِين, وَقُور (يتّسم بالوقار والرصانة في الطبع والسلوك)",
 "森林": "غَابَة, غابة (الغَابَةُ: الأَجَمَةُ ذاتُ الشَّجَرِ المُتَكَاثِف؛ لأَنَّها تُغَيِّبُ مَا فِيهَا. أو الأَجَمَةُ الَّتِي طالتْ، وَلَهَا أَطْراف مُرْتَفِعَةٌ باسِقَة؛ الغابةُ أَجَمة القَصَب، قَالَ: وَقَدْ جُعِلَتْ جماعةَ الشَّجَرِ، لأَنه مأْخوذ مِنَ الغَيابةِ)\nمثال: مشينا في الغابة",
 "森林伐採": "إزالة الأشجار, إزالة الغابات (إزالة الأشجار) / إزالة الغابات (حالة خلو المكان من الأشجار)",
 "森林再生": "إعادة التشجير (استعادة (إعادة زراعة) غابة تم تقليصها بسبب حريق أو قطع)",
 "森林地": "أحراج, غابة (أرض مغطاة بالأشجار والشجيرات)",
 "森林地帯": "أحراج, غابة (أرض مغطاة بالأشجار والشجيرات)",
 "森林学": "علم الغابات (علم زراعة ورعاية الغابات وإدارة الأخشاب النامية)",
 "森林火災": "حريق غابة (حريق غير منضبط في منطقة حرجية)",
 "森林狼": "ذئب الغياض, ذئب رمادي (ذئب ذو معطف رمادي مبقع يعيش في المناطق الشمالية المشجرة في أمريكا الشمالية)",
 "森林破壊": "إزالة الأشجار, إزالة الغابات (إزالة الأشجار) / إزالة الغابات (حالة خلو المكان من الأشجار)",
 "森林限界": "خط الأشجار (الخط الذي يمثل الحد الأعلى لنمو الأشجار في الجبال أو خطوط العرض الشمالية)",
 "森閑": "صَامِت, سَاكِت",
 "棲み分け": "تبويب, تصنيف (فعل توزيع الأشياء في فئات أو أصناف من نفس النوع) / تجزئة, تقسيم نفسي (حالة خفيفة من التفكك النفسي)",
 "棲み分ける": "فَرَّقَ",
 "棲む": "حَيِيَ, عَاشَ / يَنْجُو / حَيّ (ضد المَيِّت، على قيد الحَيَاة؛ جمع حَيَاء) / مُباشِر\nمثال: ينبح كلب في الحي.",
 "棲家": "مَنْزِل, سَكَن (مكان نزول القافلة؛ واحد منازل القمر، وهي مداراته التي يدور فيها حول الأَرض يدور كلَّ ليلة في أَحدها)\nمثال: لقد هدأ المنزل. / عَرِين, جُحْر (اِسْمٌ لِمَاْوَى الأَسَد)",
 "棲息": "أَقَام, قَطَن (فعل تعدي من قَامَ بمعنى جَعَلَه يقوم؛ ضد أجْلَسَ؛ الشيءَ: جعله يقوم أو جعله قائما مع معنى الثبات)\nمثال: أقام سامي مع بعض الأصدقاء.",
 "棲息地": "مَوْطِن (الوَطَن؛ كل مكان أقام به الإنسان سواء اتخذه وطنا أم لا)\nمثال: السافانة موطن أيضا للأسود و النمور.",
 "棹": "عَصًا (ما يتخذ من خَشَب للتوكؤ أو الضرب؛ تطلق مجازا على عَظْم السَاق وعلى اللِسَان)\nمثال: لا تمسك العصا من الوسط. / رَقَبَة, عُنُق / خَشَبَة / كَمَرَة, جَائِز / شُعَاع / قَضِيب, ذَكَر",
 "棹さす": "عَمُود, قُطْب / زَانَة",
 "棹差す": "عَمُود, قُطْب / زَانَة",
 "棹秤": "ميزان العارضة, ميزان ذو كفتين (ميزان يتكون من رافعة ذات ذراعين متساويين وكفة معلقة من كل ذراع)",
 "棺": "تَابُوت (تَّابُوت: هو الصُّنْدُوق الذي توضع به الجثة؛ صندوق خشبيّ يكون مستطيل)",
 "棺おけ": "تَابُوت (تَّابُوت: هو الصُّنْدُوق الذي توضع به الجثة؛ صندوق خشبيّ يكون مستطيل)",
 "棺を覆う": "مَاتَ (للحَيّ: فقد الحَيَاة. مصدره مَوتَا ومِيتَة؛ للأرض: ليس فيها شيء حَيّ من النبات أو الحيوان أو الإنسان. مصدره مَوَات) / تُوُفِّيَ / زَهْر اَلطَّاوِلَة, زَهْر اَلنَّرْد ((زَهَرَ) الوجهُ والسراجُ والقمرُ يَزْهُرُ زَهْرًا، وزُهُوراً: تلألأ وأشْرق؛ (زَهَرَ) الشيءُ: صَفا لونُه)\nمثال: إعتقدت أنه مات.",
 "棺架": "جَنَازَة (مراسم تقام لتشييع وفاة شخص)\nمثال: \"أنا ذاهب إلى جنازة.\" \"من توفي؟\"",
 "棺桶": "تَابُوت (تَّابُوت: هو الصُّنْدُوق الذي توضع به الجثة؛ صندوق خشبيّ يكون مستطيل)",
 "椀": "زِبْدِيَّة / سُلْطَانِيَّة / زُبْدِيَّة",
 "椀型": "وِعَائِيُّ الشَّكْل (ذو شكل مقعّر مفتوح من الأعلى كالوعاء)",
 "椀形": "وِعَائِيُّ الشَّكْل (ذو شكل مقعّر مفتوح من الأعلى كالوعاء)",
 "椅子": "كُرْسِيّ, مَقْعَد (مَقْعَد لواحد؛ العِلْم. يقال هو من أهل الكُرسِيّ أي أهل العِلم) / كُرْسِيّ مُعَلِّم (مَقْعَد لواحد؛ العِلْم. يقال هو من أهل الكُرسِيّ أي أهل العِلم)\nمثال: أحب ذاك الكرسي. / عَارِضَة, عَارْضَة / مَنْشوُر, بُوسْت / نَشَرَ, نشر (بَسَطَ، فَرَّقَ، نَشَرَ الشيءَ: جعله منتشراً، مثل نشر الأخبار أو نشر كتاب؛ نَشَرَ: وزع أو عمم شيئًا بين الناس، مثل نشر المقالات)\nمثال: نشر توم الغسيل.",
 "椅子取りゲーム": "تبادل أدوار, كراسي موسيقية (إعادة ترتيب ليس لها تأثير عملي أو أهمية حقيقية) / الكراسي الموسيقية (لعبة للأطفال يسير فيها اللاعبون على أنغام الموسيقى حول مجموعة من الكراسي تقل بكرسي واحد عن عدد اللاعبين؛ عندما تتوقف الموسيقى فجأة يتدافع اللاعبون…)\nمثال: تبحث الشركة عن الاستقرار بعد سنوات من لعبة الكراسي الموسيقية مع المديرين",
 "椈": "زان ياباني (زان موطنه اليابان له خشب بني مصفر فاتح ناعم)",
 "椈の木": "زان ياباني (زان موطنه اليابان له خشب بني مصفر فاتح ناعم)",
 "椈材": "خشب الزان (خشب أي من أشجار الزان المختلفة؛ يستخدم للأرضيات والحاويات والخشب الرقائقي ومقابض الأدوات)",
 "椋鳥": "زُرْزُور / فلاح ساذج, قروي بسيط (شخص ليس ذكياً جداً أو غير مهتم بالثقافة) / تِسْعَة وَسِتُّون",
 "椋鳥擬": "سوادية (شحرور أمريكي طويل الذيل ذو ريش أسود قزحي الألوان)",
 "植う": "نَبَات (مصدر للفعل نَبَتَ؛ اسم جنس شامل لكل ما تنبته الأرض من شجر أو بقل أو عشب أو غيره) / زَرَعَ, غَرَسَ (بَذَرَ الحَبَّ؛ أَنْبَتَ، نَمَّى)\nمثال: هذا النبات مهدد بالانقراض.",
 "植えつけ": "زراعة, غرس (وضع البذور أو النباتات الصغيرة في الأرض لتنمو) / زرع, غرس (فعل التثبيت بإحكام في المكان) / مشجر, مغرس (مجموعة من النباتات (أشجار أو شجيرات أو زهور) في منطقة معينة)\nمثال: زراعة الذرة عمل شاق",
 "植えつける": "نَبَات (مصدر للفعل نَبَتَ؛ اسم جنس شامل لكل ما تنبته الأرض من شجر أو بقل أو عشب أو غيره) / زَرَعَ, غَرَسَ (بَذَرَ الحَبَّ؛ أَنْبَتَ، نَمَّى)\nمثال: هذا النبات مهدد بالانقراض.",
 "植える": "نَبَات (مصدر للفعل نَبَتَ؛ اسم جنس شامل لكل ما تنبته الأرض من شجر أو بقل أو عشب أو غيره) / زَرَعَ, غَرَسَ (بَذَرَ الحَبَّ؛ أَنْبَتَ، نَمَّى)\nمثال: هذا النبات مهدد بالانقراض. / أَدْخَلَ / لَقَّحَ",
 "植え付け": "زراعة, غرس (وضع البذور أو النباتات الصغيرة في الأرض لتنمو) / زرع, غرس (فعل التثبيت بإحكام في المكان) / مشجر, مغرس (مجموعة من النباتات (أشجار أو شجيرات أو زهور) في منطقة معينة)\nمثال: زراعة الذرة عمل شاق",
 "植え付ける": "نَبَات (مصدر للفعل نَبَتَ؛ اسم جنس شامل لكل ما تنبته الأرض من شجر أو بقل أو عشب أو غيره) / زَرَعَ, غَرَسَ (بَذَرَ الحَبَّ؛ أَنْبَتَ، نَمَّى)\nمثال: هذا النبات مهدد بالانقراض.",
 "植え字": "تَنْضِيد",
 "植え替え": "زرع, نقل (عملية إزالة شيء من مكان وإدخاله في مكان آخر) / زراعة الأعضاء, نقل الأعضاء (عملية نقل عضو من كائن حي (المتبرع) إلى آخر (المتلقي))\nمثال: لم تزهر الشتلة المزروعة حتى السنة الثانية",
 "植え替える": "زَرَعَ, شَتَلَ (بَذَرَ الحَبَّ؛ أَنْبَتَ، نَمَّى) / زَرَعَ (بَذَرَ الحَبَّ؛ أَنْبَتَ، نَمَّى) / زَرْع (بَذَرَ الحَبَّ؛ أَنْبَتَ، نَمَّى)\nمثال: يريد الإنفصاليون زرع رايتهم بمواقع الأنترنت. / جهاز إعادة ضبط, زر إعادة تعيين (جهاز لإعادة ضبط الأدوات أو عناصر التحكم)",
 "植え込み": "مَزْرَعَة",
 "植え込む": "نَبَات (مصدر للفعل نَبَتَ؛ اسم جنس شامل لكل ما تنبته الأرض من شجر أو بقل أو عشب أو غيره) / زَرَعَ, غَرَسَ (بَذَرَ الحَبَّ؛ أَنْبَتَ، نَمَّى)\nمثال: هذا النبات مهدد بالانقراض.",
 "植付": "زراعة, غرس (وضع البذور أو النباتات الصغيرة في الأرض لتنمو) / زرع, غرس (فعل التثبيت بإحكام في المكان) / مشجر, مغرس (مجموعة من النباتات (أشجار أو شجيرات أو زهور) في منطقة معينة)\nمثال: زراعة الذرة عمل شاق",
 "植付け": "زراعة, غرس (وضع البذور أو النباتات الصغيرة في الأرض لتنمو) / زرع, غرس (فعل التثبيت بإحكام في المكان) / مشجر, مغرس (مجموعة من النباتات (أشجار أو شجيرات أو زهور) في منطقة معينة)\nمثال: زراعة الذرة عمل شاق",
