 "欽定": "رَسْمِيّ, مُخَوَّل (ممنوح السلطة)\nمثال: بلاغ رسمي",
 "欽定英訳聖書": "آب (الشهر الحادي عشر من السنة المدنية؛ الشهر الخامس من السنة الدينية في التقويم اليهودي (في يوليو وأغسطس))",
 "欽慕": "توقير, عبادة (العبادة المقدمة لله وحده) / تبجيل, عشق (فعل الإعجاب بشدة) / عبادة, هيام (شعور بالحب العميق والإعجاب)",
 "款": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / عُنْوَان (عُنْوَان) / عِنْوَان (عُنْوَان) / اِسْم (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)\nمثال: في حقيقة الأمر، كان زيري يعرف لقب ريمة. / النزعَة إلى الخير",
 "歌": "أُغْنِيَّة, أُغْنِيَة (الجمع : أُغْنِيَات و أغانٍ؛ الأُغنيَة المقتسمة : ( الموسيقى ) قطعة موسيقيَّة ذات لفظ مجانس متعلِّق بالكورال في القرن التَّاسع عشر) / غِنَاء (مصدر للفعل \"غَنَّى\"؛ استعمال الصوت البشري لصنع أصوات موسيقية)\nمثال: أنا أغني أغنية.",
 "歌い手": "مُطْرِب, مُغَنٍّ",
 "歌い文句": "شِعار (العلامة: وذلك من شعار العقلاء (مادة حلم من مجمع بحار الأنوار))\nمثال: الشعار ☭ هو رمز الشيوعية.",
 "歌う": "غَنَّى / تَلَا (قَرَأَ، نحو: تَلُوتُ القرآن تلاوةً أي قرأته؛ اتّبَعَ، نحو: تلا الكتاب والسنة، أو تبع فلان في عمله وسار على نهجه)",
 "歌うたい": "مُطْرِب, مُغَنٍّ",
 "歌人": "شَاعِر, شَاعِرَة",
 "歌劇": "أُوبِرَا, أُوپِرَا",
 "歌劇団": "فرقة أوبرا (فرقة تنتج الأوبرا)",
 "歌劇場": "أوبرا, دار الأوبرا (مبنى يتم فيه تقديم الأعمال الدرامية الموسيقية)",
 "歌唄い": "مُطْرِب, مُغَنٍّ",
 "歌唱": "أُغْنِيَّة, أُغْنِيَة (الجمع : أُغْنِيَات و أغانٍ؛ الأُغنيَة المقتسمة : ( الموسيقى ) قطعة موسيقيَّة ذات لفظ مجانس متعلِّق بالكورال في القرن التَّاسع عشر) / غِنَاء (مصدر للفعل \"غَنَّى\"؛ استعمال الصوت البشري لصنع أصوات موسيقية)\nمثال: أنا أغني أغنية.",
 "歌声": "صوت غنائي (الجودة الموسيقية للصوت أثناء الغناء)",
 "歌姫": "مغنية (امرأة مغنية (خاصة للأغاني الشعبية))",
 "歌学": "شِعْر (العِلْم؛ في : هو كلام مُقَفَّى ومُوَازَن على أوزان معروفة يُقصد به إظهار الكلام بصيغة فنية)\nمثال: شعر ماريا طويل.",
 "歌手": "مُطْرِب, مُغَنٍّ",
 "歌曲": "لَحْن, أُغْنِيَّة (وضع الألحان أو التأليف الموسيقي؛ قرأ النص بلحن أو أداء صوتي مميز)\nمثال: أنا أحب هذا اللحن.",
 "歌歌い": "مُطْرِب, مُغَنٍّ",
 "歌神": "ربة الإلهام, ملهمة (مصدر إلهام الفنان) / ربة الإلهام, موز (في الأساطير اليونانية القديمة أي من بنات زيوس وميموزين التسع؛ حاميات الفنون والعلوم)\nمثال: كانت يوتيربي ملهمته",
 "歌舞人": "مُوسِيقِيّ, مُوسِيقِيَّة (متعلق أو له صلة بالموسيقى؛ الشخض الذي يعزف أو يؤلف الموسيقى، كمهنة أو هواية)\nمثال: سيبدأ الفيلم الموسيقي قريبا.",
 "歌舞伎": "كَابُوكِي",
 "歌舞音曲": "تَرْفِيه, تَسْلِيَة",
 "歌詞": "ليبريتو, نص الأوبرا (كلمات أوبرا أو مسرحية موسيقية)",
 "歌謡": "أُغْنِيَّة, أُغْنِيَة (الجمع : أُغْنِيَات و أغانٍ؛ الأُغنيَة المقتسمة : ( الموسيقى ) قطعة موسيقيَّة ذات لفظ مجانس متعلِّق بالكورال في القرن التَّاسع عشر) / غِنَاء (مصدر للفعل \"غَنَّى\"؛ استعمال الصوت البشري لصنع أصوات موسيقية)\nمثال: أنا أغني أغنية.",
 "歌謡い": "مُطْرِب, مُغَنٍّ",
 "歌道": "عروض, نظم الشعر (فن أو ممارسة كتابة الشعر) / عروض, نظم (الشكل أو التركيب المتري للقصيدة) / نظم شعري (اقتباس موزون لشيء ما (على سبيل المثال، لنص نثري))",
 "歌集": "تَجْمِيعَة, دِيوَان / كتاب أغاني (كتاب يحتوي على مجموعة من الأغاني)",
 "歎": "تَنَهَّدَ / تَنَهُّد / غَمّ, حُزْن",
 "歎き": "غَمّ, حُزْن",
 "歎く": "عَوِيل, رَثَاء / مَرْثِيَة / بَكَى, نَاحَ (دَمَعَتْ عَيناهُ حزنا؛ بكى الْمَيِّت: رثاه) / بَكَى, رَثَى (دَمَعَتْ عَيناهُ حزنا؛ بكى الْمَيِّت: رثاه)\nمثال: بكى زيري كثيرا.",
 "歎じる": "عَوِيل, رَثَاء / مَرْثِيَة / بَكَى, نَاحَ (دَمَعَتْ عَيناهُ حزنا؛ بكى الْمَيِّت: رثاه) / بَكَى, رَثَى (دَمَعَتْ عَيناهُ حزنا؛ بكى الْمَيِّت: رثاه)\nمثال: بكى زيري كثيرا. / عَجَبَ",
 "歎ずる": "عَوِيل, رَثَاء / مَرْثِيَة / بَكَى, نَاحَ (دَمَعَتْ عَيناهُ حزنا؛ بكى الْمَيِّت: رثاه) / بَكَى, رَثَى (دَمَعَتْ عَيناهُ حزنا؛ بكى الْمَيِّت: رثاه)\nمثال: بكى زيري كثيرا. / عَجَبَ",
 "歎声": "تَنَهَّدَ / تَنَهُّد",
 "歎息": "تَنَهَّدَ / تَنَهُّد",
 "歎美": "إِعْجَاب",
 "歎賞": "إِعْجَاب",
 "歓": "سُرُور, فَرَح (شُعُور حَسَن يتبع الرضا، والارتياح)\nمثال: قبل زيري بسرور.",
 "歓呼": "تَزْكِية",
 "歓喜": "فُرْجَة",
 "歓声": "انشراح, بشاشة (صفة كون المرء مبتهجاً وطارداً للكآبة) / هتاف (صرخة أو صيحة استحسان)\nمثال: أضافت الزهور لمسة من البهجة للغرفة الكئيبة",
 "歓天喜地": "ابتهاج, تهلل (تلفظ بأصوات تعبر عن الفرح العظيم) / ابتهاج, احتفال (مناسبة مبهجة تتضمن احتفالات خاصة لتمييز حدث سعيد) / تهلل, حبور (شعور بالفرح الشديد)",
 "歓待": "كَرَم, إِكْرَام / ضِيَافَة",
 "歓心": "تفضل, خدمة (عمل يتسم باللطف والتفضل) / هدية الحفل (تذكار عبارة عن هدية صغيرة تعطى للضيوف في حفلة) / تَأْيِيد, صَالِح (أفضلية تعود بالنفع على شخص أو شيء ما) / استحسان, قبول (الميل للموافقة والاستحسان)\nمثال: كانت النتيجة في صالحه",
 "歓楽": "مُتْعَة, لَذَّة",
 "歓楽街": "حي البغاء, منطقة الضوء الأحمر (حي يكثر فيه وجود بيوت الدعارة)",
 "歓然": "مَسْرُور (كلُّ من يشعر بالسُّرُور)\nمثال: أما مسرور برؤيتك.",
 "歓談": "دَرْدَشَ / مُحَادَثَّة / دَرْدَشَة",
 "歓迎": "أَهْلًا وَسَهْلًا, مَرْحَبًا (تحية ترحيب بالضيف؛ تحية عند اللقاء أو لبدء المحادثة) / تَرْحِيب / رَحَّبَ, اِسْتَقْبِل (بنو رَحَب: اسم؛ بطن من همذان)\nمثال: أهلا يا أصدقاء.",
 "歔欷": "شهيق البكاء, نشيج (شهقة تشنجية تحدث أثناء البكاء)",
 "止し": "زَالَ (زَالَ يَزُولُ زَوَالاً، وزَوَلاَنًا: تحوَّلَ وانتقل؛ يقال: زَالَ من مكانه وعنه)\nمثال: توم لا زال يبكي",
 "止す": "وَقَفَ, تَوَقَّفَ (قَامَ، اِنْتَصَبَ، نَهَضَ؛ ثَبَتَ) / أَوْقَفَ, وَقَفَ / تَوَقَّفَ, وَقَّف / مَوْقِف / وَقْفَة\nمثال: وقف وراء الباب.",
 "止まない": "دَائِمًا, أَبَدًا / جِدًّا (كلمة \"جدا\" لها معانٍ متعددة؛ يرتبط المعنى بالعطاء والكرم، سواء بالمنح أو طلبه)\nمثال: إنها غالية جدا!",
 "止まり": "وَقَفَ, تَوَقَّفَ (قَامَ، اِنْتَصَبَ، نَهَضَ؛ ثَبَتَ) / أَوْقَفَ, وَقَفَ / تَوَقَّفَ, وَقَّف / مَوْقِف / وَقْفَة\nمثال: وقف وراء الباب.",
 "止まり木": "فرخ (أي من الأسماك العديدة شائكة الزعانف من فصائل مختلفة من رتبة الفرخيات) / فرخ (أسماك غذائية ورياضية شائكة الزعانف تعيش في المياه العذبة) / مجثم (دعامة تتكون من فرع أو قضيب يعمل كمكان للراحة (خاصة للطائر)) / سمك الفرخ, فرخ (أي من العديد من أسماك أمريكا وأوروبا)",
 "止まる": "وَقَفَ, تَوَقَّفَ (قَامَ، اِنْتَصَبَ، نَهَضَ؛ ثَبَتَ) / أَوْقَفَ, وَقَفَ / تَوَقَّفَ, وَقَّف / مَوْقِف / وَقْفَة\nمثال: وقف وراء الباب. / بَاقِي (الباقي : اسم من أسماء الله تعالى ومعناه : المستأثر بالبقاء والدّوام ، وهو نتيجة كونه واجبَ الوجود لذاته ، فهو الأوّل بلا ابتداء ، والآخر بلا انتهاء؛ الباقي الثابتُ بعد غيره) / بَقِيَ, مَكَثَ (أَقَامَ أو ثَبَتَ في مكانه أو حاله زمنا قصيرا أو طويلا؛ فَضَلَ)\nمثال: الباقي ليس مهم. / زَالَ (زَالَ يَزُولُ زَوَالاً، وزَوَلاَنًا: تحوَّلَ وانتقل؛ يقال: زَالَ من مكانه وعنه)\nمثال: توم لا زال يبكي",
 "止まれ": "وَقَفَ, تَوَقَّفَ (قَامَ، اِنْتَصَبَ، نَهَضَ؛ ثَبَتَ) / أَوْقَفَ, وَقَفَ / تَوَقَّفَ, وَقَّف / مَوْقِف / وَقْفَة\nمثال: وقف وراء الباب.",
 "止みがたい": "لَا يُقَاوَم (بالغ الجاذبيّة إلى حدّ لا يمكن مقاومته) / ساحق, لا يقاوم (مستحيل مقاومته؛ غلاب)\nمثال: دوافع لا تقاوم",
 "止み難い": "لَا يُقَاوَم (بالغ الجاذبيّة إلى حدّ لا يمكن مقاومته) / ساحق, لا يقاوم (مستحيل مقاومته؛ غلاب)\nمثال: دوافع لا تقاوم",
 "止む": "زَالَ (زَالَ يَزُولُ زَوَالاً، وزَوَلاَنًا: تحوَّلَ وانتقل؛ يقال: زَالَ من مكانه وعنه)\nمثال: توم لا زال يبكي",
 "止むに止まれず": "قَاهِر, لَا يُقَاوَم (يميل إلى الإقناع بقوّة البرهان) / دَافِع, قَاهِر (يدفع أو يُرغم بقوة لا تُقاوم)",
 "止むに止まれない": "قَاهِر, لَا يُقَاوَم (يميل إلى الإقناع بقوّة البرهان) / دَافِع, قَاهِر (يدفع أو يُرغم بقوة لا تُقاوم)",
 "止むに止まれぬ": "قَاهِر, لَا يُقَاوَم (يميل إلى الإقناع بقوّة البرهان) / دَافِع, قَاهِر (يدفع أو يُرغم بقوة لا تُقاوم)",
 "止むを得ず": "بشكل حتمي, لا محالة (بحكم الضرورة؛ بشكل لا مفر منه)\nمثال: انزلق الوضع لا محالة نحو الكارثة",
 "止むを得ない": "وَاجِب (اسم لما يُوجَبُ فعله؛ اسم لما صار حدوثه أكيد)\nمثال: لا شكر على واجب.",
 "止むを得まい": "وَاجِب (اسم لما يُوجَبُ فعله؛ اسم لما صار حدوثه أكيد)\nمثال: لا شكر على واجب.",
 "止むを得ません": "وَاجِب (اسم لما يُوجَبُ فعله؛ اسم لما صار حدوثه أكيد)\nمثال: لا شكر على واجب.",
 "止むを得ん": "وَاجِب (اسم لما يُوجَبُ فعله؛ اسم لما صار حدوثه أكيد)\nمثال: لا شكر على واجب.",
 "止む得ず": "بشكل حتمي, لا محالة (بحكم الضرورة؛ بشكل لا مفر منه)\nمثال: انزلق الوضع لا محالة نحو الكارثة",
 "止む無い": "وَاجِب (اسم لما يُوجَبُ فعله؛ اسم لما صار حدوثه أكيد)\nمثال: لا شكر على واجب.",
 "止む無く": "اضْطِرَارًا, بِالضَّرُورَة (عن طريق الضرورة؛ بحكم الظروف)",
 "止む無し": "وَاجِب (اسم لما يُوجَبُ فعله؛ اسم لما صار حدوثه أكيد)\nمثال: لا شكر على واجب.",
 "止む終えない": "وَاجِب (اسم لما يُوجَبُ فعله؛ اسم لما صار حدوثه أكيد)\nمثال: لا شكر على واجب.",
 "止む負えない": "وَاجِب (اسم لما يُوجَبُ فعله؛ اسم لما صار حدوثه أكيد)\nمثال: لا شكر على واجب.",
 "止め": "وَقَفَ, تَوَقَّفَ (قَامَ، اِنْتَصَبَ، نَهَضَ؛ ثَبَتَ) / أَوْقَفَ, وَقَفَ / تَوَقَّفَ, وَقَّف / مَوْقِف / وَقْفَة\nمثال: وقف وراء الباب. / فَائِض, مُتَبَقٍّ (لم يُسْتَهْلَك بعد)",
 "止めくぎ": "توجل, مسمار تثبيت (مثبت يتكون من وتد أو مسمار أو قطعة عرضية يتم إدخالها في عروة في نهاية حبل أو سلسلة أو كابل لتثبيته بشيء ما (مثل حبل أو سلسلة أو كابل آخر)) / مفتاح تبديل, مفتاح قلاب (مفتاح مفصلي يمكن أن يتخذ أحد وضعين) / أمر تبديل, مفتاح تبديل (أي تعليمة تعمل بطريقة ما أولاً ثم بطريقة أخرى؛ فهي تشغّل شيئاً ما في المرة الأولى لاستخدامها ثم توقفه في المرة التالية)",
 "止めだて": "تقييد, كبح (فعل السيطرة عن طريق تقييد شخص ما أو شيء ما) / رادع, قيد (جهاز يؤخر حركة شيء ما) / بساطة, تقشف فني (الخلو من الزخرفة) / تحفظ, كبح (الانضباط في الأنشطة الشخصية والاجتماعية)\nمثال: التقييد غير القانوني للتجارة",
 "止めておく": "مَرَّرَ, مَرَّ / اِحْتَازَ (بنفس معنى حَازَ، إلا أن احتاز تميل إلى أن الفاعل أراد الحوز) / اِنْقَضَى, مَرَّ / أَهمَلَ / تَغَاضَى / تَخَلَّى / طَريق (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من ٱلشَّارِعِ، سَبِيل) / جَوَاز\nمثال: أسأل عن الطريق.",
 "止めとき": "لَا (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: لا أحب المدرسة.",
 "止めど": "نِهَايَة, غَايَة / غَايَة / اِنْتَهَى, أَنْهَى (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات)\nمثال: انتهى أمر زيري.",
 "止めどない": "حَلَقِيّ, لَا نِهَائِيّ (مُتَّصِلُ الأَطْرَافِ بِحَيْثُ يُشَكِّلُ كُلًّا مُتَّصِلًا) / أَبَدِيّ, سَرْمَدِيّ (لَيْسَ لَهُ بِدَايَةٌ مَعْرُوفَةٌ وَلَا نِهَايَةٌ مُفْتَرَضَةٌ) / لَا نِهَائِيّ, لَا يُحْصَى (عَظِيمٌ بِلَا حُدُودٍ فِي العَدَدِ) / لَا نِهَائِيّ, لَا يَنْتَهِي (طَويل بِشَكْل مُمِلّ؛ يَبْدو بِلا نِهايَة)",
 "止めどなく": "إِلى مَا لَا نِهَايَة, بِلَا نِهَايَة (الاستمرار للأبد دون توقف) / بِلَا انْقِطَاع, بِلَا تَوَقُّف (بعزيمة لا تكل) / إِلَى مَا لَا نِهَايَة (طوال الوقت؛ يبدو بلا توقف) / إلى ما لا نهاية, بلا نهاية ((بالمعنى المكاني) يبدو أنه ليس له حدود)\nمثال: هناك احتمالات لا حصر لها",
 "止めにする": "وَقَفَ, تَوَقَّفَ (قَامَ، اِنْتَصَبَ، نَهَضَ؛ ثَبَتَ) / أَوْقَفَ, وَقَفَ / تَوَقَّفَ, وَقَّف / مَوْقِف / وَقْفَة\nمثال: وقف وراء الباب.",
 "止めに入る": "تَدَخَّلَ",
 "止める": "وَقَفَ, تَوَقَّفَ (قَامَ، اِنْتَصَبَ، نَهَضَ؛ ثَبَتَ) / أَوْقَفَ, وَقَفَ / تَوَقَّفَ, وَقَّف / مَوْقِف / وَقْفَة\nمثال: وقف وراء الباب. / حَدِيقَة (الحَديقَةُ، الرَّوْضَةُ ذاتُ الشجرِ؛ حديقة , العاطل عن العمل في اللهجة العراقية وأصل تولد المعنى أن بعض العاطلين يقضون أوقاتهم في العناية بحدائق بيوتهم, فإذا سألهم سائل عن عملهم, ما هو؟…) / وَقَّفَ, صَفَّ (قَامَ، اِنْتَصَبَ، نَهَضَ؛ ثَبَتَ)\nمثال: ليس لدينا حديقة. / مَنَعَ (حَرَمَ، ضد أَعْطَى؛ كَفَّ عنه وحَمَاه)\nمثال: تساهم جذور أشجار المنغروف في منع حدوث انجراف التربة. / لَاحَظَ / لَاحَظَ, اِنْتَبَهَ / وَقَفَ, تَوَقَّفَ (قَامَ، اِنْتَصَبَ، نَهَضَ؛ ثَبَتَ) / أَوْقَفَ, وَقَفَ / تَوَقَّفَ, وَقَّف / مَوْقِف / وَقْفَة\nمثال: وقف وراء الباب. / أَلْغَى, أَبْطَلَ / وَقَفَ, تَوَقَّفَ (قَامَ، اِنْتَصَبَ، نَهَضَ؛ ثَبَتَ) / أَوْقَفَ, وَقَفَ / تَوَقَّفَ, وَقَّف / مَوْقِف / وَقْفَة\nمثال: وقف وراء الباب. / دَبُّوس / حَدّ (مُنْتَهى الشيءِ؛ الْفَصْلُ بَيْنَ الشَّيْئَيْنِ لِئَلَّا يَخْتَلِطَ أَحدهما بِالْآخَرِ أَو لِئَلَّا يَتَعَدَّى أَحدهما عَلَى الْآخَرِ) / نِهَايَة / حَدَّ, حَدَّدَ (مُنْتَهى الشيءِ؛ الْفَصْلُ بَيْنَ الشَّيْئَيْنِ لِئَلَّا يَخْتَلِطَ أَحدهما بِالْآخَرِ أَو لِئَلَّا يَتَعَدَّى أَحدهما عَلَى الْآخَرِ)\nمثال: أعرفها إلى حد ما. / تَسْجِيل, مُدَوَّنَة / سِجِلّ, دَفْتَر (كتاب أو صحيفة تُسَجَّلُ فيها الأمور؛ الكاتب الذي يحفظ تلك الصحيفة أو السِجِلّ) / رَقْم قِيَاسِيّ (وضع أرقامًا على شيء ما للتنظيم أو التمييز) / سَجَّلَ (كتاب أو صحيفة تُسَجَّلُ فيها الأمور؛ الكاتب الذي يحفظ تلك الصحيفة أو السِجِلّ)\nمثال: سجل سامي وصوله.",
 "止め具": "زِلاَج, ضَبَّة",
 "止め処": "نِهَايَة, غَايَة / غَايَة / اِنْتَهَى, أَنْهَى (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات)\nمثال: انتهى أمر زيري.",
 "止め処なく": "إِلى مَا لَا نِهَايَة, بِلَا نِهَايَة (الاستمرار للأبد دون توقف) / بِلَا انْقِطَاع, بِلَا تَوَقُّف (بعزيمة لا تكل) / إِلَى مَا لَا نِهَايَة (طوال الوقت؛ يبدو بلا توقف) / إلى ما لا نهاية, بلا نهاية ((بالمعنى المكاني) يبدو أنه ليس له حدود)\nمثال: هناك احتمالات لا حصر لها",
 "止め処無い": "حَلَقِيّ, لَا نِهَائِيّ (مُتَّصِلُ الأَطْرَافِ بِحَيْثُ يُشَكِّلُ كُلًّا مُتَّصِلًا) / أَبَدِيّ, سَرْمَدِيّ (لَيْسَ لَهُ بِدَايَةٌ مَعْرُوفَةٌ وَلَا نِهَايَةٌ مُفْتَرَضَةٌ) / لَا نِهَائِيّ, لَا يُحْصَى (عَظِيمٌ بِلَا حُدُودٍ فِي العَدَدِ) / لَا نِهَائِيّ, لَا يَنْتَهِي (طَويل بِشَكْل مُمِلّ؛ يَبْدو بِلا نِهايَة)",
 "止め男": "مُخبر المراهنات (شخص يبيع النصائح حول المقامرة أو المضاربة (خاصة في سباق الخيل)) / دلال, سمسار (شخص يعلن للزبائن بطريقة وقحة بشكل خاص) / بائع تذاكر في السوق السوداء (شخص يشتري تذاكر لحدث ما لإعادة بيعها بربح) / حَكَم, مُحكِّم (شخص يتم اختياره للحكم والبت في قضية متنازع عليها)\nمثال: اعتُبر الناقد حكماً للأدب الحديث",
 "止め立て": "تقييد, كبح (فعل السيطرة عن طريق تقييد شخص ما أو شيء ما) / رادع, قيد (جهاز يؤخر حركة شيء ما) / بساطة, تقشف فني (الخلو من الزخرفة) / تحفظ, كبح (الانضباط في الأنشطة الشخصية والاجتماعية)\nمثال: التقييد غير القانوني للتجارة",
 "止め置き": "تَوْقِيف",
 "止め置く": "اِعْتَقَلَ (أمسك الأطراف وربطها، بمعنى عَقَلَ؛ أمسك ووضع في السجن أو المَعْقَل)\nمثال: اعتقل لقيادته و هو سكران.",
 "止め金": "إمساك, قبضة (فعل الإمساك) / مشبك (أداة تثبيت (مثل إبزيم أو خطاف) تستخدم لربط شيئين معاً)\nمثال: أرخى قبضته عن ذراعي",
 "止め釘": "توجل, مسمار تثبيت (مثبت يتكون من وتد أو مسمار أو قطعة عرضية يتم إدخالها في عروة في نهاية حبل أو سلسلة أو كابل لتثبيته بشيء ما (مثل حبل أو سلسلة أو كابل آخر)) / مفتاح تبديل, مفتاح قلاب (مفتاح مفصلي يمكن أن يتخذ أحد وضعين) / أمر تبديل, مفتاح تبديل (أي تعليمة تعمل بطريقة ما أولاً ثم بطريقة أخرى؛ فهي تشغّل شيئاً ما في المرة الأولى لاستخدامها ثم توقفه في المرة التالية)",
 "止め針": "دَبُّوس",
 "止処": "نِهَايَة, غَايَة / غَايَة / اِنْتَهَى, أَنْهَى (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات)\nمثال: انتهى أمر زيري.",
 "止宿": "إِقَامَة",
 "止瀉剤": "مضاد للإسهال (دواء يستخدم للسيطرة على الإسهال أو إيقافه)",
 "止瀉薬": "مضاد للإسهال (دواء يستخدم للسيطرة على الإسهال أو إيقافه)",
 "止男": "مُخبر المراهنات (شخص يبيع النصائح حول المقامرة أو المضاربة (خاصة في سباق الخيل)) / دلال, سمسار (شخص يعلن للزبائن بطريقة وقحة بشكل خاص) / بائع تذاكر في السوق السوداء (شخص يشتري تذاكر لحدث ما لإعادة بيعها بربح) / حَكَم, مُحكِّم (شخص يتم اختياره للحكم والبت في قضية متنازع عليها)\nمثال: اعتُبر الناقد حكماً للأدب الحديث",
 "止痛剤": "مسكن ألم (الموضع الذي يسكن فيه الإنسان بمعنى يُقيم؛ البَيْت أو الدار)\nمثال: كان دوري كي أنظف المسكن",
 "止痢剤": "مضاد للإسهال (دواء يستخدم للسيطرة على الإسهال أو إيقافه)",
 "止置き": "تَوْقِيف",
 "止置く": "اِعْتَقَلَ (أمسك الأطراف وربطها، بمعنى عَقَلَ؛ أمسك ووضع في السجن أو المَعْقَل)\nمثال: اعتقل لقيادته و هو سكران.",
 "止血": "إرقاء, قطع النزف (إجراء جراحي لوقف تدفق الدم)",
 "止血剤": "مُرْقِئ, مُوقِف لِلنَّزِيف (يميل إلى وقف النزيف عبر تقليص الأنسجة أو الأوعية الدموية)",
 "止血帯": "عاصِبَة",
 "止血薬": "مُرْقِئ, مُوقِف لِلنَّزِيف (يميل إلى وقف النزيف عبر تقليص الأنسجة أو الأوعية الدموية)",
 "止針": "دَبُّوس",
 "止音器": "كابح, مثبط (قيد يسبب الإحباط أو التثبيط) / كاتم, مخمّد (جهاز يقلل من سعة التذبذبات الإلكترونية أو الميكانيكية أو الصوتية أو الديناميكية الهوائية) / مخمد (لوحة حديدية متحركة تنظم تيار الهواء في موقد أو مدخنة أو فرن)\nمثال: وضع المطر كابحًا لخطط نزهتنا",
 "正": "حَقٌّ (اسم من الأسماء الحسنى وهو من صفات الله. لا جمع له؛ ضد البَاطِل، العَدْل والحَقِيْقَة والوُجُوْد الثَابِت والصِدْق والذي لا جدال فيه. لا جمع له)\nمثال: الأستاذ على حق. / أَصْلِيّ / مُوجَب / إِيجَابِيّ / صُورَة مُوجَبَة / أُطْرُوحَة / بِالضَّبْط, تَمَامًا / بِالْضَبْط / صَحِيح, صَوَاب / صَحَّحَ (جعل الشيء صحيحًا أو خاليًا من الأخطاء؛ أظهر صحة معلومة أو حقيقة)\nمثال: صحح نطقي من فضلك. / أَكْبَر, كُبْرَى (الأَكْبَر: هو ما فاق غيره في الكُبْر، ويكون ذلك إما بالحجم أو المقام أو كلاهما؛ للكُبْر)\nمثال: إنه أخي الأكبر. / مُدِير, مُدِيرَة (الشخص الذي أدار، جمعه مُدِيرُون ومُدِيرِين؛ مهنة يتولى صاحبها إدَارَة شؤون جهة ما. جمعه مُدَرَاء)\nمثال: زيري هو المدير. / مَضْبُوط, دَقِيق",
 "正々": "مَضْبُوط / دَقِيق (ضد الغَلِيْظ، الرَفِيْع الرَقِيْق؛ صغير الحجم جدا)\nمثال: ساعتي غير دقيقة.",
 "正しい": "يَمِين, يمين / صَحِيح, صَوَاب / قَائِم / عَلَى اَلْيَمِين (يفيد الاستعلاء؛ يفيد التعليل) / إِلَى اَلْيَمِين (حرف جر يُفيد الغاية الزمنية؛ حرف جر يُفيد الغاية المكانية) / صحيح, تمام / حَقّ, حُقُوق (اسم من الأسماء الحسنى وهو من صفات الله. لا جمع له؛ ضد البَاطِل، العَدْل والحَقِيْقَة والوُجُوْد الثَابِت والصِدْق والذي لا جدال فيه. لا جمع له) / صَحَّحَ (جعل الشيء صحيحًا أو خاليًا من الأخطاء؛ أظهر صحة معلومة أو حقيقة)\nمثال: أجب على السؤال. / سَلِيم, صَحِيح (ملائم لحالة أو غرض أو مناسبة أو لطبيعة الشخص واحتياجاته) / صحيح, لائق (يتميز بالملائمة أو الصواب أو المناسبة)\nمثال: علاج طبي مناسب",
 "正しく": "بِالتَّأْكِيد / بِالتَّأْكِيد, بِدُون شَكّ / عَدْل (عَدْل) / فَقَط (لا أكثر، لا غير)\nمثال: هل يعاملون بالعدل / يَمِين, يمين / صَحِيح, صَوَاب / قَائِم / عَلَى اَلْيَمِين (يفيد الاستعلاء؛ يفيد التعليل) / إِلَى اَلْيَمِين (حرف جر يُفيد الغاية الزمنية؛ حرف جر يُفيد الغاية المكانية) / صحيح, تمام / حَقّ, حُقُوق (اسم من الأسماء الحسنى وهو من صفات الله. لا جمع له؛ ضد البَاطِل، العَدْل والحَقِيْقَة والوُجُوْد الثَابِت والصِدْق والذي لا جدال فيه. لا جمع له) / صَحَّحَ (جعل الشيء صحيحًا أو خاليًا من الأخطاء؛ أظهر صحة معلومة أو حقيقة)\nمثال: أجب على السؤال.",
 "正す": "صَحِيح, صَوَاب / صَحَّحَ (جعل الشيء صحيحًا أو خاليًا من الأخطاء؛ أظهر صحة معلومة أو حقيقة)\nمثال: صحح نطقي من فضلك. / اِسْتَقَامَ (أَقَامَ نفسه)",
 "正に": "بِالضَّبْط, تَمَامًا / بِالْضَبْط / يَمِين, يمين / صَحِيح, صَوَاب / قَائِم / عَلَى اَلْيَمِين (يفيد الاستعلاء؛ يفيد التعليل) / إِلَى اَلْيَمِين (حرف جر يُفيد الغاية الزمنية؛ حرف جر يُفيد الغاية المكانية) / صحيح, تمام / حَقّ, حُقُوق (اسم من الأسماء الحسنى وهو من صفات الله. لا جمع له؛ ضد البَاطِل، العَدْل والحَقِيْقَة والوُجُوْد الثَابِت والصِدْق والذي لا جدال فيه. لا جمع له) / صَحَّحَ (جعل الشيء صحيحًا أو خاليًا من الأخطاء؛ أظهر صحة معلومة أو حقيقة)\nمثال: أجب على السؤال. / عَدْل (عَدْل) / فَقَط (لا أكثر، لا غير)\nمثال: هل يعاملون بالعدل / حَقًّا (حَقَا (حقاه) حقوا: أصاب حقوه، يقال ضربه فحقاه؛ (حَقَا)الشيء فلانا: بلغ حقوه، يقال نزل في الماء حتى حقاه فهو محقو ومحقي) / وَٱللّٰه؟ / لَيْسَ مَعْقُل!\nمثال: هو اغضبني حقا .",
 "正の数": "عَدَد مُوجَب (مِقْدَار مَا يُعَدّ)\nمثال: كم عدد سكان الجزائر؟",
 "正三角形": "مثلث متساوي الأضلاع (مضلع منتظم ثلاثي الأضلاع)",
 "正中": "مُنْتَصَف, وَسَط / وَسَط, مُتَوَسْط / نَزَاهَة, حِيَاد / إتمام, إكمال (إجراء ختامي أو نهائي) / تتويج, ذروة (اللحظة الحاسمة في رواية أو مسرحية) / بلوغ القمة, عبور الزوال ((في الفلك) أعلى نقطة سماوية لجرم سماوي فوق أفق المراقب) / أوج, ذروة (مرحلة الذروة النهائية)\nمثال: مشهد فراش الموت هو ذروة المسرحية",
 "正二十面体": "عشروني سطوح منتظم (عشروني سطوح ذو عشرين مثلثاً متساوي الأضلاع كأوجه)",
 "正五角形": "خماسي منتظم, مخمس منتظم (مخمس تكون فيه جميع الزوايا متساوية وجميع الأضلاع متساوية)",
 "正体": "مُطَابَقَة / هُوِيَّة / وَعْي (الفَهْم والتَدَبُّر واِحْتِوَاء كل معاني الشيء؛ في علم النفس: حالة وعي ويعني أيضا محتوى العقل، ويشمل المشاعر والوعي الذاتي وٱلصور وَالأفكار وَٱلقدرة على إدراك العلاقة بين المرء وٱلبيئة والشعور بما…) / شُعُور\nمثال: إنها فاقدة الوعي.",
 "正体不明": "غير قابل للتعرف عليه, مجهول الهوية (يستحيل التعرف عليه أو تحديده)",
 "正値性": "عَدَم قَابِلِيَّة الدَّحْض, قَطْعِيَّة (صفة كون الشيء غير قابل للإنكار ولا يستحق الجدال حوله) / إيجابية (كمية أكبر من الصفر) / إِيجَابِيَّة, مُوَاتَاة (صفة كون الشيء مشجعاً أو مبشراً بنتيجة ناجحة) / إِيجَابِيَّة, يَقِين (صفة أو حالة تتميز باليقين أو القبول أو التأكيد والتوكيد الجازم)",
 "正八胞体": "تسراكت, مكعب فائق (النظير رباعي الأبعاد للمكعب)",
 "正八面体": "ثماني سطوح منتظم (ثماني سطوح ذو ثمانية مثلثات متساوية الأضلاع كأوجه)",
 "正六面体": "سداسي سطوح منتظم, مكعب (سداسي سطوح له ستة مربعات متساوية كأوجه)",
 "正典": "الأسفار القانونية (مجموعة الكتب المقبولة ككتب مقدسة، وخاصة كتب الكتاب المقدس المعترف بها من قبل أي كنيسة مسيحية على أنها أصلية وموحى بها) / قائمة القديسين, قانون كنسي (قائمة كاملة بالقديسين المعترف بهم من قبل الكنيسة الكاثوليكية الرومانية) / قَانُون, مِعْيَار (قاعدة أو مجموعة قواعد أو مبادئ معترف بصحتها وأساسيتها عموماً في مجال الفن أو الفلسفة) / كانون (قطعة موسيقية طباقية يتم فيها تقليد اللحن في جزء واحد تماماً في أجزاء أخرى)\nمثال: القانون الكلاسيكي الجديد",
 "正典化": "إعلان القداسة (فعل قبول شخص متوفى في قائمة القديسين)",
 "正円窓": "نافذة مدورة (نافذة تؤدي إلى القوقعة)",
 "正切": "مُمَاسّ",
 "正則": "صَحِيح, صَوَاب / صَحَّحَ (جعل الشيء صحيحًا أو خاليًا من الأخطاء؛ أظهر صحة معلومة أو حقيقة)\nمثال: صحح نطقي من فضلك. / عَكُوْسَة",
 "正則化": "تسوية, تنظيم (فعل تحقيق التوحيد؛ جعله منتظماً) / تسوية, تنظيم (حالة ما تم جعله نظامياً (أو أكثر انتظاماً))",
 "正割": "قَاطِع",
 "正北": "الشَّمَال (نقطة البوصلة الأصلية التي تكون عند 0 أو 360 درجة)",
 "正十二面体": "اثنا عشري سطوح منتظم (اثنا عشري سطوح ذو اثني عشر مخمساً منتظماً كأوجه)",
 "正午": "ظهر, ظَهِيرَة (مصدر للفعل ظَهَرَ؛ خلاف البَطْن، الجزء الظَاهِر من الشيئ وغير البَاطِن)\nمثال: عنده حقيبة ظهر.",
 "正南": "الجَنُوب (نقطة البوصلة الأصلية التي تكون عند 180 درجة)",
 "正号": "عَلَامَة زَائِد, عَلَامَةُ جَمْع (سِمَةٌ أو أمارة أو شِعَار تُعرف به الأشياء؛ رَمْز)\nمثال: تحصلت على علامة أ.",
 "正味": "شَبَكَة, شبكة / اَلْوَزْن اَلصَّافِي",
 "正味重量": "اَلْوَزْن اَلصَّافِي",
 "正員": "عُضْو, عِضْو (جُزْء من الجَسَد؛ مُشْتَرِك فِي جَمْعِيَّة أو شَرِكَة أو حِزْب أو نَادٍ) / عُضُو (جُزْء من الجَسَد؛ مُشْتَرِك فِي جَمْعِيَّة أو شَرِكَة أو حِزْب أو نَادٍ)\nمثال: اذكر كل عضو باسمه.",
 "正四面体": "رباعي سطوح منتظم (رباعي سطوح ذو أربعة أوجه مثلثة متساوية الأضلاع)",
 "正多角形": "مضلع منتظم (مضلع جميع أضلاعه وجميع زواياه متساوية)",
 "正多面体": "متعدد سطوح منتظم, مجسم أفلاطوني (أي واحد من خمسة مجسمات أوجهها مضلعات منتظمة متطابقة وزواياها متعددة السطوح متطابقة)",
 "正大": "إِنْصَاف (أخْذُ نِصْف الشيء أو وصول النصف؛ العَدْل والتَقْسِيم بالتساوي بدون أن يظلم أي من الطرفين)",
 "正妃": "ملكة قرينة (زوجة الملك الحاكم)",
 "正子": "مُنْتَصَف لَيْل, مُنْتَصَف اللَّيْل / مُنْتَصَف اَللَّيْل",
 "正孔": "ثَقْب, حُفْرة (فَجَّرَ أو خَرَقَ شيئًا بفتح فيه؛ نَفَذَ أو مرَّ عبر شيء) / تقب\nمثال: انه ثقب الاسود.",
