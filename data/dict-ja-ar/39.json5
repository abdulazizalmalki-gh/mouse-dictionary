 "押し上げ": "اِضْطِرَاب",
 "押し上げる": "تشجيع, دعم (فعل إعطاء الأمل أو الدعم لشخص ما)\nمثال: ساعدها بدفعة لتجاوز السياج",
 "押し上げポンプ": "مضخة ضغط (مضخة تستخدم لدفع السائل لأعلى وطرده تحت الضغط)",
 "押し並べて": "بشكل عام, عموماً (دون تمييز واحد عن الآخرين)\nمثال: هو مهتم بالثعابين بشكل عام",
 "押し付け": "فَرْض",
 "押し付けがましい": "اِنْتِهَازِيّ, مُلِحّ (يتسم بطموح عدواني ونشاط ومبادرة)",
 "押し倒す": "صَرَعَ (طَرَحَه على الأرض؛ أَرْدَاهُ قَتِيلاً وأَهْلَكَهُ)",
 "押し傷": "كَدَمَ",
 "押し入り": "لص منازل (لص يدخل مبنى بقصد السرقة)",
 "押し入る": "تَطَفَّلَ, تَدَخَّلَ",
 "押し入れ": "عَرِين, حُجْرَة (اِسْمٌ لِمَاْوَى الأَسَد)\nمثال: اقترب من الخزانة.",
 "押し出し": "بثق, طرد (الإخراج عن طريق تطبيق الضغط)\nمثال: خروج غير متوقع لمعجون الأسنان من قاع الأنبوب / حُضُور (حُضُور)\nمثال: الحضور هام جدا.",
 "押し出す": "إبراز ضوئي, منطقة مضيئة (منطقة من السطوع في الصورة)\nمثال: كان الجزء الأبرز في الجولة زيارتنا للفاتيكان",
 "押し切る": "هَزَمَ, غَلَبَ",
 "押し包む": "لِحَاف, بَطَّانِيَّة",
