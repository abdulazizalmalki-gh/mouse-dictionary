 "捨印": "استهلاك, صرف (عملية استهلاك شيء ما)",
 "捨場": "مَزْبَلَة, نُفَايَة (موضع تجميع الأَزْبَال والتِفَايَات لحين نقلها؛ حَاوِيَة نفايات؛ موضع خارج…)\nمثال: وضع فاضل جثة دانية في مزبلة.",
 "捨売り": "إغراق (بيع البضائع في الخارج بسعر أقل من السعر المفروض في السوق المحلية)",
 "捨子": "لَقِيط, مَلْقُوط",
 "捨札": "تخلص, رمي (التخلص من شيء يعتبر عديم الفائدة أو غير مرغوب فيه) / لَوْحَة إِعْلَانَات",
 "捨石": "تَضْحِيَة, قُرْبَان",
 "捨象": "تَجْرِيد, كِيَان مُجَرَّد (مفهوم عامّ يُستخلَص بانتزاع السمات المشتركة من أمثلة محدّدة)",
 "捨身": "تمثيل انفعالي, تنفيس حركي ((طب نفسي) عرض المشاعر المكبوتة سابقاً (غالباً في أفعال بدلاً من كلمات)؛ يعتبر…)",
 "捨鉢": "يَائِس, قَانِط",
 "捨駒": "تَضْحِيَة, قُرْبَان",
 "捩じくれる": "منحنى",
 "捩じり": "التواء, عزم الدوران\nمثال: قام البهلوان بالتواءات لا تصدق",
 "捩じ上げる": "لَوَى, بَرَمَ",
 "捩じ向ける": "لَوَى, بَرَمَ",
 "捩り": "مُحَاكَاة سَاخِرَة (تقليد أو محاولة إعادة عملية أو نظام موجود في الواقع بطريقة اصطناعية أو نموذجية)\nمثال: ويتم الآن طرح التساؤل التالي: هل يفهم الذكاء الصناعي اللغة الصينية حقيقة أم أنه يتم فقط محاكاة هذه المقدرة. / لُعْبَة اَلْكَلِمَات, جِنَاس (اللَعْبَة البَرْبَرية دواء عشبيّ)\nمثال: عنده لعبة يويو.",
 "捩り秤": "ميزان الالتواء (أداة قياس مصممة لقياس القوى الصغيرة عن طريق الالتواء الذي تمارسه على سلك رفيع)",
 "捩る": "لَوَى, بَرَمَ / اِلْتِوَاء / مُحَاكَاة سَاخِرَة (تقليد أو محاولة إعادة عملية أو نظام موجود في الواقع بطريقة اصطناعية أو نموذجية)\nمثال: ويتم الآن طرح التساؤل التالي: هل يفهم الذكاء الصناعي اللغة الصينية حقيقة أم أنه يتم فقط محاكاة هذه المقدرة. / لَوَى, بَرَمَ",
 "捩れ": "لَوَى, بَرَمَ / التواء, عزم الدوران\nمثال: قام البهلوان بالتواءات لا تصدق",
 "捩れ秤": "ميزان الالتواء (أداة قياس مصممة لقياس القوى الصغيرة عن طريق الالتواء الذي تمارسه على سلك رفيع)",
 "捩向ける": "لَوَى, بَرَمَ",
 "据える": "مَيْدَان\nمثال: هذا المكان مقدس / رَكَّبَ (عَلَى أو أعْتَلَى شيئا؛ السَيَّارَة أو وسيلة نقل أخرى، استخدمها في تنقله بدلا…)\nمثال: ركب ياني سفينة. / اِسْتَعْمَرَ (اِسْتَعْمَرَ الاِسْتِعْمارُ الفَرَنْسِيُّ البِلادَ بِالسِّلاَحِ: دَخَلَها…)\nمثال: استقر زيري في خيمته. / وَضَعَ (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه)\nمثال: لقد أزمت الوضع.",
 "据え付け": "تثبيت, تركيب (فعل تثبيت شيء ما (مثل المعدات))\nمثال: استغرق تركيب الهاتف بضع دقائق فقط",
 "据え付ける": "رَكَّبَ (عَلَى أو أعْتَلَى شيئا؛ السَيَّارَة أو وسيلة نقل أخرى، استخدمها في تنقله بدلا…)\nمثال: ركب ياني سفينة.",
 "据え物": "حِلْيَة / جَسَد مَيِّت, جُثَّة (جسم طبيعي يتكون من حيوان أو إنسان ميت)\nمثال: وجدوا الجثة في البحيرة",
 "据え置き": "إرجاء, تأجيل (فعل التأجيل إلى وقت لاحق) / مَحْكُومٌ عَلَيْه, مَلْعُون (مُعرَّض لعذاب جهنم الأبدي)",
 "据え置き型": "سَطْح الْمَكْتَب (سَطحَهُ يَسْطَحَ سَطْحًا: بَسَطَهُ وسَوّاه؛ فهو مَسْطُوحٌ، وسَطِيحٌ)\nمثال: هناك ثقوب على السطح.",
 "据え置き期間": "فترة السماح",
 "据わる": "مَكَثَ, بَقِيَ / أَهْدَأَ, هَدَّأَ",
 "据付": "تثبيت, تركيب (فعل تثبيت شيء ما (مثل المعدات))\nمثال: استغرق تركيب الهاتف بضع دقائق فقط",
 "据付ける": "رَكَّبَ (عَلَى أو أعْتَلَى شيئا؛ السَيَّارَة أو وسيلة نقل أخرى، استخدمها في تنقله بدلا…)\nمثال: ركب ياني سفينة.",
 "据置き": "إرجاء, تأجيل (فعل التأجيل إلى وقت لاحق) / مَحْكُومٌ عَلَيْه, مَلْعُون (مُعرَّض لعذاب جهنم الأبدي)",
 "据置き型": "سَطْح الْمَكْتَب (سَطحَهُ يَسْطَحَ سَطْحًا: بَسَطَهُ وسَوّاه؛ فهو مَسْطُوحٌ، وسَطِيحٌ)\nمثال: هناك ثقوب على السطح.",
 "据置型": "سَطْح الْمَكْتَب (سَطحَهُ يَسْطَحَ سَطْحًا: بَسَطَهُ وسَوّاه؛ فهو مَسْطُوحٌ، وسَطِيحٌ)\nمثال: هناك ثقوب على السطح.",
 "据置期間": "فترة السماح",
 "捲く": "رِيح, ريح / مُغَلَّف, لِفَافَة / تَنُّورَة, جُوب / وَصْلَة",
 "捲し上げる": "سيف ذو حدين (سيف مستقيم بنصل ضيق وحدين)",
 "捲り上げる": "سيف ذو حدين (سيف مستقيم بنصل ضيق وحدين) / رَفَعَ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ)\nمثال: رفع سامي نظارته.",
 "捲る": "قَلَبَ / خَلَعَ (نَزَعَ، أَزَالَ إلا أنَّ في الخَلْعِ مُهْلَةً (لسان العرب)؛ عَزَلَ)\nمثال: خلع سامي حذاءه.",
 "捲線": "تدوير, ملء (عملية التدوير أو اللف)\nمثال: وضع المفتاح في الساعة القديمة وأعطاها تدويراً جيداً",
 "捲縮": "تَجْعِيدَة (خصلة شعر تم تمويجها أو تجعيدها صناعياً)\nمثال: طية في المنديل",
 "捷し": "حَادّ (مَالَ وَانْحَرَفَ عَنِ الطَّرِيقِ؛ تَجَنَّبَ شَيْئًا أَوِ الْاِلْتِزَامَ…)\nمثال: عندك ذاكرة حادة. / شَدِيد / سَرِيع\nمثال: ينبح كلب في الحي. / سَنِين, مُرْهَف (له حافة قاطعة أو رأس حادّ)",
 "捷径": "اختصار, طريق مختصر (طريق أقصر من الطريق المعتاد)",
 "捷運": "نقل سريع (نظام نقل عام حضري يستخدم قطارات تحت الأرض أو مرتفعة)",
 "捺く": "زُبّ, زُبْر (في : اللحية أو مقدمها؛ في : الأنف) / خَزَّ (\"خَزَّهُ بسكِّينٍ\" : طَعَنَهُ بِهِ؛ \"خَزَّهُ بِبَصَرِهِ\" : أَصَابَتْهُ عَيْنُه)\nمثال: إذا كنت وخز لنا، هل نحن لا ينزف؟ / اِسْتِعْمَال, اِسْتِخْدَام (اِسْتِعْمَال)\nمثال: أيمكنني استعمال هاتفك؟ / حَمْلَة",
 "捺印": "خَتْم (أنهى الشيءَ وأتمّه؛ طبع بخاتم أو ختم رسميّ)\nمثال: ختم سامي القرآن في شهر رمضان.",
 "捺染": "طِبَاعَة",
 "捻くり回す": "لَوَى, بَرَمَ / إعادة كتابة, تنقيح (شيء تمت كتابته مرة أخرى)\nمثال: كانت إعادة الكتابة أفضل بكثير",
 "捻くる": "برم, دوران سريع (عملية الدوران بسرعة)\nمثال: أدار الكرنك بقوة / تَغَيَّرَƒ\nمثال: أنا غير متفاجئ.",
 "捻くれる": "ثَنَى (طوى شيئًا وجعله على شكل مزدوج؛ أعاد النظر أو غير مسار قراره أو تصرفه) / بوز, حرد (مزاج أو إظهار للترفع العبوس أو الانسحاب)\nمثال: بقي في المنزل في حالة حرد",
 "捻くれ者": "عبوس, متجهم (شخص ذو تعبير وجه كئيب أو عابس بشكل معتاد)",
 "捻じくれる": "منحنى",
 "捻じ上げる": "لَوَى, بَرَمَ",
 "捻じ向ける": "لَوَى, بَرَمَ",
 "捻じ曲がる": "لَوَى, بَرَمَ",
 "捻じ曲げる": "لَوَى, بَرَمَ / شَوَّهَ",
 "捻じ込む": "اِعْتَرَضَ, اِحْتَجَّ (سار عارضا بدون هدف وتخطيط كما تكون الخشبة الطافية في الماء؛ الشيءَ أو الشخصَ:…)\nمثال: اعترض ديما: \"لكن هذا سخيف! الكوبيكات لم تعد تستخدم منذ عصور! و0.99 ليس رقما طبيعيا حتى!\"",
 "捻づ": "لَوَى, بَرَمَ",
 "捻り": "لَوَى, بَرَمَ / براعة, ذكاء (خاصية كون الشخص بارعاً)\nمثال: حبكة ذات براعة كبيرة",
 "捻り出す": "وصية عقارية ((قانون) هبة لممتلكات عقارية بموجب وصية)",
 "捻る": "لَوَى, بَرَمَ / خَنَقَ (خَنَقَ (خنقه) خنقا: عصر حلقه حتى مات؛ خَنَقَ الوقت: أخره وضيقه)\nمثال: خنق زيري وليد بعمامته. / نَبْض\nمثال: ضرب سامي زوجته. / لَوَى, بَرَمَ / اِلْتِوَاء",
 "捻れ": "لَوَى, بَرَمَ / التواء, عزم الدوران\nمثال: قام البهلوان بالتواءات لا تصدق",
 "捻出": "أَدَارَ (دَارَ نصف دورة فقط؛ الشيء: جعله يدور؛ فعل تعدّي من دَارَ)\nمثال: أدار فاضل مقبض الباب بهدوء و دخل إلى المنزل. / إسهاب, بلورة (التطوير بتفاصيل معقدة ومضنية)",
 "捻向ける": "لَوَى, بَرَمَ",
 "捻挫": "اِلْتِوَاء",
 "捻転": "برم, دوران سريع (عملية الدوران بسرعة)\nمثال: أدار الكرنك بقوة",
 "捻髪音": "طقطقة, فرقعة (الصوت الحاد لأصوات الانكسار)",
 "掃きだめ": "كومة خردة, كومة قمامة (تراكم للنفايات والمواد المهملة)",
 "掃き溜め": "كومة خردة, كومة قمامة (تراكم للنفايات والمواد المهملة)",
 "掃く": "مَسَحَ (مَرَّ عليه بكفه وهو يلامسه؛ مَحَا، مرَّ عليه بكفه حتى يُزيله)\nمثال: مسح توم الطاولة.",
 "掃射": "تمشيط جوي, قصف جوي منخفض (هجوم بنيران الرشاشات أو نيران المدافع من طائرة تحلق على علو منخفض)\nمثال: نفذوا في صباح اليوم التالي تمشيطاً جوياً لمطارات العدو",
 "掃引": "كنس (فعل التنظيف بالمكنسة)",
 "掃海": "تطهير الألغام, كسح الألغام (نشاط الكشف عن الألغام البحرية والتخلص منها)",
 "掃海艇": "كانسة الألغام",
 "掃海艦": "كانسة الألغام",
 "掃溜": "كومة خردة, كومة قمامة (تراكم للنفايات والمواد المهملة)",
 "掃溜め": "كومة خردة, كومة قمامة (تراكم للنفايات والمواد المهملة)",
 "掃滅": "إِفْنَاء, تَدْمِير",
 "掃除": "تَنْظِيف",
 "掃除人": "بَوَّاب",
 "掃除器": "مِكْنَسَة كَهْرَبَائِيَّة / أداة تنظيف, معدات تنظيف (أي أداة من فئة كبيرة من الأدوات المستخدمة للتنظيف)",
 "掃除婦": "عاملة نظافة (أنثى بشرية موظفة للقيام بالأعمال المنزلية)\nمثال: ستنظف عاملة النظافة السجاد",
 "掃除屋": "مُنَظِّف / سماد بشري, فضلات بشرية (فضلات بشرية تستخدم كسماد)",
 "掃除機": "مِكْنَسَة كَهْرَبَائِيَّة",
 "掃除機をかける": "خَلَاء, فَرَاغ (المكان الخالي من الناس، غالبا ما يقصد به الأماكن غير المزروعة والتي تركت طبيعية…)\nمثال: حبب إليه الخلاء.",
 "掃除機を掛ける": "خَلَاء, فَرَاغ (المكان الخالي من الناس، غالبا ما يقصد به الأماكن غير المزروعة والتي تركت طبيعية…)\nمثال: حبب إليه الخلاء.",
 "掃除用具入れ": "أداة تنظيف, معدات تنظيف (أي أداة من فئة كبيرة من الأدوات المستخدمة للتنظيف)",
 "授かりもの": "أَنِيس, رَفِيق (قريب جداً وأليف في العشرة)\nمثال: استمتع بنعم السلام",
 "授かり物": "أَنِيس, رَفِيق (قريب جداً وأليف في العشرة)\nمثال: استمتع بنعم السلام",
 "授ける": "مَنَحَ\nمثال: 聖霊がある方の上に下って、その上にとどまられるのが見えたなら、その方こそ聖霊によってバプテスマを授ける方である。 — الذي ترى الروح نازلا ومستقرا عليه فهذا هو الذي يعمد بالروح القدس. / عَلَّمَ (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "授与": "حكم بالتعويض, منح (منحة تقدمها محكمة قانونية)\nمثال: انتقد منح المحكمة للتعويض",
 "授乳": "رَضَاعَة طَبِيعِيَّة",
 "授受": "حَوَّلَ (جَعَلَ الشيءَ غير ما كان؛ نقل الشيء من موضع إلى آخر)\nمثال: رقصنا حول النار.",
 "授受特性": "نِيَّة",
