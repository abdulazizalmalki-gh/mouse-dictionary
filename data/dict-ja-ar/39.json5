 "憎気": "بغيض, كريه (يثير أو يستحق الكراهية) / حَقُود, خَبِيث (يتسم بالحقد والخبث)\nمثال: لا توجد رذيلة بغيضة عالمياً مثل الجحود",
 "憐がる": "شَفَقَة (وشَفِقَ على؛ الرحمة والعَطْف والحَنَان والحُنُوّ) / شَفِقَ ((شَفِقَ) منه، وعليه يَشْفَقَ شَفَقًا: خاف وحَذِرَ، فهو شَفِقٌ؛ (شَفِقَ) عليه: رَقَّ له وعطف عليه؛ فهو شَفِيقٌ)\nمثال: زيري مثير للشفقة.",
 "憐れ": "شَفَقَة (وشَفِقَ على؛ الرحمة والعَطْف والحَنَان والحُنُوّ) / شَفِقَ ((شَفِقَ) منه، وعليه يَشْفَقَ شَفَقًا: خاف وحَذِرَ، فهو شَفِقٌ؛ (شَفِقَ) عليه: رَقَّ له وعطف عليه؛ فهو شَفِيقٌ)\nمثال: زيري مثير للشفقة. / مُثِير لِلشَّفَقَة, مُزْرٍ (يُثِير مَزيجاً مِن الاحتقار والشَّفَقة) / بَائِس, مُثِيرٌ لِلشَّفَقَة (يَسْتَحِقُّ الشَّفَقَةَ أَوْ يَسْتَدْعِيهَا) / وَا حَسْرَتَاه, وَاهًا",
 "憐れみ": "شَفَقَة (وشَفِقَ على؛ الرحمة والعَطْف والحَنَان والحُنُوّ) / شَفِقَ ((شَفِقَ) منه، وعليه يَشْفَقَ شَفَقًا: خاف وحَذِرَ، فهو شَفِقٌ؛ (شَفِقَ) عليه: رَقَّ له وعطف عليه؛ فهو شَفِيقٌ)\nمثال: زيري مثير للشفقة.",
 "憐れむ": "شَفَقَة (وشَفِقَ على؛ الرحمة والعَطْف والحَنَان والحُنُوّ) / شَفِقَ ((شَفِقَ) منه، وعليه يَشْفَقَ شَفَقًا: خاف وحَذِرَ، فهو شَفِقٌ؛ (شَفِقَ) عليه: رَقَّ له وعطف عليه؛ فهو شَفِيقٌ)\nمثال: زيري مثير للشفقة.",
 "憐察": "شَفَقَة (وشَفِقَ على؛ الرحمة والعَطْف والحَنَان والحُنُوّ) / شَفِقَ ((شَفِقَ) منه، وعليه يَشْفَقَ شَفَقًا: خاف وحَذِرَ، فهو شَفِقٌ؛ (شَفِقَ) عليه: رَقَّ له وعطف عليه؛ فهو شَفِيقٌ)\nمثال: زيري مثير للشفقة.",
 "憐情": "رَحْمَة / شَفَقَة (وشَفِقَ على؛ الرحمة والعَطْف والحَنَان والحُنُوّ)\nمثال: زيري مثير للشفقة.",
 "憐愍": "شَفَقَة (وشَفِقَ على؛ الرحمة والعَطْف والحَنَان والحُنُوّ) / شَفِقَ ((شَفِقَ) منه، وعليه يَشْفَقَ شَفَقًا: خاف وحَذِرَ، فهو شَفِقٌ؛ (شَفِقَ) عليه: رَقَّ له وعطف عليه؛ فهو شَفِيقٌ)\nمثال: زيري مثير للشفقة.",
 "憐憫": "شَفَقَة (وشَفِقَ على؛ الرحمة والعَطْف والحَنَان والحُنُوّ) / شَفِقَ ((شَفِقَ) منه، وعليه يَشْفَقَ شَفَقًا: خاف وحَذِرَ، فهو شَفِقٌ؛ (شَفِقَ) عليه: رَقَّ له وعطف عليه؛ فهو شَفِيقٌ)\nمثال: زيري مثير للشفقة.",
 "憑き物": "روح شريرة (روح تميل لإحداث الضرر)",
 "憑く": "مَلَكَ, اِمْتَلَكَ (لغة في المَالِك، وهو الذي يَمْلِكُ؛ السُلْطَان الحَاكِم الذي يملك الأَرْض والبِلاد)\nمثال: زيري ملك لنفسه.",
 "憑み": "طَلَبَ (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى)) / طَلَب, مَسْأَلَة (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى))\nمثال: طلب زيري ورودا. / اتكال, اعتماد (يقين مبني على الخبرة السابقة) / اتكال, اعتماد (حالة الاعتماد على شيء ما)\nمثال: كتب الورقة مع اعتماد كبير على عمل علماء آخرين",
 "憑依": "مَسّ, تَلَبُّس / مُمْتَلَك / حَوْزَة, مُلْكِيّة / اِسْتِحْوَاذ / حِيَازَة / اِسْتِنَاد / إِدْمَان",
 "憑拠": "قَاعِدَة, أَسَاس",
 "憑物": "روح شريرة (روح تميل لإحداث الضرر)",
 "憔悴": "عظمية, هزال شديد (نحافة شديدة (عادة بسبب الجوع أو المرض))",
 "憖い": "باستهتار, بلا تفكير (إظهار عدم التفكير) / دون تفكير (بطريقة خالية من التفكير)\nمثال: عامل والديه باستهتار / فِي مُنْتَصَف الطَّرِيق (في نصف المسافة؛ في المنتصف) / مُنْتَصَف, وَسَط (على مسافة متساوية من الأطراف) / جُزْئِيّ, نِصْفِيّ (لا يشمل إلّا النصف أو جزءًا فقط) / فِي مُنْتَصَفِ الطَّرِيق (عِنْدَ نُقْطَةٍ وَسَطٍ بَيْنَ طَرَفَيْنِ)\nمثال: كان في منتصف السلم عندما سقط",
 "憚り": "تردد, تلكؤ (فعل التوقف بشكل غير مؤكد) / تثاقل, تردد (درجة معينة من عدم الرغبة) / تردد, تريث (تردد في الكلام أو العمل)\nمثال: كان هناك تردد في كلامه / إعاقة, عرقلة (فعل الإعاقة أو العرقلة أو المنع) / عائق, مانع (أي عائق يعرقل أو يكون مرهقاً) / عائق, عقبة (شيء غير مادي يتداخل مع أو يؤخر العمل أو التقدم) / دورة مياه, مغسلة (مرحاض (خاصة مرحاض في مكان عام))",
 "憚り様": "شُكْرًا, تِسْلَم",
 "憚る": "تَرَدَّدَ (الذهاب إلى المكان مرة أخرى إلى نفس المكان بصورة متكررة؛ عدم الاستقرار على رأي معين)\nمثال: قبل ماثيو بتردد.",
 "憤り": "مرارة",
 "憤ろしい": "مُثِير لِلْجُنُون, مُسْتَفِزّ (مزعج أو مثير للاستياء بشكل شديد)",
 "憤怒": "غَضَب / أَغْضَبَ / غَضِبَ",
 "憤悶": "غَضَب / أَغْضَبَ / غَضِبَ",
 "憤慨": "استنكار, سخط (شعور بالغضب المحق)",
 "憤懣": "غَضَب / أَغْضَبَ / غَضِبَ",
 "憤激": "حَنَق, غَيْظ ((حَنِقَ) عَلَيْهِ حنقا: اشْتَدَّ غيظه فَهُوَ حنق وحنيق) / حَنِق, مُغْتَاظ ((حَنِقَ) عَلَيْهِ حنقا: اشْتَدَّ غيظه فَهُوَ حنق وحنيق)",
 "憤然": "غَاضِب, غَضْبَان",
 "憧れ": "شَوْق (نزوعُ النَّفْس إِلى الشيء، أو تَعَلُّقها به؛ مصدر الفعل شَاقَ)\nمثال: سأشعر بالشوق إليك.",
 "憧れる": "اِشْتَاقَ",
 "憧憬": "شَوْق (نزوعُ النَّفْس إِلى الشيء، أو تَعَلُّقها به؛ مصدر الفعل شَاقَ)\nمثال: سأشعر بالشوق إليك.",
 "憩": "رَاحَة, اِسْتِرَاحَة / اِسْتَرَاحَ (اِرْتَاح؛ طلب الرَاحَة) / بَاقِيَّة / أَثَارَة\nمثال: عليك أخذ استراحة.",
 "憩い": "رَاحَة, اِسْتِرَاحَة / اِسْتَرَاحَ (اِرْتَاح؛ طلب الرَاحَة) / بَاقِيَّة / أَثَارَة\nمثال: عليك أخذ استراحة.",
 "憩う": "رَاحَة, اِسْتِرَاحَة / اِسْتَرَاحَ (اِرْتَاح؛ طلب الرَاحَة) / بَاقِيَّة / أَثَارَة\nمثال: عليك أخذ استراحة.",
 "憩室": "رتج (فتق من خلال الجدار العضلي لعضو أنبوبي (خاصة القولون))",
 "憩室炎": "التهاب الرتج (التهاب رتج في الجهاز الهضمي (خاصة القولون)؛ يتميز بتقلصات مؤلمة في البطن وحمى وإمساك)",
 "憫れ": "شَفَقَة (وشَفِقَ على؛ الرحمة والعَطْف والحَنَان والحُنُوّ) / شَفِقَ ((شَفِقَ) منه، وعليه يَشْفَقَ شَفَقًا: خاف وحَذِرَ، فهو شَفِقٌ؛ (شَفِقَ) عليه: رَقَّ له وعطف عليه؛ فهو شَفِيقٌ)\nمثال: زيري مثير للشفقة. / مُثِير لِلشَّفَقَة, مُزْرٍ (يُثِير مَزيجاً مِن الاحتقار والشَّفَقة) / بَائِس, مُثِيرٌ لِلشَّفَقَة (يَسْتَحِقُّ الشَّفَقَةَ أَوْ يَسْتَدْعِيهَا) / وَا حَسْرَتَاه, وَاهًا",
 "憫察": "تَعَاطُف / عَطْف (عِطْف: عُنُق، رَقبة؛ الجمع: أَعْطَافٌ، و عِطَافٌ، و عُطُوفٌ) / حُنُو",
 "憫然": "مُثِير لِلشَّفَقَة, مُزْرٍ (يُثِير مَزيجاً مِن الاحتقار والشَّفَقة) / بَائِس, مُثِيرٌ لِلشَّفَقَة (يَسْتَحِقُّ الشَّفَقَةَ أَوْ يَسْتَدْعِيهَا)",
 "憫諒": "شَفَقَة (وشَفِقَ على؛ الرحمة والعَطْف والحَنَان والحُنُوّ) / شَفِقَ ((شَفِقَ) منه، وعليه يَشْفَقَ شَفَقًا: خاف وحَذِرَ، فهو شَفِقٌ؛ (شَفِقَ) عليه: رَقَّ له وعطف عليه؛ فهو شَفِيقٌ)\nمثال: زيري مثير للشفقة.",
 "憮然": "خَائِب الأَمَل / ساخط, ساخطة",
 "憲兵": "شُرْطَة عَسْكَرِيَّة, الشُّرْطَة الْعَسْكَرِيَّة",
 "憲法": "تَكْوِين / دُسْتُور, نِظَام (قَاعِدَة) / دُسْتُور (قَاعِدَة)\nمثال: العدالة مضمونة في الدستور. / قَانُون, قَاعِدَة (مقياس كل شيء وطريقه؛ أمر كليّ ينطبق على جميع جزئياته التي تعرف أحكامها منه) / حُكْم, حُكُومَة (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ) / حَكَمَ (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ)\nمثال: ذكرني بالقانون.",
 "憲法上": "بُنْيَوِيّ / دُسْتُورِيّ / دستورياً (وفقاً للدستور)\nمثال: تم استبعاد هذا دستورياً",
 "憲法上の権利": "حَقّ دُسْتُورِيّ (اسم من الأسماء الحسنى وهو من صفات الله. لا جمع له؛ ضد البَاطِل، العَدْل والحَقِيْقَة والوُجُوْد الثَابِت والصِدْق والذي لا جدال فيه. لا جمع له)\nمثال: الأستاذ على حق.",
 "憲章": "مِيثَاق",
 "憶断": "فَرَضِيَّة, اِفْتِرَاض (مؤنث الفَرَضِيّ، وهو المنسوب إلى الفَرَض؛ الفَرَض، ما يُفْتَرَض من الأمور، خلاف الحَقِيقَة. كلمة حديثة) / تَخْمِين\nمثال: الحقائق تؤكد هذه الفرضية.",
 "憶測": "خَمَّنَ, حزر ((خَمَّنَ) الشَّيْء: خمنه فَهُوَ مخمن)\nمثال: خمن الصائب: \"إن كانوا من السراعيف، فنعم\".",
 "憶見": "فَرَضِيَّة, اِفْتِرَاض (مؤنث الفَرَضِيّ، وهو المنسوب إلى الفَرَض؛ الفَرَض، ما يُفْتَرَض من الأمور، خلاف الحَقِيقَة. كلمة حديثة) / تَخْمِين\nمثال: الحقائق تؤكد هذه الفرضية.",
 "憶説": "فَرْضِيَّة (مؤنث الفَرَضِيّ، وهو المنسوب إلى الفَرَض؛ الفَرَض، ما يُفْتَرَض من الأمور، خلاف الحَقِيقَة. كلمة حديثة)\nمثال: الحقائق تؤكد هذه الفرضية.",
 "憾み": "مرارة / نَدِمَ / تَأَسَّفَ (تأسُّف) / أَسَف (مصدر أسِفَ على / أسِفَ لـ / أسِفَ من؛ أَسَفِي شَدِيدٌ على ما بَدَرَ مِنِّي : نَدَمِي) / تَأَسُّف (تأسُّف)\nمثال: للأسف ذلك صحيح.",
 "憾む": "نَدِمَ / تَأَسَّفَ (تأسُّف) / أَسَف (مصدر أسِفَ على / أسِفَ لـ / أسِفَ من؛ أَسَفِي شَدِيدٌ على ما بَدَرَ مِنِّي : نَدَمِي) / تَأَسُّف (تأسُّف)\nمثال: للأسف ذلك صحيح.",
 "憾むらくは": "أَنَا آسِف, أَنَا آسِفَة",
 "懇": "نوع (صِنْف؛ في : وحدة تصنيفية أقل من الجنس) / حَنُون, لَطِيف\nمثال: انه نوع من الفطر. / أَلِيف, وَدُود (ذو مصالح أو مودة مشتركة؛ على صداقة راسخة) / حَمِيم, وَثِيق (يتميز بالمعرفة أو الصحبة أو الألفة الوثيقة) / ضَلِيع, مُطَّلِع (على دراية تامة عبر الدراسة أو التجربة) / أَلِيف, حَمِيمِيّ (يُوَفِّرُ جَوًّا دَافِئًا وَوُدِّيًّا وَغَيْر رَسْمِيّ)",
 "懇々": "جَدِّي, جَادّ / عَرْبُون",
 "懇ろ": "نوع (صِنْف؛ في : وحدة تصنيفية أقل من الجنس) / حَنُون, لَطِيف\nمثال: انه نوع من الفطر. / أَلِيف, وَدُود (ذو مصالح أو مودة مشتركة؛ على صداقة راسخة) / حَمِيم, وَثِيق (يتميز بالمعرفة أو الصحبة أو الألفة الوثيقة) / ضَلِيع, مُطَّلِع (على دراية تامة عبر الدراسة أو التجربة) / أَلِيف, حَمِيمِيّ (يُوَفِّرُ جَوًّا دَافِئًا وَوُدِّيًّا وَغَيْر رَسْمِيّ)",
 "懇切": "مراعٍ, مهتم بالآخرين (يظهر اهتماماً بحقوق ومشاعر الآخرين)\nمثال: أصدقاء مراعون بما يكفي ليتركونا وحدنا",
 "懇到": "أَدِيب, مُؤَدَّب",
 "懇情": "حب المساعدة, طيبة (ود يتضح من خلال طبع طيب ومحب للمساعدة)",
 "懇意": "صَدَاقَة (المَحَبَّة بالصِّدْق. هي العِلاقَة بين شخصين أو أكثر قائِمَة على المحبة والصدق فكل منهم يحب الآخر ويَصْدُقه ويُصَدِّقه، كل منهم هو صَدِيق للآخر)\nمثال: الغيرة عدوة الصداقة. / إِحْسَان",
 "懇意になる": "تَعَرَّفَ",
 "懇懇": "جَدِّي, جَادّ / عَرْبُون",
 "懇望": "استجداء, توسل (طلب جاد أو عاجل)\nمثال: مناشدة لوقف القتال",
 "懇篤": "بَشُوش, لَطِيف (يَنْشُرُ الدِّفْء وَالوُدّ مِنْ حَوْلِه) / حَمِيم, وِدِّيّ (مَحْسُوس بِإِخْلَاص وَعُمْق) / لَطِيف, وَدِّيّ (دافئ وودّي بأدب ولباقة) / ليكير, مشروب كحولي حلو (مشروب قوي حلو ومنكه بشدة يُشرب عادة بعد الوجبة)",
 "懇親": "صَدَاقَة (المَحَبَّة بالصِّدْق. هي العِلاقَة بين شخصين أو أكثر قائِمَة على المحبة والصدق فكل منهم يحب الآخر ويَصْدُقه ويُصَدِّقه، كل منهم هو صَدِيق للآخر)\nمثال: الغيرة عدوة الصداقة.",
 "懇親会": "حدث اجتماعي, حفل (تجمع اجتماعي رسمي أو احتفال للناس)\nمثال: كانت الحفلة حدثاً مهماً حقاً",
 "懇話": "دَرْدَشَ / مُحَادَثَّة / دَرْدَشَة",
 "懇談会": "جمع, حصد (فعل جمع شيء ما) / اِحْتِشَاد, تَجَمُّع (الفعل الاجتماعي المتمثل في التجمع) / زم, كشكشة (خياطة تتكون من طيات صغيرة أو تجاعيد مصنوعة بسحب خيط بإحكام في خط خياطة) / تجمع, تجمهر (مجموعة من الأشخاص مجتمعين معاً في مكان واحد)\nمثال: طالبوا بالحق في التجمع / حلقة نقاش, ندوة (خطاب في اجتماع أكاديمي أو ندوة) / حَلَقَة نِقَاشِيَّة, مُؤْتَمَر عِلْمِيّ (اجتماع أكاديمي أو ندوة يقودها عادة محاضر مختلف وتتناول موضوعاً مختلفاً في كل اجتماع)",
 "懇請": "اِلْتِمَاس, اِسْتِئْنَاف / اِسْتَأْنَفَ",
 "懇願": "مُرَافَعَة",
 "懈怠": "كَسَل / إساءة أداء, سوء تصرف (أداء عمل مشروع بطريقة خاطئة أو ضارة)",
 "懊悩": "عذاب, غم (ضيق عقلي شديد) / ألم شديد, كمد (ضيق شديد في الجسم أو العقل)",
 "懊悩煩悶": "عذاب, غم (ضيق عقلي شديد) / ألم شديد, كمد (ضيق شديد في الجسم أو العقل)",
 "懐": "ثَدْي / بَلَغَ / قَلْب, فُؤَاد / قَلْب / كُبَّا / عَقْل (أمسك بأطرافه وربطه، أصلها للشاة والإبل حيث تربط قوائمها كي تبقى باركة فلا تقوم؛ بلغ العَقْل، أصبح عاقلا فاهما راشدا)\nمثال: هي فتاة تسحر العقل.",
 "懐い": "عَزِيز, عَزِيْزَة (القوي المنيع، ضد الذليل؛ القليل النادر العالي القيمة) / غَالِي, غَالِيَّة\nمثال: هذه رسالة من شخص عزيز.",
 "懐かし": "عَزِيز, عَزِيْزَة (القوي المنيع، ضد الذليل؛ القليل النادر العالي القيمة) / غَالِي, غَالِيَّة\nمثال: هذه رسالة من شخص عزيز.",
 "懐かしい": "عَزِيز, عَزِيْزَة (القوي المنيع، ضد الذليل؛ القليل النادر العالي القيمة) / غَالِي, غَالِيَّة\nمثال: هذه رسالة من شخص عزيز.",
 "懐かしがる": "اِشْتَاقَ",
 "懐かしのメロディ": "أغنية قديمة (أغنية كانت مشهورة سابقاً)",
 "懐かしむ": "تَاقَ (اشتاقَ ومالَ بشدة إلى الشيء أو الشخص؛ تحركَ أو تطلعَ بشوق نحو أمر مرغوب) / اِشْتَاقَ",
 "懐が寂しい": "مَضِيق, مُعْسِر (لا يملك ما يكفي من المال لسدّ الحاجات الأساسية)",
 "懐が淋しい": "مَضِيق, مُعْسِر (لا يملك ما يكفي من المال لسدّ الحاجات الأساسية)",
 "懐が深い": "مُتَفَتِّح الذِّهْن, وَاسِع الأُفُق (يميل إلى احترام الآراء والمعتقدات التي تختلف عن آرائك ومعتقداتك) / غير قابل للصدمة, متفتح الذهن (لا يمكن أن يصاب بالصدمة (يتقبل كل شيء))\nمثال: قاضٍ واسع الأفق ولكنه منصف",
 "懐く": "أَخَذَ (تَنَاوَلَ الشيء بيده، تملكه أو تحكم فيه، بالقوة أو بدونها؛ أمْسَكَ بِالشيء. (يتعدى بالباء)) / أَخَذَ بِـ (تَنَاوَلَ الشيء بيده، تملكه أو تحكم فيه، بالقوة أو بدونها؛ أمْسَكَ بِالشيء. (يتعدى بالباء)) / اِتَّخَذَ / اِسْتَغْرَقَ / اِلْتَقَطَ\nمثال: أخذ الولد يبكي. / اِحْتَضَنَ, عَانَقَ / اِحْتِضَان, عِنَاق\nمثال: その子供は母親の腕の中に抱かれて安心した。 — أحس الطفل بالأمان بين ذراعي أمه. / مَلَكَ, اِمْتَلَكَ (لغة في المَالِك، وهو الذي يَمْلِكُ؛ السُلْطَان الحَاكِم الذي يملك الأَرْض والبِلاد) / تَنَاوَلَ (فعل مطاوعة من نَاوَلَ، ناولته فتناول؛ أخذ الشيء الذي ناولته إياه؛ الطعام والدواء: أكَلَه)\nمثال: زيري ملك لنفسه.",
 "懐こい": "بَشُوش, لَطِيف (يَنْشُرُ الدِّفْء وَالوُدّ مِنْ حَوْلِه) / لَطِيف المَزَاج, وَدُود (ميّال إلى إسعاد الآخرين وإرضائهم)",
 "懐しい": "جَدِير بِالْإِعْجَاب / حَنِين, نُوسْتَالْجِيّ (حزين لبُعده عن الأماكن المألوفة ويشتاق إليها) / فُضُولِيّ",
 "懐っこい": "بَشُوش, لَطِيف (يَنْشُرُ الدِّفْء وَالوُدّ مِنْ حَوْلِه) / لَطِيف المَزَاج, وَدُود (ميّال إلى إسعاد الآخرين وإرضائهم)",
 "懐にする": "مِلْك, نَفْس (لغة في المَالِك، وهو الذي يَمْلِكُ؛ السُلْطَان الحَاكِم الذي يملك الأَرْض والبِلاد) / مَلَكَ (لغة في المَالِك، وهو الذي يَمْلِكُ؛ السُلْطَان الحَاكِم الذي يملك الأَرْض والبِلاد)\nمثال: زيري ملك لنفسه. / أَخَذَ (تَنَاوَلَ الشيء بيده، تملكه أو تحكم فيه، بالقوة أو بدونها؛ أمْسَكَ بِالشيء. (يتعدى بالباء)) / أَخَذَ بِـ (تَنَاوَلَ الشيء بيده، تملكه أو تحكم فيه، بالقوة أو بدونها؛ أمْسَكَ بِالشيء. (يتعدى بالباء)) / اِتَّخَذَ / اِسْتَغْرَقَ / اِلْتَقَطَ\nمثال: أخذ الولد يبكي.",
 "懐に入る": "تَمَلَّقَ",
 "懐の深い": "مُتَفَتِّح الذِّهْن, وَاسِع الأُفُق (يميل إلى احترام الآراء والمعتقدات التي تختلف عن آرائك ومعتقداتك) / غير قابل للصدمة, متفتح الذهن (لا يمكن أن يصاب بالصدمة (يتقبل كل شيء))\nمثال: قاضٍ واسع الأفق ولكنه منصف",
 "懐メロ": "أغنية قديمة (أغنية كانت مشهورة سابقاً)",
 "懐中時計": "ساعة جيب (ساعة تُحمل في جيب ساعة صغير)",
 "懐中物": "جِزْدَان, جُزْدَان",
 "懐中花": "بِحَجْم الجَيْب (صغير بما يكفي لحمله في جيب الثوب) / صَغِير, مَحْدُود النِّطَاق (صَغير الحَجْم أَوْ مَحْدود في النِّطاق أَوْ الأَهَمِّيَّة)",
 "懐中鏡": "مرآة جيب, مرآة صغيرة (مرآة صغيرة محمولة باليد عادة ما تكون في علبة معدنية أو بلاستيكية مستديرة؛ تستخدم غالباً لتعديل المكياج خارج المنزل)",
 "懐中電灯": "مَشْعَل / شُعْلَة",
 "懐中電燈": "مَشْعَل / شُعْلَة",
 "懐刀": "خَنْجَر (السِكِّين الكبيرة لا تستخدم للطعام بل للحَرْب، وقيل هي السكين ذات الحدين) / أمين سر, خليل (شخص يُؤتمن على الأمور الخاصة)",
 "懐剣": "خَنْجَر (السِكِّين الكبيرة لا تستخدم للطعام بل للحَرْب، وقيل هي السكين ذات الحدين)",
 "懐古": "استدعاء, تذكر (عملية التذكر (وخاصة عملية استعادة المعلومات بجهد ذهني)) / استحضار الماضي, ذكريات (انطباع ذهني محفوظ ومستعاد من الماضي)\nمثال: لديه استدعاء كامل للحلقة",
 "懐古厨": "دقة قديمة, رجعي (محافظ قديم الطراز أو ممل في موقفه أو مظهره)\nمثال: قد تتهمني بأنني رجعي عجوز أحاول منع الشباب من الاستمتاع",
 "懐古的": "حَنِين, نُوسْتَالْجِيّ (حزين لبُعده عن الأماكن المألوفة ويشتاق إليها)",
 "懐妊": "حَمْل (رَفَعَ، أَقَلَّ)\nمثال: حمل سامي سلاحه.",
 "懐孕": "حَمْل (رَفَعَ، أَقَلَّ)\nمثال: حمل سامي سلاحه.",
 "懐手": "بطالة, تسكع (عدم القيام بعمل أو وظيفة) / بطالة, تراخ (سمة كون المرء عاطلاً بسبب العزوف عن العمل) / بُطْلَان, لَا أَسَاس (صفة الافتقار إلى الجوهر أو القيمة)\nمثال: تم التعرف بسرعة على بطلان تقريرهم",
 "懐抱": "اِحْتَضَنَ, عَانَقَ / اِحْتِضَان, عِنَاق / ثَدْي",
 "懐旧": "استدعاء, تذكر (عملية التذكر (وخاصة عملية استعادة المعلومات بجهد ذهني)) / استحضار الماضي, ذكريات (انطباع ذهني محفوظ ومستعاد من الماضي)\nمثال: لديه استدعاء كامل للحلقة",
 "懐旧談": "استدعاء, تذكر (عملية التذكر (وخاصة عملية استعادة المعلومات بجهد ذهني)) / استحضار الماضي, ذكريات (انطباع ذهني محفوظ ومستعاد من الماضي)\nمثال: لديه استدعاء كامل للحلقة",
 "懐柔": "ترضية, مصالحة (فعل الترضية والتغلب على عدم الثقة والعداء)",
 "懐疑": "شَكَّ ((شَكَّ) الشيءُ يَشُكُّ شَكًّا: لَصِقَ بعضُه ببعضَ واتَّصَلَ؛ (شَكَّ) القرابةُ: اتَّصَلَتْ) / شَكّ, شُبْهَة ((شَكَّ) الشيءُ يَشُكُّ شَكًّا: لَصِقَ بعضُه ببعضَ واتَّصَلَ؛ (شَكَّ) القرابةُ: اتَّصَلَتْ) / شُبْهَة\nمثال: إنها بلا شك محقة.",
 "懐疑主義": "ارتياب, شك (الشك في حقيقة شيء ما) / شكوكية, لاأدرية (عدم التصديق في أي ادعاءات بالمعرفة المطلقة)",
 "懐疑主義者": "شاك, متشكك (شخص يشك عادة في المعتقدات المقبولة)",
 "懐疑心": "ارتياب, شك (الشك في حقيقة شيء ما) / شكوكية, لاأدرية (عدم التصديق في أي ادعاءات بالمعرفة المطلقة)",
 "懐疑的": "شُكُوكِيّ",
 "懐疑論": "ارتياب, شك (الشك في حقيقة شيء ما) / شكوكية, لاأدرية (عدم التصديق في أي ادعاءات بالمعرفة المطلقة)",
 "懐胎": "حَبَل, حَمْل ((حَبَلَه): شَدّه بالحبْل؛ (حَبَلَه) الصَّيْدَ: نَصَب لَهُ الحِبَالةَ وصاده بهَا. وَيُقَال: حَبَلَت فُلَانَةُ فلَانًا: أوقعَتْه فِي شِباك حُبّها وسحَرته)\nمثال: حبل الكذب قصير.",
 "懐郷": "حَنِين, اِشْتِيَاق",
 "懐郷病": "حَنِين, اِشْتِيَاق",
 "懐銭": "مَصْرُوف جَيْب, مَصْرُوف",
 "懐香": "شَمَر ((شَمَرَ) يَشْمُرُ شَمْرًا: مَرَّ جادًّا؛ (شَمَرَ): مَشَى مُخْتالاً)",
 "懦夫": "جَبَان (شديد الخوف ممتنع عن الإقدام؛ ضد الشجاع)\nمثال: إيدير مجرد جبان.",
 "懦弱": "لَا مُبَالٍ (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: لا أحب المدرسة. / ضَعِيف",
 "懲らしめ": "تأنيب, توبيخ (عقاب لفظي) / تَأْدِيب, تَقْوِيم (توبيخ لارتكاب خطأ)",
 "懲らしめる": "عَاقَبَ, قَاصَصَ",
 "懲らす": "عَاقَبَ, قَاصَصَ",
 "懲りない": "مُتَعَنِّت, عَنِيد",
 "懲り懲り": "اِكتَفَى, مُكتَفٍ",
 "懲役刑": "حَبْس, سَجْن (مَنَعَ الشيءَ عن الفعلِ؛ أَمْسَكَ الشيءَ، قَبَضَ عَلَيْهِ)\nمثال: هو,البارحة حرر من الحبس.",
 "懲戒": "تَرْتِيب, اِنْضِبَاط (تنظيم الأشياء أو الأحداث في تسلسل معين أو وضعها في نظام؛ إعداد أو تجهيز شيء لتحقيق غاية معينة) / نِظَام (مَنْهَج، طَرِيقَة؛ تَرْتِيب واتِّسَاق)\nمثال: أعاد زيري ترتيب المطبخ كلية.",
 "懲戒処分": "عِقَاب, إِسْتِحْسَان (طَيْر من الجَوَارِح، أكبر التي تصيد منها يكنى بأبي الهَيْثَم ومعروف بحِدَّة البصر؛ حَجَر ناتئ في جَوْف البِئْر يخرق الدَلُو. ونادر)\nمثال: هو من تلقى العقاب الأكبر.",
 "懲治監": "إصْلاحِيّ, تَهْذيبِيّ (يَهْدِف إلى الإصْلاح والتَّهْذيب) / إصلاحية, دار رعاية الأحداث (مؤسسة إصلاحية لاحتجاز وتأديب وتدريب الأحداث أو المجرمين لأول مرة)",
 "懲罰": "تَرْتِيب, اِنْضِبَاط (تنظيم الأشياء أو الأحداث في تسلسل معين أو وضعها في نظام؛ إعداد أو تجهيز شيء لتحقيق غاية معينة) / نِظَام (مَنْهَج، طَرِيقَة؛ تَرْتِيب واتِّسَاق)\nمثال: أعاد زيري ترتيب المطبخ كلية.",
 "懲罰房": "حَبْس اِنْفِرَادِيّ (مَنَعَ الشيءَ عن الفعلِ؛ أَمْسَكَ الشيءَ، قَبَضَ عَلَيْهِ)\nمثال: هو,البارحة حرر من الحبس.",
 "懲罰的": "تأديبي, عقابي (يفرض عقوبة)\nمثال: عدالة عقابية",
 "懲罰的損害賠償": "تعويضات رادعة, تعويضات عقابية ((قانون) تعويض يزيد عن الأضرار الفعلية (شكل من أشكال العقاب الممنوح في حالات سوء السلوك المتعمد أو الخبيث))",
 "懶い": "خَامِلُ الهِمَّة, فَاتِر (يفتقر إلى الحيوية أو النشاط) / مُتْعِب, مُزْعِج (يُسَبِّب صُعُوبَةً أَوْ إِزْعَاجًا)",
 "懶惰": "بُطْء",
 "懶熊": "دب الكسلان (دب شائع خشن الشعر طويل الخطم من جنوب وسط آسيا)",
 "懸": "اِئْتِمَان / لَائِحَة (قانون مكتوب للإشارة إلى مواقف محددة وغرضه أن يمنع حدوث أمر معين أو يحث عليه؛ قانون وافق عليه الكونجرس (البرلمان الأمريكي)) / فَاتُورَة, حِسَاب / مِنْقَار\nمثال: من فضلك أضف اسمي إلى اللائحة. / علاقة (أي شيء يمكن تعليق شيء منه) / معلّق (عامل يعلق شيئاً ما) / تقريباً, حوالي ((للكميات) غير دقيق ولكنه قريب جداً من الصواب)\nمثال: استمر حوالي ساعة / بَيْن (ظرف مكان بمعنى وَسْط)\nمثال: مصيري بين يديك. / عَاشِر / عُشْر (الثَلَاثُ العُشَر: الليلة العاشرة والحادية عشر والثانية عشر من كل شهر قمري…)\nمثال: لدي عشرة أقلام. / فِي (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "懸かり": "بدء, مشاركة أساسية (دور للبدء (في لعبة في البداية)) / ابْتِدَائِيّ, انْطِلَاقِيّ (مُنَاسِبٌ لِبِدَايَةِ حَدَثٍ أَوِ انْطِلَاقَتِهِ) / جَاحِظ ((خاصة العيون) منتفخ أو بارز كما في حالة الخوف)\nمثال: حصل على بدايته لأن أحد الرماة الأساسيين كان في المستشفى / حَمْلَة / هَاجَمَ / سفيف الريشة (واحدة من الشعيرات المتوازية التي تبرز من العمود الرئيسي للريشة) / حسك, شوكة (نقطة فرعية تواجه عكس النقطة الرئيسية تجعل من الصعب إزالة رأس السهم أو الرمح) / شوكة (الجزء المدبب من الأسلاك الشائكة) / تهكم, نقد لاذع (ملاحظة عدوانية موجهة لشخص مثل قذيفة وتهدف إلى إحداث تأثير قوي)\nمثال: كانت كلمته الأخيرة 'اذهب للجحيم'",
 "懸け": "اِئْتِمَان / لَائِحَة (قانون مكتوب للإشارة إلى مواقف محددة وغرضه أن يمنع حدوث أمر معين أو يحث عليه؛ قانون وافق عليه الكونجرس (البرلمان الأمريكي)) / فَاتُورَة, حِسَاب / مِنْقَار\nمثال: من فضلك أضف اسمي إلى اللائحة. / علاقة (أي شيء يمكن تعليق شيء منه) / معلّق (عامل يعلق شيئاً ما) / تقريباً, حوالي ((للكميات) غير دقيق ولكنه قريب جداً من الصواب)\nمثال: استمر حوالي ساعة / بَيْن (ظرف مكان بمعنى وَسْط)\nمثال: مصيري بين يديك. / عَاشِر / عُشْر (الثَلَاثُ العُشَر: الليلة العاشرة والحادية عشر والثانية عشر من كل شهر قمري…)\nمثال: لدي عشرة أقلام. / فِي (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "懸ける": "عَلَّقَ / أَغْلَقَ الْخَطّ (ضد فَتَحَ؛ سَدَّ وسَكَّرَ؛ قد تستخدم بمعنى أَقْفَلَ؛ أغلقه بحيث لا يفتح إلا بمفتاح)\nمثال: أغلق الباب بغضب / لَبِسَ, اِرْتَدَى (خَلَطَ بحيث يصعب التمييز والفصل؛ الأمر: خلطه فاشتبه واضطرب)\nمثال: لبس سروالا نظيفا. / فَعَلَ, صَنَعَ (عَمِلَ وصَنَعَ، بعلم أو بدون علم، عن قصد أو دون قصد) / جَعَلَ (صَيَّرَ؛ أَنْشَأَ)\nمثال: ماذا فعل للحمي؟ / أَنْفَقَ, صَرَفَ / قَضَى",
 "懸け樋": "أنبوب, قناة (ممر (أنبوب أو نفق) يمكن أن تمر عبره المياه أو الأسلاك الكهربائية)\nمثال: تم توصيل الحواسيب من خلال نظام من القنوات",
 "懸け橋": "جِسْر (شَجُعَ، جرُؤ؛ أقدم على الخطر واجترأ) / قَنْطَرَة / كوبري / جسر (شَجُعَ، جرُؤ؛ أقدم على الخطر واجترأ) / قنطرة / بْرِيدْج\nمثال: اذهب إلى الجسر. / ممشى (مسار مخصص للمشي)\nمثال: بعد العاصفة الثلجية جرف الثلج من الممشى الأمامي",
 "懸け物": "رِهَان, مُرَاهَنَة",
 "懸け紙": "وَرَق تَغْلِيف (ما ينمو على النبات من الأعلى والجوانب بشكل صفائح ذات لون أخضر أو مائل إلى الخضرة. انظر الصورة؛ جلود رقاق يُكتَبُ عليها)\nمثال: هات ورقة بيضاء.",
 "懸け詞": "لُعْبَة اَلْكَلِمَات, جِنَاس (اللَعْبَة البَرْبَرية دواء عشبيّ)\nمثال: عنده لعبة يويو.",
 "懸り": "بدء, مشاركة أساسية (دور للبدء (في لعبة في البداية)) / ابْتِدَائِيّ, انْطِلَاقِيّ (مُنَاسِبٌ لِبِدَايَةِ حَدَثٍ أَوِ انْطِلَاقَتِهِ) / جَاحِظ ((خاصة العيون) منتفخ أو بارز كما في حالة الخوف)\nمثال: حصل على بدايته لأن أحد الرماة الأساسيين كان في المستشفى / حَمْلَة / هَاجَمَ / سفيف الريشة (واحدة من الشعيرات المتوازية التي تبرز من العمود الرئيسي للريشة) / حسك, شوكة (نقطة فرعية تواجه عكس النقطة الرئيسية تجعل من الصعب إزالة رأس السهم أو الرمح) / شوكة (الجزء المدبب من الأسلاك الشائكة) / تهكم, نقد لاذع (ملاحظة عدوانية موجهة لشخص مثل قذيفة وتهدف إلى إحداث تأثير قوي)\nمثال: كانت كلمته الأخيرة 'اذهب للجحيم'",
 "懸吊": "يُعَلِّق / تَعْلِيق",
 "懸命": "مُشْتَاق",
 "懸垂": "تمرين العقلة (تمرين للذراع يتم بسحب النفس للأعلى على قضيب أفقي حتى يصبح الذقن بمستوى القضيب) / مقهى على الطريق (مقهى على جانب الطريق خاصة لسائقي الشاحنات) / يُعَلِّق / تَعْلِيق",
 "懸垂下降": "هبوط بالحبال ((تسلق الجبال) هبوط جرف عمودي أو جدار باستخدام حبل مزدوج مثبت في نقطة أعلى وملفوف حول الجسم)",
 "懸垂分詞": "اسم فاعل معلق (اسم فاعل (عادة في بداية الجملة) يبدو وكأنه يعدل كلمة غير تلك المقصودة)",
 "懸垂線": "سِلْك (السِّلْكُ : الخيطُ الذي ينظَم فيه الخرز ونحوه، أَو الذي يخاط به؛ السِّلْكُ : خيط من معدن تسري فيه الكهرباء)\nمثال: هذا السلك ساخن.",
 "懸壅垂": "لَهَاة",
 "懸崖": "جُرْف (أخذ شيئًا وجرفه بعيدًا، أو سحب شيئًا بقوة؛ في : في بعض الحالات، قد تستخدم للإشارة إلى إزالة أو جرف شيء نحو مكان آخر)",
 "懸念": "قَلِقَ (شاعر بالقَلَق؛ تَحَرّك/اهتزاز/اضطراب في الوضع الطبيعي للشيء) / قَلَق (شاعر بالقَلَق؛ تَحَرّك/اهتزاز/اضطراب في الوضع الطبيعي للشيء)\nمثال: ليلى قلقة بشأنك.",
 "懸想": "مَوَدَّة / مُلْحَق / مُرْفَق (مَا يُتَّكَأُ عَلَيْهِ)\nمثال: يؤلمني ذراعي من الكتف إلى المرفق.",
 "懸想文": "رِسَالَةُ حُبٍّ",
 "懸架": "يُعَلِّق / تَعْلِيق",
 "懸樋": "أنبوب, قناة (ممر (أنبوب أو نفق) يمكن أن تمر عبره المياه أو الأسلاك الكهربائية)\nمثال: تم توصيل الحواسيب من خلال نظام من القنوات",
 "懸橋": "جِسْر (شَجُعَ، جرُؤ؛ أقدم على الخطر واجترأ) / قَنْطَرَة / كوبري / جسر (شَجُعَ، جرُؤ؛ أقدم على الخطر واجترأ) / قنطرة / بْرِيدْج\nمثال: اذهب إلى الجسر. / ممشى (مسار مخصص للمشي)\nمثال: بعد العاصفة الثلجية جرف الثلج من الممشى الأمامي",
 "懸濁": "يُعَلِّق / تَعْلِيق",
 "懸濁液": "يُعَلِّق / تَعْلِيق",
 "懸物": "رِهَان, مُرَاهَنَة",
 "懸紙": "وَرَق تَغْلِيف (ما ينمو على النبات من الأعلى والجوانب بشكل صفائح ذات لون أخضر أو مائل إلى الخضرة. انظر الصورة؛ جلود رقاق يُكتَبُ عليها)\nمثال: هات ورقة بيضاء.",
 "懸詞": "لُعْبَة اَلْكَلِمَات, جِنَاس (اللَعْبَة البَرْبَرية دواء عشبيّ)\nمثال: عنده لعبة يويو.",
 "懸賞": "سَلِيبَة / غَنِيمَة / جَائِزَة, مُكَافَأَة",
 "懸賞金": "جائزة مالية (أي أموال تُعطى كجائزة)",
 "懸軍万里": "بعثة, حملة عسكرية (حملة عسكرية مصممة لتحقيق هدف محدد في بلد أجنبي)",
 "懸軍長駆": "بعثة, حملة عسكرية (حملة عسكرية مصممة لتحقيق هدف محدد في بلد أجنبي)",
 "懸鉤子": "فْرَامْبْوَاز",
 "懸隔": "فَرْق, اِخْتِلَاف / فَرْق, فُرُوق / خِلاف, خِلافات / فَرْق / مَيَّزَ",
 "懺悔": "تَوْبَة",
 "懺悔室": "كرسي الاعتراف, كشك الاعتراف (كشك يجلس فيه الكاهن لسماع الاعترافات)",
 "懺悔録": "إِقْرَار, اِعْتِرَاف / طَائِفَة (مؤنث طَائِف؛ التي تطوفُ؛ القطعة أو الجزء من الشيء أو الواحدة منه)",
 "懺法": "إِقْرَار, اِعْتِرَاف / طَائِفَة (مؤنث طَائِف؛ التي تطوفُ؛ القطعة أو الجزء من الشيء أو الواحدة منه)",
 "懼る": "خَوْف, وَهَل / خَافَ, خَشِيَ (ضد أَمِنَ، خَشِي على نفسه أو ماله؛ فَزَعَ وخَشِيَ) / خَافَ عَلَى, خَشِيَ عَلَى (ضد أَمِنَ، خَشِي على نفسه أو ماله؛ فَزَعَ وخَشِيَ)\nمثال: خاف زيري نوعا ما.",
 "懾伏": "سُجُود",
 "懾服": "سُجُود",
 "戀": "حَبِيب, حَبِيبَة / أَحَبَّ, حب (مَالَ إلى الشيء أو الشخص، وَدَّه؛ للزَّرع: بَدا حَبُّه) / أَحَبَّ (مَالَ إلى الشيء أو الشخص، وَدَّه؛ للزَّرع: بَدا حَبُّه)\nمثال: لا أحب المدرسة.",
 "戈": "ذُو مِقْبَض طَوِيل (لَهُ مِقْبَض أَوْ يَد طَويلَة) / سِلَاح, أَسْلِحَة / جرمانيوم (عنصر بلوري رمادي هش وهو شبه فلز شبه موصل (يشبه السيليكون) يستخدم في الترانزستورات؛ يوجد في الجرمانيت والأرجيروديت)",
 "戈を収める": "دَفَنَ الأَحْقَادَ (دَفَنَهُ يَدْفِنُهُ: سَتَرَهُ، وواراه)\nمثال: دفن القط فضلاته.",
 "戌": "كَلْب, كلب (بمعنى ضربهُ بالكُلاب أو جعل لها كَلْبًا؛ سَيْر أحمر يُجعَل بين طرفي الأديم إذا خُرِز)\nمثال: كان الكلب ميتا.",
 "戌亥": "باتجاه الشمال الغربي (إلى أو باتجاه أو في الشمال الغربي) / شَمَال غَرْبِيّ (يقع في الشمال الغربي أو موجَّه نحوه) / قَادِم مِنَ الشَّمَال الغَرْبِيّ (قادم من اتجاه الشمال الغربي) / شمال غرب (موقع في الجزء الشمالي الغربي من بلد أو منطقة أو مدينة)",
 "戍卒": "حَامِيَة",
 "戎": "إقليمي, ريفي (من خصائص الأقاليم (الريف) أو سكانها) / إقليمي, ريفي (مكون من أو مرتبط بمقاطعة أو إقليم) / فلاح, قروي (شخص من الريف) / رئيس إقليمي ((الكنيسة الكاثوليكية) مسؤول مسؤول عن مقاطعة كنسية يعمل تحت الرئيس العام للرهبنة)\nمثال: ريفي ومساير للأعراف بعمق / أَجْنَبِيّ, أَجْنَبِيَّة",
 "戎克": "جُنْك",
 "戎器": "درع النبالة, شعار النبالة (الرموز الرسمية لعائلة أو دولة، إلخ) / أسلحة, تسليح (الأسلحة مجتمعة)",
 "戎葵": "ختمية (أي من نباتات طويلة متنوعة من جنس ألسيا؛ موطنها الشرق الأوسط ولكنها توطنت وزرعت على نطاق واسع لزهورها الكبيرة جداً والمتنوعة الألوان) / ألثيا, ختمية (أي من نباتات متنوعة من جنس ألثيا؛ تشبه ولكن بزهور أصغر من جنس ألسيا)",
 "戎馬": "حصان حرب (حصان يستخدم في الحرب) / عمل كلاسيكي مكرر (عمل فني (مقطوعة أو دراما) جزء من الذخيرة القياسية ولكنه أصبح مبتذلاً من كثرة التكرار) / محارب قديم, مخضرم (شخص ذو خبرة مر بالعديد من المعارك؛ أو شخص قدم خدمة طويلة)",
 "成さしめる": "أَكْرَهَ, أَجْبَرَ",
 "成し得る": "قَابِل لِلتَّحْقِيق, قَابِل لِلْإِنْجَاز (يمكن تحقيقه أو إنجازه؛ في حيّز الإمكان)",
 "成し遂げる": "أَدَّى",
 "成す": "صُورَة, شَكْل / اِسْتِمَارَة / شَكَّلَ ((شَكَلَ) الأمْرُ يَشْكُلُ شُكُولاً: الْتَبَسَ؛ (شَكَلَ) المريضُ: تماثَلَ)\nمثال: اجلس بشكل مريح. / خَلَقَ (أَنْشَأَ، أَوْجَدَ)\nمثال: زيري سيء الخلق. / أَدَّى / تَغَيَّرَƒ / غَيَّرَ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به) / تَغْيِير, تَبْدِيل / فَكَّة / بَاقٍ (باقٍ ، الباقِيٌ جمع باقون ( للعاقل ) وبَواقٍ ، مؤ باقية ، جمع مؤ باقيات وبَواقٍ؛ باقٍ إلَى الأبَدِ : خالِدٌ) / تَغْيِير\nمثال: أنا غير متفاجئ.",
 "成す術もない": "بِخَسَارَة (أقل من التكلفة)\nمثال: باع السيارة بخسارة",
 "成っていない": "غَيْر مَقْبُول, مَرْفُوض (غير مقبول؛ غير مرحب به) / غَيْرُ مَقْبُول (لا يكفي لتحقيق الرضا) / غَيْر مَقْبُول, مَرْفُوض (لا يتوافق مع الاستخدام اللغوي المعياري) / غَيْرُ مَقْبُول, مُسْتَحِيل ((يوصف به الأشخاص أو سلوكهم) غير مقبول أو معقول)\nمثال: كلمة غير مقبولة في المجتمع المهذب",
 "成ってない": "غَيْر مَقْبُول, مَرْفُوض (غير مقبول؛ غير مرحب به) / غَيْرُ مَقْبُول (لا يكفي لتحقيق الرضا) / غَيْر مَقْبُول, مَرْفُوض (لا يتوافق مع الاستخدام اللغوي المعياري) / غَيْرُ مَقْبُول, مُسْتَحِيل ((يوصف به الأشخاص أو سلوكهم) غير مقبول أو معقول)\nمثال: كلمة غير مقبولة في المجتمع المهذب",
 "成らず者": "بلطجي, فتوة (رجل قاسٍ ووحشي)",
 "成り": "رَقَّى ((رَقَى) المريضَ ونحوَهُ يَرْقِي رَقْيًا، ورُقِيًّا، ورُقْيَةً (بضم الراء وفتحها): عوَّذَه؛ يقال: باسم الله أَرقِيك واللهُ يَشفيك) / رَوَّجَ (رَوَّج الغُبارُ: دام؛ رَوَّج السِّلعةَ: جعلها تَرُوجُ)",
 "成りすまし": "تَنَكَّرَ / بَارُودِيَا, مُحَاكَاة سَاخِرَة (تكوين يقلد أو يحرف أسلوب شخص ما، عادة بطريقة فكاهية)",
 "成りすます": "اِنْتَحَلَ",
 "成り上がり": "كيب, نهوض بالركل (تمرين جمباز يبدأ من وضع تكون فيه الساقان فوق الجزء العلوي من الجسم والتحرك إلى وضع منتصب عن طريق تقويس الظهر وأرجحة الساقين للخارج وللأسفل مع دفع…) / حديث النعمة, متسلق طبقي (شخص صعد فجأة إلى وضع اقتصادي أعلى ولكنه لم ينل القبول الاجتماعي من الآخرين في تلك الطبقة) / متغطرس, مغرور (شخص متكبر أو وقح)",
 "成り上がり者": "كيب, نهوض بالركل (تمرين جمباز يبدأ من وضع تكون فيه الساقان فوق الجزء العلوي من الجسم والتحرك إلى وضع منتصب عن طريق تقويس الظهر وأرجحة الساقين للخارج وللأسفل مع دفع…) / حديث النعمة, متسلق طبقي (شخص صعد فجأة إلى وضع اقتصادي أعلى ولكنه لم ينل القبول الاجتماعي من الآخرين في تلك الطبقة) / متغطرس, مغرور (شخص متكبر أو وقح)",
 "成り代わる": "اِسْتَبْدَلَ, بَدَّلَ (اتخذ شيئا بدلا من شيء)\nمثال: استبدل ياني حنفية المطبخ.",
 "成り変わる": "تَغَيَّرَƒ / غَيَّرَ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به) / تَغْيِير, تَبْدِيل / فَكَّة / بَاقٍ (باقٍ ، الباقِيٌ جمع باقون ( للعاقل ) وبَواقٍ ، مؤ باقية ، جمع مؤ باقيات وبَواقٍ؛ باقٍ إلَى الأبَدِ : خالِدٌ) / تَغْيِير\nمثال: أنا غير متفاجئ.",
 "成り済まし": "تَنَكَّرَ / بَارُودِيَا, مُحَاكَاة سَاخِرَة (تكوين يقلد أو يحرف أسلوب شخص ما، عادة بطريقة فكاهية)",
 "成り済ます": "اِنْتَحَلَ",
 "成り立ち": "مَنْشَأ / مَنْبَع, مَنْشَأ / اَصْل / هَيْكَل",
 "成り行き": "طَبَق, وَجْبَة (جَعَلَ شيئًا يغطي شيئًا آخر بشكل كامل؛ نفَّذَ أمرًا أو خطةً عمليةً) / مَسار (المَسَار: اسم مكان من سارَ : مسلك ، طريق ؛ خَطُّ السَّيْر؛ مَسَار كوكب حول الشَّمس : مدار)\nمثال: هذا الطبق لذيذ. / أمر بسعر السوق (أمر لوسيط ببيع أو شراء أسهم أو سلع بسعر السوق السائد)",
 "成り行き任せ": "انجراف, تسكع (تجوال بلا هدف من مكان لآخر) / تَائِه, مُتَشَرِّد (يتنقّل باستمرار خاصّة من مسكن أو عمل لآخر)",
 "成り行き注文": "أمر بسعر السوق (أمر لوسيط ببيع أو شراء أسهم أو سلع بسعر السوق السائد)",
 "成り込む": "دَمَجَ (دمج الأشياء: جمعها وخلطها معًا؛ دمجهُ:جعله جزءًا من شيء أكبر منه)\nمثال: دمج فكرتين في فكرة.",
 "成り金": "كيب, نهوض بالركل (تمرين جمباز يبدأ من وضع تكون فيه الساقان فوق الجزء العلوي من الجسم والتحرك إلى وضع منتصب عن طريق تقويس الظهر وأرجحة الساقين للخارج وللأسفل مع دفع…) / حديث النعمة, متسلق طبقي (شخص صعد فجأة إلى وضع اقتصادي أعلى ولكنه لم ينل القبول الاجتماعي من الآخرين في تلك الطبقة) / متغطرس, مغرور (شخص متكبر أو وقح)",
 "成る": "صَارَ, أَصْبَحَ (انتقل من حال إلى أخرى. (فعل ناقص))\nمثال: صار \"توم\" منعزلا تماما. / بَرْهَنَ, أَثْبَتَ / نَجَحَ / تَغَيَّرَƒ / غَيَّرَ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به) / تَغْيِير, تَبْدِيل / فَكَّة / بَاقٍ (باقٍ ، الباقِيٌ جمع باقون ( للعاقل ) وبَواقٍ ، مؤ باقية ، جمع مؤ باقيات وبَواقٍ؛ باقٍ إلَى الأبَدِ : خالِدٌ) / تَغْيِير\nمثال: أنا غير متفاجئ.",
 "成るべくなら": "بالأحرى, يفضل (بشكل أكثر استعداداً أو رغبة)\nمثال: نظفه جيداً، يفضل بالماء الدافئ",
 "成るべく早く": "فِي أَقْرَب وَقْت مُمْكِن, فِي أَسْرَع وَقْت مُمْكِن (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "成る程": "بالفعل, حقاً ((تستخدم كصيغة تعجب) تعبير عن الدهشة أو الشك أو السخرية وما إلى ذلك) / بالفعل, جداً (في الحقيقة (غالباً ما تميل إلى التوكيد))\nمثال: يريد الزواج من رئيس الخدم؟ حقاً!",
 "成上り": "كيب, نهوض بالركل (تمرين جمباز يبدأ من وضع تكون فيه الساقان فوق الجزء العلوي من الجسم والتحرك إلى وضع منتصب عن طريق تقويس الظهر وأرجحة الساقين للخارج وللأسفل مع دفع…) / حديث النعمة, متسلق طبقي (شخص صعد فجأة إلى وضع اقتصادي أعلى ولكنه لم ينل القبول الاجتماعي من الآخرين في تلك الطبقة) / متغطرس, مغرور (شخص متكبر أو وقح)",
 "成人": "بَالِغ, رَاشِد\nمثال: その映画は成人しかみられない。 — هذا الفيلم للكبار فقط.",
 "成人向け": "بَالِغ, رَاشِد",
 "成人女性": "أنثى بالغة, امرأة (شخص بالغ أنثى (مقابل الرجل))\nمثال: كانت المرأة تدير المنزل بينما كان الرجل يصطاد",
 "成人年齢": "سِنّ الرُّشْد ((سَنَّ) السِّكِّينَ و نحْوَهُ يَسُنُّ سَنًّا: أَحَدَّهُ؛ فهو مسنون وسَنِين)\nمثال: هم في نفس السن.",
 "成人教育": "تعليم الكبار (دورة (عبر محاضرات أو بالمراسلة) للبالغين غير المنخرطين في دراسة رسمية)",
 "成人教育協会": "تعليم الكبار (دورة (عبر محاضرات أو بالمراسلة) للبالغين غير المنخرطين في دراسة رسمية)",
 "成人期": "بلوغ, سن الرشد (حالة (ومسؤوليات) الشخص الذي بلغ النضج) / رشد, سن البلوغ (الفترة الزمنية في حياتك بعد توقف نموك الجسدي واكتمال تطورك)",
 "成人男子": "ذكر بالغ, رجل (شخص بالغ ذكر (مقابل المرأة))\nمثال: كان هناك امرأتان وستة رجال في الحافلة",
 "成人男性": "ذكر بالغ, رجل (شخص بالغ ذكر (مقابل المرأة))\nمثال: كان هناك امرأتان وستة رجال في الحافلة",
 "成仏": "مُحْتَضَر, يَمُوت (في عملية الانتقال من الحياة أو التوقف عن الوجود) / اندثار, زوال (الوقت الذي ينتهي فيه شيء ما)\nمثال: رجل يحتضر",
 "成体": "بَالِغ, رَاشِد",
 "成分": "مُقَوِّم",
 "成分調整牛乳": "حليب متجانس (حليب تم تكسير جزيئات الدهون فيه وتوزيعها بانتظام حتى لا تطفو القشدة على السطح)",
 "成功": "نَجَاح / نَجَحَ",
 "成功報酬": "أتعاب مشروطة (أتعاب تُدفع فقط إذا كانت النتيجة ناجحة (كما هو الحال بالنسبة لخدمات المحامي))",
 "成功者": "نَجَاح",
 "成功裏": "نَجَاح",
 "成功裡": "نَجَاح",
 "成句": "اِصْطِلَاح, مُصْطَلَح / مَثَل, حِكْمَة (الشَبَه؛ النَظِير)\nمثال: قصدته مثل نكتة.",
 "成否": "نَتِيجَة",
 "成員": "عُضْو, عِضْو (جُزْء من الجَسَد؛ مُشْتَرِك فِي جَمْعِيَّة أو شَرِكَة أو حِزْب أو نَادٍ) / عُضُو (جُزْء من الجَسَد؛ مُشْتَرِك فِي جَمْعِيَّة أو شَرِكَة أو حِزْب أو نَادٍ)\nمثال: اذكر كل عضو باسمه.",
 "成因": "مَنْشَأ / مَنْبَع, مَنْشَأ / اَصْل",
 "成型": "صُورَة, شَكْل / اِسْتِمَارَة / شَكَّلَ ((شَكَلَ) الأمْرُ يَشْكُلُ شُكُولاً: الْتَبَسَ؛ (شَكَلَ) المريضُ: تماثَلَ)\nمثال: اجلس بشكل مريح. / اختيار الممثلين, توزيع الأدوار (اختيار الممثلين للعب أدوار معينة في مسرحية أو فيلم) / رمي الصنارة (فعل رمي خيط الصيد فوق الماء بواسطة صنارة وبكرة) / سبك, صب (فعل إنشاء شيء ما عن طريق صبه في قالب) / قالب, مصبوب (شيء تم تشكيله بواسطة قالب)",
 "成型炭": "قالب فحم (كتلة مصنوعة من الفحم النباتي أو غبار الفحم وتحرق كوقود)",
 "成婚": "زَوَاج, نِكَاح / زَوَاج / عُرْس, زِفَاف",
 "成宮": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "成家": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "成就": "إشباع, تحقيق (فعل إتمام شيء ما (كرغبة أو وعد)) / إنجاز, تحقيق الذات (شعور بالرضا لتحقيق رغباتك)",
 "成層": "تنضيد (وضع البذور في رمل رطب أو نشارة خشب لحفظها أو تعزيز الإنبات) / تراصف, تطبقات (فعل أو عملية ترتيب الأشخاص في طبقات أو شرائح اجتماعية) / تطبق (تكوين طبقي) / ترسب طبقي, تطبّق (التشكيل أو الترسيب في طبقات)",
 "成層圏": "سْتْرَاتُوسْفِير",
 "成島": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "成嶋": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "成年": "غَالِبِيَّة, أَغْلَبِيّة",
 "成年年齢": "سِنّ الرُّشْد ((سَنَّ) السِّكِّينَ و نحْوَهُ يَسُنُّ سَنًّا: أَحَدَّهُ؛ فهو مسنون وسَنِين)\nمثال: هم في نفس السن.",
 "成年者": "بَالِغ, رَاشِد",
 "成形": "صُورَة, شَكْل / اِسْتِمَارَة / شَكَّلَ ((شَكَلَ) الأمْرُ يَشْكُلُ شُكُولاً: الْتَبَسَ؛ (شَكَلَ) المريضُ: تماثَلَ)\nمثال: اجلس بشكل مريح. / اختيار الممثلين, توزيع الأدوار (اختيار الممثلين للعب أدوار معينة في مسرحية أو فيلم) / رمي الصنارة (فعل رمي خيط الصيد فوق الماء بواسطة صنارة وبكرة) / سبك, صب (فعل إنشاء شيء ما عن طريق صبه في قالب) / قالب, مصبوب (شيء تم تشكيله بواسطة قالب)",
 "成形手術": "جِرَاحَةْ تَجْمِيل",
 "成形炭": "قالب فحم (كتلة مصنوعة من الفحم النباتي أو غبار الفحم وتحرق كوقود)",
 "成敗": "عِقَاب, جَزَاء (طَيْر من الجَوَارِح، أكبر التي تصيد منها يكنى بأبي الهَيْثَم ومعروف بحِدَّة البصر؛ حَجَر ناتئ في جَوْف البِئْر يخرق الدَلُو. ونادر) / عُقُوبَة / عِقَاب (طَيْر من الجَوَارِح، أكبر التي تصيد منها يكنى بأبي الهَيْثَم ومعروف بحِدَّة البصر؛ حَجَر ناتئ في جَوْف البِئْر يخرق الدَلُو. ونادر)\nمثال: هو من تلقى العقاب الأكبر. / قَطْعُ الرَّأَس (قطع الشيء : جزه؛ قطع الشيء : فصل بعضه عن بعضه الآخر)\nمثال: قطع زيري العشب.",
 "成文": "كِتَابَة (الخَطّ أو ما كُتِبَ؛ ما يُكْتَبُ عموما) / كتبة (الكِتْبَةُ : الحالةُ؛ الكِتْبَةُ :الإكتتاب في الفَرْض والرزق)\nمثال: تعبت من الكتابة.",
 "成文化": "تصنيف, تقنين (فعل التقنين؛ الترتيب في نظام منهجي) / دستور, مدونة (مجموعة من القواعد أو المبادئ أو القوانين (وخاصة المكتوبة منها))",
 "成文律": "تشريع, قانون تشريعي (قانون تم سنه من قبل هيئة تشريعية)",
 "成文法": "قانون تشريعي (مجموعة القوانين التي تنشئها التشريعات البرلمانية)",
 "成書": "كِتَاب, سِفْر (موضع تعليم الكتابة. الاستخدام الأصلي؛ مدرسة شبه رسمية لتعليم الأطفال الكِتَابَة والقِرَاءَة ومباديء الحِسَاب وبعض القُرَآن…) / سِفْر (السَّفَرُ : قَطْعُ المسافة؛ هو مِنِّي سفَرٌ : بعيد) / سِجِل (كتاب أو صحيفة تُسَجَّلُ فيها الأمور؛ الكاتب الذي يحفظ تلك الصحيفة أو السِجِلّ) / سِجِلّ (كتاب أو صحيفة تُسَجَّلُ فيها الأمور؛ الكاتب الذي يحفظ تلك الصحيفة أو السِجِلّ) / حَجَزَ (حجَزهُ: مَنَعَهُ)\nمثال: هذا الكتاب جديد",
 "成木": "بَالِغ, مُكْتَمِلُ النُّمُوّ ((للحيوانات) مكتمل النمو والتطور)",
 "成果": "تَسَبَّب / نَتِيجَة",
 "成果物": "جاهز للتسليم, قابل للتسليم (مناسب أو جاهز للتسليم) / تسليمات, مُخرَج (شيء يمكن تقديمه كمنتج لعملية التطوير)\nمثال: بموجب هذا العقد تشمل التسليمات كلاً من البرامج والأجهزة",
 "成果給": "عُمُولَة",
 "成極": "استقطاب (الظاهرة التي يتم فيها تقييد اتجاه اهتزاز موجات الضوء أو غيرها من الإشعاعات) / استقطاب (حالة امتلاك أو إعطاء قطبية)",
 "成歯": "سن دائمة (أي من الأسنان الـ 32 التي تحل محل الأسنان اللبنية في مرحلة الطفولة المبكرة ويمكن أن تستمر حتى الشيخوخة)",
 "成瀬": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "成熟": "نَضْج",
 "成熟分裂": "إثبات بالنفي, تورية (تهوين للتأثير البلاغي (خاصة عند التعبير عن الإيجاب بنفي ضده)) / انقسام اختزالي, انقسام منصف ((علم الوراثة) انقسام الخلية الذي ينتج خلايا تناسلية في الكائنات التي تتكاثر جنسيًا؛ تنقسم النواة إلى أربع نوى تحتوي كل منها على نصف عدد الكروموسومات)\nمثال: قول 'لم أكن منزعجاً قليلاً' عندما تقصد 'كنت منزعجاً جداً' هو مثال على الإثبات بالنفي",
 "成熟度": "نَضْج",
 "成熟期": "مُرَاهَقَة",
 "成田": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "成程": "قَدْر اَلْمُسْتَطَاع, قَدْر اَلْإِمْكَان (قضاء الله وحكمه وما قَدَّرَه؛ مبلغ الشيء وكميتّه، بنفس معنى قَدْر)",
 "成立": "تَشَكُّل / تَشْكِيلَة / نَتِيجَة / إبقاء, احتفاظ (فعل الاحتفاظ بشيء ما) / أملاك, مقتنيات (شيء مملوك؛ أي حيازة ملموسة أو غير ملموسة يمتلكها شخص ما)\nمثال: تلك القبعة ملكي",
 "成立ち": "مَنْشَأ / مَنْبَع, مَنْشَأ / اَصْل / هَيْكَل",
 "成績": "تَسَبَّب / نَتِيجَة",
 "成績表": "التقرير المدرسي عن الطالب",
 "成羽": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "成聖": "تكريس (تقديس شيء ما عن طريق تخصيصه (عادة بطقوس دينية) لله) / تَكْرِيس (التزام رسمي بحياتك أو وقتك لغرض عزيز (لخدمة أو هدف))",
 "成育": "تَنْمِيَة, نُمُو (الزيادة؛ النماء)\nمثال: الجزائر راغبة في تنمية اقتصادها.",
 "成膜": "تطبيق, طلاء (عمل وضع شيء (على سطح)) / طبقة, طلاء (طبقة رقيقة تغطي شيئاً ما) / قماش المعاطف (قماش ثقيل مناسب للمعاطف) / تشطيب, طبقة خارجية (ملمس أو مظهر زخرفي لسطح ما (أو المادة التي تعطيه ذلك المظهر))\nمثال: وصف الطبيب وضعاً موضعياً لليود",
 "成虫": "حشرة كاملة, يافعة (حشرة بالغة ناتجة بعد التحول) / إيماجو, صورة الوالد ((في التحليل النفسي) صورة مثالية لشخص (عادة أحد الوالدين) تشكلت في الطفولة)",
 "成行": "طَبَق, وَجْبَة (جَعَلَ شيئًا يغطي شيئًا آخر بشكل كامل؛ نفَّذَ أمرًا أو خطةً عمليةً) / مَسار (المَسَار: اسم مكان من سارَ : مسلك ، طريق ؛ خَطُّ السَّيْر؛ مَسَار كوكب حول الشَّمس : مدار)\nمثال: هذا الطبق لذيذ. / أمر بسعر السوق (أمر لوسيط ببيع أو شراء أسهم أو سلع بسعر السوق السائد)",
 "成行き": "طَبَق, وَجْبَة (جَعَلَ شيئًا يغطي شيئًا آخر بشكل كامل؛ نفَّذَ أمرًا أو خطةً عمليةً) / مَسار (المَسَار: اسم مكان من سارَ : مسلك ، طريق ؛ خَطُّ السَّيْر؛ مَسَار كوكب حول الشَّمس : مدار)\nمثال: هذا الطبق لذيذ. / أمر بسعر السوق (أمر لوسيط ببيع أو شراء أسهم أو سلع بسعر السوق السائد)",
 "成行き任せ": "انجراف, تسكع (تجوال بلا هدف من مكان لآخر) / تَائِه, مُتَشَرِّد (يتنقّل باستمرار خاصّة من مسكن أو عمل لآخر)",
 "成行き注文": "أمر بسعر السوق (أمر لوسيط ببيع أو شراء أسهم أو سلع بسعر السوق السائد)",
 "成行注文": "أمر بسعر السوق (أمر لوسيط ببيع أو شراء أسهم أو سلع بسعر السوق السائد)",
 "成語": "تعبير اصطلاحي, مصطلح (تعبير لا يمكن استنتاج معانيه من معاني الكلمات التي يتكون منها)",
 "成賀": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "成跡": "إِنْجَاز",
 "成都": "شِينْغْدُو, تْشِينْغْدُو",
 "成金": "كيب, نهوض بالركل (تمرين جمباز يبدأ من وضع تكون فيه الساقان فوق الجزء العلوي من الجسم والتحرك إلى وضع منتصب عن طريق تقويس الظهر وأرجحة الساقين للخارج وللأسفل مع دفع…) / حديث النعمة, متسلق طبقي (شخص صعد فجأة إلى وضع اقتصادي أعلى ولكنه لم ينل القبول الاجتماعي من الآخرين في تلك الطبقة) / متغطرس, مغرور (شخص متكبر أو وقح)",
 "成長": "تَنْمِيَة, نُمُو (الزيادة؛ النماء)\nمثال: الجزائر راغبة في تنمية اقتصادها.",
 "成長ホルモン": "سوماتروبين, هرمون النمو (هرمون تنتجه الغدة النخامية الأمامية؛ يعزز النمو عند البشر)",
 "成長因子": "عامل نمو (بروتين يشارك في تمايز الخلايا ونموها)",
 "成長期": "موسم النمو (الموسم الذي ينمو فيه المحصول بشكل أفضل)",
 "成長株": "أسهم نمو (أسهم شركة حققت مكاسب أسرع من المتوسط في الأرباح ومن المتوقع أن تستمر في ذلك)",
 "成長率": "مُعَدَّل النُّمُوّ (معدل الزيادة في الحجم لكل وحدة زمنية)",
 "成長産業": "صناعة نامية (صناعة تنمو بسرعة)",
 "成長痛": "صعوبات البداية, مشاكل النمو (المشاكل التي تنشأ عند توسيع مؤسسة (خاصة في المراحل المبكرة)) / آلام النمو, معاناة النضج (ضيق عاطفي ينشأ خلال فترة المراهقة) / آلام النمو (ألم في العضلات أو المفاصل يعاني منه الأطفال أحياناً وغالباً ما يُعزى إلى النمو السريع)",
 "我": "أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى. / نَفْس (النَّفْسُ : الرُّوحُ؛ النَّفْسُ :الدَّمُ، فشاهده قول السموأَل: تَسِيلُ على حَدِّ الظُّبَّاتِ نُفُوسُنَا…)\nمثال: هم في نفس السن. / مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة! / ـِي, ـي / عِنَاد / نَفْس (النَّفْسُ : الرُّوحُ؛ النَّفْسُ :الدَّمُ، فشاهده قول السموأَل: تَسِيلُ على حَدِّ الظُّبَّاتِ نُفُوسُنَا…)\nمثال: هم في نفس السن.",
 "我々": "نحن (ضَمِيرُ رَفْعٍ مُنْفَصِلٌ لِلْمُثَنَّى وَالْجَمْعِ ( مُذَكَّراً وَمُؤَنَّثاً )؛ ضَمِيرُ رَفْعٍ مُنْفَصِلٌ لِلْمُتَكَلِّمِ فِي حَالَةِ التَّعْظِيمِ)\nمثال: نحن مهتمون جدا.",
 "我が": "ـِي, ـي",
 "我がちに": "تَهَافَتَ",
 "我がまま": "أَنَانِيّ / مُتَسَاهِل مَعَ النَّفْس (يُلبّي شهواته ورغباته الخاصّة)",
 "我がままを言う": "أنين, تباكي (شكوى يتم التلفظ بها بطريقة شاكية وحزينة)",
 "我がもの": "مَسّ, تَلَبُّس / مُمْتَلَك / حَوْزَة, مُلْكِيّة / اِسْتِحْوَاذ / حِيَازَة",
 "我が世の春": "أوج, إبان (فترة الازدهار أو الإنتاجية القصوى)",
 "我が侭": "أَنَانِيّ / مُتَسَاهِل مَعَ النَّفْس (يُلبّي شهواته ورغباته الخاصّة)",
 "我が侭を言う": "أنين, تباكي (شكوى يتم التلفظ بها بطريقة شاكية وحزينة)",
 "我が儘": "أَنَانِيّ / مُتَسَاهِل مَعَ النَّفْس (يُلبّي شهواته ورغباته الخاصّة)",
 "我が儘を言う": "أنين, تباكي (شكوى يتم التلفظ بها بطريقة شاكية وحزينة)",
 "我が党": "أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى. / مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة!",
 "我が君": "مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة!",
 "我が国": "الْيَابَان (دولة جزرية في شرق قارة آسيا، عاصمتها طوكيو)",
 "我が強い": "عَنِيد",
 "我が方": "نحن (ضَمِيرُ رَفْعٍ مُنْفَصِلٌ لِلْمُثَنَّى وَالْجَمْعِ ( مُذَكَّراً وَمُؤَنَّثاً )؛ ضَمِيرُ رَفْعٍ مُنْفَصِلٌ لِلْمُتَكَلِّمِ فِي حَالَةِ التَّعْظِيمِ)\nمثال: نحن مهتمون جدا.",
 "我が物": "مَسّ, تَلَبُّس / مُمْتَلَك / حَوْزَة, مُلْكِيّة / اِسْتِحْوَاذ / حِيَازَة",
 "我が身": "نَفْسِي / أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى. / مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة!",
 "我が輩": "أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى. / نحن (ضَمِيرُ رَفْعٍ مُنْفَصِلٌ لِلْمُثَنَّى وَالْجَمْعِ ( مُذَكَّراً وَمُؤَنَّثاً )؛ ضَمِيرُ رَفْعٍ مُنْفَصِلٌ لِلْمُتَكَلِّمِ فِي حَالَةِ التَّعْظِيمِ)\nمثال: نحن مهتمون جدا.",
 "我こそは": "أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى.",
 "我と": "لوحد / لحال / بالطبع, بطبيعة الحال (كما هو متوقع) / طبيعياً (وفقاً للطبيعة؛ بوسائل طبيعية؛ دون مساعدة اصطناعية) / بشكل طبيعي, بطبيعية (بطريقة طبيعية أو عادية) / بالفطرة, بطبعه (من خلال الطبيعة المتأصلة)\nمثال: بطبيعة الحال، أرسل لنا المحامي فاتورة ضخمة",
 "我と我が身": "نَفْسِي",
 "我にもあらず": "بذهول, بشرود (بطريقة شاردة الذهن أو مشغولة البال)\nمثال: قرأ الرسالة بشرود",
 "我にもなく": "بذهول, بشرود (بطريقة شاردة الذهن أو مشغولة البال)\nمثال: قرأ الرسالة بشرود",
 "我にも無く": "بذهول, بشرود (بطريقة شاردة الذهن أو مشغولة البال)\nمثال: قرأ الرسالة بشرود",
 "我にも非ず": "بذهول, بشرود (بطريقة شاردة الذهن أو مشغولة البال)\nمثال: قرأ الرسالة بشرود",
 "我に返る": "أَهْدَأَ, هَدَّأَ",
 "我の強い": "عَنِيد",
 "我ら": "نحن (ضَمِيرُ رَفْعٍ مُنْفَصِلٌ لِلْمُثَنَّى وَالْجَمْعِ ( مُذَكَّراً وَمُؤَنَّثاً )؛ ضَمِيرُ رَفْعٍ مُنْفَصِلٌ لِلْمُتَكَلِّمِ فِي حَالَةِ التَّعْظِيمِ)\nمثال: نحن مهتمون جدا. / أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى. / مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة!",
 "我らが": "ـنَا",
 "我を折る": "أَجْزَأَ (أَجْزَأَ القومُ: جَزَأَتْ إِبِلُهُمْ؛ أَجْزَأَ المرأَةُ: ولدت الإِنَاث) / أَجْزَى / أَدَرَّ ((أَدِرَ) أدرا وأدرة وأدرة: انتفخت خصيته لتسرب سائل في غلافها فهو آدر وأدرت الخصية فهي أدراء (ج) أدر) / أَغَلَّ / أَكْسَبَ / أَمَّنَ (وَثِقَ به وأرْكَنَ إليه) / إِفَادَة / إِفَادَةٌ مِنْ / إِنْتاج / إِيراد / اِسْتِفَادَة / جَدَاء\nمثال: لا أدر لماذا بكيت هذا القدر كله.",
 "我主": "مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة!",
 "我事": "زَوْجَة, اِمْرَأَة",
 "我人": "مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة!",
 "我人ども": "مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة!",
 "我侭": "أَنَانِيّ / مُتَسَاهِل مَعَ النَّفْس (يُلبّي شهواته ورغباته الخاصّة)",
 "我侭を言う": "أنين, تباكي (شكوى يتم التلفظ بها بطريقة شاكية وحزينة)",
 "我僧": "رَاهِب, نَاسِك (اسم فاعل للفعل رَهَبَ؛ عند المَسِيحِيّين هو من تَبَتَّلَ لله واعْتَزَلَ الناس إلى بعض الأدْيِرَة طلبا للعِبَادَة)",
 "我儕": "أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى. / مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة!",
 "我儘": "أَنَانِيّ / مُتَسَاهِل مَعَ النَّفْس (يُلبّي شهواته ورغباته الخاصّة)",
 "我儘を言う": "أنين, تباكي (شكوى يتم التلفظ بها بطريقة شاكية وحزينة)",
 "我儘者": "أناني (شخص يتصف بأنانية مفرطة وغير عادية)",
 "我党": "أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى. / مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة!",
 "我勝ちに": "تَهَافَتَ",
 "我執": "أنانية, حب الذات (رأي مبالغ فيه حول أهمية الذات) / تضخم الأنا, غرور (شعور متضخم بالفخر بتفوقك على الآخرين)",
 "我妹": "حَبِيب, حَبِيبَة",
 "我妹子": "حَبِيب, حَبِيبَة",
 "我孫子": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "我御寮": "مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة!",
 "我御料": "مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة!",
 "我思うゆえに我あり": "أُفَكِّر، إِذَن أَنَا مَوْجُود, أُفَكِّر، إِذَن أُوجَد",
 "我思う故に我あり": "أُفَكِّر، إِذَن أَنَا مَوْجُود, أُفَكِّر، إِذَن أُوجَد",
 "我思う故に我在り": "أُفَكِّر، إِذَن أَنَا مَوْجُود, أُفَكِّر، إِذَن أُوجَد",
 "我情": "أَنَانِيَّة",
 "我意": "ضبط النفس (سمة التحكم الحازم في سلوك المرء) / عناد (التمسك الحازم بأفكار أو رغبات المرء)",
 "我慢": "تحمل, جلد (القدرة على تحمل المشقة أو التوتر) / بقاء, نجاة (حالة البقاء على قيد الحياة)\nمثال: يختبر الماراثون قدرة تحمل العداء / إنكار الذات, ضبط النفس (فعل إنكار الذات؛ السيطرة على الدوافع) / ضبط النفس (سمة التحكم الحازم في سلوك المرء)",
 "我慢くらべ": "ماراثون, مسابقة التحمل (أي مشروع طويل وشاق)",
 "我慢ならない": "غير محتمل, لا يطاق (لا يمكن تحمله أو الصبر عليه)\nمثال: درجة لا تطاق من العاطفية",
 "我慢の限界": "القشة الأخيرة, القشة التي قصمت ظهر البعير (الإزعاج الأخير الذي يمدد صبرك إلى ما بعد الحد)",
 "我慢強い": "صَبُور (الكثير الصبر أو الذي يصبر طويلا، من كانت صفته الصبر؛ الصَبُوْر: اسم من الأسماء الحسنى) / مَرِيض, مَرِيضَة (من به مَرَض، أي السَقِيْم المَعْلُوْل. يقال لما يصاب به الجَسَد والنَفَس والرُوْح أو أحدهم) / مَفْعُول (كناية عن الذي فُعِلَ به فاحشة اللواط. المَلُوطُ به)\nمثال: أظن أنها مريضة.",
 "我慢比べ": "ماراثون, مسابقة التحمل (أي مشروع طويل وشاق)",
 "我慢汁": "مَذْي",
 "我慢競べ": "ماراثون, مسابقة التحمل (أي مشروع طويل وشاق)",
 "我楽多市": "سوق البضائع المستعملة, سوق خيري (بيع المواد المتبرع بها)",
 "我欲": "أَنَانِيَّة",
 "我武者": "جَرِيء, مُجَازِف (مُستعد لخوض المخاطر والمجازفة) / صَفِيق, وَقِح (لا يتقيّد بالأعراف أو اللياقة؛ جريء بشكل فظّ) / بَاسِل, جَسُور (لا يهاب الخوف أو الترهيب)",
 "我武者羅": "مُتَهَوِّر",
 "我殿": "مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة!",
 "我物": "مَسّ, تَلَبُّس / مُمْتَلَك / حَوْزَة, مُلْكِيّة / اِسْتِحْوَاذ / حِيَازَة",
 "我知らず": "رَغْمًا عَنْه, قَسْرًا (ضد إرادة المرء أو دون تفكير واعي)\nمثال: احتجز قسراً رغماً عنه",
 "我等": "نحن (ضَمِيرُ رَفْعٍ مُنْفَصِلٌ لِلْمُثَنَّى وَالْجَمْعِ ( مُذَكَّراً وَمُؤَنَّثاً )؛ ضَمِيرُ رَفْعٍ مُنْفَصِلٌ لِلْمُتَكَلِّمِ فِي حَالَةِ التَّعْظِيمِ)\nمثال: نحن مهتمون جدا. / أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى. / مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة!",
 "我等が": "ـنَا",
 "我褒め": "تباهي, تفاخر (الحديث عن النفس بصيغ التفخيم)",
 "我身": "نَفْسِي / أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى. / مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة!",
 "我輩": "أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى. / نحن (ضَمِيرُ رَفْعٍ مُنْفَصِلٌ لِلْمُثَنَّى وَالْجَمْعِ ( مُذَكَّراً وَمُؤَنَّثاً )؛ ضَمِيرُ رَفْعٍ مُنْفَصِلٌ لِلْمُتَكَلِّمِ فِي حَالَةِ التَّعْظِيمِ)\nمثال: نحن مهتمون جدا.",
 "我郎": "فَتًى, غُلَام (شَابٌّ أوَّلَ شبابه بين المراهقة والرُّجولة؛ عبد، خادم) / صَبِيّ, فَتًى / ياه\nمثال: ترى الفتاة الفتى. / اِبْن زِنًى, بِنْت زِنًى (الولد الذكر)\nمثال: هو له ابن صغير. / مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة!",
 "我鳴り立てる": "صَاحَ (صاتَ بأقصى طاقته وأعلى صوته، يستخدم للحيّ ولا يقال صاح للجماد؛ عليه: ناداه)\nمثال: سأساعدك يا صاح.",
 "戒": "تَحْذِير, تَنْبِيه (نصيحة تحذيرية حول شيء وشيك (خاصة خطر وشيك أو أمر غير سار)) / إِنْذَار, تَحْذِير (توبيخ حازم)\nمثال: خطاب تحذير حول مخاطر الفسق",
 "戒め": "حَذَر, حِيطَة (حذِر الشّخصُ: تيقّظ واستعدّ وتأهّب وتنبّه؛ حذِر الأمرَ: كَتَمَه وأخفاه) / حَذَر (حذِر الشّخصُ: تيقّظ واستعدّ وتأهّب وتنبّه؛ حذِر الأمرَ: كَتَمَه وأخفاه)\nمثال: قد بحذر من فضلك. / حَظْر, مَنْع ((حَظَّرَ): بالغ في الحظر) / حَظْر ((حَظَّرَ): بالغ في الحظر)\nمثال: حظر تويتر توم لمدة خمسة عشرة يوما. / عِقَاب, جَزَاء (طَيْر من الجَوَارِح، أكبر التي تصيد منها يكنى بأبي الهَيْثَم ومعروف بحِدَّة البصر؛ حَجَر ناتئ في جَوْف البِئْر يخرق الدَلُو. ونادر) / عُقُوبَة / عِقَاب (طَيْر من الجَوَارِح، أكبر التي تصيد منها يكنى بأبي الهَيْثَم ومعروف بحِدَّة البصر؛ حَجَر ناتئ في جَوْف البِئْر يخرق الدَلُو. ونادر)\nمثال: هو من تلقى العقاب الأكبر.",
 "戒める": "حَذَّرَ (حذِر الشّخصُ: تيقّظ واستعدّ وتأهّب وتنبّه؛ حذِر الأمرَ: كَتَمَه وأخفاه)\nمثال: قد بحذر من فضلك. / مَنَعَ (حَرَمَ، ضد أَعْطَى؛ كَفَّ عنه وحَمَاه)\nمثال: تساهم جذور أشجار المنغروف في منع حدوث انجراف التربة. / عَاقَبَ, قَاصَصَ",
 "戒厳": "حُكْم عُرْفِيّ (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ)\nمثال: حكم علي بالموت.",
 "戒厳令": "حُكْم عُرْفِيّ (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ)\nمثال: حكم علي بالموت.",
 "戒告": "تَحْذِير, تَنْبِيه (نصيحة تحذيرية حول شيء وشيك (خاصة خطر وشيك أو أمر غير سار)) / إِنْذَار, تَحْذِير (توبيخ حازم)\nمثال: خطاب تحذير حول مخاطر الفسق",
 "戒律": "مَبْدَأ (أَسَاس، أَصْل؛ مُسَلَّمَة، اِفْتِرَاض، ما يسلّم به لوضوحه)",
 "戒心": "حَذَر, حِيطَة (حذِر الشّخصُ: تيقّظ واستعدّ وتأهّب وتنبّه؛ حذِر الأمرَ: كَتَمَه وأخفاه) / حَذَر (حذِر الشّخصُ: تيقّظ واستعدّ وتأهّب وتنبّه؛ حذِر الأمرَ: كَتَمَه وأخفاه)\nمثال: قد بحذر من فضلك.",
 "戒慎": "حَذَر, حِيطَة (حذِر الشّخصُ: تيقّظ واستعدّ وتأهّب وتنبّه؛ حذِر الأمرَ: كَتَمَه وأخفاه) / حَذَر (حذِر الشّخصُ: تيقّظ واستعدّ وتأهّب وتنبّه؛ حذِر الأمرَ: كَتَمَه وأخفاه)\nمثال: قد بحذر من فضلك.",
 "戒飭": "إِنْذَار, تَحْذِير (توبيخ حازم)",
 "或いは": "أَو, أَم (يفيد الشك؛ يفيد التقسيم)\nمثال: أكون أو لا أكون؟ / رُبَّمَا, مِن اَلْمُمْكِن",
 "或は": "أَو, أَم (يفيد الشك؛ يفيد التقسيم)\nمثال: أكون أو لا أكون؟",
 "或る日": "مَرَّةً, يَوْمًا (مؤنث مُرّ، صفة ما كان بها مرارة) / فِي يَوْمٍ مِنَ ٱلْأَيَّامِ (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: كم من مرة ذهبت؟",
 "或る時": "مَرَّةً, مَرَّةً وَاحِدَةً (مؤنث مُرّ، صفة ما كان بها مرارة) / بِمُجَرَّد أَنّ\nمثال: كم من مرة ذهبت؟",
 "或る種": "أَكِيد / مُتَأَكِّد / بَعْض ((بَعَضَه) البعوض بَعْضًا: لسعه وآذاه؛ (بَعَضَ) الشَّيْء: جعله أقساما) / مُحَدَّد (من الفعل حَدَّدَ؛ (في الرياضيات) مصطلح يستعمل في الجبر الخطي، ويتم تحديد محدد مصفوفة باستعمال صيغة لايبنتس أو صيغة لابلاس)\nمثال: لديك بعض الكتب.",
 "或日": "مَرَّةً, يَوْمًا (مؤنث مُرّ، صفة ما كان بها مرارة) / فِي يَوْمٍ مِنَ ٱلْأَيَّامِ (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: كم من مرة ذهبت؟",
 "戛々": "نَقْرَة / نَقَرَ",
 "戛戛": "نَقْرَة / نَقَرَ",
 "戞々": "نَقْرَة / نَقَرَ",
 "戞戞": "نَقْرَة / نَقَرَ",
 "戟": "ذُو مِقْبَض طَوِيل (لَهُ مِقْبَض أَوْ يَد طَويلَة) / سِلَاح, أَسْلِحَة",
 "戦": "حَرْب (حَرَبَ (حربه) بالحربة حربا: طعنه بها؛ حَرَبَ (ه) حربا: سلبه جميع ما يملك) / مُحَارَبَة / حرب (حَرَبَ (حربه) بالحربة حربا: طعنه بها؛ حَرَبَ (ه) حربا: سلبه جميع ما يملك) / حَارَبَ, شَنَّ حَرْبًا\nمثال: بوتين مجرم حرب. / قُوَّات, عَسْكَرِيَّة / حَرْب (حَرَبَ (حربه) بالحربة حربا: طعنه بها؛ حَرَبَ (ه) حربا: سلبه جميع ما يملك) / مُحَارَبَة / حرب (حَرَبَ (حربه) بالحربة حربا: طعنه بها؛ حَرَبَ (ه) حربا: سلبه جميع ما يملك) / حَارَبَ, شَنَّ حَرْبًا\nمثال: بوتين مجرم حرب. / مُبَارَاة / شَحّاطَة, شَخَّاطَة",
 "戦々恐々": "بتوتر, بقلق (بطريقة عصبية وقلقة) / باضطراب, بنزق (بإثارة عصبية)\nمثال: راقبنا سوق الأسهم بتوتر",
 "戦い": "مَعْرَكَة / عَارَكَ, قَاتَلَ / تَعَارَكَ, تَقَاتَلَ / نَاضَلَ, كَافَحَ / قِتَال (من قَتَلَ: كثير القَتْل) / مَعْرَكَة\nمثال: لن يحل القتال أي شيء. / مُسَابَقَة",
 "戦いの庭": "سَاحَة حَرْب, سَاحَة مَعْرَكَة",
 "戦う": "عَارَكَ, قَاتَلَ / تَعَارَكَ, تَقَاتَلَ / نَاضَلَ, كَافَحَ / قِتَال (من قَتَلَ: كثير القَتْل) / مَعْرَكَة\nمثال: لن يحل القتال أي شيء. / تَنَافَسَ, تَبَارَى / كِفَاح, نِضَال / كافح, جَاهَدَ",
 "戦き": "ارتجاف, رعشة (اهتزاز لا إرادي (كما لو كان بسبب المرض أو الخوف)) / رجفة, رعشة (إحساس بالخوف يكاد يكون ممتعاً)\nمثال: سرت فيه رعشة مفاجئة",
 "戦く": "هَزَّ / اِخْتَلَجَ, اِرْتَجَفَ / رَجْفَة (المرّة الواحدة من الرَجْف؛ الزَلْزَلَة)",
 "戦わす": "تَنَافَسَ, تَبَارَى / مُنَاظَرَة, مُنَاقَشَة (مصدر من ناظَرَ)",
 "戦中": "زَمَن الْحَرْب, وَقْت الْحَرْب",
 "戦乙女": "فَالْكِيرِي",
 "戦乱": "حرب, قتال (شن صراع مسلح ضد عدو) / حَرْب (صراع نشط بين كيانات متنافسة)\nمثال: قُتل آلاف الأشخاص في الحرب",
 "戦争": "حَرْب (حَرَبَ (حربه) بالحربة حربا: طعنه بها؛ حَرَبَ (ه) حربا: سلبه جميع ما يملك) / مُحَارَبَة / حرب (حَرَبَ (حربه) بالحربة حربا: طعنه بها؛ حَرَبَ (ه) حربا: سلبه جميع ما يملك) / حَارَبَ, شَنَّ حَرْبًا\nمثال: بوتين مجرم حرب. / صِرَاع",
 "戦争屋": "مُحَرِّض حَرْب, مُحَرِّضَة حَرْب",
 "戦争挑発": "عُدْوَان / عِدْوَان",
 "戦争未亡人": "أرملة الحرب (امرأة توفي زوجها في الحرب)",
 "戦争犯罪": "جَرِيمَةْ حَرْب",
 "戦争犯罪人": "مُجْرِم حَرْب, مُجْرِمَة حَرْب",
 "戦争犯罪者": "مُجْرِم حَرْب, مُجْرِمَة حَرْب",
 "戦争状態": "حالة حرب, حرب (حالة قانونية تنشأ بإعلان الحرب وتنتهي بإعلان رسمي تسري خلالها القواعد الدولية للحرب)\nمثال: أعلنت الحرب في نوفمبر لكن القتال الفعلي لم يبدأ حتى الربيع التالي",
 "戦争画": "تبرج, مكياج (مستحضرات تجميل توضع على الوجه لتحسين أو تغيير المظهر) / ألوان الحرب, زينة الحرب (الملابس والمراسم الاحتفالية الكاملة (مجازياً)) / طلاء الحرب (زينة تتكون من طلاء يوضع على الوجه والجسم لدى بعض المحاربين الهنود الحمر قبل المعركة)",
 "戦争神経症": "إرهاق المعركة, صدمة القصف (اضطراب عقلي ناتج عن إجهاد الحرب النشطة)",
 "戦人": "مُحَارِب, مُقَاتِل",
 "戦列": "خط القتال (خط تشكله القوات أو السفن المستعدة لشن هجوم أو تلقيه)",
 "戦列復帰": "رجوع, عودة (حدوث تغيير في الاتجاه للرجوع في الاتجاه المعاكس)",
 "戦列艦": "سفينة حربية (سفينة حربية مخصصة للقتال)",
 "戦利品": "سورة الأنفال / شِرَاء, اِشْتِرَاء / مُشْتَرًى, مُشْتَرَيَات / اِشْتَرَى (أَخَذَ الشيءَ بِثَمَن؛ اشترى الشخصَ (الحرّ) أو رضاه: أراد إرضائه ومحبته بغض النظر عن الكلفة)\nمثال: اشترى زيري ذلك.",
 "戦力": "قدرة عسكرية, قوة عسكرية (القدرة من حيث الأفراد والمعدات التي تؤثر على القدرة على خوض الحرب)\nمثال: واجهنا جيشًا ذا قوة كبيرة / قُدْرَة, مَقْدِرَة / مَوْهِبَة",
 "戦務": "خِدْمَة",
 "戦勝": "اِنْتِصَار, نَصْر",
 "戦勝者": "غالب, منتصر (مقاتل قادر على هزيمة المنافسين) / فائز, منتصر (المتسابق الذي يفوز بالمسابقة)",
 "戦区": "مَسْرَح حَرْب",
 "戦地": "جَبْهَة / أَمَامِيّ",
 "戦域": "سَاحَة حَرْب, سَاحَة مَعْرَكَة",
 "戦場": "سَاحَة حَرْب, سَاحَة مَعْرَكَة",
 "戦士": "جُنْدِيّ, عَسْكَرِيّ (لقب عسكري يُطلق على من يلتحق بالجَيْش ويعمل فيه، مقاتل، محارب، عسكري؛ (في الشطرنج) اسم آخر للبيدق)\nمثال: غادر ذلك الجندي.",
 "戦役": "حملة, حملة عسكرية (عدة عمليات مترابطة تهدف إلى تحقيق هدف معين (عادة ضمن قيود جغرافية وزمنية))",
 "戦意": "رُوح مَعْنَوِيَّة (رَوَّحَ عليه بالمِرْوحَة: حَرَّكَها ليجلبَ إِليه نسيمَ الهواء؛ رَوَّحَ بالقوم: صلَّى بهم التراويح)\nمثال: كان سامي هو روح الحفلة.",
 "戦慄": "ارتجاف, رعشة (اهتزاز لا إرادي (كما لو كان بسبب المرض أو الخوف)) / رجفة, رعشة (إحساس بالخوف يكاد يكون ممتعاً)\nمثال: سرت فيه رعشة مفاجئة",
 "戦慄く": "اِخْتَلَجَ, اِرْتَجَفَ / رَجْفَة (المرّة الواحدة من الرَجْف؛ الزَلْزَلَة)",
 "戦旗": "راية المعركة (علم يقود القوات إلى المعركة)",
 "戦時": "زَمَن الْحَرْب, وَقْت الْحَرْب",
 "戦時下": "زَمَن الْحَرْب, وَقْت الْحَرْب",
 "戦時共産主義": "شُيُوعِيَّةُ الْحَرْب",
 "戦時国際法": "قَانُون دُوَلِيّ (مقياس كل شيء وطريقه؛ أمر كليّ ينطبق على جميع جزئياته التي تعرف أحكامها منه)\nمثال: ذكرني بالقانون.",
 "戦時犯罪": "جَرِيمَةْ حَرْب",
 "戦機": "إِسْتْرَاتِيجِيَّة (الإستراتيجية فن وعلم وضع خُطط الحرب وإدارة العمليَّات الحربيَّة: إستراتيجيَّة القوَّات المسلَّحة؛ خُطَّة شاملة في أي مجال من المجالات: وضعت الحكومة إستراتيجيَّة مستقبليَّة للنهوض بالاقتصاد القوميّ)\nمثال: ستحمي روسيا مصالحها الإستراتيجية كما تفعل الولايات المتحدة.",
 "戦歴": "خِدْمَةٌ عَسْكَرِيَّة",
 "戦没者追悼記念日": "يوم الذكرى (عطلة قانونية في الولايات المتحدة، آخر يوم اثنين في مايو؛ يحيي ذكرى أعضاء القوات المسلحة الأمريكية الذين قتلوا في الحرب)",
 "戦法": "تَكْتِيك (فن وضع خطط حربية؛ وسائل وخطط وطرق تنفيذية تتخد للنجاح في أمر ما. مثال: تكتيك برلماني أو سياسي) / تَكْتِيك, تَخْطِيط (فن وضع خطط حربية؛ وسائل وخطط وطرق تنفيذية تتخد للنجاح في أمر ما. مثال: تكتيك برلماني أو سياسي)",
 "戦火": "حَرْب (حَرَبَ (حربه) بالحربة حربا: طعنه بها؛ حَرَبَ (ه) حربا: سلبه جميع ما يملك) / مُحَارَبَة / حرب (حَرَبَ (حربه) بالحربة حربا: طعنه بها؛ حَرَبَ (ه) حربا: سلبه جميع ما يملك) / حَارَبَ, شَنَّ حَرْبًا\nمثال: بوتين مجرم حرب.",
 "戦犯": "مُجْرِم حَرْب, مُجْرِمَة حَرْب",
 "戦略": "إِسْتْرَاتِيجِيَّة (الإستراتيجية فن وعلم وضع خُطط الحرب وإدارة العمليَّات الحربيَّة: إستراتيجيَّة القوَّات المسلَّحة؛ خُطَّة شاملة في أي مجال من المجالات: وضعت الحكومة إستراتيجيَّة مستقبليَّة للنهوض بالاقتصاد القوميّ)\nمثال: ستحمي روسيا مصالحها الإستراتيجية كما تفعل الولايات المتحدة.",
 "戦略上": "إِسْتِرَاتِيجِيّ / استراتيجياً (فيما يتعلق بالاستراتيجية)\nمثال: قرارات هامة استراتيجياً",
 "戦略兵器削減条約": "نَجْمَة, اِبْتِدَاء / نَجْمَة / بَدَأَ (حَدَثَ ونَشَأَ وحَصَلَ؛ أَخَذَ، شَرَعَ)\nمثال: بدأ سامي يتكلم.",
 "戦略家": "استراتيجي, خبير استراتيجي (خبير في الاستراتيجية (خاصة في الحرب))",
 "戦略情報システム": "أخت, أخوات (الأُخْت : المرأة التي تشترك معك في الأب أو الأم؛ الأُخْت  لقب يطلقه الشخص على امرأة لا يعرفها تأدبا وإن كانت غريبة عنه)\nمثال: ماري هي أخت توم",
 "戦略的": "إِسْتِرَاتِيجِيّ",
 "戦略的互恵関係": "تَكَافُلِيّ, مُتَبَادِلُ الاعْتِمَاد (يَعْتَمِدُ كُلٌّ مِنْهُمَا عَلَى الآخَر)",
 "戦線": "جَبْهَة / أَمَامِيّ",
 "戦績": "إِصَابَة (إِلحاق الأَذى بالجسم، الجُرْح؛ مَرَضٌ أو عَدْوَى) / دَرَجَة\nمثال: تعرض زيري لإصابة.",
 "戦艦": "بارجة (سفينة حربية كبيرة ومدرعة بشدة)",
 "戦術": "تَكْتِيك (فن وضع خطط حربية؛ وسائل وخطط وطرق تنفيذية تتخد للنجاح في أمر ما. مثال: تكتيك برلماني أو سياسي) / تَكْتِيك, تَخْطِيط (فن وضع خطط حربية؛ وسائل وخطط وطرق تنفيذية تتخد للنجاح في أمر ما. مثال: تكتيك برلماني أو سياسي)",
 "戦術家": "تكتيكي (شخص ماهر في تخطيط التكتيكات)",
 "戦術的": "تكتيكي (من أو يتعلق بالتكتيك أو التكتيكات)",
 "戦車": "فِنْطَاس, صِهْرِيج / خَزَّان / دَبَّابَة / عَرَبَة",
 "戦野": "سَاحَة حَرْب, سَاحَة مَعْرَكَة",
 "戦闘": "مَعْرَكَة",
 "戦闘不能": "فاقد الوعي, لاواعٍ (غير واعٍ؛ يفتقر إلى الوعي والقدرة على الإدراك الحسي كما لو كان نائماً أو ميتاً) / لَا وَاعٍ (بِدُونِ إِرَادَةٍ وَاعِيَة) / عقل لاواعي, لاوعي (ذلك الجزء من العقل الذي يحدث فيه النشاط النفسي الذي لا يدركه الشخص)\nمثال: مستلقٍ فاقداً للوعي على الأرض",
 "戦闘任務": "مهمة قتالية (مهمة للاستيلاء على شيء أو الدفاع عنه)\nمثال: アメリカ軍はイラクでの戦闘任務を完了することを発表した。 — أعلنت القوات الأمريكية انتهاء مهمتها في العراق.",
 "戦闘員": "مُقَاتِل (مُقاتِل: اسم مذكر يجمع : يجمع جمعا سالما على مُقاتِلون وجمع تكسير على مُقاتِلة واسم فاعل من قَاتَل)",
 "戦闘服": "زَيّ, زِي",
 "戦闘機": "مُبَارِز, مُقَاتِل / مُحَارِب, مُقَاتِل",
 "戦闘正面幅": "واجهة المبنى (وجه أو مقدمة مبنى) / واجهة (امتداد الأرض المحاذية لشارع أو ماء) / وَاجِهَة (الاتجاه الذي يواجهه شيء ما (مثل مبنى))",
 "戦闘犠牲者": "خسائر, خسارة (نقصان في الأفراد أو المعدات العسكرية) / إصابة مميتة, حادث مميت (حادث يتسبب في موت شخص ما) / ضَحِيَّة حادِث, مُصاب (شخص أصيب أو قتل في حادث) / إِصابَة, خَسارَة بَشَرِيَّة (شخص أصيب أو قتل أو أسر أو فقد في اشتباك عسكري)",
 "戦闘的": "مُقَاتِل, مُحَارِب (مُقاتِل: اسم مذكر يجمع : يجمع جمعا سالما على مُقاتِلون وجمع تكسير على مُقاتِلة واسم فاعل من قَاتَل)",
 "戦闘艦": "بارجة, سفينة حربية (سفينة حكومية متاحة لشن الحرب)",
 "戦闘要員": "مُقَاتِل (مُقاتِل: اسم مذكر يجمع : يجمع جمعا سالما على مُقاتِلون وجمع تكسير على مُقاتِلة واسم فاعل من قَاتَل)",
 "戦闘靴": "بسطار",
 "戦陣": "سَاحَة حَرْب, سَاحَة مَعْرَكَة",
 "戦隊": "سرب طيران ((سَرِبَ) المَاء سَرَباً: سَالَ فَهُوَ سَرِب)\nمثال: سرب الطيور ذلك جميل جدا.",
 "戦雲": "نذر الحرب (علامة مشؤومة تهدد بالحرب)",
 "戦馬": "حصان حرب (حصان يستخدم في الحرب) / عمل كلاسيكي مكرر (عمل فني (مقطوعة أو دراما) جزء من الذخيرة القياسية ولكنه أصبح مبتذلاً من كثرة التكرار) / محارب قديم, مخضرم (شخص ذو خبرة مر بالعديد من المعارك؛ أو شخص قدم خدمة طويلة)",
 "截": "قِسْم, جُزْء (فَرَّقَ أو قَسَّمَ الشَّيءَ إلى أجزاء أو أجزاء مختلفة؛ أَحْلَفَ، أَي جَعَلَ يَحْلِفُ على أمرٍ ما) / مَقْطَع / جَرَحَ (كَلَمَ، شَقَّ اللَحْم وأسَالَ الدَمّ؛ صَادَ أو اكْتَسَبَ) / قَصَّ / جَذَبَ, قَطَعَ (شَدَّ الشيءَ نحوه بقوة؛ لفَتَ الانتباه أو أثارَ الاهتمام)",
 "截ち割る": "انفصل",
 "截つ": "جَرَحَ (كَلَمَ، شَقَّ اللَحْم وأسَالَ الدَمّ؛ صَادَ أو اكْتَسَبَ) / قَصَّ\nمثال: ذلك سيهيج الجرح.",
 "截る": "جَرَحَ (كَلَمَ، شَقَّ اللَحْم وأسَالَ الدَمّ؛ صَادَ أو اكْتَسَبَ) / قَصَّ\nمثال: ذلك سيهيج الجرح.",
 "截断": "قص, قطع (عملية تقصير شيء ما بقطع أطرافه) / تخفيف, مزج (عملية تخفيف شيء ما) / تقطيع, قطع (عملية قطع شيء ما إلى أجزاء) / قص, قطع (عملية الاختراق أو الفتح بحافة حادة)\nمثال: أعطاه الحلاق قصة جيدة",
 "截断機": "أداة قطع, قاطعة (أداة للقطع) / قارب قاطع, كتر (سفينة شراعية بصارية واحدة مثبتة في الخلف أكثر من صارية السلوب) / قارب توصيل, قارب خدمات (قارب للتواصل بين السفينة والشاطئ) / قاطع, قصاص (شخص عمله القص (مثل قص القماش للملابس))",
 "截然": "شَفَّاف / وَاضِح",
 "截頭": "قص, قطع (عملية تقصير شيء ما بقطع أطرافه) / استئصال, بتر (عملية قطع شيء ما)\nمثال: أعطاه الحلاق قصة جيدة",
 "戮す": "قَتَلَ, قتل (تعمّد جعله يَمُوتُ، أزهق روحه، أمَاتَه متعمدا؛ الوقتَ: ضيعه بشيء غير ذي فائدة وهو ينتظر أمرا آخر) / قَتْلَة\nمثال: قتل الصياد دبا.",
 "戮する": "قَتَلَ, قتل (تعمّد جعله يَمُوتُ، أزهق روحه، أمَاتَه متعمدا؛ الوقتَ: ضيعه بشيء غير ذي فائدة وهو ينتظر أمرا آخر) / قَتْلَة\nمثال: قتل الصياد دبا.",
 "戮力": "تَعَاوُن",
 "戮力協心": "تَضَامُن (التعاون والتكاتف بين أفراد أو جهات لتحقيق هدف مشترك أو دعم بعضهم البعض؛ الشعور بالمسؤولية الجماعية تجاه قضية أو موقف)\nمثال: التضامن اساس الإنسانية.",
 "戯": "دعابة خفيفة, ملاطفة (ملاحظة مقبولة أو مسلية)\nمثال: يتبادلون الملاطفات",
 "戯け": "طُرْفَة, نُكْتَة / نُكْتَة, هَزْل / مَزَحَ / حماقة, طيش (سلوك أحمق أو لا معنى له) / مُغَفَّل, أَحْمَق",
 "戯ける": "دعابة, مزاح (نشاط يتميز بالمرح والفكاهة) / طُرْفَة, مَزْحَة (حكاية فكاهية أو ملاحظة تهدف إلى إثارة الضحك)\nمثال: روى نكتة مضحكة جداً",
 "戯け口": "طُرْفَة, نُكْتَة / نُكْتَة, هَزْل / مَزَحَ",
 "戯け者": "أَحْمَق, غَبِيّ (مُغَفَّل، أَبْلَه، طَائِش)\nمثال: قبلني ايها الأحمق.",
 "戯け芝居": "فُكَاهَة, كُومِيدِيَا / كُومِيدِيَا",
 "戯け話": "قِصَّة مُضْحِكَة, مَوْقِف طَرِيف (رواية لحادث مسلٍ (عادة مع جملة ختامية مضحكة))\nمثال: روت قصة مضحكة",
 "戯す": "إغاظة, تهكم (فعل مضايقة شخص ما بمرح أو بخبث (خاصة عن طريق السخرية)؛ استفزاز شخص ما بمضايقات مستمرة) / غانية, لعوب (امرأة مغرية تستخدم جاذبيتها لاستغلال الرجال) / مستفز, مشاكس (شخص يميل إلى المشاكسة (عن طريق السخرية أو إثارة الفضول))\nمثال: تجاهل تهكمهم",
 "戯つく": "شعر ركيك, شعر هزلي (شعر كوميدي غير منتظم الوزن) / خشخشة, رنين (صوت معدني)\nمثال: سمع بعض الشعر الركيك السخيف الذي ظل يتردد في ذهنه",
 "戯らす": "إغاظة, تهكم (فعل مضايقة شخص ما بمرح أو بخبث (خاصة عن طريق السخرية)؛ استفزاز شخص ما بمضايقات مستمرة) / غانية, لعوب (امرأة مغرية تستخدم جاذبيتها لاستغلال الرجال) / مستفز, مشاكس (شخص يميل إلى المشاكسة (عن طريق السخرية أو إثارة الفضول))\nمثال: تجاهل تهكمهم",
 "戯る": "لهو, مرح (نشاط ترفيهي مبهج أو خفيف الظل للتسلية)\nمثال: كل ذلك تم من باب المزاح",
 "戯れ": "لَعِبَ, لعب (فعل شيئا للتسلية والترفيه، شَارَكَ في لعبة) / عَزَفَ, شَغَّلَ (والمعزف :الملاهي واحدها معزف ومعزفة) / دَوْر (جَعَله يَدُور؛ جَعَلَه مُدَوَّر) / مَسْرَحِيَّة / مَسْرَح, مَسْرَحِيَّة\nمثال: لعب زيري التنس.",
 "戯れる": "لهو, مرح (نشاط ترفيهي مبهج أو خفيف الظل للتسلية)\nمثال: كل ذلك تم من باب المزاح / تفتيش جسدي (فعل تفتيش شخص ما بحثاً عن أسلحة مخفية أو مخدرات غير قانونية)\nمثال: أجرى للمشتبه به تفتيشاً سريعاً",
 "戯れ事": "مَقْلَب",
 "戯れ歌": "لِيمِرِيك",
 "戯れ言": "طُرْفَة, نُكْتَة / نُكْتَة, هَزْل / مَزَحَ",
 "戯奴": "أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى. / مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة!",
 "戯弄": "مُزْعِج, مُضَايِق (يسبب الانزعاج أو الضيق) / تسليك الشعر, فك التشابك (فعل إزالة التشابك من شعرك بمشط) / إغاظة, تهكم (فعل مضايقة شخص ما بمرح أو بخبث (خاصة عن طريق السخرية)؛ استفزاز شخص ما بمضايقات مستمرة) / إغاظة, مشاكسة (مضايقة مرحة)\nمثال: تجاهل تهكمهم",
 "戯曲": "دْرَامَا, مَسْرَحِيَّة\nمثال: 彼はいくつかの戯曲を韻文で書いた。 — كَتَبَ عدة مسرحيات في الشعر .",
 "戯歌": "لِيمِرِيك",
 "戯画": "كَارِيكَاتِير, كَارِيكَاتُور",
 "戯画化": "كَارِيكَاتِير, كَارِيكَاتُور",
 "戯言": "هُرَاء, لَغْو / طُرْفَة, نُكْتَة / نُكْتَة, هَزْل / مَزَحَ",
 "戯評": "كَارِيكَاتِير, كَارِيكَاتُور",
 "戰隊": "سرب طيران ((سَرِبَ) المَاء سَرَباً: سَالَ فَهُوَ سَرِب)\nمثال: سرب الطيور ذلك جميل جدا.",
 "戲け者": "أَحْمَق, غَبِيّ (مُغَفَّل، أَبْلَه، طَائِش)\nمثال: قبلني ايها الأحمق.",
 "戲言": "طُرْفَة, نُكْتَة / نُكْتَة, هَزْل / مَزَحَ",
 "戴き": "تَاج, إِكْلِيل",
 "戴冠": "تَتْوِيج",
 "戴冠式": "تتويج, تنصيب (مراسم تنصيب ملك جديد)",
 "戴勝": "هُدْهُد",
 "戸": "أَبْوَاب, بَاب / مِصْرَاع (البَاب. ويطلق غالباً على الأبواب الخشبية الثقيلة؛ هو ما يسُدٌّ الباب من خشب) / دُخُول / مَدْخَل / ضَيِّق",
 "戸々": "سُكَّان / سُكَّانِيَّة",
 "戸別": "مِنْ بَابٍ إِلَى بَاب (لا يُغفِل أحدًا؛ يتنقّل من بيت إلى بيت)",
 "戸別訪問": "مِنْ بَابٍ إِلَى بَاب (لا يُغفِل أحدًا؛ يتنقّل من بيت إلى بيت) / مِنْ بَابٍ لِبَاب ((عَنِ الرِّحْلَات أَوِ التَّوْصِيلَات) مُبَاشَرَة مِنْ نُقْطَة الأَصْل إِلَى الوِجْهَة)",
 "戸口": "أَبْوَاب, بَاب / سُكَّان / سُكَّانِيَّة",
 "戸口調査": "مِنْ بَابٍ إِلَى بَاب (لا يُغفِل أحدًا؛ يتنقّل من بيت إلى بيت) / مِنْ بَابٍ لِبَاب ((عَنِ الرِّحْلَات أَوِ التَّوْصِيلَات) مُبَاشَرَة مِنْ نُقْطَة الأَصْل إِلَى الوِجْهَة)",
 "戸塚": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "戸外": "خلاء, عراء (حيث يكون الهواء غير محصور)\nمثال: أراد الخروج للهواء الطلق قليلاً",
 "戸川": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "戸建": "مَجْلِس",
 "戸建て": "مَجْلِس",
 "戸当たり": "مصد الباب (سدادة تمنع الأبواب المفتوحة من التحرك)",
 "戸当り": "مصد الباب (سدادة تمنع الأبواب المفتوحة من التحرك)",
 "戸惑い": "اِلْتِبَاس / اِرْتِبَاك (ارتبك الأمر:اختلط عليه ، وفي الوحْل :نَشَبَ فيه وعَلِق ،وفي الأمر:وقع فيه ولم يكد يتخلّص منه؛ ارتبك في كلامه:إذا تَتَعْتَعَ، وارتبك الصّيد في الْحِبَالَة:اِضْطَرَب)\nمثال: لا داعي لارتباك.",
 "戸戸": "سُكَّان / سُكَّانِيَّة",
 "戸扉": "دُخُول / مَدْخَل",
 "戸松": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "戸板": "باب منزلق (باب يفتح عن طريق الانزلاق بدلاً من التأرجح)",
 "戸棚": "خِزَانَة (مكان الخَزْن؛ قطعة أثاث للخَزْن)\nمثال: اقترب من الخزانة.",
 "戸毎目張": "قاروص مخطط (سمكة طعام وصيد بحرية ذات خطوط طولية داكنة؛ تهاجر عكس تيار النهر لوضع البيض) / سمكة الصخر (سمكة طعام بحرية توجد بين الصخور على طول السواحل الشمالية لأوروبا وأمريكا) / سمك الصخر (اللحم قليل الدهن لأي من أسماك السوق القيمة المختلفة التي يتم صيدها بين الصخور)",
 "戸毎眼張": "قاروص مخطط (سمكة طعام وصيد بحرية ذات خطوط طولية داكنة؛ تهاجر عكس تيار النهر لوضع البيض) / سمكة الصخر (سمكة طعام بحرية توجد بين الصخور على طول السواحل الشمالية لأوروبا وأمريكا) / سمك الصخر (اللحم قليل الدهن لأي من أسماك السوق القيمة المختلفة التي يتم صيدها بين الصخور)",
 "戸毎鮴": "قاروص مخطط (سمكة طعام وصيد بحرية ذات خطوط طولية داكنة؛ تهاجر عكس تيار النهر لوضع البيض) / سمكة الصخر (سمكة طعام بحرية توجد بين الصخور على طول السواحل الشمالية لأوروبا وأمريكا) / سمك الصخر (اللحم قليل الدهن لأي من أسماك السوق القيمة المختلفة التي يتم صيدها بين الصخور)",
 "戸田": "تودا (اللغة الدرافيدية التي يتحدث بها شعب تودا في جنوب الهند) / تودا (عضو في شعب رعوي يعيش في تلال نيلجيري في جنوب الهند) / لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "戸籍": "تَعْدَاد اَلسُّكَّان, إِحْصَاء اَلسُّكَّان",
 "戸谷": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "戸走り": "عَدَّاء / عَدَّاءَة",
 "戻し": "رَاجِع, عَائِد (يميل إلى العودة إلى حالة سابقة)",
 "戻す": "رَجَعَ, عَادَ (جَاءَ بعدما ذَهَبَ) / أَرْجَعَ, أَعَادَ (أَعَادَ، رَدَّ؛ صَرَفَ، رَدَّ) / عَوْدَة\nمثال: إياك والتحرك حتى أرجع. / تَقَيَّأَ, قَاءَ / تَقَيُّؤ / شُفِيَ, بَرِئَ",
 "戻ってくる": "عَادَ, رَجَعَ (رَجَعَ)\nمثال: هل عاد توم حقا؟",
 "戻って来る": "عَادَ, رَجَعَ (رَجَعَ)\nمثال: هل عاد توم حقا؟",
 "戻り": "رَجَعَ, عَادَ (جَاءَ بعدما ذَهَبَ) / أَرْجَعَ, أَعَادَ (أَعَادَ، رَدَّ؛ صَرَفَ، رَدَّ) / عَوْدَة\nمثال: إياك والتحرك حتى أرجع.",
 "戻り梅雨": "موسم الأمطار (أحد الموسمين في المناخات الاستوائية، وهي فترة سنوية يحدث فيها معظم هطول الأمطار في بلد ما)",
 "戻る": "رَجَعَ, عَادَ (جَاءَ بعدما ذَهَبَ) / أَرْجَعَ, أَعَادَ (أَعَادَ، رَدَّ؛ صَرَفَ، رَدَّ) / عَوْدَة\nمثال: إياك والتحرك حتى أرجع. / شُفِيَ, بَرِئَ / استحواذ على المرتدة, ريباوند (فعل تأمين حيازة كرة السلة المرتدة بعد تسديدة ضائعة) / ارتداد, رد فعل عكسي (رد فعل لأزمة أو نكسة أو إحباط) / ارتداد, انعكاس (حركة العودة من الارتطام)\nمثال: لا يزال في حالة ارتداد من وفاة زوجته",
 "房": "خصلة, قزعة (حزمة من الريش أو الشعر) / أجمة, خصلة (حزمة من الشعر أو الريش أو العشب النامي) / حُزْمَة, عُنْقُود / مَجْمُوعَة (مؤنث مَجْمُوع وهو اسم مفعول من جَمَعَ؛ الطَائِفَة أو الجَمَاعَة من الناس) / حُزْمَة / حَزَمَ (جَمَعَ، رَتَّبَ؛ في اللغة: شدّ الأشياء معًا بشكل محكم)\nمثال: شكرا لإضافتي للمجموعة. / جزء, قسم (أحد الأجزاء أو القطع المتعددة التي تتناسب مع غيرها لتكوين جسم كامل) / جُزْء, فَلْقَة (أحد الأجزاء التي ينقسم إليها الشيء بشكل طبيعي)\nمثال: قسم من صنارة الصيد / حُجْرَة (الغُرْفَة أو القَاعَة. تطلق على القَبْر والحَضِيرَة من باب التشبيه؛ ما يشبه الغرفة من الأرض، المكان المحمي أو المحاط بما يجعله شبيها بالمنعى الأول. استخدام مجازي وقديم) / غُرْفَة, غُرْفَةُ نَوْم (اسم مفعول لما غُرِفَ من الماء وغيره باليد، الجمع غِرَاف؛ اسم؛ المكان في الدار أو المبنى محاط بأربع جدران وسقف، حُجْرَة، عِلِّيَّة. الجمع وغُرَف وغُرُفَات) / مَجْلِس\nمثال: قعدنا في وسط الحجرة. / رَاهِب, نَاسِك (اسم فاعل للفعل رَهَبَ؛ عند المَسِيحِيّين هو من تَبَتَّلَ لله واعْتَزَلَ الناس إلى بعض الأدْيِرَة طلبا للعِبَادَة)",
 "房々した": "حَدِّيّ, هَامِشِيّ (عند الحدود أو الحافّة أو يشكّلها)",
 "房事": "جِمَاع, مُجَامَعَة (الموافقة والمساعدة في أي شيء كان؛ الشيء: جمعه)\nمثال: توم قائد جماعة أنونيموس.",
 "房室": "فَضاء (فَضَاء) / غُرْفَة, حُجْرَة (اسم مفعول لما غُرِفَ من الماء وغيره باليد، الجمع غِرَاف؛ اسم؛ المكان في الدار أو المبنى محاط بأربع جدران وسقف، حُجْرَة، عِلِّيَّة. الجمع وغُرَف وغُرُفَات)\nمثال: الفضاء مليئ بالغموض. / مَخْدَع, غُرْفَةُ نَوْم / حجيرة, مسكن (تجويف صغير أو فراغ داخل عضو أو في نبات أو حيوان)",
 "房室弁": "صمام أذيني بطيني (أي من صمامي القلب اللذين يتدفق الدم من خلالهما من الأذينين إلى البطينين؛ يمنع عودة الدم إلى الأذين)",
 "房室結節": "عقدة أذينية بطينية (عقدة من عضلة القلب المتخصصة تقع في الجدار الحاجز للأذين الأيمن؛ تستقبل النبضات من العقدة الجيبية الأذينية وتنقلها إلى الحزمة الأذينية البطينية)",
 "房房した": "حَدِّيّ, هَامِشِيّ (عند الحدود أو الحافّة أو يشكّلها)",
 "房毛": "قُفْل (أَغْلَقَ أو سَدَّ البابَ أو الشَّيْءَ؛ في بعض السياقات: عادَ أو رجَعَ إلى مكانه أو بدايته) / هَوِّيس / أَقْفَلَ / ذُؤَابَة\nمثال: يحاول توم كسر القفل.",
 "房水": "خلط مائي, سائل مائي (السائل الصافي داخل مقلة العين بين القرنية والعدسة)",
 "房飾り": "شُرَّابَة",
 "所": "مَيْدَان / مَكَان (مَوْضِع؛ المنزلة والشأن، يقال أيضا مكانة) / مَقْعَد (كل ما يُقْعَدُ ويُجْلَسُ عليه؛ مَكَان القُعُود) / مَكَان, مكان (مَوْضِع؛ المنزلة والشأن، يقال أيضا مكانة) / وَضَعَ, حط (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه)\nمثال: هذا المكان مقدس / خُطْبَة, نِدَاء / عُنْوَان, عِنْوَان (عُنْوَان) / عَنْوَنَ\nمثال: نسيت عنوان توم. / مِنْطَقَة (المِنْطَقةُ: المَنْطِقَةُ؛ مِنْطَقَةُ: مُقَاطَعَةٌ)\nمثال: غزة منطقة مكشوفة. / نُقْطَة (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه) / مَوْقِع (موضع الوُقُوع؛ الموضع الذي حَدَثَ أو يحدث فيه حادث) / أَشَارَ\nمثال: هذه هي نقطة ضعفه.",
 "所々": "هُنَا وَهُنَاكَ",
 "所々方々": "فِي كُلِّ مَكَانٍ (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "所が": "رغم ذلك, لكن (على الرغم من أي شيء مخالف (تسبق عادة التنازل))\nمثال: على الرغم من أنني خائف قليلاً، إلا أنني أود تجربتها مع ذلك",
 "所せしと": "مُزْدَحِم",
 "所せましと": "مُزْدَحِم",
 "所で": "بِالْمُنَاسَبَةِ, عَلَى فِكْرَةٍ / بصرف النظر, بغض النظر (على الرغم من كل شيء؛ دون اعتبار للعوائق)\nمثال: واصل العمل بغض النظر عن الصعوبات",
 "所では": "حَتَّى الْآنَ (يفيد انتهاء الغاية؛ يفيد الغاية)\nمثال: انتظر حتى أجلس.",
 "所により": "فِي مَوْضِعِه الأَصْلِيّ (في المكان أو الموقع الأصلي أو الطبيعي)\nمثال: سرطان في موضعه",
 "所与": "مَفْرُوض, مُسَلَّم بِه (مُعتَرف به بوصفه افتراضًا) / مُسلّمة, مُعطى (افتراض يؤخذ كأمر مسلم به) / بَيَانَات, مَعْلُومَات / إحساس (وعي أولي غير مفصل بالتحفيز)\nمثال: إحساس باللمس",
 "所以": "عَقْل (أمسك بأطرافه وربطه، أصلها للشاة والإبل حيث تربط قوائمها كي تبقى باركة فلا تقوم؛ بلغ العَقْل، أصبح عاقلا فاهما راشدا)\nمثال: هي فتاة تسحر العقل.",
 "所作": "تصرف, سلوك (طريقة التصرف أو التحكم بالنفس) / تصرف, سلوك ((السمات السلوكية) الطريقة التي يتصرف بها الشخص تجاه الآخرين) / حَرَكَة / أَدَاء / مَسْرَحِيَّة / رَقْص (حركة الجسم بتنسيق موسيقي أو لحن، حيث يتحرك الشخص بشكل إيقاعي أو متناسق مع الموسيقى أو أنغام معينة؛ نشاط جسدي يتم على عادة أو تقليد، حيث يشارك الأفراد في الاحتفالات أو الفعاليات الاجتماعية) / رقص (حركة الجسم بتنسيق موسيقي أو لحن، حيث يتحرك الشخص بشكل إيقاعي أو متناسق مع الموسيقى أو أنغام معينة؛ نشاط جسدي يتم على عادة أو تقليد، حيث يشارك الأفراد في الاحتفالات أو الفعاليات الاجتماعية) / شطيح / رَقَصَ, رقص (حركة الجسم بتنسيق موسيقي أو لحن، حيث يتحرك الشخص بشكل إيقاعي أو متناسق مع الموسيقى أو أنغام معينة؛ نشاط جسدي يتم على عادة أو تقليد، حيث يشارك الأفراد في الاحتفالات أو الفعاليات الاجتماعية)\nمثال: كنت تجيد الرقص.",
 "所作事": "رَقْص (حركة الجسم بتنسيق موسيقي أو لحن، حيث يتحرك الشخص بشكل إيقاعي أو متناسق مع الموسيقى أو أنغام معينة؛ نشاط جسدي يتم على عادة أو تقليد، حيث يشارك الأفراد في الاحتفالات أو الفعاليات الاجتماعية) / رقص (حركة الجسم بتنسيق موسيقي أو لحن، حيث يتحرك الشخص بشكل إيقاعي أو متناسق مع الموسيقى أو أنغام معينة؛ نشاط جسدي يتم على عادة أو تقليد، حيث يشارك الأفراد في الاحتفالات أو الفعاليات الاجتماعية) / شطيح / رَقَصَ, رقص (حركة الجسم بتنسيق موسيقي أو لحن، حيث يتحرك الشخص بشكل إيقاعي أو متناسق مع الموسيقى أو أنغام معينة؛ نشاط جسدي يتم على عادة أو تقليد، حيث يشارك الأفراد في الاحتفالات أو الفعاليات الاجتماعية)\nمثال: كنت تجيد الرقص.",
 "所信": "اِعْتِقَاد / عَقِيدَة (المُعَاقِدَة، بمعنى اسم الفاعل؛ المعقودة، بمعنى اسم المفعول) / إيمان",
 "所出": "مَصْدَر, مَصَادِر (مَصْدَر) / عَيْن (المُعَايَنَة والمشاهدة؛ العين : حاسة البصر والرؤية - مؤنث - تكون للإنسان وغيره من الحيوان . قال ابن السكيت : العين التي يبصر بها الناظر…) / مَصْدَر (مَصْدَر)\nمثال: ما مصدر هذا الخوف؟",
 "所労": "مَرَض, دَاء (أصابه مرضٌ أو علّة أو سَقَم)\nمثال: هذا المرض قلبي.",
 "所務": "مَهَمَّة / عَمَل, وَظِيفَة (فِعْل، صُنْع؛ وسيلة للكسب، مِهْنَة، حِرْفَة)\nمثال: المهم هو العمل.",
 "所収": "مُرْفَق, مُضَمَّن (مرفق في نفس المظروف أو الحزمة)",
 "所員": "عضو هيئة, موظف (موظف يكون عضواً في هيئة عاملين (خاصة عضو في الطاقم الذي يعمل لرئيس الولايات المتحدة))",
 "所在": "مَوْقِع (موضع الوُقُوع؛ الموضع الذي حَدَثَ أو يحدث فيه حادث) / مَكَان (مَوْضِع؛ المنزلة والشأن، يقال أيضا مكانة) / مَوْضِع\nمثال: هنا موقع الحادث.",
 "所在ない": "مَلُول, ضَجِر",
 "所在なげ": "عَاطِل عَن اَلْعَمَل",
 "所在地": "مَوْقِع (موضع الوُقُوع؛ الموضع الذي حَدَثَ أو يحدث فيه حادث) / مَكَان (مَوْضِع؛ المنزلة والشأن، يقال أيضا مكانة) / مَوْضِع\nمثال: هنا موقع الحادث.",
 "所在無い": "مَلُول, ضَجِر",
 "所在無げ": "عَاطِل عَن اَلْعَمَل",
 "所場": "مَيْدَان / مَكَان (مَوْضِع؛ المنزلة والشأن، يقال أيضا مكانة) / مَقْعَد (كل ما يُقْعَدُ ويُجْلَسُ عليه؛ مَكَان القُعُود) / مَكَان, مكان (مَوْضِع؛ المنزلة والشأن، يقال أيضا مكانة) / وَضَعَ, حط (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه)\nمثال: هذا المكان مقدس",
 "所変わって": "أَمَّا (حَرْفُ اِسْتِفْتَاحٍ، وَيَكْثُرُ اِسْتِعْمَالُهُ قَبْلَ القَسَمِ) / إِلَى حِينِ ذَلِكَ الوَقْتِ فِي الأَثْنَاءِ (حرف جر يُفيد الغاية الزمنية؛ حرف جر يُفيد الغاية المكانية) / فِي حِينِ أَنَّ (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: أما زلت تذكرني؟",
 "所嫌わず": "أي مكان, في أي مكان (في أو عند أو إلى أي مكان)\nمثال: يمكنك العثور على هذا الطعام في أي مكان",
 "所存": "رَأْي, نَظَر",
 "所定": "مَفْرُوض, مُقَرَّر (مَنْصُوصٌ عَلَيْهِ كَقَاعِدَةٍ أَوْ دَلِيلٍ إِرْشَادِيّ) / مَنْصُوصٌ عَلَيْه, وَضْعِيّ (مَفْرُوضٌ أَوْ مُقَرَّرٌ رَسْمِيًّا) / رَسْمِيّ, مُقَرَّرٌ (متوافق مع الاستخدام أو الإجراء أو النظام المحدد) / مَفْرُوض, مُقَرَّر (ثابت أو مقرّر خاصّة بأمر أو قرار رسميّ)",
 "所定期間保存": "أَرْشِيف",
 "所属": "تَبَعِيَّة, اِنْتِمَاء (التَّبَعيَّة : كَوْن الشخص أو الشيْ تابعاً لغيره؛ مصدر صناعيّ من تَبَعَ: جِنْسِيَّة ومُواطَنَة أو انتماء إلى دولة ما، يكون للمواطن فيها حقوق وامتيازات، وبالمقابل عليه واجبات)",
 "所属長": "أَجْدَر (أَجْدَرَ النَّبْتُ: جَدَرَ؛ يقال: أَجْدَرَتِ الأَرْضُ) / مُتَفَوِّق / يعلو",
 "所帯": "أسرة, عائلة (وحدة اجتماعية تعيش معًا)\nمثال: نقل عائلته إلى فيرجينيا",
 "所帯主": "رب الأسرة, عائل الأسرة (رئيس الأسرة أو العائلة أو القبيلة)",
 "所帯持ち": "زوج (رجل متزوج؛ شريك المرأة في الزواج)",
 "所得": "دَخْل, إِيرَاد (وَلَجَ؛ أَدْخَلَ. (تعدية خاصة بالباء))\nمثال: دخل توم المبنى.",
 "所得控除": "إعفاء ضريبي, خصم ضريبي (تخفيض في المبلغ الإجمالي الذي تُحسب عليه الضريبة؛ يقلل الضرائب بالنسبة المئوية المحددة لشريحة دخل دافع الضرائب)",
 "所得税": "ضَرِيبَة اَلدَّخْل",
 "所得税法": "ضَرِيبَة اَلدَّخْل",
 "所得税減税": "ضَرِيبَة اَلدَّخْل",
 "所得隠し": "تَهَرُّب ضَرِيبِيّ",
 "所思": "فِكْر, فِكْرَة (أَعْمَلَ عقله ليصل إلى شيءٍ، ليحل مشكلةً. (يتعدى تعدية عامة بفي)) / فِكْر, تَفْكِير (أَعْمَلَ عقله ليصل إلى شيءٍ، ليحل مشكلةً. (يتعدى تعدية عامة بفي))\nمثال: إنها فكرة جيدة.",
 "所感": "اِنْطِبَاع, أَثَر / تَقْلِيد",
 "所所": "هُنَا وَهُنَاكَ",
 "所所方方": "فِي كُلِّ مَكَانٍ (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "所持": "مَسّ, تَلَبُّس / مُمْتَلَك / حَوْزَة, مُلْكِيّة / اِسْتِحْوَاذ / حِيَازَة",
 "所持人": "حامل, ناقل (شخص تتضمن وظيفته حمل شيء ما) / حامل (الشخص الذي بحوزته شيك أو كمبيالة أو سند أو وثيقة ملكية مظهرة له أو لمن يحملها) / حامل (رسول يحمل أو يقدم شيئاً) / حامِل النَّعْش (أحد المشيعين الذين يحملون النعش في الجنازة)\nمثال: نُقلت السندات بواسطة حامل",
 "所持者": "مَالِك, مَالِكَة (اسم شخصي معطًى للذكور من العرب)\nمثال: من مالك هذا البيت؟",
