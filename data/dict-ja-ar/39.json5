 "抑々揚格": "تفعيلة أنابيستية, تفعيلة قصيرة-قصيرة-طويلة (وحدة مترية بمقاطع غير مشددة-غير مشددة-مشددة)",
 "抑うつ": "إحباط, انقباض (حالة من الاكتئاب السوداوي)",
 "抑うつ症": "اضطراب اكتئابي, اكتئاب سريري (حالة من الاكتئاب وانعدام التلذذ شديدة لدرجة تتطلب تدخلاً سريرياً)",
 "抑うつ症群": "اضطراب اكتئابي, اكتئاب سريري (حالة من الاكتئاب وانعدام التلذذ شديدة لدرجة تتطلب تدخلاً سريرياً)",
 "抑うつ障害群": "اضطراب اكتئابي, اكتئاب سريري (حالة من الاكتئاب وانعدام التلذذ شديدة لدرجة تتطلب تدخلاً سريرياً)",
 "抑え": "وَزْن\nمثال: ان ثقل ما تحمل، فضع بعضا منه. / دِفَاع, حِمَايَة",
 "抑えがたい": "جَامِح, لَا يُمْكِنُ كَبْحُهُ (يَسْتَحِيلُ قَمْعُهُ أَوِ السَّيْطَرَةُ عَلَيْه)",
 "抑えきれない": "جَامِح, لَا يُمْكِنُ كَبْحُهُ (يَسْتَحِيلُ قَمْعُهُ أَوِ السَّيْطَرَةُ عَلَيْه)",
 "抑える": "سَيْطَرَ\nمثال: من أنت لتحكم علي؟ / تَفَقُّد",
 "抑え切れない": "جَامِح, لَا يُمْكِنُ كَبْحُهُ (يَسْتَحِيلُ قَمْعُهُ أَوِ السَّيْطَرَةُ عَلَيْه)",
 "抑え込み": "تعطيل, شل الحركة (فعل الحد من الحركة أو جعل الشيء غير قادر على الحركة)\nمثال: تسببت العاصفة في شلل تام لفريق الإنقاذ",
 "抑え込む": "سَيْطَرَ\nمثال: من أنت لتحكم علي؟",
 "抑え難い": "جَامِح, لَا يُمْكِنُ كَبْحُهُ (يَسْتَحِيلُ قَمْعُهُ أَوِ السَّيْطَرَةُ عَلَيْه)",
 "抑制": "سَيْطَرَ\nمثال: من أنت لتحكم علي؟",
 "抑制剤": "مانع, مثبط (مادة تؤخر أو توقف نشاطاً ما)",
 "抑制性": "قَمْعِيّ, كَبْتِيّ (يُقيِّد الفعل أو يكبته)",
 "抑圧": "تَفَقُّد / قَمْع, كَبْت",
 "抑揚": "تَجْوِيد, تَرْتِيل (جوّد القارئ:أتى بـ التّلاوة على وجهها الحقّ وراعى أحكام التّجويد في القرآن (قرأ…)",
 "抑揚のない": "مُمِلّ (ما يسبب الضجر والضيقة، غير مثير للاهتمام)\nمثال: نهار اليوم ممل!",
 "抑揚の無い": "مُمِلّ (ما يسبب الضجر والضيقة، غير مثير للاهتمام)\nمثال: نهار اليوم ممل!",
 "抑揚格": "تفعيلة إيامبية, تفعيلة قصيرة-طويلة (وحدة مترية بمقاطع غير مشددة-مشددة)",
 "抑止": "رَدْع (رَدَعَه عنه: كَفَّهُ ورَدَّهُ، فارْتَدَعَ؛ رَدَعَ جَيْبَه عنه: فَرَجَه)\nمثال: بما أن إسرائيل خسرت حربا في لبنان عام 2006، شنت العديد من حملات قصف كبيرة في غزة كي تسترجع قدرتها على الردع.",
 "抑止力": "رَدْع (رَدَعَه عنه: كَفَّهُ ورَدَّهُ، فارْتَدَعَ؛ رَدَعَ جَيْبَه عنه: فَرَجَه)\nمثال: بما أن إسرائيل خسرت حربا في لبنان عام 2006، شنت العديد من حملات قصف كبيرة في غزة كي تسترجع قدرتها على الردع.",
 "抑留": "اِحْتِجَاز, حَجْز",
 "抑留者": "أسير, أسيرة (اَلْأَسِيرُ هُوَ مَنْ أُسِرَ فِي مَعْرَكَةٍ حَيّّا فَسُجِنَ إِلَى حِينٍ…)\nمثال: أنا بريء وأسير حرب.",
 "抑鬱": "إحباط, انقباض (حالة من الاكتئاب السوداوي)",
 "抒情": "شاعريّة, عاطفة جياشة (حماس مفرط وغير مقيد)",
 "抒情的": "غِنَائِيّ, وِجْدَانِيّ (يعبّر عن عاطفة عميقة)",
 "抒情詩": "غِنَائِيّ, وِجْدَانِيّ (يعبّر عن عاطفة عميقة)\nمثال: سوبرانو غنائي",
 "抓み": "عُقدة, مقبض دائري (مقبض مستدير الشكل) / وَجْبَة خَفِيفَة, لُمْجَة (الحصة التي صارت واجبة؛ الحصة الواحدة من الطعام توجب في موعد محدد)\nمثال: التهم زيري الوجبة. / قَرَصَ / مِقْبَض",
 "抓む": "مِعْوَل, فَأْس (الفأس الكبيرة العظيمة، تستخدم في الزراعة والصناعة)",
 "抓める": "قَرَصَ",
 "抓る": "قَرَصَ",
 "投": "زِفْت",
 "投げ": "رَمَى, صَبَّ ((مُتَعَدٍّ بِنَفْسِهِ) جَعَلَهُ يَتَحَرَّكُ فِي الهَوَاءِ)\nمثال: رمى تلك الموزة. / اِسْتَقَالَ / غربلة, هزة (اقتصادية) (حالة اقتصادية تؤدي إلى إقصاء المشاركين الممولين بشكل هامشي في صناعة…)\nمثال: أغرقوا السوق من أجل إحداث هزة لمنافسيهم",
 "投げかける": "دَارَ, أَدَارَ (المحل يجمع البِنَاء والعَرَصَة. قيل سمي كذلك لدوران الناس به وعليه وحوله. يجمع…)\nمثال: إذهب إلى الدار.",
 "投げやり": "متهاون, مقصّر (يتميز بالإهمال وعدم الاكتراث غير المبرر)\nمثال: آباء مهملون",
 "投げる": "رَمَى, صَبَّ ((مُتَعَدٍّ بِنَفْسِهِ) جَعَلَهُ يَتَحَرَّكُ فِي الهَوَاءِ)\nمثال: رمى تلك الموزة. / تَنَازَلَ / صَبَّ, رَمَى (سَكَبَ، الفرق بين صَبَّ وسَكَب أن الصَبّ يكون متعمدا والسكب قد يكون متعمدا أو…)\nمثال: صب الشاي لضيفك.",
 "投げ下ろす": "مَزْبَلَة, نُفَايَة (موضع تجميع الأَزْبَال والتِفَايَات لحين نقلها؛ حَاوِيَة نفايات؛ موضع خارج…)\nمثال: وضع فاضل جثة دانية في مزبلة.",
 "投げ出す": "مَدَّدَ / اِنْصَرَفَ, يَنْصَرِفُ (فعل مطاوعة لصَرَفَ: صَرَفْتُهُ فَاَنْصَرَف؛ ذهب إلى مكان آخر)\nمثال: انصرف من ملكيتنا! / تَضْحِيَة, قُرْبَان",
 "投げ売り": "إغراق (بيع البضائع في الخارج بسعر أقل من السعر المفروض في السوق المحلية)",
 "投げ打つ": "طَرَحَ (طَرَحَ الشَّيْءَ: أَلْقَاهُ؛ طَرَحَ فُلَاناً أَرْضاً: أَوْقَعَهُ)\nمثال: طرح زيري سؤالا.",
 "投げ技": "رَمَى, صَبَّ ((مُتَعَدٍّ بِنَفْسِهِ) جَعَلَهُ يَتَحَرَّكُ فِي الهَوَاءِ)\nمثال: رمى تلك الموزة.",
 "投げ捨てる": "طَرَحَ (طَرَحَ الشَّيْءَ: أَلْقَاهُ؛ طَرَحَ فُلَاناً أَرْضاً: أَوْقَعَهُ)\nمثال: طرح زيري سؤالا.",
 "投げ掛ける": "دَارَ, أَدَارَ (المحل يجمع البِنَاء والعَرَصَة. قيل سمي كذلك لدوران الناس به وعليه وحوله. يجمع…)\nمثال: إذهب إلى الدار.",
 "投げ棄てる": "طَرَحَ (طَرَحَ الشَّيْءَ: أَلْقَاهُ؛ طَرَحَ فُلَاناً أَرْضاً: أَوْقَعَهُ)\nمثال: طرح زيري سؤالا.",
 "投げ槍": "مِزْرَاق",
 "投げ渡す": "تمرير, رمي ((رياضة) فعل رمي الكرة لعضو آخر في فريقك)\nمثال: تم إهدار التمريرة / اِسْتَسْلَمَ",
 "投げ物": "تَصْفِية",
 "投げ綱": "حبل الرمي (حبل خفيف الوزن مزود بوزن في نهايته، يُلقى بين سفينتين أو بين سفينة والشاطئ لسحب…)\nمثال: غالباً ما تُستخدم عقدة قبضة القرد كوزن في حبل الرمي",
 "投げ網": "شَبَكَة",
 "投げ縄": "أنشوطة, وهق (حبل طويل ذو عقدة منزلقة يستخدم لصيد الحيوانات)",
 "投げ荷": "حطام عائم (حطام سفينة يطفو على الماء)",
 "投げ込み": "أَدْخَلَ",
 "投げ遣り": "متهاون, مقصّر (يتميز بالإهمال وعدم الاكتراث غير المبرر)\nمثال: آباء مهملون",
 "投げ釣り": "صيد الأمواج (رمي طعم (صناعي) بعيداً في المحيط (حتى 200 ياردة) مع تكسر الأمواج حولك)",
 "投げ銭": "طَرَف",
 "投げ飛ばす": "عَلَاقَة سَرِيعَة, علاقة طيارى\nمثال: صب الشاي لضيفك.",
 "投じる": "رَمَى, صَبَّ ((مُتَعَدٍّ بِنَفْسِهِ) جَعَلَهُ يَتَحَرَّكُ فِي الهَوَاءِ)\nمثال: رمى تلك الموزة. / اِسْتَثْمَرَ / أَعْطَى, وَهَبَ (مَنَحَ، نَوَّلَ)\nمثال: أعطى بلده حياته. / اِنْصَرَفَ, يَنْصَرِفُ (فعل مطاوعة لصَرَفَ: صَرَفْتُهُ فَاَنْصَرَف؛ ذهب إلى مكان آخر)\nمثال: انصرف من ملكيتنا!",
 "投ずる": "رَمَى, صَبَّ ((مُتَعَدٍّ بِنَفْسِهِ) جَعَلَهُ يَتَحَرَّكُ فِي الهَوَاءِ)\nمثال: رمى تلك الموزة. / اِسْتَثْمَرَ / أَعْطَى, وَهَبَ (مَنَحَ، نَوَّلَ)\nمثال: أعطى بلده حياته. / اِسْتَسْلَمَ",
 "投てき": "رَمَى, صَبَّ ((مُتَعَدٍّ بِنَفْسِهِ) جَعَلَهُ يَتَحَرَّكُ فِي الهَوَاءِ)\nمثال: رمى تلك الموزة.",
 "投下": "سَاقِط, مُتَسَاقِط (يَنْزِلُ بِحُرِّيَّةٍ تَحْتَ تَأْثِيرِ الجَاذِبِيَّة) / اِسْتِثْمَار",
 "投下ろす": "مَزْبَلَة, نُفَايَة (موضع تجميع الأَزْبَال والتِفَايَات لحين نقلها؛ حَاوِيَة نفايات؛ موضع خارج…)\nمثال: وضع فاضل جثة دانية في مزبلة.",
 "投与": "إِدَارَة, مُرَاقَبَة (هو عملية تولي تَصْرِيف شؤون العَمَل. لا جمع له؛ مجموع الناس الذين يقومون بإدارة…)\nمثال: والدتي تنتظرني في الإدارة.",
 "投与量": "جُرْعَة",
 "投了": "اِسْتِقَالَة, اِسْتِعْفَاء",
 "投企": "إِسْقَاط\nمثال: دفنت في مسقط رأسها.",
 "投信": "شركة استثمار, صندوق استثمار (مؤسسة مالية تبيع الأسهم للأفراد وتستثمر في الأوراق المالية الصادرة عن شركات أخرى)",
 "投光器": "كشاف ضوئي, مصباح غامر (ضوء يعد مصدراً للإضاءة الاصطناعية ذات شعاع عريض؛ يستخدم في التصوير الفوتوغرافي)",
 "投光機": "كشاف ضوئي, مصباح غامر (ضوء يعد مصدراً للإضاءة الاصطناعية ذات شعاع عريض؛ يستخدم في التصوير الفوتوغرافي)",
 "投光照明": "كشاف ضوئي, مصباح غامر (ضوء يعد مصدراً للإضاءة الاصطناعية ذات شعاع عريض؛ يستخدم في التصوير الفوتوغرافي)",
 "投光照明器": "كشاف ضوئي, مصباح غامر (ضوء يعد مصدراً للإضاءة الاصطناعية ذات شعاع عريض؛ يستخدم في التصوير الفوتوغرافي)",
 "投入": "أَدْخَلَ / اِسْتِثْمَار / إطلاق, قذف (فعل الدفع بقوة)\nمثال: تطلعوا إلى الظهور الأول لخط إنتاجهم الجديد / إصدار, إطلاق (فعل توفير عنصر للاستخدام العام أو لأغراض رسمية (عادة بكميات))\nمثال: إصدار جديد من الطوابع",
 "投写": "إِسْقَاط\nمثال: دفنت في مسقط رأسها.",
 "投出": "إِسْقَاط\nمثال: دفنت في مسقط رأسها.",
 "投函": "إرسال بالبريد (إرسال رسالة عبر البريد)\nمثال: يشير ختم البريد إلى وقت الإرسال",
 "投合": "اِتِّفَاق, تَوَافُق",
 "投売り": "إغراق (بيع البضائع في الخارج بسعر أقل من السعر المفروض في السوق المحلية)",
 "投宿": "إِقَامَة",
 "投射": "إِسْقَاط\nمثال: دفنت في مسقط رأسها.",
 "投射物": "قَذْفِيّ, مَقْذُوف (يدفع أو يُدفَع إلى الأمام)",
 "投弾帯": "مِقْلَاع",
 "投影": "إِسْقَاط\nمثال: دفنت في مسقط رأسها. / اِنْعِكَاس, عَكْس",
 "投影図": "إِسْقَاط\nمثال: دفنت في مسقط رأسها.",
 "投影図法": "إِسْقَاط\nمثال: دفنت في مسقط رأسها.",
 "投影式": "إِسْقَاط",
 "投影機": "جِهَاز إِسْقَاط",
 "投影法": "إِسْقَاط\nمثال: دفنت في مسقط رأسها. / اختبار إسقاطي (أي اختبار شخصية مصمم لتقديم معلومات حول شخصية شخص ما بناءً على استجابته غير…)",
 "投手": "إِبْرِيق, زِير",
 "投捨てる": "طَرَحَ (طَرَحَ الشَّيْءَ: أَلْقَاهُ؛ طَرَحَ فُلَاناً أَرْضاً: أَوْقَعَهُ)\nمثال: طرح زيري سؤالا.",
 "投擲": "رَمَى, صَبَّ ((مُتَعَدٍّ بِنَفْسِهِ) جَعَلَهُ يَتَحَرَّكُ فِي الهَوَاءِ)\nمثال: رمى تلك الموزة.",
 "投擲槍": "مِزْرَاق",
 "投映": "بَارِز, مُمْتَدّ (يمتد للخارج فوق سطح أو حدّ أو ما وراءهما)",
 "投書": "حَرْف, حرف (طَرَف وَجَانِب وَحَدّ؛ رَمْز مخطوط أو مطبوع يقوم مقام صوت أو كلمة أو عبارة أو…)\nمثال: ألف هو الحرف الأول للألف باء. / مُسَاهَمَة (المُساهَمَة : المُشاركة والاشتراك في الشيء)\nمثال: ويستطيع الجميع المساهمة.",
 "投書家": "كاتب مساهم, مساهم (كاتب يُنشر عمله في صحيفة أو مجلة أو كجزء من كتاب)",
 "投棄": "هِجْرَان, هُجْرَان",
 "投槍": "مِزْرَاق",
 "投槍器": "عصا رمي, قاذفة رماح (جهاز يشبه المقلاع يستخدم في مجتمعات بدائية مختلفة لدفع سهم أو رمح)",
 "投機": "تَكَهُّنٌ",
 "投機家": "مُضَارِب",
 "投機師": "مُغَامِر, مُغَامِرَة",
 "投機的": "اسْتِفْهَامِيّ, مُتَسَائِل (يُظهِر الفضول والتساؤل)",
 "投機筋": "مُضَارِب",
 "投物": "تَصْفِية",
 "投獄": "حَبْس, سَجْن (مَنَعَ الشيءَ عن الفعلِ؛ أَمْسَكَ الشيءَ، قَبَضَ عَلَيْهِ)\nمثال: هو,البارحة حرر من الحبس.",
 "投球": "رمي ((في البيسبول) اللعب في مركز الرامي)\nمثال: كان التأرجح والتقلب مثيراً للغاية",
 "投球動作": "إتمام, إكمال (إجراء ختامي أو نهائي)",
 "投石": "حَجَر, حجر (حَجَرَ عليه الأمرَ:مَنَعَه منه ، حجر الشّيء على نفسه:خَصَّها به وقصره عليها…)\nمثال: عوقب زيري بالحجر.",
 "投石器": "مَنْجَنِيق, مِرْجَام / مِقْلَاع",
 "投石機": "مَنْجَنِيق, مِرْجَام",
 "投石紐": "مِقْلَاع",
