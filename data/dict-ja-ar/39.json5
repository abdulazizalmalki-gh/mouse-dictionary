 "正規化投影座標系": "مركز منع الانتشار (وكالة تعمل كنقطة محورية لجميع أنشطة مجتمع الاستخبارات المتعلقة بمنع انتشار أسلحة الدمار الشامل وأنظمة إطلاق الصواريخ الخاصة بها)",
 "正規軍": "جيش, قوات برية (منظمة دائمة للقوات البرية العسكرية لأمة أو دولة)",
 "正視": "تبطين, تغليف (تزويد شيء بسطح من مادة مختلفة) / تكسية خارجية, كسوة (غطاء واقٍ يحمي الجزء الخارجي من المبنى) / بطانة الحافة, سجاف (بطانة تطبق على حافة الملابس للزينة أو التقوية) / تكسية, قشرة خارجية (طلاء زخرفي لمبنى) / بصر سوي, سواء البصر ((طب العيون) الحالة الانكسارية الطبيعية للعين حيث يوجد تركيز واضح للضوء على الشبكية)",
 "正視眼": "بصر سوي, سواء البصر ((طب العيون) الحالة الانكسارية الطبيعية للعين حيث يوجد تركيز واضح للضوء على الشبكية)",
 "正誤": "دِقَّة / تَصْحِيح",
 "正誤表": "خطأ مطبعي, هفوة مطبعية (خطأ في المادة المطبوعة ناتج عن أعطال ميكانيكية من نوع ما)",
 "正課外": "خَارِج نِطَاق الزَّوَاج, زَانٍ (يتسم بالزنا أو العلاقات خارج إطار الزواج) / خَارِج نِطَاق العَمَل (خارج المهام الاعتيادية للوظيفة أو المهنة) / خَارِج المِنْهَاج, لَا مَنْهَجِيّ (خارج المنهج الدراسي الأكاديمي المعتاد)",
 "正貨": "مسكوكات, نقود معدنية (العملات المعدنية مجتمعة)",
 "正賓": "ضيف الشرف (الشخص الذي يُعقد التجمع تكريماً له)",
 "正路": "استقامة, بر (التمسك بالمبادئ الأخلاقية)",
 "正身": "الشَّيْء الأَصْلِيّ (استخدام غير رسمي ينسب الأصالة)",
 "正選手": "أَسَاسِيّ فِي الفَرِيق (عضو دائم وأساسيّ في الفريق) / أَسَاسِيّ, مِنَ الصَّفِّ الْأَوَّلِ (من أعضاء الفريق الأساسيين؛ ليس بديلاً)",
 "正金": "نَقْد, نُقُود / مسكوكات, نقود معدنية (العملات المعدنية مجتمعة)",
 "正長石": "أرثوكلاز (فلسبار أحادي الميل أبيض أو ملون)",
 "正電極": "مِصْعَد / أَنُود",
 "正電気": "شحنة موجبة (وجود نقص في الإلكترونات؛ وجود جهد كهربائي أعلى)",
 "正電荷": "شحنة موجبة (وجود نقص في الإلكترونات؛ وجود جهد كهربائي أعلى)",
 "正面": "جَبْهَة / أَمَامِيّ\nمثال: 正面のドアは鍵がかかったままだった。 — ظل الباب مغلقاً.",
 "正面から": "جَبْهِيّ, مُوَاجِه (يلتقي وجهاً لوجه بشكل مباشر) / بمقدمته, وجهاً لوجه (مع المقدمة أولاً) / بشكل مباشر, بمواجهة (في معارضة مباشرة؛ مباشرة) / مُبَاشِر, مُوَاجِه (يتَّسم بالمعارضة المباشرة وجهاً لوجه)\nمثال: اصطدمت السيارات وجهاً لوجه",
 "正面きって": "بشكل علني, بصراحة (بطريقة مفتوحة)\nمثال: تباهى علانية بعاطفته تجاه أخته",
 "正面切って": "بشكل علني, بصراحة (بطريقة مفتوحة)\nمثال: تباهى علانية بعاطفته تجاه أخته",
 "正面口": "باب أمامي, مدخل أمامي (باب خارجي (عند المدخل) في واجهة المبنى)",
 "正面玄関": "باب أمامي, مدخل أمامي (باب خارجي (عند المدخل) في واجهة المبنى)",
 "正面衝突": "جَبْهِيّ, مُوَاجِه (يلتقي وجهاً لوجه بشكل مباشر) / بمقدمته, وجهاً لوجه (مع المقدمة أولاً) / بشكل مباشر, بمواجهة (في معارضة مباشرة؛ مباشرة) / مُبَاشِر, مُوَاجِه (يتَّسم بالمعارضة المباشرة وجهاً لوجه)\nمثال: اصطدمت السيارات وجهاً لوجه",
 "正餐": "وَلِيمَة, مَأْدُبَة (طعام العُرْس؛ أي طعام صنع لدعوة ولجمع كبير من الناس)\nمثال: كانت الوليمة من أطيب ما ذقت.",
 "正鵠": "إصابة الهدف, نجاح تام (شيء ينجح تماماً في تحقيق هدفه) / إصابة في الصميم, إصابة مركز الهدف (في الرماية: نقطة تُحرز بضرب مركز الهدف) / فانوس مظلم (فانوس بفتحة واحدة ولوحة منزلقة يمكن إغلاقها لإخفاء الضوء) / إصابة الهدف, نقطة الوسط (مركز الهدف)\nمثال: كانت الحملة الإعلانية الجديدة نجاحاً تاماً",
 "此": "هَٰذَا, هَٰذِهِ / هٰذَا, هٰذِهِ",
 "此うした": "مِثْل, هَكَذَا (الشَبَه؛ النَظِير)\nمثال: قصدته مثل نكتة.",
 "此の中": "أَمَّا (حَرْفُ اِسْتِفْتَاحٍ، وَيَكْثُرُ اِسْتِعْمَالُهُ قَبْلَ القَسَمِ) / إِلَى حِينِ ذَلِكَ الوَقْتِ فِي الأَثْنَاءِ (حرف جر يُفيد الغاية الزمنية؛ حرف جر يُفيد الغاية المكانية) / فِي حِينِ أَنَّ (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: أما زلت تذكرني؟ / مُؤَخَّرًا / حَدِيثًا / بِأَخَرَة",
 "此の内": "أَمَّا (حَرْفُ اِسْتِفْتَاحٍ، وَيَكْثُرُ اِسْتِعْمَالُهُ قَبْلَ القَسَمِ) / إِلَى حِينِ ذَلِكَ الوَقْتِ فِي الأَثْنَاءِ (حرف جر يُفيد الغاية الزمنية؛ حرف جر يُفيد الغاية المكانية) / فِي حِينِ أَنَّ (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: أما زلت تذكرني؟",
 "此の君": "خَيْزَرَان, خَيْزُرَان",
 "此の故に": "إِذَنْ, لِذٰلِكَ (و جزاء ينصب الفعل المضارع إذا كان متصدرا غير مفصول عنه)\nمثال: تحتاج لإذن خطي.",
 "此の糸": "بَنَفْسَجِيّ / أُرْجُوَانِيّ",
 "此の頃様": "عَصْرِيّ, حَدِيث",
 "此れ者": "مُقَامِر / مُغَامِر",
 "此ん": "هَٰذَا, هَٰذِهِ / هٰذَا, هٰذِهِ",
 "此処許": "إِلَى هُنَا (حرف جر يُفيد الغاية الزمنية؛ حرف جر يُفيد الغاية المكانية)\nمثال: تعال إلى منزلي. / أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى.",
 "此方様": "مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة!",
 "此様": "مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة!",
 "此樣": "مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة!",
 "此許": "إِلَى هُنَا (حرف جر يُفيد الغاية الزمنية؛ حرف جر يُفيد الغاية المكانية)\nمثال: تعال إلى منزلي. / أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى.",
 "此間": "مُنْذُ بِضْعَةْ أَيَّام, بِالْأَمْس",
 "武": "فَنٌّ قِتَالِيّ, الفُنُون القِتَالِيَّة (نوع، صنف؛ كل عمل جميل يؤثر في المشاعر والعواطف)\nمثال: هذا مدرسنا في الفن. / قوة عسكرية, وحدة عسكرية (وحدة تكون جزءًا من خدمة عسكرية ما)\nمثال: أرسل لقيصر قوة قوامها ستة آلاف رجل / إقدام, بسالة (صفات البطل أو البطلة؛ شجاعة استثنائية أو بطولية عند مواجهة الخطر (خاصة في المعركة))\nمثال: أظهر بطولة عظيمة في المعركة / ضابط, ضابط عسكري (أي شخص في القوات المسلحة يشغل منصباً ذا سلطة أو قيادة)\nمثال: الضابط مسؤول عن حياة رجاله",
 "武し": "شُجَاع, جَرِيء (الثعبان)\nمثال: إنك شجاع للغاية. / حَازِم, قَوِيّ (يتّسم بالقوة والحيوية في الفعل أو النشاط) / قَوِيّ, نَشِيط (قوي ونشيط بدنياً أو ذهنياً) / قَوِيّ, قَادِر (اسم من أسماء الله الحسنى؛ الشَدِيْد ذو الحَوْل)\nمثال: كانت صدمة قوية. / لَافِت, مُلْفِتٌ لِلنَّظَرِ (لَهُ صِفَةٌ تَفْرِضُ نَفْسَهَا عَلَى الِانْتِبَاهِ) / بَارِز, عَظِيم (ذو أهمّيّة أو دلالة كُبرى) / غَيْرُ مُسَدَّد, مُسْتَحَقّ (مُسْتَحَقٌّ كَدَيْن) / بَارِع, مُتَمَيِّز (يتميز عن غيره بالتفوق)",
 "武事": "فَنٌّ قِتَالِيّ, الفُنُون القِتَالِيَّة (نوع، صنف؛ كل عمل جميل يؤثر في المشاعر والعواطف)\nمثال: هذا مدرسنا في الفن.",
 "武人": "جندي, عسكري (رجل يخدم في القوات المسلحة؛ عضو في قوة عسكرية)",
 "武侠": "مُرُوءَة",
 "武備": "تَسْلِيح",
 "武具": "درع النبالة, شعار النبالة (الرموز الرسمية لعائلة أو دولة، إلخ) / أسلحة, تسليح (الأسلحة مجتمعة)",
 "武力": "سَيْف, حُسَام (مصدر للفعل سَافَ؛ سِلاح ذو حَدّ واحد طويل يعتبر من الأسْلِحَة البيضاء لأنها مصنوعة من حَدِيد أبيض حاد. كان أهم أنواع الأسلحة قبل اخْتِرَاع الأسلحة النَارِيَّة) / سَيَّافٌ\nمثال: القلم أقوى من السيف.",
 "武力政治": "دبلوماسية الزوارق الحربية, سياسة القوة (دبلوماسية تهدد فيها الدول باستخدام القوة لتحقيق أهدافها)",
 "武勇": "شَجَاعَة",
 "武器": "سِلَاح, أَسْلِحَة",
 "武器倉": "ترسانة, مخزن أسلحة (مكان يتم فيه تصنيع الأسلحة) / ترسانة, مخزن أسلحة (هيكل عسكري حيث تُخزن الأسلحة والذخيرة والمعدات العسكرية الأخرى ويتم التدريب على استخدام الأسلحة) / ترسانة (جميع الأسلحة والمعدات التي تمتلكها دولة ما) / ترسانة, جعبة (مجموعة من الموارد)\nمثال: غرف من ترسانته الفكرية ليجد إجابة",
 "武器取引": "صفقة أسلحة (صفقة لتوفير أسلحة عسكرية)",
 "武器庫": "ترسانة, مخزن أسلحة (مكان يتم فيه تصنيع الأسلحة) / ترسانة, مخزن أسلحة (هيكل عسكري حيث تُخزن الأسلحة والذخيرة والمعدات العسكرية الأخرى ويتم التدريب على استخدام الأسلحة) / ترسانة (جميع الأسلحة والمعدات التي تمتلكها دولة ما) / ترسانة, جعبة (مجموعة من الموارد)\nمثال: غرف من ترسانته الفكرية ليجد إجابة",
 "武器貸与": "إعارة وتأجير (نقل السلع والخدمات إلى حليف للمساعدة في قضية مشتركة)\nمثال: كان برنامج الإعارة والتأجير خلال الحرب العالمية الثانية سخياً للغاية",
 "武士": "سَامُورَاي / مُحَارِب, مُقَاتِل",
 "武士道": "بوشيدو (القانون التقليدي للساموراي الياباني الذي يؤكد على الشجاعة والولاء والانضباط الذاتي والعيش البسيط)",
 "武夫": "مُحَارِب, مُقَاتِل",
 "武学": "علوم عسكرية (التخصص الذي يتعامل مع مبادئ الحرب)",
 "武官": "ضابط, ضابط عسكري (أي شخص في القوات المسلحة يشغل منصباً ذا سلطة أو قيادة)\nمثال: الضابط مسؤول عن حياة رجاله",
 "武家": "سَامُورَاي",
 "武庫": "ترسانة, مخزن أسلحة (مكان يتم فيه تصنيع الأسلحة) / ترسانة, مخزن أسلحة (هيكل عسكري حيث تُخزن الأسلحة والذخيرة والمعدات العسكرية الأخرى ويتم التدريب على استخدام الأسلحة) / ترسانة (جميع الأسلحة والمعدات التي تمتلكها دولة ما) / ترسانة, جعبة (مجموعة من الموارد)\nمثال: غرف من ترسانته الفكرية ليجد إجابة",
 "武弁": "جُنْدِيّ, عَسْكَرِيّ (لقب عسكري يُطلق على من يلتحق بالجَيْش ويعمل فيه، مقاتل، محارب، عسكري؛ (في الشطرنج) اسم آخر للبيدق)\nمثال: غادر ذلك الجندي.",
 "武徳": "فَنٌّ قِتَالِيّ, الفُنُون القِتَالِيَّة (نوع، صنف؛ كل عمل جميل يؤثر في المشاعر والعواطف)\nمثال: هذا مدرسنا في الفن.",
 "武技": "فَنٌّ قِتَالِيّ, الفُنُون القِتَالِيَّة (نوع، صنف؛ كل عمل جميل يؤثر في المشاعر والعواطف)\nمثال: هذا مدرسنا في الفن.",
 "武断": "عَسْكَرِيَّة",
 "武断主義": "عَسْكَرِيَّة",
 "武断政治": "حكم عسكري, حكومة عسكرية (الحكم بواسطة الجيش والقوات المسلحة)",
 "武断的": "عَسْكَرِتَارِيّ, نَزَّاعٌ إِلَى التَّسَلُّح (مُشْبَعٌ بِالنَّزْعَةِ العَسْكَرِيَّة)",
 "武漢": "وُوهَان, وُوخَان",
 "武略": "إِسْتْرَاتِيجِيَّة (الإستراتيجية فن وعلم وضع خُطط الحرب وإدارة العمليَّات الحربيَّة: إستراتيجيَّة القوَّات المسلَّحة؛ خُطَّة شاملة في أي مجال من المجالات: وضعت الحكومة إستراتيجيَّة مستقبليَّة للنهوض بالاقتصاد القوميّ)\nمثال: ستحمي روسيا مصالحها الإستراتيجية كما تفعل الولايات المتحدة.",
 "武者": "مُحَارِب, مُقَاتِل",
 "武者修業": "دُونْكِيشُوتِيَّة, فُرُوسِيَّة مُتَجَوِّلَة (سلوك دونكيشوتي (رومانسي وغير عملي)) / فروسية جوالة ((العصور الوسطى) قواعد السلوك التي يراعيها الفارس الجوال الذي يتجول بحثاً عن مآثر الفروسية)",
 "武者振り": "براعة, فن (مهارة فائقة يمكنك تعلمها بالدراسة والممارسة والملاحظة)\nمثال: فن المحادثة",
 "武芸": "فَنٌّ قِتَالِيّ, الفُنُون القِتَالِيَّة (نوع، صنف؛ كل عمل جميل يؤثر في المشاعر والعواطف)\nمثال: هذا مدرسنا في الفن.",
 "武術": "فَنٌّ قِتَالِيّ, الفُنُون القِتَالِيَّة (نوع، صنف؛ كل عمل جميل يؤثر في المشاعر والعواطف)\nمثال: هذا مدرسنا في الفن. / اَلْوُوشُو",
 "武術太極拳": "اَلْوُوشُو",
 "武装": "درع النبالة, شعار النبالة (الرموز الرسمية لعائلة أو دولة، إلخ) / أسلحة, تسليح (الأسلحة مجتمعة)",
 "武装具": "إكسسوار, كماليات (ملابس أو أدوات تُرتدى أو تُحمل، ولكنها ليست جزءاً من الملابس الرئيسية)",
 "武装強盗": "سَطْو مُسَلَّح",
 "武装解除": "نَزْع السِلَاح (قَلَعَ، أَزَالَ؛ خَلَعَ)\nمثال: نزع زيري البساط.",
 "武道": "فَنٌّ قِتَالِيّ, الفُنُون القِتَالِيَّة (نوع، صنف؛ كل عمل جميل يؤثر في المشاعر والعواطف)\nمثال: هذا مدرسنا في الفن.",
 "武闘派": "مُقَاتِل, مُحَارِب (مُقاتِل: اسم مذكر يجمع : يجمع جمعا سالما على مُقاتِلون وجمع تكسير على مُقاتِلة واسم فاعل من قَاتَل)",
 "武陵桃源": "شَانْغْرِيلَا",
 "武骨": "غَلِيظٌ, فَظٌّ (سيئ السلوك وخشن ومحتقر في التصرف أو المظهر)",
 "武骨一徹": "رَيْفِيّ, قَرَوِيّ",
 "武骨者": "عديم التربية, فظ (شخص فظ غير مهذب يفتقر للثقافة أو الرقي)",
 "歩": "جُنْدِيّ (لقب عسكري يُطلق على من يلتحق بالجَيْش ويعمل فيه، مقاتل، محارب، عسكري؛ (في الشطرنج) اسم آخر للبيدق) / بَيْدَق ((في الشطرنج) القطعة الأكثر انتشارًا على رقعة الشِطْرَنْج) / بيذق\nمثال: غادر ذلك الجندي. / خُطْوَة, خَطْوَة / خَطْوَة / قِيَافَة, مِشْيَة / مُتَجَسِّد / مَشْي (السَيْر على رجلين؛ السير عامّة)\nمثال: مشي توم مع ماري. / خطوة, خطوة واسعة (خطوة في المشي أو الجري) / معدل, وتيرة (السرعة النسبية للتقدم أو التغيير) / ياردة (وحدة للطول تساوي 3 أقدام؛ محددة بـ 91.44 سنتيمتر) / خطوة (المسافة التي تغطيها خطوة)\nمثال: عاش بوتيرة سريعة / طَبَق, وَجْبَة (جَعَلَ شيئًا يغطي شيئًا آخر بشكل كامل؛ نفَّذَ أمرًا أو خطةً عمليةً) / مَسار (المَسَار: اسم مكان من سارَ : مسلك ، طريق ؛ خَطُّ السَّيْر؛ مَسَار كوكب حول الشَّمس : مدار)\nمثال: هذا الطبق لذيذ. / زِفْت / عُمُولَة / بِالضَّبْط, تَمَامًا / بِالْضَبْط / جندي مشاة, سائر (شخص يقاتل سيراً على الأقدام بأسلحة خفيفة) / تابع, مرؤوس (مساعد خاضع لسلطة أو سيطرة آخر) / مُتَجَسِّد / مَشْي (السَيْر على رجلين؛ السير عامّة)\nمثال: مشي توم مع ماري.",
 "歩き": "مَشَى, تَمَشَّى (اِنْتَقَلَ من مكان إلى آخر؛ اِنْتَقَلَ من مكان إلى آخر على الأقدام. (تخصيص)) / تمشّى / مَسِير, سِيرَة / مِشْيَة\nمثال: مشى ياني مع سكورا.",
 "歩きだす": "بَدَأَ, اِبْتَدَأَ (حَدَثَ ونَشَأَ وحَصَلَ؛ أَخَذَ، شَرَعَ)\nمثال: بدأ سامي يتكلم.",
 "歩き出す": "بَدَأَ, اِبْتَدَأَ (حَدَثَ ونَشَأَ وحَصَلَ؛ أَخَذَ، شَرَعَ)\nمثال: بدأ سامي يتكلم.",
 "歩く": "مَشَى, تَمَشَّى (اِنْتَقَلَ من مكان إلى آخر؛ اِنْتَقَلَ من مكان إلى آخر على الأقدام. (تخصيص)) / تمشّى / مَسِير, سِيرَة / مِشْيَة\nمثال: مشى ياني مع سكورا.",
 "歩ぶ": "مَشَى, تَمَشَّى (اِنْتَقَلَ من مكان إلى آخر؛ اِنْتَقَلَ من مكان إلى آخر على الأقدام. (تخصيص)) / تمشّى / مَسِير, سِيرَة / مِشْيَة\nمثال: مشى ياني مع سكورا.",
 "歩み": "مُتَجَسِّد / مَشْي (السَيْر على رجلين؛ السير عامّة)\nمثال: مشي توم مع ماري. / خطوة, خطوة واسعة (خطوة في المشي أو الجري) / معدل, وتيرة (السرعة النسبية للتقدم أو التغيير) / ياردة (وحدة للطول تساوي 3 أقدام؛ محددة بـ 91.44 سنتيمتر) / خطوة (المسافة التي تغطيها خطوة)\nمثال: عاش بوتيرة سريعة / طَبَق, وَجْبَة (جَعَلَ شيئًا يغطي شيئًا آخر بشكل كامل؛ نفَّذَ أمرًا أو خطةً عمليةً) / مَسار (المَسَار: اسم مكان من سارَ : مسلك ، طريق ؛ خَطُّ السَّيْر؛ مَسَار كوكب حول الشَّمس : مدار)\nمثال: هذا الطبق لذيذ. / زِفْت",
 "歩みよる": "حَل وَسَط, تَسْوِيَة (للعقدة: ضد عَقْدها؛ للجامد في السائل: إذابته) / يخترق\nمثال: حل زيري المشكل. / اِقْتَرَبَ / اِقْتِرَاب, مُقَارَبَة (اقتراب) / كَيْفِيَّة, طَرِيقَة\nمثال: هو واصل الاقتراب مني.",
 "歩み合い": "حَل وَسَط, تَسْوِيَة (للعقدة: ضد عَقْدها؛ للجامد في السائل: إذابته) / يخترق\nمثال: حل زيري المشكل.",
 "歩み寄り": "حَل وَسَط, تَسْوِيَة (للعقدة: ضد عَقْدها؛ للجامد في السائل: إذابته) / يخترق\nمثال: حل زيري المشكل.",
 "歩み寄る": "حَل وَسَط, تَسْوِيَة (للعقدة: ضد عَقْدها؛ للجامد في السائل: إذابته) / يخترق\nمثال: حل زيري المشكل. / اِقْتَرَبَ / اِقْتِرَاب, مُقَارَبَة (اقتراب) / كَيْفِيَّة, طَرِيقَة\nمثال: هو واصل الاقتراب مني.",
 "歩み方": "حَرُكَ, تَحَرَّكَ (غَيَّرَ مَوْضِعَهُ أو مَكَانَهُ أو حَالَه؛ حَرُكَ الوَلَدُ : تَحَرَّكَ، أَوْ خَرَجَ عَنْ سُكُونِهِ) / اِنْتَقَلَ, تَحَلْحَلَ\nمثال: لقد أوقفنا حركة المرور.",
 "歩み板": "لوحة القدم (لوح عمودي أو لوحة تشكل قدم السرير) / موطئ القدم (منصة ضيقة للوقوف أو تثبيت القدمين)",
 "歩み続ける": "تَابَعَ, اِسْتَمَرَّ",
 "歩む": "مَشَى, تَمَشَّى (اِنْتَقَلَ من مكان إلى آخر؛ اِنْتَقَلَ من مكان إلى آخر على الأقدام. (تخصيص)) / تمشّى / مَسِير, سِيرَة / مِشْيَة\nمثال: مشى ياني مع سكورا. / دَعَسَ, دَاسَ (الدَّعْسُ، كالمَنْعِ: حَشْوُ الوِعَاءِ، وَقد دَعَسَه: حَشَاهُ. والدَّعْسُ: شِدَّةُ الَوطْء) / صَعِدَ",
 "歩を進める": "مَشَى, تَمَشَّى (اِنْتَقَلَ من مكان إلى آخر؛ اِنْتَقَلَ من مكان إلى آخر على الأقدام. (تخصيص)) / تمشّى / مَسِير, سِيرَة / مِشْيَة\nمثال: مشى ياني مع سكورا.",
 "歩一歩": "خُطْوَةً خُطْوَةً, خُطْوَةً بِخُطْوَةٍ",
 "歩人": "مَاشٍ",
 "歩兵": "مُشَاة, بِيَادَة / جُنْدِيّ (لقب عسكري يُطلق على من يلتحق بالجَيْش ويعمل فيه، مقاتل، محارب، عسكري؛ (في الشطرنج) اسم آخر للبيدق) / بَيْدَق ((في الشطرنج) القطعة الأكثر انتشارًا على رقعة الشِطْرَنْج) / بيذق\nمثال: غادر ذلك الجندي.",
 "歩兵戦闘車両": "مَرْكَبَةُ مُشَاةِ قِتَالِيَّة",
 "歩割": "مُعَدَّل (هو الأمر الذي جرى عليه تَعْدِيل فهو أفضل من ما يناظره؛ السيارة المعدّلة تسير بسرعة أكبر من مثيلاتها) / سِعْر (سَعِرَ يَسْعَرَ سَعَراً، وسُعْرَةً: ضرب لونه إِلى السواد فُوَيْقَ الأُدْمة؛ فهو أَسْعَرُ، وهي سَعْراءُ. والجمع: سُعْرٌ)\nمثال: انخفض معدل الجريمة. / عُمُولَة",
 "歩卒": "جندي مشاة, سائر (شخص يقاتل سيراً على الأقدام بأسلحة خفيفة) / تابع, مرؤوس (مساعد خاضع لسلطة أو سيطرة آخر)",
 "歩合": "مُعَدَّل (هو الأمر الذي جرى عليه تَعْدِيل فهو أفضل من ما يناظره؛ السيارة المعدّلة تسير بسرعة أكبر من مثيلاتها) / سِعْر (سَعِرَ يَسْعَرَ سَعَراً، وسُعْرَةً: ضرب لونه إِلى السواد فُوَيْقَ الأُدْمة؛ فهو أَسْعَرُ، وهي سَعْراءُ. والجمع: سُعْرٌ)\nمثال: انخفض معدل الجريمة. / عُمُولَة",
 "歩哨": "حارِس, خَفِير (شخص يتم توظيفه للمراقبة تحسباً لحدث متوقع)",
 "歩容": "مشية (طريقة مشي الشخص) / مشية الحصان (طريقة تحرك الحصان) / سُرْعَة المَشْي, مِشْيَة (معدل الحركة (خاصة المشي أو الجري))",
 "歩帯": "ميزاب حركي (إحدى المناطق الخمس على السطح السفلي لشوكيات الجلد التي توجد عليها الأقدام الأنبوبية)",
 "歩幅": "خُطْوَة, خَطْوَة / خَطْوَة / قِيَافَة, مِشْيَة",
 "歩廊": "رِوَاق, دِهْلِيز (مَمَرّ خارج المَبْنَى وملاصق له يمتد عليه السَقْف ويُصفّ على الجانب الآخر الأعمدة؛ في العصر الحديث يُطلق على الممر عامة) / مَمَرّ جَوِّيّ, مُـخـتَرَق جَوِّيّ (على مَمَرّ العصور: على طولها ومداها؛ على مَمَرّ الفصول: على تواليها وتعاقبها)\nمثال: ذهب إلى الرواق.",
 "歩引き": "خَصْم, تَخْفِيض (الخَصْمُ :مُجَادِل، مُنَازِع، مُخَاصِم، عكسه حَلِيف أو صَدِيْق، وقد يستوي فيه المفرد والمثنى والجمع؛ والخَصْمُ (في ) : حَطِيطَة)",
 "歩掛り": "إنْتَاجِيَّة",
 "歩数計": "مقياس الخطوات (أداة قياس لتسجيل عدد الخطوات المقطوعة في المشي)",
 "歩様": "مشية (طريقة المشي)\nمثال: كان لديه مشية مضحكة",
 "歩武": "خُطْوَة, خَطْوَة / خَطْوَة / قِيَافَة, مِشْيَة",
 "歩留まり": "أَجْزَأَ (أَجْزَأَ القومُ: جَزَأَتْ إِبِلُهُمْ؛ أَجْزَأَ المرأَةُ: ولدت الإِنَاث) / أَجْزَى / أَدَرَّ ((أَدِرَ) أدرا وأدرة وأدرة: انتفخت خصيته لتسرب سائل في غلافها فهو آدر وأدرت الخصية فهي أدراء (ج) أدر) / أَغَلَّ / أَكْسَبَ / أَمَّنَ (وَثِقَ به وأرْكَنَ إليه) / إِفَادَة / إِفَادَةٌ مِنْ / إِنْتاج / إِيراد / اِسْتِفَادَة / جَدَاء\nمثال: لا أدر لماذا بكيت هذا القدر كله.",
 "歩留り": "أَجْزَأَ (أَجْزَأَ القومُ: جَزَأَتْ إِبِلُهُمْ؛ أَجْزَأَ المرأَةُ: ولدت الإِنَاث) / أَجْزَى / أَدَرَّ ((أَدِرَ) أدرا وأدرة وأدرة: انتفخت خصيته لتسرب سائل في غلافها فهو آدر وأدرت الخصية فهي أدراء (ج) أدر) / أَغَلَّ / أَكْسَبَ / أَمَّنَ (وَثِقَ به وأرْكَنَ إليه) / إِفَادَة / إِفَادَةٌ مِنْ / إِنْتاج / إِيراد / اِسْتِفَادَة / جَدَاء\nمثال: لا أدر لماذا بكيت هذا القدر كله.",
 "歩行": "مُتَجَسِّد / مَشْي (السَيْر على رجلين؛ السير عامّة)\nمثال: مشي توم مع ماري. / جندي مشاة, سائر (شخص يقاتل سيراً على الأقدام بأسلحة خفيفة) / تابع, مرؤوس (مساعد خاضع لسلطة أو سيطرة آخر) / مُتَجَسِّد / مَشْي (السَيْر على رجلين؛ السير عامّة)\nمثال: مشي توم مع ماري.",
 "歩行器": "مشاية أطفال (هيكل مغلق على عجلات؛ يساعد الأطفال على تعلم المشي)",
 "歩行者": "رَاجِل, مَاشٍ",
 "歩行虫": "خنفساء أرضية (خنفساء أرضية مفترسة سوداء لامعة أو معدنية اللون تقضي على العديد من الحشرات الضارة) / دُودَة أَلْفِيَّة, ذات الألف قدم",
 "歩行補助器": "مَاشٍ",
 "歩調": "خطوة, خطوة واسعة (خطوة في المشي أو الجري) / معدل, وتيرة (السرعة النسبية للتقدم أو التغيير) / ياردة (وحدة للطول تساوي 3 أقدام؛ محددة بـ 91.44 سنتيمتر) / خطوة (المسافة التي تغطيها خطوة)\nمثال: عاش بوتيرة سريعة",
 "歩道": "مَمْشًى, مَسار الْشَاة",
 "歩道橋": "جسر مشاة (جسر مصمم لعبور المشاة)",
 "歪": "مُحَرَّف, مُشَوَّه (تم تغيير معناه المقصود أو تشويهه) / مَعِيب الشَّكْل, مُشَوَّه (سيّئ التكوين إلى حدّ القبح) / إِهْلِيلَج / إِهْلِيلَجِيّ, بَيْضَوِيّ",
 "歪み": "سُلَالَة / التواء, تشويه (عملية لي أو تشويه شكل شيء ما (مثل الجسم)) / التواء, تلوّي (شكل أو وضع ملتو ومتعرج)\nمثال: قام البهلوان بالتواءات لا تصدق / خلل بسيط, عقدة (صعوبة أو عيب في خطة أو عملية) / شطحة, فكرة غريبة (فكرة غريبة الأطوار) / شَاذّ, مُنْحَرِف جِنْسِيّاً (شخص ذو ميول جنسية غير عادية) / التواء, عقدة (انحناء حاد في خط ناتج عن سحب خط به حلقة بقوة)\nمثال: لا يزال هناك بعض العقد التي يجب حلها",
 "歪む": "سدى (الخيط المرتب طولياً على النول ويقطعه اللحمة) / اعوجاج, انحراف (تشويه أخلاقي أو عقلي) / اعوجاج, انبعاج (شكل مشوه باللي أو الطي) / انحراف (التواء أو شذوذ؛ خاصة طريقة منحرفة أو غير طبيعية في الحكم أو التصرف)",
 "歪める": "ثَنَى (طوى شيئًا وجعله على شكل مزدوج؛ أعاد النظر أو غير مسار قراره أو تصرفه) / مُرْتَشٍ, فَاسِد / أَفْسَدَ",
 "歪力": "إِجْهَاد",
 "歪度": "تَجَانُف",
 "歪曲": "تحريف, تشويه (خطأ تحريف الحقائق) / تشويه, لوي الحقائق (فعل تشويه الشيء ليبدو وكأنه يعني شيئاً لم يكن يقصده) / تحريف, تشويه (تغيير للأسوأ) / تشوه, زيغ (ظاهرة بصرية ناتجة عن فشل عدسة أو مرآة في إنتاج صورة جيدة)",
 "歯": "سِنّ, سن ((سَنَّ) السِّكِّينَ و نحْوَهُ يَسُنُّ سَنًّا: أَحَدَّهُ؛ فهو مسنون وسَنِين)\nمثال: هم في نفس السن. / دَعَمَ, دَعَّمَ (• دَعَمَهُ، كمنَعهُ: مالَ فأقامَهُ) / أَيَّدَ, دَعَمَ ((أَيَّدَه): قوّاه بالإياد) / تَأْيِيد, دَعْم\nمثال: ياني هنا لدعم ريمة. / عُمْر ((في الإسلام) أبو حفص عمر بن الخطاب العدوي القرشي، ثاني الخلفاء الراشدين في المذهب السني) / سِنّ ((سَنَّ) السِّكِّينَ و نحْوَهُ يَسُنُّ سَنًّا: أَحَدَّهُ؛ فهو مسنون وسَنِين)\nمثال: جون في عمر أخي. / سِنّ, سن ((سَنَّ) السِّكِّينَ و نحْوَهُ يَسُنُّ سَنًّا: أَحَدَّهُ؛ فهو مسنون وسَنِين)\nمثال: هم في نفس السن. / عُمْر ((في الإسلام) أبو حفص عمر بن الخطاب العدوي القرشي، ثاني الخلفاء الراشدين في المذهب السني) / سِنّ ((سَنَّ) السِّكِّينَ و نحْوَهُ يَسُنُّ سَنًّا: أَحَدَّهُ؛ فهو مسنون وسَنِين)\nمثال: جون في عمر أخي.",
 "歯かす": "لوحة تذكارية نحاسية, لوحة معدنية (نصب تذكاري مصنوع من النحاس الأصفر) / لويحة ((علم الأمراض) رقعة غير طبيعية صغيرة على أو داخل الجسم)",
 "歯がみ": "صرير الأسنان",
 "歯がゆい": "ضجر, عجول (قلق أو سريع الغضب تحت التأخير أو المعارضة)\nمثال: نافذ الصبر مع الطلاب الأبطاء",
 "歯ぎしり": "صرير الأسنان",
 "歯くそ": "لوحة تذكارية نحاسية, لوحة معدنية (نصب تذكاري مصنوع من النحاس الأصفر) / لويحة ((علم الأمراض) رقعة غير طبيعية صغيرة على أو داخل الجسم)",
 "歯ぐき": "لِثَة, لَثَة / صَمْغ / عِلْكَة",
 "歯ごたえ": "ثَبَات / تَحَدٍّ, التَّحَدِّي",
 "歯する": "دبلوم متوسط, درجة مشارك (درجة تمنحها كلية لمدة عامين عند إتمام الطالب بنجاح للدراسات الجامعية الأولية) / قرين, مرافق (أي حدث يصاحب عادة أو يرتبط ارتباطاً وثيقاً بآخر) / رَفِيق, زَمِيل (شخص ينضم للآخرين في نشاط أو مسعى) / زميل مشارك, شريك (شخص ذو عضوية تابعة في جمعية أو مؤسسة أو مؤسسة تجارية)\nمثال: أولاً كان البرق ثم قرينه الراعد",
 "歯に衣を着せない": "جَرِيء, صَدَّاح (يُعبّر عن رأيه بحرّيّة وإصرار) / صَرِيح, فَصِيح (يَتَّسِم بِالمُبَاشَرَة فِي الأُسْلُوب أَوِ الكَلَام؛ بِدُون مُوَارَبَة أَوْ تَهَرُّب)",
 "歯に衣を着せぬ": "جَرِيء, صَدَّاح (يُعبّر عن رأيه بحرّيّة وإصرار) / صَرِيح, فَصِيح (يَتَّسِم بِالمُبَاشَرَة فِي الأُسْلُوب أَوِ الكَلَام؛ بِدُون مُوَارَبَة أَوْ تَهَرُّب)",
 "歯に衣着せない": "جَرِيء, صَدَّاح (يُعبّر عن رأيه بحرّيّة وإصرار) / صَرِيح, فَصِيح (يَتَّسِم بِالمُبَاشَرَة فِي الأُسْلُوب أَوِ الكَلَام؛ بِدُون مُوَارَبَة أَوْ تَهَرُّب)",
 "歯に衣着せぬ": "جَرِيء, صَدَّاح (يُعبّر عن رأيه بحرّيّة وإصرار) / صَرِيح, فَصِيح (يَتَّسِم بِالمُبَاشَرَة فِي الأُسْلُوب أَوِ الكَلَام؛ بِدُون مُوَارَبَة أَوْ تَهَرُّب)",
 "歯の妖精": "جِنِّيّ أَسْنَان (جَنِيَ يَجْنَى جَنًى: خرج ظهرُه ودخلَ صدرُه؛ فهو أَجْنى)",
 "歯の根": "نَاب (مَثَّل مكان أحد ما، كان نَائِبا عنه)\nمثال: كم يكلف ناب الفيل؟",
 "歯をみがく": "نَظَّفَ الْأَسْنَان\nمثال: タロー君、歯を磨いていらっしゃい。 — يا تارو روح وفرش أسنانك.",
 "歯を磨く": "نَظَّفَ الْأَسْنَان\nمثال: タロー君、歯を磨いていらっしゃい。 — يا تارو روح وفرش أسنانك.",
 "歯を立てる": "عَضَّ, قَضَمَ / عَضَّ / قَرْصة / لُقْمة",
 "歯ブラシ": "فُرْشَاة أَسْنَان\nمثال: この歯ブラシを使っているのは母ではない。 — الشخص الذي يستخدم فرشاة الأسنان هذه ليس أمي.",
 "歯並": "أسنان, نظام الأسنان (نوع وعدد وترتيب الأسنان (مجتمعة) في شخص أو حيوان) / بزوغ الأسنان, تسنين (بزوغ أسنان الطفل عبر اللثة)",
 "歯並び": "أسنان, نظام الأسنان (نوع وعدد وترتيب الأسنان (مجتمعة) في شخص أو حيوان) / بزوغ الأسنان, تسنين (بزوغ أسنان الطفل عبر اللثة)",
 "歯並み": "أسنان, نظام الأسنان (نوع وعدد وترتيب الأسنان (مجتمعة) في شخص أو حيوان) / بزوغ الأسنان, تسنين (بزوغ أسنان الطفل عبر اللثة)",
 "歯元": "جَذْر, جدر (جِذْرُ ٱلشَّيْءِ هُوَ: أَصْلُهُ؛ في : جذر العدد النوني هو عدد ما إذا رفعناه لقوة ما أعطانا العدد الأصلي) / جَذْر (جِذْرُ ٱلشَّيْءِ هُوَ: أَصْلُهُ؛ في : جذر العدد النوني هو عدد ما إذا رفعناه لقوة ما أعطانا العدد الأصلي) / أَصْل (جعله أصيلًا أو ثابت الجذور؛ أي عَمَّق وأحكم أصوله؛ نسب شيئًا إلى أصله أو وضّح جذوره)\nمثال: أحسب جذر خمسة بالآلة الحاسبة.",
 "歯内治療学": "علاج جذور الأسنان (فرع طب الأسنان الذي يتعامل مع أمراض لب الأسنان)",
 "歯内療法学": "علاج جذور الأسنان (فرع طب الأسنان الذي يتعامل مع أمراض لب الأسنان)",
 "歯内療法専門医": "أخصائي لب الأسنان (طبيب أسنان متخصص في أمراض لب الأسنان والعصب)",
 "歯切れいい": "حَادّ, مُقْتَضَب (قَصِيرٌ وَمُبَاشِرٌ؛ مُخْتَصَرٌ بِفَاعِلِيَّةٍ) / حَادّ, قَاطِع ((عَمَّا يُرَى أَوْ يُسْمَع) مُحَدَّد بِوُضُوح) / شَدِيدُ التَّجْعِيد, مُكَرَّش ((عَنِ الشَّعْرِ) ذُو تَجْعِيدَاتٍ صَغِيرَةٍ وَمُحْكَمَةٍ) / مُقَرْمَش, هَشّ (صَلْب وَطَازَج بِشَكْل مُسْتَحَبّ)",
 "歯切れがいい": "حَادّ, مُقْتَضَب (قَصِيرٌ وَمُبَاشِرٌ؛ مُخْتَصَرٌ بِفَاعِلِيَّةٍ) / حَادّ, قَاطِع ((عَمَّا يُرَى أَوْ يُسْمَع) مُحَدَّد بِوُضُوح) / شَدِيدُ التَّجْعِيد, مُكَرَّش ((عَنِ الشَّعْرِ) ذُو تَجْعِيدَاتٍ صَغِيرَةٍ وَمُحْكَمَةٍ) / مُقَرْمَش, هَشّ (صَلْب وَطَازَج بِشَكْل مُسْتَحَبّ)",
 "歯切れがよい": "حَادّ, مُقْتَضَب (قَصِيرٌ وَمُبَاشِرٌ؛ مُخْتَصَرٌ بِفَاعِلِيَّةٍ) / حَادّ, قَاطِع ((عَمَّا يُرَى أَوْ يُسْمَع) مُحَدَّد بِوُضُوح) / شَدِيدُ التَّجْعِيد, مُكَرَّش ((عَنِ الشَّعْرِ) ذُو تَجْعِيدَاتٍ صَغِيرَةٍ وَمُحْكَمَةٍ) / مُقَرْمَش, هَشّ (صَلْب وَطَازَج بِشَكْل مُسْتَحَبّ)",
 "歯切れが悪い": "أَعْجَم, عَاجِز عَن التَّعْبِير (بدون أو محروم من استخدام الكلام أو الكلمات)\nمثال: بهائم عجماء",
 "歯切れが良い": "حَادّ, مُقْتَضَب (قَصِيرٌ وَمُبَاشِرٌ؛ مُخْتَصَرٌ بِفَاعِلِيَّةٍ) / حَادّ, قَاطِع ((عَمَّا يُرَى أَوْ يُسْمَع) مُحَدَّد بِوُضُوح) / شَدِيدُ التَّجْعِيد, مُكَرَّش ((عَنِ الشَّعْرِ) ذُو تَجْعِيدَاتٍ صَغِيرَةٍ وَمُحْكَمَةٍ) / مُقَرْمَش, هَشّ (صَلْب وَطَازَج بِشَكْل مُسْتَحَبّ)",
 "歯切れのいい": "حَادّ, مُقْتَضَب (قَصِيرٌ وَمُبَاشِرٌ؛ مُخْتَصَرٌ بِفَاعِلِيَّةٍ) / حَادّ, قَاطِع ((عَمَّا يُرَى أَوْ يُسْمَع) مُحَدَّد بِوُضُوح) / شَدِيدُ التَّجْعِيد, مُكَرَّش ((عَنِ الشَّعْرِ) ذُو تَجْعِيدَاتٍ صَغِيرَةٍ وَمُحْكَمَةٍ) / مُقَرْمَش, هَشّ (صَلْب وَطَازَج بِشَكْل مُسْتَحَبّ)",
 "歯切れのよい": "حَادّ, مُقْتَضَب (قَصِيرٌ وَمُبَاشِرٌ؛ مُخْتَصَرٌ بِفَاعِلِيَّةٍ) / حَادّ, قَاطِع ((عَمَّا يُرَى أَوْ يُسْمَع) مُحَدَّد بِوُضُوح) / شَدِيدُ التَّجْعِيد, مُكَرَّش ((عَنِ الشَّعْرِ) ذُو تَجْعِيدَاتٍ صَغِيرَةٍ وَمُحْكَمَةٍ) / مُقَرْمَش, هَشّ (صَلْب وَطَازَج بِشَكْل مُسْتَحَبّ)",
 "歯切れの悪い": "أَعْجَم, عَاجِز عَن التَّعْبِير (بدون أو محروم من استخدام الكلام أو الكلمات)\nمثال: بهائم عجماء",
 "歯切れの良い": "حَادّ, مُقْتَضَب (قَصِيرٌ وَمُبَاشِرٌ؛ مُخْتَصَرٌ بِفَاعِلِيَّةٍ) / حَادّ, قَاطِع ((عَمَّا يُرَى أَوْ يُسْمَع) مُحَدَّد بِوُضُوح) / شَدِيدُ التَّجْعِيد, مُكَرَّش ((عَنِ الشَّعْرِ) ذُو تَجْعِيدَاتٍ صَغِيرَةٍ وَمُحْكَمَةٍ) / مُقَرْمَش, هَشّ (صَلْب وَطَازَج بِشَكْل مُسْتَحَبّ)",
 "歯切れよい": "حَادّ, مُقْتَضَب (قَصِيرٌ وَمُبَاشِرٌ؛ مُخْتَصَرٌ بِفَاعِلِيَّةٍ) / حَادّ, قَاطِع ((عَمَّا يُرَى أَوْ يُسْمَع) مُحَدَّد بِوُضُوح) / شَدِيدُ التَّجْعِيد, مُكَرَّش ((عَنِ الشَّعْرِ) ذُو تَجْعِيدَاتٍ صَغِيرَةٍ وَمُحْكَمَةٍ) / مُقَرْمَش, هَشّ (صَلْب وَطَازَج بِشَكْل مُسْتَحَبّ)",
 "歯切れ良い": "حَادّ, مُقْتَضَب (قَصِيرٌ وَمُبَاشِرٌ؛ مُخْتَصَرٌ بِفَاعِلِيَّةٍ) / حَادّ, قَاطِع ((عَمَّا يُرَى أَوْ يُسْمَع) مُحَدَّد بِوُضُوح) / شَدِيدُ التَّجْعِيد, مُكَرَّش ((عَنِ الشَّعْرِ) ذُو تَجْعِيدَاتٍ صَغِيرَةٍ وَمُحْكَمَةٍ) / مُقَرْمَش, هَشّ (صَلْب وَطَازَج بِشَكْل مُسْتَحَبّ)",
 "歯列矯正": "تقويم الأسنان (فرع طب الأسنان الذي يتعامل مع الوقاية من أو تصحيح عدم انتظام الأسنان)",
 "歯列矯正器": "مُقَوَّم أَسْنَان",
 "歯医者": "طَبِيب أَسْنَان, طَبِيبَة أَسْنَان (العالم بالطب)\nمثال: سوف تصبح طبيبة.",
 "歯向う": "شَغَّلَ ((شَغَلَ) الدارَ يَشْغَلَ شَغْلًا: سكنها؛ شَغَلَ فلانًا عن الشيء: لَهَّاهُ وصرَفَه) / اِنْقَلَبَ عَلَى\nمثال: شغل بيل التلفاز.",
 "歯向かう": "شَغَّلَ ((شَغَلَ) الدارَ يَشْغَلَ شَغْلًا: سكنها؛ شَغَلَ فلانًا عن الشيء: لَهَّاهُ وصرَفَه) / اِنْقَلَبَ عَلَى\nمثال: شغل بيل التلفاز.",
 "歯周": "لثوي, متعلق بدواعم الأسنان (متعلق بعلاج دواعم الأسنان (اللثة والعظام))\nمثال: مرض دواعم الأسنان",
 "歯周治療学": "طب دواعم الأسنان, علاج اللثة (فرع طب الأسنان الذي يتعامل مع أمراض اللثة والهياكل الأخرى حول الأسنان)",
 "歯周炎": "التهاب اللثة, مرض دواعم السن (مرض يهاجم اللثة والعظام حول الأسنان)",
 "歯周病": "التهاب اللثة, مرض دواعم السن (مرض يهاجم اللثة والعظام حول الأسنان)",
 "歯噛み": "صرير الأسنان",
 "歯固": "عضاضة, لهاية (أداة تستخدم ليمصها الرضيع أو يعض عليها لتهدئته)",
 "歯固め": "عضاضة, لهاية (أداة تستخدم ليمصها الرضيع أو يعض عليها لتهدئته)",
 "歯垢": "لوحة تذكارية نحاسية, لوحة معدنية (نصب تذكاري مصنوع من النحاس الأصفر) / لويحة ((علم الأمراض) رقعة غير طبيعية صغيرة على أو داخل الجسم)",
 "歯塩": "قَلَح, قَلْح",
 "歯学": "طب الأسنان (فرع الطب المعني بتشريح وتطور وأمراض الأسنان)",
 "歯学部": "كلية طب الأسنان (كلية دراسات عليا تقدم دراسة تؤدي إلى درجات علمية في طب الأسنان)",
 "歯屎": "لوحة تذكارية نحاسية, لوحة معدنية (نصب تذكاري مصنوع من النحاس الأصفر) / لويحة ((علم الأمراض) رقعة غير طبيعية صغيرة على أو داخل الجسم)",
 "歯応え": "ثَبَات / تَحَدٍّ, التَّحَدِّي",
 "歯抜け": "خلو الفم من الأسنان, درد (حالة أو وضعية عدم وجود أسنان)\nمثال: بشكل غير متوقع، استحضر صورة طبيب الأسنان المسؤول عن خلو فمه من الأسنان",
 "歯擦音": "صَفِيرِيّ / حَرْفُ صَفِير (طَرَف وَجَانِب وَحَدّ؛ رَمْز مخطوط أو مطبوع يقوم مقام صوت أو كلمة أو عبارة أو معنى)\nمثال: ألف هو الحرف الأول للألف باء.",
 "歯朶": "سَرْخَس",
 "歯根膜炎": "التهاب اللثة, مرض دواعم السن (مرض يهاجم اللثة والعظام حول الأسنان)",
 "歯槽": "حويصلة هوائية",
 "歯槽炎": "التهاب الأسناخ (التهاب الأسناخ في الرئتين الناتج عن استنشاق الغبار؛ مع التعرض المتكرر قد تصبح الحالة مزمنة) / التهاب السنخ الجاف (التهاب في سنخ السن؛ يحدث أحياناً بعد قلع السن وفشل تكون جلطة دموية)",
 "歯槽膿漏": "التهاب اللثة, مرض دواعم السن (مرض يهاجم اللثة والعظام حول الأسنان)",
 "歯止め": "فَرَمَلَة / مِكْبَح / فَرْمَلَ, َكَبَح / جَنَاحِيَّة / دَقَّ (الشيءَ: ضربه وأصدر صوتًا عند الدق؛ البابَ: طرقه)\nمثال: واصل زيري دق الجرس.",
 "歯止めがかからない": "جامح, لا يمكن إيقافه (غير قابل للإيقاف)\nمثال: لا يمكن إيقافه كالرياح",
 "歯止めをかける": "ضبط, كبح (فعل تقييد القوة أو العمل أو الحد من التجاوز) / حافة الرصيف (حافة بين الرصيف والطريق تتكون من خط من أحجار الرصيف (عادة ما تشكل جزءاً من المزراب)) / شكيمة كبح, لجام بالسلسلة (شكيمة حصان بسلسلة أو حزام ملحق لكبح الحصان)\nمثال: حسه السليم هو لجام لمزاجه السريع",
 "歯止めを掛ける": "ضبط, كبح (فعل تقييد القوة أو العمل أو الحد من التجاوز) / حافة الرصيف (حافة بين الرصيف والطريق تتكون من خط من أحجار الرصيف (عادة ما تشكل جزءاً من المزراب)) / شكيمة كبح, لجام بالسلسلة (شكيمة حصان بسلسلة أو حزام ملحق لكبح الحصان)\nمثال: حسه السليم هو لجام لمزاجه السريع",
 "歯滓": "لوحة تذكارية نحاسية, لوحة معدنية (نصب تذكاري مصنوع من النحاس الأصفر) / لويحة ((علم الأمراض) رقعة غير طبيعية صغيرة على أو داخل الجسم)",
 "歯牙": "أسنان, نظام الأسنان (نوع وعدد وترتيب الأسنان (مجتمعة) في شخص أو حيوان)",
 "歯牙矯正術": "تقويم الأسنان (فرع طب الأسنان الذي يتعامل مع الوقاية من أو تصحيح عدم انتظام الأسنان)",
 "歯痒い": "ضجر, عجول (قلق أو سريع الغضب تحت التأخير أو المعارضة)\nمثال: نافذ الصبر مع الطلاب الأبطاء",
 "歯痛": "أَلَمُ أَسْنَان, أَلَمُ الْأَسْنَان (الوَجَع)\nمثال: ألم أقل لك ذلك؟",
 "歯石": "جِيرُ الأَسْنَان, قَلَح (طبقة قشرية تتكون على الأسنان واللثة) / تتار (عضو في الشعب المنغولي في آسيا الوسطى الذي غزا روسيا في القرن الثالث عشر) / امرأة شرسة, صارمة (امرأة يقظة بشراسة وبغيضة) / طرطرات البوتاسيوم الهيدروجينية, كريم التارتار (ملح يستخدم بشكل خاص في مسحوق الخبز (البيكنج بودر))",
 "歯磨き": "معجون أسنان, منظف أسنان (مادة لتنظيف الأسنان؛ توضع بفرشاة الأسنان)",
 "歯磨き剤": "معجون أسنان, منظف أسنان (مادة لتنظيف الأسنان؛ توضع بفرشاة الأسنان)",
 "歯磨き楊子": "فُرْشَاة أَسْنَان",
 "歯磨き楊枝": "فُرْشَاة أَسْنَان",
 "歯磨き粉": "مسحوق الأسنان (مستحضر لتنظيف الأسنان في شكل مسحوق)\nمثال: 歯磨き粉はどこにありますか？ — أين معجون الأسنان؟",
 "歯磨剤": "معجون أسنان, منظف أسنان (مادة لتنظيف الأسنان؛ توضع بفرشاة الأسنان)",
 "歯科": "طب الأسنان (فرع الطب المعني بتشريح وتطور وأمراض الأسنان)",
 "歯科インプラント": "زرعة سنية (زرعة تحل محل سن طبيعي)",
 "歯科医": "طَبِيب أَسْنَان, طَبِيبَة أَسْنَان (العالم بالطب)\nمثال: سوف تصبح طبيبة.",
 "歯科医学": "طب الأسنان (فرع الطب المعني بتشريح وتطور وأمراض الأسنان)",
 "歯科医師": "طَبِيب أَسْنَان, طَبِيبَة أَسْنَان (العالم بالطب)\nمثال: سوف تصبح طبيبة.",
 "歯科医術": "طب الأسنان (فرع الطب المعني بتشريح وتطور وأمراض الأسنان)",
 "歯科医院": "جراحة الأسنان (فرع طب الأسنان الذي يشمل الإجراءات الجراحية)",
 "歯科学": "طب الأسنان (فرع الطب المعني بتشريح وتطور وأمراض الأسنان)",
 "歯科技工士": "فني أسنان (شخص يصنع أجهزة طب الأسنان (الجسور وأطقم الأسنان))",
 "歯科矯正学": "تقويم الأسنان (فرع طب الأسنان الذي يتعامل مع الوقاية من أو تصحيح عدم انتظام الأسنان)",
 "歯科衛生士": "أخصائي صحة الأسنان (شخص مدرب لتقديم خدمات طب الأسنان الوقائية (تنظيف الأسنان أو أخذ صور الأشعة السينية))",
 "歯糞": "لوحة تذكارية نحاسية, لوحة معدنية (نصب تذكاري مصنوع من النحاس الأصفر) / لويحة ((علم الأمراض) رقعة غير طبيعية صغيرة على أو داخل الجسم)",
 "歯肉": "لِثَة, لَثَة / صَمْغ / عِلْكَة",
 "歯肉炎": "التهاب اللثة (التهاب اللثة)",
 "歯脱け": "خلو الفم من الأسنان, درد (حالة أو وضعية عدم وجود أسنان)\nمثال: بشكل غير متوقع، استحضر صورة طبيب الأسنان المسؤول عن خلو فمه من الأسنان",
 "歯膜炎": "التهاب اللثة, مرض دواعم السن (مرض يهاجم اللثة والعظام حول الأسنان)",
 "歯茎": "لِثَة, لَثَة / صَمْغ / عِلْكَة",
 "歯茎音": "صامت سني, صامت لثوي (صامت يُنطق بطرف اللسان بالقرب من حافة اللثة)",
 "歯質": "عاج (عظم (نسيج متكلس) يحيط بتجويف لب السن) / دنتين, عاج الأسنان (مادة كلسية أصلب وأكثر كثافة من العظم تشكل الجزء الأكبر من السن)",
 "歯車": "ترس, عجلة مسننة (عجلة مسننة تتعشق مع آلية مسننة أخرى لتغيير سرعة أو اتجاه الحركة المنقولة) / تجهيزات, عُدَّة (معدات تتكون من مواد متنوعة لازمة لعملية معينة أو رياضة وما إلى ذلك) / آلية تروس, ترس (آلية لنقل الحركة لغرض محدد (مثل ترس التوجيه في السيارة)) / مجموعة تروس, نظام نقل الحركة (آلية عجلات تتكون من مجموعة متصلة من التروس الدوارة التي يتم من خلالها نقل القوة أو تغيير الحركة أو عزم الدوران)\nمثال: علق ربطة عنق الأحمق في مجموعة التروس / سن الترس (سن على حافة عجلة مسننة) / ترس في آلة (مرؤوس يؤدي وظيفة مهمة ولكنها روتينية)\nمثال: كان ترساً صغيراً في آلة كبيرة",
 "歯車がかみ合う": "شَبَكَة",
 "歯車が噛み合う": "شَبَكَة",
 "歯軋り": "صرير الأسنان",
 "歯音": "سِنِّيّ ((سَنِيَ) يَسْنَى سَنًا، وسَناءً: ارتفع؛ (سَنِيَ): صار ذا سَناء ورِفْعةٍ وقَدْرٍ)\nمثال: وقعت سني الأمامية.",
 "歯骨": "سِنّ, سن ((سَنَّ) السِّكِّينَ و نحْوَهُ يَسُنُّ سَنًّا: أَحَدَّهُ؛ فهو مسنون وسَنِين)\nمثال: هم في نفس السن.",
 "歯髄": "لب (الجزء الداخلي الرخو للسن) / مجلة إثارة, مجلة رخيصة (مجلة غير مكلفة مطبوعة على ورق رديء الجودة) / عَصِيدَة, لُبّ (أي كتلة ناعمة أو رطبة) / لب, لحم الفاكهة (جزء طري رطب من الفاكهة)\nمثال: سحقه حتى أصبح لباً",
 "歯髄腔": "تجويف اللب (التجويف المركزي للسن الذي يحتوي على اللب (بما في ذلك قناة الجذر))",
 "歯鯨": "حوت مسنن (أي من عدة حيتان لها أسنان مخروطية بسيطة وتتغذى على الأسماك وما إلى ذلك)",
 "歯齦": "لِثَة, لَثَة / صَمْغ / عِلْكَة",
 "歯齦炎": "التهاب اللثة (التهاب اللثة)",
 "歳": "صَفّ (سَطْر مستقيم؛ مستوى تعليمي)\nمثال: صف كليتي وقلبي‎. / عُمْر ((في الإسلام) أبو حفص عمر بن الخطاب العدوي القرشي، ثاني الخلفاء الراشدين في المذهب السني) / سِنّ ((سَنَّ) السِّكِّينَ و نحْوَهُ يَسُنُّ سَنًّا: أَحَدَّهُ؛ فهو مسنون وسَنِين)\nمثال: جون في عمر أخي. / شَيْخُوخَة, عُجُوز",
 "歳々": "سَنَوِيّ",
 "歳々年々": "سنوياً, كل سنة (دون تفويت سنة) / سَنَوِيًّا (في السنة؛ كل سنة (عادة مع الإشارة إلى مبلغ من المال يدفع أو يُستلم))\nمثال: يسافرون إلى الصين سنوياً",
 "歳とった": "قَدِيم (شيء مر عليه زمن طويل) / قديم (شيء مر عليه زمن طويل) / كَبِير اَلسِّنّ (ضد الصغير؛ العظيم الحَجْم؛ ضد الصغير؛ المتقدم في السِنّ) / مُسِنّ\nمثال: هذه خدعة قديمة.",
 "歳とる": "عُمْر ((في الإسلام) أبو حفص عمر بن الخطاب العدوي القرشي، ثاني الخلفاء الراشدين في المذهب السني) / سِنّ ((سَنَّ) السِّكِّينَ و نحْوَهُ يَسُنُّ سَنًّا: أَحَدَّهُ؛ فهو مسنون وسَنِين)\nمثال: جون في عمر أخي.",
 "歳のいった": "قَدِيم, مُخَضْرَم (ماهر من خلال خبرة طويلة) / طَاعِن فِي السِّنّ, مُسِنّ (متقدّم في العمر) / الأَبّ, الأَكْبَر (يُستخدم للأكبر سنًّا من شخصين يحملان الاسم ذاته؛ خاصة لتمييز الأب عن ابنه)",
 "歳の市": "فِي نِهَايَةِ العَام (يَجْرِي فِي خِتَامِ السَّنَةِ المَالِيَّةِ) / نهاية العام (نهاية السنة التقويمية)\nمثال: اضطر لتفريغ البضائع قبل نهاية العام",
 "歳の行った": "قَدِيم, مُخَضْرَم (ماهر من خلال خبرة طويلة) / طَاعِن فِي السِّنّ, مُسِنّ (متقدّم في العمر) / الأَبّ, الأَكْبَر (يُستخدم للأكبر سنًّا من شخصين يحملان الاسم ذاته؛ خاصة لتمييز الأب عن ابنه)",
 "歳をとる": "عُمْر ((في الإسلام) أبو حفص عمر بن الخطاب العدوي القرشي، ثاني الخلفاء الراشدين في المذهب السني) / سِنّ ((سَنَّ) السِّكِّينَ و نحْوَهُ يَسُنُّ سَنًّا: أَحَدَّهُ؛ فهو مسنون وسَنِين)\nمثال: جون في عمر أخي.",
 "歳を取る": "عُمْر ((في الإسلام) أبو حفص عمر بن الخطاب العدوي القرشي، ثاني الخلفاء الراشدين في المذهب السني) / سِنّ ((سَنَّ) السِّكِّينَ و نحْوَهُ يَسُنُّ سَنًّا: أَحَدَّهُ؛ فهو مسنون وسَنِين)\nمثال: جون في عمر أخي.",
 "歳を重ねる": "عُمْر ((في الإسلام) أبو حفص عمر بن الخطاب العدوي القرشي، ثاني الخلفاء الراشدين في المذهب السني) / سِنّ ((سَنَّ) السِّكِّينَ و نحْوَهُ يَسُنُّ سَنًّا: أَحَدَّهُ؛ فهو مسنون وسَنِين)\nمثال: جون في عمر أخي.",
 "歳代": "عَقْد (العَشْر من السَنَوَات؛ الاتِّفَاق والعَهْد بين طرفين)\nمثال: أمضى زيري العقد.",
 "歳取った": "قَدِيم (شيء مر عليه زمن طويل) / قديم (شيء مر عليه زمن طويل) / كَبِير اَلسِّنّ (ضد الصغير؛ العظيم الحَجْم؛ ضد الصغير؛ المتقدم في السِنّ) / مُسِنّ\nمثال: هذه خدعة قديمة.",
 "歳差": "مبادرة الاعتدالين (انزياح غربي بطيء للاعتدالين على طول مستوى مسار الشمس ناتج عن مبادرة محور دوران الأرض)",
 "歳差運動": "مبادرة الاعتدالين (انزياح غربي بطيء للاعتدالين على طول مستوى مسار الشمس ناتج عن مبادرة محور دوران الأرض) / أسبقية, تقدم (فعل التقدم في الوقت أو الترتيب أو الرتبة (كما في المراسم)) / ترنح, مبادرة (حركة جسم دوار (مثل البلبل) يترنح فيها بحيث يمسح محور الدوران مخروطاً)",
 "歳旦": "أول أيام السنة, يوم رأس السنة (اليوم الأول من السنة)",
 "歳星": "اَلْمُشْتَرِي (أحد كَوَاكِب المجموعة الشمسية السَّيَّارَة، وهو أكبرها) / يُوبِيتَر\nمثال: كوكب المشتري متكون من الغاز.",
 "歳暮": "فِي نِهَايَةِ العَام (يَجْرِي فِي خِتَامِ السَّنَةِ المَالِيَّةِ) / نهاية العام (نهاية السنة التقويمية)\nمثال: اضطر لتفريغ البضائع قبل نهاية العام",
 "歳月": "وَقْت (\"بَقِيَ وَقْتاً عِنْدَهُ \" : أَيْ مِقْدَاراً مِنَ الزَّمَنِ؛ \"جَاءَ فِي الوَقْتِ الْمُنَاسِبِ \" : فِي اللَّحْظَةِ الْمُنَاسِبَةِ) / مَرَّة, مرة (مؤنث مُرّ، صفة ما كان بها مرارة) / حِين, وَقْت ((حَيَّنَه): جعل لَهُ حينا؛ (حَيَّنَ) الله فلَانا: لم يوفقه للرشاد)\nمثال: حان وقت الذهاب.",
 "歳末商戦": "فِي نِهَايَةِ العَام (يَجْرِي فِي خِتَامِ السَّنَةِ المَالِيَّةِ) / نهاية العام (نهاية السنة التقويمية)\nمثال: اضطر لتفريغ البضائع قبل نهاية العام",
 "歳次": "صَفّ (سَطْر مستقيم؛ مستوى تعليمي)\nمثال: صف كليتي وقلبي‎.",
 "歳歳": "سَنَوِيّ",
 "歳歳年年": "سنوياً, كل سنة (دون تفويت سنة) / سَنَوِيًّا (في السنة؛ كل سنة (عادة مع الإشارة إلى مبلغ من المال يدفع أو يُستلم))\nمثال: يسافرون إلى الصين سنوياً",
 "歴": "خِبْرَة, تَجْرِبَة (مصدر للفعل خَبَرَ؛ القاعُ يُنبت السِّدْر والأراك) / اِخْتِبَار (اختبر الشّيء:خبره) / خِبْرَة (مصدر للفعل خَبَرَ؛ القاعُ يُنبت السِّدْر والأراك)\nمثال: زيري عنده خبرة. / مَرَّرَ, مَرَّ / اِحْتَازَ (بنفس معنى حَازَ، إلا أن احتاز تميل إلى أن الفاعل أراد الحوز) / اِنْقَضَى, مَرَّ / أَهمَلَ / تَغَاضَى / تَخَلَّى / طَريق (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من ٱلشَّارِعِ، سَبِيل) / جَوَاز\nمثال: أسأل عن الطريق. / اِخْتَرَقَ, نَفَذَ / خِبْرَة, تَجْرِبَة (مصدر للفعل خَبَرَ؛ القاعُ يُنبت السِّدْر والأراك) / اِخْتِبَار (اختبر الشّيء:خبره) / خِبْرَة (مصدر للفعل خَبَرَ؛ القاعُ يُنبت السِّدْر والأراك)\nمثال: زيري عنده خبرة.",
 "歴々": "مَرْمُوق, بَارِز / شَفَّاف / وَاضِح",
 "歴とした": "مَقْبُول, مُعْتَرَف بِه (حائز على القبول العامّ أو يفرض الاعتراف)",
 "歴代史": "تَارِيخ (جملة الأَحوال والأحداث التي يمر بها كائن ما، ويَصْدق على الفرد والمجتمع، كما يَصْدق على الظواهر الطبيعية والإنسانية؛ هو تحديد الزمن باليَوْم والشَهْر والسَنَة أو ببعضهما. الأجَل أو الوَقْت)\nمثال: ما تاريخ اليوم؟",
 "歴伝": "تَقْلِيد",
 "歴史": "تَارِيخ, تاريخ (جملة الأَحوال والأحداث التي يمر بها كائن ما، ويَصْدق على الفرد والمجتمع، كما يَصْدق على الظواهر الطبيعية والإنسانية؛ هو تحديد الزمن باليَوْم والشَهْر والسَنَة أو ببعضهما. الأجَل أو الوَقْت) / تَارِيخ (جملة الأَحوال والأحداث التي يمر بها كائن ما، ويَصْدق على الفرد والمجتمع، كما يَصْدق على الظواهر الطبيعية والإنسانية؛ هو تحديد الزمن باليَوْم والشَهْر والسَنَة أو ببعضهما. الأجَل أو الوَقْت) / مَحْفُوظَات\nمثال: ما تاريخ اليوم؟",
 "歴史の一ページ": "تَارِيخِي",
 "歴史の１ページ": "تَارِيخِي",
 "歴史は繰り返す": "التَّارِيخ يُعِيدُ نَفْسِهِ",
 "歴史上": "تَارِيخِيّ (مهمّ في التاريخ؛ ذو أثر تاريخيّ) / تَارِيخِيّ (يَنْتَمِي لِلْمَاضِي؛ ذُو أَهَمِّيَّةٍ أَوْ شُهْرَةٍ تَارِيخِيَّة)",
 "歴史主義": "تاريخانية (نظرية تقول بأن الأحداث الاجتماعية والثقافية تحددها التاريخ)",
 "歴史以前": "مَا قَبْلَ التَّارِيخ (انظر مَا)\nمثال: هلا! ما الجديد؟",
 "歴史再審論者": "تحريفي (شيوعي يحاول إعادة كتابة الماركسية لتبرير التراجع عن الموقف الثوري)",
 "歴史地図": "أَطْلَس",
 "歴史学": "تَارِيخ, تاريخ (جملة الأَحوال والأحداث التي يمر بها كائن ما، ويَصْدق على الفرد والمجتمع، كما يَصْدق على الظواهر الطبيعية والإنسانية؛ هو تحديد الزمن باليَوْم والشَهْر والسَنَة أو ببعضهما. الأجَل أو الوَقْت) / تَارِيخ (جملة الأَحوال والأحداث التي يمر بها كائن ما، ويَصْدق على الفرد والمجتمع، كما يَصْدق على الظواهر الطبيعية والإنسانية؛ هو تحديد الزمن باليَوْم والشَهْر والسَنَة أو ببعضهما. الأجَل أو الوَقْت) / مَحْفُوظَات\nمثال: ما تاريخ اليوم؟",
 "歴史学派": "المدرسة التاريخية (مدرسة للاقتصاديين والفلاسفة القانونيين الألمان في القرن التاسع عشر حاولت شرح الأنظمة الاقتصادية الحديثة بمصطلحات تطورية أو تاريخية)",
 "歴史家": "مُؤَرِّخ, مُؤَرِّخَة",
 "歴史的": "تَارِيخِي / تَارِيخِيّ (مهمّ في التاريخ؛ ذو أثر تاريخيّ) / تَارِيخِيّ (يَنْتَمِي لِلْمَاضِي؛ ذُو أَهَمِّيَّةٍ أَوْ شُهْرَةٍ تَارِيخِيَّة)",
 "歴史的現在": "المضارع التاريخي (استخدام صيغة المضارع لوصف أحداث أو حالات في الماضي)",
 "歴史言語学": "لُغَوِيَات تَارِيخِيَّة",
 "歴史資料": "سجل تاريخي, وثيقة تاريخية (كتابة لها قيمة تاريخية (على عكس الخيال أو الأسطورة وما إلى ذلك))",
 "歴年": "سنة تقويمية, سنة ميلادية (السنة (التي تحسب من 1 يناير إلى 31 ديسمبر) وفقاً للتقويم الغريغوري)",
 "歴年齢": "عمر زمني (العمر مقاساً بالوقت (السنوات والشهور) الذي وجد فيه شيء أو شخص ما)\nمثال: كان عمره الزمني 71 عاماً",
 "歴戦": "مُحَارِب قَدِيم",
 "歴歴": "مَرْمُوق, بَارِز / شَفَّاف / وَاضِح",
 "歴然": "بَيِّن, مَلْحُوظ (يمكن رؤيته أو ملاحظته) / بَيِّن, جَلِيّ (مكشوف بوضوح للعقل أو الحواسّ أو الحكم)",
 "歴遊": "رِحْلَة / جَوْلَة",
 "歴青": "أَسْفَلْت, زِفْت",
 "歴青ウラン鉱": "بتشبيند, يورانينيت (معدن يتكون من أكسيد اليورانيوم وآثار من الراديوم والثوريوم والبولونيوم والرصاص والهيليوم؛ يسمى اليورانينيت في شكله الكتلي بتشبيند وهو خام اليورانيوم…)",
 "歴青炭": "فحم بتوميني, فحم قاري (فحم غني بالهيدروكربونات القطرانية؛ يحترق بسهولة بلهب أصفر مدخن)",
 "死": "مَوْت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي) / وَفَاة / هَلَاك / مَنِيَّة / حِمَام (قضاء الموت وقدره؛ جمع حُمَّة وهو قدر الفراق) / موت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي)\nمثال: لا اخاف الموت . / خَارِج / إِعْدَام, عُقُوبَة الْإِعْدَام (في القانون: هي عقوبة يحددها القضاء على جريمة كبرى اقترفها المتهم وتؤدي إلى قتل المتهم غالبا بالشنق)\nمثال: محكم عليه بالإعدام.",
 "死す": "مَاتَ (للحَيّ: فقد الحَيَاة. مصدره مَوتَا ومِيتَة؛ للأرض: ليس فيها شيء حَيّ من النبات أو الحيوان أو الإنسان. مصدره مَوَات) / تُوُفِّيَ / زَهْر اَلطَّاوِلَة, زَهْر اَلنَّرْد ((زَهَرَ) الوجهُ والسراجُ والقمرُ يَزْهُرُ زَهْرًا، وزُهُوراً: تلألأ وأشْرق؛ (زَهَرَ) الشيءُ: صَفا لونُه)\nمثال: إعتقدت أنه مات.",
 "死すべき": "إنسان, شخص (كائن بشري؛ فرد من البشر) / فَتَّاك, مُمِيت (يُسَبِّب أَوْ قَادِر عَلَى التَّسَبُّب فِي المَوْت) / فانٍ, مائت (عرضة للموت)\nمثال: كان هناك الكثير ليفعله شخص واحد",
 "死する": "مَاتَ (للحَيّ: فقد الحَيَاة. مصدره مَوتَا ومِيتَة؛ للأرض: ليس فيها شيء حَيّ من النبات أو الحيوان أو الإنسان. مصدره مَوَات) / تُوُفِّيَ / زَهْر اَلطَّاوِلَة, زَهْر اَلنَّرْد ((زَهَرَ) الوجهُ والسراجُ والقمرُ يَزْهُرُ زَهْرًا، وزُهُوراً: تلألأ وأشْرق؛ (زَهَرَ) الشيءُ: صَفا لونُه)\nمثال: إعتقدت أنه مات.",
 "死せる": "مَيِّت",
 "死せる魂": "راحل, فقيد (شخص فارق الحياة ولم يعد حياً)\nمثال: أتساءل عما كان سيفعله الميت",
 "死なせる": "قَتَلَ, قتل (تعمّد جعله يَمُوتُ، أزهق روحه، أمَاتَه متعمدا؛ الوقتَ: ضيعه بشيء غير ذي فائدة وهو ينتظر أمرا آخر) / قَتْلَة\nمثال: قتل الصياد دبا.",
 "死に": "مُحْتَضَر, يَمُوت (في عملية الانتقال من الحياة أو التوقف عن الوجود) / اندثار, زوال (الوقت الذي ينتهي فيه شيء ما)\nمثال: رجل يحتضر / مَيِّت / بِشَكْل بَغِيض, بِشَكْل لَعِين (بطريقة بغيضة) / لَعِين, مَلْعُون ((غير رسمي) شتائم تُستخدَم للتوكيد والتأثير) / مَحْكُومٌ عَلَيْه, مَلْعُون (مُعرَّض لعذاب جهنم الأبدي) / ملعونون, هالكون (الناس المحكوم عليهم بالعقاب الأبدي)\nمثال: آرثر اللطيف - مثابر بشكل لعين، وبأدب، وبلا نهاية!",
 "死にいたらしめる": "قَتَلَ, قتل (تعمّد جعله يَمُوتُ، أزهق روحه، أمَاتَه متعمدا؛ الوقتَ: ضيعه بشيء غير ذي فائدة وهو ينتظر أمرا آخر) / قَتْلَة\nمثال: قتل الصياد دبا.",
 "死にそこなう": "نَجَا",
 "死に体": "الْبَطَّةُ الْعَرْجَاءُ",
 "死に損ない": "خرف (مسن في مرحلة الخرف؛ شخص أضعف العمر عقله)",
 "死に損なう": "نَجَا",
 "死に物狂い": "استماتة, يأس (تهور يائس) / قنوط, يأس (حالة فقدان كل أمل أو غيابه)\nمثال: كانت سياسة يائسة",
 "死に生き": "مَوْت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي) / وَفَاة / هَلَاك / مَنِيَّة / حِمَام (قضاء الموت وقدره؛ جمع حُمَّة وهو قدر الفراق) / موت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي)\nمثال: لا اخاف الموت .",
 "死に神": "مَوْت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي) / وَفَاة / هَلَاك / مَنِيَّة / حِمَام (قضاء الموت وقدره؛ جمع حُمَّة وهو قدر الفراق) / موت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي)\nمثال: لا اخاف الموت .",
 "死に絶える": "اِنْقَرَضَ",
 "死に至らしめる": "قَتَلَ, قتل (تعمّد جعله يَمُوتُ، أزهق روحه، أمَاتَه متعمدا؛ الوقتَ: ضيعه بشيء غير ذي فائدة وهو ينتظر أمرا آخر) / قَتْلَة\nمثال: قتل الصياد دبا.",
 "死に身": "جَسَد مَيِّت, جُثَّة (جسم طبيعي يتكون من حيوان أو إنسان ميت)\nمثال: وجدوا الجثة في البحيرة",
 "死に馬": "طعم الغربان (حصان هزيل من المحتمل أن يصبح جيفة قريباً وبالتالي يجذب الغربان)",
 "死ぬ": "مَاتَ (للحَيّ: فقد الحَيَاة. مصدره مَوتَا ومِيتَة؛ للأرض: ليس فيها شيء حَيّ من النبات أو الحيوان أو الإنسان. مصدره مَوَات) / تُوُفِّيَ / زَهْر اَلطَّاوِلَة, زَهْر اَلنَّرْد ((زَهَرَ) الوجهُ والسراجُ والقمرُ يَزْهُرُ زَهْرًا، وزُهُوراً: تلألأ وأشْرق؛ (زَهَرَ) الشيءُ: صَفا لونُه)\nمثال: إعتقدت أنه مات. / زَالَ (زَالَ يَزُولُ زَوَالاً، وزَوَلاَنًا: تحوَّلَ وانتقل؛ يقال: زَالَ من مكانه وعنه)\nمثال: توم لا زال يبكي",
 "死ぬほど": "مَوْت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي) / وَفَاة / هَلَاك / مَنِيَّة / حِمَام (قضاء الموت وقدره؛ جمع حُمَّة وهو قدر الفراق) / موت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي)\nمثال: لا اخاف الموت .",
 "死ぬ気で": "بجنون, بشدة ((عامية) بسرعة أو جهد أو شدة كبيرة؛ للمبالغة) / في أحلامه, مستحيل (تستخدم بسخرية للإشارة إلى عكس ما قيل)\nمثال: قاد بجنون",
 "死ぬ程": "مَوْت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي) / وَفَاة / هَلَاك / مَنِيَّة / حِمَام (قضاء الموت وقدره؛ جمع حُمَّة وهو قدر الفراق) / موت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي)\nمثال: لا اخاف الموت .",
 "死ね": "اللعنة عليك",
 "死の床": "سرير الاحتضار, فراش الموت (السرير الذي يموت عليه الشخص) / فراش الموت (الساعات الأخيرة قبل الوفاة)",
 "死の組": "مَجْمُوعَة الْمَوْت (مؤنث مَجْمُوع وهو اسم مفعول من جَمَعَ؛ الطَائِفَة أو الجَمَاعَة من الناس)\nمثال: شكرا لإضافتي للمجموعة.",
 "死の舞踏": "رقصة الموت (رقصة من العصور الوسطى يقود فيها هيكل عظمي يمثل الموت موكباً من الآخرين إلى القبر)",
 "死を選ぶ": "اِنْتَحَرَ",
 "死んでも": "بِأَيِّ ثَمَنٍ",
 "死亡": "مَوْت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي) / وَفَاة / هَلَاك / مَنِيَّة / حِمَام (قضاء الموت وقدره؛ جمع حُمَّة وهو قدر الفراق) / موت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي)\nمثال: لا اخاف الموت .",
 "死亡事故": "إصابة مميتة, حادث مميت (حادث يتسبب في موت شخص ما)",
 "死亡保険": "تَأْمِين عَلَى اَلْحَيَاة",
 "死亡保険金": "تعويض الوفاة, مخصص الوفاة (أموال تأمين أو معاش تقاعدي تدفع لمستفيد من المتوفى)",
 "死亡保障": "تعويض الوفاة, مخصص الوفاة (أموال تأمين أو معاش تقاعدي تدفع لمستفيد من المتوفى)",
 "死亡広告": "نَعْي",
 "死亡率": "مُعَدَّل الوَفَيَات (نسبة الوفيات في منطقة ما إلى سكان تلك المنطقة؛ يُعبر عنها لكل 1000 في السنة)",
 "死亡給付金": "تعويض الوفاة, مخصص الوفاة (أموال تأمين أو معاش تقاعدي تدفع لمستفيد من المتوفى)",
 "死亡者": "مَيِّت مَيْت, مُتَوَفًّى / مَرْحُوم",
 "死人": "جُثَّة, جُثْمَان",
 "死体": "جَسَد مَيِّت, جُثَّة (جسم طبيعي يتكون من حيوان أو إنسان ميت)\nمثال: وجدوا الجثة في البحيرة",
 "死体ごっこ": "تبليط بالألواح الخشبية (عمل تغطية منطقة بألواح خشبية) / أرضية خشبية, تبليط خشبي ((بحرياً) غطاء أو أرضية مصنوعة من الألواح الخشبية (كما في السفينة)) / ألواح خشبية (الألواح الخشبية بشكل جماعي؛ كمية من الألواح)",
 "死体保管所": "مَشْرَحَة",
 "死体安置所": "مَشْرَحَة",
 "死体性愛": "اشتهاء الموتى, نيكروفيليا (انجذاب جنسي لا يقاوم نحو الجثث)",
 "死体検案": "تشريح الجثة, فحص ما بعد الوفاة (فحص وتشريح جثة ميت لتحديد سبب الوفاة أو التغيرات الناتجة عن المرض)",
 "死体検案書": "تشريح الجثة, فحص ما بعد الوفاة (فحص وتشريح جثة ميت لتحديد سبب الوفاة أو التغيرات الناتجة عن المرض) / تحليل لاحق, مراجعة ما بعد الحدث (مناقشة لحدث ما بعد وقوعه)",
 "死体置き場": "مَشْرَحَة",
 "死体解剖": "تَشْرِيح",
 "死傷者": "خسائر, خسارة (نقصان في الأفراد أو المعدات العسكرية) / إصابة مميتة, حادث مميت (حادث يتسبب في موت شخص ما) / ضَحِيَّة حادِث, مُصاب (شخص أصيب أو قتل في حادث) / إِصابَة, خَسارَة بَشَرِيَّة (شخص أصيب أو قتل أو أسر أو فقد في اشتباك عسكري)",
 "死出": "مَوْت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي) / وَفَاة / هَلَاك / مَنِيَّة / حِمَام (قضاء الموت وقدره؛ جمع حُمَّة وهو قدر الفراق) / موت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي)\nمثال: لا اخاف الموت .",
 "死出の旅": "مَوْت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي) / وَفَاة / هَلَاك / مَنِيَّة / حِمَام (قضاء الموت وقدره؛ جمع حُمَّة وهو قدر الفراق) / موت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي)\nمثال: لا اخاف الموت .",
 "死刑": "إِعْدَام, عُقُوبَة الْإِعْدَام (في القانون: هي عقوبة يحددها القضاء على جريمة كبرى اقترفها المتهم وتؤدي إلى قتل المتهم غالبا بالشنق)\nمثال: محكم عليه بالإعدام.",
 "死刑制度": "إِعْدَام, عُقُوبَة الْإِعْدَام (في القانون: هي عقوبة يحددها القضاء على جريمة كبرى اقترفها المتهم وتؤدي إلى قتل المتهم غالبا بالشنق)\nمثال: محكم عليه بالإعدام.",
 "死刑台": "سِقَالَة, إِسْقَالَة",
 "死刑執行": "تَنْفِيذ / إِعْدَام (في القانون: هي عقوبة يحددها القضاء على جريمة كبرى اقترفها المتهم وتؤدي إلى قتل المتهم غالبا بالشنق)\nمثال: محكم عليه بالإعدام.",
 "死刑執行人": "جَلَّاد",
 "死別": "حداد, فجيعة (حالة من الحزن على وفاة أو رحيل شخص محبوب)",
 "死去": "مَوْت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي) / وَفَاة / هَلَاك / مَنِيَّة / حِمَام (قضاء الموت وقدره؛ جمع حُمَّة وهو قدر الفراق) / موت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي)\nمثال: لا اخاف الموت .",
 "死命": "قِسْمَة, مَصِير (في : هو أن أحد العمليات الحسابية الرئيسية، ضد الضَرْب)\nمثال: الزواج قسمة و نصيب.",
 "死因": "سَبَب مَوْت, سَبَب وَفَاة ((سَبَّبَه): أَكثر سَبَّه؛ (سَبَّبَ) الأسبَاب: أوجدها)\nمثال: سامي كان السبب.",
 "死地": "مَوْت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي) / وَفَاة / هَلَاك / مَنِيَّة / حِمَام (قضاء الموت وقدره؛ جمع حُمَّة وهو قدر الفراق) / موت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي)\nمثال: لا اخاف الموت . / مُعْضِلَة / مِحْنَة",
 "死姦": "اشتهاء الموتى, نيكروفيليا (انجذاب جنسي لا يقاوم نحو الجثث)",
 "死屍": "جُثَّة, جُثْمَان",
 "死後硬直": "تخشب الموت, تيبس الموت (تصلب عضلي يبدأ بعد 2 إلى 4 ساعات من الوفاة ويستمر لمدة 4 أيام تقريباً) / تيبس موتي, صمل موتي (تصلب مؤقت للمفاصل وتيبس عضلي يحدث بعد الموت)",
 "死恐怖症": "رهاب الموت (خوف مرضي من الموت)",
 "死文": "بريد ميت, رسالة مهملة (بريد لا يمكن تسليمه ولا إعادته) / حبر على ورق, قانون مهمل (حالة شيء فقد أهميته أو فعاليته)",
 "死歿": "مَوْت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي) / وَفَاة / هَلَاك / مَنِيَّة / حِمَام (قضاء الموت وقدره؛ جمع حُمَّة وهو قدر الفراق) / موت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي)\nمثال: لا اخاف الموت .",
 "死毒": "تسمم بتوماين (مصطلح للتسمم الغذائي لم يعد مستخدماً علمياً)",
 "死没": "مَوْت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي) / وَفَاة / هَلَاك / مَنِيَّة / حِمَام (قضاء الموت وقدره؛ جمع حُمَّة وهو قدر الفراق) / موت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي)\nمثال: لا اخاف الموت .",
 "死没者": "راحل, فقيد (شخص فارق الحياة ولم يعد حياً)\nمثال: أتساءل عما كان سيفعله الميت",
 "死活問題": "حَيَاتِيّ, مَصِيرِيّ (بالغ الأهمية على نحو حيوي)",
 "死海": "الْبَحْر الْمَيِّت",
 "死滅": "اِنْقِرَاض",
 "死生": "مَوْت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي) / وَفَاة / هَلَاك / مَنِيَّة / حِمَام (قضاء الموت وقدره؛ جمع حُمَّة وهو قدر الفراق) / موت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي)\nمثال: لا اخاف الموت .",
 "死生不知": "أَهْوَج, مُتَهَوِّر (جريء بشكل متهور ومُفرِط) / طائش, متهور (شخص متهور مندفع غير مسؤول)",
 "死生学": "ثاناتولوجيا, علم الموت (فرع العلم الذي يدرس الموت (خاصة جوانبه الاجتماعية والنفسية))",
 "死産": "إجهاض تلقائي, إسقاط (فقدان طبيعي لنتاج الحمل)",
 "死界": "سِجِّين, عَالَم سُفْلِيّ / نُقْطَة عَمْيَاء (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه)\nمثال: هذه هي نقطة ضعفه.",
 "死神": "مَوْت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي) / وَفَاة / هَلَاك / مَنِيَّة / حِمَام (قضاء الموت وقدره؛ جمع حُمَّة وهو قدر الفراق) / موت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي)\nمثال: لا اخاف الموت .",
 "死絶": "نِهَايَة, غَايَة / غَايَة / اِنْتَهَى, أَنْهَى (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات)\nمثال: انتهى أمر زيري. / مُحْتَضَر, يَمُوت (في عملية الانتقال من الحياة أو التوقف عن الوجود) / اندثار, زوال (الوقت الذي ينتهي فيه شيء ما)\nمثال: رجل يحتضر",
 "死線": "أَجَل, مُهْلَة (مُدَّة الشيء، وَقْت أو مَوْعِد انتهاء الشيء أو حلوله)\nمثال: اقترب أجل زيري.",
 "死者": "راحل, فقيد (شخص فارق الحياة ولم يعد حياً)\nمثال: أتساءل عما كان سيفعله الميت",
 "死者の書": "كِتَاب الْمَوْتَى (موضع تعليم الكتابة. الاستخدام الأصلي؛ مدرسة شبه رسمية لتعليم الأطفال الكِتَابَة والقِرَاءَة ومباديء الحِسَاب وبعض القُرَآن…)\nمثال: هذا الكتاب جديد",
 "死者数": "حصيلة القتلى (عدد الوفيات الناتجة عن سبب معين مثل حادث أو معركة أو كارثة طبيعية)",
 "死肉": "جِيفة, فَطِيسَة",
 "死荷重": "ثقل ساكن, وزن ميت (وزن ثقيل لا يتحرك) / عبء ثقيل (عائق قمعي أو ثقيل)",
 "死蔵": "اِكْتِنَاز",
 "死角": "نُقْطَة عَمْيَاء (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه)\nمثال: هذه هي نقطة ضعفه.",
 "死語": "لُغَة بَائِدَة, لُغَة مَيِّتَة (هِيَ مجموعة من الأصوات التي يصدرها الإنسان على شكل كلمات منظمة بقواعد، ليتواصل به الناس وينقلون به الافكار والمعاني، اللسان؛ يقصد بها أحيانا اللهجة)\nمثال: الأمازيغية لغة.",
 "死軸": "محور خامل, محور ميت (محور يحمل عجلة ولكن بدون قوة لدفعها)",
 "死都": "مَدِينَة أَشْبَاح, مَدِينَة الْأَشْبَاح",
 "死霊": "شَبَح, خَيَال",
 "死霊術師": "مستحضر الأرواح (من يمارس العرافة باستحضار الموتى) / ساحر, عراف (من يمارس السحر أو الشعوذة)",
 "死面": "قناع الموت (غطاء يوضع على الوجه للحماية أو التنكر؛ طبق يوضع فيه الطعام. )\nمثال: نزع زيري القناع.",
 "死骸": "بَدَن, جِسْم ((بَدُنَ) الرَّجُلُ مِنْ بَابِ ظَرُفَ وَ (بُدْنًا) أَيْضًا بِوَزْنِ قُفْلٍ أَيْ سَمِنَ وَضَخُمَ فَهُوَ (بَادِنٌ))",
 "歿": "مَوْت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي) / وَفَاة / هَلَاك / مَنِيَّة / حِمَام (قضاء الموت وقدره؛ جمع حُمَّة وهو قدر الفراق) / موت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي)\nمثال: لا اخاف الموت .",
 "歿後": "بعد الوفاة (بعد الموت)\nمثال: نُشرت مقطوعات البيانو هذه بعد الوفاة",
 "殆": "إلى حد بعيد, تماماً (إلى أقصى حد؛ بالكامل) / إلى حد ما, تماماً (بدرجة ما (لا تستخدم مع النفي)) / حقاً, يا له من (من نوع ملحوظ أو استثنائي أو مميز بشكل غير عادي (لا تستخدم مع النفي)) / تماماً, حقاً (في الواقع أو بصدق أو إلى حد أقصى)\nمثال: أنت محق تماماً",
 "殆ど": "تَقْرِيبًا, عَلَى وَشْك / بالكاد, قبل قليل (قبل وقت قصير جداً فقط) / بالكاد, قلّما (تقريباً لا؛ بصعوبة بالغة) / بالكاد, بصعوبة (ببطء وبصعوبة)\nمثال: بالكاد كنا نعرفهم / أَكْثَر, أَغْلَب / جِدًّا (كلمة \"جدا\" لها معانٍ متعددة؛ يرتبط المعنى بالعطاء والكرم، سواء بالمنح أو طلبه)\nمثال: إنها غالية جدا!",
 "殆んど": "تَقْرِيبًا, عَلَى وَشْك / بالكاد, قبل قليل (قبل وقت قصير جداً فقط) / بالكاد, قلّما (تقريباً لا؛ بصعوبة بالغة) / بالكاد, بصعوبة (ببطء وبصعوبة)\nمثال: بالكاد كنا نعرفهم / أَكْثَر, أَغْلَب / جِدًّا (كلمة \"جدا\" لها معانٍ متعددة؛ يرتبط المعنى بالعطاء والكرم، سواء بالمنح أو طلبه)\nمثال: إنها غالية جدا!",
 "殉じる": "اِنْتَحَرَ",
 "殉ずる": "اِنْتَحَرَ",
 "殉教": "شَهَادَة",
 "殉教者": "شُهَدَاء, شَهِيد",
 "殉難": "شَهَادَة",
 "殉難者": "ضَحِيَّة / أُضْحِيَّة",
 "殊": "فَرْق, اِخْتِلَاف / فَرْق, فُرُوق / خِلاف, خِلافات / فَرْق / مَيَّزَ / غَيْر مَأْلُوف (لا يُصادف عادة) / استثنائي, غير عادي (غير معتاد أو غير شائع أو غير عادي) / شاذ, عجيب (خارج عن المألوف وغير متوقع بشكل قاطع؛ غريب قليلاً أو حتى شاذ)\nمثال: مشهد ذو جمال غير عادي",
 "殊な": "اِسْتِثْنَائِيّ",
 "殊に": "خُصُوصًا, خَاصَّةً / بالإضافة إلى ذلك, علاوة على ذلك (بالإضافة؛ علاوة على ذلك)\nمثال: يعمل بالإضافة إلى ذلك كمدير تنفيذي",
 "殊の外": "بشدة, جداً (لدرجة قصوى)\nمثال: بارد جداً / بالصدفة, عرضياً (بدون تخطيط مسبق) / بشكل غير متوقع, فجأة (بطريقة لم تكن متوقعة)\nمثال: التقيا بالصدفة",
 "殊勝": "جَدِير بِالْإِعْجَاب",
 "殊勲賞": "وسام الخدمة المتميزة (وسام عسكري أمريكي للخدمة الجديرة بالتقدير في واجبات الحرب ذات المسؤولية العظيمة)",
 "殊更": "عَمْدًا / خُصُوصًا, خَاصَّةً",
 "残": "بَقِيَّة",
 "残さず": "كُلّ, جَمِيع",
 "残す": "تَرَكَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض) / تَرَكَ, غَادَرَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض) / إِجَازَة, عُطْلَة\nمثال: لقد ترك لك هذا. / أَنْقَذَ, أَنْجَى / اِدَّخَرَ / حَفِظَ (الحِفْظُ نَقِيضُ النِّسْيَان، وهو التَّعَاهُدُ وقِلَّةُ الغَفْلَةِ؛ قِلَّةُ الغَفْلَةِ)\nمثال: حفظ رقم هاتفها. / مَكَثَ, بَقِيَ / إِقَامَة",
 "残った": "فَائِض, مُتَبَقٍّ (لم يُسْتَهْلَك بعد)",
 "残らず": "كُلّ, جَمِيع",
 "残り": "بَقِيَّة",
 "残りかす": "باقي, بقية (شيء متبقٍ بعد إزالة أجزاء أخرى) / بقية, ثمالة (المادة التي تتبقى بعد إزالة شيء ما)\nمثال: لم يكن هناك بقية",
 "残りカス": "باقي, بقية (شيء متبقٍ بعد إزالة أجزاء أخرى) / بقية, ثمالة (المادة التي تتبقى بعد إزالة شيء ما)\nمثال: لم يكن هناك بقية",
 "残り多い": "آسف, نادم (الشعور بـأو التعبير عن الأسف أو الحزن أو الشعور بالخسارة لشيء تم فعله أو تركه)\nمثال: شعر بالندم على شبابه الضائع",
 "残り惜しい": "مُؤْسِف, يُؤْسَفُ لَهُ (يَسْتَحِقُّ الأَسَفَ أَوِ النَّدَمَ)",
 "残り滓": "باقي, بقية (شيء متبقٍ بعد إزالة أجزاء أخرى) / بقية, ثمالة (المادة التي تتبقى بعد إزالة شيء ما)\nمثال: لم يكن هناك بقية",
 "残り火": "جَمْرَة",
 "残り物": "الْبَقَايَا",
 "残り物には福がある": "أخيراً وليس آخراً",
 "残り物に福あり": "أخيراً وليس آخراً",
 "残り物に福がある": "أخيراً وليس آخراً",
 "残り粕": "باقي, بقية (شيء متبقٍ بعد إزالة أجزاء أخرى) / بقية, ثمالة (المادة التي تتبقى بعد إزالة شيء ما)\nمثال: لم يكن هناك بقية",
 "残る": "بَاقِي (الباقي : اسم من أسماء الله تعالى ومعناه : المستأثر بالبقاء والدّوام ، وهو نتيجة كونه واجبَ الوجود لذاته ، فهو الأوّل بلا ابتداء ، والآخر بلا انتهاء؛ الباقي الثابتُ بعد غيره) / بَقِيَ, مَكَثَ (أَقَامَ أو ثَبَتَ في مكانه أو حاله زمنا قصيرا أو طويلا؛ فَضَلَ)\nمثال: الباقي ليس مهم.",
 "残んの": "فَائِض, مُتَبَقٍّ (لم يُسْتَهْلَك بعد)",
 "残余": "بَقِيَّة",
 "残余額": "رَصِيد",
 "残像": "أثر حسي, صورة تلوية (صورة (عادة ما تكون سلبية) تستمر بعد توقف التحفيز)",
 "残光": "أثر طيب, نشوة لاحقة (متعة تذكر حدث سار) / شفق, وهج لاحق (وهج يُرى أحياناً في السماء بعد غروب الشمس)\nمثال: استمتع بنشوة انتصاره",
 "残党": "بقايا قماش, فضلة قماش (قطعة قماش متبقية بعد استخدام الباقي أو بيعه) / بقايا (جزء صغير أو حصة تتبقى بعد زوال الجزء الرئيسي)",
 "残効": "أثر لاحق (أي نتيجة تتبع سببها بعد فترة زمنية) / أثر تال, أثر لاحق (تأثير متأخر لدواء أو علاج)\nمثال: كان للدواء آثار تالية غير متوقعة",
 "残務整理": "تَصْفِية",
 "残品整理": "بيع تصفية, تصفية (بيع لتقليل المخزون)",
 "残基": "باقي, بقية (شيء متبقٍ بعد إزالة أجزاء أخرى) / بقية, ثمالة (المادة التي تتبقى بعد إزالة شيء ما)\nمثال: لم يكن هناك بقية",
 "残存": "بقاء (شيء ينجو ويبقى) / انتقاء طبيعي, بقاء (عملية طبيعية تؤدي إلى تطور الكائنات الحية الأكثر تكيفاً مع البيئة) / بقاء, نجاة (حالة البقاء على قيد الحياة)",
 "残存種": "أثر متبق, بقايا جيولوجية (ميزة جيولوجية تمثل بقايا تكوين موجود مسبقاً بعد اختفاء أجزاء أخرى) / أثر باق, باقية (كائن أو نوع باقٍ كبقية من نباتات أو حيوانات منقرضة في بيئة تغيرت كثيراً عن تلك التي نشأ فيها)",
 "残存者": "ناجٍ (حيوان يبقى على قيد الحياة رغم الشدائد) / بَاقٍ عَلَى قَيْد الْحَيَاة, نَاجٍ (من يعيش أطول من غيره) / باقٍ عَلَى قَيْد الحَياة, ناجٍ (الشخص الذي يعيش بعد محنة أو كارثة)\nمثال: كانت الحيوانات الأصلح فقط هي الناجية من فصول الشتاء الباردة",
 "残差": "ثمالي, متبق (متعلق بالباقي أو يشير إليه) / عوائد البث المتكرر ((غالباً بصيغة الجمع) دفعة تُقدم لفنان أو كاتب أو مخرج لبرنامج تلفزيوني أو إعلان تجاري وتُدفع عن كل عرض متكرر) / باقي, بقية (شيء متبقٍ بعد إزالة أجزاء أخرى)\nمثال: كمية متبقية",
 "残影": "أَثَر (عَلَامَة؛ بَقِيَّة؛ رَسْم مُتَخَلَّف من شيء ما؛ تأثير؛ انطباع) / لِوْحَة دَارَاتُ مَطَبُوعَة\nمثال: اختفى فلم ير له أثر.",
 "残心": "إنجاز, متابعة (تنفيذ مشروع أو نية حتى الاكتمال التام) / استكمال الضربة, متابعة الحركة (فعل مواصلة الضربة إلى نهايتها الطبيعية)\nمثال: قدرت متابعته وإنجازه لوعده / مَوَدَّة / مُلْحَق / مُرْفَق (مَا يُتَّكَأُ عَلَيْهِ)\nمثال: يؤلمني ذراعي من الكتف إلى المرفق.",
 "残忍": "فَظّ, قَاسِي الصَّرَاحَة (مُبَاشِر وَدَقِيق بِشَكْلٍ مُنَفِّر) / قَاسٍ, هَمَجِيّ ((عن الأشخاص أو أفعالهم) قادر على إلحاق الألم أو المعاناة أو مُيّال لذلك) / بَهِيمِيّ, حَيَوَانِيّ (يُشبه الوحش؛ يُظهر انعدام الحِسّ الإنساني) / قَاسٍ, لَا يَرْحَم (بَالِغُ القَسْوَةِ بِشَكْلٍ مُؤْلِم)",
 "残忍冷酷": "قَاسٍ, الْقَاسِي (شديد وصلب، غير لين؛ جافٍ أو يابس في الملمس أو التعامل)\nمثال: قاس طول السرير.",
 "残忍刻薄": "قَاسٍ, الْقَاسِي (شديد وصلب، غير لين؛ جافٍ أو يابس في الملمس أو التعامل)\nمثال: قاس طول السرير.",
 "残忍性": "فَظّ, قَاسِي الصَّرَاحَة (مُبَاشِر وَدَقِيق بِشَكْلٍ مُنَفِّر) / قَاسٍ, هَمَجِيّ ((عن الأشخاص أو أفعالهم) قادر على إلحاق الألم أو المعاناة أو مُيّال لذلك) / بَهِيمِيّ, حَيَوَانِيّ (يُشبه الوحش؛ يُظهر انعدام الحِسّ الإنساني) / قَاسٍ, لَا يَرْحَم (بَالِغُ القَسْوَةِ بِشَكْلٍ مُؤْلِم)",
 "残忍酷薄": "قَاسٍ, الْقَاسِي (شديد وصلب، غير لين؛ جافٍ أو يابس في الملمس أو التعامل)\nمثال: قاس طول السرير.",
 "残忍非道": "فَظّ, قَاسِي الصَّرَاحَة (مُبَاشِر وَدَقِيق بِشَكْلٍ مُنَفِّر) / قَاسٍ, هَمَجِيّ ((عن الأشخاص أو أفعالهم) قادر على إلحاق الألم أو المعاناة أو مُيّال لذلك) / بَهِيمِيّ, حَيَوَانِيّ (يُشبه الوحش؛ يُظهر انعدام الحِسّ الإنساني) / قَاسٍ, لَا يَرْحَم (بَالِغُ القَسْوَةِ بِشَكْلٍ مُؤْلِم)",
 "残念": "مُؤْسِف, يُؤْسَفُ لَهُ (يَسْتَحِقُّ الأَسَفَ أَوِ النَّدَمَ)",
 "残念ながら": "لِلْأَسَف, لِسُوءِ الْحَظِّ",
 "残念なこと": "شَفَقَة (وشَفِقَ على؛ الرحمة والعَطْف والحَنَان والحُنُوّ) / شَفِقَ ((شَفِقَ) منه، وعليه يَشْفَقَ شَفَقًا: خاف وحَذِرَ، فهو شَفِقٌ؛ (شَفِقَ) عليه: رَقَّ له وعطف عليه؛ فهو شَفِيقٌ)\nمثال: زيري مثير للشفقة.",
 "残念なことに": "لِلْأَسَف, لِسُوءِ الْحَظِّ",
 "残念な事": "شَفَقَة (وشَفِقَ على؛ الرحمة والعَطْف والحَنَان والحُنُوّ) / شَفِقَ ((شَفِقَ) منه، وعليه يَشْفَقَ شَفَقًا: خاف وحَذِرَ، فهو شَفِقٌ؛ (شَفِقَ) عليه: رَقَّ له وعطف عليه؛ فهو شَفِيقٌ)\nمثال: زيري مثير للشفقة.",
 "残念な事に": "لِلْأَسَف, لِسُوءِ الْحَظِّ",
 "残念に思う": "تَابَ (تَابَ: عادَ إِلى اللَّهِ ورَجَعَ وأَنَابَ؛ تابَ اللهُ عَلَيْهِ: أَي عادَ عَلَيْهِ بالمَغْفِرة)",
 "残念無念": "إذلال, انكسار (مشاعر قوية من الإحراج)",
 "残念至極": "إذلال, انكسار (مشاعر قوية من الإحراج)",
 "残映": "أثر طيب, نشوة لاحقة (متعة تذكر حدث سار) / شفق, وهج لاحق (وهج يُرى أحياناً في السماء بعد غروب الشمس)\nمثال: استمتع بنشوة انتصاره / أَثَر (عَلَامَة؛ بَقِيَّة؛ رَسْم مُتَخَلَّف من شيء ما؛ تأثير؛ انطباع) / لِوْحَة دَارَاتُ مَطَبُوعَة\nمثال: اختفى فلم ير له أثر.",
 "残柱": "عمود",
 "残業": "وَقْت إِضَافِيّ (\"بَقِيَ وَقْتاً عِنْدَهُ \" : أَيْ مِقْدَاراً مِنَ الزَّمَنِ؛ \"جَاءَ فِي الوَقْتِ الْمُنَاسِبِ \" : فِي اللَّحْظَةِ الْمُنَاسِبَةِ)\nمثال: حان وقت الذهاب.",
 "残欠": "قِطْعَة, شَقَفَة (القِطْعَةُ: الْجُزْءَ أو الحِصَّة من الشيءِ؛ القِطْعَةُ: فقرة قصيرة عادة من مقالٍ أو كتاب)\nمثال: يصنع قطعة أثاث خشبية.",
 "残渣": "تُفْل / حُثالَة",
 "残滓": "جُثَّة, جُثْمَان (جسد إنسان ميت) / بقايا أثرية, لقى أثرية (أثر تم استخراجه من التربة عن طريق التنقيب) / بقايا (أي شيء يترك غير مستخدم أو لا يزال موجوداً)\nمثال: كانت الجثة مخصصة للتشريح",
 "残照": "أثر طيب, نشوة لاحقة (متعة تذكر حدث سار) / شفق, وهج لاحق (وهج يُرى أحياناً في السماء بعد غروب الشمس)\nمثال: استمتع بنشوة انتصاره",
 "残片": "قِطْعَة, شَقَفَة (القِطْعَةُ: الْجُزْءَ أو الحِصَّة من الشيءِ؛ القِطْعَةُ: فقرة قصيرة عادة من مقالٍ أو كتاب)\nمثال: يصنع قطعة أثاث خشبية.",
 "残物": "بقايا قماش, فضلة قماش (قطعة قماش متبقية بعد استخدام الباقي أو بيعه) / بقايا (جزء صغير أو حصة تتبقى بعد زوال الجزء الرئيسي)",
 "残留": "فَائِض, مُتَبَقٍّ (لم يُسْتَهْلَك بعد)",
 "残留性有機汚染物質": "بُوب, مُوسِيقَى شَعْبِيَّة",
 "残留物": "باقي, بقية (شيء متبقٍ بعد إزالة أجزاء أخرى) / بقية, ثمالة (المادة التي تتبقى بعد إزالة شيء ما)\nمثال: لم يكن هناك بقية / باقي, بقية (شيء متبقٍ بعد إزالة أجزاء أخرى)\nمثال: لم يكن هناك بقية",
 "残痕": "أثر, بقية (دلالة على أن شيئاً ما كان موجوداً)\nمثال: لم يكن هناك أي أثر لدليل على الادعاء",
 "残缺": "قِطْعَة, شَقَفَة (القِطْعَةُ: الْجُزْءَ أو الحِصَّة من الشيءِ؛ القِطْعَةُ: فقرة قصيرة عادة من مقالٍ أو كتاب)\nمثال: يصنع قطعة أثاث خشبية.",
 "残虐": "قَاسٍ, الْقَاسِي (شديد وصلب، غير لين؛ جافٍ أو يابس في الملمس أو التعامل)\nمثال: قاس طول السرير.",
 "残虐無道": "فظاعة, وحشية (عمل من أعمال القسوة الفظيعة) / لَا إِنْسَانِيَّة, وَحْشِيَّة (صفة الافتقار إلى الرحمة أو مراعاة الآخرين)",
