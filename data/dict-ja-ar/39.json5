 "村八分": "إقصاء, نبذ اجتماعي (فعل استبعاد شخص من المجتمع بإجماع عام) / إبعاد, نبذ (حالة النفي أو النبذ (الاستبعاد من المجتمع بموافقة عامة))\nمثال: يجب على الجمعية التخلص من أعضائها المسنين - ليس عن طريق القتل الرحيم بالطبع، ولكن عن طريق النبذ",
 "村庄": "قَرْيَة, كَفْر (الضَيْعَة والمِصْر والبَلَد، كل مكان اتصلت به الأبنية وجمع الناس؛ المَدِينَة التي لا سور لها. ونادر)\nمثال: هذه القرية مملة.",
 "村村": "قَرْيَة, كَفْر (الضَيْعَة والمِصْر والبَلَد، كل مكان اتصلت به الأبنية وجمع الناس؛ المَدِينَة التي لا سور لها. ونادر)\nمثال: هذه القرية مملة.",
 "村民": "قَرَوِيّ, قَرَوِيَّة",
 "村社会": "حَلْقَة / خَاتَم, خَاتِم / دَقَّ, رَنَّ (الشيءَ: ضربه وأصدر صوتًا عند الدق؛ البابَ: طرقه) / رَنَّ ((رَنَّ) رنينا: صَوَّت وَصَاح؛ (رَنَّ) إِلَيْهِ: أصغى) / تَلْفَنَ, رَنَّ / مثال: واصل زيري دق الجرس.",
 "村立": "قَرْيَة, كَفْر (الضَيْعَة والمِصْر والبَلَد، كل مكان اتصلت به الأبنية وجمع الناس؛ المَدِينَة التي لا سور لها. ونادر)\nمثال: هذه القرية مملة.",
 "村肝": "حشا, عضو داخلي (عضو رئيسي يقع داخل الجسم)",
 "村落": "قَرْيَة, كَفْر (الضَيْعَة والمِصْر والبَلَد، كل مكان اتصلت به الأبنية وجمع الناس؛ المَدِينَة التي لا سور لها. ونادر)\nمثال: هذه القرية مملة.",
 "村邑": "قَرْيَة, كَفْر (الضَيْعَة والمِصْر والبَلَد، كل مكان اتصلت به الأبنية وجمع الناس؛ المَدِينَة التي لا سور لها. ونادر)\nمثال: هذه القرية مملة.",
 "村里": "قَرْيَة, كَفْر (الضَيْعَة والمِصْر والبَلَد، كل مكان اتصلت به الأبنية وجمع الناس؛ المَدِينَة التي لا سور لها. ونادر)\nمثال: هذه القرية مملة.",
 "杓": "مِغْرَفَة / مِغْرَفَة / بقدونس البقر, سرفيل بري (عشب ثنائي الحول خشن قائم من العالم القديم أدخل كعشب ضار في شرق أمريكا الشمالية)",
 "杓る": "تَجَوَّفَ / مِغْرَفَة / رَعَشَة / يرتعش / يهز",
 "杓子定規": "صَارِم",
 "杓子菜": "كُرُنْب صِينِيّ, بُوك تْشُوي",
 "杓文字": "ملعقة خشبية (ملعقة مصنوعة من الخشب) / ملعقة خشبية (جائزة ترضية تتكون من ملعقة مصنوعة من الخشب)",
 "杓鴫": "كَرَوَان",
 "杖": "بُوص, قَصَبَة (فتح فمه أو فمه بشكل غير طبيعي؛ تشتت الكلام أو الصوت بشكل غير واضح)\nمثال: عرض الثلاجة 24 بوصة فقط. إنها تناسب الشقق الصغيرة.",
 "杙": "وَتِد, خَازُوق (العصا تثبت في الأرض لتثبيت شيء ما بربطه إليها) / مِحْرَقَة / حِصَّة / رِهَان / جُذْمُور, كُنَّاشَة",
 "杜": "غَابَة, غابة (الغَابَةُ: الأَجَمَةُ ذاتُ الشَّجَرِ المُتَكَاثِف؛ لأَنَّها تُغَيِّبُ مَا فِيهَا. أو الأَجَمَةُ الَّتِي طالتْ، وَلَهَا أَطْراف مُرْتَفِعَةٌ باسِقَة؛ الغابةُ أَجَمة القَصَب، قَالَ: وَقَدْ جُعِلَتْ جماعةَ الشَّجَرِ، لأَنه مأْخوذ مِنَ الغَيابةِ)\nمثال: مشينا في الغابة",
 "杜撰": "غَيْر مُبَالِي (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "杜漏": "غَيْر مُبَالِي (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "杜父魚": "إسقلبين (أي من الأسماك العقربية العديدة الشائكة كبيرة الرأس وعديمة القشور عادة ذات أفواه عريضة)",
 "杜絶": "إيقاف, توقف (فعل إيقاف شيء ما) / انسداد, سدادة (عائق في أنبوب أو مجرى) / توقف, كبح (حالة عدم النشاط بعد انقطاع)\nمثال: إيقافه للتدفق أدى إلى فيضان",
 "杜鵑草": "زنبق الضفدع (خس هندي طافٍ أو زاحف ذو عناقيد طرفية من الزهور الوردية الباهتة؛ المناطق الرطبة في المرتفعات بغرب أمريكا الشمالية)",
 "束": "إِبَالَة, حُزْمَة / تَبَخْتَر / سَمَاكَة / عرض اليد (أي وحدة للطول تعتمد على عرض يد الإنسان) / شبكة خشبية (هيكل يتكون من تصميم زخرفي مصنوع من شرائط من الخشب أو المعدن) / شباك صغير, كوة (فتحة صغيرة (مثل نافذة في باب) يمكن من خلالها إجراء المعاملات) / شبكة بلورية, شبيكة (ترتيب للنقاط أو الجسيمات أو الأشياء في نمط دوري منتظم في بعدين أو 3 أبعاد) / عرض اليد (أي وحدة للطول تعتمد على عرض يد الإنسان) / حزمة ألياف, حزمة عصبية (حزمة من الألياف (خاصة الألياف العصبية)) / كراسة, ملزمة (جزء من عمل مطبوع)",
 "束ね": "إِبَالَة, حُزْمَة",
 "束ねる": "إِبَالَة, حُزْمَة / حَكَمَ, تَحَكَّمَ (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ)\nمثال: حكم علي بالموت. / طَوَى / طَيَّة",
 "束ね積む": "صَدْمَة / صَعْقَة / صَعَقَ",
 "束の間": "عَزْم / لَحْظَة, دَقِيقَة",
 "束生": "ارتعاش حزمي, حزمية (ارتعاش عضلي لمجموعات متجاورة من ألياف العضلات)",
 "束縛": "تقييد, كبح (فعل السيطرة عن طريق تقييد شخص ما أو شيء ما) / رادع, قيد (جهاز يؤخر حركة شيء ما) / بساطة, تقشف فني (الخلو من الزخرفة) / تحفظ, كبح (الانضباط في الأنشطة الشخصية والاجتماعية)\nمثال: التقييد غير القانوني للتجارة / تضميد, تضميد الجراح (عمل وضع ضمادة) / مُلْزِم (مُنَفَّذٌ بِسُلْطَةٍ قَانُونِيَّةٍ صَحِيحَة) / تجليد, غلاف الكتاب (الغطاء الواقي لمقدمة الكتاب ومؤخرته وكعبه) / حاشية, شريط ربط (شريط مخيط فوق أو على طول حافة لتقويتها أو تزيينها)\nمثال: كان للكتاب تجليد جلدي",
 "束脩": "تذكرة الدخول, رسم الدخول (الرسم المفروض للدخول)",
 "条": "عَضَلَة / قُوَّة (ضد الضُعْف، الشِدَّة والقُدْرَة الجِسْمَانِيَّة؛ ضد الضُعْف، المَقْدِرَة والحَوْل والتَمَكُّن، القدرة المعنوية)\nمثال: توم شعر بالقوة. / وَرِيد, عِرْق / ليف مقوى (مادة تشبه الجلد مصنوعة بضغط طبقات من الورق أو القماش) / سجية, شخصية (مجموعة السمات المتأصلة المعقدة التي تحدد التصرفات وردود الأفعال الأخلاقية والأدبية للشخص) / ليف, ليفة (أي من الخلايا المتطاولة الخيطية المتعددة (خاصة الليف العضلي أو الليف العصبي)) / ألياف, ألياف غذائية (طعام نباتي خشن عسر الهضم منخفض العناصر الغذائية؛ كتلته تحفز التمعج المعوي)\nمثال: يهدف التعليم إلى تكوين الشخصية / خَطّ (كِتَابَة؛ ما يَصِل نقطتين أو أكثر)\nمثال: إرسم خط مستقيم. / مَقَال, مَقَالَة / أَدَاةُ تَعْرِيف, أَدَاةُ التَّعْرِيف / مادّةٌ, مَوَادُّ (مؤنث مَادّ، اسم فاعل من مَدَّ. الجمع مَادَّات؛ ما كان مَدَدًا لغيره)\nمثال: لا أحب مادة العلوم. / رَغْم أَنَّ, مَعَ أَنَّ ((رَغَمَ) رَغْمًا، ومَرْغَمًا، ومَرْغَمَةً: ذَلَّ؛ (رَغَمَ) ذل عن كَرْه. يقال (رغَمَ) أَنْفُه)\nمثال: إنه سعيد رغم فقره. / مُنْذُ / لِأَنَّ / قِطْعَة (القِطْعَةُ: الْجُزْءَ أو الحِصَّة من الشيءِ؛ القِطْعَةُ: فقرة قصيرة عادة من مقالٍ أو كتاب)\nمثال: يصنع قطعة أثاث خشبية.",
 "条令": "تَنْظِيم",
 "条件": "شَرْط (شَرِطَ فلانٌ يَشْرِطِ شَرْطًا: وقع في أَمر عظيمٍ)\nمثال: صرخ ليون: \"شرطة!\"",
 "条件づけ": "تَكْيِيف",
 "条件付": "شَرْطِيّ (أحد المنتسبين إلى الشُرْطَة)\nمثال: تبدو وكأنك شرطي.",
 "条件付き": "شَرْطِيّ (أحد المنتسبين إلى الشُرْطَة)\nمثال: تبدو وكأنك شرطي.",
 "条件付き確率": "احتمال مشروط (احتمال وقوع حدث ما بالنظر إلى وقوع حدث أو أحداث أخرى)",
 "条件付け": "تَكْيِيف",
 "条件反射": "منعكس شرطي, منعكس مكتسب (استجابة مكتسبة تخضع لسيطرة (مشروطة بحدوث) محفز)",
 "条件文": "جُمْلَة شَرْطِيَّة (مؤنث جُمْل، وهو الحبل الغليظ أو الجماعة من الناس؛ المَجْمُوع)\nمثال: يا لها من جملة!",
 "条件検索": "مِصْفَايَة / فِلْتَر",
 "条件節": "شَرْطِيّ (أحد المنتسبين إلى الشُرْطَة)\nمثال: تبدو وكأنك شرطي.",
 "条例": "تَنْظِيم",
 "条播": "إنتاج النفط, تنقيب (فعل حفر ثقب في الأرض على أمل إنتاج البترول) / تثقيب, حفر (فعل التثقيب أو الحفر)",
 "条播き": "إنتاج النفط, تنقيب (فعل حفر ثقب في الأرض على أمل إنتاج البترول) / تثقيب, حفر (فعل التثقيب أو الحفر)",
 "条文": "رِسَالَة, مِيسِيج",
 "条款": "اشتراط, شرط (قيد يتم الإصرار عليه كشرط للاتفاق) / شرط, شرط مسبق (افتراض تعتمد عليه صحة أو تأثير شيء آخر) / إقرار قضائي, اشتراط ((قانون) اتفاق أو تنازل يقدمه الأطراف في دعوى قضائية يتعلق بالعمل المعروض على المحكمة؛ يجب أن يكون مكتوبًا ما لم يكن جزءًا من سجل المحكمة)\nمثال: تم عمل إقرار بالوقائع لتجنب التأخير",
 "条片": "شَرِيط / قِطَاع / خَطّ (كِتَابَة؛ ما يَصِل نقطتين أو أكثر)\nمثال: إرسم خط مستقيم.",
 "条理": "عَقْل (أمسك بأطرافه وربطه، أصلها للشاة والإبل حيث تربط قوائمها كي تبقى باركة فلا تقوم؛ بلغ العَقْل، أصبح عاقلا فاهما راشدا)\nمثال: هي فتاة تسحر العقل.",
 "条痕": "اِنْجِرَاف",
 "条目": "مَقَال, مَقَالَة / أَدَاةُ تَعْرِيف, أَدَاةُ التَّعْرِيف / مادّةٌ, مَوَادُّ (مؤنث مَادّ، اسم فاعل من مَدَّ. الجمع مَادَّات؛ ما كان مَدَدًا لغيره)\nمثال: لا أحب مادة العلوم.",
 "条章": "إمدادات غذائية, تموين (مخزون أو إمدادات من الأطعمة)",
 "条約": "مُعَاهَدَة, مُقَاوَلَة (مؤنث مُعَاهَد، وهو اسم مفعول من عَاهَدَ؛ اتِّفَاق مُقَرّر بين دَوْلَتَيْن أو أكثر على أمور معينة)\nمثال: أمضيت المعاهدة يوم 18 نوفمبر 1903.",
 "条約加盟国": "مُوقّع (موضع الوُقُوع؛ الموضع الذي حَدَثَ أو يحدث فيه حادث)\nمثال: هنا موقع الحادث.",
 "条約港": "ميناء معاهدة (ميناء في الصين أو كوريا أو اليابان كان مفتوحًا للتجارة الخارجية بموجب معاهدة تجارية)",
 "条線": "تخطيط شريطي, تريط (شريط أو أشرطة ذات لون مغاير) / تحزز, تخطط (أي من الأخاديد المتوازية الدقيقة مثل: الخدوش التي يتركها نهر جليدي على الصخور أو الخطوط في الأنسجة العضلية)\nمثال: تظهر الكروموسومات شرائط مميزة",
 "条虫": "دودة شريطية (ديدان مفلطحة تشبه الشريط تتطفل في أمعاء البشر والفقاريات الأخرى)",
 "条虫類": "دودة شريطية (ديدان مفلطحة تشبه الشريط تتطفل في أمعاء البشر والفقاريات الأخرى)",
 "条規": "اشتراط, شرط (قيد يتم الإصرار عليه كشرط للاتفاق) / شرط, شرط مسبق (افتراض تعتمد عليه صحة أو تأثير شيء آخر) / إقرار قضائي, اشتراط ((قانون) اتفاق أو تنازل يقدمه الأطراف في دعوى قضائية يتعلق بالعمل المعروض على المحكمة؛ يجب أن يكون مكتوبًا ما لم يكن جزءًا من سجل المحكمة)\nمثال: تم عمل إقرار بالوقائع لتجنب التأخير",
 "条項": "جُمْلَة (مؤنث جُمْل، وهو الحبل الغليظ أو الجماعة من الناس؛ المَجْمُوع) / بَنْد\nمثال: يا لها من جملة!",
 "杢": "حركة فنية (مجموعة محددة مسبقاً من الحركات في الرقص أو التزلج) / تصميم, شكل (عمل زخرفي أو فني) / تمثال صغير, شكل (نموذج لشكل جسماني (خاصة لشخص)) / شخصية, هيئة (الانطباع الذي يحدثه الشخص)\nمثال: حققت أفضل درجة في الحركات الإلزامية",
 "杢目": "حَبَة (واحدة الحَبّ؛ البَذْرَة، لأنها صغيرة مثل الحبة) / حُبُوب / تَجْزِيع, تَعْرِيق\nمثال: أكلت حبة طماطم.",
 "杢調": "مُبَرْقَع, مُرَقَّش (ذو بقع أو رقع من الألوان المتباينة)",
 "杣人": "حَطَّاب",
 "来": "قَادِم / تَالٍ ((تَالَ): عالَجَ التِّوَلةَ: (السِّحْر)؛ (تَالَ) بِه: دُهِيَ ومُنِيَ) / بِجَانِب (بجانب)\nمثال: زيري بجانب الحوض. / مُنْذُ / لِأَنَّ",
 "来し方": "مَاضٍ, الْمَاضِي ((في النحو) زمن نحوي يدل على حدث قد وقع، أو وُجِد قبل الآن بوقت ما) / بَعْدَ (يدل على اللحاق في الزمان؛ يكون مضافا، وينصب أو يجر)\nمثال: و بعد قليل أتى.",
 "来す": "قَضِيَّة (الأمر أو الشيء المُعَقَّد؛ في : ما يقضي فيه القاضي) / سَبَّبَ ((سَبَّبَه): أَكثر سَبَّه؛ (سَبَّبَ) الأسبَاب: أوجدها)\nمثال: سأرفع عليك قضية.",
 "来た": "جَيِّد (بَيِّن الجَوْدَة) / حَسَنًا (تقال عند استحسان الفعل أو القول، هَذَا حَسَن) / مثال: إنها فكرة جيدة.",
 "来たる": "قَادِم / تَالٍ ((تَالَ): عالَجَ التِّوَلةَ: (السِّحْر)؛ (تَالَ) بِه: دُهِيَ ومُنِيَ) / بِجَانِب (بجانب)\nمثال: زيري بجانب الحوض. / جَاءَ (أَتَى؛ حَدَثَ) / أَتَى (جَاءَ؛ فَعَلَ الأمرَ) / جا / جه\nمثال: تقريبا الكل جاء",
