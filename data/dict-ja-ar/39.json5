 "折り節": "أَحْيَانًا",
 "折り紙": "أُورِيغَامِي, طَيّ اَلْوَرَق / بصمة, سمة فارقة (سمة أو صفة مميزة لشخص أو شيء ما)",
 "折り紙つき": "ضَمَان, ضَمَانَة (مَصْدَرُ ضَمِنَ؛ كَفَالَة)\nمثال: لا أستطيع ضمان أي شيء.",
 "折り紙を付ける": "ضَمَان, ضَمَانَة (مَصْدَرُ ضَمِنَ؛ كَفَالَة)\nمثال: لا أستطيع ضمان أي شيء.",
 "折り紙付": "ضَمَان, ضَمَانَة (مَصْدَرُ ضَمِنَ؛ كَفَالَة)\nمثال: لا أستطيع ضمان أي شيء.",
 "折り紙付き": "ضَمَان, ضَمَانَة (مَصْدَرُ ضَمِنَ؛ كَفَالَة)\nمثال: لا أستطيع ضمان أي شيء.",
 "折り罫": "خنجر الكريس (خنجر ماليزي ذو نصل متموج)\nمثال: يحتوي وجهه على العديد من الخطوط",
 "折り襟": "طَيَّة",
 "折り込み": "أَدْخَلَ",
 "折り込む": "أَدْخَلَ / يحساب حساب",
 "折り返し": "طَيَّة / رَاجِع, عَائِد (يميل إلى العودة إلى حالة سابقة) / كَوْرَس, كُورَس / المَعْرُوف بِـ, بِاسْم مُسْتَعَار (كما هو معروف أو مسمى في وقت أو مكان آخر)\nمثال: السيد سميث، المعروف بالسيد لافاييت",
 "折り返し地点": "نقطة تحوّل (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه)\nمثال: هذه هي نقطة ضعفه.",
 "折り返し点": "نقطة تحوّل (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه)\nمثال: هذه هي نقطة ضعفه.",
 "折り返す": "رَجَعَ, عَادَ (جَاءَ بعدما ذَهَبَ)\nمثال: إياك والتحرك حتى أرجع.",
 "折り鞄": "حَقِيبَة, مِحْفَظَة",
 "折る": "اِنْكَسَرَ (فعل مطاوعة لكَسَرَ، قام أحدهم بكَسْره أو قام هو بكَسْر نفسه؛ التاجر: خَسِرَ…)\nمثال: عليك أخذ استراحة. / طَوَى / فَعَلَ, صَنَعَ (عَمِلَ وصَنَعَ، بعلم أو بدون علم، عن قصد أو دون قصد)\nمثال: ماذا فعل للحمي؟ / قَاطَعَ",
 "折れ": "طَوَى",
 "折れる": "اِنْكَسَرَ (فعل مطاوعة لكَسَرَ، قام أحدهم بكَسْره أو قام هو بكَسْر نفسه؛ التاجر: خَسِرَ…)\nمثال: عليك أخذ استراحة. / أَذْعَنَ ((أَذْعَنَ): انْقَادَ وسلس وَيُقَال: أذعن بِالْحَقِّ: أقرّ بِهِ) / دَارَ, أَدَارَ (المحل يجمع البِنَاء والعَرَصَة. قيل سمي كذلك لدوران الناس به وعليه وحوله. يجمع…)\nمثال: إذهب إلى الدار.",
 "折れ口": "اِنْكَسَرَ (فعل مطاوعة لكَسَرَ، قام أحدهم بكَسْره أو قام هو بكَسْر نفسه؛ التاجر: خَسِرَ…)\nمثال: عليك أخذ استراحة.",
 "折れ合う": "حَل وَسَط, تَسْوِيَة (للعقدة: ضد عَقْدها؛ للجامد في السائل: إذابته)\nمثال: حل زيري المشكل.",
 "折れ曲がる": "ثَنَى (طوى شيئًا وجعله على شكل مزدوج؛ أعاد النظر أو غير مسار قراره أو تصرفه)",
 "折れ目": "طَوَى",
 "折れ線": "بشكل متعرج (في مسار متعرج أو على طريق متعرج)\nمثال: طارت الطيور بشكل متعرج عبر السماء الزرقاء",
 "折れ返る": "كَرَّرَ, أَعَادَ (أَعَادَ)\nمثال: كرر الشهادة بعدي.",
 "折丁": "رَزْمَة صَغِيرَة, مَلْزَمَة وَرَق (كمية من الورق؛ 24 أو 25 ورقة)",
 "折上": "جون, خليج صغير (مدخل مائي صغير)",
 "折中": "حَل وَسَط, تَسْوِيَة (للعقدة: ضد عَقْدها؛ للجامد في السائل: إذابته)\nمثال: حل زيري المشكل.",
 "折半": "نِصْف, نُصْف",
 "折句": "قصيدة استهلالية, قصيدة الحروف الأوائل (شعر تشكل فيه أحرف معينة، مثل الحرف الأول في كل سطر، كلمة أو رسالة)",
 "折合い": "اِتِّفَاق, تَوَافُق / عَلَاقَة, مُنَاسَبَة",
 "折合う": "حَل وَسَط, تَسْوِيَة (للعقدة: ضد عَقْدها؛ للجامد في السائل: إذابته)\nمثال: حل زيري المشكل.",
 "折好く": "لِحُسْن اَلْحَظّ",
 "折悪しく": "لِلْأَسَف, لِسُوءِ الْحَظِّ",
 "折戸": "باب أكورديون, باب قابل للطي (باب داخلي يفتح عن طريق الطي للخلف في أقسام (بدلاً من التأرجح على مفصلات))",
 "折折": "أَحْيَانًا",
 "折損": "تحطيم, كسر (عملية كسر شيء ما)\nمثال: كان الكسر لا مفر منه",
 "折敷く": "رَكَعَ, جَثَا ((رَكَعَ) رَكْعًا، ورُكوعًا: انحنى، سواءٌ؛ مَسّتْ ركبتاه الأرض أم لا)",
 "折曲げる": "ثَنَى (طوى شيئًا وجعله على شكل مزدوج؛ أعاد النظر أو غير مسار قراره أو تصرفه)",
 "折板": "جبيرة (جهاز ميكانيكي لتقويم العظام يستخدم لتثبيت وحماية جزء من الجسم (مثل الساق…)\nمثال: أشعل النار باستخدام شظية خشبية مشتعلة",
 "折柄": "عندئذ, في تلك اللحظة (في وقت معين في الماضي)\nمثال: عندئذ انطلق البوق / فِي ذَلِك, فِي ذَلِك المَكَان ((رسمي) في أو داخل ذلك الشيء أو المكان)\nمثال: يمكنهم أن يقرؤوا في ذلك ما هي خططنا",
 "折檻": "ضَرْب (معروف، وهو اللطم أو الدق أو الصكّ و ما أشبه؛ النَوْع أو الصنف أو المثال)\nمثال: ضرب سامي زوجته. / تأنيب, توبيخ (عقاب لفظي)",
 "折畳み": "طي (عملية الطي)\nمثال: قام بطي المناديل طية مزدوجة",
 "折畳み式": "قَابِل لِلطَّيّ (يمكن طيّه وتخزينه)",
 "折畳印刷物": "شرفة, وريقة (سديلة مثلثة رقيقة لصمام القلب)",
 "折目": "طَوَى / آداب, أخلاق (السلوك الاجتماعي)\nمثال: أخلاقه أخلاق خنازير",
 "折目正しい": "حَسَنُ الأَخْلَاقِ, مُؤَدَّب (صحيح السلوك اجتماعياً)",
 "折笠": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "折節": "أَحْيَانًا",
 "折紙": "أُورِيغَامِي, طَيّ اَلْوَرَق / بصمة, سمة فارقة (سمة أو صفة مميزة لشخص أو شيء ما)",
 "折紙を付ける": "ضَمَان, ضَمَانَة (مَصْدَرُ ضَمِنَ؛ كَفَالَة)\nمثال: لا أستطيع ضمان أي شيء.",
 "折罫": "خنجر الكريس (خنجر ماليزي ذو نصل متموج)\nمثال: يحتوي وجهه على العديد من الخطوط",
 "折良く": "لِحُسْن اَلْحَظّ",
 "折衝": "مُفَاوَضَات, مُذَاكَرَات",
 "折衷": "حَل وَسَط, تَسْوِيَة (للعقدة: ضد عَقْدها؛ للجامد في السائل: إذابته)\nمثال: حل زيري المشكل.",
 "折衷主義": "انتقائية (اتخاذ القرارات بناءً على ما يبدو أفضل بدلاً من اتباع مذهب أو أسلوب واحد)",
 "折襟": "طَيَّة",
 "折角": "نَادِر / نوع (صِنْف؛ في : وحدة تصنيفية أقل من الجنس)\nمثال: انه نوع من الفطر.",
 "折込": "أَدْخَلَ",
 "折込み": "أَدْخَلَ",
 "折込む": "أَدْخَلَ / يحساب حساب",
 "折返し": "طَيَّة / رَاجِع, عَائِد (يميل إلى العودة إلى حالة سابقة) / كَوْرَس, كُورَس / المَعْرُوف بِـ, بِاسْم مُسْتَعَار (كما هو معروف أو مسمى في وقت أو مكان آخر)\nمثال: السيد سميث، المعروف بالسيد لافاييت",
 "折返る": "كَرَّرَ, أَعَادَ (أَعَادَ)\nمثال: كرر الشهادة بعدي.",
 "折鶴蘭": "زهرة العنكبوت (موطنها أمريكا الجنوبية ولكنها متوطنة في الأجزاء الدافئة من الولايات المتحدة…)",
 "抛擲": "اِنْصَرَفَ, يَنْصَرِفُ (فعل مطاوعة لصَرَفَ: صَرَفْتُهُ فَاَنْصَرَف؛ ذهب إلى مكان آخر)\nمثال: انصرف من ملكيتنا!",
 "抛物面": "مجسم قطع مكافئ (سطح له مقاطع مكافئة موازية لمحور إحداثي واحد ومقاطع بيضاوية متعامدة مع ذلك…)",
 "抜かす": "إغفال, حذف (خطأ ناتج عن الإهمال) / سَبَقَ (سَبَقَهُ إِلَى الشيءِ يَسْبِقَهُ سَبْقًا: تقدَّمَهُ؛ يقال سَبَقَ الفرسُ في…)\nمثال: سبق و رأيت ذلك. / قَالَ, قال (نَطَقَ بالكلام)\nمثال: قال زيري وداعا.",
 "抜かせ": "أَعْطِنِي",
 "抜かり": "خطأ فادح, زلة (خطأ محرج)",
 "抜かる": "أَخْطَأَ ((أخْطَأَ): خَطِئَ؛ (أخْطَأَ) غَلِظَ (حاد عن الصواب))\nمثال: اعترف أنه أخطأ.",
 "抜きがたい": "رَاسِخ, عَمِيق الجُذُور ((يستخدم خاصة للأفكار أو المبادئ) عميق الجذور؛ ثابت ومتمكّن بقوّة)",
 "抜きさる": "مَرَّرَ, مَرَّ\nمثال: أسأل عن الطريق. / عَزَلَ (فَصَلَ، فرَز، أَبْعَدَ؛ أَبْعَدَ، نَحَّى)\nمثال: جو بايدن طالب الكونغرس بعزل ترامب.",
 "抜きしろ": "مُسْوَدَّة",
 "抜きんでる": "فَاقَ, تَجَاوَزَ",
 "抜きん出る": "فَاقَ, تَجَاوَزَ",
 "抜きネタ": "مِغْرَفَة",
 "抜き出す": "اِخْتَارَ / مُقْتَطَف",
 "抜き出る": "فَاقَ, تَجَاوَزَ",
 "抜き刷": "طبعة منفصلة, مُستَلّة (مقال مطبوع بشكل منفصل ظهر أصلاً في منشور أكبر)",
 "抜き刷り": "طبعة منفصلة, مُستَلّة (مقال مطبوع بشكل منفصل ظهر أصلاً في منشور أكبر)",
 "抜き去る": "مَرَّرَ, مَرَّ\nمثال: أسأل عن الطريق. / عَزَلَ (فَصَلَ، فرَز، أَبْعَدَ؛ أَبْعَدَ، نَحَّى)\nمثال: جو بايدن طالب الكونغرس بعزل ترامب.",
 "抜き取る": "عَزَلَ (فَصَلَ، فرَز، أَبْعَدَ؛ أَبْعَدَ، نَحَّى)\nمثال: جو بايدن طالب الكونغرس بعزل ترامب. / أَخَذَ (تَنَاوَلَ الشيء بيده، تملكه أو تحكم فيه، بالقوة أو بدونها؛ أمْسَكَ بِالشيء…)\nمثال: أخذ الولد يبكي. / سَرَقَ (أخذ ما كان لغيره خفية وبدون علم أحد)\nمثال: من سرق التفاحة؟",
 "抜き型": "أداة قطع, قاطعة (أداة للقطع)",
 "抜き差し": "أَدَارَ (دَارَ نصف دورة فقط؛ الشيء: جعله يدور؛ فعل تعدّي من دَارَ)\nمثال: أدار فاضل مقبض الباب بهدوء و دخل إلى المنزل.",
 "抜き差しならぬ": "دَبِق, صَمْغِيّ (له خصائص اللصق اللزجة كالمواد اللاصقة)",
 "抜き打ち検査": "تفتيش عشوائي, فحص مفاجئ (فحص لأداء العمل أو جودة المنتج يتم في أوقات عشوائية دون سابق إنذار)\nمثال: تضمن الفحوصات المفاجئة مستوى عالياً من الأداء من قبل الموظفين",
 "抜き打ち調査": "تفتيش عشوائي, فحص مفاجئ (فحص لأداء العمل أو جودة المنتج يتم في أوقات عشوائية دون سابق إنذار)\nمثال: تضمن الفحوصات المفاجئة مستوى عالياً من الأداء من قبل الموظفين",
 "抜き放つ": "اِسْتَلّ, شَهَرَ",
 "抜き書き": "مُقْتَطَف",
 "抜き足で": "بتسلل, خلسة (بطريقة خفية)\nمثال: تقدموا خلسة عكس التيار",
 "抜き難い": "رَاسِخ, عَمِيق الجُذُور ((يستخدم خاصة للأفكار أو المبادئ) عميق الجذور؛ ثابت ومتمكّن بقوّة)",
 "抜く": "عَزَلَ (فَصَلَ، فرَز، أَبْعَدَ؛ أَبْعَدَ، نَحَّى)\nمثال: جو بايدن طالب الكونغرس بعزل ترامب. / إغفال, حذف (خطأ ناتج عن الإهمال) / بَالُوعَة / اِخْتَارَ",
 "抜くべからざる": "رَاسِخ, عَمِيق الجُذُور ((يستخدم خاصة للأفكار أو المبادئ) عميق الجذور؛ ثابت ومتمكّن بقوّة)",
 "抜け": "إِغْفَال / تَعْرِيف (الإعلام؛ الشيء أو الكلمة: التوضيح بالمعنى بصورة مختصرة ليعرف الناس ما هي)\nمثال: هل لديه بطاقة شخصية (هوية شخصية - بطاقة تعريف)",
 "抜けかわる": "سَقِيفَة",
 "抜けもれ": "سهو, غفلة (خطأ ناتج عن عدم الانتباه)",
 "抜ける": "خَرَجَ (اِنْتَقَلَ إلى خارج المكان)\nمثال: خرج سامي ليحتفل. / اختفاء, تلاشٍ (التوقف التدريجي عن الظهور)\nمثال: أخذ دروساً لعلاج ضرباته المقوسة / تَرَكَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد…)\nمثال: لقد ترك لك هذا. / خُرُوج\nمثال: خرج سامي ليحتفل.",
 "抜け代る": "سَقِيفَة",
 "抜け代わる": "سَقِيفَة",
 "抜け作": "مُغَفَّل, أَحْمَق",
 "抜け出す": "انْسَلَّ, تَسَلَّلَ خارجاً (المغادرة خلسة وسراً)\nمثال: كانت المحاضرة مملة وانسل العديد من الطلاب خارجاً / اِنْدَلَعَ",
 "抜け出る": "انْسَلَّ, تَسَلَّلَ خارجاً (المغادرة خلسة وسراً)\nمثال: كانت المحاضرة مملة وانسل العديد من الطلاب خارجاً / تَفَوَّقَ, بَزَّ",
 "抜け変る": "سَقِيفَة",
 "抜け変わる": "سَقِيفَة",
 "抜け抜け": "بجرأة, بوقاحة (بطريقة وقحة)\nمثال: تحدث بوقاحة / بغباء (بطريقة غبية)\nمثال: اشترى تذكرة ذهاب فقط بغباء",
 "抜け替る": "سَقِيفَة",
 "抜け替わる": "سَقِيفَة",
 "抜け殻": "قِشْرَة",
 "抜け毛": "تسريح, تمشيط (فعل تمرير المشط خلال الشعر)\nمثال: كان شعره بحاجة إلى تمشيط",
 "抜け漏れ": "سهو, غفلة (خطأ ناتج عن عدم الانتباه)",
 "抜け目": "حماقة, سفاهة (نقص الحذر في الشؤون العملية)",
 "抜け目がない": "حَاذِق (اسم فاعل للفعل حَذِقَ أي المَاهِرِ المُتقِنِ لعَمَلِهِ)\nمثال: إنها حاذقة الذكاء.",
 "抜け目ない": "حَاذِق (اسم فاعل للفعل حَذِقَ أي المَاهِرِ المُتقِنِ لعَمَلِهِ)\nمثال: إنها حاذقة الذكاء.",
 "抜け目のない": "حَاذِق (اسم فاعل للفعل حَذِقَ أي المَاهِرِ المُتقِنِ لعَمَلِهِ)\nمثال: إنها حاذقة الذكاء.",
 "抜け目無い": "حَاذِق (اسم فاعل للفعل حَذِقَ أي المَاهِرِ المُتقِنِ لعَمَلِهِ)\nمثال: إنها حاذقة الذكاء.",
 "抜け穴": "فتحة الرمي, مزغل (ثقب صغير في جدار محصن؛ للمراقبة أو إطلاق الأسلحة) / حركة افتتاحية, خطوة أولى (الأولى في سلسلة من الإجراءات)\nمثال: كشف شعاع الضوء عن فتحه الحذر للباب",
 "抜け荷": "تَهْرِيب",
 "抜け落ちる": "خَرَجَ (اِنْتَقَلَ إلى خارج المكان)\nمثال: خرج سامي ليحتفل.",
 "抜け裏": "طريق جانبي, طريق فرعي (طريق جانبي قليل الاستخدام (كما في الريف))",
 "抜け道": "طريق جانبي, طريق فرعي (طريق جانبي قليل الاستخدام (كما في الريف)) / فتحة الرمي, مزغل (ثقب صغير في جدار محصن؛ للمراقبة أو إطلاق الأسلحة)",
 "抜てき": "اختيار, انتقاء (فعل الاختيار أو الانتقاء)\nمثال: كان اختيارك للألوان غير موفق",
 "抜作": "مُغَفَّل, أَحْمَق",
 "抜出る": "فَاقَ, تَجَاوَزَ",
 "抜刷": "طبعة منفصلة, مُستَلّة (مقال مطبوع بشكل منفصل ظهر أصلاً في منشور أكبر)",
 "抜刷り": "طبعة منفصلة, مُستَلّة (مقال مطبوع بشكل منفصل ظهر أصلاً في منشور أكبر)",
 "抜去": "استخراج, خلع (عملية إخراج شيء ما (خاصة باستخدام الجهد أو القوة))\nمثال: أعطاها طبيب الأسنان تخديراً موضعياً قبل الخلع",
 "抜去る": "مَرَّرَ, مَرَّ\nمثال: أسأل عن الطريق. / عَزَلَ (فَصَلَ، فرَز، أَبْعَدَ؛ أَبْعَدَ، نَحَّى)\nمثال: جو بايدن طالب الكونغرس بعزل ترامب.",
 "抜型": "أداة قطع, قاطعة (أداة للقطع)",
 "抜擢": "اختيار, انتقاء (فعل الاختيار أو الانتقاء)\nمثال: كان اختيارك للألوان غير موفق",
 "抜書": "مُقْتَطَف",
 "抜書き": "مُقْتَطَف",
 "抜本": "استئصال, طمس (التدمير الكامل لكل أثر لشيء ما) / جَذْرِيّ, صَارِم (قويّ وحازم وصارم) / نبذة – مقتطفات من",
 "抜本的": "جَذْرِيّ, صَارِم (قويّ وحازم وصارم)",
 "抜根機": "مشجع رياضي (مؤيد متحمس للرياضة)",
 "抜殻": "قِشْرَة",
 "抜毛": "الجماع المقطوع, العزل (طريقة لتحديد النسل يتم فيها بدء الجماع ولكن يتم سحب القضيب عمداً قبل القذف)",
 "抜毛症": "هوس نتف الشعر",
 "抜毛癖": "هوس نتف الشعر",
 "抜爪": "قلع الأظافر (شكل من أشكال التعذيب يتم فيه نزع أظافر اليدين أو القدمين)",
 "抜目": "حماقة, سفاهة (نقص الحذر في الشؤون العملية)",
 "抜穴": "فتحة الرمي, مزغل (ثقب صغير في جدار محصن؛ للمراقبة أو إطلاق الأسلحة) / حركة افتتاحية, خطوة أولى (الأولى في سلسلة من الإجراءات)\nمثال: كشف شعاع الضوء عن فتحه الحذر للباب",
 "抜粋": "مُقْتَطَف",
 "抜線": "فَجْوَة عَمِيقَة, هُوَّة (تفاوت لا يمكن جسره (بسبب فشل في الفهم مثلاً))\nمثال: شعر بهوة بينه وبين أصدقائه السابقين",
 "抜群": "لَافِت, مُلْفِتٌ لِلنَّظَرِ (لَهُ صِفَةٌ تَفْرِضُ نَفْسَهَا عَلَى الِانْتِبَاهِ)",
 "抜難い": "رَاسِخ, عَمِيق الجُذُور ((يستخدم خاصة للأفكار أو المبادئ) عميق الجذور؛ ثابت ومتمكّن بقوّة)",
 "択び": "اِخْتَارَ",
 "択り": "اِخْتَارَ",
 "択る": "اِخْتَارَ",
 "択一問題": "متعدد الخيارات (يقدم عدة إجابات بديلة يجب اختيار الإجابة الصحيحة منها)\nمثال: أسئلة متعددة الخيارات",
 "択一的": "بَدِيلِيّ, تَخْيِيرِيّ (يَسْتَلْزِمُ الِاخْتِيَارَ بَيْنَ احْتِمَالَاتٍ مُتَنَافِيَةٍ)\nمثال: ما الخيار الذي كان لدي؟",
 "披く": "مَفْتُوح\nمثال: فتح الباب آليا.",
 "披瀝": "إخبار, إعلام (فعل كلامي ينقل معلومات)",
 "披裂軟骨": "غضروف طرجهالي (أحد غضروفين صغيرين في مؤخرة الحنجرة تتصل بهما الحبال الصوتية)",
 "披見": "قِرَاءَة",
 "披針形": "رُمْحِيّ ((عن شكل الورقة) كرأس الرمح؛ ضيّق يتدرَّج إلى قمّة مُدبَّبة)",
 "披露": "إِعْلَان, بَلَاغ",
 "披露宴": "اِسْتِقْبَال",
 "抱え": "حِضن, ملء الذراعين (الكمية التي يمكن احتواؤها بين الذراعين) / مُوَظَّف, مُوَظَّفَة",
 "抱えあげる": "رَفَعَ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ)\nمثال: رفع سامي نظارته.",
 "抱えこむ": "اِحْتَضَنَ, عَانَقَ",
 "抱える": "مَلَكَ, اِمْتَلَكَ (لغة في المَالِك، وهو الذي يَمْلِكُ؛ السُلْطَان الحَاكِم الذي يملك الأَرْض…)\nمثال: زيري ملك لنفسه. / وَظَّفَ",
 "抱え上げる": "رَفَعَ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ)\nمثال: رفع سامي نظارته.",
 "抱え主": "رَبّ عَمَل, رَبَّة عَمَل (رَبَّ الولدَ يَرُبُّ رَبًّا: ولِيَه وتعهده بما يغذيه وينميه ويؤدّبه؛ الفاعل:…)\nمثال: اعتني بي يا رب.",
 "抱え手": "رَبّ عَمَل, رَبَّة عَمَل (رَبَّ الولدَ يَرُبُّ رَبًّا: ولِيَه وتعهده بما يغذيه وينميه ويؤدّبه؛ الفاعل:…)\nمثال: اعتني بي يا رب.",
 "抱え込む": "اِحْتَضَنَ, عَانَقَ",
 "抱きかかえる": "مَسَكَ, مسك",
 "抱きしめる": "اِحْتَضَنَ, عَانَقَ",
 "抱きつく": "اِحْتَضَنَ, عَانَقَ",
 "抱き付く": "اِحْتَضَنَ, عَانَقَ",
 "抱き合せる": "ضَمَّ, جَمَعَ (جَمَعَ، لَمَّ؛ وَصَلَ الشيءَ بالشيءِ)\nمثال: ضم سامي رأس ليلى إلى صدره.",
 "抱き合せ販売": "رابط, وصلة (مثبت يعمل على ضم أو توصيل الأشياء)\nمثال: الجدران متماسكة بروابط معدنية توضع في الملاط الرطب أثناء البناء",
 "抱き合わせ": "رابط, وصلة (مثبت يعمل على ضم أو توصيل الأشياء)\nمثال: الجدران متماسكة بروابط معدنية توضع في الملاط الرطب أثناء البناء",
 "抱き合わせる": "ضَمَّ, جَمَعَ (جَمَعَ، لَمَّ؛ وَصَلَ الشيءَ بالشيءِ)\nمثال: ضم سامي رأس ليلى إلى صدره.",
 "抱き合わせ販売": "رابط, وصلة (مثبت يعمل على ضم أو توصيل الأشياء)\nمثال: الجدران متماسكة بروابط معدنية توضع في الملاط الرطب أثناء البناء",
 "抱き寄せる": "اِحْتَضَنَ, عَانَقَ",
 "抱き抱える": "مَسَكَ, مسك",
 "抱き犬": "كلب حضن (كلب صغير وأليف بما يكفي ليحمل في الحضن)",
 "抱き着く": "اِحْتَضَنَ, عَانَقَ",
 "抱き締める": "اِحْتَضَنَ, عَانَقَ",
 "抱く": "اِحْتَضَنَ, عَانَقَ\nمثال: その子供は母親の腕の中に抱かれて安心した。 — أحس الطفل بالأمان بين ذراعي أمه. / مَلَكَ, اِمْتَلَكَ (لغة في المَالِك، وهو الذي يَمْلِكُ؛ السُلْطَان الحَاكِم الذي يملك الأَرْض…)\nمثال: زيري ملك لنفسه. / اِحْتَضَنَ, عَانَقَ / حِضْنَة, صغار (صغار حيوان يتم رعايتهم في وقت واحد)",
 "抱っこ": "إبقاء, احتفاظ (فعل الاحتفاظ بشيء ما)\nمثال: تلك القبعة ملكي",
 "抱主": "رَبّ عَمَل, رَبَّة عَمَل (رَبَّ الولدَ يَرُبُّ رَبًّا: ولِيَه وتعهده بما يغذيه وينميه ويؤدّبه؛ الفاعل:…)\nمثال: اعتني بي يا رب.",
 "抱卵": "حِضَانَة, تَفْرِيخ",
 "抱合": "تَصْرِيف, تَصْرِيف فِعْل / اِحْتَضَنَ, عَانَقَ",
 "抱合せ": "رابط, وصلة (مثبت يعمل على ضم أو توصيل الأشياء)\nمثال: الجدران متماسكة بروابط معدنية توضع في الملاط الرطب أثناء البناء",
 "抱合せる": "ضَمَّ, جَمَعَ (جَمَعَ، لَمَّ؛ وَصَلَ الشيءَ بالشيءِ)\nمثال: ضم سامي رأس ليلى إلى صدره.",
 "抱合せ販売": "رابط, وصلة (مثبت يعمل على ضم أو توصيل الأشياء)\nمثال: الجدران متماسكة بروابط معدنية توضع في الملاط الرطب أثناء البناء",
 "抱合わせる": "ضَمَّ, جَمَعَ (جَمَعَ، لَمَّ؛ وَصَلَ الشيءَ بالشيءِ)\nمثال: ضم سامي رأس ليلى إلى صدره.",
 "抱合体": "مَقْرُون, مُتَرَافِق ((فِي الكِيمِيَاء العُضْوِيَّة) يَحْتَوِي عَلَى رَابِطَتَيْن مُزْدَوِجَتَيْن…)",
 "抱懐": "مَرْفَأ, مَرْسَى",
 "抱手": "رَبّ عَمَل, رَبَّة عَمَل (رَبَّ الولدَ يَرُبُّ رَبًّا: ولِيَه وتعهده بما يغذيه وينميه ويؤدّبه؛ الفاعل:…)\nمثال: اعتني بي يا رب.",
 "抱擁": "اِحْتَضَنَ, عَانَقَ",
 "抱水": "هَايْدْرَات",
 "抱水クロラール": "هيدرات الكلورال (دواء بلوري عديم اللون يستخدم كمهدئ؛ يهيج المعدة ويمكن أن يسبب الإدمان)",
 "抱負": "أَمَل ((أَمَّلَه): أَمَلَهُ يُقَال: فلَان بَحر المؤمل)\nمثال: أشعر بخيبة أمل.",
 "抵当": "رَهْن, رَهْن عَقَارِيّ ((رَهَنَ) الشيءُ يَرْهَنُ رهْنًا، ورُهُونا: ثَبَت ودامَ؛ يقال (رَهَنَ) بالمكان:…)\nمثال: رهن فاضل الحلي.",
 "抵当権": "رَهْن, رَهْن عَقَارِيّ ((رَهَنَ) الشيءُ يَرْهَنُ رهْنًا، ورُهُونا: ثَبَت ودامَ؛ يقال (رَهَنَ) بالمكان:…)\nمثال: رهن فاضل الحلي.",
 "抵当権者": "حامل الرهن, دائن مرتهن (الشخص الذي يقبل الرهن العقاري)\nمثال: أصبح البنك هو الدائن المرتهن عندما قبل رهن منزلنا الجديد",
 "抵当権設定者": "راهن (الشخص الذي يعطي رهناً عقارياً مقابل المال الذي سيتم سداده)\nمثال: أصبحنا راهنين عندما قبل البنك رهننا وأقرضنا المال لشراء منزلنا الجديد",
 "抵当流れ": "حجز الرهن (الإجراءات القانونية التي يبدأها الدائن لاستعادة الضمان لقرض متخلف عن السداد)",
 "抵当貸付け": "رهن عقاري, قرض عقاري (قرض عقاري عادة ما يكون مضموناً برهن)",
 "抵抗": "مُقَاوَمَة\nمثال: 無駄な抵抗はやめなさい。 — لن تستفيد من المقاومة فلا تحاول. / تثاقل, تردد (درجة معينة من عدم الرغبة)\nمثال: ممانعة في إلزام نفسه / مُقَاوَمَة / مقاومة (جهاز كهربائي يقاوم تدفق التيار الكهربائي)",
 "抵抗力": "مُقَاوَمَة",
 "抵抗器": "مقاومة (جهاز كهربائي يقاوم تدفق التيار الكهربائي)",
 "抵抗性": "مُقَاوَمَة",
 "抵抗感": "مشاعر مناهضة",
 "抵抗率": "مقاومة, مقاومة كهربائية (ممانعة المادة لتدفق التيار الكهربائي؛ تقاس بالأوم)",
 "抵梧": "تَبَايُن, تَضَارُب (اختلاف بين حقائق أو ادعاءات أو آراء متعارضة)\nمثال: تباين متزايد في الآراء",
 "抵牾く": "لَامَ, اِسْتَنْكَرَ (لامَ يَلوم ، لُمْ ، لَوْمًا ، فهو لائم والجمع : لُوَّمٌ ، ولُيَّمٌ وهو أَيضاً…)\nمثال: لام سامي معلمه على فشله هو. / قَلَّدَ",
 "抵触": "مِسَاس / صِرَاع, نِزَاع / تَصَادُّم, اِصْطِدَام",
 "抹殺": "حذف (حَذَفَ الشّيء:قطعه وأَسْقَطَه. حَذَفَ الْمُرَاجِعُ عِبَارَةً منَ الْخِطَابِ…)\nمثال: حذف ياني حسابه. / رَدّ (صَرَفَ، أَرْجَعَ؛ أَعَادَ، أَرْجَعَ. (يتعدى بإلى))\nمثال: اليوم هناك برد. / شطب, محو (الحذف عن طريق الشطب أو المسح)\nمثال: تمت كتابة كلمة أخرى فوق المحو",
 "抹消": "شطب, محو (الحذف عن طريق الشطب أو المسح)\nمثال: تمت كتابة كلمة أخرى فوق المحو",
 "抹茶": "مَاتْشَا",
 "抹茶アイスクリーム": "شَايْ أَخْضَر (شَجَرَة خَضْرَاء من فَصِيلَة الكَامِيلِيات لها أزْهَار بَيْضَاء، وتُعْطِي…)\nمثال: صب الشاي لضيفك.",
 "抹香": "بَخُور (البَخُور : ما يتبخَّر به من عُودٍ ونحوه؛ الدخان أو الرائحة الناتجة من احتراق…)",
 "抹香鯨": "حُوتُ الْعَنْبَر (سمكة صَغيرة كانت أو كبيرة؛ حوت كبير: صاحب مال وسَطْوَة ونفوذ)\nمثال: هل الحوت من الثدييات؟",
 "押え": "وَزْن\nمثال: ان ثقل ما تحمل، فضع بعضا منه. / دِفَاع, حِمَايَة",
 "押える": "غِطَاء / حَصَلَ (الشيء: حَصَلَ عليه؛ العلم: أخَذَه وحَازَه)\nمثال: متى حصل الحادث؟ / قَبْضَة / اِحْتِيَاط\nمثال: حجز مناد موعدا.",
 "押さえ": "وَزْن\nمثال: ان ثقل ما تحمل، فضع بعضا منه. / دِفَاع, حِمَايَة",
 "押さえる": "غِطَاء / حَصَلَ (الشيء: حَصَلَ عليه؛ العلم: أخَذَه وحَازَه)\nمثال: متى حصل الحادث؟ / قَبْضَة / اِحْتِيَاط\nمثال: حجز مناد موعدا.",
 "押さえ込み": "تعطيل, شل الحركة (فعل الحد من الحركة أو جعل الشيء غير قادر على الحركة)\nمثال: تسببت العاصفة في شلل تام لفريق الإنقاذ",
 "押さえ込む": "سَيْطَرَ\nمثال: من أنت لتحكم علي؟",
 "押し": "دَفَعَ, زق (لزّه ونحاه وأبعده؛ صرفه قبل وروده، أي منعه وأبعده قبل مجيئه أو حدوثه، وعكسه أن…)\nمثال: دفع زيري الثمن. / وَزْن\nمثال: ان ثقل ما تحمل، فضع بعضا منه. / سُلْطَة (هو طعام يصنع من الخُضَار الطَازَجَة تقطع وتخلط ويضاف إليها المِلْح وقد يضاف…)\nمثال: هو متعطش للسلطة.",
 "押しあう": "تدافع, زحام (فعل التدافع (شق طريقك عن طريق الدفع))",
 "押しあげる": "تشجيع, دعم (فعل إعطاء الأمل أو الدعم لشخص ما)\nمثال: ساعدها بدفعة لتجاوز السياج",
 "押しかけ": "غَيْرُ مَدْعُوّ ((عن الشخص) لم تُوجَّه إليه دعوة)",
 "押しかぶせ断層": "صدع الدسر, صدع عكسي (صدع جيولوجي يبدو فيه أن الجانب العلوي قد تم دفعه للأعلى بفعل الضغط)",
 "押しきる": "هَزَمَ, غَلَبَ",
 "押したおす": "صَرَعَ (طَرَحَه على الأرض؛ أَرْدَاهُ قَتِيلاً وأَهْلَكَهُ)",
 "押したてる": "رَفَعَ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ)\nمثال: رفع سامي نظارته. / رَشَّحَ, عَيَّنَ (اقتَرَح شخصًا أو جهةً ليكون مرشَّحًا لمنصب أو مهمة؛ جعَل شيئًا يرشُح أو يُصفّى) / دَفَعَ, زق (لزّه ونحاه وأبعده؛ صرفه قبل وروده، أي منعه وأبعده قبل مجيئه أو حدوثه، وعكسه أن…)\nمثال: دفع زيري الثمن.",
 "押しつけ": "فَرْض",
 "押しつけがましい": "اِنْتِهَازِيّ, مُلِحّ (يتسم بطموح عدواني ونشاط ومبادرة)",
 "押しつつむ": "لِحَاف, بَطَّانِيَّة",
 "押しつぶす": "هَرَسَ (سَحَقَ أو دَكَّ شيئًا بقوة حتى يتفتت؛ طَحَنَ أو فَتَّتَ شيئًا)",
 "押して": "بالإكراه, بالقوة (بطريقة تتضمن استخدام القوة)\nمثال: تذكر مخاطر فرض قيمنا وتحيزاتنا بالقوة / رَغْمَ, بِالرَّغْمِ مِن ((رَغَمَ) رَغْمًا، ومَرْغَمًا، ومَرْغَمَةً: ذَلَّ؛ (رَغَمَ) ذل عن كَرْه. يقال…)\nمثال: إنه سعيد رغم فقره.",
 "押していく": "مَشَى, تَمَشَّى (اِنْتَقَلَ من مكان إلى آخر؛ اِنْتَقَلَ من مكان إلى آخر على الأقدام. (تخصيص))\nمثال: مشى ياني مع سكورا.",
 "押して行く": "مَشَى, تَمَشَّى (اِنْتَقَلَ من مكان إلى آخر؛ اِنْتَقَلَ من مكان إلى آخر على الأقدام. (تخصيص))\nمثال: مشى ياني مع سكورا.",
 "押しとどめる": "تَفَقُّد",
 "押しなべて": "بشكل عام, عموماً (دون تمييز واحد عن الآخرين)\nمثال: هو مهتم بالثعابين بشكل عام",
 "押しに弱い": "أمر سهل, لعب أطفال (أي مشروع يسهل القيام به)\nمثال: تسويق هذا المنتج لن يكون نزهة",
 "押しのけ容積": "إِزَاحَة, نُزُوح",
 "押しの強い": "عُدْوَانِيّ",
 "押しも押されぬ": "مَقْبُول, مُعْتَرَف بِه (حائز على القبول العامّ أو يفرض الاعتراف)",
 "押しも押されもしない": "مَقْبُول, مُعْتَرَف بِه (حائز على القبول العامّ أو يفرض الاعتراف)",
 "押しも押されもせぬ": "مَقْبُول, مُعْتَرَف بِه (حائز على القبول العامّ أو يفرض الاعتراف)",
 "押しやる": "دفع عنيف (فعل الدفع بقوة (دفع شخص أو شيء))\nمثال: أعطى الباب دفعة قوية",
 "押しピン": "دبوس رسم, دبوس ضغط (دبوس لتثبيت الأوراق على لوحة إعلانات أو لوحة رسم)",
 "押しボタン": "زر, زر ضغط (مفتاح كهربائي يعمل بالضغط)\nمثال: كان المصعد يعمل بأزرار ضغط",
