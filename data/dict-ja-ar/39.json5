 "栄養": "تَغْذِيَة (تَغْذِيَةُ الجِسْمِ: تَزْوِيدُهُ بِـالغِذَاءِ؛ في ركيزة أساسية للحياة، فهي تشمل جميع العمليات التي يُحصل من خلالها الكائن الحي على احتياجاته الغذائية. تُساهم هذه الاحتياجات في تشغيل الوظائف…) / غِذَاء / إِطْعَام / اِغْتِذَاء / طَعَام (كُلُّ مَا يُؤْكَلُ. مُرادفه أَكْل)\nمثال: لن نستمر في تغذية الانتقامات.",
 "栄養ドリンク": "مَشْرُوب الطَّاقَة",
 "栄養不良": "سُوء تَغْذِيَة",
 "栄養不足": "سُوء تَغْذِيَة",
 "栄養分": "مُغَذٍّ, المُغَذِّي",
 "栄養剤": "مُغَذٍّ, المُغَذِّي",
 "栄養士": "أخصائي تغذية, أخصائي حميات (متخصص في دراسة الأنظمة الغذائية والتغذية)",
 "栄養失調": "سُوء تَغْذِيَة",
 "栄養学": "علم الحمية, نظام غذائي (الدراسة العلمية لإعداد الطعام وتناوله)",
 "栄養学者": "أخصائي تغذية, أخصائي حميات (متخصص في دراسة الأنظمة الغذائية والتغذية)",
 "栄養物": "تَغْذِيَة (تَغْذِيَةُ الجِسْمِ: تَزْوِيدُهُ بِـالغِذَاءِ؛ في ركيزة أساسية للحياة، فهي تشمل جميع العمليات التي يُحصل من خلالها الكائن الحي على احتياجاته الغذائية. تُساهم هذه الاحتياجات في تشغيل الوظائف…) / غِذَاء / إِطْعَام / اِغْتِذَاء / طَعَام (كُلُّ مَا يُؤْكَلُ. مُرادفه أَكْل)\nمثال: لن نستمر في تغذية الانتقامات.",
