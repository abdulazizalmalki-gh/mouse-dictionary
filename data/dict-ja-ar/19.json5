 "ウルトラス": "رَادِيكَالِيّ, مُتَطَرِّف ((لِلآرَاءِ وَالأَفْعَال) بَعِيدٌ جِدًّا عَنِ المِعْيَارِ المَقْبُول)",
 "ウルトラナショナリズム": "تَعَصُّب وَطَنِيّ, شُوفِينِيَّة (وطنية متعصبة)",
 "ウルトラマリン": "أَزْرَق لَازَوَرْدِيّ (بلون أزرق صافٍ زاهٍ إلى أزرق أرجواني) / أزرق فاقع, أزرق ما وراء البحار (لون أزرق زاهٍ إلى أزرق أرجواني) / ألترامارين, لازوردي (خضاب أزرق مصنوع من اللازورد المسحوق)",
 "ウルトラモダン": "فَائِقُ الحَدَاثَة (حَدِيثٌ لِأَقْصَى دَرَجَة)",
 "ウルトラモンタニズム": "ألترامونتانية, الولاء البابوي المطلق ((الكنيسة الكاثوليكية) السياسة القائلة بأن السلطة المطلقة للكنيسة يجب أن تكون مخولة للبابا)",
 "ウルトラＣ": "ورقة حكم, ورقة رابحة (ورقة لعب من النقش الذي تم إعلانه كحكم)\nمثال: آس الحكم هو فائز مؤكد",
 "ウルドゥご": "اَلْأُرْدِيَّة, أُرْدُو",
 "ウルドゥーご": "اَلْأُرْدِيَّة, أُرْدُو",
 "ウルドゥー語": "اَلْأُرْدِيَّة, أُرْدُو",
 "ウルドゥ語": "اَلْأُرْدِيَّة, أُرْدُو",
 "ウルフ": "ذِئْب (حيوان مفترس من فصيلة الكلاب يعيش في جماعات وأكثر ما يصطاد في الليل؛ صفة تطلق على الرجل الذي يخدع النساء ليحصل على مراده منهن بالدهاء) / ديب / ذيب / اِلْتَهَمَ بِشَرَاهَة\nمثال: نظرة الذئب للشاة.",
 "ウルフハウンド": "كلب صيد الذئاب (أكبر سلالات الكلاب؛ كان يستخدم سابقاً لصيد الذئاب)",
 "ウルムチ": "أُورُومْتْشِي",
 "ウルヴァリン": "شَرِه, وُلْفِيرِين ((شَرِهَ) إلى الطعام وغيره، وشَرِهَ عليه يَشْرَهَ شَرَهًا: اشتد حرصُه عليه واشتِهاؤه له؛ فهو شَرِهٌ وشَرْهَانُ، وهي شَرِهة وشَرْهَى)\nمثال: كانت صوفيا شرهة.",
 "ウレアーゼ": "يورييز (إنزيم يحفز التحلل المائي لليوريا إلى ثاني أكسيد الكربون والأمونيا؛ يوجد في البكتيريا المعوية)",
 "ウレタン": "بولي يوريثان (أي من البوليمرات المختلفة التي تحتوي على شق اليوريثان؛ تُصنع منه مجموعة متنوعة من الأشكال الاصطناعية وتستخدم كمواد لاصقة أو بلاستيك أو طلاء أو مطاط)",
 "ウロつく": "تجوال خلسة, تسلل (فعل التجوال خلسة)",
 "ウロウロ": "بتململ, بقلق (بطريقة متململة)\nمثال: طقطق مفاصل أصابعه بتململ / نفق أفقي (ممر أفقي (أو شبه أفقي) في منجم) / مرمى, مغزى (المعنى العام أو الفحوى السائد) / اتجاه, تيار (ميل عام للتغيير (كما في الرأي)) / رُكَام (كتلة كبيرة من المواد المتراكمة بفعل الرياح أو التيارات المائية)\nمثال: حفروا نفقاً أفقياً موازياً للعرق المعدني / صخب, ضجة (اضطراب نشط وسريع) / مشاجرة تافهة, ملاحاة (شجار حول نقاط تافهة) / إزعاج, جلبة (اضطراب غاضب) / اضطراب, حيرة (حالة من الهياج المثار)\nمثال: لم يرد إثارة جلبة",
 "ウロキナーゼ": "منشط البلازمينوجين, يوروكيناز (بروتياز يُنتج في الكلى يحول البلازمينوجين إلى بلازمين وبالتالي يبدأ انحلال الفيبرين)",
 "ウロコ": "مِقْيَاس / مِيزَان (آلة تُوزن بها الأشياء ويُعْرف مِقْدارها؛ عَدْل) / سُلَّمٌ مُوسِيقِيّ (أَمِنَ على نفسه وحالته؛ بَرِئَ من الآفات والْأَذَى) / سُلَّم (أَمِنَ على نفسه وحالته؛ بَرِئَ من الآفات والْأَذَى) / فَلْس, حَرْشَف\nمثال: هم يريدون السلم.",
 "ウロビリノゲン": "ستيركوبيلينوجين, يوروبيلينوجين (مولد لون يتكون في الأمعاء نتيجة تحلل البيليروبين؛ ينتج اليوروبيلين عند الأكسدة؛ يُفرز بعضه في البراز ويمتص البعض الآخر ويُفرز في الصفراء أو البول)",
 "ウロビリノーゲン": "ستيركوبيلينوجين, يوروبيلينوجين (مولد لون يتكون في الأمعاء نتيجة تحلل البيليروبين؛ ينتج اليوروبيلين عند الأكسدة؛ يُفرز بعضه في البراز ويمتص البعض الآخر ويُفرز في الصفراء أو البول)",
 "ウロビリン": "يوروبيلين (خضاب صفراوي بني يتشكل من اليوروبيلينوجين ويوجد في البراز وبكميات صغيرة في البول)",
 "ウロボロス": "أُورُبُورُوس",
 "ウヰスキー": "ويسكي (مشروب مصنوع من هريس الحبوب المخمر)",
 "ウン": "بَلَى, مبلا (يفيد إبطال النفي؛ في : نَعَمْ في كل حالاتها عدا جواب النِدَاء في بعض لهجات الشام، في بعض اللهجات الشامية الأخرى يقال مبَلَى…) / نَعَم, نَعَمَانِ (الإبِل والبَقَر والغَنَم. وتسمى نَعَم فقط إذا كان فيها إبل، فالإبل لوحدها نَعَم…)\nمثال: هذه ليست جملة, بل مجموعة من الكلمات بلى معنى. / هَمْهَمَة (اِسْمٌ لِصَوْتِ الأَسَد) / هَمْهَمَ, دَنْدَنَ\nمثال: انا اسمع ضجيج المروحة و صوت نزول قطرات الماء من الصنبور و همهمة الثلاجة و تكتكة الساعة و هبوب الهواء عند مرور السيارات بالقرب من المنزل .",
 "ウンウンエンニウム": "أُونُون إِينْيُوم",
 "ウンウンオクチウム": "أُنُون أُوكْتِيُوم",
 "ウンウンクアジウム": "أُنُون كُوَادْيُوم",
 "ウンウンセプチウム": "أُنُون سِيبْتِيُوم",
 "ウンウントリウム": "أُنُون تْرِيُّوم",
 "ウンウンビウム": "أُنُون بِيُوم",
 "ウンウンヘキシウム": "أُنُون هِيكْسِيُوم",
 "ウンウンペンチウム": "أُنُون بِينْتِيُوم",
 "ウンカ": "نطاط النبات (قريب من نطاطات الأوراق وحشرات البصاق ولكنه نادراً ما يضر بالنباتات المزروعة)",
 "ウンコ": "بَرَّزَ, تَغَوَّطَ (خَرَجَ؛ نَبُه بعد خُمول) / بُرَاز, كَاكَا / خَرَاء, بُرَاز",
 "ウンコ座り": "قرفصاء (فعل اتخاذ أو الحفاظ على وضعية الانحناء مع ثني الركبتين والأرداف بالقرب من الكعبين) / القرفصاء, سكوات (تمرين عن طريق اتخاذ وضعية الانحناء مع ثني الركبتين بشكل متكرر؛ يقوي عضلات الساق)",
 "ウンザリ": "إِطْنَابِيّ, ثَرْثَار (يَسْتَخْدِمُ أَوْ يَحْتَوِي عَلَى كَلِمَاتٍ أَكْثَرَ مِمَّا يَنْبَغِي) / مُضْجِر, مُمِلّ (يفتقر إلى الإثارة لدرجة تسبب السأم الذهني)",
 "ウンジャメナ": "نِجَامِينَا, إِنْجَامِينَا",
 "ウンタイ": "اِغْتِصَاب (أَخْذُ الشيء قَهْراً وَظُلْماً؛ اِسْتِخْدَامُ العُنْفِ مَعَ النساء لِنَيْلِ الحَاجَةِ مِنْهَن بِالرَّغْمِ عَنْهَن) / اِغْتَصَبَ, غَصَبَ (غَصَبَ؛ زَنَى (بِفُلَانَةٍ) قَهْرًا/غَصْبًا)\nمثال: تعرض زيري للاغتصاب.",
 "ウンダイ": "اِغْتِصَاب (أَخْذُ الشيء قَهْراً وَظُلْماً؛ اِسْتِخْدَامُ العُنْفِ مَعَ النساء لِنَيْلِ الحَاجَةِ مِنْهَن بِالرَّغْمِ عَنْهَن) / اِغْتَصَبَ, غَصَبَ (غَصَبَ؛ زَنَى (بِفُلَانَةٍ) قَهْرًا/غَصْبًا)\nمثال: تعرض زيري للاغتصاب.",
 "ウンチ": "بَرَّزَ, تَغَوَّطَ (خَرَجَ؛ نَبُه بعد خُمول) / بُرَاز, كَاكَا",
 "ウンディーネ": "أوندين (أي من أرواح المياه الأنثوية المختلفة)",
 "ウンマ": "أُمَّة (المرأة المملوكة، خلاف الحرة)\nمثال: الأمة تطلب العدالة الاجتماعية.",
 "ウンムン": "هَانْغُول",
 "ウー": "خَمْسَة, خمسة (قيمة عددية تساوي \"٥\"؛ الرقم ما بعد \"أَرْبَعَة\" وقبل \"سِتَّة\")\nمثال: رأيت خمسة رجال.",
 "ウージ": "قَصَب السُّكَّر",
 "ウースターソース": "صلصة ورسيستيرشاير (صلصة لذيذة من الخل وصلصة الصويا والتوابل)",
 "ウースター・ソース": "صلصة ورسيستيرشاير (صلصة لذيذة من الخل وصلصة الصويا والتوابل)",
 "ウーステッド": "صوف ممشط, ورستد (قماش صوفي بسطح محكم صلب وبدون وبر؛ منسوج من خيوط صوفية ممشطة) / غزل صوفي ممشط (خيط صوفي مجدول بإحكام مغزول من الصوف طويل التيلة)\nمثال: ارتدى بدلة من الصوف الممشط",
 "ウーゾ": "أوزو (مشروب يوناني منكه باليانسون)",
 "ウード": "عُود (قطعة من الخشب كالعصا جمعه عيدان؛ ما يُتَبَخَّر به)\nمثال: أشعلت عود ثقاب.",
 "ウーハー": "مجهار ترددات منخفضة, ووفر (مكبر صوت يعيد إنتاج الأصوات ذات الترددات الصوتية المنخفضة)",
 "ウーパールーパー": "عفريت الماء",
 "ウーファー": "مجهار ترددات منخفضة, ووفر (مكبر صوت يعيد إنتاج الأصوات ذات الترددات الصوتية المنخفضة)",
 "ウープス": "آهٍ (صوت يستخدم للدلالة على الشعور بالألم العاطفي أو الجسدي؛ ألم، إما عاطفي أم جسدي)\nمثال: آه ، هناك فراشة!",
 "ウーマン": "اِمْرَأَة (أُنْثَى الْإِنْسَانِ الْبَالِغَةُ؛ زَوْجَةٌ)\nمثال: أنا امرأة قوية.",
 "ウーマンリブ": "تحرير المرأة, حركة نسوية (الحركة التي تهدف إلى الحقوق المتساوية للمرأة)",
 "ウーマン・リブ": "تحرير المرأة, حركة نسوية (الحركة التي تهدف إلى الحقوق المتساوية للمرأة)",
 "ウーラノス": "أُورَانُوس",
 "ウーリーモンキー": "سَعْدَان صُوفِيّ",
 "ウーリー・モンキー": "سَعْدَان صُوفِيّ",
 "ウール": "صُوف",
 "ウーロン": "أولونغ (أوراق شاي صينية تم تخميرها جزئياً قبل تجفيفها)",
 "ウーン": "غرفة الطوارئ (غرفة في مستشفى أو عيادة مزودة بطاقم ومعدات لتوفير رعاية طارئة للأشخاص الذين يحتاجون إلى علاج طبي فوري) / إيربيوم (عنصر فلزي ثلاثي التكافؤ من مجموعة الأتربة النادرة)",
 "エア": "هَوَاء (خَلِيط من الغَازَات يغلف الكرة الأرضية؛ فَارِغ) / جَوّ / نَغَم\nمثال: أخرجي الهواء من فمك.",
 "エアウェイ": "خطوط جوية, شركة طيران (مؤسسة تجارية توفر رحلات مجدولة للركاب) / قناة تهوية, مجرى هواء (قناة توفر التهوية (كما في المناجم)) / مجرى التنفس, مسلك تنفسي (الممرات التي يدخل من خلالها الهواء ويخرج من الجسم) / مسار طيران, ممر جوي (طريق محدد تتبعه الطائرات في الطيران من مطار إلى آخر)",
 "エアウエイ": "خطوط جوية, شركة طيران (مؤسسة تجارية توفر رحلات مجدولة للركاب) / قناة تهوية, مجرى هواء (قناة توفر التهوية (كما في المناجم)) / مجرى التنفس, مسلك تنفسي (الممرات التي يدخل من خلالها الهواء ويخرج من الجسم) / مسار طيران, ممر جوي (طريق محدد تتبعه الطائرات في الطيران من مطار إلى آخر)",
 "エアガン": "بندقية هوائية, مسدس هوائي (بندقية تدفع المقذوف بواسطة الهواء المضغوط)",
 "エアガール": "مُضِيفَةْ طَيَرَان, مُضِيفَة",
 "エアクッション": "وسادة هوائية (وسادة مصنوعة عادة من المطاط أو البلاستيك يمكن نفخها) / زنبرك هوائي, وسادة هوائية (جهاز ميكانيكي يستخدم الهواء المحصور لامتصاص صدمة الحركة) / وسادة هوائية (الهواء المحبوس الذي يدعم الحوامة على مسافة قصيرة فوق الماء أو الأرض)",
 "エアクラフト": "طَائِرَة (مَرْكَبَة كبيرة لها جناحان وتنقل الرُكَّاب والبَضَائِع بالجَوّ. ؛ كل من تَطِير، مؤنث طائر)\nمثال: لقد وصلت الطائرة.",
 "エアクリーナー": "مرشح هواء, منقي هواء (مرشح يزيل الغبار من الهواء الذي يمر عبره)",
 "エアコン": "مُكَيِّف هَوَاء",
 "エアコンディショナ": "مُكَيِّف هَوَاء",
 "エアコンディショナー": "مُكَيِّف هَوَاء",
 "エアコンディショニング": "تَكْيِيف",
 "エアコンプレッサ": "ضاغط هواء (ضاغط يسحب الهواء عند الضغط الجوي ويضخه بضغط أعلى)",
 "エアコンプレッサー": "ضاغط هواء (ضاغط يسحب الهواء عند الضغط الجوي ويضخه بضغط أعلى)",
 "エアシック": "مُصَاب بِدُوَار السَّفَر (يعاني من دوار ناتج عن الحركة كالسفر بالسيّارة أو الطائرة أو السفينة)",
 "エアシックネス": "داء الجو, دوار الجو (دوار الحركة الذي يحدث أثناء السفر بالطائرة (خاصة أثناء الاضطرابات الجوية))",
 "エアシップ": "سفينة هوائية, منطاد موجه (طائرة ذاتية الدفع قابلة للتوجيه)",
 "エアステーション": "قاعدة جوية (قاعدة للطائرات العسكرية)",
 "エアゾール": "هَبَاء جَوِّيّ, أَيْرُوسُول",
 "エアターミナル": "محطة جوية (محطة طرفية تخدم المسافرين جواً أو الشحن الجوي)",
 "エアダクト": "قناة تهوية, مجرى هواء (قناة توفر التهوية (كما في المناجم))",
 "エアダムチーズ": "إِيدَام",
 "エアダム・チーズ": "إِيدَام",
 "エアハンマー": "جاك هامر, مطرقة تكسير (مطرقة تعمل بالهواء المضغوط)",
 "エアバス": "إِيرْبَاص",
 "エアバック": "وسادة هوائية (قيد أمان في السيارة؛ تنتفخ الوسادة عند الاصطدام وتمنع السائق أو الراكب من الاندفاع للأمام)",
 "エアバッグ": "وسادة هوائية (قيد أمان في السيارة؛ تنتفخ الوسادة عند الاصطدام وتمنع السائق أو الراكب من الاندفاع للأمام)",
 "エアフィルタ": "مرشح هواء, منقي هواء (مرشح يزيل الغبار من الهواء الذي يمر عبره)",
 "エアフィルター": "مرشح هواء, منقي هواء (مرشح يزيل الغبار من الهواء الذي يمر عبره)",
 "エアフィールド": "مَهْبِط, مَدْرَج",
 "エアフォース": "سِلَاح طَيَرَان",
 "エアブラシ": "بخاخ طلاء, فرشاة هوائية (مرذاذ لرش الطلاء عن طريق الهواء المضغوط)",
 "エアプランツ": "نبات فوقي, نبات هوائي (نبات يستمد الرطوبة والمواد المغذية من الهواء والمطر؛ ينمو عادة على نبات آخر ولكنه لا يتطفل عليه)",
 "エアベット": "مرتبة هوائية (مرتبة يمكن تخزينها مسطحة ونفخها للاستخدام)",
 "エアベッド": "مرتبة هوائية (مرتبة يمكن تخزينها مسطحة ونفخها للاستخدام)",
 "エアホステス": "مضيفة طيران (امرأة مضيفة على متن طائرة)",
