 "取り柄": "مَاثَلَ / اِسْتَحَقَّ, اِسْتَأْهَلَ / اِسْتَحَقَّ / قِيمَة",
 "取り極める": "وَافَقَ (صَادَفَ؛ صَادَقَ)\nمثال: وافق ماثيو بتردد.",
 "取り次ぎ": "فَاعِلِيَّة / وِكَالَة / وَكَالَة / دَائِرَة (في : الشكل الهندسي الذي ليس له نقطة بداية ولا نهاية ويتكون من قَوْس مستمر؛ الهيئة أو الجهة التي تدير امرا ما)\nمثال: رجاء ضع دائرة حول الجواب الصحيح. / رَدّ (صَرَفَ، أَرْجَعَ؛ أَعَادَ، أَرْجَعَ. (يتعدى بإلى)) / حَلّ (للعقدة: ضد عَقْدها؛ للجامد في السائل: إذابته) / أَجَابَ, رَدَّ (رَدَّ على سُؤالٍ أو طلبٍ؛ أَمْتَثَلَ لِمُطَالَبَةٍ أو دعوةٍ)\nمثال: اليوم هناك برد. / وَسِيلَةُ النَّقْل",
 "取り次ぐ": "أَبْلَغَ, نَقَلَ (أَكْثَرُ بَلَاغَة)\nمثال: أبلغ توم تحياتي. / بَلَّغَ, أَبْلَغَ / مِقْبَض",
 "取り止め": "يُعَلِّق / تَعْلِيق",
 "取り止める": "أَلْغَى, أَبْطَلَ",
 "取り決め": "قَرَار, تَصْمِيم",
 "取り決める": "وَافَقَ (صَادَفَ؛ صَادَقَ)\nمثال: وافق ماثيو بتردد.",
 "取り沙汰": "تَكَلَّمَ, تَحَدَّثَ (نُطْق؛ تَحَدُّث) / مُحَاضَرَة / خِطَاب / مُحَادَثَات, مُفَاوَضَات\nمثال: أخذت تكلم الكلب.",
 "取り消し": "اِنْسِحَاب",
 "取り消す": "أَلْغَى, أَبْطَلَ",
 "取り混ぜる": "خَلَطَ, مَزَجَ (اختلط)\nمثال: خلط توم بين السكر و الملح.",
 "取り潰す": "خُرْدَة / يتخلى, نبذ / شجار"
}
