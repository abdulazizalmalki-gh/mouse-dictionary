 "エン麦": "شُوفَان, خَرْطَال",
 "エヴァンジェリスト": "مُبَشِّر / إِنْجِيلِيّ, بَشِير",
 "エヴァーグリーン": "دائم الخضرة ((عن النباتات والشجيرات) تحمل أوراق الشجر طوال العام) / نبات دائم الخضرة (نبات له أوراق تدوم وتظل خضراء طوال العام)",
 "エヴォリューション": "تَطَوُّر",
 "エヴォルーション": "تَطَوُّر",
 "エヴリバディ": "اَلْجَمِيع, كُلّ شَخْص",
 "エー": "ا (الْأَلِفُ بِدُونِ هَمْزَةٍ ؛ تُسْتَخْدَمُ فِي آخِرِ أَوْ وَسَطِ الكلام لمد الصوت بحركة الفتحة؛ تبتدئ بها بعض الأسماء في اللغة العربية وهي) / إِي, آ (بمعنى نَعَم ولا يأتي إلا وبعده قَسَم؛ في : يستخدم بدلا من نعم في كل الحالات حتى في إجابة النداء وليس بحاجة إلى قَسَم) / فِي (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: يجب على توم عدم إعطاء إي إهتمام لما قالته ماري.",
 "エーがたかんえん": "التهاب الكبد أ, التهاب الكبد المعدي",
 "エーきゅう": "صِنْف, صَنْف / طَبَقَة / فَصْل, صَفّ (التقطيع؛ تقسيم الشيء أجزاءً؛ جزء، باب في كِتَاب أو ماشابهه) / طَائِفَة (مؤنث طَائِف؛ التي تطوفُ؛ القطعة أو الجزء من الشيء أو الواحدة منه)\nمثال: اقرأ هذا الفصل.",
 "エーアイ": "ذَكَاء اِصْطِنَاعِيّ",
 "エーアールディーエス": "رئة رطبة, متلازمة الضائقة التنفسية الحادة (إصابة رئوية حادة تتميز بالسعال والخرخرة؛ التهاب في الرئتين اللتين تصبحان صلبتين وليفيتين ولا تستطيعان تبادل الأكسجين)",
 "エーイー": "مدير حساب عميل, مسؤول حسابات (شخص مسؤول عن حساب العميل لدى وكالة إعلانات أو شركة وساطة أو غيرها من الأعمال الخدمية)",
 "エーエス": "كَـ, مِثْل / مِثْل, كَـ (الشَبَه؛ النَظِير)\nمثال: قصدته مثل نكتة. / أَنْجْلُوسَكْسُونِيّ",
 "エーエスエムアール": "إيسمار, استجابة الزوال الحسية الذاتية (تجربة مبتهجة تتميز بإحساس بالوخز يشبه الكهرباء الساكنة على الجلد يبدأ عادةً في فروة الرأس وينتقل إلى أسفل الرقبة والعمود الفقري العلوي، مما يعجل…)",
 "エーエスエーピー": "فِي أَقْرَب وَقْت مُمْكِن, فِي أَسْرَع وَقْت مُمْكِن (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "エーエスディー": "اِضْطِرَاب طَيْف التَّوَحُّد / توحد ((طب نفس) انشغال غير طبيعي بالذات؛ يتميز باضطرابات التواصل وقصر مدى الانتباه وعدم القدرة على معاملة الآخرين كبشر) / عيب الحاجز الأذيني (فتحة غير طبيعية بين الأذينين الأيسر والأيمن للقلب)",
 "エーエスピー": "صِل, كوبرا مصرية (كوبرا استخدمها الفراعنة كرمز لقوتهم على الحياة والموت) / أفعى أوروبية (من جنوب أوروبا؛ تشبه الأفعى الشائعة ولكنها أصغر)",
 "エーエフ": "تركيز تلقائي (جهاز بصري لتركيز الكاميرا أو أداة أخرى تلقائياً) / تَرَدُّد صَوْتِيّ (تردد موجة صوتية مسموعة) / سِلَاح طَيَرَان / جِمَاع شَرَجِيّ (الموافقة والمساعدة في أي شيء كان؛ الشيء: جمعه)\nمثال: توم قائد جماعة أنونيموس.",
 "エーエム": "صَبَاحًا, قَبْل الظُّهْر (قبل الساعة 12 ظهراً)\nمثال: لنلتقي في الساعة 11 صباحاً / تضمين السعة (تضمين سعة الموجة الحاملة (للراديو))",
 "エーエムディー": "تنكس بقعي مرتبط بالعمر (تنكس بقعي مرتبط بالتقدم في العمر)",
 "エーエムピー": "أدينوسين أحادي الفوسفات",
 "エーエルイー": "مِزْر",
 "エーエルエス": "التَّصَلُّب الضُّمُورِي الْجَانِبِي",
 "エーエルティー": "اِرْتِفَاع, عُلُوّ (المسافة الزاوية فوق الأفق (خاصة لجرم سماوي))",
 "エーエーかいぎ": "أفرو-آسيوي (من أو يتعلق بدول أفريقيا وآسيا أو شعوبها)\nمثال: سكان أفرو-آسيويين",
 "エーカー": "آكِر",
 "エークラス": "صِنْف, صَنْف / طَبَقَة / فَصْل, صَفّ (التقطيع؛ تقسيم الشيء أجزاءً؛ جزء، باب في كِتَاب أو ماشابهه) / طَائِفَة (مؤنث طَائِف؛ التي تطوفُ؛ القطعة أو الجزء من الشيء أو الواحدة منه)\nمثال: اقرأ هذا الفصل.",
 "エーゲかい": "بَحْر إِيجَة (شَقّ الأرض؛ التَحَيُّر والبَهْت من الفزع أو من شدة العَطَش فنظر لا يقصد شيئا)\nمثال: هبطت على البحر.",
 "エーゲぶんめい": "الحضارة الإيجية (حضارة ما قبل التاريخ في الجزر في بحر إيجة والبلدان المحيطة)",
 "エーゲ文明": "الحضارة الإيجية (حضارة ما قبل التاريخ في الجزر في بحر إيجة والبلدان المحيطة)",
 "エーゲ海": "بَحْر إِيجَة (شَقّ الأرض؛ التَحَيُّر والبَهْت من الفزع أو من شدة العَطَش فنظر لا يقصد شيئا)\nمثال: هبطت على البحر.",
 "エーコンかん": "أنبوب البلوط (صمام مفرغ صغير؛ يستخدم في الترددات العالية)",
 "エーコン管": "أنبوب البلوط (صمام مفرغ صغير؛ يستخدم في الترددات العالية)",
 "エーシー": "تَيَّار مُتَرَدِّد / حاسوب تناظري (حاسوب يمثل المعلومات بكميات متغيرة (مثل المواضع أو الفولتية)) / متوسط التكلفة (إجمالي تكلفة جميع الوحدات المشتراة (أو المنتجة) مقسوماً على عدد الوحدات)",
 "エージ": "عُمْر ((في الإسلام) أبو حفص عمر بن الخطاب العدوي القرشي، ثاني الخلفاء الراشدين في المذهب السني) / سِنّ ((سَنَّ) السِّكِّينَ و نحْوَهُ يَسُنُّ سَنًّا: أَحَدَّهُ؛ فهو مسنون وسَنِين)\nمثال: جون في عمر أخي.",
 "エージェンシー": "فَاعِلِيَّة / وِكَالَة / وَكَالَة / دَائِرَة (في : الشكل الهندسي الذي ليس له نقطة بداية ولا نهاية ويتكون من قَوْس مستمر؛ الهيئة أو الجهة التي تدير امرا ما)\nمثال: رجاء ضع دائرة حول الجواب الصحيح.",
 "エージェント": "فَاعِل (الشيء :فعله)\nمثال: تظن الشرطة أن سامي يعلم من الفاعل. / ضابط استخبارات, عميل سري (شخص يعمل سراً في التجسس لصالح حكومة)",
 "エージェントオレンジ": "العامل البرتقالي (مبيد أعشاب استخدم في حرب فيتنام لإزالة أوراق الغابات)",
 "エージェント・オレンジ": "العامل البرتقالي (مبيد أعشاب استخدم في حرب فيتنام لإزالة أوراق الغابات)",
 "エージズム": "تمييز عمري (التمييز على أساس عمر الشخص)",
 "エージレス": "أَبَدِيّ, أَزَلِيّ (مستمرّ إلى الأبد أو إلى أجل غير مُسمًّى)",
 "エージング": "شَيْخُوخَة, هَرَم",
 "エージント": "فَاعِل (الشيء :فعله)\nمثال: تظن الشرطة أن سامي يعلم من الفاعل.",
 "エージーエー": "صَلَع",
 "エース": "آس (نوع نباتي من جنس الآس من الفَصِيلَة الآسيّة. وهو شجر دائم الخُضْرَة، بيضيّ الورق، أبيض الزَّهْر أو ورديُّه، يُزرع للتزيين ولرائحته العِطْريّة…؛ ورقة من أوراق اللعب ذات نقطة أو علامة واحدة) / واحد النرد, آس (في وَ: العدد واحد العدد الاول) / ذَرَّة / إرسال ساحق (الإرْسال : الإطلاق؛ النقل والبَعْث من مكان إلى آخر) / أفضل رامٍ في الفريق / آس, مُمْتاز (نوع نباتي من جنس الآس من الفَصِيلَة الآسيّة. وهو شجر دائم الخُضْرَة، بيضيّ الورق، أبيض الزَّهْر أو ورديُّه، يُزرع للتزيين ولرائحته العِطْريّة…؛ ورقة من أوراق اللعب ذات نقطة أو علامة واحدة)\nمثال: لدي الآس الكوبا.",
 "エータ": "إِتَا",
 "エーティー": "ناقل حركة أوتوماتيكي (ناقل حركة يغير التروس تلقائياً وفقاً لسرعة السيارة)",
 "エーティーエム": "صَرَّافَة, صَرَّاف آلِيّ / وضع النقل غير المتزامن (وسيلة للاتصالات الرقمية قادرة على سرعات عالية جداً؛ مناسبة لنقل الصور أو الصوت أو الفيديو وكذلك البيانات)\nمثال: يستخدم وضع النقل غير المتزامن لكل من الشبكات المحلية والشبكات الواسعة",
 "エーティーピー": "أدينوسين ثلاثي الفوسفات (نيوكليوتيد مشتق من الأدينوسين يوجد في الأنسجة العضلية؛ المصدر الرئيسي للطاقة للتفاعلات الخلوية)",
 "エーテル": "أَثِير",
 "エーディー": "حِقْبَة عَامَّة, بَعْدَ الْمِيلَاد (مدة من الزمان تُقَدَّرُ بطولٍ غير محدد، وقد تكون قصيرة أو طويلة بحسب السياق؛ فترة تاريخية مميزة بسمات أو أحداث معينة)\nمثال: لقد بدأت حقبة جديدة في الجزائر. / مدير فني (المخرج المسؤول عن الجوانب الفنية لإنتاج مسرحي (الأزياء والمناظر والإضاءة)) / حِقْبَة عَامَّة, بَعْدَ الْمِيلَاد (مدة من الزمان تُقَدَّرُ بطولٍ غير محدد، وقد تكون قصيرة أو طويلة بحسب السياق؛ فترة تاريخية مميزة بسمات أو أحداث معينة)\nمثال: لقد بدأت حقبة جديدة في الجزائر.",
 "エーディーエイチ": "الهرمون المضاد لإدرار البول, فازوبريسين (هرمون تفرزه الغدة النخامية الخلفية؛ يؤثر على ضغط الدم ويقلل تدفق البول)",
 "エーディーエイチディー": "اضطراب فرط الحركة ونقص الانتباه, اضطراب نقص الانتباه (حالة (تغلب عند الأولاد) تتميز باضطرابات سلوكية وصعوبات في التعلم)",
 "エーディーエッチディー": "اضطراب فرط الحركة ونقص الانتباه, اضطراب نقص الانتباه (حالة (تغلب عند الأولاد) تتميز باضطرابات سلوكية وصعوبات في التعلم)",
 "エーディーコンバーター": "محول تناظري رقمي, مرقم (جهاز لتحويل الإشارات التناظرية إلى إشارات رقمية)",
 "エーディーピー": "أدينوسين ثنائي الفوسفات",
 "エーデルバイス": "إِيدِلْفَايْس",
 "エーデルワイス": "إِيدِلْفَايْس",
 "エーデルヴァイス": "إِيدِلْفَايْس",
 "エートス": "إيثوس, روح الثقافة ((الأنثروبولوجيا) الروح المميزة لثقافة أو عصر ما)\nمثال: الروح اليونانية",
 "エード": "مُسَاعَدَة",
 "エービーエム": "صاروخ مضاد للصواريخ الباليستية (صاروخ دفاعي مصمم لإسقاط الصواريخ الباليستية العابرة للقارات القادمة)\nمثال: محادثات الحد من الأسلحة الاستراتيجية وضعت حدوداً على نشر الصواريخ المضادة للصواريخ الباليستية",
 "エービーシー": "حُرُوف هِجَاء, أَبْجَد (صِيْغَةُ جَمْعٍ مُفْرَدُهَا: حرف)\nمثال: كيف أتذكر الحروف الصينية؟ / أبجدية, ألفباء (مجموعة رموز تتضمن حروفاً وتُستخدم لكتابة لغة ما)",
 "エーピー": "برنامج تطبيقي, تطبيق (برنامج يعطي تعليمات للحاسوب توفر للمستخدم أدوات لإنجاز مهمة ما)\nمثال: لقد جرب عدة تطبيقات مختلفة لمعالجة النصوص / إقامة كاملة, خطة أمريكية (خطة فندقية تشمل ثلاث وجبات يومياً)",
 "エーピーアイ": "وَاجِهَة بَرْمَجَة اَلتَّطْبِيقَات",
 "エーピーエル": "لُغَة بَرْمَجَة (هِيَ مجموعة من الأصوات التي يصدرها الإنسان على شكل كلمات منظمة بقواعد، ليتواصل به الناس وينقلون به الافكار والمعاني، اللسان؛ يقصد بها أحيانا اللهجة)\nمثال: الأمازيغية لغة.",
 "エーブイ": "سمعي بصري (يتضمن كلاً من السمع والرؤية (يتعلق عادةً بالوسائل التعليمية)) / مادة سمعية بصرية, وسيلة سمعية بصرية (مواد تستخدم البصر أو الصوت لتقديم المعلومات)\nمثال: القسم السمعي البصري بالمدرسة",
 "エープリルフール": "يَوْم كَذْبَة أَبْرِيل (فترة من الزمان تبدأ عند غُرُوب الشمس وتنتهي عند غُرُوب شمس النهار التالي ويشمل اللَيْلَة ونَهَارا. طوله أربع وعشرين سَاعَة؛ النَهَار، يبدأ من طلوع الفَجْر إلى غُرُوب الشَمس، على المجاز)\nمثال: طقس اليوم جميل. / كِذْبَةُ أَبْرِيل",
 "エープリル・フール": "يَوْم كَذْبَة أَبْرِيل (فترة من الزمان تبدأ عند غُرُوب الشمس وتنتهي عند غُرُوب شمس النهار التالي ويشمل اللَيْلَة ونَهَارا. طوله أربع وعشرين سَاعَة؛ النَهَار، يبدأ من طلوع الفَجْر إلى غُرُوب الشَمس، على المجاز)\nمثال: طقس اليوم جميل. / كِذْبَةُ أَبْرِيل",
 "エーユー": "وحدة فلكية (وحدة طول تستخدم للمسافات داخل النظام الشمسي؛ تساوي متوسط المسافة بين الأرض والشمس (حوالي 150 مليون كيلومتر)) / ذهب (عنصر فلزي ناعم أصفر قابل للطرق والسحب؛ لا يتفاعل مع معظم المواد الكيميائية)",
 "エーライン": "ملابس بقصة واسعة (ملابس نسائية لها جزء علوي ضيق وتنورة واسعة تكون أعرض ما يمكن عند الحاشية)",
 "エーリアン": "غَرِيب, غَرِيبَة / أَجْنَبِيّ, أَجْنَبِيَّة",
 "エール": "صَاحَ (صاتَ بأقصى طاقته وأعلى صوته، يستخدم للحيّ ولا يقال صاح للجماد؛ عليه: ناداه)\nمثال: سأساعدك يا صاح. / مِزْر",
 "エールをおくる": "انشراح, بشاشة (صفة كون المرء مبتهجاً وطارداً للكآبة) / هتاف (صرخة أو صيحة استحسان)\nمثال: أضافت الزهور لمسة من البهجة للغرفة الكئيبة",
 "エールを送る": "انشراح, بشاشة (صفة كون المرء مبتهجاً وطارداً للكآبة) / هتاف (صرخة أو صيحة استحسان)\nمثال: أضافت الزهور لمسة من البهجة للغرفة الكئيبة",
 "エーログラム": "رسالة جوية (رسالة ترسل بالبريد الجوي)",
 "エーロゾル": "هَبَاء جَوِّيّ, أَيْرُوسُول",
 "エー・アイ": "ذَكَاء اِصْطِنَاعِيّ",
 "エー・アール・ディー・エス": "رئة رطبة, متلازمة الضائقة التنفسية الحادة (إصابة رئوية حادة تتميز بالسعال والخرخرة؛ التهاب في الرئتين اللتين تصبحان صلبتين وليفيتين ولا تستطيعان تبادل الأكسجين)",
 "エー・イー": "مدير حساب عميل, مسؤول حسابات (شخص مسؤول عن حساب العميل لدى وكالة إعلانات أو شركة وساطة أو غيرها من الأعمال الخدمية)",
 "エー・エス": "كَـ, مِثْل / مِثْل, كَـ (الشَبَه؛ النَظِير)\nمثال: قصدته مثل نكتة. / أَنْجْلُوسَكْسُونِيّ",
 "エー・エス・エム・アール": "إيسمار, استجابة الزوال الحسية الذاتية (تجربة مبتهجة تتميز بإحساس بالوخز يشبه الكهرباء الساكنة على الجلد يبدأ عادةً في فروة الرأس وينتقل إلى أسفل الرقبة والعمود الفقري العلوي، مما يعجل…)",
 "エー・エス・エー・ピー": "فِي أَقْرَب وَقْت مُمْكِن, فِي أَسْرَع وَقْت مُمْكِن (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "エー・エス・ディー": "اِضْطِرَاب طَيْف التَّوَحُّد / توحد ((طب نفس) انشغال غير طبيعي بالذات؛ يتميز باضطرابات التواصل وقصر مدى الانتباه وعدم القدرة على معاملة الآخرين كبشر) / عيب الحاجز الأذيني (فتحة غير طبيعية بين الأذينين الأيسر والأيمن للقلب)",
 "エー・エス・ピー": "صِل, كوبرا مصرية (كوبرا استخدمها الفراعنة كرمز لقوتهم على الحياة والموت) / أفعى أوروبية (من جنوب أوروبا؛ تشبه الأفعى الشائعة ولكنها أصغر)",
 "エー・エフ": "تركيز تلقائي (جهاز بصري لتركيز الكاميرا أو أداة أخرى تلقائياً) / تَرَدُّد صَوْتِيّ (تردد موجة صوتية مسموعة) / سِلَاح طَيَرَان / جِمَاع شَرَجِيّ (الموافقة والمساعدة في أي شيء كان؛ الشيء: جمعه)\nمثال: توم قائد جماعة أنونيموس.",
 "エー・エム・ディー": "تنكس بقعي مرتبط بالعمر (تنكس بقعي مرتبط بالتقدم في العمر)",
 "エー・エム・ピー": "أدينوسين أحادي الفوسفات",
 "エー・エル・イー": "مِزْر",
 "エー・エル・エス": "التَّصَلُّب الضُّمُورِي الْجَانِبِي",
 "エー・エル・ティー": "اِرْتِفَاع, عُلُوّ (المسافة الزاوية فوق الأفق (خاصة لجرم سماوي))",
 "エー・シー": "تَيَّار مُتَرَدِّد / حاسوب تناظري (حاسوب يمثل المعلومات بكميات متغيرة (مثل المواضع أو الفولتية)) / متوسط التكلفة (إجمالي تكلفة جميع الوحدات المشتراة (أو المنتجة) مقسوماً على عدد الوحدات)",
 "エー・ジー・エー": "صَلَع",
 "エー・ティー": "ناقل حركة أوتوماتيكي (ناقل حركة يغير التروس تلقائياً وفقاً لسرعة السيارة)",
 "エー・ティー・エム": "صَرَّافَة, صَرَّاف آلِيّ / وضع النقل غير المتزامن (وسيلة للاتصالات الرقمية قادرة على سرعات عالية جداً؛ مناسبة لنقل الصور أو الصوت أو الفيديو وكذلك البيانات)\nمثال: يستخدم وضع النقل غير المتزامن لكل من الشبكات المحلية والشبكات الواسعة",
 "エー・ティー・ピー": "أدينوسين ثلاثي الفوسفات (نيوكليوتيد مشتق من الأدينوسين يوجد في الأنسجة العضلية؛ المصدر الرئيسي للطاقة للتفاعلات الخلوية)",
 "エー・ディー": "حِقْبَة عَامَّة, بَعْدَ الْمِيلَاد (مدة من الزمان تُقَدَّرُ بطولٍ غير محدد، وقد تكون قصيرة أو طويلة بحسب السياق؛ فترة تاريخية مميزة بسمات أو أحداث معينة)\nمثال: لقد بدأت حقبة جديدة في الجزائر. / مدير فني (المخرج المسؤول عن الجوانب الفنية لإنتاج مسرحي (الأزياء والمناظر والإضاءة)) / حِقْبَة عَامَّة, بَعْدَ الْمِيلَاد (مدة من الزمان تُقَدَّرُ بطولٍ غير محدد، وقد تكون قصيرة أو طويلة بحسب السياق؛ فترة تاريخية مميزة بسمات أو أحداث معينة)\nمثال: لقد بدأت حقبة جديدة في الجزائر.",
 "エー・ディー・エイチ": "الهرمون المضاد لإدرار البول, فازوبريسين (هرمون تفرزه الغدة النخامية الخلفية؛ يؤثر على ضغط الدم ويقلل تدفق البول)",
 "エー・ディー・エイチ・ディー": "اضطراب فرط الحركة ونقص الانتباه, اضطراب نقص الانتباه (حالة (تغلب عند الأولاد) تتميز باضطرابات سلوكية وصعوبات في التعلم)",
 "エー・ディー・ピー": "أدينوسين ثنائي الفوسفات",
 "エー・ビー・エム": "صاروخ مضاد للصواريخ الباليستية (صاروخ دفاعي مصمم لإسقاط الصواريخ الباليستية العابرة للقارات القادمة)\nمثال: محادثات الحد من الأسلحة الاستراتيجية وضعت حدوداً على نشر الصواريخ المضادة للصواريخ الباليستية",
 "エー・ビー・シー": "حُرُوف هِجَاء, أَبْجَد (صِيْغَةُ جَمْعٍ مُفْرَدُهَا: حرف)\nمثال: كيف أتذكر الحروف الصينية؟ / أبجدية, ألفباء (مجموعة رموز تتضمن حروفاً وتُستخدم لكتابة لغة ما)",
 "エー・ピー": "برنامج تطبيقي, تطبيق (برنامج يعطي تعليمات للحاسوب توفر للمستخدم أدوات لإنجاز مهمة ما)\nمثال: لقد جرب عدة تطبيقات مختلفة لمعالجة النصوص / إقامة كاملة, خطة أمريكية (خطة فندقية تشمل ثلاث وجبات يومياً)",
 "エー・ピー・アイ": "وَاجِهَة بَرْمَجَة اَلتَّطْبِيقَات",
 "エー・ピー・エル": "لُغَة بَرْمَجَة (هِيَ مجموعة من الأصوات التي يصدرها الإنسان على شكل كلمات منظمة بقواعد، ليتواصل به الناس وينقلون به الافكار والمعاني، اللسان؛ يقصد بها أحيانا اللهجة)\nمثال: الأمازيغية لغة.",
 "エー・ブイ": "سمعي بصري (يتضمن كلاً من السمع والرؤية (يتعلق عادةً بالوسائل التعليمية)) / مادة سمعية بصرية, وسيلة سمعية بصرية (مواد تستخدم البصر أو الصوت لتقديم المعلومات)\nمثال: القسم السمعي البصري بالمدرسة",
 "オア": "أَو, أَم (يفيد الشك؛ يفيد التقسيم)\nمثال: أكون أو لا أكون؟",
 "オアかいろ": "بوابة أو (دائرة بوابة في الكمبيوتر تعمل عندما يعمل أي من مدخلاتها)",
 "オアゲート": "بوابة أو (دائرة بوابة في الكمبيوتر تعمل عندما يعمل أي من مدخلاتها)",
 "オアシス": "وَاحَة, غُوطَة (بقعة خضراء في الصحراء أو في أرض قاحلة، وأصبحت كذلك بسبب وجود مصدر ماء بقربها)",
 "オア回路": "بوابة أو (دائرة بوابة في الكمبيوتر تعمل عندما يعمل أي من مدخلاتها)",
 "オイシイ": "حَسَن, جَيِّد (جَمِيل؛ مُبْهِج) / صِحِّيّ (ما ينفع الصحة) / حَسَنًا (تقال عند استحسان الفعل أو القول، هَذَا حَسَن) / خَيْر ((خَيَّرَ)وخَيَّرَهُ: فَوَّضَ إليه الخِيارَ؛ (خَيَّرَ) بَين الْأَشْيَاء: فضل بَعْضهَا على بعض) / سِلْعَة\nمثال: إيمي فتاة حسنة. / جَذَّاب",
 "オイスター": "مَحَار",
 "オイスターバー": "بار المحار (حانة (كما في مطعم) تتخصص في تقديم المحار المعد بطرق مختلفة)",
 "オイスター・バー": "بار المحار (حانة (كما في مطعم) تتخصص في تقديم المحار المعد بطرق مختلفة)",
 "オイタ": "أذى, شقاوة (سلوك متهور أو خبيث يسبب الإزعاج أو الضيق للآخرين) / أذى, شر (الطبيعة أو الصفة المؤذية أو الشريرة) / شَأْن / عَلَاقَة غَرَامِيَّة",
 "オイタナシー": "قَتْلٌ رَحِيم (تعمّد جعله يَمُوتُ، أزهق روحه، أمَاتَه متعمدا؛ الوقتَ: ضيعه بشيء غير ذي فائدة وهو ينتظر أمرا آخر)\nمثال: قتل الصياد دبا.",
 "オイタナジー": "قَتْلٌ رَحِيم (تعمّد جعله يَمُوتُ، أزهق روحه، أمَاتَه متعمدا؛ الوقتَ: ضيعه بشيء غير ذي فائدة وهو ينتظر أمرا آخر)\nمثال: قتل الصياد دبا.",
 "オイッス": "يَاه, اسمع / هَلَا / نَعَم سَيِّدِي (الإبِل والبَقَر والغَنَم. وتسمى نَعَم فقط إذا كان فيها إبل، فالإبل لوحدها نَعَم…)\nمثال: أنت نعم الطالب.",
 "オイニー": "رَائِحَة, رِيحة (الخاصية التي تمتلكها بعض المركبات الكيميائية المتطايرة في الهواء على الأرجح بتركيز منخفض جدًا…) / شَمّ ((شَمَّ) البناءُ أو الجبلُ يَشُمُّ شَمَمًا: ارتفَعَ أعلاهُ؛ (شَمَّ) الأنفُ: ارتفعت قَصَبَتُهُ قليلاً في استواء) / شَمَّ ((شَمَّ) البناءُ أو الجبلُ يَشُمُّ شَمَمًا: ارتفَعَ أعلاهُ؛ (شَمَّ) الأنفُ: ارتفعت قَصَبَتُهُ قليلاً في استواء) / اِشْتَمَّ (اجتذب الرائحة، قَرَبَّ الشيء أو اقترب منه ليشمه) / شم ((شَمَّ) البناءُ أو الجبلُ يَشُمُّ شَمَمًا: ارتفَعَ أعلاهُ؛ (شَمَّ) الأنفُ: ارتفعت قَصَبَتُهُ قليلاً في استواء) / شَمَّمَ\nمثال: شم تلك الرائحة.",
 "オイプシロン": "أُبْسِلُون, أُبْسِيلُون",
 "オイラル": "أيرير (100 أيرير تساوي 1 كرونا في آيسلندا)",
 "オイラーすう": "إِي, إِيه (بمعنى نَعَم ولا يأتي إلا وبعده قَسَم؛ في : يستخدم بدلا من نعم في كل الحالات حتى في إجابة النداء وليس بحاجة إلى قَسَم)\nمثال: يجب على توم عدم إعطاء إي إهتمام لما قالته ماري.",
 "オイラーのこうしき": "صِيغَة أُويْلِر",
 "オイラーの公式": "صِيغَة أُويْلِر",
 "オイラー数": "إِي, إِيه (بمعنى نَعَم ولا يأتي إلا وبعده قَسَم؛ في : يستخدم بدلا من نعم في كل الحالات حتى في إجابة النداء وليس بحاجة إلى قَسَم)\nمثال: يجب على توم عدم إعطاء إي إهتمام لما قالته ماري.",
 "オイリュトミー": "حركات إيقاعية, يوريثميكس (التفسير بحركات جسدية متناغمة لإيقاع المؤلفات الموسيقية؛ يستخدم لتعليم الفهم الموسيقي)",
 "オイリー": "زَيْتِيّ, دُهْنِيّ / زَيْتِيّ",
 "オイル": "زَيْت, زيت (ما يعصر من الزَيْتُون؛ كل سائل لزج يستخرد من النبات يستخدم كما يستخدم السمن) / نَفْط, زَيْت (سَائِل أسود قابل للاحتراق يوجد في باطن الأرض تستخدم مشتقاته كوقود وفي الصناعة. يعتبر حاليا أهم مصادر الطاقة في العالم)\nمثال: خبأن ذلك الزيت. / كِيرُوسِين",
 "オイルこうかん": "تغيير الزيت (استبدال الزيت المتسخ بآخر نظيف)",
 "オイルご": "الفرنسية القديمة (أقدم شكل للغة الفرنسية؛ من القرن التاسع إلى الخامس عشر)",
 "オイルカラー": "زيت, لون زيتي (طلاء زيتي يحتوي على صبغة يستخدمه الفنانون) / طلاء زيتي (طلاء يكون الزيت الجاف هو الوسيط فيه)",
 "オイルクロス": "مُشَمَّع",
 "オイルクロース": "مُشَمَّع",
 "オイルシェール": "سجيل زيتي, طفل صفحي زيتي (طفل صفحي يمكن الحصول منه على النفط بالتسخين)",
 "オイルスキン": "معطف مشمع (معطف ماكنتوش مصنوع من قماش قطني معالج بالزيت والصبغة لجعله مقاوماً للماء)",
 "オイルステイン": "بقعة زيت (بقعة ناتجة عن الزيت)",
 "オイルストーン": "مسن زيتي (حجر شحذ للاستخدام مع الزيت)",
 "オイルバーナー": "حارق نفط, فرن نفطي (فرن يحرق النفط)",
 "オイルフィルター": "مرشح زيت (مرشح يزيل الشوائب من الزيت المستخدم لتزييت محرك الاحتراق الداخلي)",
 "オイルペインティング": "لَوْحَة زَيْتِيَة",
 "オイルペイント": "طلاء زيتي (طلاء يكون الزيت الجاف هو الوسيط فيه)",
 "オイルポンプ": "مضخة زيت (مضخة تحافظ على إمداد الزيت للأجزاء المتحركة)",
 "オイルランプ": "مِصْبَاح زَيْتِيّ (كل ما يستضاء به، منه الفانوس والقنديل والنبراس والسراج والمشكاة؛ جهاز كهربائي يُسْتَضَاءُ بِه، مِصْبَاح كَهْرَبَائِيّ)\nمثال: ليس كل مصباح سحريا.",
 "オイル・カラー": "زيت, لون زيتي (طلاء زيتي يحتوي على صبغة يستخدمه الفنانون) / طلاء زيتي (طلاء يكون الزيت الجاف هو الوسيط فيه)",
 "オイル・クロス": "مُشَمَّع",
 "オイル・クロース": "مُشَمَّع",
 "オイル・シェール": "سجيل زيتي, طفل صفحي زيتي (طفل صفحي يمكن الحصول منه على النفط بالتسخين)",
 "オイル・ステイン": "بقعة زيت (بقعة ناتجة عن الزيت)",
 "オイル・バーナー": "حارق نفط, فرن نفطي (فرن يحرق النفط)",
 "オイル・フィルター": "مرشح زيت (مرشح يزيل الشوائب من الزيت المستخدم لتزييت محرك الاحتراق الداخلي)",
 "オイル・ペインティング": "لَوْحَة زَيْتِيَة",
 "オイル・ペイント": "طلاء زيتي (طلاء يكون الزيت الجاف هو الوسيط فيه)",
 "オイル・ポンプ": "مضخة زيت (مضخة تحافظ على إمداد الزيت للأجزاء المتحركة)",
 "オイル・ランプ": "مِصْبَاح زَيْتِيّ (كل ما يستضاء به، منه الفانوس والقنديل والنبراس والسراج والمشكاة؛ جهاز كهربائي يُسْتَضَاءُ بِه، مِصْبَاح كَهْرَبَائِيّ)\nمثال: ليس كل مصباح سحريا.",
 "オイル交換": "تغيير الزيت (استبدال الزيت المتسخ بآخر نظيف)",
 "オイル語": "الفرنسية القديمة (أقدم شكل للغة الفرنسية؛ من القرن التاسع إلى الخامس عشر)",
 "オウギガイ": "محار عملاق (محار كبير يسكن الشعاب المرجانية في جنوب المحيط الهادئ ويزن ما يصل إلى 500 رطل)",
 "オウギバショウ": "رافينالا, شجرة المسافر (نبات عملاق يشبه الشجرة له جوز صالح للأكل وأعناق أوراق تنتج مشروباً منعشاً من عصارة مائية صافية؛ يشاع أنه مصدر طوارئ للمياه للمسافرين)",
 "オウギヤシ": "دوم, نخلة تدمر (نخيل مروحي طويل من أفريقيا والهند وماليزيا ينتج خشباً صلباً وعصارة حلوة تعد مصدراً لنبيذ النخيل والسكر؛ وتستخدم الأوراق للتسقيف والنسيج)",
 "オウギワシ": "عقاب هاربي (عقاب كبيرة سوداء وبيضاء متوجة من أمريكا الاستوائية)",
 "オウサマペンギン": "بطريق ملك (بطريق كبير في الجزر المحاذية للدائرة القطبية الجنوبية)",
 "オウシュウアカマツ": "صنوبر اسكتلندي, صنوبر بري (صنوبر متوسط الكبر ثنائي الإبر من شمال أوروبا وآسيا له لحاء أحمر بني متقشر)",
 "オウシュウシラカンバ": "بتولا بيضاء أوروبية, بتولا فضية (بتولا أوروبية بلحاء أبيض فضي مقشر وفروع متدلية بشكل ملحوظ)",
 "オウシュウトウヒ": "تنوب نرويجي (تنوب هرمي طويل موطنه شمال أوروبا له أوراق خضراء داكنة على فروع منتشرة بغصينات متدلية ومخاريط طويلة متدلية)",
 "オウシュウナラ": "بلوط شائع, سنديان إنجليزي (سنديان أوروبي نفضي متوسط إلى كبير الحجم، له أوراق ناعمة ذات فصوص مستديرة؛ ينتج خشباً صلباً قوياً فاتح اللون)",
 "オウバイ": "ياسمين شتوي (شجيرة متسلقة متساقطة الأوراق تُزرع على نطاق واسع لزهورها الصفراء التي تتفتح في الشتاء)",
 "オウム": "بَبَّغَاء (طائر من فصيلة كبيرة من الطيور ذوات ألوان زاهية قادرة على تقليد صوت كلام الإنسان دون القدرة على التواصل بالكلام)",
 "オウムガイ": "نوتي (رأسيات الأرجل في المحيطين الهندي والهادئ لها صدفة حلزونية ذات حواجز لؤلؤية شاحبة)",
 "オウム病": "حمى الببغاء, داء الببغائية (التهاب رئوي لانمطي يسببه كائن دقيق من الريكيتسيا وينتقل إلى البشر من الطيور المصابة) / حمى الببغاء, داء الببغائية (مرض معد يصيب الطيور)",
 "オウラフィン": "ألكين, أوليفين (أي هيدروكربون أليفاتي غير مشبع)",
 "オウル": "قِرْش, عُمْلَة",
 "オウレン": "خيط الذهب, كوبتيس (نبات معمر منخفض النمو في غابات أمريكا الشمالية له أوراق ثلاثية وساق جذري أصفر وأزهار بيضاء)",
 "オウロ": "قِرْش, عُمْلَة",
 "オウンゴール": "هدف ذاتي, هدف عكسي (جاء إلى الهَدَف؛ ارتفع عن الأرض)\nمثال: لقد أخطأ الهدف.",
 "オウン・ゴール": "هدف ذاتي, هدف عكسي (جاء إلى الهَدَف؛ ارتفع عن الأرض)\nمثال: لقد أخطأ الهدف.",
 "オオアメリカモモンガ": "سنجاب طائر شمالي (سنجاب طائر كبير؛ بشكل رئيسي من كندا)",
 "オオアリクイ": "آكل النمل العملاق (آكل نمل كبير أشعث الشعر وعديم الأسنان ذو لسان طويل ومخالب قوية؛ من أمريكا الجنوبية)",
 "オオアルマジロ": "مدرع عملاق (يبلغ طوله حوالي ثلاثة أقدام باستثناء الذيل)",
 "オオアワガエリ": "تِيمُوثَاوُس",
 "オオイヌノフグリ": "بَانُورَامِيّ, مِنْ عَلُوّ (كما يُرى من ارتفاع أو مسافة بعيدة)",
 "オオイヌフグリ": "بَانُورَامِيّ, مِنْ عَلُوّ (كما يُرى من ارتفاع أو مسافة بعيدة)",
 "オオウミガラス": "أوك عظيم (طائر أوك كبير لا يطير من الجزر الصخرية قبالة سواحل شمال الأطلسي؛ منقرض)",
 "オオカバマダラ": "فراشة الصقلاب, فراشة الملك (فراشة أمريكية مهاجرة كبيرة لها أجنحة برتقالية عميقة بعلامات سوداء وبيضاء؛ تتغذى اليرقات على الصقلاب)",
 "オオカミ": "ذِئْب (حيوان مفترس من فصيلة الكلاب يعيش في جماعات وأكثر ما يصطاد في الليل؛ صفة تطلق على الرجل الذي يخدع النساء ليحصل على مراده منهن بالدهاء) / ديب / ذيب / اِلْتَهَمَ بِشَرَاهَة\nمثال: نظرة الذئب للشاة. / ذِئْبٌ فِي ثَوْبِ حَمَلٍ (حيوان مفترس من فصيلة الكلاب يعيش في جماعات وأكثر ما يصطاد في الليل؛ صفة تطلق على الرجل الذي يخدع النساء ليحصل على مراده منهن بالدهاء)\nمثال: نظرة الذئب للشاة.",
 "オオカミ男": "مُسْتَذْئِب, مُسْتَذْئِبَة",
 "オオカンガルー": "كنغر رمادي شرقي, كنغر عملاق (كنغر أسترالي بني رمادي كبير جداً كان وفيراً سابقاً في المناطق المشجرة المفتوحة)",
 "オオキンケイギク": "أشرفية, بذر القراد",
 "オオクチバス": "قاروص كبير الفم (قاروص أسود كبير؛ تقع زاوية الفك خلف العين) / باس كبير الفم (لحم سمكة الباس كبير الفم)",
 "オオクログワイ": "كستناء الماء, كستناء الماء الصينية (سعد صيني ينتج درنات صالحة للأكل على شكل بصيلة)",
 "オオグチバス": "قاروص كبير الفم (قاروص أسود كبير؛ تقع زاوية الفك خلف العين) / باس كبير الفم (لحم سمكة الباس كبير الفم)",
 "オオケタデ": "بطباط شرقي, ريشة الأمير (نبات حولي بأوراق بيضاوية عريضة وسنابل متدلية رفيعة من الزهور القرمزية؛ جنوب شرق آسيا وأستراليا؛ توطن في أمريكا الشمالية)",
 "オオコウモリ": "خفاش الفاكهة (خفاش كبير من العالم القديم في المناطق الدافئة والاستوائية يتغذى على الفاكهة)",
 "オオジカ": "مُوظ",
 "オオジュリン": "درسة القصب (طائر درسة أوروبي يسكن المناطق المستنقعية)",
 "オオタカ": "باز شمالي / صَقَارَة",
 "オオチョウザメ": "بيلوغا, حوت أبيض (حوت شمالي صغير يكون لونه أبيض عند البلوغ) / بيلوغا (مصدر قيم للكافيار والجيلاتين السمكي؛ توجد في البحر الأسود وبحر قزوين)",
 "オオツチグモ": "رُتَيْل",
 "オオツノヒツジ": "الضأن كبير القرون, كباش الجبال الصخرية (خروف بري في المناطق الجبلية بغرب أمريكا الشمالية له قرون ضخمة ملتوية)",
 "オオトカゲ": "وَرَل",
 "オオトリテエ": "سُلْطَة (هو طعام يصنع من الخُضَار الطَازَجَة تقطع وتخلط ويضاف إليها المِلْح وقد يضاف عصير اللَيْمُون أو الخَلّ أو الزَيْت. لا يطبخ)\nمثال: هو متعطش للسلطة.",
 "オオハクチョウ": "تم ناعق (بجعة شائعة في العالم القديم تشتهر بندائها الناعق)",
 "オオハシ": "طُوقَان",
 "オオハシウミガラス": "موسوي المنقار (طائر أوك أسود وأبيض من شمال الأطلسي ذو منقار مضغوط حاد الحواف)",
 "オオバコ": "لِسَان الْحَمَل, لِسَان الْخَرُوف (فِي : جسم لحميّ مستطيل متحرك، يكون في الفم، ويصلح للتّذوُّق والبلع، وللنطق؛ جَارِحَة الْكَلَام؛ كَلِمَة)\nمثال: ماري لها فم ليس لها لسان.",
 "オオバン": "غُرَّة (بياض في جبهة الفرس فوق العينين أو بينهما وتحت الأذنين. انظر الصورة؛ أول يوم في الشهر، أو ليلة اِسْتِهْلَال القمر)",
 "オオフクロモモンガ": "رَعْدِيد, هَيَّاب (سَرِيع الخَوْف وسَهْل الإِفْزَاع)",
 "オオフルマカモメ": "نوء عملاق (طائر نوء بني كبير يوجد بشكل رئيسي في بحار القطب الجنوبي)",
 "オオミズアオ": "عثة الإمبراطور (عثة كبيرة من الغابات المعتدلة في أوراسيا ذات أجنحة شفافة كثيفة القشور)",
 "オオミミギツネ": "لَوْشَب",
 "オオムギ": "شَعِير",
 "オオメジロザメ": "قرش الثور (أكثر أنواع القرش شيوعاً في المياه الساحلية المعتدلة والاستوائية حول العالم؛ ضخم الجسم وخطير)",
 "オオモズ": "صرد شمالي (طائر صرد من شمال أمريكا الشمالية)",
 "オオヤマネコ": "وَشَق",
 "オオルリソウ": "لسان الكلب المخزني (شجيرة ثنائية الحول في أوروبا وغرب آسيا لها أوراق خشنة على شكل لسان وأزهار حمراء أرجوانية داكنة) / لسان الكلب الفرجيني (شجيرة معمرة في أمريكا الشمالية لها أوراق خشنة على شكل لسان وأزهار زرقاء شاحبة إلى أرجوانية)",
 "オカシイ": "مُضْحِك, هَزْلِيّ / غَرِيب, عَجِيب / أَجْنَبِيّ, غَرِيب / مُخْطِئ / ظَلَمَ (الثَلَاثُ الظُلَم: الليلة التاسعة عشر، والعشرون، والحادية والعشرون من كل شهر قمري، وسميت بذلك لظلمتها. يسبقها الثلاث الدُرَع ويليها الثلاث الحنادس)\nمثال: نحن نرفض الظلم. / مُريب, مَشبوه",
 "オカズ": "طبق جانبي (طبق يُقدم مع الطبق الرئيسي ولكنه تابع له) / مَلَأَ",
 "オカチメンコ": "امرأة قبيحة, عجوز شمطاء (امرأة قبيحة أو سيئة المزاج)\nمثال: كان يتودد لتلك العجوز الشمطاء طمعاً في مالها",
 "オカトラノオ": "ليسيماكيا عنق الإوزة (صنف من عشبة الليسيماكيا)",
 "オカピ": "أوكابي (يشبه الزرافة ولكنه أصغر وله رقبة أقصر بكثير وخطوط على الأرجل)",
 "オカマ": "قِدْر (قضاء الله وحكمه وما قَدَّرَه؛ مبلغ الشيء وكميتّه، بنفس معنى قَدْر) / إِنَاء / طَنْجَرَة / حَلَّة (المرة الواحدة من الحُلول، أي النزول؛ الزنبيل الكبير من القصب) / قِدِر (قضاء الله وحكمه وما قَدَّرَه؛ مبلغ الشيء وكميتّه، بنفس معنى قَدْر) / حلَّة (المرة الواحدة من الحُلول، أي النزول؛ الزنبيل الكبير من القصب)\nمثال: خذ قدر ما تريد. / فَوَّهَةُ الْبُرْكَان, فَوَّهَة / فَوَّهَةُ الْبُرْكَان / أرداف, ألية (الجزء اللحمي من جسم الإنسان الذي يجلس عليه)\nمثال: يستحق ركلة جيدة في مؤخرته / رجل مثلي (رجل مثلي الجنس)",
 "オカマを掘る": "لوطي (شخص يمارس اللواط)",
 "オカメインコ": "كُوكَاتِيل",
 "オカヨシガモ": "بط سماري ((بَطَّ) الْقُرْحَةَ شَقَّهَا)\nمثال: ذهب لاصطياد البط.",
 "オカリナ": "أكرين",
 "オカルチック": "تَنْجِيمِيَّة",
 "オカルティズム": "تنجيم, علوم خفية (اعتقاد بوجود قوى خارقة للطبيعة وإمكانية إخضاعها للسيطرة البشرية) / التنجيم, العلوم الخفية (دراسة ما وراء الطبيعة أو القوى الخارقة)",
 "オカルティック": "تَنْجِيمِيَّة",
 "オカルト": "تَنْجِيمِيَّة",
 "オカレンコン": "بَامْيَة, بَامْيَا",
 "オカン": "أمي, ماما (مصطلحات غير رسمية للأم)",
 "オガネソン": "أُوغَانِيسُون",
 "オガワコマッコウ": "حوت العنبر القزمي (حوت عنبر صغير جداً (يصل إلى 8 أقدام) يعيش في السواحل الوسطى للمحيط الأطلسي والهادئ)",
 "オキアミ": "كريل (قشريات عوالق تشبه الروبيان؛ مصدر رئيسي للغذاء للحيتان البالينية مثلاً)",
 "オキエソ": "سمكة السحلية (أسماك استوائية ذات أفواه كبيرة في رؤوس تشبه السحالي؛ توجد في جميع أنحاء العالم)",
 "オキサイド": "أُكْسِيد",
 "オキサロさくさん": "حمض أكسالوأسيتيك (حمض يتكون من أكسدة حمض الماليك (كما في استقلاب الدهون والكربوهيدرات))",
 "オキサロ酢酸": "حمض أكسالوأسيتيك (حمض يتكون من أكسدة حمض الماليك (كما في استقلاب الدهون والكربوهيدرات))",
 "オキシゲナーゼ": "أكسيجيناز (أوكسيدوريدوكتاز يحفز دمج الأكسجين الجزيئي)",
 "オキシジェン": "أُكْسِجِين",
 "オキシダント": "عامل مؤكسد, مؤكسد (مادة تقوم بأكسدة مادة أخرى)",
 "オキシダーゼ": "أوكسيداز (أي من الإنزيمات التي تحفز الأكسدة البيولوجية)",
 "オキシテトラサイクリン": "أوكسي تتراسيكلين, تيراميسين (مضاد حيوي بلوري أصفر (العلامة التجارية تيراميسين) يتم الحصول عليه من شعيات التربة؛ يستخدم لعلاج الالتهابات البكتيرية والريكتسية المختلفة)",
 "オキシトシン": "أوكسيتوسين (هرمون تفرزه الغدة النخامية الخلفية؛ يحفز تقلصات الرحم وإدرار الحليب)",
 "オキシド": "أُكْسِيد",
 "オキシドレダクターゼ": "أوكسيدوريدوكتاز (إنزيم يحفز الأكسدة والاختزال)",
 "オキシドール": "بيروكسيد, بيروكسيد الهيدروجين (سائل لزج ذو خصائص أكسدة قوية؛ عامل تبييض قوي؛ يستخدم أيضاً (في المحاليل المائية) كمطهر خفيف، وفي (التركيزات القوية) كمؤكسد في وقود الصواريخ) / بيروكسيد",
 "オキシヘモグロビン": "أوكسي هيموغلوبين, هيموغلوبين مؤكسج (الهيموغلوبين الأحمر الساطع الذي يتكون من اتحاد الهيموغلوبين والأكسجين من الرئتين)\nمثال: ينقل الأوكسي هيموغلوبين الأكسجين إلى خلايا الجسم",
 "オキシメーター": "مقياس التأكسج (أداة قياس تقيس الأكسجين في الدم الشرياني)",
 "オキナグサ": "أُقْحُوَان / صَنَوْبَر, صنوبر",
 "オキナワベニハゼ": "أَحْمَر بُرْتُقَالِيّ (أحمر مع مسحة برتقالية)",
 "オキナワヤマイモ": "يام أبيض, يام الماء (يزرع في أسترالاسيا وبولينيزيا لجذره الكبير ذو اللحم الأبيض الناعم الصالح للأكل)",
 "オキナワン": "لُغَة أُوكِينَاوَا (هِيَ مجموعة من الأصوات التي يصدرها الإنسان على شكل كلمات منظمة بقواعد، ليتواصل به الناس وينقلون به الافكار والمعاني، اللسان؛ يقصد بها أحيانا اللهجة)\nمثال: الأمازيغية لغة.",
 "オキニ": "مَحْبُوب, مُفَضَّل (يروق لعامة الناس ويستهويهم) / مفضل (شيء يحظى بتفضيل أو إعجاب خاص) / حبيب, مفضل (شخص محبوب مميز) / مرشح للفوز, مفضل (منافس يُعتقد أنه من المرجح أن يفوز)\nمثال: هذا الكتاب هو أحد مفضلاتي",
 "オキュパイド": "مَحْجُوز / مَشْغُول / مُحْتَلّ",
 "オキュペイション": "وَظِيفَة, مِهْنَة (ما يُقَدَّر من الشيء في زمن مُعَيَّن؛ مَنْصِب) / اِحْتِلال, إِشْغَال (احتلّ: نزل؛ احتلّ به واحتلّه: نزل به، واحتلّ الشيء: اتّخذه حلالاً)\nمثال: ما وظيفة زوجتك؟",
 "オキュペーショナルセラピー": "علاج بالعمل, علاج وظيفي (علاج يعتمد على المشاركة في أنشطة ذات مغزى من الحياة اليومية، لتمكين المشاركة في مثل هذه الأنشطة على الرغم من القصور أو القيود في الوظائف الجسدية أو…)",
 "オキュペーショナル・セラピー": "علاج بالعمل, علاج وظيفي (علاج يعتمد على المشاركة في أنشطة ذات مغزى من الحياة اليومية، لتمكين المشاركة في مثل هذه الأنشطة على الرغم من القصور أو القيود في الوظائف الجسدية أو…)",
 "オキュペーション": "وَظِيفَة, مِهْنَة (ما يُقَدَّر من الشيء في زمن مُعَيَّن؛ مَنْصِب) / اِحْتِلال, إِشْغَال (احتلّ: نزل؛ احتلّ به واحتلّه: نزل به، واحتلّ الشيء: اتّخذه حلالاً)\nمثال: ما وظيفة زوجتك؟",
 "オギノしき": "طريقة التقويم, طريقة العد (تنظيم الأسرة الطبيعي الذي يُفترض فيه حدوث الإباضة قبل 14 يوماً من بدء الدورة الشهرية)",
 "オギノ式": "طريقة التقويم, طريقة العد (تنظيم الأسرة الطبيعي الذي يُفترض فيه حدوث الإباضة قبل 14 يوماً من بدء الدورة الشهرية)",
 "オギャー": "بَاكٍ / بُكَاء",
 "オク": "مَزَاد, مُزَايَدَة",
 "オクシデンタリズム": "استغراب, طابع غربي (الصفات أو العادات أو السلوكيات المميزة للحضارات الغربية) / استغراب (المعرفة العلمية بالثقافات واللغات والشعوب الغربية)",
 "オクシデンタル": "أُوكْسِيدَنْتَالِيّ, غَرْبِيّ (يدلّ على دول أوروبا ونصف الكرة الغربي أو يتّسم بخصائصها) / أوكسيدنتال, اللغة الغربية (لغة مساعدة دولية مخطط لها أنشأها إدغار دي فال، ونُشرت عام 1922) / غربي (ساكن أصلي من الغرب)",
 "オクシデント": "المغرب, نصف الكرة الغربي (نصف الكرة الذي يشمل أمريكا الشمالية وأمريكا الجنوبية)",
 "オクシモロン": "أوكسيمورون, تضاد ظاهري (الجمع بين مصطلحات متناقضة)",
 "オクスフォード": "أُكْسْفُورْد",
 "オクスブリッジ": "أوكسبريدج (مصطلح عام لجامعة عريقة ومرموقة ومميزة (خاصة جامعة أكسفورد أو جامعة كامبريدج))",
 "オクタボ": "قطع ثُماني (حجم كتاب تُصنع صفحاته بطي ورقة ثلاث مرات لتكوين ثماني ورقات)",
 "オクタン": "أُوكْتَان",
 "オクタンさん": "حمض الكابريليك (حمض دهني له طعم زنخ؛ يوجد في الزبدة والدهون والزيوت الأخرى)",
 "オクタン酸": "حمض الكابريليك (حمض دهني له طعم زنخ؛ يوجد في الزبدة والدهون والزيوت الأخرى)",
 "オクターブ": "مقطع ثماني (مجموعة إيقاعية من ثمانية أبيات شعرية) / أوكتاف, جواب (فاصل موسيقي مكون من ثماني نغمات) / أوكتاف (يوم العيد والأيام السبعة التي تليه)",
 "オクターボ": "قطع ثُماني (حجم كتاب تُصنع صفحاته بطي ورقة ثلاث مرات لتكوين ثماني ورقات)",
 "オクターヴ": "مقطع ثماني (مجموعة إيقاعية من ثمانية أبيات شعرية) / أوكتاف, جواب (فاصل موسيقي مكون من ثماني نغمات) / أوكتاف (يوم العيد والأيام السبعة التي تليه)",
 "オクテット": "أوكتيت, ثماني (تأليف موسيقي لثمانية مؤديين) / ثماني, مجموعة ثمانية (ثمانية أشخاص يُنظر إليهم كوحدة واحدة) / ثماني (مجموعة من ثمانية أشياء متشابهة تُعتبر كوحدة واحدة) / ثماني (ثمانية مؤدين أو مغنين يؤدون معاً)",
 "オクトバー": "أَكْتُوبَر, تِشْرِين الْأَوَّل (الشهر العاشر في السنة الميلادية الروميّة)\nمثال: أراك في شهر أكتوبر.",
 "オクトパス": "أُخْطُبُوط, أَخْطَبُوط (الأُخْطُبُوْط حَيَوَانٌ بَحْرِيٌّ مِنْ فَصِيلَةِ الرِّخْوِيَّاتِ، لَهُ ثَمَانِي أرجُلِ فِي رَأْسِهِ، فِيهَا مَحَاكِم يَلْتَصِقُ بِهَا…؛ الأُخْطُبوط : حيوان بَحْريّ من الرِّخْويَّات له ثماني أرجلٍ رأْسية، يضرب به المثل في شُدة التشبُّث بما يمسكه)",
 "オクトーバー": "أَكْتُوبَر, تِشْرِين الْأَوَّل (الشهر العاشر في السنة الميلادية الروميّة)\nمثال: أراك في شهر أكتوبر.",
 "オクラ": "بَامْيَة, بَامْيَا / أَلْغَى, أَبْطَلَ",
