 "オーソグラフィー": "إِمْلَاء (الاسم من قراءة الشيء على أحد ما حتى يكتبه كما قُرِأ؛ الأمر بأشياء بدون السماح للمأمور بالمخالفة كأنه يُمْلِي عليه شيئا ليكتب) / عِلْم الْإِمْلَاء, هِجَاء (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "オーソスコープ": "منظار تقويم (منظار عين بطبقة من الماء لتحييد انكسار القرنية)",
 "オーソドキシー": "أُرْثُوذُكْسِيَّة (أرثوذكسيَّة)",
 "オーソドクス": "أُرْثُوذُكْسِيّ",
 "オーソドックス": "أُرْثُوذُكْسِيّ",
 "オーソライズ": "إذن, تفيوض (فعل منح الشرعية أو الإقرار أو التفويض الرسمي) / تفويض, سلطة (إذن رسمي أو موافقة) / تفويض, سلطة (القوة أو الحق في إصدار الأوامر أو اتخاذ القرارات) / تفويض, توكيل (وثيقة تعطي تعليمات أو أمراً رسمياً)\nمثال: تم تجديد التفويض للبرنامج عدة مرات",
 "オーソライゼーション": "إذن, تفيوض (فعل منح الشرعية أو الإقرار أو التفويض الرسمي) / تفويض, سلطة (إذن رسمي أو موافقة) / تفويض, سلطة (القوة أو الحق في إصدار الأوامر أو اتخاذ القرارات) / تفويض, توكيل (وثيقة تعطي تعليمات أو أمراً رسمياً)\nمثال: تم تجديد التفويض للبرنامج عدة مرات",
 "オーソリゼーション": "إذن, تفيوض (فعل منح الشرعية أو الإقرار أو التفويض الرسمي) / تفويض, سلطة (إذن رسمي أو موافقة) / تفويض, سلطة (القوة أو الحق في إصدار الأوامر أو اتخاذ القرارات) / تفويض, توكيل (وثيقة تعطي تعليمات أو أمراً رسمياً)\nمثال: تم تجديد التفويض للبرنامج عدة مرات",
 "オーソリティ": "سُلْطَة (هو طعام يصنع من الخُضَار الطَازَجَة تقطع وتخلط ويضاف إليها المِلْح وقد يضاف عصير اللَيْمُون أو الخَلّ أو الزَيْت. لا يطبخ)\nمثال: هو متعطش للسلطة.",
 "オーソリティー": "سُلْطَة (هو طعام يصنع من الخُضَار الطَازَجَة تقطع وتخلط ويضاف إليها المِلْح وقد يضاف عصير اللَيْمُون أو الخَلّ أو الزَيْت. لا يطبخ)\nمثال: هو متعطش للسلطة.",
 "オータナティブ": "بَدِيلِيّ, تَخْيِيرِيّ (يَسْتَلْزِمُ الِاخْتِيَارَ بَيْنَ احْتِمَالَاتٍ مُتَنَافِيَةٍ) / بَدِيل (يَتَعَلَّقُ بِخِيَارَاتٍ غَيْرِ تَقْلِيدِيَّة) / بَدِيل (يُستخدَم أو يَخدُم مكان شيء آخر) / بديل, خيار (واحد من عدد من الأشياء التي يمكن اختيار واحد منها فقط)\nمثال: ما الخيار الذي كان لدي؟",
 "オータム": "خَرِيف, خريف (فصل من فصول السَّنَة الأربعة، بعد الصَّيْف وقبل الشِّتَاء؛ سَنَة)\nمثال: نحن في الخريف الآن.",
 "オーダ": "تَرْتِيب, نِظَام (تنظيم الأشياء أو الأحداث في تسلسل معين أو وضعها في نظام؛ إعداد أو تجهيز شيء لتحقيق غاية معينة) / أَمْر, حُكْم (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة) / طَلَب (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى)) / جَمَاعَة (العَدَد الكثير من النَاس أو الحَيْوَان أو النَبَات أو غيره. المَجْمُوعَة؛ طَائِفَة من الناس التي يجمعها مكان و بيئة واحدة أو تتشارك اهداف و غايات واحدة) / وِسَام / رُتْبَة (رُتْبَة، بضم الراء؛ رَتْبَة، بفتح الراء) / أَمَرَ (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة) / طَلَبَ, حَجَزَ (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى))\nمثال: أعاد زيري ترتيب المطبخ كلية.",
 "オーダシティ": "جُرْأَة, وَقَاحَة",
 "オーダー": "تَرْتِيب, نِظَام (تنظيم الأشياء أو الأحداث في تسلسل معين أو وضعها في نظام؛ إعداد أو تجهيز شيء لتحقيق غاية معينة) / أَمْر, حُكْم (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة) / طَلَب (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى)) / جَمَاعَة (العَدَد الكثير من النَاس أو الحَيْوَان أو النَبَات أو غيره. المَجْمُوعَة؛ طَائِفَة من الناس التي يجمعها مكان و بيئة واحدة أو تتشارك اهداف و غايات واحدة) / وِسَام / رُتْبَة (رُتْبَة، بضم الراء؛ رَتْبَة، بفتح الراء) / أَمَرَ (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة) / طَلَبَ, حَجَزَ (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى))\nمثال: أعاد زيري ترتيب المطبخ كلية.",
 "オーダーひん": "مُفَصَّلٌ حَسَبَ الطَّلَبِ ((عن الملابس) مصنوع حسب المقاس والطلب) / مَبْنِيٌّ حَسَبَ الطَّلَبِ (مُشيَّد خصيصاً لفرد معيَّن)",
 "オーダースーツ": "مُفَصَّلٌ حَسَبَ الطَّلَبِ ((عن الملابس) مصنوع حسب المقاس والطلب) / ملابس مفصلة (ملابس مصنوعة حسب الطلب)",
 "オーダーメイド": "مُفَصَّلٌ حَسَبَ الطَّلَبِ ((عن الملابس) مصنوع حسب المقاس والطلب) / مَبْنِيٌّ حَسَبَ الطَّلَبِ (مُشيَّد خصيصاً لفرد معيَّن)",
 "オーダーメード": "مُفَصَّلٌ حَسَبَ الطَّلَبِ ((عن الملابس) مصنوع حسب المقاس والطلب) / مَبْنِيٌّ حَسَبَ الطَّلَبِ (مُشيَّد خصيصاً لفرد معيَّن)",
 "オーダー・スーツ": "مُفَصَّلٌ حَسَبَ الطَّلَبِ ((عن الملابس) مصنوع حسب المقاس والطلب) / ملابس مفصلة (ملابس مصنوعة حسب الطلب)",
 "オーダー・メイド": "مُفَصَّلٌ حَسَبَ الطَّلَبِ ((عن الملابس) مصنوع حسب المقاس والطلب) / مَبْنِيٌّ حَسَبَ الطَّلَبِ (مُشيَّد خصيصاً لفرد معيَّن)",
 "オーダー・メード": "مُفَصَّلٌ حَسَبَ الطَّلَبِ ((عن الملابس) مصنوع حسب المقاس والطلب) / مَبْنِيٌّ حَسَبَ الطَّلَبِ (مُشيَّد خصيصاً لفرد معيَّن)",
 "オーダー品": "مُفَصَّلٌ حَسَبَ الطَّلَبِ ((عن الملابس) مصنوع حسب المقاس والطلب) / مَبْنِيٌّ حَسَبَ الطَّلَبِ (مُشيَّد خصيصاً لفرد معيَّن)",
 "オーチャード": "بُسْتَان, بَيَارَة (أَرْض يحيطها سُوْر وفيها نخيل متفرقة وأعناب وأشجار، تستخدم في الأساس للحصول على منتوجها من الفَاكِهَة والثَمَر. الجَنَّة)\nمثال: أحب سقي البستان.",
 "オーチャードグラス": "إصبعية متكتلة, عشب البساتين (عشب قش ومرعى قوي من العالم القديم يُزرع على نطاق واسع)",
 "オーチャード・グラス": "إصبعية متكتلة, عشب البساتين (عشب قش ومرعى قوي من العالم القديم يُزرع على نطاق واسع)",
 "オーツ": "شُوفَان, خَرْطَال",
 "オーティー": "وَقْت إِضَافِيّ (\"بَقِيَ وَقْتاً عِنْدَهُ \" : أَيْ مِقْدَاراً مِنَ الزَّمَنِ؛ \"جَاءَ فِي الوَقْتِ الْمُنَاسِبِ \" : فِي اللَّحْظَةِ الْمُنَاسِبَةِ)\nمثال: حان وقت الذهاب. / اَلْعَهْد اَلْقَدِيم",
 "オーティーシー": "دواء بدون وصفة طبية, دواء لا يستلزم وصفة طبية (دواء يباع بدون وصفة طبية)",
 "オーティーシーやく": "دواء بدون وصفة طبية, دواء لا يستلزم وصفة طبية (دواء يباع بدون وصفة طبية)",
 "オーディエンス": "جُمْهُور, نَظَّارَة",
 "オーディオ": "سَمْعِيّ, أُودْيُو",
 "オーディオアンプ": "مضخم صوت (مضخم يزيد من سعة الصوت المعاد إنتاجه)",
 "オーディオテープ": "شريط صوتي (شريط مغناطيسي للاستخدام في تسجيل الصوت) / شريط صوتي (شريط تسجيل للصوت)",
 "オーディオビジュアル": "سمعي بصري (يتضمن كلاً من السمع والرؤية (يتعلق عادةً بالوسائل التعليمية)) / مادة سمعية بصرية, وسيلة سمعية بصرية (مواد تستخدم البصر أو الصوت لتقديم المعلومات)\nمثال: القسم السمعي البصري بالمدرسة",
 "オーディオブック": "كِتَاب مَسْمُوع, كِتَاب سَمْعِيّ (موضع تعليم الكتابة. الاستخدام الأصلي؛ مدرسة شبه رسمية لتعليم الأطفال الكِتَابَة والقِرَاءَة ومباديء الحِسَاب وبعض القُرَآن…)\nمثال: هذا الكتاب جديد",
 "オーディオマニア": "عَالِي الدِّقَّة (يتّسم بالحدّ الأدنى من التشويه في إعادة إنتاج الصوت) / دقة عالية (إعادة إنتاج الصوت مع قليل من التشويه أو بدونه) / نظام صوت عالي الدقة, هاي فاي (معدات لاستنساخ الصوت بدقة عالية)",
 "オーディオメーター": "مقياس السمع (أداة تستخدم لقياس حساسية السمع)",
 "オーディオ・アンプ": "مضخم صوت (مضخم يزيد من سعة الصوت المعاد إنتاجه)",
 "オーディオ・テープ": "شريط صوتي (شريط مغناطيسي للاستخدام في تسجيل الصوت) / شريط صوتي (شريط تسجيل للصوت)",
 "オーディオ・ビジュアル": "سمعي بصري (يتضمن كلاً من السمع والرؤية (يتعلق عادةً بالوسائل التعليمية)) / مادة سمعية بصرية, وسيلة سمعية بصرية (مواد تستخدم البصر أو الصوت لتقديم المعلومات)\nمثال: القسم السمعي البصري بالمدرسة",
 "オーディオ・ブック": "كِتَاب مَسْمُوع, كِتَاب سَمْعِيّ (موضع تعليم الكتابة. الاستخدام الأصلي؛ مدرسة شبه رسمية لتعليم الأطفال الكِتَابَة والقِرَاءَة ومباديء الحِسَاب وبعض القُرَآن…)\nمثال: هذا الكتاب جديد",
 "オーディオ・マニア": "عَالِي الدِّقَّة (يتّسم بالحدّ الأدنى من التشويه في إعادة إنتاج الصوت) / دقة عالية (إعادة إنتاج الصوت مع قليل من التشويه أو بدونه) / نظام صوت عالي الدقة, هاي فاي (معدات لاستنساخ الصوت بدقة عالية)",
 "オーディション": "تَجْرِبة أَدَاء",
 "オーディトリアム": "صالة العرض, قاعة الجمهور (منطقة المسرح أو قاعة الحفلات الموسيقية حيث يجلس الجمهور)",
 "オーディナリー": "عَادِيّ, مَأْلُوف",
 "オーディー": "جُرْعَة زَائِدَة / عين يمنى (العين اليمنى) / دكتوراه في البصريات (درجة الدكتوراه في البصريات) / سحب على المكشوف (سحب يتجاوز الرصيد الدائن)",
 "オーデコロン": "كولونيا, ماء الكولونيا (سائل معطر مصنوع من الزيوت الأساسية والكحول)",
 "オート": "سيارة, مركبة (مركبة آلية بأربع عجلات؛ تدفع عادة بمحرك احتراق داخلي)\nمثال: إنه يحتاج إلى سيارة للذهاب إلى العمل / شُوفَان, خَرْطَال",
 "オートじゅう": "سلاح آلي, سلاح ناري أوتوماتيكي (سلاح ناري يعيد تحميل نفسه ويستمر في إطلاق النار حتى يتم تحرير الزناد)",
 "オートむぎ": "شُوفَان",
 "オートキャンプ": "تخييم بالكرفان, سياحة القوافل (ممارسة قضاء العطلات في عربة مقطورة (كرفان))",
 "オートキュイジーヌ": "الطهي الراقي, المطبخ الرفيع ((فرنسي) أسلوب متقن وماهر في إعداد الطعام)",
 "オートクチュール": "أزياء راقية, هوت كوتور (أزياء تحدد اتجاهات الموضة)",
 "オートクラシー": "أُوتُوقْرَاطِيَّة, اِسْتِبْدَاد",
 "オートクレーブ": "أوتوكلاف, جهاز تعقيم بالبخار المضغوط (جهاز لتسخين المواد فوق درجة غليانها؛ يستخدم لتصنيع المواد الكيميائية أو لتعقيم الأدوات الجراحية)",
 "オートケーキ": "كعكة الشوفان (كعكة مسطحة رقيقة غير مخمرة من دقيق الشوفان المخبوز)",
 "オートコレクト": "تصحيح تلقائي (نظام لتصحيح النص تلقائياً)",
 "オートジャイロ": "أوتوجيرو, طائرة دوارة (طائرة تُدعم في الطيران بواسطة أجنحة أفقية (أو شفرات) دوارة غير مزودة بالطاقة؛ ويتم توفير الدفع الأمامي بواسطة مروحة تقليدية)",
 "オートチェンジャー": "مبدل الأسطوانات (جهاز ميكانيكي أوتوماتيكي في مشغل الأسطوانات يتسبب في تشغيل أسطوانات جديدة دون تدخل يدوي)",
 "オートノミー": "اِسْتِقْلال, تَحَرُّر (التحرر من السيطرة أو الاعتماد على الغير، سواء كان ذلك فرديًا أو جماعيًا؛ التمتع بالاكتفاء الذاتي والقدرة على اتخاذ القرارات دون تدخل خارجي)\nمثال: الصحراويون يريدون الاستقلال.",
 "オートバイ": "مُوتُوسِيكِل, دَرَّاجَة نَارِيَّة",
 "オートバイオグラフィー": "سِيرَة ذَاتِيَّة",
 "オートパイロット": "طيار آلي, نظام طيران آلي (جهاز ملاحي يحافظ تلقائياً على مسار السفن أو الطائرات أو المركبات الفضائية في اتجاه ثابت) / تصرف تلقائي, طيار آلي (حالة معرفية يتصرف فيها الشخص دون وعي ذاتي كامل)\nمثال: قامت بأعمالها المنزلية بشكل تلقائي",
 "オートフォーカス": "تركيز تلقائي (جهاز بصري لتركيز الكاميرا أو أداة أخرى تلقائياً)",
 "オートマ": "تِلْقَائِيّ, أُوتُوماتِيكِيّ (عَفْوِيّ؛ آلِيّ) / تِلْقَائِيّ (عَفْوِيّ؛ آلِيّ)\nمثال: كان سامي معرضا لحكم تلقائي بالسجن المؤبد إن أدين.",
 "オートマチスム": "تِلْقَائِيَّة",
 "オートマチック": "تِلْقَائِيّ, أُوتُوماتِيكِيّ (عَفْوِيّ؛ آلِيّ) / تِلْقَائِيّ (عَفْوِيّ؛ آلِيّ)\nمثال: كان سامي معرضا لحكم تلقائي بالسجن المؤبد إن أدين. / سلاح آلي, سلاح ناري أوتوماتيكي (سلاح ناري يعيد تحميل نفسه ويستمر في إطلاق النار حتى يتم تحرير الزناد) / ناقل حركة أوتوماتيكي (ناقل حركة يغير التروس تلقائياً وفقاً لسرعة السيارة)",
 "オートマチックシフト": "ناقل حركة أوتوماتيكي (ناقل حركة يغير التروس تلقائياً وفقاً لسرعة السيارة)",
 "オートマチックトランスミッション": "ناقل حركة أوتوماتيكي (ناقل حركة يغير التروس تلقائياً وفقاً لسرعة السيارة)",
 "オートマチック・シフト": "ناقل حركة أوتوماتيكي (ناقل حركة يغير التروس تلقائياً وفقاً لسرعة السيارة)",
 "オートマチック・トランスミッション": "ناقل حركة أوتوماتيكي (ناقل حركة يغير التروس تلقائياً وفقاً لسرعة السيارة)",
 "オートマット": "مطعم آلي (كافيتريا يتم فيها تقديم الطعام من الآلات) / آلة بيع الطعام (آلة بيع يمكنك الحصول منها على الطعام)",
 "オートマティスム": "تِلْقَائِيَّة",
 "オートマティック": "تِلْقَائِيّ, أُوتُوماتِيكِيّ (عَفْوِيّ؛ آلِيّ) / تِلْقَائِيّ (عَفْوِيّ؛ آلِيّ)\nمثال: كان سامي معرضا لحكم تلقائي بالسجن المؤبد إن أدين. / سلاح آلي, سلاح ناري أوتوماتيكي (سلاح ناري يعيد تحميل نفسه ويستمر في إطلاق النار حتى يتم تحرير الزناد) / ناقل حركة أوتوماتيكي (ناقل حركة يغير التروس تلقائياً وفقاً لسرعة السيارة)",
 "オートマトン": "آلَة ذَاتِيَّة تَشْغِيل, أُوتُومَاتُون (الفارسية: ماشين؛ الأوردية: مشين)\nمثال: نسى زيري الآلة.",
 "オートミール": "دقيق الشوفان, شوفان (دقيق مصنوع من الشوفان الملفوف أو المطحون) / دقيق الشوفان, عصيدة الشوفان (عصيدة مصنوعة من رقائق الشوفان)",
 "オートミールクッキー": "بسكويت الشوفان (بسكويت يحتوي على رقائق الشوفان)",
 "オートミール・クッキー": "بسكويت الشوفان (بسكويت يحتوي على رقائق الشوفان)",
 "オートメ": "أَتْمَتَة, تَأْلِيَّة",
 "オートメーション": "أَتْمَتَة, تَأْلِيَّة",
 "オートモビル": "سَيَّارَة, أُوتُومُوبِيل (مؤنث سَيَّار، صفة للكثير السَيْر؛ القَافِلَة أوالقَوْم الذين يسيرون)\nمثال: إنه يملك سيارة.",
 "オートモーチブ": "ذَاتِيّ الحَرَكَة, ذَاتِيّ الدَّفْع (يحتوي في ذاته على وسيلة الدفع أو الحركة) / ذاتي الحركة, متعلق بالسيارات (متعلق بالمركبات ذات المحرك)\nمثال: مستلزمات السيارات",
 "オートモービル": "سَيَّارَة, أُوتُومُوبِيل (مؤنث سَيَّار، صفة للكثير السَيْر؛ القَافِلَة أوالقَوْم الذين يسيرون)\nمثال: إنه يملك سيارة.",
 "オートラジオグラフィー": "تصوير إشعاعي ذاتي (إنتاج صورة شعاعية بواسطة الإشعاع المنبعث من العينة التي يتم تصويرها)",
 "オートレース": "سباق السيارات (سباق بين السيارات (عادة عالية الأداء))",
 "オート・キュイジーヌ": "الطهي الراقي, المطبخ الرفيع ((فرنسي) أسلوب متقن وماهر في إعداد الطعام)",
 "オート・クチュール": "أزياء راقية, هوت كوتور (أزياء تحدد اتجاهات الموضة)",
