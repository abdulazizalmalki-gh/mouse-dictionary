 "オード": "أود, قصيدة غنائية (قصيدة غنائية ذات أشكال مقطعية معقدة)",
 "オードコロン": "كولونيا, ماء الكولونيا (سائل معطر مصنوع من الزيوت الأساسية والكحول)",
 "オードトワレ": "ماء تواليت (سائل معطر أخف تركيزاً من الكولونيا)",
 "オードビ": "بَرَانْدِي / بْرَانْدِي / كُونْيَاك",
 "オードブル": "مشهيات, مقبلات (طبق يُقدم لفتح الشهية قبل الوجبة الرئيسية)",
 "オードーブル": "مشهيات, مقبلات (طبق يُقدم لفتح الشهية قبل الوجبة الرئيسية)",
 "オーナ": "مَالِك, مَالِكَة (اسم شخصي معطًى للذكور من العرب)\nمثال: من مالك هذا البيت؟",
 "オーナメント": "حِلْيَة",
 "オーナー": "مَالِك, مَالِكَة (اسم شخصي معطًى للذكور من العرب)\nمثال: من مالك هذا البيت؟",
 "オーナーシップ": "مُلْكِيَّة",
 "オーナードライバー": "سائق مالك, مالك وسائق (سائق سيارة يمتلك السيارة التي يقودها)",
 "オーニソプター": "أورنيثوبتر, طائرة رفرافة (مركبة أثقل من الهواء يتم دفعها عن طريق رفرفة الأجنحة)",
 "オーニング": "تنده, مظلة قماشية (ظلة مصنوعة من قماش القنب لحماية الناس أو الأشياء من المطر أو الشمس)",
 "オーバ": "مِعْطَف / فَائِق, هَائِل (يتجاوز بكثير ما هو معتاد في الحجم أو الدرجة) / مُضَخَّم, مُكَبَّر (مُكبَّر إلى درجة غير طبيعية) / مُبَالَغٌ فِيه (مُصَوَّرٌ عَلَى أَنَّهُ أَكْبَرُ مِمَّا هُوَ فِي الحَقِيقَة) / تعريض مفرط (فعل تعريض شخص ما بشكل مفرط لتجربة مؤثرة) / تعريض مفرط (فعل تعريض الفيلم للكثير من الضوء أو لفترة طويلة جدًا)\nمثال: التعرض المفرط للعنف في التلفزيون",
 "オーバコート": "مِعْطَف",
 "オーバジーン": "باذنجان (خضار بيضاوي الشكل ذو جلد لامع عادة ما يكون أرجوانياً داكناً ولكن أحياناً أبيض أو أصفر) / باذنجان (عشب مشعر قائم موطنه جنوب شرق آسيا ولكنه يزرع على نطاق واسع لفاكهته اللحمية اللامعة الكبيرة المستخدمة عادة كخضروات)",
 "オーバチュア": "اِفْتِتَاحِيَّة",
 "オーバフロー": "فَيَضَان / فَاضَ",
 "オーバヘッド": "فَوْق الرَّأْس (أعلى الرأس) / عَالِيًا, فِي السَّمَاء (فوق رأسك؛ في السماء) / سماش, ضربة ساحقة (رد قوي بضرب كرة التنس فوق رأسك) / علوي, فوقي (يقع أو ينشأ من الأعلى)\nمثال: اجمع الساقين معاً فوق الرأس / رَكْلَة ازْدِوَاجِيَّة",
 "オーバラップ": "تراكب, طية (لسان يقع فوق جزء آخر) / تداخل (خاصية التصادف الجزئي في الوقت) / التقاء, تداخل (تمثيل للأرضية المشتركة بين النظريات أو الظواهر)\nمثال: يجب أن يكون تراكب القرميد عشر بوصات على الأقل",
 "オーバラン": "تجاوز الإنتاج, فرط الإنتاج (إنتاج مفرط أو أكثر من المتوقع)",
 "オーバル": "إِهْلِيلَج / إِهْلِيلَجِيّ, بَيْضَوِيّ",
 "オーバレイ": "طبقة تغطية (طبقة من مادة زخرفية (مثل ورق الذهب أو قشرة الخشب) توضع فوق سطح) / تغليف, تكسية (غطاء واقٍ يتكون مثلاً من طبقة من الألواح تطبق على دعامات وعوارض المبنى لتقويته وتكون بمثابة أساس للتكسية الخارجية المقاومة للعوامل الجوية)",
 "オーバレイくぶん": "طبقة تغطية (طبقة من مادة زخرفية (مثل ورق الذهب أو قشرة الخشب) توضع فوق سطح) / تغليف, تكسية (غطاء واقٍ يتكون مثلاً من طبقة من الألواح تطبق على دعامات وعوارض المبنى لتقويته وتكون بمثابة أساس للتكسية الخارجية المقاومة للعوامل الجوية)",
 "オーバレイ区分": "طبقة تغطية (طبقة من مادة زخرفية (مثل ورق الذهب أو قشرة الخشب) توضع فوق سطح) / تغليف, تكسية (غطاء واقٍ يتكون مثلاً من طبقة من الألواح تطبق على دعامات وعوارض المبنى لتقويته وتكون بمثابة أساس للتكسية الخارجية المقاومة للعوامل الجوية)",
 "オーバー": "مِعْطَف / فَائِق, هَائِل (يتجاوز بكثير ما هو معتاد في الحجم أو الدرجة) / مُضَخَّم, مُكَبَّر (مُكبَّر إلى درجة غير طبيعية) / مُبَالَغٌ فِيه (مُصَوَّرٌ عَلَى أَنَّهُ أَكْبَرُ مِمَّا هُوَ فِي الحَقِيقَة) / تعريض مفرط (فعل تعريض شخص ما بشكل مفرط لتجربة مؤثرة) / تعريض مفرط (فعل تعريض الفيلم للكثير من الضوء أو لفترة طويلة جدًا)\nمثال: التعرض المفرط للعنف في التلفزيون",
 "オーバーアクション": "مبالغة في التمثيل (تمثيل رديء من قبل ممثل مبالغ)",
 "オーバーウェイト": "زَائِد الوَزْن, ضَخْم البِنْيَة (يَصِف عَادَةً شَخْصًا كَبِيرًا بَدِينًا لَكِنْ لَه هَيْكَل كَبِير يَحْمِل وَزْنَه) / بدانة, وزن زائد (خاصية السمنة المفرطة)",
 "オーバーウェート": "زَائِد الوَزْن, ضَخْم البِنْيَة (يَصِف عَادَةً شَخْصًا كَبِيرًا بَدِينًا لَكِنْ لَه هَيْكَل كَبِير يَحْمِل وَزْنَه) / بدانة, وزن زائد (خاصية السمنة المفرطة)",
 "オーバーウエイト": "زَائِد الوَزْن, ضَخْم البِنْيَة (يَصِف عَادَةً شَخْصًا كَبِيرًا بَدِينًا لَكِنْ لَه هَيْكَل كَبِير يَحْمِل وَزْنَه) / بدانة, وزن زائد (خاصية السمنة المفرطة)",
 "オーバーウエート": "زَائِد الوَزْن, ضَخْم البِنْيَة (يَصِف عَادَةً شَخْصًا كَبِيرًا بَدِينًا لَكِنْ لَه هَيْكَل كَبِير يَحْمِل وَزْنَه) / بدانة, وزن زائد (خاصية السمنة المفرطة)",
 "オーバーエイジ": "عَفَا عَلَيْه الزَّمَن, مُتَجَاوِز السِّنّ (تجاوز السنّ المناسبة بحيث لم يعد صالحاً للعمل) / زيادة, فائض (فائض أو زيادة في المال أو البضائع الموجودة فعلياً والتي تتجاوز التوقعات)",
 "オーバーエージ": "عَفَا عَلَيْه الزَّمَن, مُتَجَاوِز السِّنّ (تجاوز السنّ المناسبة بحيث لم يعد صالحاً للعمل) / زيادة, فائض (فائض أو زيادة في المال أو البضائع الموجودة فعلياً والتي تتجاوز التوقعات)",
 "オーバーオール": "إِجْمَالِيّ, شَامِل (يتناول السمات الرئيسية فقط) / إِجْمَالِيّ, شَامِل (يشمل كل شيء بلا استثناء) / أفرول, سروال عمل ((عادة جمع) ملابس عمل تتكون من سراويل دنيم (عادة بمريلة وحمالات كتف)) / أفرول, بدلة عمل (رداء واقٍ فضفاض أو مريول يرتدى فوق الملابس العادية للعمل المتسخ)",
 "オーバーキル": "إفراط, مبالغة (أي جهد يبدو أنه يذهب أبعد مما هو ضروري لتحقيق هدفه) / إفراط في التسلح, قوة مفرطة (القدرة على تدمير هدف بأسلحة تزيد عن الحاجة (خاصة الأسلحة النووية))",
 "オーバーコート": "مِعْطَف",
 "オーバーサイズ": "أَكْبَر مِن المُعْتَاد, مُفْرِط الحَجْم (أكبر من الحجم الطبيعي لنوعه)",
 "オーバーシューズ": "حذاء فوقي (حذاء يحمي حذاءك الأصلي من الماء أو الثلج أو البرد)",
 "オーバーシューツ": "حذاء فوقي (حذاء يحمي حذاءك الأصلي من الماء أو الثلج أو البرد)",
 "オーバーシュート": "إلغاء الهبوط, تجاوز الهدف (اقتراب يفشل ويفسح المجال لمحاولة أخرى) / تَفَشٍّ",
 "オーバーステア": "انعطاف مفرط, فرط التوجيه (عندما تنعطف السيارة بمقدار أكثر مما أمر به السائق)",
 "オーバーステップ": "مُتَجَسِّد / مَشْي (السَيْر على رجلين؛ السير عامّة)\nمثال: مشي توم مع ماري.",
 "オーバースロー": "رمية علوية (رمية بيسبول تتحرك فيها اليد فوق الكتف)",
 "オーバータイム": "وَقْت إِضَافِيّ (\"بَقِيَ وَقْتاً عِنْدَهُ \" : أَيْ مِقْدَاراً مِنَ الزَّمَنِ؛ \"جَاءَ فِي الوَقْتِ الْمُنَاسِبِ \" : فِي اللَّحْظَةِ الْمُنَاسِبَةِ)\nمثال: حان وقت الذهاب.",
 "オーバーチャージ": "زيادة في السعر, سعر مبالغ فيه (سعر مرتفع جداً)",
 "オーバーチュア": "اِفْتِتَاحِيَّة",
 "オーバーテイク": "تجاوز, تخطي (المرور بجانب شيء متحرك للوصول إلى أمامه)\nمثال: كانت تقود بشكل جيد لكن تجاوزها المتهور لكل سيارة على الطريق أخافني",
 "オーバードクター": "باحث ما بعد الدكتوراه (باحث يشارك في دراسة أكاديمية تتجاوز مستوى درجة الدكتوراه) / منحة ما بعد الدكتوراه (منحة تمول دراسة أو بحث ما بعد الدكتوراه)",
 "オーバードライブ": "أوفردرايف, سرعة زائدة (ترس عالٍ يستخدم بسرعات عالية للحفاظ على سرعة القيادة بطاقة خرج أقل) / طاقة قصوى, نشاط مفرط (حالة النشاط العالي أو المفرط أو الإنتاجية أو التركيز)\nمثال: القوات مستعدة للعمل بطاقة قصوى بمجرد إعطاء الإشارة",
 "オーバードラフト": "سحب على المكشوف (سحب يتجاوز الرصيد الدائن)",
 "オーバードース": "جُرْعَة زَائِدَة",
 "オーバードーズ": "جُرْعَة زَائِدَة",
 "オーバーナイト": "بَيْنَ لَيْلةٍ وَضُحاهَا (ظرف مكان بمعنى وَسْط)\nمثال: مصيري بين يديك.",
 "オーバーナイトバッグ": "حقيبة ليلية, حقيبة مبيت (حقيبة سفر صغيرة لحمل الملابس واللوازم للإقامة لليلة واحدة)",
 "オーバーナイト・バッグ": "حقيبة ليلية, حقيبة مبيت (حقيبة سفر صغيرة لحمل الملابس واللوازم للإقامة لليلة واحدة)",
 "オーバーハング": "بروز, تدلّ (نتوء يمتد إلى ما بعد شيء آخر أو يتدلى فوقه)",
 "オーバーハンド": "مَخِيطٌ بِغُرْزَةٍ عُلْوِيَّةٍ (مخيط بغرز عمودية قريبة تمر فوق الحافتين وتجمعهما معاً) / من فوق الذراع (مع تقديم اليد وخفضها من فوق مستوى الكتف)\nمثال: رمية من فوق الذراع",
 "オーバーパス": "جسر علوي (جسر يتشكل من المستوى العلوي لتقاطع طريقين سريعين على مستويات مختلفة)",
 "オーバーヒート": "تسخين مفرط, فرط السخونة (تسخين مفرط)",
 "オーバーフェンス": "إصابة الهدف, نجاح تام (شيء ينجح تماماً في تحقيق هدفه) / ركضة كاملة, هوم ران (ضربة تتيح للضارب الدوران حول القواعد وتسجيل نقطة (ركضة))\nمثال: كانت الحملة الإعلانية الجديدة نجاحاً تاماً",
