 "ウィー": "وي",
 "ウィーク": "أُسْبُوع / جُمْعَة (مجموعة، قبضة أو كمية صغيرة؛ جمعةٌ من تمر، أي قبضة منهُ) / اسبوع / إسبوع / أُسبوع / سيمانة\nمثال: اليوم هو الجمعة. / ضَعِيف",
 "ウィークエンド": "نِهَايَة الْأُسْبُوع, عَطْلَة الْأُسْبُوع",
 "ウィークデイ": "يَوْم عَمَل (فترة من الزمان تبدأ عند غُرُوب الشمس وتنتهي عند غُرُوب شمس النهار التالي ويشمل اللَيْلَة ونَهَارا. طوله أربع وعشرين سَاعَة؛ النَهَار، يبدأ من طلوع الفَجْر إلى غُرُوب الشَمس، على المجاز)\nمثال: طقس اليوم جميل.",
 "ウィークデー": "يَوْم عَمَل (فترة من الزمان تبدأ عند غُرُوب الشمس وتنتهي عند غُرُوب شمس النهار التالي ويشمل اللَيْلَة ونَهَارا. طوله أربع وعشرين سَاعَة؛ النَهَار، يبدأ من طلوع الفَجْر إلى غُرُوب الشَمس، على المجاز)\nمثال: طقس اليوم جميل.",
 "ウィークニング": "إضعاف (عملية تقليل قوة شيء ما) / مُضَعِّف, مُوَهِّن (يُخفّف عن طريق إضعاف حدة الألم أو الحزن) / مُضْعِف, مُوهِن (يسبب الوهن والضعف) / إضعاف, وهن (أن يصبح الشيء أضعف)",
 "ウィークポイント": "نقطة ضعف (صفة غير كافية أو ناقصة)",
 "ウィークリ": "أُسْبُوعِيًّا / أُسْبُوعِيٌّ",
 "ウィークリー": "أُسْبُوعِيًّا / أُسْبُوعِيٌّ",
 "ウィーク・ポイント": "نقطة ضعف (صفة غير كافية أو ناقصة)",
 "ウィース": "يَاه, اسمع / هَلَا / نَعَم سَيِّدِي (الإبِل والبَقَر والغَنَم. وتسمى نَعَم فقط إذا كان فيها إبل، فالإبل لوحدها نَعَم…)\nمثال: أنت نعم الطالب.",
 "ウィーゼル": "اِبْن عِرْس, عِرْسَة (الولد الذكر)\nمثال: هو له ابن صغير.",
 "ウィーチャット": "وِي تْشَات",
 "ウィード": "عُشْبَة ضَارَّة / بانْجو, حَشيش",
 "ウィービング": "حياكة, نسيج (صنع القماش)",
 "ウィーン": "فِيِينَا / فِيِنَّا / ڤِيِينَا / ڤِيِنَّا",
 "ウイ": "بَلَى, مبلا (يفيد إبطال النفي؛ في : نَعَمْ في كل حالاتها عدا جواب النِدَاء في بعض لهجات الشام، في بعض اللهجات الشامية الأخرى يقال مبَلَى…) / نَعَم, نَعَمَانِ (الإبِل والبَقَر والغَنَم. وتسمى نَعَم فقط إذا كان فيها إبل، فالإبل لوحدها نَعَم…)\nمثال: هذه ليست جملة, بل مجموعة من الكلمات بلى معنى.",
 "ウイウイ": "بَلَى, مبلا (يفيد إبطال النفي؛ في : نَعَمْ في كل حالاتها عدا جواب النِدَاء في بعض لهجات الشام، في بعض اللهجات الشامية الأخرى يقال مبَلَى…) / نَعَم, نَعَمَانِ (الإبِل والبَقَر والغَنَم. وتسمى نَعَم فقط إذا كان فيها إبل، فالإبل لوحدها نَعَم…)\nمثال: هذه ليست جملة, بل مجموعة من الكلمات بلى معنى.",
 "ウイキペディア": "وِيكِيبِيدِيَا (موسوعة ويكي مجانية المحتوى ومتعددة اللغات على الإنترنت تديرها مؤسسة ويكيميديا؛ (مَجَازِيًّا) المجتمع الذي يطور ويكيبيديا)\nمثال: استعمل ويكيبيديا.",
