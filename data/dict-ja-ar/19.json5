 "イペ": "سنديان الوادي, سنديان كاليفورنيا الأبيض (سنديان نفضي طويل ورشيق موطنه كاليفورنيا، له أوراق جلدية وبلوط (ثمر) نحيل ومدبب) / بلاتيميسيوم, روبل (شجرة كبيرة من ترينيداد وغيانا لها أوراق ريشية فردية وعناقيد إبطية برائحة البنفسج من الزهور الصفراء وقرون ناعمة طويلة؛ تزرع كعينة في المتنزهات…)",
 "イペカック": "إيبيكاك, عرق الذهب (دواء طبي يستخدم لاستثارة القيء (خاصة في حالات الجرعة الزائدة من المخدرات أو التسمم))",
 "イペリット": "غاز الخردل",
 "イボ": "ثُؤْلُول",
 "イボご": "إِيغْبُو (عضو في أكبر مجموعة عرقية في جنوب شرق نيجيريا)\nمثال: معظم الإيغبو مزارعون",
 "イボイノシシ": "خَنْزِير بَرِّيّ",
 "イボイボ": "ثُؤْلُول",
 "イボタ": "تمرحنة يابانية (شجيرة دائمة الخضرة من اليابان وكوريا لها أوراق داكنة صغيرة وزهور في عناقيد فضفاضة؛ مرتبطة بالتمرحنة الصينية ولكنها أصغر)",
 "イボハナザル": "أَفْطَس, قَصِير الأَنْف (ذو أنف قصير وأفطس)",
 "イボ語": "إِيغْبُو (عضو في أكبر مجموعة عرقية في جنوب شرق نيجيريا)\nمثال: معظم الإيغبو مزارعون",
 "イマい": "تَيَّار / جَارٍ (له استخدامات متعددة، تتراوح بين وصف المكان والعلاقة بين الناس، وبين وصف فعل الظلم أو الميل عن الطريق الصحيح؛ \"جار\" كلمةٌ مُشْعِبَةُ المعنى، تشيرُ إلى المكانِ، والعلاقة، والظلم)\nمثال: لدي جارة مسلمة.",
 "イマイチ": "إلى حد ما, باعتدال (إلى حد أو درجة معينة) / إلى حد ما, قليلاً (بدرجة أو مدى صغير)\nمثال: كبير جداً",
 "イマジズム": "التصويرية (حركة لشعراء أمريكيين وإنجليز في أوائل القرن العشرين كرد فعل على العاطفية الفيكتورية؛ استخدمت لغة مشتركة في الشعر الحر مع صور حسية واضحة)",
 "イマジナリ": "خِيَّالِيّ",
 "イマジナリー": "خِيَّالِيّ",
 "イマジネイション": "خَيَّال, تَخَيُّل (الخَيَّالُ : صَاحبُ الخيول؛ الخَيَّالُ : فارس الخيول) / صُورَة ذِهْنِيَّة\nمثال: يحب الخيال العلمي.",
 "イマジネーション": "خَيَّال, تَخَيُّل (الخَيَّالُ : صَاحبُ الخيول؛ الخَيَّالُ : فارس الخيول) / صُورَة ذِهْنِيَّة\nمثال: يحب الخيال العلمي.",
 "イマジン": "تَخَيَّلَ, تَصَوَّرَ",
 "イマドキ": "الآن, اليوم (في هذه الأوقات) / حاضر (الفترة الزمنية التي تحدث الآن؛ أي امتداد مستمر للزمن يشمل لحظة الكلام)\nمثال: فقط من خلال لغتهم يتم تمييز الطبقات العليا في هذه الأيام",
 "イマーゴ": "حشرة كاملة, يافعة (حشرة بالغة ناتجة بعد التحول) / إيماجو, صورة الوالد ((في التحليل النفسي) صورة مثالية لشخص (عادة أحد الوالدين) تشكلت في الطفولة)",
 "イマージェンシー": "طَوَارِئ, حَالَةْ اَلطَّوَارِئ",
 "イマージュ": "صُورَة / اِنْطِبَاع, سُمْعَة",
 "イマーム": "إِمَام",
 "イミグレ": "هِجْرَة, مُهَاجَرَة (ترك الأرض والخروج منها إلى أخرى؛ في الشرع: ترك الوطن الذي بين الكفار والانتقال إلى دار الإسلام قربة لله)\nمثال: الهجرة النبوية.",
 "イミグレイション": "هِجْرَة, مُهَاجَرَة (ترك الأرض والخروج منها إلى أخرى؛ في الشرع: ترك الوطن الذي بين الكفار والانتقال إلى دار الإسلام قربة لله)\nمثال: الهجرة النبوية.",
 "イミグレーション": "هِجْرَة, مُهَاجَرَة (ترك الأرض والخروج منها إلى أخرى؛ في الشرع: ترك الوطن الذي بين الكفار والانتقال إلى دار الإسلام قربة لله)\nمثال: الهجرة النبوية.",
 "イミダゾール": "إيميدازول",
 "イミテイション": "تَقْلِيد",
 "イミテーション": "تَقْلِيد",
 "イミディエイト": "فَوْرِيّ",
 "イミド": "إيميد",
 "イミフ": "غَامِض",
 "イミプラミン": "إيميبرامين, توفرانيل (مضاد اكتئاب ثلاثي الحلقات (الأسماء التجارية توفرانيل وغيرها) يستخدم لعلاج الاكتئاب السريري)",
 "イミュータブル": "رَاسِخ, غَيْر قَابِل لِلتَّحَوُّل (لا يخضع أو غير قابل للتغيير أو التباين في الشكل أو الجودة أو الطبيعة) / رَاسِخ, لَا يَتَغَيَّر (ثَابِتٌ وَغَيْرُ مُتَحَوِّلٍ)",
 "イメチェン": "تجديد شامل, تغيير المظهر (إعادة بناء وتجديد كامل لشيء ما) / تجميل شامل, نيو لوك (علاج تجميلي شامل (يتضمن تسريحة شعر ومستحضرات تجميل وملابس) يهدف إلى تغيير أو تحسين مظهر الشخص)\nمثال: خضع الحي المتدهور لتجديد شامل",
 "イメトレ": "تصور بصري, صورة بصرية (صورة ذهنية تشبه الإدراك البصري)",
 "イメージ": "صُورَة / اِنْطِبَاع, سُمْعَة / تصوير, رسم (التمثيل عن طريق الرسم أو التلوين وما إلى ذلك) / تخطيط, رسم خطي (رسم لخطوط خارجية لأشكال أو أشياء) / تصوير, تمثيل (تمثيل عن طريق الصورة أو الرسم) / تشخيص, تصوير (وصف لفظي بياني أو حيوي)\nمثال: في كثير من الأحيان كانت الرواية تُقاطع بصور لفظية طويلة",
 "イメージがぞう": "صُورَة / اِنْطِبَاع, سُمْعَة",
 "イメージオルシコン": "أورثيكون (أنبوب التقاط صور قديم في كاميرا التلفزيون؛ يتم تركيز الإلكترونات المنبعثة من سطح حساس للضوء بما يتناسب مع شدة الضوء الساقط على الهدف مما يسبب…)",
 "イメージガール": "فتاة الملصق (طفلة ملصق أنثى)",
 "イメージキャラクター": "تميمة (شخصية أو حيوان أو شيء يتبناه فريق أو مجموعة كشكل رمزي)",
 "イメージスキャナ": "ماسح ضوئي (جهاز إلكتروني يولد تمثيلاً رقمياً لصورة لإدخال البيانات إلى الحاسوب)",
 "イメージスキャナー": "ماسح ضوئي (جهاز إلكتروني يولد تمثيلاً رقمياً لصورة لإدخال البيانات إلى الحاسوب)",
 "イメージチェンジ": "تجديد شامل, تغيير المظهر (إعادة بناء وتجديد كامل لشيء ما) / تجميل شامل, نيو لوك (علاج تجميلي شامل (يتضمن تسريحة شعر ومستحضرات تجميل وملابس) يهدف إلى تغيير أو تحسين مظهر الشخص)\nمثال: خضع الحي المتدهور لتجديد شامل",
 "イメージトレーニング": "تصور بصري, صورة بصرية (صورة ذهنية تشبه الإدراك البصري)",
 "イメージメーカー": "عَلَاقَات عَامَّة",
 "イメージング": "تصوير طبي, تصوير مقطعي ((طب) الحصول على صور لداخل الجسم) / تخيل, خيال (القدرة على تكوين صور ذهنية للأشياء أو الأحداث)\nمثال: كان لا يزال يسمعها في خياله",
 "イメージ・オルシコン": "أورثيكون (أنبوب التقاط صور قديم في كاميرا التلفزيون؛ يتم تركيز الإلكترونات المنبعثة من سطح حساس للضوء بما يتناسب مع شدة الضوء الساقط على الهدف مما يسبب…)",
 "イメージ・ガール": "فتاة الملصق (طفلة ملصق أنثى)",
 "イメージ・キャラクター": "تميمة (شخصية أو حيوان أو شيء يتبناه فريق أو مجموعة كشكل رمزي)",
 "イメージ・スキャナ": "ماسح ضوئي (جهاز إلكتروني يولد تمثيلاً رقمياً لصورة لإدخال البيانات إلى الحاسوب)",
 "イメージ・スキャナー": "ماسح ضوئي (جهاز إلكتروني يولد تمثيلاً رقمياً لصورة لإدخال البيانات إلى الحاسوب)",
 "イメージ・チェンジ": "تجديد شامل, تغيير المظهر (إعادة بناء وتجديد كامل لشيء ما) / تجميل شامل, نيو لوك (علاج تجميلي شامل (يتضمن تسريحة شعر ومستحضرات تجميل وملابس) يهدف إلى تغيير أو تحسين مظهر الشخص)\nمثال: خضع الحي المتدهور لتجديد شامل",
 "イメージ・トレーニング": "تصور بصري, صورة بصرية (صورة ذهنية تشبه الإدراك البصري)",
 "イメージ・メーカー": "عَلَاقَات عَامَّة",
 "イメージ画像": "صُورَة / اِنْطِبَاع, سُمْعَة",
 "イモ": "درنة (ساق أو جذر تحت أرضي لحمي يخدم في التكاثر وتخزين الغذاء) / فلاح ساذج, قروي بسيط (شخص ليس ذكياً جداً أو غير مهتم بالثقافة) / خَامِل, فَاشِل (لا يَنْفَجِر؛ غَيْر مَشْحون بِمادَّة مُتَفَجِّرَة فَعَّالَة) / عمل فاشل, قنبلة (حدث يفشل بشدة أو يكون غير فعال تماماً) / فشل الاشتعال, كبوة (انفجار يفشل في الحدوث) / فاشِل, مُخْفِق (شخص غير ناجح)\nمثال: كانت التجربة الأولى عملاً فاشلاً حقاً",
 "イモい": "رَيْفِيّ, قَرَوِيّ",
 "イモくさい": "رِيفِيُّ الطَّابِع (يتّسم بسمات الحياة الريفيّة)",
 "イモっぽい": "غَيْر رَائِج, مُمِلّ ((عامية) غير عصري وممل)",
 "イモる": "مُخَيِّم",
 "イモムシ": "يَرَقَة, دُودَة الْفَرَاشَة",
 "イモリ": "سَمَنْدَل",
 "イモータル": "خَالِد (الخلود)\nمثال: خالد هو مواطن كويتي.",
 "イモーラル": "فاسد, لا أخلاقي (ينتهك عمداً المبادئ المقبولة للصواب والخطأ) / فَاسِد, لَا أَخْلَاقِيّ (لا يلتزم بالمبادئ الأخلاقية أو القِيَمية)",
 "イヤ": "كَرِهَ (لم يُحِبّ، لم يَسْتطِع تحمُّلَ شَخْص أو أمرٍ، لم يُطِقْه، مقَته وكان عنده نُفورٌ منه؛ كره الشّخص فعل السّوء)\nمثال: هتلر كره اليهود. / بغيض, غير سار (مسيء أو غير مقبول؛ يسبب عدم الراحة أو التعاسة)\nمثال: شخصية بغيضة / أُذُن (أَذَن؛ أَذَنَ: ( فعل ) أَذَنَ أَذْناً) / أُذْن (أَذَن؛ أَذَنَ: ( فعل ) أَذَنَ أَذْناً) / سُنْبُلَة / حَرَثَ (حرث الأرض: شقها بالمحراث ليزرعها؛ حرث النار: حركها وأثارها)\nمثال: من أذن لتوم باستعارة سيارتي? / وَا, يَا يَاه / آه (صوت يستخدم للدلالة على الشعور بالألم العاطفي أو الجسدي؛ ألم، إما عاطفي أم جسدي) / يَا, أَيْ (يستعمل لنِدَاء البعيد والقريب)\nمثال: آه ، هناك فراشة!",
 "イヤがらせ": "تَحَرُّش",
 "イヤというほど": "كَافٍ (كِفَايَة، يَكْفِي، كَافِ؛ مَه، كَفَى) / تَمَامًا / مَه, كَفَى (اسم فعل بمعنى إنْكَفِفْ أو تَوَقَّفْ، ويقال مَهٍ أيضاً)\nمثال: خسر كافة ممتلكاته. / بمرارة (بمرارة؛ بطريقة مستاءة) / بشدة, بمرارة (تشير إلى شيء صعب القبول) / بشكل ثاقب, بشكل قارص (بشكل شديد وحاد جداً)\nمثال: اشتكت بمرارة",
 "イヤイヤ": "دُونَ رَغْبَة, عَلَى مَضَض (بطريقة غير راغبة)\nمثال: لقد أخطأ بحقها كرهاً",
 "イヤガラセ": "تَحَرُّش",
 "イヤドロップ": "قرط متدلي (قرط به حلية متدلية)",
 "イヤピース": "سماعة أذن, سماعة رأس (محول كهروصوتي لتحويل الإشارات الكهربائية إلى أصوات؛ يوضع فوق الأذن أو بداخلها)\nمثال: لم تكن الكتابة هي ما تكرهه بل سماعات الأذن",
 "イヤフォン": "سَمَّاعَات",
 "イヤフォーン": "سَمَّاعَات",
 "イヤホン": "سَمَّاعَات",
 "イヤマーク": "بصمة, سمة فارقة (سمة أو صفة مميزة لشخص أو شيء ما) / علامة الأذن (علامة تعريف على أذن حيوان أليف)",
 "イヤリング": "قُرْط, حَلَق",
 "イヤン": "وَا, يَا يَاه / آه (صوت يستخدم للدلالة على الشعور بالألم العاطفي أو الجسدي؛ ألم، إما عاطفي أم جسدي) / يَا, أَيْ (يستعمل لنِدَاء البعيد والقريب)\nمثال: آه ، هناك فراشة!",
 "イヤンホホ": "سَمَّاعَات",
 "イヤー": "أُذُن (أَذَن؛ أَذَنَ: ( فعل ) أَذَنَ أَذْناً) / أُذْن (أَذَن؛ أَذَنَ: ( فعل ) أَذَنَ أَذْناً) / سُنْبُلَة / حَرَثَ (حرث الأرض: شقها بالمحراث ليزرعها؛ حرث النار: حركها وأثارها)\nمثال: من أذن لتوم باستعارة سيارتي? / وَا, يَا يَاه / آه (صوت يستخدم للدلالة على الشعور بالألم العاطفي أو الجسدي؛ ألم، إما عاطفي أم جسدي) / يَا, أَيْ (يستعمل لنِدَاء البعيد والقريب)\nمثال: آه ، هناك فراشة! / صَفّ (سَطْر مستقيم؛ مستوى تعليمي)\nمثال: صف كليتي وقلبي‎.",
 "イヤーウォーマ": "غطاء للأذنين (زوج من أغطية الأذن (عادة ما تكون متصلة بطوق رأس) يتم ارتداؤها للحفاظ على دفء الأذنين في الطقس البارد)",
 "イヤーウォーマー": "غطاء للأذنين (زوج من أغطية الأذن (عادة ما تكون متصلة بطوق رأس) يتم ارتداؤها للحفاظ على دفء الأذنين في الطقس البارد)",
 "イヤーピース": "سماعة أذن, سماعة رأس (محول كهروصوتي لتحويل الإشارات الكهربائية إلى أصوات؛ يوضع فوق الأذن أو بداخلها)\nمثال: لم تكن الكتابة هي ما تكرهه بل سماعات الأذن",
 "イヤーブック": "كتاب سنوي (كتاب مرجعي ينشر بانتظام مرة كل عام) / كتاب سنوي (كتاب تنشره سنوياً دفعة التخرج في مدرسة ثانوية أو كلية يحتوي عادة على صور أعضاء هيئة التدريس والطلاب المتخرجين)",
 "イヤーマフ": "غطاء للأذنين (زوج من أغطية الأذن (عادة ما تكون متصلة بطوق رأس) يتم ارتداؤها للحفاظ على دفء الأذنين في الطقس البارد)",
 "イヤーラウンド": "على مدار السنة (يعمل أو يستمر طوال العام)\nمثال: منتجع يعمل على مدار السنة",
 "イヤーラウンドファッション": "على مدار السنة (يعمل أو يستمر طوال العام)\nمثال: منتجع يعمل على مدار السنة",
 "イヤーラウンド・ファッション": "على مدار السنة (يعمل أو يستمر طوال العام)\nمثال: منتجع يعمل على مدار السنة",
