 "南極大陸": "أَنْتَارْكِتِيكَا, الْقُطْبُ الْجَنُوبِيّ (القارة الأقصى جنوبًا؛ تقع جنوب المحيط المتجمد الجنوبي، وتحوي القطب الجنوبي)\nمثال: تكس هو طائر من أنتاركتيكا.",
 "南極海": "اَلْمُحِيط اَلْمُتَجَمِّد اَلْجَنُوبِيّ, اَلْمُحِيط اَلْجَنُوبِيّ",
 "南極点": "اَلْقُطْب اَلْجَنُوبِيّ",
 "南極線": "الدَائِرَة القُطْبِيَّة الجَنُوبِيَّة",
 "南欧": "أُورُوبَّا اَلْجَنُوبِيَّة (الجزء من يوراسيا الذي يقع غرب جبال الأورال، والمعتبر تقليديًّا قارة بحد ذاته، كما يقع شمال قارة إفريقيا، وغرب قارة آسيا، وشرق المحيط الأطلسي؛ كيان سياسي؛ الاتحاد الأوروبي)\nمثال: ذهبت إلى أوروبا مرة.",
 "南溟": "اَلْمُحِيط اَلْمُتَجَمِّد اَلْجَنُوبِيّ, اَلْمُحِيط اَلْجَنُوبِيّ",
 "南無": "آمْيْن (اسم فعل أمر مبن على الفتح بمعنى \"اسْتَجِبْ\"، تأتي في خاتمة الدعاء) / آمِين (اسم فعل أمر مبن على الفتح بمعنى \"اسْتَجِبْ\"، تأتي في خاتمة الدعاء) / أَمَّنَ (وَثِقَ به وأرْكَنَ إليه)\nمثال: اتصل زيري بالأمن.",
 "南無三": "آهٍ (صوت يستخدم للدلالة على الشعور بالألم العاطفي أو الجسدي؛ ألم، إما عاطفي أم جسدي)\nمثال: آه ، هناك فراشة!",
 "南無三宝": "آهٍ (صوت يستخدم للدلالة على الشعور بالألم العاطفي أو الجسدي؛ ألم، إما عاطفي أم جسدي)\nمثال: آه ، هناك فراشة!",
 "南瓜": "قَرْع, يَقْطِين (ضرب بشدة على شيء يَصْدُرُ منه صوت قوي؛ في سياق مجازي: أوقع الضربة أو وقع الصوت المفاجئ أو الحاد)\nمثال: توقف ذلك القرع.",
 "南米": "أَمْرِيكَا الْجَنُوبِيَّة, أَمِيرِكَا الْجَنُوبِيَّة",
 "南蛮": "أُورُوبَّا الْغَرْبِيَّة (الجزء من يوراسيا الذي يقع غرب جبال الأورال، والمعتبر تقليديًّا قارة بحد ذاته، كما يقع شمال قارة إفريقيا، وغرب قارة آسيا، وشرق المحيط الأطلسي؛ كيان سياسي؛ الاتحاد الأوروبي)\nمثال: ذهبت إلى أوروبا مرة. / أَجْنَبِيّ / غَرِيب, أَجْنَبِيّ / شَطَّة",
 "南蛮宗": "مَسِيحِيَّة, نَصْرَانِيَّة (مؤنث المَسِيْحِيّ؛ المنسوبة إلى المَسِيْح؛ هي الدِيْن الذي يدين به المَسِيْحِيُّوْن؛ النَصْرَانِيَّة)\nمثال: اعتنق المسيحية.",
 "南蛮辛子": "شَطَّة",
 "南蛮黍": "غَلَّة",
 "南部": "جَنُوب (الْجِهَةُ الْمُقَابِلَةُ لِلشَّمَال؛ رِيحٌ تَهُبُّ مِنَ الْجَنُوب) / جنوب (الْجِهَةُ الْمُقَابِلَةُ لِلشَّمَال؛ رِيحٌ تَهُبُّ مِنَ الْجَنُوب) / جَنوب (الْجِهَةُ الْمُقَابِلَةُ لِلشَّمَال؛ رِيحٌ تَهُبُّ مِنَ الْجَنُوب)\nمثال: لا بد أنه من الجنوب.",
 "南都": "نَارَا",
 "南面": "حَاكِم (حَاكَمَ القاضي فلانا: أقام عليه محكمة ليرى ما إذا كان مجرما أم لا؛ حَاكَمَ فلانٌ فلانا: رفع عليه قضية؛ اشتكى عليه عند القضاء فأقاموا محكمة للحكم في الأمر)\nمثال: ميت رومني هو حاكم ولاية ماساتشوستس.",
 "南風": "صَيْف, صيف (فصل من فصول السنة الأربعة، يلي الرَّبِيع ويأتي بعده الخَرِيف، يتميز بشدة الحَرّ)\nمثال: نأتي هنا كل صيف.",
 "南鮮": "كُورِيَا الْجَنُوبِيَّة (بلاد في جنوب شرق آسيا، يطلق عليها جغرافيا شِبْهُ الجَزِيْرَةِ الكُوْرِيَّة؛ دولتان تقعان في جنوب شرق آسيا تسميان كُوْرِيَا الشَمَالِيَّة وكُوْرِيَا الجَنُوْبِيَّة)\nمثال: أريد أن أزور كوريا.",
 "単": "أَحَادِيّ / وَاحِد (في وَ: العدد واحد العدد الاول) / أَعْزَب, غَيْر مُتَزَوِّج / إصدار منفرد, أغنية منفردة / عَزَب\nمثال: رأيت واحدة مرة.",
 "単なる": "أَبْلَه (أَحْمَق؛ غَبِيّ)\nمثال: لا تضحك على الأبله و المعوق.",
 "単に": "بِكُلّ بَسَاطَة (بَكَلَه: خَلَطَه؛ بَكَلَ عَلَيْنَا حَديثَه وأَمْرَه: خَلَطَهُ وجاءَ بِهِ عَلَى غَيْرِ وَجْهِهِ)\nمثال: غادرنا بكل بساطة.",
 "単一": "أَحَادِيّ / وَاحِد (في وَ: العدد واحد العدد الاول) / أَعْزَب, غَيْر مُتَزَوِّج / إصدار منفرد, أغنية منفردة / عَزَب\nمثال: رأيت واحدة مرة.",
 "単一化": "تَوْحِيد",
 "単一機械": "آلة بَسِيطة (الفارسية: ماشين؛ الأوردية: مشين)\nمثال: نسى زيري الآلة.",
 "単一神教": "هينوثية",
 "単一言語": "أُحَادِي اَللُّغَة",
 "単位": "وَحْدَة / اِئْتِمَان",
 "単位料金区域": "مَا (انظر مَا)\nمثال: هلا! ما الجديد؟",
 "単価記号": "آت",
 "単元": "وَحْدَة",
 "単刀直入": "إِفْرَنْجِيّ",
 "単向": "مُبَسَّط (دَرْسٌ مُبَسَّطٌ : سَهْلٌ، وَاضِحٌ)\nمثال: هذا الكتاب مؤلف بلغة إنجليزية مبسطة و هو سهل للقراءة.",
 "単射": "حُقْنَة, حَقْن",
 "単打": "أَحَادِيّ / وَاحِد (في وَ: العدد واحد العدد الاول) / أَعْزَب, غَيْر مُتَزَوِّج / إصدار منفرد, أغنية منفردة / عَزَب\nمثال: رأيت واحدة مرة.",
 "単数": "أَحَادِيّ / وَاحِد (في وَ: العدد واحد العدد الاول) / أَعْزَب, غَيْر مُتَزَوِّج / إصدار منفرد, أغنية منفردة / عَزَب\nمثال: رأيت واحدة مرة. / مُفْرَد ((في النحو) يصف شيئًا أو شخصًا واحدًا فقط؛ كَلِمَة) / مُفْرَد, صِيغَة اَلْمُفْرَد ((في النحو) يصف شيئًا أو شخصًا واحدًا فقط؛ كَلِمَة)",
 "単方向": "مُبَسَّط (دَرْسٌ مُبَسَّطٌ : سَهْلٌ، وَاضِحٌ)\nمثال: هذا الكتاب مؤلف بلغة إنجليزية مبسطة و هو سهل للقراءة.",
 "単板": "قِنَاع (غطاء يوضع على الوجه للحماية أو التنكر؛ طبق يوضع فيه الطعام. )\nمثال: نزع زيري القناع.",
 "単独": "وَحِيد / عَزْب / أَخْمُص, بَاطِن القَدَم / نَعْل / سَمَك مُوسَى (سَمَك جمع سَمَكَة، كما تجمع سمكة أسماك)\nمثال: سمكة ميناد ماتت / اِسْتِقْلَال (التحرر من السيطرة أو الاعتماد على الغير، سواء كان ذلك فرديًا أو جماعيًا؛ التمتع بالاكتفاء الذاتي والقدرة على اتخاذ القرارات دون تدخل خارجي)\nمثال: الصحراويون يريدون الاستقلال.",
 "単独で": "وَحِيد, مُنْفَرِد",
 "単発性": "أَحَادِيّ / وَاحِد (في وَ: العدد واحد العدد الاول) / أَعْزَب, غَيْر مُتَزَوِّج / إصدار منفرد, أغنية منفردة / عَزَب\nمثال: رأيت واحدة مرة.",
 "単称": "مُفْرَد ((في النحو) يصف شيئًا أو شخصًا واحدًا فقط؛ كَلِمَة) / مُفْرَد, صِيغَة اَلْمُفْرَد ((في النحو) يصف شيئًا أو شخصًا واحدًا فقط؛ كَلِمَة)",
 "単簡": "أَبْلَه (أَحْمَق؛ غَبِيّ)\nمثال: لا تضحك على الأبله و المعوق.",
 "単純": "أَبْلَه (أَحْمَق؛ غَبِيّ)\nمثال: لا تضحك على الأبله و المعوق.",
 "単純性": "بَسَاطَة",
 "単純素朴": "سَاذَج",
 "単試合": "أَحَادِيّ / وَاحِد (في وَ: العدد واحد العدد الاول) / أَعْزَب, غَيْر مُتَزَوِّج / إصدار منفرد, أغنية منفردة / عَزَب\nمثال: رأيت واحدة مرة.",
 "単語": "كَلِمَة, كَلَام (الكلِمَةُ : اللفظةُ الدَّالةُ على معنًى مُفْرَد بالوضع، وتكون؛ الكلِمَةُ: الكلامُ المؤلَّفُ المطوَّل، قصيدةً، أَو خُطْبَةً، أَو مقالةً، أَو رسالة) / كَلِمَةُ اللهِ (الكلِمَةُ : اللفظةُ الدَّالةُ على معنًى مُفْرَد بالوضع، وتكون؛ الكلِمَةُ: الكلامُ المؤلَّفُ المطوَّل، قصيدةً، أَو خُطْبَةً، أَو مقالةً، أَو رسالة)\nمثال: كلمة السر طويلة.",
 "単語篇": "مَسْرَد",
 "単調性": "اِطِّرَادُ دَالَّةٍ",
 "単身": "وَحِيد, مُنْفَرِد",
 "単身者": "أَعْزَب, عَازِب",
 "単車": "مُوتُوسِيكِل, دَرَّاجَة نَارِيَّة",
 "単離": "تَوَحُّد",
 "単音": "تَلْفَنَ",
 "単音節": "أُحَادِيّ المَقْطَع",
 "単項": "مُبَسَّط (دَرْسٌ مُبَسَّطٌ : سَهْلٌ، وَاضِحٌ)\nمثال: هذا الكتاب مؤلف بلغة إنجليزية مبسطة و هو سهل للقراءة.",
 "単館": "مُسْتَقِل, حُرّ (اسم فاعل مِن اِسْتَقَلَّ؛ من لا يعتمد على غيره)\nمثال: الجزائر مستقلة الآن.",
 "博": "مَعْرِض",
 "博す": "رَبِحَ (رَبَحَ التَّاجِرُ: نَالَ فَائِدَةً مَالِيَّةً فِي تِجَارَتِهِ؛ رَبَحَ السَّبَاقَ: فَازَ، تَفَوَّقَ)\nمثال: ربح زيري المال. / نَشَرَ (بَسَطَ، فَرَّقَ، نَشَرَ الشيءَ: جعله منتشراً، مثل نشر الأخبار أو نشر كتاب؛ نَشَرَ: وزع أو عمم شيئًا بين الناس، مثل نشر المقالات) / اِنْتِشَار (مصدر الفعل \"انْتَشَرَ\"؛ (في الفيزياء) عملية توزيع جزيئات أو ذرات أو حبيبات بشكل متساوٍ في فراغ أو في حيز متاح أو تخللها خلال حاجز غشائي)\nمثال: نشر توم الغسيل.",
 "博する": "رَبِحَ (رَبَحَ التَّاجِرُ: نَالَ فَائِدَةً مَالِيَّةً فِي تِجَارَتِهِ؛ رَبَحَ السَّبَاقَ: فَازَ، تَفَوَّقَ)\nمثال: ربح زيري المال. / نَشَرَ (بَسَطَ، فَرَّقَ، نَشَرَ الشيءَ: جعله منتشراً، مثل نشر الأخبار أو نشر كتاب؛ نَشَرَ: وزع أو عمم شيئًا بين الناس، مثل نشر المقالات) / اِنْتِشَار (مصدر الفعل \"انْتَشَرَ\"؛ (في الفيزياء) عملية توزيع جزيئات أو ذرات أو حبيبات بشكل متساوٍ في فراغ أو في حيز متاح أو تخللها خلال حاجز غشائي)\nمثال: نشر توم الغسيل.",
 "博士": "خَبِير, مَاهِر (الخَابِر الذي يعرف خَبَر الشيء؛ المُخْتَصّ بالشيء ويعرف كل شيء عنه) / مُتَخَصِّص, مُتَخَصِّصَة\nمثال: درب على يد خبير.",
 "博士号": "دُكْتُورَاة (الدُّكْتوراة : دَرَجة دُكْتُور ولَقَبه؛ الدُّكْتُورَاه :أَعْلى مُؤهِّل جامعيّ، أعلى شهادة جامعيَّة، أو أَعْلَى شَهادَةٍ جامِعِيَّةٍ تُمْنَحُ بَعْدَ شَهادَةِ الإِجازَةُ (الْلِيسانْسِ) لِمَنْ…)",
 "博奕": "قِمَار, مُقَامَرَة / تَكَهُّنٌ / مُضَارَبَة",
 "博学者": "عَلَّامَة, بحر العلوم (سِمَةٌ أو أمارة أو شِعَار تُعرف به الأشياء؛ رَمْز)\nمثال: تحصلت على علامة أ.",
 "博徒": "مُقَامِر / مُغَامِر",
 "博愛": "مُنَظَّمَة خَيْرِيَّة / صَدَقَة / إِحْسَان",
 "博愛主義者": "سَخِيّ ((سَخِيَ) سَخاً: كَانَ جوادًا كَرِيمًا؛ (سَخِيَت) نَفسه عَن الشَّيْء: تركته)\nمثال: هو سخي بأمواله.",
 "博愛家": "سَخِيّ ((سَخِيَ) سَخاً: كَانَ جوادًا كَرِيمًا؛ (سَخِيَت) نَفسه عَن الشَّيْء: تركته)\nمثال: هو سخي بأمواله.",
 "博戯": "لعبة حظ (اللَعْبَة البَرْبَرية دواء عشبيّ)\nمثال: عنده لعبة يويو.",
 "博打": "قِمَار, مُقَامَرَة / تَكَهُّنٌ / مُضَارَبَة",
 "博物": "تاريخ طبيعي (جملة الأَحوال والأحداث التي يمر بها كائن ما، ويَصْدق على الفرد والمجتمع، كما يَصْدق على الظواهر الطبيعية والإنسانية؛ هو تحديد الزمن باليَوْم والشَهْر والسَنَة أو ببعضهما. الأجَل أو الوَقْت)\nمثال: ما تاريخ اليوم؟",
 "博物学": "تاريخ طبيعي (جملة الأَحوال والأحداث التي يمر بها كائن ما، ويَصْدق على الفرد والمجتمع، كما يَصْدق على الظواهر الطبيعية والإنسانية؛ هو تحديد الزمن باليَوْم والشَهْر والسَنَة أو ببعضهما. الأجَل أو الوَقْت)\nمثال: ما تاريخ اليوم؟",
 "博物誌": "تاريخ طبيعي (جملة الأَحوال والأحداث التي يمر بها كائن ما، ويَصْدق على الفرد والمجتمع، كما يَصْدق على الظواهر الطبيعية والإنسانية؛ هو تحديد الزمن باليَوْم والشَهْر والسَنَة أو ببعضهما. الأجَل أو الوَقْت)\nمثال: ما تاريخ اليوم؟",
 "博物館": "مَتْحَف (مكان تُجمع وتُعْرَض فيه الآثار التاريخيَّة أو الفنيَّة أو العِلْميَّة وغيرها)\nمثال: عاد إلى المتحف.",
 "博聞": "مُطَّلِع",
 "博覧会": "مَعْرِض",
 "博言学": "لِسَانِيَّات, عِلْم اللُّغَة",
 "博識": "تَعَلَّمَ (اكتسب معرفة أو خبرة أو مهارة) / اِعْتَبَرَ, اِتَّعَظَ (الشيءَ: اختبره وامتحنه ونظر فيه؛ الشيءَ شيءًا: عَدُّه كذلك وتصرف على ذلك الأساس. بمفعولين)\nمثال: هو سريع التعلم.",
