 "アブ": "نُعَرَة",
 "アブない": "خَطِر (خطر في مشيه: اهتز وتبختر؛ خطر بذنبه: رفعه مرة وخفضه أخرى، أو حركه يمينا وشمالا)\nمثال: أنا ذاهب للخطر. / فِي خَطَرٍ (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي. / غَيْر مُحَدَّد (غامض (يُستخدم خاصة في صيغة النفي)) / غَيْر مُؤَكَّد, مَشْكُوك فِيه (غير ثابت بما لا يدع مجالاً للشك؛ لا يزال غير مقرر أو غير معروف) / غَيْر وَاثِق, مُتَرَدِّد (يفتقر إلى أو يشير إلى نقص الثقة أو الاطمئنان) / غَيْر مُؤَكَّد (غير مؤكد الحدوث؛ ليس حتمياً)\nمثال: مستقبل غير مؤكد / أَغْلَقَ, سَكَّر (ضد فَتَحَ؛ سَدَّ وسَكَّرَ؛ قد تستخدم بمعنى أَقْفَلَ؛ أغلقه بحيث لا يفتح إلا بمفتاح) / قَرِيب\nمثال: أغلق الباب بغضب",
 "アブギダ": "أَبُوجِيدَا",
 "アブサン": "أبسنت (ليكير أخضر قوي منكه بالشيح واليانسون) / أفسنتين, شيح ابن سينا (عشبة عطرية في أوراسيا المعتدلة وشمال أفريقيا ذات طعم مر تستخدم في صنع مشروب الأفسنتين)",
 "アブサンゆ": "زيت الشيح (زيت مر داكن يتم الحصول عليه من أوراق الشيح؛ ينكه مشروبات الأفسنتين)",
 "アブサン油": "زيت الشيح (زيت مر داكن يتم الحصول عليه من أوراق الشيح؛ ينكه مشروبات الأفسنتين)",
 "アブジェクション": "اتضاع, انحطاط (حالة متدنية أو منكسرة)\nمثال: كل اعتراف جلبها إلى حالة من الانحطاط",
 "アブジャ": "أَبُوجَا",
 "アブジャド": "أَبْجَد (فِي : نظام ترتيب الأحرف العربي القديم قبل تحويله إلى نظام هجائي. يبدأ بحرف الألف وينتهي بحرف الغين…)",
 "アブスト": "مُلَخَّص, حاصِل / مَعْنَوِيّ, تَجْرِيدِيّ",
 "アブストラクション": "تَجْرِيد, كِيَان مُجَرَّد (مفهوم عامّ يُستخلَص بانتزاع السمات المشتركة من أمثلة محدّدة) / انتزاع, سحب (عملية سحب أو إزالة شيء ما) / لوحة تجريدية (لوحة فنية تجريدية) / انشغال بال, ذهول (الانشغال بشيء ما واستبعاد كل شيء آخر)",
 "アブストラクト": "مُلَخَّص, حاصِل / مَعْنَوِيّ, تَجْرِيدِيّ / تجريدية, فن تجريدي (نوع تجريدي من الفن؛ يعتمد المحتوى الفني على الشكل الداخلي بدلاً من التمثيل التصويري)",
 "アブストラクトアート": "تجريدية, فن تجريدي (نوع تجريدي من الفن؛ يعتمد المحتوى الفني على الشكل الداخلي بدلاً من التمثيل التصويري)",
 "アブストラクト・アート": "تجريدية, فن تجريدي (نوع تجريدي من الفن؛ يعتمد المحتوى الفني على الشكل الداخلي بدلاً من التمثيل التصويري)",
 "アブセンティズム": "غِيَاب",
 "アブソリューティズム": "مطلقية (عقيدة الكائن المطلق، وترتبط غالباً بالمثالية في الفلسفة) / حكم مطلق, شمولية (معتقد أيديولوجي في السلطة الكاملة وغير المقيدة للحكومة) / استبدادية, دكتاتورية (شكل من أشكال الحكم يكون فيه الحاكم دكتاتوراً مطلقاً (غير مقيد بدستور أو قوانين أو معارضة وما إلى ذلك)) / استبداد, حكم مطلق (الهيمنة من خلال التهديد بالعقاب والعنف)",
 "アブソリュート": "مُطْلَق (المُطْلَق ؛ ضد المُقَيَّد، من يتحرك بلا قَيْد أو مَانِع؛ صفة: تركت الشرطة البريء مُطْلَق السراح) / مثال: \"متزوج؟\" \"مطلق.\"",
 "アブソルート": "مُطْلَق (المُطْلَق ؛ ضد المُقَيَّد، من يتحرك بلا قَيْد أو مَانِع؛ صفة: تركت الشرطة البريء مُطْلَق السراح) / مثال: \"متزوج؟\" \"مطلق.\"",
 "アブソーバー": "مادة ماصة ((فيزياء) مادة في مفاعل نووي تمتص الإشعاع)",
 "アブダクション": "اِخْتِطَاف",
 "アブダビ": "أَبُو ظَبْي / إِمَارَة أَبُو ظَبْي (الإمَارَة : منصِب الأمير؛ الإمَارَة: دَوْلَة أو مَنْطِقَة أو جُزْء من الأَرْض يحكمه أَمِير)",
 "アブドラ": "عَبْدُ ٱللّٰه (خلاف الحُرّ، المَمْلُوْك، من له مالك يملكه. الجمع عبيد وأعبد وعِبدان وعُبدان؛ الإنسان حرا كان أم لا مؤمنا كان أن ملحدا من حيث أنه مملوك لله)",
 "アブナい": "خَطِر (خطر في مشيه: اهتز وتبختر؛ خطر بذنبه: رفعه مرة وخفضه أخرى، أو حركه يمينا وشمالا)\nمثال: أنا ذاهب للخطر. / فِي خَطَرٍ (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي. / غَيْر مُحَدَّد (غامض (يُستخدم خاصة في صيغة النفي)) / غَيْر مُؤَكَّد, مَشْكُوك فِيه (غير ثابت بما لا يدع مجالاً للشك؛ لا يزال غير مقرر أو غير معروف) / غَيْر وَاثِق, مُتَرَدِّد (يفتقر إلى أو يشير إلى نقص الثقة أو الاطمئنان) / غَيْر مُؤَكَّد (غير مؤكد الحدوث؛ ليس حتمياً)\nمثال: مستقبل غير مؤكد / أَغْلَقَ, سَكَّر (ضد فَتَحَ؛ سَدَّ وسَكَّرَ؛ قد تستخدم بمعنى أَقْفَلَ؛ أغلقه بحيث لا يفتح إلا بمفتاح) / قَرِيب\nمثال: أغلق الباب بغضب",
 "アブノーマル": "غَيْر طَبِيعِيّ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "アブハジア": "أَبْخَازْيَا",
 "アブミ骨": "رِكَاب",
 "アブラカタブラ": "تَعْوِيذَة, طَلَاسِم (رطانة وهراء)",
 "アブラカダブラ": "تَعْوِيذَة, طَلَاسِم (رطانة وهراء)",
 "アブラギク": "أُقْحُوَان",
 "アブラギッシュ": "زَيْتِيّ, دُهْنِيّ / زَيْتِيّ / حَثِيث, دَائِم (لَا يَتَوَقَّفُ أَبَدًا) / مُلَازِمٌ لِلذِّهْن, مُلِحّ (يَعُودُ إِلَى الذِّهْنِ بِاسْتِمْرَارٍ) / دائم, مستديم (باقٍ؛ لا يسقط) / عَنُود, مُثَابِر (ثابت بإصرار لا يلين ولا يتراجع)\nمثال: الأوراق المستديمة تبقى ملتصقة بعد النضج",
 "アブラコ": "جرينلينغ (سمكة غذائية في شمال المحيط الهادئ)",
 "アブラザメ": "كلب البحر الشائك (كلاب بحر صغيرة تعيش في القاع)",
 "アブラソコムツ": "إسكولار (ماكريل ثعباني كبير له حلقات تشبه النظارات حول عينيه)",
 "アブラツノザメ": "كلب البحر الشائك (كلاب بحر صغيرة تعيش في القاع)",
 "アブラナ": "اِغْتِصَاب (أَخْذُ الشيء قَهْراً وَظُلْماً؛ اِسْتِخْدَامُ العُنْفِ مَعَ النساء لِنَيْلِ الحَاجَةِ مِنْهَن بِالرَّغْمِ عَنْهَن) / اِغْتَصَبَ, غَصَبَ (غَصَبَ؛ زَنَى (بِفُلَانَةٍ) قَهْرًا/غَصْبًا)\nمثال: تعرض زيري للاغتصاب.",
 "アブラハム": "إِبْرَاهِيم ((في الإسلام) سورة إبراهيم، وهي السورة الرابعة عشر في القرآن) / إِبْرَاهِيم, أَبْرَاهَام ((في الإسلام) سورة إبراهيم، وهي السورة الرابعة عشر في القرآن)",
 "アブラムシ": "مَنّ, مَنَّة (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة! / صُرْصُور / مُتَطَفِّل, مُلْحَق (شخص يتبع باستمرار (وبشكل مزعج))",
 "アブラメ": "سَمَنْدَل",
 "アブラヤシ": "نخيل الزيت (جمع نَخْلَة)\nمثال: زيري يغرس نخيل التمر.",
 "アブレーション": "استئصال, بتر (إزالة جراحية لجزء من الجسم أو نسيج) / تلاشي الجليد, ذوبان الجليد (عملية التعرية التي تقلل من حجم الأنهار الجليدية)",
 "アブ・ダビ": "أَبُو ظَبْي / إِمَارَة أَبُو ظَبْي (الإمَارَة : منصِب الأمير؛ الإمَارَة: دَوْلَة أو مَنْطِقَة أو جُزْء من الأَرْض يحكمه أَمِير)",
 "アプグレ": "تَرْقِيَة",
 "アプコン": "رَاقٍ, فَاخِر (مُنَاسِبٌ لِذَوِي الدُّخُولِ الجَيِّدَة)",
 "アプザイレン": "هبوط بالحبال ((تسلق الجبال) هبوط جرف عمودي أو جدار باستخدام حبل مزدوج مثبت في نقطة أعلى وملفوف حول الجسم)",
 "アプス": "حنية الكنيسة (تجويف مقبب أو مقوس في مبنى، وخاصة في الطرف الشرقي للكنيسة؛ وعادة ما يحتوي على المذبح)",
 "アプストレー": "مُلَخَّص, حاصِل / مَعْنَوِيّ, تَجْرِيدِيّ",
 "アプデ": "تحديث (حَدَّث الشّخصُ:روى حديث الرّسول -صلّى الله عليه وسلّم-،حدّثه الشّخصُ:أخبره وتكلّم إليه،حدّثه قلبه:أعلمه،أحسّ مسبقاً بشيء،حدّث الشيء:جعله حديثاً،جدّده؛ حدّث بالنّعمة:أشاعها وشكر عليها)\nمثال: تم تحديث القاموس.",
 "アプライ": "وَضَعَ (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه) / طَبَّقَ (جَعَلَ شيئًا يغطي شيئًا آخر بشكل كامل؛ نفَّذَ أمرًا أو خطةً عمليةً)\nمثال: لقد أزمت الوضع.",
 "アプライアンス": "جِهَاز",
 "アプリ": "تَطْبِيق",
 "アプリオリ": "مُسَلَّم بِه, لَا يُحْتَاجُ إِثْبَاتَة إِلَى تَجْرِبَة ((للأشخاص) متبع دين الإِسْلَام) / مُسَبَّق\nمثال: سامي مسلم سابق.",
 "アプリオリほう": "مُسَلَّم بِه, لَا يُحْتَاجُ إِثْبَاتَة إِلَى تَجْرِبَة ((للأشخاص) متبع دين الإِسْلَام) / مُسَبَّق\nمثال: سامي مسلم سابق.",
 "アプリオリ法": "مُسَلَّم بِه, لَا يُحْتَاجُ إِثْبَاتَة إِلَى تَجْرِبَة ((للأشخاص) متبع دين الإِسْلَام) / مُسَبَّق\nمثال: سامي مسلم سابق.",
 "アプリカント": "مُقَدِّم طَلَب (الذي قُدِّمَ؛ في : رتبة عسكرية هي خامس الرتب في الترتيب التصاعدي الرَائِد أدنى منه والعَقِيْد أعلى منه) / مُتَقَدِّم\nمثال: تزحلقت العربة المسرعة و اصطدمت مقدمة العربة ب مؤخرة الشاحنة بشكل مفاجئ جدا .",
 "アプリケイション": "تَطْبِيق / كِتَاب, اِسْتِمَارَة (موضع تعليم الكتابة. الاستخدام الأصلي؛ مدرسة شبه رسمية لتعليم الأطفال الكِتَابَة والقِرَاءَة ومباديء الحِسَاب وبعض القُرَآن…)\nمثال: هذا الكتاب جديد",
 "アプリケーション": "تَطْبِيق / كِتَاب, اِسْتِمَارَة (موضع تعليم الكتابة. الاستخدام الأصلي؛ مدرسة شبه رسمية لتعليم الأطفال الكِتَابَة والقِرَاءَة ومباديء الحِسَاب وبعض القُرَآن…)\nمثال: هذا الكتاب جديد",
