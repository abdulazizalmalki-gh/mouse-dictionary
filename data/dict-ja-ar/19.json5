 "ウェンズデー": "الْأَرْبِعَاء, يَوْم الْأَرْبِعَاء",
 "ウェー": "طَرِيق, سَبِيل (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من ٱلشَّارِعِ، سَبِيل)\nمثال: أسأل عن الطريق.",
 "ウェーイ": "يَاه, اسمع / هَلَا",
 "ウェーキ": "أَيْقَظَ (نبَّهه، ضد نَوَّمَه؛ الغبارَ: أثاره)\nمثال: أيقظ زيري السائق",
 "ウェークボード": "لوح تزلج مائي (ويك بورد) (لوح طافٍ (يشبه لوح ركوب الأمواج) يستخدم للركوب فوق الماء أثناء السحب خلف قارب بمحرك)",
 "ウェーター": "نَادِل, نَادِلَة",
 "ウェーティング": "انتظار, تَرَقُّب (فعل الانتظار (البقاء دون نشاط في مكان واحد توقعاً لشيء ما)) / رَهْنَ الإِشَارَة, مُنْتَظِر (جاهز ومتاح للاستخدام في أيّ وقت)\nمثال: كان الانتظار محنة بالنسبة له",
 "ウェーティングリスト": "قَائِمَة اَلْاِنْتِظَار",
 "ウェーティングルーム": "غُرْفَةُ الاِنْتِظَار (اسم مفعول لما غُرِفَ من الماء وغيره باليد، الجمع غِرَاف؛ اسم؛ المكان في الدار أو المبنى محاط بأربع جدران وسقف، حُجْرَة، عِلِّيَّة. الجمع وغُرَف وغُرُفَات)\nمثال: الأب في الغرفة.",
 "ウェーティング・ルーム": "غُرْفَةُ الاِنْتِظَار (اسم مفعول لما غُرِفَ من الماء وغيره باليد، الجمع غِرَاف؛ اسم؛ المكان في الدار أو المبنى محاط بأربع جدران وسقف، حُجْرَة، عِلِّيَّة. الجمع وغُرَف وغُرُفَات)\nمثال: الأب في الغرفة.",
 "ウェート": "وَزْن / ثِقْل (ثَقَلَ الشيءَ يَثْقُلُه بِيَدِهِ ثَقْلًا: رَازَ ثِقَلَه؛ ثَقَلَ الشَّيْء بِيَدِهِ ثقلا قدّر ثِقْلَه)\nمثال: ان ثقل ما تحمل، فضع بعضا منه. / أَهَمِّيَّة",
 "ウェートレス": "نَادِلَة, جَرْسُونَة",
 "ウェードしき": "وَيْد–جَيْلْز, وِيد–جِيلْز",
 "ウェード式": "وَيْد–جَيْلْز, وِيد–جِيلْز",
 "ウェーハ": "رُقَاقَة",
 "ウェーバ": "تَنَازُل, وَثِيقَةُ تَنَازُل / ويبر (وحدة للتدفق المغناطيسي تساوي 100,000,000 ماكسويل)",
 "ウェーバー": "تَنَازُل, وَثِيقَةُ تَنَازُل / ويبر (وحدة للتدفق المغناطيسي تساوي 100,000,000 ماكسويل)",
 "ウェーバーのほうそく": "قانون فيبر ((فيزياء نفسية) المفهوم القائل بأن الفرق الملحوظ فقط في التحفيز يتناسب مع حجم التحفيز الأصلي)\nمثال: يفسر قانون فيبر لماذا لا تلاحظ أن مصابيحك الأمامية مضاءة في النهار",
 "ウェーバーの法則": "قانون فيبر ((فيزياء نفسية) المفهوم القائل بأن الفرق الملحوظ فقط في التحفيز يتناسب مع حجم التحفيز الأصلي)\nمثال: يفسر قانون فيبر لماذا لا تلاحظ أن مصابيحك الأمامية مضاءة في النهار",
 "ウェーバーフェヒナーのほうそく": "قانون فيشنر ((فيزياء نفسية) المفهوم القائل بأن حجم الإحساس الذاتي يزداد بما يتناسب مع لوغاريتم شدة التحفيز)",
 "ウェーバーフェヒナーの法則": "قانون فيشنر ((فيزياء نفسية) المفهوم القائل بأن حجم الإحساس الذاتي يزداد بما يتناسب مع لوغاريتم شدة التحفيز)",
 "ウェーファー": "رُقَاقَة",
 "ウェーブ": "لَوَّحَ, رَفْرَفَ / مَوْج, مَوْجَة",
 "ウェーブフロント": "جبهة الموجة ((في الفيزياء) سطح وهمي يربط بين جميع النقاط في الفضاء التي تصل إليها موجة تنتشر عبر وسط في نفس اللحظة)",
 "ウェーブレット": "تموج صغير, مويجة (موجة صغيرة على سطح سائل)",
 "ウェールズ": "وِيلْز",
 "ウェールズご": "ويلش, ويلش الأسود (سلالة من الماشية ثنائية الغرض طُورت في ويلز) / ويلزي (من أو متعلق أو مميز لويلز أو شعبها أو لغتهم) / الويلزية (لغة كلتية في ويلز) / ويلزي (مواطن أو مقيم في ويلز)\nمثال: الساحل الويلزي",
 "ウェールズじん": "ويلزي (مواطن أو مقيم ذكر في ويلز)",
 "ウェールズ人": "ويلزي (مواطن أو مقيم ذكر في ويلز)",
 "ウェールズ語": "ويلش, ويلش الأسود (سلالة من الماشية ثنائية الغرض طُورت في ويلز) / ويلزي (من أو متعلق أو مميز لويلز أو شعبها أو لغتهم) / الويلزية (لغة كلتية في ويلز) / ويلزي (مواطن أو مقيم في ويلز)\nمثال: الساحل الويلزي",
 "ウェーヴ": "لَوَّحَ, رَفْرَفَ / مَوْج, مَوْجَة",
 "ウエア": "لَبِسَ (خَلَطَ بحيث يصعب التمييز والفصل؛ الأمر: خلطه فاشتبه واضطرب) / اِرْتَدَى / اِهْتِراء\nمثال: لبس سروالا نظيفا. / بضائع, سلع (أصناف للبيع للمستهلك الفرد) / آنية, أدوات (أصناف من نفس النوع أو المادة؛ تستخدم عادة في التركيبات اللفظية)\nمثال: تعتمد التجارة الجيدة على وجود بضائع جيدة / بَرْمَجِيَات, بَرَامِج حَاسِب",
 "ウエアハウス": "مَخْزَن, مُسْتَوْدَع",
 "ウエアラブル": "قابل للارتداء (مناسب للارتداء أو يمكن ارتداؤه) / ثياب, كساء (غطاء مصمم ليتم ارتداؤه على جسم الإنسان)\nمثال: ملابس سهرة قابلة للارتداء",
 "ウエアー": "لَبِسَ (خَلَطَ بحيث يصعب التمييز والفصل؛ الأمر: خلطه فاشتبه واضطرب) / اِرْتَدَى / اِهْتِراء\nمثال: لبس سروالا نظيفا. / بضائع, سلع (أصناف للبيع للمستهلك الفرد) / آنية, أدوات (أصناف من نفس النوع أو المادة؛ تستخدم عادة في التركيبات اللفظية)\nمثال: تعتمد التجارة الجيدة على وجود بضائع جيدة / بَرْمَجِيَات, بَرَامِج حَاسِب",
 "ウエイクボード": "لوح تزلج مائي (ويك بورد) (لوح طافٍ (يشبه لوح ركوب الأمواج) يستخدم للركوب فوق الماء أثناء السحب خلف قارب بمحرك)",
 "ウエイター": "نَادِل, نَادِلَة",
 "ウエイティング": "انتظار, تَرَقُّب (فعل الانتظار (البقاء دون نشاط في مكان واحد توقعاً لشيء ما)) / رَهْنَ الإِشَارَة, مُنْتَظِر (جاهز ومتاح للاستخدام في أيّ وقت)\nمثال: كان الانتظار محنة بالنسبة له",
 "ウエイティングルーム": "غُرْفَةُ الاِنْتِظَار (اسم مفعول لما غُرِفَ من الماء وغيره باليد، الجمع غِرَاف؛ اسم؛ المكان في الدار أو المبنى محاط بأربع جدران وسقف، حُجْرَة، عِلِّيَّة. الجمع وغُرَف وغُرُفَات)\nمثال: الأب في الغرفة.",
 "ウエイティング・ルーム": "غُرْفَةُ الاِنْتِظَار (اسم مفعول لما غُرِفَ من الماء وغيره باليد، الجمع غِرَاف؛ اسم؛ المكان في الدار أو المبنى محاط بأربع جدران وسقف، حُجْرَة، عِلِّيَّة. الجمع وغُرَف وغُرُفَات)\nمثال: الأب في الغرفة.",
 "ウエイト": "وَزْن / ثِقْل (ثَقَلَ الشيءَ يَثْقُلُه بِيَدِهِ ثَقْلًا: رَازَ ثِقَلَه؛ ثَقَلَ الشَّيْء بِيَدِهِ ثقلا قدّر ثِقْلَه)\nمثال: ان ثقل ما تحمل، فضع بعضا منه. / أَهَمِّيَّة / اِنْتَظَرَ (تَرَقَّبَ؛ تَوَقَّعَ)\nمثال: انتظر حتى أجلس.",
