 "切り出し": "خُرْدَة / يتخلى, نبذ / شجار",
 "切り出す": "مَقْلَع / فَاتَحَ (الرجلُ المرأةَ: جامعها؛ عمرٌ زيدًا: قاضاه وحاكمه)\nمثال: شعري لونه بني فاتح.",
 "切り分ける": "نَحَتَ (وهو القَطْع والبَري والنشر والقشر وتشكيل الخشب أو الحجر أو غيره؛ الشيء الذي نُحِتَ، النقش أو التمثال أو غيره مما كان ناتج النحت)\nمثال: من علمك نحت الخشب. / عَزَلَ (فَصَلَ، فرَز، أَبْعَدَ؛ أَبْعَدَ، نَحَّى)\nمثال: جو بايدن طالب الكونغرس بعزل ترامب.",
 "切り刻む": "لَحْم مَفْرُوم (ما يبقى من جسم الحيوان أو الإنسان بعد إزالة الجلد الأحشاء والعظم والشحم والدم والأعصاب. يتكون أساسا من العَضَلَات؛ ما يؤكل من لحم من الحيوان والطير والسمك عامة)\nمثال: أفضل لحم البقر.",
 "切り割る": "جَرَحَ (كَلَمَ، شَقَّ اللَحْم وأسَالَ الدَمّ؛ صَادَ أو اكْتَسَبَ) / قَصَّ\nمثال: ذلك سيهيج الجرح.",
 "切り去る": "قَطَعَ (قطع الشيء : جزه؛ قطع الشيء : فصل بعضه عن بعضه الآخر)\nمثال: قطع زيري العشب.",
 "切り取り": "قُلَامَة / جَرَحَ (كَلَمَ، شَقَّ اللَحْم وأسَالَ الدَمّ؛ صَادَ أو اكْتَسَبَ) / قَصَّ\nمثال: ذلك سيهيج الجرح. / سَطْو / لُصُوصِيَّة",
 "切り取る": "قَطَعَ (قطع الشيء : جزه؛ قطع الشيء : فصل بعضه عن بعضه الآخر)\nمثال: قطع زيري العشب.",
 "切り口": "قِسْم, جُزْء (فَرَّقَ أو قَسَّمَ الشَّيءَ إلى أجزاء أو أجزاء مختلفة؛ أَحْلَفَ، أَي جَعَلَ يَحْلِفُ على أمرٍ ما) / مَقْطَع\nمثال: أنا أزين القسم. / وِجْهَة نَظَر, حَيْثِيَّة / وِجْهَة نَظَر",
 "切り回し": "إِدَارَة (هو عملية تولي تَصْرِيف شؤون العَمَل. لا جمع له؛ مجموع الناس الذين يقومون بإدارة شؤون الجهة، حكومية كانت أم خاصة)\nمثال: والدتي تنتظرني في الإدارة.",
 "切り回す": "أَدَارَ (دَارَ نصف دورة فقط؛ الشيء: جعله يدور؛ فعل تعدّي من دَارَ)\nمثال: أدار فاضل مقبض الباب بهدوء و دخل إلى المنزل.",
 "切り売り主義": "بِغَاءٌ, دَعَارَة",
 "切り子": "سَطْح (سَطحَهُ يَسْطَحَ سَطْحًا: بَسَطَهُ وسَوّاه؛ فهو مَسْطُوحٌ، وسَطِيحٌ) / جَانِب\nمثال: هناك ثقوب على السطح.",
 "切り屑": "خُرْدَة / يتخلى, نبذ / شجار",
 "切り岸": "جُرْف (أخذ شيئًا وجرفه بعيدًا، أو سحب شيئًا بقوة؛ في : في بعض الحالات، قد تستخدم للإشارة إلى إزالة أو جرف شيء نحو مكان آخر)\nمثال: وقف على حافة الجرف.",
 "切り崩す": "مُسْتَوًى / مَرْحَلَة / انفصل",
 "切り張り": "مُصَحِّح / رَقَّعَ ((رَقَعَ) الشيخُ ونحوُه رَقْعًا: اعْتَمَد على راحَتَيْه عند القيام؛ (رَقَعَ) في سَيْرِه: أسْرَع)",
 "切り戻し": "أَجَاص / عَوِينَة / عَوِينَة مُجَفَّفَة / خَوْخ مُجَفَّف / شَذَبَ, قَضَبَ",
 "切り手": "شَهَادَة",
 "切り払う": "أَجَاص / عَوِينَة / عَوِينَة مُجَفَّفَة / خَوْخ مُجَفَّف / شَذَبَ, قَضَبَ",
 "切り抜き": "قُلَامَة / مِشْبَك / كْلِيبْ",
 "切り抜く": "مُقْتَطَف / خلاصة",
 "切り抜ける": "هَزَمَ, غَلَبَ",
 "切り拓く": "شَفَّاف / وَاضِح",
 "切り捨て": "تَضْحِيَة, قُرْبَان / ضَحَّى / إِغْفَال",
 "切り捨てる": "اِنْصَرَفَ, يَنْصَرِفُ (فعل مطاوعة لصَرَفَ: صَرَفْتُهُ فَاَنْصَرَف؛ ذهب إلى مكان آخر) / تَرَكَ, يترك (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض)\nمثال: انصرف من ملكيتنا! / قَطْرَة / نُقْطَة (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه) / أَسْقَطَ ((أَسْقَطَ) في قوله أو فعله أخطأ وزل. ويقال تكلم فما أسقط في كلمة ما أخطأ؛ (أَسْقَطَ) له: خاطبه بسقط الكلام)\nمثال: هذه هي نقطة ضعفه. / قَتَلَ, أَزْهَقَ رُوحَهُ (تعمّد جعله يَمُوتُ، أزهق روحه، أمَاتَه متعمدا؛ الوقتَ: ضيعه بشيء غير ذي فائدة وهو ينتظر أمرا آخر)\nمثال: قتل الصياد دبا.",
 "切り接ぎ": "تَطْعِيم (زرع غصن من نوع من الشجر على غصن من نوع آخر، مثلا زرع غصن من البرتقال في شجرة ليمون لتكون النتيجة أن شجرة الليمون تنتج ليمونا وبرتقالا؛ علاج طبي يستهدف إلى منع الأمراض التي تتسبب من الجراثيم أو الفيروسات. استخدام حديث)",
 "切り換え": "تَبْدِيل, تَبَادُل / بُورْصَة, تَدَاوُل / تَبَادَلَ, صَرَفَ",
 "切り換える": "تَغَيَّرَƒ / غَيَّرَ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به) / تَغْيِير, تَبْدِيل / فَكَّة / بَاقٍ (باقٍ ، الباقِيٌ جمع باقون ( للعاقل ) وبَواقٍ ، مؤ باقية ، جمع مؤ باقيات وبَواقٍ؛ باقٍ إلَى الأبَدِ : خالِدٌ) / تَغْيِير\nمثال: أنا غير متفاجئ.",
 "切り放つ": "قَطَعَ (قطع الشيء : جزه؛ قطع الشيء : فصل بعضه عن بعضه الآخر)\nمثال: قطع زيري العشب.",
 "切り替え": "تَبْدِيل, تَبَادُل / بُورْصَة, تَدَاوُل / تَبَادَلَ, صَرَفَ",
 "切り替える": "تَغَيَّرَƒ / غَيَّرَ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به) / تَغْيِير, تَبْدِيل / فَكَّة / بَاقٍ (باقٍ ، الباقِيٌ جمع باقون ( للعاقل ) وبَواقٍ ، مؤ باقية ، جمع مؤ باقيات وبَواقٍ؛ باقٍ إلَى الأبَدِ : خالِدٌ) / تَغْيِير\nمثال: أنا غير متفاجئ.",
 "切り替わる": "تَغَيَّرَƒ / غَيَّرَ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به) / تَغْيِير, تَبْدِيل / فَكَّة / بَاقٍ (باقٍ ، الباقِيٌ جمع باقون ( للعاقل ) وبَواقٍ ، مؤ باقية ، جمع مؤ باقيات وبَواقٍ؛ باقٍ إلَى الأبَدِ : خالِدٌ) / تَغْيِير\nمثال: أنا غير متفاجئ.",
 "切り札": "وَرَقَة رَابِحَة",
 "切り杭": "جُذْمُور, كُنَّاشَة",
 "切り枝": "قَلَّمَ (قَطَعَ جزءا من شيء لتزيينه وتحسينه)\nمثال: ارسم بقلم رصاص.",
 "切り枯らす": "دَمَّرَ",
 "切り株": "جِذْع, جِذْل (في علم النبات: أحد أجزاء النبات الذي يحمل الأغصان ويتصل في أسفله بالجذر)",
 "切り欠く": "جَرَحَ (كَلَمَ، شَقَّ اللَحْم وأسَالَ الدَمّ؛ صَادَ أو اكْتَسَبَ) / قَصَّ\nمثال: ذلك سيهيج الجرح.",
 "切り殺す": "قَتَلَ, أَزْهَقَ رُوحَهُ (تعمّد جعله يَمُوتُ، أزهق روحه، أمَاتَه متعمدا؛ الوقتَ: ضيعه بشيء غير ذي فائدة وهو ينتظر أمرا آخر)\nمثال: قتل الصياد دبا.",
 "切り盛り": "إِدَارَة (هو عملية تولي تَصْرِيف شؤون العَمَل. لا جمع له؛ مجموع الناس الذين يقومون بإدارة شؤون الجهة، حكومية كانت أم خاصة)\nمثال: والدتي تنتظرني في الإدارة.",
 "切り目": "جَرَحَ (كَلَمَ، شَقَّ اللَحْم وأسَالَ الدَمّ؛ صَادَ أو اكْتَسَبَ) / قَصَّ\nمثال: ذلك سيهيج الجرح. / نِهَايَة, غَايَة / غَايَة / اِنْتَهَى, أَنْهَى (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات)\nمثال: انتهى أمر زيري.",
 "切り石": "بَلَاط",
 "切り立てる": "جَرَحَ (كَلَمَ، شَقَّ اللَحْم وأسَالَ الدَمّ؛ صَادَ أو اكْتَسَبَ) / قَصَّ\nمثال: ذلك سيهيج الجرح.",
 "切り端": "خُرْدَة / يتخلى, نبذ / شجار",
 "切り籠": "سَطْح (سَطحَهُ يَسْطَحَ سَطْحًا: بَسَطَهُ وسَوّاه؛ فهو مَسْطُوحٌ، وسَطِيحٌ) / جَانِب\nمثال: هناك ثقوب على السطح.",
 "切り組む": "تَعْشِيقَة / عَشَّقَ (فرط الحب حتى لا يستطيع العاشق الابتعاد عن المعشوق) / اِنْسَجَمَ مَعَ, رَكَّبَ\nمثال: أغاني العشق تحرك مشاعري.",
 "切り継ぎ": "تَطْعِيم (زرع غصن من نوع من الشجر على غصن من نوع آخر، مثلا زرع غصن من البرتقال في شجرة ليمون لتكون النتيجة أن شجرة الليمون تنتج ليمونا وبرتقالا؛ علاج طبي يستهدف إلى منع الأمراض التي تتسبب من الجراثيم أو الفيروسات. استخدام حديث)",
 "切り羽": "وَجْه, مُحَيًّا (الإِنْسَان: هو مقدم رأسه الذي يُوَجِهَهُ إلى الناس؛ ضد الظَهْر، ما يقع في المقدمة أو ما يوَجَه إلى الناس) / مَظْهَر (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / وَاجَهَ (تَقَابَلَ معه وَجها لوجه؛ الجندي العدو: استقبله مواجهة ليقاتله أو يناضل ضده)\nمثال: تبدو شاحب الوجه.",
 "切り苛む": "عَذَاب / عَذَّبَ",
 "切り落し": "قُلَامَة",
 "切り落す": "قَطَعَ (قطع الشيء : جزه؛ قطع الشيء : فصل بعضه عن بعضه الآخر)\nمثال: قطع زيري العشب.",
 "切り落とし": "قُلَامَة",
 "切り落とす": "قَطَعَ (قطع الشيء : جزه؛ قطع الشيء : فصل بعضه عن بعضه الآخر)\nمثال: قطع زيري العشب.",
 "切り裂きジャック": "جَاك اَلسَّفَّاح",
 "切り解く": "أَطْلَقَ سَرَاح, حَرَّرَ",
 "切り詰める": "قَصَّرَ (ضد الطول؛ غير تام، غير كامل)\nمثال: لقد قصر الخطاب. / قَلَّلَ",
 "切り調える": "شَذَّبَ, قَلَّمَ",
 "切り貼り": "مُصَحِّح / رَقَّعَ ((رَقَعَ) الشيخُ ونحوُه رَقْعًا: اعْتَمَد على راحَتَيْه عند القيام؛ (رَقَعَ) في سَيْرِه: أسْرَع)",
 "切り身": "جَرَحَ (كَلَمَ، شَقَّ اللَحْم وأسَالَ الدَمّ؛ صَادَ أو اكْتَسَبَ) / قَصَّ\nمثال: ذلك سيهيج الجرح.",
 "切り込み": "جَرَحَ (كَلَمَ، شَقَّ اللَحْم وأسَالَ الدَمّ؛ صَادَ أو اكْتَسَبَ) / قَصَّ\nمثال: ذلك سيهيج الجرح. / مُدَاهَمَة / غَارَة, غَزْوَة / أَغَارَ, اِقْتَحَمَ / أَغَارَ",
 "切り込む": "مُدَاهَمَة / غَارَة, غَزْوَة / أَغَارَ, اِقْتَحَمَ / أَغَارَ",
 "切り進む": "شَقَّ, فَسَخَ ((شَقَّ) الفَرَسُ ونحوُهُ يَشِقَّ شَقَقًا: مال في جَرْيِهِ إِلى جانب؛ فهو أشَقُّ، وهي شَقَّاءُ)\nمثال: اكشف عن الشق العلوي من الجسم.",
 "切り開き": "شَفَّاف / وَاضِح",
 "切り開く": "شَفَّاف / وَاضِح",
 "切り除ける": "قَطَعَ (قطع الشيء : جزه؛ قطع الشيء : فصل بعضه عن بعضه الآخر)\nمثال: قطع زيري العشب.",
 "切り離す": "قَطَعَ (قطع الشيء : جزه؛ قطع الشيء : فصل بعضه عن بعضه الآخر)\nمثال: قطع زيري العشب.",
 "切る": "جَرَحَ (كَلَمَ، شَقَّ اللَحْم وأسَالَ الدَمّ؛ صَادَ أو اكْتَسَبَ) / قَصَّ\nمثال: ذلك سيهيج الجرح. / جَذَبَ, قَطَعَ (شَدَّ الشيءَ نحوه بقوة؛ لفَتَ الانتباه أو أثارَ الاهتمام)\nمثال: استعملت ريمة لجذب الانتباه. / عَلَّقَ / أَغْلَقَ الْخَطّ (ضد فَتَحَ؛ سَدَّ وسَكَّرَ؛ قد تستخدم بمعنى أَقْفَلَ؛ أغلقه بحيث لا يفتح إلا بمفتاح)\nمثال: أغلق الباب بغضب / لَكْمَة / لَكَمَ (معناه: ضرب بقبضة اليد أو اللكم؛ معنى آخر: الضرب بشدة) / خَرَّامَة\nمثال: لكم اشتقت إليك!",
 "切れ": "قِطْعَة (القِطْعَةُ: الْجُزْءَ أو الحِصَّة من الشيءِ؛ القِطْعَةُ: فقرة قصيرة عادة من مقالٍ أو كتاب)\nمثال: يصنع قطعة أثاث خشبية. / قُمَاش, أقمشة (النسيج الذي لم يُقَصّ أو يُخَاط) / مِمْسَحَة\nمثال: الورق و القماش يمتصان الماء.",
 "切れが悪い": "سَمِيك, غَلِيظ / غَلِيظ",
 "切れっぱし": "خُرْدَة / يتخلى, نبذ / شجار",
 "切れっ端": "خُرْدَة / يتخلى, نبذ / شجار",
 "切れはし": "قِطْعَة, شَقَفَة (القِطْعَةُ: الْجُزْءَ أو الحِصَّة من الشيءِ؛ القِطْعَةُ: فقرة قصيرة عادة من مقالٍ أو كتاب)\nمثال: يصنع قطعة أثاث خشبية.",
 "切れる": "اِنْكَسَرَ (فعل مطاوعة لكَسَرَ، قام أحدهم بكَسْره أو قام هو بكَسْر نفسه؛ التاجر: خَسِرَ المال ونَقَصَ عنده المال، أفْلَسَ) / كَسَرَ / اِسْتِرَاحَة (مبنى خارج المدن يتوقف فيه المسافرون للراحة والتَزَوُّد يُجمع على اِسْتِرَاحَات)\nمثال: عليك أخذ استراحة. / نَفِدَ / نَبْض / ضَرَبَ, دَقَّ (معروف، وهو اللطم أو الدق أو الصكّ و ما أشبه؛ النَوْع أو الصنف أو المثال) / وَجَفَ / هَزَمَ, غَلَبَ / خَفَقَ (الجذر يعبر عن الحركة والاضطراب الخفيف الذي ينشأ عن الرياح أو القلوب أو الرايات، ويستخدم لوصف الطبيعة والأحاسيس والجوانب الحسية المختلفة؛ عبّر عن حركة سريعة، سواء كانت اضطراباً أو ضرباً خفيفاً أو صوتاً، بالإضافة إلى صفةٍ تُوصف بها الخيل)\nمثال: ضرب سامي زوجته. / منحنى",
 "切れ切れ": "قِطْعَة (القِطْعَةُ: الْجُزْءَ أو الحِصَّة من الشيءِ؛ القِطْعَةُ: فقرة قصيرة عادة من مقالٍ أو كتاب)\nمثال: يصنع قطعة أثاث خشبية.",
 "切れ口": "قِسْم, جُزْء (فَرَّقَ أو قَسَّمَ الشَّيءَ إلى أجزاء أو أجزاء مختلفة؛ أَحْلَفَ، أَي جَعَلَ يَحْلِفُ على أمرٍ ما) / مَقْطَع\nمثال: أنا أزين القسم.",
 "切れ味": "مَهَارَة",
