 "アプリコット": "مِشْمِش",
 "アプルーバル": "قُبُول, قَبُول (القبول: الرِّضَا بالشيء وميل النفس إليه والحسن والشارة وريح الصبا؛ (المعجم الوسيط)؛ ريح شرقية)\nمثال: أميل إلى قبول العرض.",
 "アプルーブ": "صَدَّقَ, وَافَقَ (نقيض الْكِذْب والكَذِب؛ قول ما يعتقدهُ القائل مطابقا للوَاقِع) / اِسْتَحَسَنَ, وَافَقَ (عَدَّه حَسَنا بمعنى جميل؛ عدَّه حسنًا بمعنى جَيِّد) / وَافَقَ (صَادَفَ؛ صَادَقَ)\nمثال: صدق سامي كل شيء.",
 "アプレット": "بريمج, تطبيق مصغر (تطبيق جافا؛ برنامج تطبيقي يستخدم متصفح الويب الخاص بالعميل لتوفير واجهة مستخدم)",
 "アプロディテ": "أَفْرُودِيت",
 "アプロディーテ": "أَفْرُودِيت",
 "アプロディーテー": "أَفْرُودِيت",
 "アプロプリエーション": "استيلاء, مصادرة (فعل متعمد لاكتساب شيء ما، غالباً دون إذن المالك) / استيلاء, ضم (الدمج عن طريق الانضمام أو الاتحاد) / اعتماد مالي, مخصصات مالية (أموال مخصصة (كما من قبل هيئة تشريعية) لغرض محدد)\nمثال: تم الحصول على الأموال اللازمة من خلال استيلاء الحكومة على الوحدة التشغيلية للشركة",
 "アプローズ": "تَصْفِيق",
 "アプローチ": "اِقْتَرَبَ / اِقْتِرَاب, مُقَارَبَة (اقتراب) / كَيْفِيَّة, طَرِيقَة\nمثال: هو واصل الاقتراب مني. / ضربة اقتراب (ضربة غولف قصيرة نسبياً تهدف لوضع الكرة في المنطقة الخضراء)\nمثال: خسر الحفرة عندما تدحرجت ضربة اقترابه وتجاوزت المنطقة الخضراء",
 "アプローチショット": "ضربة اقتراب (ضربة غولف قصيرة نسبياً تهدف لوضع الكرة في المنطقة الخضراء)\nمثال: خسر الحفرة عندما تدحرجت ضربة اقترابه وتجاوزت المنطقة الخضراء",
 "アプローチ・ショット": "ضربة اقتراب (ضربة غولف قصيرة نسبياً تهدف لوضع الكرة في المنطقة الخضراء)\nمثال: خسر الحفرة عندما تدحرجت ضربة اقترابه وتجاوزت المنطقة الخضراء",
 "アプロード": "صَفَّقَ",
 "アヘアヘ": "بِابْتِهَاج غَامِر, بِنَشْوَة (بطريقة منتشية)\nمثال: تفاعل بابتهاج غامر مع خطتي للسفر إلى أفريقيا",
 "アヘッド": "أماماً, في المقدمة (في أو في المقدمة) / سلفاً, مسبقاً (قبل الوقت؛ تحسباً) / إلى الأمام, قدماً (في اتجاه أمامي) / في الصدارة, متقدماً (يتقدم أو يسبق في منافسة)\nمثال: أرى أضواء مدينة أمامنا",
 "アヘン": "أَفْيُون",
 "アヘンチンキ": "صبغة الأفيون, لودانوم (مخدر يتكون من محلول كحولي للأفيون أو أي مستحضر يكون الأفيون فيه المكون الرئيسي)",
 "アヘン剤": "أَفْيُونِيّ",
 "アヘン窟": "وكر أفيون (مبنى يتم فيه بيع الأفيون واستخدامه)",
 "アベイラビリティ": "تَوَفُّر",
 "アベイラビリティー": "تَوَفُّر",
 "アベイラブル": "مُتَاح (ممكن، مسموح)\nمثال: يجب أن تكون نتائج البحث متاحة للجميع.",
