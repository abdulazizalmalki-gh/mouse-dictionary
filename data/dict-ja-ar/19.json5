 "イードアルアドハー": "عِيد اَلْأَضْحَى, اَلْأَضْحَى",
 "イードアルフィトル": "عِيد الْفِطْر",
 "イード・アルアドハー": "عِيد اَلْأَضْحَى, اَلْأَضْحَى",
 "イード・アルフィトル": "عِيد الْفِطْر",
 "イービットダー": "إبيتدا, الأرباح قبل الفوائد والضرائب والإهلاك والاستهلاك (الدخل قبل طرح الفوائد والضرائب والإهلاك والاستهلاك؛ مؤشر لربحية الشركة يراقبه المستثمرون (خاصة في عمليات الاستحواذ بالرافعة المالية))",
 "イービットディーエー": "إبيتدا, الأرباح قبل الفوائد والضرائب والإهلاك والاستهلاك (الدخل قبل طرح الفوائد والضرائب والإهلاك والاستهلاك؛ مؤشر لربحية الشركة يراقبه المستثمرون (خاصة في عمليات الاستحواذ بالرافعة المالية))",
 "イービル": "شِرِّير, شَرِير (الكَثير الشَرّ بمعنى اسم جامع للرذائل، قد يستعمل كاسم فاعل؛ ضد الخَيِّر؛ يستخدم أيضا بمعنى ذو الشَرّ وما تسبب بالشرّ) / شَرّ, سَوْء (ضد الخَيْر؛ السوء والفساد والرذائل والخطايا وقيل الشرّ يضم كل الرذائل؛ اسم تفضيل، الأكثر شَرّا، أصله أشرّ وحذفت الألف) / شَرّ (ضد الخَيْر؛ السوء والفساد والرذائل والخطايا وقيل الشرّ يضم كل الرذائل؛ اسم تفضيل، الأكثر شَرّا، أصله أشرّ وحذفت الألف)\nمثال: لقد وصف سامي ليلى كشخص شرير إلى حد يكاد لا يصدق.",
 "イービー": "كِتَاب إِلِكْتْرُونِيّ, إِيبُوك (موضع تعليم الكتابة. الاستخدام الأصلي؛ مدرسة شبه رسمية لتعليم الأطفال الكِتَابَة والقِرَاءَة ومباديء الحِسَاب وبعض القُرَآن…)\nمثال: هذا الكتاب جديد / حزمة إشعاعية, حزمة إلكترونية (مجموعة من خطوط الإشعاع الكهرومغناطيسي المتوازية تقريباً)",
 "イービーウイルス": "فيروس إبشتاين-بار (فيروس هربس يسبب كثرة الوحيدات العدوائية؛ ويرتبط بسرطانات محددة في أفريقيا والصين)",
 "イーピー": "خطة أوروبية, خطة كونتيننتال (خطة فندقية توفر إفطاراً خفيفاً (كونتيننتال) يومياً)",
 "イーピーロム": "إيبروم, ذاكرة القراءة فقط القابلة للمحى والبرمجة ((في علم الحاسوب) شريحة ذاكرة للقراءة فقط يمكن مسحها بالأشعة فوق البنفسجية وبرمجتها مرة أخرى ببيانات جديدة)",
 "イーブイ": "سَيَّارَة كَهْرَبَائِيَّة (مؤنث سَيَّار، صفة للكثير السَيْر؛ القَافِلَة أوالقَوْم الذين يسيرون)\nمثال: إنه يملك سيارة. / مِصْعَدْ / إلكترون فولت (وحدة طاقة تساوي الشغل الذي يبذله إلكترون يتسارع عبر فرق جهد قدره 1 فولت)",
 "イーブル": "شِرِّير, شَرِير (الكَثير الشَرّ بمعنى اسم جامع للرذائل، قد يستعمل كاسم فاعل؛ ضد الخَيِّر؛ يستخدم أيضا بمعنى ذو الشَرّ وما تسبب بالشرّ) / شَرّ, سَوْء (ضد الخَيْر؛ السوء والفساد والرذائل والخطايا وقيل الشرّ يضم كل الرذائل؛ اسم تفضيل، الأكثر شَرّا، أصله أشرّ وحذفت الألف) / شَرّ (ضد الخَيْر؛ السوء والفساد والرذائل والخطايا وقيل الشرّ يضم كل الرذائل؛ اسم تفضيل، الأكثر شَرّا، أصله أشرّ وحذفت الألف)\nمثال: لقد وصف سامي ليلى كشخص شرير إلى حد يكاد لا يصدق.",
 "イーブン": "مُسَطَّح, مُنبَسِط / أَمْلَس, سَوِيّ / زَوْجِيّ / حَتَّى (يفيد انتهاء الغاية؛ يفيد الغاية)\nمثال: انتظر حتى أجلس.",
 "イーベイ": "إِيبَاي",
 "イーメイル": "بَرِيد إِلِكْتْرُونِيّ, إِيمَيْل / إِيمَيْل, رِسَالَة إِلِكْتْرُونِيّّة",
 "イーメール": "بَرِيد إِلِكْتْرُونِيّ, إِيمَيْل / إِيمَيْل, رِسَالَة إِلِكْتْرُونِيّّة",
 "イーメールアドレス": "عنوان بريد إلكتروني (مُعرِّف يستخدمه الشخص كهوية له للتواصل عبر نظام البريد الإلكتروني)",
 "イーユー": "الاتحاد الأوروبي, السوق الأوروبية المشتركة (منظمة دولية للدول الأوروبية تشكلت بعد الحرب العالمية الثانية لتقليل الحواجز التجارية وزيادة التعاون بين أعضائها) / يوروبيوم (عنصر فلزي ثنائي وثلاثي التكافؤ من مجموعة الأتربة النادرة)\nمثال: حاول إدخال بريطانيا في الاتحاد الأوروبي",
 "イーリアス": "الإِلْيَاذَة",
 "イールド": "أَجْزَأَ (أَجْزَأَ القومُ: جَزَأَتْ إِبِلُهُمْ؛ أَجْزَأَ المرأَةُ: ولدت الإِنَاث) / أَجْزَى / أَدَرَّ ((أَدِرَ) أدرا وأدرة وأدرة: انتفخت خصيته لتسرب سائل في غلافها فهو آدر وأدرت الخصية فهي أدراء (ج) أدر) / أَغَلَّ / أَكْسَبَ / أَمَّنَ (وَثِقَ به وأرْكَنَ إليه) / إِفَادَة / إِفَادَةٌ مِنْ / إِنْتاج / إِيراد / اِسْتِفَادَة / جَدَاء\nمثال: لا أدر لماذا بكيت هذا القدر كله.",
 "イー・イー・シー": "الاتحاد الأوروبي, السوق الأوروبية المشتركة (منظمة دولية للدول الأوروبية تشكلت بعد الحرب العالمية الثانية لتقليل الحواجز التجارية وزيادة التعاون بين أعضائها)\nمثال: حاول إدخال بريطانيا في الاتحاد الأوروبي",
 "イー・エス・エム": "تدابير دعم الحرب الإلكترونية (حرب إلكترونية تتم تحت السيطرة المباشرة لقائد عملياتي لتحديد مصادر الطاقة الكهرومغناطيسية المشعة لغرض التعرف الفوري على التهديد)",
 "イー・エス・ピー": "إدراك خارج الحواس, استبصار (قوة ظاهرية لإدراك أشياء غير موجودة للحواس)",
 "イー・エックス": "مُنْقَرِض",
 "イー・エム・エス": "إِم",
 "イー・エル・ブイ": "مِصْعَدْ",
 "イー・オー・エス": "إييوس",
 "イー・キュー": "مكافئ, وزن مكافئ (الوزن الذري لعنصر له نفس سعة الاتحاد لوزن معين من عنصر آخر؛ المعيار هو 8 للأكسجين) / هدف التعادل (تسجيل يجعل النتيجة متساوية) / ثقل موازن (وزن يوازن وزناً آخر) / إيكولايزر, معادل الصوت (معدات إلكترونية تقلل من تشويه التردد)",
 "イー・コマース": "تِجَارَة إِلِكْتْرُونِيَّة",
 "イー・シー": "الاتحاد الأوروبي, السوق الأوروبية المشتركة (منظمة دولية للدول الأوروبية تشكلت بعد الحرب العالمية الثانية لتقليل الحواجز التجارية وزيادة التعاون بين أعضائها)\nمثال: حاول إدخال بريطانيا في الاتحاد الأوروبي / تِجَارَة إِلِكْتْرُونِيَّة",
 "イー・シー・エム": "إجراءات إلكترونية مضادة (حرب إلكترونية يتم القيام بها لمنع أو تقليل الاستخدام الفعال للعدو للطيف الكهرومغناطيسي)",
 "イー・シー・シー・エス": "رمز تصحيح الخطأ ((الأتصالات) نظام تشفير يدمج بتات تماثل إضافية من أجل اكتشاف الأخطاء)",
 "イー・ダブリュー・エス": "يَع",
 "イー・ツー・イー": "بالكامل, من البداية إلى النهاية (من الأول إلى الأخير) / مِن طَرَف إِلَى طَرَف (بِحَيْث يَتَلامَس طَرَف شَيْء مَع طَرَف شَيْء آخَر طولِيًّا)\nمثال: المسرحية كانت ممتازة من البداية إلى النهاية",
 "イー・ツー・イー・イー": "بالكامل, من البداية إلى النهاية (من الأول إلى الأخير) / مِن طَرَف إِلَى طَرَف (بِحَيْث يَتَلامَس طَرَف شَيْء مَع طَرَف شَيْء آخَر طولِيًّا)\nمثال: المسرحية كانت ممتازة من البداية إلى النهاية",
 "イー・ティー・エフ": "صندوق متداول في البورصة (صندوق استثمار مشترك يتم تداوله في سوق الأوراق المالية)",
 "イー・ティー・エー": "إِتَا",
 "イー・ティー・ディー": "كشف أثر المتفجرات (نظام لفحص الأمتعة في المطارات؛ يمرر الوكيل مسحة حول الأمتعة أو داخلها ثم يمرر المسحة عبر جهاز يمكنه اكتشاف كميات ضئيلة من المتفجرات)",
 "イー・ディー": "خلل الانتصاب, ضعف الانتصاب (عجز ناتج عن عدم قدرة الرجل على الحصول على انتصاب للقضيب أو الحفاظ عليه)",
 "イー・ディー・ティー・エー": "إيثيلين ثنائي الأمين رباعي حمض الأسيتيك (جزيء معقد يستخدم طبياً لإزالة أيونات المعادن (الاستخلاب) في حالات التسمم بالرصاص أو المعادن الثقيلة)",
 "イー・ビット・ダー": "إبيتدا, الأرباح قبل الفوائد والضرائب والإهلاك والاستهلاك (الدخل قبل طرح الفوائد والضرائب والإهلاك والاستهلاك؛ مؤشر لربحية الشركة يراقبه المستثمرون (خاصة في عمليات الاستحواذ بالرافعة المالية))",
 "イー・ビット・ディー・エー": "إبيتدا, الأرباح قبل الفوائد والضرائب والإهلاك والاستهلاك (الدخل قبل طرح الفوائد والضرائب والإهلاك والاستهلاك؛ مؤشر لربحية الشركة يراقبه المستثمرون (خاصة في عمليات الاستحواذ بالرافعة المالية))",
 "イー・ビー": "كِتَاب إِلِكْتْرُونِيّ, إِيبُوك (موضع تعليم الكتابة. الاستخدام الأصلي؛ مدرسة شبه رسمية لتعليم الأطفال الكِتَابَة والقِرَاءَة ومباديء الحِسَاب وبعض القُرَآن…)\nمثال: هذا الكتاب جديد / حزمة إشعاعية, حزمة إلكترونية (مجموعة من خطوط الإشعاع الكهرومغناطيسي المتوازية تقريباً)",
 "イー・ピー": "خطة أوروبية, خطة كونتيننتال (خطة فندقية توفر إفطاراً خفيفاً (كونتيننتال) يومياً)",
 "イー・ブイ": "سَيَّارَة كَهْرَبَائِيَّة (مؤنث سَيَّار، صفة للكثير السَيْر؛ القَافِلَة أوالقَوْم الذين يسيرون)\nمثال: إنه يملك سيارة. / مِصْعَدْ / إلكترون فولت (وحدة طاقة تساوي الشغل الذي يبذله إلكترون يتسارع عبر فرق جهد قدره 1 فولت)",
 "イー・ユー": "الاتحاد الأوروبي, السوق الأوروبية المشتركة (منظمة دولية للدول الأوروبية تشكلت بعد الحرب العالمية الثانية لتقليل الحواجز التجارية وزيادة التعاون بين أعضائها) / يوروبيوم (عنصر فلزي ثنائي وثلاثي التكافؤ من مجموعة الأتربة النادرة)\nمثال: حاول إدخال بريطانيا في الاتحاد الأوروبي",
 "イ短調": "صَغِير, مَحْدُود النِّطَاق (صَغير الحَجْم أَوْ مَحْدود في النِّطاق أَوْ الأَهَمِّيَّة) / أصغر, أقلية (أقل في العدد أو الحجم أو المقدار) / بسيط, ثانوي (أقل في النطاق أو التأثير) / قاصر (لم يبلغ السن القانونية)\nمثال: حصة صغيرة من الأرباح",
 "イ草": "أسل شائع, سمار ناعم (أسل طويل بسيقان ناعمة منتصبة أو مقوسة يوجد في أوراسيا وأستراليا ونيوزيلندا وشائع في أمريكا الشمالية)",
 "イ語": "لغة يي, لولو (لغة لولو، يتحدث بها شعب يي أو لولو في الصين وفيتنام وتايلاند)",
 "イ長調": "رَائِد",
 "ウ": "غَاقِيَات / أُوكْرَانِيَا (دولة تقع في شرق قارة أوروبا، وتحد الساحل الشمالي من البحر الأسود؛ أُسِّسَت كدولة مستقلة بعد سقوط الاتحاد السوفياتي عام ١٩٩١…)\nمثال: المجد لأوكرانيا",
 "ウ〜ン": "بَلَى, مبلا (يفيد إبطال النفي؛ في : نَعَمْ في كل حالاتها عدا جواب النِدَاء في بعض لهجات الشام، في بعض اللهجات الشامية الأخرى يقال مبَلَى…) / نَعَم, نَعَمَانِ (الإبِل والبَقَر والغَنَم. وتسمى نَعَم فقط إذا كان فيها إبل، فالإبل لوحدها نَعَم…)\nمثال: هذه ليست جملة, بل مجموعة من الكلمات بلى معنى. / هَمْهَمَة (اِسْمٌ لِصَوْتِ الأَسَد) / هَمْهَمَ, دَنْدَنَ\nمثال: انا اسمع ضجيج المروحة و صوت نزول قطرات الماء من الصنبور و همهمة الثلاجة و تكتكة الساعة و هبوب الهواء عند مرور السيارات بالقرب من المنزل .",
 "ウアカリ": "سعدان الواكاري, واكاري (قرد متوسط الحجم يعيش على الأشجار في حوض الأمازون؛ وهو القرد الوحيد في العالم الجديد ذو ذيل قصير)",
 "ウィ": "بَلَى, مبلا (يفيد إبطال النفي؛ في : نَعَمْ في كل حالاتها عدا جواب النِدَاء في بعض لهجات الشام، في بعض اللهجات الشامية الأخرى يقال مبَلَى…) / نَعَم, نَعَمَانِ (الإبِل والبَقَر والغَنَم. وتسمى نَعَم فقط إذا كان فيها إبل، فالإبل لوحدها نَعَم…)\nمثال: هذه ليست جملة, بل مجموعة من الكلمات بلى معنى.",
 "ウィウィ": "بَلَى, مبلا (يفيد إبطال النفي؛ في : نَعَمْ في كل حالاتها عدا جواب النِدَاء في بعض لهجات الشام، في بعض اللهجات الشامية الأخرى يقال مبَلَى…) / نَعَم, نَعَمَانِ (الإبِل والبَقَر والغَنَم. وتسمى نَعَم فقط إذا كان فيها إبل، فالإبل لوحدها نَعَم…)\nمثال: هذه ليست جملة, بل مجموعة من الكلمات بلى معنى.",
 "ウィキ": "وِيكِي / وِيكِيبِيدِيَا (موسوعة ويكي مجانية المحتوى ومتعددة اللغات على الإنترنت تديرها مؤسسة ويكيميديا؛ (مَجَازِيًّا) المجتمع الذي يطور ويكيبيديا)\nمثال: استعمل ويكيبيديا.",
 "ウィキペデア": "وِيكِيبِيدِيَا (موسوعة ويكي مجانية المحتوى ومتعددة اللغات على الإنترنت تديرها مؤسسة ويكيميديا؛ (مَجَازِيًّا) المجتمع الذي يطور ويكيبيديا)\nمثال: استعمل ويكيبيديا.",
 "ウィキペディア": "وِيكِيبِيدِيَا (موسوعة ويكي مجانية المحتوى ومتعددة اللغات على الإنترنت تديرها مؤسسة ويكيميديا؛ (مَجَازِيًّا) المجتمع الذي يطور ويكيبيديا)\nمثال: استعمل ويكيبيديا.",
 "ウィキペディアン": "وِيكِيبِيدِيّ, وِيكِيبِيدِيَّة",
 "ウィキペデイア": "وِيكِيبِيدِيَا (موسوعة ويكي مجانية المحتوى ومتعددة اللغات على الإنترنت تديرها مؤسسة ويكيميديا؛ (مَجَازِيًّا) المجتمع الذي يطور ويكيبيديا)\nمثال: استعمل ويكيبيديا.",
 "ウィク": "فَتِيل, فَتِيلَة",
 "ウィクショナリー": "وِيكَامُوس (اسم مشروع للقَامُوس الحُرّ)\nمثال: مرحبا بك في ويكاموس.",
 "ウィグラー": "دودة الأرض (دودة برية تحفر في التربة وتساعد في تهويتها؛ تظهر غالباً عندما تكون الأرض باردة أو رطبة؛ تستخدم كطعم من قبل الصيادين) / يرقة البعوض (يرقة البعوض) / كَثِير الْحَرَكَة, مُتَمَلْمِل (شخص لا يستطيع البقاء ساكناً (خاصة الطفل))\nمثال: كان الطفل الصغير كثير الحركة حقاً في رحلات الطائرة",
 "ウィグル": "الخط الأويغوري (الخط (المشتق من الآرامية) المستخدم لكتابة اللغة الأويغورية) / الأويغورية (اللغة التركية التي يتحدث بها ما يقرب من 7,000,000 من الأويغور في أقصى شمال غرب الصين) / إيغوري (عضو في شعب يتحدث الإيغورية ويعيش في شينجيانغ والمناطق المجاورة)",
 "ウィグワム": "كوخ ويغوام (كوخ للهنود الحمر غالباً ما يكون بيضاوي الشكل ومغطى باللحاء أو الجلود)",
 "ウィケット": "خَوْخَة",
 "ウィザ": "صَعَقَ",
 "ウィザー": "صَعَقَ",
 "ウィザード": "سَاحِر, مُشَعْوِذ",
 "ウィザードリィ": "سحر, عبقرية (قدرة إبداعية استثنائية)",
 "ウィザードリー": "سحر, عبقرية (قدرة إبداعية استثنائية)",
 "ウィジウィグ": "مطابق للعرض (متعلق بـ أو كونه نظام معالجة نصوص يطبع النص تماماً كما يظهر على شاشة الكمبيوتر)",
 "ウィジェット": "آلة مبتكرة, أداة (جهاز أو أداة تحكم مفيدة جداً لأداء عمل معين) / أداة, أداة مبهمة الاسم (شيء غير محدد تم نسيان اسمه أو غير معروف)\nمثال: أعادت الأداة كروية الشكل إلى مكانها",
 "ウィジャばん": "لوحة الويجا (لوحة عليها الحروف الأبجدية؛ تستخدم مع مؤشر لتهجئة رسائل خارقة للطبيعة)",
 "ウィジャボード": "لوحة الويجا (لوحة عليها الحروف الأبجدية؛ تستخدم مع مؤشر لتهجئة رسائل خارقة للطبيعة)",
 "ウィジャ・ボード": "لوحة الويجا (لوحة عليها الحروف الأبجدية؛ تستخدم مع مؤشر لتهجئة رسائل خارقة للطبيعة)",
 "ウィジャ盤": "لوحة الويجا (لوحة عليها الحروف الأبجدية؛ تستخدم مع مؤشر لتهجئة رسائل خارقة للطبيعة)",
 "ウィスカー": "شَارِب, كُلْبَة",
 "ウィスキ": "ويسكي (مشروب مصنوع من هريس الحبوب المخمر)",
 "ウィスキー": "ويسكي (مشروب مصنوع من هريس الحبوب المخمر)",
 "ウィスキーサワー": "ويسكي ساور (كوكتيل ساور مصنوع بالويسكي)",
 "ウィスキー・サワー": "ويسكي ساور (كوكتيل ساور مصنوع بالويسكي)",
 "ウィスコンシン": "وِيسْكُنْسِن, وِيسْكُونْسِن",
 "ウィスタリア": "ستارية, ويستيريا",
 "ウィステリア": "ستارية, ويستيريا",
 "ウィスト": "ويست (لعبة ورق لأربعة لاعبين يشكلون شراكتين؛ يتم توزيع حزمة من 52 ورقة ويسجل كل جانب نقطة واحدة لكل جولة يأخذها تزيد عن ستة)",
 "ウィスパー": "هَمْس / هَمَسَ, وَسْوَسَ",
 "ウィズ": "مَعَ (يفيد الاجتماع والمصاحبة؛ مكان الاجتماع) / بِـ (الإلصاق: أمسكت بالشيء؛ الاستعانة: كتبت بالقلم)\nمثال: جئت مع أصدقائي.",
