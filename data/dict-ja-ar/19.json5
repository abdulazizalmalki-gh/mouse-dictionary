 "オーバー・エージ": "عَفَا عَلَيْه الزَّمَن, مُتَجَاوِز السِّنّ (تجاوز السنّ المناسبة بحيث لم يعد صالحاً للعمل) / زيادة, فائض (فائض أو زيادة في المال أو البضائع الموجودة فعلياً والتي تتجاوز التوقعات)",
 "オーバー・ドクター": "باحث ما بعد الدكتوراه (باحث يشارك في دراسة أكاديمية تتجاوز مستوى درجة الدكتوراه) / منحة ما بعد الدكتوراه (منحة تمول دراسة أو بحث ما بعد الدكتوراه)",
 "オーバー・ドライブ": "أوفردرايف, سرعة زائدة (ترس عالٍ يستخدم بسرعات عالية للحفاظ على سرعة القيادة بطاقة خرج أقل) / طاقة قصوى, نشاط مفرط (حالة النشاط العالي أو المفرط أو الإنتاجية أو التركيز)\nمثال: القوات مستعدة للعمل بطاقة قصوى بمجرد إعطاء الإشارة",
 "オーバー・フェンス": "إصابة الهدف, نجاح تام (شيء ينجح تماماً في تحقيق هدفه) / ركضة كاملة, هوم ران (ضربة تتيح للضارب الدوران حول القواعد وتسجيل نقطة (ركضة))\nمثال: كانت الحملة الإعلانية الجديدة نجاحاً تاماً",
 "オーパイ": "طيار آلي, نظام طيران آلي (جهاز ملاحي يحافظ تلقائياً على مسار السفن أو الطائرات أو المركبات الفضائية في اتجاه ثابت) / تصرف تلقائي, طيار آلي (حالة معرفية يتصرف فيها الشخص دون وعي ذاتي كامل)\nمثال: قامت بأعمالها المنزلية بشكل تلقائي",
 "オーパス": "تأليف موسيقي, عمل موسيقي (عمل موسيقي تم إبداعه)\nمثال: التأليف مكتوب في أربع حركات",
 "オービター": "تابع, قمر اصطناعي (معدات من صنع الإنسان تدور حول الأرض أو القمر)",
 "オービー": "عجوز نشيط (رجل مسن مفعم بالحيوية) / خريج قديم (تلميذ سابق لمدرسة) / صديق قديم (مصطلح مألوف لمخاطبة رجل) / خط التماس, خط الجانب (خط يحدد الحدود الجانبية لملعب اللعب)",
 "オーピー": "شارة مُوسِيقِيّة / طباعة فوقية (شيء مضاف عن طريق الطباعة الفوقية)",
 "オーファン": "يَتِيم / يَتِيمَة",
 "オーブ": "مقلة العين (المحفظة الكروية التي تحتوي على عين الفقاريات) / جرم, كرة (جسم ذو شكل كروي)\nمثال: كرة من النار",
 "オーブン": "فُرْن, تَنُّور",
 "オーブントースター": "فرن تحميص (جهاز مطبخ يتكون من فرن كهربائي صغير لتحميص أو تسخين الطعام)",
 "オーブン・トースター": "فرن تحميص (جهاز مطبخ يتكون من فرن كهربائي صغير لتحميص أو تسخين الطعام)",
 "オープナー": "فَتَّاحَة, مِفَكّ (التي تكثر الفَتْح)",
 "オープニング": "حركة افتتاحية, خطوة أولى (الأولى في سلسلة من الإجراءات) / فتح (عملية فتح شيء ما) / فتح (أن يصبح الشيء مفتوحاً أو يتم فتحه) / افتتاحية, افتتاحية الشطرنج (تسلسل معترف به من النقلات في بداية لعبة الشطرنج)\nمثال: كشف شعاع الضوء عن فتحه الحذر للباب / شارة مُوسِيقِيّة",
 "オープン": "حركة افتتاحية, خطوة أولى (الأولى في سلسلة من الإجراءات) / فتح (عملية فتح شيء ما) / فتح (أن يصبح الشيء مفتوحاً أو يتم فتحه) / افتتاحية, افتتاحية الشطرنج (تسلسل معترف به من النقلات في بداية لعبة الشطرنج)\nمثال: كشف شعاع الضوء عن فتحه الحذر للباب / مَفْتُوح / فَتَحَ (ضد أغْلَقَ وسَدَّ؛ تركه بلا شيء يسده؛ الطريق: جعلها سالكة للطارقين) / فتح (ضد أغْلَقَ وسَدَّ؛ تركه بلا شيء يسده؛ الطريق: جعلها سالكة للطارقين) / حل (للعقدة: ضد عَقْدها؛ للجامد في السائل: إذابته) / اِنْفَتَحَ (فعل مطاوعة لفَتَحَ، فَتَحْتُهُ فانْفَتَح؛ يستخدم عوضا عن المبنى للمجهول فُتِحَ. )\nمثال: فتح الباب آليا.",
 "オープンかんじょう": "حساب مفتوح (طلب ائتماني غير مدفوع) / حساب ائتماني, حساب جاري مدين (ائتمان تمنحه شركة لعميل)",
 "オープンせい": "انفتاح, تقبل (الاستعداد أو الجاهزية للتلقي (خاصة الانطباعات أو الأفكار)) / انفتاح, شفافية (يتسم بموقف يسهل الوصول إليه (خاصة فيما يتعلق بأفعال المرء أو مقاصده)؛ بدون إخفاء؛ غير كتوم) / اِتِّسَاع, اِنْفِتَاح (الخلو من العوائق أمام المرور أو الرؤية)\nمثال: كان يختبر تقبل الحكومة للإصلاح",
 "オープンせん": "مُبَارَاة وِدِّيَّة",
 "オープンアカウント": "حساب مفتوح (طلب ائتماني غير مدفوع) / حساب ائتماني, حساب جاري مدين (ائتمان تمنحه شركة لعميل)",
 "オープンエア": "خلاء, عراء (حيث يكون الهواء غير محصور)\nمثال: أراد الخروج للهواء الطلق قليلاً",
 "オープンエアー": "خلاء, عراء (حيث يكون الهواء غير محصور)\nمثال: أراد الخروج للهواء الطلق قليلاً",
 "オープンエンドスパナ": "مفتاح مفتوح الطرف (مفتاح ربط بفكوك متوازية بتباعد ثابت (غالباً في كلا طرفي المقبض))",
 "オープンエンド・スパナ": "مفتاح مفتوح الطرف (مفتاح ربط بفكوك متوازية بتباعد ثابت (غالباً في كلا طرفي المقبض))",
 "オープンカー": "حَنْطُور",
 "オープンキャンパス": "استقبال عام, بيت مفتوح (حفلة غير رسمية تتيح الضيافة لجميع القادمين)",
 "オープンゲーム": "مُبَارَاة وِدِّيَّة",
 "オープンサンド": "شطيرة مفتوحة (شطيرة بدون شريحة خبز تغطيها)",
 "オープンサンドイッチ": "شطيرة مفتوحة (شطيرة بدون شريحة خبز تغطيها)",
 "オープンショップ": "مؤسسة مفتوحة التوظيف (شركة يتم توظيف عمالها دون النظر إلى عضويتهم في نقابة عمالية)",
 "オープンスクール": "استقبال عام, بيت مفتوح (حفلة غير رسمية تتيح الضيافة لجميع القادمين)",
 "オープンスペース": "ترويق, تصفية (فعل إزالة الجزيئات الصلبة من سائل) / تبرئة (فعل التحرير من الشكوك) / فُرْجَة, فُسْحَة (قطعة أرض بها عدد قليل من الأشجار أو خالية منها تقع وسط منطقة حرجية)",
 "オープンセサミ": "اِفْتَح يَا سِمْسِم",
 "オープンソースインテリジェンス": "مَفْتُوح الْمَصْدَرِ",
 "オープンソースソフトウェア": "مَفْتُوح الْمَصْدَرِ",
 "オープンソースソフトウエア": "مَفْتُوح الْمَصْدَرِ",
 "オープンソース・ソフトウェア": "مَفْتُوح الْمَصْدَرِ",
 "オープンドア": "باب مفتوح, حرية الوصول (حرية الوصول) / سياسة الباب المفتوح (سياسة منح فرص تجارية متساوية لجميع البلدان)\nمثال: حافظ على سياسة الباب المفتوح لجميع الموظفين",
 "オープンハウス": "استقبال عام, بيت مفتوح (حفلة غير رسمية تتيح الضيافة لجميع القادمين)",
 "オープンフレーム": "إطار مفتوح (أي إطار (جولة) يفشل فيه لاعب البولينج في تحقيق ضربة كاملة (سترايك) أو مكملة (سبير))\nمثال: الكسر في الإطار الثامن كلفه المباراة",
 "オープンフロア": "مَفْتُوحُ التَّصْمِيم ((للغرف أو المباني) ذو غرف واسعة بقليل من الحواجز الفاصلة)",
 "オープンマリッジ": "زواج مفتوح (زواج يكون فيه كل شريك حراً في الدخول في علاقات جنسية خارجية دون شعور بالذنب أو الغيرة من الآخر)",
 "オープンユニバーシティー": "الجامعة المفتوحة (جامعة بريطانية مفتوحة للأشخاص الذين ليس لديهم مؤهلات أكاديمية رسمية ويكون التدريس فيها بالمراسلة أو البث أو المدرسة الصيفية)",
 "オープンワールド": "عالم مفتوح (الذي يعلم؛ متخصص في عِلْم ما وباحث فيه)\nمثال: هو عالم أحيائي.",
 "オープン・アカウント": "حساب مفتوح (طلب ائتماني غير مدفوع) / حساب ائتماني, حساب جاري مدين (ائتمان تمنحه شركة لعميل)",
 "オープン・エア": "خلاء, عراء (حيث يكون الهواء غير محصور)\nمثال: أراد الخروج للهواء الطلق قليلاً",
 "オープン・カー": "حَنْطُور",
 "オープン・キャンパス": "استقبال عام, بيت مفتوح (حفلة غير رسمية تتيح الضيافة لجميع القادمين)",
 "オープン・ゲーム": "مُبَارَاة وِدِّيَّة",
 "オープン・サンド": "شطيرة مفتوحة (شطيرة بدون شريحة خبز تغطيها)",
 "オープン・サンドイッチ": "شطيرة مفتوحة (شطيرة بدون شريحة خبز تغطيها)",
 "オープン・ショップ": "مؤسسة مفتوحة التوظيف (شركة يتم توظيف عمالها دون النظر إلى عضويتهم في نقابة عمالية)"
}
