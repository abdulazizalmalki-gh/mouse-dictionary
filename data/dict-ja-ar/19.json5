 "エポック・メイキング": "تَارِيخِيّ, حِقْبِيّ (بالغ الأهمّيّة خاصّةً في إحداث أو تمييز بداية حقبة أو عصر جديد)",
 "エポック・メーキング": "تَارِيخِيّ, حِقْبِيّ (بالغ الأهمّيّة خاصّةً في إحداث أو تمييز بداية حقبة أو عصر جديد)",
 "エポニム": "اسم منسوب لشخص (الاسم المشتق من شخص (حقيقي أو خيالي)) / شخص سُمي به (الشخص الذي سُمي شيء باسمه)\nمثال: متلازمة داون هي اسم منسوب للطبيب الإنجليزي جون داون",
 "エポレット": "كَتَّافَة (زينة تتكون من وسادة قماشية مزخرفة توضع على الكتف)",
 "エマジェンシー": "طَوَارِئ, حَالَةْ اَلطَّوَارِئ",
 "エマルション": "مُسْتَحْلَب",
 "エマルジオン": "مُسْتَحْلَب",
 "エマルジョン": "مُسْتَحْلَب",
 "エマンシペーション": "تحرير من الوصاية, عتق (تحرير شخص من سيطرة آخر؛ خاصة تخلي الوالد عن السلطة والسيطرة على طفل قاصر)",
 "エマージェンシー": "طَوَارِئ, حَالَةْ اَلطَّوَارِئ",
 "エマージェンシーランディング": "هبوط اضطراري (هبوط غير مجدول للطائرة يتم في ظروف خارجة عن سيطرة الطيار)",
 "エマージェンシー・ランディング": "هبوط اضطراري (هبوط غير مجدول للطائرة يتم في ظروف خارجة عن سيطرة الطيار)",
 "エマージング": "بَارِز, نَاشِئ (يظهر إلى الوجود؛ في طَوْر التكوُّن) / صَاعِد, نَاشِئ (يَبْلُغُ مَرْحَلَةَ النُّضْج)",
 "エミグラント": "مُهَاجِر, مُهَاجِرَة",
 "エミグレーション": "هِجْرَة, نُزُوح (ترك الأرض والخروج منها إلى أخرى؛ في الشرع: ترك الوطن الذي بين الكفار والانتقال إلى دار الإسلام قربة لله)\nمثال: الهجرة النبوية.",
 "エミッション": "إصدار, انبعاث (فعل الإصدار؛ التسبب في التدفق للخارج) / انبعاث, خروج (حدوث تدفق للماء (كما من أنبوب)) / إفراز, انبعاث (أي من العمليات الجسدية العديدة التي تخرج بموجبها المواد من الجسم) / انبعاث (إطلاق الإلكترونات من الذرات الأم)\nمثال: خروج الصديد",
 "エミッター": "باعث (القطب الكهربائي في الترانزستور الذي تنشأ منه الإلكترونات)",
 "エミネント": "بَارِز",
 "エミュ": "مُحَاكٍ",
 "エミュレイト": "اقتداء, محاكاة (الجهد المبذول لمساواة أو التفوق على آخر) / محاكاة ((علم الحاسوب) تقنية تمكن آلة من الحصول على نفس نتائج آلة أخرى) / مضاهاة, منافسة (طموح للمساواة أو التفوق)",
 "エミュレーション": "اقتداء, محاكاة (الجهد المبذول لمساواة أو التفوق على آخر) / محاكاة ((علم الحاسوب) تقنية تمكن آلة من الحصول على نفس نتائج آلة أخرى) / مضاهاة, منافسة (طموح للمساواة أو التفوق)",
 "エミュレータ": "مُحَاكٍ",
 "エミュレーター": "مُحَاكٍ",
 "エミュレート": "اقتداء, محاكاة (الجهد المبذول لمساواة أو التفوق على آخر) / محاكاة ((علم الحاسوب) تقنية تمكن آلة من الحصول على نفس نتائج آلة أخرى) / مضاهاة, منافسة (طموح للمساواة أو التفوق)",
 "エミュー": "دُرْمِيس أُسْتُرَالِيّ",
 "エム": "أَلْف (يَدُلُّ عَلَى العَدَد 1000) / تركيز مولاري, مولارية (التركيز مقاساً بعدد مولات المذاب لكل لتر من المحلول) / ميبي بايت, ميغابايت (وحدة معلومات تساوي 1024 كيبي بايت أو 2 أس 20 (1,048,576) بايت) / ميغابايت (وحدة معلومات تساوي 1000 كيلوبايت أو 10 أس 6 (1,000,000) بايت) / مِتْر (فِي : مُسْتَعْمَلٌ لِتَحْدِيدِ طُولِ مُخْتَلِفِ الأَشْيَاءِ، قَدْرُهُ ذِرَاعٌ وَنِصْفٌ تَقْرِيباً…؛ فِي : هوَ النَادل أو موَظف خدْمة الزَّبائن في المطْعم، يقَال أيْضاً \"مِيتْر\")\nمثال: أنا أقل بقليل من 150 سنتي متر. / مَاسُوشِيّ, مَازُوخِيّ / ذَكَرِيّ / ذَكَر, ذكر (ذَكَرَ الشيءَ: نطق به أو أشار إليه بالكلام؛ ذَكَرَ شخصًا: استحضره في الذاكرة)\nمثال: قتله ذكر زرافة.",
 "エムせだい": "ألفي (متعلق بألفية أو فترة تمتد لألف عام)",
 "エムりろん": "ْنَظَرِيَّة-إَم",
 "エムアイエス": "مِي (الفتاة البِكْر؛ اسم من أسماء الخَمْر، يطلق غالبًا على الخمر الجديد الذي لم يُعتَّقُ كثيرا)",
 "エムアール": "سيد (صيغة خطاب للرجل) / أبحاث التسويق (البحث الذي يجمع ويحلل المعلومات حول نقل البضائع أو الخدمات من المنتج إلى المستهلك)",
 "エムアールアイ": "تصوير بالرنين المغناطيسي (استخدام الرنين المغناطيسي النووي للبروتونات لإنتاج صور كثافة البروتون)",
 "エムアールエヌエー": "حمض نووي ريبوزي رسول (القالب لتخليق البروتين؛ شكل الحمض النووي الريبوزي الذي يحمل المعلومات من الحمض النووي في النواة إلى مواقع الريبوسوم لتخليق البروتين في الخلية)",
 "エムイー": "إلكترونيات دقيقة (فرع الإلكترونيات الذي يتعامل مع المكونات المصغرة) / الشَّرْق الْأَوْسَط, مَشْرِق / إِنْجْلِيزِيَّة وُسْطَى (مُؤَنَّثُ إِنْجْلِيزِيّ، ٌ مُؤَنَّثَةٌ إِلَى ٱلْإِنجليزِ؛ اَللُّغَةُ ٱلْإِنجليزِيَّةُ: وَهي اللغَة الأكثَر ٱستعمَالًا (كلغة ثانية) في هذَا العصر…)\nمثال: تحدث بالإنجليزية! / ـنِي, ـنِيَ / ـِي, ـِيَ",
 "エムエフ": "تَرَدُّد مُتَوَسِّط (300 إلى 3000 كيلوهرتز)",
 "エムエフエー": "ماجستير الفنون الجميلة (درجة الماجستير في الفنون الجميلة)",
 "エムエル": "سنتيمتر مكعب, مليلتر (وحدة مترية للحجم تساوي واحداً من الألف من اللتر)",
 "エムエルエス": "ماجستير علم المكتبات (درجة الماجستير في علم المكتبات)",
 "エムオー": "موليبدنوم (عنصر فلزي متعدد التكافؤ يشبه الكروم والتنجستن في خصائصه) / دقيقة, لحظة (وقت قصير غير محدد)\nمثال: انتظر لحظة فقط",
 "エムシー": "عريف الحفل, مذيع الربط (شخص يعمل كمضيف في المناسبات الرسمية (يلقي خطابات تمهيدية ويقدم المتحدثين الآخرين)) / مركز تشغيل آلي, مركز خراط (موضع الاِرْتِكَاز عامة؛ موضع الشخص ومحلّه الذي يبقى فيه عادة)\nمثال: أين أقرب مركز شرطة؟ / تكلفة تزايدية, تكلفة حدية (الزيادة أو النقصان في التكاليف نتيجة لوحدة إنتاج واحدة أكثر أو أقل)",
 "エムティー": "ترجمة آلية (استخدام الحواسيب للترجمة من لغة إلى أخرى) / طن, طن متري (وحدة وزن تعادل 1000 كيلوغرام) / مايتنريوم (عنصر مشع ما بعد اليورانيوم، عدده الذري 109) / ميغا طن (مقياس للقوة التفجيرية (لسلاح نووي) يساوي قوة مليون طن من مادة تي إن تي) / ميغا طن (مليون طن) / شريط مغناطيسي (جهاز ذاكرة يتكون من شريط بلاستيكي رفيع طويل مطلي بأكسيد الحديد؛ يستخدم لتسجيل الإشارات الصوتية أو الفيديو أو لتخزين معلومات الحاسوب)\nمثال: أخذ معه دزينة من الأشرطة لتسجيل المقابلة",
 "エムティージー": "اِجْتِمَاع, مَجْلِس (جمعوا انفسهم؛ اسم يطلق على عملية جَمْع بعض الناس في مكان واحد ليتباحثوا أمرا) / مُلَاقَاة, مُقَابَلَة (لِقَاء) / مُلَاقَاة, لِقَاء (لِقَاء)\nمثال: هذا اجتماع مهم.",
 "エムティービー": "دَرَّاجَة لِلْجِبَال (مَرْكَبَة من عجلتين أو ثلاث، ولها مقعد واحد عادة، مثل الدراجة الهوائية والدراجة النارية؛ دراجة هوائية. (تخصيص))\nمثال: كين يريد دراجة.",
 "エムディー": "دكتور في الطب (درجة الدكتوراه في الطب) / طبيب (ممارس طبي مرخص) / مندليفيوم (عنصر مشع ما بعد اليورانيوم يتم تصنيعه بقصف الأينشتاينيوم بجسيمات ألفا)\nمثال: شعرت بسوء شديد فذهبت لرؤية طبيبي / قرص مغناطيسي ((علم الحاسوب) جهاز ذاكرة يتكون من قرص مسطح مغطى بطبقة مغناطيسية يتم تخزين المعلومات عليها) / إعلان, دعاية (العمل التجاري لجذب انتباه الجمهور إلى السلع والخدمات) / بيع, متاجرة (تبادل البضائع مقابل مبلغ متفق عليه من المال) / منتجات ترويجية (منتجات تحمل علامة تجارية تهدف للترويج لمنتج آخر، وخاصة الأفلام والفرق الموسيقية)",
 "エムディーエムエー": "إكستاسي, إم دي إم إيه (عقار منشط مرتبط كيميائياً بالميسكالين والأمفيتامين ويستخدم بشكل غير مشروع لتأثيراته المبهجة والمهلوسة؛ كان يستخدم سابقاً في العلاج النفسي ولكن في عام…)\nمثال: غالباً ما يستخدم الإكستاسي في الحفلات لأنه يمكن رواد الحفلات من البقاء نشطين لفترات طويلة من الزمن",
 "エムビー": "مِيغَابَايْت",
 "エムビーエー": "ماجستير في إدارة الأعمال (درجة الماجستير في الأعمال)",
 "エムピー": "الشرطة العسكرية (فيلق عسكري يفرض الانضباط ويحرس السجناء) / شُرْطِيّ عَسْكَرِيّ (عضو في الشرطة العسكرية يقوم بضبط الجنود وحراسة السجناء) / شُرْطَة عَسْكَرِيَّة, الشُّرْطَة الْعَسْكَرِيَّة / عضو برلمان, نائب (عضو منتخب في البرلمان البريطاني: عضو في مجلس العموم)",
 "エムピースリー": "إِم بِي ثْرِي, إم بي 3",
 "エムピースリープレーヤー": "مُشَغِّل إِم بِي ثْرِي, مشغل 3",
 "エムブイピー": "أفضل لاعب, اللاعب الأكثر قيمة (اللاعب الذي يُحكم عليه بأنه الأكثر أهمية للرياضة أو الفريق)",
 "エムブレム": "شِعَار, رَمْز (العلامة: وذلك من شعار العقلاء (مادة حلم من مجمع بحار الأنوار))\nمثال: الشعار ☭ هو رمز الشيوعية.",
 "エムペグ": "مبيغ (مجموعة من المعايير لضغط الفيديو الرقمي والبيانات الصوتية)",
 "エムユーディー": "طِين, وَحْل",
 "エムルション": "مُسْتَحْلَب",
 "エム・アイ・エス": "مِي (الفتاة البِكْر؛ اسم من أسماء الخَمْر، يطلق غالبًا على الخمر الجديد الذي لم يُعتَّقُ كثيرا)",
 "エム・アール": "سيد (صيغة خطاب للرجل) / أبحاث التسويق (البحث الذي يجمع ويحلل المعلومات حول نقل البضائع أو الخدمات من المنتج إلى المستهلك)",
 "エム・アール・アイ": "تصوير بالرنين المغناطيسي (استخدام الرنين المغناطيسي النووي للبروتونات لإنتاج صور كثافة البروتون)",
 "エム・アール・エヌ・エー": "حمض نووي ريبوزي رسول (القالب لتخليق البروتين؛ شكل الحمض النووي الريبوزي الذي يحمل المعلومات من الحمض النووي في النواة إلى مواقع الريبوسوم لتخليق البروتين في الخلية)",
