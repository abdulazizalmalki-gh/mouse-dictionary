 "１分": "جُزْء مِن مِائَة, وَاحِد بِالْمِائَة (جزء واحد من مائة جزء متساوي)",
 "１切れ": "شريحة\nمثال: قطع زيري العشب.",
 "１列": "صَفّ (سَطْر مستقيم؛ مستوى تعليمي)\nمثال: صف كليتي وقلبي‎.",
 "１割": "عُشْر (جزء من عشرة؛ جزء واحد من عشرة أجزاء متساوية)",
 "１匹": "وَاحِد, وَاحِدَة (في وَ: العدد واحد العدد الاول)\nمثال: رأيت واحدة مرة.",
 "１千": "أَلْف (يَدُلُّ عَلَى العَدَد 1000)",
 "１号": "الذات, النفس (إشارة إلى النفس أو الذات؛ عبارة 'الاهتمام برقم واحد' تعني وضع مصالح المرء…)\nمثال: الأول من الشهر",
 "１号園児": "طفل ما قبل المدرسة (طفل يرتاد حضانة أو روضة أطفال)",
 "１回": "مَرَّةً, مَرَّةً وَاحِدَةً (مؤنث مُرّ، صفة ما كان بها مرارة)\nمثال: كم من مرة ذهبت؟",
 "１回生": "فِي السَّنَةِ الأُولَى, مُسْتَجِدّ (يُوصَفُ بِهِ الشَّخْصُ فِي سَنَتِهِ الأُولَى مِنْ تَجْرِبَةٍ (خَاصَّةً فِي…)",
 "１型糖尿病": "السكري المعتمد على الأنسولين, السكري من النوع الأول (داء سكري شديد يظهر مبكرًا؛ يتميز بكثرة التبول والعطش الشديد وزيادة الشهية…)",
 "１塁": "قاعدة أولى, مرحلة أولى (المرحلة الأولية في إنجاز شيء ما)\nمثال: لم نصل إلى المرحلة الأولى بهذا النهج / لاعب القاعدة الأولى ((بيسبول) رجل يلعب في القاعدة الأولى)",
 "１士": "جُنْدِيّ أَوَّل (لقب عسكري يُطلق على من يلتحق بالجَيْش ويعمل فيه، مقاتل، محارب، عسكري؛ (في…)\nمثال: غادر ذلك الجندي.",
 "１対１": "وَاحِدٌ لِوَاحِد (يصف علاقة يرتبط فيها كل عنصر من مجموعة بعنصر واحد من مجموعة ثانية)",
 "１対１の通信": "وَاحِدٌ لِوَاحِد (يصف علاقة يرتبط فيها كل عنصر من مجموعة بعنصر واحد من مجموعة ثانية)",
 "１尉": "طَيَّار, قُبْطَان (اسم فاعل للمبالغة على وزن فَعَّال؛ الذي يقود الطَائِرَة سواء كانت مهنته أم لا)\nمثال: لم توجه أبدا تهمة القيادة غير المسؤولة للطيار.",
 "１年生": "فِي السَّنَةِ الأُولَى, مُسْتَجِدّ (يُوصَفُ بِهِ الشَّخْصُ فِي سَنَتِهِ الأُولَى مِنْ تَجْرِبَةٍ (خَاصَّةً فِي…) / مُبْتَدِئ, مُبْتَدِئَة (من يبتدئ في تعلّم علم أو فنّ، شخص قليل الخبرة)\nمثال: إنك محترف وأنا مبتدئ. / سَنَوِيّ",
 "１度": "مَرَّةً, مَرَّةً وَاحِدَةً (مؤنث مُرّ، صفة ما كان بها مرارة)\nمثال: كم من مرة ذهبت؟ / مُؤَقَّتًا",
 "１度も": "يَوْمًا",
 "１才": "بِعُمُر سَنَة وَاحِدَة (في عامه الأوّل من العمر)",
 "１打": "سكتة دِمَاغِيَّة",
 "１撃": "تزرير, صفيحة عزل (صفيحة معدنية مشكلة ومثبتة على سطح لتقويته وحمايته من العوامل الجوية)\nمثال: اجتاحته ومضة من المشاعر",
 "１日": "مَرَّةً, يَوْمًا (مؤنث مُرّ، صفة ما كان بها مرارة)\nمثال: كم من مرة ذهبت؟ / طُول اَلْيَوْم, طُول اَلنَّهَار (قُدرة؛ غنى أو فضل)\nمثال: قاس طول السرير.",
 "１日中": "طِوَال اليَوْم, نَهَارًا (خلال اليوم بأكمله)\nمثال: الضوء يتدفق طوال اليوم في الغرفة",
 "１時": "اَلسَّاعَة اَلْوَاحِدَة / مَرَّةً, مَرَّةً وَاحِدَةً (مؤنث مُرّ، صفة ما كان بها مرارة)\nمثال: كم من مرة ذهبت؟ / لبرهة, لفترة وجيزة (لفترة قصيرة)\nمثال: اجلس وابقى لبرهة / وَقْت (\"بَقِيَ وَقْتاً عِنْدَهُ \" : أَيْ مِقْدَاراً مِنَ الزَّمَنِ؛ \"جَاءَ فِي…)\nمثال: حان وقت الذهاب.",
 "１曹": "رقيب أول, مساعد (ضابط صف كبير في الجيش أو المارينز)",
 "１月": "يَنَايِر, كَانُون اَلثَّانِي (الشهر الأول من السنة الروميّة)\nمثال: لتبدأ الاحتفالات بيناير.",
 "１服": "زفر, نفخ (زفير قوي عن طريق الأنف أو الفم)\nمثال: أعطى أنفه نفخة قوية / رَاحَة, اِسْتِرَاحَة\nمثال: عليك أخذ استراحة. / ركود, هدوء مؤقت (فترة من الطقس الهادئ)\nمثال: كان هناك هدوء مؤقت في العاصفة",
 "１本": "نَفَخَ (أَطْلَقَ الريح من فمه؛ زَفَرَ أو هَبَّ بشدة)\nمثال: يداك أوكتا وفوك نفخ / غَيْشَا / أُحَادِيُّ الْهَدَفِ, مُصَمِّمٌ (مُصَمِّم ومُنصَبّ على هدف واحد)",
 "１杯": "كوب, ملء كوب (الكمية التي يستوعبها كوب)\nمثال: شرب كوباً من القهوة / مُمْتَلِئ, مَلِيء / بالكامل, تماماً (إلى أقصى درجة أو مدى؛ بشكل كامل أو كلي)\nمثال: نمى بالكامل / كَثِير (ما كان عدده كبيرا؛ متبوعًا بمِنْ: عدد كبير أو كمية كبيرة من الشيء)\nمثال: هذا أسهل بكثير.",
 "１枚": "وَاحِد, وَاحِدَة (في وَ: العدد واحد العدد الاول)\nمثال: رأيت واحدة مرة.",
 "１次": "أَوَّل, أُولَى (الذي يكون ترتيبه وَاحِد، الذي كان قبل الآخرين؛ الأوَّل اسم من الأسماء الحسنى) / أَوَّلِيّ / تَنَاظُرِيّ, خَطِّيّ (لدائرة أو جهاز له مخرج يتناسب مع المدخل)\nمثال: جهاز تناظري",
 "１次コイル": "ملف ابتدائي (ملف يشكل جزءاً من دائرة كهربائية بحيث يؤدي تغيير التيار فيه إلى حث تيار في…)\nمثال: التيار عبر الملف الابتدائي يحث تياراً في الملف الثانوي",
 "１歩": "خُطْوَة, خَطْوَة\nمثال: もう一歩も歩けないよ。 — لا يمكنني المشي خطوة أخرى. / مُسْتَوًى",
 "１歩１歩": "خُطْوَةً خُطْوَةً, خُطْوَةً بِخُطْوَةٍ",
 "１歳": "بِعُمُر سَنَة وَاحِدَة (في عامه الأوّل من العمر)",
 "１番": "الذات, النفس (إشارة إلى النفس أو الذات؛ عبارة 'الاهتمام برقم واحد' تعني وضع مصالح المرء…)\nمثال: الأول من الشهر / أَفْضَل / لَعْب, لَعْبَة (فعل شيئا للتسلية والترفيه، شَارَكَ في لعبة)\nمثال: لعب زيري التنس. / أُغْنِيَّة, أُغْنِيَة (الجمع : أُغْنِيَات و أغانٍ؛ الأُغنيَة المقتسمة : ( الموسيقى ) قطعة موسيقيَّة…)\nمثال: أنا أغني أغنية.",
 "１番手": "مُتَكَلِّم",
 "１番目": "أَوَّل, أُولَى (الذي يكون ترتيبه وَاحِد، الذي كان قبل الآخرين؛ الأوَّل اسم من الأسماء الحسنى)",
 "１発": "جولة, طلقة (شحنة ذخيرة لطلقة واحدة) / إصابة الهدف, نجاح تام (شيء ينجح تماماً في تحقيق هدفه)\nمثال: كانت الحملة الإعلانية الجديدة نجاحاً تاماً",
 "１等": "بالدرجة الأولى (بواسطة وسائل نقل من الدرجة الأولى؛ مع إقامة من الدرجة الأولى)\nمثال: نسافر دائماً بالدرجة الأولى / أَكْثَر, أَغْلَب\nمثال: إنها غالية جدا!",
 "１等兵": "جُنْدِيّ أَوَّل (لقب عسكري يُطلق على من يلتحق بالجَيْش ويعمل فيه، مقاتل، محارب، عسكري؛ (في…)\nمثال: غادر ذلك الجندي.",
 "１等国": "رَفِيع, مُتَأَلِّق (جيد جدًا؛ من أرقى مستويات الجودة)",
