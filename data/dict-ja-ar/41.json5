 "模式標本": "عينة نمطية, عينة نموذجية (العينة الأصلية التي يتم بناءً عليها وصف نوع جديد (في البيولوجيا))",
 "模擬": "تَقْلِيد",
 "模擬実験": "مُحَاكَاة (تقليد أو محاولة إعادة عملية أو نظام موجود في الواقع بطريقة اصطناعية أو نموذجية)\nمثال: ويتم الآن طرح التساؤل التالي: هل يفهم الذكاء الصناعي اللغة الصينية حقيقة أم أنه يتم فقط محاكاة هذه المقدرة.",
 "模擬店": "مَطْعَم التَّصَابِير, كُشْك التَّصَابِير",
 "模擬戦": "بروفة, تدريب (جلسة تدريب تحضيراً لأداء عام (كمسرحية أو خطاب أو حفلة موسيقية))\nمثال: فوت الكثير من البروفات",
 "模擬裁判": "محكمة افتراضية, محكمة تدريبية (محكمة صورية حيث يترافع طلاب القانون في قضايا افتراضية)",
 "模様": "نُمُوذَج, نَمَط / وَضْع (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه) / دَوْلَة (بَلَد يتميز بحُدُود معروفة وشَعْب وحُكُومَة ومُؤَسَسَات مُنَظَّمَة؛ مجموعة من الناس مستقلين متحدين معا لتكوين مجتمع لحماية حقوقهم و وضع قوانينهم الخاصة) / وِلَايَة (منطقة إدارية لها استقلالها الإداري والمعنوي؛ ويختلف المعنى من بلد لآخر كما يختلف من فترة زمنية لأخرى) / يُبْدِي\nمثال: لقد أزمت الوضع. / نَمُوذَج / نَمُوذَج مُصَغَّر / قَدْوَة (من يُقتدى به) / إطار, هيكل (هيكل يدعم أو يحتوي على شيء ما) / إطار, نسيج (الهيكل الأساسي) / إطار نظري, نموذج (وصف افتراضي لكيان أو عملية معقدة)\nمثال: توفير إطار عمل واقعي للبحث المستقبلي",
 "模樹石": "تغصن, زائدة شجرية (ليف قصير ينقل الإشارات نحو جسم الخلية العصبية)",
 "模範": "أُسْوَة (أُسْوَةٌ)",
 "模範囚": "حَسَن السُّلُوك, مُؤَدَّب ((عادة عن الأطفال) يتصرف بالطريقة التي يراها المتحدث صحيحة)",
 "模範演技": "مَعْرِض",
 "模範的": "نَمُوذَجِيّ / نَمُوذَجِيّ, مِثَالِيّ",
 "模糊": "خَافِت, مُعْتَدِل الإِضَاءَة (ضَعِيف الضَّوْء؛ غَيْر سَاطِعٍ أَوْ قَاسٍ) / مُخْفَت, مُعْتِم (جُعل معتماً أو أقل سطوعاً) / بَطِيء الفَهْم, كَلِيل الذِّهْن (بطيء التعلّم والاستيعاب؛ يفتقر إلى الحدّة الذهنيّة) / بَاهِت, خَافِت (يَفْتَقِر إِلَى الوُضُوح أَوِ التَّمَيُّز)\nمثال: أضواء القاعة المخفتة جلبت صمتاً من الترقب",
 "模索": "مُتَخَبِّط, مُتَلَمِّس (يتصرّف بتردّد وعدم ثقة أو يقين)",
 "模製": "نسخ (فعل النسخ)",
 "模造": "تَقْلِيد",
 "模造品": "تَقْلِيد",
 "模造者": "مُحَاكٍ, مُقَلِّد (شخص ينسخ كلمات أو سلوك شخص آخر) / منتحل شخصية (شخص ينتحل (عن طريق الاحتيال) مظهر شخص آخر)",
 "模造革": "جلد صناعي (قماش مصنوع ليبدو مثل الجلد)",
 "権": "يَمِين, يمين / صَحِيح, صَوَاب / قَائِم / عَلَى اَلْيَمِين (يفيد الاستعلاء؛ يفيد التعليل) / إِلَى اَلْيَمِين (حرف جر يُفيد الغاية الزمنية؛ حرف جر يُفيد الغاية المكانية) / صحيح, تمام / حَقّ, حُقُوق (اسم من الأسماء الحسنى وهو من صفات الله. لا جمع له؛ ضد البَاطِل، العَدْل والحَقِيْقَة والوُجُوْد الثَابِت والصِدْق والذي لا جدال فيه. لا جمع له) / صَحَّحَ (جعل الشيء صحيحًا أو خاليًا من الأخطاء؛ أظهر صحة معلومة أو حقيقة)\nمثال: أجب على السؤال. / سُلْطَة (هو طعام يصنع من الخُضَار الطَازَجَة تقطع وتخلط ويضاف إليها المِلْح وقد يضاف عصير اللَيْمُون أو الخَلّ أو الزَيْت. لا يطبخ)\nمثال: هو متعطش للسلطة.",
 "権兵衛": "فُلان, فُلان الْفُلانِيّ (كلمة تستخدم لوصف شخص ما بدون ذكر من هو، غالبًا يقصد به \"أي شخص من الناس\"، أو شخص لا يريد المتحدث ذكره)\nمثال: سمعنا ذلك من فلان و فلان. / شَخْص رِيفِيّ أَحْمَق (سواد الإنسان حين يرى من بعيد فلا يُعرَف؛ واحد الإنسان بصورة عامة بدون تحديد لسنه وجنسه وقومه وغير ذلك)\nمثال: هذا الشخص فنان.",
 "権利": "يَمِين, يمين / صَحِيح, صَوَاب / قَائِم / عَلَى اَلْيَمِين (يفيد الاستعلاء؛ يفيد التعليل) / إِلَى اَلْيَمِين (حرف جر يُفيد الغاية الزمنية؛ حرف جر يُفيد الغاية المكانية) / صحيح, تمام / حَقّ, حُقُوق (اسم من الأسماء الحسنى وهو من صفات الله. لا جمع له؛ ضد البَاطِل، العَدْل والحَقِيْقَة والوُجُوْد الثَابِت والصِدْق والذي لا جدال فيه. لا جمع له) / صَحَّحَ (جعل الشيء صحيحًا أو خاليًا من الأخطاء؛ أظهر صحة معلومة أو حقيقة)\nمثال: أجب على السؤال.",
 "権利の章典": "وثيقة الحقوق (بيان بالحقوق والامتيازات الأساسية (خاصة التعديلات العشرة الأولى لدستور الولايات المتحدة))",
 "権利侵害": "جنحة مدنية, ضرر مدني ((قانون) أي خطأ يمكن رفع دعوى بسببه للمطالبة بتعويضات)",
 "権利放棄": "تَنَازُل, وَثِيقَةُ تَنَازُل",
 "権利書": "سند ملكية (وثيقة قانونية تثبت حق الشخص في الملكية)",
 "権利章典": "وثيقة الحقوق (بيان بالحقوق والامتيازات الأساسية (خاصة التعديلات العشرة الأولى لدستور الولايات المتحدة))",
 "権利者": "مُسْتَفِيد",
 "権利譲渡": "اندثار, زوال (الوقت الذي ينتهي فيه شيء ما)\nمثال: كان ذلك زوال كل خططه",
 "権利金": "إصدار مُكَلف / فاخر",
 "権力": "قُوَّة, قُدْرَة (ضد الضُعْف، الشِدَّة والقُدْرَة الجِسْمَانِيَّة؛ ضد الضُعْف، المَقْدِرَة والحَوْل والتَمَكُّن، القدرة المعنوية) / قُوَّة (ضد الضُعْف، الشِدَّة والقُدْرَة الجِسْمَانِيَّة؛ ضد الضُعْف، المَقْدِرَة والحَوْل والتَمَكُّن، القدرة المعنوية) / قُوَّة, طَاقَة (ضد الضُعْف، الشِدَّة والقُدْرَة الجِسْمَانِيَّة؛ ضد الضُعْف، المَقْدِرَة والحَوْل والتَمَكُّن، القدرة المعنوية) / طَاقَة كَهْرَبَائِيَّة, طَاقَة (القُدْرَة والشِدَّة؛ هي مقدار ما يمكن للإنسان أن يفعله بمشقة، كأن قدرته محددة بطَوْق)\nمثال: توم شعر بالقوة.",
 "権力主義": "سُلْطَوِيَّة",
 "権力争い": "صِرَاع عَلَى ٱلسُّلْطَة",
 "権力抗争": "صِرَاع عَلَى ٱلسُّلْطَة",
 "権力政治": "دبلوماسية الزوارق الحربية, سياسة القوة (دبلوماسية تهدد فيها الدول باستخدام القوة لتحقيق أهدافها)",
 "権力者": "شخصية مؤثرة, شخصية هامة (شخص تؤثر أفعاله وآراؤه بقوة على مسار الأحداث)",
 "権力闘争": "صِرَاع عَلَى ٱلسُّلْطَة",
 "権助": "خادم رجل (خادم من الرجال)",
 "権勢": "قُوَّة, قُدْرَة (ضد الضُعْف، الشِدَّة والقُدْرَة الجِسْمَانِيَّة؛ ضد الضُعْف، المَقْدِرَة والحَوْل والتَمَكُّن، القدرة المعنوية) / قُوَّة (ضد الضُعْف، الشِدَّة والقُدْرَة الجِسْمَانِيَّة؛ ضد الضُعْف، المَقْدِرَة والحَوْل والتَمَكُّن، القدرة المعنوية) / قُوَّة, طَاقَة (ضد الضُعْف، الشِدَّة والقُدْرَة الجِسْمَانِيَّة؛ ضد الضُعْف، المَقْدِرَة والحَوْل والتَمَكُّن، القدرة المعنوية) / طَاقَة كَهْرَبَائِيَّة, طَاقَة (القُدْرَة والشِدَّة؛ هي مقدار ما يمكن للإنسان أن يفعله بمشقة، كأن قدرته محددة بطَوْق)\nمثال: توم شعر بالقوة.",
 "権化": "الحُلُول / التَّجَسُّد, التَّأَنُّس / تَجَسَّد",
 "権妻": "سَيِّدَة / خَلِيلَة, عَشِيقَة",
 "権威": "سُلْطَة (هو طعام يصنع من الخُضَار الطَازَجَة تقطع وتخلط ويضاف إليها المِلْح وقد يضاف عصير اللَيْمُون أو الخَلّ أو الزَيْت. لا يطبخ)\nمثال: هو متعطش للسلطة.",
 "権威主義": "سُلْطَوِيَّة",
 "権威的": "اِسْتِبْدَادِيّ, سُلْطَوِيّ / مُتَسَلِّط, مُسْتَبِدّ",
 "権威者": "سُلْطَة (هو طعام يصنع من الخُضَار الطَازَجَة تقطع وتخلط ويضاف إليها المِلْح وقد يضاف عصير اللَيْمُون أو الخَلّ أو الزَيْت. لا يطبخ)\nمثال: هو متعطش للسلطة.",
 "権宜": "تَوْقِيت مُنَاسِب, مُوَاتَاة (الملاءمة الزمنية)",
 "権柄": "قُوَّة, قُدْرَة (ضد الضُعْف، الشِدَّة والقُدْرَة الجِسْمَانِيَّة؛ ضد الضُعْف، المَقْدِرَة والحَوْل والتَمَكُّن، القدرة المعنوية) / قُوَّة (ضد الضُعْف، الشِدَّة والقُدْرَة الجِسْمَانِيَّة؛ ضد الضُعْف، المَقْدِرَة والحَوْل والتَمَكُّن، القدرة المعنوية) / قُوَّة, طَاقَة (ضد الضُعْف، الشِدَّة والقُدْرَة الجِسْمَانِيَّة؛ ضد الضُعْف، المَقْدِرَة والحَوْل والتَمَكُّن، القدرة المعنوية) / طَاقَة كَهْرَبَائِيَّة, طَاقَة (القُدْرَة والشِدَّة؛ هي مقدار ما يمكن للإنسان أن يفعله بمشقة، كأن قدرته محددة بطَوْق)\nمثال: توم شعر بالقوة.",
 "権柄ずく": "مُتَسَلِّط",
 "権的": "سَيِّدَة / خَلِيلَة, عَشِيقَة",
 "権益": "فَائِدَة",
 "権能": "سُلْطَة (هو طعام يصنع من الخُضَار الطَازَجَة تقطع وتخلط ويضاف إليها المِلْح وقد يضاف عصير اللَيْمُون أو الخَلّ أو الزَيْت. لا يطبخ)\nمثال: هو متعطش للسلطة.",
 "権藤": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "権衡": "رَصِيد",
 "権謀": "مَكِيدَة",
 "権謀術数": "حيلة, خديعة (استخدام الحيل لخداع شخص ما (عادة لانتزاع المال منه)) / احتيال, تلاعب (تضليل لفظي يهدف إلى استغلالك بطريقة ما)",
 "権謀術策": "حيلة, خديعة (استخدام الحيل لخداع شخص ما (عادة لانتزاع المال منه)) / احتيال, تلاعب (تضليل لفظي يهدف إلى استغلالك بطريقة ما)",
 "権貴": "قُوَّة عُظْمَى (ضد الضُعْف، الشِدَّة والقُدْرَة الجِسْمَانِيَّة؛ ضد الضُعْف، المَقْدِرَة والحَوْل والتَمَكُّن، القدرة المعنوية)\nمثال: توم شعر بالقوة.",
 "権道": "مَصْلَحَة ظَرْفِيَّة, مُلَائَمَة (صفة كون الشيء مناسباً للغابة المنشودة)",
 "権限": "قُوَّة, قُدْرَة (ضد الضُعْف، الشِدَّة والقُدْرَة الجِسْمَانِيَّة؛ ضد الضُعْف، المَقْدِرَة والحَوْل والتَمَكُّن، القدرة المعنوية) / قُوَّة (ضد الضُعْف، الشِدَّة والقُدْرَة الجِسْمَانِيَّة؛ ضد الضُعْف، المَقْدِرَة والحَوْل والتَمَكُّن، القدرة المعنوية) / قُوَّة, طَاقَة (ضد الضُعْف، الشِدَّة والقُدْرَة الجِسْمَانِيَّة؛ ضد الضُعْف، المَقْدِرَة والحَوْل والتَمَكُّن، القدرة المعنوية) / طَاقَة كَهْرَبَائِيَّة, طَاقَة (القُدْرَة والشِدَّة؛ هي مقدار ما يمكن للإنسان أن يفعله بمشقة، كأن قدرته محددة بطَوْق)\nمثال: توم شعر بالقوة.",
 "権限委譲": "لامركزية, نقل السلطة (تفويض السلطة (خاصة من حكومة مركزية إلى حكومة إقليمية)) / انحطاط, تدهور (عملية التراجع من مستوى أعلى إلى مستوى أدنى من القوة الفعالة أو الحيوية أو الجودة الأساسية)",
 "権高": "فَخْر (اعتزَّ أو تباهى بشيء يملكه أو بعمل قام به؛ زها على الآخرين وأبدى شعوره بالتفوق) / زُمْرَة\nمثال: أنا شديدة الفخر بأبي.",
 "横": "أُفُقِيّ / جانبي, من جانب لآخر (بالتناوب يساراً ويميناً بالنسبة لنقطة مركزية)\nمثال: الحركة الجانبية للقارب / جَانِب / صَفْحَة / بصرف النظر, جانباً (غير مأخوذ في الاعتبار أو مستبعد) / ادِّخَارًا, جَانِبًا (في الاحتياط؛ ليس للاستخدام الفوري) / جَانِبًا (على أو إلى جانب واحد) / بَعِيدًا, جَانِبًا (بعيداً عن الطريق (خاصة بعيداً عن أفكار المرء))\nمثال: بصرف النظر عن هذه المشاكل، البلاد تبلي بلاءً حسناً",
 "横ぎる": "صَلِيب / عَبْر, خِلَال (الشيء: اجتازه وقطعه من طرف إلى الطرف الآخر كاملا؛ الشخص: مات) / عَبَرَ (الشيء: اجتازه وقطعه من طرف إلى الطرف الآخر كاملا؛ الشخص: مات)\nمثال: عبر جرذ الطريق.",
 "横すべり": "انزلاق جانبي (مناورة طيران؛ تنزلق الطائرة جانبياً في الهواء) / انزلاق, تزحلق (انزلاق غير متوقع)",
 "横ずれ断層": "صدع انزلاقي الاتجاه (صدع جيولوجي يبدو فيه أن أحد السطحين المتجاورين قد تحرك أفقياً)",
 "横たわる": "اِسْتَلْقَى (وَضَعَ ظَهْرَهُ عَلَى سَطْحٍ كَالسَّرِيرِ والأَرْضِ للنوم أو الاستراحة) / اِضْطَجَعَ\nمثال: استلقى على السرير.",
 "横ちょ": "بشكل جانبي, بطرف العين (إلى جانب واحد أو باتجاهه) / بشكل جانبي, جانبياً (في اتجاه جانبي) / بشكل مائل, من الجانب (من الجانب؛ بشكل منحرف) / بالجنب, بالعرض (مع تقديم جانب واحد للأمام)\nمثال: عيون ترمق بطرف العين من وجه ذابل",
 "横っちょ": "بشكل جانبي, بطرف العين (إلى جانب واحد أو باتجاهه) / بشكل جانبي, جانبياً (في اتجاه جانبي) / بشكل مائل, من الجانب (من الجانب؛ بشكل منحرف) / بالجنب, بالعرض (مع تقديم جانب واحد للأمام)\nمثال: عيون ترمق بطرف العين من وجه ذابل",
 "横っ腹": "جَانِب / صَفْحَة",
 "横っ面": "جَانِب / صَفْحَة",
 "横づけ": "حبل إرساء ((مصطلح بحري) حبل يثبت جسماً (خاصة القارب) في مكانه) / مربط, مرسى (مكان يمكن فيه تثبيت القارب أو السفينة)",
 "横なぐり": "قُطْرِيّ, مَائِل (ذو اتِّجاه مائل أو منحرف عن الأفق)",
 "横に": "أفقياً (في اتجاه أفقي)\nمثال: غالباً ما يتم إضافة معرض للاستفادة من المساحة رأسياً وأفقياً / عَبْرَ (الشيء: اجتازه وقطعه من طرف إلى الطرف الآخر كاملا؛ الشخص: مات)\nمثال: عبر جرذ الطريق.",
 "横になる": "اِسْتَلْقَى (وَضَعَ ظَهْرَهُ عَلَى سَطْحٍ كَالسَّرِيرِ والأَرْضِ للنوم أو الاستراحة) / اِضْطَجَعَ\nمثال: استلقى على السرير.",
 "横にらみ": "وَهَج",
 "横ばい": "نطاط الأوراق (حشرة صغيرة قافزة تمتص عصارة النباتات) / أفعى جانبية الحركة, أفعى مقرنة / سايدويندر (صاروخ جو-جو بجهاز توجيه بالأشعة تحت الحمراء) / مُثَبِّت, مُسْتَقِرّ (يُؤَدِّي إلى الاسْتِقْرار والثَّبات)",
 "横やり": "مُقَاطَعَة",
 "横やりを入れる": "قَاطَعَ",
 "横を向く": "غضّ النظر, غضّ الطرف",
 "横パス": "تمريرة عرضية (تمريرة إلى مستقبل في الملعب بعيدًا عن الممرر)",
 "横一線": "بِمُحَاذَاة, جَنْبًا إِلَى جَنْب (بجانب بعضهما البعض، متجهين في نفس الاتجاه) / بسباق محموم, جنباً إلى جنب (متساوٍ أو متقارب في سباق أو منافسة أو مقارنة) / رَأْسًا بِرَأْسٍ, مُتَعَادِل (غَيْرُ حَاسِمٍ مِنْ حَيْثُ النَّتِيجَةُ؛ مُتَقَارِبٌ أَوْ مُتَسَاوٍ فِي سِبَاقٍ أَوْ مُنَافَسَةٍ)\nمثال: ركضت الخيول جنباً إلى جنب",
 "横丁": "شارع جانبي (شارع يتقاطع مع شارع رئيسي وينتهي عنده)",
 "横串": "تكامل أفقي (الاستيعاب في شركة واحدة لعدة شركات تعمل في نفس مستوى الإنتاج وتشارك الموارد في ذلك المستوى)",
 "横乳": "جانب الثدي (ثدي مكشوف من الجانب)",
 "横井": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "横付け": "حبل إرساء ((مصطلح بحري) حبل يثبت جسماً (خاصة القارب) في مكانه) / مربط, مرسى (مكان يمكن فيه تثبيت القارب أو السفينة)",
 "横切る": "صَلِيب / عَبْر, خِلَال (الشيء: اجتازه وقطعه من طرف إلى الطرف الآخر كاملا؛ الشخص: مات) / عَبَرَ (الشيء: اجتازه وقطعه من طرف إلى الطرف الآخر كاملا؛ الشخص: مات)\nمثال: عبر جرذ الطريق.",
 "横列": "رُتْبَة (رُتْبَة، بضم الراء؛ رَتْبَة، بفتح الراء)",
 "横取り": "إمساك, التقاط (فعل التقاط شيء باليدين) / خطف (رفعة أوزان يتم فيها رفع البار فوق الرأس في حركة واحدة سريعة) / اختطاف, خطف ((قانون) العمل غير القانوني المتمثل في القبض على شخص وحمله بعيداً رغماً عنه واحتجازه في سجن زائف) / فرج (مصطلحات بذيئة للأعضاء التناسلية الأنثوية)\nمثال: أمسك ميس بالكرة وظهره للوحة",
 "横合": "جَانِب / صَفْحَة",
 "横合い": "جَانِب / صَفْحَة",
 "横周": "عَرْض (أتى العروض، أي مكّة والمدينة وما حولهما؛ الفَرَسَ: سار به بالعُرض)\nمثال: قبل كلاي العرض.",
 "横地": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "横坑": "مدخل أفقي للمجم, نفق أفقي (ممر أفقي تقريباً من السطح إلى داخل المنجم)",
 "横堀": "خَنْدَق",
 "横太り": "قَصِير وَبَدِين, مُكَتَّل (قَصِير القَامَة وَمُمْتَلِئ الجِسْم)",
 "横奪": "اختلاس, سوء استخدام (استعارة غير مشروعة) / اختلاس, استيلاء (الاستيلاء الاحتيالي على أموال أو ممتلكات معهود بها لرعايتك ولكنها مملوكة فعلياً لشخص آخر)\nمثال: كان تفسيره سوء استخدام للنظرية الاجتماعية",
 "横尾": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "横山": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
