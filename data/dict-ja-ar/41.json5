{
 "無定見": "مُتَعَارِض, مُتَنَاقِض (غَيْرُ مُتَّسِقٍ أَوْ مُتَوَافِقٍ) / غير متسق, متناقض (يظهر نقصاً في الاتساق) / غَيْرُ مُتَّسِقٍ, مُتَنَاقِضٌ (لا يمكن جعله متسقاً أو منسجماً)\nمثال: التصريحات المتناقضة لا يمكن أن تكون صحيحة في نفس الوقت",
 "無実": "بَرَاءَة / لَا جَوْهَرِيَّة, وَهْن (الافتقار إلى الجوهر أو الواقع) / انعدام الجوهر, وهمية (نقص الجوهر الصلب والقوة) / رياء, زيف (صفة عدم الصراحة أو الصدق؛ الخداع أو النفاق)",
 "無害": "غير ضار, مسالم (لا يسبب أو غير قادر على التسبب في ضرر)\nمثال: بكتيريا غير ضارة",
 "無害化": "إزالة السموم (علاج للتسمم عن طريق تحييد الخصائص السامة (عادة وظيفة الكبد)) / تخلص من السموم, علاج الإدمان (علاج لإدمان المخدرات أو الكحول يهدف إلى إزالة الآثار الفسيولوجية للمواد المسببة للإدمان) / تَعْقِيم ((وعَقَّمَهُ تَعْقيمًا: أسْكَتَه)؛ عقّم يعقِّم تعقيماً،فهو معقِّم،والمفعول مُعقَّم ، عَقَّمَ حجرة العمليات :أباد ما فيها من جراثيم ضارّة و ميكروبات لمنع تطوّر المرض الناقل لل جراثيم)",
 "無家賃": "دُونَ إِيجَار, مَجَّانًا (بدون دفع إيجار) / مُعْفًى مِنَ الإِيجَار (مَجَّانِيّ؛ بِدُونِ دَفْعِ إِيجَار)\nمثال: يمكنني العيش هنا مجاناً",
 "無宿": "تشرد (حالة أو وضع عدم امتلاك منزل (خاصة حالة العيش في الشوارع))",
 "無宿者": "بِلا مَأْوَى, مُشَرَّد (شخص سيء الحظ بدون سكن)\nمثال: عُثر على مشرد مقتولاً في سنترال بارك",
 "無審査": "غَيْر مُجَرَّب, غَيْر مُخْتَبَر (لم يُخْتَبَر أو يُجَرَّب بالتجربة العملية) / غَيْر مُجَرَّب, غَيْر مُخْتَبَر (لم يُثبَت أو يُخضَع للاختبار بعد)",
 "無尽": "ديمومة, عدم القابلية للنفاذ (حالة أو شرط استحالة الاستنفاد أو النفاذ؛ كون الشيء غير محدود)\nمثال: يجب على الاقتصاديين التصالح مع عدم قابلية المعرفة للنفاذ، وحقيقة أن استخدام المعرفة لا يستنزفها",
 "無尾類": "ضفدع, علجوم (أي من البرمائيات المختلفة عديمة الذيل ممتلئة الجسم ذات أطراف خلفية طويلة للقفز؛ أنواع شبه مائية وأرضية) / بتراواني (يتعلق بالضفادع والعلاجيم)",
 "無尿": "انحباس البول, انقطاع البول (عدم القدرة على التبول)",
 "無届": "غَيْر مُسَجَّل ((عَنِ القَارِب أَوِ السَّفِينَة) غَيْر مُزَوَّد بِالوَثَائِق الرَّسْمِيَّة) / غير مسجل (غير مسجل) / غير مسجل ((للحيوانات) غير مسجل أو معتمد لدى جمعية سلالة رسمية)\nمثال: مواطن غير مسجل",
 "無届け": "غَيْر مُسَجَّل ((عَنِ القَارِب أَوِ السَّفِينَة) غَيْر مُزَوَّد بِالوَثَائِق الرَّسْمِيَّة) / غير مسجل (غير مسجل) / غير مسجل ((للحيوانات) غير مسجل أو معتمد لدى جمعية سلالة رسمية)\nمثال: مواطن غير مسجل",
 "無差別": "اعتباطي, عشوائي (لا يتميز بتمييزات دقيقة (يخلط الحابل بالنابل)) / عَشْوَائِيّ, غَيْر مُمَيِّز (يُخْفِق فِي التَّمْيِيز بَيْنَ الأَشْيَاء)\nمثال: عادات قراءة عشوائية",
 "無差別曲線": "منحنى السواء (في نظرية الاقتصاد الجزئي، رسم بياني يوضح مجموعات مختلفة من السلع التي يكون المستهلك غير مبالٍ بينها)",
 "無常": "زوال, عدم الدوام (خاصية عدم الوجود لمدد طويلة غير محددة) / قَابِل لِلطَّفْرَة (يميل إلى الخضوع لطفرة جينيّة) / قَابِل لِلتَّحَوُّل, مُتَغَيِّر (قادر على أو يميل إلى التغيير في الشكل أو الجودة أو الطبيعة) / غَيْرُ ثَابِتٍ, مُتَحَوِّل (مَيَّالٌ إِلَى التَّغَيُّرِ المُتَكَرِّرِ؛ غَيْرُ ثَابِتٍ)\nمثال: مادة قابلة للتحول",
 "無帽": "غَيْر مُغَطًّى, مَكْشُوف (غير مغطى بالملابس)",
 "無干渉": "عدم التدخل (سياسة خارجية للبقاء خارج نزاعات الدول الأخرى)",
 "無弓類": "لا ثقوبيات (زاحف بدائي ليس له فتحة في المنطقة الصدغية من الجمجمة؛ جميعها منقرضة باستثناء السلاحف)",
 "無形": "عَدِيمُ الشَّكْل (لَيْسَ لَهُ شَكْلٌ مَادِّيٌّ مُحَدَّد) / غَيْر مُتَبَلْوِر, لَا شَكْلِيّ (ليس له شكل محدَّد أو هيئة واضحة)",
 "無形文化遺産": "تراث ثقافي غير مادي",
 "無形財産": "أصل غير ملموس, أصول معنوية (أصول قابلة للبيع وإن لم كانت مادية أو فيزيائية)",
 "無彩色": "لَالَوْنِيّ, مُحَايِد (ليس له تدرج لوني)\nمثال: ألوان محايدة مثل الأسود أو الأبيض",
 "無役": "مُعْفًى مِنَ الرُّسُوم (مُعْفًى مِنَ الرُّسُومِ الجُمْرُكِيَّة)",
 "無得点": "بِلَا أَهْدَاف, بِلَا نِقَاط (لم يُسجَّل فيه أي نقاط أو أهداف)",
 "無徳": "فَقِير / مِسْكِين / فُقَرَاء",
 "無心": "بَرَاءَة / فصل, فك الارتباط (عملية التحرير من مرفق أو اتصال) / انفصال, تفكك (التفرق أو الانقسام) / انسحاب, تجرد (تجنب التورط العاطفي) / مفرزة (وحدة صغيرة من القوات ذات تكوين خاص) / بِلَا شُعُور, جَامِد (خالٍ من الشعور والوعي والحيوية)\nمثال: حجر جامد / مُزْعِج, مُضَايِق (يسبب الانزعاج أو الضيق)",
 "無念": "نَدِمَ / تَأَسَّفَ (تأسُّف) / أَسَف (مصدر أسِفَ على / أسِفَ لـ / أسِفَ من؛ أَسَفِي شَدِيدٌ على ما بَدَرَ مِنِّي : نَدَمِي) / تَأَسُّف (تأسُّف)\nمثال: للأسف ذلك صحيح.",
 "無念がる": "نَدِمَ / تَأَسَّفَ (تأسُّف) / أَسَف (مصدر أسِفَ على / أسِفَ لـ / أسِفَ من؛ أَسَفِي شَدِيدٌ على ما بَدَرَ مِنِّي : نَدَمِي) / تَأَسُّف (تأسُّف)\nمثال: للأسف ذلك صحيح.",
 "無念をはらす": "اِنْتَقَمَ",
 "無念を晴らす": "اِنْتَقَمَ",
 "無思慮": "طيش, عدم اكتراث (سمة عدم التفكير بعناية قبل التصرف) / اسْتِهْتَار, طَيْش (صفة الفشل في مراعاة شعور الآخرين)",
 "無性": "بِلَا جَاذِبِيَّة جِنْسِيَّة (غير جذّاب جنسيًّا) / عَدِيم الرَّغْبَة الجِنْسِيَّة (لا يشعر بأيّ رغبة جنسية) / خُنْثَوِيّ, عَقِيم (بلا أعضاء جنسية أو ذو أعضاء ناقصة النموّ أو غير فاعلة) / لَاجِنْسِيّ, لَاجِنْسِيَّة / لاجِنْسِيّ / لاجنسي",
 "無性に": "بشدة, بعمق (إلى عمق كبير نفسياً أو عاطفياً) / بشدة, مكثفاً (إلى درجة عالية؛ بتركيز عال)\nمثال: شعروا بالخسارة بعمق",
 "無性愛": "لَاجِنْسِيَّة",
 "無性生殖": "تَكَاثُر لَاجِنْسِيّ",
 "無性繁殖": "تَكَاثُر لَاجِنْسِيّ",
 "無性芽": "برعم تكاثري, جيمة (بنية تكاثرية لا جنسية صغيرة في حشيشة الكبد والحزازيات تنفصل عن الأصل وتتطور إلى فرد جديد)",
 "無恥": "وَقِح, صَفِيق",
 "無情": "غلظة, قسوة القلب (غياب الاهتمام برفاهية الآخرين) / بِلَا شُعُور, جَامِد (خالٍ من الشعور والوعي والحيوية)\nمثال: حجر جامد",
 "無惨": "قَاسٍ, الْقَاسِي (شديد وصلب، غير لين؛ جافٍ أو يابس في الملمس أو التعامل)\nمثال: قاس طول السرير. / مُثِير لِلشَّفَقَة, مُزْرٍ (يُثِير مَزيجاً مِن الاحتقار والشَّفَقة) / بَائِس, مُثِيرٌ لِلشَّفَقَة (يَسْتَحِقُّ الشَّفَقَةَ أَوْ يَسْتَدْعِيهَا) / مُؤْسِف, مُحْزِن (سيء ومؤسف؛ يبعث على الأسى)",
 "無意味": "هُرَاء, لَغْو",
 "無意志": "قسري, لا إرادي (غير خاضع لسيطرة الإرادة) / لا إرادي (يتم التحكم فيه بواسطة الجهاز العصبي اللاإرادي؛ دون تحكم واعي)\nمثال: قتل غير عمد (لا إرادي)",
 "無意気": "بَذِيء",
 "無意義": "بلا معنى, عبثي (ليس له معنى أو اتجاه أو غرض) / عَبَثِيّ, عَقِيم (لَا يُنْتِجُ أَيَّ نَتِيجَةٍ أَوْ أَثَر)\nمثال: مسعى بلا معنى",
 "無意識": "فِقْدَان اَلْوَعْي, إِغْمَاء / فاقد الوعي, لاواعٍ (غير واعٍ؛ يفتقر إلى الوعي والقدرة على الإدراك الحسي كما لو كان نائماً أو ميتاً) / لَا وَاعٍ (بِدُونِ إِرَادَةٍ وَاعِيَة) / عقل لاواعي, لاوعي (ذلك الجزء من العقل الذي يحدث فيه النشاط النفسي الذي لا يدركه الشخص)\nمثال: مستلقٍ فاقداً للوعي على الأرض",
 "無意識的": "فاقد الوعي, لاواعٍ (غير واعٍ؛ يفتقر إلى الوعي والقدرة على الإدراك الحسي كما لو كان نائماً أو ميتاً) / لَا وَاعٍ (بِدُونِ إِرَادَةٍ وَاعِيَة) / عقل لاواعي, لاوعي (ذلك الجزء من العقل الذي يحدث فيه النشاط النفسي الذي لا يدركه الشخص)\nمثال: مستلقٍ فاقداً للوعي على الأرض",
 "無愛嬌": "فَظّ, مُقْتَضَب (يتسم بالقصور الوقح أو الاستعلائي في الكلام)",
 "無愛想": "انطوائي, غير اجتماعي (لا يميل إلى المجتمع أو الرفقة)\nمثال: طبيعة غير اجتماعية؛ خجول ومتحفظ",
 "無愛敬": "فَظّ, مُقْتَضَب (يتسم بالقصور الوقح أو الاستعلائي في الكلام)",
 "無感動": "عادي, غير مثير للإعجاب (غير قادر على إثارة الإعجاب)",
 "無感情": "لَامُبَالَاة, عَدَم اِكْتِرَاث",
 "無感覚": "خَدِر (استتر؛ خدر بالمكان: أقام) / خَدَّرَ (استتر؛ خدر بالمكان: أقام) / خَفَّفَ (قلل شيئًا أو نقص من حدته؛ هون أو لطف من شدة أمر)\nمثال: خفف زيري السرعة. / لَا مُبَالٍ (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: لا أحب المدرسة.",
 "無愧": "وَقِح, صَفِيق",
 "無慈悲": "عديم الرحمة, قاسٍ (ليس لديه أو لا يظهر أي رحمة)\nمثال: العدو عديم الرحمة",
 "無慙": "قَاسٍ, الْقَاسِي (شديد وصلب، غير لين؛ جافٍ أو يابس في الملمس أو التعامل)\nمثال: قاس طول السرير. / مُثِير لِلشَّفَقَة, مُزْرٍ (يُثِير مَزيجاً مِن الاحتقار والشَّفَقة) / بَائِس, مُثِيرٌ لِلشَّفَقَة (يَسْتَحِقُّ الشَّفَقَةَ أَوْ يَسْتَدْعِيهَا) / مُؤْسِف, مُحْزِن (سيء ومؤسف؛ يبعث على الأسى)",
 "無慚": "قَاسٍ, الْقَاسِي (شديد وصلب، غير لين؛ جافٍ أو يابس في الملمس أو التعامل)\nمثال: قاس طول السرير. / مُثِير لِلشَّفَقَة, مُزْرٍ (يُثِير مَزيجاً مِن الاحتقار والشَّفَقة) / بَائِس, مُثِيرٌ لِلشَّفَقَة (يَسْتَحِقُّ الشَّفَقَةَ أَوْ يَسْتَدْعِيهَا) / مُؤْسِف, مُحْزِن (سيء ومؤسف؛ يبعث على الأسى)",
 "無慮": "حَوَالَيْ, تَقْرِيبًا",
 "無我": "إِيثَار, غَيْرِيَّة",
 "無我の境": "ترانس",
 "無所属": "مُسْتَقِل, حُرّ (اسم فاعل مِن اِسْتَقَلَّ؛ من لا يعتمد على غيره)\nمثال: الجزائر مستقلة الآن.",
 "無手": "فَارِغ اليَدَيْن (لَا يَحْمِلُ شَيْئًا فِي يَدَيْه) / خَالِي الوِفَاض, صِفْر اليَدَيْن (لم يكتسب أو يحصل على شيء)",
 "無才": "عَجْز, عَدَم كَفَاءَة (نقص في القدرة الجسدية أو الفكرية أو المؤهلات) / عجز, قصور (عدم قدرة جزء أو عضو على العمل بشكل صحيح)",
 "無批判": "أعمى (في الاتباع), غير انتقادي (غير ناقد؛ لا يميل إلى البحث عن الأخطاء أو لفت الانتباه إليها) / غير ممحص, غير نقدي (يتميز بتجاهل المعايير أو الإجراءات النقدية)\nمثال: معجب مخلص وتقريباً غير انتقادي (أعمى)",
 "無技巧": "بَسِيط, سَاذَج (بسيط وطبيعي؛ بدون مكر أو خداع) / بسيط, ساذج (يتميز بعدم القدرة على إخفاء المشاعر؛ غير ماكر) / سَاذَجٌ, غَيْرُ مُثَقَّفٍ ((عن الأشخاص) يفتقر إلى الثقافة أو المعرفة) / خَالٍ مِنَ الْبَرَاعَةِ, سَاذَج (يُظهر افتقارًا إلى الحرفية والفنّ)\nمثال: أسلوب بسيط",
 "無抵抗": "عَدَم المُقَاوَمَة (رفض جماعي للجوء إلى العنف حتى في الدفاع ضد العنف)",
 "無抵抗主義": "عَدَم المُقَاوَمَة (رفض جماعي للجوء إلى العنف حتى في الدفاع ضد العنف)",
 "無担保": "بِلَا ضَمَان, غَيْر مَضْمُون (بدون ضمان ماليّ) / غَيْر مُقْفَل, مَحْلُول (غير مثبّت أو مؤمّن بإحكام)",
 "無挨拶": "خشونة, قلة ذوق (قلة أدب متعمدة)",
 "無援": "عَاجِز",
 "無政府": "فَوْضَى, فَوْضَوِيَّة",
 "無政府主義": "لَاسُلْطَوِيَّة",
 "無政府主義者": "فَوْضَوِيّ, فَوْضَوِيَّة",
 "無政府共産主義": "شيوعية لاسلطوية (نظرية لاسلطوية تدعو إلى إلغاء الدولة والرأسمالية والأجور والملكية الخاصة، وتؤيد الملكية المشتركة لوسائل الإنتاج والديمقراطية المباشرة)\nمثال: في الوقت نفسه، كان يتطور من اللاسلطوية الجماعية لباكونين إلى مذهب الشيوعية اللاسلطوية",
 "無政府状態": "فَوْضَى, فَوْضَوِيَّة",
 "無政府資本主義": "لاسلطوية رأسمالية",
 "無敗": "بلا هزيمة, غير مهزوم (منتصر (لم يهزم))\nمثال: غير مهزوم في المعركة",
 "無教育": "جاهل, غير متعلم (لا يمتلك تعليماً جيداً)",
 "無教養": "جاهل, غير متعلم (لا يمتلك تعليماً جيداً)",
 "無数": "لَا يُحْصَى, لَا يُعَدّ (أَكْثَر مِنْ أَنْ يُحْصَى أَوْ يُعَدّ)",
 "無敵": "مَنِيع",
 "無文": "سادة, غير منقوش (يفتقر للنقوش خاصة في اللون)",
 "無料": "حُرّ (ضد البَرْد) / شَاغِر, فَاضٍ / بِغَيْرِ, بِدُونِ / مَجَّانًا / حَرَّرَ (يُصَغَّرُ عَلَى حُرَيْحٍ وَيُجْمَعُ عَلَى أَحْرَاحٍ؛ ضد الْعَبْدِ)\nمثال: أنا حر كالطائر.",
 "無料通話": "مجاني (لا تفرض عليه رسوم استخدام)\nمثال: طريق مجاني",
 "無断借用": "اختلاس, سوء استخدام (استعارة غير مشروعة) / اختلاس, استيلاء (الاستيلاء الاحتيالي على أموال أو ممتلكات معهود بها لرعايتك ولكنها مملوكة فعلياً لشخص آخر)\nمثال: كان تفسيره سوء استخدام للنظرية الاجتماعية",
 "無断居住者": "محتل للمكان, واضع اليد (شخص يستقر في أرض أو مسكن دون حق أو سند قانوني) / مستوطن, واضع اليد (شخص يستقر بشكل قانوني على أرض حكومية بقصد الحصول على حق ملكيتها)",
 "無断欠席": "تَمَلُّص, هُرُوب مِن المَدْرَسَة (الفشل في الحضور (خاصة المدرسة))",
 "無方針": "انعدام الهدف, عبثية (صفة الافتقار إلى أي غرض محدد)",
 "無智": "جَهْل, جَهَالَة (الجَهْل: نَقِيضُ العِلْم؛ تَجَاهَلَ: أَظهر الجَهْل)\nمثال: العلم نور والجهل ظلام.",
 "無月経": "انقطاع الطمث (غياب أو قمع تدفق الطمث الطبيعي)",
 "無期": "نَكِرَة / سَجْن مُؤَبَّد (وضع شخصًا أو شيئًا في السجن أو الحبس؛ قيّد حرية شخص أو حركة شيء)\nمثال: دخل سامي السجن.",
 "無期刑": "سَجْن مُؤَبَّد (وضع شخصًا أو شيئًا في السجن أو الحبس؛ قيّد حرية شخص أو حركة شيء)\nمثال: دخل سامي السجن.",
 "無期懲役": "سَجْن مُؤَبَّد (وضع شخصًا أو شيئًا في السجن أو الحبس؛ قيّد حرية شخص أو حركة شيء)\nمثال: دخل سامي السجن.",
 "無期限": "نَكِرَة",
 "無条件": "غَيْر مَشْرُوط (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "無条件反射": "رد فعل منعكس, منعكس (رد فعل تلقائي غريزي غير متعلم لمحفز)",
 "無条件降伏": "استسلام غير مشروط",
 "無東西": "حَاجّ, حَجِّيّ (افتقر)\nمثال: لا أرى لذلك حاجة.",
 "無柄": "جَالِس, عَدِيم السُّوَيْقَة (متصل مباشرة بالقاعدة؛ ليس له ساق وسيطة) / ثَابِت, لَاطِئ (متصل بشكل دائم بركيزة؛ ليس حراً في التحرك)\nمثال: زهور لاطئة",
 "無根": "لَا أَسَاس لَه, وَاهٍ (بدون أساس في العقل أو الواقع)",
 "無根拠": "لَا أَسَاس لَه, وَاهٍ (بدون أساس في العقل أو الواقع)",
 "無極": "بِلَا حُدُود, لَامَحْدُود (يَبْدُو بِلَا حُدُودٍ فِي الكَمِّيَّةِ أَوِ العَدَدِ أَوِ الدَّرَجَةِ أَوِ المَدَى) / بلا حدود, غير محدود (ليس له حدود في المدى أو النطاق) / لَا حَدَّ لَه, لَا مَحْدُود (بلا حدود في المدى أو الحجم أو الكمية)\nمثال: البدء بنظرية الحرية غير المحدودة هو الانتهاء باستبداد غير محدود",
 "無様": "كَرِيه المَنْظَر (غير سار للنظر)",
 "無標": "غير موسوم, غير مُميز (ليس لديه علامة تعريف) / غَيْر مُلَاحَظ, مُغْفَل (لم يُؤخَذ في الحسبان)\nمثال: أوراق لعب غير معلمة",
 "無機": "غير عضوي (متعلق أو منتمي لفئة المركبات التي ليس أساسها الكربون) / جامد, غير عضوي (يفتقر لخصائص الكائنات الحية)\nمثال: أحماض الهيدروكلوريك والكبريتيك تسمى مواد غير عضوية / كيمياء اللاعضوية (الحيلة والحِذق، وكان يراد بها عند القدماء: تحويل بعض المعادن إلى بعض، ولا يسما إلى الذهب؛ علم من علوم الطبيعة يتناول خواص العناصر والمركبات والقوانين التي تحكم تفاعلاتها)\nمثال: هو يحب الكيمياء. / مركب غير عضوي (أي مركب لا يحتوي على الكربون)",
 "無機化合物": "مركب غير عضوي (أي مركب لا يحتوي على الكربون)",
 "無機化学": "كيمياء اللاعضوية (الحيلة والحِذق، وكان يراد بها عند القدماء: تحويل بعض المعادن إلى بعض، ولا يسما إلى الذهب؛ علم من علوم الطبيعة يتناول خواص العناصر والمركبات والقوانين التي تحكم تفاعلاتها)\nمثال: هو يحب الكيمياء.",
 "無機物": "مركب غير عضوي (أي مركب لا يحتوي على الكربون)",
 "無機的": "غير عضوي (متعلق أو منتمي لفئة المركبات التي ليس أساسها الكربون) / جامد, غير عضوي (يفتقر لخصائص الكائنات الحية)\nمثال: أحماض الهيدروكلوريك والكبريتيك تسمى مواد غير عضوية",
 "無機質": "بَارِد, برد (مُنْخَفِض الحَرارة أو حَرارتُه أقلّ من حَرارة جسْم الإنسان؛ غير حامٍ، أو متروك بلا حماوة، غير محميّ على النَّار) / بَرْدَان / بُرُودَة, بَرْد / زُكَام, رَشْح\nمثال: الماء بارد حقا.",
 "無機質肥料": "سماد معدني (سماد غير عضوي يحتوي على معادن نادرة)",
 "無欠": "بِلَا عَيْب, خَالٍ مِنَ العُيُوب (خالٍ من أيّ عيب أو شائبة)",
 "無欲": "غَيْر أَنَانِيّ, نَزِيه (ليس جشعاً أو طمّاعاً) / غير أناني, مؤثر (للغير) (يتجاهل مصالحه ورفاهيته الخاصة لصالح الآخرين)",
 "無残": "قَاسٍ, الْقَاسِي (شديد وصلب، غير لين؛ جافٍ أو يابس في الملمس أو التعامل)\nمثال: قاس طول السرير. / مُثِير لِلشَّفَقَة, مُزْرٍ (يُثِير مَزيجاً مِن الاحتقار والشَّفَقة) / بَائِس, مُثِيرٌ لِلشَّفَقَة (يَسْتَحِقُّ الشَّفَقَةَ أَوْ يَسْتَدْعِيهَا) / مُؤْسِف, مُحْزِن (سيء ومؤسف؛ يبعث على الأسى)",
 "無段": "غَيْر مُدَرَّج, غَيْر مُرَتَّب (غير منظَّم ترتيباً هرميّاً) / مُتَوَاصِل, مُتَّصِل",
 "無段階": "مُتَوَاصِل, مُتَّصِل",
 "無毒": "غَيْرُ سَامّ (آمن للأكل) / غَيْرُ سَامّ (لا ينتج سمًّا ولا يحتوي عليه)",
 "無毒化": "إزالة السموم (علاج للتسمم عن طريق تحييد الخصائص السامة (عادة وظيفة الكبد)) / تخلص من السموم, علاج الإدمان (علاج لإدمان المخدرات أو الكحول يهدف إلى إزالة الآثار الفسيولوجية للمواد المسببة للإدمان)",
 "無比": "لَا مَثِيلَ لَهُ, لَا نَظِيرَ لَهُ (بارز يفوق أيّ مقارنة؛ فريد لا يُضاهى)",
 "無毛": "أَجْرَد",
 "無気": "تَمَامًا / شَقَاوَة, تَعَاسَة",
 "無気力": "لَامُبَالَاة, عَدَم اِكْتِرَاث",
 "無気力状態": "لَامُبَالَاة, عَدَم اِكْتِرَاث",
 "無気味": "عَجِيب, غَرِيب",
 "無気肺": "انخماص الرئة (انهيار رئة متمددة (خاصة عند الرضع)؛ أو فشل الحويصلات الهوائية الرئوية في التوسع عند الولادة)",
 "無水": "لامائي (بدون ماء؛ خاصة بدون ماء التبلور) / جَدْب, قَاحِل (يفتقر إلى ما يكفي من الماء أو الأمطار)",
 "無水アルコール": "كحول مطلق (كحول إيثيلي نقي (يحتوي على ما لا يزيد عن 1% ماء))",
 "無水ケイ酸": "ثاني أكسيد السيليكون, سيليكا",
 "無水フタル酸": "أنهيدريد الفثاليك (أنهيدريد حلقي أبيض)",
 "無水亜ヒ酸": "ثلاثي أكسيد الزرنيخ, زرنيخ (مسحوق أبيض سام من ثلاثي أكسيد الزرنيخ؛ يستخدم في صناعة الزجاج وكمبيد للآفات (سم الفئران) ومبيد للأعشاب)",
 "無水亜砒酸": "ثلاثي أكسيد الزرنيخ, زرنيخ (مسحوق أبيض سام من ثلاثي أكسيد الزرنيخ؛ يستخدم في صناعة الزجاج وكمبيد للآفات (سم الفئران) ومبيد للأعشاب)",
 "無水物": "أنهيدريد (مركب يتكون من مركب آخر أو أكثر في تفاعل يؤدي إلى إزالة الماء)",
 "無水珪酸": "ثاني أكسيد السيليكون, سيليكا",
 "無水酢酸": "أنهيدريد الأسيتيك (مركب ضروري لتكرير الأفيون وتحويله إلى هيروين)",
 "無汗症": "انحباس العرق, لا تعرق (فشل الغدد العرقية في العمل)",
 "無法": "عَدَم وُجُود قَوَانِين (الفقدان ونقيض الوجود؛ يجب عدم فعل كذا: أي يجب الامتناع عن الفعل)\nمثال: عليك عدم الخوف. / بَاهِظ, فَاحِش (يَتَجَاوَزُ حُدُودَ المَعْقُولِ وَالاعْتِدَالِ بِكَثِير) / شَنِيع, فَظِيع (مسيء بشكل فاحش للآداب أو الأخلاق؛ مثير للرعب)",
 "無法国家": "دولة مارقة (دولة لا تحترم الدول الأخرى في أعمالها الدولية)",
 "無法状態": "عَدَم وُجُود قَوَانِين (الفقدان ونقيض الوجود؛ يجب عدم فعل كذا: أي يجب الامتناع عن الفعل)\nمثال: عليك عدم الخوف.",
 "無法者": "جانٍ, مجرم (شخص ارتكب جريمة أو تمت إدانته قانونياً بجريمة)",
 "無漂白": "غَيْر مَصْبُوغ, غَيْر مُبَيَّض (لم يُلوَّن أو يُبيَّض صناعيًّا)",
 "無点": "بلا معنى, عبثي (ليس له معنى أو اتجاه أو غرض) / عَبَثِيّ, عَقِيم (لَا يُنْتِجُ أَيَّ نَتِيجَةٍ أَوْ أَثَر)\nمثال: مسعى بلا معنى",
 "無為": "بطالة, تسكع (عدم القيام بعمل أو وظيفة) / بطالة, تراخ (سمة كون المرء عاطلاً بسبب العزوف عن العمل) / بُطْلَان, لَا أَسَاس (صفة الافتقار إلى الجوهر أو القيمة)\nمثال: تم التعرف بسرعة على بطلان تقريرهم",
 "無為無聊": "مَلَل, ضَجَر",
 "無煙": "بلا دخان, غير مدخن (ينبعث منه القليل من الدخان أو لا ينبعث منه على الإطلاق)\nمثال: مداخن مصانع بلا دخان",
 "無煙火薬": "بارود عديم الدخان, باليستيت (مادة متفجرة (الاسم التجاري باليستيت) تحترق بدخان قليل نسبيًا؛ تحتوي على البايروسليلوز وتستخدم كوقود دافع)",
 "無煙炭": "أنتراسيت, فحم حجري صلب (فحم طبيعي صلب يحترق ببطء ويعطي حرارة شديدة)",
 "無現": "لَا مُتَنَاهٍ (كلّيّ وشامل لكلّ شيء) / فراغ, فضاء (المدى غير المحدود الذي يقع فيه كل شيء) / لَا يُحْصَى, لَا يُعَدّ (أَكْثَر مِنْ أَنْ يُحْصَى أَوْ يُعَدّ) / غير محدود, لانهائي (ليس له حدود أو قيود في الزمان أو المكان أو المدى أو الحجم)\nمثال: اختبروا قدرته على تحديد مواقع الأشياء في الفضاء",
 "無理": "غَيْرُ مَعْقُول, مُفْرِط (يَتَجَاوَزُ الحُدُودَ الطَّبِيعِيَّة) / غير معقول, غير منطقي (غير معقول؛ لا يظهر حكماً صائباً) / مُسْتَحِيل / بِالقُوَّة, قَسْرِيّ (مدفوع بالقوّة الجسدية خاصة ضدّ المقاومة) / مُفْرِط, زَائِد",
 "無理からぬ": "مَعْقُول (مربوط، قد عُقِلَ بالعِقَال؛ ما يمكن عَقْلَه بالعَقْل)\nمثال: زيري يخاف العناكب بصفة غير معقولة.",
 "無理くり": "بالإكراه, بالقوة (بطريقة تتضمن استخدام القوة)\nمثال: تذكر مخاطر فرض قيمنا وتحيزاتنا بالقوة",
 "無理じい": "قُوَّة (ضد الضُعْف، الشِدَّة والقُدْرَة الجِسْمَانِيَّة؛ ضد الضُعْف، المَقْدِرَة والحَوْل والتَمَكُّن، القدرة المعنوية) / أَجْبَرَ, اِضْطَرَّ (فعل تعدّي من جَبَرَ؛ جعله يَجْبُر، ضد أَكْسَرَ؛ جعله يفعل شيئا رُغْما عنه؛ أَرْغَمَ)\nمثال: توم شعر بالقوة.",
 "無理ない": "طَبِيعِيّ",
 "無理なく": "بِشَكْل مَنْطِقِيّ / بشكل معقول",
 "無理のない": "طَبِيعِيّ",
 "無理はない": "طَبِيعِيّ",
 "無理もない": "طَبِيعِيّ",
 "無理やり": "بالإكراه, بالقوة (بطريقة تتضمن استخدام القوة)\nمثال: تذكر مخاطر فرض قيمنا وتحيزاتنا بالقوة",
 "無理圧状": "قَهْر, قَسْر (غَلَبَ وانْتَصَرَ ولم يقدر عليه أحد) / إِكْرَاه",
 "無理強い": "قُوَّة (ضد الضُعْف، الشِدَّة والقُدْرَة الجِسْمَانِيَّة؛ ضد الضُعْف، المَقْدِرَة والحَوْل والتَمَكُّن، القدرة المعنوية) / أَجْبَرَ, اِضْطَرَّ (فعل تعدّي من جَبَرَ؛ جعله يَجْبُر، ضد أَكْسَرَ؛ جعله يفعل شيئا رُغْما عنه؛ أَرْغَمَ)\nمثال: توم شعر بالقوة.",
 "無理往生": "قَهْر, قَسْر (غَلَبَ وانْتَصَرَ ولم يقدر عليه أحد) / إِكْرَاه",
 "無理押し": "جَرَّفَ (أخذ شيئًا وجرفه بعيدًا، أو سحب شيئًا بقوة؛ في : في بعض الحالات، قد تستخدم للإشارة إلى إزالة أو جرف شيء نحو مكان آخر)\nمثال: وقف على حافة الجرف.",
 "無理数": "عَدَد غَيْر نِسْبِيّ (عدد حقيقي لا يمكن التعبير عنه كعدد نسبي (كسر))",
 "無理無い": "طَبِيعِيّ",
 "無理無く": "بِشَكْل مَنْطِقِيّ / بشكل معقول",
 "無理非道": "بَاهِظ, فَاحِش (يَتَجَاوَزُ حُدُودَ المَعْقُولِ وَالاعْتِدَالِ بِكَثِير) / بِلَا وَازِع, عَدِيمُ الضَّمِير (يفتقر إلى الضمير والوازع الأخلاقيّ)",
 "無産者": "بْرُولِيتَارِيّ / بْرُولِيتَارِيّ, بْرُولِيتَارِيَّة",
 "無用": "عَدِيمُ الْفَائِدَةِ (عديم: فقير؛ عديم: أحمق، غبي)\nمثال: كن عديم الرحمة. / غَيْر ضَرُورِيّ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ. / لا تربطه قرابة, ليس قريباً (غير متصل بقرابة) / غير ذي صلة, غير مرتبط (يفتقر لعلاقة منطقية أو سببية) / مَحْظُور, مَمْنُوع (غَيْر مَسْموح بِهِ بِمُوجَب القانون) / مَحْظُور, مُحَرَّم (ممنوع استخدامه أو ذكره)",
 "無用の長物": "زيادة لا لزوم لها, عجلة خامسة (شخص أو شيء غير مرغوب فيه وغير مطلوب) / خشب ميت (فرع أو جزء من شجرة ميت)",
 "無用心": "خطر, خطير (ينطوي على خطر أو يسببه؛ عرضة للتسبب في الأذى أو الضرر) / غير آمن, محفوف بالمخاطر (يفتقر إلى الأمن أو السلامة) / غَيْرُ آمِن, مُعَرَّضٌ لِلخَطَر (غَيْرُ مَحْمِيٍّ مِنَ الهُجُوم)\nمثال: مجرم خطير",
 "無畏": "انتفاء الخوف, جسارة (سمة عدم الشعور بالخوف) / جسارة, عدم الخوف (عدم الشعور بالخوف)",
 "無症候": "دون السريري (متعلق بمرحلة تطور المرض قبل ظهور الأعراض)",
 "無症状": "دون السريري (متعلق بمرحلة تطور المرض قبل ظهور الأعراض)",
 "無痛": "غَيْر مُؤْلِم (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "無痛症": "تسكين الألم, فقدان الإحساس بالألم (غياب الإحساس بالألم دون فقدان الوعي)",
 "無発酵パン": "خبز الفطير, ماتزو (خبز مسطح هش يؤكل في عيد الفصح اليهودي)",
 "無益": "عَدِيمُ الْفَائِدَةِ (عديم: فقير؛ عديم: أحمق، غبي)\nمثال: كن عديم الرحمة.",
 "無目": "رافدة, عارضة النافذة (قطعة عرضية أفقية عبر نافذة أو تفصل باباً عن نافذة فوقه) / نافذة العارضة (نافذة فوق الباب تكون عادة مفصلية بعارضة أفقية فوق الباب)",
 "無目的": "بلا هدف, عبثي (لا يظهر أي غرض أو هدف) / عَبَثِيّ, لَا طَائِلَ مِنْه (لَا يَخْدِمُ أَيَّ غَرَضٍ مُفِيد؛ لَا مُبَرِّرَ لِوُجُودِه)",
 "無着陸": "رحلة بدون توقف (رحلة تتم دون توقفات وسيطة بين المصدر والوجهة) / بلا توقف (بدون توقف) / دُونَ تَوَقُّف, عَلَى مَدَارِ السَّاعَة (فِي جَمِيعِ الأَوْقَات؛ دُونَ انْقِطَاع) / بِدُون تَوَقُّف ((عَنِ الرِّحْلَات خَاصَّةً الجَوِّيَّة) تَتِمّ بِدُون تَوَقُّفَات)\nمثال: كم عدد الرحلات بدون توقف إلى دالاس؟",
 "無着陸飛行": "رحلة بدون توقف (رحلة تتم دون توقفات وسيطة بين المصدر والوجهة)\nمثال: كم عدد الرحلات بدون توقف إلى دالاس؟",
 "無矛盾性": "اِتِّسَاق",
 "無知": "جَهْل, جَهَالَة (الجَهْل: نَقِيضُ العِلْم؛ تَجَاهَلَ: أَظهر الجَهْل)\nمثال: العلم نور والجهل ظلام.",
 "無知は幸福": "الْجَهْل نَعِيمَهُ, الْجَهْل نِعْمَة",
 "無知愚昧": "جاهل, غير مستنير (ليس مستنيراً؛ جاهل) / سَاذَج, غَيْرُ مُوَجَّه (يفتقر إلى المعلومات أو التوجيه)\nمثال: الوسائل التي حفظ بها الرجال غير المستنيرين النظام الاجتماعي غير العادل",
 "無知蒙昧": "جاهل, غير مستنير (ليس مستنيراً؛ جاهل) / سَاذَج, غَيْرُ مُوَجَّه (يفتقر إلى المعلومات أو التوجيه)\nمثال: الوسائل التي حفظ بها الرجال غير المستنيرين النظام الاجتماعي غير العادل",
 "無礼": "فجاجة, قلة أدب (أسلوب وقح ومهين) / بدائية, خشونة (حالة برية أو غير مهذبة) / فَظّ",
 "無神経": "غير حساس, متبلد الحس (غير مستجيب للمحفزات الجسدية) / عديم الإحساس, غليظ (يفتقر إلى المشاعر الإنسانية؛ غير حساس عقليًا أو أخلاقيًا)\nمثال: غير حساس للإشعاع",
 "無神者": "مُلْحِد, مُلْحِدَة",
 "無神論": "إِلْحَاد / زَنْدَقَة",
 "無神論者": "مُلْحِد, مُلْحِدَة",
 "無私": "غَيْر أَنَانِيّ, نَزِيه (ليس جشعاً أو طمّاعاً) / غير أناني, مؤثر (للغير) (يتجاهل مصالحه ورفاهيته الخاصة لصالح الآخرين)",
 "無私無欲": "إِيثَار, غَيْرِيَّة",
 "無秩序": "اِخْتِلال, اِضْطِراب (الاِخْتِلال : اتّخاذ الخلّ من العصير؛ اختلّ الأمر : وقع فيه الخلل) / اِضْطِرَاب",
 "無税": "مُعْفًى مِنَ الرُّسُوم (مُعْفًى مِنَ الرُّسُومِ الجُمْرُكِيَّة)",
 "無税品": "مُعْفًى مِنَ الرُّسُوم (مُعْفًى مِنَ الرُّسُومِ الجُمْرُكِيَّة)",
 "無稽": "لَا أَسَاس لَه, وَاهٍ (بدون أساس في العقل أو الواقع)",
 "無窮": "أَبَد (الأبَد : الدَّهْرُ وَيُقَالُ الدَّهْرُ الطَّوِيلُ الَّذِي لَيْسَ بِمَحْدُودٍ؛ ما يَنْفُر القَلْب عن تقدير نهايته) / أبَدِيَّة\nمثال: سأحبك إلى الأبد.",
 "無窮動": "حركة أبدية (حركة تستمر إلى أجل غير مسمى دون أي مصدر خارجي للطاقة؛ مستحيلة عملياً بسبب الاحتكاك)",
 "無窮花": "ختمية سورية, ورد شارون (شجيرة آسيوية أو شجرة شجيرية صغيرة ذات زهور وردية أو أرجوانية أو بيضاء مبهرجة على شكل جرس وأوراق ثلاثية الفصوص عادة؛ تزرع على نطاق واسع في أمريكا…)",
 "無筆": "أُمِّيَّة",
 "無節操": "عَدِيم المَبَادِئ (يفتقر إلى النزاهة أو المبادئ الأخلاقيَّة) / غير مبدئي, مجرد من المبادئ (يفتقر للمبادئ أو الوازع الأخلاقي)\nمثال: التحرر من الافتراء الفظ غير المبدئي",
 "無籍者": "تَائِه, مُتَشَرِّد (يتنقّل باستمرار خاصّة من مسكن أو عمل لآخر) / متشرد, هائم (متجول ليس لديه إقامة ثابتة أو وسيلة عيش ظاهرة)",
 "無粋": "بَذِيء / غَلِيظٌ, فَظٌّ (سيئ السلوك وخشن ومحتقر في التصرف أو المظهر)",
 "無精": "بُطْء",
 "無精ひげ": "شُعَيْرَات اللِّحْيَة / قَشّ",
 "無精者": "انحناء, ترهل (انحناء القامة عند الوقوف والمشي) / شخص غير كفء, متكاسل (شخص غير كفء؛ تستخدم عادة في صيغ النفي)\nمثال: إنه ليس متكاسلاً عندما يتعلق الأمر بالبيسبول",
 "無精髭": "شُعَيْرَات اللِّحْيَة / قَشّ",
 "無糖": "خال من السكر (لا يحتوي على السكر)",
 "無糸分裂": "انقسام مباشر, لا تفتلي (الطريقة المباشرة لانقسام الخلية التي تتميز بالانقسام البسيط للنواة دون تكوين كروموسومات)",
 "無終": "ديمومة, لا نهائية (خاصية كونه (أو يبدو أنه) بلا نهاية)",
 "無給": "بلا أجر, غير مدفوع (لم يتم الدفع له) / تَرْفِيهِيّ, هَاوٍ (يُمارَس كهواية أو تسلية) / تَطَوُّعِيّ, غَيْرُ مَأْجُور (بِدُونِ مُقَابِلٍ مَادِّيّ)\nمثال: أجور غير مدفوعة",
 "無統制": "خارج عن السيطرة, غير منضبط (غير خاضع للسيطرة؛ خارج السيطرة)\nمثال: أكبر مشكلة صحية غير مسيطر عليها هي الإيدز",
 "無線": "رَادْيُو, رَادِيُو / لَاسِلْكِيّ",
 "無線ラン": "شبكة محلية لاسلكية, واي فاي (شبكة محلية تستخدم إشارات راديو عالية التردد لإرسال واستقبال البيانات عبر مسافات تصل إلى بضع مئات من الأقدام؛ تستخدم بروتوكول إيثرنت)",
 "無線周波": "تَرَدُّد رَادْيَوِيّ (تردد موجة كهرومغناطيسية بين الصوتية والأشعة تحت الحمراء)",
 "無線周波数": "تَرَدُّد رَادْيَوِيّ (تردد موجة كهرومغناطيسية بين الصوتية والأشعة تحت الحمراء)",
 "無線家": "عامل لاسلكي, مشغل راديو (شخص يقوم بتشغيل جهاز إرسال لاسلكي)",
 "無線局": "مَحَطَّة إِذَاعِيَّة",
 "無線標識": "منارة لاسلكية (محطة إذاعية تبث إشارة توجيهية لأغراض الملاحة) / منارة لاسلكية (إشارة مميزة يبعثها جهاز إرسال يستخدم للملاحة)",
 "無線機": "رَادْيُو, رَادِيُو",
 "無線電話": "هاتف راديوي, هاتف لاسلكي (هاتف يتصل عبر موجات الراديو بدلاً من الكابلات) / راديو تليفون, هاتف لاسلكي (المهاتفة التي تستخدم الإرسال عن طريق الراديو بدلاً من الأسلاك)",
 "無線ＬＡＮ": "شبكة محلية لاسلكية, واي فاي (شبكة محلية تستخدم إشارات راديو عالية التردد لإرسال واستقبال البيانات عبر مسافات تصل إلى بضع مئات من الأقدام؛ تستخدم بروتوكول إيثرنت)",
 "無縁": "لا تربطه قرابة, ليس قريباً (غير متصل بقرابة) / غير ذي صلة, غير مرتبط (يفتقر لعلاقة منطقية أو سببية)",
 "無縁墓地": "مقبرة الغرباء (مقبرة للأشخاص المجهولين أو المعوزين)",
 "無罪": "بَرَاءَة",
 "無罪放免": "تَبْرِئَة",
 "無署名": "غير موقع (يفتقر إلى التوقيع)\nمثال: الرسالة كانت مطبوعة وغير موقعة",
 "無義道": "وحشية",
 "無考え": "غَافِل, لَامُبَالٍ (بلا اكتراث أو اهتمام بالآخرين) / أرعن, طائش (يظهر نقصًا في التفكير المتأني)\nمثال: تحول النقاش إلى مشاحنات طائشة",
 "無聊": "مَلَل, ضَجَر / ساخط, غير راضٍ (يظهر أو يمر بعدم الرضا أو الشوق القلق) / سخط, عدم رضا (توق لشيء أفضل من الوضع الحالي)\nمثال: رأى العديد من الوجوه الساخطة في الغرفة",
 "無職": "مُتَبَطِّل, مُتَبَطِّلَة",
 "無職者": "عاطل عن العمل (شخص بلا وظيفة)",
 "無能": "عَجْز, عَدَم كَفَاءَة (نقص في القدرة الجسدية أو الفكرية أو المؤهلات) / عجز, قصور (عدم قدرة جزء أو عضو على العمل بشكل صحيح) / عاجز, غير كفء (شخص ليس لديه الكفاءة لاتخاذ إجراءات فعالة)",
 "無能力": "عَجْز, عَدَم كَفَاءَة (نقص في القدرة الجسدية أو الفكرية أو المؤهلات) / عجز, قصور (عدم قدرة جزء أو عضو على العمل بشكل صحيح)",
 "無能力者": "عاجز, غير كفء (شخص ليس لديه الكفاءة لاتخاذ إجراءات فعالة)",
 "無能者": "عَاجِز, غَيْر مُؤَهَّل (لا يستوفي المتطلّبات اللازمة) / عاجز, غير كفء (غير مؤهل أو غير مناسب لغرض ما) / غير مؤهل, غير مختص قانونياً (غير مؤهل أو غير كافٍ قانونياً) / عَدِيم المَهَارَة, غَيْر كُفْء (لا يؤدي العمل بشكل جيد؛ يفتقر إلى الكفاءة)\nمثال: جهاز مخابرات غير كفء",
 "無脂肪": "خالٍ من الدسم, منزوع الدسم (بدون دهون أو مواد صلبة دهنية)\nمثال: حليب خالٍ من الدسم",
 "無脂肪乳": "حَلِيب خَالِي الدَسَم (هو اللَبَن المَحْلُوْب، أو ما لم يتغير طعمه. أصل التسمية؛ هو ما لم يَرُوْب واللَبَن هو ما رَابَ)\nمثال: كنت أشرب الحليب",
 "無脂肪牛乳": "حَلِيب خَالِي الدَسَم (هو اللَبَن المَحْلُوْب، أو ما لم يتغير طعمه. أصل التسمية؛ هو ما لم يَرُوْب واللَبَن هو ما رَابَ)\nمثال: كنت أشرب الحليب",
 "無脊椎動物": "لَا فَقَارِيّ (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: لا أحب المدرسة.",
 "無脚": "عَدِيمُ القَوَائِم ((عَنِ الأَفَاعِي وَالأَنْقَلَيْسِ) بِلَا أَقْدَامٍ بِطَبِيعَتِهِ)",
 "無脾症": "اِنْعِْدَام الطِحَال",
 "無脾症候群": "اِنْعِْدَام الطِحَال",
 "無腕症": "انعدام الذراعين (حالة عدم وجود أذرع)",
 "無腰": "أَعْزَل",
 "無自覚": "غَافِل, غَيْر مُدْرِك ((غالباً يتبعه 'بـ') غير مدرك)\nمثال: بدا غافلاً عن التدقيق",
 "無臭": "عديم الرائحة (ليس له رائحة)\nمثال: غاز عديم الرائحة",
 "無色": "بَاهِت, عَدِيم اللَّوْن (ضعيف في اللون؛ غير زاهي الألوان) / بَاهِت, مُمِلّ (يفتقر إلى التنوع والاهتمام)\nمثال: شخص باهت وغير خيالي / مُحَايِد / نُقْطَة الْعَطَالَة (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه)\nمثال: هذه هي نقطة ضعفه.",
 "無花果": "تين, تين شائع (شجرة متوسطية تُزرع على نطاق واسع لثمارها الصالحة للأكل) / تِين, بَلَس",
 "無花果果": "تِين, بَلَس",
 "無花果状果": "تِين, بَلَس",
 "無茶無茶": "بشكل رهيب, جداً (تستخدم للتوكيد) / بشكل سيء للغاية, بشكل فظيع (بطريقة فظيعة) / بشكل مروع, بفظاعة (من نوع مروع)\nمثال: مثير للاهتمام جداً",
 "無菌": "مُعَقَّم (جُعِلَ عَقِيمًا بِإِجْرَاء طِبِّيّ)",
 "無菌性": "خَالٍ مِنَ الجَرَاثِيم, مُعَقَّم (خالٍ من الكائنات الدقيقة المُمرضة أو يستخدم طرقًا لمنعها)",
 "無菌法": "تطهير, تعقيم (عملية تثبيط نمو وتكاثر الكائنات الحية الدقيقة) / تعقيم, خلو من الجراثيم ((للأشياء غير الحية) حالة الخلو من الكائنات الحية المسببة للأمراض)",
 "無蓋": "مَفْتُوح / فَتَحَ (ضد أغْلَقَ وسَدَّ؛ تركه بلا شيء يسده؛ الطريق: جعلها سالكة للطارقين) / فتح (ضد أغْلَقَ وسَدَّ؛ تركه بلا شيء يسده؛ الطريق: جعلها سالكة للطارقين) / حل (للعقدة: ضد عَقْدها؛ للجامد في السائل: إذابته) / اِنْفَتَحَ (فعل مطاوعة لفَتَحَ، فَتَحْتُهُ فانْفَتَح؛ يستخدم عوضا عن المبنى للمجهول فُتِحَ. )\nمثال: فتح الباب آليا.",
 "無血": "أَبْيَض كَالمَوْت, فَاقِد الدَّم (خالٍ من الدم أو يبدو كذلك) / بِلَا إِرَاقَة دِمَاء, غَيْر دَمَوِيّ (خالٍ من الدم أو سفك الدماء) / شَاحِب, مُمْتَقَع (شاحب اللون كأنّه فاقد الدم؛ ذو مظهر مريض) / جَامِد, خَالٍ مِنَ الإِحْسَاس (خالٍ من العاطفة الإنسانية أو الشعور)\nمثال: جراحة غير دموية",
 "無規律": "غَيْرُ مُنْضَبِط, فَاقِدُ الانْضِبَاط (يَفْتَقِرُ إِلَى الانْضِبَاطِ أَوِ السَّيْطَرَة) / غَيْرُ مُؤَدَّب, غَيْرُ مُصَحَّح (لم يخضع للتأديب أو التصحيح) / غَيْرُ مُنْضَبِط (لم يخضع للانضباط أو التأديب)",
 "無視": "بصرف النظر, بغض النظر (على الرغم من كل شيء؛ دون اعتبار للعوائق)\nمثال: واصل العمل بغض النظر عن الصعوبات",
 "無観客": "خلف الأبواب المغلقة (بَدَلَ، أَعْقَبَ؛ أَتَى بعده أو جاء مكانه)\nمثال: دار زيري للخلف.",
 "無角": "أَجْلَح",
 "無角類": "حَيَوَان عَنْكَبُوتِيّ (بمعنى أصبح له حياة؛ الحَيَاة. والحَيَوَان أبلغ من الحَيَاة؛ جنس الحَيّ الذي يأكل وينمو ويتحرك بالإرادة وبه حِسّ بخلاف ما به حياة فقط دون الحس مثل النَبَات. بعض العامة تقول حَيْوَان وهو غلط)\nمثال: هذا حيوان أليف.",
 "無言": "صَمْت, سُكُوت / صَمَّتَ / صَمْتًا!, صَهٍ!",
 "無言劇": "بانتوميم, تمثيل صامت (أداء يستخدم الإيماءات وحركات الجسم بدون كلمات) / إيمائي, ممثل صامت (ممثل يتواصل كلياً عن طريق الإيماءات وتعابير الوجه)",
 "無言症": "بكم, خرس (حالة عدم القدرة أو عدم الرغبة في التحدث)\nمثال: كان خرسه نتيجة لصممه",
 "無計画": "غَيْر مُتْقَن, مُرْتَجَل (يَتَّسِم بِالإِهْمَال الشَّدِيد وعَدَم الدِّقَّة) / جزافاً, خبط عشواء (بدون عناية؛ بطريقة مرتجلة وسريعة) / اِعْتِبَاطِيّ, عَشْوَائِيّ (يعتمد على الصدفة أو يتّسم بها)\nمثال: كان رئيس الوزراء يرتدي بدلة رمادية وقميصاً أبيض بياقة ناعمة، لكن رقبته أصبحت أنحف والياقة تبتعد عنها كما لو تم شراؤها عشوائياً",
 "無記名": "غير موقع (يفتقر إلى التوقيع)\nمثال: الرسالة كانت مطبوعة وغير موقعة",
 "無記名投票": "اقتراع سري (تصويت يكون فيه اختيار كل شخص سريًا ولكن إجمالي الأصوات علني)",
 "無記名株": "سهم لحامله (سهم لا يحتوي على معلومات الملكية ويفترض أن حامله المادي هو المالك)\nمثال: الأسهم لحاملها محظورة في بعض البلدان بسبب احتمال إساءة استخدامها",
 "無許可": "غَيْر مُخَوَّل, غَيْر مُصَرَّح بِه (غير ممنوح السلطة) / غَيْر مَأْذُون, غَيْر مُصَرَّح بِه (بدون تصريح أو إذن رسميّ)",
 "無認識": "غَيْر مَعْرُوف, غَيْر مُعتَرَف بِه (لم يُتعرَّف عليه أو يُقَرّ به) / غَيْر مُعْتَرَف بِه (لا يتمتّع بسمعة راسخة)",
 "無調": "لا نغمية (غياب السلم الموسيقي؛ بديل للنظام الدياتوني)",
 "無調整": "غَيْر مَضْبُوط, غَيْر مُعَدَّل (لم يتم تغييره ليتناسب مع متطلبات معينة) / غَيْر مُتَكَيِّف (لم يتأقلم مع الظروف الجديدة)\nمثال: رقم غير معدل بنسبة 8.5 في المائة",
 "無調法": "إهمال, تقصير (الفشل في التصرف بالحكمة التي يمارسها الشخص العاقل في نفس الظروف) / إهمال, لا مبالاة (صفة عدم الحذر أو عدم بذل الجهد) / خطأ فادح, زلة (خطأ محرج)",
 "無論": "طَبْعًا",
 "無謀": "مُتَهَوِّر",
 "無謬": "عِصْمَة",
 "無警察": "فَوْضَى, فَوْضَوِيَّة",
 "無責任": "اِنْعِدام مَسْؤُولِيَّة",
 "無賃": "مَجَّانِيّ, مَجَّانًا",
 "無資格": "غير مؤهل, غير مختص قانونياً (غير مؤهل أو غير كافٍ قانونياً) / بِلَا حَقّ, غَيْرُ مُسْتَحِقّ (لا يملك حقاً أو استحقاقاً) / غير مؤهل (غير مستوف للمعايير والمتطلبات والتدريب المناسب) / غير مشروط, مطلق (غير محدود أو مقيد)\nمثال: تعتبر الزوجة عادة غير مؤهلة للشهادة ضد زوجها",
 "無資格者": "عَاجِز, غَيْر مُؤَهَّل (لا يستوفي المتطلّبات اللازمة) / عاجز, غير كفء (غير مؤهل أو غير مناسب لغرض ما) / غير مؤهل, غير مختص قانونياً (غير مؤهل أو غير كافٍ قانونياً) / عَدِيم المَهَارَة, غَيْر كُفْء (لا يؤدي العمل بشكل جيد؛ يفتقر إلى الكفاءة)\nمثال: جهاز مخابرات غير كفء",
 "無趣味": "رَتِيب, مُمِلّ (مكرّر بشكل مملّ أو يفتقر إلى التنوّع) / رَتِيب, عَادِيّ (غير مُلهِم ولا يُشكِّل تحدياً؛ باهت وخالٍ من الإثارة) / رَتَابَة, مَلَل (صفة الثبات المرهق والروتين ونقص التنوع)\nمثال: لم يعتد أبداً على رتابة عمله / عديم الذوق, مبتذل (يفتقر إلى الذوق الجمالي أو الاجتماعي) / عديم النكهة, لا طعم له (يفتقر إلى النكهة)",
 "無足類": "ضفدع ثعباني (أي من البرمائيات الصغيرة النحيلة عديمة الأطراف الحفارة التي تشبه الديدان؛ تعيش في التربة الرطبة في المناطق الاستوائية) / ضفدعي ثعباني (من أو متعلق بـ أو ينتمي إلى فصيلة الضفادع الثعبانية)",
 "無軌道": "بِلَا مَسَالِك, وَعْر (يفتقر إلى الممرّات والطرق المعبَّدة) / بلا أثر, غير مطروق (ليس به آثار)\nمثال: حافلة ترولي بلا مسار (سكة) / مُتَهَوِّر",
 "無辜": "بَرِيء, بَرِيئَة / بَرِيء",
 "無農薬": "عُضْوِيّ",
 "無辺": "لَا مُتَنَاهٍ (كلّيّ وشامل لكلّ شيء) / فراغ, فضاء (المدى غير المحدود الذي يقع فيه كل شيء) / لَا يُحْصَى, لَا يُعَدّ (أَكْثَر مِنْ أَنْ يُحْصَى أَوْ يُعَدّ) / غير محدود, لانهائي (ليس له حدود أو قيود في الزمان أو المكان أو المدى أو الحجم)\nمثال: اختبروا قدرته على تحديد مواقع الأشياء في الفضاء",
 "無辺際": "لَا مُتَنَاهٍ (كلّيّ وشامل لكلّ شيء) / فراغ, فضاء (المدى غير المحدود الذي يقع فيه كل شيء) / لَا يُحْصَى, لَا يُعَدّ (أَكْثَر مِنْ أَنْ يُحْصَى أَوْ يُعَدّ) / غير محدود, لانهائي (ليس له حدود أو قيود في الزمان أو المكان أو المدى أو الحجم)\nمثال: اختبروا قدرته على تحديد مواقع الأشياء في الفضاء",
 "無造作": "سَهْل (ضد الصَعْب، اليَسِير. لا جمع له؛ الشيء المُمَهَّد اللَيِّن. لا جمع له)\nمثال: هذا الشعور سهل. / سَطْحِيّ, عَابِر (مُسْتَعْجِل وبِدُون اهْتِمَام بِالتَّفَاصِيل؛ غَيْر شَامِل) / عَابِث, لَامُبَالٍ (يَتَّسِمُ بِعَدَمِ الِاكْتِرَاثِ وَالِاسْتِهْتَارِ) / بِلَا جُهْد, يَسِير (لَا يُظْهِر جُهْدًا أَوْ إِجْهَادًا) / عَادِيّ, يَوْمِيّ (مُنَاسِبٌ لِلْمُنَاسَبَاتِ العَادِيَّةِ أَوِ الرُّوتِينِيَّةِ)",
 "無過失": "تنزه عن الخطأ, عصمة (صفة الإعفاء من الخطيئة أو عدم القدرة على ارتكابها) / خلو من العيب, عصمة (جودة كون الشيء بلا خطأ أو عيب)",
 "無道": "غَيْر إِنْسَانِيّ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "無遠慮": "فَظّ",
 "無邪気": "بَرِيء, بَرِيئَة / بَرِيء / بَرِيء, شَفَّاف (خالٍ من المكر والخداع) / غَافِل, لَامُبَالٍ (بلا اكتراث أو اهتمام بالآخرين) / أرعن, طائش (يظهر نقصًا في التفكير المتأني)\nمثال: تحول النقاش إلى مشاحنات طائشة",
 "無配慮": "غير مراعٍ, مستهتر (يفتقر إلى الاهتمام بحقوق أو مشاعر الآخرين) / غَيْرُ مُتَرَوٍّ, مُتَسَرِّع (بِدُونِ تَفْكِيرٍ أَوْ تَأَمُّلٍ كَافٍ)\nمثال: سلوك مستهتر بشكل صادم",
 "無酸素": "لَا هَوَائِيّ (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: لا أحب المدرسة.",
 "無酸素運動": "بناء العضلات, تمرين لاهوائي (تمرين يبني العضلات من خلال التوتر والمقاومة)",
 "無釉": "غير لامع, غير مصقول (ليس له طبقة لامعة) / غير مزجج (غير مزود بالزجاج)\nمثال: ورق غير مصقول",
 "無重力": "انعدام الوزن, خفة (خاصية كون الشيء صغير الوزن نسبياً)\nمثال: خفة خشب البالسا",
 "無重力状態": "انعدام الوزن, خفة (خاصية كون الشيء صغير الوزن نسبياً)\nمثال: خفة خشب البالسا",
 "無重量": "انعدام الوزن, خفة (خاصية كون الشيء صغير الوزن نسبياً)\nمثال: خفة خشب البالسا",
 "無量": "لَا يُقَاسُ (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: لا أحب المدرسة.",
 "無鉛": "خالٍ من الرصاص (غير معالج بالرصاص) / غَيْر مُرَصَّص (لا يحتوي على شرائح رصاص بين السطور)\nمثال: بنزين خالٍ من الرصاص",
 "無銘": "غير موقع (يفتقر إلى التوقيع)\nمثال: الرسالة كانت مطبوعة وغير موقعة",
 "無間": "استمرارية, تواصل (صفة الشيء الذي يستمر بلا نهاية أو انقطاع)",
 "無関係": "لا تربطه قرابة, ليس قريباً (غير متصل بقرابة) / غير ذي صلة, غير مرتبط (يفتقر لعلاقة منطقية أو سببية)",
 "無関心": "لَا مُبَالٍ (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: لا أحب المدرسة.",
 "無防備": "أَعْزَل",
 "無降水": "جَفَاف",
 "無限": "أبدية, خلود (زمن بلا نهاية) / لَا مُتَنَاهٍ (كلّيّ وشامل لكلّ شيء) / فراغ, فضاء (المدى غير المحدود الذي يقع فيه كل شيء) / لَا يُحْصَى, لَا يُعَدّ (أَكْثَر مِنْ أَنْ يُحْصَى أَوْ يُعَدّ) / غير محدود, لانهائي (ليس له حدود أو قيود في الزمان أو المكان أو المدى أو الحجم)\nمثال: اختبروا قدرته على تحديد مواقع الأشياء في الفضاء",
 "無限ループ": "حلقة مغلقة, نظام الحلقة المغلقة (نظام تحكم ذو حلقة تغذية مرتدة نشطة)",
 "無限大": "أبدية, خلود (زمن بلا نهاية)",
 "無限定": "شَامِل, وَاسِعُ النِّطَاق (واسع في نطاقه أو محتواه؛ يغطّي مجالات عديدة)",
 "無限小": "مُتَنَاهٍ فِي الصِّغَر (صغير بشكل لا نهائي أو لا يُقاس) / متناهي الصغر ((رياضيات) متغير حده هو الصفر)",
 "無限数列": "متتالية لا نهائية (تتابع غير محدود لعناصر مرتبة بترتيب معين)",
 "無限軌道": "جنزير, مسار كاتربيلر (حزام معدني لا نهائي تتحرك عليه المركبات المجنزرة فوق الأرض)",
 "無限連鎖講": "مخطط هرمي (مخطط احتيالي يتم فيه تجنيد أشخاص لدفع مدفوعات للشخص الذي جندهم بينما يتوقعون تلقي مدفوعات من الأشخاص الذين يقومون بتجنيدهم؛ عندما يفشل عدد المجندين…)",
 "無雑": "صَافٍ, اَلصَّافِي",
 "無難": "أَمِين, سَالِم (من يتولى رقابة شيء أو المحافظة عليه؛ مُطْمَئِنّ) / خَزْنَة حَدِيدِيَّة, خَزْنَة\nمثال: هو غبي وغير أمين. / مَقْبُول, مُرْضٍ (جدير بالقبول أو مرضٍ) / مَقْبُول, وَافٍ بِالغَرَض (كَافٍ لِتَحْقِيقِ الغَرَضِ المَطْلُوبِ) / لَائِق, مَقْبُول (يفي بالمتطلبات والمعايير المطلوبة) / مَقْبُول, مُسْتَسَاغ (يُحكَم عليه بأنه متوافق مع الاستخدام اللغوي المعتمد)\nمثال: مستويات مقبولة من الإشعاع",
 "無電": "لَاسِلْكِيّ",
 "無音": "صَمْت, سُكُوت / صَمَّتَ / صَمْتًا!, صَهٍ!",
 "無韻詩": "شعر مرسل (شعر غير مقفى (عادة في البحر الخماسي اليامبي))",
 "無響室": "غرفة عديمة الصدى (غرفة ذات صدى ضئيل جداً)",
 "無頓着": "غَيْرُ آبِهٍ, لَامُبَالٍ (لَا يُظْهِرُ أَيَّ اهْتِمَامٍ أَوْ عِنَايَةٍ فِي مَوْقِفِهِ أَوْ تَصَرُّفِهِ) / سِيَّان, لَا يَهُمّ ((غالبًا متبوع بـ 'لـ') لا أهمّيّة له؛ لا فرق بين خياراته) / فَاتِر, لَامُبَالٍ (يتّسم بانعدام الاهتمام) / وَسَطِيّ (لَيْسَ مُفْرِطًا وَلَا قَلِيلًا جِدًّا)",
 "無頼": "شِرِّير (الكَثير الشَرّ بمعنى اسم جامع للرذائل، قد يستعمل كاسم فاعل؛ ضد الخَيِّر؛ يستخدم أيضا بمعنى ذو الشَرّ وما تسبب بالشرّ)\nمثال: لقد وصف سامي ليلى كشخص شرير إلى حد يكاد لا يصدق. / مُسْتَقِل, حُرّ (اسم فاعل مِن اِسْتَقَلَّ؛ من لا يعتمد على غيره)\nمثال: الجزائر مستقلة الآن.",
 "無頼漢": "بلطجي, فتوة (رجل قاسٍ ووحشي)",
 "無顆粒球症": "ندرة المحببات (اضطراب دموي حاد يتميز بانخفاض حاد في الخلايا المحببة)",
 "無題": "بِلَا لَقَب, غَيْر نَبِيل (لا ينتمي إلى طبقة النبلاء)",
 "無額面株": "أسهم بدون قيمة اسمية (أسهم ليس لها قيمة اسمية محددة في ميثاق الشركة أو على شهادة الأسهم)",
 "無額面株式": "أسهم بدون قيمة اسمية (أسهم ليس لها قيمة اسمية محددة في ميثاق الشركة أو على شهادة الأسهم)",
 "無顎類": "لا فكيات (فقاري يشبه الثعبان بدون فكوك أو زوائد مزدوجة بما في ذلك دائريات الفم وبعض الأشكال المنقرضة)",
 "無類": "لَا مَثِيلَ لَهُ, لَا نَظِيرَ لَهُ (بارز يفوق أيّ مقارنة؛ فريد لا يُضاهى)",
 "無風": "بِلَا رِيَاح, سَاكِن الرِّيح (بِدُون رِيَاح أَوْ بِرِيَاحٍ شِبْه مَعْدُومَة) / صَامِت, هَادِئ",
 "無風流": "خشن, غير مهذب ((للأشخاص وسلوكهم) غير مهذب؛ فظ) / خام, غير مكرر (غير مكرر أو معالج)\nمثال: كيف يمكن لفتاة مهذبة أن تنجذب لرجل خشن كهذا؟",
 "無食": "تعذر البلع, لا بلع (فقدان القدرة على البلع)",
 "無食欲": "قَهَم",
 "無香料": "غَيْرُ مُنَكَّه (بِدُونِ إِضَافَةِ مُنَكِّهَات)",
 "無駄にする": "إسراف, تبديد (نشاط غير مجدٍ أو غير مربح؛ استخدام أو إنفاق أو استهلاك بلا تفكير أو بإهمال) / قَفْر, مَهْجُور (في منطقة نائية وموحشة؛ خَرِبة) / إضرار بالمال, تبديد الممتلكات ((قانون) انخفاض في قيمة العقار ناتج عن فعل أو إهمال) / إتلاف, إهدار (سمة إهدار الموارد)\nمثال: إذا لم يحقق الجهد أي مكسب تعويضي فهو هدر",
 "無駄のない": "اقْتِصَادِيّ, مُوَفِّر (يستخدم الحدّ الأدنى من الوقت أو الموارد اللازمة للفاعلية) / زَاهِد, مُقْتَصِد (يَتَجَنَّبُ الإِسْرَافَ وَالهَدْر) / اقتصادي (مكون من أو متعلق بالاقتصاد، نظام الإنتاج وإدارة الثروة المادية)\nمثال: نمو اقتصادي",
 "無駄の無い": "اقْتِصَادِيّ, مُوَفِّر (يستخدم الحدّ الأدنى من الوقت أو الموارد اللازمة للفاعلية) / زَاهِد, مُقْتَصِد (يَتَجَنَّبُ الإِسْرَافَ وَالهَدْر) / اقتصادي (مكون من أو متعلق بالاقتصاد، نظام الإنتاج وإدارة الثروة المادية)\nمثال: نمو اقتصادي",
 "無駄口": "هَذَى",
 "無駄言": "هَذَى",
 "無駄話": "ثرثرة, كلام تافه (حديث عاطل أو أحمق وغير ذي صلة)",
 "無駄遣い": "إسراف, تبديد (نشاط غير مجدٍ أو غير مربح؛ استخدام أو إنفاق أو استهلاك بلا تفكير أو بإهمال) / قَفْر, مَهْجُور (في منطقة نائية وموحشة؛ خَرِبة) / إضرار بالمال, تبديد الممتلكات ((قانون) انخفاض في قيمة العقار ناتج عن فعل أو إهمال) / إتلاف, إهدار (سمة إهدار الموارد)\nمثال: إذا لم يحقق الجهد أي مكسب تعويضي فهو هدر",
 "無駄飯喰い": "شخص عديم الفائدة, عاطل (شخص خامل لا قيمة له)",
 "無駄飯喰らい": "عَدِيمُ الجَدْوَى, لَا خَيْرَ فِيه (بِلَا اسْتِحْقَاق؛ ذُو قِيمَةٍ أَوْ فَائِدَةٍ ضَئِيلَةٍ أَوْ مُنْعَدِمَة) / شخص عديم الفائدة, عاطل (شخص خامل لا قيمة له)",
 "無駄飯食い": "شخص عديم الفائدة, عاطل (شخص خامل لا قيمة له)",
 "無駄飯食らい": "عَدِيمُ الجَدْوَى, لَا خَيْرَ فِيه (بِلَا اسْتِحْقَاق؛ ذُو قِيمَةٍ أَوْ فَائِدَةٍ ضَئِيلَةٍ أَوْ مُنْعَدِمَة) / شخص عديم الفائدة, عاطل (شخص خامل لا قيمة له)",
 "無骨": "غَلِيظٌ, فَظٌّ (سيئ السلوك وخشن ومحتقر في التصرف أو المظهر)",
 "無骨一徹": "رَيْفِيّ, قَرَوِيّ",
 "無骨者": "عديم التربية, فظ (شخص فظ غير مهذب يفتقر للثقافة أو الرقي)",
 "無髯": "أَمْرَد",
 "焦がす": "حَرْق (الفعل له عدة معانٍ تتعلق بالتأثير والتلف، منها: برد الحديد، حكّ الأنياب، إتلاف الثوب بالدق، وحرق الشيء بالنار؛ إتلاف شيء ما بالنار أو بأداة حادة، كما يشمل المعنى المجازي للألم الشديد والحزن الذي يُؤثر في القلب) / سَفْعَة / حُرق (الفعل له عدة معانٍ تتعلق بالتأثير والتلف، منها: برد الحديد، حكّ الأنياب، إتلاف الثوب بالدق، وحرق الشيء بالنار؛ إتلاف شيء ما بالنار أو بأداة حادة، كما يشمل المعنى المجازي للألم الشديد والحزن الذي يُؤثر في القلب) / أَحْرَقَ (أحرقت النار الشيءَ: حرقته؛ أحرقَ الشيءَ: أهلكه) / حَرَقَ (الفعل له عدة معانٍ تتعلق بالتأثير والتلف، منها: برد الحديد، حكّ الأنياب، إتلاف الثوب بالدق، وحرق الشيء بالنار؛ إتلاف شيء ما بالنار أو بأداة حادة، كما يشمل المعنى المجازي للألم الشديد والحزن الذي يُؤثر في القلب) / ضَرِمَ / حرق (الفعل له عدة معانٍ تتعلق بالتأثير والتلف، منها: برد الحديد، حكّ الأنياب، إتلاف الثوب بالدق، وحرق الشيء بالنار؛ إتلاف شيء ما بالنار أو بأداة حادة، كما يشمل المعنى المجازي للألم الشديد والحزن الذي يُؤثر في القلب) / وَلَّع\nمثال: قامت ليلى بحرق كل كتب آرت المتعلقة بالأدب العنصري.",
 "焦がれる": "طَوِيل",
 "焦げ": "بشكل حارق, بلهيب (قادر على إحداث حروق (تستخدم عادة لوصف شدة الحرارة)) / حَارِق, لَافِح (شديد الحرارة والجفاف بما يكفي لحرق السطح أو تجفيفه)\nمثال: كان الجو حاراً بشكل حارق",
 "焦げる": "حَرْق (الفعل له عدة معانٍ تتعلق بالتأثير والتلف، منها: برد الحديد، حكّ الأنياب، إتلاف الثوب بالدق، وحرق الشيء بالنار؛ إتلاف شيء ما بالنار أو بأداة حادة، كما يشمل المعنى المجازي للألم الشديد والحزن الذي يُؤثر في القلب) / سَفْعَة / حُرق (الفعل له عدة معانٍ تتعلق بالتأثير والتلف، منها: برد الحديد، حكّ الأنياب، إتلاف الثوب بالدق، وحرق الشيء بالنار؛ إتلاف شيء ما بالنار أو بأداة حادة، كما يشمل المعنى المجازي للألم الشديد والحزن الذي يُؤثر في القلب) / أَحْرَقَ (أحرقت النار الشيءَ: حرقته؛ أحرقَ الشيءَ: أهلكه) / حَرَقَ (الفعل له عدة معانٍ تتعلق بالتأثير والتلف، منها: برد الحديد، حكّ الأنياب، إتلاف الثوب بالدق، وحرق الشيء بالنار؛ إتلاف شيء ما بالنار أو بأداة حادة، كما يشمل المعنى المجازي للألم الشديد والحزن الذي يُؤثر في القلب) / ضَرِمَ / حرق (الفعل له عدة معانٍ تتعلق بالتأثير والتلف، منها: برد الحديد، حكّ الأنياب، إتلاف الثوب بالدق، وحرق الشيء بالنار؛ إتلاف شيء ما بالنار أو بأداة حادة، كما يشمل المعنى المجازي للألم الشديد والحزن الذي يُؤثر في القلب) / وَلَّع\nمثال: قامت ليلى بحرق كل كتب آرت المتعلقة بالأدب العنصري.",
 "焦げ付き": "ديون معدومة, ديون هالكة (دين من غير المرجح سداده)",
 "焦げ目": "أثر حرق, حرق (مكان أو منطقة تم حرقها (خاصة على جسم الشخص))",
 "焦げ茶": "بني زيتوني (درجة من البني مشوبة بالأخضر)",
 "焦げ茶色": "بني زيتوني (درجة من البني مشوبة بالأخضر)\nمثال: 彼はこげ茶色の髪をしていた。 — كانَ لديه شعرٌ بُنِّيٌّ غامق.",
 "焦げ跡": "أثر حرق, حرق (مكان أو منطقة تم حرقها (خاصة على جسم الشخص))",
 "焦らす": "إغاظة, تهكم (فعل مضايقة شخص ما بمرح أو بخبث (خاصة عن طريق السخرية)؛ استفزاز شخص ما بمضايقات مستمرة) / غانية, لعوب (امرأة مغرية تستخدم جاذبيتها لاستغلال الرجال) / مستفز, مشاكس (شخص يميل إلى المشاكسة (عن طريق السخرية أو إثارة الفضول))\nمثال: تجاهل تهكمهم",
 "焦り": "نَفَاد صَبْر",
 "焦る": "دستان, عتبة (قضيب صغير من المعدن عبر لوحة أصابع الآلة الموسيقية؛ لإنتاج نغمة ذات حدة مطلوبة عند الضغط على الوتر) / تعشيق هندسي, مفتاح إغريقي (نمط زخرفي يتكون من خطوط عمودية وأفقية متكررة (غالباً بشكل بارز)) / موضع تآكل (بقعة تآكلت بفعل الاحتكاك أو التعرية) / غمة, قلق (هياج ناتج عن قلق نشط)\nمثال: كان هناك تعشيق هندسي بسيط في أعلى الجدران / ذُعْر, رُعْب ((ذَعَرَه) ذعرا: خَوّفه وأفزعه)\nمثال: أصيب سامي بالذعر.",
 "焦れったい": "مُزْعِج, مُضَايِق (يسبب الانزعاج أو الضيق) / مُؤْلِم, مُهَيِّج (يسبب عدم الراحة الجسدية) / تَنْبِيهِيّ, مُهَيِّج ((للمحفزات الجسدية) يعمل على التحفيز أو الإثارة)",
 "焦れる": "دستان, عتبة (قضيب صغير من المعدن عبر لوحة أصابع الآلة الموسيقية؛ لإنتاج نغمة ذات حدة مطلوبة عند الضغط على الوتر) / تعشيق هندسي, مفتاح إغريقي (نمط زخرفي يتكون من خطوط عمودية وأفقية متكررة (غالباً بشكل بارز)) / موضع تآكل (بقعة تآكلت بفعل الاحتكاك أو التعرية) / غمة, قلق (هياج ناتج عن قلق نشط)\nمثال: كان هناك تعشيق هندسي بسيط في أعلى الجدران",
 "焦土": "سِيَاسَةُ الأَرْضِ المَحْرُوقَة (بمعنى رعى الغنم وقادها؛ بمعنى قاد الناس وحَكَمَهم باللين والحكمة لا بالغصب والقهر)\nمثال: عاد إلى السياسة.",
 "焦心": "نَفَاد صَبْر",
 "焦心苦慮": "تَمَلْمَلَ",
 "焦慮": "نَفَاد صَبْر",
 "焦点": "بُؤْرَة",
 "焦点をあてる": "بُؤْرَة",
 "焦点を合わせる": "بُؤْرَة",
 "焦点を当てる": "بُؤْرَة",
 "焦点を絞る": "رَكَّزَ (وضع الشيء بثبات في مكانه؛ أثبت الشيء أو ثبّتَه، وخاصة في مكان محدد) / رَكَّزَ, تَرَكَّزَ (وضع الشيء بثبات في مكانه؛ أثبت الشيء أو ثبّتَه، وخاصة في مكان محدد) / مركز (موضع الاِرْتِكَاز عامة؛ موضع الشخص ومحلّه الذي يبقى فيه عادة)\nمثال: فقط ركز يا زيري.",
 "焦点距離": "بُعْد بُؤْرِيّ, مَسَافَة بُؤْرِيَّة (المسافة من العدسة إلى بؤرتها)",
 "焦熱地獄": "جَحِيم, جَهَنَّم / جَحِيم, سَعِير",
 "焦燥": "نَفَاد صَبْر",
 "焦燥感": "حدة المزاج, سرعة الغضب (الميل لإظهار غضب غير منضبط) / تهيج, قابلية للاستثارة (حساسية مفرطة لعضو أو جزء من الجسم) / تهيج, سرعة الغضب (شعور بالتهيج والنزق)\nمثال: كانت حدة مزاجه معروفة لجميع موظفيه",
 "焦眉": "طَوَارِئ, حَالَةْ اَلطَّوَارِئ",
 "焦茶": "بني زيتوني (درجة من البني مشوبة بالأخضر)",
 "焦電気": "كهرباء حرارية (توليد شحنة كهربائية على بلورات معينة (مثل التورمالين) نتيجة لتغير في درجة الحرارة)",
 "焮衝": "اِلْتِهَاب",
 "然": "كَـ / فَـ, لِذَا (الحرف العشرون في حروف الهجاء العربية؛ يفيد الترتيب والتعقيب) / إِذًا, فَ / هَٰكَذَا, كَذَا / بل, نعم (ليس ذلك فحسب، بل)\nمثال: أنا بذلك أفرح، بل وسأفرح",
 "然あらぬ": "سَطْحِيّ, عَابِر (مُسْتَعْجِل وبِدُون اهْتِمَام بِالتَّفَاصِيل؛ غَيْر شَامِل) / عَابِث, لَامُبَالٍ (يَتَّسِمُ بِعَدَمِ الِاكْتِرَاثِ وَالِاسْتِهْتَارِ) / بِلَا جُهْد, يَسِير (لَا يُظْهِر جُهْدًا أَوْ إِجْهَادًا) / عَادِيّ, يَوْمِيّ (مُنَاسِبٌ لِلْمُنَاسَبَاتِ العَادِيَّةِ أَوِ الرُّوتِينِيَّةِ)",
 "然こそ": "بِالتَّأْكِيد",
 "然したる": "خاص (قلَّ أو أصبح أقل؛ خَاصَ العَطَاءَ خَاصَ خَوْصًا: قلَّله)\nمثال: كل الخضار الخاص بك.",
 "然して": "بشكل خاص, تحديداً (بدرجة أكبر بوضوح مما هو شائع) / بِتَمَيُّز, بِشَكْل خَاصّ (بشكل فريد أو مميز) / تَحْدِيدًا, عَلَى وَجْه الخُصُوص (مميز بشكل خاص عن الآخرين)\nمثال: كان دقيقاً بشكل خاص حول التهجئة",
 "然しも": "إلى هذا الحد, بقدر ما (إلى الدرجة أو المدى الذي)\nمثال: بقدر ما يمكن التأكد، رئة الحصان قابلة للمقارنة برئة الإنسان",
 "然せる": "خاص (قلَّ أو أصبح أقل؛ خَاصَ العَطَاءَ خَاصَ خَوْصًا: قلَّله)\nمثال: كل الخضار الخاص بك.",
 "然のみ": "كَثِير (ما كان عدده كبيرا؛ متبوعًا بمِنْ: عدد كبير أو كمية كبيرة من الشيء) / كَثِيرًا\nمثال: هذا أسهل بكثير.",
 "然のみならず": "أَيْضًا, كَذٰلِكَ",
 "然も": "حَقًّا (حَقَا (حقاه) حقوا: أصاب حقوه، يقال ضربه فحقاه؛ (حَقَا)الشيء فلانا: بلغ حقوه، يقال نزل في الماء حتى حقاه فهو محقو ومحقي) / وَٱللّٰه؟ / لَيْسَ مَعْقُل!\nمثال: هو اغضبني حقا .",
 "然もあらばあれ": "عَلَى أَيِّ حَالٍ (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال.",
 "然もないと": "خِلَافَ, خِلَافَ ذَلِك / وَإِلَّا / عَكْس ذٰلِك",
 "然もなくば": "خِلَافَ, خِلَافَ ذَلِك / وَإِلَّا / عَكْس ذٰلِك",
 "然もなければ": "خِلَافَ, خِلَافَ ذَلِك / وَإِلَّا / عَكْس ذٰلِك\nمثال: 急ぎなさい、さもなければ遅れますよ。 — أسرع، وإلا فإنك ستتأخر.",
 "然も無いと": "خِلَافَ, خِلَافَ ذَلِك / وَإِلَّا / عَكْس ذٰلِك",
 "然も無くば": "خِلَافَ, خِلَافَ ذَلِك / وَإِلَّا / عَكْس ذٰلِك",
 "然も無ければ": "خِلَافَ, خِلَافَ ذَلِك / وَإِلَّا / عَكْس ذٰلِك\nمثال: 急ぎなさい、さもなければ遅れますよ。 — أسرع، وإلا فإنك ستتأخر.",
 "然らば": "آنَذَاكَ, حِينَئِذٍ / ثُمَّ (يفيد الترتيب والتراخي) / إِذًا, إِذَنْ\nمثال: ثم هناك مشكلة؛",
 "然り": "بَلَى, مبلا (يفيد إبطال النفي؛ في : نَعَمْ في كل حالاتها عدا جواب النِدَاء في بعض لهجات الشام، في بعض اللهجات الشامية الأخرى يقال مبَلَى…) / نَعَم, نَعَمَانِ (الإبِل والبَقَر والغَنَم. وتسمى نَعَم فقط إذا كان فيها إبل، فالإبل لوحدها نَعَم…)\nمثال: هذه ليست جملة, بل مجموعة من الكلمات بلى معنى.",
 "然りげ": "هَٰكَذَا, كَذَا",
 "然りげに": "بِعَفَوِيَّة, بِلَا مُبَالَاة (بطريقة غير مبالية) / بِبُرُود, بِرَبَاطَة جَأْش (بطريقة هادئة وغير مبالية)\nمثال: ألقى نظرة غير مبالية على العناوين",
 "然りながら": "لٰكِن, لٰكِنَّ (يفيد الاستدراك ويسبقه نفي أو نهي ويليه اسم مفرد؛ يفيد الاستدراك)\nمثال: لكن لديك أطفال.",
 "然り乍ら": "لٰكِن, لٰكِنَّ (يفيد الاستدراك ويسبقه نفي أو نهي ويليه اسم مفرد؛ يفيد الاستدراك)\nمثال: لكن لديك أطفال.",
 "然り気": "هَٰكَذَا, كَذَا",
 "然る": "خاص (قلَّ أو أصبح أقل؛ خَاصَ العَطَاءَ خَاصَ خَوْصًا: قلَّله)\nمثال: كل الخضار الخاص بك.",
 "然るに": "بِأَيَّةِ طَرِيقَة, عَلَى كُلِّ حَال",
 "然るべき": "سَلِيم, صَحِيح (ملائم لحالة أو غرض أو مناسبة أو لطبيعة الشخص واحتياجاته) / صحيح, لائق (يتميز بالملائمة أو الصواب أو المناسبة)\nمثال: علاج طبي مناسب",
 "然るべく": "بشكل لائق, بشكل مناسب (بما يتوافق مع ما هو مناسب أو ملائم للظروف)\nمثال: كان يرتدي ملابس مناسبة",
 "然るを": "رغم ذلك, لكن (على الرغم من أي شيء مخالف (تسبق عادة التنازل))\nمثال: على الرغم من أنني خائف قليلاً، إلا أنني أود تجربتها مع ذلك",
 "然る可き": "سَلِيم, صَحِيح (ملائم لحالة أو غرض أو مناسبة أو لطبيعة الشخص واحتياجاته) / صحيح, لائق (يتميز بالملائمة أو الصواب أو المناسبة)\nمثال: علاج طبي مناسب",
 "然る可く": "بشكل لائق, بشكل مناسب (بما يتوافق مع ما هو مناسب أو ملائم للظروف)\nمثال: كان يرتدي ملابس مناسبة",
 "然る後": "بعد ذلك, منذ ذلك الحين (من ذلك الوقت فصاعداً)\nمثال: بعد ذلك لم يتصل أبداً مرة أخرى",
 "然る者": "أَحَد (العدد وَاحِد؛ الوَاحِد من الشيء)\nمثال: لم يساعدني أحد.",
 "然れども": "لٰكِن, لٰكِنَّ (يفيد الاستدراك ويسبقه نفي أو نهي ويليه اسم مفرد؛ يفيد الاستدراك)\nمثال: لكن لديك أطفال.",
 "然れば": "إِذَنْ, لِذٰلِكَ (و جزاء ينصب الفعل المضارع إذا كان متصدرا غير مفصول عنه)\nمثال: تحتاج لإذن خطي. / بالفعل, حقاً ((تستخدم كصيغة تعجب) تعبير عن الدهشة أو الشك أو السخرية وما إلى ذلك) / بالفعل, جداً (في الحقيقة (غالباً ما تميل إلى التوكيد))\nمثال: يريد الزواج من رئيس الخدم؟ حقاً! / إِذَنْ, لِذٰلِكَ (و جزاء ينصب الفعل المضارع إذا كان متصدرا غير مفصول عنه)\nمثال: تحتاج لإذن خطي. / بِالْمُنَاسَبَةِ, عَلَى فِكْرَةٍ",
 "然ればこそ": "بالتأكيد, حتماً (بشكل قاطع أو إيجابي) / كما كان متوقعاً, وفعلاً (كما هو مفترض أو متوقع)\nمثال: النتائج مشجعة بالتأكيد",
 "然有らぬ": "سَطْحِيّ, عَابِر (مُسْتَعْجِل وبِدُون اهْتِمَام بِالتَّفَاصِيل؛ غَيْر شَامِل) / عَابِث, لَامُبَالٍ (يَتَّسِمُ بِعَدَمِ الِاكْتِرَاثِ وَالِاسْتِهْتَارِ) / بِلَا جُهْد, يَسِير (لَا يُظْهِر جُهْدًا أَوْ إِجْهَادًا) / عَادِيّ, يَوْمِيّ (مُنَاسِبٌ لِلْمُنَاسَبَاتِ العَادِيَّةِ أَوِ الرُّوتِينِيَّةِ)",
 "然様": "فَـ, لِذَا (الحرف العشرون في حروف الهجاء العربية؛ يفيد الترتيب والتعقيب) / إِذًا, فَ / بالفعل, حقاً ((تستخدم كصيغة تعجب) تعبير عن الدهشة أو الشك أو السخرية وما إلى ذلك) / بالفعل, جداً (في الحقيقة (غالباً ما تميل إلى التوكيد))\nمثال: يريد الزواج من رئيس الخدم؟ حقاً!",
 "然程": "فَـ, لِذَا (الحرف العشرون في حروف الهجاء العربية؛ يفيد الترتيب والتعقيب) / إِذًا, فَ",
 "然諾": "رَضِيَ, وَافَقَ (قَبِلَ؛ سلَّم واقتنع) / رِضًا (مصدر الفعل \"رَضِيَ\")\nمثال: السكوت علامة الرضا.",
 "焼": "تحميص, شوي (طهي (اللحم) بحرارة جافة في فرن (عادة مع إضافة دهن))\nمثال: استغرق التحميص البطيء عدة ساعات / تطبيع, تلدين (تقسية شيء ما بالمعالجة الحرارية) / مُعَدِّل, مُهَدِّئ (يُلَطّف ويجعل الأمر أكثر اعتدالًا) / خَزَف (خَزَفَ في مَشْيه يَخْزِفُ خَزْفًا: رفع يدَه ووَضعها؛ خَزَفَ الثوبَ: خَرَقه وشقَّه)",
 "焼い弾": "قنبلة حارقة (قنبلة مصممة لإشعال الحرائق؛ وهي أكثر فعالية ضد الأهداف القابلة للاشتعال (مثل الوقود))",
 "焼き": "تحميص, شوي (طهي (اللحم) بحرارة جافة في فرن (عادة مع إضافة دهن))\nمثال: استغرق التحميص البطيء عدة ساعات / تطبيع, تلدين (تقسية شيء ما بالمعالجة الحرارية) / مُعَدِّل, مُهَدِّئ (يُلَطّف ويجعل الأمر أكثر اعتدالًا)",
 "焼きあげる": "حَرْق (الفعل له عدة معانٍ تتعلق بالتأثير والتلف، منها: برد الحديد، حكّ الأنياب، إتلاف الثوب بالدق، وحرق الشيء بالنار؛ إتلاف شيء ما بالنار أو بأداة حادة، كما يشمل المعنى المجازي للألم الشديد والحزن الذي يُؤثر في القلب) / سَفْعَة / حُرق (الفعل له عدة معانٍ تتعلق بالتأثير والتلف، منها: برد الحديد، حكّ الأنياب، إتلاف الثوب بالدق، وحرق الشيء بالنار؛ إتلاف شيء ما بالنار أو بأداة حادة، كما يشمل المعنى المجازي للألم الشديد والحزن الذي يُؤثر في القلب) / أَحْرَقَ (أحرقت النار الشيءَ: حرقته؛ أحرقَ الشيءَ: أهلكه) / حَرَقَ (الفعل له عدة معانٍ تتعلق بالتأثير والتلف، منها: برد الحديد، حكّ الأنياب، إتلاف الثوب بالدق، وحرق الشيء بالنار؛ إتلاف شيء ما بالنار أو بأداة حادة، كما يشمل المعنى المجازي للألم الشديد والحزن الذي يُؤثر في القلب) / ضَرِمَ / حرق (الفعل له عدة معانٍ تتعلق بالتأثير والتلف، منها: برد الحديد، حكّ الأنياب، إتلاف الثوب بالدق، وحرق الشيء بالنار؛ إتلاف شيء ما بالنار أو بأداة حادة، كما يشمل المعنى المجازي للألم الشديد والحزن الذي يُؤثر في القلب) / وَلَّع\nمثال: قامت ليلى بحرق كل كتب آرت المتعلقة بالأدب العنصري.",
 "焼きごて": "مِكْوَاةُ اللَّحَّام, كاوِيَةُ اللَّحَّام / عَلَامَة, شِعَار (سِمَةٌ أو أمارة أو شِعَار تُعرف به الأشياء؛ رَمْز) / مَارْكَة\nمثال: تحصلت على علامة أ.",
 "焼きすぎる": "طباعة فوقية (شيء مضاف عن طريق الطباعة الفوقية)",
 "焼きつき": "إمساك, قبض (فعل الإمساك بشيء بإحكام باليدين) / خيط التحزيم (حبال صغيرة تستخدم لربط حبلين أو أكثر معاً)",
 "焼きつける": "خَبَزَ (هو طعام يصنع من الدَقِيق الذي يعجن بالماء والخَمِيرَة ويُخْبَز في الفُرْن أو التَنُّور؛ خُبْز الغُراب: الفِطْر، ويسمى أيضا عُشّ الغُرَاب) / خَبز (هو طعام يصنع من الدَقِيق الذي يعجن بالماء والخَمِيرَة ويُخْبَز في الفُرْن أو التَنُّور؛ خُبْز الغُراب: الفِطْر، ويسمى أيضا عُشّ الغُرَاب)\nمثال: هذا الخبز لذيذ. / تجنيد إجباري, سخرة (فعل إجبار شخص ما على الخدمة الحكومية) / طَبَعَ (طَبَعَ الله الخلقَ : أَنشأَهُ؛ طبَعَت الدَّوْلةُ النَّقْد : صاغتْه ونقشته)\nمثال: بالطبع هي مزحة! / عَلَامَة, شِعَار (سِمَةٌ أو أمارة أو شِعَار تُعرف به الأشياء؛ رَمْز) / مَارْكَة\nمثال: تحصلت على علامة أ.",
 "焼きなおす": "اجترار, تكرار (مادة قديمة تم إعادة صياغتها قليلاً واستخدامها مرة أخرى)\nمثال: مجرد اجترار ممل لروايته الأولى",
 "焼きなまし": "تطبيع, تلدين (تقسية شيء ما بالمعالجة الحرارية)",
 "焼きもち": "حَسَد, غَبْط (تمنيّ زوال نعمة الغير)\nمثال: الكره لا يظهر بكل بساطة من فراغ. إنه بالعادة يبدأ من الحسد أو الخوف.",
 "焼きを入れる": "حدة المزاج, سرعة الغضب (الميل لإظهار غضب غير منضبط) / صلابة, متانة (مرونة وصلابة جسم معدني؛ قدرته على امتصاص طاقة كبيرة قبل التشقق) / فورة غضب, هيجان (نوبة مفاجئة من الغضب) / مزاج (حالة شعورية مميزة (عادة أو مؤقتة نسبياً))\nمثال: كانت حدة مزاجه معروفة لجميع موظفيه",
 "焼き上げる": "حَرْق (الفعل له عدة معانٍ تتعلق بالتأثير والتلف، منها: برد الحديد، حكّ الأنياب، إتلاف الثوب بالدق، وحرق الشيء بالنار؛ إتلاف شيء ما بالنار أو بأداة حادة، كما يشمل المعنى المجازي للألم الشديد والحزن الذي يُؤثر في القلب) / سَفْعَة / حُرق (الفعل له عدة معانٍ تتعلق بالتأثير والتلف، منها: برد الحديد، حكّ الأنياب، إتلاف الثوب بالدق، وحرق الشيء بالنار؛ إتلاف شيء ما بالنار أو بأداة حادة، كما يشمل المعنى المجازي للألم الشديد والحزن الذي يُؤثر في القلب) / أَحْرَقَ (أحرقت النار الشيءَ: حرقته؛ أحرقَ الشيءَ: أهلكه) / حَرَقَ (الفعل له عدة معانٍ تتعلق بالتأثير والتلف، منها: برد الحديد، حكّ الأنياب، إتلاف الثوب بالدق، وحرق الشيء بالنار؛ إتلاف شيء ما بالنار أو بأداة حادة، كما يشمل المعنى المجازي للألم الشديد والحزن الذي يُؤثر في القلب) / ضَرِمَ / حرق (الفعل له عدة معانٍ تتعلق بالتأثير والتلف، منها: برد الحديد، حكّ الأنياب، إتلاف الثوب بالدق، وحرق الشيء بالنار؛ إتلاف شيء ما بالنار أو بأداة حادة، كما يشمل المعنى المجازي للألم الشديد والحزن الذي يُؤثر في القلب) / وَلَّع\nمثال: قامت ليلى بحرق كل كتب آرت المتعلقة بالأدب العنصري.",
 "焼き串": "سيخ (دبوس طويل لتثبيت اللحم في موضعه أثناء شيه)",
 "焼き付き": "إمساك, قبض (فعل الإمساك بشيء بإحكام باليدين) / خيط التحزيم (حبال صغيرة تستخدم لربط حبلين أو أكثر معاً)",
 "焼き付け": "طِبَاعَة / صقل, طلاء زجاجي (طلاء للسيراميك والمعدن وما إلى ذلك) / تلميع, صقل (طبقة نهائية لامعة على القماش) / طبقة تلميع, طلاء لامع (أي من التغطيات الرقيقة اللامعة (المالحة أو الحلوة) التي توضع على الأطعمة)",
 "焼き付ける": "خَبَزَ (هو طعام يصنع من الدَقِيق الذي يعجن بالماء والخَمِيرَة ويُخْبَز في الفُرْن أو التَنُّور؛ خُبْز الغُراب: الفِطْر، ويسمى أيضا عُشّ الغُرَاب) / خَبز (هو طعام يصنع من الدَقِيق الذي يعجن بالماء والخَمِيرَة ويُخْبَز في الفُرْن أو التَنُّور؛ خُبْز الغُراب: الفِطْر، ويسمى أيضا عُشّ الغُرَاب)\nمثال: هذا الخبز لذيذ. / تجنيد إجباري, سخرة (فعل إجبار شخص ما على الخدمة الحكومية) / طَبَعَ (طَبَعَ الله الخلقَ : أَنشأَهُ؛ طبَعَت الدَّوْلةُ النَّقْد : صاغتْه ونقشته)\nمثال: بالطبع هي مزحة! / عَلَامَة, شِعَار (سِمَةٌ أو أمارة أو شِعَار تُعرف به الأشياء؛ رَمْز) / مَارْكَة\nمثال: تحصلت على علامة أ.",
 "焼き入れ": "إخماد, إطفاء (فعل الإطفاء؛ التسبب في توقف الاحتراق)\nمثال: إطفاء الأنوار",
 "焼き印": "عَلَامَة, شِعَار (سِمَةٌ أو أمارة أو شِعَار تُعرف به الأشياء؛ رَمْز) / مَارْكَة\nمثال: تحصلت على علامة أ.",
 "焼き印を押す": "عَلَامَة, شِعَار (سِمَةٌ أو أمارة أو شِعَار تُعرف به الأشياء؛ رَمْز) / مَارْكَة\nمثال: تحصلت على علامة أ.",
 "焼き型": "قَالِب / سَنَّ ((سَنَّ) السِّكِّينَ و نحْوَهُ يَسُنُّ سَنًّا: أَحَدَّهُ؛ فهو مسنون وسَنِين) / تَعَفُّن, عُفُونَة\nمثال: هم في نفس السن.",
 "焼き場": "محرقة الجثث (فرن حيث يمكن حرق الجثة وتحويلها إلى رماد) / محرقة الجثث (مبنى جنائزي حيث يتم حرق الجثث)",
 "焼き戻し": "تطبيع, تلدين (تقسية شيء ما بالمعالجة الحرارية) / مُعَدِّل, مُهَدِّئ (يُلَطّف ويجعل الأمر أكثر اعتدالًا)",
 "焼き物": "فَخَّار, خَزَف / مَتْجَر الْفَخَّارِيَّات, مَحَلّ الْفَخَّارِيَّات / صِنَاعَة الفَخَّار (إيجاد الشيء وخَلْقُه؛ (استخدام حديث) قطاع اقتصادي)\nمثال: هذا البلد مدعوم بالصناعة.",
 "焼き目": "حَارِق, لَاذِع (شديد القسوة في النقد)",
 "焼き目をつける": "بُنِّيّ (هو لون ينتمي لمجموعة الألوان الحارة. وكلمة بني نسبة للبن (قهوة)) / أَسْمَر / أَسْمَر, سَمْرَاء\nمثال: توم من بني البشر.",
 "焼き目を付ける": "بُنِّيّ (هو لون ينتمي لمجموعة الألوان الحارة. وكلمة بني نسبة للبن (قهوة)) / أَسْمَر / أَسْمَر, سَمْرَاء\nمثال: توم من بني البشر.",
 "焼き直し": "إعادة إنتاج, نسخة جديدة (إبداع تم إنشاؤه مرة أخرى أو من جديد)\nمثال: إنه إعادة إنتاج لفيلم قديم",
 "焼き直す": "اجترار, تكرار (مادة قديمة تم إعادة صياغتها قليلاً واستخدامها مرة أخرى)\nمثال: مجرد اجترار ممل لروايته الأولى",
 "焼き石膏": "جص, جص باريس (أي من أسمنتات الجبس المختلفة؛ مسحوق أبيض (شكل من أشكال كبريتات الكالسيوم) يشكل عجينة عند خلطه بالماء ويتصلب؛ يستخدم في صنع القوالب والمنحوتات…)",
 "焼き窯": "فُرْن, تَنُّور",
 "焼き絵": "رسم بالحرق (تصميم يتم إنتاجه عن طريق الحرق على الخشب أو الجلد)",
 "焼き網": "ملعب كرة قدم أمريكية (ملعب اللعب الذي تُلعب عليه كرة القدم الأمريكية) / شواية شبكية (أداة طهي من قضبان معدنية متوازية؛ تستخدم لشواء السمك أو اللحم)",
 "焼き肉": "شواية / مُصَبَّع / مِشْوَاة / شِوَاء / مَشْوِيَّات / شَوَى, يَشْوِي",
 "焼き豚": "شواء خنزير (قطعة من لحم الخنزير مناسبة للتحمير)",
 "焼き過ぎる": "طباعة فوقية (شيء مضاف عن طريق الطباعة الفوقية)",
 "焼き金": "مِيسَم",
 "焼き鈍し": "تطبيع, تلدين (تقسية شيء ما بالمعالجة الحرارية)",
 "焼き鍋": "قِدْر, طَنْجَرَة (قضاء الله وحكمه وما قَدَّرَه؛ مبلغ الشيء وكميتّه، بنفس معنى قَدْر)\nمثال: خذ قدر ما تريد.",
 "焼き鏝": "مِكْوَاةُ اللَّحَّام, كاوِيَةُ اللَّحَّام / عَلَامَة, شِعَار (سِمَةٌ أو أمارة أو شِعَار تُعرف به الأشياء؛ رَمْز) / مَارْكَة\nمثال: تحصلت على علامة أ.",
 "焼き飯": "أرز صيني مقلي, أرز مقلي (أرز مسلوق مخلوط بالبصل الأخضر ولحم الخنزير المفروم أو الجمبري ومخفوق بسرعة مع البيض)",
 "焼き餅": "حَسَد, غَبْط (تمنيّ زوال نعمة الغير)\nمثال: الكره لا يظهر بكل بساطة من فراغ. إنه بالعادة يبدأ من الحسد أو الخوف.",
 "焼く": "حَرْق (الفعل له عدة معانٍ تتعلق بالتأثير والتلف، منها: برد الحديد، حكّ الأنياب، إتلاف الثوب بالدق، وحرق الشيء بالنار؛ إتلاف شيء ما بالنار أو بأداة حادة، كما يشمل المعنى المجازي للألم الشديد والحزن الذي يُؤثر في القلب) / سَفْعَة / حُرق (الفعل له عدة معانٍ تتعلق بالتأثير والتلف، منها: برد الحديد، حكّ الأنياب، إتلاف الثوب بالدق، وحرق الشيء بالنار؛ إتلاف شيء ما بالنار أو بأداة حادة، كما يشمل المعنى المجازي للألم الشديد والحزن الذي يُؤثر في القلب) / أَحْرَقَ (أحرقت النار الشيءَ: حرقته؛ أحرقَ الشيءَ: أهلكه) / حَرَقَ (الفعل له عدة معانٍ تتعلق بالتأثير والتلف، منها: برد الحديد، حكّ الأنياب، إتلاف الثوب بالدق، وحرق الشيء بالنار؛ إتلاف شيء ما بالنار أو بأداة حادة، كما يشمل المعنى المجازي للألم الشديد والحزن الذي يُؤثر في القلب) / ضَرِمَ / حرق (الفعل له عدة معانٍ تتعلق بالتأثير والتلف، منها: برد الحديد، حكّ الأنياب، إتلاف الثوب بالدق، وحرق الشيء بالنار؛ إتلاف شيء ما بالنار أو بأداة حادة، كما يشمل المعنى المجازي للألم الشديد والحزن الذي يُؤثر في القلب) / وَلَّع\nمثال: قامت ليلى بحرق كل كتب آرت المتعلقة بالأدب العنصري. / شَوَى, صَلَى / حَرَارَة (السخونة والحماوة؛ شدة العَطَش) / حَرَارَة, سُخُونَة (السخونة والحماوة؛ شدة العَطَش) / سَخَّنَ, أَحَرَّ (حمي وأصبح حارا)\nمثال: حرارة الطقس تتزايد. / فَعَلَ, صَنَعَ (عَمِلَ وصَنَعَ، بعلم أو بدون علم، عن قصد أو دون قصد) / جَعَلَ (صَيَّرَ؛ أَنْشَأَ)\nمثال: ماذا فعل للحمي؟",
 "焼けこげ": "حرق سطحي, شياط (تغير في اللون ناتج عن الحرارة) / لفحة (مرض نباتي ينتج مظهراً بنياً أو محروقاً لأنسجة النبات) / حرق سطحي (حرق في السطح)",
 "焼けこげる": "حرق سطحي, شياط (تغير في اللون ناتج عن الحرارة) / لفحة (مرض نباتي ينتج مظهراً بنياً أو محروقاً لأنسجة النبات) / حرق سطحي (حرق في السطح)",
 "焼けつく": "حَرْق (الفعل له عدة معانٍ تتعلق بالتأثير والتلف، منها: برد الحديد، حكّ الأنياب، إتلاف الثوب بالدق، وحرق الشيء بالنار؛ إتلاف شيء ما بالنار أو بأداة حادة، كما يشمل المعنى المجازي للألم الشديد والحزن الذي يُؤثر في القلب) / سَفْعَة / حُرق (الفعل له عدة معانٍ تتعلق بالتأثير والتلف، منها: برد الحديد، حكّ الأنياب، إتلاف الثوب بالدق، وحرق الشيء بالنار؛ إتلاف شيء ما بالنار أو بأداة حادة، كما يشمل المعنى المجازي للألم الشديد والحزن الذي يُؤثر في القلب) / أَحْرَقَ (أحرقت النار الشيءَ: حرقته؛ أحرقَ الشيءَ: أهلكه) / حَرَقَ (الفعل له عدة معانٍ تتعلق بالتأثير والتلف، منها: برد الحديد، حكّ الأنياب، إتلاف الثوب بالدق، وحرق الشيء بالنار؛ إتلاف شيء ما بالنار أو بأداة حادة، كما يشمل المعنى المجازي للألم الشديد والحزن الذي يُؤثر في القلب) / ضَرِمَ / حرق (الفعل له عدة معانٍ تتعلق بالتأثير والتلف، منها: برد الحديد، حكّ الأنياب، إتلاف الثوب بالدق، وحرق الشيء بالنار؛ إتلاف شيء ما بالنار أو بأداة حادة، كما يشمل المعنى المجازي للألم الشديد والحزن الذي يُؤثر في القلب) / وَلَّع\nمثال: قامت ليلى بحرق كل كتب آرت المتعلقة بالأدب العنصري.",
 "焼けぼっくい": "جَمْرَة",
 "焼ける": "حَرْق (الفعل له عدة معانٍ تتعلق بالتأثير والتلف، منها: برد الحديد، حكّ الأنياب، إتلاف الثوب بالدق، وحرق الشيء بالنار؛ إتلاف شيء ما بالنار أو بأداة حادة، كما يشمل المعنى المجازي للألم الشديد والحزن الذي يُؤثر في القلب) / سَفْعَة / حُرق (الفعل له عدة معانٍ تتعلق بالتأثير والتلف، منها: برد الحديد، حكّ الأنياب، إتلاف الثوب بالدق، وحرق الشيء بالنار؛ إتلاف شيء ما بالنار أو بأداة حادة، كما يشمل المعنى المجازي للألم الشديد والحزن الذي يُؤثر في القلب) / أَحْرَقَ (أحرقت النار الشيءَ: حرقته؛ أحرقَ الشيءَ: أهلكه) / حَرَقَ (الفعل له عدة معانٍ تتعلق بالتأثير والتلف، منها: برد الحديد، حكّ الأنياب، إتلاف الثوب بالدق، وحرق الشيء بالنار؛ إتلاف شيء ما بالنار أو بأداة حادة، كما يشمل المعنى المجازي للألم الشديد والحزن الذي يُؤثر في القلب) / ضَرِمَ / حرق (الفعل له عدة معانٍ تتعلق بالتأثير والتلف، منها: برد الحديد، حكّ الأنياب، إتلاف الثوب بالدق، وحرق الشيء بالنار؛ إتلاف شيء ما بالنار أو بأداة حادة، كما يشمل المعنى المجازي للألم الشديد والحزن الذي يُؤثر في القلب) / وَلَّع\nمثال: قامت ليلى بحرق كل كتب آرت المتعلقة بالأدب العنصري. / اختفاء, تلاشٍ (التوقف التدريجي عن الظهور) / ضربة مقوسة لليمين (ضربة غولف تنحني لليمين للاعب الغولف الأيمن)\nمثال: أخذ دروساً لعلاج ضرباته المقوسة",
 "焼け付く": "حَرْق (الفعل له عدة معانٍ تتعلق بالتأثير والتلف، منها: برد الحديد، حكّ الأنياب، إتلاف الثوب بالدق، وحرق الشيء بالنار؛ إتلاف شيء ما بالنار أو بأداة حادة، كما يشمل المعنى المجازي للألم الشديد والحزن الذي يُؤثر في القلب) / سَفْعَة / حُرق (الفعل له عدة معانٍ تتعلق بالتأثير والتلف، منها: برد الحديد، حكّ الأنياب، إتلاف الثوب بالدق، وحرق الشيء بالنار؛ إتلاف شيء ما بالنار أو بأداة حادة، كما يشمل المعنى المجازي للألم الشديد والحزن الذي يُؤثر في القلب) / أَحْرَقَ (أحرقت النار الشيءَ: حرقته؛ أحرقَ الشيءَ: أهلكه) / حَرَقَ (الفعل له عدة معانٍ تتعلق بالتأثير والتلف، منها: برد الحديد، حكّ الأنياب، إتلاف الثوب بالدق، وحرق الشيء بالنار؛ إتلاف شيء ما بالنار أو بأداة حادة، كما يشمل المعنى المجازي للألم الشديد والحزن الذي يُؤثر في القلب) / ضَرِمَ / حرق (الفعل له عدة معانٍ تتعلق بالتأثير والتلف، منها: برد الحديد، حكّ الأنياب، إتلاف الثوب بالدق، وحرق الشيء بالنار؛ إتلاف شيء ما بالنار أو بأداة حادة، كما يشمل المعنى المجازي للألم الشديد والحزن الذي يُؤثر في القلب) / وَلَّع\nمثال: قامت ليلى بحرق كل كتب آرت المتعلقة بالأدب العنصري.",
 "焼け木杭": "جَمْرَة",
 "焼け棒杭": "جَمْرَة",
 "焼け火ばし": "خَاطِف, سَرِيع جِدًّا (سَرِيع لِلغَايَة؛ قَادِر عَلَى الاسْتِجَابَة السَّرِيعَة وَالسُّرْعَة الفَائِقَة) / مُتَوَهِّج الحُمْرَة (يتوهَّج باللون الأحمر من شدَّة الحرارة) / مُتَأَجِّج, مُثِير (يتّسم بالعاطفة الشديدة أو الاهتمام أو الإثارة) / سَاخِن, طَازَج جِدًّا (الأحدث والأكثر جدّة)",
 "焼け火箸": "خَاطِف, سَرِيع جِدًّا (سَرِيع لِلغَايَة؛ قَادِر عَلَى الاسْتِجَابَة السَّرِيعَة وَالسُّرْعَة الفَائِقَة) / مُتَوَهِّج الحُمْرَة (يتوهَّج باللون الأحمر من شدَّة الحرارة) / مُتَأَجِّج, مُثِير (يتّسم بالعاطفة الشديدة أو الاهتمام أو الإثارة) / سَاخِن, طَازَج جِدًّا (الأحدث والأكثر جدّة)",
 "焼け焦げ": "حرق سطحي, شياط (تغير في اللون ناتج عن الحرارة) / لفحة (مرض نباتي ينتج مظهراً بنياً أو محروقاً لأنسجة النبات) / حرق سطحي (حرق في السطح)",
 "焼け焦げる": "حرق سطحي, شياط (تغير في اللون ناتج عن الحرارة) / لفحة (مرض نباتي ينتج مظهراً بنياً أو محروقاً لأنسجة النبات) / حرق سطحي (حرق في السطح)",
 "焼け石に水": "قَطْرَة فِي الْمُحِيط",
 "焼け腹": "استماتة, يأس (تهور يائس) / قنوط, يأس (حالة فقدان كل أمل أو غيابه)\nمثال: كانت سياسة يائسة",
 "焼っ腹": "استماتة, يأس (تهور يائس) / قنوط, يأس (حالة فقدان كل أمل أو غيابه)\nمثال: كانت سياسة يائسة",
 "焼なまし": "تطبيع, تلدين (تقسية شيء ما بالمعالجة الحرارية)",
 "焼串": "سيخ (دبوس طويل لتثبيت اللحم في موضعه أثناء شيه)",
 "焼付け": "طِبَاعَة / صقل, طلاء زجاجي (طلاء للسيراميك والمعدن وما إلى ذلك) / تلميع, صقل (طبقة نهائية لامعة على القماش) / طبقة تلميع, طلاء لامع (أي من التغطيات الرقيقة اللامعة (المالحة أو الحلوة) التي توضع على الأطعمة)",
 "焼付ける": "خَبَزَ (هو طعام يصنع من الدَقِيق الذي يعجن بالماء والخَمِيرَة ويُخْبَز في الفُرْن أو التَنُّور؛ خُبْز الغُراب: الفِطْر، ويسمى أيضا عُشّ الغُرَاب) / خَبز (هو طعام يصنع من الدَقِيق الذي يعجن بالماء والخَمِيرَة ويُخْبَز في الفُرْن أو التَنُّور؛ خُبْز الغُراب: الفِطْر، ويسمى أيضا عُشّ الغُرَاب)\nمثال: هذا الخبز لذيذ. / تجنيد إجباري, سخرة (فعل إجبار شخص ما على الخدمة الحكومية) / طَبَعَ (طَبَعَ الله الخلقَ : أَنشأَهُ؛ طبَعَت الدَّوْلةُ النَّقْد : صاغتْه ونقشته)\nمثال: بالطبع هي مزحة! / عَلَامَة, شِعَار (سِمَةٌ أو أمارة أو شِعَار تُعرف به الأشياء؛ رَمْز) / مَارْكَة\nمثال: تحصلت على علامة أ.",
 "焼入れ": "إخماد, إطفاء (فعل الإطفاء؛ التسبب في توقف الاحتراق)\nمثال: إطفاء الأنوار",
 "焼印": "عَلَامَة, شِعَار (سِمَةٌ أو أمارة أو شِعَار تُعرف به الأشياء؛ رَمْز) / مَارْكَة\nمثال: تحصلت على علامة أ.",
 "焼印を押す": "عَلَامَة, شِعَار (سِمَةٌ أو أمارة أو شِعَار تُعرف به الأشياء؛ رَمْز) / مَارْكَة\nمثال: تحصلت على علامة أ.",
 "焼却": "تحريق, ترميد (عملية حرق شيء ما بالكامل؛ تحويله إلى رماد)",
 "焼却灰": "رَمَاد, سَكَن / دَرْدَار",
 "焼却炉": "محرقة, مرمدة (فرن للحرق (خاصة للتخلص من النفايات))",
 "焼型": "قَالِب / سَنَّ ((سَنَّ) السِّكِّينَ و نحْوَهُ يَسُنُّ سَنًّا: أَحَدَّهُ؛ فهو مسنون وسَنِين) / تَعَفُّن, عُفُونَة\nمثال: هم في نفس السن.",
 "焼場": "محرقة الجثث (فرن حيث يمكن حرق الجثة وتحويلها إلى رماد) / محرقة الجثث (مبنى جنائزي حيث يتم حرق الجثث)",
 "焼塊": "طوب محروق, كلينكر (طوب صلب يستخدم كحجر رصف) / خَبَث الفحم, رَمَاد خَشِن (بقايا غير قابلة للاحتراق تُترك بعد حريق الخشب أو الفحم أو الفحم النباتي)",
 "焼夷弾": "قنبلة حارقة (قنبلة مصممة لإشعال الحرائق؛ وهي أكثر فعالية ضد الأهداف القابلة للاشتعال (مثل الوقود))",
 "焼成": "إطلاق نار (فعل إطلاق النار من بندقية) / إقالة, تسريح (إنهاء توظيف شخص ما (وتركه حراً للمغادرة)) / إشعال, إضرام (عملية إضرام النار في شيء ما) / إطلاق نار, رمي (فعل إطلاق الأسلحة أو المدفعية على عدو)\nمثال: تراجعوا في مواجهة نيران العدو الشديدة",
 "焼戻し": "تطبيع, تلدين (تقسية شيء ما بالمعالجة الحرارية) / مُعَدِّل, مُهَدِّئ (يُلَطّف ويجعل الأمر أكثر اعتدالًا)",
 "焼火ばし": "خَاطِف, سَرِيع جِدًّا (سَرِيع لِلغَايَة؛ قَادِر عَلَى الاسْتِجَابَة السَّرِيعَة وَالسُّرْعَة الفَائِقَة) / مُتَوَهِّج الحُمْرَة (يتوهَّج باللون الأحمر من شدَّة الحرارة) / مُتَأَجِّج, مُثِير (يتّسم بالعاطفة الشديدة أو الاهتمام أو الإثارة) / سَاخِن, طَازَج جِدًّا (الأحدث والأكثر جدّة)",
 "焼火箸": "خَاطِف, سَرِيع جِدًّا (سَرِيع لِلغَايَة؛ قَادِر عَلَى الاسْتِجَابَة السَّرِيعَة وَالسُّرْعَة الفَائِقَة) / مُتَوَهِّج الحُمْرَة (يتوهَّج باللون الأحمر من شدَّة الحرارة) / مُتَأَجِّج, مُثِير (يتّسم بالعاطفة الشديدة أو الاهتمام أو الإثارة) / سَاخِن, طَازَج جِدًّا (الأحدث والأكثر جدّة)",
 "焼灼": "كي (فعل تخثير الدم وتدمير الأنسجة بحديد ساخن أو عامل كاوٍ أو بالتجميد) / مادة كاوية, مكواة (أداة أو مادة تستخدم لتدمير الأنسجة لأسباب طبية (مثل إزالة الثؤلول) عن طريق حرقها بمكواة ساخنة أو تيار كهربائي أو مادة كاوية أو عن طريق تجميدها)",
 "焼物": "فَخَّار, خَزَف / مَتْجَر الْفَخَّارِيَّات, مَحَلّ الْفَخَّارِيَّات / صِنَاعَة الفَخَّار (إيجاد الشيء وخَلْقُه؛ (استخدام حديث) قطاع اقتصادي)\nمثال: هذا البلد مدعوم بالصناعة.",
 "焼目": "حَارِق, لَاذِع (شديد القسوة في النقد)",
 "焼石膏": "جص, جص باريس (أي من أسمنتات الجبس المختلفة؛ مسحوق أبيض (شكل من أشكال كبريتات الكالسيوم) يشكل عجينة عند خلطه بالماء ويتصلب؛ يستخدم في صنع القوالب والمنحوتات…)",
 "焼網": "ملعب كرة قدم أمريكية (ملعب اللعب الذي تُلعب عليه كرة القدم الأمريكية) / شواية شبكية (أداة طهي من قضبان معدنية متوازية؛ تستخدم لشواء السمك أو اللحم)",
 "焼肉": "شواية / مُصَبَّع / مِشْوَاة / شِوَاء / مَشْوِيَّات / شَوَى, يَشْوِي",
 "焼腹": "استماتة, يأس (تهور يائس) / قنوط, يأس (حالة فقدان كل أمل أو غيابه)\nمثال: كانت سياسة يائسة",
 "焼豚": "شواء خنزير (قطعة من لحم الخنزير مناسبة للتحمير)",
 "焼鈍": "تطبيع, تلدين (تقسية شيء ما بالمعالجة الحرارية)",
 "焼鈍し": "تطبيع, تلدين (تقسية شيء ما بالمعالجة الحرارية)",
 "焼鍋": "قِدْر, طَنْجَرَة (قضاء الله وحكمه وما قَدَّرَه؛ مبلغ الشيء وكميتّه، بنفس معنى قَدْر)\nمثال: خذ قدر ما تريد.",
 "焼飯": "أرز صيني مقلي, أرز مقلي (أرز مسلوق مخلوط بالبصل الأخضر ولحم الخنزير المفروم أو الجمبري ومخفوق بسرعة مع البيض)",
 "焼骨": "حرق الجثث (ترميد جثة الميت) / رَمَاد, سَكَن / دَرْدَار",
 "煆焼": "تكليس (تحويل المعادن إلى أكاسيدها نتيجة للتسخين إلى درجة حرارة عالية)",
 "煉り上げる": "بُولَنْدِيّ / لَمَّعَ (لمع أي أصدر ضَوْءً أو عَكَسَهُ) / صَقَل",
 "煉り土": "أَلْصَقَ",
 "煉り物": "تقدم, زحف (فعل التحرك للأمام (نحو هدف)) / مَسِيرَة, مَوْكِب (العمل الجماعي لمجموعة من الناس أو الحيوانات أو المركبات التي تتحرك للأمام في تشكيل منتظم إلى حد ما) / انبثاق, فيض ((اللاهوت) انبثاق الروح القدس في العنصرة)\nمثال: كانت المواكب محظورة",
 "煉り香": "قرص طبي محلى",
 "煉丹": "إكسير الحياة (مادة افتراضية يعتقد أنها تحافظ على الحياة إلى أجل غير مسمى؛ كان يسعى إليها الخيميائيون)",
 "煉丹術": "اَلْخِيمِيَاء, خِيمِيَاء",
 "煉土": "أَلْصَقَ",
 "煉炭": "قالب فحم (كتلة مصنوعة من الفحم النباتي أو غبار الفحم وتحرق كوقود)",
 "煉獄": "مَطْهَر",
 "煉瓦": "طُوبَة, لَبِنَة",
 "煉瓦造り": "أعمال الطوب, بناء بالطوب (بناء يتم باستخدام الطوب والملاط)",
 "煉香": "قرص طبي محلى",
 "煌々": "باهِر",
 "煌き": "لَمَعَ, بَرَقَ (لمع أي أصدر ضَوْءً أو عَكَسَهُ)",
 "煌く": "لَمَعَ, بَرَقَ (لمع أي أصدر ضَوْءً أو عَكَسَهُ)",
 "煌びやか": "خَلَّاب, سَاحِر (جميل بشكل مُبْهِر)",
 "煌めき": "لَمَعَ, بَرَقَ (لمع أي أصدر ضَوْءً أو عَكَسَهُ)",
 "煌めく": "لَمَعَ, بَرَقَ (لمع أي أصدر ضَوْءً أو عَكَسَهُ)",
 "煌煌": "باهِر",
 "煎": "بث, حقن (فعل غرس أو إدخال عنصر أو صفة معدلة معينة) / تسريب ((طب) الإدخال السلبي لمادة (سائل أو دواء أو إلكتروليت) في وريد أو بين الأنسجة (كما عن طريق قوة الجاذبية)) / منقوع, نقع (عملية استخلاص خصائص فعالة معينة (كدواء من نبات) عن طريق النقع أو الغمر (عادة في الماء)) / مستخلص, منقوع (محلول يتم الحصول عليه عن طريق نقع مادة (عادة في الماء))\nمثال: يُعزى النجاح المستمر للفريق إلى الضخ المستمر للمواهب الجديدة",
 "煎じる": "دُمَّل, خُرَاج / غَلَيَان, غَلْي / غَلَّى",
 "煎じ薬": "غلي, مغلي ((في علم الصيدلة) استخلاص المواد الدوائية القابلة للذوبان في الماء عن طريق الغليان)",
 "煎じ詰めると": "فِي النِّهَايَة (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "煎ずる": "دُمَّل, خُرَاج / غَلَيَان, غَلْي / غَلَّى",
 "煎りつける": "شَوَى, صَلَى",
 "煎り付ける": "شَوَى, صَلَى",
 "煎り卵": "بيض مخفوق (بيض مخفوق ومطبوخ حتى يصبح قوامه متماسكاً وطرياً مع التحريك)",
 "煎り玉子": "بيض مخفوق (بيض مخفوق ومطبوخ حتى يصبح قوامه متماسكاً وطرياً مع التحريك)",
 "煎る": "شَوَى, صَلَى",
 "煎剤": "غلي, مغلي ((في علم الصيدلة) استخلاص المواد الدوائية القابلة للذوبان في الماء عن طريق الغليان)",
 "煎茶": "شَايْ أَخْضَر (شَجَرَة خَضْرَاء من فَصِيلَة الكَامِيلِيات لها أزْهَار بَيْضَاء، وتُعْطِي أوراقاً يصنع منها شَرَاب مُنَبِّه؛ أوراق الشجرة المجففة)\nمثال: صب الشاي لضيفك.",
 "煎薬": "غلي, مغلي ((في علم الصيدلة) استخلاص المواد الدوائية القابلة للذوبان في الماء عن طريق الغليان)",
 "煕々": "وَاسِع, رَحْب (واسِع: (اسم)؛ واسع: (اسم))\nمثال: أرض الله واسعة. / حَافِل بِالنَّشَاط, صَاخِب (مليء بالنشاط الحيويّ والصاخب)",
 "煕春茶": "هايسون (شاي أخضر صيني بأوراق ملتوية)",
 "煕煕": "وَاسِع, رَحْب (واسِع: (اسم)؛ واسع: (اسم))\nمثال: أرض الله واسعة. / حَافِل بِالنَّشَاط, صَاخِب (مليء بالنشاط الحيويّ والصاخب)",
 "煖": "مُدَفِّئ, مُسَخِّن (يُنتِج إحساساً بالحرارة عند وضعه على الجسم) / مُدْفِئ (يمنح الدفء والحرارة) / دفء, ذوبان الجليد (طقس دافئ يعقب التجمد؛ يذوب فيه الثلج والجليد) / تدفئة, تسخين (عملية التحول إلى الدفء؛ ارتفاع درجة الحرارة)\nمثال: رحبوا بذوبان الجليد الربيعي",
 "煖気": "دفاء",
 "煙": "دُخَان, دخان / دَخَّنَ (دخن: الشَّيْء دخنة دخن؛ دخنت: النَّار دخنت والوقود دخن)\nمثال: دخن زيري سيجارة.",
 "煙い": "مدخن, مليء بالدخان (يتميز بوجود الدخان أو انبعاثه أو الامتلاء به) / مُدَخَّن (ذُو طَعْمِ الدُّخَان)\nمثال: عوارض مدخنة",
 "煙たい": "مدخن, مليء بالدخان (يتميز بوجود الدخان أو انبعاثه أو الامتلاء به) / مُدَخَّن (ذُو طَعْمِ الدُّخَان)\nمثال: عوارض مدخنة / غَيْر مُرْتَاح, مُرْتَبِك (يشعر بعدم الارتياح الاجتماعي؛ غير واثق ومتحفظ) / غَيْرُ مُنَاسِب, مُحْرِج (يُسَبِّبُ الإِزْعَاجَ أَوْ عَدَمَ الارْتِيَاح) / حَرِج, مُحْرِج (صَعْب التَّعَامُل مَعَهُ؛ يُسَبِّب أَلَمًا أَوْ إِحْرَاجًا) / ثَقِيل الأُسْلُوب, رَكِيك (يَفْتَقِر إِلَى الأَنَاقَة أَوِ الرَّشَاقَة فِي التَّعْبِير)",
 "煙っぽい": "مدخن, مليء بالدخان (يتميز بوجود الدخان أو انبعاثه أو الامتلاء به) / مُدَخَّن (ذُو طَعْمِ الدُّخَان)\nمثال: عوارض مدخنة",
 "煙に巻く": "أَرْبَكَ",
 "煙り出し": "مَدْخَنَة",
 "煙る": "دُخَان, دخان / دَخَّنَ (دخن: الشَّيْء دخنة دخن؛ دخنت: النَّار دخنت والوقود دخن)\nمثال: دخن زيري سيجارة.",
 "煙を立てる": "اِرْتَزَقَ",
 "煙出し": "مَدْخَنَة",
 "煙塵": "تُرْبَة, تُرَاب / بُقْعَة, قَذَارَة",
 "煙幕": "سِتَار دُخَانِيّ",
 "煙弾": "قنبلة دخانية (قنبلة تطلق دخاناً كثيفاً عند انفجارها؛ تستخدم لعمل ستار دخاني أو لتحديد موقع)",
 "煙探知器": "إنذار حريق, كاشف دخان (إنذار ينطلق بسبب الحريق أو الدخان)",
 "煙水晶": "كوارتز دخاني, كيرنغورم (كوارتز أصفر دخاني أو بني)",
 "煙波": "رذاذ البحر (رذاذ من أمواج المحيط)",
 "煙火": "فَنَار / مَنَار / مُفَرْقِعَات, أَلْعَاب نَارِيَّة",
 "煙玉": "قنبلة دخانية (قنبلة تطلق دخاناً كثيفاً عند انفجارها؛ تستخدم لعمل ستار دخاني أو لتحديد موقع)",
 "煙硝": "بَارُود",
 "煙突": "مَدْخَنَة",
 "煙筒": "مَدْخَنَة",
 "煙管": "مَدْخَنَة",
 "煙草": "تِبْغ, تَبْغ / تَبْغ, تَبَغ / تبغ, نبات التبغ (أعشاب وشجيرات عطرية حولية أو معمرة)",
 "煙草を吸う": "دُخَان, دخان / دَخَّنَ (دخن: الشَّيْء دخنة دخن؛ دخنت: النَّار دخنت والوقود دخن)\nمثال: دخن زيري سيجارة.",
 "煙草入れ": "كيس تبغ (جراب لحمل تبغ الغليون)",
 "煙警報器": "إنذار حريق, كاشف دخان (إنذار ينطلق بسبب الحريق أو الدخان)",
 "煙道": "مَدْخَنَة",
 "煙霞": "سَدِيم",
 "煙霧": "عَجَاج",
 "煙霧質": "هَبَاء جَوِّيّ, أَيْرُوسُول",
 "煢然": "وَحِيد, مُنْفَرِد",
 "煢独": "يَتِيم / يَتِيمَة",
 "煤": "سُخَام",
 "煤塵": "جسيمات, مادة جسيمية (كتلة صغيرة منفصلة من مادة صلبة أو سائلة تبقى منتشرة بشكل فردي في انبعاثات الغاز أو السائل (تعتبر عادة ملوثاً للغلاف الجوي))",
 "煤払い": "تنظيف المنزل (فعل تنظيف غرف ومفروشات المنزل) / تنظيف داخلي, حملة تطهير ((مجازياً) فعل الإصلاح عن طريق إزالة الموظفين أو الممارسات أو الظروف غير المرغوب فيها)\nمثال: تنظيف المنزل الفعال يجب أن يتم غرفة غرفة",
 "煥発": "أُبَّهَة, رَوْعَة (صفة كون الشيء رائعاً أو فاخراً أو عظيماً) / بريق, توهج (ضوء داخل مجال الرؤية يكون أكثر سطوعاً من السطوع الذي تتكيف معه العينان) / عبقرية, نبوغ (قدرة عقلية غير عادية)\nمثال: بالنسبة للفخامة والخدمة الشخصية",
 "照らし合わせる": "تَفَقُّد / كِشّ مَلِك / فَاتُورَة, حِسَاب / اِسْتَأْنَى, دَقَّقَ ((مُتَعَدٍّ بِالْبَاءِ أَوْ بِـ\"فِي\" أو بِدُونِهِمَا) تَأَنَّى، انْتَظَرَ) / كَشَّ",
 "照らす": "قَارَنَ / شَبَّهَ",
 "照り": "نُور الشَّمْس (ضد الظَلام؛ ما يشع فيمكن الرؤية بسببه؛ ضد الضوء:ما يشع من أصله وليس ما يعكس الشعاع من غيره)\nمثال: نسي أن يطفئ النور.",
 "照り映える": "لَمَعَ, وَمَضَ (لمع أي أصدر ضَوْءً أو عَكَسَهُ)",
 "照り焼": "تِيرْيَاكِي",
 "照り焼き": "تِيرْيَاكِي",
 "照り返し": "اِنْعِكَاس, عَكْس",
 "照り返す": "عَكَسَ",
 "照る": "لَمَعَ, وَمَضَ (لمع أي أصدر ضَوْءً أو عَكَسَهُ)",
 "照れ": "خجل, وجل (الشعور بالإحراج بسبب التواضع)",
 "照れくさい": "حَرِج, مُحْرِج (صَعْب التَّعَامُل مَعَهُ؛ يُسَبِّب أَلَمًا أَوْ إِحْرَاجًا) / مُحْرِج, مُخْجِل (يسبب الشعور بالخجل أو الانزعاج أو الضيق)",
 "照れ性": "خَجُول",
 "照れ臭い": "حَرِج, مُحْرِج (صَعْب التَّعَامُل مَعَهُ؛ يُسَبِّب أَلَمًا أَوْ إِحْرَاجًا) / مُحْرِج, مُخْجِل (يسبب الشعور بالخجل أو الانزعاج أو الضيق)",
 "照会": "استفسار, تحقيق (تحقيق منهجي في مسألة ذات اهتمام عام) / بحث, تحقيق (بحث عن المعرفة) / استجواب, استفسار (حالة من السؤال أو الاستفسار)\nمثال: تستحق فخارياتهم بحثاً أكثر مما تلقته / اِسْتِعْلام (يُقال:اِسْتَعْلِمْ لي خبر فلان وأَعْلِمِنِيه حتى أَعْلَمَهُ، واسْتَعْلَمَنِي الخبَرَ فَأَعْلَمْتُهُ إيّاهُ؛ اِسْتَعْلَمَ يَسْتَعْلِمُ اِسْتِعْلَاماً: فهو مُسْتَعْلِم والمفعول مُسْتَعْلَم)",
 "照会先": "مَرْجِع",
 "照会言語": "لُغَةَ الاِسْتِعْلَام (هِيَ مجموعة من الأصوات التي يصدرها الإنسان على شكل كلمات منظمة بقواعد، ليتواصل به الناس وينقلون به الافكار والمعاني، اللسان؛ يقصد بها أحيانا اللهجة)\nمثال: الأمازيغية لغة.",
 "照合": "تَفَقُّد / كِشّ مَلِك / فَاتُورَة, حِسَاب / اِسْتَأْنَى, دَقَّقَ ((مُتَعَدٍّ بِالْبَاءِ أَوْ بِـ\"فِي\" أو بِدُونِهِمَا) تَأَنَّى، انْتَظَرَ) / كَشَّ",
 "照合機": "آلة تجميع, مجمعة البطاقات (آلة تقوم باختيار ودمج ومطابقة مجموعات من البطاقات المثقوبة)",
 "照射": "تَشَعُّع / تَشْعِيع / تعريض (فعل تعريض شخص ما لتجربة مؤثرة) / ترك في العراء, نبذ (التخلي دون مأوى أو حماية (مثل ترك رضيع في العراء)) / إظهار, كشف (العرض للمشاهدة بطريقة علنية أو عامة) / تعريض (فعل تعريض الفيلم للضوء)\nمثال: نددت بتعريض الأطفال للمواد الإباحية",
 "照射処理": "إِضَاءَة",
 "照射法": "تَشَعُّع / تَشْعِيع",
 "照射線量": "جرعة التعرض (قياس للإشعاع فيما يتعلق بقدرته على إنتاج التأين)",
 "照尺": "مَشْهَد / مَنْظَر",
 "照度": "إِضَاءَة",
 "照影": "صُورَة / بُورْتْرِيَّة",
 "照応": "مُرَاسَلَة",
 "照明": "إِضَاءَة",
 "照明弾": "كرة طائرة قصيرة ((بيسبول) كرة طائرة تضرب لمسافة قصيرة في الملعب الخارجي) / تمريرة جانبية (تمريرة أمامية قصيرة لظهير يركض نحو الخطوط الجانبية) / شعلة ضوئية, مشعل (جهاز ينتج ضوءاً ساطعاً للتحذير أو الإضاءة أو تحديد الهوية) / توهج, وميض (انفجار ضوئي يستخدم للتواصل أو الإضاءة)",
 "照星": "خرزة (كرة صغيرة بها ثقب في المنتصف) / حافة خرزية (إطار مزخرف بالخرز لحاشية أو تزيين الأثاث) / حبة, قطرة (شكل كروي وصغير)\nمثال: حبات العرق على جبهته",
 "照映": "صُورَة / بُورْتْرِيَّة",
 "照査": "إثبات, تأكيد (دليل إضافي على أن شيئاً كان يُعتقد (حقيقة أو فرضية أو نظرية) صحيح) / تحقق, توثيق ((في القانون) إقرار مرفق ببيان يؤكد صحة ذلك البيان)\nمثال: قدمت الحفريات تأكيداً إضافياً لنظرية التطور",
 "照準": "مَشْهَد / مَنْظَر",
 "照準器": "منظار التسديد, موجّه (أداة بصرية لمساعدة العين في التصويب، كما في سلاح ناري أو أداة مسح)",
 "照焼": "تِيرْيَاكِي",
 "照焼き": "تِيرْيَاكِي",
 "照空灯": "كشاف ضوئي (مصدر ضوء بعاكسات يسقط شعاعاً من الضوء في اتجاه معين)",
 "照葉木": "غار إسكندري (شجرة من شرق الهند لها عناقيد من الزهور البيضاء العطرة؛ المناطق الساحلية من جنوب الهند إلى ماليزيا)",
 "煩": "مُشْكِلَة, مَتاعِب",
 "煩い": "صَارِخ, صاخِب / مُزْعِج / دَقِيق, مُتَطَلِّب (شَدِيد التَّدْقِيق خَاصَّةً فِي التَّفَاصِيل) / عَبُوس, مُتَذَمِّر (مُنزعج وسريع الانفعال) / مُزْدَحِم بِالتَّفَاصِيل (مكتظّ بالتفاصيل والزخارف بشكل مفرط) / كَمَّمَ الفَمَ / صَه, اُسْكُت (صَهْ اسم فعل أمر بمعنى اسكتْ، وهو بلفظ واحد للمفرد و الجمع و المذكر و المؤنث; يقال صَهٍ بالتنوين بمعنى اسكت سكوتاً ما في وقتٍ ما) / قَلِقَ (شاعر بالقَلَق؛ تَحَرّك/اهتزاز/اضطراب في الوضع الطبيعي للشيء) / قَلَق (شاعر بالقَلَق؛ تَحَرّك/اهتزاز/اضطراب في الوضع الطبيعي للشيء)\nمثال: ليلى قلقة بشأنك. / مَرَض, دَاء (أصابه مرضٌ أو علّة أو سَقَم)\nمثال: هذا المرض قلبي.",
 "煩いつく": "مَرِضَ, أُصِيبَ بِالْمَرَض (أصابه مرضٌ أو علّة أو سَقَم)\nمثال: هذا المرض قلبي.",
 "煩い付く": "مَرِضَ, أُصِيبَ بِالْمَرَض (أصابه مرضٌ أو علّة أو سَقَم)\nمثال: هذا المرض قلبي.",
 "煩う": "قَلِقَ (شاعر بالقَلَق؛ تَحَرّك/اهتزاز/اضطراب في الوضع الطبيعي للشيء) / قَلَق (شاعر بالقَلَق؛ تَحَرّك/اهتزاز/اضطراب في الوضع الطبيعي للشيء)\nمثال: ليلى قلقة بشأنك.",
 "煩さ型": "تنطع, دقة مفرطة (سمة التدقيق المفرط في أمور الذوق أو الأسلوب)\nمثال: أناقة وتدقيق في الملابس",
 "煩わしい": "مُتْعِب, مُزْعِج (يُسَبِّب صُعُوبَةً أَوْ إِزْعَاجًا)",
 "煩わす": "مُشْكِلَة, مَتاعِب",
 "煩わせる": "مُشْكِلَة, مَتاعِب",
