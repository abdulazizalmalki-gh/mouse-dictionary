 "機械コード": "كود الآلة, لغة الآلة (مجموعة من التعليمات المشفرة بحيث يمكن للحاسوب استخدامها مباشرة دون ترجمة إضافية)",
 "機械之心": "مُحْتَال, مُدَبِّر (يُخفي خططًا ماكرة لتحقيق مصلحته الشخصيّة) / داهِيَة, مُتَآمِر (حاذِق في التَّدْبير والتَّخْطيط بِمَكْر وحِيلَة)",
 "機械仕掛け": "آلِيَّة",
 "機械化": "مَكْنَنَة, مَيْكَنَة",
 "機械学": "مِيكَانِيكَا, مِيكَانِيكِيَّة",
 "機械学習": "تعلم الآلة (مجال فرعي من علوم الحاسوب يستكشف دراسة وبناء الخوارزميات التي يمكنها التعلم من البيانات وتقديم تنبؤات حولها)",
 "機械室": "غرفة المحرك (غرفة (كما في السفينة) يوجد فيها المحرك)",
 "機械工": "فني آلات, ميكانيكي (حرفي ماهر في تشغيل الأدوات الآلية)",
 "機械工具": "آلَة تَشْغِيل (الفارسية: ماشين؛ الأوردية: مشين)\nمثال: نسى زيري الآلة.",
 "機械工学": "هندسة ميكانيكية (فرع الهندسة الذي يتعامل مع تصميم وبناء وتشغيل الآلات)",
 "機械式": "مِيكَانِيكِيّ",
 "機械技師": "مهندس ميكانيكي (شخص مدرب على تصميم وبناء الآلات)",
 "機械水雷": "لِي, لي / مَنْجَم, لَغَم / لَغْم, لَغَم / لَغَمَ",
 "機械的": "مِيكَانِيكِيّ",
 "機械的エネルギー": "طاقة ميكانيكية (القُدْرَة والشِدَّة؛ هي مقدار ما يمكن للإنسان أن يفعله بمشقة، كأن قدرته محددة بطَوْق)\nمثال: طلب بطاقة اعتماد.",
 "機械翻訳": "ترجمة آلية (استخدام الحواسيب للترجمة من لغة إلى أخرى)",
 "機械装置": "آلَة, مَاكِينَة (الفارسية: ماشين؛ الأوردية: مشين)\nمثال: نسى زيري الآلة.",
 "機械製": "مصنوع آلياً, ميكانيكي الصنع (مصنوع بواسطة الآلة)",
 "機械語": "لُغَة آلَة (هِيَ مجموعة من الأصوات التي يصدرها الإنسان على شكل كلمات منظمة بقواعد، ليتواصل به الناس وينقلون به الافكار والمعاني، اللسان؛ يقصد بها أحيانا اللهجة)\nمثال: الأمازيغية لغة.",
 "機械論": "آلِيَّة",
 "機械論者": "آلي, ميكانيكي المذهب (فيلسوف يؤيد مذهب الآلية)",
 "機械類": "آلات, معدات (الآلات أو أنظمة الآلات بشكل جماعي) / آلية, جهاز (نظام من الوسائل والأنشطة تعمل من خلاله مؤسسة اجتماعية)\nمثال: آلية التفاوض المعقدة",
 "機構": "آلِيَّة / نِظَام (مَنْهَج، طَرِيقَة؛ تَرْتِيب واتِّسَاق) / جِهَاز\nمثال: ليس بنظام كامل.",
 "機構改革": "إعادة تنظيم, إعادة هيكلة (تغيير واسع النطاق لهيكل شركة أو حكومة) / إعادة تنظيم (فرض تنظيم جديد؛ التنظيم بشكل مختلف (غالباً ما ينطوي على تغييرات واسعة وجذرية))\nمثال: بعد الاستحواذ كان هناك إعادة تنظيم شاملة",
 "機甲": "دِرْع (غطاء واقٍ صلب وقاسٍ إلى حد ما لحيوان أو نبات) / تدريع, درع (غطاء واقٍ مصنوع من المعدن ويستخدم في القتال) / مدرعات (وحدة عسكرية تتكون من مركبات قتالية مدرعة)",
 "機略": "مَوْرِد",
 "機知": "وعي, إدراك (الفَهْم والتَدَبُّر واِحْتِوَاء كل معاني الشيء؛ في علم النفس: حالة وعي ويعني أيضا محتوى العقل، ويشمل المشاعر والوعي الذاتي وٱلصور وَالأفكار وَٱلقدرة على إدراك العلاقة بين المرء وٱلبيئة والشعور بما…)\nمثال: إنها فاقدة الوعي.",
 "機種": "نَمُوذَج / نَمُوذَج مُصَغَّر / قَدْوَة (من يُقتدى به)",
 "機縁": "فُرْصَة",
 "機織": "حياكة, نسيج (صنع القماش)",
 "機織り": "حياكة, نسيج (صنع القماش)",
 "機織り虫": "جُنْدُب, جَرَادَة",
 "機織鳥": "حباك (طيور استعمارية أفريقية وآسيوية تشبه الشرشور تشتهر بأعشاشها المنسوجة بإتقان)",
 "機能": "وَظِيفَة (ما يُقَدَّر من الشيء في زمن مُعَيَّن؛ مَنْصِب) / مَهَمَّة / دَالَّة, تَابِع / وَظِيفَة, دَالَّة (ما يُقَدَّر من الشيء في زمن مُعَيَّن؛ مَنْصِب)\nمثال: ما وظيفة زوجتك؟",
 "機能不全": "خلل وظيفي, قصور وظيفي (أي اضطراب في أداء عضو أو جزء من الجسم، أو اضطراب في عمل مجموعة اجتماعية)\nمثال: ضعف الانتصاب",
 "機能主義": "وظيفية (أي مذهب يركز على المنفعة أو الغرض) / وظيفية (علم نفس يقوم على افتراض أن جميع العمليات العقلية مفيدة للكائن الحي في التكيف مع البيئة)",
 "機能単一化文法": "جو خانق ((عامية بريطانية) جو كريه الرائحة ودخاني وعديم الهواء)",
 "機能性": "عَمَلِيَّة, وَظِيفِيَّة (القدرة على خدمة غرض ما بشكل جيد)\nمثال: برمجيات ذات وظيفية أكبر",
 "機能拡張": "تَمْدِيد",
 "機能的": "عملي, وظيفي (مصمم لـ أو قادر على أداء وظيفة أو استخدام معين) / شَغَّال, عَامِل ((عَنِ الآلَات مَثَلًا) يَعْمَلُ أَوْ قَادِر عَلَى العَمَل) / وظيفي (يتعلق بالوظيفة أو يؤثر عليها بدلاً من علم وظائف الأعضاء (الفسيولوجيا)) / وَظِيفِيّ (مصمم لوظيفة معينة أو مكيَّف لاستخدام محدد)\nمثال: أسلوب في الكتابة تكون فيه كل كلمة وظيفية",
 "機能語": "كَلِمَة وَظِيفِيَّة (الكلِمَةُ : اللفظةُ الدَّالةُ على معنًى مُفْرَد بالوضع، وتكون؛ الكلِمَةُ: الكلامُ المؤلَّفُ المطوَّل، قصيدةً، أَو خُطْبَةً، أَو مقالةً، أَو رسالة)\nمثال: كلمة السر طويلة.",
 "機能障害": "اضطراب وظيفي (اضطراب يظهر أعراضاً لا يمكن تحديد سبب فسيولوجي أو تشريحي لها)",
 "機転": "سرعة بديهة, سرعة ذهنية (الذكاء كما يكشف عنه القدرة على تقديم إجابات صحيحة دون تأخير)",
 "機軸": "مِحْوَر",
 "機運": "فُرْصَة / رَائِج, مُتَدَاوَل / يَرُوج, يُتَدَاوَل",
 "機銃": "رَشَاش, مِتْرالِيُوز (أي آلَة تَرُش المَاء؛ المِدْفَع الرَشَّاش: هو بين المِدْفَع والرَشَّاشَة لا يُحمَل باليد ويثبت على الأرض إلا أنه يَرُشّ الرصاص كالرشاشة)\nمثال: إني أطلق النار برشاش روسي.",
 "機銃掃射": "تمشيط جوي, قصف جوي منخفض (هجوم بنيران الرشاشات أو نيران المدافع من طائرة تحلق على علو منخفض)",
 "機鋒": "جُلّ, مُعْظَم",
 "機長": "طَيَّار, قُبْطَان (اسم فاعل للمبالغة على وزن فَعَّال؛ الذي يقود الطَائِرَة سواء كانت مهنته أم لا) / نَقِيب, قُبْطَان / قَائِد, كَبْتِن\nمثال: لم توجه أبدا تهمة القيادة غير المسؤولة للطيار.",
 "機関": "مُحَرِّك, مُوتُور (اسم فاعل من حَرَّكَ؛ اسم آلة)\nمثال: المحرك لا يعمل. / فَاعِلِيَّة / وِكَالَة / وَكَالَة / دَائِرَة (في : الشكل الهندسي الذي ليس له نقطة بداية ولا نهاية ويتكون من قَوْس مستمر؛ الهيئة أو الجهة التي تدير امرا ما)\nمثال: رجاء ضع دائرة حول الجواب الصحيح. / نِظَام (مَنْهَج، طَرِيقَة؛ تَرْتِيب واتِّسَاق) / جِهَاز\nمثال: ليس بنظام كامل.",
