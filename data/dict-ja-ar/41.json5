 "片持ち": "دعمة, كابول (عارضة أفقية بارزة مثبتة من طرف واحد فقط)",
 "片持ち梁": "دعمة, كابول (عارضة أفقية بارزة مثبتة من طرف واحد فقط)",
 "片持梁": "دعمة, كابول (عارضة أفقية بارزة مثبتة من طرف واحد فقط)",
 "片方": "وَاحِد, وَاحِدَة (في وَ: العدد واحد العدد الاول) / اَلْمَرْء\nمثال: رأيت واحدة مرة.",
 "片方向相互動作": "ذُو اِتِّجَاه وَاحِد (يتحرك أو يسمح بالحركة في اتجاه واحد فقط)",
 "片方向通信": "ذُو اِتِّجَاه وَاحِد (يتحرك أو يسمح بالحركة في اتجاه واحد فقط)",
 "片時": "لَحْظَة",
 "片栗": "بنفسج سن الكلب (نبات غابات معمر يزهر في الربيع؛ يزرع على نطاق واسع)",
 "片棒かつぎ": "مُسَاهَمَة, اِشْتِرَاك (المُساهَمَة : المُشاركة والاشتراك في الشيء)\nمثال: ويستطيع الجميع المساهمة. / حَبِيب, حَبِيبَة",
 "片棒担ぎ": "مُسَاهَمَة, اِشْتِرَاك (المُساهَمَة : المُشاركة والاشتراك في الشيء)\nمثال: ويستطيع الجميع المساهمة. / حَبِيب, حَبِيبَة",
 "片片": "خفقان, رفرفة (حركة الرفرفة صعوداً وهبوطاً) / شِظْوِيّ, مُتَشَظٍّ (يتألّف من أجزاء صغيرة غير مترابطة) / تَافِه, حَقِير (صغير ولا يلفت الانتباه) / تَافِه, ضَئِيلُ الشَّأْن (ذو أهمية أو نفوذ أو سلطة قليلة؛ ذو مكانة ثانوية) / عَدِيمُ الدَّلَالَة (لا يدل على شيء) / تافه, ضئيل الشأن (خالٍ من الأهمية أو المعنى أو القوة)",
 "片田舎": "أحراش, منطقة نائية (منطقة نائية وغير متطورة)",
 "片眼鏡": "نظارة أحادية (عدسة لتصحيح الرؤية المعيبة في عين واحدة؛ تثبت في مكانها بواسطة عضلات الوجه)",
 "片秀": "ناقص-غير كامل / قَبِيح, بَشِع (ضد الحَسَن، وهو ما نَفَرَ منه الذوق السليم ويشمل القول والفعل والصورة؛ القَبَاح)\nمثال: نادتني بالقبيح.",
 "片端": "أَعْرَج, مُقْعَد (مُصَابٌ بِعَجْزٍ فِي القَدَمَيْنِ أَوِ السَّاقَيْنِ) / ناقص-غير كامل",
 "片端から": "بشكل منتظم, بشكل منهجي (بطريقة منهجية أو متسقة)\nمثال: استبعدوا النساء بشكل منهجي",
 "片結び": "عقدة منزلقة (عقدة في نهاية حبل يمكن أن تنزلق على الحبل الذي صنعت حوله)",
 "片肌脱ぐ": "مد يد العون (جذب ومطل حتى يصبح أطول او اوسع؛ بسط ووسع)\nمثال: مد سامي يده لليلى.",
 "片脳油": "زيت الكافور (زيت مقطر من راتنج الكافور)",
 "片腹痛い": "سَخِيف, مَسْخَرَة",
 "片舷斉射": "بالجانب العريض, بكامل الجانب (بجانب يواجه شيئاً ما) / رماية جانبية (إطلاق النار المتزامن لجميع الأسلحة على جانب واحد من سفينة حربية) / عَرْضِيّ (باتجاه الجانب الكامل؛ على عرض الشيء) / جانب السفينة (الجانب الكامل للسفينة من المقدمة إلى المؤخرة)\nمثال: صدم القطار الشاحنة من جانبها العريض",
 "片言": "بَقَّ ((بَقَّ) الرجل بقا: أَكثر القَوْل فِي صَوَاب أَو خطأ؛ (بَقَّ) الْمَرْأَة: كثر وَلَدهَا)\nمثال: قد غزا بق الفراش فرنسا.",
 "片貝": "بطنيات القدم (طائفة من الرخويات لها عادة صدفة ملفوفة من قطعة واحدة وقدم عضلية مسطحة ورأس يحمل عيوناً ذات سويقات) / أحادي الصدفة (يستخدم للرخويات، خاصة بطنيات القدم، مثل القواقع وغيرها)",
 "片貿易": "أُحَادِيّ الجَانِب, مِن طَرَف وَاحِد (يشمل جزءاً أو جانباً واحداً فقط) / مُتَحَيِّز, مُنْحَاز (يُفَضِّلُ شَخْصًا أَوْ طَرَفًا عَلَى آخَر) / أحادي الوجه, غير قابل للقلب (غير قابل للعكس أو لاستخدام أي من الجانبين للخارج)\nمثال: شلل أحادي الجانب",
 "片跛": "أَعْرَج / أَكْسَح / أَشَلّ ((أَشَلَّ) فلانٌ: أصَابه الشَّلَل؛ (أَشَلَّ) اللهُ فلانًا أَو يَدَهُ: أصابَها بالشَّلَل) / غَيْرُ مُتَكَافِئ ((عن مسابقة أو متنافسين) غير متكافئ كخصوم) / غير متطابق, متنافر (إما غير متطابق أو متطابق بشكل غير مناسب)",
 "片輪": "أَعْرَج, مُقْعَد (مُصَابٌ بِعَجْزٍ فِي القَدَمَيْنِ أَوِ السَّاقَيْنِ) / ناقص-غير كامل",
 "片輪走行": "تَزَلُّج",
 "片辺": "زَاوِيَة, رُكْن",
 "片道": "ذُو اِتِّجَاه وَاحِد (يتحرك أو يسمح بالحركة في اتجاه واحد فقط)",
 "片道切符": "ذُو اِتِّجَاه وَاحِد (يتحرك أو يسمح بالحركة في اتجاه واحد فقط)",
 "片道料金": "ذُو اِتِّجَاه وَاحِد (يتحرك أو يسمح بالحركة في اتجاه واحد فقط)",
 "片道航空券": "ذُو اِتِّجَاه وَاحِد (يتحرك أو يسمح بالحركة في اتجاه واحد فقط)",
 "片陰": "ظِلّ, مَظَلَّة (الإستمرار في العمل. أصله للنهار ثم أصبح يشمل النهار والليل)\nمثال: ظل الولد ساكنا.",
 "片隅": "زَاوِيَة, رُكْن",
 "片頭痛": "شَقِيقَة, صُدَاع نِصْفِي (مؤنث الشَقِيْق، وهو كل ما شُقَّ نصفين فكل من النصفين شقيق الآخر. الجمع شَقَائِق؛ مؤنث الشَقِيْق، وهو الأَخ من نفس الأُمّ والأبّ)\nمثال: هي أختي غير الشقيقة.",
 "片鱗": "جُزْء, جُزَء / دَوْر (جَعَله يَدُور؛ جَعَلَه مُدَوَّر) / اِفْتَرَقَ, تَفَارَقَ\nمثال: في أي دور تسكن؟",
 "片麻岩": "نايس (صخر متحول صفائحي مشابه للجرانيت)",
 "片麻痺": "شلل نصفي (شلل جانب واحد من الجسم)",
 "版": "طَبْعَة / طَبَق, صَحْن (جَعَلَ شيئًا يغطي شيئًا آخر بشكل كامل؛ نفَّذَ أمرًا أو خطةً عمليةً)\nمثال: هذا الطبق لذيذ.",
 "版下": "رسومات, عمل فني (صور فوتوغرافية أو تمثيلات مرئية أخرى في منشور مطبوع)\nمثال: كان الناشر مسؤولاً عن جميع الأعمال الفنية في الكتاب",
 "版元": "دَار نَشْر, نَاشِر (المحل يجمع البِنَاء والعَرَصَة. قيل سمي كذلك لدوران الناس به وعليه وحوله. يجمع على دُور؛ المنزل المَبْني. يجمع على دُور)\nمثال: إذهب إلى الدار.",
 "版図": "إِقْلِيم (مساحة مكانية معينة ومحددة تمثل الخطوط الحدودية لمنطقة جغرافية أو مناخية، أو كيان سياسي ما)",
 "版木": "طَابُوقَة",
 "版権": "حُقُوقُ النَّشْر, حُقُوقُ التَّأْلِيفِ وَٱلنَّشْر (صِيْغَةُ جَمْعٍ مُفْرَدُهَا: حق)\nمثال: الحقوق إنسانية.",
 "版権侵害": "انتهاك حقوق النشر, تعدي على حق المؤلف (انتهاك الحقوق التي يكفلها حق المؤلف)",
 "版権所有": "جَمِيع اَلْحُقُوق مَحْفُوظَة, كَافَّة اَلْحُقُوق مَحْفُوظَة",
 "版画": "قالب خشبي (نقش يتكون من كتلة من الخشب تم قطع تصميم فيها؛ تستخدم لعمل المطبوعات) / كليشيه خشبي, نقش خشبي (مطبوعة مصنوعة من نقش على الخشب)",
 "版画家": "صانع طباعة, فنان غرافيكي (فنان يصمم ويصنع المطبوعات)",
 "版行": "نشر (العمل التجاري لإصدار المواد المطبوعة للبيع أو التوزيع) / فُقْمَة / خَتْم (أنهى الشيءَ وأتمّه؛ طبع بخاتم أو ختم رسميّ)\nمثال: ختم سامي القرآن في شهر رمضان.",
 "牌": "قِرْمِيدَة, قِرْمِيد / قَرْمَدَ / مِيدَالِيَة, مِِيدَالْيَة / لوحة إعلانات (لوحة تُعلق على الحائط؛ تعرض الإعلانات) / قِرْمِيدَة, قِرْمِيد / قَرْمَدَ",
 "牌山": "حَائِط, جِدَار / سُور, سور / جِدَار, حيط",
 "牙": "نَاب (مَثَّل مكان أحد ما، كان نَائِبا عنه)\nمثال: كم يكلف ناب الفيل؟ / سِنّ, سن ((سَنَّ) السِّكِّينَ و نحْوَهُ يَسُنُّ سَنًّا: أَحَدَّهُ؛ فهو مسنون وسَنِين)\nمثال: هم في نفس السن. / عَاج (مادة ثمينة تُصنع من أنياب الفيل، وتتواجد غالبًا في قارة إفريقيا، وبعض دول شرق آسيا؛ حاليًّا، يُمنع اصطياد الفيلة من أجل أنيابها في معظم الدول) / عَاجِيّ / عَاجِيَّة",
 "牙をむく": "تشابك, متاهة (شيء مختلط أو مشوش) / زمجرة (تعبير غاضب وشرس) / زمجرة (هدير غاضب شرس)\nمثال: تشابك من اللوائح الحكومية",
 "牙を剥く": "تشابك, متاهة (شيء مختلط أو مشوش) / زمجرة (تعبير غاضب وشرس) / زمجرة (هدير غاضب شرس)\nمثال: تشابك من اللوائح الحكومية",
 "牙保": "بيت وساطة, شركة وساطة (المكان الذي يدير فيه الوسيط أعماله) / سمسرة, وساطة (عمل السمسار؛ يتقاضى رسوماً لترتيب عقد بين طرفين) / شركة سمسرة, شركة وساطة مالية (أعمال سمسار الأوراق المالية؛ تتقاضى رسوماً للعمل كوسيط بين البائع والمشتري)",
 "牙城": "حِصْن (ما يُتَحَصَّنُ به ويُمْنَع؛ كل مكان محميّ مُحرَز لا يُوصَل إليه؛ عن ما يُتَحصَّن به وإن لم يكن موضعا أو مكانا كالسلاح مثلا)\nمثال: كان هناك حصن على تلك الهضبة في يوم من الأيام.",
 "牙婆": "سِمْسَار, وَسِيط",
 "牙獐": "طرغول مائي (أكبر أنواع الطرغول؛ يعيش في المناطق المستنقعية بغرب أفريقيا)",
 "牙関緊急": "ضزز, كزاز الفك (تشنج طويل الأمد لعضلات الفك)",
 "牛": "مَوَاشٍ, مَاشِيَة / بَقَر (فتح وشق ووسّع؛ فتش عن الخفايا وكشف عنها، عرف أحوال الناس)\nمثال: أفضل لحم البقر. / لَحْم بَقَر (ما يبقى من جسم الحيوان أو الإنسان بعد إزالة الجلد الأحشاء والعظم والشحم والدم والأعصاب. يتكون أساسا من العَضَلَات؛ ما يؤكل من لحم من الحيوان والطير والسمك عامة)\nمثال: أفضل لحم البقر.",
 "牛たん": "لسان بقر (لسان البقرة يؤكل كلحم)",
 "牛の毛草": "فستوكة الغنم (تُزرع لرعي الأغنام في المناطق المرتفعة أو تستخدم كعشب للمروج)",
 "牛の舌": "وَحِيد / عَزْب / أَخْمُص, بَاطِن القَدَم / نَعْل / سَمَك مُوسَى (سَمَك جمع سَمَكَة، كما تجمع سمكة أسماك)\nمثال: سمكة ميناد ماتت",
 "牛ひき肉": "لحم بقر مفروم (لحم بقر تم فرمه)",
 "牛ふん": "جلة, روث البقر (قطعة من روث البقر المجفف)",
 "牛もも肉": "شريحة الفخذ المدورة (قطعة لحم بقر قليلة الدهن من المنطقة بين الكفل والساق)",
 "牛タン": "لسان بقر (لسان البقرة يؤكل كلحم)",
 "牛タン戦術": "إطالة النقاش, تعطيل برلماني ((قانون) تكتيك لتأخير أو عرقلة التشريع عن طريق إلقاء خطب طويلة) / معرقل تشريعي (مشرع يلقي خطابات طويلة في محاولة لتأخير أو عرقلة تشريع يعارضه)",
 "牛テール": "ذيل الثور (ذيل الماشية بعد سلخه؛ يستخدم خاصة للحساء)",
 "牛ミンチ": "لحم بقر مفروم (لحم بقر تم فرمه)",
 "牛モモ肉": "شريحة الفخذ المدورة (قطعة لحم بقر قليلة الدهن من المنطقة بين الكفل والساق)",
 "牛ロース": "شواء بقري, لحم بقر للتحمير (قطعة من لحم البقر مناسبة للتحمير)",
 "牛乳": "حَلِيب (هو اللَبَن المَحْلُوْب، أو ما لم يتغير طعمه. أصل التسمية؛ هو ما لم يَرُوْب واللَبَن هو ما رَابَ) / لَبَن (سَقَاهُ اللَبَن؛ أكل كثيرا) / حَلَبَ (الشاةَ أو البقرةَ أو الناقةَ: استخرج ما في ضرعها من لبن؛ فلانٌ للرجل: أي حَلَب ماشية الرجل نيابة عنه)\nمثال: كنت أشرب الحليب",
 "牛乳屋": "مشتقات الحليب / مَلْبَنَة / حَلِيبِيّ / لَبَنِيّ",
