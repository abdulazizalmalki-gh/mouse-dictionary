 "玉石混交": "تشكيلة, خليط (مجموعة تحتوي على تشكيلة متنوعة من أنواع الأشياء)\nمثال: كانت هناك تشكيلة كبيرة من السيارات معروضة",
 "玉石混淆": "تشكيلة, خليط (مجموعة تحتوي على تشكيلة متنوعة من أنواع الأشياء)\nمثال: كانت هناك تشكيلة كبيرة من السيارات معروضة",
 "玉砂利": "حَصَى, حَصْبَاء (الحَصَى: صِغارُ الْحِجَارَةِ، الواحدةُ مِنْهُ حَصَاة. ابْنُ سِيدَهْ: الحَصَاة مِنَ الْحِجَارَةِ مَعْرُوفَةٌ…)",
 "玉突き": "بِلْيَارْدُو",
 "玉突き台": "طاولة بلياردو (معدات ألعاب تتكون من طاولة ثقيلة تلعب عليها البلياردو)",
 "玉章": "حَرْف, حرف (طَرَف وَجَانِب وَحَدّ؛ رَمْز مخطوط أو مطبوع يقوم مقام صوت أو كلمة أو عبارة أو معنى) / رِسَالَة, مَكْتُوب\nمثال: ألف هو الحرف الأول للألف باء.",
 "玉箒": "مِكْنَسَة, مِقْشَة / كُحُول, خَمْر (سَائِلٌ لاَ لَوْنَ لَهُ، لاَذِعُ الطَّعْمِ، يُسْتَخْرَجُ مِنْ تَخْمِيرِ بَعْضِ الْمَوَادِّ، يُمْزَجُ بِالْمَشْرُوبَاتِ الرُّوحِيَّةِ…)\nمثال: أكره ذوق الكحول.",
 "玉繭": "شَرْنَقَة (غشاء واق من خيوط دقيقة تنسجه بعض الحشرات حولها كدودة القز، لتحتمي به في طَوْر من أطوار حياتها)",
 "玉菜": "مَلْفُوف, كُرُنْب",
 "玉葱": "بَصَل / بصل / بصلة / بُصَل",
 "玉藻": "عُشْب بَحْرِيّ",
 "玉虫色": "غَامِض, مُلْتَبِس (غَيْرُ يَقِينِيٍّ كَعَلَامَةٍ أَوْ دَلَالَةٍ) / حمال أوجه, غامض (مفتوح لأكثر من تفسير؛ أو ذو طبيعة أو مغزى غير مؤكد؛ أو (غالباً) يهدف إلى التضليل) / غَامِض, مُلْتَبِس (قابل للتساؤل ومفتوح للتأويل)\nمثال: بيان ملتبس",
 "玉蜀黍畑": "حقل ذرة (حقل مزروع بالذرة)",
 "玉袋": "صَفَن, كِيس اَلصَّفَن",
 "玉貝": "صدفة القمر (بطنيات قدم بحرية لها أصداف مستديرة ناعمة تشكل أبراجاً قصيرة)",
 "玉蹴り": "كُرَة اَلْقَدَم",
 "玉軸受": "رمان بلي, محمل كروي (محامل تحتوي على كرات معدنية صغيرة)",
 "玉軸受け": "رمان بلي, محمل كروي (محامل تحتوي على كرات معدنية صغيرة)",
 "玉輪": "قَمَر, قمر (الكَوْكَب الذي يدور حول الأرْض ويظهر غالبا في الليل ويعكس ضوء الشَمْس. مذكر لا يؤنث؛ أي كوكب يدور حول كوكب آخر، لا يشمل ذلك الكواكب التي تدور حول شُمُوس. مذكر لا يؤنث)\nمثال: ضوء القمر ضعيف.",
 "玉酒": "مُرْتَفِع الدَّرَجَة",
 "玉門": "أعضاء تناسلية أنثوية (أعضاء جنسية أنثوية خارجية)",
 "玉髄": "عقيق أبيض, كالسيدوني (كوارتز حليبي أو رمادي نصف شفاف إلى شفاف)",
 "玉黍": "غَلَّة / برونكل (بطني قدم بحري صالح للأكل) / بروينكل, حلزون بحري (حلزون بحري صغير صالح للأكل؛ يطهى بالبخار في النبيذ أو يخبز) / عناقية, عين البزون (عشب خشبي من العالم القديم يزرع عادة وله أزهار كبيرة وردية إلى حمراء) / عناقية, فنكا (نباتات سامة زاحفة بشكل رئيسي بزهور زرقاء)",
 "王": "مَلِك, شاه (لغة في المَالِك، وهو الذي يَمْلِكُ؛ السُلْطَان الحَاكِم الذي يملك الأَرْض والبِلاد) / مَلِك (لغة في المَالِك، وهو الذي يَمْلِكُ؛ السُلْطَان الحَاكِم الذي يملك الأَرْض والبِلاد)\nمثال: زيري ملك لنفسه. / إمبراطور مالي, بارون (رجل أعمال ثري جداً أو قوي النفوذ)\nمثال: بارون نفط / قَيْصَر, إِمْبْرَاطُور / أَمِير",
 "王位": "عَرْش, كُرْسِيّ (هو كُرْسِيّ المَلِك تحديدا؛ العَرْش: هو عَرش الرَحْمَان فوق سِدْرَة المنتهى)\nمثال: ولي العهد هو من يرث العرش.",
 "王党": "فارس ملكي (مؤيد ملكي لتشارلز الأول خلال الحرب الأهلية الإنجليزية) / ملكي (مدافع عن مبادئ الملكية)",
 "王党派": "فارس ملكي (مؤيد ملكي لتشارلز الأول خلال الحرب الأهلية الإنجليزية) / ملكي (مدافع عن مبادئ الملكية)",
 "王公": "نَبِيل, شريف (اَلذَّكِيُّ؛ اَلنَّجِيبُ) / كَرِيم, شَرِيف (نبيل النفس عزيزها ذو الخلق العالي والخير الكثير والعطاء السخي. الكَرَم يشمل مجموعة من الأخلاق أهمها العطاء؛ الجَوَاد السخيّ تحديدا)\nمثال: إنها امرأة نبيلة.",
 "王冠": "تَاج, إِكْلِيل / غِطَاء زُجَاجَة, غِطَاء قَارُورَة",
 "王后": "مَلِكَة, ملكة (مؤنث مَلِك) / وَزِير, فرزان / تفرزن\nمثال: ليحفظ الله الملكة.",
 "王国": "مَمْلَكَة, مُلْك (دَوْلَةً يَحْكُمُهَا مَلِكٌ) / مَمْلَكَة (دَوْلَةً يَحْكُمُهَا مَلِكٌ)\nمثال: نعيش في المملكة المتحدة.",
 "王太妃": "ولية العهد (وريثة أنثى ظاهرة للعرش) / زوجة ولي العهد (زوجة ولي العهد)",
 "王太子": "وَلِيّ عَهْد (مَلَكَ الأمر وقَامَ به وسيطر عليه وولي عليه ولايةَ)\nمثال: ولي العهد هو من يرث العرش.",
 "王太子妃": "ولية العهد (وريثة أنثى ظاهرة للعرش) / زوجة ولي العهد (زوجة ولي العهد)",
 "王女": "أَمِيرَة",
 "王妃": "مَلِكَة, ملكة (مؤنث مَلِك) / وَزِير, فرزان / تفرزن\nمثال: ليحفظ الله الملكة.",
 "王婿": "أمير قرين (أمير هو زوج ملكة حاكمة)",
 "王子": "أَمِير",
 "王子様": "أَمِير",
 "王室": "عَائِلَة مَلِكِيَّة (اسم فاعل من الفعل عَالَ؛ مؤنث عَائِل؛ إحدى طبقات الأنساب وهي آخرها دون الفصيلة وتشمل ثلاث أجيال من جد واحد: الجد والأبناء وأبناء الأبناء)\nمثال: هو طفل العائلة.",
 "王室カナダ騎馬警察": "شرطة الخيالة الكندية الملكية (قوة الشرطة الفيدرالية لكندا)",
 "王家": "عَائِلَة مَلِكِيَّة (اسم فاعل من الفعل عَالَ؛ مؤنث عَائِل؛ إحدى طبقات الأنساب وهي آخرها دون الفصيلة وتشمل ثلاث أجيال من جد واحد: الجد والأبناء وأبناء الأبناء)\nمثال: هو طفل العائلة.",
 "王将": "مَلِك, شاه (لغة في المَالِك، وهو الذي يَمْلِكُ؛ السُلْطَان الحَاكِم الذي يملك الأَرْض والبِلاد) / مَلِك (لغة في المَالِك، وهو الذي يَمْلِكُ؛ السُلْطَان الحَاكِم الذي يملك الأَرْض والبِلاد)\nمثال: زيري ملك لنفسه.",
 "王將": "مَلِك, شاه (لغة في المَالِك، وهو الذي يَمْلِكُ؛ السُلْطَان الحَاكِم الذي يملك الأَرْض والبِلاد) / مَلِك (لغة في المَالِك، وهو الذي يَمْلِكُ؛ السُلْطَان الحَاكِم الذي يملك الأَرْض والبِلاد)\nمثال: زيري ملك لنفسه.",
 "王座": "عَرْش, كُرْسِيّ (هو كُرْسِيّ المَلِك تحديدا؛ العَرْش: هو عَرش الرَحْمَان فوق سِدْرَة المنتهى)\nمثال: ولي العهد هو من يرث العرش. / دعم, مؤازرة (فعل تقديم الموافقة والدعم) / بطولة (مسابقة يتم فيها اختيار البطل) / بطولة (مكانة كونه بطلاً)\nمثال: دعمه القوي للمحافظين أوقعه في مشاكل مع التقدميين",
 "王手": "تَفَقُّد / كِشّ مَلِك / فَاتُورَة, حِسَاب / اِسْتَأْنَى, دَقَّقَ ((مُتَعَدٍّ بِالْبَاءِ أَوْ بِـ\"فِي\" أو بِدُونِهِمَا) تَأَنَّى، انْتَظَرَ) / كَشَّ",
 "王手をかける": "تَفَقُّد / كِشّ مَلِك / فَاتُورَة, حِسَاب / اِسْتَأْنَى, دَقَّقَ ((مُتَعَدٍّ بِالْبَاءِ أَوْ بِـ\"فِي\" أو بِدُونِهِمَا) تَأَنَّى، انْتَظَرَ) / كَشَّ / هَدَّدَ / أَنْذَرَ",
 "王手を掛ける": "تَفَقُّد / كِشّ مَلِك / فَاتُورَة, حِسَاب / اِسْتَأْنَى, دَقَّقَ ((مُتَعَدٍّ بِالْبَاءِ أَوْ بِـ\"فِي\" أو بِدُونِهِمَا) تَأَنَّى، انْتَظَرَ) / كَشَّ / هَدَّدَ / أَنْذَرَ",
 "王政": "مَلِكِيَّة",
 "王政復古": "إعادة, استرداد (استعادة الشيء مرة أخرى) / إعادة تأهيل, استعادة (فعل إعادة شيء أو شخص إلى حالة مرضية) / نموذج استعادة, نموذج ترميم (نموذج يمثل المشهد الطبيعي لعصر جيولوجي سابق أو يمثل حيواناً منقرضاً وما إلى ذلك) / عمل مرمم, قطعة مرممة (قطعة أثرية أو فنية تم ترميمها أو إعادة بنائها)\nمثال: عند إعادة الكتاب إلى صاحبه الشرعي تم توبيخ الطفل",
 "王族": "مَلَكِيَّة",
 "王朝": "سُلَالَة",
 "王様": "مَلِك, شاه (لغة في المَالِك، وهو الذي يَمْلِكُ؛ السُلْطَان الحَاكِم الذي يملك الأَرْض والبِلاد) / مَلِك (لغة في المَالِك، وهو الذي يَمْلِكُ؛ السُلْطَان الحَاكِم الذي يملك الأَرْض والبِلاد)\nمثال: زيري ملك لنفسه.",
 "王様ペンギン": "بطريق ملك (بطريق كبير في الجزر المحاذية للدائرة القطبية الجنوبية)",
 "王殺し": "قتل الملك (فعل قتل الملك) / قاتل الملك (شخص يرتكب جريمة قتل الملك)",
 "王水": "مَاء مَلَكِيّ (السائل الشفاف المعروف الذي تنشأ به الحياة، عديم اللون والرائحة والطعم عندما يكون نقيا؛ علميا فِي : جزيئة متكونة من ذرتي هيدروجين مرتبطين بذرة واحدة من الأوكسيجين)\nمثال: أنا أشرب الماء.",
 "王物": "مَلِك, شاه (لغة في المَالِك، وهو الذي يَمْلِكُ؛ السُلْطَان الحَاكِم الذي يملك الأَرْض والبِلاد) / مَلِك (لغة في المَالِك، وهو الذي يَمْلِكُ؛ السُلْطَان الحَاكِم الذي يملك الأَرْض والبِلاد)\nمثال: زيري ملك لنفسه.",
 "王立": "مَلَكِيّ, قَيْصَرِيّ",
 "王立協会": "الجمعية الملكية (جمعية إنجليزية فخرية (تم إضفاء الطابع الرسمي عليها في عام 1660 ومنحها تشارلز الثاني ميثاقاً ملكياً في عام 1662) دعمت الحكومة البريطانية من خلالها…)",
 "王立園芸協会": "عامل مطلق, هرمون مطلق (أي من عدة هرمونات تنتج في الهايبوتلاموس وتحمل إلى الغدة النخامية الأمامية حيث تحفز إطلاق هرمونات الغدة النخامية الأمامية) / روديوم (عنصر فلزي صلب أبيض من مجموعة البلاتين ويوجد في خامات البلاتين) / العامل الرايزيسي, عامل ريزوس (مستضد فصيلة الدم يمتلكه الأشخاص إيجابيو العامل الرايزيسي)",
 "王笏": "صَوْلَجَان",
 "王統": "عائلة مالكة, ملوك (الأشخاص الملكيون بشكل جماعي)\nمثال: حضر الزفاف أفراد من العائلة المالكة",
 "王者": "مَلِك, شاه (لغة في المَالِك، وهو الذي يَمْلِكُ؛ السُلْطَان الحَاكِم الذي يملك الأَرْض والبِلاد) / مَلِك (لغة في المَالِك، وهو الذي يَمْلِكُ؛ السُلْطَان الحَاكِم الذي يملك الأَرْض والبِلاد)\nمثال: زيري ملك لنفسه. / نَصِير, نَصِيرَة",
 "王蛇": "بُوَاء",
 "王道": "ملكية, مُلك (كرامة أو رتبة أو منصب الملك) / طريق ملكي, طريق ممهد (طريقة أو وسيلة مميزة وسهلة لتحقيق شيء ما)\nمثال: الطريق الممهد للنجاح",
 "王道的": "تَقْلِيدِيّ, كُلَاسِيكِيّ (يتعلق بالفترة المهمة الأولى لحضارة أو ثقافة أو مجال دراسة، إلخ) / عَرِيق, كْلَاسِيكِيّ (مَعْرُوفٌ وَمُسْتَقِرٌّ مُنْذُ زَمَنٍ طَوِيلٍ فِي الشَّكْلِ أَوِ الأُسْلُوب) / تُرَاثِيّ, كْلَاسِيكِيّ (يُعتبر من أعلى مستويات الجودة وذو أهمية وقيمة دائمتين) / كِلَاسِيكِيّ, نَمَطِيّ (من نوع معروف؛ نموذجي بشكل لافت)\nمثال: فخار صيني كلاسيكي",
 "王配": "أمير قرين (أمير هو زوج ملكة حاكمة)",
 "玖": "تِسْعَة, تسعة",
 "玩ぶ": "قَدَّرَ (قضاء الله وحكمه وما قَدَّرَه؛ مبلغ الشيء وكميتّه، بنفس معنى قَدْر) / عَلِمَ (أَدْرَكَ حقيقة الشيء) / رَفَعَ قِيمَة, زَادَ فِي قِيمَة (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ)\nمثال: خذ قدر ما تريد.",
 "玩具": "لُعْبَة, دُمْيَة (اللَعْبَة البَرْبَرية دواء عشبيّ)\nمثال: عنده لعبة يويو. / ألعوبة, لعبة (شيء مصنوع مصمم للعب به)",
 "玩具かぼちゃ": "قرع, يقطين (ضرب بشدة على شيء يَصْدُرُ منه صوت قوي؛ في سياق مجازي: أوقع الضربة أو وقع الصوت المفاجئ أو الحاد)\nمثال: توقف ذلك القرع.",
 "玩具カボチャ": "قرع, يقطين (ضرب بشدة على شيء يَصْدُرُ منه صوت قوي؛ في سياق مجازي: أوقع الضربة أو وقع الصوت المفاجئ أو الحاد)\nمثال: توقف ذلك القرع.",
 "玩具南瓜": "قرع, يقطين (ضرب بشدة على شيء يَصْدُرُ منه صوت قوي؛ في سياق مجازي: أوقع الضربة أو وقع الصوت المفاجئ أو الحاد)\nمثال: توقف ذلك القرع.",
