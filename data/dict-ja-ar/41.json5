 "木管": "آلَة نَفْخ خَشَبِيَّة (الفارسية: ماشين؛ الأوردية: مشين)\nمثال: نسى زيري الآلة.",
 "木管楽器": "آلَة نَفْخ خَشَبِيَّة (الفارسية: ماشين؛ الأوردية: مشين)\nمثال: نسى زيري الآلة.",
 "木精": "كحول الخشب, كحول ميثيلي (كحول سائل خفيف متطاير قابل للاشتعال وسام؛ يستخدم كمضاد للتجمد ومذيب ووقود)",
 "木糖": "زايلوز, سكر الخشب (سكر مستخرج من الخشب أو القش؛ يُستخدم في أطعمة مرضى السكري)",
 "木糖醇": "زايلوز, سكر الخشب (سكر مستخرج من الخشب أو القش؛ يُستخدم في أطعمة مرضى السكري)",
 "木綿": "قُطْن, قُطُن / قُطْنِي, قطن / سيمال, شجرة قطن الحرير الأحمر (شجرة قطن حرير من شرق الهند تنتج أليافاً أقل جودة من الكابوك)",
 "木綿針": "يعسوب (حشرة نحيلة الجسم غير لاسعة ذات أجنحة قزحية الألوان تكون مفرودة عند الراحة؛ تتغذى البالغات والحوريات على البعوض وما إلى ذلك) / إبرة خياطة (إبرة تستخدم في الخياطة لسحب الخيط عبر القماش)",
 "木羽": "شَظِيَّة",
 "木肌": "نَبَحَ, يَنْبَح / نُبَاح / لِحَاء",
 "木舞": "شريحة خشبية (شريط رفيع ضيق من الخشب يستخدم كدعم للجص أو لعمل الشبكات الخشبية)",
 "木苺": "فْرَامْبْوَاز",
 "木草": "خُضْرَة, عَشَابَة",
 "木莓": "فْرَامْبْوَاز",
 "木菟": "بومة قرناء (بوم كبير له خصلات أذن بارزة)",
 "木菟鳥": "بومة قرناء (بوم كبير له خصلات أذن بارزة)",
 "木葉": "شَظِيَّة / وَرَقَة, وَرَقة / صَحِيفَة",
 "木葉微塵": "أشلاء, قطع صغيرة (مجموعة من الشظايا الصغيرة تعتبر ككل)\nمثال: قُصفت برلين حتى تحولت إلى ركام",
 "木蓮": "ختمية سورية, ورد شارون (شجيرة آسيوية أو شجرة شجيرية صغيرة ذات زهور وردية أو أرجوانية أو بيضاء مبهرجة على شكل جرس وأوراق ثلاثية الفصوص عادة؛ تزرع على نطاق واسع في أمريكا…)",
 "木虱": "قمل النبات القافز (حشرة صغيرة نشطة تشبه الزيز لها أرجل خلفية متكيفة للقفز؛ تتغذى على عصارة النبات)",
 "木蝋": "شمع نباتي (مادة شمعية يتم الحصول عليها من النباتات (خاصة من جذوع بعض أنواع النخيل))",
 "木蝨": "قمل النبات القافز (حشرة صغيرة نشطة تشبه الزيز لها أرجل خلفية متكيفة للقفز؛ تتغذى على عصارة النبات)",
 "木製": "خَشَبِيّ",
 "木訥": "بَسِيطٌ سَاذَج, رِيفِيّ (بَسِيطٌ بِطَرِيقَةٍ فَجَّةٍ وَقَرَوِيّ) / بَسِيط, غَيْر مُعَقَّد (يفتقر إلى التعقيد) / غَيْرُ دُنْيَوِيّ, غَيْرُ مُتَحَضِّر (لا يعرف طرق العالم ولا يملك خبرة فيها)",
 "木谷": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "木豆": "بَازِلَّاء هِنْدِيَّة, بِسِلَّة هِنْدِيَّة",
 "木賊": "ذيل الحصان الخشن, كنباث شتوي (ذيل حصان منتصب دائم الخضرة بسيقان خشنة الحواف؛ كان يستخدم سابقاً لتنظيف الأواني)",
 "木質": "خَشَبِيّ (شَبيه بالخَشَب في الصَّلابَة أو القِوام) / حَرَجِيّ, كَثِير الأَشْجَار (غنيّ بالأشجار ووافرها) / خشبي, ليفي (مصنوع من أو يحتوي على أو يشبه الخشب)\nمثال: نباتات خشبية",
 "木質部": "نسيج الخشب",
 "木造": "خَشَبِيّ / أعمال خشبية, نجارة (حرفة النجار: صنع الأشياء من الخشب) / بُسْتَانِيّ, بُسْتَانِيَّة",
 "木造り": "أعمال خشبية, نجارة (حرفة النجار: صنع الأشياء من الخشب) / بُسْتَانِيّ, بُسْتَانِيَّة",
 "木道": "ممشى خشبي (ممشى مصنوع من ألواح خشبية؛ عادة على شاطئ البحر)",
 "木邨": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "木部": "نسيج الخشب",
 "木酢": "حمض الخليك الخشبي, خل الخشب (سائل بني محمر يتكون عند تقطير الخشب ويحتوي على حمض الخليك والميثانول والأسيتون وزيوت الخشب والقطران)",
 "木醋": "حمض الخليك الخشبي, خل الخشب (سائل بني محمر يتكون عند تقطير الخشب ويحتوي على حمض الخليك والميثانول والأسيتون وزيوت الخشب والقطران)",
 "木野村": "اسم مكان (الاسم الذي يُعرف به مكان جغرافي) / لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "木鋏": "مقص تقليم, مقص شجر (مقص بشفرات قوية يستخدم للتقليم الخفيف للنباتات الخشبية)",
 "木鐸": "قَائِد, زَعِيم",
 "木陰": "عريشة (هيكل يدعم النباتات المتسلقة)\nمثال: وفرت العريشة مكاناً ظليلاً للراحة في الحديقة",
 "木霊": "صَدًى",
 "木靴": "سابو, قبقاب خشبي (حذاء منحوت من كتلة واحدة من الخشب)",
 "木食い虫": "خنفساء اللحاء (خنفساء صغيرة تحفر أنفاقاً في لحاء وخشب الأشجار؛ قريبة من السوس)",
 "木食虫": "خنفساء اللحاء (خنفساء صغيرة تحفر أنفاقاً في لحاء وخشب الأشجار؛ قريبة من السوس)",
 "木香ばら": "ورد بانكسيا (ورد متسلق دائم الخضرة صيني ذو زهور مفردة صفراء أو بيضاء)",
 "木香バラ": "ورد بانكسيا (ورد متسلق دائم الخضرة صيني ذو زهور مفردة صفراء أو بيضاء)",
 "木香茨": "ورد بانكسيا (ورد متسلق دائم الخضرة صيني ذو زهور مفردة صفراء أو بيضاء)",
 "木香薔薇": "ورد بانكسيا (ورد متسلق دائم الخضرة صيني ذو زهور مفردة صفراء أو بيضاء)",
 "木馬": "حصان خشبي, حصان هزاز (لعبة أطفال تتكون من حصان مقلد مثبت على زلاجات؛ يمتطيه الطفل ويتظاهر بالركوب) / حصان القفز, حصان طويل (حصان جمباز بدون مقابض وبطرف ممدود؛ يستخدم طولياً للقفز) / حِصَان, فَرَس (الواحد الذكر من الخَيْل؛ يطلق مجازًا على الواحد من الخيل الذي لا يُعرف ذكر كان أم أنثى)\nمثال: لم يشفى الحصان.",
 "木髄": "نُخَاع",
 "木麒麟": "عنب الثعلب البربادوسي (فاكهة صغيرة صفراء إلى برتقالية لصبار عنب الثعلب البربادوسي) / بيرسكية شائكة, عنب الثعلب البربادوسي (متسلق خشبي من جزر الهند الغربية ذو سيقان شائكة والعديد من الزهور البيضاء العطرة في نورات عنقودية تليها ثمار صفراء إلى برتقالية صغيرة)",
 "木麻黄": "خشب اللحم (شجرة تنتج خشباً محمراً ثقيلاً صلباً) / خشب البقر المقشر (شجرة أو شجيرة طويلة ذات أوراق لامعة وخيمات من الزهور البيضاء الكريمية العطرة؛ تنتج خشباً محمراً ثقيلاً صلباً) / خشب البقر (أي من عدة أشجار أسترالية من جنس كزوارينا تنتج خشباً أحمر صلباً ثقيلاً يستخدم في النجارة) / خشب اللحم (أي من العديد من الأخشاب المحمرة الصلبة الثقيلة الاستوائية بشكل رئيسي؛ يستخدم بعضها للخزائن)",
 "木鼠": "سِنْجَاب",
 "未": "خَرُوف / ضَأْن / غَنَم / شاء (أَرَادَ) / حَمَل (رَفَعَ، أَقَلَّ) / خروف\nمثال: إن شاء الله ؛ / باتجاه الجنوب الجنوب الغربي (إلى أو نحو أو في الجنوب الجنوب الغربي) / لَمْ ؛ حَتَّى الْآنَ, لَمْ ؛ بَعْدُ (جَمَعَ، ضَمَّ)\nمثال: لم يساعدني أحد.",
 "未だ": "سَاكِن, ثَابِت / سَاكِنًا / لَا يَزَال, مَا زَالَ (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها) / رَغِم ذٰلِك, مَعَ ذٰلِك ((رَغَمَ) رَغْمًا، ومَرْغَمًا، ومَرْغَمَةً: ذَلَّ؛ (رَغَمَ) ذل عن كَرْه. يقال (رغَمَ) أَنْفُه)\nمثال: لا أحب المدرسة. / بَعْد (يدل على اللحاق في الزمان؛ يكون مضافا، وينصب أو يجر)\nمثال: و بعد قليل أتى. / أَكْثَر / عَلَى اَلْأَقَلّ (يفيد الاستعلاء؛ يفيد التعليل) / عَلَى الأَقَلِّ (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال.",
 "未だ…ず": "لَمْ ؛ حَتَّى الْآنَ, لَمْ ؛ بَعْدُ (جَمَعَ، ضَمَّ)",
 "未だかつて": "أَبَدًا",
 "未だし": "سَابِقٌ لِأَوَانِه, مُبْتَسَر (مبكّر بشكل غير مألوف أو قبل الوقت المتوقّع) / مُتَسَرِّع, مُسْتَعْجَل (أبكر ممّا ينبغي أو أكثر تسرّعاً من اللازم) / سابق لأوانه, مبتسر (ولد بعد فترة حمل أقل من الوقت الطبيعي)\nمثال: رضيع مبتسر",
 "未だしも": "بِالْأَحْرَى",
 "未だに": "سَاكِن, ثَابِت / سَاكِنًا / لَا يَزَال, مَا زَالَ (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها) / رَغِم ذٰلِك, مَعَ ذٰلِك ((رَغَمَ) رَغْمًا، ومَرْغَمًا، ومَرْغَمَةً: ذَلَّ؛ (رَغَمَ) ذل عن كَرْه. يقال (رغَمَ) أَنْفُه)\nمثال: لا أحب المدرسة.",
 "未セク": "لَمْ ؛ حَتَّى الْآنَ, لَمْ ؛ بَعْدُ (جَمَعَ، ضَمَّ)\nمثال: لم يساعدني أحد.",
 "未チェック": "جَامِح, مُنْفَلِت (غير مكبوح أو غير مسيطَر عليه)",
 "未上場": "غير مُدرج (غير موجود في قائمة) / غَيْرُ مُدْرَجٍ (لم يُدرج اسمه في قائمة الناخبين)\nمثال: رقم هاتف غير مدرج",
 "未了": "غير مكتمل, غير منتهٍ (لم يتم الانتهاء منه أو اختتامه) / غير تام الصنع, غير جاهز (لم يتم إيصاله للحالة النهائية المطلوبة) / خَامّ, غَيْرُ مَطْلِيّ (يَفْتَقِرُ إِلَى تَشْطِيبٍ سَطْحِيٍّ كَالطِّلَاء)\nمثال: أعمال غير منتهية",
 "未亡人": "أَرْمَلَة",
 "未使用": "عَاطِل, غَيْر مُسْتَخْدَم (ليس قيد الاستخدام الفعليّ) / جَدِيد, غَيْر مُسْتَعْمَل (نظيف لأنّه لم يُستخدَم من قبل) / غَيْر مُسْتَخْدَم (لم يُوضَع قيد الاستعمال بعد)",
 "未信者": "وَثَنِيّ / وَثَنِيّ, وَثَنِيَّة",
 "未入力": "خَالٍ, اَلْخَالِي (بمعنى ظَنَّ، استخدام نادر والأغلب استخدام خَيْل أو مَخَالَة؛ أخو الأم. جمعه أخوال للمذكر وخالات للمؤنث)\nمثال: عندي ابنا خالة.",
 "未公表": "غَيْر مَنْشُور (غير منشور)\nمثال: رسائل ومذكرات غير منشورة",
 "未公開": "غَيْر مَنْشُور (غير منشور)\nمثال: رسائل ومذكرات غير منشورة",
 "未公開株": "سهم خارج المقصورة, سهم غير مدرج (سهم غير مدرج ومتداول في بورصة منظمة)",
 "未処分": "غَيْرُ مُسْتَوْطَن (لم يُسْتَوطَن بعد) / غير مستقر (غير مستقر أو مؤسس) / غير محسوم, معلق (لا يزال موضع شك) / غَيْرُ مُسْتَقِرّ, مُتَحَوِّل (عُرْضَةٌ لِلتَّغَيُّر)\nمثال: نمط حياة غير مستقر",
 "未処理": "غَيْر مُعَالَج (لم يُعالَج بمادّة كيميائيّة أو فيزيائيّة أو بيولوجيّة) / غير معالج (لم يخضع لمعالجة كيميائية أو فيزيائية) / غير معالج (لم يتلق رعاية أو علاجاً طبياً)\nمثال: نسيج غير معالج",
 "未処置": "غَيْر مُعَالَج (لم يُعالَج بمادّة كيميائيّة أو فيزيائيّة أو بيولوجيّة) / غير معالج (لم يخضع لمعالجة كيميائية أو فيزيائية) / غير معالج (لم يتلق رعاية أو علاجاً طبياً)\nمثال: نسيج غير معالج",
 "未出": "غَيْر مَنْشُور (غير منشور)\nمثال: رسائل ومذكرات غير منشورة",
 "未分化": "غير متمايز, متجانس (غير متمايز)",
 "未刊": "غَيْر مَنْشُور (غير منشور)\nمثال: رسائل ومذكرات غير منشورة",
 "未刊行": "غَيْر مَنْشُور (غير منشور)\nمثال: رسائل ومذكرات غير منشورة",
 "未到": "بَعِيد المَنَال, لَا يُمكِن الوُصُول إِلَيْه (يقع في مكان يتعذّر الوصول إليه)",
 "未加工": "خَام, غَيْر مُعَالَج (لَمْ يُعَالَج أَوْ يُحَضَّر بِعَمَلِيَّة خَاصَّة) / خام, غير معالج (غير مغير عن حالته الأصلية أو الطبيعية) / خام, غير مكرر (غير مكرر أو معالج)\nمثال: سلع أولية (غير مصنعة)",
 "未収": "مُتَرَاكِم, مُسْتَحَقّ (يتراكم دورياً مع مرور الوقت)",
 "未収入金": "حِسَاب مَدِين (بمعنى عَدَّ وجَمَعَ وطَرَحَ كلها معا. جمعه حُسْبَان؛ الاسم من المُحَاسَبَة، لأن فيه تُحسب المحاسن والأخطاء)\nمثال: الحساب لو سمحت.",
 "未収載": "غير مُدرج (غير موجود في قائمة) / غَيْرُ مُدْرَجٍ (لم يُدرج اسمه في قائمة الناخبين)\nمثال: رقم هاتف غير مدرج",
 "未回答": "بِلَا مُقَابِلٍ, غَيْرُ مَرْدُودٍ (لا يُرَدُّ بالمثل)",
 "未墾": "سَطْحِيّ, غَيْرُ مُثَقَّف (يتصف بعدم التهذيب الثقافي أو افتقار الذوق الفكري) / بور, غير مزروع ((للأرض أو الحقول) غير معدة لزراعة المحاصيل) / سَاذَجٌ, غَيْرُ مُثَقَّفٍ ((عن الأشخاص) يفتقر إلى الثقافة أو المعرفة)",
 "未婚": "أعزب, غير متزوج (غير متزوج أو يتعلق بحالة العزوبية)\nمثال: رجال ونساء غير متزوجين",
 "未完": "غير مكتمل, ناقص (غير كامل أو غير كلي؛ لم يتم إنجازه) / غَيْرُ مُكْتَمِل, نَاقِص (لَمْ يَكْتَمِلْ بَعْدُ)\nمثال: سرد غير مكتمل لحياته",
 "未完了": "غير مكتمل, ناقص (غير كامل أو غير كلي؛ لم يتم إنجازه) / غَيْرُ مُكْتَمِل, نَاقِص (لَمْ يَكْتَمِلْ بَعْدُ)\nمثال: سرد غير مكتمل لحياته / ناقص-غير كامل",
 "未完成": "غير مكتمل, ناقص (غير كامل أو غير كلي؛ لم يتم إنجازه) / غَيْرُ مُكْتَمِل, نَاقِص (لَمْ يَكْتَمِلْ بَعْدُ)\nمثال: سرد غير مكتمل لحياته",
