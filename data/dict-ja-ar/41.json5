 "未就学": "روضة أطفال, مرحلة ما قبل المدرسة (مؤسسة تعليمية للأطفال الصغار جداً على المدرسة الابتدائية)",
 "未届け": "غَيْر مُبَلَّغ عَنْه (لم يتم الإبلاغ عنه)\nمثال: نتائج غير مبلغ عنها",
 "未成": "غَيْرُ مُلْتَقَط, غَيْرُ مُنْجَز (لم يُلتقَط أو لم يُلتقَط داخل الحدود المسموحة)",
 "未成年": "أَقَلِّيَّة\nمثال: 君は未成年だから入れません。 — ليس بإمكانك الدخول لأنك قاصر.",
 "未成年者": "صَغِير, مَحْدُود النِّطَاق (صَغير الحَجْم أَوْ مَحْدود في النِّطاق أَوْ الأَهَمِّيَّة)\nمثال: حصة صغيرة من الأرباح",
 "未成熟": "عدم نضج (عدم الوصول إلى النضج)",
 "未払": "بلا أجر, غير مدفوع (لم يتم الدفع له)\nمثال: أجور غير مدفوعة",
 "未払い": "بلا أجر, غير مدفوع (لم يتم الدفع له)\nمثال: أجور غير مدفوعة",
 "未払い金": "متأخرات (دين غير مدفوع تجاوز موعد استحقاقه)\nمثال: حساب عليه متأخرات",
 "未払金": "متأخرات (دين غير مدفوع تجاوز موعد استحقاقه)\nمثال: حساب عليه متأخرات",
 "未接種": "غَيْر مُطَعَّم, غَيْر مُلَقَّح (لم يتلقَّ التطعيم)",
 "未教育": "غير مدرب (غير منضبط أو مكيف أو ماهر بسبب التدريب)\nمثال: صوت غير مدرب",
 "未整理": "قَيْدَ الِانْتِظَار, مُعَلَّق (فِي انْتِظَارِ الِاخْتِتَامِ أَوِ التَّأْكِيدِ)",
 "未晒": "غَيْر مَصْبُوغ, غَيْر مُبَيَّض (لم يُلوَّن أو يُبيَّض صناعيًّا)",
 "未晒し": "غَيْر مَصْبُوغ, غَيْر مُبَيَّض (لم يُلوَّن أو يُبيَّض صناعيًّا)",
 "未曽有": "غَيْر مَسْبُوق (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "未曾有": "غَيْر مَسْبُوق (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "未来": "مُسْتَقْبَل",
 "未来予知": "تنبؤ, معرفة مسبقة (معرفة حدث قبل وقوعه)",
 "未来型": "مستقبلي (من أو يتعلق بالمستقبلية (حركة فنية))\nمثال: فن مستقبلي",
 "未来学": "استشراف المستقبل, علم المستقبليات (دراسة أو التنبؤ بالتطورات المستقبلية بناءً على الظروف الحالية)",
 "未来学者": "مستقبلي (من أو يتعلق بالمستقبلية (حركة فنية))\nمثال: فن مستقبلي",
 "未来完了": "مستقبل تام (زمن تام يُستخدم لوصف حدث سيكتمل في المستقبل)",
 "未来形": "مُسْتَقْبَل",
 "未来時制": "مُسْتَقْبَل",
 "未来永劫": "إلى الأبد, دائماً وأبداً (في أي وقت في المستقبل؛ مستقبلاً وبشكل دائم)\nمثال: عش حياة خالية من اللوم إلى الأبد",
 "未来派": "مستقبلية (الموقف القائل بأن معنى الحياة يجب أن يُلتمس في المستقبل)",
 "未来的": "مستقبلي (من أو يتعلق بالمستقبلية (حركة فنية))\nمثال: فن مستقبلي",
 "未来進行形": "مستقبل مستمر (زمن مستمر يُستخدم للتعبير عن حدث سيكون مستمراً في المستقبل)",
 "未決": "قَيْدَ الِانْتِظَار, مُعَلَّق (فِي انْتِظَارِ الِاخْتِتَامِ أَوِ التَّأْكِيدِ)",
 "未決定": "غَيْر مَحْسُوم (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "未決済": "لَافِت, مُلْفِتٌ لِلنَّظَرِ (لَهُ صِفَةٌ تَفْرِضُ نَفْسَهَا عَلَى الِانْتِبَاهِ)",
 "未決算": "لَافِت, مُلْفِتٌ لِلنَّظَرِ (لَهُ صِفَةٌ تَفْرِضُ نَفْسَهَا عَلَى الِانْتِبَاهِ)",
 "未消化": "غَيْر مَهْضوم (لَمْ يَتِمّ هَضْمُه بَعْد) / غَيْر مُتَحَقِّق, غَيْر مُنْجَز ((للأشخاص) يتميز بالفشل في تحقيق كامل إمكاناته)",
 "未済": "غير مكتمل, غير منتهٍ (لم يتم الانتهاء منه أو اختتامه)\nمثال: أعمال غير منتهية / بلا أجر, غير مدفوع (لم يتم الدفع له)\nمثال: أجور غير مدفوعة",
 "未満": "أَصْغَر مِن, صُغْرَى مِن",
 "未然": "سلفاً, مسبقاً (قبل الوقت؛ تحسباً)\nمثال: عندما تدفع مقدماً تحصل على خصم",
 "未然防止": "مَنْع (حَرَمَ، ضد أَعْطَى؛ كَفَّ عنه وحَمَاه)\nمثال: تساهم جذور أشجار المنغروف في منع حدوث انجراف التربة.",
 "未熟": "غير ناضج, فج (غير مكتمل النمو أو النضج؛ غير يانع)\nمثال: فاكهة غير ناضجة / غير مكسو بالريش, غير ناضج ((عن الطيور) لم تطور ريشاً بعد)\nمثال: عصفور صغير غير مكسو بالريش على حافة النافذة",
 "未熟児": "طفل خديج, طفل مبتسر (رضيع يولد قبل 37 أسبوعاً من الحمل)",
 "未熟練": "عَدِيم المَهَارَة, غَيْر كُفْء (لا يؤدي العمل بشكل جيد؛ يفتقر إلى الكفاءة)\nمثال: غير ماهر في فن البلاغة",
 "未熟者": "بريء, قليل الخبرة (شخص يفتقر إلى معرفة الشر)",
 "未生": "جنيني, غير مولود (لم يولد بعد)\nمثال: أجيال لم تولد بعد",
 "未申": "باتجاه الجنوب الغربي (إلى أو نحو أو في الجنوب الغربي)",
 "未申告": "غير معلن (غير مصرح به أو معترف به علانية)\nمثال: خوض حرب غير معلنة",
 "未病": "اعتلال الصحة, توعك (حالة تعجز فيها عن العمل بشكل طبيعي وبدون ألم) / قبل الأعراض, ما قبل السريري (مكون من أو متعلق بالمراحل المبكرة من المرض عندما لا يكون التشخيص الدقيق ممكناً…)",
