 "業務上過失": "إهمال, تقصير (الفشل في التصرف بالحكمة التي يمارسها الشخص العاقل في نفس الظروف)",
 "業務命令": "تَرْتِيب, نِظَام (تنظيم الأشياء أو الأحداث في تسلسل معين أو وضعها في نظام؛ إعداد أو تجهيز شيء…)\nمثال: أعاد زيري ترتيب المطبخ كلية.",
 "業務執行": "إِدَارَة (هو عملية تولي تَصْرِيف شؤون العَمَل. لا جمع له؛ مجموع الناس الذين يقومون بإدارة…)\nمثال: والدتي تنتظرني في الإدارة.",
 "業務委託": "عقد من الباطن (عقد يسند إلى طرف آخر بعض التزامات عقد سابق)",
 "業務日誌": "دفتر السجل, سجل الوقائع (كتاب يُكتب فيه السجل)",
 "業務的": "مُنَظَّم, مِهَنِيّ (يُظهر خصائص منهجية ومنظّمة تُفيد في العمل التجاري)",
 "業務補助": "تدريب طبي, فترة الامتياز (منصب المتدرب الطبي (طبيب امتياز))",
 "業務遂行": "أداء, تنفيذ (فعل الأداء؛ القيام بشيء بنجاح؛ استخدام المعرفة بدلاً من مجرد امتلاكها)\nمثال: انتقدوا أداءه كرئيس للبلدية",
 "業因": "كَارْمَا",
 "業報": "قِسْمَة, مَصِير (في : هو أن أحد العمليات الحسابية الرئيسية، ضد الضَرْب)\nمثال: الزواج قسمة و نصيب.",
 "業態": "مجال, ميدان عمل (نوع معين من المؤسسات التجارية)\nمثال: هم متميزون في مجالهم",
 "業火": "نَارُ جَهَنَّم (نارَتِ النارُ: أضاءَت؛ نَارَ النَّارَ مَنْ بَعِيدٍ : أَبْصَرَهَا، نَظَرَ…)\nمثال: سمعن طلقات نار.",
 "業界": "صِنَاعَة (إيجاد الشيء وخَلْقُه؛ (استخدام حديث) قطاع اقتصادي)\nمثال: هذا البلد مدعوم بالصناعة.",
 "業界アナリスト": "محلل صناعي (محلل للظروف التي تؤثر على صناعة معينة)",
 "業界用語": "كَلِمَة طَنَّانَة, مُصْطَلَح رَائِج (عبارات مخزنة أصبحت بلا معنى بسبب التكرار اللامتناهي)",
 "業突く張り": "عِنَاد / بَخِيل, بَخِيلَة (الجمع : بُخَلاءُ ، المؤنث : بخيلة ، و الجمع للمؤنث : بخيلات و بُخَلاءُ…)\nمثال: بئس الرجل البخيل.",
 "業突張り": "عِنَاد / بَخِيل, بَخِيلَة (الجمع : بُخَلاءُ ، المؤنث : بخيلة ، و الجمع للمؤنث : بخيلات و بُخَلاءُ…)\nمثال: بئس الرجل البخيل.",
 "業績": "إِنْجَاز",
 "業績主義": "حكم الجدارة, ميريتوقراطية (الاعتقاد بأن الحكام يجب أن يتم اختيارهم لقدراتهم المتفوقة وليس بسبب ثروتهم أو…)",
 "業績悪化": "تراجع, ركود (تدهور في النشاط التجاري أو الاقتصادي)\nمثال: شهد السوق ركوداً",
 "業者": "بَائِع, تَاجِر",
