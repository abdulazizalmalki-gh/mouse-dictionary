 "果物": "فَاكِهَة (الثمار كلها؛ ما يتنعم بأكله رطبا كان أم يابسا كالتين واللوز والرمان ونحوها)\nمثال: التفاح فاكهة لذيذة.",
 "果物ナイフ": "سكين تقشير (سكين حاد صغير يستخدم في تقشير الفواكه أو الخضروات)",
 "果物屋": "بائع فاكهة, فاكهاني (شخص يبيع الفاكهة)",
 "果物時計草": "ثَمَرَة زَهْرَة اَلْآلَام, فَاكِهَة زَهْرَة اَلْآلَام",
 "果物畑": "بُسْتَان, بَيَارَة (أَرْض يحيطها سُوْر وفيها نخيل متفرقة وأعناب وأشجار، تستخدم في الأساس للحصول على…)\nمثال: أحب سقي البستان.",
 "果皮": "جِدَارُ الثَّمَرَة, غِلافُ الثَّمَرَة (الجدران الناضجة والمتحورة لمبيض النبات) / هدورة, جلدة\nمثال: سلخ زيري ذلك الغزال.",
 "果粒": "لب (الجزء الداخلي الرخو للسن)\nمثال: سحقه حتى أصبح لباً / تُوت, حَبَّة",
 "果糖": "سكر الفاكهة, فركتوز (سكر بسيط يوجد في العسل وفي العديد من الفواكه الناضجة)",
 "果肉": "لَحْمٌ (ما يبقى من جسم الحيوان أو الإنسان بعد إزالة الجلد الأحشاء والعظم والشحم والدم…)\nمثال: أفضل لحم البقر.",
 "枝": "فَرْع, غُصْن",
 "枝つき燭台": "شمعدان (حامل شموع متفرع؛ مزخرف؛ يحتوي على عدة مصابيح)",
 "枝の主日": "أحد الشعانين (الأحد الذي يسبق عيد الفصح)",
 "枝むち": "عصا البتولا (عصا تتكون من غصن أو حزمة من أغصان شجرة البتولا؛ تستخدم لضرب الناس كعقاب)\nمثال: والدي لم يتوانَ قط عن استخدام عصا البتولا",
 "枝付き燭台": "شمعدان (حامل شموع متفرع؛ مزخرف؛ يحتوي على عدة مصابيح)",
 "枝分かれ": "تشعب, تفرع (عملية التفرع أو الانقسام إلى فروع)\nمثال: كان لقرار المحكمة تداعيات عديدة غير متوقعة",
 "枝切り": "تقليم (عملية تشذيب النبات)",
 "枝刈り": "تقليم (عملية تشذيب النبات)",
 "枝垂れかんば": "بتولا بيضاء أوروبية, بتولا فضية (بتولا أوروبية بلحاء أبيض فضي مقشر وفروع متدلية بشكل ملحوظ)",
 "枝垂れる": "تدلي, ترهل (شكل يتدلى أو يهبط للأسفل)\nمثال: كان هناك هبوط في مقعد الكرسي",
 "枝垂れ柳": "صفصاف بابلي, صفصاف باكي (صفصاف ذو فروع طويلة متدلية وأوراق رفيعة موطنه الصين؛ يزرع على نطاق واسع كنبات…)",
 "枝垂れ樺": "بتولا بيضاء أوروبية, بتولا فضية (بتولا أوروبية بلحاء أبيض فضي مقشر وفروع متدلية بشكل ملحوظ)",
 "枝尺": "عثة هندسية (عثة نحيلة الجسم عريضة الأجنحة تسمى يرقاتها الديدان القياسية)",
 "枝打ち": "تقليم (عملية تشذيب النبات)",
 "枝折": "علامة قراءة, فاصل كتب (علامة (قطعة من الورق أو شريط) توضع بين صفحات الكتاب لتحديد مكان القراءة) / دليل سياحي, مرشد (شيء يقدم معلومات أو تعليمات أساسية)",
 "枝折り": "علامة قراءة, فاصل كتب (علامة (قطعة من الورق أو شريط) توضع بين صفحات الكتاب لتحديد مكان القراءة) / دليل سياحي, مرشد (شيء يقدم معلومات أو تعليمات أساسية)",
 "枝折り戸": "باب صغير, بويب (بوابة أو باب صغير (خاصة الذي يكون جزءاً من باب أكبر))",
 "枝折戸": "باب صغير, بويب (بوابة أو باب صغير (خاصة الذي يكون جزءاً من باب أكبر))",
 "枝振り": "تشعب, تفرع (عملية التفرع أو الانقسام إلى فروع)",
 "枝族": "قَبِيلَة, عَشِيرَة (ما دون الشَعْب وفوق العَمَارَة في تقسيم الناس؛ مجموعة كبيرة من الناس ينحدرون من…)\nمثال: انضم جوناس لقبيلة ريمة.",
 "枝木": "فَرْع, غُصْن",
 "枝条": "فَرْع, غُصْن",
 "枝毛": "جناح متباعد ((كرة القدم الأمريكية) لاعب هجومي يصطف على مسافة من لاعبي الخط الآخرين)",
 "枝狩り": "تقليم (عملية تشذيب النبات)",
 "枝線": "خط فرعي (خط سكة حديد متصل بخط رئيسي)",
 "枝葉": "زخرفة ورقية ((في العمارة) زخرفة معمارية تشبه الأوراق) / عَرَضِيّ, هَامِشِيّ (ليس ذا أهمية مركزية أو أوّلية)\nمثال: تخلصوا من جميع الأشياء غير الضرورية",
 "枝葉末節": "ثانوي, غير أساسي (ليس أساسياً أو جوهرياً)\nمثال: تخلصوا من جميع الأشياء غير الضرورية",
 "枝角": "قَرْن الْأَيِّل (مصدر للفعل قَرَنَ؛ القوم يعيشون سوية فترة طويلة جذا من الزمن، أو هو الفترة…)\nمثال: هذه الشجرة عمرها أكثر من قرن.",
 "枝角羚羊": "ظبي أمريكي, وعل شوكي القرون (مجتر سريع يشبه الظبي من سهول غرب أمريكا الشمالية ذو قرون صغيرة متفرعة)",
 "枝道": "طريق جانبي, طريق فرعي (طريق جانبي قليل الاستخدام (كما في الريف)) / انحراف عن المسار, خروج عن الطريق (الابتعاد عن المسار الرئيسي للرحلة)\nمثال: تحويل عن الطريق السريع الرئيسي",
 "枝野": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "枝隊": "فصل, فك الارتباط (عملية التحرير من مرفق أو اتصال)",
 "枝鞭": "عصا البتولا (عصا تتكون من غصن أو حزمة من أغصان شجرة البتولا؛ تستخدم لضرب الناس كعقاب)\nمثال: والدي لم يتوانَ قط عن استخدام عصا البتولا",
 "枠": "أَطَّرَ ((أَطَّرَ) الشَّيْء: أَطَرَهُ)\nمثال: دهنت أطر النافذة بالأصفر. / حَدّ, حُدُود (مُنْتَهى الشيءِ؛ الْفَصْلُ بَيْنَ الشَّيْئَيْنِ لِئَلَّا يَخْتَلِطَ أَحدهما…)\nمثال: أعرفها إلى حد ما. / حَدّ (مُنْتَهى الشيءِ؛ الْفَصْلُ بَيْنَ الشَّيْئَيْنِ لِئَلَّا يَخْتَلِطَ أَحدهما…)\nمثال: أعرفها إلى حد ما. / فِئَة (هي الجماعة المُتَظَاهِرَة التي يرجع بعضها إلى بعض في التعاضد؛ هي الطائفة…)\nمثال: سأقدم طلبي في إطار فئة أخرى.",
 "枠を付ける": "أَطَّرَ ((أَطَّرَ) الشَّيْء: أَطَرَهُ)\nمثال: دهنت أطر النافذة بالأصفر.",
 "枠外": "حَدّ (مُنْتَهى الشيءِ؛ الْفَصْلُ بَيْنَ الشَّيْئَيْنِ لِئَلَّا يَخْتَلِطَ أَحدهما…)\nمثال: أعرفها إلى حد ما.",
 "枠組": "أَطَّرَ ((أَطَّرَ) الشَّيْء: أَطَرَهُ)\nمثال: دهنت أطر النافذة بالأصفر. / إطار, هيكل (هيكل يدعم أو يحتوي على شيء ما)\nمثال: توفير إطار عمل واقعي للبحث المستقبلي",
 "枠組み": "أَطَّرَ ((أَطَّرَ) الشَّيْء: أَطَرَهُ)\nمثال: دهنت أطر النافذة بالأصفر. / إطار, هيكل (هيكل يدعم أو يحتوي على شيء ما)\nمثال: توفير إطار عمل واقعي للبحث المستقبلي",
 "枡": "قِيَاس\nمثال: قاس طول السرير. / صُنْدُوق, صَنْدُوق (وعاء كبيرة من الخشب غالبا وقد يكون حديدًا يستخدم لوضع الاشياء داخله، ويكون لها…)\nمثال: أين صندوق البريد؟",
 "枡山": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "枡形": "مُرَبَّع (كُلُّ ما يُرَبَّعُ؛ كُلُّ ما له أربعة أركانٍٍ)",
 "枡田": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "枡目": "قِيَاس\nمثال: قاس طول السرير. / مُرَبَّع (كُلُّ ما يُرَبَّعُ؛ كُلُّ ما له أربعة أركانٍٍ) / صُنْدُوق, صَنْدُوق (وعاء كبيرة من الخشب غالبا وقد يكون حديدًا يستخدم لوضع الاشياء داخله، ويكون لها…)\nمثال: أين صندوق البريد؟",
 "枢": "أَبْوَاب, بَاب",
 "枢密": "سِرّ دَوْلَة (شَعَرَ بِالسُّرُورِ)\nمثال: السر سيبقى سرا.",
 "枢密院": "المجلس الخاص (مجلس استشاري للحاكم (خاصة للتاج البريطاني))",
 "枢戸": "أَبْوَاب, بَاب",
 "枢機卿": "كارْدِينال, كَرْدِينَال",
 "枢要": "مُهِمّ",
 "枢軸": "إكس, مِحْوَر (عمود تدور عليه العجلة) / مَرْكَز (موضع الاِرْتِكَاز عامة؛ موضع الشخص ومحلّه الذي يبقى فيه عادة)\nمثال: أين أقرب مركز شرطة؟ / مِحْوَر",
 "枢軸側": "قوة التحلف (ضد الضُعْف، الشِدَّة والقُدْرَة الجِسْمَانِيَّة؛ ضد الضُعْف، المَقْدِرَة…)",
 "枢軸国": "قوة التحلف (ضد الضُعْف، الشِدَّة والقُدْرَة الجِسْمَانِيَّة؛ ضد الضُعْف، المَقْدِرَة…)\nمثال: توم شعر بالقوة.",
 "枯らす": "قَتَلَ, قتل (تعمّد جعله يَمُوتُ، أزهق روحه، أمَاتَه متعمدا؛ الوقتَ: ضيعه بشيء غير ذي فائدة…)\nمثال: قتل الصياد دبا.",
 "枯れる": "صَعَقَ / نَاضِج, رَاشِد",
 "枯れ枯れ": "ذَابِل, مُتَجَعِّد (نَحِيل وَمُتَجَعِّد بِسَبَب الانْكِمَاش مِنَ الشَّيْخُوخَة أَوِ المَرَض)",
 "枯れ草": "تِبْن, جَفِيف (تبَنَ الدابة: عَلَفها تبنًا)\nمثال: لم تبن روما في يوم.",
 "枯れ葉剤": "مزيل الأوراق, مسقط الأوراق (مادة كيميائية تُرش على النباتات وتتسبب في تساقط أوراقها)",
 "枯れ葉色": "بني مصفر, كراميل (لون أسمر متوسط إلى داكن)",
 "枯槁": "مُبِيد, مُدَمِّر (يَتَسَبَّبُ أَوْ يَقْدِرُ عَلَى التَّدْمِيرِ الكَامِلِ) / ضمور (انخفاض في حجم عضو ناتج عن مرض أو عدم الاستخدام)",
 "枯死": "مُبِيد, مُدَمِّر (يَتَسَبَّبُ أَوْ يَقْدِرُ عَلَى التَّدْمِيرِ الكَامِلِ)",
 "枯渇": "تتجفاف, تجفيف (عملية استخلاص الرطوبة)",
 "枯燥": "تتجفاف, تجفيف (عملية استخلاص الرطوبة)",
 "枯草": "تِبْن, جَفِيف (تبَنَ الدابة: عَلَفها تبنًا)\nمثال: لم تبن روما في يوم.",
 "枯草熱": "حمى القش (التهاب أنف موسمي ناتج عن رد فعل تحسسي لحبوب اللقاح)",
 "枯草菌": "عصوية رقيقة (نوع من العصويات يوجد في التربة والمواد العضوية المتحللة؛ تنتج بعض سلالاتها…)",
 "枯葉剤": "مزيل الأوراق, مسقط الأوراق (مادة كيميائية تُرش على النباتات وتتسبب في تساقط أوراقها)",
 "枯葉色": "بني مصفر, كراميل (لون أسمر متوسط إلى داكن)",
 "枯骨": "راحل, فقيد (شخص فارق الحياة ولم يعد حياً)\nمثال: أتساءل عما كان سيفعله الميت",
 "枳": "برتقال بري, برتقال ثلاثي الأوراق (شجرة برتقال صينية نفضية شائكة صغيرة سريعة النمو تحمل زهوراً حلوة الرائحة…)",
 "枳殻": "برتقال بري, برتقال ثلاثي الأوراق (شجرة برتقال صينية نفضية شائكة صغيرة سريعة النمو تحمل زهوراً حلوة الرائحة…)",
 "架": "مَكْتَبَة شَخْصِيَّة",
 "架かる": "شِبْر",
 "架ける": "بَنَى (أَقَامَ شيئا مثل الجدران و السفن باستخدام مواد مثل الخشب والطَّابُوق والحَجَر…)\nمثال: بنى سامي منزلا.",
 "架け替える": "اِسْتَبْدَلَ, بَدَّلَ (اتخذ شيئا بدلا من شيء)\nمثال: استبدل ياني حنفية المطبخ.",
 "架け橋": "جِسْر (شَجُعَ، جرُؤ؛ أقدم على الخطر واجترأ)\nمثال: اذهب إلى الجسر. / ممشى (مسار مخصص للمشي)\nمثال: بعد العاصفة الثلجية جرف الثلج من الممشى الأمامي",
 "架け橋となる": "جِسْر (شَجُعَ، جرُؤ؛ أقدم على الخطر واجترأ)\nمثال: اذهب إلى الجسر.",
 "架する": "شِبْر",
 "架台": "وَقَفَ, وقف (قَامَ، اِنْتَصَبَ، نَهَضَ؛ ثَبَتَ)\nمثال: وقف وراء الباب.",
 "架工義歯": "جِسْر (شَجُعَ، جرُؤ؛ أقدم على الخطر واجترأ)\nمثال: اذهب إلى الجسر.",
 "架構": "إطار, هيكل (هيكل يدعم أو يحتوي على شيء ما)\nمثال: توفير إطار عمل واقعي للبحث المستقبلي",
 "架橋": "جِسْر (شَجُعَ، جرُؤ؛ أقدم على الخطر واجترأ)\nمثال: اذهب إلى الجسر. / تشابك, رابطة مستعرضة (رابطة جانبية تربط سلسلتين متجاورتين من الذرات في جزيء معقد)",
 "架空": "مُخْتَلَق / جَوِّيّ, هَوَائِيّ",
 "架空鉄道": "سكة حديد معلقة, قطار معلق (سكة حديد تعمل بالكهرباء وتسير على مسار مرتفع فوق مستوى الشارع)",
 "架線": "تسليك, تمديد الأسلاك (عمل تركيب الأسلاك لنظام أو جهاز كهربائي)",
 "架装": "كَمَالِيّ\nمثال: علي مساعدة ماري.",
 "架設": "بِنَاء, تَشْيِيد (ضد هَدْم. ؛ المَبْنَى أو البِنَاية)\nمثال: أنا وجدت البناء.",
 "架電": "رسالة مهنية, مسار مهني (المهنة المحددة التي تدربت من أجلها)",
 "枷": "قَيْد / رباط, وصلة تثبيت (وصلة تثبت الأشياء ببعضها البعض)\nمثال: الالتصاق المتبادل للخلايا",
 "枸橘": "برتقال بري, برتقال ثلاثي الأوراق (شجرة برتقال صينية نفضية شائكة صغيرة سريعة النمو تحمل زهوراً حلوة الرائحة…)",
 "枸櫞": "تُرُنْج",
 "枸櫞酸": "حمض الستريك, حمض الليمون (حمض ضعيف قابل للذوبان في الماء يوجد في العديد من الفواكه (خاصة الحمضيات)…)",
 "枸櫞酸回路": "دورة حمض الستريك, دورة كريبس (في جميع النباتات والحيوانات: سلسلة من التفاعلات الإنزيمية في الميتوكوندريا…)",
 "枸櫞酸塩": "سيترات (ملح أو إستر لحمض الستريك)",
 "枹": "بَلُّوط, سِنْدِيَان",
 "柄": "مِقْبَض / سَاق / نُمُوذَج, نَمَط / حركة فنية (مجموعة محددة مسبقاً من الحركات في الرقص أو التزلج)\nمثال: حققت أفضل درجة في الحركات الإلزامية / شَخْصِيَّة\nمثال: زيري سيء الخلق. / مَقْبَض / جِذْع (في علم النبات: أحد أجزاء النبات الذي يحمل الأغصان ويتصل في أسفله بالجذر)\nمثال: أين صندوق البريد؟ / قصبة الريشة (العمود الفقري المجوف للريشة) / مِقْبَض",
 "柄が悪い": "سَيِّئُ التَّرْبِيَةِ, قَلِيلُ الْأَدَبِ ((عن الأشخاص) يفتقر إلى الرقة أو اللباقة)",
 "柄の悪い": "سَيِّئُ التَّرْبِيَةِ, قَلِيلُ الْأَدَبِ ((عن الأشخاص) يفتقر إلى الرقة أو اللباقة)",
 "柄沢": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "柄節": "سُوَيْقَة جِذْرِيَّة",
 "柄長": "قُرْقُف طَوِيل الذِّيل",
 "柄頭": "مقبض مزخرف (زخرفة على شكل كرة على مقبض السيف أو الخنجر)",
 "柊": "بَهَشِيَّة, إِيلِكْس",
 "柏原": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "柏木": "بلوط, سنديان (شجرة نفضية من جنس السنديان؛ لها جوز (بلوط) وأوراق مفصصة)\nمثال: تنمو أشجار البلوط العظيمة من ثمار البلوط الصغيرة",
 "柏瀬": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "某": "أَحَد (العدد وَاحِد؛ الوَاحِد من الشيء)\nمثال: لم يساعدني أحد. / أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك…)\nمثال: لم تقصد أي أذى. / أَكِيد\nمثال: لديك بعض الكتب. / أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك…)\nمثال: لم تقصد أي أذى. / بَعْضٌ ((بَعَضَه) البعوض بَعْضًا: لسعه وآذاه؛ (بَعَضَ) الشَّيْء: جعله أقساما) / أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك…)\nمثال: لم تقصد أي أذى.",
 "某々": "فُلَان, فُلَانَة (كلمة تستخدم لوصف شخص ما بدون ذكر من هو، غالبًا يقصد به \"أي شخص من الناس\"، أو…)\nمثال: سمعنا ذلك من فلان و فلان.",
 "某某": "فُلَان, فُلَانَة (كلمة تستخدم لوصف شخص ما بدون ذكر من هو، غالبًا يقصد به \"أي شخص من الناس\"، أو…)\nمثال: سمعنا ذلك من فلان و فلان.",
 "柑": "حمضيات (أي من الفواكه العديدة لجنس الحمضيات ذات القشرة السميكة واللب العصيري؛ تزرع في…)",
 "柑子栗毛": "حُمَّاض بُسْتَانِيّ\nمثال: أنا لديها شعر بني كستنائي, ولكن ماجدالينا لديها شعر أشقر.",
 "柑子色": "شَجَرَةْ اَلْبُرْتُقَال (نبات قائم على سَاق صلبة؛ مخطط له تفرعات)\nمثال: أنا تحت الشجرة.",
 "柑橘": "حمضيات (أي من الفواكه العديدة لجنس الحمضيات ذات القشرة السميكة واللب العصيري؛ تزرع في…)",
