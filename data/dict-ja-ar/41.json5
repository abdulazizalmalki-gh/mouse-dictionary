 "横穴": "كَهْف, غَار",
 "横突起": "نتوء مستعرض (أحد نتوءين يمتدان من كل فقرة ويوفران نقطة تمفصل للأضلاع)",
 "横笛": "ناي, ناي مستعرض (آلة نفخ خشبية عالية النبرة؛ أنبوب رفيع مغلق من أحد طرفيه بفتحات للأصابع في أحد طرفيه وفتحة بالقرب من الطرف المغلق يتم نفخ الهواء عبرها) / ناي الحفلات الغربي, ناي بوهيم (ناي الحفلات الغربي (يسمى أيضاً الناي المستعرض أو ناي بوهيم) هو آلة نفخ خشبية تُعزف من الجانب ومصنوعة من المعدن أو الخشب)",
 "横筋": "عَرْضِيّ, مُسْتَعْرِض (يَمْتَدّ أَوْ يَقَع بِالعَرْض؛ في اتِّجاه عَمودِيّ عَلى المِحْوَر)",
 "横筋ジャッカル": "ابن آوى مخطط الجانب (ابن آوى موطنه جنوب أفريقيا ذو شريط أسفل جانبه)",
 "横糸": "لُحْمَة (هو اللَحْم، واللحمة أخصُّ من اللحم؛ قطعة من اللحم)",
 "横紋筋": "عضلة مخططة, عضلة هيكلية (عضلة متصلة في أحد طرفيها أو كليهما بعظم وبالتالي تحرك أجزاء من الهيكل العظمي؛ عضلة تتميز بخطوط عرضية)",
 "横綱稽古": "تدريب, تمرين (تدريب منهجي بتكرارات متعددة)\nمثال: الممارسة تؤدي إلى الإتقان",
 "横腹": "جَانِب / صَفْحَة",
 "横行": "مُدْهِش, مُذْهِل (مُثير للإعجاب بشكل مُفاجئ لدرجة الذهول أو الإرباك)",
 "横行結腸": "قولون مستعرض (جزء الأمعاء الغليظة الذي يمتد عبر تجويف البطن ويربط القولون الصاعد بالنازل)",
 "横行闊歩": "مُتَبَخْتِر, مُتَهَوِّر بِمَرَح (مغامر بطريقة استعراضية وبَاهرة) / مُتَعَجْرِف, مُتَكَبِّر (لديه أو يُظهِر تفوّقًا متعجرفًا واحتقارًا لمن يعتبرهم أدنى منه)",
 "横谷": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "横車": "انحراف, شذوذ (الانحراف المتعمد عما هو خير وصواب) / عناد, مخالفة (تمرد متعمد وعنيد ومقاومة للتوجيه أو الانضباط)\nمثال: سيكون هناك دائمًا قلة من الناس يجدون متعة في التنمر والإرهاب بدافع الانحراف",
 "横転": "لفة برميلية (لفة تتبع فيها الطائرة مساراً لولبياً)",
 "横軸": "إِحْدَاثِيّ سِينِيّ, الإحداثي الأفقي (قيمة الإحداثي على المحور الأفقي)",
 "横這い": "نطاط الأوراق (حشرة صغيرة قافزة تمتص عصارة النباتات) / أفعى جانبية الحركة, أفعى مقرنة / سايدويندر (صاروخ جو-جو بجهاز توجيه بالأشعة تحت الحمراء) / مُثَبِّت, مُسْتَقِرّ (يُؤَدِّي إلى الاسْتِقْرار والثَّبات)",
 "横這いガラガラ蛇": "أفعى جانبية الحركة, أفعى مقرنة / سايدويندر (صاروخ جو-جو بجهاز توجيه بالأشعة تحت الحمراء)",
 "横道": "طريق جانبي, طريق فرعي (طريق جانبي قليل الاستخدام (كما في الريف)) / انحراف عن المسار, خروج عن الطريق (الابتعاد عن المسار الرئيسي للرحلة) / انحراف, تحويل (التحول جانباً (عن مسارك أو انتباهك أو اهتمامك)) / اسْتِطْرَاد, جُمْلَة مُعْتَرِضَة (رسالة تخرج عن الموضوع الرئيسي)\nمثال: تحويل عن الطريق السريع الرئيسي / شر, فجور (سلوك مرفوض أخلاقياً) / بَشَاعَة, خِسَّة (صفة كون الشيء مقرفاً للحواس أو المشاعر) / إثم, خطيئة (الابتعاد عن الله) / خباثة, دناءة (صفة الشر والفساد الأخلاقي)\nمثال: فاجأتنا بشاعة لغته",
 "横長": "مُسْتَطِيل (مُنْحَرِف عَن شَكْل المُرَبَّع أَوْ الدَّائِرَة بِاسْتِطالَتِه في اتِّجاه واحِد) / مُسْتَطِيل الوَرَقَة ((عن شكل الورقة) ذو شكل مُستطيل بعض الشيء بجوانب شبه متوازية) / شكل مستطيل, مستطيل (شكل مستوٍ ينحرف عن المربع أو الدائرة بسبب الاستطالة)",
 "横陣": "رُتْبَة (رُتْبَة، بضم الراء؛ رَتْبَة، بفتح الراء)",
 "横隊": "رُتْبَة (رُتْبَة، بضم الراء؛ رَتْبَة، بفتح الراء)",
 "横隔神経": "عصب حجابي (أحد زوجين من الأعصاب ينشأ من الجذور الشوكية العنقية ويمر أسفل القفص الصدري ليعصب الحجاب الحاجز ويتحكم في التنفس)",
 "横隔膜": "حِجَاب حَاجِز (الغطاء أو الساتر؛ يُطلق مجازا على لباس المرأة الذي يستر جميع جسمها)\nمثال: ارتدت أمها الحجاب.",
 "横隔膜ヘルニア": "فتق الحجاب الحاجز, فتق حجابي (فتق ناتج عن بروز جزء من المعدة عبر الحجاب الحاجز)",
 "横静索": "تَجْهِيزَات السَّفِينَة, صَوَارِي وَشِرَاع (تشكيل الصواري والعوارض والأشرعة وغيرها على السفينة) / تجهيزات الصاري, حبال السفينة (معدات تتكون من حبال وما إلى ذلك تدعم سواري السفينة وأشرعتها)",
 "横面": "جَانِب / صَفْحَة",
 "横須賀": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "横領": "اِخْتِلَاس (الخَلَسُ: الأخذ نُهْزَةومخاتلة، والاختلاس كالخَلَسِ؛ أخذه خُِلْسَةً أي اختلاسا)\nمثال: لقد اتهم باختلاس الأموال العامة.",
 "横領犯": "مختلس (شخص ينتهك الأمانة بأخذ (المال) لاستخدامه الخاص)",
 "横領罪": "اِخْتِلَاس (الخَلَسُ: الأخذ نُهْزَةومخاتلة، والاختلاس كالخَلَسِ؛ أخذه خُِلْسَةً أي اختلاسا)\nمثال: لقد اتهم باختلاس الأموال العامة.",
 "横領者": "مختلس (شخص ينتهك الأمانة بأخذ (المال) لاستخدامه الخاص)",
 "横顔": "حُدُود خَارِجِيَّة / صُورَة جَانِبِيَّة / سِيرَة / شُهْرَة / بُرُوز",
 "横風": "مُتَكَبِّر, مَغْرُور (شعب مُتكبِّر : مُتعجرف ، شامخ الرأس؛ مُتكَبِّر : فاعل من تَكَبَّر)\nمثال: هو متكبر للغاية. / رياح جانبية (رياح تهب عبر مسار سفينة أو طائرة)",
 "樫": "بلوط هولم, سنديان أخضر (بلوط دائم الخضرة من جنوب أوروبا له أوراق تشبه إلى حد ما أوراق البهشية؛ ينتج خشباً صلباً)",
 "樫本": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "樫羽": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "樵": "حَطَّاب",
 "樸直": "بَسَاطَة",
 "樹": "شَجَر, شَجَرَة (الأمر المختلف بين الناس؛ مخرج الفَم أو مُؤَخَّره. ومنه الحروف الشَجْرِيَّة) / شَجَرَة (نبات قائم على سَاق صلبة؛ مخطط له تفرعات)\nمثال: توم يتسلق شجرة.",
 "樹々": "شَجَر, شَجَرَة (الأمر المختلف بين الناس؛ مخرج الفَم أو مُؤَخَّره. ومنه الحروف الشَجْرِيَّة) / شَجَرَة (نبات قائم على سَاق صلبة؛ مخطط له تفرعات)\nمثال: توم يتسلق شجرة.",
 "樹下": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "樹医": "أخصائي أشجار, جراح أشجار (متخصص في علاج الأشجار المتضررة)",
 "樹妖精": "حورية الغابة, درياد (إلهة أو حورية الغابات)",
 "樹幹": "جِذْع (في علم النبات: أحد أجزاء النبات الذي يحمل الأغصان ويتصل في أسفله بالجذر) / خُرْطُوم / صَنْدُوق, صُنْدُوق (وعاء كبيرة من الخشب غالبا وقد يكون حديدًا يستخدم لوضع الاشياء داخله، ويكون لها عادة جهة قابلة للفتح سواء بمفاصل او بالازالة الكاملة؛ صُنْدُوْقُ السَيَّارَة قمرة تشبه الصندوق في الجزء الخلفي من السيارة يستخدم كالصندوق) / حَقِيبَة أَمْتِعَة, صُنْدُوقُ السَّيَّارَةِ\nمثال: أين صندوق البريد؟",
 "樹形図": "شجرة, مخطط شجري (شكل يتفرع من جذر واحد)\nمثال: شجرة العائلة",
 "樹懶": "كَسَل / كَسْلَان",
 "樹木": "شَجَر, شَجَرَة (الأمر المختلف بين الناس؛ مخرج الفَم أو مُؤَخَّره. ومنه الحروف الشَجْرِيَّة) / شَجَرَة (نبات قائم على سَاق صلبة؛ مخطط له تفرعات)\nمثال: توم يتسلق شجرة.",
 "樹木医": "أخصائي أشجار, جراح أشجار (متخصص في علاج الأشجار المتضررة)",
 "樹木園": "حديقة نباتية, مشتل (منشأة تُزرع فيها الأشجار والشجيرات للعرض)",
 "樹木学": "علم الأشجار (دراسة النباتات الخشبية)",
 "樹杪": "تاج الشجرة, قمة الشجرة (الفروع والأوراق العليا لشجرة أو نبات آخر)",
 "樹林": "غَابَة, غابة (الغَابَةُ: الأَجَمَةُ ذاتُ الشَّجَرِ المُتَكَاثِف؛ لأَنَّها تُغَيِّبُ مَا فِيهَا. أو الأَجَمَةُ الَّتِي طالتْ، وَلَهَا أَطْراف مُرْتَفِعَةٌ باسِقَة؛ الغابةُ أَجَمة القَصَب، قَالَ: وَقَدْ جُعِلَتْ جماعةَ الشَّجَرِ، لأَنه مأْخوذ مِنَ الغَيابةِ)\nمثال: مشينا في الغابة",
 "樹枝": "فَرْع, غُصْن",
 "樹枝状": "ذُو بِنْيَةٍ تَفَرُّعِيَّة, شَجَرِيّ (يُشْبِهُ الشَّجَرَةَ فِي شَكْلِهِ وَبِنْيَتِهِ المُتَفَرِّعَة)",
 "樹枝状結晶": "تغصن, زائدة شجرية (ليف قصير ينقل الإشارات نحو جسم الخلية العصبية)",
 "樹梢": "تاج الشجرة, قمة الشجرة (الفروع والأوراق العليا لشجرة أو نبات آخر)",
 "樹樹": "شَجَر, شَجَرَة (الأمر المختلف بين الناس؛ مخرج الفَم أو مُؤَخَّره. ومنه الحروف الشَجْرِيَّة) / شَجَرَة (نبات قائم على سَاق صلبة؛ مخطط له تفرعات)\nمثال: توم يتسلق شجرة.",
 "樹氷": "صقيع (بلورات جليدية تشكل طبقة بيضاء (خاصة على الأشياء في الخارج))",
 "樹液": "نُسْغ, عُصَارَة",
 "樹状突起": "تغصن, زائدة شجرية (ليف قصير ينقل الإشارات نحو جسم الخلية العصبية)",
 "樹状細胞": "تيار مستمر (تيار كهربائي يتدفق في اتجاه واحد بثبات)",
 "樹皮": "نَبَحَ, يَنْبَح / نُبَاح / لِحَاء",
 "樹立": "تَأْسِيس / مُؤَسَّسَة",
 "樹脂": "رَاتِينَج, صُرْع",
 "樹芸": "زراعة الأشجار (العناية بالأشجار ورعايتها)",
 "樺": "بَتُولَا",
 "樺の木": "بتولا, شجر القضبان (أي شجرة أو شجيرة من الفصيلة البتولية ذات لحاء رقيق مقشر)",
 "樺太シシャモ": "كبلين (سمكة شمالية صغيرة جداً؛ غذاء للطيور البحرية والثدييات البحرية والأسماك الأخرى)",
 "樺太梟": "بومة رمادية عظمى (بومة كبيرة ذات وجه مسطح من شمال أمريكا الشمالية وغرب أوراسيا)",
 "樺太雷鳥": "طيهوج أحمر (طيهوج بني محمر يعيش في المستنقعات المرتفعة في بريطانيا العظمى)",
 "樺山": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "樽": "برميل (حاوية أسطوانية تحفظ السوائل) / ملء برميل (الكمية التي يستوعبها برميل خشبي)",
 "樽俎": "طَرَف / حَفْلَة, اِحْتِفَال",
 "樽俎折衝": "دبلوماسية, مفاوضات دبلوماسية (تفاوض بين الدول)",
 "樽角": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "橄欖": "أبيض الزنك, أبيض صيني (خضاب أبيض يستخدم في دهانات المنازل؛ يتكون من أكسيد الزنك) / زَيْتُون (نوع من الشَجَر له ثمر حبّ صغير أسود أو أخضر يُعصر منه الزَيْت؛ ثمر شجر الزيتون، الحب الصغير أسود كان أو أخصر) / زَيْتُونِيّ, زَيْتِيّ\nمثال: هي تشرب زيت الزيتون.",
 "橄欖山": "جَبَل الزَّيْتُون (كلمة \"جبل\" لها معانٍ متعددة؛ طبع أو خلق شيئًا أو شخصًا على طبيعة أو سلوك معين)",
 "橄欖岩": "بيريدوتيت (صخر ناري خشن الحبيبات داكن يتكون بشكل أساسي من الأوليفين)",
 "橄欖油": "زَيْت زَيْتُون (ما يعصر من الزَيْتُون؛ كل سائل لزج يستخرد من النبات يستخدم كما يستخدم السمن)",
 "橄欖石": "أوليفين, زبرجد زيتوني (معدن يتكون من سيليكات المغنيسيوم والحديد؛ مصدر للمغنيسيوم)",
 "橄欖色": "زَيْتُون (نوع من الشَجَر له ثمر حبّ صغير أسود أو أخضر يُعصر منه الزَيْت؛ ثمر شجر الزيتون، الحب الصغير أسود كان أو أخصر) / زَيْتُونِيّ, زَيْتِيّ",
 "橅": "زان ياباني (زان موطنه اليابان له خشب بني مصفر فاتح ناعم)",
 "橅の木": "زان ياباني (زان موطنه اليابان له خشب بني مصفر فاتح ناعم)",
 "橅材": "خشب الزان (خشب أي من أشجار الزان المختلفة؛ يستخدم للأرضيات والحاويات والخشب الرقائقي ومقابض الأدوات)",
 "橇": "زلاجة (مركبة مثبتة على زحافات وتجرها الخيول أو الكلاب؛ للنقل فوق الثلج) / حذاء ثلجي (جهاز يساعدك على المشي فوق الثلج العميق؛ إطار خفيف الوزن يشبه المضرب مقوى بقطع عرضية ويحتوي على شبكة من السيور؛ يلبس واحد في كل قدم)",
 "橈脚": "مجدافية الأرجل (قشريات بحرية أو مياه عذبة دقيقة لها عادة ستة أزواج من الأطراف على الصدر؛ بعضها وفير في العوالق والبعض الآخر طفيلي على الأسماك)",
 "橈脚類": "مجدافية الأرجل (قشريات بحرية أو مياه عذبة دقيقة لها عادة ستة أزواج من الأطراف على الصدر؛ بعضها وفير في العوالق والبعض الآخر طفيلي على الأسماك)",
 "橈骨": "كُعْبُرَة / نِصْف قُطْر, شُعَاع",
 "橈骨動脈": "شريان كعبري (فرع من الشريان العضدي يبدأ أسفل المرفق ويمتد لأسفل الساعد حول الرسغ وإلى راحة اليد)",
 "橋": "جِسْر (شَجُعَ، جرُؤ؛ أقدم على الخطر واجترأ) / قَنْطَرَة / كوبري / جسر (شَجُعَ، جرُؤ؛ أقدم على الخطر واجترأ) / قنطرة / بْرِيدْج\nمثال: اذهب إلى الجسر. / جسر (شَجُعَ، جرُؤ؛ أقدم على الخطر واجترأ)\nمثال: اذهب إلى الجسر.",
 "橋かけ": "تشابك, رابطة مستعرضة (رابطة جانبية تربط سلسلتين متجاورتين من الذرات في جزيء معقد)",
 "橋がかり": "جسر مسقوف (جسر يكون ممره محمياً بسقف وجوانب مغلقة)",
 "橋上": "جِسْر (شَجُعَ، جرُؤ؛ أقدم على الخطر واجترأ) / قَنْطَرَة / كوبري / جسر (شَجُعَ، جرُؤ؛ أقدم على الخطر واجترأ) / قنطرة / بْرِيدْج\nمثال: اذهب إلى الجسر.",
 "橋口": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "橋懸": "جسر مسقوف (جسر يكون ممره محمياً بسقف وجوانب مغلقة)",
 "橋懸かり": "جسر مسقوف (جسر يكون ممره محمياً بسقف وجوانب مغلقة)",
 "橋懸り": "جسر مسقوف (جسر يكون ممره محمياً بسقف وجوانب مغلقة)",
 "橋掛": "جسر مسقوف (جسر يكون ممره محمياً بسقف وجوانب مغلقة)",
