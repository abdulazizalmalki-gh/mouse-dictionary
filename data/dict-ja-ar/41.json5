 "株式分割": "تجزئة الأسهم (زيادة في عدد الأسهم القائمة للشركة دون تغيير حقوق المساهمين)\nمثال: أعلنوا عن تجزئة اثنين مقابل واحد للأسهم العادية",
 "株式取引所": "بُورْصَة, سُوقُ الْأَوْرَاقِ الْمَالِيَّةِ",
 "株式市場": "سُوقُ الْأَوْرَاقِ الْمَالِيَّةِ, بُورْصَة (مكان للبيع والشراء؛ جمع ساق، قال الله تعالى: 《رُدُّوهَا عَلَيَّ فَطَفِقَ…)\nمثال: ذهبت إلى السوق.",
 "株式相場": "سُوقُ الْأَوْرَاقِ الْمَالِيَّةِ, بُورْصَة (مكان للبيع والشراء؛ جمع ساق، قال الله تعالى: 《رُدُّوهَا عَلَيَّ فَطَفِقَ…)\nمثال: ذهبت إلى السوق.",
 "株式譲渡益": "أرباح رأسمالية, مكاسب رأسمالية (المبلغ الذي يتجاوز به سعر بيع الأصل سعر الشراء؛ يتحقق الربح عند بيع الأصل)",
 "株式配当": "أرباح الأسهم, توزيعات أسهم (أرباح مدفوعة في شكل أسهم بدلاً من النقد)",
 "株式配当金": "أرباح الأسهم, توزيعات أسهم (أرباح مدفوعة في شكل أسهم بدلاً من النقد)",
 "株買い占め": "زَاوِيَة, رُكْن",
 "栫": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "栲": "توت الورق (شجرة شجيرية آسيوية لها لحاء (تابا) يشبه القماش؛ تزرع كشجرة ظل في أوروبا وأمريكا…) / قُمَاش, أقمشة (النسيج الذي لم يُقَصّ أو يُخَاط)\nمثال: الورق و القماش يمتصان الماء.",
 "栴檀": "أزدرخت, زنزلخت (شجرة من شمال الهند والصين لها أزهار أرجوانية وثمار صفراء صغيرة غير صالحة للأكل…)",
 "核": "حَجَر, حجر (حَجَرَ عليه الأمرَ:مَنَعَه منه ، حجر الشّيء على نفسه:خَصَّها به وقصره عليها…)\nمثال: عوقب زيري بالحجر. / نِوَاة / سِلَاح نَوَوِيّ / نَوَاة / بِذْرَة, زَرِّيعَة / لِسَان (فِي : جسم لحميّ مستطيل متحرك، يكون في الفم، ويصلح للتّذوُّق والبلع، وللنطق…)\nمثال: ماري لها فم ليس لها لسان. / بَظْر / نِوَاة",
 "核のごみ": "نفايات مشعة (مواد مشعة عديمة الفائدة تتبقى بعد اكتمال عملية مخبرية أو تجارية)",
 "核のゴミ": "نفايات مشعة (مواد مشعة عديمة الفائدة تتبقى بعد اكتمال عملية مخبرية أو تجارية)",
 "核の冬": "شتاء نووي (فترة طويلة من الظلام والبرد القارس يتوقع العلماء أنها ستعقب حرباً نووية شاملة…)",
 "核の塵": "نفايات مشعة (مواد مشعة عديمة الفائدة تتبقى بعد اكتمال عملية مخبرية أو تجارية)",
 "核エネルギー": "طَاقَة ذَرِّيَّة (القُدْرَة والشِدَّة؛ هي مقدار ما يمكن للإنسان أن يفعله بمشقة، كأن قدرته محددة…)\nمثال: طلب بطاقة اعتماد.",
 "核クラブ": "النادي النووي (الدول التي تمتلك أسلحة نووية)",
 "核シェルター": "قُنْبُلَة نَوَوِيَّة",
 "核テロ": "إرهاب نووي (استخدام جهاز نووي من قبل منظمة إرهابية لإحداث دمار هائل أو استخدام (أو التهديد…)",
 "核仁": "نوية",
 "核保有国": "طاقة نووية, قدرة نووية (الطاقة النووية باعتبارها مصدراً للكهرباء لشبكة الطاقة (للاستخدام المدني))",
 "核兵器": "سِلَاح نَوَوِيّ",
 "核分裂": "انشطار / انقسام النواة (عملية عضوية تتكون من انقسام نواة الخلية أثناء الانقسام المتساوي أو المنصف)",
 "核分裂反応": "انشطار",
 "核分裂性": "قابل للانشطار, قابل للفلق (قابل للفلق أو الشق أو التقسيم في اتجاه الألياف)\nمثال: بلورات قابلة للانفلاق",
 "核分裂性物質": "انشطاري, قابل للانشطار (قابل للخضوع للانشطار النووي)\nمثال: نواة انشطارية",
 "核化学": "كيمياء إشعاعية, كيمياء نووية (كيمياء المواد المشعة)",
 "核医学": "طب نووي (فرع الطب الذي يستخدم المواد المشعة إما لتصوير جسم المريض أو لتدمير الخلايا…)",
 "核反応": "تفاعل نووي (فلان وفلان: أثّر كلّ منهما في الآخر؛ مع الشيء: تأثّر به)",
 "核反応炉": "مُفَاعِل نَوَوِيّ",
 "核型": "نمط نووي (مظهر التركيب الصبغي لخلية جسدية في فرد أو نوع (بما في ذلك عدد وترتيب وحجم وهيكل…)",
 "核大国": "طاقة نووية, قدرة نووية (الطاقة النووية باعتبارها مصدراً للكهرباء لشبكة الطاقة (للاستخدام المدني))",
 "核子": "نُوَيَّة, نِيُوكْلِيُون (مكون (بروتون أو نيوترون) للنواة الذرية) / دَقِيق الْأَرُزّ, أَرُزّ مَسْحُوق (ضد الغَلِيْظ، الرَفِيْع الرَقِيْق؛ صغير الحجم جدا)\nمثال: ساعتي غير دقيقة.",
 "核家族": "أسرة نووية (أسرة تتكون من الوالدين وأطفالهم وجدي أحد الزوجين)",
 "核小体": "نوية",
 "核弾頭": "رأس حربي ذري, رأس نووي (الرأس الحربي لصاروخ مصمم لإيصال قنبلة ذرية)",
 "核心": "نِوَاة",
 "核心的": "حَاسِم",
 "核戦争": "حَرْب نَوَوِيَّة, حَرْب ذَرِّيَّة (حَرَبَ (حربه) بالحربة حربا: طعنه بها؛ حَرَبَ (ه) حربا: سلبه جميع ما يملك)",
 "核抑止": "ردع نووي (العقيدة العسكرية القائلة بأن العدو سيرتدع عن استخدام الأسلحة النووية طالما أمكن…)\nمثال: عندما تلجأ دولتان إلى الردع النووي، قد تكون النتيجة دماراً متبادلاً",
 "核果": "ثمرة نووية, حسلة (فاكهة لحمية غير متفتحة ذات بذرة واحدة: مثل اللوز والخوخ والبرقوق والكرز والخمان…)",
 "核燃料": "وقود نووي (وقود (مثل اليورانيوم) يمكن استخدامه في المفاعلات النووية كمصدر للكهرباء)",
 "核燃料サイクル": "وقود نووي (وقود (مثل اليورانيوم) يمكن استخدامه في المفاعلات النووية كمصدر للكهرباء)",
 "核燃料デブリ": "وقود نووي (وقود (مثل اليورانيوم) يمكن استخدامه في المفاعلات النووية كمصدر للكهرباء)",
 "核燃料プール": "وقود نووي (وقود (مثل اليورانيوم) يمكن استخدامه في المفاعلات النووية كمصدر للكهرباء)",
 "核燃料再処理": "وقود نووي (وقود (مثل اليورانيوم) يمكن استخدامه في المفاعلات النووية كمصدر للكهرباء)",
 "核燃料化": "إِثْرَاء",
 "核燃料棒": "وقود نووي (وقود (مثل اليورانيوم) يمكن استخدامه في المفاعلات النووية كمصدر للكهرباء)",
 "核爆弾": "قُنْبُلَة نَوَوِيَّة",
 "核爆発": "انفجار ذري, انفجار نووي (انفجار قنبلة ذرية)",
 "核物理学": "فيزياء ذرية, فيزياء نووية (فرع الفيزياء الذي يدرس البنية الداخلية للنواة الذرية)",
 "核磁気共鳴": "رنين مغناطيسي نووي (رنين البروتونات للإشعاع في مجال مغناطيسي)",
 "核磁気共鳴映像法": "رنين مغناطيسي نووي (رنين البروتونات للإشعاع في مجال مغناطيسي)",
 "核移植": "نقل نواة الخلية الجسدية (نقل نواة الخلية ومادتها الوراثية من خلية إلى أخرى)",
 "核蛋白質": "بروتين نووي (أي من عدة مواد موجودة في نوى جميع الخلايا الحية؛ تتكون من بروتين مرتبط بحمض نووي)",
 "核融合": "اِنْدِمَاج نَوَوِيّ",
 "核融合反応": "اندماج, اندماج نووي (تفاعل نووي تتحد فيه النوى لتكوين نوى أكثر ضخامة مع إطلاق متزامن للطاقة)",
 "核融合炉": "اِنْدِمَاج نَوَوِيّ",
 "核融合発電": "اِنْدِمَاج نَوَوِيّ",
 "核質": "بلازما نووية, جبلة نووية (البروتوبلازم الذي يشكل نواة الخلية)",
 "核酸": "حمض نووي ((كيمياء حيوية) أي من الجزيئات الكبيرة المختلفة المكونة من سلاسل النيوكليوتيدات…)",
 "核酸増幅検査": "حمض نووي ((كيمياء حيوية) أي من الجزيئات الكبيرة المختلفة المكونة من سلاسل النيوكليوتيدات…)",
 "根": "جَذْر, جدر (جِذْرُ ٱلشَّيْءِ هُوَ: أَصْلُهُ؛ في : جذر العدد النوني هو عدد ما إذا رفعناه…)\nمثال: أحسب جذر خمسة بالآلة الحاسبة. / شَعَاب / مُثَابَرَة / جَذْريّ / جَذْر, جدر (جِذْرُ ٱلشَّيْءِ هُوَ: أَصْلُهُ؛ في : جذر العدد النوني هو عدد ما إذا رفعناه…)\nمثال: أحسب جذر خمسة بالآلة الحاسبة.",
 "根から": "مطلقا, على الإطلاق",
 "根から葉から": "مطلقا, على الإطلاق",
 "根が深い": "رَاسِخ, عَمِيق الجُذُور ((يستخدم خاصة للأفكار أو المبادئ) عميق الجذور؛ ثابت ومتمكّن بقوّة)",
 "根こそぎ": "كُلّ, جَمِيع",
 "根っから": "بالفطرة, بطبعه (من خلال الطبيعة المتأصلة)\nمثال: كان كسولاً بطبعه / مطلقا, على الإطلاق",
 "根っから葉っから": "مطلقا, على الإطلاق",
 "根っこ": "جَذْر, جدر (جِذْرُ ٱلشَّيْءِ هُوَ: أَصْلُهُ؛ في : جذر العدد النوني هو عدد ما إذا رفعناه…)\nمثال: أحسب جذر خمسة بالآلة الحاسبة. / جُذْمُور, كُنَّاشَة",
 "根っ子": "جَذْر, جدر (جِذْرُ ٱلشَّيْءِ هُوَ: أَصْلُهُ؛ في : جذر العدد النوني هو عدد ما إذا رفعناه…)\nمثال: أحسب جذر خمسة بالآلة الحاسبة. / جُذْمُور, كُنَّاشَة",
 "根なし": "صُعْلُوك, مُقْتَلَع الجُذُور (يتشرّد بلا هدف ودون روابط بمكان أو مجتمع)",
 "根のいい": "صَبُور, طَوِيلُ البَال (يَتَحَمَّلُ بِصَبْرٍ الظُّلْمَ أَوِ المَتَاعِبَ المُسْتَمِرَّة)",
 "根の国": "سِجِّين, عَالَم سُفْلِيّ",
 "根の堅州国": "سِجِّين, عَالَم سُفْلِيّ",
 "根の堅洲国": "سِجِّين, عَالَم سُفْلِيّ",
 "根の良い": "صَبُور, طَوِيلُ البَال (يَتَحَمَّلُ بِصَبْرٍ الظُّلْمَ أَوِ المَتَاعِبَ المُسْتَمِرَّة)",
 "根ほり葉ほり": "بتساؤل, بفضول\nمثال: نظر الطفل حوله بفضول",
 "根も葉もない": "لَا أَسَاس لَه, وَاهٍ (بدون أساس في العقل أو الواقع)",
 "根をはる": "هَدَأَ\nمثال: استقر زيري في خيمته.",
 "根を張る": "هَدَأَ\nمثال: استقر زيري في خيمته.",
 "根セロリ": "جذر الكرفس (جذر عطري صالح للأكل وسميك لنوع من نبات الكرفس)",
 "根井": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "根付": "تجذير (عملية إخراج الجذور والبدء في النمو)",
 "根付く": "جَذْر, جدر (جِذْرُ ٱلشَّيْءِ هُوَ: أَصْلُهُ؛ في : جذر العدد النوني هو عدد ما إذا رفعناه…)\nمثال: أحسب جذر خمسة بالآلة الحاسبة.",
 "根保証": "ائتمان متجدد, ائتمان مفتوح (خط ائتمان استهلاكي يمكن استخدامه حتى حد معين أو سداده في أي وقت)",
 "根元": "جَذْر, جدر (جِذْرُ ٱلشَّيْءِ هُوَ: أَصْلُهُ؛ في : جذر العدد النوني هو عدد ما إذا رفعناه…)\nمثال: أحسب جذر خمسة بالآلة الحاسبة. / قَاعِدَة / جَذْر, جدر (جِذْرُ ٱلشَّيْءِ هُوَ: أَصْلُهُ؛ في : جذر العدد النوني هو عدد ما إذا رفعناه…)\nمثال: أحسب جذر خمسة بالآلة الحاسبة.",
 "根元的": "أَزَلِيّ, بِدْئِيّ (موجود منذ البداية؛ في أبكر مرحلة أو حالة أصلية)",
 "根冠": "قلنسوة الجذر (كتلة من الخلايا على شكل قمع تغطي وتحمي الطرف النامي للجذر)",
 "根出葉": "شارة وردية, وردة شريطية (حلية أو نمط يشبه الوردة يُلبس كشارة منصب أو اعترافاً بالفوز بشرف ما)",
 "根切り": "استخراج المعادن, تعدين (فعل استخراج الخامات أو الفحم وما إلى ذلك من الأرض)\nمثال: هناك حفر مثير للاهتمام يجري بالقرب من برينستون / إبادة",
 "根切り虫": "دودة قارضة (عثة أمريكية شمالية تتغذى يرقاتها على سيقان النباتات الصغيرة وتقطعها عند مستوى…)",
 "根切虫": "دودة قارضة (عثة أمريكية شمالية تتغذى يرقاتها على سيقان النباتات الصغيرة وتقطعها عند مستوى…)",
 "根刮ぎ": "استئصال, طمس (التدمير الكامل لكل أثر لشيء ما)",
 "根原": "جَذْر, جدر (جِذْرُ ٱلشَّيْءِ هُوَ: أَصْلُهُ؛ في : جذر العدد النوني هو عدد ما إذا رفعناه…)\nمثال: أحسب جذر خمسة بالآلة الحاسبة.",
 "根号": "علامة الجذر (علامة تشير إلى استخراج الجذر)",
 "根問い": "تطفل, فضول (حالة من الفضول النشط)\nمثال: أزعجتني نظرة الاختراق وحب الاستطلاع لديه: شعرت بالحرج والذنب في وجوده",
 "根喰葉虫": "خنفساء الأوراق (خنفساء زاهية الألوان تتغذى على أوراق النباتات؛ وتغزو يرقاتها الجذور والسيقان)",
 "根回し": "خَلْفَ الكَوَالِيس, سِرِّيّ (مُصَمَّمٌ وَمُنَفَّذٌ بِسِرِّيَّةٍ أَوْ بِشَكْلٍ سِرِّيّ)",
 "根城": "حِصْن (ما يُتَحَصَّنُ به ويُمْنَع؛ كل مكان محميّ مُحرَز لا يُوصَل إليه؛ عن ما…)\nمثال: كان هناك حصن على تلك الهضبة في يوم من الأيام. / قَاعِدَة",
 "根基": "جَذْريّ",
 "根太": "دُمَّل, خُرَاج / رافدة (عارضة تستخدم لدعم الأرضيات أو الأسقف)",
 "根太板": "لوح أرضية (لوح في الأرضية)",
 "根岸": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "根幹": "إِنْشاء, إِشَادَة (مصدر للفعل \"أَنْشَأَ\")\nمثال: إنشاء موقع إلكتروني بدون أي تكلفة؟",
 "根底": "جَذْر, جدر (جِذْرُ ٱلشَّيْءِ هُوَ: أَصْلُهُ؛ في : جذر العدد النوني هو عدد ما إذا رفعناه…)\nمثال: أحسب جذر خمسة بالآلة الحاسبة.",
 "根強い": "رَاسِخ, عَمِيق الجُذُور ((يستخدم خاصة للأفكار أو المبادئ) عميق الجذور؛ ثابت ومتمكّن بقوّة)",
 "根性": "ضبط النفس (سمة التحكم الحازم في سلوك المرء) / شَخْصِيَّة\nمثال: زيري سيء الخلق.",
 "根性なし": "جَبَان (شديد الخوف ممتنع عن الإقدام؛ ضد الشجاع)\nمثال: إيدير مجرد جبان.",
