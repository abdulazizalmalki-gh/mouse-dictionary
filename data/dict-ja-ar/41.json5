 "有頭動物": "حيوان فقاري, فقاري (حيوانات لها هيكل عظمي أو غضروفي مع عمود فقري مقسم ودماغ كبير محاط بجمجمة)",
 "有頭骨": "عظم كبير (عظم الرسغ ذو الرأس المستدير الذي يتمفصل مع العظم السنعي الثالث)",
 "有馬": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "有鬚動物": "دودة لحوية (حيوان نحيل له مجسات وغطاء خارجي يشبه الأنبوب؛ يعيش في قاع المحيط العميق)",
 "有鱗類": "آكل النمل الحرشفي, بنغول (ثديي عديم الأسنان من جنوب أفريقيا وآسيا يغطي جسمه حراشف قرنية وله خطم طويل للتغذى على النمل والنمل الأبيض)",
 "朋": "صَدِيق, صَدِيقَة (هو الصَاحِب والخّل الذي بينك وبينه صَدَاقَة)\nمثال: ليس لديه صديقة. / مُصَاحَبَة",
 "朋党": "فَرِيق, زَمْرَة (الطَائِفَة من الشيء المتفرق؛ الطَائِفَة من الناس، وهي أكثر من الفِرْقَة)\nمثال: لدينا فريق جيد.",
 "朋友": "صَدِيق, صَدِيقَة (هو الصَاحِب والخّل الذي بينك وبينه صَدَاقَة)\nمثال: ليس لديه صديقة.",
 "朋永": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "服": "مَلَابِس, ثِيَاب / حِدَاد / ثَوْبُ حِدَاد (ما يُلْبَسُ من اللِبَاس، أي جزء ويطلق للرجال والنساء؛ الجزء الرئيس من الملابس، غالبا ما يكون طويلا وواسعا وذو أكمام، تحته الملابس الداخلية وفوقه الخارجية. يستخدم للرجال والنساء)\nمثال: هو ذئب في ثوب حمل.",
 "服す": "أَطَاعَ / عَبَدَ (خلاف الحُرّ، المَمْلُوْك، من له مالك يملكه. الجمع عبيد وأعبد وعِبدان وعُبدان؛ الإنسان حرا كان أم لا مؤمنا كان أن ملحدا من حيث أنه مملوك لله) / خَدَمَ (عَمِلَ أو سَاعَدَ شخصًا أو جهة؛ أَدَارَ خدمة أو مهمة) / قَدَّمَ (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى الرُّسْغَ؛ أنّ لهم سابقةً وفضلاً له عند فلان قَدَمٌ : معروف) / أَرْسَلَ (بَعَثَ؛ أَطْلَقَ) / إِرْسَال (الإرْسال : الإطلاق؛ النقل والبَعْث من مكان إلى آخر)\nمثال: ماذا أنجز عبد العزيز بوتفليقة؟ / لَاحَظَ, رَاقَبَ / أَخَذَ (تَنَاوَلَ الشيء بيده، تملكه أو تحكم فيه، بالقوة أو بدونها؛ أمْسَكَ بِالشيء. (يتعدى بالباء)) / أَخَذَ بِـ (تَنَاوَلَ الشيء بيده، تملكه أو تحكم فيه، بالقوة أو بدونها؛ أمْسَكَ بِالشيء. (يتعدى بالباء)) / اِتَّخَذَ / اِسْتَغْرَقَ / اِلْتَقَطَ\nمثال: أخذ الولد يبكي.",
 "服する": "أَطَاعَ / عَبَدَ (خلاف الحُرّ، المَمْلُوْك، من له مالك يملكه. الجمع عبيد وأعبد وعِبدان وعُبدان؛ الإنسان حرا كان أم لا مؤمنا كان أن ملحدا من حيث أنه مملوك لله) / خَدَمَ (عَمِلَ أو سَاعَدَ شخصًا أو جهة؛ أَدَارَ خدمة أو مهمة) / قَدَّمَ (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى الرُّسْغَ؛ أنّ لهم سابقةً وفضلاً له عند فلان قَدَمٌ : معروف) / أَرْسَلَ (بَعَثَ؛ أَطْلَقَ) / إِرْسَال (الإرْسال : الإطلاق؛ النقل والبَعْث من مكان إلى آخر)\nمثال: ماذا أنجز عبد العزيز بوتفليقة؟ / لَاحَظَ, رَاقَبَ / أَخَذَ (تَنَاوَلَ الشيء بيده، تملكه أو تحكم فيه، بالقوة أو بدونها؛ أمْسَكَ بِالشيء. (يتعدى بالباء)) / أَخَذَ بِـ (تَنَاوَلَ الشيء بيده، تملكه أو تحكم فيه، بالقوة أو بدونها؛ أمْسَكَ بِالشيء. (يتعدى بالباء)) / اِتَّخَذَ / اِسْتَغْرَقَ / اِلْتَقَطَ\nمثال: أخذ الولد يبكي.",
 "服む": "أَخَذَ (تَنَاوَلَ الشيء بيده، تملكه أو تحكم فيه، بالقوة أو بدونها؛ أمْسَكَ بِالشيء. (يتعدى بالباء)) / أَخَذَ بِـ (تَنَاوَلَ الشيء بيده، تملكه أو تحكم فيه، بالقوة أو بدونها؛ أمْسَكَ بِالشيء. (يتعدى بالباء)) / اِتَّخَذَ / اِسْتَغْرَقَ / اِلْتَقَطَ\nمثال: أخذ الولد يبكي.",
 "服わぬ": "أبي, غير خاضع (غير خانع أو خاضع)",
 "服務": "وَاجِب, وَظِيفَة (اسم لما يُوجَبُ فعله؛ اسم لما صار حدوثه أكيد) / رَسْم (سَم الشَّيءَ :خطّه رسَم مُربَّعًا/ صورةً/ شكلاً؛ رسَم : كَتَبَ)\nمثال: لا شكر على واجب.",
 "服務期間": "فترة تجنيد, فترة خدمة (فترة زمنية تقضى في الخدمة العسكرية)",
 "服喪": "حِدَاد / ثَوْبُ حِدَاد (ما يُلْبَسُ من اللِبَاس، أي جزء ويطلق للرجال والنساء؛ الجزء الرئيس من الملابس، غالبا ما يكون طويلا وواسعا وذو أكمام، تحته الملابس الداخلية وفوقه الخارجية. يستخدم للرجال والنساء)",
 "服地": "قُمَاش, أقمشة (النسيج الذي لم يُقَصّ أو يُخَاط) / مِمْسَحَة\nمثال: الورق و القماش يمتصان الماء.",
 "服屋": "خَيَّاط, خَيَّاطَة",
 "服属": "تَابِع / مُتَابِع",
 "服山": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "服役": "خِدْمَةٌ عَسْكَرِيَّة / عمل قسري (فِعْل، صُنْع؛ وسيلة للكسب، مِهْنَة، حِرْفَة)\nمثال: المهم هو العمل.",
 "服役囚": "أَدَانَ / سَجِين, مُدَان",
 "服従": "طَاعَة, إِطَاعَة",
 "服従心": "إذعان, خضوع (سمة الاستعداد للخضوع لإرادة شخص آخر أو قوة عليا وما إلى ذلك)",
 "服忌": "حِدَاد / ثَوْبُ حِدَاد (ما يُلْبَسُ من اللِبَاس، أي جزء ويطلق للرجال والنساء؛ الجزء الرئيس من الملابس، غالبا ما يكون طويلا وواسعا وذو أكمام، تحته الملابس الداخلية وفوقه الخارجية. يستخدم للرجال والنساء)\nمثال: هو ذئب في ثوب حمل.",
 "服用": "جُرْعَة",
 "服膺": "ذَكَرَ, حَفِظَ (ذَكَرَ الشيءَ: نطق به أو أشار إليه بالكلام؛ ذَكَرَ شخصًا: استحضره في الذاكرة)",
 "服装": "زي, لباس (ملابس ذات طراز مميز أو لمناسبة خاصة)",
 "服装倒錯": "تخنث, لبيسة الجنس الآخر (ممارسة اعتماد ملابس أو أسلوب أو الدور الجنسي للجنس الآخر)",
 "服装倒錯者": "لبيس (للجنس الآخر), متشبه بالجنس الآخر (يحصل على إشباع جنسي من ارتداء ملابس الجنس الآخر) / لابس لملابس الجنس الآخر (شخص يتبنى لباس أو أسلوب أو الدور الجنسي للجنس الآخر)",
 "服装規定": "قواعد اللباس (مجموعة من القواعد تحدد الطريقة الصحيحة للملبس أثناء التواجد في مباني المؤسسة (أو تحدد ما هو ممنوع من الملابس))",
 "服部": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "服飾": "زي, لباس (ملابس ذات طراز مميز أو لمناسبة خاصة)",
 "服飾品": "كَمَالِيّ / مُسَاعِد (مُعَاوِن، مُسَانِد، من يقوم بالمُسَاعَدَة؛ بمعنى مُفِيد، يقال هذا عامل مساعد وهذه مادة مساعدة) / أَكْسِسْوَار\nمثال: علي مساعدة ماري.",
 "服飾店": "متجر ملابس رجالية (متجر تباع فيه ملابس الرجال)",
 "服飾見本": "لوحة أزياء (لوحة توضح أحدث صيحات الموضة في الملابس) / متأنق (رجل يهتم كثيراً بملابسه ومظهره)",
 "朔": "مُحَاق (الثَلَاثُ المُِحَاق: آخر ثلاث ليالٍ من كل شهر قمري وفيها السِّرَار وقيل ليلة خمس وست وسبع وقيل غير ذلك وقد تكون ليلتان في الأشهر ذَات التسع والعشرون…) / مَحَاق (الثَلَاثُ المُِحَاق: آخر ثلاث ليالٍ من كل شهر قمري وفيها السِّرَار وقيل ليلة خمس وست وسبع وقيل غير ذلك وقد تكون ليلتان في الأشهر ذَات التسع والعشرون…) / مِحَاق (الثَلَاثُ المُِحَاق: آخر ثلاث ليالٍ من كل شهر قمري وفيها السِّرَار وقيل ليلة خمس وست وسبع وقيل غير ذلك وقد تكون ليلتان في الأشهر ذَات التسع والعشرون…)",
 "朔月": "مُحَاق (الثَلَاثُ المُِحَاق: آخر ثلاث ليالٍ من كل شهر قمري وفيها السِّرَار وقيل ليلة خمس وست وسبع وقيل غير ذلك وقد تكون ليلتان في الأشهر ذَات التسع والعشرون…) / مَحَاق (الثَلَاثُ المُِحَاق: آخر ثلاث ليالٍ من كل شهر قمري وفيها السِّرَار وقيل ليلة خمس وست وسبع وقيل غير ذلك وقد تكون ليلتان في الأشهر ذَات التسع والعشرون…) / مِحَاق (الثَلَاثُ المُِحَاق: آخر ثلاث ليالٍ من كل شهر قمري وفيها السِّرَار وقيل ليلة خمس وست وسبع وقيل غير ذلك وقد تكون ليلتان في الأشهر ذَات التسع والعشرون…)",
 "朔望": "اقتران كوكبي (تكوين خط مستقيم لـ 3 أجرام سماوية (مثل الشمس والأرض والقمر) في نظام جاذبية)",
 "朔望月": "شهر قمري (الفترة بين قمرين جديدين متتاليين (29.531 يوماً))",
 "朔風": "رياح شمالية (رياح تهب من الشمال)",
 "朕": "نحن (ضَمِيرُ رَفْعٍ مُنْفَصِلٌ لِلْمُثَنَّى وَالْجَمْعِ ( مُذَكَّراً وَمُؤَنَّثاً )؛ ضَمِيرُ رَفْعٍ مُنْفَصِلٌ لِلْمُتَكَلِّمِ فِي حَالَةِ التَّعْظِيمِ)\nمثال: نحن مهتمون جدا.",
 "朗々": "شَفَّاف / وَاضِح",
 "朗らか": "مَسْرُور, فَرِح (كلُّ من يشعر بالسُّرُور)\nمثال: أما مسرور برؤيتك. / لَامِع, نَيِّر / مُسْتَنِير",
 "朗吟": "تِلَاوَة",
 "朗唱": "تِلَاوَة",
 "朗報": "بُشْرَى (الخبر السار) / بِشَارَة, إِنْجِيل",
 "朗朗": "شَفَّاف / وَاضِح",
 "朗詠": "تِلَاوَة",
 "朗誦": "تِلَاوَة",
 "朗読": "تِلَاوَة",
 "朗読会": "حَيْثِيَّة",
 "望": "بَدْر (البَدْرُ : القَمَرُ إِذا امْتَلأَ، وإِنما سُمِّيَ بَدْراً لأَنه يُبَادِرُ بالغُرُوب طُلُوع الشَّمْسِ…؛ البَدْرُ الغلامُ المكتمل أو الممتلئ)",
 "望の月": "بَدْر (البَدْرُ : القَمَرُ إِذا امْتَلأَ، وإِنما سُمِّيَ بَدْراً لأَنه يُبَادِرُ بالغُرُوب طُلُوع الشَّمْسِ…؛ البَدْرُ الغلامُ المكتمل أو الممتلئ)",
 "望ましい": "مرغوب فيه, مستحب (يستحق الامتلاك أو السعي إليه أو تحقيقه) / جَدِير, لَائِق (جدير بالاختيار خاصة كشريك زواج)\nمثال: وظيفة مرغوبة",
 "望み": "أُمْنِيَّة / رَغْبَة / مُنْيَة / تَمَنَّى / توقع, احتمال / تَنْقِيْب (نقّب إذا سار في البلاد طلباً للمهرب ، نقّب عن الأخبار وغيرها:بحث عنها،هو البحث عن كلّ شيء والتّفتيش مطلقاً؛ نقّب مبالغة في نَقَب ، نقّب عن الشيء :فحص عنه فحصاً بليغاً)",
 "望み薄": "مِنْ غَيْرِ المُرَجَّحِ (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "望む": "رَغِبَ ((رَغُبَ) رُغْبًا، ورَغابةً: اتَّسَع وعظُم؛ يقال: (رَغُبَ) الوادي) / رَغْبَة\nمثال: يمكن لتوم البقاء إن رغب. / تَوَقَّعَ / رَأَى (أدرك أو لاحظ شيئًا أو شخصًا بالعينين؛ اعْتَقَدَ، تَأَمَّلَ) / عَايَنَ / شاف\nمثال: رأى ياني منزلا.",
 "望むらくは": "لَيْتَ, تَمَنَّى (يفيد التمني)\nمثال: ليت بحاجة لتعمل ساعات إضافية.",
 "望外": "مُفَاجِئ",
 "望月": "بَدْر (البَدْرُ : القَمَرُ إِذا امْتَلأَ، وإِنما سُمِّيَ بَدْراً لأَنه يُبَادِرُ بالغُرُوب طُلُوع الشَّمْسِ…؛ البَدْرُ الغلامُ المكتمل أو الممتلئ)",
 "望楼": "مَرْقَب, بُرْج الْمُرَاقَبَة",
 "望樓": "مَرْقَب, بُرْج الْمُرَاقَبَة",
 "望潮": "سرطان عازف (سرطان حفار في المناطق الساحلية الأمريكية يتميز بوجود مخلب واحد متضخم جداً لدى الذكر)",
 "望火楼": "مَرْقَب, بُرْج الْمُرَاقَبَة",
 "望観": "رَصْد, مُشَاهَدَة (الرَّصْد : المُراقبة؛ الرَّصد الجوّي: دراسة الأَحوال الجوّيَّة لمعرفة تقلُّبات الطقس)",
 "望遠": "بَعِيد المَدَى (يغطي مسافة طويلة) / بعيد المسافة, طويل المدى (مكون من أو متعلق بـ أو كونه مكالمة هاتفية بعيدة المسافة)",
 "望遠レンズ": "عدسة زوم, عدسة مقربة (عدسة كاميرا تقوم بتكبير الصورة)",
 "望遠鏡": "تِلِسْكُوب, مِقْرَاب",
 "望遠鏡座": "الْمِقْرَاب",
 "望郷": "حَنِين, اِشْتِيَاق",
 "朝": "صَبَاح / غُدْوة / صُبْح (أَشْرَقَ، أَضَاءَ) / صباح / صُبُح (أَشْرَقَ، أَضَاءَ)\nمثال: كان يريد أن بصبح حاخاما. / إِفْطَار, فَطُور / فَطَرَ ( مَا تَفَطَّر مِنَ النَّبَاتِ، والفُطْر جِنْسٌ مِنَ الكَمْءِ أَبيض عِظَامٌ لأَن الأَرض تَنْفطر عَنْهُ؛  في هو اسم يطلق على طائفة من اللازهريات خالية من الكلوروفيل منها فصائل وأَجناس وأَنواع عديدة وتسمى أيضًا فُطْريّات، منها ما يُؤْكَلُ، وما هو سامٌ…)\nمثال: وجدت بعض الفطر. / سُلَالَة / حُكْم, حُكُومَة (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ) / حُكْم (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ) / حَكَمَ (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ)\nمثال: حكم علي بالموت. / نُقْطَة, عَلَامَة فَصْلِيَّة (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه) / حِصَّةٌ / عَصْر (مصدر للفعل \"عَصَرَ\"؛ أي مدة زمنية، دهر من الوقت)\nمثال: هذه هي نقطة ضعفه. / مَحْكَمَة (مقام الحاكم. وغلبت على مقام الحاكم الشرعي أي القاضي)\nمثال: عاد إلى المحكمة.",
 "朝から晩まで": "طُول اَلْيَوْم, طُول اَلنَّهَار (قُدرة؛ غنى أو فضل)\nمثال: قاس طول السرير.",
 "朝が早い": "استيقاظ, صحوة (فعل الاستيقاظ)\nمثال: كان استيقاظاً مبكراً",
 "朝ごはん": "إِفْطَار, فَطُور / فَطَرَ ( مَا تَفَطَّر مِنَ النَّبَاتِ، والفُطْر جِنْسٌ مِنَ الكَمْءِ أَبيض عِظَامٌ لأَن الأَرض تَنْفطر عَنْهُ؛  في هو اسم يطلق على طائفة من اللازهريات خالية من الكلوروفيل منها فصائل وأَجناس وأَنواع عديدة وتسمى أيضًا فُطْريّات، منها ما يُؤْكَلُ، وما هو سامٌ…)\nمثال: وجدت بعض الفطر.",
 "朝ご飯": "إِفْطَار, فَطُور / فَطَرَ ( مَا تَفَطَّر مِنَ النَّبَاتِ، والفُطْر جِنْسٌ مِنَ الكَمْءِ أَبيض عِظَامٌ لأَن الأَرض تَنْفطر عَنْهُ؛  في هو اسم يطلق على طائفة من اللازهريات خالية من الكلوروفيل منها فصائل وأَجناس وأَنواع عديدة وتسمى أيضًا فُطْريّات، منها ما يُؤْكَلُ، وما هو سامٌ…)\nمثال: وجدت بعض الفطر.",
 "朝に夕に": "دَائِمًا, أَبَدًا",
 "朝ぼらけ": "فَجْر, فَلَق (هو آخر اللَيْل أو أول النَهَار حين تنصدع الظُلْمَة من النُور)\nمثال: فجر توم البالونة.",
 "朝めし": "إِفْطَار, فَطُور / فَطَرَ ( مَا تَفَطَّر مِنَ النَّبَاتِ، والفُطْر جِنْسٌ مِنَ الكَمْءِ أَبيض عِظَامٌ لأَن الأَرض تَنْفطر عَنْهُ؛  في هو اسم يطلق على طائفة من اللازهريات خالية من الكلوروفيل منها فصائل وأَجناس وأَنواع عديدة وتسمى أيضًا فُطْريّات، منها ما يُؤْكَلُ، وما هو سامٌ…)\nمثال: وجدت بعض الفطر.",
 "朝メシ": "إِفْطَار, فَطُور / فَطَرَ ( مَا تَفَطَّر مِنَ النَّبَاتِ، والفُطْر جِنْسٌ مِنَ الكَمْءِ أَبيض عِظَامٌ لأَن الأَرض تَنْفطر عَنْهُ؛  في هو اسم يطلق على طائفة من اللازهريات خالية من الكلوروفيل منها فصائل وأَجناس وأَنواع عديدة وتسمى أيضًا فُطْريّات، منها ما يُؤْكَلُ، وما هو سامٌ…)\nمثال: وجدت بعض الفطر.",
 "朝ロ": "كُورِيَا الشَّمَالِيَّة (بلاد في جنوب شرق آسيا، يطلق عليها جغرافيا شِبْهُ الجَزِيْرَةِ الكُوْرِيَّة؛ دولتان تقعان في جنوب شرق آسيا تسميان كُوْرِيَا الشَمَالِيَّة وكُوْرِيَا الجَنُوْبِيَّة)\nمثال: أريد أن أزور كوريا.",
 "朝丘": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "朝井": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "朝倉": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "朝勃ち": "أثمان, مجد الصباح (أي من الكروم الملتفة المتنوعة ذات أزهار قمعية الشكل تغلق في وقت متأخر من اليوم)",
 "朝型": "صَبَاح / غُدْوة / صُبْح (أَشْرَقَ، أَضَاءَ) / صباح / صُبُح (أَشْرَقَ، أَضَاءَ)\nمثال: كان يريد أن بصبح حاخاما.",
 "朝型人間": "مُبَكِّر (شخص يستيقظ مبكراً جداً في الصباح) / باكور, مبكر (شخص يصل مبكرًا قبل الآخرين)",
 "朝基": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "朝夕": "باستمرار, بشكل متواصل (بشكل ثابت لا يتغير) / باستمرار, دائماً (بدون تنوع أو تغيير، في كل حالة)\nمثال: العالم يتغير باستمرار",
 "朝妻": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "朝寝坊": "استلقاء, بقاء في الفراش (البقاء لفترة طويلة في الفراش في الصباح)",
 "朝山": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "朝憲": "تَكْوِين / دُسْتُور, نِظَام (قَاعِدَة) / دُسْتُور (قَاعِدَة)\nمثال: العدالة مضمونة في الدستور.",
 "朝日": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "朝日る": "اِفْتَرَى, اِخْتَلَقَ",
 "朝日奈": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "朝明け": "فَجْر (هو آخر اللَيْل أو أول النَهَار حين تنصدع الظُلْمَة من النُور) / فَجْر, فَلَق (هو آخر اللَيْل أو أول النَهَار حين تنصدع الظُلْمَة من النُور) / شُرُوق (البُزُوغ، الطُلُوع؛ الوَقْت الذي تَشْرُق فيه الشَمْس) / شُرُوق, مَشْرِق (البُزُوغ، الطُلُوع؛ الوَقْت الذي تَشْرُق فيه الشَمْس)\nمثال: فجر توم البالونة.",
 "朝晩": "على مدار الوقت (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال.",
 "朝来": "مُنْذُ",
 "朝比奈": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "朝立ち": "أثمان, مجد الصباح (أي من الكروم الملتفة المتنوعة ذات أزهار قمعية الشكل تغلق في وقت متأخر من اليوم)",
 "朝腹": "تفاهة, شيء تافه (شيء قليل الأهمية) / تفاهة, ضآلة (صفة كون الشيء غير مهم وتافهاً أو سطحياً) / أمر تافه, تفاهة (تفصيل يعتبر غير مهم)",
 "朝臣": "رجل حاشية (مرافق في بلاط الحاكم)",
 "朝見": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "朝議": "المجلس الخاص (مجلس استشاري للحاكم (خاصة للتاج البريطاني))",
 "朝賀": "أول أيام السنة, يوم رأس السنة (اليوم الأول من السنة)",
 "朝起ち": "أثمان, مجد الصباح (أي من الكروم الملتفة المتنوعة ذات أزهار قمعية الشكل تغلق في وقت متأخر من اليوم)",
 "朝長": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "朝陽": "شُرُوق, شُرُوق الشَّمْس (البُزُوغ، الطُلُوع؛ الوَقْت الذي تَشْرُق فيه الشَمْس) / شُرُوق, صَحْوَة (البُزُوغ، الطُلُوع؛ الوَقْت الذي تَشْرُق فيه الشَمْس)\nمثال: شروق الشمس جميل هذا الصباح.",
 "朝露": "كُورِيَا الشَّمَالِيَّة (بلاد في جنوب شرق آسيا، يطلق عليها جغرافيا شِبْهُ الجَزِيْرَةِ الكُوْرِيَّة؛ دولتان تقعان في جنوب شرق آسيا تسميان كُوْرِيَا الشَمَالِيَّة وكُوْرِيَا الجَنُوْبِيَّة)\nمثال: أريد أن أزور كوريا.",
 "朝顔": "أثمان نيلي, مجد الصباح الياباني (عشب متسلق استوائي حولي من العالم القديم يتميز بمجموعة واسعة من الألوان وزهور مكشكشة أو مزدوجة) / قُمْعِيّ الشَّكْل (على شكل قِمع) / ختمية سورية, ورد شارون (شجيرة آسيوية أو شجرة شجيرية صغيرة ذات زهور وردية أو أرجوانية أو بيضاء مبهرجة على شكل جرس وأوراق ثلاثية الفصوص عادة؛ تزرع على نطاق واسع في أمريكا…)",
 "朝食": "إِفْطَار, فَطُور / فَطَرَ ( مَا تَفَطَّر مِنَ النَّبَاتِ، والفُطْر جِنْسٌ مِنَ الكَمْءِ أَبيض عِظَامٌ لأَن الأَرض تَنْفطر عَنْهُ؛  في هو اسم يطلق على طائفة من اللازهريات خالية من الكلوروفيل منها فصائل وأَجناس وأَنواع عديدة وتسمى أيضًا فُطْريّات، منها ما يُؤْكَلُ، وما هو سامٌ…)\nمثال: وجدت بعض الفطر.",
 "朝飯": "إِفْطَار, فَطُور / فَطَرَ ( مَا تَفَطَّر مِنَ النَّبَاتِ، والفُطْر جِنْسٌ مِنَ الكَمْءِ أَبيض عِظَامٌ لأَن الأَرض تَنْفطر عَنْهُ؛  في هو اسم يطلق على طائفة من اللازهريات خالية من الكلوروفيل منها فصائل وأَجناس وأَنواع عديدة وتسمى أيضًا فُطْريّات، منها ما يُؤْكَلُ، وما هو سامٌ…)\nمثال: وجدت بعض الفطر.",
 "朝飯前": "بَسِيطَة, لُقْمَة سَائِغَة",
 "朝餉": "إِفْطَار, فَطُور / فَطَرَ ( مَا تَفَطَّر مِنَ النَّبَاتِ، والفُطْر جِنْسٌ مِنَ الكَمْءِ أَبيض عِظَامٌ لأَن الأَرض تَنْفطر عَنْهُ؛  في هو اسم يطلق على طائفة من اللازهريات خالية من الكلوروفيل منها فصائل وأَجناس وأَنواع عديدة وتسمى أيضًا فُطْريّات، منها ما يُؤْكَلُ، وما هو سامٌ…)\nمثال: وجدت بعض الفطر.",
 "朝鮮": "كُورْيَا (بلاد في جنوب شرق آسيا، يطلق عليها جغرافيا شِبْهُ الجَزِيْرَةِ الكُوْرِيَّة؛ دولتان تقعان في جنوب شرق آسيا تسميان كُوْرِيَا الشَمَالِيَّة وكُوْرِيَا الجَنُوْبِيَّة) / كُورِيَا (بلاد في جنوب شرق آسيا، يطلق عليها جغرافيا شِبْهُ الجَزِيْرَةِ الكُوْرِيَّة؛ دولتان تقعان في جنوب شرق آسيا تسميان كُوْرِيَا الشَمَالِيَّة وكُوْرِيَا الجَنُوْبِيَّة)\nمثال: أريد أن أزور كوريا.",
 "朝鮮人": "كُورِيّ / كوري شمالي (من أو يتعلق بكوريا الشمالية أو شعبها أو ثقافتها أو يميزهم) / كوري شمالي (كوري من كوريا الشمالية)",
 "朝鮮人参": "باناكس, جنسنغ (عشب صيني بأوراق مركبة كفية وأزهار مخضرة صغيرة وجذور عطرية متشعبة يُعتقد أن لها قوى طبية)",
 "朝鮮人民共和国": "الْجُمْهُورِيَّة الشَّعْبِيَّة",
 "朝鮮労働党": "حزب العمال (حزّب القومَ:جعلهم أحزاباً ، قوّاهم ، جعلهم من حزبه؛ حَزَّبْتُ القُرْآنَ: جَعَلْتُه أَحْزَاباً)\nمثال: التحقت بذلك الحزب.",
 "朝鮮半島": "شِبْه الْجَزِيرَةِ الْكُورِيَّة",
 "朝鮮文字": "هَانْغُول",
 "朝鮮朝顔": "تفاح شائك, داتورا (أي من عدة نباتات من جنس داتورا)",
 "朝鮮民主主義人民共和国": "جُمْهُورِيَّة كُورِيَا اَلدِّيمُقْرَاطِيَّة اَلشَّعْبِيَّة",
 "朝鮮玉入れ": "باتشينكو (لعبة بينبول يابانية تُلعب على لوحة عمودية)",
 "朝鮮薊": "أرضي شوكي, خرشوف (رأس زهرة يشبه الشوك بأوراق وقلب لحمي صالح للأكل) / أرضي شوكي, خرشوف (نبات متوسطي يشبه الشوك يزرع على نطاق واسع لرأسه الزهري الكبير الصالح للأكل)",
 "朝鮮語": "كُورِيّ",
 "期": "نُقْطَة, عَلَامَة فَصْلِيَّة (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه) / حِصَّةٌ / عَصْر (مصدر للفعل \"عَصَرَ\"؛ أي مدة زمنية، دهر من الوقت)\nمثال: هذه هي نقطة ضعفه. / فُرْصَة / عُمْر ((في الإسلام) أبو حفص عمر بن الخطاب العدوي القرشي، ثاني الخلفاء الراشدين في المذهب السني) / سِنّ ((سَنَّ) السِّكِّينَ و نحْوَهُ يَسُنُّ سَنًّا: أَحَدَّهُ؛ فهو مسنون وسَنِين)\nمثال: جون في عمر أخي. / اِصْطِلَاح, مُصْطَلَح / وَقْت (\"بَقِيَ وَقْتاً عِنْدَهُ \" : أَيْ مِقْدَاراً مِنَ الزَّمَنِ؛ \"جَاءَ فِي الوَقْتِ الْمُنَاسِبِ \" : فِي اللَّحْظَةِ الْمُنَاسِبَةِ) / مَرَّة, مرة (مؤنث مُرّ، صفة ما كان بها مرارة) / حِين, وَقْت ((حَيَّنَه): جعل لَهُ حينا؛ (حَيَّنَ) الله فلَانا: لم يوفقه للرشاد)\nمثال: حان وقت الذهاب.",
 "期が熟す": "في الوقت الحالي, مؤقتاً (بشكل مؤقت)\nمثال: سنتوقف في الوقت الحالي",
 "期す": "صَلَّحَ / أَصْلَحَ / تَوَقَّعَ / حَلَّ (للعقدة: ضد عَقْدها؛ للجامد في السائل: إذابته)\nمثال: حل زيري المشكل.",
 "期する": "صَلَّحَ / أَصْلَحَ / تَوَقَّعَ / حَلَّ (للعقدة: ضد عَقْدها؛ للجامد في السائل: إذابته)\nمثال: حل زيري المشكل.",
 "期せずして": "بالصدفة, عرضياً (بدون تخطيط مسبق) / بشكل غير متوقع, فجأة (بطريقة لم تكن متوقعة)\nمثال: التقيا بالصدفة",
 "期は熟す": "في الوقت الحالي, مؤقتاً (بشكل مؤقت)\nمثال: سنتوقف في الوقت الحالي",
 "期内": "مُدَّة / فَتْرَة / فِي حِين, بَيْنَمَا (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "期待": "أفق, استشراف (اعتقاد بشأن المستقبل (أو تصور ذهني له)) / توقع رياضي, قيمة متوقعة (مجموع قيم متغير عشوائي مقسوماً على عدد القيم) / توقع (الشعور بأن شيئاً ما على وشك الحدوث) / ترقب, توقع (الترقب مع الثقة بالتحقق) / مُشْرِق, وَاعِد (من المرجح أن يسير على نحو جيد في المستقبل) / مُبَشِّر, وَاعِد (يُنْبِئ بِاحْتِمال النَّجاح أَوْ نَتيجَة إيجابِيَّة)",
 "期待はずれ": "خَيْبَة أَمَل",
 "期待値": "قِيمَة مُتَوَقَّعَة / أفق, استشراف (اعتقاد بشأن المستقبل (أو تصور ذهني له)) / توقع رياضي, قيمة متوقعة (مجموع قيم متغير عشوائي مقسوماً على عدد القيم) / توقع (الشعور بأن شيئاً ما على وشك الحدوث) / ترقب, توقع (الترقب مع الثقة بالتحقق)",
 "期待外れ": "خَيْبَة أَمَل",
 "期日": "أَجَل, مُهْلَة (مُدَّة الشيء، وَقْت أو مَوْعِد انتهاء الشيء أو حلوله)\nمثال: اقترب أجل زيري.",
 "期望": "تَوَقَّعَ, اِرْتَقَبَ",
 "期末テスト": "أَخِير, نِهَائِيّ (لا يمكن تغييره أو التراجع عنه) / أَخِير, خِتَامِيّ (يَقَعُ فِي نِهَايَةِ شَيْءٍ أَوْ يُشَكِّلُ خَاتِمَتَهُ) / أَخِير, خِتَامِيّ (حاسم في عملية أو مسار تقدمي) / امتحان نهائي (امتحان يجرى في نهاية الفصل الدراسي)",
 "期末試験": "امتحان نهائي (امتحان يجرى في نهاية الفصل الدراسي)",
 "期生": "استنشاق, شهيق (فعل الشهيق؛ سحب الهواء (أو غازات أخرى) للداخل كما في التنفس) / ابتلاع, استهلاك (عملية إدخال الطعام إلى الجسم عن طريق الفم (مثل الأكل)) / مأخذ, مدخل (فتحة يتم من خلالها إدخال السائل إلى أنبوب أو حاوية)",
 "期間": "نُقْطَة, عَلَامَة فَصْلِيَّة (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه) / حِصَّةٌ / عَصْر (مصدر للفعل \"عَصَرَ\"؛ أي مدة زمنية، دهر من الوقت)\nمثال: هذه هي نقطة ضعفه.",
 "期間中": "خِلَالَ, فِي",
 "期間工": "عامل مصنع (عامل في طاحونة أو مصنع)",
 "期間従業員": "موظف مؤقت (عامل (خاصة في مكتب) يتم تعيينه على أساس مؤقت)",
 "期限": "اِصْطِلَاح, مُصْطَلَح / حد زمني, مهلة (فترة زمنية يجب خلالها إنجاز شيء ما أو إكماله)",
 "期頤": "مِئَة (يَدُلُّ عَلَى العَدَد 100)",
 "朦々": "كَثِيف, غَلِيظ / غَامِض, مُبْهَم (غير واضح التعبير أو المعنى) / غامض, غير محدد (غير محدود أو مقرر أو مميز بدقة) / بَاهِت, خَافِت (يَفْتَقِر إِلَى الوُضُوح أَوِ التَّمَيُّز)\nمثال: مصطلح غير محدد (مبهم)",
 "朦朦": "كَثِيف, غَلِيظ / غَامِض, مُبْهَم (غير واضح التعبير أو المعنى) / غامض, غير محدد (غير محدود أو مقرر أو مميز بدقة) / بَاهِت, خَافِت (يَفْتَقِر إِلَى الوُضُوح أَوِ التَّمَيُّز)\nمثال: مصطلح غير محدد (مبهم)",
 "朦朧": "خَافِت, مُعْتَدِل الإِضَاءَة (ضَعِيف الضَّوْء؛ غَيْر سَاطِعٍ أَوْ قَاسٍ) / مُخْفَت, مُعْتِم (جُعل معتماً أو أقل سطوعاً) / بَطِيء الفَهْم, كَلِيل الذِّهْن (بطيء التعلّم والاستيعاب؛ يفتقر إلى الحدّة الذهنيّة) / بَاهِت, خَافِت (يَفْتَقِر إِلَى الوُضُوح أَوِ التَّمَيُّز)\nمثال: أضواء القاعة المخفتة جلبت صمتاً من الترقب",
 "朧": "ضَبَابِيّ, مُعْتِم (ممتلئ بالضباب أو السديم) / ضَبَابِيّ, مُشَوَّش (غَيْر وَاضِح أَوْ مُبْهَم الخُطُوط)",
 "朧げ": "غَامِض, مُبْهَم (غير واضح التعبير أو المعنى) / غامض, غير محدد (غير محدود أو مقرر أو مميز بدقة) / بَاهِت, خَافِت (يَفْتَقِر إِلَى الوُضُوح أَوِ التَّمَيُّز)\nمثال: مصطلح غير محدد (مبهم)",
 "朧ろ": "ضَبَابِيّ, مُعْتِم (ممتلئ بالضباب أو السديم) / ضَبَابِيّ, مُشَوَّش (غَيْر وَاضِح أَوْ مُبْهَم الخُطُوط)",
 "朧ろ気": "غَامِض, مُبْهَم (غير واضح التعبير أو المعنى) / غامض, غير محدد (غير محدود أو مقرر أو مميز بدقة) / بَاهِت, خَافِت (يَفْتَقِر إِلَى الوُضُوح أَوِ التَّمَيُّز)\nمثال: مصطلح غير محدد (مبهم)",
 "朧気": "غَامِض, مُبْهَم (غير واضح التعبير أو المعنى) / غامض, غير محدد (غير محدود أو مقرر أو مميز بدقة) / بَاهِت, خَافِت (يَفْتَقِر إِلَى الوُضُوح أَوِ التَّمَيُّز)\nمثال: مصطلح غير محدد (مبهم)",
 "朧雲": "طبقي متوسط (سحابة طبقية على ارتفاع متوسط يبلغ 2 أو 3 أميال)",
 "木": "شَجَر, شَجَرَة (الأمر المختلف بين الناس؛ مخرج الفَم أو مُؤَخَّره. ومنه الحروف الشَجْرِيَّة) / شَجَرَة (نبات قائم على سَاق صلبة؛ مخطط له تفرعات)\nمثال: توم يتسلق شجرة. / خَشَب, خشب (هو ما غَلَظَ وصَلُبَ من أصول الشَجَر وفروعها مثل الجِذْع والأغْصَان؛ هو ما صنع من جذوع أو أغصان الشَجَر)\nمثال: نحن نقطع الخشب. / الْخَمِيس, يَوْم الْخَمِيس / خَشَب, خشب (هو ما غَلَظَ وصَلُبَ من أصول الشَجَر وفروعها مثل الجِذْع والأغْصَان؛ هو ما صنع من جذوع أو أغصان الشَجَر)\nمثال: نحن نقطع الخشب.",
 "木々": "شَجَر, شَجَرَة (الأمر المختلف بين الناس؛ مخرج الفَم أو مُؤَخَّره. ومنه الحروف الشَجْرِيَّة) / شَجَرَة (نبات قائم على سَاق صلبة؛ مخطط له تفرعات)\nمثال: توم يتسلق شجرة.",
