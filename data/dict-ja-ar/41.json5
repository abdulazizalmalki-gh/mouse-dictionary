 "構造化問い合わせ言語": "إِس كْيُو إِل, إسْ كْيُو إلْ",
 "構造化照会言語": "إِس كْيُو إِل, إسْ كْيُو إلْ",
 "構造式": "صيغة بنائية (صيغة جزيئية موسعة تظهر ترتيب الذرات داخل الجزيء)",
 "構造構文": "تصوّر, فكرة (فكرة مجردة أو عامة مستنتجة أو مشتقة من حالات محددة)",
 "構造物": "هَيْكَل",
 "構造的": "بِنْيَوِيّ, هَيْكَلِيّ (يَتَعَلَّقُ بِالبِنْيَةِ المُنَظَّمَةِ فِي حَقْلٍ دِرَاسِيٍّ مُعَيَّنٍ)\nمثال: مهندس إنشائي",
 "構造言語学": "بنيوية, لسانيات بنيوية (اللسانيات المعرفة كتحليل للهياكل الشكلية في نص أو خطاب)",
 "構造運動": "حركة تكتونية, حركة قشرية (حركة ناتجة عن تشوه القشرة الأرضية أو مسببة له)",
 "構造遺伝子": "جين هيكلي (جين يتحكم في إنتاج بروتين أو ببتيد معين)",
 "構音": "تمفصل (عملية ربط الأشياء بطريقة تجعل الحركة ممكنة)\nمثال: التعبير عن مشاعري",
 "構音障害": "رتة, عسر التلفظ (ضعف القدرة التعبيرية الناتجة عن عيوب في الأعصاب الحركية المحيطية أو في عضلات…)",
 "槌": "مِطْرَقَة, شَاكُوش (أداة رأسها من حَدِيد ولها ذراع غالبا ما تكون من خَشَب تستخدم لضرب المِسْمَار في…)\nمثال: سأشتري له مطرقة.",
 "槌矛": "دَبُّوس",
 "槌音": "دك, طرق (فعل الطرق (توجيه ضربات ثقيلة متكررة))\nمثال: فاجأه طرق القبضات المفاجئ",
 "槌骨": "عُظيمة المطرقة",
 "槍": "رُمْح, حَرْبَة (عُود طَوِيلٌ فِي رَأْسِهِ حَرْبَة يُطعَن بِهَا الْعَدُوُّ، يُجمع جَمْع تَكْسِير…)\nمثال: راس الرمح كان مغموسا في سم قاتل. / مِزْرَاق / مشرط (سكين جراحي بشفرة مدببة ذات حدين؛ يستخدم للثقب والشقوق الصغيرة) / سَاخِر, مُسْتَهْزِئ (يُسيء لفظياً؛ يُعبِّر عن الازدراء أو السخرية) / ذُو مِقْبَض طَوِيل (لَهُ مِقْبَض أَوْ يَد طَويلَة) / سِلَاح, أَسْلِحَة",
 "槍の穂先": "رأس حربة (عُضْو مِنَ ٱلْجَسَدِ يَحْوِي الدِّمَاغ والفَم والأَنْف والعَيْنَيْن…)\nمثال: قطع سامي رأس كلب.",
 "槍使い": "رَمَّاح (جمع للاسم رُمْح)",
 "槍先": "رأس حربة (عُضْو مِنَ ٱلْجَسَدِ يَحْوِي الدِّمَاغ والفَم والأَنْف والعَيْنَيْن…)\nمثال: قطع سامي رأس كلب.",
 "槍兵": "رَمَّاح (جمع للاسم رُمْح)",
 "槍投げ": "مِزْرَاق",
 "槍持ち": "كومبارس, ممثل إضافي (ممثل ثانوي يظهر في مشاهد الحشود)",
 "槍杯": "وَاحِد, وَاحِدَة (في وَ: العدد واحد العدد الاول)",
 "槍玉": "ضَحِيَّة",
 "槍術家": "رَمَّاح (جمع للاسم رُمْح)",
 "槍鉋": "ذُو مِقْبَض طَوِيل (لَهُ مِقْبَض أَوْ يَد طَويلَة)",
 "槍騎兵": "رماح, فارس الرمح ((سابقاً) جندي خيال مسلح برمح)",
 "槐": "شجرة الباغودا اليابانية, صفيراء يابانية (شجرة نفضية جميلة مستديرة الرأس لها أوراق مركبة خضراء داكنة وعناقيد غزيرة من…)",
 "槐樹": "شجرة الباغودا اليابانية, صفيراء يابانية (شجرة نفضية جميلة مستديرة الرأس لها أوراق مركبة خضراء داكنة وعناقيد غزيرة من…)",
 "槐角": "فَوَاكِه مُجَفَّفَة",
 "槓杆": "مُخْل\nمثال: أغلق دان المحل.",
 "槓桿": "مُخْل\nمثال: أغلق دان المحل.",
 "様": "فَوْضَى, اِخْتِلَاط / ـًا، ـاً, لـ (الْأَلِفُ بِدُونِ هَمْزَةٍ ؛ تُسْتَخْدَمُ فِي آخِرِ أَوْ وَسَطِ الكلام لمد…) / سيد (صيغة خطاب للرجل) / وَضْع (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه)\nمثال: لقد أزمت الوضع. / صُورَة, شَكْل\nمثال: اجلس بشكل مريح. / حَبَّ (الزرع، كبيرا كان أم صغيرا؛ بَذْرُ الزرع)\nمثال: زيري بحب المال. / شَيْء, حاجة (الموجود عرضاً كان أو جوهراً، ويصح أن يتصور ويخبر عنه؛ مَا أُخْبِرَ عَنْهُ: سواء…)\nمثال: في يدها شيء ما. / سَابِقَة (فِي : لَاصِقَة تزاد قبل الكلمة لتحويل مبناها وتغيير معناها. وهي وسيلة اقتصادية…)\nمثال: افتقد لزوجته السابقة.",
 "様々": "مُخْتَلِف, مُتَنَوَّع",
 "様な": "حَبَّ (الزرع، كبيرا كان أم صغيرا؛ بَذْرُ الزرع)\nمثال: زيري بحب المال. / فَكَرَ, فَكَّرَ (أَعْمَلَ عقله ليصل إلى شيءٍ، ليحل مشكلةً. (يتعدى تعدية عامة بفي))\nمثال: إنها فكرة جيدة.",
 "様に": "حَبَّ (الزرع، كبيرا كان أم صغيرا؛ بَذْرُ الزرع)\nمثال: زيري بحب المال. / حَتَّى (يفيد انتهاء الغاية؛ يفيد الغاية)\nمثال: انتظر حتى أجلس. / اِسْتَطَاعَ (أَطَاقَ الشَّيءَ وقَدَرَ عليه، أَمْكَنَهُ الشَّيءُ)\nمثال: توم استطاع ان يهرب",
 "様はない": "بذيء, غير لائق (مسيء للذوق العام خاصة في المسائل الجنسية)\nمثال: قصة واقعية لكنها ليست فاحشة",
 "様は無い": "بذيء, غير لائق (مسيء للذوق العام خاصة في المسائل الجنسية)\nمثال: قصة واقعية لكنها ليست فاحشة",
 "様体": "شَرْط (شَرِطَ فلانٌ يَشْرِطِ شَرْطًا: وقع في أَمر عظيمٍ)\nمثال: صرخ ليون: \"شرطة!\"",
 "様変わり": "تَحَوُّل (صَارَ غير ما كان)\nمثال: تحول ياني إلى وحش.",
 "様変わる": "تَحَوَّلَ, مَسَخَ (صَارَ غير ما كان)\nمثال: تحول ياني إلى وحش.",
 "様子": "وَضْع (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه)\nمثال: لقد أزمت الوضع. / ظُهُور (عِيْدُ الظُّهُوْر: عيد للنَصَارَى يُسَمَّى أيضا عيد التَجَلِّي)\nمثال: لا أحد لاحظ ظهور الدب. / لافِتَة\nمثال: توم وقع و أصيب.",
 "様子見": "مِسْبَار",
 "様式": "أُسْلُوب (الطَرِيْق والفنّ من القول؛ الطريقة بصورة عامة سواء كانت من القول أو الفعل أو…)\nمثال: هو يحب أسلوب معطوب.",
 "様式化": "أسلوبية, تنميط (فعل التنميط؛ الجعل مطابقاً لأسلوب معين)",
 "様式美": "عَرِيق, مُوَقَّر بِالقِدَم (محترم بسبب القِدَم أو طول الاستخدام)",
 "様態": "صُورَة, شَكْل\nمثال: اجلس بشكل مريح.",
 "様方": "عِنَايَة, رِعَايَة",
 "様様": "مُخْتَلِف, مُتَنَوَّع",
 "様相": "تعبير, ملامح (المشاعر الظاهرة على وجه الشخص)\nمثال: تعبير حزين / نمط علاجي, وسيلة علاجية (طريقة للعلاج تتضمن علاجاً علاجياً فيزيائياً أو كهربائياً)",
 "様相論理": "منطق الموجهات (نظام منطقي تشبه خصائصه الشكلية مفاهيم أخلاقية ومعرفية معينة)",
 "様相論理学": "منطق الموجهات (نظام منطقي تشبه خصائصه الشكلية مفاهيم أخلاقية ومعرفية معينة)",
 "槙原": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "槙本": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "槙肌": "جلفطة, مادة سد الشقوق (حشو ومانع تسرب مقاوم للماء يستخدم في البناء والإصلاح لجعله غير منفذ للماء)",
 "槭樹": "قَيْقَب",
 "槻沢": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "槽": "فِنْطَاس, صِهْرِيج / بَدَن, جِسْم ((بَدُنَ) الرَّجُلُ مِنْ بَابِ ظَرُفَ وَ (بُدْنًا) أَيْضًا بِوَزْنِ قُفْلٍ أَيْ…) / طَشْت\nمثال: ملأت الحوض ماءا.",
 "槿": "ختمية سورية, ورد شارون (شجيرة آسيوية أو شجرة شجيرية صغيرة ذات زهور وردية أو أرجوانية أو بيضاء مبهرجة…)",
 "樋": "فِنْطَاس / كوليس, مجرى انزلاق (عضو خشبي محفور (مخدد) لاستيعاب لوح منزلق)",
 "樋口": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "樋嘴": "مزراب (جرغول) (زخرفة تتكون من شكل منحوت بشكل غريب لشخص أو حيوان)",
 "樋川": "عَيْن, يَنْبُوع (المُعَايَنَة والمشاهدة؛ العين : حاسة البصر والرؤية - مؤنث - تكون للإنسان وغيره…)\nمثال: كان عين ليلى مسودة.",
 "樋殿": "مِرْحَاض, تواليت",
 "樋浦": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "樋門": "خَوْخَة",
 "樏": "حذاء ثلجي (جهاز يساعدك على المشي فوق الثلج العميق؛ إطار خفيف الوزن يشبه المضرب مقوى بقطع…)",
 "樓": "بُرْج (ظهر وارتفع)\nمثال: وصل كارل إلى برج آخر. / برج حربي, برج مدفع (منصة أسلحة مستقلة تحتوي على مدافع وقابلة للدوران) / بَيْت دَعَارَة, مَبْغًى (بمعنى قضى الليل؛ الخَيْمَة من الشَعْر يَبِيت فيها البَدَوي أو المُسافر. الجمع…)\nمثال: لنعد إلى البيت.",
 "樗": "أزدرخت, زنزلخت (شجرة من شمال الهند والصين لها أزهار أرجوانية وثمار صفراء صغيرة غير صالحة للأكل…)",
 "樗才": "زيادة لا لزوم لها, عجلة خامسة (شخص أو شيء غير مرغوب فيه وغير مطلوب)",
 "樗材": "زيادة لا لزوم لها, عجلة خامسة (شخص أو شيء غير مرغوب فيه وغير مطلوب) / أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك…)\nمثال: لم تقصد أي أذى.",
 "樗沢": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "樗蚕": "عثة سينثيا (عثة آسيوية كبيرة أُدخلت إلى الولايات المتحدة؛ تتغذى اليرقات على شجرة السماء)",
 "標": "دَرَجَة\nمثال: الصهاينة أشر من النازيين. / رَمْز, عَلَامَة (رمز (جمعه رموز)؛ الرمز يعني الرسم الذي يعبر عن شيء معين وعموما فأن العلامة…)\nمثال: تمثال الحرية رمز لأمريكا. / شَارَة / دَلِيل, بُرْهَان / إِرْشَاد, هِدَايَة / دَرَجَة\nمثال: الصهاينة أشر من النازيين. / لوحة الاسم (لوحة تحمل اسماً)",
 "標す": "تَرَكَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد…)\nمثال: لقد ترك لك هذا.",
 "標定": "توحيد المعايير, معايرة (فعل فحص أو تعديل دقة أداة قياس (بالمقارنة مع معيار))\nمثال: احتاج مقياس الحرارة إلى معايرة",
 "標徴": "رَمْز, عَلَامَة (رمز (جمعه رموز)؛ الرمز يعني الرسم الذي يعبر عن شيء معين وعموما فأن العلامة…)\nمثال: تمثال الحرية رمز لأمريكا.",
 "標数": "صِفَة (صُفَّة المَسْجِد هي موضع مُظَلَّل منه بين جدران ثلاثة؛ هي غُرْفَة ذات ثلاث…)\nمثال: محاسبة النفس صفة حميدة.",
 "標旗": "بِطَاقَة هُوِيَّة",
 "標本": "عَيِّنَة (جزء من الأنسجة أو الدم أو البول يؤخذ لأغراض التشخيص)\nمثال: جمعوا عينة بول لتحليل البول / مِثَال, مَثَل / عَيِّنَة",
