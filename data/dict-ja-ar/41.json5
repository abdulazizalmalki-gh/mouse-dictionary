 "月着陸船": "مركبة الهبوط على القمر, وحدة قمرية (مركبة فضائية تحمل رواد الفضاء من وحدة القيادة إلى سطح القمر والعودة)",
 "月砂": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "月経": "حَيْض, طَمْث (الحَيْضُ : الدورة التي ينزل فيها الدم من رَحِم المرأة البالغة في أَيَّامٍ…)",
 "月経前": "سابق للحيض (مكون من أو متعلق بـ أو يحدث خلال الوقت الذي يسبق الحيض مباشرة)",
 "月経前症候群": "متلازمة ما قبل الحيض (متلازمة تحدث لدى العديد من النساء قبل 2 إلى 14 يوماً من بدء الحيض)",
 "月経周期": "حيض, دورة شهرية (دورة متكررة (تبدأ عند البلوغ وتنتهي عند انقطاع الطمث) تستعد فيها بطانة الرحم…)\nمثال: متوسط الدورة الشهرية هو 28 يوماً",
 "月経困難症": "عسر الطمث (حيض مؤلم)",
 "月経帯": "فوطة صحية (وسادة ماصة تستخدم لمرة واحدة؛ تُرتدى لامتصاص تدفق الدورة الشهرية)",
 "月経過多": "حيض, طمث (تدفق الدم من الرحم؛ يحدث على فترات شهرية تقريباً خلال سنوات الإنجاب للمرأة)",
 "月経閉止期": "إِيَاس",
 "月給日": "يوم الدفع, يوم الراتب (اليوم الذي تتلقى فيه أجراً عن عملك)",
 "月給泥棒": "انتهازي, طفيلي (شخص يستغل كرم الآخرين)",
 "月色": "ضَوْء قَمَر (النُّور؛ مصدر ضَاء)\nمثال: ضوء القمر ضعيف.",
 "月華": "قَمَر, قمر (الكَوْكَب الذي يدور حول الأرْض ويظهر غالبا في الليل ويعكس ضوء الشَمْس. مذكر لا…)",
 "月蝕": "خُسُوف اَلْقَمَر",
 "月見草": "أخدرية, زهرة الربيع المسائية",
 "月見里": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "月読": "قَمَر, قمر (الكَوْكَب الذي يدور حول الأرْض ويظهر غالبا في الليل ويعكس ضوء الشَمْس. مذكر لا…)\nمثال: ضوء القمر ضعيف. / تْسُوكُويُومِي",
 "月読み": "قَمَر, قمر (الكَوْكَب الذي يدور حول الأرْض ويظهر غالبا في الليل ويعكس ضوء الشَمْس. مذكر لا…)\nمثال: ضوء القمر ضعيف. / تْسُوكُويُومِي",
 "月讀": "قَمَر, قمر (الكَوْكَب الذي يدور حول الأرْض ويظهر غالبا في الليل ويعكس ضوء الشَمْس. مذكر لا…)\nمثال: ضوء القمر ضعيف. / تْسُوكُويُومِي",
 "月輪": "قَمَر, قمر (الكَوْكَب الذي يدور حول الأرْض ويظهر غالبا في الليل ويعكس ضوء الشَمْس. مذكر لا…)\nمثال: ضوء القمر ضعيف.",
 "月長石": "حَجَرُ ٱلْقَمْر (حَجَرَ عليه الأمرَ:مَنَعَه منه ، حجر الشّيء على نفسه:خَصَّها به وقصره عليها…)\nمثال: عوقب زيري بالحجر.",
 "月間": "شَهْر (اسم مفرد: مدة زمنية قدرها 28 أو 29 أو 30 أو 31 يوما، والشَّهرُ جزءٌ من اثني عشر…)\nمثال: رمضان شهر حرام.",
 "月隠り": "يوم الحساب, يوم الدين (اليوم في نهاية الزمان الذي سيقضي فيه الله بمصير جميع البشر وفقاً لأعمالهم)",
 "月面着陸": "هُبُوط عَلَى الْقَمَر",
 "月食": "خُسُوف اَلْقَمَر",
 "月餅": "كَعْكَة اَلْقَمَر (واحدة الكَعْك؛ حَلْوَى تُصْنع من الدَقِيق والحَلِيب والسُكَّر والزَيت ويخبز…)\nمثال: خبزت كعكة لتوم.",
 "月魄": "ضَوْء قَمَر (النُّور؛ مصدر ضَاء)\nمثال: ضوء القمر ضعيف.",
 "有": "وُجُود, كَيْنُونَة (خِلاف العَدَم، وهي الحالة التي يكون الشيء أو الأمر أو الشخص فيها كَائِن…)\nمثال: لا وجود للصدف ! / مَسّ, تَلَبُّس / شَرِكَة مَحْدُودَة / مَوْجُود (الذي له وجود)\nمثال: أنا موجود لوحدي / بشكل حسن, على ما يرام (بطريقة مرضية أو كافية)\nمثال: ستبلي حسناً بمفردها / كَانَ (اِتَّصَفَ. (فعل ناقص)؛ حَدَثَ)\nمثال: كان الكلب ميتا.",
 "有する": "مَلَكَ, اِمْتَلَكَ (لغة في المَالِك، وهو الذي يَمْلِكُ؛ السُلْطَان الحَاكِم الذي يملك الأَرْض…)\nمثال: زيري ملك لنفسه.",
 "有った": "مَاضٍ, الْمَاضِي ((في النحو) زمن نحوي يدل على حدث قد وقع، أو وُجِد قبل الآن بوقت ما)",
 "有らざる": "لَا, مَا (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر…)",
 "有らず": "لَا, مَا (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر…)",
 "有らずもがな": "غَيْر ضَرُورِيّ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "有らない": "مَعْدُوم",
 "有らぬ": "مُخْطِئ\nمثال: نحن نرفض الظلم. / مُخْتَلِف\nمثال: أرني مثالا آخر. / مُفَاجِئ",
 "有らぬ事": "لَا يَخْطُرُ عَلَى الْبَالِ (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر…)\nمثال: لا أحب المدرسة.",
 "有らまほしい": "مرغوب فيه, مستحب (يستحق الامتلاك أو السعي إليه أو تحقيقه)\nمثال: وظيفة مرغوبة",
 "有らん限り": "كُلّ, جَمِيع",
 "有り": "مَوْجُود (الذي له وجود)\nمثال: أنا موجود لوحدي / بشكل حسن, على ما يرام (بطريقة مرضية أو كافية)\nمثال: ستبلي حسناً بمفردها / كَانَ (اِتَّصَفَ. (فعل ناقص)؛ حَدَثَ)\nمثال: كان الكلب ميتا.",
 "有りける": "السَّابِقُ ذِكْرُهُ",
 "有りさま": "وَضْع (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه)\nمثال: لقد أزمت الوضع. / حَقِيقَة (الحَقّ، نقيض البَاطِل؛ نقيض المَجَاز)\nمثال: هي صديقة حقيقة.",
 "有りし": "رئيس الدير (رئيس رهبنة دينية؛ في الدير يكون أقل رتبة من الأباتي)",
 "有りそう": "رَاجِح, مُحْتَمَل (يُرَجَّح حُدوثُه أَوْ وُقوعُه)\nمثال: نتيجة محتملة",
 "有りそうもない": "عَجِيب, مُسْتَبْعَد (مستبعد جداً بحيث لا يمكن تصديقه)\nمثال: التشريع بشأن هذه المسألة مستبعد للغاية",
 "有りの実": "كُمَّثْرَى, إِجَّاص",
 "有りもしない": "مَعْدُوم",
 "有り丈": "كَامِل",
 "有り体に": "في الواقع, كما هو الحال (في الحالة الفعلية للأمور وغالباً ما تكون عكس التوقعات)\nمثال: كان من الممكن أن يُقتل؛ ولكن في الواقع، أصيب بجروح خطيرة",
 "有り切れ": "بقايا قماش, فضلة قماش (قطعة قماش متبقية بعد استخدام الباقي أو بيعه)",
 "有り布": "بقايا قماش, فضلة قماش (قطعة قماش متبقية بعد استخدام الباقي أو بيعه)",
 "有り得ない": "مُسْتَحِيل / لَا يَخْطُرُ عَلَى الْبَالِ (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر…)\nمثال: لا أحب المدرسة.",
 "有り得ない程": "لا يصدق (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر…)\nمثال: لا أحب المدرسة.",
 "有り得べからざる": "لَا يُعْذَر, لَا يُغْتَفَر (لَا يُمْكِنُ التَّمَاسُ العُذْرِ لَه)",
 "有り得べき": "مُمْكِن / مُفَضَّل, أَفْضَل",
 "有り得る": "مُمْكِن",
 "有り有り": "بوضوح (بدون شك أو تساؤل)\nمثال: كانوا تائهين بوضوح",
 "有り様": "وَضْع (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه)\nمثال: لقد أزمت الوضع. / حَقِيقَة (الحَقّ، نقيض البَاطِل؛ نقيض المَجَاز)\nمثال: هي صديقة حقيقة.",
 "有り難い": "مُمْتَنّ, شَاكِر",
 "有り難いことに": "لحسن الحظ (من حسن الحظ أن)\nمثال: لحسن الحظ لم يأت إلى الحفلة",
 "有り難い事に": "لحسن الحظ (من حسن الحظ أن)\nمثال: لحسن الحظ لم يأت إلى الحفلة",
 "有り難う": "شُكْرًا, تِسْلَم",
 "有り難うございました": "شُكْرًا, تِسْلَم",
 "有り難うございます": "شُكْرًا, تِسْلَم",
 "有り難う御座います": "شُكْرًا, تِسْلَم",
 "有り難さ": "قِيمَة",
 "有り難し": "نَادِر",
 "有り難み": "قِيمَة",
 "有り難や": "الْحَمْدُ لِلّٰهِ",
 "有り難味": "قِيمَة",
 "有る": "كَانَ (اِتَّصَفَ. (فعل ناقص)؛ حَدَثَ)\nمثال: كان الكلب ميتا. / مَلَكَ, اِمْتَلَكَ (لغة في المَالِك، وهو الذي يَمْلِكُ؛ السُلْطَان الحَاكِم الذي يملك الأَرْض…)\nمثال: زيري ملك لنفسه. / حَدَثَ, جَرَى (وَقَعَ الأمر؛ نقيض قَدُمَ، كان حَدِيثا)\nمثال: لا أصدق ما حدث. / وُجِدَ (أَدْرَكَ المطلوب، أَدْرَكَ الشيء الذي أَرَادَهُ وبَحَثَ عنه؛ غَضِبَ عليه…)\nمثال: وجد ياني هاتفه.",
 "有るたけ": "كَامِل",
 "有るだけ": "كَامِل",
 "有るべき": "مِثَالِيّ",
 "有る限り": "كُلّ, جَمِيع",
 "有事": "طَوَارِئ, حَالَةْ اَلطَّوَارِئ",
 "有人": "مأهول (لديه طاقم)\nمثال: اعتبر القمر الصناعي الأرضي المأهول خطوة بحثية ضرورية",
 "有休": "إجازة مدفوعة الأجر (إجازة من العمل للموظف مع منح الراتب)",
 "有休消化": "استهلاك, صرف (عملية استهلاك شيء ما)",
 "有体": "مَلْمُوْس",
 "有体に": "في الواقع, كما هو الحال (في الحالة الفعلية للأمور وغالباً ما تكون عكس التوقعات)\nمثال: كان من الممكن أن يُقتل؛ ولكن في الواقع، أصيب بجروح خطيرة",
 "有余": "قَلِيلًا / إفراط في التدليل (التدليل المفرط)\nمثال: أفسد الطفل بسبب الإفراط في التدليل",
 "有余年": "أكثر, مزيد من ((صيغة المقارنة من 'كثير' للمعدود وغير المعدود) محدد كمية يعني أكبر في الحجم أو…)\nمثال: مزيد من الأرض",
 "有価": "قَيِّم, ثَمِين (صيغة مبالغة من الفعل قَامَ، أي الكثير القيام؛ القَيِّم على الأمر مُتَوَلِّيه…)\nمثال: إعطي قيمة لذاتك.",
 "有価物": "قَيِّم, ثَمِين (صيغة مبالغة من الفعل قَامَ، أي الكثير القيام؛ القَيِّم على الأمر مُتَوَلِّيه…)\nمثال: إعطي قيمة لذاتك.",
 "有償": "دَفْع (لزّه ونحاه وأبعده؛ صرفه قبل وروده، أي منعه وأبعده قبل مجيئه أو حدوثه، وعكسه أن…)\nمثال: دفع زيري الثمن.",
 "有利": "مُفِيد, مُوَاتٍ (يمنح ميزة)\nمثال: عقد مفيد لبلدنا / مجد, مربح (يدر مكسباً مادياً أو ربحاً)\nمثال: مضاربة مربحة في سوق الأسهم",
 "有利子負債": "مدر للفائدة (للالتزامات المالية التي يُدفع عليها فائدة)",
 "有刺鉄線": "سِلْك شَائِك (السِّلْكُ : الخيطُ الذي ينظَم فيه الخرز ونحوه، أَو الذي يخاط به؛ السِّلْكُ :…)\nمثال: هذا السلك ساخن.",
 "有力": "ذو نفوذ, مؤثر (لديه أو يمارس تأثيراً أو سلطة)\nمثال: صحيفة مؤثرة / قَوِيّ (اسم من أسماء الله الحسنى؛ الشَدِيْد ذو الحَوْل)\nمثال: كانت صدمة قوية.",
 "有力者": "شخصية مؤثرة, شخصية هامة (شخص تؤثر أفعاله وآراؤه بقوة على مسار الأحداث)",
 "有功": "جَدَارَة",
 "有効": "شَرَعِيّ",
 "有効けた": "رَقَم مَعْنَوِيّ (أي رقم في عدد معروف بدقة؛ أي رقم في عدد يبدأ من أقصى اليسار غير الصفري وينتهي…)\nمثال: حسب الجواب لأربعة أرقام معنوية",
 "有効けた演算": "رَقَم مَعْنَوِيّ (أي رقم في عدد معروف بدقة؛ أي رقم في عدد يبدأ من أقصى اليسار غير الصفري وينتهي…)\nمثال: حسب الجواب لأربعة أرقام معنوية",
 "有効化": "تمكيني, مخوِّل (توفير السلطة القانونية أو العقوبة)\nمثال: قرار تمكيني",
 "有効性": "صَلَاحِيَّة",
 "有効成分": "مَادَّة فَعَّالَة (مؤنث مَادّ، اسم فاعل من مَدَّ. الجمع مَادَّات؛ ما كان مَدَدًا لغيره)\nمثال: لا أحب مادة العلوم.",
 "有効数字": "رَقَم مَعْنَوِيّ (أي رقم في عدد معروف بدقة؛ أي رقم في عدد يبدأ من أقصى اليسار غير الصفري وينتهي…)\nمثال: حسب الجواب لأربعة أرقام معنوية",
 "有効桁": "رَقَم مَعْنَوِيّ (أي رقم في عدد معروف بدقة؛ أي رقم في عدد يبدأ من أقصى اليسار غير الصفري وينتهي…)\nمثال: حسب الجواب لأربعة أرقام معنوية",
 "有効範囲": "حَيِّز",
 "有印": "إِشَارِيّ, بِلُغَةِ الإِشَارَة (متعلّق بلغة إشارة الصُّمّ)\nمثال: رسالة موقعة",
 "有史": "تَارِيخِي",
 "有史以前": "عَصْر مَا قَبْلَ التَّارِيخ (مصدر للفعل \"عَصَرَ\"؛ أي مدة زمنية، دهر من الوقت)\nمثال: صلى زيري العصر.",
 "有司": "خادم عام, موظف حكومي (شخص يشغل منصباً حكومياً (سواء بالانتخاب أو التعيين))",
 "有吉": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "有名": "مَشْهُور, شَهِير (معروف على نطاق واسع؛ اسم مفعول للفعل \"شَهَرَ\")\nمثال: إنه رسام مشهور.",
 "有名どころ": "ذَائِع الصِّيت, مَعْرُوف جَيِّدًا (معروف على نطاق واسع أو بشكل تامّ)",
 "有名人": "نَجْم, نَجْمَة (طَلَعَ وظَهَرَ؛ نَجَمَ عن الأمر: أي ظهر نَتِيجَة عنه أو نَتَجَ عنه)\nمثال: سميت السفينة \"النجم الفضي\".",
 "有名店": "ذَائِع الصِّيت, مَعْرُوف جَيِّدًا (معروف على نطاق واسع أو بشكل تامّ)",
 "有名所": "ذَائِع الصِّيت, مَعْرُوف جَيِّدًا (معروف على نطاق واسع أو بشكل تامّ)",
 "有名無名": "ذَائِع الصِّيت, مَعْرُوف جَيِّدًا (معروف على نطاق واسع أو بشكل تامّ)",
 "有名無実": "اسمياً فقط, بالاسم (باللقب أو السمعة ولكن ليس في الواقع)\nمثال: هو طبيب بالاسم فقط",
 "有向": "مُوَجَّه (يمكن إدارته من قبل جهة مشرفة)",
 "有向グラフ": "ثنائي الحرف (حرفان متتاليان (خاصة حرفين يستخدمان لتمثيل صوت واحد))",
