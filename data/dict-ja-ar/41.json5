 "栽培者": "خبير زراعي, مزارع (شخص يعنى بعلم أو فن أو تجارة زراعة الأرض)",
 "栽植": "زراعة, غرس (وضع البذور أو النباتات الصغيرة في الأرض لتنمو) / زرع, غرس (فعل التثبيت بإحكام في المكان) / مشجر, مغرس (مجموعة من النباتات (أشجار أو شجيرات أو زهور) في منطقة معينة)\nمثال: زراعة الذرة عمل شاق",
 "桁": "عَمُود / خَانَة / رَقْم (وضع أرقامًا على شيء ما للتنظيم أو التمييز) / إِصْبَع (عضو مستطيل ينشعِب من طرف الكفّ أو القدم)\nمثال: سجلت رقم هاتفه.",
 "桁あふれ": "فَيَضَان / فَاضَ",
 "桁上げ": "حَمَلَ (رَفَعَ، أَقَلَّ)\nمثال: حمل سامي سلاحه.",
 "桁上げる": "حَمَلَ (رَفَعَ، أَقَلَّ)\nمثال: حمل سامي سلاحه.",
 "桁上り": "حَمَلَ (رَفَعَ، أَقَلَّ)\nمثال: حمل سامي سلاحه.",
 "桁下": "سعة ديناميكية, هامش أمان صوتي (قدرة النظام على إعادة إنتاج الأصوات العالية دون تشويه) / اِرْتِفَاع خَالِص, مِسَاحَة عُلْوِيَّة (المساحة الرأسية المتاحة للسماح بالمرور السهل تحت شيء ما)",
 "桁外れ": "غير معقول, لا يصدق (يتجاوز التصديق أو الفهم)\nمثال: بسرعة لا تصدق",
 "桁移動": "نَوْبَة",
 "桁端": "طرف العارضة (أي من طرفي عارضة السفينة المجهزة بأشرعة مربعة)",
 "桁送り": "نَوْبَة",
 "桁違い": "لا يصدق (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: لا أحب المدرسة.",
 "桂": "فَارِس (اسم فاعل لفَرَسَ؛ راكب الفَرَس أو الحِصَان) / حِصَان, فَرَس (الواحد الذكر من الخَيْل؛ يطلق مجازًا على الواحد من الخيل الذي لا يُعرف ذكر كان أم أنثى)\nمثال: فارس الظلام فيلم جيد.",
 "桂冠詩人": "شاعر البلاط (الشاعر المعين رسمياً في البلاط الملكي في بريطانيا العظمى) / أمير الشعراء, شاعر متوج (شاعر يُنظر إليه بشكل غير رسمي على أنه يشغل منصباً فخرياً في مجموعة أو منطقة معينة)\nمثال: يُتوقع من شاعر البلاط تقديم قصائد للمناسبات الوطنية الكبرى",
 "桂庵": "حلقة وصل, وسيط (مفاوض يعمل كحلقة وصل بين الأطراف) / تملق, نفاق (ثناء مفرط أو غير صادق)",
 "桂月": "قَمَر, قمر (الكَوْكَب الذي يدور حول الأرْض ويظهر غالبا في الليل ويعكس ضوء الشَمْس. مذكر لا يؤنث؛ أي كوكب يدور حول كوكب آخر، لا يشمل ذلك الكواكب التي تدور حول شُمُوس. مذكر لا يؤنث)\nمثال: ضوء القمر ضعيف.",
 "桂林": "غُويْلِين, جُويْلِين",
 "桂枝茯苓丸": "اَلطِّبّ اَلصِّينِيّ",
 "桂皮": "قِرْفَة",
 "桂花": "قَمَر, قمر (الكَوْكَب الذي يدور حول الأرْض ويظهر غالبا في الليل ويعكس ضوء الشَمْس. مذكر لا يؤنث؛ أي كوكب يدور حول كوكب آخر، لا يشمل ذلك الكواكب التي تدور حول شُمُوس. مذكر لا يؤنث)",
 "桂馬": "فَارِس (اسم فاعل لفَرَسَ؛ راكب الفَرَس أو الحِصَان) / حِصَان, فَرَس (الواحد الذكر من الخَيْل؛ يطلق مجازًا على الواحد من الخيل الذي لا يُعرف ذكر كان أم أنثى)\nمثال: فارس الظلام فيلم جيد.",
 "桃": "خَوْخ / خَوْخَة / دُرَّاق / فِرْسِك",
 "桃乃": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "桃井": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "桃園": "بستان خوخ (بستان من أشجار الخوخ)",
 "桃山": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "桃林": "بستان خوخ (بستان من أشجار الخوخ)",
 "桃沢": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "桃源": "شَانْغْرِيلَا",
 "桃源郷": "شَانْغْرِيلَا",
 "桃瀬": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "桃色": "وَرْدِيّ, زَهْرِيّ (هُو ما كان بِلَوْنِ الورد؛ ٌ إِلَىٰ ٱلْوَرْدِ) / زَهْرِيّ, وَرْدِيّ\nمثال: لا أظن أن توم سيشتري مظلة وردية.",
 "桃花": "زَهْرَة خَوْخ",
 "桃谷": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "框": "إِطَار النَافِذَة",
 "案": "فِكْرَة, فِكْر (صورة ذهنية لأمر ما؛ فِكْر، نَظَر، رَأْي)\nمثال: إنها فكرة جيدة. / مُسْوَدَّة / تَجْنِيد / سَوَّدَ / جَنَّدَ (جَنَّدَ الجنودَ: جَمَعَهَا؛ جَنَّدَ فلانًا: صيَّره جنديّاً) / أفق, استشراف (اعتقاد بشأن المستقبل (أو تصور ذهني له)) / توقع رياضي, قيمة متوقعة (مجموع قيم متغير عشوائي مقسوماً على عدد القيم) / توقع (الشعور بأن شيئاً ما على وشك الحدوث) / ترقب, توقع (الترقب مع الثقة بالتحقق) / مَكْتَب, مِنْضَدَة (الموضع الذي يُكتَب عليه. بعكس المَكْتَب الذي يكتب فيه؛ مِنْضَدَة مخصصة للكتابة، سواء كانت للمَكَاتِب أم لغيرها)\nمثال: عاد إلى المكتب.",
 "案じる": "قَلِقَ (شاعر بالقَلَق؛ تَحَرّك/اهتزاز/اضطراب في الوضع الطبيعي للشيء) / قَلَق (شاعر بالقَلَق؛ تَحَرّك/اهتزاز/اضطراب في الوضع الطبيعي للشيء)\nمثال: ليلى قلقة بشأنك. / وصية عقارية ((قانون) هبة لممتلكات عقارية بموجب وصية) / وصية عقارية (وصية للتصرف في الممتلكات العقارية)",
 "案ずる": "قَلِقَ (شاعر بالقَلَق؛ تَحَرّك/اهتزاز/اضطراب في الوضع الطبيعي للشيء) / قَلَق (شاعر بالقَلَق؛ تَحَرّك/اهتزاز/اضطراب في الوضع الطبيعي للشيء)\nمثال: ليلى قلقة بشأنك. / وصية عقارية ((قانون) هبة لممتلكات عقارية بموجب وصية) / وصية عقارية (وصية للتصرف في الممتلكات العقارية)",
 "案の定": "بالتأكيد, حتماً (بشكل قاطع أو إيجابي) / كما كان متوقعاً, وفعلاً (كما هو مفترض أو متوقع)\nمثال: النتائج مشجعة بالتأكيد",
 "案件": "مَادَّة (مؤنث مَادّ، اسم فاعل من مَدَّ. الجمع مَادَّات؛ ما كان مَدَدًا لغيره) / أَمْر (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة) / قَضِيَّة, أَمْر (الأمر أو الشيء المُعَقَّد؛ في : ما يقضي فيه القاضي) / مَادَّة, جِسْم (مؤنث مَادّ، اسم فاعل من مَدَّ. الجمع مَادَّات؛ ما كان مَدَدًا لغيره) / هَمَّ\nمثال: لا أحب مادة العلوم. / قَضِيَّة (الأمر أو الشيء المُعَقَّد؛ في : ما يقضي فيه القاضي) / عُلْبَة / حَالَات / دَعْوَى (إدِّعَاء؛ دُعَاء) / عُلَب\nمثال: سأرفع عليك قضية. / مَشْرُوع (ما تُجِيزُه السلطة أو القانون أو أي قاعدة، جَائِز، قَانُونِيّ؛ مسعى مؤقت أي شيء يُسْعى لفعله خلال فترة زمنية معينة، فيُقال مشروع شخصي، مشروع سياسي، مشروع تجاري ؛إلخ)\nمثال: هذا مشروع عظيم. / إِيذَان, إِعْلَان",
 "案内": "إِرْشَاد, هِدَايَة / هِدَايَة, إِرْشَاد / مَعْلُومَات, مَعْلُومَة / إِعْلَان, بَلَاغ / دَعْوَة, عزيمة / إِغْرَاء",
 "案内カウンター": "مَكْتَبُ الاِسْتِعْلَامَات, مَكْتَبُ الْمَعْلُومَات (الموضع الذي يُكتَب عليه. بعكس المَكْتَب الذي يكتب فيه؛ مِنْضَدَة مخصصة للكتابة، سواء كانت للمَكَاتِب أم لغيرها)\nمثال: عاد إلى المكتب.",
 "案内人": "مُرْشِد, مُرْشِد سِيَاحِيّ (المُرْشِد : من يقوم بدور التَّوجيه والإرشاد؛ من يُساعد السُّفن بتعليماته لاجتياز القنوات أو للإرساء في المرافئ) / دَلِيل / دَلَّ, هَدَى (مَعِدَة، بَطْن؛ قَلْب)\nمثال: كيف استطيع الحصول على مرشد سياحي.",
 "案内係": "مَكْتَبُ الاِسْتِعْلَامَات, مَكْتَبُ الْمَعْلُومَات (الموضع الذي يُكتَب عليه. بعكس المَكْتَب الذي يكتب فيه؛ مِنْضَدَة مخصصة للكتابة، سواء كانت للمَكَاتِب أم لغيرها)\nمثال: عاد إلى المكتب.",
 "案内嬢": "مرشدة (مرشدة أنثى)",
 "案内広告": "إِعْلَان مُبَوَّب (إعلان قصير في صحيفة أو مجلة (عادة بخط صغير) ويظهر مع إعلانات أخرى من نفس النوع)",
 "案内役": "مُرْشِد, مُرْشِد سِيَاحِيّ (المُرْشِد : من يقوم بدور التَّوجيه والإرشاد؛ من يُساعد السُّفن بتعليماته لاجتياز القنوات أو للإرساء في المرافئ) / دَلِيل / دَلَّ, هَدَى (مَعِدَة، بَطْن؛ قَلْب)\nمثال: كيف استطيع الحصول على مرشد سياحي.",
 "案内所": "مَكْتَبُ الاِسْتِعْلَامَات, مَكْتَبُ الْمَعْلُومَات (الموضع الذي يُكتَب عليه. بعكس المَكْتَب الذي يكتب فيه؛ مِنْضَدَة مخصصة للكتابة، سواء كانت للمَكَاتِب أم لغيرها)\nمثال: عاد إلى المكتب.",
 "案内書": "دليل سياحي, مرشد (شيء يقدم معلومات أو تعليمات أساسية)",
 "案内者": "مُرْشِد, مُرْشِد سِيَاحِيّ (المُرْشِد : من يقوم بدور التَّوجيه والإرشاد؛ من يُساعد السُّفن بتعليماته لاجتياز القنوات أو للإرساء في المرافئ) / دَلِيل / دَلَّ, هَدَى (مَعِدَة، بَطْن؛ قَلْب)\nمثال: كيف استطيع الحصول على مرشد سياحي.",
 "案内記": "دليل سياحي, مرشد (شيء يقدم معلومات أو تعليمات أساسية)",
 "案出": "ابتكار, اختلاق (فعل تدبير أو ابتكار شيء ما) / آلة مبتكرة, أداة (جهاز أو أداة تحكم مفيدة جداً لأداء عمل معين) / تجهيز مؤقت, تلفيق (أي ترتيب مرتجل للاستخدام المؤقت) / ابتكار, براعة (ملكة الابتكار؛ مهارة ابتكارية)\nمثال: براعته الماهرة في إجابات كل مشكلة",
 "案外": "بالصدفة, عرضياً (بدون تخطيط مسبق) / بشكل غير متوقع, فجأة (بطريقة لم تكن متوقعة)\nمثال: التقيا بالصدفة / مُفَاجِئ",
 "案山子": "فَزَّاعَة / تمثال مقدمة السفينة (تمثال على مقدمة بعض السفن الشراعية) / واجهة (شخص يستخدم كغطاء لنشاط مشكوك فيه)",
 "案文": "مُسْوَدَّة / تَجْنِيد / سَوَّدَ / جَنَّدَ (جَنَّدَ الجنودَ: جَمَعَهَا؛ جَنَّدَ فلانًا: صيَّره جنديّاً)",
 "桎梏": "رباط, وصلة تثبيت (وصلة تثبت الأشياء ببعضها البعض) / صفد, قيد (قيد يحد أو يقيد الحرية (خاصة شيء يستخدم لربط أو تقييد سجين)) / التصاق, تلاصق (خاصية الالتصاق معاً (كالغراء والخشب) أو انضمام أسطح مختلفة التكوين) / رابطة, رابطة كيميائية (قوة كهربائية تربط الذرات)\nمثال: الالتصاق المتبادل للخلايا",
 "桐": "كوتو (آلة وترية يابانية تشبه الزيثير؛ لها لوحة صوت خشبية مستطيلة وعادة 13 وتراً حريرياً يتم نقرها بالأصابع)",
 "桐ヶ谷": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "桐村": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "桐油": "زيت التونغ (زيت أصفر يتم الحصول عليه من بذور شجرة التونغ)",
 "桐生": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "桑": "تُوت",
