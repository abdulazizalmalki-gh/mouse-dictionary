 "標準電波": "توقيت محلي, توقيت مدني (الوقت الرسمي في منطقة محلية (معدل حسب الموقع حول الأرض)؛ يحدد بالقانون أو العرف)",
 "標的": "دَرِيئَة, نِيشَان / هَدَف, مَرْمًى (جاء إلى الهَدَف؛ ارتفع عن الأرض) / يَسْتَهْدِفُ\nمثال: لقد أخطأ الهدف.",
 "標石": "حجر الميل, معلم المسافة (عمود حجري بجانب الطريق لإظهار المسافات)",
 "標示": "دَرَجَة / أَشَّرَ (مَرِحٌ؛ نَشِط)\nمثال: الصهاينة أشر من النازيين.",
 "標示板": "لافِتَة / وَقَّعَ (الشيء: سَقَطَ، انحدر من مكان عال؛ الأمر: حَدَثَ، وأكثر ما يقال للأمر العظيم)\nمثال: توم وقع و أصيب.",
 "標章": "شِعَار, رَمْز (العلامة: وذلك من شعار العقلاء (مادة حلم من مجمع بحار الأنوار))\nمثال: الشعار ☭ هو رمز الشيوعية.",
 "標記": "تعليم, وضع علامات (فعل عمل علامة مرئية على سطح) / تصحيح, وضع الدرجات (تقييم الأداء عن طريق تعيين درجة أو نتيجة) / علامة, وسم (نمط من العلامات) / علامة, مؤشر (رمز مميز)\nمثال: ما كرهه في التدريس هو كل التصحيح الذي كان عليه القيام به / فَاعِل, مُبْتَدَأ (الشيء :فعله) / مَوْضُوع / دَوْرَة, مَادَّة (في غرب العراق على نهر الفرات قرب الحدود السورية؛ حَيّ في جنوب بغداد تقع فيه محطة تكرير للنفط تسمّى بإسمه) / رَعِيَّة\nمثال: تظن الشرطة أن سامي يعلم من الفاعل.",
 "標語": "شِعَار (العلامة: وذلك من شعار العقلاء (مادة حلم من مجمع بحار الأنوار))\nمثال: الشعار ☭ هو رمز الشيوعية.",
 "標識": "لافِتَة / وَقَّعَ (الشيء: سَقَطَ، انحدر من مكان عال؛ الأمر: حَدَثَ، وأكثر ما يقال للأمر العظيم)\nمثال: توم وقع و أصيب. / علامة, مؤشر (جسم بارز يُستخدم لتمييز أو تحديد شيء ما) / قلم تخطيط, قلم علّام (أداة كتابة لعمل علامة) / علامة, مؤشر (رمز مميز)\nمثال: كانت العوامات علامات للقناة المائية",
 "標識灯": "فنار, منارة (برج به ضوء يعطي تحذيراً للسفن العابرة من الأرصفة الصخرية أو المياه الضحلة)",
 "標題": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / عُنْوَان (عُنْوَان) / عِنْوَان (عُنْوَان) / اِسْم (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)\nمثال: في حقيقة الأمر، كان زيري يعرف لقب ريمة.",
 "標題紙": "صفحة العنوان (صفحة في كتاب تعرض العنوان والمؤلف والناشر)",
 "標題音楽": "موسيقى برنامجية (تراكيب موسيقية تهدف إلى استحضار صور أو تذكير المستمع بأحداث)",
 "標高": "منسوب",
 "樟": "شجرة الكافور (شجرة كبيرة دائمة الخضرة في المناطق الدافئة ينتج خشبها العطري الكافور)",
 "樟脳": "كَافُور",
 "模": "ظُهُور (عِيْدُ الظُّهُوْر: عيد للنَصَارَى يُسَمَّى أيضا عيد التَجَلِّي) / مَظْهَر (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / مَظْهَر, شَكْل (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / شَكْل ((شَكَلَ) الأمْرُ يَشْكُلُ شُكُولاً: الْتَبَسَ؛ (شَكَلَ) المريضُ: تماثَلَ)",
 "模す": "قَلَّدَ / أَثَر (عَلَامَة؛ بَقِيَّة؛ رَسْم مُتَخَلَّف من شيء ما؛ تأثير؛ انطباع) / لِوْحَة دَارَاتُ مَطَبُوعَة\nمثال: اختفى فلم ير له أثر.",
 "模する": "قَلَّدَ / أَثَر (عَلَامَة؛ بَقِيَّة؛ رَسْم مُتَخَلَّف من شيء ما؛ تأثير؛ انطباع) / لِوْحَة دَارَاتُ مَطَبُوعَة\nمثال: اختفى فلم ير له أثر.",
