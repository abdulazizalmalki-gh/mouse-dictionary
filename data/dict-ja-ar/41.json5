 "熱力学の第３法則": "القانون الثالث للديناميكا الحرارية (قانون ينص على أن إنتروبيا مادة ما تقترب من الصفر مع اقتراب درجة حرارتها من الصفر المطلق)",
 "熱力学法則": "قانون الديناميكا الحرارية ((فيزياء) قانون يحكم العلاقات بين حالات الطاقة في نظام مغلق)",
 "熱力学的": "ترموديناميكي, ديناميكي حراري (متعلق بالديناميكا الحرارية)\nمثال: الحد الديناميكي الحراري",
 "熱力学第一法則": "حفظ الطاقة, قانون حفظ الطاقة (المبدأ الأساسي في الفيزياء القائل بأن الطاقة الكلية لنظام معزول ثابتة على الرغم من التغيرات الداخلية)",
 "熱力学第三法則": "القانون الثالث للديناميكا الحرارية (قانون ينص على أن إنتروبيا مادة ما تقترب من الصفر مع اقتراب درجة حرارتها من الصفر المطلق)",
 "熱力学第二法則": "القانون الثاني للديناميكا الحرارية (قانون ينص على أنه لا يمكن استخلاص شغل ميكانيكي من جسم إلا عندما يتفاعل ذلك الجسم مع جسم آخر عند درجة حرارة أقل؛ أي عملية تلقائية تؤدي إلى زيادة في…)",
 "熱力学第１法則": "حفظ الطاقة, قانون حفظ الطاقة (المبدأ الأساسي في الفيزياء القائل بأن الطاقة الكلية لنظام معزول ثابتة على الرغم من التغيرات الداخلية)",
 "熱力学第２法則": "القانون الثاني للديناميكا الحرارية (قانون ينص على أنه لا يمكن استخلاص شغل ميكانيكي من جسم إلا عندما يتفاعل ذلك الجسم مع جسم آخر عند درجة حرارة أقل؛ أي عملية تلقائية تؤدي إلى زيادة في…)",
 "熱力学第３法則": "القانون الثالث للديناميكا الحرارية (قانون ينص على أن إنتروبيا مادة ما تقترب من الصفر مع اقتراب درجة حرارتها من الصفر المطلق)",
 "熱化学": "كيمياء حرارية (فرع الكيمياء الذي يدرس العلاقة بين العمل الكيميائي وكمية الحرارة الممتصة أو المتولدة)",
 "熱可塑": "لدائني الحرارة, لدن بالحرارة (له خاصية الليونة أو الانصهار عند التسخين والتصلب مرة أخرى عند التبريد) / بلاستيك حراري, لدائن حرارية (مادة تلين عند تسخينها وتتصلب مرة أخرى عند تبريدها)\nمثال: المواد اللدائنية الحرارية يمكن إعادة صهرها وتبريدها مرارًا دون الخضوع لأي تغيير كيميائي ملحوظ",
 "熱可塑性樹脂": "بلاستيك حراري, لدائن حرارية (مادة تلين عند تسخينها وتتصلب مرة أخرى عند تبريدها)",
 "熱可塑樹脂": "بلاستيك حراري, لدائن حرارية (مادة تلين عند تسخينها وتتصلب مرة أخرى عند تبريدها)",
 "熱器具": "مِدْفَأَة",
 "熱圏": "ثِيرْمُوسْفِير",
 "熱射病": "ضربة شمس, فرط الحرارة (انهيار ناتج عن التعرض للحرارة المفرطة)",
 "熱帯": "مَدَار (اسم مَفْعُول من أدَارَ، الشيء أو الشخص الذي أُدِير)\nمثال: انتشرت الشائعة على مدار الدولة.",
 "熱帯医学": "طب المناطق الحارة (فرع الطب الذي يتعامل مع تشخيص وعلاج الأمراض الموجودة غالباً في المناطق الاستوائية)",
 "熱帯多雨林": "غَابَة مَطِيرَة مَدَارِيَّة (الغَابَةُ: الأَجَمَةُ ذاتُ الشَّجَرِ المُتَكَاثِف؛ لأَنَّها تُغَيِّبُ مَا فِيهَا. أو الأَجَمَةُ الَّتِي طالتْ، وَلَهَا أَطْراف مُرْتَفِعَةٌ باسِقَة؛ الغابةُ أَجَمة القَصَب، قَالَ: وَقَدْ جُعِلَتْ جماعةَ الشَّجَرِ، لأَنه مأْخوذ مِنَ الغَيابةِ)\nمثال: مشينا في الغابة",
 "熱帯雨林": "غَابَة مَطِيرَة مَدَارِيَّة (الغَابَةُ: الأَجَمَةُ ذاتُ الشَّجَرِ المُتَكَاثِف؛ لأَنَّها تُغَيِّبُ مَا فِيهَا. أو الأَجَمَةُ الَّتِي طالتْ، وَلَهَا أَطْراف مُرْتَفِعَةٌ باسِقَة؛ الغابةُ أَجَمة القَصَب، قَالَ: وَقَدْ جُعِلَتْ جماعةَ الشَّجَرِ، لأَنه مأْخوذ مِنَ الغَيابةِ)\nمثال: مشينا في الغابة",
 "熱度": "دَرَجَةْ الْحَرَارَة / حُمَّى (حمَى الشيءُ فلانًا: منَعه ودفع عنه؛ حمى المريضَ: منعه ما يضره)\nمثال: ليس لديك أي حمى.",
 "熱心": "مُتَحَمِّس, حَمَاسِيّ",
 "熱情": "اتقاد, حرارة (مشاعر الدفء والحدة الكبيرة) / شغف, وله (شعور مكثف بالحب) / اتقاد, اندفاع (شعور بتوق قوي (عادة لصالح شخص أو قضية))\nمثال: تحدث بحماسة كبيرة",
 "熱情的": "مُتَوَهِّج",
 "熱意": "حَمَاس / جُهْد (بَذَلَ قُصَارَى جُهْدِهِ فِي أَمْرٍ مَا؛ أَتْعَبَ نَفْسَهُ أو غَيْرَهُ بِعَمَلٍ شَاقٍ)\nمثال: لا إنجاز بلا جهد .",
 "熱愛": "تَفَرُّغ",
 "熱愛者": "عَاشِق, عَاشِقَة / مُغْرَم",
 "熱暴走": "تسخين مفرط, فرط السخونة (تسخين مفرط)",
 "熱核反応": "تفاعل نووي حراري (تفاعل اندماج نووي يحدث في درجات حرارة عالية جداً (كما في الشمس))",
 "熱機関": "محرك حراري (أي محرك يستخدم الحرارة للقيام بعمل)",
 "熱気": "حَرَارَة (السخونة والحماوة؛ شدة العَطَش) / حَرَارَة, سُخُونَة (السخونة والحماوة؛ شدة العَطَش) / سَخَّنَ, أَحَرَّ (حمي وأصبح حارا)\nمثال: حرارة الطقس تتزايد. / حَمَاس, حَمَاسَة / حُمَّة, حُمَّى / حمى, سخونة (ارتفاع في درجة حرارة الجسم؛ غالباً ما يكون عرضاً للعدوى) / محمومية, هياج (حالة من النشاط أو العاطفة المثارة بشدة)",
 "熱気球": "مُنْطَاد, بَالُون",
 "熱水": "مشكلة عويصة, ورطة (مأزق خطير أو مؤلم)\nمثال: آراؤه حول العرق أوقعته في ورطة سياسية",
 "熱水泉": "يُنْبُوع حَارّ, مِيَاه حارَّة (ينبوع: عَيْنُ المَاءِ أو جَدْوَلٌ كَثِيرُ المَاءِ)\nمثال: ماء هذا الينبوع صافي.",
 "熱汚染": "تلوث حراري (ضرر يلحق بالبحيرات والأنهار ناتج عن إطلاق حرارة زائدة فيها)",
 "熱波": "مَوْجَة اَلْحَرّ",
 "熱湯": "ماء مغلي (ماء تم تسخينه إلى درجة الغليان أو تجاوزها)\nمثال: هناك غلاية ماء مغلي على الموقد",
 "熱烈": "مُتَوَهِّج كَالنَّار, مُتَّقِد (يَتَوَهَّج أَوْ يَلْمَع كَالنَّار) / حَارّ, مُتَوَقِّد (يتّسم بحماسة شديدة وقويّة) / حَمَاسِيّ, مُتَحَمِّس (يَتَّسِمُ بِعَاطِفَةٍ شَدِيدَة)",
 "熱熱": "حرق بالسوائل, سلق (عملية الحرق بالبخار أو الماء الساخن) / سلق (حرق ناتج عن سائل ساخن أو بخار)",
 "熱狂ぶり": "تشقق دقيق (شق دقيق في الطلاء أو أي سطح آخر) / بدعة, صرعة (اهتمام يُتبع بحماس مبالغ فيه) / نوبة جنون, هياج (حالة من الهياج العقلي العنيف)\nمثال: يتبع دائماً أحدث الصرعات",
 "熱狂振り": "تشقق دقيق (شق دقيق في الطلاء أو أي سطح آخر) / بدعة, صرعة (اهتمام يُتبع بحماس مبالغ فيه) / نوبة جنون, هياج (حالة من الهياج العقلي العنيف)\nمثال: يتبع دائماً أحدث الصرعات",
 "熱狂的": "مَجْنُون, مَخْبُول",
 "熱狂的信者": "مُتَعَصِّب / مُتَعَصِّب, غَيُور",
 "熱狂者": "متحمس, نصير (مؤيد قوي ومتحمس لشخص أو نشاط ما) / مولع, هاوٍ (شخص لديه إعجاب قوي بشيء ما)",
 "熱疲労": "إنهاك حراري (حالة تتميز بالدوخة والغثيان والضعف الناجم عن استنزاف سوائل الجسم والشوارد)",
 "熱疲憊": "إنهاك حراري (حالة تتميز بالدوخة والغثيان والضعف الناجم عن استنزاف سوائل الجسم والشوارد)",
 "熱病": "حُمَّة, حُمَّى",
 "熱発": "حُمَّة, حُمَّى",
 "熱盛": "مُثِير",
 "熱盛り": "مُثِير",
 "熱硬化": "تصلبي الحرارة, صلد بالحرارة (له خاصية التصلب الدائم عند التسخين أو المعالجة)\nمثال: كانت راتنجات الفينول والبلاستيك هي المواد الاصطناعية الأصلية المتصلبة بالحرارة",
 "熱硬化剤": "مصلب, مقسي (مادة تزيد الصلابة، خاصة مادة تضاف إلى الورنيش أو الطلاء لمنحه سطحاً أو طبقة أكثر صلابة)",
 "熱硬化性樹脂": "راتينج تصلب بالحرارة, لدائن تصلب بالحرارة (مادة تتصلب عند تسخينها ولا يمكن إعادة تشكيلها)",
 "熱線": "شعاع تحت أحمر (شعاع من الأشعة تحت الحمراء؛ ينتج تأثيراً حرارياً (كما من مصباح الأشعة تحت الحمراء))",
 "熱臭い": "دَافِئ / دَفِيء",
 "熱血": "حَمَاس / جُهْد (بَذَلَ قُصَارَى جُهْدِهِ فِي أَمْرٍ مَا؛ أَتْعَبَ نَفْسَهُ أو غَيْرَهُ بِعَمَلٍ شَاقٍ)\nمثال: لا إنجاز بلا جهد .",
 "熱血漢": "حَمِيّ الطَّبْع, مُتَّقِدُ المَشَاعِر (ميّال إلى الانفعال والعاطفة الشديدة)",
 "熱血男児": "حَمِيّ الطَّبْع, مُتَّقِدُ المَشَاعِر (ميّال إلى الانفعال والعاطفة الشديدة)",
 "熱誠": "جدية, رزانة (سمة كون المرء جاداً) / إخلاص, جدية (شعور جاد وصادق)\nمثال: نقص الوقار ليس بالضرورة نقصاً في الجدية",
 "熱量": "حَمَاس, حَمَاسَة",
 "熱量計": "مسعر, مقياس الحرارة (أداة قياس تحدد كميات الحرارة)",
 "熱電子": "أَيُون حَرَارِيّ (جسيم مشحون كهربائياً (إلكترون أو أيون) ينبعث من مادة عند درجة حرارة عالية)",
 "熱電対": "مزدوجة حرارية (نوع من مقاييس الحرارة يتكون من سلكين من معدنين مختلفين متصلين في كلا الطرفين؛ حيث يولد التيار في الدائرة بما يتناسب مع فرق درجات الحرارة)",
 "熾": "جَمْرَة",
 "熾す": "بَنَى (أَقَامَ شيئا مثل الجدران و السفن باستخدام مواد مثل الخشب والطَّابُوق والحَجَر والآجَر والخَرَسَانَة وغيرها؛ جعل الشيء يحدث خطوة بعد خطوة كأنه بناء وإن لم يكن شيئا ملموسا)\nمثال: بنى سامي منزلا.",
 "熾る": "اِشْتَعَلَ",
 "熾天使": "سَرَافِيم",
 "熾烈": "عَاصِف, مُضْطَرِب (شَدِيد الهَيَجَان والاضْطِرَاب) / شَرِس, ضَارٍ (عَدِيمُ الرَّحْمَةِ فِي المُنَافَسَة) / جَامِح, حَادّ (يَتَّسِمُ بِشِدَّةٍ مُتَطَرِّفَةٍ فِي المَشَاعِرِ أَوِ القَنَاعَات؛ يَمِيلُ إِلَى رَدِّ الفِعْلِ العَنِيف) / شَرِس, ضَارٍ (يَتَّسِمُ بِطَاقَةٍ بَالِغَةِ العُنْفِ وَالشِّدَّة)",
 "熾盛": "حيوية, طاقة (أسلوب حيوي خيالي (خاصة أسلوب الكتابة)) / حيوية, نشاط (قوة نشطة للجسد أو العقل) / حيوية, طاقة (بذل قوي للجهد)\nمثال: تنقل كتابته طاقة كبيرة",
 "燃えあがる": "اِنْدَلَعَ",
 "燃えかす": "جَمْرُ مُنْطَفِيّ ((جمر) الْفرس جمرا وثب فِي الْقَيْد وَفُلَانًا أعطَاهُ جمرا ونحاه؛ جَمَرَ: الجَمْر: النَّارُ الْمُتَّقِدَةُ، وَاحِدَتُهُ جَمْرَةٌ. فإِذا بَرَدَ فَهُوَ فَحْمٌ)\nمثال: أنا أنتظر قرارك على أحر من الجمر.",
 "燃えがら": "جَمْرَة",
 "燃えさかる": "سَعِيرَا",
 "燃えさし": "جَمْرَة",
 "燃えつく": "اِشْتَعَلَ",
 "燃えないごみ": "غَيْر قَابِل لِلاِشْتِعَال (يستحيل إشعاله)",
 "燃えないゴミ": "غَيْر قَابِل لِلاِشْتِعَال (يستحيل إشعاله)",
 "燃える": "حَرْق (الفعل له عدة معانٍ تتعلق بالتأثير والتلف، منها: برد الحديد، حكّ الأنياب، إتلاف الثوب بالدق، وحرق الشيء بالنار؛ إتلاف شيء ما بالنار أو بأداة حادة، كما يشمل المعنى المجازي للألم الشديد والحزن الذي يُؤثر في القلب) / سَفْعَة / حُرق (الفعل له عدة معانٍ تتعلق بالتأثير والتلف، منها: برد الحديد، حكّ الأنياب، إتلاف الثوب بالدق، وحرق الشيء بالنار؛ إتلاف شيء ما بالنار أو بأداة حادة، كما يشمل المعنى المجازي للألم الشديد والحزن الذي يُؤثر في القلب) / أَحْرَقَ (أحرقت النار الشيءَ: حرقته؛ أحرقَ الشيءَ: أهلكه) / حَرَقَ (الفعل له عدة معانٍ تتعلق بالتأثير والتلف، منها: برد الحديد، حكّ الأنياب، إتلاف الثوب بالدق، وحرق الشيء بالنار؛ إتلاف شيء ما بالنار أو بأداة حادة، كما يشمل المعنى المجازي للألم الشديد والحزن الذي يُؤثر في القلب) / ضَرِمَ / حرق (الفعل له عدة معانٍ تتعلق بالتأثير والتلف، منها: برد الحديد، حكّ الأنياب، إتلاف الثوب بالدق، وحرق الشيء بالنار؛ إتلاف شيء ما بالنار أو بأداة حادة، كما يشمل المعنى المجازي للألم الشديد والحزن الذي يُؤثر في القلب) / وَلَّع\nمثال: قامت ليلى بحرق كل كتب آرت المتعلقة بالأدب العنصري.",
 "燃えカス": "جَمْرُ مُنْطَفِيّ ((جمر) الْفرس جمرا وثب فِي الْقَيْد وَفُلَانًا أعطَاهُ جمرا ونحاه؛ جَمَرَ: الجَمْر: النَّارُ الْمُتَّقِدَةُ، وَاحِدَتُهُ جَمْرَةٌ. فإِذا بَرَدَ فَهُوَ فَحْمٌ)\nمثال: أنا أنتظر قرارك على أحر من الجمر.",
 "燃え上がる": "اِنْدَلَعَ",
 "燃え付く": "اِشْتَعَلَ",
 "燃え出す": "اِشْتَعَلَ",
 "燃え差し": "جَمْرَة",
 "燃え広がる": "نَشَرَ (بَسَطَ، فَرَّقَ، نَشَرَ الشيءَ: جعله منتشراً، مثل نشر الأخبار أو نشر كتاب؛ نَشَرَ: وزع أو عمم شيئًا بين الناس، مثل نشر المقالات) / اِنْتِشَار (مصدر الفعل \"انْتَشَرَ\"؛ (في الفيزياء) عملية توزيع جزيئات أو ذرات أو حبيبات بشكل متساوٍ في فراغ أو في حيز متاح أو تخللها خلال حاجز غشائي)\nمثال: نشر توم الغسيل.",
 "燃え止し": "جَمْرَة",
 "燃え残り": "جَمْرَة",
 "燃え殻": "جَمْرَة",
 "燃え盛る": "سَعِيرَا",
 "燃え移る": "نَشَرَ (بَسَطَ، فَرَّقَ، نَشَرَ الشيءَ: جعله منتشراً، مثل نشر الأخبار أو نشر كتاب؛ نَشَرَ: وزع أو عمم شيئًا بين الناس، مثل نشر المقالات) / اِنْتِشَار (مصدر الفعل \"انْتَشَرَ\"؛ (في الفيزياء) عملية توزيع جزيئات أو ذرات أو حبيبات بشكل متساوٍ في فراغ أو في حيز متاح أو تخللها خلال حاجز غشائي)\nمثال: نشر توم الغسيل.",
 "燃え種": "إشعال, إضرام (عملية إضرام النار في شيء ما) / صوفان, قشاشة (مادة لبدء إشعال النار)",
 "燃す": "حَرْق (الفعل له عدة معانٍ تتعلق بالتأثير والتلف، منها: برد الحديد، حكّ الأنياب، إتلاف الثوب بالدق، وحرق الشيء بالنار؛ إتلاف شيء ما بالنار أو بأداة حادة، كما يشمل المعنى المجازي للألم الشديد والحزن الذي يُؤثر في القلب) / سَفْعَة / حُرق (الفعل له عدة معانٍ تتعلق بالتأثير والتلف، منها: برد الحديد، حكّ الأنياب، إتلاف الثوب بالدق، وحرق الشيء بالنار؛ إتلاف شيء ما بالنار أو بأداة حادة، كما يشمل المعنى المجازي للألم الشديد والحزن الذي يُؤثر في القلب) / أَحْرَقَ (أحرقت النار الشيءَ: حرقته؛ أحرقَ الشيءَ: أهلكه) / حَرَقَ (الفعل له عدة معانٍ تتعلق بالتأثير والتلف، منها: برد الحديد، حكّ الأنياب، إتلاف الثوب بالدق، وحرق الشيء بالنار؛ إتلاف شيء ما بالنار أو بأداة حادة، كما يشمل المعنى المجازي للألم الشديد والحزن الذي يُؤثر في القلب) / ضَرِمَ / حرق (الفعل له عدة معانٍ تتعلق بالتأثير والتلف، منها: برد الحديد، حكّ الأنياب، إتلاف الثوب بالدق، وحرق الشيء بالنار؛ إتلاف شيء ما بالنار أو بأداة حادة، كما يشمل المعنى المجازي للألم الشديد والحزن الذي يُؤثر في القلب) / وَلَّع\nمثال: قامت ليلى بحرق كل كتب آرت المتعلقة بالأدب العنصري.",
 "燃やす": "حَرْق (الفعل له عدة معانٍ تتعلق بالتأثير والتلف، منها: برد الحديد، حكّ الأنياب، إتلاف الثوب بالدق، وحرق الشيء بالنار؛ إتلاف شيء ما بالنار أو بأداة حادة، كما يشمل المعنى المجازي للألم الشديد والحزن الذي يُؤثر في القلب) / سَفْعَة / حُرق (الفعل له عدة معانٍ تتعلق بالتأثير والتلف، منها: برد الحديد، حكّ الأنياب، إتلاف الثوب بالدق، وحرق الشيء بالنار؛ إتلاف شيء ما بالنار أو بأداة حادة، كما يشمل المعنى المجازي للألم الشديد والحزن الذي يُؤثر في القلب) / أَحْرَقَ (أحرقت النار الشيءَ: حرقته؛ أحرقَ الشيءَ: أهلكه) / حَرَقَ (الفعل له عدة معانٍ تتعلق بالتأثير والتلف، منها: برد الحديد، حكّ الأنياب، إتلاف الثوب بالدق، وحرق الشيء بالنار؛ إتلاف شيء ما بالنار أو بأداة حادة، كما يشمل المعنى المجازي للألم الشديد والحزن الذي يُؤثر في القلب) / ضَرِمَ / حرق (الفعل له عدة معانٍ تتعلق بالتأثير والتلف، منها: برد الحديد، حكّ الأنياب، إتلاف الثوب بالدق، وحرق الشيء بالنار؛ إتلاف شيء ما بالنار أو بأداة حادة، كما يشمل المعنى المجازي للألم الشديد والحزن الذي يُؤثر في القلب) / وَلَّع\nمثال: قامت ليلى بحرق كل كتب آرت المتعلقة بالأدب العنصري.",
 "燃ゆる土": "فَحْم حَجَرِيّ / فَحْم / فحم / فَحَم",
 "燃ゆる水": "بترول, نفط خام (زيت داكن يتكون أساساً من الهيدروكربونات)",
 "燃料": "وَقُود",
 "燃料噴射": "حقن الوقود (نظام ميكانيكي لحقن الوقود المذرى مباشرة في أسطوانات محرك الاحتراق الداخلي؛ يغني عن الحاجة للمكربن (الكربياتير))",
 "燃料気化爆弾": "متفجرات الوقود الهوائي (جهاز يتكون من حاوية وقود وشحنتين متفجرتين؛ الشحنة الأولى تفتح حاوية الوقود عند ارتفاع محدد وتنشر الوقود في سحابة تختلط بالأكسجين الجوي؛ الشحنة…)",
 "燃料油": "زيت الوقود, مازوت (منتج بترولي يُستخدم كوقود)",
 "燃料計": "عَدَّاد الوَقُود",
 "燃料電池": "خلية وقود (خلية تنتج الكهرباء عن طريق أكسدة الوقود (الهيدروجين والأكسجين أو الزنك والهواء)؛ تستخدم غالباً في السيارات الكهربائية)",
 "燃木": "حَطَب (حَطَبَ فُلَانًا حَطَباً يَحْطِبُه واحْتَطَبَ لَهُ: جَمَعَه لَهُ وأَتاهُ بِهِ؛ حَطَبُوه: قَطَعُوه)\nمثال: بحث زيري عن الحطب.",
 "燃油": "زيت الوقود, مازوت (منتج بترولي يُستخدم كوقود)",
 "燃焼": "احتراق, حرق (عملية حرق شيء ما) / حرق (شكل من أشكال التعذيب تستخدم فيه السجائر أو السيجار أو أدوات ساخنة أخرى لحرق جلد الضحية) / حرق, حرق على الخازوق (الإعدام بالنار) / صعق كهربائي (الإعدام بالكهرباء)\nمثال: حرق الأوراق كان ممنوعاً بموجب مرسوم المدينة",
 "燃焼器": "حَرَّاق, موقد (جهاز لحرق الوقود (أو النفايات)) / شعلة, عين الموقد (عناصر التسخين في الموقد التي توضع عليها الأواني والمقالي للطهي)\nمثال: محرك الديزل هو حراق زيت",
 "燃素": "فلوجستون (مادة افتراضية كان يعتقد سابقاً بوجودها في جميع المواد القابلة للاحتراق ويتم إطلاقها أثناء الاحتراق)",
 "燃費": "اِسْتِهْلَاك الوَقُود (نسبة عدد الأميال المقطوعة إلى عدد جالونات البنزين المحروقة)\nمثال: あなたの車は本当に燃費が悪いんですね。 — سيارتك تستهلك البنزين بكثرة.",
 "燈": "إِشَارَة مُرُور, إِشَارَة ضَوْئِيَّة / نُور, ضَوْء (ضد الظَلام؛ ما يشع فيمكن الرؤية بسببه؛ ضد الضوء:ما يشع من أصله وليس ما يعكس الشعاع من غيره) / أَشْعَلَ, أَوْقَدَ ((أَشْعَلَ) النارَ: شَعَلها؛ يقال أَشْعَلَ فلانًا: هيَّج غَضبَه) / أَضَاءَ / مُنِير / فَاتِح (الرجلُ المرأةَ: جامعها؛ عمرٌ زيدًا: قاضاه وحاكمه) / خَفِيف / خفيف\nمثال: نسي أن يطفئ النور.",
 "燈台": "مَنَارَة, مَنَار (أسم، محجَّة الطريق وما يُوضَع بين الشيئَين من الحدود؛ اسم، البرج عند البحر يوضع فيه نور لتهتدي به السفن) / عَفَا عَلَيْه الزَّمَن, قَدِيم الطِّرَاز (خَارِج المُوضَة وَلَمْ يَعُدْ رَائِجًا)",
 "燈台草": "حليب الشيطان, فربيون الشمس (عشبة أوروبية غير جذابة تتحول زهورها نحو الشمس)",
 "燈心": "فَتِيل, فَتِيلَة",
 "燈火": "إِشَارَة مُرُور, إِشَارَة ضَوْئِيَّة / نُور, ضَوْء (ضد الظَلام؛ ما يشع فيمكن الرؤية بسببه؛ ضد الضوء:ما يشع من أصله وليس ما يعكس الشعاع من غيره) / أَشْعَلَ, أَوْقَدَ ((أَشْعَلَ) النارَ: شَعَلها؛ يقال أَشْعَلَ فلانًا: هيَّج غَضبَه) / أَضَاءَ / مُنِير / فَاتِح (الرجلُ المرأةَ: جامعها؛ عمرٌ زيدًا: قاضاه وحاكمه) / خَفِيف / خفيف\nمثال: نسي أن يطفئ النور.",
 "燈芯": "فَتِيل, فَتِيلَة",
 "燎原の火": "حَرِيق هَائِل (النَار المشتعلة في شيء كالدَار او الغَابَة)\nمثال: أين هو الحريق إذا؟",
 "燐": "فُسْفُور",
 "燐光": "تالق فسفوري, فسفرة (فلورة تستمر بعد توقف الإشعاع القاصف)",
 "燐化水素": "فوسفين (غاز عديم اللون له رائحة سمكية قوية؛ يستخدم كمبيد للآفات)",
 "燐火": "سراب, وهم خادع (وهم يضلل) / مصباح العفريت, نار هائمة (ضوء باهت يُرى أحياناً في الليل فوق الأرض المستنقعية)",
 "燐灰石": "أباتيت",
 "燐礬石": "أمبليغونيت (معدن أبيض أو رمادي يتكون من فوسفات الليثيوم والألمنيوم؛ وهو مصدر لليثيوم)",
 "燐脂質": "دُهْن فُوسْفُورِيّ, لِيبِيد مُفَسْفَر (طلى الشيء بالدهن أو الزيت أو الطيب؛ ضرب بالرفق)\nمثال: توم بدهن غرفته.",
 "燐蛋白質": "بروتين فوسفوري (يحتوي على حمض الفوسفوريك المرتبط كيميائياً)",
 "燐酸": "حمض الفوسفوريك (أصبح حامضًا، تغير الطعم إلى الحموضة؛ ارتفعت نسبة الحموضة في شيء ما، كما في الطعام أو السوائل)\nمثال: رمى ياني الحمض على وجه سكورة.",
 "燐酸ナトリウム": "فوسفات الصوديوم (فوسفات للصوديوم؛ يستخدم كملين لتنظيف الأمعاء)",
 "燐酸塩": "شراب الفوسفات (مشروب غازي مع شراب الفاكهة وقليل من حمض الفوسفوريك) / فوسفات (ملح لحمض الفوسفوريك)",
 "燐青銅": "برونز فوسفوري (برونز مقاوم للتآكل يحتوي على الفوسفور؛ يستخدم في المحامل والتروس)",
 "燕": "جَرَعَ, بَلَعَ ((جَرَعَ) المَاء وَنَحْوه جرعا: بَلِعَه) / جَرْعَة, شَرْبَة / سُنُونُو / خطاف المخازن",
 "燕子": "جَرَعَ, بَلَعَ ((جَرَعَ) المَاء وَنَحْوه جرعا: بَلِعَه) / جَرْعَة, شَرْبَة / سُنُونُو",
 "燕尾服": "بدلة بذيول, بدلة رسمية كاملة (ملابس رسمية تتكون من زي سهرة كامل للرجال)",
 "燕支": "أحمر خدود (مكياج يتكون من مسحوق وردي أو أحمر يوضع على الخدين) / أحمر داكن (لون أحمر يعكس القليل من الضوء) / دودة قرمزية",
 "燕楽": "ابتهاج, احتفال صاخب (احتفال صاخب؛ بهجة ومرح)",
 "燕脂": "أحمر خدود (مكياج يتكون من مسحوق وردي أو أحمر يوضع على الخدين) / أحمر داكن (لون أحمر يعكس القليل من الضوء) / دودة قرمزية",
 "燕雀": "تَافِه, ضَيِّق النَّظَر (مَحْدُود الأُفُق بِشَكْلٍ مُحْتَقَر)",
 "燕鰶": "خيطية الزعانف (أسماك بحرية استوائية تشبه البوري لها زعانف صدرية ذات أشعة طويلة تشبه الخيوط)",
 "燕鳶": "حدأة خطافية الذيل (حدأة رشيقة سوداء وبيضاء من أمريكا الشمالية)",
 "燕麦": "شُوفَان, خَرْطَال",
 "燠": "جَمْرَة",
 "燦": "باهِر",
 "燦々": "باهِر",
 "燦然": "باهِر",
 "燦燦": "باهِر",
 "燦爛": "باهِر",
 "燧": "مثقاب يدوي (مثقاب محمول صغير يُمسك ويشغل باليد)",
 "燧石": "صَوَّان, ظُرَر / صَوَّانَة, ظِرّ",
 "燧鉄": "ضارب, مطرقة (الجزء من جهاز ميكانيكي الذي يضرب شيئاً ما) / ضارب (شخص يضرب) / مُضرِب (موظف مضرب عن العمل ضد صاحب العمل) / متدرب بحري (شخص يتلقى تدريباً مكثفاً للحصول على تصنيف فني بحري)\nمثال: ضارب قوي",
 "燬く": "حَرْق (الفعل له عدة معانٍ تتعلق بالتأثير والتلف، منها: برد الحديد، حكّ الأنياب، إتلاف الثوب بالدق، وحرق الشيء بالنار؛ إتلاف شيء ما بالنار أو بأداة حادة، كما يشمل المعنى المجازي للألم الشديد والحزن الذي يُؤثر في القلب) / سَفْعَة / حُرق (الفعل له عدة معانٍ تتعلق بالتأثير والتلف، منها: برد الحديد، حكّ الأنياب، إتلاف الثوب بالدق، وحرق الشيء بالنار؛ إتلاف شيء ما بالنار أو بأداة حادة، كما يشمل المعنى المجازي للألم الشديد والحزن الذي يُؤثر في القلب) / أَحْرَقَ (أحرقت النار الشيءَ: حرقته؛ أحرقَ الشيءَ: أهلكه) / حَرَقَ (الفعل له عدة معانٍ تتعلق بالتأثير والتلف، منها: برد الحديد، حكّ الأنياب، إتلاف الثوب بالدق، وحرق الشيء بالنار؛ إتلاف شيء ما بالنار أو بأداة حادة، كما يشمل المعنى المجازي للألم الشديد والحزن الذي يُؤثر في القلب) / ضَرِمَ / حرق (الفعل له عدة معانٍ تتعلق بالتأثير والتلف، منها: برد الحديد، حكّ الأنياب، إتلاف الثوب بالدق، وحرق الشيء بالنار؛ إتلاف شيء ما بالنار أو بأداة حادة، كما يشمل المعنى المجازي للألم الشديد والحزن الذي يُؤثر في القلب) / وَلَّع\nمثال: قامت ليلى بحرق كل كتب آرت المتعلقة بالأدب العنصري. / شَوَى, صَلَى / حَرَارَة (السخونة والحماوة؛ شدة العَطَش) / حَرَارَة, سُخُونَة (السخونة والحماوة؛ شدة العَطَش) / سَخَّنَ, أَحَرَّ (حمي وأصبح حارا)\nمثال: حرارة الطقس تتزايد. / فَعَلَ, صَنَعَ (عَمِلَ وصَنَعَ، بعلم أو بدون علم، عن قصد أو دون قصد) / جَعَلَ (صَيَّرَ؛ أَنْشَأَ)\nمثال: ماذا فعل للحمي؟",
 "燭": "إِشَارَة مُرُور, إِشَارَة ضَوْئِيَّة / نُور, ضَوْء (ضد الظَلام؛ ما يشع فيمكن الرؤية بسببه؛ ضد الضوء:ما يشع من أصله وليس ما يعكس الشعاع من غيره) / أَشْعَلَ, أَوْقَدَ ((أَشْعَلَ) النارَ: شَعَلها؛ يقال أَشْعَلَ فلانًا: هيَّج غَضبَه) / أَضَاءَ / مُنِير / فَاتِح (الرجلُ المرأةَ: جامعها؛ عمرٌ زيدًا: قاضاه وحاكمه) / خَفِيف / خفيف\nمثال: نسي أن يطفئ النور.",
 "燭光": "شدة الإضاءة, قوة الشمعة (شدة الإضاءة مقاسة بالشمعات)",
 "燭台": "شَمْعَدَان, قِنْدِيل",
 "燻し": "تَدْخِين",
 "燻し鮭": "سلمون مدخن (سلمون محفوظ بالتدخين)",
 "燻す": "دُخَان, دخان / دَخَّنَ (دخن: الشَّيْء دخنة دخن؛ دخنت: النَّار دخنت والوقود دخن)\nمثال: دخن زيري سيجارة.",
 "燻ぶる": "دُخَان, دخان / دَخَّنَ (دخن: الشَّيْء دخنة دخن؛ دخنت: النَّار دخنت والوقود دخن)\nمثال: دخن زيري سيجارة. / احتراق بطيء, جمر (نار تحترق بدخان كثيف ولكن دون لهب)\nمثال: تحول الجمر فجأة إلى لهب",
 "燻べる": "دُخَان, دخان / دَخَّنَ (دخن: الشَّيْء دخنة دخن؛ دخنت: النَّار دخنت والوقود دخن)\nمثال: دخن زيري سيجارة.",
 "燻らす": "دُخَان, دخان / دَخَّنَ (دخن: الشَّيْء دخنة دخن؛ دخنت: النَّار دخنت والوقود دخن)\nمثال: دخن زيري سيجارة.",
 "燻る": "دُخَان, دخان / دَخَّنَ (دخن: الشَّيْء دخنة دخن؛ دخنت: النَّار دخنت والوقود دخن)\nمثال: دخن زيري سيجارة. / احتراق بطيء, جمر (نار تحترق بدخان كثيف ولكن دون لهب)\nمثال: تحول الجمر فجأة إلى لهب",
 "燻煙": "تَدْخِين",
 "燻蒸": "تبخير, تعقيم بالدخان (تطبيق غاز أو دخان على شيء لغرض تطهيره)",
 "燻蒸剤": "مادة تبخير, مبيد تبخيري (مادة كيميائية تستخدم في التبخير)",
 "燻製": "تَدْخِين / مُدَخَّن ((خَاصَّةً عَنِ اللُّحُوم وَالأَسْمَاك) مُجَفَّف وَمَحْفُوظ بِالتَّعْلِيق فِي دُخَان الخَشَب)",
 "燻鮭": "سلمون مدخن (سلمون محفوظ بالتدخين)",
 "燼滅": "اختفاء, تواري (فعل المغادرة سراً أو دون تفسير)",
 "爆ごう": "تَفْجِير",
 "爆ぜる": "بُوب, مُوسِيقَى شَعْبِيَّة",
 "爆圧": "موجة صادمة",
 "爆弾": "قُنْبُلَة / قَنْبَلَ",
 "爆弾マーク": "قُنْبُلَة / قَنْبَلَ",
 "爆撃": "تَفْجِير, قَصْف",
 "爆撃機": "قَاذِفَة قَنَابِل",
 "爆死": "تَفْجِير, قَصْف",
 "爆泣き": "صراخ, عويل (صرخات عالية أثناء البكاء)",
 "爆燃": "اشتعال سريع, تفرقع (احتراق ينتشر عبر غاز أو على سطح مادة متفجرة بمعدل سريع مدفوعاً بنقل الحرارة) / طرق, قرع (صوت الطرق (كما على باب أو في محرك أو محمل))\nمثال: ازداد الطرق ارتفاعاً",
 "爆発": "اِنْفِجَار, تَفْجِير / فورة, نوبة (اضطراب عنيف مفاجئ) / انفجار, تدفق عاطفي (تعبير غير مقيد عن العاطفة) / اندلاع, انفجار (حدث مفاجئ ومكثف)\nمثال: اندلاع أمطار غزيرة",
 "爆発ガス": "غاز المناجم, فايردامب (خليط من الغازات (معظمها الميثان) يتشكل في مناجم الفحم ويصبح متفجراً عند اختلاطه بالهواء)",
 "爆発事故": "اِنْفِجَار, تَفْجِير",
 "爆発物": "اِنْفِجَارِيّ, مُتَفَجِّر / مُتَفَجِّرَة, مَادَّة مُتَفَجِّرَة",
 "爆発的": "اِنْفِجَارِيّ, مُتَفَجِّر / مُتَفَجِّرَة, مَادَّة مُتَفَجِّرَة",
 "爆発管": "صاعق, كبسولة تفجير (جهاز تفجير ميكانيكي أو كهربائي أو كمية صغيرة من المتفجرات؛ يمكن استخدامه لبدء تفاعل متفجر مدمر)",
 "爆砕": "كَارِثِيّ, مُهْلِك (يُسَبِّبُ الأَذَى أَوِ الآفَةَ؛ يُصِيبُ بِعُنْفٍ مُفَاجِئٍ أَوْ وَبَاءٍ) / زَاعِق, صَاخِب (عالٍ بشكل مزعج ونافذ)",
 "爆破": "تَعْنِيف, تَوْبِيخ شَدِيد (توبيخ شديد)\nمثال: استحق التوبيخ الشديد الذي وجهه له المدرب",
 "爆竹": "مفرقعة, مفرقعة نارية (لعبة نارية تتكون من شحنة متفجرة صغيرة وفتيل داخل غلاف ورقي سميك)",
 "爆管": "قداحة, مشعل (جهاز لإشعال الوقود أو الشحنات أو الحرائق) / مادة إشعال, مشعل (مادة تستخدم لإشعال النار أو إضرامها)\nمثال: هل لديك ولاعة؟",
 "爆縮": "انحباس صوتي, انطباق (المرحلة الانحباسية الأولية للصامت الانفجاري) / انفجار داخلي, انكماش (انهيار مفاجئ نحو الداخل)\nمثال: انفجار المصباح الكهربائي نحو الداخل",
 "爆薬": "اِنْفِجَارِيّ, مُتَفَجِّر / مُتَفَجِّرَة, مَادَّة مُتَفَجِّرَة",
 "爆裂": "اِنْفَجَرَ / تَفْرَقَعَ",
 "爆裂弾": "قُنْبُلَة / قَنْبَلَ",
 "爆走": "بشدة, للغاية (بدرجة قصوى (تستخدم غالباً لوصف السُكر)) / رَائِج, مُزْدَهِر (حيوي ومربح للغاية؛ في حالة ازدهار ونمو) / خوار, زئير (تلفظ عالٍ جداً (مثل صوت حيوان)) / دوي, رعد (ضجيج عميق طويل وعالٍ)\nمثال: ثمل بشدة",
 "爆轟": "تَفْجِير",
 "爆雷": "قنبلة أعماق (قنبلة تنفجر عند عمق محدد مسبقاً تحت الماء؛ جهاز مضاد للغواصات)",
 "爆音": "أَنَّ (يفيد التوكيد) / قَهْقَهَ / زَئِير (اسم لصوت الأَسَد؛ زائير اسم سابق لجمهورية الكونغو الديمقراطية)\nمثال: كيف لي أن أعرف؟",
 "爆風": "انفجار قنبلة (انفجار قنبلة)",
 "爆食": "اِلْتَهَمَ",
 "爆食い": "اِلْتَهَمَ",
 "爛": "باهِر",
 "爛々": "مُبْهِر, وَهَّاج (يَلْمَع بِشِدَّة وقُوَّة) / صَارِخ, فَاضِح (سَيِّئٌ وَمُسْتَنْكَرٌ بِشَكْلٍ صَارِخٍ وَفَاضِحٍ)",
 "爛れ": "مُوجِع, مُؤْلِم / سَعْفَة",
 "爛れる": "تَقَيَّحَ",
 "爛柯": "ذَهَبَ, رَاحَ (في : التِبْر، مَعْدِن ثَمِين أصْفَر اللَّوْنِ، هُوَ أَسَاسُ التَعَامُلِ المَالِيّ وَيُسْتَخْدَمُ أَيْضاً فِي صِنَاعَةِ الْحُلِيّ وَالْمُجَوْهَرَات؛ هَذَا رَجُل ذَهَبا: أَيْ رَجُلٌ يُسَاوِي ذَهَباً فِي قِيمَتِهِ وَقدره) / ذَهَبَ, زَالَ (في : التِبْر، مَعْدِن ثَمِين أصْفَر اللَّوْنِ، هُوَ أَسَاسُ التَعَامُلِ المَالِيّ وَيُسْتَخْدَمُ أَيْضاً فِي صِنَاعَةِ الْحُلِيّ وَالْمُجَوْهَرَات؛ هَذَا رَجُل ذَهَبا: أَيْ رَجُلٌ يُسَاوِي ذَهَباً فِي قِيمَتِهِ وَقدره) / غُو\nمثال: ذهب إلى الدكان.",
 "爛漫": "بَاهِر, رَائِع (يتمتع بجمال وروعة عظيمين) / عظيم, مجيد (ذو مجد أو يستحق المجد أو يمنحه) / بَهِيّ, رَائِع (يتّسم بالعظمة والفخامة)\nمثال: مسيرة مهنية طويلة ومجيدة",
 "爛爛": "مُبْهِر, وَهَّاج (يَلْمَع بِشِدَّة وقُوَّة) / صَارِخ, فَاضِح (سَيِّئٌ وَمُسْتَنْكَرٌ بِشَكْلٍ صَارِخٍ وَفَاضِحٍ)",
 "爨ぐ": "طَبَّاخ, طَبَّاخَة (من طَبَخَ، بمعنى اسم الفاعل الطَابِخ؛ من طَبَخَ، بمعنى الكثير الطَبْخ) / طَبَخَ, طيب (أَنْضَجَ الطعام بتسخينه) / طاب (حَسُنَ واصبح طَيِّب؛ نفسُه: ارتاحت ورضيت واطمأنت)\nمثال: زوجي طباخ ماهر.",
 "爪": "ظُفْر, ضفر (الجزء المتقرن الميت على طرف الأصبع من الإنْسَان وبعض الحَيْوَانَات) / مِسْمَار, مسمار (وتد صغير من حَدِيد أحد طرفيه مسنون والآخر له رأس يدق في الخشب والجدران وغيرها للتثبيت؛ غِلْظ صغير مخروطي الشكل قد يحدث في أصابع القدم أو في أخْمَص القدم)\nمثال: نبت ظفر أصبع رجلي الكبير. / ريشة / خَطَّاف / لَكْمَة خُطَّافِيَّة",
 "爪あと": "خَرْبَشَ / نَدْبَة, نَدْب",
 "爪の垢": "خرقة, رقعة (قطعة صغيرة من القماش) / ذرة, مثقال ذرة (كمية صغيرة جداً أو نادرة الوجود)",
 "爪先": "إِصْبَع (عضو مستطيل ينشعِب من طرف الكفّ أو القدم) / إِصْبَع اَلْقَدَم (عضو مستطيل ينشعِب من طرف الكفّ أو القدم)\nمثال: كان أول ما لفت انتباهه هي بصمة الإصبع على الزجاج.",
 "爪先で歩く": "رُؤُوسُ أَصَابِع",
 "爪切": "مِقَصّ أَظَافِر",
 "爪切り": "مِقَصّ أَظَافِر",
 "爪半月": "حلية هلالية (حلية معدنية على شكل هلال من العصر البرونزي) / ظفرة, هلالية الظفر (المنطقة الهلالية الشكل عند قاعدة ظفر الإنسان)",
 "爪周囲炎": "التهاب حول الظفر, داحس (عدوى في الأنسجة المجاورة للظفر في إصبع اليد أو القدم)",
 "爪囲炎": "التهاب حول الظفر, داحس (عدوى في الأنسجة المجاورة للظفر في إصبع اليد أو القدم)",
 "爪弾き": "تجنب, تحاشي (التجنب المتعمد؛ الابتعاد عن شيء أو منع حدوثه) / فيلم, فيلم سينمائي (شكل من أشكال الترفيه يجسد قصة بالصوت وتسلسل من الصور يعطي وهماً بالحركة المستمرة) / شطبة سريعة, نقر (خط قصير وسريع) / ضربة خفيفة, نقرة (تلامس خفيف وحاد (عادة بشيء مرن))\nمثال: ذهبوا لمشاهدة فيلم كل ليلة سبت",
 "爪弾く": "دندنة, عزف (صوت العزف على الأوتار)\nمثال: عزف الغيتار",
 "爪楊枝": "عُود تَخْلِيل أَسْنَان, خِلَال (قطعة من الخشب كالعصا جمعه عيدان؛ ما يُتَبَخَّر به)\nمثال: أشعلت عود ثقاب.",
 "爪水虫": "سعفة الأظافر (عدوى فطرية في الأظافر (خاصة أظافر القدمين))",
 "爪牙": "إمساك, قبضة (فعل الإمساك)\nمثال: أرخى قبضته عن ذراعي / جُنْدِيّ (لقب عسكري يُطلق على من يلتحق بالجَيْش ويعمل فيه، مقاتل، محارب، عسكري؛ (في الشطرنج) اسم آخر للبيدق) / بَيْدَق ((في الشطرنج) القطعة الأكثر انتشارًا على رقعة الشِطْرَنْج) / بيذق\nمثال: غادر ذلك الجندي. / مساعد أيمن (المساعد الذكر الأكثر فائدة)",
 "爪痕": "خَرْبَشَ / نَدْبَة, نَدْب",
 "爪白癬": "سعفة الأظافر (عدوى فطرية في الأظافر (خاصة أظافر القدمين))",
 "爪繰る": "إِصْبَع (عضو مستطيل ينشعِب من طرف الكفّ أو القدم) / بَنَان (أَطْرَافُ الأَصَابِعِ) / صَبَّعَ ((صَبَعَ) به، وصَبَعَ عليه يَصْبَعُ صَبْعًا: أشار نحوه بِإِصبَعِهِ سخريةً؛ (صَبَعَ) في الشيءِ: أَدخل إصبَعَه فيه)\nمثال: كان أول ما لفت انتباهه هي بصمة الإصبع على الزجاج.",
 "爪羽鶏": "هواتزين",
 "爪蛙": "ضفدع أفريقي ذو مخالب (ضفدع عديم اللسان موطنه أفريقيا؛ استقر في الولايات المتحدة نتيجة إطلاق حيوانات المختبرات وأحواض السمك)",
 "爪跡": "خَرْبَشَ / نَدْبَة, نَدْب",
 "爪車": "سقاطة (جهاز ميكانيكي يتكون من عجلة مسننة أو رف متشابك مع لسان يسمح له بالتحرك في اتجاه واحد فقط)",
 "爬虫": "زَحَّافَة",
 "爬虫両棲類学": "علم الزواحف والبرمائيات (فرع علم الحيوان المعني الزواحف والبرمائيات)",
 "爬虫両生類学": "علم الزواحف والبرمائيات (فرع علم الحيوان المعني الزواحف والبرمائيات)",
 "爬虫類": "زَحَّافَة",
 "爬虫類学": "علم الزواحف والبرمائيات (فرع علم الحيوان المعني الزواحف والبرمائيات)",
 "爬虫類学者": "عالم زواحف وبرمائيات (عالم حيوان يدرس الزواحف والبرمائيات)",
 "爬行": "زحف (طريقة تنقل بطيئة على اليدين والركبتين أو بجر الجسم)\nمثال: كان الزحف هو كل ما استطاع الرجل المصاب القيام به",
 "爬行性": "تراخ, سبات (خمول؛ إظهار نقص غير عادي في الطاقة) / خمول, ركود (وتيرة الأشياء التي تتحرك ببطء نسبي) / خمول مرضي, وسن (حالة من السبات تشبه الغيبوبة (كما توجد في مرض النوم))\nمثال: أقلق المظهر العام للسبات أصدقاءه",
 "爰許": "إِلَى هُنَا (حرف جر يُفيد الغاية الزمنية؛ حرف جر يُفيد الغاية المكانية)\nمثال: تعال إلى منزلي. / أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى.",
 "爲": "حَسَن, جَيِّد (جَمِيل؛ مُبْهِج) / صِحِّيّ (ما ينفع الصحة) / حَسَنًا (تقال عند استحسان الفعل أو القول، هَذَا حَسَن) / خَيْر ((خَيَّرَ)وخَيَّرَهُ: فَوَّضَ إليه الخِيارَ؛ (خَيَّرَ) بَين الْأَشْيَاء: فضل بَعْضهَا على بعض) / سِلْعَة\nمثال: إيمي فتاة حسنة. / غاية, غَرَض / عَاقِبَة / نَتِيجَة / مُؤَثِّر, مُبَكٍّ (يثير المشاعر والعواطف)",
 "爲に": "لِأَنَّ / لِـ (اللَّامُ هو الحرف الثالث والعشرون من حروف ٱلْهِجَاءِ، وهو مجهور متوسط…؛ يفيد التعليل الغرضي) / لِأَجْل / لِـ, بِالنِّسْبَة لِـ (اللَّامُ هو الحرف الثالث والعشرون من حروف ٱلْهِجَاءِ، وهو مجهور متوسط…؛ يفيد التعليل الغرضي) / بِسَبَب, بِحُكْم",
 "爵": "اللوردات, النبلاء (أقران المملكة (اللوردات) يُعتبرون كمجموعة)",
 "爵位": "اللوردات, النبلاء (أقران المملكة (اللوردات) يُعتبرون كمجموعة)",
 "父": "أَب, وَالِد (الوَالِد و/أو المُرَبِّي، ويُطلق أيضًا على الجَدّ والعَمّ وإن علوا؛ أبو الشّيء هو من كان سببا في إيجاده أو ظهوره) / بَابَا\nمثال: الأب في الغرفة. / رَبّ (رَبَّ الولدَ يَرُبُّ رَبًّا: ولِيَه وتعهده بما يغذيه وينميه ويؤدّبه؛ الفاعل: رَابٌّ، والمفعول: مَرْبوبٌ، وربيبٌ)\nمثال: اعتني بي يا رب.",
 "父さん": "أَب, وَالِد (الوَالِد و/أو المُرَبِّي، ويُطلق أيضًا على الجَدّ والعَمّ وإن علوا؛ أبو الشّيء هو من كان سببا في إيجاده أو ظهوره) / بَابَا\nمثال: الأب في الغرفة.",
 "父じゃ人": "أَب, وَالِد (الوَالِد و/أو المُرَبِّي، ويُطلق أيضًا على الجَدّ والعَمّ وإن علوا؛ أبو الشّيء هو من كان سببا في إيجاده أو ظهوره) / بَابَا\nمثال: الأب في الغرفة.",
 "父ちゃん": "بَابَا",
 "父なし子": "ابن غير شرعي, نغل (النسل غير الشرعي لأبوين غير متزوجين)",
 "父の命": "أَب, وَالِد (الوَالِد و/أو المُرَبِّي، ويُطلق أيضًا على الجَدّ والعَمّ وإن علوا؛ أبو الشّيء هو من كان سببا في إيجاده أو ظهوره) / بَابَا\nمثال: الأب في الغرفة.",
 "父の日": "عِيدُ الْأَب",
 "父上": "أَب, وَالِد (الوَالِد و/أو المُرَبِّي، ويُطلق أيضًا على الجَدّ والعَمّ وإن علوا؛ أبو الشّيء هو من كان سببا في إيجاده أو ظهوره) / بَابَا\nمثال: الأب في الغرفة.",
 "父兄": "وَلِي أَمْر, حَافِظ (مَلَكَ الأمر وقَامَ به وسيطر عليه وولي عليه ولايةَ) / حَارِس\nمثال: ولي العهد هو من يرث العرش.",
 "父君": "أَب, وَالِد (الوَالِد و/أو المُرَبِّي، ويُطلق أيضًا على الجَدّ والعَمّ وإن علوا؛ أبو الشّيء هو من كان سببا في إيجاده أو ظهوره) / بَابَا\nمثال: الأب في الغرفة.",
 "父子草": "شيح لويزيانا, مريمية بيضاء (عشب معمر أبيض قطني من جنوب غرب الولايات المتحدة) / عشبة القطن, فيلاغو (أي نبات من جنس فيلاغو له عناقيد رأسية من رؤوس زهور صوفية صغيرة) / عشبة القد, غنافاليوم",
 "父御": "أَب, وَالِد (الوَالِد و/أو المُرَبِّي، ويُطلق أيضًا على الجَدّ والعَمّ وإن علوا؛ أبو الشّيء هو من كان سببا في إيجاده أو ظهوره) / بَابَا\nمثال: الأب في الغرفة.",
 "父性": "أبوة الفكرة, تأليف (فعل إطلاق فكرة أو نظرية أو كتابة جديدة) / أُبُوَّة (علاقة القرابة بين النسل والأب) / أبوة (حالة كونه أباً)\nمثال: تأليف النظرية محل نزاع",
 "父方": "أَبَوِيّ",
 "父権制": "نِظَام أَبَوِيّ (مَنْهَج، طَرِيقَة؛ تَرْتِيب واتِّسَاق)\nمثال: ليس بنظام كامل.",
 "父殺し": "قتل الأب (قتل الشخص لأبيه) / قاتل أبيه (شخص يقتل والده)",
 "父母": "وَالِد (الذي قام بالولادة؛ هو الذكر الذي كان له دور مباشر وعضوي في تكوين الطفل في الجنين؛ الأب الطبيعي) / وَالِدَة (اسم فاعل مؤنث للفعل \"وَلَدَ\"؛ مرادف لـ\"أُمّ\") / وَالِدَان (الشكل المثنى من \"وَالِد\" في حالة الرفع)\nمثال: ألست والدة توم؟",
 "父無し子": "ابن غير شرعي, نغل (النسل غير الشرعي لأبوين غير متزوجين)",
 "父祖": "سَلَف (مضى أو سبق في الزمن؛ تسوية الأرض للمزارعة باستخدام أداة تسمى \"المِسْلَفَة\")",
 "父祖伝来": "أَبَوِيّ, مَوْرُوث (مُتوارَث وفق قواعد راسخة (عادة قانونية) للإرث) / عَائِلِيّ, وِرَاثِيّ (يحدث بين أفراد الأسرة عادة عن طريق الوراثة)",
 "父称": "أبوي الاسم, كنيوي (من أو مشتق من اسم شخصي أو عائلي (اسم الأب)) / اسم الأب, نسبة للأب (اسم عائلي مشتق من اسم أبيك أو أحد أسلافك من جهة الأب)",
 "父老": "كَابِر / بَيْلَسَان (زهره بيضاء ذات رائحه عطريه جميله) / خَمَان",
 "父親": "أَب, وَالِد (الوَالِد و/أو المُرَبِّي، ويُطلق أيضًا على الجَدّ والعَمّ وإن علوا؛ أبو الشّيء هو من كان سببا في إيجاده أو ظهوره) / بَابَا\nمثال: الأب في الغرفة.",
 "父親らしい": "أَبَوِيّ",
 "父親殺し": "قتل الأب (قتل الشخص لأبيه) / قاتل أبيه (شخص يقتل والده)",
 "父音": "صَامِت / حَرْف (طَرَف وَجَانِب وَحَدّ؛ رَمْز مخطوط أو مطبوع يقوم مقام صوت أو كلمة أو عبارة أو معنى)\nمثال: ألف هو الحرف الأول للألف باء.",
 "父馬": "أب, فحل (الوالد الذكر لحيوان، خاصة الحيوانات الأليفة مثل الحصان) / جد, سلف (مؤسس العائلة) / مولاي (لقب مخاطبة كان يستخدم سابقاً لرجل ذي رتبة وسلطة)\nمثال: حافظوا على إيمان أجدادنا",
 "爺": "شَيْخ, عَجُوز / عجوز, مخضرم",
 "爺が背": "خيتون, عديد الأصداف (رخوي بحري بدائي ممدود متناظر ثنائياً له عباءة مغطاة بثماني صفائح جيرية) / خيتون (سترة صوفية ارتداها الرجال والنساء في اليونان القديمة)",
 "爺さん": "جَدّ (أبو الأَبّ وأبو الأُمّ. وفي العامية قد تُكسر الجِيم؛ أحد الذين يعود النسل إليهم عن طريق الأب، فهو أبو الأب وأبو أبوه وهكذا)\nمثال: عليك العمل بجد.",
 "爺ちゃん": "جَدّ (أبو الأَبّ وأبو الأُمّ. وفي العامية قد تُكسر الجِيم؛ أحد الذين يعود النسل إليهم عن طريق الأب، فهو أبو الأب وأبو أبوه وهكذا)\nمثال: عليك العمل بجد.",
 "爺むさい": "خَرِف, هَرِم (ضعيف عقلياً أو جسدياً بسبب الشيخوخة)",
 "爻辞": "تَعْلِيق",
 "爽やか": "طَازَج, طَازَة / عَذْب / شَفَّاف / وَاضِح",
 "爽快": "مُنْعِش",
 "爾": "مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة! / هَٰكَذَا, كَذَا / بل, نعم (ليس ذلك فحسب، بل)\nمثال: أنا بذلك أفرح، بل وسأفرح",
 "爾ら": "مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة!",
 "爾今": "مِنَ الآنَ فَصَاعِدًا, اِنْطِلَاقًا مِنَ الْآنِ (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "爾余": "آخَرُون",
 "爾前": "رئيس الدير (رئيس رهبنة دينية؛ في الدير يكون أقل رتبة من الأباتي)",
 "爾後": "بعد ذلك, منذ ذلك الحين (من ذلك الوقت فصاعداً)\nمثال: بعد ذلك لم يتصل أبداً مرة أخرى",
 "爾汝": "مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة!",
 "爾等": "مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة!",
 "牀": "أَرْضِيَّة, أَرْض (ما يقابل السَقْف من الغرفة؛ قاع الشيء) / طَابِق\nمثال: انهارت الأرضية. / مَرْحَلَة / مُنَصَّة, مَسْرَح",
 "牀榻": "قَاع, حَوْض (أَرْض مستوية سهلة تنصب إِليها مياه الأمطار فتمسكها ثم تُنبت العشب؛ القَعْر) / مَشَارَة, حَوْض\nمثال: نمت في قاعة السينما.",
 "片": "وَاحِد, وَاحِدَة (في وَ: العدد واحد العدد الاول) / اَلْمَرْء\nمثال: رأيت واحدة مرة. / غير مكتمل, ناقص (غير كامل أو غير كلي؛ لم يتم إنجازه) / غَيْرُ مُكْتَمِل, نَاقِص (لَمْ يَكْتَمِلْ بَعْدُ)\nمثال: سرد غير مكتمل لحياته / قَلِيل (ما كان عدده صغيرا؛ متبوعًا بمِنْ: عدد صغير أو كمية صغيرة من الشيء) / مثال: و بعد قليل أتى. / بَعِيد, نَاءٍ (ضد القَرِيب، الذي يفصل بينك وبينه مسافة أو زمان) / نَاءٍ\nمثال: إنها بعيدة جدا.",
 "片々": "خفقان, رفرفة (حركة الرفرفة صعوداً وهبوطاً) / شِظْوِيّ, مُتَشَظٍّ (يتألّف من أجزاء صغيرة غير مترابطة) / تَافِه, حَقِير (صغير ولا يلفت الانتباه) / تَافِه, ضَئِيلُ الشَّأْن (ذو أهمية أو نفوذ أو سلطة قليلة؛ ذو مكانة ثانوية) / عَدِيمُ الدَّلَالَة (لا يدل على شيء) / تافه, ضئيل الشأن (خالٍ من الأهمية أو المعنى أو القوة)",
 "片がつく": "اِسْتَعْمَرَ (اِسْتَعْمَرَ الاِسْتِعْمارُ الفَرَنْسِيُّ البِلادَ بِالسِّلاَحِ: دَخَلَها غَازِياً، وَأَرَادَها تابِعَةً لَهُ لِفَرْضِ سِيادَتِهِ عَلَيْها) / اِسْتَوْطَنَ (اتخذ وَطَنا أرضا كانت لغيره) / اِسْتَقَرَّ (فعل مطاوعة لأَقَرَّ بمعنى جعله يثبت ويسكن، أَقْرَرْتُهُ فاسْتَقَرَّ؛ ثبت وقرّ)\nمثال: استقر زيري في خيمته.",
 "片が付く": "اِسْتَعْمَرَ (اِسْتَعْمَرَ الاِسْتِعْمارُ الفَرَنْسِيُّ البِلادَ بِالسِّلاَحِ: دَخَلَها غَازِياً، وَأَرَادَها تابِعَةً لَهُ لِفَرْضِ سِيادَتِهِ عَلَيْها) / اِسْتَوْطَنَ (اتخذ وَطَنا أرضا كانت لغيره) / اِسْتَقَرَّ (فعل مطاوعة لأَقَرَّ بمعنى جعله يثبت ويسكن، أَقْرَرْتُهُ فاسْتَقَرَّ؛ ثبت وقرّ)\nمثال: استقر زيري في خيمته.",
 "片す": "حَرُكَ, تَحَرَّكَ (غَيَّرَ مَوْضِعَهُ أو مَكَانَهُ أو حَالَه؛ حَرُكَ الوَلَدُ : تَحَرَّكَ، أَوْ خَرَجَ عَنْ سُكُونِهِ) / اِنْتَقَلَ, تَحَلْحَلَ\nمثال: لقد أوقفنا حركة المرور. / مُنَظَّم, نَظِيف",
 "片すみ": "زَاوِيَة, رُكْن",
 "片ちんば": "أَعْرَج / أَكْسَح / أَشَلّ ((أَشَلَّ) فلانٌ: أصَابه الشَّلَل؛ (أَشَلَّ) اللهُ فلانًا أَو يَدَهُ: أصابَها بالشَّلَل) / غَيْرُ مُتَكَافِئ ((عن مسابقة أو متنافسين) غير متكافئ كخصوم) / غير متطابق, متنافر (إما غير متطابق أو متطابق بشكل غير مناسب)",
 "片っぽ": "وَاحِد, وَاحِدَة (في وَ: العدد واحد العدد الاول) / اَلْمَرْء\nمثال: رأيت واحدة مرة.",
 "片っ方": "وَاحِد, وَاحِدَة (في وَ: العدد واحد العدد الاول) / اَلْمَرْء\nمثال: رأيت واحدة مرة.",
 "片っ端から": "بشكل منتظم, بشكل منهجي (بطريقة منهجية أو متسقة)\nمثال: استبعدوا النساء بشكل منهجي",
 "片つけ": "إنهاء, تشطيب (فعل الإنهاء) / تشطيب, طبقة خارجية (ملمس أو مظهر زخرفي لسطح ما (أو المادة التي تعطيه ذلك المظهر))\nمثال: كان أفضل إنهاء له في بطولة كبرى هو المركز الثالث",
 "片づけ": "إنهاء, تشطيب (فعل الإنهاء) / تشطيب, طبقة خارجية (ملمس أو مظهر زخرفي لسطح ما (أو المادة التي تعطيه ذلك المظهر))\nمثال: كان أفضل إنهاء له في بطولة كبرى هو المركز الثالث",
 "片づける": "اِسْتَعْمَرَ (اِسْتَعْمَرَ الاِسْتِعْمارُ الفَرَنْسِيُّ البِلادَ بِالسِّلاَحِ: دَخَلَها غَازِياً، وَأَرَادَها تابِعَةً لَهُ لِفَرْضِ سِيادَتِهِ عَلَيْها) / اِسْتَوْطَنَ (اتخذ وَطَنا أرضا كانت لغيره) / اِسْتَقَرَّ (فعل مطاوعة لأَقَرَّ بمعنى جعله يثبت ويسكن، أَقْرَرْتُهُ فاسْتَقَرَّ؛ ثبت وقرّ)\nمثال: استقر زيري في خيمته. / فَرَغَ, أَنْهَى / اِنْتَهَى (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات)\nمثال: انتهى أمر زيري. / زَوَّجَ (زَوَّجَ الأَشياءَ تَزْويجًا، وزَواجًا: قرن بعضَها ببعض؛ زَوَّجَ فلانًا امرأةً، وبها: جعله يتزوَجَها)\nمثال: زوجة ماري طبيبة. / قَتَلَ, قتل (تعمّد جعله يَمُوتُ، أزهق روحه، أمَاتَه متعمدا؛ الوقتَ: ضيعه بشيء غير ذي فائدة وهو ينتظر أمرا آخر) / قَتْلَة\nمثال: قتل الصياد دبا.",
 "片めがね": "نظارة أحادية (عدسة لتصحيح الرؤية المعيبة في عين واحدة؛ تثبت في مكانها بواسطة عضلات الوجه)",
 "片われ月": "هِلَال",
 "片をつける": "اِسْتَعْمَرَ (اِسْتَعْمَرَ الاِسْتِعْمارُ الفَرَنْسِيُّ البِلادَ بِالسِّلاَحِ: دَخَلَها غَازِياً، وَأَرَادَها تابِعَةً لَهُ لِفَرْضِ سِيادَتِهِ عَلَيْها) / اِسْتَوْطَنَ (اتخذ وَطَنا أرضا كانت لغيره) / اِسْتَقَرَّ (فعل مطاوعة لأَقَرَّ بمعنى جعله يثبت ويسكن، أَقْرَرْتُهُ فاسْتَقَرَّ؛ ثبت وقرّ)\nمثال: استقر زيري في خيمته.",
 "片を付ける": "اِسْتَعْمَرَ (اِسْتَعْمَرَ الاِسْتِعْمارُ الفَرَنْسِيُّ البِلادَ بِالسِّلاَحِ: دَخَلَها غَازِياً، وَأَرَادَها تابِعَةً لَهُ لِفَرْضِ سِيادَتِهِ عَلَيْها) / اِسْتَوْطَنَ (اتخذ وَطَنا أرضا كانت لغيره) / اِسْتَقَرَّ (فعل مطاوعة لأَقَرَّ بمعنى جعله يثبت ويسكن، أَقْرَرْتُهُ فاسْتَقَرَّ؛ ثبت وقرّ)\nمثال: استقر زيري في خيمته.",
 "片一方": "وَاحِد, وَاحِدَة (في وَ: العدد واحد العدد الاول) / اَلْمَرْء\nمثال: رأيت واحدة مرة.",
 "片付け": "إنهاء, تشطيب (فعل الإنهاء) / تشطيب, طبقة خارجية (ملمس أو مظهر زخرفي لسطح ما (أو المادة التي تعطيه ذلك المظهر))\nمثال: كان أفضل إنهاء له في بطولة كبرى هو المركز الثالث",
 "片付ける": "اِسْتَعْمَرَ (اِسْتَعْمَرَ الاِسْتِعْمارُ الفَرَنْسِيُّ البِلادَ بِالسِّلاَحِ: دَخَلَها غَازِياً، وَأَرَادَها تابِعَةً لَهُ لِفَرْضِ سِيادَتِهِ عَلَيْها) / اِسْتَوْطَنَ (اتخذ وَطَنا أرضا كانت لغيره) / اِسْتَقَرَّ (فعل مطاوعة لأَقَرَّ بمعنى جعله يثبت ويسكن، أَقْرَرْتُهُ فاسْتَقَرَّ؛ ثبت وقرّ)\nمثال: استقر زيري في خيمته. / فَرَغَ, أَنْهَى / اِنْتَهَى (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات)\nمثال: انتهى أمر زيري. / زَوَّجَ (زَوَّجَ الأَشياءَ تَزْويجًا، وزَواجًا: قرن بعضَها ببعض؛ زَوَّجَ فلانًا امرأةً، وبها: جعله يتزوَجَها)\nمثال: زوجة ماري طبيبة. / قَتَلَ, قتل (تعمّد جعله يَمُوتُ، أزهق روحه، أمَاتَه متعمدا؛ الوقتَ: ضيعه بشيء غير ذي فائدة وهو ينتظر أمرا آخر) / قَتْلَة\nمثال: قتل الصياد دبا.",
 "片仮名": "كَاتَاكَانَا (ٱلْأَحْرُفَ ٱلْمُشَابِهَةَ لِلْهِيرَاغَانَا، ٱلَّتِي تُسْتَخْدَمُ لِكِتَابَةِ كَلِمَاتٍ غَيْرِ يَابَانِيَّةٍ وَأَسْمَاءٍ أَجْنَبِيَّةٍ…)",
 "片切スイッチ": "ذُو اِتِّجَاه وَاحِد (يتحرك أو يسمح بالحركة في اتجاه واحد فقط)",
 "片利共生": "تَعَايُش سِلْمِيّ, مُعَايَشَة (العلاقة بين نوعين مختلفين من الكائنات الحية عندما يحصل أحدهما على فوائد من الآخر دون الإضرار به)",
 "片前": "أحادي الصدر ((عن الملابس) يغلق بتداخل ضيق ويُثبت بصف واحد من الأزرار)\nمثال: سترة أحادية الصدر",
 "片割れ": "قِطْعَة, شَقَفَة (القِطْعَةُ: الْجُزْءَ أو الحِصَّة من الشيءِ؛ القِطْعَةُ: فقرة قصيرة عادة من مقالٍ أو كتاب)\nمثال: يصنع قطعة أثاث خشبية. / شَرِيك فِي جَرِيمَة / نَظِير",
 "片割れ月": "هِلَال",
 "片割月": "هِلَال",
 "片務": "أحادية الجانب (حالة أو صفة كون الشيء أحادي الجانب)\nمثال: تأملت في أحادية الجانب لعلاقة السيد بالعبد",
 "片務契約": "عقد أحادي الجانب (اتفاق من جانب واحد تعد فيه بالقيام (أو الامتناع عن القيام) بشيء ما مقابل أداء (وليس وعداً))",
 "片子": "حَبِيبِي (الحَبِيْب الذي يُنسب إلى المتكلم؛ كلمة يطلقها المُتَحَابِّيْن على بعضهم البعض) / حَبِيبِي, عَزِيزِي (الحَبِيْب الذي يُنسب إلى المتكلم؛ كلمة يطلقها المُتَحَابِّيْن على بعضهم البعض)\nمثال: ماذا تفعل حبيبي / بنفسج سن الكلب (نبات غابات معمر يزهر في الربيع؛ يزرع على نطاق واسع)",
 "片寄り": "إِنْحِرَاف / استقطاب (الظاهرة التي يتم فيها تقييد اتجاه اهتزاز موجات الضوء أو غيرها من الإشعاعات) / استقطاب (حالة امتلاك أو إعطاء قطبية)",
 "片寄る": "مَالَ (ما يملك الإنسان من كل شيء ويشمل النقد والعَيْن؛ عند البدو: هي النعم والإبل تحديدا) / اِسْتَنَدَ, اِتَّكَأَ\nمثال: أريد بعض المال.",
 "片岩": "شيست (أي صخر متحول يمكن شقه إلى طبقات رقيقة)",
 "片帆": "بَلَغَ",
 "片影": "ذرة, نقطة صغيرة (بقعة صغيرة جداً) / ذرة, رشة (كمية طفيفة ولكن محسوسة) / ذرة, هباءة ((الاستخدام غير التقني) قطعة صغيرة جداً من أي شيء)\nمثال: كانت الطائرة مجرد نقطة في السماء",
 "片思い": "أُحَادِيّ الجَانِب, مِن طَرَف وَاحِد (يشمل جزءاً أو جانباً واحداً فقط) / مُتَحَيِّز, مُنْحَاز (يُفَضِّلُ شَخْصًا أَوْ طَرَفًا عَلَى آخَر) / أحادي الوجه, غير قابل للقلب (غير قابل للعكس أو لاستخدام أي من الجانبين للخارج)\nمثال: شلل أحادي الجانب",
 "片恋": "أُحَادِيّ الجَانِب, مِن طَرَف وَاحِد (يشمل جزءاً أو جانباً واحداً فقط) / مُتَحَيِّز, مُنْحَاز (يُفَضِّلُ شَخْصًا أَوْ طَرَفًا عَلَى آخَر) / أحادي الوجه, غير قابل للقلب (غير قابل للعكس أو لاستخدام أي من الجانبين للخارج)\nمثال: شلل أحادي الجانب",
 "片恋い": "أُحَادِيّ الجَانِب, مِن طَرَف وَاحِد (يشمل جزءاً أو جانباً واحداً فقط) / مُتَحَيِّز, مُنْحَاز (يُفَضِّلُ شَخْصًا أَوْ طَرَفًا عَلَى آخَر) / أحادي الوجه, غير قابل للقلب (غير قابل للعكس أو لاستخدام أي من الجانبين للخارج)\nمثال: شلل أحادي الجانب",
 "片恨み": "أُحَادِيّ الجَانِب, مِن طَرَف وَاحِد (يشمل جزءاً أو جانباً واحداً فقط) / مُتَحَيِّز, مُنْحَاز (يُفَضِّلُ شَخْصًا أَوْ طَرَفًا عَلَى آخَر) / أحادي الوجه, غير قابل للقلب (غير قابل للعكس أو لاستخدام أي من الجانبين للخارج)\nمثال: شلل أحادي الجانب",
