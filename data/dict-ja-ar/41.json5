 "疲弊": "إعياء, إنهاك (عملية استنفاد شيء ما بالكامل) / إعياء, إنهاك (ضعف خطير وفقدان للطاقة) / إجهاد شديد, إنهاك (تعب شديد) / إفقار (فعل جعل شخص ما فقيراً) / عوز, فقر (حالة امتلاك القليل من المال أو عدم امتلاكه وقلة الممتلكات المادية)",
 "疲憊": "إعياء, إنهاك (عملية استنفاد شيء ما بالكامل) / إعياء, إنهاك (ضعف خطير وفقدان للطاقة) / إجهاد شديد, إنهاك (تعب شديد)",
 "疳": "حدة المزاج, سرعة الغضب (الميل لإظهار غضب غير منضبط) / صلابة, متانة (مرونة وصلابة جسم معدني؛ قدرته على امتصاص طاقة كبيرة قبل التشقق) / فورة غضب, هيجان (نوبة مفاجئة من الغضب) / مزاج (حالة شعورية مميزة (عادة أو مؤقتة نسبياً))\nمثال: كانت حدة مزاجه معروفة لجميع موظفيه",
 "疳の虫": "اِخْتِلَاج (الخَلْجُ: الجَذْبُ،واختلج شيء في صدري:احتكأ مع شك؛ أصل الاختلاج: الحركة والاضطراب)",
 "疳性": "حدة المزاج, سرعة الغضب (الميل لإظهار غضب غير منضبط) / تهيج, قابلية للاستثارة (حساسية مفرطة لعضو أو جزء من الجسم) / تهيج, سرعة الغضب (شعور بالتهيج والنزق)\nمثال: كانت حدة مزاجه معروفة لجميع موظفيه",
 "疵瑕": "شائبة, عيب (علامة أو عيب يفسد مظهر شيء ما (خاصة على جسم الشخص))\nمثال: عيب في الوجه",
 "疹": "طَفْح, طَفْح جِلْدِيّ",
 "疼き": "تَأَلَّمَ, وَجِعَ / أَلَم, وَجَع (الوَجَع)\nمثال: ألم أقل لك ذلك؟",
 "疼く": "خَفَقَ (الجذر يعبر عن الحركة والاضطراب الخفيف الذي ينشأ عن الرياح أو القلوب أو الرايات، ويستخدم لوصف الطبيعة والأحاسيس والجوانب الحسية المختلفة؛ عبّر عن حركة سريعة، سواء كانت اضطراباً أو ضرباً خفيفاً أو صوتاً، بالإضافة إلى صفةٍ تُوصف بها الخيل) / خَفَقَ, نَبَضَ (الجذر يعبر عن الحركة والاضطراب الخفيف الذي ينشأ عن الرياح أو القلوب أو الرايات، ويستخدم لوصف الطبيعة والأحاسيس والجوانب الحسية المختلفة؛ عبّر عن حركة سريعة، سواء كانت اضطراباً أو ضرباً خفيفاً أو صوتاً، بالإضافة إلى صفةٍ تُوصف بها الخيل) / خَفَقَان / صفاقة, وقاحة (سمة كون المرء وقحاً وسليطاً؛ يميل لأخذ حريات غير مستحقة) / صفراء, عصارة صفراوية (عصارة هضمية يفرزها الكبد وتخزن في المرارة؛ تساعد في هضم الدهون) / استياء, حقد (شعور بالغضب العميق والمرارة وسوء النية) / عفصة (تورم غير طبيعي في أنسجة النبات ناتج عن الحشرات أو الكائنات الحية الدقيقة أو الإصابة)",
 "疽腫": "انتفاخ (الزيادة في حجم بعض المواد عند تسخينها (غالباً ما تكون مصحوبة بإطلاق الماء)) / انتفاخ, بروز (شيء ينتفخ للخارج أو يبرز عن محيطه) / انتفاخ, تضخم (بروز غير طبيعي أو تضخم موضعي)\nمثال: أحدث المسدس في جيبه انتفاخاً واضحاً",
 "疾う": "بِسُرْعَة, عَاجِلًا",
 "疾うの昔": "قَدِيماً",
 "疾く": "بِسُرْعَة, عَاجِلًا / قَدِيماً",
 "疾くの昔": "قَدِيماً",
 "疾く疾く": "بِسُرْعَة, عَاجِلًا",
 "疾し": "حَادّ (مَالَ وَانْحَرَفَ عَنِ الطَّرِيقِ؛ تَجَنَّبَ شَيْئًا أَوِ الْاِلْتِزَامَ بِمَسَارٍ مَعَيَّنٍ)\nمثال: عندك ذاكرة حادة. / شَدِيد / سَرِيع / سَرِيعٌ / حَيٌّ (ضد المَيِّت، على قيد الحَيَاة؛ جمع حَيَاء) / جَارٍ (له استخدامات متعددة، تتراوح بين وصف المكان والعلاقة بين الناس، وبين وصف فعل الظلم أو الميل عن الطريق الصحيح؛ \"جار\" كلمةٌ مُشْعِبَةُ المعنى، تشيرُ إلى المكانِ، والعلاقة، والظلم) / سَرِيعًا, بِسُرْعَةٍ\nمثال: ينبح كلب في الحي. / سَنِين, مُرْهَف (له حافة قاطعة أو رأس حادّ) / طَاعِن, لَاذِع (مؤلم كما لو كان ناتجاً عن أداة حادّة) / رَائِع, مُمْتَاز (ممتاز؛ بالغ الجودة) / حَادّ, لَاذِع (شَدِيدُ الحِدَّةِ وَالوَطْأَة)",
 "疾呼": "صَيح, صِيَاح (مبالغة في الصياح، صاح كثيرا؛ في : صرخ) / صَرَخَ, صَاحَ (صاحَ صياحا شديدًا واستغاث)\nمثال: صرخ طالبا النجدة.",
 "疾強風": "عاصفة نشطة (رياح تتحرك بسرعة 39-46 عقدة؛ 8 على مقياس بوفورت)",
 "疾患": "مَرَض, دَاء (أصابه مرضٌ أو علّة أو سَقَم)\nمثال: هذا المرض قلبي.",
 "疾病": "مَرَض, دَاء (أصابه مرضٌ أو علّة أو سَقَم)\nمثال: هذا المرض قلبي.",
 "疾病対策センター": "مراكز السيطرة على الأمراض والوقاية منها (وكالة فيدرالية في وزارة الصحة والخدمات الإنسانية؛ تقع في أتلانتا؛ تحقق وتشخص وتحاول السيطرة على الأمراض أو الوقاية منها (خاصة الأمراض الجديدة وغير…)",
 "疾苦": "بلاء, مصاب (سبب للمعاناة والضيق الشديد) / بلاْء, علة (حالة من المعاناة أو الضيق بسبب اعتلال الصحة) / بلاء, محنة (حالة من المعاناة والضيق الشديد بسبب الشدائد)",
 "疾走": "ركض سريع, عدو سريع (جري سريع)",
 "疾風": "ريح عاتية, عاصفة (رياح قوية تتحرك بسرعة 45-90 عقدة؛ قوة 7 إلى 10 على مقياس بوفورت)",
 "疾風怒涛": "اضطراب, قلاقل (حالة من الاضطراب والفوضى العنيفة (كما في السياسة أو الظروف الاجتماعية بشكل عام))\nمثال: كانت الثورة الصناعية فترة اضطراب كبير",
 "疾風怒濤": "اضطراب, قلاقل (حالة من الاضطراب والفوضى العنيفة (كما في السياسة أو الظروف الاجتماعية بشكل عام))\nمثال: كانت الثورة الصناعية فترة اضطراب كبير",
 "痀瘻": "كُسَاح / أحدب (شخص ظهره مقوس بسبب انحناء غير طبيعي في العمود الفقري العلوي) / الحدب, حداب (انحناء خلفي غير طبيعي للعمود الفقري)",
 "痂せる": "جُلْبَة",
 "痂皮": "قِشْرَة",
 "病": "مَرَض, دَاء (أصابه مرضٌ أو علّة أو سَقَم)\nمثال: هذا المرض قلبي. / ضَعْف / أَلَمٌ (الوَجَع) / آلَمَ, يُؤْلِمُ (سبَّبَ أَلَمًا حسّيًّا أو وجعًا في الجسد؛ سَبَّبَ له الألَم)\nمثال: ألم أقل لك ذلك؟ / مَرَض, دَاء (أصابه مرضٌ أو علّة أو سَقَم)\nمثال: هذا المرض قلبي.",
 "病き": "أَلَمٌ (الوَجَع) / آلَمَ, يُؤْلِمُ (سبَّبَ أَلَمًا حسّيًّا أو وجعًا في الجسد؛ سَبَّبَ له الألَم)\nمثال: ألم أقل لك ذلك؟ / مَرَض, دَاء (أصابه مرضٌ أو علّة أو سَقَم)\nمثال: هذا المرض قلبي.",
 "病の床": "سرير المريض, فراش المرض (السرير الذي يرقد عليه المريض)",
 "病み上がり": "نَقَاهَة / نَقَاهَة, فَتْرَةُ نَقَاهَة",
 "病む": "مَرِضَ, أُصِيبَ بِالْمَرَض (أصابه مرضٌ أو علّة أو سَقَم)\nمثال: هذا المرض قلبي.",
 "病める": "بَشِع, مَكَابِرِيّ (منفّر بشكل صادم؛ يثير الرعب والاشمئزاز) / مَرِيض, مُتَأَثِّر بِعُمْق (متأثر تأثرًا عميقًا بشعور قوي) / مَجْنُون, مُخْتَلّ (مصاب بالجنون أو الاضطراب العقليّ) / خَافِت, شَاحِب ((للضوء) ضعيف الشدة أو السطوع؛ خافت وباهت) / جَرَحَ (كَلَمَ، شَقَّ اللَحْم وأسَالَ الدَمّ؛ صَادَ أو اكْتَسَبَ) / أَلِمَ, وَجِعَ (الوَجَع)\nمثال: ذلك سيهيج الجرح.",
 "病人": "عَلِيل, مَرِيض (شخص يعاني من مرض)",
 "病休": "إِجَازَة مَرَضِيَّة",
 "病原": "آلية المرض, تكون المرض (نشأة وتطور المرض)",
 "病原体": "مسببات الأمراض",
 "病原学": "أيتولوجيا, علم الأسباب (الدراسة الفلسفية للسببية) / علم الأسباب, مسببات المرض (سبب المرض)",
 "病原性": "حدة الجرثوم",
 "病原菌": "جُرْثُومَة",
 "病因学": "أيتولوجيا, علم الأسباب (الدراسة الفلسفية للسببية) / علم الأسباب, مسببات المرض (سبب المرض)",
 "病型": "نَوْع, نَمَط (صِنْف؛ في : وحدة تصنيفية أقل من الجنس) / طَبَعَ (طَبَعَ الله الخلقَ : أَنشأَهُ؛ طبَعَت الدَّوْلةُ النَّقْد : صاغتْه ونقشته)\nمثال: انه نوع من الفطر.",
 "病変": "آفة, إصابة (أي تغير هيكلي غير طبيعي موضعي في جزء من الجسم) / آفة, إصابة (إصابة في الأنسجة الحية (خاصة إصابة تنطوي على قطع أو كسر في الجلد))",
 "病室": "غرفة المريض (غرفة يُلازمها الشخص المريض)",
 "病害虫": "آفة (أي حشرة أو حيوان غير مرغوب فيه ومدمر يهاجم الطعام أو المحاصيل أو الماشية) / ثقيل الظل, لحوح (شخص يسبب الإزعاج والمضايقة باستمرار) / طاعون, وباء (أي مرض وبائي ذو معدل وفيات مرتفع) / طاعون (عدوى خطيرة (قاتلة أحيانًا) للقوارض تسببها اليرسينيا الطاعونية وتنتقل عن طريق الخطأ إلى البشر عن طريق لدغة برغوث قام بلدغ حيوان مصاب)\nمثال: رش الحديقة للتخلص من الآفات",
 "病巣": "بُؤْرَة",
 "病床": "سرير المريض, فراش المرض (السرير الذي يرقد عليه المريض)",
 "病床日誌": "يَوْمِيّ (يتعلق بكل يوم أو يحدث كل يوم)",
 "病弱": "ضَعِيف",
 "病弱者": "بَاطِل, غَيْر صَالِح (لم يعد ساري المفعول) / باطل, غير سارٍ (ليس له قوة إقناع أو قوة قانونية) / عاجِز, مُقْعَد (شخص أقعده مرض مزمن أو إصابة)\nمثال: استدلال باطل",
 "病後": "نَقَاهَة / نَقَاهَة, فَتْرَةُ نَقَاهَة",
 "病徴": "عَرَض, عَلَامَة (أتى العروض، أي مكّة والمدينة وما حولهما؛ الفَرَسَ: سار به بالعُرض) / عَرَض (أتى العروض، أي مكّة والمدينة وما حولهما؛ الفَرَسَ: سار به بالعُرض)\nمثال: قبل كلاي العرض.",
 "病患": "مَرَض (أصابه مرضٌ أو علّة أو سَقَم)\nمثال: هذا المرض قلبي.",
 "病態": "حالة مرضية (حالة جسدية ناجمة عن مرض)",
