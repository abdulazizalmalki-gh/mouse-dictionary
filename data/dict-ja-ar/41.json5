 "機嫌を取る": "تَمَلَّقَ",
 "機嫌を損ねる": "أَهَانَ (شخص يكون لئيم لآخر بالكلام)\nمثال: أهان سامي ليلى بقص شعرها.",
 "機嫌取り": "خَنُوع, مُتَذَلِّل (شخص يذل نفسه كعلامة على الاحترام؛ يتصرف وكأنه بلا كرامة)",
 "機嫌気褄": "فُكَاهَة, دُعَابَة / مِزَاج / خِلْط, أَخْلَاط (اختلط)\nمثال: خلط توم بين السكر و الملح.",
 "機嫌気褄を取る": "تَمَلَّقَ",
 "機嫌良く": "بِبَهْجَة, بِمَرَح (بطريقة مرحة)\nمثال: وافق بمرح على القيام بذلك",
 "機嫌買い": "مُتَقَلِّب, نَزَوِيّ (عرضة لتغيّرات مفاجئة وغير متوقّعة) / غَيْرُ مُسْتَقِرّ, مُتَقَلِّب (يَتَّسِمُ بِتَقَلُّبَاتٍ عَشْوَائِيَّةٍ فِي المَشَاعِرِ أَوِ الِارْتِبَاطَاتِ)",
 "機宜": "تَوْقِيت مُنَاسِب, مُوَاتَاة (الملاءمة الزمنية)",
 "機密": "سِرِّيَّة",
 "機密保持契約": "اِتِّفَاقِيَّة عَدَم الإِفْصَاح, اِتِّفَاقِيَّة عَدَم الْإِفْشَاء",
 "機密保護": "أَمْن, أَمَان (وَثِقَ به وأرْكَنَ إليه) / حِمَايَة / ضَمَانَة, كَفَالَة (وَثِيقَةٌ يَضْمَنُ بِهَا شَخْصٌ شَخْصاً آخَرَ فِي غَرَضٍ مِنْ أَغْرَاضِ البَيْعِ وَقَضَايَا التَّعَامُلِ؛ وَثِيقَةٌ يَضْمَنُ بِهَا ٱلْبَائِعُ سَلاَمَةَ الْمَبِيعِ مِنْ كُلِّ عَيْبٍ وَبَقَاءَهُ صَالِحاً لِلاِسْتِعْمَالِ مُدَّةً مُعَيَّنَةً حَسَبَ…)\nمثال: اتصل زيري بالأمن.",
 "機密性": "سرية, كتمان (التكتم في حفظ المعلومات السرية) / خصوصية, سرية (حالة كونه سرياً)\nمثال: يجب عليك احترام سرية اتصالات عميلك",
 "機密情報": "تَلْمِيح, طَرَف خَيْط (إشارة إلى فرصة محتملة)\nمثال: حصل على نصيحة حول سوق الأسهم",
 "機密解除": "رفع السرية (تخفيض أو إزالة الحكومة للقيود المفروضة على وثيقة أو سلاح سري)",
 "機尾": "ذَنَب, ذَيْل (ذَنَّبَ: مدَّ ذَنَبَه؛ ذَنَّبَ الضَّبّ: أخرج ذَنَبَهُ من أدنى الجُحْر عند الحَرْشِ) / ذَنَب (ذَنَّبَ: مدَّ ذَنَبَه؛ ذَنَّبَ الضَّبّ: أخرج ذَنَبَهُ من أدنى الجُحْر عند الحَرْشِ)\nمثال: عذر أقبح من ذنب.",
 "機屋": "نَسَّاج, نَسَّاجَة / تَنَوُّط",
 "機巧": "حِيلَة",
 "機序": "آلِيَّة",
 "機微": "خفاء, دقة (صفة الصعوبة في الكشف أو التحليل) / تَفَاوُت دَقِيق, فَارِق بَسِيط (اختلاف دقيق في المعنى أو الرأي أو الموقف)\nمثال: عليك أن تعجب بدقة الفروق التي رسمها / خَبيث, فَتّاك (يُلحِق ضَرَرًا تَدْريجِيًّا خَفِيًّا ولكِنَّه بالِغ) / دَقِيق, مُسْتَعْصٍ عَلَى الفَهْم (صَعْبُ الإِدْرَاكِ أَوِ الفَهْمِ أَوِ التَّحْلِيل) / دَقِيقُ التَّمْيِيز (قَادِرٌ عَلَى إِجْرَاءِ تَمْيِيزَاتٍ دَقِيقَة)",
 "機微情報": "تَلْمِيح, طَرَف خَيْط (إشارة إلى فرصة محتملة)\nمثال: حصل على نصيحة حول سوق الأسهم",
 "機徴": "ذُو إِحْسَاس (أحد الأسماء الستة، لا يأتي إلا مُضَافًا، بمعنى صاحب) / حَسَّاس\nمثال: كان رجل ذو قامة طويله.",
 "機才": "حذق, حنكة (الذكاء الذي يظهر من خلال الحنكة (كما في التعاملات التجارية))",
 "機敏": "سَرِيع / سَرِيعٌ / حَيٌّ (ضد المَيِّت، على قيد الحَيَاة؛ جمع حَيَاء) / جَارٍ (له استخدامات متعددة، تتراوح بين وصف المكان والعلاقة بين الناس، وبين وصف فعل الظلم أو الميل عن الطريق الصحيح؛ \"جار\" كلمةٌ مُشْعِبَةُ المعنى، تشيرُ إلى المكانِ، والعلاقة، والظلم) / سَرِيعًا, بِسُرْعَةٍ\nمثال: ينبح كلب في الحي.",
 "機智": "وعي, إدراك (الفَهْم والتَدَبُّر واِحْتِوَاء كل معاني الشيء؛ في علم النفس: حالة وعي ويعني أيضا محتوى العقل، ويشمل المشاعر والوعي الذاتي وٱلصور وَالأفكار وَٱلقدرة على إدراك العلاقة بين المرء وٱلبيئة والشعور بما…)\nمثال: إنها فاقدة الوعي.",
 "機材": "مُعَدَّات, تَجْهِيزَات",
 "機杼": "مَكُّوك / مَكُوك",
 "機根": "صَبْر, تَحَمُّل ((صَبَرَ) يَصْبِرُ صَبْرًا: تجلَّد ولم يَجْزَع؛ (صَبَرَ): انتظر في هدوء واطمئنان)\nمثال: الصبر أم العلوم.",
 "機械": "آلَة, مَاكِينَة (الفارسية: ماشين؛ الأوردية: مشين)\nمثال: نسى زيري الآلة. / الة موسيقية / آلَة (الفارسية: ماشين؛ الأوردية: مشين) / أَدَاة\nمثال: نسى زيري الآلة.",
