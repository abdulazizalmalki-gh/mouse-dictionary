 "未開封": "غَيْرُ مَفْتُوح, مُغْلَق (لم يُفتَح بعد ولم يُفَكّ ختمه)",
 "未開拓": "غير متطور, غير نامٍ (لم يتطور أو ينضج أو يكتمل صياغته)\nمثال: كانت دورات التصميم الداخلي نادرة وغير متطورة",
 "未開発": "غير متطور, غير نامٍ (لم يتطور أو ينضج أو يكتمل صياغته)\nمثال: كانت دورات التصميم الداخلي نادرة وغير متطورة",
 "末": "طَرَف / نِهَايَة, غَايَة\nمثال: انتهى أمر زيري. / أحفاد, ذُرِّيَّة (كل نسل سلف معين)\nمثال: علينا تأمين فوائد الحرية لأنفسنا ولذريتنا / مُسْتَقْبَل / بعد (يدل على اللحاق في الزمان؛ يكون مضافا، وينصب أو يجر)\nمثال: و بعد قليل أتى. / النِهاية / بُودْرَة",
 "末々": "أحفاد, ذُرِّيَّة (كل نسل سلف معين)\nمثال: علينا تأمين فوائد الحرية لأنفسنا ولذريتنا / الطَّبَقَاتُ الدُّنْيَا",
 "末えい": "سَلِيل (صِفَة ثابتة للمفعول من الفعل سلَّ؛ يَنْحَدِرُ مِنْ نَسْلٍ شَرِيفٍ)",
 "末つ方": "نِهَايَةُ الْعَالَم, الْقِيَامَة",
 "末に": "أَخِيراً",
 "末の世": "الأجيال القادمة, الخَلَف (جميع الأجيال المستقبلية)\nمثال: علينا تأمين فوائد الحرية لأنفسنا ولذريتنا",
 "末の末": "آخِر (ضد الأوَّل؛ وهو من يكون ترتيبه بعد الجميع؛ الشيء: مؤخرّه، الجزء الآخير منه)\nمثال: أرني مثالا آخر.",
 "末代": "أَبَد (الأبَد : الدَّهْرُ وَيُقَالُ الدَّهْرُ الطَّوِيلُ الَّذِي لَيْسَ بِمَحْدُودٍ…)\nمثال: سأحبك إلى الأبد.",
 "末代まで": "إِلَى الْأَبَد (حرف جر يُفيد الغاية الزمنية؛ حرف جر يُفيد الغاية المكانية)\nمثال: تعال إلى منزلي.",
 "末吉": "بِالتَّوْفِيق!, حَظًّا سَعِيدًا!",
 "末始終": "إِلَى الْأَبَد (حرف جر يُفيد الغاية الزمنية؛ حرف جر يُفيد الغاية المكانية)\nمثال: تعال إلى منزلي.",
 "末孫": "سَلِيل (صِفَة ثابتة للمفعول من الفعل سلَّ؛ يَنْحَدِرُ مِنْ نَسْلٍ شَرِيفٍ)",
