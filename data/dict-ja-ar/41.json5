{
 "最新鋭": "بِأَحْدَث التِّقْنِيَّات (على أعلى مستوى من التطوّر في وقت معيّن (خاصة الوقت الحالي))",
 "最早": "قَد, مِنْ قَبْلُ (يفيد التحقيق. (مع الماضي والمضارع)؛ يفيد التقريب. (مع الماضي)) / لقد\nمثال: قد أثلجت كثيرا. / لم يعد (ليس الآن)\nمثال: لم تعد موجودة",
 "最有力": "قِمَّة",
 "最東": "أَقْصَى الشَّرْق (الأبعد باتّجاه الشرق)",
 "最深部": "أعماق, أغوار ((الجمع) الجزء الأعمق والأكثر بعداً)\nمثال: من أعماق أفريقيا المظلمة",
 "最盛": "أَوْجٌ, ذُرْوَةٌ",
 "最盛期": "عَصْر ذَهَبِيّ (مصدر للفعل \"عَصَرَ\"؛ أي مدة زمنية، دهر من الوقت)\nمثال: صلى زيري العصر. / مَوْسِم / مَوْسِم, جُزْء",
 "最終": "آخِر (ضد الأوَّل؛ وهو من يكون ترتيبه بعد الجميع؛ الشيء: مؤخرّه، الجزء الآخير منه) / مَاضٍ, الْمَاضِي ((في النحو) زمن نحوي يدل على حدث قد وقع، أو وُجِد قبل الآن بوقت ما) / آخر (ضد الأوَّل؛ وهو من يكون ترتيبه بعد الجميع؛ الشيء: مؤخرّه، الجزء الآخير منه) / اِسْتَمَرَّ, دَامَ\nمثال: أرني مثالا آخر.",
 "最終学年": "اَلْعَامَ اَلْمَاضِيَ, اَلسَّنَةَ ٱلْمَاضِيَةَ",
 "最終手段": "الملاذ الأخير, حل يائس (وسيلة لا يتم اللجوء إليها إلا عند اليأس)",
 "最終日": "يوم الحساب, يوم الدين (اليوم في نهاية الزمان الذي سيقضي فيه الله بمصير جميع البشر وفقاً لأعمالهم)",
 "最終決定": "حكم نهائي (حكم يفصل في القضية المعروضة على المحكمة؛ بعد صدور الحكم (أو الاستئناف منه) كل ما تبقى هو إنفاذ الحكم)",
 "最終的": "أَخِير, نِهَائِيّ (لا يمكن تغييره أو التراجع عنه) / أَخِير, خِتَامِيّ (يَقَعُ فِي نِهَايَةِ شَيْءٍ أَوْ يُشَكِّلُ خَاتِمَتَهُ) / أَخِير, خِتَامِيّ (حاسم في عملية أو مسار تقدمي) / امتحان نهائي (امتحان يجرى في نهاية الفصل الدراسي)",
 "最終的に": "أخيراً, في الختام (كنتيجة نهائية لتتابع أو عملية) / في النهاية (في نهاية المطاف أو بعد فترة طويلة)\nمثال: في النهاية كان عليه الاستسلام",
 "最終結論": "مخرجات, منتج نهائي (المنتج النهائي؛ الأشياء المنتجة)",
 "最終製品": "مخرجات, منتج نهائي (المنتج النهائي؛ الأشياء المنتجة)",
 "最終財": "مخرجات, منتج نهائي (المنتج النهائي؛ الأشياء المنتجة)",
 "最終通告": "بِلَاغ نِهَائِيّ",
 "最終選考": "قائمة مختصرة (قائمة بالمتقدمين تم تصفيتهم من قائمة أطول واعتبروا مناسبين وسيتم اختيار الشخص الناجح منهم)",
 "最良": "أَفْضَل",
 "最西": "أَقْصَى الغَرْب (الأبعد باتّجاه الغرب)",
 "最賃": "حد أدنى للأجور (مُنْتَهى الشيءِ؛ الْفَصْلُ بَيْنَ الشَّيْئَيْنِ لِئَلَّا يَخْتَلِطَ أَحدهما بِالْآخَرِ أَو لِئَلَّا يَتَعَدَّى أَحدهما عَلَى الْآخَرِ)\nمثال: أعرفها إلى حد ما.",
 "最賃法": "حد أدنى للأجور (مُنْتَهى الشيءِ؛ الْفَصْلُ بَيْنَ الشَّيْئَيْنِ لِئَلَّا يَخْتَلِطَ أَحدهما بِالْآخَرِ أَو لِئَلَّا يَتَعَدَّى أَحدهما عَلَى الْآخَرِ)\nمثال: أعرفها إلى حد ما.",
 "最近": "مُؤَخَّرًا / حَدِيثًا / بِأَخَرَة / الأقرب ((صيغة التفضيل لـ قريب) ضمن أقصر مسافة)\nمثال: كان ذلك الوقت الذي اقترب فيه الأقرب إلى الموت",
 "最近親": "أقرب الأقرباء (الشخص (أو الأشخاص) الأكثر قرابة لشخص معين)",
 "最速": "الأسرع (بأقصى سرعة)",
 "最速化": "اِسْتِمْثَال, مُلَاءَمَة",
 "最遅": "الأبطأ (بأقصى بطء)",
 "最遠": "الأبعد, الأقصى (إلى أقصى مسافة في المكان أو الزمان) / الأبعد, الأقصى (إلى أقصى درجة أو مدى أو مرحلة متقدمة) / أَبْعَد, أَقْصَى (الأكثر بُعداً في المكان أو الزمان أو الترتيب)\nمثال: انظر من يستطيع القفز لأبعد مسافة",
 "最適": "أَمْثَل, مِثَالِيّ (الأكثر استحساناً ضمن قيد معين صريح أو ضمني) / أَفْضَل حَال, أَمْثَل (الظروف الأكثر ملاءمة أو أقصى درجة أو كمية ممكنة في ظل ظروف معينة)",
 "最適化": "اِسْتِمْثَال, مُلَاءَمَة",
 "最重度": "سَحِيق, غَوْر (يَقَعُ فِي عُمْقٍ كَبِيرٍ أَوْ يَمْتَدُّ إِلَيْهِ؛ أَعْمَقُ مِنْ أَنْ يُسْبَرَ) / ثَقِيل, عَمِيق ((عَنِ النَّوْمِ) عَمِيقٌ وَتَامّ) / عَمِيقٌ مِنَ الأَعْمَاق (نَابِعٌ مِنْ أَعْمَاقِ النَّفْس) / بَالِغُ العُمْق, عَمِيقٌ جِدًّا (مِنْ أَشَدِّ دَرَجَاتِ الحِدَّةِ؛ تَامّ)",
 "最長": "لأطول فترة (لأكثر وقت)\nمثال: بقيت لأطول فترة",
 "最頻値": "وَضْع (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه) / مِنْوَال\nمثال: لقد أزمت الوضع.",
 "最高": "أَفْضَل / أعظمي, أقصى (الأعظم أو الأكثر اكتمالاً أو الأفضل الممكن) / أقصى, غاية (أقصى درجة ممكنة) / حد أقصى, نهاية عظمى (النقطة على المنحنى حيث يتغير المماس من موجب على اليسار إلى سالب على اليمين) / حد أقصى, ذروة (أكبر كمية ممكنة)\nمثال: توسع أقصى",
 "最高会議": "مَجْلِس السُّوفْيِت الْأَعْلَى",
 "最高位": "مكان الصدارة (المكان الأول أو الأعلى أو الأكثر أهمية أو الأكثر تفاخراً)",
 "最高作": "التحفة الكبرى, العمل العظيم (عمل فني أو أدبي عظيم)",
 "最高値": "تَارِيخِيّ, غَيْرُ مَسْبُوق (لم يُتجاوَز في جانب ما حتى الآن)",
 "最高傑作": "تُحْفَة, رَائِعَة",
 "最高執行責任者": "رئيس تنفيذي (المسؤول التنفيذي للشركة المسؤول عن عمليات الشركة؛ يقدم تقاريره إلى مجلس الإدارة؛ قد يعين مديرين آخرين (بما في ذلك الرئيس))",
 "最高峰": "قِمَّة / يضع شيء على قمة عالية",
 "最高情報責任者": "مؤتمر المنظمات الصناعية (اتحاد للنقابات الصناعية في أمريكا الشمالية اندمج مع الاتحاد الأمريكي للعمل في عام 1955)",
 "最高投資責任者": "مؤتمر المنظمات الصناعية (اتحاد للنقابات الصناعية في أمريكا الشمالية اندمج مع الاتحاد الأمريكي للعمل في عام 1955)",
 "最高指導者": "المُرْشِد الأَعْلَى لِلْثَّوْرَة الإِسْلَامِيَّة, قَائِد الثَّوْرَة الْإِسْلَامِيَّة",
 "最高指揮官": "رَئِيس أَرْكَان",
 "最高殊勲選手": "أفضل لاعب, اللاعب الأكثر قيمة (اللاعب الذي يُحكم عليه بأنه الأكثر أهمية للرياضة أو الفريق)",
 "最高気温": "عَالٍ, اَلْعَالِي (افتقر واحتاج إلى مساعدة غيره المادية؛ عاله الشيء: اعوزه واحتاجه) / مَسْطُول\nمثال: بدأ يبكي بصوت عال",
 "最高水準": "علامة المد العالي (خط يحدد أعلى مستوى تم الوصول إليه)",
 "最高法院": "مَحْكَمَة عُلْيَا (مقام الحاكم. وغلبت على مقام الحاكم الشرعي أي القاضي)\nمثال: عاد إلى المحكمة.",
 "最高潮": "ذروة جنسية, رعشة الجماع (لحظة أقصى متعة أثناء الاتصال الجنسي) / تتويج, ذروة (اللحظة الحاسمة في رواية أو مسرحية) / تصاعد, ذروة (ترتيب الجمل بترتيب تصاعدي من حيث القوة) / ذروة, قمة (أعلى نقطة لأي شيء يتصور أنه ينمو أو يتطور أو يتكشف)\nمثال: مشهد فراش الموت هو ذروة المسرحية",
 "最高経営責任者": "رَئِيس تَنْفِيذِيّ",
 "最高裁": "مَحْكَمَة عُلْيَا (مقام الحاكم. وغلبت على مقام الحاكم الشرعي أي القاضي)\nمثال: عاد إلى المحكمة.",
 "最高裁事務総局": "مَحْكَمَة عُلْيَا (مقام الحاكم. وغلبت على مقام الحاكم الشرعي أي القاضي)\nمثال: عاد إلى المحكمة.",
 "最高裁判事": "مَحْكَمَة عُلْيَا (مقام الحاكم. وغلبت على مقام الحاكم الشرعي أي القاضي)\nمثال: عاد إلى المحكمة.",
 "最高裁判所": "مَحْكَمَة عُلْيَا (مقام الحاكم. وغلبت على مقام الحاكم الشرعي أي القاضي)\nمثال: عاد إلى المحكمة.",
 "最高裁判所図書館": "مَحْكَمَة عُلْيَا (مقام الحاكم. وغلبت على مقام الحاكم الشرعي أي القاضي)\nمثال: عاد إلى المحكمة.",
 "最高裁裁判官": "مَحْكَمَة عُلْيَا (مقام الحاكم. وغلبت على مقام الحاكم الشرعي أي القاضي)\nمثال: عاد إلى المحكمة.",
 "最高財務責任者": "مدير مالي (المسؤول التنفيذي للشركة الذي لديه سلطة مالية لتخصيص الاعتمادات والتفويض بالنفقات لشركة ما)",
 "最高責任者": "الرئيس, رئيس الولايات المتحدة (منصب رئيس دولة الولايات المتحدة) / الرئيس الأمريكي, رئيس الولايات المتحدة (الشخص الذي يشغل منصب رئيس الدولة في حكومة الولايات المتحدة)\nمثال: يتم انتخاب الرئيس كل أربع سنوات",
 "最高限": "قِمَّة",
 "最高限度": "حد شمالي, حد علوي (الحد الموجود على الجانب العلوي (أو الشمالي) لشيء ما) / حد أقصى, ذروة (أكبر كمية ممكنة)",
 "最＆高": "أَفْضَل",
 "會澤": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "會田": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "月": "قَمَر, قمر (الكَوْكَب الذي يدور حول الأرْض ويظهر غالبا في الليل ويعكس ضوء الشَمْس. مذكر لا يؤنث؛ أي كوكب يدور حول كوكب آخر، لا يشمل ذلك الكواكب التي تدور حول شُمُوس. مذكر لا يؤنث)\nمثال: ضوء القمر ضعيف. / شَهْر (اسم مفرد: مدة زمنية قدرها 28 أو 29 أو 30 أو 31 يوما، والشَّهرُ جزءٌ من اثني عشر جزئا من السَنَة…)\nمثال: رمضان شهر حرام. / ضَوْء قَمَر (النُّور؛ مصدر ضَاء)\nمثال: ضوء القمر ضعيف. / الْاِثْنَيْن, يَوْم الْاِثْنَيْن",
 "月々": "شَهْرِيّ / شَهْرِيًّا",
 "月あかり": "ضَوْء قَمَر (النُّور؛ مصدر ضَاء)\nمثال: ضوء القمر ضعيف.",
 "月ごと": "شَهْرِيّ / شَهْرِيًّا",
 "月のもの": "حَيْض, طَمْث (الحَيْضُ : الدورة التي ينزل فيها الدم من رَحِم المرأة البالغة في أَيَّامٍ معلومةٍ كلَّ شهر؛ أعراض ما قبل الحيض (في ): أعراض تشمل انتفاخ البطن وألم الصدر والصداع والشعور بالتّعب وحدَّة الطبع والتهيّج العصبيّ والاكتئاب…)",
 "月の入り": "سُدْفَة, فَحْمَة",
 "月の出": "شَفَق, غَسَق ((شَفِقَ) منه، وعليه يَشْفَقَ شَفَقًا: خاف وحَذِرَ، فهو شَفِقٌ؛ (شَفِقَ) عليه: رَقَّ له وعطف عليه؛ فهو شَفِيقٌ)\nمثال: أثارت تلك السلحفاة شفقة زيري.",
 "月の剣": "مُحَاق (الثَلَاثُ المُِحَاق: آخر ثلاث ليالٍ من كل شهر قمري وفيها السِّرَار وقيل ليلة خمس وست وسبع وقيل غير ذلك وقد تكون ليلتان في الأشهر ذَات التسع والعشرون…) / مَحَاق (الثَلَاثُ المُِحَاق: آخر ثلاث ليالٍ من كل شهر قمري وفيها السِّرَار وقيل ليلة خمس وست وسبع وقيل غير ذلك وقد تكون ليلتان في الأشهر ذَات التسع والعشرون…) / مِحَاق (الثَلَاثُ المُِحَاق: آخر ثلاث ليالٍ من كل شهر قمري وفيها السِّرَار وقيل ليلة خمس وست وسبع وقيل غير ذلك وقد تكون ليلتان في الأشهر ذَات التسع والعشرون…)",
 "月の物": "حَيْض, طَمْث (الحَيْضُ : الدورة التي ينزل فيها الدم من رَحِم المرأة البالغة في أَيَّامٍ معلومةٍ كلَّ شهر؛ أعراض ما قبل الحيض (في ): أعراض تشمل انتفاخ البطن وألم الصدر والصداع والشعور بالتّعب وحدَّة الطبع والتهيّج العصبيّ والاكتئاب…)",
 "月の輪": "قَمَر, قمر (الكَوْكَب الذي يدور حول الأرْض ويظهر غالبا في الليل ويعكس ضوء الشَمْس. مذكر لا يؤنث؛ أي كوكب يدور حول كوكب آخر، لا يشمل ذلك الكواكب التي تدور حول شُمُوس. مذكر لا يؤنث)\nمثال: ضوء القمر ضعيف.",
 "月の障り": "حيض, دورة شهرية (الإفراز الشهري للدم من رحم النساء غير الحوامل من سن البلوغ حتى سن اليأس)\nمثال: كانت النساء مريضات وعرضة للحيض المفرط",
 "月ヶ瀬": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "月下推敲": "بُولَنْدِيّ / لَمَّعَ (لمع أي أصدر ضَوْءً أو عَكَسَهُ) / صَقَل",
 "月下氷人": "حلقة وصل, وسيط (مفاوض يعمل كحلقة وصل بين الأطراف)",
 "月下美人": "شمعية ليلية الإزهار (أي من الصباريات المتعددة من جنس الشمعية) / شمعية ليلية الإزهار (أي من الصباريات المتعددة من جنس هيلوسيريوس) / شمعية ليلية الإزهار (أي من الصباريات الليلية الإزهار المتعددة من جنس سيلينيسيريوس)",
 "月下老人": "حلقة وصل, وسيط (مفاوض يعمل كحلقة وصل بين الأطراف)",
 "月下香": "مسك الروم (عشب مكسيكي درني له أوراق تشبه العشب ويزرع لسنابله من الزهور البيضاء الشمعية التي تشبه الزنبق وشديدة العطرية)",
 "月世界": "قَمَر, قمر (الكَوْكَب الذي يدور حول الأرْض ويظهر غالبا في الليل ويعكس ضوء الشَمْس. مذكر لا يؤنث؛ أي كوكب يدور حول كوكب آخر، لا يشمل ذلك الكواكب التي تدور حول شُمُوس. مذكر لا يؤنث)\nمثال: ضوء القمر ضعيف. / أصفر شاحب, تِبنِي (صبغة صفراء متغيرة؛ أصفر باهت، غالباً ما يكون مخففاً بالأبيض)",
 "月並": "مُبْتَذَل, مُسْتَهْلَك (مُكرَّر أكثر من اللازم؛ مألوف بشكل مفرط بسبب كثرة الاستخدام)",
 "月並み": "مُبْتَذَل, مُسْتَهْلَك (مُكرَّر أكثر من اللازم؛ مألوف بشكل مفرط بسبب كثرة الاستخدام)",
 "月事": "حَيْض, طَمْث (الحَيْضُ : الدورة التي ينزل فيها الدم من رَحِم المرأة البالغة في أَيَّامٍ معلومةٍ كلَّ شهر؛ أعراض ما قبل الحيض (في ): أعراض تشمل انتفاخ البطن وألم الصدر والصداع والشعور بالتّعب وحدَّة الطبع والتهيّج العصبيّ والاكتئاب…)",
 "月亭": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "月例": "شَهْرِيّ / شَهْرِيًّا",
 "月光": "ضَوْء قَمَر (النُّور؛ مصدر ضَاء)\nمثال: ضوء القمر ضعيف.",
 "月別": "شَهْرِيّ / شَهْرِيًّا",
 "月卿": "عَالِيّ الرُتْبَة",
 "月夜": "قَمَر, قمر (الكَوْكَب الذي يدور حول الأرْض ويظهر غالبا في الليل ويعكس ضوء الشَمْس. مذكر لا يؤنث؛ أي كوكب يدور حول كوكب آخر، لا يشمل ذلك الكواكب التي تدور حول شُمُوس. مذكر لا يؤنث)",
 "月夜に釜を抜かれる": "خطأ فادح, زلة (خطأ محرج)",
 "月夜見": "قَمَر, قمر (الكَوْكَب الذي يدور حول الأرْض ويظهر غالبا في الليل ويعكس ضوء الشَمْس. مذكر لا يؤنث؛ أي كوكب يدور حول كوكب آخر، لا يشمل ذلك الكواكب التي تدور حول شُمُوس. مذكر لا يؤنث)\nمثال: ضوء القمر ضعيف. / تْسُوكُويُومِي",
 "月天": "قَمَر, قمر (الكَوْكَب الذي يدور حول الأرْض ويظهر غالبا في الليل ويعكس ضوء الشَمْس. مذكر لا يؤنث؛ أي كوكب يدور حول كوكب آخر، لا يشمل ذلك الكواكب التي تدور حول شُمُوس. مذكر لا يؤنث)\nمثال: ضوء القمر ضعيف.",
 "月天子": "قَمَر, قمر (الكَوْكَب الذي يدور حول الأرْض ويظهر غالبا في الليل ويعكس ضوء الشَمْس. مذكر لا يؤنث؛ أي كوكب يدور حول كوكب آخر، لا يشمل ذلك الكواكب التي تدور حول شُمُوس. مذكر لا يؤنث)\nمثال: ضوء القمر ضعيف.",
 "月影": "ضَوْء قَمَر (النُّور؛ مصدر ضَاء)\nمثال: ضوء القمر ضعيف.",
 "月役": "حَيْض, طَمْث (الحَيْضُ : الدورة التي ينزل فيها الدم من رَحِم المرأة البالغة في أَيَّامٍ معلومةٍ كلَّ شهر؛ أعراض ما قبل الحيض (في ): أعراض تشمل انتفاخ البطن وألم الصدر والصداع والشعور بالتّعب وحدَّة الطبع والتهيّج العصبيّ والاكتئاب…)",
 "月日": "وَقْت (\"بَقِيَ وَقْتاً عِنْدَهُ \" : أَيْ مِقْدَاراً مِنَ الزَّمَنِ؛ \"جَاءَ فِي الوَقْتِ الْمُنَاسِبِ \" : فِي اللَّحْظَةِ الْمُنَاسِبَةِ) / مَرَّة, مرة (مؤنث مُرّ، صفة ما كان بها مرارة) / حِين, وَقْت ((حَيَّنَه): جعل لَهُ حينا؛ (حَيَّنَ) الله فلَانا: لم يوفقه للرشاد)\nمثال: حان وقت الذهاب. / تَمْرَة, تَمْر / تَارِيخ (جملة الأَحوال والأحداث التي يمر بها كائن ما، ويَصْدق على الفرد والمجتمع، كما يَصْدق على الظواهر الطبيعية والإنسانية؛ هو تحديد الزمن باليَوْم والشَهْر والسَنَة أو ببعضهما. الأجَل أو الوَقْت) / مُوَاعَدَة, مَوْعِد / لِقَاء الْحُبّ, مَوْعِد (وجود اثنين أو أكثر معًا، صدفةً أو تدبيرًا) / أَرَّخَ (أَرَخَّ الشيءَ: بالغ فيه؛ وأَرَخَّ العجينَ: أكثر ماءه)\nمثال: ما تاريخ اليوم؟",
 "月旦": "تَعْلِيق",
 "月旦評": "تَعْلِيق",
 "月明": "ضَوْء قَمَر (النُّور؛ مصدر ضَاء)\nمثال: ضوء القمر ضعيف.",
 "月明かり": "ضَوْء قَمَر (النُّور؛ مصدر ضَاء)\nمثال: ضوء القمر ضعيف.",
 "月曜": "الْاِثْنَيْن, يَوْم الْاِثْنَيْن",
 "月曜日": "الْاِثْنَيْن, يَوْم الْاِثْنَيْن",
 "月月": "شَهْرِيّ / شَهْرِيًّا",
 "月月火水木金金": "لِمُدَّة أُسْبُوع (يَسْتَمِرّ أُسبوعًا كامِلًا)",
 "月末": "النِهاية",
 "月桂": "غَار / قَمَر, قمر (الكَوْكَب الذي يدور حول الأرْض ويظهر غالبا في الليل ويعكس ضوء الشَمْس. مذكر لا يؤنث؛ أي كوكب يدور حول كوكب آخر، لا يشمل ذلك الكواكب التي تدور حول شُمُوس. مذكر لا يؤنث)\nمثال: ضوء القمر ضعيف. / سيرسيديفيلوم, كاتسورا (شجرة نفضية سريعة النمو في سفوح الجبال المنخفضة في الصين واليابان؛ تزرع للزينة لأوراقها الخضراء المزرقة الداكنة برائحة الحلوى التي تتحول إلى الأصفر…)",
 "月桂冠": "إِكْلِيل الْغَار",
 "月桂樹": "غَار",
 "月桃": "زنجبيل الصدفة, زهرة الصدفة (يزرع لأوراقه المستطيلة اللامعة وعناقيده المقوسة من الزهور البيضاء ذات الظلال الوردية والشفاه الصفراء المجعدة ذات الخطوط الأرجوانية المبرقشة)",
 "月極め駐車場": "مَوْقِف سَيَّارَات, مَوْقِف",
 "月極駐車場": "مَوْقِف سَيَّارَات, مَوْقِف",
 "月次": "مُبْتَذَل, مُسْتَهْلَك (مُكرَّر أكثر من اللازم؛ مألوف بشكل مفرط بسبب كثرة الاستخدام)",
 "月毎": "شَهْرِيّ / شَهْرِيًّا",
 "月毛": "بالومينو (حصان لونه أسمر فاتح أو ذهبي مع عرف وذيل بلون الكريم أو الأبيض)",
 "月火水木金": "يَوْم عَمَل (فترة من الزمان تبدأ عند غُرُوب الشمس وتنتهي عند غُرُوب شمس النهار التالي ويشمل اللَيْلَة ونَهَارا. طوله أربع وعشرين سَاعَة؛ النَهَار، يبدأ من طلوع الفَجْر إلى غُرُوب الشَمس، على المجاز)\nمثال: طقس اليوم جميل.",
 "月状骨": "عظم هلالي (أحد عظام الرسغ الصغيرة الثمانية)",
 "月球": "قَمَر, قمر (الكَوْكَب الذي يدور حول الأرْض ويظهر غالبا في الليل ويعكس ضوء الشَمْس. مذكر لا يؤنث؛ أي كوكب يدور حول كوكب آخر، لا يشمل ذلك الكواكب التي تدور حول شُمُوس. مذكر لا يؤنث)",
 "月相": "طور القمر, منزلة القمر (وقت يقدم فيه القمر مظهراً متكرراً معيناً)",
 "月着陸": "هُبُوط عَلَى الْقَمَر",
 "月着陸船": "مركبة الهبوط على القمر, وحدة قمرية (مركبة فضائية تحمل رواد الفضاء من وحدة القيادة إلى سطح القمر والعودة)",
 "月砂": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "月経": "حَيْض, طَمْث (الحَيْضُ : الدورة التي ينزل فيها الدم من رَحِم المرأة البالغة في أَيَّامٍ معلومةٍ كلَّ شهر؛ أعراض ما قبل الحيض (في ): أعراض تشمل انتفاخ البطن وألم الصدر والصداع والشعور بالتّعب وحدَّة الطبع والتهيّج العصبيّ والاكتئاب…)",
 "月経前": "سابق للحيض (مكون من أو متعلق بـ أو يحدث خلال الوقت الذي يسبق الحيض مباشرة)",
 "月経前症候群": "متلازمة ما قبل الحيض (متلازمة تحدث لدى العديد من النساء قبل 2 إلى 14 يوماً من بدء الحيض)",
 "月経周期": "حيض, دورة شهرية (دورة متكررة (تبدأ عند البلوغ وتنتهي عند انقطاع الطمث) تستعد فيها بطانة الرحم للحمل؛ وإذا لم يحدث حمل، تتساقط البطانة أثناء الحيض)\nمثال: متوسط الدورة الشهرية هو 28 يوماً",
 "月経困難症": "عسر الطمث (حيض مؤلم)",
 "月経帯": "فوطة صحية (وسادة ماصة تستخدم لمرة واحدة؛ تُرتدى لامتصاص تدفق الدورة الشهرية)",
 "月経過多": "حيض, طمث (تدفق الدم من الرحم؛ يحدث على فترات شهرية تقريباً خلال سنوات الإنجاب للمرأة)",
 "月経閉止期": "إِيَاس",
 "月給日": "يوم الدفع, يوم الراتب (اليوم الذي تتلقى فيه أجراً عن عملك)",
 "月給泥棒": "انتهازي, طفيلي (شخص يستغل كرم الآخرين)",
 "月色": "ضَوْء قَمَر (النُّور؛ مصدر ضَاء)\nمثال: ضوء القمر ضعيف.",
 "月華": "قَمَر, قمر (الكَوْكَب الذي يدور حول الأرْض ويظهر غالبا في الليل ويعكس ضوء الشَمْس. مذكر لا يؤنث؛ أي كوكب يدور حول كوكب آخر، لا يشمل ذلك الكواكب التي تدور حول شُمُوس. مذكر لا يؤنث)",
 "月蝕": "خُسُوف اَلْقَمَر",
 "月見草": "أخدرية, زهرة الربيع المسائية",
 "月見里": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "月読": "قَمَر, قمر (الكَوْكَب الذي يدور حول الأرْض ويظهر غالبا في الليل ويعكس ضوء الشَمْس. مذكر لا يؤنث؛ أي كوكب يدور حول كوكب آخر، لا يشمل ذلك الكواكب التي تدور حول شُمُوس. مذكر لا يؤنث)\nمثال: ضوء القمر ضعيف. / تْسُوكُويُومِي",
 "月読み": "قَمَر, قمر (الكَوْكَب الذي يدور حول الأرْض ويظهر غالبا في الليل ويعكس ضوء الشَمْس. مذكر لا يؤنث؛ أي كوكب يدور حول كوكب آخر، لا يشمل ذلك الكواكب التي تدور حول شُمُوس. مذكر لا يؤنث)\nمثال: ضوء القمر ضعيف. / تْسُوكُويُومِي",
 "月讀": "قَمَر, قمر (الكَوْكَب الذي يدور حول الأرْض ويظهر غالبا في الليل ويعكس ضوء الشَمْس. مذكر لا يؤنث؛ أي كوكب يدور حول كوكب آخر، لا يشمل ذلك الكواكب التي تدور حول شُمُوس. مذكر لا يؤنث)\nمثال: ضوء القمر ضعيف. / تْسُوكُويُومِي",
 "月輪": "قَمَر, قمر (الكَوْكَب الذي يدور حول الأرْض ويظهر غالبا في الليل ويعكس ضوء الشَمْس. مذكر لا يؤنث؛ أي كوكب يدور حول كوكب آخر، لا يشمل ذلك الكواكب التي تدور حول شُمُوس. مذكر لا يؤنث)\nمثال: ضوء القمر ضعيف.",
 "月長石": "حَجَرُ ٱلْقَمْر (حَجَرَ عليه الأمرَ:مَنَعَه منه ، حجر الشّيء على نفسه:خَصَّها به وقصره عليها؛ الحجْرُ: المَنْعُ مِن التَّصَرُّفِ ، وحَجَرَ عَلَيْهِ القاضِي يَحْجُرُ حَجْراً، إِذا مَنَعَه مِن التَّصَرُّفِ فِي مالِه)\nمثال: عوقب زيري بالحجر.",
 "月間": "شَهْر (اسم مفرد: مدة زمنية قدرها 28 أو 29 أو 30 أو 31 يوما، والشَّهرُ جزءٌ من اثني عشر جزئا من السَنَة…)\nمثال: رمضان شهر حرام.",
 "月隠り": "يوم الحساب, يوم الدين (اليوم في نهاية الزمان الذي سيقضي فيه الله بمصير جميع البشر وفقاً لأعمالهم)",
 "月面着陸": "هُبُوط عَلَى الْقَمَر",
 "月食": "خُسُوف اَلْقَمَر",
 "月餅": "كَعْكَة اَلْقَمَر (واحدة الكَعْك؛ حَلْوَى تُصْنع من الدَقِيق والحَلِيب والسُكَّر والزَيت ويخبز طريًا وقد يوضع عليه القِشْطَة. يُسمى عند البعض كَيْك وعند البعض تُورْتَة)\nمثال: خبزت كعكة لتوم.",
 "月魄": "ضَوْء قَمَر (النُّور؛ مصدر ضَاء)\nمثال: ضوء القمر ضعيف.",
 "有": "وُجُود, كَيْنُونَة (خِلاف العَدَم، وهي الحالة التي يكون الشيء أو الأمر أو الشخص فيها كَائِن ومَوْجُوْد؛ الوجود يقصد به كل ما هو كائن وموجود في الكَوْن)\nمثال: لا وجود للصدف ! / مَسّ, تَلَبُّس / مُمْتَلَك / حَوْزَة, مُلْكِيّة / اِسْتِحْوَاذ / حِيَازَة / شَرِكَة مَحْدُودَة / مَوْجُود (الذي له وجود)\nمثال: أنا موجود لوحدي / بشكل حسن, على ما يرام (بطريقة مرضية أو كافية) / تمام, حسناً (تعبير عن الموافقة يحدث عادة في بداية الجملة) / بالتأكيد, بلا شك (بدون شك (تستخدم لتعزيز تأكيد)) / مَقْبُول ((استخدام غير معياريّ) مُرْضٍ)\nمثال: ستبلي حسناً بمفردها / كَانَ (اِتَّصَفَ. (فعل ناقص)؛ حَدَثَ) / كَانَ هُوَ, هِيَ (اِتَّصَفَ. (فعل ناقص)؛ حَدَثَ)\nمثال: كان الكلب ميتا.",
 "有する": "مَلَكَ, اِمْتَلَكَ (لغة في المَالِك، وهو الذي يَمْلِكُ؛ السُلْطَان الحَاكِم الذي يملك الأَرْض والبِلاد) / تَنَاوَلَ (فعل مطاوعة من نَاوَلَ، ناولته فتناول؛ أخذ الشيء الذي ناولته إياه؛ الطعام والدواء: أكَلَه)\nمثال: زيري ملك لنفسه.",
 "有った": "مَاضٍ, الْمَاضِي ((في النحو) زمن نحوي يدل على حدث قد وقع، أو وُجِد قبل الآن بوقت ما)",
 "有らざる": "لَا, مَا (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها) / مثال: لا أحب المدرسة.",
 "有らず": "لَا, مَا (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها) / مثال: لا أحب المدرسة.",
 "有らずもがな": "غَيْر ضَرُورِيّ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "有らない": "مَعْدُوم",
 "有らぬ": "مُخْطِئ / ظَلَمَ (الثَلَاثُ الظُلَم: الليلة التاسعة عشر، والعشرون، والحادية والعشرون من كل شهر قمري، وسميت بذلك لظلمتها. يسبقها الثلاث الدُرَع ويليها الثلاث الحنادس)\nمثال: نحن نرفض الظلم. / مُخْتَلِف / آٰخَر (ضد الأوَّل؛ وهو من يكون ترتيبه بعد الجميع؛ الشيء: مؤخرّه، الجزء الآخير منه)\nمثال: أرني مثالا آخر. / مُفَاجِئ",
 "有らぬ事": "لَا يَخْطُرُ عَلَى الْبَالِ (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: لا أحب المدرسة.",
 "有らまほしい": "مرغوب فيه, مستحب (يستحق الامتلاك أو السعي إليه أو تحقيقه) / جَدِير, لَائِق (جدير بالاختيار خاصة كشريك زواج)\nمثال: وظيفة مرغوبة",
 "有らん限り": "كُلّ, جَمِيع",
 "有り": "مَوْجُود (الذي له وجود)\nمثال: أنا موجود لوحدي / بشكل حسن, على ما يرام (بطريقة مرضية أو كافية) / تمام, حسناً (تعبير عن الموافقة يحدث عادة في بداية الجملة) / بالتأكيد, بلا شك (بدون شك (تستخدم لتعزيز تأكيد)) / مَقْبُول ((استخدام غير معياريّ) مُرْضٍ)\nمثال: ستبلي حسناً بمفردها / كَانَ (اِتَّصَفَ. (فعل ناقص)؛ حَدَثَ) / كَانَ هُوَ, هِيَ (اِتَّصَفَ. (فعل ناقص)؛ حَدَثَ)\nمثال: كان الكلب ميتا.",
 "有りける": "السَّابِقُ ذِكْرُهُ",
 "有りさま": "وَضْع (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه) / دَوْلَة (بَلَد يتميز بحُدُود معروفة وشَعْب وحُكُومَة ومُؤَسَسَات مُنَظَّمَة؛ مجموعة من الناس مستقلين متحدين معا لتكوين مجتمع لحماية حقوقهم و وضع قوانينهم الخاصة) / وِلَايَة (منطقة إدارية لها استقلالها الإداري والمعنوي؛ ويختلف المعنى من بلد لآخر كما يختلف من فترة زمنية لأخرى) / يُبْدِي\nمثال: لقد أزمت الوضع. / حَقِيقَة (الحَقّ، نقيض البَاطِل؛ نقيض المَجَاز)\nمثال: هي صديقة حقيقة.",
 "有りし": "رئيس الدير (رئيس رهبنة دينية؛ في الدير يكون أقل رتبة من الأباتي)",
 "有りそう": "رَاجِح, مُحْتَمَل (يُرَجَّح حُدوثُه أَوْ وُقوعُه) / محتمل, مرجح (مرجح ولكن ليس مؤكداً أن يكون حقيقياً أو واقعياً) / مرشح مرجح (متقدم من المرجح أن يتم اختياره)\nمثال: نتيجة محتملة",
 "有りそうもない": "عَجِيب, مُسْتَبْعَد (مستبعد جداً بحيث لا يمكن تصديقه) / غير محتمل, مستبعد (ليس من المرجح أن يكون صحيحاً أو أن يحدث أو أن يكون قد حدث) / غَيْر مُقْنِع, مُسْتَبْعَد (ذو احتمالية منخفضة جداً لا تبعث على التصديق)\nمثال: التشريع بشأن هذه المسألة مستبعد للغاية",
 "有りの実": "كُمَّثْرَى, إِجَّاص",
 "有りもしない": "مَعْدُوم",
 "有り丈": "كَامِل / كُلّ",
 "有り体に": "في الواقع, كما هو الحال (في الحالة الفعلية للأمور وغالباً ما تكون عكس التوقعات)\nمثال: كان من الممكن أن يُقتل؛ ولكن في الواقع، أصيب بجروح خطيرة",
 "有り切れ": "بقايا قماش, فضلة قماش (قطعة قماش متبقية بعد استخدام الباقي أو بيعه) / بقايا (جزء صغير أو حصة تتبقى بعد زوال الجزء الرئيسي)",
 "有り布": "بقايا قماش, فضلة قماش (قطعة قماش متبقية بعد استخدام الباقي أو بيعه) / بقايا (جزء صغير أو حصة تتبقى بعد زوال الجزء الرئيسي)",
 "有り得ない": "مُسْتَحِيل / لَا يَخْطُرُ عَلَى الْبَالِ (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: لا أحب المدرسة.",
 "有り得ない程": "لا يصدق (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: لا أحب المدرسة.",
 "有り得べからざる": "لَا يُعْذَر, لَا يُغْتَفَر (لَا يُمْكِنُ التَّمَاسُ العُذْرِ لَه) / غير معذور, لا مبرر له (بدون عذر أو مبرر)",
 "有り得べき": "مُمْكِن / مُفَضَّل, أَفْضَل",
 "有り得る": "مُمْكِن",
 "有り有り": "بوضوح (بدون شك أو تساؤل) / بشكل متميز, بوضوح (واضح للعقل؛ بتمييز عقلي واضح) / بشكل مفهوم, بوضوح (بطريقة يمكن فهمها) / بِوُضُوح (بطريقة يسهل إدراكها)\nمثال: كانوا تائهين بوضوح",
 "有り様": "وَضْع (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه) / دَوْلَة (بَلَد يتميز بحُدُود معروفة وشَعْب وحُكُومَة ومُؤَسَسَات مُنَظَّمَة؛ مجموعة من الناس مستقلين متحدين معا لتكوين مجتمع لحماية حقوقهم و وضع قوانينهم الخاصة) / وِلَايَة (منطقة إدارية لها استقلالها الإداري والمعنوي؛ ويختلف المعنى من بلد لآخر كما يختلف من فترة زمنية لأخرى) / يُبْدِي\nمثال: لقد أزمت الوضع. / حَقِيقَة (الحَقّ، نقيض البَاطِل؛ نقيض المَجَاز)\nمثال: هي صديقة حقيقة.",
 "有り難い": "مُمْتَنّ, شَاكِر",
 "有り難いことに": "لحسن الحظ (من حسن الحظ أن) / بامتنان, بشكر (بطريقة ممتنة؛ مع الشكر)\nمثال: لحسن الحظ لم يأت إلى الحفلة",
 "有り難い事に": "لحسن الحظ (من حسن الحظ أن) / بامتنان, بشكر (بطريقة ممتنة؛ مع الشكر)\nمثال: لحسن الحظ لم يأت إلى الحفلة",
 "有り難う": "شُكْرًا, تِسْلَم",
 "有り難うございました": "شُكْرًا, تِسْلَم",
 "有り難うございます": "شُكْرًا, تِسْلَم",
 "有り難う御座います": "شُكْرًا, تِسْلَم",
 "有り難さ": "قِيمَة",
 "有り難し": "نَادِر",
 "有り難み": "قِيمَة",
 "有り難や": "الْحَمْدُ لِلّٰهِ",
 "有り難味": "قِيمَة",
 "有る": "كَانَ (اِتَّصَفَ. (فعل ناقص)؛ حَدَثَ) / كَانَ هُوَ, هِيَ (اِتَّصَفَ. (فعل ناقص)؛ حَدَثَ)\nمثال: كان الكلب ميتا. / مَلَكَ, اِمْتَلَكَ (لغة في المَالِك، وهو الذي يَمْلِكُ؛ السُلْطَان الحَاكِم الذي يملك الأَرْض والبِلاد) / تَنَاوَلَ (فعل مطاوعة من نَاوَلَ، ناولته فتناول؛ أخذ الشيء الذي ناولته إياه؛ الطعام والدواء: أكَلَه)\nمثال: زيري ملك لنفسه. / حَدَثَ, جَرَى (وَقَعَ الأمر؛ نقيض قَدُمَ، كان حَدِيثا)\nمثال: لا أصدق ما حدث. / وُجِدَ (أَدْرَكَ المطلوب، أَدْرَكَ الشيء الذي أَرَادَهُ وبَحَثَ عنه؛ غَضِبَ عليه. (يتعدى بعلى))\nمثال: وجد ياني هاتفه.",
 "有るたけ": "كَامِل / كُلّ",
 "有るだけ": "كَامِل / كُلّ",
 "有るべき": "مِثَالِيّ",
 "有る限り": "كُلّ, جَمِيع",
 "有事": "طَوَارِئ, حَالَةْ اَلطَّوَارِئ",
 "有人": "مأهول (لديه طاقم)\nمثال: اعتبر القمر الصناعي الأرضي المأهول خطوة بحثية ضرورية",
 "有休": "إجازة مدفوعة الأجر (إجازة من العمل للموظف مع منح الراتب)",
 "有休消化": "استهلاك, صرف (عملية استهلاك شيء ما)",
 "有体": "مَلْمُوْس",
 "有体に": "في الواقع, كما هو الحال (في الحالة الفعلية للأمور وغالباً ما تكون عكس التوقعات)\nمثال: كان من الممكن أن يُقتل؛ ولكن في الواقع، أصيب بجروح خطيرة",
 "有余": "قَلِيلًا / إفراط في التدليل (التدليل المفرط) / زَائِد, فَائِض (أكثر مما هو مطلوب أو مرغوب فيه أو لازم) / إفراط, تجاوز (عدم الاعتدال نتيجة لتجاوز الحدود الكافية أو المسموح بها) / زيادة, فائض (كمية أكبر بكثير مما هو مطلوب)\nمثال: أفسد الطفل بسبب الإفراط في التدليل",
 "有余年": "أكثر, مزيد من ((صيغة المقارنة من 'كثير' للمعدود وغير المعدود) محدد كمية يعني أكبر في الحجم أو الكمية أو المدى أو الدرجة)\nمثال: مزيد من الأرض",
 "有価": "قَيِّم, ثَمِين (صيغة مبالغة من الفعل قَامَ، أي الكثير القيام؛ القَيِّم على الأمر مُتَوَلِّيه، الذي يقوم به ويكون في وِلايَةه)\nمثال: إعطي قيمة لذاتك.",
 "有価物": "قَيِّم, ثَمِين (صيغة مبالغة من الفعل قَامَ، أي الكثير القيام؛ القَيِّم على الأمر مُتَوَلِّيه، الذي يقوم به ويكون في وِلايَةه)\nمثال: إعطي قيمة لذاتك.",
 "有償": "دَفْع (لزّه ونحاه وأبعده؛ صرفه قبل وروده، أي منعه وأبعده قبل مجيئه أو حدوثه، وعكسه أن يرفعه، اي أن يصرفه بعد حدوثه)\nمثال: دفع زيري الثمن.",
 "有利": "مُفِيد, مُوَاتٍ (يمنح ميزة) / مُنَاسِب, مُوَاتٍ (ملائم لتحقيق غاية معينة؛ يُلَمِّح إلى قلة الاكتراث بالعدالة)\nمثال: عقد مفيد لبلدنا / مجد, مربح (يدر مكسباً مادياً أو ربحاً)\nمثال: مضاربة مربحة في سوق الأسهم",
 "有利子負債": "مدر للفائدة (للالتزامات المالية التي يُدفع عليها فائدة)",
 "有刺鉄線": "سِلْك شَائِك (السِّلْكُ : الخيطُ الذي ينظَم فيه الخرز ونحوه، أَو الذي يخاط به؛ السِّلْكُ : خيط من معدن تسري فيه الكهرباء)\nمثال: هذا السلك ساخن.",
 "有力": "ذو نفوذ, مؤثر (لديه أو يمارس تأثيراً أو سلطة)\nمثال: صحيفة مؤثرة / قَوِيّ (اسم من أسماء الله الحسنى؛ الشَدِيْد ذو الحَوْل) / مَنِيع, مَتِيْن / قَوِيّ, راسِخ (اسم من أسماء الله الحسنى؛ الشَدِيْد ذو الحَوْل) / شَدِيْد, قَوْيّ / شَدِيْد / حَادّ, ثَقِيْل (مَالَ وَانْحَرَفَ عَنِ الطَّرِيقِ؛ تَجَنَّبَ شَيْئًا أَوِ الْاِلْتِزَامَ بِمَسَارٍ مَعَيَّنٍ) / بِقُوَّة\nمثال: كانت صدمة قوية.",
 "有力者": "شخصية مؤثرة, شخصية هامة (شخص تؤثر أفعاله وآراؤه بقوة على مسار الأحداث)",
 "有功": "جَدَارَة",
 "有効": "شَرَعِيّ",
 "有効けた": "رَقَم مَعْنَوِيّ (أي رقم في عدد معروف بدقة؛ أي رقم في عدد يبدأ من أقصى اليسار غير الصفري وينتهي بأقصى اليمين غير الصفري)\nمثال: حسب الجواب لأربعة أرقام معنوية",
 "有効けた演算": "رَقَم مَعْنَوِيّ (أي رقم في عدد معروف بدقة؛ أي رقم في عدد يبدأ من أقصى اليسار غير الصفري وينتهي بأقصى اليمين غير الصفري)\nمثال: حسب الجواب لأربعة أرقام معنوية",
 "有効化": "تمكيني, مخوِّل (توفير السلطة القانونية أو العقوبة)\nمثال: قرار تمكيني",
 "有効性": "صَلَاحِيَّة / قَانُونِيَّة, مَشْرُوعِيَّة",
 "有効成分": "مَادَّة فَعَّالَة (مؤنث مَادّ، اسم فاعل من مَدَّ. الجمع مَادَّات؛ ما كان مَدَدًا لغيره)\nمثال: لا أحب مادة العلوم.",
 "有効数字": "رَقَم مَعْنَوِيّ (أي رقم في عدد معروف بدقة؛ أي رقم في عدد يبدأ من أقصى اليسار غير الصفري وينتهي بأقصى اليمين غير الصفري)\nمثال: حسب الجواب لأربعة أرقام معنوية",
 "有効桁": "رَقَم مَعْنَوِيّ (أي رقم في عدد معروف بدقة؛ أي رقم في عدد يبدأ من أقصى اليسار غير الصفري وينتهي بأقصى اليمين غير الصفري)\nمثال: حسب الجواب لأربعة أرقام معنوية",
 "有効範囲": "حَيِّز",
 "有印": "إِشَارِيّ, بِلُغَةِ الإِشَارَة (متعلّق بلغة إشارة الصُّمّ) / ممهور بتوقيع, موقع (يحمل توقيعًا مكتوبًا بخط اليد)\nمثال: رسالة موقعة",
 "有史": "تَارِيخِي",
 "有史以前": "عَصْر مَا قَبْلَ التَّارِيخ (مصدر للفعل \"عَصَرَ\"؛ أي مدة زمنية، دهر من الوقت)\nمثال: صلى زيري العصر.",
 "有司": "خادم عام, موظف حكومي (شخص يشغل منصباً حكومياً (سواء بالانتخاب أو التعيين))",
 "有吉": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "有名": "مَشْهُور, شَهِير (معروف على نطاق واسع؛ اسم مفعول للفعل \"شَهَرَ\") / مَشْهُور (معروف على نطاق واسع؛ اسم مفعول للفعل \"شَهَرَ\")\nمثال: إنه رسام مشهور.",
 "有名どころ": "ذَائِع الصِّيت, مَعْرُوف جَيِّدًا (معروف على نطاق واسع أو بشكل تامّ)",
