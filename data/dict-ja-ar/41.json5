 "栗鼠擬": "زبابيات الشجر (ثديي شجري آكل للحشرات من جنوب شرق آسيا يشبه السنجاب وله عيون كبيرة وخطم حاد طويل)",
 "栗鼠猿": "سعدان السنجاب (قرد صغير طويل الذيل يعيش في أمريكا الوسطى والجنوبية، ذو فراء مخضر وخطم أسود)",
 "栞": "علامة قراءة, فاصل كتب (علامة (قطعة من الورق أو شريط) توضع بين صفحات الكتاب لتحديد مكان القراءة) / دليل سياحي, مرشد (شيء يقدم معلومات أو تعليمات أساسية)",
 "校": "مَدْرَسَة, مَكْتَب (الموضع الذي تُدَرَّس فيه العلوم؛ البناء فيه عدة غرف تُدَرَّسُ فيها العلوم وتمنح شهادة رسمية بعد إكمال الدروس) / كُلِّيَّة, جَامِعَة (مصدر صناعيّ من كُلّ؛ شمول، مجموع من الأوّل إلى الآخر) / قِسِم (فَرَّقَ أو قَسَّمَ الشَّيءَ إلى أجزاء أو أجزاء مختلفة؛ أَحْلَفَ، أَي جَعَلَ يَحْلِفُ على أمرٍ ما) / مَدْرَسَة (الموضع الذي تُدَرَّس فيه العلوم؛ البناء فيه عدة غرف تُدَرَّسُ فيها العلوم وتمنح شهادة رسمية بعد إكمال الدروس)\nمثال: لا أحب المدرسة. / نَقَّحَ",
 "校下": "منطقة تعليمية (منطقة تدار مدارسها العامة معاً)",
 "校勘": "مضاهاة, مطابقة (فحص ومقارنة دقيقة لملاحظة نقاط الاختلاف) / ترتيب, توضيب (التجميع بتسلسل رقمي أو منطقي سليم) / تصغيرة, وجبة خفيفة (وجبة خفيفة غير رسمية)",
 "校務員": "بَوَّاب",
 "校区": "منطقة تعليمية (منطقة تدار مدارسها العامة معاً)",
 "校友": "زميل دراسة, زميل صف (معرفة تذهب معه إلى المدرسة)",
 "校合": "مضاهاة, مطابقة (فحص ومقارنة دقيقة لملاحظة نقاط الاختلاف) / ترتيب, توضيب (التجميع بتسلسل رقمي أو منطقي سليم) / تصغيرة, وجبة خفيفة (وجبة خفيفة غير رسمية)",
 "校外": "خَارِج المَدْرَسَة (غَيْر مُلْتَحِق بِالمَدْرَسَة وَبِالتَّالِي مُتَاح لِلْعَمَل)",
 "校外学習": "رحلة ميدانية (رحلة جماعية (إلى متحف أو غابة أو مكان تاريخي) للفحص المباشر)",
 "校定": "تَنْقِيح",
 "校庭": "ساحة المدرسة, فناء المدرسة (الساحة المرتبطة بالمدرسة)",
 "校書": "مضاهاة, مطابقة (فحص ومقارنة دقيقة لملاحظة نقاط الاختلاف) / ترتيب, توضيب (التجميع بتسلسل رقمي أو منطقي سليم) / تصغيرة, وجبة خفيفة (وجبة خفيفة غير رسمية) / غَيْشَا",
 "校服": "زِي مَدْرَسِيّ",
 "校正": "نَقَّحَ / معايرة (المُعايرَةُ :  تقدير الشيء بالوزن أو الحجم حسب معايير قياسية معروفة؛ المُعايرَةُ : ( و) التقدير بالحجم بمحاليلَ قياسيةٍ معروفةٍ قُوَّتُها)",
 "校正係": "مدقق لغوي, مصحح تجارب (شخص يقرأ النسخ التجريبية للعثور على الأخطاء وتصحيحها)",
 "校正刷": "بُرْهَان, دَلِيل",
 "校正刷り": "بُرْهَان, دَلِيل",
 "校正員": "مدقق لغوي, مصحح تجارب (شخص يقرأ النسخ التجريبية للعثور على الأخطاء وتصحيحها)",
 "校正室": "قَاعَة ٱلْمُطَالَعَة",
 "校正者": "مدقق لغوي, مصحح تجارب (شخص يقرأ النسخ التجريبية للعثور على الأخطاء وتصحيحها)",
 "校舎": "مبنى المدرسة, مدرسة (مبنى يتلقى فيه الشباب التعليم)\nمثال: بُنيت المدرسة عام 1932",
 "校訂": "تصحيف, تنقيح (تصحيح عن طريق التنقيح؛ تصحيح ناتج عن التحرير النقدي)",
 "校長": "رَئِيسِيّ / مُدِير, مُدِيرَة (الشخص الذي أدار، جمعه مُدِيرُون ومُدِيرِين؛ مهنة يتولى صاحبها إدَارَة شؤون جهة ما. جمعه مُدَرَاء) / مُوَكِّل\nمثال: زيري هو المدير.",
 "校長先生": "مدير مدرسة (المربي الذي لديه سلطة تنفيذية لمدرسة)\nمثال: أرسلت التلاميذ المشاغبين لرؤية المدير",
 "校閲": "تَنْقِيح",
 "校閲係": "مدقق لغوي, مصحح تجارب (شخص يقرأ النسخ التجريبية للعثور على الأخطاء وتصحيحها)",
 "校閲者": "محلل, معلق (كاتب يكتب تقارير ويحلل أحداث اليوم) / قارئ مخطوطات, مُراجِع (شخص يقرأ المخطوطات ويحكم على مدى ملاءمتها للنشر)",
 "栩栩": "بهيج, مفرح (مليء بـأو يتميز بالفرح)\nمثال: شعر بانطلاق بهيج",
 "株": "جَرْد, خَزِين (جَرَدَ الشيءَ: أحصى ما فيه، ضبط قيمته؛ جَرَدَ البطاطسَ: قشّرها وأزال ما عليها) / مَخْزُون / مَرَقَة, حَسَاء (الطَعَام السائل الخفيف فيه ماء اللحم وقد يكون فيه خضار أو غير ذلك. يؤكل عادة مع الرز أو الخبز. يجوز قول مَرَق، والمَرَقَة أخص من المرَق) / مَنْثُور / قَنْدَاق\nمثال: كان سامي جرد طفل. / جُذْمُور, كُنَّاشَة / أصول, جذور (حالة الانتماء إلى مكان أو مجموعة معينة بحكم النسب الاجتماعي أو العرقي أو الثقافي)\nمثال: جذوره في تكساس تعود إلى زمن طويل / سُلَالَة / وَتِد, خَازُوق (العصا تثبت في الأرض لتثبيت شيء ما بربطه إليها) / مِحْرَقَة / حِصَّة / رِهَان / جُذْمُور, كُنَّاشَة",
 "株主": "مُسَاهِم, مُسَاهِمَة",
 "株主資本": "رأس مال الأسهم (القيمة الدفترية للأسهم القائمة لشركة ما) / أسهم مصرح بها, رأس المال المصرح به (الحد الأقصى لعدد الأسهم المصرح بها بموجب شروط عقد تأسيس الشركة)",
 "株主資本利益率": "بطارخ, بيض السمك (البيض أو المبيض الممتلئ بالبيض للسمك) / بطارخ القشريات (كتلة البيض أو السرء لبعض القشريات مثل الكركند) / بطارخ (بيض إناث الأسماك) / بطارخ (بيض السمك أو المبيض الممتلئ بالبيض؛ له قوام حبيبي)",
 "株価の反発": "استحواذ على المرتدة, ريباوند (فعل تأمين حيازة كرة السلة المرتدة بعد تسديدة ضائعة) / ارتداد, رد فعل عكسي (رد فعل لأزمة أو نكسة أو إحباط) / ارتداد, انعكاس (حركة العودة من الارتطام)\nمثال: لا يزال في حالة ارتداد من وفاة زوجته",
 "株価収益率": "مُضَاعِف الرِّبْحِيَّة, نِسْبَة السِّعْر إِلَى الأَرْبَاح ((سوق الأسهم) سعر السهم مقسوماً على أرباحه)",
 "株価指数": "مؤشر سوق الأسهم (مؤشر يعتمد على تجميع إحصائي لأسعار أسهم عدد من الأسهم التمثيلية)",
 "株価指数先物": "مؤشر سوق الأسهم (مؤشر يعتمد على تجميع إحصائي لأسعار أسهم عدد من الأسهم التمثيلية)",
 "株価指数先物取引": "مؤشر سوق الأسهم (مؤشر يعتمد على تجميع إحصائي لأسعار أسهم عدد من الأسهم التمثيلية)",
 "株価指数連動型上場投資信託": "صندوق متداول في البورصة (صندوق استثمار مشترك يتم تداوله في سوق الأوراق المالية)",
 "株価指数連動型投資信託": "صندوق متداول في البورصة (صندوق استثمار مشترك يتم تداوله في سوق الأوراق المالية)",
 "株元": "قَاعِدَة / قَاعِدَة, مَرْكَز / يُبْنَى عَلَى, يَسْتَنِدُ إِلَى / شائع / منخفض, فاسق / دنيء",
 "株券": "سهم, شهادة سهم (شهادة توثق ملكية المساهم في الشركة)\nمثال: تضاعفت قيمة أسهمه خلال العام الماضي",
 "株屋": "سمسار بورصة, وسيط أوراق مالية (وكيل في بيع وشراء الأسهم والسندات)",
 "株式": "نَصِيب, حِصَّة / سَهْم (سَهَمَ؛ سَهَّمَ) / شَارَكَ\nمثال: لم يصب السهم توم.",
 "株式オプション": "خيار الأسهم, خيار شراء الأسهم (ميزة تمنحها الشركة للموظف في شكل خيار لشراء أسهم في الشركة بخصم أو بسعر ثابت) / خيار الأسهم (الحق في شراء أو بيع سهم بسعر محدد خلال فترة محددة)",
 "株式交換率": "بُورْصَة, سُوقُ الْأَوْرَاقِ الْمَالِيَّةِ",
 "株式仲買人": "سمسار بورصة, وسيط أوراق مالية (وكيل في بيع وشراء الأسهم والسندات)",
 "株式会社": "فرقة ريبيرتوار, فرقة مسرحية دائمة (فرقة مسرحية تؤدي مسرحيات من مخزون جاهز) / شركة مساهمة (شركة يتم تمثيل رأس مالها بأسهم)",
 "株式併合": "تجزئة عكسية للأسهم (انخفاض في عدد الأسهم القائمة للشركة دون تغيير حقوق المساهمين)",
 "株式公開買い付け": "عَرْض شِرَاء عَام (عرض لشراء أسهم في شركة (عادة فوق سعر السوق) نقداً أو بأوراق مالية أو كليهما)",
 "株式公開買付制度": "عَرْض شِرَاء عَام (عرض لشراء أسهم في شركة (عادة فوق سعر السوق) نقداً أو بأوراق مالية أو كليهما)",
 "株式分割": "تجزئة الأسهم (زيادة في عدد الأسهم القائمة للشركة دون تغيير حقوق المساهمين)\nمثال: أعلنوا عن تجزئة اثنين مقابل واحد للأسهم العادية",
 "株式取引所": "بُورْصَة, سُوقُ الْأَوْرَاقِ الْمَالِيَّةِ",
 "株式市場": "سُوقُ الْأَوْرَاقِ الْمَالِيَّةِ, بُورْصَة (مكان للبيع والشراء؛ جمع ساق، قال الله تعالى: 《رُدُّوهَا عَلَيَّ فَطَفِقَ مَسْحًا بِالسُّوقِ وَالْأَعْنَاقِ》)\nمثال: ذهبت إلى السوق.",
 "株式相場": "سُوقُ الْأَوْرَاقِ الْمَالِيَّةِ, بُورْصَة (مكان للبيع والشراء؛ جمع ساق، قال الله تعالى: 《رُدُّوهَا عَلَيَّ فَطَفِقَ مَسْحًا بِالسُّوقِ وَالْأَعْنَاقِ》)\nمثال: ذهبت إلى السوق.",
 "株式譲渡益": "أرباح رأسمالية, مكاسب رأسمالية (المبلغ الذي يتجاوز به سعر بيع الأصل سعر الشراء؛ يتحقق الربح عند بيع الأصل)",
 "株式配当": "أرباح الأسهم, توزيعات أسهم (أرباح مدفوعة في شكل أسهم بدلاً من النقد)",
 "株式配当金": "أرباح الأسهم, توزيعات أسهم (أرباح مدفوعة في شكل أسهم بدلاً من النقد)",
 "株買い占め": "زَاوِيَة, رُكْن",
 "栫": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "栲": "توت الورق (شجرة شجيرية آسيوية لها لحاء (تابا) يشبه القماش؛ تزرع كشجرة ظل في أوروبا وأمريكا؛ الزهور الذكرية هي نورات هرية متدلية والأنثوية جرة الشكل تليها ثمار…) / قُمَاش, أقمشة (النسيج الذي لم يُقَصّ أو يُخَاط) / مِمْسَحَة\nمثال: الورق و القماش يمتصان الماء.",
 "栴檀": "أزدرخت, زنزلخت (شجرة من شمال الهند والصين لها أزهار أرجوانية وثمار صفراء صغيرة غير صالحة للأكل؛ تم توطينها في جنوب الولايات المتحدة كشجرة ظل) / أزدرخت, زنزلخت (شجرة دائمة الخضرة في أمريكا الاستوائية ذات ثمار لبية تحتوي على الصابونين الذي كان يستخدم كصابون من قبل السكان الأصليين)",
 "核": "حَجَر, حجر (حَجَرَ عليه الأمرَ:مَنَعَه منه ، حجر الشّيء على نفسه:خَصَّها به وقصره عليها؛ الحجْرُ: المَنْعُ مِن التَّصَرُّفِ ، وحَجَرَ عَلَيْهِ القاضِي يَحْجُرُ حَجْراً، إِذا مَنَعَه مِن التَّصَرُّفِ فِي مالِه) / حجر, حصى (حَجَرَ عليه الأمرَ:مَنَعَه منه ، حجر الشّيء على نفسه:خَصَّها به وقصره عليها؛ الحجْرُ: المَنْعُ مِن التَّصَرُّفِ ، وحَجَرَ عَلَيْهِ القاضِي يَحْجُرُ حَجْراً، إِذا مَنَعَه مِن التَّصَرُّفِ فِي مالِه) / نواة, عضم / رَجَمَ (رَجَمَ:تكلّم بالظنّ ويُقال:رجم بـ الغيب تكلّم بما لا يعلم ،والقبر :وضع عليه الرّجام،رجمه رَجْماً:رماه بالحجارة وقتله بها…؛ رجم الشخص:رماه بالحجارة ، أو قتله بها (رجم الشّعبُ القتلةَ)،رجمه بالقول:قذفه وشتمه،رجم بالغيب:تكلّم بما لا يعلم)\nمثال: عوقب زيري بالحجر. / نِوَاة / سِلَاح نَوَوِيّ / نَوَاة / بِذْرَة, زَرِّيعَة / مَنْي / لِسَان (فِي : جسم لحميّ مستطيل متحرك، يكون في الفم، ويصلح للتّذوُّق والبلع، وللنطق؛ جَارِحَة الْكَلَام؛ كَلِمَة) / لسان (فِي : جسم لحميّ مستطيل متحرك، يكون في الفم، ويصلح للتّذوُّق والبلع، وللنطق؛ جَارِحَة الْكَلَام؛ كَلِمَة)\nمثال: ماري لها فم ليس لها لسان. / بَظْر / نِوَاة",
 "核のごみ": "نفايات مشعة (مواد مشعة عديمة الفائدة تتبقى بعد اكتمال عملية مخبرية أو تجارية)",
 "核のゴミ": "نفايات مشعة (مواد مشعة عديمة الفائدة تتبقى بعد اكتمال عملية مخبرية أو تجارية)",
 "核の冬": "شتاء نووي (فترة طويلة من الظلام والبرد القارس يتوقع العلماء أنها ستعقب حرباً نووية شاملة؛ حيث ستغطي طبقة من الغبار والدخان في الغلاف الجوي الأرض وتحجب أشعة…)",
 "核の塵": "نفايات مشعة (مواد مشعة عديمة الفائدة تتبقى بعد اكتمال عملية مخبرية أو تجارية)",
 "核エネルギー": "طَاقَة ذَرِّيَّة (القُدْرَة والشِدَّة؛ هي مقدار ما يمكن للإنسان أن يفعله بمشقة، كأن قدرته محددة بطَوْق)\nمثال: طلب بطاقة اعتماد.",
 "核クラブ": "النادي النووي (الدول التي تمتلك أسلحة نووية)",
 "核シェルター": "قُنْبُلَة نَوَوِيَّة",
 "核テロ": "إرهاب نووي (استخدام جهاز نووي من قبل منظمة إرهابية لإحداث دمار هائل أو استخدام (أو التهديد باستخدام) مواد مشعة انشطارية)",
 "核仁": "نوية",
 "核保有国": "طاقة نووية, قدرة نووية (الطاقة النووية باعتبارها مصدراً للكهرباء لشبكة الطاقة (للاستخدام المدني))",
 "核兵器": "سِلَاح نَوَوِيّ",
 "核分裂": "انشطار / انقسام النواة (عملية عضوية تتكون من انقسام نواة الخلية أثناء الانقسام المتساوي أو المنصف)",
 "核分裂反応": "انشطار",
 "核分裂性": "قابل للانشطار, قابل للفلق (قابل للفلق أو الشق أو التقسيم في اتجاه الألياف) / انشطاري, قابل للانشطار (قابل للخضوع للانشطار النووي)\nمثال: بلورات قابلة للانفلاق",
 "核分裂性物質": "انشطاري, قابل للانشطار (قابل للخضوع للانشطار النووي)\nمثال: نواة انشطارية",
 "核化学": "كيمياء إشعاعية, كيمياء نووية (كيمياء المواد المشعة)",
 "核医学": "طب نووي (فرع الطب الذي يستخدم المواد المشعة إما لتصوير جسم المريض أو لتدمير الخلايا المريضة)",
 "核反応": "تفاعل نووي (فلان وفلان: أثّر كلّ منهما في الآخر؛ مع الشيء: تأثّر به)",
 "核反応炉": "مُفَاعِل نَوَوِيّ",
 "核型": "نمط نووي (مظهر التركيب الصبغي لخلية جسدية في فرد أو نوع (بما في ذلك عدد وترتيب وحجم وهيكل الكروموسومات))",
 "核大国": "طاقة نووية, قدرة نووية (الطاقة النووية باعتبارها مصدراً للكهرباء لشبكة الطاقة (للاستخدام المدني))",
 "核子": "نُوَيَّة, نِيُوكْلِيُون (مكون (بروتون أو نيوترون) للنواة الذرية) / دَقِيق الْأَرُزّ, أَرُزّ مَسْحُوق (ضد الغَلِيْظ، الرَفِيْع الرَقِيْق؛ صغير الحجم جدا)\nمثال: ساعتي غير دقيقة.",
 "核家族": "أسرة نووية (أسرة تتكون من الوالدين وأطفالهم وجدي أحد الزوجين)",
 "核小体": "نوية",
 "核弾頭": "رأس حربي ذري, رأس نووي (الرأس الحربي لصاروخ مصمم لإيصال قنبلة ذرية)",
 "核心": "نِوَاة",
 "核心的": "حَاسِم",
 "核戦争": "حَرْب نَوَوِيَّة, حَرْب ذَرِّيَّة (حَرَبَ (حربه) بالحربة حربا: طعنه بها؛ حَرَبَ (ه) حربا: سلبه جميع ما يملك)",
 "核抑止": "ردع نووي (العقيدة العسكرية القائلة بأن العدو سيرتدع عن استخدام الأسلحة النووية طالما أمكن تدميره كنتيجة لذلك)\nمثال: عندما تلجأ دولتان إلى الردع النووي، قد تكون النتيجة دماراً متبادلاً",
 "核果": "ثمرة نووية, حسلة (فاكهة لحمية غير متفتحة ذات بذرة واحدة: مثل اللوز والخوخ والبرقوق والكرز والخمان والزيتون والعناب)",
 "核燃料": "وقود نووي (وقود (مثل اليورانيوم) يمكن استخدامه في المفاعلات النووية كمصدر للكهرباء)",
 "核燃料サイクル": "وقود نووي (وقود (مثل اليورانيوم) يمكن استخدامه في المفاعلات النووية كمصدر للكهرباء)",
 "核燃料デブリ": "وقود نووي (وقود (مثل اليورانيوم) يمكن استخدامه في المفاعلات النووية كمصدر للكهرباء)",
 "核燃料プール": "وقود نووي (وقود (مثل اليورانيوم) يمكن استخدامه في المفاعلات النووية كمصدر للكهرباء)",
 "核燃料再処理": "وقود نووي (وقود (مثل اليورانيوم) يمكن استخدامه في المفاعلات النووية كمصدر للكهرباء)",
 "核燃料化": "إِثْرَاء",
 "核燃料棒": "وقود نووي (وقود (مثل اليورانيوم) يمكن استخدامه في المفاعلات النووية كمصدر للكهرباء)",
 "核爆弾": "قُنْبُلَة نَوَوِيَّة",
 "核爆発": "انفجار ذري, انفجار نووي (انفجار قنبلة ذرية)",
 "核物理学": "فيزياء ذرية, فيزياء نووية (فرع الفيزياء الذي يدرس البنية الداخلية للنواة الذرية)",
 "核磁気共鳴": "رنين مغناطيسي نووي (رنين البروتونات للإشعاع في مجال مغناطيسي)",
 "核磁気共鳴映像法": "رنين مغناطيسي نووي (رنين البروتونات للإشعاع في مجال مغناطيسي)",
 "核移植": "نقل نواة الخلية الجسدية (نقل نواة الخلية ومادتها الوراثية من خلية إلى أخرى)",
 "核蛋白質": "بروتين نووي (أي من عدة مواد موجودة في نوى جميع الخلايا الحية؛ تتكون من بروتين مرتبط بحمض نووي)",
 "核融合": "اِنْدِمَاج نَوَوِيّ",
 "核融合反応": "اندماج, اندماج نووي (تفاعل نووي تتحد فيه النوى لتكوين نوى أكثر ضخامة مع إطلاق متزامن للطاقة)",
 "核融合炉": "اِنْدِمَاج نَوَوِيّ",
 "核融合発電": "اِنْدِمَاج نَوَوِيّ",
 "核質": "بلازما نووية, جبلة نووية (البروتوبلازم الذي يشكل نواة الخلية)",
 "核酸": "حمض نووي ((كيمياء حيوية) أي من الجزيئات الكبيرة المختلفة المكونة من سلاسل النيوكليوتيدات التي تعد مكونات حيوية لجميع الخلايا الحية)",
 "核酸増幅検査": "حمض نووي ((كيمياء حيوية) أي من الجزيئات الكبيرة المختلفة المكونة من سلاسل النيوكليوتيدات التي تعد مكونات حيوية لجميع الخلايا الحية)",
 "根": "جَذْر, جدر (جِذْرُ ٱلشَّيْءِ هُوَ: أَصْلُهُ؛ في : جذر العدد النوني هو عدد ما إذا رفعناه لقوة ما أعطانا العدد الأصلي) / جَذْر (جِذْرُ ٱلشَّيْءِ هُوَ: أَصْلُهُ؛ في : جذر العدد النوني هو عدد ما إذا رفعناه لقوة ما أعطانا العدد الأصلي) / أَصْل (جعله أصيلًا أو ثابت الجذور؛ أي عَمَّق وأحكم أصوله؛ نسب شيئًا إلى أصله أو وضّح جذوره)\nمثال: أحسب جذر خمسة بالآلة الحاسبة. / شَعَاب / مُثَابَرَة / جَذْريّ / رَادِيكَالِيّ / جَذْر, جدر (جِذْرُ ٱلشَّيْءِ هُوَ: أَصْلُهُ؛ في : جذر العدد النوني هو عدد ما إذا رفعناه لقوة ما أعطانا العدد الأصلي) / جَذْر (جِذْرُ ٱلشَّيْءِ هُوَ: أَصْلُهُ؛ في : جذر العدد النوني هو عدد ما إذا رفعناه لقوة ما أعطانا العدد الأصلي) / أَصْل (جعله أصيلًا أو ثابت الجذور؛ أي عَمَّق وأحكم أصوله؛ نسب شيئًا إلى أصله أو وضّح جذوره)\nمثال: أحسب جذر خمسة بالآلة الحاسبة.",
 "根から": "مطلقا, على الإطلاق",
 "根から葉から": "مطلقا, على الإطلاق",
 "根が深い": "رَاسِخ, عَمِيق الجُذُور ((يستخدم خاصة للأفكار أو المبادئ) عميق الجذور؛ ثابت ومتمكّن بقوّة)",
 "根こそぎ": "كُلّ, جَمِيع",
 "根っから": "بالفطرة, بطبعه (من خلال الطبيعة المتأصلة)\nمثال: كان كسولاً بطبعه / مطلقا, على الإطلاق",
 "根っから葉っから": "مطلقا, على الإطلاق",
 "根っこ": "جَذْر, جدر (جِذْرُ ٱلشَّيْءِ هُوَ: أَصْلُهُ؛ في : جذر العدد النوني هو عدد ما إذا رفعناه لقوة ما أعطانا العدد الأصلي) / جَذْر (جِذْرُ ٱلشَّيْءِ هُوَ: أَصْلُهُ؛ في : جذر العدد النوني هو عدد ما إذا رفعناه لقوة ما أعطانا العدد الأصلي) / أَصْل (جعله أصيلًا أو ثابت الجذور؛ أي عَمَّق وأحكم أصوله؛ نسب شيئًا إلى أصله أو وضّح جذوره)\nمثال: أحسب جذر خمسة بالآلة الحاسبة. / جُذْمُور, كُنَّاشَة",
 "根っ子": "جَذْر, جدر (جِذْرُ ٱلشَّيْءِ هُوَ: أَصْلُهُ؛ في : جذر العدد النوني هو عدد ما إذا رفعناه لقوة ما أعطانا العدد الأصلي) / جَذْر (جِذْرُ ٱلشَّيْءِ هُوَ: أَصْلُهُ؛ في : جذر العدد النوني هو عدد ما إذا رفعناه لقوة ما أعطانا العدد الأصلي) / أَصْل (جعله أصيلًا أو ثابت الجذور؛ أي عَمَّق وأحكم أصوله؛ نسب شيئًا إلى أصله أو وضّح جذوره)\nمثال: أحسب جذر خمسة بالآلة الحاسبة. / جُذْمُور, كُنَّاشَة",
 "根なし": "صُعْلُوك, مُقْتَلَع الجُذُور (يتشرّد بلا هدف ودون روابط بمكان أو مجتمع)",
 "根のいい": "صَبُور, طَوِيلُ البَال (يَتَحَمَّلُ بِصَبْرٍ الظُّلْمَ أَوِ المَتَاعِبَ المُسْتَمِرَّة) / خَالِد, رَاسِخ (يبقى مدّة طويلة؛ لا يزول بسهولة)",
 "根の国": "سِجِّين, عَالَم سُفْلِيّ",
 "根の堅州国": "سِجِّين, عَالَم سُفْلِيّ",
 "根の堅洲国": "سِجِّين, عَالَم سُفْلِيّ",
 "根の良い": "صَبُور, طَوِيلُ البَال (يَتَحَمَّلُ بِصَبْرٍ الظُّلْمَ أَوِ المَتَاعِبَ المُسْتَمِرَّة) / خَالِد, رَاسِخ (يبقى مدّة طويلة؛ لا يزول بسهولة)",
 "根ほり葉ほり": "بتساؤل, بفضول\nمثال: نظر الطفل حوله بفضول",
 "根も葉もない": "لَا أَسَاس لَه, وَاهٍ (بدون أساس في العقل أو الواقع)",
 "根をはる": "هَدَأَ / اِسْتَقَرَّ (فعل مطاوعة لأَقَرَّ بمعنى جعله يثبت ويسكن، أَقْرَرْتُهُ فاسْتَقَرَّ؛ ثبت وقرّ)\nمثال: استقر زيري في خيمته.",
 "根を張る": "هَدَأَ / اِسْتَقَرَّ (فعل مطاوعة لأَقَرَّ بمعنى جعله يثبت ويسكن، أَقْرَرْتُهُ فاسْتَقَرَّ؛ ثبت وقرّ)\nمثال: استقر زيري في خيمته.",
 "根セロリ": "جذر الكرفس (جذر عطري صالح للأكل وسميك لنوع من نبات الكرفس) / كرفس جذري, كرفس لفتي (يزرع لجذره العطري السميك الصالح للأكل)",
 "根井": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "根付": "تجذير (عملية إخراج الجذور والبدء في النمو)",
 "根付く": "جَذْر, جدر (جِذْرُ ٱلشَّيْءِ هُوَ: أَصْلُهُ؛ في : جذر العدد النوني هو عدد ما إذا رفعناه لقوة ما أعطانا العدد الأصلي) / جَذْر (جِذْرُ ٱلشَّيْءِ هُوَ: أَصْلُهُ؛ في : جذر العدد النوني هو عدد ما إذا رفعناه لقوة ما أعطانا العدد الأصلي) / أَصْل (جعله أصيلًا أو ثابت الجذور؛ أي عَمَّق وأحكم أصوله؛ نسب شيئًا إلى أصله أو وضّح جذوره)\nمثال: أحسب جذر خمسة بالآلة الحاسبة.",
 "根保証": "ائتمان متجدد, ائتمان مفتوح (خط ائتمان استهلاكي يمكن استخدامه حتى حد معين أو سداده في أي وقت)",
 "根元": "جَذْر, جدر (جِذْرُ ٱلشَّيْءِ هُوَ: أَصْلُهُ؛ في : جذر العدد النوني هو عدد ما إذا رفعناه لقوة ما أعطانا العدد الأصلي) / جَذْر (جِذْرُ ٱلشَّيْءِ هُوَ: أَصْلُهُ؛ في : جذر العدد النوني هو عدد ما إذا رفعناه لقوة ما أعطانا العدد الأصلي) / أَصْل (جعله أصيلًا أو ثابت الجذور؛ أي عَمَّق وأحكم أصوله؛ نسب شيئًا إلى أصله أو وضّح جذوره)\nمثال: أحسب جذر خمسة بالآلة الحاسبة. / قَاعِدَة / قَاعِدَة, مَرْكَز / يُبْنَى عَلَى, يَسْتَنِدُ إِلَى / شائع / منخفض, فاسق / دنيء / جَذْر, جدر (جِذْرُ ٱلشَّيْءِ هُوَ: أَصْلُهُ؛ في : جذر العدد النوني هو عدد ما إذا رفعناه لقوة ما أعطانا العدد الأصلي) / جَذْر (جِذْرُ ٱلشَّيْءِ هُوَ: أَصْلُهُ؛ في : جذر العدد النوني هو عدد ما إذا رفعناه لقوة ما أعطانا العدد الأصلي) / أَصْل (جعله أصيلًا أو ثابت الجذور؛ أي عَمَّق وأحكم أصوله؛ نسب شيئًا إلى أصله أو وضّح جذوره)\nمثال: أحسب جذر خمسة بالآلة الحاسبة.",
 "根元的": "أَزَلِيّ, بِدْئِيّ (موجود منذ البداية؛ في أبكر مرحلة أو حالة أصلية)",
 "根冠": "قلنسوة الجذر (كتلة من الخلايا على شكل قمع تغطي وتحمي الطرف النامي للجذر)",
 "根出葉": "شارة وردية, وردة شريطية (حلية أو نمط يشبه الوردة يُلبس كشارة منصب أو اعترافاً بالفوز بشرف ما) / نافذة وردية (نافذة دائرية مليئة بالزخارف) / وريدة (مجموعة من الأوراق تنمو في دوائر مزدحمة من مركز مشترك أو تاج (عادة عند الأرض أو بالقرب منها)) / البطاطس الصغيرة, تقرح الساق (مرض الريزوكتونيا الذي يصيب البطاطس)",
 "根切り": "استخراج المعادن, تعدين (فعل استخراج الخامات أو الفحم وما إلى ذلك من الأرض) / تنيقب, حفر (فعل الحفر) / حفر, حفرية (حفرة في الأرض ناتجة عن الحفر) / حفرية, موقع أثري (موقع الاستكشاف الأثري)\nمثال: هناك حفر مثير للاهتمام يجري بالقرب من برينستون / إبادة",
 "根切り虫": "دودة قارضة (عثة أمريكية شمالية تتغذى يرقاتها على سيقان النباتات الصغيرة وتقطعها عند مستوى الأرض)",
 "根切虫": "دودة قارضة (عثة أمريكية شمالية تتغذى يرقاتها على سيقان النباتات الصغيرة وتقطعها عند مستوى الأرض)",
 "根刮ぎ": "استئصال, طمس (التدمير الكامل لكل أثر لشيء ما)",
 "根原": "جَذْر, جدر (جِذْرُ ٱلشَّيْءِ هُوَ: أَصْلُهُ؛ في : جذر العدد النوني هو عدد ما إذا رفعناه لقوة ما أعطانا العدد الأصلي) / جَذْر (جِذْرُ ٱلشَّيْءِ هُوَ: أَصْلُهُ؛ في : جذر العدد النوني هو عدد ما إذا رفعناه لقوة ما أعطانا العدد الأصلي) / أَصْل (جعله أصيلًا أو ثابت الجذور؛ أي عَمَّق وأحكم أصوله؛ نسب شيئًا إلى أصله أو وضّح جذوره)\nمثال: أحسب جذر خمسة بالآلة الحاسبة.",
 "根号": "علامة الجذر (علامة تشير إلى استخراج الجذر)",
 "根問い": "تطفل, فضول (حالة من الفضول النشط) / حب الاستطلاع, فضول (صفة الفضول والاهتمام)\nمثال: أزعجتني نظرة الاختراق وحب الاستطلاع لديه: شعرت بالحرج والذنب في وجوده",
 "根喰葉虫": "خنفساء الأوراق (خنفساء زاهية الألوان تتغذى على أوراق النباتات؛ وتغزو يرقاتها الجذور والسيقان)",
 "根回し": "خَلْفَ الكَوَالِيس, سِرِّيّ (مُصَمَّمٌ وَمُنَفَّذٌ بِسِرِّيَّةٍ أَوْ بِشَكْلٍ سِرِّيّ)",
 "根城": "حِصْن (ما يُتَحَصَّنُ به ويُمْنَع؛ كل مكان محميّ مُحرَز لا يُوصَل إليه؛ عن ما يُتَحصَّن به وإن لم يكن موضعا أو مكانا كالسلاح مثلا)\nمثال: كان هناك حصن على تلك الهضبة في يوم من الأيام. / قَاعِدَة / قَاعِدَة, مَرْكَز / يُبْنَى عَلَى, يَسْتَنِدُ إِلَى / شائع / منخفض, فاسق / دنيء",
 "根基": "جَذْريّ / رَادِيكَالِيّ",
 "根太": "دُمَّل, خُرَاج / غَلَيَان, غَلْي / غَلَّى / رافدة (عارضة تستخدم لدعم الأرضيات أو الأسقف)",
 "根太板": "لوح أرضية (لوح في الأرضية) / أرضية السيارة (أرضية السيارة)",
 "根岸": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "根幹": "إِنْشاء, إِشَادَة (مصدر للفعل \"أَنْشَأَ\") / أَسَاس, قَاعِدَة (مبدأ عام تعتمد عليه طائفة من الظواهر أو القضايا؛ مُرتكز البناء وقاعدته) / مُؤَسَّسَة / أَسَاس (مبدأ عام تعتمد عليه طائفة من الظواهر أو القضايا؛ مُرتكز البناء وقاعدته)\nمثال: إنشاء موقع إلكتروني بدون أي تكلفة؟",
 "根底": "جَذْر, جدر (جِذْرُ ٱلشَّيْءِ هُوَ: أَصْلُهُ؛ في : جذر العدد النوني هو عدد ما إذا رفعناه لقوة ما أعطانا العدد الأصلي) / جَذْر (جِذْرُ ٱلشَّيْءِ هُوَ: أَصْلُهُ؛ في : جذر العدد النوني هو عدد ما إذا رفعناه لقوة ما أعطانا العدد الأصلي) / أَصْل (جعله أصيلًا أو ثابت الجذور؛ أي عَمَّق وأحكم أصوله؛ نسب شيئًا إلى أصله أو وضّح جذوره)\nمثال: أحسب جذر خمسة بالآلة الحاسبة.",
 "根強い": "رَاسِخ, عَمِيق الجُذُور ((يستخدم خاصة للأفكار أو المبادئ) عميق الجذور؛ ثابت ومتمكّن بقوّة)",
 "根性": "ضبط النفس (سمة التحكم الحازم في سلوك المرء) / شَخْصِيَّة / خُلْق (أَنْشَأَ، أَوْجَدَ) / حَرْف, رَمْز (طَرَف وَجَانِب وَحَدّ؛ رَمْز مخطوط أو مطبوع يقوم مقام صوت أو كلمة أو عبارة أو معنى) / مِحْرَف\nمثال: زيري سيء الخلق.",
 "根性なし": "جَبَان (شديد الخوف ممتنع عن الإقدام؛ ضد الشجاع)\nمثال: إيدير مجرد جبان.",
 "根性のすわった": "جريء, جريئة",
 "根性悪": "سيء الطباع, فظ (ذو طبع سريع الغضب وغير سار)",
 "根性曲がり": "شِرِّير (الكَثير الشَرّ بمعنى اسم جامع للرذائل، قد يستعمل كاسم فاعل؛ ضد الخَيِّر؛ يستخدم أيضا بمعنى ذو الشَرّ وما تسبب بالشرّ)\nمثال: لقد وصف سامي ليلى كشخص شرير إلى حد يكاد لا يصدق.",
 "根性無し": "جَبَان (شديد الخوف ممتنع عن الإقدام؛ ضد الشجاع)\nمثال: إيدير مجرد جبان.",
 "根性焼き": "حرق سيجارة (أثر حرق تركته سيجارة مشتعلة)\nمثال: حرق سيجارة على حافة الطاولة",
 "根抜き": "الجماع المقطوع, العزل (طريقة لتحديد النسل يتم فيها بدء الجماع ولكن يتم سحب القضيب عمداً قبل القذف) / ابْنُ البَلَد, مَوْلُودٌ فِي البَلَد (يَنْتَمِي إِلَى مَكَانٍ بِحُكْمِ الوِلَادَةِ فِيهِ)",
 "根拠": "قَاعِدَة, أَسَاس / قَاعِدَة / قَاعِدَة, مَرْكَز / يُبْنَى عَلَى, يَسْتَنِدُ إِلَى / شائع / منخفض, فاسق / دنيء",
 "根拠のない": "لَا أَسَاس لَه, وَاهٍ (بدون أساس في العقل أو الواقع)",
 "根拠地": "قَاعِدَة / قَاعِدَة, مَرْكَز / يُبْنَى عَلَى, يَسْتَنِدُ إِلَى / شائع / منخفض, فاسق / دنيء",
 "根拠薄弱": "غَيْر مُؤَيَّد بِأَدِلَّة, غَيْر مُوَثَّق (غير مدعوم بأدلة أخرى)",
 "根掘り葉掘り": "بتساؤل, بفضول\nمثال: نظر الطفل حوله بفضول",
 "根方": "جَذْر, جدر (جِذْرُ ٱلشَّيْءِ هُوَ: أَصْلُهُ؛ في : جذر العدد النوني هو عدد ما إذا رفعناه لقوة ما أعطانا العدد الأصلي) / جَذْر (جِذْرُ ٱلشَّيْءِ هُوَ: أَصْلُهُ؛ في : جذر العدد النوني هو عدد ما إذا رفعناه لقوة ما أعطانا العدد الأصلي) / أَصْل (جعله أصيلًا أو ثابت الجذور؛ أي عَمَّق وأحكم أصوله؛ نسب شيئًا إلى أصله أو وضّح جذوره)\nمثال: أحسب جذر خمسة بالآلة الحاسبة.",
 "根明": "طَائِش, لَا مُبَالٍ (غير مسؤول بمرح وخِفّة)",
 "根明か": "طَائِش, لَا مُبَالٍ (غير مسؤول بمرح وخِفّة)",
 "根暗": "كَئِيب, مُوحِش",
 "根本": "قَاعِدَة / قَاعِدَة, مَرْكَز / يُبْنَى عَلَى, يَسْتَنِدُ إِلَى / شائع / منخفض, فاسق / دنيء / جَذْر, جدر (جِذْرُ ٱلشَّيْءِ هُوَ: أَصْلُهُ؛ في : جذر العدد النوني هو عدد ما إذا رفعناه لقوة ما أعطانا العدد الأصلي) / جَذْر (جِذْرُ ٱلشَّيْءِ هُوَ: أَصْلُهُ؛ في : جذر العدد النوني هو عدد ما إذا رفعناه لقوة ما أعطانا العدد الأصلي) / أَصْل (جعله أصيلًا أو ثابت الجذور؛ أي عَمَّق وأحكم أصوله؛ نسب شيئًا إلى أصله أو وضّح جذوره)\nمثال: أحسب جذر خمسة بالآلة الحاسبة. / جَذْر, جدر (جِذْرُ ٱلشَّيْءِ هُوَ: أَصْلُهُ؛ في : جذر العدد النوني هو عدد ما إذا رفعناه لقوة ما أعطانا العدد الأصلي) / جَذْر (جِذْرُ ٱلشَّيْءِ هُوَ: أَصْلُهُ؛ في : جذر العدد النوني هو عدد ما إذا رفعناه لقوة ما أعطانا العدد الأصلي) / أَصْل (جعله أصيلًا أو ثابت الجذور؛ أي عَمَّق وأحكم أصوله؛ نسب شيئًا إلى أصله أو وضّح جذوره)\nمثال: أحسب جذر خمسة بالآلة الحاسبة. / إِنْشاء, إِشَادَة (مصدر للفعل \"أَنْشَأَ\") / أَسَاس, قَاعِدَة (مبدأ عام تعتمد عليه طائفة من الظواهر أو القضايا؛ مُرتكز البناء وقاعدته) / مُؤَسَّسَة / أَسَاس (مبدأ عام تعتمد عليه طائفة من الظواهر أو القضايا؛ مُرتكز البناء وقاعدته)\nمثال: إنشاء موقع إلكتروني بدون أي تكلفة؟",
 "根本主義": "أُصُولِيَّة",
 "根本主義者": "أُصُولِيّ",
 "根本原理": "أساسيات, مبادئ أساسية (مبادئ يمكن استنتاج حقائق أخرى منها)\nمثال: أولاً يجب أن تتعلم الأساسيات",
 "根本的": "أَسَاسِيّ",
 "根来": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "根株": "جُذْمُور, كُنَّاشَة",
 "根比べ": "ماراثون, مسابقة التحمل (أي مشروع طويل وشاق)",
 "根毛": "شعيرة جذرية (نمو شعري رقيق لخلية بشرة خلف الطرف مباشرة؛ يمتص العناصر الغذائية من التربة)",
 "根気": "صَبْر, تَحَمُّل ((صَبَرَ) يَصْبِرُ صَبْرًا: تجلَّد ولم يَجْزَع؛ (صَبَرَ): انتظر في هدوء واطمئنان)\nمثال: الصبر أم العلوم.",
 "根気よく": "بصبر (مع صبر؛ بطريقة صبورة)\nمثال: لعب بصبر مع الطفل",
 "根気強い": "دَؤُوب, مُثَابِر (يُوَاظِبُ بِهُدُوءٍ وَثَبَاتٍ خَاصَّةً فِي التَّفَاصِيلِ وَالدِّقَّة)",
 "根気良く": "بصبر (مع صبر؛ بطريقة صبورة)\nمثال: لعب بصبر مع الطفل",
 "根津": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "根深": "بصل ويلزي, كراث ياباني (بصل آسيوي ذو بصيلات نحيلة؛ يستخدم كبصل أخضر مبكر)",
 "根深い": "رَاسِخ, عَمِيق الجُذُور ((يستخدم خاصة للأفكار أو المبادئ) عميق الجذور؛ ثابت ومتمكّن بقوّة)",
 "根深汁": "بصل ويلزي, كراث ياباني (بصل آسيوي ذو بصيلات نحيلة؛ يستخدم كبصل أخضر مبكر)",
 "根源": "جَذْر, جدر (جِذْرُ ٱلشَّيْءِ هُوَ: أَصْلُهُ؛ في : جذر العدد النوني هو عدد ما إذا رفعناه لقوة ما أعطانا العدد الأصلي) / جَذْر (جِذْرُ ٱلشَّيْءِ هُوَ: أَصْلُهُ؛ في : جذر العدد النوني هو عدد ما إذا رفعناه لقوة ما أعطانا العدد الأصلي) / أَصْل (جعله أصيلًا أو ثابت الجذور؛ أي عَمَّق وأحكم أصوله؛ نسب شيئًا إلى أصله أو وضّح جذوره)\nمثال: أحسب جذر خمسة بالآلة الحاسبة.",
 "根源的": "أَزَلِيّ, بِدْئِيّ (موجود منذ البداية؛ في أبكر مرحلة أو حالة أصلية)",
 "根無し": "صُعْلُوك, مُقْتَلَع الجُذُور (يتشرّد بلا هدف ودون روابط بمكان أو مجتمع)",
 "根無し草": "عدس الماء (عَدَس)\nمثال: أعدت سلطة العدس. / هَائِم",
 "根物": "خضراوات جذرية (أي من الجذور أو الدرنات الصالحة للأكل اللحمية المختلفة تحت الأرض)",
 "根生葉": "شارة وردية, وردة شريطية (حلية أو نمط يشبه الوردة يُلبس كشارة منصب أو اعترافاً بالفوز بشرف ما) / نافذة وردية (نافذة دائرية مليئة بالزخارف) / وريدة (مجموعة من الأوراق تنمو في دوائر مزدحمة من مركز مشترك أو تاج (عادة عند الأرض أو بالقرب منها)) / البطاطس الصغيرة, تقرح الساق (مرض الريزوكتونيا الذي يصيب البطاطس)",
 "根田": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "根矢": "رأس السهم, نصل (الرأس المدبب أو الطرف الضارب للسهم)",
 "根立": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "根競べ": "ماراثون, مسابقة التحمل (أي مشروع طويل وشاق)",
 "根管": "قناة الجذر (الممر في جذر السن الذي تدخل من خلاله أعصابه وأوعيته الدموية إلى تجويف اللب)",
 "根管治療": "قناة الجذر (الممر في جذر السن الذي تدخل من خلاله أعصابه وأوعيته الدموية إلى تجويف اللب)",
 "根絶": "استئصال, طمس (التدمير الكامل لكل أثر لشيء ما)",
 "根絶やし": "استئصال, طمس (التدمير الكامل لكل أثر لشيء ما)",
 "根継": "لصقة, وصلة (نقطة اتصال حيث يتم ضم شيئين (مثل الورق أو الفيلم أو الشريط المغناطيسي) معاً)\nمثال: كان الانقطاع بسبب وصلة غير متقنة",
 "根継ぎ": "لصقة, وصلة (نقطة اتصال حيث يتم ضم شيئين (مثل الورق أو الفيلم أو الشريط المغناطيسي) معاً)\nمثال: كان الانقطاع بسبب وصلة غير متقنة",
 "根腐れ": "عفن الجذور (مرض يتميز بتعفن الجذور؛ تسببه فطريات مختلفة)",
 "根茎": "جذمور (ساق نبات أفقية ذات براعم فوق وجذور تحت تعمل كهيكل تكاثري)",
 "根菜": "خضراوات جذرية (أي من الجذور أو الدرنات الصالحة للأكل اللحمية المختلفة تحت الأرض)",
 "根菜類": "محصول جذري (محصول يزرع لجذوره المتضخمة: مثل البنجر والبطاطس واللفت)",
 "根野菜": "محصول جذري (محصول يزرع لجذوره المتضخمة: مثل البنجر والبطاطس واللفت)",
 "根間": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "根際": "جَانِب / صَفْحَة",
 "根音": "جَذْر, جدر (جِذْرُ ٱلشَّيْءِ هُوَ: أَصْلُهُ؛ في : جذر العدد النوني هو عدد ما إذا رفعناه لقوة ما أعطانا العدد الأصلي) / جَذْر (جِذْرُ ٱلشَّيْءِ هُوَ: أَصْلُهُ؛ في : جذر العدد النوني هو عدد ما إذا رفعناه لقوة ما أعطانا العدد الأصلي) / أَصْل (جعله أصيلًا أو ثابت الجذور؛ أي عَمَّق وأحكم أصوله؛ نسب شيئًا إلى أصله أو وضّح جذوره)\nمثال: أحسب جذر خمسة بالآلة الحاسبة.",
 "根頭癌腫": "تدرن التاج (مرض بكتيري يصيب النباتات (خاصة الفواكه ذات النواة والتفاحيات والعنب والورود) يشكل نتوءات على الساق بالقرب من الأرض)",
 "格": "تَرْتِيب, دَرَجَة (تنظيم الأشياء أو الأحداث في تسلسل معين أو وضعها في نظام؛ إعداد أو تجهيز شيء لتحقيق غاية معينة) / حَال, حَالَة (تحول أو تغيّر من حالٍ إلى حالٍ؛ اعترض أو فصل بين شيئين)\nمثال: أعاد زيري ترتيب المطبخ كلية. / طَرِيقَة, مِنْهَج / قَانُون, قَاعِدَة (مقياس كل شيء وطريقه؛ أمر كليّ ينطبق على جميع جزئياته التي تعرف أحكامها منه) / حُكْم, حُكُومَة (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ) / حَكَمَ (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ)\nمثال: ذكرني بالقانون. / قَضِيَّة (الأمر أو الشيء المُعَقَّد؛ في : ما يقضي فيه القاضي) / عُلْبَة / حَالَات / دَعْوَى (إدِّعَاء؛ دُعَاء) / عُلَب\nمثال: سأرفع عليك قضية. / تَعْدِيل",
