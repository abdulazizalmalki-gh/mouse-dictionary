 "梏桎": "غُلّ, أَغْلال",
 "梓": "كرز شرقي, كرز ياباني (شجرة زينة بفاكهة غير صالحة للأكل تزرع على نطاق واسع في العديد من الأصناف لأزهارها البيضاء)",
 "梓に上せる": "نَشَرَ, أَصْدَرَ (بَسَطَ، فَرَّقَ، نَشَرَ الشيءَ: جعله منتشراً، مثل نشر الأخبار أو نشر كتاب؛ نَشَرَ: وزع أو عمم شيئًا بين الناس، مثل نشر المقالات)\nمثال: نشر توم الغسيل.",
 "梓匠": "صانع الأثاث, صانع الخزائن (نجار متخصص في صنع الأثاث)",
 "梔": "غاردينيا, ياسمين الكاب (شجيرة دائمة الخضرة تزرع على نطاق واسع لزهورها البيضاء الشمعية العطرة الكبيرة وأوراقها اللامعة)",
 "梔子": "غاردينيا, ياسمين الكاب (شجيرة دائمة الخضرة تزرع على نطاق واسع لزهورها البيضاء الشمعية العطرة الكبيرة وأوراقها اللامعة)",
 "梗塞": "إيقاف, توقف (فعل إيقاف شيء ما) / انسداد, سدادة (عائق في أنبوب أو مجرى) / توقف, كبح (حالة عدم النشاط بعد انقطاع)\nمثال: إيقافه للتدفق أدى إلى فيضان / احتشاء (نخر موضعي ناتج عن انسداد في تدفق الدم)",
 "梗概": "لَخَّصَ, اِخْتَصَرَ",
 "梛": "ناجي, ناجيا (شجرة متوسطة الحجم ذات أوراق رمحية لامعة؛ جنوب الصين إلى تايوان وجنوب اليابان)",
 "梛木擬": "خشب الكاوري (خشب أبيض دقيق الحبيبات لشجرة من جنس أغاتيس) / كاوري (شجرة خشب طويلة من نيوزيلندا لها خشب أبيض مستقيم الحبيبات) / صمغ الكاوري, كاوري (راتنج أشجار الكاوري في نيوزيلندا؛ يوجد عادة كأحفورة؛ ويُجمع أيضاً لصنع الورنيش والمشمع)",
 "梛筏": "سَفَنْدَر",
 "梟": "بُومَة",
 "梟す": "فضح, كشف القناع (فضح محتال أو مخادع)\nمثال: نشر فضيحة عن الرشوة والفساد في حكومة المدينة",
 "梟する": "فضح, كشف القناع (فضح محتال أو مخادع)\nمثال: نشر فضيحة عن الرشوة والفساد في حكومة المدينة",
 "梟座": "بُومَة",
 "梟雄": "رأس المدبرين, زعيم عصابة (شخص يقود الآخرين (خاصة في الأنشطة غير المشروعة))",
 "梢": "تاج الشجرة, قمة الشجرة (الفروع والأوراق العليا لشجرة أو نبات آخر)",
 "梢子": "مراكبي (رجل يقود أو يركب قارباً)",
 "梣葉の楓": "قيقب مانيتوبا, قيقب مراني الأوراق (شجرة ظل شائعة في شرق ووسط الولايات المتحدة)",
 "梨": "شَجَرَةُ اَلكُمَّثْرَى (نبات قائم على سَاق صلبة؛ مخطط له تفرعات) / كُمَّثْرَى, إِجَّاص",
 "梨の実": "كُمَّثْرَى, إِجَّاص",
 "梨原": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
