 "症": "مَرَض, دَاء (أصابه مرضٌ أو علّة أو سَقَم)\nمثال: هذا المرض قلبي.",
 "症例": "قَضِيَّة (الأمر أو الشيء المُعَقَّد؛ في : ما يقضي فيه القاضي) / عُلْبَة / حَالَات / دَعْوَى (إدِّعَاء؛ دُعَاء) / عُلَب\nمثال: سأرفع عليك قضية.",
 "症候": "عَرَض, عَلَامَة (أتى العروض، أي مكّة والمدينة وما حولهما؛ الفَرَسَ: سار به بالعُرض) / عَرَض (أتى العروض، أي مكّة والمدينة وما حولهما؛ الفَرَسَ: سار به بالعُرض)\nمثال: قبل كلاي العرض.",
 "症候学": "عِلْم اَلْأَعْرَاض (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "症候群": "مُتَلَازِمَة, أَعْرَاض",
 "症状": "عَرَض, عَلَامَة (أتى العروض، أي مكّة والمدينة وما حولهما؛ الفَرَسَ: سار به بالعُرض) / عَرَض (أتى العروض، أي مكّة والمدينة وما حولهما؛ الفَرَسَ: سار به بالعُرض)\nمثال: قبل كلاي العرض.",
 "痒い": "مُثِيرٌ لِلْحَكَّة, مُحِكّ (يُسَبِّبُ إِحْسَاسًا جِلْدِيًّا بِالحَكَّة) / قَلِق, مُتَمَلْمِل (عَصَبِيٌّ وَغَيْرُ قَادِرٍ عَلَى الاسْتِرْخَاء)",
 "痒み": "حِكَّة / أَحَكَّ (أَحَكَّ (فلانًا جسمَه): حكَّه؛ ويقال: أَحَكَّ الأمرَ في صدره: حكَّه)",
 "痒疹": "حكاك (مرض التهابي مزمن للجلد يتميز بحطاطات تعلوها بثور وحكة شديدة)",
 "痔": "بَاسُور",
 "痔核": "بَاسُور",
 "痔疾": "بَاسُور",
 "痕": "أَثَر (عَلَامَة؛ بَقِيَّة؛ رَسْم مُتَخَلَّف من شيء ما؛ تأثير؛ انطباع) / لِوْحَة دَارَاتُ مَطَبُوعَة\nمثال: اختفى فلم ير له أثر. / مَوْضِع / مَوْقِع (موضع الوُقُوع؛ الموضع الذي حَدَثَ أو يحدث فيه حادث)\nمثال: هنا موقع الحادث. / نَدْبَة, نَدْب",
 "痕跡": "أَثَر (عَلَامَة؛ بَقِيَّة؛ رَسْم مُتَخَلَّف من شيء ما؛ تأثير؛ انطباع) / لِوْحَة دَارَاتُ مَطَبُوعَة\nمثال: اختفى فلم ير له أثر.",
 "痘": "جُدَرِيّ / أثر بثرة, ندبة جدري (ندبة أو حفرة على الجلد تتركها بثرة جدري أو حب شباب أو مرض طفح جلدي آخر)",
 "痘そう": "جُدَرِيّ",
 "痘痕": "أثر بثرة, ندبة جدري (ندبة أو حفرة على الجلد تتركها بثرة جدري أو حب شباب أو مرض طفح جلدي آخر) / جُدَرِيّ / أثر بثرة, ندبة جدري (ندبة أو حفرة على الجلد تتركها بثرة جدري أو حب شباب أو مرض طفح جلدي آخر)",
 "痘瘡": "جُدَرِيّ",
 "痘苗": "لَقَاح",
 "痙性麻痺": "شلل تشنجي, شلل دماغي (فقدان أو نقص في التحكم الحركي مع تشنجات لا إرادية ناتجة عن تلف دائم في الدماغ موجود عند الولادة)",
 "痙攣": "اِخْتِلَاج (الخَلْجُ: الجَذْبُ،واختلج شيء في صدري:احتكأ مع شك؛ أصل الاختلاج: الحركة والاضطراب)",
 "痙縮": "تَشَنُّجِيَّة (صفة التحرك أو التصرف في تشنجات)",
 "痛": "أَحّ, حِلْيَة / أَلَمٌ (الوَجَع) / آلَمَ, يُؤْلِمُ (سبَّبَ أَلَمًا حسّيًّا أو وجعًا في الجسد؛ سَبَّبَ له الألَم)\nمثال: ألم أقل لك ذلك؟",
 "痛々しい": "مُثِير لِلشَّفَقَة, مُزْرٍ (يُثِير مَزيجاً مِن الاحتقار والشَّفَقة) / بَائِس, مُثِيرٌ لِلشَّفَقَة (يَسْتَحِقُّ الشَّفَقَةَ أَوْ يَسْتَدْعِيهَا) / مُؤْسِف, مُحْزِن (سيء ومؤسف؛ يبعث على الأسى)",
 "痛い": "أَلِيم, مُؤْلِم / حَرِج, مُحْرِج (صَعْب التَّعَامُل مَعَهُ؛ يُسَبِّب أَلَمًا أَوْ إِحْرَاجًا) / مُحْرِج, مُخْجِل (يسبب الشعور بالخجل أو الانزعاج أو الضيق)",
 "痛く": "بشدة, جداً (لدرجة قصوى) / بشكل كبير, جداً (إلى درجة أو مدى عال؛ بشكل إيجابي أو باحترام كبير)\nمثال: بارد جداً / بشكل مؤلم, بشكل محزن (بشكل غير سار) / بألم, بوجع (في حالة ألم أو كما لو كان متألماً)\nمثال: كان جهله واضحاً بشكل مؤلم",
 "痛ましい": "مُثِير لِلشَّفَقَة, مُزْرٍ (يُثِير مَزيجاً مِن الاحتقار والشَّفَقة) / بَائِس, مُثِيرٌ لِلشَّفَقَة (يَسْتَحِقُّ الشَّفَقَةَ أَوْ يَسْتَدْعِيهَا) / مُؤْسِف, مُحْزِن (سيء ومؤسف؛ يبعث على الأسى)",
 "痛み": "أَلَمٌ (الوَجَع) / آلَمَ, يُؤْلِمُ (سبَّبَ أَلَمًا حسّيًّا أو وجعًا في الجسد؛ سَبَّبَ له الألَم)\nمثال: ألم أقل لك ذلك؟ / عُطْل, ضَرَر (أوقف أو جعل شيء غير فعال لفترة معينة؛ إيقاف شيء عن العمل أو تركه بدون استخدام أو اهتمام)\nمثال: ذهب سامي في عطلة.",
 "痛み止め": "ضِدَّ الأَلَم, مُسَكِّن",
 "痛む": "جَرَحَ (كَلَمَ، شَقَّ اللَحْم وأسَالَ الدَمّ؛ صَادَ أو اكْتَسَبَ) / أَلِمَ, وَجِعَ (الوَجَع)\nمثال: ذلك سيهيج الجرح.",
 "痛めつける": "عَذَاب / عَذَّبَ",
 "痛める": "جَرَحَ (كَلَمَ، شَقَّ اللَحْم وأسَالَ الدَمّ؛ صَادَ أو اكْتَسَبَ) / أَلِمَ, وَجِعَ (الوَجَع)\nمثال: ذلك سيهيج الجرح. / ضَرَرٌ / ضَرَّ أَضَرَّ / قَلِقَ (شاعر بالقَلَق؛ تَحَرّك/اهتزاز/اضطراب في الوضع الطبيعي للشيء) / قَلَق (شاعر بالقَلَق؛ تَحَرّك/اهتزاز/اضطراب في الوضع الطبيعي للشيء)\nمثال: ليلى قلقة بشأنك.",
 "痛め付ける": "عَذَاب / عَذَّبَ",
 "痛め吟味": "تَعْذِيب / عَذَاب / عَذَّبَ",
 "痛切": "سَنِين, مُرْهَف (له حافة قاطعة أو رأس حادّ) / طَاعِن, لَاذِع (مؤلم كما لو كان ناتجاً عن أداة حادّة) / رَائِع, مُمْتَاز (ممتاز؛ بالغ الجودة) / حَادّ, لَاذِع (شَدِيدُ الحِدَّةِ وَالوَطْأَة)",
 "痛哭": "حداد, ندب (النشاط العاطفي والظاهر للتعبير عن الحزن) / رثاء, عويل (صرخة حزن وأسى)\nمثال: يمكن سماع نواحهم المثير للشفقة في جميع أنحاء الجناح",
 "痛心": "حزن شديد, فجيعة (أسى شديد ناتج عن فقدان شخص محبوب (خاصة بالموت))",
 "痛快": "مُبْهِج, مُنْعِش (يُضفي الحيوية والبهجة) / مُبْهِج, مُحَفِّز (يجعل النفس حيّة ومبتهجة)",
 "痛悔": "توبة, ندامة (الأسى على الخطيئة الناشئ عن الخوف من العقاب)",
 "痛烈": "جَسِيم, خَطِير (يُثير الخوف أو القلق بتهديده بأذى عظيم) / حَادّ, وَخِيم (سيء جداً في درجته أو مداه) / إسْبَرْطِيّ, شَدِيد (لا يرحم ولا يتهاون في الانضباط أو الحكم) / فَظِيع, وَخِيم (بَالِغُ السُّوءِ أَوِ الفَظَاعَةِ فِي الدَّرَجَةِ أَوِ النَّوْع)",
 "痛痒": "عذاب نفسي, كرب عقلي (ألم عاطفي مستمر ومضجر)",
 "痛罵": "تَعَسُّف, طُغْيَان / مَسَبَّة, شَتِيمَة / إِيذَاء جَسَدِيّ / اِنْتِهَاك جَسَدِيّ / أَسَاءَ اِسْتِعْمَالَ / آذَى / أَهَانَ, سَبَّ (شخص يكون لئيم لآخر بالكلام) / اِغْتَصَبَ, اِنْتَهَكَ (غَصَبَ؛ زَنَى (بِفُلَانَةٍ) قَهْرًا/غَصْبًا) / خَدَعَ, غَشَّ (غَشَّ، مَكَرَ؛ خَادَعَ شخصًا: خدعه بشكل مستمر أو بطريقة خفية)\nمثال: أهان سامي ليلى بقص شعرها.",
 "痛苦": "عذاب, غم (ضيق عقلي شديد) / ألم شديد, كمد (ضيق شديد في الجسم أو العقل)",
 "痛覚閾値": "عتبة الألم (أقل شدة للتحفيز التي يتم عندها الشعور بالألم)\nمثال: يتمتع بعض الناس بعتبات ألم أعلى بكثير من غيرهم",
 "痛風": "رَثْيَة / نِقْرِس",
 "痟𤸎": "سُكَّرِيّ, دِيَابِيطَا / سَيَلَان",
 "痢": "إِسْهَال",
 "痢病": "زُحَار",
 "痣": "وَحْمَة / كَدَمَ / كَدْمَة, رَضّ",
 "痤瘡": "حَبُّ الشَّبَاب (الزرع، كبيرا كان أم صغيرا؛ بَذْرُ الزرع)\nمثال: زيري بحب المال.",
 "痩せ": "مُنَحِّف",
 "痩せぎす": "نَحِيف",
 "痩せすぎ": "نَاقِص الوَزْن, هَزِيل (شَدِيد النُّحُول والهُزَال)",
 "痩せた": "رَفِيع, رَقِيق / ضعيف, ضعيفة / خَالٍ, عَدِيم (يفتقر بشكل كامل إلى شيء ما) / عَاقِر (لَا يُنْجِب ذُرِّيَّة؛ غَيْر قَادِر عَلَى الإِنْجَاب) / جَرْدَاء, قَاحِلَة (لا توفِّر مأوى ولا قوتاً) / أرض بور, أرض قاحلة (برية غير مأهولة لا تصلح للزراعة)\nمثال: الأراضي القاحلة في وسط أفريقيا",
 "痩せっぽち": "فَزَّاعَة",
 "痩せる": "فَقَدَ وَزْن",
 "痩せ細る": "فَقَدَ وَزْن",
 "痩せ肉": "عظمية, هزال شديد (نحافة شديدة (عادة بسبب الجوع أو المرض)) / مُتَهَالِك, هَزِيل جِدًّا (شَدِيد النُّحُول خَاصَّةً بِسَبَب المَرَض أَوِ الجُوع أَوِ البَرْد)",
 "痩せ過ぎ": "نَاقِص الوَزْن, هَزِيل (شَدِيد النُّحُول والهُزَال)",
 "痩果": "فقيرة (فاكهة جافة صغيرة غير متفتحة تكون البذرة فيها متميزة عن جدار الفاكهة)",
 "痩猿": "لانغور (قرد آسيوي نحيل طويل الذيل)",
 "痩肉": "عظمية, هزال شديد (نحافة شديدة (عادة بسبب الجوع أو المرض)) / مُتَهَالِك, هَزِيل جِدًّا (شَدِيد النُّحُول خَاصَّةً بِسَبَب المَرَض أَوِ الجُوع أَوِ البَرْد)",
 "痩身": "مُنَحِّف",
 "痰": "بَلْغَم / بَلْغَم, قُشَاعَة",
 "痰を切る": "تَنَحْنَحَ",
 "痰唾": "بلغم (مادة مقشوعة (مبصوقة)؛ لعاب ممزوج بإفرازات من الممرات التنفسية)",
 "痰壷": "مبصقة (وعاء للبصق (عادة في مكان عام))",
 "痰壺": "مبصقة (وعاء للبصق (عادة في مكان عام))",
 "痳毒": "سيلان (مرض تناسلي شائع تسببه بكتيريا النيسرية البنية؛ الأعراض هي تبول مؤلم وألم حول مجرى البول)",
 "痳疾": "سَيَلَان",
 "痳菌": "مكورة بنية, نيسرية بنية (البكتيريا المنتجة للقيح التي تسبب السيلان)",
 "痴": "حَمَاقَة (خطأ سخيف) / سَخَافَة / مُغَفَّل, أَحْمَق",
 "痴れ事": "حماقة, طيش (سلوك أحمق أو لا معنى له) / حماقة, غباء (خطأ سخيف) / حماقة (سمة التصرف بغباء أو تهور) / جنون, حماقة (صفة التهور والحماقة)\nمثال: محاولة القيادة خلال عاصفة ثلجية هي قمة الحماقة",
 "痴れ者": "مُغَفَّل, أَحْمَق",
 "痴れ言": "هُرَاء, لَغْو",
 "痴人": "أحمق, بليد (شخص غبي؛ تستخدم هذه الكلمات للتعبير عن رأي متدنٍ في ذكاء شخص ما)",
 "痴呆": "خَرَف ((خَرُفَ) الرجل خرفا وخرافة: خرف) / غَبَاء, غَبَاوَة (بمعنى أن يخفى الأمر، يقال أيضا غَبَاءَة وغَبَاوَة والغباء أعمّ؛ بمعنى ضد الفِطْنة والذَكاء، يقال أيضا غَبَاوة)\nمثال: ما تقترحه غباء.",
 "痴呆症": "خَرَف ((خَرُفَ) الرجل خرفا وخرافة: خرف)",
 "痴情": "معشوق, مفتون به (موضوع لشغف مفرط وقصير الأمد) / افتتان, ولع (شغف أو حب أو إعجاب أحمق وعادة ما يكون مفرطاً) / إعجاب عابر, حب المراهقة (حب مؤقت لمراهق)",
 "痴愚": "حماقة, غباء (خطأ سخيف) / بلاهة (تخلف عقلي أشد من البله ولكن ليس بشدة العته)",
 "痴態": "حَمَاقَة (خطأ سخيف)",
 "痴漢": "متحرش (شخص يُخضع الآخرين لأنشطة جنسية غير مرغوب فيها أو غير لائقة) / مُغَفَّل, أَحْمَق",
 "痴漢行為": "مُتَخَبِّط, مُتَلَمِّس (يتصرّف بتردّد وعدم ثقة أو يقين)",
 "痴言": "هُرَاء, لَغْو",
 "痴話": "كلمات معسولة, همسات الحب (تعبيرات عاطفية غير مهمة المضمون)\nمثال: همس بكلمات معسولة في أذنها",
 "痴話文": "رِسَالَةُ حُبٍّ",
 "痺れ": "فتور, لامبالاة (سمة الافتقار للحماس أو الاهتمام بالأشياء عموماً) / تنميل, خدر (فقدان جزئي أو كلي للإحساس في جزء من الجسم؛ عَرَض لتلف الأعصاب أو خلل وظيفي)",
 "痺れえい": "رعاد, سمك الرعاد (أي سمكة راي بطيئة الحركة تعيش في القاع من رتبة الطوربيدينيات ولها جسم مستدير وأعضاء كهربائية على كل جانب من الرأس قادرة على إصدار شحنات كهربائية قوية)",
 "痺れる": "وَخَزَ (الطعن بآلة حادة بدون يكون نافذا ولا يكسر الجلد) / نَمِلَ\nمثال: إذا كنت وخز لنا، هل نحن لا ينزف؟",
 "痺れエイ": "رعاد, سمك الرعاد (أي سمكة راي بطيئة الحركة تعيش في القاع من رتبة الطوربيدينيات ولها جسم مستدير وأعضاء كهربائية على كل جانب من الرأس قادرة على إصدار شحنات كهربائية قوية)",
 "痺れ感": "فتور, لامبالاة (سمة الافتقار للحماس أو الاهتمام بالأشياء عموماً) / تنميل, خدر (فقدان جزئي أو كلي للإحساس في جزء من الجسم؛ عَرَض لتلف الأعصاب أو خلل وظيفي)",
 "痺れ薬": "مُخَدِّر, بَنْج",
 "痺れ鯰": "رعاد, سلور كهربائي (سلور مياه عذبة في النيل ووسط أفريقيا الاستوائية يمتلك عضواً كهربائياً)",
 "痺れ鰻": "أنقليس رعاد, أنقليس كهربائي (سمكة مياه عذبة تشبه الثعبان تعيش في أمريكا الجنوبية ولها أعضاء كهربائية في جسمها)",
 "痺れ鱏": "رعاد, سمك الرعاد (أي سمكة راي بطيئة الحركة تعيش في القاع من رتبة الطوربيدينيات ولها جسم مستدير وأعضاء كهربائية على كل جانب من الرأس قادرة على إصدار شحنات كهربائية قوية)",
 "痺れ鱝": "رعاد, سمك الرعاد (أي سمكة راي بطيئة الحركة تعيش في القاع من رتبة الطوربيدينيات ولها جسم مستدير وأعضاء كهربائية على كل جانب من الرأس قادرة على إصدار شحنات كهربائية قوية)",
 "痺鯰": "رعاد, سلور كهربائي (سلور مياه عذبة في النيل ووسط أفريقيا الاستوائية يمتلك عضواً كهربائياً)",
 "痺鰻": "أنقليس رعاد, أنقليس كهربائي (سمكة مياه عذبة تشبه الثعبان تعيش في أمريكا الجنوبية ولها أعضاء كهربائية في جسمها)",
 "痼る": "جَمَدَ (صَارَ صُلْبًا أو قَاسِيًا بَعْدَ السَّيُولَةِ؛ تَوَقَّفَ عَنِ الحَرَكَةِ أو النَّمُوِّ)",
 "痿疾": "عَنَانَة, عُنَّة",
 "瘋癲": "جُنُون / تَائِه, مُتَشَرِّد (يتنقّل باستمرار خاصّة من مسكن أو عمل لآخر) / صُعْلُوك, مُقْتَلَع الجُذُور (يتشرّد بلا هدف ودون روابط بمكان أو مجتمع) / جسم تائه, شارد (أي شيء يشبه المتشرد في عدم وجود مكان ثابت له) / متشرد, هائم (متجول ليس لديه إقامة ثابتة أو وسيلة عيش ظاهرة)\nمثال: كانت سفن القراصنة شوارد البحر",
 "瘋癲病院": "مارستان, مستشفى المجانين (مصطلحات تحقيرية لمصحة المجانين)",
 "瘡": "أَكْزِيمَا / بثرة قيحية (ارتفاع جلدي ملتهب صغير يحتوي على قيح؛ فقاعة مملوءة بالقيح) / زُهَرِيّ, مَرَض فِرَنْجِيّ"
}
