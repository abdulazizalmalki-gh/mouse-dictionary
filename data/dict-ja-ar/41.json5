 "止し": "زَالَ (زَالَ يَزُولُ زَوَالاً، وزَوَلاَنًا: تحوَّلَ وانتقل؛ يقال: زَالَ من مكانه وعنه)\nمثال: توم لا زال يبكي",
 "止す": "وَقَفَ, تَوَقَّفَ (قَامَ، اِنْتَصَبَ، نَهَضَ؛ ثَبَتَ)\nمثال: وقف وراء الباب.",
 "止まない": "دَائِمًا, أَبَدًا / جِدًّا (كلمة \"جدا\" لها معانٍ متعددة؛ يرتبط المعنى بالعطاء والكرم، سواء بالمنح أو طلبه)\nمثال: إنها غالية جدا!",
 "止まない雨はない": "هُنَاكَ, يُوجَدُ",
 "止まり": "وَقَفَ, تَوَقَّفَ (قَامَ، اِنْتَصَبَ، نَهَضَ؛ ثَبَتَ)\nمثال: وقف وراء الباب.",
 "止まり木": "فرخ (أي من الأسماك العديدة شائكة الزعانف من فصائل مختلفة من رتبة الفرخيات)",
 "止まる": "وَقَفَ, تَوَقَّفَ (قَامَ، اِنْتَصَبَ، نَهَضَ؛ ثَبَتَ)\nمثال: وقف وراء الباب. / بَاقِي (الباقي : اسم من أسماء الله تعالى ومعناه : المستأثر بالبقاء والدّوام ، وهو نتيجة…)\nمثال: الباقي ليس مهم. / زَالَ (زَالَ يَزُولُ زَوَالاً، وزَوَلاَنًا: تحوَّلَ وانتقل؛ يقال: زَالَ من مكانه وعنه)\nمثال: توم لا زال يبكي",
 "止まれ": "وَقَفَ, تَوَقَّفَ (قَامَ، اِنْتَصَبَ، نَهَضَ؛ ثَبَتَ)\nمثال: وقف وراء الباب.",
 "止みがたい": "لَا يُقَاوَم (بالغ الجاذبيّة إلى حدّ لا يمكن مقاومته)\nمثال: دوافع لا تقاوم",
 "止み難い": "لَا يُقَاوَم (بالغ الجاذبيّة إلى حدّ لا يمكن مقاومته)\nمثال: دوافع لا تقاوم",
 "止む": "زَالَ (زَالَ يَزُولُ زَوَالاً، وزَوَلاَنًا: تحوَّلَ وانتقل؛ يقال: زَالَ من مكانه وعنه)\nمثال: توم لا زال يبكي",
 "止むかたなし": "هُنَاكَ, يُوجَدُ",
 "止むに止まれず": "قَاهِر, لَا يُقَاوَم (يميل إلى الإقناع بقوّة البرهان)",
 "止むに止まれない": "قَاهِر, لَا يُقَاوَم (يميل إلى الإقناع بقوّة البرهان)",
 "止むに止まれぬ": "قَاهِر, لَا يُقَاوَم (يميل إلى الإقناع بقوّة البرهان)",
 "止むを得ず": "بشكل حتمي, لا محالة (بحكم الضرورة؛ بشكل لا مفر منه)\nمثال: انزلق الوضع لا محالة نحو الكارثة",
 "止むを得ない": "وَاجِب (اسم لما يُوجَبُ فعله؛ اسم لما صار حدوثه أكيد)\nمثال: لا شكر على واجب.",
 "止むを得まい": "وَاجِب (اسم لما يُوجَبُ فعله؛ اسم لما صار حدوثه أكيد)\nمثال: لا شكر على واجب.",
 "止むを得ません": "وَاجِب (اسم لما يُوجَبُ فعله؛ اسم لما صار حدوثه أكيد)\nمثال: لا شكر على واجب.",
 "止むを得ん": "وَاجِب (اسم لما يُوجَبُ فعله؛ اسم لما صار حدوثه أكيد)\nمثال: لا شكر على واجب.",
 "止む得ず": "بشكل حتمي, لا محالة (بحكم الضرورة؛ بشكل لا مفر منه)\nمثال: انزلق الوضع لا محالة نحو الكارثة",
 "止む方なし": "هُنَاكَ, يُوجَدُ",
 "止む無い": "وَاجِب (اسم لما يُوجَبُ فعله؛ اسم لما صار حدوثه أكيد)\nمثال: لا شكر على واجب.",
 "止む無く": "اضْطِرَارًا, بِالضَّرُورَة (عن طريق الضرورة؛ بحكم الظروف)",
 "止む無し": "وَاجِب (اسم لما يُوجَبُ فعله؛ اسم لما صار حدوثه أكيد)\nمثال: لا شكر على واجب.",
 "止む終えない": "وَاجِب (اسم لما يُوجَبُ فعله؛ اسم لما صار حدوثه أكيد)\nمثال: لا شكر على واجب.",
 "止む負えない": "وَاجِب (اسم لما يُوجَبُ فعله؛ اسم لما صار حدوثه أكيد)\nمثال: لا شكر على واجب.",
 "止め": "وَقَفَ, تَوَقَّفَ (قَامَ، اِنْتَصَبَ، نَهَضَ؛ ثَبَتَ)\nمثال: وقف وراء الباب. / فَائِض, مُتَبَقٍّ (لم يُسْتَهْلَك بعد)",
 "止めくぎ": "توجل, مسمار تثبيت (مثبت يتكون من وتد أو مسمار أو قطعة عرضية يتم إدخالها في عروة في نهاية حبل أو…)",
 "止めた": "مَاضٍ, الْمَاضِي ((في النحو) زمن نحوي يدل على حدث قد وقع، أو وُجِد قبل الآن بوقت ما)",
 "止めだて": "تقييد, كبح (فعل السيطرة عن طريق تقييد شخص ما أو شيء ما)\nمثال: التقييد غير القانوني للتجارة",
 "止めておく": "مَرَّرَ, مَرَّ\nمثال: أسأل عن الطريق.",
 "止めとき": "لَا (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر…)\nمثال: لا أحب المدرسة.",
 "止めど": "نِهَايَة, غَايَة\nمثال: انتهى أمر زيري.",
 "止めどない": "حَلَقِيّ, لَا نِهَائِيّ (مُتَّصِلُ الأَطْرَافِ بِحَيْثُ يُشَكِّلُ كُلًّا مُتَّصِلًا)",
 "止めどなく": "إِلى مَا لَا نِهَايَة, بِلَا نِهَايَة (الاستمرار للأبد دون توقف)\nمثال: هناك احتمالات لا حصر لها",
 "止めにする": "وَقَفَ, تَوَقَّفَ (قَامَ، اِنْتَصَبَ، نَهَضَ؛ ثَبَتَ)\nمثال: وقف وراء الباب.",
 "止めに入る": "تَدَخَّلَ",
 "止める": "وَقَفَ, تَوَقَّفَ (قَامَ، اِنْتَصَبَ، نَهَضَ؛ ثَبَتَ)\nمثال: وقف وراء الباب. / حَدِيقَة (الحَديقَةُ، الرَّوْضَةُ ذاتُ الشجرِ؛ حديقة , العاطل عن العمل في اللهجة العراقية…)\nمثال: ليس لدينا حديقة. / مَنَعَ (حَرَمَ، ضد أَعْطَى؛ كَفَّ عنه وحَمَاه)\nمثال: تساهم جذور أشجار المنغروف في منع حدوث انجراف التربة. / لَاحَظَ / وَقَفَ, تَوَقَّفَ (قَامَ، اِنْتَصَبَ، نَهَضَ؛ ثَبَتَ)\nمثال: وقف وراء الباب. / أَلْغَى, أَبْطَلَ / وَقَفَ, تَوَقَّفَ (قَامَ، اِنْتَصَبَ، نَهَضَ؛ ثَبَتَ)\nمثال: وقف وراء الباب. / دَبُّوس / حَدّ (مُنْتَهى الشيءِ؛ الْفَصْلُ بَيْنَ الشَّيْئَيْنِ لِئَلَّا يَخْتَلِطَ أَحدهما…)\nمثال: أعرفها إلى حد ما. / تَسْجِيل, مُدَوَّنَة\nمثال: سجل سامي وصوله.",
 "止め具": "زِلاَج, ضَبَّة",
 "止め処": "نِهَايَة, غَايَة\nمثال: انتهى أمر زيري.",
 "止め処なく": "إِلى مَا لَا نِهَايَة, بِلَا نِهَايَة (الاستمرار للأبد دون توقف)\nمثال: هناك احتمالات لا حصر لها",
 "止め処無い": "حَلَقِيّ, لَا نِهَائِيّ (مُتَّصِلُ الأَطْرَافِ بِحَيْثُ يُشَكِّلُ كُلًّا مُتَّصِلًا)",
 "止め男": "مُخبر المراهنات (شخص يبيع النصائح حول المقامرة أو المضاربة (خاصة في سباق الخيل)) / حَكَم, مُحكِّم (شخص يتم اختياره للحكم والبت في قضية متنازع عليها)\nمثال: اعتُبر الناقد حكماً للأدب الحديث",
 "止め立て": "تقييد, كبح (فعل السيطرة عن طريق تقييد شخص ما أو شيء ما)\nمثال: التقييد غير القانوني للتجارة",
 "止め置き": "تَوْقِيف",
 "止め置く": "اِعْتَقَلَ (أمسك الأطراف وربطها، بمعنى عَقَلَ؛ أمسك ووضع في السجن أو المَعْقَل)\nمثال: اعتقل لقيادته و هو سكران.",
 "止め金": "إمساك, قبضة (فعل الإمساك)\nمثال: أرخى قبضته عن ذراعي",
 "止め釘": "توجل, مسمار تثبيت (مثبت يتكون من وتد أو مسمار أو قطعة عرضية يتم إدخالها في عروة في نهاية حبل أو…)",
 "止め針": "دَبُّوس",
 "止め鋏": "النسخة النهائية (النسخة المحررة النهائية للفيلم كما وافق عليها المخرج والمنتج)",
 "止処": "نِهَايَة, غَايَة\nمثال: انتهى أمر زيري.",
 "止宿": "إِقَامَة",
 "止瀉剤": "مضاد للإسهال (دواء يستخدم للسيطرة على الإسهال أو إيقافه)",
 "止瀉薬": "مضاد للإسهال (دواء يستخدم للسيطرة على الإسهال أو إيقافه)",
 "止男": "مُخبر المراهنات (شخص يبيع النصائح حول المقامرة أو المضاربة (خاصة في سباق الخيل)) / حَكَم, مُحكِّم (شخص يتم اختياره للحكم والبت في قضية متنازع عليها)\nمثال: اعتُبر الناقد حكماً للأدب الحديث",
 "止痛剤": "مسكن ألم (الموضع الذي يسكن فيه الإنسان بمعنى يُقيم؛ البَيْت أو الدار)\nمثال: كان دوري كي أنظف المسكن",
 "止痢剤": "مضاد للإسهال (دواء يستخدم للسيطرة على الإسهال أو إيقافه)",
 "止置き": "تَوْقِيف",
 "止置く": "اِعْتَقَلَ (أمسك الأطراف وربطها، بمعنى عَقَلَ؛ أمسك ووضع في السجن أو المَعْقَل)\nمثال: اعتقل لقيادته و هو سكران.",
 "止血": "إرقاء, قطع النزف (إجراء جراحي لوقف تدفق الدم)",
 "止血剤": "مُرْقِئ, مُوقِف لِلنَّزِيف (يميل إلى وقف النزيف عبر تقليص الأنسجة أو الأوعية الدموية)",
 "止血帯": "عاصِبَة",
 "止血薬": "مُرْقِئ, مُوقِف لِلنَّزِيف (يميل إلى وقف النزيف عبر تقليص الأنسجة أو الأوعية الدموية)",
 "止針": "دَبُّوس",
 "止音器": "كابح, مثبط (قيد يسبب الإحباط أو التثبيط)\nمثال: وضع المطر كابحًا لخطط نزهتنا",
 "正": "حَقٌّ (اسم من الأسماء الحسنى وهو من صفات الله. لا جمع له؛ ضد البَاطِل، العَدْل…)\nمثال: الأستاذ على حق. / أَصْلِيّ / مُوجَب / أُطْرُوحَة / بِالضَّبْط, تَمَامًا / صَحِيح, صَوَاب\nمثال: صحح نطقي من فضلك. / أَكْبَر, كُبْرَى (الأَكْبَر: هو ما فاق غيره في الكُبْر، ويكون ذلك إما بالحجم أو المقام أو كلاهما…)\nمثال: إنه أخي الأكبر. / مُدِير, مُدِيرَة (الشخص الذي أدار، جمعه مُدِيرُون ومُدِيرِين؛ مهنة يتولى صاحبها إدَارَة شؤون جهة…)\nمثال: زيري هو المدير. / مَضْبُوط, دَقِيق",
 "正々": "مَضْبُوط\nمثال: ساعتي غير دقيقة.",
 "正しい": "يَمِين, يمين\nمثال: أجب على السؤال. / سَلِيم, صَحِيح (ملائم لحالة أو غرض أو مناسبة أو لطبيعة الشخص واحتياجاته)\nمثال: علاج طبي مناسب",
 "正しく": "بِالتَّأْكِيد / عَدْل (عَدْل)\nمثال: هل يعاملون بالعدل / يَمِين, يمين\nمثال: أجب على السؤال.",
 "正す": "صَحِيح, صَوَاب\nمثال: صحح نطقي من فضلك. / اِسْتَقَامَ (أَقَامَ نفسه)",
 "正に": "بِالضَّبْط, تَمَامًا / يَمِين, يمين\nمثال: أجب على السؤال. / عَدْل (عَدْل)\nمثال: هل يعاملون بالعدل / حَقًّا (حَقَا (حقاه) حقوا: أصاب حقوه، يقال ضربه فحقاه؛ (حَقَا)الشيء فلانا: بلغ حقوه…)\nمثال: هو اغضبني حقا .",
 "正の数": "عَدَد مُوجَب (مِقْدَار مَا يُعَدّ)\nمثال: كم عدد سكان الجزائر؟",
 "正三角形": "مثلث متساوي الأضلاع (مضلع منتظم ثلاثي الأضلاع)",
 "正中": "مُنْتَصَف, وَسَط / نَزَاهَة, حِيَاد / إتمام, إكمال (إجراء ختامي أو نهائي)\nمثال: مشهد فراش الموت هو ذروة المسرحية",
 "正二十面体": "عشروني سطوح منتظم (عشروني سطوح ذو عشرين مثلثاً متساوي الأضلاع كأوجه)",
 "正五角形": "خماسي منتظم, مخمس منتظم (مخمس تكون فيه جميع الزوايا متساوية وجميع الأضلاع متساوية)",
 "正体": "مُطَابَقَة / وَعْي (الفَهْم والتَدَبُّر واِحْتِوَاء كل معاني الشيء؛ في علم النفس: حالة وعي ويعني…)\nمثال: إنها فاقدة الوعي.",
 "正体不明": "غير قابل للتعرف عليه, مجهول الهوية (يستحيل التعرف عليه أو تحديده)",
 "正体字": "حُرُوف صِينِيَّة تَقْلِيدِيَّة (صِيْغَةُ جَمْعٍ مُفْرَدُهَا: حرف)\nمثال: كيف أتذكر الحروف الصينية؟",
 "正値性": "عَدَم قَابِلِيَّة الدَّحْض, قَطْعِيَّة (صفة كون الشيء غير قابل للإنكار ولا يستحق الجدال حوله)",
 "正八胞体": "تسراكت, مكعب فائق (النظير رباعي الأبعاد للمكعب)",
 "正八面体": "ثماني سطوح منتظم (ثماني سطوح ذو ثمانية مثلثات متساوية الأضلاع كأوجه)",
 "正六面体": "سداسي سطوح منتظم, مكعب (سداسي سطوح له ستة مربعات متساوية كأوجه)",
 "正典": "الأسفار القانونية (مجموعة الكتب المقبولة ككتب مقدسة، وخاصة كتب الكتاب المقدس المعترف بها من قبل أي…)\nمثال: القانون الكلاسيكي الجديد",
 "正典化": "إعلان القداسة (فعل قبول شخص متوفى في قائمة القديسين)",
 "正円窓": "نافذة مدورة (نافذة تؤدي إلى القوقعة)",
 "正切": "مُمَاسّ",
 "正則": "صَحِيح, صَوَاب\nمثال: صحح نطقي من فضلك. / عَكُوْسَة",
 "正則化": "تسوية, تنظيم (فعل تحقيق التوحيد؛ جعله منتظماً)",
 "正割": "قَاطِع",
 "正北": "الشَّمَال (نقطة البوصلة الأصلية التي تكون عند 0 أو 360 درجة)",
 "正十二面体": "اثنا عشري سطوح منتظم (اثنا عشري سطوح ذو اثني عشر مخمساً منتظماً كأوجه)",
 "正午": "ظهر, ظَهِيرَة (مصدر للفعل ظَهَرَ؛ خلاف البَطْن، الجزء الظَاهِر من الشيئ وغير البَاطِن)\nمثال: عنده حقيبة ظهر.",
 "正南": "الجَنُوب (نقطة البوصلة الأصلية التي تكون عند 180 درجة)",
 "正号": "عَلَامَة زَائِد, عَلَامَةُ جَمْع (سِمَةٌ أو أمارة أو شِعَار تُعرف به الأشياء؛ رَمْز)\nمثال: تحصلت على علامة أ.",
 "正味": "شَبَكَة, شبكة / اَلْوَزْن اَلصَّافِي",
 "正味重量": "اَلْوَزْن اَلصَّافِي",
 "正員": "عُضْو, عِضْو (جُزْء من الجَسَد؛ مُشْتَرِك فِي جَمْعِيَّة أو شَرِكَة أو حِزْب أو نَادٍ)\nمثال: اذكر كل عضو باسمه.",
 "正四面体": "رباعي سطوح منتظم (رباعي سطوح ذو أربعة أوجه مثلثة متساوية الأضلاع)",
 "正垣": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "正多角形": "مضلع منتظم (مضلع جميع أضلاعه وجميع زواياه متساوية)",
 "正多面体": "متعدد سطوح منتظم, مجسم أفلاطوني (أي واحد من خمسة مجسمات أوجهها مضلعات منتظمة متطابقة وزواياها متعددة السطوح…)",
 "正大": "إِنْصَاف (أخْذُ نِصْف الشيء أو وصول النصف؛ العَدْل والتَقْسِيم بالتساوي بدون أن يظلم أي…)",
 "正妃": "ملكة قرينة (زوجة الملك الحاكم)",
 "正子": "مُنْتَصَف لَيْل, مُنْتَصَف اللَّيْل",
 "正孔": "ثَقْب, حُفْرة (فَجَّرَ أو خَرَقَ شيئًا بفتح فيه؛ نَفَذَ أو مرَّ عبر شيء)\nمثال: انه ثقب الاسود.",
 "正字法": "إِمْلَاء (الاسم من قراءة الشيء على أحد ما حتى يكتبه كما قُرِأ؛ الأمر بأشياء بدون السماح…)\nمثال: أدرس علم النفس.",
 "正宗": "غاية, غَرَض",
 "正客": "ضيف الشرف (الشخص الذي يُعقد التجمع تكريماً له)",
 "正室": "وَارِث, وَرِيث (اسم فاعل من الفعل وَرَثَ؛ الوَارِث: اسم من الأسماء الحسنى)",
 "正岡": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "正常": "عَادِيّ",
 "正常位": "الوضع التبشيري, الوضع التقليدي (وضع للجماع الجنسي؛ يستلقي الرجل والمرأة في مواجهة بعضهما البعض مع كون الرجل في…)",
 "正常化": "تطبيع, تقييس (فرض المعايير أو اللوائح)",
 "正式": "رَسْمِيّ, صُورِيّ (منسوب للسُّلْطَة أو الحُكُومَة أو الدَّوْلَة أو القَانُون؛ مُلَائِم للمَعَايِير)\nمثال: لقد انتهى الدرس بشكل رسمي.",
 "正引": "بحث (عملية تحدد ما إذا كان عنصر واحد أو أكثر من مجموعة عناصر يمتلك خاصية محددة)\nمثال: كتبوا برنامجاً للبحث في الجدول",
 "正引き": "بحث (عملية تحدد ما إذا كان عنصر واحد أو أكثر من مجموعة عناصر يمتلك خاصية محددة)\nمثال: كتبوا برنامجاً للبحث في الجدول",
 "正弦": "جَيْب (جيَّب القميص:جَابَ، جعل له جيبًا)\nمثال: جيب سامي مثقوب.",
 "正弦曲線": "منحنى الجيب",
 "正弦波": "موجة جيبية (موجة يشبه شكلها منحنى الجيب)",
 "正当": "عَدْل (عَدْل)\nمثال: هل يعاملون بالعدل",
 "正当化": "تَبْرِير",
 "正当性": "قَانُونِيَّة, مَشْرُوعِيَّة (صفة الامتثال للقانون)",
 "正当防衛": "دفاع عن النفس (فعل الدفاع عن نفسك)",
 "正接": "مُمَاسّ",
 "正攻法": "إجراء تشغيلي قياسي, إجراء قياسي (إجراء مقرر يجب اتباعه بشكل روتيني)\nمثال: الحفظ عن ظهر قلب كان الإجراء التشغيلي القياسي للمعلمين لقرون",
 "正教": "أُرْثُوذُكْسِيَّة (أرثوذكسيَّة)",
 "正教会": "أُرْثُوذُكْسِيَّة شَرْقِيَّة (أرثوذكسيَّة)",
 "正教授": "أستاذ كامل, أستاذ كرسي (أستاذ من أعلى رتبة)",
 "正数": "عَدَد مُوجَب (مِقْدَار مَا يُعَدّ)\nمثال: كم عدد سكان الجزائر؟",
 "正断層": "صدع عادي (صدع مائل يبدو فيه أن الجدار المعلق قد انزلق لأسفل بالنسبة للجدار السفلي)",
 "正方": "مُرَبَّع (كُلُّ ما يُرَبَّعُ؛ كُلُّ ما له أربعة أركانٍٍ)",
 "正方形": "مُرَبَّع (كُلُّ ما يُرَبَّعُ؛ كُلُّ ما له أربعة أركانٍٍ)",
 "正方行列": "مَصْفُوفَة مُرَبَّعَة",
 "正時": "وَقْت (\"بَقِيَ وَقْتاً عِنْدَهُ \" : أَيْ مِقْدَاراً مِنَ الزَّمَنِ؛ \"جَاءَ فِي…)\nمثال: حان وقت الذهاب.",
 "正書法": "إِمْلَاء (الاسم من قراءة الشيء على أحد ما حتى يكتبه كما قُرِأ؛ الأمر بأشياء بدون السماح…)\nمثال: أدرس علم النفس.",
 "正月": "السَّنَة الْجَدِيدَة / يَنَايِر, كَانُون اَلثَّانِي (الشهر الأول من السنة الروميّة)\nمثال: لتبدأ الاحتفالات بيناير.",
 "正月休み": "السَّنَة الْجَدِيدَة",
 "正月飾り": "أول أيام السنة, يوم رأس السنة (اليوم الأول من السنة)",
 "正服": "زَيّ, زِي",
 "正朔": "أول أيام السنة, يوم رأس السنة (اليوم الأول من السنة)",
 "正期産": "مكتمل الحمل (حُمل به طوال مدة الحمل الطبيعي)\nمثال: طفل مكتمل الحمل وبصحة جيدة",
 "正木": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "正本": "أَصْلِيّ",
 "正札": "عَلَامَةُ سِعْر, بِطَاقَةُ سِعْر (سِمَةٌ أو أمارة أو شِعَار تُعرف به الأشياء؛ رَمْز)\nمثال: تحصلت على علامة أ.",
 "正東": "الشَّرْق (نقطة البوصلة الأصلية التي تكون عند 90 درجة)",
 "正極": "كاثود, مهبط (قطب كهربائي سالب الشحنة وهو مصدر الإلكترونات التي تدخل جهازاً كهربائياً)",
 "正横": "بمحاذاة المنتصف (بزوايا قائمة لطول سفينة أو طائرة)",
 "正正": "مَضْبُوط\nمثال: ساعتي غير دقيقة.",
 "正比例": "تَنَاسُب, تَوَازُن (ترتيب أو علاقة متناغمة للأجزاء أو العناصر داخل كلٍّ (كما في التصميم))",
 "正気": "رشاد, سلامة العقل (القوى الطبيعية أو السليمة للعقل)",
