 "末席": "قَاع (أَرْض مستوية سهلة تنصب إِليها مياه الأمطار فتمسكها ثم تُنبت العشب؛ القَعْر)\nمثال: نمت في قاعة السينما.",
 "末恐ろしい": "مُجَفِّل, مُخِيف",
 "末成": "شَاحِب الوَجْه (ذو وجه شاحب)",
 "末成り": "شَاحِب الوَجْه (ذو وجه شاحب)",
 "末摘花": "مُرِّيق, مُرَّيْق",
 "末日": "يوم الحساب, يوم الدين (اليوم في نهاية الزمان الذي سيقضي فيه الله بمصير جميع البشر وفقاً لأعمالهم)",
 "末日聖徒": "قديس الأيام الأخيرة, مورموني (عضو في كنيسة يسوع المسيح لقديسي الأيام الأخيرة)",
 "末日聖徒イエスキリスト教会": "كنيسة المورمون, كنيسة يسوع المسيح لقديسي الأيام الأخيرة (كنيسة أسسها جوزيف سميث عام 1830 ومقرها الرئيسي في سولت ليك سيتي، يوتا)",
 "末期": "اَلْعَامَ اَلْمَاضِيَ, اَلسَّنَةَ ٱلْمَاضِيَةَ",
 "末期的": "فِي مَرْحَلَة مُتَأَخِّرَة, نِهَائِيّ (يُسَبِّب أَوْ يَنْتَهِي بِالمَوْت أَوْ يَقْتَرِب مِنْه)\nمثال: العمود الطرفي",
 "末木": "تاج الشجرة, قمة الشجرة (الفروع والأوراق العليا لشجرة أو نبات آخر)",
 "末末": "أحفاد, ذُرِّيَّة (كل نسل سلف معين)\nمثال: علينا تأمين فوائد الحرية لأنفسنا ولذريتنا / الطَّبَقَاتُ الدُّنْيَا",
 "末松": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "末枯れる": "مَاتَ (للحَيّ: فقد الحَيَاة. مصدره مَوتَا ومِيتَة؛ للأرض: ليس فيها شيء حَيّ من النبات…)\nمثال: إعتقدت أنه مات. / صَعَقَ",
 "末柄": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "末梢": "طَرَف / تفاهة, شيء تافه (شيء قليل الأهمية)",
 "末梢性": "طَرَفِيّ, مُحِيطِيّ (على أو بالقرب من حافة أو يشكل حداً خارجياً؛ المنطقة الخارجية)\nمثال: المقاطعات الطرفية لروسيا",
 "末梢的": "تافِه",
 "末梢神経系": "الجهاز العصبي المحيطي (قسم الجهاز العصبي الذي يقع خارج الدماغ والحبل الشوكي)",
 "末次": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "末段": "النِهاية",
 "末永": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "末永い": "دَائِم",
 "末永く": "إِلَى الْأَبَد (حرف جر يُفيد الغاية الزمنية؛ حرف جر يُفيد الغاية المكانية)\nمثال: تعال إلى منزلي.",
 "末派": "فِرْقَة\nمثال: الوجودية مذهب إنساني.",
 "末流": "أحفاد, ذُرِّيَّة (كل نسل سلف معين)\nمثال: علينا تأمين فوائد الحرية لأنفسنا ولذريتنا",
 "末生り": "شَاحِب الوَجْه (ذو وجه شاحب)",
 "末端": "نِهَايَة, غَايَة\nمثال: انتهى أمر زيري. / الأفراد, الجنود العاديون (الأعضاء العاديون في منظمة (مثل الجنود المجندين في الجيش))\nمثال: تم دعم الإضراب من قبل أفراد النقابة",
 "末端価格": "سعر التجزئة (السعر الإجمالي المفروض على منتج يُباع للعميل، ويشمل تكلفة المصنع بالإضافة إلى…)",
 "末端小粒": "تيلومير, قسيم طرفي (أي من الطرفين (الحرين) لكروموسوم حقيقي النواة)",
 "末端巨大症": "ضخامة النهايات (تضخم عظام اليدين والقدمين والوجه؛ غالباً ما يكون مصحوباً بصداع وآلام في العضلات…)",
 "末端消費者": "مستخدم نهائي",
 "末端肥大症": "ضخامة النهايات (تضخم عظام اليدين والقدمين والوجه؛ غالباً ما يكون مصحوباً بصداع وآلام في العضلات…)",
 "末筆ながら": "أخيراً وليس آخراً",
 "末筆乍ら": "أخيراً وليس آخراً",
 "末節": "عَرَضِيّ, هَامِشِيّ (ليس ذا أهمية مركزية أو أوّلية)\nمثال: تخلصوا من جميع الأشياء غير الضرورية",
 "末葉": "نِهَايَة, غَايَة\nمثال: انتهى أمر زيري. / سَلِيل (صِفَة ثابتة للمفعول من الفعل سلَّ؛ يَنْحَدِرُ مِنْ نَسْلٍ شَرِيفٍ)",
 "末裔": "سَلِيل (صِفَة ثابتة للمفعول من الفعل سلَّ؛ يَنْحَدِرُ مِنْ نَسْلٍ شَرِيفٍ)",
 "末路": "يوم الحساب, يوم الدين (اليوم في نهاية الزمان الذي سيقضي فيه الله بمصير جميع البشر وفقاً لأعمالهم)",
 "末輩": "تابع, مرؤوس (مساعد خاضع لسلطة أو سيطرة آخر)",
 "末造": "يوم الحساب, يوم الدين (اليوم في نهاية الزمان الذي سيقضي فيه الله بمصير جميع البشر وفقاً لأعمالهم)",
 "末野": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "末長い": "دَائِم",
 "末長く": "إِلَى الْأَبَد (حرف جر يُفيد الغاية الزمنية؛ حرف جر يُفيد الغاية المكانية)\nمثال: تعال إلى منزلي.",
 "末頼もしい": "مُشْرِق, وَاعِد (من المرجح أن يسير على نحو جيد في المستقبل)",
 "末香": "بَخُور (البَخُور : ما يتبخَّر به من عُودٍ ونحوه؛ الدخان أو الرائحة الناتجة من احتراق…)",
 "本": "مَنْشَأ / قَاعِدَة, أَسَاس / قَضِيَّة (الأمر أو الشيء المُعَقَّد؛ في : ما يقضي فيه القاضي)\nمثال: سأرفع عليك قضية. / مَادِّيّ\nمثال: لا أحب مادة العلوم. / كِتَاب, سِفْر (موضع تعليم الكتابة. الاستخدام الأصلي؛ مدرسة شبه رسمية لتعليم الأطفال الكِتَابَة…)\nمثال: هذا الكتاب جديد / هَٰذَا, هَٰذِهِ / رَئِيسِيّ / حَقِيقِيّ",
 "本しゅす": "أَطْلَس",
 "本ちゃん": "أَدَاء / لَعْب, لَعْبَة (فعل شيئا للتسلية والترفيه، شَارَكَ في لعبة)\nمثال: لعب زيري التنس. / اِرْتِفَاع / اِخْتِرَاقْ (اختراق الرياح مرورها؛ اخترقت الخيل ما بين القرى والشجر:تخلّلتها)",
 "本に": "بالفعل, حقاً ((تستخدم كصيغة تعجب) تعبير عن الدهشة أو الشك أو السخرية وما إلى ذلك)\nمثال: يريد الزواج من رئيس الخدم؟ حقاً!",
 "本のムシ": "دودة كتب (شخص يقضي وقتاً طويلاً في القراءة)",
 "本の虫": "دودة كتب (شخص يقضي وقتاً طويلاً في القراءة)",
 "本ガス": "غاز المدينة (غاز فحم مصنع للاستخدام المنزلي والصناعي)",
 "本チャン": "أَدَاء / لَعْب, لَعْبَة (فعل شيئا للتسلية والترفيه، شَارَكَ في لعبة)\nمثال: لعب زيري التنس. / اِرْتِفَاع / اِخْتِرَاقْ (اختراق الرياح مرورها؛ اخترقت الخيل ما بين القرى والشجر:تخلّلتها)",
 "本丸": "نِوَاة",
 "本人確認": "التحقق من الهوية, القياسات الحيوية (التعرف التلقائي على الأفراد الأحياء باستخدام خصائصهم الفسيولوجية والسلوكية)",
 "本会": "جَلْسَة\nمثال: خضع زيد لدورة مكثفة",
 "本位": "مِعْيَارِيّ",
 "本位記号": "طَبِيعِيّ",
 "本位貨幣": "عملة قانونية, وسيلة دفع (شيء يمكن استخدامه كوسيلة رسمية للدفع)",
 "本体": "مَادَّة (مؤنث مَادّ، اسم فاعل من مَدَّ. الجمع مَادَّات؛ ما كان مَدَدًا لغيره)\nمثال: لا أحب مادة العلوم. / بَدَن, جِسْم ((بَدُنَ) الرَّجُلُ مِنْ بَابِ ظَرُفَ وَ (بُدْنًا) أَيْضًا بِوَزْنِ قُفْلٍ أَيْ…) / نُومِينُون",
 "本体論": "أُنْطُولُوجِيَّا, عِلْم الْوُجُود",
 "本体部": "عُضْو (جُزْء من الجَسَد؛ مُشْتَرِك فِي جَمْعِيَّة أو شَرِكَة أو حِزْب أو نَادٍ)\nمثال: اذكر كل عضو باسمه.",
 "本体部暗号化表示": "عُضْو (جُزْء من الجَسَد؛ مُشْتَرِك فِي جَمْعِيَّة أو شَرِكَة أو حِزْب أو نَادٍ)\nمثال: اذكر كل عضو باسمه.",
 "本元": "مَنْشَأ",
 "本分": "وَاجِب, وَظِيفَة (اسم لما يُوجَبُ فعله؛ اسم لما صار حدوثه أكيد)",
 "本初": "بِدَايَة (في بِدَايَة الأمْرِ كانَ مُهَذَّباً : فِي أوّلِهِ؛ البِدَايَة والنِّهاية:…)\nمثال: هذه بداية جيدة.",
 "本初子午線": "خَطّ الزَّوَال, خَطّ الطُّول الرَّئِيسِيّ (كِتَابَة؛ ما يَصِل نقطتين أو أكثر)\nمثال: إرسم خط مستقيم.",
 "本券": "سهم, شهادة سهم (شهادة توثق ملكية المساهم في الشركة)\nمثال: تضاعفت قيمة أسهمه خلال العام الماضي",
 "本則": "قَانُون, قَاعِدَة (مقياس كل شيء وطريقه؛ أمر كليّ ينطبق على جميع جزئياته التي تعرف أحكامها منه)\nمثال: ذكرني بالقانون.",
 "本務": "وَاجِب, وَظِيفَة (اسم لما يُوجَبُ فعله؛ اسم لما صار حدوثه أكيد)\nمثال: لا شكر على واجب.",
 "本卦帰り": "خرف, هرم (الضعف العقلي نتيجة لكبر السن)",
 "本卦還り": "خرف, هرم (الضعف العقلي نتيجة لكبر السن)",
 "本命": "مَحْبُوب, مُفَضَّل (يروق لعامة الناس ويستهويهم)\nمثال: هذا الكتاب هو أحد مفضلاتي",
 "本営": "الْقِيَادَة الْعَامَّة",
 "本因坊": "أستاذ كبير (لاعب ذو مهارة استثنائية أو عالمية في الشطرنج أو البريدج)",
 "本国": "وَطَن, مَوْطِن (أقام بالمكان وكان وَطَنا له)\nمثال: دعاها لحفلة العودة للوطن.",
 "本国人": "أَصْلِيّ",
 "本土": "يَابِسَة, بَرّ",
 "本城": "حِصْن (ما يُتَحَصَّنُ به ويُمْنَع؛ كل مكان محميّ مُحرَز لا يُوصَل إليه؛ عن ما…)\nمثال: كان هناك حصن على تلك الهضبة في يوم من الأيام.",
 "本堂": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "本場": "وَطَن (أقام بالمكان وكان وَطَنا له)\nمثال: دعاها لحفلة العودة للوطن. / مسقط الرأس, منشأ (المكان الذي نشأ فيه شيء ما أو تمت رعايته في بداية وجوده)\nمثال: مهد الحضارة",
 "本場風": "أَصِيل, مَوْثُوق (غير مُزيَّف أو منسوخ؛ حقيقي لا شك فيه)",
 "本塁": "قَاعِدَة / مركز قيادة, مقر رئيسي ((عادة بصيغة الجمع) المكتب الذي يعمل كمركز إداري لمؤسسة ما)\nمثال: لدى العديد من الشركات مقراتها الرئيسية في نيويورك",
 "本塁打": "إصابة الهدف, نجاح تام (شيء ينجح تماماً في تحقيق هدفه)\nمثال: كانت الحملة الإعلانية الجديدة نجاحاً تاماً",
 "本塁打王": "إصابة الهدف, نجاح تام (شيء ينجح تماماً في تحقيق هدفه)\nمثال: كانت الحملة الإعلانية الجديدة نجاحاً تاماً",
 "本多": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "本契約": "عَقْد, مُعَاهَدَة (العَشْر من السَنَوَات؛ الاتِّفَاق والعَهْد بين طرفين)\nمثال: أمضى زيري العقد.",
 "本好き": "محب للكتب, مولع بالكتب (شخص يحب الكتب (ويجمعها عادة))",
 "本字": "كَانْجِي, طَابِع يَابَانِيّ ((حرفيا) (الـ)حروف (الـ)صينية؛ نظام كتابة اللغة اليابانية باستخدام الأحرف الصينية)\nمثال: علمني بعض الكانجي من فضلك. / حَرْف صِينِيّ, طَابِع صِينِيّ (طَرَف وَجَانِب وَحَدّ؛ رَمْز مخطوط أو مطبوع يقوم مقام صوت أو كلمة أو عبارة أو…)\nمثال: ألف هو الحرف الأول للألف باء.",
 "本官": "أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك…)\nمثال: لم تقصد أي أذى.",
 "本家": "مُؤَسِّس, مُؤَسِّسَة",
 "本家本元": "مَكَان الْمِيلَاد, مَسْقَط الرَّأْس (مَوْضِع؛ المنزلة والشأن، يقال أيضا مكانة)\nمثال: هذا المكان مقدس",
 "本審査": "فحص تحري, فرز (اختبار الأشياء أو الأشخاص لتحديد أولئك الذين لديهم خصائص معينة)\nمثال: أخفى الغطاء بنادقهم عن طائرات العدو",
 "本尊": "صَنَم, وَثَن (الصَّنَم: نَحْتٌ من خَشَبٍ ويُصَاغُ من نُحاسٍ، وغيره يُصنع لعبادته. ويُسمى…)",
 "本局": "مركز قيادة, مقر رئيسي ((عادة بصيغة الجمع) المكتب الذي يعمل كمركز إداري لمؤسسة ما)\nمثال: لدى العديد من الشركات مقراتها الرئيسية في نيويورك",
 "本屋": "متجر كتب, مكتبة (متجر تباع فيه الكتب) / دَار نَشْر, نَاشِر (المحل يجمع البِنَاء والعَرَصَة. قيل سمي كذلك لدوران الناس به وعليه وحوله. يجمع…)\nمثال: إذهب إلى الدار.",
 "本屋敷": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "本山": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…) / اسم مكان (الاسم الذي يُعرف به مكان جغرافي)",
 "本川": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "本州": "هُونْشُو",
 "本庄": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "本店": "مركز قيادة, مقر رئيسي ((عادة بصيغة الجمع) المكتب الذي يعمل كمركز إداري لمؤسسة ما)\nمثال: لدى العديد من الشركات مقراتها الرئيسية في نيويورك",
 "本式": "رَسْمِيّ, صُورِيّ (منسوب للسُّلْطَة أو الحُكُومَة أو الدَّوْلَة أو القَانُون؛ مُلَائِم للمَعَايِير)\nمثال: لقد انتهى الدرس بشكل رسمي. / بجدية (بطريقة جادة)\nمثال: تحدث بجدية مع ابنه",
 "本当": "حَقِيقَة (الحَقّ، نقيض البَاطِل؛ نقيض المَجَاز)\nمثال: هي صديقة حقيقة. / سَلِيم, صَحِيح (ملائم لحالة أو غرض أو مناسبة أو لطبيعة الشخص واحتياجاته)\nمثال: علاج طبي مناسب / أَصْلِيّ",
 "本当に": "حَقًّا (حَقَا (حقاه) حقوا: أصاب حقوه، يقال ضربه فحقاه؛ (حَقَا)الشيء فلانا: بلغ حقوه…)\nمثال: هو اغضبني حقا .",
 "本当のところ": "بصدق, حقاً (في الواقع (تستخدم للتوكيد أو تعديل الجملة))\nمثال: في الحقيقة، عجل الانحلال الأخلاقي بسقوط الإمبراطورية الرومانية / حَقِيقَة (الحَقّ، نقيض البَاطِل؛ نقيض المَجَاز)\nمثال: هي صديقة حقيقة.",
 "本当の所": "بصدق, حقاً (في الواقع (تستخدم للتوكيد أو تعديل الجملة))\nمثال: في الحقيقة، عجل الانحلال الأخلاقي بسقوط الإمبراطورية الرومانية / حَقِيقَة (الحَقّ، نقيض البَاطِل؛ نقيض المَجَاز)\nمثال: هي صديقة حقيقة.",
 "本影": "منطقة الظل التام (منطقة من الظل الكامل ناتجة عن الانسداد الكلي للضوء)",
 "本意ない": "مُتَرَدِّد, مُحْجِم (غير متحمّس؛ يتردّد في الإقدام) / غَيْر مُبَشِّر, مَشْؤُوم (غير مبشر؛ ينذر بالسوء)\nمثال: تحول مؤسف للأحداث",
 "本意無い": "مُتَرَدِّد, مُحْجِم (غير متحمّس؛ يتردّد في الإقدام) / غَيْر مُبَشِّر, مَشْؤُوم (غير مبشر؛ ينذر بالسوء)\nمثال: تحول مؤسف للأحداث",
 "本態性振戦": "رعاش مجهول السبب (رعاش غير معروف السبب (عادة في اليدين والرأس) يتطور لدى كبار السن؛ غالباً ما…)",
 "本態性高血圧": "ارتفاع ضغط الدم الأساسي, فرط ضغط الدم الأولي (ارتفاع مستمر ومرضي في ضغط الدم لا يمكن العثور على سبب محدد له)",
 "本所": "مركز قيادة, مقر رئيسي ((عادة بصيغة الجمع) المكتب الذي يعمل كمركز إداري لمؤسسة ما)\nمثال: لدى العديد من الشركات مقراتها الرئيسية في نيويورك",
 "本手": "ورقة حكم, ورقة رابحة (ورقة لعب من النقش الذي تم إعلانه كحكم)\nمثال: آس الحكم هو فائز مؤكد / خَبِير, مَاهِر (الخَابِر الذي يعرف خَبَر الشيء؛ المُخْتَصّ بالشيء ويعرف كل شيء عنه)\nمثال: درب على يد خبير.",
 "本拠": "حِصْن (ما يُتَحَصَّنُ به ويُمْنَع؛ كل مكان محميّ مُحرَز لا يُوصَل إليه؛ عن ما…)\nمثال: كان هناك حصن على تلك الهضبة في يوم من الأيام.",
 "本拠地": "حِصْن (ما يُتَحَصَّنُ به ويُمْنَع؛ كل مكان محميّ مُحرَز لا يُوصَل إليه؛ عن ما…)\nمثال: كان هناك حصن على تلك الهضبة في يوم من الأيام.",
 "本数": "عَدَد, نمرة (مِقْدَار مَا يُعَدّ)\nمثال: كم عدد سكان الجزائر؟",
