 "フォトリソグラフィー": "طباعة حجرية ضوئية, فوتو ليثوغرافيا (عملية طباعة مستوية تستخدم ألواحاً مصنوعة من صورة فوتوغرافية)",
 "フォトン": "فُوتُون",
 "フォト・アルバム": "أَلْبُوم صُوَر (كتاب صفحاته من الجيوب الشَّفافة لحفظ الصّور، والطوابع، والتوقيعات والنقود ونحوها؛ مجموعة من التسجيلات الصوتية التي أُصدرت كمجموعة على قرص مضغوط، أو قرص فونوغراف، أو شريط صوتي، أو أي وسيط آخر، كالتوزيع الرقمي)\nمثال: أحب هذا الألبوم.",
 "フォト用紙": "ورق تصوير (ورق حساس للضوء يمكن طباعة صورة فوتوغرافية عليه)",
 "フォニックス": "صوتيات (تعليم القراءة بتدريب المبتدئين على ربط الحروف بأصواتها)",
 "フォニー": "بَهْرَج, خَرَّاص / مُتَصَنِّع / مُتَصَنِّع, مُنَافِق",
 "フォニーム": "فُونِيم, صَوْت لُغَوِيّ",
 "フォネティックス": "صَوْتِيَات",
 "フォネーム": "فُونِيم, صَوْت لُغَوِيّ",
 "フォノグラフ": "فونوغراف, مشغل أسطوانات (آلة تتسبب فيها الأسطوانات الدوارة في اهتزاز إبرة ويتم تضخيم الاهتزازات صوتياً أو إلكترونياً)",
 "フォノグラム": "رمز صوتي, فونوغرام (أي رمز مكتوب يمثل صوتاً أو مقطعاً لفظياً أو مورفيماً أو كلمة)",
 "フォノロジー": "فُونُولُوجِيَّا, عِلْمُ ٱلْأَصْوَاتِ ٱللُّغَوِيَّةِ",
 "フォブ": "سلسلة الساعة (سلسلة قصيرة أو شريط يربط ساعة الجيب بصدرية الرجل) / دلاية الساعة, سلسلة الساعة (زينة تتدلى من سلسلة الساعة) / جيب ساعة (جيب في الصدرية مخصص لحمل ساعة الجيب)",
 "フォブポケット": "جيب ساعة (جيب في الصدرية مخصص لحمل ساعة الجيب)",
 "フォブ・ポケット": "جيب ساعة (جيب في الصدرية مخصص لحمل ساعة الجيب)",
 "フォボス": "فوبوس",
 "フォリオ": "فوليو, كتاب من القطع الكبير (كتاب (أو مخطوطة) يتكون من أوراق كبيرة مطوية في المنتصف لتكوين ورقتين أو أربع صفحات) / صحيفة, ورقة (ورقة من أي مادة مكتوبة أو مطبوعة (خاصة في مخطوطة أو كتاب)) / تَرْقِيم, تَرْقِيم الصَّفَحَات (نظام ترقيم الصفحات)\nمثال: الفوليو الأول لمسرحيات شكسبير",
 "フォリナー": "أَجْنَبِيّ, أَجْنَبِيَّة",
 "フォリン": "أَجْنَبِيّ / غَرِيب, أَجْنَبِيّ",
 "フォリント": "فُورِنْت",
 "フォリー": "حماقة, طيش (سلوك أحمق أو لا معنى له) / حماقة, غباء (خطأ سخيف) / حماقة (سمة التصرف بغباء أو تهور) / جنون, حماقة (صفة التهور والحماقة)\nمثال: محاولة القيادة خلال عاصفة ثلجية هي قمة الحماقة",
 "フォルアウト": "أثر جانبي, تداعيات (أي تأثير ثانوي ضار وغير مرغوب فيه) / سقط نووي, غبار ذري (الجسيمات المشعة التي تستقر على الأرض بعد انفجار نووي)\nمثال: استراتيجية لاحتواء تداعيات فضيحة المحاسبة",
 "フォルクスワーゲン": "فولكس واجن",
 "フォルクローレ": "أمريكي جنوبي (متعلق بقارة أمريكا الجنوبية أو دولها أو شعوبها أو مميز لها) / أمريكي جنوبي (مواطن أو ساكن في أمريكا الجنوبية) / مُوسِيقَى فُلْكْلُورِيَّة (مُوسِيقى، فنُّ تأليف الألحان وتوزيعها وإيقاعها والغناء والتطريب بضروب المعازف؛ علم الموسيقى : علمٌ يُبحَثُ فيه عن أُصَول النغم من حيث تأَتلف أَو تتنافر، وأَحوال الأَزمنة المتخللة بينها، ليُعلَمَ كيف يؤلَّف اللَّحْن)\nمثال: أتعلم الموسيقى.",
 "フォルス": "زَائِف, بَاطِل / كَاذِب",
 "フォルダ": "مِلَفّ, مُجَلَّد / مُجَلَّد",
 "フォルダー": "مِلَفّ, مُجَلَّد / مُجَلَّد",
 "フォルテ": "بصوت عالٍ, بقوة (توجيه في الموسيقى؛ للعزف بقوة وصوت عالٍ نسبي) / فورتي, قوي ((تستخدم بشكل رئيسي كتوجيه أو وصف في الموسيقى) تشير إلى أن المقطع المذكور يجب أن يعزف بصوت عالٍ) / الجزء القوي (الجزء الأقوى من نصل السيف بين المقبض والجزء الضعيف) / تَخَصُّص, مَوْطِن قُوَّة (ميزة ذات قيمة أو فائدة خاصة)\nمثال: مقاطع الفورتي (القوية) في المقطوعة",
 "フォルティシモ": "بصوت عالٍ جداً, فورتيسيمو (توجيه في الموسيقى؛ للعزف بقوة شديدة) / فُورْتِيسِيمُو ((بشكل رئيسي توجيه أو وصف في الموسيقى) عالٍ وقوي جداً) / بشدة بالغة, فورتيسيمو (تأليف موسيقي أو مقطع يُؤدى بصوت عالٍ جداً)",
 "フォルティッシモ": "بصوت عالٍ جداً, فورتيسيمو (توجيه في الموسيقى؛ للعزف بقوة شديدة) / فُورْتِيسِيمُو ((بشكل رئيسي توجيه أو وصف في الموسيقى) عالٍ وقوي جداً) / بشدة بالغة, فورتيسيمو (تأليف موسيقي أو مقطع يُؤدى بصوت عالٍ جداً)",
 "フォルティッスィモ": "بصوت عالٍ جداً, فورتيسيمو (توجيه في الموسيقى؛ للعزف بقوة شديدة) / فُورْتِيسِيمُو ((بشكل رئيسي توجيه أو وصف في الموسيقى) عالٍ وقوي جداً) / بشدة بالغة, فورتيسيمو (تأليف موسيقي أو مقطع يُؤدى بصوت عالٍ جداً)",
 "フォルト": "خَطَأ (تعني ضدّ الصواب. يشمل ذلك الفعل، القول، والرأي. يُستخدم الفعل \"أخطأ\" للدلالة على عدم الإصابة…؛ قام بعمل بعيد عن الصواب أو مخالف للحق سواء كان ذلك في السلوك أو القول أو الكتابة) / صَدْع, فَالِق ((صَدَعَ) النباتُ الأرضَ يَصْدَعَ صَدْعًا: شَقَّها وظَهَرَ منها؛ (صَدَعَ) الزجاجَ ونحوه: كسره)\nمثال: كان خطأ حاسوبي.",
 "フォルマッジ": "جُبْن, جبنة (جَبَنَ يَجْبُن وجَبُنَ جُبْنًا وجُبُنًا وجَبانةً)\nمثال: قل جبنة يا زيري.",
 "フォルマッジオ": "جُبْن, جبنة (جَبَنَ يَجْبُن وجَبُنَ جُبْنًا وجُبُنًا وجَبانةً)\nمثال: قل جبنة يا زيري.",
 "フォルマリスム": "شكلية (ممارسة الالتزام الدقيق بالأشكال المقررة أو الخارجية) / شكلانية (المذهب القائل بأن الهيكل الرسمي بدلاً من المحتوى هو ما يجب تمثيله) / شكلانية ((فلسفة) النظرية الفلسفية القائلة بأن البيانات الرسمية (المنطقية أو الرياضية) ليس لها معنى ولكن رموزها (التي تعتبر كيانات مادية) تظهر شكلاً له تطبيقات…)",
 "フォルマリズム": "شكلية (ممارسة الالتزام الدقيق بالأشكال المقررة أو الخارجية) / شكلانية (المذهب القائل بأن الهيكل الرسمي بدلاً من المحتوى هو ما يجب تمثيله) / شكلانية ((فلسفة) النظرية الفلسفية القائلة بأن البيانات الرسمية (المنطقية أو الرياضية) ليس لها معنى ولكن رموزها (التي تعتبر كيانات مادية) تظهر شكلاً له تطبيقات…)",
 "フォルマリン": "فورمالين (محلول 10% من الفورمالديهايد في الماء؛ يستخدم كمطهر أو لحفظ العينات البيولوجية)",
 "フォルム": "مُنْتَدَى (مَجْلِس؛ موقع إنترنت ينشر فيه المستخدمون مواضيعا ويردون عليها. (إنترنت))\nمثال: أساهم في هذا المنتدى كل يوم. / صُورَة, شَكْل / اِسْتِمَارَة / شَكَّلَ ((شَكَلَ) الأمْرُ يَشْكُلُ شُكُولاً: الْتَبَسَ؛ (شَكَلَ) المريضُ: تماثَلَ)\nمثال: اجلس بشكل مريح.",
 "フォルムアルデヒド": "فورمالديهايد, ميثانال (غاز سام عديم اللون؛ يصنع عن طريق أكسدة الميثانول)",
 "フォレスト": "غَابَة, غابة (الغَابَةُ: الأَجَمَةُ ذاتُ الشَّجَرِ المُتَكَاثِف؛ لأَنَّها تُغَيِّبُ مَا فِيهَا. أو الأَجَمَةُ الَّتِي طالتْ، وَلَهَا أَطْراف مُرْتَفِعَةٌ باسِقَة؛ الغابةُ أَجَمة القَصَب، قَالَ: وَقَدْ جُعِلَتْ جماعةَ الشَّجَرِ، لأَنه مأْخوذ مِنَ الغَيابةِ)\nمثال: مشينا في الغابة",
 "フォレンシック": "جِنائِيّ",
 "フォレンジック": "جِنائِيّ",
 "フォロミ": "فحص لاحق, متابعة (فحص لاحق للمريض لغرض مراقبة العلاج السابق) / متابعة (نشاط يواصل شيئاً قد بدأ بالفعل أو يكرر شيئاً تم القيام به بالفعل) / عمل لاحق, متابعة (قطعة عمل تستغل أو تبني على عمل سابق)\nمثال: برنامجه الجديد هو متابعة للبرامج التي بدؤوا بها",
 "フォロワー": "تَابِع / مُتَابِع",
 "フォロー": "تَبِعَ, اِتَّبَعَ (تبِع الشيءَ: سار في إثرِه، تلاه؛ تبِعه تبَعًا: مرَّ به فمضى معه) / اِتَّبَعَ (تَكَلَّفَ وبذل الجُهْد في أن يَتْبَع) / تَابَعَ, تَتَبَّعَ / تَابَعَ\nمثال: تبع المشتبه محققان. / تَالٍ, التَّالِي ((تَالَ): عالَجَ التِّوَلةَ: (السِّحْر)؛ (تَالَ) بِه: دُهِيَ ومُنِيَ) / بَعْد (يدل على اللحاق في الزمان؛ يكون مضافا، وينصب أو يجر)\nمثال: و بعد قليل أتى. / فحص لاحق, متابعة (فحص لاحق للمريض لغرض مراقبة العلاج السابق) / متابعة (نشاط يواصل شيئاً قد بدأ بالفعل أو يكرر شيئاً تم القيام به بالفعل) / عمل لاحق, متابعة (قطعة عمل تستغل أو تبني على عمل سابق)\nمثال: برنامجه الجديد هو متابعة للبرامج التي بدؤوا بها / دَعَمَ, دَعَّمَ (• دَعَمَهُ، كمنَعهُ: مالَ فأقامَهُ) / أَيَّدَ, دَعَمَ ((أَيَّدَه): قوّاه بالإياد) / تَأْيِيد, دَعْم\nمثال: ياني هنا لدعم ريمة.",
