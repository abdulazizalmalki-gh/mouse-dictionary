 "ブクブク": "محدب, ناتئ (منحنٍ أو بارز إلى الخارج) / مُحَدَّب, مُنْتَفِخ (منحنٍ نحو الخارج؛ ذو شكل بصلي بارز) / فَوَّار, مُتَأَلِّق (يتميّز بروح عالية أو حماسة متّقدة) / رَغْوِيّ, فَقَّاعِيّ (يُصدر فقاعات أو مليء بها كما في المشروبات الغازيّة أو التخمير)",
 "ブクマ": "علامة قراءة, فاصل كتب (علامة (قطعة من الورق أو شريط) توضع بين صفحات الكتاب لتحديد مكان القراءة)",
 "ブクレシュチ": "بُوخَارِسْت",
 "ブクレシュティ": "بُوخَارِسْت",
 "ブケー": "شَذًى, شَذًا",
 "ブサイク": "أَخْرَق / قَبِيح, بَشِع (ضد الحَسَن، وهو ما نَفَرَ منه الذوق السليم ويشمل القول والفعل والصورة؛ القَبَاح)\nمثال: نادتني بالقبيح.",
 "ブサヨ": "الجناح اليساري, اليسار (أولئك الذين يدعمون درجات متفاوتة من التغيير الاجتماعي أو السياسي أو الاقتصادي المصمم لتعزيز الرفاهية العامة)",
 "ブザー": "طَنَّان",
 "ブシュカン": "يد بوذا (فاكهة كبيرة تشبه الليمون مقسمة إلى أقسام تشبه الأصابع؛ معظم الأصناف لا تحتوي على لب أو عصير)",
 "ブジュンブラ": "بُوجُمْبُورَا",
 "ブジー": "مِسْبَار",
 "ブス": "قَبِيح, بَشِع (ضد الحَسَن، وهو ما نَفَرَ منه الذوق السليم ويشمل القول والفعل والصورة؛ القَبَاح)\nمثال: نادتني بالقبيح.",
 "ブスくれる": "بوز, حرد (مزاج أو إظهار للترفع العبوس أو الانسحاب)\nمثال: بقي في المنزل في حالة حرد",
 "ブスっと": "بِتَجَهُّم, بِعُبُوس (بطريقة عابسة)\nمثال: جلس على كرسيه بتجهم",
 "ブスッと": "بِتَجَهُّم, بِعُبُوس (بطريقة عابسة)\nمثال: جلس على كرسيه بتجهم",
 "ブスブス": "تطاير, طرطشة (ضجيج شيء يتناثر أو يطرطش بشكل انفجاري)\nمثال: سمع طرطشة نيران",
 "ブタ": "خِنْزِير / حَلُوف / خنزير / حلوف / خَنْزير / لَحْم الْخِنْزِير (ما يبقى من جسم الحيوان أو الإنسان بعد إزالة الجلد الأحشاء والعظم والشحم والدم والأعصاب. يتكون أساسا من العَضَلَات؛ ما يؤكل من لحم من الحيوان والطير والسمك عامة)\nمثال: أفضل لحم البقر. / بدين, سمين (شخص مستدير الجسم)",
 "ブタイモ": "أرضي شوكي قدسي, خرشوف قدسي (درنة دوار الشمس تؤكل نيئة أو مسلوقة أو مقطعة إلى شرائح رقيقة ومقلية) / أرضي شوكي, خرشوف القدس (نبات معمر طويل بسيقان وأوراق مشعرة؛ يزرع على نطاق واسع لدرناته الكبيرة غير المنتظمة الصالحة للأكل) / خرشوف القدس, طرطوفة (درنة صالحة للأكل لخرشوف القدس)",
 "ブタクサ": "أمبروزية, دمسيسة (أي من العديد من النباتات الضارة في أمريكا الشمالية التي تشكل جنس الأمبروزية والتي تنتج حبوب لقاح مسببة للحساسية الشديدة المسؤولة عن الكثير من حمى…) / شيخة متكاملة الأوراق, شيخة يعقوبية (عشب ضار أوروبي واسع الانتشار له أزهار صفراء تشبه الأقحوان؛ أحياناً يكون عشباً ضاراً بغيضاً وساماً للماشية إذا استهلك بكميات كبيرة)",
 "ブタジエン": "بوتادين",
 "ブタジエンゴム": "بروم (عنصر سائل لافلزي ثقيل متطاير ذو لون بني داكن ينتمي للهالوجينات؛ يوجد في مياه البحر)",
 "ブタジエン・ゴム": "بروم (عنصر سائل لافلزي ثقيل متطاير ذو لون بني داكن ينتمي للهالوجينات؛ يوجد في مياه البحر)",
 "ブタナ": "أذن القط, هندباء خنزيرية (عشب ضار أوروبي مستوطن على نطاق واسع في أمريكا الشمالية له رؤوس زهرية صفراء وأوراق تشبه أذن القط) / أذن القط (أي من النباتات العديدة من جنس كالوشورتوس ذات أزهار ببتلات على شكل آذان القطط)",
 "ブタノール": "بيوتانول, كحول البيوتيل (كحول قابل للاشتعال مشتق من البيوتان ويستخدم للمذيبات)",
 "ブタバナコウモリ": "الْعَالَم الْقَدِيم",
 "ブタペスト": "بُدَابِسْت, بُودَابِسْت",
 "ブタン": "بوتان (يوجد في الغاز الطبيعي؛ يستخدم في تصنيع المطاط والوقود)",
 "ブタ箱": "إقفال, إيصاد (فعل قفل شيء ما لحمايته) / توقيف, حجز (سجن في مركز شرطة محلي)",
 "ブダペシュト": "بُدَابِسْت, بُودَابِسْت",
 "ブダペスト": "بُدَابِسْت, بُودَابِسْت",
 "ブチあげ": "ابتهاج, زهو (شعور بالفرح والفخر)",
 "ブチのめす": "أَرْضِيَّة, أَرْض (ما يقابل السَقْف من الغرفة؛ قاع الشيء) / طَابِق\nمثال: انهارت الأرضية. / هَرَسَ (سَحَقَ أو دَكَّ شيئًا بقوة حتى يتفتت؛ طَحَنَ أو فَتَّتَ شيئًا)",
 "ブチまける": "مَزْبَلَة, نُفَايَة (موضع تجميع الأَزْبَال والتِفَايَات لحين نقلها؛ حَاوِيَة نفايات؛ موضع خارج المدينة توضع فيه الأزبال والنفايات)\nمثال: وضع فاضل جثة دانية في مزبلة. / كَشَفَ (كشَّف الأمرَ بالغ في كشْفِه وتوضيحه؛ أزال الغطاء أو جعل الشيء مكشوفًا) / أَوْحَى, أَنْزَلَ (بمعنى وَحَى، أَشَارَ؛ ألهم، يستخدم في الخير والشر، من الله أو من غيره)\nمثال: كشف كارل المزيد.",
 "ブチる": "اِنْكَسَرَ (فعل مطاوعة لكَسَرَ، قام أحدهم بكَسْره أو قام هو بكَسْر نفسه؛ التاجر: خَسِرَ المال ونَقَصَ عنده المال، أفْلَسَ) / كَسَرَ / اِسْتِرَاحَة (مبنى خارج المدن يتوقف فيه المسافرون للراحة والتَزَوُّد يُجمع على اِسْتِرَاحَات)\nمثال: عليك أخذ استراحة.",
 "ブチアゲ": "ابتهاج, زهو (شعور بالفرح والفخر)",
 "ブチハイエナ": "ضبع ضاحك, ضبع مرقط (ضبع أفريقي يشتهر بعوائه المميز)",
 "ブチャ": "بُوتْشَا",
 "ブチル": "بوتيل",
 "ブチルアルコール": "بيوتانول, كحول البيوتيل (كحول قابل للاشتعال مشتق من البيوتان ويستخدم للمذيبات)",
 "ブチルゴム": "مطاط البوتيل (مطاط صناعي مصنوع عن طريق بلمرة الأيزوبيوتيلين)",
 "ブチル・アルコール": "بيوتانول, كحول البيوتيل (كحول قابل للاشتعال مشتق من البيوتان ويستخدم للمذيبات)",
 "ブチル・ゴム": "مطاط البوتيل (مطاط صناعي مصنوع عن طريق بلمرة الأيزوبيوتيلين)",
 "ブチレン": "بوتيلين, بوتين",
 "ブチ殺す": "قَتَلَ, قتل (تعمّد جعله يَمُوتُ، أزهق روحه، أمَاتَه متعمدا؛ الوقتَ: ضيعه بشيء غير ذي فائدة وهو ينتظر أمرا آخر) / قَتْلَة\nمثال: قتل الصياد دبا.",
 "ブッカー": "وكيل حجز (شخص يتعاقد مع شخص أو شركة لتقديم عروض)",
 "ブッキッシュ": "دَؤُوب, مُوَلَّعٌ بِالقِرَاءَة (يتّسم بالدراسة الجادّة والشغف بالمطالعة)",
 "ブッキング": "حَجْز (حجَزهُ: مَنَعَهُ)\nمثال: حجز مناد موعدا.",
 "ブッキー": "وكيل مراهنات (مقامر يقبل ويدفع الرهانات (خاصة في سباقات الخيل))",
 "ブック": "كِتَاب, سِفْر (موضع تعليم الكتابة. الاستخدام الأصلي؛ مدرسة شبه رسمية لتعليم الأطفال الكِتَابَة والقِرَاءَة ومباديء الحِسَاب وبعض القُرَآن…) / سِفْر (السَّفَرُ : قَطْعُ المسافة؛ هو مِنِّي سفَرٌ : بعيد) / سِجِل (كتاب أو صحيفة تُسَجَّلُ فيها الأمور؛ الكاتب الذي يحفظ تلك الصحيفة أو السِجِلّ) / سِجِلّ (كتاب أو صحيفة تُسَجَّلُ فيها الأمور؛ الكاتب الذي يحفظ تلك الصحيفة أو السِجِلّ) / حَجَزَ (حجَزهُ: مَنَعَهُ)\nمثال: هذا الكتاب جديد",
 "ブックエンド": "مسند كتب (دعامة توضع في نهاية صف من الكتب لإبقائها منتصبة (على رف أو طاولة))",
 "ブックカバー": "غلاف الكتاب الورقي (غلاف ورقي للكتاب؛ غلاف تطبع عليه عادة معلومات ترويجية)",
 "ブックキーピング": "مسك الدفاتر (نشاط تسجيل المعاملات التجارية)",
 "ブックケース": "مَكْتَبَة, خِزَانَةُ الْكُتُب",
 "ブックシェルフ": "رَفّ كُتُب, رَفُّ الْكُتُب (رَفَّتْ أَوْراقُ الشَّجَرِ: اِهْتَزَّتْ، تَحَرَّكَتْ؛ رَفَّتِ العَيْنُ: رَمَّشَتْ)\nمثال: وضع الكتاب على الرف.",
 "ブックストア": "متجر كتب, مكتبة (متجر تباع فيه الكتب)",
 "ブックマーカー": "علامة قراءة, فاصل كتب (علامة (قطعة من الورق أو شريط) توضع بين صفحات الكتاب لتحديد مكان القراءة)",
 "ブックマーク": "علامة قراءة, فاصل كتب (علامة (قطعة من الورق أو شريط) توضع بين صفحات الكتاب لتحديد مكان القراءة)",
 "ブックメーカー": "مُؤَلِّف, كَتَّاب / مُرَاهِن",
 "ブックモビル": "مكتبة متنقلة (شاحنة مغلقة بها أرفف كتب؛ تعمل كمكتبة متنقلة أو مكتبة لبيع الكتب)",
 "ブックモビール": "مكتبة متنقلة (شاحنة مغلقة بها أرفف كتب؛ تعمل كمكتبة متنقلة أو مكتبة لبيع الكتب)",
 "ブックモービル": "مكتبة متنقلة (شاحنة مغلقة بها أرفف كتب؛ تعمل كمكتبة متنقلة أو مكتبة لبيع الكتب)",
 "ブックレット": "كُتَيِّب, كُرَّاسَة (كِتَاب صَغِير؛ دَلِيل)",
 "ブックレビュー": "مراجعة كتاب (مراجعة نقدية لكتاب (عادة ما يكون كتاباً نُشر حديثاً))",
 "ブック・カバー": "غلاف الكتاب الورقي (غلاف ورقي للكتاب؛ غلاف تطبع عليه عادة معلومات ترويجية)",
 "ブック・レビュー": "مراجعة كتاب (مراجعة نقدية لكتاب (عادة ما يكون كتاباً نُشر حديثاً))",
 "ブッコミ": "خلط, خليط (عملية خلط الأشياء معاً)\nمثال: عجينة مصنوعة من خليط الدقيق والماء / ارتداء, لبس (فعل وضع شيء على الجسم كغطاء أو زينة) / مُتْعِب, مُرْهِق (يُسبّب الإنهاك والإعياء) / تعرية, نحت ((في الجيولوجيا) العملية الميكانيكية لتآكل أو طحن شيء ما (كما يحدث عند غسل الجسيمات له)، وتستخدم مجازياً أيضاً)\nمثال: اشترته للارتداء اليومي / سمك القاع (الأسماك التي تعيش في قاع البحر (خاصة أسماك القد المهمة تجارياً مثل القد والحدوق، أو الأسماك المفلطحة مثل الفلوندر))",
 "ブッコミ釣り": "سمك القاع (الأسماك التي تعيش في قاع البحر (خاصة أسماك القد المهمة تجارياً مثل القد والحدوق، أو الأسماك المفلطحة مثل الفلوندر))",
 "ブッサイク": "أَخْرَق / قَبِيح, بَشِع (ضد الحَسَن، وهو ما نَفَرَ منه الذوق السليم ويشمل القول والفعل والصورة؛ القَبَاح)\nمثال: نادتني بالقبيح.",
 "ブッシェル": "بوشل (مقياس جاف أمريكي يساوي 4 بيكات) / بوشل (مقياس سعة إمبراطوري بريطاني (سائل أو جاف) يساوي 4 بيكات)",
 "ブッシュ": "شُجَيْرَة, شَجَرَة / بطانة أسطوانية, جلبة (بطانة معدنية أسطوانية تستخدم لتقليل الاحتكاك) / بطانة, جلبة عازلة (بطانة عازلة في فتحة تمر من خلالها الموصلات)",
 "ブッシュカン": "يد بوذا (فاكهة كبيرة تشبه الليمون مقسمة إلى أقسام تشبه الأصابع؛ معظم الأصناف لا تحتوي على لب أو عصير)",
 "ブッシュドノエル": "جذع عيد الميلاد (جذع كبير يتم حرقه تقليدياً في عيد الميلاد)",
 "ブッシュバック": "بوشبوك, ظبي الشجيرات (ظبي بعلامات بيضاء تشبه السرج وقرون ملتوية)",
 "ブッシュベビー": "جلاجو, طفل الأدغال (ليمور أفريقي ليلي رشيق طويل الذيل ذو فرو صوفي كثيف وعيون وآذان كبيرة)",
 "ブッシュマン": "بوشمن, خويسان (صيادون وجامعو ثمار رحل يعيشون في جنوب أفريقيا) / ساكن الأحراش (ساكن ذكر في مناطق الأحراش الأسترالية)",
 "ブッシュ・ド・ノエル": "جذع عيد الميلاد (جذع كبير يتم حرقه تقليدياً في عيد الميلاد)",
 "ブッシュ・ベビー": "جلاجو, طفل الأدغال (ليمور أفريقي ليلي رشيق طويل الذيل ذو فرو صوفي كثيف وعيون وآذان كبيرة)",
 "ブッシング": "بطانة أسطوانية, جلبة (بطانة معدنية أسطوانية تستخدم لتقليل الاحتكاك) / بطانة, جلبة عازلة (بطانة عازلة في فتحة تمر من خلالها الموصلات)",
 "ブッソウゲ": "كركديه صيني, ورد صيني (شجيرة آسيوية كبيرة مبهرجة أو شجرة صغيرة ذات زهور حمراء إلى حمراء داكنة كبيرة مفردة أو مزدوجة)",
 "ブッダ": "بُوذَا, بُدّ",
 "ブッチ": "إغفال, حذف (خطأ ناتج عن الإهمال) / قفز خفيف, وثب (مشية تتبادل فيها الخطوات والقفزات) / اِنْكَسَرَ (فعل مطاوعة لكَسَرَ، قام أحدهم بكَسْره أو قام هو بكَسْر نفسه؛ التاجر: خَسِرَ المال ونَقَصَ عنده المال، أفْلَسَ) / كَسَرَ / اِسْتِرَاحَة (مبنى خارج المدن يتوقف فيه المسافرون للراحة والتَزَوُّد يُجمع على اِسْتِرَاحَات)\nمثال: عليك أخذ استراحة.",
 "ブッチャー": "جَزَّار, قَصَّاب / جَزَّار / جَزَر (جَزَرَ الماءُ عن الأَرضِ يَجْزُرُ جَزْراً: نَضَبَ وحَسَرَ؛ ويقال: جَزَرَ البَحْرُ والنَّهْرُ: انْحسرَ ماؤُهُ) / جَزَر, نَحَر (جَزَرَ الماءُ عن الأَرضِ يَجْزُرُ جَزْراً: نَضَبَ وحَسَرَ؛ ويقال: جَزَرَ البَحْرُ والنَّهْرُ: انْحسرَ ماؤُهُ)\nمثال: ضع الجزر في القدر.",
 "ブッツリ": "طَاعِن, لَاذِع (مؤلم كما لو كان ناتجاً عن أداة حادّة) / جارِح, طاعِن (يُسَبِّب جِراحًا أو ألَمًا حادًّا)",
 "ブッディスト": "بُوذِيّ (مِن، أو متعلق بالديانة البوذية؛ أحد أتباع الديانة البوذية وتعليمات مؤسسها وشخصيتها الرئيسية غواتاما بوذا)",
 "ブッドレア": "بودليا, شجيرة الفراشة (شجيرة استوائية ذات عناقيد من الزهور البيضاء أو البنفسجية أو الصفراء)",
 "ブッフェ": "بُوفِيه",
 "ブッポウソウ": "كرة متدحرجة (كرة أرضية تتدحرج على طول الملعب الداخلي) / حمام قلاب (حمامة تقوم بشقلبات خلفية أثناء الطيران أو على الأرض) / شقراق (طائر من العالم القديم يتقلب أو يتدحرج في الطيران؛ مرتبط بالرفراف) / لفافة شعر, مجعد شعر (جهاز ميكانيكي يتكون من أنبوب أسطواني يُلف حوله الشعر لتجعيده)\nمثال: امرأة رأسها مليء بلفافات الشعر ليست منظراً جميلاً",
 "ブッラータ": "بُورَّاتَا, بُرَّاتَا",
 "ブツ": "جَرْد, خَزِين (جَرَدَ الشيءَ: أحصى ما فيه، ضبط قيمته؛ جَرَدَ البطاطسَ: قشّرها وأزال ما عليها) / مَخْزُون / مَرَقَة, حَسَاء (الطَعَام السائل الخفيف فيه ماء اللحم وقد يكون فيه خضار أو غير ذلك. يؤكل عادة مع الرز أو الخبز. يجوز قول مَرَق، والمَرَقَة أخص من المرَق) / مَنْثُور / قَنْدَاق\nمثال: كان سامي جرد طفل. / بَضَائِع, سِلَع",
