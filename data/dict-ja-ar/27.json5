 "フォッサ": "فوسا",
 "フォト": "صورة, صورة فوتوغرافية (تمثيل لشخص أو مشهد في شكل مطبوعة أو شريحة شفافة أو بتنسيق رقمي)",
 "フォトようし": "ورق تصوير (ورق حساس للضوء يمكن طباعة صورة فوتوغرافية عليه)",
 "フォトアルバム": "أَلْبُوم صُوَر (كتاب صفحاته من الجيوب الشَّفافة لحفظ الصّور، والطوابع، والتوقيعات والنقود ونحوها؛ مجموعة من التسجيلات الصوتية التي أُصدرت كمجموعة على قرص مضغوط، أو قرص فونوغراف، أو شريط صوتي، أو أي وسيط آخر، كالتوزيع الرقمي)\nمثال: أحب هذا الألبوم.",
 "フォトグラビア": "حفر ضوئي, روتوجرافور (استخدام التصوير الفوتوغرافي لإنتاج لوحة للطباعة) / حفر ضوئي, طباعة غائرة (مطبوعة غائرة يتم إنتاجها عن طريق الحفر) / حفر ضوئي, فوتوغرافيور (الطباعة من لوح غائر مُعد بطرق فوتوغرافية)",
 "フォトグラフ": "صُورَة, صُورَة شَمْسِيَّة / اِلْتَقَطَ صُورَة",
 "フォトグラファー": "مُصَوِّر, مُصَوِّرَة",
 "フォトグラフィ": "تَصْوِير, فُوتُوغْرَافِيَّا",
 "フォトグラフィー": "تَصْوِير, فُوتُوغْرَافِيَّا",
 "フォトコラージュ": "مونتاج صور (مونتاج يستخدم صوراً فوتوغرافية)",
 "フォトシンセシス": "تَمْثِيل ضَوْئِيّ / تَرْكِيب ضَوْئِيّ (اسم للشيء الذي يُرَّكبُ بالعادة)",
 "フォトジェ": "حَسَن المَظْهَر فِي الصُّوَر, فُوتُوجِينِيّ (يبدو جذاباً في الصور الفوتوغرافية)",
 "フォトジェニック": "حَسَن المَظْهَر فِي الصُّوَر, فُوتُوجِينِيّ (يبدو جذاباً في الصور الفوتوغرافية)",
 "フォトジェニー": "حَسَن المَظْهَر فِي الصُّوَر, فُوتُوجِينِيّ (يبدو جذاباً في الصور الفوتوغرافية)",
 "フォトジャーナリスト": "مصور صحفي (صحفي يقدم القصة بشكل أساسي من خلال استخدام الصور الفوتوغرافية)",
