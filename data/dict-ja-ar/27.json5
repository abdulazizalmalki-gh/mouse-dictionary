 "突っかかる": "تُهْمَة / اِتَّهَمَ / شَحَنَ (مَلَأَ الشيءَ أو حمله بكميات كبيرة؛ في : زوّد شيئًا بالطاقة الكهربائية أو الشحنة) / هَاجَمَ\nمثال: أقوم بشحن هاتفي / اِنْدَلَعَ",
 "突っかけ": "صَنْدَل (شجر طيب الرائحة يشبه شجر الجوز له ثمر يُحمل في عناقيد من حب أخضر، يستخدم غالبا لصنع العطور؛ من الحمير والجمال: ذو الرأس الضخمة)",
 "突っこみ": "تُهْمَة / اِتَّهَمَ / شَحَنَ (مَلَأَ الشيءَ أو حمله بكميات كبيرة؛ في : زوّد شيئًا بالطاقة الكهربائية أو الشحنة) / هَاجَمَ\nمثال: أقوم بشحن هاتفي / عَمْق / طعني / جِنْس (الجَمَاعَة أو المَجْمُوعَة الواحدة التي لها صفات تجعلها تنتمي إلى بعض تسمى جِنْسا وهو أعمُّ من النَوْع. ليس للجنس أو النوع ما يحددهما فالبشر كلهم جنس…؛ أحيانا يقصد به ذكر أم أنثى تحديدا) / جِمَاع, مُجَامَعَة (الموافقة والمساعدة في أي شيء كان؛ الشيء: جمعه)\nمثال: أنا مثلي الجنس.",
 "突っこむ": "أَشَارَ / طعني",
 "突っつく": "خَزَّ (\"خَزَّهُ بسكِّينٍ\" : طَعَنَهُ بِهِ؛ \"خَزَّهُ بِبَصَرِهِ\" : أَصَابَتْهُ عَيْنُه)\nمثال: إذا كنت وخز لنا، هل نحن لا ينزف؟",
 "突っぱねる": "رَفَضَ (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟",
 "突っ切る": "صَلِيب / عَبْر, خِلَال (الشيء: اجتازه وقطعه من طرف إلى الطرف الآخر كاملا؛ الشخص: مات) / عَبَرَ (الشيء: اجتازه وقطعه من طرف إلى الطرف الآخر كاملا؛ الشخص: مات)\nمثال: عبر جرذ الطريق.",
 "突っ張り": "سِنَاد, عِمَاد / دَعَمَ, عَمَدَ (• دَعَمَهُ، كمنَعهُ: مالَ فأقامَهُ)\nمثال: ياني هنا لدعم ريمة. / تَشَنُّج, شَدٌّ عَضَلِيّ / بَانْك",
 "突っ張る": "شَدَّ, ضَيَّقَ / ثَابَرَ / دَعَمَ, دَعَّمَ (• دَعَمَهُ، كمنَعهُ: مالَ فأقامَهُ) / أَيَّدَ, دَعَمَ ((أَيَّدَه): قوّاه بالإياد) / تَأْيِيد, دَعْم\nمثال: ياني هنا لدعم ريمة. / تَمَدَّدَ / مَدَّدَ, اِمْتَدَّ",
 "突っ慳貪": "كَلِيل",
 "突っ掛かる": "تُهْمَة / اِتَّهَمَ / شَحَنَ (مَلَأَ الشيءَ أو حمله بكميات كبيرة؛ في : زوّد شيئًا بالطاقة الكهربائية أو الشحنة) / هَاجَمَ\nمثال: أقوم بشحن هاتفي / اِنْدَلَعَ",
 "突っ掛け": "صَنْدَل (شجر طيب الرائحة يشبه شجر الجوز له ثمر يُحمل في عناقيد من حب أخضر، يستخدم غالبا لصنع العطور؛ من الحمير والجمال: ذو الرأس الضخمة)",
 "突っ支い": "سِنَاد, عِمَاد / دَعَمَ, عَمَدَ (• دَعَمَهُ، كمنَعهُ: مالَ فأقامَهُ)\nمثال: ياني هنا لدعم ريمة.",
 "突っ支い棒": "سِنَاد, عِمَاد / دَعَمَ, عَمَدَ (• دَعَمَهُ، كمنَعهُ: مالَ فأقامَهُ)\nمثال: ياني هنا لدعم ريمة.",
 "突っ突く": "خَزَّ (\"خَزَّهُ بسكِّينٍ\" : طَعَنَهُ بِهِ؛ \"خَزَّهُ بِبَصَرِهِ\" : أَصَابَتْهُ عَيْنُه)\nمثال: إذا كنت وخز لنا، هل نحن لا ينزف؟",
 "突っ立つ": "وَقَفَ, وقف (قَامَ، اِنْتَصَبَ، نَهَضَ؛ ثَبَتَ)\nمثال: وقف وراء الباب.",
 "突っ立てる": "طَعْن / طَعْنَة / طَعَنَ / نَبَات (مصدر للفعل نَبَتَ؛ اسم جنس شامل لكل ما تنبته الأرض من شجر أو بقل أو عشب أو غيره) / زَرَعَ, غَرَسَ (بَذَرَ الحَبَّ؛ أَنْبَتَ، نَمَّى)\nمثال: هذا النبات مهدد بالانقراض.",
 "突っ走る": "سُرْعَة\nمثال: 違反のスピードを出して、突っ走っていた車がブレーキをかけたが、空回りして、運転手があっというまもなく、トラックの背後に、もろにぶつかった。 — تزحلقت العربة المسرعة و اصطدمت مقدمة العربة ب مؤخرة الشاحنة بشكل مفاجئ جداً .",
 "突っ込み": "تُهْمَة / اِتَّهَمَ / شَحَنَ (مَلَأَ الشيءَ أو حمله بكميات كبيرة؛ في : زوّد شيئًا بالطاقة الكهربائية أو الشحنة) / هَاجَمَ\nمثال: أقوم بشحن هاتفي / عَمْق / طعني / جِنْس (الجَمَاعَة أو المَجْمُوعَة الواحدة التي لها صفات تجعلها تنتمي إلى بعض تسمى جِنْسا وهو أعمُّ من النَوْع. ليس للجنس أو النوع ما يحددهما فالبشر كلهم جنس…؛ أحيانا يقصد به ذكر أم أنثى تحديدا) / جِمَاع, مُجَامَعَة (الموافقة والمساعدة في أي شيء كان؛ الشيء: جمعه)\nمثال: أنا مثلي الجنس.",
 "突っ込む": "أَشَارَ / طعني",
 "突っ返す": "رَفَضَ (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟",
 "突として": "فَجْأَةً",
 "突ん出す": "مَشْرُوع (ما تُجِيزُه السلطة أو القانون أو أي قاعدة، جَائِز، قَانُونِيّ؛ مسعى مؤقت أي شيء يُسْعى لفعله خلال فترة زمنية معينة، فيُقال مشروع شخصي، مشروع سياسي، مشروع تجاري ؛إلخ)\nمثال: هذا مشروع عظيم.",
 "突兀": "شَاهِق",
 "突先": "طَرَف / بَقْشِيش / بَقْشِيش, بَخْشِيش / إِخْبَارِيَّة / نَصِيحَة",
 "突入": "عَاصِفَة / طُوفَان (عاصفة) / عَاصْفة",
 "突出": "إِسْقَاط / مَسْقَط (اسم مكان من السقوط؛ موضع السقوط عامّة؛ رأسه: عن المكان الذي وُلِد فيه. يُقصد بها الدولة أو المدينة لا المبنى)\nمثال: دفنت في مسقط رأسها. / تَمَزُّق",
 "突出し": "نَاتِئَة / مَزَّة, مُشَهْي (مَزة (بفتح الميم) مجموعة من الأكلات الصغيرة مشهورة في شرق البحر المتوسط، عادة تؤكل مع المشروبات الكحولية؛ مُزة (بضم الميم) تستخدم في اللهجة المصرية للإشارة للمرأة الجميلة)",
 "突出して": "خُصُوصًا, خَاصَّةً",
 "突出る": "مَشْرُوع (ما تُجِيزُه السلطة أو القانون أو أي قاعدة، جَائِز، قَانُونِيّ؛ مسعى مؤقت أي شيء يُسْعى لفعله خلال فترة زمنية معينة، فيُقال مشروع شخصي، مشروع سياسي، مشروع تجاري ؛إلخ)\nمثال: هذا مشروع عظيم.",
 "突出物": "إِسْقَاط / مَسْقَط (اسم مكان من السقوط؛ موضع السقوط عامّة؛ رأسه: عن المكان الذي وُلِد فيه. يُقصد بها الدولة أو المدينة لا المبنى)\nمثال: دفنت في مسقط رأسها.",
 "突出部": "نَاتِئَة",
