 "ムシクイ": "مَسُوس, مُتَأَكِّلٌ بِالدُّودِ (مُصَابٌ أَوْ مُتَضَرِّرٌ بِفِعْلِ الدِّيدَانِ)",
 "ムシケラ": "شَخْص دَنِيء (سواد الإنسان حين يرى من بعيد فلا يُعرَف؛ واحد الإنسان بصورة عامة بدون تحديد لسنه وجنسه وقومه وغير ذلك)\nمثال: هذا الشخص فنان.",
 "ムシコブ": "صفاقة, وقاحة (سمة كون المرء وقحاً وسليطاً؛ يميل لأخذ حريات غير مستحقة) / صفراء, عصارة صفراوية (عصارة هضمية يفرزها الكبد وتخزن في المرارة؛ تساعد في هضم الدهون) / استياء, حقد (شعور بالغضب العميق والمرارة وسوء النية) / عفصة (تورم غير طبيعي في أنسجة النبات ناتج عن الحشرات أو الكائنات الحية الدقيقة أو الإصابة)",
 "ムシヒキアブ": "ذبابة سارقة (ذبابة مفترسة سريعة لها جسم قوي يشبه النحلة مع خرطوم صلب لامتصاص عصارة الحشرات الأخرى التي يتم اصطيادها أثناء الطيران)",
 "ムシムシ": "حَارّ وَرَطْب, خَانِق (حارّ أو دافئ ورطب بشكل مزعج)",
 "ムシャクシャ": "زَعْلَان / أَشْعَث",
 "ムシャムシャ": "قضم, مضغ (قضمة كبيرة)\nمثال: حاول التحدث بين قضمات الشطيرة / أَشْعَث",
 "ムショ": "سِجْن (وضع شخصًا أو شيئًا في السجن أو الحبس؛ قيّد حرية شخص أو حركة شيء)\nمثال: دخل سامي السجن.",
 "ムシロ": "مَقْعَد, مَقْعَدَة (كل ما يُقْعَدُ ويُجْلَسُ عليه؛ مَكَان القُعُود)\nمثال: نام ياني على مقعد.",
 "ムジナ": "غُرَيْر / كلب الراكون (كلب بري صغير من شرق آسيا له علامات وجه تشبه علامات الراكون)",
 "ムジナモ": "الدرواندة, نبات طاحونة الماء (نبات مائي آكل للحوم معمر وطافٍ من وسط وجنوب أوروبا وإفريقيا وآسيا وأستراليا، له دوارات من 6 إلى 9 أوراق تنتهي بفصوص مفصلية لاصطياد براغيث الماء مثلاً)",
 "ムジャーヒディーン": "مجاهدين (قوة عسكرية من المحاربين المسلمين المشاركين في الجهاد)\nمثال: يسمي البعض المجاهدين محاربين دوليين لكن آخرين يسمونهم إرهابيين",
 "ムスっと": "بِتَجَهُّم, بِعُبُوس (بطريقة عابسة)\nمثال: جلس على كرسيه بتجهم",
 "ムスカリ": "ياسنت العنب (أي من الياسنت الربيعي المبكر المتنوع موطنه أوراسيا ذو سنابل كثيفة من الزهور الزرقاء المستديرة تشبه عناقيد العنب الصغيرة)",
 "ムスク": "مِسْك",
 "ムスコ": "اِبْن (الولد الذكر)\nمثال: هو له ابن صغير. / قَضِيب, ذَكَر",
 "ムスタッシュ": "شَارِب (نمو للشعر غير المحلوق على الشفة العليا)\nمثال: بدا أصغر سناً بعد أن حلق شاربه",
