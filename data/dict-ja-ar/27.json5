 "メロドラマてき": "مِيلُودْرَامِيّ (يَحْمِل إِثَارَةً وَجَاذِبِيَّةً عَاطِفِيَّة كَالمِيلُودْرَامَا) / اِسْتِعْرَاضِيّ, مَسْرَحِيّ (مِنْ سِمَات التَّمْثِيل أَوِ الأَدَاء المَسْرَحِيّ؛ غَالِبًا مُتَكَلَّف)",
 "メロドラマ的": "مِيلُودْرَامِيّ (يَحْمِل إِثَارَةً وَجَاذِبِيَّةً عَاطِفِيَّة كَالمِيلُودْرَامَا) / اِسْتِعْرَاضِيّ, مَسْرَحِيّ (مِنْ سِمَات التَّمْثِيل أَوِ الأَدَاء المَسْرَحِيّ؛ غَالِبًا مُتَكَلَّف)",
 "メロメロ": "بتهور, رأساً على عقب (في عجلة مضطربة)\nمثال: ركضنا بتهور نحو الملجأ / اِنْهَار / اِنْهِيَار (سقوط شيء أو تهاويه بشكل مفاجئ نتيجة ضعف أو خلل؛ تدهور نفسي أو عاطفي يؤدي إلى فقدان القدرة على التحمل)\nمثال: يوشك الجسر على الانهيار.",
 "メロン": "شَمَّام",
 "メロ・ドラマ": "مِيلُودْرَامَا",
 "メロー": "برخامة, بنعومة (بطريقة رخيمة) / ثَمِل قَلِيلًا, مُنْتَشٍ (فِي حَالَة نَشْوَة خَفِيفَة مِنَ الكُحُول أَوِ المُخَدِّرَات) / هادِئ, وَديع (لَطيف وهادِئ؛ نَضِج واعْتَدَل بِمُرور الوَقْت) / مُعَتَّق, نَاعِم (ذو نكهة ممتلئة ومُسْتَحَبّة بفضل التعتيق المناسب)",
 "メン": "نَاس (اسم للجمع من بني آدم واحده إِنْسَان أو إِنْس)\nمثال: ضحك الناس عليه. / عُضْو, عِضْو (جُزْء من الجَسَد؛ مُشْتَرِك فِي جَمْعِيَّة أو شَرِكَة أو حِزْب أو نَادٍ) / عُضُو (جُزْء من الجَسَد؛ مُشْتَرِك فِي جَمْعِيَّة أو شَرِكَة أو حِزْب أو نَادٍ)\nمثال: اذكر كل عضو باسمه.",
 "メンゴ": "آسِف / حَزِين / مُؤْسِف, مُحْزِن / آسِف, آسِفَة",
 "メンシェビキ": "منشفي, منشفيك (عضو روسي في مجموعة الأقلية الليبرالية التي دعت إلى الإصلاح التدريجي وعارضت البلاشفة قبل وأثناء الثورة الروسية)",
 "メンシェヴィキ": "منشفي, منشفيك (عضو روسي في مجموعة الأقلية الليبرالية التي دعت إلى الإصلاح التدريجي وعارضت البلاشفة قبل وأثناء الثورة الروسية)",
 "メンション": "ذِكْر (ذَكَرَ الشيءَ: نطق به أو أشار إليه بالكلام؛ ذَكَرَ شخصًا: استحضره في الذاكرة) / ذَكَرَ (ذَكَرَ الشيءَ: نطق به أو أشار إليه بالكلام؛ ذَكَرَ شخصًا: استحضره في الذاكرة)\nمثال: قتله ذكر زرافة.",
 "メンス": "حيض, دورة شهرية (الإفراز الشهري للدم من رحم النساء غير الحوامل من سن البلوغ حتى سن اليأس)\nمثال: كانت النساء مريضات وعرضة للحيض المفرط",
 "メンズ": "حمام الرجال (مرحاض عام للرجال) / نَاس (اسم للجمع من بني آدم واحده إِنْسَان أو إِنْس)\nمثال: ضحك الناس عليه.",
 "メンズスーツ": "بَذْلَة, بَدْلَة / رَمْز (رمز (جمعه رموز)؛ الرمز يعني الرسم الذي يعبر عن شيء معين وعموما فأن العلامة ينبغي نقل رسالتها بنظرة واحدة دون الحاجة للكلمات) / نَاسَبَ\nمثال: تمثال الحرية رمز لأمريكا.",
 "メンズ・スーツ": "بَذْلَة, بَدْلَة / رَمْز (رمز (جمعه رموز)؛ الرمز يعني الرسم الذي يعبر عن شيء معين وعموما فأن العلامة ينبغي نقل رسالتها بنظرة واحدة دون الحاجة للكلمات) / نَاسَبَ\nمثال: تمثال الحرية رمز لأمريكا.",
 "メンソール": "منثول (غسول يحتوي على المنثول مما يعطيه رائحة النعناع) / منثول (مركب بلوري له طعم ورائحة النعناع الباردة ويوجد بشكل طبيعي في زيت النعناع الفلفلي؛ يستخدم كمنكه وفي الطب لتخفيف الحكة والألم واحتقان الأنف)",
 "メンタリズム": "ذهنية ((فلسفة) مذهب يرى أن العقل هو الواقع الحقيقي وأن الأشياء توجد فقط كجوانب من وعي العقل)",
 "メンタリティ": "عَقْلِيَّة",
 "メンタリティー": "عَقْلِيَّة",
 "メンタリング": "مرشد, موجه (مرشد ومستشار حكيم وموثوق به)",
 "メンタル": "عَقْلِيّ / صِحَّة نَفْسِيَّة (سَلَامَة؛ سَلَامَة الْجِسْم)\nمثال: أشك في صحة ذلك.",
 "メンタルテスト": "اختبار, اختبار عقلي (أي إجراء موحد لقياس الحساسية أو الذاكرة أو الذكاء أو الكفاءة أو الشخصية وما إلى ذلك)\nمثال: تم توحيد الاختبار على عينة كبيرة من الطلاب",
 "メンタルヘルス": "صِحَّة نَفْسِيَّة (سَلَامَة؛ سَلَامَة الْجِسْم)\nمثال: أشك في صحة ذلك.",
 "メンタル・テスト": "اختبار, اختبار عقلي (أي إجراء موحد لقياس الحساسية أو الذاكرة أو الذكاء أو الكفاءة أو الشخصية وما إلى ذلك)\nمثال: تم توحيد الاختبار على عينة كبيرة من الطلاب",
 "メンタル・ヘルス": "صِحَّة نَفْسِيَّة (سَلَامَة؛ سَلَامَة الْجِسْم)\nمثال: أشك في صحة ذلك.",
