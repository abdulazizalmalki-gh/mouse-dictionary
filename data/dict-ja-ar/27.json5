 "ベトナムしゃかいしゅぎきょうわこく": "جُمْهُورِيَّة فِيِتْنَام الاِشْتِرَاكِيَّة, جُمْهُورِيَّة الاِشْتِرَاكِيَّة فِيِتْنَام",
 "ベトナムじん": "فِيتْنَامِيّ",
 "ベトナム人": "فِيتْنَامِيّ",
 "ベトナム社会主義共和国": "جُمْهُورِيَّة فِيِتْنَام الاِشْتِرَاكِيَّة, جُمْهُورِيَّة الاِشْتِرَاكِيَّة فِيِتْنَام",
 "ベトナム語": "فِيتْنَامِيّ",
 "ベトベト": "دَبِق, صَمْغِيّ (له خصائص اللصق اللزجة كالمواد اللاصقة) / لَاصِق, لَزِق (مُغطّى بمادّة لاصقة) / حَرِج, مُحْرِج (صَعْب التَّعَامُل مَعَهُ؛ يُسَبِّب أَلَمًا أَوْ إِحْرَاجًا) / حَارّ وَرَطْب, خَانِق (حارّ أو دافئ ورطب بشكل مزعج)",
 "ベトン": "مَادِّيّ / خَرَسَانَة",
 "ベドウィン": "بَدَوِيّ, بَدْو (إلى البادية؛ الذي يعيش في البَادِيَة؛ الأعرابيّ)",
 "ベナン": "بَنِين",
 "ベニア": "قِنَاع (غطاء يوضع على الوجه للحماية أو التنكر؛ طبق يوضع فيه الطعام. )\nمثال: نزع زيري القناع. / خَشَب رَقَائِقِيّ, خَشَب مُعَاكِس (هو ما غَلَظَ وصَلُبَ من أصول الشَجَر وفروعها مثل الجِذْع والأغْصَان؛ هو ما صنع من جذوع أو أغصان الشَجَر)\nمثال: نحن نقطع الخشب.",
 "ベニイモ": "يام أبيض, يام الماء (يزرع في أسترالاسيا وبولينيزيا لجذره الكبير ذو اللحم الأبيض الناعم الصالح للأكل)",
 "ベニエ": "بينييه, فطيرة فرنسية مقلية (دونات مقلية مخمرة بالخميرة ومرشوشة بسكر الحلواني)",
 "ベニガイ": "فَتِيّ, مِلْؤُه الحَيَوِيَّة (مَليء بِالقُوَّة والنَّشاط والحَيَوِيَّة الدَّمَوِيَّة) / كَامِلُ الدَّم, نَقِيُّ السُّلَالَة (من نسب غير مختلط؛ خالص الأصل)",
 "ベニザケ": "سلمون أحمر, سلمون سوكي (سلمون صغير ذو لحم أحمر؛ يوجد في الأنهار وروافد شمال المحيط الهادئ ويُقدر كطعام؛ يموت البالغون بعد وضع البيض) / سلمون أحمر (لحم أحمر دهني لسلمون ساحل المحيط الهادئ والأنهار)",
 "ベニス": "اَلْبُنْدُقِيَّة",
 "ベニテングタケ": "أمانيت مسكاري, فطر الذباب (فطر غابات سام (ولكن نادراً ما يكون قاتلاً) له قبعة قرمزية مع ثآليل بيضاء وخياشيم بيضاء)",
 "ベニハナ": "مُرِّيق, مُرَّيْق",
 "ベニバナ": "مُرِّيق, مُرَّيْق",
 "ベニバナインゲン": "فاصولياء قرمزية (قرون فاصولياء طويلة تقطع عادةً؛ مفضلة في بريطانيا) / فاصولياء العداء القرمزي, فاصولياء قرمزية (فاصولياء استوائية أمريكية ذات زهور حمراء وفاصولياء سوداء مرقطة تشبه الفاصولياء الشائعة ولكنها معمرة؛ وهي فاصولياء مفضلة للأكل في بريطانيا العظمى)",
 "ベニミョウレンジ": "جابونيكا, كاميليا يابانية (شجيرة دفيئة ذات أوراق خضراء لامعة وزهور مبهرجة عطرة تشبه الورد؛ تزرع في العديد من الأصناف)",
