 "マントーはんのう": "اختبار مانتو (يتم حقن التوبركولين (مشتق من عصية الدرن) داخل الأدمة؛ ظهور منطقة حمراء بعد 1-3 أيام يشير إلى التعرض (الماضي أو الحالي) لعصيات الدرن)",
 "マントー反応": "اختبار مانتو (يتم حقن التوبركولين (مشتق من عصية الدرن) داخل الأدمة؛ ظهور منطقة حمراء بعد 1-3 أيام يشير إلى التعرض (الماضي أو الحالي) لعصيات الدرن)",
 "マンドラゴラ": "يَبْرُوح, لُفَّاح",
 "マンドリル": "مندريل (رباح يعيش في غرب أفريقيا ذو خطم أحمر وأزرق ساطع ومؤخرة زرقاء)",
 "マンドリン": "ماندولين (آلة وترية مرتبطة بالعود، تُعزف عادة بريشة)",
 "マンドレイク": "يَبْرُوح, لُفَّاح",
 "マンドレーク": "يَبْرُوح, لُفَّاح",
 "マンナ": "مَنّ (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "マンニトール": "مانيتول (مدر للبول (الاسم التجاري أوزميترول) يستخدم لتعزيز إخراج البول)",
 "マンネリズム": "رَتِيب, مُمِلّ (مكرّر بشكل مملّ أو يفتقر إلى التنوّع) / رَتِيب, عَادِيّ (غير مُلهِم ولا يُشكِّل تحدياً؛ باهت وخالٍ من الإثارة) / رَتَابَة, مَلَل (صفة الثبات المرهق والروتين ونقص التنوع)\nمثال: لم يعتد أبداً على رتابة عمله",
 "マンネングサ": "حَيّ الْعَالَم (ضد المَيِّت، على قيد الحَيَاة؛ جمع حَيَاء)\nمثال: ينبح كلب في الحي.",
 "マンネンタケ": "فطر الرف, فطر قوسي (فطر خشبي يشكل حوامل بوغية تشبه الرف على جذوع الأشجار والهياكل الخشبية)",
 "マンネンロウ": "إِكْلِيل الْغَار, إِكْلِيل الْجَبَل",
 "マンハッタン": "مانهاتن (كوكتيل مصنوع من الويسكي والفيرموث الحلو مع قليل من البيترز)",
 "マンハッタンけいかく": "مشروع مانهاتن (وكالة تنفيذية أمريكية سابقة كانت مسؤولة عن تطوير القنابل الذرية خلال الحرب العالمية الثانية)",
 "マンハッタン計画": "مشروع مانهاتن (وكالة تنفيذية أمريكية سابقة كانت مسؤولة عن تطوير القنابل الذرية خلال الحرب العالمية الثانية)",
 "マンハント": "بحث منظم, مطارده (بحث منظم (من قبل الشرطة) عن شخص (متهم بجريمة))",
 "マンバ": "مامبا (ثعبان شجري من وسط وجنوب أفريقيا عضته غالباً ما تكون قاتلة)",
 "マンパワー": "أيدي عاملة, قوة عاملة (قوة العمال المتاحة)",
 "マンホール": "فتحة صيانة, منهول (ثقب (عادة بغطاء مستو) يمكن للشخص من خلاله الوصول إلى هيكل تحت الأرض)",
 "マンボ": "مَامْبُو",
 "マンボウ": "سمكة شمس المحيط, مولا (من بين أكبر الأسماك العظمية؛ سمكة تعيش في عرض البحر ذات جسم بيضاوي مضغوط وزعانف ظهرية وشرجية عالية وزعنفة ذيلية مختزلة إلى فص يشبه الدفة؛ توجد…)",
 "マンマンデ": "بَطِيء / أَبْطَأَ, بَطَّأَ",
 "マンマンデー": "بَطِيء / أَبْطَأَ, بَطَّأَ",
 "マンモグラフィ": "تصوير الثدي بالأشعة (إجراء تشخيصي للكشف عن أورام الثدي باستخدام الأشعة السينية)",
 "マンモグラフィー": "تصوير الثدي بالأشعة (إجراء تشخيصي للكشف عن أورام الثدي باستخدام الأشعة السينية)",
 "マンモス": "مَامُوث / ضَخْم, هَائِل",
 "マンモスぞう": "ماموث شمالي, ماموث صوفي (ماموث كثيف الشعر كان شائعاً في المناطق الباردة من نصف الكرة الشمالي)",
 "マンモスゾウ": "ماموث شمالي, ماموث صوفي (ماموث كثيف الشعر كان شائعاً في المناطق الباردة من نصف الكرة الشمالي)",
 "マンモス像": "ماموث شمالي, ماموث صوفي (ماموث كثيف الشعر كان شائعاً في المناطق الباردة من نصف الكرة الشمالي)",
 "マンモン": "المال (كإله), المامون (الثروة باعتبارها تأثيراً شريراً)",
 "マンリョウ": "توت التوابل, توت المرجان (شجيرة ذات توت أحمر مرجاني؛ اليابان إلى شمال الهند) / توت المرجان, كشمش هندي (شجيرة نفضية من أمريكا الشمالية تزرع لعناقيدها الغزيرة من الثمار الحمراء المرجانية الشبيهة بالتوت)",
 "マン・イーター": "قرش أبيض, قرش أبيض كبير (قرش عدواني كبير واسع الانتشار في البحار الدافئة؛ معروف بمهاجمته للبشر) / آكل لحوم البشر (شخص يأكل اللحم البشري)",
 "マン島語": "قط مانكس (سلالة قصيرة الشعر عديمة الذيل يعتقد أنها نشأت في جزيرة مان) / مانكسي (من أو متعلق بجزيرة مان أو سكانها أو لغتهم) / المانكية, لغة مانكس (الغيلية القديمة التي كان يتم التحدث بها سابقًا في جزيرة مان؛ تُستخدم اللغة أحيانًا في المناسبات الاحتفالية)\nمثال: صناعة صيد الأسماك المانكسية",
 "マン毛": "شَعْر اَلْعَانَة (العِلْم؛ في : هو كلام مُقَفَّى ومُوَازَن على أوزان معروفة يُقصد به إظهار الكلام بصيغة فنية)\nمثال: شعر ماريا طويل.",
 "マン肉": "فَرْج, حِرّ",
 "マーカ": "علامة, مؤشر (جسم بارز يُستخدم لتمييز أو تحديد شيء ما) / قلم تخطيط, قلم علّام (أداة كتابة لعمل علامة) / علامة, مؤشر (رمز مميز)\nمثال: كانت العوامات علامات للقناة المائية / مسجل النقاط (مسؤول يسجل النتيجة أثناء سير المباراة)",
 "マーカンティリズム": "تجارة, تجارية (المعاملات (البيع والشراء) التي تهدف إلى توفير السلع (البضائع والخدمات)) / مذهب تجاري, مركنتيلية (نظام اقتصادي (أوروبا في القرن الثامن عشر) لزيادة ثروة الأمة عن طريق التنظيم الحكومي لجميع المصالح التجارية للأمة)",
 "マーカンヒリズム": "تجارة, تجارية (المعاملات (البيع والشراء) التي تهدف إلى توفير السلع (البضائع والخدمات)) / مذهب تجاري, مركنتيلية (نظام اقتصادي (أوروبا في القرن الثامن عشر) لزيادة ثروة الأمة عن طريق التنظيم الحكومي لجميع المصالح التجارية للأمة)",
 "マーカー": "علامة, مؤشر (جسم بارز يُستخدم لتمييز أو تحديد شيء ما) / قلم تخطيط, قلم علّام (أداة كتابة لعمل علامة) / علامة, مؤشر (رمز مميز)\nمثال: كانت العوامات علامات للقناة المائية / مسجل النقاط (مسؤول يسجل النتيجة أثناء سير المباراة)",
 "マーガリン": "سَمْن نَبَاتِيّ (الدُهُون التي تؤكل، وتشمل الزُبْد والقِشْطَة وما يستخرج من الحَيْوَان والنبات. قيل السمن من الحيوان والدهن من النبات وقيل السمن ما يؤكل والدهن ما لا…)",
 "マーガレット": "أقحوان المارغريت, أقحوان شجيري (شجيرة معمرة من جزر الكناري لها زهور تشبه الأقحوان صفراء شاحبة عادة؛ تُصنف غالباً ضمن جنس الأقحوان) / أقحوان أبيض, أقحوان المروج (نبات أوراسي معمر طويل الساق ومورق بزهور بيضاء؛ متوطن على نطاق واسع)",
 "マーキュリー": "زِئْبَق, زَاؤُوق / حُلْبُوب",
 "マーキュロ": "ميربرومين, ميركوروكروم (مركب زئبقي يطبق موضعياً كمطهر؛ ميركوروكروم هي العلامة التجارية)",
 "マーキュロクロム": "ميربرومين, ميركوروكروم (مركب زئبقي يطبق موضعياً كمطهر؛ ميركوروكروم هي العلامة التجارية)",
 "マーキュロクローム": "ميربرومين, ميركوروكروم (مركب زئبقي يطبق موضعياً كمطهر؛ ميركوروكروم هي العلامة التجارية)",
 "マーキング": "تعليم, وضع علامات (فعل عمل علامة مرئية على سطح) / تصحيح, وضع الدرجات (تقييم الأداء عن طريق تعيين درجة أو نتيجة) / علامة, وسم (نمط من العلامات) / علامة, مؤشر (رمز مميز)\nمثال: ما كرهه في التدريس هو كل التصحيح الذي كان عليه القيام به",
 "マーキングペン": "قَلَم لَبَدِيّ, قَلَم تَحْدِيد (قَطَعَ جزءا من شيء لتزيينه وتحسينه)\nمثال: ارسم بقلم رصاص.",
 "マーキング・ペン": "قَلَم لَبَدِيّ, قَلَم تَحْدِيد (قَطَعَ جزءا من شيء لتزيينه وتحسينه)\nمثال: ارسم بقلم رصاص.",
 "マーキーズ": "سرادق, مظلة المدخل (مظلة دائمة فوق مدخل فندق أو ما شابه) / ماركيزة (امرأة نبيلة رتبتها أقل من دوقة وأعلى من كونتيسة)",
 "マーク": "دَرَجَة / أَشَّرَ (مَرِحٌ؛ نَشِط)\nمثال: الصهاينة أشر من النازيين. / عَلَامَة تِجَارِيَّة (سِمَةٌ أو أمارة أو شِعَار تُعرف به الأشياء؛ رَمْز)\nمثال: تحصلت على علامة أ. / رصد, مراقبة (فعل المراقبة؛ أخذ نظرة متأنية) / إعداد المسرح, ديكور المسرح (ترتيب المناظر والممتلكات لتمثيل المكان الذي تُمثل فيه مسرحية أو فيلم) / فص, مثبت (قاعدة تثبيت تتكون من قطعة معدنية (كما في خاتم أو مجوهرات أخرى) تثبت الحجر الكريم في مكانه) / إعداد المائدة (طقم مائدة لشخص واحد) / إطار, محيط (السياق والبيئة التي يوضع فيها شيء ما)\nمثال: كان الماس في مثبت ذهبي بسيط",
 "マークアップ": "تَرْمِيز, تَعْلِيمَات التَّنْسِيق (تعليمات نمطية مفصلة لتنضيد الحروف لشيء سيتم طباعته؛ عادة ما يتم كتابة الترميز اليدوي على النسخة (مثل وضع خط تحت الكلمات التي سيتم تعيينها بخط مائل)) / زيادة السعر, هامش الربح (المبلغ المضاف إلى التكلفة لتحديد سعر البيع)",
 "マークアップげんご": "لغَة رقم (هِيَ مجموعة من الأصوات التي يصدرها الإنسان على شكل كلمات منظمة بقواعد، ليتواصل به الناس وينقلون به الافكار والمعاني، اللسان؛ يقصد بها أحيانا اللهجة)\nمثال: الأمازيغية لغة.",
 "マークアップ言語": "لغَة رقم (هِيَ مجموعة من الأصوات التي يصدرها الإنسان على شكل كلمات منظمة بقواعد، ليتواصل به الناس وينقلون به الافكار والمعاني، اللسان؛ يقصد بها أحيانا اللهجة)\nمثال: الأمازيغية لغة.",
 "マーケ": "تَسْوِيق",
 "マーケター": "بائع, مروّج (شخص يروج أو يتبادل البضائع أو الخدمات مقابل المال)",
 "マーケッティング": "تَسْوِيق",
 "マーケット": "سُوق (مكان للبيع والشراء؛ جمع ساق، قال الله تعالى: 《رُدُّوهَا عَلَيَّ فَطَفِقَ مَسْحًا بِالسُّوقِ وَالْأَعْنَاقِ》)\nمثال: ذهبت إلى السوق.",
 "マーケットアナリシス": "تحليل السوق (أبحاث تسويقية تسفر عن معلومات حول السوق)",
 "マーケットガーデン": "بستان تجاري (حديقة تُزرع فيها الفواكه والخضروات لغرض التسويق)",
 "マーケットプライス": "سعر السوق, قيمة سوقية (السعر الذي يتبادل به المشترون والبائعون السلعة في سوق مفتوح)",
 "マーケットプレイス": "سوق (عالم النشاط التجاري حيث يتم شراء وبيع السلع والخدمات) / ساحة السوق, سوق (منطقة في مدينة حيث تُقام منشأة تجارية عامة)\nمثال: بدون منافسة لن يكون هناك سوق",
 "マーケットリサーチ": "بَحْث سُوق, بَحْث السُوق (طَلَب الشيء في التُرَاب؛ طلب الشيء في أي مكان والتَفْتِيش والتَقَصِّي عنه)\nمثال: بدأ زيري البحث.",
 "マーケット・アナリシス": "تحليل السوق (أبحاث تسويقية تسفر عن معلومات حول السوق)",
 "マーケット・ガーデン": "بستان تجاري (حديقة تُزرع فيها الفواكه والخضروات لغرض التسويق)",
 "マーケット・プライス": "سعر السوق, قيمة سوقية (السعر الذي يتبادل به المشترون والبائعون السلعة في سوق مفتوح)",
 "マーケット・リサーチ": "بَحْث سُوق, بَحْث السُوق (طَلَب الشيء في التُرَاب؛ طلب الشيء في أي مكان والتَفْتِيش والتَقَصِّي عنه)\nمثال: بدأ زيري البحث.",
 "マーケティング": "تَسْوِيق",
 "マーケティングじょうほうシステム": "مِي (الفتاة البِكْر؛ اسم من أسماء الخَمْر، يطلق غالبًا على الخمر الجديد الذي لم يُعتَّقُ كثيرا)",
 "マーケティングコスト": "تكلفة التسويق (تكلفة التسويق (على سبيل المثال، تكلفة نقل الملكية ونقل البضائع إلى العميل))",
 "マーケティングリサーチ": "أبحاث التسويق (البحث الذي يجمع ويحلل المعلومات حول نقل البضائع أو الخدمات من المنتج إلى المستهلك)",
 "マーケティング・コスト": "تكلفة التسويق (تكلفة التسويق (على سبيل المثال، تكلفة نقل الملكية ونقل البضائع إلى العميل))",
 "マーケティング・リサーチ": "أبحاث التسويق (البحث الذي يجمع ويحلل المعلومات حول نقل البضائع أو الخدمات من المنتج إلى المستهلك)",
 "マーケティング情報システム": "مِي (الفتاة البِكْر؛ اسم من أسماء الخَمْر، يطلق غالبًا على الخمر الجديد الذي لم يُعتَّقُ كثيرا)",
 "マーゲイ": "مارج (قط بري صغير مرقط يوجد من تكساس إلى البرازيل)",
 "マーコール": "مارخور (ماعز هيمالايا كبير بقرون لولبية كبيرة)",
 "マーサン": "لَذِيذ / شَهِيّ",
 "マーシャル": "عَقِيْد / مارْشال, مَأْمُور تَنْفِيذ قَضائِيّ (ضابط قانون له واجبات مشابهة للمأمور في تنفيذ أحكام المحكمة) / مارشال, مشير ((في بعض البلدان) ضابط عسكري من أعلى رتبة)",
 "マーシャルしょとう": "جُزُر مَارْشَال (جَزَرَ الماءُ عن الأَرضِ يَجْزُرُ جَزْراً: نَضَبَ وحَسَرَ؛ ويقال: جَزَرَ البَحْرُ والنَّهْرُ: انْحسرَ ماؤُهُ)\nمثال: ضع الجزر في القدر.",
 "マーシャルアーツ": "فَنٌّ قِتَالِيّ, الفُنُون القِتَالِيَّة (نوع، صنف؛ كل عمل جميل يؤثر في المشاعر والعواطف)\nمثال: هذا مدرسنا في الفن.",
 "マーシャル・アーツ": "فَنٌّ قِتَالِيّ, الفُنُون القِتَالِيَّة (نوع، صنف؛ كل عمل جميل يؤثر في المشاعر والعواطف)\nمثال: هذا مدرسنا في الفن.",
 "マーシャル諸島": "جُزُر مَارْشَال (جَزَرَ الماءُ عن الأَرضِ يَجْزُرُ جَزْراً: نَضَبَ وحَسَرَ؛ ويقال: جَزَرَ البَحْرُ والنَّهْرُ: انْحسرَ ماؤُهُ)\nمثال: ضع الجزر في القدر.",
 "マーシュ": "خَسّ النَّعْجَة, خَسّ الضَأْن (خَسَّ الرجُلُ يَخِسُّ خِسَّةً، وخَسَاسَةً: حَقُرَ؛ يقال: خَسَّ فِعْلُهُ وقولُه ورأْيُه)\nمثال: بيع المنزل بثمن بخس.",
 "マージ": "دَمَجَ (دمج الأشياء: جمعها وخلطها معًا؛ دمجهُ:جعله جزءًا من شيء أكبر منه)\nمثال: دمج فكرتين في فكرة.",
 "マージナル": "حَدِّيّ, هَامِشِيّ (عند الحدود أو الحافّة أو يشكّلها) / حَدِّيّ, هَامِشِيّ (ذو جودة مشكوك فيها أو ضئيلة) / هَامِشِيّ الرِّبْح (ينتج بمعدّل يكاد يغطّي تكاليف الإنتاج فحسب) / بِالْكَاد, ضَئِيل (بالكاد يكفي أو عند الحدّ الأدنى)",
 "マージナルコスト": "تكلفة تزايدية, تكلفة حدية (الزيادة أو النقصان في التكاليف نتيجة لوحدة إنتاج واحدة أكثر أو أقل)",
 "マージナル・コスト": "تكلفة تزايدية, تكلفة حدية (الزيادة أو النقصان في التكاليف نتيجة لوحدة إنتاج واحدة أكثر أو أقل)",
 "マージャン": "مَا جُونْغ (انظر مَا)\nمثال: هلا! ما الجديد؟",
 "マージョラム": "مَرْدَقُوش, بَرْدَقُوش",
 "マージン": "هَامِش",
 "マース": "الْمِرِّيخ, المريخ (رابع كوكب من كواكب المجموعة الشمسية) / مَارِس (ومَرِسَ؛ إله الحرب في الأساطير الرُومِيَّة، وهو المَرِيِّخ، لا يؤنث ولا يجمع)\nمثال: المريخ عالم ميت.",
 "マーズ": "إنفلونزا الإبل, فيروس كورونا المسبب لمتلازمة الشرق الأوسط التنفسية / الْمِرِّيخ, المريخ (رابع كوكب من كواكب المجموعة الشمسية) / مَارِس (ومَرِسَ؛ إله الحرب في الأساطير الرُومِيَّة، وهو المَرِيِّخ، لا يؤنث ولا يجمع)\nمثال: المريخ عالم ميت.",
 "マーダー": "قَتْلٌ عَمْدٌ (تعمّد جعله يَمُوتُ، أزهق روحه، أمَاتَه متعمدا؛ الوقتَ: ضيعه بشيء غير ذي فائدة وهو ينتظر أمرا آخر) / قَتَلَ (تعمّد جعله يَمُوتُ، أزهق روحه، أمَاتَه متعمدا؛ الوقتَ: ضيعه بشيء غير ذي فائدة وهو ينتظر أمرا آخر)\nمثال: قتل الصياد دبا.",
 "マーダーミステリー": "لغز جريمة قتل (سرد حول جريمة قتل وكيفية اكتشاف القاتل)",
 "マーダー・ミステリー": "لغز جريمة قتل (سرد حول جريمة قتل وكيفية اكتشاف القاتل)",
 "マーチ": "مَسِيرَة / لَحْن السَّيْر, مَارْش (وضع الألحان أو التأليف الموسيقي؛ قرأ النص بلحن أو أداء صوتي مميز) / سَارَ (مَشَى)\nمثال: أنا أحب هذا اللحن.",
 "マーチャンダイザー": "بائع تجزئة, تاجر (رجل أعمال يعمل في تجارة التجزئة)",
 "マーチャンダイジング": "إعلان, دعاية (العمل التجاري لجذب انتباه الجمهور إلى السلع والخدمات) / بيع, متاجرة (تبادل البضائع مقابل مبلغ متفق عليه من المال) / منتجات ترويجية (منتجات تحمل علامة تجارية تهدف للترويج لمنتج آخر، وخاصة الأفلام والفرق الموسيقية)",
 "マーチャント": "تَاجِر, تَاجِرَة",
 "マーチャントバンク": "بنك تجاري, بنك مكتسب (بنك يعالج بطاقات الائتمان؛ حيث يتلقى التجار ائتمانًا لإيصالات بطاقات الائتمان مخصومًا منها رسوم المعالجة)",
 "マーチャント・バンク": "بنك تجاري, بنك مكتسب (بنك يعالج بطاقات الائتمان؛ حيث يتلقى التجار ائتمانًا لإيصالات بطاقات الائتمان مخصومًا منها رسوم المعالجة)",
 "マーチョ": "عَرَبَة / مُدَرِّب, مُدَرِّبَة / حافلة السفر, حافلة النقل الخارجي (وسيلة نَقْل للركاب)\nمثال: لنذهب بالحافلة.",
 "マーチング": "سير عسكري, مسير (فعل السير؛ المشي بخطوات منتظمة (خاصة في موكب من نوع ما))\nمثال: كان مسيراً طويلاً",
 "マーチングバンド": "فرقة استعراضية, فرقة مارش (فرقة تسير (كما في موكب) وتعزف الموسيقى في نفس الوقت)",
 "マーチング・バンド": "فرقة استعراضية, فرقة مارش (فرقة تسير (كما في موكب) وتعزف الموسيقى في نفس الوقت)",
 "マーティニ": "مارتيني (كوكتيل مصنوع من الجن (أو الفودكا) مع فيرموث جاف)",
 "マーティーニ": "مارتيني (كوكتيل مصنوع من الجن (أو الفودكا) مع فيرموث جاف)",
