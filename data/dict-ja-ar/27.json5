 "フォージ": "وَرْشَة حِدَادَة",
 "フォース": "قُوَّة (ضد الضُعْف، الشِدَّة والقُدْرَة الجِسْمَانِيَّة؛ ضد الضُعْف، المَقْدِرَة والحَوْل والتَمَكُّن، القدرة المعنوية) / أَجْبَرَ, اِضْطَرَّ (فعل تعدّي من جَبَرَ؛ جعله يَجْبُر، ضد أَكْسَرَ؛ جعله يفعل شيئا رُغْما عنه؛ أَرْغَمَ)\nمثال: توم شعر بالقوة. / قُوَّة (ضد الضُعْف، الشِدَّة والقُدْرَة الجِسْمَانِيَّة؛ ضد الضُعْف، المَقْدِرَة والحَوْل والتَمَكُّن، القدرة المعنوية) / أَجْبَرَ, اِضْطَرَّ (فعل تعدّي من جَبَرَ؛ جعله يَجْبُر، ضد أَكْسَرَ؛ جعله يفعل شيئا رُغْما عنه؛ أَرْغَمَ)\nمثال: توم شعر بالقوة. / خارجاً, للملأ (للخارج للعرض) / فصاعداً, قدماً (للأمام في الوقت أو الترتيب أو الدرجة) / بَعِيدًا (من شيء أو مكان أو منصب معين)\nمثال: خرج من الحشد",
 "フォースアウト": "إخراج قسري, فورس آوت (إخراج عداء قاعدة مطلوب منه الركض)\nمثال: أمسك لاعب الشورت ستوب بالعداء عند الثانية في لعبة إجبارية",
 "フォースプレー": "إخراج قسري, فورس آوت (إخراج عداء قاعدة مطلوب منه الركض)\nمثال: أمسك لاعب الشورت ستوب بالعداء عند الثانية في لعبة إجبارية",
 "フォース・プレー": "إخراج قسري, فورس آوت (إخراج عداء قاعدة مطلوب منه الركض)\nمثال: أمسك لاعب الشورت ستوب بالعداء عند الثانية في لعبة إجبارية",
 "フォーチュン": "ثَرْوَة",
 "フォーチュンクッキー": "كَعْكَة الحَظّ (واحدة الكَعْك؛ حَلْوَى تُصْنع من الدَقِيق والحَلِيب والسُكَّر والزَيت ويخبز طريًا وقد يوضع عليه القِشْطَة. يُسمى عند البعض كَيْك وعند البعض تُورْتَة)\nمثال: خبزت كعكة لتوم.",
 "フォーチュン・クッキー": "كَعْكَة الحَظّ (واحدة الكَعْك؛ حَلْوَى تُصْنع من الدَقِيق والحَلِيب والسُكَّر والزَيت ويخبز طريًا وقد يوضع عليه القِشْطَة. يُسمى عند البعض كَيْك وعند البعض تُورْتَة)\nمثال: خبزت كعكة لتوم.",
 "フォーチューンクッキー": "كَعْكَة الحَظّ (واحدة الكَعْك؛ حَلْوَى تُصْنع من الدَقِيق والحَلِيب والسُكَّر والزَيت ويخبز طريًا وقد يوضع عليه القِشْطَة. يُسمى عند البعض كَيْك وعند البعض تُورْتَة)\nمثال: خبزت كعكة لتوم.",
 "フォーティ": "أَرْبَعُونَ",
 "フォーティー": "أَرْبَعُونَ",
 "フォーティーン": "أَرْبَعَةَ عَشَرَ (أَرْبِعَة؛ أربعَة)\nمثال: مرت أربعة أيام.",
 "フォートナイト": "أُسْبُوعَان",
 "フォートラン": "فورتران",
 "フォートレス": "قَلْعَة, حِصْن (المرة الواحدة من القَلْع؛ حِصْن منيع غالبا يبنى على تلّ أو جبل أو مكان عالٍ منيع)\nمثال: هو يعيش في قلعة.",
 "フォード": "مَخَاضَة",
 "フォービスム": "الوحشية (حركة فنية انطلقت عام 1905 تميزت أعمالها بألوان زاهية وغير طبيعية وأشكال بسيطة؛ أثرت على التعبيريين)",
 "フォーブ": "فنان وحشي, وحشي (عضو في مجموعة من الرسامين الفرنسيين الذين اتبعوا المدرسة الوحشية)",
 "フォーマッティング": "تنسيق, صيغة البيانات (تنظيم المعلومات وفقاً لمواصفات محددة مسبقاً (عادة للمعالجة الحاسوبية))",
 "フォーマット": "تنسيق, شكل (المظهر العام لمنشور) / تنسيق, صيغة البيانات (تنظيم المعلومات وفقاً لمواصفات محددة مسبقاً (عادة للمعالجة الحاسوبية))",
 "フォーマティング": "تنسيق, صيغة البيانات (تنظيم المعلومات وفقاً لمواصفات محددة مسبقاً (عادة للمعالجة الحاسوبية))",
 "フォーマリズム": "شكلية (ممارسة الالتزام الدقيق بالأشكال المقررة أو الخارجية) / شكلانية (المذهب القائل بأن الهيكل الرسمي بدلاً من المحتوى هو ما يجب تمثيله) / شكلانية ((فلسفة) النظرية الفلسفية القائلة بأن البيانات الرسمية (المنطقية أو الرياضية) ليس لها معنى ولكن رموزها (التي تعتبر كيانات مادية) تظهر شكلاً له تطبيقات…)",
 "フォーマル": "رَسْمِيّ, صُورِيّ (منسوب للسُّلْطَة أو الحُكُومَة أو الدَّوْلَة أو القَانُون؛ مُلَائِم للمَعَايِير) / رَسْمِيّ (منسوب للسُّلْطَة أو الحُكُومَة أو الدَّوْلَة أو القَانُون؛ مُلَائِم للمَعَايِير)\nمثال: لقد انتهى الدرس بشكل رسمي.",
 "フォーマルハウト": "فَمُ الْحُوت",
 "フォーミュラ": "صِيغَة",
 "フォーミュラリー": "صياغي, وصفتي (مكون من أو متعلق بـ أو ذو طبيعة صيغية) / دستور الأدوية ((علم الأدوية) كتاب يحتوي على تجميع للمنتجات الصيدلانية مع صيغها وطرق تحضيرها)",
 "フォーム": "صُورَة, شَكْل / اِسْتِمَارَة / شَكَّلَ ((شَكَلَ) الأمْرُ يَشْكُلُ شُكُولاً: الْتَبَسَ؛ (شَكَلَ) المريضُ: تماثَلَ)\nمثال: اجلس بشكل مريح. / رَغْوَة / زَبَد (هو السَمْن الموجود في الحَلِيب يستخرج بأن يُخَضّ الحليب خَضا مستمرا حتى يتكتل بداخله) / زَبَد البَحْر (هو السَمْن الموجود في الحَلِيب يستخرج بأن يُخَضّ الحليب خَضا مستمرا حتى يتكتل بداخله)\nمثال: اشترت رطلي زبدة.",
 "フォームラバー": "مطاط رغوي (مطاط إسفنجي؛ يصنع بإدخال فقاعات الهواء قبل الفلكنة ويستخدم للتبطين أو التنجيد)",
 "フォーム・ラバー": "مطاط رغوي (مطاط إسفنجي؛ يصنع بإدخال فقاعات الهواء قبل الفلكنة ويستخدم للتبطين أو التنجيد)",
 "フォーメーション": "تَشَكُّل / تَشْكِيلَة",
 "フォーラム": "مُنْتَدَى (مَجْلِس؛ موقع إنترنت ينشر فيه المستخدمون مواضيعا ويردون عليها. (إنترنت))\nمثال: أساهم في هذا المنتدى كل يوم.",
 "フォーリナー": "أَجْنَبِيّ, أَجْنَبِيَّة",
 "フォーリン": "أَجْنَبِيّ / غَرِيب, أَجْنَبِيّ",
 "フォーリーズ": "استعراض فوليز (عرض استعراضي بأزياء متقنة)",
 "フォール": "وَقَعَ, سَقَطَ (الشيء: سَقَطَ، انحدر من مكان عال؛ الأمر: حَدَثَ، وأكثر ما يقال للأمر العظيم) / سَقَطَ (تَحَرَّكَ من أعلى إلى أسفل بتأثير الجاذبية، وَقَعَ؛ في كلامه: أخْطَأَ، أو قال قولا لا ينبغي أو لا يريد قوله) / سُقُوط, هُوِيّ (يحمل كافة معاني الفعل بصيغة المصدر)\nمثال: توم وقع و أصيب.",
 "フォールアウト": "أثر جانبي, تداعيات (أي تأثير ثانوي ضار وغير مرغوب فيه) / سقط نووي, غبار ذري (الجسيمات المشعة التي تستقر على الأرض بعد انفجار نووي)\nمثال: استراتيجية لاحتواء تداعيات فضيحة المحاسبة",
 "フォールアウトシェルター": "ملجأ نووي (ملجأ لحماية شاغليه من الغبار النووي الناتج عن قنبلة ذرية)",
 "フォールアウト・シェルター": "ملجأ نووي (ملجأ لحماية شاغليه من الغبار النووي الناتج عن قنبلة ذرية)",
 "フォールス": "زَائِف, بَاطِل / كَاذِب",
 "フォールダ": "مِلَفّ, مُجَلَّد / مُجَلَّد",
 "フォールダー": "مِلَفّ, مُجَلَّد / مُجَلَّد",
 "フォールディング": "طي (عملية الطي) / طي (عملية جيولوجية تسبب انحناء في طبقة صخرية) / طي البروتين (العملية التي يتخذ فيها جزيء البروتين شكله المعقد ثلاثي الأبعاد)\nمثال: قام بطي المناديل طية مزدوجة",
 "フォールディングドア": "باب أكورديون, باب قابل للطي (باب داخلي يفتح عن طريق الطي للخلف في أقسام (بدلاً من التأرجح على مفصلات))",
 "フォールディング・ドア": "باب أكورديون, باب قابل للطي (باب داخلي يفتح عن طريق الطي للخلف في أقسام (بدلاً من التأرجح على مفصلات))",
 "フォールト": "خَطَأ (تعني ضدّ الصواب. يشمل ذلك الفعل، القول، والرأي. يُستخدم الفعل \"أخطأ\" للدلالة على عدم الإصابة…؛ قام بعمل بعيد عن الصواب أو مخالف للحق سواء كان ذلك في السلوك أو القول أو الكتابة) / صَدْع, فَالِق ((صَدَعَ) النباتُ الأرضَ يَصْدَعَ صَدْعًا: شَقَّها وظَهَرَ منها؛ (صَدَعَ) الزجاجَ ونحوه: كسره)\nمثال: كان خطأ حاسوبي.",
 "フォールド": "طي (عملية الطي) / طي (عملية جيولوجية تسبب انحناء في طبقة صخرية) / طي البروتين (العملية التي يتخذ فيها جزيء البروتين شكله المعقد ثلاثي الأبعاد)\nمثال: قام بطي المناديل طية مزدوجة / لفافة (ضمادة مغلفة) / غلاف, غلاف خارجي (الغطاء (عادة من الورق أو السلوفان) الذي يُلف فيه شيء ما)",
 "フォールバック": "انسحاب, فك الاشتباك (وقف عمل عسكري مع عدو)",
 "フォーレスト": "غَابَة, غابة (الغَابَةُ: الأَجَمَةُ ذاتُ الشَّجَرِ المُتَكَاثِف؛ لأَنَّها تُغَيِّبُ مَا فِيهَا. أو الأَجَمَةُ الَّتِي طالتْ، وَلَهَا أَطْراف مُرْتَفِعَةٌ باسِقَة؛ الغابةُ أَجَمة القَصَب، قَالَ: وَقَدْ جُعِلَتْ جماعةَ الشَّجَرِ، لأَنه مأْخوذ مِنَ الغَيابةِ)\nمثال: مشينا في الغابة",
 "フォーレターワード": "كلمة نابية, لفظ فاحش (أي من عدة كلمات قصيرة (غالباً ما تكون من 4 أحرف في الإنجليزية) تُعتبر عموماً بذيئة أو مسيئة)",
 "フォーン": "تَلْفَنَ",
 "フォーントルロイ": "طفل مدلل (صبي مهذب ومتأنق بشكل مفرط)",
 "フォーヴ": "فنان وحشي, وحشي (عضو في مجموعة من الرسامين الفرنسيين الذين اتبعوا المدرسة الوحشية)",
 "フォーヴィスム": "الوحشية (حركة فنية انطلقت عام 1905 تميزت أعمالها بألوان زاهية وغير طبيعية وأشكال بسيطة؛ أثرت على التعبيريين)",
