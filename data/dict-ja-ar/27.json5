 "マグナ・カルタ": "مَاجْنَا كَارْتَا",
 "マグニチュード": "حجم, عِظَم (خاصية الحجم النسبي أو المدى (سواء كان كبيراً أو صغيراً)) / أهمية, جسامة (الأهمية النسبية) / أُسّ عَشْرِيّ, رُتْبَة مِقْدَارِيَّة (رقم مخصص لنسبة كميتين؛ تكون كميتان من نفس الرتبة المقدارية إذا كانت إحداهما أقل من 10 أضعاف الأخرى)\nمثال: حاولوا التنبؤ بمقدار الانفجار",
 "マグネサイト": "مغنسيت (معدن أبيض يتكون من كربونات المغنيسيوم؛ مصدر للمغنيسيوم)",
 "マグネシア": "بيريكلاز, مغنيسيا (معدن صلب أبيض يوجد بشكل طبيعي كأكسيد مغنيسيوم؛ مصدر للمغنيسيوم)",
 "マグネシウム": "مَغْنِيسِيُوم",
 "マグネシヤ": "بيريكلاز, مغنيسيا (معدن صلب أبيض يوجد بشكل طبيعي كأكسيد مغنيسيوم؛ مصدر للمغنيسيوم)",
 "マグネタイト": "ماغنيتيت, مغناطيس طبيعي (أكسيد حديد ينجذب بقوة للمغناطيس)",
 "マグネチック": "مِغْنَاطِيسِيّ",
 "マグネチックインク": "حبر مغناطيسي (حبر يحتوي على جزيئات من مادة مغناطيسية يمكن الكشف عن وجودها بواسطة أجهزة استشعار مغناطيسية)",
 "マグネチック・インク": "حبر مغناطيسي (حبر يحتوي على جزيئات من مادة مغناطيسية يمكن الكشف عن وجودها بواسطة أجهزة استشعار مغناطيسية)",
 "マグネット": "مَغْنَاطِيس",
 "マグネティック": "مِغْنَاطِيسِيّ",
 "マグネト": "مغنيط, مولد مغناطيسي (دينامو صغير بملف ثانوي ينتج جهداً عالياً يتيح للشرارة القفز بين أقطاب شمعة الاحتراق في محرك البنزين)",
 "マグネトロン": "ماجنترون, مغناطيسون (أنبوب مفرغ ثنائي الصمام يتم فيه التحكم في تدفق الإلكترونات من كاثود مركزي إلى أنود أسطواني بواسطة مجالات مغناطيسية وكهربائية متقاطعة؛ يستخدم بشكل…)",
 "マグノリア": "مَغْنُولِيَة",
 "マグマ": "صُهَارَة, مَاغْمَا",
 "マグレ": "تريماتودا, مثقوبات (ديدان مفلطحة طفيلية لها ممصات خارجية للالتصاق بالمضيف) / فلق (أي من فصي ذيل الحيتان) / سن المرساة, مخلب المرساة (نتوء مسطح يشبه النصل على ذراع المرساة) / سن الخطاف (شوكة في حربة أو سهم)",
 "マグレブ": "رفع مغناطيسي, ماجليف (تكنولوجيا سكك حديدية عالية السرعة؛ حيث يُعلق القطار على وسادة مغناطيسية فوق مسار ممغنط ويسافر دون احتكاك) / اَلْمَغْرِب, اَلْمَغْرِب اَلْعَرَبِيّ ( رَسْمِيّاً الْمَمْلَكَة الْمَغْرِبِيَّة، هُوَ الْبَلَد الَّذِي يَقَع فِي أقْصَى شَمَال غَرْب القَارَّة الإِفْرِيقية؛  مَجْمُوعَةُ دُوَلٍ تقَع شَمَال غربَ إفْريقيا، وَتَضُمُّ اَلْمَغْرِب وَمُورِيتَانْيَا وَالْجَزَائِر وَتُونُس وَلِيبْيَا)\nمثال: يعيش في المغرب.",
 "マグロ": "تُونَة, تُنّ / نَجْمَةُ اَلْبَحْرِ",
 "マグロ女": "نَجْمَةُ اَلْبَحْرِ",
 "マグ・カップ": "كُوب, قَعْب (إناء للشرب لا عروة له؛ كل إناء للشرب. (تعميم)(غير معياري))\nمثال: الكوب مليء بالحليب.",
 "マグ・ショット": "صورة جنائية (صورة لوجه شخص ما (خاصة تلك التي تؤخذ لسجلات الشرطة))",
 "マケドニア": "مَقْدُونِيَا, مَكْدُونِيَا / مَقْدُونِيَا",
 "マゲイ": "كانتالا, ماغوي (نبات فلبيني ينتج أليافاً صلبة تستخدم في صنع الخيوط الخشنة) / ماغوي (نبات مكسيكي يستخدم خاصة لصنع البولكي وهو مصدر لمشروب المسكال المكسيكي عديم اللون)",
 "マコロン": "ماكارون (حلوى تعتمد على الميرانغ وتُصنع من بياض البيض والسكر البودرة والسكر الحبيبي ومسحوق اللوز أو اللوز المطحون وملونات الطعام)",
