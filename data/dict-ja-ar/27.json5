 "フイにする": "إسراف, تبديد (نشاط غير مجدٍ أو غير مربح؛ استخدام أو إنفاق أو استهلاك بلا تفكير أو بإهمال) / قَفْر, مَهْجُور (في منطقة نائية وموحشة؛ خَرِبة) / إضرار بالمال, تبديد الممتلكات ((قانون) انخفاض في قيمة العقار ناتج عن فعل أو إهمال) / إتلاف, إهدار (سمة إهدار الموارد)\nمثال: إذا لم يحقق الجهد أي مكسب تعويضي فهو هدر",
 "フイゴ": "مِنْفَاخ",
 "フイニッシュ": "فَرَغَ, أَنْهَى / اِنْتَهَى (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات)\nمثال: انتهى أمر زيري. / هُبُوط / بَسْطَة",
 "フイフイきょう": "الْإِسْلَام",
 "フイリピン": "الْفِلِبِّين (دولة في جنوب شرق آسيا؛ اسمها الرسمي جمهورية الفلبين، وعاصمتها مانيلا؛ جزر الفلبين، أرخبيل في جنوب شرق قارة آسيا يمثل أساس جمهورية الفلبين)\nمثال: الفلبين بلد كاثوليكي أساسا.",
 "フイルム": "غِطَايَة, غشاوة / فِلْم, فيلم (شريط من السِّلِيلُوز تعلوه قشرة من الجلاتين ومن برومور الفِضَّة يستعمل للتصوير الفوتوغرافي والسينمائي؛ قصة سينمائية، نتاج سينمائي: «فلم تاريخي»)\nمثال: استمر الفلم ساعتين.",
 "フゥオグゥオ": "هوت بوت (يخنة من اللحم والبطاطس مطبوخة في قدر محكم الغطاء)",
 "フゥフゥ": "شهقة, لهاث (سحب قصير ومجهد للنفس مع فتح الفم)\nمثال: أطلقت شهقة وأغمي عليها / مُكَافِح (منخرط في كفاح للتغلب خاصة على الفقر أو الغموض)",
 "フウぞく": "شجرة الصمغ الحلو, ليكيدامبار (أي شجرة من جنس ليكيدامبار) / صمغ حلو, ليكوييد آمبر (إفراز عطري من شجرة الصمغ الحلو)",
 "フウっと": "فَجْأَةً",
 "フウセンカズラ": "بازلاء القلب, كرمة البالون (نبات متسلق معمر خشبي ذو قرون بذور زينة كبيرة تشبه البالونات؛ الهند الاستوائية وإفريقيا وأمريكا)",
 "フウッと": "فَجْأَةً",
 "フウフウ": "شهقة, لهاث (سحب قصير ومجهد للنفس مع فتح الفم)\nمثال: أطلقت شهقة وأغمي عليها / مُكَافِح (منخرط في كفاح للتغلب خاصة على الفقر أو الغموض)",
 "フウロソウ": "غُرْنُوق / جِيرَانِيُوم",
 "フウ属": "شجرة الصمغ الحلو, ليكيدامبار (أي شجرة من جنس ليكيدامبار) / صمغ حلو, ليكوييد آمبر (إفراز عطري من شجرة الصمغ الحلو)",
 "フェ": "مِعْزَقة",
 "フェア": "أَشْقَر (هو لون الشُقْرَة، وأصله اللون الأحمر المائل إلى الصُفرة ثم أصبح يطلق على ما كان لونه أصفر أيضا؛ صفة ما كان لونه الشُقرة) / حَقَّانِيّ, عادِل / مَأْذُون, مُبَاح\nمثال: أنا لديها شعر بني كستنائي, ولكن ماجدالينا لديها شعر أشقر. / كرة صحيحة, كرة عادلة ((بيسبول) كرة تضرب بالمضرب بحيث تبقى بين الخطوط (خطوط الفاول) التي تحدد عرض ملعب اللعب)",
 "フェアウェイ": "الممر (المنطقة بين نقطة الانطلاق والمنطقة الخضراء حيث يتم قص العشب قصيراً (في الجولف)) / ممر سالك (قطعة أرض خالية من العوائق للحركة) / ممر ملاحي (المسار المعتاد الذي تسلكه السفن عبر الميناء أو المياه الساحلية)",
 "フェアウェー": "الممر (المنطقة بين نقطة الانطلاق والمنطقة الخضراء حيث يتم قص العشب قصيراً (في الجولف)) / ممر سالك (قطعة أرض خالية من العوائق للحركة) / ممر ملاحي (المسار المعتاد الذي تسلكه السفن عبر الميناء أو المياه الساحلية)",
 "フェアウエイ": "الممر (المنطقة بين نقطة الانطلاق والمنطقة الخضراء حيث يتم قص العشب قصيراً (في الجولف)) / ممر سالك (قطعة أرض خالية من العوائق للحركة) / ممر ملاحي (المسار المعتاد الذي تسلكه السفن عبر الميناء أو المياه الساحلية)",
 "フェアウエー": "الممر (المنطقة بين نقطة الانطلاق والمنطقة الخضراء حيث يتم قص العشب قصيراً (في الجولف)) / ممر سالك (قطعة أرض خالية من العوائق للحركة) / ممر ملاحي (المسار المعتاد الذي تسلكه السفن عبر الميناء أو المياه الساحلية)",
 "フェアガンゲンハイト": "مَاضٍ, الْمَاضِي ((في النحو) زمن نحوي يدل على حدث قد وقع، أو وُجِد قبل الآن بوقت ما) / بَعْدَ (يدل على اللحاق في الزمان؛ يكون مضافا، وينصب أو يجر)",
 "フェアキャッチ": "التقاط حر ((كرة القدم الأمريكية) التقاط ركلة تشتيت في الهواء من قبل لاعب دفاعي أشار بأنه لن يركض وبالتالي لا ينبغي عرقلته)",
 "フェアコピー": "مبيضة, نسخة منقحة (نسخة نظيفة من مسودة مصححة)",
 "フェアセックス": "الجنس اللطيف, النساء (النساء كطبقة)\nمثال: إنها إهانة للنساء الأمريكيات",
 "フェアトレード": "تجارة مشروعة (التجارة التي تتم بشكل قانوني) / تجارة عادلة (تجارة تستوفي معايير معينة في سلسلة توريد السلع المعنية، تشمل عادة دفعاً عادلاً للمنتجين؛ وغالباً مع اعتبارات اجتماعية وبيئية أخرى)",
 "フェアプレー": "لَعْب عَادِل (فعل شيئا للتسلية والترفيه، شَارَكَ في لعبة)\nمثال: لعب زيري التنس.",
 "フェアボール": "كرة صحيحة, كرة عادلة ((بيسبول) كرة تضرب بالمضرب بحيث تبقى بين الخطوط (خطوط الفاول) التي تحدد عرض ملعب اللعب)",
 "フェアユース": "استخدام عادل (الشروط التي يمكنك بموجبها استخدام مواد محمية بحقوق الطبع والنشر لشخص آخر دون دفع رسوم)",
 "フェアリング": "أَشْقَر (هو لون الشُقْرَة، وأصله اللون الأحمر المائل إلى الصُفرة ثم أصبح يطلق على ما كان لونه أصفر أيضا؛ صفة ما كان لونه الشُقرة) / حَقَّانِيّ, عادِل / مَأْذُون, مُبَاح",
 "フェアリー": "جِنِّيَّة, سَاحِرَة",
 "フェアリーテール": "قِصَّة خُرَافِيَّة, خُرَافَة",
 "フェアリーランド": "أرض الجنيات, عالم الخيال (عالم الجنيات المسحور) / أرض الخيال, عالم خيالي (شيء موجود فقط في الخيال (ولكن غالبًا ما يُخطئ في اعتباره واقعًا))",
 "フェア・キャッチ": "التقاط حر ((كرة القدم الأمريكية) التقاط ركلة تشتيت في الهواء من قبل لاعب دفاعي أشار بأنه لن يركض وبالتالي لا ينبغي عرقلته)",
 "フェア・コピー": "مبيضة, نسخة منقحة (نسخة نظيفة من مسودة مصححة)",
 "フェア・セックス": "الجنس اللطيف, النساء (النساء كطبقة)\nمثال: إنها إهانة للنساء الأمريكيات",
