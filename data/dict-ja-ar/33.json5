 "写実": "بَرَاغْمَاتِيَّة, وَاقِعِيَّة (سمة قبول حقائق الحياة وتفضيل العملية والحقيقة الحرفية)",
 "写実主義": "بَرَاغْمَاتِيَّة, وَاقِعِيَّة (سمة قبول حقائق الحياة وتفضيل العملية والحقيقة الحرفية)",
 "写実主義者": "وَاقِعِيّ",
 "写実性": "بَرَاغْمَاتِيَّة, وَاقِعِيَّة (سمة قبول حقائق الحياة وتفضيل العملية والحقيقة الحرفية)",
 "写実的": "واقعي (مدرك أو يعبر عن إدراك للأشياء كما هي حقاً)\nمثال: وصف واقعي",
 "写本": "مَخْطُوطَة (مُؤَلَّف المكتوب باليد ، غير المطبوع؛ نُسْخة المؤلِّلف الأصليَّة المُعدَّة للطبع)",
 "写生": "رَسْم تَقْرِيبِيّ, رَسِيمَة (سَم الشَّيءَ :خطّه رسَم مُربَّعًا/ صورةً/ شكلاً؛ رسَم : كَتَبَ)\nمثال: واصل زيري الرسم.",
 "写生帖": "دفتر رسم",
 "写生帳": "دفتر رسم",
 "写生文": "تشخيص, تصوير (وصف لفظي بياني أو حيوي)\nمثال: في كثير من الأحيان كانت الرواية تُقاطع بصور لفظية طويلة",
 "写真": "صُورَة, صُورَة شَمْسِيَّة\nمثال: あなたに何枚かの写真を見せましょう。 — سأريك بعض الصور. / فيلم, فيلم سينمائي (شكل من أشكال الترفيه يجسد قصة بالصوت وتسلسل من الصور يعطي وهماً بالحركة المستمرة)\nمثال: ذهبوا لمشاهدة فيلم كل ليلة سبت",
 "写真をとる": "اِلْتَقَطَ صُورَةً",
 "写真を写す": "صُورَة, صُورَة شَمْسِيَّة",
 "写真を撮る": "اِلْتَقَطَ صُورَةً",
 "写真フィルム": "فيلم, فيلم فوتوغرافي (مادة فوتوغرافية تتكون من قاعدة من السيلولويد مغطاة بمستحلب فوتوغرافي؛ تستخدم…)",
 "写真乳剤": "مستحلب, مستحلب فوتوغرافي (طلاء حساس للضوء على الورق أو الفيلم؛ يتكون من حبيبات دقيقة من بروميد الفضة…)",
 "写真乾板": "لوح جاف (طريقة تصوير سابقة استخدمت لوحاً زجاجياً مطلياً بمستحلب جيلاتيني حساس للضوء)",
 "写真写りがいい": "حَسَن المَظْهَر فِي الصُّوَر, فُوتُوجِينِيّ (يبدو جذاباً في الصور الفوتوغرافية)",
 "写真判定決勝": "نهاية متقاربة جداً, نهاية مصورة (بشكل عام، أي نهاية متقاربة جداً؛ وتحديداً، نهاية سباق يكون فيه المتسابقون…)",
 "写真家": "مُصَوِّر, مُصَوِّرَة",
 "写真屋": "مُصَوِّر, مُصَوِّرَة",
 "写真帖": "أَلْبُوم صُوَر (كتاب صفحاته من الجيوب الشَّفافة لحفظ الصّور، والطوابع، والتوقيعات والنقود…)",
 "写真師": "مُصَوِّر, مُصَوِّرَة",
 "写真帳": "ألبوم صور (ألبوم للصور الفوتوغرافية)",
 "写真撮影": "تَصْوِير, فُوتُوغْرَافِيَّا",
 "写真機": "كَمِرَة, كَامِيرَا",
 "写真濃度": "امتصاصية, كثافة ضوئية ((فيزياء) مقياس لمدى نقل المادة للضوء أو الإشعاع الكهرومغناطيسي الآخر)",
 "写真版": "جهاز تصوير, فوتوستات (آلة نسخ تقوم بعمل نسخ موجبة أو سالبة سريعة مباشرة على سطح ورق محضر)",
 "写真用紙": "ورق تصوير (ورق حساس للضوء يمكن طباعة صورة فوتوغرافية عليه)",
 "写真石版": "طباعة حجرية ضوئية, فوتو ليثوغرافيا (عملية طباعة مستوية تستخدم ألواحاً مصنوعة من صورة فوتوغرافية)",
 "写真術": "تَصْوِير, فُوتُوغْرَافِيَّا",
 "写真製版": "لوحة تظليل, نقش ضوئي (نقش يستخدم لإعادة إنتاج رسم توضيحي)",
 "写真複写機": "نَاسِخَة, نَاسِخَة ضَوْئِيَّة",
 "写真記者": "مصور صحفي (صحفي يقدم القصة بشكل أساسي من خلال استخدام الصور الفوتوغرافية)",
 "写真電送": "إبراق ضوئي, إرسال صور بالتلغراف (تقنية مبكرة لنقل النسخ المماثلة (الفاكس))\nمثال: وجه آيفز انتباهه بعد ذلك إلى التلفزيون، الذي اعتبره مجرد شكل مسرع من الإبراق الضوئي",
 "写象": "صُورَة",
 "冠": "تَاج, إِكْلِيل / أَفْضَل / اِسْم, أَسْمَاء (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه…)\nمثال: ما اسم حصان توم؟ / تَرْتِيب, نِظَام (تنظيم الأشياء أو الأحداث في تسلسل معين أو وضعها في نظام؛ إعداد أو تجهيز شيء…)\nمثال: أعاد زيري ترتيب المطبخ كلية.",
 "冠す": "تَاج, إِكْلِيل / أصلاً, في المقام الأول (قبل الآن)\nمثال: لماذا لم تخبرني في المقام الأول؟",
 "冠する": "تَاج, إِكْلِيل / أصلاً, في المقام الأول (قبل الآن)\nمثال: لماذا لم تخبرني في المقام الأول؟",
 "冠たる": "أَفْضَل",
 "冠る": "لَبِسَ, اِرْتَدَى (خَلَطَ بحيث يصعب التمييز والفصل؛ الأمر: خلطه فاشتبه واضطرب)\nمثال: لبس سروالا نظيفا. / دُبّ / تراكب, طية (لسان يقع فوق جزء آخر)\nمثال: يجب أن يكون تراكب القرميد عشر بوصات على الأقل / أَغْلَقَ, سَكَّر (ضد فَتَحَ؛ سَدَّ وسَكَّرَ؛ قد تستخدم بمعنى أَقْفَلَ؛ أغلقه بحيث لا يفتح إلا…)\nمثال: أغلق الباب بغضب",
 "冠不全": "قُصُور الشِّرْيَان التَّاجِيّ, قُصُور القَلْب (تدفق غير كافٍ للدم إلى عضلات القلب؛ يمكن أن يسبب ذبحة صدرية)",
 "冠動脈": "شريان تاجي (الشريان الذي يتفرع من الأبهر لتغذية القلب بالدم)",
