 "分ち": "تَمْيِيْز",
 "分ちあう": "نَصِيب, حِصَّة / سَهْم (سَهَمَ؛ سَهَّمَ) / شَارَكَ\nمثال: لم يصب السهم توم.",
 "分ち与える": "نَصِيب, حِصَّة / سَهْم (سَهَمَ؛ سَهَّمَ) / شَارَكَ\nمثال: لم يصب السهم توم.",
 "分ち合う": "نَصِيب, حِصَّة / سَهْم (سَهَمَ؛ سَهَّمَ) / شَارَكَ\nمثال: لم يصب السهم توم.",
 "分つ": "قَسَّمَ (فَرَّقَ أو قَسَّمَ الشَّيءَ إلى أجزاء أو أجزاء مختلفة؛ أَحْلَفَ، أَي جَعَلَ يَحْلِفُ على أمرٍ ما)\nمثال: أنا أزين القسم. / نَصِيب, حِصَّة / سَهْم (سَهَمَ؛ سَهَّمَ) / شَارَكَ\nمثال: لم يصب السهم توم.",
 "分にすぎた": "غَيْر مُسْتَحَقّ (لم يحن موعد استحقاقه بعد) / زَائِد, غَيْر مُنَاسِب (غير مناسب أو غير لائق (أو حتى قانوني) في الظروف الحالية) / غَيْرُ مَعْقُول, مُفْرِط (يَتَجَاوَزُ الحُدُودَ الطَّبِيعِيَّة) / غَيْرُ مُبَرَّرٍ, غَيْرُ مُسَوَّغٍ (يفتقر إلى التبرير أو التفويض)\nمثال: قرض غير مستحق",
 "分に過ぎた": "غَيْر مُسْتَحَقّ (لم يحن موعد استحقاقه بعد) / زَائِد, غَيْر مُنَاسِب (غير مناسب أو غير لائق (أو حتى قانوني) في الظروف الحالية) / غَيْرُ مَعْقُول, مُفْرِط (يَتَجَاوَزُ الحُدُودَ الطَّبِيعِيَّة) / غَيْرُ مُبَرَّرٍ, غَيْرُ مُسَوَّغٍ (يفتقر إلى التبرير أو التفويض)\nمثال: قرض غير مستحق",
 "分の悪い": "ضَارّ, غَيْر مُفِيد (ينطوي على أو يخلق ظروفاً تضر بالنجاح أو الفعالية)\nمثال: نتيجة غير مواتية",
 "分べん": "مَخَاض, وَضْع",
 "分り": "فَهْم (فهم الأمر أو الكلام أو نحو ذلك، أدركه، علمه، أحسن تصوّره، استوعبه) / رُؤْيَة / تَفَاهُم / فهم (فهم الأمر أو الكلام أو نحو ذلك، أدركه، علمه، أحسن تصوّره، استوعبه)\nمثال: لقد أسئت الفهم.",
 "分る": "فَهِمَ (فهم الأمر أو الكلام أو نحو ذلك، أدركه، علمه، أحسن تصوّره، استوعبه)\nمثال: لقد أسئت الفهم. / أَظُنُّ ذٰلِك",
 "分れ目": "شَوْكَة, مِذْرَاة (أداة لتناول الطعام تتكون عادةً من مقبض وعدة أسنان حادة، وتُستعمل لغرز الطعام وحمله إلى الفم) / تَفَرَّعَ / تَشَعَّبَ\nمثال: هناك شوكة ناقصة. / نقطة تحوّل (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه)\nمثال: هذه هي نقطة ضعفه.",
 "分与": "تَوْزِيع",
 "分会": "فَرْع, غُصْن",
 "分体": "اِنْقِسَام / انقسام",
 "分光": "تَشَتُّت",
 "分光光度計": "مقياس الطيف الضوئي (مقياس ضوئي لمقارنة إشعاعين ضوئيين طول موجة بطول موجة)",
 "分光写真機": "مخطط طيفي (سجل فوتوغرافي للطيف) / مرسمة الطيف (مقياس طيف يمكن من خلاله تصوير الأطياف)",
 "分光分析": "تحليل طيفي, مطيافية (استخدام المناظير الطيفية لتحليل الأطياف)",
 "分光器": "مِطْيَاف",
 "分光学": "تحليل طيفي, مطيافية (استخدام المناظير الطيفية لتحليل الأطياف)",
 "分光法": "تحليل طيفي, مطيافية (استخدام المناظير الطيفية لتحليل الأطياف)",
 "分光測定": "تحليل طيفي, مطيافية (استخدام المناظير الطيفية لتحليل الأطياف)",
 "分光計": "مِطْيَاف",
 "分冊": "حزمة ألياف, حزمة عصبية (حزمة من الألياف (خاصة الألياف العصبية)) / كراسة, ملزمة (جزء من عمل مطبوع)",
 "分別": "حسن تقدير, فطنة (سمة الحكم بحكمة وموضوعية) / تقدير, حرية الإرادة (القدرة على اتخاذ خيارات حرة دون قيود خارجية) / تحفظ, تكتم (معرفة كيفية تجنب الإحراج أو الضيق) / رقة, كياسة (ذوق رفيع؛ لباقة في التصرف)\nمثال: رجل ذو فطنة / تَفْرِقَة",
 "分別心": "عَقْل, حَنْك (أمسك بأطرافه وربطه، أصلها للشاة والإبل حيث تربط قوائمها كي تبقى باركة فلا تقوم؛ بلغ العَقْل، أصبح عاقلا فاهما راشدا)\nمثال: هي فتاة تسحر العقل.",
 "分別蒸留": "تقطير تجزيئي (تجزئة سائل عن طريق التقطير)",
 "分利": "أَزْمَة, بُحْرَان / أَزْمَة",
 "分割": "تَقْسِيم / مُعَدَّل (هو الأمر الذي جرى عليه تَعْدِيل فهو أفضل من ما يناظره؛ السيارة المعدّلة تسير بسرعة أكبر من مثيلاتها) / سِعْر (سَعِرَ يَسْعَرَ سَعَراً، وسُعْرَةً: ضرب لونه إِلى السواد فُوَيْقَ الأُدْمة؛ فهو أَسْعَرُ، وهي سَعْراءُ. والجمع: سُعْرٌ)\nمثال: انخفض معدل الجريمة. / عُمُولَة",
 "分割払い": "تقسيط, شراء إيجاري (خطة تقسيط)\nمثال: اشترينا سيارة بالتقسيط",
 "分割機": "فرجار تقسيم, مقسم (أداة رسم تشبه الفرجار تستخدم لتقسيم الخطوط إلى أجزاء متساوية أو لنقل القياسات) / حاجز, فاصل (هيكل عمودي يقسم أو يفصل (مثل الجدار الذي يفصل غرفة عن أخرى)) / مُقَسِّم (شخص يفصل شيئاً ما إلى أجزاء أو مجموعات) / مُقسِّم (عالم تصنيف يصنف الكائنات الحية في مجموعات عديدة بناءً على خصائص ثانوية نسبياً)",
 "分割統治": "فَرِّقْ تَسُدْ",
 "分割線": "حد فاصل, خط فاصل (فصل أو تمييز مفاهيمي)\nمثال: هناك خط رفيع بين العقل والجنون",
 "分化": "اختصاص, تخصص (مجال العمل الخاص الذي اتخذته كمسار مهني) / تخصص (فعل التخصص؛ جعل الشيء مناسباً لغرض خاص) / تخصص, تمايز ((في الأحياء) التكيف الهيكلي لجزء من الجسم لوظيفة معينة)\nمثال: تخصصه هو أمراض الجهاز الهضمي",
 "分厘": "أبداً, بتاتاً (بأدنى درجة أو بأي حال من الأحوال) / على الإطلاق, ولو قليلاً (إلى أي مدى كان)\nمثال: هل أنت مهتم على الإطلاق؟ لا، على الإطلاق",
 "分厚": "سَمِيك, غَلِيظ / غَلِيظ",
 "分厚い": "سَمِيك, غَلِيظ / غَلِيظ",
 "分取": "تجزئة (الفصل إلى أجزاء أو حصص) / تجزئة, تقطير تجزيئي (عملية تستخدم الحرارة لفصل مادة إلى مكوناتها)",
 "分周": "تَقْسِيم / قِسْمَة (في : هو أن أحد العمليات الحسابية الرئيسية، ضد الضَرْب) / قِسْمَةٌ (في : هو أن أحد العمليات الحسابية الرئيسية، ضد الضَرْب) / فِرْقَة / فُرْقَة\nمثال: الزواج قسمة و نصيب.",
 "分営": "مخفر أمامي (موقع عسكري متمركز على مسافة من الجسم الرئيسي للقوات) / مخفر حدودي, مستوطنة حدودية (مستوطنة على حدود الحضارة) / مخفر أمامي, نقطة نائية (محطة في موقع ناء أو قليل السكان)",
 "分団": "فَرْع, غُصْن",
 "分圧器": "مقسم الجهد (مقاومات متصلة على التوالي عبر مصدر جهد؛ تستخدم للحصول على جزء مطلوب من الجهد)",
 "分外": "مُفْرِط, زَائِد",
 "分娩": "مَخَاض, وَضْع",
 "分娩予定日": "مَوْعِد (مَوْعِد الإفطار،أي وقت الإفطار؛ لديه مَوْعِد مع صديق)\nمثال: مناد عنده موعد.",
 "分娩作用": "تَوْصِيل, تَسْلِيم / مَخَاض, وَضْع / إِلْقَاء (إِلْقَاءُ الشَّبَكَةِ فِي البَحْرِ : رَمْيُها؛ إِلْقاءُ مُحَاضَرَةٍ : إعْطَاؤُهُا، أَي الحَدِيثُ فِي مَوْضُوعٍ أَمَامَ جَمْهُورٍ)\nمثال: مروا بسرعة و بدون إلقاء نظرة.",
 "分娩臥床": "طلق, مخاض (المرحلة الختامية للحمل؛ من بداية الانقباضات حتى ولادة الطفل)\nمثال: كانت في المخاض لمدة ست ساعات",
 "分子": "جُزَيْء / بَسْط (بَسَطَ الأمورَ أَمامَهُ : عَرَضَها وَكَشَفَ عَنْها، عَرَضَها عَلَيْهِ بَسَطَتِ العُلومُ آفاقاً جَديدَةً أَمامَ الإِنْسانِ؛ بَسَطَ العُذْرَ : قَدَّمَهُ، أَبْداهُ)\nمثال: بسط توم الجريدة على الطاولة. / عُنْصُر كِيمِيَائِيّ, عُنْصُر (الْأَصْل؛ الجِنْس)\nمثال: المغنيزيوم عنصر كيميائي. / جُسَيْم, ذَرَّة (في الفيزياء: الجُسيْمات التحت ذريّة، أي الجُسيْمات الأوليّة والمركّبة (معنى مستحدث)) / جُسَيْم (في الفيزياء: الجُسيْمات التحت ذريّة، أي الجُسيْمات الأوليّة والمركّبة (معنى مستحدث))\nمثال: نحن نعيش بعض اللحظات الحزينة حقا لأن بلادنا عانت من خسارة جسيمة. وسوف يستغرق وقتا طويلا قبل أن تعود إلى مجدها السابق.",
 "分子式": "صيغة جزيئية (صيغة كيميائية تعتمد على التحليل والوزن الجزيئي)",
 "分子生物学": "بيولوجيا جزيئية (فرع علم الأحياء الذي يدرس بنية ونشاط الجزيئات الكبيرة الضرورية للحياة)",
 "分子軌道": "موليبدنوم (عنصر فلزي متعدد التكافؤ يشبه الكروم والتنجستن في خصائصه) / دقيقة, لحظة (وقت قصير غير محدد)\nمثال: انتظر لحظة فقط",
 "分子遺伝学": "علم الوراثة الجزيئي (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "分子量": "كتلة جزيئية نسبية, وزن جزيئي ((في الكيمياء) مجموع الكتل الذرية النسبية للذرات المكونة للجزيء)",
 "分室": "توسعة, جناح (إضافة توسع المبنى الرئيسي)",
 "分宿": "مسكن عسكري (سكن للأفراد العسكريين (خاصة في منزل خاص)) / رسالة قصيرة, ملاحظة (رسالة شخصية قصيرة)\nمثال: اكتب لي رسالة قصيرة عندما تصل هناك",
 "分封": "ثَوْل (بدا فيه الجنون) / اِزْدِحَام",
 "分屯": "نَائِب, نَائِبَة",
 "分岐": "تباعد, تشعب (عملية الابتعاد في اتجاهات مختلفة عن نقطة مشتركة) / تَبَايُن, تَضَارُب (اختلاف بين حقائق أو ادعاءات أو آراء متعارضة) / تَبَاعُد (متسلسلة لا نهائية ليس لها حد) / اختلاف, انحراف (اختلاف ينحرف عن المعيار أو القاعدة)\nمثال: تتشكل الزاوية من تباعد خطين مستقيمين",
 "分岐器": "دوران للخارج ((باليه) الدوران الخارجي لساق الراقص من الورك) / إِقْبَال (الحضور لحدث أو غرض معين (كما في التصويت في الانتخابات)) / طقم ملابس, هندام (مجموعة متناسقة من الملابس (مع الإكسسوارات)) / إنتاج, مخرجات (ما يتم إنتاجه في فترة زمنية معينة)\nمثال: الإقبال على التجمع",
 "分岐学": "تحليل تفرعي, تفرع حيوي (نظام تصنيفي لتصنيف الأنواع بناءً على أنماط التفرع)",
 "分岐点": "شَوْكَة, مِذْرَاة (أداة لتناول الطعام تتكون عادةً من مقبض وعدة أسنان حادة، وتُستعمل لغرز الطعام وحمله إلى الفم) / تَفَرَّعَ / تَشَعَّبَ\nمثال: هناك شوكة ناقصة. / نقطة تحوّل (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه)\nمثال: هذه هي نقطة ضعفه.",
 "分岐線": "خط فرعي (خط سكة حديد متصل بخط رئيسي)",
 "分岐群": "زمرة, فَرْع حَيَوِي (مجموعة من الأصناف البيولوجية أو الأنواع التي تشترك في سمات موروثة من سلف مشترك)",
 "分岐駅": "ربط, وصل (عملية ضم أو إلحاق الأشياء) / تقاطع, نقطة اتصال (المكان الذي يجتمع فيه شيئان أو أكثر) / ملتقى, نقطة اتصال (شيء يربط أو يصل) / مفصل, ملتقى (الشكل أو الطريقة التي تلتقي بها الأشياء ويتم الاتصال)",
 "分布": "تَوْزِيع",
 "分庁舎": "مبنى حكومي (مبنى يضم فرعاً من فروع الحكومة)",
 "分度器": "مِنْقَلَة",
 "分引き": "خَصْم, تَخْفِيض (الخَصْمُ :مُجَادِل، مُنَازِع، مُخَاصِم، عكسه حَلِيف أو صَدِيْق، وقد يستوي فيه المفرد والمثنى والجمع؛ والخَصْمُ (في ) : حَطِيطَة)",
 "分担": "تَوَزُّع\nمثال: 私達は、家事を分担することで合意した。 — اتفقنا على توزيع مهام تنظيف البيت فيما بيننا.",
 "分担金": "مُسَاهَمَة (المُساهَمَة : المُشاركة والاشتراك في الشيء)\nمثال: ويستطيع الجميع المساهمة.",
 "分担額": "مُسَاهَمَة (المُساهَمَة : المُشاركة والاشتراك في الشيء)\nمثال: ويستطيع الجميع المساهمة.",
 "分捕り": "إمساك, التقاط (فعل التقاط شيء باليدين) / خطف (رفعة أوزان يتم فيها رفع البار فوق الرأس في حركة واحدة سريعة) / اختطاف, خطف ((قانون) العمل غير القانوني المتمثل في القبض على شخص وحمله بعيداً رغماً عنه واحتجازه في سجن زائف) / فرج (مصطلحات بذيئة للأعضاء التناسلية الأنثوية)\nمثال: أمسك ميس بالكرة وظهره للوحة",
 "分捕り品": "نَهَبَ",
 "分捕り物": "نَهَبَ",
 "分捕品": "نَهَبَ",
 "分掌": "إِقْتِسَام, مُقَاسَمَة",
 "分散": "تَشَتُّت / تَبَايُن",
 "分散データ処理": "معالجة بيانات موزعة, معالجة عن بعد (معالجة البيانات التي يتم فيها تنفيذ بعض الوظائف في أماكن مختلفة ومتصلة بمرافق الإرسال)",
 "分散分析": "أنوفا, تحليل التباين (طريقة إحصائية لإجراء مقارنات متزامنة بين متوسطين أو أكثر)",
 "分散分析法": "أنوفا, تحليل التباين (طريقة إحصائية لإجراء مقارنات متزامنة بين متوسطين أو أكثر)",
 "分散化": "لامركزية (نشر السلطة بعيداً عن المركز إلى الفروع المحلية أو الحكومات) / لامركزية (العملية الاجتماعية التي ينتقل فيها السكان والصناعة من المراكز الحضرية إلى المناطق النائية)",
 "分散和音": "آربيج, تفكيك الكورد (كورد تُعزف نوتاته بتتابع سريع بدلاً من عزفها في آن واحد)",
 "分散型": "تَوْزِيع",
 "分散媒": "طور مشتِّت, وسط التشتت ((في الغرويات) مادة يتم فيها تشتيت مادة أخرى غروياً)",
 "分散相": "جسيمات مشتتة, طور مشتت ((في الغرويات) مادة في الحالة الغروية)",
 "分散質": "جسيمات مشتتة, طور مشتت ((في الغرويات) مادة في الحالة الغروية)",
 "分数": "قِطْعَة (القِطْعَةُ: الْجُزْءَ أو الحِصَّة من الشيءِ؛ القِطْعَةُ: فقرة قصيرة عادة من مقالٍ أو كتاب) / كَسْر, كُسُور\nمثال: يصنع قطعة أثاث خشبية.",
 "分断前部": "يَتِيم / يَتِيمَة",
 "分断後部": "أَرْمَلَة",
 "分断線": "حد فاصل, خط فاصل (فصل أو تمييز مفاهيمي)\nمثال: هناك خط رفيع بين العقل والجنون",
 "分明": "صَفَاء, نَقَاء (صفة الماء الصافي) / جَلَاء, صَفَاء (الخلو من الغموض وسهولة الفهم؛ قابلية التعبير الواضح للفهم)\nمثال: عندما استيقظت عاد الصفاء إلى عينيها",
 "分析": "تَحْلِيل / تَحْلِيل رِيَاضِيّ / تَحْلِيلْ مُخْتَبَرِيّ",
 "分析器": "جهاز تحليل, محلل (أداة تقوم بإجراء التحليلات)",
 "分析学": "تَحْلِيلَات",
 "分析官": "مُحَلِّل, مُتَخَصِّص",
 "分析家": "مُحَلِّل, مُتَخَصِّص",
 "分析的": "تَحْلِيلِيّ (لقضية تكون صحيحة بالضرورة بغض النظر عن الحقيقة أو التجربة) / تَحْلِيلِيّ (يستخدم أو ماهر في استخدام التحليل (أي فصل الكل - الفكري أو الجوهري - إلى أجزائه العنصرية أو مبادئه الأساسية))\nمثال: 'كل العوانس غير متزوجات' هي قضية تحليلية",
 "分析者": "مُحَلِّل, مُتَخَصِّص",
 "分析試験": "تحليل مخبري, مقايسة (اختبار كمي أو نوعي لمادة (خاصة خام أو دواء) لتحديد مكوناتها؛ يستخدم بشكل متكرر لاختبار وجود أو تركيز العوامل المعدية أو الأجسام المضادة وما إلى ذلك) / اختبار, تدقيق (تقييم لحالة الأمور) / تقرير تحليل, تقرير فحص (تقرير مكتوب عن نتائج تحليل تكوين مادة ما) / عينة الفحص, مادة الاختبار (مادة تخضع لتحليل مكوناتها)\nمثال: قاموا بفحص المحتويات",
 "分枝": "تشعب ثنائي, تفرع ثنائي (عملية الانقسام إلى فرعين) / تشعب (المكان الذي ينقسم فيه الشيء إلى فرعين) / تشعب (فرع متشعب (واحد أو كلاهما)) / ذُو فُرُوع, مُتَفَرِّع (لَهُ فُرُوعٌ أَوْ أَغْصَان) / شَوْكِيّ, مُتَشَعِّب (يشبه الشوكة؛ منقسم أو منفصل إلى فرعين)",
 "分格": "تَبْعِيضِيّ",
 "分業": "تَقْسِيم الْعَمَل",
 "分極": "استقطاب (الظاهرة التي يتم فيها تقييد اتجاه اهتزاز موجات الضوء أو غيرها من الإشعاعات) / استقطاب (حالة امتلاك أو إعطاء قطبية)",
 "分極化": "استقطاب (الظاهرة التي يتم فيها تقييد اتجاه اهتزاز موجات الضوء أو غيرها من الإشعاعات) / استقطاب (حالة امتلاك أو إعطاء قطبية)",
 "分権化": "لامركزية (نشر السلطة بعيداً عن المركز إلى الفروع المحلية أو الحكومات) / لامركزية (العملية الاجتماعية التي ينتقل فيها السكان والصناعة من المراكز الحضرية إلى المناطق النائية)",
 "分母": "قَاسِم, مَقَام",
 "分水山脈": "حدث مفصلي, علامة بارزة (حدث يمثل تغييراً تاريخياً فريداً أو مهماً في المسار أو تعتمد عليه تطورات مهمة) / حوض النهر, مستجمع مائي (المنطقة الجغرافية الكاملة التي يصرفها النهر وروافده؛ منطقة تتميز بتدفق جميع مياه الجريان السطحي إلى نفس المخرج) / خط تقسيم المياه, مستجمع مائي (حيد من الأرض يفصل بين نظامين نهريين متجاورين)\nمثال: كانت الاتفاقية نقطة تحول في تاريخ كلتا الدولتين",
 "分水嶺": "حدث مفصلي, علامة بارزة (حدث يمثل تغييراً تاريخياً فريداً أو مهماً في المسار أو تعتمد عليه تطورات مهمة) / حوض النهر, مستجمع مائي (المنطقة الجغرافية الكاملة التي يصرفها النهر وروافده؛ منطقة تتميز بتدفق جميع مياه الجريان السطحي إلى نفس المخرج) / خط تقسيم المياه, مستجمع مائي (حيد من الأرض يفصل بين نظامين نهريين متجاورين)\nمثال: كانت الاتفاقية نقطة تحول في تاريخ كلتا الدولتين / نقطة تحوّل (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه)\nمثال: هذه هي نقطة ضعفه.",
 "分水界": "حدث مفصلي, علامة بارزة (حدث يمثل تغييراً تاريخياً فريداً أو مهماً في المسار أو تعتمد عليه تطورات مهمة) / حوض النهر, مستجمع مائي (المنطقة الجغرافية الكاملة التي يصرفها النهر وروافده؛ منطقة تتميز بتدفق جميع مياه الجريان السطحي إلى نفس المخرج) / خط تقسيم المياه, مستجمع مائي (حيد من الأرض يفصل بين نظامين نهريين متجاورين)\nمثال: كانت الاتفاقية نقطة تحول في تاريخ كلتا الدولتين",
 "分水線": "حدث مفصلي, علامة بارزة (حدث يمثل تغييراً تاريخياً فريداً أو مهماً في المسار أو تعتمد عليه تطورات مهمة) / حوض النهر, مستجمع مائي (المنطقة الجغرافية الكاملة التي يصرفها النهر وروافده؛ منطقة تتميز بتدفق جميع مياه الجريان السطحي إلى نفس المخرج) / خط تقسيم المياه, مستجمع مائي (حيد من الأرض يفصل بين نظامين نهريين متجاورين)\nمثال: كانت الاتفاقية نقطة تحول في تاريخ كلتا الدولتين",
