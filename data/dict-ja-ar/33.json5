 "列宿": "كَوْكَبَة",
 "列島": "أَرْخَبِيل",
 "列席": "حُضُور (فعل التواجد (في اجتماع أو حدث إلخ)) / حضور (عدد الأشخاص الموجودين) / حُضُور, مُوَاظَبَة (تواتر وجود الشخص في مكان ما)\nمثال: زاد الحضور بنسبة 50 في المائة",
 "列席者": "حاضِر, حُضُور (شخص حاضر ومشارك في اجتماع)\nمثال: كان حاضراً دائماً في اجتماعات القسم",
 "列座": "حُضُور (فعل التواجد (في اجتماع أو حدث إلخ)) / حضور (عدد الأشخاص الموجودين) / حُضُور, مُوَاظَبَة (تواتر وجود الشخص في مكان ما)\nمثال: زاد الحضور بنسبة 50 في المائة",
 "列強": "قُوَّة عُظْمَى (ضد الضُعْف، الشِدَّة والقُدْرَة الجِسْمَانِيَّة؛ ضد الضُعْف، المَقْدِرَة والحَوْل والتَمَكُّن، القدرة المعنوية)\nمثال: توم شعر بالقوة.",
 "列挙": "إحصاء, عد (فعل العد؛ تلاوة الأرقام بترتيب تصاعدي) / ترقيم, قائمة مرقمة (قائمة مرقمة)\nمثال: استمر العد لعدة ساعات",
 "列柱": "رِوَاق (مَمَرّ خارج المَبْنَى وملاصق له يمتد عليه السَقْف ويُصفّ على الجانب الآخر الأعمدة؛ في العصر الحديث يُطلق على الممر عامة)\nمثال: ذهب إلى الرواق.",
 "列次": "تَرْتِيب, نِظَام (تنظيم الأشياء أو الأحداث في تسلسل معين أو وضعها في نظام؛ إعداد أو تجهيز شيء لتحقيق غاية معينة) / أَمْر, حُكْم (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة) / طَلَب (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى)) / جَمَاعَة (العَدَد الكثير من النَاس أو الحَيْوَان أو النَبَات أو غيره. المَجْمُوعَة؛ طَائِفَة من الناس التي يجمعها مكان و بيئة واحدة أو تتشارك اهداف و غايات واحدة) / وِسَام / رُتْبَة (رُتْبَة، بضم الراء؛ رَتْبَة، بفتح الراء) / أَمَرَ (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة) / طَلَبَ, حَجَزَ (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى))\nمثال: أعاد زيري ترتيب المطبخ كلية.",
 "列福": "تطويب ((الكنيسة الكاثوليكية) فعل للبابا يعلن فيه أن شخصًا متوفى عاش حياة مقدسة ويستحق التبجيل العام؛ خطوة أولى نحو إعلان القداسة) / تطويب (فعل جعل الشخص مباركاً وسعيداً للغاية) / سعادة قصوى, طوبى (حالة من السعادة العارمة)",
 "列聖": "إعلان القداسة (فعل قبول شخص متوفى في قائمة القديسين)",
 "列記": "قَائِمَة, قائمة",
 "列車": "ذَيْل (ذَيَّلَ (ذيله): جعل له ذيلا؛ (ذَيَّلَ) أطال ذيله وطوله. ويقال ذيل كتابه أو كلامه: أردفه بكلام كالتتمة له) / قَافِلَة (مؤنث القافل؛ الراجعة؛ جماعة من الناس تسير معًا مع أمتعتها وركوبها في سفر قافلين كانوا أو خارجين. سميّت كذلك تفائلا برجوعها) / تَدَرَّبَ, تَمَرَّنَ / دَرَّبَ, درب (الدَّرْبُ: كُلُّ طريقٍ يصلُ بين مكانَيْن. يقال: مَنْ سار على الدَّرب وصل : معناه أنّ المهارة تكتسبُ بالمِران؛ الدَّرْبُ: المَضيقُ في الجبال الْمَضْيَقُ فِي الجَبَلِ) / درب, أهل (الدَّرْبُ: كُلُّ طريقٍ يصلُ بين مكانَيْن. يقال: مَنْ سار على الدَّرب وصل : معناه أنّ المهارة تكتسبُ بالمِران؛ الدَّرْبُ: المَضيقُ في الجبال الْمَضْيَقُ فِي الجَبَلِ)\nمثال: للبقرة ذيل طويل.",
 "初": "أَوَّل, أُولَى (الذي يكون ترتيبه وَاحِد، الذي كان قبل الآخرين؛ الأوَّل اسم من الأسماء الحسنى) / أَوَّلاً / مثال: لم تكن أول مرة.",
 "初々しい": "بَرِيء, بَرِيئَة / بَرِيء",
 "初い": "بَرِيء, بَرِيئَة / بَرِيء",
 "初っ端": "بِدَايَة (في بِدَايَة الأمْرِ كانَ مُهَذَّباً : فِي أوّلِهِ؛ البِدَايَة والنِّهاية: المبتدأ والمنتهى)\nمثال: هذه بداية جيدة.",
 "初め": "بِدَايَة (في بِدَايَة الأمْرِ كانَ مُهَذَّباً : فِي أوّلِهِ؛ البِدَايَة والنِّهاية: المبتدأ والمنتهى)\nمثال: هذه بداية جيدة. / أَوَّل, أُولَى (الذي يكون ترتيبه وَاحِد، الذي كان قبل الآخرين؛ الأوَّل اسم من الأسماء الحسنى) / أَوَّلاً / مثال: لم تكن أول مرة. / مَنْشَأ / مَنْبَع, مَنْشَأ / اَصْل / نَاهِيكَ عَن, هٰذَا عَدَا عَنْ",
 "初めた": "مَاضٍ, الْمَاضِي ((في النحو) زمن نحوي يدل على حدث قد وقع، أو وُجِد قبل الآن بوقت ما)",
 "初めて": "أَوَّل, أُولَى (الذي يكون ترتيبه وَاحِد، الذي كان قبل الآخرين؛ الأوَّل اسم من الأسماء الحسنى) / أَوَّلاً / مثال: لم تكن أول مرة.",
 "初めとする": "شَامِل",
 "初めに": "أَوَّل, أُولَى (الذي يكون ترتيبه وَاحِد، الذي كان قبل الآخرين؛ الأوَّل اسم من الأسماء الحسنى) / أَوَّلاً / مثال: لم تكن أول مرة. / مُقَدَّمَة / تَعْرِيف (الإعلام؛ الشيء أو الكلمة: التوضيح بالمعنى بصورة مختصرة ليعرف الناس ما هي) / مُقَدَّمَة, مَدْخَل\nمثال: هل لديه بطاقة شخصية (هوية شخصية - بطاقة تعريف)",
 "初めのうち": "أول الأمر, في البداية (في البدء)\nمثال: في البداية لم يلاحظ أي شيء غريب",
 "初めの内": "أول الأمر, في البداية (في البدء)\nمثال: في البداية لم يلاحظ أي شيء غريب",
 "初めは": "أول الأمر, في البداية (في البدء)\nمثال: في البداية لم يلاحظ أي شيء غريب",
 "初世": "مُؤَسِّس, مُؤَسِّسَة",
 "初乳": "لَبَأ",
 "初井": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "初代": "مُؤَسِّس, مُؤَسِّسَة",
 "初便": "رحلة بحرية أولى (أول رحلة بحرية من نوعها)\nمثال: في عام 1912 غرقت سفينة تايتانيك في رحلتها الأولى",
 "初公開": "إطلاق, تدشين (فعل البدء بشيء جديد) / ظهور أول (تقديم فتاة للمجتمع لأول مرة)\nمثال: تطلعوا إلى الظهور الأول لخط إنتاجهم الجديد",
 "初出": "إطلاق, تدشين (فعل البدء بشيء جديد)\nمثال: تطلعوا إلى الظهور الأول لخط إنتاجهم الجديد",
 "初出場": "إطلاق, تدشين (فعل البدء بشيء جديد) / ظهور أول (تقديم فتاة للمجتمع لأول مرة)\nمثال: تطلعوا إلى الظهور الأول لخط إنتاجهم الجديد",
 "初列": "أَوَّلِيّ / خَطّ أَمَامِيّ (كِتَابَة؛ ما يَصِل نقطتين أو أكثر)\nمثال: إرسم خط مستقيم.",
 "初初しい": "بَرِيء, بَرِيئَة / بَرِيء",
 "初口": "بِدَايَة (في بِدَايَة الأمْرِ كانَ مُهَذَّباً : فِي أوّلِهِ؛ البِدَايَة والنِّهاية: المبتدأ والمنتهى)\nمثال: هذه بداية جيدة.",
 "初回": "أَوَّل, أُولَى (الذي يكون ترتيبه وَاحِد، الذي كان قبل الآخرين؛ الأوَّل اسم من الأسماء الحسنى) / أَوَّلاً / مثال: لم تكن أول مرة.",
 "初場所": "أول أيام السنة, يوم رأس السنة (اليوم الأول من السنة)",
 "初学者": "مُبْتَدِئ, مُبْتَدِئَة (من يبتدئ في تعلّم علم أو فنّ، شخص قليل الخبرة)\nمثال: إنك محترف وأنا مبتدئ.",
 "初年": "السَّنَة الْجَدِيدَة",
 "初年度": "أَوَّلِيّ, أَوَّل / أَوَّل (الذي يكون ترتيبه وَاحِد، الذي كان قبل الآخرين؛ الأوَّل اسم من الأسماء الحسنى) / حَرْف أَوَّلِيّ (طَرَف وَجَانِب وَحَدّ؛ رَمْز مخطوط أو مطبوع يقوم مقام صوت أو كلمة أو عبارة أو معنى)\nمثال: لم تكن أول مرة.",
 "初度": "أَوَّلِيّ, أَوَّل / أَوَّل (الذي يكون ترتيبه وَاحِد، الذي كان قبل الآخرين؛ الأوَّل اسم من الأسماء الحسنى) / حَرْف أَوَّلِيّ (طَرَف وَجَانِب وَحَدّ؛ رَمْز مخطوط أو مطبوع يقوم مقام صوت أو كلمة أو عبارة أو معنى)\nمثال: لم تكن أول مرة.",
 "初座": "شوط أول (الأول من شوطين للعب)",
 "初心": "انعدام التجربة, قلة خبرة (الافتقار إلى الخبرة والمعرفة والفهم المستمد من التجربة)\nمثال: خلقت قلة الخبرة الإجرائية صعوبات",
 "初心い": "بَرِيء, بَرِيئَة / بَرِيء",
 "初心者": "مُبْتَدِئ, مُبْتَدِئَة (من يبتدئ في تعلّم علم أو فنّ، شخص قليل الخبرة)\nمثال: إنك محترف وأنا مبتدئ.",
 "初志貫徹": "أداء, تنفيذ (فعل الأداء؛ القيام بشيء بنجاح؛ استخدام المعرفة بدلاً من مجرد امتلاكها) / تطبيق, تنفيذ (عملية إنجاز هدف ما أو تنفيذ أمر ما)\nمثال: انتقدوا أداءه كرئيس للبلدية",
 "初恋": "اَلْحُبّ اَلْأَوَّل",
 "初手": "بِدَايَة (في بِدَايَة الأمْرِ كانَ مُهَذَّباً : فِي أوّلِهِ؛ البِدَايَة والنِّهاية: المبتدأ والمنتهى)\nمثال: هذه بداية جيدة.",
 "初撃": "ضربة أولى (الاستخدام الأولي للأسلحة النووية لمهاجمة بلد يمتلك أيضاً أسلحة نووية)\nمثال: وعد الرئيس الباكستاني بعدم توجيه ضربة أولى ضد الهند",
 "初日": "أول أيام السنة, يوم رأس السنة (اليوم الأول من السنة)",
 "初春": "السَّنَة الْجَدِيدَة",
 "初月": "مُحَاق (الثَلَاثُ المُِحَاق: آخر ثلاث ليالٍ من كل شهر قمري وفيها السِّرَار وقيل ليلة خمس وست وسبع وقيل غير ذلك وقد تكون ليلتان في الأشهر ذَات التسع والعشرون…) / مَحَاق (الثَلَاثُ المُِحَاق: آخر ثلاث ليالٍ من كل شهر قمري وفيها السِّرَار وقيل ليلة خمس وست وسبع وقيل غير ذلك وقد تكون ليلتان في الأشهر ذَات التسع والعشرون…) / مِحَاق (الثَلَاثُ المُِحَاق: آخر ثلاث ليالٍ من كل شهر قمري وفيها السِّرَار وقيل ليلة خمس وست وسبع وقيل غير ذلك وقد تكون ليلتان في الأشهر ذَات التسع والعشرون…)",
 "初期": "بداية, حداثة (فترة مبكرة من التطور)\nمثال: خلال حداثة المشروع",
 "初期値": "تغذية وريدية (إعطاء المغذيات عبر الوريد) / أَرْبَعَة (يَدُلُّ عَلَى العَدَد 4) / أَرْبَعَة, رُبَاعِيّ (العدد الأصلي الذي هو مجموع ثلاثة وواحد)",
 "初期化": "تهيئة منخفضة المستوى ((علوم الكمبيوتر) تنسيق القطاعات على سطح محرك الأقراص الثابتة حتى يتمكن نظام التشغيل من الوصول إليها وتحديد موضع البداية) / تنسيق, صيغة البيانات (تنظيم المعلومات وفقاً لمواصفات محددة مسبقاً (عادة للمعالجة الحاسوبية))",
 "初期設定": "تهيئة منخفضة المستوى ((علوم الكمبيوتر) تنسيق القطاعات على سطح محرك الأقراص الثابتة حتى يتمكن نظام التشغيل من الوصول إليها وتحديد موضع البداية)",
 "初歩": "أساسيات, مبادئ أساسية (مبادئ يمكن استنتاج حقائق أخرى منها) / أساسيات, مبادئ أولية (بيان بالحقائق أو المبادئ الأساسية)\nمثال: أولاً يجب أن تتعلم الأساسيات",
 "初歩的": "بَسِيط, غَيْر مُعَقَّد (سَهْل وَغَيْر مُعَقَّد أَوْ مُتَشَعِّب) / أَوَّلِيّ, جَوْهَرِيّ (من الجزء الأساسي أو الجوهري أو يكونه) / أولي, ابتدائي (مكون من أو متعلق بـ أو مميز للمدرسة الابتدائية أو التعليم الابتدائي)\nمثال: الصفوف الابتدائية",
 "初演": "الْعَرْضُ ٱلْأَوَّل",
 "初潮": "بدء الحيض (أول حدوث للحيض عند المرأة)",
 "初物": "بتول, بِكْر (المنقطعه عن الرجال)",
 "初犯": "مذنب لأول مرة (شخص أدين للمرة الأولى)",
 "初犯者": "مذنب لأول مرة (شخص أدين للمرة الأولى)",
 "初生": "بِكْر (في : يُطلق على الحليب الذي يُحلب من أول مرة بعد الولادة)\nمثال: لا أفهم سبب ولعه بكرة القدم.",
 "初生ひな鑑別師": "مُجَنِّس الْكَتَاكِيت (شخص مدرب يتم تعيينه لتحديد جنس الدجاج والفراخ الأخرى)",
 "初生雛鑑別師": "مُجَنِّس الْكَتَاكِيت (شخص مدرب يتم تعيينه لتحديد جنس الدجاج والفراخ الأخرى)",
 "初産": "وضع, ولادة (عملية الولادة)",
 "初産婦": "بكرية ((طب التوليد) امرأة ولدت طفلاً لأول مرة)",
 "初発": "نَجْمَة, اِبْتِدَاء / نَجْمَة / بَدَأَ (حَدَثَ ونَشَأَ وحَصَلَ؛ أَخَذَ، شَرَعَ)\nمثال: بدأ سامي يتكلم.",
 "初登場": "إطلاق, تدشين (فعل البدء بشيء جديد) / ظهور أول (تقديم فتاة للمجتمع لأول مرة)\nمثال: تطلعوا إلى الظهور الأول لخط إنتاجهم الجديد",
 "初穂": "قُرْبَان",
 "初穗": "قُرْبَان",
 "初等": "بَسِيط, غَيْر مُعَقَّد (سَهْل وَغَيْر مُعَقَّد أَوْ مُتَشَعِّب) / أَوَّلِيّ, جَوْهَرِيّ (من الجزء الأساسي أو الجوهري أو يكونه) / أولي, ابتدائي (مكون من أو متعلق بـ أو مميز للمدرسة الابتدائية أو التعليم الابتدائي)\nمثال: الصفوف الابتدائية",
 "初等幾何学": "هندسة أولية, هندسة إقليدية (الهندسة القائمة على بديهيات إقليدس)",
 "初等教育": "تعليم ابتدائي (التعليم في المواد الأساسية (القراءة والكتابة والحساب) المقدم للطلاب الصغار في المدرسة الابتدائية)",
 "初等生": "مدرسة ابتدائية (مدرسة للأطفال الصغار؛ عادة ما تكون الصفوف الستة أو الثمانية الأولى)",
 "初等部": "مدرسة ابتدائية (مدرسة للأطفال الصغار؛ عادة ما تكون الصفوف الستة أو الثمانية الأولى)",
 "初級者": "مُبْتَدِئ, مُبْتَدِئَة (من يبتدئ في تعلّم علم أو فنّ، شخص قليل الخبرة)\nمثال: إنك محترف وأنا مبتدئ.",
 "初経": "بدء الحيض (أول حدوث للحيض عند المرأة)",
 "初舞台": "إطلاق, تدشين (فعل البدء بشيء جديد) / ظهور أول (تقديم فتاة للمجتمع لأول مرة)\nمثال: تطلعوا إلى الظهور الأول لخط إنتاجهم الجديد",
 "初航海": "رحلة بحرية أولى (أول رحلة بحرية من نوعها)\nمثال: في عام 1912 غرقت سفينة تايتانيك في رحلتها الأولى",
 "初音": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "初頭": "بِدَايَة (في بِدَايَة الأمْرِ كانَ مُهَذَّباً : فِي أوّلِهِ؛ البِدَايَة والنِّهاية: المبتدأ والمنتهى)\nمثال: هذه بداية جيدة.",
 "初飛行": "رحلة أولى, طلعة جوية أولى (أول رحلة من نوعها)\nمثال: قامت قاذفة الشبح برحلتها الأولى في عام 1989",
 "判": "فُقْمَة / خَتْم (أنهى الشيءَ وأتمّه؛ طبع بخاتم أو ختم رسميّ)\nمثال: ختم سامي القرآن في شهر رمضان. / تقييم, حكم (فعل الحكم على أو تقييم شخص أو موقف أو حدث) / حكم, قرار قضائي ((قانون) القرار الصادر عن محكمة مختصة بشأن المسائل المعروضة عليها) / تقدير, حكم (القدرة على تقييم المواقف أو الظروف بذكاء واستخلاص استنتاجات سليمة) / تمييز, حصافة (القدرة العقلية على الفهم والتمييز بين العلاقات)\nمثال: انتقدوا حكمي على المتسابقين / مَقَاس, قِيَاس",
 "判じる": "قَاضٍ, قَاضِيَة / حَكَمَ (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ)\nمثال: حكم علي بالموت. / ذَابَ, حَلَّ (تحوّل الشيء من حالته الصلبة إلى حالة سائلة نتيجة الحرارة؛ زال أو تلاشى شيئًا فشيئًا، مثل ذوبان الجليد أو اختفاء الألم)\nمثال: ذاب ذلك الجليد. / إِلٰهِيّ / رَجُلُ دِينٍ, رِجالُ دِينٍ (العُضْو في جسد الإنسان يتكون من القَدَم والسَاق والفُخْذ. الجمع أرجُل، وقد تقول العامّة رِجْلين ورجْلينات؛ القَدَم من باب اطلاق اسم الكل على الجزء)\nمثال: هذا الرجل تاجر.",
 "判じ物": "لُغْز, مُعْضِلَة (قالَ كلامًا خفيًا أو غير واضح، أو استخدم التورية والإشارة؛ عبّرَ عن شيء بطريقة رمزية أو غير مباشرة) / بَازْل, لُغْز / حَيَّرَ ((حَيَّرَه): أَوْقَعَه فِي حيرة)\nمثال: لم يحل أبدا لغز وفاتها.",
 "判ずる": "قَاضٍ, قَاضِيَة / حَكَمَ (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ)\nمثال: حكم علي بالموت. / ذَابَ, حَلَّ (تحوّل الشيء من حالته الصلبة إلى حالة سائلة نتيجة الحرارة؛ زال أو تلاشى شيئًا فشيئًا، مثل ذوبان الجليد أو اختفاء الألم)\nمثال: ذاب ذلك الجليد. / إِلٰهِيّ / رَجُلُ دِينٍ, رِجالُ دِينٍ (العُضْو في جسد الإنسان يتكون من القَدَم والسَاق والفُخْذ. الجمع أرجُل، وقد تقول العامّة رِجْلين ورجْلينات؛ القَدَم من باب اطلاق اسم الكل على الجزء)\nمثال: هذا الرجل تاجر.",
 "判で押したみたいに": "باستمرار, دائماً (بدون تنوع أو تغيير، في كل حالة)\nمثال: لطيف وكريم دائماً",
 "判で押したよう": "مُكَرَّر, نَمَطِيّ (يَفْتَقِرُ إِلَى العَفْوِيَّةِ أَوِ الأَصَالَةِ أَوِ التَّفَرُّد)",
 "判り": "فَهْم (فهم الأمر أو الكلام أو نحو ذلك، أدركه، علمه، أحسن تصوّره، استوعبه) / رُؤْيَة / تَفَاهُم / فهم (فهم الأمر أو الكلام أو نحو ذلك، أدركه، علمه، أحسن تصوّره، استوعبه)\nمثال: لقد أسئت الفهم.",
 "判りにくい": "غامض, غير مفهوم (صعب الفهم) / عصي على الفهم, لا يمكن تفسيره (غير قادر على أن يفسر أو يعلل)\nمثال: الشيء الأكثر غموضاً (عدم قابلية للفهم) في الكون هو أنه قابل للفهم",
 "判り難い": "غامض, غير مفهوم (صعب الفهم) / عصي على الفهم, لا يمكن تفسيره (غير قادر على أن يفسر أو يعلل)\nمثال: الشيء الأكثر غموضاً (عدم قابلية للفهم) في الكون هو أنه قابل للفهم",
 "判る": "فَهِمَ (فهم الأمر أو الكلام أو نحو ذلك، أدركه، علمه، أحسن تصوّره، استوعبه)\nمثال: لقد أسئت الفهم. / أَظُنُّ ذٰلِك",
 "判事": "قَاضٍ, قَاضِيَة / حَكَمَ (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ)\nمثال: حكم علي بالموت.",
 "判例": "سَابِقَة (فِي : لَاصِقَة تزاد قبل الكلمة لتحويل مبناها وتغيير معناها. وهي وسيلة اقتصادية لبناء المفردات في اللغة)",
 "判例集": "كِتَابِيّ, نَمُوذَجِيّ (وفقًا لما هو مذكور في الكتب المرجعية أو يتسم بخصائصها؛ نموذجي) / سجل القضايا, مدونة القضايا (كتاب يُحتفظ فيه بسجلات مكتوبة مفصلة لقضية ما ويعد مصدراً للمعلومات للعمل اللاحق)",
 "判別": "تَمْيِيْز",
 "判別がつく": "أَخْبَرَ, قَالَ (أَنْبَأَ، أَعْلَمَ) / تَلّ (في الْمُرتَفَعِ مِنَ الأرْضِ قَليلا، وهو دون الجَبَل؛ رَابِيَة)\nمثال: أخبر سامي أباه.",
 "判別が付く": "أَخْبَرَ, قَالَ (أَنْبَأَ، أَعْلَمَ) / تَلّ (في الْمُرتَفَعِ مِنَ الأرْضِ قَليلا، وهو دون الجَبَل؛ رَابِيَة)\nمثال: أخبر سامي أباه.",
 "判型": "تنسيق, شكل (المظهر العام لمنشور) / تنسيق, صيغة البيانات (تنظيم المعلومات وفقاً لمواصفات محددة مسبقاً (عادة للمعالجة الحاسوبية))",
 "判士": "قاضٍ عسكري, محامٍ عسكري (ضابط أركان يعمل كمستشار قانوني لقائد عسكري) / محامٍ عسكري (ضابط معين في مكتب المحامي العام للقضاء العسكري)",
 "判官": "قَاضٍ, قَاضِيَة / حَكَمَ (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ)\nمثال: حكم علي بالموت. / مُفَتِّش, مُفَتِّشَة",
 "判定": "تقييم, حكم (فعل الحكم على أو تقييم شخص أو موقف أو حدث) / حكم, قرار قضائي ((قانون) القرار الصادر عن محكمة مختصة بشأن المسائل المعروضة عليها) / تقدير, حكم (القدرة على تقييم المواقف أو الظروف بذكاء واستخلاص استنتاجات سليمة) / تمييز, حصافة (القدرة العقلية على الفهم والتمييز بين العلاقات)\nمثال: انتقدوا حكمي على المتسابقين",
 "判定基準": "مِعْيَار (العِيَار الذي يُقَاس به غيره، اسم آلة؛ قد يقصد به العِيَار)",
 "判定詞": "مُحَدِّد (من الفعل حَدَّدَ؛ (في الرياضيات) مصطلح يستعمل في الجبر الخطي، ويتم تحديد محدد مصفوفة باستعمال صيغة لايبنتس أو صيغة لابلاس)\nمثال: حضر الجميع إلى الصف في الوقت المحدد",
 "判断": "تقييم, حكم (فعل الحكم على أو تقييم شخص أو موقف أو حدث) / حكم, قرار قضائي ((قانون) القرار الصادر عن محكمة مختصة بشأن المسائل المعروضة عليها) / تقدير, حكم (القدرة على تقييم المواقف أو الظروف بذكاء واستخلاص استنتاجات سليمة) / تمييز, حصافة (القدرة العقلية على الفهم والتمييز بين العلاقات)\nمثال: انتقدوا حكمي على المتسابقين / تنجيم, عرافة (فن أو موهبة النبوءة (أو ادعاء النبوءة) بوسائل خارقة للطبيعة) / نبوءة (تنبؤ ينطق به تحت إلهام إلهي) / حَدْس صَائِب, فِرَاسَة (تخمين ناجح عن طريق بصيرة غير عادية أو حظ جيد)",
 "判断ミス": "حساب خاطئ, سوء تقدير (خطأ في الحساب)",
 "判断力": "تقييم, حكم (فعل الحكم على أو تقييم شخص أو موقف أو حدث) / حكم, قرار قضائي ((قانون) القرار الصادر عن محكمة مختصة بشأن المسائل المعروضة عليها) / تقدير, حكم (القدرة على تقييم المواقف أو الظروف بذكاء واستخلاص استنتاجات سليمة) / تمييز, حصافة (القدرة العقلية على الفهم والتمييز بين العلاقات)\nمثال: انتقدوا حكمي على المتسابقين",
 "判決": "حكم, قرار قضائي ((قانون) القرار الصادر عن محكمة مختصة بشأن المسائل المعروضة عليها)",
 "判然": "بوضوح (بدون شك أو تساؤل) / بشكل متميز, بوضوح (واضح للعقل؛ بتمييز عقلي واضح) / بشكل مفهوم, بوضوح (بطريقة يمكن فهمها) / بِوُضُوح (بطريقة يسهل إدراكها)\nمثال: كانوا تائهين بوضوح",
 "判示": "تقييم, حكم (فعل الحكم على أو تقييم شخص أو موقف أو حدث) / حكم, قرار قضائي ((قانون) القرار الصادر عن محكمة مختصة بشأن المسائل المعروضة عليها) / تقدير, حكم (القدرة على تقييم المواقف أو الظروف بذكاء واستخلاص استنتاجات سليمة) / تمييز, حصافة (القدرة العقلية على الفهم والتمييز بين العلاقات)\nمثال: انتقدوا حكمي على المتسابقين",
 "判者": "قَاضٍ, قَاضِيَة / حَكَمَ (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ)\nمثال: حكم علي بالموت.",
 "判読": "فك الترميز, فك التشفير (نشاط توضيح أو تحويل من رمز إلى نص عادي)\nمثال: مطلوب مفتاح سري أو كلمة مرور لفك التشفير",
 "判読しがたい": "غير مقروء ((لخط اليد، الطباعة، إلخ) لا يمكن قراءته)\nمثال: خط يد غير مقروء",
 "判読し難い": "غير مقروء ((لخط اليد، الطباعة، إلخ) لا يمكن قراءته)\nمثال: خط يد غير مقروء",
 "別": "تَمْيِيْز / فَصَلَ (التقطيع؛ تقسيم الشيء أجزاءً؛ جزء، باب في كِتَاب أو ماشابهه) / مُنْفَصِل\nمثال: اقرأ هذا الفصل. / اِسْتِثْنَاء / اِسْتِثْنَاء, خَطَأ / طِبْقًا لِـ, وَفْقًا لِـ / بِالنِّسْبَة لِـ / رَبّ (رَبَّ الولدَ يَرُبُّ رَبًّا: ولِيَه وتعهده بما يغذيه وينميه ويؤدّبه؛ الفاعل: رَابٌّ، والمفعول: مَرْبوبٌ، وربيبٌ)\nمثال: اعتني بي يا رب.",
 "別々": "فَصَلَ (التقطيع؛ تقسيم الشيء أجزاءً؛ جزء، باب في كِتَاب أو ماشابهه) / مُنْفَصِل\nمثال: اقرأ هذا الفصل.",
 "別々に": "بشكل فردي, على حدة (بمعزل عن الآخرين)\nمثال: إذا أخذناها بشكل فردي، الغرف كانت مربعة",
 "別け": "تَقْسِيم / قِسْمَة (في : هو أن أحد العمليات الحسابية الرئيسية، ضد الضَرْب) / قِسْمَةٌ (في : هو أن أحد العمليات الحسابية الرئيسية، ضد الضَرْب) / فِرْقَة / فُرْقَة\nمثال: الزواج قسمة و نصيب. / إِقْتِسَام, مُقَاسَمَة / دَلَجَ, غَرَفَ / رَسَمَ (سَم الشَّيءَ :خطّه رسَم مُربَّعًا/ صورةً/ شكلاً؛ رسَم : كَتَبَ) / قُرْعَة\nمثال: واصل زيري الرسم.",
 "別け前": "نَصِيب, حِصَّة / سَهْم (سَهَمَ؛ سَهَّمَ) / شَارَكَ\nمثال: لم يصب السهم توم.",
 "別して": "خُصُوصًا, خَاصَّةً",
 "別ち": "تَمْيِيْز",
 "別ち持つ": "نَصِيب, حِصَّة / سَهْم (سَهَمَ؛ سَهَّمَ) / شَارَكَ\nمثال: لم يصب السهم توم.",
 "別つ": "قَسَّمَ (فَرَّقَ أو قَسَّمَ الشَّيءَ إلى أجزاء أو أجزاء مختلفة؛ أَحْلَفَ، أَي جَعَلَ يَحْلِفُ على أمرٍ ما)\nمثال: أنا أزين القسم. / نَصِيب, حِصَّة / سَهْم (سَهَمَ؛ سَهَّمَ) / شَارَكَ\nمثال: لم يصب السهم توم.",
 "別として": "غَيْر (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "別なく": "بصرف النظر, بغض النظر (على الرغم من كل شيء؛ دون اعتبار للعوائق)\nمثال: واصل العمل بغض النظر عن الصعوبات",
 "別に": "بشكل خاص, تحديداً (بدرجة أكبر بوضوح مما هو شائع) / بِتَمَيُّز, بِشَكْل خَاصّ (بشكل فريد أو مميز) / تَحْدِيدًا, عَلَى وَجْه الخُصُوص (مميز بشكل خاص عن الآخرين)\nمثال: كان دقيقاً بشكل خاص حول التهجئة / بشكل فردي, على حدة (بمعزل عن الآخرين)\nمثال: إذا أخذناها بشكل فردي، الغرف كانت مربعة",
 "別にいいけど": "لَا يَهُمُّنِي (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: لا أحب المدرسة.",
 "別れ": "فِرَاقٌ / انحلال, انفصال (إنهاء أو تفكك علاقة (بين أشخاص أو دول)) / انفصال, تفكك (التفرق أو الانقسام)",
 "別れに臨ん": "فِرَاقٌ",
 "別れる": "جُزْء, جُزَء / دَوْر (جَعَله يَدُور؛ جَعَلَه مُدَوَّر) / اِفْتَرَقَ, تَفَارَقَ\nمثال: في أي دور تسكن؟ / فَصَلَ (التقطيع؛ تقسيم الشيء أجزاءً؛ جزء، باب في كِتَاب أو ماشابهه) / مُنْفَصِل\nمثال: اقرأ هذا الفصل. / فَقَدَ / خَسِرَ (كلمة \"خسر\" تعني فقدان شيء ما، سواء كان مالا أو شيئا آخر. وتشمل معانيها: فقد المال، الهلاك، الضياع…؛ فعل متعدٍّ ومُتعدٍّ لِمَعْنَى، ومعناها الأساسي فقدان شيء ما. وتتعدد معانيه لتشمل)\nمثال: خسر توم وظيفته.",
 "別れを告げる": "وَدَّعَ",
 "別れ別れ": "فَصَلَ (التقطيع؛ تقسيم الشيء أجزاءً؛ جزء، باب في كِتَاب أو ماشابهه) / مُنْفَصِل\nمثال: اقرأ هذا الفصل.",
 "別れ目": "شَوْكَة, مِذْرَاة (أداة لتناول الطعام تتكون عادةً من مقبض وعدة أسنان حادة، وتُستعمل لغرز الطعام وحمله إلى الفم) / تَفَرَّعَ / تَشَعَّبَ\nمثال: هناك شوكة ناقصة. / نقطة تحوّل (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه)\nمثال: هذه هي نقطة ضعفه.",
 "別れ話": "تَكَلَّمَ فِي, تَكَلَّمَ عَلَى (نُطْق؛ تَحَدُّث)\nمثال: أخذت تكلم الكلب.",
 "別れ道": "فَرْع, غُصْن / مُفْتَرَق, تَقَاطُع",
 "別アカ": "اِرْتِفَاع, عُلُوّ (المسافة الزاوية فوق الأفق (خاصة لجرم سماوي))",
 "別乾坤": "عالم آخر, عالم الغيب (عالم روحي مجرد يقع خارج حدود الواقع الدنيوي)",
 "別事": "حادث مؤسف, نحس (حالة من سوء الحظ) / سوء حظ, نحس (نتيجة غير متوقعة ومؤسفة)\nمثال: لو لم يكن لدي سوء حظ، لما كان لدي أي حظ على الإطلاق",
 "別仕立て": "مُفَصَّلٌ حَسَبَ الطَّلَبِ ((عن الملابس) مصنوع حسب المقاس والطلب) / ملابس مفصلة (ملابس مصنوعة حسب الطلب)",
 "別個": "آخَر, إِضَافِيّ (ضد الأوَّل؛ وهو من يكون ترتيبه بعد الجميع؛ الشيء: مؤخرّه، الجزء الآخير منه) / آخَر, أُخْرَى (ضد الأوَّل؛ وهو من يكون ترتيبه بعد الجميع؛ الشيء: مؤخرّه، الجزء الآخير منه)\nمثال: أرني مثالا آخر.",
 "別冊": "ملحق / مُكَمِّل",
 "別册": "ملحق / مُكَمِّل",
 "別別": "فَصَلَ (التقطيع؛ تقسيم الشيء أجزاءً؛ جزء، باب في كِتَاب أو ماشابهه) / مُنْفَصِل\nمثال: اقرأ هذا الفصل.",
 "別別に": "بشكل فردي, على حدة (بمعزل عن الآخرين)\nمثال: إذا أخذناها بشكل فردي، الغرف كانت مربعة",
 "別刷り": "نبذة – مقتطفات من",
 "別剌敦那": "البلادونا, ست الحسن (مستخلص قلويدي أو صبغة من نبات البلادونا السام يستخدم طبياً) / باذنجان مميت, بلادونا (عشب معمر أوراسي بأزهار جرسية الشكل محمرة وتوت أسود لامع؛ يزرع بكثافة في الولايات المتحدة؛ الجذور والأوراق تنتج الأتروبين)",
 "別名": "مُرَادِف (اسم فاعل من الفعل \"رَادَفَ\"؛ (في علم دلالة الألفاظ) كلمة لها المعنى نفسه أو معنى قريب له لكلمة أخرى في اللغة)\nمثال: الانفصالي مرادف للعاهرة. / المَعْرُوف بِـ, بِاسْم مُسْتَعَار (كما هو معروف أو مسمى في وقت أو مكان آخر) / اسم مستعار (اسم تم انتحاله)\nمثال: السيد سميث، المعروف بالسيد لافاييت",
 "別垢": "اِرْتِفَاع, عُلُوّ (المسافة الزاوية فوق الأفق (خاصة لجرم سماوي))",
 "別墅": "فِيلَا, دَارَة",
 "別姓": "رجل وزوجته, زواج (شخصان متزوجان من بعضهما البعض)\nمثال: كان زواجه الثاني أكثر سعادة من الأول",
 "別室": "سُرِّيَة",
 "別居": "تَفْرِقَة",
 "別府": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "別当": "سَائِس / هَندَم / أَمِين, حارِس (شخص يتولى مسؤولية المباني أو الأراضي أو الحيوانات) / مندوب عمالي (عضو نقابة يُنتخب لتمثيل زملائه العمال في التفاوض مع الإدارة) / ناظر, وكيل (شخص يدير الممتلكات أو الشؤون الأخرى لشخص آخر) / مضيف, مضيف طيران (مرافق على متن طائرة)",
 "別役": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "別懇": "أُلْفَة",
 "別所": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "別条": "حادث مؤسف, نحس (حالة من سوء الحظ) / سوء حظ, نحس (نتيجة غير متوقعة ومؤسفة)\nمثال: لو لم يكن لدي سوء حظ، لما كان لدي أي حظ على الإطلاق",
 "別枠": "إِضَافِيّ (إِضافيّ : ما يُضاف ، ما يُزاد؛ ما يُتْبَع شيئاً آخر ، ما يُلْحَق به ، ما يُزاد على الأصل)\nمثال: ستعطيني بطانية إضافية.",
 "別格": "خَاصّ, خُصُوصِيّ (قلَّ أو أصبح أقل؛ خَاصَ العَطَاءَ خَاصَ خَوْصًا: قلَّله)\nمثال: كل الخضار الخاص بك.",
 "別棟": "مَبْنى خَارِجِيّ (كل ما بُنِيَ؛ ما يُبْنى على أرضٍ محاطا بالجُدْرَان ومغطى بسَقْف. (تخصيص))\nمثال: دخل توم المبنى.",
 "別業": "فِيلَا, دَارَة",
 "別様": "مُخْتَلِف / آٰخَر (ضد الأوَّل؛ وهو من يكون ترتيبه بعد الجميع؛ الشيء: مؤخرّه، الجزء الآخير منه)\nمثال: أرني مثالا آخر.",
 "別段": "خاص (قلَّ أو أصبح أقل؛ خَاصَ العَطَاءَ خَاصَ خَوْصًا: قلَّله)\nمثال: كل الخضار الخاص بك. / بشكل خاص, تحديداً (بدرجة أكبر بوضوح مما هو شائع) / بِتَمَيُّز, بِشَكْل خَاصّ (بشكل فريد أو مميز) / تَحْدِيدًا, عَلَى وَجْه الخُصُوص (مميز بشكل خاص عن الآخرين)\nمثال: كان دقيقاً بشكل خاص حول التهجئة",
 "別添": "مَوَدَّة / مُلْحَق / مُرْفَق (مَا يُتَّكَأُ عَلَيْهِ)\nمثال: يؤلمني ذراعي من الكتف إلى المرفق.",
 "別無く": "بصرف النظر, بغض النظر (على الرغم من كل شيء؛ دون اعتبار للعوائق)\nمثال: واصل العمل بغض النظر عن الصعوبات",
 "別物": "اِسْتِثْنَاء / اِسْتِثْنَاء, خَطَأ",
 "別状": "حادث مؤسف, نحس (حالة من سوء الحظ) / سوء حظ, نحس (نتيجة غير متوقعة ومؤسفة)\nمثال: لو لم يكن لدي سوء حظ، لما كان لدي أي حظ على الإطلاق",
 "別珍": "مخمل قطني (قماش عادة ما يكون قطنياً بوبر قصير يقلد المخمل)",
 "別称": "مُرَادِف (اسم فاعل من الفعل \"رَادَفَ\"؛ (في علم دلالة الألفاظ) كلمة لها المعنى نفسه أو معنى قريب له لكلمة أخرى في اللغة)\nمثال: الانفصالي مرادف للعاهرة. / المَعْرُوف بِـ, بِاسْم مُسْتَعَار (كما هو معروف أو مسمى في وقت أو مكان آخر) / اسم مستعار (اسم تم انتحاله)\nمثال: السيد سميث، المعروف بالسيد لافاييت",
 "別箇": "آخَر, إِضَافِيّ (ضد الأوَّل؛ وهو من يكون ترتيبه بعد الجميع؛ الشيء: مؤخرّه، الجزء الآخير منه) / آخَر, أُخْرَى (ضد الأوَّل؛ وهو من يكون ترتيبه بعد الجميع؛ الشيء: مؤخرّه، الجزء الآخير منه)\nمثال: أرني مثالا آخر.",
 "別紙": "إحاطة, تغليف (عملية إحاطة شيء داخل شيء آخر) / حظيرة, مسيَّج (هيكل يتكون من منطقة تم تطويقها لغرض ما) / طية, مرفق (شيء ما (عادة وثيقة داعمة) يتم إرفاقه في ظرف مع رسالة تغطية) / حيز طبيعي مغلق, مكان مغلق (مساحة مغلقة بشكل طبيعي)",
 "別荘": "منزل عطلات (مسكن (منزل ثانٍ) تعيش فيه أثناء العطلة) / سِجْن (وضع شخصًا أو شيئًا في السجن أو الحبس؛ قيّد حرية شخص أو حركة شيء)\nمثال: دخل سامي السجن.",
 "別言すれば": "وَبِعِبَارَة أُخْرَى",
 "別記": "إضافة, ملحق (مادة نصية تضاف إلى منشور؛ عادة في النهاية)",
 "別訳": "تَرَاوُح, اِخْتِلَاف",
 "別途": "فَصَلَ (التقطيع؛ تقسيم الشيء أجزاءً؛ جزء، باب في كِتَاب أو ماشابهه) / مُنْفَصِل\nمثال: اقرأ هذا الفصل. / بشكل فردي, على حدة (بمعزل عن الآخرين)\nمثال: إذا أخذناها بشكل فردي، الغرف كانت مربعة",
 "別邸": "منزل عطلات (مسكن (منزل ثانٍ) تعيش فيه أثناء العطلة)",
 "別部": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "別配達": "تسليم خاص (بريد يتم تسليمه بواسطة ناقل خاص (مقابل رسوم إضافية))",
 "別離": "فِرَاقٌ",
 "別館": "توسعة, جناح (إضافة توسع المبنى الرئيسي)",
 "利": "أَفْضَلِيَّة, فَائِدَة",
 "利いた風": "خَفِيف العَقْل, مُسْتَخِفّ (يُظهر خفّة غير لائقة في موضع يستدعي الجدّية)",
 "利かす": "اِسْتِعْمَال, اِسْتِخْدَام (اِسْتِعْمَال) / اِسْتَعْمَلَ, اِسْتَخْدَمَ (عَمِلَ بالشيء؛ اِتَّخَذَ الشخصَ عَامِلًا عنده)\nمثال: أيمكنني استعمال هاتفك؟",
 "利かせる": "اِسْتِعْمَال, اِسْتِخْدَام (اِسْتِعْمَال) / اِسْتَعْمَلَ, اِسْتَخْدَمَ (عَمِلَ بالشيء؛ اِتَّخَذَ الشخصَ عَامِلًا عنده)\nمثال: أيمكنني استعمال هاتفك؟",
 "利かぬ": "عَنيد, غَليظ (شَديد القَسْوَة وعَديم الرَّحْمَة؛ لا يَرِقّ قَلْبُه) / عَنِيدٌ, مُصِرٌّ عَلَى الْخَطَأِ (مُصِرّ بعناد على ارتكاب الخطأ)",
 "利かぬ気": "مُتَوَحِّش, خارج عن السيطرَة",
 "利かん気": "مُتَوَحِّش, خارج عن السيطرَة",
 "利き": "فعالية, قوة تأثير (القدرة على إنتاج تأثيرات فسيولوجية أو كيميائية قوية) / تأثير, فعالية (القدرة على أن يكون مؤثرًا أو إحداث تأثير)\nمثال: قوة تأثير التوكسين / جانبية, هيمنة جانبية (تطور متفوق لجانب واحد من الجسم) / تفويض, سلطة (القوة أو الحق في إصدار الأوامر أو اتخاذ القرارات) / سيادة (الظاهرة العضوية التي يتم فيها التعبير عن أحد أليلين موجودين في النمط الجيني في النمط الظاهري بينما لا يظهر الأليل الآخر) / تحكم, سيطرة (الحالة التي توجد عندما يكون لشخص أو مجموعة سلطة على أخرى)\nمثال: لديه السلطة لإصدار مذكرات التوقيف / مَذَاق (مَا تُدْرِكُهُ حَاسَّةُ الذَّوْق)\nمثال: التين حلو المذاق.",
 "利き所": "نقطة ضغط (منطقة على الجلد حساسة للغاية للضغط) / نقطة ضغط (حيث يحتمل حدوث مشاكل أو صعوبات) / نقطة ضغط (أي من عدة نقاط في الجسم حيث يمكن الشعور بالنبض وحيث يؤدي الضغط على شريان تحتي إلى السيطرة على النزيف من ذلك الشريان في نقطة أبعد)\nمثال: يجب أن تعرف نقاط الضغط لكي تمارس شياتسو",
 "利き目": "تَأْثِير, أَثَر",
 "利き酒": "تَذَوُّق النَّبِيذ (تجمع للناس لتذوق ومقارنة أنواع مختلفة من النبيذ)",
 "利く": "عَمَل, شُغْل (فِعْل، صُنْع؛ وسيلة للكسب، مِهْنَة، حِرْفَة) / مُصَنَّف, مُؤَلَّف / سَارَ (مَشَى)\nمثال: المهم هو العمل. / اِسْتَطَاعَ, قَدَرَ (أَطَاقَ الشَّيءَ وقَدَرَ عليه، أَمْكَنَهُ الشَّيءُ)\nمثال: توم استطاع ان يهرب / حَسَبَ الرَغَبَة (عَدَّ مع الجَمْع والطَرْح وغيرها من العمليات الحِسَابية؛ عند أكثر العامة: هو العَدّ مطلقا)\nمثال: حسب سامي المال.",
 "利け者": "شخصية مؤثرة, شخصية هامة (شخص تؤثر أفعاله وآراؤه بقوة على مسار الأحداث)",
 "利ざや": "هَامِش إِجْمَالِيّ, هَامِش الرِّبْح (نسبة إجمالي الأرباح مقسومة على صافي المبيعات)",
 "利し": "حَادّ (مَالَ وَانْحَرَفَ عَنِ الطَّرِيقِ؛ تَجَنَّبَ شَيْئًا أَوِ الْاِلْتِزَامَ بِمَسَارٍ مَعَيَّنٍ)\nمثال: عندك ذاكرة حادة. / شَدِيد / سَرِيع / سَرِيعٌ / حَيٌّ (ضد المَيِّت، على قيد الحَيَاة؛ جمع حَيَاء) / جَارٍ (له استخدامات متعددة، تتراوح بين وصف المكان والعلاقة بين الناس، وبين وصف فعل الظلم أو الميل عن الطريق الصحيح؛ \"جار\" كلمةٌ مُشْعِبَةُ المعنى، تشيرُ إلى المكانِ، والعلاقة، والظلم) / سَرِيعًا, بِسُرْعَةٍ\nمثال: ينبح كلب في الحي. / سَنِين, مُرْهَف (له حافة قاطعة أو رأس حادّ) / طَاعِن, لَاذِع (مؤلم كما لو كان ناتجاً عن أداة حادّة) / رَائِع, مُمْتَاز (ممتاز؛ بالغ الجودة) / حَادّ, لَاذِع (شَدِيدُ الحِدَّةِ وَالوَطْأَة)",
 "利する": "رِبْح, مَكْسَب (رَبَحَ التَّاجِرُ: نَالَ فَائِدَةً مَالِيَّةً فِي تِجَارَتِهِ؛ رَبَحَ السَّبَاقَ: فَازَ، تَفَوَّقَ)\nمثال: ربح زيري المال. / فَائِدَة, جَدْوَى / اِسْتَغَلَّ",
 "利にさとい": "مُتَيَقِّظ تَمَامًا (في حالة يقظة وانتباه كاملين) / سَاهِر, يَقِظ تَمَامًا (مستيقظ تماماً وفي كامل اليقظة)",
 "利に敏い": "مُتَيَقِّظ تَمَامًا (في حالة يقظة وانتباه كاملين) / سَاهِر, يَقِظ تَمَامًا (مستيقظ تماماً وفي كامل اليقظة)",
 "利に聡い": "مُتَيَقِّظ تَمَامًا (في حالة يقظة وانتباه كاملين) / سَاهِر, يَقِظ تَمَامًا (مستيقظ تماماً وفي كامل اليقظة)",
 "利を得る": "رِبْح, مَكْسَب (رَبَحَ التَّاجِرُ: نَالَ فَائِدَةً مَالِيَّةً فِي تِجَارَتِهِ؛ رَبَحَ السَّبَاقَ: فَازَ، تَفَوَّقَ)\nمثال: ربح زيري المال.",
 "利ザヤ": "هَامِش إِجْمَالِيّ, هَامِش الرِّبْح (نسبة إجمالي الأرباح مقسومة على صافي المبيعات)",
 "利上げ": "سِعْر الْفَائِدَة (سَعِرَ يَسْعَرَ سَعَراً، وسُعْرَةً: ضرب لونه إِلى السواد فُوَيْقَ الأُدْمة؛ فهو أَسْعَرُ، وهي سَعْراءُ. والجمع: سُعْرٌ)",
 "利下げ": "سِعْر الْفَائِدَة (سَعِرَ يَسْعَرَ سَعَراً، وسُعْرَةً: ضرب لونه إِلى السواد فُوَيْقَ الأُدْمة؛ فهو أَسْعَرُ، وهي سَعْراءُ. والجمع: سُعْرٌ)",
 "利他": "إِيثَار, غَيْرِيَّة",
 "利他主義": "إِيثَار, غَيْرِيَّة",
 "利他主義者": "فاعل خير, محب للبشر (شخص يقدم تبرعات خيرية تهدف إلى زيادة رفاهية الإنسان)",
 "利他的": "إِيثَارِيّ, نَاكِر لِلذَّات (يظهر اهتماماً غير أناني برفاهية الآخرين)",
 "利他的行動": "إِيثَار, غَيْرِيَّة",
 "利付": "مدر للفائدة (للالتزامات المالية التي يُدفع عليها فائدة)",
 "利付き": "مدر للفائدة (للالتزامات المالية التي يُدفع عليها فائدة)",
 "利付債": "مدر للفائدة (للالتزامات المالية التي يُدفع عليها فائدة)",
 "利付国債": "مدر للفائدة (للالتزامات المالية التي يُدفع عليها فائدة)",
 "利便": "مُلَاءَمَة, مُنَاسَبَة",
 "利便性": "مُلَاءَمَة, مُنَاسَبَة",
 "利口": "ذَكِيّ (ذَكِيَ: صار شديد الفطنة وسريع البديهة؛ ذكِيَ التلميذ في مهارات الحساب الدهني)\nمثال: إنه وسيم و ذكي. / حَسَن السُّلُوك, مُؤَدَّب ((عادة عن الأطفال) يتصرف بالطريقة التي يراها المتحدث صحيحة)",
 "利器": "مُلَاءَمَة, مُنَاسَبَة",
 "利回り": "فَائِدَة",
 "利子": "فَائِدَة",
 "利子率": "سِعْر الْفَائِدَة (سَعِرَ يَسْعَرَ سَعَراً، وسُعْرَةً: ضرب لونه إِلى السواد فُوَيْقَ الأُدْمة؛ فهو أَسْعَرُ، وهي سَعْراءُ. والجمع: سُعْرٌ)\nمثال: إتفقوا على سعر.",
 "利害": "فَائِدَة",
 "利害得失": "مَحَاسِن وَمَسَاوِئ",
