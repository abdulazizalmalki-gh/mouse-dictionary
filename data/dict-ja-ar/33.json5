 "呶鳴り出す": "اِنْدَلَعَ",
 "呷る": "جرعة كبيرة, عبّة (جرعة كبيرة ومروية)",
 "呻き": "تَأَوَّهَ (قَالَ آه؛ تَحَسَّرَ، تَنَهَّدَ)",
 "呻き声": "آهَة, أَنِين / تَأَوَّهَ, أَنَّ (قَالَ آه؛ تَحَسَّرَ، تَنَهَّدَ)",
 "呻く": "تَأَوَّهَ (قَالَ آه؛ تَحَسَّرَ، تَنَهَّدَ)",
 "呻吟": "تَأَوَّهَ (قَالَ آه؛ تَحَسَّرَ، تَنَهَّدَ)",
 "呼ばる": "دَعَا, نَادَى (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه) / اِتَّصَلَ بِـ / دَعَا, سَمَّى (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه) / اِتِّصَال, مُكَالَمَة / زِيَارَة\nمثال: دعا ثلاميذه الاثني عشر",
 "呼ばれる": "سُمِّيَ",
 "呼ばれるプログラム": "إجراء, دالة (تسلسل محدد من الخطوات، جزء من برنامج حاسوبي أكبر)",
 "呼ばわり": "رسالة مهنية, مسار مهني (المهنة المحددة التي تدربت من أجلها)",
 "呼ばわる": "صَيح, صِيَاح (مبالغة في الصياح، صاح كثيرا؛ في : صرخ) / صَرَخَ, صَاحَ (صاحَ صياحا شديدًا واستغاث)\nمثال: صرخ طالبا النجدة.",
 "呼び": "دَعَا, نَادَى (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه) / اِتَّصَلَ بِـ / دَعَا, سَمَّى (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه) / اِتِّصَال, مُكَالَمَة / زِيَارَة\nمثال: دعا ثلاميذه الاثني عشر",
 "呼びかけ": "دَعَا, نَادَى (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه) / اِتَّصَلَ بِـ / دَعَا, سَمَّى (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه) / اِتِّصَال, مُكَالَمَة / زِيَارَة\nمثال: دعا ثلاميذه الاثني عشر",
 "呼びかける": "بَرَد, مطر تلج (أصبح باردا، ضد سَخَنَ وهو فعل لازم مصدر بَرْد وبُرود؛ مَاتَ، على المجاز لأن الميت تبرد جثته. فعل لازم مصدر بَرْد) / السلام عليك, السلام عليكم\nمثال: لا أتحمل البرد. / اِلْتِمَاس, اِسْتِئْنَاف / اِسْتَأْنَفَ",
 "呼びこむ": "دَعَا, عَزَمَ (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه)\nمثال: دعا ثلاميذه الاثني عشر",
 "呼びつけ": "رسالة مهنية, مسار مهني (المهنة المحددة التي تدربت من أجلها)",
 "呼びつける": "دَعَا إِلَى (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه)\nمثال: دعا ثلاميذه الاثني عشر",
 "呼びよせる": "دَعَا, نَادَى (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه) / اِتَّصَلَ بِـ / دَعَا, سَمَّى (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه) / اِتِّصَال, مُكَالَمَة / زِيَارَة\nمثال: دعا ثلاميذه الاثني عشر",
 "呼びりん": "جَرَس, جرس (جَرَسَ الطَّائِرُ: صَوَّتَ؛ جَرَسَ الكَلاَمَ: نَغَمَ بِهِ وَتَكَلَّمَ) / اِتِّصَال\nمثال: ياني يرن الجرس.",
 "呼び付け": "رسالة مهنية, مسار مهني (المهنة المحددة التي تدربت من أجلها)",
 "呼び付ける": "دَعَا إِلَى (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه)\nمثال: دعا ثلاميذه الاثني عشر",
 "呼び値": "سعر اسمي (سعر تقديري قد يشبه أو لا يشبه سعر السوق للأصل)",
 "呼び入れる": "دَعَا, عَزَمَ (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه)\nمثال: دعا ثلاميذه الاثني عشر",
 "呼び出し": "دَعَا, نَادَى (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه) / اِتَّصَلَ بِـ / دَعَا, سَمَّى (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه) / اِتِّصَال, مُكَالَمَة / زِيَارَة\nمثال: دعا ثلاميذه الاثني عشر / شَبِيهٌ بِالصُّنْدُوقِ, صُنْدُوقِيّ (يشبه الصندوق في استطالته) / عَالِيّ الرُتْبَة",
 "呼び出し側": "طَازَج (طَازَج وَجَدِيد) / بَارِد عَلِيل, مُنْعِش ((عامّيّة اسكتلنديّة) يمنح البرودة والانتعاش) / زائر, ضيف (زائر اجتماعي أو للعمل) / متصل (الشخص الذي يبدأ مكالمة هاتفية)\nمثال: كانت الغرفة فوضوية لأنه لم يكن يتوقع ضيوفاً",
 "呼び出し時間": "وقت الوصول ((في علم الحاسوب) الفترة بين طلب البيانات من قبل النظام ووقت توفير البيانات بواسطة محرك الأقراص)\nمثال: وقت الوصول هو مجموع وقت البحث وكمون الدوران ووقت معالجة الأوامر",
 "呼び出し状": "اِسْتِدْعَاء (دَعْوَةً؛ طَلَب الْمُثُولِ)\nمثال: أراد توم استدعاء الشرطة، ولكن ماري لم تسمح له.",
 "呼び出し符号": "رَمْز نِدَاء (رمز (جمعه رموز)؛ الرمز يعني الرسم الذي يعبر عن شيء معين وعموما فأن العلامة ينبغي نقل رسالتها بنظرة واحدة دون الحاجة للكلمات)\nمثال: تمثال الحرية رمز لأمريكا.",
 "呼び出し音": "نَغْمَة الرَنَّة, نَغْمَة رَنِين",
 "呼び出す": "استدعاء للخدمة, استنفار (أمر بالالتحاق بالواجب العسكري) / دَعَا (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه)\nمثال: دعا ثلاميذه الاثني عشر",
 "呼び名": "اِسْم (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)\nمثال: ما اسم حصان توم؟",
 "呼び声": "دَعَا, نَادَى (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه) / اِتَّصَلَ بِـ / دَعَا, سَمَّى (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه) / اِتِّصَال, مُكَالَمَة / زِيَارَة\nمثال: دعا ثلاميذه الاثني عشر",
 "呼び売り": "بيع متجول (فعل بيع البضائع لكسب العيش)",
 "呼び子": "صَفَّارَة / صَفَرَ, صَفَّرَ (الخَالِي كأنه تَصْفِر فيه الرِيح. ويقال أيضا صَفْر وصُفْر؛ في : هي عَدَد قيمته لا شيء، أو خالية)\nمثال: بدأ سامي من نقطة الصفر.",
 "呼び寄せる": "دَعَا, نَادَى (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه) / اِتَّصَلَ بِـ / دَعَا, سَمَّى (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه) / اِتِّصَال, مُكَالَمَة / زِيَارَة\nمثال: دعا ثلاميذه الاثني عشر",
 "呼び屋": "مُرَوِّج",
 "呼び戻す": "ٱسْتَدْعى / تَذَكَّرَ (تذكَّر الشَّيءَ: ذكره، استحضره بعد نسيان، وفطِن له؛ تذكَّرتِ المرأةُ: تَشَبَّهَتْ بِالرَّجُلِ) / سَحْبٌ (سحب أو جذب شيئًا باتجاهه أو بعيدًا عنه؛ أزال أو سحب شيء من مكانه)\nمثال: ليلى تذكر سامي.",
 "呼び掛け": "دَعَا, نَادَى (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه) / اِتَّصَلَ بِـ / دَعَا, سَمَّى (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه) / اِتِّصَال, مُكَالَمَة / زِيَارَة\nمثال: دعا ثلاميذه الاثني عشر",
 "呼び掛ける": "بَرَد, مطر تلج (أصبح باردا، ضد سَخَنَ وهو فعل لازم مصدر بَرْد وبُرود؛ مَاتَ، على المجاز لأن الميت تبرد جثته. فعل لازم مصدر بَرْد) / السلام عليك, السلام عليكم\nمثال: لا أتحمل البرد. / اِلْتِمَاس, اِسْتِئْنَاف / اِسْتَأْنَفَ",
 "呼び樋": "كُوع, مِرْفَق / كُوعٌ",
 "呼び止める": "بَرَد, مطر تلج (أصبح باردا، ضد سَخَنَ وهو فعل لازم مصدر بَرْد وبُرود؛ مَاتَ، على المجاز لأن الميت تبرد جثته. فعل لازم مصدر بَرْد) / السلام عليك, السلام عليكم\nمثال: لا أتحمل البرد.",
 "呼び水": "إثارة, إيقاظ (فعل الإثارة أو الاستنهاض) / حَمَاسِيّ, مُحَفِّز (يحثّ على النشاط أو يُصَعِّد الفعل كأنّه يَحْفِز ويَدْفَع) / حَمَاسِيّ, مُلْهِم (قادر على إثارة الحماس أو الإثارة)\nمثال: الهدف من الفن هو إثارة العواطف",
 "呼び水式経済政策": "تحضير المضخة (إدخال الماء في المضخة لتحسين الختم وبدء تدفق المياه) / إنفاق بالعجز (إنفاق الأموال التي تم جمعها عن طريق الاقتراض؛ تستخدمه الحكومات لتحفيز اقتصادها)",
 "呼び覚ます": "صَحَا, اِسْتَيْقَظَ (أَفَاقَ؛ اِسْتَيْقَظَ) / أَيْقَظَ (نبَّهه، ضد نَوَّمَه؛ الغبارَ: أثاره)\nمثال: أيقظ زيري السائق / اِسْتَحْضَارَ, اِسْتَدَعَى",
 "呼び起こす": "أَيْقَظَ (نبَّهه، ضد نَوَّمَه؛ الغبارَ: أثاره) / اِسْتَيْقَظَ, أَفَاقَ (منع النَوْم)\nمثال: أيقظ زيري السائق / دَعَا, نَادَى (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه) / اِتَّصَلَ بِـ / دَعَا, سَمَّى (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه) / اِتِّصَال, مُكَالَمَة / زِيَارَة\nمثال: دعا ثلاميذه الاثني عشر",
 "呼び込み": "كلب (مصطلحات غير رسمية للكلاب) / منادٍ (شخص يقف أمام عرض (كما في الكرنفال) ويلقي خطاب بيع صاخب وملون للزبائن المحتملين)",
 "呼び込む": "دَعَا, عَزَمَ (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه)\nمثال: دعا ثلاميذه الاثني عشر",
 "呼び返す": "ٱسْتَدْعى / تَذَكَّرَ (تذكَّر الشَّيءَ: ذكره، استحضره بعد نسيان، وفطِن له؛ تذكَّرتِ المرأةُ: تَشَبَّهَتْ بِالرَّجُلِ) / سَحْبٌ (سحب أو جذب شيئًا باتجاهه أو بعيدًا عنه؛ أزال أو سحب شيء من مكانه)\nمثال: ليلى تذكر سامي.",
 "呼び鈴": "جَرَس, جرس (جَرَسَ الطَّائِرُ: صَوَّتَ؛ جَرَسَ الكَلاَمَ: نَغَمَ بِهِ وَتَكَلَّمَ) / اِتِّصَال\nمثال: ياني يرن الجرس.",
 "呼び集める": "اِجْتَمَعَ (ضد تَفَرَّقَ، كانوا جَمِيْع، أو كانوا مع بعض؛ الناس على كذا: ضدّ تَفَرَّقُوْا؛ كانوا على رأي واحد)\nمثال: اجتمع الناس في المتنزه.",
 "呼ぶ": "دَعَا, نَادَى (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه) / اِتَّصَلَ بِـ / دَعَا, سَمَّى (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه) / اِتِّصَال, مُكَالَمَة / زِيَارَة\nمثال: دعا ثلاميذه الاثني عشر / يَسْتَحْضِر, يَسْتَدْعِي / دَعَا, عَزَمَ (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه)\nمثال: دعا ثلاميذه الاثني عشر / اِسْم, أَسْمَاء (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر) / اِشْتِهَار / سَمَّى, سمى / اِخْتَارَ / عَيَّنَ (المُعَايَنَة والمشاهدة؛ العين : حاسة البصر والرؤية - مؤنث - تكون للإنسان وغيره من الحيوان . قال ابن السكيت : العين التي يبصر بها الناظر…) / عَيَّنَ, نَصَبَ (المُعَايَنَة والمشاهدة؛ العين : حاسة البصر والرؤية - مؤنث - تكون للإنسان وغيره من الحيوان . قال ابن السكيت : العين التي يبصر بها الناظر…)\nمثال: ما اسم حصان توم؟",
 "呼ぶ子": "صَفَّارَة / صَفَرَ, صَفَّرَ (الخَالِي كأنه تَصْفِر فيه الرِيح. ويقال أيضا صَفْر وصُفْر؛ في : هي عَدَد قيمته لا شيء، أو خالية)\nمثال: بدأ سامي من نقطة الصفر.",
 "呼値": "سعر اسمي (سعر تقديري قد يشبه أو لا يشبه سعر السوق للأصل)",
 "呼入れる": "دَعَا, عَزَمَ (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه)\nمثال: دعا ثلاميذه الاثني عشر",
 "呼出": "دَعَا, نَادَى (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه) / اِتَّصَلَ بِـ / دَعَا, سَمَّى (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه) / اِتِّصَال, مُكَالَمَة / زِيَارَة\nمثال: دعا ثلاميذه الاثني عشر / شَبِيهٌ بِالصُّنْدُوقِ, صُنْدُوقِيّ (يشبه الصندوق في استطالته) / عَالِيّ الرُتْبَة",
 "呼出し": "دَعَا, نَادَى (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه) / اِتَّصَلَ بِـ / دَعَا, سَمَّى (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه) / اِتِّصَال, مُكَالَمَة / زِيَارَة\nمثال: دعا ثلاميذه الاثني عشر / شَبِيهٌ بِالصُّنْدُوقِ, صُنْدُوقِيّ (يشبه الصندوق في استطالته) / عَالِيّ الرُتْبَة",
 "呼出し音": "نَغْمَة الرَنَّة, نَغْمَة رَنِين",
 "呼出す": "استدعاء للخدمة, استنفار (أمر بالالتحاق بالواجب العسكري) / دَعَا (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه)\nمثال: دعا ثلاميذه الاثني عشر",
 "呼出時間": "وقت الوصول ((في علم الحاسوب) الفترة بين طلب البيانات من قبل النظام ووقت توفير البيانات بواسطة محرك الأقراص)\nمثال: وقت الوصول هو مجموع وقت البحث وكمون الدوران ووقت معالجة الأوامر",
 "呼出状": "اِسْتِدْعَاء (دَعْوَةً؛ طَلَب الْمُثُولِ)\nمثال: أراد توم استدعاء الشرطة، ولكن ماري لم تسمح له.",
 "呼出符号": "رَمْز نِدَاء (رمز (جمعه رموز)؛ الرمز يعني الرسم الذي يعبر عن شيء معين وعموما فأن العلامة ينبغي نقل رسالتها بنظرة واحدة دون الحاجة للكلمات)\nمثال: تمثال الحرية رمز لأمريكا.",
 "呼出音": "نَغْمَة الرَنَّة, نَغْمَة رَنِين",
 "呼名": "اِسْم (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)\nمثال: ما اسم حصان توم؟",
 "呼吸": "تَنَفُس, نَفَس / براعة, مهارة خاصة (طريقة خاصة أو مهارة فطرية للقيام بشيء ما)\nمثال: كان لديه ميل لذلك / اِنْسِجَام, تَوَافُق",
 "呼吸が合う": "انسجم, تفاهم (التمتع بعلاقات طيبة وسلسة مع الآخرين)\nمثال: أنا ورئيسي نتفاهم بشكل جيد للغاية",
 "呼吸中枢": "مركز تنفسي (المركز في النخاع المستطيل والجسر الذي يدمج المعلومات الحسية حول مستوى الأكسجين وثاني أكسيد الكربون في الدم ويحدد الإشارات التي سيتم إرسالها إلى عضلات…)",
 "呼吸器": "عضو تنفسي (أي عضو يشارك في عملية التنفس)",
 "呼吸器官": "عضو تنفسي (أي عضو يشارك في عملية التنفس)",
 "呼吸器感染": "التهاب الجهاز التنفسي, عدوى الجهاز التنفسي (أي عدوى تصيب الجهاز التنفسي)",
 "呼吸器疾患": "اضطراب تنفسي, مرض تنفسي (مرض يصيب الجهاز التنفسي)",
 "呼吸器系": "جِهَاز تَنَفُّسِيّ",
 "呼吸困難": "ضيق النفس, عسر التنفس (تنفس صعب أو مجهد)\nمثال: 標高がぐんと高くなると呼吸困難を感じる。 — في الأعالي، يصعب على الناس التنفس.",
 "呼吸根": "جذر هوائي (جذر مملوء بالهواء (مغمور أو مكشوف) يمكن أن يعمل كعضو تنفسي لنبات المستنقعات)",
 "呼吸点": "حُرِيَّة (الحُرِّيَة : الخلُوص من الشَّوائب أَو الرقّ أَو اللُّؤْم؛ الحُرِّيَة : حَقُّ الإنْسَانِ فِي اخْتِيَارِ مَا يُرِيدُ حَسَبَ اعْتِقَادِهِ…)\nمثال: الحرية لفلسطين.",
 "呼吸窮迫症候群": "متلازمة الضائقة التنفسية (مرض رئوي حاد يصيب حديثي الولادة (خاصة الخدج))",
 "呼和浩特": "هُوهِيهُوت, خُوخِيخَاوْتِي",
 "呼声": "دَعَا, نَادَى (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه) / اِتَّصَلَ بِـ / دَعَا, سَمَّى (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه) / اِتِّصَال, مُكَالَمَة / زِيَارَة\nمثال: دعا ثلاميذه الاثني عشر",
 "呼子": "صَفَّارَة / صَفَرَ, صَفَّرَ (الخَالِي كأنه تَصْفِر فيه الرِيح. ويقال أيضا صَفْر وصُفْر؛ في : هي عَدَد قيمته لا شيء، أو خالية)\nمثال: بدأ سامي من نقطة الصفر.",
 "呼寄せる": "دَعَا, نَادَى (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه) / اِتَّصَلَ بِـ / دَعَا, سَمَّى (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه) / اِتِّصَال, مُكَالَمَة / زِيَارَة\nمثال: دعا ثلاميذه الاثني عشر",
 "呼応": "أَجَابَ (رَدَّ على سُؤالٍ أو طلبٍ؛ أَمْتَثَلَ لِمُطَالَبَةٍ أو دعوةٍ)\nمثال: أجاب ياني فورا. / اِتِّفَاق, تَوَافُق / إِقْرَار / اِتِّفَاق, اِتِّفَاقِيَّة",
 "呼応して": "بالتنسيق, معاً (بخطط مشتركة)\nمثال: العمل بالتنسيق",
 "呼格": "نِدَاء",
 "呼気": "زَفِير",
 "呼水": "إثارة, إيقاظ (فعل الإثارة أو الاستنهاض) / حَمَاسِيّ, مُحَفِّز (يحثّ على النشاط أو يُصَعِّد الفعل كأنّه يَحْفِز ويَدْفَع) / حَمَاسِيّ, مُلْهِم (قادر على إثارة الحماس أو الإثارة)\nمثال: الهدف من الفن هو إثارة العواطف",
 "呼称": "اِسْم, أَسْمَاء (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر) / اِشْتِهَار / سَمَّى, سمى / اِخْتَارَ / عَيَّنَ (المُعَايَنَة والمشاهدة؛ العين : حاسة البصر والرؤية - مؤنث - تكون للإنسان وغيره من الحيوان . قال ابن السكيت : العين التي يبصر بها الناظر…) / عَيَّنَ, نَصَبَ (المُعَايَنَة والمشاهدة؛ العين : حاسة البصر والرؤية - مؤنث - تكون للإنسان وغيره من الحيوان . قال ابن السكيت : العين التي يبصر بها الناظر…)\nمثال: ما اسم حصان توم؟",
 "呼起": "استدعاء, تذكر (عملية التذكر (وخاصة عملية استعادة المعلومات بجهد ذهني)) / استرجاع, تذكر (القدرة على استدعاء الأحداث الماضية) / استذكار, ذكرى مستعادة (شيء تم استدعاؤه إلى الذهن)\nمثال: لديه استدعاء كامل للحلقة",
 "呼込み": "كلب (مصطلحات غير رسمية للكلاب) / منادٍ (شخص يقف أمام عرض (كما في الكرنفال) ويلقي خطاب بيع صاخب وملون للزبائن المحتملين)",
 "呼込む": "دَعَا, عَزَمَ (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه)\nمثال: دعا ثلاميذه الاثني عشر",
 "呼鈴": "جَرَس, جرس (جَرَسَ الطَّائِرُ: صَوَّتَ؛ جَرَسَ الكَلاَمَ: نَغَمَ بِهِ وَتَكَلَّمَ) / اِتِّصَال\nمثال: ياني يرن الجرس.",
 "呼集": "جمع, حصد (فعل جمع شيء ما) / اِحْتِشَاد, تَجَمُّع (الفعل الاجتماعي المتمثل في التجمع) / زم, كشكشة (خياطة تتكون من طيات صغيرة أو تجاعيد مصنوعة بسحب خيط بإحكام في خط خياطة) / تجمع, تجمهر (مجموعة من الأشخاص مجتمعين معاً في مكان واحد)\nمثال: طالبوا بالحق في التجمع",
 "命": "حَياة (الحَياة: ضد الموت والحَيُّ: ضدُّ الميّت؛ والمَحْيا مَفْعَلٌ من الحياة. تقول: مَحْيَاي ومماتي. والجمع الحَحايي)\nمثال: ما أغرب الحياة! / حياة, عمر (الفترة التي يكون فيها شيء ما وظيفياً أو حياً (ما بين الولادة والموت))\nمثال: عاش حياة طويلة وسعيدة / إِنْشاء, إِشَادَة (مصدر للفعل \"أَنْشَأَ\") / أَسَاس, قَاعِدَة (مبدأ عام تعتمد عليه طائفة من الظواهر أو القضايا؛ مُرتكز البناء وقاعدته) / مُؤَسَّسَة / أَسَاس (مبدأ عام تعتمد عليه طائفة من الظواهر أو القضايا؛ مُرتكز البناء وقاعدته)\nمثال: إنشاء موقع إلكتروني بدون أي تكلفة؟ / قِسْمَة, مَصِير (في : هو أن أحد العمليات الحسابية الرئيسية، ضد الضَرْب)\nمثال: الزواج قسمة و نصيب. / تَرْتِيب, نِظَام (تنظيم الأشياء أو الأحداث في تسلسل معين أو وضعها في نظام؛ إعداد أو تجهيز شيء لتحقيق غاية معينة) / أَمْر, حُكْم (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة) / طَلَب (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى)) / جَمَاعَة (العَدَد الكثير من النَاس أو الحَيْوَان أو النَبَات أو غيره. المَجْمُوعَة؛ طَائِفَة من الناس التي يجمعها مكان و بيئة واحدة أو تتشارك اهداف و غايات واحدة) / وِسَام / رُتْبَة (رُتْبَة، بضم الراء؛ رَتْبَة، بفتح الراء) / أَمَرَ (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة) / طَلَبَ, حَجَزَ (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى))\nمثال: أعاد زيري ترتيب المطبخ كلية. / حَياة (الحَياة: ضد الموت والحَيُّ: ضدُّ الميّت؛ والمَحْيا مَفْعَلٌ من الحياة. تقول: مَحْيَاي ومماتي. والجمع الحَحايي)\nمثال: ما أغرب الحياة! / قدر, مصير (حدث (أو مسار أحداث) سيحدث حتماً في المستقبل) / قضاء, قَدَر (القوة النهائية التي يُنظر إليها على أنها تحدد مسار الأحداث مسبقاً) / حظ, قدر (ظروفك العامة أو حالتك في الحياة (بما في ذلك كل ما يحدث لك))\nمثال: نحن عاجزون أمام القدر / رَبّ (رَبَّ الولدَ يَرُبُّ رَبًّا: ولِيَه وتعهده بما يغذيه وينميه ويؤدّبه؛ الفاعل: رَابٌّ، والمفعول: مَرْبوبٌ، وربيبٌ)\nمثال: اعتني بي يا رب. / مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة!",
 "命からがら": "للنجاة بحياته (كما لو كانت حياتك على المحك)\nمثال: كان يركض للنجاة بحياته",
 "命が散る": "مَاتَ (للحَيّ: فقد الحَيَاة. مصدره مَوتَا ومِيتَة؛ للأرض: ليس فيها شيء حَيّ من النبات أو الحيوان أو الإنسان. مصدره مَوَات) / تُوُفِّيَ / زَهْر اَلطَّاوِلَة, زَهْر اَلنَّرْد ((زَهَرَ) الوجهُ والسراجُ والقمرُ يَزْهُرُ زَهْرًا، وزُهُوراً: تلألأ وأشْرق؛ (زَهَرَ) الشيءُ: صَفا لونُه)\nمثال: إعتقدت أنه مات.",
 "命じる": "حسب الطلب (حسب المواصفات)\nمثال: صنع الأحذية حسب الطلب",
 "命ずる": "حسب الطلب (حسب المواصفات)\nمثال: صنع الأحذية حسب الطلب",
 "命とり": "مُمِيت, قَاتِل",
 "命の恩人": "طوق نجاة (وسيلة نجاة على شكل حلقة من مادة طافية) / منقذ سباحة (مرافق يعمل في الشاطئ أو المسبح لحماية السباحين من الحوادث)",
 "命の水": "بَاعِث لِلْحَيَاة, مُحْيٍ (يمنح أو يملك القدرة على بثّ الحياة والروح) / كُحُول, خَمْر (سَائِلٌ لاَ لَوْنَ لَهُ، لاَذِعُ الطَّعْمِ، يُسْتَخْرَجُ مِنْ تَخْمِيرِ بَعْضِ الْمَوَادِّ، يُمْزَجُ بِالْمَشْرُوبَاتِ الرُّوحِيَّةِ…)\nمثال: أكره ذوق الكحول. / مَنِيّ",
 "命をつなぐ": "نَجَا",
 "命を散らす": "مَاتَ (للحَيّ: فقد الحَيَاة. مصدره مَوتَا ومِيتَة؛ للأرض: ليس فيها شيء حَيّ من النبات أو الحيوان أو الإنسان. مصدره مَوَات) / تُوُفِّيَ / زَهْر اَلطَّاوِلَة, زَهْر اَلنَّرْد ((زَهَرَ) الوجهُ والسراجُ والقمرُ يَزْهُرُ زَهْرًا، وزُهُوراً: تلألأ وأشْرق؛ (زَهَرَ) الشيءُ: صَفا لونُه)\nمثال: إعتقدت أنه مات.",
 "命を絶つ": "اِنْتَحَرَ / قَتَلَ, قتل (تعمّد جعله يَمُوتُ، أزهق روحه، أمَاتَه متعمدا؛ الوقتَ: ضيعه بشيء غير ذي فائدة وهو ينتظر أمرا آخر) / قَتْلَة\nمثال: قتل الصياد دبا.",
 "命を繋ぐ": "نَجَا",
 "命中": "أَصَابَ / ضَرْبَة (المرة الواحدة من الضَرْب؛ اللطمو أو الدقة أو الصكّة؛ ضربة طبل: دقة واحدة منه)\nمثال: تلقى مناد ضربة.",
 "命中弾": "أَصَابَ / ضَرْبَة (المرة الواحدة من الضَرْب؛ اللطمو أو الدقة أو الصكّة؛ ضربة طبل: دقة واحدة منه)\nمثال: تلقى مناد ضربة.",
 "命令": "تَرْتِيب, نِظَام (تنظيم الأشياء أو الأحداث في تسلسل معين أو وضعها في نظام؛ إعداد أو تجهيز شيء لتحقيق غاية معينة) / أَمْر, حُكْم (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة) / طَلَب (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى)) / جَمَاعَة (العَدَد الكثير من النَاس أو الحَيْوَان أو النَبَات أو غيره. المَجْمُوعَة؛ طَائِفَة من الناس التي يجمعها مكان و بيئة واحدة أو تتشارك اهداف و غايات واحدة) / وِسَام / رُتْبَة (رُتْبَة، بضم الراء؛ رَتْبَة، بفتح الراء) / أَمَرَ (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة) / طَلَبَ, حَجَزَ (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى))\nمثال: أعاد زيري ترتيب المطبخ كلية. / تَعْلِيم (الأوامر والنواهي التي يحددها دِين ما أو مَذْهَب ما. يُجمع جَمْع تَكْسِير على تَعَالِيم؛ ما دون الأمْر المُلْزِم والمستدعي للعقوبة وفوق الطَلَب الإختياري. أكثر ما يستخدم بصيغة الجمع تَعْلِيمَات) / أَمْر (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة)\nمثال: هو بارع في التعليم.",
 "命令コード": "رمز العملية, كود العملية (الجزء من مجموعة أوصاف العمليات الذي يحدد العملية التي سيتم تنفيذها؛ مجموعة العمليات في الحاسوب)",
 "命令一下": "مَنْقُول, مُتَوَارَث (اِنْتَقَلَ مِنْ جِيلٍ إِلَى جِيل)",
 "命令型": "أَسَاسِيّ, ضَرُورِيّ",
 "命令型プログラミング": "برمجة أمرية (نموذج برمجة يصف الحساب من حيث البيانات التي تغير حالة البرنامج)\nمثال: البرمجة الإجرائية هي نوع محدد (أو مجموعة فرعية) من البرمجة الأمرية",
 "命令形": "صِيغَة الأَمْر (صيغة تعبر عن نية للتأثير على سلوك المستمع)",
 "命令書": "أَمْر, مَرْسُوم (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة)\nمثال: إنه أمر مختلف .",
 "命令法": "أَمْر (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة)\nمثال: إنه أمر مختلف .",
 "命取り": "مُمِيت, قَاتِل",
 "命名": "تسمية, تعيين (فعل وضع شخص في منصب غير انتخابي) / تسمية (الفعل اللفظي للتسمية)\nمثال: كان يجب الموافقة على التعيين من قبل اللجنة بأكملها",
 "命名式": "تسمية في المعمودية (إعطاء اسم مسيحي عند المعمودية)",
 "命名日": "يَوْم اِسْم (فترة من الزمان تبدأ عند غُرُوب الشمس وتنتهي عند غُرُوب شمس النهار التالي ويشمل اللَيْلَة ونَهَارا. طوله أربع وعشرين سَاعَة؛ النَهَار، يبدأ من طلوع الفَجْر إلى غُرُوب الشَمس، على المجاز)\nمثال: طقس اليوم جميل.",
 "命名法": "تَسْمِيَة",
 "命名者": "مُسَمٍّ (شخص يطلق اسماً أو أسماء)\nمثال: عادة ما يكون المالك هو من يسمي القارب",
 "命数": "قدر, مصير (حدث (أو مسار أحداث) سيحدث حتماً في المستقبل) / قضاء, قَدَر (القوة النهائية التي يُنظر إليها على أنها تحدد مسار الأحداث مسبقاً) / حظ, قدر (ظروفك العامة أو حالتك في الحياة (بما في ذلك كل ما يحدث لك))\nمثال: نحن عاجزون أمام القدر",
 "命数法": "نظام أعداد, نظام عد (أي تدوين لتمثيل الأعداد)",
 "命根": "حَياة (الحَياة: ضد الموت والحَيُّ: ضدُّ الميّت؛ والمَحْيا مَفْعَلٌ من الحياة. تقول: مَحْيَاي ومماتي. والجمع الحَحايي)\nمثال: ما أغرب الحياة!",
 "命知らず": "تَهَوُّر (التسرع والاندفاع لفعل شيء دون التفكير بالنتائج)\nمثال: إنه خطر أن تقود بتهور.",
 "命綱": "حبل النجاة (حبل يُلقى من سفينة ليتمسك به الناس لإنقاذ أنفسهم من الغرق) / حبل الغواص (حبل يرفع أو ينزل غواص أعماق البحار) / شريان حياة, طوق نجاة (دعم يمكن الناس من البقاء أو الاستمرار في فعل شيء ما (غالباً من خلال توفير اتصال أساسي)) / خط الحياة (تجعد في راحة اليد؛ يقال في قراءة الكف أنه يشير إلى طول العمر)\nمثال: وفر الجسر الجوي شريان حياة لبرلين",
 "命脈": "حَياة (الحَياة: ضد الموت والحَيُّ: ضدُّ الميّت؛ والمَحْيا مَفْعَلٌ من الحياة. تقول: مَحْيَاي ومماتي. والجمع الحَحايي)\nمثال: ما أغرب الحياة!",
 "命運": "قِسْمَة, مَصِير (في : هو أن أحد العمليات الحسابية الرئيسية، ضد الضَرْب)\nمثال: الزواج قسمة و نصيب.",
 "命題": "قَضِيَّة (الأمر أو الشيء المُعَقَّد؛ في : ما يقضي فيه القاضي)\nمثال: سأرفع عليك قضية. / هَدَف, مَقْصَد (جاء إلى الهَدَف؛ ارتفع عن الأرض)\nمثال: لقد أخطأ الهدف. / تسمية, تعيين (فعل وضع شخص في منصب غير انتخابي) / تسمية (الفعل اللفظي للتسمية)\nمثال: كان يجب الموافقة على التعيين من قبل اللجنة بأكملها",
 "命題論理": "منطق القضايا (فرع من المنطق الرمزي يتعامل مع القضايا كوحدات ومع تركيباتها والروابط التي تربط بينها)",
 "命題論理学": "منطق القضايا (فرع من المنطق الرمزي يتعامل مع القضايا كوحدات ومع تركيباتها والروابط التي تربط بينها)",
 "咀嚼": "مضغ (عض وطحن الطعام في فمك ليصبح ناعماً بما يكفي للبلع) / هَضْم",
 "咀嚼運動": "مضغ (عض وطحن الطعام في فمك ليصبح ناعماً بما يكفي للبلع)",
 "咄々": "نَقْرَة / نَقَرَ / بِسُخْط, بِغَضَب (بطريقة تعبر عن الغضب)\nمثال: أنكر الاتهام بغضب",
 "咄咄": "نَقْرَة / نَقَرَ / بِسُخْط, بِغَضَب (بطريقة تعبر عن الغضب)\nمثال: أنكر الاتهام بغضب",
 "咄嗟": "عَزْم / لَحْظَة, دَقِيقَة",
 "咄嗟に": "حَالاً (مباشرةً، فوراً، دون تأخير؛ في هذه الأثناء، في الوضع الحالي)\nمثال: سأكون معك حالا.",
 "咆号": "أَنَّ (يفيد التوكيد) / قَهْقَهَ / زَئِير (اسم لصوت الأَسَد؛ زائير اسم سابق لجمهورية الكونغو الديمقراطية)\nمثال: كيف لي أن أعرف؟",
 "咆吼": "أَنَّ (يفيد التوكيد) / قَهْقَهَ / زَئِير (اسم لصوت الأَسَد؛ زائير اسم سابق لجمهورية الكونغو الديمقراطية)\nمثال: كيف لي أن أعرف؟",
 "咆哮": "أَنَّ (يفيد التوكيد) / قَهْقَهَ / زَئِير (اسم لصوت الأَسَد؛ زائير اسم سابق لجمهورية الكونغو الديمقراطية)\nمثال: كيف لي أن أعرف؟",
 "和": "هَادِئ / طَمْأَنَ / مَجْمُوع / مَبْلَغ / اِنْسِجَام, تَوَافُق / الْيَابَان (دولة جزرية في شرق قارة آسيا، عاصمتها طوكيو)\nمثال: أنا من اليابان. / رَاكِد, سَاجٍ ((عَنْ جِسْمٍ مَائِيّ) خَالٍ مِنَ الاضْطِرَاب بِسَبَب الأَمْوَاج الكَبِيرَة) / سَاكِن, هَادِئ (غير مضطرب؛ يحافظ على ضبط النفس)",
 "和える": "لَبِسَ (خَلَطَ بحيث يصعب التمييز والفصل؛ الأمر: خلطه فاشتبه واضطرب) / ثَوْب, لِبَاس (ما يُلْبَسُ من اللِبَاس، أي جزء ويطلق للرجال والنساء؛ الجزء الرئيس من الملابس، غالبا ما يكون طويلا وواسعا وذو أكمام، تحته الملابس الداخلية وفوقه الخارجية. يستخدم للرجال والنساء) / كَسْوَة, مَلْبَس\nمثال: لبس سروالا نظيفا.",
 "和がり": "انتصار, فوز (النجاح بعد صعوبة كبيرة) / أَخَّاذ, خَلَّاب (بالغ الجاذبيّة؛ يستولي على الاهتمام) / فَائِز, مُنْتَصِر (حقق الفوز أو الانتصار)\nمثال: الفوز ليس كل شيء",
 "和ぎ": "هَادِئ / طَمْأَنَ",
 "和ぐ": "أَهْدَأَ, هَدَّأَ",
 "和する": "جَمَعَ (ضَمَّ، لَمَّ، حَشَدَ؛ في : أَضَافَ أعدادا إلى غيرها) / أَضَافَ\nمثال: جمع خيل هو خيول.",
 "和ます": "هَادِئ / طَمْأَنَ",
 "和む": "أَهْدَأَ, هَدَّأَ",
 "和める": "هَادِئ / طَمْأَنَ",
 "和やか": "مُعْتَدِل (الأمر الوسط بين الطَرَفْيَن، نقيض المُتَطَرِّف)\nمثال: الجو معتدل هنا.",
 "和ら": "جُودُو",
 "和らぎ": "تَخْفِيف / تَسْكِين",
 "和らぐ": "أَهْدَأَ, هَدَّأَ",
 "和らげる": "مُعْتَدِل (الأمر الوسط بين الطَرَفْيَن، نقيض المُتَطَرِّف)\nمثال: الجو معتدل هنا.",
 "和り": "انتصار, فوز (النجاح بعد صعوبة كبيرة) / أَخَّاذ, خَلَّاب (بالغ الجاذبيّة؛ يستولي على الاهتمام) / فَائِز, مُنْتَصِر (حقق الفوز أو الانتصار)\nمثال: الفوز ليس كل شيء",
 "和を結ぶ": "سَالَمَ, صَالَحَ",
 "和三盆": "دَقِيقُ الْحُبَيْبَاتِ, مُتَرَاصّ (كثيف أو متراصّ البنية كخشب مؤلّف من خلايا صغيرة القطر) / مَسْحُوق, مُسَحَّق (يتكوّن من جزيئات دقيقة ناعمة)",
 "和上": "معلم جامعي (معلم في جامعة أو كلية (خاصة في كامبريدج أو أكسفورد)) / رَاهِب, نَاسِك (اسم فاعل للفعل رَهَبَ؛ عند المَسِيحِيّين هو من تَبَتَّلَ لله واعْتَزَلَ الناس إلى بعض الأدْيِرَة طلبا للعِبَادَة) / سَيِّد / أُصُولِيّ, أُصُولِيَّة / أحسن, أتقن ((أَحْسَنَ): فعل مَا هُوَ حسن؛ (أَحْسَنَ) الشَّيْء: أَجَاد صنعه وأتقنه)\nمثال: يبدو زيري أحسن.",
 "和主": "مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة!",
 "和了": "انتصار, فوز (النجاح بعد صعوبة كبيرة) / أَخَّاذ, خَلَّاب (بالغ الجاذبيّة؛ يستولي على الاهتمام) / فَائِز, مُنْتَصِر (حقق الفوز أو الانتصار)\nمثال: الفوز ليس كل شيء",
 "和了り": "انتصار, فوز (النجاح بعد صعوبة كبيرة) / أَخَّاذ, خَلَّاب (بالغ الجاذبيّة؛ يستولي على الاهتمام) / فَائِز, مُنْتَصِر (حقق الفوز أو الانتصار)\nمثال: الفوز ليس كل شيء",
 "和人": "مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة!",
