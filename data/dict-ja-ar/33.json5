 "利": "أَفْضَلِيَّة, فَائِدَة",
 "利いた風": "خَفِيف العَقْل, مُسْتَخِفّ (يُظهر خفّة غير لائقة في موضع يستدعي الجدّية)",
 "利かす": "اِسْتِعْمَال, اِسْتِخْدَام (اِسْتِعْمَال)\nمثال: أيمكنني استعمال هاتفك؟",
 "利かせる": "اِسْتِعْمَال, اِسْتِخْدَام (اِسْتِعْمَال)\nمثال: أيمكنني استعمال هاتفك؟",
 "利かぬ": "عَنيد, غَليظ (شَديد القَسْوَة وعَديم الرَّحْمَة؛ لا يَرِقّ قَلْبُه)",
 "利かぬ気": "مُتَوَحِّش, خارج عن السيطرَة",
 "利かん気": "مُتَوَحِّش, خارج عن السيطرَة",
 "利き": "فعالية, قوة تأثير (القدرة على إنتاج تأثيرات فسيولوجية أو كيميائية قوية)\nمثال: قوة تأثير التوكسين / جانبية, هيمنة جانبية (تطور متفوق لجانب واحد من الجسم)\nمثال: لديه السلطة لإصدار مذكرات التوقيف / مَذَاق (مَا تُدْرِكُهُ حَاسَّةُ الذَّوْق)\nمثال: التين حلو المذاق.",
 "利き所": "نقطة ضغط (منطقة على الجلد حساسة للغاية للضغط)\nمثال: يجب أن تعرف نقاط الضغط لكي تمارس شياتسو",
 "利き目": "تَأْثِير, أَثَر",
 "利き酒": "تَذَوُّق النَّبِيذ (تجمع للناس لتذوق ومقارنة أنواع مختلفة من النبيذ)",
 "利く": "عَمَل, شُغْل (فِعْل، صُنْع؛ وسيلة للكسب، مِهْنَة، حِرْفَة)\nمثال: المهم هو العمل. / اِسْتَطَاعَ, قَدَرَ (أَطَاقَ الشَّيءَ وقَدَرَ عليه، أَمْكَنَهُ الشَّيءُ)\nمثال: توم استطاع ان يهرب / حَسَبَ الرَغَبَة (عَدَّ مع الجَمْع والطَرْح وغيرها من العمليات الحِسَابية؛ عند أكثر العامة: هو…)\nمثال: حسب سامي المال.",
 "利け者": "شخصية مؤثرة, شخصية هامة (شخص تؤثر أفعاله وآراؤه بقوة على مسار الأحداث)",
 "利ざや": "هَامِش إِجْمَالِيّ, هَامِش الرِّبْح (نسبة إجمالي الأرباح مقسومة على صافي المبيعات)",
 "利し": "حَادّ (مَالَ وَانْحَرَفَ عَنِ الطَّرِيقِ؛ تَجَنَّبَ شَيْئًا أَوِ الْاِلْتِزَامَ…)\nمثال: عندك ذاكرة حادة. / شَدِيد / سَرِيع\nمثال: ينبح كلب في الحي. / سَنِين, مُرْهَف (له حافة قاطعة أو رأس حادّ)",
