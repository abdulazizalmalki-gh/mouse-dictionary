 "割り付け": "تخصيص, تقسيم (فعل التوزيع عن طريق التخصيص أو التقسيم؛ التوزيع وفقاً لخطة) / تخصيص, مخصص (حصة مخصصة لغرض محدد)\nمثال: يعتمد توزيع المقاعد في مجلس النواب على الكثافة السكانية لكل ولاية",
 "割り付ける": "خَصَّصَ (خَصَّصَ الشيءَ: جعله خاصًّا؛ خَصَّصَ فلانًا بالشيءِ: خَصَّهُ به)\nمثال: حاول توفير بعض المال من ما خصص للسفر.",
 "割り出す": "حَسَبَ (عَدَّ مع الجَمْع والطَرْح وغيرها من العمليات الحِسَابية؛ عند أكثر العامة: هو العَدّ مطلقا)\nمثال: حسب سامي المال. / إِسْتَنْتَجَ",
 "割り切れない": "غير قابل للتجزئة, غير قابل للقسمة (من المستحيل أن يخضع للتقسيم)\nمثال: اتحاد ولايات غير قابل للانقسام / غير مقنع, واهٍ (ليس مقنعاً) / غَيْر مُقْنِع, مُسْتَبْعَد (ذو احتمالية منخفضة جداً لا تبعث على التصديق)\nمثال: حجة واهية",
 "割り前": "نَصِيب, حِصَّة / سَهْم (سَهَمَ؛ سَهَّمَ) / شَارَكَ\nمثال: لم يصب السهم توم.",
 "割り前勘定": "تقاسم الحساب, عشاء هولندي (عشاء حيث يدفع كل شخص ثمن طعامه)",
 "割り勘": "تقاسم الحساب, عشاء هولندي (عشاء حيث يدفع كل شخص ثمن طعامه)",
 "割り合い": "مُعَدَّل (هو الأمر الذي جرى عليه تَعْدِيل فهو أفضل من ما يناظره؛ السيارة المعدّلة تسير بسرعة أكبر من مثيلاتها) / سِعْر (سَعِرَ يَسْعَرَ سَعَراً، وسُعْرَةً: ضرب لونه إِلى السواد فُوَيْقَ الأُدْمة؛ فهو أَسْعَرُ، وهي سَعْراءُ. والجمع: سُعْرٌ)\nمثال: انخفض معدل الجريمة. / نِسْبِيّاً",
 "割り増し": "إِضَافِيّ, زَائِد (أكثر من اللازم أو مُضاف إلى ما هو موجود) / بشكل إضافي, بشكل استثنائي (بشكل غير عادي أو استثنائي) / زَائِد, فَائِض (أكثر مما هو مطلوب أو مرغوب فيه أو لازم) / إِضَافِيّ, خَاصّ (مضاف إلى الجدول المنتظم)\nمثال: سيارة سريعة بشكل استثنائي",
 "割り増し料金": "رسم إضافي (رسم إضافي (كما هو الحال بالنسبة للعناصر التي تم حذفها سابقاً أو كعقوبة لعدم ممارسة الحذر العام أو المهارة العامة))",
 "割り増し金": "إصدار مُكَلف / فاخر",
 "割り安": "اقْتِصَادِيّ, مُوَفِّر (يستخدم الحدّ الأدنى من الوقت أو الموارد اللازمة للفاعلية) / زَاهِد, مُقْتَصِد (يَتَجَنَّبُ الإِسْرَافَ وَالهَدْر) / اقتصادي (مكون من أو متعلق بالاقتصاد، نظام الإنتاج وإدارة الثروة المادية)\nمثال: نمو اقتصادي",
 "割り引": "خَصْم, تَخْفِيض (الخَصْمُ :مُجَادِل، مُنَازِع، مُخَاصِم، عكسه حَلِيف أو صَدِيْق، وقد يستوي فيه المفرد والمثنى والجمع؛ والخَصْمُ (في ) : حَطِيطَة)",
 "割り引き": "خَصْم, تَخْفِيض (الخَصْمُ :مُجَادِل، مُنَازِع، مُخَاصِم، عكسه حَلِيف أو صَدِيْق، وقد يستوي فيه المفرد والمثنى والجمع؛ والخَصْمُ (في ) : حَطِيطَة)",
 "割り引く": "خَصْم, تَخْفِيض (الخَصْمُ :مُجَادِل، مُنَازِع، مُخَاصِم، عكسه حَلِيف أو صَدِيْق، وقد يستوي فيه المفرد والمثنى والجمع؛ والخَصْمُ (في ) : حَطِيطَة)",
 "割り当て": "تخصيص, تقسيم (فعل التوزيع عن طريق التخصيص أو التقسيم؛ التوزيع وفقاً لخطة) / تخصيص, مخصص (حصة مخصصة لغرض محدد)\nمثال: يعتمد توزيع المقاعد في مجلس النواب على الكثافة السكانية لكل ولاية / تَخْصِيص",
 "割り当てる": "تعيين شخص لعمل ما",
 "割り当て額": "تخصيص, تقسيم (فعل التوزيع عن طريق التخصيص أو التقسيم؛ التوزيع وفقاً لخطة) / تخصيص, مخصص (حصة مخصصة لغرض محدد)\nمثال: يعتمد توزيع المقاعد في مجلس النواب على الكثافة السكانية لكل ولاية",
 "割り戻す": "حز, فريز (أخدود مستطيل يُعمل لتثبيت قطعتين معاً) / استرداد جزئي, تخفيض (استرداد لجزء من المبلغ المدفوع)",
 "割り振り": "تَخْصِيص",
 "割り振る": "تعيين شخص لعمل ما",
 "割り方": "نِسْبِيّاً / مُعَدَّل (هو الأمر الذي جرى عليه تَعْدِيل فهو أفضل من ما يناظره؛ السيارة المعدّلة تسير بسرعة أكبر من مثيلاتها) / سِعْر (سَعِرَ يَسْعَرَ سَعَراً، وسُعْرَةً: ضرب لونه إِلى السواد فُوَيْقَ الأُدْمة؛ فهو أَسْعَرُ، وهي سَعْراءُ. والجمع: سُعْرٌ)\nمثال: انخفض معدل الجريمة.",
 "割り材": "خَلَّاط, خَفَّاقَة",
 "割り栗": "إِبَاحِيّ صَرِيح (صريح إلى أقصى درجة في المحتوى الجنسي) / مُتَشَدِّد فِي الوَلَاء, مُوَالٍ بِشِدَّة (شَدِيد الوَلَاء والإِخْلَاص)",
 "割り栗石": "إِبَاحِيّ صَرِيح (صريح إلى أقصى درجة في المحتوى الجنسي) / مُتَشَدِّد فِي الوَلَاء, مُوَالٍ بِشِدَّة (شَدِيد الوَلَاء والإِخْلَاص)",
 "割り目": "صَدْع ((صَدَعَ) النباتُ الأرضَ يَصْدَعَ صَدْعًا: شَقَّها وظَهَرَ منها؛ (صَدَعَ) الزجاجَ ونحوه: كسره)",
 "割り石": "أَنْقَاض, رُكام",
 "割り符": "ركضة, نقطة (نقطة في البيسبول يسجلها العداء بلمس جميع القواعد الأربع بأمان) / إحصاء, عد (فعل العد؛ تلاوة الأرقام بترتيب تصاعدي) / حساب, كشف الحساب (فاتورة بمبلغ مستحق)\nمثال: سجل فريق اليانكيز 3 ركضات في النصف الثاني من الشوط التاسع",
 "割り算": "تَقْسِيم / قِسْمَة (في : هو أن أحد العمليات الحسابية الرئيسية، ضد الضَرْب) / قِسْمَةٌ (في : هو أن أحد العمليات الحسابية الرئيسية، ضد الضَرْب) / فِرْقَة / فُرْقَة\nمثال: الزواج قسمة و نصيب.",
 "割り箸": "أَعْوَاد الْأَكْل, هَاشِي",
 "割り解す": "نَبْض / ضَرَبَ, دَقَّ (معروف، وهو اللطم أو الدق أو الصكّ و ما أشبه؛ النَوْع أو الصنف أو المثال) / وَجَفَ / هَزَمَ, غَلَبَ / خَفَقَ (الجذر يعبر عن الحركة والاضطراب الخفيف الذي ينشأ عن الرياح أو القلوب أو الرايات، ويستخدم لوصف الطبيعة والأحاسيس والجوانب الحسية المختلفة؛ عبّر عن حركة سريعة، سواء كانت اضطراباً أو ضرباً خفيفاً أو صوتاً، بالإضافة إلى صفةٍ تُوصف بها الخيل)\nمثال: ضرب سامي زوجته.",
 "割り込み": "قَاطَعَ / إِسْفِين (عبارة عن وَتَد أو قطعة من الخَشَب أو الحَدِيد تستخدم في البِنَاء والنِجَارَة بلإبقاء على فُرْجَة بين الأجسام، خصوصا ألواح الخشب، أو لتكوين هذه الفرجة؛ دَقَّ بينهم إسفينا: فَرَّقَ بينهم) / وَتِد (العصا تثبت في الأرض لتثبيت شيء ما بربطه إليها) / وَتَد (العصا تثبت في الأرض لتثبيت شيء ما بربطه إليها)",
 "割り込む": "إِسْفِين (عبارة عن وَتَد أو قطعة من الخَشَب أو الحَدِيد تستخدم في البِنَاء والنِجَارَة بلإبقاء على فُرْجَة بين الأجسام، خصوصا ألواح الخشب، أو لتكوين هذه الفرجة؛ دَقَّ بينهم إسفينا: فَرَّقَ بينهم) / وَتِد (العصا تثبت في الأرض لتثبيت شيء ما بربطه إليها) / وَتَد (العصا تثبت في الأرض لتثبيت شيء ما بربطه إليها)",
 "割り返し": "حز, فريز (أخدود مستطيل يُعمل لتثبيت قطعتين معاً) / استرداد جزئي, تخفيض (استرداد لجزء من المبلغ المدفوع)",
 "割り醤油": "صَلْصَةْ اَلصُّويَا",
 "割り鏨": "إزميل هدم (إزميل طويل بطرف قطع منحني قليلاً؛ يستخدم للرفع الثقيل أو تنظيف النقرات)",
 "割る": "قَسَّمَ (فَرَّقَ أو قَسَّمَ الشَّيءَ إلى أجزاء أو أجزاء مختلفة؛ أَحْلَفَ، أَي جَعَلَ يَحْلِفُ على أمرٍ ما)\nمثال: أنا أزين القسم. / جَرَحَ (كَلَمَ، شَقَّ اللَحْم وأسَالَ الدَمّ؛ صَادَ أو اكْتَسَبَ) / قَصَّ\nمثال: ذلك سيهيج الجرح. / اِنْكَسَرَ (فعل مطاوعة لكَسَرَ، قام أحدهم بكَسْره أو قام هو بكَسْر نفسه؛ التاجر: خَسِرَ المال ونَقَصَ عنده المال، أفْلَسَ) / كَسَرَ / اِسْتِرَاحَة (مبنى خارج المدن يتوقف فيه المسافرون للراحة والتَزَوُّد يُجمع على اِسْتِرَاحَات)\nمثال: عليك أخذ استراحة. / خَفَّفَ (قلل شيئًا أو نقص من حدته؛ هون أو لطف من شدة أمر)\nمثال: خفف زيري السرعة.",
 "割れ": "تَحْتَ (أَقَلَّ) / جَنُوبِيّ\nمثال: أنا تحت الشجرة.",
 "割れる": "اِنْكَسَرَ (فعل مطاوعة لكَسَرَ، قام أحدهم بكَسْره أو قام هو بكَسْر نفسه؛ التاجر: خَسِرَ المال ونَقَصَ عنده المال، أفْلَسَ) / كَسَرَ / اِسْتِرَاحَة (مبنى خارج المدن يتوقف فيه المسافرون للراحة والتَزَوُّد يُجمع على اِسْتِرَاحَات)\nمثال: عليك أخذ استراحة. / انفصل / مِشْبَك / كْلِيبْ",
 "割れ易い": "سَرِيعُ الكَسْر, هَشّ (قَلِيلُ المُرُونَة؛ يَسْهُلُ تَشَقُّقُهُ أَوِ انْكِسَارُهُ) / غَيْرُ مُلَدَّن, هَشّ ((لِلْمَعْدَنِ أَوِ الزُّجَاج) لَمْ يُلَدَّنْ وَبِالتَّالِي سَهْلُ التَّشَقُّقِ أَوِ الكَسْر) / جَافّ, قَاسٍ (يفتقر إلى الدفء والسخاء في الروح) / بريتل, توفي (سكر مكرمل مبرد في صفائح رقيقة)",
 "割れ物注意": "هَشّ (رقيق أو ضعيف البنية؛ لين وسهل الكسر أو التفتيت)",
 "割れ目": "صَدْع ((صَدَعَ) النباتُ الأرضَ يَصْدَعَ صَدْعًا: شَقَّها وظَهَرَ منها؛ (صَدَعَ) الزجاجَ ونحوه: كسره) / قَطَعَ, شَطَبَ (قطع الشيء : جزه؛ قطع الشيء : فصل بعضه عن بعضه الآخر)\nمثال: قطع زيري العشب.",
 "割れ鍋に綴じ蓋": "هُنَاكَ, يُوجَدُ",
 "割付": "تخصيص, تقسيم (فعل التوزيع عن طريق التخصيص أو التقسيم؛ التوزيع وفقاً لخطة) / تخصيص, مخصص (حصة مخصصة لغرض محدد)\nمثال: يعتمد توزيع المقاعد في مجلس النواب على الكثافة السكانية لكل ولاية",
 "割付け": "تخصيص, تقسيم (فعل التوزيع عن طريق التخصيص أو التقسيم؛ التوزيع وفقاً لخطة) / تخصيص, مخصص (حصة مخصصة لغرض محدد)\nمثال: يعتمد توزيع المقاعد في مجلس النواب على الكثافة السكانية لكل ولاية",
 "割付ける": "خَصَّصَ (خَصَّصَ الشيءَ: جعله خاصًّا؛ خَصَّصَ فلانًا بالشيءِ: خَصَّهُ به)\nمثال: حاول توفير بعض المال من ما خصص للسفر.",
 "割付る": "خَصَّصَ (خَصَّصَ الشيءَ: جعله خاصًّا؛ خَصَّصَ فلانًا بالشيءِ: خَصَّهُ به)\nمثال: حاول توفير بعض المال من ما خصص للسفر.",
 "割前": "نَصِيب, حِصَّة / سَهْم (سَهَمَ؛ سَهَّمَ) / شَارَكَ\nمثال: لم يصب السهم توم.",
 "割前勘定": "تقاسم الحساب, عشاء هولندي (عشاء حيث يدفع كل شخص ثمن طعامه)",
 "割勘": "تقاسم الحساب, عشاء هولندي (عشاء حيث يدفع كل شخص ثمن طعامه)",
 "割合": "مُعَدَّل (هو الأمر الذي جرى عليه تَعْدِيل فهو أفضل من ما يناظره؛ السيارة المعدّلة تسير بسرعة أكبر من مثيلاتها) / سِعْر (سَعِرَ يَسْعَرَ سَعَراً، وسُعْرَةً: ضرب لونه إِلى السواد فُوَيْقَ الأُدْمة؛ فهو أَسْعَرُ، وهي سَعْراءُ. والجمع: سُعْرٌ)\nمثال: انخفض معدل الجريمة. / نِسْبِيّاً",
 "割合に": "نِسْبِيّاً",
 "割増": "إِضَافِيّ, زَائِد (أكثر من اللازم أو مُضاف إلى ما هو موجود) / بشكل إضافي, بشكل استثنائي (بشكل غير عادي أو استثنائي) / زَائِد, فَائِض (أكثر مما هو مطلوب أو مرغوب فيه أو لازم) / إِضَافِيّ, خَاصّ (مضاف إلى الجدول المنتظم)\nمثال: سيارة سريعة بشكل استثنائي",
 "割増し": "إِضَافِيّ, زَائِد (أكثر من اللازم أو مُضاف إلى ما هو موجود) / بشكل إضافي, بشكل استثنائي (بشكل غير عادي أو استثنائي) / زَائِد, فَائِض (أكثر مما هو مطلوب أو مرغوب فيه أو لازم) / إِضَافِيّ, خَاصّ (مضاف إلى الجدول المنتظم)\nمثال: سيارة سريعة بشكل استثنائي",
 "割増し料金": "رسم إضافي (رسم إضافي (كما هو الحال بالنسبة للعناصر التي تم حذفها سابقاً أو كعقوبة لعدم ممارسة الحذر العام أو المهارة العامة))",
 "割増料金": "رسم إضافي (رسم إضافي (كما هو الحال بالنسبة للعناصر التي تم حذفها سابقاً أو كعقوبة لعدم ممارسة الحذر العام أو المهارة العامة))",
 "割安": "اقْتِصَادِيّ, مُوَفِّر (يستخدم الحدّ الأدنى من الوقت أو الموارد اللازمة للفاعلية) / زَاهِد, مُقْتَصِد (يَتَجَنَّبُ الإِسْرَافَ وَالهَدْر) / اقتصادي (مكون من أو متعلق بالاقتصاد، نظام الإنتاج وإدارة الثروة المادية)\nمثال: نمو اقتصادي",
 "割引": "خَصْم, تَخْفِيض (الخَصْمُ :مُجَادِل، مُنَازِع، مُخَاصِم، عكسه حَلِيف أو صَدِيْق، وقد يستوي فيه المفرد والمثنى والجمع؛ والخَصْمُ (في ) : حَطِيطَة)",
 "割引き": "خَصْم, تَخْفِيض (الخَصْمُ :مُجَادِل، مُنَازِع، مُخَاصِم، عكسه حَلِيف أو صَدِيْق، وقد يستوي فيه المفرد والمثنى والجمع؛ والخَصْمُ (في ) : حَطِيطَة)",
 "割引く": "خَصْم, تَخْفِيض (الخَصْمُ :مُجَادِل، مُنَازِع، مُخَاصِم، عكسه حَلِيف أو صَدِيْق، وقد يستوي فيه المفرد والمثنى والجمع؛ والخَصْمُ (في ) : حَطِيطَة)",
 "割引処理": "التأكيد على الفاعلية / تصديق (صَدّقّهُ تصديقا:ضد كذَّبّهُ؛ تَصْديق: مصدر صدَّقَ/صَدّقَ ب/صَدّقَ على)\nمثال: رفصنا تصديق ذلك.",
 "割引料金": "خَصْم, تَخْفِيض (الخَصْمُ :مُجَادِل، مُنَازِع، مُخَاصِم، عكسه حَلِيف أو صَدِيْق، وقد يستوي فيه المفرد والمثنى والجمع؛ والخَصْمُ (في ) : حَطِيطَة)",
 "割引歩合": "خصم مصرفي, سعر الخصم (فائدة على أساس سنوي تُخصم مقدماً على قرض) / سعر الخصم الفيدرالي (سعر الفائدة الذي يحدده الاحتياطي الفيدرالي والذي يُفرض على البنوك الأعضاء عند اقتراض الأموال من خلال نظام الاحتياطي الفيدرالي)",
 "割引率": "خصم مصرفي, سعر الخصم (فائدة على أساس سنوي تُخصم مقدماً على قرض) / سعر الخصم الفيدرالي (سعر الفائدة الذي يحدده الاحتياطي الفيدرالي والذي يُفرض على البنوك الأعضاء عند اقتراض الأموال من خلال نظام الاحتياطي الفيدرالي)",
 "割当": "تخصيص, تقسيم (فعل التوزيع عن طريق التخصيص أو التقسيم؛ التوزيع وفقاً لخطة) / تخصيص, مخصص (حصة مخصصة لغرض محدد)\nمثال: يعتمد توزيع المقاعد في مجلس النواب على الكثافة السكانية لكل ولاية / تَخْصِيص",
 "割当て": "تخصيص, تقسيم (فعل التوزيع عن طريق التخصيص أو التقسيم؛ التوزيع وفقاً لخطة) / تخصيص, مخصص (حصة مخصصة لغرض محدد)\nمثال: يعتمد توزيع المقاعد في مجلس النواب على الكثافة السكانية لكل ولاية / تَخْصِيص",
 "割当てる": "تعيين شخص لعمل ما",
 "割当額": "تخصيص, تقسيم (فعل التوزيع عن طريق التخصيص أو التقسيم؛ التوزيع وفقاً لخطة) / تخصيص, مخصص (حصة مخصصة لغرض محدد)\nمثال: يعتمد توزيع المقاعد في مجلس النواب على الكثافة السكانية لكل ولاية",
 "割愛": "سَاقِط, مُتَسَاقِط (يَنْزِلُ بِحُرِّيَّةٍ تَحْتَ تَأْثِيرِ الجَاذِبِيَّة) / ترك, هجران (فعل الهجر أو التخلي) / إذعان, استسلام (فعل لفظي للاعتراف بالهزيمة)",
 "割戻す": "حز, فريز (أخدود مستطيل يُعمل لتثبيت قطعتين معاً) / استرداد جزئي, تخفيض (استرداد لجزء من المبلغ المدفوع)",
 "割振り": "تَخْصِيص",
 "割振る": "تعيين شخص لعمل ما",
 "割断": "قص, قطع (عملية تقصير شيء ما بقطع أطرافه) / تخفيف, مزج (عملية تخفيف شيء ما) / تقطيع, قطع (عملية قطع شيء ما إلى أجزاء) / قص, قطع (عملية الاختراق أو الفتح بحافة حادة)\nمثال: أعطاه الحلاق قصة جيدة",
 "割方": "نِسْبِيّاً / مُعَدَّل (هو الأمر الذي جرى عليه تَعْدِيل فهو أفضل من ما يناظره؛ السيارة المعدّلة تسير بسرعة أكبر من مثيلاتها) / سِعْر (سَعِرَ يَسْعَرَ سَعَراً، وسُعْرَةً: ضرب لونه إِلى السواد فُوَيْقَ الأُدْمة؛ فهو أَسْعَرُ، وهي سَعْراءُ. والجمع: سُعْرٌ)\nمثال: انخفض معدل الجريمة.",
 "割材": "خَلَّاط, خَفَّاقَة",
 "割栗": "إِبَاحِيّ صَرِيح (صريح إلى أقصى درجة في المحتوى الجنسي) / مُتَشَدِّد فِي الوَلَاء, مُوَالٍ بِشِدَّة (شَدِيد الوَلَاء والإِخْلَاص)",
 "割栗石": "إِبَاحِيّ صَرِيح (صريح إلى أقصى درجة في المحتوى الجنسي) / مُتَشَدِّد فِي الوَلَاء, مُوَالٍ بِشِدَّة (شَدِيد الوَلَاء والإِخْلَاص)",
 "割殻": "روبيان الهيكل العظمي (قشري صغير من مزدوجات الأرجل له شكل غريب يوحي بفرس النبي؛ يوجد بشكل رئيسي على الأعشاب البحرية)",
 "割烹": "طَبْخ (أَنْضَجَ الطعام بتسخينه)\nمثال: سامي يحب الطبخ. / مَطْعَم",
 "割烹店": "مَطْعَم",
 "割球": "فلقة, قسيمة أريمية (أي خلية ناتجة عن انقسام البويضة المخصبة)",
 "割目": "صَدْع ((صَدَعَ) النباتُ الأرضَ يَصْدَعَ صَدْعًا: شَقَّها وظَهَرَ منها؛ (صَدَعَ) الزجاجَ ونحوه: كسره)",
 "割石": "أَنْقَاض, رُكام",
 "割礼": "خِتَان / طهور",
 "割礼を施す": "خَتَنَ ((خَتَنَ) ختونا وختونة: تزوج والصبي؛ (ختن) ختنا وختانا وختانة: قطع قلفته فهو مختون ويقال ختن الصبية وهو وهي ختين)\nمثال: ختن سامي في سن السادسة من عمره.",
 "割符": "ركضة, نقطة (نقطة في البيسبول يسجلها العداء بلمس جميع القواعد الأربع بأمان) / إحصاء, عد (فعل العد؛ تلاوة الأرقام بترتيب تصاعدي) / حساب, كشف الحساب (فاتورة بمبلغ مستحق)\nمثال: سجل فريق اليانكيز 3 ركضات في النصف الثاني من الشوط التاسع",
 "割算": "تَقْسِيم / قِسْمَة (في : هو أن أحد العمليات الحسابية الرئيسية، ضد الضَرْب) / قِسْمَةٌ (في : هو أن أحد العمليات الحسابية الرئيسية، ضد الضَرْب) / فِرْقَة / فُرْقَة\nمثال: الزواج قسمة و نصيب.",
 "割腔": "تجويف الأريمة (التجويف المملوء بالسائل داخل الأريمة)",
 "割腹": "إخراج الأحشاء, نزع الأحشاء (عملية إزالة الأمعاء أو الأحشاء؛ عملية القطع بحيث تبرز الأحشاء)",
 "割薬": "حشوة متفجرة, شحنة (كمية من المتفجرات يتم تفجيرها في وقت واحد)\nمثال: تحتوي هذه الخرطوشة على شحنة بارود تبلغ 50 حبة",
 "割解す": "نَبْض / ضَرَبَ, دَقَّ (معروف، وهو اللطم أو الدق أو الصكّ و ما أشبه؛ النَوْع أو الصنف أو المثال) / وَجَفَ / هَزَمَ, غَلَبَ / خَفَقَ (الجذر يعبر عن الحركة والاضطراب الخفيف الذي ينشأ عن الرياح أو القلوب أو الرايات، ويستخدم لوصف الطبيعة والأحاسيس والجوانب الحسية المختلفة؛ عبّر عن حركة سريعة، سواء كانت اضطراباً أو ضرباً خفيفاً أو صوتاً، بالإضافة إلى صفةٍ تُوصف بها الخيل)\nمثال: ضرب سامي زوجته.",
 "割譲": "تنازل (فعل التنازل عن ملكية أو حق)",
 "割賦": "تخصيص, تقسيم (فعل التوزيع عن طريق التخصيص أو التقسيم؛ التوزيع وفقاً لخطة) / تخصيص, مخصص (حصة مخصصة لغرض محدد)\nمثال: يعتمد توزيع المقاعد في مجلس النواب على الكثافة السكانية لكل ولاية",
 "割賦方式": "خطة تقسيط, شراء بالتقسيط (نظام لدفع ثمن البضائع على أقساط)",
 "割込": "قَاطَعَ / إِسْفِين (عبارة عن وَتَد أو قطعة من الخَشَب أو الحَدِيد تستخدم في البِنَاء والنِجَارَة بلإبقاء على فُرْجَة بين الأجسام، خصوصا ألواح الخشب، أو لتكوين هذه الفرجة؛ دَقَّ بينهم إسفينا: فَرَّقَ بينهم) / وَتِد (العصا تثبت في الأرض لتثبيت شيء ما بربطه إليها) / وَتَد (العصا تثبت في الأرض لتثبيت شيء ما بربطه إليها)",
 "割込み": "قَاطَعَ / إِسْفِين (عبارة عن وَتَد أو قطعة من الخَشَب أو الحَدِيد تستخدم في البِنَاء والنِجَارَة بلإبقاء على فُرْجَة بين الأجسام، خصوصا ألواح الخشب، أو لتكوين هذه الفرجة؛ دَقَّ بينهم إسفينا: فَرَّقَ بينهم) / وَتِد (العصا تثبت في الأرض لتثبيت شيء ما بربطه إليها) / وَتَد (العصا تثبت في الأرض لتثبيت شيء ما بربطه إليها)",
 "割込み分類": "إقحام, كبس (إدراج في التقويم (مثل يوم كبيس))",
 "割醤油": "صَلْصَةْ اَلصُّويَا",
 "剴切": "مُلَاءَمَة, مُوَافَقَة (صفة كون الشيء مناسباً بشكل خاص) / صوابية, ملاءمة (السلوك المناسب؛ فعل الشيء الصحيح)",
 "創む": "نَجْمَة, اِبْتِدَاء / نَجْمَة / بَدَأَ (حَدَثَ ونَشَأَ وحَصَلَ؛ أَخَذَ، شَرَعَ)\nمثال: بدأ سامي يتكلم.",
 "創り上げる": "اِنْتَهَى, أَكْمَلَ (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات) / كَامِل / ذَرِيع\nمثال: انتهى أمر زيري. / اِفْتَرَى, اِخْتَلَقَ",
 "創り出す": "صَنَعَ, أَنْتَجَ (عَمِلَ شيئًا يعلم ويُجِيد كيفية عَمَلِه؛ فَعَلَ)\nمثال: صنع لي أبي رفا. / اِخْتَرَعَ",
 "創る": "فَعَلَ, صَنَعَ (عَمِلَ وصَنَعَ، بعلم أو بدون علم، عن قصد أو دون قصد) / جَعَلَ (صَيَّرَ؛ أَنْشَأَ)\nمثال: ماذا فعل للحمي؟ / جَهَّزَ, حَضَّرَ (جَهاز العَرُوس وَالْمَيِّتِ وجِهازهما: مَا يَحْتَاجَانِ إِليه؛ جَهَّزَه فَتَجَهَّز وجَهَّزْتُ العروسَ تَجْهِيزاً، وَكَذَلِكَ جَهَّزت الْجَيْشَ) / اِسْتَعَدَّ, تَأَهَّبَ (اِسْتَعَدَّ للامْتِحانِ بِجِدٍّ: حَضَّرَ لَه؛ يَسْتَعِدُّ لِلْمُبَارَاةِ: يَتَهَيَّأُ لَهَا)\nمثال: جهز زيري حقائبه. / رَفَعَ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ)\nمثال: رفع سامي نظارته. / حَتَّى, إِلَى أَنّ (يفيد انتهاء الغاية؛ يفيد الغاية) / حَرَثَ (حرث الأرض: شقها بالمحراث ليزرعها؛ حرث النار: حركها وأثارها)\nمثال: انتظر حتى أجلس.",
 "創世記": "تَكْوِين",
 "創作": "خِلْقَة, خَلْق / اِبْتِكَار, خَلْق / خَلْق (أَنْشَأَ، أَوْجَدَ)\nمثال: زيري سيء الخلق. / فَبْرَكَة",
 "創作力": "عَبْقَرِيّ, نَابِغَة / عَبْقَرِيَّة",
 "創作活動": "إبداع, خلق (الفعل البشري المتمثل في الإيجاد أو الابتكار)",
 "創作物": "خِلْقَة, خَلْق / اِبْتِكَار, خَلْق / خَلْق (أَنْشَأَ، أَوْجَدَ)",
 "創作的": "إِبْداعِيّ, خَلَّاق",
 "創作者": "خَالِق (الخالق : اسم من أسماء الله الحسنى ، ومعناه : الذي يُخرج من العدم إلى الوجود ، ويصنِّف المُبدَعات…؛ خَالِقُ الْكَوْنِ : مُنْشِؤُهُ ، مُكَوِّنُهُ ، اللهُ سُبْحَانَهُ) / مُبْدِع\nمثال: القرآن منزل من الخالق.",
 "創傷": "جُرْح, جِرَاحَة (كَلَمَ، شَقَّ اللَحْم وأسَالَ الدَمّ؛ صَادَ أو اكْتَسَبَ) / جَرَحَ (كَلَمَ، شَقَّ اللَحْم وأسَالَ الدَمّ؛ صَادَ أو اكْتَسَبَ)\nمثال: ذلك سيهيج الجرح.",
 "創傷学": "جراحة الحوادث, طب الرضوح (فرع الطب الذي يتعامل مع الإصلاح الجراحي للإصابات والجروح الناجمة عن الحوادث)",
 "創出": "خِلْقَة, خَلْق / اِبْتِكَار, خَلْق / خَلْق (أَنْشَأَ، أَوْجَدَ)\nمثال: زيري سيء الخلق.",
 "創刊": "إِنْشاء, إِشَادَة (مصدر للفعل \"أَنْشَأَ\") / أَسَاس, قَاعِدَة (مبدأ عام تعتمد عليه طائفة من الظواهر أو القضايا؛ مُرتكز البناء وقاعدته) / مُؤَسَّسَة / أَسَاس (مبدأ عام تعتمد عليه طائفة من الظواهر أو القضايا؛ مُرتكز البناء وقاعدته)\nمثال: إنشاء موقع إلكتروني بدون أي تكلفة؟",
 "創口": "بضع, شق جراحي (قطع أنسجة الجسم أو أعضائه (خاصة بواسطة جراح كجزء من عملية))",
 "創唱": "قَضِيَّة (الأمر أو الشيء المُعَقَّد؛ في : ما يقضي فيه القاضي)",
 "創始": "خِلْقَة, خَلْق / اِبْتِكَار, خَلْق / خَلْق (أَنْشَأَ، أَوْجَدَ)\nمثال: زيري سيء الخلق.",
 "創始者": "العقل المدبر, مُبْتَكِر (شخص يبتكر أو ينشئ أشياء جديدة)",
 "創始者効果": "تَأْثِير المُؤَسِّس, تَأْثِير المُؤَسَّسَة",
 "創建": "تَأْسِيس / مُؤَسَّسَة",
 "創建者": "مُؤَسِّس, مُؤَسِّسَة",
 "創意": "أَصَالَة, ابْتِكَار (صفة كون الشيء جديداً وأصلياً (غير مشتق من شيء آخر)) / أصالة (القدرة على التفكير والتصرف بشكل مستقل)",
 "創意工夫": "براعة, ذكاء (خاصية كون الشخص بارعاً) / إبداع, عبقرية (قوة الخيال الإبداعي)\nمثال: حبكة ذات براعة كبيرة",
 "創成": "خِلْقَة, خَلْق / اِبْتِكَار, خَلْق / خَلْق (أَنْشَأَ، أَوْجَدَ)\nمثال: زيري سيء الخلق.",
 "創成期": "بداية, حداثة (فترة مبكرة من التطور)\nمثال: خلال حداثة المشروع",
 "創案": "حَبِلَ ((حَبَلَه): شَدّه بالحبْل؛ (حَبَلَه) الصَّيْدَ: نَصَب لَهُ الحِبَالةَ وصاده بهَا. وَيُقَال: حَبَلَت فُلَانَةُ فلَانًا: أوقعَتْه فِي شِباك حُبّها وسحَرته) / خَرَجَ بِ (اِنْتَقَلَ إلى خارج المكان)\nمثال: حبل الكذب قصير.",
 "創案者": "العقل المدبر, مُبْتَكِر (شخص يبتكر أو ينشئ أشياء جديدة)",
 "創業": "تَأْسِيس / مُؤَسَّسَة",
 "創業地": "مَكَان الْمِيلَاد, مَسْقَط الرَّأْس (مَوْضِع؛ المنزلة والشأن، يقال أيضا مكانة)\nمثال: هذا المكان مقدس",
 "創業者": "مُؤَسِّس, مُؤَسِّسَة",
 "創生": "خِلْقَة, خَلْق / اِبْتِكَار, خَلْق / خَلْق (أَنْشَأَ، أَوْجَدَ)\nمثال: زيري سيء الخلق.",
 "創生期": "بداية, حداثة (فترة مبكرة من التطور)\nمثال: خلال حداثة المشروع",
 "創痍": "جُرْح, جِرَاحَة (كَلَمَ، شَقَّ اللَحْم وأسَالَ الدَمّ؛ صَادَ أو اكْتَسَبَ) / جَرَحَ (كَلَمَ، شَقَّ اللَحْم وأسَالَ الدَمّ؛ صَادَ أو اكْتَسَبَ)\nمثال: ذلك سيهيج الجرح. / عُطْل, ضَرَر (أوقف أو جعل شيء غير فعال لفترة معينة؛ إيقاف شيء عن العمل أو تركه بدون استخدام أو اهتمام)\nمثال: ذهب سامي في عطلة.",
 "創痕": "نَدْبَة, نَدْب",
 "創発": "انبثاق",
 "創発的": "بَارِز, نَاشِئ (يظهر إلى الوجود؛ في طَوْر التكوُّن) / صَاعِد, نَاشِئ (يَبْلُغُ مَرْحَلَةَ النُّضْج)",
 "創立": "تَأْسِيس / مُؤَسَّسَة",
 "創立者": "مُؤَسِّس, مُؤَسِّسَة",
 "創製": "اِخْتِرَاع",
 "創見": "أَصَالَة, ابْتِكَار (صفة كون الشيء جديداً وأصلياً (غير مشتق من شيء آخر)) / أصالة (القدرة على التفكير والتصرف بشكل مستقل)",
 "創設": "تَأْسِيس / مُؤَسَّسَة",
 "創設者": "مُؤَسِّس, مُؤَسِّسَة",
 "創造": "خِلْقَة, خَلْق / اِبْتِكَار, خَلْق / خَلْق (أَنْشَأَ، أَوْجَدَ)\nمثال: زيري سيء الخلق.",
 "創造主": "خَالِق (الخالق : اسم من أسماء الله الحسنى ، ومعناه : الذي يُخرج من العدم إلى الوجود ، ويصنِّف المُبدَعات…؛ خَالِقُ الْكَوْنِ : مُنْشِؤُهُ ، مُكَوِّنُهُ ، اللهُ سُبْحَانَهُ) / مُبْدِع\nمثال: القرآن منزل من الخالق.",
 "創造力": "إِبْدَاع (ابْتِكَار؛ إيجاد الشيء من لا شيء)\nمثال: يحتاج اكتساب اللغة إلى الإبداع.",
 "創造性": "إِبْدَاع (ابْتِكَار؛ إيجاد الشيء من لا شيء)\nمثال: يحتاج اكتساب اللغة إلى الإبداع.",
 "創造物": "مَخْلُوق, كَائِن",
 "創造的": "إِبْداعِيّ, خَلَّاق",
 "創造神": "الصانع, ديميورج (إله تابع، وفي بعض الفلسفات هو خالق الكون)",
 "創造科学": "علم الخلق (محاولة لتقديم دعم علمي لحقيقة رواية الخلق الواردة في سفر التكوين)",
 "創造者": "خَالِق (الخالق : اسم من أسماء الله الحسنى ، ومعناه : الذي يُخرج من العدم إلى الوجود ، ويصنِّف المُبدَعات…؛ خَالِقُ الْكَوْنِ : مُنْشِؤُهُ ، مُكَوِّنُهُ ، اللهُ سُبْحَانَهُ) / مُبْدِع\nمثال: القرآن منزل من الخالق.",
 "創造説": "خلقية (الإيمان الحرفي برواية الخلق الواردة في سفر التكوين)\nمثال: تنكر الخلقية نظرية تطور الأنواع",
 "創造論": "خلقية (الإيمان الحرفي برواية الخلق الواردة في سفر التكوين)\nمثال: تنكر الخلقية نظرية تطور الأنواع",
 "剽": "تَهْدِيد",
 "剽げる": "دعابة, مزاح (نشاط يتميز بالمرح والفكاهة) / طُرْفَة, مَزْحَة (حكاية فكاهية أو ملاحظة تهدف إلى إثارة الضحك)\nمثال: روى نكتة مضحكة جداً",
 "剽悍": "عَاصِف, مُضْطَرِب (شَدِيد الهَيَجَان والاضْطِرَاب) / شَرِس, ضَارٍ (عَدِيمُ الرَّحْمَةِ فِي المُنَافَسَة) / جَامِح, حَادّ (يَتَّسِمُ بِشِدَّةٍ مُتَطَرِّفَةٍ فِي المَشَاعِرِ أَوِ القَنَاعَات؛ يَمِيلُ إِلَى رَدِّ الفِعْلِ العَنِيف) / شَرِس, ضَارٍ (يَتَّسِمُ بِطَاقَةٍ بَالِغَةِ العُنْفِ وَالشِّدَّة)",
 "剽盗": "قاطِعُ طَرِيق, قُطّاعُ ٱلطُّرُق",
 "剽窃": "اِنْتِحال",
 "剽軽": "سَاخِر / طَرِيف",
 "剽軽る": "دعابة, مزاح (نشاط يتميز بالمرح والفكاهة) / طُرْفَة, مَزْحَة (حكاية فكاهية أو ملاحظة تهدف إلى إثارة الضحك)\nمثال: روى نكتة مضحكة جداً",
 "剽軽者": "جُوكَر",
 "剿滅": "إِفْنَاء, تَدْمِير / إِفْنَاء",
 "劃時代的": "تَارِيخِيّ, حِقْبِيّ (بالغ الأهمّيّة خاصّةً في إحداث أو تمييز بداية حقبة أو عصر جديد)",
 "劃然": "شَفَّاف / وَاضِح",
 "劇": "دْرَامَا, مَسْرَحِيَّة",
 "劇作家": "كَاتِب مَسْرَحِيّ (كَتَبَ رِسَالَة أو مَكْتُوْب لأحد وهذا الآخر يكتب له؛ راسل؛ كَتَبَ عقدا مع أحد؛ عاقد)\nمثال: لست بذاك الكاتب.",
 "劇化": "تجسيد درامي, تمثيل مسرحي (تمثيل درامي) / درجمة, معالجة درامية (التحويل إلى شكل درامي (مسرحي أو تمثيلي))\nمثال: كانت المسرحية معالجة درامية لقصة قصيرة",
 "劇団": "فرقة, فرقة مسرحية (منظمة من المؤدين والموظفين المرتبطين بهم (خاصة المسرحية))\nمثال: أقامت الفرقة المتجولة كلها في نفس الفندق",
 "劇場": "دار عرض, مسرح (مبنى يمكن فيه تقديم العروض المسرحية أو عروض الصور المتحركة) / فنون مسرحية, مسرح (فن كتابة وإنتاج المسرحيات) / مسرح العمليات, ميدان (منطقة تجري فيها عمليات عسكرية نشطة)\nمثال: كان المسرح ممتلئاً",
 "劇場版": "فِلْم (شريط من السِّلِيلُوز تعلوه قشرة من الجلاتين ومن برومور الفِضَّة يستعمل للتصوير الفوتوغرافي والسينمائي؛ قصة سينمائية، نتاج سينمائي: «فلم تاريخي») / شَرِيط / فِيلْم سِينَمَائِيّ / تَصْوِير مُتَحَرِّك\nمثال: استمر الفلم ساعتين.",
 "劇壇": "مَرْحَلَة / مُنَصَّة, مَسْرَح",
 "劇戦": "عَنِيف المُنَافَسَة (يَتَطَلَّب جُهْدًا كَبِيرًا)",
 "劇烈": "عُنْف, عَنْف / عُنْف",
 "劇界": "مَرْحَلَة / مُنَصَّة, مَسْرَح",
 "劇症": "خَاطِف, صَاعِق (مفاجئ وشديد في آن واحد)",
 "劇的": "درامي, مثير (مناسب لـ أو من خصائص الدراما) / دْرَامَاتِيكِيّ, مُثِير (مُذهل في المظهر أو مُشوّق في الأثر) / درامي (تستخدم لمغنٍ أو صوت غنائي يتميز بالقوة والتعبير وأسلوب مسرحي) / درامي, مسرحي (متعلق بـ أو مميز للدراما)\nمثال: دخول درامي بعباءة ملوحة / الْأُقْصَى, الْأَبْعَد / شَدِيد / غَيْر اِعْتِيَادِيّ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به) / خَطِير / مُتَطَرِّف / أَخِير\nمثال: أنا غير متفاجئ.",
 "劇道": "دْرَامَا, مَسْرَحِيَّة",
 "劈": "اِنْكَسَرَ (فعل مطاوعة لكَسَرَ، قام أحدهم بكَسْره أو قام هو بكَسْر نفسه؛ التاجر: خَسِرَ المال ونَقَصَ عنده المال، أفْلَسَ) / كَسَرَ / اِسْتِرَاحَة (مبنى خارج المدن يتوقف فيه المسافرون للراحة والتَزَوُّد يُجمع على اِسْتِرَاحَات)\nمثال: عليك أخذ استراحة.",
 "劈く": "اِنْكَسَرَ (فعل مطاوعة لكَسَرَ، قام أحدهم بكَسْره أو قام هو بكَسْر نفسه؛ التاجر: خَسِرَ المال ونَقَصَ عنده المال، أفْلَسَ) / كَسَرَ / اِسْتِرَاحَة (مبنى خارج المدن يتوقف فيه المسافرون للراحة والتَزَوُّد يُجمع على اِسْتِرَاحَات)\nمثال: عليك أخذ استراحة.",
 "劈開": "شطر, فلق (عملية الفلق أو الشق) / شق الصدر, فلق الصدر (الخط المتشكل من أخدود بين جزأين (خاصة الفاصل بين ثديي المرأة)) / تفلج, تقطع ((علم الأجنة) الانقسام المتكرر للبويضة المخصبة) / انشطار, انقسام (كسر رابطة كيميائية في جزيء مما يؤدي إلى جزيئات أصغر)",
 "劈頭": "بِدَايَة (في بِدَايَة الأمْرِ كانَ مُهَذَّباً : فِي أوّلِهِ؛ البِدَايَة والنِّهاية: المبتدأ والمنتهى)\nمثال: هذه بداية جيدة.",
 "劈頭第一": "أساساً, في المقام الأول (ذو أهمية أولية) / أصلاً, في المقام الأول (قبل الآن)\nمثال: هذه مسألة اقتصادية في المقام الأول",
 "劍": "سَيْف, حُسَام (مصدر للفعل سَافَ؛ سِلاح ذو حَدّ واحد طويل يعتبر من الأسْلِحَة البيضاء لأنها مصنوعة من حَدِيد أبيض حاد. كان أهم أنواع الأسلحة قبل اخْتِرَاع الأسلحة النَارِيَّة) / سَيَّافٌ\nمثال: القلم أقوى من السيف. / حَرْبَة, سُونْكِيّ (آلة للحَرْب تكون قصيرة مُحَدَّدة الرَأس تستخدم للطَعْن. غالبا ما تُرَكَّب على غيرها مثل الرُمْح أو البُنْدُقِيَّة. الجمع حِرَاب وحَرْبَات؛ رأس حَرْبَة: تعبير مجازيّ يقصد به شيء يستخدم لتهديد العَدُو) / مبارزة, مهارة استخدام السيف (المهارة في المبارزة) / ضربة لاذعة (ضربة حادة مؤلمة) / إبرة لاسعة (عضو حاد للهجوم أو الدفاع (كما في الدبور أو سمك الراي اللاسع أو العقرب) غالباً ما يكون متصلاً بغدة سم) / ستينغر (نظام صواريخ أرض-جو محمول منخفض الارتفاع يستخدم التوجيه بالأشعة تحت الحمراء وصمام تصادم؛ يطلق من الكتف) / طَعْنَة, كَلِمَة جَارِحَة (ملاحظة قادرة على الجرح معنوياً)\nمثال: الطعنة الأكثر قسوة على الإطلاق",
 "劒": "سَيْف, حُسَام (مصدر للفعل سَافَ؛ سِلاح ذو حَدّ واحد طويل يعتبر من الأسْلِحَة البيضاء لأنها مصنوعة من حَدِيد أبيض حاد. كان أهم أنواع الأسلحة قبل اخْتِرَاع الأسلحة النَارِيَّة) / سَيَّافٌ\nمثال: القلم أقوى من السيف. / حَرْبَة, سُونْكِيّ (آلة للحَرْب تكون قصيرة مُحَدَّدة الرَأس تستخدم للطَعْن. غالبا ما تُرَكَّب على غيرها مثل الرُمْح أو البُنْدُقِيَّة. الجمع حِرَاب وحَرْبَات؛ رأس حَرْبَة: تعبير مجازيّ يقصد به شيء يستخدم لتهديد العَدُو) / مبارزة, مهارة استخدام السيف (المهارة في المبارزة) / ضربة لاذعة (ضربة حادة مؤلمة) / إبرة لاسعة (عضو حاد للهجوم أو الدفاع (كما في الدبور أو سمك الراي اللاسع أو العقرب) غالباً ما يكون متصلاً بغدة سم) / ستينغر (نظام صواريخ أرض-جو محمول منخفض الارتفاع يستخدم التوجيه بالأشعة تحت الحمراء وصمام تصادم؛ يطلق من الكتف) / طَعْنَة, كَلِمَة جَارِحَة (ملاحظة قادرة على الجرح معنوياً)\nمثال: الطعنة الأكثر قسوة على الإطلاق",
 "劓": "قص, قطع (عملية تقصير شيء ما بقطع أطرافه) / استئصال, بتر (عملية قطع شيء ما)\nمثال: أعطاه الحلاق قصة جيدة",
 "力": "قُوَّة (ضد الضُعْف، الشِدَّة والقُدْرَة الجِسْمَانِيَّة؛ ضد الضُعْف، المَقْدِرَة والحَوْل والتَمَكُّن، القدرة المعنوية) / أَجْبَرَ, اِضْطَرَّ (فعل تعدّي من جَبَرَ؛ جعله يَجْبُر، ضد أَكْسَرَ؛ جعله يفعل شيئا رُغْما عنه؛ أَرْغَمَ)\nمثال: توم شعر بالقوة. / قابلية, كفاءة (صفة القدرة (جسديًا أو فكريًا أو قانونيًا)) / إمكانية, قابلية (استعداد يمكن تطويره) / قابلية, قدرة (قابلية الشيء لعلاج أو معالجة معينة)\nمثال: عمل في حدود مقدرته / فعالية, نجاعة (القدرة أو القوة لإنتاج تأثير مرغوب)\nمثال: قلق بشأن سلامة وفعالية اللقاح / جَهْد, جُهْد (بَذَلَ قُصَارَى جُهْدِهِ فِي أَمْرٍ مَا؛ أَتْعَبَ نَفْسَهُ أو غَيْرَهُ بِعَمَلٍ شَاقٍ)\nمثال: لا إنجاز بلا جهد . / قُوَّة (ضد الضُعْف، الشِدَّة والقُدْرَة الجِسْمَانِيَّة؛ ضد الضُعْف، المَقْدِرَة والحَوْل والتَمَكُّن، القدرة المعنوية)\nمثال: توم شعر بالقوة.",
 "力こぶ": "ذَات اَلرَّأْسَيْن / ذَات اَلرَّأْسَيْن اَلْعَضُدِيَّة / حَمَاس / جُهْد (بَذَلَ قُصَارَى جُهْدِهِ فِي أَمْرٍ مَا؛ أَتْعَبَ نَفْسَهُ أو غَيْرَهُ بِعَمَلٍ شَاقٍ)\nمثال: لا إنجاز بلا جهد .",
 "力ずく": "قُوَّة (ضد الضُعْف، الشِدَّة والقُدْرَة الجِسْمَانِيَّة؛ ضد الضُعْف، المَقْدِرَة والحَوْل والتَمَكُّن، القدرة المعنوية) / أَجْبَرَ, اِضْطَرَّ (فعل تعدّي من جَبَرَ؛ جعله يَجْبُر، ضد أَكْسَرَ؛ جعله يفعل شيئا رُغْما عنه؛ أَرْغَمَ)\nمثال: توم شعر بالقوة.",
 "力づく": "قُوَّة (ضد الضُعْف، الشِدَّة والقُدْرَة الجِسْمَانِيَّة؛ ضد الضُعْف، المَقْدِرَة والحَوْل والتَمَكُّن، القدرة المعنوية) / أَجْبَرَ, اِضْطَرَّ (فعل تعدّي من جَبَرَ؛ جعله يَجْبُر، ضد أَكْسَرَ؛ جعله يفعل شيئا رُغْما عنه؛ أَرْغَمَ)\nمثال: توم شعر بالقوة.",
 "力づける": "شَجَّعَ (حفَّز شخصًا أو دعمه لتحقيق هدف أو القيام بعمل؛ بثَّ الحماس أو الثقة في نفس شخص)\nمثال: شجع سامي ليلى لتفعل ذلك.",
 "力ない": "خَائِر القُوَى, ضَعِيف (يفتقر إلى القوة والعزيمة) / ضَعِيف, وَاهِن (يفتقر إلى القوة البدنية أو العضلية أو الحيوية) / خَافِت, وَاهِن (ضعيف في قوته أو حيويته) / سَقِيم, وَاهٍ (يفتقر بشكل مُثير للشفقة إلى القوة أو الفاعلية)",
 "力なげ": "خَائِر القُوَى, ضَعِيف (يفتقر إلى القوة والعزيمة) / ضَعِيف, وَاهِن (يفتقر إلى القوة البدنية أو العضلية أو الحيوية) / خَافِت, وَاهِن (ضعيف في قوته أو حيويته) / سَقِيم, وَاهٍ (يفتقر بشكل مُثير للشفقة إلى القوة أو الفاعلية)",
 "力のモーメント": "عَزْم",
 "力の場": "حقل, حقل القوة (الحيز حول جسم مشع والذي يمكن لتذبذباته الكهرومغناطيسية أن تمارس قوة على جسم مشابه آخر غير ملامس له)",
 "力の能率": "عَزْم",
 "力み": "إجهاد, توتر (مجهود مكثف أو عنيف) / تشويه, لوي الحقائق (فعل تشويه الشيء ليبدو وكأنه يعني شيئاً لم يكن يقصده) / شَاقّ, مُجْهِد (يُرهق إلى أقصى حدّ؛ يختبر قدرات التحمّل) / إجهاد مفرط (إجهاد مفرط؛ بذل جهد كبير لدرجة تسبب الانزعاج أو الإصابة) / تبجح, تهديد فارغ (تظاهر بالشجاعة بغطرسة)",
 "力む": "سُلَالَة / تبختر, خيلاء (مشية فخورة ومتيبسة ومتغطرسة) / شِيك جِدًّا, فَخْم ((عامّيّة بريطانيّة) أَنِيق لِلغَايَة) / عامل متجول أسترالي (عامل أسترالي متجول يحمل ممتلكاته الشخصية في صرة أثناء سفره بحثاً عن عمل)",
 "力をつける": "شَجَّعَ (حفَّز شخصًا أو دعمه لتحقيق هدف أو القيام بعمل؛ بثَّ الحماس أو الثقة في نفس شخص)\nمثال: شجع سامي ليلى لتفعل ذلك.",
 "力を付ける": "شَجَّعَ (حفَّز شخصًا أو دعمه لتحقيق هدف أو القيام بعمل؛ بثَّ الحماس أو الثقة في نفس شخص)\nمثال: شجع سامي ليلى لتفعل ذلك.",
 "力を入れる": "سُلَالَة",
 "力を合わせる": "تَعَاوَنَ",
 "力を抜く": "اِسْتَرْخَى",
 "力を貸す": "تمريرة حاسمة, مساعدة ((رياضة) فعل تمكين لاعب آخر من القيام بلعبة جيدة) / إعانة, عون (نشاط المساهمة في تلبية حاجة أو تعزيز جهد أو غرض ما)\nمثال: قدم لي مساعدة في الأعمال المنزلية",
 "力不足": "عَدَم كِفَايَة, نَقْص (عدم الإرضاء بسبب عدم الكفاية) / عدم كفاية, قصور (الافتقار إلى كمية أو عدد كافٍ) / عدم كفاءة, قصور (نقص الكفاءة)\nمثال: عدم كفاية إعانات البطالة",
 "力丸": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "力久": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "力仕事": "عمل يدوي (العمل المنجز بالأيدي)",
 "力付ける": "شَجَّعَ (حفَّز شخصًا أو دعمه لتحقيق هدف أو القيام بعمل؛ بثَّ الحماس أو الثقة في نفس شخص)\nمثال: شجع سامي ليلى لتفعل ذلك.",
 "力代": "تَوَسُّط, رَدَاءَة نِسْبِيَّة (العادية نتيجة لكون الشيء متوسطاً وغير متميز) / شَخْص مِنَ الدَّرَجَة الثَّانِيَة, مُتَوَسِّط الْمُسْتَوَى (شخص ذو قدرة أو قيمة من الدرجة الثانية)",
 "力作": "إنجاز فذ, عمل إعجازي (مأثرة بارعة أو عبقرية) / كَدْح / تَعِبَ, كَدَحَ (تعِب:ضدّ استراح؛ التَّعَبُ: شدَّةُ العَنَاءِ ضدُّ الراحَة، تَعب يَتْعَبُ تَعَباً: أَعْيَا)\nمثال: شعر توم بالتعب.",
 "力価": "تيتر, عيار (تركيز محلول كما يحدد بالمعايرة)",
 "力倆": "قُدْرَة, مَقْدِرَة / مَوْهِبَة",
 "力動": "حيوية, ديناميكية (نشاط شخصية حيوية) / حيوية, نشاط (قوة نشطة للجسد أو العقل) / ديناميكية (أي من النظريات أو المذاهب أو الأنظمة الفلسفية المختلفة التي تحاول تفسير ظواهر الكون بدلالة قوة أو طاقة كامنة) / ديناميكا نفسية (فرع علم النفس الاجتماعي الذي يتعامل مع العمليات والعواطف التي تحدد النفسية والدافع) / دِينَامِيكِيَّة نَفْسِيَّة (الترابط بين العمليات والعواطف الواعية وغير الواعية التي تحدد الشخصية والدوافع)",
 "力動感": "حيوية, ديناميكية (نشاط شخصية حيوية) / حيوية, نشاط (قوة نشطة للجسد أو العقل) / ديناميكية (أي من النظريات أو المذاهب أو الأنظمة الفلسفية المختلفة التي تحاول تفسير ظواهر الكون بدلالة قوة أو طاقة كامنة)",
 "力動的": "حَرَكِيّ ((يستخدم للأفعال والصفات المشتقة) يعبر عن فعل بدلاً من حالة كينونة) / حركي, ديناميكي (يتميز بالعمل أو القوة أو قوة الشخصية) / ديناميكي (من أو يتعلق بالديناميكا) / دينامية, قوة دافعة (حافز فعال أو قوة محركة)\nمثال: سوق ديناميكي",
 "力場": "حقل, حقل القوة (الحيز حول جسم مشع والذي يمكن لتذبذباته الكهرومغناطيسية أن تمارس قوة على جسم مشابه آخر غير ملامس له)",
 "力士": "مصارع سومو (مصارع يشارك في السومو (شكل ياباني من المصارعة))\nمثال: مصارعو السومو رجال ضخام وثقيلو الوزن",
 "力学": "مِيكَانِيكَا, مِيكَانِيكِيَّة",
 "力学的": "مِيكَانِيكِيّ",
 "力学的エネルギー": "طاقة ميكانيكية (القُدْرَة والشِدَّة؛ هي مقدار ما يمكن للإنسان أن يفعله بمشقة، كأن قدرته محددة بطَوْق)\nمثال: طلب بطاقة اعتماد.",
 "力学系": "نظام ديناميكي ((الفيزياء) فضاء طور جنباً إلى جنب مع تحول لذلك الفضاء)",
 "力尽きる": "مَاتَ (للحَيّ: فقد الحَيَاة. مصدره مَوتَا ومِيتَة؛ للأرض: ليس فيها شيء حَيّ من النبات أو الحيوان أو الإنسان. مصدره مَوَات) / تُوُفِّيَ / زَهْر اَلطَّاوِلَة, زَهْر اَلنَّرْد ((زَهَرَ) الوجهُ والسراجُ والقمرُ يَزْهُرُ زَهْرًا، وزُهُوراً: تلألأ وأشْرق؛ (زَهَرَ) الشيءُ: صَفا لونُه)\nمثال: إعتقدت أنه مات.",
 "力尽く": "قُوَّة (ضد الضُعْف، الشِدَّة والقُدْرَة الجِسْمَانِيَّة؛ ضد الضُعْف، المَقْدِرَة والحَوْل والتَمَكُّن، القدرة المعنوية) / أَجْبَرَ, اِضْطَرَّ (فعل تعدّي من جَبَرَ؛ جعله يَجْبُر، ضد أَكْسَرَ؛ جعله يفعل شيئا رُغْما عنه؛ أَرْغَمَ)\nمثال: توم شعر بالقوة.",
 "力弱い": "ضَعِيف",
 "力強い": "قَوِيّ (اسم من أسماء الله الحسنى؛ الشَدِيْد ذو الحَوْل)\nمثال: كانت صدمة قوية. / مُطَمْئِن (يعيد الثقة ويخفف القلق)\nمثال: ملاحظة مطمئنة جداً",
 "力役": "عمل قسري (فِعْل، صُنْع؛ وسيلة للكسب، مِهْنَة، حِرْفَة)\nمثال: المهم هو العمل.",
 "力感": "قُوَّة, قُدْرَة (ضد الضُعْف، الشِدَّة والقُدْرَة الجِسْمَانِيَّة؛ ضد الضُعْف، المَقْدِرَة والحَوْل والتَمَكُّن، القدرة المعنوية) / قُوَّة (ضد الضُعْف، الشِدَّة والقُدْرَة الجِسْمَانِيَّة؛ ضد الضُعْف، المَقْدِرَة والحَوْل والتَمَكُّن، القدرة المعنوية) / قُوَّة, طَاقَة (ضد الضُعْف، الشِدَّة والقُدْرَة الجِسْمَانِيَّة؛ ضد الضُعْف، المَقْدِرَة والحَوْل والتَمَكُّن، القدرة المعنوية) / طَاقَة كَهْرَبَائِيَّة, طَاقَة (القُدْرَة والشِدَّة؛ هي مقدار ما يمكن للإنسان أن يفعله بمشقة، كأن قدرته محددة بطَوْق)\nمثال: توم شعر بالقوة.",
 "力抜け": "تثبيط (فعل التثبيط أو الإحباط) / إِحْبَاط, تَثْبِيط (التعبير عن المعارضة وعدم الاستحسان) / إحباط, تثبيط (شعور اليأس في مواجهة العقبات)\nمثال: تثبيط السرقة الصغيرة",
 "力拳": "قبضة (يد مضمومة الأصابع في راحة اليد (كما في حالة الضرب))",
 "力持ち": "كمال أجسام, مفتول العضلات (رجل يقوم بتمارين خاصة لتطوير عضلات قوية) / بلطجي, حارس مفتول العضلات (متنمر ذكر يُستخدم كبلطجي أو حارس شخصي)",
 "力本説": "حيوية, ديناميكية (نشاط شخصية حيوية) / حيوية, نشاط (قوة نشطة للجسد أو العقل) / ديناميكية (أي من النظريات أو المذاهب أو الأنظمة الفلسفية المختلفة التي تحاول تفسير ظواهر الكون بدلالة قوة أو طاقة كامنة)",
 "力業": "عمل يدوي (العمل المنجز بالأيدي)",
 "力武": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "力添え": "مُسَاعَدَة, مَعُونَة / مُسَاعِد, مُسَاعِدَة (مُعَاوِن، مُسَانِد، من يقوم بالمُسَاعَدَة؛ بمعنى مُفِيد، يقال هذا عامل مساعد وهذه مادة مساعدة) / سَاعَدَ, عَاوَنَ (عَاوَنَ، أَعَانَ) / مُسَاعَدَة, النَّجْدَة\nمثال: علي مساعدة ماري.",
 "力点": "تَرْكِيز",
 "力無い": "خَائِر القُوَى, ضَعِيف (يفتقر إلى القوة والعزيمة) / ضَعِيف, وَاهِن (يفتقر إلى القوة البدنية أو العضلية أو الحيوية) / خَافِت, وَاهِن (ضعيف في قوته أو حيويته) / سَقِيم, وَاهٍ (يفتقر بشكل مُثير للشفقة إلى القوة أو الفاعلية)",
 "力無げ": "خَائِر القُوَى, ضَعِيف (يفتقر إلى القوة والعزيمة) / ضَعِيف, وَاهِن (يفتقر إلى القوة البدنية أو العضلية أو الحيوية) / خَافِت, وَاهِن (ضعيف في قوته أو حيويته) / سَقِيم, وَاهٍ (يفتقر بشكل مُثير للشفقة إلى القوة أو الفاعلية)",
 "力瘤": "ذَات اَلرَّأْسَيْن / ذَات اَلرَّأْسَيْن اَلْعَضُدِيَّة / حَمَاس / جُهْد (بَذَلَ قُصَارَى جُهْدِهِ فِي أَمْرٍ مَا؛ أَتْعَبَ نَفْسَهُ أو غَيْرَهُ بِعَمَلٍ شَاقٍ)\nمثال: لا إنجاز بلا جهد .",
 "力石": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "力積": "دفعة, قوة دافعة مفاجئة (فعل تطبيق قوة فجأة) / دفعة, زخم (قوة دافعة) / سيال عصبي, نبضة عصبية (التفريغ الكهربائي الذي ينتقل عبر الليف العصبي) / نبض, نبضة ((في الإلكترونيات) موجة عابرة حادة في الحالة الكهربائية الطبيعية (أو سلسلة من هذه العوابر))\nمثال: الدفعة المفاجئة أسقطته أرضاً",
 "力線": "خط القوة, خط المجال (خط وهمي في مجال القوة؛ اتجاه الخط في أي نقطة هو اتجاه القوة عند تلك النقطة)",
 "力編": "إنجاز فذ, عمل إعجازي (مأثرة بارعة أو عبقرية)",
 "力織機": "نول آلي (نول يعمل ميكانيكياً)",
 "力落し": "تثبيط (فعل التثبيط أو الإحباط) / إِحْبَاط, تَثْبِيط (التعبير عن المعارضة وعدم الاستحسان) / إحباط, تثبيط (شعور اليأس في مواجهة العقبات)\nمثال: تثبيط السرقة الصغيرة",
 "力落とし": "تثبيط (فعل التثبيط أو الإحباط) / إِحْبَاط, تَثْبِيط (التعبير عن المعارضة وعدم الاستحسان) / إحباط, تثبيط (شعور اليأس في مواجهة العقبات)\nمثال: تثبيط السرقة الصغيرة",
 "力行": "جهد, عناء (استخدام الطاقة البدنية أو العقلية؛ العمل الشاق)\nمثال: حصل على درجة امتياز لجهده",
 "力説": "تأكيد, تشديد (فعل إعطاء أهمية خاصة أو دلالة لشيء ما)",
 "力走": "ركض سريع, عدو سريع (جري سريع)",
 "力車": "رِيكْشَا",
 "力量": "قُدْرَة, مَقْدِرَة / مَوْهِبَة",
 "力関係": "توازن القوى",
 "力頼み": "اِسْتِنَاد / إِدْمَان",
 "功": "خِدْمَة / إِنْجَاز / جَدَارَة / إِنْجَاز",
 "功し": "إِنْجَاز / شُجَاع, جَرِيء (الثعبان)\nمثال: إنك شجاع للغاية. / مُجْتَهِد (مشتق من إجتهد)\nمثال: لعل المجتهد ينجح. / فَاضِل, جَدِير",
 "功り": "خِدْمَة",
 "功を奏す": "نَجَحَ",
 "功を奏する": "نَجَحَ",
 "功利": "خدمة عامة, مرفق عام (الخدمة (طاقة كهربائية أو مياه أو نقل) المقدمة من قبل مرفق عام) / خدمة عامة, مرفق خدمي (منشأة مكونة من قطعة أو أكثر من المعدات المتصلة بهيكل أو جزء منه ومصممة لتقديم خدمة مثل الحرارة أو الكهرباء أو الماء أو التخلص من مياه الصرف الصحي) / جَدْوَى, فَائِدَة (صفة كون الشيء ذا فائدة عملية) / أداة مساعدة, برنامج خدمي ((علم الحاسوب) برنامج مصمم للدعم العام لعمليات الحاسوب)\nمثال: تكلفة المرافق العامة لا تنخفض أبداً",
 "功利主義": "نَفْعِيَّة",
 "功利主義者": "عَمَلِيّ, نَفْعِيّ (لَهُ وَظِيفَة نَفْعِيَّة عَمَلِيَّة) / عَمَلَانِيّ, نَفْعِيّ (ذُو مَنْفَعَةٍ عَمَلِيَّةٍ غَالِبًا عَلَى حِسَابِ القِيَمِ الجَمَالِيَّة) / نفعي (شخص يؤمن بأن قيمة الشيء تعتمد على منفعته)",
 "功利的": "عَمَلِيّ, نَفْعِيّ (لَهُ وَظِيفَة نَفْعِيَّة عَمَلِيَّة) / عَمَلَانِيّ, نَفْعِيّ (ذُو مَنْفَعَةٍ عَمَلِيَّةٍ غَالِبًا عَلَى حِسَابِ القِيَمِ الجَمَالِيَّة) / نفعي (شخص يؤمن بأن قيمة الشيء تعتمد على منفعته)",
 "功労": "خدمات (أداء واجبات أو توفير مساحة ومعدات مفيدة للآخرين)\nمثال: حاول العمدة الحفاظ على خدمات المدينة",
 "功名": "شُهْرَة",
 "功名心": "مَطْمَح",
 "功夫": "كُونْج فُو",
 "功徳": "جَدَارَة / غريس",
 "功徳蔵": "بيت الكنز (مستودع للكنوز)",
 "功業": "مَأْثُرَة / اِسْتَغَلَّ",
 "功用": "اِسْتِعْمَال, اِسْتِخْدَام (اِسْتِعْمَال) / اِسْتَعْمَلَ, اِسْتَخْدَمَ (عَمِلَ بالشيء؛ اِتَّخَذَ الشخصَ عَامِلًا عنده)\nمثال: أيمكنني استعمال هاتفك؟",
 "功績": "إِنْجَاز",
 "功者": "براعة, ذكاء (خاصية كون الشخص بارعاً) / ذكاء, شطارة (الذكاء الذي يظهر في سرعة البديهة والفطنة) / إبداع, عبقرية (قوة الخيال الإبداعي)\nمثال: حبكة ذات براعة كبيرة",
 "功能": "تَأْثِير, أَثَر",
 "加": "إضَافَة / مُضَاف / جَمْع (ضَمَّ، لَمَّ، حَشَدَ؛ في : أَضَافَ أعدادا إلى غيرها)\nمثال: جمع خيل هو خيول. / كَنَدَا, كَنَدَة (دولة في قارة أمريكا الشمالية؛ عاصمتها أُوتَاوَا)\nمثال: هذا خطاب من كندا.",
 "加うるに": "إِلَّا, بِٱسْتِثْنَاء (حرف استثناء؛ في : للسؤال المنفي، مرادف لبَلَى في الفصحى) / عِلَاوَة عَلَى ذٰلِكَ\nمثال: لا أعرف إلا هذا.",
 "加えて": "بالإضافة إلى ذلك, علاوة على ذلك (بالإضافة؛ علاوة على ذلك)\nمثال: يعمل بالإضافة إلى ذلك كمدير تنفيذي",
 "加える": "جَمَعَ (ضَمَّ، لَمَّ، حَشَدَ؛ في : أَضَافَ أعدادا إلى غيرها) / أَضَافَ\nمثال: جمع خيل هو خيول. / زَاد (زَادَ يَزِيدُ زَيْدًا، وزِيادَةً: نما وكَثُرَ؛ زَادَ الشيءَ: جعله يزيد) / زِيَادَة / اِرْتِفَاع, اِزْدِيَاد\nمثال: زاد السياح عددا. / تضمن / اِتِّفَاقِيَّة",
 "加え算": "إضَافَة / مُضَاف / جَمْع (ضَمَّ، لَمَّ، حَشَدَ؛ في : أَضَافَ أعدادا إلى غيرها)\nمثال: جمع خيل هو خيول.",
 "加わる": "شَارَكَ, سَاهَمَ / زَاد (زَادَ يَزِيدُ زَيْدًا، وزِيادَةً: نما وكَثُرَ؛ زَادَ الشيءَ: جعله يزيد) / زِيَادَة / اِرْتِفَاع, اِزْدِيَاد\nمثال: زاد السياح عددا.",
 "加之": "أَيْضًا, كَذٰلِكَ",
 "加入": "اتصال, ضم (عملية جعل شيئين متلامسين (خاصة للتواصل))\nمثال: تشابك الأيدي حول الطاولة",
 "加入者": "جهة منتسبة, فرع (منظمة فرعية أو ثانوية تابعة لمنظمة أخرى) / عُضْو مُنْتَسِب, مُنْتَسِب (زميل مرؤوس أو فرعي؛ شخص ينتسب لآخر أو لمنظمة)\nمثال: الجهات التابعة للشبكة",
 "加入者回線": "خط هاتف, خط هاتفي (وصلة هاتفية)",
 "加入者線交換機": "خَمْسُونَ (يَدُلُّ عَلَى العَدَد 50) / لتر (وحدة مترية للسعة، تساوي 1,000 سنتيمتر مكعب) / لامبرت (وحدة للإضاءة في نظام السنتيمتر-غرام-ثانية تساوي سطوع سطح منتشر تماماً ينبعث منه أو يعكس لومن واحد لكل سنتيمتر مربع) / خَمْسُون (العدد الأصلي الذي هو حاصل ضرب عشرة في خمسة)",
 "加入金": "تذكرة الدخول, رسم الدخول (الرسم المفروض للدخول)",
 "加入電信": "تِلِكْس",
 "加判人": "مُوقّع (موضع الوُقُوع؛ الموضع الذي حَدَثَ أو يحدث فيه حادث)\nمثال: هنا موقع الحادث.",
 "加勢": "مُسَاعَدَة, إِمْدَاد",
 "加号": "عَلَامَة زَائِد, عَلَامَةُ جَمْع (سِمَةٌ أو أمارة أو شِعَار تُعرف به الأشياء؛ رَمْز)\nمثال: تحصلت على علامة أ.",
 "加味": "بَهَار, تَابِل / إضَافَة / مُضَاف / جَمْع (ضَمَّ، لَمَّ، حَشَدَ؛ في : أَضَافَ أعدادا إلى غيرها)\nمثال: جمع خيل هو خيول.",
 "加味逍遙散": "اَلطِّبّ اَلصِّينِيّ",
 "加味逍遥散": "اَلطِّبّ اَلصِّينِيّ",
 "加圧水型原子炉": "مفاعل الماء المضغوط (مفاعل نووي يستخدم الماء كمبرد ومهدئ؛ يمكن للبخار المنتج تشغيل توربين بخاري)",
 "加圧水炉": "مفاعل الماء المضغوط (مفاعل نووي يستخدم الماء كمبرد ومهدئ؛ يمكن للبخار المنتج تشغيل توربين بخاري)",
 "加塩": "تمليح (فعل إضافة الملح إلى الطعام)",
 "加増": "زَاد (زَادَ يَزِيدُ زَيْدًا، وزِيادَةً: نما وكَثُرَ؛ زَادَ الشيءَ: جعله يزيد) / زِيَادَة / اِرْتِفَاع, اِزْدِيَاد\nمثال: زاد السياح عددا.",
