 "堂": "مَعْبَد / هَيْكَل / صَدْغ / ذِرَاع / قَاعَة, صَالَة / مَهْجَع / سَرِيَّة / شَرِكَة / صالون, غرفة جلوس (غرفة في منزل خاص أو منشأة حيث يمكن للناس الجلوس والتحدث والاسترخاء)",
 "堂々": "عَظِيم, رَائِع (خلاف الصَغِيْر، الكَبِيْر؛ نقيض الحَقِير)\nمثال: الصين بلد عظيم. / أَشْقَر (هو لون الشُقْرَة، وأصله اللون الأحمر المائل إلى الصُفرة ثم أصبح يطلق على ما كان لونه أصفر أيضا؛ صفة ما كان لونه الشُقرة) / حَقَّانِيّ, عادِل / مَأْذُون, مُبَاح\nمثال: أنا لديها شعر بني كستنائي, ولكن ماجدالينا لديها شعر أشقر. / بعظمة, بفخامة (بأسلوب فخم وعظيم)\nمثال: بدا القصر كبيراً بعظمة مقارنة بمعايير اليوم / مِن اَلْعَدْل, بِالْعَدْل (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "堂堂": "عَظِيم, رَائِع (خلاف الصَغِيْر، الكَبِيْر؛ نقيض الحَقِير)\nمثال: الصين بلد عظيم. / أَشْقَر (هو لون الشُقْرَة، وأصله اللون الأحمر المائل إلى الصُفرة ثم أصبح يطلق على ما كان لونه أصفر أيضا؛ صفة ما كان لونه الشُقرة) / حَقَّانِيّ, عادِل / مَأْذُون, مُبَاح\nمثال: أنا لديها شعر بني كستنائي, ولكن ماجدالينا لديها شعر أشقر. / بعظمة, بفخامة (بأسلوب فخم وعظيم)\nمثال: بدا القصر كبيراً بعظمة مقارنة بمعايير اليوم / مِن اَلْعَدْل, بِالْعَدْل (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "堂塔": "مَعْبَد / هَيْكَل / صَدْغ / ذِرَاع",
 "堂宇": "بِنَاء, مَبْنَى (ضد هَدْم. ؛ المَبْنَى أو البِنَاية) / مَدْرَسَة (الموضع الذي تُدَرَّس فيه العلوم؛ البناء فيه عدة غرف تُدَرَّسُ فيها العلوم وتمنح شهادة رسمية بعد إكمال الدروس)\nمثال: أنا وجدت البناء.",
 "堂鳩": "حمام مستأنس (حمام مستأنس يُربى للرياضة أو الطعام)",
 "堅": "قُوَّة (ضد الضُعْف، الشِدَّة والقُدْرَة الجِسْمَانِيَّة؛ ضد الضُعْف، المَقْدِرَة والحَوْل والتَمَكُّن، القدرة المعنوية)\nمثال: توم شعر بالقوة. / دِرْع (غطاء واقٍ صلب وقاسٍ إلى حد ما لحيوان أو نبات) / تدريع, درع (غطاء واقٍ مصنوع من المعدن ويستخدم في القتال) / مدرعات (وحدة عسكرية تتكون من مركبات قتالية مدرعة)",
 "堅い": "صُلْب (قوي وصلب الملمس، لا ينحني بسهولة؛ متماسك وثابت، غير قابل للتغيير أو الانكسار) / صَعْب / لَا يُدْحَضُ (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: هذا التخت جدا صلب. / بتصلب, بجمود (بطريقة متصلبة) / بشدة, حتى التجمد (لدرجة كبيرة (غالباً مع الخوف أو الملل)) / ثَمِل تَمَامًا, سَكْرَان طَافِح (فِي حَالَة سُكْرٍ شَدِيد) / جَامِد, مُتَصَلِّب (غَيْرُ قَابِلٍ لِلِانْثِنَاءِ أَوْ مُقَاوِمٌ لَهُ)\nمثال: استقرت يداه بتصلب / قَوِيّ (اسم من أسماء الله الحسنى؛ الشَدِيْد ذو الحَوْل) / مَنِيع, مَتِيْن / قَوِيّ, راسِخ (اسم من أسماء الله الحسنى؛ الشَدِيْد ذو الحَوْل) / شَدِيْد, قَوْيّ / شَدِيْد / حَادّ, ثَقِيْل (مَالَ وَانْحَرَفَ عَنِ الطَّرِيقِ؛ تَجَنَّبَ شَيْئًا أَوِ الْاِلْتِزَامَ بِمَسَارٍ مَعَيَّنٍ) / بِقُوَّة\nمثال: كانت صدمة قوية. / أَمِين, سَالِم (من يتولى رقابة شيء أو المحافظة عليه؛ مُطْمَئِنّ) / خَزْنَة حَدِيدِيَّة, خَزْنَة\nمثال: هو غبي وغير أمين.",
 "堅さ": "ثَبَات",
 "堅し": "صُلْب (قوي وصلب الملمس، لا ينحني بسهولة؛ متماسك وثابت، غير قابل للتغيير أو الانكسار) / صَعْب / لَا يُدْحَضُ (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: هذا التخت جدا صلب.",
 "堅っ苦しい": "رَسْمِيّ, صُورِيّ (منسوب للسُّلْطَة أو الحُكُومَة أو الدَّوْلَة أو القَانُون؛ مُلَائِم للمَعَايِير) / رَسْمِيّ (منسوب للسُّلْطَة أو الحُكُومَة أو الدَّوْلَة أو القَانُون؛ مُلَائِم للمَعَايِير)\nمثال: لقد انتهى الدرس بشكل رسمي.",
 "堅パン": "بقسماط السفينة, خبز البحارة (بسكويت أو خبز صلب جداً غير مملح؛ كان غذاءً أساسياً في السفن قديماً) / ماهوجني الجبل (نوع من الماهوجني الجبلي)",
 "堅人": "مُرَبَّع (كُلُّ ما يُرَبَّعُ؛ كُلُّ ما له أربعة أركانٍٍ) / مثال: لا توجد مثلثات مربعة.",
 "堅信": "تَأْكِيد / سِرّ المَيْرُون (شَعَرَ بِالسُّرُورِ)\nمثال: السر سيبقى سرا.",
 "堅信礼": "تَأْكِيد / سِرّ المَيْرُون (شَعَرَ بِالسُّرُورِ)\nمثال: السر سيبقى سرا.",
 "堅剛": "جَامِد, مُتَصَلِّب (غَيْرُ قَابِلٍ لِلِانْثِنَاءِ أَوْ مُقَاوِمٌ لَهُ) / صلب الهيكل (يصف منطاداً أو سفينة هوائية تحافظ على شكلها بواسطة إطار أو هيكل صلب غير مرن) / جَامِد, صَارِم (غَيْرُ قَادِرٍ عَلَى التَّكَيُّفِ أَوِ التَّغَيُّرِ لِمُوَاجَهَةِ الظُّرُوفِ) / ثَابِت, جَامِد (مثبّت في مكانه ولا يتحرك)",
 "堅固": "صُلْب (قوي وصلب الملمس، لا ينحني بسهولة؛ متماسك وثابت، غير قابل للتغيير أو الانكسار) / جَامِد\nمثال: هذا التخت جدا صلب.",
 "堅塁": "حِصْن (ما يُتَحَصَّنُ به ويُمْنَع؛ كل مكان محميّ مُحرَز لا يُوصَل إليه؛ عن ما يُتَحصَّن به وإن لم يكن موضعا أو مكانا كالسلاح مثلا)\nمثال: كان هناك حصن على تلك الهضبة في يوم من الأيام.",
 "堅実": "ثابت (اسم فاعل من ثَبَتَ؛ المُسْتَقِرّ الذي لا يتحرك، ضد المُتَحَرِّك)\nمثال: الشاحنة غير ثابتة.",
 "堅州国": "سِجِّين, عَالَم سُفْلِيّ",
 "堅強": "قَوِيّ (اسم من أسماء الله الحسنى؛ الشَدِيْد ذو الحَوْل)\nمثال: كانت صدمة قوية.",
 "堅忍": "مُثَابَرَة",
 "堅振": "تَأْكِيد / سِرّ المَيْرُون (شَعَرَ بِالسُّرُورِ)\nمثال: السر سيبقى سرا.",
 "堅木": "خشب صلب (خشب الأشجار عريضة الأوراق ثنائية الفلقة (بالمقارنة مع خشب الصنوبريات))",
 "堅果": "رَأْس, قَرْعَة (عُضْو مِنَ ٱلْجَسَدِ يَحْوِي الدِّمَاغ والفَم والأَنْف والعَيْنَيْن والأُذُنَيْن؛ أَعْلَى ٱلشَّيْءِ) / مَخْبُول / بَيْضَة (ما تضعه أنثى الحيوان البَيُوض أو الطائر، يخرج منه صغير الطائر بعد فترة؛ قد يقصد به بَيْضَة الدجاج تحديدا لأنه أكثر ما يأكله الإنسان من بيوض الحيوان) / صَمُولَة\nمثال: قطع سامي رأس كلب.",
 "堅気": "نَزِيه, صَادِق",
 "堅洲国": "سِجِّين, عَالَم سُفْلِيّ",
 "堅焼": "مَخْبُوزٌ حَتَّى التَّصَلُّب (خُبِزَ حَتَّى أَصْبَحَ صَلْبًا)",
 "堅焼き": "مَخْبُوزٌ حَتَّى التَّصَلُّب (خُبِزَ حَتَّى أَصْبَحَ صَلْبًا)",
 "堅牢": "صُلْب (قوي وصلب الملمس، لا ينحني بسهولة؛ متماسك وثابت، غير قابل للتغيير أو الانكسار) / جَامِد\nمثال: هذا التخت جدا صلب.",
 "堅物": "مُتَحَفِّظ بِإِفْرَاط, مُتَزَمِّت (مبالِغ في التمسّك باللياقة والتحفّظ)",
 "堅白同異": "سَفْسَطَة, مُغَالَطَة",
 "堅累": "حِصْن (ما يُتَحَصَّنُ به ويُمْنَع؛ كل مكان محميّ مُحرَز لا يُوصَل إليه؛ عن ما يُتَحصَّن به وإن لم يكن موضعا أو مكانا كالسلاح مثلا)\nمثال: كان هناك حصن على تلك الهضبة في يوم من الأيام.",
 "堅結び": "عقدة اليد, عقدة مربعة (عقدة مربعة تستخدم في حبل تقليص الشراع)",
 "堅苦しい": "رَسْمِيّ, صُورِيّ (منسوب للسُّلْطَة أو الحُكُومَة أو الدَّوْلَة أو القَانُون؛ مُلَائِم للمَعَايِير) / رَسْمِيّ (منسوب للسُّلْطَة أو الحُكُومَة أو الدَّوْلَة أو القَانُون؛ مُلَائِم للمَعَايِير)\nمثال: لقد انتهى الدرس بشكل رسمي.",
 "堅調": "بإصرار, بثبات (بتصميم حازم) / رَاسِخ, مَتِين (قويّ وأكيد) / رَاسِخ, مُخْلِص (ثَابِت لَا يَتَزَعْزَع فِي الإِخْلَاص لِصَدِيق أَوْ عَهْد أَوْ قَضِيَّة) / جَامِد, رَاسِخ (مُثَبَّت بِإِحْكَام فِي مَكَانِه)\nمثال: صدقنا ذلك بحزم / قَوِيّ (اسم من أسماء الله الحسنى؛ الشَدِيْد ذو الحَوْل) / مَنِيع, مَتِيْن / قَوِيّ, راسِخ (اسم من أسماء الله الحسنى؛ الشَدِيْد ذو الحَوْل) / شَدِيْد, قَوْيّ / شَدِيْد / حَادّ, ثَقِيْل (مَالَ وَانْحَرَفَ عَنِ الطَّرِيقِ؛ تَجَنَّبَ شَيْئًا أَوِ الْاِلْتِزَامَ بِمَسَارٍ مَعَيَّنٍ) / بِقُوَّة\nمثال: كانت صدمة قوية.",
 "堅陣": "حِصْن (ما يُتَحَصَّنُ به ويُمْنَع؛ كل مكان محميّ مُحرَز لا يُوصَل إليه؛ عن ما يُتَحصَّن به وإن لم يكن موضعا أو مكانا كالسلاح مثلا)\nمثال: كان هناك حصن على تلك الهضبة في يوم من الأيام.",
 "堅頭竜": "باكيسيفالوصور (ديناصور عاشب ثنائي الأرجل يمتلك 10 بوصات من العظم فوق رأسه؛ أكبر ديناصور عظمي الرأس تم العثور عليه)",
 "堆": "مَصْرِف, بَنْك (في الاقتصاد: مؤسسة مالية مُرَخصة، تختص بإتمام الخدمات المالية كتلقي عمليات الإيداع، ومنح القروض، وإدارة الثروات، واستبدال العملات) / ضِفَّة\nمثال: عدن إلى المصرف. / كَوْم",
 "堆石": "ركام جليدي, مورين (تربة وحجارة متراكمة ترسبها الأنهار الجليدية)",
 "堆積": "تجميع, تراكم (عملية التراكم) / تجميع, تشكيلة (أشياء عديدة مجمعة معًا أو تعتبر ككل) / أرباح محتجزة, تراكم الأرباح ((تمويل) الأرباح التي لا تُدفع كتوزيعات أرباح ولكن تضاف إلى القاعدة الرأسمالية للشركة) / تراكم, تكدس (زيادة عن طريق النمو الطبيعي أو الإضافة) / ترسب, ترسيب (ظاهرة تراكم الرواسب أو الحصى)",
 "堆積作用": "ترسب, ترسيب (ظاهرة تراكم الرواسب أو الحصى)",
 "堆積岩": "صَخْر رُسُوبِيّ",
 "堆積物": "رَاسِب",
 "堆肥": "دبال, سماد عضوي (خليط من النباتات المتحللة والروث؛ يستخدم كسماد)",
 "堆肥化": "دبال, سماد عضوي (خليط من النباتات المتحللة والروث؛ يستخدم كسماد)",
 "堕す": "فَاسِق, مُسْتَهْتِر (مُتَحَرِّرٌ مِنَ القُيُودِ الأَخْلَاقِيَّةِ وَالأَعْرَاف) / منحرف (شخص ينحرف سلوكه عما هو مقبول خاصة في السلوك الجنسي)",
 "堕する": "فَاسِق, مُسْتَهْتِر (مُتَحَرِّرٌ مِنَ القُيُودِ الأَخْلَاقِيَّةِ وَالأَعْرَاف) / منحرف (شخص ينحرف سلوكه عما هو مقبول خاصة في السلوك الجنسي)",
 "堕ちる": "رَفَضَ (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟ / وَقَعَ, سَقَطَ (الشيء: سَقَطَ، انحدر من مكان عال؛ الأمر: حَدَثَ، وأكثر ما يقال للأمر العظيم) / سَقَطَ (تَحَرَّكَ من أعلى إلى أسفل بتأثير الجاذبية، وَقَعَ؛ في كلامه: أخْطَأَ، أو قال قولا لا ينبغي أو لا يريد قوله) / سُقُوط, هُوِيّ (يحمل كافة معاني الفعل بصيغة المصدر)\nمثال: توم وقع و أصيب.",
 "堕つ": "وَقَعَ, سَقَطَ (الشيء: سَقَطَ، انحدر من مكان عال؛ الأمر: حَدَثَ، وأكثر ما يقال للأمر العظيم) / سَقَطَ (تَحَرَّكَ من أعلى إلى أسفل بتأثير الجاذبية، وَقَعَ؛ في كلامه: أخْطَأَ، أو قال قولا لا ينبغي أو لا يريد قوله) / سُقُوط, هُوِيّ (يحمل كافة معاني الفعل بصيغة المصدر)\nمثال: توم وقع و أصيب.",
 "堕ろす": "يُجْهِض",
 "堕天使": "مَلَاك سَاقِط",
 "堕胎": "خِدَاج, إِجْهَاض",
 "堕胎薬": "مُجْهِض (يتسبّب في الإجهاض) / دواء مجهض, مُجهض (دواء (أو عامل كيميائي آخر) يسبب الإجهاض)",
 "堕落": "انحطاط أخلاقي, رذيلة (فعل أو ممارسة فاسدة أو منحطة أو منحلة) / انحطاط أخلاقي, انحلال (انحراف أخلاقي؛ إفساد للفضيلة والمبادئ الأخلاقية)\nمثال: مختلف أشكال الانحطاط في المجتمع الحديث",
 "堕落腐敗": "انحطاط, تحقير (التغيير إلى حالة أدنى (حالة أقل احتراماً)) / تزييف, غش (الخلط بمادة غريبة؛ ناتج الغش)",
 "堡塁": "قَلْعَة, حِصْن (المرة الواحدة من القَلْع؛ حِصْن منيع غالبا يبنى على تلّ أو جبل أو مكان عالٍ منيع)\nمثال: هو يعيش في قلعة.",
 "堡礁": "حاجز مرجاني (شعاب مرجانية طويلة بالقرب من الشاطئ وموازية له)",
 "堤": "مَصْرِف, بَنْك (في الاقتصاد: مؤسسة مالية مُرَخصة، تختص بإتمام الخدمات المالية كتلقي عمليات الإيداع، ومنح القروض، وإدارة الثروات، واستبدال العملات) / ضِفَّة\nمثال: عدن إلى المصرف. / حَوْض, جَابِيَة (حَوَّضَ: عمِل حوضًا؛ حَوَّضَ (الماءَ): حاضَه) / فِنْطَاس\nمثال: ملأت الحوض ماءا.",
 "堤塘": "مَصْرِف, بَنْك (في الاقتصاد: مؤسسة مالية مُرَخصة، تختص بإتمام الخدمات المالية كتلقي عمليات الإيداع، ومنح القروض، وإدارة الثروات، واستبدال العملات) / ضِفَّة\nمثال: عدن إلى المصرف.",
 "堤防": "مَصْرِف, بَنْك (في الاقتصاد: مؤسسة مالية مُرَخصة، تختص بإتمام الخدمات المالية كتلقي عمليات الإيداع، ومنح القروض، وإدارة الثروات، واستبدال العملات) / ضِفَّة\nمثال: عدن إلى المصرف.",
 "堪えがたい": "غير محتمل, لا يطاق (لا يمكن تحمله أو الصبر عليه)\nمثال: درجة لا تطاق من العاطفية",
 "堪えられない": "لَا يُقَاوَم (بالغ الجاذبيّة إلى حدّ لا يمكن مقاومته) / ساحق, لا يقاوم (مستحيل مقاومته؛ غلاب)\nمثال: دوافع لا تقاوم",
 "堪える": "دُبّ / دُبَّة / اِحْتَمَلَ / دَعَمَ, دَعَّمَ (• دَعَمَهُ، كمنَعهُ: مالَ فأقامَهُ) / أَيَّدَ, دَعَمَ ((أَيَّدَه): قوّاه بالإياد) / تَأْيِيد, دَعْم\nمثال: ياني هنا لدعم ريمة. / دُبّ / دُبَّة / اِحْتَمَلَ / سَيْطَرَ / تَحَكُّم, مُرَاقَبَة (\"تَحَكَّمَ فِي أُمُورِهِ الشَّخْصِيَّةِ\" : ضَبَطَهَا وَأَحْكَمَهَا؛ \"يَتَحَكَّمُ فِي أُمُورِ غَيْرِهِ\" : يَتَصَرَّفُ فِيهَا كَمَا يَشَاءُ وَيُرِيدُ)\nمثال: من أنت لتحكم علي؟ / سَامَحَ / غَفَرَ",
 "堪え忍ぶ": "تَحَمَّلَ, صَبَرَ / اِسْتَمَرَّ",
 "堪え性": "تحمل, جلد (القدرة على تحمل المشقة أو التوتر) / بقاء, نجاة (حالة البقاء على قيد الحياة)\nمثال: يختبر الماراثون قدرة تحمل العداء",
 "堪え難い": "غير محتمل, لا يطاق (لا يمكن تحمله أو الصبر عليه)\nمثال: درجة لا تطاق من العاطفية",
 "堪ったものじゃない": "غير محتمل, لا يطاق (لا يمكن تحمله أو الصبر عليه)\nمثال: درجة لا تطاق من العاطفية / عَظِيم, هَائِل (كبير بشكل استثنائي في الحجم أو المدى أو الكمية أو القوة أو الدرجة) / رَائِع, عَظِيم (جيد أو عظيم بشكل استثنائي؛ يُستخدم خاصة كمكثف) / شَدِيد, مَهُول (بالغ في الدرجة أو المدى أو المقدار أو التأثير)",
 "堪ったものではない": "غير محتمل, لا يطاق (لا يمكن تحمله أو الصبر عليه)\nمثال: درجة لا تطاق من العاطفية / عَظِيم, هَائِل (كبير بشكل استثنائي في الحجم أو المدى أو الكمية أو القوة أو الدرجة) / رَائِع, عَظِيم (جيد أو عظيم بشكل استثنائي؛ يُستخدم خاصة كمكثف) / شَدِيد, مَهُول (بالغ في الدرجة أو المدى أو المقدار أو التأثير)",
 "堪ったもんじゃない": "غير محتمل, لا يطاق (لا يمكن تحمله أو الصبر عليه)\nمثال: درجة لا تطاق من العاطفية / عَظِيم, هَائِل (كبير بشكل استثنائي في الحجم أو المدى أو الكمية أو القوة أو الدرجة) / رَائِع, عَظِيم (جيد أو عظيم بشكل استثنائي؛ يُستخدم خاصة كمكثف) / شَدِيد, مَهُول (بالغ في الدرجة أو المدى أو المقدار أو التأثير)",
 "堪ったもんではない": "غير محتمل, لا يطاق (لا يمكن تحمله أو الصبر عليه)\nمثال: درجة لا تطاق من العاطفية / عَظِيم, هَائِل (كبير بشكل استثنائي في الحجم أو المدى أو الكمية أو القوة أو الدرجة) / رَائِع, عَظِيم (جيد أو عظيم بشكل استثنائي؛ يُستخدم خاصة كمكثف) / شَدِيد, مَهُول (بالغ في الدرجة أو المدى أو المقدار أو التأثير)",
 "堪まる": "دُبّ / دُبَّة / اِحْتَمَلَ",
 "堪らない": "غير محتمل, لا يطاق (لا يمكن تحمله أو الصبر عليه)\nمثال: درجة لا تطاق من العاطفية / لَا يُقَاوَم (بالغ الجاذبيّة إلى حدّ لا يمكن مقاومته) / ساحق, لا يقاوم (مستحيل مقاومته؛ غلاب)\nمثال: دوافع لا تقاوم",
 "堪らん": "غير محتمل, لا يطاق (لا يمكن تحمله أو الصبر عليه)\nمثال: درجة لا تطاق من العاطفية / لَا يُقَاوَم (بالغ الجاذبيّة إلى حدّ لا يمكن مقاومته) / ساحق, لا يقاوم (مستحيل مقاومته؛ غلاب)\nمثال: دوافع لا تقاوم",
 "堪る": "دُبّ / دُبَّة / اِحْتَمَلَ",
 "堪忍": "صَبْر, تَحَمُّل ((صَبَرَ) يَصْبِرُ صَبْرًا: تجلَّد ولم يَجْزَع؛ (صَبَرَ): انتظر في هدوء واطمئنان)\nمثال: الصبر أم العلوم. / مَغْفِرَة, غُفْرَان",
 "堪能": "بَارِع, حَاذِق (يمتلك معرفة ومهارة وكفاءة ويُظهرها) / تقني, فني (مكون من أو متعلق بالتقنية أو البراعة في مهارة عملية)\nمثال: كان ابتكاره الفني هو ضربات فرشاته / صَبْر, تَحَمُّل ((صَبَرَ) يَصْبِرُ صَبْرًا: تجلَّد ولم يَجْزَع؛ (صَبَرَ): انتظر في هدوء واطمئنان)\nمثال: الصبر أم العلوم.",
 "堪航能力": "صلاحية للإبحار (اللياقة لعبور البحار)",
 "堰": "سَدّ, سد (أغلق الخلل ورَدَمَ الثلم فلائم الردمُ الثلم؛ الطريق: أغلقه وأعاق السير فيه)",
 "堰き止める": "سَاق نَبَات / أَصْل (جعله أصيلًا أو ثابت الجذور؛ أي عَمَّق وأحكم أصوله؛ نسب شيئًا إلى أصله أو وضّح جذوره)\nمثال: أخشى أن أصل متأخرا.",
 "堰く": "سَدّ, سد (أغلق الخلل ورَدَمَ الثلم فلائم الردمُ الثلم؛ الطريق: أغلقه وأعاق السير فيه)",
 "堰を切る": "برز, ظهر فجأة (ظهر أو حدث بشكل مفاجئ أو غير متوقع)\nمثال: ظهرت المزرعة فجأة عندما انعطفنا",
 "堰堤": "سَدّ, سد (أغلق الخلل ورَدَمَ الثلم فلائم الردمُ الثلم؛ الطريق: أغلقه وأعاق السير فيه)",
 "堰板": "قماش الملاءات (قماش تصنع منه ملاءات السرير)",
 "報": "مَعْلُومَات, مَعْلُومَة / مُكَافَأَة, ثَوَاب / جَائِزَة / جَزَاء / مَنَحَ",
 "報い": "مُكَافَأَة, ثَوَاب / جَائِزَة / جَزَاء / مَنَحَ / عِقَاب, جَزَاء (طَيْر من الجَوَارِح، أكبر التي تصيد منها يكنى بأبي الهَيْثَم ومعروف بحِدَّة البصر؛ حَجَر ناتئ في جَوْف البِئْر يخرق الدَلُو. ونادر) / عُقُوبَة / عِقَاب (طَيْر من الجَوَارِح، أكبر التي تصيد منها يكنى بأبي الهَيْثَم ومعروف بحِدَّة البصر؛ حَجَر ناتئ في جَوْف البِئْر يخرق الدَلُو. ونادر)\nمثال: هو من تلقى العقاب الأكبر.",
 "報いる": "مُكَافَأَة, ثَوَاب / جَائِزَة / جَزَاء / مَنَحَ",
 "報う": "مُكَافَأَة, ثَوَاب / جَائِزَة / جَزَاء / مَنَحَ",
 "報え": "رَدّ (صَرَفَ، أَرْجَعَ؛ أَعَادَ، أَرْجَعَ. (يتعدى بإلى)) / حَلّ (للعقدة: ضد عَقْدها؛ للجامد في السائل: إذابته) / أَجَابَ, رَدَّ (رَدَّ على سُؤالٍ أو طلبٍ؛ أَمْتَثَلَ لِمُطَالَبَةٍ أو دعوةٍ)\nمثال: اليوم هناك برد.",
 "報じる": "وَصَفَ, أَبْلَغَ / أَبْلَغَ (أَكْثَرُ بَلَاغَة) / تَقْرِير, بَلَاغ\nمثال: أبلغ توم تحياتي. / رَجَعَ, عَادَ (جَاءَ بعدما ذَهَبَ) / أَرْجَعَ, أَعَادَ (أَعَادَ، رَدَّ؛ صَرَفَ، رَدَّ) / عَوْدَة\nمثال: إياك والتحرك حتى أرجع.",
