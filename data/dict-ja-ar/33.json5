 "吹込む": "تَسْجِيل, مُدَوَّنَة / سِجِلّ, دَفْتَر (كتاب أو صحيفة تُسَجَّلُ فيها الأمور؛ الكاتب الذي يحفظ تلك الصحيفة أو السِجِلّ) / رَقْم قِيَاسِيّ (وضع أرقامًا على شيء ما للتنظيم أو التمييز) / سَجَّلَ (كتاب أو صحيفة تُسَجَّلُ فيها الأمور؛ الكاتب الذي يحفظ تلك الصحيفة أو السِجِلّ)\nمثال: سجل سامي وصوله.",
 "吹通し": "تَهْوِيَة / بَالَغَ",
 "吹部": "فرقة عسكرية, فرقة موسيقية للحفلات (مجموعة من الموسيقيين يعزفون على الآلات النحاسية وآلات النفخ الخشبية والإيقاعية)",
 "吹降": "عاصفة مطرية (عاصفة مصحوبة بمطر)",
 "吹降り": "عاصفة مطرية (عاصفة مصحوبة بمطر)",
 "吹雪": "عَاصِفَة ثَلْجِيَّة, دَمَق",
 "吹革": "مِنْفَاخ",
 "吹飛ばす": "بَدَّدَ, أَزَالَ ((بَدَّدَ) الشَّيْءَ: فرّقه)",
 "吹鳴": "نفخ (معالجة تتضمن نفخ الغاز)",
 "吹鳴らす": "نَفَخَ (أَطْلَقَ الريح من فمه؛ زَفَرَ أو هَبَّ بشدة) / ضَرْبَة (المرة الواحدة من الضَرْب؛ اللطمو أو الدقة أو الصكّة؛ ضربة طبل: دقة واحدة منه)\nمثال: يداك أوكتا وفوك نفخ",
 "吻": "خُرْطُوم",
 "吻合": "صُدْفَة, مُصَادَفَة (الصدفة. جمع: صُدُفات و صُدْفات و صُدَف٬ هي تزامن غير متوقع لحدوث فعلين بدون تخطيط مسبق، رآه صُدْفةً…)\nمثال: لا تدعها للصدفة. / تشابك, مفاغرة (ربط طبيعي أو جراحي لأجزاء أو فروع الهياكل الأنبوبية بحيث تصبح متصلة)",
 "吼えたてる": "نَبَحَ, يَنْبَح / نُبَاح / لِحَاء",
 "吼える": "نَبَحَ, يَنْبَح / نُبَاح / لِحَاء / عُوَاء / عَوَى / أَنَّ (يفيد التوكيد)\nمثال: كيف لي أن أعرف؟ / صَاحَ (صاتَ بأقصى طاقته وأعلى صوته، يستخدم للحيّ ولا يقال صاح للجماد؛ عليه: ناداه)\nمثال: سأساعدك يا صاح.",
 "吼え声": "نَبَحَ, يَنْبَح / نُبَاح / لِحَاء",
 "吼え立てる": "نَبَحَ, يَنْبَح / نُبَاح / لِحَاء",
 "吼く": "أَنَّ (يفيد التوكيد) / قَهْقَهَ / زَئِير (اسم لصوت الأَسَد؛ زائير اسم سابق لجمهورية الكونغو الديمقراطية)\nمثال: كيف لي أن أعرف؟",
 "吼猿": "العواء, سعدان العواء (قرد يعيش في غابات أمريكا الجنوبية الاستوائية، يتميز بصيحات عواء عالية)",
 "吾": "أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى. / نَفْس (النَّفْسُ : الرُّوحُ؛ النَّفْسُ :الدَّمُ، فشاهده قول السموأَل: تَسِيلُ على حَدِّ الظُّبَّاتِ نُفُوسُنَا…)\nمثال: هم في نفس السن. / مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة!",
 "吾が": "ـِي, ـي",
 "吾が身": "مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة! / نَفْسِي",
 "吾が輩": "أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى. / نحن (ضَمِيرُ رَفْعٍ مُنْفَصِلٌ لِلْمُثَنَّى وَالْجَمْعِ ( مُذَكَّراً وَمُؤَنَّثاً )؛ ضَمِيرُ رَفْعٍ مُنْفَصِلٌ لِلْمُتَكَلِّمِ فِي حَالَةِ التَّعْظِيمِ)\nمثال: نحن مهتمون جدا.",
 "吾主": "مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة!",
 "吾人": "نحن (ضَمِيرُ رَفْعٍ مُنْفَصِلٌ لِلْمُثَنَّى وَالْجَمْعِ ( مُذَكَّراً وَمُؤَنَّثاً )؛ ضَمِيرُ رَفْعٍ مُنْفَصِلٌ لِلْمُتَكَلِّمِ فِي حَالَةِ التَّعْظِيمِ)\nمثال: نحن مهتمون جدا.",
 "吾儕": "أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى. / مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة!",
 "吾兄": "مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة!",
 "吾妹": "حَبِيب, حَبِيبَة",
 "吾妹子": "حَبِيب, حَبِيبَة",
 "吾妻": "الْمِنْطَقَة الشَرْقِيَّة, الشَرْقِيَّة / شَرْق (شَرَقَتِ الشَّمْسُ تَشْرِقُ شَرْقًا؛ وشُرُوقًا: طلعت) / مَشْرِق / شَرْقِيٌّ\nمثال: تشرق الشمس من الشرق. / عَرَبَة",
 "吾妻しい": "سَارّ, لَطِيف (مَشَى)\nمثال: ها قد أتت سارة.",
 "吾妻琴": "عَرَبَة",
 "吾嬬": "الْمِنْطَقَة الشَرْقِيَّة, الشَرْقِيَّة / شَرْق (شَرَقَتِ الشَّمْسُ تَشْرِقُ شَرْقًا؛ وشُرُوقًا: طلعت) / مَشْرِق / شَرْقِيٌّ\nمثال: تشرق الشمس من الشرق. / عَرَبَة",
 "吾曹": "نحن (ضَمِيرُ رَفْعٍ مُنْفَصِلٌ لِلْمُثَنَّى وَالْجَمْعِ ( مُذَكَّراً وَمُؤَنَّثاً )؛ ضَمِيرُ رَفْعٍ مُنْفَصِلٌ لِلْمُتَكَلِّمِ فِي حَالَةِ التَّعْظِيمِ)\nمثال: نحن مهتمون جدا.",
 "吾殿": "مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة!",
 "吾輩": "أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى. / نحن (ضَمِيرُ رَفْعٍ مُنْفَصِلٌ لِلْمُثَنَّى وَالْجَمْعِ ( مُذَكَّراً وَمُؤَنَّثاً )؛ ضَمِيرُ رَفْعٍ مُنْفَصِلٌ لِلْمُتَكَلِّمِ فِي حَالَةِ التَّعْظِيمِ)\nمثال: نحن مهتمون جدا.",
 "呂律": "تمفصل (عملية ربط الأشياء بطريقة تجعل الحركة ممكنة) / مفصل ((في التشريح) نقطة الاتصال بين عظمين أو عناصر هيكل عظمي (خاصة إذا كانت تسمح بالحركة)) / تعبير, نطق (التعبير بشكل لفظي متماسك) / تلفظ, نطق مخارج الحروف (جانب النطق الذي يتضمن جمع أعضاء النطق معاً لتشكيل أصوات الكلام)\nمثال: التعبير عن مشاعري",
 "呆": "مَصْدُوم, مَهُول (أصابه الخوف أو الهلع أو الذهول)",
 "呆け": "مُغَفَّل, أَحْمَق / خرف, هرم (الضعف العقلي نتيجة لكبر السن) / خَارِج السِّيَاق, غَيْر مُلِمّ (غافل نتيجة عدم الاطلاع على المعلومات) / فَاقِدُ الإِحْسَاسِ, مُغْمًى عَلَيْهِ (لَا يَسْتَجِيبُ لِلتَّنْبِيهِ أَوِ المُؤَثِّرَاتِ) / مُسْتَبْعَد, مُهَمَّش (مُقصًى من نشاط أو مجموعة اجتماعية)",
 "呆れ笑い": "اسْتِهْزَاء, تَهَكُّم (إظهار الازدراء عن طريق السخرية)",
 "呆然": "مَبْهُوت, مَصْعُوق (كأنه أُصيب بالخرس من شدة الذهول والمفاجأة)",
 "呆然自失": "ترنح, ذهول (وعي هامشي) / ذهول, صدمة (شعور بالضيق وعدم التصديق الذي ينتابك عند حدوث شيء سيء بشكل عرضي)\nمثال: كان ترنحه بسبب الإرهاق بقدر ما كان بسبب الضربات",
 "呈す": "حَالِيّ, حَاضِر / مَوْجُود, حَاضِر (الذي له وجود) / الزَّمَان, الْحَال / قَدَّمَ, طَرَحَ (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى الرُّسْغَ؛ أنّ لهم سابقةً وفضلاً له عند فلان قَدَمٌ : معروف)\nمثال: أنا موجود لوحدي / ثَبَتَ, وَضَحَ (اسْتَقَرَّ ودَامَ ولم يتحرك برغم المغريات أو الدوافع؛ الأمر: تَحَقَّقَ وتَأكَّدَ حصوله) / عَرْض, اِسْتِعْرَاض (أتى العروض، أي مكّة والمدينة وما حولهما؛ الفَرَسَ: سار به بالعُرض) / بَرْنَامَج (عَرْضٌ (تلْفَزِيٌّ،…)؛ مُفَكَّرَةٌ يَوْمِيَّةٌ) / مَعْرِض / إِظْهَار, عَرْض\nمثال: ثبت مناد مكانه. / اِفْتَرَضَ",
 "呈する": "حَالِيّ, حَاضِر / مَوْجُود, حَاضِر (الذي له وجود) / الزَّمَان, الْحَال / قَدَّمَ, طَرَحَ (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى الرُّسْغَ؛ أنّ لهم سابقةً وفضلاً له عند فلان قَدَمٌ : معروف)\nمثال: أنا موجود لوحدي / ثَبَتَ, وَضَحَ (اسْتَقَرَّ ودَامَ ولم يتحرك برغم المغريات أو الدوافع؛ الأمر: تَحَقَّقَ وتَأكَّدَ حصوله) / عَرْض, اِسْتِعْرَاض (أتى العروض، أي مكّة والمدينة وما حولهما؛ الفَرَسَ: سار به بالعُرض) / بَرْنَامَج (عَرْضٌ (تلْفَزِيٌّ،…)؛ مُفَكَّرَةٌ يَوْمِيَّةٌ) / مَعْرِض / إِظْهَار, عَرْض\nمثال: ثبت مناد مكانه. / اِفْتَرَضَ",
 "呈上": "مِعْطَاء",
 "呈出": "حَالِيّ, حَاضِر / مَوْجُود, حَاضِر (الذي له وجود) / الزَّمَان, الْحَال / قَدَّمَ, طَرَحَ (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى الرُّسْغَ؛ أنّ لهم سابقةً وفضلاً له عند فلان قَدَمٌ : معروف)\nمثال: أنا موجود لوحدي",
 "呈示": "إِرَاءَة / إِهْدَاء, مَنْح",
 "呈色": "اختيار الألوان, تلوين (اختيار واستخدام الألوان (كما يفعل الفنان)) / اصطباغ, تلوين (المظهر فيما يتعلق باللون) / لون صوتي (جرس الصوت الموسيقي)\nمثال: تلوينها الصحي",
 "呉": "وُو",
 "呉の母": "شَمَر ((شَمَرَ) يَشْمُرُ شَمْرًا: مَرَّ جادًّا؛ (شَمَرَ): مَشَى مُخْتالاً)",
 "呉る": "أَعْطَى, وَهَبَ (مَنَحَ، نَوَّلَ)\nمثال: أعطى بلده حياته.",
 "呉れ手": "مُتَبَرِّع",
 "呉服": "قُمَاش, أقمشة (النسيج الذي لم يُقَصّ أو يُخَاط) / مِمْسَحَة\nمثال: الورق و القماش يمتصان الماء.",
 "呉服屋": "بَزَّاز",
 "呉服物": "قِطْعَة (القِطْعَةُ: الْجُزْءَ أو الحِصَّة من الشيءِ؛ القِطْعَةُ: فقرة قصيرة عادة من مقالٍ أو كتاب)\nمثال: يصنع قطعة أثاث خشبية.",
 "呉牛": "جاموس الماء (جاموس آسيوي غالباً ما يتم استئناسه لاستخدامه كحيوان جر)",
 "告ぐ": "أَخْبَرَ, قَالَ (أَنْبَأَ، أَعْلَمَ) / تَلّ (في الْمُرتَفَعِ مِنَ الأرْضِ قَليلا، وهو دون الجَبَل؛ رَابِيَة)\nمثال: أخبر سامي أباه. / دَلَّ عَلَى, رَمَزَ إِلَى (مَعِدَة، بَطْن؛ قَلْب)\nمثال: بدل سامي ملابسه.",
 "告げる": "أَخْبَرَ, قَالَ (أَنْبَأَ، أَعْلَمَ) / تَلّ (في الْمُرتَفَعِ مِنَ الأرْضِ قَليلا، وهو دون الجَبَل؛ رَابِيَة)\nمثال: أخبر سامي أباه. / دَلَّ عَلَى, رَمَزَ إِلَى (مَعِدَة، بَطْن؛ قَلْب)\nمثال: بدل سامي ملابسه.",
 "告げ口": "بَلِيغ, مُؤَثِّر (يُنتج أثراً قويّاً) / فَاضِح, كَاشِف (يكشف عن غير قصد شيئًا مخفيًّا) / دَامِغ, مُؤَثِّر (مقنع بقوّة ووجاهة الحجّة) / إفشاء, وشاية (كشف معلومات أو تقديم أدلة عن شخص آخر)",
 "告別": "وَدَاع / فِرَاق, وَدَاع / وَدَاعًا (تقال للمسافر؛ تقال قبل الانصراف. (تعميم))\nمثال: قال زيري وداعا.",
 "告発": "قرار اتهام, لائحة اتهام (وثيقة رسمية يكتبها مدع عام يتهم فيها شخصاً بجريمة ما) / اتهام, لائحة اتهام (اتهام بارتكاب مخالفات)\nمثال: الكتاب هو لائحة اتهام للفلسفة الحديثة",
 "告発状": "قرار اتهام, لائحة اتهام (وثيقة رسمية يكتبها مدع عام يتهم فيها شخصاً بجريمة ما)",
 "告発者": "شَاكٍ",
 "告白": "إِقْرَار, اِعْتِرَاف / طَائِفَة (مؤنث طَائِف؛ التي تطوفُ؛ القطعة أو الجزء من الشيء أو الواحدة منه) / مِهْنَة / وَظِيفَة (ما يُقَدَّر من الشيء في زمن مُعَيَّن؛ مَنْصِب)\nمثال: ما وظيفة زوجتك؟",
 "告白録": "إِقْرَار, اِعْتِرَاف / طَائِفَة (مؤنث طَائِف؛ التي تطوفُ؛ القطعة أو الجزء من الشيء أو الواحدة منه)",
 "告知": "لَاحَظَ / لَاحَظَ, اِنْتَبَهَ",
 "告知板": "لَوْحَة إِعْلَانَات",
 "告示": "لَاحَظَ / لَاحَظَ, اِنْتَبَهَ",
 "告示板": "لَوْحَة إِعْلَانَات",
 "告解": "إِقْرَار, اِعْتِرَاف / طَائِفَة (مؤنث طَائِف؛ التي تطوفُ؛ القطعة أو الجزء من الشيء أو الواحدة منه)",
 "告解場": "كرسي الاعتراف, كشك الاعتراف (كشك يجلس فيه الكاهن لسماع الاعترافات)",
 "告解師": "المُعَرِّف, كاهن الاعتراف (كاهن يستمع إلى الاعتراف ويمنح الغفران) / معترف (شخص يعترف (يكشف معلومات تضر بنفسه))",
 "告訴": "اِتِّهَام / اِتِّهَام, تُهْمَة",
 "告訴人": "شَاكٍ",
 "告達": "إِشْعَار, إِخْطَار / تَنْبِيه, إِشْعَار",
 "呑み": "شَرِبَ, شرب (جَرَعَ) / شَرَاب, مَشْرُوب / شراب\nمثال: جلس وشرب قهوته. / حنفية, صنبور (منظم للتحكم في تدفق السائل من خزان) / سدادة حنفية, صنبور (سدادة لفتحة البرميل في برميل خشبي)",
 "呑み助": "مُعَاقِر الخَمْر, شَارِب الخَمْر",
 "呑み口": "ذَوْق, طَعْم (الذَّوْقُ : حَاسَّةُ اللِّسَانِ وَبِهَا قُوَّةٌ تُدْرِكُ خَوَاصَّ الأَجْسَامِ الطَّعْمِيَّةَ؛ الذَّوْقُ : آدابُ السلوك التي تقتضي معرفة ما هو لائق أو مناسب في موقف اجتماعيّ معيّن) / ذَوْق (الذَّوْقُ : حَاسَّةُ اللِّسَانِ وَبِهَا قُوَّةٌ تُدْرِكُ خَوَاصَّ الأَجْسَامِ الطَّعْمِيَّةَ؛ الذَّوْقُ : آدابُ السلوك التي تقتضي معرفة ما هو لائق أو مناسب في موقف اجتماعيّ معيّن) / ذَاقَ, تَذَوَّقَ (تناول شيئا من الطعام أو الشراب ليختبر طَعْمَه؛ جَرَّبَ، اِخْتًبَرَ، أَحَسَّ)\nمثال: أكره ذوق الكحول. / تَنَصَّتَ",
 "呑み屋": "حَانَة, بَار / مُؤَلِّف, كَتَّاب / مُرَاهِن / حانة رخيصة ((سابقاً) صالون رخيص يبيع الخمور بالدلو) / شركة وساطة وهمية, مكتب مراهنات غير قانوني (شركة وساطة غير أخلاقية أو عدوانية بشكل مفرط)",
 "呑み師": "كحولي, مدمن كحول (شخص يشرب الكحول بإفراط وبشكل اعتيادي)",
 "呑み歩き": "جولة حانات (جولة في الحانات (عادة مع تناول مشروب في كل محطة))",
 "呑み行為": "دَلْو, سَطْل",
 "呑み込み": "جَرَعَ, بَلَعَ ((جَرَعَ) المَاء وَنَحْوه جرعا: بَلِعَه) / جَرْعَة, شَرْبَة / سُنُونُو / فَهْم (فهم الأمر أو الكلام أو نحو ذلك، أدركه، علمه، أحسن تصوّره، استوعبه) / رُؤْيَة / تَفَاهُم / فهم (فهم الأمر أو الكلام أو نحو ذلك، أدركه، علمه، أحسن تصوّره، استوعبه)\nمثال: لقد أسئت الفهم.",
 "呑み込みが悪い": "بَطِيء الفَهْم, ضَعِيف العَقْل (متأخر في التطور العقلي والذهني)",
 "呑み込みが早い": "سَرِيع البَدِيهَة (ذكي وسريع الحيلة ذهنياً)",
 "呑み込む": "جَرَعَ, بَلَعَ ((جَرَعَ) المَاء وَنَحْوه جرعا: بَلِعَه) / جَرْعَة, شَرْبَة / سُنُونُو / فَهِمَ (فهم الأمر أو الكلام أو نحو ذلك، أدركه، علمه، أحسن تصوّره، استوعبه)\nمثال: لقد أسئت الفهم. / اِحْتَوَى, تَضَمَّنَ / اِحْتَوَى",
 "呑む": "شَرِبَ, شرب (جَرَعَ) / شَرَاب, مَشْرُوب / شراب\nمثال: جلس وشرب قهوته. / دُخَان, دخان / دَخَّنَ (دخن: الشَّيْء دخنة دخن؛ دخنت: النَّار دخنت والوقود دخن)\nمثال: دخن زيري سيجارة. / جَرَعَ, بَلَعَ ((جَرَعَ) المَاء وَنَحْوه جرعا: بَلِعَه) / جَرْعَة, شَرْبَة / سُنُونُو / قَبِلَ (وضع فمه على الشخص أو الشيء علامة الحب والاحترام. في العاميّة يُقال بَاسَ) / اِعْتَرَفَ\nمثال: كنت هنا من قبل.",
 "呑んでかかる": "اِسْتَخَفَّ, اِسْتَهَانَ / اِسْتَبَدَّ (حزم ولم يتردد في اتخاذ القرار وتنفيذه؛ (في السياسة) حكم بنظام استبدادي)",
 "呑んで掛かる": "اِسْتَخَفَّ, اِسْتَهَانَ / اِسْتَبَدَّ (حزم ولم يتردد في اتخاذ القرار وتنفيذه؛ (في السياسة) حكم بنظام استبدادي)",
 "呑兵衛": "مُعَاقِر الخَمْر, شَارِب الخَمْر",
 "呑口": "ذَوْق, طَعْم (الذَّوْقُ : حَاسَّةُ اللِّسَانِ وَبِهَا قُوَّةٌ تُدْرِكُ خَوَاصَّ الأَجْسَامِ الطَّعْمِيَّةَ؛ الذَّوْقُ : آدابُ السلوك التي تقتضي معرفة ما هو لائق أو مناسب في موقف اجتماعيّ معيّن) / ذَوْق (الذَّوْقُ : حَاسَّةُ اللِّسَانِ وَبِهَا قُوَّةٌ تُدْرِكُ خَوَاصَّ الأَجْسَامِ الطَّعْمِيَّةَ؛ الذَّوْقُ : آدابُ السلوك التي تقتضي معرفة ما هو لائق أو مناسب في موقف اجتماعيّ معيّن) / ذَاقَ, تَذَوَّقَ (تناول شيئا من الطعام أو الشراب ليختبر طَعْمَه؛ جَرَّبَ، اِخْتًبَرَ، أَحَسَّ)\nمثال: أكره ذوق الكحول. / تَنَصَّتَ",
 "呑師": "كحولي, مدمن كحول (شخص يشرب الكحول بإفراط وبشكل اعتيادي)",
 "呑気症": "بلع الهواء (ابتلاع الهواء (يتبعه عادة تجشؤ وانزعاج وانتفاخ))",
 "呑気者": "طَائِش, لَا مُبَالٍ (غير مسؤول بمرح وخِفّة)",
 "呟き": "لَغَط, طَبْطَبَة / غَمْغَمَ, تَغَمْغَمَ / تَغْرِيدَة / غَرَّدَ",
 "呟きサイト": "تدوين مصغر (مدونة يتم فيها تحديد طول التدوينات الفردية (مثل تويتر))",
 "呟きブログ": "تدوين مصغر (مدونة يتم فيها تحديد طول التدوينات الفردية (مثل تويتر))",
 "呟く": "غَمْغَمَة, تَمْتَمة / تَمْتَمَ, هَمْهَمَ / تَغْرِيدَة / غَرَّدَ",
 "呦々": "بَاكٍ / بُكَاء / شهيق البكاء, نشيج (شهقة تشنجية تحدث أثناء البكاء)",
 "呦呦": "بَاكٍ / بُكَاء / شهيق البكاء, نشيج (شهقة تشنجية تحدث أثناء البكاء)",
 "周": "مُحِيط (في : هو الخط المستدير الذي يُحيط بالشكل الهندسي؛ في : البَحْر المُحِيْط هو البحر الكبير الذي يحيط بالقارات. الاستخدام الحديث يحذف كلمة بَحْر؛ القَامُوْس)\nمثال: أسبح في المحيط. / تشو, سلالة تشو (السلالة الإمبراطورية للصين من 1122 إلى 221 قبل الميلاد؛ اشتهرت بظهور الكونفوشيوسية والطاوية)",
 "周り": "مُحِيط (في : هو الخط المستدير الذي يُحيط بالشكل الهندسي؛ في : البَحْر المُحِيْط هو البحر الكبير الذي يحيط بالقارات. الاستخدام الحديث يحذف كلمة بَحْر؛ القَامُوْس)\nمثال: أسبح في المحيط.",
 "周到": "حَذِر (حذِر الشّخصُ: تيقّظ واستعدّ وتأهّب وتنبّه؛ حذِر الأمرَ: كَتَمَه وأخفاه) / دَقِيق (ضد الغَلِيْظ، الرَفِيْع الرَقِيْق؛ صغير الحجم جدا)\nمثال: قد بحذر من فضلك.",
 "周回": "مَدَار (اسم مَفْعُول من أدَارَ، الشيء أو الشخص الذي أُدِير) / فَلَك (التَلّ المستدير من الرَمْل حوله فَضَاء؛ المَدَار يسبح فيه الجُرْم السماويّ)\nمثال: انتشرت الشائعة على مدار الدولة. / مُحِيط (في : هو الخط المستدير الذي يُحيط بالشكل الهندسي؛ في : البَحْر المُحِيْط هو البحر الكبير الذي يحيط بالقارات. الاستخدام الحديث يحذف كلمة بَحْر؛ القَامُوْس)\nمثال: أسبح في المحيط.",
 "周回軌道": "مَدَار (اسم مَفْعُول من أدَارَ، الشيء أو الشخص الذي أُدِير) / فَلَك (التَلّ المستدير من الرَمْل حوله فَضَاء؛ المَدَار يسبح فيه الجُرْم السماويّ)\nمثال: انتشرت الشائعة على مدار الدولة.",
 "周囲": "مُحِيط (في : هو الخط المستدير الذي يُحيط بالشكل الهندسي؛ في : البَحْر المُحِيْط هو البحر الكبير الذي يحيط بالقارات. الاستخدام الحديث يحذف كلمة بَحْر؛ القَامُوْس)\nمثال: أسبح في المحيط.",
 "周囲長": "مُحِيط (في : هو الخط المستدير الذي يُحيط بالشكل الهندسي؛ في : البَحْر المُحِيْط هو البحر الكبير الذي يحيط بالقارات. الاستخدام الحديث يحذف كلمة بَحْر؛ القَامُوْس)\nمثال: أسبح في المحيط.",
 "周圏": "مُحِيط (في : هو الخط المستدير الذي يُحيط بالشكل الهندسي؛ في : البَحْر المُحِيْط هو البحر الكبير الذي يحيط بالقارات. الاستخدام الحديث يحذف كلمة بَحْر؛ القَامُوْس)\nمثال: أسبح في المحيط.",
 "周密": "مُجْتَهِد, وَرِع فِي عَمَلِه (يَتَّسِم بِعِنَايَة فَائِقَة وجُهْدٍ كَبِير) / دقيق, ضميري (لديه وازع؛ ينبع من الشعور بالصواب والخطأ؛ صاحب مبادئ)\nمثال: أرسل المنتجون الأقل نزاهة حزماً كانت مخادعة في مظهرها",
 "周年": "إِلَى أَقْصَى حَدٍّ, اَلنُّونِيّ (الأخير أو الأعظم في سلسلة كبيرة غير محددة)",
 "周旋": "بيني, متوسط (الواقع بين نقيضين أو طرفين في الزمان أو المكان أو الحالة) / مُتَوَسِّط, وَسَط (فِي حُدُودِ الوَسَطِ عَلَى مِقْيَاسِ التَّقْيِيم) / مركب وسيط, وسيط كيميائي (مادة تتشكل أثناء عملية كيميائية قبل الحصول على المنتج المطلوب)\nمثال: الانتقال من الجلوس إلى الوقوف دون دفعات وسيطة باليدين / مكتب عمل, وكالة توظيف (وكالة تجد أشخاصاً لشغل وظائف معينة أو تجد وظائف للعاطلين عن العمل)",
 "周旋人": "فَاعِل (الشيء :فعله)\nمثال: تظن الشرطة أن سامي يعلم من الفاعل.",
 "周旋屋": "سِمْسَار, وَسِيط",
 "周旋料": "بيت وساطة, شركة وساطة (المكان الذي يدير فيه الوسيط أعماله) / سمسرة, وساطة (عمل السمسار؛ يتقاضى رسوماً لترتيب عقد بين طرفين) / شركة سمسرة, شركة وساطة مالية (أعمال سمسار الأوراق المالية؛ تتقاضى رسوماً للعمل كوسيط بين البائع والمشتري)",
 "周旋業": "بيت وساطة, شركة وساطة (المكان الذي يدير فيه الوسيط أعماله) / سمسرة, وساطة (عمل السمسار؛ يتقاضى رسوماً لترتيب عقد بين طرفين) / شركة سمسرة, شركة وساطة مالية (أعمال سمسار الأوراق المالية؛ تتقاضى رسوماً للعمل كوسيط بين البائع والمشتري)",
 "周旋業者": "سِمْسَار, وَسِيط",
 "周易": "تنجيم, عرافة (فن أو موهبة النبوءة (أو ادعاء النبوءة) بوسائل خارقة للطبيعة) / نبوءة (تنبؤ ينطق به تحت إلهام إلهي) / حَدْس صَائِب, فِرَاسَة (تخمين ناجح عن طريق بصيرة غير عادية أو حظ جيد)",
 "周期": "دَوْر, دَوْرَة (جَعَله يَدُور؛ جَعَلَه مُدَوَّر) / دَوْرَة (في غرب العراق على نهر الفرات قرب الحدود السورية؛ حَيّ في جنوب بغداد تقع فيه محطة تكرير للنفط تسمّى بإسمه)\nمثال: في أي دور تسكن؟",
 "周期冗長検査": "فحص التكرار الدوري (رمز لتصحيح الخطأ يُسجل في كل قطاع من القرص المغناطيسي ويُستخدم لاكتشاف الأخطاء في البيانات)",
 "周期律": "القانون الدوري, قانون مندليف ((كيمياء) المبدأ القائل بأن الخواص الكيميائية للعناصر هي دوال دورية لأعدادها الذرية)",
 "周期性": "دَوْرِيَّة (صفة التكرار على فترات منتظمة) / دَوْرِيّ, عَرَضِيّ (يَتَكَرَّرُ أَوْ يَظْهَرُ مِنْ حِينٍ لِآخَر) / دوري (يحدث أو يتكرر على فترات منتظمة)\nمثال: الظهور الدوري للجراد ذي السبعة عشر عاماً",
 "周期性嘔吐症": "مِئَة وَخَمْسَة (يَدُلُّ عَلَى العَدَد 105) / سيرة ذاتية (ملخص للتاريخ الأكاديمي والوظيفي للشخص)",
 "周期的": "دَوْرِيّ, عَرَضِيّ (يَتَكَرَّرُ أَوْ يَظْهَرُ مِنْ حِينٍ لِآخَر) / دوري (يحدث أو يتكرر على فترات منتظمة)\nمثال: الظهور الدوري للجراد ذي السبعة عشر عاماً",
 "周期表": "الْجَدْوَلُ الدَّوْرِيّ",
 "周波": "دَوْر, دَوْرَة (جَعَله يَدُور؛ جَعَلَه مُدَوَّر) / دَوْرَة (في غرب العراق على نهر الفرات قرب الحدود السورية؛ حَيّ في جنوب بغداد تقع فيه محطة تكرير للنفط تسمّى بإسمه)\nمثال: في أي دور تسكن؟",
 "周波変調": "تضمين التردد (تضمين تردد الموجة الحاملة (للراديو))",
 "周波帯": "حزمة موجية, نطاق التردد (نطاق من الترددات الراديوية المتجاورة (مثل تلك المخصصة لنقل إشارات الراديو أو التلفزيون))",
 "周波数": "تَرَدُّد (الذهاب إلى المكان مرة أخرى إلى نفس المكان بصورة متكررة؛ عدم الاستقرار على رأي معين)\nمثال: قبل ماثيو بتردد.",
 "周波数変調": "تضمين التردد (تضمين تردد الموجة الحاملة (للراديو))",
 "周波数変調方式": "تضمين التردد (تضمين تردد الموجة الحاملة (للراديو))",
 "周波数帯": "حزمة موجية, نطاق التردد (نطاق من الترددات الراديوية المتجاورة (مثل تلك المخصصة لنقل إشارات الراديو أو التلفزيون))",
 "周波数特性": "استجابة ترددية ((في الإلكترونيات) منحنى يمثل نسبة المخرجات إلى المدخلات لمحول الطاقة كدالة للتردد)",
 "周産期学": "طب الفترة المحيطة بالولادة (فرع التوليد المعني بتشريح وفسيولوجيا وتشخيص وعلاج اضطرابات الأم والجنين أو الوليد خلال أواخر الحمل والولادة والنفاس)",
 "周知": "أمر معروف للجميع, معلومات عامة (أي شيء معروف عموماً للجميع)",
 "周知の事実": "أمر معروف للجميع, معلومات عامة (أي شيء معروف عموماً للجميع)",
 "周知徹底": "نَشْر, بَثّ (بَسَطَ، فَرَّقَ، نَشَرَ الشيءَ: جعله منتشراً، مثل نشر الأخبار أو نشر كتاب؛ نَشَرَ: وزع أو عمم شيئًا بين الناس، مثل نشر المقالات)\nمثال: نشر توم الغسيل.",
 "周章": "اِلْتِبَاس / اِرْتِبَاك (ارتبك الأمر:اختلط عليه ، وفي الوحْل :نَشَبَ فيه وعَلِق ،وفي الأمر:وقع فيه ولم يكد يتخلّص منه؛ ارتبك في كلامه:إذا تَتَعْتَعَ، وارتبك الصّيد في الْحِبَالَة:اِضْطَرَب)\nمثال: لا داعي لارتباك.",
 "周章狼狽": "ذعر, فزع (خوف ناتج عن الوعي بالخطر)",
 "周縁": "هُدْب (هُدْبُ العين ما نبت من الشعر على أشفارها) / هُدُب (هُدْبُ العين ما نبت من الشعر على أشفارها)",
 "周縁化": "تهميش (العملية الاجتماعية المتمثلة في التحول إلى هامشي أو جعله هامشياً (خاصة كمجموعة داخل المجتمع الأكبر))\nمثال: تهميش الطبقة الدنيا",
 "周縁部": "أطراف, حد خارجي (الحد الخارجي أو سطح شيء ما)",
 "周航": "طواف حول العالم (السفر حول شيء ما (بالسفينة أو الطائرة))\nمثال: أثبت طواف ماجلان حول الأرض أنها كروية",
 "周転円": "فَلَك التَّدوِير (التَلّ المستدير من الرَمْل حوله فَضَاء؛ المَدَار يسبح فيه الجُرْم السماويّ)\nمثال: أصبح زيري عالم فلك.",
 "周辺": "مُحِيط (في : هو الخط المستدير الذي يُحيط بالشكل الهندسي؛ في : البَحْر المُحِيْط هو البحر الكبير الذي يحيط بالقارات. الاستخدام الحديث يحذف كلمة بَحْر؛ القَامُوْس)\nمثال: أسبح في المحيط. / طَرَفِيّ, مُحِيطِيّ (على أو بالقرب من حافة أو يشكل حداً خارجياً؛ المنطقة الخارجية) / طَرَفِيّ, هَامِشِيّ (مرتبط بالقضية الرئيسية لكنّه ليس ذا أهمية محورية) / جهاز طرفي, ملحق حاسوبي (معدات إلكترونية خارجية عن لوحة الدائرة التي تحتوي على وحدة المعالجة المركزية للكمبيوتر)\nمثال: المقاطعات الطرفية لروسيا",
 "周辺化": "تهميش (العملية الاجتماعية المتمثلة في التحول إلى هامشي أو جعله هامشياً (خاصة كمجموعة داخل المجتمع الأكبر))\nمثال: تهميش الطبقة الدنيا",
 "周辺機器": "طَرَفِيّ, مُحِيطِيّ (على أو بالقرب من حافة أو يشكل حداً خارجياً؛ المنطقة الخارجية) / طَرَفِيّ, هَامِشِيّ (مرتبط بالقضية الرئيسية لكنّه ليس ذا أهمية محورية) / جهاز طرفي, ملحق حاسوبي (معدات إلكترونية خارجية عن لوحة الدائرة التي تحتوي على وحدة المعالجة المركزية للكمبيوتر)\nمثال: المقاطعات الطرفية لروسيا",
 "周辺装置": "جهاز طرفي, ملحق حاسوبي (معدات إلكترونية خارجية عن لوحة الدائرة التي تحتوي على وحدة المعالجة المركزية للكمبيوتر)\nمثال: محركات الأقراص والطابعات هي أجهزة طرفية مهمة",
 "周辺視覚": "رؤية جانبية, رؤية محيطية (الرؤية عند حواف المجال البصري باستخدام محيط الشبكية فقط)",
 "周辺視野": "رؤية جانبية, رؤية محيطية (الرؤية عند حواف المجال البصري باستخدام محيط الشبكية فقط)",
 "周遊": "رِحْلَة / جَوْلَة",
 "周長": "مُحِيط (في : هو الخط المستدير الذي يُحيط بالشكل الهندسي؛ في : البَحْر المُحِيْط هو البحر الكبير الذي يحيط بالقارات. الاستخدام الحديث يحذف كلمة بَحْر؛ القَامُوْس)\nمثال: أسبح في المحيط.",
 "呪": "تميمة الحظ, جالب للحظ (شيء يُعتقد أنه يجلب الحظ السعيد) / جاذبية, سحر (الجاذبية التي تثير الاهتمام أو تسعد أو تحفز) / كوارك ساحر, نكهة السحر ((فيزياء) إحدى نكهات الكوارك الست، وهو الثالث من حيث الكتلة بين جميع الكواركات) / تعويذة, رقى (صيغة لفظية يُعتقد أن لها قوة سحرية)\nمثال: كانت ابتسامته جزءاً من جاذبيته لها / لَعْنَة (أي رغبة صريحة في أن تصيب المحن أو أي شكل من أشكال سوء الحظ كيانًا ما، سواء كان شخصًا، أو مكانًا، أو كائنًا) / نِقْمَة / لَعَنَ ((في الدين) طَرَدَهُ اللَّٰهُ مِنْ رَحْمَتِهِ؛ سَبَّ، شَتَمَ) / شَتَمَ, سَبَّ\nمثال: اللعنة حولها ومعرفة / تعويذة, مانترا ((سنسكريتية) تعني حرفياً 'قول مقدس' في الفيدية؛ واحدة من مجموعة ترانيم شعرية منقولة شفهياً) / تعويذة متكررة, مانترا (كلمة أو عبارة مكررة بشكل شائع)\nمثال: كررت 'مسرورة جداً بسير الأمور' على فترات مثل المانترا / تَعْوِيذَة / هَجَّى, تَهَجَّى",
 "呪い": "لَعْنَة (أي رغبة صريحة في أن تصيب المحن أو أي شكل من أشكال سوء الحظ كيانًا ما، سواء كان شخصًا، أو مكانًا، أو كائنًا) / نِقْمَة / لَعَنَ ((في الدين) طَرَدَهُ اللَّٰهُ مِنْ رَحْمَتِهِ؛ سَبَّ، شَتَمَ) / شَتَمَ, سَبَّ\nمثال: اللعنة حولها ومعرفة / تميمة الحظ, جالب للحظ (شيء يُعتقد أنه يجلب الحظ السعيد) / جاذبية, سحر (الجاذبية التي تثير الاهتمام أو تسعد أو تحفز) / كوارك ساحر, نكهة السحر ((فيزياء) إحدى نكهات الكوارك الست، وهو الثالث من حيث الكتلة بين جميع الكواركات) / تعويذة, رقى (صيغة لفظية يُعتقد أن لها قوة سحرية)\nمثال: كانت ابتسامته جزءاً من جاذبيته لها",
 "呪う": "لَعْنَة (أي رغبة صريحة في أن تصيب المحن أو أي شكل من أشكال سوء الحظ كيانًا ما، سواء كان شخصًا، أو مكانًا، أو كائنًا) / نِقْمَة / لَعَنَ ((في الدين) طَرَدَهُ اللَّٰهُ مِنْ رَحْمَتِهِ؛ سَبَّ، شَتَمَ) / شَتَمَ, سَبَّ\nمثال: اللعنة حولها ومعرفة / لَعْنَة (أي رغبة صريحة في أن تصيب المحن أو أي شكل من أشكال سوء الحظ كيانًا ما، سواء كان شخصًا، أو مكانًا، أو كائنًا) / نِقْمَة / لَعَنَ ((في الدين) طَرَدَهُ اللَّٰهُ مِنْ رَحْمَتِهِ؛ سَبَّ، شَتَمَ) / شَتَمَ, سَبَّ\nمثال: اللعنة حولها ومعرفة / تميمة الحظ, جالب للحظ (شيء يُعتقد أنه يجلب الحظ السعيد) / جاذبية, سحر (الجاذبية التي تثير الاهتمام أو تسعد أو تحفز) / كوارك ساحر, نكهة السحر ((فيزياء) إحدى نكهات الكوارك الست، وهو الثالث من حيث الكتلة بين جميع الكواركات) / تعويذة, رقى (صيغة لفظية يُعتقد أن لها قوة سحرية)\nمثال: كانت ابتسامته جزءاً من جاذبيته لها",
 "呪り": "تَعْوِيذَة / هَجَّى, تَهَجَّى",
 "呪わしい": "بغيض, كريه (يثير أو يستحق الكراهية) / حَقُود, خَبِيث (يتسم بالحقد والخبث)\nمثال: لا توجد رذيلة بغيضة عالمياً مثل الجحود",
 "呪具": "تميمة الحظ, جالب للحظ (شيء يُعتقد أنه يجلب الحظ السعيد) / جاذبية, سحر (الجاذبية التي تثير الاهتمام أو تسعد أو تحفز) / كوارك ساحر, نكهة السحر ((فيزياء) إحدى نكهات الكوارك الست، وهو الثالث من حيث الكتلة بين جميع الكواركات) / تعويذة, رقى (صيغة لفظية يُعتقد أن لها قوة سحرية)\nمثال: كانت ابتسامته جزءاً من جاذبيته لها",
 "呪力": "قدرة سحرية (القدرة على أداء السحر)",
 "呪文": "تَعْوِيذَة / هَجَّى, تَهَجَّى",
 "呪法": "سِحْر (ألقى السحر على شخص أو شيء، بمعنى جعله تحت تأثير السحر؛ أدهش أو أبهر بجمال أو جاذبية غير عادية) / سِحْرِيّ\nمثال: هذا هو سحر الجزائر.",
 "呪物": "هَوَس, وَلَع مَرَضِيّ (تفاني مفرط أو غير عقلاني لنشاط ما) / تميمة سحرية, سحر (تميمة يُعتقد بخرافة أنها تجسد قوى سحرية) / صنمية جنسية, فتيشية (شكل من أشكال الرغبة الجنسية يعتمد فيه الإشباع بدرجة غير طبيعية على كائن أو قطعة ملابس أو جزء من الجسم)\nمثال: جعل من النظافة هوساً",
 "呪物崇拝": "صنمية جنسية, فيتيشية (الإثارة الجنسية أو الإشباع الناتج عن التعامل مع صنم (أو جزء معين من الجسم غير الأعضاء التناسلية)) / تقديس الأشياء, فيتيشية (الاعتقاد بالقوة السحرية للأشياء المادية (أو عبادة التمائم))",
 "呪的": "سِحْرِيّ",
 "呪符": "تَمِيمَة, أُخْذَة",
 "呪縛": "تَعْوِيذَة / هَجَّى, تَهَجَّى",
 "呪術": "سِحْر (ألقى السحر على شخص أو شيء، بمعنى جعله تحت تأثير السحر؛ أدهش أو أبهر بجمال أو جاذبية غير عادية) / سِحْرِيّ\nمثال: هذا هو سحر الجزائر.",
 "呪術医": "رجل الطب, طبيب ساحر (شامان من الهنود الحمر)",
 "呪術師": "طَبِيب سَاحِر (العالم بالطب)\nمثال: سوف تصبح طبيبة.",
 "呪術的": "سِحْرِيّ",
 "呪言": "تَعْوِيذَة / هَجَّى, تَهَجَّى",
 "呪詛": "لَعْنَة (أي رغبة صريحة في أن تصيب المحن أو أي شكل من أشكال سوء الحظ كيانًا ما، سواء كان شخصًا، أو مكانًا، أو كائنًا) / نِقْمَة / لَعَنَ ((في الدين) طَرَدَهُ اللَّٰهُ مِنْ رَحْمَتِهِ؛ سَبَّ، شَتَمَ) / شَتَمَ, سَبَّ\nمثال: اللعنة حولها ومعرفة",
 "呱々の声をあげる": "وُلِدَ, تَوَلَّدَ (الرجلُ و المرأةُ ومثلهما الانسان: أنجب؛ الرجلُ و المرأةُ وَلَدًا: أنجبه)\nمثال: أعرف ذلك الولد.",
 "呱々の声を上げる": "وُلِدَ, تَوَلَّدَ (الرجلُ و المرأةُ ومثلهما الانسان: أنجب؛ الرجلُ و المرأةُ وَلَدًا: أنجبه)\nمثال: أعرف ذلك الولد.",
 "呱呱の声をあげる": "وُلِدَ, تَوَلَّدَ (الرجلُ و المرأةُ ومثلهما الانسان: أنجب؛ الرجلُ و المرأةُ وَلَدًا: أنجبه)\nمثال: أعرف ذلك الولد.",
 "呱呱の声を上げる": "وُلِدَ, تَوَلَّدَ (الرجلُ و المرأةُ ومثلهما الانسان: أنجب؛ الرجلُ و المرأةُ وَلَدًا: أنجبه)\nمثال: أعرف ذلك الولد.",
 "味": "بَهَار / تميمة الحظ, جالب للحظ (شيء يُعتقد أنه يجلب الحظ السعيد) / جاذبية, سحر (الجاذبية التي تثير الاهتمام أو تسعد أو تحفز) / كوارك ساحر, نكهة السحر ((فيزياء) إحدى نكهات الكوارك الست، وهو الثالث من حيث الكتلة بين جميع الكواركات) / تعويذة, رقى (صيغة لفظية يُعتقد أن لها قوة سحرية)\nمثال: كانت ابتسامته جزءاً من جاذبيته لها / خِبْرَة, تَجْرِبَة (مصدر للفعل خَبَرَ؛ القاعُ يُنبت السِّدْر والأراك) / اِخْتِبَار (اختبر الشّيء:خبره) / خِبْرَة (مصدر للفعل خَبَرَ؛ القاعُ يُنبت السِّدْر والأراك)\nمثال: زيري عنده خبرة. / شَاطِر (بمعنى قطع إلى نصفين متساويين، الجمع شاطرون وشاطرات؛ مَن أعيا أهلهُ خبثًا، ومن هذا القبيل الابن الشّاطر المذكور في الإنجيل. الجمع شُطَّار) / ذَكِيّ (ذَكِيَ: صار شديد الفطنة وسريع البديهة؛ ذكِيَ التلميذ في مهارات الحساب الدهني)\nمثال: إنه وسيم و ذكي. / ذَوْق, طَعْم (الذَّوْقُ : حَاسَّةُ اللِّسَانِ وَبِهَا قُوَّةٌ تُدْرِكُ خَوَاصَّ الأَجْسَامِ الطَّعْمِيَّةَ؛ الذَّوْقُ : آدابُ السلوك التي تقتضي معرفة ما هو لائق أو مناسب في موقف اجتماعيّ معيّن) / ذَوْق (الذَّوْقُ : حَاسَّةُ اللِّسَانِ وَبِهَا قُوَّةٌ تُدْرِكُ خَوَاصَّ الأَجْسَامِ الطَّعْمِيَّةَ؛ الذَّوْقُ : آدابُ السلوك التي تقتضي معرفة ما هو لائق أو مناسب في موقف اجتماعيّ معيّن) / ذَاقَ, تَذَوَّقَ (تناول شيئا من الطعام أو الشراب ليختبر طَعْمَه؛ جَرَّبَ، اِخْتًبَرَ، أَحَسَّ)\nمثال: أكره ذوق الكحول.",
 "味あい": "مذاق, نكهة (تجربة التذوق عند وضع طعام متبل في الفم) / نكهة ((فيزياء) الأنواع الستة للكواركات) / روح, شعور (الجو العام لمكان أو موقف وتأثيره على الناس)\nمثال: أثاره شعور المدينة / مَعْنًى / الْمَعْنَى",
 "味あう": "حَسَبَ الرَغَبَة (عَدَّ مع الجَمْع والطَرْح وغيرها من العمليات الحِسَابية؛ عند أكثر العامة: هو العَدّ مطلقا)\nمثال: حسب سامي المال.",
 "味がする": "حَسَبَ الرَغَبَة (عَدَّ مع الجَمْع والطَرْح وغيرها من العمليات الحِسَابية؛ عند أكثر العامة: هو العَدّ مطلقا)\nمثال: حسب سامي المال.",
 "味がでる": "خَرَجَ (اِنْتَقَلَ إلى خارج المكان) / غَادَرَ (تَرَكَ)\nمثال: خرج سامي ليحتفل.",
 "味が出る": "خَرَجَ (اِنْتَقَلَ إلى خارج المكان) / غَادَرَ (تَرَكَ)\nمثال: خرج سامي ليحتفل.",
 "味たま": "مَسْلُوقٌ بِنِصْفِ نُضْج ((عَنِ البَيْض) لَا يَزَالُ الصَّفَارُ سَائِلًا) / رقيق القلب, طيب القلب (سهل التأثر بالشفقة أو الحزن)\nمثال: قاضٍ رقيق القلب",
 "味たまご": "مَسْلُوقٌ بِنِصْفِ نُضْج ((عَنِ البَيْض) لَا يَزَالُ الصَّفَارُ سَائِلًا) / رقيق القلب, طيب القلب (سهل التأثر بالشفقة أو الحزن)\nمثال: قاضٍ رقيق القلب",
 "味な": "شَاطِر (بمعنى قطع إلى نصفين متساويين، الجمع شاطرون وشاطرات؛ مَن أعيا أهلهُ خبثًا، ومن هذا القبيل الابن الشّاطر المذكور في الإنجيل. الجمع شُطَّار) / ذَكِيّ (ذَكِيَ: صار شديد الفطنة وسريع البديهة؛ ذكِيَ التلميذ في مهارات الحساب الدهني)\nمثال: إنه وسيم و ذكي.",
