 "半過去": "مستمر (زمن للأفعال يُستخدم في وصف حدث مستمر)",
 "半道": "فِي مُنْتَصَف الطَّرِيق (في نصف المسافة؛ في المنتصف)\nمثال: كان في منتصف السلم عندما سقط",
 "半道海豚": "دلفين قاروري الأنف (أي من عدة دلافين ذات جبهة مستديرة ومنقار متطور؛ تعيش بشكل رئيسي في شمال المحيط…)",
 "半金属": "شِبْهُ فِلِزِّيّ (عُنْصُرٌ لَا فِلِزِّيٌّ لَهُ بَعْضُ خَصَائِصِ الفِلِزَّات)",
 "半鐘": "إنذار حريق, كاشف دخان (إنذار ينطلق بسبب الحريق أو الدخان)",
 "半長靴": "جَزْمَة (الأكلة الواحدة ليلا ونهارا؛ هي السُكُون بمعنى علامة الجزم من الحركات)",
 "半間": "أَحْمَق, غَبِيّ (مُغَفَّل، أَبْلَه، طَائِش)\nمثال: قبلني ايها الأحمق.",
 "半陰影": "شِبْه ظِلّ",
 "半陰陽": "خُنْثَى",
 "半面": "مُدَّة\nمثال: جون في عمر أخي. / فِي نَفْس اَلْوَقْت (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي. / حُدُود خَارِجِيَّة / نِصْف, نُصْف"
}
