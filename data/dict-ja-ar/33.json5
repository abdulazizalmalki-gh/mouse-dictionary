 "剛強": "قُوَّة (ضد الضُعْف، الشِدَّة والقُدْرَة الجِسْمَانِيَّة؛ ضد الضُعْف، المَقْدِرَة…)\nمثال: توم شعر بالقوة.",
 "剛性": "شدة, صرامة (صرامة مفرطة)\nمثال: صرامة الشخصية",
 "剛性率": "مُعَامِل الصَّلَابَة, مُعَامِل القَصّ (معامل المرونة لقوة القص)",
 "剛情張": "عِنَاد",
 "剛愎": "عِنَاد",
 "剛毅": "ثبات, جلد (قوة العقل التي تمكن المرء من تحمل المحن بشجاعة)",
 "剛毛": "شعرة خشنة, هلبه (شعرة صلبة)",
 "剛気": "جَرِيء, جَسُور",
 "剛球": "كرة سريعة ((بيسبول) رمية ترمى بأقصى سرعة)\nمثال: تأخر في ضرب الكرة السريعة",
 "剛直": "مُسْتَقِيم (ما جُعِلَ قَائِمًا غير مُنْحَنٍ؛ ما ليس به عِوَج)\nمثال: إرسم خط مستقيم.",
 "剛胆": "جَرِيء, جَسُور",
 "剛腹": "عِنَاد",
 "剝がれ": "تَقْشِير",
 "剝く": "قَشَّرَ / خَالٍ مِنَ الزَّخْرَفَة, سَادَة (يفتقر إلى التزيين أو الزخرفة)",
 "剝れる": "بوز, حرد (مزاج أو إظهار للترفع العبوس أو الانسحاب)\nمثال: بقي في المنزل في حالة حرد / قَشَّرَ",
 "剝奪": "تعرية, كشف (إزالة الغطاء)",
 "剝板": "جبيرة (جهاز ميكانيكي لتقويم العظام يستخدم لتثبيت وحماية جزء من الجسم (مثل الساق…)\nمثال: أشعل النار باستخدام شظية خشبية مشتعلة",
 "剝片": "رُقَاقة, شَظِيَّة صغيرة (شظية صغيرة من شيء انفصلت عن الكل)\nمثال: أصابت عينه شظية صخرية صغيرة",
 "剝皮": "تقشير (إزالة الغطاء الخارجي لعضو أو جزء)",
 "剝落": "تراجع, ركود (تدهور ملحوظ في الأداء أو الجودة)\nمثال: دخل الفريق في حالة ركود",
 "剝離": "فصل, فك الارتباط (عملية التحرير من مرفق أو اتصال) / تَفْرِقَة",
 "剣": "سَيْف, حُسَام (مصدر للفعل سَافَ؛ سِلاح ذو حَدّ واحد طويل يعتبر من الأسْلِحَة البيضاء لأنها…)\nمثال: القلم أقوى من السيف. / حَرْبَة, سُونْكِيّ (آلة للحَرْب تكون قصيرة مُحَدَّدة الرَأس تستخدم للطَعْن. غالبا ما تُرَكَّب على…) / مبارزة, مهارة استخدام السيف (المهارة في المبارزة) / ضربة لاذعة (ضربة حادة مؤلمة)\nمثال: الطعنة الأكثر قسوة على الإطلاق",
 "剣が峰": "حلبة المصارعة (حلبة مربعة يتنافس فيها المصارعون)",
 "剣の道": "مبارزة, مهارة استخدام السيف (المهارة في المبارزة)",
 "剣ケ峰": "حلبة المصارعة (حلبة مربعة يتنافس فيها المصارعون)",
 "剣ヶ峰": "حلبة المصارعة (حلبة مربعة يتنافس فيها المصارعون)",
 "剣匠": "سَيَّاف, سَلَّال",
 "剣名": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "剣呑": "خَطِر (خطر في مشيه: اهتز وتبختر؛ خطر بذنبه: رفعه مرة وخفضه أخرى، أو حركه يمينا وشمالا)\nمثال: أنا ذاهب للخطر.",
 "剣士": "سَيَّاف",
 "剣奴": "مُجَالِد, مُصَارِع",
 "剣山": "ضِفْدِع (مِنْ فَصِيلَةِ الضِّفْدَعِيَّاتِ ، بَرْمَائِيٌّ لاَ ذَنَبَ لَهُ ، رَخْوٌ…)\nمثال: الضفدع في البئر.",
 "剣微塵子": "سَايْكْلُوب",
 "剣戟": "سِلَاح, أَسْلِحَة",
 "剣技": "مبارزة, مهارة استخدام السيف (المهارة في المبارزة)",
 "剣持": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "剣歯虎": "نمر سيفي الأسنان (أي من العديد من القطط المنقرضة في العالم القديم والجديد ذات أنياب علوية طويلة…)",
 "剣法": "مُبَارَزَة",
 "剣状": "سَيْفِيّ الشَّكْل (على شكل نصل السيف)",
 "剣状突起": "زائدة سيفية, ناتئ رهابي (أصغر الأجزاء الثلاثة لعظم القص؛ يتمفصل مع جسم القص والضلع السابع)",
 "剣状軟骨": "زائدة سيفية, ناتئ رهابي (أصغر الأجزاء الثلاثة لعظم القص؛ يتمفصل مع جسم القص والضلع السابع)",
 "剣石": "حجر العقد (حَجَرَ عليه الأمرَ:مَنَعَه منه ، حجر الشّيء على نفسه:خَصَّها به وقصره عليها…)\nمثال: عوقب زيري بالحجر.",
 "剣突": "تَقْرِيع شَدِيد, تَوْبِيخ لَاذِع (توبيخ شديد وقاسٍ)",
 "剣突く": "تَقْرِيع شَدِيد, تَوْبِيخ لَاذِع (توبيخ شديد وقاسٍ)",
 "剣突を食わせる": "ازدراء, تجاهل (رفض التعرف على شخص تعرفه)\nمثال: كان التجاهل متعمداً بوضوح",
 "剣竜": "ستيغوصور (ديناصور عاشب من رتبة طيريات الورك، يتميز بصف من الصفائح العظمية على ظهره وذيل…)",
 "剣筋": "مبارزة, مهارة استخدام السيف (المهارة في المبارزة)",
 "剣舞": "رقصة السيف (أي من الرقصات المختلفة التي يؤديها رجال يخطون برشاقة فوق السيوف أو يلوحون بها…)",
 "剣術": "مُبَارَزَة",
 "剣術使い": "مبارز (شخص ماهر في المبارزة بالسيف)",
 "剣術者": "مبارز (شخص ماهر في المبارزة بالسيف)",
 "剣闘士": "مُجَالِد, مُصَارِع",
 "剣龍": "ستيغوصور (ديناصور عاشب من رتبة طيريات الورك، يتميز بصف من الصفائح العظمية على ظهره وذيل…)",
 "剤": "دَوَاء\nمثال: اختص في طب القلب.",
 "剥がれ": "تَقْشِير",
 "剥き出し": "عُرْيَان, عَارٍ / إِفْرَنْجِيّ",
 "剥き出す": "ثَبَتَ, وَضَحَ (اسْتَقَرَّ ودَامَ ولم يتحرك برغم المغريات أو الدوافع؛ الأمر: تَحَقَّقَ…)\nمثال: ثبت مناد مكانه.",
 "剥く": "قَشَّرَ / خَالٍ مِنَ الزَّخْرَفَة, سَادَة (يفتقر إلى التزيين أو الزخرفة)",
 "剥ぐ": "أَفْقَدَ",
 "剥げる": "اختفاء, تلاشٍ (التوقف التدريجي عن الظهور)\nمثال: أخذ دروساً لعلاج ضرباته المقوسة",
 "剥れる": "بوز, حرد (مزاج أو إظهار للترفع العبوس أو الانسحاب)\nمثال: بقي في المنزل في حالة حرد / قَشَّرَ",
 "剥奪": "تعرية, كشف (إزالة الغطاء)",
 "剥板": "جبيرة (جهاز ميكانيكي لتقويم العظام يستخدم لتثبيت وحماية جزء من الجسم (مثل الساق…)\nمثال: أشعل النار باستخدام شظية خشبية مشتعلة",
 "剥片": "رُقَاقة, شَظِيَّة صغيرة (شظية صغيرة من شيء انفصلت عن الكل)\nمثال: أصابت عينه شظية صخرية صغيرة",
 "剥皮": "تقشير (إزالة الغطاء الخارجي لعضو أو جزء)",
 "剥脱性皮膚炎": "احمرار الجلد (أي اضطراب جلدي ينطوي على احمرار غير طبيعي)",
 "剥落": "تراجع, ركود (تدهور ملحوظ في الأداء أو الجودة)\nمثال: دخل الفريق في حالة ركود",
 "剥製": "حشو (حشوة توضع في المراتب والوسائد والأثاث المنجد)",
 "剥製術": "تحنيط (فن تركيب جلود الحيوانات بحيث يكون لها مظهر نابض بالحياة)",
 "剥離": "فصل, فك الارتباط (عملية التحرير من مرفق أو اتصال) / تَفْرِقَة",
 "剪み切る": "قصاصة, قُصاصة (عملية القص أو القصقصة)",
 "剪む": "مِشْبَك",
 "剪る": "جَرَحَ (كَلَمَ، شَقَّ اللَحْم وأسَالَ الدَمّ؛ صَادَ أو اكْتَسَبَ)\nمثال: ذلك سيهيج الجرح.",
 "剪刀": "مِقَصّ, مِقْرَاض",
 "剪定": "تقليم (عملية تشذيب النبات)",
 "剪定ばさみ": "مقص تقليم, مقص شجر (مقص بشفرات قوية يستخدم للتقليم الخفيف للنباتات الخشبية)",
 "剪定器": "مقص تقليم, مِنجل تقليم (منشار تقليم طويل المقبض بشفرة منحنية في النهاية وأحياناً مقص؛ يستخدم لتقليم…)\nمثال: لم يمسها فأس مقلّم الأشجار",
 "剪定鋏": "مقص تقليم, مقص شجر (مقص بشفرات قوية يستخدم للتقليم الخفيف للنباتات الخشبية)",
 "剪断": "جَزَّ, قَصَّ (جَزَّ النخلُ ونحوُه يَجُزُّ جَزًّا: حان أَن يُقطَعَ ثَمَرُهُ؛ جَزَّ النَّخلَةَ…)\nمثال: طلبت من توم جز عشبنا.",
 "剪断機": "جَزّاز, قاص الصوف (عامل ماهر يقوم بجز الصوف عن الأغنام أو الحيوانات الأخرى)",
 "剪枝": "تقليم (عملية تشذيب النبات)",
 "剪裁": "قص, قطع (عملية تقصير شيء ما بقطع أطرافه)\nمثال: أعطاه الحلاق قصة جيدة",
 "剪除": "قص, قطع (عملية تقصير شيء ما بقطع أطرافه)\nمثال: أعطاه الحلاق قصة جيدة",
 "副": "مُسَاعِد, مُسَاعِدَة (مُعَاوِن، مُسَانِد، من يقوم بالمُسَاعَدَة؛ بمعنى مُفِيد، يقال هذا عامل مساعد…)\nمثال: علي مساعدة ماري. / تَوْأَمِيّ, مُتَمَاثِل (يكون اثنين متطابقين)\nمثال: صنع نسخة للملفات / ظَرْف (ظَرْف: اسم؛ ظَرْف الشيء وعاءه. الجمع ظُرُوف؛ ظَرْف: اسم؛ كيس من الورق توضع فيه…)\nمثال: أغلقت ذلك الظرف.",
 "副う": "لَاقَى, لَقِيَ (لَقِيَ، صَادَفَ)\nمثال: لقد التقى بماري. / رَافَقَ\nمثال: من صاحب هذه الأرض؟ / تَزَوَّجَ\nمثال: زوجة ماري طبيبة.",
 "副え木": "جبيرة (جهاز ميكانيكي لتقويم العظام يستخدم لتثبيت وحماية جزء من الجسم (مثل الساق…)\nمثال: أشعل النار باستخدام شظية خشبية مشتعلة / وصلة تراكبية (وصلة تصنع عن طريق تداخل طرفين وربطهما معاً)\nمثال: كان الانقطاع بسبب وصلة غير متقنة",
 "副プログラム": "إجراء, دالة (تسلسل محدد من الخطوات، جزء من برنامج حاسوبي أكبر)",
 "副主席": "نَائِب رَئِيس, نَائِبَةُ رَئِيسَة",
 "副交感神経系": "الجهاز العصبي الباراسمبثاوي, الجهاز العصبي اللاودي (ينشأ في جذع الدماغ والجزء السفلي من الحبل الشوكي؛ يعارض التأثيرات الفسيولوجية…)",
 "副会長": "نَائِب رَئِيس, نَائِبَةُ رَئِيسَة",
 "副作用": "أَثَر جَانِبِيّ (عَلَامَة؛ بَقِيَّة؛ رَسْم مُتَخَلَّف من شيء ما؛ تأثير؛ انطباع)\nمثال: اختفى فلم ير له أثر.",
 "副反応": "أَثَر جَانِبِيّ (عَلَامَة؛ بَقِيَّة؛ رَسْم مُتَخَلَّف من شيء ما؛ تأثير؛ انطباع)\nمثال: اختفى فلم ير له أثر.",
 "副大統領": "نَائِب رَئِيس, نَائِبَةُ رَئِيسَة",
 "副大統領候補": "نائب رئاسي (يتعلق بنائب الرئيس أو بمنصب نائب الرئيس)\nمثال: مناظرات نواب الرئيس",
 "副子": "جبيرة (جهاز ميكانيكي لتقويم العظام يستخدم لتثبيت وحماية جزء من الجسم (مثل الساق…)\nمثال: أشعل النار باستخدام شظية خشبية مشتعلة",
 "副官": "لقلق مساعد (لقلق هندي كبير ذو مشية عسكرية)",
 "副審": "حكم مساعد, مراقب الخط (حكم (في التنس، كرة القدم، إلخ) يساعد الحكم الرئيسي بطريقة ما (خاصة بمراقبة خروج…)",
 "副専攻": "صَغِير, مَحْدُود النِّطَاق (صَغير الحَجْم أَوْ مَحْدود في النِّطاق أَوْ الأَهَمِّيَّة)\nمثال: حصة صغيرة من الأرباح",
 "副将": "الرجل الثاني, نائب القائد (شخص يحل محل القائد)",
 "副将軍": "فريق (الطَائِفَة من الشيء المتفرق؛ الطَائِفَة من الناس، وهي أكثر من الفِرْقَة)\nمثال: لدينا فريق جيد.",
 "副尺": "مقياس ورني, ورنية (مقياس صغير متحرك ينزلق على طول مقياس رئيسي؛ المقياس الصغير معاير للإشارة إلى…)",
 "副弐": "ثَانَوِي (الثانويّ : المَنْسوب إلى الثاني ما يجيء بعدَ الأَوَّل؛ ما ليس له الأَهمّيَّة…)\nمثال: ثانوية زيري ضخمة.",
 "副手": "مُسَاعِد, مُسَاعِدَة (مُعَاوِن، مُسَانِد، من يقوم بالمُسَاعَدَة؛ بمعنى مُفِيد، يقال هذا عامل مساعد…)\nمثال: علي مساعدة ماري.",
 "副操縦士": "مساعد طيار (طيار مساعد على متن طائرة)",
 "副文": "إضافة, ملحق (مادة نصية تضاف إلى منشور؛ عادة في النهاية) / جملة تابعة, جملة ثانوية (جملة في جملة معقدة لا يمكن أن تقف وحدها كجملة كاملة وتعمل داخل الجملة كاسم أو…)",
 "副書": "نُسْخَة",
 "副木": "جبيرة (جهاز ميكانيكي لتقويم العظام يستخدم لتثبيت وحماية جزء من الجسم (مثل الساق…)\nمثال: أشعل النار باستخدام شظية خشبية مشتعلة",
 "副本": "تَوْأَمِيّ, مُتَمَاثِل (يكون اثنين متطابقين)\nمثال: صنع نسخة للملفات",
 "副業": "هواية (نشاط إضافي أو جانبي)",
 "副次文化": "ثقافة فرعية (مجموعة اجتماعية داخل ثقافة وطنية لها أنماط مميزة من السلوك والمعتقدات)",
 "副次的": "ثَانَوِي (الثانويّ : المَنْسوب إلى الثاني ما يجيء بعدَ الأَوَّل؛ ما ليس له الأَهمّيَّة…)\nمثال: ثانوية زيري ضخمة.",
 "副牧師": "راعي, قس (شخص مخول لإقامة الشعائر الدينية)\nمثال: يُطلق عادة على رجال الدين لقب قسيس في الكنائس البروتستانتية",
 "副王": "نَائِب",
 "副生": "منتج ثانوي (منتج تم صنعه أثناء تصنيع شيء آخر)",
 "副生成物": "منتج ثانوي (منتج تم صنعه أثناء تصنيع شيء آخر)",
 "副生物": "منتج ثانوي (منتج تم صنعه أثناء تصنيع شيء آخر)",
 "副産物": "منتج ثانوي (منتج تم صنعه أثناء تصنيع شيء آخر)",
 "副甲状腺": "غدة جار درقية, غدة جارات الدرقية (أي واحدة من أربع غدد صماء تقع فوق أو داخل الغدة الدرقية)",
 "副甲状腺ホルモン": "باراثورمون, هرمون الغدة الجار درقية (هرمون يتم تصنيعه وإطلاقه في مجرى الدم بواسطة الغدد الجار درقية؛ ينظم الفوسفور…)",
 "副甲状腺機能亢進症": "فرط نشاط جارات الدرقية (إفراز مفرط لهرمون الغدة الجار درقية يؤدي إلى مستويات عالية غير طبيعية من…)",
 "副甲状腺機能低下症": "قصور الدريقية, قصور جارات الدرقية (إفراز غير كافٍ لهرمون الغدة الجار درقية يؤدي إلى مستويات منخفضة غير طبيعية من…)",
