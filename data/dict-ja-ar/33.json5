 "執心": "تَفَرُّغ / معشوق, مفتون به (موضوع لشغف مفرط وقصير الأمد) / افتتان, ولع (شغف أو حب أو إعجاب أحمق وعادة ما يكون مفرطاً) / إعجاب عابر, حب المراهقة (حب مؤقت لمراهق)",
 "執念": "إصرار, دأب (تصميم مستمر)",
 "執念い": "عَنِيد",
 "執念深い": "مُتَمَاسِك (ملتصق ببعضه ومتماسك) / حافظ, قوي الذاكرة (جيد في التذكر) / عَنُود, مُثَابِر (ثابت بإصرار لا يلين ولا يتراجع)\nمثال: عقل حافظ",
 "執拗": "حَثِيث, دَائِم (لَا يَتَوَقَّفُ أَبَدًا) / مُلَازِمٌ لِلذِّهْن, مُلِحّ (يَعُودُ إِلَى الذِّهْنِ بِاسْتِمْرَارٍ) / دائم, مستديم (باقٍ؛ لا يسقط) / عَنُود, مُثَابِر (ثابت بإصرار لا يلين ولا يتراجع)\nمثال: الأوراق المستديمة تبقى ملتصقة بعد النضج",
 "執拗い": "مُتَكَرِّر, مُلِحّ (يَتَكَرَّرُ بِإِلْحَاحٍ وَمُثَابَرَة) / مُتَطَلِّب, مُلِحّ (يَسْتَدْعِي الانْتِبَاهَ فَوْرًا) / دسم, دهني (يحتوي على أو يتكون من الدهون) / بدين, سمين (شخص مستدير الجسم)\nمثال: طعام دسم",
 "執政": "إِدَارَة, مُرَاقَبَة (هو عملية تولي تَصْرِيف شؤون العَمَل. لا جمع له؛ مجموع الناس الذين يقومون بإدارة شؤون الجهة، حكومية كانت أم خاصة) / إِدَارَة تَنْفِيذِيَّة (هو عملية تولي تَصْرِيف شؤون العَمَل. لا جمع له؛ مجموع الناس الذين يقومون بإدارة شؤون الجهة، حكومية كانت أم خاصة)\nمثال: والدتي تنتظرني في الإدارة. / قُنْصُل",
 "執政官": "قُنْصُل",
 "執着": "مَوَدَّة / مُلْحَق / مُرْفَق (مَا يُتَّكَأُ عَلَيْهِ)\nمثال: يؤلمني ذراعي من الكتف إلى المرفق.",
 "執着心": "مَوَدَّة / مُلْحَق / مُرْفَق (مَا يُتَّكَأُ عَلَيْهِ)\nمثال: يؤلمني ذراعي من الكتف إلى المرفق.",
 "執筆": "كِتَابَة (الخَطّ أو ما كُتِبَ؛ ما يُكْتَبُ عموما) / كتبة (الكِتْبَةُ : الحالةُ؛ الكِتْبَةُ :الإكتتاب في الفَرْض والرزق)\nمثال: تعبت من الكتابة.",
 "執筆者": "كَاتِب, كَاتِبَة (كَتَبَ رِسَالَة أو مَكْتُوْب لأحد وهذا الآخر يكتب له؛ راسل؛ كَتَبَ عقدا مع أحد؛ عاقد)\nمثال: لست بذاك الكاتب.",
 "執行": "تَنْفِيذ / إِعْدَام (في القانون: هي عقوبة يحددها القضاء على جريمة كبرى اقترفها المتهم وتؤدي إلى قتل المتهم غالبا بالشنق)\nمثال: محكم عليه بالإعدام.",
 "執行人": "مُنْجِز, مُنَفِّذ / وَصِيّ, وَلِيّ (في : في حال وفاة أحد الوالدين، يتم تعيين الوصي بالإتفاق أو بموجب القانون ليكون مسؤولا عن قاصر أو عن إنسان عاجز غير كفء…؛ في : المؤسسة أو الشخص الذي تَثِقُ فيه وَتُأَمِّنُهُ على أموالك وممتلكاتك، وهو الذي يدير أموال الوصية بعد الوفاة)\nمثال: مات من دون أن يترك وصية.",
 "執行吏": "مَأْمُور",
 "執行官": "شَرِيف",
 "執行役": "ضابط تنفيذي, نائب القائد (الضابط الثاني في القيادة)",
 "執行猶予": "وقف تنفيذ الحكم (أمر يمنع تنفيذ الحكم لفترة زمنية محددة)",
 "執行者": "مُنْجِز, مُنَفِّذ / وَصِيّ, وَلِيّ (في : في حال وفاة أحد الوالدين، يتم تعيين الوصي بالإتفاق أو بموجب القانون ليكون مسؤولا عن قاصر أو عن إنسان عاجز غير كفء…؛ في : المؤسسة أو الشخص الذي تَثِقُ فيه وَتُأَمِّنُهُ على أموالك وممتلكاتك، وهو الذي يدير أموال الوصية بعد الوفاة)\nمثال: مات من دون أن يترك وصية. / إِجْرَائِيّ",
 "執行部": "إِجْرَائِيّ",
 "執達吏": "مَأْمُور",
 "培う": "بِالاِحْتِضَان, بِالكَفَالَة (يَتِمّ رِعايَتُه دونَ أَن يَكونَ ابْنًا بِيُولوجِيًّا)",
 "培地": "وسط استنبات, وسط زرع ((علم الجراثيم) مادة مغذية (صلبة أو سائلة) تستخدم لزراعة الكائنات الحية الدقيقة)",
 "培植": "تَهْذِيب",
 "培殖": "تَهْذِيب",
 "培養": "ثَقَافَة (بمعنى صار حَاذقا فطنا؛ المعرفة الواسعة والإطلاع على الكثير من المعلومات)\nمثال: توم لا يهتم بالثقافة. / تَهْذِيب",
 "培養土": "دبال, سماد عضوي (خليط من النباتات المتحللة والروث؛ يستخدم كسماد)",
 "培養基": "مُتَوَسِّط",
 "培養士": "أخصائي علم الأجنة (طبيب متخصص في علم الأجنة)",
 "培養液": "مَرَق, مَرَقَة (الطَعَام سائل الخفيف فيه ماء اللحم وقد يكون فيه خضار أو غير ذلك. يؤكل عادة مع الرز أو الخبز. يجوز قول مَرَقَة، وهي أخص من المرَق)",
 "基": "مَنْشَأ / مَنْبَع, مَنْشَأ / اَصْل / قَاعِدَة, أَسَاس / قَضِيَّة (الأمر أو الشيء المُعَقَّد؛ في : ما يقضي فيه القاضي) / سَبَّبَ ((سَبَّبَه): أَكثر سَبَّه؛ (سَبَّبَ) الأسبَاب: أوجدها)\nمثال: سأرفع عليك قضية. / مَادِّيّ / مَادَّة (مؤنث مَادّ، اسم فاعل من مَدَّ. الجمع مَادَّات؛ ما كان مَدَدًا لغيره)\nمثال: لا أحب مادة العلوم. / مَجْمُوعَة, جَمَاعَة (مؤنث مَجْمُوع وهو اسم مفعول من جَمَعَ؛ الطَائِفَة أو الجَمَاعَة من الناس)\nمثال: شكرا لإضافتي للمجموعة. / جَذْريّ / رَادِيكَالِيّ",
 "基く": "جَاءَ (أَتَى؛ حَدَثَ) / أَتَى (جَاءَ؛ فَعَلَ الأمرَ) / جا / جه\nمثال: تقريبا الكل جاء",
 "基づく": "جَاءَ (أَتَى؛ حَدَثَ) / أَتَى (جَاءَ؛ فَعَلَ الأمرَ) / جا / جه\nمثال: تقريبا الكل جاء",
 "基体": "قَاعِدَة / قَاعِدَة, مَرْكَز / يُبْنَى عَلَى, يَسْتَنِدُ إِلَى / شائع / منخفض, فاسق / دنيء / ركيزة لغوية, لغة تحتية (لغة أصلية تساهم بخصائص في لغة شعب غازٍ يفرض لغته على السكان الأصليين) / طبقة تحتية, طبقة سفلية (أي طبقة تقع تحت أخرى) / ركيزة, طبقة تحتية (سطح ينمو عليه كائن حي أو يلتصق به)\nمثال: اللغات السلتية في بريطانيا هي ركيزة للغة الإنجليزية",
 "基剤": "قَاعِدَة / قَاعِدَة, مَرْكَز / يُبْنَى عَلَى, يَسْتَنِدُ إِلَى / شائع / منخفض, فاسق / دنيء",
 "基原": "مُقَوِّم",
 "基地": "قَاعِدَة / قَاعِدَة, مَرْكَز / يُبْنَى عَلَى, يَسْتَنِدُ إِلَى / شائع / منخفض, فاسق / دنيء / متحمس, نصير (مؤيد قوي ومتحمس لشخص أو نشاط ما) / مولع, هاوٍ (شخص لديه إعجاب قوي بشيء ما)",
 "基壇": "إِنْشاء, إِشَادَة (مصدر للفعل \"أَنْشَأَ\") / أَسَاس, قَاعِدَة (مبدأ عام تعتمد عليه طائفة من الظواهر أو القضايا؛ مُرتكز البناء وقاعدته) / مُؤَسَّسَة / أَسَاس (مبدأ عام تعتمد عليه طائفة من الظواهر أو القضايا؛ مُرتكز البناء وقاعدته)\nمثال: إنشاء موقع إلكتروني بدون أي تكلفة؟",
 "基層": "ركيزة لغوية, لغة تحتية (لغة أصلية تساهم بخصائص في لغة شعب غازٍ يفرض لغته على السكان الأصليين) / طبقة تحتية, طبقة سفلية (أي طبقة تقع تحت أخرى) / ركيزة, طبقة تحتية (سطح ينمو عليه كائن حي أو يلتصق به)\nمثال: اللغات السلتية في بريطانيا هي ركيزة للغة الإنجليزية",
 "基層語": "ركيزة لغوية, لغة تحتية (لغة أصلية تساهم بخصائص في لغة شعب غازٍ يفرض لغته على السكان الأصليين) / طبقة تحتية, طبقة سفلية (أي طبقة تقع تحت أخرى) / ركيزة, طبقة تحتية (سطح ينمو عليه كائن حي أو يلتصق به)\nمثال: اللغات السلتية في بريطانيا هي ركيزة للغة الإنجليزية",
 "基幹": "الحبل الرئيسي للسارية (الحبل الأمامي الذي يثبت الصاري الرئيسي) / دعامة أساسية, ركيزة (مصدر دعم واستقرار مركزي ومتماسك) / دعامة, ركن أساسي (مؤيد بارز)\nمثال: الإيمان هو ركيزته",
 "基底": "قَاعِدَة / قَاعِدَة, مَرْكَز / يُبْنَى عَلَى, يَسْتَنِدُ إِلَى / شائع / منخفض, فاسق / دنيء / قَاعِدَة, أَسَاس",
