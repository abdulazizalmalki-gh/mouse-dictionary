 "刈り立て": "مَحْشُوش حَدِيثًا, مَقْصُوص تَوًّا (تم حشه أو قصه مؤخرًا)",
 "刈り葺く": "سقف معروش, سقف من القش (سقف منزل مصنوع من مادة نباتية (كالقش)) / جُمَّة, شَعْر كَثّ (شعر يشبه مواد التسقيف بالقش) / قش (سيقان نباتات تستخدم كمادة تسقيف)",
 "刈り込み": "حَلَاقَة",
 "刈り込む": "أَجَاص / عَوِينَة / عَوِينَة مُجَفَّفَة / خَوْخ مُجَفَّف / شَذَبَ, قَضَبَ / حِصَاد / مَحْصُول, غَلَّة / حَصَدَ (قَطَعَ الزَّرْعَ وغيره من النبات بالمِنْجَل أو آلة الحصاد)\nمثال: حصد الفلاح القمح.",
 "刈る": "جَرَحَ (كَلَمَ، شَقَّ اللَحْم وأسَالَ الدَمّ؛ صَادَ أو اكْتَسَبَ) / قَصَّ\nمثال: ذلك سيهيج الجرح.",
 "刈入": "حِصَاد / مَحْصُول, غَلَّة / حَصَدَ (قَطَعَ الزَّرْعَ وغيره من النبات بالمِنْجَل أو آلة الحصاد)\nمثال: حصد الفلاح القمح.",
 "刈入れ": "حِصَاد / مَحْصُول, غَلَّة / حَصَدَ (قَطَعَ الزَّرْعَ وغيره من النبات بالمِنْجَل أو آلة الحصاد)\nمثال: حصد الفلاح القمح.",
 "刈入れる": "حِصَاد / مَحْصُول, غَلَّة / حَصَدَ (قَطَعَ الزَّرْعَ وغيره من النبات بالمِنْجَل أو آلة الحصاد)\nمثال: حصد الفلاح القمح.",
 "刈取る": "جَزَّ (جَزَّ النخلُ ونحوُه يَجُزُّ جَزًّا: حان أَن يُقطَعَ ثَمَرُهُ؛ جَزَّ النَّخلَةَ جَزًّا، وجِزَازاً: قَطعَ ثمَرَها)\nمثال: طلبت من توم جز عشبنا.",
 "刈払い": "عُشْبَة ضَارَّة / بانْجو, حَشيش",
 "刈込む": "أَجَاص / عَوِينَة / عَوِينَة مُجَفَّفَة / خَوْخ مُجَفَّف / شَذَبَ, قَضَبَ / حِصَاد / مَحْصُول, غَلَّة / حَصَدَ (قَطَعَ الزَّرْعَ وغيره من النبات بالمِنْجَل أو آلة الحصاد)\nمثال: حصد الفلاح القمح.",
 "刈除": "تنحية, عزل (الفصل من منصب رسمي) / إزالة, نزع (عملية الإزالة)\nمثال: أجرى عملية جراحية لإزالة ورم خبيث",
 "刊": "نَشْر (بَسَطَ، فَرَّقَ، نَشَرَ الشيءَ: جعله منتشراً، مثل نشر الأخبار أو نشر كتاب؛ نَشَرَ: وزع أو عمم شيئًا بين الناس، مثل نشر المقالات) / مَنْشُور\nمثال: نشر توم الغسيل.",
 "刊行": "نَشْر (بَسَطَ، فَرَّقَ، نَشَرَ الشيءَ: جعله منتشراً، مثل نشر الأخبار أو نشر كتاب؛ نَشَرَ: وزع أو عمم شيئًا بين الناس، مثل نشر المقالات) / مَنْشُور\nمثال: نشر توم الغسيل.",
 "刊行物": "نَشْر (بَسَطَ، فَرَّقَ، نَشَرَ الشيءَ: جعله منتشراً، مثل نشر الأخبار أو نشر كتاب؛ نَشَرَ: وزع أو عمم شيئًا بين الناس، مثل نشر المقالات) / مَنْشُور\nمثال: نشر توم الغسيل.",
 "刊記": "علامة الناشر, كولوفون (شعار الناشر المطبوع في كتاب (عادة في صفحة العنوان))",
 "刎ねる": "قَطَعَ (قطع الشيء : جزه؛ قطع الشيء : فصل بعضه عن بعضه الآخر)\nمثال: قطع زيري العشب.",
 "刎頚": "قَطْعُ الرَّأَس (قطع الشيء : جزه؛ قطع الشيء : فصل بعضه عن بعضه الآخر)\nمثال: قطع زيري العشب.",
 "刎頸": "قَطْعُ الرَّأَس (قطع الشيء : جزه؛ قطع الشيء : فصل بعضه عن بعضه الآخر)\nمثال: قطع زيري العشب.",
 "刑": "جَزَاء",
 "刑す": "عَاقَبَ, قَاصَصَ",
 "刑する": "عَاقَبَ, قَاصَصَ",
 "刑に処する": "حُكْم (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ) / جُمْلَة (مؤنث جُمْل، وهو الحبل الغليظ أو الجماعة من الناس؛ المَجْمُوع) / حَكَمَ, أَدَانَ (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ)\nمثال: حكم علي بالموت.",
 "刑の量定": "حُكْم (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ) / جُمْلَة (مؤنث جُمْل، وهو الحبل الغليظ أو الجماعة من الناس؛ المَجْمُوع) / حَكَمَ, أَدَانَ (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ)\nمثال: حكم علي بالموت.",
 "刑事": "مُحَقِّق (من يُجري تحقيق وتحرِّيات للكشف عن ملابسات قضيَّة غامضة؛ قَاضِي التَّحْقِيقِ الَّذِي يُحَقِّقُ مَعَ الْمُتَّهَمِ فِي قَضِيَّةٍ لِلْكَشْفِ عَنْ مَجْرَيَاتِهَا)\nمثال: تحدث ياني مع محقق.",
 "刑事上": "جَزَائِيّ, عِقَابِيّ",
 "刑事法院": "محكمة جنائية (محكمة لها اختصاص في القضايا الجنائية)",
 "刑事犯": "جريمة, جناية ((القانون الجنائي) فعل يعاقب عليه القانون؛ عادة ما يعتبر فعلاً شريراً)\nمثال: سجل طويل من الجرائم",
 "刑事被告": "مُتَّهَم, مُتَّهَمَة",
 "刑事被告人": "مُتَّهَم, مُتَّهَمَة",
 "刑事訴追": "محاكمة جناية, ملاحقة قضائية (بدء وإجراء الإجراءات القانونية ضد مدعى عليه لسلوك إجرامي)",
 "刑余": "خَصِيّ, مَخْصِيّ",
 "刑典": "قانون جنائي (مجموعة القوانين التي تتعامل مع الجرائم وعقوباتها)",
 "刑務官": "حارِس سِجْن, سَجَّان (شخص يحرس السجناء)",
 "刑務所": "سِجْن (وضع شخصًا أو شيئًا في السجن أو الحبس؛ قيّد حرية شخص أو حركة شيء)\nمثال: دخل سامي السجن.",
 "刑吏": "جَلَّاد",
 "刑律": "قانون جنائي (مجموعة القوانين التي تتعامل مع الجرائم وعقوباتها)",
 "刑徒": "سَجِين, سَجِينَة",
 "刑戮": "عِقَاب, جَزَاء (طَيْر من الجَوَارِح، أكبر التي تصيد منها يكنى بأبي الهَيْثَم ومعروف بحِدَّة البصر؛ حَجَر ناتئ في جَوْف البِئْر يخرق الدَلُو. ونادر) / عُقُوبَة / عِقَاب (طَيْر من الجَوَارِح، أكبر التي تصيد منها يكنى بأبي الهَيْثَم ومعروف بحِدَّة البصر؛ حَجَر ناتئ في جَوْف البِئْر يخرق الدَلُو. ونادر)\nمثال: هو من تلقى العقاب الأكبر.",
 "刑期": "فترة سجن, محكومية (الفترة الزمنية التي يسجن فيها السجين)\nمثال: قضى فترة سجن مدتها 15 شهراً",
 "刑死": "تَنْفِيذ / إِعْدَام (في القانون: هي عقوبة يحددها القضاء على جريمة كبرى اقترفها المتهم وتؤدي إلى قتل المتهم غالبا بالشنق)\nمثال: محكم عليه بالإعدام.",
 "刑法": "قانون جنائي (مجموعة القوانين التي تتعامل مع الجرائم وعقوباتها)",
 "刑法典": "قَانُون جِنَائِيّ (مقياس كل شيء وطريقه؛ أمر كليّ ينطبق على جميع جزئياته التي تعرف أحكامها منه)\nمثال: ذكرني بالقانون.",
 "刑法犯": "جريمة, جناية ((القانون الجنائي) فعل يعاقب عليه القانون؛ عادة ما يعتبر فعلاً شريراً)\nمثال: سجل طويل من الجرائم",
 "刑獄": "سِجْن, حَبْس (وضع شخصًا أو شيئًا في السجن أو الحبس؛ قيّد حرية شخص أو حركة شيء)\nمثال: دخل سامي السجن.",
 "刑罰": "عِقَاب, جَزَاء (طَيْر من الجَوَارِح، أكبر التي تصيد منها يكنى بأبي الهَيْثَم ومعروف بحِدَّة البصر؛ حَجَر ناتئ في جَوْف البِئْر يخرق الدَلُو. ونادر) / عُقُوبَة / عِقَاب (طَيْر من الجَوَارِح، أكبر التي تصيد منها يكنى بأبي الهَيْثَم ومعروف بحِدَّة البصر؛ حَجَر ناتئ في جَوْف البِئْر يخرق الدَلُو. ونادر)\nمثال: هو من تلقى العقاب الأكبر.",
 "刖": "قص, قطع (عملية تقصير شيء ما بقطع أطرافه) / استئصال, بتر (عملية قطع شيء ما)\nمثال: أعطاه الحلاق قصة جيدة",
 "列": "صَفّ (سَطْر مستقيم؛ مستوى تعليمي) / جَدَّفَ (معنى الفعل في سياقات متعددة تتراوح بين الطيران والسير، وحتى في الدلالات المجازية كالرمي والقطع؛ الفعل له معانٍ متعددة: رمي (كالسماء بالبرد)، الإسراع في المشي، كفر بالنعم وعدم الرضا بها، ودفع السفينة بالمجاديف) / تَجْدِيف\nمثال: صف كليتي وقلبي‎. / مَجْمُوعَة, جَمَاعَة (مؤنث مَجْمُوع وهو اسم مفعول من جَمَعَ؛ الطَائِفَة أو الجَمَاعَة من الناس)\nمثال: شكرا لإضافتي للمجموعة. / مُتَتَالِيَة, مُتَوَالِيَة / سِلْسِلَة, مَجْمُوعَة / مُسَلْسَلَات تِلِفِزْيُونِيَّة, مُسَلْسِلَات / مُتَسَلْسِلَة, سِلْسِلَة",
 "列する": "حَضَرَ (حضر: الحُضورُ: نَقِيضُ المَغيب والغَيْبةِ؛ حَضَرَ يَحْضُرُ حُضُورًا وحِضَارَةً؛ ويُعَدَّى فَيُقَالُ: حَضَرَه وحَضِرَه؛ حَضَرَ، كنَصَرَ وعلِمَ، حُضُورًا وحضارَةً: ضِدُّ غابَ)\nمثال: حضر كل شيئ لرحلتي.",
 "列ねる": "جَمَعَ (ضَمَّ، لَمَّ، حَشَدَ؛ في : أَضَافَ أعدادا إلى غيرها) / أَضَافَ\nمثال: جمع خيل هو خيول. / وَصْلَة",
 "列伝": "حَيِيَ, عَاشَ / يَنْجُو / حَيّ (ضد المَيِّت، على قيد الحَيَاة؛ جمع حَيَاء) / مُباشِر\nمثال: ينبح كلب في الحي.",
 "列品": "مَعْرُوض",
 "列国": "دَوْلَة, وَطَن (بَلَد يتميز بحُدُود معروفة وشَعْب وحُكُومَة ومُؤَسَسَات مُنَظَّمَة؛ مجموعة من الناس مستقلين متحدين معا لتكوين مجتمع لحماية حقوقهم و وضع قوانينهم الخاصة)\nمثال: لبنان دولة صغيرة.",
