 "半ば": "مُنْتَصَف, وَسَط / وَسَط, مُتَوَسْط / نِصْف, نُصْف / إلى حد كبير, بشكل رئيسي (في جزء كبير؛ بشكل رئيسي أو أساسي) / بشكل عام, في الغالب (عادة؛ كقاعدة)\nمثال: هذه الحسابات غير نشطة إلى حد كبير",
 "半ぺら": "بِنِصْف الحَجْم (نصف الحجم المعتاد أو العادي)",
 "半クラ": "دواسة الدبرياج, دواسة القابض (دواسة أو رافعة تعشق أو تفصل عمود الدوران وآلية القيادة)\nمثال: حرر القابض بسلاسة بقدم واحدة وداس على دواسة الوقود بالقدم الأخرى",
 "半クラッチ": "دواسة الدبرياج, دواسة القابض (دواسة أو رافعة تعشق أو تفصل عمود الدوران وآلية القيادة)\nمثال: حرر القابض بسلاسة بقدم واحدة وداس على دواسة الوقود بالقدم الأخرى",
 "半ズボン": "شُورْت",
 "半ダース": "سِتَّة (يَدُلُّ عَلَى العَدَد 6)",
 "半ドン": "نصف يوم عطلة (يوم يكون نصفه خالياً من العمل أو الواجب)",
 "半パン": "شُورْت",
 "半乾燥": "شِبْه قَاحِل (قاحل إلى حدٍّ ما)",
 "半人": "عَدِيمُ الْفَائِدَةِ (عديم: فقير؛ عديم: أحمق، غبي)\nمثال: كن عديم الرحمة.",
 "半人前": "عديم الخبرة, غشيم (يفتقر إلى الخبرة العملية أو التدريب)",
 "半人足": "عَدِيمُ الْفَائِدَةِ (عديم: فقير؛ عديم: أحمق، غبي)\nمثال: كن عديم الرحمة.",
 "半休": "نصف يوم عطلة (يوم يكون نصفه خالياً من العمل أو الواجب)",
 "半信半疑": "مَشْكُوك فِيه, مُرْتَاب (مليء بالشكّ وعدم اليقين) / شَاكّ, غَيْر مُقْتَنِع (ليس على اقتناع أو يقين) / مَشْبُوه, مَشْكُوكٌ فِيه (يثير الشكّ أو الريبة)",
 "半値": "بنصف السعر (مقابل نصف السعر)",
 "半光沢": "نصف لامع (طلاء يجف بلمسة نهائية بين اللامعة وغير اللامعة)",
 "半円": "نصف دائرة (شكل مستوٍ له شكل نصف دائرة)",
 "半円アーチ": "قوس روماني, قوس نصف دائري (قوس مستدير مرسوم من مركز واحد)",
 "半円形": "نِصْف دَائِرِيّ (منحنٍ على شكل نصف دائرة)",
 "半分": "نِصْف, نُصْف",
 "半切": "بِنِصْف الحَجْم (نصف الحجم المعتاد أو العادي) / مُسَطَّح القَاع (ذو قاع مُسَطَّح ومُسْتَوٍ)",
 "半切り": "مُسَطَّح القَاع (ذو قاع مُسَطَّح ومُسْتَوٍ)",
 "半切符": "بنصف السعر (مقابل نصف السعر)\nمثال: اشترته بنصف السعر أثناء التخفيضات",
 "半券": "بذرَة",
 "半刻": "وَقْت (\"بَقِيَ وَقْتاً عِنْدَهُ \" : أَيْ مِقْدَاراً مِنَ الزَّمَنِ؛ \"جَاءَ فِي الوَقْتِ الْمُنَاسِبِ \" : فِي اللَّحْظَةِ الْمُنَاسِبَةِ)\nمثال: حان وقت الذهاب. / نِصْف سَاعَة",
 "半半": "مُنَاصَفَةً, بِالنِّصْف",
 "半可": "عدم كفاية, قصور (الافتقار إلى كمية أو عدد كافٍ) / قُصُور ((في علم الأمراض) عجز جزء من الجسم أو عضو عن العمل بشكل طبيعي) / عدم كفاءة, قصور (نقص الكفاءة)\nمثال: عدم كفاية إعانات البطالة",
 "半可臭い": "أَحْمَق, غَبِيّ (مُغَفَّل، أَبْلَه، طَائِش)\nمثال: قبلني ايها الأحمق.",
 "半可通": "إلمام بسيط, معرفة سطحية (فهم طفيف أو سطحي لموضوع ما) / حفنة, قلة (عدد أو كمية صغيرة)\nمثال: تم تلقي حفنة فقط من الردود / مُتَطَفِّل, هَاوٍ سَطْحِيّ (يُظهِر اهتمامًا سطحيًّا أو تافهًا؛ على مستوى الهواة) / متطفل, هاوٍ غير جدي (هاوٍ ينخرط في نشاط دون نوايا جادة ويدعي المعرفة)",
 "半周": "نصف دائرة (شكل مستوٍ له شكل نصف دائرة)",
 "半固体": "شِبْهُ صُلْب (صلب جزئيًّا؛ ذو صلابة ولزوجة وسطى بين الصلب والسائل)",
 "半固形": "شِبْهُ صُلْب (صلب جزئيًّا؛ ذو صلابة ولزوجة وسطى بين الصلب والسائل)",
 "半夜": "مُنْتَصَف لَيْل, مُنْتَصَف اللَّيْل / مُنْتَصَف اَللَّيْل",
 "半天": "جَوّ",
 "半官的": "شِبْه رَسْمِيّ (له بعض السلطة أو الإقرار الرسميّ)",
 "半宵": "مُنْتَصَف لَيْل, مُنْتَصَف اللَّيْل / مُنْتَصَف اَللَّيْل",
 "半導体": "شِبْه مُوَصِّل",
 "半導体検出器": "حَالَةٌ صُلْبَة (يتألّف من موادّ وعناصر أشباه الموصلات والأجهزة المتّصلة بها) / خَاصٌّ بِالحَالَةِ الصُّلْبَة (يتعلّق بالخصائص الفيزيائيّة للموادّ الصلبة؛ خاصّةً التوصيل الكهربائيّ)",
 "半導体素子": "جهاز شبه موصل, نبيطة شبه موصلة (موصل مصنوع من مادة شبه موصلة)",
 "半島": "شِبْه جَزِيرَة / كُورْيَا (بلاد في جنوب شرق آسيا، يطلق عليها جغرافيا شِبْهُ الجَزِيْرَةِ الكُوْرِيَّة؛ دولتان تقعان في جنوب شرق آسيا تسميان كُوْرِيَا الشَمَالِيَّة وكُوْرِيَا الجَنُوْبِيَّة) / كُورِيَا (بلاد في جنوب شرق آسيا، يطلق عليها جغرافيا شِبْهُ الجَزِيْرَةِ الكُوْرِيَّة؛ دولتان تقعان في جنوب شرق آسيا تسميان كُوْرِيَا الشَمَالِيَّة وكُوْرِيَا الجَنُوْبِيَّة)\nمثال: أريد أن أزور كوريا.",
 "半島人": "كُورِيّ",
 "半年ごとに": "مَرَّتَيْن فِي السَّنَة, نِصْف سَنَوِيًّا (مرتين في السنة)",
 "半年毎に": "مَرَّتَيْن فِي السَّنَة, نِصْف سَنَوِيًّا (مرتين في السنة)",
 "半張り": "نصف نعل (نعل حذاء يمتد من القوس إلى إصبع القدم)",
 "半影": "شِبْه ظِلّ",
