 "品物": "مَقَال, مَقَالَة / أَدَاةُ تَعْرِيف, أَدَاةُ التَّعْرِيف / مادّةٌ, مَوَادُّ (مؤنث مَادّ، اسم فاعل من مَدَّ. الجمع مَادَّات؛ ما كان مَدَدًا لغيره)\nمثال: لا أحب مادة العلوم.",
 "品玉": "خفة اليد (براعة يدوية في تنفيذ الحيل)",
 "品目": "بَنْد",
 "品種": "نَوْع, نَمَط (صِنْف؛ في : وحدة تصنيفية أقل من الجنس) / طَبَعَ (طَبَعَ الله الخلقَ : أَنشأَهُ؛ طبَعَت الدَّوْلةُ النَّقْد : صاغتْه ونقشته)\nمثال: انه نوع من الفطر. / صُورَة, شَكْل / اِسْتِمَارَة / شَكَّلَ ((شَكَلَ) الأمْرُ يَشْكُلُ شُكُولاً: الْتَبَسَ؛ (شَكَلَ) المريضُ: تماثَلَ)\nمثال: اجلس بشكل مريح. / رَبَّى",
 "品等": "دَرَجَة",
 "品管": "مُرَاقَبَةُ الْجَوْدَة",
 "品良く": "كَمَا يَجِب, كَمَا يَنْبَغِي",
 "品行": "تصرف, سلوك (طريقة التصرف أو التحكم بالنفس) / تصرف, سلوك ((السمات السلوكية) الطريقة التي يتصرف بها الشخص تجاه الآخرين)",
 "品証": "ضَمَانْ الجَوْدَة (مَصْدَرُ ضَمِنَ؛ كَفَالَة)\nمثال: لا أستطيع ضمان أي شيء.",
 "品評": "تثمين, تقدير (حكم على صفات شيء أو شخص ما) / تخمين, تقدير (حساب تقريبي للكمية أو الدرجة أو القيمة) / تقدير (الاحترام الذي يحظى به شخص ما) / تثمين, تقدير (وثيقة تقدر قيمة شيء ما (مثل التأمين أو الضرائب))\nمثال: في تقديري الصبي بريء",
 "品評会": "أَشْقَر (هو لون الشُقْرَة، وأصله اللون الأحمر المائل إلى الصُفرة ثم أصبح يطلق على ما كان لونه أصفر أيضا؛ صفة ما كان لونه الشُقرة) / حَقَّانِيّ, عادِل / مَأْذُون, مُبَاح\nمثال: أنا لديها شعر بني كستنائي, ولكن ماجدالينا لديها شعر أشقر.",
 "品詞": "جُزْء كَلَام, قَسْم كَلَام",
 "品質": "نَوْعِيَّة, جَوْدَة",
 "品質チェック": "ضَمَانْ الجَوْدَة (مَصْدَرُ ضَمِنَ؛ كَفَالَة)\nمثال: لا أستطيع ضمان أي شيء.",
 "品質保証": "ضَمَانْ الجَوْدَة (مَصْدَرُ ضَمِنَ؛ كَفَالَة)\nمثال: لا أستطيع ضمان أي شيء.",
 "品質管理": "مُرَاقَبَةُ الْجَوْدَة",
 "哄然": "بشكل واسع, بمعنى واسع (دون النظر إلى تفاصيل محددة أو استثناءات) / بشكل عريض (بطريقة واسعة)\nمثال: يفسر القانون بشكل واسع",
 "哈爾浜": "هَارْبِين, خَارْبِين",
 "哈爾浜工業大学": "أَصَابَ / ضَرْبَة (المرة الواحدة من الضَرْب؛ اللطمو أو الدقة أو الصكّة؛ ضربة طبل: دقة واحدة منه)\nمثال: تلقى مناد ضربة.",
 "員": "عُضْو, عِضْو (جُزْء من الجَسَد؛ مُشْتَرِك فِي جَمْعِيَّة أو شَرِكَة أو حِزْب أو نَادٍ) / عُضُو (جُزْء من الجَسَد؛ مُشْتَرِك فِي جَمْعِيَّة أو شَرِكَة أو حِزْب أو نَادٍ)\nمثال: اذكر كل عضو باسمه.",
 "員数": "عَدَد, نمرة (مِقْدَار مَا يُعَدّ) / عَدَد, رَقْم (مِقْدَار مَا يُعَدّ) / عَدَد (مِقْدَار مَا يُعَدّ) / رَقْم (وضع أرقامًا على شيء ما للتنظيم أو التمييز) / رَقَّمَ (وضع أرقامًا على شيء ما للتنظيم أو التمييز)\nمثال: كم عدد سكان الجزائر؟",
 "哨兵": "حارِس, خَفِير (شخص يتم توظيفه للمراقبة تحسباً لحدث متوقع)",
 "哨戒": "دَوْرِيَّة, خَفْر / دَوْرِيَّة",
 "哨戒艇": "سفينة دورية, قارب دورية (سفينة مخصصة للقيام بدوريات في منطقة ما)",
 "哨舎": "كشك الحراسة (مأوى صغير مفتوح من الأمام لحماية الحارس من الطقس)",
 "哭く": "بَكَى, عَيَّط (دَمَعَتْ عَيناهُ حزنا؛ بكى الْمَيِّت: رثاه) / صَاحَ (صاتَ بأقصى طاقته وأعلى صوته، يستخدم للحيّ ولا يقال صاح للجماد؛ عليه: ناداه) / بكاء\nمثال: بكى زيري كثيرا.",
 "哭声": "صراخ, عويل (صرخات عالية أثناء البكاء) / عَوِيل, نَائِح (يعبّر بصوته عن الحزن والأسى أو يشبه هذا التعبير)",
 "哭慟": "صراخ, عويل (صرخات عالية أثناء البكاء) / عَوِيل, نَائِح (يعبّر بصوته عن الحزن والأسى أو يشبه هذا التعبير)",
 "哭聲": "صراخ, عويل (صرخات عالية أثناء البكاء) / عَوِيل, نَائِح (يعبّر بصوته عن الحزن والأسى أو يشبه هذا التعبير)",
 "哮り立つ": "حَنَق ((حَنِقَ) عَلَيْهِ حنقا: اشْتَدَّ غيظه فَهُوَ حنق وحنيق) / غَضِبَ, اِنْدَلَعَ / عُوَاء / عَوَى / أَنَّ (يفيد التوكيد)\nمثال: كيف لي أن أعرف؟",
 "哮る": "أَنَّ (يفيد التوكيد) / قَهْقَهَ / زَئِير (اسم لصوت الأَسَد؛ زائير اسم سابق لجمهورية الكونغو الديمقراطية)\nمثال: كيف لي أن أعرف؟",
 "哲": "حَكِيم, فَطِن (الذي يتصرف دوما بحكمة وتكون الحكمة من صفاته؛ في : هو الطَبِيب) / مَرْيَمِيَّة / شَاقِيَة\nمثال: هذه كلمات حكيمة. / حصافة, حكمة (سمة تكوين الآراء عن طريق التمييز والتقييم) / تمييز, حصافة (القدرة العقلية على الفهم والتمييز بين العلاقات)",
 "哲人": "رجل حكيم (مرشد ومستشار ذكر حكيم وموثوق به)",
 "哲学": "فَلْسَفَة (في : عِلْمُ الفَلْسَفَة: علم يعنى بوجه الإجمال على بيان أسباب الأشياءِ المادّية والغير المادّية أو ذكر الأشياءِ مع أسبابها وهو يدرس المبادئ الأُولى…؛ في : التشبُّه بالإله حسب الطاقة البشريَّة لتحصيل السعادة الأبديَّة) / مَذْهَب, عَقِيدَة (المَذْهَب : بمعنى الذَهْاب، السَيْر، المَسْلَك، الإزَالَة؛ المَذْهَب: المُعْتَقَد الديني الذي يُذهب إليه) / مَبْدَأ, مَذْهَب (أَسَاس، أَصْل؛ مُسَلَّمَة، اِفْتِرَاض، ما يسلّم به لوضوحه) / فَلْسَفَة, مَذْهَب (في : عِلْمُ الفَلْسَفَة: علم يعنى بوجه الإجمال على بيان أسباب الأشياءِ المادّية والغير المادّية أو ذكر الأشياءِ مع أسبابها وهو يدرس المبادئ الأُولى…؛ في : التشبُّه بالإله حسب الطاقة البشريَّة لتحصيل السعادة الأبديَّة)\nمثال: درس الفلسفة الإسلامية.",
 "哲学博士": "دُكْتُور فِي الْفَلْسَفَة, دُكْتُورَة فِي الْفَلْسَفَة",
 "哲学的": "فَلْسَفِيّ",
 "哲学者": "فَيْلَسُوف (تلميذ للفلسفة)\nمثال: إنك فيلسوف ، أليس ذلك صحيحا؟",
 "哲学者の石": "حَجَر اَلْفَلَاسِفَة (حَجَرَ عليه الأمرَ:مَنَعَه منه ، حجر الشّيء على نفسه:خَصَّها به وقصره عليها؛ الحجْرُ: المَنْعُ مِن التَّصَرُّفِ ، وحَجَرَ عَلَيْهِ القاضِي يَحْجُرُ حَجْراً، إِذا مَنَعَه مِن التَّصَرُّفِ فِي مالِه)\nمثال: عوقب زيري بالحجر.",
 "哲理": "فَلْسَفَة (في : عِلْمُ الفَلْسَفَة: علم يعنى بوجه الإجمال على بيان أسباب الأشياءِ المادّية والغير المادّية أو ذكر الأشياءِ مع أسبابها وهو يدرس المبادئ الأُولى…؛ في : التشبُّه بالإله حسب الطاقة البشريَّة لتحصيل السعادة الأبديَّة) / مَذْهَب, عَقِيدَة (المَذْهَب : بمعنى الذَهْاب، السَيْر، المَسْلَك، الإزَالَة؛ المَذْهَب: المُعْتَقَد الديني الذي يُذهب إليه) / مَبْدَأ, مَذْهَب (أَسَاس، أَصْل؛ مُسَلَّمَة، اِفْتِرَاض، ما يسلّم به لوضوحه) / فَلْسَفَة, مَذْهَب (في : عِلْمُ الفَلْسَفَة: علم يعنى بوجه الإجمال على بيان أسباب الأشياءِ المادّية والغير المادّية أو ذكر الأشياءِ مع أسبابها وهو يدرس المبادئ الأُولى…؛ في : التشبُّه بالإله حسب الطاقة البشريَّة لتحصيل السعادة الأبديَّة)\nمثال: درس الفلسفة الإسلامية.",
 "哺乳": "رَضِيع",
 "哺乳びん": "زجاجة رضاعة (وعاء مزود بحلمة مرنة ومملوء بالحليب؛ يستخدم كبديل للرضاعة الطبيعية)",
 "哺乳動物": "ثَدْيِيّ",
 "哺乳器官": "غدة ثديية (عضو مفرز للحليب في إناث الثدييات) / أمي, ماما (مصطلحات غير رسمية للأم)",
 "哺乳瓶": "زجاجة رضاعة (وعاء مزود بحلمة مرنة ومملوء بالحليب؛ يستخدم كبديل للرضاعة الطبيعية)",
 "哺乳類": "ثَدْيِيّ\nمثال: イルカは哺乳類の一種です。 — الدلفين نوع من الثدييات.",
 "哺乳類学": "علم الثدييات (فرع علم الحيوان الذي يدرس الثدييات)",
 "哺育": "تَمْرِيض (تَمْرِيض: اعتنى بالمَرِيض أثناء مرضه؛ التَمْرِيض: المهنة التي يقوم أصحابها بالعناية بالمَرْضَى أثناء مرضهم) / مثال: كانت ليلى طالبة تمريض جميلة.",
 "唄": "أُغْنِيَّة, أُغْنِيَة (الجمع : أُغْنِيَات و أغانٍ؛ الأُغنيَة المقتسمة : ( الموسيقى ) قطعة موسيقيَّة ذات لفظ مجانس متعلِّق بالكورال في القرن التَّاسع عشر) / غِنَاء (مصدر للفعل \"غَنَّى\"؛ استعمال الصوت البشري لصنع أصوات موسيقية)\nمثال: أنا أغني أغنية.",
 "唄う": "غَنَّى / تَلَا (قَرَأَ، نحو: تَلُوتُ القرآن تلاوةً أي قرأته؛ اتّبَعَ، نحو: تلا الكتاب والسنة، أو تبع فلان في عمله وسار على نهجه)",
 "唆し": "إثارة, تحريض (الإشعال المتعمد والمقصود (للمشاكل أو الفتنة)) / تحريض, حث (الفعل اللفظي للحث)",
 "唆す": "حَرَّضَ, دَفَعَ (حرّضه على الأمر: حضّه ، شدّد الرّغبة فيه؛ حَرَّضَهُ تَحْرِيضاً: حَثَّه على القِتَالِ وأَحْمَاهُ عَلَيْه)\nمثال: هو حرض على الشغب.",
 "唇": "شَفَة, شفة",
 "唇をとがらす": "بوّز, بَرطَمَ",
 "唇を尖らす": "بوّز, بَرطَمَ",
 "唇弁": "شَفَة, شفة / حنك رخو (سديلة عضلية تغلق البلعوم الأنفي أثناء البلع أو الكلام) / حجاب (غطاء غشائي متصل بالجسم الثمري غير الناضج لبعض الفطريات)",
 "唇形": "شَبِيهٌ بِالشَّفَة, شَفَوِيّ (لَهُ شِفَاهٌ أَوْ أَجْزَاءٌ تُشْبِهُ الشِّفَاه)",
 "唇歯音": "صوت شفوي سني (صامت يتضمن نطقه الشفاه والأسنان)",
 "唇裂": "شفة أرنبية, شفة مشقوقة (شق خلقي في منتصف الشفة العليا)",
 "唇音": "شَفَوِيّ, شَفَهِيّ",
 "唎き酒": "تَذَوُّق النَّبِيذ (تجمع للناس لتذوق ومقارنة أنواع مختلفة من النبيذ)",
 "唎酒": "تَذَوُّق النَّبِيذ (تجمع للناس لتذوق ومقارنة أنواع مختلفة من النبيذ)",
 "唐": "تانغ, سلالة تانغ (السلالة الإمبراطورية للصين من 618 إلى 907) / الصِّين (دولة في شرق آسيا؛ اسمها الرسمي جُمْهُورِيَّة الصِّين الشَّعْبِيَّة، وعاصمتها بِكِّين) / صِينِيَّة (نوع من آنية المطبخ تستخدم لوضع الآواني عليها حين تنقل تكون مسطحة وواسعة؛ القُصْعَة؛ آنية واسعة يُصَّب فيها طعام يكفي عصبة من الناس)\nمثال: الصين بلد عظيم. / الصِّين (دولة في شرق آسيا؛ اسمها الرسمي جُمْهُورِيَّة الصِّين الشَّعْبِيَّة، وعاصمتها بِكِّين) / صِينِيَّة (نوع من آنية المطبخ تستخدم لوضع الآواني عليها حين تنقل تكون مسطحة وواسعة؛ القُصْعَة؛ آنية واسعة يُصَّب فيها طعام يكفي عصبة من الناس)\nمثال: الصين بلد عظيم. / صِينِيّ",
 "唐三盆": "مُرْتَفِع الدَّرَجَة",
 "唐人": "أَجْنَبِيّ, أَجْنَبِيَّة",
 "唐人の寝言": "رَطَانَة / ثَرْثَرَة, بَرْبَرَة",
 "唐人町": "حَيّ صِينِي, تْشَايْنَاتَاوْن (ضد المَيِّت، على قيد الحَيَاة؛ جمع حَيَاء)\nمثال: ينبح كلب في الحي.",
 "唐人稗": "دُخْن (دخن: الشَّيْء دخنة دخن؛ دخنت: النَّار دخنت والوقود دخن)\nمثال: دخن زيري سيجارة.",
 "唐人街": "حَيّ صِينِي, تْشَايْنَاتَاوْن (ضد المَيِّت، على قيد الحَيَاة؛ جمع حَيَاء)\nمثال: ينبح كلب في الحي.",
 "唐名": "المَعْرُوف بِـ, بِاسْم مُسْتَعَار (كما هو معروف أو مسمى في وقت أو مكان آخر) / اسم مستعار (اسم تم انتحاله)\nمثال: السيد سميث، المعروف بالسيد لافاييت",
 "唐国": "الصِّين (دولة في شرق آسيا؛ اسمها الرسمي جُمْهُورِيَّة الصِّين الشَّعْبِيَّة، وعاصمتها بِكِّين) / صِينِيَّة (نوع من آنية المطبخ تستخدم لوضع الآواني عليها حين تنقل تكون مسطحة وواسعة؛ القُصْعَة؛ آنية واسعة يُصَّب فيها طعام يكفي عصبة من الناس)\nمثال: الصين بلد عظيم.",
 "唐土": "الصِّين (دولة في شرق آسيا؛ اسمها الرسمي جُمْهُورِيَّة الصِّين الشَّعْبِيَّة، وعاصمتها بِكِّين) / صِينِيَّة (نوع من آنية المطبخ تستخدم لوضع الآواني عليها حين تنقل تكون مسطحة وواسعة؛ القُصْعَة؛ آنية واسعة يُصَّب فيها طعام يكفي عصبة من الناس)\nمثال: الصين بلد عظيم. / صِينِيّ",
 "唐変木": "أبله, أجلف (شخص أخرق وغبي)",
 "唐大黄": "رَاوَنْد",
 "唐山": "الصِّين (دولة في شرق آسيا؛ اسمها الرسمي جُمْهُورِيَّة الصِّين الشَّعْبِيَّة، وعاصمتها بِكِّين) / صِينِيَّة (نوع من آنية المطبخ تستخدم لوضع الآواني عليها حين تنقل تكون مسطحة وواسعة؛ القُصْعَة؛ آنية واسعة يُصَّب فيها طعام يكفي عصبة من الناس)\nمثال: الصين بلد عظيم.",
 "唐手": "كَارَاتِيه",
 "唐撫子": "قرنفل صيني, قرنفل قوس قزح (قرنفل صيني بزهور وردية ليلكية مسننة بعمق مع عين أرجوانية؛ يزرع عادة كنبات سنوي)",
 "唐文字": "حَرْف صِينِيّ, طَابِع صِينِيّ (طَرَف وَجَانِب وَحَدّ؛ رَمْز مخطوط أو مطبوع يقوم مقام صوت أو كلمة أو عبارة أو معنى)\nمثال: ألف هو الحرف الأول للألف باء.",
 "唐朝": "تانغ, سلالة تانغ (السلالة الإمبراطورية للصين من 618 إلى 907)",
 "唐松": "شجرة اللاريكس, لاريكس (أي من الصنوبريات العديدة من جنس لاريكس، جميعها ذات أوراق إبرية متساقطة) / خشب الأرزية, خشب اللارك (خشب شجرة الأرزية)",
 "唐果物": "مَقْلِيّ (مَطْهُوٌّ بِالقَلْيِ فِي الدُّهْن)",
 "唐桃": "مِشْمِش",
 "唐梅": "بهار ياباني, حلوى الشتاء (شجيرة يابانية نفضية تزرع لأزهارها الصفراء العطرة)",
 "唐棹": "مِدرس, مِدرَسة (أداة تتكون من مقبض وعصا حرة التأرجح في نهايته؛ تستخدم في درس الحبوب يدوياً)",
 "唐樒": "ليسوم حقيقي, ينسون نجمي",
 "唐猫": "قِطّ (حَيْوَان مستأنس من عائلة السَنُّورِيّات، له في اللغة أسماء عديدة تذكر وتؤنث) / قِطَّة (حيوان مستأنس من فصيلة السنوريات) / هِرّ (القطّ؛ صوت الإبل أو دعائها إلى الماء) / هِرَّة (المؤنث من الْهِرّ) / سَنُّور / قطّ (حَيْوَان مستأنس من عائلة السَنُّورِيّات، له في اللغة أسماء عديدة تذكر وتؤنث)\nمثال: أعطنا هذا القط.",
 "唐瘡": "زُهَرِيّ, مَرَض فِرَنْجِيّ",
 "唐突": "مُبَاغِت, مُفَاجِئ",
 "唐竿": "مِدرس, مِدرَسة (أداة تتكون من مقبض وعصا حرة التأرجح في نهايته؛ تستخدم في درس الحبوب يدوياً)",
 "唐紅": "قِرْمِز (القِرْمِزُ: صِبْغ أرمني أَحمر يقال إِنه من عُصارة دود يكون في آجامهم (في الصخور)، فارسي معرب؛ صبغ لونه احمر قانٍ يصنع من حشرة القرمز الجافة والمسحوقة) / قِرْمِزِيّ",
 "唐胡麻": "خِرْوَع, تَنُّوم",
 "唐臼": "مِلَاط / مِهْرَاس, هَاوُن / هَاوُن, مِدْفَعُ الهَاوُن / هَاوُن",
 "唐芋": "بَطَاطَا حُلْوَة",
 "唐茄子": "اسكواش (لعبة تُلعب في ملعب مغلق من قبل لاعبين أو أربعة يضربون الكرة بمضارب طويلة المقبض) / قرع, كوسا (الفاكهة الصالحة للأكل لنبات القرع؛ تؤكل كخضار) / قرع, كوسا (ضرب بشدة على شيء يَصْدُرُ منه صوت قوي؛ في سياق مجازي: أوقع الضربة أو وقع الصوت المفاجئ أو الحاد)\nمثال: توقف ذلك القرع.",
 "唐草文": "أرابيسك, زخرفة عربية (زخرفة تتداخل فيها أشكال نباتية محاكية في تصميم معقد) / أرابيسك (وضعية يرفع فيها الراقص ساقاً واحدة للخلف ويمد ذراعيه في وقفة تقليدية)",
 "唐草模様": "أرابيسك, زخرفة عربية (زخرفة تتداخل فيها أشكال نباتية محاكية في تصميم معقد) / أرابيسك (وضعية يرفع فيها الراقص ساقاً واحدة للخلف ويمد ذراعيه في وقفة تقليدية)",
 "唐菓子": "مَقْلِيّ (مَطْهُوٌّ بِالقَلْيِ فِي الدُّهْن)",
 "唐菓物": "مَقْلِيّ (مَطْهُوٌّ بِالقَلْيِ فِي الدُّهْن)",
 "唐薯": "بَطَاطَا حُلْوَة",
 "唐語": "صِينِيّ",
 "唐辛子": "نَبَات فُلْفُل (مصدر للفعل نَبَتَ؛ اسم جنس شامل لكل ما تنبته الأرض من شجر أو بقل أو عشب أو غيره) / فُلَيْفِلَة\nمثال: هذا النبات مهدد بالانقراض.",
 "唐辛子スプレー": "رشاش الفلفل (أي آلَة تَرُش المَاء؛ المِدْفَع الرَشَّاش: هو بين المِدْفَع والرَشَّاشَة لا يُحمَل باليد ويثبت على الأرض إلا أنه يَرُشّ الرصاص كالرشاشة)\nمثال: إني أطلق النار برشاش روسي.",
 "唐金": "بُرُنْزٌ, فِلِزّ / بُرُنْزِيٌّ",
 "唐銅": "بُرُنْزٌ, فِلِزّ / بُرُنْزِيٌّ",
 "唐鋤": "مِحْراث (أداة زراعية ذات شفرة ثقيلة أو أكثر لقلب التربة وشق أخدود قبل البذر)",
 "唐黍": "ذُرَة, سرغوم / أرز الجبل, عشب الحرير (عشب علفي قيم في المناطق المرتفعة الجافة وسهول غرب أمريكا الشمالية إلى شمال المكسيك) / درة, ذرة بيضاء (سورغم المناطق الجافة في آسيا وشمال أفريقيا)",
 "唖": "خرس, صمت (رفض التحدث عند التوقع) / بكم, خرس (حالة عدم القدرة أو عدم الرغبة في التحدث)\nمثال: كان صمته عن مساهمتي مفاجئاً / أَخْرَس, أَبْكَم ((أَخْرَسَت) الأَرْض: لم تصلح للزِّرَاعَة؛ (أَخْرَسَ) الله فلَانا: أَصَابَهُ بالخرس) / صَامِت",
 "唖々": "نَعْق, نَعِيق / نَعَقَ",
