 "動脈血ガス分析": "دم شرياني (الدم الموجود في الشرايين)\nمثال: باستثناء الشريان الرئوي، الدم الشرياني غني بالأكسجين",
 "動詞": "فِعْل (عَمِلَ وصَنَعَ، بعلم أو بدون علم، عن قصد أو دون قصد)\nمثال: ماذا فعل للحمي؟",
 "動詞化": "فِعْل (عَمِلَ وصَنَعَ، بعلم أو بدون علم، عن قصد أو دون قصد)\nمثال: ماذا فعل للحمي؟",
 "動詞句": "عبارة فعلية, مسند (أحد المكونين الرئيسيين للجملة؛ يحتوي المسند على الفعل ومكملاته)",
 "動詞状名詞": "صِيغَةُ فِعْل, مَصْدَر",
 "動議": "حَرَكَة",
 "動転": "تَحَوُّل, نَقِل (صَارَ غير ما كان)\nمثال: تحول ياني إلى وحش.",
 "動軸": "محور حي, محور دافع (محور مركبة ذاتية الدفع الذي يوفر قوة القيادة)",
 "動輪": "عجلة القيادة, عجلة دافعة (عجلة تحرك مركبة (تحول عزم الدوران إلى قوة سحب))",
 "動量": "زَخَم حَرَكَة (زخم للشيء إذا كانت رائحته كريهة؛ \"الزَّخَمَة\" تعني الرائحة الكريهة، خصوصاً من الطعام أو اللحم. قد يُستخدم المصطلح لوصف لحوم السباع التي تكون دسمة وخبيثة الرائحة. يُقال \"طعام فيه…) / زَخَم (زخم للشيء إذا كانت رائحته كريهة؛ \"الزَّخَمَة\" تعني الرائحة الكريهة، خصوصاً من الطعام أو اللحم. قد يُستخدم المصطلح لوصف لحوم السباع التي تكون دسمة وخبيثة الرائحة. يُقال \"طعام فيه…)\nمثال: يمكنك أن تتعلم بنفس الزخم في المكتبة كما في المدرسة.",
 "動静": "وَضْع (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه) / دَوْلَة (بَلَد يتميز بحُدُود معروفة وشَعْب وحُكُومَة ومُؤَسَسَات مُنَظَّمَة؛ مجموعة من الناس مستقلين متحدين معا لتكوين مجتمع لحماية حقوقهم و وضع قوانينهم الخاصة) / وِلَايَة (منطقة إدارية لها استقلالها الإداري والمعنوي؛ ويختلف المعنى من بلد لآخر كما يختلف من فترة زمنية لأخرى) / يُبْدِي\nمثال: لقد أزمت الوضع.",
 "動静脈": "شرياني وريدي (يوصل شرياناً بوريد)\nمثال: ناسور شرياني وريدي",
 "勘": "اِدْرََاك حَسِّيّ",
 "勘がいい": "فطن, مدرك (لديه القدرة على الإدراك أو الفهم؛ حاد البصيرة) / إدراكي (متعلق بالإدراك الحسي)\nمثال: عين ثاقبة",
 "勘がよい": "فطن, مدرك (لديه القدرة على الإدراك أو الفهم؛ حاد البصيرة) / إدراكي (متعلق بالإدراك الحسي)\nمثال: عين ثاقبة",
 "勘が良い": "فطن, مدرك (لديه القدرة على الإدراك أو الفهم؛ حاد البصيرة) / إدراكي (متعلق بالإدراك الحسي)\nمثال: عين ثاقبة",
 "勘ぐり": "اِتِّهَام, شَكّ / اِتِّهَام",
 "勘ぐる": "اِشْتَبَهَ بِ / مُشْتَبَه بِهِ, مَشْبُوه",
 "勘づく": "حَاسَّة / إِحْسَاس, شُعُور / مَعْنَى, دَلَالَة / مَوْهِبَة, قُدْرَة طَبِيعِيَّة / حَسَّ (حسّه:أحرقه ، حسسْتُ الشّيء:أحسَسْتُه،حسَسْتُ اللحمَ:جعلته على الجمر،حسَسْتُ النّارَ:رددْتُها بالعصا على خُبْزِ المَلّةِ؛ حَسَّ فلاناً:قتله قتلاً ذريعاً مستأصلاً رأسه.(حسَسْتُ اليهوديََ لما أظهر عداوته لله ودينه))\nمثال: لديهم حس الفكاهة.",
 "勘どころ": "مَرْبِط الْفَرَس",
 "勘のいい": "فطن, مدرك (لديه القدرة على الإدراك أو الفهم؛ حاد البصيرة) / إدراكي (متعلق بالإدراك الحسي)\nمثال: عين ثاقبة",
 "勘のよい": "فطن, مدرك (لديه القدرة على الإدراك أو الفهم؛ حاد البصيرة) / إدراكي (متعلق بالإدراك الحسي)\nمثال: عين ثاقبة",
 "勘の良い": "فطن, مدرك (لديه القدرة على الإدراك أو الفهم؛ حاد البصيرة) / إدراكي (متعلق بالإدراك الحسي)\nمثال: عين ثاقبة",
 "勘付く": "حَاسَّة / إِحْسَاس, شُعُور / مَعْنَى, دَلَالَة / مَوْهِبَة, قُدْرَة طَبِيعِيَّة / حَسَّ (حسّه:أحرقه ، حسسْتُ الشّيء:أحسَسْتُه،حسَسْتُ اللحمَ:جعلته على الجمر،حسَسْتُ النّارَ:رددْتُها بالعصا على خُبْزِ المَلّةِ؛ حَسَّ فلاناً:قتله قتلاً ذريعاً مستأصلاً رأسه.(حسَسْتُ اليهوديََ لما أظهر عداوته لله ودينه))\nمثال: لديهم حس الفكاهة.",
 "勘定": "حَسْب, مُحَاسَبَة (عَدَّ مع الجَمْع والطَرْح وغيرها من العمليات الحِسَابية؛ عند أكثر العامة: هو العَدّ مطلقا)\nمثال: حسب سامي المال. / لَائِحَة (قانون مكتوب للإشارة إلى مواقف محددة وغرضه أن يمنع حدوث أمر معين أو يحث عليه؛ قانون وافق عليه الكونجرس (البرلمان الأمريكي)) / فَاتُورَة, حِسَاب / مِنْقَار\nمثال: من فضلك أضف اسمي إلى اللائحة. / اهتمام, مراعاة (عمل ينم عن مراعاة وتفكير بالآخرين) / اهتمام بالآخرين, مراعاة (احترام ومراعاة لطيفة للآخرين) / اعتبار, نظر (عملية التفكير المتأني في شيء ما) / اعتبار, حالة (معلومات يجب وضعها في الاعتبار عند اتخاذ قرار)\nمثال: لم يظهر أي مراعاة لمشاعرها",
 "勘定係": "كَاشِير, صَرَّاف / أَمِينُ الصُّنْدُوقِ (من يتولى رقابة شيء أو المحافظة عليه؛ مُطْمَئِنّ)\nمثال: هو غبي وغير أمين.",
 "勘定台": "عَدَّاد",
 "勘定奉行": "صراف الأجور, مسؤول الرواتب (شخص مسؤول عن دفع الأجور)",
 "勘定書": "لَائِحَة (قانون مكتوب للإشارة إلى مواقف محددة وغرضه أن يمنع حدوث أمر معين أو يحث عليه؛ قانون وافق عليه الكونجرس (البرلمان الأمريكي)) / فَاتُورَة, حِسَاب / مِنْقَار\nمثال: من فضلك أضف اسمي إلى اللائحة.",
 "勘定書き": "لَائِحَة (قانون مكتوب للإشارة إلى مواقف محددة وغرضه أن يمنع حدوث أمر معين أو يحث عليه؛ قانون وافق عليه الكونجرس (البرلمان الأمريكي)) / فَاتُورَة, حِسَاب / مِنْقَار\nمثال: من فضلك أضف اسمي إلى اللائحة.",
 "勘定照合": "صُلْح, مُصَالَحَة",
 "勘定違い": "حساب خاطئ, سوء تقدير (خطأ في الحساب)",
 "勘定高い": "داهِيَة, مُتَآمِر (حاذِق في التَّدْبير والتَّخْطيط بِمَكْر وحِيلَة)",
 "勘弁": "إِبْرَاء, إِعْفَاء / عَفْو, صَفْح / عَفَا (عَفَا شَعَرُ البَعِيرِ: كَثُرَ، وطَالَ فَغَطَّى دُبُرَهُ؛ عَفَا أثَرُهُ عفاءً: هَلَكَ) / عَفْواً!, مَاذَا قُلْتَ؟",
 "勘当": "حرمان من الميراث (فعل من قبل المورث ينهي حق الشخص في الميراث)",
 "勘所": "مَرْبِط الْفَرَس",
 "勘査": "تَحْقِيق",
 "勘案": "اِعْتَبَرَ, تَدَبَّرَ (الشيءَ: اختبره وامتحنه ونظر فيه؛ الشيءَ شيءًا: عَدُّه كذلك وتصرف على ذلك الأساس. بمفعولين) / عَدَّ",
 "勘検": "تَحْقِيق",
 "勘気": "استهجان, عدم رضا (الميل لعدم منح الموافقة أو الرضا عن شخص أو مجموعة) / استهجان, سخط (حالة فقدان الحظوة أو الرضا)\nمثال: هو في حالة سخط من الملك (مغضوب عليه)",
 "勘繰り": "اِتِّهَام, شَكّ / اِتِّهَام",
 "勘繰る": "اِشْتَبَهَ بِ / مُشْتَبَه بِهِ, مَشْبُوه",
 "勘考": "اهتمام, مراعاة (عمل ينم عن مراعاة وتفكير بالآخرين) / اهتمام بالآخرين, مراعاة (احترام ومراعاة لطيفة للآخرين) / اعتبار, نظر (عملية التفكير المتأني في شيء ما) / اعتبار, حالة (معلومات يجب وضعها في الاعتبار عند اتخاذ قرار)\nمثال: لم يظهر أي مراعاة لمشاعرها",
 "勘解由小路": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "勘辨": "إِبْرَاء, إِعْفَاء / عَفْو, صَفْح / عَفَا (عَفَا شَعَرُ البَعِيرِ: كَثُرَ، وطَالَ فَغَطَّى دُبُرَهُ؛ عَفَا أثَرُهُ عفاءً: هَلَكَ) / عَفْواً!, مَاذَا قُلْتَ؟",
 "勘違い": "سُوء فَهْم",
 "務め": "خِدْمَة",
 "務める": "مَلَأَ",
 "務所": "سِجْن (وضع شخصًا أو شيئًا في السجن أو الحبس؛ قيّد حرية شخص أو حركة شيء)\nمثال: دخل سامي السجن.",
 "務長官": "سِكْرِتِير, سِكْرِتِيرَة",
 "勝": "رَبِحَ (رَبَحَ التَّاجِرُ: نَالَ فَائِدَةً مَالِيَّةً فِي تِجَارَتِهِ؛ رَبَحَ السَّبَاقَ: فَازَ، تَفَوَّقَ)\nمثال: ربح زيري المال.",
 "勝ち": "رَبِحَ (رَبَحَ التَّاجِرُ: نَالَ فَائِدَةً مَالِيَّةً فِي تِجَارَتِهِ؛ رَبَحَ السَّبَاقَ: فَازَ، تَفَوَّقَ)\nمثال: ربح زيري المال. / بشكل سائد, في الغالب (أكبر بكثير في العدد أو التأثير)\nمثال: المرضى في الغالب من السكان الأصليين",
 "勝ちとる": "رَبِحَ (رَبَحَ التَّاجِرُ: نَالَ فَائِدَةً مَالِيَّةً فِي تِجَارَتِهِ؛ رَبَحَ السَّبَاقَ: فَازَ، تَفَوَّقَ)\nمثال: ربح زيري المال.",
 "勝ち上がる": "يقرب",
 "勝ち取る": "رَبِحَ (رَبَحَ التَّاجِرُ: نَالَ فَائِدَةً مَالِيَّةً فِي تِجَارَتِهِ؛ رَبَحَ السَّبَاقَ: فَازَ، تَفَوَّقَ)\nمثال: ربح زيري المال.",
 "勝ち得る": "حَقَّقَ (حَقَّقَ (الأمرَ): أثبتَه وصدَّقَه؛ ويقال: حَقَّقَ الظنَّ، وحَقَّقَ القولَ والقضيّةَ؛ حَقَّقَ (الشيءَ والأمرَ): أحكمه؛ ويقال: حَقَّقَ الثوبَ: أحكم نَسْجَه)\nمثال: و أخيرا حقق هدفه.",
 "勝ち戦": "اِنْتِصَار, نَصْر",
 "勝ち抜き": "بطولة, دورة (منافسة رياضية يلعب فيها المتسابقون سلسلة من الألعاب لتحديد الفائز) / بطولة مبارزة, مبارزة (سلسلة من المبارزات بين الفرسان للتنافس على جائزة)",
 "勝ち抜き戦": "بطولة, دورة (منافسة رياضية يلعب فيها المتسابقون سلسلة من الألعاب لتحديد الفائز) / بطولة مبارزة, مبارزة (سلسلة من المبارزات بين الفرسان للتنافس على جائزة)",
 "勝ち星": "رَبِحَ (رَبَحَ التَّاجِرُ: نَالَ فَائِدَةً مَالِيَّةً فِي تِجَارَتِهِ؛ رَبَحَ السَّبَاقَ: فَازَ، تَفَوَّقَ)\nمثال: ربح زيري المال.",
