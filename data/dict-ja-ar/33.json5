 "凝っては思案にあたわず": "بإفراط, كثيراً جداً (أكثر مما يلزم)\nمثال: إنها تأكل كثيراً جداً",
 "凝っては思案に能わず": "بإفراط, كثيراً جداً (أكثر مما يلزم)\nمثال: إنها تأكل كثيراً جداً",
 "凝らす": "تَجَمَّدَ / تَفَكَّرَ, فَكَّرَ / رَكَّزَ (وضع الشيء بثبات في مكانه؛ أثبت الشيء أو ثبّتَه، وخاصة في مكان محدد)\nمثال: فقط ركز يا زيري. / جَمَدَ (صَارَ صُلْبًا أو قَاسِيًا بَعْدَ السَّيُولَةِ؛ تَوَقَّفَ عَنِ الحَرَكَةِ أو…)",
 "凝らせる": "تَجَمَّدَ",
 "凝り": "كُتْلَة (القطعة المجتمعة من الشيء؛ القطعة الواحدة من اللحم)\nمثال: السحابة هي كتلة بخار في السماء. / تململ, قلق (عدم القدرة على الراحة أو الاسترخاء أو السكون) / تجمّد, تخثر (عملية التجمد؛ التصلب عن طريق (أو كما لو كان عن طريق) التجميد)",
 "凝り固まる": "تَجَلَّطَ, تَخَثَّرَ / جَمَدَ (صَارَ صُلْبًا أو قَاسِيًا بَعْدَ السَّيُولَةِ؛ تَوَقَّفَ عَنِ الحَرَكَةِ أو…)",
 "凝り屋": "كَمَالِيّ",
 "凝り性": "استحواذ فكري, هوس أحادي (هوس يقتصر على شيء واحد أو فكرة واحدة)",
 "凝る": "جَمَدَ (صَارَ صُلْبًا أو قَاسِيًا بَعْدَ السَّيُولَةِ؛ تَوَقَّفَ عَنِ الحَرَكَةِ أو…)",
 "凝乳": "خُثَارَة, أَقِط",
 "凝固": "تجلط, تخثر (عملية تشكيل كتل شبه صلبة في سائل)",
 "凝固まり": "تجلط, تخثر (عملية تشكيل كتل شبه صلبة في سائل)",
 "凝固剤": "عامل تجلط, مخثر (عامل ينتج التخثر)",
 "凝固因子": "عامل التخثر (أي من العوامل في الدم التي تعد أفعالها ضرورية لتخثر الدم)",
 "凝固点": "نقطة الانصهار, نقطة التجمد (درجة الحرارة التي يتحول تحتها السائل إلى صلب)",
 "凝塊": "جلطة, خثرة (كتلة من مادة تشكلت من محتوى سائل)",
 "凝析": "تجلط, تخثر (عملية تشكيل كتل شبه صلبة في سائل)",
 "凝滞": "تَأْخِير, تَأَخَّر\nمثال: اقترب أجل زيري.",
 "凝灰岩": "توف, طوفة بركانية (صخر بركاني صلب يتكون من رماد بركاني مضغوط)",
 "凝然": "بسكون تام, بلا حراك (بدون حركة أو إصدار صوت)\nمثال: جلس بلا حراك كالتمثال",
 "凝然として": "بِهُدُوء",
 "凝着": "اِلْتِصَاق",
 "凝着力": "اِلْتِصَاق",
 "凝結": "تصلب, تصلد (عملية التحول إلى صلب أو قاسي عن طريق التبريد أو التجفيف أو التبلور)\nمثال: تصلب الخرسانة / تجلط, تخثر (عملية تشكيل كتل شبه صلبة في سائل) / تكثيف, تكميد (فعل زيادة كثافة شيء ما)\nمثال: تقلص الغاز عند التبريد",
 "凝縮": "تكثيف, تكميد (فعل زيادة كثافة شيء ما)\nمثال: تقلص الغاز عند التبريد",
 "凝縮熱": "حرارة التكثف (حرارة تتحرر بواسطة وحدة كتلة من الغاز عند نقطة غليانه عندما يتكثف إلى سائل)\nمثال: حرارة التكثف تساوي حرارة التبخر",
 "凝縮物": "تكثف, ندى (رطوبة جوية تكثفت بسبب البرودة)",
 "凝華": "خلع, عزل (فعل عزل شخص ما؛ إزالة شخص قوي من منصب أو وظيفة)",
 "凝血": "خُثْرَة, جُلْطَة",
 "凝視": "حَدَّقَ (حَدَقَ فلَان الشَّيْءَ بعَيْنِه يَحْدِقُه حَدْقاً: إِذا نَظَرَ إلَيهِ، وحدَقَ…)\nمثال: حدق الجميع في وجهي.",
 "凝議": "تداول, تريث (سمة التفكير المتأني في العمل أو القرار)\nمثال: كان رجلاً ذا تداول قضائي",
 "凝集": "تجميع كتلي, تكتل (فعل الجمع في كتلة) / تماسك ((في الفيزياء) القوة بين الجزيئية التي تربط جزيئات مادة صلبة أو سائلة معاً) / تلبد (عملية التلبد؛ تشكيل تجمعات صوفية تشبه السحب) / إلصاق (بناء الكلمات من المورفيمات المكونة التي تحتفظ بشكلها ومعناها في عملية الجمع)",
 "凝集剤": "عامل تجلط, مخثر (عامل ينتج التخثر)",
 "凝集力": "تماسك ((في الفيزياء) القوة بين الجزيئية التي تربط جزيئات مادة صلبة أو سائلة معاً)",
 "凝集原": "مستضد ملزن, مولد التلزن (أي مادة تعمل كمستضد لتسبب إنتاج الراصة (الأجسام المضادة الملزنة))",
 "凝集塊": "إِجْمَالِيّ, مَجْمُوع",
 "凝集素": "راصة (جسم مضاد يسبب تراص مستضد معين)",
 "几": "مِرْفَق (مَا يُتَّكَأُ عَلَيْهِ)\nمثال: يؤلمني ذراعي من الكتف إلى المرفق. / مَكْتَب, مِنْضَدَة (الموضع الذي يُكتَب عليه. بعكس المَكْتَب الذي يكتب فيه؛ مِنْضَدَة مخصصة للكتابة…)\nمثال: عاد إلى المكتب.",
 "几帳": "حِجَاب, سِتَارَة (الغطاء أو الساتر؛ يُطلق مجازا على لباس المرأة الذي يستر جميع جسمها)\nمثال: ارتدت أمها الحجاب.",
 "几帳面": "مَنْهَجِيّ, مُنَظَّم (يتسم بالمنهجية والدقة في الترتيب)",
 "几案": "مَكْتَب, مِنْضَدَة (الموضع الذي يُكتَب عليه. بعكس المَكْتَب الذي يكتب فيه؛ مِنْضَدَة مخصصة للكتابة…)\nمثال: عاد إلى المكتب.",
 "凡": "عَادِيّ, مَأْلُوف",
 "凡々": "عَادِيّ, مَأْلُوف",
 "凡そ": "حَوْلَ (جَعَلَ الشيءَ غير ما كان؛ نقل الشيء من موضع إلى آخر)\nمثال: رقصنا حول النار. / عُمُومًا / تَمَامًا / لَخَّصَ, اِخْتَصَرَ",
 "凡ての道はローマに通ず": "كُلُّ الطُّرُقِ تُؤَدِّي إِلَى رُومَا",
 "凡ならざる": "غير شائع, غير مألوف (غير شائع أو لا يصادف عادة؛ عظيم المقدار بشكل غير عادي أو لافت للنظر في طابعه أو…)\nمثال: طيور غير شائعة",
 "凡体": "تَوَسُّط, رَدَاءَة نِسْبِيَّة (العادية نتيجة لكون الشيء متوسطاً وغير متميز)",
 "凡例": "أُسْطُورَة\nمثال: بحث عن المفتاح.",
 "凡俗": "تَوَسُّط, رَدَاءَة نِسْبِيَّة (العادية نتيجة لكون الشيء متوسطاً وغير متميز)",
 "凡凡": "عَادِيّ, مَأْلُوف",
 "凡常": "عَادِيّ, مَأْلُوف",
 "凡庶": "عامة الناس, قوم (الناس بشكل عام (وغالباً ما تستخدم بصيغة الجمع))\nمثال: إنهم مجرد ناس ريفيين",
 "凡庸": "مُتَوَسِّط",
 "凡愚": "شخص من العامة, عامّي (شخص لا يحمل أي لقب نبيل)",
 "凡才": "تَوَسُّط, رَدَاءَة نِسْبِيَّة (العادية نتيجة لكون الشيء متوسطاً وغير متميز)",
 "凡百": "مُخْتَلِف, مُتَنَوَّع",
 "処": "مَيْدَان\nمثال: هذا المكان مقدس / خُطْبَة, نِدَاء\nمثال: نسيت عنوان توم. / مِنْطَقَة (المِنْطَقةُ: المَنْطِقَةُ؛ مِنْطَقَةُ: مُقَاطَعَةٌ)\nمثال: غزة منطقة مكشوفة. / نُقْطَة (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه)\nمثال: هذه هي نقطة ضعفه. / مَطْعَم",
 "処々方々": "فِي كُلِّ مَكَانٍ (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "処す": "أَدَارَ (دَارَ نصف دورة فقط؛ الشيء: جعله يدور؛ فعل تعدّي من دَارَ)\nمثال: أدار فاضل مقبض الباب بهدوء و دخل إلى المنزل. / حُكْم (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام…)\nمثال: حكم علي بالموت.",
 "処する": "أَدَارَ (دَارَ نصف دورة فقط؛ الشيء: جعله يدور؛ فعل تعدّي من دَارَ)\nمثال: أدار فاضل مقبض الباب بهدوء و دخل إلى المنزل. / حُكْم (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام…)\nمثال: حكم علي بالموت.",
 "処世訓": "مَبْدَأ (أَسَاس، أَصْل؛ مُسَلَّمَة، اِفْتِرَاض، ما يسلّم به لوضوحه)",
 "処処方方": "فِي كُلِّ مَكَانٍ (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "処分": "تخلص, تصريف (فعل أو وسيلة التخلص من شيء ما)\nمثال: استخدم كل الموارد المتاحة تحت تصرفه / قِيَاس\nمثال: قاس طول السرير. / عِقَاب, جَزَاء (طَيْر من الجَوَارِح، أكبر التي تصيد منها يكنى بأبي الهَيْثَم ومعروف بحِدَّة…)\nمثال: هو من تلقى العقاب الأكبر.",
 "処分場": "محطة معالجة مياه الصرف الصحي (منشأة للتخلص من مياه الصرف الصحي)",
 "処刑": "تَنْفِيذ\nمثال: محكم عليه بالإعدام.",
 "処刑人": "جَلَّاد",
 "処刑台": "سِقَالَة, إِسْقَالَة",
 "処女": "بتول, بِكْر (المنقطعه عن الرجال) / إطلاق, تدشين (فعل البدء بشيء جديد)\nمثال: تطلعوا إلى الظهور الأول لخط إنتاجهم الجديد",
 "処女受胎": "ميلاد, ولادة عذرية (العقيدة اللاهوتية القائلة بأن يسوع المسيح لم يكن له أب بشري؛ يعتقد المسيحيون أن…)",
 "処女喪失": "تَصَرُّف",
 "処女宮": "بُرْج الْعَذْرَاء, الْعَذْرَاء (ظهر وارتفع)\nمثال: وصل كارل إلى برج آخر.",
 "処女性": "بَكَارَة, بَتُولِيَّة",
 "処女懐胎": "ميلاد, ولادة عذرية (العقيدة اللاهوتية القائلة بأن يسوع المسيح لم يكن له أب بشري؛ يعتقد المسيحيون أن…)",
 "処女林": "غابة بكر, غابة قديمة النمو (غابة أو أرض حرجية ذات نظام بيئي ناضج أو مفرط النضج لم يتأثر تقريباً بالنشاط…)",
 "処女生殖": "توالد عذري (عملية تتطور فيها البويضة غير المخصبة إلى فرد جديد؛ شائعة بين الحشرات وبعض…)",
 "処女膜": "غِشَاء اَلْبَكَارَة",
 "処女航海": "رحلة بحرية أولى (أول رحلة بحرية من نوعها)\nمثال: في عام 1912 غرقت سفينة تايتانيك في رحلتها الأولى",
 "処女降誕": "ميلاد, ولادة عذرية (العقيدة اللاهوتية القائلة بأن يسوع المسيح لم يكن له أب بشري؛ يعتقد المسيحيون أن…)",
 "処女飛行": "رحلة أولى, طلعة جوية أولى (أول رحلة من نوعها)\nمثال: قامت قاذفة الشبح برحلتها الأولى في عام 1989",
 "処子": "امرأة غير متزوجة, عزباء (امرأة ليست متزوجة)",
 "処断": "تقييم, حكم (فعل الحكم على أو تقييم شخص أو موقف أو حدث)\nمثال: انتقدوا حكمي على المتسابقين / أداء, تنفيذ (فعل الأداء؛ القيام بشيء بنجاح؛ استخدام المعرفة بدلاً من مجرد امتلاكها)\nمثال: انتقدوا أداءه كرئيس للبلدية",
 "処方": "وَصْفَة طِبِّيَّة, وَصْفَة",
 "処方せん": "وَصْفَة طِبِّيَّة, وَصْفَة",
 "処方箋": "وَصْفَة طِبِّيَّة, وَصْفَة",
 "処方箋医薬品": "دواء بوصفة طبية, وصفة طبية (دواء لا يتوفر إلا بتعليمات مكتوبة من طبيب أو طبيب أسنان للصيدلي)\nمثال: أخبر الطبيب أنه كان يتناول وصفته الطبية بانتظام",
 "処方薬": "دواء بوصفة طبية, وصفة طبية (دواء لا يتوفر إلا بتعليمات مكتوبة من طبيب أو طبيب أسنان للصيدلي)\nمثال: أخبر الطبيب أنه كان يتناول وصفته الطبية بانتظام",
 "処格": "حالة الظرفية المكانية, حالة المكان (حالة تستخدم للإشارة إلى المكان، أو المكان الذي يحدث فيه الشيء)",
 "処決": "مُسْتَعْمَرَة, مُسْتَوْطَنَة",
 "処理": "مُعَالَجَة",
 "処理機構": "مُعَالِج",
 "処理済み": "مُصَنَّع, مُعَالَج (خضع لعملية أو معالجة خاصة)\nمثال: خامات معالجة",
 "処理系": "تَنْفِيذ",
 "処理能力": "إنتاجية, معدل المعالجة (المخرجات بالنسبة للمدخلات؛ الكمية التي تمر عبر نظام من المدخلات إلى المخرجات…)",
 "処理装置": "مُعَالِج",
 "処理過程": "عَمَلِيَّة\nمثال: جهز زيري حقائبه.",
 "処理部": "مُعَالِج",
 "処置": "قِيَاس\nمثال: قاس طول السرير.",
 "処置なし": "مَيْئُوس مِنْه ((غير رسمي للتأكيد) يتجاوز أي أمل في الإصلاح أو المعالجة)\nمثال: في عذاب من الحزن الميؤوس منه",
 "処置無し": "مَيْئُوس مِنْه ((غير رسمي للتأكيد) يتجاوز أي أمل في الإصلاح أو المعالجة)\nمثال: في عذاب من الحزن الميؤوس منه",
 "処罰": "عِقَاب, جَزَاء (طَيْر من الجَوَارِح، أكبر التي تصيد منها يكنى بأبي الهَيْثَم ومعروف بحِدَّة…)\nمثال: هو من تلقى العقاب الأكبر.",
 "処遇": "مُعَامَلَة (كيفية التَصَرُّف مع الآخرين ومدى احترامهم أو خلافه؛ عند الفقهاء: العَقْد على…)\nمثال: أساء توم معاملة ماري.",
 "凧": "طَائِرَة وَرَقِيَّة, طيارة ورق (مَرْكَبَة كبيرة لها جناحان وتنقل الرُكَّاب والبَضَائِع بالجَوّ. ؛ كل من تَطِير…)\nمثال: لقد وصلت الطائرة.",
 "凪": "هَادِئ",
 "凪良": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "凭れ掛かる": "مَالَ (ما يملك الإنسان من كل شيء ويشمل النقد والعَيْن؛ عند البدو: هي النعم والإبل…)\nمثال: أريد بعض المال.",
 "凭れ椅子": "كرسي استلقاء, كرسي قابل للإمالة (كرسي بذراعين يمكن خفض ظهره ورفع مسند القدمين للسماح للجالس بالاستلقاء فيه)",
 "凱旋門": "قوس النصر (قوس تذكاري ضخم؛ يُبنى عادة لإحياء ذكرى انتصار بارز)",
 "凱歌": "اِنْتِصَار, نَصْر",
 "凶": "نَحْس, سُوءُ الحَظّ",
 "凶々しい": "مَشْؤُوم, نَذِير شُؤْم (ينذر بسوء الحظ والطالع) / مُزْعِج / قابل للتصديق, معقول (يبدو معقولاً وموثوقاً، وبالتالي مقنعاً)\nمثال: عذر وجيه",
 "凶事": "بَلَاء, بُؤْس",
 "凶人": "وَغْد, نَذْل",
 "凶党": "عِصَابَة",
 "凶凶しい": "مَشْؤُوم, نَذِير شُؤْم (ينذر بسوء الحظ والطالع) / مُزْعِج / قابل للتصديق, معقول (يبدو معقولاً وموثوقاً، وبالتالي مقنعاً)\nمثال: عذر وجيه",
 "凶変": "كَارِثَة, فَاجِعَة",
 "凶害": "قَتْلٌ عَمْدٌ (تعمّد جعله يَمُوتُ، أزهق روحه، أمَاتَه متعمدا؛ الوقتَ: ضيعه بشيء غير ذي فائدة…)\nمثال: قتل الصياد دبا.",
 "凶徒": "جانٍ, مجرم (شخص ارتكب جريمة أو تمت إدانته قانونياً بجريمة)",
 "凶悍": "شَنَاعَة, فَظَاعَة (صفة كون الفعل قاسياً بشكل مروع وغير إنساني)",
 "凶悪": "فَظِيع, مُرَوِّع (يثير الرعب والهلع)",
 "凶悪性": "بِشَاعَة, قَسْوَة",
 "凶手": "قَاتِل, سَفَّاح (اسم فاعل من الفعل قَتَلَ، الذي قَامَ بالقَتْل. الجمع قَاتِلُون؛ المُجْرِم الذي…)\nمثال: بيتي قاتلة أمك.",
 "凶暴": "شَرِس ((شَرَسَ) الجِلْدَ يَشْرُسُ شَرْسًا: دَلكَهُ؛ (شَرَسَ) صاحبَه: أمَضَّهُ بالقول)\nمثال: احذر من الكلب الشرس",
 "凶暴性": "وحشية",
 "凶歉": "مَجَاعَة",
 "凶漢": "شِرِّير (الكَثير الشَرّ بمعنى اسم جامع للرذائل، قد يستعمل كاسم فاعل؛ ضد الخَيِّر؛ يستخدم…)\nمثال: لقد وصف سامي ليلى كشخص شرير إلى حد يكاد لا يصدق.",
 "凶状": "جَرِيمَة, جِنَايَة",
 "凶猛": "عَاصِف, مُضْطَرِب (شَدِيد الهَيَجَان والاضْطِرَاب)",
 "凶相": "نَحْس, سُوءُ الحَظّ",
 "凶荒": "مَجَاعَة",
 "凶行": "عُنْف, عَنْف",
 "凶行人": "حيوان, كائن حي (كائن حي يتميز بالحركة الإرادية)",
 "凶賊": "شِرِّير (الكَثير الشَرّ بمعنى اسم جامع للرذائل، قد يستعمل كاسم فاعل؛ ضد الخَيِّر؛ يستخدم…)\nمثال: لقد وصف سامي ليلى كشخص شرير إلى حد يكاد لا يصدق.",
 "凶運": "نَحْس, شُؤْم",
 "凸": "حَاجِب (قوس الشعر فوق كل عين)\nمثال: غربت الشمس خلف قمة التلال البعيدة / خبطة, ضربة (ارتطام (كما هو الحال في التصادم))\nمثال: الخبطة ألقته عن الدراجة / مُحَدَّب",
 "凸する": "تُهْمَة\nمثال: أقوم بشحن هاتفي",
 "凸る": "تُهْمَة\nمثال: أقوم بشحن هاتفي / رِسَالَة, خَبَر",
 "凸レンズ": "عدسة مجمعة, عدسة محدبة (عدسة تعمل على تجميع شعاع الضوء المار عبرها في نقطة أو بؤرة)",
 "凸円": "تحدب (الخاصية التي يمتلكها الشكل المحدب)",
 "凸凹": "تَفَاوُت, عَدَم اسْتِوَاء (صفة عدم التوازن) / عَدَم مُسَاوَاة (الفقدان ونقيض الوجود؛ يجب عدم فعل كذا: أي يجب الامتناع عن الفعل)\nمثال: عليك عدم الخوف.",
 "凸助": "فتحة الشرج (فِي اللُّغَةِ الْعَرَبِيَّةِ (إعراب) : الفَتْحَة أو الفَتْح هي إحدى الحركات…)\nمثال: انظر من الفتحة.",
 "凸坊": "عَابِس, مُقَطِّب الجَبِين (كَئِيب أَوْ غَيْر وُدِّيّ فِي المَظْهَر)",
 "凸型": "تحدب (الخاصية التي يمتلكها الشكل المحدب)",
 "凸多角形": "مضلع محدب (مضلع بحيث إذا مُد أي ضلع لا يقطع أي ضلع أو رأس آخر)",
 "凸形": "مُحَدَّب",
 "凸月": "أَحْدَب (صفة من كان له حَدْبَة؛ لما كان أحدبًا)",
 "凸版": "طباعة بارزة, لتربرس (الطباعة من لوح ذي أحرف بارزة)",
 "凸版印刷": "طباعة بارزة, لتربرس (الطباعة من لوح ذي أحرف بارزة)",
 "凸状": "نَاتِئَة",
 "凸面": "مُحَدَّب",
 "凹": "مُقَعَّر, مُجَوَّف / أَجْوَف / مَهْبَل",
 "凹ます": "انبعاج, حز (أثر غائر في سطح (كما ينتج عن ضربة))\nمثال: أحدث نقصاً في حسابي المصرفي",
 "凹ませる": "انبعاج, حز (أثر غائر في سطح (كما ينتج عن ضربة))\nمثال: أحدث نقصاً في حسابي المصرفي",
 "凹まる": "انخساف, هبوط أرضي (الانهيار المفاجئ لشيء ما في تجويف تحته)",
 "凹み": "أَجْوَف\nمثال: 後ろのドアにへこみができた。 — لديهم بعجة في الباب الخلفي .",
 "凹む": "أَجْزَأَ (أَجْزَأَ القومُ: جَزَأَتْ إِبِلُهُمْ؛ أَجْزَأَ المرأَةُ: ولدت الإِنَاث)\nمثال: لا أدر لماذا بكيت هذا القدر كله. / فَقَدَ\nمثال: خسر توم وظيفته. / انخساف, هبوط أرضي (الانهيار المفاجئ لشيء ما في تجويف تحته)",
 "凹める": "تَجَوَّفَ",
 "凹レンズ": "عدسة مفرقة, عدسة مقعرة (عدسة تعمل على تفريق أو نشر شعاع الضوء المتوازي المار عبرها)",
 "凹凸": "تَفَاوُت, عَدَم اسْتِوَاء (صفة عدم التوازن) / اخْتِلَال التَّوَازُن, عَدَم تَنَاسُب (افتقار للتناسب؛ عدم توازن بين أجزاء الشيء)\nمثال: اختلال هرموني",
 "凹地": "أَجْوَف",
 "凹型": "تقعر (الخاصية التي يمتلكها الشكل المقعر)",
 "凹多角形": "مضلع مقعر (مضلع يوجد فيه خط مستقيم يقطعه في أربع نقاط أو أكثر)",
 "凹形": "تقعر (الخاصية التي يمتلكها الشكل المقعر)",
 "凹所": "تقعر (الخاصية التي يمتلكها الشكل المقعر)",
 "凹溜まり": "أَجْوَف",
 "凹版": "إنتاليو, نقش غائر (فن نحت يتكون من نقش أو نحت غائر أو منخفض على حجر أو جوهرة (عكس الكاميو))",
 "凹版印刷": "طباعة غائرة, غرافور (عملية طباعة تستخدم لوحاً محفوراً أو منقوشاً؛ يُلطخ اللوح بالحبر ويُمسح لينظف…)",
 "凹状": "تقعر (الخاصية التي يمتلكها الشكل المقعر)",
 "凹角": "داخل, منعكس ((للزوايا) تشير إلى الداخل)\nمثال: مضلع بزوايا منعكسة",
 "凹面": "تقعر (الخاصية التي يمتلكها الشكل المقعر) / مُقَعَّر, مُجَوَّف",
 "出": "تسرب, نضوح (خروج سائل من حاوية ما)\nمثال: حاولوا وقف تسرب الغاز من الأنبوب التالف / خادِم, مُعْتَنٍ (يُقَدِّم مُساعَدَة عَمَلِيَّة ورِعايَة) / نَجْمَة, اِبْتِدَاء\nمثال: بدأ سامي يتكلم. / مَنْشَأ / بَارِز, نَاشِئ (يظهر إلى الوجود؛ في طَوْر التكوُّن)",
 "出あう": "لَاقَى, لَقِيَ (لَقِيَ، صَادَفَ)\nمثال: لقد التقى بماري.",
 "出かける": "خَرَجَ (اِنْتَقَلَ إلى خارج المكان)\nمثال: خرج سامي ليحتفل.",
 "出かした": "أَحْسَنْتَ, أَحْسَنْتِ",
 "出かす": "فَعَلَ, عَمِلَ (عَمِلَ وصَنَعَ، بعلم أو بدون علم، عن قصد أو دون قصد)\nمثال: ماذا فعل للحمي؟",
 "出がらし": "تَافِه, سَخِيف (يفتقر إلى الأهمية أو التأثير)",
 "出くわす": "صَادَفَ (لَقِيَ، وَافَقَ، وَجَدَ؛ وَاجَهَ، لَاقَى، وَجَدَ)\nمثال: صادف مشكلا صعبا.",
 "出し": "ذَرِيعَة, عُذْر",
 "出した": "مَاضٍ, الْمَاضِي ((في النحو) زمن نحوي يدل على حدث قد وقع، أو وُجِد قبل الآن بوقت ما)",
 "出してくれる": "أَخْرَجَ",
 "出しぬけ": "فَجْأَةً",
 "出しゃばる": "تَطَفَّلَ, تَدَخَّلَ",
 "出し分け": "فَرَّقَ",
 "出し店": "كُشْك (هو الكِشْك في بعض اللهجات العربية؛ شبه رِوَاق بارز عن مساواة بقية البيت)",
 "出し惜しむ": "بُغْض, ضَغِينَة (البُغْض ضدّ الحبّ ، بغَض جَدُّك:كتعس جدّك،ونعِمَ الله بك عيناً وبغَض بعدوّك…)\nمثال: سأذهب بغض النظر عن مجيئه.",
 "出し抜け": "فَجْأَةً",
 "出し殻": "باحة, ساحة (الأرض المسيجة المحيطة بمنزل أو مبنى آخر)\nمثال: كان منزلاً صغيراً بلا فناء تقريباً",
 "出し汁": "مَرَق, مَرَقَة (الطَعَام سائل الخفيف فيه ماء اللحم وقد يكون فيه خضار أو غير ذلك. يؤكل عادة مع…)",
 "出し渋る": "بُغْض, ضَغِينَة (البُغْض ضدّ الحبّ ، بغَض جَدُّك:كتعس جدّك،ونعِمَ الله بك عيناً وبغَض بعدوّك…)\nمثال: سأذهب بغض النظر عن مجيئه.",
 "出し物": "بَرْنَامَج (عَرْضٌ (تلْفَزِيٌّ،…)؛ مُفَكَّرَةٌ يَوْمِيَّةٌ)\nمثال: نشط البرنامج الآن. / قِطْعَة (القِطْعَةُ: الْجُزْءَ أو الحِصَّة من الشيءِ؛ القِطْعَةُ: فقرة قصيرة عادة من…)\nمثال: يصنع قطعة أثاث خشبية.",
 "出し見世": "كُشْك (هو الكِشْك في بعض اللهجات العربية؛ شبه رِوَاق بارز عن مساواة بقية البيت)",
 "出し遅れ": "مُتَأَخِّر, مُتَلَكِّئ (بعد الوقت المتوقّع أو المعتاد؛ مُؤَجَّل)",
 "出す": "أَخْرَجَ / أَنْتَجَ (أَنْشَأَ شَيْئَا من شَيْءٍ، وَلَّدَه؛ الفرس أو الناقة: وَلَدَت) / نَشَرَ, أَصْدَرَ (بَسَطَ، فَرَّقَ، نَشَرَ الشيءَ: جعله منتشراً، مثل نشر الأخبار أو نشر كتاب…)\nمثال: نشر توم الغسيل. / أَرْسَلَ, بَعَثَ (بَعَثَ؛ أَطْلَقَ)\nمثال: هو أرسل لي هدية.",
 "出ず": "تَرَكَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد…)\nمثال: لقد ترك لك هذا. / بَلَغَ / ظَهَرَ (مصدر للفعل ظَهَرَ؛ خلاف البَطْن، الجزء الظَاهِر من الشيئ وغير البَاطِن)\nمثال: عنده حقيبة ظهر. / حَضَرَ (حضر: الحُضورُ: نَقِيضُ المَغيب والغَيْبةِ؛ حَضَرَ يَحْضُرُ حُضُورًا وحِضَارَةً…)\nمثال: حضر كل شيئ لرحلتي.",
 "出ず入らず": "مُعْتَدِل (الأمر الوسط بين الطَرَفْيَن، نقيض المُتَطَرِّف)",
 "出だし": "نَجْمَة, اِبْتِدَاء\nمثال: بدأ سامي يتكلم.",
 "出っこみ引っこみ": "شذوذ, مخالفة (سلوك يخرق القاعدة أو الإتيكيت أو العرف أو الأخلاق)",
 "出っぱり": "إِسْقَاط\nمثال: دفنت في مسقط رأسها.",
 "出っぱる": "مَشْرُوع (ما تُجِيزُه السلطة أو القانون أو أي قاعدة، جَائِز، قَانُونِيّ؛ مسعى مؤقت أي شيء…)\nمثال: هذا مشروع عظيم.",
 "出っ張り": "إِسْقَاط\nمثال: دفنت في مسقط رأسها.",
 "出っ張る": "مَشْرُوع (ما تُجِيزُه السلطة أو القانون أو أي قاعدة، جَائِز، قَانُونِيّ؛ مسعى مؤقت أي شيء…)\nمثال: هذا مشروع عظيم.",
 "出っ歯": "بروز الفك العلوي, تراكب العضة ((طب الأسنان) سوء إطباق تمتد فيه الأسنان العلوية بشكل غير طبيعي فوق الأسنان…)",
 "出っ端": "استهلال, انطلاق (الوقت الذي يفترض أن يبدأ فيه شيء ما)\nمثال: بدأوا بداية مبكرة",
 "出っ鼻": "استهلال, انطلاق (الوقت الذي يفترض أن يبدأ فيه شيء ما)\nمثال: بدأوا بداية مبكرة",
 "出づ": "تَرَكَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد…)\nمثال: لقد ترك لك هذا. / بَلَغَ / ظَهَرَ (مصدر للفعل ظَهَرَ؛ خلاف البَطْن، الجزء الظَاهِر من الشيئ وغير البَاطِن)\nمثال: عنده حقيبة ظهر. / حَضَرَ (حضر: الحُضورُ: نَقِيضُ المَغيب والغَيْبةِ؛ حَضَرَ يَحْضُرُ حُضُورًا وحِضَارَةً…)\nمثال: حضر كل شيئ لرحلتي.",
 "出ていく": "تَرَكَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد…)\nمثال: لقد ترك لك هذا.",
 "出ていけ": "اِبْتَعَدَ",
 "出てくる": "خَرَجَ (اِنْتَقَلَ إلى خارج المكان)\nمثال: خرج سامي ليحتفل.",
 "出てけ": "اِبْتَعَدَ",
 "出てゆく": "تَرَكَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد…)\nمثال: لقد ترك لك هذا.",
 "出て来る": "خَرَجَ (اِنْتَقَلَ إلى خارج المكان)\nمثال: خرج سامي ليحتفل.",
 "出て行く": "تَرَكَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد…)\nمثال: لقد ترك لك هذا.",
 "出て行け": "اِبْتَعَدَ",
 "出でる": "ذَهَبَ, رَاحَ (في : التِبْر، مَعْدِن ثَمِين أصْفَر اللَّوْنِ، هُوَ أَسَاسُ التَعَامُلِ…)\nمثال: ذهب إلى الدكان.",
 "出で湯": "يُنْبُوع حَارّ, مِيَاه حارَّة (ينبوع: عَيْنُ المَاءِ أو جَدْوَلٌ كَثِيرُ المَاءِ)\nمثال: ماء هذا الينبوع صافي.",
 "出で立ち": "لَبِسَ (خَلَطَ بحيث يصعب التمييز والفصل؛ الأمر: خلطه فاشتبه واضطرب)\nمثال: لبس سروالا نظيفا.",
 "出で立つ": "نَجْمَة, اِبْتِدَاء\nمثال: بدأ سامي يتكلم.",
 "出どころ": "مَصْدَر, مَصَادِر (مَصْدَر)\nمثال: ما مصدر هذا الخوف؟ / خُرُوج\nمثال: خرج سامي ليحتفل.",
 "出なおす": "عَفْواً!\nمثال: ماذا تريد الآن؟",
 "出る": "تَرَكَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد…)\nمثال: لقد ترك لك هذا. / بَلَغَ / ظَهَرَ (مصدر للفعل ظَهَرَ؛ خلاف البَطْن، الجزء الظَاهِر من الشيئ وغير البَاطِن)\nمثال: عنده حقيبة ظهر. / حَضَرَ (حضر: الحُضورُ: نَقِيضُ المَغيب والغَيْبةِ؛ حَضَرَ يَحْضُرُ حُضُورًا وحِضَارَةً…)\nمثال: حضر كل شيئ لرحلتي.",
 "出エジプト記": "سِفْر الْخَرُوج (السَّفَرُ : قَطْعُ المسافة؛ هو مِنِّي سفَرٌ : بعيد)",
 "出不精": "بَيْتُوتِيّ (شخص نادراً ما يذهب إلى أي مكان؛ شخص لا يميل للتجول أو السفر)",
 "出世": "تَرْقِيَة, تَرْفِيع\nمثال: もちろん私は自らの努力で出世するべきだという考えに賛成です。 — علنا، أنا مؤمن بأن عليك الارتقاء في حياتك بجهدك الشخصي.",
 "出世コース": "مسار سريع (وسيلة سريعة لتحقيق هدف)\nمثال: رأوا الاستقلال كمسار سريع للديمقراطية",
 "出世作": "عمل فني (فن هو نتاج أحد الفنون الجميلة (خاصة لوحة أو نحت ذو قيمة فنية))",
