 "初発": "نَجْمَة, اِبْتِدَاء\nمثال: بدأ سامي يتكلم.",
 "初登場": "إطلاق, تدشين (فعل البدء بشيء جديد)\nمثال: تطلعوا إلى الظهور الأول لخط إنتاجهم الجديد",
 "初穂": "قُرْبَان",
 "初穗": "قُرْبَان",
 "初等": "بَسِيط, غَيْر مُعَقَّد (سَهْل وَغَيْر مُعَقَّد أَوْ مُتَشَعِّب)\nمثال: الصفوف الابتدائية",
 "初等幾何学": "هندسة أولية, هندسة إقليدية (الهندسة القائمة على بديهيات إقليدس)",
 "初等教育": "تعليم ابتدائي (التعليم في المواد الأساسية (القراءة والكتابة والحساب) المقدم للطلاب الصغار في…)",
 "初等生": "مدرسة ابتدائية (مدرسة للأطفال الصغار؛ عادة ما تكون الصفوف الستة أو الثمانية الأولى)",
 "初等部": "مدرسة ابتدائية (مدرسة للأطفال الصغار؛ عادة ما تكون الصفوف الستة أو الثمانية الأولى)",
 "初級者": "مُبْتَدِئ, مُبْتَدِئَة (من يبتدئ في تعلّم علم أو فنّ، شخص قليل الخبرة)\nمثال: إنك محترف وأنا مبتدئ.",
 "初経": "بدء الحيض (أول حدوث للحيض عند المرأة)",
 "初舞台": "إطلاق, تدشين (فعل البدء بشيء جديد)\nمثال: تطلعوا إلى الظهور الأول لخط إنتاجهم الجديد",
 "初航海": "رحلة بحرية أولى (أول رحلة بحرية من نوعها)\nمثال: في عام 1912 غرقت سفينة تايتانيك في رحلتها الأولى",
 "初音": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "初頭": "بِدَايَة (في بِدَايَة الأمْرِ كانَ مُهَذَّباً : فِي أوّلِهِ؛ البِدَايَة والنِّهاية:…)\nمثال: هذه بداية جيدة.",
 "初飛行": "رحلة أولى, طلعة جوية أولى (أول رحلة من نوعها)\nمثال: قامت قاذفة الشبح برحلتها الأولى في عام 1989",
 "判": "فُقْمَة\nمثال: ختم سامي القرآن في شهر رمضان. / تقييم, حكم (فعل الحكم على أو تقييم شخص أو موقف أو حدث)\nمثال: انتقدوا حكمي على المتسابقين / مَقَاس, قِيَاس",
 "判じる": "قَاضٍ, قَاضِيَة\nمثال: حكم علي بالموت. / ذَابَ, حَلَّ (تحوّل الشيء من حالته الصلبة إلى حالة سائلة نتيجة الحرارة؛ زال أو تلاشى شيئًا…)\nمثال: ذاب ذلك الجليد. / إِلٰهِيّ\nمثال: هذا الرجل تاجر.",
 "判じ物": "لُغْز, مُعْضِلَة (قالَ كلامًا خفيًا أو غير واضح، أو استخدم التورية والإشارة؛ عبّرَ عن شيء بطريقة…)\nمثال: لم يحل أبدا لغز وفاتها.",
 "判ずる": "قَاضٍ, قَاضِيَة\nمثال: حكم علي بالموت. / ذَابَ, حَلَّ (تحوّل الشيء من حالته الصلبة إلى حالة سائلة نتيجة الحرارة؛ زال أو تلاشى شيئًا…)\nمثال: ذاب ذلك الجليد. / إِلٰهِيّ\nمثال: هذا الرجل تاجر.",
 "判で押したみたいに": "باستمرار, دائماً (بدون تنوع أو تغيير، في كل حالة)\nمثال: لطيف وكريم دائماً",
 "判で押したよう": "مُكَرَّر, نَمَطِيّ (يَفْتَقِرُ إِلَى العَفْوِيَّةِ أَوِ الأَصَالَةِ أَوِ التَّفَرُّد)",
 "判り": "فَهْم (فهم الأمر أو الكلام أو نحو ذلك، أدركه، علمه، أحسن تصوّره، استوعبه)\nمثال: لقد أسئت الفهم.",
 "判りにくい": "غامض, غير مفهوم (صعب الفهم)\nمثال: الشيء الأكثر غموضاً (عدم قابلية للفهم) في الكون هو أنه قابل للفهم",
 "判り難い": "غامض, غير مفهوم (صعب الفهم)\nمثال: الشيء الأكثر غموضاً (عدم قابلية للفهم) في الكون هو أنه قابل للفهم",
 "判る": "فَهِمَ (فهم الأمر أو الكلام أو نحو ذلك، أدركه، علمه، أحسن تصوّره، استوعبه)\nمثال: لقد أسئت الفهم. / أَظُنُّ ذٰلِك",
 "判事": "قَاضٍ, قَاضِيَة\nمثال: حكم علي بالموت.",
 "判例": "سَابِقَة (فِي : لَاصِقَة تزاد قبل الكلمة لتحويل مبناها وتغيير معناها. وهي وسيلة اقتصادية…)",
 "判例集": "كِتَابِيّ, نَمُوذَجِيّ (وفقًا لما هو مذكور في الكتب المرجعية أو يتسم بخصائصها؛ نموذجي)",
 "判別": "تَمْيِيْز",
 "判別がつく": "أَخْبَرَ, قَالَ (أَنْبَأَ، أَعْلَمَ)\nمثال: أخبر سامي أباه.",
 "判別が付く": "أَخْبَرَ, قَالَ (أَنْبَأَ، أَعْلَمَ)\nمثال: أخبر سامي أباه.",
 "判型": "تنسيق, شكل (المظهر العام لمنشور)",
 "判士": "قاضٍ عسكري, محامٍ عسكري (ضابط أركان يعمل كمستشار قانوني لقائد عسكري)",
 "判官": "قَاضٍ, قَاضِيَة\nمثال: حكم علي بالموت. / مُفَتِّش, مُفَتِّشَة",
 "判定": "تقييم, حكم (فعل الحكم على أو تقييم شخص أو موقف أو حدث)\nمثال: انتقدوا حكمي على المتسابقين",
 "判定基準": "مِعْيَار (العِيَار الذي يُقَاس به غيره، اسم آلة؛ قد يقصد به العِيَار)",
 "判定詞": "مُحَدِّد (من الفعل حَدَّدَ؛ (في الرياضيات) مصطلح يستعمل في الجبر الخطي، ويتم تحديد محدد…)\nمثال: حضر الجميع إلى الصف في الوقت المحدد",
 "判断": "تقييم, حكم (فعل الحكم على أو تقييم شخص أو موقف أو حدث)\nمثال: انتقدوا حكمي على المتسابقين / تنجيم, عرافة (فن أو موهبة النبوءة (أو ادعاء النبوءة) بوسائل خارقة للطبيعة)",
 "判断ミス": "حساب خاطئ, سوء تقدير (خطأ في الحساب)",
 "判断力": "تقييم, حكم (فعل الحكم على أو تقييم شخص أو موقف أو حدث)\nمثال: انتقدوا حكمي على المتسابقين",
 "判決": "حكم, قرار قضائي ((قانون) القرار الصادر عن محكمة مختصة بشأن المسائل المعروضة عليها)",
 "判然": "بوضوح (بدون شك أو تساؤل)\nمثال: كانوا تائهين بوضوح",
 "判示": "تقييم, حكم (فعل الحكم على أو تقييم شخص أو موقف أو حدث)\nمثال: انتقدوا حكمي على المتسابقين",
 "判者": "قَاضٍ, قَاضِيَة\nمثال: حكم علي بالموت.",
 "判読": "فك الترميز, فك التشفير (نشاط توضيح أو تحويل من رمز إلى نص عادي)\nمثال: مطلوب مفتاح سري أو كلمة مرور لفك التشفير",
 "判読しがたい": "غير مقروء ((لخط اليد، الطباعة، إلخ) لا يمكن قراءته)\nمثال: خط يد غير مقروء",
 "判読し難い": "غير مقروء ((لخط اليد، الطباعة، إلخ) لا يمكن قراءته)\nمثال: خط يد غير مقروء",
 "別": "تَمْيِيْز / فَصَلَ (التقطيع؛ تقسيم الشيء أجزاءً؛ جزء، باب في كِتَاب أو ماشابهه)\nمثال: اقرأ هذا الفصل. / اِسْتِثْنَاء / طِبْقًا لِـ, وَفْقًا لِـ / رَبّ (رَبَّ الولدَ يَرُبُّ رَبًّا: ولِيَه وتعهده بما يغذيه وينميه ويؤدّبه؛ الفاعل:…)\nمثال: اعتني بي يا رب.",
 "別々": "فَصَلَ (التقطيع؛ تقسيم الشيء أجزاءً؛ جزء، باب في كِتَاب أو ماشابهه)\nمثال: اقرأ هذا الفصل.",
 "別々に": "بشكل فردي, على حدة (بمعزل عن الآخرين)\nمثال: إذا أخذناها بشكل فردي، الغرف كانت مربعة",
 "別け": "تَقْسِيم\nمثال: الزواج قسمة و نصيب. / إِقْتِسَام, مُقَاسَمَة / دَلَجَ, غَرَفَ\nمثال: واصل زيري الرسم.",
 "別け前": "نَصِيب, حِصَّة\nمثال: لم يصب السهم توم.",
 "別して": "خُصُوصًا, خَاصَّةً",
 "別ち": "تَمْيِيْز",
 "別ち持つ": "نَصِيب, حِصَّة\nمثال: لم يصب السهم توم.",
 "別つ": "قَسَّمَ (فَرَّقَ أو قَسَّمَ الشَّيءَ إلى أجزاء أو أجزاء مختلفة؛ أَحْلَفَ، أَي جَعَلَ…)\nمثال: أنا أزين القسم. / نَصِيب, حِصَّة\nمثال: لم يصب السهم توم.",
 "別として": "غَيْر (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "別なく": "بصرف النظر, بغض النظر (على الرغم من كل شيء؛ دون اعتبار للعوائق)\nمثال: واصل العمل بغض النظر عن الصعوبات",
 "別に": "بشكل خاص, تحديداً (بدرجة أكبر بوضوح مما هو شائع)\nمثال: كان دقيقاً بشكل خاص حول التهجئة / بشكل فردي, على حدة (بمعزل عن الآخرين)\nمثال: إذا أخذناها بشكل فردي، الغرف كانت مربعة",
 "別にいいけど": "لَا يَهُمُّنِي (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر…)\nمثال: لا أحب المدرسة.",
 "別れ": "فِرَاقٌ / انحلال, انفصال (إنهاء أو تفكك علاقة (بين أشخاص أو دول))",
 "別れに臨ん": "فِرَاقٌ",
 "別れる": "جُزْء, جُزَء\nمثال: في أي دور تسكن؟ / فَصَلَ (التقطيع؛ تقسيم الشيء أجزاءً؛ جزء، باب في كِتَاب أو ماشابهه)\nمثال: اقرأ هذا الفصل. / فَقَدَ\nمثال: خسر توم وظيفته.",
 "別れを告げる": "وَدَّعَ",
 "別れ別れ": "فَصَلَ (التقطيع؛ تقسيم الشيء أجزاءً؛ جزء، باب في كِتَاب أو ماشابهه)\nمثال: اقرأ هذا الفصل.",
 "別れ目": "شَوْكَة, مِذْرَاة (أداة لتناول الطعام تتكون عادةً من مقبض وعدة أسنان حادة، وتُستعمل لغرز الطعام…)\nمثال: هناك شوكة ناقصة. / نقطة تحوّل (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه)\nمثال: هذه هي نقطة ضعفه.",
 "別れ話": "تَكَلَّمَ فِي, تَكَلَّمَ عَلَى (نُطْق؛ تَحَدُّث)\nمثال: أخذت تكلم الكلب.",
 "別れ道": "فَرْع, غُصْن / مُفْتَرَق, تَقَاطُع",
