 "四十九日": "اَلتَّاسِعُ وَالْأَرْبَعُونَ (العدد الترتيبي لتسعة وأربعين في العدّ)",
 "四十代": "أَرْبَعُونَ (يَدُلُّ عَلَى العَدَد 40) / أَرْبَعُون (العدد الأصلي الذي هو حاصل ضرب عشرة في أربعة)",
 "四千": "أَرْبَعَة آلَاف (أَرْبِعَة؛ أربعَة)\nمثال: مرت أربعة أيام.",
 "四半": "رُبُع (وقف وانتظر وتحبّس؛ الرجلُ: رفع الحجر بيده امتحانا لقوتّه) / حَارَة\nمثال: الساعة السادسة و الربع مساء.",
 "四半分": "رَابِع, رَابِعَة (رابعوا الحمِلَ مرابعة: أدخلوا المِربَعة تحتهُ)\nمثال: زيري هو الرابع.",
 "四半期": "رُبُع (وقف وانتظر وتحبّس؛ الرجلُ: رفع الحجر بيده امتحانا لقوتّه) / حَارَة\nمثال: الساعة السادسة و الربع مساء.",
 "四周": "أطراف, حد خارجي (الحد الخارجي أو سطح شيء ما)",
 "四和音": "أَرْبَعَة, رُبَاعِيّ (العدد الأصلي الذي هو مجموع ثلاثة وواحد)",
 "四回生": "طَاعِن فِي السِّنّ, مُسِنّ (متقدّم في العمر) / أرفع مقاماً, أقدم (أكبر سنًا؛ أعلى رتبة؛ أطول في مدة الولاية أو الخدمة) / أَكْبَر سِنّاً, مُسِنّ (شخص أكبر منك سناً) / طالب سنة نهائية (طالب جامعي خلال السنة التي تسبق التخرج)\nمثال: ضابط كبير",
 "四囲": "مُحِيط (في : هو الخط المستدير الذي يُحيط بالشكل الهندسي؛ في : البَحْر المُحِيْط هو البحر الكبير الذي يحيط بالقارات. الاستخدام الحديث يحذف كلمة بَحْر؛ القَامُوْس)\nمثال: أسبح في المحيط.",
 "四国": "شِيكُوكُو",
 "四国犬": "شِيكُوكُو",
 "四国稗": "دخن الإصبع, راجي (عشب حبوب من شرق الهند تنتج بذوره دقيقاً مراً نوعاً ما، وهو غذاء أساسي في الشرق)",
 "四塩化炭素": "رابع كلوريد الكربون (سائل عديم اللون غير قابل للاشتعال يستخدم كمذيب للدهون والزيوت؛ تراجع استخدامه كسائل تنظيف أو طفاية حريق بسبب سميته)",
 "四大": "جَسَد, جِسْمُ الإِنْسَان (أسماء بديلة لجسد الإنسان)\nمثال: درس ليوناردو جسم الإنسان",
 "四大不調": "مَرَض, دَاء (أصابه مرضٌ أو علّة أو سَقَم)\nمثال: هذا المرض قلبي.",
 "四大大会": "الدوري الرئيسي, الدوري الممتاز (أهم دوري في أي رياضة (خاصة البيسبول))",
 "四季報": "ربع سنوياً, كل ثلاثة أشهر (في فترات كل ثلاثة أشهر) / في أرباع الشعار (في أرباع متقابلة قطرياً من الشعار (في علم الشعارات)) / ربع سنوي (من أو يتعلق بربع (فترة زمنية) أو يتكون منه) / ربع سنوية, فصلية (دورية تصدر كل ربع سنة (أو أربعة أعداد في السنة))\nمثال: الفائدة مركبة ربع سنوياً",
 "四川": "سِيشْوَان, سِيتْشْوَان",
 "四川省": "سِيشْوَان, سِيتْشْوَان",
 "四年生": "فِي السَّنَةِ الرَّابِعَةِ (يُسْتَخْدَمُ لِوَصْفِ السَّنَةِ الرَّابِعَةِ وَالأَخِيرَةِ فِي المَدْرَسَةِ الثَّانَوِيَّةِ أَوِ الجَامِعَةِ الأَمْرِيكِيَّةِ)",
 "四度": "أربعة أضعاف (بمقدار أربعة أضعاف)\nمثال: ارتفع سعر البنزين أربعة أضعاف خلال العامين الماضيين",
 "四強": "متأهل لنصف النهائي (واحد من أربعة منافسين متبقين في بطولة بنظام الإقصاء)",
 "四念処": "وعي, يقظة ذهنية (سمة البقاء واعياً (إيلاء اهتمام وثيق) بمسؤولياتك)",
 "四手": "شجرة النير, نير (أي من الأشجار أو الشجيرات المتعددة من جنس النير)",
 "四才": "بِعُمُر أَرْبَع سَنَوَات (في عامه الرابع من العمر)",
 "四拍子": "زمن شائع, وزن رباعي (توقيع زمني يشير إلى أربع دقات في المقياس)",
 "四拾": "أَرْبَعُونَ",
 "四捨五入": "تَقْرِيب",
 "四捨五入機能": "تَقْرِيب",
 "四散": "بعثرة, نثر (عملية البعثرة) / تشتت, تفريق (الانتشار على نطاق واسع أو الطرد بعيداً) / رشراش, زخات خفيفة متفرقة (زخة خفيفة تسقط في بعض المواقع دون غيرها القريبة) / بعثرة, تشتت (العملية الفيزيائية التي تنحرف فيها الجسيمات عشوائياً نتيجة للتصادمات)",
 "四文字言葉": "كلمة نابية, لفظ فاحش (أي من عدة كلمات قصيرة (غالباً ما تكون من 4 أحرف في الإنجليزية) تُعتبر عموماً بذيئة أو مسيئة)",
 "四文字語": "كلمة نابية, لفظ فاحش (أي من عدة كلمات قصيرة (غالباً ما تكون من 4 أحرف في الإنجليزية) تُعتبر عموماً بذيئة أو مسيئة)",
 "四方": "مُحِيط (في : هو الخط المستدير الذي يُحيط بالشكل الهندسي؛ في : البَحْر المُحِيْط هو البحر الكبير الذي يحيط بالقارات. الاستخدام الحديث يحذف كلمة بَحْر؛ القَامُوْس)\nمثال: أسبح في المحيط. / هُنَا وَهُنَاكَ / مُرَبَّع (كُلُّ ما يُرَبَّعُ؛ كُلُّ ما له أربعة أركانٍٍ) / مثال: لا توجد مثلثات مربعة.",
 "四日熱": "ربعي (يحدث كل رابع يوم (خاصة الحمى والضعف الناجمين عن الملاريا)) / حمى الربع (حمى الملاريا التي تتكرر كل رابع يوم)\nمثال: ملاريا ربعية",
 "四旬節": "الصَّوْم الْأَرْبَعِينِيّ / اَلصَّوْم اَلْكَبِير",
 "四時": "اَلسَّاعَة اَلرَّابِعَة",
 "四月": "أَبْرِيل, نِيسَان (الشهر الرابع من السنة الميلادية الروميّة)\nمثال: أبريل شهر الرابع في السنة",
 "四月馬鹿": "كِذْبَةُ أَبْرِيل",
 "四本": "أَرْبَعَة, أَرْبَع (أَرْبِعَة؛ أربعَة)\nمثال: مرت أربعة أيام.",
 "四次元": "البعد الرابع, الزمن (الإحداثي الرابع المطلوب (إلى جانب الأبعاد المكانية الثلاثة) لتحديد حدث فيزيائي)",
 "四次元超立方体": "تسراكت, مكعب فائق (النظير رباعي الأبعاد للمكعب)",
 "四歳": "بِعُمُر أَرْبَع سَنَوَات (في عامه الرابع من العمر)",
 "四海": "اَلْبِحَار اَلسَّبْعَة",
 "四炭糖": "تتروز, سكر رباعي (أي سكر أحادي يحتوي على أربع ذرات كربون في الجزيء)",
 "四球": "مشي للقاعدة ((في البيسبول) تقدم الضارب للقاعدة الأولى بعد تلقي أربع رميات خارج منطقة الجزاء)\nمثال: تلاعب بالرامي للحصول على مشي للقاعدة",
 "四百": "أَرْبَعُمِئَة (يَدُلُّ عَلَى العَدَد 400)",
 "四種姓": "فارنا ((في الهندوسية) اسم التقسيم الاجتماعي الأصلي للشعب الفيدي إلى أربع مجموعات (والتي تنقسم إلى آلاف الطوائف))",
 "四糖": "سكر رباعي (أي من مجموعة متنوعة من الكربوهيدرات التي تنتج أربعة جزيئات من السكر الأحادي عند التحلل المائي الكامل)",
 "四肢動物": "رباعي الأطراف (حيوان فقاري له أربعة أقدام أو أرجل أو زوائد تشبه الأرجل)",
 "四肢麻痺": "شلل رباعي (شلل الذراعين والساقين)",
 "四行連": "رُبَاعِيّ",
 "四角": "رُبَاعِيّ الْأَضْلَاع / رُبَاعِيّ الْجَوَانِب",
 "四角い": "مُرَبَّع (كُلُّ ما يُرَبَّعُ؛ كُلُّ ما له أربعة أركانٍٍ) / مثال: لا توجد مثلثات مربعة.",
 "四角四面": "مُرَبَّع (كُلُّ ما يُرَبَّعُ؛ كُلُّ ما له أربعة أركانٍٍ) / مثال: لا توجد مثلثات مربعة.",
 "四角形": "رُبَاعِيّ الْأَضْلَاع / رُبَاعِيّ الْجَوَانِب",
 "四角柱": "منشور رباعي (منشور قاعدتاه أشكال رباعية)",
 "四角豆": "فاصوليا مجنحة, فول غوا (كرمة حولية درنية ملتفة تحمل عناقيد من الزهور الأرجوانية وقروناً بأربعة أجنحة مسننة؛ المناطق الاستوائية في العالم القديم)",
 "四足": "رُبَاعِيّ الأَرْجُل (لديه أربعة أقدام) / رباعي الأرجل (حيوان خاصة الثدييات له أربعة أطراف متخصصة للمشي)",
 "四足動物": "رباعي الأطراف (حيوان فقاري له أربعة أقدام أو أرجل أو زوائد تشبه الأرجل)",
 "四足獣": "رُبَاعِيّ الأَرْجُل (لديه أربعة أقدام) / رباعي الأرجل (حيوان خاصة الثدييات له أربعة أطراف متخصصة للمشي)",
 "四輪": "رباعي العجلات (مكون من أو متعلق بالمركبات ذات العجلات الأربع)\nمثال: دفع رباعي العجلات",
 "四輪車": "سَيَّارَة, أُوتُومُوبِيل (مؤنث سَيَّار، صفة للكثير السَيْر؛ القَافِلَة أوالقَوْم الذين يسيرون)\nمثال: إنه يملك سيارة.",
 "四輪駆動": "اَلدَّفْع اَلرَّبَاعِيّ",
 "四辺": "جوار, جيرة (أشخاص يعيشون بالقرب من بعضهم البعض) / جوار, منطقة مجاورة (منطقة محيطة أو قريبة)\nمثال: إنه حي ودود / حَدّ, حُدُود (مُنْتَهى الشيءِ؛ الْفَصْلُ بَيْنَ الشَّيْئَيْنِ لِئَلَّا يَخْتَلِطَ أَحدهما بِالْآخَرِ أَو لِئَلَّا يَتَعَدَّى أَحدهما عَلَى الْآخَرِ)\nمثال: أعرفها إلى حد ما.",
 "四辺形": "رُبَاعِيّ الْأَضْلَاع / رُبَاعِيّ الْجَوَانِب",
 "四辻": "مُفْتَرَق, تَقَاطُع",
 "四部作": "رُبَاعِيَّة",
 "四部合唱": "تناغم رباعي الأجزاء (تناغم يحتوي فيه كل كورد على أربع نغمات تخلق أربعة خطوط لحنية)",
 "四部合奏": "رباعي, كوارتيت (تأليف موسيقي لأربعة مؤديين) / رباعي, مجموعة رباعية (أربعة أشخاص يُنظر إليهم كوحدة واحدة) / رباعي (مجموعة من أربعة أشياء متشابهة تُعتبر كوحدة واحدة) / رباعي (أربعة مؤدين أو مغنين يؤدون معاً)\nمثال: انضم إلى رباعي غنائي",
 "四里四方": "إِيدُو",
 "四重": "أربعة أضعاف (بمقدار أربعة أضعاف) / أَرْبَعَةُ أَضْعَافٍ, رُبَاعِيُّ الضِّعْفِ (أربعة أمثال الكمية أو العدد) / رُبَاعِيّ (ذو أربع وحدات أو مكوّنات)\nمثال: ارتفع سعر البنزين أربعة أضعاف خلال العامين الماضيين",
 "四重苦": "أَرْبَعَةُ أَضْعَافٍ, رُبَاعِيُّ الضِّعْفِ (أربعة أمثال الكمية أو العدد) / رُبَاعِيّ (ذو أربع وحدات أو مكوّنات)",
 "四阿": "عريشة (هيكل يدعم النباتات المتسلقة) / عمود دوران, مغزل (أي من الأعمدة الدوارة المختلفة التي تعمل كمحاور لأجزاء دوارة أكبر) / شجرة (شجرة (في مقابل شجيرة))\nمثال: وفرت العريشة مكاناً ظليلاً للراحة في الحديقة",
 "四面体": "رباعي السطوح, هرم ثلاثي (أي متعدد سطوح له أربعة أوجه مستوية)",
 "四顧": "جِوَار, قُرْب / حَيّ (ضد المَيِّت، على قيد الحَيَاة؛ جمع حَيَاء) / جِوَار\nمثال: ينبح كلب في الحي.",
 "四駆": "اَلدَّفْع اَلرَّبَاعِيّ",
 "回": "وَقْت (\"بَقِيَ وَقْتاً عِنْدَهُ \" : أَيْ مِقْدَاراً مِنَ الزَّمَنِ؛ \"جَاءَ فِي الوَقْتِ الْمُنَاسِبِ \" : فِي اللَّحْظَةِ الْمُنَاسِبَةِ) / مَرَّة, مرة (مؤنث مُرّ، صفة ما كان بها مرارة) / حِين, وَقْت ((حَيَّنَه): جعل لَهُ حينا؛ (حَيَّنَ) الله فلَانا: لم يوفقه للرشاد)\nمثال: حان وقت الذهاب. / شوط ((بيسبول) واحد من تسعة أقسام للعب يكون لكل فريق خلالها دور في الضرب) / حَادِثَة, وَاقِعَة / حَلْقَة, حَلَقَة / هُوَي",
 "回々教": "الْإِسْلَام",
 "回し": "حِزَام, زُنَّار (خيط أو قطعة من جلد تستخدم لحَزْم النَبَات أو العِيدَان أو غيرها لتكوين حُزْمَة؛ النِطَاق، قطعة من الجِلْد الطَوِيل يلف حول الخَصْر إما ليمسك المَلابِس أو ليظهر الخصر) / سَيْر (أسَارَ، أي جعله يَسِير والفرق بين الإثنين أن سَيَّرَ فيها تكرار وأسارَ لا تكرار فيها؛ فلان من بَلَده أو مَوْطِنه: أخْرَجَه وأجْلاه)\nمثال: هذا حزام من الجلد. / وِشَاح / اِغْتِصَاب جَمَاعِيّ (أَخْذُ الشيء قَهْراً وَظُلْماً؛ اِسْتِخْدَامُ العُنْفِ مَعَ النساء لِنَيْلِ الحَاجَةِ مِنْهَن بِالرَّغْمِ عَنْهَن)\nمثال: تعرض زيري للاغتصاب.",
 "回し引き鋸": "منشار ترددي, منشار صابر (منشار آلي محمول بشفرة ترددية؛ يمكن استخدامه مع مجموعة متنوعة من الشفرات حسب التطبيق ونوع القطع؛ يحتوي عموماً على لوحة تركب على السطح الذي يتم قطعه)",
 "回し文": "دَائِرِيّ (المنسوب إلى الدَائِرَة بمعنى الشكل الهندسي، ويقصد به ما كان شكله كالدائرة)\nمثال: التفاحة دائرية الشكل.",
 "回し者": "جَاسُوس / تَجَسَّسَ / طُعم, مروّج مخادع (طُعم يتصرف كزبون متحمس من أجل تحفيز مشاركة الآخرين)",
 "回し車": "عَجَلَة / عجلة / رويضة",
 "回す": "دَارَ, أَدَارَ (المحل يجمع البِنَاء والعَرَصَة. قيل سمي كذلك لدوران الناس به وعليه وحوله. يجمع على دُور؛ المنزل المَبْني. يجمع على دُور) / لَفَّ / قَلَبَ / اِنْقَلَبَ, صَارَ / اِنْعِطَاف / دَوْر, نَوْبَة (جَعَله يَدُور؛ جَعَلَه مُدَوَّر)\nمثال: إذهب إلى الدار. / حَرُكَ, تَحَرَّكَ (غَيَّرَ مَوْضِعَهُ أو مَكَانَهُ أو حَالَه؛ حَرُكَ الوَلَدُ : تَحَرَّكَ، أَوْ خَرَجَ عَنْ سُكُونِهِ) / اِنْتَقَلَ, تَحَلْحَلَ\nمثال: لقد أوقفنا حركة المرور. / شَغَّلَ ((شَغَلَ) الدارَ يَشْغَلَ شَغْلًا: سكنها؛ شَغَلَ فلانًا عن الشيء: لَهَّاهُ وصرَفَه) / اِنْقَلَبَ عَلَى\nمثال: شغل بيل التلفاز. / وَضَعَ, حَطَّ (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه)\nمثال: لقد أزمت الوضع.",
 "回り": "دَوْرَة (في غرب العراق على نهر الفرات قرب الحدود السورية؛ حَيّ في جنوب بغداد تقع فيه محطة تكرير للنفط تسمّى بإسمه)\nمثال: خضع زيد لدورة مكثفة / انتشار, نشر (عملية الامتداد على نطاق أوسع أو مساحة من المكان أو الزمان) / إذاعة, نشر (فتح موضوع لمناقشة واسعة وجدل) / انتشار, تفشي (عملية أو نتيجة التوزيع أو الامتداد على مساحة واسعة من الفضاء) / تَأْثِير, أَثَر / بِوَاسِطَة, عَن طَرِيق / بِـ (الإلصاق: أمسكت بالشيء؛ الاستعانة: كتبت بالقلم)",
 "回りくどい": "غَيْر مُبَاشِر, مُلْتَوٍ (يَنْحَرِف عَنِ المَسَار المُسْتَقِيم) / غَيْر مُبَاشِر, مُلْتَوٍ (يَتَّسِم بِالمُوَارَبَة أَوْ عَدَم المُبَاشَرَة فِي الكَلَام أَوِ السُّلُوك)",
