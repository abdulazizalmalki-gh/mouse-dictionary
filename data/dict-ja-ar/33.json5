 "刻": "خَرْبَشَ / فترة, فترة زمنية (مقدار من الزمن)\nمثال: فترة زمنية تمتد لثلاثين عاماً / نَحْت (وهو القَطْع والبَري والنشر والقشر وتشكيل الخشب أو الحجر أو غيره؛ الشيء الذي…)\nمثال: من علمك نحت الخشب. / حزم, صرامة (عزم لا هوادة فيه) / وَقْت (\"بَقِيَ وَقْتاً عِنْدَهُ \" : أَيْ مِقْدَاراً مِنَ الزَّمَنِ؛ \"جَاءَ فِي…)\nمثال: حان وقت الذهاب.",
 "刻する": "نَحَتَ (وهو القَطْع والبَري والنشر والقشر وتشكيل الخشب أو الحجر أو غيره؛ الشيء الذي…)\nمثال: من علمك نحت الخشب. / نَشَرَ, أَصْدَرَ (بَسَطَ، فَرَّقَ، نَشَرَ الشيءَ: جعله منتشراً، مثل نشر الأخبار أو نشر كتاب…)\nمثال: نشر توم الغسيل.",
 "刻み": "مُتَصَنِّعٌ, مُتَكَلِّفٌ (مُتَصَنِّع في الرقة والتهذيب) / ضَرْب (معروف، وهو اللطم أو الدق أو الصكّ و ما أشبه؛ النَوْع أو الصنف أو المثال)\nمثال: ضرب سامي زوجته. / فَاصِل",
 "刻み値": "زيادة, علاوة (المقدار الذي يزداد به الشيء)\nمثال: اقترحوا زيادة بنسبة 15 في المائة في الأجرة",
 "刻み幅": "خطوة واسعة, قفزة (تقدم كبير (خاصة في عبارة 'قطع أشواطاً'))\nمثال: قطعوا أشواطاً كبيرة في الإنتاجية",
 "刻み目": "ثلم, حز (قطع صغير)\nمثال: كان هناك أربعة حزوز في مقبض مسدسه",
 "刻み込む": "نَحَتَ (وهو القَطْع والبَري والنشر والقشر وتشكيل الخشب أو الحجر أو غيره؛ الشيء الذي…)\nمثال: من علمك نحت الخشب.",
 "刻む": "لَحْم مَفْرُوم (ما يبقى من جسم الحيوان أو الإنسان بعد إزالة الجلد الأحشاء والعظم والشحم والدم…)\nمثال: أفضل لحم البقر. / نَحَتَ (وهو القَطْع والبَري والنشر والقشر وتشكيل الخشب أو الحجر أو غيره؛ الشيء الذي…)\nمثال: من علمك نحت الخشب. / عَذَاب",
 "刻下": "حَالِيّ, حَاضِر\nمثال: أنا موجود لوحدي",
 "刻印": "نَقْشْ (لوّن بلونين أو أكثر؛ زيَّن بأشكال أو ألوان) / عَلَامَة, شِعَار (سِمَةٌ أو أمارة أو شِعَار تُعرف به الأشياء؛ رَمْز)\nمثال: تحصلت على علامة أ.",
 "刻器": "منقاش, مِزمَل (إزميل من الفولاذ المقسى ذو طرف حاد؛ يستخدم للنقش)",
 "刻子": "زلاجة صندوقية (زلاجة يجرها حصان واحد تتكون من صندوق على زحافات)",
 "刻時機構": "سَاعَة, ساعة (ثُلْث ثُمْن اليَوْم بمعنى مجموع النَهَار واللَيْل، أي جزء من أربعة وعشرين جزءا…)\nمثال: درست لمدة ساعة.",
 "刻薄": "قَاسٍ, الْقَاسِي (شديد وصلب، غير لين؛ جافٍ أو يابس في الملمس أو التعامل)\nمثال: قاس طول السرير.",
 "刻限": "وَقْت (\"بَقِيَ وَقْتاً عِنْدَهُ \" : أَيْ مِقْدَاراً مِنَ الزَّمَنِ؛ \"جَاءَ فِي…)\nمثال: حان وقت الذهاب.",
 "剃り跡": "شُعَيْرَات اللِّحْيَة",
 "剃る": "حَلَقَ (أصاب حَلْقه أو ضربه في حلقه؛ أزال شعر رأسه أو ذقنه كله بالمُوسَى)\nمثال: حلق زيري لحيته.",
 "剃刀": "شَفْرَة حِلَاقَة / بَالِغ الوُضُوح (مُحَدَّد المَعَالِم بِوُضُوح شَدِيد)",
 "剃刀砥": "مسن دقيق (حجر شحذ مصنوع من الحجر الرملي الدقيق؛ يستخدم لشحذ شفرات الحلاقة)",
 "剃度": "حلاقة الترهب, طونسورة (حلاقة قمة الرأس من قبل الكهنة أو أعضاء الرهبنة)",
 "剃毛": "احتكاك, كشط (فعل الاحتكاك بشيء أثناء المرور)",
 "剃髪": "حلاقة الترهب, طونسورة (حلاقة قمة الرأس من قبل الكهنة أو أعضاء الرهبنة)",
 "剄る": "ضَرَبَ عُنُقَهُ (معروف، وهو اللطم أو الدق أو الصكّ و ما أشبه؛ النَوْع أو الصنف أو المثال)\nمثال: ضرب سامي زوجته. / نَار, نار (نارَتِ النارُ: أضاءَت؛ نَارَ النَّارَ مَنْ بَعِيدٍ : أَبْصَرَهَا، نَظَرَ…)\nمثال: سمعن طلقات نار.",
 "則": "قَانُون, قَاعِدَة (مقياس كل شيء وطريقه؛ أمر كليّ ينطبق على جميع جزئياته التي تعرف أحكامها منه)\nمثال: ذكرني بالقانون. / نَمُوذَج / مُنْحَدَر",
 "則る": "تَبِعَ, اِتَّبَعَ (تبِع الشيءَ: سار في إثرِه، تلاه؛ تبِعه تبَعًا: مرَّ به فمضى معه)\nمثال: تبع المشتبه محققان.",
 "削ぎ落とす": "أَجَاص",
 "削ぐ": "تفتيت, شطف (عملية شطف جزء من شيء ما) / شَحَذَ (سنّ شيئًا ليصبح حادًا أو أكثر قدرة على القطع؛ استثار أو حفّز قوة ذهنية أو…) / قَلَّلَ",
 "削げる": "انفصل / تخفيض, تقليل (عملية إنقاص أو تقليل شيء ما)\nمثال: كان هناك انخفاض في درجة حرارته مع هدوء الحمى",
 "削げ落とす": "أَجَاص",
 "削り": "احتكاك, كشط (فعل الاحتكاك بشيء أثناء المرور)",
 "削りかす": "احتكاك, كشط (فعل الاحتكاك بشيء أثناء المرور)",
 "削りくず": "احتكاك, كشط (فعل الاحتكاك بشيء أثناء المرور)",
 "削りクズ": "احتكاك, كشط (فعل الاحتكاك بشيء أثناء المرور)",
 "削り出す": "آلَة, مَاكِينَة (الفارسية: ماشين؛ الأوردية: مشين)\nمثال: نسى زيري الآلة.",
 "削り屑": "احتكاك, كشط (فعل الاحتكاك بشيء أثناء المرور)",
 "削り滓": "احتكاك, كشط (فعل الاحتكاك بشيء أثناء المرور)",
 "削り粕": "احتكاك, كشط (فعل الاحتكاك بشيء أثناء المرور)",
 "削る": "حَلَقَ (أصاب حَلْقه أو ضربه في حلقه؛ أزال شعر رأسه أو ذقنه كله بالمُوسَى)\nمثال: حلق زيري لحيته. / قَلَّلَ / حَذَفَ (حَذَفَ الشّيء:قطعه وأَسْقَطَه. حَذَفَ الْمُرَاجِعُ عِبَارَةً منَ الْخِطَابِ…)\nمثال: حذف ياني حسابه.",
 "削剥作用": "تعرية, كشف (إزالة الغطاء)",
 "削去": "تنحية, عزل (الفصل من منصب رسمي)\nمثال: أجرى عملية جراحية لإزالة ورم خبيث",
 "削器": "مِكْشَطة (أي من الأدوات اليدوية المختلفة للكشط)",
 "削岩機": "ريشة حفر الصخر, مثقاب الصخور (مثقاب لاختراق الصخور)",
 "削摩": "تعرية, كشف (إزالة الغطاء) / انحناءة مبالغ فيها (انحناء عميق مع سحب القدم للخلف (يدل على التواضع المفرط))\nمثال: كل ذلك الانحناء والتذلل لم يثر إعجابه",
 "削減": "جَرَحَ (كَلَمَ، شَقَّ اللَحْم وأسَالَ الدَمّ؛ صَادَ أو اكْتَسَبَ)\nمثال: ذلك سيهيج الجرح.",
 "削片": "شَظِيَّة",
 "削片板": "فايبر بورد, لوح حبيبي (لوح جداري يتكون من رقائق الخشب أو النشارة المترابطة مع الراتنج والمضغوطة في…)",
 "削進": "استخراج المعادن, تعدين (فعل استخراج الخامات أو الفحم وما إلى ذلك من الأرض)\nمثال: هناك حفر مثير للاهتمام يجري بالقرب من برينستون",
 "削除": "حذف, شطب (عملية حذف شيء مكتوب أو مطبوع)\nمثال: حذوفات المحرر كثيراً ما تزعج المؤلفين الشباب",
 "剋": "فترة, فترة زمنية (مقدار من الزمن)\nمثال: فترة زمنية تمتد لثلاثين عاماً / اِنْتِصَار, نَصْر / حزم, صرامة (عزم لا هوادة فيه)",
 "前": "نُقْطَة (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه)\nمثال: هذه هي نقطة ضعفه. / رَئِيس, رَئِيسَة / أَوَّل, أُولَى (الذي يكون ترتيبه وَاحِد، الذي كان قبل الآخرين؛ الأوَّل اسم من الأسماء الحسنى) / أماماً, في المقدمة (في أو في المقدمة)\nمثال: أرى أضواء مدينة أمامنا / آخِر (ضد الأوَّل؛ وهو من يكون ترتيبه بعد الجميع؛ الشيء: مؤخرّه، الجزء الآخير منه)\nمثال: أرني مثالا آخر. / قَبْلَ (وضع فمه على الشخص أو الشيء علامة الحب والاحترام. في العاميّة يُقال بَاسَ)\nمثال: كنت هنا من قبل. / أماماً, في المقدمة (في أو في المقدمة)\nمثال: أرى أضواء مدينة أمامنا / قَبْلَ (وضع فمه على الشخص أو الشيء علامة الحب والاحترام. في العاميّة يُقال بَاسَ)\nمثال: كنت هنا من قبل. / جَبْهَة / صَاعِدًا\nمثال: まっすぐ前を見てください。 — انظر امامك مباشره.",
 "前々": "قَدِيماً",
 "前々から": "دَائِمًا, أَبَدًا",
 "前々日": "أَوَّل أَمْس (الذي يكون ترتيبه وَاحِد، الذي كان قبل الآخرين؛ الأوَّل اسم من الأسماء الحسنى)\nمثال: لم تكن أول مرة.",
 "前かがみ": "انحناء, ترهل (انحناء القامة عند الوقوف والمشي)\nمثال: إنه ليس متكاسلاً عندما يتعلق الأمر بالبيسبول",
 "前かがみになる": "انحناء, ترهل (انحناء القامة عند الوقوف والمشي)\nمثال: إنه ليس متكاسلاً عندما يتعلق الأمر بالبيسبول",
 "前だれ": "مِرْيَلَة, مِئْزَر",
 "前のめり": "وِقَائِيّ, استباق الْأَحْدَاث / مُتَسَرِّع",
 "前ふり": "مُقَدِّمَة",
 "前ぶれ": "بَشِير, مُبَشِّر",
 "前もって": "سلفاً, مسبقاً (قبل الوقت؛ تحسباً)\nمثال: عندما تدفع مقدماً تحصل على خصم",
 "前を失礼します": "عَفْوًا!, مَاذَا قُلْتَ؟",
 "前カレ": "حبيب سابق (رجل لم يعد حبيباً لامرأة ما)",
 "前ジテ": "بَطَل, بَطَلَة",
 "前ピン": "بؤرة, تركيز (تركيز الانتباه أو الطاقة على شيء ما)\nمثال: تحول محور النشاط إلى البيولوجيا الجزيئية",
 "前世": "تَارِيخ قَدِيم (جملة الأَحوال والأحداث التي يمر بها كائن ما، ويَصْدق على الفرد والمجتمع، كما…)\nمثال: ما تاريخ اليوم؟",
 "前世紀": "أيام الخوالي (أوقات ماضية يتم تذكرها بحنين)",
