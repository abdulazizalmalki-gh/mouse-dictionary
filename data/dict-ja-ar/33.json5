 "助け": "مُسَاعَدَة, إِمْدَاد",
 "助けになる": "مُسَاعَدَة, مَعُونَة / مُسَاعِد, مُسَاعِدَة (مُعَاوِن، مُسَانِد، من يقوم بالمُسَاعَدَة؛ بمعنى مُفِيد، يقال هذا عامل مساعد وهذه مادة مساعدة) / سَاعَدَ, عَاوَنَ (عَاوَنَ، أَعَانَ) / مُسَاعَدَة, النَّجْدَة\nمثال: علي مساعدة ماري.",
 "助ける": "أَنْقَذَ, أَنْجَى / اِدَّخَرَ / حَفِظَ (الحِفْظُ نَقِيضُ النِّسْيَان، وهو التَّعَاهُدُ وقِلَّةُ الغَفْلَةِ؛ قِلَّةُ الغَفْلَةِ)\nمثال: حفظ رقم هاتفها. / مُسَاعَدَة, مَعُونَة / مُسَاعِد, مُسَاعِدَة (مُعَاوِن، مُسَانِد، من يقوم بالمُسَاعَدَة؛ بمعنى مُفِيد، يقال هذا عامل مساعد وهذه مادة مساعدة) / سَاعَدَ, عَاوَنَ (عَاوَنَ، أَعَانَ) / مُسَاعَدَة, النَّجْدَة\nمثال: علي مساعدة ماري. / دَعَمَ, دَعَّمَ (• دَعَمَهُ، كمنَعهُ: مالَ فأقامَهُ) / أَيَّدَ, دَعَمَ ((أَيَّدَه): قوّاه بالإياد) / تَأْيِيد, دَعْم\nمثال: ياني هنا لدعم ريمة. / سَهَّلَ (ضد الصَعْب، اليَسِير. لا جمع له؛ الشيء المُمَهَّد اللَيِّن. لا جمع له)\nمثال: هذا الشعور سهل.",
 "助け上げる": "قَطَفَ (قطفت الدّابّة قِطَافاً: أَبْطَأَتْ، في أمثالهم: (أَقْطَفُ من أرنب)؛ قَطَفَ الزّهرةَ: قطعها، قَطَفَ الثّمرَ: جناه وجمعه)\nمثال: أحب قطف الورود.",
 "助け出す": "أَنْقَذَ, خَلَّصَ / إِنْقَاذ",
 "助け合い": "تَعَاوُن",
 "助け合う": "تَعَاوَنَ",
 "助け守る": "حَمَى (حمَى الشيءُ فلانًا: منَعه ودفع عنه؛ حمى المريضَ: منعه ما يضره)\nمثال: ليس لديك أي حمى.",
 "助け平": "شهواني, فاسق (رجل لديه رغبات جنسية قوية)",
 "助け手": "مُسَاعِد, مُسَاعِدَة (مُعَاوِن، مُسَانِد، من يقوم بالمُسَاعَدَة؛ بمعنى مُفِيد، يقال هذا عامل مساعد وهذه مادة مساعدة)\nمثال: علي مساعدة ماري.",
 "助け舟": "قَارِب نَجَاةَ (الزَّورق؛ سفينة صغيرة)\nمثال: كان لسامي قارب صغير / مساعدة, يد العون (مساعدة جسدية)\nمثال: أعطني يد العون في الأعمال المنزلية",
 "助け船": "قَارِب نَجَاةَ (الزَّورق؛ سفينة صغيرة)\nمثال: كان لسامي قارب صغير / مساعدة, يد العون (مساعدة جسدية)\nمثال: أعطني يد العون في الأعمال المنزلية",
 "助っ人": "مُسَاعِد, مُسَاعِدَة (مُعَاوِن، مُسَانِد، من يقوم بالمُسَاعَدَة؛ بمعنى مُفِيد، يقال هذا عامل مساعد وهذه مادة مساعدة)\nمثال: علي مساعدة ماري.",
 "助兵衛": "شَبَق",
 "助兵衛根性": "فَحْشَاء, فِسْق / جَشَع, طَمَع (اِسْمٌ وَصِفَةٌ لِلْأَسَد)\nمثال: كان مارك يميل للجشع.",
 "助剤": "مُساعِد, مُعَزِّز (يُعَزِّز فِعْل العِلاج الطِّبِّيّ) / إِضَافِيّ, مُسَاعِد (يقدم دعمًا إضافيًا) / عامل مساعد, مادة مساعدة (مادة مضافة تعزز فعالية العلاج الطبي)",
 "助力": "مُسَاعَدَة, إِمْدَاد",
 "助動詞": "فعل مساعد (فعل يندمج مع فعل آخر في عبارة فعلية للمساعدة في تشكيل الزمن أو الصيغة أو البناء أو الشرط للفعل الذي يندمج معه)",
 "助勢": "تشجيع, دعم (فعل إعطاء الأمل أو الدعم لشخص ما) / تشجيع (التعبير عن الموافقة والدعم) / تشجيع (الشعور بالتشجيع)",
 "助命": "رأفة, رحمة (التساهل والرحمة التي يظهرها تجاه المخالفين شخص أو وكالة مكلفة بإقامة العدل) / اعتدال (طقس جيد مع درجات حرارة مريحة)",
 "助変数": "وَسِيط, بَارَامِتِر / مَعْلَم, وَسِيط (من يمتهن التعليم، مُدَرِّس)\nمثال: هي أصبحت معلمة.",
 "助太刀": "مُسَاعَدَة, إِمْدَاد / مُسَاعِد, مُسَاعِدَة (مُعَاوِن، مُسَانِد، من يقوم بالمُسَاعَدَة؛ بمعنى مُفِيد، يقال هذا عامل مساعد وهذه مادة مساعدة)\nمثال: علي مساعدة ماري.",
 "助奏": "أوبليغاتو, لحن إلزامي (جزء من المدونة الموسيقية يجب أداؤه دون تغيير أو حذف) / أوبليجاتو, لحن ملازم (موتيف مستمر ولكنه ثانوي)",
 "助平": "شَبَق",
 "助平根性": "فَحْشَاء, فِسْق / جَشَع, طَمَع (اِسْمٌ وَصِفَةٌ لِلْأَسَد)\nمثال: كان مارك يميل للجشع.",
 "助成": "تمريرة حاسمة, مساعدة ((رياضة) فعل تمكين لاعب آخر من القيام بلعبة جيدة) / إعانة, عون (نشاط المساهمة في تلبية حاجة أو تعزيز جهد أو غرض ما)\nمثال: قدم لي مساعدة في الأعمال المنزلية",
 "助成金": "إِعَانَة مَالِيَّة",
 "助手": "مُسَاعِد, مُسَاعِدَة (مُعَاوِن، مُسَانِد، من يقوم بالمُسَاعَدَة؛ بمعنى مُفِيد، يقال هذا عامل مساعد وهذه مادة مساعدة)\nمثال: علي مساعدة ماري.",
 "助手席": "مقعد الراكب (كل ما يُقْعَدُ ويُجْلَسُ عليه؛ مَكَان القُعُود)\nمثال: نام ياني على مقعد.",
 "助教": "أستاذ مساعد (معلم برتبة أقل من أستاذ مشارك)",
 "助教授": "أستاذ مساعد (معلم برتبة أقل من أستاذ مشارك)",
 "助数詞": "عَدَّاد",
 "助産": "قَبَالَة",
 "助産婦": "قَابِلَة, دَايَة",
 "助産師": "قَابِلَة, دَايَة",
 "助産院": "مُسْتَشْفَى وِلَادَة (اسم مفعول من الفعل \"اسْتَشْفَى\")\nمثال: أعمل في مستشفى.",
 "助祭": "شَمَّاس",
 "助触媒": "مُرَوِّج",
 "助言": "نَصِيحَة, مَشُورَة",
 "助言者": "مستشار, ناصح (خبير يقدم المشورة)\nمثال: ساعد مستشار الطلاب في اختيار دوراتهم",
 "助詞": "جُسَيْم, ذَرَّة (في الفيزياء: الجُسيْمات التحت ذريّة، أي الجُسيْمات الأوليّة والمركّبة (معنى مستحدث)) / جُسَيْم (في الفيزياء: الجُسيْمات التحت ذريّة، أي الجُسيْمات الأوليّة والمركّبة (معنى مستحدث))\nمثال: نحن نعيش بعض اللحظات الحزينة حقا لأن بلادنا عانت من خسارة جسيمة. وسوف يستغرق وقتا طويلا قبل أن تعود إلى مجدها السابق.",
 "助走": "ركضة الاقتراب (الركض التقريبي الذي يكتسب خلاله الرياضي السرعة) / تراكم, صعود سريع (زيادة كبيرة خلال فترة زمنية قصيرة نسبياً)\nمثال: صعود سريع في أسعار الفائدة",
 "助辞": "جُسَيْم, ذَرَّة (في الفيزياء: الجُسيْمات التحت ذريّة، أي الجُسيْمات الأوليّة والمركّبة (معنى مستحدث)) / جُسَيْم (في الفيزياء: الجُسيْمات التحت ذريّة، أي الجُسيْمات الأوليّة والمركّبة (معنى مستحدث))\nمثال: نحن نعيش بعض اللحظات الحزينة حقا لأن بلادنا عانت من خسارة جسيمة. وسوف يستغرق وقتا طويلا قبل أن تعود إلى مجدها السابق.",
 "助酵素": "إنزيم مساعد, مرافق إنزيم (جزيء صغير (ليس بروتيناً ولكن أحياناً فيتامين) ضروري لنشاط بعض الإنزيمات)",
 "助野": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "助長": "تَرْقِيَة, تَرْفِيع / تَرْوِيج / تَرْقِيَة / إساءة, خدمة سيئة (فعل يُقصد به المساعدة ولكن نتائجه تكون سيئة)\nمثال: لقد أساء إليهم",
 "努": "أَبَدًا",
 "努々": "بِالتَّأْكِيد / بِالتَّأْكِيد, بِدُون شَكّ / قَلِيلًا / بِجِدّ",
 "努めて": "قَدْر اَلْمُسْتَطَاع, قَدْر اَلْإِمْكَان (قضاء الله وحكمه وما قَدَّرَه؛ مبلغ الشيء وكميتّه، بنفس معنى قَدْر)\nمثال: خذ قدر ما تريد.",
 "努める": "مُحَاوَلَة, غَايَة (بذل الجهد أو السعي لتحقيق هدف أو الوصول إلى نتيجة معينة؛ التجربة أو القيام بشيء ما للحصول على نتيجة مرغوبة)\nمثال: كف عن المحاولة.",
 "努力": "جَهْد, جُهْد (بَذَلَ قُصَارَى جُهْدِهِ فِي أَمْرٍ مَا؛ أَتْعَبَ نَفْسَهُ أو غَيْرَهُ بِعَمَلٍ شَاقٍ)\nمثال: لا إنجاز بلا جهد .",
 "努力家": "عامل كادح (شخص يعمل بجد مثل العبد)",
 "努力目標": "تَحَدٍّ, التَّحَدِّي",
 "努努": "بِالتَّأْكِيد / بِالتَّأْكِيد, بِدُون شَكّ / قَلِيلًا / بِجِدّ",
 "劫": "إغماء, ضربة قاضية (ضربة تفقد الخصم وعيه)",
 "劫掠": "غَزَاوَة",
 "劫略": "غَزَاوَة",
 "劫盗": "سَرِقَة, لُصُوصِيَّة",
 "劫臈": "دهر, سنوات (فترة زمنية طويلة)\nمثال: نحن نعرف بعضنا منذ دهر",
 "劫臘": "دهر, سنوات (فترة زمنية طويلة)\nمثال: نحن نعرف بعضنا منذ دهر",
 "劫﨟": "دهر, سنوات (فترة زمنية طويلة)\nمثال: نحن نعرف بعضنا منذ دهر",
 "励まし": "تشجيع, دعم (فعل إعطاء الأمل أو الدعم لشخص ما) / تشجيع (التعبير عن الموافقة والدعم) / تشجيع (الشعور بالتشجيع)",
 "励ます": "شَجَّعَ (حفَّز شخصًا أو دعمه لتحقيق هدف أو القيام بعمل؛ بثَّ الحماس أو الثقة في نفس شخص)\nمثال: شجع سامي ليلى لتفعل ذلك. / رَفَعَ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ)\nمثال: رفع سامي نظارته.",
 "励み": "تشجيع, دعم (فعل إعطاء الأمل أو الدعم لشخص ما) / تشجيع (التعبير عن الموافقة والدعم) / تشجيع (الشعور بالتشجيع)",
 "励み合い": "مُنَافَسَة, مُبَارَاة / مُنَافَسَة, مُسَابَقَة",
 "励む": "كَافَحَ, اِجْتَهَدَ / جَاهَدَ",
 "励弧": "إثارة, تهيج (شيء يسبب الاضطراب والإثارة) / استثارة, تهيج (الاستثارة العصبية أو الكهربائية لعضو أو عضلة أو غدة) / إثارة, انفعال (حالة الاستثارة العاطفية والانفعال)\nمثال: تطلع إلى إثارة اليوم",
 "励振": "إثارة, تهيج (شيء يسبب الاضطراب والإثارة) / استثارة, تهيج (الاستثارة العصبية أو الكهربائية لعضو أو عضلة أو غدة) / إثارة, انفعال (حالة الاستثارة العاطفية والانفعال)\nمثال: تطلع إلى إثارة اليوم",
 "励磁": "إثارة, تهيج (شيء يسبب الاضطراب والإثارة) / استثارة, تهيج (الاستثارة العصبية أو الكهربائية لعضو أو عضلة أو غدة) / إثارة, انفعال (حالة الاستثارة العاطفية والانفعال)\nمثال: تطلع إلى إثارة اليوم",
 "励精": "اِجْتِهَاد",
 "励起": "إثارة, تهيج (شيء يسبب الاضطراب والإثارة) / استثارة, تهيج (الاستثارة العصبية أو الكهربائية لعضو أو عضلة أو غدة) / إثارة, انفعال (حالة الاستثارة العاطفية والانفعال)\nمثال: تطلع إلى إثارة اليوم / إثارة, مداعبة (الملاطفة الجنسية المتبادلة قبل الجماع) / تحفيز, تنشيط (فعل استنهاض كائن حي للعمل) / مثير, محفز (أي معلومة أو حدث محفز؛ يعمل على إثارة العمل) / تحفيز, تنبيه ((في علم وظائف الأعضاء) تأثير منبه (على الأعصاب أو الأعضاء وما إلى ذلك))",
 "労": "شغل, عمل (عمل منتج (خاصة العمل البدني المنجز مقابل أجر)) / مسعى, مشروع (أي قطعة عمل يتم الاضطلاع بها أو محاولتها) / وزارة العمل (الإدارة الفيدرالية المسؤولة عن تعزيز ظروف عمل أصحاب الأجور في الولايات المتحدة؛ أنشئت عام 1913) / الطبقة العاملة, بروليتاريا (طبقة اجتماعية تضم الذين يقومون بعمل يدوي أو يعملون مقابل أجر)\nمثال: لم يتطلب عمله قدراً كبيراً من المهارة",
 "労い": "شُكْرًا",
 "労き": "أَلَمٌ (الوَجَع) / آلَمَ, يُؤْلِمُ (سبَّبَ أَلَمًا حسّيًّا أو وجعًا في الجسد؛ سَبَّبَ له الألَم)\nمثال: ألم أقل لك ذلك؟ / مَرَض, دَاء (أصابه مرضٌ أو علّة أو سَقَم)\nمثال: هذا المرض قلبي.",
 "労しい": "مُحْزِن, مُفْجِع (يسبب أو يتسم بالحزن الشديد أو الكرب)",
 "労する": "عَمَل, شُغْل (فِعْل، صُنْع؛ وسيلة للكسب، مِهْنَة، حِرْفَة) / مُصَنَّف, مُؤَلَّف / سَارَ (مَشَى)\nمثال: المهم هو العمل.",
 "労せずして": "بِسُهُولَة",
 "労たし": "فَاتِن, جَذَّاب",
 "労り": "تَعَاطُف / عَطْف (عِطْف: عُنُق، رَقبة؛ الجمع: أَعْطَافٌ، و عِطَافٌ، و عُطُوفٌ) / حُنُو / خِدْمَة / مَرَض, دَاء (أصابه مرضٌ أو علّة أو سَقَم)\nمثال: هذا المرض قلبي.",
 "労る": "شَفَقَة (وشَفِقَ على؛ الرحمة والعَطْف والحَنَان والحُنُوّ) / شَفِقَ ((شَفِقَ) منه، وعليه يَشْفَقَ شَفَقًا: خاف وحَذِرَ، فهو شَفِقٌ؛ (شَفِقَ) عليه: رَقَّ له وعطف عليه؛ فهو شَفِيقٌ)\nمثال: زيري مثير للشفقة. / مُمَرِّض / مُمَرِّضَة / ممرض / أَرْضَعَ ((أَرْضَعَت) الْأُم: كَانَ لَهَا ولد تُرْضِعه؛ (أَرْضَعَت) الْولد: جعلته يرضع فَهِيَ مرضع ومرضعة (ج) مراضع) / مَرَّضَ (أصابه مرضٌ أو علّة أو سَقَم)\nمثال: هذا المرض قلبي. / قَدَّرَ (قضاء الله وحكمه وما قَدَّرَه؛ مبلغ الشيء وكميتّه، بنفس معنى قَدْر) / عَلِمَ (أَدْرَكَ حقيقة الشيء) / رَفَعَ قِيمَة, زَادَ فِي قِيمَة (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ)\nمثال: خذ قدر ما تريد.",
 "労わる": "شَفَقَة (وشَفِقَ على؛ الرحمة والعَطْف والحَنَان والحُنُوّ) / شَفِقَ ((شَفِقَ) منه، وعليه يَشْفَقَ شَفَقًا: خاف وحَذِرَ، فهو شَفِقٌ؛ (شَفِقَ) عليه: رَقَّ له وعطف عليه؛ فهو شَفِيقٌ)\nمثال: زيري مثير للشفقة. / مُمَرِّض / مُمَرِّضَة / ممرض / أَرْضَعَ ((أَرْضَعَت) الْأُم: كَانَ لَهَا ولد تُرْضِعه؛ (أَرْضَعَت) الْولد: جعلته يرضع فَهِيَ مرضع ومرضعة (ج) مراضع) / مَرَّضَ (أصابه مرضٌ أو علّة أو سَقَم)\nمثال: هذا المرض قلبي. / قَدَّرَ (قضاء الله وحكمه وما قَدَّرَه؛ مبلغ الشيء وكميتّه، بنفس معنى قَدْر) / عَلِمَ (أَدْرَكَ حقيقة الشيء) / رَفَعَ قِيمَة, زَادَ فِي قِيمَة (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ)\nمثال: خذ قدر ما تريد.",
 "労作": "كَدْح / تَعِبَ, كَدَحَ (تعِب:ضدّ استراح؛ التَّعَبُ: شدَّةُ العَنَاءِ ضدُّ الراحَة، تَعب يَتْعَبُ تَعَباً: أَعْيَا)\nمثال: شعر توم بالتعب.",
 "労作唄": "أغنية عمل (أغنية إيقاعية عادة لمصاحبة العمل المتكرر)",
 "労作歌": "أغنية عمل (أغنية إيقاعية عادة لمصاحبة العمل المتكرر)",
 "労働": "شغل, عمل (عمل منتج (خاصة العمل البدني المنجز مقابل أجر)) / مسعى, مشروع (أي قطعة عمل يتم الاضطلاع بها أو محاولتها) / وزارة العمل (الإدارة الفيدرالية المسؤولة عن تعزيز ظروف عمل أصحاب الأجور في الولايات المتحدة؛ أنشئت عام 1913) / الطبقة العاملة, بروليتاريا (طبقة اجتماعية تضم الذين يقومون بعمل يدوي أو يعملون مقابل أجر)\nمثال: لم يتطلب عمله قدراً كبيراً من المهارة / حزب العمال (حزب سياسي يسار الوسط تم تشكيله لتمثيل مصالح العمال العاديين) / حزب العمال البريطاني (حزب سياسي تشكل في بريطانيا العظمى عام 1900؛ يتميز بتعزيز مصالح العمل وسابقاً تأميم الصناعات الرئيسية)",
 "労働争議": "ضَرَبَ (معروف، وهو اللطم أو الدق أو الصكّ و ما أشبه؛ النَوْع أو الصنف أو المثال) / إِضْرَاب\nمثال: ضرب سامي زوجته.",
 "労働人口": "أيدي عاملة, قوة عاملة (قوة العمال المتاحة)",
 "労働党": "حزب العمال (حزب سياسي يسار الوسط تم تشكيله لتمثيل مصالح العمال العاديين) / حزب العمال البريطاني (حزب سياسي تشكل في بريطانيا العظمى عام 1900؛ يتميز بتعزيز مصالح العمل وسابقاً تأميم الصناعات الرئيسية)",
 "労働力": "شغل, عمل (عمل منتج (خاصة العمل البدني المنجز مقابل أجر)) / مسعى, مشروع (أي قطعة عمل يتم الاضطلاع بها أو محاولتها) / وزارة العمل (الإدارة الفيدرالية المسؤولة عن تعزيز ظروف عمل أصحاب الأجور في الولايات المتحدة؛ أنشئت عام 1913) / الطبقة العاملة, بروليتاريا (طبقة اجتماعية تضم الذين يقومون بعمل يدوي أو يعملون مقابل أجر)\nمثال: لم يتطلب عمله قدراً كبيراً من المهارة",
 "労働力人口": "قوى عاملة, يد عاملة (مصدر الأشخاص المدربين الذين يمكن توظيفهم عمالاً)",
 "労働力率": "قوى عاملة, يد عاملة (مصدر الأشخاص المدربين الذين يمكن توظيفهم عمالاً)",
 "労働協約": "اتفاقية جماعية, عقد عمل جماعي (عقد بين العمال والإدارة ينظم الأجور والمزايا وظروف العمل)",
 "労働収容所": "مخيم عمل قسري, معسكر عمل (مؤسسة عقابية للسجناء السياسيين الذين يستخدمون كعمالة قسرية)",
 "労働契約": "اتفاقية جماعية, عقد عمل جماعي (عقد بين العمال والإدارة ينظم الأجور والمزايا وظروف العمل)",
 "労働寄生": "دغريات",
 "労働市場": "سُوق عَمَل, سُوق الْعَمَل (مكان للبيع والشراء؛ جمع ساق، قال الله تعالى: 《رُدُّوهَا عَلَيَّ فَطَفِقَ مَسْحًا بِالسُّوقِ وَالْأَعْنَاقِ》)\nمثال: ذهبت إلى السوق.",
 "労働日": "يَوْم عَمَل (فترة من الزمان تبدأ عند غُرُوب الشمس وتنتهي عند غُرُوب شمس النهار التالي ويشمل اللَيْلَة ونَهَارا. طوله أربع وعشرين سَاعَة؛ النَهَار، يبدأ من طلوع الفَجْر إلى غُرُوب الشَمس، على المجاز) / يَوْم الْعَمَل (فترة من الزمان تبدأ عند غُرُوب الشمس وتنتهي عند غُرُوب شمس النهار التالي ويشمل اللَيْلَة ونَهَارا. طوله أربع وعشرين سَاعَة؛ النَهَار، يبدأ من طلوع الفَجْر إلى غُرُوب الشَمس، على المجاز)\nمثال: طقس اليوم جميل.",
 "労働服": "ملابس عمل (ملابس تلبس للقيام بعمل يدوي)",
 "労働歌": "أغنية عمل (أغنية إيقاعية عادة لمصاحبة العمل المتكرر)",
 "労働法": "قانون العمل (مقياس كل شيء وطريقه؛ أمر كليّ ينطبق على جميع جزئياته التي تعرف أحكامها منه)\nمثال: ذكرني بالقانون.",
 "労働祭": "عيد العمال (عطلة للاحتفال بالعمال وتكريمهم)",
 "労働節": "عيد العمال (عطلة للاحتفال بالعمال وتكريمهم)",
 "労働紹介所": "وَكَالَة تَوْظِيف",
 "労働組合": "اتحاد عمالي, نقابة (منظمة للموظفين تشكلت للتفاوض مع صاحب العمل)\nمثال: عليك الانضمام إلى النقابة للحصول على وظيفة",
 "労働組合法": "اتحاد عمالي, نقابة (منظمة للموظفين تشكلت للتفاوض مع صاحب العمل)\nمثال: عليك الانضمام إلى النقابة للحصول على وظيفة",
 "労働者": "عَامِل, عَامِلَة (الذي يَعْمَل أو الذي عَمِلَ؛ هو الذي وَلاه السُلْطَان على أمر من أمور الدولة. الجمع عمَال)\nمثال: توم عامل نفايات.",
 "労働者党": "حزب العمال (حزّب القومَ:جعلهم أحزاباً ، قوّاهم ، جعلهم من حزبه؛ حَزَّبْتُ القُرْآنَ: جَعَلْتُه أَحْزَاباً)\nمثال: التحقت بذلك الحزب.",
 "労働者階級": "اَلطَّبَقَة الْعَامِلَة",
 "労働許可証": "تصريح عمل (وثيقة قانونية تعطي المعلومات المطلوبة لتوظيف أشخاص معينين في بلدان معينة)",
 "労働運動": "حركة النقابات, حركة عمالية (محاولة منظمة من قبل العمال لتحسين وضعهم عن طريق العمل الموحد (خاصة عبر النقابات العمالية))",
 "労働階級": "اَلطَّبَقَة الْعَامِلَة",
 "労働集約的産業": "كَثِيفُ العَمَالَة (يتطلّب إنفاقاً كبيراً من العمل البشري دون رأس مال كثير)",
 "労力": "مَخَاض / عَمَلَ (فِعْل، صُنْع؛ وسيلة للكسب، مِهْنَة، حِرْفَة)\nمثال: المهم هو العمل.",
 "労務": "شغل, عمل (عمل منتج (خاصة العمل البدني المنجز مقابل أجر)) / مسعى, مشروع (أي قطعة عمل يتم الاضطلاع بها أو محاولتها) / وزارة العمل (الإدارة الفيدرالية المسؤولة عن تعزيز ظروف عمل أصحاب الأجور في الولايات المتحدة؛ أنشئت عام 1913) / الطبقة العاملة, بروليتاريا (طبقة اجتماعية تضم الذين يقومون بعمل يدوي أو يعملون مقابل أجر)\nمثال: لم يتطلب عمله قدراً كبيراً من المهارة",
 "労務者": "عَامِل, عَامِلَة (الذي يَعْمَل أو الذي عَمِلَ؛ هو الذي وَلاه السُلْطَان على أمر من أمور الدولة. الجمع عمَال)\nمثال: توم عامل نفايات.",
 "労咳": "تدرن رئوي, سل رئوي (يشمل الرئتين مع هزال تدريجي للجسم)",
 "労役": "كَدْح / تَعِبَ, كَدَحَ (تعِب:ضدّ استراح؛ التَّعَبُ: شدَّةُ العَنَاءِ ضدُّ الراحَة، تَعب يَتْعَبُ تَعَباً: أَعْيَا)\nمثال: شعر توم بالتعب.",
 "労災": "أثناء العمل, وظيفي (متعلق بـ أو مرتبط بوظيفة أو توظيف)\nمثال: تدريب أثناء العمل",
 "労症": "تابس, هزال (هزال الجسم أثناء مرض مزمن)",
 "労組": "اتحاد عمالي, نقابة (منظمة للموظفين تشكلت للتفاوض مع صاحب العمل)\nمثال: عليك الانضمام إلى النقابة للحصول على وظيفة",
 "労組法": "اتحاد عمالي, نقابة (منظمة للموظفين تشكلت للتفاوض مع صاحب العمل)\nمثال: عليك الانضمام إلى النقابة للحصول على وظيفة",
 "労苦": "شغل, عمل (عمل منتج (خاصة العمل البدني المنجز مقابل أجر)) / مسعى, مشروع (أي قطعة عمل يتم الاضطلاع بها أو محاولتها) / وزارة العمل (الإدارة الفيدرالية المسؤولة عن تعزيز ظروف عمل أصحاب الأجور في الولايات المتحدة؛ أنشئت عام 1913) / الطبقة العاملة, بروليتاريا (طبقة اجتماعية تضم الذين يقومون بعمل يدوي أو يعملون مقابل أجر)\nمثال: لم يتطلب عمله قدراً كبيراً من المهارة",
 "労賃": "جزاء, عاقبة (تعويض عن أعمال جديرة بالتقدير أو عقاب على مخالفات)\nمثال: أجرة الخطيئة هي الموت",
 "労連": "اتحاد عمالي, نقابة (منظمة للموظفين تشكلت للتفاوض مع صاحب العمل)\nمثال: عليك الانضمام إلى النقابة للحصول على وظيفة",
 "労銀": "جزاء, عاقبة (تعويض عن أعمال جديرة بالتقدير أو عقاب على مخالفات)\nمثال: أجرة الخطيئة هي الموت",
 "効": "فعالية, نجاعة (القدرة أو القوة لإنتاج تأثير مرغوب)\nمثال: قلق بشأن سلامة وفعالية اللقاح",
 "効かす": "اِسْتِعْمَال, اِسْتِخْدَام (اِسْتِعْمَال) / اِسْتَعْمَلَ, اِسْتَخْدَمَ (عَمِلَ بالشيء؛ اِتَّخَذَ الشخصَ عَامِلًا عنده)\nمثال: أيمكنني استعمال هاتفك؟",
 "効かせる": "اِسْتِعْمَال, اِسْتِخْدَام (اِسْتِعْمَال) / اِسْتَعْمَلَ, اِسْتَخْدَمَ (عَمِلَ بالشيء؛ اِتَّخَذَ الشخصَ عَامِلًا عنده)\nمثال: أيمكنني استعمال هاتفك؟",
 "効き": "فعالية, قوة تأثير (القدرة على إنتاج تأثيرات فسيولوجية أو كيميائية قوية) / تأثير, فعالية (القدرة على أن يكون مؤثرًا أو إحداث تأثير)\nمثال: قوة تأثير التوكسين",
 "効き目": "تَأْثِير, أَثَر",
 "効く": "عَمَل, شُغْل (فِعْل، صُنْع؛ وسيلة للكسب، مِهْنَة، حِرْفَة) / مُصَنَّف, مُؤَلَّف / سَارَ (مَشَى)\nمثال: المهم هو العمل. / اِسْتَطَاعَ, قَدَرَ (أَطَاقَ الشَّيءَ وقَدَرَ عليه، أَمْكَنَهُ الشَّيءُ)\nمثال: توم استطاع ان يهرب / حَسَبَ الرَغَبَة (عَدَّ مع الجَمْع والطَرْح وغيرها من العمليات الحِسَابية؛ عند أكثر العامة: هو العَدّ مطلقا)\nمثال: حسب سامي المال.",
 "効力": "تَأْثِير, أَثَر",
 "効果": "تَأْثِير, أَثَر / أغراض شخصية, متعلقات شخصية (ممتلكات ذات طابع شخصي قابلة للحمل ولا تستخدم في الأعمال التجارية)\nمثال: تركت بعض متعلقاتها الشخصية في المنزل",
 "効果の法則": "قانون الأثر ((علم النفس) المبدأ القائل بأن السلوكيات يتم اختيارها بناءً على عواقبها؛ السلوك الذي له عواقب جيدة يميل إلى التكرار بينما السلوك الذي يؤدي إلى عواقب…)",
 "効果的": "فَعَّال (ذو الفعل المؤثر)\nمثال: لا يستطيع إتخاذ إجراءات فعالة.",
 "効果音": "مُؤَثِّر صَوْتِيّ",
 "効率": "فاعلية, كفاءة (المهارة في تجنب إضاعة الوقت والجهد) / كَفَاءَة (نسبة المخرجات إلى المدخلات في أي نظام)\nمثال: قامت بالعمل بكفاءة كبيرة",
 "効率化": "اِسْتِمْثَال, مُلَاءَمَة",
 "効率性": "فاعلية, كفاءة (المهارة في تجنب إضاعة الوقت والجهد) / كَفَاءَة (نسبة المخرجات إلى المدخلات في أي نظام)\nمثال: قامت بالعمل بكفاءة كبيرة",
 "効率的": "فَعَّال (ذو الفعل المؤثر)\nمثال: لا يستطيع إتخاذ إجراءات فعالة.",
 "効用": "اِسْتِعْمَال, اِسْتِخْدَام (اِسْتِعْمَال) / اِسْتَعْمَلَ, اِسْتَخْدَمَ (عَمِلَ بالشيء؛ اِتَّخَذَ الشخصَ عَامِلًا عنده)\nمثال: أيمكنني استعمال هاتفك؟",
 "効能": "تَأْثِير, أَثَر",
 "効験": "فعالية, نجاعة (القدرة أو القوة لإنتاج تأثير مرغوب)\nمثال: قلق بشأن سلامة وفعالية اللقاح",
 "勃": "مُفْعَم بِالحَيَاة, مُنْتَعِش (أُضفِيَت عليه الحيويّة والنشاط) / جَرِيء, ذُو هِمَّة (مُسْتَعِدّ لِمُوَاجَهَة الخَطَر) / حَيَوِيّ, مِقْدَام (يتميّز بالحركة النشطة والحيوية) / حيوي, مفعم بالحيوية (يظهر حيوية أو نشاطًا أو حماسًا) / مُبَاغِت, مُفَاجِئ",
 "勃々": "مُفْعَم بِالحَيَاة, مُنْتَعِش (أُضفِيَت عليه الحيويّة والنشاط) / جَرِيء, ذُو هِمَّة (مُسْتَعِدّ لِمُوَاجَهَة الخَطَر) / حَيَوِيّ, مِقْدَام (يتميّز بالحركة النشطة والحيوية) / حيوي, مفعم بالحيوية (يظهر حيوية أو نشاطًا أو حماسًا)",
 "勃勃": "مُفْعَم بِالحَيَاة, مُنْتَعِش (أُضفِيَت عليه الحيويّة والنشاط) / جَرِيء, ذُو هِمَّة (مُسْتَعِدّ لِمُوَاجَهَة الخَطَر) / حَيَوِيّ, مِقْدَام (يتميّز بالحركة النشطة والحيوية) / حيوي, مفعم بالحيوية (يظهر حيوية أو نشاطًا أو حماسًا)",
 "勃然": "فَجْأَةً",
 "勃発": "تَفَشٍّ",
 "勃起": "نُعُوظ, اِنْتِصَاب",
 "勃起不全": "خلل الانتصاب, ضعف الانتصاب (عجز ناتج عن عدم قدرة الرجل على الحصول على انتصاب للقضيب أو الحفاظ عليه)",
 "勃起障害": "خلل الانتصاب, ضعف الانتصاب (عجز ناتج عن عدم قدرة الرجل على الحصول على انتصاب للقضيب أو الحفاظ عليه)",
 "勅": "مرسوم إمبراطوري (مرسوم يصدره حاكم ذو سيادة)",
 "勅令": "مَرْسُوم",
 "勅使川原": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "勅使河原": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "勅定": "مرسوم إمبراطوري (مرسوم يصدره حاكم ذو سيادة)",
 "勅宣": "مرسوم إمبراطوري (مرسوم يصدره حاكم ذو سيادة)",
 "勅許": "مرسوم ملكي, ميثاق ملكي (ميثاق ممنوح من قبل السيادة (خاصة في بريطانيا العظمى))",
 "勅諚": "مرسوم إمبراطوري (مرسوم يصدره حاكم ذو سيادة)",
 "勇": "شَجَاعَة",
 "勇ましい": "شُجَاع, جَرِيء (الثعبان)\nمثال: إنك شجاع للغاية. / تحريك, تقليب (تحريك سائل باستخدام أداة) / إلهام, تحريك المشاعر (الاستنهاض لعاطفة أو فعل معين) / مُثِير, مُحَرِّك لِلْمَشَاعِر (يثير مشاعر قوية لكنها غير مزعجة) / حَمَاسِيّ, مُلْهِم (قادر على إثارة الحماس أو الإثارة)\nمثال: التحريك المستمر يمنعه من الاحتراق في قاع المقلاة",
 "勇み肌": "بَاسِل, صَنْدِيد (لَا يَتَرَاجَع فِي المَعْرَكَة أَوِ العَمَل) / فُرُوسِيّ, نَبِيل (يُبدي اهتماماً بالنساء كالفارس المثالي) / جَلِيل, شَامِخ (يتحلّى بالوقار والنُّبل الكبيرين أو يُظهرهما) / أَنِيق, جَرِيء (حيويّ ومفعم بالحماس والأناقة)",
 "勇み足": "تهور, طيش (سمة إيلاء القليل من التفكير للخطر) / رعونة, طيش (سمة التصرف برعونة وبدون تعقل)",
 "勇む": "حمحة, صهيل (الأصوات المميزة التي يصدرها الحصان)",
 "勇侠": "مُرُوءَة",
 "勇力": "شَجَاعَة, جَسَارَة",
 "勇名": "شُهْرَة",
 "勇士": "بَطَل, بَطَلَة",
 "勇壮": "بُطُولِيّ",
 "勇婦": "بَطَلَة",
 "勇将の下に弱卒なし": "هُنَاك, يُوجَد",
 "勇将の下に弱卒無し": "هُنَاك, يُوجَد",
 "勇将弱卒": "هُنَاك, يُوجَد",
 "勇敢": "شُجَاع, جَرِيء (الثعبان)\nمثال: إنك شجاع للغاية.",
 "勇敢さ": "شَجَاعَة",
 "勇武": "شَجَاعَة",
 "勇気": "شَجَاعَة, جَسَارَة\nمثال: 我々は彼女の勇気に感心する。 — نحب شجاعتها.",
 "勇気ある": "شجاع (الثعبان)\nمثال: إنك شجاع للغاية.",
 "勇気づけ": "تشجيع, دعم (فعل إعطاء الأمل أو الدعم لشخص ما) / تشجيع (التعبير عن الموافقة والدعم) / تشجيع (الشعور بالتشجيع)",
 "勇気づける": "شَجَّعَ (حفَّز شخصًا أو دعمه لتحقيق هدف أو القيام بعمل؛ بثَّ الحماس أو الثقة في نفس شخص)\nمثال: شجع سامي ليلى لتفعل ذلك.",
 "勇気付け": "تشجيع, دعم (فعل إعطاء الأمل أو الدعم لشخص ما) / تشجيع (التعبير عن الموافقة والدعم) / تشجيع (الشعور بالتشجيع)",
 "勇気付ける": "شَجَّعَ (حفَّز شخصًا أو دعمه لتحقيق هدف أو القيام بعمل؛ بثَّ الحماس أو الثقة في نفس شخص)\nمثال: شجع سامي ليلى لتفعل ذلك.",
 "勇気凛々": "فَيَّاض, مُتَدَفِّق (طافح بالفرح والحيويّة بلا قيود)",
 "勇気凛凛": "فَيَّاض, مُتَدَفِّق (طافح بالفرح والحيويّة بلا قيود)",
 "勇気凜々": "فَيَّاض, مُتَدَفِّق (طافح بالفرح والحيويّة بلا قيود)",
 "勇気凜凜": "فَيَّاض, مُتَدَفِّق (طافح بالفرح والحيويّة بلا قيود)",
 "勇気有る": "شجاع (الثعبان)\nمثال: إنك شجاع للغاية.",
 "勇決": "حَسْم, قَطْعِيَّة (صفة كون الشيء نهائياً أو محسوماً بشكل قاطع) / حسم, قاطع (سمة الحزم كما يتضح من صلابة الشخصية أو الغرض)\nمثال: نهائية الموت",
 "勇烈": "شَجَاعَة",
 "勇猛": "جَرِيء, جَسُور",
 "勇者": "بَطَل, بَطَلَة",
 "勇退": "تنازل عن العرش (فعل التنازل عن العرش) / تنازل عن العرش, تنحي (استقالة رسمية وتنازل عن السلطات)",
 "勇邁": "بُطُولِيّ",
 "勇魚": "حُوت (سمكة صَغيرة كانت أو كبيرة؛ حوت كبير: صاحب مال وسَطْوَة ونفوذ)\nمثال: هل الحوت من الثدييات؟",
 "勇魚取": "صَيْد اَلْحِيتَان",
 "勇魚取り": "صَيْد اَلْحِيتَان",
 "勉励": "اِجْتِهَاد",
 "勉学": "ذَاكَرَ, دَرَسَ / دَرَسَ ((متعدٍّ بنفسه) عَلَّمَ، لَقَّنَ؛ اِمْتَهَنَ التَّعْلِيم) / دَرَسَ, تَعَلَّمَ ((متعدٍّ بنفسه) عَلَّمَ، لَقَّنَ؛ اِمْتَهَنَ التَّعْلِيم) / تَعَلُّم, دِرَاسَة (اكتسب معرفة أو خبرة أو مهارة) / مَكْتَب (الموضع الذي يُكتَب عليه. بعكس المَكْتَب الذي يكتب فيه؛ مِنْضَدَة مخصصة للكتابة، سواء كانت للمَكَاتِب أم لغيرها)\nمثال: أراك بعد الدرس.",
 "勉強": "ذَاكَرَ, دَرَسَ / دَرَسَ ((متعدٍّ بنفسه) عَلَّمَ، لَقَّنَ؛ اِمْتَهَنَ التَّعْلِيم) / دَرَسَ, تَعَلَّمَ ((متعدٍّ بنفسه) عَلَّمَ، لَقَّنَ؛ اِمْتَهَنَ التَّعْلِيم) / تَعَلُّم, دِرَاسَة (اكتسب معرفة أو خبرة أو مهارة) / مَكْتَب (الموضع الذي يُكتَب عليه. بعكس المَكْتَب الذي يكتب فيه؛ مِنْضَدَة مخصصة للكتابة، سواء كانت للمَكَاتِب أم لغيرها)\nمثال: أراك بعد الدرس. / اِجْتِهَاد / خِبْرَة, تَجْرِبَة (مصدر للفعل خَبَرَ؛ القاعُ يُنبت السِّدْر والأراك) / اِخْتِبَار (اختبر الشّيء:خبره) / خِبْرَة (مصدر للفعل خَبَرَ؛ القاعُ يُنبت السِّدْر والأراك)\nمثال: زيري عنده خبرة. / خَصْم, تَخْفِيض (الخَصْمُ :مُجَادِل، مُنَازِع، مُخَاصِم، عكسه حَلِيف أو صَدِيْق، وقد يستوي فيه المفرد والمثنى والجمع؛ والخَصْمُ (في ) : حَطِيطَة)",
 "勉強になる": "تثقيفي, تنويري (تنويري أو رافع للمعنويات بما يشجع على التحسن الفكري أو الأخلاقي) / تثقيفي, تنويري (يميل لزيادة المعرفة أو تبديد الجهل)\nمثال: اللوحات في الكنيسة خدمت غرضاً تهذيبياً حتى لأولئك الذين لا يستطيعون القراءة",
 "勉強熱心": "مُجْتَهِد (مشتق من إجتهد)\nمثال: لعل المجتهد ينجح.",
 "勒": "بِت (انقطع؛ قَطَع)",
 "勒する": "أَدَارَ (دَارَ نصف دورة فقط؛ الشيء: جعله يدور؛ فعل تعدّي من دَارَ)\nمثال: أدار فاضل مقبض الباب بهدوء و دخل إلى المنزل. / نَحَتَ (وهو القَطْع والبَري والنشر والقشر وتشكيل الخشب أو الحجر أو غيره؛ الشيء الذي نُحِتَ، النقش أو التمثال أو غيره مما كان ناتج النحت)\nمثال: من علمك نحت الخشب.",
 "動": "حَرَكَة",
 "動かしがたい": "رَاسِخ, مَنِيع (خَالٍ مِنَ الثَّغَرَاتِ أَوِ العُيُوب) / ثَابِتٌ, رَاسِخٌ (يتميز بعزيمة راسخة لا تتزعزع)",
 "動かし難い": "رَاسِخ, مَنِيع (خَالٍ مِنَ الثَّغَرَاتِ أَوِ العُيُوب) / ثَابِتٌ, رَاسِخٌ (يتميز بعزيمة راسخة لا تتزعزع)",
 "動かす": "حَرُكَ, تَحَرَّكَ (غَيَّرَ مَوْضِعَهُ أو مَكَانَهُ أو حَالَه؛ حَرُكَ الوَلَدُ : تَحَرَّكَ، أَوْ خَرَجَ عَنْ سُكُونِهِ) / اِنْتَقَلَ, تَحَلْحَلَ\nمثال: لقد أوقفنا حركة المرور. / تَغَيَّرَƒ / غَيَّرَ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به) / تَغْيِير, تَبْدِيل / فَكَّة / بَاقٍ (باقٍ ، الباقِيٌ جمع باقون ( للعاقل ) وبَواقٍ ، مؤ باقية ، جمع مؤ باقيات وبَواقٍ؛ باقٍ إلَى الأبَدِ : خالِدٌ) / تَغْيِير\nمثال: أنا غير متفاجئ. / شَغَّلَ ((شَغَلَ) الدارَ يَشْغَلَ شَغْلًا: سكنها؛ شَغَلَ فلانًا عن الشيء: لَهَّاهُ وصرَفَه)\nمثال: شغل بيل التلفاز. / حَشَدَ, اِسْتَجَاشَ (حَشَد القَوْمَ: جَمَعَهم؛ حَشَد الزَّرْعُ: نَبَتَ كُلُّه)\nمثال: لمحته للحظة وسط الحشد",
 "動かぬ証拠": "دليل دامغ, دليل قاطع (دليل لا يقبل الجدل (خاصة في جريمة))",
 "動き": "حَرَكَة / رَائِج, مُتَدَاوَل / يَرُوج, يُتَدَاوَل",
 "動きが取れない": "مُسْتَنْقَع",
 "動く": "حَرُكَ, تَحَرَّكَ (غَيَّرَ مَوْضِعَهُ أو مَكَانَهُ أو حَالَه؛ حَرُكَ الوَلَدُ : تَحَرَّكَ، أَوْ خَرَجَ عَنْ سُكُونِهِ) / اِنْتَقَلَ, تَحَلْحَلَ\nمثال: لقد أوقفنا حركة المرور. / شَغَّلَ ((شَغَلَ) الدارَ يَشْغَلَ شَغْلًا: سكنها؛ شَغَلَ فلانًا عن الشيء: لَهَّاهُ وصرَفَه)\nمثال: شغل بيل التلفاز. / عَمَل (فِعْل، صُنْع؛ وسيلة للكسب، مِهْنَة، حِرْفَة) / قَانُون (مقياس كل شيء وطريقه؛ أمر كليّ ينطبق على جميع جزئياته التي تعرف أحكامها منه) / مَثَّلَ (الشَبَه؛ النَظِير) / تَصَرَّفَ\nمثال: المهم هو العمل. / تَغَيَّرَƒ / غَيَّرَ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به) / تَغْيِير, تَبْدِيل / فَكَّة / بَاقٍ (باقٍ ، الباقِيٌ جمع باقون ( للعاقل ) وبَواقٍ ، مؤ باقية ، جمع مؤ باقيات وبَواقٍ؛ باقٍ إلَى الأبَدِ : خالِدٌ) / تَغْيِير\nمثال: أنا غير متفاجئ.",
 "動乱": "إزعاج, اضطراب (فعل إزعاج شيء أو شخص ما؛ تحريك شيء ما) / شِجَار عَلَنِيّ, عِرَاك (قتال صاخب) / إزعاج, اضطراب (نشاط يمثل خللاً أو تطفلاً أو انقطاعاً) / تداخل, تشويش (نشاط كهربائي أو صوتي يمكن أن يزعج الاتصالات)\nمثال: مصطلح 'كرب' يعني درجة ما من الاضطراب والانزعاج العاطفي",
 "動作": "حَرَكَة / رمان بلي, كرسي تحميل (دعامة دوارة توضع بين الأجزاء المتحركة للسماح لها بالحركة بسهولة) / رسم شعار النبالة, شحنة (شعار النبالة المتمثل في تصميم أو صورة مرسومة على درع) / سلوك, هيئة (أسلوب أو سلوك وقور) / قوام, هيئة (طريقة مميزة لحمل الجسم)\nمثال: وقف بوضعية جيدة / عَمَلِيَّة, عَمَل / عَمَلِيَّة جِرَاحِيَّة, جِرَاحَة / عَمَلِيَّات, عَمَلِيَّة",
 "動作不良": "خلل وظيفي, عطل (فشل في العمل بشكل طبيعي)",
 "動作主": "فَاعِل (الشيء :فعله)\nمثال: تظن الشرطة أن سامي يعلم من الفاعل.",
 "動作可能時間": "فترة العمل, وقت التشغيل (فترة زمنية يكون فيها شيء ما (كالآلة أو المصنع) قيد التشغيل ومتاحاً للاستخدام)",
 "動作有効期間": "نِظَام (مَنْهَج، طَرِيقَة؛ تَرْتِيب واتِّسَاق) / نِظَام, سَطْوَة (مَنْهَج، طَرِيقَة؛ تَرْتِيب واتِّسَاق)\nمثال: ليس بنظام كامل.",
 "動作状態": "نَشِيط, عَامِل / نَشِيط / حَرِك (غَيَّرَ مَوْضِعَهُ أو مَكَانَهُ أو حَالَه؛ حَرُكَ الوَلَدُ : تَحَرَّكَ، أَوْ خَرَجَ عَنْ سُكُونِهِ) / فَارِه, حَرِك\nمثال: لقد أوقفنا حركة المرور.",
 "動作確認": "التأكيد على الفاعلية / تصديق (صَدّقّهُ تصديقا:ضد كذَّبّهُ؛ تَصْديق: مصدر صدَّقَ/صَدّقَ ب/صَدّقَ على)\nمثال: رفصنا تصديق ذلك.",
 "動作記録": "تَارِيخ, تاريخ (جملة الأَحوال والأحداث التي يمر بها كائن ما، ويَصْدق على الفرد والمجتمع، كما يَصْدق على الظواهر الطبيعية والإنسانية؛ هو تحديد الزمن باليَوْم والشَهْر والسَنَة أو ببعضهما. الأجَل أو الوَقْت) / تَارِيخ (جملة الأَحوال والأحداث التي يمر بها كائن ما، ويَصْدق على الفرد والمجتمع، كما يَصْدق على الظواهر الطبيعية والإنسانية؛ هو تحديد الزمن باليَوْم والشَهْر والسَنَة أو ببعضهما. الأجَل أو الوَقْت) / مَحْفُوظَات\nمثال: ما تاريخ اليوم؟",
 "動力": "قُوَّة, قُدْرَة (ضد الضُعْف، الشِدَّة والقُدْرَة الجِسْمَانِيَّة؛ ضد الضُعْف، المَقْدِرَة والحَوْل والتَمَكُّن، القدرة المعنوية) / قُوَّة (ضد الضُعْف، الشِدَّة والقُدْرَة الجِسْمَانِيَّة؛ ضد الضُعْف، المَقْدِرَة والحَوْل والتَمَكُّن، القدرة المعنوية) / قُوَّة, طَاقَة (ضد الضُعْف، الشِدَّة والقُدْرَة الجِسْمَانِيَّة؛ ضد الضُعْف، المَقْدِرَة والحَوْل والتَمَكُّن، القدرة المعنوية) / طَاقَة كَهْرَبَائِيَّة, طَاقَة (القُدْرَة والشِدَّة؛ هي مقدار ما يمكن للإنسان أن يفعله بمشقة، كأن قدرته محددة بطَوْق)\nمثال: توم شعر بالقوة.",
 "動力学": "دِينَامِيكَا, حَرَكِيَّة",
 "動力故障": "انقطاع التيار الكهربائي, انقطاع الكهرباء (فشل المعدات الناتج عند انقطاع مصدر الطاقة)\nمثال: تسببت العاصفة الثلجية في انقطاع التيار الكهربائي",
 "動力炉": "طاقة نووية, قدرة نووية (الطاقة النووية باعتبارها مصدراً للكهرباء لشبكة الطاقة (للاستخدام المدني))",
 "動力計": "دينامومتر, مقياس القوة (أداة قياس مصممة لقياس القدرة أو القوة)",
 "動力降下": "انقضاض بمحرك (غوص طائرة يتم تسريعه بواسطة الجاذبية وقوة المحرك معاً)",
 "動勢": "وَضْع (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه) / دَوْلَة (بَلَد يتميز بحُدُود معروفة وشَعْب وحُكُومَة ومُؤَسَسَات مُنَظَّمَة؛ مجموعة من الناس مستقلين متحدين معا لتكوين مجتمع لحماية حقوقهم و وضع قوانينهم الخاصة) / وِلَايَة (منطقة إدارية لها استقلالها الإداري والمعنوي؛ ويختلف المعنى من بلد لآخر كما يختلف من فترة زمنية لأخرى) / يُبْدِي\nمثال: لقد أزمت الوضع.",
 "動原体": "سِنْترومِير, قَسِيم مَرْكَزِيّ\nمثال: من الصعب تحديد تسلسل القسيم المركزي",
 "動名詞": "صِيغَةُ فِعْل, مَصْدَر",
 "動向": "رَائِج, مُتَدَاوَل / يَرُوج, يُتَدَاوَل",
 "動員": "تَعْبِئَة, تَجْنِيد",
 "動因": "قَادَ, سَاقَ / سَاقَ",
 "動学": "دِينَامِيكَا, حَرَكِيَّة / مِيكَانِيكَا, مِيكَانِيكِيَّة",
 "動径": "متجه نصف القطر (خط يربط نقطة في الفضاء بأصل نظام إحداثيات قطبي) / متجه نصف القطر (خط يربط قمرًا صناعيًا بمركز الجسم الذي يدور حوله)",
 "動悸": "خَفَقَان",
 "動感": "حَرَكَة",
 "動態": "حَرَكَة",
 "動揺": "رج, هز (عملية التسبب في تحرك شيء ما صعوداً وهبوطاً (أو ذهاباً وإياباً) بحركات سريعة) / ارتعاش, اهتزاز (حركة مهتزة)\nمثال: ارتعاش أصابعه وهو يشعل غليونه / إزعاج, اضطراب (فعل إزعاج شيء أو شخص ما؛ تحريك شيء ما) / شِجَار عَلَنِيّ, عِرَاك (قتال صاخب) / إزعاج, اضطراب (نشاط يمثل خللاً أو تطفلاً أو انقطاعاً) / تداخل, تشويش (نشاط كهربائي أو صوتي يمكن أن يزعج الاتصالات)\nمثال: مصطلح 'كرب' يعني درجة ما من الاضطراب والانزعاج العاطفي",
 "動機": "حَافِز / تيمة, فكرة زخرفية (تصميم أو شكل يتكون من أشكال أو ألوان متكررة، كما في العمارة أو الديكور) / ثيمة, موضوع (فكرة موحدة تعد عنصرًا متكررًا في العمل الأدبي أو الفني) / فكرة موسيقية, موتيف (موضوع يتم تكراره أو تفصيله في قطعة موسيقية)\nمثال: كان الموضوع المعتاد 'صبي يفوز بقلب فتاة'",
 "動機づけ": "دَافِع (دَافِع : حافِزٌ وسببٌ، أمرٌ مُوجِبٌ؛ ما يحمل على الفعل من غرائز وميول فهو وجدانيّ، ولا شعوريّ في حين أنّ الباعث عقليّ وشعوريّ) / دافِع (دَافِع : حافِزٌ وسببٌ، أمرٌ مُوجِبٌ؛ ما يحمل على الفعل من غرائز وميول فهو وجدانيّ، ولا شعوريّ في حين أنّ الباعث عقليّ وشعوريّ)\nمثال: دافع عن الضعفاء.",
 "動機付け": "دَافِع (دَافِع : حافِزٌ وسببٌ، أمرٌ مُوجِبٌ؛ ما يحمل على الفعل من غرائز وميول فهو وجدانيّ، ولا شعوريّ في حين أنّ الباعث عقليّ وشعوريّ) / دافِع (دَافِع : حافِزٌ وسببٌ، أمرٌ مُوجِبٌ؛ ما يحمل على الفعل من غرائز وميول فهو وجدانيّ، ولا شعوريّ في حين أنّ الباعث عقليّ وشعوريّ)\nمثال: دافع عن الضعفاء.",
 "動物": "حَيَوَان (بمعنى أصبح له حياة؛ الحَيَاة. والحَيَوَان أبلغ من الحَيَاة؛ جنس الحَيّ الذي يأكل وينمو ويتحرك بالإرادة وبه حِسّ بخلاف ما به حياة فقط دون الحس مثل النَبَات. بعض العامة تقول حَيْوَان وهو غلط) / حَيَوَان, وَحْش (بمعنى أصبح له حياة؛ الحَيَاة. والحَيَوَان أبلغ من الحَيَاة؛ جنس الحَيّ الذي يأكل وينمو ويتحرك بالإرادة وبه حِسّ بخلاف ما به حياة فقط دون الحس مثل النَبَات. بعض العامة تقول حَيْوَان وهو غلط)\nمثال: هذا حيوان أليف.",
