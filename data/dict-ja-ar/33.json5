 "利得": "كَسَبَ",
 "利息": "فَائِدَة",
 "利息制限法": "سِعْر الْفَائِدَة (سَعِرَ يَسْعَرَ سَعَراً، وسُعْرَةً: ضرب لونه إِلى السواد فُوَيْقَ الأُدْمة؛ فهو أَسْعَرُ، وهي سَعْراءُ. والجمع: سُعْرٌ)\nمثال: إتفقوا على سعر.",
 "利慾": "جَشَع, طَمَع (اِسْمٌ وَصِفَةٌ لِلْأَسَد)\nمثال: كان مارك يميل للجشع.",
 "利札": "قَسِيمَة / كُوبُون, قَسِيمَة شِرائِيَّة",
 "利根": "جِهَاز الْمُخَابَرَات, مُخَابَرَات",
 "利根川": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "利権": "فَائِدَة",
 "利権ビジネス": "صاحب امتياز (شخص يحمل أو يدير حق امتياز تجاري)",
 "利権団体": "جماعة ضغط, مجموعة مصالح خاصة (مجموعة مصالح تحاول التأثير على المشرعين أو البيروقراطيين للعمل لصالحهم، عادة من خلال الضغط)",
 "利権屋": "إسْتِغْلَالِيّ, اِنْتِهَازِيّ",
 "利欲": "جَشَع, طَمَع (اِسْمٌ وَصِفَةٌ لِلْأَسَد)\nمثال: كان مارك يميل للجشع.",
 "利水": "سَقْي",
 "利潤": "رِبْح, مَكْسَب (رَبَحَ التَّاجِرُ: نَالَ فَائِدَةً مَالِيَّةً فِي تِجَارَتِهِ؛ رَبَحَ السَّبَاقَ: فَازَ، تَفَوَّقَ)\nمثال: ربح زيري المال.",
 "利点": "أَفْضَلِيَّة, فَائِدَة",
 "利率": "سِعْر الْفَائِدَة (سَعِرَ يَسْعَرَ سَعَراً، وسُعْرَةً: ضرب لونه إِلى السواد فُوَيْقَ الأُدْمة؛ فهو أَسْعَرُ، وهي سَعْراءُ. والجمع: سُعْرٌ)\nمثال: إتفقوا على سعر.",
 "利用": "اِسْتِعْمَال, اِسْتِخْدَام (اِسْتِعْمَال) / اِسْتَعْمَلَ, اِسْتَخْدَمَ (عَمِلَ بالشيء؛ اِتَّخَذَ الشخصَ عَامِلًا عنده)\nمثال: أيمكنني استعمال هاتفك؟",
 "利用券": "تَذْكِرَة / تذكرة",
 "利用可能": "مُتَاح (ممكن، مسموح)\nمثال: يجب أن تكون نتائج البحث متاحة للجميع.",
 "利用客": "مُسْتَعْمِل, مُسْتَخْدِم (غير جَدِيد، لم يصل البَلَى بعد إلا أنه في الطريق إلى ذلك؛ مُسْتَخْدَم، أحد ما يستخدمه الآن)\nمثال: اشتريت جوال مستعمل.",
 "利用明細": "بيان محاسبي, كشف حساب (بيان بالمعاملات الحديثة والرصيد الناتج)\nمثال: يرسلون لي كشف حساب كل شهر",
 "利用法": "اِسْتِخْدَام",
 "利用者": "مُسْتَعْمِل, مُسْتَخْدِم (غير جَدِيد، لم يصل البَلَى بعد إلا أنه في الطريق إلى ذلك؛ مُسْتَخْدَم، أحد ما يستخدمه الآن)\nمثال: اشتريت جوال مستعمل.",
 "利用者名": "اِسْم مُسْتَخْدِم (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "利用者証明証": "شَهَادَة",
