 "合釘": "مسمار خشبي, وتد (مثبت يتم إدخاله في ثقوب في قطعتين متجاورتين لتثبيتهما معاً)",
 "合銀": "عُمُولَة",
 "合鍵": "ماستر كي, مفتاح رئيسي (مفتاح يؤمن الدخول في كل مكان)",
 "合間": "فَاصِل / مُدَّة, فَتْرَة / مَسَافَة / انقطاع, توقف (فعل تأخير أو قطع الاستمرارية) / شق, فجوة (فتحة ضيقة) / فَارِق, فَجْوَة (تفاوت أو اختلاف واضح كما بين رقمين) / فجوة, هوة (اختلاف (خاصة اختلاف مؤسف) بين رأيين أو وجهتي نظر أو موقفين)\nمثال: تم عرضه بدون فواصل إعلانية",
 "合集": "تأليف, تجميع (فعل التجميع (كما في كتاب واحد أو ملف أو قائمة)) / تجميع, مصنف (شيء تم تجميعه (كما في كتاب واحد أو ملف))\nمثال: استغرقت وظيفة تجميع المخزون عدة ساعات",
 "吉": "حسن طالع, ضربة حظ (جَمِيل؛ مُبْهِج) / توفيق, حسن الحظ (حالة ميمونة ناتجة عن نتائج إيجابية)\nمثال: إيمي فتاة حسنة.",
 "吉凶": "ثَرْوَة",
 "吉報": "بُشْرَى (الخبر السار) / بِشَارَة, إِنْجِيل",
 "吉左右": "بُشْرَى (الخبر السار) / بِشَارَة, إِنْجِيل",
 "吉本総合芸能学院": "مجلس الأمن القومي (لجنة في الفرع التنفيذي للحكومة تقدم المشورة للرئيس بشأن الشؤون الخارجية والعسكرية والأمن القومي؛ تشرف على وكالة الاستخبارات المركزية)",
 "吉祥": "سَعِيد / فَرِح (سُرُور؛ اسم يطلق على الإناث) / مَحْظُوظ\nمثال: فرح فاضل كثيرا.",
 "吉草酸": "حمض البنتانويك, حمض الفاليريك (حمض كربوكسيلي سائل شفاف يستخدم في العطور والأدوية)",
 "吊し": "جاهز, معد مسبقاً (مصنوع للشراء والاستخدام الفوري) / جَاهِز, مُعَدٌّ تِجَارِيًّا (مُنتَج تجارياً وليس منزلي الصنع) / جَاهِز, نَمَطِيّ (يتكرر بانتظام دون تفكير أو أصالة) / غرض جاهز الصنع, منتج جاهز (منتج مصنّع (كملابس أو قطعة أثاث) يتم صنعه مسبقاً ويكون متاحاً للشراء)\nمثال: شقتهم كانت مؤثثة بأثاث جاهز / شَنْق (قتله بربط حبل حول رقبته وإسقاطه)\nمثال: شنق زيري نفسه فوق شجرة.",
 "吊し上げ": "رَفَعَ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ) / رَافِعَة\nمثال: رفع سامي نظارته. / وَشَى",
 "吊し上げる": "رَفَعَ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ) / رَافِعَة\nمثال: رفع سامي نظارته.",
 "吊し柿": "كَاكَا / كَاكِي / بِرْسِيمُون",
 "吊し責め": "تعليق من الخلف, سترابادو (شكل من أشكال التعذيب حيث تُربط يدا الشخص خلف ظهره ويُرفع عن الأرض بحبل مربوط بمعصميه، ثم يُترك ليسقط حتى يتم وقف سقوطه فجأة بواسطة الحبل)",
 "吊す": "عَلِقَ, عِلِق / عَلَّقَ, عَلَّق / شَنَقَ, شَنَق (قتله بربط حبل حول رقبته وإسقاطه)\nمثال: شنق زيري نفسه فوق شجرة.",
 "吊り": "شَنْق (قتله بربط حبل حول رقبته وإسقاطه)\nمثال: شنق زيري نفسه فوق شجرة. / مِقْلَاع / حَمَّالَة",
 "吊りランプ": "عِقْد, قِلَادَة (العَشْر من السَنَوَات؛ الاتِّفَاق والعَهْد بين طرفين)\nمثال: أمضى زيري العقد.",
 "吊り上げる": "رَفَعَ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ) / رفع (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ) / شال (قطعة مربعة كبيرة من القماش الصوفي يستخدمه الرجال كغطاء للرأس يكون عادة غير منقوش ولا مطرز؛ قطعة مستطيلة أو ممثلثة من القماش سواء كان خفيفا أم سميكا من الصوف أو القطن أو الحرير يكون عادة مطرز أو مشغول تضعه النساء على أكتافها) / مِصْعَد, أَصَنْصِير\nمثال: رفع سامي نظارته. / رَفَعَ, سَانَدَ (دفع شخصاً أو شيئاً من الأسفل لمساعدته على الصعود)\nمثال: رفعت أطفالها للأعلى عندما مر الشرطي",
 "吊り下がる": "دَلَّى",
 "吊り下げる": "عَلَّقَ",
 "吊り床": "أُرْجُوحَة شَبَكِيَّة / نقاط الحذف (واحدة من سلسلة من النقاط ('؛') تشير إلى أن شيئاً ما قد تم حذفه أو أن الجملة غير مكتملة)",
 "吊り手": "علاقة (أي شيء يمكن تعليق شيء منه) / معلّق (عامل يعلق شيئاً ما) / صَيَّاد, صَيَّادَة (اِسْمٌ وَصِفَةٌ لِلْأَسَد)\nمثال: قتل الصياد دبا.",
 "吊り橋": "جِسْر مُعَلَّق (شَجُعَ، جرُؤ؛ أقدم على الخطر واجترأ)\nمثال: اذهب إلى الجسر.",
 "吊り籠": "غندول, جندول",
 "吊り紐": "خَيْط, حَبْل ((خَيَّطَ) الشَّيْبُ في رأسِهِ تَخْييطًا: بَدَا، أو صارَ كالخُيُوطِ فَتَخَيَّطَ رأسُهُ بالشَّيْبِ؛ (خَيَّطَ) الثَّوْب: خاطه)\nمثال: حل الصرة تلقى خيط.",
 "吊り輪": "حلق, حلقات (جهاز جمباز يتكون من زوج من الحلقات المعدنية الثقيلة (مغطاة عادة بالجلد) معلقة بحبال؛ تستخدم لتمارين الجمباز)\nمثال: تتطلب الحلقات قوة جسدية علوية كبيرة",
 "吊り革": "رِبَاط",
 "吊る": "عَلِقَ, عِلِق / عَلَّقَ, عَلَّق / شَنَقَ, شَنَق (قتله بربط حبل حول رقبته وإسقاطه)\nمثال: شنق زيري نفسه فوق شجرة. / تجعد, كشكشة (طية غير منتظمة في سطح مستوٍ خلاف ذلك (كما في القماش))",
 "吊るし上げ": "رَفَعَ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ) / رَافِعَة\nمثال: رفع سامي نظارته. / وَشَى",
 "吊るし上げる": "رَفَعَ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ) / رَافِعَة\nمثال: رفع سامي نظارته.",
 "吊るし柿": "كَاكَا / كَاكِي / بِرْسِيمُون",
 "吊るし責め": "تعليق من الخلف, سترابادو (شكل من أشكال التعذيب حيث تُربط يدا الشخص خلف ظهره ويُرفع عن الأرض بحبل مربوط بمعصميه، ثم يُترك ليسقط حتى يتم وقف سقوطه فجأة بواسطة الحبل)",
 "吊るす": "عَلِقَ, عِلِق / عَلَّقَ, عَلَّق / شَنَقَ, شَنَق (قتله بربط حبل حول رقبته وإسقاطه)\nمثال: شنق زيري نفسه فوق شجرة.",
 "吊ランプ": "عِقْد, قِلَادَة (العَشْر من السَنَوَات؛ الاتِّفَاق والعَهْد بين طرفين)\nمثال: أمضى زيري العقد.",
 "吊上げ": "رَفَعَ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ) / رَافِعَة\nمثال: رفع سامي نظارته. / وَشَى",
 "吊床": "أُرْجُوحَة شَبَكِيَّة / نقاط الحذف (واحدة من سلسلة من النقاط ('؛') تشير إلى أن شيئاً ما قد تم حذفه أو أن الجملة غير مكتملة)",
 "吊手": "علاقة (أي شيء يمكن تعليق شيء منه) / معلّق (عامل يعلق شيئاً ما) / صَيَّاد, صَيَّادَة (اِسْمٌ وَصِفَةٌ لِلْأَسَد)\nمثال: قتل الصياد دبا.",
 "吊橋": "جِسْر مُعَلَّق (شَجُعَ، جرُؤ؛ أقدم على الخطر واجترأ)\nمثال: اذهب إلى الجسر.",
 "吊虻": "ذبابة النحل (ذبابة مشعرة آكلة للرحيق تشبه النحلة؛ يرقاتها طفيلية على يرقات النحل والحشرات ذات الصلة)",
 "吊革": "رِبَاط",
 "同": "نَفْسَهُ, نَفْسَهَا / مِثْلَهَا, يُشْبِهَهُ\nمثال: 英語はドイツ語と同語族である。 — الإنجليزية هي لغة جِرمانية. / كَذٰلِك, أَيْضًا / بِالمِثْل",
 "同じ": "نَفْسَهُ, نَفْسَهَا / مِثْلَهَا, يُشْبِهَهُ / عَلَى كُلِّ حَال, على كل حال (يفيد الاستعلاء؛ يفيد التعليل) / عَلَى أَيُّ حَالٍ, على كل حال (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال.",
 "同じい": "نَفْسَهُ, نَفْسَهَا / مِثْلَهَا, يُشْبِهَهُ",
 "同じく": "حَبَّ (الزرع، كبيرا كان أم صغيرا؛ بَذْرُ الزرع) / أَحَبَّ (مَالَ إلى الشيء أو الشخص، وَدَّه؛ للزَّرع: بَدا حَبُّه) / اِسْتَمْطَعَ / أَعْجَبَ (سُرَّ بالشيءِ) / مِثْل (الشَبَه؛ النَظِير) / مِثْل, شِبْه (الشَبَه؛ النَظِير) / مِثْل, كَـ (الشَبَه؛ النَظِير)\nمثال: زيري بحب المال.",
 "同じよう": "مُمَاثِل",
 "同じる": "وَافَقَ (صَادَفَ؛ صَادَقَ)\nمثال: وافق ماثيو بتردد.",
 "同じ様": "مُمَاثِل",
 "同ずる": "وَافَقَ (صَادَفَ؛ صَادَقَ)\nمثال: وافق ماثيو بتردد.",
 "同一": "أُحَادِيّ البُوَيْضَة, مُتَطَابِق ((للتوائم) مشتق من بيضة واحدة أو بويضة) / قَابِلٌ لِلتَّطَابُقِ, مُتَمَاثِل (يَتَطَابَقُ تَمَامًا عِنْدَ وَضْعِهِ فَوْقَ الآخَرِ) / مُتَمَاثِل (ذو خصائص بقيم موحّدة على طول جميع المحاور) / لَا يُمَيَّز, مُتَطَابِق (متماثل تمامًا؛ لا يمكن إدراك أيّ فرق بينهما)\nمثال: التوائم المتطابقة هي أحادية البويضة / أَشْقَر (هو لون الشُقْرَة، وأصله اللون الأحمر المائل إلى الصُفرة ثم أصبح يطلق على ما كان لونه أصفر أيضا؛ صفة ما كان لونه الشُقرة) / حَقَّانِيّ, عادِل / مَأْذُون, مُبَاح\nمثال: أنا لديها شعر بني كستنائي, ولكن ماجدالينا لديها شعر أشقر.",
 "同一化": "بِطَاقَة هُوِيَّة",
 "同一平面": "شطف (غسل أو نظف الشيء بالماء، غالبًا بمعنى التنظيف العميق؛ في بعض الاستخدامات، يمكن أن تعني إزالة ما علق بالشيء من أوساخ أو شوائب)",
 "同一平面上": "مُشْتَرَكُ المُسْتَوَى (يقع في المستوى نفسه)",
 "同一性": "مُطَابَقَة / هُوِيَّة",
 "同一視": "بِطَاقَة هُوِيَّة",
 "同上": "أيضاً, علامة التكرار (علامة تُستخدم للإشارة إلى تكرار الكلمة الموجودة أعلاها)",
 "同人": "بطانة, زمرة (دائرة حصرية من الناس ذات هدف مشترك)",
 "同伴": "مُتَرَتِّب, مُصَاحِب (يحدث بالتزامن مع شيء آخر أو نتيجةً له)",
 "同伴者": "صَاحِب, صَاحِبَة (اَلْمُرَافِق، الْمُلَازِمُ، وَلَا يُقَالُ عُرْفاً إِلَّا لِمَنْ كَثُرَتْ مُلَازَمَتُهُ؛ صَاحِبُ الشَّيْءِ: مَالِكُهُ)\nمثال: من صاحب هذه الأرض؟ / رفيق, رفيق السفر (مسافر يرافقك) / رفيق الدرب (متعاطف مع الشيوعية (ولكن ليس عضوًا في الحزب الشيوعي))",
 "同位体": "نَظِير",
 "同位元素": "نَظِير",
 "同位列": "مَصْفُوفَة",
 "同体": "فِي وَقْت وَاحِد, مَعًا (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "同体に": "مَعًا, سَوِيًّا",
 "同価": "مُعَادِل",
 "同侶": "صَاحِب, صَاحِبَة (اَلْمُرَافِق، الْمُلَازِمُ، وَلَا يُقَالُ عُرْفاً إِلَّا لِمَنْ كَثُرَتْ مُلَازَمَتُهُ؛ صَاحِبُ الشَّيْءِ: مَالِكُهُ)\nمثال: من صاحب هذه الأرض؟",
 "同値": "قَابِلِيَّة لِلْمُقَارَنَة, مُضَاهَاة (السمات التي يمكن مقارنتها) / تَعَادُل, تَكَافُؤ (مساواة جوهرية وقابلية للتبادل) / تكافؤ, مساواة (حالة من التساوي أو التكافؤ الجوهري؛ التوازن المتساوي)\nمثال: لا توجد مقارنة بين الكتابين",
 "同僚": "زَمِيل, زَمِيلَة",
 "同分母": "قاسم مشترك (سمة مشتركة بين جميع أعضاء فئة ما) / مَقَام مُشْتَرَك (عدد صحيح هو مضاعف مشترك لمقامات كسرين أو أكثر)",
 "同前": "أيضاً, علامة التكرار (علامة تُستخدم للإشارة إلى تكرار الكلمة الموجودة أعلاها)",
 "同労者": "زَمِيل عَمَل (زميل يعمل معه المرء في نفس المكان)",
 "同勢": "طَرَف / حَفْلَة, اِحْتِفَال",
 "同化": "مُمَاثَلَة, تَمَاثُل / تأقلم, تكيف ((فسيولوجيا) التعديل المستجيب لعضو حسي (كالعين) لظروف متغيرة (كالضوء)) / اقتباس, نسخة معدلة (عمل مكتوب (كرواية) تمت إعادة صياغته في شكل جديد) / تأقلم, تعديل (عملية التكيف مع شيء ما (مثل الظروف البيئية))\nمثال: المسرحية هي اقتباس لرواية قصيرة",
 "同化作用": "مُمَاثَلَة, تَمَاثُل",
 "同名": "جناس تام, مشترك لفظي (تكون الكلمتان مشتركتين لفظياً إذا كان لهما نفس النطق والهجاء ولكن بمعانٍ مختلفة)",
 "同名異人": "سَمِيّ / سَمِيَّة",
 "同和": "مُمَاثَلَة, تَمَاثُل",
 "同国人": "مُوَاطِن, مُوَاطِنَة (مَدَنِيّ؛ مُقِيم)\nمثال: أنا مواطن لبناني",
 "同圧線": "خط تساوي الضغط ((أرصاد جوية) خط تساوي يربط النقاط ذات الضغط الجوي المتساوي في وقت معين)",
 "同型": "تَسَاوِي الشَّكْل, تَمَاثُل بَلُّورِيّ ((في علم الأحياء) تشابه أو تطابق الشكل أو الهيئة أو البنية)",
 "同型接合体": "متماثل الزيجوت, متماثل اللاقحة ((علم الوراثة) كائن حي يمتلك أليلين متطابقين لجين معين وبالتالي يتكاثر بصفات نقية لتلك الخاصية)",
 "同報": "تَلْفَزَة, إِذَاعَة / أَذَاعَ, بَثَّ",
 "同士": "حبيب, صديق حميم (رجل هو عشيق لرجل أو امرأة) / رجل, رفيق (صبي أو رجل) / زَمِيل (شخص عضو في نفس مهنة أو طبقة الشخص الآخر) / رفيق, زميل (صديق يتواجد كثيراً بصحبة آخر)\nمثال: لو علمت أنه حبيبها لما سألت",
 "同士愛": "لحام, لصق (التثبيت بإحكام معاً) / ربط الأسنان, لصق تجميلي ((طب الأسنان) تقنية لإصلاح الأسنان؛ يتم تطبيق مادة صمغية على سطح السن حيث تلتصق بمينا الأسنان) / أُلْفَة, تَرَابُط (علاقة شخصية وثيقة تتشكل بين الناس (كما بين الزوج والزوجة أو الوالد والطفل))",
 "同士打ち": "نِيرَان صَدِيقَة",
 "同士討ち": "نِيرَان صَدِيقَة",
 "同学": "زميل دراسة, زميل صف (معرفة تذهب معه إلى المدرسة)",
 "同定": "بِطَاقَة هُوِيَّة",
 "同室者": "رَفِيق السَّكَن",
