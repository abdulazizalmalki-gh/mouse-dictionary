 "半意識": "ترنح, ذهول (وعي هامشي)\nمثال: كان ترنحه بسبب الإرهاق بقدر ما كان بسبب الضربات / فِقْدَان اَلْوَعْي, إِغْمَاء / عقل باطن, لاوعي (حالة ذهنية غير متاحة للوعي المباشر)",
 "半截": "بِنِصْف الحَجْم (نصف الحجم المعتاد أو العادي)",
 "半折": "بِنِصْف الحَجْم (نصف الحجم المعتاد أو العادي)",
 "半数": "نِصْف, نُصْف / أحادي الصيغة الصبغية (لخلية أو كائن حي يحتوي على مجموعة واحدة من الكروموسومات) / أحادي الصيغة الصبغية ((في علم الوراثة) كائن أو خلية تحتوي على مجموعة كاملة واحدة فقط من الكروموسومات)",
 "半数体": "أحادي الصيغة الصبغية (لخلية أو كائن حي يحتوي على مجموعة واحدة من الكروموسومات) / أحادي الصيغة الصبغية ((في علم الوراثة) كائن أو خلية تحتوي على مجموعة كاملة واحدة فقط من الكروموسومات)",
 "半数性": "أحادية الصيغة الصبغية (حالة كون الكائن أحادي الصيغة الصبغية)",
 "半旗": "تنكيس, منتصف الصاري (موضع على مسافة ما أسفل قمة الصاري يتم إنزال العلم إليه في الحداد أو للإشارة إلى الاستغاثة)",
 "半時": "وَقْت (\"بَقِيَ وَقْتاً عِنْدَهُ \" : أَيْ مِقْدَاراً مِنَ الزَّمَنِ؛ \"جَاءَ فِي الوَقْتِ الْمُنَاسِبِ \" : فِي اللَّحْظَةِ الْمُنَاسِبَةِ)\nمثال: حان وقت الذهاب. / نِصْف سَاعَة",
 "半時間": "نِصْف سَاعَة",
 "半月": "تَرْبِيع / نصف دائرة (شكل مستوٍ له شكل نصف دائرة)",
 "半月刊": "مَرَّتَيْن فِي الشَّهْر (مرتين في الشهر) / نِصْفُ شَهْرِيّ (يحدث مرتين في الشهر) / نصف شهرية (دورية تصدر مرتين كل شهر (أو 24 عدداً في السنة))\nمثال: الرواتب تدفع مرتين في الشهر",
 "半月弁": "صمام هلالي (صمام قلبي ذو شرفات على شكل أنصاف أقمار؛ يمنع الدم من التدفق عائداً إلى القلب)",
 "半月形": "نِصْف دَائِرِيّ (منحنٍ على شكل نصف دائرة)",
 "半月板": "هِلَالَة",
 "半期": "عطلة نصف الفصل (إجازة قصيرة في منتصف الفصل الدراسي تقريباً)\nمثال: جاء للزيارة في عطلة نصف الفصل",
 "半歩": "نصف بعد, نصف نغمة (الفاصل الموسيقي بين المفاتيح المتجاورة على آلة لوحة المفاتيح)",
 "半母音": "أَشْبَاهُ العِلَلِ",
 "半永久的": "شِبْه دَائِم, طَوِيل الأَمَد (مُتَعَلِّق بِفَتْرَة زَمَنِيَّة طَويلَة نِسْبِيًّا أَوْ مُمْتَدّ عَلَيْها)",
 "半沢": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "半流動体": "شِبْهُ سَائِل (سائل إلى حدّ ما؛ بين الصلب والسائل)",
 "半減期": "عمر النصف (الوقت اللازم لشيء ما للانخفاض إلى نصف قيمته الأولية (على وجه الخصوص، الوقت اللازم لتحلل نصف الذرات في مادة مشعة))",
 "半澤": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "半焼け": "غَيْرُ مُكْتَمِلِ النُّضْج, نَاقِصُ الطَّهْو (لَمْ يُطْهَ بِالقَدْرِ الكَافِي) / أَحْمَق, طَائِش (سخيف وعديم الجدوى تماماً)",
 "半熟": "مَسْلُوقٌ بِنِصْفِ نُضْج ((عَنِ البَيْض) لَا يَزَالُ الصَّفَارُ سَائِلًا) / رقيق القلب, طيب القلب (سهل التأثر بالشفقة أو الحزن)\nمثال: قاضٍ رقيق القلب / غير ناضج, فج (غير مكتمل النمو أو النضج؛ غير يانع) / غَيْرُ جَاهِز, غَيْرُ نَاضِج (لم يكتمل استعداده بعد)\nمثال: فاكهة غير ناضجة",
 "半熟卵": "مَسْلُوقٌ بِنِصْفِ نُضْج ((عَنِ البَيْض) لَا يَزَالُ الصَّفَارُ سَائِلًا) / رقيق القلب, طيب القلب (سهل التأثر بالشفقة أو الحزن)",
 "半片": "كَعْب التَّذْكِرَة (جزء ممزق من التذكرة يُعاد إلى حاملها كإيصال)",
 "半狂乱": "مُجَنَّن, مُختَلُّ العَقْل (دُفِع إلى الجنون؛ فَقَدَ عقله)",
 "半獣神": "ساتير",
 "半球": "نِصْف كُرَة",
 "半球形": "نِصْف كُرَة",
 "半生": "نَادِر / شِبْه جَافّ (جافّ إلى حدٍّ ما) / غَيْرُ مُكْتَمِلِ النُّضْج, نَاقِصُ الطَّهْو (لَمْ يُطْهَ بِالقَدْرِ الكَافِي) / أَحْمَق, طَائِش (سخيف وعديم الجدوى تماماً)",
 "半田": "سبيكة لحام, مادة اللحام (سبيكة (عادة من الرصاص والقصدير) تستخدم عند صهرها لربط سطحين معدنيين)",
 "半田ごて": "مِكْوَاةُ اللَّحَّام, كاوِيَةُ اللَّحَّام",
 "半田付け": "لحام, لصق (التثبيت بإحكام معاً)",
 "半畳": "تشويش, مقاطعة (الصياح لمقاطعة خطاب لا توافق عليه)",
 "半畳を入れる": "قَاطَعَ",
 "半畳を打つ": "قَاطَعَ",
 "半盲症": "عَمًى",
 "半直線": "شُعَاع / شِفْنِين, شِفْنِين بَحْرِيّ",
 "半神": "نِصْف إِلٰه",
 "半神半人": "نِصْف إِلٰه",
 "半端": "بقايا قماش, فضلة قماش (قطعة قماش متبقية بعد استخدام الباقي أو بيعه) / بقايا (جزء صغير أو حصة تتبقى بعد زوال الجزء الرئيسي) / قِطْعَة (القِطْعَةُ: الْجُزْءَ أو الحِصَّة من الشيءِ؛ القِطْعَةُ: فقرة قصيرة عادة من مقالٍ أو كتاب) / كَسْر, كُسُور\nمثال: يصنع قطعة أثاث خشبية. / فِي مُنْتَصَف الطَّرِيق (في نصف المسافة؛ في المنتصف) / مُنْتَصَف, وَسَط (على مسافة متساوية من الأطراف) / جُزْئِيّ, نِصْفِيّ (لا يشمل إلّا النصف أو جزءًا فقط) / فِي مُنْتَصَفِ الطَّرِيق (عِنْدَ نُقْطَةٍ وَسَطٍ بَيْنَ طَرَفَيْنِ)\nمثال: كان في منتصف السلم عندما سقط / غير مسؤول, مستهتر (يظهر عدم الاكتراث بالعواقب)\nمثال: تصرف كأحمق غير مسؤول",
 "半端じゃない": "كبير, معتبر (كبير أو كبير نسبياً في العدد أو الكمية أو المدى أو الدرجة)\nمثال: كمية معتبرة",
 "半端ない": "بثقل, بشكل كبير (بدرجة كبيرة)\nمثال: اعتمد بشكل كبير على بيانات الآخرين",
 "半端物": "أخلاط, أشياء متنوعة (تشكيلة مختلطة من الأشياء)",
 "半端者": "أحمق, بليد (شخص غبي؛ تستخدم هذه الكلمات للتعبير عن رأي متدنٍ في ذكاء شخص ما)",
 "半経験的": "شِبْهُ تَجْرِيبِيّ (يعتمد إلى حدّ ما على الملاحظة أو التجربة)",
 "半纏木": "حور أصفر, شجرة الزنبق (شجرة خشب نفضية طويلة في أمريكا الشمالية لها زهور صفراء مخضرة كبيرة تشبه الزنبق وثمار تشبه المخروط؛ تنتج أخشاباً بيضاء ناعمة تستخدم خاصة لأعمال الخزائن)",
 "半股引き": "يصل للركبة (يمتد إلى الركبة) / مُختَصَر إِلَى النِّصْف (اختُصِرَ إلى نصف طوله الأصلي) / لِلنِّصْف العُلْوِيّ, نِصْفِيّ (يُمثل النصف العلوي فقط من الجسم) / صورة نصفية (بورتريه يظهر الجسم من الخصر لأعلى فقط)",
 "半自動小銃": "ذَاتِيّ التَّعْبِئَة, نِصْف آلِيّ ((للأسلحة النارية) قادر على التعبئة والإطلاق المتواصل آلياً) / نِصْف آلِيّ (آلي جزئياً) / مسدس نصف آلي (مسدس عبارة عن سلاح ناري نصف آلي قادر على التحميل والإطلاق بشكل مستمر)",
 "半舷上陸": "إجازة الشاطئ (إجازة تُمنح لبحار أو ضابط بحري)",
 "半蔀": "ثُنَائِيّ, مِن جُزْأَيْن (يتضمن جزأين أو عنصرين)",
 "半藤": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "半衿": "قطعة رقبة (قطعة من الملابس تلبس حول الرقبة)",
 "半袖": "كم قصير, نصف كم (كم يمتد من الكتف إلى الكوع)",
 "半装軌車": "نِصْف مُجَنْزَر (له جنازير في الخلف وعجلات في الأمام)",
 "半裸体": "شِبْه عَارٍ (مكسوّ جزئياً فقط)",
 "半規管": "قناة هلالية (إحدى ثلاث حلقات أنبوبية مملوءة بسائل وفي مستويات متعامدة تقريباً مع بعضها البعض؛ معنية بالتوازن)",
 "半諧音": "سجع, قافية حروف العلة (تكرار حروف العلة المتشابهة في المقاطع المشددة للكلمات المتتالية)",
 "半身不随": "شلل نصفي (شلل جانب واحد من الجسم)",
 "半身像": "مُختَصَر إِلَى النِّصْف (اختُصِرَ إلى نصف طوله الأصلي) / لِلنِّصْف العُلْوِيّ, نِصْفِيّ (يُمثل النصف العلوي فقط من الجسم) / صورة نصفية (بورتريه يظهر الجسم من الخصر لأعلى فقط)",
 "半身浴": "مغطس مقعدي (حوض استحمام تُغمر فيه الأرداف والوركين كما لو كنت جالساً على كرسي وتستحم في وضعية الجلوس)",
 "半身麻痺": "شلل نصفي (شلل جانب واحد من الجسم)",
 "半輪": "نصف دائرة (شكل مستوٍ له شكل نصف دائرة)",
 "半農": "وَظِيفَة بِدَوَامٍ جُزْئِيّ, عَمَل جُزْئِيّ (ما يُقَدَّر من الشيء في زمن مُعَيَّن؛ مَنْصِب)\nمثال: ما وظيفة زوجتك؟",
 "半透明": "شِبْه شَفَّاف (يسمح بمرور الضوء بشكل منتشر دون أن يكون شفّافاً تماماً)",
 "半透膜": "غشاء شبه منفذ (غشاء (مثل غشاء الخلية) يسمح لبعض الجزيئات بالمرور من خلاله دون غيرها)",
 "半途": "فِي مُنْتَصَف الطَّرِيق (في نصف المسافة؛ في المنتصف) / مُنْتَصَف, وَسَط (على مسافة متساوية من الأطراف) / جُزْئِيّ, نِصْفِيّ (لا يشمل إلّا النصف أو جزءًا فقط) / فِي مُنْتَصَفِ الطَّرِيق (عِنْدَ نُقْطَةٍ وَسَطٍ بَيْنَ طَرَفَيْنِ)\nمثال: كان في منتصف السلم عندما سقط",
 "半通夜": "أَيْقَظَ (نبَّهه، ضد نَوَّمَه؛ الغبارَ: أثاره)\nمثال: أيقظ زيري السائق",
 "半過去": "مستمر (زمن للأفعال يُستخدم في وصف حدث مستمر)",
 "半道": "فِي مُنْتَصَف الطَّرِيق (في نصف المسافة؛ في المنتصف) / مُنْتَصَف, وَسَط (على مسافة متساوية من الأطراف) / جُزْئِيّ, نِصْفِيّ (لا يشمل إلّا النصف أو جزءًا فقط) / فِي مُنْتَصَفِ الطَّرِيق (عِنْدَ نُقْطَةٍ وَسَطٍ بَيْنَ طَرَفَيْنِ)\nمثال: كان في منتصف السلم عندما سقط",
 "半道海豚": "دلفين قاروري الأنف (أي من عدة دلافين ذات جبهة مستديرة ومنقار متطور؛ تعيش بشكل رئيسي في شمال المحيط الأطلسي والبحر الأبيض المتوسط)",
 "半金属": "شِبْهُ فِلِزِّيّ (عُنْصُرٌ لَا فِلِزِّيٌّ لَهُ بَعْضُ خَصَائِصِ الفِلِزَّات)",
 "半鐘": "إنذار حريق, كاشف دخان (إنذار ينطلق بسبب الحريق أو الدخان) / إنذار الحريق (صيحة أو جرس للتحذير من اندلاع حريق)",
 "半長靴": "جَزْمَة (الأكلة الواحدة ليلا ونهارا؛ هي السُكُون بمعنى علامة الجزم من الحركات) / بسطار",
 "半間": "أَحْمَق, غَبِيّ (مُغَفَّل، أَبْلَه، طَائِش)\nمثال: قبلني ايها الأحمق.",
 "半陰影": "شِبْه ظِلّ",
 "半陰陽": "خُنْثَى / خُنْثَوِيّ",
 "半面": "مُدَّة / فَتْرَة / فِي حِين, بَيْنَمَا (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي. / فِي نَفْس اَلْوَقْت (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي. / حُدُود خَارِجِيَّة / صُورَة جَانِبِيَّة / سِيرَة / شُهْرَة / بُرُوز / نِصْف, نُصْف"
}
