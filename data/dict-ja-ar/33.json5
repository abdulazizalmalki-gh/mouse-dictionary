 "和声学": "علم التوافقيات (دراسة الصوت الموسيقي)",
 "和姦": "زِنًى, سِفَاح (مَارَسَ الزِّنَى)",
 "和字": "كَانَا",
 "和尚": "معلم جامعي (معلم في جامعة أو كلية (خاصة في كامبريدج أو أكسفورد)) / رَاهِب, نَاسِك (اسم فاعل للفعل رَهَبَ؛ عند المَسِيحِيّين هو من تَبَتَّلَ لله واعْتَزَلَ الناس إلى بعض الأدْيِرَة طلبا للعِبَادَة) / سَيِّد / أُصُولِيّ, أُصُولِيَّة / أحسن, أتقن ((أَحْسَنَ): فعل مَا هُوَ حسن؛ (أَحْسَنَ) الشَّيْء: أَجَاد صنعه وأتقنه)\nمثال: يبدو زيري أحسن.",
 "和平": "سَلَام, هُدُوء (أمان، سِلم، صُلْح؛ السلامةُ والبراءة من العيوبِ) / سَلَام (أمان، سِلم، صُلْح؛ السلامةُ والبراءة من العيوبِ)\nمثال: هن يردن السلام.",
 "和平プロセス": "عملية السلام (أي عملية اجتماعية تقوم بها الحكومات التي ترغب في أن يعتقد مواطنوها أنها تحاول تجنب الأعمال العدائية المسلحة)",
 "和平交渉": "مُفَاوَضَاتُ السَّلَامِ, مُحَادَثَاتُ السَّلَامِ",
 "和平会談": "مُفَاوَضَاتُ السَّلَامِ, مُحَادَثَاتُ السَّلَامِ",
 "和平工作": "مبادرة سلام (حركة افتتاحية في التفاوض على معاهدة سلام)",
 "和御寮": "مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة!",
 "和戦": "سَلَام, هُدُوء (أمان، سِلم، صُلْح؛ السلامةُ والبراءة من العيوبِ) / سَلَام (أمان، سِلم، صُلْح؛ السلامةُ والبراءة من العيوبِ)\nمثال: هن يردن السلام.",
 "和歌山": "وَاكَايَامَا",
 "和殿": "مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة!",
 "和気あいあい": "مُتَنَاغِم, مُنْسَجِم (يعيش في وئام وانسجام مع الآخرين) / مُنَاسِب, مُنْسَجِم (مُلَائِمٌ وَمُتَوَافِقٌ) / مُتَمَاثِل, مُتَنَاسِب (يُظهِر تكافؤاً أو تناسباً بين مكوّناته) / متناغم, منسجم (ممتع موسيقياً)",
 "和気藹々": "مُتَنَاغِم, مُنْسَجِم (يعيش في وئام وانسجام مع الآخرين) / مُنَاسِب, مُنْسَجِم (مُلَائِمٌ وَمُتَوَافِقٌ) / مُتَمَاثِل, مُتَنَاسِب (يُظهِر تكافؤاً أو تناسباً بين مكوّناته) / متناغم, منسجم (ممتع موسيقياً)",
 "和気藹藹": "مُتَنَاغِم, مُنْسَجِم (يعيش في وئام وانسجام مع الآخرين) / مُنَاسِب, مُنْسَجِم (مُلَائِمٌ وَمُتَوَافِقٌ) / مُتَمَاثِل, مُتَنَاسِب (يُظهِر تكافؤاً أو تناسباً بين مكوّناته) / متناغم, منسجم (ممتع موسيقياً)",
 "和琴": "عَرَبَة",
 "和睦": "صُلْح, مُصَالَحَة",
 "和蘭芥子": "قُرَّة, حُرْف",
 "和蘭芹": "مَقْدُونِس, بَقْدُونِس",
 "和親": "صَدَاقَة (المَحَبَّة بالصِّدْق. هي العِلاقَة بين شخصين أو أكثر قائِمَة على المحبة والصدق فكل منهم يحب الآخر ويَصْدُقه ويُصَدِّقه، كل منهم هو صَدِيق للآخر)\nمثال: الغيرة عدوة الصداقة.",
 "和親条約": "مُعَاهَدَة سَلَام (مؤنث مُعَاهَد، وهو اسم مفعول من عَاهَدَ؛ اتِّفَاق مُقَرّر بين دَوْلَتَيْن أو أكثر على أمور معينة)\nمثال: أمضيت المعاهدة يوم 18 نوفمبر 1903.",
 "和解": "صُلْح, مُصَالَحَة",
 "和解案": "مُسْتَعْمَرَة, مُسْتَوْطَنَة",
 "和語": "اللغة اليابانية (اللغة (التي تعتبر عادة ألطية) التي يتحدث بها اليابانيون)",
 "和諧": "اِنْسِجَام, تَوَافُق",
 "和郎": "فَتًى, غُلَام (شَابٌّ أوَّلَ شبابه بين المراهقة والرُّجولة؛ عبد، خادم) / صَبِيّ, فَتًى / ياه\nمثال: ترى الفتاة الفتى. / اِبْن زِنًى, بِنْت زِنًى (الولد الذكر)\nمثال: هو له ابن صغير. / مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة!",
 "和集合": "اِتِّحَاد, اِتِّفَاق (اِتِّحَاد؛ الاتِّحاد الأوربيّ : (السياسة) اتِّحاد أوربيّ إقليميّ أنشئ بمقتضى معاهدة ماستريخت في عام 1993 م…) / زَوَاج\nمثال: عاش الاتحاد السوفيتي!",
 "和音": "وَتَر, اِئْتِلَاف نَغَمَات (خيط شديد أو سلك يربط بين طرفي القوس ليستخدم في إطلاق السهام. سمي كذلك لأنه واحد، مشتق من الوِتْر وهو الفرد؛ خيط شديد أو سلك يربط على الآلة الموسيقية لإطلاق الصوت. سمي كذلك تشبيها له بوَتَر القَوْس)",
 "和風": "نسيم معتدل (رياح تتحرك بسرعة 13-18 عقدة؛ 4 على مقياس بوفورت)",
 "咎": "خَطَأ (تعني ضدّ الصواب. يشمل ذلك الفعل، القول، والرأي. يُستخدم الفعل \"أخطأ\" للدلالة على عدم الإصابة…؛ قام بعمل بعيد عن الصواب أو مخالف للحق سواء كان ذلك في السلوك أو القول أو الكتابة) / غَلْطَة / غَلَط\nمثال: كان خطأ حاسوبي. / خَطِيئَة, إِثْم / أَثِمَ, أَذْنَبَ ((أَثِمَ) أثما وإثما وأثاما ومأثما: وقع في الإثم فهو أثم وآثم وأثيم وأثام وأثوم)\nمثال: أثمة ما تريد إخباري عنه؟",
 "咎め": "لَوْم, مَلَامَة",
 "咎める": "لَوْم, مَلَامَة / سُؤَال, سؤال (سُؤَال) / مَسْأَلَة / استفهم\nمثال: أجب على السؤال. / زُبّ, زُبْر (في : اللحية أو مقدمها؛ في : الأنف)",
 "咎め立て": "تَذَمُّر, تَصَيُّد الْأَخْطَاء (نقد تافه وغير مبرر ومستمر)",
 "咎人": "جَانٍ ((جَانَ) جونا وجونة: اسود)",
 "咏": "تِلَاوَة / مُؤَلَّف, مُصَنَّف",
 "咒": "تميمة الحظ, جالب للحظ (شيء يُعتقد أنه يجلب الحظ السعيد) / جاذبية, سحر (الجاذبية التي تثير الاهتمام أو تسعد أو تحفز) / كوارك ساحر, نكهة السحر ((فيزياء) إحدى نكهات الكوارك الست، وهو الثالث من حيث الكتلة بين جميع الكواركات) / تعويذة, رقى (صيغة لفظية يُعتقد أن لها قوة سحرية)\nمثال: كانت ابتسامته جزءاً من جاذبيته لها / لَعْنَة (أي رغبة صريحة في أن تصيب المحن أو أي شكل من أشكال سوء الحظ كيانًا ما، سواء كان شخصًا، أو مكانًا، أو كائنًا) / نِقْمَة / لَعَنَ ((في الدين) طَرَدَهُ اللَّٰهُ مِنْ رَحْمَتِهِ؛ سَبَّ، شَتَمَ) / شَتَمَ, سَبَّ\nمثال: اللعنة حولها ومعرفة / تعويذة, مانترا ((سنسكريتية) تعني حرفياً 'قول مقدس' في الفيدية؛ واحدة من مجموعة ترانيم شعرية منقولة شفهياً) / تعويذة متكررة, مانترا (كلمة أو عبارة مكررة بشكل شائع)\nمثال: كررت 'مسرورة جداً بسير الأمور' على فترات مثل المانترا",
 "咒い": "لَعْنَة (أي رغبة صريحة في أن تصيب المحن أو أي شكل من أشكال سوء الحظ كيانًا ما، سواء كان شخصًا، أو مكانًا، أو كائنًا) / نِقْمَة / لَعَنَ ((في الدين) طَرَدَهُ اللَّٰهُ مِنْ رَحْمَتِهِ؛ سَبَّ، شَتَمَ) / شَتَمَ, سَبَّ\nمثال: اللعنة حولها ومعرفة / تميمة الحظ, جالب للحظ (شيء يُعتقد أنه يجلب الحظ السعيد) / جاذبية, سحر (الجاذبية التي تثير الاهتمام أو تسعد أو تحفز) / كوارك ساحر, نكهة السحر ((فيزياء) إحدى نكهات الكوارك الست، وهو الثالث من حيث الكتلة بين جميع الكواركات) / تعويذة, رقى (صيغة لفظية يُعتقد أن لها قوة سحرية)\nمثال: كانت ابتسامته جزءاً من جاذبيته لها",
 "咨詢": "سُؤَال, سؤال (سُؤَال) / مَسْأَلَة / استفهم\nمثال: أجب على السؤال.",
 "咬ます": "اِتِّفَاقِيَّة / جَرَّ, سَحَبَ (جَرَّ الحيوانَ وغيرَه: جذبه وسحبه؛ جَرَّ أذيالَه: تبختر، زها بنفسه، اختال)\nمثال: اضطررت إلى جر سامي.",
 "咬ませる": "اِتِّفَاقِيَّة / جَرَّ, سَحَبَ (جَرَّ الحيوانَ وغيرَه: جذبه وسحبه؛ جَرَّ أذيالَه: تبختر، زها بنفسه، اختال)\nمثال: اضطررت إلى جر سامي.",
 "咬み傷": "عَضَّ, قَضَمَ / عَضَّ / قَرْصة / لُقْمة",
 "咬み合わせ": "انسداد, سد (فعل السد أو الغلق) / انسداد, سدادة (عائق في أنبوب أو مجرى) / إِطْبَاق, إِطْبَاق الأَسْنَان ((طب الأسنان) العلاقة المكانية الطبيعية للأسنان عندما يكون الفكان مغلقين) / جبهة محبوسة, جبهة مقفلة ((في الأرصاد الجوية) جبهة مركبة عندما يحيط الهواء البارد بكتلة من الهواء الدافئ ويجبرها على الارتفاع)\nمثال: اضطررنا لاستدعاء سباك لإزالة الانسداد في أنبوب الصرف",
 "咬む": "عَضَّ, قَضَمَ / عَضَّ / قَرْصة / لُقْمة / مَضَغَ / تاتاة, تلعثم (اضطراب في الكلام ينطوي على تردد وتكرار لا إرادي لأصوات معينة) / شَبَكَة",
 "咬傷": "عَضَّ, قَضَمَ / عَضَّ / قَرْصة / لُقْمة",
 "咬創": "عَضَّ, قَضَمَ / عَضَّ / قَرْصة / لُقْمة",
 "咬合": "انسداد, سد (فعل السد أو الغلق) / انسداد, سدادة (عائق في أنبوب أو مجرى) / إِطْبَاق, إِطْبَاق الأَسْنَان ((طب الأسنان) العلاقة المكانية الطبيعية للأسنان عندما يكون الفكان مغلقين) / جبهة محبوسة, جبهة مقفلة ((في الأرصاد الجوية) جبهة مركبة عندما يحيط الهواء البارد بكتلة من الهواء الدافئ ويجبرها على الارتفاع)\nمثال: اضطررنا لاستدعاء سباك لإزالة الانسداد في أنبوب الصرف",
 "咬合器": "عضو ناطق (عضو نطق متحرك) / لافظ (شخص يلفظ الكلمات)",
 "咬痙": "تيتانوس, كزاز (عدوى بكتيرية حادة وخطيرة تصيب الجهاز العصبي المركزي وتدخل عبر الجروح المفتوحة؛ قد تحدث تشنجات في الفك وعضلات الحنجرة في المراحل المتأخرة)",
 "咬耗": "تآكل بالاحتكاك, سحج (فعل الفرك معًا؛ إهلاك الشيء عن طريق الاحتكاك) / استنزاف (الإنهاك بغرض الإضعاف أو التدمير) / توبة, ندامة (الأسى على الخطيئة الناشئ عن الخوف من العقاب) / تآكل, سحج (تآكل جزيئات الصخور عن طريق الاحتكاك بسبب الماء أو الرياح أو الجليد)\nمثال: حرب استنزاف",
 "咬耗症": "تآكل بالاحتكاك, سحج (فعل الفرك معًا؛ إهلاك الشيء عن طريق الاحتكاك) / استنزاف (الإنهاك بغرض الإضعاف أو التدمير) / توبة, ندامة (الأسى على الخطيئة الناشئ عن الخوف من العقاب) / تآكل, سحج (تآكل جزيئات الصخور عن طريق الاحتكاك بسبب الماء أو الرياح أو الجليد)\nمثال: حرب استنزاف",
 "咬頭": "نقطة الالتقاء (نقطة تتشكل من قوسين متقاطعين (كما في القوس القوطي)) / حدبة الأسنان, شرفة (ارتفاع صغير على سطح طحن الأسنان) / شرفة, وريقة (سديلة مثلثة رقيقة لصمام القلب)",
 "咲きだす": "خَرَجَ (اِنْتَقَلَ إلى خارج المكان) / غَادَرَ (تَرَكَ)\nمثال: خرج سامي ليحتفل.",
 "咲き出す": "خَرَجَ (اِنْتَقَلَ إلى خارج المكان) / غَادَرَ (تَرَكَ)\nمثال: خرج سامي ليحتفل.",
 "咲く": "إزهار, تزهير (رواسب مسحوقية على سطح ما) / زهرة (العضو التكاثري للنباتات كاسيات البذور خاصة تلك التي لها أجزاء مبهرجة أو ملونة) / إزهار, تفتح (العملية العضوية لحمل الزهور) / تورد, نضارة (لون وردي (خاصة في الخدين) يؤخذ كعلامة على الصحة الجيدة)\nمثال: سوف توقف كل الإزهار إذا تركت الزهور تنتج البذور",
 "咳": "كَحَّ, سَعَلَ / سَعَلَ (سَعِلَ يَسْعَلَ سَعَلاً: نَشِطَ) / سُعْلَة, سُعَال\nمثال: سعل زيري مرة أخرى.",
 "咳が出る": "كَحَّ, سَعَلَ / سَعَلَ (سَعِلَ يَسْعَلَ سَعَلاً: نَشِطَ) / سُعْلَة, سُعَال\nمثال: سعل زيري مرة أخرى.",
 "咳く": "كَحَّ, سَعَلَ / سَعَلَ (سَعِلَ يَسْعَلَ سَعَلاً: نَشِطَ) / سُعْلَة, سُعَال\nمثال: سعل زيري مرة أخرى.",
 "咳嗽": "كَحَّ, سَعَلَ / سَعَلَ (سَعِلَ يَسْعَلَ سَعَلاً: نَشِطَ) / سُعْلَة, سُعَال\nمثال: سعل زيري مرة أخرى.",
 "咳払い": "كَحَّ, سَعَلَ / سَعَلَ (سَعِلَ يَسْعَلَ سَعَلاً: نَشِطَ) / سُعْلَة, سُعَال\nمثال: سعل زيري مرة أخرى.",
 "咳止め": "أَدْوِيَةُ السُعَال",
 "咽せっぽい": "خنق (فعل خنق (شخص ما) عن طريق الضغط على القصبة الهوائية) / خَنَّاق, كَاتِم لِلْأَنْفَاس (يُسَبِّب صُعُوبَة فِي التَّنَفُّس خَاصَّةً بِسَبَب نَقْص الهَوَاء النَّقِيّ) / اختناق, غصة (حالة ناتجة عن انسداد الممرات الهوائية المؤدية إلى الرئتين (كما هو الحال مع الطعام أو تورم الحنجرة))\nمثال: لا يوجد دليل على أن الخنق تم بواسطة المتهم",
 "咽せる": "اِخْتَنَقَ / خَنَقَ (خَنَقَ (خنقه) خنقا: عصر حلقه حتى مات؛ خَنَقَ الوقت: أخره وضيقه)\nمثال: خنق زيري وليد بعمامته.",
 "咽び泣き": "شهيق البكاء, نشيج (شهقة تشنجية تحدث أثناء البكاء)",
 "咽び泣く": "شهيق, شهقة / شَهِقَ (تنفس بصوت عالٍ وبشكل مفاجئ نتيجة التعب أو الخوف أو الضيق؛ في لغة الطيور: أصدرت صوتًا عاليًا يشبه الشهيق)",
 "咽る": "اِخْتَنَقَ / خَنَقَ (خَنَقَ (خنقه) خنقا: عصر حلقه حتى مات؛ خَنَقَ الوقت: أخره وضيقه)\nمثال: خنق زيري وليد بعمامته.",
 "咽喉": "حَلْق, حُلْقُوم (أصاب حَلْقه أو ضربه في حلقه؛ أزال شعر رأسه أو ذقنه كله بالمُوسَى)\nمثال: حلق زيري لحيته.",
 "咽頭": "بُلْعُوم",
 "咽頭反射": "منعكس البلعوم, منعكس التقيؤ (منعكس طبيعي يتكون من التهوع؛ قد ينتج عن لمس الحنك الرخو في الجزء الخلفي من الفم)",
 "咽頭炎": "التهاب البلعوم, التهاب الحلق (التهاب الحلق والبلعوم)",
 "咽頭痛": "اِلْتِهَاب حَلْق",
 "哀": "شَفَقَة (وشَفِقَ على؛ الرحمة والعَطْف والحَنَان والحُنُوّ) / شَفِقَ ((شَفِقَ) منه، وعليه يَشْفَقَ شَفَقًا: خاف وحَذِرَ، فهو شَفِقٌ؛ (شَفِقَ) عليه: رَقَّ له وعطف عليه؛ فهو شَفِيقٌ)\nمثال: زيري مثير للشفقة.",
 "哀しい": "حَزِين, زعلان / مُحْزِنٌ\nمثال: そんな悲しい目で見ないで。 — لا تنظري إلي بهاتين العينين الحزينتين. / مُحْزِنٌ",
 "哀しいかな": "وَا حَسْرَتَاه, وَاهًا",
 "哀しさ": "حُزْن (يقالُ: أَصابَهُ حَزَنٌ شَديدٌ وحُزْنٌ شَديدٌ:(الهَمُّ)؛ حَزِنَ الرّجل : اغْتَمَّ ، حزِنت المرأة:لبست السّواد)\nمثال: شعر توم بالحزن.",
 "哀しみ": "حُزْن (يقالُ: أَصابَهُ حَزَنٌ شَديدٌ وحُزْنٌ شَديدٌ:(الهَمُّ)؛ حَزِنَ الرّجل : اغْتَمَّ ، حزِنت المرأة:لبست السّواد)\nمثال: شعر توم بالحزن.",
 "哀しむ": "نَدِمَ / تَأَسَّفَ (تأسُّف) / أَسَف (مصدر أسِفَ على / أسِفَ لـ / أسِفَ من؛ أَسَفِي شَدِيدٌ على ما بَدَرَ مِنِّي : نَدَمِي) / تَأَسُّف (تأسُّف)\nمثال: للأسف ذلك صحيح.",
 "哀びん": "شَفَقَة (وشَفِقَ على؛ الرحمة والعَطْف والحَنَان والحُنُوّ) / شَفِقَ ((شَفِقَ) منه، وعليه يَشْفَقَ شَفَقًا: خاف وحَذِرَ، فهو شَفِقٌ؛ (شَفِقَ) عليه: رَقَّ له وعطف عليه؛ فهو شَفِيقٌ)\nمثال: زيري مثير للشفقة.",
 "哀みん": "شَفَقَة (وشَفِقَ على؛ الرحمة والعَطْف والحَنَان والحُنُوّ) / شَفِقَ ((شَفِقَ) منه، وعليه يَشْفَقَ شَفَقًا: خاف وحَذِرَ، فهو شَفِقٌ؛ (شَفِقَ) عليه: رَقَّ له وعطف عليه؛ فهو شَفِيقٌ)\nمثال: زيري مثير للشفقة.",
 "哀れ": "شَفَقَة (وشَفِقَ على؛ الرحمة والعَطْف والحَنَان والحُنُوّ) / شَفِقَ ((شَفِقَ) منه، وعليه يَشْفَقَ شَفَقًا: خاف وحَذِرَ، فهو شَفِقٌ؛ (شَفِقَ) عليه: رَقَّ له وعطف عليه؛ فهو شَفِيقٌ)\nمثال: زيري مثير للشفقة. / مُثِير لِلشَّفَقَة, مُزْرٍ (يُثِير مَزيجاً مِن الاحتقار والشَّفَقة) / بَائِس, مُثِيرٌ لِلشَّفَقَة (يَسْتَحِقُّ الشَّفَقَةَ أَوْ يَسْتَدْعِيهَا) / وَا حَسْرَتَاه, وَاهًا",
 "哀れがる": "شَفَقَة (وشَفِقَ على؛ الرحمة والعَطْف والحَنَان والحُنُوّ) / شَفِقَ ((شَفِقَ) منه، وعليه يَشْفَقَ شَفَقًا: خاف وحَذِرَ، فهو شَفِقٌ؛ (شَفِقَ) عليه: رَقَّ له وعطف عليه؛ فهو شَفِيقٌ)\nمثال: زيري مثير للشفقة.",
 "哀れっぽい": "حَزِين, شَجِيّ (يعبّر عن الحزن والأسى)",
 "哀れみ": "شَفَقَة (وشَفِقَ على؛ الرحمة والعَطْف والحَنَان والحُنُوّ) / شَفِقَ ((شَفِقَ) منه، وعليه يَشْفَقَ شَفَقًا: خاف وحَذِرَ، فهو شَفِقٌ؛ (شَفِقَ) عليه: رَقَّ له وعطف عليه؛ فهو شَفِيقٌ)\nمثال: زيري مثير للشفقة.",
 "哀れむ": "شَفَقَة (وشَفِقَ على؛ الرحمة والعَطْف والحَنَان والحُنُوّ) / شَفِقَ ((شَفِقَ) منه، وعليه يَشْفَقَ شَفَقًا: خاف وحَذِرَ، فهو شَفِقٌ؛ (شَفِقَ) عليه: رَقَّ له وعطف عليه؛ فهو شَفِيقٌ)\nمثال: زيري مثير للشفقة. / قَدَّرَ (قضاء الله وحكمه وما قَدَّرَه؛ مبلغ الشيء وكميتّه، بنفس معنى قَدْر) / عَلِمَ (أَدْرَكَ حقيقة الشيء) / رَفَعَ قِيمَة, زَادَ فِي قِيمَة (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ)\nمثال: خذ قدر ما تريد.",
 "哀れ気": "حَزِين, زعلان / مُحْزِنٌ",
 "哀傷": "حُزْن (يقالُ: أَصابَهُ حَزَنٌ شَديدٌ وحُزْنٌ شَديدٌ:(الهَمُّ)؛ حَزِنَ الرّجل : اغْتَمَّ ، حزِنت المرأة:لبست السّواد)\nمثال: شعر توم بالحزن.",
 "哀傷歌": "عَوِيل, رَثَاء / مَرْثِيَة / بَكَى, نَاحَ (دَمَعَتْ عَيناهُ حزنا؛ بكى الْمَيِّت: رثاه) / بَكَى, رَثَى (دَمَعَتْ عَيناهُ حزنا؛ بكى الْمَيِّت: رثاه)\nمثال: بكى زيري كثيرا.",
 "哀切": "سَخِيف, مُثِير لِلشَّفَقَة (يُثِير شَفَقَةً مَشُوبَةً بِالاِزْدِرَاء) / مُثِير لِلشَّفَقَة, مُزْرٍ (يُثِير مَزيجاً مِن الاحتقار والشَّفَقة) / بَائِس, مُثِيرٌ لِلشَّفَقَة (يَسْتَحِقُّ الشَّفَقَةَ أَوْ يَسْتَدْعِيهَا)",
 "哀号": "تَأَوَّهَ (قَالَ آه؛ تَحَسَّرَ، تَنَهَّدَ)",
 "哀哭": "غَمّ, حُزْن",
 "哀悼": "تَأْسِيَة / تَعْزِيَة",
 "哀悼痛惜": "تَأْسِيَة / تَعْزِيَة",
 "哀情": "حُزْن (يقالُ: أَصابَهُ حَزَنٌ شَديدٌ وحُزْنٌ شَديدٌ:(الهَمُّ)؛ حَزِنَ الرّجل : اغْتَمَّ ، حزِنت المرأة:لبست السّواد)\nمثال: شعر توم بالحزن.",
 "哀惜": "غَمّ, حُزْن",
 "哀愁": "إثارة المشاعر, شجن (صفة تثير العواطف (خاصة الشفقة أو الحزن)) / باثوس, شجن (أسلوب له القدرة على إثارة المشاعر) / إشفاق, رثاء (شعور بالتعاطف والحزن على مصائب الآخرين)\nمثال: الفيلم جسد كل الشجن في وضعهم",
 "哀愁漂う": "مُحْزَن",
 "哀愍": "شَفَقَة (وشَفِقَ على؛ الرحمة والعَطْف والحَنَان والحُنُوّ) / شَفِقَ ((شَفِقَ) منه، وعليه يَشْفَقَ شَفَقًا: خاف وحَذِرَ، فهو شَفِقٌ؛ (شَفِقَ) عليه: رَقَّ له وعطف عليه؛ فهو شَفِيقٌ)\nمثال: زيري مثير للشفقة.",
 "哀感": "إثارة المشاعر, شجن (صفة تثير العواطف (خاصة الشفقة أو الحزن)) / باثوس, شجن (أسلوب له القدرة على إثارة المشاعر) / إشفاق, رثاء (شعور بالتعاطف والحزن على مصائب الآخرين)\nمثال: الفيلم جسد كل الشجن في وضعهم",
 "哀憐": "شَفَقَة (وشَفِقَ على؛ الرحمة والعَطْف والحَنَان والحُنُوّ) / شَفِقَ ((شَفِقَ) منه، وعليه يَشْفَقَ شَفَقًا: خاف وحَذِرَ، فهو شَفِقٌ؛ (شَفِقَ) عليه: رَقَّ له وعطف عليه؛ فهو شَفِيقٌ)\nمثال: زيري مثير للشفقة.",
 "哀憫": "شَفَقَة (وشَفِقَ على؛ الرحمة والعَطْف والحَنَان والحُنُوّ) / شَفِقَ ((شَفِقَ) منه، وعليه يَشْفَقَ شَفَقًا: خاف وحَذِرَ، فهو شَفِقٌ؛ (شَفِقَ) عليه: رَقَّ له وعطف عليه؛ فهو شَفِيقٌ)\nمثال: زيري مثير للشفقة.",
 "哀歌": "عَوِيل, رَثَاء / مَرْثِيَة / بَكَى, نَاحَ (دَمَعَتْ عَيناهُ حزنا؛ بكى الْمَيِّت: رثاه) / بَكَى, رَثَى (دَمَعَتْ عَيناهُ حزنا؛ بكى الْمَيِّت: رثاه)\nمثال: بكى زيري كثيرا. / مَرَاثِي إِرْمِيَا",
 "哀痛": "ثَاكِل, مَفْجُوع (حزين بسبب فقدان أو حرمان)",
 "哀訴": "اِلْتِمَاس, اِسْتِئْنَاف / اِسْتَأْنَفَ",
 "哀訴嘆願": "التماس, دفع (رد يشير إلى سبب وجوب رفض الدعوى) / التماس, دفع ((قانون) إجابة المدعى عليه بمسألة واقعية (متميزاً عن الدفع الشكلي)) / استعطاف, التماس (طلب متواضع للمساعدة من شخص في السلطة)",
 "哀訴歎願": "التماس, دفع (رد يشير إلى سبب وجوب رفض الدعوى) / التماس, دفع ((قانون) إجابة المدعى عليه بمسألة واقعية (متميزاً عن الدفع الشكلي)) / استعطاف, التماس (طلب متواضع للمساعدة من شخص في السلطة)",
 "哀詩": "رِثَاء, مَرْثِيَة",
 "哀調をおびた": "حَزِين, شَجِيّ (يعبّر عن الحزن والأسى)",
 "哀調を帯びた": "حَزِين, شَجِيّ (يعبّر عن الحزن والأسى)",
 "哀願": "ابتهال, دعاء (فعل التواصل مع إله (خاصة كطلب أو في العبادة أو الندم أو الشكر)) / استعطاف, التماس (طلب متواضع للمساعدة من شخص في السلطة) / ابتهال, دعاء (صلاة لطلب عون الله كجزء من خدمة دينية)\nمثال: جثا الكاهن على ركبتيه في صلاة",
 "品": "مَقَال, مَقَالَة / أَدَاةُ تَعْرِيف, أَدَاةُ التَّعْرِيف / مادّةٌ, مَوَادُّ (مؤنث مَادّ، اسم فاعل من مَدَّ. الجمع مَادَّات؛ ما كان مَدَدًا لغيره)\nمثال: لا أحب مادة العلوم. / نَوْعِيَّة, جَوْدَة / دَلَال / مُسْتَوًى / مَرْحَلَة / فَصْل (التقطيع؛ تقسيم الشيء أجزاءً؛ جزء، باب في كِتَاب أو ماشابهه) / بَاب (ما يُسَدُّ به مَدْخَل المَبْنَى أو الغُرْفَة أو المَرْكَبَة؛ (تعميم) مَدْخَل أي شيء؛ فُتْحَة)\nمثال: اقرأ هذا الفصل. / أَنَاقَة / مَقَال, مَقَالَة / أَدَاةُ تَعْرِيف, أَدَاةُ التَّعْرِيف / مادّةٌ, مَوَادُّ (مؤنث مَادّ، اسم فاعل من مَدَّ. الجمع مَادَّات؛ ما كان مَدَدًا لغيره)\nمثال: لا أحب مادة العلوم.",
 "品がいい": "رَاقٍ, مُهَذَّب (يوحي بالذوق الرفيع واليسر والثراء) / مُحَسَّن, مُنَقَّح (دقيق إلى درجة رفيعة من الإحكام) / راق, مصقول ((للأشخاص وسلوكهم) مثقف ومهذب) / مكرر, منقى (منقى من الشوائب عن طريق المعالجة)\nمثال: كانت رقيقة ومهذبة وغير معتادة على المشقة",
 "品がない": "خشن, غير مهذب ((للأشخاص وسلوكهم) غير مهذب؛ فظ) / خام, غير مكرر (غير مكرر أو معالج)\nمثال: كيف يمكن لفتاة مهذبة أن تنجذب لرجل خشن كهذا؟",
 "品がよい": "رَاقٍ, مُهَذَّب (يوحي بالذوق الرفيع واليسر والثراء) / مُحَسَّن, مُنَقَّح (دقيق إلى درجة رفيعة من الإحكام) / راق, مصقول ((للأشخاص وسلوكهم) مثقف ومهذب) / مكرر, منقى (منقى من الشوائب عن طريق المعالجة)\nمثال: كانت رقيقة ومهذبة وغير معتادة على المشقة",
