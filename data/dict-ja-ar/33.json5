 "商": "خَارِج قِسْمَة, خَارِج / شَرِكَة / عَمَل, تِجَارَة (فِعْل، صُنْع؛ وسيلة للكسب، مِهْنَة، حِرْفَة) / رِعَايَة\nمثال: المهم هو العمل. / سلالة شانغ, شانغ (السلالة الإمبراطورية التي حكمت الصين من حوالي القرن الثامن عشر إلى القرن الثاني عشر قبل الميلاد)",
 "商い": "تِجَارَة / انقلاب, قلب (عملية قلب شيء ما) / إجمالي العائدات, حجم التداول (الحجم المقاس بالدولار) / تيرن أوفر, فطيرة مطوية (طبق يُصنع بطي قطعة من العجين فوق الحشوة) / دَوَرَان المُوَظَّفِين, مُعَدَّل الدَّوَرَان (نسبة عدد العمال الذين تم استبدالهم في فترة زمنية معينة إلى متوسط عدد العمال)\nمثال: أصيب برضوض شديدة بسبب انقلاب زلاجته بسرعة عالية",
 "商い屋": "دُكَّان, مَتْجَر (حانوت أو محل بيع؛ مصطبة يُقعد عليها) / تَسَوَّقَ, تَبَضَّعَ\nمثال: ذهب إلى الدكان.",
 "商い物": "سلعة تجارية (سلعة معروضة للبيع)",
 "商う": "بَاعَ (أَعْطَى الشيءَ بِثَمَن؛ اِشْتَرَى) / اِنْبَاعَ, بِيعَ\nمثال: باع زيري منزله.",
 "商人": "تَاجِر, تَاجِرَة",
 "商人根性": "تجارة, تجارية (المعاملات (البيع والشراء) التي تهدف إلى توفير السلع (البضائع والخدمات))",
 "商会": "بإصرار, بثبات (بتصميم حازم) / رَاسِخ, مَتِين (قويّ وأكيد) / رَاسِخ, مُخْلِص (ثَابِت لَا يَتَزَعْزَع فِي الإِخْلَاص لِصَدِيق أَوْ عَهْد أَوْ قَضِيَّة) / جَامِد, رَاسِخ (مُثَبَّت بِإِحْكَام فِي مَكَانِه)\nمثال: صدقنا ذلك بحزم",
 "商務省": "وزارة التجارة (الإدارة الفيدرالية الأمريكية التي تعزز وتدير التجارة المحلية والخارجية (بما في ذلك إدارة التعداد ومكتب براءات الاختراع)؛ أنشئت عام 1913)",
 "商号": "اسم تجاري, علامة تجارية (اسم يُعطى لمنتج أو خدمة)",
 "商品": "بِضَاعَة, بَضَائِع",
 "商品作物": "محصول تجاري, محصول نقدي (محصول قابل للبيع بسهولة يُزرع ويُجمع من أجل السوق (مثل الخضروات أو القطن أو التبغ))",
 "商品化": "إضفاء الطابع التجاري, تسويق تجاري (فعل جعل الشيء تجارياً؛ إدخال شيء ما في التجارة)\nمثال: اعتبر والدي تحويل عيد الميلاد إلى مناسبة تجارية تدنيساً للمقدسات",
 "商品取引所": "بورصة السلع (بورصة لبيع وشراء السلع للتسليم المستقبلي)",
 "商品名": "اسم تجاري, علامة تجارية (اسم يُعطى لمنتج أو خدمة)",
 "商品学": "إعلان, دعاية (العمل التجاري لجذب انتباه الجمهور إلى السلع والخدمات) / بيع, متاجرة (تبادل البضائع مقابل مبلغ متفق عليه من المال) / منتجات ترويجية (منتجات تحمل علامة تجارية تهدف للترويج لمنتج آخر، وخاصة الأفلام والفرق الموسيقية)",
 "商品目録": "جَرْد (جَرَدَ الشيءَ: أحصى ما فيه، ضبط قيمته؛ جَرَدَ البطاطسَ: قشّرها وأزال ما عليها)\nمثال: كان سامي جرد طفل.",
 "商品開発": "تطوير المنتجات (تحسين منتج موجود أو تطوير أنواع جديدة من المنتجات)",
 "商域": "سُوق (مكان للبيع والشراء؛ جمع ساق، قال الله تعالى: 《رُدُّوهَا عَلَيَّ فَطَفِقَ مَسْحًا بِالسُّوقِ وَالْأَعْنَاقِ》)\nمثال: ذهبت إلى السوق.",
 "商売": "تِجَارَة\nمثال: 地元の店は観光客相手に順調な商売をしている。 — المتاجر المحلية تقوم بمتاجرة جيدة مع السياح . / وَظِيفَة, مِهْنَة (ما يُقَدَّر من الشيء في زمن مُعَيَّن؛ مَنْصِب) / اِحْتِلال, إِشْغَال (احتلّ: نزل؛ احتلّ به واحتلّه: نزل به، واحتلّ الشيء: اتّخذه حلالاً)\nمثال: ما وظيفة زوجتك؟",
 "商売になる": "دَفَعَ, خَلَّصَ (لزّه ونحاه وأبعده؛ صرفه قبل وروده، أي منعه وأبعده قبل مجيئه أو حدوثه، وعكسه أن يرفعه، اي أن يصرفه بعد حدوثه) / معاش, أجر\nمثال: دفع زيري الثمن.",
 "商売人": "تَاجِر, تَاجِرَة / خَبِير, مَاهِر (الخَابِر الذي يعرف خَبَر الشيء؛ المُخْتَصّ بالشيء ويعرف كل شيء عنه) / مُتَخَصِّص, مُتَخَصِّصَة\nمثال: درب على يد خبير. / بائعة هوى",
 "商売女": "بائعة هوى",
 "商売道具": "أدوات المهنة, عدة العمل (أي معدات تستخدم باستمرار كجزء من مهنة أو وظيفة)\nمثال: الود هو أداة البائع في عمله",
 "商女": "دَاعِرَة, بَغِيَّة / دَعِرَ, بَغَى (دَعِرَ الْعود دعرا دخن وَلم يتقد)",
 "商家": "تَاجِر, تَاجِرَة",
 "商屋": "دُكَّان, مَتْجَر (حانوت أو محل بيع؛ مصطبة يُقعد عليها) / تَسَوَّقَ, تَبَضَّعَ\nمثال: ذهب إلى الدكان.",
 "商店": "دُكَّان, مَتْجَر (حانوت أو محل بيع؛ مصطبة يُقعد عليها) / تَسَوَّقَ, تَبَضَّعَ\nمثال: ذهب إلى الدكان.",
 "商店主": "صاحب دكان, صاحب متجر (تاجر يمتلك أو يدير متجراً)",
 "商店街": "وَسَطُ البَلَد",
 "商材": "مُنْتَج / سِلْعَة / حَاصِل (الشيء :حصل عليه) / مَحْصُول / حَاصِل ضَرْب (الشيء :حصل عليه) / جَدَاء",
 "商業": "تِجَارَة",
 "商業中心地": "وَسَطُ البَلَد",
 "商業主義": "تجارة, تجارية (المعاملات (البيع والشراء) التي تهدف إلى توفير السلع (البضائع والخدمات))",
 "商業信用状": "خطاب اعتماد تجاري (خطاب اعتماد يُعطى لمؤسسة تجارية لأغراض تجارية)",
 "商業化": "إضفاء الطابع التجاري, تسويق تجاري (فعل جعل الشيء تجارياً؛ إدخال شيء ما في التجارة)\nمثال: اعتبر والدي تحويل عيد الميلاد إلى مناسبة تجارية تدنيساً للمقدسات",
 "商業地": "المنطقة التجارية, حي تجاري (المنطقة المركزية أو المركز التجاري لبلدة أو مدينة)\nمثال: قلب وسط مدينة برمنغهام",
 "商業地域": "المنطقة التجارية, حي تجاري (المنطقة المركزية أو المركز التجاري لبلدة أو مدينة)\nمثال: قلب وسط مدينة برمنغهام",
 "商業手形": "ورقة تجارية (التزام قصير الأجل غير مضمون وغير مسجل يصدره مقترض مؤسسي للمستثمرين الذين لديهم نقد خامل مؤقتاً)",
 "商業用": "إِعْلَان تِجَارِيّ",
 "商業組合": "جمعية, رابطة (رابطة رسمية لأشخاص لديهم اهتمامات مماثلة)\nمثال: انضم إلى نادي الجولف",
 "商業美術": "فن تجاري (فن يُستخدم لأغراض تجارية (كما في الإعلانات))",
 "商業銀行": "بنك تجاري, مصرف تجاري (مؤسسة مالية تقبل الودائع تحت الطلب وتقدم القروض وتوفر خدمات أخرى للجمهور)",
 "商標": "عَلَامَة تِجَارِيَّة (سِمَةٌ أو أمارة أو شِعَار تُعرف به الأشياء؛ رَمْز)\nمثال: تحصلت على علامة أ.",
 "商標名": "اسم تجاري, علامة تجارية (اسم يُعطى لمنتج أو خدمة)",
 "商法": "تِجَارَة / قانون تجاري (مجموعة القواعد المطبقة على المعاملات التجارية؛ مستمدة من ممارسات التجار بدلاً من الفقه القانوني)",
 "商流": "قناة توزيع (طريقة لبيع منتج الشركة إما مباشرة أو عبر موزعين)",
 "商用": "شَرِكَة / عَمَل, تِجَارَة (فِعْل، صُنْع؛ وسيلة للكسب، مِهْنَة، حِرْفَة) / رِعَايَة\nمثال: المهم هو العمل.",
 "商用化": "إضفاء الطابع التجاري, تسويق تجاري (فعل جعل الشيء تجارياً؛ إدخال شيء ما في التجارة)\nمثال: اعتبر والدي تحويل عيد الميلاد إلى مناسبة تجارية تدنيساً للمقدسات",
 "商科": "تِجَارَة",
 "商舗": "دُكَّان, مَتْجَر (حانوت أو محل بيع؛ مصطبة يُقعد عليها) / تَسَوَّقَ, تَبَضَّعَ\nمثال: ذهب إلى الدكان.",
 "商船": "باخرة شحن, سفينة تجارية (سفينة شحن)\nمثال: قاموا بالكثير من تجارتهم الخارجية في سفن أجنبية",
 "商談": "مُفَاوَضَات, مُذَاكَرَات",
 "商議": "مُؤْتَمَر",
 "商議員": "محامي دفاع, مستشار قانوني (محامٍ يترافع في القضايا أمام المحكمة) / مرشد, ناصح (شخص يقدم المشورة بشأن المشكلات) / مشرف مخيم (شخص لديه واجبات إشرافية في مخيم صيفي)",
 "商量": "اهتمام, مراعاة (عمل ينم عن مراعاة وتفكير بالآخرين) / اهتمام بالآخرين, مراعاة (احترام ومراعاة لطيفة للآخرين) / اعتبار, نظر (عملية التفكير المتأني في شيء ما) / اعتبار, حالة (معلومات يجب وضعها في الاعتبار عند اتخاذ قرار)\nمثال: لم يظهر أي مراعاة لمشاعرها",
 "商銀": "بنك تجاري, مصرف تجاري (مؤسسة مالية تقبل الودائع تحت الطلب وتقدم القروض وتوفر خدمات أخرى للجمهور)",
 "商館": "بإصرار, بثبات (بتصميم حازم) / رَاسِخ, مَتِين (قويّ وأكيد) / رَاسِخ, مُخْلِص (ثَابِت لَا يَتَزَعْزَع فِي الإِخْلَاص لِصَدِيق أَوْ عَهْد أَوْ قَضِيَّة) / جَامِد, رَاسِخ (مُثَبَّت بِإِحْكَام فِي مَكَانِه)\nمثال: صدقنا ذلك بحزم",
 "商魂たくましい": "حَاذِق (اسم فاعل للفعل حَذِقَ أي المَاهِرِ المُتقِنِ لعَمَلِهِ) / نَاصِح, نَبِيه\nمثال: إنها حاذقة الذكاء.",
 "商魂逞しい": "حَاذِق (اسم فاعل للفعل حَذِقَ أي المَاهِرِ المُتقِنِ لعَمَلِهِ) / نَاصِح, نَبِيه\nمثال: إنها حاذقة الذكاء.",
 "問": "سُؤَال, سؤال (سُؤَال) / مَسْأَلَة / استفهم\nمثال: أجب على السؤال.",
 "問い": "سُؤَال, سؤال (سُؤَال) / مَسْأَلَة / استفهم\nمثال: أجب على السؤال.",
 "問いかけ": "اِسْتِعْلام (يُقال:اِسْتَعْلِمْ لي خبر فلان وأَعْلِمِنِيه حتى أَعْلَمَهُ، واسْتَعْلَمَنِي الخبَرَ فَأَعْلَمْتُهُ إيّاهُ؛ اِسْتَعْلَمَ يَسْتَعْلِمُ اِسْتِعْلَاماً: فهو مُسْتَعْلِم والمفعول مُسْتَعْلَم)",
 "問いただす": "اِسْتَعْلَمَ, سَأَلَ / حَقَّقَ مَعَ, اِسْتَجْوَبَ (حَقَّقَ (الأمرَ): أثبتَه وصدَّقَه؛ ويقال: حَقَّقَ الظنَّ، وحَقَّقَ القولَ والقضيّةَ؛ حَقَّقَ (الشيءَ والأمرَ): أحكمه؛ ويقال: حَقَّقَ الثوبَ: أحكم نَسْجَه)\nمثال: و أخيرا حقق هدفه.",
 "問い合す": "اِسْتَعْلَمَ, سَأَلَ",
 "問い合せ": "استفسار, تحقيق (تحقيق منهجي في مسألة ذات اهتمام عام) / بحث, تحقيق (بحث عن المعرفة) / استجواب, استفسار (حالة من السؤال أو الاستفسار)\nمثال: تستحق فخارياتهم بحثاً أكثر مما تلقته",
 "問い合せる": "اِسْتَعْلَمَ, سَأَلَ",
 "問い合せ先": "مَرْجِع",
 "問い合わす": "اِسْتَعْلَمَ, سَأَلَ",
 "問い合わせ": "استفسار, تحقيق (تحقيق منهجي في مسألة ذات اهتمام عام) / بحث, تحقيق (بحث عن المعرفة) / استجواب, استفسار (حالة من السؤال أو الاستفسار)\nمثال: تستحق فخارياتهم بحثاً أكثر مما تلقته",
 "問い合わせる": "اِسْتَعْلَمَ, سَأَلَ",
 "問い合わせ先": "مَرْجِع",
 "問い合わせ言語": "لُغَةَ الاِسْتِعْلَام (هِيَ مجموعة من الأصوات التي يصدرها الإنسان على شكل كلمات منظمة بقواعد، ليتواصل به الناس وينقلون به الافكار والمعاني، اللسان؛ يقصد بها أحيانا اللهجة)\nمثال: الأمازيغية لغة.",
 "問い掛け": "اِسْتِعْلام (يُقال:اِسْتَعْلِمْ لي خبر فلان وأَعْلِمِنِيه حتى أَعْلَمَهُ، واسْتَعْلَمَنِي الخبَرَ فَأَعْلَمْتُهُ إيّاهُ؛ اِسْتَعْلَمَ يَسْتَعْلِمُ اِسْتِعْلَاماً: فهو مُسْتَعْلِم والمفعول مُسْتَعْلَم)",
 "問い質す": "اِسْتَعْلَمَ, سَأَلَ / حَقَّقَ مَعَ, اِسْتَجْوَبَ (حَقَّقَ (الأمرَ): أثبتَه وصدَّقَه؛ ويقال: حَقَّقَ الظنَّ، وحَقَّقَ القولَ والقضيّةَ؛ حَقَّقَ (الشيءَ والأمرَ): أحكمه؛ ويقال: حَقَّقَ الثوبَ: أحكم نَسْجَه)\nمثال: و أخيرا حقق هدفه.",
 "問い返す": "عَدَّاد",
 "問う": "سَأَلَ, سأل (اِسْتَعْلَمَ، اسْتَخْبَرَ؛ طَلَبَ، اِلْتَمَسَ)\nمثال: سأل توم عن هذا. / لَاحَقَ / اِتَّبَعَ (تَكَلَّفَ وبذل الجُهْد في أن يَتْبَع)\nمثال: اتبع قلبك فحسب. / شَكَّ ((شَكَّ) الشيءُ يَشُكُّ شَكًّا: لَصِقَ بعضُه ببعضَ واتَّصَلَ؛ (شَكَّ) القرابةُ: اتَّصَلَتْ) / شَكّ, شُبْهَة ((شَكَّ) الشيءُ يَشُكُّ شَكًّا: لَصِقَ بعضُه ببعضَ واتَّصَلَ؛ (شَكَّ) القرابةُ: اتَّصَلَتْ) / شُبْهَة\nمثال: إنها بلا شك محقة.",
 "問わず": "بِغَضِّ ٱلنَّظَر عَن, دُونَ الاِهْتِمَام بِـ (البُغْض ضدّ الحبّ ، بغَض جَدُّك:كتعس جدّك،ونعِمَ الله بك عيناً وبغَض بعدوّك عيناً؛ بغَضَ فلانٌ الشّيءَ أو الشّخصَ:كَرِهَه ومَقَتَه وأعرض عنه)\nمثال: سأذهب بغض النظر عن مجيئه.",
