 "利酒": "تَذَوُّق النَّبِيذ (تجمع للناس لتذوق ومقارنة أنواع مختلفة من النبيذ)",
 "利金": "فَائِدَة",
 "利鞘": "هَامِش إِجْمَالِيّ, هَامِش الرِّبْح (نسبة إجمالي الأرباح مقسومة على صافي المبيعات)",
 "刪修": "تَنْقِيح",
 "到る": "بَلَغَ / جَاءَ (أَتَى؛ حَدَثَ) / أَتَى (جَاءَ؛ فَعَلَ الأمرَ) / جا / جه\nمثال: تقريبا الكل جاء",
 "到底": "رُبَّمَا, لَعَلَّ (عن طريق الصدفة (أو الاحتمال)) / بِأَيّ حَال, بِإِمْكَان (إلى درجة يمكن تحقيقها أو بوسائل ممكنة)\nمثال: ربما ستتصل غداً",
 "到来": "وُصُول, وِفَادَة",
 "到来物": "حَالِيّ, حَاضِر / مَوْجُود, حَاضِر (الذي له وجود) / الزَّمَان, الْحَال / قَدَّمَ, طَرَحَ (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى الرُّسْغَ؛ أنّ لهم سابقةً وفضلاً له عند فلان قَدَمٌ : معروف)\nمثال: أنا موجود لوحدي",
 "到着": "وُصُول, وِفَادَة",
 "到着予定時刻": "إِتَا",
 "到着時刻": "وقت الوصول (الوقت المقرر لوصول وسيلة نقل عامة إلى وجهة معينة)",
 "到着時間": "وقت الوصول (الوقت المقرر لوصول وسيلة نقل عامة إلى وجهة معينة)",
 "到着駅": "وِجْهَة, وُجْهَة",
 "到達": "بلوغ, تحقيق الهدف (إنجاز هدف أو غاية) / مد, وصول (فعل المد الجسدي أو الدفع للخارج)",
 "刳り": "أَجْوَف",
 "刳り形": "سبك, صب (فعل إنشاء شيء ما عن طريق صبه في قالب) / تشكيل, نمذجة (نحت أولي من الشمع أو الطين يمكن نسخ العمل النهائي منه) / قولبة, نحت طيني (نحت يتم إنتاجه بالقولبة) / إفريز, قولبة (سطح زخرفي غائر أو بارز على الحافة)",
 "刳り抜く": "أَجْوَف",
 "刳り舟": "بيروج, زورق محفور (كانو مصنوع عن طريق حفر وتشكيل جذع شجرة كبير)",
 "刳り船": "بيروج, زورق محفور (كانو مصنوع عن طريق حفر وتشكيل جذع شجرة كبير)",
 "刳り貫く": "أَجْوَف",
 "刳る": "تجويف, نقر (فعل النقر أو التجويف بأداة) / إزميل مقعر, مِنْقَار (أداة ذات حد بشفرة تشبه الميزاب لقطع القنوات أو الأخاديد) / انبعاج, حز (أثر غائر في سطح (كما ينتج عن ضربة)) / تَجَوَّفَ / مِغْرَفَة / رَعَشَة / يرتعش / يهز",
 "刳形": "سبك, صب (فعل إنشاء شيء ما عن طريق صبه في قالب) / تشكيل, نمذجة (نحت أولي من الشمع أو الطين يمكن نسخ العمل النهائي منه) / قولبة, نحت طيني (نحت يتم إنتاجه بالقولبة) / إفريز, قولبة (سطح زخرفي غائر أو بارز على الحافة)",
 "刳抜く": "أَجْوَف",
 "刳舟": "بيروج, زورق محفور (كانو مصنوع عن طريق حفر وتشكيل جذع شجرة كبير)",
 "刳船": "بيروج, زورق محفور (كانو مصنوع عن طريق حفر وتشكيل جذع شجرة كبير)",
 "刳貫く": "أَجْوَف",
 "制": "نِظَام (مَنْهَج، طَرِيقَة؛ تَرْتِيب واتِّسَاق) / جِهَاز\nمثال: ليس بنظام كامل.",
 "制がん": "مضاد للأورام, مضاد للسرطان (يستخدم في علاج السرطان)\nمثال: دواء مضاد للسرطان",
 "制す": "سَيْطَرَ / تَحَكُّم, مُرَاقَبَة (\"تَحَكَّمَ فِي أُمُورِهِ الشَّخْصِيَّةِ\" : ضَبَطَهَا وَأَحْكَمَهَا؛ \"يَتَحَكَّمُ فِي أُمُورِ غَيْرِهِ\" : يَتَصَرَّفُ فِيهَا كَمَا يَشَاءُ وَيُرِيدُ)\nمثال: من أنت لتحكم علي؟",
 "制する": "لِجَام, صُرْع / سَيْطَرَ / تَحَكُّم, مُرَاقَبَة (\"تَحَكَّمَ فِي أُمُورِهِ الشَّخْصِيَّةِ\" : ضَبَطَهَا وَأَحْكَمَهَا؛ \"يَتَحَكَّمُ فِي أُمُورِ غَيْرِهِ\" : يَتَصَرَّفُ فِيهَا كَمَا يَشَاءُ وَيُرِيدُ)\nمثال: من أنت لتحكم علي؟",
 "制令": "تَنْظِيم",
 "制作": "عَمَل, شُغْل (فِعْل، صُنْع؛ وسيلة للكسب، مِهْنَة، حِرْفَة) / مُصَنَّف, مُؤَلَّف / سَارَ (مَشَى)\nمثال: المهم هو العمل. / إِنْتَاج",
 "制作室": "إِسْتُودِيُو",
 "制作者": "مُنْتِج",
 "制作費": "تكلفة الإنتاج (التكاليف المجمعة للمواد الخام والعمالة المتكبدة في إنتاج البضائع)",
 "制動": "فَرَمَلَة / مِكْبَح / فَرْمَلَ, َكَبَح / جَنَاحِيَّة / دَقَّ (الشيءَ: ضربه وأصدر صوتًا عند الدق؛ البابَ: طرقه)\nمثال: واصل زيري دق الجرس.",
 "制動手": "عامل الفرامل (موظف سكة حديد ذكر مسؤول عن فرامل القطار)",
 "制動機": "فَرَمَلَة / مِكْبَح / فَرْمَلَ, َكَبَح / جَنَاحِيَّة / دَقَّ (الشيءَ: ضربه وأصدر صوتًا عند الدق؛ البابَ: طرقه)\nمثال: واصل زيري دق الجرس.",
 "制動灯": "ضوء التوقف, ضوء الفرامل (ضوء أحمر في الجزء الخلفي من المركبة يشير إلى استخدام الفرامل للإبطاء أو التوقف)",
 "制勝": "اِنْتِصَار, نَصْر",
 "制吐薬": "مضاد للقيء (دواء يمنع أو يخفف الغثيان والقيء)",
 "制圧": "كبت, كبح ((علم النفس) الاستبعاد الواعي للأفكار أو الرغبات غير المقبولة) / إخماد, قمع (منع بالقوة؛ القضاء على الشيء بالسلطة أو القوة) / حظر, منع (فعل حجب أو سحب كتاب أو كتابة من النشر أو التداول) / قمع, كبت (فشل نمو جزء أو عضو ما)\nمثال: قمع الهرطقة",
 "制圧射撃": "نيران إخماد, نيران قمعية (نيران على أو حول نظام أسلحة لتقليل أدائه إلى ما دون المستوى المطلوب لتحقيق أهداف مهمته)",
 "制定": "تجسيد, تقمص (تمثيل دور شخصية على المسرح؛ تمثيل الشخصية بشكل درامي عن طريق الكلام والفعل والإشارة) / إقرار, سن (تمرير قانون من قبل هيئة تشريعية) / تشريع, قانون (وثيقة قانونية تدون نتيجة مداولات لجنة أو جمعية أو هيئة تشريعية)",
 "制定法": "تشريع, قانون تشريعي (قانون تم سنه من قبل هيئة تشريعية)",
 "制度": "نِظَام (مَنْهَج، طَرِيقَة؛ تَرْتِيب واتِّسَاق) / جِهَاز\nمثال: ليس بنظام كامل.",
 "制度化": "ترشيد, منهجة (تنظيم منهجي؛ فعل تنظيم شيء ما وفقاً لنظام أو منطق)",
 "制度的": "نِظَامِيّ",
 "制式": "قَانُون, قَاعِدَة (مقياس كل شيء وطريقه؛ أمر كليّ ينطبق على جميع جزئياته التي تعرف أحكامها منه) / حُكْم, حُكُومَة (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ) / حَكَمَ (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ)\nمثال: ذكرني بالقانون.",
 "制御": "سَيْطَرَ / تَحَكُّم, مُرَاقَبَة (\"تَحَكَّمَ فِي أُمُورِهِ الشَّخْصِيَّةِ\" : ضَبَطَهَا وَأَحْكَمَهَا؛ \"يَتَحَكَّمُ فِي أُمُورِ غَيْرِهِ\" : يَتَصَرَّفُ فِيهَا كَمَا يَشَاءُ وَيُرِيدُ)\nمثال: من أنت لتحكم علي؟",
 "制御システム": "نظام تحكم (نظام للتحكم في تشغيل نظام آخر)",
 "制御不能": "منفلت من عقاله",
 "制御卓": "وَاسَى, عَزَّى",
 "制御器": "تحكم, وحدة تحكم (آلية تتحكم في تشغيل آلة) / محاسب, مراقب مالي (شخص يقوم بمسك وتدقيق الحسابات التجارية) / ضابط, متحكم (شخص يوجه ويضبط)\nمثال: وحدة التحكم في السرعة في مشغل الأسطوانات لم تكن تعمل بشكل صحيح",
 "制御回路": "دائرة تحكم, دائرة تغذية راجعة سلبية (دائرة تغذية راجعة تطرح من المدخلات)",
 "制御室": "غرفة التحكم (غرفة تضم معدات التحكم (كما في استوديو التسجيل))",
 "制御工学": "هَنْدَسَة التَّكَكُّمَ (الحدُّ والقياس؛ في الرياضيات: هي العلم الذي يبحث في الأشكال وعلاقاتها من حيث الخطوط والأبعاد والسطوح وغيرها)\nمثال: هو ضليع في علم الهندسة .",
 "制御文字": "شَخْص (سواد الإنسان حين يرى من بعيد فلا يُعرَف؛ واحد الإنسان بصورة عامة بدون تحديد لسنه وجنسه وقومه وغير ذلك)\nمثال: هذا الشخص فنان.",
 "制御棒": "قضيب تحكُّم (قضيب من الفولاذ أو الألومنيوم يمكن تحريكه لأعلى أو لأسفل للتحكم في معدل التفاعل النووي)",
 "制御権": "سَيْطَرَ / تَحَكُّم, مُرَاقَبَة (\"تَحَكَّمَ فِي أُمُورِهِ الشَّخْصِيَّةِ\" : ضَبَطَهَا وَأَحْكَمَهَا؛ \"يَتَحَكَّمُ فِي أُمُورِ غَيْرِهِ\" : يَتَصَرَّفُ فِيهَا كَمَا يَشَاءُ وَيُرِيدُ)\nمثال: من أنت لتحكم علي؟",
 "制御機": "تحكم, وحدة تحكم (آلية تتحكم في تشغيل آلة) / محاسب, مراقب مالي (شخص يقوم بمسك وتدقيق الحسابات التجارية) / ضابط, متحكم (شخص يوجه ويضبط)\nمثال: وحدة التحكم في السرعة في مشغل الأسطوانات لم تكن تعمل بشكل صحيح",
 "制御機能": "عملية تحكم (عملية تتحكم في تسجيل أو معالجة أو إرسال أو تفسير البيانات)\nمثال: بدأت عملية تحكم بمعالجة البيانات",
 "制御点": "سنتيمتر (وحدة مترية للطول تساوي واحداً من المائة من المتر) / كوريوم (عنصر فلزي مشع ما بعد اليورانيوم؛ ينتج بقصف البلوتونيوم بنوى الهيليوم)",
 "制御盤": "لَوْحَةُ التَّحَكُّم",
 "制御系": "نظام تحكم (نظام للتحكم في تشغيل نظام آخر)",
 "制御装置": "تحكم, وحدة تحكم (آلية تتحكم في تشغيل آلة) / محاسب, مراقب مالي (شخص يقوم بمسك وتدقيق الحسابات التجارية) / ضابط, متحكم (شخص يوجه ويضبط)\nمثال: وحدة التحكم في السرعة في مشغل الأسطوانات لم تكن تعمل بشكل صحيح",
 "制御言語": "لغة الأوامر, لغة الاستعلام (لغة مصدر تتكون من مشغلات إجرائية تستدعي وظائف ليتم تنفيذها)",
 "制御遺伝子": "جين تنظيمي (جين ينتج مادة كابتة تمنع الجين المشغل)",
 "制御部": "تحكم, وحدة تحكم (آلية تتحكم في تشغيل آلة) / محاسب, مراقب مالي (شخص يقوم بمسك وتدقيق الحسابات التجارية) / ضابط, متحكم (شخص يوجه ويضبط)\nمثال: وحدة التحكم في السرعة في مشغل الأسطوانات لم تكن تعمل بشكل صحيح",
 "制御領域": "كالسيوم (عنصر فلزي أبيض يحترق بضوء ساطع؛ خامس أكثر العناصر وفرة في القشرة الأرضية)",
 "制服": "زَيّ, زِي\nمثال: 私たちの学校では制服を着る。 — نحن ترتدي الزي الرسمي في مدرستنا.",
 "制止": "سَيْطَرَ / تَحَكُّم, مُرَاقَبَة (\"تَحَكَّمَ فِي أُمُورِهِ الشَّخْصِيَّةِ\" : ضَبَطَهَا وَأَحْكَمَهَا؛ \"يَتَحَكَّمُ فِي أُمُورِ غَيْرِهِ\" : يَتَصَرَّفُ فِيهَا كَمَا يَشَاءُ وَيُرِيدُ)\nمثال: من أنت لتحكم علي؟",
 "制気口": "ناشر ضوء (جهاز بصري يوزع ضوء المصباح بالتساوي) / ناشر الصوت (حاجز يوزع الموجات الصوتية بالتساوي)",
 "制汗剤": "مضاد للتعرق (مادة قابضة توضع على الجلد لتقليل التعرق)",
 "制汗性": "مضاد للتعرق (مادة قابضة توضع على الجلد لتقليل التعرق)",
 "制球": "سَيْطَرَ / تَحَكُّم, مُرَاقَبَة (\"تَحَكَّمَ فِي أُمُورِهِ الشَّخْصِيَّةِ\" : ضَبَطَهَا وَأَحْكَمَهَا؛ \"يَتَحَكَّمُ فِي أُمُورِ غَيْرِهِ\" : يَتَصَرَّفُ فِيهَا كَمَا يَشَاءُ وَيُرِيدُ)\nمثال: من أنت لتحكم علي؟",
 "制球力": "سَيْطَرَ / تَحَكُّم, مُرَاقَبَة (\"تَحَكَّمَ فِي أُمُورِهِ الشَّخْصِيَّةِ\" : ضَبَطَهَا وَأَحْكَمَهَا؛ \"يَتَحَكَّمُ فِي أُمُورِ غَيْرِهِ\" : يَتَصَرَّفُ فِيهَا كَمَا يَشَاءُ وَيُرِيدُ)\nمثال: من أنت لتحكم علي؟",
 "制癌": "مضاد للأورام, مضاد للسرطان (يستخدم في علاج السرطان)\nمثال: دواء مضاد للسرطان",
 "制空権": "تفوق جوي",
 "制約": "تحديد, تقييد (فعل الحد أو التقييد (كما هو الحال عن طريق التنظيم)) / قصور, محدودية (صفة كون الشيء محدودًا أو مقيدًا) / تحديد, حصر (مبدأ يحد من مدى شيء ما) / حد, قيد (أكبر قدر ممكن أو مسموح به من شيء ما)\nمثال: إنها خطة جيدة لكن لها محدوديات خطيرة",
 "制約条件": "متطلب",
 "制肘": "تقييد, كبح (فعل السيطرة عن طريق تقييد شخص ما أو شيء ما) / رادع, قيد (جهاز يؤخر حركة شيء ما) / بساطة, تقشف فني (الخلو من الزخرفة) / تحفظ, كبح (الانضباط في الأنشطة الشخصية والاجتماعية)\nمثال: التقييد غير القانوني للتجارة",
 "制腐剤": "مُعَقِّمٌ",
 "制裁": "عِقَاب, إِسْتِحْسَان (طَيْر من الجَوَارِح، أكبر التي تصيد منها يكنى بأبي الهَيْثَم ومعروف بحِدَّة البصر؛ حَجَر ناتئ في جَوْف البِئْر يخرق الدَلُو. ونادر)\nمثال: هو من تلقى العقاب الأكبر.",
 "制覇": "فَتْح, اِسْتِيلَاء (ضد أغْلَقَ وسَدَّ؛ تركه بلا شيء يسده؛ الطريق: جعلها سالكة للطارقين)\nمثال: فتح الباب آليا. / انتصار, فوز (النجاح بعد صعوبة كبيرة) / أَخَّاذ, خَلَّاب (بالغ الجاذبيّة؛ يستولي على الاهتمام) / فَائِز, مُنْتَصِر (حقق الفوز أو الانتصار)\nمثال: الفوز ليس كل شيء",
 "制輪子": "حذاء المكبح, قماش الفرامل (قيد يتم توفيره عندما يتم تحريك بطانات الفرامل هيدروليكياً ضد أسطوانة الفرامل لإبطاء دوران العجلة)",
 "制酸薬": "عامل قلوي, مضاد للحموضة (عامل يقاوم أو يعادل الحموضة (خاصة في المعدة))",
 "制限": "تَقْيِيد, اِقْتِصَار / قَيْد",
 "制限なし": "لَا يَنْضَب, لَا يُسْتَنْفَد (لَا يُمْكِنُ اسْتِهْلَاكُهُ أَوِ اسْتِنْفَادُهُ بِالكَامِلِ) / بلا حدود, غير محدود (ليس له حدود في المدى أو النطاق) / صَرِيح, مُطْلَق (بلا تحفّظ أو استثناء)\nمثال: البدء بنظرية الحرية غير المحدودة هو الانتهاء باستبداد غير محدود",
 "制限事項": "تَقْيِيد, اِقْتِصَار / قَيْد",
 "制限付き": "مَحْدُود",
 "制限戦争": "حرب محدودة (حرب هدفها أقل من الهزيمة غير المشروطة للعدو)",
 "制限時間": "حد زمني, مهلة (فترة زمنية يجب خلالها إنجاز شيء ما أو إكماله)",
 "制限用法": "تَقْيِيدِيّ",
 "制限速度": "حَدّ اَلسُّرْعَة اَلْأُقْصَى, حَدّ اَلسُّرْعَة (مُنْتَهى الشيءِ؛ الْفَصْلُ بَيْنَ الشَّيْئَيْنِ لِئَلَّا يَخْتَلِطَ أَحدهما بِالْآخَرِ أَو لِئَلَّا يَتَعَدَّى أَحدهما عَلَى الْآخَرِ)\nمثال: أعرفها إلى حد ما.",
 "制限酵素": "إنزيم الاقتطاع, إنزيم القصر (أي من الإنزيمات التي تقطع الحمض النووي في مواقع اقتطاع محددة وتنتج شظايا اقتطاع؛ يتم الحصول عليها من البكتيريا (حيث تعطل الغزاة الفيروسيين)؛ تُستخدم…)",
 "刷": "طِبَاعَة",
 "刷く": "تلطيخ, رسم رديء (لوحة غير متقنة) / بقعة, تلطخ (عيب ناتج عن الأوساخ) / طيانة, ملاط طيني (مادة تستخدم لطلاء الجدران بالطين)\nمثال: كانت هناك لطخة على خده",
 "刷った": "مَاضٍ, الْمَاضِي ((في النحو) زمن نحوي يدل على حدث قد وقع، أو وُجِد قبل الآن بوقت ما)",
 "刷り": "طِبَاعَة",
 "刷りなおす": "طبعة منفصلة, مُستَلّة (مقال مطبوع بشكل منفصل ظهر أصلاً في منشور أكبر) / إعادة إصدار, طبعة جديدة (منشور (مثل كتاب) يُعاد طبعه دون تغييرات أو تحرير ويُعرض للبيع مرة أخرى)",
 "刷り出す": "طَبَعَ (طَبَعَ الله الخلقَ : أَنشأَهُ؛ طبَعَت الدَّوْلةُ النَّقْد : صاغتْه ونقشته)\nمثال: بالطبع هي مزحة!",
 "刷り損なう": "خطأ مطبعي, هفوة مطبعية (خطأ في المادة المطبوعة ناتج عن أعطال ميكانيكية من نوع ما)",
 "刷り直す": "طبعة منفصلة, مُستَلّة (مقال مطبوع بشكل منفصل ظهر أصلاً في منشور أكبر) / إعادة إصدار, طبعة جديدة (منشور (مثل كتاب) يُعاد طبعه دون تغييرات أو تحرير ويُعرض للبيع مرة أخرى)",
 "刷り込み": "تطبّع, دمغ (عملية تعلم في مرحلة مبكرة من الحياة يتم بموجبها تأسيس أنماط سلوك خاصة بالنوع)",
 "刷り込む": "طَبَعَ (طَبَعَ الله الخلقَ : أَنشأَهُ؛ طبَعَت الدَّوْلةُ النَّقْد : صاغتْه ونقشته)\nمثال: بالطبع هي مزحة! / بصمة, طبعة (أثر أو علامة تنتج عن الضغط على سطح ما) / أثر, بصمة (تأثير مميز) / بصمة, نقش بارز (انطباع ناتج عن الضغط أو الطباعة) / بصمة الناشر, بيان النشر (تعريف للناشر؛ اسم الناشر مع التاريخ والعنوان والطبعة المطبوعة في أسفل صفحة العنوان)\nمثال: لا تزال اللغة الإنجليزية تحمل بصمة الغزو النورماندي",
 "刷り違い": "خطأ مطبعي, هفوة مطبعية (خطأ في المادة المطبوعة ناتج عن أعطال ميكانيكية من نوع ما)",
 "刷る": "طَبَعَ (طَبَعَ الله الخلقَ : أَنشأَهُ؛ طبَعَت الدَّوْلةُ النَّقْد : صاغتْه ونقشته)\nمثال: بالطبع هي مزحة!",
 "刷子": "فُرْشَاة / فَرَشَ / مَشَّطَ (سرح الشعر باستخدام مشط؛ نظف أو مرر شيئًا باستخدام مشط أو أداة مشابهة)\nمثال: مشط شعرك قبل أن تخرج.",
 "刷新": "إِصْلَاح",
 "刷毛": "فُرْشَاة / فَرَشَ / مَشَّطَ (سرح الشعر باستخدام مشط؛ نظف أو مرر شيئًا باستخدام مشط أو أداة مشابهة)\nمثال: مشط شعرك قبل أن تخرج.",
 "刷毛箒": "مِكْنَسَة صغيرة, مِكْنَسَة يدوية (مكنسة صغيرة ذات مقبض قصير تستخدم لتنظيف الملابس)",
 "刷込む": "طَبَعَ (طَبَعَ الله الخلقَ : أَنشأَهُ؛ طبَعَت الدَّوْلةُ النَّقْد : صاغتْه ونقشته)\nمثال: بالطبع هي مزحة! / بصمة, طبعة (أثر أو علامة تنتج عن الضغط على سطح ما) / أثر, بصمة (تأثير مميز) / بصمة, نقش بارز (انطباع ناتج عن الضغط أو الطباعة) / بصمة الناشر, بيان النشر (تعريف للناشر؛ اسم الناشر مع التاريخ والعنوان والطبعة المطبوعة في أسفل صفحة العنوان)\nمثال: لا تزال اللغة الإنجليزية تحمل بصمة الغزو النورماندي",
 "券": "تَذْكِرَة / تذكرة",
 "券売所": "شباك التذاكر (المكتب الذي تباع فيه تذاكر الدخول)",
 "券文": "رباط, وصلة تثبيت (وصلة تثبت الأشياء ببعضها البعض) / صفد, قيد (قيد يحد أو يقيد الحرية (خاصة شيء يستخدم لربط أو تقييد سجين)) / التصاق, تلاصق (خاصية الالتصاق معاً (كالغراء والخشب) أو انضمام أسطح مختلفة التكوين) / رابطة, رابطة كيميائية (قوة كهربائية تربط الذرات)\nمثال: الالتصاق المتبادل للخلايا",
 "券面": "وَجْه, مُحَيًّا (الإِنْسَان: هو مقدم رأسه الذي يُوَجِهَهُ إلى الناس؛ ضد الظَهْر، ما يقع في المقدمة أو ما يوَجَه إلى الناس) / مَظْهَر (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / وَاجَهَ (تَقَابَلَ معه وَجها لوجه؛ الجندي العدو: استقبله مواجهة ليقاتله أو يناضل ضده)\nمثال: تبدو شاحب الوجه.",
 "券面額": "قيمة ظاهرية (القيمة الظاهرة مقابل القيمة الحقيقية) / قيمة اسمية (قيمة الورقة المالية التي تحددها الشركة المصدرة لها؛ ولا علاقة لها بالقيمة السوقية)",
 "刹": "مَعْبَد / هَيْكَل / صَدْغ / ذِرَاع",
 "刹帝利": "كشاتريا (عضو في الطبقة الهندوسية الملكية أو المحاربة)",
 "刹那": "عَزْم / لَحْظَة, دَقِيقَة",
 "刹那的": "سَرِيع الزَّوَال, عَابِر (لا يدوم إلّا وقتًا قصيرًا جدًّا) / كائن سريع الزوال (أي شيء قصير العمر، مثل حشرة تعيش ليوم واحد فقط في شكلها المجنح)",
 "刹鬼": "شَيْطَان, شيطان ((في الأديان الإبراهيمية) الرُّوح الشِّرِّير الَّذِي يَرْمِي بِكَ لِلتَّهْلُكَةِ لِبُعْدِهِ عَنِ الْخَيْرِ وَطَرِيقِ الْحَقِّ؛ (استعمال مجازي) كُلّ وَلَدٍ مُشَاكِسٍ أَوْ مُتَمَرِّدٍ)\nمثال: العجلة من الشيطان. / زوال, عدم الدوام (خاصية عدم الوجود لمدد طويلة غير محددة)",
 "刺": "بصمة, علامة مميزة (خاصية أو سلوك مميز) / بِطَاقَة زِيَارَة (تحية مطبوعة أو مكتوبة تترك للإشارة إلى أنك قمت بزيارة) / بطاقة هاتف (بطاقة تستخدم بدلاً من النقد لإجراء مكالمات هاتفية)\nمثال: القنابل هي بصمات الإرهابيين / أَسَلَة / شَوْكَة (أداة لتناول الطعام تتكون عادةً من مقبض وعدة أسنان حادة، وتُستعمل لغرز الطعام وحمله إلى الفم)\nمثال: هناك شوكة ناقصة. / شَظِيَّة",
 "刺々": "دستان, عتبة (قضيب صغير من المعدن عبر لوحة أصابع الآلة الموسيقية؛ لإنتاج نغمة ذات حدة مطلوبة عند الضغط على الوتر) / تعشيق هندسي, مفتاح إغريقي (نمط زخرفي يتكون من خطوط عمودية وأفقية متكررة (غالباً بشكل بارز)) / موضع تآكل (بقعة تآكلت بفعل الاحتكاك أو التعرية) / غمة, قلق (هياج ناتج عن قلق نشط)\nمثال: كان هناك تعشيق هندسي بسيط في أعلى الجدران / بحدة, بعدوانية (بطريقة عدوانية) / بشكل حاد, بوضوح (بطريقة محددة بوضوح) / بشكل حاد, بشكل مفاجئ (بشكل مفاجئ جداً وبدرجة كبيرة) / بحدة, بزاوية حادة (تغير مفاجئ في الاتجاه والدرجة)\nمثال: كانت تُستجوب بحدة",
 "刺々しい": "حَادّ (مَالَ وَانْحَرَفَ عَنِ الطَّرِيقِ؛ تَجَنَّبَ شَيْئًا أَوِ الْاِلْتِزَامَ بِمَسَارٍ مَعَيَّنٍ)\nمثال: عندك ذاكرة حادة. / حَادّ الذُّرْوَة, مُدَبَّب النَّبْرَة (ذو نقاط عالية النبرة بشكل خاصّ أو كأنَّه كذلك)",
 "刺さる": "زُبّ, زُبْر (في : اللحية أو مقدمها؛ في : الأنف) / حَرُكَ, تَحَرَّكَ (غَيَّرَ مَوْضِعَهُ أو مَكَانَهُ أو حَالَه؛ حَرُكَ الوَلَدُ : تَحَرَّكَ، أَوْ خَرَجَ عَنْ سُكُونِهِ) / اِنْتَقَلَ, تَحَلْحَلَ\nمثال: لقد أوقفنا حركة المرور.",
 "刺し": "سَاشِيمِي / طَاعِن, لَاذِع (مؤلم كما لو كان ناتجاً عن أداة حادّة) / جارِح, طاعِن (يُسَبِّب جِراحًا أو ألَمًا حادًّا)",
 "刺しゅう": "تَطْرِيز",
 "刺し傷": "عَضَّ, قَضَمَ / عَضَّ / قَرْصة / لُقْمة",
 "刺し子": "تضريب, قماش مبطن (مادة تستخدم لصنع لحاف، أو قماش مبطن) / تنجيد, خياطة اللحف (خياطة عبر طبقات من القماش والحشو لإنشاء تصميم)",
 "刺し網": "شبكة خيشومية (شبكة صيد مسطحة معلقة عمودياً في الماء لتشابك الأسماك من خياشيمها)",
 "刺し縫い": "تضريب, قماش مبطن (مادة تستخدم لصنع لحاف، أو قماش مبطن) / تنجيد, خياطة اللحف (خياطة عبر طبقات من القماش والحشو لإنشاء تصميم)",
 "刺し貫く": "ثَقَبَ (فَجَّرَ أو خَرَقَ شيئًا بفتح فيه؛ نَفَذَ أو مرَّ عبر شيء)\nمثال: انه ثقب الاسود.",
 "刺し身": "سَاشِيمِي",
 "刺し通す": "طَعْن / طَعْنَة / طَعَنَ",
 "刺す": "ثَقَبَ (فَجَّرَ أو خَرَقَ شيئًا بفتح فيه؛ نَفَذَ أو مرَّ عبر شيء)\nمثال: انه ثقب الاسود. / لَسَعَ / خَاطَ (خَطَّ، خَيطَ في إبرة أو آلة؛ وَصَلَ أو أَصَّلَ أجزاء معًا باستخدام الخيط) / خَيَّطَ ((خَيَّطَ) الشَّيْبُ في رأسِهِ تَخْييطًا: بَدَا، أو صارَ كالخُيُوطِ فَتَخَيَّطَ رأسُهُ بالشَّيْبِ؛ (خَيَّطَ) الثَّوْب: خاطه)\nمثال: خاط سامي جيبه المثقوب. / عَمُود, قُطْب / زَانَة",
 "刺亀虫": "بق قاتل (بق حقيقي: بق مفترس طويل الأرجل يعيش غالباً على الحشرات الأخرى؛ وعدد قليل منها يمتص دماء الثدييات)",
 "刺傷": "عَضَّ, قَضَمَ / عَضَّ / قَرْصة / لُقْمة / طَعْن / طَعْنَة / طَعَنَ",
 "刺刀": "خَنْجَر (السِكِّين الكبيرة لا تستخدم للطعام بل للحَرْب، وقيل هي السكين ذات الحدين)",
 "刺刺": "دستان, عتبة (قضيب صغير من المعدن عبر لوحة أصابع الآلة الموسيقية؛ لإنتاج نغمة ذات حدة مطلوبة عند الضغط على الوتر) / تعشيق هندسي, مفتاح إغريقي (نمط زخرفي يتكون من خطوط عمودية وأفقية متكررة (غالباً بشكل بارز)) / موضع تآكل (بقعة تآكلت بفعل الاحتكاك أو التعرية) / غمة, قلق (هياج ناتج عن قلق نشط)\nمثال: كان هناك تعشيق هندسي بسيط في أعلى الجدران / بحدة, بعدوانية (بطريقة عدوانية) / بشكل حاد, بوضوح (بطريقة محددة بوضوح) / بشكل حاد, بشكل مفاجئ (بشكل مفاجئ جداً وبدرجة كبيرة) / بحدة, بزاوية حادة (تغير مفاجئ في الاتجاه والدرجة)\nمثال: كانت تُستجوب بحدة",
 "刺史": "مُحَافِظ, حَاكِم",
 "刺子": "تضريب, قماش مبطن (مادة تستخدم لصنع لحاف، أو قماش مبطن) / تنجيد, خياطة اللحف (خياطة عبر طبقات من القماش والحشو لإنشاء تصميم)",
 "刺客": "قَاتِل, سَفَّاح (اسم فاعل من الفعل قَتَلَ، الذي قَامَ بالقَتْل. الجمع قَاتِلُون؛ المُجْرِم الذي يقتل بلا حَقّ. الجمع قتلة) / حَشَّاش\nمثال: بيتي قاتلة أمك.",
 "刺戟物": "مُنَشِّط, مُنَبِّه",
 "刺抜き": "مِلْقَط صَغِير, مِلْقَط",
 "刺椿象": "بق قاتل (بق حقيقي: بق مفترس طويل الأرجل يعيش غالباً على الحشرات الأخرى؛ وعدد قليل منها يمتص دماء الثدييات)",
 "刺殺": "أَنْتَجَ (أَنْشَأَ شَيْئَا من شَيْءٍ، وَلَّدَه؛ الفرس أو الناقة: وَلَدَت)",
 "刺毛": "شعيرة لاسعة (شعرة متعددة الخلايا في نباتات مثل القراص اللاسع تطرد سائلاً مهيجاً)",
 "刺激": "مثير, محفز (أي معلومة أو حدث محفز؛ يعمل على إثارة العمل) / دفعة, قوة دافعة مفاجئة (فعل تطبيق قوة فجأة) / اندفاع, حافز (قوة تحرك شيئاً ما للأمام)\nمثال: الدفعة المفاجئة أسقطته أرضاً / اضطراب, هياج (اضطراب عادة ما يكون احتجاجاً) / إثارة, تهيج (شيء يسبب الاضطراب والإثارة) / إثارة, انتعاش (الشعور بفرح حيوي ومبهج) / إثارة, انفعال (حالة الاستثارة العاطفية والانفعال)\nمثال: تطلع إلى إثارة اليوم",
 "刺激剤": "مُنَشِّط, مُنَبِّه / تشجيع, حافز (تأثير تحفيزي إيجابي)",
 "刺激性": "إزعاج, غيظ (فعل إقلاق أو إزعاج شخص ما) / إغاظة, استفزاز (سلوك غير ودي يسبب الغضب أو الاستياء) / انزعاج, ضيق (شعور غير مريح بالألم العقلي أو الضيق) / فورة غضب, هيجان (نوبة مفاجئة من الغضب)\nمثال: اشتعل غضبه كالحطب الجاف",
 "刺激物": "مُنَشِّط, مُنَبِّه",
 "刺激的": "مُبْهِج, مُحَفِّز (يجعل النفس حيّة ومبتهجة) / مثير, محفز (يثير أو ينشط النشاط أو الحواس) / مُحَفِّز, مُنَبِّه (ذو تأثير تنبيهي وتحفيزي)\nمثال: مناقشة محفزة",
 "刺激薬": "مُنَشِّط, مُنَبِّه",
 "刺状突起": "حسكة, شوكة (طرف صغير مدبب حاد يشبه السنبلة على ساق أو ورقة)",
 "刺突": "طَاعِن, لَاذِع (مؤلم كما لو كان ناتجاً عن أداة حادّة) / جارِح, طاعِن (يُسَبِّب جِراحًا أو ألَمًا حادًّا)",
 "刺絡": "فَصْد",
 "刺網": "شبكة خيشومية (شبكة صيد مسطحة معلقة عمودياً في الماء لتشابك الأسماك من خياشيمها)",
 "刺繍": "تَطْرِيز",
 "刺繍枠": "طارة تطريز (إطار مصنوع من طارتين؛ يستخدم للتطريز)",
 "刺股": "ثُنَائِيُّ الشُّعَب (ذُو شُعْبَتَيْن)",
 "刺胞動物": "جوفمعوي, لاسع (حيوانات متناظرة شعاعياً لها أجسام تشبه الكيس بفتحة واحدة فقط ومجسات ذات هياكل لاسعة)",
 "刺蕃茘枝": "غرافيولا, قشطة شائكة (فاكهة استوائية شائكة كبيرة ذات لب لاذع) / غرافيولا, قشطة شائكة (شجرة استوائية أمريكية صغيرة تحمل فاكهة كبيرة عصيرية حامضة قليلاً)",
 "刺衝": "طَاعِن, لَاذِع (مؤلم كما لو كان ناتجاً عن أداة حادّة) / جارِح, طاعِن (يُسَبِّب جِراحًا أو ألَمًا حادًّا)",
 "刺身": "سَاشِيمِي",
 "刺通す": "طَعْن / طَعْنَة / طَعَنَ",
 "刺青": "وَشْم / وَشَمَ, وَشَّمَ",
 "刺魚": "سمك شائك الظهر (أسماك صغيرة (2-4 بوصات) عدوانية غالباً عديمة الحراشف وشائكة الظهر تعيش في المياه العذبة والساحلية الشمالية ولها طقوس تزاوج معقدة؛ موضوع لكثير من…)",
 "刻": "خَرْبَشَ / فترة, فترة زمنية (مقدار من الزمن)\nمثال: فترة زمنية تمتد لثلاثين عاماً / نَحْت (وهو القَطْع والبَري والنشر والقشر وتشكيل الخشب أو الحجر أو غيره؛ الشيء الذي نُحِتَ، النقش أو التمثال أو غيره مما كان ناتج النحت)\nمثال: من علمك نحت الخشب. / حزم, صرامة (عزم لا هوادة فيه) / حزم, صرامة (انتباه حي الضمير للقواعد والتفاصيل) / وَقْت (\"بَقِيَ وَقْتاً عِنْدَهُ \" : أَيْ مِقْدَاراً مِنَ الزَّمَنِ؛ \"جَاءَ فِي الوَقْتِ الْمُنَاسِبِ \" : فِي اللَّحْظَةِ الْمُنَاسِبَةِ) / مَرَّة, مرة (مؤنث مُرّ، صفة ما كان بها مرارة) / حِين, وَقْت ((حَيَّنَه): جعل لَهُ حينا؛ (حَيَّنَ) الله فلَانا: لم يوفقه للرشاد)\nمثال: حان وقت الذهاب.",
 "刻する": "نَحَتَ (وهو القَطْع والبَري والنشر والقشر وتشكيل الخشب أو الحجر أو غيره؛ الشيء الذي نُحِتَ، النقش أو التمثال أو غيره مما كان ناتج النحت)\nمثال: من علمك نحت الخشب. / نَشَرَ, أَصْدَرَ (بَسَطَ، فَرَّقَ، نَشَرَ الشيءَ: جعله منتشراً، مثل نشر الأخبار أو نشر كتاب؛ نَشَرَ: وزع أو عمم شيئًا بين الناس، مثل نشر المقالات)\nمثال: نشر توم الغسيل.",
 "刻み": "مُتَصَنِّعٌ, مُتَكَلِّفٌ (مُتَصَنِّع في الرقة والتهذيب) / ضَرْب (معروف، وهو اللطم أو الدق أو الصكّ و ما أشبه؛ النَوْع أو الصنف أو المثال)\nمثال: ضرب سامي زوجته. / فَاصِل / مُدَّة, فَتْرَة / مَسَافَة",
 "刻み値": "زيادة, علاوة (المقدار الذي يزداد به الشيء) / تصاعد, زيادة (عملية التحول إلى أكبر أو أطول أو أكثر عدداً أو أهمية)\nمثال: اقترحوا زيادة بنسبة 15 في المائة في الأجرة",
 "刻み幅": "خطوة واسعة, قفزة (تقدم كبير (خاصة في عبارة 'قطع أشواطاً')) / خطوة, خطوة واسعة (خطوة في المشي أو الجري) / خطوة (المسافة التي تغطيها خطوة)\nمثال: قطعوا أشواطاً كبيرة في الإنتاجية",
 "刻み目": "ثلم, حز (قطع صغير) / ثلم, حز (ثلَم الإناءَ: كسر حرفَه؛ ثلَم الحائطَ: أحدث خلل أو شقّ في الحائط) / ممر, ممر جبلي (موقع في سلسلة جبال لتكوين جيولوجي يكون أقل ارتفاعاً من القمم المحيطة) / ثلمة, حز\nمثال: كان هناك أربعة حزوز في مقبض مسدسه",
 "刻み込む": "نَحَتَ (وهو القَطْع والبَري والنشر والقشر وتشكيل الخشب أو الحجر أو غيره؛ الشيء الذي نُحِتَ، النقش أو التمثال أو غيره مما كان ناتج النحت)\nمثال: من علمك نحت الخشب.",
 "刻む": "لَحْم مَفْرُوم (ما يبقى من جسم الحيوان أو الإنسان بعد إزالة الجلد الأحشاء والعظم والشحم والدم والأعصاب. يتكون أساسا من العَضَلَات؛ ما يؤكل من لحم من الحيوان والطير والسمك عامة)\nمثال: أفضل لحم البقر. / نَحَتَ (وهو القَطْع والبَري والنشر والقشر وتشكيل الخشب أو الحجر أو غيره؛ الشيء الذي نُحِتَ، النقش أو التمثال أو غيره مما كان ناتج النحت)\nمثال: من علمك نحت الخشب. / عَذَاب / عَذَّبَ",
 "刻下": "حَالِيّ, حَاضِر / مَوْجُود, حَاضِر (الذي له وجود) / الزَّمَان, الْحَال / قَدَّمَ, طَرَحَ (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى الرُّسْغَ؛ أنّ لهم سابقةً وفضلاً له عند فلان قَدَمٌ : معروف)\nمثال: أنا موجود لوحدي",
 "刻印": "نَقْشْ (لوّن بلونين أو أكثر؛ زيَّن بأشكال أو ألوان) / عَلَامَة, شِعَار (سِمَةٌ أو أمارة أو شِعَار تُعرف به الأشياء؛ رَمْز) / مَارْكَة\nمثال: تحصلت على علامة أ.",
 "刻器": "منقاش, مِزمَل (إزميل من الفولاذ المقسى ذو طرف حاد؛ يستخدم للنقش)",
 "刻子": "زلاجة صندوقية (زلاجة يجرها حصان واحد تتكون من صندوق على زحافات)",
 "刻時機構": "سَاعَة, ساعة (ثُلْث ثُمْن اليَوْم بمعنى مجموع النَهَار واللَيْل، أي جزء من أربعة وعشرين جزءا من مجموع النهار والليل وتتكون من ستين دَقِيقَة؛ الوَقْت الحاضر، الآن)\nمثال: درست لمدة ساعة.",
 "刻薄": "قَاسٍ, الْقَاسِي (شديد وصلب، غير لين؛ جافٍ أو يابس في الملمس أو التعامل)\nمثال: قاس طول السرير.",
 "刻限": "وَقْت (\"بَقِيَ وَقْتاً عِنْدَهُ \" : أَيْ مِقْدَاراً مِنَ الزَّمَنِ؛ \"جَاءَ فِي الوَقْتِ الْمُنَاسِبِ \" : فِي اللَّحْظَةِ الْمُنَاسِبَةِ) / مَرَّة, مرة (مؤنث مُرّ، صفة ما كان بها مرارة) / حِين, وَقْت ((حَيَّنَه): جعل لَهُ حينا؛ (حَيَّنَ) الله فلَانا: لم يوفقه للرشاد)\nمثال: حان وقت الذهاب.",
 "剃り跡": "شُعَيْرَات اللِّحْيَة / قَشّ",
 "剃る": "حَلَقَ (أصاب حَلْقه أو ضربه في حلقه؛ أزال شعر رأسه أو ذقنه كله بالمُوسَى)\nمثال: حلق زيري لحيته.",
 "剃刀": "شَفْرَة حِلَاقَة / بَالِغ الوُضُوح (مُحَدَّد المَعَالِم بِوُضُوح شَدِيد) / حَادٌّ كَالمُوسَى (حادّ كحدّة شفرة الموسى)",
 "剃刀砥": "مسن دقيق (حجر شحذ مصنوع من الحجر الرملي الدقيق؛ يستخدم لشحذ شفرات الحلاقة) / أداة شحذ دقيق, مِصْقَلَة (أداة تتكون من عدد من الشرائح الكاشطة الدقيقة المثبتة في رأس آلة، تدور وتتردد لإعطاء لمسة ناعمة لثقوب الأسطوانات، إلخ)",
 "剃度": "حلاقة الترهب, طونسورة (حلاقة قمة الرأس من قبل الكهنة أو أعضاء الرهبنة) / قرعة (تاج الرأس المحلوق للراهب أو الكاهن)",
 "剃毛": "احتكاك, كشط (فعل الاحتكاك بشيء أثناء المرور) / حلاقة (فعل إزالة الشعر بالموس) / قُشَارة, كُشَاطَة (شظية أو شريحة رفيعة (خاصة من الخشب) تم كشطها أو حلقها من شيء ما)",
 "剃髪": "حلاقة الترهب, طونسورة (حلاقة قمة الرأس من قبل الكهنة أو أعضاء الرهبنة) / قرعة (تاج الرأس المحلوق للراهب أو الكاهن)",
 "剄る": "ضَرَبَ عُنُقَهُ (معروف، وهو اللطم أو الدق أو الصكّ و ما أشبه؛ النَوْع أو الصنف أو المثال)\nمثال: ضرب سامي زوجته. / نَار, نار (نارَتِ النارُ: أضاءَت؛ نَارَ النَّارَ مَنْ بَعِيدٍ : أَبْصَرَهَا، نَظَرَ إِلَيْهَا، تَأَمَّلَهَا) / حَرِيق, حريجة (النَار المشتعلة في شيء كالدَار او الغَابَة) / طَرَدَ\nمثال: سمعن طلقات نار.",
 "則": "قَانُون, قَاعِدَة (مقياس كل شيء وطريقه؛ أمر كليّ ينطبق على جميع جزئياته التي تعرف أحكامها منه) / حُكْم, حُكُومَة (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ) / حَكَمَ (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ)\nمثال: ذكرني بالقانون. / نَمُوذَج / نَمُوذَج مُصَغَّر / قَدْوَة (من يُقتدى به) / مُنْحَدَر / مَيْل",
 "則る": "تَبِعَ, اِتَّبَعَ (تبِع الشيءَ: سار في إثرِه، تلاه؛ تبِعه تبَعًا: مرَّ به فمضى معه) / اِتَّبَعَ (تَكَلَّفَ وبذل الجُهْد في أن يَتْبَع) / تَابَعَ, تَتَبَّعَ / تَابَعَ\nمثال: تبع المشتبه محققان.",
 "削ぎ落とす": "أَجَاص / عَوِينَة / عَوِينَة مُجَفَّفَة / خَوْخ مُجَفَّف / شَذَبَ, قَضَبَ",
 "削ぐ": "تفتيت, شطف (عملية شطف جزء من شيء ما) / شيب, ضربة قصيرة منخفضة ((غولف) ضربة اقتراب منخفضة ومتدحرجة) / رقاقة, رقاقة دقيقة (معدات إلكترونية تتكون من بلورة صغيرة من شبه موصل السيليكون مصنعة لتنفيذ عدد من الوظائف الإلكترونية في دائرة متكاملة) / رقاقة بوكر, فيشة (عداد صغير على شكل قرص يستخدم لتمثيل المال عند المقامرة) / شَحَذَ (سنّ شيئًا ليصبح حادًا أو أكثر قدرة على القطع؛ استثار أو حفّز قوة ذهنية أو عاطفية لتحقيق هدف معين) / قَلَّلَ",
 "削げる": "انفصل / تخفيض, تقليل (عملية إنقاص أو تقليل شيء ما) / انخفاض, تناقص (المقدار الذي ينخفض به شيء ما) / انخفاض, تراجع (تغير نحو الأسفل) / انخفاض, تناقص (عملية التحول إلى أصغر أو أقصر)\nمثال: كان هناك انخفاض في درجة حرارته مع هدوء الحمى",
 "削げ落とす": "أَجَاص / عَوِينَة / عَوِينَة مُجَفَّفَة / خَوْخ مُجَفَّف / شَذَبَ, قَضَبَ",
 "削り": "احتكاك, كشط (فعل الاحتكاك بشيء أثناء المرور) / حلاقة (فعل إزالة الشعر بالموس) / قُشَارة, كُشَاطَة (شظية أو شريحة رفيعة (خاصة من الخشب) تم كشطها أو حلقها من شيء ما)",
 "削りかす": "احتكاك, كشط (فعل الاحتكاك بشيء أثناء المرور) / حلاقة (فعل إزالة الشعر بالموس) / قُشَارة, كُشَاطَة (شظية أو شريحة رفيعة (خاصة من الخشب) تم كشطها أو حلقها من شيء ما)",
 "削りくず": "احتكاك, كشط (فعل الاحتكاك بشيء أثناء المرور) / حلاقة (فعل إزالة الشعر بالموس) / قُشَارة, كُشَاطَة (شظية أو شريحة رفيعة (خاصة من الخشب) تم كشطها أو حلقها من شيء ما)",
 "削りクズ": "احتكاك, كشط (فعل الاحتكاك بشيء أثناء المرور) / حلاقة (فعل إزالة الشعر بالموس) / قُشَارة, كُشَاطَة (شظية أو شريحة رفيعة (خاصة من الخشب) تم كشطها أو حلقها من شيء ما)",
 "削り出す": "آلَة, مَاكِينَة (الفارسية: ماشين؛ الأوردية: مشين)\nمثال: نسى زيري الآلة.",
 "削り屑": "احتكاك, كشط (فعل الاحتكاك بشيء أثناء المرور) / حلاقة (فعل إزالة الشعر بالموس) / قُشَارة, كُشَاطَة (شظية أو شريحة رفيعة (خاصة من الخشب) تم كشطها أو حلقها من شيء ما)",
 "削り滓": "احتكاك, كشط (فعل الاحتكاك بشيء أثناء المرور) / حلاقة (فعل إزالة الشعر بالموس) / قُشَارة, كُشَاطَة (شظية أو شريحة رفيعة (خاصة من الخشب) تم كشطها أو حلقها من شيء ما)",
 "削り粕": "احتكاك, كشط (فعل الاحتكاك بشيء أثناء المرور) / حلاقة (فعل إزالة الشعر بالموس) / قُشَارة, كُشَاطَة (شظية أو شريحة رفيعة (خاصة من الخشب) تم كشطها أو حلقها من شيء ما)",
 "削る": "حَلَقَ (أصاب حَلْقه أو ضربه في حلقه؛ أزال شعر رأسه أو ذقنه كله بالمُوسَى)\nمثال: حلق زيري لحيته. / قَلَّلَ / حَذَفَ (حَذَفَ الشّيء:قطعه وأَسْقَطَه. حَذَفَ الْمُرَاجِعُ عِبَارَةً منَ الْخِطَابِ؛ حَذَفَهُ بِالعَصَا: ضَرَبَهُ ، ورَمَاهُ بِها)\nمثال: حذف ياني حسابه.",
 "削剥作用": "تعرية, كشف (إزالة الغطاء)",
 "削去": "تنحية, عزل (الفصل من منصب رسمي) / إزالة, نزع (عملية الإزالة)\nمثال: أجرى عملية جراحية لإزالة ورم خبيث",
 "削器": "مِكْشَطة (أي من الأدوات اليدوية المختلفة للكشط)",
 "削岩機": "ريشة حفر الصخر, مثقاب الصخور (مثقاب لاختراق الصخور)",
 "削摩": "تعرية, كشف (إزالة الغطاء) / انحناءة مبالغ فيها (انحناء عميق مع سحب القدم للخلف (يدل على التواضع المفرط)) / خدش, كشط (ضجيج خشن ناتج عن الكشط) / كُشَاطَة ((عادةً بالجمع) ما يُكشط عن سطح شيء ما ويُجمع)\nمثال: كل ذلك الانحناء والتذلل لم يثر إعجابه",
 "削減": "جَرَحَ (كَلَمَ، شَقَّ اللَحْم وأسَالَ الدَمّ؛ صَادَ أو اكْتَسَبَ) / قَصَّ\nمثال: ذلك سيهيج الجرح.",
 "削片": "شَظِيَّة",
 "削片板": "فايبر بورد, لوح حبيبي (لوح جداري يتكون من رقائق الخشب أو النشارة المترابطة مع الراتنج والمضغوطة في أوراق صلبة)",
 "削進": "استخراج المعادن, تعدين (فعل استخراج الخامات أو الفحم وما إلى ذلك من الأرض) / تنيقب, حفر (فعل الحفر) / حفر, حفرية (حفرة في الأرض ناتجة عن الحفر) / حفرية, موقع أثري (موقع الاستكشاف الأثري)\nمثال: هناك حفر مثير للاهتمام يجري بالقرب من برينستون",
 "削除": "حذف, شطب (عملية حذف شيء مكتوب أو مطبوع) / استئصال, حذف (الإسقاط الذي يحدث عندما يختصر التغيير التحريري مقطعاً مكتوباً) / حذف ((في علم الوراثة) فقدان أو غياب نيوكليوتيد واحد أو أكثر من الكروموسوم) / حذف (أي عملية يتم فيها ترك أصوات أو كلمات من الكلمات أو العبارات المنطوقة)\nمثال: حذوفات المحرر كثيراً ما تزعج المؤلفين الشباب",
 "剋": "فترة, فترة زمنية (مقدار من الزمن)\nمثال: فترة زمنية تمتد لثلاثين عاماً / اِنْتِصَار, نَصْر / حزم, صرامة (عزم لا هوادة فيه) / حزم, صرامة (انتباه حي الضمير للقواعد والتفاصيل)",
 "前": "نُقْطَة (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه) / مَوْقِع (موضع الوُقُوع؛ الموضع الذي حَدَثَ أو يحدث فيه حادث) / أَشَارَ\nمثال: هذه هي نقطة ضعفه. / رَئِيس, رَئِيسَة / رَئِيس / اِتَّجَهَ / أَوَّل, أُولَى (الذي يكون ترتيبه وَاحِد، الذي كان قبل الآخرين؛ الأوَّل اسم من الأسماء الحسنى) / أَوَّلاً / مثال: لم تكن أول مرة. / أماماً, في المقدمة (في أو في المقدمة) / سلفاً, مسبقاً (قبل الوقت؛ تحسباً) / إلى الأمام, قدماً (في اتجاه أمامي) / في الصدارة, متقدماً (يتقدم أو يسبق في منافسة)\nمثال: أرى أضواء مدينة أمامنا / آخِر (ضد الأوَّل؛ وهو من يكون ترتيبه بعد الجميع؛ الشيء: مؤخرّه، الجزء الآخير منه) / مَاضٍ, الْمَاضِي ((في النحو) زمن نحوي يدل على حدث قد وقع، أو وُجِد قبل الآن بوقت ما) / آخر (ضد الأوَّل؛ وهو من يكون ترتيبه بعد الجميع؛ الشيء: مؤخرّه، الجزء الآخير منه) / اِسْتَمَرَّ, دَامَ\nمثال: أرني مثالا آخر. / قَبْلَ (وضع فمه على الشخص أو الشيء علامة الحب والاحترام. في العاميّة يُقال بَاسَ) / قَبْلَ, أَمَامَ (وضع فمه على الشخص أو الشيء علامة الحب والاحترام. في العاميّة يُقال بَاسَ)\nمثال: كنت هنا من قبل. / أماماً, في المقدمة (في أو في المقدمة)\nمثال: أرى أضواء مدينة أمامنا / قَبْلَ (وضع فمه على الشخص أو الشيء علامة الحب والاحترام. في العاميّة يُقال بَاسَ) / قَبْلَ, أَمَامَ (وضع فمه على الشخص أو الشيء علامة الحب والاحترام. في العاميّة يُقال بَاسَ)\nمثال: كنت هنا من قبل. / جَبْهَة / أَمَامِيّ / صَاعِدًا / مُهَاجِم\nمثال: まっすぐ前を見てください。 — انظر امامك مباشره.",
 "前々": "قَدِيماً",
 "前々から": "دَائِمًا, أَبَدًا",
 "前々日": "أَوَّل أَمْس (الذي يكون ترتيبه وَاحِد، الذي كان قبل الآخرين؛ الأوَّل اسم من الأسماء الحسنى) / قَبْلَ أَمْس, أَمْس الْأَوَّل (وضع فمه على الشخص أو الشيء علامة الحب والاحترام. في العاميّة يُقال بَاسَ)\nمثال: لم تكن أول مرة.",
 "前かがみ": "انحناء, ترهل (انحناء القامة عند الوقوف والمشي) / شخص غير كفء, متكاسل (شخص غير كفء؛ تستخدم عادة في صيغ النفي)\nمثال: إنه ليس متكاسلاً عندما يتعلق الأمر بالبيسبول",
 "前かがみになる": "انحناء, ترهل (انحناء القامة عند الوقوف والمشي) / شخص غير كفء, متكاسل (شخص غير كفء؛ تستخدم عادة في صيغ النفي)\nمثال: إنه ليس متكاسلاً عندما يتعلق الأمر بالبيسبول",
 "前だれ": "مِرْيَلَة, مِئْزَر",
 "前のめり": "وِقَائِيّ, استباق الْأَحْدَاث / مُتَسَرِّع",
 "前ふり": "مُقَدِّمَة",
 "前ぶれ": "بَشِير, مُبَشِّر",
 "前もって": "سلفاً, مسبقاً (قبل الوقت؛ تحسباً)\nمثال: عندما تدفع مقدماً تحصل على خصم",
 "前を失礼します": "عَفْوًا!, مَاذَا قُلْتَ؟",
 "前カレ": "حبيب سابق (رجل لم يعد حبيباً لامرأة ما)",
 "前ジテ": "بَطَل, بَطَلَة / مُتَصَدِّر",
 "前ピン": "بؤرة, تركيز (تركيز الانتباه أو الطاقة على شيء ما) / بؤرة, نقطة التجمع (نقطة التقاء الضوء (أو أي إشعاع آخر) أو النقطة التي ينبعث منها) / بؤرة, بؤرة الإصابة (نقطة مركزية أو موضع العدوى في كائن حي)\nمثال: تحول محور النشاط إلى البيولوجيا الجزيئية",
 "前世": "تَارِيخ قَدِيم (جملة الأَحوال والأحداث التي يمر بها كائن ما، ويَصْدق على الفرد والمجتمع، كما يَصْدق على الظواهر الطبيعية والإنسانية؛ هو تحديد الزمن باليَوْم والشَهْر والسَنَة أو ببعضهما. الأجَل أو الوَقْت)\nمثال: ما تاريخ اليوم؟",
 "前世紀": "أيام الخوالي (أوقات ماضية يتم تذكرها بحنين)",
 "前人": "بشير, سلف (شيء يسبق ويشير إلى اقتراب شيء أو شخص ما) / سَلَف (من يسبقك في الوقت (كما في شغل منصب أو وظيفة))",
 "前人未到": "بِلَا مَسَالِك, وَعْر (يفتقر إلى الممرّات والطرق المعبَّدة)",
 "前人未発": "غَيْر مَسْبُوق (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "前人未踏": "بِلَا مَسَالِك, وَعْر (يفتقر إلى الممرّات والطرق المعبَّدة)",
 "前仕手": "بَطَل, بَطَلَة / مُتَصَدِّر",
 "前付": "المواد التمهيدية, مقدمات الكتاب (مادة مكتوبة تسبق المتن الرئيسي لكتاب)",
 "前付け": "المواد التمهيدية, مقدمات الكتاب (مادة مكتوبة تسبق المتن الرئيسي لكتاب)",
 "前代未聞": "غَيْر مَسْبُوق, لَمْ يُسْمَع بِهِ (لم يكن معروفاً من قبل)",
 "前件": "سَابِق (يسبق في الوقت أو الترتيب) / سَابِق (مرجع الجناس؛ عبارة أو جملة يشار إليها بضمير عائد) / سابقة, مقدمة (حدث أو سبب أو واقعة سابقة) / جد, سلف (شخص تنحدر منه (لكنه عادة أبعد من الجد))",
 "前任": "سَابِق",
 "前任者": "بشير, سلف (شيء يسبق ويشير إلى اقتراب شيء أو شخص ما) / سَلَف (من يسبقك في الوقت (كما في شغل منصب أو وظيفة))",
 "前会計": "دفع مسبق (الدفع مقدماً)",
 "前例": "سَابِقَة (فِي : لَاصِقَة تزاد قبل الكلمة لتحويل مبناها وتغيير معناها. وهي وسيلة اقتصادية لبناء المفردات في اللغة)\nمثال: افتقد لزوجته السابقة.",
 "前倒し": "تَسَارُع (عَجَلَة، تزايُد السرعة بالنسبة إلى الزمن في جسم من الأَجسام المتحرِّكة؛ إِسْرَاعٍ وَتَسَابُقٍ فِي الجَرْيِ)\nمثال: تسارع السائق بسيارته.",
 "前借": "قَرْض, إِعَارَة",
 "前借り": "يقرب",
 "前借金": "قَرْض, إِعَارَة",
 "前側": "أَمَامِيّ",
 "前備え": "طَلِيعَة",
 "前兆": "فَأل, نَذِيْر",
 "前兆現象": "بشير, سلف (شيء يسبق ويشير إلى اقتراب شيء أو شخص ما) / رَائِد, سَابِق (شخص يسبق غيره أو يعلن عن قدوم آخر) / سلائف, مادة أولية (مادة تتكون منها مادة أخرى (خاصة عن طريق تفاعل استقلابي))",
 "前処理": "تَحْضِير, إِعْدَاد",
 "前出": "الْمَذْكُورُ آنِفًا, السًّابِقُ ذِكْرُهُ",
 "前前日": "أَوَّل أَمْس (الذي يكون ترتيبه وَاحِد، الذي كان قبل الآخرين؛ الأوَّل اسم من الأسماء الحسنى) / قَبْلَ أَمْس, أَمْس الْأَوَّل (وضع فمه على الشخص أو الشيء علامة الحب والاحترام. في العاميّة يُقال بَاسَ)\nمثال: لم تكن أول مرة.",
 "前半": "شوط أول (الأول من شوطين للعب)",
 "前半戦": "شوط أول (الأول من شوطين للعب)",
 "前半期": "شوط أول (الأول من شوطين للعب)",
 "前半生": "شوط أول (الأول من شوطين للعب)",
 "前原": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "前古": "أيام الخوالي (أوقات ماضية يتم تذكرها بحنين)",
 "前史": "عَصْر مَا قَبْلَ التَّارِيخ (مصدر للفعل \"عَصَرَ\"؛ أي مدة زمنية، دهر من الوقت)\nمثال: صلى زيري العصر.",
 "前向き": "حَدَاثِيّ, مُبْتَكِر (سابق لعصره ومتطوّر)",
 "前向性健忘": "فقدان الذاكرة التقدمي, نسيان تقدمي (فقدان الذاكرة للأحداث التي تلي الصدمة مباشرة؛ وأحياناً يسري على الأحداث أثناء الصدمة ولفترة طويلة بعدها)",
 "前哨": "مخفر أمامي (موقع عسكري متمركز على مسافة من الجسم الرئيسي للقوات) / مخفر حدودي, مستوطنة حدودية (مستوطنة على حدود الحضارة) / مخفر أمامي, نقطة نائية (محطة في موقع ناء أو قليل السكان)",
 "前哨地": "مخفر أمامي (موقع عسكري متمركز على مسافة من الجسم الرئيسي للقوات) / مخفر حدودي, مستوطنة حدودية (مستوطنة على حدود الحضارة) / مخفر أمامي, نقطة نائية (محطة في موقع ناء أو قليل السكان)",
 "前哨戦": "مُنَاوَشَة / بريلود, مقدمة (موسيقى تسبق الفوغا أو تقدم فصلاً في الأوبرا) / استهلال, تمهيد (شيء يعمل كحدث سابق أو يقدم ما يلي)\nمثال: التدريب مقدمة ضرورية للتوظيف",
 "前園": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "前垂": "مِرْيَلَة, مِئْزَر",
 "前垂れ": "مِرْيَلَة, مِئْزَر",
 "前売": "حَجْز (حجَزهُ: مَنَعَهُ)\nمثال: حجز مناد موعدا.",
 "前売り": "حَجْز (حجَزهُ: مَنَعَهُ)\nمثال: حجز مناد موعدا.",
 "前夜": "اَلْبَارِحَةَ / حَوَّاء / حَوَّاء, أِيف",
 "前夜式": "أَيْقَظَ (نبَّهه، ضد نَوَّمَه؛ الغبارَ: أثاره)\nمثال: أيقظ زيري السائق",
 "前夜祭": "حَوَّاء / حَوَّاء, أِيف",
 "前奏": "بريلود, مقدمة (موسيقى تسبق الفوغا أو تقدم فصلاً في الأوبرا) / استهلال, تمهيد (شيء يعمل كحدث سابق أو يقدم ما يلي)\nمثال: التدريب مقدمة ضرورية للتوظيف",
 "前奏曲": "بريلود, مقدمة (موسيقى تسبق الفوغا أو تقدم فصلاً في الأوبرا) / استهلال, تمهيد (شيء يعمل كحدث سابق أو يقدم ما يلي)\nمثال: التدريب مقدمة ضرورية للتوظيف",
 "前妻": "زوجة سابقة, طليقة (امرأة كانت زوجة لرجل معين سابقاً)\nمثال: كل طليقاته يعشن في تكساس",
 "前室": "صالون, غرفة جلوس (غرفة في منزل خاص أو منشأة حيث يمكن للناس الجلوس والتحدث والاسترخاء)",
 "前小口": "الحافة الأمامية (جزء الكتاب الذي يواجه الداخل عند وضع الكتاب على الرف؛ الجزء المقابل للكعب)",
 "前屈み": "انحناء, ترهل (انحناء القامة عند الوقوف والمشي) / شخص غير كفء, متكاسل (شخص غير كفء؛ تستخدم عادة في صيغ النفي)\nمثال: إنه ليس متكاسلاً عندما يتعلق الأمر بالبيسبول",
 "前屈みになる": "انحناء, ترهل (انحناء القامة عند الوقوف والمشي) / شخص غير كفء, متكاسل (شخص غير كفء؛ تستخدم عادة في صيغ النفي)\nمثال: إنه ليس متكاسلاً عندما يتعلق الأمر بالبيسبول",
 "前山": "سَفْح (لها معانٍ متعددة تتعلق بالانصباب والسكب؛ أراقَ دمًا أو ماءً)\nمثال: كان ذلك الحوض في سفح الجبل.",
 "前岡": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "前島": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "前川": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "前席": "مَقْعَد أَمَامِيّ (كل ما يُقْعَدُ ويُجْلَسُ عليه؛ مَكَان القُعُود)\nمثال: نام ياني على مقعد.",
 "前年": "اَلْعَامَ اَلْمَاضِيَ, اَلسَّنَةَ ٱلْمَاضِيَةَ",
 "前広": "سَابِق",
 "前座": "حدث تمهيدي, مستهل (أي نشاط تمهيدي) / فقرة افتتاحية, مسرحية تمهيدية (مسرحية قصيرة تُقدم قبل المسرحية الرئيسية)",
 "前庭": "حديقة أمامية, فناء أمامي (الفناء الموجود أمام المنزل؛ بين المنزل والشارع) / بهو, ردهة (مدخل كبير أو غرفة استقبال أو منطقة استقبال) / دهليز (أي من التجاويف الجسدية المختلفة المؤدية إلى تجويف آخر (كما في الأذن أو المهبل))",
 "前庭器官": "الجهاز الدهليزي (الأعضاء التي تتوسط حاسة التيه (الأذن الداخلية)؛ المعنية بالتوازن)",
 "前庭窓": "نافذة بيضوية (نافذة تتصل بها قاعدة الركاب)",
 "前庭蝸牛神経": "عصب دهليزي قوقعي, عصب سمعي (عصب حسي مركب يغذي الخلايا الشعرية للعضو الدهليزي والخلايا الشعرية للقوقعة)",
 "前廊": "رِوَاق, رُوَاق (مَمَرّ خارج المَبْنَى وملاصق له يمتد عليه السَقْف ويُصفّ على الجانب الآخر الأعمدة؛ في العصر الحديث يُطلق على الممر عامة)\nمثال: ذهب إلى الرواق.",
 "前彼": "حبيب سابق (رجل لم يعد حبيباً لامرأة ما)",
 "前後": "ذَهَابًا وَإِيَابًا / حَوْلَ (جَعَلَ الشيءَ غير ما كان؛ نقل الشيء من موضع إلى آخر) / بِالْقُرْب, قُرْبَ / مَوْجُود (الذي له وجود)\nمثال: رقصنا حول النار. / تَرْتِيب, نِظَام (تنظيم الأشياء أو الأحداث في تسلسل معين أو وضعها في نظام؛ إعداد أو تجهيز شيء لتحقيق غاية معينة) / أَمْر, حُكْم (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة) / طَلَب (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى)) / جَمَاعَة (العَدَد الكثير من النَاس أو الحَيْوَان أو النَبَات أو غيره. المَجْمُوعَة؛ طَائِفَة من الناس التي يجمعها مكان و بيئة واحدة أو تتشارك اهداف و غايات واحدة) / وِسَام / رُتْبَة (رُتْبَة، بضم الراء؛ رَتْبَة، بفتح الراء) / أَمَرَ (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة) / طَلَبَ, حَجَزَ (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى))\nمثال: أعاد زيري ترتيب المطبخ كلية. / عَاقِبَة / نَتِيجَة",
 "前後の見境もなく": "باستهتار, بتهور (بطريقة متهورة)",
 "前後不覚": "فِقْدَان اَلْوَعْي, إِغْمَاء",
 "前後工程": "جيئة وذهاباً, ذهاباً وإياباً (التحرك من مكان إلى آخر والعودة مرة أخرى)\nمثال: سافر ذهاباً وإياباً بين لوس أنجلوس ونيويورك",
 "前後左右": "إجمالاً, في المجموع (مع تضمين أو عد كل شيء)\nمثال: إجمالاً يكسب ما يقرب من مليون دولار",
 "前後撞着": "تناقض ذاتي (مناقضة النفس)",
 "前後矛盾": "تناقض ذاتي (مناقضة النفس)",
 "前後関係": "سِيَاق, قَرِينَة",
 "前成説": "تكون مسبق, نظرية التكون المسبق (نظرية (كانت شائعة في القرن الثامن عشر وفقدت مصداقيتها الآن) تفيد بأن الفرد يتطور بتضخم بسيط لكائن حي صغير كامل التكوين موجود في الخلية الجرثومية)",
 "前戯": "إثارة, مداعبة (الملاطفة الجنسية المتبادلة قبل الجماع)",
 "前扉": "باب أمامي, مدخل أمامي (باب خارجي (عند المدخل) في واجهة المبنى) / العنوان الموجز (صفحة أولى في بعض الكتب تعرض فقط عنوان الكتاب)",
 "前打音": "نوتة زينة (نوتة تجميلية تُكتب عادة بحجم أصغر)",
 "前払": "دَفْع مُسْبَق (لزّه ونحاه وأبعده؛ صرفه قبل وروده، أي منعه وأبعده قبل مجيئه أو حدوثه، وعكسه أن يرفعه، اي أن يصرفه بعد حدوثه)\nمثال: دفع زيري الثمن.",
 "前払い": "دَفْع مُسْبَق (لزّه ونحاه وأبعده؛ صرفه قبل وروده، أي منعه وأبعده قبل مجيئه أو حدوثه، وعكسه أن يرفعه، اي أن يصرفه بعد حدوثه)\nمثال: دفع زيري الثمن.",
 "前払い金": "دَفْع مُسْبَق (لزّه ونحاه وأبعده؛ صرفه قبل وروده، أي منعه وأبعده قبل مجيئه أو حدوثه، وعكسه أن يرفعه، اي أن يصرفه بعد حدوثه)\nمثال: دفع زيري الثمن.",
 "前払金": "دَفْع مُسْبَق (لزّه ونحاه وأبعده؛ صرفه قبل وروده، أي منعه وأبعده قبل مجيئه أو حدوثه، وعكسه أن يرفعه، اي أن يصرفه بعد حدوثه)\nمثال: دفع زيري الثمن.",
 "前振り": "مُقَدِّمَة",
 "前掛": "مِرْيَلَة, مِئْزَر",
 "前掛け": "مِرْيَلَة, مِئْزَر",
 "前接語": "مُتَّصِل, مُحَاط",
 "前掲": "الْمَذْكُورُ آنِفًا, السًّابِقُ ذِكْرُهُ",
 "前掲書": "إشارة مرجعية, استشهاد (ملاحظة قصيرة تعترف بمصدر المعلومات أو فقرة مقتبسة)\nمثال: فشل مقال الطالب في ذكر عدة استشهادات مهمة",
 "前提": "شَرْط (شَرِطَ فلانٌ يَشْرِطِ شَرْطًا: وقع في أَمر عظيمٍ)\nمثال: صرخ ليون: \"شرطة!\" / قَصْد, إِرَادَة / مُقَدِّمَة",
 "前提条件": "شرط مسبق (شرط يعتبر متطلباً أساسياً) / مُسلّمة, مُعطى (افتراض يؤخذ كأمر مسلم به) / شرط, شرط مسبق (افتراض تعتمد عليه صحة أو تأثير شيء آخر)",
 "前文": "دِيبَاجَة",
 "前方": "أماماً, في المقدمة (في أو في المقدمة) / سلفاً, مسبقاً (قبل الوقت؛ تحسباً) / إلى الأمام, قدماً (في اتجاه أمامي) / في الصدارة, متقدماً (يتقدم أو يسبق في منافسة)\nمثال: أرى أضواء مدينة أمامنا / قَبْلَ (وضع فمه على الشخص أو الشيء علامة الحب والاحترام. في العاميّة يُقال بَاسَ) / قَبْلَ, أَمَامَ (وضع فمه على الشخص أو الشيء علامة الحب والاحترام. في العاميّة يُقال بَاسَ)\nمثال: كنت هنا من قبل. / جَبْهَة / أَمَامِيّ / غير مكسو بالريش, غير ناضج ((عن الطيور) لم تطور ريشاً بعد) / غير ناضج (لم ينضج بعد) / طفولي, غير ناضج (من سمات الافتقار إلى النضج) / غير ناضج, فج (غير مكتمل النمو أو النضج؛ غير يانع)\nمثال: عصفور صغير غير مكسو بالريش على حافة النافذة",
 "前方互換性": "توافقية مستقبلية",
 "前方端": "حافة أمامية (الحافة الأمامية لسطح انسيابي (مثل الجناح))",
 "前日": "حَوَّاء / حَوَّاء, أِيف",
 "前日談": "متعلِّق بالماضي, رَجْعِيّ",
 "前日譚": "متعلِّق بالماضي, رَجْعِيّ",
 "前時代的": "عَفَا عَلَيْه الزَّمَن, قَدِيم الطِّرَاز (خَارِج المُوضَة وَلَمْ يَعُدْ رَائِجًا)",
 "前景": "مقدمة ((في علم الحاسوب) نافذة لتطبيق نشط) / مقدمة (جزء المشهد القريب من المشاهد)",
 "前景化": "معالجة في المقدمة (تنفيذ برنامج يستحوذ على استخدام نظام المعالجة)",
 "前景気": "توقع, احتمال / تَنْقِيْب (نقّب إذا سار في البلاد طلباً للمهرب ، نقّب عن الأخبار وغيرها:بحث عنها،هو البحث عن كلّ شيء والتّفتيش مطلقاً؛ نقّب مبالغة في نَقَب ، نقّب عن الشيء :فحص عنه فحصاً بليغاً)",
 "前書き": "مُقَدِّمَة",
 "前期": "الطور التمهيدي (المرحلة الأولى من الانقسام المتساوي) / طور تمهيدي (المرحلة الأولى من الانقسام المنصف)",
 "前村": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "前板": "لَوْحَةُ التَّعْلِيمَات",
 "前林": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
