 "喘音": "صرير (صوت صفير عند التنفس (يُسمع عادة عند الشهيق)؛ يشير إلى انسداد القصبة الهوائية أو الحنجرة)",
 "喘鳴": "صرير (صوت صفير عند التنفس (يُسمع عادة عند الشهيق)؛ يشير إلى انسداد القصبة الهوائية أو الحنجرة)",
 "喚きたてる": "صَاحَ (صاتَ بأقصى طاقته وأعلى صوته، يستخدم للحيّ ولا يقال صاح للجماد؛ عليه: ناداه)\nمثال: سأساعدك يا صاح.",
 "喚き声": "صَاحَ (صاتَ بأقصى طاقته وأعلى صوته، يستخدم للحيّ ولا يقال صاح للجماد؛ عليه: ناداه)\nمثال: سأساعدك يا صاح.",
 "喚き立てる": "صَاحَ (صاتَ بأقصى طاقته وأعلى صوته، يستخدم للحيّ ولا يقال صاح للجماد؛ عليه: ناداه)\nمثال: سأساعدك يا صاح.",
 "喚く": "صَيح, صِيَاح (مبالغة في الصياح، صاح كثيرا؛ في : صرخ) / صَرَخَ, صَاحَ (صاحَ صياحا شديدًا واستغاث)\nمثال: صرخ طالبا النجدة.",
 "喚問": "اِسْتِدْعَاء (دَعْوَةً؛ طَلَب الْمُثُولِ)\nمثال: أراد توم استدعاء الشرطة، ولكن ماري لم تسمح له.",
 "喚声": "صَيح, صِيَاح (مبالغة في الصياح، صاح كثيرا؛ في : صرخ) / صَرَخَ, صَاحَ (صاحَ صياحا شديدًا واستغاث)\nمثال: صرخ طالبا النجدة.",
 "喚起": "إثارة, إيقاظ (فعل الإثارة أو الاستنهاض) / إثارة, مداعبة (الملاطفة الجنسية المتبادلة قبل الجماع) / استيقاظ, صحوة (الاستيقاظ من النوم) / استثارة, تيقظ (حالة من النشاط الفسيولوجي المتزايد)\nمثال: الهدف من الفن هو إثارة العواطف",
 "喜々": "مَرِح, فَرِح",
 "喜ばしい": "سَعِيد, مُفْرِح",
 "喜ばす": "فُرْجَة",
 "喜び": "سُرُور, فَرَح (شُعُور حَسَن يتبع الرضا، والارتياح)\nمثال: قبل زيري بسرور.",
 "喜びごと": "اِحْتِفَال (إقامة مراسم أو فعاليات تعبيرًا عن مناسبة معينة) / اِحْتِفَال, مِهْرَجَان (إقامة مراسم أو فعاليات تعبيرًا عن مناسبة معينة)\nمثال: لم يحضر الاحتفال.",
 "喜び事": "اِحْتِفَال (إقامة مراسم أو فعاليات تعبيرًا عن مناسبة معينة) / اِحْتِفَال, مِهْرَجَان (إقامة مراسم أو فعاليات تعبيرًا عن مناسبة معينة)\nمثال: لم يحضر الاحتفال.",
 "喜ぶ": "أَفْرَحَ / هَنَّأَ, يُهَنِّئُ / أَهْلًا وَسَهْلًا, مَرْحَبًا (تحية ترحيب بالضيف؛ تحية عند اللقاء أو لبدء المحادثة) / تَرْحِيب / رَحَّبَ, اِسْتَقْبِل (بنو رَحَب: اسم؛ بطن من همذان)\nمثال: أهلا يا أصدقاء.",
 "喜んで": "بِرَغْبَة, بِمَتْعَة",
 "喜劇": "فُكَاهَة, كُومِيدِيَا / كُومِيدِيَا",
 "喜劇役者": "كُومِيدْيَان",
 "喜劇的": "كُومِيدِيّ, مُضْحِك (يُثير الضحك أو يستدعيه)",
 "喜喜": "مَرِح, فَرِح",
 "喜怒哀楽": "مشاعر (الحساسية العاطفية أو الأخلاقية (خاصة فيما يتعلق بالمبادئ الشخصية أو الكرامة))\nمثال: جرحت الملاحظة مشاعره",
 "喜悦": "سُرُور, فَرَح (شُعُور حَسَن يتبع الرضا، والارتياح)\nمثال: قبل زيري بسرور.",
 "喜捨": "إيتاء الصدقة, تصدق (تقديم مساهمات طوعية لمساعدة الفقراء)",
 "喜望峰": "رَأْس اَلرَّجَاء اَلصَّالِح (عُضْو مِنَ ٱلْجَسَدِ يَحْوِي الدِّمَاغ والفَم والأَنْف والعَيْنَيْن والأُذُنَيْن؛ أَعْلَى ٱلشَّيْءِ)\nمثال: قطع سامي رأس كلب.",
 "喜歌劇": "أوبرا كوميك, أوبرا هزلية (أوبرا ذات نهاية سعيدة وفيها بعض النصوص منطوقة) / أوبريت",
 "喜遊曲": "دِيفِرْتِمِنْتُو, دِفِرْتِمِنْتُو",
 "喝上げ": "اِبْتِزَاز (اِسْتِغْلالٌ بِدَنَاءَة؛ ابتزاز المال بالتهديد)",
 "喝破": "تَأْنِيب, تَوْبِيخ (فعل أو تعبير عن النقد واللوم)\nمثال: اضطر لتلقي التوبيخ بابتسامة على وجهه / شرح مستفيض, عرض (تفسير أو شرح منهجي (مكتوب عادة) لموضوع معين)",
 "喝采": "انشراح, بشاشة (صفة كون المرء مبتهجاً وطارداً للكآبة) / هتاف (صرخة أو صيحة استحسان)\nمثال: أضافت الزهور لمسة من البهجة للغرفة الكئيبة",
 "喝采をおくる": "صَفَّقَ",
 "喝采を送る": "صَفَّقَ",
 "喞子": "مِدَكّ",
 "喞筒": "مِضَخَّة / ضَخّ",
 "喟然": "تَنَهَّدَ / تَنَهُّد",
 "喧々": "بِصَخَب, بِضَجِيج (مع الكثير من الضجيج أو الصوت العالي والمزعج)\nمثال: نظف أنفه بصخب",
 "喧々ごうごう": "فوضى, هرج ومرج (حالة من الارتباك والاضطراب الشديد) / صَارِخ, صاخِب",
 "喧々囂々": "فوضى, هرج ومرج (حالة من الارتباك والاضطراب الشديد) / صَارِخ, صاخِب",
 "喧々諤々": "مُضْطَرِب, صَاخِب",
 "喧しい": "صَارِخ, صاخِب / زَعْلَان / صَارِم / خاص (قلَّ أو أصبح أقل؛ خَاصَ العَطَاءَ خَاصَ خَوْصًا: قلَّله)\nمثال: كل الخضار الخاص بك.",
 "喧し屋": "عياب, متشائم (شخص دائم الانتقاد لنوايا الآخرين)",
 "喧喧": "بِصَخَب, بِضَجِيج (مع الكثير من الضجيج أو الصوت العالي والمزعج)\nمثال: نظف أنفه بصخب",
 "喧喧囂囂": "فوضى, هرج ومرج (حالة من الارتباك والاضطراب الشديد) / صَارِخ, صاخِب",
 "喧喧諤諤": "مُضْطَرِب, صَاخِب",
 "喧嘩": "نِزَاع, شِجَار (حالة المريض المشرف على الموت؛ خُصُومَة بين أفراد أو جماعات قد تقتصر على تبادل الشتائم وقد تمتدّ إلى التماسك بالأيدي أو استخدام أداة ما في المشاجرة أو تُفضي إلى الحرب بين الدول) / تَشَاجَرَ\nمثال: شمال مالي منطقة نزاع.",
 "喧嘩っ早い": "كَثِيرُ الخِصَام, مُشَاكِس (مَيَّالٌ إِلَى المُشَاجَرَةِ وَالخِصَام)",
 "喧嘩ぱやい": "كَثِيرُ الخِصَام, مُشَاكِس (مَيَّالٌ إِلَى المُشَاجَرَةِ وَالخِصَام)",
 "喧嘩師": "مُشَاكِس",
 "喧嘩早い": "كَثِيرُ الخِصَام, مُشَاكِس (مَيَّالٌ إِلَى المُشَاجَرَةِ وَالخِصَام)",
 "喧嘩腰": "عدوانية, ولع بالقتال (ميل طبيعي للعداء) / عدائية, ولع بالقتال (موقف أو طبيعة معادية أو حربية)",
 "喧噪": "جلبة, صخب (فعل إحداث اضطراب صاخب) / اضطراب, فوضى (هياج عنيف) / جلبة, صخب (حالة من الهيجان والضوضاء والارتباك)",
 "喧囂": "جلبة, صخب (صيحات عالية ومستمرة من العديد من الناس) / جلبة, صخب (ضجيج عالٍ خشن أو حاد)\nمثال: تجاهل صخب الحشد",
 "喧然": "صَارِخ, صاخِب",
 "喧騒": "جلبة, صخب (فعل إحداث اضطراب صاخب) / اضطراب, فوضى (هياج عنيف) / جلبة, صخب (حالة من الهيجان والضوضاء والارتباك)",
 "喨々": "رَائِق, سَلِس (واضح وشفّاف في اللغة؛ سهل الفهم) / بِلَّوْرِيّ, رَائِق (ينقل الضوء ويمكن الرؤية من خلاله بوضوح)",
 "喨喨": "رَائِق, سَلِس (واضح وشفّاف في اللغة؛ سهل الفهم) / بِلَّوْرِيّ, رَائِق (ينقل الضوء ويمكن الرؤية من خلاله بوضوح)",
 "喩え": "مِثَال, مَثَل / مِثَال / تَشْبِيه",
 "喩える": "شَبَّهَ",
 "喪": "حِدَاد / ثَوْبُ حِدَاد (ما يُلْبَسُ من اللِبَاس، أي جزء ويطلق للرجال والنساء؛ الجزء الرئيس من الملابس، غالبا ما يكون طويلا وواسعا وذو أكمام، تحته الملابس الداخلية وفوقه الخارجية. يستخدم للرجال والنساء)\nمثال: هو ذئب في ثوب حمل. / بَلَاء, بُؤْس",
 "喪事": "جَنَازَة, دَفْن (مراسم تقام لتشييع وفاة شخص)\nمثال: \"أنا ذاهب إلى جنازة.\" \"من توفي؟\"",
 "喪失": "خَسَارَة, فِقْدَان / ضَرَر / خَسَارَة",
 "喪家": "مُتَشَرِّد",
 "喪心": "ترنح, ذهول (وعي هامشي) / ذهول, صدمة (شعور بالضيق وعدم التصديق الذي ينتابك عند حدوث شيء سيء بشكل عرضي)\nمثال: كان ترنحه بسبب الإرهاق بقدر ما كان بسبب الضربات / إِغْمَاء / أُغْمِيَ, غُشِيَ",
 "喪礼": "جَنَازَة, دَفْن (مراسم تقام لتشييع وفاة شخص)\nمثال: \"أنا ذاهب إلى جنازة.\" \"من توفي؟\"",
 "喪神": "ترنح, ذهول (وعي هامشي) / ذهول, صدمة (شعور بالضيق وعدم التصديق الذي ينتابك عند حدوث شيء سيء بشكل عرضي)\nمثال: كان ترنحه بسبب الإرهاق بقدر ما كان بسبب الضربات / إِغْمَاء / أُغْمِيَ, غُشِيَ",
 "喪章": "شريط الحداد (شريط أسود يرتديه الرجل (على الذراع أو القبعة) كعلامة على الحداد)",
 "喫す": "أَكَلَ : يَأْكُلُ, كَلْ (تَنَاوَلَ الطَّعَام، وَضَعَه في فمِه ثُم مَضَغَه ثُم بَلَعَه؛ أَفْنَى الشيء ولَم يبقِ منه)\nمثال: أحب أكل البطيخ. / تَأَلَّمَ, عَانَى / عَانَى (قَاسَى وكابد؛ الشيءَ: ملابسته ومباشرته)\nمثال: لقد عانى جمال كثيرا.",
 "喫する": "أَكَلَ : يَأْكُلُ, كَلْ (تَنَاوَلَ الطَّعَام، وَضَعَه في فمِه ثُم مَضَغَه ثُم بَلَعَه؛ أَفْنَى الشيء ولَم يبقِ منه)\nمثال: أحب أكل البطيخ. / تَأَلَّمَ, عَانَى / عَانَى (قَاسَى وكابد؛ الشيءَ: ملابسته ومباشرته)\nمثال: لقد عانى جمال كثيرا.",
 "喫む": "دُخَان, دخان / دَخَّنَ (دخن: الشَّيْء دخنة دخن؛ دخنت: النَّار دخنت والوقود دخن)\nمثال: دخن زيري سيجارة.",
 "喫水": "مُسْوَدَّة / تَجْنِيد / سَوَّدَ / جَنَّدَ (جَنَّدَ الجنودَ: جَمَعَهَا؛ جَنَّدَ فلانًا: صيَّره جنديّاً)",
 "喫水線": "خط الماء (خط يقابل سطح الماء عندما تكون السفينة طافية بتوازن؛ غالباً ما يُرسم على بدن السفينة)",
 "喫煙": "تَدْخِين",
 "喫煙ルーム": "غرفة المدخنين (غرفة في فندق أو نادٍ مخصصة للمدخنين)",
 "喫煙室": "غرفة المدخنين (غرفة في فندق أو نادٍ مخصصة للمدخنين)",
 "喫煙者": "مُدَخِّن, مُدَخِّنَة",
 "喫煙車": "عربة للمدخنين (عربة ركاب للمسافرين الذين يرغبون في التدخين)",
 "喫緊": "مُسْتَعْجِل",
 "喫茶": "مَقْهًى, دَار شَاي (مكان عام تُقدَّم فيه المشروبات كالقهوة والشاي، وأحياناً الأطعمة الخفيفة؛ مكانٌ عامٌّ تقدم فيه القهوةُ ونحُوها من الأَشربة)\nمثال: هذا المقهى مريح.",
 "喫茶店": "مقهى (مطعم صغير تباع فيه المشروبات والوجبات الخفيفة)",
 "喫食": "أَكْل (تَنَاوَلَ الطَّعَام، وَضَعَه في فمِه ثُم مَضَغَه ثُم بَلَعَه؛ أَفْنَى الشيء ولَم يبقِ منه)\nمثال: أحب أكل البطيخ.",
 "喫飯": "أَكْل (تَنَاوَلَ الطَّعَام، وَضَعَه في فمِه ثُم مَضَغَه ثُم بَلَعَه؛ أَفْنَى الشيء ولَم يبقِ منه)\nمثال: أحب أكل البطيخ.",
 "喫驚": "دَهْشَة, تَعَجُّب / بَاغَتَ / فَاجَأَ / دَهِشَ",
 "喬志": "فَخْر (اعتزَّ أو تباهى بشيء يملكه أو بعمل قام به؛ زها على الآخرين وأبدى شعوره بالتفوق) / زُمْرَة\nمثال: أنا شديدة الفخر بأبي.",
 "喬木": "عريشة (هيكل يدعم النباتات المتسلقة) / عمود دوران, مغزل (أي من الأعمدة الدوارة المختلفة التي تعمل كمحاور لأجزاء دوارة أكبر) / شجرة (شجرة (في مقابل شجيرة))\nمثال: وفرت العريشة مكاناً ظليلاً للراحة في الحديقة",
 "喰い付く": "قَضَمَ / تَذَمَّرَ, اِشْتَكَى / شَكَا, اِشْتَكَى (تَأَلَّمَ مِنْ مَرَضٍ أو هَمٍّ وَنَحْوِهِ؛ أَظْهَرَ)",
 "喰い締める": "إمساك, قبضة (فعل الإمساك) / عقدة تثبيت (أنشوطة صغيرة مصنوعة بالربط)\nمثال: أرخى قبضته عن ذراعي",
 "喰う": "أَكَلَ : يَأْكُلُ, كَلْ (تَنَاوَلَ الطَّعَام، وَضَعَه في فمِه ثُم مَضَغَه ثُم بَلَعَه؛ أَفْنَى الشيء ولَم يبقِ منه)\nمثال: أحب أكل البطيخ. / حَيِيَ, عَاشَ / يَنْجُو / حَيّ (ضد المَيِّت، على قيد الحَيَاة؛ جمع حَيَاء) / مُباشِر\nمثال: ينبح كلب في الحي. / عَضَّ, قَضَمَ / عَضَّ / قَرْصة / لُقْمة / إغاظة, تهكم (فعل مضايقة شخص ما بمرح أو بخبث (خاصة عن طريق السخرية)؛ استفزاز شخص ما بمضايقات مستمرة) / غانية, لعوب (امرأة مغرية تستخدم جاذبيتها لاستغلال الرجال) / مستفز, مشاكس (شخص يميل إلى المشاكسة (عن طريق السخرية أو إثارة الفضول))\nمثال: تجاهل تهكمهم",
 "喰らいつく": "قَضَمَ",
 "喰らい付く": "قَضَمَ",
 "喰らう": "أَكَلَ : يَأْكُلُ, كَلْ (تَنَاوَلَ الطَّعَام، وَضَعَه في فمِه ثُم مَضَغَه ثُم بَلَعَه؛ أَفْنَى الشيء ولَم يبقِ منه)\nمثال: أحب أكل البطيخ. / اِسْتَقْبَلَ, اِسْتَلَمَ (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه) / اِسْتَقْبَلَ, يَسْتَقْبِل (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه)\nمثال: استقبل توم الضيوف.",
 "喰屍鬼": "غُول",
 "営々": "صُلْب (قوي وصلب الملمس، لا ينحني بسهولة؛ متماسك وثابت، غير قابل للتغيير أو الانكسار) / صَعْب / لَا يُدْحَضُ (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: هذا التخت جدا صلب.",
 "営み": "نَشَاط / وَظِيفَة, مِهْنَة (ما يُقَدَّر من الشيء في زمن مُعَيَّن؛ مَنْصِب) / اِحْتِلال, إِشْغَال (احتلّ: نزل؛ احتلّ به واحتلّه: نزل به، واحتلّ الشيء: اتّخذه حلالاً)\nمثال: ما وظيفة زوجتك؟ / جِمَاع, مُجَامَعَة (الموافقة والمساعدة في أي شيء كان؛ الشيء: جمعه)\nمثال: توم قائد جماعة أنونيموس. / تَحْضِير, إِعْدَاد",
 "営む": "رَكَضَ (عَدَا) / جَرَى (تحرك من مكان إلى آخر بصورة مستمرة وسريعة؛ الماء أو النهر أو السائل: سالَ)\nمثال: إنها تحب الركض. / شَغَّلَ, نَفَّذَ ((شَغَلَ) الدارَ يَشْغَلَ شَغْلًا: سكنها؛ شَغَلَ فلانًا عن الشيء: لَهَّاهُ وصرَفَه)\nمثال: شغل بيل التلفاز. / مَسَكَ, مسك",
 "営倉": "سجن عسكري, مركز حراسة (منشأة عسكرية تعمل كمقر للشرطة العسكرية ويمكن فيها احتجاز السجناء العسكريين)",
 "営利": "مُتَسَلِّع, مُسَوَّق (مُنظّم أساساً لتحقيق الربح المالي)",
 "営利主義": "تجارة, تجارية (المعاملات (البيع والشراء) التي تهدف إلى توفير السلع (البضائع والخدمات))",
 "営利的": "إِعْلَان تِجَارِيّ",
 "営営": "صُلْب (قوي وصلب الملمس، لا ينحني بسهولة؛ متماسك وثابت، غير قابل للتغيير أو الانكسار) / صَعْب / لَا يُدْحَضُ (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: هذا التخت جدا صلب.",
 "営団": "كرش (مصطلحات عامية للكرش أو البطن البارز) / شركة مساهمة, مؤسسة (شركة تجارية تمت الموافقة على مواد تأسيسها في ولاية ما)",
 "営巣地": "معشش, مكان التعشيش (مكان مناسب للتعشيش)",
 "営所": "ثُكْنَة, قَشْلَة",
 "営業": "شَرِكَة / عَمَل, تِجَارَة (فِعْل، صُنْع؛ وسيلة للكسب، مِهْنَة، حِرْفَة) / رِعَايَة\nمثال: المهم هو العمل. / إجمالي الإيرادات, إجمالي المبيعات (الدخل (بقيم الفواتير) المستلم للبضائع والخدمات خلال فترة معينة)",
 "営業スタッフ": "طاقم المبيعات (أولئك في شركة المسؤولون عن المبيعات)",
 "営業トーク": "خِطَاب الْبَيْع, عَرْض تَرْوِيجِيّ (ترويج عن طريق الحجة والبرهان)",
 "営業パーソン": "بَيَّاع, بَيَّاعَة",
 "営業マン": "بَيَّاع, بَيَّاعَة",
 "営業中": "مَفْتُوح / فَتَحَ (ضد أغْلَقَ وسَدَّ؛ تركه بلا شيء يسده؛ الطريق: جعلها سالكة للطارقين) / فتح (ضد أغْلَقَ وسَدَّ؛ تركه بلا شيء يسده؛ الطريق: جعلها سالكة للطارقين) / حل (للعقدة: ضد عَقْدها؛ للجامد في السائل: إذابته) / اِنْفَتَحَ (فعل مطاوعة لفَتَحَ، فَتَحْتُهُ فانْفَتَح؛ يستخدم عوضا عن المبنى للمجهول فُتِحَ. )\nمثال: فتح الباب آليا.",
 "営業品目": "تشكيلة منتجات, خط إنتاج (نوع معين من المنتجات أو البضائع)\nمثال: تشكيلة جميلة من الأحذية",
 "営業員": "بَيَّاع, بَيَّاعَة",
 "営業年度": "سَنَة مَالِيَّة (مقدارُ قطع الشمس البروجَ الاثني عشر ، وهي السنة الشمسيَّة، و السَّنَةُ تمامُ اثنتَيْ عشرةَ دَورةً للقمر ، وهي السنة القمرية…)\nمثال: في عمره 24 سنة.",
 "営業所": "مكتب (مكان عمل يتم فيه أداء واجبات مهنية أو كتابية)\nمثال: استأجر مكتباً في المبنى الجديد",
 "営業案内": "كَتَالُوج, فِهْرِس",
 "営業活動": "نشاط تجاري (نشاط يتم القيام به كجزء من مؤسسة تجارية)",
 "営業秘密": "سر تجاري (سر (طريقة أو جهاز أو صيغة) يمنح الشركة المصنعة ميزة على المنافسة)",
 "営業種目": "مجال, ميدان عمل (نوع معين من المؤسسات التجارية) / تشكيلة منتجات, خط إنتاج (نوع معين من المنتجات أو البضائع)\nمثال: هم متميزون في مجالهم",
 "営業者": "رَائِد أَعْمال مُتَعَهِّد / مُنَظِّم",
 "営業費": "تكاليف التشغيل, مصاريف إدارية وعامة (نفقات صيانة الممتلكات (مثل دفع الضرائب العقارية والمرافق والتأمين)؛ لا تشمل الإهلاك أو تكلفة التمويل أو ضرائب الدخل)",
 "営業部": "إدارة المبيعات, قسم المبيعات (قسم في مؤسسة تجارية مسؤول عن بيع المنتجات أو الخدمات)",
 "営為": "شَرِكَة / عَمَل, تِجَارَة (فِعْل، صُنْع؛ وسيلة للكسب، مِهْنَة، حِرْفَة) / رِعَايَة\nمثال: المهم هو العمل.",
 "営繕": "صيانة, عناية (نشاط يتضمن الحفاظ على شيء في حالة عمل جيدة) / إعاشة, صيانة (فعل الحفاظ على الحياة بالطعام أو توفير وسائل العيش)\nمثال: ألف دليل العناية بالسيارة",
 "営舎": "ثُكْنَة, قَشْلَة",
 "営農": "زراعة, عمل في الأرض (الزراعة باعتبارها مهنة أو أسلوب حياة) / زراعة, فلاحة (ممارسة زراعة الأرض أو تربية الماشية)\nمثال: الزراعة حياة شاقة",
 "営造": "بِنَاء (ضد هَدْم. ؛ المَبْنَى أو البِنَاية) / مَبْنَى, بِنَاء (كل ما بُنِيَ؛ ما يُبْنى على أرضٍ محاطا بالجُدْرَان ومغطى بسَقْف. (تخصيص))\nمثال: أنا وجدت البناء.",
 "営造物": "بِنَاء (ضد هَدْم. ؛ المَبْنَى أو البِنَاية) / مَبْنَى, بِنَاء (كل ما بُنِيَ؛ ما يُبْنى على أرضٍ محاطا بالجُدْرَان ومغطى بسَقْف. (تخصيص))\nمثال: أنا وجدت البناء.",
 "嗄れ嗄れ": "مَبْحُوح",
 "嗄声": "بُحَاح",
 "嗅ぎたばこ": "نَشُوق",
 "嗅ぎつける": "يَشُمّ, يَكْتَشِف",
 "嗅ぎタバコ": "نَشُوق",
 "嗅ぎ付ける": "يَشُمّ, يَكْتَشِف",
 "嗅ぎ出す": "كَشَفَ (كشَّف الأمرَ بالغ في كشْفِه وتوضيحه؛ أزال الغطاء أو جعل الشيء مكشوفًا)\nمثال: كشف كارل المزيد.",
 "嗅ぎ取る": "رَائِحَة, رِيحة (الخاصية التي تمتلكها بعض المركبات الكيميائية المتطايرة في الهواء على الأرجح بتركيز منخفض جدًا…) / شَمّ ((شَمَّ) البناءُ أو الجبلُ يَشُمُّ شَمَمًا: ارتفَعَ أعلاهُ؛ (شَمَّ) الأنفُ: ارتفعت قَصَبَتُهُ قليلاً في استواء) / شَمَّ ((شَمَّ) البناءُ أو الجبلُ يَشُمُّ شَمَمًا: ارتفَعَ أعلاهُ؛ (شَمَّ) الأنفُ: ارتفعت قَصَبَتُهُ قليلاً في استواء) / اِشْتَمَّ (اجتذب الرائحة، قَرَبَّ الشيء أو اقترب منه ليشمه) / شم ((شَمَّ) البناءُ أو الجبلُ يَشُمُّ شَمَمًا: ارتفَعَ أعلاهُ؛ (شَمَّ) الأنفُ: ارتفعت قَصَبَتُهُ قليلاً في استواء) / شَمَّمَ\nمثال: شم تلك الرائحة. / حَاسَّة / إِحْسَاس, شُعُور / مَعْنَى, دَلَالَة / مَوْهِبَة, قُدْرَة طَبِيعِيَّة / حَسَّ (حسّه:أحرقه ، حسسْتُ الشّيء:أحسَسْتُه،حسَسْتُ اللحمَ:جعلته على الجمر،حسَسْتُ النّارَ:رددْتُها بالعصا على خُبْزِ المَلّةِ؛ حَسَّ فلاناً:قتله قتلاً ذريعاً مستأصلاً رأسه.(حسَسْتُ اليهوديََ لما أظهر عداوته لله ودينه))\nمثال: لديهم حس الفكاهة.",
 "嗅ぎ当てる": "يَشُمّ, يَكْتَشِف",
 "嗅ぎ薬": "استنشاقي, شهيقي (يقوم بالاستنشاق أو يخدم عملية الاستنشاق) / دواء استنشاق, مستنشق (دواء يؤخذ عن طريق استنشاقه) / مستنشق (مادة يتم استنشاقها)\nمثال: مسام شهيقي",
 "嗅ぐ": "استنشاق, تشمم (استشعار رائحة عن طريق الاستنشاق من الأنف)",
 "嗅球": "بصلة شمية (أحد تضخمين عند نهاية العصب الشمي عند قاعدة الدماغ فوق تجاويف الأنف مباشرة)",
 "嗅神経": "عصب شمي, عصب قحفي أول (مصطلح جماعي للعديد من الخيوط الشمية في الغشاء المخاطي للأنف)",
 "嗅脳": "دماغ شمي (مركز في نصفي الكرة المخية يحكم حاسة الشم في الحيوانات الدنيا؛ وفي البشر يبدو أنه يتوسط السلوك العاطفي المعقد)",
 "嗅覚": "حاسة الشم, شم (الملكة التي تمكننا من تمييز الروائح)",
 "嗅覚低下": "نقص الشم (انخفاض الحساسية للروائح)",
 "嗅覚器官": "أنف (عضو الشم ومدخل الجهاز التنفسي؛ الجزء البارز من وجه الإنسان أو الثدييات الأخرى)\nمثال: لديه زكام في الأنف",
 "嗅覚障害": "خلل الشم, عسر الشم (اضطراب في حاسة الشم)",
 "嗔恚": "غَضَب / أَغْضَبَ / غَضِبَ",
 "嗚咽": "شهيق البكاء, نشيج (شهقة تشنجية تحدث أثناء البكاء)",
 "嗜み": "ذَوْق, طَعْم (الذَّوْقُ : حَاسَّةُ اللِّسَانِ وَبِهَا قُوَّةٌ تُدْرِكُ خَوَاصَّ الأَجْسَامِ الطَّعْمِيَّةَ؛ الذَّوْقُ : آدابُ السلوك التي تقتضي معرفة ما هو لائق أو مناسب في موقف اجتماعيّ معيّن) / ذَوْق (الذَّوْقُ : حَاسَّةُ اللِّسَانِ وَبِهَا قُوَّةٌ تُدْرِكُ خَوَاصَّ الأَجْسَامِ الطَّعْمِيَّةَ؛ الذَّوْقُ : آدابُ السلوك التي تقتضي معرفة ما هو لائق أو مناسب في موقف اجتماعيّ معيّن) / ذَاقَ, تَذَوَّقَ (تناول شيئا من الطعام أو الشراب ليختبر طَعْمَه؛ جَرَّبَ، اِخْتًبَرَ، أَحَسَّ)\nمثال: أكره ذوق الكحول. / آداب, أخلاق (السلوك الاجتماعي)\nمثال: أخلاقه أخلاق خنازير / تَوَاضُع / حِشْمَة / تَنْفِيذ",
 "嗜む": "اِسْتَمْتَعَ, تَمَتَّعَ / حَظِيَ (نَعِمَ بِشَيْءٍ أَو نَالَ حَظًّا مِنْهُ؛ نَالَ مَكَانَةً وَمَنْزِلَةً عِنْدَ شَخْصٍ)\nمثال: من حسن حظي أن صرت صديقه. / سَاعَة (ثُلْث ثُمْن اليَوْم بمعنى مجموع النَهَار واللَيْل، أي جزء من أربعة وعشرين جزءا من مجموع النهار والليل وتتكون من ستين دَقِيقَة؛ الوَقْت الحاضر، الآن) / حَارِس / رَصَدَ (الرَّصْد : المُراقبة؛ الرَّصد الجوّي: دراسة الأَحوال الجوّيَّة لمعرفة تقلُّبات الطقس) / حَذِرَ (حذِر الشّخصُ: تيقّظ واستعدّ وتأهّب وتنبّه؛ حذِر الأمرَ: كَتَمَه وأخفاه) / حَرَسَ (حَفِظَ الشيء أو الشخص أو مكاناً من المخاطر أو الأضرار؛ راقب شيئاً أو شخصاً بعناية لضمان الأمان)\nمثال: درست لمدة ساعة.",
 "嗜好": "ذَوْق, طَعْم (الذَّوْقُ : حَاسَّةُ اللِّسَانِ وَبِهَا قُوَّةٌ تُدْرِكُ خَوَاصَّ الأَجْسَامِ الطَّعْمِيَّةَ؛ الذَّوْقُ : آدابُ السلوك التي تقتضي معرفة ما هو لائق أو مناسب في موقف اجتماعيّ معيّن) / ذَوْق (الذَّوْقُ : حَاسَّةُ اللِّسَانِ وَبِهَا قُوَّةٌ تُدْرِكُ خَوَاصَّ الأَجْسَامِ الطَّعْمِيَّةَ؛ الذَّوْقُ : آدابُ السلوك التي تقتضي معرفة ما هو لائق أو مناسب في موقف اجتماعيّ معيّن) / ذَاقَ, تَذَوَّقَ (تناول شيئا من الطعام أو الشراب ليختبر طَعْمَه؛ جَرَّبَ، اِخْتًبَرَ، أَحَسَّ)\nمثال: أكره ذوق الكحول.",
 "嗜好品": "صَكّ غُفْرَان",
 "嗜慾": "إعجاب, ميل (شعور بالمتعة والاستمتاع)\nمثال: كان لدي دائماً ميل للقراءة",
 "嗜欲": "إعجاب, ميل (شعور بالمتعة والاستمتاع)\nمثال: كان لدي دائماً ميل للقراءة",
 "嗜癖": "إِدْمَان",
 "嗜眠": "نَوْم عَمِيق (بكافة معانيه)\nمثال: لم أستطع النوم.",
 "嗜眠性": "خامل, فاتر (يفتقر إلى اليقظة أو النشاط)\nمثال: أصبحت الضفادع خاملة مع أول ليالي البرد",
 "嗜眠性脳炎": "التهاب الدماغ السباتي, مرض النوم (التهاب دماغ كان وبائياً بين عامي 1915 و1926؛ تشمل الأعراض شلل عضلة العين الخارجية وضعف عضلي شديد)",
 "嗜虐": "سادية",
 "嗜虐性": "سادية",
 "嗜虐的": "سادى",
 "嗜食": "تذوق (أخذ كمية صغيرة في الفم لاختبار جودتها)\nمثال: كان الطهي جيدًا ولكن التذوق هو ما استمتع به أكثر",
 "嗟嘆": "حداد, ندب (النشاط العاطفي والظاهر للتعبير عن الحزن) / رثاء, عويل (صرخة حزن وأسى)\nمثال: يمكن سماع نواحهم المثير للشفقة في جميع أنحاء الجناح / إِعْجَاب",
 "嗟歎": "حداد, ندب (النشاط العاطفي والظاهر للتعبير عن الحزن) / رثاء, عويل (صرخة حزن وأسى)\nمثال: يمكن سماع نواحهم المثير للشفقة في جميع أنحاء الجناح / إِعْجَاب",
 "嗣": "تولي, خلافة (اكتساب الممتلكات عن طريق النسب أو الوصية) / تتابع, تسلسل (فعل التتابع بالترتيب) / تسلسل, تعاقب (تتابع شيء بعد آخر في الوقت) / تتابع, تعاقب (مجموعة من الأشخاص أو الأشياء مرتبة أو متتابعة بالترتيب)\nمثال: لعب الأوراق الرابحة بالتسلسل",
 "嗣子": "وَارِث, وَرِيث (اسم فاعل من الفعل وَرَثَ؛ الوَارِث: اسم من الأسماء الحسنى)",
 "嗣業": "مِيرَاث, إرْثْ",
 "嗤うべき": "كُومِيدِيّ, مُضْحِك (يُثير الضحك أو يستدعيه) / سَخِيف, مُثِير لِلسُّخْرِيَة (بالغ اللامعقوليّة بحيث يستدعي الاستهزاء والسخرية)",
 "嗤笑": "تَكْشِيرَة سَاخِرَة, نَظْرَة ازْدِرَاء (تعبير وجهي يدل على الازدراء أو الاحتقار (برفع الشفة العليا)) / تَعْلِيق مُتَهَكِّم, مُلَاحَظَة سَاخِرَة (ملاحظة ازدرائية أو محتقرة)",
 "嗽ぐ": "تَمَضْمَضَ, غَرْغَرَ / سَائِل الْغَرْغَرَة",
 "嗽薬": "غَسُولُ فَمّ",
 "嗾ける": "حَرَّضَ, دَفَعَ (حرّضه على الأمر: حضّه ، شدّد الرّغبة فيه؛ حَرَّضَهُ تَحْرِيضاً: حَثَّه على القِتَالِ وأَحْمَاهُ عَلَيْه)\nمثال: هو حرض على الشغب.",
 "嘆": "تَنَهَّدَ / تَنَهُّد / غَمّ, حُزْن",
