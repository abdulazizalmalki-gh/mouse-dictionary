 "化青鮫": "ماكو طويل الزعنفة (يشبه الماكو قصير الزعنفة ولكنه أزرق داكن أكثر)",
 "化骨": "تَعَظُّم",
 "北": "شَمَال (الْجِهَةُ الْمُقَابِلَةُ لِلجَنُوب؛ رَأْسُ الْبَوْصَلَةِ الْمُقَابِلُ لِلجَنُوب) / شمال (الْجِهَةُ الْمُقَابِلَةُ لِلجَنُوب؛ رَأْسُ الْبَوْصَلَةِ الْمُقَابِلُ لِلجَنُوب)\nمثال: أعيش في شمال السويد. / كُورِيَا الشَّمَالِيَّة (بلاد في جنوب شرق آسيا، يطلق عليها جغرافيا شِبْهُ الجَزِيْرَةِ الكُوْرِيَّة؛ دولتان تقعان في جنوب شرق آسيا تسميان كُوْرِيَا الشَمَالِيَّة وكُوْرِيَا الجَنُوْبِيَّة)\nمثال: أريد أن أزور كوريا. / رياح شمالية (رياح تهب من الشمال)",
 "北々東": "باتجاه الشمال الشمالي الشرقي (إلى أو باتجاه أو في الشمال الشمالي الشرقي)",
 "北々西": "باتجاه الشمال الشمالي الغربي (إلى أو باتجاه أو في الشمال الشمالي الغربي)",
 "北の方": "شَمَال (الْجِهَةُ الْمُقَابِلَةُ لِلجَنُوب؛ رَأْسُ الْبَوْصَلَةِ الْمُقَابِلُ لِلجَنُوب) / شمال (الْجِهَةُ الْمُقَابِلَةُ لِلجَنُوب؛ رَأْسُ الْبَوْصَلَةِ الْمُقَابِلُ لِلجَنُوب)\nمثال: أعيش في شمال السويد. / زَوْجَة, اِمْرَأَة",
 "北アイルランド": "أِيرْلَنْدَا الشَّمَالِيَّة (جزيرة تقع في شمال المحيط الأطلسي، تحدها جزيرة بريطانيا العظمى من الشرق؛ دولة في شمال غرب قارة أوروبا؛ اسمها الرسمي جمهورية أيرلندا، وعاصمتها دبلن)",
 "北アフリカ": "شَمَال إِفْرِيقِيَا, شَمَال أَفْرِيقِيَا (الْجِهَةُ الْمُقَابِلَةُ لِلجَنُوب؛ رَأْسُ الْبَوْصَلَةِ الْمُقَابِلُ لِلجَنُوب)\nمثال: أعيش في شمال السويد.",
 "北アメリカ": "أَمْرِيكَا الشَّمَالِيَّة",
 "北オポッサム": "أمريكي شمالي (متعلق بقارة أمريكا الشمالية أو دولها أو شعوبها أو مميز لها) / أمريكي شمالي (مواطن أو ساكن في أمريكا الشمالية)",
 "北キプロス": "قُبْرُص الشَّمَالِيَّة (دولة تحكمها جمهورية قبرص، وهي عضو من الاتحاد الأوروبي منذ 2004، ولكنها لا تسيطر على قبرص الشمالية منذ 1974…)\nمثال: كانت قبرص محمية بريطانية.",
 "北ベトナム": "فِيِتْنَام الشَّمَالِيَّة, فْيِتْنَام الشَّمَالِيَّة",
 "北マケドニア": "مَقِدُونِيَا الشَّمَالِيَّة",
 "北マケドニア共和国": "جُمْهُورِيَّة شَمَالِ مَقْدُونِيَا",
 "北マリアナ諸島": "جزر ماريانا الشمالية (جَزَرَ الماءُ عن الأَرضِ يَجْزُرُ جَزْراً: نَضَبَ وحَسَرَ؛ ويقال: جَزَرَ البَحْرُ والنَّهْرُ: انْحسرَ ماؤُهُ)",
 "北ヨーロッパ": "أُورُوبَا الشَّمَالِيَّة (الجزء من يوراسيا الذي يقع غرب جبال الأورال، والمعتبر تقليديًّا قارة بحد ذاته، كما يقع شمال قارة إفريقيا، وغرب قارة آسيا، وشرق المحيط الأطلسي؛ كيان سياسي؛ الاتحاد الأوروبي)\nمثال: ذهبت إلى أوروبا مرة.",
 "北京": "بِكِين / پِكِين / كِيُوتُو",
 "北京人": "بِكِينِيّ, بِكِينِيَّة",
 "北京原人": "إنسان بكين (أحافير عُثر عليها بالقرب من بكين، الصين؛ فُقدت خلال الحرب العالمية الثانية)",
 "北京官話": "الصينية الفصحى, الماندرين (لهجة صينية يتم التحدث بها في بكين وتم اعتمادها كلغة رسمية للصين بأكملها)",
 "北京語": "الصينية الفصحى, الماندرين (لهجة صينية يتم التحدث بها في بكين وتم اعتمادها كلغة رسمية للصين بأكملها)",
 "北側": "الجانب الشمالي (الجانب الذي يقع في الشمال)",
 "北光": "شفق قطبي ((شَفِقَ) منه، وعليه يَشْفَقَ شَفَقًا: خاف وحَذِرَ، فهو شَفِقٌ؛ (شَفِقَ) عليه: رَقَّ له وعطف عليه؛ فهو شَفِيقٌ)\nمثال: أثارت تلك السلحفاة شفقة زيري.",
 "北入": "أَعْلَى (اسم تفضيل من عَلَا/ علا في؛ أكثر ارتفاعًا، عكْسه أسفل سقط من أعلى المبنى) / فَوقَ / شَمَالِيّ / على (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: خذها إلى الأعلى.",
 "北入ル": "أَعْلَى (اسم تفضيل من عَلَا/ علا في؛ أكثر ارتفاعًا، عكْسه أسفل سقط من أعلى المبنى) / فَوقَ / شَمَالِيّ / على (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: خذها إلى الأعلى.",
 "北別府": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "北前船": "شحن بحري, ملاحة تجارية (خدمات النقل التي توفرها السفن التابعة لبلد أو صناعة معينة)",
 "北北東": "باتجاه الشمال الشمالي الشرقي (إلى أو باتجاه أو في الشمال الشمالي الشرقي)",
 "北北西": "باتجاه الشمال الشمالي الغربي (إلى أو باتجاه أو في الشمال الشمالي الغربي)",
 "北半球": "نِصْف اَلْكُرَة الْأَرْضِيَّة الشَّمَالِيّ",
 "北原": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "北名": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "北回帰線": "مَدَار السَّرَطَان (اسم مَفْعُول من أدَارَ، الشيء أو الشخص الذي أُدِير)\nمثال: انتشرت الشائعة على مدار الدولة.",
 "北国": "الأراضي الشمالية, الشمال (أي منطقة تقع في الشمال أو باتجاهه)",
 "北国人": "شمالي (أحد سكان الشمال) / شمالي, يانكي (أمريكي يعيش في الشمال (خاصة خلال الحرب الأهلية الأمريكية))",
 "北堂": "أُمّ, وَالِدَة (الوَالِدَة أو الجَدَّة، وقد يطلق على والدة الزوج مجازا؛ أمّ بالرضاعة: المرأة التي أرضعت الطِفْل صغيرا فتصبح كوالدته)\nمثال: هل ستأتي أم لا؟",
 "北大西洋条約機構": "مُنَظَّمَة حِلْف شَمَال اَلْأَطْلَسِيّ, اَلْحِلْف اَلْأَطْلَسِيّ",
 "北寄り": "شَمَالًا (في اتجاه الشمال) / شَمَالِيّ المَصْدَر (قادم من الشمال؛ يوصف به خاصة الرياح) / شَمَالِيّ الاتِّجَاه (موجَّه نحو الشمال) / رياح شمالية (رياح تهب من الشمال)\nمثال: يكسبون أكثر في الشمال",
 "北山": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "北島": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "北川": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "北征": "حملة, حملة عسكرية (عدة عمليات مترابطة تهدف إلى تحقيق هدف معين (عادة ضمن قيود جغرافية وزمنية))",
 "北微東": "الشَّمَال المَائِل لِلشَّرْق, شَمَال لِشَرْق (نقطة البوصلة التي تقع شرق الشمال بنقطة واحدة)",
 "北微西": "الشَّمَال المَائِل لِلغَرْب, شَمَال لِغَرْب (نقطة البوصلة التي تقع غرب الشمال بنقطة واحدة)",
 "北斗": "بَنَاتُ نَعْشٍ الكُبْرَى",
 "北斗七星": "بَنَاتُ نَعْشٍ الكُبْرَى",
 "北斗星": "بَنَاتُ نَعْشٍ الكُبْرَى",
 "北方": "شَمَال (الْجِهَةُ الْمُقَابِلَةُ لِلجَنُوب؛ رَأْسُ الْبَوْصَلَةِ الْمُقَابِلُ لِلجَنُوب) / شمال (الْجِهَةُ الْمُقَابِلَةُ لِلجَنُوب؛ رَأْسُ الْبَوْصَلَةِ الْمُقَابِلُ لِلجَنُوب)\nمثال: أعيش في شمال السويد.",
 "北方四島": "مُقَاطَعَة شَمَالِيَّة",
 "北方話": "اَللُّغَة اَلصِّينِيَّة اَلشَّمَالِيَّة, مَنْدَرِينِيَّة",
 "北方限界線": "خَطُّ تَرْسِيم, خَطُّ التَّرْسِيم (كِتَابَة؛ ما يَصِل نقطتين أو أكثر)\nمثال: إرسم خط مستقيم.",
 "北方領土": "مُقَاطَعَة شَمَالِيَّة",
 "北方領土問題": "جُزُر اَلْكُورِيل (جَزَرَ الماءُ عن الأَرضِ يَجْزُرُ جَزْراً: نَضَبَ وحَسَرَ؛ ويقال: جَزَرَ البَحْرُ والنَّهْرُ: انْحسرَ ماؤُهُ)\nمثال: ضع الجزر في القدر.",
 "北朝鮮": "كُورِيَا الشَّمَالِيَّة (بلاد في جنوب شرق آسيا، يطلق عليها جغرافيا شِبْهُ الجَزِيْرَةِ الكُوْرِيَّة؛ دولتان تقعان في جنوب شرق آسيا تسميان كُوْرِيَا الشَمَالِيَّة وكُوْرِيَا الجَنُوْبِيَّة)\nمثال: أريد أن أزور كوريا.",
 "北朝鮮人": "كوري شمالي (من أو يتعلق بكوريا الشمالية أو شعبها أو ثقافتها أو يميزهم) / كوري شمالي (كوري من كوريا الشمالية)",
 "北村": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "北条": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "北東": "باتجاه الشمال الشرقي (إلى أو باتجاه أو في الشمال الشرقي) / شَمَال شَرْقِيّ (يقع في الشمال الشرقي أو موجَّه نحوه) / قَادِم مِنَ الشَّمَال الشَّرْقِيّ (قادم من اتجاه الشمال الشرقي) / شمال شرق (موقع في الجزء الشمالي الشرقي من بلد أو منطقة أو مدينة)",
 "北東微北": "الشَّمَال الشَّرْقِيّ المَائِل لِلشَّمَال, شَمَال شَرْقِيّ لِشَمَال (نقطة البوصلة التي تقع شمال الشمال الشرقي بنقطة واحدة)",
 "北東微東": "الشَّمَال الشَّرْقِيّ المَائِل لِلشَّرْق, شَمَال شَرْقِيّ لِشَرْق (نقطة البوصلة التي تقع شرق الشمال الشرقي بنقطة واحدة)",
 "北東部": "باتجاه الشمال الشرقي (إلى أو باتجاه أو في الشمال الشرقي) / شَمَال شَرْقِيّ (يقع في الشمال الشرقي أو موجَّه نحوه) / قَادِم مِنَ الشَّمَال الشَّرْقِيّ (قادم من اتجاه الشمال الشرقي) / شمال شرق (موقع في الجزء الشمالي الشرقي من بلد أو منطقة أو مدينة)",
 "北栗鼠": "سنجاب أحمر (سنجاب بني محمر شائع في أوروبا وأجزاء من آسيا) / سنجاب أحمر أمريكي (من شمال الولايات المتحدة وكندا)",
 "北極": "اَلْقُطْب اَلشَّمَالِيّ\nمثال: 北極圏とは北極周辺の地域の事である。 — المنطقة القطبية هي تلك الواقعة حول القطب الشمالي. / قُطْبِيّ شَمَالِيّ",
 "北極光": "شفق قطبي ((شَفِقَ) منه، وعليه يَشْفَقَ شَفَقًا: خاف وحَذِرَ، فهو شَفِقٌ؛ (شَفِقَ) عليه: رَقَّ له وعطف عليه؛ فهو شَفِيقٌ)\nمثال: أثارت تلك السلحفاة شفقة زيري.",
 "北極圏": "الدَّائِرَة الْقُطْبِيَّة الشَّمَالِيَّة\nمثال: 北極圏とは北極周辺の地域の事である。 — المنطقة القطبية هي تلك الواقعة حول القطب الشمالي.",
 "北極地方": "قُطْبِيّ شَمَالِيّ",
 "北極岩魚": "شار قطبي (ترويت صغير في المياه الشمالية؛ توجد مجموعات حبيسة في كيبيك وشمال نيو إنجلاند)",
 "北極星": "الجُدَيّ, نَجْم الشَمَال",
 "北極洋": "الْمُحِيط الْمُتَجَمِّد الشَّمَالِيّ, الْمُحِيط الشَّمَالِيّ",
 "北極海": "الْمُحِيط الْمُتَجَمِّد الشَّمَالِيّ, الْمُحِيط الشَّمَالِيّ",
 "北極点": "اَلْقُطْب اَلشَّمَالِيّ",
 "北極熊": "دُبّ أَبْيَض, دُبَّة بَيْضَاء",
 "北極狐": "ثعلب أبيض, ثعلب قطبي (ثعلب كثيف الفرو من المناطق القطبية؛ بني في الصيف وأبيض في الشتاء)",
 "北極狼": "ذئب أبيض, ذئب قطبي (ذئب من القطب الشمالي لأمريكا الشمالية ذو فرو أبيض وذيل أسود الطرف)",
 "北極線": "الدَّائِرَة الْقُطْبِيَّة الشَّمَالِيَّة",
 "北極野兎": "أرنب قطبي (أرنب بري كبير من شمال أمريكا الشمالية؛ يكون أبيض بالكامل تقريباً في الشتاء)",
 "北極鯨": "حوت مقوس الرأس (حوت قطبي كبير الفم)",
 "北欧": "أُورُوبَا الشَّمَالِيَّة (الجزء من يوراسيا الذي يقع غرب جبال الأورال، والمعتبر تقليديًّا قارة بحد ذاته، كما يقع شمال قارة إفريقيا، وغرب قارة آسيا، وشرق المحيط الأطلسي؛ كيان سياسي؛ الاتحاد الأوروبي)\nمثال: ذهبت إلى أوروبا مرة.",
 "北欧人": "إسكندنافي, نورسي (من أو يتعلق بإسكندنافيا أو شعوبها أو ثقافاتها) / الجرمانية الشمالية, اللغات الإسكندنافية (العائلة الشمالية من اللغات الجرمانية التي يتم التحدث بها في الدول الإسكندنافية وأيسلندا) / إسكندنافي (أحد سكان إسكندنافيا)\nمثال: الملاحم النورسية",
 "北欧神話": "الأساطير الإسكندنافية (أساطير الدول الإسكندنافية (التي تشترك فيها جزئيًا بريطانيا وألمانيا) حتى تغلغل المسيحية)",
 "北欧諸国": "دولة إسكندنافية (أي دولة من الدول التي تشغل إسكندنافيا)",
 "北氷洋": "الْمُحِيط الْمُتَجَمِّد الشَّمَالِيّ, الْمُحِيط الشَّمَالِيّ",
 "北沢": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "北浜": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "北海": "بَحَر اَلشَّمَال (شَقّ الأرض؛ التَحَيُّر والبَهْت من الفزع أو من شدة العَطَش فنظر لا يقصد شيئا)\nمثال: هبطت على البحر. / هُوكَايْدُو, هُكَّايْدُو",
 "北海油田": "بَحَر اَلشَّمَال (شَقّ الأرض؛ التَحَيُّر والبَهْت من الفزع أو من شدة العَطَش فنظر لا يقصد شيئا)\nمثال: هبطت على البحر.",
 "北海道": "هُوكَايْدُو, هُكَّايْدُو",
 "北海道犬": "هُوكَايْدُو, هُكَّايْدُو",
 "北海道開発庁長官": "مُدِير عَامّ (الشخص الذي أدار، جمعه مُدِيرُون ومُدِيرِين؛ مهنة يتولى صاحبها إدَارَة شؤون جهة ما. جمعه مُدَرَاء)\nمثال: زيري هو المدير.",
 "北田": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "北米": "أَمْرِيكَا الشَّمَالِيَّة",
 "北米合衆国": "الْوِلَايَات الْمُتَّحِدَة الْأَمْرِيكِيَّة, الْوِلَايَات الْمُتَّحِدَة",
 "北米土人": "اللغة الأمرندية, لغة السكان الأصليين للأمريكيتين (أي من اللغات التي يتحدث بها السكان الأصليون للأمريكيتين (الهنود الحمر))",
 "北米大陸": "أمريكي شمالي (متعلق بقارة أمريكا الشمالية أو دولها أو شعوبها أو مميز لها) / أمريكي شمالي (مواطن أو ساكن في أمريكا الشمالية)",
