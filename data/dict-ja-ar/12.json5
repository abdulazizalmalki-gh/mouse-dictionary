 "どうぐしゅぎ": "أداتية (نظام فلسفي براغماتي يعتبر الفكرة أدوات يجب أن توجه أفعالنا وتقاس قيمتها بنجاحها)",
 "どうぐてき": "أداتِيّ, وَسيلِيّ (يَعْمَل كَوَسيلَة أو أداة لِتَحْقيق غايَة)\nمثال: مؤلفات آلية",
 "どうぐてきじょうけんづけ": "إشراط وسيلي (إشراط إجرائي يقرن استجابة بتعزيز في تجارب منفصلة؛ يحدث التعزيز فقط بعد إعطاء…)",
 "どうぐばこ": "صَنْدُوق اَلْعِدَّة (وعاء كبيرة من الخشب غالبا وقد يكون حديدًا يستخدم لوضع الاشياء داخله، ويكون لها…)\nمثال: أين صندوق البريد؟",
 "どうぐろん": "أداتية (نظام فلسفي براغماتي يعتبر الفكرة أدوات يجب أن توجه أفعالنا وتقاس قيمتها بنجاحها)",
 "どうけ": "دُعابة, مَقلَب (فعل مضحك أو غريب يتم القيام به للمرح والتسلية) / مُهَرِّج",
 "どうけい": "تَابِعٌ, مُلْحَقٌ (مُنْضَمّ في ارتباط وثيق) / شَوْق (نزوعُ النَّفْس إِلى الشيء، أو تَعَلُّقها به؛ مصدر الفعل شَاقَ)\nمثال: سأشعر بالشوق إليك. / تَسَاوِي الشَّكْل, تَمَاثُل بَلُّورِيّ ((في علم الأحياء) تشابه أو تطابق الشكل أو الهيئة أو البنية) / متجه نصف القطر (خط يربط نقطة في الفضاء بأصل نظام إحداثيات قطبي)",
 "どうけいいおんご": "متجانس كتابةً مختلف نطقاً, مجانس خطي (تكون الكلمتان مجانستين خطياً إذا كُتبتا بنفس الطريقة ولكنهما اختلفتا في النطق)",
 "どうけいいぎご": "جناس خطي, مشترك خطي (تكون الكلمتان مشتركتين خطياً إذا كُتبتا بنفس الطريقة واختلفتا في المعنى)",
 "どうけいせつごうたい": "متماثل الزيجوت, متماثل اللاقحة ((علم الوراثة) كائن حي يمتلك أليلين متطابقين لجين معين وبالتالي يتكاثر بصفات…)",
 "どうけいどうおんいぎせい": "اشْتِرَاك لَفْظِيّ, جِنَاس (العلاقة بين كلمتين تكتبان بنفس الطريقة أو تلفظان بنفس الطريقة ولكنهما تختلفان…)",
 "どうけし": "مُهَرِّج",
 "どうけしばい": "فارس, مهزلة (كوميديا تتميز بالسخرية الواسعة والمواقف غير المحتملة)",
 "どうけっせつ": "عقدة جيبية أذينية, ناظمة قلبية (قطعة متخصصة من نسيج القلب تتحكم في ضربات القلب)",
 "どうけつ": "كَهْف, غَار",
 "どうけもの": "مُهَرِّج",
 "どうけやくしゃ": "مُهَرِّج",
 "どうける": "دعابة, مزاح (نشاط يتميز بالمرح والفكاهة)\nمثال: روى نكتة مضحكة جداً",
 "どうけん": "نظرة ثاقبة / مَبْنَى الْوِلَايَة (كل ما بُنِيَ؛ ما يُبْنى على أرضٍ محاطا بالجُدْرَان ومغطى بسَقْف. (تخصيص))\nمثال: دخل توم المبنى.",
 "どうげんたい": "سِنْترومِير, قَسِيم مَرْكَزِيّ\nمثال: من الصعب تحديد تسلسل القسيم المركزي",
 "どうこう": "رَائِج, مُتَدَاوَل / مُتَرَتِّب, مُصَاحِب (يحدث بالتزامن مع شيء آخر أو نتيجةً له) / تِلْمِيذ, تِلْمِيذَة / أَيُّ شَيْءٍ (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك…)\nمثال: لم تقصد أي أذى.",
 "どうこういう": "تَذَمَّرَ, اِشْتَكَى",
 "どうこうかつやくきん": "عضلة عاصرة, مصرة (حلقة من العضلات تنقبض لإغلاق فتحة)",
 "どうこうさんだい": "توسع الحدقة (توسع انعكاسي للحدقة حيث تسحب العضلة القزحية للخارج؛ يحدث استجابة لانخفاض الضوء…)",
 "どうこうしゃ": "صَاحِب, صَاحِبَة (اَلْمُرَافِق، الْمُلَازِمُ، وَلَا يُقَالُ عُرْفاً إِلَّا لِمَنْ كَثُرَتْ…)\nمثال: من صاحب هذه الأرض؟",
 "どうこうしゅくしょう": "تقبض الحدقة, منعكس الضوء (انكماش انعكاسي للعضلة العاصرة للقزحية استجابة لضوء ساطع (أو أدوية معينة) مما…)",
 "どうこうはんしゃ": "تقبض الحدقة, منعكس الضوء (انكماش انعكاسي للعضلة العاصرة للقزحية استجابة لضوء ساطع (أو أدوية معينة) مما…)",
 "どうこう言う": "تَذَمَّرَ, اِشْتَكَى",
 "どうこく": "صراخ, عويل (صرخات عالية أثناء البكاء)",
 "どうこくじん": "مُوَاطِن, مُوَاطِنَة (مَدَنِيّ؛ مُقِيم)\nمثال: أنا مواطن لبناني",
 "どうころんでも": "عَلَى أَيِّ حَالٍ (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال.",
 "どうこん": "شَامِل",
 "どうこんご": "ذُو رَحِمٍ, مِنْ نَفْسِ الدَّمِ (مرتبط بصلة الدم)",
 "どうごはんぷく": "تحصيل حاصل, حشو (تكرار عديم الفائدة وبلا هدف)\nمثال: العبارة 'هو شجاع أو هو غير شجاع' هي تحصيل حاصل",
 "どうさ": "حَرَكَة / رمان بلي, كرسي تحميل (دعامة دوارة توضع بين الأجزاء المتحركة للسماح لها بالحركة بسهولة)\nمثال: وقف بوضعية جيدة / عَمَلِيَّة, عَمَل",
 "どうさかくにん": "التأكيد على الفاعلية\nمثال: رفصنا تصديق ذلك.",
 "どうさかのうじかん": "فترة العمل, وقت التشغيل (فترة زمنية يكون فيها شيء ما (كالآلة أو المصنع) قيد التشغيل ومتاحاً للاستخدام)",
 "どうさきろく": "تَارِيخ, تاريخ (جملة الأَحوال والأحداث التي يمر بها كائن ما، ويَصْدق على الفرد والمجتمع، كما…)\nمثال: ما تاريخ اليوم؟",
 "どうさしゅ": "فَاعِل (الشيء :فعله)\nمثال: تظن الشرطة أن سامي يعلم من الفاعل.",
 "どうさじょうたい": "نَشِيط, عَامِل\nمثال: لقد أوقفنا حركة المرور.",
 "どうさつ": "حسن تقدير, فطنة (سمة الحكم بحكمة وموضوعية)\nمثال: رجل ذو فطنة",
 "どうさつりょく": "نظرة ثاقبة",
 "どうさふりょう": "خلل وظيفي, عطل (فشل في العمل بشكل طبيعي)",
 "どうさゆうこうきかん": "نِظَام (مَنْهَج، طَرِيقَة؛ تَرْتِيب واتِّسَاق)\nمثال: ليس بنظام كامل.",
 "どうさん": "أموال منقولة, ممتلكات شخصية (الممتلكات المنقولة (لتمييزها عن العقارات))",
 "どうざ": "اِنْخِرَاط, مُشَارَكَة (فعل المشاركة في أنشطة المجموعة)\nمثال: حاول المعلم زيادة مشاركة طلابه في الأنشطة الصفية",
 "どうざし": "عارضة (عارضة مصنوعة عادة من الصلب؛ دعامة رئيسية في هيكل)",
 "どうざん": "منجم نحاس (منجم يُستخرج منه النحاس من الأرض)",
 "どうし": "فِعْل (عَمِلَ وصَنَعَ، بعلم أو بدون علم، عن قصد أو دون قصد)\nمثال: ماذا فعل للحمي؟ / حبيب, صديق حميم (رجل هو عشيق لرجل أو امرأة)\nمثال: لو علمت أنه حبيبها لما سألت / رَفِيق, رَفِيقَة / هُوَ / طاوي (متعلق بالنظام الفلسفي الذي طوره لاو تزو وتشوانغ تزو والذي يدعو إلى حياة بسيطة…)\nمثال: معابد طاوية / مُعَلِّم رُوحِيّ, جُورُو (من يمتهن التعليم، مُدَرِّس)\nمثال: هي أصبحت معلمة. / تِلْمِيذ, تِلْمِيذَة",
 "どうしあい": "لحام, لصق (التثبيت بإحكام معاً)",
 "どうしうち": "نِيرَان صَدِيقَة",
 "どうしか": "فِعْل (عَمِلَ وصَنَعَ، بعلم أو بدون علم، عن قصد أو دون قصد)\nمثال: ماذا فعل للحمي؟",
 "どうしく": "عبارة فعلية, مسند (أحد المكونين الرئيسيين للجملة؛ يحتوي المسند على الفعل ومكملاته)",
 "どうしこく": "مُتَوَافِق الرَّأْي (يَتَشابَه في الآراء وَالأَفْكار مَعَ الآخَرين)",
 "どうししょう": "تلصص, تلصصية (انحراف يحصل فيه الشخص على إشباع جنسي من رؤية الأعضاء التناسلية للآخرين أو…)",
 "どうしじょうめいし": "صِيغَةُ فِعْل, مَصْدَر",
 "どうした": "بشكل ما, بطريقة أو بأخرى (بطريقة أو أسلوب غير محدد؛ أو بوسيلة غير محددة)\nمثال: لقد تدبروا الأمر بطريقة ما",
 "どうしたって": "بكل الوسائل, بكل تأكيد (بالتأكيد أو يقيناً)\nمثال: زرنا بكل تأكيد",
 "どうしたわけか": "بشكل ما, بطريقة أو بأخرى (بطريقة أو أسلوب غير محدد؛ أو بوسيلة غير محددة)\nمثال: لقد تدبروا الأمر بطريقة ما / لِمَاذَا\nمثال: لم يساعدني أحد.",
 "どうした訳か": "بشكل ما, بطريقة أو بأخرى (بطريقة أو أسلوب غير محدد؛ أو بوسيلة غير محددة)\nمثال: لقد تدبروا الأمر بطريقة ما / لِمَاذَا\nمثال: لم يساعدني أحد.",
 "どうしつ": "متجانس (كله من نفس النوع أو الطبيعة أو متشابه)\nمثال: مجموعة متجانسة متماسكة",
 "どうしついぞう": "تعدد الأشكال ((في علم الأحياء) وجود شكلين أو أكثر من الأفراد ضمن نفس النوع الحيواني (بشكل…)",
 "どうしつしゃ": "رَفِيق السَّكَن",
 "どうしつてき": "متجانس (كله من نفس النوع أو الطبيعة أو متشابه)\nمثال: مجموعة متجانسة متماسكة",
 "どうして": "كَيْف, ازاي / لِمَاذَا\nمثال: لم يساعدني أحد.",
 "どうしてき": "أَنِيس, مُؤْنِس (يوحي بالصُّحْبَة والمؤانسة)",
 "どうしても": "بكل الوسائل, بكل تأكيد (بالتأكيد أو يقيناً)\nمثال: زرنا بكل تأكيد / طَوْعًا أَوْ كَرْهًا, شاءَ مَن شاءَ وَأَبَى مَن أَبَى / أَبَدًا / أخيراً, في الختام (كنتيجة نهائية لتتابع أو عملية)\nمثال: في النهاية كان عليه الاستسلام",
 "どうしゅ": "قَائِدُ فِرْقَاتٍ مُوسِيقِيَّةٍ",
 "どうしゅいしょく": "طعم مباين (نسيج أو عضو يُنقل من متبرع من نفس النوع ولكن بتركيب وراثي مختلف؛ يجب قمع الجهاز…)",
 "どうしゅう": "زَمِيل سَفِينَة (شريك معك على نفس السفينة)",
 "どうしゅつ": "استمداد, اشتقاق (فعل اشتقاق شيء أو الحصول عليه من مصدر أو أصل)",
 "どうしゅりょうほう": "مُعَالَجَة مَثَلِيَّة",
 "どうしょ": "شُرْطَة",
 "どうしょう": "أساس الطريق (طبقة أساس تدعم طريقاً) / ميدالية برونزية (كأس مصنوعة من البرونز (أو لها مظهر البرونز) تمنح عادة للفائز بالمركز الثالث في…)",
 "どうしょく": "نحاسي (لون بني محمر يشبه لون النحاس المصقول)",
 "どうしょせい": "توطن مشترك (وجود الكائنات الحية في مناطق جغرافية متداخلة، ولكن دون تزاوج)",
 "どうしようもない": "هُنَاكَ, يُوجَدُ",
 "どうしるい": "متشابهات الأجنحة (حشرات لها أجنحة أمامية وخلفية غشائية)",
 "どうしん": "تداخل مركزي, تمركز (صفة امتلاك نفس المركز (مثل دوائر داخل بعضها البعض)) / إجماع تام (أن يكون الجميع على رأي واحد) / شرطي (عضو ذكر في قوة الشرطة) / بَسَاطَة, سَذَاجَة (نقص في التطور أو الخبرة الدنيوية) / حس أخلاقي, ضمير (دافع نابع منطقياً من مبادئ أخلاقية تحكم أفكار الشخص وتصرفاته)",
 "どうしんえんじょう": "متحد المركز (له مركز مشترك)\nمثال: حلقات متحدة المركز",
 "どうじ": "مُتَزَامِن / فَتًى, غُلَام (شَابٌّ أوَّلَ شبابه بين المراهقة والرُّجولة؛ عبد، خادم)\nمثال: ترى الفتاة الفتى.",
 "どうじく": "محور حي, محور دافع (محور مركبة ذاتية الدفع الذي يوفر قوة القيادة) / مُتَحَاوِر, مُشْتَرِكُ المِحْوَرِ (لَهُ مِحْوَرٌ مُشْتَرَك)",
 "どうじくケーブル": "كابل محوري (خط نقل للإشارات عالية التردد)",
 "どうじせい": "تزامن, توقيت واحد (حدوث أو وجود أو فعل في نفس الوقت)",
 "どうじたはつてき": "فِي نَفْس اَلْوَقْت (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "どうじつうやく": "تَرْجَمَة فَوْرِيَّة (شرح الكِتَاب أو توضيحه؛ تحويل الكلام من لغة إلى أخرى كي يفهمه قوم آخرون)\nمثال: أنا مدرس للترجمة.",
 "どうじに": "فِي نَفْس اَلْوَقْت (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "どうじはつおんすう": "بوليفونية, تعدد الأصوات (موسيقى مرتبة في أجزاء لعدة أصوات أو أدوات)",
 "どうじほうそう": "بث متزامن (بث يتم نقله في وقت واحد عن طريق الراديو والتلفزيون)",
 "どうじめ": "حِزَام, زُنَّار (خيط أو قطعة من جلد تستخدم لحَزْم النَبَات أو العِيدَان أو غيرها لتكوين حُزْمَة…)\nمثال: هذا حزام من الجلد.",
 "どうじゃく": "ذُهُول, دَهْشَة",
 "どうじゅうたい": "خط تساوي الضغط ((أرصاد جوية) خط تساوي يربط النقاط ذات الضغط الجوي المتساوي في وقت معين)",
 "どうじょ": "بِنْت\nمثال: أنا أري الفتاة.",
 "どうじょう": "أيضاً, علامة التكرار (علامة تُستخدم للإشارة إلى تكرار الكلمة الموجودة أعلاها) / تَعَاطُف / ماندا (لغة درافيدية يتم التحدث بها في جنوب وسط الهند، وتحديداً في أوديشا) / على الطريق, في جولة (التجوال في الأرجاء)\nمثال: أخذوا العرض في جولة",
 "どうじょうしゃ": "مؤيد, متعاطف (شخص يشاركك مشاعرك أو آرائك ويأمل أن تنجح)",
 "どうじょうしん": "تَعَاطُف",
 "どうじょうみゃく": "شرياني وريدي (يوصل شرياناً بوريد)\nمثال: ناسور شرياني وريدي",
 "どうじる": "وَافَقَ (صَادَفَ؛ صَادَقَ)\nمثال: وافق ماثيو بتردد.",
 "どうじん": "بطانة, زمرة (دائرة حصرية من الناس ذات هدف مشترك)",
 "どうじんゲーム": "لَعْبَةْ فِيدِيُو (اللَعْبَة البَرْبَرية دواء عشبيّ)\nمثال: عنده لعبة يويو.",
 "どうすいかん": "شِيشَة, أرجيلة",
 "どうずる": "وَافَقَ (صَادَفَ؛ صَادَقَ)\nمثال: وافق ماثيو بتردد.",
 "どうせ": "عَلَى أَيِّ حَالٍ (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال.",
 "どうせい": "مُسَاكَنَة / وَضْع (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه)\nمثال: لقد أزمت الوضع. / شَقِيق, شَقِيقَة (كل ما شُقَّ نصفين فكل من النصفين شقيق الآخر؛ الأخ من نفس الأم والأب)\nمثال: لا أحد هناك عرف أن توم هو شقيق ماري.",
 "どうせいあい": "مِثْلِيَّة, مِثْلِيَّة جِنْسِيَّة",
 "どうせいあいけんお": "رُهَاب اَلْمِثْلِيَّة, هُومُوفُوبِيَا",
 "どうせいあいしゃ": "مِثْليّ, مِثْليّ الجنس",
 "どうせいあいしゃかいほううんどう": "حركة تحرير المثليين (الحركة التي تهدف إلى تحرير المثليين من القمع القانوني أو الاجتماعي أو الاقتصادي)",
 "どうせいかんけっこん": "أسرة مثلية, زوجان مثليان (شخصان من نفس الجنس يعيشان معاً كأسرة)\nمثال: كان الوضع القانوني لزواج المثليين مثار جدل ساخن",
 "どうせいけっこん": "أسرة مثلية, زوجان مثليان (شخصان من نفس الجنس يعيشان معاً كأسرة)\nمثال: كان الوضع القانوني لزواج المثليين مثار جدل ساخن",
 "どうせいこん": "أسرة مثلية, زوجان مثليان (شخصان من نفس الجنس يعيشان معاً كأسرة)\nمثال: كان الوضع القانوني لزواج المثليين مثار جدل ساخن",
 "どうせき": "حُضُور (فعل التواجد (في اجتماع أو حدث إلخ))\nمثال: زاد الحضور بنسبة 50 في المائة",
 "どうせきしゃ": "صَاحِب, صَاحِبَة (اَلْمُرَافِق، الْمُلَازِمُ، وَلَا يُقَالُ عُرْفاً إِلَّا لِمَنْ كَثُرَتْ…)\nمثال: من صاحب هذه الأرض؟",
 "どうせだから": "لِمَ لَا (جَمَعَ، ضَمَّ)\nمثال: لم يساعدني أحد.",
 "どうせん": "سلك, سلك موصل (موصل معدني يحمل الكهرباء لمسافة)",
 "どうぜい": "طَرَف",
 "どうぜん": "أيضاً, علامة التكرار (علامة تُستخدم للإشارة إلى تكرار الكلمة الموجودة أعلاها)",
 "どうそうせい": "زميل دراسة, زميل صف (معرفة تذهب معه إلى المدرسة)",
 "どうそうば": "سعر السوق, قيمة سوقية (السعر الذي يتبادل به المشترون والبائعون السلعة في سوق مفتوح)",
 "どうそたい": "تآصل, شكل تآصلي (شكل مختلف هيكلياً لعنصر ما)\nمثال: الجرافيت والماس هما متآصلان للكربون",
 "どうぞ": "أَرْضَى, أَعْجَبَ\nمثال: يا لها من جملة! / بكل الوسائل, بكل تأكيد (بالتأكيد أو يقيناً)\nمثال: زرنا بكل تأكيد / تَفَضَّل, تَفَضَّلِي / أَعْطَى, وَهَبَ (مَنَحَ، نَوَّلَ)\nمثال: أعطى بلده حياته.",
 "どうぞく": "متجانس, متماثل (متوافق أو مشابه في الموقع أو البنية أو الوظيفة أو الخصائص؛ وخاصة المشتقة من…)\nمثال: طعم نسيجي متماثل",
 "どうぞくかんけい": "قَرَابَة عَصَب, قَرَابَة دَم",
 "どうぞよろしく": "تَشَرَّفْنَا, فُرْصَة سَعِيدَة / أَطْيَب التَّمَنِّيَات (تعبير عن الأمل في سعادة أو رفاهية شخص ما في المستقبل)\nمثال: أرسلنا أطيب تمنياتنا بالشفاء العاجل",
 "どうぞ宜しく": "تَشَرَّفْنَا, فُرْصَة سَعِيدَة / أَطْيَب التَّمَنِّيَات (تعبير عن الأمل في سعادة أو رفاهية شخص ما في المستقبل)\nمثال: أرسلنا أطيب تمنياتنا بالشفاء العاجل",
 "どうたい": "حَرَكَة / قَائِدُ فِرْقَاتٍ مُوسِيقِيَّةٍ / جِذْع (في علم النبات: أحد أجزاء النبات الذي يحمل الأغصان ويتصل في أسفله بالجذر)\nمثال: أين صندوق البريد؟ / بَدَن, جِسْم ((بَدُنَ) الرَّجُلُ مِنْ بَابِ ظَرُفَ وَ (بُدْنًا) أَيْضًا بِوَزْنِ قُفْلٍ أَيْ…) / فِي وَقْت وَاحِد, مَعًا (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "どうたいに": "مَعًا, سَوِيًّا",
 "どうたく": "جَرَسِيُّ الشَّكْل, نَاقُوسِيّ (ذو شكل محدّب يشبه الجرس)",
 "どうたら": "فُلَان, فُلَانَة (كلمة تستخدم لوصف شخص ما بدون ذكر من هو، غالبًا يقصد به \"أي شخص من الناس\"، أو…)\nمثال: سمعنا ذلك من فلان و فلان.",
 "どうたらこうたら": "فُلَان, فُلَانَة (كلمة تستخدم لوصف شخص ما بدون ذكر من هو، غالبًا يقصد به \"أي شخص من الناس\"، أو…)\nمثال: سمعنا ذلك من فلان و فلان.",
 "どうだっていい": "عَدِيم الأَهَمِّيَّة, لَا قِيمَة لَهُ (يفتقر إلى القيمة أو الأهمّيّة)\nمثال: 君の考えなどはどうだっていいことだ。 — لا يهتم أحد برأيك. / أَيّ, أَيَّمَا (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك…)\nمثال: لم تقصد أي أذى.",
 "どうだってよい": "عَدِيم الأَهَمِّيَّة, لَا قِيمَة لَهُ (يفتقر إلى القيمة أو الأهمّيّة)\nمثال: 君の考えなどはどうだっていいことだ。 — لا يهتم أحد برأيك. / أَيّ, أَيَّمَا (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك…)\nمثال: لم تقصد أي أذى.",
 "どうだって良い": "عَدِيم الأَهَمِّيَّة, لَا قِيمَة لَهُ (يفتقر إلى القيمة أو الأهمّيّة)\nمثال: 君の考えなどはどうだっていいことだ。 — لا يهتم أحد برأيك. / أَيّ, أَيَّمَا (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك…)\nمثال: لم تقصد أي أذى.",
 "どうだん": "نَفْسَهُ, نَفْسَهَا",
 "どうち": "قَابِلِيَّة لِلْمُقَارَنَة, مُضَاهَاة (السمات التي يمكن مقارنتها)\nمثال: لا توجد مقارنة بين الكتابين",
 "どうちゃく": "تَنَاقُضٌ",
 "どうちゃくごほう": "أوكسيمورون, تضاد ظاهري (الجمع بين مصطلحات متناقضة)",
 "どうちゃくむじゅん": "تناقض ذاتي (مناقضة النفس)",
 "どうちゅう": "رِحْلَة, سَفَر / فِي الطَّرِيق (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "どうちゅうごぶじに": "رِحْلَة سَعِيدَة, رِحْلَة مُوَفَّقَة",
 "どうちょう": "اِمْتِثَال, تَوَافُق (التصرف وفقاً لمعايير معينة مقبولة)\nمثال: بياناتهم المالية متوافقة مع الممارسات المحاسبية المقبولة عموماً / توليف, دوزنة ((موسيقى) معايرة شيء ما (آلة أو دائرة إلكترونية) لتردد قياسي)",
 "どうちょうあつりょく": "مجموعة الأقران (المعاصرون من نفس الوضع الاجتماعي)",
 "どうちょうかいろ": "دائرة رنين, رنان (دائرة كهربائية تجمع بين السعة والمحاثة بطريقة تجعل التذبذب الكهربائي الدوري يصل…)",
 "どうちょうしゃ": "مؤيد, متعاطف (شخص يشاركك مشاعرك أو آرائك ويأمل أن تنجح)",
 "どうつう": "توصيل, موصلية (انتقال الحرارة أو الكهرباء أو الصوت)",
 "どうつうていこう": "مُقَاوَمَة",
 "どうつきながくつ": "حذاء الخوض, خوّاضة (أحذية طويلة تصل للفخذ مقاومة للماء (تمتد أحياناً إلى الصدر) يرتديها الصيادون)",
 "どうつきのこ": "منشار مقوى الظهر (منشار يدوي مدعم بتقوية معدنية على طول الحافة العلوية)",
 "どうつきのこぎり": "منشار مقوى الظهر (منشار يدوي مدعم بتقوية معدنية على طول الحافة العلوية)",
 "どうづき": "مِدَكّ (أداة لدفع شيء بقوة) / منشار مقوى الظهر (منشار يدوي مدعم بتقوية معدنية على طول الحافة العلوية)",
 "どうづきのこ": "منشار مقوى الظهر (منشار يدوي مدعم بتقوية معدنية على طول الحافة العلوية)",
 "どうてい": "بِطَاقَة هُوِيَّة / بَكَارَة, بَتُولِيَّة / رَاهِبَة / بُعْد (يدل على اللحاق في الزمان؛ يكون مضافا، وينصب أو يجر)\nمثال: و بعد قليل أتى. / طَرِيق, صِرَاط (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من…)\nمثال: أسأل عن الطريق.",
 "どうていせいしょく": "توالد ذكري (توالد عذري ذكري يحتوي فيه الجنين على كروموسومات الأب فقط بسبب فشل نواة البويضة…)",
 "どうていせつ": "الحَمْل بِلَا دَنَس",
 "どうてき": "حَرَكِيّ ((يستخدم للأفعال والصفات المشتقة) يعبر عن فعل بدلاً من حالة كينونة)\nمثال: سوق ديناميكي",
 "どうてきけいかくほう": "شخص بلا جنسية, نازح (شخص أجبر على الفرار من منزله أو بلده)",
 "どうてきアドレスへんかん": "شريط صوتي رقمي (تسجيل رقمي للصوت على شريط)",
 "どうてきアドレスへんかんきこう": "شريط صوتي رقمي (تسجيل رقمي للصوت على شريط)",
 "どうてついぎご": "جناس خطي, مشترك خطي (تكون الكلمتان مشتركتين خطياً إذا كُتبتا بنفس الطريقة واختلفتا في المعنى)",
 "どうてん": "تَحَوُّل, نَقِل (صَارَ غير ما كان)\nمثال: تحول ياني إلى وحش. / جمود, طريق مسدود (وضع لا يمكن فيه إحراز تقدم أو لا يمكن فيه أي تقدم)\nمثال: وصلوا إلى طريق مسدود في المفاوضات",
 "どうてんけっしょうせん": "شوط كسر التعادل (لعب إضافي من أجل كسر التعادل؛ مثل التنس وكرة القدم)",
 "どうてんゴール": "هدف التعادل (تسجيل يجعل النتيجة متساوية)",
 "どうであれ": "بِأَيَّةِ طَرِيقَة, عَلَى كُلِّ حَال",
 "どうであろうと": "أَيّ, أَيَّمَا (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك…)\nمثال: لم تقصد أي أذى.",
 "どうでも": "عَلَى كُلِّ حَال, على كل حال (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال. / بكل الوسائل, بكل تأكيد (بالتأكيد أو يقيناً)\nمثال: زرنا بكل تأكيد",
 "どうでもいい": "عَدِيم الأَهَمِّيَّة, لَا قِيمَة لَهُ (يفتقر إلى القيمة أو الأهمّيّة) / أَيّ, أَيَّمَا (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك…)\nمثال: لم تقصد أي أذى.",
 "どうでもよい": "عَدِيم الأَهَمِّيَّة, لَا قِيمَة لَهُ (يفتقر إلى القيمة أو الأهمّيّة) / أَيّ, أَيَّمَا (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك…)\nمثال: لم تقصد أي أذى.",
 "どうでも良い": "عَدِيم الأَهَمِّيَّة, لَا قِيمَة لَهُ (يفتقر إلى القيمة أو الأهمّيّة) / أَيّ, أَيَّمَا (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك…)\nمثال: لم تقصد أي أذى.",
 "どうでん": "توصيل, موصلية (انتقال الحرارة أو الكهرباء أو الصوت)",
 "どうでんせい": "توصيل, موصلية (انتقال الحرارة أو الكهرباء أو الصوت)",
 "どうでんたい": "قَائِدُ فِرْقَاتٍ مُوسِيقِيَّةٍ",
 "どうでんど": "توصيل, موصلية (انتقال الحرارة أو الكهرباء أو الصوت)",
 "どうでんりつ": "توصيل, موصلية (انتقال الحرارة أو الكهرباء أو الصوت)",
 "どうと": "طَرِيق, سِكَّة (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من…)\nمثال: أسأل عن الطريق. / حَادِث إِصْطِدَام\nمثال: يوشك الجسر على الانهيار.",
 "どうとう": "مُسَاوَاة / مَعْبَد",
 "どうとく": "أخلاق, دافع أخلاقي (دافع يستند إلى مبادئ الصواب والخطأ)",
 "どうとくかんかく": "حس أخلاقي, ضمير (دافع نابع منطقياً من مبادئ أخلاقية تحكم أفكار الشخص وتصرفاته)",
 "どうとくかんねん": "حس أخلاقي, ضمير (دافع نابع منطقياً من مبادئ أخلاقية تحكم أفكار الشخص وتصرفاته)",
 "どうとくがく": "أخلاق, فلسفة أخلاقية (الدراسة الفلسفية للقيم والقواعد الأخلاقية)",
 "どうとくきょう": "داوديجنغ",
 "どうとくげき": "مسرحية أخلاقية (مسرحية رمزية شاعت في القرنين الخامس عشر والسادس عشر؛ حيث تجسد الشخصيات الفضائل…)",
 "どうとくしゅぎ": "حكم أخلاقي, وعظ أخلاقي (أحكام حول أخلاق شخص آخر)\nمثال: لم يستطع تحمل وعظها الأخلاقي المتسلط",
 "どうとくしん": "حس أخلاقي, ضمير (دافع نابع منطقياً من مبادئ أخلاقية تحكم أفكار الشخص وتصرفاته)",
 "どうとくじょう": "أخلاقياً (فيما يتعلق بالمبادئ الأخلاقية)\nمثال: غير مبرر أخلاقياً / أَخْلَاقِيّ",
 "どうとくせい": "أَخْلَاق, أَخْلَاقِيَّة",
 "どうとくてき": "أَخْلَاقِيّ",
 "どうとくてききけん": "خطر أخلاقي ((في الاقتصاد) غياب الحافز للحماية من المخاطر عندما تكون محمياً منها (كما هو…)\nمثال: تتعرض شركات التأمين لخطر أخلاقي إذا لم يكن الطرف المؤمن عليه نزيهاً",
 "どうとくてつがく": "أخلاق, فلسفة أخلاقية (الدراسة الفلسفية للقيم والقواعد الأخلاقية)",
 "どうど": "حَادِث إِصْطِدَام\nمثال: يوشك الجسر على الانهيار.",
 "どうどう": "مُتَرَتِّب, مُصَاحِب (يحدث بالتزامن مع شيء آخر أو نتيجةً له) / عَظِيم, رَائِع (خلاف الصَغِيْر، الكَبِيْر؛ نقيض الحَقِير)\nمثال: الصين بلد عظيم. / أَشْقَر (هو لون الشُقْرَة، وأصله اللون الأحمر المائل إلى الصُفرة ثم أصبح يطلق على ما كان…)\nمثال: أنا لديها شعر بني كستنائي, ولكن ماجدالينا لديها شعر أشقر. / بعظمة, بفخامة (بأسلوب فخم وعظيم)\nمثال: بدا القصر كبيراً بعظمة مقارنة بمعايير اليوم / مِن اَلْعَدْل, بِالْعَدْل (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "どうどくりょうほう": "مُعَالَجَة مَثَلِيَّة",
 "どうなか": "جِذْع (في علم النبات: أحد أجزاء النبات الذي يحمل الأغصان ويتصل في أسفله بالجذر)\nمثال: أين صندوق البريد؟",
 "どうながたんそく": "طَوِيلُ الجَسَد (لَهُ جَسَدٌ طَوِيلٌ نِسْبِيًّا)",
 "どうなることやら": "هُنَاكَ, يُوجَدُ",
 "どうなん": "غُلَام, صَبِيّ",
 "どうにか": "بِطَرِيقَةٍ أَو بِأُخرَى",
 "どうにかして": "بشكل ما, بطريقة أو بأخرى (بطريقة أو أسلوب غير محدد؛ أو بوسيلة غير محددة)\nمثال: لقد تدبروا الأمر بطريقة ما",
 "どうにかなりそう": "مَجْنُون, مَخْبُول",
 "どうにも": "أبداً / بشكل رهيب, جداً (تستخدم للتوكيد)\nمثال: مثير للاهتمام جداً",
 "どうにもこうにも": "أبداً",
 "どうにもならない": "مَيْئُوس مِنْه ((غير رسمي للتأكيد) يتجاوز أي أمل في الإصلاح أو المعالجة)\nمثال: في عذاب من الحزن الميؤوس منه",
 "どうにゅう": "مُقَدَّمَة\nمثال: هل لديه بطاقة شخصية (هوية شخصية - بطاقة تعريف)",
 "どうにゅうぶ": "مُقَدَّمَة\nمثال: هل لديه بطاقة شخصية (هوية شخصية - بطاقة تعريف) / رَصَاص",
 "どうにょ": "بِنْت\nمثال: أنا أري الفتاة.",
 "どうにん": "بطانة, زمرة (دائرة حصرية من الناس ذات هدف مشترك)",
