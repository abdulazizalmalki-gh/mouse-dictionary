 "でないと": "بِدُونِ, بِلَا",
 "でなおす": "عَفْواً!\nمثال: ماذا تريد الآن؟",
 "でなくてなんだろう": "إِلَّا (حرف استثناء؛ في : للسؤال المنفي، مرادف لبَلَى في الفصحى)\nمثال: لا أعرف إلا هذا.",
 "でなくて何だろう": "إِلَّا (حرف استثناء؛ في : للسؤال المنفي، مرادف لبَلَى في الفصحى)\nمثال: لا أعرف إلا هذا.",
 "でなければ": "بِدُونِ, بِلَا",
 "での": "فِي (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي. / مَعَ (يفيد الاجتماع والمصاحبة؛ مكان الاجتماع)\nمثال: جئت مع أصدقائي. / مِنْ (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "では": "آنَذَاكَ, حِينَئِذٍ\nمثال: ثم هناك مشكلة؛ / صَوْب, ناحية (أحد جانبي المدينة التي يقسمها نهر، ومن ذلك صوب الكرخ وصوب الرصافة في بغداد…)\nمثال: صوب الرجل مسدسا نحو المحققين. / إِلَّا (حرف استثناء؛ في : للسؤال المنفي، مرادف لبَلَى في الفصحى)\nمثال: لا أعرف إلا هذا. / فُرْصَة / دعم, مرافقة (جزء موسيقي (صوتي أو آلي) يدعم أو يوفر خلفية لأجزاء موسيقية أخرى)",
 "ではある": "كَانَ (اِتَّصَفَ. (فعل ناقص)؛ حَدَثَ)\nمثال: كان الكلب ميتا.",
 "ではいり": "مُتَكَرِّر / تَذَبذُب, تَقَلُّب / عَارَكَ, قَاتَلَ\nمثال: لن يحل القتال أي شيء. / تحزيز, تسنين (عملية القطع في حافة بشقوق تشبه الأسنان أو شقوق زاوية)",
 "ではじめ": "إطلاق, تدشين (فعل البدء بشيء جديد)\nمثال: تطلعوا إلى الظهور الأول لخط إنتاجهم الجديد",
 "ではずれ": "نِهَايَة, غَايَة\nمثال: انتهى أمر زيري.",
 "ではでは": "آنَذَاكَ, حِينَئِذٍ\nمثال: ثم هناك مشكلة؛",
 "ではな": "استهلال, انطلاق (الوقت الذي يفترض أن يبدأ فيه شيء ما)\nمثال: بدأوا بداية مبكرة",
 "ではなしに": "بِدُونِ, بِلَا",
 "ではまた": "إِلَى اللِّقَاء, أَرَاكَ لَاحِقًا (حرف جر يُفيد الغاية الزمنية؛ حرف جر يُفيد الغاية المكانية)\nمثال: تعال إلى منزلي.",
 "でば": "بروز الفك العلوي, تراكب العضة ((طب الأسنان) سوء إطباق تمتد فيه الأسنان العلوية بشكل غير طبيعي فوق الأسنان…) / مَصْدَر, مَصَادِر (مَصْدَر)\nمثال: ما مصدر هذا الخوف؟",
 "でばかめ": "مُتَلَصِّص",
 "でばがめ": "مُتَلَصِّص",
 "でばしょ": "مَصْدَر, مَصَادِر (مَصْدَر)\nمثال: ما مصدر هذا الخوف؟",
 "でばすずめだい": "أخضر مزرق, فيروزي غامق (لون أو صبغة زرقاء مخضرة)\nمثال: طلوها بدرجة فاتحة من الأزرق المخضر",
 "でばな": "استهلال, انطلاق (الوقت الذي يفترض أن يبدأ فيه شيء ما)\nمثال: بدأوا بداية مبكرة",
 "でばり": "إِسْقَاط\nمثال: دفنت في مسقط رأسها.",
 "でばる": "مَشْرُوع (ما تُجِيزُه السلطة أو القانون أو أي قاعدة، جَائِز، قَانُونِيّ؛ مسعى مؤقت أي شيء…)\nمثال: هذا مشروع عظيم.",
 "でび": "قَضِيب, ذَكَر",
 "でふ": "كَانَ (اِتَّصَفَ. (فعل ناقص)؛ حَدَثَ)\nمثال: كان الكلب ميتا.",
 "でぶ": "سَمِين, بَدِين\nمثال: توم بدهن غرفته. / بدين, سمين (شخص مستدير الجسم)",
 "でぶしょう": "بَيْتُوتِيّ (شخص نادراً ما يذهب إلى أي مكان؛ شخص لا يميل للتجول أو السفر)",
 "でぶちん": "بدين, سمين (شخص مستدير الجسم)",
 "でぶっちょ": "دسم, دهني (يحتوي على أو يتكون من الدهون)\nمثال: طعام دسم",
 "でぶでぶ": "سَمِين, بَدِين\nمثال: توم بدهن غرفته.",
 "でほうだい": "هُرَاء, لَغْو",
 "でまど": "نافذة بارزة (نافذة تبرز من الجدار الخارجي للمنزل)",
 "でまわり": "زَوَّدَ (زَوَّدَ (زوده): أزاده. ويقال زودته كتابا إلى فلان؛ زَوَّدَ(هـ) بكذا: أمده به)",
 "でみず": "طُوفَان, فَيَضَان (عاصفة)",
 "でみせ": "فَرْع, غُصْن / مَعْلِف, مُرَاح",
 "でむかえ": "اِسْتَقْبَلَ, اِسْتَلَمَ (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه)\nمثال: استقبل توم الضيوف.",
 "でむかえる": "لَاقَى, لَقِيَ (لَقِيَ، صَادَفَ)\nمثال: لقد التقى بماري.",
 "でむく": "رَئِيس, رَئِيسَة",
 "でめきん": "تِلِسْكُوب, مِقْرَاب",
 "でも": "لٰكِن, لٰكِنَّ (يفيد الاستدراك ويسبقه نفي أو نهي ويليه اسم مفرد؛ يفيد الاستدراك)\nمثال: لكن لديك أطفال. / مُسَطَّح, مُنبَسِط\nمثال: انتظر حتى أجلس. / بِأَيَّةِ طَرِيقَة, عَلَى كُلِّ حَال / زائف",
 "でもいしゃ": "بَطْبَطَة, زَبْط",
 "でもって": "إِضَافَةً عَلى ذٰلِكَ / بِجَانِب, جنب (بجانب)\nمثال: زيري بجانب الحوض.",
 "でもの": "طَفْح, طَفْح جِلْدِيّ / صَفْقَة (عَقْد، اتِّفَاق؛ ضرب اليدين عند العقد)\nمثال: إنها صفقة جيدة. / حَبَقَ, ضَرَطَ (الحَبِق : ضراط المَعز ، تقول : حبَقت تحْبِق حَبْقاً وحَبِقاً ، وقد تستعمل في…)",
 "でも医者": "بَطْبَطَة, زَبْط",
 "でよう": "مَوْقِف, سُلُوك",
 "でら": "جِدًّا (كلمة \"جدا\" لها معانٍ متعددة؛ يرتبط المعنى بالعطاء والكرم، سواء بالمنح أو طلبه)\nمثال: إنها غالية جدا!",
 "でる": "تَرَكَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد…)\nمثال: لقد ترك لك هذا. / بَلَغَ / ظَهَرَ (مصدر للفعل ظَهَرَ؛ خلاف البَطْن، الجزء الظَاهِر من الشيئ وغير البَاطِن)\nمثال: عنده حقيبة ظهر. / حَضَرَ (حضر: الحُضورُ: نَقِيضُ المَغيب والغَيْبةِ؛ حَضَرَ يَحْضُرُ حُضُورًا وحِضَارَةً…)\nمثال: حضر كل شيئ لرحلتي.",
 "でれ": "جِدًّا (كلمة \"جدا\" لها معانٍ متعددة؛ يرتبط المعنى بالعطاء والكرم، سواء بالمنح أو طلبه)\nمثال: إنها غالية جدا!",
 "でれっと": "مُتَرَاخٍ, مُتَسَاهِل (يَفْتَقِر إِلَى الصَّرَامَة أَوِ الدِّقَّة)\nمثال: قام بسحب الجزء المرتخي / مَسْلُوبُ العَقْل, مَمْسُوسٌ بِالقَمَر (مجنون ويُعتَقد أنّ جنونه مرتبط بأطوار القمر)",
 "でれつく": "عَاطِل عَن اَلْعَمَل / غزل, ملاطفة (سلوك مرح يهدف إلى إثارة الاهتمام الجنسي)",
 "でれでれ": "بطالة, تسكع (عدم القيام بعمل أو وظيفة) / غزل, ملاطفة (سلوك مرح يهدف إلى إثارة الاهتمام الجنسي)",
 "でゎでゎ": "آنَذَاكَ, حِينَئِذٍ\nمثال: ثم هناك مشكلة؛",
 "でわでわ": "آنَذَاكَ, حِينَئِذٍ\nمثال: ثم هناك مشكلة؛",
 "でん": "أُسْطُورَة\nمثال: بحث عن المفتاح. / سِيرَة, تَرْجَمَةُ ٱلْحَيَاةِ / طَرِيقَة, مِنْهَج / قَاعَة, صَالَة",
 "でんあつ": "جُهْد, فُولْتِيَّة (بَذَلَ قُصَارَى جُهْدِهِ فِي أَمْرٍ مَا؛ أَتْعَبَ نَفْسَهُ أو غَيْرَهُ بِعَمَلٍ…)\nمثال: لا إنجاز بلا جهد .",
 "でんあつけい": "مِقْياس الْجُهْد الْكَهْرَبَائِيّ, مِقْياس الْفُولْت",
 "でんあつこうか": "هبوط الجهد (انخفاض في الجهد الكهربائي على طول موصل يتدفق خلاله تيار)",
 "でんあつていか": "انقطاع الكهرباء, تعتيم (الظلام الناتج عن إطفاء الأنوار (كما في مدينة غير مرئية لطائرات العدو))",
 "でんい": "جهد كهربائي, فرق الجهد (الفرق في الشحنة الكهربائية بين نقطتين في دائرة معبراً عنه بالفولت)",
 "でんいけい": "إلكترومتر, مقياس الكهرباء (مقياس لقياس فروق الجهد الكهروستاتيكي؛ لا يسحب تياراً من المصدر)",
 "でんいさ": "جهد كهربائي, فرق الجهد (الفرق في الشحنة الكهربائية بين نقطتين في دائرة معبراً عنه بالفولت)",
 "でんいさけい": "مقياس الجهد الانزلاقي",
 "でんえい": "فِلْم (شريط من السِّلِيلُوز تعلوه قشرة من الجلاتين ومن برومور الفِضَّة يستعمل للتصوير…)\nمثال: استمر الفلم ساعتين. / بَرْق (بَرَقَ الرجلُ: تَهَدّدَ وتَوَعَّدَ، كأَبْرَقَ؛ بَرَقَ الشيءُ بَرْقاً وبَريقاً…)\nمثال: البرق يسبق الرعد",
 "でんえん": "دَوْلَة, بَلَد (بَلَد يتميز بحُدُود معروفة وشَعْب وحُكُومَة ومُؤَسَسَات مُنَظَّمَة؛ مجموعة من…)\nمثال: لبنان دولة صغيرة. / أرض زراعية, أرض محروثة (أرض صالحة للزراعة يتم حرثها وزرعها وإنتاج المحاصيل منها)",
 "でんおん": "دَوْلَة, بَلَد (بَلَد يتميز بحُدُود معروفة وشَعْب وحُكُومَة ومُؤَسَسَات مُنَظَّمَة؛ مجموعة من…)\nمثال: لبنان دولة صغيرة. / أرض زراعية, أرض محروثة (أرض صالحة للزراعة يتم حرثها وزرعها وإنتاج المحاصيل منها)",
 "でんおんせいなんちょう": "فقدان السمع التوصيلي (فقدان السمع بسبب مشاكل في عظام الأذن الوسطى)",
 "でんおんなんちょう": "فقدان السمع التوصيلي (فقدان السمع بسبب مشاكل في عظام الأذن الوسطى)",
 "でんか": "إرث عائلي, تحفة متوارثة (شيء كان موجوداً في العائلة لأجيال) / سُمُوُّكَ, سُمُوُّكِ / إمداد بالكهرباء, كهربة (فعل توفير الكهرباء)\nمثال: كهربة ريف تينيسي / شِحْنَة كَهْرَبَائِيَّة",
 "でんかい": "تحليل كهربائي لإزالة الشعر (إزالة الشعر الزائد أو غير المرغوب فيه عن طريق تمرير تيار كهربائي عبر جذر الشعرة) / حقل كهربائي (ذهب أو حدث بسرعة أو دون توقف؛ في بعض اللهجات: تعني تحرك سريعاً أو اهتزّ)\nمثال: يعمل الفلاحون في الحقل.",
 "でんかいこうかトランジスタ": "ترانزستور تأثير المجال, فيت (ترانزستور يتدفق فيه معظم التيار في قناة يمكن التحكم في مقاومتها الفعالة بواسطة…)",
 "でんかいこうかトランジスター": "ترانزستور تأثير المجال, فيت (ترانزستور يتدفق فيه معظم التيار في قناة يمكن التحكم في مقاومتها الفعالة بواسطة…)",
 "でんかいしつ": "إلكتروليت, كهرل (محلول يوصل الكهرباء)\nمثال: الكمية والتوزيع المناسب للإلكتروليتات في الجسم ضروري للصحة",
 "でんかいそう": "خلية تحليل كهربائي (خلية تحتوي على إلكتروليت يتسبب الجهد المطبق فيه بحدوث تفاعل لا يحدث لولاه (مثل…)",
 "でんかいほうしゅつ": "انبعاث مجالي (انبعاث الإلكترونات التي تنتزع من الذرات الأم بواسطة مجال كهربائي عالٍ)",
 "でんかいコンデンサー": "مكثف إلكتروليتي, مكثف كيميائي (مكثف ثابت يتكون من قطبين يفصل بينهما إلكتروليت)",
 "でんかく": "قَصْر, بَلَاط (ضد الطول؛ غير تام، غير كامل)\nمثال: لقد قصر الخطاب.",
 "でんかのほうとう": "ورقة حكم, ورقة رابحة (ورقة لعب من النقش الذي تم إعلانه كحكم)\nمثال: آس الحكم هو فائز مؤكد",
 "でんがくざし": "سيخ (دبوس طويل لتثبيت اللحم في موضعه أثناء شيه)",
 "でんき": "سِيرَة, تَرْجَمَةُ ٱلْحَيَاةِ / كَهْرَبَائِيّ, كَهْرُبَائِيّ / جِهَاز / كَهْرَبَاء, كَهْرُبَاء / إِشَارَة مُرُور, إِشَارَة ضَوْئِيَّة\nمثال: نسي أن يطفئ النور.",
 "でんきいす": "كُرْسِيّ كَهْرَبَائِيّ (مَقْعَد لواحد؛ العِلْم. يقال هو من أهل الكُرسِيّ أي أهل العِلم)\nمثال: أحب ذاك الكرسي.",
 "でんきいんせいど": "سلبية كهربائية ((كيمياء) ميل الذرة أو الجذر لجذب الإلكترونات في تكوين رابطة أيونية)",
 "でんきうなぎ": "أنقليس رعاد, أنقليس كهربائي (سمكة مياه عذبة تشبه الثعبان تعيش في أمريكا الجنوبية ولها أعضاء كهربائية في جسمها)",
 "でんきえいどう": "رحلان كهربائي (حركة الجسيمات المشحونة في مادة غروانية تحت تأثير مجال كهربائي؛ حيث تتجه…)",
 "でんきえいどうほう": "رحلان كهربائي (حركة الجسيمات المشحونة في مادة غروانية تحت تأثير مجال كهربائي؛ حيث تتجه…)",
 "でんきかいり": "تأين (عملية التأين؛ تكوين الأيونات عن طريق فصل الذرات أو الجزيئات أو الجذور أو عن…)\nمثال: تأين الغاز",
 "でんきかいろ": "دَارَة كَهْرَبَائِيَّة (لا جمع له)",
 "でんきかいろブレーカー": "قاطع الدائرة, قاطع كهربائي (جهاز يعمل مثل المفتاح ويفتح الدائرة عند التحميل الزائد)",
 "でんきかがく": "كيمياء كهربائية (فرع الكيمياء الذي يتعامل مع التأثير الكيميائي للكهرباء وإنتاج الكهرباء عن طريق…)",
 "でんきかみそり": "ماكينة حلاقة كهربائية (ماكينة حلاقة تعمل بمحرك كهربائي)",
 "でんきがいしゃ": "شركة طاقة, شركة كهرباء (مرفق عام يوفر الكهرباء)",
 "でんききかんしゃ": "قاطرة كهربائية (قاطرة تعمل بمحرك كهربائي)",
 "でんきぎし": "مهندس كهربائي (شخص مدرب على التطبيقات العملية لنظرية الكهرباء)",
 "でんきぎじゅつしゃ": "مهندس كهربائي (شخص مدرب على التطبيقات العملية لنظرية الكهرباء)",
 "でんきくらげ": "رجل الحرب البرتغالي (سحاري كبير له عوامة تشبه المثانة ومجسات لاسعة)",
 "でんきけいとう": "نظام كهربائي (معدات في مركبة بمحرك توفر الكهرباء لتشغيل المحرك وإشعال الوقود وتشغيل الأضواء…)",
 "でんきけいれんりょうほう": "علاج بالصدمات الكهربائية (إعطاء تيار كهربائي قوي يمر عبر الدماغ للحث على التشنجات والغيبوبة)",
 "でんきこう": "كَهْرَبَائِيّ, كَهْرَبَائِيَّة",
 "でんきこうがく": "هندسة كهربائية (فرع العلوم الهندسية الذي يدرس استخدامات الكهرباء ومعدات توليد الطاقة وتوزيعها…)",
