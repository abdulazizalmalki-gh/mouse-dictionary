 "どこをどう": "كَيْف, ازاي / كَيْفَ, ازاي / كَمْ, يَا لَ",
 "どこんじょう": "إقدام, عزيمة (الثبات والتصميم) / جريت, حجر رملي خشن (حجر رملي سيليسي خشن الحبيبات صلب)\nمثال: لم يكن لديه الجرأة لتجربتها",
 "どこ吹く風": "لَا مُبَالٍ, مُتَهَتِّك (يَتَّسِمُ بِعَدَمِ المُبَالَاةِ بِالأَعْرَافِ أَوْ بِسُوءِ السُّمْعَة) / طَائِش, لَا مُبَالٍ (غير مسؤول بمرح وخِفّة)",
 "どご": "لَهْجَة, الْعَامِّيَّة (طَرَفُ ٱللِّسَانِ؛ جَرْسُ ٱلْكَلَامِ)\nمثال: الشاوية هي لهجة للأمازيغية.",
 "どごう": "خوار, زئير (تلفظ عالٍ جداً (مثل صوت حيوان))\nمثال: ملأ خواره الممر",
 "どさ": "رَاسِب",
 "どさくさ": "اِلْتِبَاس / اِرْتِبَاك (ارتبك الأمر:اختلط عليه ، وفي الوحْل :نَشَبَ فيه وعَلِق ،وفي الأمر:وقع فيه ولم يكد يتخلّص منه؛ ارتبك في كلامه:إذا تَتَعْتَعَ، وارتبك الصّيد في الْحِبَالَة:اِضْطَرَب)\nمثال: لا داعي لارتباك.",
 "どさくさまぎれ": "اِلْتِبَاس / اِرْتِبَاك (ارتبك الأمر:اختلط عليه ، وفي الوحْل :نَشَبَ فيه وعَلِق ،وفي الأمر:وقع فيه ولم يكد يتخلّص منه؛ ارتبك في كلامه:إذا تَتَعْتَعَ، وارتبك الصّيد في الْحِبَالَة:اِضْطَرَب)\nمثال: لا داعي لارتباك.",
 "どさくさ紛れ": "اِلْتِبَاس / اِرْتِبَاك (ارتبك الأمر:اختلط عليه ، وفي الوحْل :نَشَبَ فيه وعَلِق ،وفي الأمر:وقع فيه ولم يكد يتخلّص منه؛ ارتبك في كلامه:إذا تَتَعْتَعَ، وارتبك الصّيد في الْحِبَالَة:اِضْطَرَب)\nمثال: لا داعي لارتباك.",
 "どさまわり": "رِحْلَة / جَوْلَة",
 "どさん": "حَالِيّ, حَاضِر / مَوْجُود, حَاضِر (الذي له وجود) / الزَّمَان, الْحَال / قَدَّمَ, طَرَحَ (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى الرُّسْغَ؛ أنّ لهم سابقةً وفضلاً له عند فلان قَدَمٌ : معروف)\nمثال: أنا موجود لوحدي",
 "どさ回り": "رِحْلَة / جَوْلَة",
 "どし": "حبيب, صديق حميم (رجل هو عشيق لرجل أو امرأة) / رجل, رفيق (صبي أو رجل) / زَمِيل (شخص عضو في نفس مهنة أو طبقة الشخص الآخر) / رفيق, زميل (صديق يتواجد كثيراً بصحبة آخر)\nمثال: لو علمت أنه حبيبها لما سألت",
 "どしうち": "نِيرَان صَدِيقَة",
 "どしがたい": "عَنِيد",
 "どしつ": "تُرْبَة, أَرْض / اِتَّسَخَ",
 "どしどし": "وَاحِدًا تِلْوَ الآخَرِ / بلا تحفظ, تماماً (بدون تحفظ)\nمثال: أستطيع أن أوصي بهذا المطعم بلا تحفظ! / تنزه جبلي, سير طويل (مشي طويل عادة للرياضة أو المتعة) / سفينة شحن متجولة (باخرة تجارية للإيجار؛ ليس لها جدول زمني منتظم) / دوس, وقع أقدام ثقيلة (وقع أقدام ثقيل) / رحالة, متجول (مسافر على الأقدام؛ شخص يذهب في نزهة طويلة (للمتعة))\nمثال: تستمتع بنزهة جبلية في وقت فراغها",
 "どしゃ": "رَاسِب",
 "どしゃくずれ": "اِنْهِيَار أَرْضِيّ (سقوط شيء أو تهاويه بشكل مفاجئ نتيجة ضعف أو خلل؛ تدهور نفسي أو عاطفي يؤدي إلى فقدان القدرة على التحمل)\nمثال: يوشك الجسر على الانهيار.",
 "どしゃぶり": "وَابِل, مَطَر غَزِير",
 "どしゃ降り": "وَابِل, مَطَر غَزِير",
 "どしょうぼね": "رُوح (رَوَّحَ عليه بالمِرْوحَة: حَرَّكَها ليجلبَ إِليه نسيمَ الهواء؛ رَوَّحَ بالقوم: صلَّى بهم التراويح) / رُوَح (رَوَّحَ عليه بالمِرْوحَة: حَرَّكَها ليجلبَ إِليه نسيمَ الهواء؛ رَوَّحَ بالقوم: صلَّى بهم التراويح) / كُحُول (سَائِلٌ لاَ لَوْنَ لَهُ، لاَذِعُ الطَّعْمِ، يُسْتَخْرَجُ مِنْ تَخْمِيرِ بَعْضِ الْمَوَادِّ، يُمْزَجُ بِالْمَشْرُوبَاتِ الرُّوحِيَّةِ…)\nمثال: كان سامي هو روح الحفلة.",
 "どしょくしょう": "أكل التراب (أكل التراب أو الطين أو الطباشير؛ يحدث في بعض القبائل البدائية، وأحياناً في حالات النقص الغذائي أو السلوك الوسواسي)",
 "どしょっぽね": "رُوح (رَوَّحَ عليه بالمِرْوحَة: حَرَّكَها ليجلبَ إِليه نسيمَ الهواء؛ رَوَّحَ بالقوم: صلَّى بهم التراويح) / رُوَح (رَوَّحَ عليه بالمِرْوحَة: حَرَّكَها ليجلبَ إِليه نسيمَ الهواء؛ رَوَّحَ بالقوم: صلَّى بهم التراويح) / كُحُول (سَائِلٌ لاَ لَوْنَ لَهُ، لاَذِعُ الطَّعْمِ، يُسْتَخْرَجُ مِنْ تَخْمِيرِ بَعْضِ الْمَوَادِّ، يُمْزَجُ بِالْمَشْرُوبَاتِ الرُّوحِيَّةِ…)\nمثال: كان سامي هو روح الحفلة.",
 "どしん": "سمين",
 "どしんどしん": "مُتَجَسِّد / مَشْي (السَيْر على رجلين؛ السير عامّة)\nمثال: مشي توم مع ماري.",
 "どじ": "خطأ فادح, زلة (خطأ محرج) / رقعة, قطعة أرض (مساحة صغيرة من الأرض مغطاة بنباتات محددة)\nمثال: رقعة فاصولياء / جوار, منطقة مجاورة (منطقة محيطة أو قريبة)\nمثال: تحطمت الطائرة في جوار آشفيل",
 "どじょう": "تُرْبَة, أَرْض / اِتَّسَخَ / مرتع, مفقس (مكان تتكاثر فيه الحيوانات) / لوتش (أسماك مياه عذبة نحيلة في أوراسيا وأفريقيا تشبه سمك السلور)",
 "どじょうがく": "طب الأطفال (فرع الطب المعني بعلاج الرضع والأطفال)",
 "どじょうしんしょく": "انجراف التربة (جرف التربة عن طريق تدفق المياه)",
 "どじる": "أَخْفَقَ, فَشِلَ ((أَخْفَقَ): اضطرب وتحرك؛ (أَخْفَقَ)الطائر: ضرب بجناحيه.بجناحيه) / رَسَبَ (جعل مادة ما تترسب أو تنفصل عن سائل، خاصة في العمليات الكيميائية؛ أعلن فشل شخص في اختبار أو تقييم أكاديمي)\nمثال: برشاقة القط، قفز نحو الرف لكنه أخفق و سقط إلى الأرض.",
 "どじをふむ": "خطأ فادح, زلة (خطأ محرج)",
 "どじを踏む": "خطأ فادح, زلة (خطأ محرج)",
 "どじん": "أَصْلِيّ / إله الأرض (إله الخصوبة والنباتات) / جَزَّار, قَصَّاب / طَبَّاخ, طَبَّاخَة (من طَبَخَ، بمعنى اسم الفاعل الطَابِخ؛ من طَبَخَ، بمعنى الكثير الطَبْخ) / طَبَخَ, طيب (أَنْضَجَ الطعام بتسخينه) / طاب (حَسُنَ واصبح طَيِّب؛ نفسُه: ارتاحت ورضيت واطمأنت)\nمثال: زوجي طباخ ماهر.",
 "どす": "خَنْجَر (السِكِّين الكبيرة لا تستخدم للطعام بل للحَرْب، وقيل هي السكين ذات الحدين) / مُغَطًّى بِالطِّين, مُوحَل (متّسخ وفوضويّ؛ مغطّى بالوحل أو الطين) / عَكِر, مُتَكَدِّر (عكر بسبب الرواسب أو الترسّبات؛ يُقال عن السوائل) / كَدِر, مُعَكَّر ((في اللون) تغيّر بسبب الشوائب؛ غير ساطع أو صافٍ) / مُسْتَنْقَعِيّ, وَحِل ((عن التربة) ليّنة ومشبَعة بالماء) / كَانَ (اِتَّصَفَ. (فعل ناقص)؛ حَدَثَ) / كَانَ هُوَ, هِيَ (اِتَّصَفَ. (فعل ناقص)؛ حَدَثَ)\nمثال: كان الكلب ميتا.",
 "どすう": "تَرَدُّد (الذهاب إلى المكان مرة أخرى إلى نفس المكان بصورة متكررة؛ عدم الاستقرار على رأي معين)\nمثال: قبل ماثيو بتردد. / دَرَجَة",
 "どすうぶんぷ": "توزيع تكراري (توزيع التكرارات المرصودة لقيم متغير)",
 "どすうぶんぷず": "مدرج تكراري (مخطط شريطي يمثل توزيع التردد؛ تمثل ارتفاعات الأشرطة الترددات المرصودة)",
 "どすぐろい": "مَائِل إِلَى القَتَامَة (داكن نوعاً ما؛ يميل إلى القتامة)",
 "どすけべ": "شهواني, فاسق (رجل لديه رغبات جنسية قوية)",
 "どすけべい": "شهواني, فاسق (رجل لديه رغبات جنسية قوية)",
 "どすっと": "خبطة, ضربة قوية (ضربة ثقيلة باليد) / خبط, دبدبة (صوت مكتوم ثقيل (كما ينتج عن ارتطام أشياء ثقيلة))",
 "どすどす": "بِصَخَب, بِضَجِيج (مع الكثير من الضجيج أو الصوت العالي والمزعج)\nمثال: نظف أنفه بصخب",
 "どすのきいた": "مُتَوَعِّد, مُنْذِر بِالشَّرّ (يهدد أو ينذر بتطورات شريرة أو مأساوية) / مُتَجَهِّم, مُكْفَهِرّ (مُعتم بالغيوم مع إيحاء بالتهديد)",
 "どすの利いた": "مُتَوَعِّد, مُنْذِر بِالشَّرّ (يهدد أو ينذر بتطورات شريرة أو مأساوية) / مُتَجَهِّم, مُكْفَهِرّ (مُعتم بالغيوم مع إيحاء بالتهديد)",
 "どすの効いた": "مُتَوَعِّد, مُنْذِر بِالشَّرّ (يهدد أو ينذر بتطورات شريرة أو مأساوية) / مُتَجَهِّم, مُكْفَهِرّ (مُعتم بالغيوم مع إيحاء بالتهديد)",
 "どする": "أَنْقَذَ, أَنْجَى / اِدَّخَرَ / حَفِظَ (الحِفْظُ نَقِيضُ النِّسْيَان، وهو التَّعَاهُدُ وقِلَّةُ الغَفْلَةِ؛ قِلَّةُ الغَفْلَةِ)\nمثال: حفظ رقم هاتفها.",
 "どすん": "انفجار, دوي (ضجيج عالٍ جداً ومفاجئ)",
 "どす黒い": "مَائِل إِلَى القَتَامَة (داكن نوعاً ما؛ يميل إلى القتامة)",
 "どせい": "زُحَل (سادس كوكب في المجموعة الشمسية) / سَاتُورْن\nمثال: زحل كوكب كبير جدا. / طِين, صَلْصَال / تُرْبَة, تُرَاب / أَرْض, أرض (الكَوْكَب الذي نعيش عليه. لا جمع له؛ البَرّ، ضد البَحْر. يجمع على أرضون) / أَرْض, دُنْيَا (الكَوْكَب الذي نعيش عليه. لا جمع له؛ البَرّ، ضد البَحْر. يجمع على أرضون)\nمثال: أرض الله واسعة.",
 "どせきりゅう": "انهيار طيني (انهيار أرضي مكون من الطين)",
 "どそう": "دَفْن, تَدْفِين (دَفَنَهُ يَدْفِنُهُ: سَتَرَهُ، وواراه)\nمثال: دفن القط فضلاته.",
 "どそうぼち": "مَقْبَرَة, مَقْبُرَة",
 "どそくで": "بلا أدب, بوقاحة (بطريقة غير مؤدبة)\nمثال: عاملها بوقاحة",
 "どぞう": "مستودع (جوداون) ((في الهند وماليزيا) مستودع)",
 "どぞくがく": "إِتْنُولُوجِيَة",
 "どたっ": "خبطة, ضربة قوية (ضربة ثقيلة باليد) / خبط, دبدبة (صوت مكتوم ثقيل (كما ينتج عن ارتطام أشياء ثقيلة))",
 "どたどた": "بِصَخَب, بِضَجِيج (مع الكثير من الضجيج أو الصوت العالي والمزعج)\nمثال: نظف أنفه بصخب",
 "どたばた": "بِصَخَب, بِضَجِيج (مع الكثير من الضجيج أو الصوت العالي والمزعج)\nمثال: نظف أنفه بصخب / تَهْرِيجِيّ (يتّسم بالمُشاغبة والحركة البدنيّة في الكوميديا) / عصا التصفيق (جهاز صوتي يتكون من مضربين مفصليين معاً؛ يستخدمه الممثل لإحداث ضوضاء عالية دون التسبب في إصابة عند ضرب شخص ما) / تهريج, سلابستيك (كوميديا صاخبة تتضمن مطاردات واصطدامات ومقالب)",
 "どたま": "رَئِيس, رَئِيسَة / رَئِيس / اِتَّجَهَ",
 "どたらこたら": "فُلَان, فُلَانَة (كلمة تستخدم لوصف شخص ما بدون ذكر من هو، غالبًا يقصد به \"أي شخص من الناس\"، أو شخص لا يريد المتحدث ذكره)\nمثال: سمعنا ذلك من فلان و فلان.",
 "どたり": "بثقل, بشكل كبير (بدرجة كبيرة) / بإفراط, بشراهة (الانغماس بإفراط) / بثقل, بصعوبة (بطريقة مجهدة) / بثقل (ببطء كما لو كان مثقلاً بوزن كبير)\nمثال: اعتمد بشكل كبير على بيانات الآخرين",
 "どたん": "خبط, دبدبة (صوت مكتوم ثقيل (كما ينتج عن ارتطام أشياء ثقيلة))",
 "どたんば": "آخر لحظة، اللحظة الأخيرة (ضد الأوَّل؛ وهو من يكون ترتيبه بعد الجميع؛ الشيء: مؤخرّه، الجزء الآخير منه)\nمثال: أرني مثالا آخر.",
 "どたん場": "آخر لحظة، اللحظة الأخيرة (ضد الأوَّل؛ وهو من يكون ترتيبه بعد الجميع؛ الشيء: مؤخرّه، الجزء الآخير منه)\nمثال: أرني مثالا آخر.",
 "どたキャン": "فِي اللَّحْظَةِ الأَخِيرَة (قُبَيْل الموعد النهائي مباشرة)",
 "どだい": "إِنْشاء, إِشَادَة (مصدر للفعل \"أَنْشَأَ\") / أَسَاس, قَاعِدَة (مبدأ عام تعتمد عليه طائفة من الظواهر أو القضايا؛ مُرتكز البناء وقاعدته) / مُؤَسَّسَة / أَسَاس (مبدأ عام تعتمد عليه طائفة من الظواهر أو القضايا؛ مُرتكز البناء وقاعدته)\nمثال: إنشاء موقع إلكتروني بدون أي تكلفة؟ / بالفطرة, بطبعه (من خلال الطبيعة المتأصلة)\nمثال: كان كسولاً بطبعه / مُسْوَدَّة / تَجْنِيد / سَوَّدَ / جَنَّدَ (جَنَّدَ الجنودَ: جَمَعَهَا؛ جَنَّدَ فلانًا: صيَّره جنديّاً)",
 "どだいいし": "حجر أساس (حَجَرَ عليه الأمرَ:مَنَعَه منه ، حجر الشّيء على نفسه:خَصَّها به وقصره عليها؛ الحجْرُ: المَنْعُ مِن التَّصَرُّفِ ، وحَجَرَ عَلَيْهِ القاضِي يَحْجُرُ حَجْراً، إِذا مَنَعَه مِن التَّصَرُّفِ فِي مالِه)\nمثال: عوقب زيري بالحجر.",
 "どだいづくり": "أساس, عمل تمهيدي (إعداد أولي كأساس أو قاعدة) / أساس (أدنى دعامة لهيكل ما) / أساس, حجر الزاوية (الافتراضات الأساسية التي يبدأ منها شيء ما أو يتطور أو يُحسب أو يُشرح)\nمثال: نحن مستعدون اليوم بسبب العمل التمهيدي الذي تم قبل عشر سنوات",
 "どち": "رقعة, قطعة أرض (مساحة صغيرة من الأرض مغطاة بنباتات محددة)\nمثال: رقعة فاصولياء / جوار, منطقة مجاورة (منطقة محيطة أو قريبة)\nمثال: تحطمت الطائرة في جوار آشفيل",
 "どちみち": "عَلَى كُلِّ حَال, على كل حال (يفيد الاستعلاء؛ يفيد التعليل) / عَلَى أَيُّ حَالٍ, على كل حال (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال.",
 "どちゃく": "أَصَالَة, تَوَطُّن (الأصلية بحكم النشأة أو الحدوث الطبيعي (كما في مكان معين)) / أَصْلِيّ",
 "どちゃくそ": "جِدًّا (كلمة \"جدا\" لها معانٍ متعددة؛ يرتبط المعنى بالعطاء والكرم، سواء بالمنح أو طلبه)\nمثال: إنها غالية جدا!",
 "どちゃくみん": "أَصْلِيّ",
 "どちゃクソ": "جِدًّا (كلمة \"جدا\" لها معانٍ متعددة؛ يرتبط المعنى بالعطاء والكرم، سواء بالمنح أو طلبه)\nمثال: إنها غالية جدا!",
 "どちゅう": "تحت الأرض, جوفياً (تحت سطح الأرض) / سرياً, في الخفاء (في أو إلى مخبأ أو عملية سرية) / خَفِيّ, سِرِّيّ (يُجْرَى بِأَهْدَافٍ أَوْ أَسَالِيبَ خَفِيَّة) / تَحْتَ أَرْضِيّ, جَوْفِيّ (تحت مستوى سطح الأرض)\nمثال: المياه تتدفق جوفياً",
 "どちょう": "التهام, نهم (الأكل بشراهة أو نهم حتى الشبع المفرط) / احتقان (الامتلاء بالدم)\nمثال: احتقان الثدي",
 "どちら": "أَيْن, فين / حَيْثُ / مَن, مين (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "どちらか": "أَيْضًا, كَذٰلِكَ / إِمَّا ؛ إِمَّا",
 "どちらからともなく": "كِلَا (بمعنى إنته ولا تفعل، ليست بحاجة إلى جملة كاملة؛ تأتي بمعنى لا الجوابية) / كل من ؛ و ؛\nمثال: انا احب كلا منهما",
 "どちらからとも無く": "كِلَا (بمعنى إنته ولا تفعل، ليست بحاجة إلى جملة كاملة؛ تأتي بمعنى لا الجوابية) / كل من ؛ و ؛\nمثال: انا احب كلا منهما",
 "どちらさま": "مَن, مين (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "どちらでも": "أَيْضًا, كَذٰلِكَ / إِمَّا ؛ إِمَّا",
 "どちらでもない": "أَحَد لَا (العدد وَاحِد؛ الوَاحِد من الشيء) / مثال: لم يساعدني أحد.",
 "どちらとも": "كِلَا (بمعنى إنته ولا تفعل، ليست بحاجة إلى جملة كاملة؛ تأتي بمعنى لا الجوابية) / كل من ؛ و ؛\nمثال: انا احب كلا منهما",
 "どちらともなく": "كِلَا (بمعنى إنته ولا تفعل، ليست بحاجة إلى جملة كاملة؛ تأتي بمعنى لا الجوابية) / كل من ؛ و ؛\nمثال: انا احب كلا منهما",
 "どちらにしても": "عَلَى أَيِّ حَالٍ (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال.",
 "どちらにせよ": "بِطَرِيقَةٍ أَو بِأُخرَى",
 "どちらも": "كِلَا (بمعنى إنته ولا تفعل، ليست بحاجة إلى جملة كاملة؛ تأتي بمعنى لا الجوابية) / كل من ؛ و ؛\nمثال: انا احب كلا منهما / أَيْضًا, كَذٰلِكَ / إِمَّا ؛ إِمَّا",
 "どちら共": "كِلَا (بمعنى إنته ولا تفعل، ليست بحاجة إلى جملة كاملة؛ تأتي بمعنى لا الجوابية) / كل من ؛ و ؛\nمثال: انا احب كلا منهما",
 "どちら様": "مَن, مين (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "どっか": "مَكَان مَا (مَوْضِع؛ المنزلة والشأن، يقال أيضا مكانة)\nمثال: هذا المكان مقدس / احتكاك, كشط (فعل الاحتكاك بشيء أثناء المرور) / تهرب ضريبي بإخفاء الدخل (عدم التصريح عن الدخل لتجنب دفع الضرائب عليه) / قشط (عملية إزالة المواد الطافية من سطح سائل) / تصفح سريع, قراءة سريعة (القراءة أو إلقاء نظرة سريعة)",
 "どっかい": "قِرَاءَة",
 "どっかり": "إسقاط الكرة ((بيسبول) ضرب كرة البيسبول بحيث تسقط فجأة) / بصوت ارتطام, طشّ (بصوت ارتطام قصير ومجوف) / رنة, طنة (صوت رنين أجوف)\nمثال: سقطت الكرة بصوت ارتطام في زاوية الملعب",
 "どっき": "خُبْث, سُمِّيَّة (ضرر جسيم أو فتك) / سُمِّيَّة (الدرجة التي يكون بها شيء ما ساماً) / حِقْد (حقد:أَمْسَكَ عَداوتَهُ فِي قَلْبهِ وتَرَبَّصَ لفُرْصَتِها؛ حقد على فلان:أَضْمَرَ له العداوة وتربّص فرصة الإيقاع به ، كَرِهَه وبَغِضَه)\nمثال: احس سامي بالحقد.",
 "どっきどき": "خفقاً, دقا (وصف لضربات إيقاعية (مثل القلب)) / بخطوات خفيفة, طقطقة (كما في صوت الخطوات الخفيفة)\nمثال: قلبه كان يخفق / خَفَقَ (الجذر يعبر عن الحركة والاضطراب الخفيف الذي ينشأ عن الرياح أو القلوب أو الرايات، ويستخدم لوصف الطبيعة والأحاسيس والجوانب الحسية المختلفة؛ عبّر عن حركة سريعة، سواء كانت اضطراباً أو ضرباً خفيفاً أو صوتاً، بالإضافة إلى صفةٍ تُوصف بها الخيل) / خَفَقَ, نَبَضَ (الجذر يعبر عن الحركة والاضطراب الخفيف الذي ينشأ عن الرياح أو القلوب أو الرايات، ويستخدم لوصف الطبيعة والأحاسيس والجوانب الحسية المختلفة؛ عبّر عن حركة سريعة، سواء كانت اضطراباً أو ضرباً خفيفاً أو صوتاً، بالإضافة إلى صفةٍ تُوصف بها الخيل) / خَفَقَان",
 "どっきょ": "عُزْلَة",
 "どっきょしつ": "صَوْمَعَة, كِرْح / خَلِيَّة / خَلَوِيّ",
 "どっきり": "مَقْلَب",
 "どっきん": "مُضَادّ لِلاحْتِكَار (عَنِ القَوَانِين وَالأَنْظِمَة؛ مُصَمَّم لِحِمَايَة التِّجَارَة مِنَ المُمَارَسَات التِّجَارِيَّة غَيْر العَادِلَة)",
 "どっきんほう": "قانون مكافحة الاحتكار (قانون يهدف إلى تعزيز المنافسة الحرة في السوق عن طريق حظر الاحتكارات)",
 "どっくん": "ضَخْم جِدًّا ((غير رسمي) كبير جداً) / خبط, دبدبة (صوت مكتوم ثقيل (كما ينتج عن ارتطام أشياء ثقيلة))",
 "どっけ": "خُبْث, سُمِّيَّة (ضرر جسيم أو فتك) / سُمِّيَّة (الدرجة التي يكون بها شيء ما ساماً) / حِقْد (حقد:أَمْسَكَ عَداوتَهُ فِي قَلْبهِ وتَرَبَّصَ لفُرْصَتِها؛ حقد على فلان:أَضْمَرَ له العداوة وتربّص فرصة الإيقاع به ، كَرِهَه وبَغِضَه)\nمثال: احس سامي بالحقد.",
 "どっけし": "تِرْيَاق (دواء مركب يدفع السموم؛ ما يضاد عمل السمّ)",
 "どっけつしょう": "انسمام الدم, تسمم الدم (تسمم الدم الناتج عن المواد السامة البكتيرية في الدم) / تسمم الحمل (حالة غير طبيعية أثناء الحمل تتميز بارتفاع ضغط الدم والوذمة والبروتين في البول)",
 "どっこう": "استقلالية, اعتماد على النفس (الاستقلال الشخصي)",
 "どっさり": "جزيلاً, كثيراً (كثيراً جداً) / أطنان, أكوام (عدد أو كمية كبيرة)\nمثال: شكراً جزيلاً",
 "どっしり": "ضَخْم, هائِل الكُتْلَة (ذو كُتْلَة كَبيرَة؛ يَحْتَوي عَلى كَمِّيَّة هائِلَة مِن المادَّة) / صَرْحِيّ, ضَخْم (مهيب في الحجم أو الكتلة أو الصلابة) / هَائِل, وَاسِع (مهيب في النطاق أو المدى أو الدرجة أو القوة) / مُتَجَانِس, مُصْمَت (مؤلَّف من المادّة نفسها في جميع أجزائه) / رزين, مهيب (يمتلك أو يعبر عن الكرامة؛ خاصة الرسمية أو الهيبة في السلوك أو المظهر) / مُعْتَزّ بِنَفْسِه, وَقُور (يمتلك أو يُظهِر تقديرًا واحترامًا للذات)\nمثال: سلوكها الوقور",
 "どったらこったら": "فُلَان, فُلَانَة (كلمة تستخدم لوصف شخص ما بدون ذكر من هو، غالبًا يقصد به \"أي شخص من الناس\"، أو شخص لا يريد المتحدث ذكره)\nمثال: سمعنا ذلك من فلان و فلان.",
 "どっち": "أَيْن, فين / حَيْثُ / مَن, مين (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "どっちか": "أَيْضًا, كَذٰلِكَ / إِمَّا ؛ إِمَّا",
 "どっちつかず": "غَيْرُ مُلْتَزِم, مُتَحَفِّظ (يَرْفُضُ الالْتِزَامَ بِمَوْقِفٍ أَوْ مَسَارِ عَمَلٍ مُعَيَّن)",
 "どっちにしても": "عَلَى أَيِّ حَالٍ (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال.",
 "どっちみち": "عَلَى كُلِّ حَال, على كل حال (يفيد الاستعلاء؛ يفيد التعليل) / عَلَى أَيُّ حَالٍ, على كل حال (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال.",
 "どっちも": "كِلَا (بمعنى إنته ولا تفعل، ليست بحاجة إلى جملة كاملة؛ تأتي بمعنى لا الجوابية) / كل من ؛ و ؛\nمثال: انا احب كلا منهما / أَيْضًا, كَذٰلِكَ / إِمَّا ؛ إِمَّا",
 "どっちらけ": "كابح, مثبط (قيد يسبب الإحباط أو التثبيط) / كاتم, مخمّد (جهاز يقلل من سعة التذبذبات الإلكترونية أو الميكانيكية أو الصوتية أو الديناميكية الهوائية) / مخمد (لوحة حديدية متحركة تنظم تيار الهواء في موقد أو مدخنة أو فرن)\nمثال: وضع المطر كابحًا لخطط نزهتنا",
 "どっち道": "عَلَى كُلِّ حَال, على كل حال (يفيد الاستعلاء؛ يفيد التعليل) / عَلَى أَيُّ حَالٍ, على كل حال (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال.",
 "どっと": "بشدة, للغاية (بدرجة قصوى (تستخدم غالباً لوصف السُكر)) / رَائِج, مُزْدَهِر (حيوي ومربح للغاية؛ في حالة ازدهار ونمو) / خوار, زئير (تلفظ عالٍ جداً (مثل صوت حيوان)) / دوي, رعد (ضجيج عميق طويل وعالٍ)\nمثال: ثمل بشدة / فَجْأَةً",
 "どっぷり": "بالكامل, بشكل تام (إلى درجة كاملة أو إلى الحد الأقصى؛ بالكامل)\nمثال: كان مقتنعاً كلياً",
 "どっぽ": "استقلالية, اعتماد على النفس (الاستقلال الشخصي) / فَرِيد, فَذّ",
 "どつく": "لَكْمَة أَمَامِيَّة",
 "どづく": "لَكْمَة أَمَامِيَّة",
 "どて": "جسر ترابي, ساتر ترابي (كومة اصطناعية طويلة من الحجر أو التراب؛ تبنى لحجز المياه أو لدعم طريق أو للحماية)",
 "どてっぱら": "أَحْشَاء",
 "どてっ腹": "أَحْشَاء",
 "どてみち": "جسر, طريق مرتفع (طريق مرفوع فوق الماء أو المستنقعات أو الرمال)",
 "どでい": "مَصْرِف, بَنْك (في الاقتصاد: مؤسسة مالية مُرَخصة، تختص بإتمام الخدمات المالية كتلقي عمليات الإيداع، ومنح القروض، وإدارة الثروات، واستبدال العملات) / ضِفَّة\nمثال: عدن إلى المصرف.",
 "どでかい": "ضَخْم, عِمْلَاق",
 "どとう": "مُتَلَاطِم, مُضْطَرِب ((لسائل) مُحرَّك بعنف؛ في حالة اضطراب وتلاطم) / عَاصِف, مُضْطَرِب (يتّسم بالفوضى أو الاضطراب أو التمرّد)",
 "どど": "كَثِيرًا, غَالِبًا",
 "どどめ": "جدار استنادي (جدار يُبنى لمقاومة الضغط الجانبي (خاصة الجدار المبني لمنع تقدم كتلة من الأرض)) / تُوت",
 "どどめいろ": "تُوت",
 "どどめ色": "تُوت",
 "どどん": "غَبِيّ / غَبِيّ, أَحْمَق",
 "どない": "يَا لَ (يستعمل لنِدَاء البعيد والقريب) / مَا (انظر مَا) / مَاذَا, مَا (أداة استفهام)\nمثال: يا لها من جملة! / كَيْف, ازاي / كَيْفَ, ازاي / كَمْ, يَا لَ",
 "どなた": "مَن, مين (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "どなたか": "أَحَد (العدد وَاحِد؛ الوَاحِد من الشيء)\nمثال: لم يساعدني أحد.",
 "どなたさま": "مَن, مين (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "どなた様": "مَن, مين (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "どなりだす": "اِنْدَلَعَ",
 "どなりちらす": "صَاحَ (صاتَ بأقصى طاقته وأعلى صوته، يستخدم للحيّ ولا يقال صاح للجماد؛ عليه: ناداه)\nمثال: سأساعدك يا صاح.",
 "どなる": "صَيح, صِيَاح (مبالغة في الصياح، صاح كثيرا؛ في : صرخ) / صَرَخَ, صَاحَ (صاحَ صياحا شديدًا واستغاث)\nمثال: صرخ طالبا النجدة.",
 "どにち": "نِهَايَة الْأُسْبُوع, عَطْلَة الْأُسْبُوع / درجة-يوم (وحدة تستخدم في تقدير متطلبات الوقود لتدفئة مبنى) / يوم التخرج, يوم منح الدرجات (اليوم الذي تُمنح فيه الدرجات الجامعية)",
 "どの": "سيد (صيغة خطاب للرجل) / أَيّ (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير) / مَما / اَلَّذِي\nمثال: لم تقصد أي أذى.",
 "どのあたり": "مكان التواجد (الموقع العام الذي يوجد فيه شيء ما)\nمثال: سألته عن مكان تواجده ليلة الجريمة",
 "どのう": "كيس رمل (كيس مملوء بالرمل؛ يستخدم كسلاح أو لبناء الجدران أو كثقل موازن)",
 "どのくらい": "كَم وَقْتًا, إِلَى مَتَى",
 "どのぐらい": "كَم وَقْتًا, إِلَى مَتَى",
 "どのばあいにも": "عَلَى أَيِّ حَالٍ (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال.",
 "どのへん": "مكان التواجد (الموقع العام الذي يوجد فيه شيء ما)\nمثال: سألته عن مكان تواجده ليلة الجريمة / كَمْ",
 "どのみち": "عَلَى كُلِّ حَال, على كل حال (يفيد الاستعلاء؛ يفيد التعليل) / عَلَى أَيُّ حَالٍ, على كل حال (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال.",
 "どのように": "كَيْف, ازاي / كَيْفَ, ازاي / كَمْ, يَا لَ\nمثال: あなたはどのようにしてその問題を解いたのですか。 — كيف تخلصت من المشكلة؟",
 "どの位": "كَم وَقْتًا, إِلَى مَتَى",
 "どの場合にも": "عَلَى أَيِّ حَالٍ (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال.",
 "どの様に": "كَيْف, ازاي / كَيْفَ, ازاي / كَمْ, يَا لَ\nمثال: あなたはどのようにしてその問題を解いたのですか。 — كيف تخلصت من المشكلة؟",
 "どの辺": "مكان التواجد (الموقع العام الذي يوجد فيه شيء ما)\nمثال: سألته عن مكان تواجده ليلة الجريمة / كَمْ",
 "どの辺り": "مكان التواجد (الموقع العام الذي يوجد فيه شيء ما)\nمثال: سألته عن مكان تواجده ليلة الجريمة",
 "どの道": "عَلَى كُلِّ حَال, على كل حال (يفيد الاستعلاء؛ يفيد التعليل) / عَلَى أَيُّ حَالٍ, على كل حال (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال.",
 "どはい": "رَجُل (العُضْو في جسد الإنسان يتكون من القَدَم والسَاق والفُخْذ. الجمع أرجُل، وقد تقول العامّة رِجْلين ورجْلينات؛ القَدَم من باب اطلاق اسم الكل على الجزء)\nمثال: هذا الرجل تاجر.",
 "どはくりょく": "مُشَوِّق, مُكَهْرِب (يُسَبِّب موجة من المشاعر أو الحماس) / مُرْعِد, مُقْشَعِرّ (يسبب الارتعاش أو القشعريرة كما من البرد أو الخوف أو الصدمة)",
 "どはずれ": "اِسْتِثْنَائِيّ, غَيْرُ عَادِيّ",
 "どはつてん": "ثَائِر, مُسْتَشِيط (يتّسم بغضب شديد بالغ الحدّة) / عَاتٍ, هَائِج ((عَنِ العَنَاصِر الطَّبِيعِيَّة) كَأَنَّهُ يُظْهِر غَضَبًا عَنِيفًا) / شَرِس, ضَارٍ (يَتَّسِمُ بِطَاقَةٍ بَالِغَةِ العُنْفِ وَالشِّدَّة)",
 "どば": "اِخْتَرَقَ / حيلة",
 "どばと": "حمام مستأنس (حمام مستأنس يُربى للرياضة أو الطعام)",
 "どひょう": "حَلْقَة / خَاتَم, خَاتِم / دَقَّ, رَنَّ (الشيءَ: ضربه وأصدر صوتًا عند الدق؛ البابَ: طرقه) / رَنَّ ((رَنَّ) رنينا: صَوَّت وَصَاح؛ (رَنَّ) إِلَيْهِ: أصغى) / تَلْفَنَ, رَنَّ / مثال: واصل زيري دق الجرس. / مُنْتَدَى (مَجْلِس؛ موقع إنترنت ينشر فيه المستخدمون مواضيعا ويردون عليها. (إنترنت))\nمثال: أساهم في هذا المنتدى كل يوم. / كيس رمل (كيس مملوء بالرمل؛ يستخدم كسلاح أو لبناء الجدران أو كثقل موازن)",
 "どひょうぎわ": "حافة الطريق, قارعة الطريق (حدود عشبية على طول الطريق) / حافة, شفا (الحد الذي يحدث أو يتغير بعده شيء ما) / صولجان, عصا سحرية (عصا احتفالية أو رمزية) / حافة, عتبة (منطقة تحدد حداً فاصلاً)\nمثال: على شفا البكاء",
 "どびゃくしょう": "فَلَّاح, فَلَّاحَة",
 "どびんしき": "مفرش شاي (مفرش طاولة صغير)",
 "どぴゅ": "مُتَطَاير, مُنْدَفِع (يُدفَع بقوَّة في مجرى ضيِّق عادةً)",
 "どぴゅっ": "مُتَطَاير, مُنْدَفِع (يُدفَع بقوَّة في مجرى ضيِّق عادةً)",
 "どふん": "تل مدفني, رابية الدفن ((في علم الآثار) كومة من التراب توضع فوق مقابر ما قبل التاريخ)",
 "どぶ": "خَنْدَق, أُخْدُود",
 "どぶいた": "شَعْبِيّ قَاعِدِيّ (يتعلق بعامة الناس بوصفهم جماعة سياسية واقتصادية أساسية) / شَعْبِيّ, قَاعِدِيّ (أساسيّ نابع من القاعدة الشعبية)",
 "どぶいたえいぎょう": "مِنْ بَابٍ إِلَى بَاب (لا يُغفِل أحدًا؛ يتنقّل من بيت إلى بيت) / مِنْ بَابٍ لِبَاب ((عَنِ الرِّحْلَات أَوِ التَّوْصِيلَات) مُبَاشَرَة مِنْ نُقْطَة الأَصْل إِلَى الوِجْهَة)",
 "どぶにすてる": "إسراف, تبديد (نشاط غير مجدٍ أو غير مربح؛ استخدام أو إنفاق أو استهلاك بلا تفكير أو بإهمال) / قَفْر, مَهْجُور (في منطقة نائية وموحشة؛ خَرِبة) / إضرار بالمال, تبديد الممتلكات ((قانون) انخفاض في قيمة العقار ناتج عن فعل أو إهمال) / إتلاف, إهدار (سمة إهدار الموارد)\nمثال: إذا لم يحقق الجهد أي مكسب تعويضي فهو هدر",
 "どぶに捨てる": "إسراف, تبديد (نشاط غير مجدٍ أو غير مربح؛ استخدام أو إنفاق أو استهلاك بلا تفكير أو بإهمال) / قَفْر, مَهْجُور (في منطقة نائية وموحشة؛ خَرِبة) / إضرار بالمال, تبديد الممتلكات ((قانون) انخفاض في قيمة العقار ناتج عن فعل أو إهمال) / إتلاف, إهدار (سمة إهدار الموارد)\nمثال: إذا لم يحقق الجهد أي مكسب تعويضي فهو هدر",
 "どぶねずみ": "جُرْذ أَسْمَر ((جَرَذَت) القرحة جرذا: تعقدت كالجُرَذِ)\nمثال: عبر جرذ الطريق.",
 "どぶん": "بصوت ارتطام, طشّ (بصوت ارتطام قصير ومجوف) / بلبق, سقوط في الماء (صوت جسم مستدير يسقط في سائل دون تناثر)\nمثال: سقطت الكرة بصوت ارتطام في زاوية الملعب",
 "どぶ板": "شَعْبِيّ قَاعِدِيّ (يتعلق بعامة الناس بوصفهم جماعة سياسية واقتصادية أساسية) / شَعْبِيّ, قَاعِدِيّ (أساسيّ نابع من القاعدة الشعبية)",
 "どぶ板営業": "مِنْ بَابٍ إِلَى بَاب (لا يُغفِل أحدًا؛ يتنقّل من بيت إلى بيت) / مِنْ بَابٍ لِبَاب ((عَنِ الرِّحْلَات أَوِ التَّوْصِيلَات) مُبَاشَرَة مِنْ نُقْطَة الأَصْل إِلَى الوِجْهَة)",
 "どへい": "أرباليست, قوس مستعرض فولاذي (نسخة متأخرة من القوس المستعرض بقوس فولاذي) / رامي القوس المستعرض (رامي سهام يستخدم القوس المستعرض (النشاب))",
 "どべ": "قَاع (أَرْض مستوية سهلة تنصب إِليها مياه الأمطار فتمسكها ثم تُنبت العشب؛ القَعْر) / قَعْر / سَالِب\nمثال: نمت في قاعة السينما. / طِين, وَحْل",
 "どほう": "عَرَّادَة",
 "どぼく": "الهندسة المدنية / خادم رجل (خادم من الرجال)",
 "どぼくぎし": "مهندس مدني (مهندس مدرب على تصميم وبناء وصيانة الأشغال العامة (الطرق أو الجسور أو الموانئ وما إلى ذلك))",
 "どぼくこうがく": "الهندسة المدنية",
 "どぼくこうがくしゃ": "مهندس مدني (مهندس مدرب على تصميم وبناء وصيانة الأشغال العامة (الطرق أو الجسور أو الموانئ وما إلى ذلك))",
 "どぼくこうじ": "أشغال عامة (هياكل (مثل الطرق السريعة أو المدارس أو الجسور أو الأرصفة) يتم إنشاؤها على نفقة الحكومة للاستخدام العام)",
 "どぼん": "بصوت ارتطام, طشّ (بصوت ارتطام قصير ومجوف) / بلبق, سقوط في الماء (صوت جسم مستدير يسقط في سائل دون تناثر)\nمثال: سقطت الكرة بصوت ارتطام في زاوية الملعب",
 "どま": "حُفْرَة",
 "どまんじゅう": "تل مدفني, رابية الدفن ((في علم الآثار) كومة من التراب توضع فوق مقابر ما قبل التاريخ)",
 "どまんなか": "النُّقْطَة المَيِّتَة (موضع المرفق عندما يكون على خط واحد مع ذراع التوصيل ولا يبذل عزم دوران)",
 "どみん": "أَصْلِيّ",
 "ども": "لٰكِن, لٰكِنَّ (يفيد الاستدراك ويسبقه نفي أو نهي ويليه اسم مفرد؛ يفيد الاستدراك) / لٰكِن, وَلٰكِنْ (يفيد الاستدراك ويسبقه نفي أو نهي ويليه اسم مفرد؛ يفيد الاستدراك) / إِلَّا, سِوًى (حرف استثناء؛ في : للسؤال المنفي، مرادف لبَلَى في الفصحى) / إلَّا, غَيْرَ (حرف استثناء؛ في : للسؤال المنفي، مرادف لبَلَى في الفصحى)\nمثال: لكن لديك أطفال. / بِالرَغْم مِن",
 "どもこもならん": "مَيْئُوس مِنْه ((غير رسمي للتأكيد) يتجاوز أي أمل في الإصلاح أو المعالجة) / فاقد للأمل, ميؤوس منه (بدون أمل لعدم وجود إمكانية للراحة أو النجاح) / بِلَا أَمَل, مَيْؤُوس مِنْه (محكوم عليه بالفشل حتماً) / عَاجِز, يَائِس ((عن شخص) غير قادر على فعل شيء بمهارة)\nمثال: في عذاب من الحزن الميؤوس منه",
 "どもり": "تَلَجْلَجَ, تَلَعْثَمَ / متلعثم (شخص يتحدث بوقفات وتكرارات لا إرادية) / تَدَرُّج / تَدْرِيج / أعمال ترابية, متراس ترابي (متراس مصنوع من التراب) / جسر ترابي, ساتر ترابي (كومة اصطناعية طويلة من الحجر أو التراب؛ تبنى لحجز المياه أو لدعم طريق أو للحماية)",
 "どもる": "تَلَجْلَجَ, تَلَعْثَمَ",
 "どや": "نزل رخيص (نزل إقامة رخيص)",
 "どやがい": "حي المشردين, منطقة بائسة (حي في المدينة يرتاده المشردون ومدمنو الكحول والمخدرات)",
 "どやがお": "رَاضٍ عَنْ نَفْسِهِ, مُتَرَاخٍ (رَاضٍ عَنْ ذَاتِهِ أَوْ أَفْعَالِهِ إِلَى حَدِّ الخَلَلِ) / مُتَعَجْرِف, مُعْجَبٌ بِنَفْسِهِ (يَتَّسِمُ بِالرِّضَا المُفْرِطِ عَنِ الذَّاتِ)",
 "どやしつける": "ضَرَبَ (معروف، وهو اللطم أو الدق أو الصكّ و ما أشبه؛ النَوْع أو الصنف أو المثال) / إِضْرَاب\nمثال: ضرب سامي زوجته.",
 "どやし付ける": "ضَرَبَ (معروف، وهو اللطم أو الدق أو الصكّ و ما أشبه؛ النَوْع أو الصنف أو المثال) / إِضْرَاب\nمثال: ضرب سامي زوجته.",
 "どやす": "أَصَابَ / ضَرْبَة (المرة الواحدة من الضَرْب؛ اللطمو أو الدقة أو الصكّة؛ ضربة طبل: دقة واحدة منه)\nمثال: تلقى مناد ضربة.",
 "どやつ": "مَن, مين (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "どや街": "حي المشردين, منطقة بائسة (حي في المدينة يرتاده المشردون ومدمنو الكحول والمخدرات)",
 "どや顔": "رَاضٍ عَنْ نَفْسِهِ, مُتَرَاخٍ (رَاضٍ عَنْ ذَاتِهِ أَوْ أَفْعَالِهِ إِلَى حَدِّ الخَلَلِ) / مُتَعَجْرِف, مُعْجَبٌ بِنَفْسِهِ (يَتَّسِمُ بِالرِّضَا المُفْرِطِ عَنِ الذَّاتِ)",
 "どよう": "السَّبْت, يَوْم السَّبْت / قيظ",
 "どようび": "السَّبْت, يَوْم السَّبْت\nمثال: 私は土曜日からここにいます。 — أنا هنا منذ يوم السبت.",
 "どよめき": "جلبة, صخب (فعل إحداث اضطراب صاخب) / جلبة, دوامة (حركة مضطربة) / اضطراب, قلاقل (ثوران أو صخب غير منظم)\nمثال: كان عالقاً في دوامة من العمل",
 "どよもす": "هَزَّ",
 "どら": "جَرَس, نَاقُوس (جَرَسَ الطَّائِرُ: صَوَّتَ؛ جَرَسَ الكَلاَمَ: نَغَمَ بِهِ وَتَكَلَّمَ)\nمثال: ياني يرن الجرس. / بطالة, تسكع (عدم القيام بعمل أو وظيفة) / يَاه, اسمع / هَلَا / جِدًّا (كلمة \"جدا\" لها معانٍ متعددة؛ يرتبط المعنى بالعطاء والكرم، سواء بالمنح أو طلبه)\nمثال: إنها غالية جدا!",
 "どらねこ": "قط شوارع (قط بلا مأوى)",
 "どら猫": "قط شوارع (قط بلا مأوى)",
 "どり": "أَخَذَ (تَنَاوَلَ الشيء بيده، تملكه أو تحكم فيه، بالقوة أو بدونها؛ أمْسَكَ بِالشيء. (يتعدى بالباء)) / أَخَذَ بِـ (تَنَاوَلَ الشيء بيده، تملكه أو تحكم فيه، بالقوة أو بدونها؛ أمْسَكَ بِالشيء. (يتعدى بالباء)) / اِتَّخَذَ / اِسْتَغْرَقَ / اِلْتَقَطَ\nمثال: أخذ الولد يبكي.",
 "どりゅう": "خَال, شَامَة (بمعنى ظَنَّ، استخدام نادر والأغلب استخدام خَيْل أو مَخَالَة؛ أخو الأم. جمعه أخوال للمذكر وخالات للمؤنث) / طَوْبِين, طُوبِين / مُول\nمثال: عندي ابنا خالة.",
 "どりょう": "كَرَم, سَخَاء / قِيَاس / فَاصِلَة / إِجْرَاء / قَاسَ (شديد وصلب، غير لين؛ جافٍ أو يابس في الملمس أو التعامل)\nمثال: قاس طول السرير.",
 "どりょうこうがく": "علم القياس, ميترولوجيا (الدراسة العلمية للقياس)",
 "どりょうのせまい": "ضَيِّقُ الأُفُقِ, مَحَلِّيّ (محدود النظرة والأفق بشكل ضيق) / أبرشي, رعوي (متعلق بالرعية (وحدة كنسية محلية) أو مدعوم منها أو يقع فيها)\nمثال: مدارس رعوية",
 "どりょうのひろさ": "انفتاح ذهني, سعة الأفق (الميل للتسامح مع الآراء المعارضة أو السلوكيات الصادمة أو التغاضي عنها)",
 "どりょく": "جَهْد, جُهْد (بَذَلَ قُصَارَى جُهْدِهِ فِي أَمْرٍ مَا؛ أَتْعَبَ نَفْسَهُ أو غَيْرَهُ بِعَمَلٍ شَاقٍ)\nمثال: لا إنجاز بلا جهد .",
 "どりょくか": "عامل كادح (شخص يعمل بجد مثل العبد)",
 "どりょくもくひょう": "تَحَدٍّ, التَّحَدِّي",
 "どるい": "أعمال ترابية, متراس ترابي (متراس مصنوع من التراب)",
 "どれ": "أَيّ (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير) / مَما / اَلَّذِي\nمثال: لم تقصد أي أذى. / حَسَنًا, بِخَيْر (تقال عند استحسان الفعل أو القول، هَذَا حَسَن) / طيّب / حسنًا (تقال عند استحسان الفعل أو القول، هَذَا حَسَن) / بِئْر, بير / عَيْن, بِئْر (المُعَايَنَة والمشاهدة؛ العين : حاسة البصر والرؤية - مؤنث - تكون للإنسان وغيره من الحيوان . قال ابن السكيت : العين التي يبصر بها الناظر…)\nمثال: حسنا. أنا موافق.",
 "どれい": "عَبْد (خلاف الحُرّ، المَمْلُوْك، من له مالك يملكه. الجمع عبيد وأعبد وعِبدان وعُبدان؛ الإنسان حرا كان أم لا مؤمنا كان أن ملحدا من حيث أنه مملوك لله) / أَمَة (المرأة المملوكة، خلاف الحرة)\nمثال: ماذا أنجز عبد العزيز بوتفليقة؟ / عُبُودِيَّة, رِقّ",
 "どれいしょうにん": "نَخَّاس",
 "どれいせい": "عُبُودِيَّة, رِقّ",
 "どれいせいど": "عُبُودِيَّة, رِقّ",
 "どれいせん": "سفينة عبيد (سفينة تستخدم لنقل العبيد من ديارهم إلى أماكن الاستعباد)",
 "どれいぼうえき": "تجارة الرقيق (الاتجار في العبيد؛ خاصة الأفارقة السود الذين تم نقلهم إلى أمريكا من القرن 16 إلى 19)",
 "どれきせい": "أَسْفَلْت, زِفْت",
 "どれくらい": "كَم وَقْتًا, إِلَى مَتَى",
 "どれぐらい": "كَم وَقْتًا, إِلَى مَتَى",
 "どれだけ": "كَمْ",
 "どれでも": "أَيّ (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير) / أَيّ, كُلّ (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى.",
 "どれどれ": "أَيّ (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير) / مَما / اَلَّذِي\nمثال: لم تقصد أي أذى. / حَسَنًا, بِخَيْر (تقال عند استحسان الفعل أو القول، هَذَا حَسَن) / طيّب / حسنًا (تقال عند استحسان الفعل أو القول، هَذَا حَسَن) / بِئْر, بير / عَيْن, بِئْر (المُعَايَنَة والمشاهدة؛ العين : حاسة البصر والرؤية - مؤنث - تكون للإنسان وغيره من الحيوان . قال ابن السكيت : العين التي يبصر بها الناظر…)\nمثال: حسنا. أنا موافق.",
 "どれにしようかな": "حكرة بكرة",
 "どれにしようかなてんのかみさまのいうとおり": "حكرة بكرة",
 "どれにしようかな天の神様のいうとおり": "حكرة بكرة",
 "どれにしようかな天の神様の言う通り": "حكرة بكرة",
 "どれにも": "لَا أَحَد (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: لا أحب المدرسة.",
 "どれほど": "كَمْ / بِأَيَّةِ طَرِيقَة, عَلَى كُلِّ حَال / كَثِير (ما كان عدده كبيرا؛ متبوعًا بمِنْ: عدد كبير أو كمية كبيرة من الشيء) / كَثِير, متعدد (ما كان عدده كبيرا؛ متبوعًا بمِنْ: عدد كبير أو كمية كبيرة من الشيء)\nمثال: هذا أسهل بكثير.",
 "どれも": "أَيّ (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير) / أَيّ, كُلّ (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى.",
 "どれもこれも": "كُلّ, جَمِيع",
 "どれ位": "كَم وَقْتًا, إِلَى مَتَى",
 "どれ程": "كَمْ / بِأَيَّةِ طَرِيقَة, عَلَى كُلِّ حَال / كَثِير (ما كان عدده كبيرا؛ متبوعًا بمِنْ: عدد كبير أو كمية كبيرة من الشيء) / كَثِير, متعدد (ما كان عدده كبيرا؛ متبوعًا بمِنْ: عدد كبير أو كمية كبيرة من الشيء)\nمثال: هذا أسهل بكثير.",
 "どろ": "طِين, وَحْل / لِصّ, لِصَّة / أَنْدْرُويِد",
 "どろえのぐ": "غسول ملون (غسول من الجير أو طلاء مائي آخر ملون بصبغة)",
 "どろおとし": "ممسحة الباب (حصيرة توضع خارج الباب الخارجي لمسح الأحذية قبل الدخول) / ضعيف, واهن (شخص ضعيف جسدياً وغير فعال)",
 "どろがめ": "سلحفاة الطين (سلحفاة مياه عذبة تعيش في القاع في الأنهار الطينية لأمريكا الشمالية والوسطى)",
 "どろくさい": "خشن, غير مهذب ((للأشخاص وسلوكهم) غير مهذب؛ فظ) / خام, غير مكرر (غير مكرر أو معالج)\nمثال: كيف يمكن لفتاة مهذبة أن تنجذب لرجل خشن كهذا؟",
 "どろだんご": "حشرة, دنيء (شخص ذو شخصية سيئة أو غير أخلاقية لا يستحق الاحترام)",
 "どろち": "طِين, وَحْل",
 "どろっと": "بِاكْتِظَاظ, بِكَثَافَة (بطريقة مركزة) / بتتابع سريع, بكثافة (في تتابع سريع) / بلسان ثقيل (التحدث بلفظ ضعيف كما لو كان اللسان ثقيلاً) / بطبقة سميكة, بكثافة (بسمك؛ بطريقة سميكة)\nمثال: المنازل القديمة غالباً ما تكون مكتظة بكثافة لدرجة أنه ربما يجب هدم ثلاثة أو أربعة مقابل كل منزل جديد يبنى",
 "どろどろ": "لَزِج / مُغَطًّى بِالطِّين, مُوحَل (متّسخ وفوضويّ؛ مغطّى بالوحل أو الطين) / عَكِر, مُتَكَدِّر (عكر بسبب الرواسب أو الترسّبات؛ يُقال عن السوائل) / كَدِر, مُعَكَّر ((في اللون) تغيّر بسبب الشوائب؛ غير ساطع أو صافٍ) / مُسْتَنْقَعِيّ, وَحِل ((عن التربة) ليّنة ومشبَعة بالماء) / قَرْقَرِيّ, هَدِير (صوت مستمر ممتلئ ومنخفض النبرة ونابض) / تذمر, قرقرة (ضجيج مستمر منخفض ومكتوم وعالٍ)\nمثال: سمعوا هدير الرعد",
 "どろなわしき": "فِي اللَّحْظَةِ الأَخِيرَة (قُبَيْل الموعد النهائي مباشرة)",
 "どろぬま": "مستنقع / مأزق, معضلة (حالة من عدم اليقين أو الحيرة تتطلب خاصة اختياراً بين خيارات غير مواتية على قدم المساواة) / مأزق, ورطة (موقف يصعب الخلاص منه، خاصة إذا كان مزعجاً أو شاقاً)\nمثال: وجد نفسه في مأزق محرج للغاية",
 "どろばち": "دبور الخزف (أي من دبابير انفرادية متنوعة تبني خلايا على شكل مزهرية من الطين لبيضها)",
 "どろぶかい": "مُسْتَنْقَعِيّ, وَحِل ((عن التربة) ليّنة ومشبَعة بالماء)",
 "どろぼう": "لِصّ, لِصَّة / سَرِقَة, سَرَقَة",
 "どろぼうせいじ": "كْلِيبْتُقْرَاطِيَّة",
 "どろぼうねこ": "زَانٍ (زان - يزين، زينا؛ زانه: حلاه، حسنه) / الزَّانِي / زَانِيَة (اسم فاعلة من زَنَى، المرأة التي تمارس الجنس مع غير زوجها أو بدون زواج)",
 "どろぼうまわり": "دوران باتجاه عقارب الساعة, دوران يميني (دوران إلى اليمين)",
 "どろぼうネコ": "زَانٍ (زان - يزين، زينا؛ زانه: حلاه، حسنه) / الزَّانِي / زَانِيَة (اسم فاعلة من زَنَى، المرأة التي تمارس الجنس مع غير زوجها أو بدون زواج)",
 "どろぼう猫": "زَانٍ (زان - يزين، زينا؛ زانه: حلاه، حسنه) / الزَّانِي / زَانِيَة (اسم فاعلة من زَنَى، المرأة التي تمارس الجنس مع غير زوجها أو بدون زواج)",
 "どろぼー": "لِصّ, لِصَّة / سَرِقَة, سَرَقَة",
 "どろまみれ": "مُغَطًّى بِالطِّين, مُوحَل (متّسخ وفوضويّ؛ مغطّى بالوحل أو الطين) / عَكِر, مُتَكَدِّر (عكر بسبب الرواسب أو الترسّبات؛ يُقال عن السوائل) / كَدِر, مُعَكَّر ((في اللون) تغيّر بسبب الشوائب؛ غير ساطع أو صافٍ) / مُسْتَنْقَعِيّ, وَحِل ((عن التربة) ليّنة ومشبَعة بالماء)",
 "どろまんじゅう": "فطيرة طين (كتلة من الطين شكلها طفل على شكل فطيرة)",
 "どろみず": "حي البغاء, منطقة الضوء الأحمر (حي يكثر فيه وجود بيوت الدعارة)",
 "どろゆ": "حمام طين (حمام في الطين الدافئ (لعلاج الروماتيزم مثلاً))",
 "どろよけ": "واقي الطين (قطعة منحنية فوق عجلة دراجة أو دراجة نارية لحماية الراكب من الماء أو الطين الذي تقذفه العجلات) / مِصَدّ",
 "どろり": "سَمِيك, غَلِيظ / غَلِيظ",
 "どろんこ": "طِين, وَحْل / مُغَطًّى بِالطِّين, مُوحَل (متّسخ وفوضويّ؛ مغطّى بالوحل أو الطين) / عَكِر, مُتَكَدِّر (عكر بسبب الرواسب أو الترسّبات؛ يُقال عن السوائل) / كَدِر, مُعَكَّر ((في اللون) تغيّر بسبب الشوائب؛ غير ساطع أو صافٍ) / مُسْتَنْقَعِيّ, وَحِل ((عن التربة) ليّنة ومشبَعة بالماء)",
 "どろ団子": "حشرة, دنيء (شخص ذو شخصية سيئة أو غير أخلاقية لا يستحق الاحترام)",
 "どをかさねる": "كَرَّرَ, أَعَادَ (أَعَادَ)\nمثال: كرر الشهادة بعدي.",
 "どをこした": "مُسْرِف",
 "どん": "طَمُعَ, طَمِعَ / كَلِيل / فَرْقَعَة / بِدِقَّة / سيد (صيغة خطاب للرجل)",
 "どんあい": "مَوَدَّة / مُلْحَق / مُرْفَق (مَا يُتَّكَأُ عَلَيْهِ)\nمثال: يؤلمني ذراعي من الكتف إلى المرفق.",
 "どんかく": "زَاوِيَة مُنْفَرِجَة",
 "どんかくさんかくけい": "مثلث منفرج الزاوية (مثلث يحتوي على زاوية داخلية منفرجة)",
 "どんかつ": "اِنْتِصَار, نَصْر",
 "どんかん": "بَلِيد, غَلِيظ الفَهْم ((غير رسمي) غبيّ وبطيء الفهم)\nمثال: 概してエリート達は批判に対して鈍感である。 — بشكل عام، النخبة ليسوا حساسين تجاه النقد.",
 "どんが": "بُرْعُم",
 "どんがめ": "سلحفاة لينة الصدفة (سلحفاة مائية شرهة ذات صدفة مرنة مسطحة مغطاة بجلد جلدي؛ يمكن أن تسبب عضات مؤلمة)",
 "どんきしょう": "بلع الهواء (ابتلاع الهواء (يتبعه عادة تجشؤ وانزعاج وانتفاخ))",
 "どんくさい": "بَطِيء / أَبْطَأَ, بَطَّأَ",
 "どんぐり": "بَلُّوط, بَلُّوطَة",
 "どんぐりかぼちゃ": "قرع البلوط (قرع صغير مضلع أخضر داكن أو أصفر ذو لب أصفر إلى برتقالي) / قرع البلوط (نبات قرع يحمل ثماراً صغيرة على شكل بلوط لها لب أصفر وقشرة خضراء داكنة أو صفراء مع تلال طولية)",
 "どんぐりまなこ": "سكاد كبير العين (من المياه الساحلية الأطلسية؛ تستخدم عادة كطعم)",
 "どんぐり眼": "سكاد كبير العين (من المياه الساحلية الأطلسية؛ تستخدم عادة كطعم)",
 "どんけつ": "أرداف, ألية (الجزء اللحمي من جسم الإنسان الذي يجلس عليه) / تذييل, ذيل (أي نتوء يشبه ذيل الحيوان) / أواخر, ذيل (وقت الجزء الأخير من شيء ما)\nمثال: يستحق ركلة جيدة في مؤخرته / حِمَار (حَيْوَان مُسْتَأْنَس من الجِنْس الذي ينتمي اليه الحِصَان (انظر الصورة). مؤنثه أَتَان؛ صفة تَحْقِيْر تطلق على الغَبِيّ أو الأَحْمَق. مؤنثه حِمَارَة) / حُمار (حَيْوَان مُسْتَأْنَس من الجِنْس الذي ينتمي اليه الحِصَان (انظر الصورة). مؤنثه أَتَان؛ صفة تَحْقِيْر تطلق على الغَبِيّ أو الأَحْمَق. مؤنثه حِمَارَة) / عَجِيزَة, مُؤَخَّرَة\nمثال: هن بحاجة لحمار.",
 "どんこん": "بَطِيء الفَهْم, ضَعِيف العَقْل (متأخر في التطور العقلي والذهني)",
 "どんさい": "غَبَاء, غَبَاوَة (بمعنى أن يخفى الأمر، يقال أيضا غَبَاءَة وغَبَاوَة والغباء أعمّ؛ بمعنى ضد الفِطْنة والذَكاء، يقال أيضا غَبَاوة)\nمثال: ما تقترحه غباء.",
