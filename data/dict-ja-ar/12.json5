 "とおもうと": "مَا أَن, حَالَمَا (انظر مَا)\nمثال: هلا! ما الجديد؟",
 "とおもったら": "مَا أَن, حَالَمَا (انظر مَا)\nمثال: هلا! ما الجديد؟",
 "とおや": "بَعِيد المَدَى (يغطي مسافة طويلة)\nمثال: مكالمة بعيدة المسافة",
 "とおり": "شَارِع, زَنَقَة / مُرُور / تَدَفُّق / إرسال, بث (فعل إرسال رسالة؛ التسبب في نقل رسالة) / اِخْتِرَاقْ (اختراق الرياح مرورها؛ اخترقت الخيل ما بين القرى والشجر:تخلّلتها)",
 "とおりあめ": "شَتْوَة, مَطْرَة\nمثال: استحم زيري هناك.",
 "とおりあわせる": "صَادَفَ (لَقِيَ، وَافَقَ، وَجَدَ؛ وَاجَهَ، لَاقَى، وَجَدَ)\nمثال: صادف مشكلا صعبا.",
 "とおりいっぺん": "سَطْحِيّ, عَابِر (مُسْتَعْجِل وبِدُون اهْتِمَام بِالتَّفَاصِيل؛ غَيْر شَامِل) / فُرْصَة",
 "とおりがかり": "اجتياز, نجاح (النجاح في استيفاء اختبار أو شرط)\nمثال: كان مستقبله يعتمد على اجتيازه لذلك الاختبار",
 "とおりがけ": "اجتياز, نجاح (النجاح في استيفاء اختبار أو شرط)\nمثال: كان مستقبله يعتمد على اجتيازه لذلك الاختبار",
 "とおりことば": "حكمة, مثل (قول مكثف ولكنه لا ينسى يجسد حقيقة مهمة من التجربة يعتبرها الكثير من الناس صحيحة) / رطانة, لغة اصطلاحية (مصطلحات تقنية متخصصة مميزة لموضوع معين)\nمثال: هم لا يتحدثون لغتنا",
 "とおりすぎる": "مَرَّرَ, مَرَّ\nمثال: أسأل عن الطريق.",
 "とおりな": "اسم تجاري مستعار ((قانون) اسم تمارس به شركة أعمالها وليس الاسم القانوني للشركة كما هو مبين في…)",
 "とおりぬける": "اِخْتَرَقَ, نَفَذَ",
 "とおりま": "سلاح قاطع (سلاح (سيف أو خنجر) يستخدم للقطع)",
 "とおりまてき": "عَشْوَائِيّ",
 "とおりみち": "قِطْعَة (القِطْعَةُ: الْجُزْءَ أو الحِصَّة من الشيءِ؛ القِطْعَةُ: فقرة قصيرة عادة من…)\nمثال: يصنع قطعة أثاث خشبية.",
 "とおり道": "قِطْعَة (القِطْعَةُ: الْجُزْءَ أو الحِصَّة من الشيءِ؛ القِطْعَةُ: فقرة قصيرة عادة من…)\nمثال: يصنع قطعة أثاث خشبية.",
 "とおる": "رَكَضَ (عَدَا)\nمثال: إنها تحب الركض. / اِخْتَرَقَ / حَمَلَ (رَفَعَ، أَقَلَّ)\nمثال: حمل سامي سلاحه. / مَرَّرَ, مَرَّ\nمثال: أسأل عن الطريق.",
 "とか": "هَكَذَا\nمثال: 包丁とか鍋とか、台所用品を持参すること。 — لا تنس جلب أدوات المطبخ؛ مثل: السكاكين، وآنية الطبخ. / ا (الْأَلِفُ بِدُونِ هَمْزَةٍ ؛ تُسْتَخْدَمُ فِي آخِرِ أَوْ وَسَطِ الكلام لمد…)\nمثال: يجب على توم عدم إعطاء إي إهتمام لما قالته ماري.",
 "とかい": "مَدِينَة, بَلَد",
 "とかいか": "تَمَدُّن, تَحَضُّر",
 "とかいてき": "حَضَرِيّ, مَدَنِيّ",
 "とかいは": "حَضَرِيّ, مَدَنِيّ",
 "とかいふう": "تمدن, حضرية (صفة أو طابع الحياة في المدينة أو البلدة)\nمثال: هناك فرق مهم بين البداوة والتمدن",
 "とかき": "قالب تشكيل (أداة تستخدم في المسبك لتشكيل قالب في الرمل)",
 "とかく": "بأي حال, على أي حال (تستخدم للإشارة إلى أن بياناً يشرح أو يدعم بياناً سابقاً)\nمثال: على أي حال، هو ميت الآن / مُخْتَلِف, مُتَنَوَّع",
 "とかげざ": "سِحْلِيَّة, ضَبّ",
 "とかげ座": "سِحْلِيَّة, ضَبّ",
 "とかしバター": "زبدة مصفاة, سمن (زبدة توضح بالتسخين وإزالة رواسب جوامد الحليب)",
 "とかす": "ذَابَ, انْصَهَرَ (تحوّل الشيء من حالته الصلبة إلى حالة سائلة نتيجة الحرارة؛ زال أو تلاشى شيئًا…)\nمثال: ذاب ذلك الجليد. / تلاشي تدريجي, مزج ((في الفيلم) انتقال تدريجي من مشهد إلى التالي؛ يتم تركيب المشهد التالي تدريجياً…) / فَقَدَ\nمثال: خسر توم وظيفته. / فُرْشَاة\nمثال: مشط شعرك قبل أن تخرج.",
 "とかなんとか": "أَوْ كَمَا قَالَ (يفيد الشك؛ يفيد التقسيم)\nمثال: أكون أو لا أكون؟",
 "とかり": "ذُو مِقْبَض طَوِيل (لَهُ مِقْبَض أَوْ يَد طَويلَة)",
 "とか何とか": "أَوْ كَمَا قَالَ (يفيد الشك؛ يفيد التقسيم)\nمثال: أكون أو لا أكون؟",
 "とが": "رَسْم (سَم الشَّيءَ :خطّه رسَم مُربَّعًا/ صورةً/ شكلاً؛ رسَم : كَتَبَ)\nمثال: واصل زيري الرسم. / رَشِيق, ظَرِيف / خَطَأ (تعني ضدّ الصواب. يشمل ذلك الفعل، القول، والرأي. يُستخدم الفعل \"أخطأ\" للدلالة…)\nمثال: كان خطأ حاسوبي. / خَطِيئَة, إِثْم\nمثال: أثمة ما تريد إخباري عنه؟",
 "とがった": "لَاذِع, مَقْصُود (مُبَاشِر وَوَاضِح فِي المَعْنَى أَوِ الإِشَارَة؛ غَالِبًا غَيْر مُسْتَحَبّ) / حَادّ (مَالَ وَانْحَرَفَ عَنِ الطَّرِيقِ؛ تَجَنَّبَ شَيْئًا أَوِ الْاِلْتِزَامَ…)\nمثال: عندك ذاكرة حادة. / مُسْتَفِز / لَافِت, مُلْفِتٌ لِلنَّظَرِ (لَهُ صِفَةٌ تَفْرِضُ نَفْسَهَا عَلَى الِانْتِبَاهِ)",
 "とがにん": "جَانٍ ((جَانَ) جونا وجونة: اسود)",
 "とがめ": "لَوْم, مَلَامَة",
 "とがめだて": "تَذَمُّر, تَصَيُّد الْأَخْطَاء (نقد تافه وغير مبرر ومستمر)",
 "とがめる": "لَوْم, مَلَامَة / سُؤَال, سؤال (سُؤَال)\nمثال: أجب على السؤال. / زُبّ, زُبْر (في : اللحية أو مقدمها؛ في : الأنف)",
 "とがらす": "شَحَذَ (سنّ شيئًا ليصبح حادًا أو أكثر قدرة على القطع؛ استثار أو حفّز قوة ذهنية أو…) / رَفَعَ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ)\nمثال: رفع سامي نظارته.",
 "とがらせる": "شَحَذَ (سنّ شيئًا ليصبح حادًا أو أكثر قدرة على القطع؛ استثار أو حفّز قوة ذهنية أو…) / رَفَعَ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ)\nمثال: رفع سامي نظارته.",
 "とがり": "نُقْطَة (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه)\nمثال: هذه هي نقطة ضعفه.",
 "とがりねずみ": "زَبَابَة",
 "とがりょう": "غَرَامَة",
 "とがりアーチ": "قوس مدبب (قوس بقمة مدببة؛ سمة من سمات العمارة القوطية)",
 "とがん": "عين أرنبية, لاقوفثالموس (حالة غير طبيعية لا يمكن فيها إغلاق العين تماماً)",
 "とき": "وَقْت (\"بَقِيَ وَقْتاً عِنْدَهُ \" : أَيْ مِقْدَاراً مِنَ الزَّمَنِ؛ \"جَاءَ فِي…)\nمثال: حان وقت الذهاب. / فُرْصَة, مُنَاسَبَة\nمثال: أرى مرآة مناسبة / فُرْصَة / فِي (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي. / شِعَار (العلامة: وذلك من شعار العقلاء (مادة حلم من مجمع بحار الأنوار))\nمثال: الشعار ☭ هو رمز الشيوعية.",
 "ときあかし": "تَفْسِير, شَرْح",
 "ときあかす": "شَرَحَ (شَرَّحَ، قَطَّعَ قِطَعَاً رِقَاقاً؛ فَسَّرَ، أَوْضَحَ، بَيَّنَ)\nمثال: شكرا على الشرح. / ذَابَ, حَلَّ (تحوّل الشيء من حالته الصلبة إلى حالة سائلة نتيجة الحرارة؛ زال أو تلاشى شيئًا…)\nمثال: ذاب ذلك الجليد.",
 "ときあたかも": "عندئذ, في تلك اللحظة (في وقت معين في الماضي)\nمثال: عندئذ انطلق البوق",
 "ときいろ": "وَرْدِيّ, زَهْرِيّ (هُو ما كان بِلَوْنِ الورد؛ ٌ إِلَىٰ ٱلْوَرْدِ)\nمثال: لا أظن أن توم سيشتري مظلة وردية.",
 "ときおよぶ": "ذِكْر (ذَكَرَ الشيءَ: نطق به أو أشار إليه بالكلام؛ ذَكَرَ شخصًا: استحضره في الذاكرة)\nمثال: قتله ذكر زرافة.",
 "ときおり": "أَحْيَانًا, سَاعَات",
 "ときがかいけつする": "الزَّمَن يُعَالِجُ كُل الأَجْرَاح",
 "ときがたい": "صعب المراس, عنيد (غير طيع؛ صعب الإدارة أو التشكيل)\nمثال: طبع عنيد",
 "とききかせる": "شَرَحَ (شَرَّحَ، قَطَّعَ قِطَعَاً رِقَاقاً؛ فَسَّرَ، أَوْضَحَ، بَيَّنَ)\nمثال: شكرا على الشرح.",
 "ときしめす": "شَرَحَ (شَرَّحَ، قَطَّعَ قِطَعَاً رِقَاقاً؛ فَسَّرَ، أَوْضَحَ، بَيَّنَ)\nمثال: شكرا على الشرح.",
 "ときすすめる": "أَقْنَعَ",
 "ときそう": "بوجونيا (أي أوركيد مستنقعات قوي التحمل من جنس بوجونيا: بساتين فاكهة أرضية ذات جذامير…)",
 "ときたま": "أحياناً, بين الحين والآخر (بشكل متقطع وغير متكرر)\nمثال: كان متغطرساً وقاسياً أحياناً",
 "ときつ": "فِي الوَقْت المُنَاسِب (في وقت ملائم)\nمثال: وصلت رسالتك في الوقت المناسب",
 "ときつける": "أَقْنَعَ",
 "ときとして": "أَحْيَانًا, سَاعَات",
 "ときどき": "أَحْيَانًا, سَاعَات / موسمي (يحدث في أو يعتمد على موسم معين)\nمثال: عمالة موسمية",
 "ときなしだいこん": "على مدار السنة (يعمل أو يستمر طوال العام)\nمثال: منتجع يعمل على مدار السنة",
 "ときならぬ": "مُفَاجِئ",
 "ときに": "بِالْمُنَاسَبَةِ, عَلَى فِكْرَةٍ / أَحْيَانًا, سَاعَات / بِدِقَّة",
 "ときには": "أَحْيَانًا",
 "ときの": "مَرْغُوب, مَطْلُوب (مَطْلُوبٌ كَثِيرًا)",
 "ときのうん": "فُرْصَة",
 "ときのけ": "مَرَض مُعْدٍ (أصابه مرضٌ أو علّة أو سَقَم)\nمثال: هذا المرض قلبي.",
 "ときのこえ": "شِعَار (العلامة: وذلك من شعار العقلاء (مادة حلم من مجمع بحار الأنوار))\nمثال: الشعار ☭ هو رمز الشيوعية.",
 "ときのべる": "شَرَحَ (شَرَّحَ، قَطَّعَ قِطَعَاً رِقَاقاً؛ فَسَّرَ، أَوْضَحَ، بَيَّنَ)\nمثال: شكرا على الشرح.",
 "ときの声": "شِعَار (العلامة: وذلك من شعار العقلاء (مادة حلم من مجمع بحار الأنوار))\nمثال: الشعار ☭ هو رمز الشيوعية.",
 "ときの気": "مَرَض مُعْدٍ (أصابه مرضٌ أو علّة أو سَقَم)\nمثال: هذا المرض قلبي.",
 "ときはかねなり": "اَلْوَقْتُ مِنْ ذَهَبٍ",
 "ときはなす": "حَرَّرَ (يُصَغَّرُ عَلَى حُرَيْحٍ وَيُجْمَعُ عَلَى أَحْرَاحٍ؛ ضد الْعَبْدِ)\nمثال: هو,البارحة حرر من الحبس.",
 "ときはなつ": "أَطْلَقَ سَرَاح, حَرَّرَ",
 "ときふせる": "أَقْنَعَ",
 "ときほぐす": "نَبْض\nمثال: ضرب سامي زوجته. / اِسْتَرْخَى",
 "ときめかす": "تمايل, رفرفة (فعل التحرك ذهاباً وإياباً)\nمثال: لقد ذهلوا من الاضطراب العنيف الذي سببوه",
 "ときめき": "ضَرْب (معروف، وهو اللطم أو الدق أو الصكّ و ما أشبه؛ النَوْع أو الصنف أو المثال)\nمثال: ضرب سامي زوجته.",
 "ときめく": "تمايل, رفرفة (فعل التحرك ذهاباً وإياباً)\nمثال: لقد ذهلوا من الاضطراب العنيف الذي سببوه / ازدهر",
 "ときょうそう": "سباق جري, عدو (سباق يتم الجري فيه على الأقدام)\nمثال: حطمت الرقم القياسي في سباق النصف ميل",
 "ときよ": "فِي (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "ときより": "أَحْيَانًا, سَاعَات",
 "ときわ": "أَبَدِيّ, أَزَلِيّ (مستمرّ إلى الأبد أو إلى أجل غير مُسمًّى) / دائم الخضرة ((عن النباتات والشجيرات) تحمل أوراق الشجر طوال العام)",
 "ときわぎょりゅう": "خشب اللحم (شجرة تنتج خشباً محمراً ثقيلاً صلباً)",
 "ときわざくら": "الربيعية, بريملة",
 "ときをうつさず": "حَالاً (مباشرةً، فوراً، دون تأخير؛ في هذه الأثناء، في الوضع الحالي)\nمثال: سأكون معك حالا.",
 "ときをえた": "فِي الوَقْت المُنَاسِب (في وقت ملائم)\nمثال: وصلت رسالتك في الوقت المناسب",
 "ときをおなじくして": "فِي نَفْس اَلْوَقْت (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "ときん": "طلاء معدني (وضع طبقة رقيقة من المعدن (كما هو الحال في التحليل الكهربائي))",
 "ときんば": "أَحْيَانًا",
 "とき色": "وَرْدِيّ, زَهْرِيّ (هُو ما كان بِلَوْنِ الورد؛ ٌ إِلَىٰ ٱلْوَرْدِ)\nمثال: لا أظن أن توم سيشتري مظلة وردية.",
