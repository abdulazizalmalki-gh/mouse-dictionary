 "ウズベキスタン": "أُوزْبَكِسْتَان, أُزْبَكِسْتَان",
 "ウズベク": "أُوزْبَكِسْتَان, أُزْبَكِسْتَان",
 "ウズベクご": "أُوزْبَكِيّ, أُوزْبَكِيّة",
 "ウズベク語": "أُوزْبَكِيّ, أُوزْبَكِيّة",
 "ウズラ": "سُمَّان, سَلْوَى",
 "ウソ": "ضَجَعَ, تَمَدَّدَ / كَذَبَ, كدب (مصدر للفعل كَذَبَ؛ نقيض الصِدْق، قَوْل ما يخالف ما يعلم القَائِل أنه حَقِيقَة) / كَذْبَة, كِذْبَة\nمثال: اتهمتني بالكذب. / أَسَاء اَلْفَهْم, أَخْطَأَ / خَطَأ, غَلْطَة (تعني ضدّ الصواب. يشمل ذلك الفعل، القول، والرأي. يُستخدم الفعل \"أخطأ\" للدلالة على عدم الإصابة…؛ قام بعمل بعيد عن الصواب أو مخالف للحق سواء كان ذلك في السلوك أو القول أو الكتابة)\nمثال: كان خطأ حاسوبي.",
 "ウソつき": "كَذَّاب, كَذَّابَة / كَذِب (مصدر للفعل كَذَبَ؛ نقيض الصِدْق، قَوْل ما يخالف ما يعلم القَائِل أنه حَقِيقَة)\nمثال: اتهمتني بالكذب.",
 "ウソつけ": "كَذَّاب, كَذَّابَة",
 "ウソなき": "دُمُوع اَلتَّمَاسِيح",
 "ウソのよう": "لا يصدق (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: لا أحب المدرسة.",
 "ウソ泣き": "دُمُوع اَلتَّمَاسِيح",
 "ウタリ": "أَهْل, أَقَارِب (أَهِلَ به يَأْهَلُ أَهَلاً: أنِس، فهو أَهِلٌ)\nمثال: أهل أبدو أنيقا؟ / لُغَة آيْنْوِيَّة (هِيَ مجموعة من الأصوات التي يصدرها الإنسان على شكل كلمات منظمة بقواعد، ليتواصل به الناس وينقلون به الافكار والمعاني، اللسان؛ يقصد بها أحيانا اللهجة)\nمثال: الأمازيغية لغة.",
 "ウチら": "نحن (ضَمِيرُ رَفْعٍ مُنْفَصِلٌ لِلْمُثَنَّى وَالْجَمْعِ ( مُذَكَّراً وَمُؤَنَّثاً )؛ ضَمِيرُ رَفْعٍ مُنْفَصِلٌ لِلْمُتَكَلِّمِ فِي حَالَةِ التَّعْظِيمِ)\nمثال: نحن مهتمون جدا. / أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى.",
 "ウッカリ": "عَنْ غَيْرِ قَصْدٍ, بِدُونِ قَصْدٍ (يُفِيدُ المُجَاوَزَة؛ يُفِيدُ الاستعلاء، عَلَى)\nمثال: سألتني عن عمري.",
 "ウッキウキ": "بِسَعَادَة",
 "ウッス": "يَاه, اسمع / هَلَا / نَعَم سَيِّدِي (الإبِل والبَقَر والغَنَم. وتسمى نَعَم فقط إذا كان فيها إبل، فالإبل لوحدها نَعَم…)\nمثال: أنت نعم الطالب.",
 "ウッスラ": "قَلِيلًا",
 "ウッテガエ": "تَغَيَّرَƒ / غَيَّرَ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به) / تَغْيِير, تَبْدِيل / فَكَّة / بَاقٍ (باقٍ ، الباقِيٌ جمع باقون ( للعاقل ) وبَواقٍ ، مؤ باقية ، جمع مؤ باقيات وبَواقٍ؛ باقٍ إلَى الأبَدِ : خالِدٌ) / تَغْيِير\nمثال: أنا غير متفاجئ.",
 "ウッディ": "خَشَبِيّ",
 "ウッディー": "خَشَبِيّ",
 "ウッド": "خَشَب, خشب (هو ما غَلَظَ وصَلُبَ من أصول الشَجَر وفروعها مثل الجِذْع والأغْصَان؛ هو ما صنع من جذوع أو أغصان الشَجَر)\nمثال: نحن نقطع الخشب.",
 "ウッドペッカー": "نَقَّار الخَشَب",
 "ウッヒョ": "عَجَبًا / سُبْحَانَ الله (مصدر للفعل سَبَحَ؛ تُقال حصرًا للَّٰه، كما في العبارة \"سُبْحَانَ اللَّٰهِ\")\nمثال: سبحان الله عما يشركون.",
 "ウッヒョー": "عَجَبًا / سُبْحَانَ الله (مصدر للفعل سَبَحَ؛ تُقال حصرًا للَّٰه، كما في العبارة \"سُبْحَانَ اللَّٰهِ\")\nمثال: سبحان الله عما يشركون.",
 "ウップス": "آهٍ (صوت يستخدم للدلالة على الشعور بالألم العاطفي أو الجسدي؛ ألم، إما عاطفي أم جسدي)\nمثال: آه ، هناك فراشة!",
