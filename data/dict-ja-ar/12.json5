 "にげる": "هَرَبَ (الفِرارُ)\nمثال: هرب كأرنب خائف. / تَجَنَّبَ (امتنع عن التعامل مع شخص أو موقف معين؛ ابتعد عن شيء أو تجنبه عمدًا لتفاديه)\nمثال: تجنب الازدحام المروري / هَرَبَ (الفِرارُ) / فِرَار, هُرُوب\nمثال: هرب كأرنب خائف.",
 "にげん": "ازدواجية, تعامل بوجهين (التصرف بسوء نية؛ الخداع بالتظاهر بامتلاك مجموعة من النوايا بينما يتصرف تحت تأثير أخرى) / ذُو وَجْهَيْن, مُرَاوِغ (يتَّسم بخداع متعمَّد خاصَّة بإظهار مشاعر والتصرُّف بمشاعر أخرى) / ازْدِوَاجِيَّة, ثَنَوِيَّة ((في الهندسة) قابلية تبادل أدوار النقاط والمستويات في نظريات الهندسة الإسقاطية) / ازدواجية, ازدواجية الموجة والجسيم ((فيزياء) خاصية المادة والإشعاع الكهرومغناطيسي التي تتميز بحقيقة أن بعض الخصائص يمكن تفسيرها بشكل أفضل بنظرية الموجة والبعض الآخر بنظرية الجسيمات) / انقسام ثنائي, ثنائية (كون الشيء ثنائياً؛ تصنيف إلى جزأين أو فئتين فرعيتين متضادتين)\nمثال: الانقسام بين الثقافة الشرقية والغربية",
 "にげんし": "ثنائي الذرة (متعلق بجزيء يتكون من ذرتين)\nمثال: جزيء ثنائي الذرة",
 "にげんせい": "ازْدِوَاجِيَّة, ثَنَوِيَّة ((في الهندسة) قابلية تبادل أدوار النقاط والمستويات في نظريات الهندسة الإسقاطية) / ازدواجية, ازدواجية الموجة والجسيم ((فيزياء) خاصية المادة والإشعاع الكهرومغناطيسي التي تتميز بحقيقة أن بعض الخصائص يمكن تفسيرها بشكل أفضل بنظرية الموجة والبعض الآخر بنظرية الجسيمات) / انقسام ثنائي, ثنائية (كون الشيء ثنائياً؛ تصنيف إلى جزأين أو فئتين فرعيتين متضادتين)\nمثال: الانقسام بين الثقافة الشرقية والغربية",
 "にげんてき": "مُثَنًّى / مُثَنَّى",
 "にげんろん": "ثَنَوِيَّة",
 "にこう": "ثُنَائِيّ الاِسْم, ذُو اسْمَيْن (يحمل اسمين أو يتّسم بهما، خاصّةً اسمَي الجنس والنوع في التصنيف الأحيائيّ) / ثنائي الحد, حداني (من أو متعلق أو مكون من حدين) / حدانية, ذو حدين ((رياضيات) كمية معبر عنها كمجموع أو فرق لحدين؛ متعدد حدود بحدين)\nمثال: تعبير ثنائي الحد",
 "にこうえんざん": "عملية ثنائية, عملية منطقية (عملية تتبع قواعد الجبر البولياني؛ يأخذ كل معامل والنتيجة إحدى قيمتين)",
 "にこうしき": "ثُنَائِيّ الاِسْم, ذُو اسْمَيْن (يحمل اسمين أو يتّسم بهما، خاصّةً اسمَي الجنس والنوع في التصنيف الأحيائيّ) / ثنائي الحد, حداني (من أو متعلق أو مكون من حدين) / حدانية, ذو حدين ((رياضيات) كمية معبر عنها كمجموع أو فرق لحدين؛ متعدد حدود بحدين)\nمثال: تعبير ثنائي الحد",
 "にこうていり": "نَظَرِيَّةُ ذَاتِ الْحَدَّيْنِ, مُبَرْهَنَةُ ذَاتِ الْحَدَّيْنِ (مؤنث نَظَرْيّ، أي يفحض بالنظر لا بالإختبار؛ قضية غير مثبتة ولا مبرهنة لتفسير أمر ما)\nمثال: إنها مجرد نظرية.",
 "にこうぶんぷ": "توزيع برنولي, توزيع ثنائي الحدين (توزيع نظري لعدد النجاحات في مجموعة محدودة من المحاولات المستقلة باحتمال نجاح ثابت)",
 "にこくかん": "ثُنَائِيّ",
 "にこくかんしゅぎ": "تناظر ثنائي, تناظر جانبي (خاصية التناظر حول مستوى عمودي)",
 "にこくかんそうごしゅぎ": "تناظر ثنائي, تناظر جانبي (خاصية التناظر حول مستوى عمودي)",
 "にこだて": "منزل شبه منفصل (مسكن متصل بشيء ما من جانب واحد فقط)",
 "にこにこ": "بابتسام, مبتسماً (مع الابتسامات؛ بطريقة مبتسمة)\nمثال: ذكرتها الفتاة مبتسمة بطفولتهما التي قضياها معاً",
 "にこにこマーク": "وجه مبتسم (رمز تعبيري لوجه يبتسم)",
 "にこぽん": "متملق, ودود بإفراط (شخص يظهر ودية مفرطة أو حماسية)",
 "にこみ": "يَخْنَة",
 "にこむ": "يَخْنَة",
 "にこやか": "ابتسامة (تعبير وجهي يتميز برفع زوايا الفم؛ يظهر عادة السعادة أو التسلية)",
 "にこよん": "مُياوِم",
 "にこり": "برقة, بعذوبة (بطريقة حنونة أو محبة)\nمثال: تؤدي سوزان هيوار دور الزوجة بحدة وعذوبة",
 "にごう": "سَيِّدَة / خَلِيلَة, عَشِيقَة",
 "にごうさん": "سَيِّدَة / خَلِيلَة, عَشِيقَة",
 "にごしらえ": "حمل حقيبة الظهر (حمل شيء ما في حقيبة على الظهر) / تحزيم, تعبئة (إحاطة شيء ما في طرد أو صندوق) / حشوة, مادة تعبئة (أي مادة تستخدم خاصة لحماية شيء ما)\nمثال: حمل الأكسجين في حقائب الظهر ضروري لرواد الفضاء",
 "にごり": "تَغَيُّم, كُدْرَة (صفة كون الشيء غائماً) / ارتباك, تشوش (حالة عقلية تتميز بنقص في وضوح الفكر والسلوك ونظامهما) / طين, وحل (بلل الأرض المغطاة أو المشبعة بالماء)\nمثال: تشوش في الانطباعات / شوائب, عدم نقاء (حالة كونه غير نقي) / خبث, شائب (مادة عديمة القيمة أو خطرة يجب إزالتها)\nمثال: كانت هناك شوائب في الماء",
 "にごん": "ازدواجية, تعامل بوجهين (التصرف بسوء نية؛ الخداع بالتظاهر بامتلاك مجموعة من النوايا بينما يتصرف تحت تأثير أخرى) / ذُو وَجْهَيْن, مُرَاوِغ (يتَّسم بخداع متعمَّد خاصَّة بإظهار مشاعر والتصرُّف بمشاعر أخرى)",
 "にさ": "مقدّم (الذي قُدِّمَ؛ في : رتبة عسكرية هي خامس الرتب في الترتيب التصاعدي الرَائِد أدنى منه والعَقِيْد أعلى منه)\nمثال: تزحلقت العربة المسرعة و اصطدمت مقدمة العربة ب مؤخرة الشاحنة بشكل مفاجئ جدا .",
 "にさい": "بِعُمُر سَنَتَيْن (في عامه الثاني من العمر)",
 "にさいして": "مَتَى / إمتى / متى / امتى / فوقتاش / حِينَمَا, عِنْدَمَا",
 "にさばき": "بَيْع / تخفيض (تَنْقِيص ، حَسْم ،تَقْلِيل؛ تَنْزِيل) / مُزَايَدَة\nمثال: هل يمكن ان تعطيني تخفيض",
 "にさんか": "ثاني أكسيد (أكسيد يحتوي على ذرتين من الأكسجين في الجزيء)",
 "にさんかいおう": "ثاني أكسيد الكبريت",
 "にさんかえんそ": "ثاني أكسيد الكلور",
 "にさんかけいそ": "ثاني أكسيد السيليكون, سيليكا",
 "にさんかたんそ": "ثَانِي أُكْسِيد الْكَرْبُون",
 "にさんかちっそ": "ثاني أكسيد النيتروجين",
 "にさんかチタン": "ثاني أكسيد التيتانيوم (مسحوق أبيض يستخدم كصبغة لقدرته العالية على التغطية وقوة تحمله)",
 "にし": "غَرْب (الجِهَة التي تغرب نحوها الشَمس؛ ضد الشَرْق؛ الأَرَاضِي والبِلَاد التي تقع جهة الغرب في العَالم) / مَغْرِب (مَكَان غُرُوب الشَمْس، ويقصد به الغَرْب مجَازًا؛ زَمَان غروب الشمس) / غرب (الجِهَة التي تغرب نحوها الشَمس؛ ضد الشَرْق؛ الأَرَاضِي والبِلَاد التي تقع جهة الغرب في العَالم)\nمثال: تغرب الشمس في الغرب. / خَاصّ, شَخْصِيّ (قلَّ أو أصبح أقل؛ خَاصَ العَطَاءَ خَاصَ خَوْصًا: قلَّله) / خَاصّ (قلَّ أو أصبح أقل؛ خَاصَ العَطَاءَ خَاصَ خَوْصًا: قلَّله) / جُنْدِيّ (لقب عسكري يُطلق على من يلتحق بالجَيْش ويعمل فيه، مقاتل، محارب، عسكري؛ (في الشطرنج) اسم آخر للبيدق)\nمثال: كل الخضار الخاص بك. / مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة!",
 "にしあかり": "شَفَق ((شَفِقَ) منه، وعليه يَشْفَقَ شَفَقًا: خاف وحَذِرَ، فهو شَفِقٌ؛ (شَفِقَ) عليه: رَقَّ له وعطف عليه؛ فهو شَفِيقٌ)\nمثال: أثارت تلك السلحفاة شفقة زيري.",
 "にしおおのすり": "طَوِيل السَّاقَيْن (ذو ساقين طويلتين)",
 "にしかいがんひょうじゅんじ": "توقيت المحيط الهادئ (التوقيت القياسي في المنطقة الزمنية الثامنة غرب غرينتش، يحسب عند خط الطول 120 غرباً؛ يستخدم في الولايات الغربية البعيدة بالولايات المتحدة)",
 "にしかぜ": "رياح غربية (رياح تهب من الغرب إلى الشرق)",
 "にしがわ": "الجانب الغربي (الجانب الذي يقع في الغرب)",
 "にしき": "إِسْتَبْرَق (إستَبرَق)",
 "にしきえ": "أَبْلَق, مُتَعَدِّد الأَلْوَان (ذو أجزاء أو بقع ملوّنة بألوان مختلفة وزاهية عادةً)",
 "にしきおり": "إِسْتَبْرَق (إستَبرَق)",
 "にしきぎ": "سرو صيفي, شجيرة النار (نبات أوراسي كثيف التفرع؛ تتحول أوراقه إلى اللون الأحمر الأرجواني في الخريف) / ديكتامنيوس, شجيرة محترقة (عشب معمر أوراسي بأزهار بيضاء تبعث بخاراً قابلاً للاشتعال في الطقس الحار) / شجيرة محترقة, غدب أرجواني (شجيرة نفضية لها كبسولات أرجوانية تحيط ببذور قرمزية) / العليقة المشتعلة ((العهد القديم) الشجيرة التي اشتعلت دون أن تحترق والتي كلم الله موسى منها)",
 "にしきた": "باتجاه الشمال الغربي (إلى أو باتجاه أو في الشمال الغربي)",
 "にしきへび": "أَصَلَة",
 "にしたがい": "وَفْقًا لِ",
 "にしたがって": "وَفْقًا لِ",
 "にしつ": "جِذْع (في علم النبات: أحد أجزاء النبات الذي يحمل الأغصان ويتصل في أسفله بالجذر) / خُرْطُوم / صَنْدُوق, صُنْدُوق (وعاء كبيرة من الخشب غالبا وقد يكون حديدًا يستخدم لوضع الاشياء داخله، ويكون لها عادة جهة قابلة للفتح سواء بمفاصل او بالازالة الكاملة؛ صُنْدُوْقُ السَيَّارَة قمرة تشبه الصندوق في الجزء الخلفي من السيارة يستخدم كالصندوق) / حَقِيبَة أَمْتِعَة, صُنْدُوقُ السَّيَّارَةِ\nمثال: أين صندوق البريد؟",
 "にしつのめどり": "بفن أطلسي (بفن شائع في شمال المحيط الأطلسي)",
 "にして": "فِي (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة) / مِن (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: جون في عمر أخي. / رَغْمَ, بِالرَّغْمِ مِن ((رَغَمَ) رَغْمًا، ومَرْغَمًا، ومَرْغَمَةً: ذَلَّ؛ (رَغَمَ) ذل عن كَرْه. يقال (رغَمَ) أَنْفُه)\nمثال: إنه سعيد رغم فقره. / بِالْإِضَافَة إِلَى / صَوْب, ناحية (أحد جانبي المدينة التي يقسمها نهر، ومن ذلك صوب الكرخ وصوب الرصافة في بغداد؛ نُزول المَطَر)\nمثال: صوب الرجل مسدسا نحو المحققين.",
 "にしてからが": "مُسَطَّح, مُنبَسِط / أَمْلَس, سَوِيّ / زَوْجِيّ / حَتَّى (يفيد انتهاء الغاية؛ يفيد الغاية)\nمثال: انتظر حتى أجلس.",
 "にしては": "لِأَنَّ / لِـ (اللَّامُ هو الحرف الثالث والعشرون من حروف ٱلْهِجَاءِ، وهو مجهور متوسط…؛ يفيد التعليل الغرضي) / لِأَجْل / لِـ, بِالنِّسْبَة لِـ (اللَّامُ هو الحرف الثالث والعشرون من حروف ٱلْهِجَاءِ، وهو مجهور متوسط…؛ يفيد التعليل الغرضي)",
 "にしても": "بِالرَغْم مِن / مُسَطَّح, مُنبَسِط / أَمْلَس, سَوِيّ / زَوْجِيّ / حَتَّى (يفيد انتهاء الغاية؛ يفيد الغاية)\nمثال: انتظر حتى أجلس. / بصرف النظر, بغض النظر (على الرغم من كل شيء؛ دون اعتبار للعوائق)\nمثال: واصل العمل بغض النظر عن الصعوبات",
 "にしねずみざめ": "لِيَّاءٌ",
 "にしはんきゅう": "المغرب, نصف الكرة الغربي (نصف الكرة الذي يشمل أمريكا الشمالية وأمريكا الجنوبية)",
 "にしぶっぽうそう": "شقراق أوروبي (شقراق أوروبي شائع أزرق وأخضر ذو ظهر بني محمر)",
 "にしみなみ": "باتجاه الجنوب الغربي (إلى أو نحو أو في الجنوب الغربي)",
 "にしゅ": "مِنَ الدَّرَجَة الثَّانِيَة (ذو مكانة أو جودة أدنى)",
 "にしゅうかん": "أسبوعان, نصف شهر (فترة أربعة عشر يوماً متتالياً)",
 "にしゅうめ": "تَنَاسُخُ الأَرْوَاحِ",
 "にしょく": "ثُنَائِيّ اللَّوْن (ذو لونين) / ثنائي اللون (من أو يتعلق بثنائية اللون)",
 "にしょくせい": "ثنائية اللون (تعدد ألوان لبلورة بحيث تظهر لونين مختلفين عند النظر إليها من اتجاهين مختلفين)",
 "にしより": "غَرْبِيًّا, مِن الغَرْب (من الغرب) / بِاتِّجَاه الغَرْب (في اتجاه الغرب) / مُتَّجِهٌ غَرْباً (يتحرّك نحو الغرب) / غَرْبِيّ (قادم من الغرب؛ يُستخدم عن الرياح)\nمثال: هبت الرياح غربياً",
 "にしる": "مَرَق, مَرَقَة (الطَعَام سائل الخفيف فيه ماء اللحم وقد يكون فيه خضار أو غير ذلك. يؤكل عادة مع الرز أو الخبز. يجوز قول مَرَقَة، وهي أخص من المرَق)",
 "にしろ": "رَغْم أَنّ ((رَغَمَ) رَغْمًا، ومَرْغَمًا، ومَرْغَمَةً: ذَلَّ؛ (رَغَمَ) ذل عن كَرْه. يقال (رغَمَ) أَنْفُه)\nمثال: إنه سعيد رغم فقره.",
 "にしん": "إضافة, ملحق (مادة نصية تضاف إلى منشور؛ عادة في النهاية) / تذييل, ملاحظة لاحقة (ملاحظة تضاف إلى رسالة بعد التوقيع) / ثُنَائِيّ (يتكوّن من وحدتين أو مكوّنين أو عنصرين) / ثنائي (من أو متعلق بنظام أرقام أساسه 2) / برنامج ثنائي, ملف ثنائي (برنامج مسبق التجميع والربط جاهز للتشغيل تحت نظام تشغيل معين؛ الملف الثنائي لنظام تشغيل ما لن يعمل على نظام مختلف) / نَجْم ثُنَائِيّ, نَجْم مُزْدَوِج (نظام من نجمين يدوران حول بعضهما البعض تحت تأثير جاذبيتهما المتبادلة)\nمثال: رقم ثنائي / رنجة المحيط الهادئ (سمكة طعام مهمة في شمال المحيط الهادئ) / ازدواجية, تعامل بوجهين (التصرف بسوء نية؛ الخداع بالتظاهر بامتلاك مجموعة من النوايا بينما يتصرف تحت تأثير أخرى) / احتيال, ازدواجية (تمثيل احتيالي أو مزدوج)",
 "にしんえんざん": "عملية ثنائية, عملية منطقية (عملية تتبع قواعد الجبر البولياني؛ يأخذ كل معامل والنتيجة إحدى قيمتين)",
 "にしんぎ": "شَجَرَة ثُنَائِيَّة (نبات قائم على سَاق صلبة؛ مخطط له تفرعات)\nمثال: أنا تحت الشجرة.",
 "にしんすう": "بِت, رَقَم ثُنَائِيّ (إما 0 أو 1 في التدوين الثنائي)",
 "にしんすうじ": "بِت, رَقَم ثُنَائِيّ (إما 0 أو 1 في التدوين الثنائي)",
 "にしんほう": "النظام الثنائي, نظام العد الثنائي (نظام عد موضعي يستخدم أرقاماً ثنائية وأساساً هو الاثنان)",
 "にしアジア": "غَرْب آسِيَا (الجِهَة التي تغرب نحوها الشَمس؛ ضد الشَرْق؛ الأَرَاضِي والبِلَاد التي تقع جهة الغرب في العَالم)\nمثال: تغرب الشمس في الغرب.",
 "にしオーストラリアしゅう": "أُسْتْرَالِيَا الْغَرْبِيَّة, أُوسْتُرَالِيَا الْغَرْبِيَّة (دولة في أوقيانوسيا؛ اسمها الرسمي كومنولث أستراليا؛ (في الجيولوجيا) قارة أستراليا-غينيا الجديدة؛ تُعتبر غينيا الجديدة أيضًا جزءًا من قارة أستراليا جيولوجيًّا بما أنها تقع على الصفيحة التكتونية…)\nمثال: جين من أستراليا.",
 "にしゴート": "قُوطِيّ غَرْبِيّ",
 "にしサハラ": "الصَّحْرَاء الْغَرْبِيَّة",
 "にしドイツ": "أَلْمَانِيَا الْغَرْبِيَّة (دولة أوروبية في وسط أوروبا)\nمثال: ستعجبك ألمانيا.",
 "にしヨーロッパ": "أُورُوبَّا الْغَرْبِيَّة (الجزء من يوراسيا الذي يقع غرب جبال الأورال، والمعتبر تقليديًّا قارة بحد ذاته، كما يقع شمال قارة إفريقيا، وغرب قارة آسيا، وشرق المحيط الأطلسي؛ كيان سياسي؛ الاتحاد الأوروبي)\nمثال: ذهبت إلى أوروبا مرة.",
 "にじ": "اِسْم, أَسْمَاء (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر) / اِشْتِهَار / سَمَّى, سمى / اِخْتَارَ / عَيَّنَ (المُعَايَنَة والمشاهدة؛ العين : حاسة البصر والرؤية - مؤنث - تكون للإنسان وغيره من الحيوان . قال ابن السكيت : العين التي يبصر بها الناظر…) / عَيَّنَ, نَصَبَ (المُعَايَنَة والمشاهدة؛ العين : حاسة البصر والرؤية - مؤنث - تكون للإنسان وغيره من الحيوان . قال ابن السكيت : العين التي يبصر بها الناظر…)\nمثال: ما اسم حصان توم؟ / ثَانٍ, تاني / ثَانِيَة, ثانية (وحدة زمنية تعادل جزءًا من ستين جزءًا من الدقيقة)\nمثال: لن أفعلها ثانية. / ثَانَوِي (الثانويّ : المَنْسوب إلى الثاني ما يجيء بعدَ الأَوَّل؛ ما ليس له الأَهمّيَّة الأُُولى)\nمثال: ثانوية زيري ضخمة. / تربيعي (ينطوي على القوة الثانية ولا توجد قوة أعلى للكمية أو الدرجة) / كَثِيرَة حُدُود مِن الدَّرَجَة الثَّانِيَة, مُعَادَلَة تَرْبِيعِيَّة (كثيرة حدود من الدرجة الثانية) / معادلة تربيعية (معادلة تكون فيها أعلى قوة للكمية المجهولة هي المربع)\nمثال: معادلة تربيعية / خَيَالِيّ, مُتَخَيَّل / قَوْس قُزَح, قوس قزح / قَزَّحَ / اَلسَّاعَة اَلثَّانِيَة",
 "にじきおくそうち": "تخزين خارجي, تخزين مساعد (جهاز تخزين بيانات ليس الذاكرة الرئيسية للحاسوب)",
 "にじきょくめん": "سطح تربيعي (منحنى أو سطح معادلته (في الإحداثيات الديكارتية) من الدرجة الثانية)",
 "にじく": "ثنائي المحور (له محورين)\nمثال: بلورات ثنائية المحور",
 "にじげん": "خَيَالِيّ, مُتَخَيَّل",
 "にじげんこうそくフーリエへんかん": "ثنائي الأبعاد, مستوٍ (ينطوي على أو له بعدان) / ثُنَائِيُّ الأَبْعَادِ, سَطْحِيّ (يفتقر إلى المدى أو العمق المتوقع؛ غير مُصمَّم لإعطاء إيهام بالعمق)",
 "にじせい": "ثَانَوِي (الثانويّ : المَنْسوب إلى الثاني ما يجيء بعدَ الأَوَّل؛ ما ليس له الأَهمّيَّة الأُُولى)\nمثال: ثانوية زيري ضخمة.",
 "にじっさい": "عِشْرُونَ",
 "にじっせいき": "القرن العشرون (القرن من 1901 إلى 2000)",
 "にじてき": "ثَانَوِي (الثانويّ : المَنْسوب إلى الثاني ما يجيء بعدَ الأَوَّل؛ ما ليس له الأَهمّيَّة الأُُولى)\nمثال: ثانوية زيري ضخمة.",
 "にじのはしをわたる": "مَاتَ (للحَيّ: فقد الحَيَاة. مصدره مَوتَا ومِيتَة؛ للأرض: ليس فيها شيء حَيّ من النبات أو الحيوان أو الإنسان. مصدره مَوَات) / تُوُفِّيَ / زَهْر اَلطَّاوِلَة, زَهْر اَلنَّرْد ((زَهَرَ) الوجهُ والسراجُ والقمرُ يَزْهُرُ زَهْرًا، وزُهُوراً: تلألأ وأشْرق؛ (زَهَرَ) الشيءُ: صَفا لونُه)\nمثال: إعتقدت أنه مات.",
 "にじはいふ": "إعادة توزيع (التوزيع مرة أخرى)\nمثال: أدت الثورة إلى إعادة توزيع الثروة",
 "にじほうていしき": "معادلة تربيعية (معادلة تكون فيها أعلى قوة للكمية المجهولة هي المربع)",
 "にじます": "تروتة قوس قزح (توجد في المياه الساحلية للمحيط الهادئ والجداول من كاليفورنيا السفلى إلى ألاسكا) / تراوت قوس قزح (لحم تراوت المحيط الهادئ الذي يهاجر من المياه المالحة إلى العذبة)",
 "にじみ": "غَشَّى, غَبَّش / لَطَّخَ, بَقَّعَ (لوَّثَ الشيءَ بسائل أو مادة لزجة؛ أصابه بشيء من العيب أو السوء)",
 "にじみでる": "رشح, نزيز (عملية التسرب ببطء) / حمأة, طين لزج (أي مادة سميكة ولزجة)",
 "にじみ出る": "رشح, نزيز (عملية التسرب ببطء) / حمأة, طين لزج (أي مادة سميكة ولزجة)",
 "にじむ": "رَكَضَ (عَدَا) / جَرَى (تحرك من مكان إلى آخر بصورة مستمرة وسريعة؛ الماء أو النهر أو السائل: سالَ)\nمثال: إنها تحب الركض. / غَشَّى, غَبَّش / لَطَّخَ, بَقَّعَ (لوَّثَ الشيءَ بسائل أو مادة لزجة؛ أصابه بشيء من العيب أو السوء) / رشح, نزيز (عملية التسرب ببطء) / حمأة, طين لزج (أي مادة سميكة ولزجة)",
 "にじゅ": "مَرَض, دَاء (أصابه مرضٌ أو علّة أو سَقَم)\nمثال: هذا المرض قلبي.",
 "にじゅう": "عِشْرُونَ / ثُنَائِيّ / ضِعْف",
 "にじゅうあご": "ذِقْن مُزْدَوِج, لُغْد (الجزء الناتىء البارز في أسفل الوجه تحت الفم، وهو منبت اللِحْيَة عند الرَجُل؛ كناية اللِحْيَة)",
 "にじゅういちだいしゅう": "وَاحِد وَعِشْرُون (في وَ: العدد واحد العدد الاول)\nمثال: رأيت واحدة مرة.",
 "にじゅういっかじょうのようきゅう": "وَاحِد وَعِشْرُون (في وَ: العدد واحد العدد الاول)\nمثال: رأيت واحدة مرة.",
 "にじゅういんようふ": "علامات اقتباس مزدوجة (زوج من علامات الاقتباس)",
 "にじゅうおんじ": "ثنائي الحرف (حرفان متتاليان (خاصة حرفين يستخدمان لتمثيل صوت واحد))",
 "にじゅうか": "استنساخ, مضاعفة (فعل نسخ أو عمل نسخة (أو نسخ) من شيء ما) / تكرار, نسخة طبق الأصل (نسخة تتوافق مع الأصل تماماً)\nمثال: هذا النوع من الازدواجية هو هدر",
 "にじゅうかんせつ": "مُزْدَوَجُ المَفَاصِل (ذُو مَفَاصِلَ مَرِنَةٍ بِشَكْلٍ غَيْرِ اعْتِيَادِيٍّ خَاصَّةً فِي الأَطْرَافِ أَوِ الأَصَابِعِ)",
 "にじゅうがま": "حمّام مائي, غلاية مزدوجة (قدران، أحدهما يوضع داخل الآخر)",
 "にじゅうきじゅん": "كَيْلٌ بِمِكْيالَيْنِ, اِزْدِوَاجِيَّة الْمَعَايِير",
 "にじゅうきはん": "كَيْلٌ بِمِكْيالَيْنِ, اِزْدِوَاجِيَّة الْمَعَايِير",
 "にじゅうきゅう": "تِسْعَة وَعِشْرُونَ (يَدُلُّ عَلَى العَدَد 29) / تِسْعَة وَعِشْرُون (العدد الأصلي الذي هو مجموع ثمانية وعشرين وواحد)",
 "にじゅうけっこん": "تَعَدُّد اَلْأَزْوَاج, تَعَدُّد اَلزَّوْجَات",
 "にじゅうけつごう": "رابطة ثنائية, رابطة مزدوجة (رابطة تساهمية يتم فيها مشاركة زوجين من الإلكترونات بين ذرتين)",
 "にじゅうこうそく": "مأزق مزدوج, ورطة مزدوجة ((علم النفس) معضلة غير قابلة للحل؛ وضع يتلقى فيه الشخص رسائل متناقضة من شخص ذي نفوذ قوي)",
 "にじゅうご": "خَمْسَة وَعِشْرُونَ (يَدُلُّ عَلَى العَدَد 25) / خَمْسَة وَعِشْرُون (العدد الأصلي الذي هو مجموع أربعة وعشرين وواحد)",
 "にじゅうごし": "خَمْسَة وَعِشْرُون (قيمة عددية تساوي \"٥\"؛ الرقم ما بعد \"أَرْبَعَة\" وقبل \"سِتَّة\")\nمثال: رأيت خمسة رجال.",
 "にじゅうしし": "أَرْبَعَة وَعِشْرُون (أَرْبِعَة؛ أربعَة)\nمثال: مرت أربعة أيام.",
 "にじゅうしち": "سَبْعَة وَعِشْرُونَ (يَدُلُّ عَلَى العَدَد 27) / سَبْعَة وَعِشْرُون (العدد الأصلي الذي هو مجموع ستة وعشرين وواحد)",
 "にじゅうしょうてん": "ثُنَائِيّ البُؤْرَة (ذو بؤرتين اثنتين)",
 "にじゅうしょばつ": "خطر مزدوج (محاكمة مدعى عليه لجريمة جنائية سبق محاكمته عليها؛ محظور في التعديل الخامس لدستور الولايات المتحدة)",
 "にじゅうしん": "شَبِيه",
 "にじゅうじんかく": "انفصام الشخصية, تعدد الشخصيات (اضطراب انشقاقي نادر نسبياً ينهار فيه التكامل المعتاد للشخصية وتظهر شخصيتان مستقلتان أو أكثر)",
 "にじゅうすいそ": "ديوتيريوم, هيدروجين ثقيل (نظير للهيدروجين يحتوي على نيوترون واحد (مقارنة بعدم وجود نيوترونات في الهيدروجين العادي))",
 "にじゅうせい": "نَجْم ثُنَائِيّ, نَجْم مُزْدَوِج (نظام من نجمين يدوران حول بعضهما البعض تحت تأثير جاذبيتهما المتبادلة) / ازْدِوَاجِيَّة, ثَنَوِيَّة ((في الهندسة) قابلية تبادل أدوار النقاط والمستويات في نظريات الهندسة الإسقاطية) / ازدواجية, ازدواجية الموجة والجسيم ((فيزياء) خاصية المادة والإشعاع الكهرومغناطيسي التي تتميز بحقيقة أن بعض الخصائص يمكن تفسيرها بشكل أفضل بنظرية الموجة والبعض الآخر بنظرية الجسيمات) / انقسام ثنائي, ثنائية (كون الشيء ثنائياً؛ تصنيف إلى جزأين أو فئتين فرعيتين متضادتين)\nمثال: الانقسام بين الثقافة الشرقية والغربية",
 "にじゅうぞこ": "قاع زائف (هيكل أفقي يقسم سفينة أو صندوقاً (خاصةً ذلك المبني بالقرب من القاع الفعلي))",
 "にじゅうだい": "عِشْرُونَ (يَدُلُّ عَلَى العَدَد 20) / عِشْرُون (العدد الأصلي الذي هو مجموع تسعة عشر وواحد)",
 "にじゅうつうしん": "ثُنَائِيّ الاِتِّصَال, مُزْدَوَج (يسمح بالاتصال في اتجاهين متعاكسين في آن واحد) / مُزْدَوَج ((يُستخدم تقنيًّا) ذو جزأين أو مكوّنين) / شقة دوبلكس, شقة طابقين (شقة تحتوي على غرف في طابقين متصلة بواسطة درج) / دوبلكس, منزل مزدوج (منزل بوحدتين تشتركان في جدار مشترك)",
 "にじゅうていこく": "النَّمْسَا وَٱلْمَجَر (دولة في أوروبا الوسطى؛ اسمها الرسمي جمهورية النمسا، وعاصمتها فيينا)\nمثال: النمسا بلد الكناغر.",
