 "にっぽんでんき": "التهاب الأمعاء والقولون الناخر (مرض التهابي حاد يحدث في أمعاء الأطفال الخدج)",
 "にっぽんとうごういりょうがっかい": "جِيم (كتب جيمًا)\nمثال: أنا أعتني بجيم.",
 "について": "حَوْلَ (جَعَلَ الشيءَ غير ما كان؛ نقل الشيء من موضع إلى آخر) / عَلَى وَشَكِ (يفيد الاستعلاء؛ يفيد التعليل) / عَن (يُفِيدُ المُجَاوَزَة؛ يُفِيدُ الاستعلاء، عَلَى) / حَوَالِي\nمثال: رقصنا حول النار. / لِكُلّ / فِي كُلّ (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة) / بِنَاءً عَلَى, لِأَجْل (ضد هَدْم. ؛ المَبْنَى أو البِنَاية)\nمثال: جون في عمر أخي.",
 "につかわしい": "مُنَاسِب, مُلَائِم",
 "につき": "بِسَبَب, بِحُكْم / حَوْلَ (جَعَلَ الشيءَ غير ما كان؛ نقل الشيء من موضع إلى آخر) / عَلَى وَشَكِ (يفيد الاستعلاء؛ يفيد التعليل) / عَن (يُفِيدُ المُجَاوَزَة؛ يُفِيدُ الاستعلاء، عَلَى) / حَوَالِي\nمثال: رقصنا حول النار. / لِكُلّ / فِي كُلّ (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة) / بِنَاءً عَلَى, لِأَجْل (ضد هَدْم. ؛ المَبْنَى أو البِنَاية)\nمثال: جون في عمر أخي.",
 "につきまして": "حَوْلَ (جَعَلَ الشيءَ غير ما كان؛ نقل الشيء من موضع إلى آخر) / عَلَى وَشَكِ (يفيد الاستعلاء؛ يفيد التعليل) / عَن (يُفِيدُ المُجَاوَزَة؛ يُفِيدُ الاستعلاء، عَلَى) / حَوَالِي\nمثال: رقصنا حول النار.",
 "につけ": "كُلَّمَا / إِذَا مَا, إِذَا",
 "につけて": "كُلَّمَا / إِذَا مَا, إِذَا",
 "につめる": "رَكَّزَ (وضع الشيء بثبات في مكانه؛ أثبت الشيء أو ثبّتَه، وخاصة في مكان محدد) / رَكَّزَ, تَرَكَّزَ (وضع الشيء بثبات في مكانه؛ أثبت الشيء أو ثبّتَه، وخاصة في مكان محدد) / مركز (موضع الاِرْتِكَاز عامة؛ موضع الشخص ومحلّه الذي يبقى فيه عادة)\nمثال: فقط ركز يا زيري.",
 "につれ": "كَـ, مِثْل / مِثْل, كَـ (الشَبَه؛ النَظِير)\nمثال: قصدته مثل نكتة.",
 "につれて": "كَـ, مِثْل / مِثْل, كَـ (الشَبَه؛ النَظِير)\nمثال: قصدته مثل نكتة.",
 "にづくり": "حمل حقيبة الظهر (حمل شيء ما في حقيبة على الظهر) / تحزيم, تعبئة (إحاطة شيء ما في طرد أو صندوق) / حشوة, مادة تعبئة (أي مادة تستخدم خاصة لحماية شيء ما)\nمثال: حمل الأكسجين في حقائب الظهر ضروري لرواد الفضاء",
 "にづみ": "تحميل (عمل وضع حمولة من شيء ما على أو في مركبة أو سفينة أو حاوية، إلخ) / بضاعة منقولة, حمولة (بضائع تحملها مركبة كبيرة) / حمل, عبء (وزن يجب تحمله أو نقله) / حمل, حمولة (كمية يمكن معالجتها أو نقلها في وقت واحد)\nمثال: استغرق التحميل ساعتين",
 "にづめ": "حمل حقيبة الظهر (حمل شيء ما في حقيبة على الظهر) / تحزيم, تعبئة (إحاطة شيء ما في طرد أو صندوق) / حشوة, مادة تعبئة (أي مادة تستخدم خاصة لحماية شيء ما)\nمثال: حمل الأكسجين في حقائب الظهر ضروري لرواد الفضاء",
 "にて": "صَوْب, ناحية (أحد جانبي المدينة التي يقسمها نهر، ومن ذلك صوب الكرخ وصوب الرصافة في بغداد؛ نُزول المَطَر)\nمثال: صوب الرجل مسدسا نحو المحققين. / بِجَانِب, جنب (بجانب) / عِنْدَ, فِي (يُفِيدُ الحضور أو وجود صلة أو علاقة مثل الانتماء والامتلاك. (ظرف مكان)؛ يُفِيدُ قُرْبَ الشيء. (ظرف مكان)) / مِن قِبَل, بِوَاسِطَّة (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / بِوَاسِطَّة, لِـ\nمثال: زيري بجانب الحوض. / فَـ, لِذَا (الحرف العشرون في حروف الهجاء العربية؛ يفيد الترتيب والتعقيب) / إِذًا, فَ",
 "にてひなる": "زَائِف, مَنْحُول (كاذب أو مُقلَّد؛ ليس كما يبدو عليه) / لَقِيط, نَغْل (وُلِدَ خارِج إِطار الزَّواج الشَّرْعِيّ) / زَائِف, مُضَلِّل (يبدو معقولًا لكنه كاذب في حقيقته) / زَائِف, مُزَيَّف (يَبْدُو صَحِيحًا ظَاهِرِيًّا لَكِنَّهُ غَيْرُ صَحِيحٍ فِعْلِيًّا)",
 "にてらして": "طِبْقًا لِـ, وَفْقًا لِـ / بِالنِّسْبَة لِـ",
 "にてらすと": "طِبْقًا لِـ, وَفْقًا لِـ / بِالنِّسْبَة لِـ",
 "にとう": "بالدرجة الثانية (بواسطة وسائل نقل الدرجة الثانية) / درجة ثانية, درجة سياحية (فئة من أماكن الإقامة على متن سفينة أو قطار أو طائرة أقل تكلفة من أماكن الدرجة الأولى) / درجة ثانية (ليس أعلى جودة في التصنيف) / درجة ثانية (ليست أعلى رتبة في التصنيف)\nمثال: سافرنا بالدرجة الثانية / سكر ثنائي (أي من مجموعة متنوعة من الكربوهيدرات التي تنتج جزيئين من السكر الأحادي عند التحلل المائي الكامل)",
 "にとうかいさ": "آمِر, مُقَدَّم",
 "にとうきん": "ذَات اَلرَّأْسَيْن / ذَات اَلرَّأْسَيْن اَلْعَضُدِيَّة",
 "にとうくうそう": "رقيب فني (ضابط صف رتبته أقل من رقيب أول في القوات الجوية أو المارينز)",
 "にとうぐんそう": "رقيب أركان (ضابط صف رتبته أعلى من عريف وأقل من رقيب أول في الجيش أو المارينز)",
 "にとうぶん": "تنصيف (التقسيم إلى جزأين متساويين)",
 "にとうぶんせん": "مُنَصِّف, مُقَسِّم",
 "にとうへい": "خَاصّ, شَخْصِيّ (قلَّ أو أصبح أقل؛ خَاصَ العَطَاءَ خَاصَ خَوْصًا: قلَّله) / خَاصّ (قلَّ أو أصبح أقل؛ خَاصَ العَطَاءَ خَاصَ خَوْصًا: قلَّله) / جُنْدِيّ (لقب عسكري يُطلق على من يلتحق بالجَيْش ويعمل فيه، مقاتل، محارب، عسكري؛ (في الشطرنج) اسم آخر للبيدق)\nمثال: كل الخضار الخاص بك.",
 "にとうへいそう": "ضابط صف بحري (ضابط صف في البحرية أو خفر السواحل برتبة تعادل رقيب في الجيش)",
 "にとうへんさんかくけい": "مثلث متساوي الساقين (مثلث له ضلعان متساويان)",
 "にとうへんさんかっけい": "مثلث متساوي الساقين (مثلث له ضلعان متساويان)",
 "にとうりくい": "ملازم أوّل (مَن يُلازم الشيء أو المكان فيدوم فيه ولا يفارقه؛ في : المُلازِم رتبة في الجيش هي أدنى رتبة للظُبَّاط ودونه ما يعرفون بنُوَّاب الظباط أو ظُباط الصَفّ)",
 "にとうりくさ": "مقدّم (الذي قُدِّمَ؛ في : رتبة عسكرية هي خامس الرتب في الترتيب التصاعدي الرَائِد أدنى منه والعَقِيْد أعلى منه)\nمثال: تزحلقت العربة المسرعة و اصطدمت مقدمة العربة ب مؤخرة الشاحنة بشكل مفاجئ جدا .",
 "にとうりくし": "خَاصّ, شَخْصِيّ (قلَّ أو أصبح أقل؛ خَاصَ العَطَاءَ خَاصَ خَوْصًا: قلَّله) / خَاصّ (قلَّ أو أصبح أقل؛ خَاصَ العَطَاءَ خَاصَ خَوْصًا: قلَّله) / جُنْدِيّ (لقب عسكري يُطلق على من يلتحق بالجَيْش ويعمل فيه، مقاتل، محارب، عسكري؛ (في الشطرنج) اسم آخر للبيدق)\nمثال: كل الخضار الخاص بك.",
 "にとうりくそう": "رقيب أول (رقيب في الجيش أعلى من رقيب أركان وأقل من مساعد)",
 "にとうりゅう": "ازدواجية الميول الجنسية (النشاط الجنسي مع كل من الرجال والنساء) / ازدواجية الجنس, خنوثة (إظهار خصائص كلا الجنسين)",
 "にとうるい": "سكر ثنائي (أي من مجموعة متنوعة من الكربوهيدرات التي تنتج جزيئين من السكر الأحادي عند التحلل المائي الكامل)",
 "にとって": "أَنّ (يفيد التوكيد) / إِلَى, عَلَى (حرف جر يُفيد الغاية الزمنية؛ حرف جر يُفيد الغاية المكانية)\nمثال: كيف لي أن أعرف؟",
 "にともない": "تَضَامُنًا مَعَ",
 "にともなって": "كَـ, مِثْل / مِثْل, كَـ (الشَبَه؛ النَظِير)\nمثال: قصدته مثل نكتة.",
 "にとりまして": "أَنّ (يفيد التوكيد) / إِلَى, عَلَى (حرف جر يُفيد الغاية الزمنية؛ حرف جر يُفيد الغاية المكانية)\nمثال: كيف لي أن أعرف؟",
