 "どくせいがく": "عِلْم السُّمُوم (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "どくせん": "اِحْتِكَار, اِنْحِصَار / خروف حولي (خروف يصل عمره إلى سنة واحدة؛ لم يتم جزه بعد)",
 "どくせんきんし": "مُضَادّ لِلاحْتِكَار (عَنِ القَوَانِين وَالأَنْظِمَة؛ مُصَمَّم لِحِمَايَة التِّجَارَة مِنَ…)",
 "どくせんきんしほう": "قانون مكافحة الاحتكار (قانون يهدف إلى تعزيز المنافسة الحرة في السوق عن طريق حظر الاحتكارات)",
 "どくせんけん": "امتياز, حق حصري (حق محفوظ حصريًا لشخص أو مجموعة معينة (خاصة حق وراثي أو رسمي))\nمثال: كان التصويت امتيازًا للذكور البالغين البيض",
 "どくせんじぎょう": "اِحْتِكَار, اِنْحِصَار",
 "どくせんてき": "اِحْتِكَارِيّ (يملك سيطرة حصرية على نشاط تجاريّ بالحيازة أو بمنحة قانونية)",
 "どくせんよく": "تملك, حب التملك (رغبة مفرطة في الامتلاك أو السيطرة)",
 "どくぜつ": "لسان حاد, لسان سليط (طريقة مريرة أو نقدية في التحدث)",
 "どくぜんてき": "مُتَظَاهِر بِالتَّقْوَى, مُرَائِي (مُفرِط في إظهار التقوى بشكل نفاقيّ)",
 "どくそ": "توكسين, ذيفان (مادة سامة تنتج أثناء التمثيل الغذائي ونمو كائنات دقيقة معينة وبعض الأنواع…)",
 "どくそう": "نبات سام (نبات يمكن أن يكون ضاراً أو مميتاً للكائن الحي عند لمسه أو تناوله بكمية كافية) / أَصَالَة, ابْتِكَار (صفة كون الشيء جديداً وأصلياً (غير مشتق من شيء آخر)) / منفرداً, وحده (دون أي شخص أو شيء آخر)\nمثال: بقي الطفل في المنزل وحده",
 "どくそうきょく": "منفرداً, وحده (دون أي شخص أو شيء آخر)\nمثال: بقي الطفل في المنزل وحده",
 "どくそうしゃ": "عازف منفرد (موسيقي يؤدي عزفاً منفرداً)",
 "どくそうせい": "إِبْدَاع (ابْتِكَار؛ إيجاد الشيء من لا شيء)\nمثال: يحتاج اكتساب اللغة إلى الإبداع.",
 "どくそうてき": "إِبْداعِيّ, خَلَّاق\nمثال: 彼は独創的な考えをたくさん持っています。 — عنده كثيرٌ من الأفكار الإبداعية.",
 "どくそん": "تباهي, تفاخر (غرور صريح)",
 "どくたけ": "فطر سام (اسم شائع للغاريقون غير الصالح للأكل أو السام (على عكس الفطر الصالح للأكل))",
 "どくだん": "عَقِيدِيَّة, عَقَائِدِيَّة",
 "どくだんてき": "عَقَائِدِي",
 "どくだんろん": "عَقِيدِيَّة, عَقَائِدِيَّة",
 "どくつるたけ": "أمانيت فالوسي, قبعة الموت (فطر سام للغاية عادة ما يكون أبيض اللون بقاعدة بارزة تشبه الكأس؛ يختلف عن…)",
 "どくづく": "لَعْنَة (أي رغبة صريحة في أن تصيب المحن أو أي شكل من أشكال سوء الحظ كيانًا ما، سواء كان…)\nمثال: اللعنة حولها ومعرفة",
 "どくとく": "تحفة, شيء نادر (شيء غير عادي - ربما يستحق الجمع)",
 "どくどく": "بانفعال شديد, بفيض من العاطفة (بطريقة متدفقة المشاعر بشكل مفرط)\nمثال: كاتب غزير الإنتاج بفيض",
 "どくどくしい": "سَامّ / بغيض, كريه (يثير أو يستحق الكراهية)\nمثال: لا توجد رذيلة بغيضة عالمياً مثل الجحود / صَارِخ, مُبَهْرَج (ذو ألوان صارخة وبرّاقة تجذب الانتباه بشكل مفرط)",
 "どくにんじん": "شَوْكَرَان",
 "どくのある": "سَامّ / خَبِيث, كَيْدِيّ (له طبيعة الخبث أو ناتج عنه)\nمثال: نميمة خبيثة",
 "どくは": "إنهاء, تشطيب (فعل الإنهاء)\nمثال: كان أفضل إنهاء له في بطولة كبرى هو المركز الثالث",
 "どくはく": "مُونُولُوج, حَدِيث النَّفْس",
 "どくばり": "لَسَعَ",
 "どくふ": "فاتنة, مغوية (امرأة تعتبر مغرية بشكل خطير)",
 "どくぶつ": "سم, مادة سامة (أي مادة تسبب إصابة أو مرض أو موت كائن حي)",
 "どくぶつがく": "عِلْم السُّمُوم (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "どくほ": "استقلالية, اعتماد على النفس (الاستقلال الشخصي) / فَرِيد, فَذّ",
 "どくほん": "قَارِئ, قَارِئَة / كِتَاب مَدْرَسِيّ, مَرْجِع (موضع تعليم الكتابة. الاستخدام الأصلي؛ مدرسة شبه رسمية لتعليم الأطفال الكِتَابَة…)\nمثال: هذا الكتاب جديد",
 "どくぼう": "حَبْس اِنْفِرَادِيّ (مَنَعَ الشيءَ عن الفعلِ؛ أَمْسَكَ الشيءَ، قَبَضَ عَلَيْهِ)\nمثال: هو,البارحة حرر من الحبس.",
 "どくぼうかんきん": "حَبْس اِنْفِرَادِيّ (مَنَعَ الشيءَ عن الفعلِ؛ أَمْسَكَ الشيءَ، قَبَضَ عَلَيْهِ)\nمثال: هو,البارحة حرر من الحبس.",
 "どくむぎ": "زوان سام, شيلم (عشبة سنوية ضارة توجد غالباً في حقول الحبوب والأراضي المزروعة الأخرى؛ تعتبر…)",
 "どくやく": "سُمّ, سَمّ (في : حرف جواب بمعنى مُرْ يأتي بعد النداء فقط)\nمثال: تناول سامي السم.",
 "どくやくじょうこう": "حبة سامة (استراتيجية دفاعية تجعل أسهم الشركة المستهدفة أقل جاذبية للمستحوذ)",
 "どくりつ": "اِسْتِقْلَال (التحرر من السيطرة أو الاعتماد على الغير، سواء كان ذلك فرديًا أو جماعيًا؛ التمتع…)\nمثال: الصحراويون يريدون الاستقلال. / تَفْرِقَة",
 "どくりつがた": "قَائِم بِذَاتِه, مُسْتَقِلّ (يقف منفردًا دون أن يكون مُثبَّتًا أو مسنودًا بشيء آخر)",
 "どくりつきかん": "وكالة مستقلة (وكالة تابعة لحكومة الولايات المتحدة يتم إنشاؤها بموجب قانون من الكونغرس وتكون…)",
 "どくりつきねんび": "يَوْم الاِسْتِقْلَال, عِيد الاِسْتِقْلَال (فترة من الزمان تبدأ عند غُرُوب الشمس وتنتهي عند غُرُوب شمس النهار التالي ويشمل…)\nمثال: طقس اليوم جميل.",
 "どくりつけい": "مُسْتَقِل, حُرّ (اسم فاعل مِن اِسْتَقَلَّ؛ من لا يعتمد على غيره)\nمثال: الجزائر مستقلة الآن.",
 "どくりつこっかきょうどうたい": "اِتِّحَاد اَلدُّوَل اَلْمُسْتَقِلَّة (اِتِّحَاد؛ الاتِّحاد الأوربيّ : (السياسة) اتِّحاد أوربيّ إقليميّ أنشئ بمقتضى…)\nمثال: عاش الاتحاد السوفيتي!",
 "どくりつさい": "يَوْم الاِسْتِقْلَال, عِيد الاِسْتِقْلَال (فترة من الزمان تبدأ عند غُرُوب الشمس وتنتهي عند غُرُوب شمس النهار التالي ويشمل…)\nمثال: طقس اليوم جميل.",
 "どくりつせい": "اِسْتِقْلَال (التحرر من السيطرة أو الاعتماد على الغير، سواء كان ذلك فرديًا أو جماعيًا؛ التمتع…)\nمثال: الصحراويون يريدون الاستقلال.",
 "どくりつどっこう": "استقلالية, اعتماد على النفس (الاستقلال الشخصي)",
 "どくりつどっぽ": "استقلالية, اعتماد على النفس (الاستقلال الشخصي)",
 "どくりつのほうそく": "قانون التوزيع المستقل (ينفصل كل عضو من زوج الكروموسومات المتماثلة بشكل مستقل عن أعضاء الأزواج الأخرى…)",
 "どくりつはん": "فصل, فك الارتباط (عملية التحرير من مرفق أو اتصال)",
 "どくりつへんすう": "متغير تجريبي, متغير مستقل ((إحصاء) متغير تكون قيمه مستقلة عن التغيرات في قيم المتغيرات الأخرى)",
 "どくろ": "جُمْجُمَة",
 "どくろマーク": "جمجمة وعظمتان متقاطعتان",
 "どくわ": "قراءة الشفاه (إدراك ما يقوله الشخص بمراقبة حركات الشفاه)",
 "どくをもる": "سُمّ, سَمّ (في : حرف جواب بمعنى مُرْ يأتي بعد النداء فقط)\nمثال: تناول سامي السم.",
 "どくん": "ضَخْم جِدًّا ((غير رسمي) كبير جداً)",
 "どくガス": "غاز سام (غاز سام عند التنفس أو التلامس؛ يستخدم في الحرب الكيميائية)",
 "どくガスしつ": "غُرْفَة اَلْغَاز (اسم مفعول لما غُرِفَ من الماء وغيره باليد، الجمع غِرَاف؛ اسم؛ المكان في الدار…)\nمثال: الأب في الغرفة.",
 "どくキノコ": "فطر سام (اسم شائع للغاريقون غير الصالح للأكل أو السام (على عكس الفطر الصالح للأكل))",
 "どくグモ": "عَنْكَبُوت ذِئْبِيّ",
 "どけち": "جلدة, شحيح (شخص بخيل جداً)",
 "どけん": "الهندسة المدنية",
 "どけんこっか": "الهندسة المدنية",
 "どこ": "أَيْن, فين\nمثال: あなたはどこでテレビを見ますか。 — أين تشاهد التلفاز؟ / كَمْ",
 "どこいら": "أَيْن, فين",
 "どこう": "أعمال ترابية, متراس ترابي (متراس مصنوع من التراب) / عَامِل, عَامِلَة (الذي يَعْمَل أو الذي عَمِلَ؛ هو الذي وَلاه السُلْطَان على أمر من أمور الدولة…)\nمثال: توم عامل نفايات.",
 "どこか": "مَكَان مَا (مَوْضِع؛ المنزلة والشأن، يقال أيضا مكانة)\nمثال: هذا المكان مقدس",
 "どこからどこまで": "جَمِيع أَنْحَاء, كُلّ",
 "どこからみても": "بصرف النظر, بغض النظر (على الرغم من كل شيء؛ دون اعتبار للعوائق)\nمثال: واصل العمل بغض النظر عن الصعوبات",
 "どこから見ても": "بصرف النظر, بغض النظر (على الرغم من كل شيء؛ دون اعتبار للعوائق)\nمثال: واصل العمل بغض النظر عن الصعوبات",
 "どこく": "دِيك رُومِيّ (ذكر الدَجَاج؛ ذكر أي طير داجن يشبه الدجاج كالقَبَج وغيره)\nمثال: لديك بعض الكتب.",
 "どこそこ": "كَذَا وَكَذَا, كَذَا",
 "どこぞ": "مَكَان مَا (مَوْضِع؛ المنزلة والشأن، يقال أيضا مكانة)\nمثال: هذا المكان مقدس",
 "どこだって": "أي مكان, في أي مكان (في أو عند أو إلى أي مكان)\nمثال: يمكنك العثور على هذا الطعام في أي مكان",
 "どこであれ": "أَيْنَ, أَيْنَمَا",
 "どこでも": "أي مكان, في أي مكان (في أو عند أو إلى أي مكان)\nمثال: يمكنك العثور على هذا الطعام في أي مكان",
 "どことなく": "بشكل ما, بطريقة أو بأخرى (بطريقة أو أسلوب غير محدد؛ أو بوسيلة غير محددة)\nمثال: لقد تدبروا الأمر بطريقة ما",
 "どこともなく": "بلا هدف (بدون هدف)\nمثال: تجول بلا هدف / بشكل ما, بطريقة أو بأخرى (بطريقة أو أسلوب غير محدد؛ أو بوسيلة غير محددة)\nمثال: لقد تدبروا الأمر بطريقة ما",
 "どこどこ": "كَذَا وَكَذَا, كَذَا",
 "どこなりと": "أي مكان, في أي مكان (في أو عند أو إلى أي مكان)\nمثال: يمكنك العثور على هذا الطعام في أي مكان",
 "どこにでも": "أي مكان, في أي مكان (في أو عند أو إلى أي مكان)\nمثال: يمكنك العثور على هذا الطعام في أي مكان",
 "どこにでもある": "رَتِيب, عَادِيّ (غير مُلهِم ولا يُشكِّل تحدياً؛ باهت وخالٍ من الإثارة)",
 "どこにでもいる": "رَتِيب, عَادِيّ (غير مُلهِم ولا يُشكِّل تحدياً؛ باهت وخالٍ من الإثارة)",
 "どこにも": "أي مكان, في أي مكان (في أو عند أو إلى أي مكان)\nمثال: يمكنك العثور على هذا الطعام في أي مكان / فِي كُلِّ مَكَانٍ (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "どこにもかしこにも": "جَمِيع أَنْحَاء, كُلّ",
 "どこにもない": "فِي لَا مَكَان (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "どこふくかぜ": "لَا مُبَالٍ, مُتَهَتِّك (يَتَّسِمُ بِعَدَمِ المُبَالَاةِ بِالأَعْرَافِ أَوْ بِسُوءِ السُّمْعَة)",
 "どこへも": "فِي لَا مَكَان (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "どこまでも": "أي مكان, في أي مكان (في أو عند أو إلى أي مكان)\nمثال: يمكنك العثور على هذا الطعام في أي مكان / مهما حدث, مهما كانت الظروف (رغم كل العقبات)\nمثال: سنذهب إلى التبت مهما حدث / بِإِصْرَار (مع الإصرار)\nمثال: كان يطرح أسئلة، أسئلة لا مفر منها، بإصرار / إجمالاً, في المجموع (مع تضمين أو عد كل شيء)\nمثال: إجمالاً يكسب ما يقرب من مليون دولار",
 "どこも": "فِي كُلِّ مَكَانٍ (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي. / فِي لَا مَكَان (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "どこもかしこも": "جَمِيع أَنْحَاء, كُلّ",
 "どこもかも": "جَمِيع أَنْحَاء, كُلّ",
 "どこもここも": "جَمِيع أَنْحَاء, كُلّ",
 "どこやら": "مَكَان مَا (مَوْضِع؛ المنزلة والشأن، يقال أيضا مكانة)\nمثال: هذا المكان مقدس / بشكل ما, بطريقة أو بأخرى (بطريقة أو أسلوب غير محدد؛ أو بوسيلة غير محددة)\nمثال: لقد تدبروا الأمر بطريقة ما",
 "どこら": "أَيْن, فين",
 "どこらあたり": "أَيْن, فين",
 "どこらへん": "أَيْن, فين",
 "どこら辺": "أَيْن, فين",
 "どこら辺り": "أَيْن, فين",
 "どころ": "مَطْعَم",
 "どころか": "عَفْوًا, عَلَى الرُحْب وَالسَّعَة / نَاهِيك",
 "どこをどう": "كَيْف, ازاي",
 "どこんじょう": "إقدام, عزيمة (الثبات والتصميم)\nمثال: لم يكن لديه الجرأة لتجربتها",
 "どこ吹く風": "لَا مُبَالٍ, مُتَهَتِّك (يَتَّسِمُ بِعَدَمِ المُبَالَاةِ بِالأَعْرَافِ أَوْ بِسُوءِ السُّمْعَة)",
 "どご": "لَهْجَة, الْعَامِّيَّة (طَرَفُ ٱللِّسَانِ؛ جَرْسُ ٱلْكَلَامِ)\nمثال: الشاوية هي لهجة للأمازيغية.",
 "どごう": "خوار, زئير (تلفظ عالٍ جداً (مثل صوت حيوان))\nمثال: ملأ خواره الممر",
 "どさ": "رَاسِب",
 "どさくさ": "اِلْتِبَاس\nمثال: لا داعي لارتباك.",
 "どさくさまぎれ": "اِلْتِبَاس\nمثال: لا داعي لارتباك.",
 "どさくさ紛れ": "اِلْتِبَاس\nمثال: لا داعي لارتباك.",
 "どさどさ": "حَالاً (مباشرةً، فوراً، دون تأخير؛ في هذه الأثناء، في الوضع الحالي)\nمثال: سأكون معك حالا.",
 "どさまわり": "رِحْلَة",
 "どさん": "حَالِيّ, حَاضِر\nمثال: أنا موجود لوحدي",
 "どさ回り": "رِحْلَة",
 "どし": "حبيب, صديق حميم (رجل هو عشيق لرجل أو امرأة)\nمثال: لو علمت أنه حبيبها لما سألت",
