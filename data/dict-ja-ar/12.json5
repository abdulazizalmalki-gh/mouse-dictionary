 "ながてぶくろ": "عقاب الممر (شكل من أشكال العقاب يُجبر فيه الشخص على الركض بين صفين من الرجال يواجهون بعضهم…)\nمثال: رمى قفاز التحدي",
 "ながなが": "بإسهاب, مطولاً (بطريقة مطولة أو مسهبة)\nمثال: استمر الجدال مطولاً / بَعِيد (ضد القَرِيب، الذي يفصل بينك وبينه مسافة أو زمان)\nمثال: إنها بعيدة جدا.",
 "ながながしい": "إِطْنَابِيّ, ثَرْثَار (يَسْتَخْدِمُ أَوْ يَحْتَوِي عَلَى كَلِمَاتٍ أَكْثَرَ مِمَّا يَنْبَغِي)",
 "ながね": "اِسْتَغْرَقَ فِي النَّوْم",
 "ながねぎ": "بصل أخضر (بصل صغير قبل تضخم البصلة؛ يؤكل في السلطات)",
 "ながねん": "دهر, سنوات (فترة زمنية طويلة)\nمثال: نحن نعرف بعضنا منذ دهر",
 "ながの": "طَوِيل / نَاغَانُو",
 "ながびかせる": "أَطَالَ",
 "ながびく": "ثَابَرَ",
 "ながぼいん": "حركة طويلة, صائت طويل (صائت يتم نطقه عادة لفترة أطول نوعاً ما من الصوائت الأخرى (عادة حوالي 1.5 إلى…)",
 "ながむ": "نَظَرَ (اِسْتَعْمَلَ عينه ليَرَى الشيءَ، ليُدْرِكَه ويُبْصِرَه. (مَصْدَرُهُ نَظَر)…)\nمثال: نظر إلى السماء. / عَجَبَ / لَاحَظَ, رَاقَبَ",
 "ながむし": "ثُعْبَان, حَنَش",
 "ながめ": "مَنْظَر, مَشْهَد / طَوِيل نَوْعًا مَا (أَطْوَل بِقَليل مِنَ المُعْتاد)",
 "ながめまわす": "تَلَفَّتَ",
 "ながめる": "نَظَرَ (اِسْتَعْمَلَ عينه ليَرَى الشيءَ، ليُدْرِكَه ويُبْصِرَه. (مَصْدَرُهُ نَظَر)…)\nمثال: نظر إلى السماء. / عَجَبَ / لَاحَظَ, رَاقَبَ",
 "ながもち": "دَائِم طَوِيْلًا",
 "ながもの": "فيل أبيض (فيل هندي أمهق؛ نادر ومقدس أحياناً في شرق آسيا)",
 "ながや": "مبنى سكني متهالك, نزل رخيص (مبنى سكني متهالك بالكاد يفي بالمعايير الدنيا)",
 "ながやり": "بايك, سمك الكراكي (أي من عدة أسماك صيد وغذاء ممدودة طويلة الخطم تعيش في المياه العذبة وتنتشر على…)",
 "ながら": "مُدَّة\nمثال: جون في عمر أخي. / كُلّ, جَمِيع / كَـ, مِثْل\nمثال: قصدته مثل نكتة.",
 "ながらく": "طَوِيل",
 "ながらに": "مُدَّة\nمثال: جون في عمر أخي.",
 "ながらも": "رَغْم أَنّ ((رَغَمَ) رَغْمًا، ومَرْغَمًا، ومَرْغَمَةً: ذَلَّ؛ (رَغَمَ) ذل عن كَرْه. يقال…)\nمثال: إنه سعيد رغم فقره. / مُدَّة\nمثال: جون في عمر أخي.",
 "ながれ": "تَدَفُّق / طَبَق, وَجْبَة (جَعَلَ شيئًا يغطي شيئًا آخر بشكل كامل؛ نفَّذَ أمرًا أو خطةً عمليةً)\nمثال: هذا الطبق لذيذ. / نُزُول / فقدان كعقوبة, مصادرة (فعل فقدان أو تسليم شيء ما كعقوبة لخطأ أو فشل في الأداء)\nمثال: حدد العقد مصادرات إذا لم يكتمل العمل في الوقت المحدد",
 "ながれぎ": "خشب طاف (خشب يطفو أو جرفته الأمواج إلى الشاطئ)",
 "ながれず": "مخطط انسيابي, مخطط تدفق (رسم تخطيطي لتسلسل العمليات في برنامج كمبيوتر أو نظام محاسبي)",
 "ながれつく": "نفق أفقي (ممر أفقي (أو شبه أفقي) في منجم)\nمثال: حفروا نفقاً أفقياً موازياً للعرق المعدني",
 "ながれぼし": "شِهَاب / سَعِيرَا",
 "ながれもの": "غَرِيب, غَرِيبَة / انجراف (انحراف (سفينة أو طائرة) عن مسارها المقصود بسبب الانجراف)",
 "ながれる": "جَدْوَل / نفق أفقي (ممر أفقي (أو شبه أفقي) في منجم)\nمثال: حفروا نفقاً أفقياً موازياً للعرق المعدني / مَسَحَ (مَرَّ عليه بكفه وهو يلامسه؛ مَحَا، مرَّ عليه بكفه حتى يُزيله)\nمثال: مسح توم الطاولة. / انتكاس, تراجع (فشل في الحفاظ على حالة أعلى)\nمثال: فترة انقطاع لمدة ثلاثة أسابيع بين الرسائل",
 "ながわきざし": "مُقَامِر",
 "ながズボン": "بِنْطَال, سِرْوَال (البِنْطَال : ضرب من الألبسة حديث يلبس في النصف الأسفل من الجسم يتكون من ساقين…)\nمثال: هذا السروال يناسبني.",
 "ながーい": "طَوِيل",
 "なき": "بُكَاء / مَيِّت مَيْت, مُتَوَفًّى / بِلَا, غَيْر",
 "なきいる": "فجأة بدأ يبكي",
 "なきうさぎ": "بيكا (ثديي حفار صغير قصير الأذن من المرتفعات الصخرية في آسيا وغرب أمريكا الشمالية)",
 "なきおとし": "قِصَّة اسْتِعْطَاف, قِصَّة حَزِينَة (قصة عاطفية (أو دراما) عن ضائقة شخصية؛ مصممة لإثارة التعاطف)",
 "なきおどし": "قِصَّة اسْتِعْطَاف, قِصَّة حَزِينَة (قصة عاطفية (أو دراما) عن ضائقة شخصية؛ مصممة لإثارة التعاطف)",
 "なきかなしむ": "رثاء, عويل (صرخة حزن وأسى)\nمثال: يمكن سماع نواحهم المثير للشفقة في جميع أنحاء الجناح",
 "なきがら": "جُثَّة, جُثْمَان (جسد إنسان ميت)\nمثال: كانت الجثة مخصصة للتشريح",
 "なきごえ": "بَكَى, عَيَّط (دَمَعَتْ عَيناهُ حزنا؛ بكى الْمَيِّت: رثاه)\nمثال: بكى زيري كثيرا.",
 "なきごと": "شِكَايَة, شَكْوَى",
 "なきさけぶ": "صرخة\nمثال: صرخ طالبا النجدة.",
 "なきしきる": "رثاء, عويل (صرخة حزن وأسى)\nمثال: يمكن سماع نواحهم المثير للشفقة في جميع أنحاء الجناح",
 "なきじゃくる": "شهيق, شهقة",
 "なきたてる": "رثاء, عويل (صرخة حزن وأسى)\nمثال: يمكن سماع نواحهم المثير للشفقة في جميع أنحاء الجناح",
 "なきたま": "رُوح (رَوَّحَ عليه بالمِرْوحَة: حَرَّكَها ليجلبَ إِليه نسيمَ الهواء؛ رَوَّحَ بالقوم:…)\nمثال: كان سامي هو روح الحفلة.",
 "なきだす": "فجأة بدأ يبكي\nمثال: 彼女は今にも泣き出しそうだった。 — كادت أن تبكي.",
 "なきつく": "اِلْتِمَاس, اِسْتِئْنَاف",
 "なきどころ": "نقطة ضعف (صفة غير كافية أو ناقصة)",
 "なきどり": "طائر مغرد (أي طائر له نداء موسيقي)",
 "なきにしもあらず": "هُنَاكَ, يُوجَدُ",
 "なきねいり": "ترك, هجران (فعل الهجر أو التخلي)",
 "なきひと": "مَيِّت مَيْت, مُتَوَفًّى",
 "なきべそをかく": "أنين, تباكي (شكوى يتم التلفظ بها بطريقة شاكية وحزينة)",
 "なきまね": "دموع التماسيح (إظهار نفاق للحزن؛ بكاء كاذب أو غير صادق)\nمثال: ذرفت السكرتيرات دموع التماسيح على معضلة المدير",
 "なきみそ": "بكاء, كثير الشكوى (شخص يميل إلى الشكوى المفرطة والبكاء والأنين)",
 "なきむし": "بكاء, كثير الشكوى (شخص يميل إلى الشكوى المفرطة والبكاء والأنين)",
 "なきもの": "راحل, فقيد (شخص فارق الحياة ولم يعد حياً)\nمثال: أتساءل عما كان سيفعله الميت",
 "なきものにする": "قَتَلَ, قتل (تعمّد جعله يَمُوتُ، أزهق روحه، أمَاتَه متعمدا؛ الوقتَ: ضيعه بشيء غير ذي فائدة…)\nمثال: قتل الصياد دبا.",
 "なきゃ": "إِلَّا (حرف استثناء؛ في : للسؤال المنفي، مرادف لبَلَى في الفصحى)\nمثال: لا أعرف إلا هذا.",
 "なきゃいけない": "حَتْمِيّ, لَا مَفَرَّ مِنْه (لا يمكن تجنّبه أو الاستغناء عنه)\nمثال: أطعمة لا غنى عنها للتغذية الجيدة",
 "なきゃならない": "حَتْمِيّ, لَا مَفَرَّ مِنْه (لا يمكن تجنّبه أو الاستغناء عنه)\nمثال: أطعمة لا غنى عنها للتغذية الجيدة",
 "なきわめく": "رثاء, عويل (صرخة حزن وأسى)\nمثال: يمكن سماع نواحهم المثير للشفقة في جميع أنحاء الجناح",
 "なぎ": "هَادِئ / ناجي, ناجيا (شجرة متوسطة الحجم ذات أوراق رمحية لامعة؛ جنوب الصين إلى تايوان وجنوب اليابان)",
 "なぎいかだ": "سَفَنْدَر",
 "なぎさ": "شَاطِئ (المنطقة اليابسة على طول حافة البحر والمحيط. شَطّ، سَاحِل، جَانِب؛ (غير شائعة)…)\nمثال: عاد إلى الشاطئ.",
 "なぎたおす": "صَرَعَ (طَرَحَه على الأرض؛ أَرْدَاهُ قَتِيلاً وأَهْلَكَهُ) / غَلَبَ, هَزَمَ (قَهَرَ واِعْتَزَّ عليه واِمْتَنَع)",
 "なぎなた": "فَنٌّ قِتَالِيّ, الفُنُون القِتَالِيَّة (نوع، صنف؛ كل عمل جميل يؤثر في المشاعر والعواطف)\nمثال: هذا مدرسنا في الفن.",
 "なぎはらう": "خَطّ مَائِل (كِتَابَة؛ ما يَصِل نقطتين أو أكثر)\nمثال: إرسم خط مستقيم.",
 "なぎもどき": "خشب الكاوري (خشب أبيض دقيق الحبيبات لشجرة من جنس أغاتيس)",
 "なぎ倒す": "صَرَعَ (طَرَحَه على الأرض؛ أَرْدَاهُ قَتِيلاً وأَهْلَكَهُ) / غَلَبَ, هَزَمَ (قَهَرَ واِعْتَزَّ عليه واِمْتَنَع)",
 "なぎ払う": "خَطّ مَائِل (كِتَابَة؛ ما يَصِل نقطتين أو أكثر)\nمثال: إرسم خط مستقيم.",
 "なく": "بَكَى, عَيَّط (دَمَعَتْ عَيناهُ حزنا؛ بكى الْمَيِّت: رثاه)\nمثال: بكى زيري كثيرا. / تَأَلَّمَ, عَانَى\nمثال: لقد عانى جمال كثيرا. / قَبِلَ (وضع فمه على الشخص أو الشيء علامة الحب والاحترام. في العاميّة يُقال بَاسَ)\nمثال: كنت هنا من قبل. / عَوِيل, رَثَاء\nمثال: بكى زيري كثيرا. / دَعَا, نَادَى (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه)\nمثال: دعا ثلاميذه الاثني عشر",
 "なくした": "مَاضٍ, الْمَاضِي ((في النحو) زمن نحوي يدل على حدث قد وقع، أو وُجِد قبل الآن بوقت ما)",
 "なくして": "بِدُونِ, بِلَا\nمثال: 労なくして益なし。 — كل شيء وله ثمن",
 "なくしては": "بِدُونِ, بِلَا",
 "なくす": "فَقَدَ\nمثال: خسر توم وظيفته. / تَخَلَّصَ ؛ مِن",
 "なくちゃ": "بِدُونِ, بِلَا",
 "なくちゃいけない": "حَتْمِيّ, لَا مَفَرَّ مِنْه (لا يمكن تجنّبه أو الاستغناء عنه)\nمثال: أطعمة لا غنى عنها للتغذية الجيدة",
 "なくては": "بِدُونِ, بِلَا",
 "なくてはいけない": "حَتْمِيّ, لَا مَفَرَّ مِنْه (لا يمكن تجنّبه أو الاستغناء عنه)\nمثال: أطعمة لا غنى عنها للتغذية الجيدة",
 "なくてはいけません": "حَتْمِيّ, لَا مَفَرَّ مِنْه (لا يمكن تجنّبه أو الاستغناء عنه)\nمثال: أطعمة لا غنى عنها للتغذية الجيدة",
 "なくてはならない": "حَتْمِيّ, لَا مَفَرَّ مِنْه (لا يمكن تجنّبه أو الاستغناء عنه)\nمثال: أطعمة لا غنى عنها للتغذية الجيدة",
 "なくてもいい": "يَضْطَر",
 "なくてもよい": "يَضْطَر",
 "なくても良い": "يَضْطَر",
 "なくなく": "باكياً, والدموع في عينيه (مع الدموع؛ بطريقة دامعة)\nمثال: اعترف الرجل باكياً بضرب زوجته / بتردد, على مضض (مع تردد أو عدم رغبة)",
 "なくなす": "فَقَدَ\nمثال: خسر توم وظيفته.",
 "なくなる": "مَاتَ (للحَيّ: فقد الحَيَاة. مصدره مَوتَا ومِيتَة؛ للأرض: ليس فيها شيء حَيّ من النبات…)\nمثال: إعتقدت أنه مات. / اِخْتَفَى (تعمّد وتكلف إخفاء نفسه عنه الأنظار فلا يُرى؛ خَفِيَ بعد أن كان مرئيًّا)\nمثال: لقد اختفى فاضل.",
 "なくになけない": "مُذِلّ, مُهِين (يُثِير الشُّعُور بِالنَّقْص أَوِ القُصُور)",
 "なくはない": "قَلِيلًا",
 "なくもがな": "عَدِيمُ الْفَائِدَةِ (عديم: فقير؛ عديم: أحمق، غبي)\nمثال: كن عديم الرحمة.",
 "なぐ": "جَزَّ (جَزَّ النخلُ ونحوُه يَجُزُّ جَزًّا: حان أَن يُقطَعَ ثَمَرُهُ؛ جَزَّ النَّخلَةَ…)\nمثال: طلبت من توم جز عشبنا. / أَهْدَأَ, هَدَّأَ",
 "なぐさみ": "تَسْلِيَة",
 "なぐさみはんぶん": "مُتَقَلِّب",
 "なぐさみもの": "ألعوبة, لعبة (شيء مصنوع مصمم للعب به)",
 "なぐさめ": "رَاحَة",
 "なぐさめる": "رَاحَة",
 "なぐりあう": "عَارَكَ, قَاتَلَ\nمثال: لن يحل القتال أي شيء.",
 "なぐりがき": "خربشة",
 "なぐりこみ": "مُدَاهَمَة",
 "なぐりこむ": "مُدَاهَمَة",
 "なぐりたおす": "صَرَعَ (طَرَحَه على الأرض؛ أَرْدَاهُ قَتِيلاً وأَهْلَكَهُ)",
 "なぐり倒す": "صَرَعَ (طَرَحَه على الأرض؛ أَرْدَاهُ قَتِيلاً وأَهْلَكَهُ)",
 "なぐる": "ضَرَبَ (معروف، وهو اللطم أو الدق أو الصكّ و ما أشبه؛ النَوْع أو الصنف أو المثال)\nمثال: ضرب سامي زوجته.",
 "なけなし": "بَخْس (بَخَسَ؛ بَخِسَ)\nمثال: بيع المنزل بثمن بخس.",
 "なけばならない": "وَجَبَ, يَتَحَتَّم (لَزِمَ، تَعَيَّنَ. (مصدره وُجُوب)؛ لزم وصار أكيد حدوثه. (مصدره وجُوب))\nمثال: وجب عليك إيقافه.",
 "なければ": "إِلَّا (حرف استثناء؛ في : للسؤال المنفي، مرادف لبَلَى في الفصحى)\nمثال: لا أعرف إلا هذا.",
 "なければいけない": "وَجَبَ, يَتَحَتَّم (لَزِمَ، تَعَيَّنَ. (مصدره وُجُوب)؛ لزم وصار أكيد حدوثه. (مصدره وجُوب))\nمثال: وجب عليك إيقافه.",
 "なければいけません": "وَجَبَ, يَتَحَتَّم (لَزِمَ، تَعَيَّنَ. (مصدره وُجُوب)؛ لزم وصار أكيد حدوثه. (مصدره وجُوب))\nمثال: وجب عليك إيقافه.",
 "なければならない": "وَجَبَ, يَتَحَتَّم (لَزِمَ، تَعَيَّنَ. (مصدره وُجُوب)؛ لزم وصار أكيد حدوثه. (مصدره وجُوب))\nمثال: وجب عليك إيقافه.",
 "なければならぬ": "وَجَبَ, يَتَحَتَّم (لَزِمَ، تَعَيَّنَ. (مصدره وُجُوب)؛ لزم وصار أكيد حدوثه. (مصدره وجُوب))\nمثال: وجب عليك إيقافه.",
 "なければなりません": "وَجَبَ, يَتَحَتَّم (لَزِمَ، تَعَيَّنَ. (مصدره وُجُوب)؛ لزم وصار أكيد حدوثه. (مصدره وجُوب))\nمثال: وجب عليك إيقافه.",
 "なければなるまい": "يَنْبَغِي أَنْ\nمثال: يا لها من جملة!",
 "なげ": "رَمَى, صَبَّ ((مُتَعَدٍّ بِنَفْسِهِ) جَعَلَهُ يَتَحَرَّكُ فِي الهَوَاءِ)\nمثال: رمى تلك الموزة. / اِسْتَقَالَ / غربلة, هزة (اقتصادية) (حالة اقتصادية تؤدي إلى إقصاء المشاركين الممولين بشكل هامشي في صناعة…)\nمثال: أغرقوا السوق من أجل إحداث هزة لمنافسيهم / سَطْحِيّ, عَابِر (مُسْتَعْجِل وبِدُون اهْتِمَام بِالتَّفَاصِيل؛ غَيْر شَامِل)",
 "なげあみ": "شَبَكَة",
 "なげうつ": "طَرَحَ (طَرَحَ الشَّيْءَ: أَلْقَاهُ؛ طَرَحَ فُلَاناً أَرْضاً: أَوْقَعَهُ)\nمثال: طرح زيري سؤالا.",
 "なげうり": "إغراق (بيع البضائع في الخارج بسعر أقل من السعر المفروض في السوق المحلية)",
 "なげおろす": "مَزْبَلَة, نُفَايَة (موضع تجميع الأَزْبَال والتِفَايَات لحين نقلها؛ حَاوِيَة نفايات؛ موضع خارج…)\nمثال: وضع فاضل جثة دانية في مزبلة.",
 "なげかける": "دَارَ, أَدَارَ (المحل يجمع البِنَاء والعَرَصَة. قيل سمي كذلك لدوران الناس به وعليه وحوله. يجمع…)\nمثال: إذهب إلى الدار.",
 "なげかわしい": "مُؤْسِف",
 "なげき": "غَمّ, حُزْن",
 "なげきのかべ": "حَائِط الْبُرَاق, حَائِط الْغَرْبِي",
 "なげきばと": "حمامة الحداد (حمامة برية في الولايات المتحدة لها نداء حزين)",
 "なげく": "عَوِيل, رَثَاء\nمثال: بكى زيري كثيرا.",
 "なげこみ": "أَدْخَلَ",
 "なげすてる": "طَرَحَ (طَرَحَ الشَّيْءَ: أَلْقَاهُ؛ طَرَحَ فُلَاناً أَرْضاً: أَوْقَعَهُ)\nمثال: طرح زيري سؤالا.",
 "なげせん": "طَرَف",
 "なげぜに": "طَرَف",
 "なげだす": "مَدَّدَ / اِنْصَرَفَ, يَنْصَرِفُ (فعل مطاوعة لصَرَفَ: صَرَفْتُهُ فَاَنْصَرَف؛ ذهب إلى مكان آخر)\nمثال: انصرف من ملكيتنا! / تَضْحِيَة, قُرْبَان",
 "なげづな": "حبل الرمي (حبل خفيف الوزن مزود بوزن في نهايته، يُلقى بين سفينتين أو بين سفينة والشاطئ لسحب…)\nمثال: غالباً ما تُستخدم عقدة قبضة القرد كوزن في حبل الرمي",
 "なげづり": "صيد الأمواج (رمي طعم (صناعي) بعيداً في المحيط (حتى 200 ياردة) مع تكسر الأمواج حولك)",
 "なげとばす": "عَلَاقَة سَرِيعَة, علاقة طيارى\nمثال: صب الشاي لضيفك.",
 "なげなわ": "أنشوطة, وهق (حبل طويل ذو عقدة منزلقة يستخدم لصيد الحيوانات)",
 "なげに": "حطام عائم (حطام سفينة يطفو على الماء)",
 "なげもの": "تَصْفِية",
 "なげやり": "متهاون, مقصّر (يتميز بالإهمال وعدم الاكتراث غير المبرر)\nمثال: آباء مهملون / مِزْرَاق",
 "なげる": "رَمَى, صَبَّ ((مُتَعَدٍّ بِنَفْسِهِ) جَعَلَهُ يَتَحَرَّكُ فِي الهَوَاءِ)\nمثال: رمى تلك الموزة. / تَنَازَلَ / صَبَّ, رَمَى (سَكَبَ، الفرق بين صَبَّ وسَكَب أن الصَبّ يكون متعمدا والسكب قد يكون متعمدا أو…)\nمثال: صب الشاي لضيفك.",
 "なげわざ": "رَمَى, صَبَّ ((مُتَعَدٍّ بِنَفْسِهِ) جَعَلَهُ يَتَحَرَّكُ فِي الهَوَاءِ)\nمثال: رمى تلك الموزة.",
 "なげわたす": "تمرير, رمي ((رياضة) فعل رمي الكرة لعضو آخر في فريقك)\nمثال: تم إهدار التمريرة / اِسْتَسْلَمَ",
 "なげー": "طَوِيل",
 "なこうど": "خَاطِب, خَاطِبَة / حلقة وصل, وسيط (مفاوض يعمل كحلقة وصل بين الأطراف)",
 "なことば": "اِسْم الذَّات (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه…)\nمثال: ما اسم حصان توم؟",
 "なご": "الطَّبَقَاتُ الدُّنْيَا",
 "なごます": "هَادِئ",
 "なごむ": "أَهْدَأَ, هَدَّأَ",
 "なごめる": "هَادِئ",
 "なごや": "نَاغُويَا",
 "なごやか": "مُعْتَدِل (الأمر الوسط بين الطَرَفْيَن، نقيض المُتَطَرِّف)\nمثال: الجو معتدل هنا.",
 "なごり": "جُثَّة, جُثْمَان (جسد إنسان ميت)\nمثال: كانت الجثة مخصصة للتشريح / فِرَاقٌ / نِهَايَة, غَايَة\nمثال: انتهى أمر زيري.",
 "なごりおしい": "مُتَرَدِّد, مُحْجِم (غير متحمّس؛ يتردّد في الإقدام)",
 "なさいます": "فَعَلَ, عَمِلَ (عَمِلَ وصَنَعَ، بعلم أو بدون علم، عن قصد أو دون قصد)\nمثال: ماذا فعل للحمي؟",
 "なさけ": "شَفَقَة (وشَفِقَ على؛ الرحمة والعَطْف والحَنَان والحُنُوّ)\nمثال: زيري مثير للشفقة. / عاطفة, محبة (شعور إيجابي بالإعجاب)\nمثال: وجد صعوبة في التعبير عن المودة التي شعر بها",
 "なさけしらず": "بارد المشاعر, قاسي القلب (يفتقر إلى التعاطف أو الشعور)",
 "なさけない": "بَائِس",
 "なさけぶかい": "شَفَقَة (وشَفِقَ على؛ الرحمة والعَطْف والحَنَان والحُنُوّ)\nمثال: زيري مثير للشفقة.",
 "なさけようしゃ": "رَحْمَة, رَأْفَة",
 "なさけようしゃなく": "بقسوة بالغة, بلا رحمة (بدون شفقة؛ بطريقة لا ترحم)\nمثال: تعرض لهزيمة نكراء بلا رحمة من قبل خصمه في المجلس",
 "なさけをしる": "وَقَعَ فِي حُبّ (الشيء: سَقَطَ، انحدر من مكان عال؛ الأمر: حَدَثَ، وأكثر ما يقال للأمر العظيم)\nمثال: توم وقع و أصيب.",
 "なさしめる": "أَكْرَهَ, أَجْبَرَ",
 "なさそう": "مِنْ غَيْرِ المُرَجَّحِ (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "なさります": "فَعَلَ, عَمِلَ (عَمِلَ وصَنَعَ، بعلم أو بدون علم، عن قصد أو دون قصد)\nمثال: ماذا فعل للحمي؟",
 "なさる": "فَعَلَ, عَمِلَ (عَمِلَ وصَنَعَ، بعلم أو بدون علم، عن قصد أو دون قصد)\nمثال: ماذا فعل للحمي؟",
 "なされます": "فَعَلَ, عَمِلَ (عَمِلَ وصَنَعَ، بعلم أو بدون علم، عن قصد أو دون قصد)\nمثال: ماذا فعل للحمي؟",
 "なされる": "فَعَلَ, عَمِلَ (عَمِلَ وصَنَعَ، بعلم أو بدون علم، عن قصد أو دون قصد)\nمثال: ماذا فعل للحمي؟",
 "なざし": "تحديد الهوية, تعيين (فعل تعيين أو تحديد هوية شيء ما)\nمثال: كان يجب الموافقة على التعيين من قبل اللجنة بأكملها",
 "なざす": "اِسْم, أَسْمَاء (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه…)\nمثال: ما اسم حصان توم؟",
 "なし": "بِدُونِ, بِلَا / غَيْر مَقْبُول, مَرْفُوض (غير مقبول؛ غير مرحب به)\nمثال: كلمة غير مقبولة في المجتمع المهذب / مَعْدُوم",
 "なしうる": "قَابِل لِلتَّحْقِيق, قَابِل لِلْإِنْجَاز (يمكن تحقيقه أو إنجازه؛ في حيّز الإمكان)",
 "なしおえる": "أَدَّى",
 "なしおわる": "فَرَغَ, أَنْهَى\nمثال: انتهى أمر زيري.",
 "なしくずし": "رَدّ, مُعَامَلَة بِالمِثْل (عمل جماعي متبادل)\nمثال: في المقابل، أعطيناهم بقدر ما حصلنا عليه",
 "なしくずしてき": "تَدْرِيجِيّ",
 "なしじょうか": "ثمرة تفاحية (فاكهة لحمية (تفاح أو كمثرى أو فواكه ذات صلة) تحتوي على غرف بذور وجزء خارجي لحمي)",
 "なして": "صُورَة, شَكْل\nمثال: اجلس بشكل مريح. / كَيْف, ازاي",
 "なしで": "بِدُونِ, بِلَا",
 "なしですます": "اِسْتَغْنَى",
 "なしで済ます": "اِسْتَغْنَى",
 "なしとげる": "أَدَّى",
 "なしに": "بِدُونِ, بِلَا",
 "なしには": "بِدُونِ, بِلَا",
 "なしのみ": "كُمَّثْرَى, إِجَّاص",
 "なし崩し": "رَدّ, مُعَامَلَة بِالمِثْل (عمل جماعي متبادل)\nمثال: في المقابل، أعطيناهم بقدر ما حصلنا عليه",
 "なし崩し的": "تَدْرِيجِيّ",
 "なし得る": "قَابِل لِلتَّحْقِيق, قَابِل لِلْإِنْجَاز (يمكن تحقيقه أو إنجازه؛ في حيّز الإمكان)",
 "なし終える": "أَدَّى",
 "なし終わる": "فَرَغَ, أَنْهَى\nمثال: انتهى أمر زيري.",
 "なじませる": "يتكيف مع",
 "なじみ": "تبسط غير لائق, تطاول (فعل ينطوي على حميمية غير لائقة)\nمثال: خلق غياب الأسوار حميمية غامضة لم يعرف فيها أحد الخصوصية",
 "なじみきゃく": "عَادِيّ",
 "なじみぶかい": "مَأْلُوف",
 "なじみ客": "عَادِيّ",
 "なじみ深い": "مَأْلُوف",
 "なじむ": "بَذْلَة, بَدْلَة\nمثال: تمثال الحرية رمز لأمريكا.",
 "なじる": "تَأْنِيب, تَوْبِيخ (فعل أو تعبير عن النقد واللوم)\nمثال: اضطر لتلقي التوبيخ بابتسامة على وجهه",
 "なす": "صُورَة, شَكْل\nمثال: اجلس بشكل مريح. / خَلَقَ (أَنْشَأَ، أَوْجَدَ)\nمثال: زيري سيء الخلق. / أَدَّى / تَغَيَّرَƒ\nمثال: أنا غير متفاجئ. / بَاذِنْجَان, بَادِنْجَان / فَعَلَ, صَنَعَ (عَمِلَ وصَنَعَ، بعلم أو بدون علم، عن قصد أو دون قصد)\nمثال: ماذا فعل للحمي؟ / وَلَدَ (الرجلُ و المرأةُ ومثلهما الانسان: أنجب؛ الرجلُ و المرأةُ وَلَدًا: أنجبه)\nمثال: أعرف ذلك الولد. / كَـ / فَعَلَ, عَمِلَ (عَمِلَ وصَنَعَ، بعلم أو بدون علم، عن قصد أو دون قصد)\nمثال: ماذا فعل للحمي؟ / اِسْتَعْمَرَ (اِسْتَعْمَرَ الاِسْتِعْمارُ الفَرَنْسِيُّ البِلادَ بِالسِّلاَحِ: دَخَلَها…)\nمثال: استقر زيري في خيمته.",
 "なすがまま": "تَحْتَ رَحْمَةِ (أَقَلَّ)\nمثال: أنا تحت الشجرة.",
 "なすすべ": "طريقة, واسطة (امتلاك القدرة على إنتاج تأثير معين أو تحقيق غاية)\nمثال: وسيلة للسيطرة",
 "なすすべもない": "بِخَسَارَة (أقل من التكلفة)\nمثال: باع السيارة بخسارة",
 "なすった": "جَاهِز, نَاضِج (مَطْهُوٌّ حَتَّى أَصْبَحَ جَاهِزًا لِلتَّقْدِيم)",
 "なすび": "بَاذِنْجَان, بَادِنْجَان",
 "なすりあい": "اتهام متبادل, تلاوم (اتهامات متبادلة)",
 "なすりつける": "حَكَّ, فَرَكَ (مَرَّرَ شَيْئًا عَلَى شَيْءٍ آخَرَ بِقُوَّةٍ لِيُزِيلَ مَا عَلَيْهِ؛ حَكَّ…)\nمثال: لقد حك سامي كعبه حتى بدأ ينزف. / وَضَعَ (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه)\nمثال: لقد أزمت الوضع.",
 "なすり合い": "اتهام متبادل, تلاوم (اتهامات متبادلة)",
 "なする": "تلطيخ, رسم رديء (لوحة غير متقنة)\nمثال: كانت هناك لطخة على خده",
 "なす術": "طريقة, واسطة (امتلاك القدرة على إنتاج تأثير معين أو تحقيق غاية)\nمثال: وسيلة للسيطرة",
 "なす術もない": "بِخَسَارَة (أقل من التكلفة)\nمثال: باع السيارة بخسارة",
 "なずき": "دِمَاغ",
 "なずく": "أَخَذَ (تَنَاوَلَ الشيء بيده، تملكه أو تحكم فيه، بالقوة أو بدونها؛ أمْسَكَ بِالشيء…)\nمثال: أخذ الولد يبكي.",
 "なずな": "كِيس الرَاعِي",
 "なせん": "طِبَاعَة",
 "なぜか": "بشكل ما, بطريقة أو بأخرى (بطريقة أو أسلوب غير محدد؛ أو بوسيلة غير محددة)\nمثال: لقد تدبروا الأمر بطريقة ما",
 "なぜかというと": "لِأَنَّ",
 "なぜか変換できない": "لَا أَعْلَمُ (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر…)",
 "なぜだか": "بشكل ما, بطريقة أو بأخرى (بطريقة أو أسلوب غير محدد؛ أو بوسيلة غير محددة)\nمثال: لقد تدبروا الأمر بطريقة ما",
 "なぜなら": "لِأَنَّ",
 "なぜならば": "لِأَنَّ",
 "なぜに": "لِمَاذَا\nمثال: لم يساعدني أحد.",
 "なぜる": "سكتة دِمَاغِيَّة",
 "なぞ": "لُغْز, أُحْجِيَّة (قالَ كلامًا خفيًا أو غير واضح، أو استخدم التورية والإشارة؛ عبّرَ عن شيء بطريقة…)\nمثال: لم يحل أبدا لغز وفاتها. / غَامِض, لُغْزِيّ (يشبه الألغاز في غموض الفكر والمعنى) / وَهٰكَذَا, وَهَلُمَّ جَرًّا / شَيْء (الموجود عرضاً كان أو جوهراً، ويصح أن يتصور ويخبر عنه؛ مَا أُخْبِرَ عَنْهُ: سواء…)\nمثال: في يدها شيء ما. / يَا لَ (يستعمل لنِدَاء البعيد والقريب)\nمثال: يا لها من جملة! / لِمَاذَا\nمثال: لم يساعدني أحد.",
 "なぞい": "سِرِّيّ, غَامِض (ذو طبيعة مُلتبِسة وعسيرة الفهم)",
 "なぞなぞ": "لُغْز, أُحْجِيَّة (قالَ كلامًا خفيًا أو غير واضح، أو استخدم التورية والإشارة؛ عبّرَ عن شيء بطريقة…)\nمثال: لم يحل أبدا لغز وفاتها.",
 "なぞめいた": "غَامِض, لُغْزِيّ (يشبه الألغاز في غموض الفكر والمعنى)",
 "なぞらえる": "قَلَّدَ",
 "なぞりがき": "تتبع, تقفي الأثر (اكتشاف ووصف مسار تطور شيء ما)\nمثال: تتبع الأنساب",
 "なぞり書き": "تتبع, تقفي الأثر (اكتشاف ووصف مسار تطور شيء ما)\nمثال: تتبع الأنساب",
 "なぞる": "أَثَر (عَلَامَة؛ بَقِيَّة؛ رَسْم مُتَخَلَّف من شيء ما؛ تأثير؛ انطباع)\nمثال: اختفى فلم ير له أثر. / قَلَّدَ",
 "なぞをかける": "تَلْمِيح\nمثال: لمح سامي منزلا.",
 "なたがま": "ساطور مقوس, منجل التقليم (أداة قطع ذات حافة حادة)\nمثال: استخدم منجلاً لتقليم الأغصان عن الشجرة",
 "なたね": "بذور السلجم (بذرة نباتات السلجم؛ مصدر لزيت صالح للأكل)",
 "なたねあぶら": "زيت السلجم, زيت الكولزا (زيت صالح للأكل أصفر فاتح إلى بني من بذور اللفت يُستخدم أيضاً كمواد تشحيم أو…)",
 "なたねな": "اِغْتِصَاب (أَخْذُ الشيء قَهْراً وَظُلْماً؛ اِسْتِخْدَامُ العُنْفِ مَعَ النساء لِنَيْلِ…)\nمثال: تعرض زيري للاغتصاب.",
 "なたねゆ": "زيت السلجم, زيت الكولزا (زيت صالح للأكل أصفر فاتح إلى بني من بذور اللفت يُستخدم أيضاً كمواد تشحيم أو…)",
