 "にわみぐさ": "برسيم الشجيرة, ليسبيديزا (نباتات شجيرية أو عشبية تستخدم على نطاق واسع للعلف وتحسين التربة وخاصة التبن في جنوب الولايات المتحدة)",
 "にわやなぎ": "عشب العقدة (عشب ضار منخفض النمو بسنيبلات على طول سيقان الأوراق)",
 "にん": "نَوَاة / وَاجِب, فَرِيضَة (اسم لما يُوجَبُ فعله؛ اسم لما صار حدوثه أكيد)\nمثال: لا شكر على واجب. / تحمل, جلد (القدرة على تحمل المشقة أو التوتر) / بقاء, نجاة (حالة البقاء على قيد الحياة)\nمثال: يختبر الماراثون قدرة تحمل العداء",
 "にんい": "اِخْتِيَارِيّ / اِعْتِبَاطِيّ",
 "にんいしんごう": "اِخْتِيَارِيّ",
 "にんいちゅうしゅつ": "أخذ عينات عشوائي (اختيار عينة عشوائية؛ حيث يكون لكل عنصر من عناصر المجتمع فرصة متساوية في الاختيار)",
 "にんか": "قُبُول, قَبُول (القبول: الرِّضَا بالشيء وميل النفس إليه والحسن والشارة وريح الصبا؛ (المعجم الوسيط)؛ ريح شرقية)\nمثال: أميل إلى قبول العرض.",
 "にんかしょう": "رُخْصَة, تَصْرِيح / رُخْصَة",
 "にんかん": "مَوْعِد, مِيعَاد (مَوْعِد الإفطار،أي وقت الإفطار؛ لديه مَوْعِد مع صديق)\nمثال: مناد عنده موعد.",
 "にんき": "شَعْبِيَّة / شَرْط (شَرِطَ فلانٌ يَشْرِطِ شَرْطًا: وقع في أَمر عظيمٍ)\nمثال: صرخ ليون: \"شرطة!\" / فترة منصب, فترة ولاية (الفترة التي يتم خلالها شغل منصب ما)",
 "にんきとうひょう": "مُسَابَقَة شَعْبِيَّة (منافسة (حقيقية أو مجازية) للحصول على الدعم الشعبي)",
 "にんきど": "تقدير, تقييم (فعل التأكد من أو تحديد قيمة أو جدوى شيء ما) / تثمين, تقدير (تقدير لقيمة شيء ما) / تصنيف, تقييم (المكانة أو الموقع على مقياس) / رتبة عسكرية (الرتبة في منظمة عسكرية)\nمثال: وضع تقييماً عالياً للصداقة",
 "にんきのある": "مَحْبُوب",
 "にんきもの": "مَحْبُوب, مُفَضَّل (يروق لعامة الناس ويستهويهم) / مفضل (شيء يحظى بتفضيل أو إعجاب خاص) / حبيب, مفضل (شخص محبوب مميز) / مرشح للفوز, مفضل (منافس يُعتقد أنه من المرجح أن يفوز)\nمثال: هذا الكتاب هو أحد مفضلاتي",
 "にんきやくしゃ": "إِجَّامَة / نَجْمَة",
 "にんきょ": "رَضِيَ, وَافَقَ (قَبِلَ؛ سلَّم واقتنع) / رِضًا (مصدر الفعل \"رَضِيَ\")\nمثال: السكوت علامة الرضا. / قُبُول, قَبُول (القبول: الرِّضَا بالشيء وميل النفس إليه والحسن والشارة وريح الصبا؛ (المعجم الوسيط)؛ ريح شرقية)\nمثال: أميل إلى قبول العرض.",
 "にんきょう": "مُرُوءَة / يَاكُوزَا",
 "にんきをさらう": "فِي مُؤَخِّرَة المَسْرَح (عند أو باتجاه خلفية المسرح) / بَارِدُ الطِّبَاعِ, مُتَبَاعِدٌ (متباعد ومتحفظ في التعامل) / خلفي (للمسرح) (للنصف الخلفي من خشبة المسرح) / مؤخرة المسرح (الجزء الخلفي من المسرح)\nمثال: تم توجيه الراقصين للتحرك نحو مؤخرة المسرح",
 "にんぎょ": "خَيَلَان, اِبْنَة الْبَحْر",
 "にんぎょう": "دُمْيَة",
 "にんぎょうげき": "عرض دمى, مسرح عرائس (عرض يكون فيه الممثلون عبارة عن دمى)",
 "にんぎょうしばい": "عرض دمى, مسرح عرائس (عرض يكون فيه الممثلون عبارة عن دمى)",
 "にんぎょうつかい": "محرك الدمى (شخص يحرك الدمى أو الماريونيت)",
 "にんぎょうづかい": "محرك الدمى (شخص يحرك الدمى أو الماريونيت)",
 "にんぎょうのいえ": "بيت الدمية (نموذج صغير لمنزل يستخدم كلعبة للأطفال) / بيت الدمية (منزل صغير جداً لدرجة أنه يشبه لعبة الطفل)",
 "にんく": "تحمل, جلد (القدرة على تحمل المشقة أو التوتر) / بقاء, نجاة (حالة البقاء على قيد الحياة)\nمثال: يختبر الماراثون قدرة تحمل العداء",
 "にんげつ": "رجل-شهر, شهر عمل (وقت عمل شخص واحد لمدة شهر، يُستخدم كمقياس لمقدار العمل أو الجهد المطلوب لأداء مهمة ما)",
 "にんげん": "إِنْسَان, نَاس (كَائِن بَشَرِيّ؛ سَوَاد العَيْن)\nمثال: أنا إنسان صادق. / شَخْصِيَّة / خُلْق (أَنْشَأَ، أَوْجَدَ) / حَرْف, رَمْز (طَرَف وَجَانِب وَحَدّ؛ رَمْز مخطوط أو مطبوع يقوم مقام صوت أو كلمة أو عبارة أو معنى) / مِحْرَف\nمثال: زيري سيء الخلق.",
 "にんげんあい": "بَشَرِيَّة, إِنْسَانِيَّة / إِنْسَانِيَّة, بَشَرِيَّة",
 "にんげんか": "أَنْسَنَة",
 "にんげんかくちょう": "ههه",
 "にんげんかつどう": "عَمَل بَشَرِيّ, فِعْل (شيء يفعله الناس أو يتسبّبون في حدوثه)",
 "にんげんかんけい": "عَلَاقَة شَخْصِيَّة (علاقة بين الأشخاص)",
 "にんげんがた": "أندرويد, روبوت بشري (إنسان آلي يشبه البشر)",
 "にんげんぎらい": "بُغْض الْبَشَرِيَّة (البُغْض ضدّ الحبّ ، بغَض جَدُّك:كتعس جدّك،ونعِمَ الله بك عيناً وبغَض بعدوّك عيناً؛ بغَضَ فلانٌ الشّيءَ أو الشّخصَ:كَرِهَه ومَقَتَه وأعرض عنه)\nمثال: سأذهب بغض النظر عن مجيئه.",
 "にんげんこうがく": "الأرغونوميا, تكنولوجيا حيوية (فرع العلوم الهندسية الذي تُستخدم فيه العلوم البيولوجية لدراسة العلاقة بين العمال وبيئاتهم)",
 "にんげんこうがくてき": "أرغونومي, هندسي بشري (مكون من أو متعلق ببيئة العمل (الأرغونوميا) وملائمتها للبشر)",
 "にんげんせい": "بَشَرِيَّة, إِنْسَانِيَّة / إِنْسَانِيَّة, بَشَرِيَّة",
 "にんげんせいたいがく": "ديموغرافيا, علم السكان (فرع علم الاجتماع الذي يدرس خصائص السكان البشريين)",
 "にんげんそがい": "التَّجْرِيد مِن الإنْسَانِيَّة",
 "にんげんちゅうしんしゅぎ": "مركزية بشرية (الميل لتقييم الواقع حصرياً من حيث القيم البشرية)",
 "にんげんちゅうしんてき": "متمركز حول الإنسان (يتمحور حول الإنسان)\nمثال: نظرتنا للعالم التي تتمركز حول الإنسان",
 "にんげんてき": "بَشَرِيّ, إنْسَانِيّ / آدْمِيّ, بَشَرِيّ / إِنْسَان (كَائِن بَشَرِيّ؛ سَوَاد العَيْن) / نَاس (اسم للجمع من بني آدم واحده إِنْسَان أو إِنْس) / إِنْس / إنسان (كَائِن بَشَرِيّ؛ سَوَاد العَيْن) / بنيآدم\nمثال: أنا إنسان صادق.",
 "にんげんどう": "إِنْسَانِيَّة, رَأْفَة (صفة الرحمة أو مراعاة الآخرين (الناس أو الحيوانات))",
 "にんげんどうし": "بَشَرِيَّة, الْجِنْس الْبَشَرِيّ",
 "にんげんのくず": "عَدِيمُ الجَدْوَى, لَا خَيْرَ فِيه (بِلَا اسْتِحْقَاق؛ ذُو قِيمَةٍ أَوْ فَائِدَةٍ ضَئِيلَةٍ أَوْ مُنْعَدِمَة) / شخص عديم الفائدة, عاطل (شخص خامل لا قيمة له)",
 "にんげんのたて": "دِرْع بَشَرِيّ, دُرُوع بَشَرِيَّة (الثَلَاثُ الدُرَع: الليلة السادسة عشر والسابعة عشر والثامنة عشر من كل شهر قمري…)\nمثال: اعطني هذا الدرع.",
 "にんげんのだらく": "السقوط, الهبوط ((الميثولوجيا اليهودية المسيحية) عندما أكل آدم وحواء من ثمر شجرة معرفة الخير والشر، فعاقبهما الله بإخراجهما من جنة عدن إلى العالم حيث يخضعان للمرض…)",
 "にんげんのクズ": "عَدِيمُ الجَدْوَى, لَا خَيْرَ فِيه (بِلَا اسْتِحْقَاق؛ ذُو قِيمَةٍ أَوْ فَائِدَةٍ ضَئِيلَةٍ أَوْ مُنْعَدِمَة) / شخص عديم الفائدة, عاطل (شخص خامل لا قيمة له)",
 "にんげんらしい": "بَشَرِيّ, إنْسَانِيّ / آدْمِيّ, بَشَرِيّ / إِنْسَان (كَائِن بَشَرِيّ؛ سَوَاد العَيْن) / نَاس (اسم للجمع من بني آدم واحده إِنْسَان أو إِنْس) / إِنْس / إنسان (كَائِن بَشَرِيّ؛ سَوَاد العَيْن) / بنيآدم\nمثال: أنا إنسان صادق.",
 "にんげんりょく": "حُسْن التَّصَرُّف, دَهَاء (صفة القدرة على التعامل مع المواقف الصعبة) / دهاء, سعة الحيلة (القدرة على التعامل بدهاء مع المشاكل غير العادية)\nمثال: رجل ذو دهاء عظيم",
 "にんしき": "إذن بالكلام (تعيين من قبل رئيس الجلسة يمنح الشخص الحق في التحدث في هيئة تداولية) / تحديد الهوية, تعرف (عملية التعرف على شيء ما أو شخص ما عن طريق التذكر) / إدراك, اعتراف (الوصول إلى فهم شيء ما بوضوح وتميز) / إقرار, اعتراف (قبول (مثل قبول ادعاء) على أنه حقيقي وصالح)\nمثال: لم يتمكن من تقديم اقتراحه لأنه لم يحصل على إذن بالكلام من الرئيس",
 "にんしきちがい": "سُوء فَهْم",
 "にんしきひょう": "بطاقة تعريف الكلب (لوحة معدنية على طوق الكلب تحمل رقم تسجيله) / بطاقة تعريف عسكرية (بطاقة تعريف عسكرية تُلبس بسلسلة حول الرقبة)",
 "にんしきふのう": "غَيْر مَعْرُوف, غَيْر مُعتَرَف بِه (لم يُتعرَّف عليه أو يُقَرّ به) / غَيْر مُعْتَرَف بِه (لا يتمتّع بسمعة راسخة)",
 "にんしきりょく": "وعي (الفَهْم والتَدَبُّر واِحْتِوَاء كل معاني الشيء؛ في علم النفس: حالة وعي ويعني أيضا محتوى العقل، ويشمل المشاعر والوعي الذاتي وٱلصور وَالأفكار وَٱلقدرة على إدراك العلاقة بين المرء وٱلبيئة والشعور بما…)\nمثال: إنها فاقدة الوعي.",
 "にんしきろん": "إِبِسْتِمُولُوجِيَّا, نَظَرِيَّةْ اَلمَعْرِفَة",
 "にんしょう": "أُقْنُوم / فَرْد / توثيق, مصادقة (التحقق من صحة أو أصالة شيء أو شخص ما) / توثيق, منح امتياز (فعل التصديق أو منح حق الامتياز لـ) / اعتماد, شهادة (وثيقة تشهد بصحة وقائع معينة مذكورة) / إثبات, تأييد (تأكيد صحة حقيقة أو بيان من خلال استخدام الأدلة الوثائقية)",
 "にんしょうしょ": "شَهَادَة",
 "にんしょうだいめいし": "ضمير شخصي (ضمير يعبر عن تمييز الشخص (المتكلم، المخاطب، الغائب))",
 "にんしょうコード": "خبير توثيق, مُوثِّق (من يحدد الأصالة (كما في الأعمال الفنية) أو يضمن الصلاحية)",
 "にんしょうトークン": "رَمْز (رمز (جمعه رموز)؛ الرمز يعني الرسم الذي يعبر عن شيء معين وعموما فأن العلامة ينبغي نقل رسالتها بنظرة واحدة دون الحاجة للكلمات)\nمثال: تمثال الحرية رمز لأمريكا.",
 "にんしょく": "رِسامة",
 "にんしん": "حَمْل (رَفَعَ، أَقَلَّ)\nمثال: حمل سامي سلاحه.",
 "にんしんおそ": "قيء حملي مفرط (قيء مفرط أثناء الحمل؛ إذا كان شديدًا يمكن أن يؤدي إلى تلف الدماغ والكبد والكلى)",
 "にんしんけんさ": "اختبار الحمل (اختبار فسيولوجي لتحديد ما إذا كانت المرأة حاملاً)",
 "にんしんけんさやく": "اختبار الحمل (اختبار فسيولوجي لتحديد ما إذا كانت المرأة حاملاً)",
 "にんしんちゅうぜつ": "خِدَاج, إِجْهَاض",
 "にんしんちゅうどくしょう": "ما قبل تسمم الحمل, مقدمات الارتعاج (حالة غير طبيعية للحمل تتميز بارتفاع ضغط الدم واحتباس السوائل والبيلة الزلالية)",
 "にんじゃ": "نِينْجَا, نِنْجَا",
 "にんじゅう": "اِسْتِسْلَام, خُضُوع (فعل الخضوع؛ عادة تسليم السلطة لآخر) / رأي قانوني, طرح ((قانون) حجة يقدمها محامٍ لقاضٍ أو هيئة محلفين كجزء من القضية التي يرافعون فيها) / إحالة للتحكيم, خضوع للتحكيم (اتفاق بين أطراف النزاع للالتزام بقرار المحكم) / اتفاق تحكيم (وثيقة قانونية تلخص اتفاقاً بين أطراف في نزاع للالتزام بقرار محكم)",
 "にんじゅつ": "نِينْجُوتْسُو",
 "にんじょう": "بَشَرِيَّة, إِنْسَانِيَّة / إِنْسَانِيَّة, بَشَرِيَّة / طبيعة بشرية (السمات النفسية المشتركة للبشرية التي يفترض أنها مشتركة بين جميع البشر)\nمثال: مراقب عظيم للطبيعة البشرية / سَفْك الدَّم, إِرَاقَةُ الدَّم (أَسَاءَ، سَكَبَ الدم أو السائل؛ سَفَكَ الدم: أراقه وأهدره) / سَفَكَ الدَّمَ (أَسَاءَ، سَكَبَ الدم أو السائل؛ سَفَكَ الدم: أراقه وأهدره)",
 "にんじょうざた": "سَفْك الدَّم, إِرَاقَةُ الدَّم (أَسَاءَ، سَكَبَ الدم أو السائل؛ سَفَكَ الدم: أراقه وأهدره) / سَفَكَ الدَّمَ (أَسَاءَ، سَكَبَ الدم أو السائل؛ سَفَكَ الدم: أراقه وأهدره)",
 "にんじょうみ": "إِحْسَان",
 "にんじる": "رَشَّحَ, عَيَّنَ (اقتَرَح شخصًا أو جهةً ليكون مرشَّحًا لمنصب أو مهمة؛ جعَل شيئًا يرشُح أو يُصفّى) / اِفْتَرَضَ",
 "にんじん": "جَزَر, جزر (جَزَرَ الماءُ عن الأَرضِ يَجْزُرُ جَزْراً: نَضَبَ وحَسَرَ؛ ويقال: جَزَرَ البَحْرُ والنَّهْرُ: انْحسرَ ماؤُهُ)\nمثال: ضع الجزر في القدر.",
 "にんずる": "رَشَّحَ, عَيَّنَ (اقتَرَح شخصًا أو جهةً ليكون مرشَّحًا لمنصب أو مهمة؛ جعَل شيئًا يرشُح أو يُصفّى) / اِفْتَرَضَ",
 "にんせい": "خُصُوبَة",
 "にんそう": "بَدَا (ظَهَرَ) / نَظْرَة, شوفة / مَرْأىً, مَرْآة\nمثال: بدا سامي مريضا. / سحنة, محيا (الوجه البشري)",
 "にんそううらない": "سحنة, محيا (الوجه البشري)",
 "にんそうがく": "سحنة, محيا (الوجه البشري)",
 "にんそく": "كولي ((إهانة عرقية) اسم مسيء لعامل آسيوي غير ماهر)",
 "にんたい": "تحمل, جلد (القدرة على تحمل المشقة أو التوتر) / بقاء, نجاة (حالة البقاء على قيد الحياة)\nمثال: يختبر الماراثون قدرة تحمل العداء",
 "にんたいしん": "تحمل, جلد (القدرة على تحمل المشقة أو التوتر) / بقاء, نجاة (حالة البقاء على قيد الحياة)\nمثال: يختبر الماراثون قدرة تحمل العداء",
 "にんたいづよい": "دَؤُوب, مُثَابِر (يُوَاظِبُ بِهُدُوءٍ وَثَبَاتٍ خَاصَّةً فِي التَّفَاصِيلِ وَالدِّقَّة)",
 "にんたいりょく": "ثبات, جلد (قوة العقل التي تمكن المرء من تحمل المحن بشجاعة)",
 "にんち": "إِقْرَار, اعْتِرَاف (بيان يقر بشيء أو بشخص ما) / إقرار, اعتراف (حالة أو صفة كونه معترفاً به أو مقدراً)\nمثال: لا بد أنها رأته لكنها لم تبد أي علامة إقرار بذلك",
 "にんちかがく": "علم الإدراك, علوم إدراكية (ميدان العلم المعني بالإدراك؛ يشمل أجزاء من علم النفس المعرفي واللسانيات وعلوم الحاسوب وعلم الأعصاب المعرفي وفلسفة العقل)",
 "にんちくしょう": "الْأَلَدُّ الْخَصِم / مَهْوُوْس",
 "にんちしょう": "خَرَف ((خَرُفَ) الرجل خرفا وخرافة: خرف)",
 "にんちしんりがく": "علم النفس المعرفي (نهج في علم النفس يؤكد على العمليات العقلية الداخلية)",
 "にんちてきふきょうわ": "تَنَافُر مَعْرِفِيّ, اِنْفِصَام مَعْرِفِيّ",
 "にんちど": "رُؤْيَة",
 "にんちゅう": "نَثْرَة",
 "にんてい": "بَدَا (ظَهَرَ) / نَظْرَة, شوفة / مَرْأىً, مَرْآة\nمثال: بدا سامي مريضا. / إذن, تفيوض (فعل منح الشرعية أو الإقرار أو التفويض الرسمي) / تفويض, سلطة (إذن رسمي أو موافقة) / تفويض, سلطة (القوة أو الحق في إصدار الأوامر أو اتخاذ القرارات) / تفويض, توكيل (وثيقة تعطي تعليمات أو أمراً رسمياً)\nمثال: تم تجديد التفويض للبرنامج عدة مرات",
 "にんていしょう": "شَهَادَة",
 "にんてんどう": "نينتندو",
 "にんとう": "سُكَّان / سُكَّانِيَّة",
 "にんとうぜい": "ضريبة الاقتراع (ضريبة بمبلغ ثابت لكل شخص وتدفع كشرط للحصول على حق التصويت)",
 "にんとく": "فضيلة طبيعية ((الفلسفة المدرسية) واحدة من الفضائل الأربع (الحكمة، العدالة، الشجاعة، الاعتدال) المستمدة من الطبيعة)",
 "にんどう": "بَشَرِيَّة, إِنْسَانِيَّة / إِنْسَانِيَّة, بَشَرِيَّة / رَصِيف / طَوَار / طُوَار",
 "にんにく": "ثُوم, ثُومَة / حِلْم (رأى في نومه)\nمثال: هذا الحلم سيتحقق. / ثُوم, ثُومَة",
 "にんにん": "اَلْجَمِيع, كُلّ شَخْص",
 "にんのう": "قَيْصَر, إِمْبْرَاطُور",
 "にんぴにん": "الْأَلَدُّ الْخَصِم / مَهْوُوْس",
 "にんぷ": "عَامِل, عَامِلَة (الذي يَعْمَل أو الذي عَمِلَ؛ هو الذي وَلاه السُلْطَان على أمر من أمور الدولة. الجمع عمَال)\nمثال: توم عامل نفايات.",
 "にんべつあらため": "تَعْدَاد اَلسُّكَّان, إِحْصَاء اَلسُّكَّان",
 "にんむ": "وَاجِب, وَظِيفَة (اسم لما يُوجَبُ فعله؛ اسم لما صار حدوثه أكيد) / رَسْم (سَم الشَّيءَ :خطّه رسَم مُربَّعًا/ صورةً/ شكلاً؛ رسَم : كَتَبَ)\nمثال: لا شكر على واجب.",
 "にんむぶたい": "فريق عمل عسكري, قوة واجب (وحدة عسكرية مؤقتة تُشكل لتحقيق هدف معين) / فريق عمل, مجموعة عمل (وحدة شبه دائمة تم إنشاؤها لتنفيذ مهمة مستمرة)",
 "にんめい": "مَوْعِد, مِيعَاد (مَوْعِد الإفطار،أي وقت الإفطار؛ لديه مَوْعِد مع صديق)\nمثال: مناد عنده موعد.",
 "にんめいしき": "تنصيب, تولية (العمل الرسمي المتمثل في إلباس شخص ما شارة منصب؛ الترقية الرسمية لشخص إلى منصب أو رتبة) / تتويج, تنصيب (مراسم تنصيب ملك جديد)",
 "にんよう": "مَوْعِد, مِيعَاد (مَوْعِد الإفطار،أي وقت الإفطار؛ لديه مَوْعِد مع صديق)\nمثال: مناد عنده موعد. / إِقْرَار, اعْتِرَاف (بيان يقر بشيء أو بشخص ما) / إقرار, اعتراف (حالة أو صفة كونه معترفاً به أو مقدراً)\nمثال: لا بد أنها رأته لكنها لم تبد أي علامة إقرار بذلك / حَمْل (رَفَعَ، أَقَلَّ)\nمثال: حمل سامي سلاحه.",
 "にんようせい": "خُصُوبَة",
 "にんようのう": "خُصُوبَة",
 "にクロムさん": "حمض ثنائي الكروميك (أصبح حامضًا، تغير الطعم إلى الحموضة؛ ارتفعت نسبة الحموضة في شيء ما، كما في الطعام أو السوائل)\nمثال: رمى ياني الحمض على وجه سكورة.",
 "にクロムさんカリウム": "ثاني كرومات البوتاسيوم (ملح برتقالي محمر يستخدم في صنع الأصباغ وفي التصوير الفوتوغرافي)",
 "にクロムさんナトリウム": "ثنائي كرومات الصوديوم (ملح برتقالي محمر يستخدم كمثبت للون)",
 "にルートか": "تكرار زائد, حشو (تكرار فعل ما بلا حاجة) / زيادة, فائض (سمة كون الشيء زائداً وغير مطلوب) / تكرار احتياطي ((إلكترونيات) تصميم نظام يكرر المكونات لتوفير بدائل في حالة فشل أحد المكونات) / تكرار زائد, حشو (تكرار الرسائل لتقليل احتمالية الأخطاء في الإرسال)\nمثال: خلق استخدام الروبوتات الصناعية فائضاً في العمالة",
 "にーに": "اَلْأَخ اَلْأَكْبَر",
 "にーにー": "اَلْأَخ اَلْأَكْبَر",
 "に亘って": "طَوَال",
 "に亘り": "طَوَال",
 "に付き": "بِسَبَب, بِحُكْم / حَوْلَ (جَعَلَ الشيءَ غير ما كان؛ نقل الشيء من موضع إلى آخر) / عَلَى وَشَكِ (يفيد الاستعلاء؛ يفيد التعليل) / عَن (يُفِيدُ المُجَاوَزَة؛ يُفِيدُ الاستعلاء، عَلَى) / حَوَالِي\nمثال: رقصنا حول النار. / لِكُلّ / فِي كُلّ (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة) / بِنَاءً عَلَى, لِأَجْل (ضد هَدْم. ؛ المَبْنَى أو البِنَاية)\nمثال: جون في عمر أخي.",
 "に付け": "كُلَّمَا / إِذَا مَا, إِذَا",
 "に付けて": "كُلَّمَا / إِذَا مَا, إِذَا",
 "に伴い": "تَضَامُنًا مَعَ",
 "に伴って": "كَـ, مِثْل / مِثْل, كَـ (الشَبَه؛ النَظِير)\nمثال: قصدته مثل نكتة.",
 "に似て": "حَبَّ (الزرع، كبيرا كان أم صغيرا؛ بَذْرُ الزرع) / أَحَبَّ (مَالَ إلى الشيء أو الشخص، وَدَّه؛ للزَّرع: بَدا حَبُّه) / اِسْتَمْطَعَ / أَعْجَبَ (سُرَّ بالشيءِ) / مِثْل (الشَبَه؛ النَظِير) / مِثْل, شِبْه (الشَبَه؛ النَظِير) / مِثْل, كَـ (الشَبَه؛ النَظِير)\nمثال: زيري بحب المال.",
 "に依らず": "بِغَضِّ ٱلنَّظَر عَن, دُونَ الاِهْتِمَام بِـ (البُغْض ضدّ الحبّ ، بغَض جَدُّك:كتعس جدّك،ونعِمَ الله بك عيناً وبغَض بعدوّك عيناً؛ بغَضَ فلانٌ الشّيءَ أو الشّخصَ:كَرِهَه ومَقَتَه وأعرض عنه)\nمثال: سأذهب بغض النظر عن مجيئه.",
 "に依る": "بِوَاسِطَة",
 "に備えて": "فِي حَال (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "に加え": "إِضَافَةً عَلى ذٰلِكَ\nمثال: パソコンに加え、携帯電話での利用が可能です。 — علاوة على الحاسب يمكن استخدامه أيضاً على الهاتف المحمول.",
 "に加えて": "إِضَافَةً عَلى ذٰلِكَ",
 "に反して": "ضد / ضِدّ",
 "に取って": "أَنّ (يفيد التوكيد) / إِلَى, عَلَى (حرف جر يُفيد الغاية الزمنية؛ حرف جر يُفيد الغاية المكانية)\nمثال: كيف لي أن أعرف؟",
 "に取りまして": "أَنّ (يفيد التوكيد) / إِلَى, عَلَى (حرف جر يُفيد الغاية الزمنية؛ حرف جر يُفيد الغاية المكانية)\nمثال: كيف لي أن أعرف؟",
 "に向けて": "نَحْوَ, صَوْبَ / نَحُو / لِأَجْل / بِقُرْب",
 "に因る": "بِوَاسِطَة",
 "に対し": "نَحْوَ, صَوْبَ / نَحُو / لِأَجْل / بِقُرْب",
 "に対して": "نَحْوَ, صَوْبَ / نَحُو / لِأَجْل / بِقُرْب",
 "に対する": "بِالنِّسْبَة لِـ, بِالنِّسْبَة إِلَى",
 "に對して": "نَحْوَ, صَوْبَ / نَحُو / لِأَجْل / بِقُرْب",
 "に對する": "بِالنِّسْبَة لِـ, بِالنِّسْبَة إِلَى",
 "に当たっては": "فِي مَا يَتَعَلَق بِـ (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "に影響されて": "فِي أَعْقَاب, عَلَى أَثَرِ (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة) / عَلَى إِثْرِ (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: جون في عمر أخي.",
 "に従い": "وَفْقًا لِ",
 "に従って": "وَفْقًا لِ",
 "に拠る": "بِوَاسِطَة",
 "に文字": "ثُوم, ثُومَة",
 "に沿って": "عَلَى طُول (يفيد الاستعلاء؛ يفيد التعليل) / بِالتَّوَازِي مَعَ\nمثال: أجب على السؤال.",
 "に渡って": "طَوَال",
 "に渡り": "طَوَال",
 "に準じて": "وَفْقًا لِ / طِبْقًا لِـ, وَفْقًا لِـ / بِالنِّسْبَة لِـ",
 "に照らして": "طِبْقًا لِـ, وَفْقًا لِـ / بِالنِّسْبَة لِـ",
 "に照らすと": "طِبْقًا لِـ, وَفْقًا لِـ / بِالنِّسْبَة لِـ",
 "に至っては": "أَمَّا ؛ فَـ (حَرْفُ اِسْتِفْتَاحٍ، وَيَكْثُرُ اِسْتِعْمَالُهُ قَبْلَ القَسَمِ)\nمثال: أما زلت تذكرني؟",
 "に連れ": "كَـ, مِثْل / مِثْل, كَـ (الشَبَه؛ النَظِير)\nمثال: قصدته مثل نكتة.",
 "に連れて": "كَـ, مِثْل / مِثْل, كَـ (الشَبَه؛ النَظِير)\nمثال: قصدته مثل نكتة.",
 "に過ぎない": "عَدْل (عَدْل) / فَقَط (لا أكثر، لا غير)\nمثال: هل يعاملون بالعدل",
 "に関し": "ذو صلة, متعلق بـ (متصل منطقياً أو سببياً أو بخصائص مشتركة)\nمثال: الرسم والفنون ذات الصلة",
 "に限って": "بشكل خاص, تحديداً (بدرجة أكبر بوضوح مما هو شائع) / بِتَمَيُّز, بِشَكْل خَاصّ (بشكل فريد أو مميز) / تَحْدِيدًا, عَلَى وَجْه الخُصُوص (مميز بشكل خاص عن الآخرين)\nمثال: كان دقيقاً بشكل خاص حول التهجئة",
 "に際して": "مَتَى / إمتى / متى / امتى / فوقتاش / حِينَمَا, عِنْدَمَا",
 "ぬ": "لَا, مَا (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها) / مثال: لا أحب المدرسة. / اِسْتَلْقَى (وَضَعَ ظَهْرَهُ عَلَى سَطْحٍ كَالسَّرِيرِ والأَرْضِ للنوم أو الاستراحة) / اِضْطَجَعَ\nمثال: استلقى على السرير.",
 "ぬい": "تَطْرِيز",
 "ぬいあげ": "سيف ذو حدين (سيف مستقيم بنصل ضيق وحدين) / ثنية مخيطة (طية ضيقة مسطحة مثبتة بالخياطة) / انثناء, تكور ((في الرياضة) وضعية جسدية تُتخذ في بعض الرياضات (مثل الغوص أو التزلج) حيث يتم ثني الركبتين وسحب الفخذين بالقرب من الصدر) / تسالي, حلويات (مأكولات (خاصة الحلويات))",
 "ぬいいと": "خيط جراحي, قطبة (خيط من الأمعاء أو الحرير أو السلك يستخدمه الجراحون لخياطة الأنسجة معاً) / غرزة, قطبة جراحية (درزة أو وصلة تستخدم في الجراحة) / درز (مفصل غير متحرك (خاصة بين عظام الجمجمة))",
 "ぬいかた": "بَالُوعَة / خَيَّاط",
 "ぬいこみ": "سيف ذو حدين (سيف مستقيم بنصل ضيق وحدين) / ثنية مخيطة (طية ضيقة مسطحة مثبتة بالخياطة) / انثناء, تكور ((في الرياضة) وضعية جسدية تُتخذ في بعض الرياضات (مثل الغوص أو التزلج) حيث يتم ثني الركبتين وسحب الفخذين بالقرب من الصدر) / تسالي, حلويات (مأكولات (خاصة الحلويات))",
 "ぬいとり": "تَطْرِيز",
 "ぬいなおす": "إعادة إنتاج, نسخة جديدة (إبداع تم إنشاؤه مرة أخرى أو من جديد)\nمثال: إنه إعادة إنتاج لفيلم قديم",
 "ぬいはり": "يعسوب (حشرة نحيلة الجسم غير لاسعة ذات أجنحة قزحية الألوان تكون مفرودة عند الراحة؛ تتغذى البالغات والحوريات على البعوض وما إلى ذلك) / إبرة خياطة (إبرة تستخدم في الخياطة لسحب الخيط عبر القماش)",
 "ぬいばり": "يعسوب (حشرة نحيلة الجسم غير لاسعة ذات أجنحة قزحية الألوان تكون مفرودة عند الراحة؛ تتغذى البالغات والحوريات على البعوض وما إلى ذلك) / إبرة خياطة (إبرة تستخدم في الخياطة لسحب الخيط عبر القماش)",
 "ぬいめ": "دَرْز (درز:درزا تمكن من درز الدُّنْيَا؛ دَرِزَ الرجلُ، كفَرِح، وَكَذَلِكَ ذَرِزَ، بالدّالِ والذّالِ، إِذا تمَكَّن مِنْهَا أَي من نَعيمِها)",
 "ぬいもの": "خِيَاطَة, حِيَاكَة",
 "ぬう": "خَاطَ (خَطَّ، خَيطَ في إبرة أو آلة؛ وَصَلَ أو أَصَّلَ أجزاء معًا باستخدام الخيط) / خَيَّطَ ((خَيَّطَ) الشَّيْبُ في رأسِهِ تَخْييطًا: بَدَا، أو صارَ كالخُيُوطِ فَتَخَيَّطَ رأسُهُ بالشَّيْبِ؛ (خَيَّطَ) الثَّوْب: خاطه)\nمثال: خاط سامي جيبه المثقوب.",
 "ぬうっと": "فَجْأَةً / بشكل مثير للإعجاب, بشكل مهيب (بطريقة مثيرة للإعجاب)\nمثال: تقدم الطلاب بسرعة مثيرة للإعجاب",
 "ぬえ": "لُغْز, غَامِضَة (قالَ كلامًا خفيًا أو غير واضح، أو استخدم التورية والإشارة؛ عبّرَ عن شيء بطريقة رمزية أو غير مباشرة)\nمثال: لم يحل أبدا لغز وفاتها.",
 "ぬえてき": "غَامِض",
 "ぬかあめ": "رَذَّ, بَغَشَ (رذ - يرذ ، رذاذا؛ رذت السماء : أمطرت الرذاذ) / تبول / رَذَاذ, بَغْشَة",
 "ぬかか": "هاموش (حشرة دقيقة ذات جناحين تمتص دماء الثدييات والطيور والحشرات الأخرى)",
 "ぬかがみ": "نَاصِيَة (خصلة من شعر عرف الحصان تنمو للأمام بين الأذنين) / خُصْلَة أَمَامِيَّة, نَاصِيَة (خصلة شعر تنمو (أو تتدلى) فوق الجبهة)",
 "ぬかご": "هاموش (حشرة دقيقة ذات جناحين تمتص دماء الثدييات والطيور والحشرات الأخرى)",
 "ぬかす": "إغفال, حذف (خطأ ناتج عن الإهمال) / قفز خفيف, وثب (مشية تتبادل فيها الخطوات والقفزات) / سَبَقَ (سَبَقَهُ إِلَى الشيءِ يَسْبِقَهُ سَبْقًا: تقدَّمَهُ؛ يقال سَبَقَ الفرسُ في الحَلْبةِ: جاءَ قبل الأَفراسِ)\nمثال: سبق و رأيت ذلك. / قَالَ, قال (نَطَقَ بالكلام) / يَتْلُو / قَالَ, يَقُول (نَطَقَ بالكلام)\nمثال: قال زيري وداعا.",
 "ぬかずき": "حرنكش, كرز أرضي",
 "ぬかずきむし": "خنفساء مطقطقة (قادرة على تعديل وضعها عندما تكون على ظهرها عن طريق القفز في الهواء مع صوت طقطقة)",
 "ぬかずく": "سَجَدَ, تَمَلَّقَ (وَضَعَ جَبْهَتَهُ عَلَى ٱلْأَرْضِ)\nمثال: سجد دان نفسه في فندق طريق محلي.",
 "ぬかつきむし": "خنفساء مطقطقة (قادرة على تعديل وضعها عندما تكون على ظهرها عن طريق القفز في الهواء مع صوت طقطقة)",
 "ぬかつく": "سَجَدَ, تَمَلَّقَ (وَضَعَ جَبْهَتَهُ عَلَى ٱلْأَرْضِ)\nمثال: سجد دان نفسه في فندق طريق محلي.",
 "ぬかづく": "سَجَدَ, تَمَلَّقَ (وَضَعَ جَبْهَتَهُ عَلَى ٱلْأَرْضِ)\nمثال: سجد دان نفسه في فندق طريق محلي.",
 "ぬかにくぎ": "هدر الجهد (جهد لا طائل منه)",
 "ぬかに釘": "هدر الجهد (جهد لا طائل منه)",
 "ぬかばえ": "هاموش (حشرة دقيقة ذات جناحين تمتص دماء الثدييات والطيور والحشرات الأخرى) / نطاط النبات (قريب من نطاطات الأوراق وحشرات البصاق ولكنه نادراً ما يضر بالنباتات المزروعة)",
 "ぬかよろこび": "سَرِيع الزَّوَال, عَابِر (لا يدوم إلّا وقتًا قصيرًا جدًّا)",
 "ぬかり": "خطأ فادح, زلة (خطأ محرج)",
 "ぬかる": "أَخْطَأَ ((أخْطَأَ): خَطِئَ؛ (أخْطَأَ) غَلِظَ (حاد عن الصواب))\nمثال: اعترف أنه أخطأ.",
 "ぬか喜び": "سَرِيع الزَّوَال, عَابِر (لا يدوم إلّا وقتًا قصيرًا جدًّا)",
 "ぬか雨": "رَذَّ, بَغَشَ (رذ - يرذ ، رذاذا؛ رذت السماء : أمطرت الرذاذ) / تبول / رَذَاذ, بَغْشَة",
 "ぬがす": "خَلَعَ (نَزَعَ، أَزَالَ إلا أنَّ في الخَلْعِ مُهْلَةً (لسان العرب)؛ عَزَلَ) / أَقْلَعَ / اِزْدَهَرَ\nمثال: خلع سامي حذاءه.",
 "ぬき": "لُحْمَة (هو اللَحْم، واللحمة أخصُّ من اللحم؛ قطعة من اللحم) / عارضة, قطعة عرضية (دعامة مستعرضة) / جائز مستعرض, عارضة مستعرضة (عارضة أفقية تمتد عبر شيء ما)",
 "ぬきあしで": "بتسلل, خلسة (بطريقة خفية)\nمثال: تقدموا خلسة عكس التيار",
 "ぬきいた": "مَنْحُوتٌ بِخُشُونَة ((عَنِ الحَجَرِ أَوِ الخَشَبِ) مُشَكَّلٌ بِشَكْلٍ خَشِنٍ دُونَ تَشْطِيبٍ) / بَذِيءٌ, سُوقِيّ (يفتقر إلى الرقي أو الثقافة أو الذوق) / فَسْقِيَّة, فِسْقِيَّة",
 "ぬきいと": "لُحْمَة (هو اللَحْم، واللحمة أخصُّ من اللحم؛ قطعة من اللحم)",
 "ぬきうちけんさ": "تفتيش عشوائي, فحص مفاجئ (فحص لأداء العمل أو جودة المنتج يتم في أوقات عشوائية دون سابق إنذار)\nمثال: تضمن الفحوصات المفاجئة مستوى عالياً من الأداء من قبل الموظفين",
 "ぬきうちちょうさ": "تفتيش عشوائي, فحص مفاجئ (فحص لأداء العمل أو جودة المنتج يتم في أوقات عشوائية دون سابق إنذار)\nمثال: تضمن الفحوصات المفاجئة مستوى عالياً من الأداء من قبل الموظفين",
 "ぬきがき": "مُقْتَطَف / خلاصة",
 "ぬきがた": "أداة قطع, قاطعة (أداة للقطع) / قارب قاطع, كتر (سفينة شراعية بصارية واحدة مثبتة في الخلف أكثر من صارية السلوب) / قارب توصيل, قارب خدمات (قارب للتواصل بين السفينة والشاطئ) / قاطع, قصاص (شخص عمله القص (مثل قص القماش للملابس))",
 "ぬきがたい": "رَاسِخ, عَمِيق الجُذُور ((يستخدم خاصة للأفكار أو المبادئ) عميق الجذور؛ ثابت ومتمكّن بقوّة)",
 "ぬきさし": "أَدَارَ (دَارَ نصف دورة فقط؛ الشيء: جعله يدور؛ فعل تعدّي من دَارَ)\nمثال: أدار فاضل مقبض الباب بهدوء و دخل إلى المنزل.",
 "ぬきさしならぬ": "دَبِق, صَمْغِيّ (له خصائص اللصق اللزجة كالمواد اللاصقة) / لَاصِق, لَزِق (مُغطّى بمادّة لاصقة) / حَرِج, مُحْرِج (صَعْب التَّعَامُل مَعَهُ؛ يُسَبِّب أَلَمًا أَوْ إِحْرَاجًا) / حَارّ وَرَطْب, خَانِق (حارّ أو دافئ ورطب بشكل مزعج)",
 "ぬきさる": "مَرَّرَ, مَرَّ / اِحْتَازَ (بنفس معنى حَازَ، إلا أن احتاز تميل إلى أن الفاعل أراد الحوز) / اِنْقَضَى, مَرَّ / أَهمَلَ / تَغَاضَى / تَخَلَّى / طَريق (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من ٱلشَّارِعِ، سَبِيل) / جَوَاز\nمثال: أسأل عن الطريق. / عَزَلَ (فَصَلَ، فرَز، أَبْعَدَ؛ أَبْعَدَ، نَحَّى)\nمثال: جو بايدن طالب الكونغرس بعزل ترامب.",
 "ぬきしろ": "مُسْوَدَّة / تَجْنِيد / سَوَّدَ / جَنَّدَ (جَنَّدَ الجنودَ: جَمَعَهَا؛ جَنَّدَ فلانًا: صيَّره جنديّاً)",
 "ぬきずり": "طبعة منفصلة, مُستَلّة (مقال مطبوع بشكل منفصل ظهر أصلاً في منشور أكبر)",
 "ぬきだす": "اِخْتَارَ / مُقْتَطَف / خلاصة",
 "ぬきでる": "فَاقَ, تَجَاوَزَ",
 "ぬきとおす": "ثَقَبَ (فَجَّرَ أو خَرَقَ شيئًا بفتح فيه؛ نَفَذَ أو مرَّ عبر شيء)\nمثال: انه ثقب الاسود. / شَغَّلَ, نَفَّذَ ((شَغَلَ) الدارَ يَشْغَلَ شَغْلًا: سكنها؛ شَغَلَ فلانًا عن الشيء: لَهَّاهُ وصرَفَه)\nمثال: شغل بيل التلفاز.",
 "ぬきとる": "عَزَلَ (فَصَلَ، فرَز، أَبْعَدَ؛ أَبْعَدَ، نَحَّى)\nمثال: جو بايدن طالب الكونغرس بعزل ترامب. / أَخَذَ (تَنَاوَلَ الشيء بيده، تملكه أو تحكم فيه، بالقوة أو بدونها؛ أمْسَكَ بِالشيء. (يتعدى بالباء)) / أَخَذَ بِـ (تَنَاوَلَ الشيء بيده، تملكه أو تحكم فيه، بالقوة أو بدونها؛ أمْسَكَ بِالشيء. (يتعدى بالباء)) / اِتَّخَذَ / اِسْتَغْرَقَ / اِلْتَقَطَ\nمثال: أخذ الولد يبكي. / سَرَقَ (أخذ ما كان لغيره خفية وبدون علم أحد) / اِسْتَرَقَ\nمثال: من سرق التفاحة؟",
 "ぬきはなつ": "اِسْتَلّ, شَهَرَ",
 "ぬきほん": "نبذة – مقتطفات من",
 "ぬきんでる": "فَاقَ, تَجَاوَزَ",
 "ぬきネタ": "مِغْرَفَة",
 "ぬき出す": "اِخْتَارَ / مُقْتَطَف / خلاصة",
 "ぬぎすてる": "تخلص, رمي (التخلص من شيء يعتبر عديم الفائدة أو غير مرغوب فيه) / إلقاء الورق, طرح الورق ((في أوراق اللعب) فعل رمي بطاقة عديمة الفائدة) / شيء متروك, مُهملات (أي شيء يتم طرحه جانباً أو التخلص منه)",
 "ぬぎぬぎ": "تَعَرَّى, اِنْجَرَدَ / تَعَرَّى",
 "ぬく": "عَزَلَ (فَصَلَ، فرَز، أَبْعَدَ؛ أَبْعَدَ، نَحَّى)\nمثال: جو بايدن طالب الكونغرس بعزل ترامب. / إغفال, حذف (خطأ ناتج عن الإهمال) / قفز خفيف, وثب (مشية تتبادل فيها الخطوات والقفزات) / بَالُوعَة / اِخْتَارَ / أَحْمَق, غَبِيّ (مُغَفَّل، أَبْلَه، طَائِش)\nمثال: قبلني ايها الأحمق.",
 "ぬくい": "دَافِئ / دَفِيء",
 "ぬくとい": "دَافِئ / دَفِيء",
 "ぬくぬく": "بإحكام (بشكل ملائم تماماً (للملابس)) / بأمان (محمي بأمان) / بدفء وراحة (محمي بشكل دافئ ومريح)\nمثال: ناسقت السترة بإحكام / مُرْتَاحُ اَلْبَالِ, خَالِي اَلْقَلْبِ / بتهور, بحماقة (بطريقة متهورة وغير حكيمة)\nمثال: بطيش، ترك العمل وركض إلى المنزل لإسعاد زوجته",
 "ぬくべからざる": "رَاسِخ, عَمِيق الجُذُور ((يستخدم خاصة للأفكار أو المبادئ) عميق الجذور؛ ثابت ومتمكّن بقوّة)",
 "ぬくまる": "اِسْتَدْفَأَ / دَفَّأَ, أَدْفَأَ (دَفَّأَ الَجريحَ: أَدْفَأَهُ)",
 "ぬくみ": "دفاء",
 "ぬくめる": "دَافِئ / دَفِيء",
 "ぬくもり": "دفاء",
 "ぬぐ": "خَلَعَ (نَزَعَ، أَزَالَ إلا أنَّ في الخَلْعِ مُهْلَةً (لسان العرب)؛ عَزَلَ) / أَقْلَعَ / اِزْدَهَرَ\nمثال: خلع سامي حذاءه.",
 "ぬぐいさる": "دَسَمَ, طَلَسَ (دَسََّمَ: الدَّسَمُ، محرَّكةً: الوَدَكُ، والوَضَرُ، والدَّنَسُ)",
 "ぬぐいとる": "مَسَحَ (مَرَّ عليه بكفه وهو يلامسه؛ مَحَا، مرَّ عليه بكفه حتى يُزيله) / مَحَى, عَفَا\nمثال: مسح توم الطاولة.",
 "ぬぐい去る": "دَسَمَ, طَلَسَ (دَسََّمَ: الدَّسَمُ، محرَّكةً: الوَدَكُ، والوَضَرُ، والدَّنَسُ)",
 "ぬぐい取る": "مَسَحَ (مَرَّ عليه بكفه وهو يلامسه؛ مَحَا، مرَّ عليه بكفه حتى يُزيله) / مَحَى, عَفَا\nمثال: مسح توم الطاولة.",
 "ぬぐう": "مَسَحَ (مَرَّ عليه بكفه وهو يلامسه؛ مَحَا، مرَّ عليه بكفه حتى يُزيله)\nمثال: مسح توم الطاولة. / تَخَلَّصَ ؛ مِن",
 "ぬけ": "إِغْفَال / تَعْرِيف (الإعلام؛ الشيء أو الكلمة: التوضيح بالمعنى بصورة مختصرة ليعرف الناس ما هي)\nمثال: هل لديه بطاقة شخصية (هوية شخصية - بطاقة تعريف)",
 "ぬけあな": "فتحة الرمي, مزغل (ثقب صغير في جدار محصن؛ للمراقبة أو إطلاق الأسلحة) / ثغرة (غموض (خاصة في نص قانون أو عقد) يجعل من الممكن التهرب من صعوبة أو التزام) / حركة افتتاحية, خطوة أولى (الأولى في سلسلة من الإجراءات) / فتح (عملية فتح شيء ما) / فتح (أن يصبح الشيء مفتوحاً أو يتم فتحه) / افتتاحية, افتتاحية الشطرنج (تسلسل معترف به من النقلات في بداية لعبة الشطرنج)\nمثال: كشف شعاع الضوء عن فتحه الحذر للباب",
 "ぬけうら": "طريق جانبي, طريق فرعي (طريق جانبي قليل الاستخدام (كما في الريف))",
 "ぬけおちる": "خَرَجَ (اِنْتَقَلَ إلى خارج المكان) / غَادَرَ (تَرَكَ)\nمثال: خرج سامي ليحتفل.",
 "ぬけかわる": "سَقِيفَة",
 "ぬけがら": "قِشْرَة",
 "ぬけげ": "تسريح, تمشيط (فعل تمرير المشط خلال الشعر)\nمثال: كان شعره بحاجة إلى تمشيط",
 "ぬけさく": "مُغَفَّل, أَحْمَق",
 "ぬけだす": "انْسَلَّ, تَسَلَّلَ خارجاً (المغادرة خلسة وسراً)\nمثال: كانت المحاضرة مملة وانسل العديد من الطلاب خارجاً / اِنْدَلَعَ",
 "ぬけでる": "انْسَلَّ, تَسَلَّلَ خارجاً (المغادرة خلسة وسراً)\nمثال: كانت المحاضرة مملة وانسل العديد من الطلاب خارجاً / تَفَوَّقَ, بَزَّ / بَرَعَ (تفوق أو تميز في مجال معين أو عمل معين؛ أجاد وأتقن أداء مهمة أو عمل)",
 "ぬけに": "تَهْرِيب",
 "ぬけぬけ": "بجرأة, بوقاحة (بطريقة وقحة)\nمثال: تحدث بوقاحة / بغباء (بطريقة غبية)\nمثال: اشترى تذكرة ذهاب فقط بغباء",
 "ぬけみち": "طريق جانبي, طريق فرعي (طريق جانبي قليل الاستخدام (كما في الريف)) / فتحة الرمي, مزغل (ثقب صغير في جدار محصن؛ للمراقبة أو إطلاق الأسلحة) / ثغرة (غموض (خاصة في نص قانون أو عقد) يجعل من الممكن التهرب من صعوبة أو التزام)",
 "ぬけめ": "حماقة, سفاهة (نقص الحذر في الشؤون العملية)",
 "ぬけめがない": "حَاذِق (اسم فاعل للفعل حَذِقَ أي المَاهِرِ المُتقِنِ لعَمَلِهِ) / نَاصِح, نَبِيه\nمثال: إنها حاذقة الذكاء.",
 "ぬけめない": "حَاذِق (اسم فاعل للفعل حَذِقَ أي المَاهِرِ المُتقِنِ لعَمَلِهِ) / نَاصِح, نَبِيه\nمثال: إنها حاذقة الذكاء.",
 "ぬけめのない": "حَاذِق (اسم فاعل للفعل حَذِقَ أي المَاهِرِ المُتقِنِ لعَمَلِهِ) / نَاصِح, نَبِيه\nمثال: إنها حاذقة الذكاء.",
 "ぬけもれ": "سهو, غفلة (خطأ ناتج عن عدم الانتباه) / إشراف, رقابة (الإدارة من خلال الإشراف على أداء أو تشغيل شخص أو مجموعة) / سهو, غفلة غير مقصودة (إغفال غير مقصود ناتج عن الفشل في ملاحظة شيء ما)",
 "ぬける": "خَرَجَ (اِنْتَقَلَ إلى خارج المكان) / غَادَرَ (تَرَكَ)\nمثال: خرج سامي ليحتفل. / اختفاء, تلاشٍ (التوقف التدريجي عن الظهور) / ضربة مقوسة لليمين (ضربة غولف تنحني لليمين للاعب الغولف الأيمن)\nمثال: أخذ دروساً لعلاج ضرباته المقوسة / تَرَكَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض) / تَرَكَ, غَادَرَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض) / إِجَازَة, عُطْلَة\nمثال: لقد ترك لك هذا. / خُرُوج / مَخْرَج / خَرَجَ (اِنْتَقَلَ إلى خارج المكان)\nمثال: خرج سامي ليحتفل.",
 "ぬけ作": "مُغَفَّل, أَحْمَق",
 "ぬこ": "قِطّ (حَيْوَان مستأنس من عائلة السَنُّورِيّات، له في اللغة أسماء عديدة تذكر وتؤنث) / قِطَّة (حيوان مستأنس من فصيلة السنوريات) / هِرّ (القطّ؛ صوت الإبل أو دعائها إلى الماء) / هِرَّة (المؤنث من الْهِرّ) / سَنُّور / قطّ (حَيْوَان مستأنس من عائلة السَنُّورِيّات، له في اللغة أسماء عديدة تذكر وتؤنث)\nمثال: أعطنا هذا القط.",
 "ぬし": "رَئِيس, رَئِيسَة / رَئِيس / اِتَّجَهَ / مَالِك, مَالِكَة (اسم شخصي معطًى للذكور من العرب)\nمثال: من مالك هذا البيت؟ / فَاعِل, مُبْتَدَأ (الشيء :فعله) / مَوْضُوع / دَوْرَة, مَادَّة (في غرب العراق على نهر الفرات قرب الحدود السورية؛ حَيّ في جنوب بغداد تقع فيه محطة تكرير للنفط تسمّى بإسمه) / رَعِيَّة\nمثال: تظن الشرطة أن سامي يعلم من الفاعل. / الروح الحارسة, الملاك الحارس (ملاك يُعتقد أن لديه عاطفة خاصة تجاه فرد معين)",
 "ぬすっと": "لِصّ, لِصَّة",
 "ぬすっとたけだけしい": "صَفِيق, وَقِح (لا يتقيّد بالأعراف أو اللياقة؛ جريء بشكل فظّ)",
 "ぬすっとねこ": "زَانٍ (زان - يزين، زينا؛ زانه: حلاه، حسنه) / الزَّانِي / زَانِيَة (اسم فاعلة من زَنَى، المرأة التي تمارس الجنس مع غير زوجها أو بدون زواج)",
 "ぬすと": "لِصّ, لِصَّة",
 "ぬすとたけだけしい": "صَفِيق, وَقِح (لا يتقيّد بالأعراف أو اللياقة؛ جريء بشكل فظّ)",
 "ぬすびと": "لِصّ, لِصَّة",
 "ぬすびとたけだけしい": "صَفِيق, وَقِح (لا يتقيّد بالأعراف أو اللياقة؛ جريء بشكل فظّ)",
 "ぬすびとねこ": "زَانٍ (زان - يزين، زينا؛ زانه: حلاه، حسنه) / الزَّانِي / زَانِيَة (اسم فاعلة من زَنَى، المرأة التي تمارس الجنس مع غير زوجها أو بدون زواج)",
 "ぬすみ": "سرقة, لصوصية (فعل أخذ شيء من شخص ما بشكل غير قانوني) / تسلل, خلسة (تجنب الكشف عن طريق التحرك بحذر)\nمثال: اللصوصية فظيعة في مطار كينيدي الدولي",
 "ぬすみぎき": "تَنَصُّت, اِسْتِرَاق سَمْع / تَنَصُّت",
 "ぬすみだす": "سَرَقَ (أخذ ما كان لغيره خفية وبدون علم أحد) / اِسْتَرَقَ\nمثال: من سرق التفاحة؟",
 "ぬすみとる": "سَرَقَ (أخذ ما كان لغيره خفية وبدون علم أحد) / اِسْتَرَقَ\nمثال: من سرق التفاحة؟",
 "ぬすみわらい": "إِهْلَاس",
 "ぬすむ": "سَرَقَ (أخذ ما كان لغيره خفية وبدون علم أحد) / اِسْتَرَقَ\nمثال: من سرق التفاحة؟ / اِنْتَحَلَ",
 "ぬたくる": "خربشة, شخبطة (كتابة يدوية رديئة)",
 "ぬたば": "حمام طين (حمام في الطين الدافئ (لعلاج الروماتيزم مثلاً))",
 "ぬた場": "حمام طين (حمام في الطين الدافئ (لعلاج الروماتيزم مثلاً))",
 "ぬっこ": "قِطّ (حَيْوَان مستأنس من عائلة السَنُّورِيّات، له في اللغة أسماء عديدة تذكر وتؤنث) / قِطَّة (حيوان مستأنس من فصيلة السنوريات) / هِرّ (القطّ؛ صوت الإبل أو دعائها إلى الماء) / هِرَّة (المؤنث من الْهِرّ) / سَنُّور / قطّ (حَيْوَان مستأنس من عائلة السَنُّورِيّات، له في اللغة أسماء عديدة تذكر وتؤنث)\nمثال: أعطنا هذا القط.",
 "ぬっと": "فَجْأَةً / بشكل مثير للإعجاب, بشكل مهيب (بطريقة مثيرة للإعجاب)\nمثال: تقدم الطلاب بسرعة مثيرة للإعجاب",
 "ぬっぺらぼう": "سَاكِن, مُسْتَقِرّ (لا يُظهر تغيّرًا يُذكر إن وُجد) / ثَابِت, مُطَّرِد (يَلْتَزِمُ بِالمَبَادِئِ أَوِ المَسَارِ ذَاتِهِ عَبْرَ الزَّمَنِ)",
 "ぬっぽり": "مُسَطَّح / بلا خجل, بوقاحة (بدون خجل)\nمثال: تخلى بلا خجل عن المشروع / بذهول, بشرود (بطريقة شاردة الذهن أو مشغولة البال)\nمثال: قرأ الرسالة بشرود / مُغَفَّل, أَحْمَق",
 "ぬて": "ثنائي, دويتو (تأليف موسيقي لمؤديين اثنين) / ثنائي, زوجان (زوج من الأشخاص يرتبطون ببعضهم البعض) / ثنائي (اثنان من المؤدين أو المغنين يؤدون معاً) / ثُنَائِيّ, زَوْج (عنصران من نفس النوع)\nمثال: الخطيبان",
 "ぬの": "قُمَاش, أقمشة (النسيج الذي لم يُقَصّ أو يُخَاط) / مِمْسَحَة\nمثال: الورق و القماش يمتصان الماء.",
 "ぬのきれ": "قطعة قماش, قطعة مادة (جزء منفصل يتكون من القماش)",
 "ぬのぎれ": "قطعة قماش, قطعة مادة (جزء منفصل يتكون من القماش)",
 "ぬのじ": "قُمَاش, نَسِيج (النسيج الذي لم يُقَصّ أو يُخَاط)\nمثال: الورق و القماش يمتصان الماء.",
 "ぬのめ": "مَلْمَس",
 "ぬばたま": "حَالِك, دَامِس (شَدِيد الظُّلْمَة لِأَقْصَى دَرَجَة)",
 "ぬひ": "عَبْد (خلاف الحُرّ، المَمْلُوْك، من له مالك يملكه. الجمع عبيد وأعبد وعِبدان وعُبدان؛ الإنسان حرا كان أم لا مؤمنا كان أن ملحدا من حيث أنه مملوك لله) / أَمَة (المرأة المملوكة، خلاف الحرة)\nمثال: ماذا أنجز عبد العزيز بوتفليقة؟",
 "ぬぼく": "خادم رجل (خادم من الرجال)",
 "ぬま": "نَعْصَة, مُسْتَنْقَع / هَوَس / أبله, متخلف عقلياً (شخص ذو ذكاء دون الطبيعي)",
 "ぬまがえる": "ضفدع الجدجد (أي من ضفدعين لهما نداء نقر)",
 "ぬますぎ": "سرو المستنقعات (خشب صنوبر متساقط الأوراق من جنس التاكسوديوم، موطنه أمريكا الشمالية) / سرو البرك / سرو أصلع, سرو المستنقعات (خشب سرو شائع في جنوب شرق الولايات المتحدة له جذع موسع عند القاعدة؛ يوجد في المستنقعات الساحلية وقيعان الأنهار الفيضية) / سرو أصلع, سرو المستنقعات (سرو شائع في جنوب شرق الولايات المتحدة له جذع متوسع عند القاعدة؛ يوجد في المستنقعات الساحلية وقيعان الأنهار الفيضية)",
 "ぬまち": "مستنقع عشبي, هور (أرض رطبة منخفضة ذات غطاء نباتي عشبي؛ عادة ما تكون منطقة انتقالية بين اليابسة والماء)\nمثال: آلاف الأفدنة من المستنقعات",
 "ぬめっと": "بَرَّاق, لَمَّاع (يَعْكِس الضَّوْء)",
 "ぬめぬめ": "حَقِير, دَنِيء (مستنكَر أخلاقياً؛ يستحق الاحتقار) / لَزِج, مُغَطًّى بِالْوَحْلِ (مغطّى بمادة لزجة أو يشبهها)",
 "ぬめり": "حمأة, طين لزج (أي مادة سميكة ولزجة)",
 "ぬらす": "مُبْتَلّ / مَبْلُول, مُبْتَلّ",
 "ぬらぬら": "حَقِير, دَنِيء (مستنكَر أخلاقياً؛ يستحق الاحتقار) / لَزِج, مُغَطًّى بِالْوَحْلِ (مغطّى بمادة لزجة أو يشبهها) / بِبُطْء",
 "ぬらり": "حَقِير, دَنِيء (مستنكَر أخلاقياً؛ يستحق الاحتقار) / لَزِج, مُغَطًّى بِالْوَحْلِ (مغطّى بمادة لزجة أو يشبهها)",
 "ぬらりくらり": "باسترخاء, بكسل (بطريقة خاملة)\nمثال: هذا ما كنت أتخيل نفسي أفعله دائماً في جنوب فرنسا، الجلوس باسترخاء، وشرب القهوة، ومراقبة الناس / بتهرب, بمراوغة (مع تهرب؛ بأسلوب مراوغ)\nمثال: بدا أن زوجها يعرف الكثير من الأشخاص المذكورين، لكنه أجاب بمراوغة عندما سُئل عن هويتهم",
 "ぬり": "تطبيق, طلاء (عمل وضع شيء (على سطح)) / طبقة, طلاء (طبقة رقيقة تغطي شيئاً ما) / قماش المعاطف (قماش ثقيل مناسب للمعاطف) / تشطيب, طبقة خارجية (ملمس أو مظهر زخرفي لسطح ما (أو المادة التي تعطيه ذلك المظهر))\nمثال: وصف الطبيب وضعاً موضعياً لليود",
 "ぬりいた": "سَبُّورَة, لَوْح",
 "ぬりかえる": "دِهَان / لَوَّنَ (صفة خارجة للشيء ترى بالعين فقط ولا تلمس أو تسمع أو تشم أو يمكن تذوقها؛ كناية عن النَوع أو الشكل أو مجموعة من الصفات المختلفة في جنس واحد)\nمثال: ما هو لون شعرك؟ / اِنْكَسَرَ (فعل مطاوعة لكَسَرَ، قام أحدهم بكَسْره أو قام هو بكَسْر نفسه؛ التاجر: خَسِرَ المال ونَقَصَ عنده المال، أفْلَسَ) / كَسَرَ / اِسْتِرَاحَة (مبنى خارج المدن يتوقف فيه المسافرون للراحة والتَزَوُّد يُجمع على اِسْتِرَاحَات)\nمثال: عليك أخذ استراحة.",
 "ぬりかためる": "وَرْنِيش",
 "ぬりぐすり": "مَرْهَم, دَهُون",
 "ぬりたし": "نَزَفَ",
 "ぬりつける": "دَهَنَ (طلى الشيء بالدهن أو الزيت أو الطيب؛ ضرب بالرفق) / لَوَّثَ\nمثال: توم بدهن غرفته. / نَوْبَة",
 "ぬりつぶし": "مَلَأَ",
 "ぬりて": "ثنائي, دويتو (تأليف موسيقي لمؤديين اثنين) / ثنائي, زوجان (زوج من الأشخاص يرتبطون ببعضهم البعض) / ثنائي (اثنان من المؤدين أو المغنين يؤدون معاً) / ثُنَائِيّ, زَوْج (عنصران من نفس النوع)\nمثال: الخطيبان",
 "ぬりばけ": "فُرْشَاة الطِلَاء",
 "ぬりばん": "سَبُّورَة, لَوْح",
 "ぬりひろげる": "نَشَرَ (بَسَطَ، فَرَّقَ، نَشَرَ الشيءَ: جعله منتشراً، مثل نشر الأخبار أو نشر كتاب؛ نَشَرَ: وزع أو عمم شيئًا بين الناس، مثل نشر المقالات) / اِنْتِشَار (مصدر الفعل \"انْتَشَرَ\"؛ (في الفيزياء) عملية توزيع جزيئات أو ذرات أو حبيبات بشكل متساوٍ في فراغ أو في حيز متاح أو تخللها خلال حاجز غشائي)\nمثال: نشر توم الغسيل.",
 "ぬりむら": "تَفَاوُت, عَدَم اسْتِوَاء (صفة عدم التوازن) / تَبَايُن, تَفَاوُت (صفة كون الشيء غير مستوٍ وتنقصه الوحدة)",
 "ぬりもの": "أشغال اللك (عمل زخرفي مصنوع من الخشب ومغطى باللك وغالباً ما يكون مرصعاً بالعاج أو المعادن الثمينة)",
 "ぬる": "دِهَان / لَوَّنَ (صفة خارجة للشيء ترى بالعين فقط ولا تلمس أو تسمع أو تشم أو يمكن تذوقها؛ كناية عن النَوع أو الشكل أو مجموعة من الصفات المختلفة في جنس واحد)\nمثال: ما هو لون شعرك؟",
 "ぬるい": "فَاتِر (الفَاتِرُ : ما بينَ الحارِّ والبارِد؛ \" اُسْتُقْبِلَ اسْتِقْبَالاً فَاتِراً \": بَارِداً لاَحَرَارَةَ فِيهِ) / لَيِّن, مُتَسَاهِل (يتّسم بالتسامح والرحمة في التعامل) / لَيِّن, مُتَسَاهِل (غَيْرُ صَارِمٍ فِي تَطْبِيقِ القَوَاعِد) / لَيِّن, مُتَسَامِح (متسامح ورحيم في المعاملة)",
 "ぬるつや": "بَرَّاق, مُبْهِر (جذّاب وأنيق ظاهريًّا؛ يوحي بالثراء أو الفخامة) / بَرَّاق, لَمَّاع (يَعْكِس الضَّوْء) / مَصْقُول, مُلَمَّع ((عن الورق والقماش والجلد) ذو سطح أملس ولامع خاصة بالضغط بين الأسطوانات) / بَرَّاق, خَدَّاع (قَائِم عَلَى التَّظَاهُر؛ خَادِع المَظْهَر)",
 "ぬるぬる": "حَقِير, دَنِيء (مستنكَر أخلاقياً؛ يستحق الاحتقار) / لَزِج, مُغَطًّى بِالْوَحْلِ (مغطّى بمادة لزجة أو يشبهها) / بسلاسة (بدون مشاكل أو صعوبات) / بسلاسة, بنعومة (بطريقة سلسة ودبلوماسية)\nمثال: نفذ الخطط بسرعة وسلاسة",
 "ぬるまゆ": "مُرِيح, وَثِير / مُرْتَاح / مُرِيح",
 "ぬるま湯": "مُرِيح, وَثِير / مُرْتَاح / مُرِيح",
 "ぬるり": "حَقِير, دَنِيء (مستنكَر أخلاقياً؛ يستحق الاحتقار) / لَزِج, مُغَطًّى بِالْوَحْلِ (مغطّى بمادة لزجة أو يشبهها)",
 "ぬれ": "تبليل, ترطيب (فعل جعل الشيء مبللاً) / تبول (تعبير مخفف للتبول) / عَلَاقَة غَرَامِيَّة / عَاشِق, عَاشِقَة / مُغْرَم",
 "ぬれぎぬをきせる": "أَطَّرَ ((أَطَّرَ) الشَّيْء: أَطَرَهُ) / وَرَّطَ / لَقْطَة\nمثال: دهنت أطر النافذة بالأصفر.",
 "ぬれごと": "عَلَاقَة غَرَامِيَّة",
 "ぬれごとし": "زير نساء (رجل يحب العديد من النساء ويقيم علاقات جنسية قصيرة معهن)",
 "ぬれすけ": "رَقِيقٌ كَالغَزْل, شَفَّاف (بَالِغُ الرِّقَّةِ بِحَيْثُ يَنْفُذُ مِنْهُ الضَّوْء)",
 "ぬれぬれ": "بِتَبَلُّل, بِرُطُوبَة (بطريقة رطبة)\nمثال: كان هناك وشاح مربوط حول رأسها لكن الخصلة المتمردة هربت وتدلت برطوبة فوق عينها اليسرى / دَبِق, صَمْغِيّ (له خصائص اللصق اللزجة كالمواد اللاصقة) / لَاصِق, لَزِق (مُغطّى بمادّة لاصقة) / حَرِج, مُحْرِج (صَعْب التَّعَامُل مَعَهُ؛ يُسَبِّب أَلَمًا أَوْ إِحْرَاجًا) / حَارّ وَرَطْب, خَانِق (حارّ أو دافئ ورطب بشكل مزعج)",
 "ぬればいろ": "أبنوسي, أسود حالك (أسود داكن جداً)",
 "ね": "جَذْر, جدر (جِذْرُ ٱلشَّيْءِ هُوَ: أَصْلُهُ؛ في : جذر العدد النوني هو عدد ما إذا رفعناه لقوة ما أعطانا العدد الأصلي) / جَذْر (جِذْرُ ٱلشَّيْءِ هُوَ: أَصْلُهُ؛ في : جذر العدد النوني هو عدد ما إذا رفعناه لقوة ما أعطانا العدد الأصلي) / أَصْل (جعله أصيلًا أو ثابت الجذور؛ أي عَمَّق وأحكم أصوله؛ نسب شيئًا إلى أصله أو وضّح جذوره)\nمثال: أحسب جذر خمسة بالآلة الحاسبة. / شَعَاب / جُرَذ, فَأْر ((جَرَذَت) القرحة جرذا: تعقدت كالجُرَذِ)\nمثال: عبر جرذ الطريق. / شَمَال (الْجِهَةُ الْمُقَابِلَةُ لِلجَنُوب؛ رَأْسُ الْبَوْصَلَةِ الْمُقَابِلُ لِلجَنُوب) / شمال (الْجِهَةُ الْمُقَابِلَةُ لِلجَنُوب؛ رَأْسُ الْبَوْصَلَةِ الْمُقَابِلُ لِلجَنُوب)\nمثال: أعيش في شمال السويد. / نَامَ, رَقَدَ (الإنسان أو الحيوان: رَقَدَ وغَفَا؛ الإنسان أو الحيوان: رَقَدَ وإن لم يغفو) / نَوْم, سِنَة (بكافة معانيه) / نَوْمَة / غَمَص, رَمَص\nمثال: نام في الحافلة. / يَاه, اسمع / هَلَا / يَعْنِي / أَرْضَى, أَعْجَبَ / مِن فَضْلِك (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / رَجَاءً / لَو سَمَحْت / لُطْفًا / أَرْجُوك\nمثال: يا لها من جملة! / ثَمَن, سِعْر (ثمَّنَ السِّلْعَةَ: قدّر ثَمنَها؛ ثمَّنَ الشيءَ: جعل له ثمانية أركان) / ثَمَن (ثمَّنَ السِّلْعَةَ: قدّر ثَمنَها؛ ثمَّنَ الشيءَ: جعل له ثمانية أركان)\nمثال: دفع زيري الثمن. / قِيمَة / مَعْدُوم / لَا, مَا (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها) / مثال: لا أحب المدرسة. / سليم / صَوْت, صوت (أكثر من إحداث الصوت؛ بالغ في إحداث الصوت؛ في : صاح نوحا أو استغاثة) / صَوَّتَ, طَلَّع صوت (أكثر من إحداث الصوت؛ بالغ في إحداث الصوت؛ في : صاح نوحا أو استغاثة)\nمثال: اقرأ بصوت عالي.",
 "ねあか": "طَائِش, لَا مُبَالٍ (غير مسؤول بمرح وخِفّة)",
 "ねあがり": "ارتفاع السعر, زيادة السعر (زيادة في السعر)",
 "ねあがりえき": "أرباح رأسمالية, مكاسب رأسمالية (المبلغ الذي يتجاوز به سعر بيع الأصل سعر الشراء؛ يتحقق الربح عند بيع الأصل)",
 "ねあげ": "ارتفاع السعر, زيادة السعر (زيادة في السعر)",
 "ねあせ": "فَرْط التَّعَرُّق اللَّيْلِيّ",
 "ねい": "تملق, نفاق (ثناء مفرط أو غير صادق)",
 "ねいあく": "انحراف, شذوذ (الانحراف المتعمد عما هو خير وصواب) / عناد, مخالفة (تمرد متعمد وعنيد ومقاومة للتوجيه أو الانضباط)\nمثال: سيكون هناك دائمًا قلة من الناس يجدون متعة في التنمر والإرهاب بدافع الانحراف",
 "ねいかん": "خَؤُون, غَادِر (يَمِيل إِلَى الخِيَانَة؛ خَاصَّةً ذُو طَبِيعَة غَادِرَة) / غَدَّار, لَا يُوثَقُ بِهِ (غير مستقرّ وغير متوقَّع بشكل خطير)",
 "ねいしん": "خَائِن, خَائِنَة (الشخص الذي قام بالخِيَانَة)\nمثال: نمر مفترس أمامك خير من خائن ورائك!",
 "ねいじん": "مُتَمَلِّق, مُداهِن (شخص يستخدم الإطراء والتملق)",
 "ねいす": "أَرِيكَة, كَنَبَة (قطعة أثاث مُنَجَّدَة يُقْعَدُ عليها، مَقْعَد مُنَجَّد)\nمثال: إنها على الأريكة.",
 "ねいせい": "هَادِئ / طَمْأَنَ",
 "ねいち": "خديعة, دهاء (صفة الدهاء والمكر) / خبث, خديعة (الدهاء الذي يظهر من خلال المهارة في الخداع)",
 "ねいは": "نِينْغْبُو",
 "ねいべん": "تملق, نفاق (ثناء مفرط أو غير صادق)",
 "ねいもう": "شَرِس ((شَرَسَ) الجِلْدَ يَشْرُسُ شَرْسًا: دَلكَهُ؛ (شَرَسَ) صاحبَه: أمَضَّهُ بالقول)\nمثال: احذر من الكلب الشرس",
 "ねいる": "غَلَّبَ النُعَاس, نَامَ (قَهَرَ واِعْتَزَّ عليه واِمْتَنَع)\nمثال: その赤ちゃんは泣き疲れて寝入った。 — بكى الطفل حتى نام.",
 "ねいろ": "جرس الصوت, خامة الصوت ((موسيقى) الخاصية المميزة لصوت مركب (صوت بشري أو ضجيج أو صوت موسيقي))\nمثال: كان جرس صوت السوبرانو الخاص بها غنياً وجميلاً",
 "ねうち": "قِيمَة / تثمين, تقدير (حكم على صفات شيء أو شخص ما) / تخمين, تقدير (حساب تقريبي للكمية أو الدرجة أو القيمة) / تقدير (الاحترام الذي يحظى به شخص ما) / تثمين, تقدير (وثيقة تقدر قيمة شيء ما (مثل التأمين أو الضرائب))\nمثال: في تقديري الصبي بريء / صَفْقَة (عَقْد، اتِّفَاق؛ ضرب اليدين عند العقد)\nمثال: إنها صفقة جيدة.",
 "ねぇ": "يَاه, اسمع / هَلَا / يَعْنِي / أَرْضَى, أَعْجَبَ / مِن فَضْلِك (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / رَجَاءً / لَو سَمَحْت / لُطْفًا / أَرْجُوك\nمثال: يا لها من جملة! / مَعْدُوم / لَا, مَا (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها) / مثال: لا أحب المدرسة.",
 "ねえ": "يَاه, اسمع / هَلَا / يَعْنِي / أَرْضَى, أَعْجَبَ / مِن فَضْلِك (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / رَجَاءً / لَو سَمَحْت / لُطْفًا / أَرْجُوك\nمثال: يا لها من جملة! / الْأُخْت الْكُبْرَى, الشَّقِيقَة الْكُبْرَى / مَعْدُوم / لَا, مَا (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها) / مثال: لا أحب المدرسة.",
 "ねえさま": "الْأُخْت الْكُبْرَى, الشَّقِيقَة الْكُبْرَى",
 "ねえさん": "الْأُخْت الْكُبْرَى, الشَّقِيقَة الْكُبْرَى / آنسة, شابة (أنثى شابة)\nمثال: شابة في الثامنة عشرة من عمرها / أَخْطَأَ ((أخْطَأَ): خَطِئَ؛ (أخْطَأَ) غَلِظَ (حاد عن الصواب)) / فَاتَ / اِفْتَقَدَ, اِشْتَاقَ / آنِسَة\nمثال: اعترف أنه أخطأ. / سيدة (امرأة راقية)\nمثال: فتح السائق باب الليموزين للسيدة الكبيرة",
 "ねえちゃん": "الْأُخْت الْكُبْرَى, الشَّقِيقَة الْكُبْرَى / بِنْت / فَتَاة (شابَّة في رَيْعان الصِّبا؛ جارية حدثة) / طِفْلة / بنت / فتاة (شابَّة في رَيْعان الصِّبا؛ جارية حدثة)\nمثال: أنا أري الفتاة.",
 "ねえねえ": "يَاه, اسمع / هَلَا",
 "ねえや": "آنسة, شابة (أنثى شابة)\nمثال: شابة في الثامنة عشرة من عمرها",
 "ねおき": "وَاعٍ, يَقِظ (يتسم بالوعي الكامل والانتباه) / صحو, يقظة (حالة البقاء مستيقظاً)\nمثال: أيام الخطر وليالي اليقظة / حَيّ (ضد المَيِّت، على قيد الحَيَاة؛ جمع حَيَاء) / مَعِيشَة, مَعَاش / حَيَاة, طَرِيقَة فِي حَيَاة (الحَياة: ضد الموت والحَيُّ: ضدُّ الميّت؛ والمَحْيا مَفْعَلٌ من الحياة. تقول: مَحْيَاي ومماتي. والجمع الحَحايي)\nمثال: ينبح كلب في الحي.",
 "ねかしつける": "نَوَّمَ, أَنَامَ (بكافة معانيه)\nمثال: لم أستطع النوم.",
 "ねかた": "جَذْر, جدر (جِذْرُ ٱلشَّيْءِ هُوَ: أَصْلُهُ؛ في : جذر العدد النوني هو عدد ما إذا رفعناه لقوة ما أعطانا العدد الأصلي) / جَذْر (جِذْرُ ٱلشَّيْءِ هُوَ: أَصْلُهُ؛ في : جذر العدد النوني هو عدد ما إذا رفعناه لقوة ما أعطانا العدد الأصلي) / أَصْل (جعله أصيلًا أو ثابت الجذور؛ أي عَمَّق وأحكم أصوله؛ نسب شيئًا إلى أصله أو وضّح جذوره)\nمثال: أحسب جذر خمسة بالآلة الحاسبة.",
 "ねかぶ": "جُذْمُور, كُنَّاشَة",
 "ねから": "مطلقا, على الإطلاق",
 "ねからはから": "مطلقا, على الإطلاق",
 "ねかん": "تَابُوت (تَّابُوت: هو الصُّنْدُوق الذي توضع به الجثة؛ صندوق خشبيّ يكون مستطيل)",
 "ねがい": "رَغِبَ ((رَغُبَ) رُغْبًا، ورَغابةً: اتَّسَع وعظُم؛ يقال: (رَغُبَ) الوادي) / رَغْبَة\nمثال: يمكن لتوم البقاء إن رغب. / طَلَبَ (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى)) / طَلَب, مَسْأَلَة (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى))\nمثال: طلب زيري ورودا. / صَلَاة, دُعَاء / صَلَاة / مُصَلٍّ / تَطْبِيق / كِتَاب, اِسْتِمَارَة (موضع تعليم الكتابة. الاستخدام الأصلي؛ مدرسة شبه رسمية لتعليم الأطفال الكِتَابَة والقِرَاءَة ومباديء الحِسَاب وبعض القُرَآن…)\nمثال: هذا الكتاب جديد",
 "ねがいごと": "أُمْنِيَّة / رَغْبَة / مُنْيَة / تَمَنَّى",
 "ねがいさげ": "إلغاء (فعل الإلغاء؛ إلغاء ترتيب ما) / إبطال, إلغاء (الفعل الكلامي للإلغاء أو الفسخ أو الإبطال) / رَفَضَ (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟",
 "ねがいしょ": "تَطْبِيق / كِتَاب, اِسْتِمَارَة (موضع تعليم الكتابة. الاستخدام الأصلي؛ مدرسة شبه رسمية لتعليم الأطفال الكِتَابَة والقِرَاءَة ومباديء الحِسَاب وبعض القُرَآن…)\nمثال: هذا الكتاب جديد",
 "ねがいで": "تَطْبِيق / كِتَاب, اِسْتِمَارَة (موضع تعليم الكتابة. الاستخدام الأصلي؛ مدرسة شبه رسمية لتعليم الأطفال الكِتَابَة والقِرَاءَة ومباديء الحِسَاب وبعض القُرَآن…)\nمثال: هذا الكتاب جديد",
 "ねがいでる": "سَأَلَ, طَلَبَ (اِسْتَعْلَمَ، اسْتَخْبَرَ؛ طَلَبَ، اِلْتَمَسَ)\nمثال: سأل توم عن هذا.",
 "ねがいぬし": "مُقَدِّم طَلَب (الذي قُدِّمَ؛ في : رتبة عسكرية هي خامس الرتب في الترتيب التصاعدي الرَائِد أدنى منه والعَقِيْد أعلى منه) / مُتَقَدِّم\nمثال: تزحلقت العربة المسرعة و اصطدمت مقدمة العربة ب مؤخرة الشاحنة بشكل مفاجئ جدا .",
 "ねがいもとめる": "اِلْتَمَسَ, تَوَسَّلَ",
 "ねがう": "رَغِبَ ((رَغُبَ) رُغْبًا، ورَغابةً: اتَّسَع وعظُم؛ يقال: (رَغُبَ) الوادي) / رَغْبَة\nمثال: يمكن لتوم البقاء إن رغب. / اِسْتَجْدَى, تَسَوَّلَ / تَسَوَّلَ, رَجَا / بيك",
 "ねがえり": "خيانة, غدر (فعل خيانة متعمد) / خِيَانَة (صفة مساعدة العدو)",
 "ねがえりをうつ": "قَلَبَ / خانَ (النُزْل أو الفُنْدُق أو اِسْتِرَاحَة المسافرين؛ الحَانُوْت أو الدُكَّان)\nمثال: خان ياني سكورة.",
 "ねがえる": "خانَ (النُزْل أو الفُنْدُق أو اِسْتِرَاحَة المسافرين؛ الحَانُوْت أو الدُكَّان)\nمثال: خان ياني سكورة. / قَلَبَ",
 "ねがさかぶ": "ثَمِين, غَالٍ (ذو سعر مرتفع)",
 "ねがた": "جَذْر, جدر (جِذْرُ ٱلشَّيْءِ هُوَ: أَصْلُهُ؛ في : جذر العدد النوني هو عدد ما إذا رفعناه لقوة ما أعطانا العدد الأصلي) / جَذْر (جِذْرُ ٱلشَّيْءِ هُوَ: أَصْلُهُ؛ في : جذر العدد النوني هو عدد ما إذا رفعناه لقوة ما أعطانا العدد الأصلي) / أَصْل (جعله أصيلًا أو ثابت الجذور؛ أي عَمَّق وأحكم أصوله؛ نسب شيئًا إلى أصله أو وضّح جذوره)\nمثال: أحسب جذر خمسة بالآلة الحاسبة.",
 "ねがってもない": "أَهْلًا وَسَهْلًا, مَرْحَبًا (تحية ترحيب بالضيف؛ تحية عند اللقاء أو لبدء المحادثة) / تَرْحِيب / رَحَّبَ, اِسْتَقْبِل (بنو رَحَب: اسم؛ بطن من همذان)\nمثال: أهلا يا أصدقاء.",
 "ねがふかい": "رَاسِخ, عَمِيق الجُذُور ((يستخدم خاصة للأفكار أو المبادئ) عميق الجذور؛ ثابت ومتمكّن بقوّة)",
 "ねがわくは": "لَيْتَ, تَمَنَّى (يفيد التمني)\nمثال: ليت بحاجة لتعمل ساعات إضافية.",
 "ねがわくば": "لَيْتَ, تَمَنَّى (يفيد التمني)\nمثال: ليت بحاجة لتعمل ساعات إضافية.",
 "ねがわしい": "مرغوب فيه, مستحب (يستحق الامتلاك أو السعي إليه أو تحقيقه) / جَدِير, لَائِق (جدير بالاختيار خاصة كشريك زواج)\nمثال: وظيفة مرغوبة",
 "ねき": "جَانِب / صَفْحَة",
 "ねきり": "إبادة",
 "ねきりむし": "دودة قارضة (عثة أمريكية شمالية تتغذى يرقاتها على سيقان النباتات الصغيرة وتقطعها عند مستوى الأرض)",
 "ねぎ": "بصل ويلزي, كراث ياباني (بصل آسيوي ذو بصيلات نحيلة؛ يستخدم كبصل أخضر مبكر) / كَاهِن, قِسِّيس / جُنْدُب, جَرَادَة",
 "ねぎらい": "شُكْرًا",
 "ねぎり": "استخراج المعادن, تعدين (فعل استخراج الخامات أو الفحم وما إلى ذلك من الأرض) / تنيقب, حفر (فعل الحفر) / حفر, حفرية (حفرة في الأرض ناتجة عن الحفر) / حفرية, موقع أثري (موقع الاستكشاف الأثري)\nمثال: هناك حفر مثير للاهتمام يجري بالقرب من برينستون",
 "ねぎる": "سَاوَمَ (بالسلعة وعليها: غالى بها وفاوض عليها، أي عرضها بثمن ودفع له المشتري أقل منه وهكذا حتى يتفقا على ثمن بين هذا وذاك؛ على الأمر: تفاوض كما يفعل البائع والمشتري مع السلعة)",
 "ねくいはむし": "خنفساء الأوراق (خنفساء زاهية الألوان تتغذى على أوراق النباتات؛ وتغزو يرقاتها الجذور والسيقان)",
 "ねくら": "كَئِيب, مُوحِش",
 "ねぐされ": "عفن الجذور (مرض يتميز بتعفن الجذور؛ تسببه فطريات مختلفة)",
 "ねぐら": "مجثم (مجثم تستريح عليه أو تنام عليه الطيور الداجنة) / مَجثَم (مأوى به عوارض لجلوس الدواجن أو الطيور الأخرى) / وِسَادَة (الجانب السفلي اللحمي الشبيه بالوسادة لقدم الحيوان أو إصبع الإنسان) / سكن مؤقت (أماكن معيشة مؤقتة) / منصة إطلاق (منصة تطلق منها الصواريخ أو المركبات الفضائية) / حشوة, لبادة (كتلة مسطحة من مادة ناعمة تستخدم للحماية أو الحشو أو الراحة)",
 "ねこ": "قِطّ (حَيْوَان مستأنس من عائلة السَنُّورِيّات، له في اللغة أسماء عديدة تذكر وتؤنث) / قِطَّة (حيوان مستأنس من فصيلة السنوريات) / هِرّ (القطّ؛ صوت الإبل أو دعائها إلى الماء) / هِرَّة (المؤنث من الْهِرّ) / سَنُّور / قطّ (حَيْوَان مستأنس من عائلة السَنُّورِيّات، له في اللغة أسماء عديدة تذكر وتؤنث)\nمثال: أعطنا هذا القط. / شَامِيسِين / غَيْشَا / عَرَبَة يَدَوِيَّة, عَجَلَة يَد",
 "ねこいたち": "نِمْس",
 "ねこかぶり": "دُعابة, مَقلَب (فعل مضحك أو غريب يتم القيام به للمرح والتسلية) / احتيال, خدعة (شيء يهدف إلى الخداع؛ حيلة متعمدة تهدف إلى الحصول على ميزة) / بَارُودِيَا, مُحَاكَاة سَاخِرَة (تكوين يقلد أو يحرف أسلوب شخص ما، عادة بطريقة فكاهية)\nمثال: 猫かぶりしてもお前の正体は分かっているよ。 — أنت ذئب في ثياب خروف.",
 "ねこかわいがり": "مُتَيَّم, مُدَلِّل (محب بإفراط أو بحماقة ومُتسامح بلا حدود)",
 "ねこぐるま": "عَرَبَة يَدَوِيَّة, عَجَلَة يَد",
 "ねこじゃらし": "ذيل الثعلب الأخضر (ذيل ثعلب أوروبي متوطن في أمريكا الشمالية؛ غالباً ما يكون عشبة ضارة مزعجة)",
 "ねこすな": "رمل فضلات القطط (طين محبب يوضع في حاوية حيث يمتص فضلات القطط أو الكلاب)",
 "ねこずな": "رمل فضلات القطط (طين محبب يوضع في حاوية حيث يمتص فضلات القطط أو الكلاب)",
 "ねこぜ": "أحدب (شخص ظهره مقوس بسبب انحناء غير طبيعي في العمود الفقري العلوي) / الحدب, حداب (انحناء خلفي غير طبيعي للعمود الفقري)",
 "ねこそぎ": "كُلّ, جَمِيع",
 "ねこっかわいがり": "مُتَيَّم, مُدَلِّل (محب بإفراط أو بحماقة ومُتسامح بلا حدود)",
 "ねこのてもかりたい": "قَلِيل المَوْظَّفِين, نَاقِص العَدَد (يفتقر إلى العدد الكافي من العاملين أو المساعدين)",
 "ねこのみ": "برغوث القط (برغوث يتكاثر بشكل رئيسي على القطط والكلاب والجرذان)",
 "ねこのめ": "مُتَقَلِّب, نَزَوِيّ (عرضة لتغيّرات مفاجئة وغير متوقّعة) / غَيْرُ مُسْتَقِرّ, مُتَقَلِّب (يَتَّسِمُ بِتَقَلُّبَاتٍ عَشْوَائِيَّةٍ فِي المَشَاعِرِ أَوِ الِارْتِبَاطَاتِ)",
 "ねこばば": "اِخْتِلَاس (الخَلَسُ: الأخذ نُهْزَةومخاتلة، والاختلاس كالخَلَسِ؛ أخذه خُِلْسَةً أي اختلاسا)\nمثال: لقد اتهم باختلاس الأموال العامة.",
 "ねこふんじゃった": "أَعْوَاد الْأَكْل, هَاشِي",
 "ねこま": "قِطّ (حَيْوَان مستأنس من عائلة السَنُّورِيّات، له في اللغة أسماء عديدة تذكر وتؤنث) / قِطَّة (حيوان مستأنس من فصيلة السنوريات) / هِرّ (القطّ؛ صوت الإبل أو دعائها إلى الماء) / هِرَّة (المؤنث من الْهِرّ) / سَنُّور / قطّ (حَيْوَان مستأنس من عائلة السَنُّورِيّات، له في اللغة أسماء عديدة تذكر وتؤنث)\nمثال: أعطنا هذا القط.",
 "ねこまんま": "القط الغذاء",
 "ねこみ": "نَائِم",
 "ねこめ": "مُتَقَلِّب, نَزَوِيّ (عرضة لتغيّرات مفاجئة وغير متوقّعة) / غَيْرُ مُسْتَقِرّ, مُتَقَلِّب (يَتَّسِمُ بِتَقَلُّبَاتٍ عَشْوَائِيَّةٍ فِي المَشَاعِرِ أَوِ الِارْتِبَاطَاتِ)",
 "ねこめし": "القط الغذاء",
 "ねこようトイレ": "صُنْدُوق فَضَلَات, صُنْدُوق رَمْل (وعاء كبيرة من الخشب غالبا وقد يكون حديدًا يستخدم لوضع الاشياء داخله، ويكون لها عادة جهة قابلة للفتح سواء بمفاصل او بالازالة الكاملة؛ صُنْدُوْقُ السَيَّارَة قمرة تشبه الصندوق في الجزء الخلفي من السيارة يستخدم كالصندوق)\nمثال: أين صندوق البريد؟",
 "ねころがる": "اِسْتَلْقَى (وَضَعَ ظَهْرَهُ عَلَى سَطْحٍ كَالسَّرِيرِ والأَرْضِ للنوم أو الاستراحة) / اِضْطَجَعَ\nمثال: استلقى على السرير.",
 "ねころぶ": "اِسْتَلْقَى (وَضَعَ ظَهْرَهُ عَلَى سَطْحٍ كَالسَّرِيرِ والأَرْضِ للنوم أو الاستراحة) / اِضْطَجَعَ\nمثال: استلقى على السرير.",
 "ねこトイレ": "صُنْدُوق فَضَلَات, صُنْدُوق رَمْل (وعاء كبيرة من الخشب غالبا وقد يكون حديدًا يستخدم لوضع الاشياء داخله، ويكون لها عادة جهة قابلة للفتح سواء بمفاصل او بالازالة الكاملة؛ صُنْدُوْقُ السَيَّارَة قمرة تشبه الصندوق في الجزء الخلفي من السيارة يستخدم كالصندوق)\nمثال: أين صندوق البريد؟",
 "ねごこち": "تحسس / شَعَرَ (العِلْم؛ في : هو كلام مُقَفَّى ومُوَازَن على أوزان معروفة يُقصد به إظهار الكلام بصيغة فنية) / شَعَرَ بِ (العِلْم؛ في : هو كلام مُقَفَّى ومُوَازَن على أوزان معروفة يُقصد به إظهار الكلام بصيغة فنية)\nمثال: شعر ماريا طويل.",
 "ねごと": "حديث أثناء النوم (نطق الكلام أثناء النوم) / هُرَاء, لَغْو",
 "ねごみ": "نَائِم",
 "ねごろ": "مَعْقُول (مربوط، قد عُقِلَ بالعِقَال؛ ما يمكن عَقْلَه بالعَقْل)\nمثال: زيري يخاف العناكب بصفة غير معقولة.",
 "ねさげ": "تخفيض السعر, خصم (عملية تخفيض سعر بيع البضائع)",
 "ねざけ": "المباراة الختامية (المباراة الأخيرة في سلسلة من مباراتين متتاليتين) / قبعة نوم (قبعة قماشية تلبس في السرير) / مشروب قبل النوم (مشروب كحولي يؤخذ عند وقت النوم)",
 "ねざめ": "أَيْقَظَ (نبَّهه، ضد نَوَّمَه؛ الغبارَ: أثاره) / اِسْتَيْقَظَ, أَفَاقَ (منع النَوْم)\nمثال: أيقظ زيري السائق",
 "ねざめる": "صَحَا, اِسْتَيْقَظَ (أَفَاقَ؛ اِسْتَيْقَظَ) / أَيْقَظَ (نبَّهه، ضد نَوَّمَه؛ الغبارَ: أثاره)\nمثال: أيقظ زيري السائق",
 "ねざや": "هَامِش",
 "ねしずまる": "غَلَّبَ النُعَاس, نَامَ (قَهَرَ واِعْتَزَّ عليه واِمْتَنَع)",
 "ねしょうべん": "تبول في الفراش (سلس البول أثناء النوم؛ شائع بشكل خاص عند الأطفال (الذين عادة ما يتجاوزونه مع النمو))",
 "ねじあげる": "لَوَى, بَرَمَ",
 "ねじくぎ": "لَوْلَب / بُرْغِيّ, قَلَاوُوظ",
 "ねじくれる": "منحنى",
 "ねじける": "منحنى",
 "ねじこむ": "اِعْتَرَضَ, اِحْتَجَّ (سار عارضا بدون هدف وتخطيط كما تكون الخشبة الطافية في الماء؛ الشيءَ أو الشخصَ: حَالَ بينه وبين ما يريد، أو وقف في طريقه) / اِعْتِرَاض, اِحْتِجَاج\nمثال: اعترض ديما: \"لكن هذا سخيف! الكوبيكات لم تعد تستخدم منذ عصور! و0.99 ليس رقما طبيعيا حتى!\"",
 "ねじしき": "مسنن, مقلوظ ((عن البراغي والمسامير) له أسنان لولبية)",
 "ねじまがる": "لَوَى, بَرَمَ",
 "ねじまげる": "لَوَى, بَرَمَ / شَوَّهَ",
 "ねじまわし": "مِفَكّ الْبَرَاغِيّ",
 "ねじむける": "لَوَى, بَرَمَ",
 "ねじめ": "لَحْن (وضع الألحان أو التأليف الموسيقي؛ قرأ النص بلحن أو أداء صوتي مميز)\nمثال: أنا أحب هذا اللحن.",
 "ねじやま": "سن البرغي, سن اللولب (الضلع الحلزوني البارز الذي يدور حول البرغي)",
 "ねじり": "التواء, عزم الدوران / التواء, تلوّي (شكل أو وضع ملتو ومتعرج)\nمثال: قام البهلوان بالتواءات لا تصدق",
 "ねじりあげる": "لَوَى, بَرَمَ\nمثال: 彼は私の腕をねじり上げた。 — لوى ذراعي.",
 "ねじりばかり": "ميزان الالتواء (أداة قياس مصممة لقياس القوى الصغيرة عن طريق الالتواء الذي تمارسه على سلك رفيع)",
 "ねじり上げる": "لَوَى, بَرَمَ\nمثال: 彼は私の腕をねじり上げた。 — لوى ذراعي.",
 "ねじり秤": "ميزان الالتواء (أداة قياس مصممة لقياس القوى الصغيرة عن طريق الالتواء الذي تمارسه على سلك رفيع)",
 "ねじる": "لَوَى, بَرَمَ / اِلْتِوَاء",
 "ねじれ": "لَوَى, بَرَمَ / التواء, عزم الدوران / التواء, تلوّي (شكل أو وضع ملتو ومتعرج)\nمثال: قام البهلوان بالتواءات لا تصدق",
 "ねじればかり": "ميزان الالتواء (أداة قياس مصممة لقياس القوى الصغيرة عن طريق الالتواء الذي تمارسه على سلك رفيع)",
 "ねじれ秤": "ميزان الالتواء (أداة قياس مصممة لقياس القوى الصغيرة عن طريق الالتواء الذي تمارسه على سلك رفيع)",
 "ねじろ": "حِصْن (ما يُتَحَصَّنُ به ويُمْنَع؛ كل مكان محميّ مُحرَز لا يُوصَل إليه؛ عن ما يُتَحصَّن به وإن لم يكن موضعا أو مكانا كالسلاح مثلا)\nمثال: كان هناك حصن على تلك الهضبة في يوم من الأيام. / قَاعِدَة / قَاعِدَة, مَرْكَز / يُبْنَى عَلَى, يَسْتَنِدُ إِلَى / شائع / منخفض, فاسق / دنيء",
 "ねじをまく": "رِيح, ريح / لَفَّ",
 "ねじを巻く": "رِيح, ريح / لَفَّ",
 "ねじプロペラ": "مروحة دافعة (مروحة بعدة شفرات مائلة تدور للدفع ضد الماء أو الهواء)",
 "ねじ上げる": "لَوَى, بَرَمَ",
 "ねじ向ける": "لَوَى, بَرَمَ",
 "ねじ回し": "مِفَكّ الْبَرَاغِيّ",
 "ねじ山": "سن البرغي, سن اللولب (الضلع الحلزوني البارز الذي يدور حول البرغي)",
 "ねじ式": "مسنن, مقلوظ ((عن البراغي والمسامير) له أسنان لولبية)",
 "ねじ曲がる": "لَوَى, بَرَمَ",
 "ねじ曲げる": "لَوَى, بَرَمَ / شَوَّهَ",
 "ねじ込む": "اِعْتَرَضَ, اِحْتَجَّ (سار عارضا بدون هدف وتخطيط كما تكون الخشبة الطافية في الماء؛ الشيءَ أو الشخصَ: حَالَ بينه وبين ما يريد، أو وقف في طريقه) / اِعْتِرَاض, اِحْتِجَاج\nمثال: اعترض ديما: \"لكن هذا سخيف! الكوبيكات لم تعد تستخدم منذ عصور! و0.99 ليس رقما طبيعيا حتى!\"",
 "ねじ釘": "لَوْلَب / بُرْغِيّ, قَلَاوُوظ",
 "ねすぎる": "اِسْتَغْرَقَ فِي النَّوْم",
 "ねすごす": "اِسْتَغْرَقَ فِي النَّوْم",
 "ねず": "فَأْرَة, فَأْر",
 "ねずっぽ": "سمكة التنين الصغيرة (أسماك بحرية صغيرة غالباً ما تكون زاهية الألوان وعديمة القشور تعيش في القاع؛ توجد في المياه الاستوائية والمعتدلة الدافئة في أوروبا وأمريكا)",
 "ねずのばん": "النوبة الليلية, نوبة آخر الليل (نوبة حراسة أثناء الليل (كما من منتصف الليل إلى 8 صباحاً))",
 "ねずばん": "النوبة الليلية, نوبة آخر الليل (نوبة حراسة أثناء الليل (كما من منتصف الليل إلى 8 صباحاً))",
 "ねずみ": "فَأْرَة, فَأْر",
 "ねずみあな": "جحر, غرفة قذرة (غرفة صغيرة قذرة وغير مريحة) / جحر جرذ (حفرة (كما في جدار مبنى) صنعتها الجرذان)",
 "ねずみいるか": "خنزير البحر المينائي (خنزير البحر الشائع في شمال المحيط الأطلسي والمحيط الهادئ)",
 "ねずみおとし": "مصيدة جرذان (فخ لصيد الجرذان) / مسكن متهالك (سكن قذر متداعي) / مصيدة, ورطة شائكة (وضع صعب ومعقد)",
 "ねずみげ": "أَسْمَر رَمَادِيّ (بلون بني رمادي باهت إلى رمادي مائل للبني) / حصان أشهب (حصان ذو لون رمادي بني باهت) / أشهب, بني رمادي (لون أو صبغة تتراوح حول لون بني رمادي فاتح)\nمثال: ارتدت لوناً أشهب",
 "ねずみこう": "مخطط هرمي (مخطط احتيالي يتم فيه تجنيد أشخاص لدفع مدفوعات للشخص الذي جندهم بينما يتوقعون تلقي مدفوعات من الأشخاص الذين يقومون بتجنيدهم؛ عندما يفشل عدد المجندين…)",
 "ねずみさん": "مُتَتَالِيَة هَنْدَسِيَّة / تكاثر, توالد (النمو عن طريق التضاعف السريع للأجزاء) / انتشار, تكاثر (زيادة سريعة في العدد (خاصة الزيادة السريعة في عدد الأسلحة الفتاكة))\nمثال: انتشار الأسلحة النووية",
 "ねずみざめ": "قرش السلمون",
 "ねずみざん": "مُتَتَالِيَة هَنْدَسِيَّة / تكاثر, توالد (النمو عن طريق التضاعف السريع للأجزاء) / انتشار, تكاثر (زيادة سريعة في العدد (خاصة الزيادة السريعة في عدد الأسلحة الفتاكة))\nمثال: انتشار الأسلحة النووية",
 "ねずみざんしき": "مُتَتَالِيَة هَنْدَسِيَّة",
 "ねずみじか": "طرغولية",
 "ねずみとり": "مصيدة ((كرة القدم الأمريكية) لعبة يُسمح فيها للاعب مدافع بعبور خط الاشتباك ثم يتم حجبه بينما يمر العداء عبر المكان الذي أخلاه لاعب الخط) / مصيدة فئران (فخ لصيد الفئران) / فخ السرعة, كمين رادار (فخ مرتب على الطريق للإمساك بالمسرعين)",
 "ねずみはなび": "دولاب نار, عجلة كاثرين (لعبة نارية دائرية تدور حول نفسها وتطلق نيرانًا ملونة)",
 "ねずみもち": "تمرحنة يابانية (شجيرة دائمة الخضرة من اليابان وكوريا لها أوراق داكنة صغيرة وزهور في عناقيد فضفاضة؛ مرتبطة بالتمرحنة الصينية ولكنها أصغر)",
 "ねずみカンガルー": "كنغر جرذي (أي من عدة كنغر أسترالي يشبه الجرذ بحجم الأرنب)",
 "ねずみチフスきん": "سالمونيلا تيفيموريوم (شكل من أشكال السالمونيلا يسبب التسمم الغذائي لدى البشر)",
 "ねずみ算": "مُتَتَالِيَة هَنْدَسِيَّة / تكاثر, توالد (النمو عن طريق التضاعف السريع للأجزاء) / انتشار, تكاثر (زيادة سريعة في العدد (خاصة الزيادة السريعة في عدد الأسلحة الفتاكة))\nمثال: انتشار الأسلحة النووية",
 "ねずみ算式": "مُتَتَالِيَة هَنْدَسِيَّة",
 "ねずみ花火": "دولاب نار, عجلة كاثرين (لعبة نارية دائرية تدور حول نفسها وتطلق نيرانًا ملونة)",
 "ねずみ講": "مخطط هرمي (مخطط احتيالي يتم فيه تجنيد أشخاص لدفع مدفوعات للشخص الذي جندهم بينما يتوقعون تلقي مدفوعات من الأشخاص الذين يقومون بتجنيدهم؛ عندما يفشل عدد المجندين…)",
 "ねずもち": "تمرحنة يابانية (شجيرة دائمة الخضرة من اليابان وكوريا لها أوراق داكنة صغيرة وزهور في عناقيد فضفاضة؛ مرتبطة بالتمرحنة الصينية ولكنها أصغر)",
 "ねそべる": "انبطاح, تمدد (وضعية غير أنيقة مع تباعد الذراعين والساقين) / تكتل حضري, تمدد حضري (تجمع أو شبكة متصلة من المجتمعات الحضرية)",
 "ねた": "مَادِّيّ / مَادَّة (مؤنث مَادّ، اسم فاعل من مَدَّ. الجمع مَادَّات؛ ما كان مَدَدًا لغيره)\nمثال: لا أحب مادة العلوم. / طُرْفَة, نُكْتَة / نُكْتَة, هَزْل / مَزَحَ / بُرْهَان, دَلِيل / حِيلَة",
 "ねたきり": "طَرِيح الْفِرَاش, مُلَازِم لِلسَّرِير (ملازم للفراش بسبب المرض)",
 "ねたばをあわす": "مَكِيدَة",
 "ねたましい": "غَيُور",
 "ねたみ": "حَسَد, غَبْط (تمنيّ زوال نعمة الغير)\nمثال: الكره لا يظهر بكل بساطة من فراغ. إنه بالعادة يبدأ من الحسد أو الخوف.",
 "ねたみそねみ": "حَسَد, غَبْط (تمنيّ زوال نعمة الغير)\nمثال: الكره لا يظهر بكل بساطة من فراغ. إنه بالعادة يبدأ من الحسد أو الخوف.",
 "ねたむ": "حَسَد (تمنيّ زوال نعمة الغير) / حَسَدَ (تمنيّ زوال نعمة الغير)\nمثال: الكره لا يظهر بكل بساطة من فراغ. إنه بالعادة يبدأ من الحسد أو الخوف.",
 "ねだ": "رافدة (عارضة تستخدم لدعم الأرضيات أو الأسقف)",
 "ねだい": "قَاع, حَوْض (أَرْض مستوية سهلة تنصب إِليها مياه الأمطار فتمسكها ثم تُنبت العشب؛ القَعْر) / مَشَارَة, حَوْض\nمثال: نمت في قاعة السينما.",
 "ねだいた": "لوح أرضية (لوح في الأرضية) / أرضية السيارة (أرضية السيارة)",
 "ねだやし": "استئصال, طمس (التدمير الكامل لكل أثر لشيء ما)",
 "ねだり": "تَسَوُّل",
 "ねだん": "ثَمَن, سِعْر (ثمَّنَ السِّلْعَةَ: قدّر ثَمنَها؛ ثمَّنَ الشيءَ: جعل له ثمانية أركان) / ثَمَن (ثمَّنَ السِّلْعَةَ: قدّر ثَمنَها؛ ثمَّنَ الشيءَ: جعل له ثمانية أركان)\nمثال: دفع زيري الثمن.",
 "ねだんせってい": "تسعير (تقييم شيء ما من حيث سعره)",
 "ねだんひょう": "قَائِمَةُ أَسْعَار",
 "ねち": "حُمَّة, حُمَّى",
 "ねちこい": "حَثِيث, دَائِم (لَا يَتَوَقَّفُ أَبَدًا) / مُلَازِمٌ لِلذِّهْن, مُلِحّ (يَعُودُ إِلَى الذِّهْنِ بِاسْتِمْرَارٍ) / دائم, مستديم (باقٍ؛ لا يسقط) / عَنُود, مُثَابِر (ثابت بإصرار لا يلين ولا يتراجع)\nمثال: الأوراق المستديمة تبقى ملتصقة بعد النضج",
 "ねちっこい": "حَثِيث, دَائِم (لَا يَتَوَقَّفُ أَبَدًا) / مُلَازِمٌ لِلذِّهْن, مُلِحّ (يَعُودُ إِلَى الذِّهْنِ بِاسْتِمْرَارٍ) / دائم, مستديم (باقٍ؛ لا يسقط) / عَنُود, مُثَابِر (ثابت بإصرار لا يلين ولا يتراجع)\nمثال: الأوراق المستديمة تبقى ملتصقة بعد النضج",
 "ねちねち": "بلزوجة (بطريقة لزجة ودبقة)\nمثال: شعر بالدم يتحرك بلزوجة من فروة رأسه المشقوقة ويسيل على جبهته / بِإِصْرَار (مع الإصرار) / بإصرار, بشكل متواصل (بطريقة مستمرة ومصرة)\nمثال: كان يطرح أسئلة، أسئلة لا مفر منها، بإصرار",
 "ねちゃねちゃ": "لَيِّن وَلَزِج (طريّ ولزج الملمس)",
 "ねっから": "بالفطرة, بطبعه (من خلال الطبيعة المتأصلة)\nمثال: كان كسولاً بطبعه / مطلقا, على الإطلاق",
 "ねっからはっから": "مطلقا, على الإطلاق",
 "ねっき": "حَرَارَة (السخونة والحماوة؛ شدة العَطَش) / حَرَارَة, سُخُونَة (السخونة والحماوة؛ شدة العَطَش) / سَخَّنَ, أَحَرَّ (حمي وأصبح حارا)\nمثال: حرارة الطقس تتزايد. / حَمَاس, حَمَاسَة / حُمَّة, حُمَّى",
 "ねっききゅう": "مُنْطَاد, بَالُون",
 "ねっきょうしゃ": "متحمس, نصير (مؤيد قوي ومتحمس لشخص أو نشاط ما) / مولع, هاوٍ (شخص لديه إعجاب قوي بشيء ما)",
 "ねっきょうてき": "مَجْنُون, مَخْبُول",
 "ねっきょうてきしんじゃ": "مُتَعَصِّب / مُتَعَصِّب, غَيُور",
 "ねっきょうぶり": "تشقق دقيق (شق دقيق في الطلاء أو أي سطح آخر) / بدعة, صرعة (اهتمام يُتبع بحماس مبالغ فيه) / نوبة جنون, هياج (حالة من الهياج العقلي العنيف)\nمثال: يتبع دائماً أحدث الصرعات",
 "ねっけつ": "حَمَاس / جُهْد (بَذَلَ قُصَارَى جُهْدِهِ فِي أَمْرٍ مَا؛ أَتْعَبَ نَفْسَهُ أو غَيْرَهُ بِعَمَلٍ شَاقٍ)\nمثال: لا إنجاز بلا جهد .",
 "ねっけつかん": "حَمِيّ الطَّبْع, مُتَّقِدُ المَشَاعِر (ميّال إلى الانفعال والعاطفة الشديدة)",
 "ねっけつだんじ": "حَمِيّ الطَّبْع, مُتَّقِدُ المَشَاعِر (ميّال إلى الانفعال والعاطفة الشديدة)",
 "ねっこ": "جَذْر, جدر (جِذْرُ ٱلشَّيْءِ هُوَ: أَصْلُهُ؛ في : جذر العدد النوني هو عدد ما إذا رفعناه لقوة ما أعطانا العدد الأصلي) / جَذْر (جِذْرُ ٱلشَّيْءِ هُوَ: أَصْلُهُ؛ في : جذر العدد النوني هو عدد ما إذا رفعناه لقوة ما أعطانا العدد الأصلي) / أَصْل (جعله أصيلًا أو ثابت الجذور؛ أي عَمَّق وأحكم أصوله؛ نسب شيئًا إلى أصله أو وضّح جذوره)\nمثال: أحسب جذر خمسة بالآلة الحاسبة. / جُذْمُور, كُنَّاشَة",
 "ねっころがる": "اِسْتَلْقَى (وَضَعَ ظَهْرَهُ عَلَى سَطْحٍ كَالسَّرِيرِ والأَرْضِ للنوم أو الاستراحة) / اِضْطَجَعَ\nمثال: استلقى على السرير.",
 "ねっしゃびょう": "ضربة شمس, فرط الحرارة (انهيار ناتج عن التعرض للحرارة المفرطة)",
 "ねっしやすい": "سريع الانفعال, قابل للإثارة (يسهل إثارته) / سَرِيع الاسْتِثَارَة, قَابِل لِلتَّهَيُّج (قادر على الاستجابة للمحفّزات)",
 "ねっしょう": "حَرْق (الفعل له عدة معانٍ تتعلق بالتأثير والتلف، منها: برد الحديد، حكّ الأنياب، إتلاف الثوب بالدق، وحرق الشيء بالنار؛ إتلاف شيء ما بالنار أو بأداة حادة، كما يشمل المعنى المجازي للألم الشديد والحزن الذي يُؤثر في القلب) / سَفْعَة / حُرق (الفعل له عدة معانٍ تتعلق بالتأثير والتلف، منها: برد الحديد، حكّ الأنياب، إتلاف الثوب بالدق، وحرق الشيء بالنار؛ إتلاف شيء ما بالنار أو بأداة حادة، كما يشمل المعنى المجازي للألم الشديد والحزن الذي يُؤثر في القلب) / أَحْرَقَ (أحرقت النار الشيءَ: حرقته؛ أحرقَ الشيءَ: أهلكه) / حَرَقَ (الفعل له عدة معانٍ تتعلق بالتأثير والتلف، منها: برد الحديد، حكّ الأنياب، إتلاف الثوب بالدق، وحرق الشيء بالنار؛ إتلاف شيء ما بالنار أو بأداة حادة، كما يشمل المعنى المجازي للألم الشديد والحزن الذي يُؤثر في القلب) / ضَرِمَ / حرق (الفعل له عدة معانٍ تتعلق بالتأثير والتلف، منها: برد الحديد، حكّ الأنياب، إتلاف الثوب بالدق، وحرق الشيء بالنار؛ إتلاف شيء ما بالنار أو بأداة حادة، كما يشمل المعنى المجازي للألم الشديد والحزن الذي يُؤثر في القلب) / وَلَّع\nمثال: قامت ليلى بحرق كل كتب آرت المتعلقة بالأدب العنصري.",
 "ねっしん": "مُتَحَمِّس, حَمَاسِيّ",
 "ねっすい": "مشكلة عويصة, ورطة (مأزق خطير أو مؤلم)\nمثال: آراؤه حول العرق أوقعته في ورطة سياسية",
 "ねっすいせん": "يُنْبُوع حَارّ, مِيَاه حارَّة (ينبوع: عَيْنُ المَاءِ أو جَدْوَلٌ كَثِيرُ المَاءِ)\nمثال: ماء هذا الينبوع صافي.",
 "ねっする": "حَرَارَة (السخونة والحماوة؛ شدة العَطَش) / حَرَارَة, سُخُونَة (السخونة والحماوة؛ شدة العَطَش) / سَخَّنَ, أَحَرَّ (حمي وأصبح حارا)\nمثال: حرارة الطقس تتزايد.",
 "ねっせい": "جدية, رزانة (سمة كون المرء جاداً) / إخلاص, جدية (شعور جاد وصادق)\nمثال: نقص الوقار ليس بالضرورة نقصاً في الجدية",
 "ねっせん": "شعاع تحت أحمر (شعاع من الأشعة تحت الحمراء؛ ينتج تأثيراً حرارياً (كما من مصباح الأشعة تحت الحمراء))",
 "ねったい": "مَدَار (اسم مَفْعُول من أدَارَ، الشيء أو الشخص الذي أُدِير)\nمثال: انتشرت الشائعة على مدار الدولة.",
 "ねったいいがく": "طب المناطق الحارة (فرع الطب الذي يتعامل مع تشخيص وعلاج الأمراض الموجودة غالباً في المناطق الاستوائية)",
 "ねったいうりん": "غَابَة مَطِيرَة مَدَارِيَّة (الغَابَةُ: الأَجَمَةُ ذاتُ الشَّجَرِ المُتَكَاثِف؛ لأَنَّها تُغَيِّبُ مَا فِيهَا. أو الأَجَمَةُ الَّتِي طالتْ، وَلَهَا أَطْراف مُرْتَفِعَةٌ باسِقَة؛ الغابةُ أَجَمة القَصَب، قَالَ: وَقَدْ جُعِلَتْ جماعةَ الشَّجَرِ، لأَنه مأْخوذ مِنَ الغَيابةِ)\nمثال: مشينا في الغابة",
 "ねったいたうりん": "غَابَة مَطِيرَة مَدَارِيَّة (الغَابَةُ: الأَجَمَةُ ذاتُ الشَّجَرِ المُتَكَاثِف؛ لأَنَّها تُغَيِّبُ مَا فِيهَا. أو الأَجَمَةُ الَّتِي طالتْ، وَلَهَا أَطْراف مُرْتَفِعَةٌ باسِقَة؛ الغابةُ أَجَمة القَصَب، قَالَ: وَقَدْ جُعِلَتْ جماعةَ الشَّجَرِ، لأَنه مأْخوذ مِنَ الغَيابةِ)\nمثال: مشينا في الغابة",
 "ねっちゅうしょう": "ضربة شمس, فرط الحرارة (انهيار ناتج عن التعرض للحرارة المفرطة)",
 "ねっちり": "بلزوجة (بطريقة لزجة ودبقة)\nمثال: شعر بالدم يتحرك بلزوجة من فروة رأسه المشقوقة ويسيل على جبهته / بِإِصْرَار (مع الإصرار) / بإصرار, بشكل متواصل (بطريقة مستمرة ومصرة)\nمثال: كان يطرح أسئلة، أسئلة لا مفر منها، بإصرار",
 "ねっとう": "ماء مغلي (ماء تم تسخينه إلى درجة الغليان أو تجاوزها)\nمثال: هناك غلاية ماء مغلي على الموقد",
 "ねっとり": "بلزوجة (بطريقة لزجة ودبقة)\nمثال: شعر بالدم يتحرك بلزوجة من فروة رأسه المشقوقة ويسيل على جبهته",
 "ねっぱ": "مَوْجَة اَلْحَرّ",
 "ねっぱつ": "حُمَّة, حُمَّى",
 "ねつ": "حَرَارَة (السخونة والحماوة؛ شدة العَطَش) / حَرَارَة, سُخُونَة (السخونة والحماوة؛ شدة العَطَش) / سَخَّنَ, أَحَرَّ (حمي وأصبح حارا)\nمثال: حرارة الطقس تتزايد. / حُمَّة, حُمَّى / حَمَاس / جُهْد (بَذَلَ قُصَارَى جُهْدِهِ فِي أَمْرٍ مَا؛ أَتْعَبَ نَفْسَهُ أو غَيْرَهُ بِعَمَلٍ شَاقٍ)\nمثال: لا إنجاز بلا جهد .",
 "ねつあい": "تَفَرُّغ",
 "ねつあいしゃ": "عَاشِق, عَاشِقَة / مُغْرَم",
 "ねつい": "حَمَاس / جُهْد (بَذَلَ قُصَارَى جُهْدِهِ فِي أَمْرٍ مَا؛ أَتْعَبَ نَفْسَهُ أو غَيْرَهُ بِعَمَلٍ شَاقٍ)\nمثال: لا إنجاز بلا جهد .",
 "ねつおせん": "تلوث حراري (ضرر يلحق بالبحيرات والأنهار ناتج عن إطلاق حرارة زائدة فيها)",
 "ねつかがく": "كيمياء حرارية (فرع الكيمياء الذي يدرس العلاقة بين العمل الكيميائي وكمية الحرارة الممتصة أو المتولدة)",
 "ねつかくはんのう": "تفاعل نووي حراري (تفاعل اندماج نووي يحدث في درجات حرارة عالية جداً (كما في الشمس))",
 "ねつかそ": "لدائني الحرارة, لدن بالحرارة (له خاصية الليونة أو الانصهار عند التسخين والتصلب مرة أخرى عند التبريد) / بلاستيك حراري, لدائن حرارية (مادة تلين عند تسخينها وتتصلب مرة أخرى عند تبريدها)\nمثال: المواد اللدائنية الحرارية يمكن إعادة صهرها وتبريدها مرارًا دون الخضوع لأي تغيير كيميائي ملحوظ",
 "ねつかそじゅし": "بلاستيك حراري, لدائن حرارية (مادة تلين عند تسخينها وتتصلب مرة أخرى عند تبريدها)",
 "ねつかそせいじゅし": "بلاستيك حراري, لدائن حرارية (مادة تلين عند تسخينها وتتصلب مرة أخرى عند تبريدها)",
 "ねつきかん": "محرك حراري (أي محرك يستخدم الحرارة للقيام بعمل)",
 "ねつききゅう": "مُنْطَاد, بَالُون",
 "ねつきぐ": "مِدْفَأَة",
 "ねつぎ": "لصقة, وصلة (نقطة اتصال حيث يتم ضم شيئين (مثل الورق أو الفيلم أو الشريط المغناطيسي) معاً)\nمثال: كان الانقطاع بسبب وصلة غير متقنة",
 "ねつく": "غَلَّبَ النُعَاس, نَامَ (قَهَرَ واِعْتَزَّ عليه واِمْتَنَع)",
 "ねつくさい": "دَافِئ / دَفِيء",
 "ねつけ": "حمى, سخونة (ارتفاع في درجة حرارة الجسم؛ غالباً ما يكون عرضاً للعدوى) / محمومية, هياج (حالة من النشاط أو العاطفة المثارة بشدة)",
 "ねつけん": "ثِيرْمُوسْفِير",
 "ねつこうか": "تصلبي الحرارة, صلد بالحرارة (له خاصية التصلب الدائم عند التسخين أو المعالجة)\nمثال: كانت راتنجات الفينول والبلاستيك هي المواد الاصطناعية الأصلية المتصلبة بالحرارة",
 "ねつこうかざい": "مصلب, مقسي (مادة تزيد الصلابة، خاصة مادة تضاف إلى الورنيش أو الطلاء لمنحه سطحاً أو طبقة أكثر صلابة)",
 "ねつこうかせいじゅし": "راتينج تصلب بالحرارة, لدائن تصلب بالحرارة (مادة تتصلب عند تسخينها ولا يمكن إعادة تشكيلها)",
 "ねつこうかんき": "مبادل حراري (جهاز ينقل الحرارة من سائل إلى آخر دون السماح باختلاطهما)",
 "ねつさまし": "خافض للحرارة",
 "ねつじょう": "اتقاد, حرارة (مشاعر الدفء والحدة الكبيرة) / شغف, وله (شعور مكثف بالحب) / اتقاد, اندفاع (شعور بتوق قوي (عادة لصالح شخص أو قضية))\nمثال: تحدث بحماسة كبيرة",
 "ねつじょうてき": "مُتَوَهِّج",
 "ねつぞう": "فَبْرَكَة",
 "ねつっぽい": "مَحْمُوم, مُحْتَدِم (يتسم باضطراب أو انفعال شديد) / مَحْمُوم, مُصَاب بِالحُمَّى (يعاني من الحمّى أو متأثّر بها) / حمي, محموم (مكون من أو متعلق بـ أو يتميز بالحمى)\nمثال: تفاعل حمي ناتج عن مادة مسببة للحساسية / مُتَحَمِّس",
 "ねつでんし": "أَيُون حَرَارِيّ (جسيم مشحون كهربائياً (إلكترون أو أيون) ينبعث من مادة عند درجة حرارة عالية)",
 "ねつでんつい": "مزدوجة حرارية (نوع من مقاييس الحرارة يتكون من سلكين من معدنين مختلفين متصلين في كلا الطرفين؛ حيث يولد التيار في الدائرة بما يتناسب مع فرق درجات الحرارة)",
 "ねつでんどうりつ": "موصلية حرارية (في الفيزياء، خاصية المادة لتوصيل الحرارة)\nمثال: عندما تخضع مادة لتغير في الطور من صلب إلى سائل أو من سائل إلى غاز، قد تتغير الموصلية الحرارية",
 "ねつど": "دَرَجَةْ الْحَرَارَة / حُمَّى (حمَى الشيءُ فلانًا: منَعه ودفع عنه؛ حمى المريضَ: منعه ما يضره)\nمثال: ليس لديك أي حمى.",
 "ねつのかべ": "حاجز حراري (حد لسرعة الطيران العالية يفرضه التسخين الديناميكي الهوائي)",
 "ねつのこもった": "مُسَخَّن (جُعِل دافئاً أو ساخناً) / حَامٍ, مُحْتَدِم (يتّسم بالحدّة العاطفيّة؛ عنيف)",
 "ねつばて": "إنهاك حراري (حالة تتميز بالدوخة والغثيان والضعف الناجم عن استنزاف سوائل الجسم والشوارد)",
 "ねつひはい": "إنهاك حراري (حالة تتميز بالدوخة والغثيان والضعف الناجم عن استنزاف سوائل الجسم والشوارد)",
 "ねつひろう": "إنهاك حراري (حالة تتميز بالدوخة والغثيان والضعف الناجم عن استنزاف سوائل الجسم والشوارد)",
 "ねつびょう": "حُمَّة, حُمَّى",
 "ねつぶんかい": "تحلل حراري (تحول مادة ناتج عن تأثير الحرارة)",
 "ねつぼうそう": "تسخين مفرط, فرط السخونة (تسخين مفرط)",
 "ねつりきがく": "دِينَامِيكَا حَرَارِيَّة",
 "ねつりきがくだいいちほうそく": "حفظ الطاقة, قانون حفظ الطاقة (المبدأ الأساسي في الفيزياء القائل بأن الطاقة الكلية لنظام معزول ثابتة على الرغم من التغيرات الداخلية)",
 "ねつりきがくだいさんほうそく": "القانون الثالث للديناميكا الحرارية (قانون ينص على أن إنتروبيا مادة ما تقترب من الصفر مع اقتراب درجة حرارتها من الصفر المطلق)",
 "ねつりきがくだいにほうそく": "القانون الثاني للديناميكا الحرارية (قانون ينص على أنه لا يمكن استخلاص شغل ميكانيكي من جسم إلا عندما يتفاعل ذلك الجسم مع جسم آخر عند درجة حرارة أقل؛ أي عملية تلقائية تؤدي إلى زيادة في…)",
 "ねつりきがくてき": "ترموديناميكي, ديناميكي حراري (متعلق بالديناميكا الحرارية)\nمثال: الحد الديناميكي الحراري",
 "ねつりきがくのだいいちほうそく": "حفظ الطاقة, قانون حفظ الطاقة (المبدأ الأساسي في الفيزياء القائل بأن الطاقة الكلية لنظام معزول ثابتة على الرغم من التغيرات الداخلية)",
 "ねつりきがくのだいさんほうそく": "القانون الثالث للديناميكا الحرارية (قانون ينص على أن إنتروبيا مادة ما تقترب من الصفر مع اقتراب درجة حرارتها من الصفر المطلق)",
 "ねつりきがくのだいにほうそく": "القانون الثاني للديناميكا الحرارية (قانون ينص على أنه لا يمكن استخلاص شغل ميكانيكي من جسم إلا عندما يتفاعل ذلك الجسم مع جسم آخر عند درجة حرارة أقل؛ أي عملية تلقائية تؤدي إلى زيادة في…)",
 "ねつりきがくのだいゼロほうそく": "القانون الصفري للديناميكا الحرارية (القانون الذي ينص على أنه إذا كان جسمان في توازن حراري مع جسم ثالث، فإن الجسمين الأولين يكونان في توازن حراري مع بعضهما البعض)",
 "ねつりきがくのほうそく": "قانون الديناميكا الحرارية ((فيزياء) قانون يحكم العلاقات بين حالات الطاقة في نظام مغلق)",
 "ねつりきがくほうそく": "قانون الديناميكا الحرارية ((فيزياء) قانون يحكم العلاقات بين حالات الطاقة في نظام مغلق)",
 "ねつりょう": "حَمَاس, حَمَاسَة",
 "ねつりょうけい": "مسعر, مقياس الحرارة (أداة قياس تحدد كميات الحرارة)",
 "ねつれつ": "مُتَوَهِّج كَالنَّار, مُتَّقِد (يَتَوَهَّج أَوْ يَلْمَع كَالنَّار) / حَارّ, مُتَوَقِّد (يتّسم بحماسة شديدة وقويّة) / حَمَاسِيّ, مُتَحَمِّس (يَتَّسِمُ بِعَاطِفَةٍ شَدِيدَة)",
 "ねつエネルギー": "حرارة, طاقة حرارية (شكل من أشكال الطاقة يتم نقله عن طريق اختلاف في درجة الحرارة)",
 "ねつポンプ": "مضخة حرارية (جهاز يستخرج الحرارة من سائل ذي درجة حرارة أعلى من محيطه؛ يمكن استخدامه لنقل الحرارة من خزان خارجي لتدفئة مبنى)",
 "ねつ造": "فَبْرَكَة",
 "ねづく": "جَذْر, جدر (جِذْرُ ٱلشَّيْءِ هُوَ: أَصْلُهُ؛ في : جذر العدد النوني هو عدد ما إذا رفعناه لقوة ما أعطانا العدد الأصلي) / جَذْر (جِذْرُ ٱلشَّيْءِ هُوَ: أَصْلُهُ؛ في : جذر العدد النوني هو عدد ما إذا رفعناه لقوة ما أعطانا العدد الأصلي) / أَصْل (جعله أصيلًا أو ثابت الجذور؛ أي عَمَّق وأحكم أصوله؛ نسب شيئًا إلى أصله أو وضّح جذوره)\nمثال: أحسب جذر خمسة بالآلة الحاسبة.",
 "ねづけ": "تسعير (تقييم شيء ما من حيث سعره)",
 "ねづもり": "تثمين, تقدير (حكم على صفات شيء أو شخص ما) / تخمين, تقدير (حساب تقريبي للكمية أو الدرجة أو القيمة) / تقدير (الاحترام الذي يحظى به شخص ما) / تثمين, تقدير (وثيقة تقدر قيمة شيء ما (مثل التأمين أو الضرائب))\nمثال: في تقديري الصبي بريء",
 "ねづよい": "رَاسِخ, عَمِيق الجُذُور ((يستخدم خاصة للأفكار أو المبادئ) عميق الجذور؛ ثابت ومتمكّن بقوّة)",
 "ねてもさめても": "باستمرار, بشكل متواصل (بشكل ثابت لا يتغير) / باستمرار, دائماً (بدون تنوع أو تغيير، في كل حالة)\nمثال: العالم يتغير باستمرار",
 "ねとねと": "بلزوجة (بطريقة لزجة ودبقة)\nمثال: شعر بالدم يتحرك بلزوجة من فروة رأسه المشقوقة ويسيل على جبهته",
 "ねとまり": "إِقَامَة",
 "ねとられ": "دياثة (فعل جنسي يمارس فيه شخص متزوج الجنس مع شخص آخر بينما يشاهد الزوج ذلك)",
 "ねどい": "تطفل, فضول (حالة من الفضول النشط) / حب الاستطلاع, فضول (صفة الفضول والاهتمام)\nمثال: أزعجتني نظرة الاختراق وحب الاستطلاع لديه: شعرت بالحرج والذنب في وجوده",
 "ねどうぐ": "أغطية السرير, مفروشات السرير (الأغطية التي تستخدم على السرير) / فَرْشَة, فِرَاش (مادة تُستخدم لتهيئة فراش أو مرقد للحيوانات)",
 "ねどこ": "قَاع, حَوْض (أَرْض مستوية سهلة تنصب إِليها مياه الأمطار فتمسكها ثم تُنبت العشب؛ القَعْر) / مَشَارَة, حَوْض\nمثال: نمت في قاعة السينما. / مَخْدَع, غُرْفَةُ نَوْم",
 "ねどころ": "مَخْدَع, غُرْفَةُ نَوْم / مجثم (مجثم تستريح عليه أو تنام عليه الطيور الداجنة) / مَجثَم (مأوى به عوارض لجلوس الدواجن أو الطيور الأخرى)",
 "ねなし": "صُعْلُوك, مُقْتَلَع الجُذُور (يتشرّد بلا هدف ودون روابط بمكان أو مجتمع)",
 "ねなしぐさ": "عدس الماء (عَدَس)\nمثال: أعدت سلطة العدس. / هَائِم",
 "ねぬき": "ابْنُ البَلَد, مَوْلُودٌ فِي البَلَد (يَنْتَمِي إِلَى مَكَانٍ بِحُكْمِ الوِلَادَةِ فِيهِ)",
 "ねね": "يَاه, اسمع / هَلَا",
 "ねのかたすくに": "سِجِّين, عَالَم سُفْلِيّ",
 "ねのくに": "سِجِّين, عَالَم سُفْلِيّ",
 "ねのとき": "مُنْتَصَف لَيْل, مُنْتَصَف اللَّيْل / مُنْتَصَف اَللَّيْل",
 "ねはん": "اَلنِّرْفَانَا / مَوْت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي) / وَفَاة / هَلَاك / مَنِيَّة / حِمَام (قضاء الموت وقدره؛ جمع حُمَّة وهو قدر الفراق) / موت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي)\nمثال: لا اخاف الموت .",
 "ねば": "دبق, لزوجة (خاصية الالتصاق بسطح ما) / طِين, صَلْصَال",
 "ねばい": "دَبِق, صَمْغِيّ (له خصائص اللصق اللزجة كالمواد اللاصقة) / لَاصِق, لَزِق (مُغطّى بمادّة لاصقة) / حَرِج, مُحْرِج (صَعْب التَّعَامُل مَعَهُ؛ يُسَبِّب أَلَمًا أَوْ إِحْرَاجًا) / حَارّ وَرَطْب, خَانِق (حارّ أو دافئ ورطب بشكل مزعج)",
 "ねばっこい": "دَبِق, صَمْغِيّ (له خصائص اللصق اللزجة كالمواد اللاصقة) / لَاصِق, لَزِق (مُغطّى بمادّة لاصقة) / حَرِج, مُحْرِج (صَعْب التَّعَامُل مَعَهُ؛ يُسَبِّب أَلَمًا أَوْ إِحْرَاجًا) / حَارّ وَرَطْب, خَانِق (حارّ أو دافئ ورطب بشكل مزعج) / مُتَمَاسِك (ملتصق ببعضه ومتماسك) / حافظ, قوي الذاكرة (جيد في التذكر) / عَنُود, مُثَابِر (ثابت بإصرار لا يلين ولا يتراجع)\nمثال: عقل حافظ",
 "ねばつち": "طِين, صَلْصَال",
 "ねばならない": "وَجَبَ, يَتَحَتَّم (لَزِمَ، تَعَيَّنَ. (مصدره وُجُوب)؛ لزم وصار أكيد حدوثه. (مصدره وجُوب)) / لَابُدَّ / عَصِير (سائلٌ سُكَّريٌّ يُستخرج من بعض الثّمار عند عَصْرها)\nمثال: وجب عليك إيقافه.",
 "ねばならぬ": "وَجَبَ, يَتَحَتَّم (لَزِمَ، تَعَيَّنَ. (مصدره وُجُوب)؛ لزم وصار أكيد حدوثه. (مصدره وجُوب)) / لَابُدَّ / عَصِير (سائلٌ سُكَّريٌّ يُستخرج من بعض الثّمار عند عَصْرها)\nمثال: وجب عليك إيقافه.",
 "ねばなりません": "وَجَبَ, يَتَحَتَّم (لَزِمَ، تَعَيَّنَ. (مصدره وُجُوب)؛ لزم وصار أكيد حدوثه. (مصدره وجُوب)) / لَابُدَّ / عَصِير (سائلٌ سُكَّريٌّ يُستخرج من بعض الثّمار عند عَصْرها)\nمثال: وجب عليك إيقافه.",
 "ねばなるまい": "يَنْبَغِي أَنْ / مِنْ اَلْمَفْرُوض أَنْ (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / مِنْ اَلْمُفْتَرَض أَنْ (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "ねばねば": "دَبِق, صَمْغِيّ (له خصائص اللصق اللزجة كالمواد اللاصقة) / لَاصِق, لَزِق (مُغطّى بمادّة لاصقة) / حَرِج, مُحْرِج (صَعْب التَّعَامُل مَعَهُ؛ يُسَبِّب أَلَمًا أَوْ إِحْرَاجًا) / حَارّ وَرَطْب, خَانِق (حارّ أو دافئ ورطب بشكل مزعج) / دبق, لزوجة (خاصية الالتصاق بسطح ما)",
 "ねばり": "دبق, لزوجة (خاصية الالتصاق بسطح ما) / إصرار, دأب (تصميم مستمر)",
 "ねばりがち": "عَنِيف المُنَافَسَة (يَتَطَلَّب جُهْدًا كَبِيرًا)",
 "ねばりけ": "دبق, لزوجة (خاصية الالتصاق بسطح ما)",
 "ねばりづよい": "مُتَمَاسِك (ملتصق ببعضه ومتماسك) / حافظ, قوي الذاكرة (جيد في التذكر) / عَنُود, مُثَابِر (ثابت بإصرار لا يلين ولا يتراجع)\nمثال: عقل حافظ / دَبِق, صَمْغِيّ (له خصائص اللصق اللزجة كالمواد اللاصقة) / لَاصِق, لَزِق (مُغطّى بمادّة لاصقة) / حَرِج, مُحْرِج (صَعْب التَّعَامُل مَعَهُ؛ يُسَبِّب أَلَمًا أَوْ إِحْرَاجًا) / حَارّ وَرَطْب, خَانِق (حارّ أو دافئ ورطب بشكل مزعج)",
 "ねばり強い": "مُتَمَاسِك (ملتصق ببعضه ومتماسك) / حافظ, قوي الذاكرة (جيد في التذكر) / عَنُود, مُثَابِر (ثابت بإصرار لا يلين ولا يتراجع)\nمثال: عقل حافظ / دَبِق, صَمْغِيّ (له خصائص اللصق اللزجة كالمواد اللاصقة) / لَاصِق, لَزِق (مُغطّى بمادّة لاصقة) / حَرِج, مُحْرِج (صَعْب التَّعَامُل مَعَهُ؛ يُسَبِّب أَلَمًا أَوْ إِحْرَاجًا) / حَارّ وَرَطْب, خَانِق (حارّ أو دافئ ورطب بشكل مزعج)",
 "ねばる": "ثَابَرَ",
 "ねびき": "تخفيض السعر, خصم (عملية تخفيض سعر بيع البضائع)",
 "ねびきりつ": "خصم مصرفي, سعر الخصم (فائدة على أساس سنوي تُخصم مقدماً على قرض) / سعر الخصم الفيدرالي (سعر الفائدة الذي يحدده الاحتياطي الفيدرالي والذي يُفرض على البنوك الأعضاء عند اقتراض الأموال من خلال نظام الاحتياطي الفيدرالي)",
 "ねふだ": "عَلَامَةُ سِعْر, بِطَاقَةُ سِعْر (سِمَةٌ أو أمارة أو شِعَار تُعرف به الأشياء؛ رَمْز)\nمثال: تحصلت على علامة أ.",
 "ねぶか": "بصل ويلزي, كراث ياباني (بصل آسيوي ذو بصيلات نحيلة؛ يستخدم كبصل أخضر مبكر)",
 "ねぶかい": "رَاسِخ, عَمِيق الجُذُور ((يستخدم خاصة للأفكار أو المبادئ) عميق الجذور؛ ثابت ومتمكّن بقوّة)",
 "ねぶくろ": "حَقِيبَةُ النَّوْم",
 "ねぶと": "دُمَّل, خُرَاج / غَلَيَان, غَلْي / غَلَّى",
 "ねぶみ": "تثمين, تخمين (تقدير خبير للجودة والكمية والخصائص الأخرى لشخص أو شيء ما) / تقدير, تقييم (تصنيف شخص أو شيء ما فيما يتعلق بقيمته) / تثمين, تقدير (وثيقة تقدر قيمة شيء ما (مثل التأمين أو الضرائب))",
 "ねぶり": "نَامَ, رَقَدَ (الإنسان أو الحيوان: رَقَدَ وغَفَا؛ الإنسان أو الحيوان: رَقَدَ وإن لم يغفو) / نَوْم, سِنَة (بكافة معانيه) / نَوْمَة / غَمَص, رَمَص\nمثال: نام في الحافلة. / خمول, ركود (حالة عدم النشاط أو قلة النشاط) / خمول, عطالة (الميل للبقاء غير نشط أو خامل) / جمود, خمول (حالة عدم النشاط)\nمثال: كان عليه التغلب على عطالته والعودة للعمل / مَوْت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي) / وَفَاة / هَلَاك / مَنِيَّة / حِمَام (قضاء الموت وقدره؛ جمع حُمَّة وهو قدر الفراق) / موت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي)\nمثال: لا اخاف الموت .",
 "ねぶる": "نَامَ, رَقَدَ (الإنسان أو الحيوان: رَقَدَ وغَفَا؛ الإنسان أو الحيوان: رَقَدَ وإن لم يغفو) / نَوْم, سِنَة (بكافة معانيه) / نَوْمَة / غَمَص, رَمَص\nمثال: نام في الحافلة. / مَاتَ (للحَيّ: فقد الحَيَاة. مصدره مَوتَا ومِيتَة؛ للأرض: ليس فيها شيء حَيّ من النبات أو الحيوان أو الإنسان. مصدره مَوَات) / تُوُفِّيَ / زَهْر اَلطَّاوِلَة, زَهْر اَلنَّرْد ((زَهَرَ) الوجهُ والسراجُ والقمرُ يَزْهُرُ زَهْرًا، وزُهُوراً: تلألأ وأشْرق؛ (زَهَرَ) الشيءُ: صَفا لونُه)\nمثال: إعتقدت أنه مات. / لَحَسَ, لَعِقَ (مرّر اللسان على الشيء لأخذ طعمه أو لتنظيفه؛ أزال الشيء بلعقه باللسان)",
 "ねべや": "مَخْدَع, غُرْفَةُ نَوْم",
 "ねほりはほり": "بتساؤل, بفضول\nمثال: نظر الطفل حوله بفضول",
 "ねぼう": "اِسْتَغْرَقَ فِي النَّوْم / نَؤُوم, نَعْسَان (شخص يشعر بالنعاس)",
 "ねぼすけ": "نَؤُوم, نَعْسَان (شخص يشعر بالنعاس)",
 "ねま": "مَخْدَع, غُرْفَةُ نَوْم",
 "ねまき": "ملابس نوم (ملابس مصممة للارتداء في السرير)",
 "ねまわし": "خَلْفَ الكَوَالِيس, سِرِّيّ (مُصَمَّمٌ وَمُنَفَّذٌ بِسِرِّيَّةٍ أَوْ بِشَكْلٍ سِرِّيّ)",
 "ねむい": "نَعْسَان, نَاعِس",
 "ねむけ": "نُعَاس, سِنَة",
 "ねむたい": "نَعْسَان, نَاعِس",
 "ねむのき": "ألبيزيا زهرة الحرير, شجرة الحرير (شجرة آسيوية جذابة مقببة أو مسطحة القمة لها أوراق ريشية مزدوجة وزهور بأسدية حريرية طويلة)",
 "ねむらす": "نَوَّمَ, أَنَامَ (بكافة معانيه)\nمثال: لم أستطع النوم. / قَتَلَ, قتل (تعمّد جعله يَمُوتُ، أزهق روحه، أمَاتَه متعمدا؛ الوقتَ: ضيعه بشيء غير ذي فائدة وهو ينتظر أمرا آخر) / قَتْلَة\nمثال: قتل الصياد دبا.",
 "ねむらせる": "نَوَّمَ, أَنَامَ (بكافة معانيه)\nمثال: لم أستطع النوم. / قَتَلَ, قتل (تعمّد جعله يَمُوتُ، أزهق روحه، أمَاتَه متعمدا؛ الوقتَ: ضيعه بشيء غير ذي فائدة وهو ينتظر أمرا آخر) / قَتْلَة\nمثال: قتل الصياد دبا.",
 "ねむり": "نَامَ, رَقَدَ (الإنسان أو الحيوان: رَقَدَ وغَفَا؛ الإنسان أو الحيوان: رَقَدَ وإن لم يغفو) / نَوْم, سِنَة (بكافة معانيه) / نَوْمَة / غَمَص, رَمَص\nمثال: نام في الحافلة. / خمول, ركود (حالة عدم النشاط أو قلة النشاط) / خمول, عطالة (الميل للبقاء غير نشط أو خامل) / جمود, خمول (حالة عدم النشاط)\nمثال: كان عليه التغلب على عطالته والعودة للعمل / مَوْت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي) / وَفَاة / هَلَاك / مَنِيَّة / حِمَام (قضاء الموت وقدره؛ جمع حُمَّة وهو قدر الفراق) / موت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي)\nمثال: لا اخاف الموت .",
 "ねむりぐさ": "ميموزا (مشروب مخلوط يحتوي على الشمبانيا وعصير البرتقال) / ست الحسن, ميموزا (أي من الشجيرات أو الأشجار الاستوائية المختلفة من جنس الميموزا ذات أزهار صفراء عادة وأوراق مركبة) / سنط فضي, ميموزا (شجرة أسترالية دائمة الخضرة ذات لحاء وأوراق صغيرة بيضاء أو فضية وزهور صفراء)",
 "ねむりぐすり": "مُخَدِّر",
 "ねむりこむ": "غَلَّبَ النُعَاس, نَامَ (قَهَرَ واِعْتَزَّ عليه واِمْتَنَع)",
 "ねむりにおちる": "غَلَّبَ النُعَاس, نَامَ (قَهَرَ واِعْتَزَّ عليه واِمْتَنَع)",
 "ねむりにつく": "غَلَّبَ النُعَاس, نَامَ (قَهَرَ واِعْتَزَّ عليه واِمْتَنَع)",
 "ねむりひめ": "الْجَمِيلَة الْنَائِمَة",
 "ねむりびょう": "التهاب الدماغ السباتي, مرض النوم (التهاب دماغ كان وبائياً بين عامي 1915 و1926؛ تشمل الأعراض شلل عضلة العين الخارجية وضعف عضلي شديد)",
 "ねむる": "نَامَ, رَقَدَ (الإنسان أو الحيوان: رَقَدَ وغَفَا؛ الإنسان أو الحيوان: رَقَدَ وإن لم يغفو) / نَوْم, سِنَة (بكافة معانيه) / نَوْمَة / غَمَص, رَمَص\nمثال: نام في الحافلة. / مَاتَ (للحَيّ: فقد الحَيَاة. مصدره مَوتَا ومِيتَة؛ للأرض: ليس فيها شيء حَيّ من النبات أو الحيوان أو الإنسان. مصدره مَوَات) / تُوُفِّيَ / زَهْر اَلطَّاوِلَة, زَهْر اَلنَّرْد ((زَهَرَ) الوجهُ والسراجُ والقمرُ يَزْهُرُ زَهْرًا، وزُهُوراً: تلألأ وأشْرق؛ (زَهَرَ) الشيءُ: صَفا لونُه)\nمثال: إعتقدت أنه مات.",
 "ねむれる": "نوم (توقف الوعي وانخفاض معدل الأيض) / سكون, كمون (حالة من الراحة الهادئة وغير النشطة) / رَاقِد, نَائِم (مستلقٍ ورأسه على كفَّيه كأنَّه نائم) / استغراق في النوم (حالة كون الشخص نائماً)",
 "ねむれるもりのびじょ": "الْجَمِيلَة الْنَائِمَة",
 "ねもころ": "نوع (صِنْف؛ في : وحدة تصنيفية أقل من الجنس) / حَنُون, لَطِيف\nمثال: انه نوع من الفطر. / أَلِيف, وَدُود (ذو مصالح أو مودة مشتركة؛ على صداقة راسخة) / حَمِيم, وَثِيق (يتميز بالمعرفة أو الصحبة أو الألفة الوثيقة) / ضَلِيع, مُطَّلِع (على دراية تامة عبر الدراسة أو التجربة) / أَلِيف, حَمِيمِيّ (يُوَفِّرُ جَوًّا دَافِئًا وَوُدِّيًّا وَغَيْر رَسْمِيّ)",
 "ねもと": "قَاعِدَة / قَاعِدَة, مَرْكَز / يُبْنَى عَلَى, يَسْتَنِدُ إِلَى / شائع / منخفض, فاسق / دنيء / جَذْر, جدر (جِذْرُ ٱلشَّيْءِ هُوَ: أَصْلُهُ؛ في : جذر العدد النوني هو عدد ما إذا رفعناه لقوة ما أعطانا العدد الأصلي) / جَذْر (جِذْرُ ٱلشَّيْءِ هُوَ: أَصْلُهُ؛ في : جذر العدد النوني هو عدد ما إذا رفعناه لقوة ما أعطانا العدد الأصلي) / أَصْل (جعله أصيلًا أو ثابت الجذور؛ أي عَمَّق وأحكم أصوله؛ نسب شيئًا إلى أصله أو وضّح جذوره)\nمثال: أحسب جذر خمسة بالآلة الحاسبة.",
 "ねもの": "خضراوات جذرية (أي من الجذور أو الدرنات الصالحة للأكل اللحمية المختلفة تحت الأرض)",
 "ねものがたり": "حديث الوسادة (محادثة حميمة بين العشاق (تحدث عادة في السرير)) / قِصَّةٌ قَبْلَ النَوْمِ",
 "ねもはもない": "لَا أَسَاس لَه, وَاهٍ (بدون أساس في العقل أو الواقع)",
 "ねや": "مَخْدَع, غُرْفَةُ نَوْم / رأس السهم, نصل (الرأس المدبب أو الطرف الضارب للسهم)",
 "ねやごと": "جِمَاع, مُجَامَعَة (الموافقة والمساعدة في أي شيء كان؛ الشيء: جمعه)\nمثال: توم قائد جماعة أنونيموس.",
 "ねやす": "رَخِيص",
 "ねらい": "هَدَف (جاء إلى الهَدَف؛ ارتفع عن الأرض)\nمثال: لقد أخطأ الهدف.",
 "ねらいうち": "رِمَايَة",
 "ねらいどころ": "دَرِيئَة, نِيشَان / هَدَف, مَرْمًى (جاء إلى الهَدَف؛ ارتفع عن الأرض) / يَسْتَهْدِفُ\nمثال: لقد أخطأ الهدف.",
 "ねらいめ": "دَرِيئَة, نِيشَان / هَدَف, مَرْمًى (جاء إلى الهَدَف؛ ارتفع عن الأرض) / يَسْتَهْدِفُ\nمثال: لقد أخطأ الهدف.",
 "ねらい撃ち": "رِمَايَة",
 "ねらい目": "دَرِيئَة, نِيشَان / هَدَف, مَرْمًى (جاء إلى الهَدَف؛ ارتفع عن الأرض) / يَسْتَهْدِفُ\nمثال: لقد أخطأ الهدف.",
 "ねり": "اِعْتِجَان / أَلْصَقَ",
 "ねりあげる": "بُولَنْدِيّ / لَمَّعَ (لمع أي أصدر ضَوْءً أو عَكَسَهُ) / صَقَل",
 "ねりあるく": "اِسْتِعْرَاض, مَوْكِب",
 "ねりかえす": "ريمكس, ريميكس",
 "ねりこ": "عَجِين, عَجِينَة",
 "ねりこう": "قرص طبي محلى",
 "ねりつち": "أَلْصَقَ",
 "ねりなおす": "تنقيح, مراجعة (فعل إعادة كتابة شيء ما)",
 "ねりはみがき": "مَعْجُون الأَسْنَان",
 "ねりもの": "تقدم, زحف (فعل التحرك للأمام (نحو هدف)) / مَسِيرَة, مَوْكِب (العمل الجماعي لمجموعة من الناس أو الحيوانات أو المركبات التي تتحرك للأمام في تشكيل منتظم إلى حد ما) / انبثاق, فيض ((اللاهوت) انبثاق الروح القدس في العنصرة)\nمثال: كانت المواكب محظورة",
 "ねり粉": "عَجِين, عَجِينَة",
 "ねる": "نَامَ, رَقَدَ (الإنسان أو الحيوان: رَقَدَ وغَفَا؛ الإنسان أو الحيوان: رَقَدَ وإن لم يغفو) / نَوْم, سِنَة (بكافة معانيه) / نَوْمَة / غَمَص, رَمَص\nمثال: نام في الحافلة. / اِسْتَلْقَى (وَضَعَ ظَهْرَهُ عَلَى سَطْحٍ كَالسَّرِيرِ والأَرْضِ للنوم أو الاستراحة) / اِضْطَجَعَ\nمثال: استلقى على السرير. / خَمَرَ (شَرَابُ الْعِنَبِ إِذَا اخْتَمَرَ؛ كُلُّ مُسْكِرٍ مُخَامِرٍ لِلْعَقْلِ، إِذَا كَانَ شَرَاباً كُحُولِيّاً أَوْ غَيْرَهُ)\nمثال: أنت تشرب الخمر. / عَجَنَ, دَلَكَ (عَجَنْتُ، أَعْجُنُ، اُعْجُنْ، مصدر عَجْنٌ، عجن فلان الدقيق، أي خلطه بالماء و لاَكَهُ بيد أو آلة وعَجَنَ فلانٌ: عَجْنًا: نهضَ معتمدا بيديه على الأرض…)\nمثال: واصل زيري العجن. / بُولَنْدِيّ / لَمَّعَ (لمع أي أصدر ضَوْءً أو عَكَسَهُ) / صَقَل / ذَيْل (ذَيَّلَ (ذيله): جعل له ذيلا؛ (ذَيَّلَ) أطال ذيله وطوله. ويقال ذيل كتابه أو كلامه: أردفه بكلام كالتتمة له) / قَافِلَة (مؤنث القافل؛ الراجعة؛ جماعة من الناس تسير معًا مع أمتعتها وركوبها في سفر قافلين كانوا أو خارجين. سميّت كذلك تفائلا برجوعها) / تَدَرَّبَ, تَمَرَّنَ / دَرَّبَ, درب (الدَّرْبُ: كُلُّ طريقٍ يصلُ بين مكانَيْن. يقال: مَنْ سار على الدَّرب وصل : معناه أنّ المهارة تكتسبُ بالمِران؛ الدَّرْبُ: المَضيقُ في الجبال الْمَضْيَقُ فِي الجَبَلِ) / درب, أهل (الدَّرْبُ: كُلُّ طريقٍ يصلُ بين مكانَيْن. يقال: مَنْ سار على الدَّرب وصل : معناه أنّ المهارة تكتسبُ بالمِران؛ الدَّرْبُ: المَضيقُ في الجبال الْمَضْيَقُ فِي الجَبَلِ)\nمثال: للبقرة ذيل طويل. / بَرِيق / حدة المزاج, سرعة الغضب (الميل لإظهار غضب غير منضبط) / صلابة, متانة (مرونة وصلابة جسم معدني؛ قدرته على امتصاص طاقة كبيرة قبل التشقق) / فورة غضب, هيجان (نوبة مفاجئة من الغضب) / مزاج (حالة شعورية مميزة (عادة أو مؤقتة نسبياً))\nمثال: كانت حدة مزاجه معروفة لجميع موظفيه / اِسْتِعْرَاض, مَوْكِب",
 "ねるじかん": "وقت النوم (الوقت الذي تذهب فيه إلى الفراش)",
 "ねわすれる": "اِسْتَغْرَقَ فِي النَّوْم",
 "ねわら": "مِحَفَّة / بَعْثَرَ",
 "ねをあげる": "تَنَازَلَ / تَخَلَّى / اِسْتَسْلَمَ",
 "ねをはる": "هَدَأَ / اِسْتَقَرَّ (فعل مطاوعة لأَقَرَّ بمعنى جعله يثبت ويسكن، أَقْرَرْتُهُ فاسْتَقَرَّ؛ ثبت وقرّ)\nمثال: استقر زيري في خيمته.",
 "ねをもどす": "استحواذ على المرتدة, ريباوند (فعل تأمين حيازة كرة السلة المرتدة بعد تسديدة ضائعة) / ارتداد, رد فعل عكسي (رد فعل لأزمة أو نكسة أو إحباط) / ارتداد, انعكاس (حركة العودة من الارتطام)\nمثال: لا يزال في حالة ارتداد من وفاة زوجته",
 "ねん": "حَاسَّة / إِحْسَاس, شُعُور / مَعْنَى, دَلَالَة / مَوْهِبَة, قُدْرَة طَبِيعِيَّة / حَسَّ (حسّه:أحرقه ، حسسْتُ الشّيء:أحسَسْتُه،حسَسْتُ اللحمَ:جعلته على الجمر،حسَسْتُ النّارَ:رددْتُها بالعصا على خُبْزِ المَلّةِ؛ حَسَّ فلاناً:قتله قتلاً ذريعاً مستأصلاً رأسه.(حسَسْتُ اليهوديََ لما أظهر عداوته لله ودينه))\nمثال: لديهم حس الفكاهة. / رَغِبَ ((رَغُبَ) رُغْبًا، ورَغابةً: اتَّسَع وعظُم؛ يقال: (رَغُبَ) الوادي) / رَغْبَة\nمثال: يمكن لتوم البقاء إن رغب. / اِهْتِمَام, اِنْتِبَاه / صَفّ (سَطْر مستقيم؛ مستوى تعليمي)\nمثال: صف كليتي وقلبي‎.",
 "ねんいり": "حَذِر (حذِر الشّخصُ: تيقّظ واستعدّ وتأهّب وتنبّه؛ حذِر الأمرَ: كَتَمَه وأخفاه) / دَقِيق (ضد الغَلِيْظ، الرَفِيْع الرَقِيْق؛ صغير الحجم جدا)\nمثال: قد بحذر من فضلك.",
 "ねんいれ": "اِهْتِمَام / عِنَايَة, رِعَايَة / اِهْتَمَّ بِـ",
 "ねんえき": "مُخَاط, نُخَاعَة",
 "ねんえきさいきん": "بكتيريا مخاطية, ميكسوبكتيريا (بكتيريا تشكل مستعمرات في مادة لزجة تنتجها ذاتياً؛ تعيش في التربة الرطبة أو المواد النباتية المتحللة أو فضلات الحيوانات)",
 "ねんえきさん": "حمض الميوسيك (أصبح حامضًا، تغير الطعم إلى الحموضة؛ ارتفعت نسبة الحموضة في شيء ما، كما في الطعام أو السوائل)\nمثال: رمى ياني الحمض على وجه سكورة.",
 "ねんえきしゅ": "ورم مخاطي (ورم حميد في النسيج الضام يحتوي على مادة تشبه الهلام)",
 "ねんえきすいしゅ": "وذمة مخاطية (قصور الغدة الدرقية يتميز بجفاف الجلد وتورمات حول الشفتين والأنف بالإضافة إلى التدهور العقلي)",
 "ねんおし": "منبه للذاكرة, مُذكّر (تجربة تجعلك تتذكر شيئاً ما) / تَذْكِير (رسالة تساعدك على تذكر شيء ما) / مُذكِّر, مُنذِر (شخص يقدم تحذيراً لتجنب وقوع خطأ)\nمثال: تجاهل تذكيرات زوجته",
 "ねんかい": "مُؤْتَمَر"
}
