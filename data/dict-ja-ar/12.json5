 "にゅうじき": "رضاعة, طفولة مبكرة (أبكر مراحل عدم النضج) / طفولة مبكرة, مهد (المرحلة المبكرة من النمو أو التطور)",
 "にゅうじしぼうりつ": "مُعَدَّل وَفَيَات الرُّضَّع (معدل الوفيات خلال السنة الأولى من الحياة)",
 "にゅうじゃく": "ضَعِيف / اَلنِّرْفَانَا",
 "にゅうじゅう": "حَلِيب (هو اللَبَن المَحْلُوْب، أو ما لم يتغير طعمه. أصل التسمية؛ هو ما لم يَرُوْب واللَبَن هو ما رَابَ) / لَبَن (سَقَاهُ اللَبَن؛ أكل كثيرا) / حَلَبَ (الشاةَ أو البقرةَ أو الناقةَ: استخرج ما في ضرعها من لبن؛ فلانٌ للرجل: أي حَلَب ماشية الرجل نيابة عنه)\nمثال: كنت أشرب الحليب",
 "にゅうじょう": "أَبْيَض مُعْتِم, حَلِيبِيّ (يُشبه الحليب في لونه الأبيض غير الصافي) / دُخُول / مَدْخَل / مَوْت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي) / وَفَاة / هَلَاك / مَنِيَّة / حِمَام (قضاء الموت وقدره؛ جمع حُمَّة وهو قدر الفراق) / موت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي)\nمثال: لا اخاف الموت .",
 "にゅうじょうえき": "طلاء اللاتكس (طلاء مائي يحتوي على مادة رابطة من اللاتكس) / لاتكس, لثى (إفراز حليبي من بعض النباتات يتخثر عند تعرضه للهواء)",
 "にゅうじょうぐち": "دُخُول / مَدْخَل",
 "にゅうじょうしゃ": "زَائِر / زَائِر, سَائِح",
 "にゅうじょうりょう": "تذكرة الدخول, رسم الدخول (الرسم المفروض للدخول)",
 "にゅうせい": "شِرْش, مَاء الْجُبْن",
 "にゅうせいひん": "منتجات الألبان (الحليب والزبدة والجبن)",
 "にゅうせん": "غدد ثديية / انتصار, فوز (النجاح بعد صعوبة كبيرة) / أَخَّاذ, خَلَّاب (بالغ الجاذبيّة؛ يستولي على الاهتمام) / فَائِز, مُنْتَصِر (حقق الفوز أو الانتصار)\nمثال: الفوز ليس كل شيء",
 "にゅうせんえん": "التهاب الثدي (التهاب الثدي (أو الضرع))",
 "にゅうせんしょう": "اعتلال الثدي (أي حالة مرضية تصيب الثدي)",
 "にゅうたい": "تَجَنُّد, تَطَوُّع (فعل التطوع (كما في الخدمة العسكرية)) / فترة تجنيد, فترة خدمة (فترة زمنية تقضى في الخدمة العسكرية)",
 "にゅうだく": "مُسْتَحْلَب",
 "にゅうだくえき": "مُسْتَحْلَب",
 "にゅうだん": "اتصال, ضم (عملية جعل شيئين متلامسين (خاصة للتواصل))\nمثال: تشابك الأيدي حول الطاولة",
 "にゅうっと": "فَجْأَةً",
 "にゅうとう": "لَاكْتُوز / حَلَمَة",
 "にゅうとうしゅ": "ورم حليمي (ورم ظهاري حميد يشكل كتلة مستديرة)",
 "にゅうとうふたいしょう": "عدم تحمل اللاكتوز (اضطراب خلقي يتمثل في عدم القدرة على هضم الحليب ومنتجاته)",
 "にゅうどう": "كَاهِن, قِسِّيس / أَصْلَع (يفتقر إلى الشعر على كل أو معظم فروة الرأس)",
 "にゅうどうぐも": "ركام مزني, سحابة رعدية (سحابة داكنة ذات امتداد عمودي كبير مشحونة بالكهرباء؛ ترتبط بالعواصف الرعدية)",
 "にゅうねん": "حَذِر (حذِر الشّخصُ: تيقّظ واستعدّ وتأهّب وتنبّه؛ حذِر الأمرَ: كَتَمَه وأخفاه) / دَقِيق (ضد الغَلِيْظ، الرَفِيْع الرَقِيْق؛ صغير الحجم جدا)\nمثال: قد بحذر من فضلك.",
 "にゅうはくしょく": "لَبَنِيّ, شِيرْبَام",
 "にゅうはくガラス": "زجاج أوبال, زجاج حليبي (زجاج أبيض حليبي نصف شفاف أو معتم)",
 "にゅうはち": "مِلَاط / مِهْرَاس, هَاوُن / هَاوُن, مِدْفَعُ الهَاوُن / هَاوُن",
 "にゅうばち": "مِلَاط / مِهْرَاس, هَاوُن / هَاوُن, مِدْفَعُ الهَاوُن / هَاوُن",
 "にゅうひ": "صَرْف, مَصْرُوف (بمعنى أبْعَدَ عن القَصْد أو الغَايَة أو محل الاهتمام؛ بمعنى اَنْفَقَ المَال وبمعنى الرَدّ والمَنْع)\nمثال: أيمكنك صرف خمسين؟",
 "にゅうび": "كيلوس (سائل حليبي يتكون من اللمف والدهون المستحلبة؛ يتكون في الأمعاء الدقيقة أثناء هضم الدهون المبتلعة)",
 "にゅうぼ": "ظِئْر, دَايَة (العاطفة على غير ولدها المرضعة له من الناس والإبل وغيرها. الذكر والأنثى في ذلك سواء)",
 "にゅうぼう": "زَوْجَة, اِمْرَأَة / اِمْرَأَة (أُنْثَى الْإِنْسَانِ الْبَالِغَةُ؛ زَوْجَةٌ)\nمثال: أنا امرأة قوية. / مِدَقَّة, يَد / ثَدْي, بز / صَدْر (الأمر: حدث ووقع وتقرّر؛ عن المكان: رجع وانصرف)\nمثال: تلقى ياني طلقة في الصدر.",
 "にゅうぼうえん": "التهاب الثدي (التهاب الثدي (أو الضرع))",
 "にゅうぼうさつえい": "تصوير الثدي بالأشعة (إجراء تشخيصي للكشف عن أورام الثدي باستخدام الأشعة السينية)",
 "にゅうぼうせつじょ": "استئصال الثدي (إزالة جراحية للثدي لإزالة ورم خبيث)",
