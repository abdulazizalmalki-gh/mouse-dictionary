 "とでもない": "لَا يَخْطُرُ عَلَى الْبَالِ (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر…)\nمثال: لا أحب المدرسة.",
 "とでも言うよう": "كَأَنَّ, كَأَنَّمَا (يفيد التشبيه)\nمثال: كأن هذه السيارة له.",
 "とと": "كرة الريشة (أداة في لعبة الريشة الطائرة تتكون من كرة من الفلين أو المطاط مع تاج من الريش) / أَب, وَالِد (الوَالِد و/أو المُرَبِّي، ويُطلق أيضًا على الجَدّ والعَمّ وإن علوا؛ أبو الشّيء…)\nمثال: الأب في الغرفة.",
 "ととう": "متآمر (عضو في مؤامرة)",
 "ととのえ": "تَحْضِير, إِعْدَاد",
 "ととのえる": "رَتَّبَ (رتَّبْته ترتيباً:ثَبَّتَه؛ رتّب الشّيء:نَسَّقَه ونَظَّمَه ووضعه في موضعه)\nمثال: رتب فاضل غرفتة. / جَهَّزَ, حَضَّرَ (جَهاز العَرُوس وَالْمَيِّتِ وجِهازهما: مَا يَحْتَاجَانِ إِليه؛ جَهَّزَه…)\nمثال: جهز زيري حقائبه. / ضَبَطَ",
 "ととのった": "حَسَنُ التَّنْظِيمِ, مُرَتَّبٌ (منظم ومرتب ترتيباً جيداً)",
 "とともに": "بشكل مشترك, جماعياً (بالاشتراك مع؛ مجتمعين)\nمثال: رواتبنا مجتمعة لا تستطيع دفع ثمن الضرر",
 "とど": "أسد البحر ستيلر (أكبر أسود البحر؛ يعيش في شمال المحيط الهادئ) / أخيراً, في الختام (كنتيجة نهائية لتتابع أو عملية)\nمثال: في النهاية كان عليه الاستسلام",
 "とどうけん": "مَبْنَى الْوِلَايَة (كل ما بُنِيَ؛ ما يُبْنى على أرضٍ محاطا بالجُدْرَان ومغطى بسَقْف. (تخصيص))\nمثال: دخل توم المبنى.",
 "とどうふけん": "مَبْنَى الْوِلَايَة (كل ما بُنِيَ؛ ما يُبْنى على أرضٍ محاطا بالجُدْرَان ومغطى بسَقْف. (تخصيص))\nمثال: دخل توم المبنى.",
 "とどく": "بَلَغَ / وَصَلَ (ضَمَّ وَلَأَمَ. (مصدره وَصْل وصِلَة)؛ بَلَغَ الشيءَ، أَدْرَكَه. (يتعدى بإلى)…)\nمثال: وصل السيد باكر. / ضَرَرٌ",
 "とどけ": "وَصَفَ, أَبْلَغَ\nمثال: أبلغ توم تحياتي.",
 "とどけいで": "وَصَفَ, أَبْلَغَ\nمثال: أبلغ توم تحياتي.",
 "とどけいででんせんびょう": "مَرَض مُعْدٍ (أصابه مرضٌ أو علّة أو سَقَم)\nمثال: هذا المرض قلبي.",
 "とどけがき": "وَصَفَ, أَبْلَغَ\nمثال: أبلغ توم تحياتي.",
 "とどけさき": "وِجْهَة, وُجْهَة",
 "とどけしょ": "وَصَفَ, أَبْلَغَ\nمثال: أبلغ توم تحياتي.",
 "とどけずみ": "مُبَلَّغ عَنْه, مُقَرَّر (تم جعله معروفاً أو التحدث عنه؛ خاصة تقديمه في حساب رسمي)\nمثال: رأيه المبلغ عنه (المنقول)",
 "とどけで": "وَصَفَ, أَبْلَغَ\nمثال: أبلغ توم تحياتي.",
 "とどけでる": "وَصَفَ, أَبْلَغَ\nمثال: أبلغ توم تحياتي.",
 "とどけもの": "حَالِيّ, حَاضِر\nمثال: أنا موجود لوحدي",
 "とどける": "نَقَلَ / وَصَفَ, أَبْلَغَ\nمثال: أبلغ توم تحياتي.",
 "とどこおり": "رُكُود",
 "とどこおりなく": "بسلاسة (بدون مشاكل أو صعوبات)\nمثال: نفذ الخطط بسرعة وسلاسة",
 "とどのつまり": "أخيراً, في الختام (كنتيجة نهائية لتتابع أو عملية)\nمثال: في النهاية كان عليه الاستسلام",
 "とどまる": "بَاقِي (الباقي : اسم من أسماء الله تعالى ومعناه : المستأثر بالبقاء والدّوام ، وهو نتيجة…)\nمثال: الباقي ليس مهم.",
 "とどめなく": "إِلى مَا لَا نِهَايَة, بِلَا نِهَايَة (الاستمرار للأبد دون توقف)\nمثال: هناك احتمالات لا حصر لها",
 "とどめる": "وَقَفَ, تَوَقَّفَ (قَامَ، اِنْتَصَبَ، نَهَضَ؛ ثَبَتَ)\nمثال: وقف وراء الباب. / دَبُّوس / حَدّ (مُنْتَهى الشيءِ؛ الْفَصْلُ بَيْنَ الشَّيْئَيْنِ لِئَلَّا يَخْتَلِطَ أَحدهما…)\nمثال: أعرفها إلى حد ما. / تَسْجِيل, مُدَوَّنَة\nمثال: سجل سامي وصوله.",
 "とどろ": "بشدة, للغاية (بدرجة قصوى (تستخدم غالباً لوصف السُكر))\nمثال: ثمل بشدة",
 "とどろかす": "فَعَلَ, صَنَعَ (عَمِلَ وصَنَعَ، بعلم أو بدون علم، عن قصد أو دون قصد)\nمثال: ماذا فعل للحمي؟ / خَفَقَ (الجذر يعبر عن الحركة والاضطراب الخفيف الذي ينشأ عن الرياح أو القلوب أو الرايات…)",
 "とどろき": "أَنَّ (يفيد التوكيد)\nمثال: كيف لي أن أعرف؟ / ضَرْب (معروف، وهو اللطم أو الدق أو الصكّ و ما أشبه؛ النَوْع أو الصنف أو المثال)\nمثال: ضرب سامي زوجته.",
 "とどろきわたる": "أَنَّ (يفيد التوكيد)\nمثال: كيف لي أن أعرف؟",
 "とどろく": "أَنَّ (يفيد التوكيد)\nمثال: كيف لي أن أعرف؟ / بَاوْنْد",
 "となえ": "اِسْم (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه…)\nمثال: ما اسم حصان توم؟",
 "となえる": "تَلَا (قَرَأَ، نحو: تَلُوتُ القرآن تلاوةً أي قرأته؛ اتّبَعَ، نحو: تلا الكتاب والسنة…) / بَكَى, عَيَّط (دَمَعَتْ عَيناهُ حزنا؛ بكى الْمَيِّت: رثاه)\nمثال: بكى زيري كثيرا. / محامي, محامية / دَعَا, نَادَى (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه)\nمثال: دعا ثلاميذه الاثني عشر",
 "となかい": "رَنَة",
 "となり": "قَادِم\nمثال: زيري بجانب الحوض.",
 "となりきんじょ": "جار, مجاور (جسم قريب من نفس النوع)\nمثال: فورت وورث جارة لدالاس",
 "となりぐみ": "صَغِير المِقْيَاس (مبنيّ أو مرسوم على نطاق صغير)",
 "となる": "صَارَ, أَصْبَحَ (انتقل من حال إلى أخرى. (فعل ناقص))\nمثال: صار \"توم\" منعزلا تماما. / جار, مجاور (جسم قريب من نفس النوع)\nمثال: فورت وورث جارة لدالاس",
 "となると": "فِي ذَلِك, فِي ذَلِك المَكَان ((رسمي) في أو داخل ذلك الشيء أو المكان)\nمثال: يمكنهم أن يقرؤوا في ذلك ما هي خططنا",
 "とに": "مُبَاغِت, مُفَاجِئ",
 "とにかく": "عَلَى كُلِّ حَال, على كل حال (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال. / حَقًّا (حَقَا (حقاه) حقوا: أصاب حقوه، يقال ضربه فحقاه؛ (حَقَا)الشيء فلانا: بلغ حقوه…)\nمثال: هو اغضبني حقا .",
 "とにつく": "نَجْمَة, اِبْتِدَاء\nمثال: بدأ سامي يتكلم.",
 "とにもかくにも": "بأي حال, على أي حال (تستخدم للإشارة إلى أن بياناً يشرح أو يدعم بياناً سابقاً)\nمثال: على أي حال، هو ميت الآن",
 "とにやすんずる": "هَدَأَ\nمثال: استقر زيري في خيمته.",
 "とね": "كَاهِن, قِسِّيس",
 "とねりこばのかえで": "قيقب مانيتوبا, قيقب مراني الأوراق (شجرة ظل شائعة في شرق ووسط الولايات المتحدة)",
 "とねりこ葉の楓": "قيقب مانيتوبا, قيقب مراني الأوراق (شجرة ظل شائعة في شرق ووسط الولايات المتحدة)",
 "との": "إقطاعي, سيد إقطاعي (رجل ذو رتبة في النظام القديم) / قَصْر (ضد الطول؛ غير تام، غير كامل)\nمثال: لقد قصر الخطاب.",
 "とのかた": "نَاس (اسم للجمع من بني آدم واحده إِنْسَان أو إِنْس)\nمثال: ضحك الناس عليه. / حمام الرجال (مرحاض عام للرجال)",
 "とのがた": "نَاس (اسم للجمع من بني آدم واحده إِنْسَان أو إِنْس)\nمثال: ضحك الناس عليه. / حمام الرجال (مرحاض عام للرجال)",
 "とのさま": "نَبِيل (اَلذَّكِيُّ؛ اَلنَّجِيبُ)\nمثال: إنها امرأة نبيلة. / إقطاعي, سيد إقطاعي (رجل ذو رتبة في النظام القديم)",
 "とのさまげい": "الهواية, مبدأ الهواية (القناعة بوجوب ممارسة الرياضة كهواية (للمتعة) وليس من أجل المال)",
 "とのさまばった": "جراد مهاجر (جراد من العالم القديم يسافر في أسراب ضخمة يجرد مساحات واسعة من الغطاء النباتي)",
 "とのたち": "نُبْل, نَبَالَة / زَائِر",
 "とのちゃ": "بني داكن, بني محمر (درجة من البني مع مسحة من الأحمر)",
 "とのばら": "نُبْل, نَبَالَة / إِنْسَان, نَاس (كَائِن بَشَرِيّ؛ سَوَاد العَيْن)\nمثال: أنا إنسان صادق.",
 "とは": "مَعَ (يفيد الاجتماع والمصاحبة؛ مكان الاجتماع)\nمثال: جئت مع أصدقائي.",
 "とはい": "وَضَع (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه)\nمثال: لقد أزمت الوضع.",
 "とはいえ": "رَغْم أَنّ ((رَغَمَ) رَغْمًا، ومَرْغَمًا، ومَرْغَمَةً: ذَلَّ؛ (رَغَمَ) ذل عن كَرْه. يقال…)\nمثال: إنه سعيد رغم فقره.",
 "とはかぎらない": "هُنَاكَ, يُوجَدُ",
 "とはべつに": "إِضَافَةً عَلى ذٰلِكَ",
 "とはもうせ": "رَغْم أَنّ ((رَغَمَ) رَغْمًا، ومَرْغَمًا، ومَرْغَمَةً: ذَلَّ؛ (رَغَمَ) ذل عن كَرْه. يقال…)\nمثال: إنه سعيد رغم فقره.",
 "とはん": "تسلق (الصعود بواسطة سلم أو ما شابه)",
 "とは別に": "إِضَافَةً عَلى ذٰلِكَ",
 "とは申せ": "رَغْم أَنّ ((رَغَمَ) رَغْمًا، ومَرْغَمًا، ومَرْغَمَةً: ذَلَّ؛ (رَغَمَ) ذل عن كَرْه. يقال…)\nمثال: إنه سعيد رغم فقره.",
 "とは言え": "رَغْم أَنّ ((رَغَمَ) رَغْمًا، ومَرْغَمًا، ومَرْغَمَةً: ذَلَّ؛ (رَغَمَ) ذل عن كَرْه. يقال…)\nمثال: إنه سعيد رغم فقره.",
 "とは限らない": "هُنَاكَ, يُوجَدُ",
 "とば": "بيت قمار, وكر قمار (مبنى عام يمكن فيه لعب مجموعة متنوعة من ألعاب الحظ (يُدار كعمل تجاري))",
 "とばく": "قِمَار, مُقَامَرَة",
 "とばくし": "مُقَامِر",
 "とばくじょう": "نَادِي الْقِمَار",
 "とばくだい": "طاولة الألعاب, طاولة القمار (طاولة تستخدم للمقامرة؛ قد تكون مجهزة بلوحة ألعاب وفتحات للرقائق)",
 "とばくち": "دُخُول / بِدَايَة (في بِدَايَة الأمْرِ كانَ مُهَذَّباً : فِي أوّلِهِ؛ البِدَايَة والنِّهاية:…)\nمثال: هذه بداية جيدة.",
 "とばしり": "عَدَّاء",
 "とばしる": "طفرة, فورة (زيادة قوية مفاجئة)\nمثال: حفزت طفرة من المضاربة",
 "とばす": "قَطْرَة\nمثال: هذه هي نقطة ضعفه. / عدو (مشية سريعة للحصان؛ خطوة ثنائية الضربات تكون خلالها الأرجل الأربع مرتفعة عن…) / مرذاذ (موزع يحول السائل (مثل العطر) إلى رذاذ ناعم)\nمثال: رشقة من الرصاص / نَشَرَ (بَسَطَ، فَرَّقَ، نَشَرَ الشيءَ: جعله منتشراً، مثل نشر الأخبار أو نشر كتاب…)\nمثال: نشر توم الغسيل.",
 "とばっちり": "رش, طرطشة (فعل نثر الماء بشكل عشوائي)\nمثال: أعطت قبعتها الحمراء ملابسها لطخة من الألوان / ابن غير شرعي, نغل (النسل غير الشرعي لأبوين غير متزوجين)",
 "とばり": "سِتَارَة (ما يُسدل على أبواب ونوافذ المباني والمَرْكَبَات وغيرها رغبةً في الخُصُوصِيَّة…) / حِجَاب, خِمَار (الغطاء أو الساتر؛ يُطلق مجازا على لباس المرأة الذي يستر جميع جسمها)\nمثال: ارتدت أمها الحجاب.",
 "とばん": "سَبُّورَة, لَوْح",
 "とば口": "دُخُول / بِدَايَة (في بِدَايَة الأمْرِ كانَ مُهَذَّباً : فِي أوّلِهِ؛ البِدَايَة والنِّهاية:…)\nمثال: هذه بداية جيدة.",
 "とひ": "إسراف, تبديد (نشاط غير مجدٍ أو غير مربح؛ استخدام أو إنفاق أو استهلاك بلا تفكير أو بإهمال)\nمثال: إذا لم يحقق الجهد أي مكسب تعويضي فهو هدر",
 "とひと": "ريفيون, قرويون (الناس الذين نشأوا أو يعيشون في بيئة ريفية)",
 "とひとま": "ريفيون, قرويون (الناس الذين نشأوا أو يعيشون في بيئة ريفية)",
 "とび": "حدأة سوداء (حدأة داكنة من العالم القديم تتغذى بشكل رئيسي على الجيف) / عامل بناء (عامل ماهر في بناء المكاتب أو المساكن وغيرها) / مِحْراك النار (قضيب معدني بمقبض؛ يستخدم لتحريك النار) / بني داكن, بني محمر (درجة من البني مع مسحة من الأحمر) / طيران (حالة السفر جواً)\nمثال: كان الطيران لا يزال مغامرة مثيرة بالنسبة له / صِفْر, ٠ (الخَالِي كأنه تَصْفِر فيه الرِيح. ويقال أيضا صَفْر وصُفْر؛ في : هي عَدَد قيمته…) / سمك طائر (أسماك بحرية استوائية لها زعانف مكبرة تشبه الأجنحة تُستخدم للطيران الانزلاقي…) / قَفَزَ (وَثَبَ أو طَفَرَ. الفرق بينهم أن الوَثْب يكون من وضع الرَكْض أو الحركة…)\nمثال: قفز من النافذة.",
 "とびあがる": "خَلَعَ (نَزَعَ، أَزَالَ إلا أنَّ في الخَلْعِ مُهْلَةً (لسان العرب)؛ عَزَلَ)\nمثال: خلع سامي حذاءه.",
 "とびいし": "حجر أساس, نقطة انطلاق (أي وسيلة للتقدم)\nمثال: كانت الوظيفة مجرد نقطة انطلاق في طريقه إلى الشهرة والثراء / وثب الحجارة (لعبة يتم فيها نط حجر مسطح على سطح ماء هادئ)",
 "とびいた": "منطلق",
 "とびいり": "فِي اللَّحْظَةِ الأَخِيرَة (قُبَيْل الموعد النهائي مباشرة)",
 "とびいろ": "بني داكن, بني محمر (درجة من البني مع مسحة من الأحمر)",
 "とびうお": "سمك طائر (أسماك بحرية استوائية لها زعانف مكبرة تشبه الأجنحة تُستخدم للطيران الانزلاقي…)",
 "とびうおざ": "سمك طائر (أسماك بحرية استوائية لها زعانف مكبرة تشبه الأجنحة تُستخدم للطيران الانزلاقي…)",
 "とびうおのこ": "سمك طائر (أسماك بحرية استوائية لها زعانف مكبرة تشبه الأجنحة تُستخدم للطيران الانزلاقي…)",
 "とびうお座": "سمك طائر (أسماك بحرية استوائية لها زعانف مكبرة تشبه الأجنحة تُستخدم للطيران الانزلاقي…)",
 "とびかける": "ذُبَابَة, دبان (حشرة صغيرة سوداء اللون معروفة)\nمثال: أمسك بتلك الذبابة.",
 "とびきり": "أَفْضَل / بشكل استثنائي (إلى درجة استثنائية)\nمثال: عمل بشكل جيد استثنائياً",
 "とびぐち": "مِحْراك النار (قضيب معدني بمقبض؛ يستخدم لتحريك النار)",
 "とびけら": "ذباب كاديس, ذبابة القمص (حشرة صغيرة تشبه العثة لها زوجان من الأجنحة الغشائية المشعرة ويرقات مائية)",
 "とびげり": "ركلة إسقاط ((كرة القدم الأمريكية) ركل (كما لهدف ميداني) حيث يتم إسقاط الكرة وركلها لحظة…)",
 "とびこ": "سمك طائر (أسماك بحرية استوائية لها زعانف مكبرة تشبه الأجنحة تُستخدم للطيران الانزلاقي…)",
 "とびこう": "عامل بناء (عامل ماهر في بناء المكاتب أو المساكن وغيرها)",
 "とびこえる": "شَفَّاف / قفزة الضفدع, نط الحبل (لعبة ينحني فيها طفل ويقفز آخر من فوقه)\nمثال: لا تزال الشركة تعتقد أن الرقاقة تمثل قفزة في التكامل وستحقق أرباحاً طائلة",
 "とびこし": "قَفَزَ (وَثَبَ أو طَفَرَ. الفرق بينهم أن الوَثْب يكون من وضع الرَكْض أو الحركة…)\nمثال: قفز من النافذة.",
 "とびこみ": "قَفَزَ (وَثَبَ أو طَفَرَ. الفرق بينهم أن الوَثْب يكون من وضع الرَكْض أو الحركة…)\nمثال: قفز من النافذة.",
 "とびこみえいぎょう": "مِنْ بَابٍ إِلَى بَاب (لا يُغفِل أحدًا؛ يتنقّل من بيت إلى بيت)",
 "とびこみだい": "لوح الغطس (لوح قفز يمكن للسباحين الغطس منه)",
 "とびこむ": "غَاصَ",
 "とびさる": "نَثَرَ, تَفَرَّقَ",
 "とびしょうぎ": "هالما (لعبة لوحية يحاول فيها اللاعبون تحريك قطعهم إلى قواعد خصمهم)",
 "とびしょく": "عامل بناء (عامل ماهر في بناء المكاتب أو المساكن وغيرها) / إِطْفَائِيّ",
 "とびしょくにん": "متسلق الأبراج (شخص يبني أو يصون الهياكل العالية جداً)",
 "とびだしナイフ": "سكين كبس, مِطواة زنبركية (سكين جيب بشفرة تفتح بالزنبرك عند الضغط على زر)",
 "とびだす": "نَفِدَ / ظَهَرَ (مصدر للفعل ظَهَرَ؛ خلاف البَطْن، الجزء الظَاهِر من الشيئ وغير البَاطِن)\nمثال: عنده حقيبة ظهر. / نَتَأَ / تَرَكَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد…)\nمثال: لقد ترك لك هذا.",
 "とびだすえほん": "كتاب مجسم, كتاب منبثق (كتاب (عادة للأطفال) يحتوي على صفحة أو أكثر بحيث يرتفع هيكل ثلاثي الأبعاد عند…)",
 "とびち": "جيب, منطقة مكتنفة (إقليم محاط بأراضٍ أجنبية يختلف عنها ثقافياً)",
 "とびちる": "نَثَرَ, تَفَرَّقَ",
 "とびっきり": "أَفْضَل / بشكل استثنائي (إلى درجة استثنائية)\nمثال: عمل بشكل جيد استثنائياً",
 "とびっこ": "سمك طائر (أسماك بحرية استوائية لها زعانف مكبرة تشبه الأجنحة تُستخدم للطيران الانزلاقي…)",
 "とびっ切り": "أَفْضَل / بشكل استثنائي (إلى درجة استثنائية)\nمثال: عمل بشكل جيد استثنائياً",
 "とびでる": "مَشْرُوع (ما تُجِيزُه السلطة أو القانون أو أي قاعدة، جَائِز، قَانُونِيّ؛ مسعى مؤقت أي شيء…)\nمثال: هذا مشروع عظيم.",
 "とびとかげ": "تنين طائر (أي من عدة سحالي آسيوية استوائية صغيرة قادرة على الانزلاق عن طريق نشر أغشية تشبه…)",
 "とびとび": "متفرق, متقطع (يتكرر في حالات متناثرة وغير منتظمة أو غير متوقعة)\nمثال: مدينة تتعرض لغارات قصف متقطعة",
 "とびどうぐ": "سِلَاح نَارِيّ",
 "とびぬけて": "بامتياز, بشكل بارز (بطريقة بارزة أو إلى درجة بارزة)\nمثال: كانت ناجحة بشكل بارز في مهنتها",
 "とびねずみ": "جَرْبُوع, يَرْبُوع",
 "とびのもの": "إِطْفَائِيّ / عامل بناء (عامل ماهر في بناء المكاتب أو المساكن وغيرها)",
 "とびはぜ": "سمكة الطين, نطاط الطين (توجد في المناطق الساحلية الاستوائية في أفريقيا وآسيا؛ قادرة على التحرك على…)",
 "とびはねる": "نَقْز",
 "とびばこ": "حصان القفز, حصان طويل (حصان جمباز بدون مقابض وبطرف ممدود؛ يستخدم طولياً للقفز)",
 "とびばった": "جَرَادَة",
 "とびむし": "قافزات الذيل (أي من الحشرات البدائية الدقيقة عديمة الأجنحة العديدة التي تمتلك زائدة بطنية…)",
 "とびら": "أَبْوَاب, بَاب / صفحة العنوان (صفحة في كتاب تعرض العنوان والمؤلف والناشر)",
 "とびらえ": "صفحة العنوان المقابلة (رسم توضيحي أمامي يواجه صفحة العنوان في كتاب)",
 "とびらぐち": "باب, فتحة الباب (المدخل (الحيز في الجدار) الذي تدخل أو تخرج منه من غرفة أو مبنى؛ الحيز الذي يمكن…)\nمثال: أطل برأسه من فتحة الباب",
 "とびりょうど": "جيب, منطقة مكتنفة (إقليم محاط بأراضٍ أجنبية يختلف عنها ثقافياً)",
 "とび出る": "مَشْرُوع (ما تُجِيزُه السلطة أو القانون أو أي قاعدة، جَائِز، قَانُونِيّ؛ مسعى مؤقت أي شيء…)\nمثال: هذا مشروع عظيم.",
 "とび口": "مِحْراك النار (قضيب معدني بمقبض؛ يستخدم لتحريك النار)",
 "とび工": "عامل بناء (عامل ماهر في بناء المكاتب أو المساكن وغيرها)",
 "とび職": "عامل بناء (عامل ماهر في بناء المكاتب أو المساكن وغيرها) / إِطْفَائِيّ",
 "とび職人": "متسلق الأبراج (شخص يبني أو يصون الهياكل العالية جداً)",
 "とび色": "بني داكن, بني محمر (درجة من البني مع مسحة من الأحمر)",
 "とふ": "تَطْبِيق\nمثال: هذا الكتاب جديد / تطبيق, طلاء (عمل وضع شيء (على سطح))\nمثال: وصف الطبيب وضعاً موضعياً لليود / رَأْسْمَال, رَأْس مَال",
 "とふぎょ": "إسقلبين (أي من الأسماك العقربية العديدة الشائكة كبيرة الرأس وعديمة القشور عادة ذات أفواه…)",
 "とふく": "سيبوكو, هاراكيري (انتحار شعائري بقر البطن بالسيف؛ كان يمارسه الساموراي في المجتمع الياباني…)",
 "とふけん": "مَبْنَى الْوِلَايَة (كل ما بُنِيَ؛ ما يُبْنى على أرضٍ محاطا بالجُدْرَان ومغطى بسَقْف. (تخصيص))\nمثال: دخل توم المبنى.",
 "とふざい": "دَلُوك",
 "とぶ": "ذُبَابَة, دبان (حشرة صغيرة سوداء اللون معروفة)\nمثال: أمسك بتلك الذبابة. / قَفَزَ (وَثَبَ أو طَفَرَ. الفرق بينهم أن الوَثْب يكون من وضع الرَكْض أو الحركة…)\nمثال: قفز من النافذة. / ترشيش, طرطشة / عَجَلَة\nمثال: أسرع و إلا تأخرت.",
 "とぶつ": "تَقَيَّأَ, قَاءَ / رِهَان, مُرَاهَنَة",
 "とぶとり": "طيور جؤجؤية, طيور طائرة (طيور لها عظام صدر جؤجؤية لربط عضلات الطيران)",
 "とぶらい": "جَنَازَة, دَفْن (مراسم تقام لتشييع وفاة شخص)\nمثال: \"أنا ذاهب إلى جنازة.\" \"من توفي؟\" / تَأْسِيَة / زَارَ (قَصَدَ شخصًا للأنس أو للحاجة)\nمثال: زار سامي مسجدا.",
 "とべ": "آخِر (ضد الأوَّل؛ وهو من يكون ترتيبه بعد الجميع؛ الشيء: مؤخرّه، الجزء الآخير منه)\nمثال: أرني مثالا آخر.",
 "とべないとり": "طيور مسطحة الصدر, نعاميات (طيور لا تطير لها عظام صدر مسطحة تفتقر إلى الجؤجؤ لربط عضلات الطيران: النعام…)",
 "とほ": "مُتَجَسِّد\nمثال: مشي توم مع ماري.",
 "とほう": "طَرِيق, سَبِيل (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من…)\nمثال: أسأل عن الطريق.",
 "とほうもない": "اِسْتِثْنَائِيّ, غَيْرُ عَادِيّ",
 "とほきょうそう": "سباق جري, عدو (سباق يتم الجري فيه على الأقدام)\nمثال: حطمت الرقم القياسي في سباق النصف ميل",
 "とぼける": "تَصَرَّفَ بِغَبَاء",
 "とぼし": "إِشَارَة مُرُور, إِشَارَة ضَوْئِيَّة\nمثال: نسي أن يطفئ النور.",
 "とぼしい": "شَحِيح, ضَئِيل (ناقص في الكمية أو الجودة أو المدى)\nمثال: موارد شحيحة",
 "とぼしき": "فَقْر (بمعنى شقّ وحزّ؛ الشقّ والحزّ؛ الهمّ والحرص، يُجمع جَمْع تَكْسِير على فُقُور)\nمثال: الفقر والفرعنة.",
 "とぼす": "إِشَارَة مُرُور, إِشَارَة ضَوْئِيَّة\nمثال: نسي أن يطفئ النور.",
 "とぼそ": "أَبْوَاب, بَاب",
 "とぼとぼ": "سير شاق (مشي طويل وصعب)",
 "とまく": "دِهَان\nمثال: ما هو لون شعرك؟",
 "とます": "أَثْرَى",
 "とまつ": "دَهَنَ (طلى الشيء بالدهن أو الزيت أو الطيب؛ ضرب بالرفق)\nمثال: توم بدهن غرفته.",
 "とまどい": "اِلْتِبَاس\nمثال: لا داعي لارتباك.",
 "とまり": "وَقَفَ, تَوَقَّفَ (قَامَ، اِنْتَصَبَ، نَهَضَ؛ ثَبَتَ)\nمثال: وقف وراء الباب. / مَكَثَ, بَقِيَ / خَان, اِسْتِرَاحَة (النُزْل أو الفُنْدُق أو اِسْتِرَاحَة المسافرين؛ الحَانُوْت أو الدُكَّان)\nمثال: خان ياني سكورة. / أَنْكُورِيج",
 "とまりきゃく": "ضيف المنزل (ضيف يتم استقباله في منزلك)",
 "とまりぎ": "فرخ (أي من الأسماك العديدة شائكة الزعانف من فصائل مختلفة من رتبة الفرخيات)",
 "とまりこむ": "وَقَفَ, تَوَقَّفَ (قَامَ، اِنْتَصَبَ، نَهَضَ؛ ثَبَتَ)\nمثال: وقف وراء الباب.",
 "とまりちん": "تَعَارِيف, تَعْرِفَة",
 "とまる": "وَقَفَ, تَوَقَّفَ (قَامَ، اِنْتَصَبَ، نَهَضَ؛ ثَبَتَ)\nمثال: وقف وراء الباب.",
 "とまれ": "وَقَفَ, تَوَقَّفَ (قَامَ، اِنْتَصَبَ، نَهَضَ؛ ثَبَتَ)\nمثال: وقف وراء الباب. / عَلَى كُلِّ حَال, على كل حال (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال.",
 "とまれかくまれ": "عَلَى أَيِّ حَالٍ (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال.",
 "とみ": "ثروة, غنى (وفرة من الممتلكات والموارد المادية) / مَوْرِد / يَانَصِيب / مُبَاغِت, مُفَاجِئ",
 "とみに": "فَجْأَةً",
 "とみん": "طُوكْيَوِيّ",
 "とむ": "كَثُر, تَوَفَر (غَلَبَ فِي ٱلْكَثْرَةِ، فَاقَ فِي ٱلْعَدَدِ؛ كاثَرُوهمْ فكثَرُوهمْ: غالَبوهُم…)\nمثال: عندي أصدقاء كثر",
 "とむらい": "جَنَازَة, دَفْن (مراسم تقام لتشييع وفاة شخص)\nمثال: \"أنا ذاهب إلى جنازة.\" \"من توفي؟\" / تَأْسِيَة",
 "とめ": "وَقَفَ, تَوَقَّفَ (قَامَ، اِنْتَصَبَ، نَهَضَ؛ ثَبَتَ)\nمثال: وقف وراء الباب. / فَائِض, مُتَبَقٍّ (لم يُسْتَهْلَك بعد) / خَمْسَة وَأَرْبَعُون (قيمة عددية تساوي \"٥\"؛ الرقم ما بعد \"أَرْبَعَة\" وقبل \"سِتَّة\")\nمثال: رأيت خمسة رجال.",
 "とめおき": "تَوْقِيف",
 "とめおく": "اِعْتَقَلَ (أمسك الأطراف وربطها، بمعنى عَقَلَ؛ أمسك ووضع في السجن أو المَعْقَل)\nمثال: اعتقل لقيادته و هو سكران.",
 "とめおとこ": "مُخبر المراهنات (شخص يبيع النصائح حول المقامرة أو المضاربة (خاصة في سباق الخيل)) / حَكَم, مُحكِّم (شخص يتم اختياره للحكم والبت في قضية متنازع عليها)\nمثال: اعتُبر الناقد حكماً للأدب الحديث",
 "とめかなぐ": "إِبْزِيم (حديدة الحزام)\nمثال: ذهبت لشراء إبزيم.",
 "とめがね": "إمساك, قبضة (فعل الإمساك)\nمثال: أرخى قبضته عن ذراعي",
 "とめぎ": "توجل, مسمار تثبيت (مثبت يتكون من وتد أو مسمار أو قطعة عرضية يتم إدخالها في عروة في نهاية حبل أو…)",
 "とめくぎ": "توجل, مسمار تثبيت (مثبت يتكون من وتد أو مسمار أو قطعة عرضية يتم إدخالها في عروة في نهاية حبل أو…)",
 "とめぐ": "زِلاَج, ضَبَّة",
 "とめだて": "تقييد, كبح (فعل السيطرة عن طريق تقييد شخص ما أو شيء ما)\nمثال: التقييد غير القانوني للتجارة",
 "とめつぎ": "تاج الأسقف (غطاء رأس طقسي يرتديه الأساقفة في المناسبات الرسمية)\nمثال: غطى سطح الشطب بالغراء قبل عمل الوصلة",
 "とめど": "نِهَايَة, غَايَة\nمثال: انتهى أمر زيري.",
 "とめどない": "حَلَقِيّ, لَا نِهَائِيّ (مُتَّصِلُ الأَطْرَافِ بِحَيْثُ يُشَكِّلُ كُلًّا مُتَّصِلًا)",
 "とめどなく": "إِلى مَا لَا نِهَايَة, بِلَا نِهَايَة (الاستمرار للأبد دون توقف)\nمثال: هناك احتمالات لا حصر لها",
 "とめにはいる": "تَدَخَّلَ",
 "とめばさみ": "النسخة النهائية (النسخة المحررة النهائية للفيلم كما وافق عليها المخرج والمنتج)",
 "とめばり": "دَبُّوس",
 "とめやく": "حَكَم, مُحكِّم (شخص يتم اختياره للحكم والبت في قضية متنازع عليها)\nمثال: اعتُبر الناقد حكماً للأدب الحديث",
 "とめる": "وَقَفَ, تَوَقَّفَ (قَامَ، اِنْتَصَبَ، نَهَضَ؛ ثَبَتَ)\nمثال: وقف وراء الباب. / حَدِيقَة (الحَديقَةُ، الرَّوْضَةُ ذاتُ الشجرِ؛ حديقة , العاطل عن العمل في اللهجة العراقية…)\nمثال: ليس لدينا حديقة. / مَنَعَ (حَرَمَ، ضد أَعْطَى؛ كَفَّ عنه وحَمَاه)\nمثال: تساهم جذور أشجار المنغروف في منع حدوث انجراف التربة. / لَاحَظَ / غَلِقَ (ق. (فعل: ثلاثي لازم). غَلِقَ، يَغْلَقُ، مصدر غَلَقٌ؛ غلِقَ يَغلَق، غَلَقًا، فهو…)\nمثال: أعاد زيري غلق الخيمة. / غَنِيّ",
 "とも": "صَاحِب, صَاحِبَة (اَلْمُرَافِق، الْمُلَازِمُ، وَلَا يُقَالُ عُرْفاً إِلَّا لِمَنْ كَثُرَتْ…)\nمثال: من صاحب هذه الأرض؟ / صَدِيق, صَدِيقَة (هو الصَاحِب والخّل الذي بينك وبينه صَدَاقَة)\nمثال: ليس لديه صديقة. / مُصَاحَبَة / صَارِم, مُتَشَدِّد / بشكل مشترك, جماعياً (بالاشتراك مع؛ مجتمعين)\nمثال: رواتبنا مجتمعة لا تستطيع دفع ثمن الضرر / نَفْسَهُ, نَفْسَهَا / كِلَا (بمعنى إنته ولا تفعل، ليست بحاجة إلى جملة كاملة؛ تأتي بمعنى لا الجوابية)\nمثال: انا احب كلا منهما / بِالتَّأْكِيد / بصرف النظر, بغض النظر (على الرغم من كل شيء؛ دون اعتبار للعوائق)\nمثال: واصل العمل بغض النظر عن الصعوبات / أَيْضًا, كَذٰلِكَ / حَسَنًا, بِخَيْر (تقال عند استحسان الفعل أو القول، هَذَا حَسَن)\nمثال: حسنا. أنا موافق.",
 "ともあれ": "بأي حال, على أي حال (تستخدم للإشارة إلى أن بياناً يشرح أو يدعم بياناً سابقاً)\nمثال: على أي حال، هو ميت الآن",
 "ともあれかくもあれ": "عَلَى أَيِّ حَالٍ (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال.",
 "ともうすに": "بِالرَغْم مِن",
 "ともえせん": "قِتَال الكِلَاب (قتال عنيف بين الكلاب (ينظم أحياناً بشكل غير قانوني للترفيه والمقامرة))\nمثال: ضغينة تعود لقتال سياسي شرس بينهما",
 "ともかく": "بأي حال, على أي حال (تستخدم للإشارة إلى أن بياناً يشرح أو يدعم بياناً سابقاً)\nمثال: على أي حال، هو ميت الآن / بِغَضّ النَظَر عَن (البُغْض ضدّ الحبّ ، بغَض جَدُّك:كتعس جدّك،ونعِمَ الله بك عيناً وبغَض بعدوّك…)\nمثال: سأذهب بغض النظر عن مجيئه.",
 "ともかくも": "بأي حال, على أي حال (تستخدم للإشارة إلى أن بياناً يشرح أو يدعم بياناً سابقاً)\nمثال: على أي حال، هو ميت الآن",
 "ともがき": "صَدِيق, صَدِيقَة (هو الصَاحِب والخّل الذي بينك وبينه صَدَاقَة)\nمثال: ليس لديه صديقة.",
 "ともがら": "رَفِيق, رَفِيقَة",
 "ともぐい": "أكل لحوم الجنس الواحد (ممارسة أكل لحم جنسك)",
 "ともこ": "صَدِيق, صَدِيقَة (هو الصَاحِب والخّل الذي بينك وبينه صَدَاقَة)\nمثال: ليس لديه صديقة.",
 "ともざ": "سطح الكوثل (سطح مكشوف جزئي على البنية الفوقية لمؤخرة السفينة)",
 "ともし": "إِشَارَة مُرُور, إِشَارَة ضَوْئِيَّة\nمثال: نسي أن يطفئ النور.",
 "ともしい": "شَحِيح, ضَئِيل (ناقص في الكمية أو الجودة أو المدى)\nمثال: موارد شحيحة",
 "ともしび": "إِشَارَة مُرُور, إِشَارَة ضَوْئِيَّة\nمثال: نسي أن يطفئ النور.",
 "ともす": "إِشَارَة مُرُور, إِشَارَة ضَوْئِيَّة\nمثال: نسي أن يطفئ النور.",
 "ともせん": "سدادة (انسداد يتكون من جسم مصمم لسد حفرة بإحكام)\nمثال: إذا كان شريكي يملك ورقة بستوني حاكمة يمكنني المراهنة بـ بلا حكم",
 "ともぜい": "مُتَرَتِّب, مُصَاحِب (يحدث بالتزامن مع شيء آخر أو نتيجةً له)\nمثال: كان حاضراً دائماً في اجتماعات القسم",
 "ともだち": "صَدِيق, صَدِيقَة (هو الصَاحِب والخّل الذي بينك وبينه صَدَاقَة)\nمثال: ليس لديه صديقة.",
 "ともだちいじょう": "أكثر, مزيد من ((صيغة المقارنة من 'كثير' للمعدود وغير المعدود) محدد كمية يعني أكبر في الحجم أو…)\nمثال: مزيد من الأرض",
 "ともだちいじょうこいびとみまん": "أكثر, مزيد من ((صيغة المقارنة من 'كثير' للمعدود وغير المعدود) محدد كمية يعني أكبر في الحجم أو…)\nمثال: مزيد من الأرض",
 "ともだちさくせん": "الْوِلَايَاتُ الْمُتَّحِدَة",
 "ともだちづきあい": "عَلَاقَة اجْتِمَاعِيَّة (علاقة بين الكائنات الحية (وخاصة بين الناس))",
 "ともつひと": "صَدِيق, صَدِيقَة (هو الصَاحِب والخّل الذي بينك وبينه صَدَاقَة)\nمثال: ليس لديه صديقة.",
 "ともづな": "حبل إرساء ((مصطلح بحري) حبل يثبت جسماً (خاصة القارب) في مكانه)",
 "ともども": "مَعًا, سَوِيًّا",
 "ともどもに": "مَعًا, سَوِيًّا",
 "ともない": "صَاحِب, صَاحِبَة (اَلْمُرَافِق، الْمُلَازِمُ، وَلَا يُقَالُ عُرْفاً إِلَّا لِمَنْ كَثُرَتْ…)\nمثال: من صاحب هذه الأرض؟",
 "ともなう": "رَافَقَ\nمثال: من صاحب هذه الأرض؟",
 "ともなく": "بشكل ما, بطريقة أو بأخرى (بطريقة أو أسلوب غير محدد؛ أو بوسيلة غير محددة)\nمثال: لقد تدبروا الأمر بطريقة ما",
 "ともなしに": "بشكل ما, بطريقة أو بأخرى (بطريقة أو أسلوب غير محدد؛ أو بوسيلة غير محددة)\nمثال: لقد تدبروا الأمر بطريقة ما",
 "ともなり": "رنين, صويت (الجودة التي تضفيها غرف الرنين في الحلق والفم والتجاويف الأنفية على أصوات الكلام…) / تَعَاطُف",
 "ともに": "مَعًا, سَوِيًّا / فِي نَفْس اَلْوَقْت (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي. / كِلَا (بمعنى إنته ولا تفعل، ليست بحاجة إلى جملة كاملة؛ تأتي بمعنى لا الجوابية)\nمثال: انا احب كلا منهما",
 "ともにする": "نَصِيب, حِصَّة\nمثال: لم يصب السهم توم.",
 "とものかい": "جَمْعِيَّة (هَيْئَة أو جهة معينة يجتمع فيها الناس لغَايَة أو هَدَف مشترك لا يستهدف الرِبْح…)\nمثال: أنشؤوا جمعية سينمائية.",
 "ともばら": "قطعة لحم, قطعية لحم (قطعة من اللحم تم قطعها من ذبيحة الحيوان)",
 "ともびと": "صَاحِب, صَاحِبَة (اَلْمُرَافِق، الْمُلَازِمُ، وَلَا يُقَالُ عُرْفاً إِلَّا لِمَنْ كَثُرَتْ…)\nمثال: من صاحب هذه الأرض؟",
 "ともまわり": "بطانة, حاشية (المجموعة التي تتبع وتخدم شخصاً مهماً)",
 "ともらい": "جَنَازَة, دَفْن (مراسم تقام لتشييع وفاة شخص)\nمثال: \"أنا ذاهب إلى جنازة.\" \"من توفي؟\" / تَأْسِيَة",
