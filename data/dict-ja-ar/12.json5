 "にゃーん": "مُوَاء (صَوْت القِطّ) / مَاءَ, تَمَوَّأَ (السائل الشفاف المعروف الذي تنشأ به الحياة، عديم اللون والرائحة والطعم عندما يكون نقيا؛ علميا فِي : جزيئة متكونة من ذرتي هيدروجين مرتبطين بذرة واحدة من الأوكسيجين)\nمثال: أنا أشرب الماء. / قِطّ (حَيْوَان مستأنس من عائلة السَنُّورِيّات، له في اللغة أسماء عديدة تذكر وتؤنث) / قِطَّة (حيوان مستأنس من فصيلة السنوريات) / هِرّ (القطّ؛ صوت الإبل أو دعائها إلى الماء) / هِرَّة (المؤنث من الْهِرّ) / سَنُّور / قطّ (حَيْوَان مستأنس من عائلة السَنُّورِيّات، له في اللغة أسماء عديدة تذكر وتؤنث)\nمثال: أعطنا هذا القط.",
 "にやけ": "أرداف, ألية (الجزء اللحمي من جسم الإنسان الذي يجلس عليه)\nمثال: يستحق ركلة جيدة في مؤخرته",
 "にやける": "ابتسامة (تعبير وجهي يتميز برفع زوايا الفم؛ يظهر عادة السعادة أو التسلية)",
 "にやっ": "بشكل واسع, بمعنى واسع (دون النظر إلى تفاصيل محددة أو استثناءات) / بشكل عريض (بطريقة واسعة)\nمثال: يفسر القانون بشكل واسع",
 "にやっかい": "عائق, مانع (أي عائق يعرقل أو يكون مرهقاً) / ثقل, حمل (اهتمام شاق أو صعب) / رهن, عبء (حق للغير على الممتلكات (مثل حق الحجز أو الرهن العقاري))\nمثال: عبء المسؤولية",
 "にやっとわらう": "إِهْلَاس",
 "にやっと笑う": "إِهْلَاس",
 "にやつく": "إِهْلَاس",
 "にやにや": "ابتسامة (تعبير وجهي يتميز برفع زوايا الفم؛ يظهر عادة السعادة أو التسلية)",
 "にやり": "بشكل ذي مغزى, بشكل معبر (بطريقة ذات معنى؛ بحيث تكون ذات مغزى)\nمثال: نظر إليها بشكل معبر",
 "にゅういき": "دخول (فعل الدخول) / دخول (حركة إلى الداخل أو نحو الباطن)\nمثال: قامت بدخول مهيب",
 "にゅういん": "استشفاء, رعاية في المستشفى (الوضع تحت الرعاية الطبية في المستشفى) / تأمين دخول المستشفى (تأمين يدفع كل أو جزء من نفقات المستشفى للمريض) / استشفاء, تنويم في المستشفى (حالة تلقي العلاج كمريض داخل المستشفى) / إقامة بالمستشفى, استشفاء (فترة زمنية تكون فيها محتجزاً في المستشفى للعلاج)\nمثال: كان يأمل تجنب نفقات الاستشفاء",
 "にゅううん": "هَالَة",
 "にゅうえい": "تَجَنُّد, تَطَوُّع (فعل التطوع (كما في الخدمة العسكرية)) / فترة تجنيد, فترة خدمة (فترة زمنية تقضى في الخدمة العسكرية)",
 "にゅうえき": "طلاء اللاتكس (طلاء مائي يحتوي على مادة رابطة من اللاتكس) / لاتكس, لثى (إفراز حليبي من بعض النباتات يتخثر عند تعرضه للهواء)",
 "にゅうえんしゃ": "مُشَارِك / دَاخِل, وَافِد",
 "にゅうえんりょう": "تذكرة الدخول, رسم الدخول (الرسم المفروض للدخول)",
 "にゅうか": "قبعة المهد (التهاب جلد فروة الرأس الشائع عند الرضع)",
 "にゅうかい": "إدخال, قبول (فعل السماح لشخص بالدخول) / حق الدخول, دخول (الحق في الدخول) / إِقْرَار, اعْتِرَاف (إقرار بصحة شيء ما) / تذكرة الدخول, رسم الدخول (الرسم المفروض للدخول)\nمثال: تم إجراء الجراحة عند إدخاله الثاني إلى العيادة",
 "にゅうかいきん": "تذكرة الدخول, رسم الدخول (الرسم المفروض للدخول)",
 "にゅうかいしゃ": "مُشَارِك / دَاخِل, وَافِد",
 "にゅうかく": "اسْتِدْلَالِيّ (يُعبّر عن استنتاج أو يسبقه) / اسْتِنْتَاجِيّ (يُشبه الاستنتاج أو يعتمد عليه أو يُتوصّل إليه بالاستدلال) / استدلالي, استنتاجي (متعلق بـ أو له طبيعة الاستدلال أو الاستنتاج)\nمثال: الملكة الاستدلالية للعقل",
 "にゅうかざい": "عامل استحلاب, مستحلب (مادة خافضة للتوتر السطحي تعزز تكوين المستحلب)",
 "にゅうかん": "حَبْس, سَجْن (مَنَعَ الشيءَ عن الفعلِ؛ أَمْسَكَ الشيءَ، قَبَضَ عَلَيْهِ)\nمثال: هو,البارحة حرر من الحبس. / شطر, فلق (عملية الفلق أو الشق) / شق الصدر, فلق الصدر (الخط المتشكل من أخدود بين جزأين (خاصة الفاصل بين ثديي المرأة)) / تفلج, تقطع ((علم الأجنة) الانقسام المتكرر للبويضة المخصبة) / انشطار, انقسام (كسر رابطة كيميائية في جزيء مما يؤدي إلى جزيئات أصغر) / إِدْخَال / وُلُوج, نَفَاذ / مَدْخَل, دُخُول / مَدْخَل, مُدْخَل / دَفْتَر, مَدْخَل / قناة لبنية (قناة نباتية تحتوي على اللاتكس)",
 "にゅうかんしゃ": "زَائِر / زَائِر, سَائِح",
 "にゅうかんりょう": "تذكرة الدخول, رسم الدخول (الرسم المفروض للدخول)",
 "にゅうがく": "إدخال, قبول (فعل السماح لشخص بالدخول) / حق الدخول, دخول (الحق في الدخول) / إِقْرَار, اعْتِرَاف (إقرار بصحة شيء ما) / تذكرة الدخول, رسم الدخول (الرسم المفروض للدخول)\nمثال: تم إجراء الجراحة عند إدخاله الثاني إلى العيادة",
 "にゅうがくこうさ": "امتحان القبول (امتحان لتحديد استعداد المرشح لدورة دراسية)",
 "にゅうがくしけん": "امتحان القبول (امتحان لتحديد استعداد المرشح لدورة دراسية)",
 "にゅうがん": "سَرَطَان اَلثَّدْي",
 "にゅうきょ": "إشغال, احتلال (فعل شغل أو الاستيلاء على مبنى)\nمثال: إشغال مبنى بدون شهادة إشغال غير قانوني",
 "にゅうきょう": "لَكْمَة / لَكَمَ (معناه: ضرب بقبضة اليد أو اللكم؛ معنى آخر: الضرب بشدة) / خَرَّامَة\nمثال: لكم اشتقت إليك!",
 "にゅうきょしゃ": "مُسْتَأْجِر",
 "にゅうきん": "إيراد إجمالي, مقبوضات (المبلغ الكامل للدخل قبل إجراء أي خصومات) / وَدِيعَة / أَوْدَعَ (الثَوْب أو ما أشبه: صانه بأن وضعه في صِوَان أو مكان لا يؤْذَى فيه؛ فلانًا مالًا: دفعه إليه ليكون عنده وديعة. ويكون أيضا بمعنى قبل الوديعة)\nمثال: غادرت المنزل دون أن أودع أهلي.",
 "にゅうぎゅう": "أبقار حلوب, ماشية الحليب (الماشية التي تُربى من أجل حليبها)",
 "にゅうこ": "إيداع, تخزين (الإيداع في مستودع)\nمثال: قرروا إيداع أثاثهم في مستودع موصى به في بروكلين",
 "にゅうこう": "لُبَان / إدخال, قبول (فعل السماح لشخص بالدخول) / حق الدخول, دخول (الحق في الدخول) / إِقْرَار, اعْتِرَاف (إقرار بصحة شيء ما) / تذكرة الدخول, رسم الدخول (الرسم المفروض للدخول)\nمثال: تم إجراء الجراحة عند إدخاله الثاني إلى العيادة / غَزْو, إِغَارَة (أَغَارَ عَلَى العَدُوِّ غَزْواً : سَارَ إِلَى مُحَارَبَتِهِ وَقِتَالِهِ فِي عُقْرِ دِيَارِهِ؛ سيطرة على دولة أو منطقة بواسطة قوّات مُسلَّحة أجنبيّة)\nمثال: الصين مستعدة لغزو تايوان. / دخول (فعل الدخول) / دخول (حركة إلى الداخل أو نحو الباطن)\nمثال: قامت بدخول مهيب / شطر, فلق (عملية الفلق أو الشق) / شق الصدر, فلق الصدر (الخط المتشكل من أخدود بين جزأين (خاصة الفاصل بين ثديي المرأة)) / تفلج, تقطع ((علم الأجنة) الانقسام المتكرر للبويضة المخصبة) / انشطار, انقسام (كسر رابطة كيميائية في جزيء مما يؤدي إلى جزيئات أصغر)",
 "にゅうこくしゃ": "مُشَارِك / دَاخِل, وَافِد",
 "にゅうこん": "أُلْفَة",
 "にゅうさいしょう": "إنتويت, مقدمة دينية (تكوين من الموسيقى الصوتية مناسب لافتتاح الخدمات الكنسية)",
 "にゅうさつ": "عَرْض, عَطَاء (أتى العروض، أي مكّة والمدينة وما حولهما؛ الفَرَسَ: سار به بالعُرض)\nمثال: قبل كلاي العرض.",
 "にゅうさつかかく": "سِعْر عَطاء, سِعْر عَرْض (سَعِرَ يَسْعَرَ سَعَراً، وسُعْرَةً: ضرب لونه إِلى السواد فُوَيْقَ الأُدْمة؛ فهو أَسْعَرُ، وهي سَعْراءُ. والجمع: سُعْرٌ)\nمثال: إتفقوا على سعر.",
 "にゅうさつしゃ": "مُزَايِد",
 "にゅうさん": "حمض اللاكتيك, حمض اللبنيك (حمض كربوكسيلي شرابي شفاف عديم الرائحة استرطابي يوجد في الحليب الحامض وفي العديد من الفواكه)",
 "にゅうさんかんきん": "عصوية لبنية, لاكتوباسيلوس (بكتيريا عصوية موجبة الجرام تنتج حمض اللاكتيك (خاصة في الحليب))",
 "にゅうさんきゅうきん": "ستربتوكوكس, مكورة عقدية (بكتيريا كروية موجبة الجرام توجد في أزواج أو سلاسل؛ تسبب أمراضاً مثل الحمى القرمزية والتهاب اللوزتين)",
 "にゅうざい": "مُسْتَحْلَب",
 "にゅうし": "سن لبنية (واحدة من أولى الأسنان المؤقتة للثدييات الصغيرة (واحدة من 20 عند الأطفال)) / امتحان القبول (امتحان لتحديد استعداد المرشح لدورة دراسية) / دهن الزبدة (المادة الدهنية للحليب التي تُصنع منها الزبدة) / حَلَمَة",
 "にゅうしち": "جُنْدِيّ (لقب عسكري يُطلق على من يلتحق بالجَيْش ويعمل فيه، مقاتل، محارب، عسكري؛ (في الشطرنج) اسم آخر للبيدق) / بَيْدَق ((في الشطرنج) القطعة الأكثر انتشارًا على رقعة الشِطْرَنْج) / بيذق\nمثال: غادر ذلك الجندي.",
 "にゅうしぼう": "دهن الزبدة (المادة الدهنية للحليب التي تُصنع منها الزبدة)",
 "にゅうしゃ": "سقوط, ورود (اصطدام شعاع ضوئي بسطح ما) / مُعَدَّل الحُدُوث, نِسْبَة الوُقُوع (التكرار النسبي لحدوث شيء ما)\nمثال: قاس زاوية سقوط الضوء المنعكس / إيداع, تخزين (الإيداع في مستودع)\nمثال: قرروا إيداع أثاثهم في مستودع موصى به في بروكلين",
 "にゅうしゃかく": "زاوية السقوط, زاوية الورود (الزاوية التي يصنعها خط مع خط عمودي على السطح عند نقطة السقوط)",
 "にゅうしゅ": "اِكْتِسَاب",
 "にゅうしゅう": "صبيانية (كونها من خصائص الصبي)",
 "にゅうしゅうじ": "ساذج, غر (شاب أخرق وقليل الخبرة)",
 "にゅうしゅかのう": "مُتَاح (ممكن، مسموح)\nمثال: يجب أن تكون نتائج البحث متاحة للجميع.",
 "にゅうしゅさき": "مَصْدَر, مَصَادِر (مَصْدَر) / عَيْن (المُعَايَنَة والمشاهدة؛ العين : حاسة البصر والرؤية - مؤنث - تكون للإنسان وغيره من الحيوان . قال ابن السكيت : العين التي يبصر بها الناظر…) / مَصْدَر (مَصْدَر)\nمثال: ما مصدر هذا الخوف؟",
 "にゅうしゅつりょく": "آيُّو",
 "にゅうしゅつりょくしょりそうち": "مُدْخَل",
 "にゅうしゅつりょくせいぎょそうち": "اللجنة الأولمبية الدولية (المنظمة المسؤولة عن تنظيم الألعاب الأولمبية الحديثة)",
 "にゅうしゅつりょくせいぎょシステム": "مُدْخَل",
 "にゅうしゅつりょくプロセッサ": "ضغط داخل العين (الضغط الذي تمارسه السوائل داخل مقلة العين؛ ينظم بواسطة مقاومة التدفق الخارجي للخلط المائي)\nمثال: يمكن أن ينتج الجلوكوما عن زيادة الضغط داخل العين",
 "にゅうしゅふか": "غير متوفر (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "にゅうしゅふかのう": "غير متوفر (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "にゅうしょ": "إدخال, قبول (فعل السماح لشخص بالدخول) / حق الدخول, دخول (الحق في الدخول) / إِقْرَار, اعْتِرَاف (إقرار بصحة شيء ما) / تذكرة الدخول, رسم الدخول (الرسم المفروض للدخول)\nمثال: تم إجراء الجراحة عند إدخاله الثاني إلى العيادة / حَبْس, سَجْن (مَنَعَ الشيءَ عن الفعلِ؛ أَمْسَكَ الشيءَ، قَبَضَ عَلَيْهِ)\nمثال: هو,البارحة حرر من الحبس.",
 "にゅうしょう": "مَيْدَان / مَكَان (مَوْضِع؛ المنزلة والشأن، يقال أيضا مكانة) / مَقْعَد (كل ما يُقْعَدُ ويُجْلَسُ عليه؛ مَكَان القُعُود) / مَكَان, مكان (مَوْضِع؛ المنزلة والشأن، يقال أيضا مكانة) / وَضَعَ, حط (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه)\nمثال: هذا المكان مقدس / شِرْش, مَاء الْجُبْن",
 "にゅうしょく": "مُسْتَعْمَرَة, مُسْتَوْطَنَة",
 "にゅうしょくしゃ": "مُسْتَوْطِن, مُسْتَعْمِر",
 "にゅうしょくち": "مُسْتَعْمَرَة, مُسْتَوْطَنَة",
