 "昼メロ": "تَمْثِيلِيَّة, مُسَلْسَلَات تِلِفِزْيُونِيَّة",
 "昼中": "نَهَارُ (انْتِشَار البَصَر وافْتِرَاقه؛ الفترة المضيئة من اليَوْم ما بين طلوع الفَجْر إلى غروب الشَمْس. ضد اللَيْل)\nمثال: نهار اليوم ممل!",
 "昼光": "ضوء النهار (الضوء أثناء النهار) / ضوء النهار, نهار (الوقت بعد شروق الشمس وقبل غروبها عندما يكون الضوء موجوداً في الخارج)\nمثال: حول الفجر الليل إلى نهار",
 "昼前": "صَبَاح / غُدْوة / صُبْح (أَشْرَقَ، أَضَاءَ) / صباح / صُبُح (أَشْرَقَ، أَضَاءَ)\nمثال: كان يريد أن بصبح حاخاما.",
 "昼勤": "وردية نهارية (عمال يعملون أثناء النهار (مثل من 8 صباحًا إلى 4 مساءً)) / وردية نهارية (نوبة العمل أثناء النهار (مثل 8 صباحاً إلى 4 مساءً))",
 "昼夜": "لَيْلَ نَهَارَ, صَبَاحَ مَسَاءَ (من مغرب الشمس إلى طلوعها)\nمثال: بكت طوال الليل.",
 "昼夜を分かたず": "لَيْلَ نَهَارَ, صَبَاحَ مَسَاءَ (من مغرب الشمس إلى طلوعها)\nمثال: بكت طوال الليل.",
 "昼夜を問わず": "لَيْلَ نَهَارَ, صَبَاحَ مَسَاءَ (من مغرب الشمس إلى طلوعها)\nمثال: بكت طوال الليل.",
 "昼夜兼行": "دُونَ تَوَقُّف, عَلَى مَدَارِ السَّاعَة (فِي جَمِيعِ الأَوْقَات؛ دُونَ انْقِطَاع)",
 "昼寝": "تَقَيَّلَ, أَخَذَ قَيْلُولَة / قَيْلولة, سِنَة",
 "昼席": "حفلة نهارية, ماتينيه (عرض مسرحي يُقام خلال النهار (خاصة بعد الظهر))",
 "昼帯": "تَمْثِيلِيَّة, مُسَلْسَلَات تِلِفِزْيُونِيَّة",
 "昼御飯": "غَدَاء (هو طَعَام الغُدْوَة، وهو الوقت بين الفَجْر وطلوع الشَمْس. استخدام قديم؛ طعام الظُهْر. استخدام حديث)\nمثال: إنه وقت الغداء.",
 "昼日なか": "نَهَارُ (انْتِشَار البَصَر وافْتِرَاقه؛ الفترة المضيئة من اليَوْم ما بين طلوع الفَجْر إلى غروب الشَمْس. ضد اللَيْل)\nمثال: نهار اليوم ممل!",
 "昼日中": "نَهَارُ (انْتِشَار البَصَر وافْتِرَاقه؛ الفترة المضيئة من اليَوْم ما بين طلوع الفَجْر إلى غروب الشَمْس. ضد اللَيْل)\nمثال: نهار اليوم ممل!",
 "昼時": "ظهر, ظَهِيرَة (مصدر للفعل ظَهَرَ؛ خلاف البَطْن، الجزء الظَاهِر من الشيئ وغير البَاطِن)\nمثال: عنده حقيبة ظهر.",
 "昼盲症": "عشى, عمى نهاري (عدم القدرة على الرؤية بوضوح في الضوء الساطع)",
 "昼興行": "حفلة نهارية, ماتينيه (عرض مسرحي يُقام خلال النهار (خاصة بعد الظهر))",
 "昼行性": "نَهَارِيّ",
 "昼行灯": "أحمق, بليد (شخص غبي؛ تستخدم هذه الكلمات للتعبير عن رأي متدنٍ في ذكاء شخص ما)",
 "昼過ぎ": "بَعْد الظُّهْر, بَعْدَ الزَّوَال (يدل على اللحاق في الزمان؛ يكون مضافا، وينصب أو يجر)\nمثال: و بعد قليل أتى.",
 "昼間": "نَهَارُ (انْتِشَار البَصَر وافْتِرَاقه؛ الفترة المضيئة من اليَوْم ما بين طلوع الفَجْر إلى غروب الشَمْس. ضد اللَيْل)\nمثال: نهار اليوم ممل!",
 "昼食": "غَدَاء (هو طَعَام الغُدْوَة، وهو الوقت بين الفَجْر وطلوع الشَمْس. استخدام قديم؛ طعام الظُهْر. استخدام حديث)\nمثال: إنه وقت الغداء.",
 "昼食会": "اجتماع غداء, غداء عمل (اجتماع على الغداء؛ عادة لإجراء الأعمال أثناء تناول الطعام)",
 "昼飯": "غَدَاء (هو طَعَام الغُدْوَة، وهو الوقت بين الفَجْر وطلوع الشَمْس. استخدام قديم؛ طعام الظُهْر. استخدام حديث)\nمثال: إنه وقت الغداء.",
 "昼餉": "غَدَاء (هو طَعَام الغُدْوَة، وهو الوقت بين الفَجْر وطلوع الشَمْس. استخدام قديم؛ طعام الظُهْر. استخدام حديث)\nمثال: إنه وقت الغداء.",
 "昼餐": "غداء (وجبة منتصف النهار)",
 "昼鳶": "لص متسلل (لص يسرق دون استخدام العنف) / نَشَّال",
 "時": "وَقْت (\"بَقِيَ وَقْتاً عِنْدَهُ \" : أَيْ مِقْدَاراً مِنَ الزَّمَنِ؛ \"جَاءَ فِي الوَقْتِ الْمُنَاسِبِ \" : فِي اللَّحْظَةِ الْمُنَاسِبَةِ) / مَرَّة, مرة (مؤنث مُرّ، صفة ما كان بها مرارة) / حِين, وَقْت ((حَيَّنَه): جعل لَهُ حينا؛ (حَيَّنَ) الله فلَانا: لم يوفقه للرشاد)\nمثال: حان وقت الذهاب. / فُرْصَة, مُنَاسَبَة / مُنَاسَبَة (مؤنث مُنَاسَب؛ اسم مفعول من نَاسَبَ؛ التي نُوسِبَتْ أي اتُّخِذَتْ نَسِيبَة؛ الحَدَث الذي يكون مناسِبًا لفعل شيئا ما، غالبا ما يُقصد به حَدَثًا سعيدا وما يُراد فعله هو الاحتفال ويجوز استخدامها في الاحداث غير سعيدة)\nمثال: أرى مرآة مناسبة / فُرْصَة / فِي (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي. / وَقْت (\"بَقِيَ وَقْتاً عِنْدَهُ \" : أَيْ مِقْدَاراً مِنَ الزَّمَنِ؛ \"جَاءَ فِي الوَقْتِ الْمُنَاسِبِ \" : فِي اللَّحْظَةِ الْمُنَاسِبَةِ)\nمثال: حان وقت الذهاب. / وَقْت (\"بَقِيَ وَقْتاً عِنْدَهُ \" : أَيْ مِقْدَاراً مِنَ الزَّمَنِ؛ \"جَاءَ فِي الوَقْتِ الْمُنَاسِبِ \" : فِي اللَّحْظَةِ الْمُنَاسِبَةِ) / مَرَّة, مرة (مؤنث مُرّ، صفة ما كان بها مرارة) / حِين, وَقْت ((حَيَّنَه): جعل لَهُ حينا؛ (حَيَّنَ) الله فلَانا: لم يوفقه للرشاد)\nمثال: حان وقت الذهاب. / مَوْسِم / مَوْسِم, جُزْء",
 "時々": "أَحْيَانًا, سَاعَات / موسمي (يحدث في أو يعتمد على موسم معين) / عامل موسمي (عامل يجد عملاً فقط في مواسم معينة)\nمثال: عمالة موسمية",
 "時々刻々": "بالساعة, كل ساعة (كل ساعة؛ حسب الساعة) / سَاعِيّ (يحدث كل ساعة أو يُدفع بالساعة)\nمثال: يومياً، بل كل ساعة، كنت أزداد قوة",
 "時あたかも": "عندئذ, في تلك اللحظة (في وقت معين في الماضي)\nمثال: عندئذ انطلق البوق",
 "時おり": "أَحْيَانًا, سَاعَات",
 "時が解決する": "الزَّمَن يُعَالِجُ كُل الأَجْرَاح",
 "時たま": "أحياناً, بين الحين والآخر (بشكل متقطع وغير متكرر)\nمثال: كان متغطرساً وقاسياً أحياناً",
 "時つ": "فِي الوَقْت المُنَاسِب (في وقت ملائم) / فِي أَوَانِه, فِي الوَقْت المُنَاسِب (يحدث أو يتم في الوقت الملائم أو المناسب) / فِي الوَقْتِ المُنَاسِب (قبل انتهاء المهلة الزمنية المحدّدة)\nمثال: وصلت رسالتك في الوقت المناسب",
 "時として": "أَحْيَانًا, سَاعَات",
 "時なし大根": "على مدار السنة (يعمل أو يستمر طوال العام)\nمثال: منتجع يعمل على مدار السنة",
 "時ならぬ": "مُفَاجِئ",
 "時に": "بِالْمُنَاسَبَةِ, عَلَى فِكْرَةٍ / أَحْيَانًا, سَاعَات / بِدِقَّة",
 "時には": "أَحْيَانًا",
 "時の": "مَرْغُوب, مَطْلُوب (مَطْلُوبٌ كَثِيرًا)",
 "時の気": "مَرَض مُعْدٍ (أصابه مرضٌ أو علّة أو سَقَم)\nمثال: هذا المرض قلبي.",
 "時の運": "فُرْصَة",
 "時は金なり": "اَلْوَقْتُ مِنْ ذَهَبٍ",
 "時めく": "ازدهر",
 "時を同じくして": "فِي نَفْس اَلْوَقْت (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "時を得た": "فِي الوَقْت المُنَاسِب (في وقت ملائم) / فِي أَوَانِه, فِي الوَقْت المُنَاسِب (يحدث أو يتم في الوقت الملائم أو المناسب) / فِي الوَقْتِ المُنَاسِب (قبل انتهاء المهلة الزمنية المحدّدة)\nمثال: وصلت رسالتك في الوقت المناسب",
 "時を移さず": "حَالاً (مباشرةً، فوراً، دون تأخير؛ في هذه الأثناء، في الوضع الحالي)\nمثال: سأكون معك حالا.",
 "時下": "الآن, اليوم (في هذه الأوقات) / حاضر (الفترة الزمنية التي تحدث الآن؛ أي امتداد مستمر للزمن يشمل لحظة الكلام)\nمثال: فقط من خلال لغتهم يتم تمييز الطبقات العليا في هذه الأيام",
 "時世": "فِي (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "時人": "جيل, معاصرون (جميع الناس الذين يعيشون في نفس الوقت أو من نفس العمر تقريباً)",
 "時代": "نُقْطَة, عَلَامَة فَصْلِيَّة (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه) / حِصَّةٌ / عَصْر (مصدر للفعل \"عَصَرَ\"؛ أي مدة زمنية، دهر من الوقت)\nمثال: هذه هي نقطة ضعفه. / فِي (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي. / شيخوخة, قدم (جودة كون الشيء قديماً؛ عكس الجدة) / شيخوخة, كبر (عكس الصغر) / عَتِيق, قَدِيم (قَدِيم، أَثَرِيّ؛ مُحَرَّر، حُرّ)\nمثال: هذا سوق عتيق للبعير.",
 "時代物": "عَتِيق, قَدِيم (قَدِيم، أَثَرِيّ؛ مُحَرَّر، حُرّ)\nمثال: هذا سوق عتيق للبعير. / عمل فني تاريخي (أي عمل فني تكمن قيمته الخاصة في استحضاره لفترة تاريخية)",
 "時代精神": "رُوحُ الْعَصْر (رَوَّحَ عليه بالمِرْوحَة: حَرَّكَها ليجلبَ إِليه نسيمَ الهواء؛ رَوَّحَ بالقوم: صلَّى بهم التراويح)\nمثال: كان سامي هو روح الحفلة.",
 "時代遅れ": "عَفَا عَلَيْه الزَّمَن, قَدِيم الطِّرَاز (خَارِج المُوضَة وَلَمْ يَعُدْ رَائِجًا)",
 "時代錯誤": "أداة لا تتناسب مع العصر, شيء في غير زمنه (غرض أو أداة تنتمي إلى زمن آخر غير الذي توجد فيه) / شَخْص مِن زَمَن آخَر, مُفَارَقَة تَارِيخِيَّة (شخص يبدو وكأنه في غير زمانه؛ ينتمي لعصر آخر) / خطأ في التوقيت, مفارقة تاريخية (شيء يقع في وقت لم يكن من الممكن أن يوجد أو يحدث فيه)",
 "時価": "ثَمَن, سِعْر (ثمَّنَ السِّلْعَةَ: قدّر ثَمنَها؛ ثمَّنَ الشيءَ: جعل له ثمانية أركان) / ثَمَن (ثمَّنَ السِّلْعَةَ: قدّر ثَمنَها؛ ثمَّنَ الشيءَ: جعل له ثمانية أركان)\nمثال: دفع زيري الثمن.",
 "時価総額": "القيمة السوقية, رسملة السوق (تقدير لقيمة شركة يتم الحصول عليه بضرب عدد الأسهم القائمة في السعر الحالي للسهم)",
 "時候": "مَوْسِم / مَوْسِم, جُزْء",
 "時候外れ": "في غير موسمه (لا يتماشى مع (وعادة ما يكون غير مرغوب فيه لـ) الموسم) / سَيِّئ التَّوْقِيت, فِي غَيْر أَوَانِه (ذو توقيت سيئ أو غير ملائم)\nمثال: عاصفة ثلجية مفاجئة في غير موسمها",
 "時分": "وَقْت (\"بَقِيَ وَقْتاً عِنْدَهُ \" : أَيْ مِقْدَاراً مِنَ الزَّمَنِ؛ \"جَاءَ فِي الوَقْتِ الْمُنَاسِبِ \" : فِي اللَّحْظَةِ الْمُنَاسِبَةِ) / مَرَّة, مرة (مؤنث مُرّ، صفة ما كان بها مرارة) / حِين, وَقْت ((حَيَّنَه): جعل لَهُ حينا؛ (حَيَّنَ) الله فلَانا: لم يوفقه للرشاد)\nمثال: حان وقت الذهاب. / فُرْصَة",
 "時分時": "وقت الطعام, وقت الوجبة (الساعة التي تُؤكل فيها وجبة عادة أو عرفاً)",
 "時制": "صِيغَة, صِيغَةُ الْفِعْل / مُتَوَتِّر",
 "時刻": "وَقْت (\"بَقِيَ وَقْتاً عِنْدَهُ \" : أَيْ مِقْدَاراً مِنَ الزَّمَنِ؛ \"جَاءَ فِي الوَقْتِ الْمُنَاسِبِ \" : فِي اللَّحْظَةِ الْمُنَاسِبَةِ) / مَرَّة, مرة (مؤنث مُرّ، صفة ما كان بها مرارة) / حِين, وَقْت ((حَيَّنَه): جعل لَهُ حينا؛ (حَيَّنَ) الله فلَانا: لم يوفقه للرشاد)\nمثال: حان وقت الذهاب. / فُرْصَة",
 "時刻表": "جَدْوَل مَوَاعِيد, جَدْوَل",
 "時効": "وَصْفَة طِبِّيَّة, وَصْفَة / تَقَادُم / آخِذ فِي الشَّيْخُوخَة, شَائِخ (في طور التقدّم في السنّ والشيخوخة) / تقدم في السن, شيخوخة (العملية العضوية للتقدم في العمر وظهور آثار زيادة السن) / تعتق, نضج (اكتساب صفات مرغوبة عن طريق ترك الشيء دون إزعاج لبعض الوقت)",
 "時勢": "فِي (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "時半": "السَّاعَة وَالنِّصْف, السَّاعَة الْوَاحِدَة وَالنِّصْف",
 "時圏": "دائرة الساعة (دائرة عظمى على الكرة السماوية تمر عبر كلا القطبين السماويين)",
 "時報": "إشارة الوقت (إشارة (خاصة إلكترونية أو لاسلكية) تشير إلى الوقت الصحيح بدقة) / تقرير, خبر (سرد قصير للأخبار)\nمثال: تقرير خطابه",
 "時好": "تَقْلِيعَة",
 "時季": "مَوْسِم / مَوْسِم, جُزْء",
 "時宣": "وَقْت (\"بَقِيَ وَقْتاً عِنْدَهُ \" : أَيْ مِقْدَاراً مِنَ الزَّمَنِ؛ \"جَاءَ فِي الوَقْتِ الْمُنَاسِبِ \" : فِي اللَّحْظَةِ الْمُنَاسِبَةِ) / مَرَّة, مرة (مؤنث مُرّ، صفة ما كان بها مرارة) / حِين, وَقْت ((حَيَّنَه): جعل لَهُ حينا؛ (حَيَّنَ) الله فلَانا: لم يوفقه للرشاد)\nمثال: حان وقت الذهاب.",
 "時局": "حَالَة, وَضْع",
 "時差": "فَارِق اَلتَّوْقِيت",
 "時差ぼけ": "إعياء السفر, اضطراب الرحلات الجوية الطويلة (تعب واضطراب في النوم ناتج عن خلل في الإيقاع اليومي الطبيعي للجسم نتيجة السفر بالطائرة)",
 "時差ボケ": "إعياء السفر, اضطراب الرحلات الجوية الطويلة (تعب واضطراب في النوم ناتج عن خلل في الإيقاع اليومي الطبيعي للجسم نتيجة السفر بالطائرة)",
 "時差惚け": "إعياء السفر, اضطراب الرحلات الجوية الطويلة (تعب واضطراب في النوم ناتج عن خلل في الإيقاع اليومي الطبيعي للجسم نتيجة السفر بالطائرة)",
 "時恰も": "عندئذ, في تلك اللحظة (في وقت معين في الماضي)\nمثال: عندئذ انطلق البوق",
 "時折": "أَحْيَانًا, سَاعَات",
 "時折り": "أَحْيَانًا, سَاعَات",
 "時日": "تَمْرَة, تَمْر / تَارِيخ (جملة الأَحوال والأحداث التي يمر بها كائن ما، ويَصْدق على الفرد والمجتمع، كما يَصْدق على الظواهر الطبيعية والإنسانية؛ هو تحديد الزمن باليَوْم والشَهْر والسَنَة أو ببعضهما. الأجَل أو الوَقْت) / مُوَاعَدَة, مَوْعِد / لِقَاء الْحُبّ, مَوْعِد (وجود اثنين أو أكثر معًا، صدفةً أو تدبيرًا) / أَرَّخَ (أَرَخَّ الشيءَ: بالغ فيه؛ وأَرَخَّ العجينَ: أكثر ماءه)\nمثال: ما تاريخ اليوم؟",
 "時時": "أَحْيَانًا, سَاعَات / موسمي (يحدث في أو يعتمد على موسم معين) / عامل موسمي (عامل يجد عملاً فقط في مواسم معينة)\nمثال: عمالة موسمية",
 "時時刻刻": "بالساعة, كل ساعة (كل ساعة؛ حسب الساعة) / سَاعِيّ (يحدث كل ساعة أو يُدفع بالساعة)\nمثال: يومياً، بل كل ساعة، كنت أزداد قوة",
 "時期": "وَقْت (\"بَقِيَ وَقْتاً عِنْدَهُ \" : أَيْ مِقْدَاراً مِنَ الزَّمَنِ؛ \"جَاءَ فِي الوَقْتِ الْمُنَاسِبِ \" : فِي اللَّحْظَةِ الْمُنَاسِبَةِ) / مَرَّة, مرة (مؤنث مُرّ، صفة ما كان بها مرارة) / حِين, وَقْت ((حَيَّنَه): جعل لَهُ حينا؛ (حَيَّنَ) الله فلَانا: لم يوفقه للرشاد)\nمثال: حان وقت الذهاب.",
 "時期尚早": "سَابِقٌ لِأَوَانِه, مُبْتَسَر (مبكّر بشكل غير مألوف أو قبل الوقت المتوقّع) / مُتَسَرِّع, مُسْتَعْجَل (أبكر ممّا ينبغي أو أكثر تسرّعاً من اللازم) / سابق لأوانه, مبتسر (ولد بعد فترة حمل أقل من الوقت الطبيعي)\nمثال: رضيع مبتسر",
 "時期早々": "سَابِقٌ لِأَوَانِه, مُبْتَسَر (مبكّر بشكل غير مألوف أو قبل الوقت المتوقّع) / مُتَسَرِّع, مُسْتَعْجَل (أبكر ممّا ينبغي أو أكثر تسرّعاً من اللازم) / سابق لأوانه, مبتسر (ولد بعد فترة حمل أقل من الوقت الطبيعي)\nمثال: رضيع مبتسر",
 "時期早尚": "سَابِقٌ لِأَوَانِه, مُبْتَسَر (مبكّر بشكل غير مألوف أو قبل الوقت المتوقّع) / مُتَسَرِّع, مُسْتَعْجَل (أبكر ممّا ينبغي أو أكثر تسرّعاً من اللازم) / سابق لأوانه, مبتسر (ولد بعد فترة حمل أقل من الوقت الطبيعي)\nمثال: رضيع مبتسر",
 "時期早早": "سَابِقٌ لِأَوَانِه, مُبْتَسَر (مبكّر بشكل غير مألوف أو قبل الوقت المتوقّع) / مُتَسَرِّع, مُسْتَعْجَل (أبكر ممّا ينبغي أو أكثر تسرّعاً من اللازم) / سابق لأوانه, مبتسر (ولد بعد فترة حمل أقل من الوقت الطبيعي)\nمثال: رضيع مبتسر",
 "時期的": "موسمي (يحدث في أو يعتمد على موسم معين) / عامل موسمي (عامل يجد عملاً فقط في مواسم معينة)\nمثال: عمالة موسمية",
 "時機": "فُرْصَة",
 "時点": "لحظة, نقطة زمنية (لحظة من الزمن)\nمثال: في تلك اللحظة اضطررت للمغادرة",
 "時無し大根": "على مدار السنة (يعمل أو يستمر طوال العام)\nمثال: منتجع يعمل على مدار السنة",
 "時疫": "وَبَاء, أَوْبِئَة (المرض العام الذي ينتشر بين الناس)\nمثال: على السلطات أن توقف انتشار الوباء.",
 "時相": "صِيغَة, صِيغَةُ الْفِعْل / مُتَوَتِّر",
