 "張り出す": "مَشْرُوع (ما تُجِيزُه السلطة أو القانون أو أي قاعدة، جَائِز، قَانُونِيّ؛ مسعى مؤقت أي شيء…)\nمثال: هذا مشروع عظيم. / عَارِضَة, عَارْضَة\nمثال: نشر توم الغسيل.",
 "張り合い": "مُنَافَسَة, مُبَارَاة / دَافِع (دَافِع : حافِزٌ وسببٌ، أمرٌ مُوجِبٌ؛ ما يحمل على الفعل من غرائز وميول فهو…)\nمثال: دافع عن الضعفاء.",
 "張り合いのない": "مُحْبِط, مُثَبِّط",
 "張り合う": "تَنَافَسَ, تَبَارَى",
 "張り型": "قَضِيب اِصْطِنَاعِيّ",
 "張り子": "وَرَق مُقَوَّى (ما ينمو على النبات من الأعلى والجوانب بشكل صفائح ذات لون أخضر أو مائل إلى…)\nمثال: هات ورقة بيضاء.",
 "張り子の虎": "وَرَق مُقَوَّى (ما ينمو على النبات من الأعلى والجوانب بشكل صفائح ذات لون أخضر أو مائل إلى…)\nمثال: هات ورقة بيضاء. / نَمِر وَرَقِيّ (طبيعة شخص أو منظمة تبدو قوية ولكنها في الواقع عاجزة وغير فعالة)",
 "張り抜き": "وَرَق مُقَوَّى (ما ينمو على النبات من الأعلى والجوانب بشكل صفائح ذات لون أخضر أو مائل إلى…)\nمثال: هات ورقة بيضاء.",
 "張り替える": "جَدَّدَ (الشيء: رممه أو أصلحه حتى صار كالجَدِيد؛ الكلام: أعاده من جديد)\nمثال: تعرف على أناس جدد.",
 "張り札": "مُلْصَق, أَفِيش",
 "張り番": "نَاطُور",
 "張り紙": "مُلْصَق / لَاحَظَ",
 "張り裂ける": "انفجار (عملية الانفجار أو التفرقع)\nمثال: انفجار الألعاب النارية أيقظ الأطفال",
 "張り詰める": "سُلَالَة",
 "張り込み": "كمين مراقبة (مراقبة مكان أو شخص ما من قبل الشرطة (كما في توقع جريمة)) / نَاطُور / تجميع ولصق (تكوين من أشياء مسطحة ملصقة على لوح أو خلفية أخرى)\nمثال: أروه تجميعاً ولصقاً لغلاف الكتاب",
 "張り込む": "عربدة, نوبة إفراط (أي فعل من أفعال الانغماس غير المعتدل)\nمثال: نوبة إفراط في التسوق / أَلْصَقَ",
 "張り飛ばす": "صَرَعَ (طَرَحَه على الأرض؛ أَرْدَاهُ قَتِيلاً وأَهْلَكَهُ)",
 "張る": "غُصَيْن\nمثال: لا تمسك العصا من الوسط. / تَمَدَّدَ / صُورَة, شَكْل\nمثال: اجلس بشكل مريح. / مَلَأَ",
 "張三李四": "عَدِيمُ الجَدْوَى, لَا خَيْرَ فِيه (بِلَا اسْتِحْقَاق؛ ذُو قِيمَةٍ أَوْ فَائِدَةٍ ضَئِيلَةٍ أَوْ مُنْعَدِمَة)",
 "張出": "بروز, تدلّ (نتوء يمتد إلى ما بعد شيء آخر أو يتدلى فوقه) / مُلْصَق, أَفِيش",
 "張出し": "بروز, تدلّ (نتوء يمتد إلى ما بعد شيء آخر أو يتدلى فوقه) / مُلْصَق, أَفِيش",
 "張出し窓": "نافذة بارزة (نافذة تبرز من الجدار الخارجي للمنزل)",
 "張力": "تَوَتُّر\nمثال: لا إنجاز بلا جهد .",
 "張力計": "مقياس التوتر السطحي (أداة قياس لقياس التوتر السطحي لسائل)",
 "張合い": "مُنَافَسَة, مُبَارَاة / دَافِع (دَافِع : حافِزٌ وسببٌ، أمرٌ مُوجِبٌ؛ ما يحمل على الفعل من غرائز وميول فهو…)\nمثال: دافع عن الضعفاء.",
 "張子": "وَرَق مُقَوَّى (ما ينمو على النبات من الأعلى والجوانب بشكل صفائح ذات لون أخضر أو مائل إلى…)\nمثال: هات ورقة بيضاء.",
 "張子の虎": "وَرَق مُقَوَّى (ما ينمو على النبات من الأعلى والجوانب بشكل صفائح ذات لون أخضر أو مائل إلى…)\nمثال: هات ورقة بيضاء. / نَمِر وَرَقِيّ (طبيعة شخص أو منظمة تبدو قوية ولكنها في الواقع عاجزة وغير فعالة)",
