 "日向水木": "بندق الشتاء, بندق مزهر (أي من الشجيرات النفضية الآسيوية المتعددة المزروعة لعناقيدها المتدلية من الزهور الصفراء التي تظهر قبل الأوراق)",
 "日向臭い": "إقليمي, ريفي (من خصائص الأقاليم (الريف) أو سكانها) / إقليمي, ريفي (مكون من أو مرتبط بمقاطعة أو إقليم) / فلاح, قروي (شخص من الريف) / رئيس إقليمي ((الكنيسة الكاثوليكية) مسؤول مسؤول عن مقاطعة كنسية يعمل تحت الرئيس العام للرهبنة)\nمثال: ريفي ومساير للأعراف بعمق",
 "日周": "نَهَارِيّ",
 "日周視差": "تزيح أرضي المركز, تزيح نهاري (تزيح جرم سماوي باستخدام نقطتين على سطح الأرض أثناء دوران الأرض)",
 "日和見": "انتهازية (استغلال الفرص دون النظر للعواقب على الآخرين)",
 "日和見主義": "انتهازية (استغلال الفرص دون النظر للعواقب على الآخرين)",
 "日和見感染": "عدوى انتهازية (أي عدوى تسببها كائنات دقيقة لا تسبب مرضاً عادةً لدى البشر؛ تحدث لدى الأشخاص الذين يعانون من ضعف في جهاز المناعة (مثل مرضى الإيدز))",
 "日唐傘": "مَظَلَّة, شَمْسِيَّة",
 "日嗣の御子": "وَلِيّ عَهْد (مَلَكَ الأمر وقَامَ به وسيطر عليه وولي عليه ولايةَ)\nمثال: ولي العهد هو من يرث العرش.",
 "日嗣の皇子": "وَلِيّ عَهْد (مَلَكَ الأمر وقَامَ به وسيطر عليه وولي عليه ولايةَ)\nمثال: ولي العهد هو من يرث العرش.",
 "日増しに": "يوماً بعد يوم, يومياً (تدريجياً وبشكل تقدمي)\nمثال: ضعفت صحته يوماً بعد يوم",
 "日変化": "تغير نهاري (تقلبات تحدث خلال اليوم الواحد)",
 "日夕": "لَيْلَ نَهَارَ, صَبَاحَ مَسَاءَ (من مغرب الشمس إلى طلوعها)\nمثال: بكت طوال الليل.",
 "日外": "ذات مرة, سابقاً (في وقت سابق) / في آن واحد, في المرة الواحدة (بشكل متزامن)\nمثال: في وقت ما أحبها",
 "日夜": "لَيْلَ نَهَارَ, صَبَاحَ مَسَاءَ (من مغرب الشمس إلى طلوعها)\nمثال: بكت طوال الليل.",
 "日天": "شَمْس, شمس (الشَّمْسُ: النَّجْمُ الرئيسُ الذي تدور حوله الْأَرْض، وسائر كواكب المجموعة الشمسية؛ الشَّمس: اسم سورة من سور القرآن الكريم، وهي السُّورة رقم 91 في ترتيب المصحف، مكِّيَّة، عدد آياتها خمس عشرة آية) / مثال: نحب غروب الشمس.",
 "日天子": "شَمْس, شمس (الشَّمْسُ: النَّجْمُ الرئيسُ الذي تدور حوله الْأَرْض، وسائر كواكب المجموعة الشمسية؛ الشَّمس: اسم سورة من سور القرآن الكريم، وهي السُّورة رقم 91 في ترتيب المصحف، مكِّيَّة، عدد آياتها خمس عشرة آية) / مثال: نحب غروب الشمس.",
 "日子": "أَيَّام",
 "日射": "إشعاع شمسي (إشعاع صادر من الشمس)",
 "日射し": "ضَوْء شَمْس, نُور شَمْس (النُّور؛ مصدر ضَاء)\nمثال: ضوء القمر ضعيف.",
 "日射病": "ضربة شمس, فرط الحرارة (انهيار ناتج عن التعرض للحرارة المفرطة)",
 "日差し": "ضَوْء شَمْس, نُور شَمْس (النُّور؛ مصدر ضَاء)\nمثال: ضوء القمر ضعيف.",
 "日常": "اعْتِيَادِيّ, يَوْمِيّ (شَائِع وَعَادِيّ؛ مِنَ الحَيَاة اليَوْمِيَّة) / عَادِيّ, يَوْمِيّ (مُنَاسِبٌ لِلْمُنَاسَبَاتِ العَادِيَّةِ أَوِ الرُّوتِينِيَّةِ) / رُوتِينِيّ, يَوْمِيّ (يوجد في المجرى العادي للأحداث)",
 "日常会話": "يَوْمِيّ (يتعلق بكل يوم أو يحدث كل يوم)",
 "日常性": "اعْتِيَادِيَّة, عَادِيَّة (صفة كون الشيء مألوفاً وعادياً)",
 "日常生活": "حَيَاة يَوْمِيَّة (الحَياة: ضد الموت والحَيُّ: ضدُّ الميّت؛ والمَحْيا مَفْعَلٌ من الحياة. تقول: مَحْيَاي ومماتي. والجمع الحَحايي)\nمثال: ما أغرب الحياة!",
 "日常生活動作": "أنشطة الحياة اليومية",
 "日常的": "دُنْيَوِيّ / عَادِيّ / مُمِلّ, مُضْجِر (ما يسبب الضجر والضيقة، غير مثير للاهتمام)\nمثال: نهار اليوم ممل!",
 "日常語": "دَارِج, عَامِّيّ (خَاصٌّ بِاللُّغَةِ اليَوْمِيَّةِ أَوْ مُنَاسِبٌ لَهَا) / لغة دارجة (الكلام اليومي للناس (تمييزاً عن اللغة الأدبية)) / رطانة, عامية خاصة (لغة مميزة لمجموعة معينة (كما بين اللصوص))\nمثال: هم لا يتحدثون لغتنا",
 "日干": "مُجَفَّف بِالشَّمْس (مُجَفَّف طَبِيعِيًّا بِأَشِعَّة الشَّمْس)",
 "日干し": "مُجَفَّف بِالشَّمْس (مُجَفَّف طَبِيعِيًّا بِأَشِعَّة الشَّمْس)",
 "日延べ": "إرجاء, تأجيل (فعل التأجيل إلى وقت لاحق) / انتظار, تأجيل (الوقت الذي يتم فيه انتظار إجراء ما)\nمثال: تسببت الإعادة الفورية في تأخير طويل جداً",
 "日当たりのいい": "مُشْمِس / شَامِس (اسم فاعل من الفعل \"شَمَسَ\"؛ ذو شمس)",
 "日当たりのよい": "مُشْمِس / شَامِس (اسم فاعل من الفعل \"شَمَسَ\"؛ ذو شمس)",
 "日当たりの良い": "مُشْمِس / شَامِس (اسم فاعل من الفعل \"شَمَسَ\"؛ ذو شمس)",
 "日影": "ظِلّ, مَظَلَّة (الإستمرار في العمل. أصله للنهار ثم أصبح يشمل النهار والليل)\nمثال: ظل الولد ساكنا. / نُور الشَّمْس (ضد الظَلام؛ ما يشع فيمكن الرؤية بسببه؛ ضد الضوء:ما يشع من أصله وليس ما يعكس الشعاع من غيره)\nمثال: نسي أن يطفئ النور.",
 "日心視差": "تزيح سنوي, تزيح شمسي المركز (تزيح جرم سماوي باستخدام نقطتين في مدار الأرض حول الشمس كخط أساس)",
 "日新": "يَوْمِيّ (يتعلق بكل يوم أو يحدث كل يوم)",
 "日日": "يَوْمِيّ / يَوْمِيًّا, كُلَّ يَوْمٍ / أَيَّام / يَوْمًا بَعْدَ يَوْم / تَمْرَة, تَمْر / تَارِيخ (جملة الأَحوال والأحداث التي يمر بها كائن ما، ويَصْدق على الفرد والمجتمع، كما يَصْدق على الظواهر الطبيعية والإنسانية؛ هو تحديد الزمن باليَوْم والشَهْر والسَنَة أو ببعضهما. الأجَل أو الوَقْت) / مُوَاعَدَة, مَوْعِد / لِقَاء الْحُبّ, مَوْعِد (وجود اثنين أو أكثر معًا، صدفةً أو تدبيرًا) / أَرَّخَ (أَرَخَّ الشيءَ: بالغ فيه؛ وأَرَخَّ العجينَ: أكثر ماءه)\nمثال: ما تاريخ اليوم؟ / أَيَّام",
 "日時計": "مِزْوَلَة",
 "日暈": "حلقة شمسية, هالة شمسية (هالة مضيئة موازية للأفق عند ارتفاع الشمس؛ تسببها بلورات الجليد في الغلاف الجوي)",
 "日暦": "تقويم شمسي (تقويم يعتمد على الدورات الشمسية)",
 "日暮": "شَفَق ((شَفِقَ) منه، وعليه يَشْفَقَ شَفَقًا: خاف وحَذِرَ، فهو شَفِقٌ؛ (شَفِقَ) عليه: رَقَّ له وعطف عليه؛ فهو شَفِيقٌ)\nمثال: أثارت تلك السلحفاة شفقة زيري.",
 "日暮し": "طِوَال اليَوْم, نَهَارًا (خلال اليوم بأكمله)\nمثال: الضوء يتدفق طوال اليوم في الغرفة",
