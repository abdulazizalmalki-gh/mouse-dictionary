 "暖房装置": "مِدْفَأَة",
 "暖機": "اِسْتَدْفَأَ / دَفَّأَ, أَدْفَأَ (دَفَّأَ الَجريحَ: أَدْفَأَهُ)",
 "暖気": "دفاء",
 "暖温帯": "المنطقة شبه الاستوائية (المناطق المتاخمة للمناطق الاستوائية)",
 "暖炉": "مِدْفَأَة, مَوْقِد",
 "暖竹": "غاب عملاق, قيصوب (أعشاب معمرة جذمورية كبيرة توجد بجانب الأنهار وفي الخنادق لها سيقان مفصلية وعناقيد ريشية رمادية بيضاء كبيرة)",
 "暖簾": "سُمْعَة, شُهْرَة / حسن نية, كياسة (الميل إلى اللطف والتعاطف) / حسن نية (الأمل الودي في نجاح شيء ما) / سمعة تجارية, شهرى المحل ((محاسبة) أصل غير ملموس يُقيم وفقاً للميزة أو السمعة التي اكتسبتها الشركة (فوق أصولها الملموسة))\nمثال: كياسة المنتصر في معاملة المهزوم",
 "暖簾に腕押し": "هدر الجهد (جهد لا طائل منه)",
 "暖簾代": "حسن نية, كياسة (الميل إلى اللطف والتعاطف) / حسن نية (الأمل الودي في نجاح شيء ما) / سمعة تجارية, شهرى المحل ((محاسبة) أصل غير ملموس يُقيم وفقاً للميزة أو السمعة التي اكتسبتها الشركة (فوق أصولها الملموسة))\nمثال: كياسة المنتصر في معاملة المهزوم",
 "暖衣飽食": "حَسَن التَّغْذِيَة (يتلقى تغذية سليمة وكافية)",
 "暗": "ظَلَام, ظُلْمَة (مصدر للفعل ظَلِمَ بمعنى ذهب نوره؛ ضد النُور، هو ذهاب النور والضوء فلا يوجد ما يشع ليُرَى)\nمثال: لدي خوف من الظلام.",
 "暗々": "غَامِق, دَاكِن",
 "暗々のうちに": "سِرًّا ((سَرَا) فلان سروا وسراوة: شرف وسخا في مروءة؛ (سَرَا) الشيء عنه سروا: نزعه وألقاه. يقال سرا عنه ثوبه ودرعه)\nمثال: أبقو حبهما سرا.",
 "暗々裏": "سِرًّا ((سَرَا) فلان سروا وسراوة: شرف وسخا في مروءة؛ (سَرَا) الشيء عنه سروا: نزعه وألقاه. يقال سرا عنه ثوبه ودرعه)\nمثال: أبقو حبهما سرا.",
 "暗々裡": "سِرًّا ((سَرَا) فلان سروا وسراوة: شرف وسخا في مروءة؛ (سَرَا) الشيء عنه سروا: نزعه وألقاه. يقال سرا عنه ثوبه ودرعه)\nمثال: أبقو حبهما سرا.",
 "暗い": "غَامِق, دَاكِن / مُحْبَط, مُكْتَئِب / مِنْ غَيْرِ المُرَجَّحِ (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة! / غَيْر مَأْلُوف (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "暗うつ": "قتامة, كآبة (شعور بتوجس كئيب) / عتمة, قتامة (حالة من الظلام الجزئي أو الكلي) / تجهم, قتامة (جو من الاكتئاب والحزن)\nمثال: أشعل عود ثقاب ليبدد العتمة",
 "暗がり": "ظَلَام, ظُلْمَة (مصدر للفعل ظَلِمَ بمعنى ذهب نوره؛ ضد النُور، هو ذهاب النور والضوء فلا يوجد ما يشع ليُرَى)\nمثال: لدي خوف من الظلام.",
 "暗きょ": "عبّارة, قنطرة (مصرف عرضي مغلق بالكامل تحت طريق أو سكة حديد)",
 "暗さ": "ظَلَام, ظُلْمَة (مصدر للفعل ظَلِمَ بمعنى ذهب نوره؛ ضد النُور، هو ذهاب النور والضوء فلا يوجد ما يشع ليُرَى)\nمثال: لدي خوف من الظلام.",
 "暗に": "ضمناً (بدون التعبير عن ذلك بوضوح) / بشكل مطلق, ثقة عمياء (دون شك أو تساؤل)\nمثال: يفترض ضمناً أنك تعرف الإجابة",
 "暗ます": "أَخْفَى / خَدَعَ, غَشَّ (غَشَّ، مَكَرَ؛ خَادَعَ شخصًا: خدعه بشكل مستمر أو بطريقة خفية)\nمثال: هذه خدعة قديمة.",
 "暗中飛躍": "خَلْفَ الكَوَالِيس, سِرِّيّ (مُصَمَّمٌ وَمُنَفَّذٌ بِسِرِّيَّةٍ أَوْ بِشَكْلٍ سِرِّيّ)",
 "暗函": "الكاميرا المظلمة, قمرة مظلمة (حاوية مظلمة تُسقَط فيها صور الأشياء الخارجية من خلال فتحة صغيرة أو عدسة على سطح مواجه) / صُنْدُوق أَسْوَد (وعاء كبيرة من الخشب غالبا وقد يكون حديدًا يستخدم لوضع الاشياء داخله، ويكون لها عادة جهة قابلة للفتح سواء بمفاصل او بالازالة الكاملة؛ صُنْدُوْقُ السَيَّارَة قمرة تشبه الصندوق في الجزء الخلفي من السيارة يستخدم كالصندوق)\nمثال: أين صندوق البريد؟",
 "暗号": "دُسْتُور, دَسْتُور (قَاعِدَة) / اِصْطِلَاح / تَرْمِيز, شِفْرَة / كود, شِفْرَة\nمثال: العدالة مضمونة في الدستور.",
 "暗号化": "ترميز, تشفير (نشاط تحويل البيانات أو المعلومات إلى رمز)",
 "暗号化手法": "تشفير, تعمية (فعل الكتابة برمز أو شفرة) / تحليل الشفرات, تشفير (علم تحليل وفك الشفرات والرموز والرسائل المشفرة)",
 "暗号学": "تشفير, تعمية (فعل الكتابة برمز أو شفرة) / تحليل الشفرات, تشفير (علم تحليل وفك الشفرات والرموز والرسائل المشفرة)",
 "暗号手法": "تشفير, تعمية (فعل الكتابة برمز أو شفرة) / تحليل الشفرات, تشفير (علم تحليل وفك الشفرات والرموز والرسائل المشفرة)",
 "暗号技術": "تشفير, تعمية (فعل الكتابة برمز أو شفرة) / تحليل الشفرات, تشفير (علم تحليل وفك الشفرات والرموز والرسائل المشفرة)",
 "暗号文": "رسالة سرية, كتابة مشفرة (قطعة من الكتابة برمز أو شفرة)",
 "暗号法": "تشفير, تعمية (فعل الكتابة برمز أو شفرة) / تحليل الشفرات, تشفير (علم تحليل وفك الشفرات والرموز والرسائل المشفرة)",
 "暗号理論": "تشفير, تعمية (فعل الكتابة برمز أو شفرة) / تحليل الشفرات, تشفير (علم تحليل وفك الشفرات والرموز والرسائل المشفرة)",
 "暗号解読": "تحليل الشفرات, تشفير (علم تحليل وفك الشفرات والرموز والرسائل المشفرة)",
 "暗号通貨": "عُمْلَة مُعَمَّاة, مُشَفَّرَة (أُجْرَة العَمَل؛ النُقُود عامة لأنها تعطى أجرة للعمل)\nمثال: دعونا نقلب العملة.",
 "暗合": "صُدْفَة, مُصَادَفَة (الصدفة. جمع: صُدُفات و صُدْفات و صُدَف٬ هي تزامن غير متوقع لحدوث فعلين بدون تخطيط مسبق، رآه صُدْفةً…)\nمثال: لا تدعها للصدفة.",
 "暗唱": "تِلَاوَة",
 "暗喩": "اِسْتِعَارَة",
 "暗室": "غرفة مظلمة (غرفة يتم فيها تحميض الصور الفوتوغرافية)",
 "暗屋": "بَيْت دَعَارَة, مَبْغًى (بمعنى قضى الليل؛ الخَيْمَة من الشَعْر يَبِيت فيها البَدَوي أو المُسافر. الجمع بُيُوت)\nمثال: لنعد إلى البيت.",
 "暗影": "ظِلّ, خَيَال (الإستمرار في العمل. أصله للنهار ثم أصبح يشمل النهار والليل)\nمثال: ظل الولد ساكنا.",
 "暗愚": "أَحْمَق, غَبِيّ (مُغَفَّل، أَبْلَه، طَائِش)\nمثال: قبلني ايها الأحمق.",
 "暗所": "ظَلَام, ظُلْمَة (مصدر للفعل ظَلِمَ بمعنى ذهب نوره؛ ضد النُور، هو ذهاب النور والضوء فلا يوجد ما يشع ليُرَى)\nمثال: لدي خوف من الظلام.",
 "暗所恐怖症": "رهاب الظلام (خوف مرضي من الليل أو الظلام)",
 "暗所視": "رؤية في الظلام, رؤية ليلية (القدرة على الرؤية في إضاءة منخفضة (كما في ضوء القمر))",
 "暗暗": "غَامِق, دَاكِن",
 "暗暗のうちに": "سِرًّا ((سَرَا) فلان سروا وسراوة: شرف وسخا في مروءة؛ (سَرَا) الشيء عنه سروا: نزعه وألقاه. يقال سرا عنه ثوبه ودرعه)\nمثال: أبقو حبهما سرا.",
 "暗暗裏": "سِرًّا ((سَرَا) فلان سروا وسراوة: شرف وسخا في مروءة؛ (سَرَا) الشيء عنه سروا: نزعه وألقاه. يقال سرا عنه ثوبه ودرعه)\nمثال: أبقو حبهما سرا.",
 "暗暗裡": "سِرًّا ((سَرَا) فلان سروا وسراوة: شرف وسخا في مروءة؛ (سَرَا) الشيء عنه سروا: نزعه وألقاه. يقال سرا عنه ثوبه ودرعه)\nمثال: أبقو حبهما سرا.",
 "暗欝": "قتامة, كآبة (شعور بتوجس كئيب) / عتمة, قتامة (حالة من الظلام الجزئي أو الكلي) / تجهم, قتامة (جو من الاكتئاب والحزن)\nمثال: أشعل عود ثقاب ليبدد العتمة",
 "暗殺": "اِغْتِيَال (مصدر للفعل \"اغْتَالَ\"؛ قتل شخص على غفلة منه، ويكثر استعماله في القتل لأسباب سياسية أو لمنافع شخصية)\nمثال: لم يتمكن أحد من الاغتيال هتلر.",
 "暗殺事件": "اِغْتِيَال (مصدر للفعل \"اغْتَالَ\"؛ قتل شخص على غفلة منه، ويكثر استعماله في القتل لأسباب سياسية أو لمنافع شخصية)\nمثال: لم يتمكن أحد من الاغتيال هتلر.",
 "暗殺者": "قَاتِل, سَفَّاح (اسم فاعل من الفعل قَتَلَ، الذي قَامَ بالقَتْل. الجمع قَاتِلُون؛ المُجْرِم الذي يقتل بلا حَقّ. الجمع قتلة) / حَشَّاش\nمثال: بيتي قاتلة أمك.",
 "暗流": "معنى مبطن, نبرة خفية (جودة عاطفية خفية تكمن وراء الكلام؛ معنى ضمني) / تيار تحتي (تيار تحت سطح سائل)",
 "暗渠": "عبّارة, قنطرة (مصرف عرضي مغلق بالكامل تحت طريق أو سكة حديد)",
 "暗溝": "عبّارة, قنطرة (مصرف عرضي مغلق بالكامل تحت طريق أو سكة حديد)",
 "暗潮": "معنى مبطن, نبرة خفية (جودة عاطفية خفية تكمن وراء الكلام؛ معنى ضمني) / تيار تحتي (تيار تحت سطح سائل)",
 "暗澹": "غَامِق, دَاكِن",
 "暗点": "عتمة (منطقة معزولة من الرؤية الضعيفة داخل المجال البصري)",
 "暗然": "غَامِق, دَاكِن / أَسِيف, حَزِين (مليء بالحزن أو يثيره)",
 "暗礁": "شَعَاب",
 "暗示": "تَلْمِيح / لَمَّحَ (لمح اليه؛يلمح لمحا واللمح:اختلس النظر وقال بعضهم:لمح نظر ولمحه)\nمثال: لمح سامي منزلا. / اِقْتِرَاح, مُقْتَرَح",
 "暗示的": "إِيحَائِيّ, مُوحٍ (يميل إلى الإيحاء بشيء غير لائق أو فاحش) / إِيحَائِيّ, تَلْمِيحِيّ (يَمِيلُ إِلَى التَّلْمِيحِ أَوِ الإِيحَاء) / دَالّ, كَاشِف (يشير بوضوح أو يكشف؛ يُستخدَم عادة مع 'على')",
 "暗穴": "أَحْمَق, غَبِيّ (مُغَفَّل، أَبْلَه، طَائِش)\nمثال: قبلني ايها الأحمق.",
 "暗箱": "الكاميرا المظلمة, قمرة مظلمة (حاوية مظلمة تُسقَط فيها صور الأشياء الخارجية من خلال فتحة صغيرة أو عدسة على سطح مواجه) / صُنْدُوق أَسْوَد (وعاء كبيرة من الخشب غالبا وقد يكون حديدًا يستخدم لوضع الاشياء داخله، ويكون لها عادة جهة قابلة للفتح سواء بمفاصل او بالازالة الكاملة؛ صُنْدُوْقُ السَيَّارَة قمرة تشبه الصندوق في الجزء الخلفي من السيارة يستخدم كالصندوق)\nمثال: أين صندوق البريد؟",
 "暗紅色": "أحمر داكن (لون أحمر يعكس القليل من الضوء)",
 "暗翳": "ظِلّ, خَيَال (الإستمرار في العمل. أصله للنهار ثم أصبح يشمل النهار والليل)\nمثال: ظل الولد ساكنا.",
 "暗者": "دَاعِرَة, بَغِيَّة / دَعِرَ, بَغَى (دَعِرَ الْعود دعرا دخن وَلم يتقد) / دجال, محتال (شخص يقدم ادعاءات خادعة)",
 "暗視": "رُؤْيَة لَيْلِيَّة",
 "暗記": "حِفْظ (الحِفْظُ نَقِيضُ النِّسْيَان، وهو التَّعَاهُدُ وقِلَّةُ الغَفْلَةِ؛ قِلَّةُ الغَفْلَةِ)\nمثال: حفظ رقم هاتفها.",
 "暗記力": "ذَاكِرَة, حَافِظَة / ذِكْرَى / ذَاكِرَة",
 "暗証": "دُسْتُور, دَسْتُور (قَاعِدَة) / اِصْطِلَاح / تَرْمِيز, شِفْرَة / كود, شِفْرَة\nمثال: العدالة مضمونة في الدستور.",
 "暗証化": "ترميز, تشفير (نشاط تحويل البيانات أو المعلومات إلى رمز)",
 "暗証番号": "الرقم السري, رقم التعريف الشخصي (رقم تختاره وتستخدمه للوصول إلى حسابات مختلفة)",
 "暗語": "رطانة, عامية خاصة (لغة مميزة لمجموعة معينة (كما بين اللصوص))\nمثال: هم لا يتحدثون لغتنا",
 "暗誦": "تِلَاوَة",
 "暗赤色": "أحمر داكن (لون أحمر يعكس القليل من الضوء)",
 "暗転": "غَشْيَة / تَعْتِيم",
 "暗闇": "ظَلَام, ظُلْمَة (مصدر للفعل ظَلِمَ بمعنى ذهب نوره؛ ضد النُور، هو ذهاب النور والضوء فلا يوجد ما يشع ليُرَى)\nمثال: لدي خوف من الظلام.",
 "暗順応": "تأقلم مع الظلام (عملية تكيف العينين مع مستويات منخفضة من الإضاءة؛ تتكيف المخاريط أولاً؛ تستمر العصي في التكيف لمدة تصل إلى أربع ساعات)",
 "暗騒音": "ضوضاء خلفية (ضوضاء خارجية تلوث القياسات الصوتية ولا يمكن فصلها عن الإشارة المطلوبة)",
 "暗鬱": "قتامة, كآبة (شعور بتوجس كئيب) / عتمة, قتامة (حالة من الظلام الجزئي أو الكلي) / تجهم, قتامة (جو من الاكتئاب والحزن)\nمثال: أشعل عود ثقاب ليبدد العتمة",
 "暗黒": "ظَلَام, ظُلْمَة (مصدر للفعل ظَلِمَ بمعنى ذهب نوره؛ ضد النُور، هو ذهاب النور والضوء فلا يوجد ما يشع ليُرَى)\nمثال: لدي خوف من الظلام.",
 "暗黒エネルギー": "طاقة مظلمة (القُدْرَة والشِدَّة؛ هي مقدار ما يمكن للإنسان أن يفعله بمشقة، كأن قدرته محددة بطَوْق)\nمثال: طلب بطاقة اعتماد.",
 "暗黒時代": "اَلْعُصُورُ الْمُظْلِمَةُ",
 "暗黒物質": "مَادَّة مَظْلِمَة (مؤنث مَادّ، اسم فاعل من مَدَّ. الجمع مَادَّات؛ ما كان مَدَدًا لغيره)\nمثال: لا أحب مادة العلوم.",
 "暗黒街": "سِجِّين, عَالَم سُفْلِيّ",
 "暗黙": "ضِمْنَيّ\nمثال: 我々には互いに支持しあおうという暗黙の了解があった。 — كان لدينا اتفاق ضمني بأننا سوف ندعم بعضنا البعض.",
 "暗黙的": "ضِمْنِيّ, مُطْلَق (بلا شكّ أو تحفُّظ) / ضمني, مفهوم ضمناً (مفهوم ضمناً وإن لم يتم التعبير عنه مباشرة؛ متأصل في طبيعة الشيء)\nمثال: اتفاق ضمني بعدم إثارة الموضوع",
 "暢達": "طلاقة, فصاحة (جودة السهولة في الكلام والكتابة) / طلاقة (المهارة في التحدث أو الكتابة) / بيان, طلاقة (لغة قوية وفعالة)\nمثال: جذبت فصاحته حشداً كبيراً",
 "暦": "تَقْوِيم",
 "暦年": "سنة تقويمية, سنة ميلادية (السنة (التي تحسب من 1 يناير إلى 31 ديسمبر) وفقاً للتقويم الغريغوري)",
 "暦年度": "سنة تقويمية, سنة ميلادية (السنة (التي تحسب من 1 يناير إلى 31 ديسمبر) وفقاً للتقويم الغريغوري)",
 "暦年齢": "عمر زمني (العمر مقاساً بالوقت (السنوات والشهور) الذي وجد فيه شيء أو شخص ما)\nمثال: كان عمره الزمني 71 عاماً",
 "暦数": "صَفّ (سَطْر مستقيم؛ مستوى تعليمي)\nمثال: صف كليتي وقلبي‎.",
 "暦日": "يوم تقويمي, يوم مدني (يوم يحسب من منتصف الليل إلى منتصف الليل)",
 "暦月": "شهر, شهر تقويمي (أحد الأقسام الاثني عشر للسنة التقويمية)\nمثال: دفع الفاتورة الشهر الماضي",
 "暦本": "تَقْوِيم",
 "暦法": "تَقْوِيم",
 "暦週": "أسبوع (فترة من سبعة أيام متتالية)",
 "暫く": "لبرهة, لفترة وجيزة (لفترة قصيرة)\nمثال: اجلس وابقى لبرهة / في الوقت الحالي, مؤقتاً (بشكل مؤقت)\nمثال: سنتوقف في الوقت الحالي / لَم أَرَكَ مُنْذُ وَقْت طَوِيل, لَم أَرَكِ مُنْذُ وَقْت طَوِيل (جَمَعَ، ضَمَّ)\nمثال: لم يساعدني أحد.",
 "暫くして": "حالاً, خلال وقت قصير (في المستقبل القريب) / حالياً, في الوقت الحاضر (في هذا الوقت أو الفترة؛ الآن)\nمثال: سيكون الطبيب هنا قريباً",
 "暫くの間": "لبرهة, لفترة وجيزة (لفترة قصيرة)\nمثال: اجلس وابقى لبرهة",
 "暫くぶり": "دهر, سنوات (فترة زمنية طويلة)\nمثال: نحن نعرف بعضنا منذ دهر",
 "暫く振り": "دهر, سنوات (فترة زمنية طويلة)\nمثال: نحن نعرف بعضنا منذ دهر",
 "暫し": "قَرِيبًا, سَرْعَانَ مَا",
 "暫らく": "لبرهة, لفترة وجيزة (لفترة قصيرة)\nمثال: اجلس وابقى لبرهة / في الوقت الحالي, مؤقتاً (بشكل مؤقت)\nمثال: سنتوقف في الوقت الحالي / لَم أَرَكَ مُنْذُ وَقْت طَوِيل, لَم أَرَكِ مُنْذُ وَقْت طَوِيل (جَمَعَ، ضَمَّ)\nمثال: لم يساعدني أحد.",
 "暫定": "مُؤَقَّت, مَشْرُوط",
 "暫定協定": "أسلوب حياة, نمط حياة (طريقة للعيش تعكس قيم الشخص ومواقفه) / تسوية مؤقتة, وضع مؤقت (تسوية مؤقتة لخلاف بين الأطراف ريثما يتم التوصل إلى تسوية دائمة)",
 "暫定的": "مُؤَقَّت, مَشْرُوط",
 "暮": "غُرُوب, مَغْرِب (المَغْرِب، أيْ الوَقْت الذي تَغْرُبُ فيه الشَمْس) / غُرُوب اَلشَّمْس (المَغْرِب، أيْ الوَقْت الذي تَغْرُبُ فيه الشَمْس) / خَاتِمَة, قَيَامَة\nمثال: نحب غروب الشمس. / نِهَايَة, غَايَة / غَايَة / اِنْتَهَى, أَنْهَى (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات)\nمثال: انتهى أمر زيري. / فِي نِهَايَةِ العَام (يَجْرِي فِي خِتَامِ السَّنَةِ المَالِيَّةِ) / نهاية العام (نهاية السنة التقويمية)\nمثال: اضطر لتفريغ البضائع قبل نهاية العام",
 "暮し": "حَياة (الحَياة: ضد الموت والحَيُّ: ضدُّ الميّت؛ والمَحْيا مَفْعَلٌ من الحياة. تقول: مَحْيَاي ومماتي. والجمع الحَحايي)\nمثال: ما أغرب الحياة!",
 "暮しむき": "نَمَط الحَيَاة",
 "暮し向き": "نَمَط الحَيَاة",
 "暮す": "حَيِيَ, عَاشَ / يَنْجُو / حَيّ (ضد المَيِّت، على قيد الحَيَاة؛ جمع حَيَاء) / مُباشِر\nمثال: ينبح كلب في الحي. / اِرْتَزَقَ",
 "暮らし": "حَياة (الحَياة: ضد الموت والحَيُّ: ضدُّ الميّت؛ والمَحْيا مَفْعَلٌ من الحياة. تقول: مَحْيَاي ومماتي. والجمع الحَحايي)\nمثال: ما أغرب الحياة!",
 "暮らしが立つ": "اِرْتَزَقَ",
 "暮らしぶり": "نَمَط الحَيَاة",
 "暮らしむき": "نَمَط الحَيَاة",
 "暮らしを立てる": "اِرْتَزَقَ",
 "暮らし向き": "نَمَط الحَيَاة",
 "暮らし振り": "نَمَط الحَيَاة",
 "暮らす": "حَيِيَ, عَاشَ / يَنْجُو / حَيّ (ضد المَيِّت، على قيد الحَيَاة؛ جمع حَيَاء) / مُباشِر\nمثال: ينبح كلب في الحي. / اِرْتَزَقَ",
 "暮れ": "غُرُوب, مَغْرِب (المَغْرِب، أيْ الوَقْت الذي تَغْرُبُ فيه الشَمْس) / غُرُوب اَلشَّمْس (المَغْرِب، أيْ الوَقْت الذي تَغْرُبُ فيه الشَمْس) / خَاتِمَة, قَيَامَة\nمثال: نحب غروب الشمس. / نِهَايَة, غَايَة / غَايَة / اِنْتَهَى, أَنْهَى (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات)\nمثال: انتهى أمر زيري. / فِي نِهَايَةِ العَام (يَجْرِي فِي خِتَامِ السَّنَةِ المَالِيَّةِ) / نهاية العام (نهاية السنة التقويمية)\nمثال: اضطر لتفريغ البضائع قبل نهاية العام",
 "暮れゆく": "انحسار, تضاؤل (انخفاض تدريجي (في الحجم أو القوة أو السلطة أو العدد))",
 "暮れる": "نِهَايَة, غَايَة / غَايَة / اِنْتَهَى, أَنْهَى (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات)\nمثال: انتهى أمر زيري.",
 "暮れ方": "مَسَاء",
 "暮れ暮れ": "هُبُوط, غَسَق",
 "暮れ行く": "انحسار, تضاؤل (انخفاض تدريجي (في الحجم أو القوة أو السلطة أو العدد))",
 "暮夜": "لَيْلَة, لَيْل (واحِدَة اللَيْل، وهو الزمن في اليوم من مَغْرِب الشمس حتى طلوع الفَجْر. قيل الليل والليلة واحد وقيل الليل ضد النهار والليلة ضد اليوم وقيل الليلة مفرد…؛ أحيانا تستخدم بمعنى اليَوْم كما يستخدم اليوم بمعنى النَهَار) / عشية, ليلة / مَغْرِب, مغْرب (مَكَان غُرُوب الشَمْس، ويقصد به الغَرْب مجَازًا؛ زَمَان غروب الشمس)\nمثال: كانت ليلة رائعة.",
 "暮方": "مَسَاء",
 "暮色": "عِشَاء, غَسَق (طَعَام العَشِيّ. وهو الطعام الذي يؤكل في المَسَاء) / يَغْسِق, يَعْتِم\nمثال: هل العشاء جاهز؟",
 "暮色蒼然": "أَسْمَر البَشَرَة, دَاكِن البَشَرَة (ذو بشرة داكنة بطبيعتها) / شَفَقِيّ, مُتَلَأْلِئ بِنُور الغُرُوب (مُضَاء بِنُور الشَّفَق أَوْ كَأَنَّهُ كَذَلِك)",
 "暴": "عُنْف, عَنْف / عُنْف",
 "暴き立てる": "فضح, كشف القناع (فضح محتال أو مخادع)\nمثال: نشر فضيحة عن الرشوة والفساد في حكومة المدينة",
 "暴く": "أَفْشَى / مَفْتُوح / فَتَحَ (ضد أغْلَقَ وسَدَّ؛ تركه بلا شيء يسده؛ الطريق: جعلها سالكة للطارقين) / فتح (ضد أغْلَقَ وسَدَّ؛ تركه بلا شيء يسده؛ الطريق: جعلها سالكة للطارقين) / حل (للعقدة: ضد عَقْدها؛ للجامد في السائل: إذابته) / اِنْفَتَحَ (فعل مطاوعة لفَتَحَ، فَتَحْتُهُ فانْفَتَح؛ يستخدم عوضا عن المبنى للمجهول فُتِحَ. )\nمثال: فتح الباب آليا.",
 "暴れまわる": "عربدة, هيجان (سلوك عنيف غاضب ومدمر)",
 "暴れる": "حَنَق ((حَنِقَ) عَلَيْهِ حنقا: اشْتَدَّ غيظه فَهُوَ حنق وحنيق) / غَضِبَ, اِنْدَلَعَ",
 "暴れん坊": "دَمَوِيّ, سَفَّاح",
 "暴れ回る": "عربدة, هيجان (سلوك عنيف غاضب ومدمر)",
 "暴れ狂う": "حَنَق ((حَنِقَ) عَلَيْهِ حنقا: اشْتَدَّ غيظه فَهُوَ حنق وحنيق) / غَضِبَ, اِنْدَلَعَ",
 "暴れ者": "بلطجي, فتوة (رجل قاسٍ ووحشي)",
 "暴利": "رِبَا (في : طلب مَالٍ أكثر من الذي حدده القانون)",
 "暴力": "عُنْف, عَنْف / عُنْف",
 "暴力団": "عصابة, نقابة الجريمة (تحالف فضفاض من رجال العصابات المسؤولين عن الأنشطة الإجرامية المنظمة)\nمثال: 暴力団は強盗を計画していた。 — خططت العصابة لسرقة.",
 "暴力団員": "سَارِق, عُضْو فِي عِصَابَة (اسم فاعل من سَرَقَ، الذي قام بالسرقة؛ لصّ، حرامي)\nمثال: ياني سارق بنوك.",
 "暴力団組員": "يَاكُوزَا",
 "暴力的": "عَنِيف",
 "暴動": "انتفاضة",
 "暴動鎮圧": "مكافحة الشغب (التدابير المتخذة للسيطرة على أعمال الشغب)",
 "暴君": "طَاغِيَة",
 "暴君竜": "تيرانوصور, تيرانوصور ريكس (ديناصور لاحم كبير ثنائي الأرجل له أسنان ضخمة ذات حواف مسننة تشبه السكاكين؛ ربما كان قمّاماً (آكل جيف) بدلاً من مفترس نشط؛ من أواخر العصر الطباشيري في…)",
 "暴噴": "احتفال بهيج, حفل (احتفال مبهج أو مناسبة اجتماعية كبيرة) / انفجار, عطل مفاجئ (عطل مفاجئ في جزء أو جهاز) / اكتساح, فوز سهل (انتصار سهل)\nمثال: انفجر الإطار الأمامي الأيمن",
 "暴威": "طُغْيَان, اِسْتِبْدَاد",
 "暴富": "مُحْدَث اَلنَّعْمَة",
 "暴帝": "طَاغِيَة",
 "暴徒": "مثير للشغب, مشاغب (مثير للمتاعب يشارك في اضطرابات عنيفة تخل بالأمن؛ شخص يتمرد على السلطة القائمة)",
 "暴徒化": "شغب (حالة من الاضطراب تنطوي على عنف جماعي)",
 "暴悪": "عُنْف, عَنْف / عُنْف",
 "暴悪無類": "شَيْطَانِيّ",
 "暴慢": "سَيِّئُ الأَدَبِ, وَقِح (غير صحيح السلوك اجتماعياً)",
 "暴戻": "طُغْيَان, اِسْتِبْدَاد",
 "暴投": "رمية طائشة (رمية شاردة لا يُتوقع من الماسك التقاطها وتسمح لعداء القاعدة بالتقدم)",
 "暴挙": "عُنْف, عَنْف / عُنْف",
 "暴政": "طُغْيَان, اِسْتِبْدَاد",
 "暴民": "رعاع, غوغاء (حشد غير منظم من الناس) / عصابة (رابطة من المجرمين) / عصابة, نقابة الجريمة (تحالف فضفاض من رجال العصابات المسؤولين عن الأنشطة الإجرامية المنظمة)\nمثال: حاولت الشرطة تفكيك العصابة",
 "暴漢": "بلطجي, سفاح (مجرم شاب عدواني وعنيف)",
 "暴落": "تراجع, ركود (تدهور ملحوظ في الأداء أو الجودة) / أزمة اقتصادية, كساد (حالة اقتصادية طويلة الأمد تتميز بالبطالة وانخفاض الأسعار ومستويات منخفضة من التجارة والاستثمار)\nمثال: دخل الفريق في حالة ركود",
 "暴虐": "طُغْيَان, اِسْتِبْدَاد",
 "暴行": "اِعْتِدَاء, حَمْلَة / اِغْتِصَاب (أَخْذُ الشيء قَهْراً وَظُلْماً؛ اِسْتِخْدَامُ العُنْفِ مَعَ النساء لِنَيْلِ الحَاجَةِ مِنْهَن بِالرَّغْمِ عَنْهَن) / اِغْتَصَبَ, غَصَبَ (غَصَبَ؛ زَنَى (بِفُلَانَةٍ) قَهْرًا/غَصْبًا)\nمثال: تعرض زيري للاغتصاب.",
 "暴行罪": "اِعْتِدَاء, حَمْلَة",
 "暴走": "عربدة, هيجان (سلوك عنيف غاضب ومدمر) / آبِق",
 "暴露": "إفشاء, كشف (الفعل الكلامي لجعل الشيء واضحاً)",
 "暴風": "عَاصِفَة / طُوفَان (عاصفة) / عَاصْفة",
 "暴風雨": "عاصفة مطرية (عاصفة مصحوبة بمطر)",
 "暴風雪": "عَاصِفَة ثَلْجِيَّة, دَمَق",
 "暴食": "شراهة, نهم (الأكل بإفراط (تُشخص كإحدى الخطايا السبع المميتة))",
 "暴食家": "أَكَّال, شَرَه",
 "暴騰": "ذراع التطويل, عوارضة (أي من الصواري أو الأعمدة الأفقية المتنوعة المستخدمة لتمديد أسفل الشراع أو لمناولة البضائع أو في الإرساء) / بوم, ذراع الميكروفون (عمود يحمل ميكروفوناً علوياً مسلطاً فوق موقع تصوير فيلم أو تلفزيون) / دوي, رعد (ضجيج عميق طويل وعالٍ) / رزق ساقه الله, رواج (حدث مفاجئ يجلب الحظ السعيد (مثل فرصة مفاجئة لكسب المال))\nمثال: خلق الطلب على الاختبار طفرة لتلك المختبرات غير الخاضعة للتنظيم",
 "暹": "سِيَام",
 "暹羅": "سِيَام",
 "暹羅鶏": "دجاج الصيد (أي من السلالات المتعددة التي تربى لمصارعة الديوك)",
 "曇": "تَغَيُّم, كُدْرَة (صفة كون الشيء غائماً) / تلبد الغيوم, غائم (شبه ظلام كئيب ناتج عن غطاء سحابي) / تغيم, غطاء سحابي (حالة السماء عندما تكون مغطاة بالسحب)\nمثال: 昨日、東京は曇りでしたか。 — أكان الجو غائماً في طوكيو البارحة؟ / ضَبَاب, شبورة / قتامة, كآبة (شعور بتوجس كئيب) / عتمة, قتامة (حالة من الظلام الجزئي أو الكلي) / تجهم, قتامة (جو من الاكتئاب والحزن)\nمثال: أشعل عود ثقاب ليبدد العتمة",
 "曇らす": "اسوداد, صدأ (تغير لون السطح المعدني الناتج عن الأكسدة)",
 "曇らせる": "سَحَاب, غَيْم (الغيوم المتحركة؛ غُيُوم، دَيْم)\nمثال: القمر موجود خلف السحاب.",
 "曇り": "تَغَيُّم, كُدْرَة (صفة كون الشيء غائماً) / تلبد الغيوم, غائم (شبه ظلام كئيب ناتج عن غطاء سحابي) / تغيم, غطاء سحابي (حالة السماء عندما تكون مغطاة بالسحب)\nمثال: 昨日、東京は曇りでしたか。 — أكان الجو غائماً في طوكيو البارحة؟ / ضَبَاب, شبورة / قتامة, كآبة (شعور بتوجس كئيب) / عتمة, قتامة (حالة من الظلام الجزئي أو الكلي) / تجهم, قتامة (جو من الاكتئاب والحزن)\nمثال: أشعل عود ثقاب ليبدد العتمة",
 "曇度": "إِعْتَام, قَتَامَة (صفة كون الشيء معتماً لدرجة ما؛ الدرجة التي يمنع بها الشيء مرور الضوء) / إِبْهَام, غُمُوض (عدم القدرة على الفهم الناتج عن غموض المعنى) / عتامة (ظاهرة عدم السماح بمرور الإشعاع الكهرومغناطيسي)",
 "曉": "فَجْر (هو آخر اللَيْل أو أول النَهَار حين تنصدع الظُلْمَة من النُور) / فَجْر, فَلَق (هو آخر اللَيْل أو أول النَهَار حين تنصدع الظُلْمَة من النُور) / شُرُوق (البُزُوغ، الطُلُوع؛ الوَقْت الذي تَشْرُق فيه الشَمْس) / شُرُوق, مَشْرِق (البُزُوغ، الطُلُوع؛ الوَقْت الذي تَشْرُق فيه الشَمْس)\nمثال: فجر توم البالونة. / وَاقِعَة, حَادِثَة (مؤنث الوَاقِع، اسم فاعل للشيء المؤنث الذي وَقَعَ؛ مؤنث وَاقِع، الأمر المؤنث الحاصل)\nمثال: الصخور الواقعة تشكل خطرا على المتسلقين.",
 "曖々": "خَافِت, مُعْتَدِل الإِضَاءَة (ضَعِيف الضَّوْء؛ غَيْر سَاطِعٍ أَوْ قَاسٍ) / مُخْفَت, مُعْتِم (جُعل معتماً أو أقل سطوعاً) / بَطِيء الفَهْم, كَلِيل الذِّهْن (بطيء التعلّم والاستيعاب؛ يفتقر إلى الحدّة الذهنيّة) / بَاهِت, خَافِت (يَفْتَقِر إِلَى الوُضُوح أَوِ التَّمَيُّز)\nمثال: أضواء القاعة المخفتة جلبت صمتاً من الترقب",
 "曖昧": "غَامِض, مُبْهَم (غير واضح التعبير أو المعنى) / غامض, غير محدد (غير محدود أو مقرر أو مميز بدقة) / بَاهِت, خَافِت (يَفْتَقِر إِلَى الوُضُوح أَوِ التَّمَيُّز)\nمثال: مصطلح غير محدد (مبهم) / ظَلِيل, وَارِف الظِّلّ (مَمْلُوء بِالظِّلّ) / مَشْبُوه (مشكوك في نزاهته أو قانونيَّته) / مُثِيرٌ لِلشُّبْهَة, مُرِيب (ليس كما هو متوقّع؛ يبعث على الريبة) / مُسْتَتِر, مُظْلِم (هادئ ومعتم أو مستتر عن الأنظار) / مُزَغَّب, وَبِرِيّ (مكسو بشعيرات خفيفة ودقيقة) / ضَبَابِيّ, غَامِض (مشوّش وغير متماسك؛ غير مُحكم التفكير) / ضَبَابِيّ, مُشَوَّش (غَيْر وَاضِح أَوْ مُبْهَم الخُطُوط)",
 "曖昧さ": "اِلْتِبَاس / إِبْهَام (الإِصْبَعُ الغليظةُ الخامسةُ من أَصابع اليد والرِّجل، وهي ذات سُلامَيَيْن (مؤنثة وقد تذكَّر) والجمع: أباهيم، وإبهامات)",
 "曖昧さ回避": "تَوْضِيح",
 "曖昧度": "مراوغة, مواربة (التزييف عن طريق لغة غامضة أو ملتبسة) / غموض متعمد, مراوغة (الغموض أو الإبهام المتعمد في الكلام) / تهرب, مراوغة (بيان ليس كاذباً حرفياً ولكنه يتجنب بذكاء حقيقة غير سارة)",
 "曖昧性": "اِلْتِبَاس / إِبْهَام (الإِصْبَعُ الغليظةُ الخامسةُ من أَصابع اليد والرِّجل، وهي ذات سُلامَيَيْن (مؤنثة وقد تذكَّر) والجمع: أباهيم، وإبهامات)",
 "曖昧性解消": "تَوْضِيح",
 "曖昧模糊": "مُظْلِم",
 "曖昧論理": "اَلْمَنْطِقُ الضَّبَابِيُّ",
 "曖昧量": "مراوغة, مواربة (التزييف عن طريق لغة غامضة أو ملتبسة) / غموض متعمد, مراوغة (الغموض أو الإبهام المتعمد في الكلام) / تهرب, مراوغة (بيان ليس كاذباً حرفياً ولكنه يتجنب بذكاء حقيقة غير سارة)",
 "曖曖": "خَافِت, مُعْتَدِل الإِضَاءَة (ضَعِيف الضَّوْء؛ غَيْر سَاطِعٍ أَوْ قَاسٍ) / مُخْفَت, مُعْتِم (جُعل معتماً أو أقل سطوعاً) / بَطِيء الفَهْم, كَلِيل الذِّهْن (بطيء التعلّم والاستيعاب؛ يفتقر إلى الحدّة الذهنيّة) / بَاهِت, خَافِت (يَفْتَقِر إِلَى الوُضُوح أَوِ التَّمَيُّز)\nمثال: أضواء القاعة المخفتة جلبت صمتاً من الترقب",
 "曙": "فَجْر (هو آخر اللَيْل أو أول النَهَار حين تنصدع الظُلْمَة من النُور) / فَجْر, فَلَق (هو آخر اللَيْل أو أول النَهَار حين تنصدع الظُلْمَة من النُور) / شُرُوق (البُزُوغ، الطُلُوع؛ الوَقْت الذي تَشْرُق فيه الشَمْس) / شُرُوق, مَشْرِق (البُزُوغ، الطُلُوع؛ الوَقْت الذي تَشْرُق فيه الشَمْس)\nمثال: فجر توم البالونة.",
 "曙光": "فَجْر (هو آخر اللَيْل أو أول النَهَار حين تنصدع الظُلْمَة من النُور) / فَجْر, فَلَق (هو آخر اللَيْل أو أول النَهَار حين تنصدع الظُلْمَة من النُور) / شُرُوق (البُزُوغ، الطُلُوع؛ الوَقْت الذي تَشْرُق فيه الشَمْس) / شُرُوق, مَشْرِق (البُزُوغ، الطُلُوع؛ الوَقْت الذي تَشْرُق فيه الشَمْس)\nمثال: فجر توم البالونة. / لمحة, نظرة خاطفة (نظرة سريعة) / لمحة, نظرة خاطفة (رؤية موجزة أو غير كاملة) / لمحة (إشارة غامضة)\nمثال: من النافذة استطاع أن يلمح البحيرة لمحة سريعة",
 "曙色": "حُوت سُلَيْمَان, سَلَمُون (سمكة صَغيرة كانت أو كبيرة؛ حوت كبير: صاحب مال وسَطْوَة ونفوذ)\nمثال: هل الحوت من الثدييات؟",
 "曜日": "يوم من أيام الأسبوع (أي واحد من الأيام السبعة في الأسبوع)",
 "曜霊": "شَمْس, شمس (الشَّمْسُ: النَّجْمُ الرئيسُ الذي تدور حوله الْأَرْض، وسائر كواكب المجموعة الشمسية؛ الشَّمس: اسم سورة من سور القرآن الكريم، وهي السُّورة رقم 91 في ترتيب المصحف، مكِّيَّة، عدد آياتها خمس عشرة آية) / مثال: نحب غروب الشمس.",
 "曝": "مَادَّة تَبْيِيض (مؤنث مَادّ، اسم فاعل من مَدَّ. الجمع مَادَّات؛ ما كان مَدَدًا لغيره) / بَيَّضَ (الأيام البِيض: الأيام التي توافق اليوم الثالث عشر، والرابع عشر، والخامس عشر من كل شهر من أشهر العام الهجري، وقد سُمِّيت بذلك…)\nمثال: لا أحب مادة العلوم. / دوكسينغ, كشف الهوية (نشر المعلومات الشخصية لشخص ما على الويب بقصد التسبب في المضايقة)",
 "曝け出す": "فضح, كشف القناع (فضح محتال أو مخادع)\nمثال: نشر فضيحة عن الرشوة والفساد في حكومة المدينة",
 "曝し": "مَادَّة تَبْيِيض (مؤنث مَادّ، اسم فاعل من مَدَّ. الجمع مَادَّات؛ ما كان مَدَدًا لغيره) / بَيَّضَ (الأيام البِيض: الأيام التي توافق اليوم الثالث عشر، والرابع عشر، والخامس عشر من كل شهر من أشهر العام الهجري، وقد سُمِّيت بذلك…)\nمثال: لا أحب مادة العلوم. / دوكسينغ, كشف الهوية (نشر المعلومات الشخصية لشخص ما على الويب بقصد التسبب في المضايقة)",
 "曝し台": "مقطرة (أداة عقاب خشبية على عمود بفتحات للمعصمين والرقبة؛ كان المخالفون يُحبسون فيها ويتعرضون للسخرية العامة)",
 "曝す": "فضح, كشف القناع (فضح محتال أو مخادع)\nمثال: نشر فضيحة عن الرشوة والفساد في حكومة المدينة / مَادَّة تَبْيِيض (مؤنث مَادّ، اسم فاعل من مَدَّ. الجمع مَادَّات؛ ما كان مَدَدًا لغيره) / بَيَّضَ (الأيام البِيض: الأيام التي توافق اليوم الثالث عشر، والرابع عشر، والخامس عشر من كل شهر من أشهر العام الهجري، وقد سُمِّيت بذلك…)\nمثال: لا أحب مادة العلوم. / شَطَفَ (غسل أو نظف الشيء بالماء، غالبًا بمعنى التنظيف العميق؛ في بعض الاستخدامات، يمكن أن تعني إزالة ما علق بالشيء من أوساخ أو شوائب) / مَضْمَضَ",
 "曝れる": "طَقْس, جَوّ",
 "曝気": "تَهْوِيَة",
 "曝露": "إفشاء, كشف (الفعل الكلامي لجعل الشيء واضحاً)",
 "曠々": "شَامِل, وَاسِعُ النِّطَاق (واسع في نطاقه أو محتواه؛ يغطّي مجالات عديدة) / مُمْتَدّ, وَاسِع النِّطَاق (كبير في الامتداد المكاني أو النطاق أو الكمية) / توسعي, واسع النطاق (للزراعة؛ زيادة الإنتاجية باستخدام مناطق واسعة بحد أدنى من النفقات والعمالة)\nمثال: إنتاج القمح في ظل ظروف واسعة النطاق",
 "曠世": "فَرِيدٌ مِنْ نَوْعِه, لَا يُضَاهَى (مُتميّز جذريًّا وليس له مثيل أو نظير)",
 "曠劫": "أيون, دهر ((الغنوصية) قوة إلهية أو طبيعة تنبثق من الكائن الأسمى وتلعب أدواراً مختلفة في عمل الكون) / حقب, دهر (فترة زمنية طويلة لا يمكن قياسها) / دهر (أطول قسم في الزمن الجيولوجي)\nمثال: أوه، لقد حدث ذلك منذ دهر",
 "曠古": "تَارِيخِيّ (مهمّ في التاريخ؛ ذو أثر تاريخيّ) / تَارِيخِيّ (يَنْتَمِي لِلْمَاضِي؛ ذُو أَهَمِّيَّةٍ أَوْ شُهْرَةٍ تَارِيخِيَّة)",
 "曠曠": "شَامِل, وَاسِعُ النِّطَاق (واسع في نطاقه أو محتواه؛ يغطّي مجالات عديدة) / مُمْتَدّ, وَاسِع النِّطَاق (كبير في الامتداد المكاني أو النطاق أو الكمية) / توسعي, واسع النطاق (للزراعة؛ زيادة الإنتاجية باستخدام مناطق واسعة بحد أدنى من النفقات والعمالة)\nمثال: إنتاج القمح في ظل ظروف واسعة النطاق",
 "曠然": "شَامِل, وَاسِعُ النِّطَاق (واسع في نطاقه أو محتواه؛ يغطّي مجالات عديدة) / مُمْتَدّ, وَاسِع النِّطَاق (كبير في الامتداد المكاني أو النطاق أو الكمية) / توسعي, واسع النطاق (للزراعة؛ زيادة الإنتاجية باستخدام مناطق واسعة بحد أدنى من النفقات والعمالة)\nمثال: إنتاج القمح في ظل ظروف واسعة النطاق",
 "曰う": "قَالَ, قال (نَطَقَ بالكلام) / يَتْلُو / قَالَ, يَقُول (نَطَقَ بالكلام)\nمثال: قال زيري وداعا.",
 "曰く": "ذَرِيعَة, عُذْر",
 "曰くありげ": "ذُو مَعْنًى (أحد الأسماء الستة، لا يأتي إلا مُضَافًا، بمعنى صاحب)\nمثال: كان رجل ذو قامة طويله.",
 "曰ふ": "قَالَ, قال (نَطَقَ بالكلام) / يَتْلُو / قَالَ, يَقُول (نَطَقَ بالكلام)\nمثال: قال زيري وداعا.",
 "曲": "مُؤَلَّف, مُصَنَّف / لَحْن (وضع الألحان أو التأليف الموسيقي؛ قرأ النص بلحن أو أداء صوتي مميز)\nمثال: أنا أحب هذا اللحن. / مُتْعَة, مِتْعَة / شر, فجور (سلوك مرفوض أخلاقياً) / بَشَاعَة, خِسَّة (صفة كون الشيء مقرفاً للحواس أو المشاعر) / إثم, خطيئة (الابتعاد عن الله) / خباثة, دناءة (صفة الشر والفساد الأخلاقي)\nمثال: فاجأتنا بشاعة لغته / مُخْطِئ / ظَلَمَ (الثَلَاثُ الظُلَم: الليلة التاسعة عشر، والعشرون، والحادية والعشرون من كل شهر قمري، وسميت بذلك لظلمتها. يسبقها الثلاث الدُرَع ويليها الثلاث الحنادس)\nمثال: نحن نرفض الظلم.",
 "曲々": "تدوير, ملء (عملية التدوير أو اللف) / مُتَعَرِّج, مُتَلَوٍّ ((عَنِ الطَّرِيق) كَثِير المُنْعَطَفَات وَالِالْتِوَاءَات) / مُتَعَرِّج, مُلْتَوٍ (يتميز بمنعطفات وانحناءات متكررة)\nمثال: وضع المفتاح في الساعة القديمة وأعطاها تدويراً جيداً",
 "曲がった": "مُجَعَّد, مُنْبَعِج (عن المعدن مثلاً؛ مُحنٍ أو مُنبعِج) / مُقَوَّس, مُنْحَنٍ (يُوصَف للظهر والرُّكبتين؛ في وضع انحناء) / عَاقِدُ الْعَزْمِ, مُصَمِّمٌ عَلَى (ثابت في هدفه وعزمه) / براعة, مهارة خاصة (طريقة خاصة أو مهارة فطرية للقيام بشيء ما)\nمثال: كان لديه ميل لذلك / عَلَى نَحْو خَاطِئ, مُنْحَرِفًا (بعيداً عن المسار الصحيح أو المتوقع) / مَائِلًا, مُنْحَرِفًا (مقلوب أو ملتو إلى جانب واحد)\nمثال: شيء ما انحرف في خططنا",
 "曲がない": "رَتِيب, عَادِيّ (غير مُلهِم ولا يُشكِّل تحدياً؛ باهت وخالٍ من الإثارة) / عَادِيّ تَمَامًا, مُبْتَذَل (عادي تماماً ولا يستحق الملاحظة) / مُبْتَذَل, مُسْتَهْلَك (مُكرَّر أكثر من اللازم؛ مألوف بشكل مفرط بسبب كثرة الاستخدام) / عبارة مبتذلة, قول مأثور مبتذل (ملاحظة مبتذلة أو واضحة بشكل مفرط) / انطوائي, غير اجتماعي (لا يميل إلى المجتمع أو الرفقة)\nمثال: طبيعة غير اجتماعية؛ خجول ومتحفظ",
 "曲がり": "انحناء",
 "曲がりくねる": "بشكل متعرج (في مسار متعرج أو على طريق متعرج) / زِيكْزَاكِيّ, مُتَعَرِّج (ذو منعطفات حادة وقصيرة أو زوايا متتالية) / زجزاج, متعرج (شكل زاوي يتميز بمنعطفات حادة في اتجاهات متبادلة)\nمثال: طارت الطيور بشكل متعرج عبر السماء الزرقاء",
 "曲がりなりにも": "بشكل ما, بطريقة أو بأخرى (بطريقة أو أسلوب غير محدد؛ أو بوسيلة غير محددة) / بطريقة ما, لسبب ما (لسبب غير محدد)\nمثال: لقد تدبروا الأمر بطريقة ما",
 "曲がり家": "مرهن",
 "曲がり尺": "زاوية النجار (زاوية فولاذية يستخدمها النجارون؛ أكبر من الزاوية القائمة العادية)",
 "曲がり屋": "مرهن",
 "曲がり目": "زَاوِيَة, رُكْن",
 "曲がり角": "زَاوِيَة, رُكْن / نقطة تحوّل (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه)\nمثال: هذه هي نقطة ضعفه.",
 "曲がり金": "زاوية النجار (زاوية فولاذية يستخدمها النجارون؛ أكبر من الزاوية القائمة العادية)",
 "曲がる": "ثَنَى (طوى شيئًا وجعله على شكل مزدوج؛ أعاد النظر أو غير مسار قراره أو تصرفه) / دَارَ, أَدَارَ (المحل يجمع البِنَاء والعَرَصَة. قيل سمي كذلك لدوران الناس به وعليه وحوله. يجمع على دُور؛ المنزل المَبْني. يجمع على دُور) / لَفَّ / قَلَبَ / اِنْقَلَبَ, صَارَ / اِنْعِطَاف / دَوْر, نَوْبَة (جَعَله يَدُور؛ جَعَلَه مُدَوَّر)\nمثال: إذهب إلى الدار.",
 "曲げ": "انثناء, ثني (فعل ثني مفصل؛ خاصة المفصل بين عظام طرف بحيث تقل الزاوية بينهما) / انثناء, ثنية (شكل زاوي أو مستدير ناتج عن الطي) / انثناء, ثني (حالة الانثناء (كما في المفصل))\nمثال: طية في المنديل",
 "曲げる": "ثَنَى (طوى شيئًا وجعله على شكل مزدوج؛ أعاد النظر أو غير مسار قراره أو تصرفه)\nمثال: 少年は考えを曲げなかった。 — لم يغير الولد رأيه. / مَالَ (ما يملك الإنسان من كل شيء ويشمل النقد والعَيْن؛ عند البدو: هي النعم والإبل تحديدا) / اِسْتَنَدَ, اِتَّكَأَ\nمثال: أريد بعض المال. / ثَنَى (طوى شيئًا وجعله على شكل مزدوج؛ أعاد النظر أو غير مسار قراره أو تصرفه) / أَجْزَأَ (أَجْزَأَ القومُ: جَزَأَتْ إِبِلُهُمْ؛ أَجْزَأَ المرأَةُ: ولدت الإِنَاث) / أَجْزَى / أَدَرَّ ((أَدِرَ) أدرا وأدرة وأدرة: انتفخت خصيته لتسرب سائل في غلافها فهو آدر وأدرت الخصية فهي أدراء (ج) أدر) / أَغَلَّ / أَكْسَبَ / أَمَّنَ (وَثِقَ به وأرْكَنَ إليه) / إِفَادَة / إِفَادَةٌ مِنْ / إِنْتاج / إِيراد / اِسْتِفَادَة / جَدَاء\nمثال: لا أدر لماذا بكيت هذا القدر كله.",
 "曲げ易い": "طَيِّع, قَابِلٌ لِلثَّنْي (يُمْكِنُ ثَنْيُهُ أَوْ لَيُّهُ دُونَ أَنْ يَنْكَسِرَ) / طَيِّع, مَرِن (قَادِرٌ عَلَى التَّكَيُّفِ بِسُهُولَةٍ مَعَ ظُرُوفٍ مُخْتَلِفَةٍ) / طَيِّع, قَابِل لِلتَّشْكِيل (قابل للتشكيل أو الثني أو السحب) / قَابِل لِلتَّشْكِيل, مَرِن (قابل للتأثير أو التشكيل)",
 "曲げ物屋": "مرهن",
 "曲のない": "مُمِلّ المُؤَسَّسَاتِيَّة (يتَّسم بطابع المؤسَّسة خاصَّة في الرتابة والجمود) / غير مثير للاهتمام, ممل (لا يثير أي اهتمام أو انتباه أو فضول أو إثارة)\nمثال: رواية غير مثيرة للاهتمام للغاية عن رحلتها",
 "曲の無い": "مُمِلّ المُؤَسَّسَاتِيَّة (يتَّسم بطابع المؤسَّسة خاصَّة في الرتابة والجمود) / غير مثير للاهتمام, ممل (لا يثير أي اهتمام أو انتباه أو فضول أو إثارة)\nمثال: رواية غير مثيرة للاهتمام للغاية عن رحلتها",
 "曲り": "انحناء",
 "曲りくねる": "بشكل متعرج (في مسار متعرج أو على طريق متعرج) / زِيكْزَاكِيّ, مُتَعَرِّج (ذو منعطفات حادة وقصيرة أو زوايا متتالية) / زجزاج, متعرج (شكل زاوي يتميز بمنعطفات حادة في اتجاهات متبادلة)\nمثال: طارت الطيور بشكل متعرج عبر السماء الزرقاء",
 "曲り家": "مرهن",
 "曲り尺": "زاوية النجار (زاوية فولاذية يستخدمها النجارون؛ أكبر من الزاوية القائمة العادية)",
 "曲り屋": "مرهن",
 "曲り目": "زَاوِيَة, رُكْن",
 "曲り角": "زَاوِيَة, رُكْن / نقطة تحوّل (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه)\nمثال: هذه هي نقطة ضعفه.",
 "曲り金": "زاوية النجار (زاوية فولاذية يستخدمها النجارون؛ أكبر من الزاوية القائمة العادية)",
 "曲る": "ثَنَى (طوى شيئًا وجعله على شكل مزدوج؛ أعاد النظر أو غير مسار قراره أو تصرفه) / دَارَ, أَدَارَ (المحل يجمع البِنَاء والعَرَصَة. قيل سمي كذلك لدوران الناس به وعليه وحوله. يجمع على دُور؛ المنزل المَبْني. يجمع على دُور) / لَفَّ / قَلَبَ / اِنْقَلَبَ, صَارَ / اِنْعِطَاف / دَوْر, نَوْبَة (جَعَله يَدُور؛ جَعَلَه مُدَوَّر)\nمثال: إذهب إلى الدار.",
 "曲事": "شر, فجور (سلوك مرفوض أخلاقياً) / بَشَاعَة, خِسَّة (صفة كون الشيء مقرفاً للحواس أو المشاعر) / إثم, خطيئة (الابتعاد عن الله) / خباثة, دناءة (صفة الشر والفساد الأخلاقي)\nمثال: فاجأتنا بشاعة لغته / زَوَر, عِوَج (زَوَّرَ الطائرُ: أَكَلَ حتى امتلأَت حوصَلتُه وارتفعت؛ زَوَّرَ الشىءَ: أَصلَحَه وقوَّمَه وأَتقنه)",
 "曲作り": "تأليف موسيقي, عمل موسيقي (عمل موسيقي تم إبداعه)\nمثال: التأليف مكتوب في أربع حركات",
 "曲射": "نيران بزاوية عالية (نيران من مدفع يتم إطلاقها بارتفاع أكبر من الارتفاع الأقصى للمدى)",
 "曲射砲": "مورتر, هاون (مدفع يلقم من الفوهة ذو سبطانة قصيرة يطلق القذائف بزوايا مرتفعة لمدى قصير)",
 "曲尺": "زاوية النجار (زاوية فولاذية يستخدمها النجارون؛ أكبر من الزاوية القائمة العادية)",
 "曲庇": "مَرْفَأ, مَرْسَى",
 "曲度": "انحناء",
 "曲彔": "مُحْدَوْدِب, مُنْحَنِي الظَّهْر (ذو ظهر وكتفَين مُنحنيَين؛ غير منتصب)",
 "曲悪": "شر, فجور (سلوك مرفوض أخلاقياً) / بَشَاعَة, خِسَّة (صفة كون الشيء مقرفاً للحواس أو المشاعر) / إثم, خطيئة (الابتعاد عن الله) / خباثة, دناءة (صفة الشر والفساد الأخلاقي)\nمثال: فاجأتنا بشاعة لغته",
 "曲想": "تيمة, موضوع موسيقي ((موسيقى) الموضوع اللحني لتكوين موسيقي)\nمثال: تم الإعلان عن الموضوع في المقاييس الأولى",
 "曲技": "حركة بهلوانية (حيلة أو حركة يؤديها لاعب بهلوان)",
 "曲技飛行": "ألعاب بهلوانية جوية, استعراض جوي (أداء حركات بهلوانية أثناء الطيران بطائرة)",
 "曲折": "ثني, حني (عملية ثني شيء ما) / انحراف, انحناء (خاصية الانحناء أو الانحراف) / انحناء, تقوس (حركة تسبب تشكل منحنى) / تَعْقِيد / مُضَاعَفَة",
 "曲曲": "تدوير, ملء (عملية التدوير أو اللف) / مُتَعَرِّج, مُتَلَوٍّ ((عَنِ الطَّرِيق) كَثِير المُنْعَطَفَات وَالِالْتِوَاءَات) / مُتَعَرِّج, مُلْتَوٍ (يتميز بمنعطفات وانحناءات متكررة)\nمثال: وضع المفتاح في الساعة القديمة وأعطاها تدويراً جيداً",
 "曲椂": "مُحْدَوْدِب, مُنْحَنِي الظَّهْر (ذو ظهر وكتفَين مُنحنيَين؛ غير منتصب)",
 "曲物屋": "مرهن",
 "曲独楽": "قِمَّة",
 "曲率": "انحناء",
 "曲球": "رمية متغيرة السرعة (كرة بيسبول ترمى بسرعة قليلة عندما يتوقع الضارب كرة سريعة)",
 "曲用": "إِعْرَاب, صَرْف (في هو)",
 "曲目": "عَدَد, نمرة (مِقْدَار مَا يُعَدّ) / عَدَد, رَقْم (مِقْدَار مَا يُعَدّ) / عَدَد (مِقْدَار مَا يُعَدّ) / رَقْم (وضع أرقامًا على شيء ما للتنظيم أو التمييز) / رَقَّمَ (وضع أرقامًا على شيء ما للتنظيم أو التمييز)\nمثال: كم عدد سكان الجزائر؟ / بَرْنَامَج (عَرْضٌ (تلْفَزِيٌّ،…)؛ مُفَكَّرَةٌ يَوْمِيَّةٌ) / بَرْمَجَ, وَضَعَ بَرْنَامَجًا / بَرْمَجَ\nمثال: نشط البرنامج الآن.",
 "曲直": "جَدَارَة",
 "曲禄": "مُحْدَوْدِب, مُنْحَنِي الظَّهْر (ذو ظهر وكتفَين مُنحنيَين؛ غير منتصب)",
 "曲筆": "تحريف, تزييف (تحريف متعمد للحقائق) / تضليل, خداع (كذب مضلل)",
 "曲管": "سِيفُون",
 "曲節": "لَحْن (وضع الألحان أو التأليف الموسيقي؛ قرأ النص بلحن أو أداء صوتي مميز)\nمثال: أنا أحب هذا اللحن.",
 "曲線": "منحنى",
 "曲線美": "امتلاء الجسم, تناسق القوام (صفة امتلاك جسم ممتلئ وجذاب)",
 "曲者": "بلطجي, فتوة (رجل قاسٍ ووحشي) / خَبِير, مَاهِر (الخَابِر الذي يعرف خَبَر الشيء؛ المُخْتَصّ بالشيء ويعرف كل شيء عنه) / مُتَخَصِّص, مُتَخَصِّصَة\nمثال: درب على يد خبير. / جني, عفريت ((فلكلور) مخلوق خارق صغير بشع يسبب المشاكل للبشر)",
 "曲芸": "بِهْلَوَانِيَّات",
 "曲芸師": "بَهْلَوَان",
 "曲解": "سوء تفسير, سوء فهم (وضع تفسير خاطئ لشيء ما)\nمثال: تسبب سوء تفسيره للسؤال في خطئه",
 "曲調": "لَحْن, أُغْنِيَّة (وضع الألحان أو التأليف الموسيقي؛ قرأ النص بلحن أو أداء صوتي مميز)\nمثال: أنا أحب هذا اللحن.",
 "曲論": "سفسطة (حجة غير صحيحة عمدًا تظهر البراعة في التفكير على أمل خداع شخص ما)",
 "曲譜": "إِصَابَة (إِلحاق الأَذى بالجسم، الجُرْح؛ مَرَضٌ أو عَدْوَى) / دَرَجَة\nمثال: تعرض زيري لإصابة.",
 "曲輪": "مِنْطَقَة (المِنْطَقةُ: المَنْطِقَةُ؛ مِنْطَقَةُ: مُقَاطَعَةٌ)\nمثال: غزة منطقة مكشوفة. / إحاطة, تغليف (عملية إحاطة شيء داخل شيء آخر) / حظيرة, مسيَّج (هيكل يتكون من منطقة تم تطويقها لغرض ما) / طية, مرفق (شيء ما (عادة وثيقة داعمة) يتم إرفاقه في ظرف مع رسالة تغطية) / حيز طبيعي مغلق, مكان مغلق (مساحة مغلقة بشكل طبيعي) / حي البغاء, منطقة الضوء الأحمر (حي يكثر فيه وجود بيوت الدعارة)",
 "曲録": "مُحْدَوْدِب, مُنْحَنِي الظَّهْر (ذو ظهر وكتفَين مُنحنيَين؛ غير منتصب)",
 "曲集": "مَجْمُوعَة, جَمْع (مؤنث مَجْمُوع وهو اسم مفعول من جَمَعَ؛ الطَائِفَة أو الجَمَاعَة من الناس) / جَمْع (ضَمَّ، لَمَّ، حَشَدَ؛ في : أَضَافَ أعدادا إلى غيرها)\nمثال: شكرا لإضافتي للمجموعة.",
 "曳々": "رمي ثقيل, قذف بجهد (رمي شيء ثقيل (بجهد كبير)) / رفع بجهد (فعل رفع شيء بجهد كبير) / لهاث (التنفس بصعوبة وثقل (كما يحدث بعد المجهود)) / تمايل, تموج (حركة تصاعدية (خاصة الارتفاع والانخفاض الإيقاعي))\nمثال: أعطاها دفعة قوية",
 "曳き綱": "حبل الشد ((مصطلح بحري) حبل يستخدم لتمديد أو تثبيت التجهيزات على السفن) / حبل تعليق, قيطان (حبل يُرتدى حول الرقبة لحمل سكين أو صافرة) / حبل الإطلاق (حبل مزود بخطاف مرفق يستخدم لإطلاق أنواع معينة من المدافع)",
 "曳き網": "شبكة",
 "曳き船": "زَوْرَق اَلْقَطْر / سحب, قطر (فعل سحب شيء (مثل مركبة) بواسطة حبل أو مشبك)\nمثال: سحبته الشاحنة إلى المرآب",
 "曳光弾": "طلقة تتبع, طلقة كاشفة (ذخيرة يمكن ملاحظة مسارها من خلال أثر دخاني)",
 "曳曳": "رمي ثقيل, قذف بجهد (رمي شيء ثقيل (بجهد كبير)) / رفع بجهد (فعل رفع شيء بجهد كبير) / لهاث (التنفس بصعوبة وثقل (كما يحدث بعد المجهود)) / تمايل, تموج (حركة تصاعدية (خاصة الارتفاع والانخفاض الإيقاعي))\nمثال: أعطاها دفعة قوية",
 "曳火": "انفجار جوي (انفجار في الغلاف الجوي)",
 "曳火弾": "فتيل التوقيت (فتيل مصنوع ليحترق لفترة زمنية محددة (خاصة لتفجير قنبلة))",
 "曳痕弾": "طلقة تتبع, طلقة كاشفة (ذخيرة يمكن ملاحظة مسارها من خلال أثر دخاني)",
 "曳網": "شبكة",
 "曳航": "سحب, قطر (فعل سحب شيء (مثل مركبة) بواسطة حبل أو مشبك)\nمثال: سحبته الشاحنة إلى المرآب",
 "曳船": "زَوْرَق اَلْقَطْر / سحب, قطر (فعل سحب شيء (مثل مركبة) بواسطة حبل أو مشبك)\nمثال: سحبته الشاحنة إلى المرآب",
 "更": "بالتناوب (في تسلسل أو وضع متناوب)\nمثال: زرع أشجار التنوب والصنوبر بالتناوب / خُمْس (جزء واحد من خمسة أجزاء متساوية) / جَدِيد (مصنوع حديثا؛ لم يمر على حدوثه زمن طويل) / حَدِيث (جَدِيد؛ الخبر عن ما حدث) / جديد (مصنوع حديثا؛ لم يمر على حدوثه زمن طويل) / جَديد (مصنوع حديثا؛ لم يمر على حدوثه زمن طويل)\nمثال: هذا الكتاب جديد / بَدِيهِيّ, بَدَهِيّ",
 "更々": "أبداً",
 "更ける": "يقرب",
 "更なり": "طَبْعًا",
 "更なる": "أَبْعَد, أَقْصَى (جعله بَعيدًا؛ جَاوَزَ الحَدَّ)\nمثال: أبعد صورتها عني.",
 "更に": "عِلَاوَة عَلَى ذٰلِكَ, أَضِف إِلَى ذٰلِك",
 "更にもっと": "وأكثر من ذلك (وأكثر بكثير بالإضافة إلى ذلك)\nمثال: كلفني راتب أسبوع وأكثر من ذلك",
 "更代": "تَبْدِيل, تَبَادُل / بُورْصَة, تَدَاوُل / تَبَادَلَ, صَرَفَ",
 "更問": "فحص لاحق, متابعة (فحص لاحق للمريض لغرض مراقبة العلاج السابق) / متابعة (نشاط يواصل شيئاً قد بدأ بالفعل أو يكرر شيئاً تم القيام به بالفعل) / عمل لاحق, متابعة (قطعة عمل تستغل أو تبني على عمل سابق)\nمثال: برنامجه الجديد هو متابعة للبرامج التي بدؤوا بها",
 "更問い": "فحص لاحق, متابعة (فحص لاحق للمريض لغرض مراقبة العلاج السابق) / متابعة (نشاط يواصل شيئاً قد بدأ بالفعل أو يكرر شيئاً تم القيام به بالفعل) / عمل لاحق, متابعة (قطعة عمل تستغل أو تبني على عمل سابق)\nمثال: برنامجه الجديد هو متابعة للبرامج التي بدؤوا بها",
 "更始": "تَجْدِيد",
