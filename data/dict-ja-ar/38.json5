 "放射性物質": "مادة مشعة (مادة ذات نشاط إشعاعي)",
 "放射状": "شُعَاعِيّ, نَجْمِيّ (مُرتَّب كالأشعة؛ ينبثق من مركز مشترك) / إشعاعي (صادر في أشعة من مركز مشترك؛ أو متعلق بأشعة الضوء) / نصف قطري (متعلق بنصف القطر أو يتحرك على طوله أو في اتجاهه) / كعبري (متعلق بعظم الكعبرة أو بالقرب منه)\nمثال: حرارة إشعاعية",
 "放射相称": "تناظر شعاعي (خاصية التناظر حول محور)\nمثال: نجم البحر يوضح التناظر الشعاعي",
 "放射線": "إِشْعَاع (انبعاث الطَّاقة وامتدادُها)",
 "放射線分解": "تحلل إشعاعي (تفكك جزيئي ناتج عن الإشعاع)",
 "放射線医学": "تنظير إشعاعي, علم الأشعة ((علم الأشعة) فحص الهيكل الداخلي للأشياء المعتمة باستخدام الأشعة السينية أو غيرها من الإشعاعات المخترقة) / علم الأشعة (فرع العلوم الطبية المعني بالاستخدام الطبي للأشعة السينية أو الإشعاعات المخترقة الأخرى)",
 "放射線学": "تنظير إشعاعي, علم الأشعة ((علم الأشعة) فحص الهيكل الداخلي للأشياء المعتمة باستخدام الأشعة السينية أو غيرها من الإشعاعات المخترقة) / علم الأشعة (فرع العلوم الطبية المعني بالاستخدام الطبي للأشعة السينية أو الإشعاعات المخترقة الأخرى)",
 "放射線感受性": "حساسية إشعاعية, حساسية للضوء (الحساسية لتأثير الطاقة المشعة)",
 "放射線技師": "مصور أشعة (شخص يقوم بعمل صور الأشعة)",
 "放射線治療": "علاج إشعاعي ((طب) علاج المرض (خاصة السرطان) عن طريق التعرض لمادة مشعة)",
 "放射線測定器": "كاشف الجسيمات (حجرة يمكن فيها جعل الجسيمات مرئية)",
 "放射線生物学": "بيولوجيا إشعاعية (فرع علم الأحياء الذي يدرس تأثيرات الإشعاع على الكائنات الحية)",
 "放射線病": "داء الإشعاع, متلازمة الإشعاع (متلازمة ناتجة عن التعرض للإشعاع المؤين (مثل التعرض للمواد الكيميائية المشعة أو للانفجارات النووية)؛ الجرعات المنخفضة تسبب الإسهال والغثيان والقيء…)\nمثال: كان يعاني من الإشعاع",
 "放射線療法": "علاج إشعاعي ((طب) علاج المرض (خاصة السرطان) عن طريق التعرض لمادة مشعة)",
 "放射線科医": "طَبِيب أَشِعَّة (العالم بالطب)\nمثال: سوف تصبح طبيبة.",
 "放射能": "إشعاع, نشاط إشعاعي (الانبعاث التلقائي لتيار من الجسيمات أو الأشعة الكهرومغناطيسية في الاضمحلال النووي) / إِشْعَاع (انبعاث الطَّاقة وامتدادُها) / مادة مشعة (مادة ذات نشاط إشعاعي)",
 "放射能マーク": "نَفَل (الثَلَاثُ النُفَل: الليلة الرابعة والخامسة والسادسة من كل شهر قمري…)",
 "放射能標識": "نَفَل (الثَلَاثُ النُفَل: الليلة الرابعة والخامسة والسادسة من كل شهر قمري…)",
 "放射菌": "أكتينوميسيس, شعية (رميات تعيش في التربة وطفيليات نباتية وحيوانية مسببة للأمراض)",
 "放射計": "راديومتر, مقياس الإشعاع (مقياس للكشف عن الطاقة الإشعاعية وقياسها (كهرومغناطيسية أو صوتية))",
 "放尿": "تبول (إخراج البول)",
 "放屁": "إخراج ريح, ريح (منعكس يطرد الغازات المعوية عبر الشرج)",
 "放屁虫": "خنفساء قاذفة (خنفساء تطلق بخاراً لاذعاً بصوت مسموع عند إزعاجها)",
 "放心": "شرود الذهن (انشغال كبير لدرجة تجاهل متطلبات الانتباه العادية) / رَاحَة, تَخْفِيف / نَقْش نَافِر (لوّن بلونين أو أكثر؛ زيَّن بأشكال أو ألوان)",
 "放心状態": "تحديق في النجوم (مراقبة النجوم)",
 "放恣": "إِبَاحِيّ",
 "放擲": "اِنْصَرَفَ, يَنْصَرِفُ (فعل مطاوعة لصَرَفَ: صَرَفْتُهُ فَاَنْصَرَف؛ ذهب إلى مكان آخر) / تَرَكَ, يترك (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض)\nمثال: انصرف من ملكيتنا!",
 "放散": "إِشْعَاع (انبعاث الطَّاقة وامتدادُها)",
 "放散虫": "شعاعي (أوالي ذات أجسام تشبه الأميبا وأقدام كاذبة خيطية شعاعية)",
 "放映": "تَلْفَزَ",
 "放棄": "هِجْرَان, هُجْرَان",
 "放楽": "تسلية, هواية (ترفيه يشغل وقت المرء وأفكاره (عادة بشكل ممتع))\nمثال: الإبحار هو هوايتها المفضلة",
 "放水": "تَصْرِيف / خُرْطُوم مَاءٍ, خُرْطُوم",
 "放水砲": "مِدْفَع مَاء (آلة حربية تَقْذِف الكتل الحَدِيدِيَّة أو النَارِيَّة مثل المَنْجَنِيق. بعض العامة تقول مَدْفَع وهذا خطأ. يُجمع جَمْع تَكْسِير على مَدَافِع)",
 "放水管": "أنبوب صرف, أنبوب نفايات (أنبوب يتم من خلاله نقل السوائل بعيداً)",
 "放水車": "شاحنة مياه (شاحنة صهريج تستخدم لنقل وتوزيع المياه)",
 "放水銃": "مِدْفَع مَاء (آلة حربية تَقْذِف الكتل الحَدِيدِيَّة أو النَارِيَّة مثل المَنْجَنِيق. بعض العامة تقول مَدْفَع وهذا خطأ. يُجمع جَمْع تَكْسِير على مَدَافِع)",
 "放流": "إطلاق نار (فعل إطلاق النار من بندقية) / إبراء ذمة, إخلاء طرف (بيان مكتوب رسمي بالتنازل أو الإبراء) / إقالة, تسريح (إنهاء توظيف شخص ما (وتركه حراً للمغادرة)) / تصريف, تنفيس (فعل التنفيس أو الإخراج) / إبعاد, حظر (الرفض عن طريق فعل نفي أو حظر شخص ما) / إبعاد, نبذ (حالة النفي أو النبذ (الاستبعاد من المجتمع بموافقة عامة))\nمثال: يجب على الجمعية التخلص من أعضائها المسنين - ليس عن طريق القتل الرحيم بالطبع، ولكن عن طريق النبذ",
 "放浪": "تجوال, هيام (السفر دون وجهة واضحة) / بِلَا مَسَار ثَابِت, شَارِد (ليس له مسار محدّد أو ثابت) / بَدَوِيّ, رَحَّال (يتنقّل من مكان لآخر دون استقرار)\nمثال: تبعته في ترحاله واعتنت به",
 "放浪癖": "هوس الترحال, ولع بالسفر (اندفاع قوي جداً أو لا يقاوم للسفر والترحال)",
 "放浪者": "تَائِه, مُتَشَرِّد (يتنقّل باستمرار خاصّة من مسكن أو عمل لآخر) / متشرد, هائم (متجول ليس لديه إقامة ثابتة أو وسيلة عيش ظاهرة)\nمثال: 放浪者は、金持ちならば観光客と称せられる。 — الشخص الجوال هو عندما يسمى الغني سائحاً.",
 "放漫": "تقلب, نزوة (سمة التصرف بشكل غير متوقع وبدافع نزوة أكثر منه بدافع العقل أو الحكم) / خاطرة غريبة, شطحة (فكرة غريبة أو خيالية أو متقلبة)\nمثال: أيأس من تقلب ونزوة ذاكرتي",
 "放火": "حَرِيق مُتَعَمَّد (النَار المشتعلة في شيء كالدَار او الغَابَة)\nمثال: أين هو الحريق إذا؟",
 "放火犯": "حَرِيق مُتَعَمَّد (النَار المشتعلة في شيء كالدَار او الغَابَة)\nمثال: أين هو الحريق إذا؟",
 "放火犯人": "مفتعل حرائق (مجرم يشعل النار في الممتلكات بشكل غير قانوني)",
 "放火狂": "بيرومانيا, هوس إشعال الحرائق (رغبة لا يمكن السيطرة عليها لإشعال النار في الأشياء)",
 "放火症": "بيرومانيا, هوس إشعال الحرائق (رغبة لا يمكن السيطرة عليها لإشعال النار في الأشياء)",
 "放火癖": "بيرومانيا, هوس إشعال الحرائق (رغبة لا يمكن السيطرة عليها لإشعال النار في الأشياء)",
 "放火罪": "حَرِيق مُتَعَمَّد (النَار المشتعلة في شيء كالدَار او الغَابَة)\nمثال: أين هو الحريق إذا؟",
 "放火魔": "مَهْوُوس بِإِشْعال الحَرائِق (شخص لديه هوس بإشعال النيران في الأشياء)",
 "放熱": "تبديد الحرارة (تبديد الحرارة)",
