 "恢宏": "توليد, مضاعفة (فعل إنتاج النسل أو المضاعفة من خلال هذا الإنتاج) / ترويج, نشر (نشر شيء (معتقد أو ممارسة) في مناطق جديدة) / انتشار (حركة موجة عبر وسط)",
 "恢弘": "توليد, مضاعفة (فعل إنتاج النسل أو المضاعفة من خلال هذا الإنتاج) / ترويج, نشر (نشر شيء (معتقد أو ممارسة) في مناطق جديدة) / انتشار (حركة موجة عبر وسط)",
 "恣": "أَنَانِيّ",
 "恣にする": "تَعَسُّف, طُغْيَان / مَسَبَّة, شَتِيمَة / إِيذَاء جَسَدِيّ / اِنْتِهَاك جَسَدِيّ / أَسَاءَ اِسْتِعْمَالَ / آذَى / أَهَانَ, سَبَّ (شخص يكون لئيم لآخر بالكلام) / اِغْتَصَبَ, اِنْتَهَكَ (غَصَبَ؛ زَنَى (بِفُلَانَةٍ) قَهْرًا/غَصْبًا) / خَدَعَ, غَشَّ (غَشَّ، مَكَرَ؛ خَادَعَ شخصًا: خدعه بشكل مستمر أو بطريقة خفية)\nمثال: أهان سامي ليلى بقص شعرها.",
 "恣意": "تقلب, نزوة (سمة التصرف بشكل غير متوقع وبدافع نزوة أكثر منه بدافع العقل أو الحكم)\nمثال: أيأس من تقلب ونزوة ذاكرتي",
 "恣意性": "تقلب, نزوة (سمة التصرف بشكل غير متوقع وبدافع نزوة أكثر منه بدافع العقل أو الحكم)\nمثال: أيأس من تقلب ونزوة ذاكرتي",
 "恣意的": "اِعْتِبَاطِيّ",
 "恥": "خَجَل, عَيْب (كلمة \"خَجِلَ\" تتراوح معانيها بين الحرج الشخصي والتأثر بالحمل أو البيئة، وتُستخدم في العديد من السياقات التي تعبر عن الاستحياء أو الحيرة؛ شعر بالخجل أو الحياء نتيجة لموقف محرج أو بسبب تصرف غير لائق) / عَار\nمثال: توم لص بلا خجل.",
 "恥さらし": "عَار, خِزْي",
 "恥じ": "خَجَل, عَيْب (كلمة \"خَجِلَ\" تتراوح معانيها بين الحرج الشخصي والتأثر بالحمل أو البيئة، وتُستخدم في العديد من السياقات التي تعبر عن الاستحياء أو الحيرة؛ شعر بالخجل أو الحياء نتيجة لموقف محرج أو بسبب تصرف غير لائق) / عَار\nمثال: توم لص بلا خجل.",
 "恥じらい": "حياء, خجل (شعور بالخوف من الإحراج)",
 "恥じらう": "اِحْمِرَار (تغيُّر لون الشيء إلى الأحمر) / رُوج (رَوَّج الغُبارُ: دام؛ رَوَّج السِّلعةَ: جعلها تَرُوجُ) / اِحْمَرَّ (أصبح لونه أَحْمَرا بعد أن كان بلون ثان؛ تَضَرَّجَ؛ ازداد حَمَارُهُ)\nمثال: شعرت بالخجل و احمر وجهها.",
 "恥ずい": "حَرِج, مُحْرِج (صَعْب التَّعَامُل مَعَهُ؛ يُسَبِّب أَلَمًا أَوْ إِحْرَاجًا) / مُحْرِج, مُخْجِل (يسبب الشعور بالخجل أو الانزعاج أو الضيق)",
 "恥ずかしい": "حَرِج, مُحْرِج (صَعْب التَّعَامُل مَعَهُ؛ يُسَبِّب أَلَمًا أَوْ إِحْرَاجًا) / مُحْرِج, مُخْجِل (يسبب الشعور بالخجل أو الانزعاج أو الضيق) / فَاضِح, مُخْزٍ ((للسلوك أو الشخصيَّة) يستحقّ العار أو يجلبه) / فَاضِح, مُخْزٍ (يُسِيءُ إِلَى الحِسِّ الأَخْلَاقِيِّ وَيَضُرُّ بِالسُّمْعَة)",
 "恥ずかしがりや": "انطوائي, خجول (شخص ينكمش من الألفة مع الآخرين)",
 "恥ずかしがり屋": "انطوائي, خجول (شخص ينكمش من الألفة مع الآخرين)",
 "恥ずかしがる": "اِحْمِرَار (تغيُّر لون الشيء إلى الأحمر) / رُوج (رَوَّج الغُبارُ: دام؛ رَوَّج السِّلعةَ: جعلها تَرُوجُ) / اِحْمَرَّ (أصبح لونه أَحْمَرا بعد أن كان بلون ثان؛ تَضَرَّجَ؛ ازداد حَمَارُهُ)\nمثال: شعرت بالخجل و احمر وجهها.",
 "恥ずかしげ": "مُحْرَج, بِٱلْحَرَج",
 "恥ずかしげもなく": "بجرأة, بوقاحة (بطريقة وقحة)\nمثال: تحدث بوقاحة",
 "恥ずかしながら": "بِشَكْل مُحْرِج (مسبباً للإحراج)\nمثال: كان الرجل العظيم متواضعاً ونكراً للذات بشكل محرج",
 "恥ずかし気": "مُحْرَج, بِٱلْحَرَج",
 "恥ずべき": "فَاضِح, مُخْزٍ ((للسلوك أو الشخصيَّة) يستحقّ العار أو يجلبه) / فَاضِح, مُخْزٍ (يُسِيءُ إِلَى الحِسِّ الأَخْلَاقِيِّ وَيَضُرُّ بِالسُّمْعَة)",
 "恥も外聞も": "حياء, شعور بالمسؤولية (وعي دافع بالمسؤولية الأخلاقية)",
 "恥らう": "اِحْمِرَار (تغيُّر لون الشيء إلى الأحمر) / رُوج (رَوَّج الغُبارُ: دام؛ رَوَّج السِّلعةَ: جعلها تَرُوجُ) / اِحْمَرَّ (أصبح لونه أَحْمَرا بعد أن كان بلون ثان؛ تَضَرَّجَ؛ ازداد حَمَارُهُ)\nمثال: شعرت بالخجل و احمر وجهها.",
 "恥を知る": "اِسْتَحَى\nمثال: 恥を知れ！ — عار عليك!",
 "恥丘": "جَبَل اَلْعَانَة (كلمة \"جبل\" لها معانٍ متعددة؛ طبع أو خلق شيئًا أو شخصًا على طبيعة أو سلوك معين)\nمثال: منزلي في الجبل.",
 "恥垢": "لَخَن",
 "恥晒し": "عَار, خِزْي",
 "恥毛": "شَعْر اَلْعَانَة (العِلْم؛ في : هو كلام مُقَفَّى ومُوَازَن على أوزان معروفة يُقصد به إظهار الكلام بصيغة فنية)\nمثال: شعر ماريا طويل.",
 "恥知らず": "وَقِح, صَفِيق",
 "恥辱": "عَار, خِزْي",
 "恥部": "أعضاء تناسلية, أعضاء جنسية (عضو جنسي خارجي) / خَجَل, عَيْب (كلمة \"خَجِلَ\" تتراوح معانيها بين الحرج الشخصي والتأثر بالحمل أو البيئة، وتُستخدم في العديد من السياقات التي تعبر عن الاستحياء أو الحيرة؛ شعر بالخجل أو الحياء نتيجة لموقف محرج أو بسبب تصرف غير لائق) / عَار\nمثال: توم لص بلا خجل.",
 "恥骨": "عَانَة",
 "恨": "أُسْرَة هَان / هَان, قَوْمِيَّة اَلْهَان",
 "恨み": "مرارة / نَدِمَ / تَأَسَّفَ (تأسُّف) / أَسَف (مصدر أسِفَ على / أسِفَ لـ / أسِفَ من؛ أَسَفِي شَدِيدٌ على ما بَدَرَ مِنِّي : نَدَمِي) / تَأَسُّف (تأسُّف)\nمثال: للأسف ذلك صحيح.",
 "恨みがましい": "تَأْدِيبِيّ, عَتَابِيّ (يُعَبِّر عَنِ التَّوْبِيخ أَوِ اللَّوْم خَاصَّةً بِغَرَض التَّصْحِيح)",
 "恨みっこ": "مرارة",
 "恨みつらみ": "مَحْبُوس, مَكْبُوت (يتسم بكبت الدوافع أو المشاعر أو يدل عليه)",
 "恨みを晴らす": "اِنْتَقَمَ",
 "恨み言": "بُغْض, ضَغِينَة (البُغْض ضدّ الحبّ ، بغَض جَدُّك:كتعس جدّك،ونعِمَ الله بك عيناً وبغَض بعدوّك عيناً؛ بغَضَ فلانٌ الشّيءَ أو الشّخصَ:كَرِهَه ومَقَتَه وأعرض عنه)\nمثال: سأذهب بغض النظر عن مجيئه.",
 "恨み辛み": "مَحْبُوس, مَكْبُوت (يتسم بكبت الدوافع أو المشاعر أو يدل عليه)",
 "恨む": "لَوْم, مَلَامَة / نَدِمَ / تَأَسَّفَ (تأسُّف) / أَسَف (مصدر أسِفَ على / أسِفَ لـ / أسِفَ من؛ أَسَفِي شَدِيدٌ على ما بَدَرَ مِنِّي : نَدَمِي) / تَأَسُّف (تأسُّف)\nمثال: للأسف ذلك صحيح.",
 "恨むらくは": "أَنَا آسِف, أَنَا آسِفَة",
 "恨めしい": "مُسْتَاء, نَاقِم (ممتلئ أو يتسم بالاستياء أو السخط الساخط)\nمثال: مستاء من الطريقة التي عومل بها / مُؤْسِف, يُؤْسَفُ لَهُ (يَسْتَحِقُّ الأَسَفَ أَوِ النَّدَمَ)",
 "恨めしや": "استهجان, سخرية (صيحة أو ضجيج يصنع للتعبير عن الاستياء أو الازدراء)",
 "恨めし気に": "بتأنيب, بعتاب (بطريقة مؤنبة أو معاتبة)\nمثال: تحدثت إليه بتأنيب",
 "恩": "تفضل, خدمة (عمل يتسم باللطف والتفضل) / هدية الحفل (تذكار عبارة عن هدية صغيرة تعطى للضيوف في حفلة) / تَأْيِيد, صَالِح (أفضلية تعود بالنفع على شخص أو شيء ما) / استحسان, قبول (الميل للموافقة والاستحسان)\nمثال: كانت النتيجة في صالحه / إِحْسَان",
 "恩人": "مُتَبَرِّع",
 "恩借": "قَرْض, إِعَارَة",
 "恩典": "تفضل, خدمة (عمل يتسم باللطف والتفضل) / هدية الحفل (تذكار عبارة عن هدية صغيرة تعطى للضيوف في حفلة) / تَأْيِيد, صَالِح (أفضلية تعود بالنفع على شخص أو شيء ما) / استحسان, قبول (الميل للموافقة والاستحسان)\nمثال: كانت النتيجة في صالحه",
 "恩寵": "غريس",
 "恩師": "مُعَلِّم, مُعَلِّمَة (من يمتهن التعليم، مُدَرِّس)\nمثال: هي أصبحت معلمة.",
 "恩徳": "غريس",
 "恩恵": "غريس",
 "恩恵的": "مُفِيد",
 "恩情": "رَحْمَة / شَفَقَة (وشَفِقَ على؛ الرحمة والعَطْف والحَنَان والحُنُوّ)\nمثال: زيري مثير للشفقة.",
 "恩愛": "حَبِيب, حَبِيبَة / أَحَبَّ, حب (مَالَ إلى الشيء أو الشخص، وَدَّه؛ للزَّرع: بَدا حَبُّه) / أَحَبَّ (مَالَ إلى الشيء أو الشخص، وَدَّه؛ للزَّرع: بَدا حَبُّه)\nمثال: لا أحب المدرسة.",
 "恩沢": "تفضل, خدمة (عمل يتسم باللطف والتفضل) / هدية الحفل (تذكار عبارة عن هدية صغيرة تعطى للضيوف في حفلة) / تَأْيِيد, صَالِح (أفضلية تعود بالنفع على شخص أو شيء ما) / استحسان, قبول (الميل للموافقة والاستحسان)\nمثال: كانت النتيجة في صالحه",
 "恩田": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "恩着せがましい": "فَوْقِيّ, مُتَعَالٍ ((يُستخدم للسلوك أو الموقف) يتسم بالاستعلاء والتعالي على الآخرين)",
 "恩知らず": "جاحد, غير ممتن (لا يشعر أو لا يظهر الامتنان) / ثَقِيل, غَيْر مُسْتَسَاغ (غير مقبول أو غير مستساغ)\nمثال: ورثة جاحدون",
 "恩給": "مَعَاش / بَنْسِيُون",
 "恩義": "وَاجِب, فَرِيضَة (اسم لما يُوجَبُ فعله؛ اسم لما صار حدوثه أكيد)\nمثال: لا شكر على واجب.",
 "恩賞": "مُكَافَأَة, ثَوَاب / جَائِزَة / جَزَاء / مَنَحَ",
 "恩赦": "عَفْو",
 "恩返し": "رَدّ, مُعَامَلَة بِالمِثْل (عمل جماعي متبادل)\nمثال: في المقابل، أعطيناهم بقدر ما حصلنا عليه",
 "恩顧": "تفضل, خدمة (عمل يتسم باللطف والتفضل) / هدية الحفل (تذكار عبارة عن هدية صغيرة تعطى للضيوف في حفلة) / تَأْيِيد, صَالِح (أفضلية تعود بالنفع على شخص أو شيء ما) / استحسان, قبول (الميل للموافقة والاستحسان)\nمثال: كانت النتيجة في صالحه",
 "恫喝": "تَرْهِيب, تَخْوِيف",
 "恬": "بَارِد (مُنْخَفِض الحَرارة أو حَرارتُه أقلّ من حَرارة جسْم الإنسان؛ غير حامٍ، أو متروك بلا حماوة، غير محميّ على النَّار) / يُبَرِّد\nمثال: الماء بارد حقا.",
 "恬として": "بِبُرُود, بِرَبَاطَة جَأْش (بطريقة هادئة وغير مبالية)\nمثال: دون مزيد من اللغط، استعار باركر سكيناً من رائد لوائه وشحذها على حجر الكاربورندم ببرود كجزار",
 "恬惔": "مُجَرَّدٌ مِنَ الهَوَى, نَزِيه (غَيْرُ مُتَأَثِّرٍ بِالمَصْلَحَةِ الذَّاتِيَّة)",
 "恬淡": "مُجَرَّدٌ مِنَ الهَوَى, نَزِيه (غَيْرُ مُتَأَثِّرٍ بِالمَصْلَحَةِ الذَّاتِيَّة)",
 "恬澹": "مُجَرَّدٌ مِنَ الهَوَى, نَزِيه (غَيْرُ مُتَأَثِّرٍ بِالمَصْلَحَةِ الذَّاتِيَّة)",
 "恬然": "بَارِد (مُنْخَفِض الحَرارة أو حَرارتُه أقلّ من حَرارة جسْم الإنسان؛ غير حامٍ، أو متروك بلا حماوة، غير محميّ على النَّار) / يُبَرِّد\nمثال: الماء بارد حقا.",
 "恭しい": "أَدِيب, مُؤَدَّب",
 "恭倹": "احترام, توقير (تعبير مهذب (بالقول أو الفعل) عن التقدير) / إذعان, امتثال (استعداد أو ميل للخضوع لإرادة الآخرين) / احترام, توقير (مراعاة مهذبة لمشاعر الناس)\nمثال: كان توقيره لرغباتها ممتعاً للغاية",
 "恭吉": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "恭悦": "فُرْجَة",
 "恭敬": "اِحْتِرَام (احترام الذَّات: احترام النَّفس والشعور بالكرامة؛ احترامًا له: بدافع ال احترام) / اِعْتِبَار, صَدَد (اعتبر منه:تعجّب،وقيل:الْعِبْرة بالكسر هو الاسم من الاعتبار؛ اعتبر بالموت اعتباراً:تدبّر،اتّعظ به) / اِحْتَرَمَ\nمثال: تعامل معها باحترام.",
 "恭謙": "تَوَاضُع / حِشْمَة",
 "恭賀新年": "كُلُّ عَامٍ وَأَنْتُمْ بِخَيْرٍ, سَنَة جَدِيدَة سَعِيدَة",
 "恭順": "اِنْتِمَاء",
 "息": "نَفَس (النَّفْسُ : الرُّوحُ؛ النَّفْسُ :الدَّمُ، فشاهده قول السموأَل: تَسِيلُ على حَدِّ الظُّبَّاتِ نُفُوسُنَا…)\nمثال: هم في نفس السن. / سِلْمِيّ / بُخَار (كلُّ رَائِحَةٍ سَطَعَتْ مِنْ نَتْنٍ أَو غَيْرِهِ؛ كل مَا يصعد كالدخان من السوائل الحارة والرائحة)\nمثال: السحابة هي كتلة بخار في السماء. / اِبْن (الولد الذكر)\nمثال: هو له ابن صغير. / قَضِيب, ذَكَر",
 "息がつまる": "اِخْتَنَقَ / خَنَقَ (خَنَقَ (خنقه) خنقا: عصر حلقه حتى مات؛ خَنَقَ الوقت: أخره وضيقه)\nمثال: خنق زيري وليد بعمامته.",
 "息が切れる": "اِنْهَار / اِنْهِيَار (سقوط شيء أو تهاويه بشكل مفاجئ نتيجة ضعف أو خلل؛ تدهور نفسي أو عاطفي يؤدي إلى فقدان القدرة على التحمل)\nمثال: يوشك الجسر على الانهيار. / مَاتَ (للحَيّ: فقد الحَيَاة. مصدره مَوتَا ومِيتَة؛ للأرض: ليس فيها شيء حَيّ من النبات أو الحيوان أو الإنسان. مصدره مَوَات) / تُوُفِّيَ / زَهْر اَلطَّاوِلَة, زَهْر اَلنَّرْد ((زَهَرَ) الوجهُ والسراجُ والقمرُ يَزْهُرُ زَهْرًا، وزُهُوراً: تلألأ وأشْرق؛ (زَهَرَ) الشيءُ: صَفا لونُه)\nمثال: إعتقدت أنه مات.",
 "息が弾む": "شهقة, لهاث (سحب قصير ومجهد للنفس مع فتح الفم) / بنطال, سروال ((عادة بصيغة الجمع) رداء يمتد من الخصر إلى الركبة أو الكاحل، ويغطي كل ساق على حدة) / لهث, نفث (الضجيج الناتج عن نفثة قصيرة من البخار (كما من محرك))\nمثال: أطلقت شهقة وأغمي عليها",
 "息が整う": "أَهْدَأَ, هَدَّأَ",
 "息が詰まる": "اِخْتَنَقَ / خَنَقَ (خَنَقَ (خنقه) خنقا: عصر حلقه حتى مات؛ خَنَقَ الوقت: أخره وضيقه)\nمثال: خنق زيري وليد بعمامته.",
 "息せき": "شهقة, لهاث (سحب قصير ومجهد للنفس مع فتح الفم) / بنطال, سروال ((عادة بصيغة الجمع) رداء يمتد من الخصر إلى الركبة أو الكاحل، ويغطي كل ساق على حدة) / لهث, نفث (الضجيج الناتج عن نفثة قصيرة من البخار (كما من محرك))\nمثال: أطلقت شهقة وأغمي عليها",
 "息せき切る": "شهقة, لهاث (سحب قصير ومجهد للنفس مع فتح الفم) / بنطال, سروال ((عادة بصيغة الجمع) رداء يمتد من الخصر إلى الركبة أو الكاحل، ويغطي كل ساق على حدة) / لهث, نفث (الضجيج الناتج عن نفثة قصيرة من البخار (كما من محرك))\nمثال: أطلقت شهقة وأغمي عليها",
 "息つぎ": "أنبوب التنفس, سنوركل (ممر هوائي يوفره جهاز قابل للسحب يحتوي على أنابيب سحب وعادم؛ يسمح للغواصة بالبقاء تحت الماء لفترات طويلة) / فترة التقاط الأنفاس, متنفس (استراحة قصيرة)",
 "息づかい": "تَنَفُس, نَفَس",
 "息づく": "تَنَفَّسَ / حَيِيَ, عَاشَ / يَنْجُو / حَيّ (ضد المَيِّت، على قيد الحَيَاة؛ جمع حَيَاء) / مُباشِر\nمثال: ينبح كلب في الحي.",
 "息の下": "شهقة, لهاث (سحب قصير ومجهد للنفس مع فتح الفم)\nمثال: أطلقت شهقة وأغمي عليها",
 "息の根": "حَياة (الحَياة: ضد الموت والحَيُّ: ضدُّ الميّت؛ والمَحْيا مَفْعَلٌ من الحياة. تقول: مَحْيَاي ومماتي. والجمع الحَحايي)\nمثال: ما أغرب الحياة!",
 "息の根を止める": "قَتَلَ, قتل (تعمّد جعله يَمُوتُ، أزهق روحه، أمَاتَه متعمدا؛ الوقتَ: ضيعه بشيء غير ذي فائدة وهو ينتظر أمرا آخر) / قَتْلَة\nمثال: قتل الصياد دبا.",
 "息の緒": "حَياة (الحَياة: ضد الموت والحَيُّ: ضدُّ الميّت؛ والمَحْيا مَفْعَلٌ من الحياة. تقول: مَحْيَاي ومماتي. والجمع الحَحايي)\nمثال: ما أغرب الحياة!",
 "息の長い": "دَائِم, طَوِيل الأَمَد (مَوْجود مُنْذُ فَتْرَة طَويلَة وَيَسْتَمِرّ) / دائم, مستديم (يستمر أو يبقى دون تغيير ملحوظ في الوضع أو الحالة أو المكان) / دائم, مستديم (باقٍ؛ لا يسقط) / دَائِم, طَوِيلُ الأَمَد (يدوم مدّة طويلة بلا تغيّر)\nمثال: سكرتير دائم للرئيس / إِطْنَابِيّ, ثَرْثَار (يَسْتَخْدِمُ أَوْ يَحْتَوِي عَلَى كَلِمَاتٍ أَكْثَرَ مِمَّا يَنْبَغِي)",
 "息む": "سُلَالَة",
 "息も絶え絶え": "شهقة, لهاث (سحب قصير ومجهد للنفس مع فتح الفم)\nمثال: أطلقت شهقة وأغمي عليها",
 "息をきる": "شهقة, لهاث (سحب قصير ومجهد للنفس مع فتح الفم) / بنطال, سروال ((عادة بصيغة الجمع) رداء يمتد من الخصر إلى الركبة أو الكاحل، ويغطي كل ساق على حدة) / لهث, نفث (الضجيج الناتج عن نفثة قصيرة من البخار (كما من محرك))\nمثال: أطلقت شهقة وأغمي عليها",
 "息をする": "تَنَفَّسَ",
 "息をのむ": "شهقة, لهاث (سحب قصير ومجهد للنفس مع فتح الفم)\nمثال: أطلقت شهقة وأغمي عليها",
 "息をひきとる": "مَاتَ (للحَيّ: فقد الحَيَاة. مصدره مَوتَا ومِيتَة؛ للأرض: ليس فيها شيء حَيّ من النبات أو الحيوان أو الإنسان. مصدره مَوَات) / تُوُفِّيَ / زَهْر اَلطَّاوِلَة, زَهْر اَلنَّرْد ((زَهَرَ) الوجهُ والسراجُ والقمرُ يَزْهُرُ زَهْرًا، وزُهُوراً: تلألأ وأشْرق؛ (زَهَرَ) الشيءُ: صَفا لونُه)\nمثال: إعتقدت أنه مات.",
 "息を切らす": "شهقة, لهاث (سحب قصير ومجهد للنفس مع فتح الفم) / بنطال, سروال ((عادة بصيغة الجمع) رداء يمتد من الخصر إلى الركبة أو الكاحل، ويغطي كل ساق على حدة) / لهث, نفث (الضجيج الناتج عن نفثة قصيرة من البخار (كما من محرك))\nمثال: أطلقت شهقة وأغمي عليها",
 "息を切らせる": "شهقة, لهاث (سحب قصير ومجهد للنفس مع فتح الفم) / بنطال, سروال ((عادة بصيغة الجمع) رداء يمتد من الخصر إلى الركبة أو الكاحل، ويغطي كل ساق على حدة) / لهث, نفث (الضجيج الناتج عن نفثة قصيرة من البخار (كما من محرك))\nمثال: أطلقت شهقة وأغمي عليها",
 "息を切る": "شهقة, لهاث (سحب قصير ومجهد للنفس مع فتح الفم) / بنطال, سروال ((عادة بصيغة الجمع) رداء يمتد من الخصر إلى الركبة أو الكاحل، ويغطي كل ساق على حدة) / لهث, نفث (الضجيج الناتج عن نفثة قصيرة من البخار (كما من محرك))\nمثال: أطلقت شهقة وأغمي عليها",
 "息を吐く": "زَفَرَ (زفَر الشَّخصُ : أخرج نفَسه من رئتيه بعد مدِّه إيّاه؛ أظهر تعبيرًا عن الحزن أو الألم من خلال تنهد أو صوت عميق)",
 "息を呑む": "شهقة, لهاث (سحب قصير ومجهد للنفس مع فتح الفم)\nمثال: أطلقت شهقة وأغمي عليها",
 "息を呑むほど": "خَاطِف لِلأَنْفَاس, مُذْهِل (يميل إلى وقف التنفس الطبيعي من شدة الإثارة)",
 "息を呑むよう": "خَاطِف لِلأَنْفَاس, مُذْهِل (يميل إلى وقف التنفس الطبيعي من شدة الإثارة)",
 "息を引き取る": "مَاتَ (للحَيّ: فقد الحَيَاة. مصدره مَوتَا ومِيتَة؛ للأرض: ليس فيها شيء حَيّ من النبات أو الحيوان أو الإنسان. مصدره مَوَات) / تُوُفِّيَ / زَهْر اَلطَّاوِلَة, زَهْر اَلنَّرْد ((زَهَرَ) الوجهُ والسراجُ والقمرُ يَزْهُرُ زَهْرًا، وزُهُوراً: تلألأ وأشْرق؛ (زَهَرَ) الشيءُ: صَفا لونُه)\nمثال: إعتقدت أنه مات.",
 "息を弾ませる": "شهقة, لهاث (سحب قصير ومجهد للنفس مع فتح الفم) / بنطال, سروال ((عادة بصيغة الجمع) رداء يمتد من الخصر إلى الركبة أو الكاحل، ويغطي كل ساق على حدة) / لهث, نفث (الضجيج الناتج عن نفثة قصيرة من البخار (كما من محرك))\nمثال: أطلقت شهقة وأغمي عليها",
 "息を飲む": "شهقة, لهاث (سحب قصير ومجهد للنفس مع فتح الفم)\nمثال: أطلقت شهقة وأغمي عليها",
 "息を飲むほど": "خَاطِف لِلأَنْفَاس, مُذْهِل (يميل إلى وقف التنفس الطبيعي من شدة الإثارة)",
 "息を飲むよう": "خَاطِف لِلأَنْفَاس, مُذْهِل (يميل إلى وقف التنفس الطبيعي من شدة الإثارة)",
 "息休め": "رَاحَة, اِسْتِرَاحَة / اِسْتَرَاحَ (اِرْتَاح؛ طلب الرَاحَة) / بَاقِيَّة / أَثَارَة\nمثال: عليك أخذ استراحة.",
 "息切れ": "ضيق التنفس, قصر النفس (حالة من عسر التنفس)",
 "息吹": "نَفَس (النَّفْسُ : الرُّوحُ؛ النَّفْسُ :الدَّمُ، فشاهده قول السموأَل: تَسِيلُ على حَدِّ الظُّبَّاتِ نُفُوسُنَا…)\nمثال: هم في نفس السن. / لافِتَة / وَقَّعَ (الشيء: سَقَطَ، انحدر من مكان عال؛ الأمر: حَدَثَ، وأكثر ما يقال للأمر العظيم)\nمثال: توم وقع و أصيب.",
 "息吹き": "نَفَس (النَّفْسُ : الرُّوحُ؛ النَّفْسُ :الدَّمُ، فشاهده قول السموأَل: تَسِيلُ على حَدِّ الظُّبَّاتِ نُفُوسُنَا…)\nمثال: هم في نفس السن. / لافِتَة / وَقَّعَ (الشيء: سَقَطَ، انحدر من مكان عال؛ الأمر: حَدَثَ، وأكثر ما يقال للأمر العظيم)\nمثال: توم وقع و أصيب.",
 "息吹く": "تَنَفَّسَ",
 "息女": "اِبْنَة, بِنْت",
 "息子": "اِبْن (الولد الذكر)\nمثال: هو له ابن صغير. / قَضِيب, ذَكَر",
 "息子さん": "اِبْن (الولد الذكر)\nمثال: هو له ابن صغير.",
 "息巻く": "حَنَق ((حَنِقَ) عَلَيْهِ حنقا: اشْتَدَّ غيظه فَهُوَ حنق وحنيق) / غَضِبَ, اِنْدَلَعَ",
 "息張る": "سُلَالَة",
 "息急き": "شهقة, لهاث (سحب قصير ومجهد للنفس مع فتح الفم) / بنطال, سروال ((عادة بصيغة الجمع) رداء يمتد من الخصر إلى الركبة أو الكاحل، ويغطي كل ساق على حدة) / لهث, نفث (الضجيج الناتج عن نفثة قصيرة من البخار (كما من محرك))\nمثال: أطلقت شهقة وأغمي عليها",
 "息急き切る": "شهقة, لهاث (سحب قصير ومجهد للنفس مع فتح الفم) / بنطال, سروال ((عادة بصيغة الجمع) رداء يمتد من الخصر إلى الركبة أو الكاحل، ويغطي كل ساق على حدة) / لهث, نفث (الضجيج الناتج عن نفثة قصيرة من البخار (كما من محرك))\nمثال: أطلقت شهقة وأغمي عليها",
 "息抜き": "اِسْتِرْخَاءْ / نَفَّسَ, هَوَّى (النَّفْسُ : الرُّوحُ؛ النَّفْسُ :الدَّمُ، فشاهده قول السموأَل: تَسِيلُ على حَدِّ الظُّبَّاتِ نُفُوسُنَا…) / نَفَّسَ عَن (النَّفْسُ : الرُّوحُ؛ النَّفْسُ :الدَّمُ، فشاهده قول السموأَل: تَسِيلُ على حَدِّ الظُّبَّاتِ نُفُوسُنَا…)\nمثال: هم في نفس السن.",
 "息災": "صحة جيدة, عافية (حالة التمتع بالنشاط والخلو من الأمراض الجسدية أو العقلية)",
 "息男": "اِبْن (الولد الذكر)",
 "息絶える": "مَاتَ (للحَيّ: فقد الحَيَاة. مصدره مَوتَا ومِيتَة؛ للأرض: ليس فيها شيء حَيّ من النبات أو الحيوان أو الإنسان. مصدره مَوَات) / تُوُفِّيَ / زَهْر اَلطَّاوِلَة, زَهْر اَلنَّرْد ((زَهَرَ) الوجهُ والسراجُ والقمرُ يَزْهُرُ زَهْرًا، وزُهُوراً: تلألأ وأشْرق؛ (زَهَرَ) الشيءُ: صَفا لونُه)\nمثال: إعتقدت أنه مات.",
 "息継ぎ": "أنبوب التنفس, سنوركل (ممر هوائي يوفره جهاز قابل للسحب يحتوي على أنابيب سحب وعادم؛ يسمح للغواصة بالبقاء تحت الماء لفترات طويلة) / فترة التقاط الأنفاس, متنفس (استراحة قصيرة)",
 "息苦しい": "خنق (فعل خنق (شخص ما) عن طريق الضغط على القصبة الهوائية) / خَنَّاق, كَاتِم لِلْأَنْفَاس (يُسَبِّب صُعُوبَة فِي التَّنَفُّس خَاصَّةً بِسَبَب نَقْص الهَوَاء النَّقِيّ) / اختناق, غصة (حالة ناتجة عن انسداد الممرات الهوائية المؤدية إلى الرئتين (كما هو الحال مع الطعام أو تورم الحنجرة))\nمثال: لا يوجد دليل على أن الخنق تم بواسطة المتهم / طُغْيَانِيّ, قَمْعِيّ (يَتَّسِم بِقَسْوَة ظَالِمَة أَوْ سُلُوك تَعَسُّفِيّ) / خانِق, كابِت (يُثْقِل كاهِل النَّفْس والحَواسّ بِشِدَّة)",
 "息詰まり": "خنق (فعل خنق (شخص ما) عن طريق الضغط على القصبة الهوائية) / خَنَّاق, كَاتِم لِلْأَنْفَاس (يُسَبِّب صُعُوبَة فِي التَّنَفُّس خَاصَّةً بِسَبَب نَقْص الهَوَاء النَّقِيّ) / اختناق, غصة (حالة ناتجة عن انسداد الممرات الهوائية المؤدية إلى الرئتين (كما هو الحال مع الطعام أو تورم الحنجرة))\nمثال: لا يوجد دليل على أن الخنق تم بواسطة المتهم",
 "息遣い": "تَنَفُس, نَفَس",
 "息長鳥": "غطاس (طائر مائي صغير مدمج الجسم بالكامل تقريباً يبني أعشاشاً عائمة؛ يشبه الغواص ولكنه أصغر وله أقدام مفصصة بدلاً من مكففة)",
 "恰も": "كَأَنَّ, كَأَنَّمَا (يفيد التشبيه)\nمثال: كأن هذه السيارة له. / عندئذ, في تلك اللحظة (في وقت معين في الماضي)\nمثال: عندئذ انطلق البوق",
 "恰もよし": "لحسن الحظ (بواسطة الحظ الجيد)\nمثال: لحسن الحظ كان الطقس جيداً",
 "恰も好し": "لحسن الحظ (بواسطة الحظ الجيد)\nمثال: لحسن الحظ كان الطقس جيداً",
 "恰好": "شَكْل, أَشْكَال ((شَكَلَ) الأمْرُ يَشْكُلُ شُكُولاً: الْتَبَسَ؛ (شَكَلَ) المريضُ: تماثَلَ)\nمثال: اجلس بشكل مريح. / ظُهُور (عِيْدُ الظُّهُوْر: عيد للنَصَارَى يُسَمَّى أيضا عيد التَجَلِّي) / مَظْهَر (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / مَظْهَر, شَكْل (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / شَكْل ((شَكَلَ) الأمْرُ يَشْكُلُ شُكُولاً: الْتَبَسَ؛ (شَكَلَ) المريضُ: تماثَلَ)\nمثال: لا أحد لاحظ ظهور الدب. / وَضْع (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه) / دَوْلَة (بَلَد يتميز بحُدُود معروفة وشَعْب وحُكُومَة ومُؤَسَسَات مُنَظَّمَة؛ مجموعة من الناس مستقلين متحدين معا لتكوين مجتمع لحماية حقوقهم و وضع قوانينهم الخاصة) / وِلَايَة (منطقة إدارية لها استقلالها الإداري والمعنوي؛ ويختلف المعنى من بلد لآخر كما يختلف من فترة زمنية لأخرى) / يُبْدِي\nمثال: لقد أزمت الوضع. / مُنَاسِب, مُلَائِم",
 "恵": "حِكْمَة (مؤنث حَكَم)\nمثال: خذ الحكمة من أي وعاء خرجت.",
 "恵み": "بَرَكَة, نِعْمَة (مُسْتَنْقَع الماء أو أو بُحِيْرَة صغيرة؛ حوض الماء المصنوع لتزيين الحدائق وريها) / نِعْمَة\nمثال: البركة عميقة جدا.",
 "恵み深い": "كَرِيم, مُنْعِم (ميّال إلى منح النِّعم والإحسان) / كَيِّس, لَطِيف (يُظهر الكياسة واللطف في التعامل) / دمث, كريم النفس (يتميز بالسحر والذوق الرفيع وكرم الروح) / رَؤُوف, كَرِيم (يتسم بالطيبة والمجاملة الدافئة خاصة من ملك تجاه رعاياه)\nمثال: لطيف حتى مع الزوار غير المتوقعين",
 "恵む": "بَارَكَ / أَعْطَى, وَهَبَ (مَنَحَ، نَوَّلَ)\nمثال: أعطى بلده حياته.",
 "恵与": "إِرَاءَة / إِهْدَاء, مَنْح",
 "恵投": "إِرَاءَة / إِهْدَاء, مَنْح",
 "恵方参り": "أول أيام السنة, يوم رأس السنة (اليوم الأول من السنة)",
 "恵方詣": "أول أيام السنة, يوم رأس السنة (اليوم الأول من السنة)",
 "恵方詣り": "أول أيام السنة, يوم رأس السنة (اليوم الأول من السنة)",
 "恵比須草": "أرابيس كندي, قرن المنجل (رشاد صخري أمريكي شمالي ذو قرون منحنية طويلة جداً) / سنا منفرجة الأوراق, قرن المنجل (عشب استوائي عالمي أو شجيرة صغيرة بزهور صفراء وقرون منحنية رفيعة؛ عشب ضار؛ يصنف أحياناً في جنس كاسيا)",
 "恵沢": "بَرَكَة, نِعْمَة (مُسْتَنْقَع الماء أو أو بُحِيْرَة صغيرة؛ حوض الماء المصنوع لتزيين الحدائق وريها) / نِعْمَة\nمثال: البركة عميقة جدا.",
 "恵贈": "حَالِيّ, حَاضِر / مَوْجُود, حَاضِر (الذي له وجود) / الزَّمَان, الْحَال / قَدَّمَ, طَرَحَ (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى الرُّسْغَ؛ أنّ لهم سابقةً وفضلاً له عند فلان قَدَمٌ : معروف)\nمثال: أنا موجود لوحدي",
 "悃々": "جَدِّي, جَادّ / عَرْبُون",
 "悃悃": "جَدِّي, جَادّ / عَرْبُون",
 "悄々": "بِإِحْبَاط, بِاكْتِئَاب (بطريقة مكتئبة)\nمثال: عندما عادت كانت صوفي وإستر تجلسان باكتئاب في المطبخ / وَحِيد, مُنْفَرِد",
 "悄悄": "بِإِحْبَاط, بِاكْتِئَاب (بطريقة مكتئبة)\nمثال: عندما عادت كانت صوفي وإستر تجلسان باكتئاب في المطبخ / وَحِيد, مُنْفَرِد",
 "悄愴": "وَحِيد, مُوحِش",
 "悄然": "قَانِط, أَسْوَان",
 "悉": "كُلّ شَيْء",
 "悉く": "بالكامل, بشكل تام (إلى درجة كاملة أو إلى الحد الأقصى؛ بالكامل) / إجمالاً, في المجموع (مع تضمين أو عد كل شيء) / بشكل عام, في الإجمال (مع أخذ كل شيء في الاعتبار) / كما ولدتني أمي (تعبيرات غير رسمية للعري)\nمثال: كان مقتنعاً كلياً",
 "悉無律": "قانون الكل أو لا شيء ((في الفسيولوجيا العصبية) نبضة عصبية ناتجة عن محفز ضعيف تكون قوية تمامًا مثل نبضة عصبية ناتجة عن محفز قوي)",
 "悉皆": "كُلّ, جَمِيع",
 "悉皆調査": "تَعْدَاد اَلسُّكَّان, إِحْصَاء اَلسُّكَّان",
 "悋気": "حَسَد, غَبْط (تمنيّ زوال نعمة الغير)\nمثال: الكره لا يظهر بكل بساطة من فراغ. إنه بالعادة يبدأ من الحسد أو الخوف.",
 "悌順": "طَاعَة, إِطَاعَة",
 "悍婦": "عَبُوس, مُتَذَمِّر (مُنزعج وسريع الانفعال)",
 "悒々": "حَزِين, زعلان / مُحْزِنٌ",
 "悒悒": "حَزِين, زعلان / مُحْزِنٌ",
 "悔い": "نَدِمَ / تَأَسَّفَ (تأسُّف) / أَسَف (مصدر أسِفَ على / أسِفَ لـ / أسِفَ من؛ أَسَفِي شَدِيدٌ على ما بَدَرَ مِنِّي : نَدَمِي) / تَأَسُّف (تأسُّف)\nمثال: للأسف ذلك صحيح.",
 "悔いる": "نَدِمَ / تَأَسَّفَ (تأسُّف) / أَسَف (مصدر أسِفَ على / أسِفَ لـ / أسِفَ من؛ أَسَفِي شَدِيدٌ على ما بَدَرَ مِنِّي : نَدَمِي) / تَأَسُّف (تأسُّف)\nمثال: للأسف ذلك صحيح.",
 "悔い改め": "تَوْبَة",
 "悔い改める": "تَابَ (تَابَ: عادَ إِلى اللَّهِ ورَجَعَ وأَنَابَ؛ تابَ اللهُ عَلَيْهِ: أَي عادَ عَلَيْهِ بالمَغْفِرة)",
 "悔しい": "مَهْزُوم, مُحْبَط (فاشل بشكل مخيّب للآمال)",
 "悔しさ": "إذلال, انكسار (مشاعر قوية من الإحراج)",
 "悔しまぎれ": "خبث, لؤم (الخبث الناتج عن كون الشخص حقودًا أو سيئ الطبع) / حقد, كيد (الشعور بالحاجة لرؤية الآخرين يعانون)",
 "悔し涙": "إزعاج, غيظ (فعل إقلاق أو إزعاج شخص ما) / صداع, قلق (شيء أو شخص يسبب القلق؛ مصدر للتعاسة) / إغاظة, انزعاج (غضب ناتج عن إثارة مزعجة) / استياء, انزعاج (الحالة النفسية للشعور بالتهيج أو الانزعاج)\nمثال: حركة المرور في نيويورك مصدر قلق دائم",
 "悔し紛れ": "خبث, لؤم (الخبث الناتج عن كون الشخص حقودًا أو سيئ الطبع) / حقد, كيد (الشعور بالحاجة لرؤية الآخرين يعانون)",
 "悔み": "تَأْسِيَة / تَعْزِيَة",
 "悔む": "نَدَبَ / نَدِمَ / تَأَسَّفَ (تأسُّف) / أَسَف (مصدر أسِفَ على / أسِفَ لـ / أسِفَ من؛ أَسَفِي شَدِيدٌ على ما بَدَرَ مِنِّي : نَدَمِي) / تَأَسُّف (تأسُّف)\nمثال: للأسف ذلك صحيح.",
 "悔やみ": "تَأْسِيَة / تَعْزِيَة",
 "悔やむ": "نَدَبَ / نَدِمَ / تَأَسَّفَ (تأسُّف) / أَسَف (مصدر أسِفَ على / أسِفَ لـ / أسِفَ من؛ أَسَفِي شَدِيدٌ على ما بَدَرَ مِنِّي : نَدَمِي) / تَأَسُّف (تأسُّف)\nمثال: للأسف ذلك صحيح.",
 "悔ゆ": "نَدِمَ / تَأَسَّفَ (تأسُّف) / أَسَف (مصدر أسِفَ على / أسِفَ لـ / أسِفَ من؛ أَسَفِي شَدِيدٌ على ما بَدَرَ مِنِّي : نَدَمِي) / تَأَسُّف (تأسُّف)\nمثال: للأسف ذلك صحيح.",
 "悔心": "توبة, ندامة (الأسى على الخطيئة الناشئ عن الخوف من العقاب)",
 "悔恨": "نَدِمَ / تَأَسَّفَ (تأسُّف) / أَسَف (مصدر أسِفَ على / أسِفَ لـ / أسِفَ من؛ أَسَفِي شَدِيدٌ على ما بَدَرَ مِنِّي : نَدَمِي) / تَأَسُّف (تأسُّف)\nمثال: للأسف ذلك صحيح.",
 "悔悛": "تَوْبَة",
 "悔悟": "نَدَم / وَخَز الضَّمِير (الطعن بآلة حادة بدون يكون نافذا ولا يكسر الجلد)\nمثال: إذا كنت وخز لنا، هل نحن لا ينزف؟",
 "悔改め": "تَوْبَة",
 "悔改める": "تَابَ (تَابَ: عادَ إِلى اللَّهِ ورَجَعَ وأَنَابَ؛ تابَ اللهُ عَلَيْهِ: أَي عادَ عَلَيْهِ بالمَغْفِرة)",
 "悔過": "تَوْبَة",
 "悖戻": "عَصَى",
 "悚然": "مَذْعُور, مُرْتَعِب (أصابه ذعر شديد أو يأس غامر)",
 "悟り": "فَهْم (فهم الأمر أو الكلام أو نحو ذلك، أدركه، علمه، أحسن تصوّره، استوعبه)\nمثال: لقد أسئت الفهم. / تَنْوِير",
 "悟る": "حَاسَّة / إِحْسَاس, شُعُور / مَعْنَى, دَلَالَة / مَوْهِبَة, قُدْرَة طَبِيعِيَّة / حَسَّ (حسّه:أحرقه ، حسسْتُ الشّيء:أحسَسْتُه،حسَسْتُ اللحمَ:جعلته على الجمر،حسَسْتُ النّارَ:رددْتُها بالعصا على خُبْزِ المَلّةِ؛ حَسَّ فلاناً:قتله قتلاً ذريعاً مستأصلاً رأسه.(حسَسْتُ اليهوديََ لما أظهر عداوته لله ودينه))\nمثال: لديهم حس الفكاهة. / فَهِمَ (فهم الأمر أو الكلام أو نحو ذلك، أدركه، علمه، أحسن تصوّره، استوعبه)\nمثال: لقد أسئت الفهم.",
 "悟性": "حِكْمَة (مؤنث حَكَم)\nمثال: خذ الحكمة من أي وعاء خرجت.",
 "悟道": "تَنْوِير",
 "悠": "صَامِت, هَادِئ / بَعِيد (ضد القَرِيب، الذي يفصل بينك وبينه مسافة أو زمان)\nمثال: إنها بعيدة جدا.",
 "悠々": "صَامِت, هَادِئ / بِسُهُولَة / بَعِيد (ضد القَرِيب، الذي يفصل بينك وبينه مسافة أو زمان)\nمثال: إنها بعيدة جدا.",
 "悠久": "أَبَدِيّ",
 "悠悠": "صَامِت, هَادِئ / بِسُهُولَة / بَعِيد (ضد القَرِيب، الذي يفصل بينك وبينه مسافة أو زمان)\nمثال: إنها بعيدة جدا.",
 "悠揚": "مُتَمَالِكٌ لِنَفْسِه, مُتَّزِن (مسيطر تمامًا على ملكاته وقدراته؛ رابط الجأش)",
 "悠揚迫らず": "بهدوء (برباطة جأش (خاصة في أوقات التوتر)) / برزانة, بهدوء ووقار (بطريقة رزينة وهادئة)\nمثال: تحدث بهدوء للطلاب المشاغبين",
 "悠揚迫らぬ": "هَادِئ / طَمْأَنَ",
 "悠然": "هَادِئ / طَمْأَنَ",
 "悠遠": "بَعِيد (ضد القَرِيب، الذي يفصل بينك وبينه مسافة أو زمان)\nمثال: إنها بعيدة جدا.",
 "悠長": "على مهل, في وقت الفراغ (بطريقة غير متسرعة أو في الوقت المناسب) / مُسْتَرْسِل, هَادِئ (غير مُتعجّل ولا قسريّ)\nمثال: اقرأ الدليل في وقت فراغك",
 "患": "مُصَاب, مُعْتَلّ (غَيْرُ لَائِقٍ عَقْلِيًّا أَوْ جَسَدِيًّا) / مُبْتَلًى, مُصَاب (متضرّر بشدّة وخاصّة من مرض)",
 "患い": "قَلِقَ (شاعر بالقَلَق؛ تَحَرّك/اهتزاز/اضطراب في الوضع الطبيعي للشيء) / قَلَق (شاعر بالقَلَق؛ تَحَرّك/اهتزاز/اضطراب في الوضع الطبيعي للشيء)\nمثال: ليلى قلقة بشأنك. / مَرَض, دَاء (أصابه مرضٌ أو علّة أو سَقَم)\nمثال: هذا المرض قلبي.",
 "患いつく": "مَرِضَ, أُصِيبَ بِالْمَرَض (أصابه مرضٌ أو علّة أو سَقَم)\nمثال: هذا المرض قلبي.",
 "患い付く": "مَرِضَ, أُصِيبَ بِالْمَرَض (أصابه مرضٌ أو علّة أو سَقَم)\nمثال: هذا المرض قلبي.",
 "患え": "حداد, ندب (النشاط العاطفي والظاهر للتعبير عن الحزن) / رثاء, عويل (صرخة حزن وأسى)\nمثال: يمكن سماع نواحهم المثير للشفقة في جميع أنحاء الجناح / غَمّ, حُزْن / قَلَق (شاعر بالقَلَق؛ تَحَرّك/اهتزاز/اضطراب في الوضع الطبيعي للشيء) / قَلَق, اِضْطِرَاب الْقَلَق (شاعر بالقَلَق؛ تَحَرّك/اهتزاز/اضطراب في الوضع الطبيعي للشيء)\nمثال: ليلى قلقة بشأنك. / مَرَض, دَاء (أصابه مرضٌ أو علّة أو سَقَم)\nمثال: هذا المرض قلبي.",
 "患ふ": "عَوِيل, رَثَاء / مَرْثِيَة / بَكَى, نَاحَ (دَمَعَتْ عَيناهُ حزنا؛ بكى الْمَيِّت: رثاه) / بَكَى, رَثَى (دَمَعَتْ عَيناهُ حزنا؛ بكى الْمَيِّت: رثاه)\nمثال: بكى زيري كثيرا.",
 "患畜": "صَبُور (الكثير الصبر أو الذي يصبر طويلا، من كانت صفته الصبر؛ الصَبُوْر: اسم من الأسماء الحسنى) / مَرِيض, مَرِيضَة (من به مَرَض، أي السَقِيْم المَعْلُوْل. يقال لما يصاب به الجَسَد والنَفَس والرُوْح أو أحدهم) / مَفْعُول (كناية عن الذي فُعِلَ به فاحشة اللواط. المَلُوطُ به)\nمثال: أظن أنها مريضة.",
 "患禍": "كَارِثَة, مُصِيبَة",
 "患者": "صَبُور (الكثير الصبر أو الذي يصبر طويلا، من كانت صفته الصبر؛ الصَبُوْر: اسم من الأسماء الحسنى) / مَرِيض, مَرِيضَة (من به مَرَض، أي السَقِيْم المَعْلُوْل. يقال لما يصاب به الجَسَد والنَفَس والرُوْح أو أحدهم) / مَفْعُول (كناية عن الذي فُعِلَ به فاحشة اللواط. المَلُوطُ به)\nمثال: أظن أنها مريضة.",
 "患部": "جُرْح, جِرَاحَة (كَلَمَ، شَقَّ اللَحْم وأسَالَ الدَمّ؛ صَادَ أو اكْتَسَبَ) / جَرَحَ (كَلَمَ، شَقَّ اللَحْم وأسَالَ الدَمّ؛ صَادَ أو اكْتَسَبَ)\nمثال: ذلك سيهيج الجرح.",
 "患難": "بلاء, مصاب (سبب للمعاناة والضيق الشديد) / بلاْء, علة (حالة من المعاناة أو الضيق بسبب اعتلال الصحة) / بلاء, محنة (حالة من المعاناة والضيق الشديد بسبب الشدائد)",
 "悦": "رضا عن الذات, غرور (الشعور الذي ينتابك عندما تكون راضياً عن نفسك)\nمثال: كان رضاه عن نفسه مثيراً للاشمئزاز تماماً",
 "悦に入る": "شَمِتَ",
 "悦に浸る": "شَمِتَ",
 "悦哉": "بندقية قديمة, مسكيت (بندقية كتف تلقم من الفوهة ذات ماسورة طويلة؛ كان يستخدمها المشاة قديماً)",
 "悦楽": "سُرُور, فَرَح (شُعُور حَسَن يتبع الرضا، والارتياح)\nمثال: قبل زيري بسرور.",
 "悩ましい": "جذاب, فاتن (يميل إلى إغراء شخص للقيام بعمل أو حالة مرغوبة) / مُزْعِج, مُقْلِق (يُسَبِّب القَلَق أو الانْزِعاج أو الكَرْب) / قَلِق, قَلِقَة (شاعر بالقَلَق؛ تَحَرّك/اهتزاز/اضطراب في الوضع الطبيعي للشيء)\nمثال: ليلى قلقة بشأنك.",
 "悩ましげ": "قَلِق, قَلِقَة (شاعر بالقَلَق؛ تَحَرّك/اهتزاز/اضطراب في الوضع الطبيعي للشيء)\nمثال: ليلى قلقة بشأنك. / شَوْق (نزوعُ النَّفْس إِلى الشيء، أو تَعَلُّقها به؛ مصدر الفعل شَاقَ)\nمثال: سأشعر بالشوق إليك.",
 "悩ます": "عَذَاب / عَذَّبَ",
 "悩み": "مُشْكِلَة, مَتاعِب",
 "悩める": "قَلِق (شاعر بالقَلَق؛ تَحَرّك/اهتزاز/اضطراب في الوضع الطبيعي للشيء)\nمثال: ليلى قلقة بشأنك. / عَذَاب / عَذَّبَ",
 "悩乱": "قَلِقَ (شاعر بالقَلَق؛ تَحَرّك/اهتزاز/اضطراب في الوضع الطبيعي للشيء) / قَلَق (شاعر بالقَلَق؛ تَحَرّك/اهتزاز/اضطراب في الوضع الطبيعي للشيء)\nمثال: ليلى قلقة بشأنك.",
 "悩殺": "فَتَنَ",
 "悪": "شِرِّير, شَرِير (الكَثير الشَرّ بمعنى اسم جامع للرذائل، قد يستعمل كاسم فاعل؛ ضد الخَيِّر؛ يستخدم أيضا بمعنى ذو الشَرّ وما تسبب بالشرّ) / شَرّ, سَوْء (ضد الخَيْر؛ السوء والفساد والرذائل والخطايا وقيل الشرّ يضم كل الرذائل؛ اسم تفضيل، الأكثر شَرّا، أصله أشرّ وحذفت الألف) / شَرّ (ضد الخَيْر؛ السوء والفساد والرذائل والخطايا وقيل الشرّ يضم كل الرذائل؛ اسم تفضيل، الأكثر شَرّا، أصله أشرّ وحذفت الألف)\nمثال: لقد وصف سامي ليلى كشخص شرير إلى حد يكاد لا يصدق. / شِرِّير (الكَثير الشَرّ بمعنى اسم جامع للرذائل، قد يستعمل كاسم فاعل؛ ضد الخَيِّر؛ يستخدم أيضا بمعنى ذو الشَرّ وما تسبب بالشرّ)\nمثال: لقد وصف سامي ليلى كشخص شرير إلى حد يكاد لا يصدق. / وَغْد, نَذْل / براتوورست (سجق خنزير صغير) / طفل شقي (طفل مزعج جداً) / أذى, شقاوة (سلوك متهور أو خبيث يسبب الإزعاج أو الضيق للآخرين) / أذى, شر (الطبيعة أو الصفة المؤذية أو الشريرة) / مُفْرِط, زَائِد",
 "悪い": "سَيِّئ, وحش / فَقِير / مِسْكِين / فُقَرَاء / شِرِّير, شَرِير (الكَثير الشَرّ بمعنى اسم جامع للرذائل، قد يستعمل كاسم فاعل؛ ضد الخَيِّر؛ يستخدم أيضا بمعنى ذو الشَرّ وما تسبب بالشرّ) / شَرّ, سَوْء (ضد الخَيْر؛ السوء والفساد والرذائل والخطايا وقيل الشرّ يضم كل الرذائل؛ اسم تفضيل، الأكثر شَرّا، أصله أشرّ وحذفت الألف) / شَرّ (ضد الخَيْر؛ السوء والفساد والرذائل والخطايا وقيل الشرّ يضم كل الرذائل؛ اسم تفضيل، الأكثر شَرّا، أصله أشرّ وحذفت الألف)\nمثال: لقد وصف سامي ليلى كشخص شرير إلى حد يكاد لا يصدق. / قَبِيح, بَشِع (ضد الحَسَن، وهو ما نَفَرَ منه الذوق السليم ويشمل القول والفعل والصورة؛ القَبَاح)\nمثال: نادتني بالقبيح. / بغيض, كريه (يثير أو يستحق الكراهية) / حَقُود, خَبِيث (يتسم بالحقد والخبث)\nمثال: لا توجد رذيلة بغيضة عالمياً مثل الجحود / مُدْهِش, مُذْهِل",
 "悪いたずら": "أذى, شقاوة (سلوك متهور أو خبيث يسبب الإزعاج أو الضيق للآخرين) / أذى, شر (الطبيعة أو الصفة المؤذية أو الشريرة)",
 "悪い虫": "عَاطِفَة, شَغْف / عَزْم / شَغَف (المرضُ فلانًا: وصل المرض شِغاف قلبه فالقلب عليل فيه مرض؛ الحبُّ فلانًا: وصل إلى شِغَاف قلبه. وقيل: دخل الحب تحت الشغاف. وقيل: غشى القلب تماما)\nمثال: قبل توم ماري بشغف.",
 "悪がしこい": "مَاكِر",
 "悪くなる": "أَفْسَدَ / دَلَّلَ, غَنَّجَ (دلل: أَدَلَّ عَلَيْهِ وتَدَلَّلَ: انْبَسَطَ؛ قالَ ابْنُ دُرَيْدٍ: أَدَلَّ عَلَيْهِ وَثِق بِمَحَبَّتِهِ فأَفْرَط عَلَيْهِ) / فَسَدَ, نَتِنَ\nمثال: دلل سامي صديقته.",
 "悪さ": "سُوء",
 "悪し": "سَيِّئ, وحش",
 "悪しい": "سَيِّئ, وحش",
 "悪しからず": "أَنَا آسِف, أَنَا آسِفَة",
 "悪しき": "سَيِّئ, وحش",
 "悪しざまに": "بِاسْتِهْجَان, بِسَلْبِيَّة (إظهار عدم الموافقة؛ بطريقة استخفافية)\nمثال: استعرض المسرحية بسلبية",
 "悪し様": "ضَارّ, غَيْر مُفِيد (ينطوي على أو يخلق ظروفاً تضر بالنجاح أو الفعالية) / غير مؤاتٍ, معاكس ((عن الرياح أو الطقس) تميل إلى الإعاقة أو المعارضة) / سلبي, غير مؤيد (غير مشجع أو غير موافق أو غير مبهج)",
 "悪し様に": "بِاسْتِهْجَان, بِسَلْبِيَّة (إظهار عدم الموافقة؛ بطريقة استخفافية)\nمثال: استعرض المسرحية بسلبية",
 "悪たれ": "خشونة, سلوك أهوج (سلوك مشاغب)",
 "悪たれ口": "تَعَسُّف, طُغْيَان / مَسَبَّة, شَتِيمَة / إِيذَاء جَسَدِيّ / اِنْتِهَاك جَسَدِيّ / أَسَاءَ اِسْتِعْمَالَ / آذَى / أَهَانَ, سَبَّ (شخص يكون لئيم لآخر بالكلام) / اِغْتَصَبَ, اِنْتَهَكَ (غَصَبَ؛ زَنَى (بِفُلَانَةٍ) قَهْرًا/غَصْبًا) / خَدَعَ, غَشَّ (غَشَّ، مَكَرَ؛ خَادَعَ شخصًا: خدعه بشكل مستمر أو بطريقة خفية)\nمثال: أهان سامي ليلى بقص شعرها.",
 "悪だくみ": "حيلة, خديعة (استخدام الحيل لخداع شخص ما (عادة لانتزاع المال منه))",
 "悪の巷": "حي المشردين, منطقة بائسة (حي في المدينة يرتاده المشردون ومدمنو الكحول والمخدرات)",
 "悪の枢軸": "مِحْوَر اَلشَّرّ",
 "悪の道へ誘う": "أَضَلَّ",
 "悪びれずに": "بهدوء (برباطة جأش (خاصة في أوقات التوتر)) / برزانة, بهدوء ووقار (بطريقة رزينة وهادئة)\nمثال: تحدث بهدوء للطلاب المشاغبين",
 "悪ふざけ": "مَقْلَب",
 "悪んぞ": "كَيْف, ازاي / كَيْفَ, ازاي / كَمْ, يَا لَ",
 "悪ガキ": "براتوورست (سجق خنزير صغير) / طفل شقي (طفل مزعج جداً)",
 "悪事": "إثم, سوء تصرف (نشاط ينتهك القانون الأخلاقي أو المدني) / إثم, جنحة (الخروج عما هو مقبول أخلاقياً)\nمثال: نفي ارتكاب أي عمل غير مشروع / مُصِيبَة, شَقْوَة",
 "悪事千里を行く": "الأخبار السيئة تنتشر بسرعة",
 "悪事千里を走る": "الأخبار السيئة تنتشر بسرعة",
 "悪人": "شخص سيء, شرير (شخص يلحق الأذى بالآخرين)",
 "悪人ども": "خَصْم, شَخْص سَيِّئ (أي شخص ليس في صفك)",
 "悪人共": "خَصْم, شَخْص سَيِّئ (أي شخص ليس في صفك)",
 "悪党": "وَغْد, نَذْل",
 "悪化": "تدهور, تردي (عملية التغير إلى حالة أدنى) / تدهور, ضعف (علامة على انخفاض الجودة أو القوة)",
 "悪友": "رفيق, زميل (صديق مقرب يرافق رفاقه في أنشطتهم)",
 "悪口": "تَعَسُّف, طُغْيَان / مَسَبَّة, شَتِيمَة / إِيذَاء جَسَدِيّ / اِنْتِهَاك جَسَدِيّ / أَسَاءَ اِسْتِعْمَالَ / آذَى / أَهَانَ, سَبَّ (شخص يكون لئيم لآخر بالكلام) / اِغْتَصَبَ, اِنْتَهَكَ (غَصَبَ؛ زَنَى (بِفُلَانَةٍ) قَهْرًا/غَصْبًا) / خَدَعَ, غَشَّ (غَشَّ، مَكَرَ؛ خَادَعَ شخصًا: خدعه بشكل مستمر أو بطريقة خفية)\nمثال: أهان سامي ليلى بقص شعرها.",
 "悪口をいう": "سَبَّ, شَتَمَ (تفاحة) / إهانة\nمثال: كتب سامي رواية تحتوى على أكثر من سب مئة صفحة.",
 "悪口を言う": "سَبَّ, شَتَمَ (تفاحة) / إهانة\nمثال: كتب سامي رواية تحتوى على أكثر من سب مئة صفحة.",
 "悪口雑言": "إِدَانَة",
 "悪名": "سمعة سيئة, شهرة سيئة (حالة كونه معروفاً بعمل أو صفة غير مرغوب فيها) / إثم, سوء تصرف (نشاط ينتهك القانون الأخلاقي أو المدني) / إثم, جنحة (الخروج عما هو مقبول أخلاقياً)\nمثال: نفي ارتكاب أي عمل غير مشروع",
 "悪名高い": "سَيِّئُ الصِّيتِ, مَشْهُورٌ بِالسُّوءِ (معروف على نطاق واسع وعادة بشكل سلبي)",
 "悪地": "وَعْر",
 "悪変": "تدهور, تردي (عملية التغير إلى حالة أدنى) / تدهور, ضعف (علامة على انخفاض الجودة أو القوة)",
 "悪夢": "كَابُوس",
 "悪天": "طقس سيء, قسوة الطقس (طقس غير مناسب للأنشطة الخارجية)",
 "悪天候": "طقس سيء, قسوة الطقس (طقس غير مناسب للأنشطة الخارجية)",
 "悪太郎": "مُثِير لِلْمَشاكِل, مُثِير لِلْمَتَاعِب",
 "悪寒": "برودة شديدة, صقيع (برودة ناتجة عن بيئة باردة) / رجفة, رعشة (إحساس بالخوف يكاد يكون ممتعاً) / انقباض, وجوم (رهبة مفاجئة تسبب الشلل) / رجفة, قشعريرة (إحساس بالبرد غالباً ما يشير إلى بداية عدوى وتطور حمى)\nمثال: سرت فيه رعشة مفاجئة",
 "悪巧み": "حيلة, خديعة (استخدام الحيل لخداع شخص ما (عادة لانتزاع المال منه))",
 "悪弊": "تَعَسُّف, طُغْيَان / مَسَبَّة, شَتِيمَة / إِيذَاء جَسَدِيّ / اِنْتِهَاك جَسَدِيّ / أَسَاءَ اِسْتِعْمَالَ / آذَى / أَهَانَ, سَبَّ (شخص يكون لئيم لآخر بالكلام) / اِغْتَصَبَ, اِنْتَهَكَ (غَصَبَ؛ زَنَى (بِفُلَانَةٍ) قَهْرًا/غَصْبًا) / خَدَعَ, غَشَّ (غَشَّ، مَكَرَ؛ خَادَعَ شخصًا: خدعه بشكل مستمر أو بطريقة خفية)\nمثال: أهان سامي ليلى بقص شعرها.",
 "悪役": "شِرِّير (الكَثير الشَرّ بمعنى اسم جامع للرذائل، قد يستعمل كاسم فاعل؛ ضد الخَيِّر؛ يستخدم أيضا بمعنى ذو الشَرّ وما تسبب بالشرّ)\nمثال: لقد وصف سامي ليلى كشخص شرير إلى حد يكاد لا يصدق.",
 "悪役令嬢": "شريرة (امرأة شريرة)",
 "悪徒": "مُشَاغِب",
 "悪循環": "حلقة مفرغة, دور منطقي (حجة تفترض صحة ما يراد إثباته) / حلقة مفرغة, دائرة خبيثة (مشكلة تؤدي إلى أخرى تفاقم الأولى)",
 "悪徳": "رَذِيلَة",
 "悪徳弁護士": "مراوغ (شخص (خاصة محامٍ أو سياسي) يستخدم أساليب عديمة الضمير أو غير أخلاقية)",
 "悪心": "غَثْيَان (جاشت النفس واضطربت واستعدت للقَيء؛ الاِشْمِئْزَاز والقَرَف)\nمثال: كنت أشعر بالغثيان.",
 "悪念": "خبث, لؤم (الخبث الناتج عن كون الشخص حقودًا أو سيئ الطبع) / حقد, كيد (الشعور بالحاجة لرؤية الآخرين يعانون)",
 "悪性": "انحلال, فجور (انغماس منحل في الملذات الحسية) / إباحية, خلاعة (صفة الفسق والمجون) / خبيث (خطير على الصحة؛ يتميز بنمو تدريجي وغير منضبط (خاصة للورم))",
 "悪性度": "حقد دفين, خبث (صفة الميل إلى الشر؛ سوء النية الشديد) / خباثة (حالة خبيثة؛ تقدمية ومقاومة للعلاج وتميل للتسبب في الوفاة)",
 "悪性新生物": "ورم خبيث, ورم نقيلي (ورم خبيث يميل إلى الانتشار إلى أجزاء أخرى من الجسم)",
 "悪性腫瘍": "ورم خبيث, ورم نقيلي (ورم خبيث يميل إلى الانتشار إلى أجزاء أخرى من الجسم)",
 "悪性貧血": "فقر الدم الخبيث, فقر الدم الوبيل (فقر دم مزمن ومترقٍ يصيب كبار السن؛ يُعتقد أنه ناتج عن نقص في العامل الداخلي (مادة تفرزها المعدة مسؤولة عن امتصاص فيتامين ب12))",
 "悪性黒色腫": "ميلانوما, ورم ميلانيني (أي من الأورام الخبيثة المتعددة (عادة في الجلد) التي تتكون من الخلايا الصبغية (الميلانينية))",
 "悪悪戯": "أذى, شقاوة (سلوك متهور أو خبيث يسبب الإزعاج أو الضيق للآخرين) / أذى, شر (الطبيعة أو الصفة المؤذية أو الشريرة)",
 "悪意": "خصومة, ضغينة (طبع عدائي (غير ودود للغاية)) / خصومة, عداء (شعور الشخص المعادي)\nمثال: لم يستطع إخفاء عدائه / حِقْد (حقد:أَمْسَكَ عَداوتَهُ فِي قَلْبهِ وتَرَبَّصَ لفُرْصَتِها؛ حقد على فلان:أَضْمَرَ له العداوة وتربّص فرصة الإيقاع به ، كَرِهَه وبَغِضَه)\nمثال: احس سامي بالحقد.",
 "悪感": "خصومة, ضغينة (طبع عدائي (غير ودود للغاية)) / خصومة, عداء (شعور الشخص المعادي)\nمثال: لم يستطع إخفاء عدائه",
 "悪感情": "خصومة, ضغينة (طبع عدائي (غير ودود للغاية)) / خصومة, عداء (شعور الشخص المعادي)\nمثال: لم يستطع إخفاء عدائه",
 "悪態をつく": "لَعْنَة (أي رغبة صريحة في أن تصيب المحن أو أي شكل من أشكال سوء الحظ كيانًا ما، سواء كان شخصًا، أو مكانًا، أو كائنًا) / نِقْمَة / لَعَنَ ((في الدين) طَرَدَهُ اللَّٰهُ مِنْ رَحْمَتِهِ؛ سَبَّ، شَتَمَ) / شَتَمَ, سَبَّ\nمثال: اللعنة حولها ومعرفة",
 "悪戯": "أذى, شقاوة (سلوك متهور أو خبيث يسبب الإزعاج أو الضيق للآخرين) / أذى, شر (الطبيعة أو الصفة المؤذية أو الشريرة) / شِرِّير, مُؤْذٍ (الكَثير الشَرّ بمعنى اسم جامع للرذائل، قد يستعمل كاسم فاعل؛ ضد الخَيِّر؛ يستخدم أيضا بمعنى ذو الشَرّ وما تسبب بالشرّ)\nمثال: لقد وصف سامي ليلى كشخص شرير إلى حد يكاد لا يصدق. / تسلية, هواية (ترفيه يشغل وقت المرء وأفكاره (عادة بشكل ممتع))\nمثال: الإبحار هو هوايتها المفضلة / اِعْتِدَاء جِنْسِيّ",
 "悪戯っぽい": "نَذْل, وَغْدِيّ (عديم المبادئ أو الضمير) / شَيْطَانِيّ, مَاكِر بِلُطْف (مرح بجرأة جذّابة ومحبّبة)",
 "悪戯っ子": "شقي, عفريت (شخص مؤذٍ بمرح) / آلْف",
 "悪戯坊主": "مُثِير لِلْمَشاكِل, مُثِير لِلْمَتَاعِب",
 "悪戯好き": "شِرِّير, مُؤْذٍ (الكَثير الشَرّ بمعنى اسم جامع للرذائل، قد يستعمل كاسم فاعل؛ ضد الخَيِّر؛ يستخدم أيضا بمعنى ذو الشَرّ وما تسبب بالشرّ)\nمثال: لقد وصف سامي ليلى كشخص شرير إلى حد يكاد لا يصدق.",
 "悪戯子": "شقي, عفريت (شخص مؤذٍ بمرح) / آلْف",
 "悪戯書": "خربشة",
 "悪戯書き": "خربشة",
 "悪戯着": "بدلة لعب, رومبر (رداء من قطعة واحدة للأطفال للعب؛ الجزء السفلي منه يشبه السروال المنتفخ) / لَاهٍ, مَارِح (شخص يمرح أو يلهو)",
 "悪戯者": "مثير للمشاكل, مشاغب (شخص يثير المشاكل أو الفتن عمداً) / فَأْرَة, فَأْر",
 "悪戯電話": "مكالمة مزعجة, مكالمة معاكسة (مكالمة هاتفية عدائية (من شخص غريب الأطوار))",
 "悪所": "حي البغاء, منطقة الضوء الأحمر (حي يكثر فيه وجود بيوت الدعارة)",
 "悪推量": "ارتياب, عدم ثقة (سمة عدم الثقة في الآخرين) / توجس, ريبة (شك في نزاهة شخص ما)",
